// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаСервере
Функция ПользовательскоеПредставлениеРеквизита(РеквизитОбъекта, Префикс = "", ПрефиксПользовательский = "")

	Результат = "";
	Синоним = ?(ПустаяСтрока(ПрефиксПользовательский), "", ПрефиксПользовательский + ". ");
	Имя = ?(ПустаяСтрока(Префикс), "", Префикс + ".");
	Если ТипЗнч(РеквизитОбъекта) = Тип("ОбъектМетаданных") Тогда
		Синоним = Синоним + РеквизитОбъекта.Синоним;	
		Имя = Имя + РеквизитОбъекта.Имя;
	ИначеЕсли ТипЗнч(РеквизитОбъекта) = Тип("ОписаниеСтандартногоРеквизита") Тогда
		Синоним = Синоним + РеквизитОбъекта.Синоним;	
		Имя = Имя + РеквизитОбъекта.Имя;
	ИначеЕсли ТипЗнч(РеквизитОбъекта) = Тип("ЭлементСпискаЗначений") Тогда
		Синоним = Синоним + РеквизитОбъекта.Представление;	
		Имя = Имя + РеквизитОбъекта.Значение;
	ИначеЕсли ТипЗнч(РеквизитОбъекта) = Тип("Структура") Тогда
		Синоним = "";
		Если НЕ ПустаяСтрока(РеквизитОбъекта.ИмяТабличнойЧасти) Тогда
			Если ПустаяСтрока(РеквизитОбъекта.ЗаголовокТабличнойЧасти) Тогда
				Синоним = РеквизитОбъекта.ИмяТабличнойЧасти + ". ";
			Иначе
				Синоним = РеквизитОбъекта.ЗаголовокТабличнойЧасти + ". ";
			КонецЕсли;
			Имя = РеквизитОбъекта.ИмяТабличнойЧасти + ".";
		КонецЕсли;
		Если ПустаяСтрока(РеквизитОбъекта.ЗаголовокРеквизита) Тогда
			Синоним = Синоним + РеквизитОбъекта.ИмяРеквизита;
		Иначе
			Синоним = Синоним + РеквизитОбъекта.ЗаголовокРеквизита;
		КонецЕсли;
		Имя = Имя + РеквизитОбъекта.ИмяРеквизита;
	КонецЕсли;
	
	Результат = "";
	Если Не ПустаяСтрока(Синоним) Тогда
		Результат = Результат + Синоним;
	КонецЕсли;
	Если Не ПустаяСтрока(Имя) Тогда
		Результат = Результат + " (" +Имя + ")";
	КонецЕсли;
	
	Возврат Результат;

КонецФункции // ПользовательскоеПредставлениеРеквизита()

&НаКлиенте
Процедура ДобавитьВСвязиПараметровВыбора()

	ТекущийРеквизит = Элементы.ДоступныеРеквизиты.ТекущиеДанные;
	Если ТекущийРеквизит = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ВыбранныеРеквизиты.НайтиПоЗначению(ТекущийРеквизит.Значение) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыбранныеРеквизиты.Добавить(ТекущийРеквизит.Значение, ТекущийРеквизит.Представление);
	
	ДоступныеРеквизиты.Удалить(ДоступныеРеквизиты.НайтиПоЗначению(ТекущийРеквизит.Значение));
	
	НовСтр = СвязиПараметровВыбора.Добавить();
	НовСтр.Реквизит = ТекущийРеквизит.Значение;
//	НовСтр.Имя = "Отбор." + ?(Лев(НовСтр.Реквизит, 7) = "Объект.", Сред(НовСтр.Реквизит, 8), НовСтр.Реквизит);
	НовСтр.Имя = "Отбор." + Сред(НовСтр.Реквизит, Найти(НовСтр.Реквизит, ".")+1);
	НовСтр.Режим = "Очищать";
	
	ТипЗначенияВыбранногоРеквизита = ТипыРеквизитовОбъектаИсточника[ТекущийРеквизит.Значение];
	Если ТипЗначенияВыбранногоРеквизита <> Неопределено Тогда
		
		ПозицияТипа = ТипыРеквизитовОбъекта.Найти(ТипЗначенияВыбранногоРеквизита);
		Если ПозицияТипа <> Неопределено Тогда
			НовСтр.Имя = Элементы.СвязиПараметровВыбораИмя.СписокВыбора.Получить(ПозицияТипа).Значение;
		КонецЕсли;
		
	КонецЕсли;
	
	Модифицированность = Истина;

КонецПроцедуры // ДобавитьВСвязиПараметровВыбора()

&НаКлиенте
Процедура УдалитьИзСвязейПараметровВыбора()
	
	ТекущийРеквизит = Элементы.СвязиПараметровВыбора.ТекущиеДанные;
	Если ТекущийРеквизит = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитКУдалению = ВыбранныеРеквизиты.НайтиПоЗначению(ТекущийРеквизит.Реквизит);
	ДоступныеРеквизиты.Добавить(РеквизитКУдалению.Значение, РеквизитКУдалению.Представление);
	
	ВыбранныеРеквизиты.Удалить(РеквизитКУдалению);
	
	НайденныйРеквизит = СвязиПараметровВыбора.НайтиПоИдентификатору(ТекущийРеквизит.ПолучитьИдентификатор());
	СвязиПараметровВыбора.Удалить(НайденныйРеквизит);
	
	ДоступныеРеквизиты.СортироватьПоПредставлению();
	
	Модифицированность = Истина;

КонецПроцедуры

&НаСервере
Процедура ПрочитатьПереданныеСвязи(ВыбранныеСвязи)

	ТекВыбранныеСвязи = Неопределено;
	Если Лев(Параметры.ВыбранныеСвязи, 4) = "{""#""" Тогда
		Попытка
		
			ТекВыбранныеСвязи = ЗначениеИзСтрокиВнутр(ВыбранныеСвязи);
		
		Исключение
			
			ТекВыбранныеСвязи = Неопределено;
			
		КонецПопытки;
	КонецЕсли;
	
	Если ТипЗнч(ТекВыбранныеСвязи)=Тип("Массив") Тогда
		
		Для каждого ТекСвязь Из ТекВыбранныеСвязи Цикл
		
			НовСтр = СвязиПараметровВыбора.Добавить();
			НовСтр.Имя = ТекСвязь.Имя;
			НовСтр.Реквизит = ТекСвязь.Реквизит;
			НовСтр.Режим = ТекСвязь.Режим;
		
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры // ПрочитатьПереданныеСвязи()

&НаКлиенте
Процедура ПодготовитьСвязиКПередаче()

	Результат = Новый Массив;
	ПредставлениеРезультата = "";
	Для каждого ТекСтр Из СвязиПараметровВыбора Цикл
	
		Результат.Добавить(Новый Структура("Имя, Реквизит, Режим",
											ТекСтр.Имя, ТекСтр.Реквизит, ТекСтр.Режим));
		ПредставлениеРезультата = ПредставлениеРезультата + ТекСтр.имя +"("+ТекСтр.Реквизит+"), ";							
	
	КонецЦикла;
	
	ПредставлениеРезультата = Лев(ПредставлениеРезультата, СтрДлина(ПредставлениеРезультата)-2);
	
	СвязиКПередаче = Новый СписокЗначений;
	СвязиКПередаче.Добавить(РезультатВСтроку(Результат), ПредставлениеРезультата);
	
	Модифицированность = Ложь;

КонецПроцедуры // ПодготовитьСвязиКПередаче()

&НаСервереБезКонтекста
Функция РезультатВСтроку(Результат)

	Возврат ЗначениеВСтрокуВнутр(Результат);

КонецФункции // РезультатВСтроку()
