
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Параметры.Организация) Тогда
		Организация = Параметры.Организация;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметры.ЛицевойСчет) Тогда
		ЛицевойСчет = Параметры.ЛицевойСчет;
		Если Не ЗначениеЗаполнено(Организация) Тогда
			Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЛицевойСчет, "Владелец");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_Документы

&НаКлиенте
Процедура ДокументыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Поле.Имя <> "ДокументыОтметка" И Поле.Имя <> "ДокументыНовыйРаздел" Тогда
		ПоказатьЗначение(, Элементы.Документы.ТекущиеДанные.Документ);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Заполнить(Команда)
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	Если ТаблицаДокументов.Количество() > 0 Тогда
		Оповещение = Новый ОписаниеОповещения("ПослеОтветаОбОчистке", ЭтотОбъект);
		ТекстВопроса = НСтр("ru = 'Таблица документов будет перезаполнена. Продолжить?'");
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 60);
	Иначе
		ЗаполнитьНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьНовыйРаздел(Команда)
	
	ЕстьОтмеченные = Ложь;
	Для Каждого СтрокаТаблицы Из ТаблицаДокументов Цикл
		Если СтрокаТаблицы.Отметка Тогда
			ЕстьОтмеченные = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ ЕстьОтмеченные Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не отмечено ни одной строки!'"));
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Отбор", Новый Структура("Владелец", ЛицевойСчет));
	
	ОповещениеПриЗакрытии = Новый ОписаниеОповещения("ПослеВыбораНовогоРаздела", ЭтотОбъект);
	
	ОткрытьФорму("Справочник.РазделыЛицевыхСчетов.ФормаВыбора", ПараметрыФормы, ЭтотОбъект,,,,ОповещениеПриЗакрытии);
	
КонецПроцедуры

&НаКлиенте
Процедура ВключитьВсе(Команда)
	Для Каждого СтрокаТаблицы Из ТаблицаДокументов Цикл
		СтрокаТаблицы.Отметка = Истина;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ОтключитьВсе(Команда)
	Для Каждого СтрокаТаблицы Из ТаблицаДокументов Цикл
		СтрокаТаблицы.Отметка = Ложь;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЗамену(Команда)
	
	ЕстьОтмеченные = Ложь;
	ЕстьНезаполненныйРаздел = Ложь;
	Для Каждого СтрокаТаблицы Из ТаблицаДокументов Цикл
		Если СтрокаТаблицы.Отметка Тогда
			ЕстьОтмеченные = Истина;
			Если Не ЗначениеЗаполнено(СтрокаТаблицы.НовыйРаздел) Тогда
				ЕстьНезаполненныйРаздел = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ ЕстьОтмеченные Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не отмечено ни одной строки для замены!'"));
		Возврат;
	КонецЕсли;
	
	Если ЕстьНезаполненныйРаздел Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'В отмеченных строках не указан новый раздел лицевого счета!'"));
		Возврат;
	КонецЕсли;
	
	ВыполнитьЗаменуНаСервере();
	
	ПоказатьОповещениеПользователя(НСтр("ru = 'Выполнена замена раздела лицевого счета'"));
	
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВыделенные(Команда)
	
	Для Каждого СтрИнд Из Элементы.Документы.ВыделенныеСтроки Цикл
		Элементы.Документы.ДанныеСтроки(СтрИнд).Отметка = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметкиВыделенных(Команда)
	
	Для Каждого СтрИнд Из Элементы.Документы.ВыделенныеСтроки Цикл
		Элементы.Документы.ДанныеСтроки(СтрИнд).Отметка = Ложь;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПослеОтветаОбОчистке(Результат, Параметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОбороты.Регистратор КАК Документ,
	|	&РазделЛицевогоСчета КАК ТекущийРаздел,
	|	Журнал.Корреспондент КАК Контрагент,
	|	ЕСТЬNULL(Журнал.СуммаДокумента, ОперацииДокументов.СуммаОперации) КАК СуммаДокумента,
	|	ЛОЖЬ КАК Отметка
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|			,
	|			,
	|			Регистратор,
	|			,
	|			&РазделыЛицевыхСчетов,
	|			Организация = &Организация
	|				И Субконто1 = &РазделЛицевогоСчета,
	|			,
	|			) КАК ЖурналПроводокЕПСБУОбороты
	|		ЛЕВОЕ СОЕДИНЕНИЕ ЖурналДокументов.ЖурналОпераций КАК Журнал
	|		ПО ЖурналПроводокЕПСБУОбороты.Регистратор = Журнал.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
	|		ПО ЖурналПроводокЕПСБУОбороты.Регистратор = ОперацииДокументов.Документ";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("РазделЛицевогоСчета", РазделЛицевогоСчета);
	Запрос.УстановитьПараметр("РазделыЛицевыхСчетов", ПланыВидовХарактеристик.ВидыСубконто.РазделыЛицевыхСчетов);
	
	ТаблицаДокументов.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораНовогоРаздела(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из ТаблицаДокументов Цикл
		Если НЕ СтрокаТаблицы.Отметка Тогда
			Продолжить;
		КонецЕсли;
		СтрокаТаблицы.НовыйРаздел = Результат;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьЗаменуНаСервере()
	
	Для Каждого СтрокаТаблицы Из ТаблицаДокументов Цикл
		
		Если НЕ СтрокаТаблицы.Отметка Тогда
			Продолжить;
		КонецЕсли;
		
		НачатьТранзакцию();
		Попытка
		
			// Регистр бухгалтерии - бухгалтерские проводки
			НаборЗаписей = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Регистратор.Установить(СтрокаТаблицы.Документ);
			
			НаборЗаписей.Прочитать();
			
			Для Каждого СтрокаНабора Из НаборЗаписей Цикл
				
				Если СтрокаНабора.СубконтоДт.РазделыЛицевыхСчетов = СтрокаТаблицы.ТекущийРаздел Тогда
					СтрокаНабора.СубконтоДт.РазделыЛицевыхСчетов = СтрокаТаблицы.НовыйРаздел;
				КонецЕсли;
				
				Если СтрокаНабора.СубконтоКт.РазделыЛицевыхСчетов = СтрокаТаблицы.ТекущийРаздел Тогда
					СтрокаНабора.СубконтоКт.РазделыЛицевыхСчетов = СтрокаТаблицы.НовыйРаздел;
				КонецЕсли;
				
			КонецЦикла;
			
			Если НаборЗаписей.Модифицированность() Тогда
				НаборЗаписей.ОбменДанными.Загрузка = Истина;
				НаборЗаписей.Записать();
			КонецЕсли;
			
			// Регистр сведений - реквизиты типовых операций
			НаборЗаписей = РегистрыСведений.ЗначенияДополнительныхРеквизитовОпераций.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Объект.Установить(СтрокаТаблицы.Документ);
			
			НаборЗаписей.Прочитать();
			
			Для Каждого СтрокаНабора Из НаборЗаписей Цикл
				
				Если СтрокаНабора.Значение = СтрокаТаблицы.ТекущийРаздел Тогда
					СтрокаНабора.Значение = СтрокаТаблицы.НовыйРаздел;
				КонецЕсли;
				
			КонецЦикла;
			
			Если НаборЗаписей.Модифицированность() Тогда
				НаборЗаписей.ОбменДанными.Загрузка = Истина;
				НаборЗаписей.Записать();
			КонецЕсли;
			
			// Документ
			МетаданныеДокумента = СтрокаТаблицы.Документ.Метаданные();
			ДокументОбъект = СтрокаТаблицы.Документ.ПолучитьОбъект();
			
			Для Каждого Реквизит Из МетаданныеДокумента.Реквизиты Цикл
				Если Реквизит.Тип.СодержитТип(ТипЗнч(СтрокаТаблицы.ТекущийРаздел)) И ДокументОбъект[Реквизит.Имя] = СтрокаТаблицы.ТекущийРаздел Тогда
					ДокументОбъект[Реквизит.Имя] = СтрокаТаблицы.НовыйРаздел;
				КонецЕсли;
			КонецЦикла;
			
			Для Каждого ТЧ ИЗ МетаданныеДокумента.ТабличныеЧасти Цикл
				Для Каждого Реквизит Из ТЧ.Реквизиты Цикл
					Если Реквизит.Тип.СодержитТип(ТипЗнч(СтрокаТаблицы.ТекущийРаздел)) Тогда
						СтрокаТабЧасти = ДокументОбъект[ТЧ.Имя].Найти(СтрокаТаблицы.ТекущийРаздел, Реквизит.Имя);
						Пока СтрокаТабЧасти <> Неопределено Цикл
							СтрокаТабЧасти[Реквизит.Имя] = СтрокаТаблицы.НовыйРаздел;
							СтрокаТабЧасти = ДокументОбъект[ТЧ.Имя].Найти(СтрокаТаблицы.ТекущийРаздел, Реквизит.Имя);
						КонецЦикла;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
			
			Если ДокументОбъект.Модифицированность() Тогда
				ДокументОбъект.ОбменДанными.Загрузка = Истина;
				ДокументОбъект.Записать();
			КонецЕсли;
			
			СтрокаТаблицы.ТекущийРаздел = СтрокаТаблицы.НовыйРаздел;
			СтрокаТаблицы.Отметка = Ложь;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			
			ОбщегоНазначения.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Ну удалось выполнить замену раздела лицевого счета'"),
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
