// ПЕРЕМЕННЫЕ МОДУЛЯ

&НаКлиенте
Перем мНачальноеЗначениеИмени; // Используется обработкой переименования процедуры


////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Возвращает признак того, что переданная в качестве параметра строка
// может быть использована в качестве идентификатора.
//
&НаКлиенте
Функция СтрокаМожетИспользоватьсяВКачествеИдентификатора(Знач Стр) Экспорт
	
	Если ПустаяСтрока(Стр) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Стр = ВРЕГ(СокрЛП(Стр));
	
	РусАнглАлфавит = "АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯABCDEFGHIJKLMNOPQRSTUVWXYZ";
	РусАнглАлфавитИВспомогательныеСимволы = "АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789";
	
	Если Найти(РусАнглАлфавит, Сред(Стр, 1, 1)) = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Инд = 2 По СтрДлина(Стр) Цикл
		Если Найти(РусАнглАлфавитИВспомогательныеСимволы, Сред(Стр, Инд, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Функция ПодготовитьОтвет(Знач НомерТекущейСтроки)
	
	СтруктураОтвета = Новый Структура;
	
	СтруктураОтвета.Вставить("ТаблицаПроцедур",ТаблицаРедактированияПроцедур);
	
	ТекущаяСтрока = ТаблицаРедактированияПроцедур.НайтиПоИдентификатору(НомерТекущейСтроки);
	Если Не ТекущаяСтрока = Неопределено Тогда
		СтруктураОтвета.Вставить("ТекущаяПроцедура",ТекущаяСтрока.Идентификатор);
	Иначе
		СтруктураОтвета.Вставить("ТекущаяПроцедура", Неопределено);
	КонецЕсли;
	
	Возврат СтруктураОтвета;

КонецФункции // ПодготовитьОтвет()

&НаКлиенте
Процедура ОповеститьРодителяОВыборе() 
	
	Модифицированность = Ложь;
	
	Закрыть(ПодготовитьОтвет(Элементы.ТаблицаРедактированияПроцедур.ТекущаяСтрока));

КонецПроцедуры // ОповеститьРодителяОВыборе()

&НаКлиенте
Процедура ОбработкаРезультатаВопроса(Результат, ДополнительныеПараметры) Экспорт 
	
	Если ДополнительныеПараметры.Источник = "ТаблицаРедактированияПроцедурПередУдалением" Тогда 
		
		Если Результат = КодВозвратаДиалога.Да Тогда 
			
			ДополнительныеПараметры.Колекция.Удалить(ДополнительныеПараметры.СтрокаДляУдаления);
			Модифицированность = истина;
			
		КонецЕсли;
		
	ИначеЕсли ДополнительныеПараметры.Источник = "ПередЗакрытием" Тогда 
		
		Если Результат = КодВозвратаДиалога.Да Тогда 
			
			ОповеститьРодителяОВыборе();
			
		ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда
			
			Модифицированность = Ложь;
			Закрыть(Неопределено);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры



////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Перем НомерТекущейСтроки;
	
	ОбщегоНазначенияКлиентСервер.ЗаполнитьКоллекциюСвойств(Параметры.ТаблицаПроцедур,ТаблицаРедактированияПроцедур);
	
	Если ЗначениеЗаполнено(Параметры.ТекущаяСтрока) Тогда 
		ТекущиеСтроки = ТаблицаРедактированияПроцедур.НайтиСтроки(Новый Структура("Идентификатор",Параметры.ТекущаяСтрока));
		Если ЗначениеЗаполнено(ТекущиеСтроки) Тогда 
			Элементы.ТаблицаРедактированияПроцедур.ТекущаяСтрока = ТекущиеСтроки[0].ПолучитьИдентификатор();
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ТАБЛИЧНОЙ ЧАСТИ

&НаКлиенте
Процедура ТаблицаРедактированияПроцедурПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Источник","ТаблицаРедактированияПроцедурПередУдалением");	
	
	ДополнительныеПараметры.Вставить("Колекция",ТаблицаРедактированияПроцедур);
	ДополнительныеПараметры.Вставить("СтрокаДляУдаления",Элементы.ТаблицаРедактированияПроцедур.ТекущиеДанные);
	
	ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
	НСтр("ru = 'Вы хотите удалить процедуру «%1»?'"),
	Элемент.ТекущиеДанные.ИмяПроцедуры);
	Кнопки = РежимДиалогаВопрос.ДаНет;
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаРезультатаВопроса",ЭтаФорма,ДополнительныеПараметры);
	
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, Кнопки, , , , );
	
КонецПроцедуры


&НаКлиенте
Процедура ТаблицаРедактированияПроцедурПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	мНачальноеЗначениеИмени = Элемент.ТекущиеДанные.ИмяПроцедуры;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРедактированияПроцедурПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	Если НоваяСтрока и ОтменаРедактирования Тогда
		Возврат;
	КонецЕсли;
	
	ИмяПроцедуры = Элемент.ТекущиеДанные.ИмяПроцедуры;
	
	// Проверка корректности написания имени.
	Если ПустаяСтрока(ИмяПроцедуры) или Не СтрокаМожетИспользоватьсяВКачествеИдентификатора(ИмяПроцедуры) Тогда
		Отказ = Истина;
		ПоказатьПредупреждение(,НСтр("ru = 'Имя процедуры задано неверно!'"));
		
		
	// Проверка уникальности имени.
	ИначеЕсли ТаблицаРедактированияПроцедур.НайтиСтроки(Новый Структура("ИмяПроцедуры",ИмяПроцедуры)).Количество() > 1 Тогда
		Отказ = Истина;
		
		ТекстПредупреждения = НСтр("ru = 'Процедура «%1» уже присутствует в списке!'");
		ПоказатьПредупреждение(,СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстПредупреждения, ИмяПроцедуры));
		
		
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРедактированияПроцедурПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Если ОтменаРедактирования Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = ТаблицаРедактированияПроцедур.НайтиПоИдентификатору(Элемент.ТекущаяСтрока);
	
	Если НоваяСтрока Тогда
		ТекущиеДанные.Идентификатор = Новый УникальныйИдентификатор;
		ТекущиеДанные.Загружена     = Истина;
	Иначе
		// Обработка переименования процедуры.
		Если Не ПустаяСтрока(мНачальноеЗначениеИмени) и мНачальноеЗначениеИмени <> ТекущиеДанные.ИмяПроцедуры и Не ТекущиеДанные.Загружена Тогда
			ТекущиеДанные.ТекстПроцедуры = ПользовательскиеАлгоритмыВызовСервера.ПолучитьТекстПроцедуры(Параметры.Ссылка, мНачальноеЗначениеИмени);
			ТекущиеДанные.Загружена      = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаРедактированияПроцедурВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ОповеститьРодителяОВыборе();
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура Выбрать(Команда)
	ОповеститьРодителяОВыборе();
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	Если Не Модифицированность Тогда
		Возврат;
	КонецЕсли;
		
	Отказ = Истина;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Источник","ПередЗакрытием");	
		
	ТекстВопроса = НСтр("ru = 'Сохранить изменения в списке процедур?'");
	Кнопки = РежимДиалогаВопрос.ДаНетОтмена;
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаРезультатаВопроса",ЭтаФорма,ДополнительныеПараметры);
	
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, Кнопки, , , , );
	
КонецПроцедуры


