КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьОстаткиПоРегистру(Организация, Подразделение, ИспользоватьПодразделение)
	
	ОстаткиПоРегистру = "";
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НаличныеДенежныеСредстваОстатки.Валюта.Наименование,
	|	СУММА(НаличныеДенежныеСредстваОстатки.СуммаОстаток) КАК СуммаОстаток
	|ИЗ
	|	РегистрНакопления.НаличныеДенежныеСредства.Остатки(,";
				   
	Если ЗначениеЗаполнено(Организация) Тогда
		
		Запрос.Текст = Запрос.Текст + "				   
		|Организация = &Организация";
		Запрос.УстановитьПараметр("Организация", Организация);	
		
		Если ИспользоватьПодразделение И НЕ ЗначениеЗаполнено(Подразделение) Тогда
			
			Запрос.Текст = Запрос.Текст + "				   
			|И ЕСТЬNULL(Подразделение.ВедетсяКассоваяКнига, ЛОЖЬ) = ЛОЖЬ";
			
		КонецЕсли;
		
		Если ИспользоватьПодразделение И ЗначениеЗаполнено(Подразделение)Тогда
			
			Запрос.Текст = Запрос.Текст + "				   
			|И Подразделение = &Подразделение";
			Запрос.УстановитьПараметр("Подразделение", Подразделение);
			
		КонецЕсли;
		
	КонецЕсли;				   
	
	Запрос.Текст = Запрос.Текст + "				   
	|) КАК НаличныеДенежныеСредстваОстатки
	|СГРУППИРОВАТЬ ПО
	|	НаличныеДенежныеСредстваОстатки.Валюта.Наименование
	|";
				   
	Выборка = Запрос.Выполнить().Выбрать();
	
	Разделитель = "";
	
	Пока Выборка.Следующий() Цикл
		
		ОстаткиПоРегистру = ОстаткиПоРегистру + Разделитель + Выборка.ВалютаНаименование + " " + Формат(Выборка.СуммаОстаток,"ЧДЦ=2; ЧРД==");
		
		Разделитель = ", ";

	КонецЦикла;
	
	Возврат ОстаткиПоРегистру;
		
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьОстаткиПоРегиструФондовые(Организация, Подразделение, ИспользоватьПодразделение)
	
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СУММА(ДенежныеДокументыОстатки.СуммаОстаток) КАК СуммаОстаток
	|ИЗ
	|	РегистрНакопления.ДенежныеДокументы.Остатки(,";
	
	Если ЗначениеЗаполнено(Организация) Тогда
		
		Запрос.Текст = Запрос.Текст + "				   
		|Организация = &Организация";
		Запрос.УстановитьПараметр("Организация", Организация);
		
		Если ИспользоватьПодразделение И НЕ ЗначениеЗаполнено(Подразделение) Тогда
			
			Запрос.Текст = Запрос.Текст + "				   
			|И ЕСТЬNULL(Подразделение.ВедетсяКассоваяКнига, ЛОЖЬ) = ЛОЖЬ";
			
		КонецЕсли;
		
		Если ИспользоватьПодразделение И ЗначениеЗаполнено(Подразделение)Тогда
			
			Запрос.Текст = Запрос.Текст + "				   
			|И Подразделение = &Подразделение";
			Запрос.УстановитьПараметр("Подразделение", Подразделение);
			
		КонецЕсли;
		
	КонецЕсли;	
	
	Запрос.Текст = Запрос.Текст + "				   
	|) КАК ДенежныеДокументыОстатки";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.СуммаОстаток;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ИзменениеОсновнойОрганизацииНаСервере()
	
	ОтборОрганизация = ЗаполнениеРеквизитовОбъектов.ОрганизацияПоУмолчанию();
	
	Представление = НСтр("ru = 'Отбор по основной организации (%1)'");
	
	Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Представление, Строка(ОтборОрганизация));
	
	УстановитьОтборОрганизацииНаСервере();
    	
КонецПроцедуры

&НаСервере
Процедура УстановитьМенюОтчетовКассира()
	
	ДоступДобавление = Ложь;
	
	Для Каждого РегДокумент Из Метаданные.ЖурналыДокументов.ОтчетыКассира.РегистрируемыеДокументы Цикл
		Если ПравоДоступа("Добавление", РегДокумент) Тогда
			ДоступДобавление = Истина;
			Прервать;
		КонецЕсли;	
	КонецЦикла;	
	
	Если ПолучитьФункциональнуюОпцию("ФондоваяКнигаОтдельноОтДенежной") Тогда
		
		Элементы.ОтчетыКассираСоздатьОтчетКассираОбщий_52н.Видимость 	= Ложь;
		Элементы.ОтчетыКассираСоздатьОтчетКассираОбщий_52н.Видимость 	= Ложь;
		
		Элементы.ОтчетыКассираПодменюСоздать.Видимость 				= ДоступДобавление;
		Элементы.ОтчетыКассираКонтекстноеПодменюСоздать.Видимость 	= ДоступДобавление;
		
		Элементы.ОтчетыКассираФондовый.Видимость = Ложь;
		
	Иначе
		
		Элементы.ОтчетыКассираСоздатьОтчетКассираОбщий_52н.Видимость 	= ДоступДобавление;
		Элементы.ОтчетыКассираСоздатьОтчетКассираОбщий_52н.Видимость 	= ДоступДобавление;
		
		Элементы.ОтчетыКассираПодменюСоздать.Видимость 				= Ложь;
		Элементы.ОтчетыКассираКонтекстноеПодменюСоздать.Видимость 	= Ложь;
		
		Элементы.ОтчетыКассираФондовый.Видимость = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиВидимостиСписковНаСервере()
	
	Если ПравоДоступа("СохранениеДанныхПользователя", Метаданные) Тогда
		ЗначениеНастройки = Новый Структура;
		ЗначениеНастройки.Вставить("СписокПриходныхДокументов", СписокПриходныхДокументов);
		ЗначениеНастройки.Вставить("СписокРасходныхДокументов", СписокРасходныхДокументов);
		ЗначениеНастройки.Вставить("СписокПриходныхДокументовФондовых", СписокПриходныхДокументовФондовых);
		ЗначениеНастройки.Вставить("СписокРасходныхДокументовФондовых", СписокРасходныхДокументовФондовых);
		ХранилищеОбщихНастроек.Сохранить("КассаОрганизации_НастройкиВидимостиСписков", , ЗначениеНастройки);
	КонецЕсли;

КонецПроцедуры

