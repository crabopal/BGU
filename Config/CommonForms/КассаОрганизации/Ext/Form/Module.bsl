
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДоступДобавление = Ложь;
	ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();
	ПараметрыРазмещения.КоманднаяПанель = Элементы.РасходныеДокументы.КоманднаяПанель;
	ПараметрыРазмещения.Источники = Новый Массив;
	ПараметрыРазмещения.ПрефиксГрупп = "РасходныеДокументы";
	Для Каждого РегДокумент Из Метаданные.ЖурналыДокументов.ЖурналРасходныхКассовыхДокументов.РегистрируемыеДокументы Цикл
		Если ПравоДоступа("Добавление", РегДокумент) Тогда
			ДоступДобавление = Истина;
		КонецЕсли;	
		ПараметрыРазмещения.Источники.Добавить(РегДокумент);
	КонецЦикла;	
	Если НЕ ДоступДобавление Тогда
		Элементы.РасходныеДокументы.ИзменятьСоставСтрок		= Ложь;
	КонецЕсли;
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	
	ДоступДобавление = Ложь;
	Для Каждого РегДокумент Из Метаданные.ЖурналыДокументов.ОтчетыКассира.РегистрируемыеДокументы Цикл
		Если ПравоДоступа("Добавление", РегДокумент) Тогда
			ДоступДобавление = Истина;
			Прервать;
		КонецЕсли;	
	КонецЦикла;	
	Если НЕ ДоступДобавление Тогда
		Элементы.ОтчетыКассира.ИзменятьСоставСтрок		= Ложь;
	КонецЕсли;
	
	Для Каждого РегДокумент Из Метаданные.ЖурналыДокументов.ЖурналНеоплаченныхПутевок.РегистрируемыеДокументы Цикл
		Если ПравоДоступа("Чтение", РегДокумент) Тогда
			ДоступныНеоплаченныеПутевки = Истина;
			Прервать;
		КонецЕсли;	
	КонецЦикла;	
	Элементы.ЖурналПутевки.Видимость = ДоступныНеоплаченныеПутевки;
	
	Если ДоступныНеоплаченныеПутевки Тогда
		
		ОбщегоНазначенияБГУ.ПолучитьСписокВыбораДляОтбораПоТипуДокумента("ЖурналНеоплаченныхПутевок", Элементы.ОтборВидДокумента);
		
		ДоступДобавление = Ложь;
		ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();
		ПараметрыРазмещения.КоманднаяПанель = Элементы.Путевки.КоманднаяПанель;
		ПараметрыРазмещения.Источники = Новый Массив;
		ПараметрыРазмещения.ПрефиксГрупп = "Путевки";

		Для Каждого РегДокумент Из Метаданные.ЖурналыДокументов.ЖурналНеоплаченныхПутевок.РегистрируемыеДокументы Цикл
			Если ПравоДоступа("Добавление", РегДокумент) Тогда
				ДоступДобавление = Истина;
			КонецЕсли;	
			ПараметрыРазмещения.Источники.Добавить(РегДокумент);
		КонецЦикла;	
		Если НЕ ДоступДобавление Тогда
			Элементы.Путевки.ИзменятьСоставСтрок		= Ложь;
		КонецЕсли;
		ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);

	КонецЕсли;	
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();
	ПараметрыРазмещения.КоманднаяПанель = Элементы.ПриходныеДокументы.КоманднаяПанель;
	ПараметрыРазмещения.Источники = Новый Массив;
	ПараметрыРазмещения.Источники.Добавить(Метаданные.Документы.ПриходныйКассовыйОрдер);
	ПараметрыРазмещения.ПрефиксГрупп = "ПриходныеДокументы";
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();
	ПараметрыРазмещения.КоманднаяПанель = Элементы.ПриходныеДокументыФондовые.КоманднаяПанель;
	ПараметрыРазмещения.Источники = Новый Массив;
	ПараметрыРазмещения.Источники.Добавить(Метаданные.Документы.ПриходныйОрдерФондовый);
	ПараметрыРазмещения.ПрефиксГрупп = "ПриходныеДокументыФондовые";
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();
	ПараметрыРазмещения.КоманднаяПанель = Элементы.РасходныеДокументыФондовые.КоманднаяПанель;
	ПараметрыРазмещения.Источники = Новый Массив;
	ПараметрыРазмещения.Источники.Добавить(Метаданные.Документы.РасходныйОрдерФондовый);
	ПараметрыРазмещения.ПрефиксГрупп = "РасходныеДокументыФондовые";
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОтборОрганизация = ЗаполнениеРеквизитовОбъектов.ОрганизацияПоУмолчанию();
	
	Если ЗначениеЗаполнено(ОтборОрганизация) Тогда
		
		УстановитьОтборОрганизацииНаСервере()
 		
	КонецЕсли;
	
	Элементы.ОстаткиДенежныхДокументовФондовыеКоличествоОстаток.Видимость = ПолучитьФункциональнуюОпцию("ВестиКоличественныйУчетДенежныхДокументов");
		
	УстановитьМенюОтчетовКассира();
	
	Если ПравоДоступа("СохранениеДанныхПользователя", Метаданные) Тогда
		ЗначениеНастройки = ХранилищеОбщихНастроек.Загрузить("КассаОрганизации_НастройкиВидимостиСписков");
	Иначе
		ЗначениеНастройки = Неопределено;
	КонецЕсли;	
	
	Если ЗначениеНастройки = Неопределено Тогда
		СписокПриходныхДокументов 			= Истина;
		СписокРасходныхДокументов 			= Истина;
		СписокПриходныхДокументовФондовых 	= Истина;
		СписокРасходныхДокументовФондовых 	= Истина;
	Иначе
		Если НЕ ЗначениеНастройки.Свойство("СписокПриходныхДокументов", СписокПриходныхДокументов) Тогда
			СписокПриходныхДокументов = Истина;
		КонецЕсли;
		Если НЕ ЗначениеНастройки.Свойство("СписокРасходныхДокументов", СписокРасходныхДокументов) Тогда
			СписокРасходныхДокументов = Истина;
		КонецЕсли;
		Если НЕ ЗначениеНастройки.Свойство("СписокПриходныхДокументовФондовых", СписокПриходныхДокументовФондовых) Тогда
			СписокПриходныхДокументовФондовых = Истина;
		КонецЕсли;
		Если НЕ ЗначениеНастройки.Свойство("СписокРасходныхДокументовФондовых", СписокРасходныхДокументовФондовых) Тогда
			СписокРасходныхДокументовФондовых = Истина;
		КонецЕсли;
	КонецЕсли;
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервереФормыСписка(ЭтотОбъект, "ПриходныеДокументы", "ПриходныеДокументыСтатусПОД");
	ОбщегоНазначенияБГУ.ПриСозданииНаСервереФормыСписка(ЭтотОбъект, "РасходныеДокументы", "РасходныеДокументыСтатусПОД");
	ОбщегоНазначенияБГУ.ПриСозданииНаСервереФормыСписка(ЭтотОбъект, "ПриходныеДокументыФондовые", "ПриходныеДокументыФондовыеСтатусПОД");
	ОбщегоНазначенияБГУ.ПриСозданииНаСервереФормыСписка(ЭтотОбъект, "РасходныеДокументыФондовые", "РасходныеДокументыФондовыеСтатусПОД");
	ОбщегоНазначенияБГУ.ПриСозданииНаСервереФормыСписка(ЭтотОбъект, "ОтчетыКассира", "ОтчетыКассираСтатусПОД");
	ОбщегоНазначенияБГУ.ПриСозданииНаСервереФормыСписка(ЭтотОбъект, "Путевки", "ПутевкиСтатусПОД");

	// ИнтеграцияС1САрхивом
	Если ОбщегоНазначения.ПодсистемаСуществует("ИнтеграцияС1САрхивом") Тогда
		МодульОбменСАрхивом = ОбщегоНазначения.ОбщийМодуль("ОбменСАрхивом");  
		ПараметрыРазмещения = МодульОбменСАрхивом.ПараметрыРазмещенияЭлементов();
		ПараметрыРазмещения.ИмяСписка = "ПриходныеДокументы";
		МодульОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
		ПараметрыРазмещения.ИмяСписка = "РасходныеДокументы";
		МодульОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
		ПараметрыРазмещения.ИмяСписка = "ПриходныеДокументыФондовые";
		МодульОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
		ПараметрыРазмещения.ИмяСписка = "РасходныеДокументыФондовые";
		МодульОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
		ПараметрыРазмещения.ИмяСписка = "ОтчетыКассира";
		МодульОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
		ПараметрыРазмещения.ИмяСписка = "Путевки";
		МодульОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	КонецЕсли;
	// Конец ИнтеграцияС1САрхивом	
	
	УстановитьВидимостьСписков();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;	
	
	СохранитьНастройкиВидимостиСписковНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "РегистрНакопленияНаличныеДенежныеСредстваИзменение" Тогда
		Элементы.ОстаткиНаличныхДенежныхСредств.Обновить();
		ОстаткиНаличныхДенежныхСредствСуммаИтого();
		
	ИначеЕсли ИмяСобытия = "РегистрНакопленияДенежныеДокументыИзменение" Тогда
		Элементы.ОстаткиДенежныхДокументовФондовые.Обновить();
		ОстаткиНаличныхДенежныхСредствСуммаИтогоФондовые();
		
	ИначеЕсли ИмяСобытия = "ИзменениеОсновнойОрганизации" Тогда
		ИзменениеОсновнойОрганизацииНаСервере();
		
	ИначеЕсли ИмяСобытия = "ПараметрыКассовойКнигиИзменение" Тогда
		УстановитьМенюОтчетовКассира();
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборОрганизацияПриИзменении(Элемент)
	
	УстановитьОтборОрганизацииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборПодразделениеИспользованиеПриИзменении(Элемент)
	
	ОтборПодразделение = ?(ОтборПодразделениеИспользование, ОтборПодразделение, ПредопределенноеЗначение("Справочник.Подразделения.ПустаяСсылка"));
	
	УстановитьОтборПодразделенияНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ОтборПодразделениеПриИзменении(Элемент)
	
	ОтборПодразделениеИспользование =  ОтборПодразделениеИспользование ИЛИ ЗначениеЗаполнено(ОтборПодразделение);
	
	УстановитьОтборПодразделенияНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборВидДокументаПриИзменении(Элемент)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Путевки.Отбор, "Тип", ?(ЗначениеЗаполнено(ОтборВидДокумента),Тип("ДокументСсылка."+ОтборВидДокумента),""),,, ЗначениеЗаполнено(ОтборВидДокумента));

КонецПроцедуры

&НаКлиенте
Процедура СписокПриходныхДокументовПриИзменении(Элемент)
	УстановитьВидимостьСписков("ПриходныеДокументы", СписокПриходныхДокументов);
КонецПроцедуры

&НаКлиенте
Процедура СписокРасходныхДокументовПриИзменении(Элемент)
	УстановитьВидимостьСписков("РасходныеДокументы", СписокРасходныхДокументов);
КонецПроцедуры

&НаКлиенте
Процедура СписокПриходныхДокументовФондовыхПриИзменении(Элемент)
	УстановитьВидимостьСписков("ПриходныеДокументыФондовые", СписокПриходныхДокументовФондовых);
КонецПроцедуры

&НаКлиенте
Процедура СписокРасходныхДокументовФондовыхПриИзменении(Элемент)
	УстановитьВидимостьСписков("РасходныеДокументыФондовые", СписокРасходныхДокументовФондовых);
КонецПроцедуры

&НаКлиенте
Процедура ГруппаСтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ПриходныеДокументы

&НаКлиенте
Процедура ПриходныеДокументыПриАктивизацииСтроки(Элемент)
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
КонецПроцедуры

&НаКлиенте
Процедура ПриходныеДокументыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	ОбщегоНазначенияБГУКлиент.НачатьЗамерВремениДобавление(Параметр);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриходныеДокументыПередНачаломИзменения(Элемент, Отказ)
	
	ОбщегоНазначенияБГУКлиент.НачатьЗамерВремениОткрытие(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриходныеДокументыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Поле = Элементы.ПриходныеДокументыСостояниеЭДО Тогда
		// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
		ОбменСКонтрагентамиКлиент.СостояниеЭДОНажатие_ФормаСписка(ВыбраннаяСтрока, СтандартнаяОбработка);
		// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиент.СписокВыбор(ЭтотОбъект, Поле, ВыбраннаяСтрока, СтандартнаяОбработка);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_РасходныеДокументы

&НаКлиенте
Процедура РасходныеДокументыПриАктивизацииСтроки(Элемент)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

КонецПроцедуры

&НаКлиенте
Процедура РасходныеДокументыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	ОбщегоНазначенияБГУКлиент.НачатьЗамерВремениДобавление(Параметр);
	
КонецПроцедуры

&НаКлиенте
Процедура РасходныеДокументыПередНачаломИзменения(Элемент, Отказ)
	
	ОбщегоНазначенияБГУКлиент.НачатьЗамерВремениОткрытие(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура РасходныеДокументыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Поле = Элементы.РасходныеДокументыСостояниеЭДО Тогда
		// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
		ОбменСКонтрагентамиКлиент.СостояниеЭДОНажатие_ФормаСписка(ВыбраннаяСтрока, СтандартнаяОбработка);
		// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиент.СписокВыбор(ЭтотОбъект, Поле, ВыбраннаяСтрока, СтандартнаяОбработка);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ПриходныеДокументыФондовые

&НаКлиенте
Процедура ПриходныеДокументыФондовыеПриАктивизацииСтроки(Элемент)
