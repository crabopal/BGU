// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	
	Источник = ЭтотОбъект.ТекущийЭлемент;
	
	Если ТипЗнч(ЭтотОбъект.ТекущийЭлемент) = Тип("ТаблицаФормы") Тогда
		Если СтрНайти(Команда.Имя, "ПриходныеДокументыФондовые") > 0 Тогда
			Источник = Элементы["ПриходныеДокументыФондовые"];
		ИначеЕсли СтрНайти(Команда.Имя, "РасходныеДокументыФондовые") > 0 Тогда	
			Источник = Элементы["РасходныеДокументыФондовые"];
		ИначеЕсли СтрНайти(Команда.Имя, "ПриходныеДокументы") > 0 Тогда
			Источник = Элементы["ПриходныеДокументы"];
		ИначеЕсли СтрНайти(Команда.Имя, "РасходныеДокументы") > 0 Тогда	
			Источник = Элементы["РасходныеДокументы"];	
		КонецЕсли;	
	Иначе
		Если СтрНайти(Команда.Имя, "Печать") > 0 Тогда
			Возврат;
		КонецЕсли;	
	КонецЕсли;	

	ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Источник);
	
КонецПроцедуры

&НаСервере
Процедура Подключаемый_ВыполнитьКомандуНаСервере(Контекст, Результат) Экспорт
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, Контекст, ЭтотОбъект.ТекущийЭлемент, Результат);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя = "ЖурналПРКД" Тогда
		Если Элементы["РасходныеДокументы"].ТекущиеДанные = Неопределено Тогда
			ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Элементы["ПриходныеДокументы"]);
		Иначе
			ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Элементы["РасходныеДокументы"]);
		КонецЕсли;
	ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя = "ЖурналПРКДФ" Тогда
		Если Элементы["РасходныеДокументыФондовые"].ТекущиеДанные = Неопределено Тогда
			ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Элементы["ПриходныеДокументыФондовые"]);
		Иначе	
			ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Элементы["РасходныеДокументыФондовые"]);
		КонецЕсли;	
	ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница.Имя = "ЖурналПутевки" Тогда
		ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Элементы["Путевки"]);
	КонецЕсли;

КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуБГУ(Команда)
	
	Если Лев(Команда.Имя, 44) = "ВнутреннийЭДО_ПросмотретьЭлектронныйДокумент" Тогда
		ИмяТабЧасти = Сред(Команда.Имя, 45);
	ИначеЕсли Лев(Команда.Имя, 41) = "ВнутреннийЭДО_СоздатьЭлектронныеДокументы" Тогда
		ИмяТабЧасти = Сред(Команда.Имя, 42);
	ИначеЕсли Лев(Команда.Имя, 46) = "ВнутреннийЭДО_АннулироватьЭлектронныеДокументы" Тогда
		ИмяТабЧасти = Сред(Команда.Имя, 47);
	ИначеЕсли Лев(Команда.Имя, 50) = "ВнутреннийЭДО_ОткрытьЭлектронныеДокументыНаПодпись" Тогда
		ИмяТабЧасти = Сред(Команда.Имя, 51);
	Иначе
		Возврат;
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиент.ВыполнитьПодключаемуюКоманду(Команда, ЭтотОбъект, Элементы[ИмяТабЧасти]);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьВидимостьСписков(ИмяЭлемента = Неопределено, ВидимостьЭлемента = Неопределено)
	
	Если ИмяЭлемента = Неопределено Тогда
		Элементы.ПриходныеДокументы.Видимость 			= СписокПриходныхДокументов;
		Элементы.РасходныеДокументы.Видимость 			= СписокРасходныхДокументов;
		Элементы.ПриходныеДокументыФондовые.Видимость 	= СписокПриходныхДокументовФондовых;
		Элементы.РасходныеДокументыФондовые.Видимость 	= СписокРасходныхДокументовФондовых;
	Иначе
		Элементы[ИмяЭлемента].Видимость = ВидимостьЭлемента;
	КонецЕсли;
											
КонецПроцедуры	

&НаСервере
Процедура УстановитьОтборОрганизацииНаСервере()
	
	// Денежная касса
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ПриходныеДокументы.Отбор, "Организация", ОтборОрганизация,,, ЗначениеЗаполнено(ОтборОрганизация));
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(РасходныеДокументы.Отбор, "Организация", ОтборОрганизация,,, ЗначениеЗаполнено(ОтборОрганизация));
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ОстаткиНаличныхДенежныхСредств.Отбор, "Организация", ОтборОрганизация,,, ЗначениеЗаполнено(ОтборОрганизация));
		
	// Фондовая касса
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ПриходныеДокументыФондовые.Отбор, "Организация", ОтборОрганизация,,, ЗначениеЗаполнено(ОтборОрганизация));
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(РасходныеДокументыФондовые.Отбор, "Организация", ОтборОрганизация,,, ЗначениеЗаполнено(ОтборОрганизация));
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ОстаткиДенежныхДокументовФондовые.Отбор, "Организация", ОтборОрганизация,,, ЗначениеЗаполнено(ОтборОрганизация));

	// Отчеты кассира
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ОтчетыКассира.Отбор, "Организация", ОтборОрганизация,,, ЗначениеЗаполнено(ОтборОрганизация));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОтчетыКассираОрганизация", "Видимость", Не ЗначениеЗаполнено(ОтборОрганизация));

	// Путевки неоплаченные
	Если ДоступныНеоплаченныеПутевки Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Путевки.Отбор, "Организация", ОтборОрганизация,,, ЗначениеЗаполнено(ОтборОрганизация));
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПутевкиОрганизация", "Видимость", Не ЗначениеЗаполнено(ОтборОрганизация));
	КонецЕсли;
	
	//Наличие Обособленных подразделений
	
	ДоступныОП = ОрганизационнаяСтруктура.ЕстьНеВыделенныеНаБалансОбособленныеПодразделения(ОтборОрганизация, Истина);
	
	ОтборПодразделениеИспользование = ОтборПодразделениеИспользование И ДоступныОП;
	
	ОтборПодразделение = ?(ДоступныОП, ОтборПодразделение, ПредопределенноеЗначение("Справочник.Подразделения.ПустаяСсылка"));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОтборПодразделениеИспользование", "Доступность", ДоступныОП);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОтборПодразделение", "Доступность", ДоступныОП);

	УстановитьОтборПодразделенияНаСервере();
 	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборПодразделенияНаСервере()
	
	// Денежная касса
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ПриходныеДокументы, "ОП", ЛОЖЬ, , , ОтборПодразделениеИспользование И НЕ ЗначениеЗаполнено(ОтборПодразделение));
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ПриходныеДокументы, "Подразделение", ОтборПодразделение, , , ОтборПодразделениеИспользование И ЗначениеЗаполнено(ОтборПодразделение));
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(РасходныеДокументы, "ОП", ЛОЖЬ, , , ОтборПодразделениеИспользование И НЕ ЗначениеЗаполнено(ОтборПодразделение));
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(РасходныеДокументы, "Подразделение", ОтборПодразделение, , , ОтборПодразделениеИспользование И ЗначениеЗаполнено(ОтборПодразделение));
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ОстаткиНаличныхДенежныхСредств, "ОП", ЛОЖЬ, , , ОтборПодразделениеИспользование И НЕ ЗначениеЗаполнено(ОтборПодразделение));
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ОстаткиНаличныхДенежныхСредств, "Подразделение", ОтборПодразделение, , , ОтборПодразделениеИспользование И ЗначениеЗаполнено(ОтборПодразделение));
	ИтогоОстаток = ПолучитьОстаткиПоРегистру(ОтборОрганизация, ОтборПодразделение, ОтборПодразделениеИспользование);
	
	// Фондовая касса
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ПриходныеДокументыФондовые, "ОП", ЛОЖЬ, , , ОтборПодразделениеИспользование И НЕ ЗначениеЗаполнено(ОтборПодразделение));
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ПриходныеДокументыФондовые, "Подразделение", ОтборПодразделение, , , ОтборПодразделениеИспользование И ЗначениеЗаполнено(ОтборПодразделение));
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(РасходныеДокументыФондовые, "ОП", ЛОЖЬ, , , ОтборПодразделениеИспользование И НЕ ЗначениеЗаполнено(ОтборПодразделение));
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(РасходныеДокументыФондовые, "Подразделение", ОтборПодразделение, , , ОтборПодразделениеИспользование И ЗначениеЗаполнено(ОтборПодразделение));
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ОстаткиДенежныхДокументовФондовые, "ОП", ЛОЖЬ, , , ОтборПодразделениеИспользование И НЕ ЗначениеЗаполнено(ОтборПодразделение));
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ОстаткиДенежныхДокументовФондовые, "Подразделение", ОтборПодразделение, , , ОтборПодразделениеИспользование И ЗначениеЗаполнено(ОтборПодразделение));
    СуммаИтогоДенежныхДокументовФондовые = ПолучитьОстаткиПоРегиструФондовые(ОтборОрганизация, ОтборПодразделение, ОтборПодразделениеИспользование);
	
	// Отчеты кассира
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ОтчетыКассира, "ОП", ЛОЖЬ, , , ОтборПодразделениеИспользование И НЕ ЗначениеЗаполнено(ОтборПодразделение));
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ОтчетыКассира, "Подразделение", ОтборПодразделение, , , ОтборПодразделениеИспользование И ЗначениеЗаполнено(ОтборПодразделение));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОтчетыКассираПодразделение", "Видимость", ДоступныОП И НЕ ОтборПодразделениеИспользование);
	
КонецПроцедуры	

