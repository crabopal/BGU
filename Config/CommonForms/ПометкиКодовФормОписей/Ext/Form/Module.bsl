#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗагрузитьПереданныеЗначения();
	
	УстановитьУсловноеОформление();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаОК(Команда)
	
	Закрыть(ПолучитьВозвращаемоеЗначение());
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОтмена(Команда)
	
	Закрыть();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗагрузитьПереданныеЗначения()
	
	Перем СоответствуетОтбору;
	
	УстановленОтборПоКодуФормы = (Параметры.ОтборМассивКодовФорм.Количество() > 0);
	
	Таблица.Очистить();
	
	Для Каждого Элемент Из Параметры.СписокВыбора Цикл
		КодФормы = Элемент.Значение;
		
		НайденаОпись = (Параметры.КодыФормОписей.Найти(КодФормы) <> Неопределено);
		
		НетПрав = (Параметры.КодыФормНетПрав.Найти(КодФормы) <> Неопределено);
		
		Если УстановленОтборПоКодуФормы Тогда
			СоответствуетОтбору = (Параметры.ОтборМассивКодовФорм.Найти(КодФормы) <> Неопределено);
		КонецЕсли;
		
		ЗначениеДоступность = Истина;
		Комментарий = "";
		
		Если НайденаОпись Тогда
			ЗначениеДоступность = Ложь;
			Комментарий = ПолучитьТекстКомментарияНайденаОпись();
			
		ИначеЕсли НетПрав Тогда
			ЗначениеДоступность = Ложь;
			Комментарий = ПолучитьТекстКомментарияНетПрав();
			
		ИначеЕсли УстановленОтборПоКодуФормы И Не СоответствуетОтбору Тогда
			ЗначениеДоступность = Ложь;
			Комментарий = ПолучитьТекстКомментарияНеУдовлетворяетОтбору();
		КонецЕсли;
		
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.Пометка = Элемент.Пометка;
		НоваяСтрока.Значение = КодФормы;
		НоваяСтрока.Доступность = ЗначениеДоступность;
		НоваяСтрока.Комментарий = Комментарий;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТекстКомментарияНайденаОпись()
	
	Возврат НСтр("ru='выбор невозможен, опись создана'");
	
КонецФункции

&НаСервере
Функция ПолучитьТекстКомментарияНетПрав()
	
	Возврат НСтр("ru='выбор невозможен, нет права создания'");
	
КонецФункции

&НаСервере
Функция ПолучитьТекстКомментарияНеУдовлетворяетОтбору()
	
	Возврат НСтр("ru='выбор невозможен, не удовлетворяет отбору'");
	
КонецФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	ИмяТаблицы = "Таблица";
	
	НовыйЭлементУО = УсловноеОформление.Элементы.Добавить();
	НовыйЭлементУО.Представление = НСтр("ru='Недоступность заблокированной строки.'");
	
	// Условие
	Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяТаблицы + ".Доступность");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Ложь;
	
	// Оформление
	НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветНедоступноеПоле);
	
	// Оформляемые поля
	ОформляемоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТаблицы);
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьВозвращаемоеЗначение()
	
	ЕстьДоступныеНеПомеченные = Ложь;
	
	ПомеченныеКодыФорм = Новый Массив();
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если СтрокаТаблицы.Пометка Тогда
			ПомеченныеКодыФорм.Добавить(СтрокаТаблицы.Значение);
		КонецЕсли;
		
		Если СтрокаТаблицы.Доступность И Не СтрокаТаблицы.Пометка Тогда
			ЕстьДоступныеНеПомеченные = Истина;
		КонецЕсли;
	КонецЦикла;
	
	ВозвращаемоеЗначение = Новый Структура();
	ВозвращаемоеЗначение.Вставить("ПомеченныеКодыФорм", ПомеченныеКодыФорм);
	ВозвращаемоеЗначение.Вставить("ЕстьДоступныеНеПомеченные", ЕстьДоступныеНеПомеченные);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

#КонецОбласти