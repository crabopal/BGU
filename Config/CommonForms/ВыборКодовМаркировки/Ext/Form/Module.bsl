
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	НаименованиеТаблицыНоменклатуры = НСтр("ru = 'По документам'");
	
	Параметры.Свойство("Номенклатура", Номенклатура);
	Параметры.Свойство("Количество",   Количество);
	
	Если Параметры.Свойство("КодыУпаковокМаркируемойПродукции") Тогда
		ЗагрузитьНомераУпаковокВТаблицу(Параметры.КодыУпаковокМаркируемойПродукции,
			КодыУпаковокМаркируемойПродукции);
	КонецЕсли;
	Если Параметры.Свойство("ТипыУпаковокМаркируемойПродукции") Тогда
		ЗагрузитьТипыУпаковокВТаблицу(Параметры.ТипыУпаковокМаркируемойПродукции,
			КодыУпаковокМаркируемойПродукции);
	КонецЕсли;
		
	Если Параметры.Свойство("КодыУпаковокМаркируемойПродукцииПоФакту") Тогда
		ЗагрузитьНомераУпаковокВТаблицу(Параметры.КодыУпаковокМаркируемойПродукцииПоФакту,
			КодыУпаковокМаркируемойПродукции);
		НаименованиеТаблицыНоменклатуры = НСтр("ru = 'По факту'");
	КонецЕсли;
	Если Параметры.Свойство("ТипыУпаковокМаркируемойПродукцииПоФакту") Тогда
		ЗагрузитьТипыУпаковокВТаблицу(Параметры.ТипыУпаковокМаркируемойПродукцииПоФакту,
			КодыУпаковокМаркируемойПродукции);
	КонецЕсли;
	
	Если Параметры.Свойство("КодыУпаковокМаркируемойПродукцииБрак") Тогда
		ЗагрузитьНомераУпаковокВТаблицу(Параметры.КодыУпаковокМаркируемойПродукцииБрак,
			КодыУпаковокМаркируемойПродукции);
		НаименованиеТаблицыНоменклатуры = НСтр("ru = 'Брак'");
	КонецЕсли;
	Если Параметры.Свойство("ТипыУпаковокМаркируемойПродукцииБрак") Тогда
		ЗагрузитьТипыУпаковокВТаблицу(Параметры.ТипыУпаковокМаркируемойПродукцииБрак,
			КодыУпаковокМаркируемойПродукции);
	КонецЕсли;
	
	Если Параметры.Свойство("КодыУпаковокМаркируемойПродукцииБой") Тогда
		ЗагрузитьНомераУпаковокВТаблицу(Параметры.КодыУпаковокМаркируемойПродукцииБой,
			КодыУпаковокМаркируемойПродукции);
		НаименованиеТаблицыНоменклатуры = НСтр("ru = 'Бой'");
	КонецЕсли;
	Если Параметры.Свойство("ТипыУпаковокМаркируемойПродукцииБой") Тогда
		ЗагрузитьТипыУпаковокВТаблицу(Параметры.ТипыУпаковокМаркируемойПродукцииБой,
			КодыУпаковокМаркируемойПродукции);
	КонецЕсли;
	
	Если Параметры.Свойство("КодыУпаковокМаркируемойПродукцииНедостача") Тогда
		ЗагрузитьНомераУпаковокВТаблицу(Параметры.КодыУпаковокМаркируемойПродукцииНедостача,
			КодыУпаковокМаркируемойПродукции);
		НаименованиеТаблицыНоменклатуры = НСтр("ru = 'Недостача'");
	КонецЕсли;
	Если Параметры.Свойство("ТипыУпаковокМаркируемойПродукцииНедостача") Тогда
		ЗагрузитьТипыУпаковокВТаблицу(Параметры.ТипыУпаковокМаркируемойПродукцииНедостача,
			КодыУпаковокМаркируемойПродукции);
	КонецЕсли;
	
	Если Параметры.Свойство("КодыУпаковокМаркируемойПродукцииИзлишки") Тогда
		ЗагрузитьНомераУпаковокВТаблицу(Параметры.КодыУпаковокМаркируемойПродукцииИзлишки,
			КодыУпаковокМаркируемойПродукции);
		НаименованиеТаблицыНоменклатуры = НСтр("ru = 'Излишки'");
	КонецЕсли;
	Если Параметры.Свойство("ТипыУпаковокМаркируемойПродукцииНедостача") Тогда
		ЗагрузитьТипыУпаковокВТаблицу(Параметры.ТипыУпаковокМаркируемойПродукцииНедостача,
			КодыУпаковокМаркируемойПродукции);
	КонецЕсли;
	
	Если Параметры.ТолькоПросмотр = Истина Тогда		
		Элементы.ФормаОК.Видимость     = Ложь;
		Элементы.ФормаОтмена.Заголовок = НСтр("ru = 'Закрыть'");
	КонецЕсли;      
	
	Если Параметры.Свойство("ПараметрыПодбора") И ЗначениеЗаполнено(Параметры.ПараметрыПодбора) Тогда
		Организация = Параметры.ПараметрыПодбора.Организация;
		Дата 		= Параметры.ПараметрыПодбора.Дата;
	КонецЕсли;
	
	КоличествоКодовУпаковок = КодыУпаковокМаркируемойПродукции.Количество();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "ОбщаяФорма.ДобавлениеСпискаКодовМаркировки" Тогда
		ОбработкаДобавленияСпискаКодовНаСервере(ВыбранноеЗначение);
	КонецЕсли;
	
КонецПроцедуры	

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОК(Команда)
	
	ПроверкаУспешноВыполнена = Ложь;
	Если НеПроверятьКодыУпаковок Тогда
		ПроверкаУспешноВыполнена = Истина;
	Иначе	
		ПроверкаУспешноВыполнена = ПроверкаЗаполненияВыполнена();
	КонецЕсли;	
	
	Если ПроверкаУспешноВыполнена Тогда
		РезультатВыбора = Новый Структура;
		РезультатВыбора.Вставить("КодыУпаковокМаркируемойПродукции",
			НомераУпаковокИзТаблицы(КодыУпаковокМаркируемойПродукции));
		РезультатВыбора.Вставить("ТипыУпаковокМаркируемойПродукции",
			ТипыУпаковокИзТаблицы(КодыУпаковокМаркируемойПродукции));
			
		Закрыть(РезультатВыбора);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСписокКодовМаркировки(Команда)
	
	ОткрытьФорму("ОбщаяФорма.ДобавлениеСпискаКодовМаркировки", , ЭтаФорма, ЭтаФорма.УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура Подбор(Команда)
	
		ОбработчикОповещения = Новый ОписаниеОповещения("ОповещениеОткрытьФормуВыбораКода", ЭтотОбъект);
		Режим = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Организация"			, Организация);
		ПараметрыФормы.Вставить("Номенклатура"			, Номенклатура);
		ПараметрыФормы.Вставить("ОСУ"					, Ложь);  
		ПараметрыФормы.Вставить("ДатаОстатков"			, Дата);
		ПараметрыФормы.Вставить("МножественныйВыбор"	, Истина);
						
		ОткрытьФорму("ОбщаяФорма.ВыборКодаИСМПБГУ", ПараметрыФормы,,,,, ОбработчикОповещения, Режим);

КонецПроцедуры
	
#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_КодыИндивидуальныхУпаковокМаркируемойПродукции

&НаКлиенте
Процедура КодыУпаковокМаркируемойПродукцииПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	КоличествоКодовУпаковок = КодыУпаковокМаркируемойПродукции.Количество();
	Если НоваяСтрока И НЕ Копирование Тогда
		ТекДанные = Элементы.КодыУпаковокМаркируемойПродукции.ТекущиеДанные;
		ТекДанные.ТипУпаковки = НСтр("ru = 'Индивидуальная упаковка'");
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура КодыУпаковокМаркируемойПродукцииПослеУдаления(Элемент)
	КоличествоКодовУпаковок = КодыУпаковокМаркируемойПродукции.Количество();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗагрузитьНомераУпаковокВТаблицу(СписокУпаковок, Таблица)
	
	Для Каждого КодУпаковки Из СписокУпаковок Цикл
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.НомерУпаковки = КодУпаковки;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьТипыУпаковокВТаблицу(СписокТиповУпаковок, Таблица)
	
	НомерСтроки = 0;
	Для Каждого ТипУпаковки Из СписокТиповУпаковок Цикл
		НоваяСтрока = Таблица[НомерСтроки];
		НоваяСтрока.ТипУпаковки = ТипУпаковки;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Функция НомераУпаковокИзТаблицы(Таблица)

	Результат = Новый Массив;
	Для каждого СтрокаТаблицы Из Таблица Цикл
		ТекстКода = СтрокаТаблицы.НомерУпаковки;
		Если КодСимвола(Сред(ТекстКода, СтрДлина(ТекстКода), 1)) = 182 Тогда
			ТекстКода = Сред(ТекстКода, 1, СтрДлина(ТекстКода)-1);	
		КонецЕсли;
		
		Результат.Добавить(ТекстКода);
	КонецЦикла;
	
	Возврат Результат;

КонецФункции

&НаКлиенте
Функция ТипыУпаковокИзТаблицы(Таблица)

	Результат = Новый Массив;
	Для каждого СтрокаТаблицы Из Таблица Цикл
		ТекстКода = СтрокаТаблицы.ТипУпаковки;
		Если КодСимвола(Сред(ТекстКода, СтрДлина(ТекстКода), 1)) = 182 Тогда
			ТекстКода = Сред(ТекстКода, 1, СтрДлина(ТекстКода)-1);	
		КонецЕсли;
		
		Результат.Добавить(ТекстКода);
	КонецЦикла;
	
	Возврат Результат;

КонецФункции

&НаСервере
Функция ПроверкаЗаполненияВыполнена()

	Результат = Истина;
	
	// Проверяем формат потребительских упаковок.
	ИндексСтроки = 0;
	Для Каждого Строка Из КодыУпаковокМаркируемойПродукции Цикл
		Если Не КодМаркируемойУпаковкиСоответствуетТребованиям(Строка.НомерУпаковки, ИндексСтроки) Тогда
			Результат = Ложь;
		КонецЕсли;
		
		ИндексСтроки = ИндексСтроки + 1;
	КонецЦикла;
	
	// Если предыдущие проверки пройдены успешно, проверяем, что упаковки не задублированы.
	Если Результат Тогда
		ОбщаяТаблицаУпаковок = КодыУпаковокМаркируемойПродукции.Выгрузить();
				
		ОбщаяТаблицаУпаковок.Колонки.Добавить("Количество");
		ОбщаяТаблицаУпаковок.ЗаполнитьЗначения(1, "Количество");
		ОбщаяТаблицаУпаковок.Свернуть("НомерУпаковки", "Количество");
		
		Для Каждого СтрокаТаблицыУпаковок Из ОбщаяТаблицаУпаковок Цикл
			Если СтрокаТаблицыУпаковок.Количество > 1 Тогда
				ТекстОшибки = НСтр("ru = 'Упаковка %1 введена несколько раз'");
				ТекстОшибки = СтрШаблон(ТекстОшибки, СтрокаТаблицыУпаковок.НомерУпаковки);
				
				ПараметрыПоискаСтрок = Новый Структура("НомерУпаковки", СтрокаТаблицыУпаковок.НомерУпаковки);
				СтрокиУпаковки = КодыУпаковокМаркируемойПродукции.НайтиСтроки(ПараметрыПоискаСтрок);
				ШаблонИмениПоля = "КодыУпаковокМаркируемойПродукции[%1].НомерУпаковки";
				
				ИмяПоля = СтрШаблон(ШаблонИмениПоля, СтрокиУпаковки[0].ПолучитьИдентификатор());
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки,, ИмяПоля);
				Результат = Ложь;
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	КоличествоКодовУпаковок = КодыУпаковокМаркируемойПродукции.Количество();
	
	Возврат Результат;

КонецФункции

&НаСервере
Функция КодМаркируемойУпаковкиСоответствуетТребованиям(Знач КодУпаковки, ИндексСтрокиДляВывода = Неопределено)

	Отказ = Ложь;
	КодУпаковки = СокрЛП(КодУпаковки);
	ИмяПоля = "КодыУпаковокМаркируемойПродукции" + СтрШаблон("[%1].НомерУпаковки", ИндексСтрокиДляВывода);
	
	Если Не ЗначениеЗаполнено(КодУпаковки) Тогда
		Отказ = Истина;
		ТекстОшибки = НСтр("ru = 'В строке %1 не заполнен код упаковки'");
	КонецЕсли;
	
	Если Отказ Тогда
		ТекстОшибки = СтрШаблон(ТекстОшибки, ИндексСтрокиДляВывода + 1);
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки,, ИмяПоля,, Отказ); 	
	КонецЕсли;
	
	Возврат Не Отказ;

КонецФункции

&НаСервере
Процедура ОбработкаДобавленияСпискаКодовНаСервере(Знач ВыбранноеЗначение)
	
	ТаблицаКМ = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресКодовМаркировкиВХранилище);
	
	Для каждого ТекСтрока Из ТаблицаКМ Цикл
		НоваяСтрока = КодыУпаковокМаркируемойПродукции.Добавить();
		НоваяСтрока.НомерУпаковки = ТекСтрока.КодМаркировки;
		НоваяСтрока.ТипУпаковки = ТекСтрока.ТипУпаковки;
	КонецЦикла;
	
	КоличествоКодовУпаковок = КодыУпаковокМаркируемойПродукции.Количество();
	
КонецПроцедуры

&НаКлиенте
 Процедура ОповещениеОткрытьФормуВыбораКода(РезультатОткрытияФормы, ПараметрыВыполнения) Экспорт
	 
	 Если ЗначениеЗаполнено(РезультатОткрытияФормы) Тогда 
		 Для Каждого СтрокаКод Из РезультатОткрытияФормы Цикл 
			 НоваяСтрока 				= КодыУпаковокМаркируемойПродукции.Добавить();
			 НоваяСтрока.НомерУпаковки 	= СтрокаКод.Код;
			 НоваяСтрока.ТипУпаковки 	= НСтр("ru = 'Индивидуальная упаковка'");
		 КонецЦикла;	 
	КонецЕсли;	
	КоличествоКодовУпаковок = КодыУпаковокМаркируемойПродукции.Количество();
	 
 КонецПроцедуры

#КонецОбласти
