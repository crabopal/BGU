	                      |	НастройкиВыгрузкиАналитикМСД.ОбязательноВОборотах2 КАК ДопускаетсяПустоеЗначениеВОборотах2,
	                      |	НастройкиВыгрузкиАналитикМСД.ОбязательноВОборотах3 КАК ДопускаетсяПустоеЗначениеВОборотах3,
	                      |	НастройкиВыгрузкиАналитикМСД.ОбязательноВОборотах4 КАК ДопускаетсяПустоеЗначениеВОборотах4,
	                      |	НастройкиВыгрузкиАналитикМСД.ОбязательноВОборотах5 КАК ДопускаетсяПустоеЗначениеВОборотах5,
	                      |	НастройкиВыгрузкиАналитикМСД.ОбязательноВОборотах6 КАК ДопускаетсяПустоеЗначениеВОборотах6
	                      |ИЗ
	                      |	РегистрСведений.НастройкиВыгрузкиАналитикМСД КАК НастройкиВыгрузкиАналитикМСД
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикиМСД КАК АналитикиМСД
	                      |		ПО НастройкиВыгрузкиАналитикМСД.Аналитика1 = АналитикиМСД.ИмяАналитики
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикиМСД КАК АналитикиМСД1
	                      |		ПО НастройкиВыгрузкиАналитикМСД.Аналитика2 = АналитикиМСД1.ИмяАналитики
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикиМСД КАК АналитикиМСД2
	                      |		ПО НастройкиВыгрузкиАналитикМСД.Аналитика3 = АналитикиМСД2.ИмяАналитики
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикиМСД КАК АналитикиМСД3
	                      |		ПО НастройкиВыгрузкиАналитикМСД.Аналитика4 = АналитикиМСД3.ИмяАналитики
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикиМСД КАК АналитикиМСД4
	                      |		ПО НастройкиВыгрузкиАналитикМСД.Аналитика5 = АналитикиМСД4.ИмяАналитики
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикиМСД КАК АналитикиМСД5
	                      |		ПО НастройкиВыгрузкиАналитикМСД.Аналитика6 = АналитикиМСД5.ИмяАналитики
	                      |ГДЕ
	                      |	НастройкиВыгрузкиАналитикМСД.Версия = &ВерсияФормата
	                      |	И НастройкиВыгрузкиАналитикМСД.Организация = &Организация");  
	
	Запрос.УстановитьПараметр("ВерсияФормата", ВерсияФормата);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	ДанныеРегистра.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры  

#КонецОбласти

#Область РеквизитыАналитик

&НаСервере
Процедура ЗаполнитьТаблицыРегистраРеквизитовАналитик()
	
	ДанныеРегистраРеквизитыАналитик.Очистить();  
	ВыборкаРегистров = ПолучитьВыборкуРегистровИРеквизитов();
	Пока ВыборкаРегистров.Следующий() Цикл		
		Выборка = ВыборкаРегистров.Выбрать();
		Пока Выборка.Следующий() Цикл  
			новСтрока = ДанныеРегистраРеквизитыАналитик.Добавить();
			ЗаполнитьЗначенияСвойств(новСтрока, Выборка);			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры     

&НаСервере
Функция ПолучитьВыборкуРегистровИРеквизитов() 
		
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НастройкиРеквизитовАналитикМСД.Организация КАК Организация,
	|	НастройкиРеквизитовАналитикМСД.Аналитика КАК Аналитика,
	|	ЕСТЬNULL(АналитикиМСД.Представление, НастройкиРеквизитовАналитикМСД.Аналитика) КАК Представление,
	|	НастройкиРеквизитовАналитикМСД.Реквизит КАК Реквизит,
	|	НастройкиРеквизитовАналитикМСД.Используется КАК Используется,
	|	НастройкиРеквизитовАналитикМСД.Обязательный КАК Обязательный,
	|	НастройкиРеквизитовАналитикМСД.ПолныеПрава КАК ПолныеПрава,
	|	ЕСТЬNULL(РеквизитыАналитикМСД.Представление, НастройкиРеквизитовАналитикМСД.Реквизит) КАК ПредставлениеРеквизита,
	|	НастройкиРеквизитовАналитикМСД.Версия КАК Версия
	|ИЗ
	|	РегистрСведений.НастройкиРеквизитовАналитикМСД КАК НастройкиРеквизитовАналитикМСД
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АналитикиМСД КАК АналитикиМСД
	|		ПО НастройкиРеквизитовАналитикМСД.Аналитика = АналитикиМСД.ИмяАналитики
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РеквизитыАналитикМСД КАК РеквизитыАналитикМСД
	|		ПО НастройкиРеквизитовАналитикМСД.Аналитика = РеквизитыАналитикМСД.ИмяАналитики
	|			И НастройкиРеквизитовАналитикМСД.Реквизит = РеквизитыАналитикМСД.ИмяРеквизита
	|ГДЕ
	|	НастройкиРеквизитовАналитикМСД.Версия = &ВерсияФормата
	|	И НастройкиРеквизитовАналитикМСД.Организация = &Организация
	|ИТОГИ ПО
	|	Аналитика"); 
	
	Запрос.УстановитьПараметр("ВерсияФормата", ВерсияФормата);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	ВыборкаАналитики = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);   
	
	Возврат ВыборкаАналитики;
	
КонецФункции  

&НаСервере
Процедура СформироватьДеревоРеквизитовАналитик()   
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	НастройкиРеквизитовАналитик.Организация КАК Организация,
	                      |	НастройкиРеквизитовАналитик.Аналитика КАК Аналитика,
	                      |	НастройкиРеквизитовАналитик.Представление КАК Представление,
	                      |	НастройкиРеквизитовАналитик.Реквизит КАК Реквизит,
	                      |	НастройкиРеквизитовАналитик.ПредставлениеРеквизита КАК ПредставлениеРеквизита,
	                      |	НастройкиРеквизитовАналитик.Используется КАК Используется,
	                      |	НастройкиРеквизитовАналитик.Используется КАК Используется1,
	                      |	НастройкиРеквизитовАналитик.Обязательный КАК Обязательный,
	                      |	НастройкиРеквизитовАналитик.Обязательный КАК Обязательный1,
	                      |	НастройкиРеквизитовАналитик.ПолныеПрава КАК ПолныеПрава,
	                      |	НастройкиРеквизитовАналитик.ПолныеПрава КАК ПолныеПрава1
	                      |ПОМЕСТИТЬ ВТ_ДанныеРегистра
	                      |ИЗ
	                      |	&ДанныеРегистраРеквизитыАналитик КАК НастройкиРеквизитовАналитик
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	НастройкиРеквизитовАналитик.Организация КАК Организация,
	                      |	НастройкиРеквизитовАналитик.Аналитика КАК Аналитика,
	                      |	НастройкиРеквизитовАналитик.Представление КАК Представление,
	                      |	НастройкиРеквизитовАналитик.Реквизит КАК Реквизит,
	                      |	НастройкиРеквизитовАналитик.ПредставлениеРеквизита КАК ПредставлениеРеквизита,
	                      |	НастройкиРеквизитовАналитик.Используется КАК Используется,
	                      |	НастройкиРеквизитовАналитик.Используется КАК Используется1,
	                      |	НастройкиРеквизитовАналитик.Обязательный КАК Обязательный,
	                      |	НастройкиРеквизитовАналитик.Обязательный КАК Обязательный1,
	                      |	НастройкиРеквизитовАналитик.ПолныеПрава КАК ПолныеПрава,
	                      |	НастройкиРеквизитовАналитик.ПолныеПрава КАК ПолныеПрава1
	                      |ИЗ
	                      |	ВТ_ДанныеРегистра КАК НастройкиРеквизитовАналитик
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	Представление,
	                      |	ПредставлениеРеквизита
	                      |ИТОГИ
	                      |	МАКСИМУМ(Представление),
	                      |	МАКСИМУМ(Используется),
	                      |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Используется1),
	                      |	МАКСИМУМ(Обязательный),
	                      |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Обязательный1),
	                      |	МАКСИМУМ(ПолныеПрава),
	                      |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПолныеПрава1)
	                      |ПО
	                      |	Аналитика"); 
	
	Запрос.УстановитьПараметр("ДанныеРегистраРеквизитыАналитик", ДанныеРегистраРеквизитыАналитик.Выгрузить());     
	
	ВыборкаАналитик = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	пРезультат = РеквизитФормыВЗначение("РеквизитыАналитик");
	пРезультат.Строки.Очистить();
	
	Пока ВыборкаАналитик.Следующий() Цикл
		новСтрока = пРезультат.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(новСтрока, ВыборкаАналитик,, "Используется, Обязательный"); 
		новСтрока.ПредставлениеАналитики = ВыборкаАналитик.Представление;
		Если ВыборкаАналитик.Используется1 = 2 Тогда
			новСтрока.Используется = 2;
		Иначе
			новСтрока.Используется = ?(ВыборкаАналитик.Используется, 1, 0);
		КонецЕсли;
			
		Если ВыборкаАналитик.Обязательный1 = 2 Тогда
			новСтрока.Обязательный = 2;
		Иначе
			новСтрока.Обязательный = ?(ВыборкаАналитик.Обязательный, 1, 0);
		КонецЕсли;                     		
		
		Если ВыборкаАналитик.ПолныеПрава1 = 2 Тогда
			новСтрока.ПолныеПрава = 2;
		Иначе
			новСтрока.ПолныеПрава = ?(ВыборкаАналитик.ПолныеПрава, 1, 0);
		КонецЕсли;                                                            
		
		новСтрока.ПолеПоиска = ВыборкаАналитик.Аналитика;
		
		Выборка = ВыборкаАналитик.Выбрать();
		Пока Выборка.Следующий() Цикл 
			
			пНовСтрока = новСтрока.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(пНовСтрока, Выборка,, "Используется, Обязательный"); 
			пНовСтрока.ПредставлениеАналитики 	= Выборка.ПредставлениеРеквизита;
			пНовСтрока.Используется = ?(Выборка.Используется, 1, 0);
			пНовСтрока.Обязательный = ?(Выборка.Обязательный, 1, 0);  						
			пНовСтрока.ПолныеПрава 	= ?(Выборка.ПолныеПрава, 1, 0); 
			пНовСтрока.ПолеПоиска 	= Выборка.Аналитика + Выборка.Реквизит;
			
		КонецЦикла;
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(пРезультат, "РеквизитыАналитик");
	
КонецПроцедуры  

&НаКлиенте
Процедура ОбновитьОтображениеСтраниц()
	
	МодульОбщегоНазначенияКлиентСервер =  ОбщегоНазначенияКлиент.ОбщийМодуль("ОбщегоНазначенияКлиентСервер");
	
	Если Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаАналитикиПоСчетам Тогда
	
		ТекСтрока = Элементы.ДеревоСчетов.ТекущиеДанные;
		
		Если Не ТекСтрока = Неопределено Тогда
			текСчет = ТекСтрока.Счет;
		Иначе
			текСчет = Неопределено;
		КонецЕсли;
		
		СформироватьДеревоСчетов();
		
		ТекущаяСтрока = 0;
		Если ЗначениеЗаполнено(текСчет) Тогда
			МодульОбщегоНазначенияКлиентСервер.ПолучитьИдентификаторСтрокиДереваПоЗначениюПоля("Счет", ТекущаяСтрока, ДеревоСчетов.ПолучитьЭлементы(), текСчет, Ложь); 
		КонецЕсли;
		
		Элементы.ДеревоСчетов.ТекущаяСтрока = ТекущаяСтрока;      
		Если пТолькоПросмотр Тогда                        
			Элементы.ДеревоСчетов.ТолькоПросмотр = Истина;
		Иначе
			Элементы.ДеревоСчетов.ТолькоПросмотр = Ложь;
		КонецЕсли;	
	Иначе 
		текСтрока = Элементы.РеквизитыАналитик.ТекущиеДанные;
		
		Если Не текСтрока = Неопределено Тогда
			ПолеПоиска = текСтрока.ПолеПоиска;
		Иначе
			ПолеПоиска = Неопределено;
		КонецЕсли; 
		
		СформироватьДеревоРеквизитовАналитик();
		
		ТекущаяСтрока = 0;
		Если ЗначениеЗаполнено(ПолеПоиска) Тогда
			МодульОбщегоНазначенияКлиентСервер.ПолучитьИдентификаторСтрокиДереваПоЗначениюПоля("ПолеПоиска", ТекущаяСтрока, РеквизитыАналитик.ПолучитьЭлементы(), ПолеПоиска, Ложь); 
		КонецЕсли;		
		Элементы.РеквизитыАналитик.ТекущаяСтрока = ТекущаяСтрока; 
		
		Если пТолькоПросмотр Тогда                        
			Элементы.РеквизитыАналитик.ТолькоПросмотр = Истина;    
		Иначе
			Элементы.РеквизитыАналитик.ТолькоПросмотр = Ложь;
		КонецЕсли;	
		
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент) 
	ЗаполнитьСписокВерсийФормата();
	ОбновитьОтображениеПриИзменении();
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьАктуальность(Команда)
	ОткрытьФорму("Обработка.ЗагрузкаТаксономии.Форма.Форма", Новый Структура("ТипФормы, Организация", "Таксономия", Организация));		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПечатьКСНаСервере(Организация, ВерсияФормата)	
	Возврат Справочники.КонтрольныеСоотношенияМСД.НапечататьКСВерсииЕФ(Организация, ВерсияФормата);	
КонецФункции

&НаКлиенте
Процедура ПечатьКС(Команда)
	МодульУправлениеПечатьюКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("УправлениеПечатьюКлиент");
	ТабличныйДокумент = ПечатьКСНаСервере(Организация, ВерсияФормата); 
	КоллекцияПечатныхФорм = МодульУправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм("ПечатьКС");
	ПечатнаяФорма = МодульУправлениеПечатьюКлиент.ОписаниеПечатнойФормы(КоллекцияПечатныхФорм, "ПечатьКС");
    ПечатнаяФорма.СинонимМакета = "Контрольные соотношения";
    ПечатнаяФорма.ТабличныйДокумент = ТабличныйДокумент;
	МодульУправлениеПечатьюКлиент.ПечатьДокументов(КоллекцияПечатныхФорм);
КонецПроцедуры

#КонецОбласти

