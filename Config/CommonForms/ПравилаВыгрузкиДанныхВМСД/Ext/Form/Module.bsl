        Если Не (текСтрока.Строки.Количество() = 1 И ЗначениеЗаполнено(текСтрока.Строки[0].Счет_Строкой)) Тогда
			ЗаполнитьВетку(новСтрока, текСтрока);   
		КонецЕсли;
		
	КонецЦикла;                                      
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеРегистра()    
		
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                      |	НастройкиВыгрузкиАналитикМСД.Версия КАК Версия,
