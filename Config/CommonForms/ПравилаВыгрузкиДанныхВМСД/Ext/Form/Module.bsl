&НаКлиенте
Процедура РазвернутьВсеСлужебный(Ветка, ИмяЭлемента)
	
	Для Каждого текСтрока Из Ветка Цикл
		
		Если Не текСтрока.ПолучитьЭлементы().Количество() = 0 Тогда
			
			РазвернутьВсеСлужебный(текСтрока.ПолучитьЭлементы(), ИмяЭлемента);
			
		КонецЕсли;
		
		Элементы[ИмяЭлемента].Развернуть(текСтрока.ПолучитьИдентификатор(), Истина);
		
	КонецЦикла;			
			
КонецПроцедуры		

&НаКлиенте
Процедура СвернутьВсеСлужебный(Ветка, ИмяЭлемента);
	
	Для Каждого текСтрока Из Ветка Цикл     
		
		Если Не текСтрока.ПолучитьЭлементы().Количество() = 0 Тогда
			
			СвернутьВсеСлужебный(текСтрока.ПолучитьЭлементы(), ИмяЭлемента);
			
		КонецЕсли;
		
		Элементы[ИмяЭлемента].Свернуть(текСтрока.ПолучитьИдентификатор());   
		
	КонецЦикла;
	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьСписокВерсийФормата()
	
	Элементы.ВерсияФормата.СписокВыбора.Очистить(); 
	ВерсияФормата = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	НастройкиВыгрузкиАналитикМСД.Версия КАК Версия
		|ПОМЕСТИТЬ ВТ_ВерсииРегистра
		|ИЗ
		|	РегистрСведений.НастройкиВыгрузкиАналитикМСД КАК НастройкиВыгрузкиАналитикМСД
		|ГДЕ
		|	НастройкиВыгрузкиАналитикМСД.Организация = &Организация
		|
		|СГРУППИРОВАТЬ ПО
		|	НастройкиВыгрузкиАналитикМСД.Версия
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтатусыВерсийЕФСрезПоследних.Версия КАК Версия,
		|	СтатусыВерсийЕФСрезПоследних.Статус = &СтатусУтвержден КАК Утвержден
		|ИЗ
		|	РегистрСведений.СтатусыВерсийЕФ.СрезПоследних(
		|			,
		|			Версия В
		|					(ВЫБРАТЬ
		|						ВТ_ВерсииРегистра.Версия КАК Версия
		|					ИЗ
		|						ВТ_ВерсииРегистра КАК ВТ_ВерсииРегистра)
		|				И Организация = &Организация) КАК СтатусыВерсийЕФСрезПоследних
		|
		|УПОРЯДОЧИТЬ ПО
		|	Утвержден УБЫВ,
		|	СтатусыВерсийЕФСрезПоследних.Период УБЫВ";
	
	Запрос.УстановитьПараметр("СтатусУтвержден", Перечисления.СтатусыВерсийЕФ.Утвержден);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	НеобходимоЗаполнениеВерсии = НЕ ЗначениеЗаполнено(ВерсияФормата);
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл 
		Если НеобходимоЗаполнениеВерсии Тогда
			ВерсияФормата = ВыборкаДетальныеЗаписи.Версия;
			НеобходимоЗаполнениеВерсии = Ложь;
		КонецЕсли;			
		Элементы.ВерсияФормата.СписокВыбора.Добавить(ВыборкаДетальныеЗаписи.Версия);		            
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДатуУтверждения()
	
	ДатаУтверждения = Неопределено;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтатусыВерсийЕФСрезПоследних.ДатаУтверждения КАК ДатаУтверждения
		|ИЗ
		|	РегистрСведений.СтатусыВерсийЕФ.СрезПоследних(
		|			,
		|			Организация = &Организация
		|				И Версия = &ВерсияФормата) КАК СтатусыВерсийЕФСрезПоследних";
	
	Запрос.УстановитьПараметр("ВерсияФормата", ВерсияФормата);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ДатаУтверждения = ВыборкаДетальныеЗаписи.ДатаУтверждения;
	КонецЕсли;
		
КонецПроцедуры	

