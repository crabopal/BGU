	ОбновитьОтображениеПриИзменении();	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте                                                                         
Процедура СвернутьВсе(Команда)      

	Если Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаАналитикиПоСчетам Тогда

		СвернутьВсеСлужебный(ДеревоСчетов.ПолучитьЭлементы(), "ДеревоСчетов");		
		Для Каждого текСтрока Из ДеревоСчетов.ПолучитьЭлементы() Цикл
			Элементы.ДеревоСчетов.Свернуть(текСтрока.ПолучитьИдентификатор());
		КонецЦикла;
		
	Иначе
		СвернутьВсеСлужебный(РеквизитыАналитик.ПолучитьЭлементы(), "РеквизитыАналитик");		
		Для Каждого текСтрока Из РеквизитыАналитик.ПолучитьЭлементы() Цикл
			Элементы.РеквизитыАналитик.Свернуть(текСтрока.ПолучитьИдентификатор());
		КонецЦикла;   
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьВсе(Команда)
	
	Если Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаАналитикиПоСчетам Тогда
		РазвернутьВсеСлужебный(ДеревоСчетов.ПолучитьЭлементы(), "ДеревоСчетов");		
	Иначе		
		РазвернутьВсеСлужебный(РеквизитыАналитик.ПолучитьЭлементы(), "РеквизитыАналитик"); 
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

