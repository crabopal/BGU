
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка) 
	
	Если Параметры.Свойство("Версия") Тогда
		ВерсияФормата 		= Параметры.Версия;
	КонецЕсли; 
	
	Если Параметры.Свойство("Организация") Тогда
		Организация = Параметры.Организация;
	Иначе
		Организация = ПараметрыСеанса.ТекущаяОрганизация;
	КонецЕсли;
	
	ЗаполнитьСписокВерсийФормата();
	
	пТолькоПросмотр = Истина;		
	
	ОбновитьДатуУтверждения();
	ЗаполнитьДанныеРегистра();
	ЗаполнитьТаблицыРегистраРеквизитовАналитик();

	УстановитьУсловноеОформление();                                                                                 	
                                                                                                                                   
	Легенда = НСтр("ru='""ВОст"" - выгружать в остатках, ""ПустОст"" - допустимость пустых значений в остатках, ""ВОб"" - выгружать в оборотах, ""ПустОб"" - допустимость пустых значений в оборотах'"); 
	Легенда2 = НСтр("ru='""В"" - выгружать, ""О"" - обязательность'"); 	
		
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)	
	ОбновитьОтображениеСтраниц();
КонецПроцедуры

&НаКлиенте
Процедура СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)	
	ОбновитьОтображениеСтраниц();	
КонецПроцедуры
 
