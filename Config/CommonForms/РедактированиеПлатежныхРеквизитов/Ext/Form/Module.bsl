
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ЗаголовокФормы") Тогда
		АвтоЗаголовок = Ложь;
		Заголовок = Параметры.ЗаголовокФормы;
	КонецЕсли;
	
	Параметры.Свойство("КлючДанных", КлючДанных);
	
	ПлатежныеРеквизиты = Параметры.ПлатежныеРеквизиты;
	
	Элементы.БанковскийСчет.Видимость 		= ПлатежныеРеквизиты.Свойство("БанковскийСчет");
	Элементы.БИКБанка.Видимость 			= ПлатежныеРеквизиты.Свойство("БИКБанка");
	Элементы.ИНН.Видимость 					= ПлатежныеРеквизиты.Свойство("ИНН");
	Элементы.КодРПБС.Видимость 				= ПлатежныеРеквизиты.Свойство("КодРПБС");
	Элементы.КорСчетБанка.Видимость 		= ПлатежныеРеквизиты.Свойство("КорСчетБанка");
	Элементы.КПП.Видимость 					= ПлатежныеРеквизиты.Свойство("КПП");
	Элементы.ЛицевойСчет.Видимость 			= ПлатежныеРеквизиты.Свойство("ЛицевойСчет");
	Элементы.Наименование.Видимость 		= ПлатежныеРеквизиты.Свойство("Наименование");
	Элементы.НаименованиеБанка.Видимость 	= ПлатежныеРеквизиты.Свойство("НаименованиеБанка");
	Элементы.Бюджет.Видимость 	            = ПлатежныеРеквизиты.Свойство("Бюджет");   
	Элементы.Бюджет.Видимость 	            = ПлатежныеРеквизиты.Свойство("ОКПО");
    Элементы.АналитическийКод.Видимость     = ПлатежныеРеквизиты.Свойство("АналитическийКод");
	Элементы.АналитическийКод1.Видимость    = ПлатежныеРеквизиты.Свойство("АналитическийКод1");
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ПлатежныеРеквизиты);
		
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаОК(Команда)
	
	Результат = Новый Структура("БанковскийСчет, БИКБанка, ИНН, КлючДанных, КодРПБС, КорСчетБанка, КПП, ЛицевойСчет, Наименование, НаименованиеБанка, Бюджет, ОКПО, АналитическийКод, АналитическийКод1");
	
	ЗаполнитьЗначенияСвойств(Результат, ЭтотОбъект);
	
	ОповеститьОВыборе(Результат);

КонецПроцедуры

#КонецОбласти