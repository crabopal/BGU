КонецПроцедуры 

&НаКлиенте
Процедура Подключаемый_АвтоматическийЗапросСроковТаксономииМСДПриИзменении(Элемент)
	
	СпособПередачиВнешнийПОИБ = (ОсновнойСпособПередачиДанныхВМСД = ПредопределенноеЗначение("Перечисление.СпособыПередачиДанныхВМСД.ВнешнийПОИБ"));
	Если ЭтаФорма.АвтоматическийЗапросСроковТаксономииМСД И СпособПередачиВнешнийПОИБ Тогда 
		Отказ = Ложь;
	    КонтрольНастроекТранспортногоСертификата(Отказ);
		Если Отказ Тогда
			ЭтаФорма.АвтоматическийЗапросСроковТаксономииМСД = Ложь;
		КонецЕсли;
	КонецЕсли;
		
	УстановитьКонстантуМСД("АвтоматическийЗапросСроковТаксономииМСД", ЭтаФорма.АвтоматическийЗапросСроковТаксономииМСД);
	Элементы.ГруппаАвтоФормирование.Доступность = ЭтаФорма.АвтоматическийЗапросСроковТаксономииМСД; 
	Если НЕ ЭтаФорма.АвтоматическийЗапросСроковТаксономииМСД Тогда
		УстановитьКонстантуМСД("АвтоматическоеФормированиеПакетовДанныхМСД", ЭтаФорма.АвтоматическийЗапросСроковТаксономииМСД);
		ЭтаФорма.АвтоматическоеФормированиеПакетовДанныхМСД = ЭтаФорма.АвтоматическийЗапросСроковТаксономииМСД;
	КонецЕсли;
	
	Если СпособПередачиВнешнийПОИБ Тогда
		УстановитьНастройкиОбменаКлиент(); 
		
		МодульПользователиКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ПользователиКлиент");
		Если МодульПользователиКлиент.ТекущийПользователь() = ЭтаФорма["ПользовательКлиентМСД"] Тогда
			АвтообменКлиент = ПолучитьСведенияОНастройкахОбмена();
			ДобавитьУдалитьФормуАвтообменаПользователя(ЭтаФорма["ПользовательКлиентМСД"],,АвтообменКлиент);
			ОбновитьИнтерфейс();
		КонецЕсли; 
	КонецЕсли;
	
КонецПроцедуры  

&НаКлиенте
Процедура Подключаемый_СторонаЗапросовСроковТаксономииЕСМВСМЭВПриИзменении(Элемент)
	УстановитьКонстантуМСД("СторонаЗапросовСроковТаксономииЕСМВСМЭВ", ЭтаФорма.СторонаЗапросовСроковТаксономииЕСМВСМЭВ);
	УстановитьНастройкиОбменаКлиент();
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_АвтоматическаяОтправкаПакетовДанныхМСДПриИзменении(Элемент)

	СпособПередачиВнешнийПОИБ = (ОсновнойСпособПередачиДанныхВМСД = ПредопределенноеЗначение("Перечисление.СпособыПередачиДанныхВМСД.ВнешнийПОИБ"));
	Если ЭтаФорма.АвтоматическаяОтправкаПакетовДанныхМСД И СпособПередачиВнешнийПОИБ Тогда 
		Отказ = Ложь;
	    КонтрольНастроекТранспортногоСертификата(Отказ);
		Если Отказ Тогда
			ЭтаФорма.АвтоматическаяОтправкаПакетовДанныхМСД = Ложь;
		КонецЕсли;
	КонецЕсли;

	УстановитьКонстантуМСД("АвтоматическаяОтправкаПакетовДанныхМСД", ЭтаФорма.АвтоматическаяОтправкаПакетовДанныхМСД);
	
	Если СпособПередачиВнешнийПОИБ Тогда
		УстановитьНастройкиОбменаКлиент();
		
		МодульПользователиКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ПользователиКлиент");
		Если МодульПользователиКлиент.ТекущийПользователь() = ЭтаФорма["ПользовательКлиентМСД"] Тогда
			АвтообменКлиент = ПолучитьСведенияОНастройкахОбмена();
			ДобавитьУдалитьФормуАвтообменаПользователя(ЭтаФорма["ПользовательКлиентМСД"],,АвтообменКлиент);
			ОбновитьИнтерфейс();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_СторонаЗапросовОтправкиПакетовЕСМВСМЭВПриИзменении(Элемент)
