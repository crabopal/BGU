#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)	
	
	НовыйЭлементСпособПередачи = Элементы.ОсновнойСпособПередачиДанныхВМСД;
	ИспользуютсяИнтеграцииЭБ = Ложь;
	МодульСбораДанныхПереопределяемый.ОпределитьВозможностьИспользованияИнтеграцийЭБ(ИспользуютсяИнтеграцииЭБ);

	Если ИспользуютсяИнтеграцииЭБ Тогда
		НовыйЭлементСпособПередачи.СписокВыбора.Добавить(Перечисления.СпособыПередачиДанныхВМСД.СервисИнтеграции); 		
	КонецЕсли;	
				
	НовыйЭлементСпособПередачи.СписокВыбора.Добавить(Перечисления.СпособыПередачиДанныхВМСД.Файл); 
	НовыйЭлементСпособПередачи.СписокВыбора.Добавить(Перечисления.СпособыПередачиДанныхВМСД.ВнешнийПОИБ);
	
#Область ЕСМВ_СМЭВ  

	ДобавитьРеквизитыИПолучитьЗначенияКонстант();
	ЗаполнитьНастройкиСервиса();
	СоздатьДополнительныеЭлементыФормы();
	
#КонецОбласти	
	
КонецПроцедуры  

&НаКлиенте
Процедура ПриОткрытии(Отказ)	
	ПроверитьУстановкуПрограммКриптографии();		
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура Подключаемый_ПользовательКлиентМСДПриИзменении(Элемент)
	
	Отказ = Ложь;
	МодульПользователиКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ПользователиКлиент");
	ТекущийПользователь = МодульПользователиКлиент.ТекущийПользователь();
	ДобавитьУдалитьФормуАвтообменаПользователя(ПользовательАвтообменТекущееЗначение, ЭтаФорма["ПользовательКлиентМСД"], Ложь, Отказ);
	Если Отказ Тогда
		ЭтаФорма["ПользовательКлиентМСД"] = ПользовательАвтообменТекущееЗначение;	
	Иначе	
		УстановитьКонстантуМСД("ПользовательКлиентМСД", ЭтаФорма["ПользовательКлиентМСД"]); 
		ДобавитьУдалитьФормуАвтообменаПользователя(ЭтаФорма["ПользовательКлиентМСД"],,Истина);
		Если ТекущийПользователь = ПользовательАвтообменТекущееЗначение 
			ИЛИ ТекущийПользователь = ЭтаФорма["ПользовательКлиентМСД"] Тогда
			ОбновитьИнтерфейс();
		КонецЕсли;
		ПользовательАвтообменТекущееЗначение = ЭтаФорма["ПользовательКлиентМСД"];
	КонецЕсли;

КонецПроцедуры 

&НаКлиенте
Процедура Подключаемый_ИмяКомпьютераКлиентМСДПриИзменении(Элемент)
	УстановитьКонстантуМСД("ИмяКомпьютераКлиентМСД", ЭтаФорма["ИмяКомпьютераКлиентМСД"]);
	ПроверитьУстановкуПрограммКриптографии();
КонецПроцедуры

&НаКлиенте
Процедура ОсновнойСпособПередачиДанныхВМСДПриИзменении(Элемент)
	УстановитьКонстантуМСД("ОсновнойСпособПередачиДанныхВМСД", ОсновнойСпособПередачиДанныхВМСД);
	Элементы.ГруппаИнтеграцияСМСДДополнительно.Доступность = НЕ (ОсновнойСпособПередачиДанныхВМСД = ОбщегоНазначенияКлиент.ПредопределенныйЭлемент("Перечисление.СпособыПередачиДанныхВМСД.Файл"));
	СпособШина = (ОсновнойСпособПередачиДанныхВМСД = ОбщегоНазначенияКлиент.ПредопределенныйЭлемент("Перечисление.СпособыПередачиДанныхВМСД.СервисИнтеграции"));
	Элементы.ЭлементНастройкаСервиса.Доступность = НЕ СпособШина;
    Элементы.СторонаЗапросовСроковТаксономииЕСМВСМЭВ.Видимость = НЕ СпособШина;
	Элементы.СторонаЗапросовОтправкиПакетовЕСМВСМЭВ.Видимость = НЕ СпособШина;
КонецПроцедуры

