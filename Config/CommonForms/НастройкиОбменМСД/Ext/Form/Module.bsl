КонецПроцедуры	

#КонецОбласти

#Область СлужебныеПроцедурыИФункции 

&НаКлиенте
Функция ПолучитьСведенияОНастройкахОбмена()
	
	ИнформационнаяБазаФайловая = ОбщегоНазначенияКлиент.ИнформационнаяБазаФайловая();
	
	Возврат (ЭтаФорма["АвтоматическийЗапросСроковТаксономииМСД"] 
	И (ЭтаФорма["СторонаЗапросовСроковТаксономииЕСМВСМЭВ"] = ПредопределенноеЗначение("Перечисление.СтороныВыполненияЗапросовЕСМВСМЭВ.Клиент") 
	ИЛИ ИнформационнаяБазаФайловая))
	ИЛИ (ЭтаФорма["АвтоматическаяОтправкаПакетовДанныхМСД"] 
	И (ЭтаФорма["СторонаЗапросовОтправкиПакетовЕСМВСМЭВ"] = ПредопределенноеЗначение("Перечисление.СтороныВыполненияЗапросовЕСМВСМЭВ.Клиент")
	ИЛИ ИнформационнаяБазаФайловая));

КонецФункции

&НаКлиенте
Процедура ПроверитьУстановкуПрограммКриптографии()
	
	#Если ВебКлиент Тогда
		ЭтоТекущийКомпьютер = Ложь;
	#Иначе
		ЭтоТекущийКомпьютер = (ЭтаФорма["ИмяКомпьютераКлиентМСД"] = ИмяКомпьютера());
	#КонецЕсли
	Элементы.НадписьПриложениеКриптопровайдера.Видимость = ЭтоТекущийКомпьютер;
	Элементы.НадписьПриложениеКриптопровайдера.Доступность = Ложь;
	Элементы.НадписьПриложениеКриптопровайдера.Гиперссылка = Ложь;
	Если ЭтоТекущийКомпьютер Тогда		
		ПараметрыПроверки = Новый Структура;
		ПараметрыПроверки.Вставить("УстанавливатьРасширение", Ложь);
		ПараметрыПроверки.Вставить("УстанавливатьКомпоненту", Ложь);
		ПараметрыПроверки.Вставить("ПредлагатьУстановитьПрограмму", Ложь);
		ПараметрыПроверки.Вставить("ПроверятьНаСервере", Ложь);
		
		ОповещениеПослеПроверкиПрограмм = Новый ОписаниеОповещения(
		"ОпределитьУстановленныеПрограммыПослеПроверкиПрограммКриптографии", ЭтотОбъект);
		
		МодульЭлектроннаяПодписьКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ЭлектроннаяПодписьКлиент");
		МодульЭлектроннаяПодписьКлиент.ПроверитьУстановкуПрограммКриптографии(ЭтаФорма, ПараметрыПроверки, ОповещениеПослеПроверкиПрограмм);		
	КонецЕсли;	
		
КонецПроцедуры 

&НаКлиенте
Процедура ОпределитьУстановленныеПрограммыПослеПроверкиПрограммКриптографии(Результат, Контекст) Экспорт
	
	ПриложениеУстановлено = Ложь;
	Если Результат.ПроверкаВыполнена Тогда
		ПриложениеУстановлено = Результат.Программы.Количество();
		ТекстНадписи = СтрШаблон(НСтр("ru = 'Приложение электронной подписи и шифрования %1 на компьютере.'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка()), 
						?(ПриложениеУстановлено, "установлено", "не установлено")); 
	Иначе
		ТекстНадписи = СтрШаблон(НСтр("ru = 'Проверка установки приложения электронной подписи и шифрования не выполнена по причине: %1.'", ОбщегоНазначенияКлиент.КодОсновногоЯзыка()), Результат.Ошибка); 	
	КонецЕсли;	
	Элементы.НадписьПриложениеКриптопровайдера.Заголовок = ТекстНадписи;
	Элементы.НадписьПриложениеКриптопровайдера.Доступность = НЕ ПриложениеУстановлено;
	Элементы.НадписьПриложениеКриптопровайдера.Гиперссылка = НЕ ПриложениеУстановлено;
		
КонецПроцедуры 

&НаКлиенте
Процедура УстановитьНастройкиОбменаКлиент()
	
	АвтообменКлиент = ПолучитьСведенияОНастройкахОбмена();
	Элементы["ЭлементНастройкаАвтообмен"].Доступность = АвтообменКлиент;
	Если АвтообменКлиент Тогда 
		Если НЕ ЗначениеЗаполнено(ЭтаФорма["ПользовательКлиентМСД"]) Тогда
			УстановитьПользователяЗапускаАвтообмена();
		КонецЕсли;
		#Если Не ВебКлиент Тогда
			Если ЗначениеЗаполнено(ЭтаФорма["ПользовательКлиентМСД"]) 
				И НЕ ЗначениеЗаполнено(ЭтаФорма["ИмяКомпьютераКлиентМСД"]) Тогда
				ЭтаФорма["ИмяКомпьютераКлиентМСД"] = ИмяКомпьютера();
				УстановитьКонстантуМСД("ИмяКомпьютераКлиентМСД", ЭтаФорма["ИмяКомпьютераКлиентМСД"]);
				ПроверитьУстановкуПрограммКриптографии();
			КонецЕсли; 
		#КонецЕсли		
	КонецЕсли;	

КонецПроцедуры  

&НаСервереБезКонтекста
Процедура УстановитьКонстантуМСД(ИмяКонстанты, ЗначениеКонстанты) 
	Константы[ИмяКонстанты].Установить(ЗначениеКонстанты);	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УстановитьЗначениеДанныеПодключения(ИмяРеквизита, Значение);	

	Попытка	 
		
		МассивДействий = Новый Массив;				
		ТаблицаДействий = Новый ТаблицаЗначений;
		ТаблицаДействий.Колонки.Добавить("Действие");
		Если ИмяРеквизита = "СервисОтправкиЕСМВ" Тогда 
			ДобавитьДействиеВТаблицу(ТаблицаДействий, МассивДействий, Перечисления.ДействияПередачиЕСМВСМЭВ.Отправка);
		ИначеЕсли ИмяРеквизита = "СервисПолученияЕСМВ" Тогда
			ДобавитьДействиеВТаблицу(ТаблицаДействий, МассивДействий, Перечисления.ДействияПередачиЕСМВСМЭВ.Получение); 
			ДобавитьДействиеВТаблицу(ТаблицаДействий, МассивДействий, Перечисления.ДействияПередачиЕСМВСМЭВ.Подтверждение);
		Иначе
			ДобавитьДействиеВТаблицу(ТаблицаДействий, МассивДействий, Перечисления.ДействияПередачиЕСМВСМЭВ.Отправка);
            ДобавитьДействиеВТаблицу(ТаблицаДействий, МассивДействий, Перечисления.ДействияПередачиЕСМВСМЭВ.Получение); 
			ДобавитьДействиеВТаблицу(ТаблицаДействий, МассивДействий, Перечисления.ДействияПередачиЕСМВСМЭВ.Подтверждение);
		КонецЕсли;
		СпособПередачи = Перечисления.СпособыПередачиДанныхВМСД.ВнешнийПОИБ;

		НачатьТранзакцию();
		
		БлокировкаДанных = Новый БлокировкаДанных;
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить("РегистрСведений.ДанныеПодключенияЕСМВСМЭВ");
		ЭлементБлокировкиДанных.УстановитьЗначение("СпособПередачи", СпособПередачи); 
		ЭлементБлокировкиДанных.ИсточникДанных = ТаблицаДействий;
		ЭлементБлокировкиДанных.ИспользоватьИзИсточникаДанных("ДействиеПередачи", "Действие");
		ЭлементБлокировкиДанных.Режим = РежимБлокировкиДанных.Исключительный;
	  	БлокировкаДанных.Заблокировать();  
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ДанныеПодключенияЕСМВСМЭВ.СпособПередачи КАК СпособПередачи,
			|	ДанныеПодключенияЕСМВСМЭВ.ДействиеПередачи КАК ДействиеПередачи,
			|	ДанныеПодключенияЕСМВСМЭВ.АдресСервера КАК АдресСервера,
			|	ДанныеПодключенияЕСМВСМЭВ.ТочкаСервиса КАК ТочкаСервиса,
			|	ДанныеПодключенияЕСМВСМЭВ.SOAPДействие КАК SOAPДействие,
			|	ДанныеПодключенияЕСМВСМЭВ.АдресХранилища КАК АдресХранилища,
			|	ДанныеПодключенияЕСМВСМЭВ.ДополнительныеПараметры КАК ДополнительныеПараметры
			|ИЗ
			|	РегистрСведений.ДанныеПодключенияЕСМВСМЭВ КАК ДанныеПодключенияЕСМВСМЭВ
			|ГДЕ
			|	ДанныеПодключенияЕСМВСМЭВ.СпособПередачи = &СпособПередачи
			|	И ДанныеПодключенияЕСМВСМЭВ.ДействиеПередачи В(&ДействиеПередачи)";
		
		Запрос.УстановитьПараметр("ДействиеПередачи", МассивДействий);
		Запрос.УстановитьПараметр("СпособПередачи", СпособПередачи);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
	    МассивИзмененныхЗначений = Новый Массив;
		АдресСервера = Неопределено;
		ТочкаСервисаПолучение = Неопределено;
			
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			НоваяЗапись = РегистрыСведений.ДанныеПодключенияЕСМВСМЭВ.СоздатьМенеджерЗаписи();	
            ЗаполнитьЗначенияСвойств(НоваяЗапись, ВыборкаДетальныеЗаписи);
			Если ИмяРеквизита = "АдресСервераЕСМВ" Тогда
				НоваяЗапись.АдресСервера = Значение;
			Иначе	
				НоваяЗапись.ТочкаСервиса = Значение;
			КонецЕсли;
			НоваяЗапись.Записать();
			МассивИзмененныхЗначений.Добавить(НоваяЗапись.ДействиеПередачи);
			АдресСервера = НоваяЗапись.АдресСервера;
			Если ВыборкаДетальныеЗаписи.ДействиеПередачи = Перечисления.ДействияПередачиЕСМВСМЭВ.Подтверждение 
				ИЛИ ВыборкаДетальныеЗаписи.ДействиеПередачи = Перечисления.ДействияПередачиЕСМВСМЭВ.Получение Тогда
				ТочкаСервисаПолучение = НоваяЗапись.ТочкаСервиса;	
			КонецЕсли;	
		КонецЦикла; 
		
		Если НЕ МассивИзмененныхЗначений.Количество() = МассивДействий.Количество() Тогда
			Для каждого СтрокаДействие Из МассивДействий Цикл
				Если МассивИзмененныхЗначений.Найти(СтрокаДействие) = Неопределено Тогда
					НоваяЗапись = РегистрыСведений.ДанныеПодключенияЕСМВСМЭВ.СоздатьМенеджерЗаписи();	
					НоваяЗапись.СпособПередачи = СпособПередачи;
					НоваяЗапись.ДействиеПередачи = СтрокаДействие;
					Если ИмяРеквизита = "АдресСервераЕСМВ" Тогда
						НоваяЗапись.АдресСервера = Значение;
						Если НоваяЗапись.ДействиеПередачи = Перечисления.ДействияПередачиЕСМВСМЭВ.Подтверждение 
							ИЛИ НоваяЗапись.ДействиеПередачи = Перечисления.ДействияПередачиЕСМВСМЭВ.Получение Тогда	
							НоваяЗапись.ТочкаСервиса = ТочкаСервисаПолучение;							
						КонецЕсли;						
					Иначе
						НоваяЗапись.АдресСервера = АдресСервера;
						НоваяЗапись.ТочкаСервиса = Значение;
					КонецЕсли;
					Если НоваяЗапись.ДействиеПередачи = Перечисления.ДействияПередачиЕСМВСМЭВ.Подтверждение Тогда
						НоваяЗапись.SOAPДействие = "ackMessages";
					ИначеЕсли НоваяЗапись.ДействиеПередачи = Перечисления.ДействияПередачиЕСМВСМЭВ.Получение Тогда
						НоваяЗапись.SOAPДействие = "getMessages";
					ИначеЕсли НоваяЗапись.ДействиеПередачи = Перечисления.ДействияПередачиЕСМВСМЭВ.Отправка Тогда
						НоваяЗапись.SOAPДействие = "sendMessage";
					КонецЕсли;
					НоваяЗапись.Записать();
					МассивИзмененныхЗначений.Добавить(НоваяЗапись.ДействиеПередачи);
				КонецЕсли;					
			КонецЦикла;	
		КонецЕсли;	
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации(НСтр("ru = 'ИзменениеНастроекПараметровУчетаМСД'", ОбщегоНазначения.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Ошибка,,,
		ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
		
	КонецПопытки;		
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьДействиеВТаблицу(Таблица, МассивДействий, Действие)
	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.Действие = Действие;
	МассивДействий.Добавить(Действие);
КонецПроцедуры	
	
&НаСервереБезКонтекста
Процедура ДобавитьУдалитьФормуАвтообменаПользователя(Пользователь, ВыбранноеЗначение = Неопределено, Добавить = Ложь, Отказ = Истина)
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		УстановитьПривилегированныйРежим(Истина);
		МодульПользователи = ОбщегоНазначения.ОбщийМодуль("Пользователи");
		Если НЕ ПравоДоступа("Просмотр", Метаданные.ОбщиеФормы.АвтоматическийОбменКлиентМСД, МодульПользователи.НайтиПоСсылке(ВыбранноеЗначение)) Тогда 
			МодульОбщегоНазначенияКлиентСервер = ОбщегоНазначения.ОбщийМодуль("ОбщегоНазначенияКлиентСервер");
			МодульОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(Нстр("ru='Пользователь %1 не может быть выбран т.к. у пользователя недостаточно прав для взаимодействия с системой МСД ПУиО ГИИС ЭБ.'"), ВыбранноеЗначение));
			Отказ = Истина;
			Возврат;
		КонецЕсли; 
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
		Возврат;	
	КонецЕсли;	
	
	ОбщегоНазначенияМСД.УстановитьНастройкиНачальнойСтраницы(Добавить,, Пользователь);
			
КонецПроцедуры
  
&НаСервере
Функция ПолучитьСведенияОНастройкахОбменаНаСервере()
	
	ИнформационнаяБазаФайловая = ОбщегоНазначения.ИнформационнаяБазаФайловая();
	
	Возврат (ЭтаФорма["АвтоматическийЗапросСроковТаксономииМСД"] 
	И (ЭтаФорма["СторонаЗапросовСроковТаксономииЕСМВСМЭВ"] = Перечисления.СтороныВыполненияЗапросовЕСМВСМЭВ.Клиент 
	ИЛИ ИнформационнаяБазаФайловая))
	ИЛИ (ЭтаФорма["АвтоматическаяОтправкаПакетовДанныхМСД"] 
	И (ЭтаФорма["СторонаЗапросовОтправкиПакетовЕСМВСМЭВ"] = Перечисления.СтороныВыполненияЗапросовЕСМВСМЭВ.Клиент
	ИЛИ ИнформационнаяБазаФайловая));

КонецФункции

&НаСервере
Процедура ПолучитьЗначенияКонстант()

	ЭтаФорма.ОсновнойСпособПередачиДанныхВМСД = Константы.ОсновнойСпособПередачиДанныхВМСД.Получить();
	ЭтаФорма.ПодписыватьОтчетныеДанныеДляМСД = Константы.ПодписыватьОтчетныеДанныеДляМСД.Получить();
	ЭтаФорма.ПодписыватьОперативныеДанныеДляМСД = Константы.ПодписыватьОперативныеДанныеДляМСД.Получить();
	ЭтаФорма.СинхронизироватьДатуЗапретаСМСД = Константы.СинхронизироватьДатуЗапретаСМСД.Получить();
	ЭтаФорма.СдвигАвтоформированияДанныхДляМСД = Константы.СдвигАвтоформированияДанныхДляМСД.Получить();
	ЭтаФорма.ТаймаутПовторнойОтправкиЗапросовВМСД = Константы.ТаймаутПовторнойОтправкиЗапросовВМСД.Получить();  
	ЭтаФорма.ИмяКомпьютераКлиентМСД = Константы.ИмяКомпьютераКлиентМСД.Получить();
	ЭтаФорма.ПользовательКлиентМСД = Константы.ПользовательКлиентМСД.Получить(); 
	ЭтаФорма.ПакетныйРежимВыгрузкиОстатковМСД = Константы.ПакетныйРежимВыгрузкиОстатковМСД.Получить(); 
	ПользовательАвтообменТекущееЗначение = ЭтаФорма.ПользовательКлиентМСД;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьРеквизитыИПолучитьЗначенияКонстант()
	
	ДобавляемыеРеквизиты = Новый Массив;
	
	ДобавляемыеРеквизиты.Добавить(
				Новый РеквизитФормы("АдресСервераЕСМВ",
			  	Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(100)),"",
			  	"Адрес сервера"));
				
	ДобавляемыеРеквизиты.Добавить(
				Новый РеквизитФормы("СервисОтправкиЕСМВ",
			  	Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(100)),"",
			  	"Сервис отправки запроса от внешней ИС в МСД ПУиО ГИИС ЭБ")); 
				
	ДобавляемыеРеквизиты.Добавить(
				Новый РеквизитФормы("СервисПолученияЕСМВ",
			  	Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(100)),"",
			  	"Сервис на получение документов из очереди МСД ПУиО ГИИС ЭБ"));										
	
	ДобавляемыеРеквизиты.Добавить(
				Новый РеквизитФормы("АвтоматическийЗапросСроковТаксономииМСД",
			  	Новый ОписаниеТипов("Булево"),"",
			  	"Автоматически запрашивать сроки/таксономию из МСД ПУиО ГИИС ЭБ"));
				
		
	ДобавляемыеРеквизиты.Добавить(
				Новый РеквизитФормы("СторонаЗапросовСроковТаксономииЕСМВСМЭВ",
			  	Новый ОписаниеТипов("ПеречислениеСсылка.СтороныВыполненияЗапросовЕСМВСМЭВ"),"",
			  	"Формировать запросы сроков/таксономии на"));	
	
	ДобавляемыеРеквизиты.Добавить(
				Новый РеквизитФормы("АвтоматическоеФормированиеПакетовДанныхМСД",
			  	Новый ОписаниеТипов("Булево"),"",
			  	"Автоматически формировать пакеты данных для МСД ПУиО ГИИС ЭБ"));

	ДобавляемыеРеквизиты.Добавить(
				Новый РеквизитФормы("СдвигАвтоформированияДанныхДляМСД",
			  	Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10)),"",
			  	"Сдвиг автоформирования пакетов данных, в часах"));												 				
			
				
	ДобавляемыеРеквизиты.Добавить(
				Новый РеквизитФормы("АвтоматическаяОтправкаПакетовДанныхМСД",
			  	Новый ОписаниеТипов("Булево"),"",
			  	"Автоматически отправлять пакеты данных в МСД ПУиО ГИИС ЭБ")); 
						
	ДобавляемыеРеквизиты.Добавить(
				Новый РеквизитФормы("СторонаЗапросовОтправкиПакетовЕСМВСМЭВ",
			  	Новый ОписаниеТипов("ПеречислениеСсылка.СтороныВыполненияЗапросовЕСМВСМЭВ"),"",
			  	"Отправлять пакеты данных на"));
				
	ДобавляемыеРеквизиты.Добавить(
				Новый РеквизитФормы("ПользовательКлиентМСД",
			  	Новый ОписаниеТипов("СправочникСсылка.Пользователи"),"",
			  	"Пользователь"));
				
	ДобавляемыеРеквизиты.Добавить(
				Новый РеквизитФормы("ИмяКомпьютераКлиентМСД",
			  	Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(150)),"",
			  	"Имя компьютера"));  
					
	ДобавляемыеРеквизиты.Добавить(
				Новый РеквизитФормы("ТаймаутПовторнойОтправкиЗапросовВМСД",
			  	Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(10)),"",
			  	"Таймаут повторной отправки запросов данных, в минутах"));
			
	ДобавляемыеРеквизиты.Добавить(
				Новый РеквизитФормы("СохранятьЗапросыОтветыЕСМВСМЭВ",
			  	Новый ОписаниеТипов("Булево"),"",
			  	"Режим отладки (сохранять текст запросов и ответов)"));
			
	ДобавляемыеРеквизиты.Добавить(
				Новый РеквизитФормы("СпискКодИС", 
				Новый ОписаниеТипов("ДинамическийСписок"),"", 
				"Настройки организаций"));
				
	ДобавляемыеРеквизиты.Добавить(
				Новый РеквизитФормы("ПакетныйРежимВыгрузкиОстатковМСД",
			  	Новый ОписаниеТипов("Булево"),"",
			  	"Пакетный режим выгрузки аналитик и остатков в МСД ПУиО ГИИС ЭБ")); 
	
	ИзменитьРеквизиты(ДобавляемыеРеквизиты); 	
	ПолучитьЗначенияКонстант();
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьНастройкиСервиса()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДанныеПодключенияЕСМВСМЭВ.ДействиеПередачи КАК ДействиеПередачи,
		|	ДанныеПодключенияЕСМВСМЭВ.АдресСервера КАК АдресСервера,
		|	ДанныеПодключенияЕСМВСМЭВ.ТочкаСервиса КАК ТочкаСервиса
		|ИЗ
		|	РегистрСведений.ДанныеПодключенияЕСМВСМЭВ КАК ДанныеПодключенияЕСМВСМЭВ
		|ГДЕ
		|	ДанныеПодключенияЕСМВСМЭВ.СпособПередачи = &СпособПередачи";
	
	Запрос.УстановитьПараметр("СпособПередачи", Перечисления.СпособыПередачиДанныхВМСД.ВнешнийПОИБ);	
	РезультатЗапроса = Запрос.Выполнить();	
	
	ВыборкаДанныеПодключения = РезультатЗапроса.Выбрать();
	
	АдресСервера = "";
	
	Пока ВыборкаДанныеПодключения.Следующий() Цикл
		Если ВыборкаДанныеПодключения.ДействиеПередачи = Перечисления.ДействияПередачиЕСМВСМЭВ.Отправка Тогда
			ЭтаФорма["СервисОтправкиЕСМВ"] = ВыборкаДанныеПодключения.ТочкаСервиса;
		ИначеЕсли ВыборкаДанныеПодключения.ДействиеПередачи = Перечисления.ДействияПередачиЕСМВСМЭВ.Получение Тогда
			ЭтаФорма["СервисПолученияЕСМВ"] = ВыборкаДанныеПодключения.ТочкаСервиса;
		КонецЕсли;
		АдресСервера = ?(НЕ ЗначениеЗаполнено(АдресСервера), ВыборкаДанныеПодключения.АдресСервера, АдресСервера);
	КонецЦикла;
	
	ЭтаФорма["АдресСервераЕСМВ"] = АдресСервера;
	ЭтаФорма["СохранятьЗапросыОтветыЕСМВСМЭВ"] = Константы.СохранятьЗапросыОтветыЕСМВСМЭВ.Получить();
	ЭтаФорма["АвтоматическийЗапросСроковТаксономииМСД"] = Константы.АвтоматическийЗапросСроковТаксономииМСД.Получить();
	ЭтаФорма["АвтоматическаяОтправкаПакетовДанныхМСД"] = Константы.АвтоматическаяОтправкаПакетовДанныхМСД.Получить();
	ЭтаФорма["АвтоматическоеФормированиеПакетовДанныхМСД"] = Константы.АвтоматическоеФормированиеПакетовДанныхМСД.Получить();

	ЭтаФорма["СторонаЗапросовСроковТаксономииЕСМВСМЭВ"] = Константы.СторонаЗапросовСроковТаксономииЕСМВСМЭВ.Получить(); 
	ЭтаФорма["СторонаЗапросовОтправкиПакетовЕСМВСМЭВ"] = Константы.СторонаЗапросовОтправкиПакетовЕСМВСМЭВ.Получить();
	
КонецПроцедуры

&НаСервере
Процедура СоздатьДополнительныеЭлементыФормы()
	
	ДобавитьГруппуФормы("ГруппаИнтеграцияСМСДДополнительно", ЭтаФорма);

	ЭлементГруппаЕСМВСМЭВ = Элементы.ГруппаИнтеграцияСМСДДополнительно;		
	ЭлементГруппаЕСМВСМЭВ.Заголовок = "Дополнительные настройки";
	ЭлементГруппаЕСМВСМЭВ.Поведение = ПоведениеОбычнойГруппы.Всплывающая;
	ЭлементГруппаЕСМВСМЭВ.ОтображениеУправления = ОтображениеУправленияОбычнойГруппы.ГиперссылкаЗаголовка; 
	ЭлементГруппаЕСМВСМЭВ.Доступность = (НЕ ЭтаФорма["ОсновнойСпособПередачиДанныхВМСД"] = Перечисления.СпособыПередачиДанныхВМСД.Файл);  
										
#Область НастройкаСервиса

	СпособШина = (ЭтаФорма["ОсновнойСпособПередачиДанныхВМСД"] = Перечисления.СпособыПередачиДанныхВМСД.СервисИнтеграции);   
	
	ДобавитьГруппуФормы("ЭлементНастройкаСервиса", ЭлементГруппаЕСМВСМЭВ);

	ЭлементНастройкаСервиса = Элементы.ЭлементНастройкаСервиса;		
	ЭлементНастройкаСервиса.Заголовок = "Настройка сервиса";
	ЭлементНастройкаСервиса.Отображение = ОтображениеОбычнойГруппы.СильноеВыделение;
	ЭлементНастройкаСервиса.Доступность = НЕ СпособШина;
	
	ДобавитьПолеФормы("АдресСервераЕСМВ", ЭлементНастройкаСервиса); 
    ДобавитьПолеФормы("СервисОтправкиЕСМВ", ЭлементНастройкаСервиса);
	ДобавитьПолеФормы("СервисПолученияЕСМВ", ЭлементНастройкаСервиса);
		
	НовыйЭлемент = Элементы.Добавить("НадписьОткрытьНастройкиВидовСведенийЕСМВ", Тип("ДекорацияФормы"), ЭлементНастройкаСервиса);
	НовыйЭлемент.Вид 					= ВидДекорацииФормы.Надпись;
	НовыйЭлемент.Заголовок = "Открыть настройки видов сведений ЕСМВ";
	НовыйЭлемент.Гиперссылка = Истина;
	НовыйЭлемент.УстановитьДействие("Нажатие", "Подключаемый_НадписьОткрытьНастройкиВидовСведенийЕСМВ" + "Нажатие");
	
#КонецОбласти

#Область ОрганизацииОбмена

	ДобавитьГруппуФормы("ЭлементНастройкаСервисаНастройкаОрганизаций", ЭлементГруппаЕСМВСМЭВ);

	ЭлементНастройкаСервисаНастройкаОрганизаций = Элементы.ЭлементНастройкаСервисаНастройкаОрганизаций;
	ЭлементНастройкаСервисаНастройкаОрганизаций.Заголовок = "Организации обмена";
	ЭлементНастройкаСервисаНастройкаОрганизаций.Отображение = ОтображениеОбычнойГруппы.СильноеВыделение;
	ЭлементНастройкаСервисаНастройкаОрганизаций.Доступность = НЕ СпособШина;
	ЭлементНастройкаСервисаНастройкаОрганизаций.РастягиватьПоГоризонтали = Ложь; 
	ЭлементНастройкаСервисаНастройкаОрганизаций.Ширина = 83;
	
	ЭлементНастройкаСервисаСтраницыОрганизации = Элементы.Добавить("ЭлементНастройкаСервисаСтраницыОрганизации",
								Тип("ГруппаФормы"),
								ЭлементНастройкаСервисаНастройкаОрганизаций);
	ЭлементНастройкаСервисаСтраницыОрганизации.Вид  = ВидГруппыФормы.Страницы;
	ЭлементНастройкаСервисаСтраницыОрганизации.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
		
	ЭлементНастройкаСервисаСтраницаНесколькоОрганизаций = Элементы.Добавить("ЭлементНастройкаСервисаСтраницаНесколькоОрганизаций",
								Тип("ГруппаФормы"),
								ЭлементНастройкаСервисаСтраницыОрганизации);
	ЭлементНастройкаСервисаСтраницаНесколькоОрганизаций.Вид  = ВидГруппыФормы.Страница;
	
	ЭлементНастройкаСервисаСтраницыОрганизации.ТекущаяСтраница = ЭлементНастройкаСервисаСтраницаНесколькоОрганизаций;
	
	// Несколько организаций
	ЭтаФорма.СпискКодИС.ПроизвольныйЗапрос   = Ложь;    
	ЭтаФорма.СпискКодИС.ОсновнаяТаблица = "РегистрСведений.КодИСОрганизацийМСД";
	
	НовыйЭлемент = Элементы.Добавить("СпискКодИС", Тип("ТаблицаФормы"), ЭлементНастройкаСервисаСтраницаНесколькоОрганизаций);
	НовыйЭлемент.ПутьКДанным                    = "СпискКодИС";
	НовыйЭлемент.Отображение                    = ОтображениеТаблицы.Список;
	НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	НовыйЭлемент.АвтоМаксимальнаяВысота = Ложь;
	НовыйЭлемент.МаксимальнаяВысота = 3;	
	
	НоваяКолонка = Элементы.Добавить("СпискКодИСОрганизация", Тип("ПолеФормы"), НовыйЭлемент);
	НоваяКолонка.ПутьКДанным                = "СпискКодИС.Организация";
	
	НоваяКолонка = Элементы.Добавить("СпискКодИСКодИС", Тип("ПолеФормы"), НовыйЭлемент);
	НоваяКолонка.ПутьКДанным                = "СпискКодИС.КодИС";
	
	НоваяКолонка = Элементы.Добавить("СпискКодИСТранспортныйСертификат", Тип("ПолеФормы"), НовыйЭлемент);
	НоваяКолонка.ПутьКДанным                = "СпискКодИС.ТранспортныйСертификат"; 
				
#КонецОбласти 

#Область АвтоматическийОбмен
	
	ДобавитьГруппуФормы("ГруппаАвтоматика", ЭлементГруппаЕСМВСМЭВ, Ложь);
	ЭлементАвтоматика = Элементы.ГруппаАвтоматика; 
	ЭлементАвтоматика.ВертикальныйИнтервал = ИнтервалМеждуЭлементамиФормы.Полуторный; 
	
	ИнформационнаяБазаФайловая = ОбщегоНазначения.ИнформационнаяБазаФайловая();
	
	ДобавитьГруппуФормы("ГруппаАвтоЗапросСроков", ЭлементАвтоматика, Ложь);
	ЭлементАвтоЗапросСроков = Элементы.ГруппаАвтоЗапросСроков;
	
	ДобавитьПолеФормы("АвтоматическийЗапросСроковТаксономииМСД", ЭлементАвтоЗапросСроков, ВидПоляФормы.ПолеФлажка, ПоложениеЗаголовкаЭлементаФормы.Право); 
	НовыйЭлемент = Элементы.АвтоматическийЗапросСроковТаксономииМСД;
	НовыйЭлемент.Подсказка = "При включении автоматического обмена с МСД ПУиО ГИИС ЭБ активируется автоматическое получение ответных сообщений от МСД ПУиО ГИИС ЭБ по всем видам сообщений.";
	НовыйЭлемент.ОтображениеПодсказки = ОтображениеПодсказки.Кнопка; 
	ДобавитьПолеФормы("СторонаЗапросовСроковТаксономииЕСМВСМЭВ", ЭлементАвтоЗапросСроков); 
		 		
	НовыйЭлемент = Элементы.СторонаЗапросовСроковТаксономииЕСМВСМЭВ;
	НовыйЭлемент.РежимВыбораИзСписка = Истина;
	НовыйЭлемент.Видимость = НЕ СпособШина И НЕ ИнформационнаяБазаФайловая; 	
	НовыйЭлемент.СписокВыбора.Добавить(Перечисления.СтороныВыполненияЗапросовЕСМВСМЭВ.Клиент, "клиенте");
	НовыйЭлемент.СписокВыбора.Добавить(Перечисления.СтороныВыполненияЗапросовЕСМВСМЭВ.Сервер, "сервере");
		
	ДобавитьГруппуФормы("ГруппаАвтоФормирование", ЭлементАвтоматика, Ложь);	
	ЭлементАвтоФормирование = Элементы.ГруппаАвтоФормирование; 
	ЭлементАвтоформирование.Доступность = ЭтаФорма.АвтоматическийЗапросСроковТаксономииМСД; 
	
	ДобавитьПолеФормы("АвтоматическоеФормированиеПакетовДанныхМСД", ЭлементАвтоформирование, ВидПоляФормы.ПолеФлажка, ПоложениеЗаголовкаЭлементаФормы.Право); 
	ДобавитьПолеФормы("СдвигАвтоформированияДанныхДляМСД", ЭлементАвтоформирование); 

    НовыйЭлемент = Элементы.СдвигАвтоформированияДанныхДляМСД;
    НовыйЭлемент.Подсказка = "Подготовка пакетов данных для отправки в МСД ПУиО ГИИС ЭБ " + 
												 "начинется автоматически в 00:00 по утвержденному графику. " + 
												 "Заполнение параметра изменит время начала подготовки данных " +
												 "на указанное количество часов. 
												 |Например: 
												 |Если параметр принимает значение ""3"", подготовка данных начнется в " +
												 "03:00.
												 |Если параметр принимает значение ""-3"", подготовка данных начнется в " +
												 "21:00, на 3 часа раньше утвержденного срока предоставления данных.";
	НовыйЭлемент.ОтображениеПодсказки = ОтображениеПодсказки.Кнопка; 
	НовыйЭлемент.Доступность = ЭтаФорма["АвтоматическоеФормированиеПакетовДанныхМСД"];	
	
	ДобавитьГруппуФормы("ГруппаАвтоОтправка", ЭлементАвтоматика, Ложь);
	ЭлементАвтоОтправка = Элементы.ГруппаАвтоОтправка;
	
	ДобавитьПолеФормы("АвтоматическаяОтправкаПакетовДанныхМСД", ЭлементАвтоОтправка, ВидПоляФормы.ПолеФлажка, ПоложениеЗаголовкаЭлементаФормы.Право); 
	НовыйЭлемент = Элементы.АвтоматическаяОтправкаПакетовДанныхМСД;
	НовыйЭлемент.Подсказка = "Автоматическая отправка в МСД ПУиО ГИИС ЭБ возможна только для пакетов, которые не требуют подписания.";
	НовыйЭлемент.ОтображениеПодсказки = ОтображениеПодсказки.Кнопка; 
	УстановитьДоступностьАвтоматическаяОтправка();
	
	ДобавитьПолеФормы("СторонаЗапросовОтправкиПакетовЕСМВСМЭВ", ЭлементАвтоОтправка); 	
	
	НовыйЭлемент = Элементы.СторонаЗапросовОтправкиПакетовЕСМВСМЭВ;
	НовыйЭлемент.РежимВыбораИзСписка = Истина;
	НовыйЭлемент.Видимость = НЕ СпособШина И НЕ ИнформационнаяБазаФайловая; 		
	НовыйЭлемент.СписокВыбора.Добавить(Перечисления.СтороныВыполненияЗапросовЕСМВСМЭВ.Клиент, "клиенте");
	НовыйЭлемент.СписокВыбора.Добавить(Перечисления.СтороныВыполненияЗапросовЕСМВСМЭВ.Сервер, "сервере");
	
	ДобавитьГруппуФормы("ЭлементНастройкаАвтообмен", ЭлементАвтоматика);
	ЭлементНастройкаАвтообмен = Элементы.ЭлементНастройкаАвтообмен;		
	ЭлементНастройкаАвтообмен.Заголовок = "Настройка автоматического обмена на клиенте";
	ЭлементНастройкаАвтообмен.Отображение = ОтображениеОбычнойГруппы.ОбычноеВыделение;

	ДобавитьПолеФормы("ПользовательКлиентМСД", ЭлементНастройкаАвтообмен);
	ДобавитьПолеФормы("ИмяКомпьютераКлиентМСД", ЭлементНастройкаАвтообмен);
	
	НовыйЭлемент = Элементы.Добавить("НадписьПриложениеКриптопровайдера", Тип("ДекорацияФормы"), ЭлементНастройкаАвтообмен);
	НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
	НовыйЭлемент.Видимость = Ложь;
	НовыйЭлемент.УстановитьДействие("Нажатие", "Подключаемый_НадписьПриложениеКриптопровайдераНажатие");
	
	АвтообменКлиент = ПолучитьСведенияОНастройкахОбменаНаСервере();
	Элементы["ЭлементНастройкаАвтообмен"].Доступность = АвтообменКлиент;


#КонецОбласти

#Область ТехническиеНастройки

	ДобавитьГруппуФормы("ЭлементТехническиеНастройки", ЭлементГруппаЕСМВСМЭВ);

	ЭлементТехническиеНастройки = Элементы.ЭлементТехническиеНастройки;		
	ЭлементТехническиеНастройки.Заголовок = "Для технических специалистов";
	ЭлементТехническиеНастройки.Поведение = ПоведениеОбычнойГруппы.Свертываемая;
	ЭлементТехническиеНастройки.ОтображениеУправления = ОтображениеУправленияОбычнойГруппы.Картинка;
	ЭлементТехническиеНастройки.Отображение = ОтображениеОбычнойГруппы.СлабоеВыделение;
	ЭлементТехническиеНастройки.ВертикальныйИнтервал = ИнтервалМеждуЭлементамиФормы.Одинарный;
	ЭлементТехническиеНастройки.Скрыть();
	
	ДобавитьПолеФормы("ПакетныйРежимВыгрузкиОстатковМСД", ЭлементТехническиеНастройки, ВидПоляФормы.ПолеФлажка, ПоложениеЗаголовкаЭлементаФормы.Право); 
    НовыйЭлемент = Элементы.ПакетныйРежимВыгрузкиОстатковМСД;
    НовыйЭлемент.Подсказка = "Использование режима снижает потребление памяти сервером, однако увеличивает время формирования данных.";
	НовыйЭлемент.ОтображениеПодсказки = ОтображениеПодсказки.ОтображатьСнизу;
	
   	ДобавитьПолеФормы("ТаймаутПовторнойОтправкиЗапросовВМСД", ЭлементТехническиеНастройки); 
	
	НовыйЭлемент = Элементы.ТаймаутПовторнойОтправкиЗапросовВМСД;
	НовыйЭлемент.Подсказка = "Система позволяет обновлять сроки предоставления данных и таксономию " + 
							 "как автоматически, так и в ручном режиме (с помощью кнопки ""Обновить"").
							 |Заполнение параметра предотвращает случайные отправки запросов данных " +
							 "в МСД ПУиО ГИИС ЭБ при многократном обновлении данных в ручном режиме.";	
	НовыйЭлемент.ОтображениеПодсказки = ОтображениеПодсказки.Кнопка;	

	ДобавитьПолеФормы("СохранятьЗапросыОтветыЕСМВСМЭВ", ЭлементТехническиеНастройки, ВидПоляФормы.ПолеФлажка, ПоложениеЗаголовкаЭлементаФормы.Право);  
		
#КонецОбласти

	УстановитьДоступностьНастроек();
	
КонецПроцедуры  

&НаСервере
Процедура ДобавитьПолеФормы(ИмяРеквизита, ГруппаЭлементов, Вид = Неопределено, ПоложениеЗаголовка = Неопределено)
	
	НовыйЭлемент = Элементы.Добавить(ИмяРеквизита, Тип("ПолеФормы"), ГруппаЭлементов);
	НовыйЭлемент.ПутьКДанным          = ИмяРеквизита;
	Если ЗначениеЗаполнено(Вид) Тогда 
		НовыйЭлемент.Вид = Вид;
	Иначе	
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	КонецЕсли;
	Если ЗначениеЗаполнено(ПоложениеЗаголовка) Тогда
		НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовка;
	Иначе	
		НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Лево;
	КонецЕсли;
	НовыйЭлемент.УстановитьДействие("ПриИзменении", "Подключаемый_" + ИмяРеквизита + "ПриИзменении");
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьГруппуФормы(ИмяРеквизита, ГруппаЭлементов, ОтображатьЗаголовок = Истина)
	
	НовыйЭлемент = Элементы.Добавить(ИмяРеквизита,
								Тип("ГруппаФормы"),
								ГруппаЭлементов);										
	НовыйЭлемент.Вид = ВидГруппыФормы.ОбычнаяГруппа; 
	НовыйЭлемент.ОтображатьЗаголовок = ОтображатьЗаголовок;
	НовыйЭлемент.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	НовыйЭлемент.Отображение = ОтображениеОбычнойГруппы.Нет;
	НовыйЭлемент.Поведение = ПоведениеОбычнойГруппы.Обычное;
	НовыйЭлемент.ВертикальныйИнтервал = ИнтервалМеждуЭлементамиФормы.Половинный;
	
КонецПроцедуры
	
&НаСервере
Процедура УстановитьДоступностьНастроек()
	
	Элементы.ОсновнойСпособПередачиДанныхВМСД.ТолькоПросмотр   		   = НЕ ПравоДоступа("Изменение", Метаданные.Константы.ОсновнойСпособПередачиДанныхВМСД);
	Элементы.ПодписыватьОперативныеДанныеДляМСД.ТолькоПросмотр 		   = НЕ ПравоДоступа("Изменение", Метаданные.Константы.ПодписыватьОперативныеДанныеДляМСД);
	Элементы.ПодписыватьОтчетныеДанныеДляМСД.ТолькоПросмотр    		   = НЕ ПравоДоступа("Изменение", Метаданные.Константы.ПодписыватьОтчетныеДанныеДляМСД); 
	Элементы.СинхронизироватьДатуЗапретаСМСД.ТолькоПросмотр    		   = НЕ ПравоДоступа("Изменение", Метаданные.Константы.СинхронизироватьДатуЗапретаСМСД);
	Элементы.АдресСервераЕСМВ.ТолькоПросмотр 				   		   = НЕ ПравоДоступа("Изменение", Метаданные.РегистрыСведений.ДанныеПодключенияЕСМВСМЭВ);
    Элементы.СервисОтправкиЕСМВ.ТолькоПросмотр                 		   = НЕ ПравоДоступа("Изменение", Метаданные.РегистрыСведений.ДанныеПодключенияЕСМВСМЭВ);
    Элементы.СервисПолученияЕСМВ.ТолькоПросмотр                		   = НЕ ПравоДоступа("Изменение", Метаданные.РегистрыСведений.ДанныеПодключенияЕСМВСМЭВ);
    Элементы.СпискКодИС.ТолькоПросмотр                        		   = НЕ ПравоДоступа("Изменение", Метаданные.РегистрыСведений.КодИСОрганизацийМСД);
	Элементы.АвтоматическийЗапросСроковТаксономииМСД.ТолькоПросмотр    = НЕ ПравоДоступа("Изменение", Метаданные.Константы.АвтоматическийЗапросСроковТаксономииМСД);
    Элементы.СторонаЗапросовСроковТаксономииЕСМВСМЭВ.ТолькоПросмотр    = НЕ ПравоДоступа("Изменение", Метаданные.Константы.СторонаЗапросовСроковТаксономииЕСМВСМЭВ);
	Элементы.АвтоматическоеФормированиеПакетовДанныхМСД.ТолькоПросмотр = НЕ ПравоДоступа("Изменение", Метаданные.Константы.АвтоматическоеФормированиеПакетовДанныхМСД);
	Элементы.СдвигАвтоформированияДанныхДляМСД.ТолькоПросмотр          = НЕ ПравоДоступа("Изменение", Метаданные.Константы.СдвигАвтоформированияДанныхДляМСД);
    Элементы.АвтоматическаяОтправкаПакетовДанныхМСД.ТолькоПросмотр     = НЕ ПравоДоступа("Изменение", Метаданные.Константы.АвтоматическаяОтправкаПакетовДанныхМСД);
	Элементы.СторонаЗапросовОтправкиПакетовЕСМВСМЭВ.ТолькоПросмотр     = НЕ ПравоДоступа("Изменение", Метаданные.Константы.СторонаЗапросовОтправкиПакетовЕСМВСМЭВ);
	Элементы.ПользовательКлиентМСД.ТолькоПросмотр                      = НЕ ПравоДоступа("Изменение", Метаданные.Константы.ПользовательКлиентМСД);
	Элементы.ИмяКомпьютераКлиентМСД.ТолькоПросмотр                     = НЕ ПравоДоступа("Изменение", Метаданные.Константы.ИмяКомпьютераКлиентМСД);
    Элементы.ТаймаутПовторнойОтправкиЗапросовВМСД.ТолькоПросмотр       = НЕ ПравоДоступа("Изменение", Метаданные.Константы.ТаймаутПовторнойОтправкиЗапросовВМСД);
	Элементы.СохранятьЗапросыОтветыЕСМВСМЭВ.ТолькоПросмотр             = НЕ ПравоДоступа("Изменение", Метаданные.Константы.СохранятьЗапросыОтветыЕСМВСМЭВ);
	
КонецПроцедуры	
	
&НаСервере
Процедура УстановитьПользователяЗапускаАвтообмена()
	Если ПравоДоступа("Просмотр", Метаданные.ОбщиеФормы.АвтоматическийОбменКлиентМСД) Тогда
		МодульПользователи = ОбщегоНазначения.ОбщийМодуль("Пользователи");
		ЭтаФорма["ПользовательКлиентМСД"] = МодульПользователи.ТекущийПользователь(); 
		ПользовательАвтообменТекущееЗначение = ЭтаФорма["ПользовательКлиентМСД"]; 
		УстановитьКонстантуМСД("ПользовательКлиентМСД", ЭтаФорма["ПользовательКлиентМСД"]);
		ДобавитьУдалитьФормуАвтообменаПользователя(ЭтаФорма["ПользовательКлиентМСД"],,Истина); 
	КонецЕсли;
КонецПроцедуры 
	
&НаСервере
Процедура КонтрольНастроекТранспортногоСертификата(Отказ)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодИСОрганизацийМСД.Организация КАК Организация,
		|	КодИСОрганизацийМСД.КодИС КАК КодИС,
		|	КодИСОрганизацийМСД.ТранспортныйСертификат КАК ТранспортныйСертификат,
		|	ЕСТЬNULL(СертификатыКлючейЭлектроннойПодписиИШифрования.ВводитьПарольВПрограммеЭлектроннойПодписи, ЛОЖЬ) КАК ВводитьПарольВПрограммеЭлектроннойПодписи
		|ИЗ
		|	РегистрСведений.КодИСОрганизацийМСД КАК КодИСОрганизацийМСД
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СертификатыКлючейЭлектроннойПодписиИШифрования КАК СертификатыКлючейЭлектроннойПодписиИШифрования
		|		ПО КодИСОрганизацийМСД.ТранспортныйСертификат = СертификатыКлючейЭлектроннойПодписиИШифрования.Ссылка";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл 
		ПереченьОшибок = "";
		Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.КодИС) Тогда
			ПереченьОшибок = ПереченьОшибок + НСтр("ru='не заполнено техническое наименование ИС'", ОбщегоНазначения.КодОсновногоЯзыка());	
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ТранспортныйСертификат) Тогда
			ПереченьОшибок = ПереченьОшибок + ?(ЗначениеЗаполнено(ПереченьОшибок), ", ","") + НСтр("ru='не заполнен транспортный сертификат'", ОбщегоНазначения.КодОсновногоЯзыка());
		Иначе
			Если НЕ ВыборкаДетальныеЗаписи.ВводитьПарольВПрограммеЭлектроннойПодписи Тогда
				ПереченьОшибок = ПереченьОшибок + ?(ЗначениеЗаполнено(ПереченьОшибок), ", ","") + НСтр("ru='в настройках транспортного сертификата не установлена настройка ""Вводить пароль в приложении электронной подписи""'", ОбщегоНазначения.КодОсновногоЯзыка());	
			КонецЕсли;	
		КонецЕсли;
		Если ЗначениеЗаполнено(ПереченьОшибок) Тогда
			ТекстОшибки = СтрШаблон(НСтр("ru='Автоматический обмен с системой МСД ПУиО ГИИС ЭБ недоступен т.к. для организации %1 %2.'", ОбщегоНазначения.КодОсновногоЯзыка()), 
			ВыборкаДетальныеЗаписи.Организация, ПереченьОшибок);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
			Отказ = Истина;
			Возврат;
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры	

 &НаСервере
Процедура УстановитьДоступностьАвтоматическаяОтправка()
	АвтоматическаяОтправкаДоступна = НЕ ПодписыватьОтчетныеДанныеДляМСД ИЛИ НЕ ПодписыватьОперативныеДанныеДляМСД; 
	Элементы.АвтоматическаяОтправкаПакетовДанныхМСД.Доступность = АвтоматическаяОтправкаДоступна;
	Если ЭтаФорма["АвтоматическаяОтправкаПакетовДанныхМСД"] И НЕ АвтоматическаяОтправкаДоступна Тогда
		ЭтаФорма["АвтоматическаяОтправкаПакетовДанныхМСД"] = АвтоматическаяОтправкаДоступна;
		УстановитьКонстантуМСД("АвтоматическаяОтправкаПакетовДанныхМСД", ЭтаФорма["АвтоматическаяОтправкаПакетовДанныхМСД"]);
	КонецЕсли;	
КонецПроцедуры	

