
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУ.ИнициализироватьОтборКомпоновщикаНастроек(Параметры,,
		КомпоновщикНастроек, СхемаКомпоновкиДанных, УникальныйИдентификатор, Отказ);
		
	Элементы.ФормаКомандаОК.Видимость = Не ТолькоПросмотр;
	
	Если ЗначениеЗаполнено(Параметры.ЗаголовокОкна) Тогда
		Заголовок = Параметры.ЗаголовокОкна;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Оповещение = Новый ОписаниеОповещения("ВыбратьИЗакрыть", ЭтотОбъект);
	ОбщегоНазначенияКлиент.ПоказатьПодтверждениеЗакрытияФормы(Оповещение, Отказ, ЗавершениеРаботы);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Очистить(Команда)
	
	КомпоновщикНастроек.Настройки.Отбор.Элементы.Очистить();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОК(Команда)
	
	ВыбратьИЗакрыть();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВыбратьИЗакрыть(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если Модифицированность Тогда
		
		Модифицированность = Ложь;
		
		Отбор = КомпоновщикНастроек.Настройки.Отбор;
		
		Если Отбор.Элементы.Количество() = 0 Тогда
			НастройкиСтрокой = "";
			ОтборСтрокой = "";
		Иначе
			НастройкиСтрокой = СериализоватьДанные(КомпоновщикНастроек.Настройки);			
		    ОтборСтрокой = СериализоватьДанные(Отбор);
		КонецЕсли;
		
		Результат = Новый Структура;
		Результат.Вставить("КомпоновщикНастроек",	КомпоновщикНастроек);
		Результат.Вставить("НастройкиОтбора",		НастройкиСтрокой);
		Результат.Вставить("Отбор",					ОтборСтрокой);
		Результат.Вставить("ПредставлениеОтбора",	Строка(Отбор));
		
		ОповеститьОВыборе(Результат);
		
	Иначе
		
		Закрыть();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СериализоватьДанные(Знач Данные)
	
	Возврат ОбщегоНазначения.ЗначениеВСтрокуXML(Данные);
	
КонецФункции

#КонецОбласти
