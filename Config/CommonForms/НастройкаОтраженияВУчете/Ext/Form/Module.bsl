
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	// Заполним реквизиты формы из параметров.
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры, СписокРеквизитовДокумента());
	
	Организация = Параметры.Организация;
	Дата = Параметры.Дата;
	
	РежимДоходы = ?(Параметры.Свойство("РежимДоходы"), Параметры.РежимДоходы, Ложь);
	
	ЕстьНалоговыйУчет = ?(Параметры.Свойство("ЕстьНалоговыйУчет"), Параметры.ЕстьНалоговыйУчет, Истина);
	УстановитьФункциональныеОпцииФормы(ЕстьНалоговыйУчет);
	
	Элементы.ГруппаОтражениеВНУ.Доступность  = ОтражатьВНалоговомУчете;
	Элементы.ГруппаОтражениеВУСН.Доступность = ОтражатьВУСНДоходыМинусРасходы;
	Элементы.ГруппаСчетУчетаНДС.Видимость    = Параметры.ЕстьНДС;
	Элементы.КПСУчетаНДС.Видимость           = Параметры.ВидимостьКПСУчетаНДС;
	
	Элементы.ГруппаОтражениеВНУ.Видимость  = ЕстьНалоговыйУчет И ПлательщикНалогаНаПрибыль;
	Элементы.ГруппаОтражениеВУСН.Видимость = ЕстьНалоговыйУчет И ПрименяетсяУСНДоходыМинусРасходы И НЕ РежимДоходы;
	
	Элементы.ГруппаОтражениеВНУ.ТекущаяСтраница =
		?(РежимДоходы, Элементы.СтраницаОтражениеДоходовВНУ, Элементы.СтраницаОтражениеРасходовВНУ);
	
	ВидимостьКоличество = Истина;
	Если НЕ Параметры.Свойство("ВидимостьКоличество",ВидимостьКоличество) Тогда
		ВидимостьКоличество = Истина;
	КонецЕсли;
	Элементы.Количество.Видимость = ВидимостьКоличество;
	
	ВидимостьКФО = Истина;
	Если НЕ Параметры.Свойство("ВидимостьКФО",ВидимостьКФО) Тогда
		ВидимостьКФО = Истина;
	КонецЕсли;
	Элементы.КФО.Видимость = ВидимостьКФО;
	
	Если ВидимостьКоличество Тогда
		Если НЕ ЗначениеЗаполнено(Параметры.ЗаголовокКоличество) Тогда
			Параметры.ЗаголовокКоличество = НСтр("ru = 'Количество'");
		КонецЕсли;
		Элементы.Количество.Заголовок = Параметры.ЗаголовокКоличество;
	КонецЕсли;
	
	Если Не Параметры.Свойство("ОбязательностьКПС", ОбязательностьКПС) Тогда
		ОбязательностьКПС = Истина;
	КонецЕсли;
	Элементы.КПС.АвтоОтметкаНезаполненного = ОбязательностьКПС;
	
	ОбязательностьКЭК = Параметры.ВидимостьКЭК И НЕ Параметры.ТолькоПросмотрКЭК;
	
	Если Параметры.ТолькоПросмотр Тогда
		ЭтаФорма.ТолькоПросмотр = Истина;
	Иначе
		Элементы.КФО.ТолькоПросмотр 			= Параметры.ТолькоПросмотрКФО;
		Элементы.КПС.ТолькоПросмотр 			= Параметры.ТолькоПросмотрКПС;
		Элементы.КЭК.ТолькоПросмотр 			= Параметры.ТолькоПросмотрКЭК;
		Элементы.Подразделение.ТолькоПросмотр 	= Параметры.ТолькоПросмотрПодразделение;
	КонецЕсли;
	Элементы.КПС.Видимость = Параметры.ВидимостьКПС;
	Элементы.КЭК.Видимость = Параметры.ВидимостьКЭК;
	
	Если НЕ ЗначениеЗаполнено(Параметры.ЗаголовокФормы) Тогда
		ЭтаФорма.Заголовок = НСтр("ru = 'Настройка отражения в учете'");
	Иначе
		ЭтаФорма.Заголовок = Параметры.ЗаголовокФормы;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Параметры.ЗаголовокКФО) Тогда
		Параметры.ЗаголовокКФО = НСтр("ru = 'КФО'");
	КонецЕсли;
	Элементы.КФО.Заголовок = Параметры.ЗаголовокКФО;
	
	Если НЕ ЗначениеЗаполнено(Параметры.ЗаголовокСчет) Тогда
		Параметры.ЗаголовокСчет = НСтр("ru = 'Счет'");
	КонецЕсли;
	Элементы.Счет.Заголовок = Параметры.ЗаголовокСчет;
	
	Если НЕ ЗначениеЗаполнено(Параметры.ЗаголовокПодразделение) Тогда
		Параметры.ЗаголовокПодразделение = НСтр("ru = 'Подразделение'");
	КонецЕсли;
	
	Элементы.Подразделение.Заголовок = Параметры.ЗаголовокПодразделение;
	Если Параметры.РежимОбязательноУказатьПодразделение Тогда
		Элементы.Подразделение.ПодсказкаВвода = "";
	КонецЕсли;
	
	СчетОбработатьИзменение(ЭтаФорма);
	СчетНУОбработатьИзменение(ЭтаФорма);
	УстановитьПараметрыОтраженияВУСН(ЭтаФорма);
	УстановитьВидимостьСтатьиПрочихДоходовНУ(ЭтотОбъект);
	УстановитьВидимостьКарточкиКапвложений(ЭтотОбъект);
	УстановитьВидимостьГруппыКарточкиКапвложений(ЭтотОбъект);
		
	ОбъектСтруктура = Новый Структура();
	ОбъектСтруктура.Вставить("ПричинаНалогообложения",	Параметры["ПричинаНалогообложения"]);
	ОбъектСтруктура.Вставить("КФО",						Параметры["КФО"]);
	Если ЗначениеЗаполнено(Параметры["ДатаСФ"]) Тогда
		ОбъектСтруктура.Вставить("Дата",				Параметры["ДатаСФ"]);
	Иначе
		ОбъектСтруктура.Вставить("Дата",				Параметры["Дата"]);
	КонецЕсли;
	
	ПрименяемаяИнструкция_СтруктураСвойств = УчетНДС.ПрименяемаяИнструкция_СтруктураСвойств(ОбъектСтруктура);
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтаФорма, ЭтаФорма.Элементы.ИнформационныеСсылки);
	
	ОтключитьПроверкуЗаполненияСчета = Параметры.ОтключитьПроверкуЗаполненияСчета;
	Элементы.Счет.АвтоОтметкаНезаполненного = НЕ ОтключитьПроверкуЗаполненияСчета;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если ЗавершениеРаботы И Модифицированность Тогда
		ТекстПредупреждения = ОбщегоНазначенияБГУКлиент.СтандартныйТекстПредупрежденияПриЗавершенииРаботы();
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Модифицированность И НЕ ПеренестиВДокумент Тогда
		
		ТекстВопроса = НСтр("ru = 'Данные были изменены. Сохранить изменения?'");
		Оповещение = Новый ОписаниеОповещения("ВопросЗавершитьРедактирование", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена, , КодВозвратаДиалога.Да);
		Отказ = Истина;
		
	Иначе
		
		Если ПеренестиВДокумент И НЕ Отказ Тогда
			Отказ = НЕ ПроверитьЗаполнениеНаКлиенте();
		КонецЕсли;
		
		Если Отказ Тогда
			ПеренестиВДокумент = Ложь;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВопросЗавершитьРедактирование(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ПеренестиВДокумент = Истина;
		Закрыть();
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда
		Модифицированность = Ложь;
		ПеренестиВДокумент = Ложь;
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()

	Если ПеренестиВДокумент Тогда
		
		СтруктураРезультат = Новый Структура(СписокРеквизитовДокумента());
		ЗаполнитьЗначенияСвойств(СтруктураРезультат, ЭтаФорма);
		
		СтруктураРезультат.Вставить("ИмяРеквизитаСчет", Параметры.ИмяРеквизитаСчет);
		
		ОповеститьОВыборе(СтруктураРезультат);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ФормаНастройкаОтраженияВУчете_Закрыть" И Источник = ВладелецФормы Тогда
		// Сообщение от основной формы документа при нажатии там Esc.
		// Сбрасываем флаг модифицированности и закрываем форму редактирования строки без вопросов.
		Модифицированность = Ложь;
		Закрыть();
	КонецЕсли;

КонецПроцедуры
#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура КФОПриИзменении(Элемент)
	
	// Налоговый учет по налогу на прибыль.
	ОтражатьВНалоговомУчете = НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(
		Параметры.Организация, Параметры.Дата, КФО);
	
	Если НЕ ОтражатьВНалоговомУчете Тогда
		СчетНУ      = Неопределено;
		СубконтоНУ1 = Неопределено;
		СубконтоНУ2 = Неопределено;
		СубконтоНУ3 = Неопределено;
	КонецЕсли;
	
	Элементы.ГруппаОтражениеВНУ.Доступность = ОтражатьВНалоговомУчете;
	
	// УСН.
	ОтражатьВУСНДоходыМинусРасходы = УчетУСНКлиентСервер.ОтражатьВУСНДоходыМинусРасходы(
		Параметры.Организация, Параметры.Дата, КФО);
	
	Если НЕ ОтражатьВУСНДоходыМинусРасходы Тогда
		ОтражениеВУСН = ПредопределенноеЗначение("Перечисление.ОтражениеВУСН.ПустаяСсылка");
	КонецЕсли;
	
	Элементы.ОтражениеВУСН.Доступность = ОтражатьВУСНДоходыМинусРасходы;
	
КонецПроцедуры

&НаКлиенте
Процедура СчетПриИзменении(Элемент)
	
	СчетОбработатьИзменение(ЭтаФорма);
	
	УстановитьПараметрыОтраженияВУСН(ЭтаФорма);
	
	ЭтоКапвложения = ОбслуживаниеКарточекКапвложенийВызовСервера.ЭтоСчетКапвложений(Счет);
	Если НЕ ЭтоКапвложения И ОтразитьВКарточкеКапвложений Тогда
		ОтразитьВКарточкеКапвложений = Ложь;
	КонецЕсли;	
	УстановитьВидимостьГруппыКарточкиКапвложений(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура СчетНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Параметры.ПараметрыСчета = Неопределено Тогда
		Параметры.ПараметрыСчета = Новый Структура();
		Параметры.ПараметрыСчета.Вставить("ТипСчета", ПредопределенноеЗначение("Перечисление.ТипыСчетов.Бухгалтерский"));
		Параметры.ПараметрыСчета.Вставить("НеВыбиратьЗабалансовые", Истина);
	КонецЕсли;
	Параметры.ПараметрыСчета.Вставить("КодТекущейСтроки", ЭтаФорма.Счет);
	ОткрытьФорму("ПланСчетов.ЕПСБУ.ФормаВыбора", Параметры.ПараметрыСчета, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура СчетНУПриИзменении(Элемент)
	
	СчетНУОбработатьИзменение(ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура СчетНУНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Параметры.ПараметрыСчетаНУ = Неопределено Тогда
		Параметры.ПараметрыСчетаНУ = Новый Структура();
		Параметры.ПараметрыСчетаНУ.Вставить("ТипСчета", ПредопределенноеЗначение("Перечисление.ТипыСчетов.Налоговый"));
	КонецЕсли;
	Параметры.ПараметрыСчетаНУ.Вставить("КодТекущейСтроки", ЭтаФорма.СчетНУ);
	ОткрытьФорму("ПланСчетов.ЕПСБУ.ФормаВыбора", Параметры.ПараметрыСчетаНУ, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура СчетДоходовНУПриИзменении(Элемент)
	
	УстановитьВидимостьСтатьиПрочихДоходовНУ(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура СчетДоходовНУНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Параметры.ПараметрыСчетаНУ = Неопределено Тогда
		Параметры.ПараметрыСчетаНУ = Новый Структура();
		Параметры.ПараметрыСчетаНУ.Вставить("ТипСчета", ПредопределенноеЗначение("Перечисление.ТипыСчетов.Налоговый"));
	КонецЕсли;
	Параметры.ПараметрыСчетаНУ.Вставить("КодТекущейСтроки", ЭтаФорма.СчетНУ);
	ОткрытьФорму("ПланСчетов.ЕПСБУ.ФормаВыбора", Параметры.ПараметрыСчетаНУ, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура НДСКРаспределениюПриИзменении(Элемент)
	
	Если НДСКРаспределению Тогда
		СчетСсылка = ПрименяемаяИнструкция_СтруктураСвойств["СчетВычетКтКРаспределениюПоУмолчанию"];
		Если НЕ ЗначениеЗаполнено(СчетСсылка) Тогда
			СчетСсылка = СчетУчетаНДСПоКоду("210.Н2", Дата, Организация);
		КонецЕсли;
	Иначе
		СчетСсылка = ПрименяемаяИнструкция_СтруктураСвойств["СчетВычетКтБезРаспределенияПоУмолчанию"];
		Если НЕ ЗначениеЗаполнено(СчетСсылка) Тогда
			СчетСсылка = СчетУчетаНДСПоКоду("210.Р2", Дата, Организация);
		КонецЕсли;
	КонецЕсли;
	
	СчетУчетаНДС = СчетСсылка;
	
КонецПроцедуры

&НаКлиенте
Процедура СчетУчетаНДСНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("КодТекущейСтроки", ЭтаФорма.СчетУчетаНДС);
	
	СчетВычетКт = ПрименяемаяИнструкция_СтруктураСвойств["СчетВычетКт"];
	Если ЗначениеЗаполнено(СчетВычетКт) Тогда
		Если ТипЗнч(СчетВычетКт) = Тип("ПланСчетовСсылка.ЕПСБУ") Тогда
			ПараметрыФормы.Вставить("ОграниченияСчета",			СчетВычетКт);
		Иначе
			ПараметрыФормы.Вставить("ОграниченияСписокСчетов",	СчетВычетКт);
		КонецЕсли;
	Иначе
		ПараметрыФормы.Вставить("ОграниченияСписокСчетов",		БухгалтерскийУчетКлиентСервер.СписокСчетов("210.Р1,210.Н1,210.11,210.Р2,210.Н2", Дата,, Организация));
	КонецЕсли;
	
	ОткрытьФорму("ПланСчетов.ЕПСБУ.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура Субконто1ПриИзменении(Элемент)
	ПриИзмененииСубконто(1);
КонецПроцедуры

&НаКлиенте
Процедура Субконто2ПриИзменении(Элемент)
	ПриИзмененииСубконто(2);
КонецПроцедуры

&НаКлиенте
Процедура Субконто3ПриИзменении(Элемент)
	ПриИзмененииСубконто(3);
КонецПроцедуры

&НаКлиенте
Процедура Субконто1НачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтруктураВыбораСубконто = БухгалтерскийУчетКлиент.ИнициализироватьСтруктуруНачалаВыбораСубконто(1,
		Параметры.Организация, КФО, КПС, КЭК, Счет, Субконто1, Субконто2, Субконто3);
	БухгалтерскийУчетКлиент.ПриНачалеВыбораСубконто(Элемент, ДанныеВыбора, СтандартнаяОбработка, СтруктураВыбораСубконто);
	
КонецПроцедуры

&НаКлиенте
Процедура Субконто2НачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтруктураВыбораСубконто = БухгалтерскийУчетКлиент.ИнициализироватьСтруктуруНачалаВыбораСубконто(2,
		Параметры.Организация, КФО, КПС, КЭК, Счет, Субконто1, Субконто2, Субконто3);
	БухгалтерскийУчетКлиент.ПриНачалеВыбораСубконто(Элемент, ДанныеВыбора, СтандартнаяОбработка, СтруктураВыбораСубконто);
	
КонецПроцедуры

&НаКлиенте
Процедура Субконто3НачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
