&НаКлиенте
Процедура КПСНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОрганиченияКПС = Неопределено;
	
	Если ЗначениеЗаполнено(Счет) Тогда
		ОрганиченияКПС = Счет;
	ИначеЕсли Тип(Параметры.ПараметрыСчета) = Тип("Структура") И Параметры.ПараметрыСчета.Свойство("ОграниченияСписокСчетов") Тогда
		ОрганиченияКПС = Параметры.ПараметрыСчета.ОграниченияСписокСчетов;
	КонецЕсли;	
	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКПС(Элемент, СтандартнаяОбработка, КПС, Параметры.Организация, Параметры.ИФО, КФО, ОрганиченияКПС, Параметры.Дата);

КонецПроцедуры

&НаКлиенте
Процедура КЭКНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ПараметрыВыбораКЭК = Новый Массив;
	
	Если ТипЗнч(Параметры.ПараметрыКЭК) = Тип("Структура") И Параметры.ПараметрыКЭК.Свойство("ДопустимыеКЭК") Тогда
		
		ДопустимыеКЭК = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(
			Параметры.ПараметрыКЭК.ДопустимыеКЭК, ",");
		
		ПараметрВыбораКЭК = Новый ПараметрВыбора("Отбор.Код", Новый ФиксированныйМассив(ДопустимыеКЭК));
		ПараметрыВыбораКЭК.Добавить(ПараметрВыбораКЭК);
		
	КонецЕсли;
	
	Элементы.КЭК.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораКЭК);
	
КонецПроцедуры

&НаКлиенте
Процедура СчетОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)          
	Если НЕ ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;	
	
	Счета = Новый Соответствие; 
	ЭлементЗначение = ЭтотОбъект[Элемент.Имя];
	Счета.Вставить(ЭлементЗначение);
	Счета.Вставить(ВыбранноеЗначение);
	ОбслуживаниеКарточекКапвложенийВызовСервера.ОпределитьСчетаКапвложений(Счета);
	Если НЕ Счета[ЭлементЗначение] И Счета[ВыбранноеЗначение] И НЕ ОтразитьВКарточкеКапвложений Тогда
		ОтразитьВКарточкеКапвложений = Истина;
	КонецЕсли;	
КонецПроцедуры

