&НаКлиентеНаСервереБезКонтекста
Функция СписокРеквизитовДокумента()
	
	Возврат "КФО, КПС, КЭК, Подразделение,
	|Счет, Субконто1, Субконто2, Субконто3,
	|СчетНУ, СубконтоНУ1, СубконтоНУ2, СубконтоНУ3,
	|ВидДеятельностиНУ, СтатьяПрочихДоходовНУ,
	|Количество,
	|НДСКРаспределению, СчетУчетаНДС, КПСУчетаНДС,
	|ОтражениеВУСН,
	|ОтразитьВКарточкеКапвложений, КарточкаКапвложений";
	
КонецФункции

&НаСервере
Процедура УстановитьФункциональныеОпцииФормы(ЕстьНалоговыйУчет)
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьПараметрОрганизацияФункциональныхОпцийФормы(
		ЭтаФорма, Параметры.Организация, Параметры.Дата);
	
	ПлательщикНалогаНаПрибыль = НалоговыйУчетВызовСервера.ПлательщикНалогаНаПрибыль(
		Параметры.Организация, Параметры.Дата);
	ОтражатьВНалоговомУчете   = ЕстьНалоговыйУчет
		И НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(Параметры.Организация, Параметры.Дата, КФО);
	
	ПрименяетсяУСНДоходыМинусРасходы = УчетУСНВызовСервера.ПрименяетсяУСНДоходыМинусРасходы(
		Параметры.Организация, Параметры.Дата);
	ОтражатьВУСНДоходыМинусРасходы = ЕстьНалоговыйУчет
		И УчетУСНКлиентСервер.ОтражатьВУСНДоходыМинусРасходы(Параметры.Организация, Параметры.Дата, КФО);
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьЗаполнениеНаКлиенте()

	Отказ = Ложь;

	// КФО
	Если НЕ Параметры.ТолькоПросмотрКФО И НЕ ЗначениеЗаполнено(КФО) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение", Параметры.ЗаголовокКФО);
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , "КФО", "", Отказ);
	КонецЕсли;
	
	// КПС
	Если Параметры.ВидимостьКПС И НЕ Параметры.ТолькоПросмотрКПС И ОбязательностьКПС И НЕ ЗначениеЗаполнено(КПС) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение", НСтр("ru = 'КПС'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , "КПС", "", Отказ);
	КонецЕсли;
	
	// КЭК
	Если Параметры.ВидимостьКЭК И НЕ Параметры.ТолькоПросмотрКЭК И ОбязательностьКЭК И НЕ ЗначениеЗаполнено(КЭК) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение", НСтр("ru = 'КЭК'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , "КЭК", "", Отказ);
	КонецЕсли;
	
	// Счет
	Если НЕ ОтключитьПроверкуЗаполненияСчета Тогда
		Если НЕ ЗначениеЗаполнено(Счет) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение", Параметры.ЗаголовокСчет);
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , "Счет", "", Отказ);
		Иначе
			// Субконто
			СвойстваСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(Счет);
			Для Инд = 1 По СвойстваСчета.КоличествоСубконто Цикл
				Если СвойстваСчета["ВидСубконто" + Инд + "Обязательный"]
				   И Не ЗначениеЗаполнено(ЭтаФорма["Субконто" + Инд]) Тогда
					Если СвойстваСчета["ВидСубконто" + Инд] = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.Партии") Тогда
						// Не проверяем заполнение субконто "Партии".
						// Субконто "Партии" доступно только для счетов 106.хП. Если на счете 105.ХХ ведется учет по партиям,
						// значение субконто "Партии" устанавливается автоматически - ссылкой на текущий документ.
					Иначе
						ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение",
							СвойстваСчета["ВидСубконто" + Инд + "Наименование"]);
						ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , "Субконто" + Инд, "", Отказ);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	// Счет учета НДС
	Если Параметры.ЕстьНДС И НЕ ЗначениеЗаполнено(СчетУчетаНДС) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение", НСтр("ru = 'Счет учета НДС'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , "СчетУчетаНДС", "", Отказ);
	КонецЕсли;
	
	// Карточки капвложений
	Если ОтразитьВКарточкеКапвложений И НЕ ЗначениеЗаполнено(КарточкаКапвложений) Тогда
		ТекстСообщения = НСтр(
			"ru = 'Поле ""Карточка капвложений"" не заполнено при включенном флажке ""Отразить в карточке капвложений"". 
			|Заполните карточку или отключите флажок'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , "КарточкаКапвложений", "", Отказ);
	КонецЕсли;
	
	Если ОтражатьВНалоговомУчете Тогда
		
		Если Параметры.РежимДоходы Тогда
			
			// Вид деятельности (НУ).
			Если НЕ ЗначениеЗаполнено(ВидДеятельностиНУ) Тогда
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение", НСтр("ru = 'Вид деятельности (НУ)'"));
				ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , "ВидДеятельностиНУ", "", Отказ);
			КонецЕсли;
			
			// Счет (НУ).
			Если НЕ ЗначениеЗаполнено(СчетНУ) Тогда
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение", НСтр("ru = 'Счет доходов (НУ)'"));
				ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , "СчетДоходовНУ", "", Отказ);
			КонецЕсли;
			
			// Статья прочих доходов (НУ).
			Если НЕ ЗначениеЗаполнено(СтатьяПрочихДоходовНУ)
				И БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетНУ, "Н91.01") Тогда
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение", НСтр("ru = 'Статья прочих доходов (НУ)'"));
				ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , "СтатьяПрочихДоходовНУ", "", Отказ);
			КонецЕсли;
			
		Иначе // Расходы.
		
			// Счет НУ.
			Если ВыбранСчетПрочихДоходовРасходов И НЕ ЗначениеЗаполнено(СчетНУ) Тогда
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение", НСтр("ru = 'Счет (НУ)'"));
				ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , "СчетНУ", "", Отказ);
			КонецЕсли;
			
			// Субконто НУ.
			Если ЗначениеЗаполнено(СчетНУ) Тогда
				СвойстваСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(СчетНУ);
				Для Инд = 1 По СвойстваСчета.КоличествоСубконто Цикл
					Если СвойстваСчета["ВидСубконто" + Инд + "Обязательный"]
					   И Не ЗначениеЗаполнено(ЭтаФорма["СубконтоНУ" + Инд]) Тогда
						ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение",
							СвойстваСчета["ВидСубконто" + Инд + "Наименование"]);
						ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , "СубконтоНУ" + Инд, "", Отказ);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;

	Возврат Не Отказ;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура СчетОбработатьИзменение(Форма)

	СвойстваСчета   = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(Форма.Счет);
	СвойстваСчетаНУ = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(Форма.СчетНУ);
	
	МассивПолей = Новый Массив;
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто1", "Субконто1", "Субконто1", Истина, "Субконто1", Истина, Ложь, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто2", "Субконто2", "Субконто2", Истина, "Субконто2", Истина, Ложь, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто3", "Субконто3", "Субконто3", Истина, "Субконто3", Истина, Ложь, Истина);
	БухгалтерскийУчетКлиентСервер.УстановитьЗаголовкиИДоступностьСубконто(Форма.Счет, Форма, Форма, МассивПолей);
	
	СубконтоДокументыРасчетовДоступно = БухгалтерскийУчетКлиентСервер.СчетВИерархии(Форма.Счет, "302.00")
	   И УчетРасчетовКлиентСервер.ВедетсяУчетПоДокументамРасчетов(
			Форма.Параметры.Организация, Форма.Параметры.Дата,
			Форма.КФО, Форма.Параметры.Валюта, Форма.Счет);
	СубконтоПартииДоступно = БухгалтерскийУчетКлиентСервер.СчетВИерархии(Форма.Счет, "106.2П,106.3П,106.4П");
	Для Индекс = 1 По 3 Цикл
		СубконтоДоступно = Форма.Элементы["Субконто"+Индекс].Доступность;
		Если СвойстваСчета["ВидСубконто" + Индекс] =
			ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.ДокументыРасчетов") Тогда
			// Субконто "Документы расчетов" доступно, только если на счете 302.ХХ ведется учет по документам расчетов.
			СубконтоДоступно = СубконтоДокументыРасчетовДоступно;
			Форма.Элементы["Субконто"+Индекс].Доступность = СубконтоДоступно;
		ИначеЕсли СвойстваСчета["ВидСубконто" + Индекс] =
			ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.Партии") Тогда
			// Субконто "Партии" доступно только для счетов 106.хП. Если на счете 105.ХХ ведется учет по партиям,
			// значение субконто "Партии" устанавливается автоматически - ссылкой на текущий документ.
			СубконтоДоступно = СубконтоПартииДоступно;
			Форма.Элементы["Субконто"+Индекс].Доступность = СубконтоДоступно;
		КонецЕсли;
		Если НЕ СубконтоДоступно Тогда
			Форма["Субконто"+Индекс] = Неопределено;
		ИначеЕсли Не ЗначениеЗаполнено(Форма["Субконто"+Индекс])
			И ЗначениеЗаполнено(Форма.Параметры["Субконто"+Индекс])
			И СвойстваСчета["ВидСубконто" + Индекс] <> Неопределено
			И СвойстваСчета["ВидСубконто" + Индекс + "ТипЗначения"].СодержитТип(ТипЗнч(Форма.Параметры["Субконто"+Индекс])) Тогда
			Форма["Субконто"+Индекс] = Форма.Параметры["Субконто"+Индекс];
		КонецЕсли;
	КонецЦикла;
	
	ЕстьКоличество  = СвойстваСчета.Количественный
		ИЛИ (Форма.ОтражатьВНалоговомУчете И СвойстваСчетаНУ.Количественный);
	
	Форма.Элементы.Количество.Доступность = ЕстьКоличество;
	Форма.Количество = ?(ЕстьКоличество, Форма.Количество, 0);
	
	Для Индекс = 1 По 3 Цикл
		Форма["ВводПустыхСубконто"+Индекс] = Не СвойстваСчета["ВидСубконто" + Индекс + "Обязательный"];
	КонецЦикла;
	
	Форма.ВыбранСчетПрочихДоходовРасходов = БухгалтерскийУчетКлиентСервер.СчетВИерархии(Форма.Счет, "401.10,401.20");
	
	ВедетсяУчетПоПодразделениям = Форма.ИспользоватьУчетПоПодразделениям И СвойстваСчета.УчетПоПодразделениям И Форма.Параметры.ВидимостьПодразделение;
	Форма.Элементы.Подразделение.Видимость = ВедетсяУчетПоПодразделениям;
	Форма.Элементы.Подразделение.АвтоОтметкаНезаполненного = ВедетсяУчетПоПодразделениям И Не СвойстваСчета.РазрешитьНеУказыватьПодразделение
		И Форма.Параметры.РежимОбязательноУказатьПодразделение;
	
	ЭтоСчетСОборотнымКЭК = НЕ (БухгалтерскийУчетВызовСервераПовтИсп.СчетаСОборотнымКЭК().Найти(Форма.Счет) = Неопределено);
	
	Форма.Элементы.КЭК.Видимость = Форма.Параметры.ВидимостьКЭК И НЕ ЭтоСчетСОборотнымКЭК;
	Форма.ОбязательностьКЭК = Форма.Параметры.ВидимостьКЭК И НЕ ЭтоСчетСОборотнымКЭК;
	Форма.КЭК = ?(ЭтоСчетСОборотнымКЭК, "", ?(ЗначениеЗаполнено(Форма.КЭК), Форма.КЭК, Форма.Параметры.КЭК));

	БухгалтерскийУчетКлиентСервер.УстановитьПараметрыВыбораСубконтоПриИзмененииСчета(
		Форма, Форма, ПараметрыУстановкиСвойствСубконто(Форма));
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура СчетНУОбработатьИзменение(Форма)

	МассивПолей = Новый Массив;
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто1", "СубконтоНУ1", "СубконтоНУ1", Истина, "СубконтоНУ1", Истина, Ложь, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто2", "СубконтоНУ2", "СубконтоНУ2", Истина, "СубконтоНУ2", Истина, Ложь, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто3", "СубконтоНУ3", "СубконтоНУ3", Истина, "СубконтоНУ3", Истина, Ложь, Истина);
	БухгалтерскийУчетКлиентСервер.УстановитьЗаголовкиИДоступностьСубконто(Форма.СчетНУ, Форма, Форма, МассивПолей);

	Для Индекс = 1 По 3 Цикл
		Форма.Элементы["СубконтоНУ"+Индекс].Видимость = Форма.Элементы["СубконтоНУ"+Индекс].Доступность;
	КонецЦикла;
	
	СвойстваСчета   = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(Форма.Счет);
	СвойстваСчетаНУ = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(Форма.СчетНУ);
	
	ЕстьКоличество  = СвойстваСчета.Количественный
		ИЛИ (Форма.ОтражатьВНалоговомУчете И СвойстваСчетаНУ.Количественный);
	
	Форма.Элементы.Количество.Доступность = ЕстьКоличество;
	Форма.Количество = ?(ЕстьКоличество, Форма.Количество, 0);
	
	Для Индекс = 1 По 3 Цикл
		Форма["ВводПустыхСубконтоНУ"+Индекс] = Не СвойстваСчетаНУ["ВидСубконто" + Индекс + "Обязательный"];
	КонецЦикла;
	
	Форма.ВыбранСчетНПВ = БухгалтерскийУчетКлиентСервер.СчетВИерархии(Форма.СчетНУ, "НПВ");

	БухгалтерскийУчетКлиентСервер.УстановитьПараметрыВыбораСубконтоПриИзмененииСчета(
		Форма, Форма, ПараметрыУстановкиСвойствСубконтоНУ(Форма));

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция УстановитьПараметрыОтраженияВУСН(Форма)

	Если Форма.ОтражатьВУСНДоходыМинусРасходы Тогда
		
		Если БухгалтерскийУчетКлиентСервер.СчетВИерархии(Форма.Счет, "206.00,302.00") Тогда
			Форма.Элементы.ОтражениеВУСН.Доступность = Ложь;
			
		ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(Форма.Счет, "105.00") Тогда
			Форма.Элементы.ОтражениеВУСН.Доступность = Истина;
			
			ВариантыОтраженияВУСН = Новый Массив;
			ВариантыОтраженияВУСН.Добавить(ПредопределенноеЗначение("Перечисление.ОтражениеВУСН.Принимаются"));
			ВариантыОтраженияВУСН.Добавить(ПредопределенноеЗначение("Перечисление.ОтражениеВУСН.НеПринимаются"));
			Форма.Элементы.ОтражениеВУСН.СписокВыбора.ЗагрузитьЗначения(ВариантыОтраженияВУСН);
			
		Иначе
			Форма.Элементы.ОтражениеВУСН.Доступность = Истина;
			
			ВариантыОтраженияВУСН = Новый Массив;
			ВариантыОтраженияВУСН.Добавить(ПредопределенноеЗначение("Перечисление.ОтражениеВУСН.Принимаются"));
			ВариантыОтраженияВУСН.Добавить(ПредопределенноеЗначение("Перечисление.ОтражениеВУСН.НеПринимаются"));
			ВариантыОтраженияВУСН.Добавить(ПредопределенноеЗначение("Перечисление.ОтражениеВУСН.ОсобыйПорядок"));
			ВариантыОтраженияВУСН.Добавить(ПредопределенноеЗначение("Перечисление.ОтражениеВУСН.Распределяются"));
			Форма.Элементы.ОтражениеВУСН.СписокВыбора.ЗагрузитьЗначения(ВариантыОтраженияВУСН);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьСтатьиПрочихДоходовНУ(Форма)
	
	Форма.Элементы.СтатьяПрочихДоходовНУ.Видимость =
		БухгалтерскийУчетКлиентСервер.СчетВИерархии(Форма.СчетНУ, "Н91.01");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьКарточкиКапвложений(Форма)
	Форма.Элементы.КарточкаКапвложений.Видимость = Форма.ОтразитьВКарточкеКапвложений;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьГруппыКарточкиКапвложений(Форма)
	Форма.Элементы.ГруппаКарточкиКапвложений.Видимость = ОбслуживаниеКарточекКапвложенийВызовСервера.ЭтоСчетКапвложений(Форма.Счет);
	УстановитьВидимостьКарточкиКапвложений(Форма);
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииСубконто(НомерСубконто)
	
	БухгалтерскийУчетКлиентСервер.УстановитьПараметрыВыбораСубконтоПриИзмененииСубконто(
		ЭтотОбъект, ЭтотОбъект, НомерСубконто, ПараметрыУстановкиСвойствСубконто(ЭтотОбъект));
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПараметрыУстановкиСвойствСубконто(Форма)

	Результат = БухгалтерскийУчетКлиентСервер.ПараметрыУстановкиСвойствСубконтоПоШаблону(
		"Субконто", "Субконто", "Счет");
		
	Результат.ДопРеквизиты.Вставить("Организация", Форма.Организация);
	
	Возврат Результат;

КонецФункции

&НаКлиенте
Процедура ПриИзмененииСубконтоНУ(НомерСубконто)
	
	БухгалтерскийУчетКлиентСервер.УстановитьПараметрыВыбораСубконтоПриИзмененииСубконто(
		ЭтотОбъект, ЭтотОбъект, НомерСубконто, ПараметрыУстановкиСвойствСубконтоНУ(ЭтотОбъект));
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПараметрыУстановкиСвойствСубконтоНУ(Форма)

	Результат = БухгалтерскийУчетКлиентСервер.ПараметрыУстановкиСвойствСубконтоПоШаблону(
		"СубконтоНУ", "СубконтоНУ", "СчетНУ");
		
	Результат.ДопРеквизиты.Вставить("Организация", Форма.Организация);
	
	Возврат Результат;

КонецФункции

#КонецОбласти
