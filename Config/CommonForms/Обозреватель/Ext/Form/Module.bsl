
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	ИспользоватьАвторизацию = Параметры.ИспользоватьАвторизацию;
	
	Если НЕ ПустаяСтрока(Параметры.Заголовок) Тогда
		Заголовок = Параметры.Заголовок;	
	КонецЕсли;
	
	Если Параметры.ЭтоОбщийМакет Тогда
		
		АдресСтраницы = ПолучитьОбщийМакет(Параметры.АдресСтраницы).ПолучитьТекст();
		
	Иначе	
		
		АдресСтраницы = Параметры.АдресСтраницы;
		
	КонецЕсли;
	
	HTMLТекст = АдресСтраницы;
	
	Элементы.АдреснаяСтрока.Видимость = Параметры.ПоказыватьАдреснуюСтроку;
	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПерейтиКСтранице(Команда)
	ОткрытьСтраницуПоАдресу();
КонецПроцедуры

&НаКлиенте
Процедура Вперед(Команда)
   Элементы.HTMLТекст.Вперед();
КонецПроцедуры

&НаКлиенте
Процедура Назад(Команда)
   Элементы.HTMLТекст.Назад();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОткрытьСтраницуПоАдресу()
	HTMLТекст = АдресСтраницы;
КонецПроцедуры

&НаКлиенте
Процедура HTMLТекстПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	
	НавигационнаяСсылка = Неопределено;
	
	Если СтрНачинаетсяС(ВРЕГ(ДанныеСобытия.Href), ВРЕГ("http://")) ИЛИ СтрНачинаетсяС(ВРЕГ(ДанныеСобытия.Href), ВРЕГ("https://")) Тогда
		НавигационнаяСсылка = ДанныеСобытия.Href;
	ИначеЕсли СтрНачинаетсяС(ВРЕГ(ДанныеСобытия.Element.id), ВРЕГ("e1cib/")) Тогда	
		НавигационнаяСсылка = ДанныеСобытия.Element.id;
	КонецЕсли;

	Если ЗначениеЗаполнено(НавигационнаяСсылка) Тогда
		СтандартнаяОбработка = Ложь;
		Если ИспользоватьАвторизацию Тогда
			ИнтернетПоддержкаПользователейКлиент.ОткрытьСтраницуИнтегрированногоСайта(НавигационнаяСсылка);
		Иначе
			ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку(НавигационнаяСсылка);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
