#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗагрузитьПереданныеСведения();
	
	НастроитьФорму();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗавершениеРаботы И (Модифицированность Или ПеренестиВДокумент) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Модифицированность И Не ПеренестиВДокумент Тогда
		Отказ = Истина;
		ТекстВопроса = НСтр("ru='Данные были изменены. Сохранить изменения?'");
		Оповещение = Новый ОписаниеОповещения("ВопросПеренестиВДокументЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена);
	КонецЕсли;
	
	Если ПеренестиВДокумент И Не Отказ Тогда
		Отказ = Не ПроверитьЗаполнение();
	КонецЕсли;
	
	Если Отказ Тогда
		ПеренестиВДокумент = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	
	Если ПеренестиВДокумент Тогда
		ВозвращаемоеЗначение = ПолучитьВозвращаемоеЗначение();
		ОповеститьОВыборе(ВозвращаемоеЗначение);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	ПроверяемыеРеквизиты.Очистить();
	
	НомерСтроки = 0;
	
	Для Каждого СтрокаТаблицы Из СчетаФактурыНаОтгрузку Цикл
		НомерСтроки = НомерСтроки + 1;
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.Дата) Тогда
			СообщитьОНезаполненнойДате(НомерСтроки, Отказ);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.Номер) Тогда
			СообщитьОНезаполненномНомере(НомерСтроки, Отказ);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.СчетФактура) Тогда
			Если СтрокаТаблицы.СчетФактура = Параметры.СчетФактура Тогда
				СообщитьОЦиклическойСсылке(НомерСтроки, Отказ);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СообщитьОНезаполненнойДате(НомерСтроки, Отказ)
	
	ОбщегоНазначения.СообщитьПользователю(
		СтрШаблон(НСтр("ru = 'В строке %1 не заполнена дата счета-фактуры.'"), НомерСтроки),
		,
		ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СчетаФактурыНаОтгрузку", НомерСтроки, "Дата"),
		,
		Отказ);
	
КонецПроцедуры

&НаСервере
Процедура СообщитьОНезаполненномНомере(НомерСтроки, Отказ)
	
	ОбщегоНазначения.СообщитьПользователю(
		СтрШаблон(НСтр("ru = 'В строке %1 не заполнен номер счета-фактуры.'"), НомерСтроки),
		,
		ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СчетаФактурыНаОтгрузку", НомерСтроки, "Номер"),
		,
		Отказ);
	
КонецПроцедуры

&НаСервере
Процедура СообщитьОЦиклическойСсылке(НомерСтроки, Отказ)
	
	ОбщегоНазначения.СообщитьПользователю(
		СтрШаблон(НСтр("ru = 'В строке %1 обнаружена ссылка на редактируемый документ счета-фактуры.'"), НомерСтроки),
		,
		ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СчетаФактурыНаОтгрузку", НомерСтроки, "СчетФактура"),
		,
		Отказ);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ОтборСписокКФОНажатие(Элемент, СтандартнаяОбработка)
	
	ПоказатьЗначенияСпискаОтбора(Элемент, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборСписокКПСНажатие(Элемент, СтандартнаяОбработка)
	
	ПоказатьЗначенияСпискаОтбора(Элемент, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборСписокСчетовНажатие(Элемент, СтандартнаяОбработка)
	
	ПоказатьЗначенияСпискаОтбора(Элемент, СтандартнаяОбработка);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_СчетаФактурыНаОтгрузку

&НаКлиенте
Процедура СчетаФактурыНаОтгрузкуСчетФактураПриИзменении(Элемент)
	
	ТекДанные = Элементы.СчетаФактурыНаОтгрузку.ТекущиеДанные;
	
	СведенияСФ = ПрочитатьСведенияСФ(ТекДанные.СчетФактура);
	
	ЗаполнитьЗначенияСвойств(ТекДанные, СведенияСФ);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Заполнить(Команда)
	
	ПодтвердитьИЗаполнить();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаписатьИЗакрыть(Команда)
	
	ПеренестиВДокумент = Истина;
	
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОтмена(Команда)
	
	Модифицированность = Ложь;
	
	Закрыть();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗагрузитьПереданныеСведения()
	
	АдресДанных = Параметры.АдресДанных;
	
	Данные = ПолучитьИзВременногоХранилища(АдресДанных);
	
	УчетНДС.УдалитьПустыеЗначенияИзОтбораОстатковВходящийНДСАвансыПолученные(Данные.Отбор);
	
	СчетаФактурыНаОтгрузку.Загрузить(Данные.СчетаФактурыНаОтгрузку);
	
	Если Не ЗначениеЗаполнено(Данные.Отбор.НаДату) Тогда
		Данные.Отбор.НаДату = ТекущаяДатаСеанса();
	КонецЕсли;
	
	ПереданныйОтбор = Новый ФиксированнаяСтруктура(Данные.Отбор);
	
	ОтборСписокКПС.ЗагрузитьЗначения(Данные.Отбор.СписокКПССчетРасчетов);
	ОтборСписокКФО.ЗагрузитьЗначения(Данные.Отбор.СписокКФО);
	ОтборСписокСчетов.ЗагрузитьЗначения(Данные.Отбор.СписокСчетовРасчетов);
	
	СчетФактураНаАванс	= Параметры.СчетФактура;
	
	НаДату = Данные.Отбор.НаДату;
	
	Если ТипЗнч(НаДату) = Тип("МоментВремени") Тогда
		ДатаЗачетаАванса = НаДату.Дата;
		
	ИначеЕсли ТипЗнч(НаДату) = Тип("Дата") Тогда
		ДатаЗачетаАванса = НаДату;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФорму()
	
	Если ЗначениеЗаполнено(Параметры.СчетФактура) Тогда
		ДоступноРедактирование = ПравоДоступа("Изменение", Параметры.СчетФактура.Метаданные());
	Иначе
		ДоступноРедактирование = Истина;
	КонецЕсли;
	
	ЭтотОбъект.ТолькоПросмотр = Не ДоступноРедактирование;
	
	Элементы.ФормаКомандаЗаписатьИЗакрыть.Доступность = ДоступноРедактирование;
	
	УстановитьПараметрыВыбораСчетаФактуры();
	
	ИменаЭлементов = СтрРазделить("ОтборСписокКФО,ОтборСписокКПС,ОтборСписокСчетов", ", ", Ложь);
	
	ВсеЭлементыОтбораСкрыты = Истина;
	
	Для Каждого ИмяЭлемента Из ИменаЭлементов Цикл
		СписокОтбора = ЭтотОбъект[ИмяЭлемента];
		
		Если СписокОтбора.Количество() = 0 Тогда
			Элементы[ИмяЭлемента].Видимость = Ложь;
		Иначе
			ВсеЭлементыОтбораСкрыты = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Если ВсеЭлементыОтбораСкрыты Тогда
		Элементы.ДекорацияНадписьОтбор.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыВыбораСчетаФактуры()
	
	МассивПараметров = Новый Массив();
	
	НовыйПараметр = Новый ПараметрВыбора("Отбор.Организация", ПереданныйОтбор.Организация);
	МассивПараметров.Добавить(НовыйПараметр);
	
	НовыйПараметр = Новый ПараметрВыбора("Отбор.Контрагент", ПереданныйОтбор.СписокКонтрагентов);
	МассивПараметров.Добавить(НовыйПараметр);
	
	НовыйПараметр = Новый ПараметрВыбора("Отбор.Договор", ПереданныйОтбор.СписокДоговоров);
	МассивПараметров.Добавить(НовыйПараметр);
	
	НовыйПараметр = Новый ПараметрВыбора("Отбор.Проведен", Истина);
	МассивПараметров.Добавить(НовыйПараметр);
	
	НовыйПараметр = Новый ПараметрВыбора("Отбор.ПричинаНалогообложения", Перечисления.ПричиныНалогообложенияНДС.Реализация);
	МассивПараметров.Добавить(НовыйПараметр);
	
	Элементы.СчетаФактурыНаОтгрузкуСчетФактура.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметров);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьИЗаполнить()
	
	Если СчетаФактурыНаОтгрузку.Количество() > 0 Тогда
		ТекстВопроса = НСтр("ru='Перед автоматическим заполнением таблица будет очищена.
			|
			|Продолжить и заполнить таблицу?'");
		
		Оповещение = Новый ОписаниеОповещения("ПодтвердитьИЗаполнитьЗавершение", ЭтотОбъект);
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
		Возврат;
	КонецЕсли;
	
	ЗаполнитьКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьИЗаполнитьЗавершение(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = КодВозвратаДиалога.Да Тогда
		ЗаполнитьКлиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКлиент()
	
	ЗаполнитьСервер();
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСервер()
	
	СчетаФактурыНаОтгрузку.Очистить();
	
	Отбор = УчетНДС.НовыйОтборОстаткиВходящийНДСАвансыПолученные();
	
	ЗаполнитьЗначенияСвойств(Отбор, ПереданныйОтбор);
	
	ТаблицаДокументов = УчетНДС.ПолучитьТаблицуДокументовСчетовФактурНаОтгрузку(Отбор, Параметры.ИсключитьРегистратор);
	
	ТаблицаДокументов.Свернуть("СчетФактура,Дата,Номер");
	
	СчетаФактурыНаОтгрузку.Загрузить(ТаблицаДокументов);
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросПеренестиВДокументЗавершение(ОтветНаВопрос, ДополнительныеПараметры) Экспорт
	
	Если ОтветНаВопрос = КодВозвратаДиалога.Да Тогда
		ПеренестиВДокумент = Истина;
		Закрыть();
		
	ИначеЕсли ОтветНаВопрос = КодВозвратаДиалога.Нет Тогда
		Модифицированность = Ложь;
		ПеренестиВДокумент = Ложь;
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьВозвращаемоеЗначение()
	
	ВозвращаемоеЗначение = Новый Структура();
	
	Если ПеренестиВДокумент Тогда
		ТаблицаСчетаФактурыНаОтгрузку = СчетаФактурыНаОтгрузку.Выгрузить();
		
		АдресТаблицыСчетаФактурыНаОтгрузку = ПоместитьВоВременноеХранилище(ТаблицаСчетаФактурыНаОтгрузку, УникальныйИдентификатор);
		
		ВозвращаемоеЗначение.Вставить("АдресТаблицыСчетаФактурыНаОтгрузку", АдресТаблицыСчетаФактурыНаОтгрузку);
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПрочитатьСведенияСФ(СчетФактура)
	
	СведенияСФ = Новый Структура("
		|Номер,
		|Дата");
	
	Если Не ЗначениеЗаполнено(СчетФактура) Тогда
		Возврат СведенияСФ;
	КонецЕсли;
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СчетФактура, "Дата,Номер");
	
	СведенияСФ.Дата = ЗначенияРеквизитов.Дата;
	СведенияСФ.Номер = РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
		СчетФактура, ЗначенияРеквизитов.Номер);
	
	Возврат СведенияСФ;
	
КонецФункции

&НаКлиенте
Процедура ПоказатьЗначенияСпискаОтбора(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ИмяЭлемента = Элемент.Имя;
	
	СписокОтбора = ЭтотОбъект[ИмяЭлемента];
	
	КоличествоЭлементовСпискаОтбора = СписокОтбора.Количество();
	
	Если КоличествоЭлементовСпискаОтбора = 0 Тогда
		Возврат;
		
	ИначеЕсли КоличествоЭлементовСпискаОтбора = 1 Тогда
		ВыбранноеЗначение = СписокОтбора.Получить(0);
		
		ПоказатьЗначение(, ВыбранноеЗначение.Значение);
		
	Иначе
		Оповещение = Новый ОписаниеОповещения("ВыбранЭлементСпискаОтбора", ЭтотОбъект);
		
		ПоказатьВыборИзСписка(Оповещение, СписокОтбора, Элементы[ИмяЭлемента]);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбранЭлементСпискаОтбора(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьЗначение(, ВыбранноеЗначение.Значение);
	
КонецПроцедуры

#КонецОбласти
