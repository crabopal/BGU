//---
// Параметры формы
//---
//
//	<обязательные>
//		СвязиПараметровВыбора	- Структура	- Набор значений, используемых для установки параметров выбора
//											различных элементов этой формы;
//		ЗначенияЗаполнения		- Структура	- Набор значений, присваиваемых реквизитам этой формы;
//		КоличествоСтрок			- Число		- Чисол строк, выводимое для справки в шапке формы;
//
//	<опциональные>
//		НеиспользуемыеПоля			- Строка или массив	- Имена скрываемых реквизитов;
//		СписокВыбораВидДокумента	- Список значений	- Список выбора для поля Вид документа;
//		СубконтоДляМОЛ				- ПланыВидовХарактеристик.ВидыСубконто	- Определяет, какое из полей
//														(ЦМО или Контрагент) будут использованы
//														для указания МОЛ.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры["СвязиПараметровВыбора"]);
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры["ЗначенияЗаполнения"]);
	
	ОпределитьИменаПолей();
	
	НастроитьФормуПриСтарте();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СтатусОбъектаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОткрытьФорму("Справочник.СтатусыОбъектовДляИнвентаризации.ФормаВыбора",,Элемент,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ЦелеваяФункцияАктиваНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОткрытьФорму("Справочник.ЦелевыеФункцииАктивовДляИнвентаризации.ФормаВыбора",,Элемент,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ИмяТаблицыФормы
//Код процедур и функций
#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗакрытьФорму(Команда)
	
	ВозвращаемоеЗначение = ПолучитьВозвращаемоеЗначение();
	
	Этаформа.Закрыть(ВозвращаемоеЗначение);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПолучитьИменаВсехПолей()
	
	//
	// Особенность использования полей ЦМО, Контрагент
	// -----------------------------------------------
	// Эти поля используются для указания МОЛ, в зависимости от необходимого типа значения.
	// Используется лишь одно из полей - либо ЦМО, либо Контрагент.
	//
	// Для указания используемого поля используется параметр СубконтоДляМОЛ:
	//   - ПланыВидовХарактеристик.ВидыСубконто.ЦМО
	//   - ПланыВидовХарактеристик.ВидыСубконто.Контрагенты	
	//
	// -------
	//  Важно
	// -------
	//	поле для МОЛ при вызове из внешней формы, а также в возвращаемом значении, именуется как ЦМО.
	//
	
	Возврат Новый Структура("
		|ЦМО,
		|ИФО,
		|Подразделение,
		|ВидДокумента,
		|КФО,
		|КПС,
		|Счет,
		|КЭК");
	
КонецФункции


&НаСервере
Процедура НастроитьФормуПриСтарте()
	
	Перем	СписокВыбораВидДокумента,
			СчетГруппа,
			Сотрудник;
	
	// Скрываем неиспользуемые поля
	Для Каждого Элемент Из НеиспользуемыеПоля Цикл
		ИмяЭлементаФормы = Элемент.Ключ;
		
		Элементы[ИмяЭлементаФормы].Видимость = Ложь;
		
		Элементы["Флажок" + ИмяЭлементаФормы].Видимость = Ложь;
	КонецЦикла;
	
	Если Параметры.Свойство("СписокВыбораВидДокумента", СписокВыбораВидДокумента) Тогда
		
		Для Каждого Элемент Из СписокВыбораВидДокумента Цикл
			Элементы["ВидДокумента"].СписокВыбора.Добавить(Элемент.Значение, Элемент.Представление);
		КонецЦикла;
		
	КонецЕсли;
	
	Если Параметры["СвязиПараметровВыбора"].Свойство("СчетГруппа", СчетГруппа) Тогда
		
		ВремМассив = Новый Массив();
		
		НовыйПараметр = Новый ПараметрВыбора("ОграниченияСчета", СчетГруппа);
		ВремМассив.Добавить(НовыйПараметр);
		
		Элементы["Счет"].ПараметрыВыбора = Новый ФиксированныйМассив(ВремМассив);
		
	КонецЕсли;
	
	Если Параметры["СвязиПараметровВыбора"].Свойство("Сотрудник", Сотрудник) Тогда
		
		ВремМассив = Новый Массив();
		
		Если ТипЗнч(Сотрудник) = Тип("СправочникСсылка.Сотрудники") Тогда
			НовыйПараметр = Новый ПараметрВыбора("Отбор.Сотрудник", Сотрудник);
			ВремМассив.Добавить(НовыйПараметр);
			
		ИначеЕсли ТипЗнч(Сотрудник) = Тип("СправочникСсылка.ЦМО") Тогда
			НовыйПараметр = Новый ПараметрВыбора("Отбор.Ссылка", Сотрудник);
			ВремМассив.Добавить(НовыйПараметр);
			
			Если ИспользуемыеПоля.Свойство("ЦМО") И ЗначениеЗаполнено(Сотрудник) Тогда
				ЦМО			= Сотрудник;
				ФлажокЦМО	= Истина;
			КонецЕсли;
		КонецЕсли;
		
		НовыйПараметр = Новый ПараметрВыбора("Отбор.Владелец", Организация);
		ВремМассив.Добавить(НовыйПараметр);
		
		Элементы["ЦМО"].ПараметрыВыбора = Новый ФиксированныйМассив(ВремМассив);
		
	КонецЕсли;
	
	// Категории для русского языка:
	//	Ноль	(-);
	//	Один	(1 шт);
	//	Два		(-);
	//	Немного	(2 шт);
	//	Много	(5 шт);
	//	Другое	(-)
	НадписьКоличествоСтрок = СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(
		НСтр("ru=';%1 строку;;%1 строки;%1 строк;'"),
		Параметры.КоличествоСтрок);
	
	Элементы["ЗакрытьФорму"].Заголовок = СтрШаблон(
		НСтр("ru='Заполнить %1'"),
		НадписьКоличествоСтрок);
	
	УстановитьУсловноеОформление();
	
КонецПроцедуры
	
&НаСервере
Процедура УстановитьУсловноеОформление()
	
	Для Каждого Элемент Из ИспользуемыеПоля Цикл
		ИмяПоля = Элемент.Ключ;
		
		ИмяПоляФлажок = "Флажок" + ИмяПоля;
		
		//
		// N. Поле при сброшенном флажке
		//
		НовыйЭлементУО = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
		НовыйЭлементУО.Представление = "Поле " + ИмяПоля + " при сброшенном флажке";
		
		// Условие
		Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоляФлажок);
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Условие.ПравоеЗначение = Ложь;
		
		// Оформление
		НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста",				ЦветаСтиля.НедоступныеДанныеЦвет);
		НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветФона",				Новый Цвет(250, 250, 250));
		НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного",	Ложь);
		
		// Оформляемые поля
		ОформляемоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
		
		//
		// N+1. Поле пустое при установленном флажке
		//
		НовыйЭлементУО = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
		НовыйЭлементУО.Представление = "Поле " + ИмяПоля + " пустое при установленном флажке";
		
		// Условие
		Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоля);
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
		Условие.ПравоеЗначение = Истина;
		
		Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоляФлажок);
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Условие.ПравоеЗначение = Истина;
		
		// Оформление
		НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Истина);
		
		// Оформляемые поля
		ОформляемоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ОпределитьИменаПолей()
	
	Перем ПереданноеЗначение;
	
	ИменаВсехПолей = ПолучитьИменаВсехПолей();
	
	ВремИспользуемыеПоля = ИменаВсехПолей;
	
	ВремНеиспользуемыеПоля = Новый Структура();
	
	Если НЕ ИспользоватьУчетПоИФО Тогда
		ВремИспользуемыеПоля.Удалить("ИФО");
	КонецЕсли;
	
	Если НЕ ИспользоватьУчетПоПодразделениям Тогда
		ВремИспользуемыеПоля.Удалить("Подразделение");
	КонецЕсли;
	
	Если Параметры.Свойство("НеиспользуемыеПоля", ПереданноеЗначение) Тогда
		Если ТипЗнч(ПереданноеЗначение) = Тип("Строка") Тогда
			ПереданноеЗначение = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(ПереданноеЗначение);
		КонецЕсли;
		
		Для Каждого ИмяПоля Из ПереданноеЗначение Цикл
			Если ИменаВсехПолей.Свойство(ИмяПоля) Тогда
				ВремНеиспользуемыеПоля.Вставить(ИмяПоля);
				ВремИспользуемыеПоля.Удалить(ИмяПоля);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если Параметры.Свойство("СубконтоДляМОЛ", ПереданноеЗначение) Тогда
		
		Если ПереданноеЗначение = ПланыВидовХарактеристик.ВидыСубконто.ЦМО Тогда
			ИмяПоляДляМОЛ = "ЦМО";
			
			ВремНеиспользуемыеПоля.Вставить("Контрагент");
			
		ИначеЕсли ПереданноеЗначение = ПланыВидовХарактеристик.ВидыСубконто.Контрагенты Тогда
			ИмяПоляДляМОЛ = "Контрагент";
			
			ВремНеиспользуемыеПоля.Вставить("ЦМО");
		КонецЕсли;
		
	Иначе
		// Если параметр не указали, по-умолчанию используется поле ЦМО
		
		ИмяПоляДляМОЛ = "ЦМО";
		
		ВремНеиспользуемыеПоля.Вставить("Контрагент");
	КонецЕсли;
	
	ИспользуемыеПоля = Новый ФиксированнаяСтруктура(ВремИспользуемыеПоля);
	
	НеиспользуемыеПоля = Новый ФиксированнаяСтруктура(ВремНеиспользуемыеПоля);
	
КонецФункции

&НаКлиенте
Процедура ПолеПриИзменении(Элемент)
	
	ИмяПоляФлажок = "Флажок" + Элемент.Имя;
	
	ЭтаФорма[ИмяПоляФлажок] = Истина;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьВозвращаемоеЗначение()
	
	// Возвращаем лишь значения, которые отмечены флажком
	
	ВозвращаемоеЗначение = Новый Структура();
	
	Для Каждого Элемент Из ИспользуемыеПоля Цикл
		ИмяРеквизита = Элемент.Ключ;
		
		Если ЭтаФорма["Флажок" + ИмяРеквизита] Тогда
			
			Если ИмяРеквизита = "ЦМО" Тогда
				ЗначениеРеквизита = ЭтаФорма[ИмяПоляДляМОЛ];
			Иначе
				ЗначениеРеквизита = ЭтаФорма[ИмяРеквизита];
			КонецЕсли;
			
			ВозвращаемоеЗначение.Вставить(ИмяРеквизита, ЗначениеРеквизита);
		КонецЕсли;
	КонецЦикла;
	
	Если ВозвращаемоеЗначение.Количество() = 0 Тогда
		ВозвращаемоеЗначение = Неопределено;
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

#КонецОбласти

