
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьТаблицуДокументов(Параметры.УчетныеДокументы, Отказ);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЭлектронныеДокументы

&НаКлиенте
Процедура ЭлектронныеДокументыДеревоОтметкаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ЭлектронныеДокументы.ТекущиеДанные;
	
	Если ТекущиеДанные.Формировать = 2 Тогда
		ТекущиеДанные.Формировать = 0;
	КонецЕсли;
	
	Если ТекущиеДанные.ИдентификаторКомандыПечати = "" Тогда
		Для Каждого ПодчиненнаяСтрока Из ТекущиеДанные.ПолучитьЭлементы() Цикл
			ПодчиненнаяСтрока.Формировать = ТекущиеДанные.Формировать;
		КонецЦикла;
	Иначе
		ЗаполнитьОтметкуУРодителя(ТекущиеДанные.ПолучитьРодителя());
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЭлектронныеДокументыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ЭлектронныеДокументы.ТекущиеДанные;
	
	Если Поле.Имя = "ЭлектронныеДокументыПредставлениеДокумента" Тогда
		Если ЗначениеЗаполнено(ТекущиеДанные.ЭлектронныйДокумент) Тогда
			ПоказатьЗначение(,ТекущиеДанные.ЭлектронныйДокумент);
		Иначе
			ПоказатьЗначение(,ТекущиеДанные.УчетныйДокумент);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура УстановитьФлажкиДокументов(Команда)
	
	УстановитьФлажки(1);
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажкиДокументов(Команда)
	
	УстановитьФлажки(0);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьПоВидуЭлектронногоДокумента(Команда)
	
	ВидыЭлектронныхДокументовВТаблице = Новый Соответствие;
	Для Каждого УчетныйДокумент Из ЭлектронныеДокументы.ПолучитьЭлементы() Цикл
		Для Каждого ЭлектронныйДокумент Из УчетныйДокумент.ПолучитьЭлементы() Цикл
			ВидыЭлектронныхДокументовВТаблице.Вставить(
				ЭлектронныйДокумент.ИдентификаторКомандыПечати, ЭлектронныйДокумент.ВидДокумента);
		КонецЦикла;
	КонецЦикла;
	
	СписокВидовЭлектронныхДокументов = Новый СписокЗначений;
	Для Каждого КлючЗначение Из ВидыЭлектронныхДокументовВТаблице Цикл
		СписокВидовЭлектронныхДокументов.Добавить(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	СписокВидовЭлектронныхДокументов.СортироватьПоПредставлению();
	
	Оповещение = Новый ОписаниеОповещения("ПослеОтметкиВидовЭлектронныхДокументов", ЭтотОбъект);
	СписокВидовЭлектронныхДокументов.ПоказатьОтметкуЭлементов(Оповещение, "Виды электронных документов");
	
КонецПроцедуры

&НаКлиенте
Процедура Аннулировать(Команда)
	
	Если НетОтмеченныхСтрок() Тогда
		ТекстСообщения = НСтр("ru = 'Не отмечено ни одной строки с электронным документом'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	Обработчик = Новый ОписаниеОповещения("ПослеВводаКомментарияПриАннулировании", ЭтотОбъект);
	Подсказка = НСтр("ru = 'Укажите причину аннулирования'");
	ПоказатьВводСтроки(Обработчик, , Подсказка, , Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьАннулирование(Команда)
	
	Если НетОтмеченныхСтрок() Тогда
		ТекстСообщения = НСтр("ru = 'Не отмечено ни одной строки с электронным документом'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = НСтр("ru = 'Будет отменено аннулирование документов. Продолжить?'");
	Обработчик = Новый ОписаниеОповещения("ПродолжитьОтменуАннулированияПослеОтвета", ЭтотОбъект);
	ПоказатьВопрос(Обработчик, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПереместитьВНеактуальные(Команда)
	
	Если НетОтмеченныхСтрок() Тогда
		ТекстСообщения = НСтр("ru = 'Не отмечено ни одной строки с электронным документом'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = НСтр("ru = 'Документы будут перемещены в неактуальные. Продолжить?'");
	Обработчик = Новый ОписаниеОповещения("ПродолжитьПеремещениеВНеактуальныеПослеОтвета", ЭтотОбъект);
	ПоказатьВопрос(Обработчик, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьТаблицуДокументов(УчетныеДокументы, Отказ = Ложь)
	
	СтрокиДерева = ЭлектронныеДокументы.ПолучитьЭлементы();
	СтрокиДерева.Очистить();
	
	ДокументыБезАктуальныхВнутреннихДокументов = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВнутреннийЭлектронныйДокумент.Ссылка КАК ЭлектронныйДокумент,
	|	ВнутреннийЭлектронныйДокумент.УчетныйДокумент КАК УчетныйДокумент,
	|	ВнутреннийЭлектронныйДокумент.ВидДокумента КАК ВидДокумента,
	|	ВнутреннийЭлектронныйДокумент.ИдентификаторКомандыПечати КАК ИдентификаторКомандыПечати,
	|	СостоянияЭлектронныхДокументов.Состояние КАК Состояние
	|ИЗ
	|	Документ.ВнутреннийЭлектронныйДокумент КАК ВнутреннийЭлектронныйДокумент
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияЭлектронныхДокументов КАК СостоянияЭлектронныхДокументов
	|		ПО ВнутреннийЭлектронныйДокумент.Ссылка = СостоянияЭлектронныхДокументов.ЭлектронныйДокумент
	|ГДЕ
	|	ВнутреннийЭлектронныйДокумент.УчетныйДокумент В(&УчетныеДокументы)
	|	И СостоянияЭлектронныхДокументов.Актуальный
	|ИТОГИ ПО
	|	УчетныйДокумент";
	
	Запрос.УстановитьПараметр("УчетныеДокументы", УчетныеДокументы);
	
	ВыборкаПоУчетнымДокументам = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоУчетнымДокументам.Следующий() Цикл
		
		СтрокаУчетныйДокумент = СтрокиДерева.Добавить();
		СтрокаУчетныйДокумент.УчетныйДокумент = ВыборкаПоУчетнымДокументам.УчетныйДокумент;
		СтрокаУчетныйДокумент.ПредставлениеДокумента = ВыборкаПоУчетнымДокументам.УчетныйДокумент;
		
		СтрокиУчетногоДокумента = СтрокаУчетныйДокумент.ПолучитьЭлементы();
		
		ВыборкаПоЭлектроннымДокументам = ВыборкаПоУчетнымДокументам.Выбрать();
		
		Пока ВыборкаПоЭлектроннымДокументам.Следующий() Цикл
			
			НоваяСтрока = СтрокиУчетногоДокумента.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаПоЭлектроннымДокументам);
			НоваяСтрока.ПредставлениеДокумента = ВыборкаПоЭлектроннымДокументам.ВидДокумента;
			
		КонецЦикла;
		
		Если СтрокиУчетногоДокумента.Количество() = 0 Тогда
			СтрокиДерева.Удалить(СтрокиДерева.Индекс(СтрокаУчетныйДокумент));
		КонецЕсли;
		
		Если СтрокиУчетногоДокумента.Количество() = 0 Тогда
			ДокументыБезАктуальныхВнутреннихДокументов.Вставить(ВыборкаПоУчетнымДокументам.УчетныйДокумент, Истина);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого КлючЗначение Из ДокументыБезАктуальныхВнутреннихДокументов Цикл
		Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Для объекта ""%1"" нет ни одного актуального внутреннего электронного документа'"),
			КлючЗначение.Ключ);
		ОбщегоНазначения.СообщитьПользователю(Сообщение);
	КонецЦикла;
	
	Если СтрокиДерева.Количество() = 0 Тогда
		Сообщение = НСтр("ru = 'Электронные документы отсутствуют либо уже аннулированы и не актуальны'");
		ОбщегоНазначения.СообщитьПользователю(Сообщение,,,,Отказ);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция НетОтмеченныхСтрок()
	
	Для Каждого УчетныйДокумент Из ЭлектронныеДокументы.ПолучитьЭлементы() Цикл
		Для Каждого ЭлектронныйДокумент Из УчетныйДокумент.ПолучитьЭлементы() Цикл
			Если ЭлектронныйДокумент.Формировать Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура УстановитьФлажки(Значение)
	
	Для Каждого УчетныйДокумент Из ЭлектронныеДокументы.ПолучитьЭлементы() Цикл
		УчетныйДокумент.Формировать = Значение;
		Для Каждого ЭлектронныйДокумент Из УчетныйДокумент.ПолучитьЭлементы() Цикл
			ЭлектронныйДокумент.Формировать = Значение;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьОтметкуУРодителя(Родитель)
	
	ЕстьОтмеченные = Ложь;
	ЕстьНеотмеченные = Ложь;
	
	Для Каждого Строка Из Родитель.ПолучитьЭлементы() Цикл
		Если Строка.Формировать Тогда
			ЕстьОтмеченные = Истина;
		Иначе
			ЕстьНеотмеченные = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если ЕстьОтмеченные И ЕстьНеотмеченные Тогда
		Родитель.Формировать = 2;
	ИначеЕсли ЕстьОтмеченные Тогда
		Родитель.Формировать = 1;
	Иначе
		Родитель.Формировать = 0;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтметкиВидовЭлектронныхДокументов(Список, Параметры) Экспорт
	
	Если Список = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОтмеченныеВидыЭлектронныхДокументов = Новый Соответствие;
	
	Для Каждого Элемент Из Список Цикл
		Если Элемент.Пометка Тогда
			ОтмеченныеВидыЭлектронныхДокументов.Вставить(Элемент.Значение, Истина);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого УчетныйДокумент Из ЭлектронныеДокументы.ПолучитьЭлементы() Цикл
		Для Каждого ЭлектронныйДокумент Из УчетныйДокумент.ПолучитьЭлементы() Цикл
			Если ОтмеченныеВидыЭлектронныхДокументов[ЭлектронныйДокумент.ИдентификаторКомандыПечати] <> Неопределено Тогда
				ЭлектронныйДокумент.Формировать = 1;
			КонецЕсли;
		КонецЦикла;
		ЗаполнитьОтметкуУРодителя(УчетныйДокумент);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаКомментарияПриАннулировании(ВведеннаяСтрока, ДополнительныеПараметры) Экспорт
	
	Если ВведеннаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(ВведеннаяСтрока) Тогда
		ТекстСообщения = НСтр("ru='При аннулировании необходимо указать причину'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,,,);
		Возврат;
	КонецЕсли;
	
	ОтмеченныеДокументы = ОтмеченныеЭлектронныеДокументы();
	
	АннулироватьДокументыНаСервере(ВведеннаяСтрока);
	
	ЗаполнитьОтметкиУДокументов(ОтмеченныеДокументы);
	
	РазвернутьДеревоДокументов();
	
	ТекстСообщения = НСтр("ru = 'Электронные документы аннулированы'");
	ПоказатьОповещениеПользователя(, , ТекстСообщения, БиблиотекаКартинок.Успешно32);
	
	Оповестить(ВнутреннийЭДОКлиент.ИмяСобытияОбновленияСостоянияВнутреннегоЭД());
	
КонецПроцедуры

&НаСервере
Процедура АннулироватьДокументыНаСервере(Комментарий)
	
	УчетныеДокументы = Новый Соответствие;
	МассивУчетныхДокументов = Новый Массив;
	
	Ответственный = Пользователи.ТекущийПользователь();
	
	Для Каждого УчетныйДокумент Из ЭлектронныеДокументы.ПолучитьЭлементы() Цикл
		МассивУчетныхДокументов.Добавить(УчетныйДокумент.УчетныйДокумент);
		Для Каждого ЭлектронныйДокумент Из УчетныйДокумент.ПолучитьЭлементы() Цикл
			Если ЭлектронныйДокумент.Формировать Тогда
				
				ПараметрыДействия = Новый Структура;
				ПараметрыДействия.Вставить("УчетныйДокумент", ЭлектронныйДокумент.УчетныйДокумент);
				ПараметрыДействия.Вставить("ЭлектронныйДокумент", ЭлектронныйДокумент.ЭлектронныйДокумент);
				ПараметрыДействия.Вставить("ВидПодписи", "");
				ПараметрыДействия.Вставить("Комментарий", Комментарий);
				ПараметрыДействия.Вставить("Ответственный", Ответственный);
				
				Если УчетныеДокументы[УчетныйДокумент.УчетныйДокумент] = Неопределено Тогда
					УчетныеДокументы.Вставить(УчетныйДокумент.УчетныйДокумент, Новый Массив);
				КонецЕсли;
				
				УчетныеДокументы[УчетныйДокумент.УчетныйДокумент].Добавить(ПараметрыДействия);
				
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ВнутреннийЭДО.АннулироватьЭлектронныеДокументы(УчетныеДокументы);
	
	ЗаполнитьТаблицуДокументов(МассивУчетныхДокументов);
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьОтменуАннулированияПослеОтвета(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ОтмеченныеДокументы = ОтмеченныеЭлектронныеДокументы();
	
	ОтменитьАннулированиеНаСервере();
	
	ЗаполнитьОтметкиУДокументов(ОтмеченныеДокументы);
	
	РазвернутьДеревоДокументов();
	
	ТекстСообщения = НСтр("ru = 'Отменено аннулирование электронных документов'");
	ПоказатьОповещениеПользователя(, , ТекстСообщения, БиблиотекаКартинок.Успешно32);
	
	Оповестить(ВнутреннийЭДОКлиент.ИмяСобытияОбновленияСостоянияВнутреннегоЭД());
	
КонецПроцедуры

&НаСервере
Процедура ОтменитьАннулированиеНаСервере()
	
	УчетныеДокументы = Новый Соответствие;
	МассивУчетныхДокументов = Новый Массив;
	
	Для Каждого УчетныйДокумент Из ЭлектронныеДокументы.ПолучитьЭлементы() Цикл
		МассивУчетныхДокументов.Добавить(УчетныйДокумент.УчетныйДокумент);
		Для Каждого ЭлектронныйДокумент Из УчетныйДокумент.ПолучитьЭлементы() Цикл
			Если ЭлектронныйДокумент.Формировать Тогда
				
				ПараметрыДействия = Новый Структура;
				ПараметрыДействия.Вставить("УчетныйДокумент", ЭлектронныйДокумент.УчетныйДокумент);
				ПараметрыДействия.Вставить("ЭлектронныйДокумент", ЭлектронныйДокумент.ЭлектронныйДокумент);
				
				Если УчетныеДокументы[УчетныйДокумент.УчетныйДокумент] = Неопределено Тогда
					УчетныеДокументы.Вставить(УчетныйДокумент.УчетныйДокумент, Новый Массив);
				КонецЕсли;
				
				УчетныеДокументы[УчетныйДокумент.УчетныйДокумент].Добавить(ПараметрыДействия);
				
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ВнутреннийЭДО.ОтменитьАннулированиеЭлектронныхДокументов(УчетныеДокументы);
	
	ЗаполнитьТаблицуДокументов(МассивУчетныхДокументов);
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьПеремещениеВНеактуальныеПослеОтвета(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ПереместитьВНеактуальныеНаСервере();
	
	РазвернутьДеревоДокументов();
	
	ТекстСообщения = НСтр("ru = 'Электронные документы перемещены в неактуальные'");
	ПоказатьОповещениеПользователя(, , ТекстСообщения, БиблиотекаКартинок.Успешно32);
	
	Оповестить(ВнутреннийЭДОКлиент.ИмяСобытияОбновленияСостоянияВнутреннегоЭД());
	
КонецПроцедуры

&НаСервере
Процедура ПереместитьВНеактуальныеНаСервере()
	
	УчетныеДокументы = Новый Соответствие;
	МассивУчетныхДокументов = Новый Массив;
	
	Для Каждого УчетныйДокумент Из ЭлектронныеДокументы.ПолучитьЭлементы() Цикл
		МассивУчетныхДокументов.Добавить(УчетныйДокумент.УчетныйДокумент);
		Для Каждого ЭлектронныйДокумент Из УчетныйДокумент.ПолучитьЭлементы() Цикл
			Если ЭлектронныйДокумент.Формировать Тогда
				
				ПараметрыДействия = Новый Структура;
				ПараметрыДействия.Вставить("УчетныйДокумент", ЭлектронныйДокумент.УчетныйДокумент);
				ПараметрыДействия.Вставить("ЭлектронныйДокумент", ЭлектронныйДокумент.ЭлектронныйДокумент);
				
				Если УчетныеДокументы[УчетныйДокумент.УчетныйДокумент] = Неопределено Тогда
					УчетныеДокументы.Вставить(УчетныйДокумент.УчетныйДокумент, Новый Массив);
				КонецЕсли;
				
				УчетныеДокументы[УчетныйДокумент.УчетныйДокумент].Добавить(ПараметрыДействия);
				
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ВнутреннийЭДО.ПереместитьЭлектронныеДокументыВНеактуальные(УчетныеДокументы);
	
	ЗаполнитьТаблицуДокументов(МассивУчетныхДокументов);
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьДеревоДокументов()
	
	Для Каждого ЭлементДерева Из ЭлектронныеДокументы.ПолучитьЭлементы() Цикл
		Элементы.ЭлектронныеДокументы.Развернуть(ЭлементДерева.ПолучитьИдентификатор(), Истина);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ОтмеченныеЭлектронныеДокументы()
	
	ОтмеченныеДокументы = Новый Соответствие;
	
	Для Каждого УчетныйДокумент Из ЭлектронныеДокументы.ПолучитьЭлементы() Цикл
		Для Каждого ЭлектронныйДокумент Из УчетныйДокумент.ПолучитьЭлементы() Цикл
			Если ЭлектронныйДокумент.Формировать Тогда
				ОтмеченныеДокументы.Вставить(ЭлектронныйДокумент.ЭлектронныйДокумент, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ОтмеченныеДокументы;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьОтметкиУДокументов(ОтмеченныеДокументы)
	
	Для Каждого УчетныйДокумент Из ЭлектронныеДокументы.ПолучитьЭлементы() Цикл
		Для Каждого ЭлектронныйДокумент Из УчетныйДокумент.ПолучитьЭлементы() Цикл
			Если ОтмеченныеДокументы[ЭлектронныйДокумент.ЭлектронныйДокумент] <> Неопределено Тогда
				ЭлектронныйДокумент.Формировать = 1;
				ЗаполнитьОтметкуУРодителя(УчетныйДокумент);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
