#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТекущаяОрганизация = ОбщегоНазначенияБГУ.ТекущаяОрганизация();
	
	ЗаполнитьИнформациюПоЭДО();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ИзменениеОсновнойОрганизации" Тогда
		ТекущаяОрганизация = Параметр;
		ЗаполнитьИнформациюПоЭДО();
	ИначеЕсли ИмяСобытия = ВнутреннийЭДОКлиент.ИмяСобытияОбновленияСостоянияВнутреннегоЭД() Тогда
		ЗаполнитьИнформациюПоЭДО();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИнформацияПоТекущимДеламЭДОНажатие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Если НЕ ПоказыватьТолькоВнутренниеЭД Тогда
		ИнтерфейсДокументовЭДОКлиент.ОткрытьТекущиеДелаЭДО();
	Иначе
		ОткрытьФорму("Обработка.ВнутренниеЭлектронныеДокументыБЭДБГУ.Форма.ДокументыНаПодпись");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ИнформацияПоВнутреннемуЭДОНажатие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ОткрытьФорму("Обработка.ВнутренниеЭлектронныеДокументыБЭДБГУ.Форма.ДокументыНаПодпись");
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьТекущиеДелаЭДО(Команда)
	
	ИнтерфейсДокументовЭДОКлиент.ОткрытьТекущиеДелаЭДО();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьФорму(Команда)
	ЗаполнитьИнформациюПоЭДО();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ЗаполнитьИнформациюПоЭДО()
	
	УстановитьПривилегированныйРежим(Истина);
	ШаблонДокумента = НСтр("ru = '%1/%2'");
	
	ПоказатьВнешнийЭДО = РольДоступна(Метаданные.Роли.ЧтениеЭлектронныхДокументов) 
		ИЛИ РольДоступна(Метаданные.Роли.ДобавлениеИзменениеЭлектронныхДокументов)
		ИЛИ РольДоступна(Метаданные.Роли.ПолныеПрава);
		
	Если ПоказатьВнешнийЭДО Тогда	
		ДанныеЭДО = ДанныеЭДО();
		
		КоличествоЭДПодписать = ДанныеЭДО.Подписать;
		КоличествоЭДУтвердить = ДанныеЭДО.Утвердить;
		
		ИнформацияПоТекущимДеламЭДО = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонДокумента, КоличествоЭДУтвердить, КоличествоЭДПодписать);
	КонецЕсли;
	
	ПоказатьВнутреннийЭДО = Константы.ИспользоватьВнутренниеДокументыЭДО.Получить();
	
	Если ПоказатьВнутреннийЭДО Тогда
		
		ПоказыватьТолькоВнутренниеЭД = РольДоступна(Метаданные.Роли.ЧтениеВнутреннихЭлектронныхДокументовБЭДДляБГУ);
		
		ДанныеВнутреннегоЭДО = ДанныеВнутреннегоЭДО();
		
		КоличествоЭДПодписать = ДанныеВнутреннегоЭДО.Подписать;
		
		Если ПоказыватьТолькоВнутренниеЭД Тогда
			ШаблонДокумента = НСтр("ru = '%1 внутр. ЭД'");
			Элементы.ЭДО.Заголовок = НСтр("ru = 'Подписать:'");
		Иначе
			ШаблонДокумента = НСтр("ru = ' + %1 внутр. ЭД'");
			Элементы.ЭДО.Заголовок = НСтр("ru = 'Утвердить/подписать:'");
		КонецЕсли;
		
		ИнформацияПоВнутреннемуЭДО = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонДокумента, КоличествоЭДПодписать);
		
		Если (КоличествоЭДПодписать = 0) И НЕ ПоказыватьТолькоВнутренниеЭД Тогда
			ПоказатьВнутреннийЭДО = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭтаФорма.Элементы,
		"ОткрытьТекущиеДелаЭДО", "Видимость", ПоказатьВнешнийЭДО);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭтаФорма.Элементы,
		"ИнформацияПоТекущимДеламЭДО", "Видимость", ПоказатьВнешнийЭДО);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭтаФорма.Элементы,
		"ИнформацияПоВнутреннемуЭДО", "Видимость", ПоказатьВнутреннийЭДО);

КонецФункции

&НаСервере
Функция ДанныеЭДО()
	
	Результат = Новый Структура;
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТекПользователь = Пользователи.ТекущийПользователь();
	ДатаПереходаНаВерсиюСПрочтенностью = РаботаСПрочтениямиВызовСервера.ПолучитьДатуПереходаНаВерсиюСПрочтенностью();
	
	УтвердитьКоличество = 0;
	ПодписатьКоличество = 0;
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЭлектронныеДокументы.Ссылка КАК ЭлектронныйДокумент,
	|	ЭлектронныеДокументы.ДатаДокумента КАК Дата,
	|	ЭлектронныеДокументы.НомерДокумента КАК Номер,
	|	ЭлектронныеДокументы.Организация КАК Организация,
	|	ЭлектронныеДокументы.Контрагент КАК Контрагент,
	|	ЭлектронныеДокументы.ДоговорКонтрагента КАК ДоговорКонтрагента,
	|	ЭлектронныеДокументы.СуммаДокумента КАК СуммаДокумента,
	|	ЭлектронныеДокументы.Ответственный КАК Ответственный,
	|	СостоянияЭДО.Состояние КАК СостояниеЭДО,
	|	ВЫРАЗИТЬ(СостоянияЭДО.Комментарий КАК СТРОКА(100)) КАК ДополнительнаяИнформация,
	|	ЭлектронныеДокументы.ВидДокумента КАК ВидДокумента,
	|	ЭлектронныеДокументы.ВидДокумента.ТипДокумента КАК ТипДокумента,
	|	""КартинкаМК"" КАК КартинкаМК,
	|	ВЫРАЗИТЬ(ЭлектронныеДокументы.Комментарий КАК СТРОКА(255)) КАК Описание,
	|	ВЫБОР
	|		КОГДА КонтрольОтраженияПереопределяемый.ЭлектронныйДокумент ЕСТЬ NULL
	|			ТОГДА 3
	|		КОГДА КонтрольОтраженияПереопределяемый.СоздатьУчетныйДокумент
	|				И КонтрольОтраженияПереопределяемый.СопоставитьНоменклатуру
	|			ТОГДА 0
	|		КОГДА КонтрольОтраженияПереопределяемый.СоздатьУчетныйДокумент
	|			ТОГДА 1
	|		КОГДА КонтрольОтраженияПереопределяемый.ПровестиУчетныйДокумент
	|			ТОГДА 2
	|		ИНАЧЕ 3
	|	КОНЕЦ КАК КонтрольОтраженияВУчете,
	|	ВЫРАЗИТЬ("""" КАК СТРОКА(300)) КАК ОтражениеВУчете,
	|	СоставПакетовДокументовЭДО.ИдентификаторПакета КАК ИдентификаторПакета,
	|	ВЫРАЗИТЬ("""" КАК СТРОКА(20)) КАК ПредставлениеДокументовВнеОтбора,
	|	ЛОЖЬ КАК ПервыйДокументПакета,
	|	ДанныеКоличестваДокументовВПакете.КоличествоДокументов КАК КоличествоДокументовВПакете,
	|	ВЫБОР
	|		КОГДА ПакетыДокументовЭДО.Дата ЕСТЬ NULL
	|			ТОГДА ЭлектронныеДокументы.ДатаДокумента
	|		ИНАЧЕ ПакетыДокументовЭДО.Дата
	|	КОНЕЦ КАК ДатаПакета,
	|	ЭлектронныеДокументы.Номер КАК НомерСлужебный,
	|	-1 КАК ИндексКартинкиПакета,
	|	ПакетыДокументовЭДО.КлючСортировки КАК КлючСортировкиПакета,
	|	ЭлектронныеДокументы.ВидДокумента.ПорядокСортировкиВПакете КАК ПорядокСортировкиВПакете,
	|	ЛОЖЬ КАК Четность,
	|	ВЫРАЗИТЬ("""" КАК СТРОКА(36)) КАК КлючДокумента,
	|	ВЫРАЗИТЬ("""" КАК СТРОКА(36)) КАК КлючПакета,
	|	ВЫБОР
	|		КОГДА ЭлектронныеДокументы.Дата < &ДатаПереходаНаВерсиюСПрочтенностью
	|			ТОГДА ИСТИНА
	|		КОГДА СведенияОПрочтении.Прочтен ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ СведенияОПрочтении.Прочтен
	|	КОНЕЦ КАК Прочтен
	|ПОМЕСТИТЬ ОбщиеДанные
	|{ВЫБРАТЬ
	|	КонтрольОтраженияВУчете}
	|ИЗ
	|	Документ.ЭлектронныйДокументВходящийЭДО КАК ЭлектронныеДокументы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияДокументовЭДО КАК СостоянияЭДО
	|		ПО (СостоянияЭДО.ЭлектронныйДокумент = ЭлектронныеДокументы.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоставПакетовДокументовЭДО КАК СоставПакетовДокументовЭДО
	|			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|				СоставПакетовДокументовЭДО.ИдентификаторПакета КАК ИдентификаторПакета,
	|				КОЛИЧЕСТВО(СоставПакетовДокументовЭДО.ЭлектронныйДокумент) КАК КоличествоДокументов
	|			ИЗ
	|				РегистрСведений.СоставПакетовДокументовЭДО КАК СоставПакетовДокументовЭДО
	|			
	|			СГРУППИРОВАТЬ ПО
	|				СоставПакетовДокументовЭДО.ИдентификаторПакета) КАК ДанныеКоличестваДокументовВПакете
	|			ПО СоставПакетовДокументовЭДО.ИдентификаторПакета = ДанныеКоличестваДокументовВПакете.ИдентификаторПакета
	|		ПО (СоставПакетовДокументовЭДО.ЭлектронныйДокумент = ЭлектронныеДокументы.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПакетыДокументовЭДО КАК ПакетыДокументовЭДО
	|		ПО (СоставПакетовДокументовЭДО.ИдентификаторПакета = ПакетыДокументовЭДО.ИдентификаторПакета)
	|		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КонтрольОтраженияВУчетеЭДО КАК КонтрольОтраженияПереопределяемый
	|		ПО ЭлектронныеДокументы.Ссылка = КонтрольОтраженияПереопределяемый.ЭлектронныйДокумент}
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СведенияОПрочтенииДокументовЭДО КАК СведенияОПрочтении
	|		ПО ЭлектронныеДокументы.Ссылка = СведенияОПрочтении.Объект
	|			И (СведенияОПрочтении.Пользователь = &Ответственный)
	|ГДЕ
	|	НЕ ЭлектронныеДокументы.ПометкаУдаления
	|{ГДЕ
	|	СостоянияЭДО.Состояние КАК СостояниеЭДО,
	|	(1 В
	|			(ВЫБРАТЬ ПЕРВЫЕ 1
	|				1
	|			ИЗ
	|				РегистрСведений.ОбъектыУчетаДокументовЭДО КАК ОбъектыУчетаДокументооборотаЭДО
	|			ГДЕ
	|				ОбъектыУчетаДокументооборотаЭДО.ЭлектронныйДокумент = ЭлектронныеДокументы.Ссылка)) КАК ЕстьОснование,
	|	(1 В
	|			(ВЫБРАТЬ ПЕРВЫЕ 1
	|				1
	|			ИЗ
	|				РегистрСведений.КонтрольОтраженияВУчетеЭДО КАК КонтрольПереопределяемый
	|			ГДЕ
	|				ЭлектронныеДокументы.Ссылка = КонтрольПереопределяемый.ЭлектронныйДокумент)) КАК ЕстьКонтрольОтражения}
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Подписать
	|ИЗ
	|	ОбщиеДанные КАК ОбщиеДанные
	|ГДЕ
	|	ОбщиеДанные.Организация = &Организация
	|	И ОбщиеДанные.Ответственный = &Ответственный
	|	И ОбщиеДанные.СостояниеЭДО = ЗНАЧЕНИЕ(Перечисление.СостоянияДокументовЭДО.ТребуетсяПодписание)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Утвердить
	|ИЗ
	|	ОбщиеДанные КАК ОбщиеДанные
	|ГДЕ
	|	ОбщиеДанные.Организация = &Организация
	|	И ОбщиеДанные.Ответственный = &Ответственный
	|	И ОбщиеДанные.СостояниеЭДО = ЗНАЧЕНИЕ(Перечисление.СостоянияДокументовЭДО.ТребуетсяУтверждение)";

	Запрос.УстановитьПараметр("Организация", ТекущаяОрганизация);
	Запрос.УстановитьПараметр("Ответственный", ТекПользователь);
	Запрос.УстановитьПараметр("ДатаПереходаНаВерсиюСПрочтенностью", ДатаПереходаНаВерсиюСПрочтенностью);
	
	РезультатВыборки = Запрос.ВыполнитьПакет();
	ДанныеПодписать = РезультатВыборки[1].Выгрузить();
	ДанныеУтвердить = РезультатВыборки[2].Выгрузить();
	Если ДанныеУтвердить.Количество() = 1 Тогда
		УтвердитьКоличество = ДанныеУтвердить[0].Утвердить;
	КонецЕсли;	
	Если ДанныеПодписать.Количество() = 1 Тогда
		ПодписатьКоличество = ДанныеПодписать[0].Подписать;
	КонецЕсли;	
	
	Результат.Вставить("Утвердить", УтвердитьКоличество);
	Результат.Вставить("Подписать", ПодписатьКоличество);
	
	Возврат Результат;
КонецФункции

&НаСервере
Функция ДанныеВнутреннегоЭДО()
	
	Результат = Новый Структура;
	ПодписатьКоличество = 0;
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТекПользователь = Пользователи.ТекущийПользователь();
	Состояние = Перечисления.СостоянияДокументовЭДО.ТребуетсяПодписание;
	Подписанты = Новый Массив;
	Подписанты.Добавить(ТекПользователь);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЭлектронныйДокументИсходящийЭДО.Ссылка КАК ДокументСсылка,
	|	СостоянияЭДО.Состояние КАК СостояниеЭДО,
	|	ЭлектронныйДокументИсходящийЭДО.Номер КАК Номер,
	|	ЭлектронныйДокументИсходящийЭДО.Дата КАК Дата
	|ИЗ
	|	Документ.ЭлектронныйДокументИсходящийЭДО КАК ЭлектронныйДокументИсходящийЭДО
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияДокументовЭДО КАК СостоянияЭДО
	|		ПО (СостоянияЭДО.ЭлектронныйДокумент = ЭлектронныйДокументИсходящийЭДО.Ссылка)
	|ГДЕ
	|	ЭлектронныйДокументИсходящийЭДО.СписокПодписантов.Подписант В(&Подписанты)
	|	И ЭлектронныйДокументИсходящийЭДО.ВидДокумента.ТипДокумента = ЗНАЧЕНИЕ(Перечисление.ТипыДокументовЭДО.Внутренний)
	|	И СостоянияЭДО.Состояние = &Состояние";
	Запрос.УстановитьПараметр("Подписанты", Подписанты);
	Запрос.УстановитьПараметр("Состояние", Состояние);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЭлектронныйДокумент = Выборка.ДокументСсылка;
		СведенияЭД = ЭлектронныеДокументыБГУ.СведенияОбЭлектронномДокументе(ЭлектронныйДокумент);
		НайденныеСтроки = СведенияЭД.Подписи.Найти(ТекПользователь, "Подписант");
		Если НайденныеСтроки = Неопределено Тогда
			ПодписатьКоличество = ПодписатьКоличество + 1;
		КонецЕсли;	
	КонецЦикла;
	
	СостояниеЗавершен = Перечисления.СостоянияДокументовЭДО.ОбменЗавершен;
	СостояниеАннулирован = Перечисления.СостоянияДокументовЭДО.Аннулирован;
	СостояниеЗакрыт = Перечисления.СостоянияДокументовЭДО.ЗакрытПринудительно;
	Состояния = Новый Массив;
	Состояния.Добавить(СостояниеЗавершен);
	Состояния.Добавить(СостояниеАннулирован);
	Состояния.Добавить(СостояниеЗакрыт);
	
	МаршрутыПользователя = Новый Массив;
	ЗапросМаршрутовПользователя = Новый Запрос;
	ЗапросМаршрутовПользователя.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	                                    |	МаршрутыПодписанияТаблицаТребований.Ссылка КАК Ссылка
	                                    |ИЗ
	                                    |	Справочник.МаршрутыПодписания.ТаблицаТребований КАК МаршрутыПодписанияТаблицаТребований
	                                    |ГДЕ
	                                    |	МаршрутыПодписанияТаблицаТребований.Подписант = &Подписант";
	ЗапросМаршрутовПользователя.УстановитьПараметр("Подписант", ТекПользователь);
	Выборка = ЗапросМаршрутовПользователя.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МаршрутыПользователя.Добавить(Выборка.Ссылка);
	КонецЦикла;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЭлектронныйДокументИсходящийЭДО.Ссылка КАК ДокументСсылка,
	|	СостоянияЭДО.Состояние КАК СостояниеЭДО,
	|	ЭлектронныйДокументИсходящийЭДО.Номер КАК Номер,
	|	ЭлектронныйДокументИсходящийЭДО.Дата КАК Дата,
	|	ЭлектронныйДокументИсходящийЭДО.МаршрутПодписания КАК МаршрутПодписания
	|ИЗ
	|	Документ.ЭлектронныйДокументИсходящийЭДО КАК ЭлектронныйДокументИсходящийЭДО
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияДокументовЭДО КАК СостоянияЭДО
	|		ПО (СостоянияЭДО.ЭлектронныйДокумент = ЭлектронныйДокументИсходящийЭДО.Ссылка)
	|ГДЕ
	|	ЭлектронныйДокументИсходящийЭДО.ВидДокумента.ТипДокумента = ЗНАЧЕНИЕ(Перечисление.ТипыДокументовЭДО.Внутренний)
	|	И НЕ СостоянияЭДО.Состояние В (&Состояния)
	|	И ЭлектронныйДокументИсходящийЭДО.МаршрутПодписания В (&МаршрутыПользователя)";
	Запрос.УстановитьПараметр("Подписанты", Подписанты);
	Запрос.УстановитьПараметр("Состояния", Состояния);
	Запрос.УстановитьПараметр("МаршрутыПользователя", МаршрутыПользователя);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЭлектронныйДокумент = Выборка.ДокументСсылка;
		СведенияЭД = ЭлектронныеДокументыБГУ.СведенияОбЭлектронномДокументе(ЭлектронныйДокумент);
		НайденныеСтроки = СведенияЭД.Подписи.Найти(ТекПользователь, "Подписант");
		Если НайденныеСтроки = Неопределено Тогда
			
			ОдинаковыйПорядокПодписания = Истина;
			ПредыдущийПорядокПодписания = 1;
			ПорядокПодписанияДляГруппы = 0;
			НомерПорядкаТекПодписанта = 0;
			МаршрутПодписания = Выборка.МаршрутПодписания;
			
			ПодписантыРаннегоПорядка = ВнутренниеЭлектронныеДокументыБГУ.ПустаяТаблицаПодписантыРаннегоПорядка();
			Для Каждого ТекСтрока Из МаршрутПодписания.ТаблицаТребований Цикл
				Если ПорядокПодписанияДляГруппы > ТекСтрока.Порядок Тогда
					Порядок = ПорядокПодписанияДляГруппы;
				Иначе	
					Порядок = ТекСтрока.Порядок;
				КонецЕсли;	
				
				Если ПредыдущийПорядокПодписания <> Порядок Тогда
					ОдинаковыйПорядокПодписания = Ложь;
				КонецЕсли;	
				
				Если ЗначениеЗаполнено(ТекСтрока.Подписант) Тогда
					
					Если ТекСтрока.Подписант = ТекПользователь Тогда
						НомерПорядкаТекПодписанта = Порядок;
						ВнутренниеЭлектронныеДокументыБГУ.ДобавитьВТаблицуПодписантыРаннегоПорядка(ПодписантыРаннегоПорядка, ТекСтрока.Подписант, Порядок, Истина);
					Иначе
						Если (НомерПорядкаТекПодписанта = 0) ИЛИ (Порядок < НомерПорядкаТекПодписанта) Тогда
							ВнутренниеЭлектронныеДокументыБГУ.ДобавитьВТаблицуПодписантыРаннегоПорядка(ПодписантыРаннегоПорядка, ТекСтрока.Подписант, Порядок);
						ИначеЕсли (Порядок = НомерПорядкаТекПодписанта) Тогда
							ВнутренниеЭлектронныеДокументыБГУ.ДобавитьВТаблицуПодписантыРаннегоПорядка(ПодписантыРаннегоПорядка, ТекСтрока.Подписант, НомерПорядкаТекПодписанта);
						КонецЕсли;
					КонецЕсли;
				Иначе
					ПорядокПодписанияДляГруппы = Порядок;
				КонецЕсли;	
			КонецЦикла;	
			
			Если ОдинаковыйПорядокПодписания Тогда
				ПодписатьКоличество = ПодписатьКоличество + 1;
			ИначеЕсли ЗначениеЗаполнено(ПодписантыРаннегоПорядка) Тогда
				РанееВсеПодписали = Истина;
				Для Каждого ТекСтрока Из ПодписантыРаннегоПорядка Цикл
					ПользователиПорядка = ВнутренниеЭлектронныеДокументыБГУ.ПользователиПорядка(ТекСтрока);
					
					ЕстьПодпись = Ложь;
					Для Каждого ТекЭлемент Из ПользователиПорядка Цикл
						НайденныеСтроки = СведенияЭД.Подписи.Найти(ТекЭлемент, "Подписант");
						Если НЕ НайденныеСтроки = Неопределено Тогда
							ЕстьПодпись = Истина;
						КонецЕсли;	
					КонецЦикла;	
					ТекСтрока.ЕстьПодпись = ЕстьПодпись;
					
				КонецЦикла;
				РанееВсеПодписали = Истина;
				Для Каждого ТекСтрока Из ПодписантыРаннегоПорядка Цикл
					Если ТекСтрока.КонкурентаяПодпись Тогда
						Если РанееВсеПодписали И ТекСтрока.ЕстьПодпись = Ложь Тогда
							ПодписатьКоличество = ПодписатьКоличество + 1;
						КонецЕсли;	
					Иначе
						Если НЕ ТекСтрока.ЕстьПодпись Тогда
							РанееВсеПодписали = Ложь;
						КонецЕсли;	
					КонецЕсли;	
				КонецЦикла;
			Иначе
				ПодписатьКоличество = ПодписатьКоличество + 1;
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;
	
	// Внутренние электронные документы БГУ
	СостояниеТребуетсяПодписание = Перечисления.СостоянияДокументовВнутреннегоЭДО.ТребуетсяПодписание;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(СостоянияЭлектронныхДокументов.ЭлектронныйДокумент) КАК КоличествоДокументовНаПодпись
	|ИЗ
	|	РегистрСведений.СостоянияЭлектронныхДокументов КАК СостоянияЭлектронныхДокументов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоставМаршрутаЭлектронногоДокумента КАК СоставМаршрутаЭлектронногоДокумента
	|		ПО СостоянияЭлектронныхДокументов.ЭлектронныйДокумент = СоставМаршрутаЭлектронногоДокумента.ЭлектронныйДокумент
	|			И СостоянияЭлектронныхДокументов.Состояние = СоставМаршрутаЭлектронногоДокумента.Состояние
	|ГДЕ
	|	СоставМаршрутаЭлектронногоДокумента.Состояние = &СостояниеТребуетсяПодписание
	|	И СоставМаршрутаЭлектронногоДокумента.Подписант = &Подписант";
	
	Запрос.УстановитьПараметр("Подписант", ТекПользователь);
	Запрос.УстановитьПараметр("СостояниеТребуетсяПодписание", СостояниеТребуетсяПодписание);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ПодписатьКоличество = ПодписатьКоличество + Выборка.КоличествоДокументовНаПодпись;
	КонецЕсли;
	
	Результат.Вставить("Подписать", ПодписатьКоличество);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
