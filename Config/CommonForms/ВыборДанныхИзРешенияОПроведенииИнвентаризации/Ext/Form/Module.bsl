#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаВыбрать(Команда)
	
	Если ТаблицаОтметок.Итог("Отметка") = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru='Отсутствуют отмеченные строки.
			|Необходимо отметить хотя бы одну строку'"));
		
		Возврат;
	КонецЕсли;
	
	Закрыть(ПолучитьВозвращаемоеЗначение());
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВсеКолонки(Команда)
	
	ПоказатьВсеКолонкиКлиент();
	
КонецПроцедуры

