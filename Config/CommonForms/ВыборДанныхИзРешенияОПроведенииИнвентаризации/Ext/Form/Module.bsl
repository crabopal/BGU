#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьУсловноеОформление(ОформитьОтсутствиеДокументов = Истина)
	
	//---
	// Оформление пустой колонки Сотрудник
	//---
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Оформление пустой колонки Сотрудник'");
	
	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаОтметок.СотрудникПредставление");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", ИнвентаризацияКлиентСервер.ПредставлениеПустогоСотрудникаФормаОтметок());
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстИнформационнойНадписи);
	
	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ТаблицаОтметокСотрудникПредставление");
	
	
	Если ОформитьОтсутствиеДокументов Тогда
		//---
		// Оформление пустой колонки Документы описей
		//---
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ЭлементУО.Представление = НСтр("ru='Оформление пустой колонки Документы описей'");
		
		// Условия
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаОтметок.ПредставлениеДокументовОписей");
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
		
		// Оформление
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru='не найдены'"));
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстИнформационнойНадписи);
		
		// Оформляемые поля
		ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ТаблицаОтметокПредставлениеДокументовОписей");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьВозвращаемоеЗначение()
	
	Перем НомерСтроки;
	
	Для Каждого СтрокаТаблицы Из ТаблицаОтметок Цикл
		Если СтрокаТаблицы.Отметка = 1 Тогда
			НомерСтроки = СтрокаТаблицы.НомерСтроки;
			
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Результат = Новый Структура();
	Результат.Вставить("АдресХранилища",	Параметры.АдресХранилища);
	Результат.Вставить("НомерСтроки",		НомерСтроки);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ПрочитатьПараметрыФормы()
	
	Если Не ЭтоАдресВременногоХранилища(Параметры.АдресХранилища) Тогда
		ТекстСообщения = НСтр("ru='В параметре ""АдресХранилища"" ожидается строковый адрес временного хранилища, содержащего параметры формы'");
		
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;
	
	ПереданнаяСтруктура = ПолучитьИзВременногоХранилища(Параметры.АдресХранилища);
	
	ДополнительныеПараметры = ПереданнаяСтруктура.Данные.ДополнительныеПараметры;
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ПереданнаяСтруктура, "Решение,ПоследнееИзменение,ОписьСсылка");
	
	ОбщийСписокСотрудников = Новый ФиксированныйМассив(ДополнительныеПараметры.ОбщийСписокСотрудников);
	
	ОписаниеРеквизитаМОЛ = Новый ФиксированнаяСтруктура(ДополнительныеПараметры.ОписаниеРеквизитаМОЛ);
	
	ТаблицаОтметок.Загрузить(ДополнительныеПараметры.ТаблицаОтметок);
	
	// Объединение строк
	
	ДопустимостьОбъединенияСчетов = ПереданнаяСтруктура.Данные.ДополнительныеПараметры.ДопустимостьОбъединенияСчетов;
	
	ДопустимостьОбъединенияМестИнвентаризации = ПереданнаяСтруктура.Данные.ДополнительныеПараметры.ДопустимостьОбъединенияМестИнвентаризации;
	
	ОбъединитьСтрокиПоСчетам = ПереданнаяСтруктура.НастройкиОбъединенияСтрок.ПоСчетам;
	
	ОбъединитьСтрокиПоМестамИнвентаризации = ПереданнаяСтруктура.НастройкиОбъединенияСтрок.ПоМестамИнвентаризации;
	
	Если Не ДопустимостьОбъединенияСчетов Тогда
		ОбъединитьСтрокиПоСчетам = Ложь;
	КонецЕсли;
	
	Если Не ДопустимостьОбъединенияМестИнвентаризации Тогда
		ОбъединитьСтрокиПоМестамИнвентаризации = Ложь;
	КонецЕсли;
	
	НастроитьВидимостьФлажковОбъединенияСтрок();
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФормуСервер()
	
	НовДоступностьСотрудника = Не ОписаниеРеквизитаМОЛ.Отсутствует;
	
	Элементы.Сотрудник.ТолькоПросмотр								= Не НовДоступностьСотрудника;
	Элементы.ТаблицаОтметокСотрудникПредставление.ТолькоПросмотр	= Не НовДоступностьСотрудника;
	
	Если Не НовДоступностьСотрудника Тогда
		Элементы.Сотрудник.ПодсказкаВвода = ИнвентаризацияКлиентСервер.ПредставлениеПустогоСотрудникаФормаОтметок();
	КонецЕсли;
	
	НастроитьВидимостьКолонок();
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьКолонкуОтметка(СтрокаИсключение = Неопределено)
	
	Для Каждого СтрокаТаблицы Из ТаблицаОтметок Цикл
		
		Если СтрокаТаблицы = СтрокаИсключение Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТаблицы.Отметка = 0;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборПоСотруднику()
	
	СтруктураОтбора = Новый Структура();
	
	Если ЗначениеЗаполнено(Сотрудник) Тогда
		СтруктураОтбора.Вставить("СотрудникПредставление", Строка(Сотрудник));
	КонецЕсли;
		
	НовоеЗначениеОтбора = Новый ФиксированнаяСтруктура(СтруктураОтбора);
	
	Элементы.ТаблицаОтметок.ОтборСтрок = НовоеЗначениеОтбора;
	
	ОчиститьКолонкуОтметка();
	
КонецПроцедуры
	
&НаКлиенте
Функция НеобходимоОчиститьПрежниеОтметки()
	
	Возврат (ТаблицаОтметок.Итог("Отметка") > 1);
	
КонецФункции

&НаСервере
Процедура ОбъединитьСтрокиПриИзмененииСервер()
	
	ПереданнаяСтруктура = ПолучитьИзВременногоХранилища(Параметры.АдресХранилища);
	
	НастройкиОбъединенияСтрок = ИнвентаризацияСервер.ПолучитьПустыеНастройкиОбъединенияСтрокДляВыбораИзРешения();
	НастройкиОбъединенияСтрок.ПоСчетам = ОбъединитьСтрокиПоСчетам;
	НастройкиОбъединенияСтрок.ПоМестамИнвентаризации = ОбъединитьСтрокиПоМестамИнвентаризации;
	
	Данные = ИнвентаризацияСервер.ПодготовитьДанныеДляВыбораИзРешения(ОписьСсылка, Решение, НастройкиОбъединенияСтрок, ПереданнаяСтруктура.Данные);
	
	ТаблицаОтметок.Загрузить(Данные.ДополнительныеПараметры.ТаблицаОтметок);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбранДокументОписи(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыбраннаяОпись = ВыбранноеЗначение.Значение;
	
	Если ВыбраннаяОпись = ОписьСсылка Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьЗначение(, ВыбраннаяОпись);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВсеКолонкиКлиент()
	
	ПоказатьВсеКолонки = Не ПоказатьВсеКолонки;
	
	НастроитьВидимостьКолонок();
	
КонецПроцедуры

&НаСервере
Процедура НастроитьВидимостьКолонок()
	
	ИменаКолонок = Новый Массив();
	ИменаКолонок.Добавить("ДатаНачала");
	ИменаКолонок.Добавить("ДатаОкончания");
	ИменаКолонок.Добавить("МестоИнвентаризацииПредставление");
	ИменаКолонок.Добавить("ДатаИнвентаризации");
	ИменаКолонок.Добавить("ПримечаниеПредставление");
	
	Для Каждого ИмяКолонки Из ИменаКолонок Цикл
		Элементы["ТаблицаОтметок" + ИмяКолонки].Видимость = ПоказатьВсеКолонки;
	КонецЦикла;
	
	Элементы.ФормаПоказатьВсеКолонки.Пометка = ПоказатьВсеКолонки;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьВидимостьФлажковОбъединенияСтрок()
	
	Элементы.ОбъединитьСтрокиПоСчетам.Видимость = ДопустимостьОбъединенияСчетов;
	
	Элементы.ОбъединитьСтрокиПоМестамИнвентаризации.Видимость = ДопустимостьОбъединенияМестИнвентаризации;
	
КонецПроцедуры

#КонецОбласти
