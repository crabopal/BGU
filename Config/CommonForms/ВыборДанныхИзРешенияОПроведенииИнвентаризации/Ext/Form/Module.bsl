#Область ОбработчикиСобытийЭлементовТаблицыФормы_ТаблицаОтметок

&НаКлиенте
Процедура ТаблицаОтметокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ТаблицаОтметокПредставлениеДокументовОписей" Тогда
		СтандартнаяОбработка = Ложь;
		
		ТекДанные = Элементы.ТаблицаОтметок.ТекущиеДанные;
		
		Если ТекДанные = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		СписокДокументовОписей = ТекДанные.СписокДокументовОписей;
		
		Если СписокДокументовОписей.Количество() = 1 Тогда
			ВыбраннаяОпись = СписокДокументовОписей.Получить(0).Значение;
			
			Если ВыбраннаяОпись = ОписьСсылка Тогда
				Возврат;
			КонецЕсли;
			
			ПоказатьЗначение(, ВыбраннаяОпись);
			
		ИначеЕсли СписокДокументовОписей.Количество() > 1 Тогда
			Оповещение = Новый ОписаниеОповещения("ВыбранДокументОписи", ЭтаФорма);
			
			ПоказатьВыборИзСписка(Оповещение, ТекДанные.СписокДокументовОписей);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаОтметокОтметкаПриИзменении(Элемент)
	
	ТекДанные = Элементы.ТаблицаОтметок.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НеобходимоОчиститьПрежниеОтметки() Тогда
		ОчиститьКолонкуОтметка(ТекДанные);
	КонецЕсли;
	
КонецПроцедуры

