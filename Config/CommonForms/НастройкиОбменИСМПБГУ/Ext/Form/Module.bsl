
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Организация = Константы.ОсновнаяОрганизация.Получить();
	
	ПрочитатьКонстанты();
	ПрочитатьЗаполнитьНастройкиПодключенияИСМП();    
	ЗаполнитьНастройкиРазрешительногоРежима();  
	ПараметрыАварийногоРежима = ПолучитьПараметрыАварийногоРежима();
	ПараметрыЛогирования      = ПолучитьПараметрыЛогирования();
		
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьДоступностьПароля(); 
	ОбновитьПредставлениеАварийногоРежима(); 
	ОбновитьПредставлениеЛогирования();
		
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "Запись_НаборКонстант" Тогда
		
		ПроверяемыеИсточники = ИменаПроверяемыхКонстант();
		
		ТребуетсяОбновление = Ложь;
		Если ТипЗнч(Источник) = Тип("Строка") Тогда
			ТребуетсяОбновление = СтрНайти(ПроверяемыеИсточники, Источник) <> 0;
		ИначеЕсли ТипЗнч(Источник) = Тип("Структура") Тогда
			Для Каждого ЭлементСтруктуры Из Источник Цикл
				ТребуетсяОбновление = СтрНайти(ПроверяемыеИсточники, ЭлементСтруктуры.Ключ) <> 0;
				Если ТребуетсяОбновление Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Если ТребуетсяОбновление Тогда
			ПрочитатьКонстанты();
		КонецЕсли;
				
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СертификатПриИзменении(Элемент)
	
	ПриИзмененииСертификатаНаСервере();
	УстановитьДоступностьПароля();
	
КонецПроцедуры

&НаКлиенте
Процедура СертификатОчистка(Элемент, СтандартнаяОбработка)
	
	ПриИзмененииСертификатаНаСервере();
	УстановитьДоступностьПароля();
	
КонецПроцедуры

&НаКлиенте
Процедура ПарольПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Пароль) Тогда
		ПроверитьПарольШаг1();
	Иначе
		ЗаписатьПарольНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПарольОчистка(Элемент, СтандартнаяОбработка)
	
	ЗаписатьПарольНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура АдресИСМППриИзменении(Элемент)
	
	ЗаписатьНастройкиПодключенияИСМП();
	
КонецПроцедуры

&НаКлиенте
Процедура ТаймаутИСМППриИзменении(Элемент)
	
	ЗаписатьНастройкиПодключенияИСМП();
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияОсновноеПояснениеОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	ОбработатьНавигационнуюСсылку(НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрольОстатковКодовИСМППриИзменении(Элемент)
	
	ЗаписатьНастройкиПодключенияИСМП();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаписатьНастройкиПодключенияИСМП()
	
	НаборНастроекИСМП = РегистрыСведений.НастройкиПодключенияИСМПБГУ.СоздатьНаборЗаписей();
	НаборНастроекИСМП.Отбор.Организация.Установить(Организация);
	НаборНастроекИСМП.Очистить();
	
	НоваяЗапись 							= НаборНастроекИСМП.Добавить();
	НоваяЗапись.Организация 				= Организация;
	НоваяЗапись.Сертификат 					= Сертификат;
	НоваяЗапись.Адрес 						= АдресИСМП;
	НоваяЗапись.Таймаут 					= ТаймаутИСМП; 
	НоваяЗапись.КонтрольОстатковКодовИСМП 	= КонтрольОстатковКодовИСМП;
	
	НаборНастроекИСМП.Записать(Истина);
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьЗаполнитьНастройкиПодключенияИСМП()
			
	МетаданныеНастроекИСМП = Метаданные.РегистрыСведений.НастройкиПодключенияИСМПБГУ.Ресурсы;
	
	АдресИСМППоУмолчанию = МетаданныеНастроекИСМП.Адрес.ЗначениеЗаполнения;
	ТаймаутИСМППоУмолчанию = МетаданныеНастроекИСМП.Таймаут.ЗначениеЗаполнения;
	
	Элементы.АдресИСМП.ПодсказкаВвода = АдресИСМППоУмолчанию;
	
	НаборНастроекИСМП = РегистрыСведений.НастройкиПодключенияИСМПБГУ.СоздатьНаборЗаписей();
	НаборНастроекИСМП.Отбор.Организация.Установить(Организация);
	НаборНастроекИСМП.Прочитать();
	
	Если НаборНастроекИСМП.Количество() > 0 Тогда
		
		НастройкаПодключения 		= НаборНастроекИСМП[0];
		Сертификат 					= НастройкаПодключения.Сертификат;
		АдресИСМП 					= НастройкаПодключения.Адрес;
		ТаймаутИСМП 				= НастройкаПодключения.Таймаут;
		КонтрольОстатковКодовИСМП 	= НастройкаПодключения.КонтрольОстатковКодовИСМП;
		
		Если ЗначениеЗаполнено(Сертификат) Тогда
			ЗаполнитьИнформациюОСертификате();
			ПарольСохранен = ОбменИСМПБГУ.ПарольКСертификатуСохранен(Сертификат);
			Если ПарольСохранен Тогда
				УстановитьПредставлениеПароля(Пароль);
			КонецЕсли;
		КонецЕсли;
		
	Иначе
		
		АдресИСМП = АдресИСМППоУмолчанию;
		ТаймаутИСМП = ТаймаутИСМППоУмолчанию;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьКонстанты()
	
	ИменаКонстант = ИменаПроверяемыхКонстант();
	
	НаборКонстант = Константы.СоздатьНабор(ИменаКонстант);
	НаборКонстант.Прочитать();
	
	ВсеКонстантыВключены = Истина;
	
	КоллекцияИменКонстант = КоллекцияИменКонстант(ИменаКонстант);
	
	Для Каждого ИмяКонстанты Из КоллекцияИменКонстант Цикл
		Если НаборКонстант[ИмяКонстанты] = Ложь Тогда
			ВсеКонстантыВключены = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ИменаПроверяемыхКонстант()
	
	Возврат "
		|ИспользоватьОбменИСМПБГУ,
		|ИспользоватьЭлектронныеПодписи";
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция КоллекцияИменКонстант(Знач ИменаКонстант)
	
	ИменаКонстант = СтрЗаменить(ИменаКонстант, Символы.ПС, "");
	ИменаКонстант = СтрЗаменить(ИменаКонстант, "|",        "");
	ИменаКонстант = СтрЗаменить(ИменаКонстант, " ",        "");
	
	Возврат СтрРазделить(ИменаКонстант, ",");
	
КонецФункции

&НаКлиенте
Процедура ОбработатьНавигационнуюСсылку(Знач НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	
	Если НавигационнаяСсылкаФорматированнойСтроки = "ПерейтиВЛичныйКабинет" Тогда
		
		СтандартнаяОбработка = Ложь;
		Если ЗначениеЗаполнено(АдресИСМП) Тогда
			ПолныйАдрес = СтрШаблон("%1%2", "https://", АдресИСМП);
			ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку(ПолныйАдрес);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьПароля()
	
	Элементы.Пароль.Доступность = ЗначениеЗаполнено(Сертификат);
	Элементы.Пароль.ПодсказкаВвода = ПодсказкаПарольНеУказан();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИнформациюОСертификате()
	
	ИнформацияОСертификате = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Сертификат,
		"ДанныеСертификата, Программа");
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ИнформацияОСертификате);
	Если ТипЗнч(ДанныеСертификата) = Тип("ХранилищеЗначения") Тогда
		ДанныеСертификата = ДанныеСертификата.Получить();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииСертификатаНаСервере()
	
	ЗаписатьНастройкиПодключенияИСМП();
	ЗаполнитьИнформациюОСертификате();
	Пароль = "";
	Если ЗначениеЗаполнено(Сертификат) Тогда
		ПарольСохранен = ОбменИСМПБГУ.ПарольКСертификатуСохранен(Сертификат);
		Если ПарольСохранен Тогда
			УстановитьПредставлениеПароля(Пароль);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьПарольНаСервере()
	
	УстановитьПривилегированныйРежим(Истина);
	
	НачатьТранзакцию();
	
	Попытка
		
		Если ЗначениеЗаполнено(Пароль) Тогда
			
			ДанныеПароля = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Сертификат, "ПаролиСертификатов");
			
			Если ТипЗнч(ДанныеПароля) <> Тип("Соответствие") Тогда
				ДанныеПароля = Новый Соответствие;
			КонецЕсли;
			
			ДанныеПароля.Вставить(Справочники.Пользователи.ПустаяСсылка(), Пароль);
			
		Иначе
			
			ДанныеПароля = Неопределено;
			
		КонецЕсли;
		
		ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(Сертификат, ДанныеПароля, "ПаролиСертификатов");
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ВызватьИсключение;
		
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Если ЗначениеЗаполнено(Пароль) Тогда
		УстановитьПредставлениеПароля(Пароль);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПредставлениеПароля(Пароль)
	
	Пароль = "****************";
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПодсказкаПарольНеУказан()
	
	Возврат НСтр("ru = '<не указан>'");
	
КонецФункции

&НаКлиенте
Процедура ПроверитьПарольШаг1()
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ОписаниеОшибки", "");
	
	ОповещениеПослеИнициализации = Новый ОписаниеОповещения("ПроверитьПарольШаг4",
		ЭтотОбъект, ДополнительныеПараметры);
	
	ПроверитьПарольШаг2(ОповещениеПослеИнициализации);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПарольШаг2(Оповещение)
	
	Контекст = Новый Структура("Оповещение", Оповещение);
	
	ОповещениеСледующегоШага = Новый ОписаниеОповещения(
		"ПроверитьПарольШаг3", ЭтотОбъект, Контекст);
	
	НачатьПодключениеРасширенияРаботыСКриптографией(ОповещениеСледующегоШага);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПарольШаг3(Подключено, Контекст) Экспорт
	
	ОповещениеСледующегоШага = Новый ОписаниеОповещения(
		"ПроверитьПарольШаг4", ЭтотОбъект, Контекст);
	
	ЭлектроннаяПодписьКлиент.СоздатьМенеджерКриптографии(ОповещениеСледующегоШага,
		"ПроверкаСертификата", Истина, Программа);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПарольШаг4(Результат, ДополнительныеПараметры) Экспорт
	
	ПроверкаУспешна = Ложь;
	ОписаниеОшибки = "";
	
	Если НЕ ДополнительныеПараметры.Свойство("ОписаниеОшибки", ОписаниеОшибки) Тогда
		ОписаниеОшибки = "";
	КонецЕсли;
	Если ТипЗнч(Результат) = Тип("МенеджерКриптографии") Тогда
		ПроверкаУспешна = ПроверитьПарольШаг5(ЭтотОбъект, Программа, ДанныеСертификата, Пароль, ОписаниеОшибки, Результат);
	Иначе
		ОписаниеОшибки = Результат;
	КонецЕсли;
	
	ЗаписатьПарольПослеПроверки(ПроверкаУспешна, ОписаниеОшибки);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПроверитьПарольШаг5(Форма, Программа, ДанныеСертификата, Пароль, ОписаниеОшибки, МенеджерКриптографии)
	
	ПроверкаУспешна = Ложь;
	
	СертификатКриптографии = Новый СертификатКриптографии(ДанныеСертификата);
	
	МенеджерКриптографии.ПарольДоступаКЗакрытомуКлючу = Пароль;
	Попытка
		МенеджерКриптографии.Подписать(ДанныеСертификата, СертификатКриптографии);
		ПроверкаУспешна = Истина;
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ОписаниеОшибки = ОписаниеОшибки + Символы.ПС + Символы.ПС
			+ СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Возможно, пароль указан неправильно.
					|Программа %1 вернула ошибку:
					|%2'"),
				Программа,
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке));
	КонецПопытки;
	
	Возврат ПроверкаУспешна;
	
КонецФункции

&НаКлиенте
Процедура ЗаписатьПарольПослеПроверки(ПроверкаУспешна, ОписаниеОшибки)
	
	Если Не ПроверкаУспешна Тогда
		Пароль = "";
	КонецЕсли;
	
	ЗаписатьПарольНаСервере();
	
	Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
		ПоказатьПредупреждение(, СокрЛП(ОписаниеОшибки));
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНастройкиРазрешительногоРежима()
	
	ВидыПродукцииИС = Новый Массив;
	Для Каждого ВидПродукции Из Перечисления.ВидыМаркируемойПродукции Цикл 
		ВидыПродукцииИС.Добавить(ОбменИСМПБГУ.СопоставитьТипыМаркировкиРазрешительныйРежим(ВидПродукции));	
	КонецЦикла;	
		
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ВидыПродукцииИС.Ссылка КАК Ссылка
	               |ПОМЕСТИТЬ ВТТоварныеГруппы
	               |ИЗ
	               |	Перечисление.ВидыПродукцииИС КАК ВидыПродукцииИС
	               |ГДЕ
	               |	ВидыПродукцииИС.Ссылка В(&ВидыПродукцииИС)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	НастройкиУчетаМаркируемойПродукцииИСМП.ВидПродукции КАК ВидПродукции,
	               |	НастройкиУчетаМаркируемойПродукцииИСМП.ВестиУчетПродукции КАК ВестиУчетПродукции,
	               |	НастройкиУчетаМаркируемойПродукцииИСМП.ДатаРозницаУведомительныйРежим КАК ДатаРозницаУведомительныйРежим,
	               |	НастройкиУчетаМаркируемойПродукцииИСМП.ДатаРозницаРазрешительныйРежим КАК ДатаРозницаРазрешительныйРежим,
	               |	НастройкиУчетаМаркируемойПродукцииИСМП.ДатаРозницаЛокальныйРазрешительныйРежим КАК ДатаРозницаЛокальныйРазрешительныйРежим,
	               |	НастройкиУчетаМаркируемойПродукцииИСМП.ДатаЗапретПродажиНемаркированныхОстатков КАК ДатаЗапретПродажиНемаркированныхОстатков
	               |ПОМЕСТИТЬ ВТНастройки
	               |ИЗ
	               |	РегистрСведений.НастройкиУчетаМаркируемойПродукцииИСМП КАК НастройкиУчетаМаркируемойПродукцииИСМП
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТТоварныеГруппы.Ссылка КАК ТоварнаяГруппа,
	               |	ЕСТЬNULL(ВТНастройки.ВестиУчетПродукции, ЛОЖЬ) КАК ВестиУчетПродукции,
	               |	ЕСТЬNULL(ВТНастройки.ДатаРозницаУведомительныйРежим, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаРозницаУведомительныйРежим,
	               |	ЕСТЬNULL(ВТНастройки.ДатаРозницаРазрешительныйРежим, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаРозницаРазрешительныйРежим,
	               |	ЕСТЬNULL(ВТНастройки.ДатаРозницаЛокальныйРазрешительныйРежим, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаРозницаЛокальныйРазрешительныйРежим,
	               |	ЕСТЬNULL(ВТНастройки.ДатаЗапретПродажиНемаркированныхОстатков, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаЗапретПродажиНемаркированныхОстатков
	               |ИЗ
	               |	ВТТоварныеГруппы КАК ВТТоварныеГруппы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТНастройки КАК ВТНастройки
	               |		ПО ВТТоварныеГруппы.Ссылка.Ссылка = ВТНастройки.ВидПродукции.Ссылка";   
	
	Запрос = Новый Запрос(ТекстЗапроса);                                         
	Запрос.УстановитьПараметр("ВидыПродукцииИС", ВидыПродукцииИС);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();  
	
	Для Каждого СтрокаЗапроса Из РезультатЗапроса Цикл 
		НоваяСтрока = ТоварныеГруппыРазрешительногоРежима.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЗапроса);
	КонецЦикла;     
	ТоварныеГруппыРазрешительногоРежима.Сортировать("ТоварнаяГруппа");
КонецПроцедуры	

&НаСервере
Процедура ТоварныеГруппыРазрешительногоРежимаПриИзмененииНаСервере()

	НаборЗаписей = РегистрыСведений.НастройкиУчетаМаркируемойПродукцииИСМП.СоздатьНаборЗаписей();
	Для Каждого ТоварнаяГруппа Из ТоварныеГруппыРазрешительногоРежима Цикл 
		Если ТоварнаяГруппа.ВестиУчетПродукции Тогда 
			НоваяСтрока = НаборЗаписей.Добавить();
			НоваяСтрока.ВидПродукции = ТоварнаяГруппа.ТоварнаяГруппа; 
			НоваяСтрока.ВестиУчетПродукции 							= ТоварнаяГруппа.ВестиУчетПродукции;
			НоваяСтрока.ДатаРозницаУведомительныйРежим 				= ТоварнаяГруппа.ДатаРозницаУведомительныйРежим;
			НоваяСтрока.ДатаРозницаРазрешительныйРежим 				= ТоварнаяГруппа.ДатаРозницаРазрешительныйРежим;
			НоваяСтрока.ДатаРозницаЛокальныйРазрешительныйРежим 	= ТоварнаяГруппа.ДатаРозницаЛокальныйРазрешительныйРежим;
			НоваяСтрока.ДатаЗапретПродажиНемаркированныхОстатков 	= ТоварнаяГруппа.ДатаЗапретПродажиНемаркированныхОстатков;
		КонецЕсли;	
	КонецЦикла;	
	
	Если НаборЗаписей.Количество() = 0 Тогда 
		Константы.ВестиУчетМаркируемойПродукцииИСМП.Установить(Ложь);
	Иначе
		Константы.ВестиУчетМаркируемойПродукцииИСМП.Установить(Истина);
	КонецЕсли;	  
	
	НаборЗаписей.Записать(Истина); 
	
КонецПроцедуры

