
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Параметры, "ВидОбменаДляQRКода,ИмяОбъектаМетаданных,ФорматОбменаДляQRКода");
	
	ИдентификаторОбъекта = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ИмяОбъектаМетаданных);
	
	Если ЗначениеЗаполнено(ВидОбменаДляQRКода) И ЗначениеЗаполнено(ФорматОбменаДляQRКода) Тогда
		СпособОбмена = 2;
	Иначе
		СпособОбмена = 1;
	КонецЕсли;
	
	Элементы.ПравилоОбмена.Доступность = СпособОбмена = 2;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СпособОбменаПриИзменении(Элемент)
	
	Если СпособОбмена = 1 Тогда
		ВидОбменаДляQRКода = "";
		ФорматОбменаДляQRКода = "";
	КонецЕсли;
	
	Элементы.ПравилоОбмена.Доступность = СпособОбмена = 2;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаОК(Команда)
	
	Если СпособОбмена = 2 Тогда
		Если НЕ ЗначениеЗаполнено(ВидОбменаДляQRКода) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не заполнено поле Вид обмена'"),,"ВидОбменаДляQRКода",,);
			Возврат;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ФорматОбменаДляQRКода) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не заполнено поле Формат обмена'"),,"ФорматОбменаДляQRКода",,);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыОповещения = Новый Структура;
	ПараметрыОповещения.Вставить("ВидОбменаДляQRКода", ВидОбменаДляQRКода);
	ПараметрыОповещения.Вставить("ФорматОбменаДляQRКода", ФорматОбменаДляQRКода);
	ОповеститьОВыборе(ПараметрыОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОтмена(Команда)
	Закрыть();
КонецПроцедуры

#КонецОбласти