#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ДобавитьВСписок(Команда)
	
	Если ЕстьКодыМаркировки() Тогда
		АдресКодовМаркировкиВХранилище = ПоместитьКодыМаркировкиВХранилище();
		Структура = Новый Структура("АдресКодовМаркировкиВХранилище", АдресКодовМаркировкиВХранилище);
		ОповеститьОВыборе(Структура);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ЕстьКодыМаркировки()
	Возврат ЗначениеЗаполнено(СокрЛП(ТекстСпискаСтрок));
КонецФункции

&НаСервере
Функция ПоместитьКодыМаркировкиВХранилище()
	
	КодыМаркировки = Новый ТаблицаЗначений;
	КодыМаркировки.Колонки.Добавить("КодМаркировки", Новый ОписаниеТипов("Строка"));
	КодыМаркировки.Колонки.Добавить("ТипУпаковки", Новый ОписаниеТипов("Строка"));
	
	ТекстКодов = СокрЛП(ТекстСпискаСтрок);
	
	Для ТекНомерСтроки = 1 По СтрЧислоСтрок(ТекстКодов) Цикл
		СтрокаТекста = СтрПолучитьСтроку(ТекстКодов, ТекНомерСтроки);
		Если ЗначениеЗаполнено(СтрокаТекста) Тогда
			НоваяСтрока = КодыМаркировки.Добавить();
			НоваяСтрока.КодМаркировки = СокрЛП(СтрокаТекста);
			НоваяСтрока.ТипУпаковки = НСтр("ru = 'Индивидуальная упаковка'");
		КонецЕсли;
	КонецЦикла;	

	Результат = ПоместитьВоВременноеХранилище(КодыМаркировки, УникальныйИдентификатор);

	Возврат Результат;
	
КонецФункции

#КонецОбласти
