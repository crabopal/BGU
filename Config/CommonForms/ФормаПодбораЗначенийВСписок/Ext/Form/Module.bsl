
////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.ТипИсточника <> "Запрос" и Параметры.ТипИсточника <> "Список" Тогда 
		ВызватьИсключение НСтр("ru = 'Неизвестный тип источника.'");
	КонецЕсли;
	
		
	
	ИсточникЗначений = Параметры.ТипИсточника;
	
	Если ЗначениеЗаполнено(Параметры.Заголовок) Тогда 
		ЭтаФорма.АвтоЗаголовок = Ложь;
		ЭтаФорма.Заголовок = Параметры.Заголовок;
	КонецЕсли;	
	
	ИтоговыйСписокЗначений.ЗагрузитьЗначения(Параметры.ИсходныйСписок.ВыгрузитьЗначения());
		
	Если ИсточникЗначений = "Список" Тогда 
		Элементы.ГруппаСтраницыИсточников.ТекущаяСтраница = Элементы.ГруппаСтраницаСписок;
		ЗаполнитьВариантыПоСписку();
		
		
	ИначеЕсли ИсточникЗначений = "Запрос" Тогда
		Элементы.ГруппаСтраницыИсточников.ТекущаяСтраница = Элементы.ГруппаСтраницаЗапрос;
		ЗаполнитьВариантыПоЗапросу();
		
	КонецЕсли;	
	
	СоздатьДополнительныеПоля();
	
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура Выбрать(Команда)
	ОповеститьОВыборе(ИтоговыйСписокЗначений);
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	ЭтаФорма.Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура УдалитьВыбранноеЗначение(Команда)
	
	СтрокиДляУдаления = ОбщегоНазначенияКлиентСервер.СкопироватьМассив(Элементы.ИтоговыйСписокЗначений.ВыделенныеСтроки);
	
	Для Каждого СтрокаДляУдаления из СтрокиДляУдаления Цикл 
		
		ИтоговыйСписокЗначений.Удалить(ИтоговыйСписокЗначений.НайтиПоИдентификатору(СтрокаДляУдаления));
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьЗначения(Команда)
	
	Если ИсточникЗначений = "Запрос" Тогда 
		Для Каждого ЗначениеДляДобавления из Элементы.ДинамическийСписокВариантовДляВыбора.ВыделенныеСтроки Цикл 
			Если ИтоговыйСписокЗначений.НайтиПоЗначению(ЗначениеДляДобавления) <> Неопределено Тогда 
				Продолжить;
			КонецЕсли;
			
			ИтоговыйСписокЗначений.Добавить(ЗначениеДляДобавления);
			
		КонецЦикла;
		
	Иначе 
		
		Для Каждого ИдСтроки из Элементы.ВариантыДляВыбора.ВыделенныеСтроки Цикл 
			
			ДанныеСтроки = СписокВариантовДляВыбора.НайтиПоИдентификатору(ИдСтроки);
			
			Если ИтоговыйСписокЗначений.НайтиПоЗначению(ДанныеСтроки.Значение) <> Неопределено Тогда 
				Продолжить;
			КонецЕсли;
			
			ИтоговыйСписокЗначений.Добавить(ДанныеСтроки.Значение);
			
		КонецЦикла;
		
	КонецЕсли;
	
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ТАБЛИЦ ФОРМЫ 

&НаКлиенте
Процедура ДинамическийСписокВариантовДляВыбораВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	Для Каждого ЗначениеДляДобавления из ВыбраннаяСтрока Цикл 
		
		Если ИтоговыйСписокЗначений.НайтиПоЗначению(ЗначениеДляДобавления) <> Неопределено Тогда 
			Продолжить;
		КонецЕсли;
		
		ИтоговыйСписокЗначений.Добавить(ЗначениеДляДобавления);
		
	КонецЦикла;	
		
КонецПроцедуры

&НаКлиенте
Процедура ВариантыДляВыбораВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	Для Каждого ИдСтроки из ВыбраннаяСтрока Цикл 
		
		ДанныеСтроки = СписокВариантовДляВыбора.НайтиПоИдентификатору(ИдСтроки);
		
		Если ИтоговыйСписокЗначений.НайтиПоЗначению(ДанныеСтроки.Значение) <> Неопределено Тогда 
			Продолжить;
		КонецЕсли;
		
		ИтоговыйСписокЗначений.Добавить(ДанныеСтроки.Значение);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ИтоговыйСписокЗначенийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Для Каждого СтрокаДляУдаления из ВыбраннаяСтрока Цикл 
		
		ИтоговыйСписокЗначений.Удалить(ИтоговыйСписокЗначений.НайтиПоИдентификатору(СтрокаДляУдаления));
		
	КонецЦикла;
	

КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаСервере
Процедура ЗаполнитьВариантыПоСписку()
	
	Если Не ЗначениеЗаполнено(Параметры.СписокЗначенийДляВыбора) Тогда 
		Возврат;
	КонецЕсли;	
	
	Для Каждого СтрокаСпискаДляВыбора из Параметры.СписокЗначенийДляВыбора Цикл 
		
		НоваяСтрока = СписокВариантовДляВыбора.Добавить();
		НоваяСтрока.Значение = СтрокаСпискаДляВыбора.Значение;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВариантыПоЗапросу()
	
	Если не ЗначениеЗаполнено(Параметры.ТипВыбираемогоЗначения) Тогда 
		ВызватьИсключение НСтр("ru = 'Не выбран тип значения.'");
	КонецЕсли;
	
	МассивТипов = Параметры.ТипВыбираемогоЗначения.Типы();
	Если МассивТипов.Количество() > 1 Тогда 
		ВызватьИсключение НСтр("ru = 'Выбор составных типов из запроса не поддерживается.'");
	КонецЕсли;
	
	ТипВыбираемогоЗначения = МассивТипов[0];
	
	Если Не ОбщегоНазначения.ЭтоСсылка(ТипВыбираемогоЗначения) Тогда 
		ВызватьИсключение НСтр("ru = 'Из запроса возможен выбор только ссылочных типов.'");
	КонецЕсли;
	
	ВидОбъекта = ОбщегоНазначения.ВидОбъектаПоТипу(ТипВыбираемогоЗначения);
	ИмяОбъекта = Метаданные.НайтиПоТипу(ТипВыбираемогоЗначения).Имя;
	
	ШаблонЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Таблица.Ссылка КАК Значение
	|ИЗ
	|	%1.%2 КАК Таблица";
	
	ДинамическийСписокВариантовДляВыбора.ТекстЗапроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонЗапроса, ВидОбъекта, ИмяОбъекта);
	ДинамическийСписокВариантовДляВыбора.ОсновнаяТаблица = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("%1.%2", ВидОбъекта, ИмяОбъекта);
	ДинамическийСписокВариантовДляВыбора.ДинамическоеСчитываниеДанных = Истина;
	
	
		
	
	
	
КонецПроцедуры	

&НаСервере
Процедура СоздатьДополнительныеПоля()
	
	Если Не ЗначениеЗаполнено(Параметры.СписокДопПолейДляОтображения) Тогда 
		Возврат;
	КонецЕсли;
	
	Если ИсточникЗначений = "Список" Тогда 
		ШаблонИмени = "ВариантыДляВыбораДопПоле%1"; 
		ШаблонПути = "СписокВариантовДляВыбора.Значение.%1"; 
		Родитель = Элементы.ВариантыДляВыбора; 
		
	ИначеЕсли ИсточникЗначений = "Запрос" Тогда
		ШаблонИмени = "ДинамическийСписокВариантовДляВыбораДопПоле%1"; 
		ШаблонПути = "ДинамическийСписокВариантовДляВыбора.Значение.%1";
		Родитель = Элементы.ДинамическийСписокВариантовДляВыбора;
		
	КонецЕсли;	
	
	Счетчик = 0;
	Для Каждого ОписаниеДопПоля из Параметры.СписокДопПолейДляОтображения Цикл 
		Счетчик = Счетчик + 1;
		
		ИмяЭлемента = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонИмени, Счетчик);
		ПутьКДанным = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонПути, ОписаниеДопПоля.Значение);
		
		НовыйЭлемент = Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), Родитель);
		НовыйЭлемент.ПутьКДанным = ПутьКДанным;
		НовыйЭлемент.Заголовок = ОписаниеДопПоля.Представление;
		НовыйЭлемент.ТолькоПросмотр = Истина;
		
	КонецЦикла;
	
КонецПроцедуры	



