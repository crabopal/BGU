КонецФункции

&НаСервере
Функция ЭтоОблачнаяККТ()
	
	Возврат КассаККМ.ПодключаемоеОборудование.ТипОборудования = Перечисления.ТипыПодключаемогоОборудования.ОблачнаяККТ;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаменитьСимволGS1(Штрихкод)
	
	СимволGS1 = МенеджерОборудованияМаркировкаКлиентСервер.РазделительGS1();
	Разделитель = МенеджерОборудованияМаркировкаКлиентСервер.ЭкранированныйСимволGS1();
	
	Штрихкод = СтрЗаменить(Штрихкод, СимволGS1, Разделитель);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатусРР(ПриОткрытии = Ложь)
	
	Если ПриОткрытии Тогда 
		Элементы.ДекорацияНадписьРезультатРР.ЦветТекста 		= WebЦвета.Серый;
		Элементы.ДекорацияНадписьРезультатРР.Заголовок 			= НСтр("ru='Проверка не проводилась'");
	ИначеЕсли ПродажаРазрешена Тогда 
		Элементы.ДекорацияНадписьРезультатРР.ЦветТекста 		= WebЦвета.Зеленый;
		Элементы.ДекорацияНадписьРезультатРР.Заголовок 			= НСтр("ru='Продажа разрешена'");
	Иначе 
		Элементы.ДекорацияНадписьРезультатРР.ЦветТекста 		= WebЦвета.Красный;
		Элементы.ДекорацияНадписьРезультатРР.Заголовок 			= НСтр("ru='Продажа запрещена'");
	КонецЕсли;	
	
КонецПроцедуры	
	
