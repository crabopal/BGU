
&НаКлиенте
Перем ШтрихКодОтсканирован;

&НаКлиенте
Перем КМПодтвержден;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Пропускаем инициализацию, чтобы гарантировать получение формы при передаче параметра "АвтоТест".
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьДоступноеПодключаемоеОборудование(ИспользоватьПодключаемоеОборудование);
	
	Если Параметры.Свойство("Номенклатура") Тогда 
		Номенклатура 								= Параметры.Номенклатура;
		НоменклатураСсылка							= Параметры.Номенклатура.Номенклатура;
	КонецЕсли;	
	Если Параметры.Свойство("Количество") Тогда 
		Количество 									= Параметры.Количество;
	КонецЕсли;	
	Если Параметры.Свойство("КодМаркировки") Тогда 
		КодМаркировки 								= Параметры.КодМаркировки;
	КонецЕсли;	
	Если Параметры.Свойство("СессияПроверкиКМОткрыта") Тогда 
		СессияПроверкиКМОткрыта 					= Параметры.СессияПроверкиКМОткрыта;
	КонецЕсли;
	Если Параметры.Свойство("КассаККМ") Тогда 
		КассаККМ 									= Параметры.КассаККМ;
		ПараметрыКассыККМ 							= ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьПараметрыКассыККМ(КассаККМ);
		ИдентификаторУстройстваФР 					= ПараметрыКассыККМ.ИдентификаторУстройства;
		ИспользуетсяККТСПередачейДанных 			= ПодключаемоеОборудованиеБГУ.ИспользуетсяККТСПередачейДанных(КассаККМ);  
		ВерсияФФД									= ПодключаемоеОборудованиеБГУ.ВерсияФФД(КассаККМ); 
		НомерФискальногоНакопителя                  = ПодключаемоеОборудованиеБГУ.НомерФискальногоНакопителя(КассаККМ);
	КонецЕсли;
	Если Параметры.Свойство("АдресДанныхПроверкиКМ") И Параметры.АдресДанныхПроверкиКМ <> "" Тогда
		ДанныеПроверкиКМ = ПолучитьИзВременногоХранилища(Параметры.АдресДанныхПроверкиКМ);
		ПараметрыДляЗаполнения = "КодМаркировкиПроверенФН, ТекстРезультатаПроверкиФН, РезультатПроверкиФН, РезультатПроверкиОИСМ, 
								|ТекстРезультатаПроверкиОИСМ, КодОбработкиЗапроса, СтатусТовара, УникальныйИдентификаторЗапроса";
		Если ДанныеПроверкиКМ <> Неопределено Тогда 
			ЗаполнитьЗначенияСвойств(ЭтаФорма, ДанныеПроверкиКМ, ПараметрыДляЗаполнения);
		КонецЕсли;	
	КонецЕсли;	
	Если Параметры.Свойство("РезультатПроверкиКМ") Тогда 
		РезультатПроверкиКМ 						= Параметры.РезультатПроверкиКМ;
	КонецЕсли;	
	Если Параметры.Свойство("РежимПродажи") Тогда 
		РежимПродажи 								= Параметры.РежимПродажи;
	КонецЕсли; 
	Если Параметры.Свойство("Организация") Тогда 
		Организация 								= Параметры.Организация;
	КонецЕсли;    
	Если Параметры.Свойство("ВидПродукцииИС") Тогда 
		ВидПродукцииИС 								= Параметры.ВидПродукцииИС;
	КонецЕсли;
	Если ЗначениеЗаполнено(ВидПродукцииИС) Тогда  
		СписокВидовПродукцииРазрешительногоРежима = 
			РегистрыСведений.НастройкиУчетаМаркируемойПродукцииИСМП.СписокУчитываемойПродукцииТребующейОбязательнойОнлайнПроверкиПриПродажеВРозницуНаДату();
		Если СписокВидовПродукцииРазрешительногоРежима.Найти(ВидПродукцииИС) = Неопределено Тогда 
			РазрешительныйРежим 					= Ложь;
		Иначе	
			РазрешительныйРежим 					= Истина;
		КонецЕсли;	
	КонецЕсли;
	Если Параметры.Свойство("ДокументОснование") Тогда 
		ДокументОснование 							= Параметры.ДокументОснование;
	КонецЕсли; 
	Если Параметры.Свойство("Числитель") Тогда 
		Числитель 									= Параметры.Числитель;
	КонецЕсли;
	Если Параметры.Свойство("Знаменатель") Тогда 
		Знаменатель 								= Параметры.Знаменатель;
	КонецЕсли;
	
	ДобавляемыеРеквизиты = Новый Массив;
	Реквизит = Новый РеквизитФормы("КодМаркировкиДляУточнения", Новый ОписаниеТипов); 
	ДобавляемыеРеквизиты.Добавить(Реквизит);
	ЭтаФорма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// ПодключаемоеОборудование
	МенеджерОборудованияКлиент.НачатьПодключениеОборудованиеПриОткрытииФормы(Неопределено, ЭтотОбъект, "СканерШтрихкода"); 
	МенеджерОборудованияКлиент.НачатьПодключениеОборудования(Неопределено, ЭтотОбъект, , ИдентификаторУстройстваФР);
	// Конец ПодключаемоеОборудование
	
	Если КодМаркировки = "" Тогда 
		ШтрихКодОтсканирован 	= Ложь;
		КМПодтвержден 			= Ложь;
	Иначе 
		ШтрихКодОтсканирован 	= Истина;
		КМПодтвержден		    = Истина;
	КонецЕсли;		
	
	УстановитьДоступностьЭлементовМаркировка();
	
	УстановитьСтатусыПроверки();
	ОбновитьСтатусРР(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ВнешнееСобытие(Источник, Событие, Данные)
	
	Если ВводДоступен() Тогда
		ПодключаемоеОборудованиеБГУКлиент.ВнешнееСобытиеОборудования(ЭтотОбъект, Источник, Событие, Данные);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьЗапросНаПроверкуКМ(ДанныеШтрихкода = Неопределено)
	
	Если НЕ СессияПроверкиКМОткрыта  Тогда 
		ОповещениеПриЗавершении = Новый ОписаниеОповещения("ОткрытьСессияПроверкиКМЗавершение", ЭтотОбъект);
		ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьОткрытиеСессииРегистрацииКМ(ОповещениеПриЗавершении, УникальныйИдентификатор, ИдентификаторУстройстваФР);
	КонецЕсли;
	
	УникальныйИдентификаторЗапроса = Строка(Новый УникальныйИдентификатор); 
	
	ПараметрыОперации = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыЗапросКМ();
	ПараметрыОперации.ИдентификаторЗапроса 			= УникальныйИдентификаторЗапроса; 
	ПараметрыОперации.ДробноеКоличество.Числитель   = Числитель;     
	ПараметрыОперации.ДробноеКоличество.Знаменатель = Знаменатель;     
	ПараметрыОперации.МераКоличестваПредметаРасчета = ПредопределенноеЗначение("Перечисление.МераКоличестваПредметаРасчетаККТ.Штука");
	Если РежимПродажи = 0 Тогда 
		ПараметрыОперации.ПланируемыйСтатусТовара 	= ПредопределенноеЗначение("Перечисление.ПланируемыйСтатусМаркируемогоТовара.ШтучныйТоварРеализован");
	Иначе	
		ПараметрыОперации.ПланируемыйСтатусТовара 	= ПредопределенноеЗначение("Перечисление.ПланируемыйСтатусМаркируемогоТовара.ШтучныйТоварВозвращен");
	КонецЕсли;	
	Если Числитель > 0 Тогда 
		ПараметрыОперации.Количество 				= 1;
		ПараметрыОперации.ПланируемыйСтатусТовара 	= ПредопределенноеЗначение("Перечисление.ПланируемыйСтатусМаркируемогоТовара.МерныйТоварВСтадииРеализации");
	Иначе 	
		ПараметрыОперации.Количество 				= ?(Количество = 0, 1, Количество);  
	КонецЕсли;
	ПараметрыОперации.КонтрольнаяМарка 				= КодМаркировки;
	ПараметрыОперации.ОжидатьПолучениеОтветаОИСМ 	= Истина; 
	ПараметрыОперации.Наименование        			= Номенклатура;

	Если РазрешительныйРежим И ЗначениеЗаполнено(ДанныеШтрихкода) Тогда 
		ПараметрыОперации.ЗапросРазрешенияПродажиКМ     	= Истина;
		ПараметрыОперации.АдресСервераЗапросаРазрешения 	= ДанныеШтрихкода.РазрешительныйРежимАдресСервера;
		ПараметрыОперации.ТекстЗапросаРазрешения        	= ДанныеШтрихкода.РазрешительныйРежимТелоЗапросаJSON;
		ПараметрыОперации.КодОтветаРазрешения           	= ДанныеШтрихкода.РазрешительныйРежимКодОтвета;
		ПараметрыОперации.РезультатЗапросаРазрешения    	= ДанныеШтрихкода.РазрешительныйРежимТелоОтветаJSON;
		ПараметрыОперации.ИдентификаторЗапросаРазрешения	= ДанныеШтрихкода.РазрешительныйРежимИдентификаторЗапросаГИСМТ;
		ПараметрыОперации.ВремяЗапросаРазрешения        	= ДанныеШтрихкода.РазрешительныйРежимДатаЗапросаГИСМТ;
	КонецЕсли;	
	
	ОповещениеПриЗавершении = Новый ОписаниеОповещения("КомандаВыполнитьЗавершениеКМФН", ЭтотОбъект);
	ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьЗапросКМ(ОповещениеПриЗавершении, УникальныйИдентификатор, ИдентификаторУстройстваФР, ПараметрыОперации);
	
КонецПроцедуры	

&НаКлиенте
Процедура Ввод(Команда)
	
	Если КМПодтвержден Или (ВерсияФФД <> "1.2") Тогда 
		ДанныеПроверки = ПолучитьСтруктуруРезультатаПроверки();
		ДанныеПроверки.КодМаркировки 								= КодМаркировки;
		ДанныеПроверки.РезультатПроверкиКМ 							= РезультатПроверкиКМ;
		ДанныеПроверки.СессияПроверкиКМОткрыта 						= СессияПроверкиКМОткрыта;
		ДанныеПроверки.УдалитьТоварИзСписка 						= Ложь;
		Если КодМаркировкиПроверенФН Тогда 
			ДанныеПроверки.АдресДанныхПроверкиКМ 					= ПоместитьВоВременноеХранилище(ДанныеПроверкиКМ(), ЭтаФорма.ВладелецФормы.УникальныйИдентификатор);	
		КонецЕсли;
				
		ЗакрытьФорму 												= Истина;
		Закрыть(ДанныеПроверки);
	Иначе 	
		ПараметрыОперации = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыПодтверждениеКМ();
		ПараметрыОперации.ИдентификаторЗапроса 	= УникальныйИдентификаторЗапроса;
		ПараметрыОперации.Выбытие				= Истина;
		
		ОповещениеПриЗавершении = Новый ОписаниеОповещения("КомандаЗавершениеПодтвержденияКМ", ЭтотОбъект);
		ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьПодтверждениеКМ(ОповещениеПриЗавершении, УникальныйИдентификатор, ИдентификаторУстройстваФР, ПараметрыОперации);
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ОтказОтПокупки(Команда)
	
	ПараметрыОперации = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыПодтверждениеКМ();
	ПараметрыОперации.ИдентификаторЗапроса 	= УникальныйИдентификаторЗапроса;
	ПараметрыОперации.Выбытие				= Ложь;
	
	ОповещениеПриЗавершении = Новый ОписаниеОповещения("КомандаОтказПодтвержденияКМ", ЭтотОбъект);
	ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьПодтверждениеКМ(ОповещениеПриЗавершении, УникальныйИдентификатор, ИдентификаторУстройстваФР, ПараметрыОперации);
	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеПоискаПоШтрихкоду(Штрихкод, ДополнительныеПараметры) Экспорт
	
	Если (НЕ КМПодтвержден) И (НЕ ПустаяСтрока(Штрихкод)) Тогда  
		КодМаркировки = МенеджерОборудованияКлиентСервер.ШтрихкодВBase64(Штрихкод);
		
		Если РазрешительныйРежим Тогда 
			ПроверитьКодМаркировкиИСМП(Штрихкод);
		Иначе 
			ШтрихКодОтсканирован = Истина;
			Если ИспользуетсяККТСПередачейДанных И (ВерсияФФД = "1.2")  Тогда  
				ОчиститьСостояниеПроверки();
				ОтправитьЗапросНаПроверкуКМ();
			КонецЕсли; 
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КодМаркировкиПриИзменении(Элемент)
	
	Штрихкод = КодМаркировки;
	КодМаркировки = МенеджерОборудованияКлиентСервер.ШтрихкодВBase64(КодМаркировки);
	Если ИспользуетсяККТСПередачейДанных И (ВерсияФФД = "1.2") Тогда  
		Если РазрешительныйРежим Тогда 
			ПроверитьКодМаркировкиИСМП(Штрихкод);	
		Иначе 	
			ОчиститьСостояниеПроверки();
			ШтрихКодОтсканирован = Истина;
			ОтправитьЗапросНаПроверкуКМ();
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСессияПроверкиКМЗавершение(РезультатВыполнения, Параметры) Экспорт

	Если РезультатВыполнения.Результат Тогда
		СессияПроверкиКМОткрыта = Истина; 
	Иначе
		ТекстСообщения = РезультатВыполнения.ОписаниеОшибки;
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыполнитьЗавершениеКМФН(РезультатВыполнения, Параметры) Экспорт
	
	Если РезультатВыполнения.Результат Тогда
		Если РезультатВыполнения.Свойство("КодМаркировкиПроверен") Тогда
			КодМаркировкиПроверенФН 	= РезультатВыполнения.КодМаркировкиПроверен;
			ТекстРезультатаПроверкиФН 	= РезультатВыполнения.РезультатXML;
		КонецЕсли;
		Если РезультатВыполнения.Свойство("РезультатПроверки") Тогда
			РезультатПроверкиФН 		= РезультатВыполнения.РезультатПроверки;
		КонецЕсли;
		Если РезультатВыполнения.Свойство("РезультатПроверкиОИСМ") Тогда
			РезультатПроверкиОИСМ 		= РезультатВыполнения.РезультатПроверкиОИСМ;
			ТекстРезультатаПроверкиОИСМ	= РезультатВыполнения.РезультатXML;
		КонецЕсли;
		Если РезультатВыполнения.Свойство("КодОбработкиЗапроса") Тогда
			КодОбработкиЗапроса 		= РезультатВыполнения.КодОбработкиЗапроса;
		КонецЕсли;
		Если РезультатВыполнения.Свойство("СтатусТовара") Тогда
			СтатусТовара 				= РезультатВыполнения.СтатусТовара;
		КонецЕсли;
	Иначе
		ТекстСообщения = РезультатВыполнения.ОписаниеОшибки;
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
	УстановитьСтатусыПроверки();
	ПодключитьОбработчикОжидания("ОжиданиеРезультатовПроверки", 1);
	
КонецПроцедуры	

&НаКлиенте
Процедура УстановитьСтатусыПроверки()
	
	ПроверкаКМПройдена = Истина;
	Если ШтрихКодОтсканирован Тогда 
		Если КодМаркировкиПроверенФН И РезультатПроверкиФН Тогда 
			Элементы.ДекорацияНадписьРезультатФН.ЦветТекста 	= WebЦвета.Зеленый;
			Элементы.ДекорацияНадписьРезультатФН.Заголовок 		= НСтр("ru='Проверка пройдена'");
		ИначеЕсли НЕ КодМаркировкиПроверенФН Тогда 
			Элементы.ДекорацияНадписьРезультатФН.ЦветТекста 	= WebЦвета.Серый;
			Элементы.ДекорацияНадписьРезультатФН.Заголовок 		= НСтр("ru='Проверка не проводилась'");
			ПроверкаКМПройдена									= Ложь;
		Иначе
			Элементы.ДекорацияНадписьРезультатФН.ЦветТекста 	= WebЦвета.Красный;
			Элементы.ДекорацияНадписьРезультатФН.Заголовок 		= НСтр("ru='Проверка не пройдена'");
			ПроверкаКМПройдена									= Ложь;
		КонецЕсли;	
		Если РезультатПроверкиОИСМ И КодОбработкиЗапроса = 0 И СтатусТовара = ПредопределенноеЗначение("Перечисление.ОтветОИСМОСтатусеТовара.ПланируемыйСтатусТовараКорректен") Тогда 
			Элементы.ДекорацияНадписьРезультатОИСМ.ЦветТекста 	= WebЦвета.Зеленый;
			Элементы.ДекорацияНадписьРезультатОИСМ.Заголовок 	= НСтр("ru='Проверка пройдена'");
		ИначеЕсли (НЕ РезультатПроверкиОИСМ) И (НЕ КМПодтвержден) Тогда 
			Элементы.ДекорацияНадписьРезультатОИСМ.ЦветТекста 	= WebЦвета.Оранжевый;
			Элементы.ДекорацияНадписьРезультатОИСМ.Заголовок 	= НСтр("ru='Результат не получен'");	
			ПроверкаКМПройдена									= Ложь;
		ИначеЕсли НЕ РезультатПроверкиОИСМ Тогда 	
			Элементы.ДекорацияНадписьРезультатОИСМ.ЦветТекста 	= WebЦвета.Серый;
			Элементы.ДекорацияНадписьРезультатОИСМ.Заголовок 	= НСтр("ru='Проверка не проводилась'");	
			ПроверкаКМПройдена									= Ложь;
		Иначе
			Элементы.ДекорацияНадписьРезультатОИСМ.ЦветТекста 	= WebЦвета.Красный;
			Элементы.ДекорацияНадписьРезультатОИСМ.Заголовок 	= НСтр("ru='Проверка не пройдена'");	
			ПроверкаКМПройдена									= Ложь;
		КонецЕсли;	
	Иначе
		Элементы.ДекорацияНадписьРезультатФН.ЦветТекста 		= WebЦвета.Серый;
		Элементы.ДекорацияНадписьРезультатОИСМ.ЦветТекста 		= WebЦвета.Серый;
		Элементы.ДекорацияНадписьРезультатФН.Заголовок 			= НСтр("ru='Проверка не проводилась'");	
		Элементы.ДекорацияНадписьРезультатОИСМ.Заголовок 		= НСтр("ru='Проверка не проводилась'");	
		ПроверкаКМПройдена										= Ложь;
	КонецЕсли;
	
	Если КМПодтвержден ИЛИ (НЕ ИспользуетсяККТСПередачейДанных) ИЛИ (ВерсияФФД <> "1.2") Тогда 
		Элементы.Ввод.Заголовок	= НСтр("ru='Закрыть'");	
	КонецЕсли;
	Если НЕ КМПодтвержден Тогда 
		РезультатПроверкиКМ = ПроверкаКМПройдена;
	КонецЕсли;	
	
	Если РезультатПроверкиКМ ИЛИ (НЕ ШтрихКодОтсканирован) ИЛИ (НЕ ИспользуетсяККТСПередачейДанных)  Тогда 
		Элементы.ДекорацияПредупреждениеПокупателю.Заголовок = "";
	Иначе  
		Элементы.ДекорацияПредупреждениеПокупателю.Заголовок = НСтр("ru='Предупредите покупателя об отрицательном результате проверки кода маркировки.'");
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиенте
Процедура ОчиститьСостояниеПроверки()
	
	КодМаркировкиПроверенФН 	= Ложь;
	РезультатПроверкиФН 		= Ложь;
	РезультатПроверкиОИСМ 		= Ложь;
	КодОбработкиЗапроса 		= 0;
	СтатусТовара 				= ПредопределенноеЗначение("Перечисление.ОтветОИСМОСтатусеТовара.ПустаяСсылка");
	ТекстРезультатаПроверкиФН 	= "";
	ТекстРезультатаПроверкиОИСМ = "";
	
КонецПроцедуры	
	
&НаКлиенте
Функция ПолучитьСтруктуруРезультатаПроверки()
	
	ДанныеПроверки = Новый Структура;
	ДанныеПроверки.Вставить("КодМаркировки"									, "");
	ДанныеПроверки.Вставить("РезультатПроверкиКМ"							, Ложь);
	ДанныеПроверки.Вставить("СессияПроверкиКМОткрыта"						, Ложь);
	ДанныеПроверки.Вставить("УдалитьТоварИзСписка"							, Ложь);
	ДанныеПроверки.Вставить("АдресДанныхПроверкиКМ"							, "");
	ДанныеПроверки.Вставить("РазрешительныйРежимДатаЗапросаГИСМТ"			, "");
	ДанныеПроверки.Вставить("РазрешительныйРежимИдентификаторЗапросаГИСМТ"	, "");
	ДанныеПроверки.Вставить("РазрешительныйРежимВерсияБазы"					, "");
	ДанныеПроверки.Вставить("РазрешительныйРежимИдентификаторЭкземпляраПО"	, "");
	ДанныеПроверки.Вставить("ПродажаРазрешена"								, Ложь);
	Возврат ДанныеПроверки;
	
КонецФункции	

&НаКлиенте
Процедура ГруппаСтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСтраницаПодробныйРезультатПроверки Тогда 
		ТекстРезультатаПроверки = ?(ТекстРезультатаПроверкиФН = "", "", НСтр("ru='Проверка ФН:'")) + Символы.ПС + ТекстРезультатаПроверкиФН + 
		Символы.ПС + Символы.ПС + ?(ТекстРезультатаПроверкиОИСМ = "", "", НСтр("ru='Проверка ОИСМ:'")) + Символы.ПС + ТекстРезультатаПроверкиОИСМ;
	КонецЕсли;	
		
КонецПроцедуры
	
&НаКлиенте
Процедура КомандаЗавершениеПодтвержденияКМ(РезультатВыполнения, Параметры) Экспорт 
	
	Если РезультатВыполнения.Результат Тогда
		ДанныеПроверки = ПолучитьСтруктуруРезультатаПроверки();
		ДанныеПроверки.КодМаркировки 								= КодМаркировки;
		ДанныеПроверки.РезультатПроверкиКМ 							= РезультатПроверкиКМ;
		ДанныеПроверки.СессияПроверкиКМОткрыта 						= СессияПроверкиКМОткрыта;
		ДанныеПроверки.УдалитьТоварИзСписка 						= Ложь;
		ДанныеПроверки.АдресДанныхПроверкиКМ						= ПоместитьВоВременноеХранилище(ДанныеПроверкиКМ(), ЭтаФорма.ВладелецФормы.УникальныйИдентификатор);
		ДанныеПроверки.РазрешительныйРежимДатаЗапросаГИСМТ 			= РазрешительныйРежимДатаЗапросаГИСМТ;
		ДанныеПроверки.РазрешительныйРежимИдентификаторЗапросаГИСМТ = РазрешительныйРежимИдентификаторЗапросаГИСМТ;
		ДанныеПроверки.РазрешительныйРежимВерсияБазы 				= РазрешительныйРежимВерсияБазы;
		ДанныеПроверки.РазрешительныйРежимИдентификаторЭкземпляраПО = РазрешительныйРежимИдентификаторЭкземпляраПО;
		ДанныеПроверки.ПродажаРазрешена 							= ПродажаРазрешена;
		ЗакрытьФорму 												= Истина;
		
		ОтключитьОбработчикОжидания("ОжиданиеРезультатовПроверки");
				
		Закрыть(ДанныеПроверки);
	Иначе
		ТекстСообщения = РезультатВыполнения.ОписаниеОшибки;
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры	 

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Отказ = Не ЗакрытьФорму;
	
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	
	ДанныеПроверки = ПолучитьСтруктуруРезультатаПроверки();
	ДанныеПроверки.КодМаркировки 			= "";
	ДанныеПроверки.РезультатПроверкиКМ 		= Ложь;
	ДанныеПроверки.СессияПроверкиКМОткрыта 	= СессияПроверкиКМОткрыта;
	ДанныеПроверки.УдалитьТоварИзСписка 	= Ложь;
	ЗакрытьФорму 							= Истина;
	ОтключитьОбработчикОжидания("ОжиданиеРезультатовПроверки");
	Закрыть(ДанныеПроверки);
	
КонецПроцедуры
	
&НаКлиенте
Функция ДанныеПроверкиКМ()
	
	ДанныеПроверки = Новый Структура;
	ДанныеПроверки.Вставить("КодМаркировкиПроверенФН"		, КодМаркировкиПроверенФН);
	ДанныеПроверки.Вставить("ТекстРезультатаПроверкиФН"		, ТекстРезультатаПроверкиФН);
	ДанныеПроверки.Вставить("РезультатПроверкиФН"			, РезультатПроверкиФН);
	ДанныеПроверки.Вставить("РезультатПроверкиОИСМ"			, РезультатПроверкиОИСМ);
	ДанныеПроверки.Вставить("ТекстРезультатаПроверкиОИСМ"	, ТекстРезультатаПроверкиОИСМ);
	ДанныеПроверки.Вставить("КодОбработкиЗапроса"			, КодОбработкиЗапроса);
	ДанныеПроверки.Вставить("СтатусТовара"					, СтатусТовара);
	ДанныеПроверки.Вставить("УникальныйИдентификаторЗапроса", УникальныйИдентификаторЗапроса);
	Возврат ДанныеПроверки;
	
КонецФункции	
	
&НаКлиенте
Процедура ОжиданиеРезультатовПроверки()
	
	ОповещениеПриЗавершении = Новый ОписаниеОповещения("КомандаВыполнитьЗавершениеКМОИСМ", ЭтотОбъект);
	ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьПолученияРезультатовЗапросаКМ(ОповещениеПриЗавершении, УникальныйИдентификатор, ИдентификаторУстройстваФР, Неопределено);
	
КонецПроцедуры	

&НаКлиенте
Процедура КомандаВыполнитьЗавершениеКМОИСМ(РезультатВыполнения, Параметры) Экспорт
	
	Если РезультатВыполнения.Результат Тогда
		Если РезультатВыполнения.Свойство("КодМаркировкиПроверен") Тогда
			КодМаркировкиПроверенФН 	= РезультатВыполнения.КодМаркировкиПроверен;
			ТекстРезультатаПроверкиФН 	= РезультатВыполнения.РезультатXML;
		КонецЕсли;
		Если РезультатВыполнения.Свойство("РезультатПроверки") Тогда
			РезультатПроверкиФН 		= РезультатВыполнения.РезультатПроверки;
		КонецЕсли;
		Если РезультатВыполнения.Свойство("РезультатПроверкиОИСМ") Тогда
			РезультатПроверкиОИСМ 		= РезультатВыполнения.РезультатПроверкиОИСМ;
			ТекстРезультатаПроверкиОИСМ	= РезультатВыполнения.РезультатXML;
		КонецЕсли;
		Если РезультатВыполнения.Свойство("КодОбработкиЗапроса") Тогда
			КодОбработкиЗапроса 		= РезультатВыполнения.КодОбработкиЗапроса;
		КонецЕсли;
		Если РезультатВыполнения.Свойство("СтатусТовара") Тогда
			СтатусТовара 				= РезультатВыполнения.СтатусТовара;
		КонецЕсли;
	Иначе
		ТекстСообщения = РезультатВыполнения.ОписаниеОшибки;
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
	УстановитьСтатусыПроверки();
	
	Если РезультатВыполнения.Свойство("СтатусРезультата") И (РезультатВыполнения.СтатусРезультата = ПредопределенноеЗначение("Перечисление.СтатусРезультатаЗапросаКМ.Получен") Или
		РезультатВыполнения.СтатусРезультата = ПредопределенноеЗначение("Перечисление.СтатусРезультатаЗапросаКМ.НеМожетБытьПолучен")) Тогда 
		ОтключитьОбработчикОжидания("ОжиданиеРезультатовПроверки");
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура УстановитьДоступностьЭлементовМаркировка()
	
	Если КМПодтвержден Тогда 
		Элементы.КодМаркировки.ТолькоПросмотр = Истина;
	КонецЕсли;	
	
КонецПроцедуры	
	
&НаКлиенте
Процедура КомандаОтказПодтвержденияКМ(РезультатВыполнения, Параметры) Экспорт 
	
	Если РезультатВыполнения.Результат Тогда
		ДанныеПроверки = ПолучитьСтруктуруРезультатаПроверки();
		ДанныеПроверки.СессияПроверкиКМОткрыта 	= СессияПроверкиКМОткрыта;
		ДанныеПроверки.УдалитьТоварИзСписка 	= Истина;
		ЗакрытьФорму 							= Истина;
		ОтключитьОбработчикОжидания("ОжиданиеРезультатовПроверки");
		Закрыть(ДанныеПроверки);
	Иначе
		ТекстСообщения = РезультатВыполнения.ОписаниеОшибки;
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры	
	
&НаКлиенте
Процедура ПроверитьКодМаркировкиИСМП(Штрихкод)  
	
	ДанныеПараметровСканирования = ПараметрыСканирования(); 
	
	ПараметрыПоискаРМК = Новый Структура;  
	ПараметрыДляОбработкиШтрихкода = Новый Структура;
	ШтрихкодОригинальный = Штрихкод;
	ЗаменитьСимволGS1(ШтрихкодОригинальный);
	ПараметрыПоискаРМК.Вставить("ШтрихкодОригинальный", ШтрихкодОригинальный);
	ПараметрыДляОбработкиШтрихкода.Вставить("Штрихкод", ШтрихкодОригинальный);
	ПараметрыПоискаРМК.Вставить("ПараметрыДляОбработкиШтрихкода", ПараметрыДляОбработкиШтрихкода);
	ПараметрыПоискаРМК.Вставить("Номенклатура", НоменклатураСсылка);
	ПараметрыПоискаРМК.Вставить("ВидПродукцииИС", ВидПродукцииИС);
	ПараметрыПоискаРМК.Вставить("Упаковка", "штука");
	
	ДанныеПараметровСканирования.Вставить("ДополнительныеПараметры", Новый Структура("ПараметрыПоискаРМК", ПараметрыПоискаРМК));
	
	ДанныеСоСканера = Новый Структура;
	ДанныеСоСканера.Вставить("Штрихкод"		, Штрихкод);
	ДанныеСоСканера.Вставить("ФорматBase64"	, Ложь);
	ДанныеСоСканера.Вставить("Количество"	, 1); 
	
	ШтрихкодированиеОбщегоНазначенияИСКлиент.ОбработатьДанныеШтрихкода("ПоискПоШтрихкодуЗавершение", ЭтотОбъект, ДанныеСоСканера, ДанныеПараметровСканирования);
	
КонецПроцедуры        

&НаКлиенте
Процедура ПоискПоШтрихкодуЗавершение(ДанныеШтрихкода, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если ДанныеШтрихкода.ОбработанСОшибками Тогда 
		ТекстСообщения = ДанныеШтрихкода.ПримечаниеКРазборуШтрихкода.ТекстОшибки;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		ПродажаРазрешена = Ложь;
		ОбновитьСтатусРР();
		Возврат;	
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ДанныеШтрихкода.ТекстОшибки) Тогда
		ТекстСообщения = ДанныеШтрихкода.ТекстОшибки;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		ПродажаРазрешена = Ложь;
		ОбновитьСтатусРР();
		Возврат;
	КонецЕсли; 
	
	ВидыМаркировкиОффлайнПроверка = ОбщегоНазначенияИСМПВызовСервера.СписокУчитываемойПродукцииТребующейОбязательнойОффлайнПроверкиПриПродажеВРозницуНаДату(ТекущаяДата());
	Если ВидыМаркировкиОффлайнПроверка.Найти(ДанныеШтрихкода.ВидПродукции) <> Неопределено И ДанныеШтрихкода.РазрешительныйРежимИдентификаторЗапросаГИСМТ = "" Тогда  
		ПродажаРазрешена = Ложь;
		ОбновитьСтатусРР();
		Возврат;	
	КонецЕсли;
	
	Если РазрешительныйРежим И ДанныеШтрихкода.РазрешительныйРежимИдентификаторЗапросаГИСМТ = "" Тогда  
		ПродажаРазрешена = Ложь;
		ОбновитьСтатусРР();
		Возврат;	
	КонецЕсли; 
	
	Если РазрешительныйРежим И ДанныеШтрихкода.КонтролиРазрешительногоРежима.Количество() > 0 Тогда 
		ПродажаРазрешена = Ложь;
		ОбновитьСтатусРР();
		Возврат;
	КонецЕсли;
	
	Если РазрешительныйРежим И ЗначениеЗаполнено(ДанныеШтрихкода.РазрешительныйРежимИдентификаторЗапросаГИСМТ) Тогда 
		РазрешительныйРежимДатаЗапросаГИСМТ          	= ДанныеШтрихкода.РазрешительныйРежимДатаЗапросаГИСМТ;
		РазрешительныйРежимИдентификаторЗапросаГИСМТ 	= ДанныеШтрихкода.РазрешительныйРежимИдентификаторЗапросаГИСМТ;
		РазрешительныйРежимВерсияБазы 					= ДанныеШтрихкода.РазрешительныйРежимВерсияБазы;
		РазрешительныйРежимИдентификаторЭкземпляраПО 	= ДанныеШтрихкода.РазрешительныйРежимИдентификаторЭкземпляраПО;
		ПродажаРазрешена 								= Истина;
	КонецЕсли;
	
	ШтрихКодОтсканирован = Истина; 
	ОчиститьСостояниеПроверки();  
	ОбновитьСтатусРР();
	ОтправитьЗапросНаПроверкуКМ(ДанныеШтрихкода);
	
КонецПроцедуры	  

&НаКлиенте
Процедура Подключаемый_ОткрытьФормуУточненияДанных()
	
	ИмяРеквизитаКодМаркировкиДляУточнения 	= "КодМаркировкиДляУточнения";
	ПараметрыЗавершенияВводаШтрихкода       = ОбщегоНазначенияКлиентСервер.СкопироватьРекурсивно(ЭтотОбъект[ИмяРеквизитаКодМаркировкиДляУточнения]);
	ПараметрыЗавершенияВводаШтрихкода.Форма = ЭтотОбъект;
	РезультатОбработкиШтрихкода 			= ПараметрыЗавершенияВводаШтрихкода.РезультатОбработкиШтрихкода;
	ДанныеШтрихкода 						= РезультатОбработкиШтрихкода.ДанныеШтрихкода;
	
	Если РезультатОбработкиШтрихкода.Свойство("ТребуетсяПроверкаРазрешительногоРежимаНаЛокальномМодуле") И
		РезультатОбработкиШтрихкода.ТребуетсяПроверкаРазрешительногоРежимаНаЛокальномМодуле Тогда
		ШтрихкодированиеОбщегоНазначенияИСМПКлиент.ОбработатьАсинхронноШтрихкодНаЛокальномМодулеЧестныйЗнак(ПараметрыЗавершенияВводаШтрихкода);
	ИначеЕсли ДанныеШтрихкода.Свойство("ТребуетсяПроверкаРазрешительногоРежимаНаТСПИоТ") И ДанныеШтрихкода.ТребуетсяПроверкаРазрешительногоРежимаНаТСПИоТ Тогда
		ОписаниеОповещенияПослеПолучения = Новый ОписаниеОповещения("ПослеПроверкиКМПИОТ", ЭтотОбъект);
		ОбработкаЗавершена = ИнтеграцияТСПИоТКлиент.ОбработатьАсинхронноШтрихкод(ПараметрыЗавершенияВводаШтрихкода, ОписаниеОповещенияПослеПолучения);
	Иначе
		ПоискПоШтрихкодуЗавершение(ДанныеШтрихкода);
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура Подключаемый_СообщитьОНевозможностиПодбора()
	
	ИмяРеквизитаКодМаркировкиДляУточнения = "КодМаркировкиДляУточнения";
	
	РезультатОбработкиШтрихкода = ЭтотОбъект[ИмяРеквизитаКодМаркировкиДляУточнения].РезультатОбработкиШтрихкода;
	Если ЗначениеЗаполнено(РезультатОбработкиШтрихкода.ТекстОшибки) Тогда
		
		Сообщить(РезультатОбработкиШтрихкода.ТекстОшибки);
		ПродажаРазрешена = Ложь;
		ОбновитьСтатусРР();
	КонецЕсли;
	
КонецПроцедуры

