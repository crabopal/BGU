
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТекстФайла = Параметры.ТекстФайла;
	БезПространстваИмен = Истина;
	
	Если ЗначениеЗаполнено(Параметры.Заголовок) Тогда
		ЭтотОбъект.Заголовок = Параметры.Заголовок;
		ЭтотОбъект.АвтоЗаголовок = Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекстФайла) Тогда
		Возврат;
	КонецЕсли;
	
	//т.к. это может быть не целостный текст xml, а отрывок, 
	//в котором может не быть всех необходимых для чтения xml, объявления пространства имен, 
	//то на всякий случай просто удалим пространство имен
	
	УдалитьПространствоИмен(ТекстФайла);
	
	Попытка	
		ПрочитатьXMLВТаблицу();
	Исключение
	 	//не удалось прочитать xml в табилцу
	КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура УдалитьПространствоИмен(ТекстФайла)
	
	Пока СтрНайти(ТекстФайла,Символы.Таб)>0 Цикл
		ТекстФайла = СтрЗаменить(ТекстФайла,Символы.Таб,"");
	КонецЦикла;
	
	ПозицияНачала = СтрНайти(ТекстФайла,"<");
	ПозицияОкончания = СтрНайти(ТекстФайла,">");
	
	Инд = 1;
	Пока ПозицияНачала <> 0 И ПозицияОкончания<>0 Цикл
		
		ЧитаемыйБлок = Сред(ТекстФайла,ПозицияНачала,ПозицияОкончания-ПозицияНачала+1);
		ПозицияПространстваИмен = СтрНайти(ЧитаемыйБлок,":");
		Если ПозицияПространстваИмен>0 Тогда
			БлокПространстваИмен = Сред(ЧитаемыйБлок,2,ПозицияПространстваИмен-1);
			Если СтрНайти(БлокПространстваИмен,"""")>0
				ИЛИ СтрНайти(БлокПространстваИмен," ")>0
				ИЛИ СтрНайти(БлокПространстваИмен,"=")>0 Тогда
				//Это не пространство имен
			Иначе
				ТекстФайла = СтрЗаменить(ТекстФайла,БлокПространстваИмен,"");
			КонецЕсли;
		КонецЕсли;
		
		Инд = Инд + 1;
		
		ПозицияНачала = СтрНайти(ТекстФайла,"<",,,Инд);
		ПозицияОкончания = СтрНайти(ТекстФайла,">",,,Инд);	
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьXMLВТаблицу()
	
	ТаблицаПутейИЗначенийФайла.Очистить();
	ЧтениеXML 			= Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ТекстФайла);
	
	ПутьПравилаОбработки = "";
	
	Пока ЧтениеXML.Прочитать() Цикл
		// Обработка узла XML           	
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
	
			ПутьПравилаОбработки = ПутьПравилаОбработки + "/" + ЧтениеXML.Имя;
			ПутьПравилаОбработки_БезИменИАтрибутов = ПолучитьПутьПравилаОбработкиБезПространстваИмен(ПутьПравилаОбработки);
			Если ЧтениеXML.КоличествоАтрибутов() > 0 Тогда
				Пока ЧтениеXML.ПрочитатьАтрибут() Цикл
					
					ПолеСтроки	 = ЧтениеXML.Значение;
					Если БезПространстваИмен = Ложь Тогда
						
						Путь = ПутьПравилаОбработки + "/@" + ЧтениеXML.Имя;
						ДобавитьСтрокуТаблицы(Путь,ПолеСтроки);
						
						
					ИначеЕсли БезПространстваИмен Тогда
						
						Путь = ПутьПравилаОбработки_БезИменИАтрибутов + "/@" + ЧтениеXML.Имя;
						ДобавитьСтрокуТаблицы(Путь,ПолеСтроки);
						
					КонецЕсли;						
				КонецЦикла;
			КонецЕсли;
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда
					
			ПолеСтроки	 = ЧтениеXML.Значение;
			Если БезПространстваИмен = Ложь Тогда
				Путь = ПутьПравилаОбработки;
				ДобавитьСтрокуТаблицы(Путь,ПолеСтроки);
			ИначеЕсли БезПространстваИмен Тогда
				Путь = ПутьПравилаОбработки_БезИменИАтрибутов; 
				ДобавитьСтрокуТаблицы(Путь,ПолеСтроки);			
			КонецЕсли;			
			
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			
			позУзла = Найти(ПутьПравилаОбработки+ "/", "/"+ЧтениеXML.Имя+ "/");
			Если позУзла >= 1 Тогда
				ПутьПравилаОбработки = Лев(ПутьПравилаОбработки, позУзла - 1);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;	
КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокуТаблицы(Путь,Значение)
	
	НовСтр = ТаблицаПутейИЗначенийФайла.Добавить();
	НовСтр.Путь = Путь;
	НовСтр.Значение = Значение;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПутьПравилаОбработкиБезПространстваИмен(Знач ПутьПравилаОбработки) Экспорт
	
	ПутьПравилаОбработки_БезПространстваИмен = "";
	ДлинаПути = СтрДлина(ПутьПравилаОбработки);
	НачатьПроверку = Ложь;
	Для Инд = 1 По ДлинаПути Цикл
		
		ТекСимвол = Сред(ПутьПравилаОбработки,Инд,1);
		
		БлокПоиска = Сред(ПутьПравилаОбработки,Инд);
		
		Если ТекСимвол = "/" Тогда
			НачатьПроверку = Истина;
		ИначеЕсли ТекСимвол = "@" Тогда
			//Это атрибут у которого есть пространство имен. Добавляем признак атрибута.
			Если Найти(БлокПоиска,":")>0 Тогда
				ПутьПравилаОбработки_БезПространстваИмен = ПутьПравилаОбработки_БезПространстваИмен+ТекСимвол;
				Продолжить;
			КонецЕсли;	
		ИначеЕсли ТекСимвол = ":" Тогда
			НачатьПроверку = Ложь;
			Продолжить;
		КонецЕсли;
		
		Если НачатьПроверку Тогда
			
			Если Найти(БлокПоиска,"/")>0 Тогда
				//есть подчиненные узлы
				Если Найти(БлокПоиска,"/")>Найти(БлокПоиска,":") И Найти(БлокПоиска,":")>0 Тогда
					//это пространство имен
					Продолжить;
				КонецЕсли;
			Иначе
				//Это крайний узел
				Если Найти(БлокПоиска,":")>0 Тогда
					//это пространство имен
					Продолжить;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;					
		ПутьПравилаОбработки_БезПространстваИмен = ПутьПравилаОбработки_БезПространстваИмен+ТекСимвол;
		
	КонецЦикла;
	Возврат ПутьПравилаОбработки_БезПространстваИмен;
	
КонецФункции
