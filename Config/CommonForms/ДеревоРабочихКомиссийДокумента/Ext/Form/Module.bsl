#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	КэшФормы = ПолучитьИзВременногоХранилища(Параметры.АдресХранилища);
	
	ПереданноеДеревоКомиссий = КэшФормы.ДеревоАктуальныхКомиссий;
	
	РеквизитДерево = РеквизитФормыВЗначение("Дерево");
	
	ИнвентаризацияСервер.ДополнитьДеревоЗначений(РеквизитДерево, ПереданноеДеревоКомиссий);
	
	ЗначениеВРеквизитФормы(РеквизитДерево, "Дерево");
	
	УстановитьУсловноеОформление();
	
	УстановитьТекущуюСтрокуДерева(РеквизитДерево, Параметры.ТекущаяСтрока);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_Дерево

&НаКлиенте
Процедура ДеревоВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Закрыть(ПолучитьВозвращаемоеЗначение(ВыбраннаяСтрока));
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция ПолучитьВозвращаемоеЗначение(ВыбраннаяСтрока)
	
	ТекДанные = Дерево.НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	ВозвращаемоеЗначение = Новый Структура();
	ВозвращаемоеЗначение.Вставить("НомерКомиссии",			ТекДанные.НомерКомиссии);
	ВозвращаемоеЗначение.Вставить("НомерРабочейКомиссии",	ТекДанные.НомерРабочейКомиссии);
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	//---
	// Выделение жирным шрифтом полей в строке комиссии (основной)
	//---
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Выделение жирным шрифтом полей в строке комиссии (основной)'");
	
	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Дерево.ЭтоРабочаяКомиссия");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Ложь;
	 
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(,,Истина));
	
	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ДеревоНомерКомиссииСтрокой");
	
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ДеревоКомиссия");
	
	
	//---
	// Выделение серым цветом полей комиссии (основной)
	//---
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Выделение серым цветом полей комиссии (основной)'");
	
	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Дерево.ЭтоРабочаяКомиссия");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Ложь;
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
	
	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ДеревоНомерРабочейКомиссииСтрокой");
	
	
	//---
	// Выделение серым цветом полей рабочей комиссии
	//---
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Выделение серым цветом полей рабочей комиссии'");
	
	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Дерево.ЭтоРабочаяКомиссия");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Истина;
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
	
	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ДеревоНомерКомиссииСтрокой");
	
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ДеревоКомиссия");
	
	
	//---
	// Выделение жирным шрифтом полей рабочей комиссии
	//---
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
