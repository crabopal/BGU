
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ Параметры.Свойство("АмортизационныеГруппыПоОКОФ") Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Для Каждого Стр Из Параметры.АмортизационныеГруппыПоОКОФ Цикл
		
		НовСтр = Список.Добавить();
		
		ЗаполнитьЗначенияСвойств(НовСтр, Стр);
		
	КонецЦикла;	
	
	Если Параметры.Свойство("АмортизационнаяГруппа") Тогда 
		
		ТекСтр = Список.НайтиСтроки(Новый Структура("Группа", Параметры.АмортизационнаяГруппа));
		
		Если ТекСтр.Количество() > 0 Тогда
			
			Элементы.Список.ТекущаяСтрока = Список.Индекс(ТекСтр[0]);		
			
		КонецЕсли;	
	
	КонецЕсли;	
	
	Если Параметры.Свойство("ОКОФ") Тогда
		
		ТекстЗапроса =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ОбщероссийскийКлассификаторОсновныхФондов.Код КАК Код,
		|	ОбщероссийскийКлассификаторОсновныхФондов.НаименованиеГруппировки КАК НаименованиеГруппировки
		|ИЗ
		|	Справочник.ОбщероссийскийКлассификаторОсновныхФондов КАК ОбщероссийскийКлассификаторОсновныхФондов
		|ГДЕ
		|	ОбщероссийскийКлассификаторОсновныхФондов.Ссылка = &ОКОФ";
		
		Если ТипЗнч(Параметры.ОКОФ) = Тип("Строка") Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Ссылка = &ОКОФ", "Код = &ОКОФ");
		КонецЕсли;
		
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("ОКОФ", Параметры.ОКОФ);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			
			КодОКОФ = Выборка.Код;
			НаименованиеОКОФ = Выборка.НаименованиеГруппировки;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ПоказатьВсе = 1;							   
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПоказатьВсеПриИзменении(Элемент)
	
	ПоказатьВсеПриИзмененииСервер();
	
КонецПроцедуры


#КонецОбласти

#Область ОбработчикиСобытийТаблицыФормыСписок

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ОбработатьВыбор();

КонецПроцедуры

&НаКлиенте
Процедура СписокВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	
	ОбработатьВыбор();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы


&НаКлиенте
Процедура Выбрать(Команда)
	
	ОбработатьВыбор();
	
КонецПроцедуры


#КонецОбласти

#Область СлужебныеПроцедурыИФункции


&НаКлиенте
Процедура ОбработатьВыбор()
	
	Результат = Элементы.Список.ТекущиеДанные.Группа;
		
	ОповеститьОВыборе(Результат);
	
КонецПроцедуры

&НаСервере
Процедура ПоказатьВсеПриИзмененииСервер();
	
	Если ПоказатьВсе = 1 Тогда 
		
		СтрНеИспользуется = Список.НайтиСтроки(Новый Структура("НеИспользуетсяДляОКОФ", Истина));
		
		Для Каждого Стр Из СтрНеИспользуется Цикл
			
			Список.Удалить(Стр);
			
		КонецЦикла;
		
	ИначеЕсли ПоказатьВсе = 2 Тогда
		
		Запрос = Новый Запрос("ВЫБРАТЬ
		|	АмортизационныеГруппы.Ссылка КАК Группа,
		|	ИСТИНА КАК НеИспользуетсяДляОКОФ,
		|	""Не исползуется для выбранного ОКОФ"" КАК Примечание
		|ИЗ
		|	Перечисление.АмортизационныеГруппы КАК АмортизационныеГруппы
		|ГДЕ
		|	НЕ АмортизационныеГруппы.Ссылка В (&Список)
		|
		|УПОРЯДОЧИТЬ ПО
		|	АмортизационныеГруппы.Порядок");
		
		Запрос.УстановитьПараметр("Список", Список.Выгрузить(, "Группа").ВыгрузитьКолонку("Группа")); 
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			НовСтр = Список.Добавить();
			
			ЗаполнитьЗначенияСвойств(НовСтр, Выборка);
			
		КонецЦикла;	
		
	КонецЕсли;	
	
КонецПроцедуры


#КонецОбласти

