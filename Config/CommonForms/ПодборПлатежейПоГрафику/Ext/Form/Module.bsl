
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ПараметрыПодбора", ПараметрыПодбора);
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ПараметрыПодбора,
		"Организация,ИФО,Контрагент,СчетРасчетов,ЭтоПоступление");
	
	// В зависимости от наличия реквизита "Договор" в шапке документа разный режим подбора.
	Если ПараметрыПодбора.Свойство("Договор") Тогда
		Договор = ПараметрыПодбора.Договор;
		ЕстьДоговорВШапке = ЗначениеЗаполнено(Договор);
	Иначе
		ЕстьДоговорВШапке = Ложь;
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"Договор", "Видимость", ЕстьДоговорВШапке);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ТаблицаДоговор", "Видимость", НЕ ЕстьДоговорВШапке);
	
	// Если валюта явно не указана, считаем "рубли".
	ПараметрыПодбора.Свойство("Валюта", Валюта);
	Если НЕ ЗначениеЗаполнено(Валюта) Тогда
		Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
	КонецЕсли;
	
	// Заполним график по остаткам неоплаченных платежей.
	НеисполненныеПлатежи = Новый ТаблицаЗначений;
	ОтборОстатков = Новый Структура("Контрагент,Валюта");
	ЗаполнитьЗначенияСвойств(ОтборОстатков, ЭтотОбъект);
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") И ПараметрыПодбора.Свойство("ИФО") Тогда
		ОтборОстатков.Вставить("ИФО", ИФО);
	КонецЕсли;
	
	Если ЕстьДоговорВШапке Тогда
		
		ОтборОстатков.Вставить("Договор", Договор);
		
		ВидДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор, "ВидДоговора");
		ВидыДоговоровСПокупателямиДебиторами = КонтрольИсполненияДоговоровКлиентСервер.ВидыДоговоровСПокупателямиДебиторами();
		ВидыДоговоровСПоставщикамиКредиторами = КонтрольИсполненияДоговоровКлиентСервер.ВидыДоговоровСПоставщикамиКредиторами();
		
		Если ВидыДоговоровСПоставщикамиКредиторами.Найти(ВидДоговора) <> Неопределено Тогда
			
			НеисполненныеПлатежи = КонтрольИсполненияДоговоров.НеисполненныеПлатежиПоставщикамКредиторам(
				ОтборОстатков, Организация);
			
		ИначеЕсли ВидыДоговоровСПокупателямиДебиторами.Найти(ВидДоговора) <> Неопределено Тогда
			
			НеисполненныеПлатежи = КонтрольИсполненияДоговоров.НеисполненныеПлатежиОтПокупателейДебиторов(
				ОтборОстатков, Организация);
			
		КонецЕсли;
		
	Иначе // Если нет договора в шапке документа, определяем вид отношений по счету расчетов.
		
		Если БухгалтерскийУчет.СчетВИерархии(СчетРасчетов, "205.00,209.00,207.00") Тогда
			НеисполненныеПлатежи = КонтрольИсполненияДоговоров.НеисполненныеПлатежиОтПокупателейДебиторов(
				ОтборОстатков, Организация);
		Иначе
			НеисполненныеПлатежи = КонтрольИсполненияДоговоров.НеисполненныеПлатежиПоставщикамКредиторам(
				ОтборОстатков, Организация);
		КонецЕсли;
		
	КонецЕсли;
	
	// Дополнительные отборы.
	Отбор = Новый Структура("ЭтоПоступление", ЭтоПоступление);
	ГрафикПлатежей = НеисполненныеПлатежи.Скопировать(Отбор);
	
	Если ГрафикПлатежей.Количество() > 0 Тогда
		Таблица.Загрузить(ГрафикПлатежей);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Оповещение = Новый ОписаниеОповещения("ЗаписатьИЗакрытьЗавершение", ЭтотОбъект);
	ОбщегоНазначенияКлиент.ПоказатьПодтверждениеЗакрытияФормы(Оповещение, Отказ, ЗавершениеРаботы);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	ЗаписатьИЗакрытьЗавершение();
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлажки(Команда)
	
	Для Каждого СтрокаОтбора Из Таблица Цикл
		СтрокаОтбора.Пометка = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажки(Команда)
	
	Для Каждого СтрокаОтбора Из Таблица Цикл
		СтрокаОтбора.Пометка = Ложь;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗаписатьИЗакрытьЗавершение(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если Модифицированность Тогда
		
		Модифицированность = Ложь;
		АдресВХранилище = ПоместитьВыбранныеСтрокиВоВременноеХранилище();
		ОповеститьОВыборе(АдресВХранилище);
		
	Иначе
		
		Закрыть();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПоместитьВыбранныеСтрокиВоВременноеХранилище()
	
	Отбор = Новый Структура("Пометка", Истина);
	АдресВХранилище = ПоместитьВоВременноеХранилище(Таблица.Выгрузить(Отбор), УникальныйИдентификатор);
	
	Возврат АдресВХранилище;
	
КонецФункции

#КонецОбласти
