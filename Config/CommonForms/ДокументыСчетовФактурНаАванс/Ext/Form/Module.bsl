#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗагрузитьПереданныеСведения();
	
	НастроитьФорму();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗавершениеРаботы И (Модифицированность Или ПеренестиВДокумент) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Модифицированность И Не ПеренестиВДокумент Тогда
		Отказ = Истина;
		ТекстВопроса = НСтр("ru='Данные были изменены. Сохранить изменения?'");
		Оповещение = Новый ОписаниеОповещения("ВопросПеренестиВДокументЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена);
	КонецЕсли;
	
	Если ПеренестиВДокумент И Не Отказ Тогда
		Отказ = Не ПроверитьЗаполнение();
	КонецЕсли;
	
	Если Отказ Тогда
		ПеренестиВДокумент = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	
	Если ПеренестиВДокумент Тогда
		ВозвращаемоеЗначение = ПолучитьВозвращаемоеЗначение();
		ОповеститьОВыборе(ВозвращаемоеЗначение);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	ПроверяемыеРеквизиты.Очистить();
	
	НомерСтроки = 0;
	
	Для Каждого СтрокаТаблицы Из СчетаФактурыНаАванс Цикл
		НомерСтроки = НомерСтроки + 1;
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.Дата) Тогда
			СообщитьОНезаполненнойДате(НомерСтроки, Отказ);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.Номер) Тогда
			СообщитьОНезаполненномНомере(НомерСтроки, Отказ);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.СчетФактура) Тогда
			Если СтрокаТаблицы.СчетФактура = Параметры.СчетФактура Тогда
				СообщитьОЦиклическойСсылке(НомерСтроки, Отказ);
			КонецЕсли;
			
			Если ТипЗнч(СтрокаТаблицы.СчетФактура) = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный") Тогда
				Если Не ЗначениеЗаполнено(СтрокаТаблицы.ДатаИсправления) Тогда
					СообщитьОНезаполненнойДатеИсправления(НомерСтроки, Отказ);
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(СтрокаТаблицы.НомерИсправления) Тогда
					СообщитьОНезаполненномНомереИсправления(НомерСтроки, Отказ);
				КонецЕсли;
			КонецЕсли;
		Иначе
			Если ЗначениеЗаполнено(СтрокаТаблицы.НомерИсправления) И Не ЗначениеЗаполнено(СтрокаТаблицы.ДатаИсправления) Тогда
				СообщитьОНезаполненнойДатеИсправления(НомерСтроки, Отказ);
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(СтрокаТаблицы.НомерИсправления) И ЗначениеЗаполнено(СтрокаТаблицы.ДатаИсправления) Тогда
				СообщитьОНезаполненномНомереИсправления(НомерСтроки, Отказ);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СообщитьОНезаполненнойДате(НомерСтроки, Отказ)
	
	ОбщегоНазначения.СообщитьПользователю(
		СтрШаблон(НСтр("ru = 'В строке %1 не заполнена дата счета-фактуры.'"), НомерСтроки),
		,
		ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СчетаФактурыНаАванс", НомерСтроки, "Дата"),
		,
		Отказ);
	
КонецПроцедуры

&НаСервере
Процедура СообщитьОНезаполненномНомере(НомерСтроки, Отказ)
	
	ОбщегоНазначения.СообщитьПользователю(
		СтрШаблон(НСтр("ru = 'В строке %1 не заполнен номер счета-фактуры.'"), НомерСтроки),
		,
		ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СчетаФактурыНаАванс", НомерСтроки, "Номер"),
		,
		Отказ);
	
КонецПроцедуры

&НаСервере
Процедура СообщитьОНезаполненнойДатеИсправления(НомерСтроки, Отказ)
	
	ОбщегоНазначения.СообщитьПользователю(
		СтрШаблон(НСтр("ru = 'В строке %1 не заполнена дата исправления.'"), НомерСтроки),
		,
		ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СчетаФактурыНаАванс", НомерСтроки, "ДатаИсправления"),
		,
		Отказ);
	
КонецПроцедуры

&НаСервере
Процедура СообщитьОЦиклическойСсылке(НомерСтроки, Отказ)
	
	ОбщегоНазначения.СообщитьПользователю(
		СтрШаблон(НСтр("ru = 'В строке %1 обнаружена ссылка на редактируемый документ счета-фактуры.'"), НомерСтроки),
		,
		ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СчетаФактурыНаАванс", НомерСтроки, "СчетФактура"),
		,
		Отказ);
	
КонецПроцедуры

&НаСервере
Процедура СообщитьОНезаполненномНомереИсправления(НомерСтроки, Отказ)
	
	ОбщегоНазначения.СообщитьПользователю(
		СтрШаблон(НСтр("ru = 'В строке %1 не заполнен номер исправления.'"), НомерСтроки),
		,
		ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СчетаФактурыНаАванс", НомерСтроки, "НомерИсправления"),
		,
		Отказ);
		
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_СчетаФактурыНаАванс

&НаКлиенте
Процедура СчетаФактурыНаАвансПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока И Не Копирование Тогда
		ТекДанные = Элементы.СчетаФактурыНаАванс.ТекущиеДанные;
		
		ЗаполнитьСлужебныеКолонкиВСтрокеТаблицы(ТекДанные);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СчетаФактурыНаАвансСчетФактураПриИзменении(Элемент)
	
	ТекДанные = Элементы.СчетаФактурыНаАванс.ТекущиеДанные;
	
	СведенияСФ = ПрочитатьСведенияСФ(ТекДанные.СчетФактура);
	
	ЗаполнитьЗначенияСвойств(ТекДанные, СведенияСФ);
	
	ЗаполнитьСлужебныеКолонкиВСтрокеТаблицы(ТекДанные);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Заполнить(Команда)
	
	ПодтвердитьИЗаполнить();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаписатьИЗакрыть(Команда)
	
	ПеренестиВДокумент = Истина;
	
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОтмена(Команда)
	
	Модифицированность = Ложь;
	
	Закрыть();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗагрузитьПереданныеСведения()
	
	АдресТаблицДокумента = Параметры.АдресТаблицДокумента;
	
	ТаблицыДокумента = ПолучитьИзВременногоХранилища(АдресТаблицДокумента);
	
	СчетаФактурыНаАванс.Загрузить(ТаблицыДокумента.СчетаФактурыНаАванс);
	
	Если Не ЗначениеЗаполнено(ТаблицыДокумента.Отбор.НаДату) Тогда
		ТаблицыДокумента.Отбор.НаДату = ТекущаяДатаСеанса();
	КонецЕсли;
	
	ПереданныйОтбор = Новый ФиксированнаяСтруктура(ТаблицыДокумента.Отбор);
	
	ЗаполнитьСлужебныеКолонки();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСлужебныеКолонкиВСтрокеТаблицы(СтрокаТаблицы)
	
	СтрокаТаблицы.ДоступноИсправление = ДоступноИсправление(СтрокаТаблицы.СчетФактура);
	СтрокаТаблицы.ЭтоИСФ = ЭтоИСФ(СтрокаТаблицы.СчетФактура);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСлужебныеКолонки()
	
	Для Каждого СтрокаТаблицы Из СчетаФактурыНаАванс Цикл
		СтрокаТаблицы.ДоступноИсправление = ДоступноИсправление(СтрокаТаблицы.СчетФактура);
		СтрокаТаблицы.ЭтоИСФ = ЭтоИСФ(СтрокаТаблицы.СчетФактура);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ДоступноИсправление(СчетФактура)
	
	Возврат ?(ЗначениеЗаполнено(СчетФактура),
		ТипЗнч(СчетФактура) = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный"),
		Истина);
		
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоИСФ(СчетФактура)
	
	Возврат ТипЗнч(СчетФактура) = ЗначениеЗаполнено(СчетФактура) И Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный");
	
КонецФункции

&НаСервере
Процедура НастроитьФорму()
	
	ДоступноРедактирование = ПравоДоступа("Изменение", Параметры.СчетФактура.Метаданные());
	
	ЭтотОбъект.ТолькоПросмотр = Не ДоступноРедактирование;
	
	Элементы.ФормаКомандаЗаписатьИЗакрыть.Доступность = ДоступноРедактирование;
	
	УстановитьПараметрыВыбораСчетаФактуры();
	
	УстановитьУсловноеОформление();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПараметрыВыбораСчетаФактуры()
	
	МассивПараметров = Новый Массив();
	
	НовыйПараметр = Новый ПараметрВыбора("Отбор.Организация", ПереданныйОтбор.Организация);
	МассивПараметров.Добавить(НовыйПараметр);
	
	НовыйПараметр = Новый ПараметрВыбора("Отбор.Контрагент", ПереданныйОтбор.СписокКонтрагентов);
	МассивПараметров.Добавить(НовыйПараметр);
	
	НовыйПараметр = Новый ПараметрВыбора("Отбор.Договор", ПереданныйОтбор.СписокДоговоров);
	МассивПараметров.Добавить(НовыйПараметр);
	
	НовыйПараметр = Новый ПараметрВыбора("Отбор.Проведен", Истина);
	МассивПараметров.Добавить(НовыйПараметр);
	
	НовыйПараметр = Новый ПараметрВыбора("Отбор.ПричинаНалогообложения", Перечисления.ПричиныНалогообложенияНДС.АвансПолученный);
	МассивПараметров.Добавить(НовыйПараметр);
	
	Элементы.СчетаФактурыНаАвансСчетФактура.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметров);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	ДобавитьУсловноеОформление_НедоступныНомерИДатаИсправления();
	
	ДобавитьУсловноеОформление_УстановкаОтметкиНезаполненногоНомераИДатаИсправления();
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьУсловноеОформление_НедоступныНомерИДатаИсправления()
	
	ИмяТЧ = "СчетаФактурыНаАванс";
	
	ИменаПолей = Новый Массив();
	ИменаПолей.Добавить("ДатаИсправления");
	ИменаПолей.Добавить("НомерИсправления");
	
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		НовыйЭлементУО = УсловноеОформление.Элементы.Добавить();
		НовыйЭлементУО.Представление = СтрШаблон(НСтр("ru='Недоступно поле %1 для обычного счета-фактуры'"), ИмяПоля);
		
		// Условие
		Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяТЧ + ".ДоступноИсправление");
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Условие.ПравоеЗначение = Ложь;
		
		Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяТЧ + "." + ИмяПоля);
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
		
		// Оформление
		НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
		НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
		НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветНедоступноеПоле);
		НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru='х'"));
		
		// Оформляемые поля
		ОформляемоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТЧ + ИмяПоля);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьУсловноеОформление_УстановкаОтметкиНезаполненногоНомераИДатаИсправления()
	
	ИмяТЧ = "СчетаФактурыНаАванс";
	
	ИменаПолей = Новый Массив();
	ИменаПолей.Добавить("ДатаИсправления");
	ИменаПолей.Добавить("НомерИсправления");
	
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		НовыйЭлементУО = УсловноеОформление.Элементы.Добавить();
		НовыйЭлементУО.Представление = СтрШаблон(НСтр("ru='Обязательное заполнение поля %1'"), ИмяПоля);
		
		// Условие
		Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяТЧ + ".ЭтоИСФ");
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Условие.ПравоеЗначение = Истина;
		
		Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяТЧ + "." + ИмяПоля);
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
		
		// Оформление
		НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Истина);
		
		// Оформляемые поля
		ОформляемоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТЧ + ИмяПоля);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьИЗаполнить()
	
	Если СчетаФактурыНаАванс.Количество() > 0 Тогда
		ТекстВопроса = НСтр("ru='Перед автоматическим заполнением таблица будет очищена.
			|
			|Продолжить и заполнить таблицу?'");
		
		Оповещение = Новый ОписаниеОповещения("ПодтвердитьИЗаполнитьЗавершение", ЭтотОбъект);
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
		Возврат;
	КонецЕсли;
	
	ЗаполнитьКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьИЗаполнитьЗавершение(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = КодВозвратаДиалога.Да Тогда
		ЗаполнитьКлиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКлиент()
	
	ЗаполнитьСервер();
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСервер()
	
	Отбор = УчетНДС.НовыйОтборОстаткиВходящийНДСАвансыПолученные();
	
	ЗаполнитьЗначенияСвойств(Отбор, ПереданныйОтбор);
	
	ТаблицаДокументов = УчетНДС.ПолучитьТаблицуДокументовСчетовФактурНаАванс(Отбор);
	
	СчетаФактурыНаАванс.Загрузить(ТаблицаДокументов);
	
	ЗаполнитьСлужебныеКолонки();
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросПеренестиВДокументЗавершение(ОтветНаВопрос, ДополнительныеПараметры) Экспорт
	
	Если ОтветНаВопрос = КодВозвратаДиалога.Да Тогда
		ПеренестиВДокумент = Истина;
		Закрыть();
		
	ИначеЕсли ОтветНаВопрос = КодВозвратаДиалога.Нет Тогда
		Модифицированность = Ложь;
		ПеренестиВДокумент = Ложь;
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьВозвращаемоеЗначение()
	
	ВозвращаемоеЗначение = Новый Структура();
	
	Если ПеренестиВДокумент Тогда
		ТаблицаСчетаФактурыНаАванс = СчетаФактурыНаАванс.Выгрузить();
		
		АдресТаблицыСчетаФактурыНаАванс = ПоместитьВоВременноеХранилище(ТаблицаСчетаФактурыНаАванс, УникальныйИдентификатор);
		
		ВозвращаемоеЗначение.Вставить("АдресТаблицыСчетаФактурыНаАванс", АдресТаблицыСчетаФактурыНаАванс);
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПрочитатьСведенияСФ(СчетФактура)
	
	СведенияСФ = Новый Структура("
		|Номер,
		|Дата,
		|НомерИсправления,
		|ДатаИсправления");
	
	Если Не ЗначениеЗаполнено(СчетФактура) Тогда
		Возврат СведенияСФ;
	КонецЕсли;
	
	Если ТипЗнч(СчетФактура) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СчетФактура, "Дата,Номер");
		
		СведенияСФ.Дата = ЗначенияРеквизитов.Дата;
		СведенияСФ.Номер = РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
			СчетФактура, ЗначенияРеквизитов.Номер);
		
		Возврат СведенияСФ;
	КонецЕсли;
	
	Если ТипЗнч(СчетФактура) = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный") Тогда
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СчетФактура, "ИсправляемыйДокумент,ДатаИсправления,НомерИсправления");
		
		ЗаполнитьЗначенияСвойств(СведенияСФ, ЗначенияРеквизитов, "НомерИсправления,ДатаИсправления");
		
		ИсправляемыйДокумент = ЗначенияРеквизитов.ИсправляемыйДокумент;
		
		Если ЗначениеЗаполнено(ИсправляемыйДокумент) Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ИсправляемыйДокумент, "Дата,Номер");
			
			СведенияСФ.Дата = ЗначенияРеквизитов.Дата;
			СведенияСФ.Номер = РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
				ИсправляемыйДокумент, ЗначенияРеквизитов.Номер);
		КонецЕсли;
	КонецЕсли;
	
	Возврат СведенияСФ;
	
КонецФункции

#КонецОбласти

