&НаКлиенте
Процедура Установить(Команда)
	
	Если НЕ ЗначениеЗаполнено(Статус) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Необходимо указать статус документа.'"),,"Статус");
		Возврат;
	КонецЕсли;
	
	РезультатКонтроля = ВыполнитьКонтрольВедомостиПеречисленийНаСервере(ПлатежноРасчетныйДокумент, Статус);
	Если РезультатКонтроля.Свойство("НеЗаписыватьСтатус") И РезультатКонтроля.НеЗаписыватьСтатус Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Есть ошибки по результатам контроля документа. Выбранный статус не может быть установлен.'"), , "Статус");
		Возврат;
	КонецЕсли;
	
	Отказ = Ложь;
	Адрес = Неопределено;
	НеЗаписыватьСтатус = Ложь;
	Если ЕстьПревышенияПоКонтролюОбязательств(ПлатежноРасчетныйДокумент,Статус,НеЗаписыватьСтатус,Адрес,Отказ) Тогда
		
		Если НеЗаписыватьСтатус Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Есть ошибки по результатам контроля документа. Выбранный статус не может быть установлен.'"),,"Статус");
		КонецЕсли;
		
		ОткрытьФорму("Справочник.НастройкиКонтроляОбязательств.Форма.ФормаРезультатовПроверки", Новый Структура("Адрес, ПредставлениеДокумента", Адрес, ПлатежноРасчетныйДокумент));
		
		Если НеЗаписыватьСтатус Тогда
			Возврат;
		КонецЕсли;
		
		Отказ = Ложь;
		
	КонецЕсли;
	
	РеквизитыРегистрации = РеквизитыРегистрацииДокумента(ЭтотОбъект);
	
	Если ПлатежноРасчетныйДокумент.Пустая() Тогда
		РеквизитыРегистрации.Вставить("ЗаписатьВДокументе", Истина);
	ИначеЕсли ЗаписатьСведенияВРегистр() Тогда 
		ОповеститьОбИзменении(ПлатежноРасчетныйДокумент);
	Иначе
		Отказ = Истина;
	КонецЕсли;
	
	Если НЕ Отказ Тогда
		Оповестить("ИзмененСтатус_ПлатежноРасчетныйДокумент", РеквизитыРегистрации, ПлатежноРасчетныйДокумент);
	КонецЕсли;
	
	Если ЗакрытьПослеЗаписи Тогда
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция ПолучитьРабочуюДату() 
	
	ЗначенияНастроек = Новый Структура("РабочаяДата");	
	ЗаполнениеРеквизитовОбъектов.ПолучитьЗначенияНастроекПользователя(Пользователи.АвторизованныйПользователь(), ЗначенияНастроек);
	
	Возврат ЗначенияНастроек.РабочаяДата;
	
КонецФункции	

&НаКлиенте
Процедура ОбновитьКурсВалюты()
	
	Если НЕ ЗначениеЗаполнено(Валюта) ИЛИ Валюта = БухгалтерскийУчетВызовСервераПовтИсп.ВалютаРегламентированногоУчета() Тогда
		Возврат;
	КонецЕсли;
	
	КурсКратность = БухгалтерскиеОперацииВызовСервера.ПолучитьКурсВалюты(Валюта, ДатаПроведения);
	
	Если КурсКратность.Курс <> Курс Тогда
		Курс = КурсКратность.Курс;
		БухгалтерскиеОперацииКлиент.ПоказатьОповещениеПриИзмененииКурсаВалюты(Истина, Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция РеквизитыРегистрацииДокумента(Форма)

	РеквизитыРегистрации = Новый Структура();
	// Общая часть для всех документов
	РеквизитыРегистрации.Вставить("ПлатежноРасчетныйДокумент", 			Форма.ПлатежноРасчетныйДокумент);
	РеквизитыРегистрации.Вставить("ДатаПроведения", 					Форма.ДатаПроведения);
	РеквизитыРегистрации.Вставить("Статус", 							Форма.Статус);
	РеквизитыРегистрации.Вставить("GUIDКО", 							Форма.GUIDКО);
	РеквизитыРегистрации.Вставить("ПервичныйОбразИРеквизиты", 			Форма.ПервичныйОбраз);
	
	//  Часть значимая для документов казначейства
	РеквизитыРегистрации.Вставить("НомерЗаявки", 						Форма.НомерЗаявки);
	РеквизитыРегистрации.Вставить("ДатаРегистрации", 					Форма.ДатаРегистрации);
	РеквизитыРегистрации.Вставить("ОтветственныйИсполнительДолжность", 	Форма.ОтветственныйИсполнительДолжность);
	РеквизитыРегистрации.Вставить("ОтветственныйИсполнительФИО", 		Форма.ОтветственныйИсполнительФИО);
	РеквизитыРегистрации.Вставить("ОтветственныйИсполнительТелефон", 	Форма.ОтветственныйИсполнительТелефон);
	РеквизитыРегистрации.Вставить("НомерОбязательства", 				Форма.НомерОбязательства);
	РеквизитыРегистрации.Вставить("ВидПодтверждающегоДокумента", 		Форма.ВидПодтверждающегоДокумента);
	РеквизитыРегистрации.Вставить("НомерПодтверждающегоДокумента", 		Форма.НомерПодтверждающегоДокумента);
	РеквизитыРегистрации.Вставить("ДатаПодтверждающегоДокумента", 		Форма.ДатаПодтверждающегоДокумента);
	РеквизитыРегистрации.Вставить("Курс", 								Форма.Курс);
	РеквизитыРегистрации.Вставить("КомментарийОбработки", 				Форма.КомментарийОбработки);  
	
	Возврат РеквизитыРегистрации;

КонецФункции // РеквизитыРегистрацииДокумента()

&НаСервере
Процедура ИзменитьСтатусДокумента()
	
	Если Статус = Перечисления.СтатусыИсполненияДокумента.Аннулирован И НЕ ИзменятьАннулированные Тогда
		Этаформа.Доступность = Ложь;
		Возврат;
	КонецЕсли;
	
	Если Оплачено Тогда
		Статус = Перечисления.СтатусыИсполненияДокумента.Исполнен;
	ИначеЕсли ЗначениеЗаполнено(НомерЗаявки) Тогда
		Статус = Перечисления.СтатусыИсполненияДокумента.НаИсполнении;
	ИначеЕсли Не ЗначениеЗаполнено(Статус) Тогда
		Статус = Перечисления.СтатусыИсполненияДокумента.ВРаботе;
	КонецЕсли;	
	
КонецПРоцедуры	

&НаСервере
Функция ЗаписатьСведенияВРегистр()
	Возврат ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(РеквизитыРегистрацииДокумента(ЭтотОбъект));
КонецФункции	

&НаСервереБезКонтекста
Функция ВыполнитьКонтрольВедомостиПеречисленийНаСервере(Знач ПлатежноРасчетныйДокумент, Знач Статус)
	
	РезультатКонтроля = Новый Структура;
	Если Статус = Перечисления.СтатусыИсполненияДокумента.ВРаботе
		Или Не ЗначениеЗаполнено(ПлатежноРасчетныйДокумент) Тогда
		Возврат РезультатКонтроля;
	КонецЕсли;
	
	ТипыДокументов = Новый Соответствие;
	ТипыДокументов.Вставить(Тип("ДокументСсылка.ЗаявкаНаКассовыйРасходСокращенная"), Истина);
	ТипыДокументов.Вставить(Тип("ДокументСсылка.ЗаявкаНаКассовыйРасход"), Истина);
	ТипыДокументов.Вставить(Тип("ДокументСсылка.ПлатежноеПоручение"), Истина);
	ТипыДокументов.Вставить(Тип("ДокументСсылка.КассовоеВыбытие"), Истина);
	ТипыДокументов.Вставить(Тип("ДокументСсылка.РСКППеречисление"), Истина);
	 
	Если ТипыДокументов[ТипЗнч(ПлатежноРасчетныйДокумент)] = Неопределено Тогда
		Возврат РезультатКонтроля;
	КонецЕсли;
	
	ДокументОснование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПлатежноРасчетныйДокумент, "ДокументОснование");
	
	Если Не ЗначениеЗаполнено(ДокументОснование) Тогда
		Возврат РезультатКонтроля;
	КонецЕсли;
	
	ПроверкаНеПройдена = Ложь;

	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ВедомостьНаВыплатуВБанк")
		Или ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ВедомостьКомпенсацииРодительскойПлатыКВыплате") Тогда
		
		ПлатежноРасчетныеДокументы.ПроверитьПлатежныйДокументНаСоответствиеВедомости(
			ДокументОснование, ПлатежноРасчетныйДокумент, ПроверкаНеПройдена);
		
	КонецЕсли;

	Если ПроверкаНеПройдена Тогда
		РезультатКонтроля.Вставить("НеЗаписыватьСтатус", Истина);
	КонецЕсли;
	
	Возврат РезультатКонтроля;
	
КонецФункции

&НаСервереБезКонтекста
Функция СостояниеКонтроля()
	Возврат Константы.КонтрольОбязательств.Получить();
КонецФункции

&НаСервереБезКонтекста
Функция КонтрольДокументаПоОбязательствамСервер(Документ ,Адрес, Отказ)
	
	КонтрольРасходов.Контроль(Документ.ПолучитьОбъект(), Отказ,, Истина, Адрес, Ложь);
	
	Если ЗначениеЗаполнено(Адрес) Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЕстьПревышенияПоКонтролюОбязательств(Документ ,Статус, НеЗаписывать, Адрес, Отказ)
	
	СтатусДляПроверки = Статус = ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДокумента.НаИсполнении") Или
						Статус = ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДокумента.Подготовлен") Или
						Статус = ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДокумента.Исполнен"); 
						
	Если СтатусДляПроверки И Не Документ.Пустая() И СостояниеКонтроля() Тогда
		Если КонтрольДокументаПоОбязательствамСервер(Документ ,Адрес, Отказ) Тогда
			
			Если Константы.ДействияПриКонтроле.Получить() = Перечисления.ДействияПриКонтролеОбязательств.ПредупреждатьНеЗаписывать Тогда
				НеЗаписывать = Истина;
			Иначе
				НеЗаписывать = Ложь;
			КонецЕсли;
			
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	Иначе
		Возврат Ложь;
	КонецЕсли;
			
