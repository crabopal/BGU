

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПлатежноРасчетныйДокумент 		= Параметры.ПлатежноРасчетныйДокумент;
	ДатаПлатежноРасчетногоДокумента = Параметры.ДатаПлатежноРасчетногоДокумента;
	ЕстьДвиженияРБ					= БухгалтерскийУчет.ЕстьДвиженияДокументаПоРегиструБухгалтерии(ПлатежноРасчетныйДокумент);
	
	Если НЕ ТипЗнч(Параметры.РеквизитыРегистрации) = Тип("Структура") Тогда
		РеквизитыРегистрации 	= ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(ПлатежноРасчетныйДокумент);
	Иначе
		РеквизитыРегистрации 	= Параметры.РеквизитыРегистрации;
	Конецесли;
	
	Если Параметры.БлокироватьВладельца Тогда
		РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
		Элементы.ФормаУстановить.Заголовок = "Записать и закрыть";
		ЗакрытьПослеЗаписи = Истина;
	КонецЕсли;
	
	ДатаПроведения 						= РеквизитыРегистрации.ДатаПроведения;
	НомерЗаявки 						= РеквизитыРегистрации.НомерЗаявки;
	ДатаРегистрации						= РеквизитыРегистрации.ДатаРегистрации;
	ОтветственныйИсполнительДолжность 	= РеквизитыРегистрации.ОтветственныйИсполнительДолжность;
	ОтветственныйИсполнительФИО 		= РеквизитыРегистрации.ОтветственныйИсполнительФИО;
	ОтветственныйИсполнительТелефон 	= РеквизитыРегистрации.ОтветственныйИсполнительТелефон;
	ДатаПодтверждающегоДокумента 		= РеквизитыРегистрации.ДатаПодтверждающегоДокумента;
	НомерПодтверждающегоДокумента		= РеквизитыРегистрации.НомерПодтверждающегоДокумента;
	ВидПодтверждающегоДокумента 		= РеквизитыРегистрации.ВидПодтверждающегоДокумента;
	НомерОбязательства					= РеквизитыРегистрации.НомерОбязательства;
	Статус								= РеквизитыРегистрации.Статус;
	GUIDКО								= РеквизитыРегистрации.GUIDКО;
	Курс 								= РеквизитыРегистрации.Курс;
	КомментарийОбработки                = РеквизитыРегистрации.КомментарийОбработки;
	
	ПервичныйОбраз = Неопределено;
	Если ТипЗНЧ(РеквизитыРегистрации.ПервичныйОбразИРеквизиты) = Тип("ХранилищеЗначения") Тогда
		ПервичныйОбраз = ?(ЗначениеЗаполнено(РеквизитыРегистрации.ПервичныйОбразИРеквизиты.Получить()), РеквизитыРегистрации.ПервичныйОбразИРеквизиты, Неопределено);
	КонецЕсли;
	
	Элементы.РегистрСведенийСостояниеПлатежноРасчетныхДокументовПечатьПервичногоОбраза.Видимость = НЕ ПервичныйОбраз = НЕОПРЕДЕЛЕНО;
	
	Оплачено = ДатаПроведения <> Дата("00010101");
	
	ТипДокумента = ТипЗнч(ПлатежноРасчетныйДокумент);
	
	Если ТипДокумента = Тип("ДокументСсылка.ПлатежноеПоручение") 
		ИЛИ ТипДокумента = Тип("ДокументСсылка.РасшифровкаВнесенныхЧерезБанкоматСредств")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.ПоручениеНаПокупкуВалюты")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.ПоручениеНаПродажуВалюты") 
		ИЛИ ТипДокумента = Тип("ДокументСсылка.ЗаявкаНаСдачуПолучениеНаличных") Тогда
		Элементы.НомерОбязательства.Видимость 			= Ложь;
		Элементы.ГруппаНомерДатаЗаявки.Видимость	 	= Ложь;
		Элементы.ГруппаОтветственный.Видимость 			= Ложь;
		Элементы.ГруппаСведенияВыплатахВалюта.Видимость = Ложь;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.КассовоеПоступление")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.КассовоеВыбытие") Тогда
		Элементы.НомерОбязательства.Видимость 			= Ложь;
		Элементы.ГруппаНомерДатаЗаявки.Видимость	 	= Ложь;
		Элементы.ГруппаОтветственный.Видимость 			= Ложь;
		Элементы.ГруппаСведенияВыплатах.Видимость		= Ложь;
		Элементы.Статус.Видимость						= Ложь;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ЗапросНаВыяснениеПринадлежностиПлатежа")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.ЗаявлениеНаВыдачуКазначейскогоАккредитива") тогда
		Элементы.НомерОбязательства.Видимость 			= Ложь;
		Элементы.ГруппаНомерДатаЗаявки.Видимость	 	= Ложь;
		Элементы.ГруппаСведенияВыплатах.Видимость		= Ложь;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.РасходноеРасписание") Тогда
		Элементы.ГруппаНомерДатаЗаявки.Видимость		= Ложь;
		Элементы.ГруппаОтветственный.Видимость			= Ложь;
		Элементы.ГруппаСведенияВыплатах.Видимость		= Ложь;
		Элементы.ГруппаПодтверждающийДокумент.Видимость = Ложь;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ЗапросУНИФО") 
		ИЛИ ТипДокумента = Тип("ДокументСсылка.КаталогГосУслуг")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.КвитанцияНаОплатуГосуслуг")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.НачислениеОтПодведомственного")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.УведомлениеОВозвратеГИСГМП")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.УведомлениеОВозвратеГИСГМПОтПодведомственного")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.НачислениеОтПосредникаГИСГМП") Тогда
		Элементы.НомерОбязательства.Видимость 			= ложь;
		Элементы.ГруппаНомерДатаЗаявки.Видимость 		= ложь;
		Элементы.ГруппаОтветственный.Видимость 			= ложь;
		Элементы.ГруппаПодтверждающийДокумент.Видимость = Ложь;
		Элементы.ГруппаСведенияВыплатах.Видимость 		= Ложь;
		Элементы.GUIDКО.Видимость 						= Ложь;
		ИзменятьАннулированные 							= Истина;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ПлатежноеТребование")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.ИнкассовоеПоручение")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.Аккредитив")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.ЗаявлениеОбОтказеОтАкцепта") Тогда
		Элементы.РеквизитыРегистрации.Видимость = Ложь;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ВыпискаИзЛицевогоСчета") 
		ИЛИ ТипДокумента = Тип("ДокументСсылка.ВыпискаИзЛицевогоСчетаУчреждения") Тогда
		Элементы.НомерОбязательства.Видимость 			= Ложь;
		Элементы.ГруппаНомерДатаЗаявки.Видимость 		= Ложь;
		Элементы.ГруппаСведенияВыплатах.Видимость 		= Ложь;
		Элементы.ГруппаПодтверждающийДокумент.Видимость = Ложь;
		Элементы.GUIDКО.Видимость 						= Ложь;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ЗаявкаНаКассовыйРасход") Тогда
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Параметры, "ВалютаДокумента") Тогда
			Валюта = Параметры.ВалютаДокумента;
			Договор = Параметры.Договор;
		Иначе
			СвойстваЗаявки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПлатежноРасчетныйДокумент, "ВалютаДокумента, Договор");
			Валюта = СвойстваЗаявки.ВалютаДокумента;
			Договор = СвойстваЗаявки.Договор;
		КонецЕсли;
		Элементы.ГруппаСведенияВыплатахВалюта.Видимость = Валюта <> БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета()
			И НЕ РаботаСОбязательствами.СведенияОВалютеОбязательства(Договор).ОплатаВРублях;  
	// Изменено РСКП	
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.РСКППеречисление") Тогда
		 Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Параметры, "ВалютаДокумента") Тогда
			Валюта = Параметры.ВалютаДокумента;
			Договор = Параметры.Договор;
		Иначе
			СвойстваЗаявки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПлатежноРасчетныйДокумент, "ВалютаДокумента, Договор");
			Валюта = СвойстваЗаявки.ВалютаДокумента;
			Договор = СвойстваЗаявки.Договор;
		КонецЕсли;
		Элементы.ГруппаСведенияВыплатахВалюта.Видимость = Валюта <> БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета()
			И НЕ РаботаСОбязательствами.СведенияОВалютеОбязательства(Договор).ОплатаВРублях;  
			
		Элементы.НомерОбязательства.Видимость 		= Ложь;
		Элементы.ГруппаНомерДатаЗаявки.Видимость 	= Ложь;
		Элементы.ГруппаОтветственный.Видимость 		= Ложь;
		Элементы.GUIDКО.Видимость 					= Ложь; 
		Элементы.ГруппаПодтверждающийДокумент.ТолькоПросмотр = Истина;   
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.РСКПВозврат") Тогда
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Параметры, "ВалютаДокумента") Тогда
			Валюта = Параметры.ВалютаДокумента;
		КонецЕсли;
		Элементы.ГруппаСведенияВыплатахВалюта.Видимость = Валюта <> БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета()
			И НЕ РаботаСОбязательствами.СведенияОВалютеОбязательства(Договор).ОплатаВРублях;  
			
		Элементы.НомерОбязательства.Видимость 		= Ложь;
		Элементы.ГруппаНомерДатаЗаявки.Видимость 	= Ложь;
		Элементы.ГруппаОтветственный.Видимость 		= Ложь;
		Элементы.GUIDКО.Видимость 					= Ложь; 
		Элементы.ГруппаПодтверждающийДокумент.ТолькоПросмотр = Истина;
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.РСКПУточнение") Тогда	
		Элементы.НомерОбязательства.Видимость 		= Ложь;
		Элементы.ГруппаНомерДатаЗаявки.Видимость 	= Ложь;
		Элементы.ГруппаОтветственный.Видимость 		= Ложь;
		Элементы.GUIDКО.Видимость 					= Ложь; 
		Элементы.ГруппаПодтверждающийДокумент.ТолькоПросмотр = Истина;  
		Элементы.ГруппаСведенияВыплатахВалюта.Видимость = Ложь;	
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.РСКППеречислениеМир") Тогда	
		Элементы.НомерОбязательства.Видимость 		= Ложь;
		Элементы.ГруппаНомерДатаЗаявки.Видимость 	= Ложь;
		Элементы.ГруппаОтветственный.Видимость 		= Ложь;
		Элементы.GUIDКО.Видимость 					= Ложь; 
		Элементы.ГруппаПодтверждающийДокумент.ТолькоПросмотр = Истина;  
		Элементы.ГруппаСведенияВыплатахВалюта.Видимость = Ложь;	
				
	Иначе
		Элементы.ГруппаСведенияВыплатахВалюта.Видимость = Ложь;
	КонецЕсли;   
	
	Элементы.КомментарийОбработки.Видимость = ЗначениеЗаполнено(КомментарийОбработки);
	
	МассивЗапрещенныхСтатусов = Новый Массив;
	Если НЕ (ТипДокумента = Тип("ДокументСсылка.КвитанцияНаОплатуГосуслуг")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.НачислениеОтПодведомственного")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.ЗапросУНИФО")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.КаталогГосУслуг")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.УведомлениеОВозвратеГИСГМП")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.УведомлениеОВозвратеГИСГМПОтПодведомственного")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.НачислениеОтПосредникаГИСГМП")) Тогда
		//ограничим список выбора статуса - добавим в запрещенные статус ПереданВОбработку
		
		МассивЗапрещенныхСтатусов.Добавить(Перечисления.СтатусыИсполненияДокумента.ОжидаетОтправки);
		
		// Изменено РСКП
		// Для РСКП нужен статус "Передано в обработку"
		Если НЕ ТипДокумента = Тип("ДокументСсылка.РСКППеречисление") 
			И НЕ ТипДокумента = Тип("ДокументСсылка.РСКППеречислениеМир") Тогда 
			МассивЗапрещенныхСтатусов.Добавить(Перечисления.СтатусыИсполненияДокумента.ПереданВОбработку); 
			МассивЗапрещенныхСтатусов.Добавить(Перечисления.СтатусыИсполненияДокумента.ИсполненЧастично);
		КонецЕслИ;	
				
	КонецЕсли;  
	
	Если МассивЗапрещенныхСтатусов.Количество()>0 Тогда
		//Если есть ограничения - ограничим список выбора статуса
		Элементы.Статус.РежимВыбораИзСписка = Истина;
		Для Каждого ТекЗнач Из Перечисления.СтатусыИсполненияДокумента Цикл
			Если МассивЗапрещенныхСтатусов.Найти(ТекЗнач)=Неопределено Тогда
				Элементы.Статус.СписокВыбора.Добавить(ТекЗнач);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;  
	
	Если НЕ ЗначениеЗаполнено(Статус) Тогда
		ИзменитьСтатусДокумента();             
	КонецЕсли;
	
	Если НЕ ПлатежноРасчетныйДокумент.Пустая() Тогда
		ДатыЗапретаИзменения.ОбъектПриЧтенииНаСервере(ЭтотОбъект, ПлатежноРасчетныйДокумент.ПолучитьОбъект());
	КонецЕсли;
	
	Если НЕ ПравоДоступа("Изменение", ПлатежноРасчетныйДокумент.Метаданные()) ИЛИ ЭтотОбъект.ТолькоПросмотр Тогда
		Элементы.ФормаУстановить.Доступность = Ложь;
		
		МассивЭлементов = Новый Массив;
		
		МассивЭлементов.Добавить("Статус");
		МассивЭлементов.Добавить("НомерОбязательства");
		Если Элементы.ГруппаНомерДатаЗаявки.Видимость Тогда
			МассивЭлементов.Добавить("НомерЗаявки");
			МассивЭлементов.Добавить("ДатаРегистрации");
		КонецЕсли;
		Если Элементы.ГруппаОтветственный.Видимость Тогда
			МассивЭлементов.Добавить("ОтветственныйИсполнительФИО");
			МассивЭлементов.Добавить("ОтветственныйИсполнительДолжность");
			МассивЭлементов.Добавить("ОтветственныйИсполнительТелефон");
		КонецЕсли;
		Если Элементы.ГруппаСведенияВыплатах.Видимость Тогда
			МассивЭлементов.Добавить("Оплачено");
			МассивЭлементов.Добавить("ДатаПроведения");
		КонецЕсли;
		Если Элементы.ГруппаПодтверждающийДокумент.Видимость Тогда
			МассивЭлементов.Добавить("ВидПодтверждающегоДокумента");
			МассивЭлементов.Добавить("НомерПодтверждающегоДокумента");
			МассивЭлементов.Добавить("ДатаПодтверждающегоДокумента");
		КонецЕсли;
		
		ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивЭлементов, "ТолькоПросмотр", Истина);
		
	КонецЕсли;
	
	// Изменено РСКП
	Если (Элементы.ГруппаСведенияВыплатах.Видимость И ЕстьДвиженияРБ) 
		ИЛИ ТипДокумента = Тип("ДокументСсылка.РСКППеречисление") 
		ИЛИ ТипДокумента = Тип("ДокументСсылка.РСКППеречислениеМир") 
		ИЛИ ТипДокумента = Тип("ДокументСсылка.РСКПВозврат")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.РСКПУточнение") Тогда
		МассивЭлементов = Новый Массив;
		МассивЭлементов.Добавить("Оплачено");
		МассивЭлементов.Добавить("ДатаПроведения");
		ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивЭлементов, "ТолькоПросмотр", Истина);
	КонецЕсли;  
	
	// Изменено РСКП
	Если (ТипДокумента = Тип("ДокументСсылка.РСКППеречисление")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.РСКППеречислениеМир")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.РСКПВозврат")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.РСКПУточнение"))
		И (НЕ Статус = Перечисления.СтатусыИсполненияДокумента.ВРаботе 
		И НЕ Статус = Перечисления.СтатусыИсполненияДокумента.Подготовлен) Тогда
		Элементы.Статус.ТолькоПросмотр = Истина;
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОплаченоПриИзменении(Элемент)
	Если НЕ Оплачено Тогда
		ДатаПроведения = "";
		Курс = 0;
	ИначеЕсли НЕ ЗначениеЗаполнено(ДатаПроведения) Тогда   
		
		пРабочаяДата = ПолучитьРабочуюДату();		
		
		Если ЗначениеЗаполнено(пРабочаяДата) Тогда
			ДатаПроведения = пРабочаяДата;
		Иначе
			ДатаПроведения = ТекущаяДата();
		Конецесли;
		
		ОбновитьКурсВалюты();  
		
	КонецЕсли;
	ИзменитьСтатусДокумента();
КонецПроцедуры

