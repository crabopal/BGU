			Строка.НаименованиеДокументаФайла = НаименованиеДокументаФайла;
		Иначе
			ШаблонСообщения = НСтр("ru = 'Внутренний электронный документ ""%1"" не найден для ОС ""%2"" (строка № %3).'");
