&НаСервере
Функция ЕстьЗамечанияКЗаполнению(СписокЗамечаний)
	Результат = Ложь;
	ТекстЗамечанияКФайлу = НСтр("ru = 'не указан файл. Необходимо удалить строку и добавить файл одной из команд подменю ""Добавить"".'");
	
	НомерСтроки = 0;
	Для Каждого Строка Из ПриложенныеДокументы Цикл
		НомерСтроки = НомерСтроки + 1;
		Если НЕ ЗначениеЗаполнено(Строка.ПрисоединенныйФайл) Тогда
			ТекстЗамечания = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'В строке %2 %1'"), ТекстЗамечанияКФайлу, НомерСтроки);
			
			СписокЗамечаний.Добавить(ТекстЗамечания);
			
			Результат = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции
 
&НаКлиенте
Процедура ДобавитьИнвКарточкиИКарточкиКапвложенийИзРегистраУчета(ТипВидаРегистра)
	
	Оповещение = Новый ОписаниеОповещения("ЗаполнитьПриложенныеДокументыРегистраУчета",ЭтотОбъект);
	
	ВидРегистра = Новый СписокЗначений; 
	МассиВидыРегистра =  СсылкаВидРегистра(ТипВидаРегистра);
	ВидРегистра.ЗагрузитьЗначения(МассиВидыРегистра);
	
	СтруктураОтбора = Новый Структура; 
	СтруктураОтбора.Вставить("ВидРегистра", ВидРегистра);
	СтруктураОтбора.Вставить("Организация", Организация);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("МножественныйВыбор", Истина);
	ПараметрыФормы.Вставить("Отбор", СтруктураОтбора);
	
	ОткрытьФорму(
	"Документ.РегистрУчета.Форма.ФормаВыбораВнутреннегоЭДО", ПараметрыФормы,
	,,,,Оповещение,
	);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПриложенныеДокументыРегистраУчета(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		ДобавитьИнвКарточкиИКарточкиКапвложенийИзФайлаРегистрУчетаНаСервере(Результат);
	Иначе
		Возврат;
	КонецЕсли;
	
	ПроверитьПриложенныеДокументыРасчетРазмера();
	
	Модифицированность = Истина;
	
КонецПроцедуры 

&НаСервере
Процедура ДобавитьИнвКарточкиИКарточкиКапвложенийИзФайлаРегистрУчетаНаСервере(ВыбранныеОбъекты)
	
	ИспользуетсяПОД = ЭлектронныеДокументыБГУ.ИспользуетсяПОД();
	
	Если ИспользуетсяПОД Тогда
		ОбъектыУчета = ВыбранныеОбъекты;
	Иначе
		ОбъектыУчета = СписокВыбранныхКарточекЭД(ВыбранныеОбъекты);
	КонецЕсли;
	
	НомерСтроки = 0;
	
	Для Каждого ТекСтрока Из ОбъектыУчета Цикл 
		
		НомерСтроки = НомерСтроки + 1;
		
		Если ИспользуетсяПОД Тогда 
			РегистрУчета 				= ТекСтрока.Значение; 
			
			СведенияПредставленияВнутреннегоЭД = СведенияПредставленияФайлаРегистрУчетаЭДПОД(РегистрУчета);
		Иначе   
			РегистрУчета 				= ТекСтрока.РегистрУчета; 
			ВнутреннийЭД 				= ТекСтрока.ВнутреннийЭД;
			ИдентификаторКомандыПечати 	= ТекСтрока.ИдентификаторКомандыПечати;
			
			СведенияПредставленияВнутреннегоЭД = СведенияПредставленияФайлаРегистрУчетаЭД(РегистрУчета, ВнутреннийЭД, ИдентификаторКомандыПечати);
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(СведенияПредставленияВнутреннегоЭД.ДобавленныйФайл) Тогда
			Файл = СведенияПредставленияВнутреннегоЭД.ДобавленныйФайл;
			Строка = ПриложенныеДокументы.Добавить();
			ЗаполнитьДанныеСтроки(Строка, Файл); 
			ЗаполнитьВидСведенийНаименованиеДокумента(Строка);
		Иначе
			ШаблонСообщения = НСтр("ru = 'Внутренний электронный документ не найден для  ""%1"" (строка № %2).'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, РегистрУчета, НомерСтроки);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СписокВыбранныхКарточекЭД(ВыбранныеОбъекты)
	
	Запрос = Новый Запрос;	                                   
	Запрос.Текст = "ВЫБРАТЬ
	|	ВнутреннийЭлектронныйДокумент.Ссылка КАК ВнутреннийЭД,
	|	ДокументРегистрУчета.Ссылка КАК РегистрУчета,
	|	ВнутреннийЭлектронныйДокумент.ИдентификаторКомандыПечати КАК ИдентификаторКомандыПечати
	|ИЗ
	|	Документ.ВнутреннийЭлектронныйДокумент КАК ВнутреннийЭлектронныйДокумент
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РегистрУчета КАК ДокументРегистрУчета
	|		ПО (ВЫБОР
	|				КОГДА ВнутреннийЭлектронныйДокумент.УчетныйДокумент ССЫЛКА Документ.РегистрУчета
	|					ТОГДА ДокументРегистрУчета.Ссылка = ВнутреннийЭлектронныйДокумент.УчетныйДокумент
	|				ИНАЧЕ ЛОЖЬ
	|			КОНЕЦ)
	|ГДЕ
	|	ДокументРегистрУчета.Ссылка В(&Ссылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВнутреннийЭлектронныйДокумент.Ссылка,
	|	ДокументРегистрУчета.Ссылка,
	|	ВнутреннийЭлектронныйДокумент.ИдентификаторКомандыПечати";
	
	Запрос.УстановитьПараметр("Ссылка", ВыбранныеОбъекты);
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
