&НаСервереБезКонтекста
Функция СсылкаВидРегистра(ТипВидаРегистра)
	
	ВидРегистраУчета = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВидыРегистровУчета.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ВидыРегистровУчета КАК ВидыРегистровУчета
	               |ГДЕ
	               |	ВидыРегистровУчета.Наименование ПОДОБНО &Наименование
				   |	И ВидыРегистровУчета.ПометкаУдаления = Ложь";
	
	Запрос.УстановитьПараметр("Наименование", "%" + ТипВидаРегистра + "%");
	
	Результат = Запрос.Выполнить().Выгрузить(); 
	
	Если Результат.Количество() > 0 Тогда 
		ВидРегистраУчета = Результат.ВыгрузитьКолонку("Ссылка");
	КонецЕсли;
	
	Возврат ВидРегистраУчета;
	
КонецФункции 

&НаСервере
Функция СведенияПредставленияФайлаРегистрУчетаЭД(ДокументРегистрУчета, ДокВнутреннегоЭД, ИдентификаторКомандыПечати)
	
	ДатаСведений = ТекущаяДатаСеанса();
	ТекстовоеСодержимое = "";
	ИмяПриложенногоФайла = "";
	
	Расширение = "pdf";
	ТипФайлаТабДок = ТипФайлаТабличногоДокумента.PDF_A_3;
	
	ВнутреннийЭД = ВнутреннийЭДО.АктуальныйЭлектронныйДокумент(ДокументРегистрУчета, ИдентификаторКомандыПечати);
	
	Если НЕ ЗначениеЗаполнено(ВнутреннийЭД) Тогда
		Результат = Новый Структура;
		Результат.Вставить("ДобавленныйФайл", Неопределено);
		Результат.Вставить("ИмяПриложенногоФайла", ИмяПриложенногоФайла);
		
		Возврат Результат;
	КонецЕсли;
	
	Реквизиты = "Описание, Дата";
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументРегистрУчета,Реквизиты);
	ИмяФайлаСПробелами = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Регистр учета от %1, %2)'"), ЗначенияРеквизитов.Дата,ЗначенияРеквизитов.Описание);
	ИмяФайлаБезПробелов = СтрЗаменить(ИмяФайлаСПробелами," ","_");
	
	ИмяФайла = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(ИмяФайлаБезПробелов, "_");
	Если СтрДлина(ИмяФайла) > 150 Тогда
		ИмяФайла = Сред(ИмяФайла,1,149);		
		ИмяФайла = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1)'"), ИмяФайла);
	КонецЕсли;	
	
	ДвоичныеДанные = ЭлектронныеДокументыБГУ.ДвоичныеДанныеЭлектронногоДокумента(ВнутреннийЭД);
	
	ЭлектронныеПодписи = ЭлектронныеДокументыБГУ.НовыйСписокЭлектронныхПодписейВнутреннегоЭД();
	ЭлектронныеДокументыБГУ.ЗаполнитьСписокПодписей(ЭлектронныеПодписи, ВнутреннийЭД.ОсновнойФайл, Организация);
	
	АдресОсновногоФайла = ПоместитьВоВременноеХранилище(ДвоичныеДанные);
	
	ТабличныйДокументОсновной = ВнутреннийЭДО.ТабличныйДокументИзДвоичныхДанныхАрхива(ДвоичныеДанные);
	
	АдресТабличногоДокумента = ПоместитьВоВременноеХранилище(ТабличныйДокументОсновной);
	
	ЭлектронныеДокументыБГУ.ДобавитьШтампыЭлектронныхПодписейВнутреннегоЭДО(ТабличныйДокументОсновной, ЭлектронныеПодписи, Организация);
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла(Расширение);
	ТабличныйДокументОсновной.Записать(ИмяВременногоФайла, ТипФайлаТабДок);
	
	ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВременногоФайла);
	АдресДвоичныхДанных = ПоместитьВоВременноеХранилище(ДвоичныеДанные);
	
	ИмяБезРасширения = ИмяФайла;
	РасширениеБезТочки = Расширение;
	СсылкаНаВладельца = ДокументОснование;
	
	ПараметрыФайла = Новый Структура();
	ПараметрыФайла.Вставить("Автор", Пользователи.ТекущийПользователь());
	ПараметрыФайла.Вставить("ВладелецФайлов", СсылкаНаВладельца);
	ПараметрыФайла.Вставить("ИмяБезРасширения", ИмяБезРасширения);
	ПараметрыФайла.Вставить("РасширениеБезТочки", РасширениеБезТочки);
	ПараметрыФайла.Вставить("ВремяИзмененияУниверсальное", ДатаСведений);
	ПараметрыФайла.Вставить("Описание", "");
	ПараметрыФайла.Вставить("Служебный", Ложь);
	
	ДобавленныйФайл = РаботаСФайлами.ДобавитьФайл(
	ПараметрыФайла, АдресДвоичныхДанных, "", СокрЛП(ИмяФайла));
	
	Попытка
		УдалитьФайлы(ИмяВременногоФайла);
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ШаблонТекста = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Удаление временного %1 файла'", ОбщегоНазначения.КодОсновногоЯзыка()),
		Расширение);
		
		ЗаписьЖурналаРегистрации(ШаблонТекста,
		УровеньЖурналаРегистрации.Ошибка,,,
		ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Удаление временного PDF файла'", ОбщегоНазначения.КодОсновногоЯзыка()),
		УровеньЖурналаРегистрации.Ошибка,,,
		ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
	КонецПопытки;
	
	ИмяПриложенногоФайла = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
	НСтр("ru='%1.pdf'"), ИмяФайла);
	
	Результат = Новый Структура;
	Результат.Вставить("ДобавленныйФайл", ДобавленныйФайл);
	Результат.Вставить("ИмяПриложенногоФайла", ИмяПриложенногоФайла);
	
	Возврат Результат;
	
КонецФункции	

