&НаСервере
Процедура ЗаполнитьВидСведенийНаименованиеДокумента(Строка)
	
	Если СтрНайти(Строка.НаименованиеФайла, НСтр("ru='Инвентарные карточки объектов'")) > 0 
		ИЛИ СтрНайти(Строка.НаименованиеФайла, НСтр("ru='Инвентарная_карточка'")) > 0 Тогда
		Строка.ВидСведений = ПредопределенноеЗначение("Перечисление.ВидыСведенийПриложенийАктаПриемаПередачиНФА.КопииИнвентарныхКарточек");
		Строка.НаименованиеДокументаФайла = НСтр("ru='Инвентарные карточки объектов'");
	ИначеЕсли СтрНайти(Строка.НаименованиеФайла, НСтр("ru='Карточки капвложений'")) > 0 
		ИЛИ СтрНайти(Строка.НаименованиеФайла, НСтр("ru='Карточка_капвложений'")) > 0 ТОгда
		Строка.ВидСведений = ПредопределенноеЗначение("Перечисление.ВидыСведенийПриложенийАктаПриемаПередачиНФА.КопииКарточекКапитальныхВложений");
		Строка.НаименованиеДокументаФайла = НСтр("ru='Карточки капитальных вложений'"); 
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриложенныеДокументыПометкаУдаленияНаСервере()
	
	Для Каждого ТекСтрока Из СписокУдаленныхДокументов Цикл
		
		УдаляемыйЭлемент = ТекСтрока.Значение;
		Если НЕ ЗначениеЗаполнено(УдаляемыйЭлемент) Тогда
			Продолжить;
		КонецЕсли; 
		ОбъектФайла = УдаляемыйЭлемент.ПолучитьОбъект();
		
		Если НЕ ОбъектФайла.ПометкаУдаления Тогда 
			
			ОбъектФайла.ПометкаУдаления = Истина; 
			ОбъектФайла.Записать(); 
			
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

