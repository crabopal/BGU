
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУ.ПолучитьСписокВыбораДляОтбораПоТипуДокумента("ЖурналПлатежноРасчетныеДокументыОбщий", 	Элементы.ОтборРасчетноПлатежныеДокументыТипДокумента);
	ОбщегоНазначенияБГУ.ПолучитьСписокВыбораДляОтбораПоТипуДокумента("ПрочиеДокументыПоЛицевымСчетам", 			Элементы.ОтборПрочиеДокументыТипДокумента);
    ОбщегоНазначенияБГУ.ПолучитьСписокВыбораДляОтбораПоТипуДокумента("ЖурналИнкассовыхДокументов", 				Элементы.ОтборДокументыИнкассоТипДокумента);
	
	Элементы.КнопкаПроводки.Пометка 	= Ложь;
	Элементы.ЖурналПроводок.Видимость 	= Элементы.КнопкаПроводки.Пометка;
	
	
	// Отбор по организации
	Организация = ОбщегоНазначенияБГУ.ТекущаяОрганизация();
	
	Если ЗначениеЗаполнено(Организация) Тогда
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Организация",Организация, ВидСравненияКомпоновкиДанных.Равно, "Организация", ЗначениеЗаполнено(Организация));
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ПрочиеДокументы.Отбор, "Организация",Организация, ВидСравненияКомпоновкиДанных.Равно, "Организация" ,ЗначениеЗаполнено(Организация));
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Выписки.Отбор, "Организация",Организация, ВидСравненияКомпоновкиДанных.Равно, "Организация" ,ЗначениеЗаполнено(Организация));
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ДокументыИнкассо.Отбор, "Организация",Организация, ВидСравненияКомпоновкиДанных.Равно, "Организация" ,ЗначениеЗаполнено(Организация));

		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СписокОрганизация", "Видимость", НЕ ЗначениеЗаполнено(Организация));
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПрочиеДокументыОрганизация", "Видимость", НЕ ЗначениеЗаполнено(Организация));
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ВыпискиОрганизация", "Видимость", НЕ ЗначениеЗаполнено(Организация));
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДокументыИнкассоОрганизация", "Видимость", НЕ ЗначениеЗаполнено(Организация));
		
	КонецЕсли;
	
	// Отбор по ответственному
	Если ПолучитьФункциональнуюОпцию("ИспользоватьОтветственных") Тогда
		
		Ответственный = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("Ответственный_ЖурналПлатежноРасчетныеДокументы", "", ПользователиКлиентСервер.АвторизованныйПользователь());
		
		//Добавим незаполненное значение
		СписокДляОтбора = Новый СписокЗначений();
		СписокДляОтбора.Добавить(Ответственный);
		СписокДляОтбора.Добавить(ПредопределенноеЗначение("Справочник.Пользователи.ПустаяСсылка"));		
 
	    ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Ответственный", СписокДляОтбора, ВидСравненияКомпоновкиДанных.ВСписке, "Ответственный", ЗначениеЗаполнено(Ответственный));
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ПрочиеДокументы.Отбор, "Ответственный", СписокДляОтбора, ВидСравненияКомпоновкиДанных.ВСписке, "Ответственный", ЗначениеЗаполнено(Ответственный));
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Выписки.Отбор, "Ответственный", СписокДляОтбора, ВидСравненияКомпоновкиДанных.ВСписке, "Ответственный", ЗначениеЗаполнено(Ответственный));
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ДокументыИнкассо.Отбор, "Ответственный", СписокДляОтбора, ВидСравненияКомпоновкиДанных.ВСписке, "Ответственный", ЗначениеЗаполнено(Ответственный));

		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СписокОтветственный", "Видимость", НЕ ЗначениеЗаполнено(Ответственный));
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПрочиеДокументыОтветственный", "Видимость", НЕ ЗначениеЗаполнено(Ответственный));
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ВыпискиОтветственный", "Видимость", НЕ ЗначениеЗаполнено(Ответственный));
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДокументыИнкассоОтветственный", "Видимость", НЕ ЗначениеЗаполнено(Ответственный));

	КонецЕсли;	

	
	ПоказыватьОстатки = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("ПоказыватьОстатки_ЖурналПлатежноРасчетныеДокументы", "");
	Если ПоказыватьОстатки Тогда
		Элементы.Остатки.Видимость = Истина;
		ОбновитьОстатки();
		Элементы.Отбор.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	Иначе
		Элементы.Остатки.Видимость = Ложь;
		Элементы.Отбор.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	КонецЕсли;	
	
	ДоступДобавление = Ложь;
	ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();
	ПараметрыРазмещения.КоманднаяПанель = Элементы.Список.КоманднаяПанель;
	ПараметрыРазмещения.Источники = Новый Массив;
	ПараметрыРазмещения.ПрефиксГрупп = "Список";
		Для Каждого РегДокумент Из Метаданные.ЖурналыДокументов.ЖурналПлатежноРасчетныеДокументыОбщий.РегистрируемыеДокументы Цикл
		Если ПравоДоступа("Добавление", РегДокумент) Тогда
			ДоступДобавление = Истина;
		КонецЕсли;	
		ПараметрыРазмещения.Источники.Добавить(РегДокумент);
	КонецЦикла;	
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	Если НЕ ДоступДобавление Тогда
		Элементы.Список.ИзменятьСоставСтрок		= Ложь;
	КонецЕсли;
	
	ДоступДобавление = Ложь;
	ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();
	ПараметрыРазмещения.КоманднаяПанель = Элементы.ПрочиеДокументы.КоманднаяПанель;
	ПараметрыРазмещения.Источники = Новый Массив;
	ПараметрыРазмещения.ПрефиксГрупп = "ПрочиеДокументы";
	Для Каждого РегДокумент Из Метаданные.ЖурналыДокументов.ПрочиеДокументыПоЛицевымСчетам.РегистрируемыеДокументы Цикл
		Если ПравоДоступа("Добавление", РегДокумент) Тогда
			ДоступДобавление = Истина;
		КонецЕсли;	
		ПараметрыРазмещения.Источники.Добавить(РегДокумент);
	КонецЦикла;	
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	Если НЕ ДоступДобавление Тогда
		Элементы.ПрочиеДокументы.ИзменятьСоставСтрок		= Ложь;
	КонецЕсли;
	
	ДоступДобавление = Ложь;
	ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();
	ПараметрыРазмещения.КоманднаяПанель = Элементы.ДокументыИнкассо.КоманднаяПанель;
	ПараметрыРазмещения.Источники = Новый Массив;
	ПараметрыРазмещения.ПрефиксГрупп = "ДокументыИнкассо";
	Для Каждого РегДокумент Из Метаданные.ЖурналыДокументов.ЖурналИнкассовыхДокументов.РегистрируемыеДокументы Цикл
		Если ПравоДоступа("Добавление", РегДокумент) Тогда
			ДоступДобавление = Истина;
		КонецЕсли;	
		ПараметрыРазмещения.Источники.Добавить(РегДокумент);
	КонецЦикла;	
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	Если НЕ ДоступДобавление Тогда
		Элементы.ДокументыИнкассо.ИзменятьСоставСтрок		= Ложь;
	КонецЕсли; 
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СписокИФО", "Видимость", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПрочиеДокументыИФО", "Видимость", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДокументыИнкассоИФО", "Видимость", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЖурналПроводокИФО", "Видимость", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	
	// Печать выписки
	ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();
	ПараметрыРазмещения.КоманднаяПанель = Элементы.Выписки.КоманднаяПанель;
	ПараметрыРазмещения.Источники = Новый Массив;
	ПараметрыРазмещения.Источники.Добавить(Метаданные.Документы.ВыпискаИзЛицевогоСчета);
	ПараметрыРазмещения.ПрефиксГрупп = "Выписки";
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	// Конец Печать выписки
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтаФорма, Элементы.ИнформационныеСсылки);
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервереФормыСписка(ЭтотОбъект, "Список", "СписокСтатусПОД", "Статус (ПОД)", 1);
	ОбщегоНазначенияБГУ.ПриСозданииНаСервереФормыСписка(ЭтотОбъект, "ПрочиеДокументы", "ПрочиеДокументыСтатусПОД", "Статус (ПОД)", 1);
	ОбщегоНазначенияБГУ.ПриСозданииНаСервереФормыСписка(ЭтотОбъект, "Выписки", "ВыпискиСтатусПОД", "Статус (ПОД)");
	ОбщегоНазначенияБГУ.ПриСозданииНаСервереФормыСписка(ЭтотОбъект, "ДокументыИнкассо", "ДокументыИнкассоСтатусПОД", "Статус (ПОД)", 1);
	
	// ИнтернетПоддержкаПользователей.РаботаСКонтрагентами
	ПроверкаКонтрагентов.ПриСозданииНаСервереСписокДокументов(Список);
	// Конец ИнтернетПоддержкаПользователей.РаботаСКонтрагентами 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если Врег(ИмяСобытия) = Врег("ИзмененСтатус_ПлатежноРасчетныйДокумент") Тогда
		
		Если ПоказыватьОстатки Тогда
			ОбновитьОстатки();
		КонецЕсли;	
		
		Элементы.Список.Обновить();
		Элементы.ПрочиеДокументы.Обновить();
		
	ИначеЕсли ИмяСобытия = "ИзменениеОсновнойОрганизации" Тогда
		
		Представление = НСтр("ru = 'Отбор по основной организации (%1)'");
		Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Представление, Строка(Параметр));
	    Организация = Параметр;
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Организация", Параметр,,Представление, ЗначениеЗаполнено(Параметр));
        Элементы.СписокОрганизация.Видимость = НЕ ЗначениеЗаполнено(Организация);
		
        ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ПрочиеДокументы.Отбор, "Организация", Параметр,,Представление, ЗначениеЗаполнено(Параметр));
		Элементы.ПрочиеДокументыОрганизация.Видимость = НЕ ЗначениеЗаполнено(Организация);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

