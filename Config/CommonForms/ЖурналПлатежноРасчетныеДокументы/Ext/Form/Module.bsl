КонецПроцедуры

&НаКлиенте
Процедура ПоказательКПСПриИзменении(Элемент)
	ОбновитьОстатки()
КонецПроцедуры

&НаКлиенте
Процедура ПоказательКЭКПриИзменении(Элемент)
	ОбновитьОстатки()
КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьОстаткиПриИзменении(Элемент)
	Если ПоказыватьОстатки Тогда
		Элементы.Остатки.Видимость = Истина;
		ОбновитьОстатки();
		Элементы.Отбор.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	Иначе
		Элементы.Остатки.Видимость = Ложь;
		Элементы.Отбор.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	КонецЕсли;	
	ОбщегоНазначенияВызовСервера.ХранилищеОбщихНастроекСохранить("ПоказыватьОстатки_ЖурналПлатежноРасчетныеДокументы", "", ПоказыватьОстатки);
КонецПроцедуры

&НаКлиенте
Процедура ОтборРасчетноПлатежныеДокументыТипДокументаПриИзменении(Элемент)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Тип", ?(ЗначениеЗаполнено(ОтборРасчетноПлатежныеДокументыТипДокумента), Тип("ДокументСсылка."+ОтборРасчетноПлатежныеДокументыТипДокумента), ""), , , ЗначениеЗаполнено(ОтборРасчетноПлатежныеДокументыТипДокумента));
	Элементы.СписокТип.Видимость = НЕ ЗначениеЗаполнено(ОтборРасчетноПлатежныеДокументыТипДокумента);

КонецПроцедуры

&НаКлиенте
Процедура ОтборПрочиеДокументыТипДокументаПриИзменении(Элемент)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ПрочиеДокументы.Отбор, "Тип", ?(ЗначениеЗаполнено(ОтборПрочиеДокументыТипДокумента), Тип("ДокументСсылка."+ОтборПрочиеДокументыТипДокумента), ""), , , ЗначениеЗаполнено(ОтборПрочиеДокументыТипДокумента));
	Элементы.ПрочиеДокументыТип.Видимость = НЕ ЗначениеЗаполнено(ОтборПрочиеДокументыТипДокумента);

КонецПроцедуры

&НаКлиенте
Процедура ОтборДокументыИнкассоТипДокументаПриИзменении(Элемент)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ДокументыИнкассо.Отбор, "Тип", ?(ЗначениеЗаполнено(ОтборДокументыИнкассоТипДокумента), Тип("ДокументСсылка."+ОтборДокументыИнкассоТипДокумента), ""), , , ЗначениеЗаполнено(ОтборДокументыИнкассоТипДокумента));
	Элементы.ДокументыИнкассоТип.Видимость = НЕ ЗначениеЗаполнено(ОтборДокументыИнкассоТипДокумента);
	
КонецПроцедуры

&НаКлиенте
Процедура ЖурналыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если ТекущаяСтраница.Имя = "ЖурналПлатежноРасчетныеДокументы" Тогда
		ИмяТабЧасти = "Список";
	ИначеЕсли ТекущаяСтраница.Имя = "ЖурналПрочиеДокументы" Тогда
		ИмяТабЧасти = "ПрочиеДокументы";
	ИначеЕсли ТекущаяСтраница.Имя = "ЖурналВыпискиИзЛицевогоСчета" Тогда
		ИмяТабЧасти = "Выписки";
	ИначеЕсли ТекущаяСтраница.Имя = "ЖурналДокументыИнкассо" Тогда
		ИмяТабЧасти = "ДокументыИнкассо";
	КонецЕсли;
	
	ОбновитьЖурналПроводок();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

