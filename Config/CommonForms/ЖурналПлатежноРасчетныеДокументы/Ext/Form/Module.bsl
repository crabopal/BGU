&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	
	Если Элементы.Журналы.ТекущаяСтраница.Имя = "ЖурналПлатежноРасчетныеДокументы" Тогда
		ИмяТабЧасти = "Список";
	ИначеЕсли Элементы.Журналы.ТекущаяСтраница.Имя = "ЖурналПрочиеДокументы" Тогда
		ИмяТабЧасти = "ПрочиеДокументы";
	ИначеЕсли Элементы.Журналы.ТекущаяСтраница.Имя = "ЖурналВыпискиИзЛицевогоСчета" Тогда
		ИмяТабЧасти = "Выписки";
	ИначеЕсли Элементы.Журналы.ТекущаяСтраница.Имя = "ЖурналДокументыИнкассо" Тогда
		ИмяТабЧасти = "ДокументыИнкассо";
	КонецЕсли;

	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Элементы[ИмяТабЧасти]);

КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуБГУ(Команда)
	
	Если Лев(Команда.Имя, 44) = "ВнутреннийЭДО_ПросмотретьЭлектронныйДокумент" Тогда
		ИмяТабЧасти = Сред(Команда.Имя, 45);
	ИначеЕсли Лев(Команда.Имя, 41) = "ВнутреннийЭДО_СоздатьЭлектронныеДокументы" Тогда
		ИмяТабЧасти = Сред(Команда.Имя, 42);
	ИначеЕсли Лев(Команда.Имя, 46) = "ВнутреннийЭДО_АннулироватьЭлектронныеДокументы" Тогда
		ИмяТабЧасти = Сред(Команда.Имя, 47);
	ИначеЕсли Лев(Команда.Имя, 50) = "ВнутреннийЭДО_ОткрытьЭлектронныеДокументыНаПодпись" Тогда
		ИмяТабЧасти = Сред(Команда.Имя, 51);
	Иначе
		Возврат;
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиент.ВыполнитьПодключаемуюКоманду(Команда, ЭтотОбъект, Элементы[ИмяТабЧасти]);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьОтборЖурналаПроводок(Знач Ссылка)
	МетаданныеРегистрБухгалтерии = Метаданные.РегистрыБухгалтерии.ЖурналПроводокЕПСБУ;
	Если Ссылка<>Неопределено Тогда
		Если НЕ Ссылка.Метаданные().Движения.Содержит(МетаданныеРегистрБухгалтерии) Тогда
			Ссылка = Неопределено;
		КонецЕсли;
	КонецЕсли;
	Проводки = РеквизитФормыВЗначение("ЖурналПроводок");
	Проводки.Отбор.Регистратор.Значение = Ссылка;
	Проводки.Отбор.Регистратор.Использование = Истина;
	Проводки.Прочитать();
	ЗначениеВРеквизитФормы(Проводки,"ЖурналПроводок");
КонецПроцедуры

&НаКлиенте
Процедура ПроверкаНеобходимостиЗаполнения()
	
	Если ЗначениеЗаполнено(ИмяТабЧасти) Тогда
		Если Элементы[ИмяТабЧасти].ТекущиеДанные<>Неопределено Тогда
			Если Элементы[ИмяТабЧасти].ТекущиеДанные.Свойство("Ссылка") Тогда
				УстановитьОтборЖурналаПроводок(Элементы[ИмяТабЧасти].ТекущиеДанные.Ссылка);
				Возврат;
			КонецЕсли;
		КонецЕсли;
    КонецЕсли;
	
	УстановитьОтборЖурналаПроводок(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЖурналПроводок()
	Если Элементы.КнопкаПроводки.Пометка Тогда
		ПодключитьОбработчикОжидания("ПроверкаНеобходимостиЗаполнения", 0.4, Истина);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ОбновитьОстатки()
	
	ТаблицаОстатков.Очистить();
	
	СхемаКомпоновкиДанных = ПолучитьОбщийМакет("БезналичныеДенежныеСредства");
	Настройки = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
	
	Для индекс = 0 по СхемаКомпоновкиДанных.Параметры.Количество()-1 цикл
		НовыйПараметр = Настройки.ПараметрыДанных.Элементы.Добавить();
		НовыйПараметр.Параметр = Новый ПараметрКомпоновкиДанных(СхемаКомпоновкиДанных.Параметры[индекс].имя);
	КонецЦикла;	

	Если ЗначениеЗаполнено(Организация) Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(Настройки, "Организация", Организация);
	Иначе
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(Настройки, "Организация", Неопределено);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЛицевойСчет) тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(Настройки,"ЛицевойСчет", ЛицевойСчет);
	КонецЕсли;
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(Настройки, "Старт", НачалоГода(ТекущаяДатаСеанса()));
	
	Для Каждого ПолеВыбора из Настройки.Выбор.Элементы цикл
	    Если ПолеВыбора.Поле = Новый ПолеКомпоновкиДанных("КПС") тогда
			ПолеВыбора.Использование = ПоказательКПС;
			Элементы.ТаблицаОстатковКПС.Видимость = ПоказательКПС; 
	    ИначеЕсли ПолеВыбора.Поле = Новый ПолеКомпоновкиДанных("КЭК") тогда
			ПолеВыбора.Использование = ПоказательКЭК;
			Элементы.ТаблицаОстатковКЭК.Видимость = ПоказательКЭК;
		КонецЕсли;		
	КонецЦикла;
		
	//Сгенерируем макет компоновки данных при помощи компоновщика макета
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	//МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки);
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	//Создадим и инициализируем процессор компоновки
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , , Истина);
	
	ПроцессорВывода =Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Новый ТаблицаЗначений);
		
	ТабРезультат = ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
	
	Для Каждого Стр Из  ТабРезультат Цикл
		НовСтр = ТаблицаОстатков.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, Стр);
	КонецЦикла;	
	
	НовСтр = ТаблицаОстатков.Добавить();

	НовСтр.ОстатокКО = ТабРезультат.Итог("ОстатокКО");
	НовСтр.ОстатокБюджетныхНазначений = ТабРезультат.Итог("ОстатокБюджетныхНазначений");
	НовСтр.Зарезервировано = ТабРезультат.Итог("Зарезервировано");
	НовСтр.Доступно = ТабРезультат.Итог("Доступно");
	
	Элементы.ТаблицаОстатковОстатокКО.Видимость = НЕ ТабРезультат.Итог("ОстатокКО") = 0;
	Элементы.ТаблицаОстатковОстатокБюджетныхНазначений.Видимость = НЕ ТабРезультат.Итог("ОстатокБюджетныхНазначений") = 0;
	
КонецПРоцедуры

&НаСервере
Процедура ОрганизацияОтборПриИзмененииНаСервере()
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Организация",Организация, ВидСравненияКомпоновкиДанных.Равно, "Организация", ЗначениеЗаполнено(Организация));
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ПрочиеДокументы.Отбор, "Организация",Организация, ВидСравненияКомпоновкиДанных.Равно, "Организация", ЗначениеЗаполнено(Организация));
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Выписки.Отбор, "Организация",Организация, ВидСравненияКомпоновкиДанных.Равно, "Организация", ЗначениеЗаполнено(Организация));
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ДокументыИнкассо.Отбор, "Организация",Организация, ВидСравненияКомпоновкиДанных.Равно, "Организация", ЗначениеЗаполнено(Организация));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СписокОрганизация", "Видимость", НЕ ЗначениеЗаполнено(Организация));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПрочиеДокументыОрганизация", "Видимость", НЕ ЗначениеЗаполнено(Организация));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ВыпискиОрганизация", "Видимость", НЕ ЗначениеЗаполнено(Организация));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДокументыИнкассоОрганизация", "Видимость", НЕ ЗначениеЗаполнено(Организация));
	
	Если ПоказыватьОстатки Тогда
		ОбновитьОстатки();
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ОтветственныйПриИзмененииНаСервере()
	
	//Добавим незаполненное значение
	СписокДляОтбора = Новый СписокЗначений();
	СписокДляОтбора.Добавить(Ответственный);
	СписокДляОтбора.Добавить(ПредопределенноеЗначение("Справочник.Пользователи.ПустаяСсылка"));		
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Ответственный", СписокДляОтбора, ВидСравненияКомпоновкиДанных.ВСписке, "Ответственный", ЗначениеЗаполнено(Ответственный));
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ПрочиеДокументы.Отбор, "Ответственный", СписокДляОтбора, ВидСравненияКомпоновкиДанных.ВСписке, "Ответственный", ЗначениеЗаполнено(Ответственный));
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Выписки.Отбор, "Ответственный", СписокДляОтбора, ВидСравненияКомпоновкиДанных.ВСписке, "Ответственный", ЗначениеЗаполнено(Ответственный));
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ДокументыИнкассо.Отбор, "Ответственный", СписокДляОтбора, ВидСравненияКомпоновкиДанных.ВСписке, "Ответственный", ЗначениеЗаполнено(Ответственный));
	
	Элементы.СписокОтветственный.Видимость 				= НЕ ЗначениеЗаполнено(Ответственный);
	Элементы.ПрочиеДокументыОтветственный.Видимость 	= НЕ ЗначениеЗаполнено(Ответственный);
	Элементы.ВыпискиОтветственный.Видимость 			= НЕ ЗначениеЗаполнено(Ответственный);
	Элементы.ДокументыИнкассоОтветственный.Видимость 	= НЕ ЗначениеЗаполнено(Ответственный);
	
	ОбщегоНазначенияВызовСервера.ХранилищеОбщихНастроекСохранить("Ответственный_ЖурналПлатежноРасчетныеДокументы", "", Ответственный);
	
КонецПроцедуры	

&НаСервере
Процедура ИФОПриИзмененииНаСервере()
	
	  ПравоеЗначение = Новый Массив;
	  ПравоеЗначение.Добавить(ИФО);
	  ПравоеЗначение.Добавить(Неопределено);
	  
	  ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "ИФО", ПравоеЗначение, ВидСравненияКомпоновкиДанных.ВСписке, "ИФО", ЗначениеЗаполнено(ИФО));
	  ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ПрочиеДокументы.Отбор, "ИФО", ПравоеЗначение, ВидСравненияКомпоновкиДанных.ВСписке, "ИФО", ЗначениеЗаполнено(ИФО));
	  ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ДокументыИнкассо.Отбор, "ИФО", ПравоеЗначение, ВидСравненияКомпоновкиДанных.ВСписке, "ИФО", ЗначениеЗаполнено(ИФО));
	  
	  Элементы.СписокИФО.Видимость = НЕ ЗначениеЗаполнено(ИФО);
	  Элементы.ПрочиеДокументыИФО.Видимость = НЕ ЗначениеЗаполнено(ИФО);
	  Элементы.ДокументыИнкассоИФО.Видимость = НЕ ЗначениеЗаполнено(ИФО);
	  
КонецПроцедуры

&НаСервере
Процедура ЛицевойСчетОтборПриИзмененииНаСервере()
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "ЛицевойСчет",ЛицевойСчет, ВидСравненияКомпоновкиДанных.Равно, "ЛицевойСчет", ЗначениеЗаполнено(ЛицевойСчет));
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ПрочиеДокументы.Отбор, "ЛицевойСчет",ЛицевойСчет, ВидСравненияКомпоновкиДанных.Равно, "ЛицевойСчет", ЗначениеЗаполнено(ЛицевойСчет));
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Выписки.Отбор, "ЛицевойСчет",ЛицевойСчет, ВидСравненияКомпоновкиДанных.Равно, "ЛицевойСчет", ЗначениеЗаполнено(ЛицевойСчет));
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ДокументыИнкассо.Отбор, "ЛицевойСчет",ЛицевойСчет, ВидСравненияКомпоновкиДанных.Равно, "ЛицевойСчет", ЗначениеЗаполнено(ЛицевойСчет));
	
	Если ПоказыватьОстатки Тогда
		ОбновитьОстатки();
	КонецЕсли;
	
КонецПроцедуры

