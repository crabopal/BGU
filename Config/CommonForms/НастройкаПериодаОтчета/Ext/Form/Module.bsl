//
// НачалоПериодаЭт - начало периода эталонное, которое было проставлено в диалог. Это значение может измениться только по клавише ОК.
// КонецПериодаЭт - конец периода эталонное, которое было проставлено в диалог. Это значение может измениться только по клавише ОК.
//

Перем Закладка;

&НаКлиенте
Процедура УстановитьИнтервал(аНачалоПериода, аКонецПериода) Экспорт
	
	Если ЗначениеЗаполнено(аНачалоПериода) Тогда
		НачалоПериодаЭт = аНачалоПериода;
	КонецЕсли;
	Если ЗначениеЗаполнено(аКонецПериода) Тогда
		КонецПериодаЭт = аКонецПериода;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачалоИнтервалаЧислоПриИзменении(Элемент)
	
	Если      НачалоИнтервала = 0 Тогда
		НачалоПериода = Дата(1, 1, 1);
	ИначеЕсли НачалоИнтервала = 1 Тогда
		НачалоПериода = НачалоГода(ТекущаяДата);//НачалоГода(КонецПериодаЭт);
	ИначеЕсли НачалоИнтервала = 2 Тогда
		НачалоПериода = НачалоКвартала(ТекущаяДата);//НачалоКвартала(КонецПериодаЭт);
	ИначеЕсли НачалоИнтервала = 3 Тогда
		НачалоПериода = НачалоМесяца(ТекущаяДата);//НачалоМесяца(КонецПериодаЭт);
	ИначеЕсли НачалоИнтервала = 4 Тогда
		НачалоПериода = НачалоНедели(ТекущаяДата);//НачалоНедели(КонецПериодаЭт);
	ИначеЕсли НачалоИнтервала = 5 Тогда
		НачалоПериода = НачалоДня(ТекущаяДата);//НачалоДня(КонецПериодаЭт);
	КонецЕсли;
	
	Элементы.НачалоПериода.Доступность = (НачалоИнтервала = 6);
	
	ОтобразитьИнтервал();
	
КонецПроцедуры

&НаКлиенте
Процедура КонецИнтервалаЧислоПриИзменении(Элемент)
	
	Если      КонецИнтервала = 0 Тогда
		КонецПериода = Дата(1,1,1);//Дата(3999, 11, 11);
	ИначеЕсли КонецИнтервала = 1 Тогда
		КонецПериода = КонецГода(ТекущаяДата);//КонецГода(КонецПериодаЭт);
	ИначеЕсли КонецИнтервала = 2 Тогда
		КонецПериода = КонецКвартала(ТекущаяДата);//КонецКвартала(КонецПериодаЭт);
	ИначеЕсли КонецИнтервала = 3 Тогда
		КонецПериода = КонецМесяца(ТекущаяДата);//КонецМесяца(КонецПериодаЭт);
	ИначеЕсли КонецИнтервала = 4 Тогда
		КонецПериода = КонецНедели(ТекущаяДата);//КонецНедели(КонецПериодаЭт);
	ИначеЕсли КонецИнтервала = 5 Тогда
		КонецПериода = КонецДня(ТекущаяДата);//КонецДня(КонецПериодаЭт);
	КонецЕсли;
	
	Элементы.КонецПериода.Доступность = (КонецИнтервала = 6);
	
	ОтобразитьИнтервал();
	
КонецПроцедуры

&НаКлиенте
Процедура ПериодЧислоПриИзменении(Элемент)
	Если      ПериодЧисло = 0 Тогда
		НачалоПериода = ?(ЗначениеЗаполнено(КонецПериода),НачалоГода(КонецПериода),НачалоГода(ТекущаяДата));
		КонецПериода  = ?(ЗначениеЗаполнено(КонецПериода),КонецГода(КонецПериода),КонецГода(ТекущаяДата));
	ИначеЕсли ПериодЧисло = 1 Тогда
		Если СНачалаГода Тогда
			НачалоПериода = ?(ЗначениеЗаполнено(КонецПериода),НачалоГода(КонецПериода),НачалоГода(ТекущаяДата));
		Иначе
			НачалоПериода = ?(ЗначениеЗаполнено(КонецПериода),НачалоКвартала(КонецПериода),НачалоКвартала(ТекущаяДата));
		КонецЕсли;
		КонецПериода = ?(ЗначениеЗаполнено(КонецПериода),КонецКвартала(КонецПериода),КонецКвартала(ТекущаяДата));
	ИначеЕсли ПериодЧисло = 2 Тогда
		Если СНачалаГода Тогда
			НачалоПериода = ?(ЗначениеЗаполнено(КонецПериода),НачалоГода(КонецПериода),НачалоГода(ТекущаяДата));
		ИначеЕсли СНачалаКвартала Тогда
			НачалоПериода = ?(ЗначениеЗаполнено(КонецПериода),НачалоКвартала(КонецПериода),НачалоКвартала(ТекущаяДата));
		Иначе
			НачалоПериода = ?(ЗначениеЗаполнено(КонецПериода),НачалоМесяца(КонецПериода),НачалоМесяца(ТекущаяДата));
		КонецЕсли;
		КонецПериода = ?(ЗначениеЗаполнено(КонецПериода),КонецМесяца(КонецПериода),КонецМесяца(ТекущаяДата));
	ИначеЕсли ПериодЧисло = 3 Тогда
		Если СНачалаГода Тогда
			НачалоПериода = ?(ЗначениеЗаполнено(КонецПериода),НачалоГода(КонецПериода),НачалоГода(ТекущаяДата));
		ИначеЕсли СНачалаКвартала Тогда
			НачалоПериода = ?(ЗначениеЗаполнено(КонецПериода),НачалоКвартала(КонецПериода),НачалоКвартала(ТекущаяДата));
		ИначеЕсли СНачалаМесяца Тогда
			НачалоПериода = ?(ЗначениеЗаполнено(КонецПериода),НачалоМесяца(КонецПериода),НачалоМесяца(ТекущаяДата));
		Иначе
			НачалоПериода = ?(ЗначениеЗаполнено(КонецПериода),НачалоДня(КонецПериода),НачалоДня(ТекущаяДата));
		КонецЕсли;
		КонецПериода = ?(ЗначениеЗаполнено(КонецПериода),КонецДня(КонецПериода),КонецДня(ТекущаяДата));
	ИначеЕсли ПериодЧисло = 3 Тогда
		Если СНачалаГода Тогда
			НачалоПериода = ?(ЗначениеЗаполнено(КонецПериода),НачалоГода(КонецПериода),НачалоГода(ТекущаяДата));
		ИначеЕсли СНачалаКвартала Тогда
			НачалоПериода = ?(ЗначениеЗаполнено(КонецПериода),НачалоКвартала(КонецПериода),НачалоКвартала(ТекущаяДата));
		ИначеЕсли СНачалаМесяца Тогда
			НачалоПериода = ?(ЗначениеЗаполнено(КонецПериода),НачалоМесяца(КонецПериода),НачалоМесяца(ТекущаяДата));
		Иначе
			НачалоПериода = ?(ЗначениеЗаполнено(КонецПериода),НачалоДня(КонецПериода),НачалоДня(ТекущаяДата));
		КонецЕсли;
	КонецЕсли;
	
	ПриИзмененииПериода();
	
	ОтобразитьИнтервал();
	
КонецПроцедуры

&НаКлиенте
Процедура СНачалаГодаПриИзменении(Элемент)
	
	Если СНачалаГода Тогда
		СНачалаКвартала = Ложь;
		СНачалаМесяца   = Ложь;
		НачалоПериода = НачалоГода(КонецПериода);
	Иначе
		Если      ПериодЧисло = 1 Тогда
			НачалоПериода = НачалоКвартала(КонецПериода);
		ИначеЕсли ПериодЧисло = 2 Тогда
			НачалоПериода = НачалоМесяца(КонецПериода);
		ИначеЕсли ПериодЧисло = 3 Тогда
			НачалоПериода = НачалоДня(КонецПериода);
		КонецЕсли;
	КонецЕсли;
	
	ОтобразитьИнтервал();
	
КонецПроцедуры

&НаКлиенте
Процедура СНачалаКварталаПриИзменении(Элемент)
	
	Если СНачалаКвартала Тогда
		СНачалаГода   = Ложь;
		СНачалаМесяца = Ложь;
		НачалоПериода = НачалоКвартала(КонецПериода);
	Иначе
		Если ПериодЧисло = 2 Тогда
			НачалоПериода = НачалоМесяца(КонецПериода);
		ИначеЕсли ПериодЧисло = 3 Тогда
			НачалоПериода = НачалоДня(КонецПериода);
		КонецЕсли;
	КонецЕсли;
	
	ОтобразитьИнтервал();
	
КонецПроцедуры

&НаКлиенте
Процедура СНачалаМесяцаПриИзменении(Элемент)
	
	Если СНачалаМесяца Тогда
		СНачалаГода     = Ложь;
		СНачалаКвартала = Ложь;
		НачалоПериода = НачалоМесяца(КонецПериода);
	Иначе
		НачалоПериода = НачалоДня(КонецПериода);
	КонецЕсли;
	
	ОтобразитьИнтервал();
	
КонецПроцедуры

&НаКлиенте
Процедура ГодРегулирование(Элемент, Направление, СтандартнаяОбработка)
	
	Если Направление = 1 Тогда // Увеличваем
		НачалоПериода = КонецГода(НачалоПериода) + 1;
		КонецПериода = КонецГода(НачалоПериода);
	Иначе
		КонецПериода = НачалоГода(НачалоПериода) - 1;
		НачалоПериода = НачалоГода(КонецПериода);
	КонецЕсли;
	
	ОтобразитьИнтервал();
	
КонецПроцедуры

&НаКлиенте
Процедура КварталРегулирование(Элемент, Направление, СтандартнаяОбработка)
	
	Если Направление = 1 Тогда // Увеличваем
		КонецПериода = КонецКвартала(КонецКвартала(КонецПериода) + 1);
	Иначе
		КонецПериода = НачалоКвартала(КонецПериода) - 1;
	КонецЕсли;
	
	Если СНачалаГода Тогда
		НачалоПериода = НачалоГода(КонецПериода);
	Иначе
		НачалоПериода = НачалоКвартала(КонецПериода);
	КонецЕсли;
	
	ОтобразитьИнтервал();
	
КонецПроцедуры

&НаКлиенте
Процедура МесяцРегулирование(Элемент, Направление, СтандартнаяОбработка)
	
	Если Направление = 1 Тогда // Увеличваем
		КонецПериода = КонецМесяца(КонецМесяца(КонецПериода) + 1);
	Иначе
		КонецПериода = НачалоМесяца(КонецПериода) - 1;
	КонецЕсли;
	
	Если СНачалаГода Тогда
		НачалоПериода = НачалоГода(КонецПериода);
	ИначеЕсли СНачалаКвартала Тогда
		НачалоПериода = НачалоКвартала(КонецПериода);
	Иначе
		НачалоПериода = НачалоМесяца(КонецПериода);
	КонецЕсли;
	
	ОтобразитьИнтервал();
	
КонецПроцедуры

&НаКлиенте
Процедура ДеньПриИзменении(Элемент)
	
	КонецПериода = КонецДня(День);
	
	Если СНачалаГода Тогда
		НачалоПериода = НачалоГода(КонецПериода);
	ИначеЕсли СНачалаКвартала Тогда
		НачалоПериода = НачалоКвартала(КонецПериода);
	ИначеЕсли СНачалаМесяца Тогда
		НачалоПериода = НачалоМесяца(КонецПериода);
	Иначе
		НачалоПериода = НачалоДня(КонецПериода);
	КонецЕсли;
	
	ОтобразитьИнтервал();
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Перем аКонецПериода,аНачалоПериода;
	
	Параметры.Свойство("НачалоПериода",НачалоПериода);
	Если ЗначениеЗаполнено(НачалоПериода) Тогда
		НачалоПериодаЭт = НачалоПериода;
	Иначе
		НачалоПериодаЭт = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Параметры.Свойство("КонецПериода",КонецПериода);
	Если ЗначениеЗаполнено(КонецПериода) Тогда
		КонецПериодаЭт = КонецПериода;
	Иначе
		КонецПериода   = Дата(1,1,1);//Дата(3999, 11, 11);
		КонецПериодаЭт = НачалоПериодаЭт;
	КонецЕсли;

	ИмяСтраницы = "Период";
	ТекущаяДата = ТекущаяДатаСеанса();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	//НачалоПериода = НачалоПериодаЭт;
	//КонецПериода = КонецПериодаЭт;
	
	УстановитьЗакладкуИнтервал();
	ПериодЧисло = УстановитьЗакладкуПериод();
	РасставитьГалки(ПериодЧисло);
	
	Элементы.Выбор.ТекущаяСтраница = Элементы.Выбор.ПодчиненныеЭлементы[ИмяСтраницы];
	
	ПриИзмененииПериода();
	
	ОтобразитьИнтервал();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗакладкуИнтервал()
	
	Если НЕ ЗначениеЗаполнено(НачалоПериода) Тогда
		НачалоИнтервала = 0;
	ИначеЕсли НачалоПериода = НачалоГода(НачалоПериода) И НачалоГода(ТекущаяДата) = НачалоГода(НачалоПериода) Тогда
		НачалоИнтервала = 1;
	ИначеЕсли НачалоПериода = НачалоКвартала(НачалоПериода) И НачалоКвартала(ТекущаяДата) = НачалоКвартала(НачалоПериода) Тогда
		НачалоИнтервала = 2;
	ИначеЕсли НачалоПериода = НачалоМесяца(НачалоПериода) И НачалоМесяца(ТекущаяДата) = НачалоМесяца(НачалоПериода) Тогда
		НачалоИнтервала = 3;
	ИначеЕсли НачалоПериода = НачалоНедели(НачалоПериода) И НачалоНедели(ТекущаяДата) = НачалоНедели(НачалоПериода) Тогда
		НачалоИнтервала = 4;
	ИначеЕсли НачалоПериода = НачалоДня(НачалоПериода) 
		И НачалоДня(НачалоПериода) = НачалоДня(КонецПериода) 
		И НачалоДня(НачалоПериода) = НачалоДня(ТекущаяДата) 
	Тогда
		НачалоИнтервала = 5;
	Иначе
		НачалоИнтервала = 6;
	КонецЕсли;
	
	Элементы.НачалоПериода.Доступность = (НачалоИнтервала = 6);
	
	Если НЕ ЗначениеЗаполнено(КонецПериода) Тогда// ИЛИ КонецПериода = Дата(3999,11,11) Тогда
		КонецИнтервала = 0;
	ИначеЕсли КонецДня(КонецПериода) = КонецГода(КонецПериода) И КонецГода(ТекущаяДата) = КонецГода(КонецПериода) Тогда
		КонецИнтервала = 1;
	ИначеЕсли КонецДня(КонецПериода) = КонецКвартала(КонецПериода) И КонецКвартала(ТекущаяДата) = КонецКвартала(КонецПериода) Тогда
		КонецИнтервала = 2;
	ИначеЕсли КонецДня(КонецПериода) = КонецМесяца(КонецПериода) И КонецМесяца(ТекущаяДата) = КонецМесяца(КонецПериода) Тогда
		КонецИнтервала = 3;
	ИначеЕсли КонецДня(КонецПериода) = КонецНедели(КонецПериода) И КонецНедели(ТекущаяДата) = КонецНедели(КонецПериода) Тогда
		КонецИнтервала = 4;
	ИначеЕсли НачалоДня(НачалоПериода) = НачалоДня(КонецПериода) И КонецДня(ТекущаяДата) = КонецДня(КонецПериода) Тогда
		КонецИнтервала = 5;
	Иначе
		КонецИнтервала = 6;
	КонецЕсли;
	
	Элементы.КонецПериода.Доступность = (КонецИнтервала = 6);
	
КонецПроцедуры

&НаКлиенте
Функция УстановитьЗакладкуПериод()
	
	_СНачалаГода     = (НачалоПериода = НачалоГода(НачалоПериода));
	_СНачалаКвартала = (НачалоПериода = НачалоКвартала(НачалоПериода));
	_СНачалаМесяца   = (НачалоПериода = НачалоМесяца(НачалоПериода));
	_ВОдномГоду      = (КонецГода(НачалоПериода)     = КонецГода(КонецПериода));
	_ВОдномКвартале  = (КонецКвартала(НачалоПериода) = КонецКвартала(КонецПериода));
	_ВОдномМесяце    = (КонецМесяца(НачалоПериода)   = КонецМесяца(КонецПериода));
	_ВОдинДень       = (КонецДня(НачалоПериода)      = КонецДня(КонецПериода));
	_ПоКонецГода     = (КонецДня(КонецПериода) = КонецГода(КонецПериода));
	_ПоКонецКвартала = (КонецДня(КонецПериода) = КонецКвартала(КонецПериода));
	_ПоКонецМесяца   = (КонецДня(КонецПериода) = КонецМесяца(КонецПериода));
	
	Если _СНачалаГода Тогда
		// Год
		Если _ПоКонецГода И _ВОдномГоду Тогда
			ПозицияПериода = 0;
		// Квартал
		ИначеЕсли _ПоКонецКвартала И _ВОдномГоду Тогда
			ПозицияПериода = 1;
		// Месяц
		ИначеЕсли _ПоКонецМесяца И _ВОдномГоду Тогда
			ПозицияПериода = 2;
		// День
		ИначеЕсли НачалоПериода<>Дата(1,1,1) И _ВОдномГоду Тогда //И КонецПериода<>Дата(3999,11,11) 
			ПозицияПериода = 3;
		Иначе
			ПозицияПериода = 4;
		КонецЕсли
	ИначеЕсли _СНачалаКвартала Тогда
		// Квартал
		Если _ПоКонецКвартала И _ВОдномКвартале Тогда
			ПозицияПериода = 1;
		// Месяц
		ИначеЕсли _ПоКонецМесяца И _ВОдномКвартале Тогда
			ПозицияПериода = 2;
		// День
		ИначеЕсли _ВОдномКвартале Тогда
			ПозицияПериода = 3;
		Иначе
			ПозицияПериода = 4;
		КонецЕсли
	ИначеЕсли _СНачалаМесяца Тогда
		// Месяц
		Если _ПоКонецМесяца И _ВОдномКвартале Тогда
			ПозицияПериода = 2;
		// День
		ИначеЕсли _ВОдномМесяце Тогда
			ПозицияПериода = 3;
		Иначе
			ПозицияПериода = 4;
		КонецЕсли
	ИначеЕсли _ВОдинДень Тогда
		ПозицияПериода = 3;
	Иначе
		ПозицияПериода = 4;
	КонецЕсли;
	
	Возврат ПозицияПериода;
	
КонецФункции

&НаКлиенте
Процедура РасставитьГалки(ГдеПериод)
	
	Если      ГдеПериод = 0 Тогда
		СНачалаГода = Ложь;
		СНачалаКвартала = Ложь;
		СНачалаМесяца = Ложь;
	ИначеЕсли ГдеПериод = 1 Тогда
		СНачалаГода = (КонецКвартала(НачалоПериода) <> КонецКвартала(КонецПериода));
		СНачалаКвартала = Ложь;
		СНачалаМесяца = Ложь;
	ИначеЕсли ГдеПериод = 2 Тогда
		Если КонецМесяца(НачалоПериода) <> КонецМесяца(КонецПериода) Тогда
			Если НачалоПериода = НачалоГода(НачалоПериода) Тогда
				СНачалаГода = Истина;
				СНачалаКвартала = Ложь;
			ИначеЕсли НачалоПериода = НачалоКвартала(НачалоПериода) Тогда
				СНачалаГода = Ложь;
				СНачалаКвартала = Истина;
			КонецЕсли;
		КонецЕсли;
		СНачалаМесяца = Ложь;
	ИначеЕсли ГдеПериод = 3 Тогда
		Если КонецДня(НачалоПериода) <> КонецДня(КонецПериода) Тогда
			Если НачалоПериода = НачалоГода(НачалоПериода) Тогда
				СНачалаГода = Истина;
				СНачалаКвартала = Ложь;
				СНачалаМесяца = Ложь;
			ИначеЕсли НачалоПериода = НачалоКвартала(НачалоПериода) Тогда
				СНачалаГода = Ложь;
				СНачалаКвартала = Истина;
				СНачалаМесяца = Ложь;
			ИначеЕсли НачалоПериода = НачалоМесяца(НачалоПериода) Тогда
				СНачалаГода = Ложь;
				СНачалаКвартала = Ложь;
				СНачалаМесяца = Истина;
			КонецЕсли;
		КонецЕсли;
	Иначе
		СНачалаГода = Ложь;
		СНачалаКвартала = Ложь;
		СНачалаМесяца = Ложь;
	КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииПериода()
	
	Для каждого Элемент из ЭУПериод Цикл
		Элементы[Элемент.Ключ].Доступность = (Элемент.Значение.Найти(ПериодЧисло) <> Неопределено);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтобразитьИнтервал()
	Отказ = Ложь;
	ОчиститьСообщения();
	КонечнаяДатаБезОграничения = КонецПериода = Дата(1,1,1); //КонецПериода = Дата(3999, 11, 11) ИЛИ
	Если ЗначениеЗаполнено(КонецПериода) И НачалоПериода > КонецПериода Тогда
		Отказ = Истина;
	КонецЕсли;
	Если НЕ Отказ Тогда
		Если ЗначениеЗаполнено(КонецПериода) Тогда
			ВыбраннаяДата = ПредставлениеПериода(НачалоДня(НачалоПериода), КонецДня(КонецПериода), "ФП");
		Иначе
			ВыбраннаяДата = ПредставлениеПериода(НачалоДня(НачалоПериода), КонецДня(Дата(3999, 11, 11)), "ФП");
		КонецЕсли;
		Если КонечнаяДатаБезОграничения Тогда
			ВыбраннаяДата = СтрЗаменить(ВыбраннаяДата, Сред(ВыбраннаяДата, Найти(ВыбраннаяДата, " - ")), " - ...");
		КонецЕсли;
	Иначе
		ВыбраннаяДата = НСтр("ru = 'Выбран не правильный период.'");;
	КонецЕсли;
	ДатаПредставления = ?(ЗначениеЗаполнено(КонецПериода),КонецПериода,ТекущаяДата);
	Год           = ПредставлениеПериода(НачалоГода(ДатаПредставления), КонецГода(ДатаПредставления), "ФП");
	Квартал       = ПредставлениеПериода(НачалоКвартала(ДатаПредставления), КонецКвартала(ДатаПредставления), "ФП");
	Месяц         = ПредставлениеПериода(НачалоМесяца(ДатаПредставления), КонецМесяца(ДатаПредставления), "ФП");
	День          = ДатаПредставления;
	ДатаНачала    = НачалоПериода;
	ДатаКонца     = КонецПериода;

КонецПроцедуры

&НаКлиенте
Процедура НачалоПериодаПриИзменении(Элемент)
	
	НачалоПериода = ДатаНачала;
	ОтобразитьИнтервал();
	
КонецПроцедуры

&НаКлиенте
Процедура КонецПериодаПриИзменении(Элемент)
	
	КонецПериода = ДатаКонца;
	ОтобразитьИнтервал();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	ИмяСтраницы = ТекущаяСтраница.Имя;
	
	Если ТекущаяСтраница.Имя = "Интервал" Тогда
		УстановитьЗакладкуИнтервал();
	Иначе
		ПериодЧисло = УстановитьЗакладкуПериод();
		РасставитьГалки(ПериодЧисло);
	КонецЕсли;
	
	ПриИзмененииПериода();
	
КонецПроцедуры

&НаКлиенте
Процедура НачалоПериодаПериодПриИзменении(Элемент)
	
	НачалоПериода = ДатаНачала;
	ОтобразитьИнтервал();
	УстановленныйПериод = УстановитьЗакладкуПериод();
	РасставитьГалки(УстановленныйПериод);
	
КонецПроцедуры

&НаКлиенте
Процедура КонецПериодаПериодПриИзменении(Элемент)
	
	КонецПериода = ДатаКонца;
	ОтобразитьИнтервал();
	УстановленныйПериод = УстановитьЗакладкуПериод();
	РасставитьГалки(УстановленныйПериод);
	
КонецПроцедуры

&НаСервере
Процедура ПриСохраненииДанныхВНастройкахНаСервере(Настройки)
	
	Настройки.Вставить("ИмяПроцедуры", ИмяСтраницы);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	Имя = Настройки.Получить("ИмяПроцедуры");
	Если Имя <> Неопределено Тогда
		ИмяСтраницы = Имя;
	КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ОК(Команда)
	
	ОчиститьСообщения();
	Если ЗначениеЗаполнено(КонецПериода) И НачалоПериода>КонецПериода Тогда
		ТекстСообщения = НСтр("ru = 'Дата начала периода не может быть больше даты конца периода'");		
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "ДатаНачала");
		Возврат;
	КонецЕсли;
	
	Закрыть(Новый Структура("НачалоПериода,КонецПериода", НачалоПериода, КонецПериода));//?(КонецПериода = Дата(3999, 11, 11), Дата(1, 1, 1), КонецПериода)));
	
КонецПроцедуры

// Элемент "СНачалаГода" доступен для Значений ПериодЧисло {1, 2, 3}
ЭУПериод = Новый Структура();
ЭУПериод.Вставить("Год", Новый Массив);
ЭУПериод["Год"].Добавить(0);
ЭУПериод.Вставить("Квартал", Новый Массив);
ЭУПериод["Квартал"].Добавить(1);
ЭУПериод.Вставить("СНачалаГода", Новый Массив);
ЭУПериод["СНачалаГода"].Добавить(1);
ЭУПериод["СНачалаГода"].Добавить(2);
ЭУПериод["СНачалаГода"].Добавить(3);
ЭУПериод.Вставить("Месяц", Новый Массив);
ЭУПериод["Месяц"].Добавить(2);
ЭУПериод.Вставить("СНачалаКвартала", Новый Массив);
ЭУПериод["СНачалаКвартала"].Добавить(2);
ЭУПериод["СНачалаКвартала"].Добавить(3);
ЭУПериод.Вставить("День", Новый Массив);
ЭУПериод["День"].Добавить(3);
ЭУПериод.Вставить("СНачалаМесяца", Новый Массив);
ЭУПериод["СНачалаМесяца"].Добавить(3);
ЭУПериод.Вставить("НачалоПериодаПериод", Новый Массив);
ЭУПериод["НачалоПериодаПериод"].Добавить(4);
ЭУПериод.Вставить("КонецПериодаПериод", Новый Массив);
ЭУПериод["КонецПериодаПериод"].Добавить(4);

Закладка = "Интервал";

