#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура НалогСборПлатежПриИзмененииСервер()
	
	НастройкаНалоговыхРеквизитов = БухгалтерскийУчет.ПолучитьНастройкиНалоговогоПлатежа(НалогСборПлатеж, Истина);
	
КонецПроцедуры	

&НаСервере
Процедура ПроверитьРеквизитыНалоговогоПлатежа()
	
	//Пока ничего не проверяем
	Возврат;
	
	Если НЕ ПолеВводаСтатусСоставителя =  НастройкаНалоговыхРеквизитов.СтатусСоставителя Тогда
		Элементы.Контроль101.Заголовок = "!*";
	Иначе
		Элементы.Контроль101.Заголовок = "";
	КонецЕсли;
	
	Если НЕ КодБКНалога = НастройкаНалоговыхРеквизитов.КодБКНалога Тогда
		Элементы.Контроль104.Заголовок = "!*";
	Иначе
		Элементы.Контроль104.Заголовок = "";
	КонецЕсли;
	
	Если НЕ КодОКАТО = НастройкаНалоговыхРеквизитов.КодОКТМО
         И НЕ КодОКАТО = НастройкаНалоговыхРеквизитов.КодОКАТО Тогда
		Элементы.Контроль105.Заголовок = "!*";
	Иначе
		Элементы.Контроль105.Заголовок = "";
	КонецЕсли;

    Если НЕ ПолеВводаПоказательОснования = НастройкаНалоговыхРеквизитов.ПоказательОснования Тогда
		Элементы.Контроль106.Заголовок = "!*";
	Иначе
		Элементы.Контроль106.Заголовок = "";
	КонецЕсли;

	Если НЕ ПолеВводаПоказательПериода = НастройкаНалоговыхРеквизитов.ПоказательПериода
		ИЛИ (НЕ ПолеВводаКодТаможенногоОргана = НастройкаНалоговыхРеквизитов.КодТаможенногоОргана И ТаможенныйПлатеж) Тогда
		Элементы.Контроль107.Заголовок = "!*";
	Иначе
		Элементы.Контроль107.Заголовок = "";
	КонецЕсли;

	Если НЕ ПолеВводаПоказательТипа = НастройкаНалоговыхРеквизитов.ПоказательТипа Тогда
		Элементы.Контроль110.Заголовок = "!*";
	Иначе
		Элементы.Контроль110.Заголовок = "";
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура ПриИзмененииРеквизитовПериодаНаКлиенте()
	
	ЗначенияРеквизитов = Новый Структура("ПоказательПериода, ПолеВводаГодПериода, ПолеВводаНомерПериода, ПолеВводаДатаПериода, ПолеВводаКодТаможенногоОргана");
    ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, ЭтаФорма);
	БухгалтерскийУчетКлиентСервер.ОпределитьРеквизитыНалоговогоПериода(ПолеВводаПоказательПериода, ТаможенныйПлатеж, Дата, ЗначенияРеквизитов);
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ЗначенияРеквизитов);
	БухгалтерскийУчетКлиентСервер.УстановитьВидимостьРеквизитовНалоговогоПериода(ЭтаФорма);
	БухгалтерскийУчетКлиентСервер.ЗаполнитьНезаполненныеНалоговыеРеквизиты(ЭтаФорма, , ЗаполнятьНезаполненныеНалоговыеРеквизитыНулем, Дата);

КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииПоказателяНаклиенте(ИмяПоказателя) 
	
	РеквизитыПлатежа = Новый Структура(ИмяПоказателя, ЭтаФорма[ИмяПоказателя]);
		
	ЗаполнитьЗначенияСвойств(ЭтаФорма, БухгалтерскийУчетКлиентСервер.ПолучитьЗначенияНалоговыхРеквизитов(РеквизитыПлатежа));

	БухгалтерскийУчетКлиентСервер.УстановитьВидимостьРеквизитовНалоговогоПериода(ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииРеквизитаНаКлиенте(ИмяРеквизита, ЗначениеРеквизита)
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, БухгалтерскийУчетКлиентСервер.НалоговыеРеквизитыПлатежногоДокумента(Новый Структура(ИмяРеквизита, ЗначениеРеквизита)));
	
	БухгалтерскийУчетКлиентСервер.ЗаполнитьНезаполненныеНалоговыеРеквизиты(ЭтаФорма, , ЗаполнятьНезаполненныеНалоговыеРеквизитыНулем, Дата);

КонецПроцедуры

#КонецОбласти


