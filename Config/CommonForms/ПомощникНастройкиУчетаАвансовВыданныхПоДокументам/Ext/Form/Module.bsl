
#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьНачальнуюНастройкуСчетов();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоСчетов

&НаКлиенте
Процедура ДеревоСчетовСубконтоАвансыПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоСчетов.ТекущиеДанные;
	Если ТекущиеДанные.СубконтоАвансы = 2 Тогда
		ТекущиеДанные.СубконтоАвансы = 0;
	КонецЕсли;
	УстановитьПометкуПодчиненным(ТекущиеДанные, ТекущиеДанные.СубконтоАвансы);
	УстановитьПометкуРодителям(ТекущиеДанные);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПеречитатьНастройкиСчетов(Команда)
	СчетаПрежние.Очистить();
	ЗаполнитьНачальнуюНастройкуСчетов();
	Модифицированность = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура Готово(Команда)
	УстановитьНовыеНастройкиПоСубконто();
	ОповеститьОбИзменении(Тип("ПланСчетовСсылка.ЕПСБУ"));
	Закрыть();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьНачальнуюНастройкуСчетов()

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Счет206", БухгалтерскийУчетПовтИсп.ПолучитьМассивСчетов("206.00"));	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЕПСБУ.Ссылка КАК Ссылка,
	               |	ВЫБОР
	               |		КОГДА ЕПСБУВидыСубконто.Ссылка ЕСТЬ NULL
	               |			ТОГДА 0
	               |		ИНАЧЕ 1
	               |	КОНЕЦ КАК СубконтоАвансы,
	               |	ЕПСБУ.Наименование КАК Наименование,
	               |	ЕПСБУ.ЭлементГруппа КАК ЭлементГруппа
	               |ИЗ
	               |	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	               |		ПО ЕПСБУ.Ссылка = ЕПСБУВидыСубконто.Ссылка
	               |			И (ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ДокументыРасчетов))
	               |			И (ЕПСБУ.ЭлементГруппа = ЛОЖЬ)
	               |ГДЕ
	               |	ЕПСБУ.Ссылка В(&Счет206)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЕПСБУ.Порядок
	               |ИТОГИ ПО
	               |	Ссылка ТОЛЬКО ИЕРАРХИЯ";
				   
	Дерево = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);				   
	ДобавитьСчетаВДеревоФормыИерархически(ДеревоСчетов, Дерево, Неопределено);

КонецПроцедуры // ЗаполнитьНачальнуюНастройкуСчетов()

&НаСервере
Процедура ДобавитьСчетаВДеревоФормыИерархически(ТекВетвь, Дерево, ТекущийЭлемент)

	НачальнаяСтрокаДляУстановкиФлагов = Неопределено;
	Для Каждого Выборка Из Дерево.Строки Цикл
		
		Если Выборка.Ссылка = ТекущийЭлемент Тогда
			Продолжить;
		КонецЕсли;
		
		НовСтрока = ТекВетвь.ПолучитьЭлементы().Добавить();
		ЗаполнитьЗначенияСвойств(НовСтрока, Выборка);
		
		Если Выборка.СубконтоАвансы = 1 Тогда
			СчетаПрежние.Добавить(Выборка.Ссылка);
		КонецЕсли;
		
		ДобавитьСчетаВДеревоФормыИерархически(НовСтрока, Выборка, Выборка.Ссылка);
		
		Если НЕ Выборка.ЭлементГруппа И НачальнаяСтрокаДляУстановкиФлагов = Неопределено Тогда
			НачальнаяСтрокаДляУстановкиФлагов = НовСтрока;
		КонецЕсли;
		
	КонецЦикла;
	
	Если НачальнаяСтрокаДляУстановкиФлагов <> Неопределено Тогда
		УстановитьПометкуРодителям(НачальнаяСтрокаДляУстановкиФлагов);
	КонецЕсли;

КонецПроцедуры // ДобавитьСчетаВДеревоИерархически()

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПометкуПодчиненным(ТекВетвь, ЗначениеПометки)

	Для каждого Элемент Из ТекВетвь.ПолучитьЭлементы() Цикл
	
		Элемент.СубконтоАвансы = ЗначениеПометки;
		
		Если Элемент.ЭлементГруппа Тогда
			УстановитьПометкуПодчиненным(Элемент, ЗначениеПометки);	
		КонецЕсли;
	
	КонецЦикла; 

КонецПроцедуры // УстановитьПометкуПодчиненным()

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПометкуРодителям(ТекВетвь)

	Родитель = ТекВетвь.ПолучитьРодителя();
	Если Родитель = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗначениеПометки = -1;
	Для каждого Элемент Из Родитель.ПолучитьЭлементы() Цикл
		Если Элемент.СубконтоАвансы = 2 Тогда
			ЗначениеПометки = 2;
			Прервать;
		ИначеЕсли Элемент.СубконтоАвансы <> ЗначениеПометки Тогда
			Если ЗначениеПометки >= 0 Тогда
				ЗначениеПометки = 2;
				Прервать;
			Иначе
				ЗначениеПометки = Элемент.СубконтоАвансы;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Родитель.СубконтоАвансы = ЗначениеПометки;
	УстановитьПометкуРодителям(Родитель);
	
КонецПроцедуры // УстановитьПометкуРодителям()

&НаСервере
Процедура УстановитьНовыеНастройкиПоСубконто()

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Счет206", БухгалтерскийУчетПовтИсп.ПолучитьМассивСчетов("206.00"));		
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЕПСБУ.Ссылка КАК Ссылка,
	               |	ЕПСБУВидыСубконто.НомерСтроки КАК НомерСтроки
	               |ИЗ
	               |	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	               |		ПО ЕПСБУ.Ссылка = ЕПСБУВидыСубконто.Ссылка
	               |			И (ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ДокументыРасчетов))
	               |ГДЕ
	               |	ЕПСБУ.Ссылка В(&Счет206)";
	Выборка = Запрос.Выполнить().Выбрать();
	
	СчетаНовые = Новый Массив;
	ЗаполнитьСчетаССубконтоИзДерева(ДеревоСчетов, СчетаНовые);
	
	НачатьТранзакцию();
	
	Пока Выборка.Следующий() Цикл
		
		Если СчетаНовые.Найти(Выборка.Ссылка) <> Неопределено Тогда
			СчетаНовые.Удалить(СчетаНовые.Найти(Выборка.Ссылка));		
			Продолжить;
		КонецЕсли;
		
		СчетОбъект = Выборка.Ссылка.ПолучитьОбъект();
		СчетОбъект.Заблокировать();
		СчетОбъект.ВидыСубконто.Удалить(Выборка.НомерСтроки - 1);
		СчетОбъект.Записать();
		
	КонецЦикла;
	
	Для каждого СчетНовый Из СчетаНовые Цикл
	
		СчетОбъект = СчетНовый.ПолучитьОбъект();
		СчетОбъект.Заблокировать();
		НовоеСубконто = СчетОбъект.ВидыСубконто.Добавить();
		НовоеСубконто.ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ДокументыРасчетов;
		НовоеСубконто.Количественный = Истина;
		НовоеСубконто.Валютный = Истина;
		НовоеСубконто.Суммовой = Истина;
		СчетОбъект.Записать();
	
	КонецЦикла; 
	
	ЗафиксироватьТранзакцию();
	
	ОбновитьПовторноИспользуемыеЗначения();

КонецПроцедуры // УстановитьНовыеНастройкиПоСубконто()

&НаСервере
Процедура ЗаполнитьСчетаССубконтоИзДерева(ТекВетвь, СчетаНовые)

	Для каждого ТекСтрока Из ТекВетвь.ПолучитьЭлементы() Цикл
	
		Если ТекСтрока.ЭлементГруппа Тогда
			ЗаполнитьСчетаССубконтоИзДерева(ТекСтрока, СчетаНовые);
		ИначеЕсли ТекСтрока.СубконтоАвансы Тогда
			СчетаНовые.Добавить(ТекСтрока.Ссылка);
		КонецЕсли;
	
	КонецЦикла;  

КонецПроцедуры // ЗаполнитьСчетаССубконтоИзДерева()

#КонецОбласти
