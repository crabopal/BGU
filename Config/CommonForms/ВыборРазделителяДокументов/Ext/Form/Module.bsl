#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если ТипЗнч(Параметры.РазделителиДокументов) = Тип("Структура") Тогда
		УправлениеНФА.ЗаполнитьТаблицуРазделителиДокументов(Параметры.РазделителиДокументов, ЭтотОбъект);
	КонецЕсли;	
	ЗакрыватьПриВыборе = Истина;  
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выбрать(Команда)
	Результат = РезультатВыбора();
	Закрыть(Результат);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометки(Команда)
	Для каждого ТекСтрока из РазделителиДокументов Цикл
		ТекСтрока.Выбран = Истина;
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажки(Команда)
	Для каждого ТекСтрока из РазделителиДокументов Цикл
		ТекСтрока.Выбран = Ложь;
	КонецЦикла;	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция РезультатВыбора()
	Результат = Новый Массив;
	
	СтрокаПолей = "";
	Таблица = ДанныеФормыВЗначение(РазделителиДокументов, Тип("ТаблицаЗначений"));
	Для каждого ТекКолонка из Таблица.Колонки Цикл
		СтрокаПолей = СтрокаПолей + ?(Таблица.Колонки.Индекс(ТекКолонка) = 0, "", ", ") + ТекКолонка.Имя;
	КонецЦикла;	
	
	Для Каждого ТекСтрока из РазделителиДокументов Цикл
		Если НЕ ТекСтрока.Выбран Тогда
			Продолжить;
		КонецЕсли;	
		
		СтрокаРезультата = Новый Структура(СтрокаПолей);
		ЗаполнитьЗначенияСвойств(СтрокаРезультата, ТекСтрока);
		Результат.Добавить(СтрокаРезультата);
	КонецЦикла;	
	
	Возврат Результат;
КонецФункции	

#КонецОбласти
