////////////////////////////////////////////////////////////////////////////////
//	Форма "Список документов, введенных на основании"
////////////////////////////////////////////////////////////////////////////////
//
// Параметры формы:
//	ДокументОснованиеСсылка		- Ссылка на документ	-
//									используется для поиска документов, введенных на основании него.
//									Обязательный параметр.
//
//	ДополнительныйПараметр		- Произвольный	-
//									используется для уточнения получаемых настроек механизма
//									из модуля менеджера документа-основания.
//									Опциональный параметр.
//
//	Количество								Откуда берется список	Флажки		Количество						
//	переданных		Условие					видов документов		выводятся	параметров						
//	флажков									(область выборки)		на форме	в запросе						
//	-------------------------------------------------------------------------------------------------------
//	Вариант 1
//	0										Описание колонок		Нет			1 (ДокументОснованиеСсылка)		
//
//	Вариант 2
//	Основной предполагаемый сценарий
//	>0			явно указан хотя бы один	Массив флажков,			Да			Количество видов документов
//				вид документа для			(но только те виды,
//				какого-либо флажка			которые есть в
//											описании колонок)
//
//	Вариант 3
//	Самый маловероятный сценарий
//	>0			во всем массиве флажков		Описание колонок		Да			1 (ДокументОснованиеСсылка)
//				явно не упомянут			
//				ни один вид документа
//
//	Замечания
//	---------
//	* Если для какого-то флажка явно не заданы виды документов,
//		то это означает выбор всех видов документов,
//		упомянутых в текущей области выборки.
//	* Выбираются документы какого-то определенного вида,
//		если установлен хотя бы 1 флажок, который привязан
//		(явно или неявно) к такому виду документов.
//	* Установленный флажок имеет приоритет перед сброшенным,
//		если оба эти флажка привязаны к одному (общему) виду документов.

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВидДокументаОснования = Параметры["ДокументОснованиеСсылка"].Метаданные().Имя;
	
	// Настройки механизма
	НастройкиФормыСписка = Документы[ВидДокументаОснования].ВводНаОсновании_НастройкиФормыСпискаДокументовВведенныхНаОсновании(Параметры["ДополнительныйПараметр"]);
	ОбработанныеНастройкиФормыСписка = ВводНаОсновании.ОбработатьНастройкиФормыСписка(НастройкиФормыСписка);
	
	Список.ТекстЗапроса	= ОбработанныеНастройкиФормыСписка["ТекстЗапроса"];
	ПараметрыЗапроса	= ОбработанныеНастройкиФормыСписка["ПараметрыЗапроса"];
	
	СоздатьКолонки(ОбработанныеНастройкиФормыСписка);
	СоздатьФлажки(ОбработанныеНастройкиФормыСписка);
	
	Элементы["_ФлажокДляПримера"].Видимость = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьСписокДокументов();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура Подключаемый_ПриИзмененииФлажка(Элемент)
	
	ОбновитьСписокДокументов();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_Список

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ПоказатьЗначение(, Элемент.ТекущиеДанные.Ссылка);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы
//Код процедур и функций
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СоздатьКолонки(ОбработанныеНастройкиФормыСписка)
	
	СтруктураОписаниеКолонок = ОбработанныеНастройкиФормыСписка["СтруктураОписаниеКолонок"];
	
	ИмяТаблицыФормы = "Список";
	
	НеСоздаваемыеКолонки = Новый Структура("
		|ВидДокумента,
		|СинонимВидаДокумента,
		|Номер,
		|Дата,
		|Проведен,
		|ПометкаУдаления,
		|Ссылка,
		|Комментарий");
	
	//---
	// Создаем новые элементы формы (колонки)
	//---
	РодительскаяГруппа = Элементы["Список"];
	Для Каждого ЭлементОписание Из СтруктураОписаниеКолонок Цикл
		ИмяКолонки		= ЭлементОписание.Ключ;
		ОписаниеКолонки	= ЭлементОписание.Значение;
		
		ПропуститьКолонку = НеСоздаваемыеКолонки.Свойство(ИмяКолонки);
		
		Если ПропуститьКолонку Тогда
			// Например, такая колонка уже есть (создана вручную)
			Продолжить;
		КонецЕсли;
		
		ИмяЭлемента = ИмяТаблицыФормы + ИмяКолонки;
		
		НовыйЭлемент = Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), РодительскаяГруппа);
		НовыйЭлемент.ПутьКДанным	= ИмяТаблицыФормы + "." + ИмяКолонки;
		НовыйЭлемент.Заголовок		= ОписаниеКолонки["Заголовок"];
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СоздатьФлажки(ОбработанныеНастройкиФормыСписка)
	
	ИспользуемыеФлажки = ОбработанныеНастройкиФормыСписка["ИспользуемыеФлажки"];
	
	Если ИспользуемыеФлажки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	//---
	// Добавляем реквизиты формы (флажки)
	//---
	ДобавляемыеРеквизиты = Новый Массив();
	Для Каждого ЭлементОписание Из ИспользуемыеФлажки Цикл
		ИмяРеквизита = ЭлементОписание["Имя"];
		
		НовыйРеквизит = Новый РеквизитФормы(ИмяРеквизита, Новый ОписаниеТипов("Булево"));
		ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	КонецЦикла;
	ЭтаФорма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	//---
	// Создаем новые элементы формы (флажки)
	//---
	РодительскаяГруппа = Элементы["ГруппаФлажки"];
	Для Каждого ЭлементОписание Из ИспользуемыеФлажки Цикл
		ИмяРеквизита	= ЭлементОписание["Имя"];
		ИмяЭлемента		= ИмяРеквизита;
		
		ЗначениеФлажкаПоУмолчанию = Истина;
		ЭтаФорма[ИмяРеквизита] = ЗначениеФлажкаПоУмолчанию;
		
		НовыйЭлемент = Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), РодительскаяГруппа);
		НовыйЭлемент.ПутьКДанным		= ИмяРеквизита;
		НовыйЭлемент.Вид				= ВидПоляФормы.ПолеФлажка;
		НовыйЭлемент.Заголовок			= ЭлементОписание["Заголовок"];
		НовыйЭлемент.ПоложениеЗаголовка	= ПоложениеЗаголовкаЭлементаФормы.Право;
		
		ИмяСобытия		= "ПриИзменении";
		ИмяОбработчика	= "Подключаемый_ПриИзмененииФлажка";
		НовыйЭлемент.УстановитьДействие(ИмяСобытия, ИмяОбработчика);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписокДокументов()
	
	Для Каждого ЭлементПараметр Из ПараметрыЗапроса Цикл
		ИмяПараметра	= ЭлементПараметр["ИмяПараметра"];
		ИменаФлажков	= ЭлементПараметр["ИменаФлажков"];
		
		УстановитьПараметр = Ложь;
		
		Если ИменаФлажков.Количество() > 0 Тогда
			// При наличии флажков, устанавливаем параметр,
			// только если установлен хотя бы один флажок
			Для Каждого ИмяФлажка Из ИменаФлажков Цикл
				ЗначениеФлажка = ЭтаФорма[ИмяФлажка];
				Если ЗначениеФлажка = Истина Тогда
					УстановитьПараметр = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		Иначе
			// Устанавливаем параметр всегда
			УстановитьПараметр = Истина;
		КонецЕсли;
		
		Если УстановитьПараметр Тогда
			ЗначениеПараметра = Параметры["ДокументОснованиеСсылка"];
		Иначе
			ЗначениеПараметра = ""; // заведомо несуществующая ссылка на документ
		КонецЕсли;
		
		Список.Параметры.УстановитьЗначениеПараметра(ИмяПараметра, ЗначениеПараметра);
	КонецЦикла;
	
	Элементы["Список"].Обновить();
	
КонецПроцедуры

#КонецОбласти

#Область ИнформационныйЦентр
//Код процедур и функций
#КонецОбласти
