#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("ТекстовыйДокумент") Тогда
		ТекстовыйДокумент = Параметры.ТекстовыйДокумент;
	КонецЕсли;
	Если Параметры.Свойство("ДокументОснование") Тогда
		ДокументОснование = Параметры.ДокументОснование;
	КонецЕсли;
	Если Параметры.Свойство("ИдентификаторЗаписи") Тогда
		ИдентификаторЗаписи = Параметры.ИдентификаторЗаписи;
	КонецЕсли;
	Если Параметры.Свойство("НомерЧекаККМ") Тогда
		НомерЧекаККМ = Параметры.НомерЧекаККМ;
	КонецЕсли;
	
	УстановитьВидимостьЭлементовФормы();
	 
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьФискальнуюОперацию(Команда)
	
	Если ЗначениеЗаполнено(ДокументОснование) Тогда
		Если ЗначениеЗаполнено(НомерЧекаККМ) Тогда
			ДанныеЧека = ДанныеЧекаГруппыПлатежей(ДокументОснование, НомерЧекаККМ);
			ИдентификаторЗаписи = ДанныеЧека.ИдентификаторЗаписи;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИдентификаторЗаписи) Тогда
			СтруктураДанных = Новый Структура;
			СтруктураДанных.Вставить("ДокументОснование", ДокументОснование);
			СтруктураДанных.Вставить("ИдентификаторЗаписи", ИдентификаторЗаписи);
			
			МассивКлюча = Новый Массив;
			МассивКлюча.Добавить(СтруктураДанных);
			
			КлючЗаписи = Новый ("РегистрСведенийКлючЗаписи.ФискальныеОперации", МассивКлюча);
			
			СтруктураКлюча = Новый Структура;
			СтруктураКлюча.Вставить("Ключ", КлючЗаписи);
			
			Попытка
				ОткрытьФорму("РегистрСведений.ФискальныеОперации.Форма.ФормаЗаписи", СтруктураКлюча, ЭтаФорма);
			Исключение
				ТекстСообщения = НСтр("ru = 'Фискальная операция не найдена!'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			КонецПопытки;	
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСписокФискальныхОпераций(Команда)
	ПараметрыОтбораПоДокументу = Новый Структура; 
    Отбор = Новый Структура; 
    Отбор.Вставить("ДокументОснование", ДокументОснование);
    ПараметрыОтбораПоДокументу.Вставить("Отбор", Отбор); 
     
    ОткрытьФорму("РегистрСведений.ФискальныеОперации.ФормаСписка", ПараметрыОтбораПоДокументу);	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьВидимостьЭлементовФормы()
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОткрытьФискальнуюОперацию",
		"Видимость", НомерЧекаККМ<>0 ИЛИ ЗначениеЗаполнено(ИдентификаторЗаписи));
	
КонецПроцедуры

&НаСервере
Функция ДанныеЧекаГруппыПлатежей(ДокументОснование, НомерЧекаККМ)
	
	Возврат ПодключаемоеОборудованиеБГУ.ДанныеЧекаГруппыПлатежей(ДокументОснование, , НомерЧекаККМ);
	
КонецФункции

#КонецОбласти

