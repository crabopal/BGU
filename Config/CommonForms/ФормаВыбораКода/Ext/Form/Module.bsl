
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	Если Параметры.Свойство("Заголовок") Тогда
		Заголовок = Параметры.Заголовок;
		АвтоЗаголовок = Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Параметры.ТекущийПериод) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(, , НСтр("ru = 'Период'"));
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "Запись.ТекущийПериод", , Отказ);
	КонецЕсли;
	
	ЗакрыватьПриВыборе = Ложь;
	
	ВыборСпискаКодов 	= Параметры.ВыборСпискаКодов;
	ВернутьВсеРеквизиты = Параметры.ВернутьВсеРеквизиты;
	
	Элементы.СписокКодовПометка.Видимость = ВыборСпискаКодов;
	

	Если ЗначениеЗаполнено(Параметры.ИмяМакета) Тогда
		ЧастиПути = СтрРазделить(Параметры.ИмяМакета,".");
		Если ЧастиПути.Количество() = 3 Тогда
			//Макет объекта
			ТипОбъекта 		= ЧастиПути[0];
			НазваниеОбъекта	= ЧастиПути[1]; 
			НазваниеМакета	= ЧастиПути[2];
		Иначе //общий макет
			НазваниеМакета	= Параметры.ИмяМакета;
		КонецЕсли;
	Иначе
		ТипОбъекта		 = Параметры.ТипОбъекта;
		НазваниеОбъекта	 = Параметры.НазваниеОбъекта;
		НазваниеМакета	 = Параметры.НазваниеМакета;
	КонецЕсли;
		
	Префикс = ?(Параметры.Свойство("Префикс"), Параметры.Префикс, "Область");
	
	СформироватьСпискиВыбора(Префикс);	
	
	Если Элементы.ПериодНачалаДействия.СписокВыбора.Количество() < 2 тогда 
		Элементы.ПериодНачалаДействия.Видимость	= Ложь;
		ОбновитьСписокКодов(0, Параметры.ТекущийКод, Истина);
	Иначе	
		ТекущийГод = ПолучитьДействующийГод(Параметры.ТекущийПериод);
		ПериодНачалаДействия = Формат(ТекущийГод,"ЧГ=");
		ОбновитьСписокКодов(ТекущийГод, Параметры.ТекущийКод);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПериодНачалаДействияПриИзменении(Элемент)

	Если Элемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийКод = ?(Элементы.СписокКодов.ТекущиеДанные = Неопределено, Неопределено, Элементы.СписокКодов.ТекущиеДанные.Код);
	
	СписокКодов.Очистить();
	
	ОбновитьСписокКодов(ПериодНачалаДействия, ТекущийКод);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокКодов

&НаКлиенте
Процедура СписокКодовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если ВыборСпискаКодов Тогда
		ВыбранныеКоды = Новый Массив;
		ОтмеченныеСтроки = СписокКодов.НайтиСтроки(Новый Структура("Пометка", Истина));
		Если ОтмеченныеСтроки.Количество() > 0 Тогда
			Для каждого ОтмеченнаяСтрока Из ОтмеченныеСтроки Цикл
				ВыбранныеКоды.Добавить(ОтмеченнаяСтрока.Код);
			КонецЦикла;
		КонецЕсли;
		Закрыть(ВыбранныеКоды);
	Иначе
		ВыбраннаяСтрока = Элементы.СписокКодов.ТекущиеДанные;
		Если НЕ ВыбраннаяСтрока = Неопределено И НЕ ПустаяСтрока(ВыбраннаяСтрока.Код) Тогда
			Если ВернутьВсеРеквизиты Тогда
				Результат = Новый Структура("Код, Наименование, КодЕдиницыИзмерения",
				ВыбраннаяСтрока.Код, ВыбраннаяСтрока.Наименование, ВыбраннаяСтрока.КодЕдиницыИзмерения);
				ОповеститьОВыборе(Результат);
				Закрыть(Результат);
			Иначе
				ОповеститьОВыборе(ВыбраннаяСтрока.Код);
				Закрыть(ВыбраннаяСтрока.Код);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьТолькоЦифрыИзСтроки(ИсходнаяСтрока)
	
	Результат = "";
	
	Для НомерСимвола = 1 По СтрДлина(ИсходнаяСтрока) Цикл
		КодСимвола = КодСимвола(ИсходнаяСтрока, НомерСимвола);
		Если КодСимвола > 47 И КодСимвола < 58 Тогда // Число.
			Результат = Результат + Символ(КодСимвола);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолучитьДействующийГод(ТекущийПериод)

	ПериодГод	= Год(ТекущийПериод);
	Мин			= 9999;
	Макс		= 0;
		
	Для Каждого ПериодСписка Из СпискиВыбора Цикл
		Если ПериодСписка.Год <= ПериодГод Тогда
			Макс = Макс(Макс, ПериодСписка.Год);
		Иначе
			Мин = Мин(Мин, ПериодСписка.Год);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ?(Макс = 0, Мин, Макс);
	
КонецФункции

&НаСервере
Процедура СформироватьСпискиВыбора(Префикс)
	
	Если ЗначениеЗаполнено(ТипОбъекта) Тогда // Макет объекта
		МакетСоставаПоказателей = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ТипОбъекта + "." + НазваниеОбъекта).ПолучитьМакет(НазваниеМакета);
	Иначе                                   // Общий макет
		МакетСоставаПоказателей = ПолучитьОбщийМакет(НазваниеМакета);		
	КонецЕсли;
	
	Если МакетСоставаПоказателей = Неопределено Тогда
		ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Макет ""%1"" не найден. Операция прервана.'"), ТипОбъекта + "." + НазваниеОбъекта + "." + НазваниеМакета);
	КонецЕсли;
	
	ДлинаПрефикса = СтрДлина(Префикс);
	
	Для Каждого Область Из МакетСоставаПоказателей.Области Цикл
		
		Если НЕ (Префикс = "" Или Сред(Область.Имя, 1, ДлинаПрефикса) = Префикс) Тогда
			Продолжить;
		КонецЕсли;
		
		СписокВыбораКода = Новый ТаблицаЗначений;
		СписокВыбораКода.Колонки.Добавить("Код");
		СписокВыбораКода.Колонки.Добавить("Наименование");
		СписокВыбораКода.Колонки.Добавить("КодЕдиницыИзмерения");
		СписокВыбораКода.Индексы.Добавить("Код");

		
		Если Область.ТипОбласти = ТипОбластиЯчеекТабличногоДокумента.Строки Тогда
			
			Для НомСтр = Область.Верх По Область.Низ Цикл
				
				КодПоказателя = СокрП(МакетСоставаПоказателей.Область(НомСтр, 1).Текст);
				
				Если КодПоказателя <> "###" И ЗначениеЗаполнено(КодПоказателя) Тогда
					
					Показатель = СписокВыбораКода.Добавить();
					Показатель.Код 					= КодПоказателя;
					Показатель.Наименование 		= СокрП(МакетСоставаПоказателей.Область(НомСтр, 2).Текст);
					Показатель.КодЕдиницыИзмерения 	= СокрП(МакетСоставаПоказателей.Область(НомСтр, 3).Текст);
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
		ГодСписка 			= ПолучитьТолькоЦифрыИзСтроки(Сред(Область.Имя, ДлинаПрефикса + 1));
		ГодСписка			= ?(ПустаяСтрока(ГодСписка), 0, Число(ГодСписка));
		НовыйПериод 		= СпискиВыбора.Добавить();
		НовыйПериод.Год 	= ГодСписка;
		НовыйПериод.СписокВыбора.Загрузить(СписокВыбораКода); 
		Элементы.ПериодНачалаДействия.СписокВыбора.Добавить(ГодСписка, Формат(ГодСписка,"ЧН=-; ЧГ=") + " г.");
		
	КонецЦикла;
	
	Элементы.ПериодНачалаДействия.СписокВыбора.СортироватьПоЗначению();
		
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокКодов(Год, ТекущийКод = Неопределено, НетПериодов = Ложь)
	
	СпискиВыбораЗначение = РеквизитФормыВЗначение("СпискиВыбора");
	
	Если СпискиВыбораЗначение.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	
	
	Если НетПериодов Тогда
		СписокКодов.Загрузить(СпискиВыбораЗначение[0].СписокВыбора);	
	Иначе	
		СписокКодов.Загрузить(СпискиВыбораЗначение.Найти(Число(Год), "Год").СписокВыбора);
	КонецЕсли;
	
	ДлинаНаименования	= 0;
	Для каждого СтрокаКода Из СписокКодов Цикл
		ДлинаНаименования	= Макс(ДлинаНаименования, СтрДлина(СтрокаКода.Наименование));
	КонецЦикла;
	
	Если ДлинаНаименования > 100 Тогда
		Элементы.СписокКодовНаименование.МногострочныйРежим	= Истина;
	КонецЕсли;
	
	Если ТекущийКод <> Неопределено Тогда
		НайденныеКоды = СписокКодов.НайтиСтроки(Новый Структура("Код", ТекущийКод));
		Если НайденныеКоды.Количество() > 0 Тогда
			Элементы.СписокКодов.ТекущаяСтрока = НайденныеКоды[0].ПолучитьИдентификатор();
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти
