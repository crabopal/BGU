#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТекущаяЦБ = Константы.ОрганизацияЦентрализованнаяБухгалтерия.Получить();
	
	ОповеститьПриЗакрытии = ПравоДоступа("Изменение",Метаданные.Константы.ОрганизацияЦентрализованнаяБухгалтерия);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	Если НЕ ЗавершениеРаботы И ОповеститьПриЗакрытии Тогда
		Оповестить("ИзменениеОрганизацииЦБ", ТекущаяЦБ);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОрганизацияЦентрализованнаяБухгалтерияПриИзменении(Элемент)
	
	Если НаборКонстант.ОрганизацияЦентрализованнаяБухгалтерия <> ТекущаяЦБ
		И ВРегистреНастройкиПравПодписейЕстьДанные() Тогда
		
		ТекстВопроса = НСтр("ru = 'Текущие настройки прав подписей будут очищены. Продолжить?'");
		Оповещение = Новый ОписаниеОповещения("ВопросОчиститьРегистрЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
	ИначеЕсли НаборКонстант.ОрганизацияЦентрализованнаяБухгалтерия <> ТекущаяЦБ Тогда
		
		СохранитьЗначениеКонстантыЦБ();
		ТекущаяЦБ = НаборКонстант.ОрганизацияЦентрализованнаяБухгалтерия;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Заполнить(Команда)
	
	Если Не ЗначениеЗаполнено(НаборКонстант.ОрганизацияЦентрализованнаяБухгалтерия) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Централизованная бухгалтерия'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "НаборКонстант.ОрганизацияЦентрализованнаяБухгалтерия");
		Возврат;
	КонецЕсли;
	
	ЕстьДанныеВРегистре = ВРегистреНастройкиПравПодписейЕстьДанные();
	
	ТекстВопроса = "";
	Если ЕстьДанныеВРегистре Тогда
		ТекстВопроса = НСтр("ru = 'Текущие настройки прав подписей будут очищены. Продолжить?'");
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекстВопроса) Тогда
		Оповещение = Новый ОписаниеОповещения("ВопросЗаполнитьРегистрЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнитьРегистрНаСервере();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВопросЗаполнитьРегистрЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ЗаполнитьРегистрНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросОчиститьРегистрЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да
		И ОчиститьРегистрНаСервере() Тогда
		ТекущаяЦБ = НаборКонстант.ОрганизацияЦентрализованнаяБухгалтерия;
	Иначе
		НаборКонстант.ОрганизацияЦентрализованнаяБухгалтерия = ТекущаяЦБ;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ВРегистреНастройкиПравПодписейЕстьДанные()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	НастройкиПраваПодписиДокументовЦБ.ОбслуживаемоеУчреждение
	|ИЗ
	|	РегистрСведений.НастройкиПраваПодписиДокументовЦБ КАК НастройкиПраваПодписиДокументовЦБ";
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

&НаСервере
Процедура ЗаполнитьРегистрНаСервере()
	
	РегистрыСведений.НастройкиПраваПодписиДокументовЦБ.ЗагрузитьЭлементы(Истина);
	
	Элементы.НастройкиПравПодписей.Обновить();
	
КонецПроцедуры

&НаСервере
Функция ОчиститьРегистрНаСервере()
	
	Если НЕ ПравоДоступа("Изменение", Метаданные.РегистрыСведений.НастройкиПраваПодписиДокументовЦБ) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.НастройкиПраваПодписиДокументовЦБ.СоздатьНаборЗаписей();
	НаборЗаписей.Записать();
	
	Элементы.НастройкиПравПодписей.Обновить();
	
	СохранитьЗначениеКонстантыЦБ();
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура СохранитьЗначениеКонстантыЦБ()
	
	// Сохранения значения константы.
	КонстантаМенеджер = Константы["ОрганизацияЦентрализованнаяБухгалтерия"];
	КонстантаЗначение = НаборКонстант["ОрганизацияЦентрализованнаяБухгалтерия"];
	
	Если КонстантаМенеджер.Получить() <> КонстантаЗначение Тогда
		КонстантаМенеджер.Установить(КонстантаЗначение);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкиПравПодписейПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если Не ЗначениеЗаполнено(НаборКонстант.ОрганизацияЦентрализованнаяБухгалтерия) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Централизованная бухгалтерия'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "НаборКонстант.ОрганизацияЦентрализованнаяБухгалтерия",,Отказ);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
