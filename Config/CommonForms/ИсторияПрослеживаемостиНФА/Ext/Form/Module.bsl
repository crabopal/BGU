#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Параметры.Адрес)Тогда
		КодСтроки = 0;
		Для Каждого Строка Из ПолучитьИзВременногоХранилища(Параметры.Адрес) Цикл
			СтрокаИстории = ИсторияПрослеживаемости.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаИстории, Строка);
			СтрокаИстории.КодСтроки = КодСтроки + 1;
		КонецЦикла;
		МаксимальныйКодСтроки = СтрокаИстории.КодСтроки;
	КонецЕсли;
	
	НФА = Параметры.НФА;
	ЭтоНоменклатура = ТипЗнч(НФА) = Тип("СправочникСсылка.Номенклатура");
	
	КэШИсторияПрослеживаемости.Загрузить(ИсторияПрослеживаемости.Выгрузить());
	
	Комментарий = "Здесь отражена история значений признаков прослеживаемости предшествующих текущим значениям,
		|указанным в карточке элемента. Изменение признака ""Прослеживаемый товар"" при наличии движений по регистрам
		|прослеживаемости возможно только через обработку ""Помощник исключения НФА из прослеживаемости""!";
	ЭтаФорма.Заголовок = СтрШаблон("История прослеживаемости для ""%1""", Параметры.Наименование);
	
	УстановитьДоступностьСохранения(ЭтотОбъект);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
	Элементы,
	"ИсторияПрослеживаемостиКомплектСПрослеживаемымиТоварами",
	"Видимость",
	ЭтоНоменклатура);
	
КонецПроцедуры

&НаКлиенте
Процедура ИсторияПрослеживаемостиПриИзменении(Элемент)
	
	Модифицированность = Истина;
	Если ИзменениеДаты И ИсторияПрослеживаемости.Количество() > 1 Тогда
		ИсторияПрослеживаемостиСортировкаСервер();
	КонецЕсли;
	УстановитьДоступностьСохранения(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ИсторияПрослеживаемостиДатаИзмененияПриИзменении(Элемент)
	
	ИзменениеДаты = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сохранить(Команда)
	
	Если Модифицированность И ИсторияЗаполненаКорректно() Тогда
		Закрыть(ИсторияПрослеживаемости);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийИсторияПрослеживаемости

&НаКлиенте
Процедура ИсторияПрослеживаемостиПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)

	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		
		Если ТекущиеДанные.ДатаИзменения < '20210701' Тогда
			СообщениеОбОшибке = НСтр("ru = 'Дата изменения не может быть ранее даты вступления в силу прослеживаемости (01.07.2021 г.)!'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеОбОшибке, , , , Отказ);
			Возврат;
		КонецЕсли;
		
		Если ТекущиеДанные.ДатаИзменения > ТекущаяДата() Тогда
			СообщениеОбОшибке = НСтр("ru = 'Дата изменения не может быть позже текущей даты!'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеОбОшибке, , , , Отказ);
			Возврат;
		КонецЕсли;
		
		Если ТекущиеДанные.ПрослеживаемыйТовар И ТекущиеДанные.КомплектСПрослеживаемымиТоварами Тогда
			СообщениеОбОшибке = НСтр("ru = 'Оба признака не могут буть установленны в ""Да"" одновременно!'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеОбОшибке, , , , Отказ);
			Возврат;
		КонецЕсли;
		
		Если ИзменениеДаты И ИсторияПрослеживаемости.Количество() > 1 Тогда
			ИсторияПрослеживаемостиСортировкаСервер();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ИсторияПрослеживаемостиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		
		ТекущиеДанные = Элемент.ТекущиеДанные;
		
		Если Элемент.ТекущиеДанные <> Неопределено Тогда
			
			Элемент.ТекущиеДанные.ДатаИзменения = НачалоДня(ОбщегоНазначенияКлиент.ДатаСеанса());
			ЭтотОбъект.ТекущийЭлемент = Элементы.ИсторияПрослеживаемостиДатаИзменения;
			
			ТекущиеДанные.КодСтроки = МаксимальныйКодСтроки + 1;
			МаксимальныйКодСтроки = ТекущиеДанные.КодСтроки;
			
			ИзменениеДаты = Истина;
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ИсторияЗаполненаКорректно()
	
	//Проверка дублей дат
	ТаблицаИстории = Новый ТаблицаЗначений;
	ТаблицаИстории.Колонки.Добавить("ПрослеживаемыйТовар", Новый ОписаниеТипов("Булево"));
	ТаблицаИстории.Колонки.Добавить("КомплектСПрослеживаемымиТоварами", Новый ОписаниеТипов("Булево"));
	ТаблицаИстории.Колонки.Добавить("ДатаИзменения", Новый ОписаниеТипов("Дата"));
	ТаблицаИстории.Колонки.Добавить("КодСтроки", Новый ОписаниеТипов("Число"));
		
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ТекущаяТаблицаИстории.КодСтроки КАК КодСтроки,
	|	ТекущаяТаблицаИстории.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар,
	|	ТекущаяТаблицаИстории.КомплектСПрослеживаемымиТоварами КАК КомплектСПрослеживаемымиТоварами,
	|	ТекущаяТаблицаИстории.ДатаИзменения КАК ДатаИзменения,
	|	АВТОНОМЕРЗАПИСИ() КАК НомерСтроки
	|ПОМЕСТИТЬ ВТ_ТекущаяТаблицаИстории
	|ИЗ
	|	&ТекущаяТаблицаИстории КАК ТекущаяТаблицаИстории
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТекущаяТаблицаИстории.ДатаИзменения КАК ДатаИзменения,
	|	КОЛИЧЕСТВО(ВТ_ТекущаяТаблицаИсторииСчетчик.ДатаИзменения) КАК Счетчик,
	|	МАКСИМУМ(ВТ_ТекущаяТаблицаИстории.НомерСтроки) КАК НомерСтроки
	|ИЗ
	|	ВТ_ТекущаяТаблицаИстории КАК ВТ_ТекущаяТаблицаИстории
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТекущаяТаблицаИстории КАК ВТ_ТекущаяТаблицаИсторииСчетчик
	|		ПО ВТ_ТекущаяТаблицаИстории.КодСтроки = ВТ_ТекущаяТаблицаИсторииСчетчик.КодСтроки
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ТекущаяТаблицаИстории.ДатаИзменения
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(ВТ_ТекущаяТаблицаИсторииСчетчик.ДатаИзменения) > 1");
	
	Запрос.УстановитьПараметр("ТекущаяТаблицаИстории",?(ИсторияПрослеживаемости.Количество(), ИсторияПрослеживаемости.Выгрузить(), ТаблицаИстории));
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;

	ТаблицаДублейДат = Запрос.Выполнить().Выгрузить();
	
	Отказ = Ложь;
	Для Каждого Дубль Из ТаблицаДублейДат Цикл
		
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Дата изменения %1 может быть указана только однократно!'"), Формат(Дубль.ДатаИзменения, "ДЛФ=D"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
		ТекстСообщения,
		,
		,
		СтрШаблон("ИсторияПрослеживаемости[%1].ДатаИзменения", Дубль.НомерСтроки -1),
		Отказ);
		
	КонецЦикла;
	
	Если Отказ Тогда
		Возврат Ложь;
	КонецЕсли;
	
	//Проверка корректности заполнениия признаков прослеживаемости
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КэШИстории.КодСтроки КАК КодСтроки,
	|	КэШИстории.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар,
	|	КэШИстории.КомплектСПрослеживаемымиТоварами КАК КомплектСПрослеживаемымиТоварами,
	|	КэШИстории.ДатаИзменения КАК ДатаИзменения
	|ПОМЕСТИТЬ ВТ_КэШИстории
	|ИЗ
	|	&КэШИстории КАК КэШИстории
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(ВложенныйЗапрос.КодСтроки) КАК КодСтроки,
	|	СУММА(ВложенныйЗапрос.НомерСтроки) КАК НомерСтроки,
	|	ВложенныйЗапрос.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар,
	|	ВложенныйЗапрос.КомплектСПрослеживаемымиТоварами КАК КомплектСПрослеживаемымиТоварами,
	|	ВложенныйЗапрос.ДатаИзменения КАК ДатаИзменения,
	|	ЛОЖЬ КАК Обработана
	|ИЗ
	|	(ВЫБРАТЬ
	|		ТекущаяТаблицаИстории.КодСтроки КАК КодСтроки,
	|		ТекущаяТаблицаИстории.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар,
	|		ТекущаяТаблицаИстории.КомплектСПрослеживаемымиТоварами КАК КомплектСПрослеживаемымиТоварами,
	|		ТекущаяТаблицаИстории.ДатаИзменения КАК ДатаИзменения,
	|		ТекущаяТаблицаИстории.НомерСтроки КАК НомерСтроки

	|	ИЗ
	|		ВТ_ТекущаяТаблицаИстории КАК ТекущаяТаблицаИстории
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		-КэШИстории.КодСтроки,
	|		КэШИстории.ПрослеживаемыйТовар,
	|		КэШИстории.КомплектСПрослеживаемымиТоварами,
	|		КэШИстории.ДатаИзменения,
	|		0
	|	ИЗ
	|		ВТ_КэШИстории КАК КэШИстории) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.ПрослеживаемыйТовар,
	|	ВложенныйЗапрос.КомплектСПрослеживаемымиТоварами,
	|	ВложенныйЗапрос.ДатаИзменения
	|
	|ИМЕЮЩИЕ
	|	СУММА(ВложенныйЗапрос.КодСтроки) <> 0";
	
	Запрос.УстановитьПараметр("КэШИстории", КэШИсторияПрослеживаемости.Выгрузить());
	
	ТаблицаИзмененыхСтрок = Запрос.Выполнить().Выгрузить();
	
	Если ТаблицаИзмененыхСтрок.Количество() Тогда
		
		ТаблицаИзмененыхСтрок.Индексы.Добавить("КодСтроки");
		
		ТаблицаКонтроляДанных = Новый ТаблицаЗначений;
		ТаблицаКонтроляДанных.Колонки.Добавить("ДатаИзменения", Новый ОписаниеТипов("Дата"));
		ТаблицаКонтроляДанных.Колонки.Добавить("Остатки", Новый ОписаниеТипов("Булево"));
		ТаблицаКонтроляДанных.Колонки.Добавить("Обороты", Новый ОписаниеТипов("Булево"));
		ТаблицаКонтроляДанных.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
		
		Для Каждого СтрокаИзменения Из ТаблицаИзмененыхСтрок Цикл
			Если СтрокаИзменения.Обработана Тогда
				Продолжить;
			КонецЕсли;
			СтрокаКорр = ТаблицаИзмененыхСтрок.Найти(-СтрокаИзменения.КодСтроки, "КодСтроки");

			Если СтрокаИзменения.КодСтроки > 0 Тогда
				Если СтрокаКорр <> Неопределено Тогда
					
					СтрокаКорр.Обработана = Истина;
					//изменение строки
					Если СтрокаИзменения.ПрослеживаемыйТовар <> СтрокаКорр.ПрослеживаемыйТовар
						И Не СтрокаИзменения.ПрослеживаемыйТовар Тогда
						ДобавитьСтрокуКонтроля(ТаблицаКонтроляДанных, СтрокаИзменения.ДатаИзменения, , Истина, СтрокаИзменения.НомерСтроки);
					ИначеЕсли ЭтоНоменклатура И ((СтрокаИзменения.КомплектСПрослеживаемымиТоварами <> СтрокаКорр.КомплектСПрослеживаемымиТоварами
								И Не СтрокаИзменения.КомплектСПрослеживаемымиТоварами)
						ИЛИ (СтрокаИзменения.ДатаИзменения <> СтрокаКорр.ДатаИзменения И Не СтрокаИзменения.КомплектСПрослеживаемымиТоварами)) Тогда
						ДобавитьСтрокуКонтроля(ТаблицаКонтроляДанных, СтрокаИзменения.ДатаИзменения, Истина, , СтрокаИзменения.НомерСтроки);
					КонецЕсли;
					
				Иначе
					//добавление строки
					Если Не СтрокаИзменения.ПрослеживаемыйТовар Тогда
						ДобавитьСтрокуКонтроля(ТаблицаКонтроляДанных, СтрокаИзменения.ДатаИзменения, , Истина, СтрокаИзменения.НомерСтроки);
					ИначеЕсли ЭтоНоменклатура И Не СтрокаИзменения.КомплектСПрослеживаемымиТоварами Тогда
						ДобавитьСтрокуКонтроля(ТаблицаКонтроляДанных, СтрокаИзменения.ДатаИзменения, Истина, , СтрокаИзменения.НомерСтроки);
					КонецЕсли;
					
				КонецЕсли;
			Иначе
				//удаление строки
			КонецЕсли;
			
			СтрокиПроверкиДвижений = ТаблицаКонтроляДанных.НайтиСтроки(Новый Структура("Обороты", Истина));
			Если СтрокиПроверкиДвижений.Количество() Тогда
				
				ЕстьДвижения = ЕстьДвиженияПТПоНФА(НФА);
				Если ЕстьДвижения Тогда
					Для Каждого СтрокаКонтроляДвижений Из СтрокиПроверкиДвижений Цикл
						
						ТекстСообщения = СтрШаблон(НСтр("ru = 'Изменение признака ""Прослеживаемый товар"" на дату %1 невозможно - есть движения!'"), 
							Формат(СтрокаКонтроляДвижений.ДатаИзменения, "ДЛФ=D"));
						
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
						ТекстСообщения,
						,
						СтрШаблон("ИсторияПрослеживаемости[%1].ДатаИзменения", СтрокаКонтроляДвижений.НомерСтроки -1),
						,
						Отказ);
						
					КонецЦикла;
				КонецЕсли;
				
			КонецЕсли;
			
			ТаблицаКонтроляОстатки = ТаблицаКонтроляДанных.Скопировать(Новый Структура("Остатки", Истина));
			Если ТаблицаКонтроляОстатки.Количество() Тогда
				
				ТаблицаКонтроляОстатки.Сортировать("ДатаИзменения", Новый СравнениеЗначений);
				ОстаткиПТПоДатамКонтроля = ОстаткиПоДатам(ТаблицаКонтроляОстатки);
				
				Для Каждого СтрокаКонтроляОстатки Из ТаблицаКонтроляОстатки Цикл
					ЗначениеКонтроля = ОстаткиПТПоДатамКонтроля.Получить(СтрокаКонтроляОстатки.ДатаИзменения);
					Если ЗначениеКонтроля <> Неопределено Тогда
						
						ТекстСообщения = СтрШаблон(НСтр("ru = 'Изменение признака ""Комплект с прослеживаемыми товарами""  на дату %1 невозможно - есть остатки!'"),
							Формат(СтрокаКонтроляОстатки.ДатаИзменения, "ДЛФ=D"));

						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
						ТекстСообщения,
						,
						СтрШаблон("ИсторияПрослеживаемости[%1].ДатаИзменения", СтрокаКонтроляОстатки.НомерСтроки -1),
						,
						Отказ);
						
					КонецЕсли;
				КонецЦикла;
				
			КонецЕсли;
			
			СтрокаИзменения.Обработана = Истина;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат НЕ Отказ;
	
КонецФункции

&НаСервере
Процедура ДобавитьСтрокуКонтроля(ТаблицаКонтроляДанных, ДатаИзменения, Остатки = Ложь, Обороты = Ложь, НомерСтроки = 0)
	
	СтрокаКонтроля = ТаблицаКонтроляДанных.Добавить();
	СтрокаКонтроля.ДатаИзменения = ДатаИзменения;
	СтрокаКонтроля.Остатки = Остатки;
	СтрокаКонтроля.Обороты = Обороты;
	СтрокаКонтроля.НомерСтроки = НомерСтроки;
	
КонецПроцедуры

&НаСервере
Функция ЕстьДвиженияПТПоНФА(НФА)
	
	Запрос = Новый Запрос;
	
	СхемаЗапроса = Новый СхемаЗапроса;
	ОператорыВыбора = СхемаЗапроса.ПакетЗапросов[0].Операторы[0];
	
	Если ЭтоНоменклатура Тогда
		ИсточникНФА = ОператорыВыбора.Источники.Добавить("РегистрНакопления.ПрослеживаемыеТовары.Обороты", "ПрослеживаемыеНФАОбороты");
	Иначе
		ИсточникНФА = ОператорыВыбора.Источники.Добавить("РегистрНакопления.ПрослеживаемыеОС.Обороты", "ПрослеживаемыеНФАОбороты")
	КонецЕсли;
	
	ОператорыВыбора.ВыбираемыеПоля.Добавить("ПрослеживаемыеНФАОбороты.КоличествоПриход");
	
	ИсточникНФА.Источник.Параметры[2].Выражение = Новый ВыражениеСхемыЗапроса("Авто");

	ТекстНФА = ?(ЭтоНоменклатура, "Номенклатура", "ОсновноеСредство");
	УсловиеНФА = СтрШаблон("(%1 = &Ссылка ИЛИ Комплектующее = &Ссылка)", ТекстНФА);
	ИсточникНФА.Источник.Параметры[3].Выражение = Новый ВыражениеСхемыЗапроса(УсловиеНФА);
	Запрос.Текст = СхемаЗапроса.ПолучитьТекстЗапроса();
	
	Запрос.УстановитьПараметр("Ссылка", НФА);

	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);

	Возврат НЕ РезультатЗапроса.Пустой();
	
КонецФункции

&НаСервере
Функция ОстаткиПоДатам(ТаблицаДат)

	Запрос = новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДатыОстатков.ДатаИзменения КАК ДатаОстатков
	|ПОМЕСТИТЬ ВТ_Даты
	|ИЗ
	|	&ДатыОстатков КАК ДатыОстатков
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Даты.ДатаОстатков КАК ДатаОстатков,
	|	СУММА(ВЫБОР
	|			КОГДА КОНЕЦПЕРИОДА(ПрослеживаемыеТоварыОстаткиИОбороты.Период, ДЕНЬ) = КОНЕЦПЕРИОДА(&НачальнаяДата, ДЕНЬ)
	|				ТОГДА ПрослеживаемыеТоварыОстаткиИОбороты.КоличествоКонечныйОстаток
	|			ИНАЧЕ ВЫБОР
	|					КОГДА КОНЕЦПЕРИОДА(ПрослеживаемыеТоварыОстаткиИОбороты.Период, ДЕНЬ) <= ВТ_Даты.ДатаОстатков
	|						ТОГДА ПрослеживаемыеТоварыОстаткиИОбороты.КоличествоОборот
	|					ИНАЧЕ 0
	|				КОНЕЦ
	|		КОНЕЦ) КАК Остаток
	|ИЗ
	|	РегистрНакопления.ПрослеживаемыеТовары.ОстаткиИОбороты(
	|			&НачальнаяДата,
	|			&КонечнаяДата,
	|			День,
	|			,
	|			Номенклатура = &НоменклатураОтбор
	|				ИЛИ Комплектующее = &НоменклатураОтбор) КАК ПрослеживаемыеТоварыОстаткиИОбороты,
	|	ВТ_Даты КАК ВТ_Даты
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Даты.ДатаОстатков";
	
	Запрос.УстановитьПараметр("ДатыОстатков", ТаблицаДат);
	Запрос.УстановитьПараметр("НоменклатураОтбор", НФА);
	Запрос.УстановитьПараметр("НачальнаяДата", ТаблицаДат[0].ДатаИзменения);
	Запрос.УстановитьПараметр("КонечнаяДата", ТаблицаДат[ТаблицаДат.Количество()-1].ДатаИзменения);

	ЗначенияКонтроля = Новый Соответствие;
	
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	
	Пока Выборка.Следующий() Цикл
		Если Выборка.Остаток > 0 Тогда
			Если ЗначенияКонтроля.Получить(Выборка.ДатаОстатков) = Неопределено Тогда
				ЗначенияКонтроля.Вставить(Выборка.ДатаОстатков, Истина);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЗначенияКонтроля;
	
КонецФункции

&НаСервере
Процедура ИсторияПрослеживаемостиСортировкаСервер()
	
	ИсторияПрослеживаемости.Сортировать("ДатаИзменения", Новый СравнениеЗначений);
	ИзменениеДаты = Ложь;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьСохранения(Форма)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
	Форма.Элементы,
	"Сохранить",
	"Доступность",
	Форма.Модифицированность);
	
КонецПроцедуры

#КонецОбласти