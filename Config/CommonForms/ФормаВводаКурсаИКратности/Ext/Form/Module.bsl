#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Валюта = Параметры.Валюта;	
	ДатаКурса = Параметры.ДатаКурса;
	Курс = Параметры.Курс;
	Кратность = Параметры.Кратность;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Асинх Процедура ЗаполнитьНаДату(Команда)
	
	ТекстПодсказки = НСтр("ru='Выберите дату курса'");
	Результат = Ждать ВвестиДатуАсинх(ДатаКурса, ТекстПодсказки, ЧастиДаты.Дата);
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;		
	
	ДатаКурса = Результат;
	КурсВалюты = КурсВалюты(Валюта, ДатаКурса);
	Курс = КурсВалюты.Курс;
	Кратность = КурсВалюты.Кратность;
	
КонецПроцедуры

&НаКлиенте
Процедура ОК(Команда)
	
	Результат = Новый Структура;
	Результат.Вставить("Курс", Курс);
	Результат.Вставить("Кратность", Кратность);
	Закрыть(Результат);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция КурсВалюты(Знач Валюта, Знач ДатаКурса)
	
	Возврат	РаботаСКурсамиВалют.ПолучитьКурсВалюты(Валюта, ДатаКурса);

КонецФункции

#КонецОбласти