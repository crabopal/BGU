
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Пропускаем инициализацию, чтобы гарантировать получение формы при передаче параметра "АвтоТест".
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли; 
	
	СтруктураНастроек = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("ВыборКодовИСМП", ""); 
	Если СтруктураНастроек <> Неопределено Тогда
		Если СтруктураНастроек.Свойство("ВидСписка") Тогда 
			ВидСписка = СтруктураНастроек.ВидСписка;
		КонецЕсли;
		Если СтруктураНастроек.Свойство("ОСУ") Тогда 
			ОСУ = СтруктураНастроек.ОСУ; 
		КонецЕсли;
	КонецЕсли;
	
	Организация 	= Параметры.Организация;
	Номенклатура 	= Параметры.Номенклатура; 
	ЕстьВидУчета	= Параметры.Свойство("ОСУ");
	
	Если ЕстьВидУчета Тогда 
		ОСУ	= Параметры.ОСУ;
	КонецЕсли;	
	
	Если Параметры.Свойство("ДатаОстатков") Тогда 
		ДатаОстатков = Параметры.ДатаОстатков;
	Иначе
		ДатаОстатков = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Если Параметры.Свойство("ВыборПоДокументам") И Параметры.ВыборПоДокументам Тогда 
		ВыборПоДокументам = Истина;
		ВидСписка = 1;
	Иначе 
		ВыборПоДокументам = Ложь;
	КонецЕсли;	 
	
	Если Параметры.Свойство("МножественныйВыбор") И Параметры.МножественныйВыбор Тогда 
		Элементы.ТаблицаКодов.РежимВыделения = РежимВыделенияТаблицы.Множественный; 
	Иначе 
		Элементы.ТаблицаКодов.РежимВыделения = РежимВыделенияТаблицы.Одиночный;
	КонецЕсли;    
	
	Если Параметры.Свойство("Количество") Тогда 
		Количество = Параметры.Количество;
	КонецЕсли;      
		
	ЗаполнитьТаблицуКодов();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуКодов()
	
	Если ВидСписка = 0 Тогда 
		РезультатЗапроса = ЗаполнитьПоОстаткам();
	Иначе
		РезультатЗапроса = ЗаполнитьПоДокументамПоступления();
	КонецЕсли;	
	
	ЭтотОбъект.ТаблицаКодов.Загрузить(РезультатЗапроса);
	
КонецПроцедуры	

&НаСервере
Функция ЗаполнитьПоДокументамПоступления()

	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ЭлектронныйДокументПоставщикаКодыУпаковокМаркируемойПродукции.НомерУпаковки КАК Код,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Ссылка.Ссылка КАК ДокументПоступления,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Ссылка.Дата КАК Дата,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Ссылка.Контрагент КАК Контрагент,
	               |	1 КАК Количество
	               |ИЗ
	               |	Документ.ЭлектронныйДокументПоставщика.КодыУпаковокМаркируемойПродукции КАК ЭлектронныйДокументПоставщикаКодыУпаковокМаркируемойПродукции
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭлектронныйДокументПоставщика.СписокНоменклатуры КАК ЭлектронныйДокументПоставщикаСписокНоменклатуры
	               |		ПО (ЭлектронныйДокументПоставщикаСписокНоменклатуры.ИдентификаторСтроки = ЭлектронныйДокументПоставщикаКодыУпаковокМаркируемойПродукции.ИдентификаторСтроки)
	               |			И ЭлектронныйДокументПоставщикаКодыУпаковокМаркируемойПродукции.Ссылка = ЭлектронныйДокументПоставщикаСписокНоменклатуры.Ссылка
	               |ГДЕ
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Номенклатура = &Номенклатура
	               |	И ЭлектронныйДокументПоставщикаСписокНоменклатуры.Ссылка.Организация = &Организация
	               |	И ВЫБОР
	               |			КОГДА &ЭтоОСУ
	               |				ТОГДА ДЛИНАСТРОКИ(ЭлектронныйДокументПоставщикаКодыУпаковокМаркируемойПродукции.НомерУпаковки) <= 24
	               |			ИНАЧЕ ДЛИНАСТРОКИ(ЭлектронныйДокументПоставщикаКодыУпаковокМаркируемойПродукции.НомерУпаковки) > 24
	               |		КОНЕЦ
	               |	И ЭлектронныйДокументПоставщикаСписокНоменклатуры.Ссылка.Проведен = ИСТИНА
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЭлектронныйДокументПоставщикаКодыУпаковокМаркируемойПродукции.НомерУпаковки,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Ссылка.Ссылка,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Ссылка.Дата,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Ссылка.Контрагент
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Дата УБЫВ"; 
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("Организация"	, Организация);
	Запрос.УстановитьПараметр("ЭтоОСУ"		, ОСУ);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если ОСУ Тогда 
		Для Каждого СтрокаТаблицы Из РезультатЗапроса Цикл   
			ПараметрыСтроки = ОбменИСМПБГУКлиентСервер.ПараметрыСтрокиИзКодаИСМП(СтрокаТаблицы.Код);
			СтрокаТаблицы.Количество 	= ПараметрыСтроки.Количество;
			СтрокаТаблицы.Код 			= ПараметрыСтроки.КодИСМП;
		КонецЦикла;	
	КонецЕсли;
	
	Возврат РезультатЗапроса;
	
КонецФункции	

&НаСервере
Функция ЗаполнитьПоОстаткам()

	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	КодыИСМПБГУОстатки.Номенклатура КАК Номенклатура,
	               |	КодыИСМПБГУОстатки.КодИСМП КАК Код,
	               |	КодыИСМПБГУОстатки.КоличествоОстаток КАК Количество
	               |ИЗ
	               |	РегистрНакопления.КодыИСМПБГУ.Остатки(
	               |			&ДатаОстатков,
	               |			Организация = &Организация
	               |				И Номенклатура = &Номенклатура) КАК КодыИСМПБГУОстатки
	               |ГДЕ
	               |	ВЫБОР
	               |			КОГДА &ЭтоОСУ
	               |				ТОГДА ДЛИНАСТРОКИ(КодыИСМПБГУОстатки.КодИСМП) <= 14
	               |			ИНАЧЕ ДЛИНАСТРОКИ(КодыИСМПБГУОстатки.КодИСМП) > 14
	               |		КОНЕЦ"; 
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Номенклатура"	, Номенклатура);
	Запрос.УстановитьПараметр("Организация"		, Организация);
	Запрос.УстановитьПараметр("ЭтоОСУ"			, ОСУ); 
	Запрос.УстановитьПараметр("ДатаОстатков"	, Новый Граница(Новый МоментВремени(ДатаОстатков),ВидГраницы.Включая));

	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Возврат РезультатЗапроса;
	
КонецФункции	
	
&НаКлиенте
Процедура Выбрать(Команда)

	СтруктураНастроек = Новый Структура;
	СтруктураНастроек.Вставить("ВидСписка", ВидСписка);
	СтруктураНастроек.Вставить("ОСУ"      , ОСУ);
	ОбщегоНазначенияВызовСервера.ХранилищеОбщихНастроекСохранить("ВыборКодовИСМП", "", СтруктураНастроек);
	
	Если Элементы.ТаблицаКодов.ВыделенныеСтроки.Количество() = 0 Тогда 
		Закрыть();
	Иначе
		ДанныеТовара = Новый Массив();
		Для Каждого СтрокаТовар Из Элементы.ТаблицаКодов.ВыделенныеСтроки Цикл 
			ВыделеннаяСтрока = ТаблицаКодов.НайтиПоИдентификатору(СтрокаТовар);
			ДанныеТовара.Добавить(ВыделеннаяСтрока);
		КонецЦикла;	
		Закрыть(ДанныеТовара);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидСпискаПриИзменении(Элемент)
	
	УстановитьВидимостьЭлементов();
	ЗаполнитьТаблицуКодов();
	
КонецПроцедуры   

&НаКлиенте
Процедура УстановитьВидимостьЭлементов()
	
	Если ВидСписка = 0 Тогда 
		ПоДокументам = Ложь; 
		Элементы.ТаблицаКодовКоличество.Заголовок = "Остаток";
	Иначе 
		ПоДокументам = Истина;
		Элементы.ТаблицаКодовКоличество.Заголовок = "Количество";
	КонецЕсли;	
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ТаблицаКодовДата", "Видимость", ПоДокументам);  
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ТаблицаКодовДокументПоступления", "Видимость", ПоДокументам);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ТаблицаКодовКонтрагент", "Видимость", ПоДокументам);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ОСУ", "Видимость", Не ЕстьВидУчета); 
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ВидСписка", "Видимость", Не ВыборПоДокументам);  
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаКоличество", "Видимость", ОСУ); 
	
КонецПроцедуры	

&НаКлиенте
Процедура ОСУПриИзменении(Элемент)
	
	ЗаполнитьТаблицуКодов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьВидимостьЭлементов();
	УстановитьКоличествоКодов();
	
КонецПроцедуры
	
&НаКлиенте
Процедура УстановитьКоличествоКодов()

	ТекущиеДанные = Элементы.ТаблицаКодов.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда 
		КоличествоКодов = ТекущиеДанные.Количество
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиенте
Процедура ТаблицаКодовПриАктивизацииСтроки(Элемент)
	
	УстановитьКоличествоКодов();
	
КонецПроцедуры 


