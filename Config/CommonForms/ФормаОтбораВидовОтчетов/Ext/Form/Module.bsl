
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СписокЗначенийДляВыбора = Параметры.СписокЗначенийДляВыбора.Скопировать();
	СписокСуществующих = СписокЗначенийДляВыбора.Скопировать();
	
	Для Каждого РанееОтмечен Из Параметры.ИсходныйСписок Цикл
		РанееОтмеченНаименование = РанееОтмечен.Значение;
		
		НайденныйСуществующий = СписокСуществующих.НайтиПоЗначению(РанееОтмеченНаименование);
		Если НайденныйСуществующий <> Неопределено Тогда
			НайденныйСуществующий.Пометка = Истина;
		Иначе
			СписокСуществующих.Добавить(РанееОтмеченНаименование,,Истина);
		КонецЕсли;
		ИтоговыйСписокЗначений.Добавить(РанееОтмеченНаименование);
	КонецЦикла;
	
	СписокСуществующих.СортироватьПоЗначению();
	
	СоздатьДеревоОтчетов();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СписокСуществующихПометкаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.СписокСуществующих.ТекущиеДанные;
	
	УчестьВИтоговомСпискеЗначений(ТекущиеДанные.Пометка, ТекущиеДанные.Значение);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокСуществующихВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	НоваяПометка = Не ТекущиеДанные.Пометка;
	
	ТекущиеДанные.Пометка = НоваяПометка;
	
	НайденныйСуществующий = СписокСуществующих.НайтиПоЗначению(ТекущиеДанные.Значение);
	Если НайденныйСуществующий <> Неопределено Тогда
		НайденныйСуществующий.Пометка = НоваяПометка;
	КонецЕсли;	
	
	УчестьВИтоговомСпискеЗначений(НоваяПометка, ТекущиеДанные.Значение);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоОтчетовПометкаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоОтчетов.ТекущиеДанные;
	
	Если ТекущиеДанные.Пометка = 2 Тогда
		ТекущиеДанные.Пометка = 0;
	КонецЕсли;
	
	Если ТекущиеДанные.ЭтоГруппа = Ложь Тогда
		УчестьВИтоговомСпискеЗначений(ТекущиеДанные.Пометка, ТекущиеДанные.Наименование);
	КонецЕсли;
	
	УстановитьИспользованиеВДереве(ТекущиеДанные, ТекущиеДанные.Пометка);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоОтчетовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	ТекущиеДанные.Пометка = ?(ТекущиеДанные.Пометка = 0, 1, 0);
		
	Если ТекущиеДанные.ЭтоГруппа = Ложь Тогда
		УчестьВИтоговомСпискеЗначений(ТекущиеДанные.Пометка, ТекущиеДанные.Наименование);
	КонецЕсли;
	
	НайтиПоЗначениюВДереве(ДеревоОтчетов);	
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоБухОтчетовПометкаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоБухОтчетов.ТекущиеДанные;
	
	Если ТекущиеДанные.Пометка = 2 Тогда
		ТекущиеДанные.Пометка = 0;
	КонецЕсли;
	
	Если ТекущиеДанные.ЭтоГруппа = Ложь Тогда
		УчестьВИтоговомСпискеЗначений(ТекущиеДанные.Пометка, ТекущиеДанные.Наименование);
	КонецЕсли;	
	
	УстановитьИспользованиеВДереве(ТекущиеДанные, ТекущиеДанные.Пометка);

КонецПроцедуры

&НаКлиенте
Процедура ДеревоБухОтчетовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	ТекущиеДанные.Пометка = ?(ТекущиеДанные.Пометка = 0, 1, 0);
		
	Если ТекущиеДанные.ЭтоГруппа = Ложь Тогда
		УчестьВИтоговомСпискеЗначений(ТекущиеДанные.Пометка, ТекущиеДанные.Наименование);
	КонецЕсли;
	
	НайтиПоЗначениюВДереве(ДеревоБухОтчетов);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выбрать(Команда)
	
	//В зависимости от способа выбора используем соответствующий источник:
	ПолучитьОтмеченныеЗначения();
	ОповеститьОВыборе(ИтоговыйСписокЗначений);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область РаботаСДеревьямиЗначений

&НаКлиенте
Процедура НайтиПоЗначениюВДереве(СтрокаДерева)
	
	Потомки = СтрокаДерева.ПолучитьЭлементы();
	
	Для Каждого Потомок Из Потомки Цикл
		
		Если Потомок.ЭтоГруппа = Ложь Тогда
			Если ИтоговыйСписокЗначений.НайтиПоЗначению(Потомок.Наименование) = Неопределено Тогда
				Потомок.Пометка = 0;
			Иначе
				Потомок.Пометка = 1;
			КонецЕсли;	
			УчестьВИтоговомСпискеЗначений(Потомок.Пометка, Потомок.Наименование);
			ИзменитьФлажкиРодительскихЭлементов(Потомок);
		КонецЕсли;
		
		НайтиПоЗначениюВДереве(Потомок);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьОтмеченныеПодчиненныеЭлементы(СтрокаДерева)
	
	Потомки = СтрокаДерева.ПолучитьЭлементы();
	
	Для Каждого Потомок Из Потомки Цикл
		
		Если Потомок.Пометка = Истина И Потомок.ЭтоГруппа = Ложь Тогда
			Если ИтоговыйСписокЗначений.НайтиПоЗначению(Потомок.Наименование) = Неопределено Тогда
				ИтоговыйСписокЗначений.Добавить(Потомок.Наименование);
			КонецЕсли;	
		КонецЕсли;
		
		ПолучитьОтмеченныеПодчиненныеЭлементы(Потомок);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьФлажкиПодчиненныхЭлементов(СтрокаДерева, ЗначениеФлажка)
	
	Потомки = СтрокаДерева.ПолучитьЭлементы();
	
	Для Каждого Потомок Из Потомки Цикл
		
		Потомок.Пометка = ЗначениеФлажка;
		Если Потомок.ЭтоГруппа = Ложь Тогда
			УчестьВИтоговомСпискеЗначений(ЗначениеФлажка, Потомок.Наименование);
		КонецЕсли;	
		ИзменитьФлажкиПодчиненныхЭлементов(Потомок, ЗначениеФлажка);		
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьФлажкиРодительскихЭлементов(СтрокаДерева)
	
	Если ТипЗнч(СтрокаДерева) <> Тип("ДанныеФормыЭлементДерева") Тогда 
		Возврат;
	КонецЕсли;              
	
	Родитель = СтрокаДерева.ПолучитьРодителя();
	Если Родитель = Неопределено Тогда 
		Возврат;
	КонецЕсли;	
	
	ПотомкиРодителя = Родитель.ПолучитьЭлементы();
	
	МассивЗначенийПотомков = Новый Массив;
	Для Каждого Потомок из ПотомкиРодителя Цикл
		
		Если МассивЗначенийПотомков.Найти(Потомок.Пометка) <> Неопределено Тогда 
			Продолжить;
		КонецЕсли;
		
		МассивЗначенийПотомков.Добавить(Потомок.Пометка);
		
		Если МассивЗначенийПотомков.Количество() > 1 Тогда 
			Прервать;
		КонецЕсли;	
		
	КонецЦикла;
	
	Если МассивЗначенийПотомков.Количество() > 1 Тогда 
		Родитель.Пометка = 2;
		
	ИначеЕсли МассивЗначенийПотомков.Количество() = 1 Тогда 
		Родитель.Пометка = МассивЗначенийПотомков[0];
	КонецЕсли;	
	
	ИзменитьФлажкиРодительскихЭлементов(Родитель);
		
КонецПроцедуры


&НаКлиенте
Процедура УстановитьПометки(Команда)
	
	Если СпособВыбора = 1 Тогда
		ИзменитьФлажкиПодчиненныхЭлементов(ДеревоБухОтчетов, Истина);
	ИначеЕсли СпособВыбора = 2 Тогда
		ИзменитьФлажкиПодчиненныхЭлементов(ДеревоОтчетов, Истина);
	Иначе
		Для Каждого ЭлементСуществующие Из СписокСуществующих Цикл
			ЭлементСуществующие.Пометка = Истина;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьПометки(Команда)
	
	Если СпособВыбора = 1 Тогда
		ИзменитьФлажкиПодчиненныхЭлементов(ДеревоБухОтчетов, Ложь);
	ИначеЕсли СпособВыбора = 2 Тогда
		ИзменитьФлажкиПодчиненныхЭлементов(ДеревоОтчетов, Ложь);
	Иначе
		ИтоговыйСписокЗначений.Очистить();
		СписокСуществующих.Очистить();
		СписокСуществующих = СписокЗначенийДляВыбора.Скопировать();
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура УчестьВИтоговомСпискеЗначений(ЗначениеФлажка, НаименованиеОтчета)
	
	РанееВыбранноеЗначение = ИтоговыйСписокЗначений.НайтиПоЗначению(НаименованиеОтчета);
	
	Если ЗначениеФлажка = 1 Тогда
		Если РанееВыбранноеЗначение = Неопределено Тогда
			ИтоговыйСписокЗначений.Добавить(НаименованиеОтчета);
		КонецЕсли;
	Иначе
		Если РанееВыбранноеЗначение <> Неопределено Тогда
			ИтоговыйСписокЗначений.Удалить(РанееВыбранноеЗначение);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьИспользованиеВДереве(СтрокаДерева, Значение)
	
	ИзменитьФлажкиПодчиненныхЭлементов(СтрокаДерева,Значение);
	ИзменитьФлажкиРодительскихЭлементов(СтрокаДерева);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьИспользованиеРодителяВДереве(ДетальнаяСтрока)
	
	СтрокаРодитель = ДетальнаяСтрока.Родитель;
	Если НЕ СтрокаРодитель = Неопределено И СтрокаРодитель.Пометка = 0 Тогда
		СтрокаРодитель.Пометка = 2;
		УстановитьИспользованиеРодителяВДереве(СтрокаРодитель);
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура СпособВыбораПриИзменении(Элемент)
	
	Если Элементы.СтраницыСписковОтчетов.ТекущаяСтраница = Элементы.СтраницаСуществующие Тогда
		//Переход со страницы существующих, отмечаем ранее выбранные в деревьях отчетов.
		НайтиПоЗначениюВДереве(ДеревоБухОтчетов);
		НайтиПоЗначениюВДереве(ДеревоОтчетов);
		
	Иначе
		Если СпособВыбора = 0 Тогда
			//Обратный переход, отмечаем в списке существующих отмеченные в деревьях и сущесвующие.
			Для Каждого ВыбранныйЭлемент Из ИтоговыйСписокЗначений Цикл
				НайденныйСуществующий = СписокСуществующих.НайтиПоЗначению(ВыбранныйЭлемент.Значение);
				Если НайденныйСуществующий = Неопределено Тогда
					СписокСуществующих.Добавить(ВыбранныйЭлемент.Значение,,Истина);
				Иначе
					НайденныйСуществующий.Пометка = Истина;
				КонецЕсли;
			КонецЦикла;
			СписокСуществующих.СортироватьПоЗначению();
			
		КонецЕсли;
	КонецЕсли;
	
	Если СпособВыбора = 1 Тогда
		Элементы.СтраницыСписковОтчетов.ТекущаяСтраница = Элементы.СтраницаБухгалтерские;
	ИначеЕсли СпособВыбора = 2 Тогда
		Элементы.СтраницыСписковОтчетов.ТекущаяСтраница = Элементы.СтраницаПрочие;
	Иначе
		Элементы.СтраницыСписковОтчетов.ТекущаяСтраница = Элементы.СтраницаСуществующие;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьОтмеченныеЗначения()
	
	ИтоговыйСписокЗначений.Очистить();
	
	Если СпособВыбора = 0 Тогда
		Для Каждого ЭлементСуществующие Из СписокСуществующих Цикл
			Если ЭлементСуществующие.Пометка Тогда
				ИтоговыйСписокЗначений.Добавить(ЭлементСуществующие.Значение);
			КонецЕсли;	
		КонецЦикла;
	Иначе	
		ПолучитьОтмеченныеПодчиненныеЭлементы(ДеревоБухОтчетов);
		ПолучитьОтмеченныеПодчиненныеЭлементы(ДеревоОтчетов);
	КонецЕсли;
	
	ИтоговыйСписокЗначений.СортироватьПоЗначению();
	
КонецПроцедуры

&НаСервере
Процедура СоздатьДеревоОтчетов()

	ДеревоВсехИспользуемыхОтчетовПоКатегориям = ДеревоВсехИспользуемыхОтчетов();
	
	// Ограничиваем исходное дерево отчетов для ИП на УСН 6%
	ЭлектронныйДокументооборотСКонтролирующимиОрганамиПереопределяемый.УпроститьФормуРегОтчетностиФильтрОтчетов(ДеревоВсехИспользуемыхОтчетовПоКатегориям, КоличествоЭлементовВДеревеОтчетов);
	
	//Перенесем бух.отчеты в отдельное дерево:
	ДеревоВсехБухОтчетов = ДеревоВсехИспользуемыхОтчетовПоКатегориям.Скопировать();
	НаименованиеБухОтчетов = "Отчетность государственных учреждений";
	
	СтрокаОтчетностьГосУчреждений = ДеревоВсехИспользуемыхОтчетовПоКатегориям.Строки.Найти(НаименованиеБухОтчетов, "Наименование", Ложь);
	Если СтрокаОтчетностьГосУчреждений <> Неопределено Тогда
		ДеревоВсехИспользуемыхОтчетовПоКатегориям.Строки.Удалить(СтрокаОтчетностьГосУчреждений);
	КонецЕсли;
	
	СтрокиДляУдаления = Новый Массив;
	Для Каждого СтрокаБухОтчетов Из ДеревоВсехБухОтчетов.Строки Цикл
		Если СтрокаБухОтчетов.Наименование <> НаименованиеБухОтчетов Тогда
			СтрокиДляУдаления.Добавить(СтрокаБухОтчетов);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаДляУдаления Из СтрокиДляУдаления Цикл
		ДеревоВсехБухОтчетов.Строки.Удалить(СтрокаДляУдаления);
	КонецЦикла;
		
	ЗначениеВДанныеФормы(ДеревоВсехИспользуемыхОтчетовПоКатегориям,   ДеревоОтчетов);
	ЗначениеВДанныеФормы(ДеревоВсехБухОтчетов,   ДеревоБухОтчетов);
	
КонецПроцедуры

&НаСервере
Функция ДеревоВсехИспользуемыхОтчетов()
	
	КоличествоЭлементовВДеревеОтчетов  = 0;
	
	ДеревоВсехИспользуемыхОтчетов = ДеревоИзСправочникаРегламентированныеОтчеты();
	
	// Добавим новые колонки для использования расширенных типов
	ДеревоВсехИспользуемыхОтчетов.Колонки.Добавить("Ссылка");
	ДеревоВсехИспользуемыхОтчетов.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка"));
	ДеревоВсехИспользуемыхОтчетов.Колонки.Добавить("ПолноеИмя",    Новый ОписаниеТипов("Строка"));
	ДеревоВсехИспользуемыхОтчетов.Колонки.Добавить("Категория",    Новый ОписаниеТипов("Строка"));
	
	ЗаполнитьНовыеКолонкиДереваОтчетов(ДеревоВсехИспользуемыхОтчетов);
	
	ДеревоВсехИспользуемыхОтчетов.Колонки.Удалить("СсылкаВидОтчета");
	ДеревоВсехИспользуемыхОтчетов.Колонки.Удалить("НаименованиеОтчета");
	ДеревоВсехИспользуемыхОтчетов.Колонки.Удалить("ИсточникОтчета");
	
	РегламентированнаяОтчетность.ДобавитьВДеревоРегламентированныхОтчетовДругиеОтчеты(ДеревоВсехИспользуемыхОтчетов);
	
	// Добавим дополнительные колонки для соответствия данным формы
	ДеревоВсехИспользуемыхОтчетов.Колонки.Добавить("Получатель",     Новый ОписаниеТипов("Строка"));
	ДеревоВсехИспользуемыхОтчетов.Колонки.Добавить("Пометка",        Новый ОписаниеТипов("Число"));
	ДеревоВсехИспользуемыхОтчетов.Колонки.Добавить("ИндексКартинки", Новый ОписаниеТипов("Число"));
	
	ОбработатьДеревоОтчетов(ДеревоВсехИспользуемыхОтчетов);
	ДополнитьДеревоЭлектроннымиПредставлениями(ДеревоВсехИспользуемыхОтчетов);
	ДеревоВсехИспользуемыхОтчетов.Колонки.Удалить("ТипПолучателя");
	
	Для каждого СтрокаПервогоУровня Из ДеревоВсехИспользуемыхОтчетов.Строки Цикл
	
		СтрокаПервогоУровня.Строки.Сортировать("Наименование", Истина);
	
	КонецЦикла;
	
	Возврат ДеревоВсехИспользуемыхОтчетов;
	
КонецФункции

&НаСервере
Функция ДеревоИзСправочникаРегламентированныеОтчеты()
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РегламентированныеОтчеты.Код КАК КодОтчета,	
	|	РегламентированныеОтчеты.Наименование КАК НаименованиеОтчета,
	|	РегламентированныеОтчеты.Ссылка КАК СсылкаВидОтчета,
	|	РегламентированныеОтчеты.ИсточникОтчета КАК ИсточникОтчета,
	|	ВидыОтправляемыхДокументов.ТипПолучателя КАК ТипПолучателя,
	|	РегламентированныеОтчеты.ЭтоГруппа
	|ИЗ
	|	Справочник.РегламентированныеОтчеты КАК РегламентированныеОтчеты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СкрытыеРегламентированныеОтчеты КАК СкрытыеРегламентированныеОтчеты
	|		ПО (СкрытыеРегламентированныеОтчеты.РегламентированныйОтчет = РегламентированныеОтчеты.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыОтправляемыхДокументов КАК ВидыОтправляемыхДокументов
	|		ПО (РегламентированныеОтчеты.ИсточникОтчета = ВидыОтправляемыхДокументов.Источник)
	|			И (ВидыОтправляемыхДокументов.Источник ПОДОБНО ""%[^ ]%"")
	|ГДЕ
	|	СкрытыеРегламентированныеОтчеты.РегламентированныйОтчет ЕСТЬ NULL
	|	И (ВидыОтправляемыхДокументов.ПометкаУдаления ЕСТЬ NULL ИЛИ НЕ ВидыОтправляемыхДокументов.ПометкаУдаления)
	|
	|УПОРЯДОЧИТЬ ПО
	|	КодОтчета ИЕРАРХИЯ");
	
	Возврат Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаполнитьНовыеКолонкиДереваОтчетов(Узел)
	
	СтрокиУзла = Узел.Строки;
	
	Для каждого СтрокаДерева Из СтрокиУзла Цикл
	
		ЗаполнитьНовыеКолонкиДереваОтчетов(СтрокаДерева);
		
		Если СтрокаДерева.ЭтоГруппа <> Истина Тогда
			
			СтрокаДерева.Ссылка = СтрокаДерева.СсылкаВидОтчета;
			СтрокаДерева.ПолноеИмя = "Документ.РегламентированныйОтчет";
			МетаОтчет = Метаданные.Отчеты.Найти(СтрокаДерева.ИсточникОтчета);
			Если МетаОтчет <> Неопределено И МетаОтчет.ОсновнаяФорма <> Неопределено Тогда
				СтрокаДерева.Наименование = МетаОтчет.ОсновнаяФорма.Синоним;
			Иначе
				СтрокаДерева.Наименование = СтрокаДерева.НаименованиеОтчета;
			КонецЕсли;
			
			// Назначим категорию (имя группы родителя)
			Если ТипЗнч(Узел) <> Тип("ДеревоЗначений") Тогда
				СтрокаДерева.Категория = Узел.НаименованиеОтчета;
			КонецЕсли;
			
		Иначе
			
			СтрокаДерева.Наименование = СтрокаДерева.НаименованиеОтчета;
			
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьДеревоОтчетов(Узел)
	
	СтрокиДерева = Узел.Строки;
	
	КолСтрок = СтрокиДерева.Количество();
	
	Для Инд = 1 По КолСтрок Цикл
		
		ОбрИндекс = КолСтрок - Инд;
		СтрокаДерева = СтрокиДерева.Получить(ОбрИндекс);
		
		ОбработатьДеревоОтчетов(СтрокаДерева);
		
		// Удаляем пустую группу
		Если СтрокаДерева.ЭтоГруппа И СтрокаДерева.Строки.Количество() = 0 Тогда
			СтрокиДерева.Удалить(СтрокаДерева);
			Продолжить;
		КонецЕсли;
		
		Если СтрокаДерева.ЭтоГруппа <> Истина Тогда
			
			СтрокаДерева.Получатель = Строка(СтрокаДерева.ТипПолучателя);
			
			СтрокаДерева.ИндексКартинки = 1;
			Если ЗначениеЗаполнено(СтрокаДерева.Ссылка) Тогда
				СтрокаДерева.ИндексКартинки = ?(СтрокаДерева.Ссылка.ПометкаУдаления, 3, 1);
			КонецЕсли;
			
			КоличествоЭлементовВДеревеОтчетов = КоличествоЭлементовВДеревеОтчетов + 1;
			
		Иначе
			СтрокаДерева.ИндексКартинки = 0;
			Если ЗначениеЗаполнено(СтрокаДерева.Ссылка) Тогда
				СтрокаДерева.ИндексКартинки = ?(СтрокаДерева.Ссылка.ПометкаУдаления, 2, 0);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДополнитьДеревоЭлектроннымиПредставлениями(ДеревоВсехИспользуемыхОтчетов)
	ДеревоВсехИспользуемыхОтчетов.Колонки.Добавить("ИмяФайлаШаблона",    Новый ОписаниеТипов("Строка"));
	ТаблицаПредставлений = ПолучитьТаблицуНереализованныхЭлектронныхПредставлений();
	Если ТаблицаПредставлений.Количество() = 0 Тогда 
		Возврат;
	КонецЕсли;
	
	Для каждого СтрокаПервогоУровня Из ДеревоВсехИспользуемыхОтчетов.Строки Цикл
		Если СтрокаПервогоУровня.Строки.Найти(Перечисления.ТипыКонтролирующихОрганов.ФСГС, "ТипПолучателя", Ложь) <> Неопределено Тогда 
			ГруппаЭлектронныеПредставления = СтрокаПервогоУровня.Строки.Вставить(0);
			ГруппаЭлектронныеПредставления.Наименование = "Прочие формы";
			ГруппаЭлектронныеПредставления.ЭтоГруппа = Истина;
			ГруппаЭлектронныеПредставления.Пометка = 2;
			Для Каждого Стр Из ТаблицаПредставлений Цикл
				НовСтр = ГруппаЭлектронныеПредставления.Строки.Вставить(0);
				НовСтр.Наименование = "Статистика: " + СокрЛП(Стр.Наименование);
				НовСтр.ИмяФайлаШаблона = Стр.ИмяФайлаШаблона;
				НовСтр.ТипПолучателя = Перечисления.ТипыКонтролирующихОрганов.ФСГС;
				НовСтр.Получатель = Перечисления.ТипыКонтролирующихОрганов.ФСГС;
				НовСтр.Категория = СтрокаПервогоУровня.Наименование;
				НовСтр.ИндексКартинки = 1;
				НовСтр.Пометка = 2;
			КонецЦикла;
			
			Прервать;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьТаблицуНереализованныхЭлектронныхПредставлений()
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИсточникОтчета", "РегламентированныйОтчетСтатистикаПрочиеФормы");
	Запрос.УстановитьПараметр("КодыФСГС", ПолучитьТаблицуКодовФСГСНереализованныхОтчетов());
	
	Попытка
		ТекущиеНастройки = ХранилищеСистемныхНастроек.Загрузить("СтатистическаяОтчетность.ОтображатьВДеревеРеализованные", "ОтображатьВДеревеРеализованные");
		ОтображатьВДеревеРеализованные = Ложь;
		
		Если ТипЗнч(ТекущиеНастройки) = Тип("Булево") Тогда 
			ОтображатьВДеревеРеализованные = ТекущиеНастройки;
		КонецЕсли;
	Исключение
		ОтображатьВДеревеРеализованные = Ложь;
	КонецПопытки;
	
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТабКодыФСГС.*
	|ПОМЕСТИТЬ ВТ_КодыФСГС
	|ИЗ
	|	&КодыФСГС КАК ТабКодыФСГС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ РегламентированныеОтчеты.Ссылка) КАК Количество,
	|	РегламентированныеОтчеты.ИсточникОтчета
	|ПОМЕСТИТЬ ВТ_ЕстьУниверсальныйОтчет
	|ИЗ
	|	Справочник.РегламентированныеОтчеты КАК РегламентированныеОтчеты
	|ГДЕ
	|	РегламентированныеОтчеты.ИсточникОтчета = &ИсточникОтчета
	|
	|СГРУППИРОВАТЬ ПО
	|	РегламентированныеОтчеты.ИсточникОтчета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ШаблоныЭВФОтчетовСтатистики.Наименование,
	|	ШаблоныЭВФОтчетовСтатистики.ИмяФайлаШаблона
	|ИЗ
	|	ВТ_КодыФСГС КАК ВТ_КодыФСГС
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ШаблоныЭВФОтчетовСтатистики КАК ШаблоныЭВФОтчетовСтатистики
	|		ПО (ВТ_КодыФСГС.ОКУД = ШаблоныЭВФОтчетовСтатистики.ОКУД)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЕстьУниверсальныйОтчет КАК ВТ_ЕстьУниверсальныйОтчет
	|		ПО (ИСТИНА)
	|ГДЕ
	|	ЕСТЬNULL(ВТ_ЕстьУниверсальныйОтчет.Количество, 0) <> 0
	|	И ЕСТЬNULL(ШаблоныЭВФОтчетовСтатистики.ИмяФайлаШаблона, 0) <> 0";
	
	Если Не ОтображатьВДеревеРеализованные Тогда
		Запрос.Текст = Запрос.Текст + " И Не ВТ_КодыФСГС.ЕстьВПрограме"
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьТаблицуКодовФСГСНереализованныхОтчетов()
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ОКУД", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(7)));
	Результат.Колонки.Добавить("ЕстьВПрограме", Новый ОписаниеТипов("Булево"));
	
	Макет = Обработки.ДокументооборотСКонтролирующимиОрганами.ПолучитьМакет("ОписаниеФормДляИмпортаФСГС");
	Для Стр = 2 По Макет.ВысотаТаблицы Цикл 
		ОКУД = Макет.Область(Стр, 1, Стр, 1).Текст;
		Если ЗначениеЗаполнено(ОКУД) Тогда
			Отчет = Макет.Область(Стр, 3, Стр, 3).Текст;
			НовСтр = Результат.Добавить();
			НовСтр.ОКУД = ОКУД;
			Если Метаданные.Отчеты.Найти(Отчет) = Неопределено Тогда 
				НовСтр.ЕстьВПрограме = Ложь;
			Иначе
				НовСтр.ЕстьВПрограме = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

#КонецОбласти
