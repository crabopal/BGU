	Если НаборКонстант.ИспользоватьДетализациюПоКОСГУВГрафикахСПокупателями Тогда
		Подключаемый_ПриИзмененииРеквизита(Элемент,Истина);
	Иначе
		ТекстВопроса = Нстр("ru='При отключении детализации по КОСГУ в графиках с покупателями измерение ""КОСГУ"" в регистрах накопления
		|- ""Оплата от покупателей, дебиторов"",
		|- ""Исполнение договоров с покупателями""
		|будет очищено. 
		|
		|Отключить и очистить детализацию по КОСГУ в регистрах?'");
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да,  НСтр("ru = 'Отключить'"));
		Кнопки.Добавить(КодВозвратаДиалога.Нет, НСтр("ru = 'Отмена'"));

		ПараметрыОтключения = ПараметрыФоновогоИзмененияКонстанты();
		ПараметрыОтключения.ИмяКонстанты                = "ИспользоватьДетализациюПоКОСГУВГрафикахСПокупателями";
		ПараметрыОтключения.ТекстСообщения              = НСтр("ru = 'Выполняется отключение детализации по КОСГУ в графиках с покупателями (дебиторами)'");
		ПараметрыОтключения.ОповещениеУспех             = НСтр("ru = 'Детализация по КОСГУ в графиках с покупателями (дебиторами) отключена'");
		ПараметрыОтключения.ОповещениеНеудача           = НСтр("ru = 'Не удалось отключить детализацию по КОСГУ в графиках с покупателями (дебиторами)'");
		ПараметрыОтключения.НаименованиеФоновогоЗадания = НСтр("ru = 'Отключение детализации по КОСГУ в графиках с покупателями (дебиторами)'"); 
		ПараметрыОтключения.ВыполняемаяПроцедура        = "ОтключитьДетализациюПоКОСГУВГрафикахСПокупателями";
		
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОДополнительнойОбработкеПриИзмененииКонстанты",
			ЭтотОбъект, ПараметрыОтключения);
		ПоказатьВопрос(Оповещение, ТекстВопроса, Кнопки, 60, КодВозвратаДиалога.Нет, , КодВозвратаДиалога.Нет);
		
	КонецЕсли;
	
