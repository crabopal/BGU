&НаКлиенте
Процедура ЛоготипШтампаЭПНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ЗначениеЗаполнено(ЛоготипШтампаЭП) Тогда
		ТекстВопроса = НСтр("ru='Заменить текущий логотип?'");
		
		Оповещение = Новый ОписаниеОповещения("ВопросПередИзменениемЛоготипа", ЭтотОбъект);
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ВыборКартинкиЛоготипа();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВопросПередИзменениемЛоготипа(Результат, ДопПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		ВыборКартинкиЛоготипа();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыборКартинкиЛоготипа()
	
	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбора.ПредварительныйПросмотр = Истина;
	ДиалогВыбора.Фильтр = "Все картинки (*.bmp;*.dib;*.rle;*.jpg;*.jpeg;*.tif;*.gif;*.png;*.ico;*.wmf;*.emf)|*.bmp;*.dib;*.rle;*.jpg;*.jpeg;*.tif;*.gif;*.png;*.ico;*.wmf;*.emf|" 
        			+ "Точечный рисунок BMP (*.bmp;*.dib;*.rle)|*.bmp;*.dib;*.rle|"
        			+ "Формат JPEG (*.jpg;*.jpeg)|*.jpg;*.jpeg|"
        			+ "Формат TIFF (*.tif)|*.tif|"
        			+ "Формат GIF (*.gif)|*.gif|"
        			+ "Формат PNG (*.png)|*.png|"
        			+ "Формат ICON (*.ico)|*.ico|"
        			+ "Метафайл Windows (*.wmf;*.emf)|*.wmf;*.emf|"
					+ "Все файлы (*.*)|*.*|";
					
	ОповещениеВыбора = Новый ОписаниеОповещения("ОбработкаВыбораКартинкиЛоготипа", ЭтотОбъект);
	
	НачатьПомещениеФайла(ОповещениеВыбора, АдресВременногоХранилища, ДиалогВыбора, Истина, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораКартинкиЛоготипа(Результат, Адрес, ИмяВыбрФайла, ДополнительныеПараметры) Экспорт
	
	Если Результат = Ложь Тогда
		Возврат;
	КонецЕсли;	
	
	АдресВременногоХранилища = Адрес;
	
	Если НЕ ЗагрузитьКартинкуЛоготипа() Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Ошибка обработки файла. Логотип не сохранен.'"));
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ЗагрузитьКартинкуЛоготипа()
	
	Результат = Ложь;
	
	Если ЭтоАдресВременногоХранилища(АдресВременногоХранилища) Тогда
		
		ДвоичныеДанныекартинки = ПолучитьИзВременногоХранилища(АдресВременногоХранилища);
		
		Если ТипЗнч(ДвоичныеДанныекартинки) = Тип("ДвоичныеДанные") Тогда
			
			КартинкаЛоготипа = Новый Картинка(ДвоичныеДанныекартинки);
			
			Если ТипЗНЧ(КартинкаЛоготипа) = Тип("Картинка")
				И КартинкаЛоготипа.Вид = ВидКартинки.Абсолютная Тогда
				
				Попытка
					Если КартинкаЛоготипа.НаборВариантов = Ложь Тогда
				
						Константы.ЛоготипШтампаЭП.Установить(Новый ХранилищеЗначения(ДвоичныеДанныекартинки));
				
						ЛоготипШтампаЭП = ПоместитьВоВременноеХранилище(ДвоичныеДанныекартинки, ЭтотОбъект.УникальныйИдентификатор);
				
						Результат = Истина;
					КонецЕсли
				Исключение
					// ничего не делаем, будет сообщение о неверном формате файла
				КонецПопытки;	
				
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ПрочитатьКартинкуЛоготипв()
	
	ДвоичныеДанныекартинки = Константы.ЛоготипШтампаЭП.Получить().Получить();
	
	Если ТипЗнч(ДвоичныеДанныекартинки) = Тип("ДвоичныеДанные") Тогда
		
		КартинкаЛоготипа = Новый Картинка(ДвоичныеДанныекартинки);
		
		Если КартинкаЛоготипа.Вид = ВидКартинки.Абсолютная Тогда

			ЛоготипШтампаЭП = ПоместитьВоВременноеХранилище(ДвоичныеДанныекартинки, ЭтотОбъект.УникальныйИдентификатор);
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

