&НаКлиенте
Процедура ИспользоватьУчетСтудентовПриИзменении(Элемент)
	Подключаемый_ПриИзмененииРеквизита(Элемент, Истина);
	
	УстановитьЗаголовкиГрупп_ГруппаУчетРасчетовсоСтудентами();
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьУчетРодительскойПлатыПриИзменении(Элемент)
	Подключаемый_ПриИзмененииРеквизита(Элемент,Истина);
	
	СсылкаНаНастройки = Неопределено;
	
	Если НаборКонстант.ИспользоватьУчетРодительскойПлаты Тогда
		СозданыНастройки = ПроверитьСозданыНастройкиРодительскойПлаты(СсылкаНаНастройки);
		
		Если СозданыНастройки Тогда
			Текст = НСтр("ru='Учет родительской платы'");
			ТекстПояснения = НСтр("ru='Создана типовая настройка расчетов по родительской плате'");
			ПоказатьОповещениеПользователя(Текст , СсылкаНаНастройки, ТекстПояснения, БиблиотекаКартинок.Информация32);
		КонецЕсли;
	КонецЕсли;
	
	УстановитьЗаголовкиГрупп_ГруппаУчетРодительскойПлаты();
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьУчетПоПодразделениямПриИзменении(Элемент)
	Если НаборКонстант.ИспользоватьУчетПоПодразделениям Тогда
		ПараметрыВключения = ПараметрыФоновогоИзмененияКонстанты();
		ПараметрыВключения.ИмяКонстанты                = "ИспользоватьУчетПоПодразделениям";
		ПараметрыВключения.ТекстСообщения              = НСтр("ru = 'Выполняется включение учета по подразделениям'");
		ПараметрыВключения.ОповещениеУспех             = НСтр("ru = 'Учет по подразделениям включен'");
		ПараметрыВключения.ОповещениеНеудача           = НСтр("ru = 'Не удалось изменить настройку учета по подразделениям'");
		ПараметрыВключения.НаименованиеФоновогоЗадания = НСтр("ru = 'Включение учета по подразделениям'"); 
		ПараметрыВключения.ВыполняемаяПроцедура        = "ВключитьУчетПоПодразделениямВФоне";
		
		ВыполнитьФоновоеИзменениеКонстанты(ПараметрыВключения);
	Иначе	
		ТекстВопроса = Нстр("ru='При отключении ""Учет по подразделениям"" будет выполнена очистка измерения ""Подразделение"" в регистре бухгалтерии. 
		|Отключить?'");
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Отключить и очистить подразделение в проводках'"));
		Кнопки.Добавить(КодВозвратаДиалога.Нет, НСтр("ru = 'Отмена'"));
		
		ПараметрыОтключения = ПараметрыФоновогоИзмененияКонстанты();
		ПараметрыОтключения.ИмяКонстанты                = "ИспользоватьУчетПоПодразделениям";
		ПараметрыОтключения.ТекстСообщения              = НСтр("ru = 'Выполняется отключение учета по подразделениям'");
		ПараметрыОтключения.ОповещениеУспех             = НСтр("ru = 'Учет по подразделениям отключен'");
		ПараметрыОтключения.ОповещениеНеудача           = НСтр("ru = 'Не удалось изменить настройку учета по подразделениям'");
		ПараметрыОтключения.НаименованиеФоновогоЗадания = НСтр("ru = ' Отключение учета по подразделениям'"); 
		ПараметрыОтключения.ВыполняемаяПроцедура        = "ОтключитьУчетПоПодразделениямВФоне"; 
				
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОДополнительнойОбработкеПриИзмененииКонстанты",
			ЭтотОбъект, ПараметрыОтключения);
		ПоказатьВопрос(Оповещение, ТекстВопроса, Кнопки, 60, КодВозвратаДиалога.Нет, , КодВозвратаДиалога.Нет);
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОсновнаяОрганизацияПриИзменении(Элемент)
	Подключаемый_ПриИзмененииРеквизита(Элемент);
