&НаКлиенте
Функция ПараметрыФоновогоИзмененияКонстанты()
	Возврат Новый Структура("ИмяКонстанты, ОповещениеУспех, ОповещениеНеудача,"
		+ "НаименованиеФоновогоЗадания, ВыполняемаяПроцедура, ТекстСообщения");
КонецФункции

&НаКлиенте
Процедура ПослеЗакрытияВопросаОДополнительнойОбработкеПриИзмененииКонстанты(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Нет Тогда
		НаборКонстант[ДополнительныеПараметры.ИмяКонстанты] = СохраненноеЗначениеКонстанты(ДополнительныеПараметры.ИмяКонстанты);
		Возврат;
	КонецЕсли;
	
	ВыполнитьФоновоеИзменениеКонстанты(ДополнительныеПараметры);

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьФоновоеИзменениеКонстанты(ПараметрыИзменения)

	ФоновоеЗадание = ЗапуститьФоновоеЗаданиеИзмененияКонстанты(ПараметрыИзменения.НаименованиеФоновогоЗадания,
		ПараметрыИзменения.ВыполняемаяПроцедура);

	НастройкиОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	НастройкиОжидания.ВыводитьОкноОжидания = Истина;
	НастройкиОжидания.ТекстСообщения = ПараметрыИзменения.ТекстСообщения;

	ПараметрыОбработчика = Новый Структура("ИмяКонстанты, ОповещениеУспех, ОповещениеНеудача");
	ЗаполнитьЗначенияСвойств(ПараметрыОбработчика, ПараметрыИзменения);

	Обработчик = Новый ОписаниеОповещения("ПослеФоновогоИзмененияКонстанты", ЭтотОбъект, ПараметрыОбработчика);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ФоновоеЗадание, Обработчик, НастройкиОжидания);

КонецПроцедуры

&НаКлиенте
Процедура ПослеФоновогоИзмененияКонстанты(ФоновоеЗадание, ДополнительныеПараметры) Экспорт

	НаборКонстант[ДополнительныеПараметры.ИмяКонстанты] = СохраненноеЗначениеКонстанты(
		ДополнительныеПараметры.ИмяКонстанты);
	УстановитьДоступность("НаборКонстант." + ДополнительныеПараметры.ИмяКонстанты);

	Если ФоновоеЗадание <> Неопределено И ФоновоеЗадание.Статус = "Выполнено" Тогда

		ПоказатьОповещениеПользователя(ДополнительныеПараметры.ОповещениеУспех);
		ОбновитьПовторноИспользуемыеЗначения();
		ПодключитьОбработчикОжидания("ОбновитьИнтерфейсПрограммы", 1, Истина);

	Иначе

		Если ФоновоеЗадание <> Неопределено Тогда
			ТекстОшибки = СтрШаблон(НСтр("ru = '%1.
										 |См. подробности в журнале регистрации.'"),
				ДополнительныеПараметры.ОповещениеНеудача);
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция СохраненноеЗначениеКонстанты(Знач ИмяКонстанты)
	Возврат Константы[ИмяКонстанты].Получить();
КонецФункции

&НаСервере
Функция ЗапуститьФоновоеЗаданиеИзмененияКонстанты(НаименованиеЗадания, ВыполняемаяПроцедура)
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НаименованиеЗадания;
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	
	ПараметрыПроцедуры = Новый Структура;
	Если ВыполняемаяПроцедура = "ВключитьУчетПоПодразделениямВФоне" Тогда
		Результат = ДлительныеОперации.ВыполнитьВФоне(
			"ОбщегоНазначенияБГУ.ВключитьУчетПоПодразделениямВФоне", ПараметрыПроцедуры, ПараметрыВыполнения); 
	ИначеЕсли ВыполняемаяПроцедура = "ОтключитьУчетПоПодразделениямВФоне" Тогда
		Результат = ДлительныеОперации.ВыполнитьВФоне(
			"ОбщегоНазначенияБГУ.ОтключитьУчетПоПодразделениямВФоне", ПараметрыПроцедуры, ПараметрыВыполнения); 
	ИначеЕсли ВыполняемаяПроцедура = "ОтключитьВалютныйУчетВФоне" Тогда
		Результат = ДлительныеОперации.ВыполнитьВФоне(
			"ОбщегоНазначенияБГУ.ОтключитьВалютныйУчетВФоне", ПараметрыПроцедуры, ПараметрыВыполнения); 
	ИначеЕсли ВыполняемаяПроцедура = "ОтключитьУчетПоИФОВФоне" Тогда
