		|в регистре бухгалтерии и регистрах накоплений. 
		|Отключить?'");
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Отключить и очистить ИФО в регистрах'"));
		Кнопки.Добавить(КодВозвратаДиалога.Нет, НСтр("ru = 'Отмена'"));
		
		ПараметрыОтключения = ПараметрыФоновогоИзмененияКонстанты();
		ПараметрыОтключения.ИмяКонстанты                = "ИспользоватьУчетПоИФО";
		ПараметрыОтключения.ТекстСообщения              = НСтр("ru = 'Выполняется отключение учета по ИФО'");
		ПараметрыОтключения.ОповещениеУспех             = НСтр("ru = 'Учет по ИФО отключен'");
		ПараметрыОтключения.ОповещениеНеудача           = НСтр("ru = 'Не удалось изменить настройку учета по ИФО'");
		ПараметрыОтключения.НаименованиеФоновогоЗадания = НСтр("ru = ' Отключение учета по ИФО'"); 
		ПараметрыОтключения.ВыполняемаяПроцедура        = "ОтключитьУчетПоИФОВФоне"; 
				
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОДополнительнойОбработкеПриИзмененииКонстанты",
			ЭтотОбъект, ПараметрыОтключения);
		ПоказатьВопрос(Оповещение, ТекстВопроса, Кнопки, 60, КодВозвратаДиалога.Нет, , КодВозвратаДиалога.Нет);
		
	КонецЕсли;

КонецПроцедуры

