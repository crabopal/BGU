////////////////////////////////////////////////////////////////////////////////
// Вызов сервера

&НаСервере
Процедура ПриИзмененииРеквизитаСервер(ИмяЭлемента)
		
	РеквизитПутьКДанным = Элементы[ИмяЭлемента].ПутьКДанным;
	
	Если РеквизитПутьКДанным = "НаборКонстант.ИспользоватьИнтеграциюСУНИФО" И НаборКонстант.ИспользоватьИнтеграциюСУНИФО Тогда
		Если НаборКонстант.ИспользоватьИнтеграциюГИСГМП Тогда
			НаборКонстант.ИспользоватьИнтеграциюГИСГМП = Ложь;
		    СохранитьЗначениеРеквизита("НаборКонстант.ИспользоватьИнтеграциюГИСГМП");
			Если НаборКонстант.ВзаимодействиеГИСГМПЧерезГАН Тогда
				НаборКонстант.ВзаимодействиеГИСГМПЧерезГАН = Ложь;
			    СохранитьЗначениеРеквизита("НаборКонстант.ВзаимодействиеГИСГМПЧерезГАН");
			КонецЕсли;
			Если НаборКонстант.ЭтоБазаГАН Тогда
				НаборКонстант.ЭтоБазаГАН = Ложь;
			    СохранитьЗначениеРеквизита("НаборКонстант.ЭтоБазаГАН");
			КонецЕсли;
			Если НаборКонстант.ИспользоватьОбменСГИСГМП_АЗ Тогда
				НаборКонстант.ИспользоватьОбменСГИСГМП_АЗ = Ложь;
				ИспользоватьОбменАЗ_ГИСГМП = Ложь;
				СохранитьЗначениеРеквизита("НаборКонстант.ИспользоватьОбменСГИСГМП_АЗ");
			КонецЕсли;
		КонецЕсли;		
	ИначеЕсли РеквизитПутьКДанным = "НаборКонстант.ИспользоватьИнтеграциюГИСГМП" И НаборКонстант.ИспользоватьИнтеграциюГИСГМП Тогда
		Если НаборКонстант.ИспользоватьИнтеграциюСУНИФО Тогда
			НаборКонстант.ИспользоватьИнтеграциюСУНИФО = Ложь;
		    СохранитьЗначениеРеквизита("НаборКонстант.ИспользоватьИнтеграциюСУНИФО");
		КонецЕсли;
		Если НаборКонстант.ИспользоватьОбменСГИСГМП_АЗ Тогда
			НаборКонстант.ИспользоватьОбменСГИСГМП_АЗ = Ложь;
			ИспользоватьОбменАЗ_РНИПУНП = Ложь;
		    СохранитьЗначениеРеквизита("НаборКонстант.ИспользоватьОбменСГИСГМП_АЗ");
		КонецЕсли;
	ИначеЕсли РеквизитПутьКДанным = "НаборКонстант.ИспользоватьИнтеграциюГИСГМП" И НЕ НаборКонстант.ИспользоватьИнтеграциюГИСГМП Тогда
		Если НаборКонстант.ВзаимодействиеГИСГМПЧерезГАН Тогда
			НаборКонстант.ВзаимодействиеГИСГМПЧерезГАН = Ложь;
		    СохранитьЗначениеРеквизита("НаборКонстант.ВзаимодействиеГИСГМПЧерезГАН");
		КонецЕсли;
		Если НаборКонстант.ЭтоБазаГАН Тогда
			НаборКонстант.ЭтоБазаГАН = Ложь;
		    СохранитьЗначениеРеквизита("НаборКонстант.ЭтоБазаГАН");
		КонецЕсли;
	ИначеЕсли РеквизитПутьКДанным = "НаборКонстант.ВзаимодействиеГИСГМПЧерезГАН" И НаборКонстант.ВзаимодействиеГИСГМПЧерезГАН Тогда
		Если НаборКонстант.ЭтоБазаГАН Тогда
			НаборКонстант.ЭтоБазаГАН = Ложь;
		    СохранитьЗначениеРеквизита("НаборКонстант.ЭтоБазаГАН");
		КонецЕсли;
	ИначеЕсли РеквизитПутьКДанным = "НаборКонстант.ЭтоБазаГАН" И НаборКонстант.ЭтоБазаГАН Тогда
		Если НаборКонстант.ВзаимодействиеГИСГМПЧерезГАН Тогда
			НаборКонстант.ВзаимодействиеГИСГМПЧерезГАН = Ложь;
		    СохранитьЗначениеРеквизита("НаборКонстант.ВзаимодействиеГИСГМПЧерезГАН");
		КонецЕсли;
	ИначеЕсли РеквизитПутьКДанным = "ИспользоватьОбменАЗ_ГИСГМП" Тогда
		НаборКонстант.ИспользоватьОбменСГИСГМП_АЗ = ИспользоватьОбменАЗ_ГИСГМП;
		СохранитьЗначениеРеквизита("НаборКонстант.ИспользоватьОбменСГИСГМП_АЗ");
	ИначеЕсли РеквизитПутьКДанным = "ИспользоватьОбменАЗ_РНИПУНП" Тогда
		НаборКонстант.ИспользоватьОбменСГИСГМП_АЗ = ИспользоватьОбменАЗ_РНИПУНП;
		СохранитьЗначениеРеквизита("НаборКонстант.ИспользоватьОбменСГИСГМП_АЗ");
	ИначеЕсли РеквизитПутьКДанным = "НаборКонстант.ВестиУчетМногоэтапныхРаботы" Тогда
		НаборКонстант.ВестиУчетМногоэтапныхРабот = Не НаборКонстант.ВестиУчетМногоэтапныхРабот;
	    СохранитьЗначениеРеквизита("НаборКонстант.ВестиУчетМногоэтапныхРабот");
	ИначеЕсли РеквизитПутьКДанным = "НаборКонстант.ИспользоватьИнтеграциюРИ" Тогда
		Если Не НаборКонстант.ИспользоватьИнтеграциюРИ Тогда
			НаборКонстант.ИспользоватьИнтеграциюРФИ = Ложь;
			СохранитьЗначениеРеквизита("НаборКонстант.ИспользоватьИнтеграциюРФИ");
		КонецЕсли;
	ИначеЕсли РеквизитПутьКДанным = "НаборКонстант.ИспользоватьКонтрактыПоГособоронзаказу" Тогда
		Если Не НаборКонстант.ИспользоватьКонтрактыПоГособоронзаказу Тогда
			НаборКонстант.ВестиУчетГособоронзаказа = Ложь;
			СохранитьЗначениеРеквизита("НаборКонстант.ВестиУчетГособоронзаказа");
		КонецЕсли;
	ИначеЕсли РеквизитПутьКДанным = "НаборКонстант.РезервироватьМЗПриВыбытии" Тогда
		Если Не НаборКонстант.РезервироватьМЗПриВыбытии Тогда
			НаборКонстант.РезервироватьСуммуМЗПриВыбытии = Ложь;
			СохранитьЗначениеРеквизита("НаборКонстант.РезервироватьСуммуМЗПриВыбытии");
		КонецЕсли; 
	ИначеЕсли РеквизитПутьКДанным = "НаборКонстант.ИспользоватьОнлайнОплаты" Тогда
		Если Не НаборКонстант.ИспользоватьОнлайнОплаты Тогда
			НаборКонстант.ИспользоватьОнлайнОплаты = Ложь;
			СохранитьЗначениеРеквизита("НаборКонстант.ИспользоватьОнлайнОплаты");
		КонецЕсли;
	ИначеЕсли РеквизитПутьКДанным = "СрокИсполненияВРегистреСрокиИсполненияИСуммыОбязательств" Тогда
		НаборКонстант.СрокИсполненияВРегистреСрокиИсполненияИСуммыОбязательств = ?(СрокИсполненияВРегистреСрокиИсполненияИСуммыОбязательств = 0, Ложь, Истина);
		СохранитьЗначениеРеквизита("НаборКонстант.СрокИсполненияВРегистреСрокиИсполненияИСуммыОбязательств");
	ИначеЕсли РеквизитПутьКДанным = "ИспользоватьДанныеГрафиковПоДоговорамНаДатуАнализаЗадолженности" Тогда
		НаборКонстант.ИспользоватьДанныеГрафиковПоДоговорамНаДатуАнализаЗадолженности = ?(ИспользоватьДанныеГрафиковПоДоговорамНаДатуАнализаЗадолженности = 0, Ложь, Истина);
		СохранитьЗначениеРеквизита("НаборКонстант.ИспользоватьДанныеГрафиковПоДоговорамНаДатуАнализаЗадолженности"); 
	КонецЕсли;
	
	СохранитьЗначениеРеквизита(РеквизитПутьКДанным);
	
	УстановитьДоступность(РеквизитПутьКДанным);
	
	ОбновитьПовторноИспользуемыеЗначения();
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Сервер

&НаСервере
Процедура СохранитьЗначениеРеквизита(РеквизитПутьКДанным)
	
	// Сохранение значений реквизитов, не связанных с константами напрямую (в отношении один-к-одному).
	Если РеквизитПутьКДанным = "" Тогда
		Возврат;
	КонецЕсли;
	
	// Определение имени константы.
	КонстантаИмя = "";
	Если НРег(Лев(РеквизитПутьКДанным, 14)) = НРег("НаборКонстант.") Тогда
		// Если путь к данным реквизита указан через "НаборКонстант".
		КонстантаИмя = Сред(РеквизитПутьКДанным, 15);
	Иначе
		// Определение имени и запись значения реквизита в соответствующей константе из "НаборКонстант".
		// Используется для тех реквизитов формы, которые связаны с константами напрямую (в отношении один-к-одному).
	КонецЕсли;
	
	// Сохранения значения константы.
	Если КонстантаИмя <> "" Тогда
		КонстантаМенеджер = Константы[КонстантаИмя];
		КонстантаЗначение = НаборКонстант[КонстантаИмя];
		
		Если КонстантаМенеджер.Получить() <> КонстантаЗначение Тогда
			КонстантаМенеджер.Установить(КонстантаЗначение);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступность(РеквизитПутьКДанным = "")
	
	Если РеквизитПутьКДанным = "НаборКонстант.ИспользоватьУчетПоПодразделениям" ИЛИ РеквизитПутьКДанным = "" Тогда
		Элементы.КомандаНастроитьУчетПоПодразделениям.Доступность = НаборКонстант.ИспользоватьУчетПоПодразделениям;
	КонецЕсли;
	
	Если РеквизитПутьКДанным = "НаборКонстант.ИспользоватьУчетРодительскойПлаты" ИЛИ РеквизитПутьКДанным = "" Тогда
		Элементы.СсылкаНастройкаКомпенсацииРП.Доступность = НаборКонстант.ИспользоватьУчетРодительскойПлаты;
		Элементы.ИспользоватьРедактируемыеТабелиРодительскаяПлата.Доступность = НаборКонстант.ИспользоватьУчетРодительскойПлаты;
		Элементы.КонтрагентВАктеОбОказанииУслугНачисленияРодПлаты.Доступность = НаборКонстант.ИспользоватьУчетРодительскойПлаты;
	КонецЕсли;
	
	Если РеквизитПутьКДанным = "НаборКонстант.ИспользоватьУчетГСМ" ИЛИ РеквизитПутьКДанным = "" ИЛИ РеквизитПутьКДанным = "НаборКонстант.ИспользоватьУчетГСМ" Тогда
		Элементы.СсылкаНастройкаОкругленияНормГСМ.Доступность = НаборКонстант.ИспользоватьУчетГСМ;
		Элементы.СсылкаНастройкиДокументовУчетаГСМ.Доступность = НаборКонстант.ИспользоватьУчетГСМ;
		Элементы.СсылкаНастройкиОтраженияЗатратНаГСМ.Доступность = НаборКонстант.ИспользоватьУчетГСМ;
		Элементы.СсылкаНастройкиЗаполненияМедосмотровГСМ.Доступность = НаборКонстант.ИспользоватьУчетГСМ;
	КонецЕсли;
	
	Если РеквизитПутьКДанным = "НаборКонстант.ИспользоватьОплатуПлатежнымиКартами" ИЛИ РеквизитПутьКДанным = "" ИЛИ РеквизитПутьКДанным = "НаборКонстант.ИспользоватьОплатуПлатежнымиКартами" Тогда
		Элементы.СсылкаПодключаемоеОборудование.Доступность 			= НаборКонстант.ИспользоватьОплатуПлатежнымиКартами;
		Элементы.СсылкаЭквайринговыеТерминалы.Доступность 				= НаборКонстант.ИспользоватьОплатуПлатежнымиКартами;
		Элементы.СсылкаВидыПлатежныхКарт.Доступность 					= НаборКонстант.ИспользоватьОплатуПлатежнымиКартами;
		Элементы.СсылкаПараметрыДоговораЭквайринга.Доступность 			= НаборКонстант.ИспользоватьОплатуПлатежнымиКартами;
		Элементы.СсылкаНастройкиЭквайрингаДляРабочихМест.Доступность 	= НаборКонстант.ИспользоватьОплатуПлатежнымиКартами;
		Элементы.СсылкаФискальныеРегистраторы.Доступность 				= НаборКонстант.ИспользоватьОплатуПлатежнымиКартами;
	КонецЕсли;
	
	Если РеквизитПутьКДанным = "НаборКонстант.ИспользоватьНастройкиПлатежногоАгента" ИЛИ РеквизитПутьКДанным = "" ИЛИ РеквизитПутьКДанным = "НаборКонстант.ИспользоватьНастройкиПлатежногоАгента" Тогда
		Элементы.СсылкаПараметрыДоговоровПлатежныхАгентов.Доступность	= НаборКонстант.ИспользоватьНастройкиПлатежногоАгента;
		Элементы.СсылкаНастройкиПлатежногоАгентаДляРабочихМест.Доступность 	= НаборКонстант.ИспользоватьНастройкиПлатежногоАгента;
	КонецЕсли;
	
	Если РеквизитПутьКДанным = "НаборКонстант.ИспользоватьИнтеграциюЕБП" ИЛИ РеквизитПутьКДанным = "" Тогда
		Элементы.УдалятьИсториюОбменаЕБП.Доступность		= НаборКонстант.ИспользоватьИнтеграциюЕБП;
		Элементы.СрокХраненияИсторииОбменаЕБП.Доступность 	= НаборКонстант.ИспользоватьИнтеграциюЕБП;
		Элементы.УдалятьЛогиОбменаЕБП.Доступность			= НаборКонстант.ИспользоватьИнтеграциюЕБП;
		Элементы.СрокХраненияЛоговОбменаЕБП.Доступность 	= НаборКонстант.ИспользоватьИнтеграциюЕБП;
	КонецЕсли;
	
	Если РеквизитПутьКДанным = "НаборКонстант.НеВключатьЗабалансовыеСчетаВБухгалтерскуюСправку" 
		ИЛИ РеквизитПутьКДанным = "НаборКонстант.НеВыводитьИтоговуюСуммуВБухгалтерскойСправке"
		ИЛИ РеквизитПутьКДанным = "" Тогда
		Элементы.ВыводитьОбщийИтогВБухгалтерскойСправке.Доступность         = НЕ (НаборКонстант.НеВыводитьИтоговуюСуммуВБухгалтерскойСправке
																			ИЛИ НаборКонстант.НеВключатьЗабалансовыеСчетаВБухгалтерскуюСправку);
		Элементы.ВыводитьРаздельноИтогиВБухгалтерскойСправке.Доступность	= НЕ (НаборКонстант.НеВыводитьИтоговуюСуммуВБухгалтерскойСправке
																			ИЛИ НаборКонстант.НеВключатьЗабалансовыеСчетаВБухгалтерскуюСправку);
	КонецЕсли;
																		
	
	Если РеквизитПутьКДанным = "НаборКонстант.ИспользоватьИнтеграциюГИСГМП" 
		ИЛИ РеквизитПутьКДанным = "НаборКонстант.ИспользоватьИнтеграциюСУНИФО" 
		ИЛИ РеквизитПутьКДанным = "" Тогда
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЭтоБазаГАН", "Доступность", НаборКонстант.ИспользоватьИнтеграциюГИСГМП);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ВзаимодействиеГИСГМПЧерезГАН", "Доступность", НаборКонстант.ИспользоватьИнтеграциюГИСГМП);
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ИспользоватьОбменАЗ_РНИПУНП", "Доступность", НаборКонстант.ИспользоватьИнтеграциюСУНИФО);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ИспользоватьОбменАЗ_ГИСГМП", "Доступность", НаборКонстант.ИспользоватьИнтеграциюГИСГМП);
	КонецЕсли;
	
	Если РеквизитПутьКДанным = "НаборКонстант.ИспользоватьИнтеграциюРИ" Или РеквизитПутьКДанным = "" Тогда
		
		Элементы.ИспользоватьИнтеграциюРФИ.Доступность = НаборКонстант.ИспользоватьИнтеграциюРИ;
		
	КонецЕсли;
	
	Если РеквизитПутьКДанным = "НаборКонстант.ИспользоватьЦентрализованнуюБухгалтерию" ИЛИ РеквизитПутьКДанным = "" Тогда
		Элементы.НастройкаПравПодписиДокументов.Доступность = НаборКонстант.ИспользоватьЦентрализованнуюБухгалтерию;
		Элементы.НастройкаВыбораОтветственныхЦБ.Доступность = НаборКонстант.ИспользоватьЦентрализованнуюБухгалтерию;
	КонецЕсли;
	
	Если РеквизитПутьКДанным = "НаборКонстант.ИспользоватьКонтрактыПоГособоронзаказу" Или РеквизитПутьКДанным = "" Тогда
		Элементы.ВестиУчетГОЗ.Доступность = НаборКонстант.ИспользоватьКонтрактыПоГособоронзаказу;
	КонецЕсли;
	
	Если РеквизитПутьКДанным = "НаборКонстант.ИспользоватьДанныеЗаполненияВФорматеСводОтчетовОбластиДанных" Или РеквизитПутьКДанным = "" Тогда
		//Если включена общая настройка, то отключаем доступность разделенной настройки
		Если Константы.ИспользоватьДанныеЗаполненияВФорматеСводОтчетов.Получить() = Истина Тогда
			Элементы.ИспользоватьДанныеЗаполненияВФорматеСводОтчетовОбластиДанных.Доступность = Ложь;
			НаборКонстант.ИспользоватьДанныеЗаполненияВФорматеСводОтчетовОбластиДанных = Истина;
		КонецЕсли;	
			
	КонецЕсли;
	
	Если РеквизитПутьКДанным = "НаборКонстант.ИспользоватьКонтрольИсполненияДоговоров" ИЛИ РеквизитПутьКДанным = "" Тогда
		Элементы.ТекстИспользоватьДетализациюПоКОСГУВГрафикахПоДоговорам.Доступность = НаборКонстант.ИспользоватьКонтрольИсполненияДоговоров;
		Элементы.ИспользоватьДетализациюПоКОСГУВГрафикахСПокупателями.Доступность = НаборКонстант.ИспользоватьКонтрольИсполненияДоговоров;
		Элементы.ИспользоватьДетализациюПоКОСГУВГрафикахСПоставщиками.Доступность = НаборКонстант.ИспользоватьКонтрольИсполненияДоговоров;
		Элементы.ТекстИспользоватьДополнительнуюАналитикуВГрафикахПлатежей.Доступность = НаборКонстант.ИспользоватьКонтрольИсполненияДоговоров;
		Элементы.ИспользоватьДополнительнуюАналитикуВГрафикахПлатежейСПокупателями.Доступность = НаборКонстант.ИспользоватьКонтрольИсполненияДоговоров;
		Элементы.ИспользоватьДополнительнуюАналитикуВГрафикахПлатежейСПоставщиками.Доступность = НаборКонстант.ИспользоватьКонтрольИсполненияДоговоров;
		Элементы.ИспользоватьДанныеГрафиковПоДоговорамНаДатуАнализаЗадолженности.Доступность = НаборКонстант.ИспользоватьКонтрольИсполненияДоговоров
			И ПравоДоступа("Изменение", Метаданные.Константы.ИспользоватьДанныеГрафиковПоДоговорамНаДатуАнализаЗадолженности);
	КонецЕсли;
	
	Если РеквизитПутьКДанным = "ИспользоватьДанныеГрафиковПоДоговорамНаДатуАнализаЗадолженности" ИЛИ РеквизитПутьКДанным = "" Тогда
		Элементы.ГиперссылкаИспользоватьДанныеГрафиковПоДоговорамНаДатуАнализаЗадолженности.Доступность = НаборКонстант.ИспользоватьДанныеГрафиковПоДоговорамНаДатуАнализаЗадолженности;
	КонецЕсли;
	
	Если РеквизитПутьКДанным = "НаборКонстант.РезервироватьМЗПриВыбытии" ИЛИ РеквизитПутьКДанным = "" Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "РезервироватьСуммуМЗПриВыбытии",
			"Доступность", НаборКонстант.РезервироватьМЗПриВыбытии);
	КонецЕсли;
	
	Если РеквизитПутьКДанным = "НаборКонстант.ИспользоватьВнутренниеДокументыЭДО" ИЛИ РеквизитПутьКДанным = "" Тогда
		ИспользоватьВнутренниеДокументыЭДО = Константы.ИспользоватьВнутренниеДокументыЭДО.Получить();
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НастройкиВнутреннегоЭДО",
			"Доступность", ИспользоватьВнутренниеДокументыЭДО);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "КомандаМаршрутыПодписания",
			"Доступность", ИспользоватьВнутренниеДокументыЭДО);
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ИспользоватьУведомленияОЗадачахВнутреннийЭДО",
			"Доступность", ИспользоватьВнутренниеДокументыЭДО);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОтображатьДатуПодписанияВШтампеВизуализацииПЭП",
			"Доступность", ИспользоватьВнутренниеДокументыЭДО);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОтображатьДатуПодписанияВШтампеВизуализацииПЭПАрхив",
			"Доступность", ИспользоватьВнутренниеДокументыЭДО);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НастройкаОтображенияДатыПоОрганизациям",
			"Доступность", ИспользоватьВнутренниеДокументыЭДО);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НастройкаОтображенияДатыПоОрганизациямАрхив",
			"Доступность", ИспользоватьВнутренниеДокументыЭДО); 
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПроверятьСведенияОДолжностиПодписантаПЭП",
			"Доступность", ИспользоватьВнутренниеДокументыЭДО);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ВнутреннийЭДОВидПодписиПоУмолчаниюДляНовогоПодписантаВМаршруте",
			"Доступность", ИспользоватьВнутренниеДокументыЭДО);
		
	КонецЕсли;
	
	Если РеквизитПутьКДанным = "НаборКонстант.ОтображатьДатуПодписанияВШтампеВизуализацииПЭП" ИЛИ РеквизитПутьКДанным = "" Тогда
		ОтображатьДатуПодписанияВШтампеВизуализацииПЭП = Константы.ОтображатьДатуПодписанияВШтампеВизуализацииПЭП.Получить();
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НастройкаОтображенияДатыПоОрганизациям",
			"Доступность", ОтображатьДатуПодписанияВШтампеВизуализацииПЭП);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НастройкаОтображенияДатыПоОрганизациямАрхив",
			"Доступность", ОтображатьДатуПодписанияВШтампеВизуализацииПЭП);
		Если ОтображатьДатуПодписанияВШтампеВизуализацииПЭП Тогда
			ЗаголовокКомандыИсключенияВШтампе = ПолучитьЗаголовокКомандыИсключенияВШтампе();
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НастройкаОтображенияДатыПоОрганизациям",
			"Заголовок", ЗаголовокКомандыИсключенияВШтампе);
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НастройкаОтображенияДатыПоОрганизациямАрхив",
			"Заголовок", ЗаголовокКомандыИсключенияВШтампе);
		КонецЕсли;
	КонецЕсли;
	
	Если РеквизитПутьКДанным = "НаборКонстант.ИспользоватьОнлайнОплаты" ИЛИ РеквизитПутьКДанным = "" Тогда
		Элементы.ГруппаНастройкиЯндексКассаЛево.Доступность 	= НаборКонстант.ИспользоватьОнлайнОплаты;
		Элементы.ГруппаНастройкиЯндексКассаПраво.Доступность 	= НаборКонстант.ИспользоватьОнлайнОплаты;
	КонецЕсли; 
	
	Если РеквизитПутьКДанным = "НаборКонстант.ИспользоватьОбменИСМПБГУ" ИЛИ РеквизитПутьКДанным = "" Тогда
		Элементы.НастройкаИнтеграцииСИСМП.Доступность = НаборКонстант.ИспользоватьОбменИСМПБГУ
		И ПравоДоступа("Просмотр", Метаданные.ОбщиеФормы.НастройкиОбменИСМПБГУ);
	КонецЕсли;
	
	Если РеквизитПутьКДанным = "" Тогда
		
		ЭтоРИБ = ПланыОбмена.ГлавныйУзел() <> Неопределено;	
		
		Если ЭтоРИБ Тогда
			Элементы.ИспользоватьВалютныйУчет.Доступность 						= Ложь;
			Элементы.УчетВРазрезеИсточниковФинансовогоОбеспечения.Доступность 	= Ложь;
			Элементы.ИспользоватьУчетПоПодразделениям.Доступность 				= Ложь;
			Элементы.КомандаНастроитьУчетПоПодразделениям.Доступность 			= Ложь;
			Элементы.ВестиУчетПродуктовПитания.Доступность 						= Ложь;
			Элементы.ИспользоватьУчетСтудентов.Доступность 						= Ложь;
			Элементы.ИспользоватьУчетРодительскойПлаты.Доступность 				= Ложь;
			Элементы.ВестиКоличественныйУчетДенежныхДокументов.Доступность 		= Ложь;
			Элементы.ФондоваяКассоваяКнигаСовместноСДенежной.Доступность 		= Ложь;
			Элементы.ИспользоватьИнтеграциюСУНИФО.Доступность 					= Ложь;
			Элементы.ИспользоватьИнтеграциюГИСГМП.Доступность 					= Ложь;
			Элементы.ИспользоватьИнтеграциюРИ.Доступность 						= Ложь;
			Элементы.ИспользоватьИнтеграциюРФИ.Доступность 						= Ложь;
			Элементы.ВестиУчетИмуществаКазны.Доступность 						= Ложь;
			Элементы.ВестиУчетГОЗ.Доступность 									= Ложь;
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДействияПриКонтроле", "Доступность", 
									(НаборКонстант.КонтрольОбязательств));
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПараметрыКонтроля", "Доступность", 
									(НаборКонстант.КонтрольОбязательств));
									
		Элементы.ГруппаНастройкиДлительность.Доступность = ПереводыСБПc2b.ПереводыСБПДоступны();							
	КонецЕсли;
	
	Настрока54ФЗПриСозданииНаСервере();
	УведомлениеИсполнителейВнутреннийЭДОПриСозданииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимость()
	
	ВидимостьГруппыВнутреннегоЭДО = ОбменСКонтрагентамиИнтеграция.РазрешеноИспользоватьВнутреннийЭДО();
	Элементы.ГруппаВнутреннийЭДО.Видимость = ВидимостьГруппыВнутреннегоЭДО;
	Элементы.ГруппаВнутреннийЭДОАрхив.Видимость = НЕ ВидимостьГруппыВнутреннегоЭДО;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СрокИсполненияВРегистреСрокиИсполненияИСуммыОбязательств",
		"Видимость", ПравоДоступа("Просмотр", Метаданные.Константы.СрокИсполненияВРегистреСрокиИсполненияИСуммыОбязательств));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СрокИсполненияВРегистреСрокиИсполненияИСуммыОбязательств",
		"Доступность", ПравоДоступа("Изменение", Метаданные.Константы.СрокИсполненияВРегистреСрокиИсполненияИСуммыОбязательств));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ИспользоватьДанныеГрафиковПоДоговорамНаДатуАнализаЗадолженности",
		"Видимость", ПравоДоступа("Просмотр", Метаданные.Константы.ИспользоватьДанныеГрафиковПоДоговорамНаДатуАнализаЗадолженности));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ТипКонтроляОстатковПриИзмененияхВПрошлыхПериодах",
		"Видимость", НаборКонстант.КонтролироватьОстаткиНоменклатурыПриИзмененияхВПрошлыхПериодах);

КонецПроцедуры

&НаСервере
Функция ПроверитьСозданыНастройкиРодительскойПлаты(Ссылка)
	Возврат РасчетыПоРодительскойПлате.СоздатьТиповыеНастройкиРасчетов(Ссылка);
КонецФункции

&НаКлиенте
Процедура КомандаРассылкаЭлектронныхЧековНастроитьРасписание(Команда)
	РегламентныеЗаданияГиперссылкаНажатие("РассылкаЭлектронныхЧеков");
КонецПроцедуры

&НаКлиенте
Процедура КомандаУведомлениеОЗадачахЭДОНастроитьРасписание(Команда)
	РегламентныеЗаданияГиперссылкаНажатие("УведомлениеОЗадачахВнутреннийЭДО");
КонецПроцедуры

&НаКлиенте
Процедура РегламентныеЗаданияГиперссылкаНажатие(ПрефиксРеквизитов)
	ПараметрыВыполнения = Новый Структура;
	ПараметрыВыполнения.Вставить("Идентификатор", ЭтотОбъект[ПрефиксРеквизитов + "Идентификатор"]);
	ПараметрыВыполнения.Вставить("ИмяРеквизитаРасписание", ПрефиксРеквизитов + "Расписание");
	
	РегламентныеЗаданияИзменитьРасписание(ПараметрыВыполнения);
КонецПроцедуры

&НаКлиенте
Процедура РегламентныеЗаданияИзменитьРасписание(ПараметрыВыполнения)
	Обработчик = Новый ОписаниеОповещения("РегламентныеЗаданияПослеИзмененияРасписания", ЭтотОбъект, ПараметрыВыполнения);
	Диалог = Новый ДиалогРасписанияРегламентногоЗадания(ЭтотОбъект[ПараметрыВыполнения.ИмяРеквизитаРасписание]);
	Диалог.Показать(Обработчик);
КонецПроцедуры

&НаКлиенте
Процедура РегламентныеЗаданияПослеИзмененияРасписания(Расписание, ПараметрыВыполнения) Экспорт
	Если Расписание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭтотОбъект[ПараметрыВыполнения.ИмяРеквизитаРасписание] = Расписание;
	
	Изменения = Новый Структура("Расписание", Расписание);
	Если ПараметрыВыполнения.Свойство("ИмяРеквизитаИспользование") Тогда
		ЭтотОбъект[ПараметрыВыполнения.ИмяРеквизитаИспользование] = Истина;
		Изменения.Вставить("Использование", Истина);
	КонецЕсли;
	РегламентныеЗаданияСохранить(ПараметрыВыполнения.Идентификатор, Изменения, ПараметрыВыполнения.ИмяРеквизитаРасписание);
КонецПроцедуры

&НаСервере
Функция РегламентныеЗаданияНайтиПредопределенное(ИмяПредопределенного)
	Фильтр = Новый Структура("Метаданные", ИмяПредопределенного);
	Найденные = РегламентныеЗаданияСервер.НайтиЗадания(Фильтр);
	Задание = ?(Найденные.Количество() = 0, Неопределено, Найденные[0]);
	
	Если ТипЗнч(Задание) = Тип("СтрокаТаблицыЗначений")
		И Задание.Владелец().Колонки.Найти("УникальныйИдентификатор") = Неопределено Тогда
		Задание.Владелец().Колонки.Идентификатор.Имя = "УникальныйИдентификатор";
	КонецЕсли;
	
	Возврат Задание;
КонецФункции

&НаСервере
Процедура РегламентныеЗаданияСохранить(УникальныйИдентификатор, Изменения, РеквизитПутьКДанным)
	РегламентныеЗаданияСервер.ИзменитьЗадание(УникальныйИдентификатор, Изменения);
	Если РеквизитПутьКДанным <> Неопределено Тогда
		УстановитьДоступность(РеквизитПутьКДанным);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура Настрока54ФЗПриСозданииНаСервере()
	
	Если НЕ ((ОбщегоНазначения.РазделениеВключено() 
		И ОбщегоНазначения.ДоступноИспользованиеРазделенныхДанных() 
		И Пользователи.ЭтоПолноправныйПользователь())
		ИЛИ ПравоДоступа("Администрирование", Метаданные)) Тогда
		
		Элементы.ГруппаНастройкаРасписанияОтправкиЧеков.Видимость = Ложь;
		
		Возврат;
		
	КонецЕсли;	
	
	РегламентноеЗадание = РегламентныеЗаданияНайтиПредопределенное("РассылкаЭлектронныхЧеков");
	ВидимостьРасписания = (РегламентноеЗадание <> Неопределено);
	Если ВидимостьРасписания Тогда
		РассылкаЭлектронныхЧековИдентификатор = РегламентноеЗадание.УникальныйИдентификатор;
		РассылкаЭлектронныхЧековРасписание    = РегламентноеЗадание.Расписание;
	КонецЕсли;
	//ВидимостьРасписания = ВидимостьФлажка И Не РежимРаботы.МодельСервиса И РежимРаботы.ЭтоАдминистраторСистемы;
	Элементы.КомандаРассылкаЭлектронныхЧековНастроитьРасписание.Видимость     = ВидимостьРасписания;
	Элементы.РассылкаЭлектронныхЧековПредставлениеРасписания.Видимость = ВидимостьРасписания;
	
	ОтправкаЭлектронныхЧековПослеПробитияЧека = Константы.ОтправкаЭлектронныхЧековПослеПробитияЧека.Получить();
	ОтправкаЭлектронныхЧеков = Число(ОтправкаЭлектронныхЧековПослеПробитияЧека);
	РассылкаЭлектронныхЧековИспользование = НЕ ОтправкаЭлектронныхЧековПослеПробитияЧека;
	
	Элементы.КомандаРассылкаЭлектронныхЧековНастроитьРасписание.Доступность = НЕ ОтправкаЭлектронныхЧековПослеПробитияЧека;
	
	Если РассылкаЭлектронныхЧековИспользование Тогда
		РасписаниеПредставление = Строка(РассылкаЭлектронныхЧековРасписание);
		Представление = ВРег(Лев(РасписаниеПредставление, 1)) + Сред(РасписаниеПредставление, 2);
	Иначе
		Представление = НСтр("ru = '<Отключено>'");
	КонецЕсли;
	Элементы.РассылкаЭлектронныхЧековПредставлениеРасписания.Заголовок = Представление;
	Элементы.КомандаРассылкаЭлектронныхЧековНастроитьРасписание.Доступность = РассылкаЭлектронныхЧековИспользование;
	
КонецПроцедуры

&НаСервере
Процедура УведомлениеИсполнителейВнутреннийЭДОПриСозданииНаСервере()
	
	Если НЕ Пользователи.ЭтоПолноправныйПользователь()
		ИЛИ НЕ ПравоДоступа("Администрирование", Метаданные) Тогда
		
		Элементы.ГруппаУведомлениеИсполнителейВнутреннийЭДО.Видимость = Ложь;
		Возврат;
	КонецЕсли;	
	
	Если ОбщегоНазначения.РазделениеВключено() Тогда
		Элементы.ГруппаУведомлениеИсполнителейПравая.Видимость = Ложь
	КонецЕсли;
	
	РегламентноеЗадание = РегламентныеЗаданияНайтиПредопределенное("УведомлениеОЗадачахВнутреннийЭДО");
	ВидимостьРасписания = (РегламентноеЗадание <> Неопределено);
	Если ВидимостьРасписания Тогда
		УведомлениеОЗадачахВнутреннийЭДОИдентификатор = РегламентноеЗадание.УникальныйИдентификатор;
		УведомлениеОЗадачахВнутреннийЭДОРасписание    = РегламентноеЗадание.Расписание;
	КонецЕсли;
	//ВидимостьРасписания = ВидимостьФлажка И Не РежимРаботы.МодельСервиса И РежимРаботы.ЭтоАдминистраторСистемы;
	Элементы.КомандаУведомлениеОЗадачахЭДОНастроитьРасписание.Видимость        = ВидимостьРасписания;
	Элементы.УведомлениеОЗадачахВнутреннийЭДОПредставлениеРасписания.Видимость = ВидимостьРасписания;
	
	УведомлениеОЗадачахВнутреннийЭДОИспользование = Константы.ИспользоватьУведомленияОЗадачахВнутреннийЭДО.Получить();
	Элементы.КомандаУведомлениеОЗадачахЭДОНастроитьРасписание.Доступность = УведомлениеОЗадачахВнутреннийЭДОИспользование;
	
	Если УведомлениеОЗадачахВнутреннийЭДОИспользование Тогда
		РасписаниеПредставление = Строка(УведомлениеОЗадачахВнутреннийЭДОРасписание);
		Представление = ВРег(Лев(РасписаниеПредставление, 1)) + Сред(РасписаниеПредставление, 2);
	Иначе
		Представление = НСтр("ru = '<Отключено>'");
	КонецЕсли;
	Элементы.УведомлениеОЗадачахВнутреннийЭДОПредставлениеРасписания.Заголовок = Представление;
	Элементы.КомандаУведомлениеОЗадачахЭДОНастроитьРасписание.Доступность = УведомлениеОЗадачахВнутреннийЭДОИспользование;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьЗаголовокКомандыИсключенияВШтампе()
	
	ЗаголовокКоманды = НСтр("ru = 'по всем организациям'");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ИсключенияОтображенияДатыПодписанияВШтампе.Организация КАК Организация
		|ИЗ
		|	РегистрСведений.ИсключенияОтображенияДатыПодписанияВШтампе КАК ИсключенияОтображенияДатыПодписанияВШтампе";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ЗаголовокКоманды = НСтр("ru = 'установлены настройки по организациям'");
	КонецЕсли;
	
	Возврат ЗаголовокКоманды;
	
КонецФункции

