
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
		
	ТекущийРазделУчета = "Общие настройки";
	Элементы.ГруппаСтраницы.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
	
	СрокИсполненияВРегистреСрокиИсполненияИСуммыОбязательств = ?(НаборКонстант.СрокИсполненияВРегистреСрокиИсполненияИСуммыОбязательств, 1, 0);
	ИспользоватьДанныеГрафиковПоДоговорамНаДатуАнализаЗадолженности = ?(НаборКонстант.ИспользоватьДанныеГрафиковПоДоговорамНаДатуАнализаЗадолженности, 1, 0);
	
	Если НаборКонстант.ИспользоватьОбменСГИСГМП_АЗ Тогда
		Если НаборКонстант.ИспользоватьИнтеграциюГИСГМП Тогда
			ИспользоватьОбменАЗ_ГИСГМП = Истина;	
		ИначеЕсли НаборКонстант.ИспользоватьИнтеграциюСУНИФО Тогда
			ИспользоватьОбменАЗ_РНИПУНП = Истина;	
		КонецЕсли;
	КонецЕсли;
	
	// Обновление состояния элементов
	УстановитьДоступность();
	
	УстановитьВидимость();
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтаФорма, Элементы.ИнформационныеСсылки);
	
	Если Параметры.Свойство("Закладка") Тогда
		Если Параметры.Закладка = НСтр("ru='Денежные средства'") Тогда
			ТекущийРазделУчета = НСтр("ru='Денежные средства'");
			Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаПараметрыКасса;
		КонецЕсли;	
	КонецЕсли;	
	
	ПрочитатьКартинкуЛоготипв();
	
	УстановитьНастройкиЮКасса();
	УстановитьНастройкиСБП();  
	
	// ИнтеграцияСМСД
	ДобавитьЭлементыФормыМСД();
	// Конец ИнтеграцияСМСД
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УстановитьЗаголовкиГрупп();
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	ОбработчикОповещений(ИмяСобытия, Параметр, Источник);
КонецПроцедуры

#КонецОбласти

