&НаКлиенте
Процедура НастроитьФормуНастройкиОтбораПоКодуФормы()
	
	ИменаЭлементов = Новый Массив();
	ИменаЭлементов.Добавить("СнятьОтборПоКодуФормы61н");
	ИменаЭлементов.Добавить("УстановитьОтборПоКодуФормы61н");
	ИменаЭлементов.Добавить("СнятьОтборПоКодуФормы52н");
	ИменаЭлементов.Добавить("УстановитьОтборПоКодуФормы52н");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементов,
		"Доступность", УстановленОтборПоКодуФормы);
	
	ИменаЭлементов = Новый Массив();
	ИменаЭлементов.Добавить("СтраницаОтборПоКодуФормыПриказ61н");
	ИменаЭлементов.Добавить("СтраницаОтборПоКодуФормыПриказ52н");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементов,
		"ТолькоПросмотр", Не УстановленОтборПоКодуФормы);
	
	УстановитьЗаголовокНастроекОтбораПоКодуФормы61н();
	УстановитьЗаголовокНастроекОтбораПоКодуФормы52н();
	
КонецПроцедуры

