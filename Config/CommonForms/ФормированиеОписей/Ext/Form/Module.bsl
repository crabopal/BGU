&НаСервере
Функция ПолучитьШаблонКомментарияПоУмолчанию()
	
	// Доступные параметры:
	//	[ДатаВремя]
	//	[ОбщийСчетчикДокументов]
	//	[ОбщееКоличествоДокументов]
	//	[СчетчикДокументовКодаФормы]
	//	[КоличествоДокументовКодаФормы]
	
	Возврат НСтр("ru='#Создано групповым формированием описей [ДатаВремя]. Документ [ОбщийСчетчикДокументов] из [ОбщееКоличествоДокументов]'");
	
КонецФункции

&НаСервере
Функция ПолучитьПодсказкуПараметрыШаблонаКомментария()
	
	Возврат НСтр("ru='Поддерживаются следующие параметры, которые можно использовать в шаблоне строки комментария:
		|
		|[ДатаВремя] - дата и время запуска группового формирования документов описей. Значение этого параметра будет одинаковым для всех формируемых документов;
        |
		|[ОбщийСчетчикДокументов] - счетчик текущего документа в общем списке всех сформированных документов, независимо от кода формы;
        |
		|[ОбщееКоличествоДокументов] - общее количество всех сформированных документов, независимо от кода формы;
        |
		|[СчетчикДокументовКодаФормы] - счетчик текущего документа в списке документов текущего кода формы;
        |
		|[КоличествоДокументовКодаФормы] - общее количество сформированных документов текущего кода формы.'");
	
КонецФункции


&НаСервере
Функция НовыйИменаДокументовСозданиеПредусмотрено()
	
	// Важно: Указанные здесь документы должны иметь уникальные коды форм.
	// Дальнейшими алгоритмами предусмотрено, что одному коду формы соответствует
	// один формируемый документ и одна строка таблицы настроек на дату Решения.
	// Далее выполняется проверка корректности настроек, и в случае проблем вызывается исключение.
	
	ИменаДокументов = Новый Массив();
	
	ИменаДокументов.Добавить("ИнвентаризационнаяОписьОстатковНаСчетах"); // 0510464
	ИменаДокументов.Добавить("ИнвентаризационнаяОписьБСО"); // 0510465
	ИменаДокументов.Добавить("ИнвентаризационнаяОписьНФА"); // 0510466
	ИменаДокументов.Добавить("ИнвентаризационнаяОписьНаличныхСредств"); // 0510467
	ИменаДокументов.Добавить("ИнвентаризационнаяОписьРасчетовПоПоступлениям"); // 0510468
	ИменаДокументов.Добавить("ИнвентаризационнаяОписьРасчетовСКонтрагентами"); // 0510469
	ИменаДокументов.Добавить("ИнвентаризационнаяОписьЦенныхБумаг"); // 0510470
	ИменаДокументов.Добавить("ИнвентаризационнаяОписьКредитовИЗаймов"); // 0510471
	ИменаДокументов.Добавить("ИнвентаризационнаяОписьГосДолгаВЦенныхБумагах"); // 0510472
	ИменаДокументов.Добавить("ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам"); // 0510473
	ИменаДокументов.Добавить("ИнвентаризационнаяОписьГосДолгаПоПредоставленнымГарантиям"); // 0510474
	
	Возврат ИменаДокументов;
	
КонецФункции

&НаСервере
Функция НовыйКодыФормСозданиеПредусмотрено(СвойстваКодовФормСозданиеПредусмотрено)
	
	КодыФорм = Новый Массив();
	
	Для Каждого Элемент Из СвойстваКодовФормСозданиеПредусмотрено Цикл
		КодыФорм.Добавить(Элемент.Ключ);
	КонецЦикла;
	
	Возврат КодыФорм;
	
КонецФункции

&НаСервере
Функция ПолучитьИмяКолонкиДляБыстрогоПоиска(КодФормы)
	
	Возврат СтрШаблон("КолонкаБыстрогоПоиска%1", КодФормы);
	
КонецФункции

&НаСервере
Функция НовыйСостоянияИндикатораОписи()
	
	СостоянияИндикатораОписи = Новый Структура();
	
	СостоянияИндикатораОписи.Вставить("Ожидается",
		НовыйОписаниеСостоянияИндикатора(БиблиотекаКартинок.ЗолотойШар, 1));
	
	СостоянияИндикатораОписи.Вставить("НеПредусмотреноЗаконодательством",
		НовыйОписаниеСостоянияИндикатора(БиблиотекаКартинок.СостояниеПоступлениеНеОжидаетсяГосИС, 2));
	
	СостоянияИндикатораОписи.Вставить("НеПредусмотреноОбработкой",
		НовыйОписаниеСостоянияИндикатора(БиблиотекаКартинок.СостояниеПоступлениеНеОжидаетсяГосИС, 3));
		
	СостоянияИндикатораОписи.Вставить("ДокументСозданНеПроведен",
		НовыйОписаниеСостоянияИндикатора(БиблиотекаКартинок.СостояниеПоступилоЧастичноГосИС, 4));
	
	СостоянияИндикатораОписи.Вставить("ДокументСозданПроведен",
		НовыйОписаниеСостоянияИндикатора(БиблиотекаКартинок.СостояниеПоступилоГосИС, 5));
	
	Возврат СостоянияИндикатораОписи;
	
КонецФункции

&НаСервере
Функция НовыйСостоянияИндикатораОшибки()
	
	СостоянияИндикатораОшибки = Новый Структура();
	
	СостоянияИндикатораОшибки.Вставить("НеПредусмотреноЗаконодательством",
		НовыйОписаниеСостоянияИндикатора(БиблиотекаКартинок.ПризнакНаличияКритическойОшибки, 1));
		
	СостоянияИндикатораОшибки.Вставить("НеПредусмотреноОбработкой",
		НовыйОписаниеСостоянияИндикатора(БиблиотекаКартинок.ПризнакНаличияКритическойОшибки, 2));
		
	СостоянияИндикатораОшибки.Вставить("НесколькоДокументовОдногоВида",
		НовыйОписаниеСостоянияИндикатора(БиблиотекаКартинок.ПризнакНаличияКритическойОшибки, 3));
	
	СостоянияИндикатораОшибки.Вставить("НетПрав",
		НовыйОписаниеСостоянияИндикатора(БиблиотекаКартинок.ПризнакНаличияКритическойОшибки, 4));
		
	Возврат СостоянияИндикатораОшибки;
	
КонецФункции

&НаСервере
Функция НовыйОписаниеСостоянияИндикатора(Картинка, Код)
	
	ОписаниеСостоянияИндикатора = Новый Структура();
	ОписаниеСостоянияИндикатора.Вставить("Картинка", Картинка);
	ОписаниеСостоянияИндикатора.Вставить("Код", Код);
	
	Возврат ОписаниеСостоянияИндикатора;
	
КонецФункции

&НаСервере
Функция НовыйОписаниеОписи()
	
	ОписаниеОписи = Новый Структура();
	ОписаниеОписи.Вставить("Ссылка");
	ОписаниеОписи.Вставить("КодФормы", "");
	ОписаниеОписи.Вставить("НомерСистемный", "");
	ОписаниеОписи.Вставить("НомерДляПечати", "");
	ОписаниеОписи.Вставить("Дата", '00010101');
	ОписаниеОписи.Вставить("Проведен", Ложь);
	ОписаниеОписи.Вставить("ПометкаУдаления", Ложь);
	
	Возврат ОписаниеОписи;
	
КонецФункции

#КонецОбласти

#Область Обновить

&НаКлиенте
Процедура ОбновитьДанныеКлиент()
	
	ОбновитьДанныеСервер(Истина);
	
	НастроитьФормуПослеОбновления();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеСервер(ПрименитьФлажкиОтбораПоКодуФормы = Ложь)
	
	Если ПрименитьФлажкиОтбораПоКодуФормы Тогда
		ЗаполнитьОтборМассивКодовФормПоФлажкамНастроекОтбора();
	КонецЕсли;
	
	ПараметрыПоиска = ИнвентаризацияСервер.НовыйПараметрыПоискаДанныхДляГрупповогоФормированияОписей();
	
	ПараметрыПоиска.ИскатьОписиПоПриказу52н = ИскатьОписиПоПриказу52н;
	ПараметрыПоиска.ОтборМассивКодовФорм = ОтборМассивКодовФорм;
	
	ЗаполнитьФормуГрупповогоФормированияОписей(Решение, ПараметрыПоиска);
	
	Элементы.ГруппаНесопоставленныеОписи.Видимость = (ТаблицаНесопоставленныхОписей.Количество() > 0);
	
	ТребуетсяОбновлениеНастроено = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОтборМассивКодовФормПоФлажкамНастроекОтбора()
	
	ВремМассив = Новый Массив();
	
	Для Каждого КодФормы Из НовыйКодыФормПредусмотреныНастройкиОтбора52н() Цикл
		ИмяРеквизита = ПолучитьИмяРеквизитаОтбиратьПоКодуФормы(КодФормы);
		
		Если ЭтотОбъект[ИмяРеквизита] Тогда
			ВремМассив.Добавить(КодФормы);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого КодФормы Из НовыйКодыФормПредусмотреныНастройкиОтбора61н() Цикл
		ИмяРеквизита = ПолучитьИмяРеквизитаОтбиратьПоКодуФормы(КодФормы);
		
		Если ЭтотОбъект[ИмяРеквизита] Тогда
			ВремМассив.Добавить(КодФормы);
		КонецЕсли;
	КонецЦикла;
	
	ОтборМассивКодовФорм = Новый ФиксированныйМассив(ВремМассив);
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьФормуПослеОбновления()
	
	КоличествоСтрокТаблицыРешения = ТаблицаРешения.Количество();
	
	КоличествоСтрокТаблицыНесопоставленныхОписей = ТаблицаНесопоставленныхОписей.Количество();
	
	Если КоличествоСтрокТаблицыНесопоставленныхОписей > 0 Тогда
		Элементы.ГруппаНесопоставленныеОписи.Показать();
	КонецЕсли;
	
	УстановитьЗаголовокГруппыОбъединитьСтроки();
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьФормуТребуетсяОбновлениеИскатьОписиПоПриказу52()
	
	НастроитьФормуТребуетсяОбновление(НСтр("ru='Изменены настройки поиска описей'"));
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьФормуТребуетсяОбновлениеОтборПоКодуФормы()
	
	НастроитьФормуТребуетсяОбновление(НСтр("ru='Изменен отбор по коду формы'"));
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьФормуТребуетсяОбновление(ТекстНачалаЗаголовка)
	
	Если ТребуетсяОбновлениеНастроено Тогда
		Возврат;
	КонецЕсли;
	
	ТекстЗаголовка = СтрШаблон(
		НСтр("ru='%1, для заполнения по актуальным настройкам необходимо выполнить команду ""Обновить""'"),
		ТекстНачалаЗаголовка);
	
	ИменаЭлементов = Новый Массив();
	ИменаЭлементов.Добавить("НадписьНеобходимоОбновитьТаблицаРешения");
	ИменаЭлементов.Добавить("НадписьНеобходимоОбновитьТаблицаНесопоставленныеОписи");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементов, "Видимость", Истина);
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементов, "Заголовок", ТекстЗаголовка);
	
	ИменаЭлементов = Новый Массив();
	ИменаЭлементов.Добавить("ТаблицаРешения");
	ИменаЭлементов.Добавить("ТаблицаНесопоставленныхОписей");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементов, "ЦветФона", ЦветФонаНедоступнойТаблицы);
	
	ИменаЭлементов = Новый Массив();
	ИменаЭлементов.Добавить("ТаблицаРешенияОтметка");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементов, "ТолькоПросмотр", Истина);
	
	Для Каждого СтрокаТаблицы Из ТаблицаРешения Цикл
		СтрокаТаблицы.Отметка = Ложь;
	КонецЦикла;
	
	ТребуетсяОбновлениеНастроено = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеФормы

&НаСервере
Процедура ЗаполнитьФормуГрупповогоФормированияОписей(РешениеСсылка, ПараметрыПоиска)
	
	Данные = ИнвентаризацияСервер.ПолучитьДанныеДляГрупповогоФормированияОписей(РешениеСсылка, ПараметрыПоиска);
	
	ПризнакиРешения = Данные.ПризнакиРешения;
	
	УстановленОтборПоКодуФормы = (ПараметрыПоиска.ОтборМассивКодовФорм.Количество() > 0);
	
	СвойстваКодовФормСозданиеПредусмотрено = ПолучитьСвойстваКодовФормСозданиеПредусмотрено(
		Данные.ТаблицаНастроек, Данные.ДатаРешения);
	
	ПраваСоздания = ОпределитьПраваСоздания(Данные.РазличныеКодыФорм,
		СвойстваКодовФормСозданиеПредусмотрено, ПараметрыПоиска);
	
	ДопустимоФормироватьОписи = ДопустимоФормироватьОписи(ПризнакиРешения);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("СостоянияИндикатораОписи", НовыйСостоянияИндикатораОписи());
	ДополнительныеПараметры.Вставить("СостоянияИндикатораОшибки", НовыйСостоянияИндикатораОшибки());
	ДополнительныеПараметры.Вставить("СинонимыПолейРешения", ПолучитьСинонимыПолейРешения());
	ДополнительныеПараметры.Вставить("СтатистикаТаблицыВизуализацииРешения", Новый Структура());
	ДополнительныеПараметры.Вставить("ЕстьНастройкиОбъединенияСтрок", Новый Структура());
	ДополнительныеПараметры.Вставить("УстановленОтборПоКодуФормы", УстановленОтборПоКодуФормы);
	ДополнительныеПараметры.Вставить("СоответствиеТипОписиИмяДокумента", ПолучитьСоответствиеТипОписиИмяДокумента(Данные.ТаблицыОписей));
	
	ДополнительныеПараметры.Вставить("СвойстваКодовФормСозданиеПредусмотрено", СвойстваКодовФормСозданиеПредусмотрено);
	ДополнительныеПараметры.Вставить("ПраваСоздания", ПраваСоздания);
	ДополнительныеПараметры.Вставить("ДопустимоФормироватьОписи", ДопустимоФормироватьОписи);
	
	// Таблица Решения.
	
	ТаблицаВизуализацииРешения = СформироватьТаблицуВизуализацииРешения(
		РешениеСсылка, Данные, ДополнительныеПараметры, ПараметрыПоиска);
		
	ЗначениеВРеквизитФормы(ТаблицаВизуализацииРешения, "ТаблицаРешения");
	
	// Несопоставленные описи.
	
	ТаблицаВизуализацииНесопоставленныхОписей = СформироватьТаблицуВизуализацииНесопоставленныхОписей(
		Данные, ДополнительныеПараметры, ПараметрыПоиска);
	
	ЗначениеВРеквизитФормы(ТаблицаВизуализацииНесопоставленныхОписей, "ТаблицаНесопоставленныхОписей");
	
	// Прочие настройки формы.
	
	СброситьНадписиНеобходимоОбновить();
	
	НастроитьСведенияОПоследнемИзменении(ПризнакиРешения);
	
	НастроитьИндикаторыРешения(Данные, ДополнительныеПараметры, ПараметрыПоиска);
	
	НастроитьОбъединениеСтрок(ТаблицаВизуализацииРешения, ДополнительныеПараметры);
	
	НастроитьДоступностьФормированияОписей(ПризнакиРешения, ДополнительныеПараметры);
	
	НастроитьМенюОтбораСтрокТаблицыРешения(ДополнительныеПараметры);
	
	МассивКодовФормНетПрав = Новый ФиксированныйМассив(ДополнительныеПараметры.ПраваСоздания.КодыФормНетПрав);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСоответствиеТипОписиИмяДокумента(ТаблицыОписей)
	
	СоответствиеТипОписиИмяДокумента = Новый Соответствие();
	
	Для Каждого Элемент из ТаблицыОписей Цикл
		ИмяДокумента = Элемент.Ключ;
		
		ТипДокумента = Тип("ДокументСсылка." + ИмяДокумента);
		
		СоответствиеТипОписиИмяДокумента.Вставить(ТипДокумента, ИмяДокумента);
	КонецЦикла;
	
	Возврат СоответствиеТипОписиИмяДокумента;
	
КонецФункции

&НаСервере
Функция ОпределитьПраваСоздания(РазличныеКодыФорм,
		СвойстваКодовФормСозданиеПредусмотрено, ПараметрыПоиска)
	
	ОтборМассив = ПараметрыПоиска.ОтборМассивКодовФорм;
	
	ИменаДокументовСозданиеПредусмотрено = НовыйИменаДокументовСозданиеПредусмотрено();
	
	КодыФормСозданиеПредусмотрено = НовыйКодыФормСозданиеПредусмотрено(
		СвойстваКодовФормСозданиеПредусмотрено);
	
	ПроверяемыеКодыФорм = ОбщегоНазначенияИСКлиентСервер.ПересечениеМассивов(РазличныеКодыФорм, КодыФормСозданиеПредусмотрено);
	
	Если ОтборМассив.Количество() > 0 Тогда
		ПроверяемыеКодыФорм = ОбщегоНазначенияИСКлиентСервер.ПересечениеМассивов(ОтборМассив, ПроверяемыеКодыФорм);
	КонецЕсли;
	
	СписокНедоступныхДокументов = ПолучитьСписокДокументовНедоступныхДляСоздания(
		ПроверяемыеКодыФорм, СвойстваКодовФормСозданиеПредусмотрено);
	
	КодыФормНетПрав = Новый Массив();
	
	Для Каждого Элемент Из СписокНедоступныхДокументов Цикл
		КодФормы = Элемент.Представление;
		
		Если КодыФормНетПрав.Найти(КодФормы) = Неопределено Тогда
			КодыФормНетПрав.Добавить(КодФормы);
		КонецЕсли;
	КонецЦикла;
	
	ПраваСоздания = Новый Структура();
	ПраваСоздания.Вставить("КодыФормНетПрав", КодыФормНетПрав);
	ПраваСоздания.Вставить("СписокНедоступныхДокументов", СписокНедоступныхДокументов);
	
	Возврат ПраваСоздания;
	
КонецФункции

 #Область ТаблицаРешения

&НаСервере
Функция НовыйТаблицаВизуализацииРешения()
	
	ТипДата = ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата);
	ТипБулево = Новый ОписаниеТипов("Булево");
	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипЧисло4 = ОбщегоНазначения.ОписаниеТипаЧисло(4, 0, ДопустимыйЗнак.Неотрицательный);
	ТипЧисло6 = ОбщегоНазначения.ОписаниеТипаЧисло(6, 0, ДопустимыйЗнак.Неотрицательный);
	ТипЧислоИндексКартинки = ОбщегоНазначения.ОписаниеТипаЧисло(2, 0, ДопустимыйЗнак.Любой);
	ТипКартинка = Новый ОписаниеТипов("Картинка");
	ТипЧисло1 = ОбщегоНазначения.ОписаниеТипаЧисло(1, 0, ДопустимыйЗнак.Неотрицательный);
	
	ТаблицаВизуализации = Новый ТаблицаЗначений();
	
	// Сведения табличной части Объекты.
	ТаблицаВизуализации.Колонки.Добавить("НомерСтроки",							ТипЧисло6);
	ТаблицаВизуализации.Колонки.Добавить("КФО",									Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ТаблицаВизуализации.Колонки.Добавить("Счет",								Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаВизуализации.Колонки.Добавить("Сотрудник",							Новый ОписаниеТипов("СправочникСсылка.Сотрудники"));
	ТаблицаВизуализации.Колонки.Добавить("ДатаИнвентаризации",					ТипДата);
	ТаблицаВизуализации.Колонки.Добавить("ДатаНачала",							ТипДата);
	ТаблицаВизуализации.Колонки.Добавить("ДатаОкончания",						ТипДата);
	ТаблицаВизуализации.Колонки.Добавить("НомерКомиссии",						ТипЧисло4);
	ТаблицаВизуализации.Колонки.Добавить("НомерРабочейКомиссии",				ТипЧисло4);
	ТаблицаВизуализации.Колонки.Добавить("МестоИнвентаризации",					Новый ОписаниеТипов(Метаданные.ОпределяемыеТипы.МестоИнвентаризацииНФА.Тип));
	ТаблицаВизуализации.Колонки.Добавить("Примечание",							ТипСтрока);
	ТаблицаВизуализации.Колонки.Добавить("МассивКодовФорм",						Новый ОписаниеТипов("ФиксированныйМассив"));
	ТаблицаВизуализации.Колонки.Добавить("КодФормы",							ТипСтрока);
	
	// Списки кодов форм.
	ТаблицаВизуализации.Колонки.Добавить("МассивКодовФормСозданиеПредусмотрено",Новый ОписаниеТипов("ФиксированныйМассив"));
	ТаблицаВизуализации.Колонки.Добавить("КодФормыСозданиеПредусмотрено",		ТипСтрока);
	ТаблицаВизуализации.Колонки.Добавить("МассивКодовФормСозданиеНеобходимо",	Новый ОписаниеТипов("ФиксированныйМассив"));
	ТаблицаВизуализации.Колонки.Добавить("КодФормыСозданиеНеобходимо",			ТипСтрока);
	ТаблицаВизуализации.Колонки.Добавить("МассивКодовФормСозданиеВыбрано",		Новый ОписаниеТипов("ФиксированныйМассив"));
	ТаблицаВизуализации.Колонки.Добавить("КодФормыСозданиеВыбрано",				ТипСтрока);
	ТаблицаВизуализации.Колонки.Добавить("СписокВыбораИзмененВручную",			ТипБулево);
	
	ТаблицаВизуализации.Колонки.Добавить("Отметка",								ТипБулево);
	ТаблицаВизуализации.Колонки.Добавить("ОтметкаДоступна",						ТипБулево);
	
	// Блок сведений описи.
	ТаблицаВизуализации.Колонки.Добавить("ПредставлениеОписи",					ТипСтрока);
	ТаблицаВизуализации.Колонки.Добавить("ЕстьСопоставленныеОписи",				ТипБулево);
	ТаблицаВизуализации.Колонки.Добавить("КоличествоСопоставленныхОписей",		ТипЧисло4);
	ТаблицаВизуализации.Колонки.Добавить("МассивОписанийОписей",				Новый ОписаниеТипов("Массив"));
	ТаблицаВизуализации.Колонки.Добавить("ИндексКартинкиОписьПроведена",		ТипЧислоИндексКартинки);
	
	// Индикатор описи.
	ТаблицаВизуализации.Колонки.Добавить("КартинкаИндикатораОписи",				ТипКартинка);
	ТаблицаВизуализации.Колонки.Добавить("КодИндикатораОписи",					ТипЧисло1);
	ТаблицаВизуализации.Колонки.Добавить("КартинкаИндикатораОшибки",			ТипКартинка);
	ТаблицаВизуализации.Колонки.Добавить("КодИндикатораОшибки",					ТипЧисло1);
	ТаблицаВизуализации.Колонки.Добавить("ЕстьОшибка",							ТипБулево);
	
	Возврат ТаблицаВизуализации;
	
КонецФункции

&НаСервере
Функция СформироватьТаблицуВизуализацииРешения(РешениеСсылка,
		Данные, ДополнительныеПараметры, ПараметрыПоиска)
	
	КодыФормНетПрав = ДополнительныеПараметры.ПраваСоздания.КодыФормНетПрав;
	
	ИменаДокументовСозданиеПредусмотрено = НовыйИменаДокументовСозданиеПредусмотрено();
	
	КодыФормСозданиеПредусмотрено = НовыйКодыФормСозданиеПредусмотрено(
		ДополнительныеПараметры.СвойстваКодовФормСозданиеПредусмотрено);
	
	ДопустимоФормироватьОписи = ДополнительныеПараметры.ДопустимоФормироватьОписи;
	
	СостоянияИндикатораОписи = ДополнительныеПараметры.СостоянияИндикатораОписи;
	
	КодОжидается						= СостоянияИндикатораОписи.Ожидается.Код;
	КодДокументСозданПроведен			= СостоянияИндикатораОписи.ДокументСозданПроведен.Код;
	КодДокументСозданНеПроведен			= СостоянияИндикатораОписи.ДокументСозданНеПроведен.Код;
	КодНеПредусмотреноЗаконодательством	= СостоянияИндикатораОписи.НеПредусмотреноЗаконодательством.Код;
	КодНеПредусмотреноОбработкой		= СостоянияИндикатораОписи.НеПредусмотреноОбработкой.Код;
	
	ТаблицаВизуализацииРешения = НовыйТаблицаВизуализацииРешения();
	
	ЕстьОшибка = Ложь;
	ЕстьДоступнаяОтметка = Ложь;
	ЕстьСопоставленныеОписи = Ложь;
	ВсеСформированоПроведеноЛибоНеПредусмотрено = Истина;
	ВсеСформированоНеПроведеноЛибоНеПредусмотрено = Истина;
	
	КодыИндикатораОписи = Новый Соответствие();
	
	КодыФормНеСформированоПолностью = Новый Соответствие();
	
	Для Каждого СтрокаТаблицыОбъекты Из Данные.ТаблицаОбъекты Цикл
		НоваяСтрока = ТаблицаВизуализацииРешения.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицыОбъекты);
		
		ЗаполнитьБлокОписиВизуализацииРешения(НоваяСтрока, СтрокаТаблицыОбъекты, Данные, ДополнительныеПараметры);
		
		ЗаполнитьКолонкиКодовФорм(НоваяСтрока, КодыФормСозданиеПредусмотрено,
			ДополнительныеПараметры, КодыФормНетПрав, ПараметрыПоиска);
		
		ЗаполнитьКолонкиИндикатораОписиТаблицыВизуализацииРешения(НоваяСтрока, ДополнительныеПараметры,
			ДопустимоФормироватьОписи, КодыФормНетПрав, ИменаДокументовСозданиеПредусмотрено,
			КодыФормНеСформированоПолностью, ПараметрыПоиска);
		
		НоваяСтрока.ОтметкаДоступна = (НоваяСтрока.КодИндикатораОписи = КодОжидается);
		
		// Статистика таблицы.
		Если НоваяСтрока.ЕстьОшибка Тогда
			ЕстьОшибка = Истина;
		КонецЕсли;
		
		Если НоваяСтрока.ОтметкаДоступна Тогда
			ЕстьДоступнаяОтметка = Истина;
		КонецЕсли;
		
		Если НоваяСтрока.ЕстьСопоставленныеОписи Тогда
			ЕстьСопоставленныеОписи = Истина;
		КонецЕсли;
		
		Если НоваяСтрока.КодИндикатораОписи <> КодНеПредусмотреноЗаконодательством
			И НоваяСтрока.КодИндикатораОписи <> КодДокументСозданПроведен Тогда
			ВсеСформированоПроведеноЛибоНеПредусмотрено = Ложь;
		КонецЕсли;
		
		Если НоваяСтрока.КодИндикатораОписи <> КодНеПредусмотреноЗаконодательством
			И НоваяСтрока.КодИндикатораОписи <> КодДокументСозданНеПроведен Тогда
			ВсеСформированоНеПроведеноЛибоНеПредусмотрено = Ложь;
		КонецЕсли;
		
		КодыИндикатораОписи.Вставить(НоваяСтрока.КодИндикатораОписи, Истина);
	КонецЦикла;
	
	СтатистикаТаблицы = НовыйСтатистикаТаблицыВизуализацииРешения();
	СтатистикаТаблицы.ЕстьОшибка = ЕстьОшибка;
	СтатистикаТаблицы.ЕстьДоступнаяОтметка = ЕстьДоступнаяОтметка;
	СтатистикаТаблицы.ЕстьСопоставленныеОписи = ЕстьСопоставленныеОписи;
	СтатистикаТаблицы.ВсеСформированоПроведеноЛибоНеПредусмотрено = ВсеСформированоПроведеноЛибоНеПредусмотрено;
	СтатистикаТаблицы.ВсеСформированоНеПроведеноЛибоНеПредусмотрено = ВсеСформированоНеПроведеноЛибоНеПредусмотрено;
	СтатистикаТаблицы.КодыИндикатораОписи = КодыИндикатораОписи;
	СтатистикаТаблицы.КодыФормНеСформированоПолностью = КодыФормНеСформированоПолностью;
	
	ДополнительныеПараметры.СтатистикаТаблицыВизуализацииРешения = СтатистикаТаблицы;
	
	Если ВыводитьТолькоФормируемыеКодыФорм Тогда
		МассивЗначений = ТаблицаВизуализацииРешения.ВыгрузитьКолонку("КодФормыСозданиеПредусмотрено");
		
		ТаблицаВизуализацииРешения.ЗагрузитьКолонку(МассивЗначений, "КодФормы");
	КонецЕсли;
	
	Возврат ТаблицаВизуализацииРешения;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьБлокОписиВизуализацииРешения(НоваяСтрока, СтрокаТаблицыОбъекты, Данные, ДополнительныеПараметры)
	
	СопоставленныеОписи = СтрокаТаблицыОбъекты.СопоставленныеОписи;
	
	МассивОписанийОписей = Новый Массив();
	МассивТекстов = Новый Массив();
	
	Шаблон = НСтр("ru='%1 от %2'");
	
	КоличествоПроведенных = 0;
	
	Для Каждого СтрокаТаблицы Из СопоставленныеОписи Цикл
		СтрокаШапкиОписи = Данные.ТаблицыОписей[СтрокаТаблицы.ИмяДокумента].Шапки[СтрокаТаблицы.ИндексСтрокиТаблицыШапокОписей];
		
		ОписьСсылка = СтрокаШапкиОписи.Ссылка;
		
		НомерДляПечати = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ОписьСсылка, СтрокаШапкиОписи.Номер);
		
		ОписаниеОписи = НовыйОписаниеОписи();
		
		ЗаполнитьЗначенияСвойств(ОписаниеОписи, СтрокаШапкиОписи, "Ссылка,Дата,Проведен,ПометкаУдаления");
		ОписаниеОписи.НомерСистемный = СтрокаШапкиОписи.Номер;
		ОписаниеОписи.НомерДляПечати = НомерДляПечати;
		ОписаниеОписи.КодФормы = ИнвентаризацияСервер.ПолучитьКодФормыПоИмениДокумента(СтрокаТаблицы.ИмяДокумента, Данные.ТаблицаНастроек);
		
		МассивОписанийОписей.Добавить(ОписаниеОписи);
		
		ПредставлениеОписи = СтрШаблон(Шаблон, НомерДляПечати, Формат(СтрокаШапкиОписи.Дата, "ДФ=dd.MM.yyyy"));
		
		МассивТекстов.Добавить(ПредставлениеОписи);
		
		Если СтрокаШапкиОписи.Проведен Тогда
			КоличествоПроведенных = КоличествоПроведенных + 1;
		КонецЕсли;
	КонецЦикла;
	
	СтрокаТекстов = СтрСоединить(МассивТекстов, "; ");
	
	КоличествоОписей = СопоставленныеОписи.Количество();
	
	Если КоличествоОписей > 1 Тогда
		ПредставлениеОписи = СтрШаблон(НСтр("ru='(%1) %2'"), Формат(КоличествоОписей, "ЧГ=0"), СтрокаТекстов);
	Иначе
		ПредставлениеОписи = СтрокаТекстов;
	КонецЕсли;
	
	НоваяСтрока.ПредставлениеОписи = ПредставлениеОписи;
	НоваяСтрока.МассивОписанийОписей = МассивОписанийОписей;
	//НоваяСтрока.ОтличающиесяПоляШапки = Новый Структура();
	
	КоличествоОписей = МассивОписанийОписей.Количество();
	
	// Индексы картинок коллекции СостояниеДокументаИДвижений.
	Если МассивОписанийОписей.Количество() = 0 Тогда
		ИндексКартинкиОписьПроведена = -1;
		
	ИначеЕсли КоличествоПроведенных = 0 Тогда
		ИндексКартинкиОписьПроведена = 0; // не проведен.
		
	ИначеЕсли КоличествоПроведенных < КоличествоОписей Тогда
		ИндексКартинкиОписьПроведена = 11; // проведен серый.
	Иначе
		ИндексКартинкиОписьПроведена = 1; // проведен зеленый.
	КонецЕсли;
	
	НоваяСтрока.ИндексКартинкиОписьПроведена = ИндексКартинкиОписьПроведена;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКолонкиИндикатораОписиТаблицыВизуализацииРешения(НоваяСтрока, ДополнительныеПараметры,
		ДопустимоФормироватьОписи, КодыФормНетПрав, ИменаДокументовСозданиеПредусмотрено,
		КодыФормНеСформированоПолностью, ПараметрыПоиска)
	
	УстановленОтборПоКодуФормы = ДополнительныеПараметры.УстановленОтборПоКодуФормы;
	
	СостоянияИндикатораОписи	= ДополнительныеПараметры.СостоянияИндикатораОписи;
	СостоянияИндикатораОшибки	= ДополнительныеПараметры.СостоянияИндикатораОшибки;
	
	ПодсчетОписей = ПодсчитатьОписиВТекущейСтроке(НоваяСтрока, ИменаДокументовСозданиеПредусмотрено,
		ДополнительныеПараметры.СоответствиеТипОписиИмяДокумента);
	
	ЕстьДублиОписейПоКодуФормы = (ПодсчетОписей.ДублиПоКодуФормы.Количество() > 0);
	
	ДиагностикаВозможностиСоздания = ДиагностироватьВозможностьСозданияПоПравам(
		НоваяСтрока, КодыФормНетПрав, ПодсчетОписей, УстановленОтборПоКодуФормы, ПараметрыПоиска.ОтборМассивКодовФорм,
		КодыФормНеСформированоПолностью);
	
	ПредусмотреноЗаконодательством = (НоваяСтрока.МассивКодовФорм.Количество() > 0);
	СозданиеПредусмотрено = (НоваяСтрока.МассивКодовФормСозданиеПредусмотрено.Количество() > 0);
	
	// Индикатор "Состояние описи".
	
	СостояниеИндикатораОписи = Неопределено;
	
	Если Не ПредусмотреноЗаконодательством Тогда
		СостояниеИндикатораОписи = СостоянияИндикатораОписи.НеПредусмотреноЗаконодательством;
		
	ИначеЕсли Не СозданиеПредусмотрено Тогда
		СостояниеИндикатораОписи = СостоянияИндикатораОписи.НеПредусмотреноОбработкой;
		
	ИначеЕсли ДиагностикаВозможностиСоздания.ЕстьВозможный И ДопустимоФормироватьОписи Тогда
		СостояниеИндикатораОписи = СостоянияИндикатораОписи.Ожидается;
		
	ИначеЕсли ПодсчетОписей.КоличествоСозданиеПредусмотрено > 0 Тогда
		Если ПодсчетОписей.КоличествоСозданиеПредусмотрено = ПодсчетОписей.КоличествоСозданиеПредусмотреноПроведено Тогда
			СостояниеИндикатораОписи = СостоянияИндикатораОписи.ДокументСозданПроведен;
		Иначе
			СостояниеИндикатораОписи = СостоянияИндикатораОписи.ДокументСозданНеПроведен;
		КонецЕсли;
	КонецЕсли;
	
	Если СостояниеИндикатораОписи <> Неопределено Тогда
		НоваяСтрока.КодИндикатораОписи = СостояниеИндикатораОписи.Код;
		НоваяСтрока.КартинкаИндикатораОписи = СостояниеИндикатораОписи.Картинка;
	КонецЕсли;
	
	// Индикатор "Ошибка".
	
	СостояниеОшибкиИндикатораОписи = Неопределено;
	
	Если ЕстьДублиОписейПоКодуФормы Тогда
		СостояниеОшибкиИндикатораОписи = СостоянияИндикатораОшибки.НесколькоДокументовОдногоВида;
		
	ИначеЕсли Не ПредусмотреноЗаконодательством Тогда
		СостояниеОшибкиИндикатораОписи = СостоянияИндикатораОшибки.НеПредусмотреноЗаконодательством;
		
	ИначеЕсли Не СозданиеПредусмотрено Тогда
		СостояниеОшибкиИндикатораОписи = СостоянияИндикатораОшибки.НеПредусмотреноОбработкой;
		
	ИначеЕсли ДиагностикаВозможностиСоздания.ЕстьНевозможный Тогда
		СостояниеОшибкиИндикатораОписи = СостоянияИндикатораОшибки.НетПрав
	КонецЕсли;
	
	Если СостояниеОшибкиИндикатораОписи <> Неопределено Тогда
		НоваяСтрока.КодИндикатораОшибки = СостояниеОшибкиИндикатораОписи.Код;
		НоваяСтрока.КартинкаИндикатораОшибки = СостояниеОшибкиИндикатораОписи.Картинка;
		
		НоваяСтрока.ЕстьОшибка = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция НовыйСтатистикаТаблицыВизуализацииРешения()
	
	СтатистикаТаблицы = Новый Структура();
	СтатистикаТаблицы.Вставить("ЕстьОшибка", Ложь);
	СтатистикаТаблицы.Вставить("ЕстьДоступнаяОтметка", Ложь);
	СтатистикаТаблицы.Вставить("ЕстьСопоставленныеОписи", Ложь);
	СтатистикаТаблицы.Вставить("ВсеСформированоПроведеноЛибоНеПредусмотрено", Ложь);
	СтатистикаТаблицы.Вставить("ВсеСформированоНеПроведеноЛибоНеПредусмотрено", Ложь);
	СтатистикаТаблицы.Вставить("КодыИндикатораОписи", Новый Соответствие());
	СтатистикаТаблицы.Вставить("КодыФормНеСформированоПолностью", Новый Соответствие());
	
	Возврат СтатистикаТаблицы;
	
КонецФункции

&НаСервере
Функция ДопустимоФормироватьОписи(ПризнакиРешения)
	
	Возврат ПризнакиРешения.Проведен
		И Не ПризнакиРешения.ЕстьОшибкиПостроенияЦепочки
		И Не ПризнакиРешения.Аннулировано;
		
КонецФункции

&НаСервере
Процедура ЗаполнитьКолонкиКодовФорм(НоваяСтрока, КодыФормСозданиеПредусмотрено,
			ДополнительныеПараметры, КодыФормНетПрав, ПараметрыПоиска)
	
	УстановленОтборПоКодуФормы = ДополнительныеПараметры.УстановленОтборПоКодуФормы;
	
	МассивКодовФормСозданиеПредусмотрено = ОбщегоНазначенияИСКлиентСервер.ПересечениеМассивов(
		НоваяСтрока.МассивКодовФорм, КодыФормСозданиеПредусмотрено);
	
	КодыФормОписей = ПолучитьКодыФормОписей(НоваяСтрока.МассивОписанийОписей);
	
	МассивКодовФормСозданиеНеобходимо = ОбщегоНазначенияКлиентСервер.РазностьМассивов(
		МассивКодовФормСозданиеПредусмотрено, КодыФормОписей);
	
	Если УстановленОтборПоКодуФормы Тогда
		МассивКодовФормСозданиеНеобходимо = ОбщегоНазначенияИСКлиентСервер.ПересечениеМассивов(
			МассивКодовФормСозданиеНеобходимо, ПараметрыПоиска.ОтборМассивКодовФорм);
	КонецЕсли;
	
	МассивКодовФормСозданиеВыбрано = ОбщегоНазначенияКлиентСервер.РазностьМассивов(
		МассивКодовФормСозданиеНеобходимо, КодыФормНетПрав);
	
	НоваяСтрока.МассивКодовФормСозданиеПредусмотрено= Новый ФиксированныйМассив(МассивКодовФормСозданиеПредусмотрено);
	НоваяСтрока.МассивКодовФормСозданиеНеобходимо	= Новый ФиксированныйМассив(МассивКодовФормСозданиеНеобходимо);
	НоваяСтрока.МассивКодовФормСозданиеВыбрано		= Новый ФиксированныйМассив(МассивКодовФормСозданиеВыбрано);
	
	НоваяСтрока.КодФормыСозданиеПредусмотрено	= СтрСоединить(МассивКодовФормСозданиеПредусмотрено, ", ");
	НоваяСтрока.КодФормыСозданиеНеобходимо		= СтрСоединить(МассивКодовФормСозданиеНеобходимо, ", ");
	НоваяСтрока.КодФормыСозданиеВыбрано			= СтрСоединить(МассивКодовФормСозданиеВыбрано, ", ");
	
КонецПроцедуры

&НаСервере
Функция ПодсчитатьОписиВТекущейСтроке(НоваяСтрока, ИменаДокументовСозданиеПредусмотрено, СоответствиеТипОписиИмяДокумента)

	Количество = НоваяСтрока.МассивОписанийОписей;
	КоличествоСозданиеПредусмотрено = 0;
	КоличествоСозданиеПредусмотреноПроведено = 0;
	
	КодыФорм = Новый Массив();
	
	ДублиПоКодуФормы = Новый Соответствие();
	
	Для Каждого ОписаниеОписи Из НоваяСтрока.МассивОписанийОписей Цикл
		КодФормы = ОписаниеОписи.КодФормы;
		
		Если КодыФорм.Найти(КодФормы) = Неопределено Тогда
			КодыФорм.Добавить(КодФормы);
		Иначе
			ДублиПоКодуФормы.Вставить(КодФормы);
		КонецЕсли;
		
		ИмяДокумента = СоответствиеТипОписиИмяДокумента.Получить(ТипЗнч(ОписаниеОписи.Ссылка));
		
		СозданиеПредусмотрено = (ИменаДокументовСозданиеПредусмотрено.Найти(ИмяДокумента) <> Неопределено);
		
		Если СозданиеПредусмотрено Тогда
			КоличествоСозданиеПредусмотрено = КоличествоСозданиеПредусмотрено + 1;
			
			Если ОписаниеОписи.Проведен Тогда
				КоличествоСозданиеПредусмотреноПроведено = КоличествоСозданиеПредусмотреноПроведено + 1;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ПодсчетОписей = Новый Структура();
	ПодсчетОписей.Вставить("Количество", Количество);
	ПодсчетОписей.Вставить("КоличествоСозданиеПредусмотрено", КоличествоСозданиеПредусмотрено);
	ПодсчетОписей.Вставить("КоличествоСозданиеПредусмотреноПроведено", КоличествоСозданиеПредусмотреноПроведено);
	ПодсчетОписей.Вставить("КодыФорм", КодыФорм);
	ПодсчетОписей.Вставить("ДублиПоКодуФормы", ДублиПоКодуФормы);
	
	Возврат ПодсчетОписей;
	
КонецФункции

&НаСервере
Функция ПолучитьКодыФормОписей(МассивОписанийОписей)
	
	КодыФормОписей = Новый Массив();
	
	Для Каждого ОписаниеОписи Из МассивОписанийОписей Цикл
		КодФормы = ОписаниеОписи.КодФормы;
		
		Если КодыФормОписей.Найти(КодФормы) = Неопределено Тогда
			КодыФормОписей.Добавить(КодФормы);
		КонецЕсли;
	КонецЦикла;
	
	Возврат КодыФормОписей;
	
КонецФункции

&НаСервере
Функция ДиагностироватьВозможностьСозданияПоПравам(
	Знач НоваяСтрока, Знач КодыФормНетПрав, Знач ПодсчетОписей, Знач УстановленОтборПоКодуФормы, Знач ОтборМассивКодовФорм,
	КодыФормНеСформированоПолностью)
	
	// Не сформированные полностью по Решению в целом.
	Для Каждого КодФормы Из НоваяСтрока.МассивКодовФормСозданиеНеобходимо Цикл
		КодыФормНеСформированоПолностью.Вставить(КодФормы, Истина);
	КонецЦикла;
	
	СозданиеНеобходимоИВозможно = ОбщегоНазначенияКлиентСервер.РазностьМассивов(
		НоваяСтрока.МассивКодовФормСозданиеНеобходимо, КодыФормНетПрав);
	
	ЕстьСозданиеНеобходимоИВозможно = (СозданиеНеобходимоИВозможно.Количество() > 0);
	
	// Необходимые к созданию, но без прав создания.
	// Цель: исключить диагностику ошибки "Нет прав" если для такого кода формы уже создана опись.
	// Ведь новую опись формировать в таком случае уже не нужно,
	// и сообщение об отсутствии прав не принесет пользы и будет лишним.
	ОстатокНетПрав = ОбщегоНазначенияКлиентСервер.РазностьМассивов(КодыФормНетПрав, ПодсчетОписей.КодыФорм);
	
	СозданиеНеобходимоИНевозможно = ОбщегоНазначенияИСКлиентСервер.ПересечениеМассивов(
	 	НоваяСтрока.МассивКодовФормСозданиеНеобходимо, КодыФормНетПрав);
	
	ЕстьСозданиеНеобходимоИНевозможно = (СозданиеНеобходимоИНевозможно.Количество() > 0);
	
	РезультатДиагностики = Новый Структура();
	РезультатДиагностики.Вставить("ЕстьВозможный", ЕстьСозданиеНеобходимоИВозможно);
	РезультатДиагностики.Вставить("ЕстьНевозможный", ЕстьСозданиеНеобходимоИНевозможно);
	
	Возврат РезультатДиагностики;
	
КонецФункции

#КонецОбласти

#Область НесопоставленныеОписи

&НаСервере
Функция НовыйТаблицаВизуализацииНесопоставленныхОписей()
	
	ТипДата = ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата);
	ТипБулево = Новый ОписаниеТипов("Булево");
	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипЧисло4 = ОбщегоНазначения.ОписаниеТипаЧисло(4, 0, ДопустимыйЗнак.Неотрицательный);
	ТипЧисло6 = ОбщегоНазначения.ОписаниеТипаЧисло(6, 0, ДопустимыйЗнак.Неотрицательный);
	ТипЧислоИндексКартинки = ОбщегоНазначения.ОписаниеТипаЧисло(2, 0, ДопустимыйЗнак.Любой);
	ТипКартинка = Новый ОписаниеТипов("Картинка");
	ТипЧисло1 = ОбщегоНазначения.ОписаниеТипаЧисло(1, 0, ДопустимыйЗнак.Неотрицательный);
	
	ТаблицаВизуализации = Новый ТаблицаЗначений();
	
	МассивТиповКФО = Новый Массив();
	МассивТиповКФО.Добавить(Тип("ПеречислениеСсылка.КВД"));
	МассивТиповКФО.Добавить(Тип("Строка"));
	
	МассивТиповСчет = Новый Массив();
	МассивТиповСчет.Добавить(Тип("ПланСчетовСсылка.ЕПСБУ"));
	МассивТиповСчет.Добавить(Тип("Строка"));
	
	// Сведения табличной части Объекты.
	ТаблицаВизуализации.Колонки.Добавить("НомерСтроки",							ТипЧисло6);
	ТаблицаВизуализации.Колонки.Добавить("КФО",									Новый ОписаниеТипов(МассивТиповКФО));
	ТаблицаВизуализации.Колонки.Добавить("Счет",								Новый ОписаниеТипов(МассивТиповСчет));
	ТаблицаВизуализации.Колонки.Добавить("Сотрудник",							Новый ОписаниеТипов("СправочникСсылка.Сотрудники"));
	ТаблицаВизуализации.Колонки.Добавить("ДатаИнвентаризации",					ТипДата);
	ТаблицаВизуализации.Колонки.Добавить("ДатаНачала",							ТипДата);
	ТаблицаВизуализации.Колонки.Добавить("ДатаОкончания",						ТипДата);
	ТаблицаВизуализации.Колонки.Добавить("НомерКомиссии",						ТипЧисло4);
	ТаблицаВизуализации.Колонки.Добавить("НомерРабочейКомиссии",				ТипЧисло4);
	ТаблицаВизуализации.Колонки.Добавить("МестоИнвентаризации",					Новый ОписаниеТипов(Метаданные.ОпределяемыеТипы.МестоИнвентаризацииНФА.Тип));
	ТаблицаВизуализации.Колонки.Добавить("КодФормы",							ТипСтрока);
	ТаблицаВизуализации.Колонки.Добавить("МассивКодовФорм",						Новый ОписаниеТипов("ФиксированныйМассив"));
	ТаблицаВизуализации.Колонки.Добавить("Комментарий",							ТипСтрока);
	
	// Блок сведений описи.
	ТаблицаВизуализации.Колонки.Добавить("ПредставлениеОписи",					ТипСтрока);
	ТаблицаВизуализации.Колонки.Добавить("ОписьСсылка");
	ТаблицаВизуализации.Колонки.Добавить("ИндексКартинкиОписьПроведена",		ТипЧислоИндексКартинки);
	
	ТаблицаВизуализации.Колонки.Добавить("НеСопоставленныеПоляШапки",			Новый ОписаниеТипов("Соответствие"));
	ТаблицаВизуализации.Колонки.Добавить("НеСопоставленныеЗначенияИзТаблиц",	Новый ОписаниеТипов("Структура"));
	
	ТаблицаВизуализации.Колонки.Добавить("ВыделитьКолонкуКФО",					ТипБулево);
	ТаблицаВизуализации.Колонки.Добавить("ВыделитьКолонкуСчет",					ТипБулево);
	ТаблицаВизуализации.Колонки.Добавить("ВыделитьКолонкуСотрудник",			ТипБулево);
	ТаблицаВизуализации.Колонки.Добавить("ВыделитьКолонкуДатаИнвентаризации",	ТипБулево);
	ТаблицаВизуализации.Колонки.Добавить("ВыделитьКолонкуДатаНачала",			ТипБулево);
	ТаблицаВизуализации.Колонки.Добавить("ВыделитьКолонкуДатаОкончания",		ТипБулево);
