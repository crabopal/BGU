КонецФункции

&НаКлиенте
Функция ЕстьУстановленныйОтборПоКоду(КодыФорм)
	
	Для Каждого КодФормы Из КодыФорм Цикл
		ИмяРеквизита = ПолучитьИмяРеквизитаОтбиратьПоКодуФормы(КодФормы);
		
		Если ЭтотОбъект[ИмяРеквизита] Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Функция ПоказатьТекстовуюСтроку(ТекстоваяСтрока, Заголовок, СохранитьИзменения = Ложь, ИмяПоля = "")
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("СохранитьИзменения",	СохранитьИзменения);
	ДополнительныеПараметры.Вставить("ИмяПоля",				ИмяПоля);
	
	Оповещение = Новый ОписаниеОповещения("ПоказатьТекстовуюСтрокуВыбор", ЭтотОбъект, ДополнительныеПараметры);
	
	ПоказатьВводСтроки(Оповещение, ТекстоваяСтрока, Заголовок,, Истина);
	
КонецФункции

&НаКлиенте
Процедура ПоказатьТекстовуюСтрокуВыбор(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
        Возврат;
	КонецЕсли;
	
	Если Не ДополнительныеПараметры.СохранитьИзменения Тогда
		Возврат;
	КонецЕсли;
	
	ЭтотОбъект[ДополнительныеПараметры.ИмяПоля] = ВыбранноеЗначение;
	
КонецПроцедуры

