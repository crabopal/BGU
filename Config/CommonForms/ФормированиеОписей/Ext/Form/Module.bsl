	ТаблицаВизуализации.Колонки.Добавить("ВыделитьКолонкуКодФормы",				ТипБулево);
	
	Возврат ТаблицаВизуализации;
	
КонецФункции

&НаСервере
Функция СформироватьТаблицуВизуализацииНесопоставленныхОписей(Данные, ДополнительныеПараметры, ПараметрыЗаполнения)
	
	УстановленОтборПоКодуФормы = ДополнительныеПараметры.УстановленОтборПоКодуФормы;
	
	ТаблицаВизуализации = НовыйТаблицаВизуализацииНесопоставленныхОписей();
	
	Поиск = Новый Структура("ЕстьСопоставленныеСтрокиТаблицыОбъекты", Ложь);
	
	НомерСтроки = 0;
	
	Для Каждого Элемент Из Данные.ТаблицыОписей Цикл
		ИмяДокумента = Элемент.Ключ;
		ТаблицыВидаОписей = Элемент.Значение;
		
		СтрокаТаблицыНастроек = Данные.ТаблицаНастроек.Найти(ИмяДокумента, "ИмяДокумента");
		
		МассивСтрок = ТаблицыВидаОписей.Шапки.НайтиСтроки(Поиск);
		
		Для Каждого СтрокаШапкиОписи Из МассивСтрок Цикл
			КодФормы = ИнвентаризацияСервер.ПолучитьКодФормыПоИмениДокумента(ИмяДокумента, Данные.ТаблицаНастроек);
			
			Если УстановленОтборПоКодуФормы
				И ПараметрыЗаполнения.ОтборМассивКодовФорм.Найти(КодФормы) = Неопределено Тогда
				// Код формы такого документа описи не соответствует установленному отбору.
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ТаблицаВизуализации.Добавить();
			
			НомерСтроки = НомерСтроки + 1;
			
			НоваяСтрока.НомерСтроки = НомерСтроки;
			
			ИменаПолей = ?(СтрокаТаблицыНастроек.Приказ52н,
				ИнвентаризацияСервер.ПолучитьСтандартныйНаборПолейРешенияДляСопоставленияСШапкамиОписей52н(),
				ИнвентаризацияСервер.ПолучитьСтандартныйНаборПолейРешенияДляСопоставленияСШапкамиОписей61н());
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаШапкиОписи, ИменаПолей);
			
			ЗаполнитьПредставленияПолейАналитикиВСтрокеНесопоставленныхОписей(НоваяСтрока,
				ИмяДокумента, СтрокаШапкиОписи, ТаблицыВидаОписей, Данные.ТаблицаНастроек);
			
			ВремМассив = Новый Массив();
			ВремМассив.Добавить(КодФормы);
			
			НоваяСтрока.МассивКодовФорм = Новый ФиксированныйМассив(ВремМассив);
			НоваяСтрока.КодФормы = КодФормы;
			
			ЗаполнитьБлокОписиСтрокиНесопоставленныхОписей(НоваяСтрока,
				ИмяДокумента, СтрокаШапкиОписи, ТаблицыВидаОписей, Данные);
				
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаШапкиОписи, "НеСопоставленныеПоляШапки,НеСопоставленныеЗначенияИзТаблиц");
			
			ЗаполнитьКомментарийСтрокиНесопоставленныхОписей(
				НоваяСтрока, СтрокаШапкиОписи, Данные, ДополнительныеПараметры);
		КонецЦикла;
	КонецЦикла;
	
	Возврат ТаблицаВизуализации;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьКомментарийСтрокиНесопоставленныхОписей(НоваяСтрока, СтрокаШапкиОписи,
		Данные, ДополнительныеПараметры)
	
	Перем СписокСчетов, МестаИнвентаризации;
	
	ШаблонРеквизитыШапки = НСтр("ru='%1 %2 шапки описи %3 в строках Решения.'");
	ШаблонСтрокиТаблицы = НСтр("ru='%1 %2 описи %3 в строках Решения.'");
	
	ШаблонИмяКолонкиВыделить = "ВыделитьКолонку%1";
	
	// Код формы.
	Если Данные.РазличныеКодыФорм.Найти(НоваяСтрока.КодФормы) = Неопределено Тогда
		НоваяСтрока[СтрШаблон(ШаблонИмяКолонкиВыделить, "КодФормы")] = Истина;
		
		НоваяСтрока.Комментарий = СтрШаблон(НСтр("ru='Код формы %1 отсутствует в строках Решения.'"), НоваяСтрока.КодФормы);
		
		Возврат;
	КонецЕсли;
	
	МассивТекстов = Новый Массив();
	
	// Поля шапки.
	ИменаПолейШапки = Новый Массив();
	
	СинонимыПолейРешения = ДополнительныеПараметры.СинонимыПолейРешения;
	
	Для Каждого Элемент Из СтрокаШапкиОписи.НеСопоставленныеПоляШапки Цикл
		ИмяПоля = Элемент.Ключ;
		
		СинонимПоля = СинонимыПолейРешения.Получить(ИмяПоля);
		
		Если СинонимПоля = Неопределено Тогда
			СинонимПоля = ИмяПоля;
		КонецЕсли;
		
		ИменаПолейШапки.Добавить(СинонимПоля);
		
		НоваяСтрока[СтрШаблон(ШаблонИмяКолонкиВыделить, ИмяПоля)] = Истина;
	КонецЦикла;
	
	Количество = ИменаПолейШапки.Количество();
	
	Если Количество > 0 Тогда
		ТекстРеквизиты = ?(Количество = 1, НСтр("ru='Значение реквизита'"), НСтр("ru='Значения реквизитов'"));
		ТекстНеНайдены = ?(Количество = 1, НСтр("ru='не найдено'"), НСтр("ru='не найдены'"));
		
		Текст = СтрШаблон(ШаблонРеквизитыШапки,
			ТекстРеквизиты,
			СтрСоединить(ИменаПолейШапки, ", "),
			ТекстНеНайдены);
			
		МассивТекстов.Добавить(Текст);
	КонецЕсли;
	
	// Строки таблицы СписокСчетов.
	Если СтрокаШапкиОписи.НеСопоставленныеЗначенияИзТаблиц <> Неопределено
		И СтрокаШапкиОписи.НеСопоставленныеЗначенияИзТаблиц.Свойство("СписокСчетов", СписокСчетов) Тогда
		
		МассивПредставлений = Новый Массив();
		
		Для Каждого СтруктураСтроки Из СписокСчетов Цикл
			КФО = ?(ЗначениеЗаполнено(СтруктураСтроки.КФО), Строка(СтруктураСтроки.КФО), "0");
			Счет = Строка(СтруктураСтроки.Счет);
			
			МассивПредставлений.Добавить(СтрШаблон("%1.%2", КФО, Счет));
		КонецЦикла;
		
		Количество = СписокСчетов.Количество();
		
		ТекстСчета = ?(Количество = 1, НСтр("ru='Счет'"), НСтр("ru='Счета'"));
		ТекстНеНайдены = ?(Количество = 1, НСтр("ru='не найден'"), НСтр("ru='не найдены'"));
		
		Текст = СтрШаблон(ШаблонСтрокиТаблицы,
			ТекстСчета,
			СтрСоединить(МассивПредставлений, ", "),
			ТекстНеНайдены);
			
		МассивТекстов.Добавить(Текст);
		
		НоваяСтрока[СтрШаблон(ШаблонИмяКолонкиВыделить, "КФО")] = Истина;
		НоваяСтрока[СтрШаблон(ШаблонИмяКолонкиВыделить, "Счет")] = Истина;
	КонецЕсли;
	
	// Строки таблицы МестаИнвентаризации.
	Если СтрокаШапкиОписи.НеСопоставленныеЗначенияИзТаблиц <> Неопределено
		И СтрокаШапкиОписи.НеСопоставленныеЗначенияИзТаблиц.Свойство("МестаИнвентаризации", МестаИнвентаризации) Тогда
		
		МассивПредставлений = Новый Массив();
		
		Для Каждого МестоИнвентаризации Из МестаИнвентаризации Цикл
			МассивПредставлений.Добавить(Строка(МестоИнвентаризации));
		КонецЦикла;
		
		Количество = МестаИнвентаризации.Количество();
		
		ТекстМестаИнвентаризации = ?(Количество = 1, НСтр("ru='Место инвентаризации'"), НСтр("ru='Места инвентаризации'"));
		ТекстНеНайдены = ?(Количество = 1, НСтр("ru='не найдено'"), НСтр("ru='не найдены'"));
		
		Текст = СтрШаблон(ШаблонСтрокиТаблицы,
			ТекстМестаИнвентаризации,
			СтрСоединить(МассивПредставлений, ", "),
			ТекстНеНайдены);
			
		МассивТекстов.Добавить(Текст);
		
		НоваяСтрока[СтрШаблон(ШаблонИмяКолонкиВыделить, "МестоИнвентаризации")] = Истина;
	КонецЕсли;
	
	Если МассивТекстов.Количество() > 0 Тогда
		Комментарий = СтрСоединить(МассивТекстов, Символы.ПС + Символы.ПС);
	Иначе
		Комментарий = НСтр("ru='Сочетание значений реквизитов шапки описи не найдено в строках Решения'");
	КонецЕсли;
	
	НоваяСтрока.Комментарий = Комментарий;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСинонимыПолейРешения()
	
	СинонимыПолейРешения = Новый Соответствие();
	СинонимыПолейРешения.Вставить("ДатаИнвентаризации",		НСтр("ru='Дата инвентаризации'"));
	СинонимыПолейРешения.Вставить("ДатаНачала",				НСтр("ru='Дата начала инвентаризации'"));
	СинонимыПолейРешения.Вставить("ДатаОкончания",			НСтр("ru='Дата окончания инвентаризации'"));
	СинонимыПолейРешения.Вставить("МестоИнвентаризации",	НСтр("ru='Место инвентаризации'"));
	СинонимыПолейРешения.Вставить("НомерКомиссии",			НСтр("ru='Номер комиссии'"));
	СинонимыПолейРешения.Вставить("НомерРабочейКомиссии",	НСтр("ru='Номер рабочей комиссии'"));
	
	Возврат СинонимыПолейРешения;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьПредставленияПолейАналитикиВСтрокеНесопоставленныхОписей(НоваяСтрока,
		ИмяДокумента, СтрокаШапкиОписи, ТаблицыВидаОписей, ТаблицаНастроек)
	
	Поиск = Новый Структура("ИмяДокумента", ИмяДокумента);
	
	СтрокаТаблицыНастроек = ТаблицаНастроек.НайтиСтроки(Поиск)[0];
	
	РасположениеРеквизитов = ИнвентаризацияСервер.ПолучитьОписаниеРасположенияРеквизитовОписи(СтрокаТаблицыНастроек);
	
	ОписьСсылка = СтрокаШапкиОписи.Ссылка;
	
	// КФО.
	РасположениеРеквизита = РасположениеРеквизитов.КФО;
	Если РасположениеРеквизита.РасположенВШапке Тогда
		ПредставлениеКФО = Строка(СтрокаШапкиОписи[РасположениеРеквизита.ИмяПоля]);
	ИначеЕсли РасположениеРеквизита.РасположенВТабличнойЧасти Тогда
		ПредставлениеКФО = СформироватьПредставлениеКолонкиТабличнойЧасти(
			РасположениеРеквизита, ОписьСсылка, ТаблицыВидаОписей);
	КонецЕсли;
	
	// Счет.
	РасположениеРеквизита = РасположениеРеквизитов.Счет;
	Если РасположениеРеквизита.РасположенВШапке Тогда
		ПредставлениеСчета = Строка(СтрокаШапкиОписи[РасположениеРеквизита.ИмяПоля]);
	ИначеЕсли РасположениеРеквизита.РасположенВТабличнойЧасти Тогда
		ПредставлениеСчета = СформироватьПредставлениеКолонкиТабличнойЧасти(
			РасположениеРеквизита, ОписьСсылка, ТаблицыВидаОписей);
	КонецЕсли;
	
	// Сотрудник.
	РасположениеРеквизита = РасположениеРеквизитов.Сотрудник;
	Если РасположениеРеквизита.Отсутствует Тогда
		Сотрудник = Справочники.Сотрудники.ПустаяСсылка();
	Иначе
		Сотрудник = СтрокаШапкиОписи[РасположениеРеквизита.ИмяПоля];
	КонецЕсли;
	
	// МестоИнвентаризации.
	РасположениеРеквизита = РасположениеРеквизитов.МестоИнвентаризации;
	Если РасположениеРеквизита.РасположенВШапке Тогда
		ПредставлениеМестаИнвентаризации = Строка(СтрокаШапкиОписи[РасположениеРеквизита.ИмяПоля]);
	ИначеЕсли РасположениеРеквизита.РасположенВТабличнойЧасти Тогда
		ПредставлениеМестаИнвентаризации = СформироватьПредставлениеКолонкиТабличнойЧасти(
			РасположениеРеквизита, ОписьСсылка, ТаблицыВидаОписей);
	КонецЕсли;
	
	НоваяСтрока.КФО = ПредставлениеКФО;
	НоваяСтрока.Счет = ПредставлениеСчета;
	НоваяСтрока.Сотрудник = Сотрудник;
	НоваяСтрока.МестоИнвентаризации = ПредставлениеМестаИнвентаризации;
	
КонецПроцедуры

&НаСервере
Функция СформироватьПредставлениеКолонкиТабличнойЧасти(РасположениеРеквизита, ОписьСсылка, ТаблицыВидаОписей)
	
	Таблица = ТаблицыВидаОписей[РасположениеРеквизита.ИмяТабличнойЧасти];
	
	ИмяКолонки = РасположениеРеквизита.ИмяКолонки;
	
	Поиск = Новый Структура("Ссылка", ОписьСсылка);
	
	ВремТаблица = Таблица.Скопировать(Поиск, ИмяКолонки);
	ВремТаблица.Свернуть(ИмяКолонки);
	
	// Представление КФО0.
	Если ИмяКолонки = "КФО" Тогда
		Поиск = Новый Структура("КФО", Перечисления.КВД.ПустаяСсылка());
		
		МассивСтрок = ВремТаблица.НайтиСтроки(Поиск);
		
		Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
			СтрокаТаблицы.КФО = "0";
		КонецЦикла;
	КонецЕсли;
	
	МассивЗначений = ВремТаблица.ВыгрузитьКолонку(ИмяКолонки);
	
	Возврат СтрСоединить(МассивЗначений, ", ");
	
КонецФункции

&НаСервере
Процедура ЗаполнитьБлокОписиСтрокиНесопоставленныхОписей(НоваяСтрока,
		ИмяДокумента, СтрокаШапкиОписи, ТаблицыВидаОписей, Данные)
	
	Шаблон = НСтр("ru='%1 от %2'");
	
	ОписьСсылка = СтрокаШапкиОписи.Ссылка;
	
	НомерДляПечати = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ОписьСсылка, СтрокаШапкиОписи.Номер);
	
	ПредставлениеОписи = СтрШаблон(Шаблон, НомерДляПечати, Формат(СтрокаШапкиОписи.Дата, "ДФ=dd.MM.yyyy"));
	
	НоваяСтрока.ПредставлениеОписи = ПредставлениеОписи;
	НоваяСтрока.ОписьСсылка = ОписьСсылка;
	
	// Индексы картинок коллекции СостояниеДокументаИДвижений.
	Если СтрокаШапкиОписи.Проведен Тогда
		ИндексКартинкиОписьПроведена = 1; // проведен зеленый.
	Иначе
		ИндексКартинкиОписьПроведена = 0; // не проведен.
	КонецЕсли;
	
	НоваяСтрока.ИндексКартинкиОписьПроведена = ИндексКартинкиОписьПроведена;
	
КонецПроцедуры

#КонецОбласти


#Область НастройкаФормыПослеЗаполнения

&НаСервере
Процедура СброситьНадписиНеобходимоОбновить()
	
	ИменаЭлементов = Новый Массив();
	ИменаЭлементов.Добавить("НадписьНеобходимоОбновитьТаблицаРешения");
	ИменаЭлементов.Добавить("НадписьНеобходимоОбновитьТаблицаНесопоставленныеОписи");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементов, "Видимость", Ложь);
	
	ИменаЭлементов = Новый Массив();
	ИменаЭлементов.Добавить("ТаблицаРешения");
	ИменаЭлементов.Добавить("ТаблицаНесопоставленныхОписей");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементов, "ЦветФона", Новый Цвет());
	
КонецПроцедуры

&НаСервере
Процедура НастроитьСведенияОПоследнемИзменении(ПризнакиРешения)
	
	КоличествоИзменений = ПризнакиРешения.КоличествоИзменений;
	
	ТекстНомерИзменения = Формат(КоличествоИзменений, "ЧГ=0;ЧН=0");
	
	ТекстТипИзменения = ?(ПризнакиРешения.Аннулировано,
		НСтр("ru='аннулирующее'"),
		НСтр("ru='корректирующее'"));
	
	ПредставлениеНомераИзменения = СтрШаблон(НСтр("ru='%1, %2'"), ТекстНомерИзменения, ТекстТипИзменения);
	
	ПоследнееИзменение			= ПризнакиРешения.ПоследнееИзменение;
	ПредставлениеНомераИзменения	= ПредставлениеНомераИзменения;
	
	Элементы.ПредставлениеНомераИзменения.Видимость = (КоличествоИзменений > 0);
	
КонецПроцедуры

&НаСервере
Процедура НастроитьОбъединениеСтрок(ТаблицаВизуализацииРешения, ДополнительныеПараметры)
	
	НастройкиОбъединенияСтрокНаФорме = НовыйНастройкиОбъединенияСтрокНаФорме();
	
	КодыФормСДоступнойОтметкой = ПолучитьКодыФормСДоступнойОтметкой(ТаблицаВизуализацииРешения);
	
	НастроитьВидимостьНастроекОбъединенияСтрок(НастройкиОбъединенияСтрокНаФорме,
		КодыФормСДоступнойОтметкой, ДополнительныеПараметры);
	
	УстановитьЗначенияНастроекОбъединенияСтрок(НастройкиОбъединенияСтрокНаФорме,
		КодыФормСДоступнойОтметкой);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьКодыФормСДоступнойОтметкой(ТаблицаВизуализацииРешения)
	
	УникальныеЗначения = Новый Соответствие();
	
	Для Каждого СтрокаТаблицы Из ТаблицаВизуализацииРешения Цикл
		Для Каждого КодФормы Из СтрокаТаблицы.МассивКодовФорм Цикл
			Если СтрокаТаблицы.ОтметкаДоступна Тогда
				УникальныеЗначения.Вставить(КодФормы, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ВремСписок = Новый СписокЗначений();
	
	Для Каждого Элемент Из УникальныеЗначения Цикл
		ВремСписок.Добавить(Элемент.Ключ);
	КонецЦикла;
	
	ВремСписок.СортироватьПоЗначению();
	
	Возврат ВремСписок.ВыгрузитьЗначения();
	
КонецФункции

&НаСервере
Процедура НастроитьВидимостьНастроекОбъединенияСтрок(НастройкиОбъединенияСтрокНаФорме,
		КодыФормСДоступнойОтметкой, ДополнительныеПараметры)
	
	// Если некоторый код формы отсутствует в строках Решения, то скрываем его настройки объединения строк.
	
	КоличествоСкрытыхНастроекСчет = 0;
	КоличествоСкрытыхНастроекМестоИнвентаризации = 0;
	
	Для Каждого КодФормы Из НастройкиОбъединенияСтрокНаФорме.ОбщийСписокКодовФорм Цикл
		ИмяФлажкаСчет = ПолучитьИмяФлажкаНастройкиОбъединенияПоСчетам(КодФормы);
		ИмяФлажкаМестоИнвентаризации = ПолучитьИмяФлажкаНастройкиОбъединенияПоМестамИнвентаризации(КодФормы);
		
		ИменаЭлементов = Новый Массив();
		ИменаЭлементов.Добавить(СтрШаблон("ДекорацияОбъединитьСтроки%1", КодФормы));
		ИменаЭлементов.Добавить(ИмяФлажкаСчет);
		ИменаЭлементов.Добавить(ИмяФлажкаМестоИнвентаризации);
		
		ОписьДоступнаКОтметкеВРешении = (КодыФормСДоступнойОтметкой.Найти(КодФормы) <> Неопределено);
		
		ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементов,
			"Видимость", ОписьДоступнаКОтметкеВРешении);
		
		Если Не ОписьДоступнаКОтметкеВРешении И НастройкиОбъединенияСтрокНаФорме.ПоСчетам.Найти(КодФормы) <> Неопределено Тогда
			КоличествоСкрытыхНастроекСчет = КоличествоСкрытыхНастроекСчет + 1;
		КонецЕсли;
		
		Если Не ОписьДоступнаКОтметкеВРешении И НастройкиОбъединенияСтрокНаФорме.ПоМестамИнвентаризации.Найти(КодФормы) <> Неопределено Тогда
			КоличествоСкрытыхНастроекМестоИнвентаризации = КоличествоСкрытыхНастроекМестоИнвентаризации + 1;
		КонецЕсли;
	КонецЦикла;
	
	// Видимость настроек в целом.
	ЕстьНастройкиПоСчетам =
		(НастройкиОбъединенияСтрокНаФорме.ПоСчетам.Количество() > КоличествоСкрытыхНастроекСчет);
	
	ЕстьНастройкиПоМестамИнвентаризации =
		(НастройкиОбъединенияСтрокНаФорме.ПоМестамИнвентаризации.Количество() > КоличествоСкрытыхНастроекМестоИнвентаризации);
	
	ЕстьНастройкиОбъединенияСтрок = ЕстьНастройкиПоСчетам Или ЕстьНастройкиПоМестамИнвентаризации;
	
	ДополнительныеПараметры.ЕстьНастройкиОбъединенияСтрок = ЕстьНастройкиОбъединенияСтрок;
	
	Элементы.ДекорацияНеПредусмотреноОбъединениеСтрок.Видимость = Не ЕстьНастройкиОбъединенияСтрок;
	
	Элементы.ГруппаОбъединитьСтрокиКоманднаяПанель.Видимость = ЕстьНастройкиОбъединенияСтрок;
	Элементы.ГруппаОбъединитьСтрокиКолонкаНадписи.Видимость = ЕстьНастройкиОбъединенияСтрок;
	
	Элементы.ГруппаОбъединитьСтрокиКолонкаСчета.Видимость = ЕстьНастройкиПоСчетам;
	Элементы.ГруппаОбъединитьСтрокиКолонкаМестаИнвентаризации.Видимость = ЕстьНастройкиПоМестамИнвентаризации;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗначенияНастроекОбъединенияСтрок(НастройкиОбъединенияСтрокНаФорме,
		КодыФормСДоступнойОтметкой)
	
	// Если некоторый код формы есть в строках Решения, то устанавливаем его флажки значениями по умолчанию.
	// Если некоторый код формы отсутствует в строках Решения, то сбрасываем все его флажки.
	
	НастройкиОбъединенияСтрокПоУмолчанию = НастройкиОбъединенияСтрокПоУмолчанию;
	
	ЗначенияРеквизитов = Новый Структура();
	
	Для Каждого КодФормы Из НастройкиОбъединенияСтрокНаФорме.ОбщийСписокКодовФорм Цикл
		ОписьДоступнаКОтметкеВРешении = (КодыФормСДоступнойОтметкой.Найти(КодФормы) <> Неопределено);
		
		ИмяФлажкаСчет = ПолучитьИмяФлажкаНастройкиОбъединенияПоСчетам(КодФормы);
		ИмяФлажкаМестоИнвентаризации = ПолучитьИмяФлажкаНастройкиОбъединенияПоМестамИнвентаризации(КодФормы);
		
		ЕстьФлажокСчет = НастройкиОбъединенияСтрокПоУмолчанию.Свойство(ИмяФлажкаСчет);
		ЕстьФлажокМестоИнвентаризации = НастройкиОбъединенияСтрокПоУмолчанию.Свойство(ИмяФлажкаМестоИнвентаризации);
		
		Если ЕстьФлажокСчет Тогда
			ЗначениеФлажка = ОписьДоступнаКОтметкеВРешении И НастройкиОбъединенияСтрокПоУмолчанию[ИмяФлажкаСчет];
			
			ЗначенияРеквизитов.Вставить(ИмяФлажкаСчет,ЗначениеФлажка);
		КонецЕсли;
		
		Если ЕстьФлажокМестоИнвентаризации Тогда
			ЗначениеФлажка = ОписьДоступнаКОтметкеВРешении И НастройкиОбъединенияСтрокПоУмолчанию[ИмяФлажкаМестоИнвентаризации];
			
			ЗначенияРеквизитов.Вставить(ИмяФлажкаМестоИнвентаризации, ЗначениеФлажка);
		КонецЕсли;
	КонецЦикла;
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ЗначенияРеквизитов);
	
КонецПроцедуры

&НаСервере
Процедура НастроитьДоступностьФормированияОписей(ПризнакиРешения, ДополнительныеПараметры)
	
	ДопустимоФормироватьОписи = ДопустимоФормироватьОписи(ПризнакиРешения);
	
	Элементы.ТаблицаРешенияОтметка.ТолькоПросмотр = Не ДопустимоФормироватьОписи;
	
	ИменаЭлементов = Новый Массив();
	ИменаЭлементов.Добавить("ТаблицаРешенияГруппаНастроитьОтметки");
	ИменаЭлементов.Добавить("СформироватьОписи");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементов,
		"Доступность", ДопустимоФормироватьОписи);
	
	Элементы.ТаблицаРешения.ЦветФона = ?(ДопустимоФормироватьОписи,
		Новый Цвет(),
		ПолучитьЦветФонаНедоступнойТаблицы());
		
	ТекстНадписиНеопределено = "";
	
	ВидимостьНадписиНеопределено = Ложь;
	
	Если ПризнакиРешения.ЕстьОшибкиПостроенияЦепочки Тогда
		ВидимостьНадписиНеопределено = Истина;
		ТекстНадписиНеопределено = НСтр("ru='Содержимое Решения не может быть определено при наличии ошибок построения цепочки документов'");

	ИначеЕсли ПризнакиРешения.ПометкаУдаления Тогда
		ВидимостьНадписиНеопределено = Истина;
		ТекстНадписиНеопределено = НСтр("ru='Содержимое Решения не может быть определено для помеченного на удаление документа'");
	КонецЕсли;
	
	ЭлементНадписи = Элементы.НадписьСодержимоеРешенияНеопределено;
	
	ЭлементНадписи.Видимость = ВидимостьНадписиНеопределено;
	ЭлементНадписи.Заголовок = ТекстНадписиНеопределено;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьМенюОтбораСтрокТаблицыРешения(ДополнительныеПараметры)
	
	СтатистикаТаблицыВизуализацииРешения = ДополнительныеПараметры.СтатистикаТаблицыВизуализацииРешения;
	
	КодыИндикатораОписи		= СтатистикаТаблицыВизуализацииРешения.КодыИндикатораОписи;
	ЕстьОшибка				= СтатистикаТаблицыВизуализацииРешения.ЕстьОшибка;
	ЕстьСопоставленныеОписи	= СтатистикаТаблицыВизуализацииРешения.ЕстьСопоставленныеОписи;
	
	СостоянияИндикатораОписи = ДополнительныеПараметры.СостоянияИндикатораОписи;
	
	КодОжидается						= СостоянияИндикатораОписи.Ожидается.Код;
	КодДокументСозданПроведен			= СостоянияИндикатораОписи.ДокументСозданПроведен.Код;
	КодДокументСозданНеПроведен			= СостоянияИндикатораОписи.ДокументСозданНеПроведен.Код;
	КодНеПредусмотреноЗаконодательством	= СостоянияИндикатораОписи.НеПредусмотреноЗаконодательством.Код;
	КодНеПредусмотреноОбработкой		= СостоянияИндикатораОписи.НеПредусмотреноОбработкой.Код;
	
	ВидимостьКнопок = Новый Структура();
	ВидимостьКнопок.Вставить("ПоказатьОшибки", Ложь);
	ВидимостьКнопок.Вставить("ПоказатьОжидается", Ложь);
	ВидимостьКнопок.Вставить("ПоказатьСозданПроведен", Ложь);
	ВидимостьКнопок.Вставить("ПоказатьСозданНеПроведен", Ложь);
	ВидимостьКнопок.Вставить("ПоказатьСозданЛюбой", Ложь);
	ВидимостьКнопок.Вставить("ПоказатьНеПредусмотреноЗаконодательством", Ложь);
	ВидимостьКнопок.Вставить("ПоказатьНеПредусмотреноОбработкой", Ложь);
	
	КоличествоВидимых = 0;
	
	Если ЕстьСопоставленныеОписи Тогда
		ВидимостьКнопок.ПоказатьСозданЛюбой = Истина;
		КоличествоВидимых = КоличествоВидимых + 1;
	КонецЕсли;
	
	Для Каждого Элемент Из КодыИндикатораОписи Цикл
		КодИндикатора = Элемент.Ключ;
		
		Если КодИндикатора = КодОжидается Тогда
			ВидимостьКнопок.ПоказатьОжидается = Истина;
			КоличествоВидимых = КоличествоВидимых + 1;
			
		ИначеЕсли КодИндикатора = КодДокументСозданПроведен Тогда
			ВидимостьКнопок.ПоказатьСозданПроведен = Истина;
			КоличествоВидимых = КоличествоВидимых + 1;
			
		ИначеЕсли КодИндикатора = КодДокументСозданНеПроведен Тогда
			ВидимостьКнопок.ПоказатьСозданНеПроведен = Истина;
			КоличествоВидимых = КоличествоВидимых + 1;
			
		ИначеЕсли КодИндикатора = КодНеПредусмотреноЗаконодательством Тогда
			ВидимостьКнопок.ПоказатьНеПредусмотреноЗаконодательством = Истина;
			КоличествоВидимых = КоличествоВидимых + 1;
			
		ИначеЕсли КодИндикатора = КодНеПредусмотреноОбработкой Тогда
			ВидимостьКнопок.ПоказатьНеПредусмотреноОбработкой = Истина;
			КоличествоВидимых = КоличествоВидимых + 1;
		КонецЕсли;
	КонецЦикла;
	
	Если ЕстьОшибка Тогда
		ВидимостьКнопок.ПоказатьОшибки = Истина;
		КоличествоВидимых = КоличествоВидимых + 1;
	КонецЕсли;
	
	Для Каждого Элемент Из ВидимостьКнопок Цикл
		ИмяКнопки = Элемент.Ключ;
		ВидимостьКнопки = Элемент.Значение;
		
		ЭлементКнопки = Элементы["ТаблицаРешения" + ИмяКнопки];
		
		ЭлементКнопки.Видимость = ВидимостьКнопки;
		ЭлементКнопки.Пометка = Ложь;
	КонецЦикла;
	
	Элементы.ТаблицаРешения.ОтборСтрок = Неопределено;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьИндикаторыРешения(Данные, ДополнительныеПараметры, ПараметрыПоиска)
	
	ВидимостьИндикаторов = Новый Структура();
	ВидимостьИндикаторов.Вставить("ОшибкиЦепочки", Ложь);
	ВидимостьИндикаторов.Вставить("Предупреждение", Ложь);
	ВидимостьИндикаторов.Вставить("НетПрав", Ложь);
	ВидимостьИндикаторов.Вставить("Отбор", Ложь);
	ВидимостьИндикаторов.Вставить("ОписиСформированы", Ложь);
	
	// Индикатор "Ошибки цепочки".
	НастроитьИндикаторОшибкиЦепочки(Данные, ДополнительныеПараметры, ВидимостьИндикаторов);
	
	// Индикатор "Предупреждение".
	НастроитьИндикаторПредупреждение(Данные, ДополнительныеПараметры, ВидимостьИндикаторов);
		
	// Индикатор "Нет прав".
	НастроитьИндикаторНетПрав(Данные, ДополнительныеПараметры, ВидимостьИндикаторов);
	
	// Индикатор "Отбор".
	НастроитьИндикаторОтбор(Данные, ДополнительныеПараметры, ПараметрыПоиска, ВидимостьИндикаторов);
	
	// Индикатор "Описи сформированы".
	НастроитьИндикаторОписиСформированы(Данные, ДополнительныеПараметры, ВидимостьИндикаторов);
		
КонецПроцедуры

&НаСервере
Процедура НастроитьИндикаторОшибкиЦепочки(Знач Данные, Знач ДополнительныеПараметры, ВидимостьИндикаторов)
	
	ПризнакиРешения	= Данные.ПризнакиРешения;
	
	ВидимостьИндикатора = ПризнакиРешения.ЕстьОшибкиПостроенияЦепочки;
	
	АдресХранилищаОшибкиЦепочки = "";
	
	Если ВидимостьИндикатора Тогда
		ГруппироватьПоРешению = Ложь;
		
		ТабДокумент = ИнвентаризацияСервер.ЗаполнитьТабличныйДокументСпискаОшибок(ПризнакиРешения.ТаблицаОшибок, ГруппироватьПоРешению);
		
		АдресХранилищаОшибкиЦепочки = ПоместитьВоВременноеХранилище(ТабДокумент, УникальныйИдентификатор);
	КонецЕсли;
	
	ПризнакиРешения.ТаблицаОшибок = Неопределено; // Это значение более не требуется, и к том же не может быть передано на форму документа.
	
	Элементы.ГруппаИндикаторОшибкиЦепочки.Видимость = ВидимостьИндикатора;
	
	ВидимостьИндикаторов.ОшибкиЦепочки = ВидимостьИндикатора;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьИндикаторПредупреждение(Знач Данные, Знач ДополнительныеПараметры, ВидимостьИндикаторов)
	
	ПризнакиРешения = Данные.ПризнакиРешения;
	
	ВидимостьИндикатора = Ложь;
	ТекстПредупреждения = "";
	
	Если Не ВидимостьИндикаторов.ОшибкиЦепочки Тогда
		Если ПризнакиРешения.ПометкаУдаления Тогда
			ВидимостьИндикатора = Истина;
			ТекстПредупреждения = НСтр("ru='Документ помечен на удаление и не участвует в построении цепочки документов'");
			
		ИначеЕсли ПризнакиРешения.Аннулировано Тогда
			ВидимостьИндикатора = Истина;
			ТекстПредупреждения = НСтр("ru='Решение аннулировано'");
			
		ИначеЕсли Не ПризнакиРешения.Проведен Тогда
			ВидимостьИндикатора = Истина;
			ТекстПредупреждения = НСтр("ru='Решение не проведено'");
		КонецЕсли;
	КонецЕсли;
	
	Элементы.НадписьИндикаторПредупреждениеКомментарий.Заголовок = ТекстПредупреждения;
	
	Элементы.ГруппаИндикаторПредупреждение.Видимость = ВидимостьИндикатора;
	
	ВидимостьИндикаторов.Предупреждение = ВидимостьИндикатора;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьИндикаторНетПрав(Знач Данные, Знач ДополнительныеПараметры, ВидимостьИндикаторов)
	
	КодыФормНетПравИНеСформированоПолностью = ПолучитьКодыФормНетПравИНеСформированоПолностью(
		ДополнительныеПараметры.ПраваСоздания, ДополнительныеПараметры.СтатистикаТаблицыВизуализацииРешения.КодыФормНеСформированоПолностью);
	
	ВидимостьИндикатора = (КодыФормНетПравИНеСформированоПолностью.Количество() > 0)
		И Не ВидимостьИндикаторов.ОшибкиЦепочки
		И Не ВидимостьИндикаторов.Предупреждение;
	
	ТекстКомментария = "";
	ТекстРасширеннойПодсказки = "";
	
	Если ВидимостьИндикатора Тогда
		ТекстыИндикатора = ПолучитьТекстыИндикатораНетПрав(
			ДополнительныеПараметры.ПраваСоздания, КодыФормНетПравИНеСформированоПолностью);
		
		ТекстКомментария = ТекстыИндикатора.ТекстКомментария;
		ТекстРасширеннойПодсказки = ТекстыИндикатора.ТекстРасширеннойПодсказки;
	КонецЕсли;
	
	ЭлементНадписи = Элементы.НадписьИндикаторНетПравКомментарий;
	
	ЭлементНадписи.Заголовок = ТекстКомментария;
	ЭлементНадписи.РасширеннаяПодсказка.Заголовок = ТекстРасширеннойПодсказки;
	
	Элементы.ГруппаИндикаторНетПрав.Видимость = ВидимостьИндикатора;
	
	ВидимостьИндикаторов.НетПрав = ВидимостьИндикатора;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьИндикаторОтбор(Знач Данные, Знач ДополнительныеПараметры,
		Знач ПараметрыПоиска, ВидимостьИндикаторов)
	
	ВидимостьИндикатора = (ПараметрыПоиска.ОтборМассивКодовФорм.Количество() > 0);
	
	ТекстНадписи = ПолучитьТекстИндикатораОтбор(ПараметрыПоиска);
	
	Элементы.НадписьИндикаторОтбор.Заголовок = ТекстНадписи;
	
	Элементы.ГруппаИндикаторОтбор.Видимость = ВидимостьИндикатора;
	
	ВидимостьИндикаторов.Отбор = ВидимостьИндикатора;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьИндикаторОписиСформированы(Знач Данные, Знач ДополнительныеПараметры, ВидимостьИндикаторов)
	
	СостоянияИндикатораОписи				= ДополнительныеПараметры.СостоянияИндикатораОписи;
	СтатистикаТаблицыВизуализацииРешения	= ДополнительныеПараметры.СтатистикаТаблицыВизуализацииРешения;
	
	ТекстНадписи = "";
	Картинка = Новый Картинка();
	
	ВидимостьИндикатора = Не ВидимостьИндикаторов.ОшибкиЦепочки
		И Не ВидимостьИндикаторов.Предупреждение
		И СтатистикаТаблицыВизуализацииРешения.ЕстьСопоставленныеОписи
		И (СтатистикаТаблицыВизуализацииРешения.ВсеСформированоПроведеноЛибоНеПредусмотрено
			Или СтатистикаТаблицыВизуализацииРешения.ВсеСформированоНеПроведеноЛибоНеПредусмотрено);
			
	Если ВидимостьИндикатора Тогда
		Если СтатистикаТаблицыВизуализацииРешения.ВсеСформированоПроведеноЛибоНеПредусмотрено Тогда
			ТекстНадписи = НСтр("ru='Все документы описей сформированы и проведены'");
			Картинка = СостоянияИндикатораОписи.ДокументСозданПроведен.Картинка;
			
		ИначеЕсли СтатистикаТаблицыВизуализацииРешения.ВсеСформированоНеПроведеноЛибоНеПредусмотрено Тогда
			ТекстНадписи = НСтр("ru='Все документы описей сформированы'");
			Картинка = СостоянияИндикатораОписи.ДокументСозданНеПроведен.Картинка;
		КонецЕсли;
		
	КонецЕсли;
	
	Элементы.НадписьИндикаторОписиСформированы.Заголовок = ТекстНадписи;
	Элементы.КартинкаИндикаторОписиСформированы.Картинка = Картинка;
	
	Элементы.ГруппаИндикаторОписиСформированы.Видимость = ВидимостьИндикатора;
	
	ВидимостьИндикаторов.ОписиСформированы = ВидимостьИндикатора;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьКодыФормНетПравИНеСформированоПолностью(ПраваСоздания, КодыФормНеСформированоПолностью)
	
	// Цель: исключить вывод индикатора "Нет прав" для кодов форм, по которым
	// полностью сформированы описи (по всем соответствующим строкам Решения).
	// Описи таких кодов форм создавать не нужно, они уже созданы,
	// поэтому сообщение о недостатке прав создания документа не требуется.
	
	КодыФормНетПрав = ПраваСоздания.КодыФормНетПрав;
	
	КодыФорм = Новый Массив();
	
	Для Каждого КодФормы Из КодыФормНетПрав Цикл
		Если КодыФормНеСформированоПолностью.Получить(КодФормы) <> Неопределено Тогда
			КодыФорм.Добавить(КодФормы);
		КонецЕсли;
	КонецЦикла;
	
	Возврат КодыФорм;
	
КонецФункции

&НаСервере
Функция ПолучитьТекстыИндикатораНетПрав(ПраваСоздания,
		КодыФормНетПравИНеСформированоПолностью)
	
	СписокНедоступныхДокументов = ПраваСоздания.СписокНедоступныхДокументов;
	
	КоличествоНедоступных = КодыФормНетПравИНеСформированоПолностью.Количество();
	
	Если КоличествоНедоступных = 1 Тогда
		ШаблонКодыФорм = НСтр("ru='описи %1'");
	ИначеЕсли КоличествоНедоступных > 1 Тогда
		ШаблонКодыФорм = НСтр("ru='описей %1'");
	КонецЕсли;
	
	ШрифтЖирный = Новый Шрифт(,, Истина);
	
	МассивТекстов = Новый Массив();
	
	ТекстКодыФорм = СтрШаблон(ШаблонКодыФорм, СтрСоединить(КодыФормНетПравИНеСформированоПолностью, ", "));
	
	ТекстКомментария = СтрШаблон(НСтр("ru='Отсутствует право создания %1'"), ТекстКодыФорм);
	
	Для Каждого КодФормы Из КодыФормНетПравИНеСформированоПолностью Цикл
		ЭтоПервыйДокумент = Истина;
		
		Для Каждого Элемент Из СписокНедоступныхДокументов Цикл
			КодФормыЭлемента = Элемент.Представление;
			ИмяДокумента = Элемент.Значение;
			
			Если КодФормыЭлемента <> КодФормы Тогда
				Продолжить;
			КонецЕсли;
			
			СинонимДокумента = Метаданные.Документы.Найти(ИмяДокумента).Синоним;
			
			Если МассивТекстов.Количество() > 0 Тогда
				МассивТекстов.Добавить(Символы.ПС);
			КонецЕсли;
			
			Если ЭтоПервыйДокумент Тогда
				МассивТекстов.Добавить(Новый ФорматированнаяСтрока(КодФормы, ШрифтЖирный));
				МассивТекстов.Добавить(СтрШаблон(" - %1", СинонимДокумента));
			Иначе
				МассивТекстов.Добавить(СтрШаблон("   %1", СинонимДокумента));
			КонецЕсли;
			
			ЭтоПервыйДокумент = Ложь;
		КонецЦикла;
	КонецЦикла;
	
	ТекстыИндикатора = Новый Структура();
	ТекстыИндикатора.Вставить("ТекстКомментария", ТекстКомментария);
	ТекстыИндикатора.Вставить("ТекстРасширеннойПодсказки", Новый ФорматированнаяСтрока(МассивТекстов));
	
	Возврат ТекстыИндикатора;
	
КонецФункции

&НаСервере
Функция ПолучитьТекстИндикатораОтбор(ПараметрыПоиска)
	
	МассивКодов = ПараметрыПоиска.ОтборМассивКодовФорм;
	
	ТекстНадписи = "";
	
	КоличествоЭлементов = МассивКодов.Количество();
	
	Если КоличествоЭлементов > 0 Тогда
		Если КоличествоЭлементов = 1 Тогда
			Шаблон = НСтр("ru='коду формы %1'");
		ИначеЕсли КоличествоЭлементов > 1 Тогда
			Шаблон = НСтр("ru='кодам форм %1'");
		КонецЕсли;
		
		ТекстКодыФорм = СтрШаблон(Шаблон, СтрСоединить(МассивКодов, ", "));
		
		ТекстНадписи = СтрШаблон(НСтр("ru='Установлен отбор по %1'"), ТекстКодыФорм);
	КонецЕсли;
	
	Возврат ТекстНадписи;
	
КонецФункции

&НаСервере
Функция ПолучитьСписокДокументовНедоступныхДляСоздания(КодыФорм, СвойстваКодовФормСозданиеПредусмотрено)
	
	// Проверяем право создания только тех документов, которые может создавать обработка группового формирования описей.
	
	СписокДокументов = Новый СписокЗначений();
	
	Для Каждого КодФормы Из КодыФорм Цикл
		ИмяДокумента = СвойстваКодовФормСозданиеПредусмотрено.Получить(КодФормы).ИмяДокумента;
		
		Если Не ПравоДоступа("Добавление", Метаданные.Документы.Найти(ИмяДокумента)) Тогда
			СписокДокументов.Добавить(ИмяДокумента, КодФормы);
		КонецЕсли;
	КонецЦикла;
	
	СписокДокументов.СортироватьПоПредставлению();
	
	Возврат СписокДокументов;
	
КонецФункции

#КонецОбласти



#КонецОбласти

#Область РасчетДокументов

&НаСервере
Функция НовыйПараметрыРасчетаИндексовСтрокТаблицыРешения()
	
	ПараметрыРасчета = Новый Структура();
	ПараметрыРасчета.Вставить("РешениеСсылка");
	ПараметрыРасчета.Вставить("НастройкиОбъединенияСтрок");
	ПараметрыРасчета.Вставить("ОтмеченныеСтрокиТаблицыРешения");
	
	Возврат ПараметрыРасчета;
	
КонецФункции

&НаСервере
Функция РассчитатьИндексыСтрокТаблицыРешения(АдресХранилища)
	
	// См. НовыйПараметрыРасчетаИндексовСтрокТаблицыРешения().
	ПараметрыРасчета = ПолучитьИзВременногоХранилища(АдресХранилища);
	
	РешениеСсылка					= ПараметрыРасчета.РешениеСсылка;
	НастройкиОбъединенияСтрок		= ПараметрыРасчета.НастройкиОбъединенияСтрок;
	ОтмеченныеСтрокиТаблицыРешения	= ПараметрыРасчета.ОтмеченныеСтрокиТаблицыРешения;
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РешениеСсылка, "Дата,Организация");
	
	Организация = ЗначенияРеквизитов.Организация;
	ДатаРешения = ЗначенияРеквизитов.Дата;
	
	ТаблицаНастроек = ИнвентаризацияСервер.ПолучитьТаблицуНастроекЗаполненияОписейПоРешению(, Истина, Организация);
	
	МассивКодовФормКСозданию = Неопределено;
	
	СоздатьКолонкиБыстрогоПоиска(ОтмеченныеСтрокиТаблицыРешения, МассивКодовФормКСозданию);
	
	СвойстваКодовФормСозданиеПредусмотрено = ПолучитьСвойстваКодовФормСозданиеПредусмотрено(
		ТаблицаНастроек, ДатаРешения);
	
	ВсеИндексыСтрок = Новый Соответствие();
	
	Для Каждого КодФормы Из МассивКодовФормКСозданию Цикл
		СвойстваКодаФормы = СвойстваКодовФормСозданиеПредусмотрено.Получить(КодФормы);
		
		ИндексыСтрокДокументов = РассчитатьИндексыСтрокДокументов(ОтмеченныеСтрокиТаблицыРешения,
			КодФормы, СвойстваКодаФормы, НастройкиОбъединенияСтрок);
		
		ВсеИндексыСтрок.Вставить(КодФормы, ИндексыСтрокДокументов);
	КонецЦикла;
	
	РезультатРасчета = ИнвентаризацияСервер.НовыйРезультатРасчетаИндексовСтрокТаблицыРешенияДляГрупповогоФормированияОписей();
	РезультатРасчета.ПараметрыРасчета = ПараметрыРасчета;
	РезультатРасчета.СвойстваКодовФормСозданиеПредусмотрено = СвойстваКодовФормСозданиеПредусмотрено;
	РезультатРасчета.ВсеИндексыСтрок = ВсеИндексыСтрок;
	РезультатРасчета.МассивКодовФормКСозданию = МассивКодовФормКСозданию;
	
	ПоместитьВоВременноеХранилище(РезультатРасчета, АдресХранилища);
	
	РезультатПроверки = ПроверитьРезультатРасчетаДокументовОписей(РезультатРасчета);
	
	Возврат РезультатПроверки;
	
КонецФункции

&НаСервере
Функция РассчитатьИндексыСтрокДокументов(ТаблицаРешения,
		КодФормы, СвойстваКодаФормы, НастройкиОбъединенияСтрок)
	
	ИмяКолонки = ПолучитьИмяКолонкиДляБыстрогоПоиска(КодФормы);
	
	ПоискВОбщейТаблице = Новый Структура(ИмяКолонки, Истина);
	
	СвернутаяТаблицаРешения = ТаблицаРешения.Скопировать(ПоискВОбщейТаблице);
	
	КолонкиГруппировок = СтрРазделить("ДатаИнвентаризации,ДатаНачала,ДатаОкончания,НомерКомиссии,НомерРабочейКомиссии,Сотрудник", ", ", Ложь);
	
	Если СвойстваКодаФормы.РасположениеРеквизитов.Счет.РасположенВШапке
		Или СвойстваКодаФормы.РасположениеРеквизитов.Счет.Отсутствует Тогда
		КолонкиГруппировок.Добавить("КФО");
		КолонкиГруппировок.Добавить("Счет");
		
	ИначеЕсли СвойстваКодаФормы.РасположениеРеквизитов.Счет.РасположенВТабличнойЧасти Тогда
		ИмяФлажкаСчет = ПолучитьИмяФлажкаНастройкиОбъединенияПоСчетам(КодФормы);
		
		ОбъединитьСтроки = НастройкиОбъединенияСтрок[ИмяФлажкаСчет];
		
		Если Не ОбъединитьСтроки Тогда
			КолонкиГруппировок.Добавить("КФО");
			КолонкиГруппировок.Добавить("Счет");
		КонецЕсли;
	КонецЕсли;
	
	Если СвойстваКодаФормы.РасположениеРеквизитов.МестоИнвентаризации.РасположенВШапке Тогда
		КолонкиГруппировок.Добавить("МестоИнвентаризации");
		
	ИначеЕсли СвойстваКодаФормы.РасположениеРеквизитов.МестоИнвентаризации.РасположенВТабличнойЧасти Тогда
		ИмяФлажкаМестоИнвентаризации = ПолучитьИмяФлажкаНастройкиОбъединенияПоМестамИнвентаризации(КодФормы);
		
		ОбъединитьСтроки = НастройкиОбъединенияСтрок[ИмяФлажкаМестоИнвентаризации];
		Если Не ОбъединитьСтроки Тогда
			КолонкиГруппировок.Добавить("МестоИнвентаризации");
		КонецЕсли;
	КонецЕсли;
	
	КолонкиГруппировокСтрокой = СтрСоединить(КолонкиГруппировок, ",");
	
	СвернутаяТаблицаРешения.Свернуть(КолонкиГруппировокСтрокой);
	
	ПоискВОбщейТаблице = Новый Структура(КолонкиГруппировокСтрокой);
	ПоискВОбщейТаблице.Вставить(ИмяКолонки, Истина);
	
	ИндексыСтрокДокументов = Новый Массив();
	
	Для Каждого СтрокаСвернутойТаблицыРешения Из СвернутаяТаблицаРешения Цикл
		ИндексыСтрокДокумента = Новый Массив();
		
		ЗаполнитьЗначенияСвойств(ПоискВОбщейТаблице, СтрокаСвернутойТаблицыРешения);
		
		МассивСтрок = ТаблицаРешения.НайтиСтроки(ПоискВОбщейТаблице);
		
		Для Каждого СтрокаТаблицыРешения Из МассивСтрок Цикл
			ИндексыСтрокДокумента.Добавить(ТаблицаРешения.Индекс(СтрокаТаблицыРешения));
		КонецЦикла;
		
		ИндексыСтрокДокументов.Добавить(ИндексыСтрокДокумента);
	КонецЦикла;
	
	Возврат ИндексыСтрокДокументов;
	
КонецФункции

&НаСервере
Функция НовыйРезультатПроверкиРасчетаИндексовСтрокТаблицыРешения()
	
	РезультатПроверки = Новый Структура();
	РезультатПроверки.Вставить("ТекстСообщения", "");
	РезультатПроверки.Вставить("КоличествоДокументов", 0);
	РезультатПроверки.Вставить("Отказ", Ложь);
	
	Возврат РезультатПроверки;
	
КонецФункции

// РезультатРасчета - Структура - См. ИнвентаризацияСервер.НовыйРезультатРасчетаИндексовСтрокТаблицыРешенияДляГрупповогоФормированияОписей().
&НаСервере
Функция ПроверитьРезультатРасчетаДокументовОписей(РезультатРасчета)
	
	СвойстваКодовФормСозданиеПредусмотрено	= РезультатРасчета.СвойстваКодовФормСозданиеПредусмотрено;
	ВсеИндексыСтрок							= РезультатРасчета.ВсеИндексыСтрок;
	МассивКодовФормКСозданию				= РезультатРасчета.МассивКодовФормКСозданию;
	
	ИменаДокументовСозданиеПредусмотрено = НовыйИменаДокументовСозданиеПредусмотрено();
	
	СписокНедоступныхДокументов = ПолучитьСписокДокументовНедоступныхДляСоздания(
		МассивКодовФормКСозданию, СвойстваКодовФормСозданиеПредусмотрено);
	
	ИменаДокументовНетПрав = СписокНедоступныхДокументов.ВыгрузитьЗначения();
	
	Отказ = Ложь;
	
	ОбщийСчетчикДокументов = 0;
	
	КоличествоНедоступныхДокументов = ИменаДокументовНетПрав.Количество();
	
	Если КоличествоНедоступныхДокументов > 0 Тогда
		// Нет прав доступа на планируемые к созданию документы.
		Отказ = Истина;
		
		Если КоличествоНедоступныхДокументов > 1 Тогда
			Шаблон = НСтр("ru='документов:
				|%1'");
			
			МассивТекстов = Новый Массив();
			
			Для Каждого ИмяДокумента Из ИменаДокументовНетПрав Цикл
				СинонимДокумента = Метаданные.Документы[ИмяДокумента].Синоним;
				
				МассивТекстов.Добавить(СтрШаблон(" - %1", СинонимДокумента));
			КонецЦикла;
			
			ТекстИменаДокументов = СтрШаблон(Шаблон, СтрСоединить(МассивТекстов, Символы.ПС));
		Иначе
			Шаблон = НСтр("ru='документа %1.'");
			
			ИмяДокумента = ИменаДокументовНетПрав[0];
			
			СинонимДокумента = Метаданные.Документы[ИмяДокумента].Синоним;
			
			ТекстИменаДокументов = СтрШаблон(Шаблон, СинонимДокумента);
		КонецЕсли;
		
		ТекстСообщения = СтрШаблон(НСтр("ru='Формирование документов описей не выполнено.
			|У текущего пользователя отсутствует право добавления %1'"),
			ТекстИменаДокументов);
	Иначе
		// Выводим информационное сообщение о количестве формируемых документов.
		Если ВсеИндексыСтрок.Количество() > 0 Тогда
			СчетчикиДокументов = Новый Соответствие();
			
			Для Каждого Элемент Из ВсеИндексыСтрок Цикл
				КодФормы = Элемент.Ключ;
				ИндексыСтрок = Элемент.Значение;
				
				КоличествоДокументов = ИндексыСтрок.Количество();
				
				СчетчикиДокументов.Вставить(КодФормы, КоличествоДокументов);
				
				ОбщийСчетчикДокументов = ОбщийСчетчикДокументов + КоличествоДокументов;
			КонецЦикла;
			
			ТекстПоКодамФорм = ИнвентаризацияСервер.ПолучитьТекстСообщенияКоличествоДокументовПоКодамФорм(СчетчикиДокументов);
			
			// 0, 1, 2, немного, 5, другое
			ТекстКоличествоДокументов = СтрокаСЧислом(";Будет создан %1 документ описи;;Будут созданы %1 документа описей;Будут созданы %1 документов описей;Будут созданы %1 документов описей",
				ОбщийСчетчикДокументов,
				ВидЧисловогоЗначения.Количественное);
			
			ТекстСообщения = СтрШаблон(НСтр("ru='%1
				|из них:
				|%2'"),
				ТекстКоличествоДокументов,
				ТекстПоКодамФорм);
		Иначе
			Отказ = Истина;
			
			ТекстСообщения = НСтр("ru='Формирование документов описей не выполнено.
				|В отмеченных строках таблицы не выбраны коды форм.'");
		КонецЕсли;
	КонецЕсли;
	
	РезультатПроверки = НовыйРезультатПроверкиРасчетаИндексовСтрокТаблицыРешения();
	РезультатПроверки.ТекстСообщения = ТекстСообщения;
	РезультатПроверки.Отказ = Отказ;
	РезультатПроверки.КоличествоДокументов = ОбщийСчетчикДокументов;
	
	Возврат РезультатПроверки;
	
КонецФункции

&НаСервере
Функция ПолучитьСвойстваКодовФормСозданиеПредусмотрено(ТаблицаНастроек, ДатаРешения)
	
	// Заполняем свойства только тех кодов форм, формирование которых предусмотрено обработкой.
	// Предполагается, что одному коду формы соответствует один документ и одна строка таблицы настроек.
	
	ИменаДокументовСозданиеПредусмотрено = НовыйИменаДокументовСозданиеПредусмотрено();
	
	ПредставлениеДаты = Формат(ДатаРешения, "ДФ=dd.MM.yyyy");
	
	СвойстваКодовФорм = Новый Соответствие();
	
	Для Каждого ИмяДокумента Из ИменаДокументовСозданиеПредусмотрено Цикл
		МассивСтрок = ПолучитьСтрокиТаблицыНастроекПоИмениДокумента(ИмяДокумента, ТаблицаНастроек, ДатаРешения);
		
		Если МассивСтрок.Количество() = 0 Тогда
			Продолжить;
			
		ИначеЕсли МассивСтрок.Количество() > 1 Тогда
			ТекстСообщения = СтрШаблон(
				НСтр("ru='Для документа описи %1 найдено более одной действующей строки таблицы настроек на дату %2'"),
				ИмяДокумента, ПредставлениеДаты);
			
			ВызватьИсключение ТекстСообщения;
		КонецЕсли;
		
		СтрокаТаблицыНастроек = МассивСтрок[0];
		
		КодФормы = СтрокаТаблицыНастроек.КодФормы;
		
		Проверка = СвойстваКодовФорм.Получить(КодФормы);
		
		Если Проверка <> Неопределено Тогда
			ИменаДокументов = Проверка.ИмяДокумента + ", " + ИмяДокумента;
			
			ТекстСообщения = СтрШаблон(
				НСтр("ru='Для кода формы %1 в таблице настроек на дату %2 указано более одного документа описи (%3), для которых предусмотрено групповое формирование описей'"),
				КодФормы, ПредставлениеДаты, ИменаДокументов);
			
			ВызватьИсключение ТекстСообщения;
		КонецЕсли;
		
		СвойстваКодаФормы = Новый Структура();
		СвойстваКодаФормы.Вставить("ИмяДокумента", СтрокаТаблицыНастроек.ИмяДокумента);
		СвойстваКодаФормы.Вставить("РасположениеРеквизитов", ИнвентаризацияСервер.ПолучитьОписаниеРасположенияРеквизитовОписи(СтрокаТаблицыНастроек));
		
		СвойстваКодовФорм.Вставить(КодФормы, СвойстваКодаФормы);
	КонецЦикла;
	
	Возврат СвойстваКодовФорм;
	
КонецФункции

&НаСервере
Функция ПолучитьСтрокиТаблицыНастроекПоИмениДокумента(ИмяДокумента, ТаблицаНастроек, ДатаРешения)
	
	СтрокиТаблицы = Новый Массив();
	
	Поиск = Новый Структура("ИмяДокумента", ИмяДокумента);
	
	МассивСтрок = ТаблицаНастроек.НайтиСтроки(Поиск);
	
	Для Каждого СтрокаТаблицыНастроек Из МассивСтрок Цикл
		ДатаНачалаПрименения			= СтрокаТаблицыНастроек.ДатаНачалаПрименения;
		ДатаОкончанияПримененияВключая	= СтрокаТаблицыНастроек.ДатаОкончанияПримененияВключая;
		
		Если ЗначениеЗаполнено(ДатаНачалаПрименения) И ЗначениеЗаполнено(ДатаОкончанияПримененияВключая)
			И (ДатаРешения < ДатаНачалаПрименения Или ДатаРешения > ДатаОкончанияПримененияВключая) Тогда
			Продолжить;
			
		ИначеЕсли ЗначениеЗаполнено(ДатаНачалаПрименения) И ДатаРешения < ДатаНачалаПрименения Тогда
			Продолжить;
			
		ИначеЕсли ЗначениеЗаполнено(ДатаОкончанияПримененияВключая) И ДатаРешения > ДатаОкончанияПримененияВключая Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокиТаблицы.Добавить(СтрокаТаблицыНастроек);
	КонецЦикла;
	
	Возврат СтрокиТаблицы;
	
КонецФункции

&НаСервере
Процедура СоздатьКолонкиБыстрогоПоиска(ТаблицаРешения, МассивКодовФормКСозданию)
	
	// Создаем колонки поиска только для тех кодов форм, которые отмечены к созданию.
	// Создавать колонки для всех теоретически возможных кодов форм не имеет смысла,
	// т.к. часть из них может не использоваться.
	// В СозданиеВыбрано уже учтено возможное наличие описей.
	
	МассивКодовФормКСозданию = Новый Массив();
	
	Для Каждого СтрокаТаблицыРешения Из ТаблицаРешения Цикл
		КодыФормКСозданию = Новый Соответствие();
		
		Для Каждого КодФормы Из СтрокаТаблицыРешения.МассивКодовФормСозданиеВыбрано Цикл
			КодыФормКСозданию.Вставить(КодФормы, Истина);
		КонецЦикла;
		
		Для Каждого Элемент Из КодыФормКСозданию Цикл
			КодФормы = Элемент.Ключ;
			
			ИмяКолонки = ПолучитьИмяКолонкиДляБыстрогоПоиска(КодФормы);
			
			Если МассивКодовФормКСозданию.Найти(КодФормы) = Неопределено Тогда
				МассивКодовФормКСозданию.Добавить(КодФормы);
				
				ТаблицаРешения.Колонки.Добавить(ИмяКолонки, Новый ОписаниеТипов("Булево"));
			КонецЕсли;
			
			СтрокаТаблицыРешения[ИмяКолонки] = Истина;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ФормированиеДокументов

&НаКлиенте
Процедура ПроверитьИСформироватьОписи()
	
	Отказ = Ложь;
	
	ПроверитьТаблицуРешенияПередФормированиемОписей(Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ПодтвердитьИСформироватьОписи();
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьТаблицуРешенияПередФормированиемОписей(Отказ)
	
	Поиск = Новый Структура("Отметка", Истина);
	
	МассивСтрок = ТаблицаРешения.НайтиСтроки(Поиск);
	
	Если МассивСтрок.Количество() = 0 Тогда
		Поиск = Новый Структура("ОтметкаДоступна", Истина);
		
		МассивСтрок = ТаблицаРешения.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() = 0 Тогда
			ТекстСообщения = НСтр("ru='В таблице Решения отсутствуют строки, по которым необходимо сформировать описи.'");
		Иначе
			ТекстСообщения = НСтр("ru='Отметьте строки Решения, по которым необходимо сформировать описи.'");
		КонецЕсли;
		
		ПоказатьПредупреждение(, ТекстСообщения);
		
		Отказ = Истина;
		
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьИСформироватьОписи()
	
	РезультатПроверки = РассчитатьДокументыОписейСервер();
	
	Если РезультатПроверки.Отказ Тогда
		ПоказатьПредупреждение(, РезультатПроверки.ТекстСообщения);
		
		Возврат;
	КонецЕсли;
	
	ТекстСообщения = СтрШаблон(НСтр("ru='%1
		|
		|Продолжить?'"),
		РезультатПроверки.ТекстСообщения);
	
	Оповещение = Новый ОписаниеОповещения("ПодтвердитьИСформироватьОписиВыбор", ЭтотОбъект);
	
	ПоказатьВопрос(Оповещение, ТекстСообщения, РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Да);
	
КонецПроцедуры

&НаСервере
Функция РассчитатьДокументыОписейСервер()
	
	ИменаРеквизитов = ПолучитьИменаРеквизитовНастроекОбъединенияСтрок();
	
	НастройкиОбъединенияСтрок = Новый Структура();
	
	Для Каждого ИмяРеквизита Из ИменаРеквизитов Цикл
		НастройкиОбъединенияСтрок.Вставить(ИмяРеквизита, ЭтотОбъект[ИмяРеквизита]);
	КонецЦикла;
	
	Поиск = Новый Структура("Отметка", Истина);
	
	ОтмеченныеСтрокиТаблицыРешения = ТаблицаРешения.Выгрузить(Поиск);
	
	ПараметрыРасчета = НовыйПараметрыРасчетаИндексовСтрокТаблицыРешения();
	ПараметрыРасчета.РешениеСсылка = Решение;
	ПараметрыРасчета.НастройкиОбъединенияСтрок = НастройкиОбъединенияСтрок;
	ПараметрыРасчета.ОтмеченныеСтрокиТаблицыРешения = ОтмеченныеСтрокиТаблицыРешения;
	
	АдресХранилища = ПоместитьВоВременноеХранилище(ПараметрыРасчета, УникальныйИдентификатор);
	
	РезультатПроверки = РассчитатьИндексыСтрокТаблицыРешения(АдресХранилища);
	
	Возврат РезультатПроверки;
	
КонецФункции

&НаКлиенте
Процедура ПодтвердитьИСформироватьОписиВыбор(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		СформироватьОписиКлиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьОписиКлиент()
	
	РезультатЗадания = СформироватьОписиСервер();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	
	ОписаниеОповещенияЗавершение = Новый ОписаниеОповещения("ФормированиеОписейЗавершеноКлиент", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, ОписаниеОповещенияЗавершение, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция СформироватьОписиСервер()
	
	РезультатРасчета = ПолучитьИзВременногоХранилища(АдресХранилища);
	
	ПараметрыФормирования = ИнвентаризацияСервер.НовыйПараметрыФормированияДокументовОписейДляГрупповогоФормированияОписей();
	ПараметрыФормирования.УстанавливатьКомментарий = УстанавливатьКомментарий;
	ПараметрыФормирования.ШаблонКомментария = ШаблонКомментария;
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru='Формирование документов описей по Решению'");
	
	Возврат ДлительныеОперации.ВыполнитьФункцию(
		ПараметрыВыполнения,
		"ИнвентаризацияСервер.СформироватьДокументыОписейДляГрупповогоФормированияОписей",
		РезультатРасчета,
		ПризнакиРешения,
		ПараметрыФормирования);
	
КонецФункции

&НаКлиенте
Процедура ФормированиеОписейЗавершеноКлиент(Результат, ДополнительныеПараметры) Экспорт
	
	Перем РезультатФормирования;
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		СтандартныеПодсистемыКлиент.ВывестиИнформациюОбОшибке(Результат.ИнформацияОбОшибке);
		Возврат;
	КонецЕсли;
	
	ФормированиеОписейЗавершеноСервер(Результат.АдресРезультата, РезультатФормирования);
	
	НастроитьФормуПослеОбновления();
	
	ПоказатьПредупреждение(, РезультатФормирования.ТекстСообщения);
	
КонецПроцедуры

&НаСервере
Процедура ФормированиеОписейЗавершеноСервер(Знач АдресРезультата, РезультатФормирования)
	
	РезультатФормирования = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	УдалитьИзВременногоХранилища(АдресРезультата);
	
	ОбновитьДанныеСервер();
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти
