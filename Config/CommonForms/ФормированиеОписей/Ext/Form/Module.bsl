#Область ОбработчикиСобытийЭлементовТаблицыФормы_ТаблицаРешения

&НаКлиенте
Процедура ТаблицаРешенияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СтрокаТаблицы = ТаблицаРешения.НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	ИмяПоля = СтрЗаменить(Поле.Имя, "ТаблицаРешения", "");
	
	Если ИмяПоля = "ПредставлениеОписи" Тогда
		Если СтрокаТаблицы.МассивОписанийОписей.Количество() > 1 Тогда
			ПоказатьСписокДокументовОписей(СтрокаТаблицы);
		КонецЕсли;
		
		Если СтрокаТаблицы.МассивОписанийОписей.Количество() = 1 Тогда
			ПоказатьЗначение(, СтрокаТаблицы.МассивОписанийОписей[0].Ссылка);
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяПоля = "КартинкаИндикатораОписи" Тогда
		Если СтрокаТаблицы.КодИндикатораОписи = СостоянияИндикатораОписи.Ожидается.Код Тогда
			ПоказатьПредупреждение(, НСтр("ru='Необходимо сформировать документ описи.'"));
			
		ИначеЕсли СтрокаТаблицы.КодИндикатораОписи = СостоянияИндикатораОписи.НеПредусмотреноЗаконодательством.Код Тогда
			ПоказатьПредупреждение(, НСтр("ru='Для указанного счета не определен код формы.'"));
			
		ИначеЕсли СтрокаТаблицы.КодИндикатораОписи = СостоянияИндикатораОписи.НеПредусмотреноОбработкой.Код Тогда
			ПоказатьПредупреждение(, НСтр("ru='Для указанного счета групповое формирование описей в программе не предусмотрено.'"));
			
		ИначеЕсли СтрокаТаблицы.КодИндикатораОписи = СостоянияИндикатораОписи.ДокументСозданНеПроведен.Код Тогда
			ПоказатьПредупреждение(, НСтр("ru='Документ описи сформирован, не проведен.'"));
			
		ИначеЕсли СтрокаТаблицы.КодИндикатораОписи = СостоянияИндикатораОписи.ДокументСозданПроведен.Код Тогда
			ПоказатьПредупреждение(, НСтр("ru='Документ описи сформирован, проведен.'"));
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяПоля = "КартинкаИндикатораОшибки" Тогда
		Если СтрокаТаблицы.КодИндикатораОшибки = СостоянияИндикатораОшибки.НесколькоДокументовОдногоВида.Код Тогда
			ПоказатьПредупреждение(, НСтр("ru='Обнаружено несколько документов описей одного и того же кода формы.'"));
			
		ИначеЕсли СтрокаТаблицы.КодИндикатораОшибки = СостоянияИндикатораОшибки.НеПредусмотреноЗаконодательством.Код Тогда
			ПоказатьПредупреждение(, НСтр("ru='Для указанного счета не определен код формы.'"));
			
		ИначеЕсли СтрокаТаблицы.КодИндикатораОшибки = СостоянияИндикатораОшибки.НеПредусмотреноОбработкой.Код Тогда
			ПоказатьПредупреждение(, НСтр("ru='Для указанного счета групповое формирование описей в программе не предусмотрено.'"));
			
		ИначеЕсли СтрокаТаблицы.КодИндикатораОшибки = СостоянияИндикатораОшибки.НетПрав.Код Тогда
			ПоказатьСообщениеОбОтсутствииПравСозданияОписи(СтрокаТаблицы);
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяПоля = "КодФормы" Тогда
		ПоказатьВыбранныеКодыФормВСтрокеТаблицы(СтрокаТаблицы);
	КонецЕсли;
	
КонецПроцедуры

