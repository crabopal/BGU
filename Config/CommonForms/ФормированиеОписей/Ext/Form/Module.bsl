&НаСервере
Процедура ИнициализироватьФорму()
	
	ШаблонКомментарияПоУмолчанию = ПолучитьШаблонКомментарияПоУмолчанию();
	ПодсказкаДоступныеПараметрыШаблона = ПолучитьПодсказкуПараметрыШаблонаКомментария();
	
	ШаблонКомментария = ШаблонКомментарияПоУмолчанию; // Значение по умолчанию, сохраняется в настройках формы.
	УстанавливатьКомментарий = Ложь; // Значение по умолчанию, сохраняется в настройках формы.
	
	ЗагрузитьПереданныеПараметры();
	
	УстановитьУсловноеОформление();
	
	КэшироватьНастройкиОбъединенияСтрокПоУмолчанию();
	
	СостоянияИндикатораОписи = Новый ФиксированнаяСтруктура(НовыйСостоянияИндикатораОписи());
	СостоянияИндикатораОшибки = Новый ФиксированнаяСтруктура(НовыйСостоянияИндикатораОшибки());
	
	СброситьНадписиНеобходимоОбновить();
	
	ЦветФонаНедоступнойТаблицы = ПолучитьЦветФонаНедоступнойТаблицы();
	
	Элементы.ГруппаНесопоставленныеОписи.Видимость = Ложь;
	Элементы.ТаблицаРешенияПоказатьСписокВыбораИзмененВручную.Видимость = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьПереданныеПараметры()
	
	ДокументСсылка = Параметры.ДокументСсылка;
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.РешениеОПроведенииИнвентаризации") Тогда
		Решение = ДокументСсылка;
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ИзменениеРешенияОПроведенииИнвентаризации") Тогда
		Решение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "Решение");
	КонецЕсли;
	
	ЗагрузитьОтборМассивКодовФорм();
	
	ИнициализироватьФлажкиОтбиратьПоКодуФормы();
	
	ВыводитьТолькоФормируемыеКодыФорм = Истина; // Значение по умолчанию, сохраняется в настройках формы.
	ИскатьОписиПоПриказу52н = Ложь; // Значение по умолчанию, сохраняется в настройках формы.
	
	ПрименитьЯвноУказанныеЗначенияПараметров();
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьОтборМассивКодовФорм()
	
	ПараметрОтборМассивКодовФорм = Параметры.ОтборМассивКодовФорм;
	
	ВремМассив = Новый Массив();
	
	Если ТипЗнч(ПараметрОтборМассивКодовФорм) = Тип("Массив") Тогда
		ВремМассив = ПараметрОтборМассивКодовФорм;
		
	ИначеЕсли ТипЗнч(ПараметрОтборМассивКодовФорм) = Тип("ФиксированныйМассив") Тогда
		ВремМассив = Новый Массив(ПараметрОтборМассивКодовФорм);
		
	ИначеЕсли ТипЗнч(ПараметрОтборМассивКодовФорм) = Тип("Строка") Тогда
		ВремМассив = СтрРазделить(ПараметрОтборМассивКодовФорм, ", ", Ложь);
	КонецЕсли;
	
	ОтборМассивКодовФорм = Новый ФиксированныйМассив(ВремМассив);
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьФлажкиОтбиратьПоКодуФормы()
	
	УстановленныеФлажки61н = ОбщегоНазначенияИСКлиентСервер.ПересечениеМассивов(
		НовыйКодыФормПредусмотреныНастройкиОтбора61н(), ОтборМассивКодовФорм);
	
	УстановитьЗначениеОтбиратьПоКодуФормы(ЭтотОбъект, Истина, УстановленныеФлажки61н);
	
	УстановленныеФлажки52н = ОбщегоНазначенияИСКлиентСервер.ПересечениеМассивов(
		НовыйКодыФормПредусмотреныНастройкиОтбора52н(), ОтборМассивКодовФорм);
		
	УстановитьЗначениеОтбиратьПоКодуФормы(ЭтотОбъект, Истина, УстановленныеФлажки52н);
	
	УстановленОтборПоКодуФормы = УстановленныеФлажки61н.Количество() > 0
		Или УстановленныеФлажки52н.Количество() > 0;
	
КонецПроцедуры

&НаСервере
Процедура КэшироватьНастройкиОбъединенияСтрокПоУмолчанию()
	
	// Предназначено для быстрой установки реквизитов формы настроек объединения строк.
	// Здесь инициализируются те реквизиты, которые есть на форме.
	
	НастройкиОбъединенияСтрокНаФорме = НовыйНастройкиОбъединенияСтрокНаФорме();
	
	ТаблицаНастроек = ИнвентаризацияСервер.ПолучитьТаблицуНастроекЗаполненияОписейПоРешению();
	
	Поиск = Новый Структура("КодФормы");
	
	ЗначенияРеквизитов = Новый Структура();
	
	Для Каждого КодФормы Из НастройкиОбъединенияСтрокНаФорме.ОбщийСписокКодовФорм Цикл
		Поиск.КодФормы = КодФормы;
		
		МассивСтрок = ТаблицаНастроек.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяДокумента = МассивСтрок[0].ИмяДокумента; // Для описей 61н одному коду формы соответствует ровно один документ.
		
		НастройкиПоУмолчанию = ИнвентаризацияСервер.ПолучитьНастройкиОбъединенияСтрокДляВыбораИзРешения(ИмяДокумента);
		
		ПредусмотренРеквизитФормыПоСчету				= (НастройкиОбъединенияСтрокНаФорме.ПоСчетам.Найти(КодФормы) <> Неопределено);
		ПредусмотренРеквизитФормыПоМестуИнвентаризации	= (НастройкиОбъединенияСтрокНаФорме.ПоМестамИнвентаризации.Найти(КодФормы) <> Неопределено);
		
		Если ПредусмотренРеквизитФормыПоСчету Тогда
			ИмяФлажкаСчет = ПолучитьИмяФлажкаНастройкиОбъединенияПоСчетам(КодФормы);
			
			ЗначенияРеквизитов.Вставить(ИмяФлажкаСчет, НастройкиПоУмолчанию.ПоСчетам);
		КонецЕсли;
		
		Если ПредусмотренРеквизитФормыПоМестуИнвентаризации Тогда
			ИмяФлажкаМестоИнвентаризации = ПолучитьИмяФлажкаНастройкиОбъединенияПоМестамИнвентаризации(КодФормы);
			
			ЗначенияРеквизитов.Вставить(ИмяФлажкаМестоИнвентаризации, НастройкиПоУмолчанию.ПоМестамИнвентаризации);
		КонецЕсли;
	КонецЦикла;
	
	НастройкиОбъединенияСтрокПоУмолчанию = Новый ФиксированнаяСтруктура(ЗначенияРеквизитов);
	
КонецПроцедуры

