&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьИменаРеквизитовНастроекОбъединенияСтрок()
	
	ИменаРеквизитов = Новый Массив();
	ИменаРеквизитов.Добавить("ОбъединитьСтрокиПоСчетам0510466");
	ИменаРеквизитов.Добавить("ОбъединитьСтрокиПоСчетам0510468");
	ИменаРеквизитов.Добавить("ОбъединитьСтрокиПоСчетам0510469");
	ИменаРеквизитов.Добавить("ОбъединитьСтрокиПоСчетам0510471");
	ИменаРеквизитов.Добавить("ОбъединитьСтрокиПоСчетам0510472");
	ИменаРеквизитов.Добавить("ОбъединитьСтрокиПоСчетам0510473");
	ИменаРеквизитов.Добавить("ОбъединитьСтрокиПоСчетам0510474");
	
	ИменаРеквизитов.Добавить("ОбъединитьСтрокиПоМестамИнвентаризации0510466");
	
	Возврат ИменаРеквизитов;
	
КонецФункции

&НаКлиенте
Процедура УстановитьЗаголовокГруппыОбъединитьСтроки()
	
	Если Элементы.ДекорацияНеПредусмотреноОбъединениеСтрок.Видимость Тогда
		ЗаголовокГруппыОбъединитьСтроки = "";
		
		Возврат;
	КонецЕсли;
	
	ИменаРеквизитов = ПолучитьИменаРеквизитовНастроекОбъединенияСтрок();
	
	ЕстьУстановленный = Ложь;
	
	Для Каждого ИмяРеквизита Из ИменаРеквизитов Цикл
		Если ЭтотОбъект[ИмяРеквизита] = Истина Тогда
			ЕстьУстановленный = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ЗаголовокГруппыОбъединитьСтроки = ?(ЕстьУстановленный,
		НСтр("ru='установлено'"),
		НСтр("ru='не установлено'"));
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗначениеНастроекОбъединения(УказанноеЗначениеНастройки)
	
	// Устанавливаются значения только видимых (используемых) флажков.
	
	ИменаРеквизитов = ПолучитьИменаРеквизитовНастроекОбъединенияСтрок();
	
	Для Каждого ИмяРеквизита Из ИменаРеквизитов Цикл
		Если Элементы[ИмяРеквизита].Видимость Тогда
			ЗначениеРеквизита = ?(УказанноеЗначениеНастройки = Неопределено,
				НастройкиОбъединенияСтрокПоУмолчанию[ИмяРеквизита],
				УказанноеЗначениеНастройки);
			
			ЭтотОбъект[ИмяРеквизита] = ЗначениеРеквизита;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Комментарий.

&НаКлиенте
Процедура НастроитьФормуНастройкиКомментария()
	
	Элементы.ШаблонКомментария.ТолькоПросмотр = Не УстанавливатьКомментарий;
	
	ИменаЭлементов = Новый Массив();
	ИменаЭлементов.Добавить("УстановитьКомментарийПоУмолчанию");
	ИменаЭлементов.Добавить("ПоказатьДоступныеПараметрыШаблона");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементов,
		"Доступность", УстанавливатьКомментарий);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьИУстановитьКомментарийПоУмолчанию()
	
	Оповещение = Новый ОписаниеОповещения("ПодтвердитьИУстановитьКомментарийПоУмолчаниюВыбор", ЭтотОбъект);
	
	ПоказатьВопрос(Оповещение, НСтр("ru='Установить комментарий документов по умолчанию?'"), РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Да);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьИУстановитьКомментарийПоУмолчаниюВыбор(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = КодВозвратаДиалога.Да Тогда
		ШаблонКомментария = ШаблонКомментарияПоУмолчанию;
	КонецЕсли;
	
КонецПроцедуры

