Процедура ДобавитьУсловноеОформление_ВыделитьНесопоставленныеПоляОписи()
	
	ШаблонПредставление = НСтр("ru='Выделение несопоставленной колонки %1 в строке несопоставленной описи.'");
	
	ШаблонКолонкиВыделить = "ВыделитьКолонку%1";
	
	ИменаПолей = СтрРазделить("КФО,Счет,Сотрудник,ДатаИнвентаризации,ДатаНачала,ДатаОкончания"
		+ ",НомерКомиссии,НомерРабочейКомиссии,МестоИнвентаризации,КодФормы", ", ", Ложь);
	
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		НовыйЭлементУО = УсловноеОформление.Элементы.Добавить();
		НовыйЭлементУО.Представление = СтрШаблон(НСтр("ru='Выделение несопоставленной колонки %1 в строке несопоставленной описи.'"), ИмяПоля);
		
		ИмяКолонкиВыделить = СтрШаблон(ШаблонКолонкиВыделить, ИмяПоля);
		
		// Условие
		Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(СтрШаблон("ТаблицаНесопоставленныхОписей.%1", ИмяКолонкиВыделить));
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Условие.ПравоеЗначение = Истина;
		
		// Оформление
		НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветОсобогоТекста);
		
		// Оформляемые поля
		ОформляемоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ТаблицаНесопоставленныхОписей" + ИмяПоля);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьУсловноеОформление_СписокВыбораИзмененВручную()
	
	ИмяТаблицы = "ТаблицаРешения";
	
	ШрифтЖирный = Новый Шрифт(,, Истина);
	ЧерныйЦвет = Новый Цвет();
	
	// 1.
	НовыйЭлементУО = УсловноеОформление.Элементы.Добавить();
	НовыйЭлементУО.Представление = НСтр("ru='Вывод фактического списка выбора кода формы, если список выбора изменен вручную.'");
	
	// Условие
	Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяТаблицы + ".СписокВыбораИзмененВручную");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Истина;
	
	Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяТаблицы + ".КодФормыСозданиеВыбрано");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	
	// Оформление
	НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", Новый ПолеКомпоновкиДанных(ИмяТаблицы + ".КодФормыСозданиеВыбрано"));
	НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("Шрифт", ШрифтЖирный);
	НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЧерныйЦвет);
	
	// Оформляемые поля
	ОформляемоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТаблицы + "КодФормы");
	
	
	// 2.
	НовыйЭлементУО = УсловноеОформление.Элементы.Добавить();
	НовыйЭлементУО.Представление = НСтр("ru='Вывод кода формы при пустом списке выбора.'");
	
	// Условие
	Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяТаблицы + ".СписокВыбораИзмененВручную");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Истина;
	
	Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяТаблицы + ".КодФормыСозданиеВыбрано");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	// Оформление
	НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru='(не выбрано)'"));
	НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("Шрифт", ШрифтЖирный);
	НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЧерныйЦвет);
	
	// Оформляемые поля
	ОформляемоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТаблицы + "КодФормы");
	
КонецПроцедуры

#КонецОбласти

#Область СохраненныеНастройкиФормы

&НаСервере
Функция ЕстьСохраненныеНастройкиФормы()
	
	Отбор = Новый Структура();
	Отбор.Вставить("Пользователь", ПользователиИнформационнойБазы.ТекущийПользователь());
	Отбор.Вставить("КлючОбъекта", ИмяФормы + "/ТекущиеДанные");
	
	Выборка = ХранилищеСистемныхНастроек.Выбрать(Отбор);
	
	Пока Выборка.Следующий() Цикл
	    Возврат Истина;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Процедура ПрименитьЯвноУказанныеЗначенияПараметров()
	
	// Применяется для параметров с допустимыми значениями Неопределено, Истина, Ложь.
	
	ИменаПараметров = Новый Массив();
	ИменаПараметров.Добавить("ВыводитьТолькоФормируемыеКодыФорм");
	ИменаПараметров.Добавить("ИскатьОписиПоПриказу52н");
	
	Для Каждого ИмяПараметра Из ИменаПараметров Цикл
		ЗначениеУказаноЯвно = Параметры[ИмяПараметра] <> Неопределено;
		
		Если ЗначениеУказаноЯвно Тогда
			ЗаполнитьЗначенияСвойств(ЭтотОбъект, Параметры, ИмяПараметра);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОтборСтрокТаблицыРешения

&НаКлиенте
Процедура НастроитьОтборСтрокТаблицыРешения(ИмяКоманды)
	
	ЭлементКнопки = Элементы["ТаблицаРешения" + ИмяКоманды];
	
	ЭлементКнопки.Пометка = Не ЭлементКнопки.Пометка;
	
	НовыйОтборСтрок = Новый Структура(Элементы.ТаблицаРешения.ОтборСтрок);
	
	Если НовыйОтборСтрок = Неопределено Тогда
		НовыйОтборСтрок = Новый Структура();
	КонецЕсли;
	
	Если ИмяКоманды = "ПоказатьОшибки" Тогда
		ИмяСвойства = "ЕстьОшибка";
		
		Если ЭлементКнопки.Пометка Тогда
			НовыйОтборСтрок.Вставить(ИмяСвойства, Истина);
			
		ИначеЕсли НовыйОтборСтрок.Свойство(ИмяСвойства) Тогда
			НовыйОтборСтрок.Удалить(ИмяСвойства);
		КонецЕсли;
		
	ИначеЕсли ИмяКоманды = "ПоказатьСписокВыбораИзмененВручную" Тогда
		ИмяСвойства = "СписокВыбораИзмененВручную";
		
		Если ЭлементКнопки.Пометка Тогда
			НовыйОтборСтрок.Вставить(ИмяСвойства, Истина);
			
		ИначеЕсли НовыйОтборСтрок.Свойство(ИмяСвойства) Тогда
			НовыйОтборСтрок.Удалить(ИмяСвойства);
		КонецЕсли;

	// Эти команды отбора являются взаимоисключающими.
	ИначеЕсли ИмяКоманды = "ПоказатьОжидается"
		Или ИмяКоманды = "ПоказатьСозданПроведен"
		Или ИмяКоманды = "ПоказатьСозданНеПроведен"
		Или ИмяКоманды = "ПоказатьСозданЛюбой"
		Или ИмяКоманды = "ПоказатьНеПредусмотреноЗаконодательством"
		Или ИмяКоманды = "ПоказатьНеПредусмотреноОбработкой" Тогда
		НастроитьОтборСтрокТаблицыРешенияДляВзаимоисключающихКоманд(НовыйОтборСтрок, ИмяКоманды, ЭлементКнопки);
	КонецЕсли;
	
	Если НовыйОтборСтрок.Количество() > 0 Тогда
		НовыйОтборСтрок = Новый ФиксированнаяСтруктура(НовыйОтборСтрок);
	Иначе
		НовыйОтборСтрок = Неопределено;
	КонецЕсли;
	
	Элементы.ТаблицаРешения.ОтборСтрок = НовыйОтборСтрок;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьОтборСтрокТаблицыРешенияДляВзаимоисключающихКоманд(НовыйОтборСтрок, ИмяКоманды, ЭлементКнопки)
	
	Если ИмяКоманды = "ПоказатьОжидается"
		Или ИмяКоманды = "ПоказатьСозданПроведен"
		Или ИмяКоманды = "ПоказатьСозданНеПроведен"
		Или ИмяКоманды = "ПоказатьНеПредусмотреноЗаконодательством"
		Или ИмяКоманды = "ПоказатьНеПредусмотреноОбработкой" Тогда
		
		ИмяСвойства = "КодИндикатораОписи";
		
		Если ИмяКоманды = "ПоказатьОжидается" Тогда
			ЗначениеСвойства = СостоянияИндикатораОписи.Ожидается.Код;
			
		ИначеЕсли ИмяКоманды = "ПоказатьСозданПроведен" Тогда
			ЗначениеСвойства = СостоянияИндикатораОписи.ДокументСозданПроведен.Код;
			
		ИначеЕсли ИмяКоманды = "ПоказатьСозданНеПроведен" Тогда
			ЗначениеСвойства = СостоянияИндикатораОписи.ДокументСозданНеПроведен.Код;
			
		ИначеЕсли ИмяКоманды = "ПоказатьНеПредусмотреноЗаконодательством" Тогда
			ЗначениеСвойства = СостоянияИндикатораОписи.НеПредусмотреноЗаконодательством.Код;
			
		ИначеЕсли ИмяКоманды = "ПоказатьНеПредусмотреноОбработкой" Тогда
			ЗначениеСвойства = СостоянияИндикатораОписи.НеПредусмотреноОбработкой.Код;
		КонецЕсли;
		
		ИмяСвойстваКор = "ЕстьСопоставленныеОписи";
		
	ИначеЕсли ИмяКоманды = "ПоказатьСозданЛюбой" Тогда
		
		ИмяСвойства = "ЕстьСопоставленныеОписи";
		ЗначениеСвойства = Истина;
		
		ИмяСвойстваКор = "КодИндикатораОписи";
	КонецЕсли;
	
	Если ЭлементКнопки.Пометка Тогда
		НовыйОтборСтрок.Вставить(ИмяСвойства, ЗначениеСвойства);
		
		СнятьПометкуКнопокОтбораСтрокСостоянияИндикатораОписи(ИмяКоманды);
		
		Если НовыйОтборСтрок.Свойство(ИмяСвойстваКор) Тогда
			НовыйОтборСтрок.Удалить(ИмяСвойстваКор);
		КонецЕсли;
		
	ИначеЕсли НовыйОтборСтрок.Свойство(ИмяСвойства) Тогда
		НовыйОтборСтрок.Удалить(ИмяСвойства);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьПометкуКнопокОтбораСтрокСостоянияИндикатораОписи(ИмяИсключаемойКнопки)
	
	ИменаКнопок = СтрРазделить(
		"ПоказатьОжидается,ПоказатьСозданПроведен,ПоказатьСозданНеПроведен,ПоказатьСозданЛюбой"
		+ ",ПоказатьНеПредусмотреноЗаконодательством,ПоказатьНеПредусмотреноОбработкой",
		", ", Ложь);
	
	Индекс = ИменаКнопок.Найти(ИмяИсключаемойКнопки);
	
	ИменаКнопок.Удалить(Индекс);
	
	Для Каждого ИмяКнопки Из ИменаКнопок Цикл
		Элементы["ТаблицаРешения" + ИмяКнопки].Пометка = Ложь;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТаблицыРешения

&НаКлиенте
Процедура ПоказатьСписокДокументовОписей(СтрокаТаблицы)
	
	Список = Новый СписокЗначений();
	
	Для Каждого ОписаниеОписи Из СтрокаТаблицы.МассивОписанийОписей Цикл
		КартинкаОписи = ?(ОписаниеОписи.Проведен, БиблиотекаКартинок.Провести, БиблиотекаКартинок.Документ);
		
		НовыйЭлемент = Список.Добавить(ОписаниеОписи.Ссылка,,, КартинкаОписи);
	КонецЦикла;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыбранДокументОписиИзСписка", ЭтотОбъект);
	
	ПоказатьВыборИзСписка(ОписаниеОповещения, Список, Элементы.ТаблицаРешенияПредставлениеОписи);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбранДокументОписиИзСписка(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьЗначение(, ВыбранныйЭлемент.Значение);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВыбранныеКодыФормВСтрокеТаблицы(СтрокаТаблицы)
	
	Если СтрокаТаблицы.МассивКодовФормСозданиеНеобходимо.Количество() <= 1 Тогда
		// Выбирать тут нечего.
		Возврат;
	КонецЕсли;
	
	КодыФормОписей = ПолучитьКодыФормОписейВСтрокеТаблицы(СтрокаТаблицы);
	
	СписокВыбора = Новый СписокЗначений();
	
	Для Каждого КодФормы Из СтрокаТаблицы.МассивКодовФормСозданиеПредусмотрено Цикл
		КодВыбран = (СтрокаТаблицы.МассивКодовФормСозданиеВыбрано.Найти(КодФормы) <> Неопределено);
		
		НовыйЭлемент = СписокВыбора.Добавить(КодФормы,, КодВыбран);
	КонецЦикла;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("СтрокаТаблицы", СтрокаТаблицы);
	
	Оповещение = Новый ОписаниеОповещения("ПоказатьВыбранныеКодыФормВСтрокеТаблицыВыбор", ЭтотОбъект, ДополнительныеПараметры);
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("СписокВыбора", СписокВыбора);
	ПараметрыФормы.Вставить("КодыФормОписей", КодыФормОписей);
	ПараметрыФормы.Вставить("КодыФормНетПрав", МассивКодовФормНетПрав);
	ПараметрыФормы.Вставить("ОтборМассивКодовФорм", ОтборМассивКодовФорм);
	
	ОткрытьФорму("ОбщаяФорма.ПометкиКодовФормОписей", ПараметрыФормы, ЭтотОбъект,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВыбранныеКодыФормВСтрокеТаблицыВыбор(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьДоступныеНеПомеченные	= ВыбранноеЗначение.ЕстьДоступныеНеПомеченные;
	ПомеченныеКодыФорм			= ВыбранноеЗначение.ПомеченныеКодыФорм;
	
	СтрокаТаблицы = ДополнительныеПараметры.СтрокаТаблицы;
	
	СтрокаТаблицы.МассивКодовФормСозданиеВыбрано = Новый ФиксированныйМассив(ПомеченныеКодыФорм);
	СтрокаТаблицы.КодФормыСозданиеВыбрано = СтрСоединить(ПомеченныеКодыФорм, ", ");
	
	КоличествоКодов = ПомеченныеКодыФорм.Количество();
	
	Если КоличествоКодов = 0 Тогда
		СтрокаТаблицы.Отметка = Ложь;
	КонецЕсли;
	
	СтрокаТаблицы.ОтметкаДоступна = (КоличествоКодов > 0);
	
	СтрокаТаблицы.СписокВыбораИзмененВручную = ЕстьДоступныеНеПомеченные;
	
	// Кнопка отбора строк таблицы Решения.
	Если ЕстьДоступныеНеПомеченные Тогда
		Элементы.ТаблицаРешенияПоказатьСписокВыбораИзмененВручную.Видимость = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьКодыФормОписейВСтрокеТаблицы(СтрокаТаблицы)
	
	КодыФормОписей = Новый Массив();
	
	Для Каждого ОписаниеОписи Из СтрокаТаблицы.МассивОписанийОписей Цикл
		КодФормы = ОписаниеОписи.КодФормы;
		
		Если КодыФормОписей.Найти(КодФормы) = Неопределено Тогда
			КодыФормОписей.Добавить(КодФормы);
		КонецЕсли;
	КонецЦикла;
	
	Возврат КодыФормОписей;
	
КонецФункции

&НаКлиенте
Процедура ПоказатьСообщениеОбОтсутствииПравСозданияОписи(СтрокаТаблицы)
	
	КодыФормОписей = ПолучитьКодыФормОписейВСтрокеТаблицы(СтрокаТаблицы);
	
	СозданиеНеобходимо = ОбщегоНазначенияКлиентСервер.РазностьМассивов(
		СтрокаТаблицы.МассивКодовФормСозданиеПредусмотрено, КодыФормОписей);
	
	Если УстановленОтборПоКодуФормы Тогда
		СозданиеНеобходимо = ОбщегоНазначенияИСКлиентСервер.ПересечениеМассивов(СозданиеНеобходимо, ОтборМассивКодовФорм);
	КонецЕсли;
	
	МассивКодов = ОбщегоНазначенияИСКлиентСервер.ПересечениеМассивов(СозданиеНеобходимо, МассивКодовФормНетПрав);
	
	КоличествоКодов = МассивКодов.Количество();
	
	Если КоличествоКодов = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если КоличествоКодов = 1 Тогда
		Шаблон = НСтр("ru='описи %1'");
		
	ИначеЕсли КоличествоКодов > 1 Тогда
		Шаблон = НСтр("ru='описей %1'");
	КонецЕсли;
	
	ТекстКодыФорм = СтрШаблон(Шаблон, СтрСоединить(МассивКодов, ", "));
	
	ТекстСообщения = СтрШаблон(НСтр("ru='Отсутствует право создания %1.'"), ТекстКодыФорм);
	
	ПоказатьПредупреждение(, ТекстСообщения);
	
КонецПроцедуры

#КонецОбласти

#Область ОтметкаСтрок

&НаКлиенте
Процедура ПроверитьИУстановитьЗначениеОтметки(ЗначениеОтметки)
	
	ВыделенныеСтроки = Элементы.ТаблицаРешения.ВыделенныеСтроки;
	
	КоличествоВыделенных = ВыделенныеСтроки.Количество();
	
	Если КоличествоВыделенных = 0 Или КоличествоВыделенных = 1 Тогда
		УстановитьЗначениеОтметки(ЗначениеОтметки, Неопределено, Истина);
	Иначе
		УстановитьЗначениеОтметки(ЗначениеОтметки, ВыделенныеСтроки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗначениеОтметки(ЗначениеОтметки, ВыделенныеСтроки, ОбработатьВсеСтроки = Ложь)
	
	Если ОбработатьВсеСтроки Тогда
		// Некоторые строки могут быть не видны из-за установленной строки поиска или расширенного поиска.
		// Определить этот факт на сервере нельзя, поэтому видимые строки определятся только на клиенте.
		// Да, это может работать медленно.
		
		ЭлементТаблицаРешения = Элементы.ТаблицаРешения;
		
		Для Каждого СтрокаТаблицы Из ТаблицаРешения Цикл
			Если ЭлементТаблицаРешения.ПроверитьСтроку(СтрокаТаблицы.ПолучитьИдентификатор()) <> Истина Тогда
				Продолжить;
			КонецЕсли;
			
			Если СтрокаТаблицы.ОтметкаДоступна Тогда
				СтрокаТаблицы.Отметка = ЗначениеОтметки;
			КонецЕсли;
		КонецЦикла;
		
		Возврат;
	КонецЕсли;	
	
	ОграничениеКлиента = 200;
		
	КоличествоВыделенныхСтрок = ВыделенныеСтроки.Количество();
	
	Если КоличествоВыделенныхСтрок > ОграничениеКлиента Тогда
		УстановитьЗначениеОтметкиСервер(ЗначениеОтметки, ВыделенныеСтроки);
	Иначе
		УстановитьЗначениеОтметкиКлиент(ЗначениеОтметки, ВыделенныеСтроки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗначениеОтметкиКлиент(ЗначениеОтметки, ВыделенныеСтроки)
	
	УстановитьЗначениеОтметкиКлиентСервер(ЗначениеОтметки, ВыделенныеСтроки, ТаблицаРешения);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗначениеОтметкиСервер(ЗначениеОтметки, Знач ВыделенныеСтроки) // Знач из-за серверного вызова.
	
	УстановитьЗначениеОтметкиКлиентСервер(ЗначениеОтметки, ВыделенныеСтроки, ТаблицаРешения);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗначениеОтметкиКлиентСервер(ЗначениеОтметки, ВыделенныеСтроки, ТаблицаРешения)
	
	Для Каждого ИдСтроки Из ВыделенныеСтроки Цикл
		СтрокаТаблицы = ТаблицаРешения.НайтиПоИдентификатору(ИдСтроки);
		
		Если СтрокаТаблицы.ОтметкаДоступна Тогда
			СтрокаТаблицы.Отметка = ЗначениеОтметки;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

