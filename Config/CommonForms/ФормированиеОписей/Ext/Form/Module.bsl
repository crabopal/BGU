&НаСервере
Функция НовыйНастройкиОбъединенияСтрокНаФорме()
	
	// Все коды форм, для которых предусмотрена та или иная группировка строк.
	ОбщийСписокКодовФорм = СтрРазделить("0510466,0510468,0510469,0510471,0510472,0510473,0510474", ", ", Ложь);
	
	НастройкиОбъединения = Новый Структура();
	НастройкиОбъединения.Вставить("ОбщийСписокКодовФорм", ОбщийСписокКодовФорм);
	НастройкиОбъединения.Вставить("ПоСчетам", ОбщийСписокКодовФорм);
	НастройкиОбъединения.Вставить("ПоМестамИнвентаризации", СтрРазделить("0510466", ", ", Ложь));
	
	Возврат НастройкиОбъединения;
	
КонецФункции

