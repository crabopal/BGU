&НаКлиенте
Процедура ТаблицаНесопоставленныхОписейВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СтрокаТаблицы = ТаблицаНесопоставленныхОписей.НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	ИмяПоля = СтрЗаменить(Поле.Имя, "ТаблицаНесопоставленныхОписей", "");
	
	Если ИмяПоля = "ПредставлениеОписи" Тогда
		ПоказатьЗначение(, СтрокаТаблицы.ОписьСсылка);
	КонецЕсли;
	
	Если ИмяПоля = "Комментарий" Тогда
		Если ЗначениеЗаполнено(СтрокаТаблицы.Комментарий) Тогда
			ПоказатьТекстовуюСтроку(СтрокаТаблицы.Комментарий, НСтр("ru='Комментарий'"));
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

