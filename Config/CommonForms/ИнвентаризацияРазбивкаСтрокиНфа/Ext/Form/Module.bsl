#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СохранятьИтоги = Истина;
	
	РассчитыватьСуммыПоЦене = Истина;
	
	ИтогОписаниеСтроки = НСтр("ru='Итого'");
	
	ЗагрузитьРазбиваемуюСтроку();
	
	ЗаполнитьНачальныеИтоги();
	
	УстановитьТочностьКоличества();
	
	УстановитьУсловноеОформление();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьОписанияСтрок();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СохранятьИтогиПриИзменении(Элемент)
	
	ПересчитатьТаблицу();
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитыватьСуммыПоЦенеПриИзменении(Элемент)
	
	ПересчитатьТаблицу();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_Таблица

&НаКлиенте
Процедура ТаблицаПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	МаксимальноеКоличествоСтрок = 10;
	
	Если Таблица.Количество() >= МаксимальноеКоличествоСтрок Тогда
		Отказ = Истина;
		
		ПоказатьПредупреждение(,СтрШаблон(НСтр("ru='Достигнуто максимальное количество строк (%1)'"), МаксимальноеКоличествоСтрок));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПередУдалением(Элемент, Отказ)
	
	ТекДанные = Элементы.Таблица.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекДанные.ЭтоНоваяСтрока Тогда

		Если Таблица.Количество() < 3 Тогда
			Отказ = Истина;
			
			ПоказатьПредупреждение(,НСтр("ru='Не допускается удаление единственной новой строки.
				|После разбивки исходной строки должно получиться минимум две строки.'"));
		КонецЕсли;
		
	Иначе
		Отказ = Истина;
		
		ПоказатьПредупреждение(,НСтр("ru='Не допускается удаление разбиваемой строки'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекДанные = Элементы.Таблица.ТекущиеДанные;
	
	Если НоваяСтрока Тогда
		ТекДанные.ЭтоНоваяСтрока = Истина;
		
		УстановитьОписаниеСтроки(ТекДанные);
		
		ПересчитатьТаблицу();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПослеУдаления(Элемент)
	
	ПересчитатьТаблицу();
	
КонецПроцедуры


&НаКлиенте
Процедура ТаблицаКоличествоФактПриИзменении(Элемент)
	
	ОбработатьИзменениеЧисловойКолонки("КоличествоФакт");
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСуммаФактПриИзменении(Элемент)
	
	ОбработатьИзменениеЧисловойКолонки("СуммаФакт");
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаКоличествоУчетПриИзменении(Элемент)
	
	ОбработатьИзменениеЧисловойКолонки("КоличествоУчет");
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСуммаУчетПриИзменении(Элемент)
	
	ОбработатьИзменениеЧисловойКолонки("СуммаУчет");
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаКоличествоНеСоответствуетПриИзменении(Элемент)
	
	ОбработатьИзменениеЧисловойКолонки("КоличествоНеСоответствует");
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСуммаНеСоответствуетПриИзменении(Элемент)
	
	ОбработатьИзменениеЧисловойКолонки("СуммаНеСоответствует");
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСтатусОбъектаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОткрытьФорму("Справочник.СтатусыОбъектовДляИнвентаризации.ФормаВыбора",,Элемент,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаЦелеваяФункцияАктиваНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОткрытьФорму("Справочник.ЦелевыеФункцииАктивовДляИнвентаризации.ФормаВыбора",,Элемент,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	
	ВозвращаемоеЗначение = ПолучитьВозвращаемоеЗначение();
	
	Закрыть(ВозвращаемоеЗначение);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИменаЧисловыхКолонокСтрокой()
	
	Возврат СтрСоединить(ИменаЧисловыхКолонок(), ",");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИменаЧисловыхКолонок()
	
	Результат = Новый Массив();
	Результат.Добавить("СуммаНеСоответствует");
	Результат.Добавить("КоличествоФакт");
	Результат.Добавить("СуммаФакт");
	Результат.Добавить("КоличествоУчет");
	Результат.Добавить("СуммаУчет");
	Результат.Добавить("КоличествоНеСоответствует");
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	ШрифтЖирный = Новый Шрифт(,,Истина);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Выделение разбиваемой строки'");

	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Таблица.ЭтоНоваяСтрока");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Ложь;
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Шрифт", ШрифтЖирный);

	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ТаблицаОписаниеСтроки");

КонецПроцедуры

&НаСервере
Процедура УстановитьТочностьКоличества()
	
	ФорматКоличества = СтрШаблон("ЧДЦ=%1", Параметры.ТочностьКоличества);
	
	Элементы.ТаблицаКоличествоФакт.Формат				= Формат(ФорматКоличества);
	Элементы.ТаблицаКоличествоУчет.Формат				= Формат(ФорматКоличества);
	Элементы.ТаблицаКоличествоНеСоответствует.Формат	= Формат(ФорматКоличества);
	
	Элементы.ТаблицаКоличествоФакт.ФорматРедактирования				= Формат(ФорматКоличества);
	Элементы.ТаблицаКоличествоУчет.ФорматРедактирования				= Формат(ФорматКоличества);
	Элементы.ТаблицаКоличествоНеСоответствует.ФорматРедактирования	= Формат(ФорматКоличества);
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьРазбиваемуюСтроку()
	
	Если ТипЗнч(Параметры.РазбиваемаяСтрока) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Таблица.Очистить();
	
	ОчищающаяСтруктура = Новый Структура(ИменаЧисловыхКолонокСтрокой());
	
	// Разбиваемая строка
	
	НоваяСтрока = Таблица.Добавить();
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Параметры.РазбиваемаяСтрока);
	
	// Новая строка
	
	НоваяСтрока = Таблица.Добавить();
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Параметры.РазбиваемаяСтрока);
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ОчищающаяСтруктура);
	
	НоваяСтрока.ЭтоНоваяСтрока = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНачальныеИтоги()
	
	ВремИтоги = Новый Структура(ИменаЧисловыхКолонокСтрокой());
	
	Если ТипЗнч(Параметры.РазбиваемаяСтрока) = Тип("Структура") Тогда
		
		ЗаполнитьЗначенияСвойств(ВремИтоги, Параметры.РазбиваемаяСтрока);
		
	КонецЕсли;
	
	НачальныеИтоги = Новый ФиксированнаяСтруктура(ВремИтоги);
	
	Для Каждого Элемент Из НачальныеИтоги Цикл
		ЭтаФорма["Итог" + Элемент.Ключ] = Элемент.Значение;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьВозвращаемоеЗначение()
	
	Результат = Новый Массив();
	
	СтруктураСтроки = Новый Структура("
		|КоличествоНеСоответствует,
		|СуммаНеСоответствует,
		|КоличествоФакт,
		|СуммаФакт,
		|КоличествоУчет,
		|СуммаУчет,
		|СтатусОбъекта,
		|ЦелеваяФункцияАктива,
		|Примечание,
		|ЭтоНоваяСтрока");
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		ЗаполнитьЗначенияСвойств(СтруктураСтроки, СтрокаТаблицы);
		
		Результат.Добавить(Новый ФиксированнаяСтруктура(СтруктураСтроки));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОбработатьИзменениеЧисловойКолонки(ИмяКолонки)
	
	ТекДанные = Элементы.Таблица.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗначениеПоказателя = ТекДанные[ИмяКолонки];
	
	Если СохранятьИтоги Тогда
		
		Если ЗначениеПоказателя > НачальныеИтоги[ИмяКолонки] Тогда
			ЗначениеПоказателя = НачальныеИтоги[ИмяКолонки];
			
			ТекДанные[ИмяКолонки] = ЗначениеПоказателя;
		КонецЕсли;
		
		РассчитатьКолонкуССохранениемИтогов(ИмяКолонки, Элементы.Таблица.ТекущаяСтрока);
		
	КонецЕсли;
	
	ЭтаФорма["Итог" + ИмяКолонки] = Таблица.Итог(ИмяКолонки);
	
	Если РассчитыватьСуммыПоЦене Тогда
		
		ПараметрыРасчетаСуммы = ПолучитьПараметрыРасчетаСуммы(ИмяКолонки);
		
		РассчитатьСуммуПоЦене(ТекДанные, ПараметрыРасчетаСуммы);
		
		ИмяКолонкиСумма = ПараметрыРасчетаСуммы.ИмяКолонкиСумма;
		
		Если СохранятьИтоги Тогда
			ЗначениеПоказателя = ТекДанные[ИмяКолонкиСумма];
			
			Если ЗначениеПоказателя > НачальныеИтоги[ИмяКолонкиСумма] Тогда
				ЗначениеПоказателя = НачальныеИтоги[ИмяКолонкиСумма];
				
				ТекДанные[ИмяКолонкиСумма] = ЗначениеПоказателя;
			КонецЕсли;
			
			РассчитатьКолонкуССохранениемИтогов(ИмяКолонкиСумма, Элементы.Таблица.ТекущаяСтрока);
		КонецЕсли;
		
		ЭтаФорма["Итог" + ИмяКолонкиСумма] = Таблица.Итог(ИмяКолонкиСумма);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьОбозначениеПоИмениКолонки(ИмяКолонки)
	
	Если ИмяКолонки = "КоличествоФакт" Или ИмяКолонки = "СуммаФакт" Тогда
		Возврат "Факт";
		
	ИначеЕсли ИмяКолонки = "КоличествоУчет" Или ИмяКолонки = "СуммаУчет" Тогда
		Возврат "Учет";
		
	ИначеЕсли ИмяКолонки = "КоличествоНеСоответствует" Или ИмяКолонки = "СуммаНеСоответствует" Тогда
		Возврат "НеСоответствует";
		
	Иначе
		Возврат "";
	КонецЕсли;
		
КонецФункции
		
&НаКлиенте
Функция ПолучитьПараметрыРасчетаСуммы(ИмяКолонки)
	
	Обозначение = ПолучитьОбозначениеПоИмениКолонки(ИмяКолонки);
	
	ИмяКолонкиКоличество	= "Количество" + Обозначение;
	ИмяКолонкиСумма			= "Сумма" + Обозначение;
	
	Если Обозначение = "Факт" Тогда
		НачальныйИтогКоличество	= НачальныеИтоги.КоличествоФакт;
		НачальныйИтогСумма		= НачальныеИтоги.СуммаФакт;
		
		Цена = ?(НачальныйИтогКоличество = 0, 0, Окр(НачальныйИтогСумма/НачальныйИтогКоличество, Параметры.ТочностьЦены));
	Иначе
		НачальныйИтогКоличество	= НачальныеИтоги.КоличествоУчет;
		НачальныйИтогСумма		= НачальныеИтоги.СуммаУчет;
		
		Цена = ?(НачальныйИтогКоличество = 0, 0, НачальныйИтогСумма/НачальныйИтогКоличество);
	КонецЕсли;
	
	ПараметрыРасчетаСуммы = Новый Структура();
	ПараметрыРасчетаСуммы.Вставить("Цена",					Цена);
	ПараметрыРасчетаСуммы.Вставить("ИмяКолонкиКоличество",	ИмяКолонкиКоличество);
	ПараметрыРасчетаСуммы.Вставить("ИмяКолонкиСумма",		ИмяКолонкиСумма);
	
	Возврат ПараметрыРасчетаСуммы;
	
КонецФункции

&НаКлиенте
Процедура РассчитатьСуммуПоЦене(СтрокаТаблицы, ПараметрыРасчетаСуммы)
	
	СтрокаТаблицы[ПараметрыРасчетаСуммы.ИмяКолонкиСумма] = Окр(СтрокаТаблицы[ПараметрыРасчетаСуммы.ИмяКолонкиКоличество] * ПараметрыРасчетаСуммы.Цена, 2);
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьКолонкуССохранениемИтогов(ИмяКолонки, ТекущаяСтрока = Неопределено)
	
	Перем ПоследняяСтрока, ПараметрыРасчетаСуммы;
	
	ЦелевойИтог = НачальныеИтоги[ИмяКолонки];
	
	УказанаТекущаяСтрока = (ТекущаяСтрока <> Неопределено);
	
	Если УказанаТекущаяСтрока Тогда
		ВведенноеЗначение = Таблица.НайтиПоИдентификатору(ТекущаяСтрока)[ИмяКолонки];
		
		Остаток = ЦелевойИтог - ВведенноеЗначение;
	Иначе
		Остаток = ЦелевойИтог;
	КонецЕсли;
	
	Если РассчитыватьСуммыПоЦене И (ИмяКолонки = "СуммаФакт" Или ИмяКолонки = "СуммаУчет" Или ИмяКолонки = "СуммаНеСоответствует") Тогда
		ПараметрыРасчетаСуммы = ПолучитьПараметрыРасчетаСуммы(ИмяКолонки);
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		
		Если УказанаТекущаяСтрока И СтрокаТаблицы.ПолучитьИдентификатор() = ТекущаяСтрока Тогда
			Продолжить;
		КонецЕсли;
		
		ПоследняяСтрока = СтрокаТаблицы;
		
		Если ПараметрыРасчетаСуммы <> Неопределено Тогда
			РассчитатьСуммуПоЦене(СтрокаТаблицы, ПараметрыРасчетаСуммы);
		КонецЕсли;
		
		Если СтрокаТаблицы[ИмяКолонки] > Остаток Тогда
			СтрокаТаблицы[ИмяКолонки] = Остаток;
		КонецЕсли;
		
		Остаток = Остаток - СтрокаТаблицы[ИмяКолонки];
		
	КонецЦикла;
	
	ПоследняяСтрока[ИмяКолонки] = ПоследняяСтрока[ИмяКолонки] + Остаток;
	
КонецПроцедуры	

&НаКлиенте
Процедура РассчитатьКолонкуСуммыПоЦене(ИмяКолонки)
	
	ПараметрыРасчетаСуммы = ПолучитьПараметрыРасчетаСуммы(ИмяКолонки);

	Для Каждого СтрокаТаблицы Из Таблица Цикл
		РассчитатьСуммуПоЦене(СтрокаТаблицы, ПараметрыРасчетаСуммы);
	КонецЦикла;
	
КонецПроцедуры	

&НаКлиенте
Процедура УстановитьОписаниеСтроки(СтрокаТаблицы)
	
	Если СтрокаТаблицы.ЭтоНоваяСтрока Тогда
		ОписаниеСтроки = НСтр("ru='Новая строка'");
	Иначе
		ОписаниеСтроки = НСтр("ru='Разбиваемая строка'");
	КонецЕсли;
	
	СтрокаТаблицы.ОписаниеСтроки = ОписаниеСтроки;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОписанияСтрок()
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		
		УстановитьОписаниеСтроки(СтрокаТаблицы);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьТаблицу()
	
	ИменаКолонок = ИменаЧисловыхКолонок();
	
	Для Каждого ИмяКолонки Из ИменаКолонок Цикл
		
		Если СохранятьИтоги Тогда
			РассчитатьКолонкуССохранениемИтогов(ИмяКолонки);
			
			ЭтаФорма["Итог" + ИмяКолонки] = Таблица.Итог(ИмяКолонки);
			
			Продолжить;
		КонецЕсли;
		
		Если РассчитыватьСуммыПоЦене И (ИмяКолонки = "СуммаФакт" Или ИмяКолонки = "СуммаУчет" Или ИмяКолонки = "СуммаНеСоответствует") Тогда
			РассчитатьКолонкуСуммыПоЦене(ИмяКолонки);
		КонецЕсли;
		
		ЭтаФорма["Итог" + ИмяКолонки] = Таблица.Итог(ИмяКолонки);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
