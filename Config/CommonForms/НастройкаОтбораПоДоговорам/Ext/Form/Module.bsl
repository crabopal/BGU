
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ПараметрыОтбора", ПараметрыОтбора);
	Параметры.Свойство("Отбор", АдресОтбора);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаОтбор", ПолучитьИзВременногоХранилища(АдресОтбора));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Отбор.Договор КАК Договор,
	|	Отбор.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ ВТ_Отбор
	|ИЗ
	|	&ТаблицаОтбор КАК Отбор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Отбор.НомерСтроки КАК НомерСтроки,
	|	Отбор.Договор КАК Договор,
	|	ИСТИНА КАК Пометка
	|ИЗ
	|	ВТ_Отбор КАК Отбор
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Таблица.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Оповещение = Новый ОписаниеОповещения("ЗаписатьИЗакрытьЗавершение", ЭтотОбъект);
	ОбщегоНазначенияКлиент.ПоказатьПодтверждениеЗакрытияФормы(Оповещение, Отказ, ЗавершениеРаботы);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура УстановитьОтбор(Команда)
	
	ЗаписатьИЗакрытьЗавершение();
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьОтбор(Команда)
	
	Таблица.Очистить();
	
	ЗаписатьИЗакрытьЗавершение();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьАвто(Команда)
	
	Если Таблица.Количество() > 0 Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьАвтоЗавершение", ЭтотОбъект),
			НСтр("ru='Таблица будет очищена. Продолжить выполнение операции?'"),
			РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да, НСтр("ru='Отбор по договорам'"));
		Возврат;
	КонецЕсли;
	
	ЗаполнитьДоговорыНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьАвтоЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Таблица.Очистить();
	
	ЗаполнитьДоговорыНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлажки(Команда)
	
	Для Каждого СтрокаОтбора Из Таблица Цикл
		СтрокаОтбора.Пометка = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажки(Команда)
	
	Для Каждого СтрокаОтбора Из Таблица Цикл
		СтрокаОтбора.Пометка = Ложь;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗаписатьИЗакрытьЗавершение(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если Модифицированность Тогда
		
		Модифицированность = Ложь;
		ПомеситьОтборВХранилище();
		ОповеститьОВыборе(АдресОтбора);
		
	Иначе
		
		Закрыть();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПомеситьОтборВХранилище()
	
	Отбор = Новый Структура("Пометка", Истина);
	ПоместитьВоВременноеХранилище(Таблица.Выгрузить(Отбор), АдресОтбора);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДоговорыНаКлиенте()
	
	ВладелецИмяФормы = ЭтотОбъект.ВладелецФормы.ИмяФормы;
	Если СтрНайти(ВладелецИмяФормы, "НачислениеАмортизацииПравПользованияОС") > 0 Тогда
		ЗаполнитьДоговорыНаСервере("НачислениеАмортизацииПравПользованияОС");
	ИначеЕсли СтрНайти(ВладелецИмяФормы, "ПрекращениеПравПользованияОС") > 0 Тогда
		ЗаполнитьДоговорыНаСервере("ПрекращениеПравПользованияОС");
	ИначеЕсли СтрНайти(ВладелецИмяФормы, "СписаниеДоходовБудущихПериодов") > 0 Тогда
		ЗаполнитьДоговорыНаСервере("СписаниеДоходовБудущихПериодов");
	ИначеЕсли СтрНайти(ВладелецИмяФормы, "СправкаОбОплатеУслугДляНалоговогоВычета") > 0 Тогда
		ЗаполнитьДоговорыДляСправкиФНС("СправкаОбОплатеУслугДляНалоговогоВычета");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДоговорыНаСервере(ВидДокумента)
	
	Запрос = Новый Запрос;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация"	, ПараметрыОтбора.Организация);
	Запрос.УстановитьПараметр("КонецПериода", Новый Граница(КонецМесяца(ПараметрыОтбора.Дата), ВидГраницы.Включая));
	
	Если ВидДокумента = "НачислениеАмортизацииПравПользованияОС"
		ИЛИ ВидДокумента = "ПрекращениеПравПользованияОС" Тогда
		
		Запрос.УстановитьПараметр("СчетОстатков",
			БухгалтерскийУчет.СписокСчетов("111.40", ПараметрыОтбора.Дата));
		
	ИначеЕсли ВидДокумента = "СписаниеДоходовБудущихПериодов" Тогда
		
		Запрос.УстановитьПараметр("СчетОстатков",
			БухгалтерскийУчет.СписокСчетов("401.40,401.41", ПараметрыОтбора.Дата));
		
	КонецЕсли;
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ВЫРАЗИТЬ(ПраваПользованияОстатки.Субконто1 КАК Справочник.Договоры) КАК Договор
	|ПОМЕСТИТЬ Договоры
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&КонецПериода,
	|			Счет В (&СчетОстатков),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Договоры),
	|			Организация = &Организация
	|				И &УсловиеИФО
	|				И &УсловиеКФО
	|				И &УсловиеКонтрагент) КАК ПраваПользованияОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИСТИНА КАК Пометка,
	|	Договоры.Договор КАК Договор
	|ИЗ
	|	Договоры КАК Договоры";
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") И ЗначениеЗаполнено(ПараметрыОтбора.ИФО) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИФО = &ИФО");
		Запрос.УстановитьПараметр("ИФО", ПараметрыОтбора.ИФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыОтбора.КФО) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "КФО = &КФО");
		Запрос.УстановитьПараметр("КФО", ПараметрыОтбора.КФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "ИСТИНА" );
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыОтбора.Контрагент) Тогда
		Если ПараметрыОтбора.Контрагент.ЭтоГруппа Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтрагент",
				"ВЫРАЗИТЬ(Субконто1 КАК Справочник.Договоры).Контрагент В ИЕРАРХИИ (&Контрагент)");
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтрагент",
				"ВЫРАЗИТЬ(Субконто1 КАК Справочник.Договоры).Контрагент = &Контрагент");
		КонецЕсли;
		Запрос.УстановитьПараметр("Контрагент", ПараметрыОтбора.Контрагент);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтрагент", "ИСТИНА" );
	КонецЕсли;
	
	Результат = Запрос.Выполнить().Выгрузить();
	Таблица.Загрузить(Результат);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДоговорыДляСправкиФНС(ВидДокумента)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация"	, ПараметрыОтбора.Организация);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоГода(ПараметрыОтбора.Дата));
	Запрос.УстановитьПараметр("КонецПериода", Новый Граница(КонецГода(ПараметрыОтбора.Дата), ВидГраницы.Включая));
	
	Если ВидДокумента = "СправкаОбОплатеУслугДляНалоговогоВычета" Тогда
		
		Запрос.УстановитьПараметр("СчетРасчетов",
			БухгалтерскийУчет.СписокСчетов("205.31", ПараметрыОтбора.Дата));
		
	КонецЕсли;
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОбороты.Субконто1 КАК Справочник.Договоры) КАК Договор
	|ПОМЕСТИТЬ Договоры
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			,
	|			Счет В (&СчетРасчетов),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Договоры),
	|			Организация = &Организация
	|				И &УсловиеКонтрагент,
	|			,
	|			) КАК ЖурналПроводокЕПСБУОбороты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИСТИНА КАК Пометка,
	|	Договоры.Договор КАК Договор
	|ИЗ
	|	Договоры КАК Договоры";
	
	Если ЗначениеЗаполнено(ПараметрыОтбора.Контрагент) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтрагент",
				"ВЫРАЗИТЬ(Субконто1 КАК Справочник.Договоры).Контрагент В (&СписокКонтрагенты)");
		Запрос.УстановитьПараметр("СписокКонтрагенты", ПараметрыОтбора.Контрагент);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКонтрагент", "ИСТИНА" );
	КонецЕсли;
	
	Результат = Запрос.Выполнить().Выгрузить();
	Таблица.Загрузить(Результат);
	
КонецПроцедуры

#КонецОбласти
