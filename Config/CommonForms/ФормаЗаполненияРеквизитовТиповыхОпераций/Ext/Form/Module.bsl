
#Область ОписаниеПеременных

&НаСервере
Перем ДеревоРеквизитовОпераций;

&НаСервере
Перем ТабРеквизитов;

&НаСервере
Перем ТабФОРеквизитов;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Перем ТолькоПросмотр;
	
	ЭтоДанныеВыписки = Ложь;
	
	СписокДокументов = Параметры.СписокДокументов;
	
	ТолькоПросмотр = НЕ ПравоДоступа("Изменение", Метаданные.РегистрыБухгалтерии.ЖурналПроводокЕПСБУ);
	
	// Дату запрета изменения проверяем для выписки, считаем, что у выписки и документов, входящих в 
	// выписку не может быть разных дат запрета.
	Если Общегоназначения.СсылкаСуществует(Параметры.ВыпискаСсылка) Тогда
		ТолькоПросмотр = ТолькоПросмотр ИЛИ ДатыЗапретаИзменения.ИзменениеЗапрещено("Документ.ВыпискаИзЛицевогоСчета", Параметры.ВыпискаСсылка);
		ЭтоДанныеВыписки = Истина;
	КонецЕсли;	
	
	Для Каждого Док Из СписокДокументов Цикл
		Если НЕ ЗначениеЗаполнено(Док.Значение) Тогда
			Продолжить;
		КонецЕсли;
		Если ТаблицаДокументов.НайтиСтроки(Новый Структура("Документ",Док.Значение)).Количество()=0 Тогда
			НовСтр = ТаблицаДокументов.Добавить();
			НовСтр.Документ = Док.Значение;
			НовСтр.ИдентификаторДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(Док.Значение));
		КонецЕсли;
	КонецЦикла;
	
	Если ТаблицаДокументов.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не указаны документы, для которых необходимо заполнить бух. операцию.'"));
		Возврат;
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаДок.Документ,
		|	ТаблицаДок.ИдентификаторДокумента
		|ПОМЕСТИТЬ ТабДок
		|ИЗ
		|	&ТаблицаДок КАК ТаблицаДок
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВложенныйЗапрос.ТиповаяОперация,
		|	ВложенныйЗапрос.ИдентификаторДокумента
		|ПОМЕСТИТЬ ТиповыеОперации
		|ИЗ
		|	(ВЫБРАТЬ
		|		ТиповыеОперации.Ссылка КАК ТиповаяОперация,
		|		ТиповыеОперации.ИдентификаторДокумента КАК ИдентификаторДокумента
		|	ИЗ
		|		Справочник.ТиповыеОперации КАК ТиповыеОперации
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИдентификаторыОбъектовМетаданных КАК ИдентификаторыОбъектовМетаданных
		|			ПО ТиповыеОперации.ИдентификаторДокумента = ИдентификаторыОбъектовМетаданных.Ссылка
		|	ГДЕ
		|		ТиповыеОперации.НеИспользуется = ЛОЖЬ
		|		И ТиповыеОперации.ПометкаУдаления = ЛОЖЬ
		|		И (НЕ ИСТИНА В
		|						(ВЫБРАТЬ
		|							ИСТИНА
		|						ИЗ
		|							Справочник.ТиповыеОперации.РазрешенныеПользователи КАК ТиповыеОперацииРазрешенныеПользователи
		|						ГДЕ
		|							ТиповыеОперацииРазрешенныеПользователи.Ссылка = ТиповыеОперации.Ссылка)
		|				ИЛИ ИСТИНА В
		|					(ВЫБРАТЬ
		|						ИСТИНА
		|					ИЗ
		|						Справочник.ТиповыеОперации.РазрешенныеПользователи КАК ТиповыеОперацииРазрешенныеПользователи
		|					ГДЕ
		|						ТиповыеОперацииРазрешенныеПользователи.Ссылка = ТиповыеОперации.Ссылка
		|						И ТиповыеОперацииРазрешенныеПользователи.Пользователь = &ТекущийПользователь))
		|		И ИдентификаторыОбъектовМетаданных.Ссылка В
		|				(ВЫБРАТЬ
		|					ТабДок.ИдентификаторДокумента
		|				ИЗ
		|					ТабДок КАК ТабДок)) КАК ВложенныйЗапрос
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТабДок.Документ,
		|	ТабДок.ИдентификаторДокумента,
		|	ОперацииДокументов.Операция КАК ТиповаяОперацияИсходная,
		|	ОперацииДокументов.Операция КАК ТиповаяОперация,
		|	ИдентификаторыОбъектовМетаданных.ПолноеИмя КАК ПолноеИмя,
		|	ОперацииДокументов.Курс,
		|	ОперацииДокументов.Кратность
		|ИЗ
		|	ТабДок КАК ТабДок
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
		|		ПО ТабДок.Документ = ОперацииДокументов.Документ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИдентификаторыОбъектовМетаданных КАК ИдентификаторыОбъектовМетаданных
		|		ПО ТабДок.ИдентификаторДокумента = ИдентификаторыОбъектовМетаданных.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЗначенияДополнительныхРеквизитовОпераций.Объект,
		|	ЗначенияДополнительныхРеквизитовОпераций.РеквизитОперации КАК РеквизитСсылка,
		|	ЗначенияДополнительныхРеквизитовОпераций.РеквизитОперации.ИмяДляФормулы КАК ИмяДляФормулы,
		|	ЗначенияДополнительныхРеквизитовОпераций.Значение
		|ИЗ
		|	РегистрСведений.ЗначенияДополнительныхРеквизитовОпераций КАК ЗначенияДополнительныхРеквизитовОпераций
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТабДок КАК ТабДок
		|		ПО ЗначенияДополнительныхРеквизитовОпераций.Объект = ТабДок.Документ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТиповыеОперации.ТиповаяОперация КАК ТиповаяОперация,
		|	ТиповыеОперации.ИдентификаторДокумента КАК ИдентификаторДокумента,
		|	ТиповыеОперации.ИдентификаторДокумента.ЗначениеПустойСсылки КАК ЗначениеПустойСсылки,
		|	РеквизитыТиповыхОпераций.ИмяДляФормулы,
		|	РеквизитыТиповыхОпераций.РеквизитПроводки,
		|	РеквизитыТиповыхОпераций.Ссылка КАК РеквизитСсылка
		|ИЗ
		|	ТиповыеОперации КАК ТиповыеОперации
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РеквизитыТиповыхОпераций КАК РеквизитыТиповыхОпераций
		|		ПО (РеквизитыТиповыхОпераций.Владелец = ТиповыеОперации.ТиповаяОперация)
		|			И (НЕ РеквизитыТиповыхОпераций.ЭтоГруппа)
		|			И (НЕ РеквизитыТиповыхОпераций.ПометкаУдаления)
		|ИТОГИ
		|	МАКСИМУМ(ИдентификаторДокумента),
		|	МАКСИМУМ(ЗначениеПустойСсылки)
		|ПО
		|	ТиповаяОперация";
		
	Запрос.УстановитьПараметр("ТаблицаДок", ТаблицаДокументов.Выгрузить());
    Запрос.УстановитьПараметр("ТекущийПользователь", Пользователи.АвторизованныйПользователь());
	ТаблицаДокументов.Очистить();
	
	Результаты = Запрос.ВыполнитьПакет();
	
	ЗначенияРеквизитовОперацийИсходные.Загрузить(Результаты[3].Выгрузить());
	ЗначенияРеквизитовОпераций.Загрузить(Результаты[3].Выгрузить());
	
	ТабДок = Результаты[2].Выгрузить();
	
	Для Каждого СтрТЧ Из ТабДок Цикл
		
		НовСтр                    = ТаблицаДокументов.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр,СтрТЧ);
		Если ЭтоДанныеВыписки Тогда
			НовСтр.ТолькоПросмотр = ТолькоПросмотр;
		Иначе	
			НовСтр.ТолькоПросмотр = ДатыЗапретаИзменения.ИзменениеЗапрещено(СтрТЧ.ПолноеИмя,СтрТЧ.Документ,Ложь) ИЛИ ТолькоПросмотр;
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(СтрТЧ.Курс) Тогда
			НовКурс               = ЗначенияРеквизитовОперацийИсходные.Добавить();
			НовКурс.ИмяДляФормулы = "Курс";
			НовКурс.Объект        = СтрТЧ.Документ;
			НовКурс.Значение      = СтрТЧ.Курс;
			ЗаполнитьЗначенияСвойств(ЗначенияРеквизитовОпераций.Добавить(),НовКурс);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрТЧ.Кратность) Тогда
			НовКратность          = ЗначенияРеквизитовОперацийИсходные.Добавить();
			НовКратность.ИмяДляФормулы = "Кратность";
			НовКратность.Объект   = СтрТЧ.Документ;
			НовКратность.Значение = СтрТЧ.Кратность;
			ЗаполнитьЗначенияСвойств(ЗначенияРеквизитовОпераций.Добавить(),НовКратность);
		КонецЕсли;
		
	КонецЦикла;	
			
	ВыборкаОпераций          = Результаты[4].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаОпераций.Следующий() Цикл
		
		НовСтр              = ТаблицаОпераций.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, ВыборкаОпераций);
		
		ВыборкаДопРеквизитов = ВыборкаОпераций.Выбрать();
		
		Пока ВыборкаДопРеквизитов.Следующий() Цикл
			НовРек           = НовСтр.ДополнительныеРеквизиты.Добавить();
			ЗаполнитьЗначенияСвойств(НовРек,ВыборкаДопРеквизитов);
		КонецЦикла;
		
	КонецЦикла;
	
	СоответствиеПоиска            = Новый Соответствие;
	ОперацияПоУмолчанию           = "";
	
	Для Каждого СтрТЧ Из ТаблицаДокументов Цикл
		
		СписокИзСоответствия      = СоответствиеПоиска.Получить(СтрТЧ.ИдентификаторДокумента);
		
		Если (СписокИзСоответствия <> Неопределено) Тогда
			
			СтрТЧ.СписокОпераций  = СписокИзСоответствия;
			Если НЕ ЗначениеЗаполнено(СтрТЧ.ТиповаяОперация) Тогда
				СтрТЧ.ТиповаяОперация     = ОперацияПоУмолчанию;
				СтрТЧ.ЕстьИзменения = ЗначениеЗаполнено(СтрТЧ.ТиповаяОперация);
			КонецЕсли;
			
			Продолжить;
			
		КонецЕсли;
		
		СтруктураПоиска           = Новый Структура("ИдентификаторДокумента",СтрТЧ.ИдентификаторДокумента);
		СписокОпераций            = Новый СписокЗначений;
		СписокОпераций.ЗагрузитьЗначения(ТаблицаОпераций.Выгрузить(СтруктураПоиска,"ТиповаяОперация").ВыгрузитьКолонку("ТиповаяОперация"));
		ОперацияПоУмолчанию       = БухгалтерскиеОперацииСервер.ТиповаяОперацияПоУмолчанию(СтрТЧ.ИдентификаторДокумента);
		
		СтрТЧ.СписокОпераций      = СписокОпераций;
		Если НЕ ЗначениеЗаполнено(СтрТЧ.ТиповаяОперация) Тогда
			СтрТЧ.ТиповаяОперация = ОперацияПоУмолчанию;
			СтрТЧ.ЕстьИзменения = ЗначениеЗаполнено(СтрТЧ.ТиповаяОперация);
		КонецЕсли;
		СоответствиеПоиска.Вставить(СтрТЧ.ИдентификаторДокумента, СписокОпераций);
		
	КонецЦикла;
		
	ФОВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	
	СформироватьДеревоСвойствРеквизитовОпераций(ТаблицаОпераций.Выгрузить().ВыгрузитьКолонку("ТиповаяОперация"));
	
    СформироватьРеквизитыОпераций();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗавершениеРаботы И Модифицированность Тогда
		ТекстПредупреждения = ОбщегоНазначенияБГУКлиент.СтандартныйТекстПредупрежденияПриЗавершенииРаботы();
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Модифицированность Тогда
		
		ТекстВопроса = НСтр("ru='Данные были изменены. Сохранить изменения?'");	
	
		ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект), ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена);
		Отказ = Истина;
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Модифицированность = Ложь;
		Закрыть();
	КонецЕсли;
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Отказ = Ложь;
		УстановитьПометкиИзмененнымИЗаписать(Отказ);
		Если Отказ Тогда
			ТекстСообщения = НСтр("ru='Не все изменения не были записаны'");
			ПоказатьПредупреждение(Неопределено, ТекстСообщения);
			Возврат;
		Иначе
			Модифицированность = Ложь;
			Закрыть();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТаблицаДокументов

&НаКлиенте
Процедура ТаблицаДокументовТиповаяОперацияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекДанные = Элементы.ТаблицаДокументов.ТекущиеДанные;
	
	Если ТекДанные <> Неопределено Тогда
		
		ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ТаблицаДокументовТиповаяОперацияНачалоВыбораЗавершение", ЭтотОбъект, Новый Структура("ТекДанные", ТекДанные)), ТекДанные.СписокОпераций, Элемент);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаДокументовТиповаяОперацияНачалоВыбораЗавершение(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	ТекДанные = ДополнительныеПараметры.ТекДанные;
	
	ВыбраннаяОперация = ВыбранныйЭлемент;
	Если ВыбраннаяОперация<>Неопределено Тогда
		ТекДанные.ТиповаяОперация = ВыбраннаяОперация.Значение;
		ТекДанные.ЕстьИзменения = Истина;
		ТекОперация = ТекДанные.ТиповаяОперация;
		ДействияПриИзмененииТиповойОперации(ТекДанные.ТиповаяОперация, ТекДанные.Документ, Истина);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаДокументовТиповаяОперацияОчистка(Элемент, СтандартнаяОбработка)
	Элементы.СтраницыРеквизитов.ТекущаяСтраница = Элементы["БухгалтерскаяОперация"];
	ТекДанные = Элементы.ТаблицаДокументов.ТекущиеДанные;
	ТекДанные.ЕстьИзменения = Истина;
	ТекОперация = Неопределено;
	ОчиститьЗначенияДопРеквизитов();
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаДокументовПриАктивизацииСтроки(Элемент)
	
	ТекДанные = Элементы.ТаблицаДокументов.ТекущиеДанные;
	
	Если ТекДанные<>Неопределено Тогда
		ТекОперация = ТекДанные.ТиповаяОперация;
		ТекДокумент = ТекДанные.Документ;
	Иначе
		ТекОперация = Неопределено;
		ТекДокумент = Неопределено;
	КонецЕсли;
	
	ДействияПриАктивизацииСтроки();
	
	Если ТекДанные<>Неопределено Тогда
		Элементы.СтраницыРеквизитов.ТекущаяСтраница.ТолькоПросмотр = ТекДанные.ТолькоПросмотр;
	Иначе
		Элементы.СтраницыРеквизитов.ТекущаяСтраница.ТолькоПросмотр = Ложь;
	КонецЕсли;
	
	ОбновитьОтображениеДанных();
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаДокументовДокументОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаДокументовДокументНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаДокументовДокументОчистка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТиповыхОпераций

&НаКлиенте
Процедура Подключаемый_ОбновитьКурсВалюты(Команда)
	
	ТекДанные = Элементы.ТаблицаДокументов.ТекущиеДанные;
	Если ТекДанные<>Неопределено Тогда
		ТекДанные.ЕстьИзменения = Истина;
	КонецЕсли;
	
	ОбновитьКурсВалюты();

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриИзмененииДопРеквизита(Элемент)
	
	ТекДанные = Элементы.ТаблицаДокументов.ТекущиеДанные;
	Если ТекДанные<>Неопределено Тогда
		ТекДанные.ЕстьИзменения = Истина;
	КонецЕсли;
	ИмяЭлемента = "";
	Префикс = "";
	РазобратьПолноеИмяЭлемента(Элемент.Имя,ИмяЭлемента,Префикс);
	
	ИзменитьРеквизитТиповойОперации(ИмяЭлемента,Префикс);
	
КонецПроцедуры

// Обновляет курс валюты и кратность на форме
// Параметры
// Форма - УправляемаяФорма
// Объект - ЭлементыФормыСтруктура - документ-объект в форме
//
&НаСервере
Процедура ОбновитьКурсВалюты()
	
	Попытка
		ДатаКурса = ЭтаФорма.Дата;
	Исключение
		//У формы нет реквизита дата
		ДатаКурса = ТекДокумент.Дата;
	КонецПопытки;
	
	Валюта=Неопределено;
	РеквизитВалюта = ТекДокумент.Метаданные().Реквизиты.Найти("ВалютаДокумента");
	Если РеквизитВалюта = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Валюта = ТекДокумент[РеквизитВалюта.Имя];
	
	ТекКурсКратность = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Валюта, ДатаКурса);
	ТекСтраница = Элементы.СтраницыРеквизитов.ТекущаяСтраница.Имя;
	Префикс = "";
	РазобратьПолноеИмяЭлемента(ТекСтраница,"",Префикс);
	
	ЭтаФорма["Курс"+Префикс] = ТекКурсКратность.Курс;
	ЭтаФорма["Кратность"+Префикс] = ТекКурсКратность.Кратность;
	
	СтрокиЗначений = ЗначенияРеквизитовОпераций.НайтиСтроки(Новый Структура("Объект,ИмяДляФормулы",ТекДокумент,"Курс"));
	Если СтрокиЗначений.Количество()> 0 Тогда
		СтрокаЗначений = СтрокиЗначений[0];
	Иначе
		СтрокаЗначений = ЗначенияРеквизитовОпераций.Добавить();
		СтрокаЗначений.Объект = ТекДокумент;
		СтрокаЗначений.ИмяДляФормулы = "Курс";
	КонецЕсли;
    СтрокаЗначений.Значение = ТекКурсКратность.Курс;
	
	СтрокиЗначений = ЗначенияРеквизитовОпераций.НайтиСтроки(Новый Структура("Объект,ИмяДляФормулы",ТекДокумент,"Кратность"));
	Если СтрокиЗначений.Количество()> 0 Тогда
		СтрокаЗначений = СтрокиЗначений[0];
	Иначе
		СтрокаЗначений = ЗначенияРеквизитовОпераций.Добавить();
		СтрокаЗначений.Объект = ТекДокумент;
		СтрокаЗначений.ИмяДляФормулы = "Кратность";
	КонецЕсли;
	СтрокаЗначений.Значение = ТекКурсКратность.Кратность;
	
КонецПроцедуры

&НаКлиенте
Процедура ДопРеквизитИзменение(Элемент,Префикс)
	
	СписокЗависимыхЭлементов = ЭтаФорма["СписокЗависимыхЭлементов"+Префикс];
	
	ИмяРеквизитаФормы = Сред(Элемент.Имя, 17);
	ИзменяемыеЭлементы = ПолучитьСписокЗависимыхЭлементовФормы(СписокЗависимыхЭлементов, ИмяРеквизитаФормы);
	
	Если ИзменяемыеЭлементы.Количество()>0 Тогда
	
		СтруктураИменЭлементов = Новый Структура;
		СтруктураИменЭлементов.Вставить("СчетФормы", ИмяРеквизитаФормы);
		
		Для каждого ТекЭлемент Из ИзменяемыеЭлементы Цикл
			
			СтруктураИменЭлементов.Вставить("Субконто"+ТекЭлемент.НомерСубконто, "ТиповыеОперации_"+ТекЭлемент.ИмяЭлемента);	
			СтруктураИменЭлементов.Вставить("СубконтоФормы"+ТекЭлемент.НомерСубконто, ТекЭлемент.ИмяЭлемента);	
			
		КонецЦикла;
		
		СтруктураИменЭлементов.Вставить("ОчищатьОтстуствующие");
		
		УстановитьЗаголовкиСубконто(ЭтаФорма, Неопределено, СтруктураИменЭлементов, ,Префикс);
		
	КонецЕсли;
	
КонецПроцедуры

// Устанавливает заголовки и доступность элементов для ввода субконто. 
// Параметры:
//	Форма - управляемаяформа
//	Объект - объект формы
//	СтруктураИменЭлементов - структура.
//		Ключи структуры:
//		СчетОбъекта - Строка - Имя реквизита объекта для получения счета
//		СчетФормы	- Строка - Имя реквизита формы для получения счета
//		Субконто1	- Строка - Имя элемента формы, содержащего субконто 1 (необязательный)
//		Субконто2	- Строка - Имя элемента формы, содержащего субконто 2 (необязательный)
//		Субконто3	- Строка - Имя элемента формы, содержащего субконто 3 (необязательный)
//		Подразделение- Строка - Имя элемента формы, содержащего подразделение затрат (необязательный)
//		КОСГУДт		- Строка - Имя реквизита объекта, для постановки КОСГУДт счета (необязательный)
//		КОСГУКт		- Строка - Имя реквизита объекта, для постановки КОСГУКт счета (необязательный)
// 		ИспользоватьУчетПоПодразделениям - Булево - значение ФО. Если не передано, то: 
//													на клиенте считается равным ЛОЖЬ. 
//													на сервере будет получено текущее значение ФО.													
//	Примечание:
//		Необходимо чтобы в структуре содеражался либо ключ СчетОбъекта, либо СчетФормы.
//		Если заданы оба, то используется СчетОбъекта, а СчетФормы игнорируется.
//		Если не задан ни один, то выполнение процедуры прерывается.
//
//		Для Веб-клиента, для гарантированной очистки пустых субконто можно задать ключ ОчищатьОтстуствующие.
//		При этом имена реквизитов объекта, содержащие значения субконто задаются в ключах
//		СубконтоОбъекта1, СубконтоОбъекта2, СубконтоОбъекта3 для объекта или
//		СубконтоФормы1, СубконтоФормы2, СубконтоФормы3 для формы.
//
//	ТекстОтсутствующегоСубконто - Строка - Текст заголовка пустого субконто.
//
&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовкиСубконто(Форма, Объект, СтруктураИменЭлементов, ТекстОтсутствующегоСубконто = "<не определено>",Префикс = "") Экспорт
	
	Если СтруктураИменЭлементов.Свойство("СчетОбъекта") Тогда 
		Счет = Объект[СтруктураИменЭлементов.СчетОбъекта];
	ИначеЕсли СтруктураИменЭлементов.Свойство("СчетФормы") Тогда 
		Счет = Форма[СтруктураИменЭлементов.СчетФормы+Префикс];
	Иначе
		Возврат;
	КонецЕсли;
	
	ИспользоватьУчетПоПодразделениям = Неопределено;
	Если НЕ СтруктураИменЭлементов.Свойство("ИспользоватьУчетПоПодразделениям", ИспользоватьУчетПоПодразделениям) Тогда
		ИспользоватьУчетПоПодразделениям = ОбщегоНазначенияБГУВызовСервераПовтИсп.ЗначениеФункциональнойОпции("ИспользоватьУчетПоПодразделениям");
	КонецЕсли;
	Если ИспользоватьУчетПоПодразделениям <> Истина Тогда
		ИспользоватьУчетПоПодразделениям = Ложь;
	КонецЕсли;
	ИмяЭлементаПодразделение = "";
	ДоступностьЭлементаПодразделение = Ложь;
		
	Если ЗначениеЗаполнено(Счет) Тогда
		СвойстваСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(Счет);
		Если ИспользоватьУчетПоПодразделениям Тогда
			ДоступностьЭлементаПодразделение = СвойстваСчета.УчетПоПодразделениям;
		КонецЕсли;
		КоличествоСубконто = СвойстваСчета.КоличествоСубконто;
		Для Счетчик = 1 По КоличествоСубконто Цикл
			ИмяРеквизита = "";
			СтруктураИменЭлементов.Свойство("Субконто"+Счетчик, ИмяРеквизита);
			Если ЗначениеЗаполнено(ИмяРеквизита) Тогда
				ТекЭлемент = Форма.Элементы[ИмяРеквизита+Префикс];
				ТекЭлемент.Заголовок = СвойстваСчета["ВидСубконто"+Счетчик+"Наименование"];
				ТекЭлемент.Доступность = Истина;
				Если Не СвойстваСчета["ВидСубконто"+Счетчик+"Обязательный"] Тогда
					ТекЭлемент.АвтоОтметкаНезаполненного = Ложь;
					ТекЭлемент.ОтметкаНезаполненного = Ложь;
				Иначе
					ТекЭлемент.АвтоОтметкаНезаполненного = Истина;
				КонецЕсли; 
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		КоличествоСубконто = 0;
	КонецЕсли;
	Если ИспользоватьУчетПоПодразделениям И СтруктураИменЭлементов.Свойство("Подразделение", ИмяЭлементаПодразделение) Тогда
		Форма.Элементы[ИмяЭлементаПодразделение+Префикс].Доступность = ДоступностьЭлементаПодразделение;
	КонецЕсли;
		
	Для Счетчик = КоличествоСубконто + 1 По 3 Цикл
		Если СтруктураИменЭлементов.Свойство("Субконто"+Счетчик) Тогда
			ТекЭлемент = Форма.Элементы[СтруктураИменЭлементов["Субконто"+Счетчик]+Префикс];
			ТекЭлемент.Заголовок = ТекстОтсутствующегоСубконто;
			ТекЭлемент.Доступность = Ложь;
			#Если ВебКлиент Тогда
			Если СтруктураИменЭлементов.Свойство("ОчищатьОтстуствующие") Тогда
				ИмяРеквизита = "";
				Если СтруктураИменЭлементов.Свойство("СубконтоОбъекта"+Счетчик, ИмяРеквизита) Тогда 		
					Если ЗначениеЗаполнено(ИмяРеквизита) Тогда
						Объект[ИмяРеквизита] = Неопределено;			
					КонецЕсли;
				ИначеЕсли СтруктураИменЭлементов.Свойство("СубконтоФормы"+Счетчик, ИмяРеквизита) Тогда 		
					Если ЗначениеЗаполнено(ИмяРеквизита) Тогда
						Форма[ИмяРеквизита+Счетчик] = Неопределено;			
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			#КонецЕсли
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ИзменитьРеквизитТиповойОперации(ИмяЭлемента,Префикс)
	
	ЗначениеЭлемента = ЭтаФорма[ИмяЭлемента+Префикс];
	
	СтрокаДанныхОперации = ТаблицаОпераций.НайтиСтроки(Новый Структура("ТиповаяОперация",ТекОперация));
	Если СтрокаДанныхОперации.Количество()> 0 Тогда
		СтрокаТЧДопРеквизитов = СтрокаДанныхОперации[0].ДополнительныеРеквизиты.НайтиСтроки(Новый Структура("ИмяДляФормулы",ИмяЭлемента));
		Если СтрокаТЧДопРеквизитов.Количество()> 0 Тогда
			ТекДанныеРеквизита = СтрокаТЧДопРеквизитов[0];
			//сделать при изменении/очистке операции - очистку значений доп реквизитов
			СтрокиЗначений = ЗначенияРеквизитовОпераций.НайтиСтроки(Новый Структура("Объект,ИмяДляФормулы",ТекДокумент,ТекДанныеРеквизита.ИмяДляФормулы));
			Если СтрокиЗначений.Количество()> 0 Тогда
				СтрокаЗначений = СтрокиЗначений[0];
			Иначе
				СтрокаЗначений = ЗначенияРеквизитовОпераций.Добавить();
				СтрокаЗначений.Объект = ТекДокумент;
				СтрокаЗначений.РеквизитСсылка = ТекДанныеРеквизита.РеквизитСсылка;
				СтрокаЗначений.ИмяДляФормулы = ТекДанныеРеквизита.ИмяДляФормулы;
			КонецЕсли;
			СтрокаЗначений.Значение = ЗначениеЭлемента;
		ИначеЕсли ВРег(ИмяЭлемента) = "КУРС" Или ВРег(ИмяЭлемента) = "КРАТНОСТЬ" Тогда
			ЭтоКурс = ВРег(ИмяЭлемента) = "КУРС";
			СтрокиЗначений = ЗначенияРеквизитовОпераций.НайтиСтроки(Новый Структура("Объект,ИмяДляФормулы",ТекДокумент,ИмяЭлемента));
			Если СтрокиЗначений.Количество()> 0 Тогда
				СтрокаЗначений = СтрокиЗначений[0];
			Иначе
				СтрокаЗначений = ЗначенияРеквизитовОпераций.Добавить();
				СтрокаЗначений.Объект = ТекДокумент;
				СтрокаЗначений.ИмяДляФормулы = ИмяЭлемента;
			КонецЕсли;
			СтрокаЗначений.Значение = ЗначениеЭлемента;
		КонецЕсли;
	КонецЕсли;
			
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РазобратьПолноеИмяЭлемента(ПолноеИмя,Имя,Префикс)
	ТекПолноеИмя = СтрЗаменить(ПолноеИмя,"ТиповыеОперации_","");
	Имя = ТекПолноеИмя;
	Префикс = "";
	ПозицияПрефикса = Найти(ТекПолноеИмя,"__");
	Если ПозицияПрефикса > 1 Тогда
		Имя = Лев(ТекПолноеИмя,ПозицияПрефикса-1);
		Префикс = Сред(ТекПолноеИмя,ПозицияПрефикса);
	КонецЕсли;		
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьДокумент(Команда)
	ТекДанные = Элементы.ТаблицаДокументов.ТекущиеДанные;
	Если ТекДанные<>Неопределено Тогда
		ПоказатьЗначение(Неопределено, ТекДанные.Документ);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НачальныеЗначения(Команда)
	ТекДанные = Элементы.ТаблицаДокументов.ТекущиеДанные;
	ВернутьНачальныеЗначенияОтмеченным(ТекДанные.ПолучитьИдентификатор());	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтметку(Команда)
	
	ИзменитьЗначениеОтметки(1);
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметку(Команда)
	ИзменитьЗначениеОтметки(0);
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьДопРеквизиты(Команда)
	ТекДанные = Элементы.ТаблицаДокументов.ТекущиеДанные;
	ЗаписатьДопРеквизитыСервер(ТекДанные.ПолучитьИдентификатор());
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СформироватьДеревоСвойствРеквизитовОпераций(ТабОпераций)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РеквизитыТиповыхОпераций.Владелец КАК Операция,
	|	РеквизитыТиповыхОпераций.Ссылка КАК Ссылка,
	|	РеквизитыТиповыхОпераций.Код КАК Код,
	|	РеквизитыТиповыхОпераций.ЭтоГруппа КАК ЭтоГруппа,
	|	РеквизитыТиповыхОпераций.РеквизитПроводки КАК РеквизитПроводки,
	|	РеквизитыТиповыхОпераций.Наименование КАК Наименование,
	|	РеквизитыТиповыхОпераций.ИмяДляФормулы КАК ИмяДляФормулы,
	|	ЕСТЬNULL(РеквизитыТиповыхОпераций.ОтборЭлементов, """") КАК ОтборЭлементов,
	|	ВЫБОР
	|		КОГДА РеквизитыТиповыхОпераций.СостояниеПоддержки = ЗНАЧЕНИЕ(Перечисление.СостоянияПоддержкиТиповыхОпераций.НеРедактируется)
	|			ТОГДА ЕСТЬNULL(РеквизитыТиповыхОпераций.ПоставляемыйРеквизитТиповойОперации.Обязательный, ЛОЖЬ)
	|		ИНАЧЕ ЕСТЬNULL(ДанныеРеквизитовТиповыхОпераций.Обязательный, ЛОЖЬ)
	|	КОНЕЦ КАК Обязательный,
	|	ВЫБОР
	|		КОГДА РеквизитыТиповыхОпераций.СостояниеПоддержки = ЗНАЧЕНИЕ(Перечисление.СостоянияПоддержкиТиповыхОпераций.НеРедактируется)
	|			ТОГДА ЕСТЬNULL(РеквизитыТиповыхОпераций.ПоставляемыйРеквизитТиповойОперации.СвязиПараметровВыбора, """")
