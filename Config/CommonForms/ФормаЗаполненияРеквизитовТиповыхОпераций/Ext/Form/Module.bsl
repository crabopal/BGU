					КонецЕсли;
					Если УпакованныеНастройки.Свойство("ТолькоЧтение") Тогда
						ОписаниеРеквизита.ЗапретитьИзменение = УпакованныеНастройки.ТолькоЧтение;  	
					КонецЕсли;
					Если УпакованныеНастройки.Свойство("Видимость") Тогда
						ОписаниеРеквизита.НевидимыйЭлемент = НЕ УпакованныеНастройки.Видимость;  	
					КонецЕсли;
					Если УпакованныеНастройки.Свойство("ПроверкаВвода") Тогда
						ОписаниеРеквизита.Обязательный = ?(УпакованныеНастройки.ПроверкаВвода = "Не проверять", ЛОЖЬ, ИСТИНА);  	
					КонецЕсли;
					Если УпакованныеНастройки.Свойство("ПоложениеЗаголовка") Тогда
						СохраненноеЗначение = 0;
						Если УпакованныеНастройки.ПоложениеЗаголовка = "Нет" Тогда
							СохраненноеЗначение = 1;
						ИначеЕсли УпакованныеНастройки.ПоложениеЗаголовка = "Лево" Тогда
							СохраненноеЗначение = 2;
						ИначеЕсли УпакованныеНастройки.ПоложениеЗаголовка = "Верх" Тогда
							СохраненноеЗначение = 3;
						ИначеЕсли УпакованныеНастройки.ПоложениеЗаголовка = "Право" Тогда
							СохраненноеЗначение = 4;
						ИначеЕсли УпакованныеНастройки.ПоложениеЗаголовка = "Низ" Тогда
							СохраненноеЗначение = 5; 
						КонецЕсли;
						ОписаниеРеквизита.ПоложениеЗаголовка = СохраненноеЗначение;  	
					КонецЕсли;
					Если УпакованныеНастройки.Свойство("СвязиПараметровВыбора") Тогда
						ОписаниеРеквизита.СвязиПараметровВыбора = УпакованныеНастройки.СвязиПараметровВыбора;
					КонецЕсли;	
					Если УпакованныеНастройки.Свойство("СвязиПоТипу") Тогда
						ОписаниеРеквизита.СвязиПоТипу = УпакованныеНастройки.СвязиПоТипу;
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;

	Для Каждого СтрОперация Из ДеревоРеквизитовОпераций.Строки Цикл
		
		    ЗаполнитьСвойстваРеквизитовРекурсивно(СтрОперация.Строки);
		
	КонецЦикла;	
			
КонецПроцедуры	

Процедура ЗаполнитьСвойстваРеквизитовРекурсивно(ВеткаДерева)
	
	Для Каждого Стр Из ВеткаДерева Цикл
		
		СвойстваРеквизита = ТабРеквизитов.Найти(Стр.Ссылка, "Ссылка");
		
		Если НЕ СвойстваРеквизита = Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Стр, СвойстваРеквизита);
		КонецЕсли;	
		
		Если Стр.Строки.Количество() > 0 Тогда
			ЗаполнитьСвойстваРеквизитовРекурсивно(Стр.Строки);
		КонецЕсли;	
			
	КонецЦикла;
	
КонецПроцедуры	

&НаСервере
Процедура СформироватьРеквизитыОпераций()
	
	Индекс = 0;
	//Для каждой операции
	РодительскаяГруппа = Элементы.СтраницыРеквизитов;
	СписокЗначенийВалУчета = Новый СписокЗначений;
	
	Для Каждого СтрОперация Из ТаблицаОпераций Цикл
		
		ПолеДляРеквизитов = ЭтаФорма.Элементы.Добавить("БухгалтерскаяОперация"+"__"+Индекс,
													Тип("ГруппаФормы"),
													РодительскаяГруппа);
		ПолеДляРеквизитов.Вид =	ВидГруппыФормы.Страница;
		ВалютныйУчет = ИспользоватьВалютныйУчет(СтрОперация.ЗначениеПустойСсылки, ФОВалютныйУчет, СписокЗначенийВалУчета);
		
		ДобавляемыеРеквизиты = Новый Массив;
		ОбязательныеРеквизиты = Новый Массив;
		РеквизитыСвязиПараметровВыбора = Новый Массив;
		
		ДеревоДопРеквизитов = ДеревоЭлементовФормыТиповойОперации(СтрОперация.ТиповаяОперация, СтрОперация.ИдентификаторДокумента);
		
		СтрокаТиповаяОперация = ДеревоДопРеквизитов.Строки.Найти("ТиповаяОперацияДокумента", "Имя");
		Если СтрокаТиповаяОперация <> Неопределено Тогда
			ДеревоДопРеквизитов.Строки.Удалить(СтрокаТиповаяОперация);
		КонецЕсли;
		Если НЕ ВалютныйУчет Тогда
			СтрокаТиповаяОперация = ДеревоДопРеквизитов.Строки.Найти("КурсКратность", "Имя");
			Если СтрокаТиповаяОперация <> Неопределено Тогда
				ДеревоДопРеквизитов.Строки.Удалить(СтрокаТиповаяОперация);
			КонецЕсли;	
		КонецЕсли;
		//Обход дерева и переименование всех необходимых полей
		УстановитьПрефиксЭлементамДерева(ДеревоДопРеквизитов,СтрОперация.ЗначениеПустойСсылки,"__"+Индекс);
		//
		ВыбратьДобавляемыеРеквизиты(ДеревоДопРеквизитов,
			ДобавляемыеРеквизиты, ОбязательныеРеквизиты, Ложь, ВалютныйУчет,, Новый Соответствие, Новый СписокЗначений);
		
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ОбязательныеДопРеквизиты"+"__"+Индекс, Новый ОписаниеТипов("СписокЗначений")));
		Если Индекс = 0 Тогда
			ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ПризнакФормированияПроводокАвтоматически", Новый ОписаниеТипов("Булево")));
		КонецЕсли;
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("СписокЗависимыхЭлементов"+"__"+Индекс, Новый ОписаниеТипов("СписокЗначений")));

		ИзменитьРеквизиты(ДобавляемыеРеквизиты);
		
        ОбновитьЭлементыФормы(ЭтаФорма, ДеревоДопРеквизитов, ПолеДляРеквизитов, Неопределено, Ложь, Истина);
			
		ЭтаФорма["ОбязательныеДопРеквизиты"+"__"+Индекс] = ОбязательныеРеквизиты;
		ЭтаФорма["ПризнакФормированияПроводокАвтоматически"] = НЕ ПолучитьФункциональнуюОпцию("ФормированиеПроводокОбособленноОтДокумента");
	    Индекс = Индекс +1;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПрефиксЭлементамДерева(ДеревоРеквизитов,СсылкаДокумента,Префикс)
	
	Для каждого ТекЭлементДерева Из ДеревоРеквизитов.Строки Цикл
		Если ТекЭлементДерева.ТипЭлемента.СодержитТип(Тип("ГруппаФормы")) Тогда
			ТекЭлементДерева.Имя = ТекЭлементДерева.Имя + Префикс;
					
			УстановитьПрефиксЭлементамДерева(ТекЭлементДерева,СсылкаДокумента,Префикс);
		Иначе
			Если ТекЭлементДерева.Имя = "Курс" ИЛИ ТекЭлементДерева.Имя = "Кратность" Тогда
				ТекЭлементДерева.ПриИзменении = "Подключаемый_ПриИзмененииДопРеквизита";
			КонецЕсли;
			ТекЭлементДерева.Имя = ТекЭлементДерева.Имя + Префикс;
			ТекЭлементДерева.Реквизит = ТекЭлементДерева.Реквизит + Префикс;
			Если ТипЗнч(ТекЭлементДерева.СвязиПараметровВыбора) = Тип("Массив") Тогда
				
				НоваяСвязь = Новый Массив;
				
				Для каждого ТекСвязьПараметров Из ТекЭлементДерева.СвязиПараметровВыбора Цикл
					СвязьДобавлена = Ложь;
				
					ИмяСвязи = ТекСвязьПараметров.ПутьКДанным;
					Если Лев(ВРег(ИмяСвязи), 7) = "ОБЪЕКТ." Тогда					
						
						
						ИмяРеквизитаСвязи = Сред(ИмяСвязи, 8);
						
						Если ЭтаФорма.СписокРеквизитовДокумента.НайтиПоЗначению(ИмяРеквизитаСвязи)=Неопределено Тогда
							ДобРек = Новый Массив;
							ДобРек.Добавить(Новый РеквизитФормы(ИмяРеквизитаСвязи, ПолучитьТипПоИмениРеквизита(СсылкаДокумента,ИмяРеквизитаСвязи)));
							ЭтаФорма.ИзменитьРеквизиты(ДобРек);
							ЭтаФорма.СписокРеквизитовДокумента.Добавить(ИмяРеквизитаСвязи);
						КонецЕсли;
						НоваяСвязь.Добавить(Новый СвязьПараметраВыбора(ТекСвязьПараметров.Имя,
																		ИмяРеквизитаСвязи,
																		ТекСвязьПараметров.ИзменениеЗначения));
						СвязьДобавлена = Истина;
					Иначе
						НоваяСвязь.Добавить(Новый СвязьПараметраВыбора(ТекСвязьПараметров.Имя,
																		ТекСвязьПараметров.ПутьКДанным+Префикс,
																		ТекСвязьПараметров.ИзменениеЗначения));
					КонецЕсли;
				КонецЦикла; 
				ТекЭлементДерева.СвязиПараметровВыбора = НоваяСвязь;
			КонецЕсли;
			Если ЗначениеЗаполнено(ТекЭлементДерева.СвязиПоТипу) Тогда
				СвязиПоТипу = ТекЭлементДерева.СвязиПоТипу;
				ИмяСвязи = Лев(СвязиПоТипу, Найти(СвязиПоТипу, "(")-1);
				ИмяСПрефиксом = ИмяСвязи + Префикс;
				ТекЭлементДерева.СвязиПоТипу = СтрЗаменить(СвязиПоТипу,ИмяСвязи+"(",ИмяСПрефиксом+"(");
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Процедура устанавливает доступность и заголовки дополнительных реквизитов операций, для которых задана связь по типу
//
// Параметры
//  Форма  - УправляемаяФорма
//  ПолеДляРеквизитов  - ГруппаФормы - группа
//
&НаСервере
Процедура УстановитьДоступностьЗависимыхРеквизитовФормы(ПолеДляРеквизитов, Префикс) Экспорт
    
	Для каждого Элемент Из ПолеДляРеквизитов.ПодчиненныеЭлементы Цикл
	
		Если ТипЗнч(Элемент) = Тип("ПолеФормы") Тогда
			
			Если Элемент.Вид = ВидПоляФормы.ПолеВвода Тогда
				ИмяРеквизитаФормы = Сред(Элемент.Имя, 17);
				ИзменяемыеЭлементы = ПолучитьСписокЗависимыхЭлементовФормы(ЭтаФорма["СписокЗависимыхЭлементов"+Префикс], ИмяРеквизитаФормы);
				
				Если ИзменяемыеЭлементы.Количество()>0 Тогда
				
					СтруктураИменЭлементов = Новый Структура;
					СтруктураИменЭлементов.Вставить("СчетФормы", ИмяРеквизитаФормы);
					Для каждого ТекЭлемент Из ИзменяемыеЭлементы Цикл
						
						СтруктураИменЭлементов.Вставить("Субконто"+ТекЭлемент.НомерСубконто, "ТиповыеОперации_"+ТекЭлемент.ИмяЭлемента);	
						
					КонецЦикла;
					
					УстановитьЗаголовкиСубконто(ЭтаФорма, Неопределено, СтруктураИменЭлементов,,Префикс);
					
				КонецЕсли;
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(Элемент) = Тип("ГруппаФормы") Тогда
			
			УстановитьДоступностьЗависимыхРеквизитовФормы(Элемент, Префикс);
			
		КонецЕсли;
	
	КонецЦикла; 		

КонецПроцедуры // УстановитьДоступностьЗависимыхРеквизитовФормы()

&НаСервереБезКонтекста
Функция ПолучитьТипПоИмениРеквизита(СсылкаНаДокумент,ИмяРеквизита)
	
	Результат = Новый ОписаниеТипов("Неопределено");
	ИскомыйРеквизит = СсылкаНаДокумент.Метаданные().Реквизиты.Найти(ИмяРеквизита);
	Если ИскомыйРеквизит <> Неопределено Тогда
		Возврат Искомыйреквизит.Тип;
	КонецЕсли;
	
	СтандартныеРеквизиты = СсылкаНаДокумент.Метаданные().СтандартныеРеквизиты;//.Найти(ИмяРеквизита);
	Для Каждого СтандартныйРеквизит Из СтандартныеРеквизиты Цикл
		Если СтандартныйРеквизит.Имя = ИмяРеквизита Тогда
			Возврат СтандартныйРеквизит.Тип;
		КонецЕсли;
	КонецЦикла;
		
	Возврат Результат;
	
КонецФункции

// Функция проверяет необходимость вывода валютных реквизитов в типовой операции.
//
&НаСервереБезКонтекста
Функция ИспользоватьВалютныйУчет(СсылкаНаДокумент, ВалютныйУчет, СписокЗначенийВалУчета) Экспорт
	
	СтрСписка = СписокЗначенийВалУчета.НайтиПоЗначению(СсылкаНаДокумент);
	Если СтрСписка <> Неопределено Тогда
		Возврат СтрСписка.Пометка;
	КонецЕсли;
	ВалУчет = ВалютныйУчет;
	Если СсылкаНаДокумент.Метаданные().Реквизиты.Найти("ВалютаДокумента")=Неопределено Тогда
		ВалУчет = Ложь;
	ИначеЕсли СсылкаНаДокумент.Метаданные().Реквизиты.Найти("Курс")<>Неопределено Тогда
		ВалУчет = Ложь;
	КонецЕсли;
	СписокЗначенийВалУчета.Добавить(СсылкаНаДокумент,,ВалУчет);
	
	Возврат ВалУчет;
	
КонецФункции

&НаСервере
Процедура ДействияПриИзмененииТиповойОперации(ТиповаяОперация, Документ, Очищать = Неопределено)
	
	Если Очищать = Неопределено Тогда
		Очищать = Ложь;
	КонецЕсли;
	
	ИскомыеСтроки = ТаблицаОпераций.НайтиСтроки(Новый Структура("ТиповаяОперация",ТиповаяОперация));
	
	Индекс = "";
	
	Если ИскомыеСтроки.Количество()> 0 Тогда
		Индекс = ИскомыеСтроки[0].ПолучитьИдентификатор();
	КонецЕсли;
	
	Элементы.СтраницыРеквизитов.ТекущаяСтраница = Элементы["БухгалтерскаяОперация"+?(Индекс<>"","__"+Индекс,"")];
	
	Если Очищать Тогда
		ОчиститьЗначенияДопРеквизитов();
	КонецЕсли;
	
	Если Индекс <> "" Тогда
		
		ИдентификаторДокумента 	= ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(Документ));
		ОбъектОрганизация 		= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "Организация");
				
		РеквизитыФормы 			= БухгалтерскиеОперацииСервер.ПолучитьИменаРеквизитовФормы(ЭтаФорма);
		
		//Значения реквизитов операции "По умолчанию"
		ЗначенияДопРеквизитов 	= БухгалтерскиеОперацииСервер.РеквизитыТиповойОперацииПоУмолчанию(ИдентификаторДокумента, ТиповаяОперация, ОбъектОрганизация);
		
		Для Каждого РеквизитФормы Из РеквизитыФормы Цикл
			
			ПозицияПрефикса = Найти(РеквизитФормы,"__");
			
			Если ПозицияПрефикса = 0 Тогда
				Продолжить;			
			КонецЕсли;
			
			Если Сред(РеквизитФормы, ПозицияПрефикса) <> "__"+Индекс Тогда
				Продолжить;
			КонецЕсли;
			
			ИмяБезПрефикса = СтрЗаменить(РеквизитФормы,"__"+Индекс,"");
			СтрокиЗначений = ЗначенияРеквизитовОпераций.НайтиСтроки(Новый Структура("Объект, ИмяДляФормулы", Документ, ИмяБезПрефикса));
			
			Если СтрокиЗначений.Количество() > 0 Тогда
				ЭтаФорма[РеквизитФормы] = СтрокиЗначений[0].Значение;
			ИначеЕсли ЗначенияДопРеквизитов.Свойство(ИмяБезПрефикса) Тогда
				ЭтаФорма[РеквизитФормы] = ЗначенияДопРеквизитов[ИмяБезПрефикса];
				ИзменитьРеквизитТиповойОперации(ИмяБезПрефикса, "__"+Индекс);
			Иначе	
				ЭтаФорма[РеквизитФормы] = Неопределено;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДействияПриАктивизацииСтроки()
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма,ТекДокумент);

	ДействияПриИзмененииТиповойОперации(ТекОперация,ТекДокумент);	
	
КонецПроцедуры

&НаСервере 
Процедура ВернутьНачальныеЗначенияОтмеченным(ТекИдентификатор)
	
	ЗаписываемыеСтроки = ТаблицаДокументов.НайтиСтроки(Новый Структура("Использовать",1));
	
	Если ЗаписываемыеСтроки.Количество() = 0 Тогда
		ТекДанные = ТаблицаДокументов.НайтиПоИдентификатору(ТекИдентификатор);
		Если ТекДанные.ЕстьИзменения Тогда
			ТекДанные.ЕстьИзменения = Ложь;
			ВернутьНачальныеЗначенияСервер(ТекДанные.ТиповаяОперация,ТекДанные.Документ);	
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не отмечены строки, для которых необходимо отменить изменения.'"));
			Возврат;
		КонецЕсли;
	Иначе
		Для Каждого ЗаписываемаяСтрока Из ЗаписываемыеСтроки Цикл
			ЗаписываемаяСтрока.ТиповаяОперация = ЗаписываемаяСтрока.ТиповаяОперацияИсходная;
			ЗаписываемаяСтрока.ЕстьИзменения = Ложь;
			ЗаписываемаяСтрока.Использовать = 0;
			ВернутьНачальныеЗначенияСервер(ЗаписываемаяСтрока.ТиповаяОперация,ЗаписываемаяСтрока.Документ);		
		КонецЦикла;
	КонецЕсли;
	
	Если ТаблицаДокументов.НайтиСтроки(Новый Структура("ЕстьИзменения",Истина)).Количество() = 0 Тогда
		ЭтаФорма.Модифицированность = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВернутьНачальныеЗначенияСервер(ТиповаяОперация,Документ)
	
	СтрокиИсходныхЗначений = ЗначенияРеквизитовОперацийИсходные.НайтиСтроки(Новый Структура("Объект",Документ));
	УдаляемыеСтроки = ЗначенияРеквизитовОпераций.НайтиСтроки(Новый Структура("Объект",Документ));
	Для Каждого УдСтрока Из УдаляемыеСтроки Цикл
		ЗначенияРеквизитовОпераций.Удалить(УдСтрока);
	КонецЦикла;
	
	Для Каждого НовСтр Из СтрокиИсходныхЗначений Цикл
		ДобавляемаяСтрока = ЗначенияРеквизитовОпераций.Добавить();
		ЗаполнитьЗначенияСвойств(ДобавляемаяСтрока,НовСтр);		
	КонецЦикла;
		
	ДействияПриИзмененииТиповойОперации(ТиповаяОперация,Документ);
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьЗначенияДопРеквизитов()
	
	СтрокиЗначений = ЗначенияРеквизитовОпераций.НайтиСтроки(Новый Структура("Объект",ТекДокумент));
	Для Каждого СтрокаЗн Из СтрокиЗначений Цикл
		ЗначенияРеквизитовОпераций.Удалить(СтрокаЗн);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьЗначениеОтметки(Значение)
	
	Для Каждого СтрТЧ Из ТаблицаДокументов Цикл
		Если НЕ СтрТЧ.ТолькоПросмотр Тогда
			СтрТЧ.Использовать = Значение;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьДопРеквизитыСервер(ТекИдентификатор=0, Отказ = Ложь)
	
	Отказ = Ложь;
	
	ЗаписываемыеСтроки = ТаблицаДокументов.НайтиСтроки(Новый Структура("Использовать",1));
	
	Если ЗаписываемыеСтроки.Количество() = 0 Тогда
		ТекДанные = ТаблицаДокументов.НайтиПоИдентификатору(ТекИдентификатор);
		Если ТекДанные.ЕстьИзменения Тогда
			ТекДанные.Использовать = 1;
			ЗаписываемыеСтроки.Добавить(ТекДанные);
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Не отмечены записываемые строки.'"));
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
 	Для Каждого ЗаписываемаяСтрока Из ЗаписываемыеСтроки Цикл
		
		ТекущийОтказ = ЗаписываемаяСтрока.ЕстьИзменения;
		
		Документ 	= ЗаписываемаяСтрока.Документ;
		Операция 	= ЗаписываемаяСтрока.ТиповаяОперация;
				
		НачатьТранзакцию();
		
		Попытка
		
		//Запишем документ без внесения любых изменений, чтобы у него изменилась версия, 
		//и пользователь в другом сеансе не перезаписал случайно изменения.
		Попытка
			ДокОбъект = Документ.ПолучитьОбъект();
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокОбъект, Ложь, Ложь, РежимЗаписиДокумента.Запись);
		Исключение
			ТекОписаниеОшибки = ОписаниеОшибки();			
			ТекстСообщения = НСтр("ru='Ошибка записи документа по причине:
			|%1'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ТекОписаниеОшибки);
			ЗаписьЖурналаРегистрации("Обработка выписки", УровеньЖурналаРегистрации.Ошибка, , , ТекстСообщения);
			ВызватьИсключение ТекстСообщения;
		КонецПопытки;
		
 		БлокировкаДанных = Новый БлокировкаДанных;
		
		БлокировкаОпераций = БлокировкаДанных.Добавить("РегистрСведений.ОперацииДокументов");
		БлокировкаОпераций.УстановитьЗначение("Документ", Документ);
		БлокировкаОпераций.Режим = РежимБлокировкиДанных.Исключительный;
		
		БлокировкаЗначРек = БлокировкаДанных.Добавить("РегистрСведений.ЗначенияДополнительныхРеквизитовОпераций");
		БлокировкаЗначРек.УстановитьЗначение("Объект",Документ);
		БлокировкаЗначРек.Режим = РежимБлокировкиДанных.Исключительный;
		
		БлокировкаДанных.Заблокировать();
	
		ЗаписываемаяСтрока.Использовать = 0;
		
		ДанныеДляЗаписи = РегистрыСведений.ОперацииДокументов.ДанныеДляЗаписи(Документ);
		
		Если ЗначениеЗаполнено(Операция) Тогда
			ДанныеДляЗаписи.Операция = Операция;   
			ДатаОрганизация = БухгалтерскиеОперацииСервер.ПолучитьДатуИОрганизациюОперации(Документ,  Операция);
			ДанныеДляЗаписи.Дата = ДатаОрганизация.Дата;
			ДанныеДляЗаписи.Организация = ДатаОрганизация.Организация;
			//курс и кратность
			// Если необходимо, записываем курс и кратность в значения доп. реквизитов
			СтрЗн = СписокЗначенийВалУчета.НайтиПоЗначению(ЗаписываемаяСтрока.ИдентификаторДокумента.ЗначениеПустойСсылки);
			Если СтрЗн.Пометка Тогда
				СтрокиЗначения = ЗначенияРеквизитовОпераций.НайтиСтроки(Новый Структура("Объект, ИмяДляФормулы", Документ, "Курс"));
				Если СтрокиЗначения.Количество()>0 Тогда
					ДанныеДляЗаписи.Курс = СтрокиЗначения[0].Значение;
				КонецЕсли;
                СтрокиЗначения = ЗначенияРеквизитовОпераций.НайтиСтроки(Новый Структура("Объект,ИмяДляФормулы", Документ, "Кратность"));
				Если СтрокиЗначения.Количество()>0 Тогда
					ДанныеДляЗаписи.Кратность = СтрокиЗначения[0].Значение;
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
		
		РегистрыСведений.ОперацииДокументов.ЗаписатьОперацию(Документ, ДанныеДляЗаписи);	
		
		//Установим записанную операцию как исходную
		ЗаписываемаяСтрока.ТиповаяОперацияИсходная = Операция;		
		
		НаборЗаписейРеквизитов = РегистрыСведений.ЗначенияДополнительныхРеквизитовОпераций.СоздатьНаборЗаписей();
		НаборЗаписейРеквизитов.Отбор.Объект.Значение = Документ;
		НаборЗаписейРеквизитов.Отбор.Объект.Использование = Истина;
		НаборЗаписейРеквизитов.Записывать = Истина;
		
		//Очищаем значения реквизитов в таблице ЗначенияРеквизитовОперацийИсходные
		МассивУдаляемыхСтрок = ЗначенияРеквизитовОперацийИсходные.НайтиСтроки(Новый Структура("Объект",Документ));
		Для Каждого ЭлМас Из МассивУдаляемыхСтрок Цикл
			ЗначенияРеквизитовОперацийИсходные.Удалить(ЭлМас);
		КонецЦикла;
			
		Если ЗначениеЗаполнено(Операция) Тогда
				
			СтрокиДанныхОперации = ТаблицаОпераций.НайтиСтроки(Новый Структура("ТиповаяОперация",Операция));
			Если СтрокиДанныхОперации.Количество()>0 Тогда
				ТЧДопРек = СтрокиДанныхОперации[0].ДополнительныеРеквизиты;
				Идентификатор = СтрокиДанныхОперации[0].ПолучитьИдентификатор();
				Для Каждого СтрТЧ Из ТЧДопРек Цикл
					Если НЕ ЗначениеЗаполнено(СтрТЧ.РеквизитСсылка) Тогда
						Продолжить;
					КонецЕсли;
					ЗаписьНабораРеквизитов = НаборЗаписейРеквизитов.Добавить();
					ЗаписьНабораРеквизитов.Объект = Документ;
					ЗаписьНабораРеквизитов.РеквизитОперации = СтрТЧ.РеквизитСсылка;
					СтрокиЗначения = ЗначенияРеквизитовОпераций.НайтиСтроки(Новый Структура("Объект,ИмяДляФормулы",Документ,СтрТЧ.ИмяДляФормулы));
					Если СтрокиЗначения.Количество()>0 Тогда
						ЗаписьНабораРеквизитов.Значение = СтрокиЗначения[0].Значение;
					Иначе
						ЗаписьНабораРеквизитов.Значение = СтрТЧ.РеквизитПроводки.ТипЗначения.ПривестиЗначение(Неопределено);
					КонецЕсли;			 
					
				КонецЦикла;
				
				//Обновляем сохраненные значения
				Для Каждого СтрокаНабора Из НаборЗаписейРеквизитов Цикл
					ЗаполнитьЗначенияСвойств(ЗначенияРеквизитовОперацийИсходные.Добавить(),СтрокаНабора);
				КонецЦикла;
				Если СтрЗн.Пометка Тогда
					НовКурс = ЗначенияРеквизитовОперацийИсходные.Добавить();
					НовКурс.Объект = Документ;
					НовКурс.ИмяДляФормулы = "Курс";
					НовКурс.Значение = ДанныеДляЗаписи.Курс;//ЗаписьНабора.Курс;
									
					НовКратность = ЗначенияРеквизитовОперацийИсходные.Добавить();
					НовКратность.Объект = Документ;
					НовКратность.ИмяДляФормулы = "Кратность";
					НовКратность.Значение = ДанныеДляЗаписи.Кратность;//ЗаписьНабора.Кратность;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		НаборЗаписейРеквизитов.Записать(Истина);
		
		ЗаписываемаяСтрока.ЕстьИзменения = Ложь;
		
		Отказ = Отказ ИЛИ Ложь;
		
		ЗафиксироватьТранзакцию();
		
		Исключение
			ОтменитьТранзакцию();
			Отказ = Истина;
			ЗаписываемаяСтрока.ЕстьИзменения = ТекущийОтказ;
			ТекОписаниеОшибки = ОписаниеОшибки();
			ТекстСообщения =НСтр("ru='Ошибка записи дополнительных реквизитов операции документа в стр %1 по причине:
			|%2'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ТаблицаДокументов.Индекс(ЗаписываемаяСтрока), ТекОписаниеОшибки);
			ЗаписьЖурналаРегистрации("Обработка выписки", УровеньЖурналаРегистрации.Ошибка, , , ТекстСообщения);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,,);
		КонецПопытки;
		
		БлокировкаДанных = Неопределено;
		
	КонецЦикла;	
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Если ТаблицаДокументов.НайтиСтроки(Новый Структура("ЕстьИзменения", Истина)).Количество() = 0 Тогда
		ЭтаФорма.Модифицированность = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПометкиИзмененнымИЗаписать(Отказ)
	
	МассивСтрок = ТаблицаДокументов.НайтиСтроки(Новый Структура("ЕстьИзменения",Истина));
	
	Для Каждого ЭлМас Из МассивСтрок Цикл
		Если Не ЭлМас.ТолькоПросмотр Тогда
			ЭлМас.Использовать = 1;	
		КонецЕсли;
	КонецЦикла;
	
	ЗаписатьДопРеквизитыСервер(Неопределено,Отказ);
	
КонецПроцедуры

&НаСервере
Процедура ВыбратьДобавляемыеРеквизиты(Дерево, ДобавляемыеРеквизиты, ОбязательныеРеквизиты, ПовторноеЧтениеОбъекта, ВалютныйУчет, ИмяТабличнойЧасти = "",
	СуществующиеРеквизитыФормы, КонфликтыИменРеквизитов) Экспорт
	
	Для каждого СтрокаДерева Из Дерево.Строки Цикл
		
		Если ПовторноеЧтениеОбъекта И СтрокаДерева.НеПовторять Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаДерева.Валютный И НЕ ВалютныйУчет Тогда
			Продолжить;
		КонецЕсли;
	
		Если СтрокаДерева.ТипЭлемента.СодержитТип(Тип("ПолеФормы")) Тогда
			
			// проверка уникальности имени
			Если ЗначениеЗаполнено(ИмяТабличнойЧасти) Тогда
				СуществующиеРеквизитыТЧ = СуществующиеРеквизитыФормы.Получить(ВРЕГ(СтрокаДерева.Путь));
				Если СуществующиеРеквизитыТЧ.Найти(ВРЕГ(СтрокаДерева.Имя)) <> Неопределено Тогда
					// конфликт - колонка существует
					ИмяНовогоРеквизита = СтрокаДерева.Имя + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "_");
					КонфликтыИменРеквизитов.Добавить(СтрокаДерева.Путь + "." + СтрокаДерева.Имя, ИмяНовогоРеквизита);
				Иначе
					ИмяНовогоРеквизита = СтрокаДерева.Имя;
				КонецЕсли;
			Иначе
				ИмяНовогоРеквизита = СтрокаДерева.Имя;
			КонецЕсли;
			
			ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяНовогоРеквизита,
				СтрокаДерева.ТипЗначения, СтрокаДерева.Путь, СтрокаДерева.Заголовок, Истина));
			Если СтрокаДерева.Обязательный Тогда
				ПолноеИмяДопРеквизита = ?(ПустаяСтрока(ИмяТабличнойЧасти), "", ИмяТабличнойЧасти + ".") + СтрокаДерева.Имя;
				Если ТипЗнч(ОбязательныеРеквизиты) = Тип("СписокЗначений") Тогда
					ОбязательныеРеквизиты.Добавить(ПолноеИмяДопРеквизита, СтрокаДерева.Заголовок);
				Иначе
					ОбязательныеРеквизиты.Добавить(ПолноеИмяДопРеквизита);
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли СтрокаДерева.ТипЭлемента.СодержитТип(Тип("ГруппаФормы")) Тогда
			ВыбратьДобавляемыеРеквизиты(СтрокаДерева, ДобавляемыеРеквизиты, ОбязательныеРеквизиты, ПовторноеЧтениеОбъекта, ВалютныйУчет,,
				СуществующиеРеквизитыФормы, КонфликтыИменРеквизитов);
		ИначеЕсли СтрокаДерева.ТипЭлемента.СодержитТип(Тип("ТаблицаФормы")) Тогда
			Если НЕ СтрокаДерева.ПредопределеннаяТЧ Тогда
				ДобавляемыеРеквизиты.Добавить(
									Новый РеквизитФормы(СтрокаДерева.Имя,
														Новый ОписаниеТипов("ТаблицаЗначений"),
														СтрокаДерева.Путь,
														СтрокаДерева.Заголовок,
														Истина));
			КонецЕсли;
			ВыбратьДобавляемыеРеквизиты(СтрокаДерева, ДобавляемыеРеквизиты, ОбязательныеРеквизиты, ПовторноеЧтениеОбъекта, ВалютныйУчет, СтрокаДерева.Имя,
				СуществующиеРеквизитыФормы, КонфликтыИменРеквизитов);
				
		КонецЕсли;
	
	КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьЭлементыФормы(Знач Форма, Знач ДеревоЭлементов, Знач ПолеДляЭлементов, Знач ПолеДляДополнительныхТабЧастей, ПовторноеЧтениеОбъекта, ВалютныйУчет) Экспорт

	Если ПовторноеЧтениеОбъекта Тогда
		УдаляемыеЭлементыФормы = Новый Массив;
		МассивИсключений = Новый Массив;
		МассивИсключений.Добавить("ТиповыеОперации_ТиповаяОперацияДокумента");
		МассивИсключений.Добавить("ТиповыеОперации_КурсКратность");
		ВыбратьПодчиненныеЭлементыФормыРекурсивно(ПолеДляЭлементов, МассивИсключений, УдаляемыеЭлементыФормы);
		Для каждого ТекЭлемент Из УдаляемыеЭлементыФормы Цикл
			
			Если Форма.Элементы.Найти(ТекЭлемент) <> Неопределено Тогда
				Форма.Элементы.Удалить(Форма.Элементы[ТекЭлемент]);
			КонецЕсли;
		
		КонецЦикла; 
	КонецЕсли;
	
	Для каждого ТекСтрокаДерева Из ДеревоЭлементов.Строки Цикл
		
		Если ПовторноеЧтениеОбъекта И ТекСтрокаДерева.НеПовторять Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТекСтрокаДерева.Валютный И НЕ ВалютныйУчет Тогда
			Продолжить;
		КонецЕсли;
	
		Если ТекСтрокаДерева.ТипЭлемента.СодержитТип(Тип("ГруппаФормы")) Тогда
			НоваяГруппа = ДобавитьГруппуФормы(Форма, ТекСтрокаДерева, ПолеДляЭлементов);
			ОбновитьЭлементыФормы(Форма, ТекСтрокаДерева, НоваяГруппа,, Ложь, ВалютныйУчет);
		Иначе
			ДобавитьПолеФормы(Форма, ТекСтрокаДерева, ПолеДляЭлементов, БухгалтерскиеОперацииКлиентСервер.ПрефиксЭлементовОперации());
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ВыбратьПодчиненныеЭлементыФормыРекурсивно(ПолеДляЭлементов, Исключения, УдаляемыеЭлементыФормы)

	Для каждого ТекЭлемент Из ПолеДляЭлементов.ПодчиненныеЭлементы Цикл
		
		Если Исключения.Найти(ТекЭлемент.Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(ТекЭлемент) = Тип("ГруппаФормы") Тогда
			
			ВыбратьПодчиненныеЭлементыФормыРекурсивно(ТекЭлемент, Исключения, УдаляемыеЭлементыФормы);
			
		КонецЕсли;
		
		УдаляемыеЭлементыФормы.Добавить(ТекЭлемент.Имя);
	
	КонецЦикла; 	

КонецПроцедуры

&НаСервере
Функция ДобавитьГруппуФормы(Форма, ТекСтрокаДерева, ПолеДляЭлементов, Знач ПрефиксЭлементовОперации = "")

	Если Не ЗначениеЗаполнено(ПрефиксЭлементовОперации) Тогда
		ПрефиксЭлементовОперации = БухгалтерскиеОперацииКлиентСервер.ПрефиксЭлементовОперации();
	КонецЕсли;
	
	НовГруппа = Форма.Элементы.Добавить(ПрефиксЭлементовОперации+ТекСтрокаДерева.Имя,
										Тип("ГруппаФормы"),
										ПолеДляЭлементов);
	
	НовГруппа.Вид = ТекСтрокаДерева.ВидЭлемента;
	Если НовГруппа.Вид = ВидГруппыФормы.Страницы Тогда
		НовГруппа.ОтображениеСтраниц = ОтображениеСтраницФормы.ЗакладкиСверху;
	Иначе
		Группировка = ГруппировкаГруппыФормы(ТекСтрокаДерева.Группировка);
		Отображение = ОтображениеГруппыФормыПоСтроке(ТекСтрокаДерева.Отображение);
	
		НовГруппа.Группировка = Группировка;
		
		Если НовГруппа.Вид = ВидГруппыФормы.Страница Тогда
			
		Иначе
			НовГруппа.ОтображатьЗаголовок = ТекСтрокаДерева.ОтображатьЗаголовок;
			НовГруппа.Отображение = Отображение;
		КонецЕсли;
	КонецЕсли;
	НовГруппа.Заголовок = ТекСтрокаДерева.Заголовок;
	НовГруппа.РастягиватьПоГоризонтали = ТекСтрокаДерева.РастягиватьПоГоризонтали;
	
	Возврат НовГруппа;
	
КонецФункции // ДобавитьГруппуФормы()

&НаСервере
Процедура ДобавитьПолеФормы(Форма, ТекСтрокаДерева, ПолеДляЭлементов, ПрефиксЭлементовОперации, ПрефиксТЧ = "")
	
	Перем ТекущаяТаблицаФормы; 
	Перем Конфликт;
	
	// проверить по функциональным опциям
	Если ТекСтрокаДерева.ФункциональныеОпции.Количество() =0 Тогда
		СоответствуетФО = Истина;
	Иначе
		СоответствуетФО = Ложь;
		Для каждого ТекФО Из ТекСтрокаДерева.ФункциональныеОпции Цикл
			Если Форма.ПолучитьФункциональнуюОпциюФормы(ТекФО) = Истина Тогда
				СоответствуетФО = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Не СоответствуетФО Тогда
		Возврат;
	КонецЕсли;
	Если ТекСтрокаДерева.НевидимыйЭлемент = Истина Тогда
		Возврат;
	КонецЕсли;
	НовЭлемент = Форма.Элементы.Найти(ПрефиксЭлементовОперации+ТекСтрокаДерева.Имя);
	Если НовЭлемент = Неопределено Тогда
		// определим путь к данным, учитывая возможные конфликты имен
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма,"СписокЭлементовСКонфликтамиИмен") Тогда
			Конфликт = Форма.СписокЭлементовСКонфликтамиИмен.НайтиПоЗначению(ПрефиксТЧ + ТекСтрокаДерева.Имя);
		Иначе
			Конфликт = Неопределено;
		КонецЕсли;
		Если Конфликт = Неопределено Тогда
			НовЭлементПутьКДанным = ПрефиксТЧ + ТекСтрокаДерева.Имя;
		Иначе
			НовЭлементПутьКДанным = ПрефиксТЧ + Конфликт.Представление;
		КонецЕсли;
		НовЭлемент = Форма.Элементы.Добавить(ПрефиксЭлементовОперации+ТекСтрокаДерева.Имя,
											 Тип("ПолеФормы"),
											 ПолеДляЭлементов);
		НовЭлемент.ПутьКДанным = НовЭлементПутьКДанным;
	КонецЕсли;
	НовЭлемент.Заголовок 			= ?(Конфликт = Неопределено, "", НСтр("ru = '<конфликт> '")) + ТекСтрокаДерева.Заголовок;
	НовЭлемент.Вид 					= ТекСтрокаДерева.ВидЭлемента;
	НовЭлемент.ПоложениеЗаголовка	= ТекСтрокаДерева.ПоложениеЗаголовка;
	
	Если ТекСтрокаДерева.ВидЭлемента = ВидПоляФормы.ПолеВвода Тогда
		НовЭлемент.АвтоОтметкаНезаполненного	= ТекСтрокаДерева.Обязательный;
		НовЭлемент.РастягиватьПоГоризонтали 	= ТекСтрокаДерева.РастягиватьПоГоризонтали;
		НовЭлемент.Ширина						= ТекСтрокаДерева.ШиринаЭлемента;
		НовЭлемент.ОграничениеТипа				= ТекСтрокаДерева.ТипЗначения;
		
		СвязиПараметровВыбора = ТекСтрокаДерева.СвязиПараметровВыбора;
		Если ТипЗнч(СвязиПараметровВыбора) = Тип("Массив") Тогда
			
			ЭтоКВДилиКФО = ТекСтрокаДерева.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов")
						ИЛИ ТекСтрокаДерева.ТипЗначения = Новый ОписаниеТипов("ПеречислениеСсылка.КВД");
			
			НовыйСвязиПараметровВыбора = Новый Массив;
			Для каждого ТекущаяСвязь Из СвязиПараметровВыбора Цикл
			
				РазложениеПутиКДанным = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекущаяСвязь.ПутьКДанным, ".");
				Если РазложениеПутиКДанным.Количество() = 2 Тогда
					Если ВРег(РазложениеПутиКДанным[0]) = "ОБЪЕКТ" Тогда
						Если ЭтоКВДилиКФО И ВРег(РазложениеПутиКДанным[1]) = "ДАТА" Тогда
							НовыйСвязиПараметровВыбора.Добавить(Новый СвязьПараметраВыбора(	ТекущаяСвязь.Имя,
																							ТекущаяСвязь.ПутьКДанным,
																							РежимИзмененияСвязанногоЗначения.НеИзменять));
						Иначе
							НовыйСвязиПараметровВыбора.Добавить(ТекущаяСвязь);
						КонецЕсли;
					Иначе
						НовыйСвязиПараметровВыбора.Добавить(ТекущаяСвязь);
					КонецЕсли;
				Иначе
					НовыйСвязиПараметровВыбора.Добавить(ТекущаяСвязь);
				КонецЕсли;
				
			
			КонецЦикла;
			
			Попытка
				НовЭлемент.СвязиПараметровВыбора = Новый ФиксированныйМассив(НовыйСвязиПараметровВыбора);
			Исключение
				// не обрабатывается
			КонецПопытки;

		КонецЕсли;

		Если ТипЗнч(ТекСтрокаДерева.ПараметрыВыбора) = Тип("Массив") Тогда
			НовЭлемент.ПараметрыВыбора = Новый ФиксированныйМассив(ТекСтрокаДерева.ПараметрыВыбора);
		КонецЕсли;
		
		ОписаниеСвязиПоТипу = ДетальноеОписаниеСвязиПоТипу(ТекСтрокаДерева.СвязиПоТипу);
		Если ЗначениеЗаполнено(ТекСтрокаДерева.СвязиПоТипу) Тогда
			
			Попытка
			
				НовЭлемент.СвязьПоТипу = Новый СвязьПоТипу(ОписаниеСвязиПоТипу.ИмяСвязи, ОписаниеСвязиПоТипу.ПорядокСвязи);
			
			Исключение
				// не обрабатываем исключение
			КонецПопытки;
			
		КонецЕсли;
		
		Если ТекСтрокаДерева.ПараметрыВыбора.Количество() > 0 Тогда
			НовЭлемент.ПараметрыВыбора = Новый ФиксированныйМассив(ТекСтрокаДерева.ПараметрыВыбора);
		КонецЕсли;

	КонецЕсли;
	
	Если НЕ ПустаяСтрока(ТекСтрокаДерева.НачалоВыбора) Тогда
		НовЭлемент.УстановитьДействие("НачалоВыбора",ТекСтрокаДерева.НачалоВыбора);
	КонецЕсли;
	Если НЕ ПустаяСтрока(ТекСтрокаДерева.ПриИзменении) Тогда
		НовЭлемент.УстановитьДействие("ПриИзменении",ТекСтрокаДерева.ПриИзменении);
	КонецЕсли;
	
	НовЭлемент.ЦветФона = ТекСтрокаДерева.ЦветФона;
	
	Если ТекСтрокаДерева.ЗапретитьИзменение = Истина Тогда
		НовЭлемент.ТолькоПросмотр = Истина;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ГруппировкаГруппыФормы(Знач Группировка)

	Если ТипЗнч(Группировка) = Тип("Строка") Тогда
		Если Группировка = "Горизонтальная" Тогда
			Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
		Иначе
			Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Группировка) <> Тип("ГруппировкаПодчиненныхЭлементовФормы") Тогда
    	Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	КонецЕсли;
	
	Возврат Группировка;
	
КонецФункции // _ГруппировкаГруппыФормыПоСтроке()

&НаСервере
Функция ОтображениеГруппыФормыПоСтроке(СтроковоеПредставление)

	Отображение = ОтображениеОбычнойГруппы.Нет;
	Если СтроковоеПредставление = "Линия" Тогда
		Отображение = ОтображениеОбычнойГруппы["Линия"];
	ИначеЕсли СтроковоеПредставление = "Отступ" Тогда
		Отображение = ОтображениеОбычнойГруппы["Отступ"];
	ИначеЕсли СтроковоеПредставление = "РамкаГруппы" Тогда
		Отображение = ОтображениеОбычнойГруппы["РамкаГруппы"];
	ИначеЕсли СтроковоеПредставление = "СильноеВыделение" Тогда
		Отображение = ОтображениеОбычнойГруппы["СильноеВыделение"];
	ИначеЕсли СтроковоеПредставление = "СлабоеВыделение" Тогда
		Отображение = ОтображениеОбычнойГруппы["СлабоеВыделение"];
	ИначеЕсли СтроковоеПредставление = "ОбычноеВыделение" Тогда
		Отображение = ОтображениеОбычнойГруппы["ОбычноеВыделение"];
	КонецЕсли;
	Возврат Отображение;

КонецФункции // _ОтображениеГруппыФормыПоСтроке()

&НаСервере
Функция ДетальноеОписаниеСвязиПоТипу(СвязиПоТипу) Экспорт

	Результат = Новый Структура;
	Если НЕ ЗначениеЗаполнено(СвязиПоТипу) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ПозицияОткрСкобки = СтрНайти(СвязиПоТипу, "(");
	ПозицияЗакрСкобки = СтрНайти(СвязиПоТипу, ")");
	
	ТипЧисло = Новый ОписаниеТипов("Число");
	
	Если ПозицияОткрСкобки > 0 И ПозицияЗакрСкобки > ПозицияОткрСкобки Тогда
		
		Результат.Вставить("ИмяСвязи", Лев(СвязиПоТипу, ПозицияОткрСкобки - 1));
		Результат.Вставить("ПорядокСвязи",
			ТипЧисло.ПривестиЗначение(Сред(СвязиПоТипу, ПозицияОткрСкобки + 1, ПозицияЗакрСкобки - ПозицияОткрСкобки - 1)));
	
	КонецЕсли;
	
	Возврат Результат;

КонецФункции // ДетальноеОписаниеСвязиПоТипу()

&НаСервере
Функция ПустоеДеревоЭлементовФормы()

	Результат = Новый ДеревоЗначений;
	
	ТипыГруппировок = Новый Массив;
	ТипыГруппировок.Добавить(Тип("ГруппировкаПодчиненныхЭлементовФормы"));
	ТипыГруппировок.Добавить(Тип("ГруппировкаКолонок"));
	ОписаниеТипаГруппировок = Новый ОписаниеТипов(ТипыГруппировок);
	// общие для группы и элемента
	Результат.Колонки.Добавить("Имя",						Новый ОписаниеТипов("Строка"));  
	Результат.Колонки.Добавить("Заголовок",					Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("РастягиватьПоГоризонтали",	Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("ТипЭлемента",				Новый ОписаниеТипов("ОписаниеТипов"));
	Результат.Колонки.Добавить("ВидЭлемента",				Новый ОписаниеТипов("Неопределено"));
	Результат.Колонки.Добавить("Валютный",					Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("Подсказка",					Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("НеПовторять",				Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("НевидимыйЭлемент",			Новый ОписаниеТипов("Булево"));
	// реквизиты группы
	Результат.Колонки.Добавить("ОтображатьЗаголовок",		Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("Группировка",				ОписаниеТипаГруппировок);
	Результат.Колонки.Добавить("ШиринаПодчиненныхЭлементов",Новый ОписаниеТипов("ШиринаПодчиненныхЭлементовФормы"));
	Результат.Колонки.Добавить("Отображение",				Новый ОписаниеТипов("Строка"));
	// реквизиты команды
	Результат.Колонки.Добавить("Действие",					Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ИмяКартинки",				Новый ОписаниеТипов("Строка"));
	// реквизиты элемента
	Результат.Колонки.Добавить("ТипЗначения",				Новый ОписаниеТипов("ОписаниеТипов"));
	Результат.Колонки.Добавить("Реквизит",					Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Путь",						Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Обязательный",				Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("СвязиПараметровВыбора",		Новый ОписаниеТипов("Неопределено"));
	Результат.Колонки.Добавить("СвязиПоТипу",				Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("СтруктураСвязиПоТипу",		Новый ОписаниеТипов("Неопределено"));
	Результат.Колонки.Добавить("ПараметрыВыбора",			Новый ОписаниеТипов("Массив"));
	Результат.Колонки.Добавить("ПоложениеЗаголовка",		Новый ОписаниеТипов("ПоложениеЗаголовкаЭлементаФормы"));
	Результат.Колонки.Добавить("ЦветФона",					Новый ОписаниеТипов("Цвет"));
	Результат.Колонки.Добавить("ШиринаЭлемента",			Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("ПредопределеннаяТЧ",		Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("ФункциональныеОпции",		Новый ОписаниеТипов("Массив"));
	Результат.Колонки.Добавить("ЗапретитьИзменение",		Новый ОписаниеТипов("Булево"));
	// реквизиты подключаемые процедуры
	Результат.Колонки.Добавить("НачалоВыбора",				Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ПриИзменении",				Новый ОписаниеТипов("Строка"));

	Возврат Результат;
	
КонецФункции // _ПустоеДеревоЭлементовФормы()

&НаСервере
Функция ДеревоЭлементовФормыТиповойОперации(ТиповаяОперация, ИдентификаторДокумента)

	Результат = ПустоеДеревоЭлементовФормы();
	
	ГруппаТиповаяОперация = Результат.Строки.Добавить();
	ГруппаТиповаяОперация.Имя							= БухгалтерскиеОперацииКлиентСервер.ИмяГруппыДляВыводаТиповойОперацииНаФорму();
	ГруппаТиповаяОперация.Заголовок						= "Типовая операция документа";
	ГруппаТиповаяОперация.РастягиватьПоГоризонтали		= Истина;
	ГруппаТиповаяОперация.ТипЭлемента					= Новый ОписаниеТипов("ГруппаФормы");
	ГруппаТиповаяОперация.ВидЭлемента					= ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаТиповаяОперация.ОтображатьЗаголовок			= Ложь;
	ГруппаТиповаяОперация.Группировка					= ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	ГруппаТиповаяОперация.ШиринаПодчиненныхЭлементов	= ШиринаПодчиненныхЭлементовФормы.Авто;
	ГруппаТиповаяОперация.Отображение					= "Нет";
	ГруппаТиповаяОперация.НеПовторять					= Истина;

	
	ЭлементГруппы = ГруппаТиповаяОперация.Строки.Добавить();
	ЭлементГруппы.Имя							= "ТиповаяОперация";
	ЭлементГруппы.Заголовок						= "Типовая операция";
	ЭлементГруппы.РастягиватьПоГоризонтали		= Истина;
	ЭлементГруппы.ТипЭлемента					= Новый ОписаниеТипов("ПолеФормы");
	ЭлементГруппы.ВидЭлемента					= ВидПоляФормы.ПолеВвода;
	ЭлементГруппы.ЦветФона						= Новый Цвет(255, 232,179);
	ЭлементГруппы.ТипЗначения					= Новый ОписаниеТипов("СправочникСсылка.ТиповыеОперации");
	ЭлементГруппы.Реквизит						= "ТиповаяОперация";
	ЭлементГруппы.Обязательный					= Ложь;
	ЭлементГруппы.СвязиПараметровВыбора			= "";
	ЭлементГруппы.ПоложениеЗаголовка			= ПоложениеЗаголовкаЭлементаФормы.Авто;
	ЭлементГруппы.ШиринаЭлемента				= 0;
	ЭлементГруппы.НачалоВыбора					= "Подключаемый_ПриНачалеВыбораТиповойОперации";
	ЭлементГруппы.ПриИзменении					= "Подключаемый_ПриИзмененииТиповойОперации";
	Если ЗначениеЗаполнено(ИдентификаторДокумента) Тогда
		ЭлементГруппы.ПараметрыВыбора.Добавить(Новый ПараметрВыбора("Отбор.ИдентификаторДокумента", 
												ИдентификаторДокумента));
	КонецЕсли;
	ЭлементГруппы.НеПовторять					= Истина;
	
	Если ТипЗнч(ИдентификаторДокумента.ЗначениеПустойСсылки) <> Тип("ДокументСсылка.ОперацияБух") Тогда
		ЭлементГруппы = ГруппаТиповаяОперация.Строки.Добавить();
		ЭлементГруппы.Имя							= "ОткрытьОперацию";
		ЭлементГруппы.Заголовок						= "Предварительный просмотр";
		ЭлементГруппы.РастягиватьПоГоризонтали		= Ложь;
		ЭлементГруппы.ТипЭлемента					= Новый ОписаниеТипов("КомандаФормы");
		ЭлементГруппы.Действие						= "Подключаемый_КомандаОткрытьОперацию";
		ЭлементГруппы.Подсказка						= НСтр("ru = 'Предварительный просмотр проводок до проведения документа'");
		ЭлементГруппы.Реквизит						= "ОткрытьОперацию";
		ЭлементГруппы.ИмяКартинки 					= "ДебетКредит";
		ЭлементГруппы.НеПовторять					= Истина;
	КонецЕсли;
	
	ГруппаВалютныйУчет = Результат.Строки.Добавить();
	ГруппаВалютныйУчет.Имя								= "КурсКратность";
	ГруппаВалютныйУчет.Заголовок						= "Курс и кратность валюты";
	ГруппаВалютныйУчет.РастягиватьПоГоризонтали			= Истина;
	ГруппаВалютныйУчет.ТипЭлемента						= Новый ОписаниеТипов("ГруппаФормы");
	ГруппаВалютныйУчет.ВидЭлемента						= ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаВалютныйУчет.ОтображатьЗаголовок				= Ложь;
	ГруппаВалютныйУчет.Группировка						= ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	ГруппаВалютныйУчет.ШиринаПодчиненныхЭлементов		= ШиринаПодчиненныхЭлементовФормы.Авто;
	ГруппаВалютныйУчет.Валютный							= Истина;
	ГруппаВалютныйУчет.НеПовторять						= Истина;
	
	ЭлементГруппы = ГруппаВалютныйУчет.Строки.Добавить();
	ЭлементГруппы.Имя							= "Курс";
	ЭлементГруппы.Заголовок						= "Курс";
	ЭлементГруппы.РастягиватьПоГоризонтали		= Ложь;
	ЭлементГруппы.ТипЭлемента					= Новый ОписаниеТипов("ПолеФормы");
	ЭлементГруппы.ВидЭлемента					= ВидПоляФормы.ПолеВвода;
	ЭлементГруппы.ТипЗначения					= Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10,4));
	ЭлементГруппы.Реквизит						= "Курс";
	ЭлементГруппы.Обязательный					= Истина;
	ЭлементГруппы.СвязиПараметровВыбора			= "";
	ЭлементГруппы.ПоложениеЗаголовка			= ПоложениеЗаголовкаЭлементаФормы.Авто;
	ЭлементГруппы.ШиринаЭлемента				= 0;
	ЭлементГруппы.Валютный						= Истина;
	ЭлементГруппы.ЦветФона						= Новый Цвет;
	ЭлементГруппы.НеПовторять					= Истина;
	
	ЭлементГруппы = ГруппаВалютныйУчет.Строки.Добавить();
	ЭлементГруппы.Имя							= "Кратность";
	ЭлементГруппы.Заголовок						= "Кратность";
	ЭлементГруппы.РастягиватьПоГоризонтали		= Ложь;
	ЭлементГруппы.ТипЭлемента					= Новый ОписаниеТипов("ПолеФормы");
	ЭлементГруппы.ВидЭлемента					= ВидПоляФормы.ПолеВвода;
	ЭлементГруппы.ТипЗначения					= Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10,0));
	ЭлементГруппы.Реквизит						= "Кратность";
	ЭлементГруппы.Обязательный					= Истина;
	ЭлементГруппы.СвязиПараметровВыбора			= "";
	ЭлементГруппы.ПоложениеЗаголовка			= ПоложениеЗаголовкаЭлементаФормы.Авто;
	ЭлементГруппы.ШиринаЭлемента				= 0;
	ЭлементГруппы.Валютный						= Истина;
	ЭлементГруппы.ЦветФона						= Новый Цвет;
	ЭлементГруппы.НеПовторять					= Истина;
	
	ЭлементГруппы = ГруппаВалютныйУчет.Строки.Добавить();
	ЭлементГруппы.Имя							= "ОбновитьКурсВалюты";
	ЭлементГруппы.Заголовок						= "Обновить курс";
	ЭлементГруппы.РастягиватьПоГоризонтали		= Ложь;
	ЭлементГруппы.ТипЭлемента					= Новый ОписаниеТипов("КомандаФормы");
	ЭлементГруппы.Действие						= "Подключаемый_ОбновитьКурсВалюты";
	ЭлементГруппы.Реквизит						= "ОбновитьКурсВалюты";
	ЭлементГруппы.Валютный						= Истина;
	ЭлементГруппы.НеПовторять					= Истина;
	
	Если ЗначениеЗаполнено(ТиповаяОперация) Тогда
		ДополнитьДеревоЭлементовТиповойОперацииДополнительнымиРеквизитами(Результат, ТиповаяОперация);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // ДеревоЭлементовФормыТиповойОперации()

&НаСервере
Процедура ДополнитьДеревоЭлементовТиповойОперацииДополнительнымиРеквизитами(ДеревоРезультат, ТиповаяОперация)
	
	ОперацияСвойства = ДеревоРеквизитовОпераций.Строки.Найти(ТиповаяОперация, "Операция");
	
	Если ОперацияСвойства = Неопределено Тогда
		//Операция не имеет реквизитов
		ОперацияСвойства = Новый ДеревоЗначений;
	КонецЕсли;		
	
	Выборка = ОперацияСвойства.Строки;
	
	ДобавитьЭлементыДополнительныхРеквизитов(Выборка, ДеревоРезультат, Неопределено, Неопределено);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьЭлементыДополнительныхРеквизитов(ВыборкаЭлементы, ТекущаяСтрокаДерева, ОперацияНаПоддержке, ТекущаяСсылка)
	
	Для каждого ТекСтрока Из ВыборкаЭлементы Цикл
		
		Если ТекСтрока.Ссылка = ТекущаяСсылка Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТекСтрока.ЭтоГруппа Тогда
			
			Для Каждого СтрокаГруппы Из ТекСтрока.Строки Цикл
				Если ТекСтрока.Ссылка = СтрокаГруппы.Ссылка Тогда
					Если СтрокаГруппы.Строки.Количество() > 0 Тогда
						НоваяГруппа = ДобавитьГруппуДополнительныхРеквизитов(СтрокаГруппы.Строки[0], ТекущаяСтрокаДерева);
					Иначе
						НоваяГруппа = ДобавитьГруппуДополнительныхРеквизитов(СтрокаГруппы, ТекущаяСтрокаДерева);
					КонецЕсли;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			ДобавитьЭлементыДополнительныхРеквизитов(ТекСтрока.Строки, НоваяГруппа, ОперацияНаПоддержке, ТекСтрока.Ссылка);
			
		Иначе
			
			СтрокаТиповойОперации = ТекСтрока.Строки[0];
			
			ДобавитьЭлементДополнительныхРеквизитов(СтрокаТиповойОперации, ТекущаяСтрокаДерева);
			
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьЭлементДополнительныхРеквизитов(ТекСтрока, ТекущаяСтрокаДерева)
	
	ЭлементГруппы = ТекущаяСтрокаДерева.Строки.Добавить();
	ЭлементГруппы.Имя							= ТекСтрока.ИмяДляФормулы;
	ЭлементГруппы.Заголовок						= ТекСтрока.Наименование;
	ЭлементГруппы.РастягиватьПоГоризонтали		= ?(ТекСтрока.РастягиватьПоГоризонтали = NULL, ЛОЖЬ, ТекСтрока.РастягиватьПоГоризонтали);
	ЭлементГруппы.ТипЭлемента					= Новый ОписаниеТипов("ПолеФормы");
	ЭлементГруппы.ВидЭлемента					= ВидПоляФормыПоСохраненномуЗначению(ТекСтрока.ВидЭлемента);
	ЭлементГруппы.ТипЗначения					= ТекСтрока.РеквизитПроводкиТипЗначения;
	ЭлементГруппы.Реквизит						= ТекСтрока.РеквизитПроводки;
	ЭлементГруппы.Обязательный					= ?(ТекСтрока.Обязательный = NULL, ЛОЖЬ, ТекСтрока.Обязательный)
												И НЕ ОбщегоНазначения.ОписаниеТипаСостоитИзТипа(ЭлементГруппы.ТипЗначения, Тип("Булево"));
	ЭлементГруппы.СвязиПараметровВыбора			= "";
	ЭлементГруппы.ПоложениеЗаголовка			= ПоложениеЗаголовкаЭлементаПоСохраненномуЗначению(ТекСтрока.ПоложениеЗаголовка);
	ЭлементГруппы.ШиринаЭлемента				= ТекСтрока.ШиринаПоляВвода;
	ЭлементГруппы.ЦветФона						= Новый Цвет;
	ЭлементГруппы.ПриИзменении					= "Подключаемый_ПриИзмененииДопРеквизита";
	Если ЭлементГруппы.ВидЭлемента = ВидПоляФормы.ПолеВвода Тогда
		ЭлементГруппы.НачалоВыбора				= "Подключаемый_ПриНачалеВыбораДопРеквизита";
	КонецЕсли;
	ЭлементГруппы.ФункциональныеОпции			= ФункциональныеОпцииРеквизитаТиповойОперации(ТекСтрока.Ссылка);
	ЭлементГруппы.ЗапретитьИзменение			= ?(ТекСтрока.ЗапретитьИзменение = NULL, ЛОЖЬ, ТекСтрока.ЗапретитьИзменение);
	ЭлементГруппы.НевидимыйЭлемент				= ?(ТекСтрока.НевидимыйЭлемент = NULL, ЛОЖЬ, ТекСтрока.НевидимыйЭлемент);
	
	Если Лев(ТекСтрока.СвязиПараметровВыбора, 4)="{""#""" Тогда
		СвязиПараметровВыбора = ЗначениеИзСтрокиВнутр(?(ТекСтрока.СвязиПараметровВыбора = NULL, "", ТекСтрока.СвязиПараметровВыбора));
		Массив = Новый Массив;
		Для каждого ТекСвязь Из СвязиПараметровВыбора Цикл
			
			Массив.Добавить(Новый СвязьПараметраВыбора(	ТекСвязь.Имя,
														ТекСвязь.Реквизит,
														?(	ТекСвязь.Режим = "Очищать",
															РежимИзмененияСвязанногоЗначения.Очищать,
															РежимИзмененияСвязанногоЗначения.НеИзменять)));
			
		КонецЦикла; 
		ЭлементГруппы.СвязиПараметровВыбора		= Массив;
	КонецЕсли;
	ЭлементГруппы.СвязиПоТипу					= ?(ТекСтрока.СвязиПоТипу = NULL, "", ТекСтрока.СвязиПоТипу);
	
	Если НЕ ПустаяСтрока(?(ТекСтрока.ОтборЭлементов = NULL, "", ТекСтрока.ОтборЭлементов)) Тогда
		ПараметрыВыбора = Новый Массив;
		ПараметрыВыбора.Добавить(Новый ПараметрВыбора("ПредустановленныйОтбор", ТекСтрока.ОтборЭлементов));
		// для перечислений добавим текст запроса для СКД обрабатываемой при получении списка выбора.
		Если Перечисления.ТипВсеСсылки().СодержитТип(ТекСтрока.РеквизитПроводкиТипЗначения.Типы()[0]) Тогда
			ТекстЗапросаОтбора = "Выбрать * Из Перечисление."+Метаданные.НайтиПоТипу(ТекСтрока.РеквизитПроводкиТипЗначения.Типы()[0]).Имя+" Как Переч";
			ПараметрыВыбора.Добавить(Новый ПараметрВыбора("ТекстЗапросаОтбора", ТекстЗапросаОтбора));
		КонецЕсли;
		ЭлементГруппы.ПараметрыВыбора			= ПараметрыВыбора;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ДобавитьГруппуДополнительныхРеквизитов(ТекСтрока, ТекущаяСтрокаДерева)
	
	НоваяГруппа = ТекущаяСтрокаДерева.Строки.Добавить();
	НоваяГруппа.Имя								= ТекСтрока.ИмяДляФормулы;
	НоваяГруппа.Заголовок						= ТекСтрока.Наименование;
	НоваяГруппа.РастягиватьПоГоризонтали		= ?(ТекСтрока.РастягиватьПоГоризонтали = NULL, ЛОЖЬ, ТекСтрока.РастягиватьПоГоризонтали);
	НоваяГруппа.ТипЭлемента						= Новый ОписаниеТипов("ГруппаФормы");
	НоваяГруппа.ВидЭлемента						= ВидГруппыФормыПоСохраненномуЗначению(?(ТекСтрока.ВидЭлемента = NULL, 0, ТекСтрока.ВидЭлемента));
	НоваяГруппа.ОтображатьЗаголовок				= ?(ТекСтрока.ОтображатьЗаголовок = NULL, ЛОЖЬ, ТекСтрока.ОтображатьЗаголовок);
	НоваяГруппа.Группировка						= ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	НоваяГруппа.ШиринаПодчиненныхЭлементов		= ШиринаПодчиненныхЭлементовПоСохраненномуЗначению(ТекСтрока.ШиринаПодчиненныхЭлементов);
	НоваяГруппа.Отображение						= ОтображениеГруппыФормыПоСохраненномуЗначению(ТекСтрока.Отображение);
	НоваяГруппа.НевидимыйЭлемент				= ?(ТекСтрока.НевидимыйЭлемент = NULL, ЛОЖЬ, ТекСтрока.НевидимыйЭлемент);
	НоваяГруппа.ФункциональныеОпции				= ФункциональныеОпцииРеквизитаТиповойОперации(ТекСтрока.Ссылка);

	Возврат НоваяГруппа;
	
КонецФункции

&НаСервере
Функция ФункциональныеОпцииРеквизитаТиповойОперации(Ссылка)
	
	ТабПоСсылке = ТабФОРеквизитов.Скопировать(Новый Структура("Ссылка", Ссылка));
	
	Возврат ТабПоСсылке.ВыгрузитьКолонку("ИмяФункциональнойОпции");
	
КонецФункции	

&НаСервере
Функция ВидПоляФормыПоСохраненномуЗначению(СохраненноеЗначение)
	
	Если СохраненноеЗначение = 1 Тогда
		Возврат ВидПоляФормы.ПолеФлажка;
	Иначе
