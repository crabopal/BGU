
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДокументУчетаНФА = Параметры.ДокументУчетаНФА;
    РезультатЭДО = Параметры.РезультатЭДО;
	ОбщееСостояниеЭДО = ЭлектронныеДокументыБГУВызовСервера.СостояниеЭДОАктамиПоДокументуПередачи(ДокументУчетаНФА);
	НовоеОбщееСостояниеЭДО = ОбщееСостояниеЭДО;
	
	КодВидаИнтерфейса = ПолучитьВидИнтерфейса();

	Если РезультатЭДО.Завершен Тогда
		ЭДОЗавершен = Истина;
	КонецЕсли;
	
	СоздатьКнопкуДляИзмененияОбщегоСостоянияЭДО(ЭтаФорма, "НовоеОбщееСостояниеЭДО", Элементы.ГруппаСостояниеЭДО);

	ОбновитьСостояниеЭДОАктаПоФорме0510448НаСервере(РезультатЭДО);	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "ОбновитьСостояниеЭДАктов" Тогда
		ОбновитьСостояниеЭДОАктаПоФорме0510448НаКлиенте();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СостояниеЭДООтправленныйАктНажатие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ЭлектронныеДокументыБГУКлиент.ОткрытьВнешнийЭлектронныйДокументБЭД(ЭтотОбъект.ОтправленныйАкт);
КонецПроцедуры

&НаКлиенте
Процедура СостояниеЭДООтветныйАктПолучателяНажатие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ЭлектронныеДокументыБГУКлиент.ОткрытьВнешнийЭлектронныйДокументБЭД(ЭтотОбъект.ОтветныйАктПолучателяНФА);
КонецПроцедуры

&НаКлиенте
Процедура СостояниеЭДОПолученныйАктНажатие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ЭлектронныеДокументыБГУКлиент.ОткрытьВнешнийЭлектронныйДокументБЭД(ЭтотОбъект.ПолученныйАкт);
КонецПроцедуры

&НаКлиенте
Процедура СостояниеЭДООтветныйАктНажатие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ЭлектронныеДокументыБГУКлиент.ОткрытьВнешнийЭлектронныйДокументБЭД(ЭтотОбъект.ОтветныйАкт);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СформироватьПредставлениеДокумента(ИсходящийДокумент)
	ДвоичныеДанныеПредставленияДокумента = Неопределено;
	
	Формат = ТипФайлаТабличногоДокумента.MXL;
	ИдентификаторКомандыПечати = "АктОПриемеПередачеОбъектовНФАЭлектронный";
	ОбъектУчета = ИсходящийДокумент;
	
	МетаданныеОбъекта = ОбъектУчета.Метаданные();
	
	ПолноеИмяФормы = МетаданныеОбъекта.ОсновнаяФормаОбъекта.Имя;
	СписокОбъектов = Новый Массив();
	СписокОбъектов.Добавить(МетаданныеОбъекта);
	
	МассивОбъектовУчета = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ОбъектУчета);
	НастройкиСохранения = УправлениеПечатью.НастройкиСохранения();
	НастройкиСохранения.ФорматыСохранения.Добавить(Формат);
	
	КомандыПечати = УправлениеПечатью.КомандыПечатиФормы(ПолноеИмяФормы, СписокОбъектов);
	НайденнаяКоманда = КомандыПечати.Найти(ИдентификаторКомандыПечати, "Идентификатор");
	Если НайденнаяКоманда = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КомандаПечатиВФайл = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(НайденнаяКоманда);

	Попытка
		РезультатПечати = УправлениеПечатью.НапечататьВФайл(КомандаПечатиВФайл, МассивОбъектовУчета, НастройкиСохранения);
	Исключение
		ТекстСообщения  = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не удалось сформировать на сервере печатную форму ""%1"" для формуляра документа ""%2"".'"), НайденнаяКоманда, ОбъектУчета);
		Сообщение       = Новый СообщениеПользователю();
		Сообщение.Текст = ТекстСообщения;
		Сообщение.Сообщить();
	КонецПопытки;
	
	Если ЗначениеЗаполнено(РезультатПечати) Тогда
		ДвоичныеДанныеПредставленияДокумента = РезультатПечати[0].ДвоичныеДанные;
	КонецЕсли;

	ПредставлениеДокументаMXL = ЭлектронныеДокументыБГУ.ТабличныйДокументИзДвоичныхДанных(ДвоичныеДанныеПредставленияДокумента);
	ПредставлениеДокументаMXL.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ПредставлениеДокументаMXL.АвтоМасштаб = Истина;
	
КонецПроцедуры	

&НаСервере
Функция ПолучитьВидИнтерфейса()
	Результат = ЭлектронныеДокументыБГУ.СторонаОбменаЭлектроннымиАктамиОПриемеПередачеНФА(ДокументУчетаНФА);
	
	Возврат Результат;	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма, КодВидаИнтерфейса, ЭДОЗавершен)

	Элементы = Форма.Элементы;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаВизуализацииДокумента", "Видимость", ЭДОЗавершен);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаОтправителя", "Видимость", КодВидаИнтерфейса = 1);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаПолучателя", "Видимость", КодВидаИнтерфейса = 2);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСостояниеЭДОАктаПоФорме0510448НаКлиенте()
	ОбновитьСостояниеЭДОАктаПоФорме0510448НаСервере();
КонецПроцедуры

&НаСервере
Процедура ОбновитьСостояниеЭДОАктаПоФорме0510448НаСервере(РезультатЭДО = Неопределено)
	
	Если РезультатЭДО = Неопределено Тогда
		РезультатЭДО = ЭлектронныеДокументыБГУВызовСервера.РезультатОбменаАктамиОПриемеПередачеНФА(ДокументУчетаНФА);
	КонецЕсли;	
	
	Если КодВидаИнтерфейса = 1 Тогда
		ЭтотОбъект.Заголовок = НСтр("ru='Электронный акт о приеме-передаче НФА ф.0510448'");
		ОтправленныйАкт = РезультатЭДО.ИсходящийДокументЭлектронногоАкта;
		ОтветныйАктПолучателяНФА = РезультатЭДО.ВходящийДокументЭлектронногоАкта;

		СостояниеЭДООтправленныйАкт = РезультатЭДО.СостояниеЭДОИсходящийДокументЭлектронногоАкта;
		СостояниеЭДООтветныйАктПолучателя = РезультатЭДО.СостояниеЭДОВходящийДокументЭлектронногоАкта;

		СформироватьПредставлениеДокумента(ОтправленныйАкт);
	ИначеЕсли КодВидаИнтерфейса = 2 Тогда
		ЭтотОбъект.Заголовок = НСтр("ru='Электронный акт о приеме-передаче НФА ф.0510448'");
		ПолученныйАкт = РезультатЭДО.ВходящийДокументЭлектронногоАкта;
		ОтветныйАкт = РезультатЭДО.ИсходящийДокументЭлектронногоАкта;
		
		СостояниеЭДОПолученныйАкт = РезультатЭДО.СостояниеЭДОВходящийДокументЭлектронногоАкта;
		СостояниеЭДООтветныйАкт = РезультатЭДО.СостояниеЭДОИсходящийДокументЭлектронногоАкта;
		
		СформироватьПредставлениеДокумента(ОтветныйАкт);	
	КонецЕсли;

	ПоказатьНовоеОбщееСостояниеЭДО();

	УстановитьВидимостьЭлементов(ЭтотОбъект, КодВидаИнтерфейса, ЭДОЗавершен);
КонецПроцедуры

&НаСервере
Процедура СоздатьКнопкуДляИзмененияОбщегоСостоянияЭДО(Форма, ИмяРеквизита, ГруппаРеквизита)
	
	ИмяКоманды = "Заполнить" + ИмяРеквизита;  
	Команда = Форма.Команды.Добавить(ИмяКоманды);
	Команда.Отображение = ОтображениеКнопки.Картинка;
	Команда.Действие = "ОбработкаНажатияКнопкиИзмененияОбщегоСостоянияЭДО";
	
	Элемент = Форма.Элементы.Добавить(ИмяКоманды,Тип("КнопкаФормы"), ГруппаРеквизита);
	Элемент.ИмяКоманды = ИмяКоманды;
	
	Элемент.Заголовок = НСтр("ru = 'Изменить'");
	Команда.Подсказка = НСтр("ru = 'Изменить общее состояние ЭДО'");
	Команда.Картинка = БиблиотекаКартинок.ПереместитьВлево;
	Команда.ИзменяетСохраняемыеДанные = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаНажатияКнопкиИзмененияОбщегоСостоянияЭДО(КомандаФормы)
	
	Элемент = ЭтаФорма.Элементы.Найти(КомандаФормы.Имя);
	СписокДоступныхСостоянийЭДО = СписокДоступныхСостоянийЭДО(КодВидаИнтерфейса);
	Оповещение = Новый ОписаниеОповещения("ВыполнитьПослеВыбораОбщегоСостоянияЭДО", ЭтотОбъект, Новый Структура);
	Оповещение.ДополнительныеПараметры.Вставить("Элемент", Элемент);
	ЭтаФорма.ПоказатьВыборИзМеню(Оповещение, СписокДоступныхСостоянийЭДО, Элемент);
	
КонецПроцедуры

&НаКлиенте
Функция СписокДоступныхСостоянийЭДО(КодВидаУчастника)
	Результат = Новый СписокЗначений;
	
	Если КодВидаУчастника = 1 Тогда
		Результат.Добавить(НСтр("ru='Не начат'"));
		Результат.Добавить(НСтр("ru='Подготовлен исходящий акт'"));
		Результат.Добавить(НСтр("ru='Получен ответный акт от получателя'"));
		Результат.Добавить(НСтр("ru='Завершен'"));
	ИначеЕсли КодВидаУчастника = 2 Тогда
		Результат.Добавить(НСтр("ru='Не начат'"));
		Результат.Добавить(НСтр("ru='Получен входящий акт'"));
		Результат.Добавить(НСтр("ru='Подготовлен ответный акт'"));
		Результат.Добавить(НСтр("ru='Завершен'"));
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ВыполнитьПослеВыбораОбщегоСостоянияЭДО(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяРеквизита = Сред(ДополнительныеПараметры.Элемент.Имя,10);
	Элементы.ДекорацияСостоянияЭДО.Заголовок = ВыбранныйЭлемент.Значение;
	УстановитьНовоеОбщееСостояниеЭДО(ВыбранныйЭлемент.Значение);
	
	Если ЗначениеЗаполнено(ДокументУчетаНФА) И (НЕ НовоеОбщееСостояниеЭДО = ОбщееСостояниеЭДО) Тогда
		Оповестить("ОбновитьСостояниеЭДАктов", , ДокументУчетаНФА);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УстановитьНовоеОбщееСостояниеЭДО(ВыбранноеЗначение = Неопределено)
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Если ВыбранноеЗначение = НСтр("ru='Не начат'") Тогда
			НовоеОбщееСостояниеЭДО = Перечисления.СостоянияДокументовАктовЭДОБГУ.ПустаяСсылка();	
		ИначеЕсли ВыбранноеЗначение = НСтр("ru='Завершен'") Тогда
			НовоеОбщееСостояниеЭДО = Перечисления.СостоянияДокументовАктовЭДОБГУ.ОбменЗавершен;	
		ИначеЕсли ВыбранноеЗначение = НСтр("ru='Подготовлен исходящий акт'") Тогда
			НовоеОбщееСостояниеЭДО = Перечисления.СостоянияДокументовАктовЭДОБГУ.ПодготовленИсходящийАкт;	
		ИначеЕсли ВыбранноеЗначение = НСтр("ru='Получен ответный акт от получателя'") Тогда
			НовоеОбщееСостояниеЭДО = Перечисления.СостоянияДокументовАктовЭДОБГУ.ПолученОтветныйАкт;	
		ИначеЕсли ВыбранноеЗначение = НСтр("ru='Получен входящий акт'") Тогда
			НовоеОбщееСостояниеЭДО = Перечисления.СостоянияДокументовАктовЭДОБГУ.ПолученВходящийАкт;	
		ИначеЕсли ВыбранноеЗначение = НСтр("ru='Подготовлен ответный акт'") Тогда
			НовоеОбщееСостояниеЭДО = Перечисления.СостоянияДокументовАктовЭДОБГУ.ПодготовленОтветныйАкт;	
		КонецЕсли;
		Если ЗначениеЗаполнено(ДокументУчетаНФА) И (НЕ НовоеОбщееСостояниеЭДО = ОбщееСостояниеЭДО) Тогда
			УстановитьПривилегированныйРежим(Истина);
			
			НаборЗаписей = РегистрыСведений.СостоянияПоДокументамАктовЭДОБГУ.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.СсылкаНаОбъект.Установить(ДокументУчетаНФА);
			Запись = НаборЗаписей.Добавить();
			Запись.СсылкаНаОбъект = ДокументУчетаНФА;
			Запись.СостояниеЭДО = НовоеОбщееСостояниеЭДО;
			НаборЗаписей.Записать(Истина);
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ПоказатьНовоеОбщееСостояниеЭДО()
	Если ЗначениеЗаполнено(НовоеОбщееСостояниеЭДО) Тогда
		Элементы.ДекорацияСостоянияЭДО.Заголовок = Строка(НовоеОбщееСостояниеЭДО);
	Иначе
		Элементы.ДекорацияСостоянияЭДО.Заголовок = НСтр("ru='Не начат'");
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

