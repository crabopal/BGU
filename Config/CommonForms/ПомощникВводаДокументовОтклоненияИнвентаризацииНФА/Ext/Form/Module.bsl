//////////////////////////////////////////////////////////////////////////
// Реквизит формы ВидОбъекта, тип Число(1) определяет вид объекта для целей определения
// вида учетного документа: 
// 1 - основные средства, 
// 2 - основные средства (кроме транспорта), 
// 3 - основные средства (транспорт), 
// 4 - основные средства (библиотечный фонд), 
// 5 - имущество казны, 
// 6 - имущество казны (кроме транспорта), 
// 7 - имущество казны (транспорт), 
// 8 - материальные запасы, 
// 9 - материальные запасы (имущество казны)        
// 11 - БСО        
// 12 - Денежные документы        
///////////////////////////////////////////////////////////////////////// 

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если НЕ ЗначениеЗаполнено(Параметры.ДокументИнвентаризации) Тогда
		ВызватьИсключение НСтр("ru = 'Форма не предназначена для непосредственного использования'");
	КонецЕсли;	
	ДокументИнвентаризации = Параметры.ДокументИнвентаризации;
	
	ЗаполнитьДеревоДанныхИнвентаризации();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если ЗначениеЗаполнено(ТекстСообщения) Тогда
		Отказ = Истина;
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, ДокументИнвентаризации);
		Возврат;
	КонецЕсли;	
	
	Если СтраницаОткрытия <> 0 Тогда
		Элементы.ГруппаСтраниц.ТекущаяСтраница = Элементы["Страница" + СтраницаОткрытия]; 
	Иначе	
		Отказ = Истина;
		ВвестиДокументыОтклонений();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТаблицыВидыОтклонений

&НаКлиенте
Процедура ВидыОтклоненийПередНачаломИзменения(Элемент, Отказ)
	Отказ = Истина;
	ВыборВидаОтклонения();
КонецПроцедуры

&НаКлиенте
Процедура ВидыОтклоненийПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, ЭтоГруппа, Параметр)
	Отказ = Истина;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТаблицыВидыОбъектов

&НаКлиенте
Процедура ВидыОбъектовПередНачаломИзменения(Элемент, Отказ)
	Отказ = Истина;
	ВыборВидаОбъекта();
КонецПроцедуры

&НаКлиенте
Процедура ВидыОбъектовПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, ЭтоГруппа, Параметр)
	Отказ = Истина;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТаблицыРазделителиДокументов

&НаКлиенте
Процедура РазделителиДокументовПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, ЭтоГруппа, Параметр)
	Отказ = Истина;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыбратьВидОтклонения(Команда)
	ВыборВидаОтклонения();
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьВидОбъекта(Команда)
	ВыборВидаОбъекта();
КонецПроцедуры

&НаКлиенте
Процедура ВвестиДокументы(Команда)
	ПереключитьСтраницы();
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометки(Команда)
	Для каждого ТекСтрока из РазделителиДокументов Цикл
		ТекСтрока.Выбран = Истина;
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажки(Команда)
	Для каждого ТекСтрока из РазделителиДокументов Цикл
		ТекСтрока.Выбран = Ложь;
	КонецЦикла;	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПереключитьСтраницы()
	Если Элементы.ГруппаСтраниц.ТекущаяСтраница = Элементы.Страница1 Тогда
		Элементы.ГруппаСтраниц.ТекущаяСтраница = Элементы.Страница2;
		ЗаполнитьВидыОбъектов();
		
		Если ВидыОбъектов.Количество() = 1 Тогда
			ВидОбъекта = ВидыОбъектов[0].ВидОбъекта;
			ПереключитьСтраницы();
		КонецЕсли;
	ИначеЕсли Элементы.ГруппаСтраниц.ТекущаяСтраница = Элементы.Страница2 Тогда
		Элементы.ГруппаСтраниц.ТекущаяСтраница = Элементы.Страница3;
		ЗаполнитьРазделителиДокументов();

		Если РазделителиДокументов.Количество() = 1 Тогда
			РазделителиДокументов[0].Выбран = Истина;
			ПереключитьСтраницы();
		КонецЕсли;
	ИначеЕсли Элементы.ГруппаСтраниц.ТекущаяСтраница = Элементы.Страница3 Тогда
		Если Не ВыбраныРазделителиДокументов() Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не отмечены параметры, по которым вводятся документы'"));
			Возврат;
		КонецЕсли;
		ВвестиДокументыОтклонений();
		Закрыть();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ВыбраныРазделителиДокументов()
	Для каждого ТекРазделитель из РазделителиДокументов Цикл
		Если ТекРазделитель.Выбран Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь
КонецФункции

&НаКлиенте
Процедура ВвестиДокументыОтклонений()
	Разделитель = Новый Структура;
	Для каждого ТекЭлемент из Элементы.РазделителиДокументов.ПодчиненныеЭлементы Цикл
		Если ТекЭлемент.Имя = "РазделителиДокументовВыбран" Тогда
			Продолжить;
		КонецЕсли;	
		Разделитель.Вставить(ТекЭлемент.Имя);
	КонецЦикла;	   

	Для каждого ТекРазделитель из РазделителиДокументов Цикл   
		Если НЕ ТекРазделитель.Выбран Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(Разделитель, ТекРазделитель);
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ДокументОснование", ДокументИнвентаризации);
		ПараметрыФормы.Вставить("Разделитель", Разделитель);
		ПараметрыФормы.Вставить("ВводНаОсновании", Истина);
		ОткрытьФорму("Документ." + ИмяДокумента + ".ФормаОбъекта", Новый Структура("Основание", ПараметрыФормы), ЭтотОбъект, Новый УникальныйИдентификатор);
	КонецЦикла;	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьДеревоДанныхИнвентаризации()
	Запрос = Новый Запрос;
	МенеджерДокумента = ОбщегоНазначения.МенеджерОбъектаПоСсылке(ДокументИнвентаризации);
	МенеджерДокумента.ЗапросДанныхДокументаИнвентаризации(Запрос, ДокументИнвентаризации);
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеДокументаИнвентаризации.ВидОбъекта КАК ВидОбъекта,
	|	ВЫБОР
	|		КОГДА ДанныеДокументаИнвентаризации.КоличествоИзлишкиНеПодтверждено <> 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Излишки,
	|	ВЫБОР
	|		КОГДА ДанныеДокументаИнвентаризации.КоличествоНедостачаНеПодтверждено <> 0
	|				ИЛИ ДанныеДокументаИнвентаризации.СуммаНедостачаНеПодтверждено <> 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Недостача,
	|	ВЫБОР
	|		КОГДА ДанныеДокументаИнвентаризации.КоличествоНеСоответствует <> 0
	|				ИЛИ ДанныеДокументаИнвентаризации.СуммаНеСоответствует <> 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК НеСоответствует,
	|	ВЫБОР
	|		КОГДА (ДанныеДокументаИнвентаризации.КоличествоОбесценение <> 0
	|				ИЛИ ДанныеДокументаИнвентаризации.СуммаОбесценение <> 0)
	|			И ДанныеДокументаИнвентаризации.Счет <> &СчетЗемли 	
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Обесценение,
	|	ВЫБОР
	|		КОГДА (ДанныеДокументаИнвентаризации.КоличествоОбесценение <> 0
	|				ИЛИ ДанныеДокументаИнвентаризации.СуммаОбесценение <> 0)
	|			И ДанныеДокументаИнвентаризации.Счет = &СчетЗемли 	
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ИзменениеСтоимости
	|ПОМЕСТИТЬ ДанныеИнвентаризации
	|ИЗ
	|	ДанныеДокументаИнвентаризации КАК ДанныеДокументаИнвентаризации
	|ГДЕ
	|	ДанныеДокументаИнвентаризации.ДокументИнвентаризации = &Ссылка
	|	И (ДанныеДокументаИнвентаризации.КоличествоИзлишкиНеПодтверждено <> 0
	|			ИЛИ ДанныеДокументаИнвентаризации.КоличествоНедостачаНеПодтверждено <> 0
	|			ИЛИ ДанныеДокументаИнвентаризации.СуммаНедостачаНеПодтверждено <> 0
	|			ИЛИ ДанныеДокументаИнвентаризации.КоличествоНеСоответствует <> 0
	|			ИЛИ ДанныеДокументаИнвентаризации.СуммаНеСоответствует <> 0
	|			ИЛИ ДанныеДокументаИнвентаризации.КоличествоОбесценение <> 0
	|			ИЛИ ДанныеДокументаИнвентаризации.СуммаОбесценение <> 0)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВЫБОР
	|		КОГДА ДанныеИнвентаризации.ВидОбъекта = 2
	|				ИЛИ ДанныеИнвентаризации.ВидОбъекта = 3
	|				ИЛИ ДанныеИнвентаризации.ВидОбъекта = 4
	|			ТОГДА 1
	|		КОГДА ДанныеИнвентаризации.ВидОбъекта = 6
	|				ИЛИ ДанныеИнвентаризации.ВидОбъекта = 7
	|			ТОГДА 5
	|		ИНАЧЕ ДанныеИнвентаризации.ВидОбъекта
	|	КОНЕЦ КАК ВидОбъекта,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОтклоненийВИнвентаризацииНФА.Излишки) КАК ВидОтклонения
	|ПОМЕСТИТЬ Данные
	|ИЗ
	|	ДанныеИнвентаризации КАК ДанныеИнвентаризации
	|ГДЕ
	|	ДанныеИнвентаризации.Излишки = ИСТИНА
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫБОР
	|		КОГДА ДанныеИнвентаризации.ВидОбъекта = 2
	|				ИЛИ ДанныеИнвентаризации.ВидОбъекта = 3
	|				ИЛИ ДанныеИнвентаризации.ВидОбъекта = 4
	|			ТОГДА 1
	|		КОГДА ДанныеИнвентаризации.ВидОбъекта = 6
	|				ИЛИ ДанныеИнвентаризации.ВидОбъекта = 7
	|			ТОГДА 5
	|		ИНАЧЕ ДанныеИнвентаризации.ВидОбъекта
	|	КОНЕЦ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДанныеИнвентаризации.ВидОбъекта,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОтклоненийВИнвентаризацииНФА.Недостача)
	|ИЗ
	|	ДанныеИнвентаризации КАК ДанныеИнвентаризации
	|ГДЕ
	|	ДанныеИнвентаризации.Недостача = ИСТИНА
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВЫБОР
	|		КОГДА ДанныеИнвентаризации.ВидОбъекта = 2
	|				ИЛИ ДанныеИнвентаризации.ВидОбъекта = 3
	|				ИЛИ ДанныеИнвентаризации.ВидОбъекта = 4
	|			ТОГДА 1
	|		КОГДА ДанныеИнвентаризации.ВидОбъекта = 6
	|				ИЛИ ДанныеИнвентаризации.ВидОбъекта = 7
	|			ТОГДА 5
	|		ИНАЧЕ ДанныеИнвентаризации.ВидОбъекта
	|	КОНЕЦ,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОтклоненийВИнвентаризацииНФА.НеАктивы)
	|ИЗ
	|	ДанныеИнвентаризации КАК ДанныеИнвентаризации
	|ГДЕ
	|	ДанныеИнвентаризации.НеСоответствует = ИСТИНА
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫБОР
	|		КОГДА ДанныеИнвентаризации.ВидОбъекта = 2
	|				ИЛИ ДанныеИнвентаризации.ВидОбъекта = 3
	|				ИЛИ ДанныеИнвентаризации.ВидОбъекта = 4
	|			ТОГДА 1
	|		КОГДА ДанныеИнвентаризации.ВидОбъекта = 6
	|				ИЛИ ДанныеИнвентаризации.ВидОбъекта = 7
	|			ТОГДА 5
	|		ИНАЧЕ ДанныеИнвентаризации.ВидОбъекта
	|	КОНЕЦ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВЫБОР
	|		КОГДА ДанныеИнвентаризации.ВидОбъекта = 2
	|				ИЛИ ДанныеИнвентаризации.ВидОбъекта = 3
	|				ИЛИ ДанныеИнвентаризации.ВидОбъекта = 4
	|			ТОГДА 1
	|		ИНАЧЕ ДанныеИнвентаризации.ВидОбъекта
	|	КОНЕЦ,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОтклоненийВИнвентаризацииНФА.Обесценение)
	|ИЗ
	|	ДанныеИнвентаризации КАК ДанныеИнвентаризации
	|ГДЕ
	|	ДанныеИнвентаризации.Обесценение = ИСТИНА
	|	И НЕ ДанныеИнвентаризации.ВидОбъекта В (6, 7, 8, 9)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫБОР
	|		КОГДА ДанныеИнвентаризации.ВидОбъекта = 2
	|				ИЛИ ДанныеИнвентаризации.ВидОбъекта = 3
	|				ИЛИ ДанныеИнвентаризации.ВидОбъекта = 4
	|			ТОГДА 1
	|		ИНАЧЕ ДанныеИнвентаризации.ВидОбъекта
	|	КОНЕЦ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВЫБОР
	|		КОГДА ДанныеИнвентаризации.ВидОбъекта = 2
	|				ИЛИ ДанныеИнвентаризации.ВидОбъекта = 3
	|				ИЛИ ДанныеИнвентаризации.ВидОбъекта = 4
	|			ТОГДА 1
	|		ИНАЧЕ ДанныеИнвентаризации.ВидОбъекта
	|	КОНЕЦ,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОтклоненийВИнвентаризацииНФА.ИзменениеСтоимости)
	|ИЗ
	|	ДанныеИнвентаризации КАК ДанныеИнвентаризации
	|ГДЕ
	|	ДанныеИнвентаризации.ИзменениеСтоимости = ИСТИНА
	|	И НЕ ДанныеИнвентаризации.ВидОбъекта В (6, 7, 8, 9)
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫБОР
	|		КОГДА ДанныеИнвентаризации.ВидОбъекта = 2
	|				ИЛИ ДанныеИнвентаризации.ВидОбъекта = 3
	|				ИЛИ ДанныеИнвентаризации.ВидОбъекта = 4
	|			ТОГДА 1
	|		ИНАЧЕ ДанныеИнвентаризации.ВидОбъекта
	|	КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Данные.ВидОбъекта КАК ВидОбъекта,
	|	Данные.ВидОтклонения КАК ВидОтклонения
	|ИЗ
	|	Данные КАК Данные
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВидОтклонения,
	|	ВидОбъекта";
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", ДокументИнвентаризации);                
	Запрос.УстановитьПараметр("СчетЗемли", БухгалтерскийУчет.СчетПоКоду("103.11"));
	ДанныеЗапроса = Запрос.Выполнить().Выгрузить();

	ТекущийВидОтклонения = Неопределено;
	СтрокиВидОтклонения = ДеревоДанныхИнвентаризации.ПолучитьЭлементы();
	Для каждого СтрокаДанных из ДанныеЗапроса Цикл
		Если ТекущийВидОтклонения <> СтрокаДанных.ВидОтклонения Тогда
			ТекущийВидОтклонения = СтрокаДанных.ВидОтклонения;
			СтрокаВидОтклонения = СтрокиВидОтклонения.Добавить();
			СтрокаВидОтклонения.ВидОтклонения = ТекущийВидОтклонения;                 
			СтрокиВидОбъекта = СтрокаВидОтклонения.ПолучитьЭлементы();
		КонецЕсли;	
		
		СтрокаВидОбъекта = СтрокиВидОбъекта.Добавить();
		СтрокаВидОбъекта.ВидОбъекта = СтрокаДанных.ВидОбъекта;
	КонецЦикла;	

	СтрокиВидОтклонения = ДеревоДанныхИнвентаризации.ПолучитьЭлементы();
	Если СтрокиВидОтклонения.Количество() = 0 Тогда
		СтраницаОткрытия = 0;
		ТекстСообщения = НСтр("ru = 'Учетные документы по всем отклонениям уже введены'");
	ИначеЕсли СтрокиВидОтклонения.Количество() = 1 Тогда
		СтраницаОткрытия = 2;
		ВидОтклонения = СтрокиВидОтклонения[0].ВидОтклонения;
		УстановитьЗаголовокТаблицыВидыОбъектов(ЭтотОбъект);
		ЗаполнитьВидыОбъектов(); 

		Если ВидыОбъектов.Количество() = 1 Тогда
			СтраницаОткрытия = 3;
			ВидОбъекта = ВидыОбъектов[0].ВидОбъекта;
			ЗаполнитьРазделителиДокументов();

			Если РазделителиДокументов.Количество() = 0 Тогда
				СтраницаОткрытия = 0;
				ТекстСообщения = СтрШаблон(НСтр(
				"ru = 'По описи отклонение ""%1"" по виду объекта ""%2"" не может быть введено.'"), 
				ВидОтклонения, ПредставлениеВидаОбъекта(ВидОбъекта));
			ИначеЕсли РазделителиДокументов.Количество() = 1 Тогда
				СтраницаОткрытия = 0;
				РазделителиДокументов[0].Выбран = Истина;
			КонецЕсли;	
		КонецЕсли;	
	Иначе
		СтраницаОткрытия = 1;
		ЗаполнитьВидыОтклонений();
	КонецЕсли;	
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьВидыОтклонений()
	ВидыОтклонений.Очистить();
	ЭлементыВидыОтклонений = ДеревоДанныхИнвентаризации.ПолучитьЭлементы();
	Для каждого СтрокаВидОтклонения из ЭлементыВидыОтклонений Цикл
		НоваяСтрока = ВидыОтклонений.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаВидОтклонения);
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура ВыборВидаОтклонения()
	ВидОтклонения = Элементы.ВидыОтклонений.ТекущиеДанные.ВидОтклонения;
	УстановитьЗаголовокТаблицыВидыОбъектов(ЭтотОбъект);
	ПереключитьСтраницы();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьВидыОбъектов()
	ВидыОбъектов.Очистить();
	СтрокиВидыОтклонений = ДеревоДанныхИнвентаризации.ПолучитьЭлементы();
	СтрокаВидОтклоненияНайденная = Неопределено;
	Для каждого СтрокаВидОтклонения из СтрокиВидыОтклонений Цикл
		Если СтрокаВидОтклонения.ВидОтклонения = ВидОтклонения Тогда
			СтрокаВидОтклоненияНайденная = СтрокаВидОтклонения;
			Прервать;
		КонецЕсли;	
	КонецЦикла;	

	Если СтрокаВидОтклоненияНайденная <> Неопределено Тогда
		СтрокиВидыОбъектов = СтрокаВидОтклоненияНайденная.ПолучитьЭлементы();
		Для каждого СтрокаВидОбъекта из СтрокиВидыОбъектов Цикл
			НоваяСтрока = ВидыОбъектов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаВидОбъекта);
			НоваяСтрока.ВидОбъектаПредставление = ПредставлениеВидаОбъекта(НоваяСтрока.ВидОбъекта);
		КонецЦикла;
	КонецЕсли;		
КонецПроцедуры

&НаКлиенте
Процедура ВыборВидаОбъекта()
	ВидОбъекта = Элементы.ВидыОбъектов.ТекущиеДанные.ВидОбъекта;
	ПереключитьСтраницы();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРазделителиДокументов()
	СтруктураИмениДокумента = УправлениеНФА.ИмяДокументаПоВидуОтклоненияИОбъекта(ВидОтклонения, ВидОбъекта);
	ИмяДокумента = СтруктураИмениДокумента.ИмяДокумента;
	ПредставлениеДокумента = СтруктураИмениДокумента.ПредставлениеДокумента;
	УстановитьЗаголовокТаблицыРазделителиДокументов(ЭтотОбъект);

	Попытка
		ДанныеРазделителей = УправлениеОсновнымиСредствамиВызовСервера
		.ТаблицаРазделителейДокументов(ДокументИнвентаризации, ИмяДокумента);    
	Исключение
		ДанныеРазделителей = Новый Структура("Разделители, ЗаголовкиРазделителей");
		ДанныеРазделителей.Вставить("Разделители", Новый Массив);
		ДанныеРазделителей.Вставить("ЗаголовкиРазделителей", Новый Структура);
	КонецПопытки;
	УправлениеНФА.ЗаполнитьТаблицуРазделителиДокументов(ДанныеРазделителей, ЭтотОбъект);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПредставлениеВидаОбъекта(ВидОбъекта)
	Если ВидОбъекта = 9 Тогда
		Результат = "Материальные запасы (имущество казны)";
	ИначеЕсли ВидОбъекта = 8 Тогда
		Результат = "Материальные запасы";
	ИначеЕсли ВидОбъекта = 7 Тогда
		Результат = "Имущество казны (транспорт)";
	ИначеЕсли ВидОбъекта = 6 Тогда
		Результат = "Имущество казны (кроме транспорта)";
	ИначеЕсли ВидОбъекта = 5 Тогда
		Результат = "Имущество казны";
	ИначеЕсли ВидОбъекта = 4 Тогда
		Результат = "Основные средства (библиотечный фонд)";
	ИначеЕсли ВидОбъекта = 3 Тогда
		Результат = "Основные средства (транспорт)";
	ИначеЕсли ВидОбъекта = 2 Тогда
		Результат = "Основные средства (кроме транспорта)";
	Иначе	
		Результат = "Основные средства";
	КонецЕсли;
		
	Возврат Результат;
КонецФункции	

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовокТаблицыРазделителиДокументов(Форма)                                      
	Заголовок = СтрШаблон(
		НСтр("ru = 'Отметьте параметры, по которым следует формировать отдельные документы: 
		|""%1""'"), Форма.ПредставлениеДокумента);
	Форма.Элементы.НадписьРазделителиДокументов.Заголовок = ОформлениеЗаголовкаТаблицы(Заголовок, 16);
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовокТаблицыВидыОбъектов(Форма)
	Заголовок = СтрШаблон(
		НСтр("ru = 'Текущее отклонение: %1'"), Строка(Форма.ВидОтклонения));
	Форма.Элементы.НадписьВидОтклоненияВидыОбъектов.Заголовок = ОформлениеЗаголовкаТаблицы(Заголовок, 11);
КонецПроцедуры	

&НаСервереБезКонтекста
Функция ОформлениеЗаголовкаТаблицы(Заголовок, РазмерШрифта)
	Возврат(Новый ФорматированнаяСтрока(Заголовок, Новый Шрифт(,РазмерШрифта,Истина), ЦветаСтиля.ТекстИнформационнойНадписи));
КонецФункции	

#КонецОбласти

