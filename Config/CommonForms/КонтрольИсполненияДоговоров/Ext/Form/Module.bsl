
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДокументСсылка = ?(Параметры.Свойство("ДокументСсылка") И ЗначениеЗаполнено(Параметры.ДокументСсылка),
		Параметры.ДокументСсылка, Неопределено);
	ВалютаДокумента = ?(Параметры.Свойство("ВалютаДокумента") И ЗначениеЗаполнено(Параметры.ВалютаДокумента),
		Параметры.ВалютаДокумента, Неопределено);
	
	Если Параметры.Свойство("Договор") И ЗначениеЗаполнено(Параметры.Договор) Тогда
		
		Договор = Параметры.Договор;
		
		РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Параметры.Договор,
			"Контрагент,Организация,ВидДоговора,ВестиГрафикПлатежей,ВестиПланГрафикИсполнения");
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, РеквизитыДоговора);
		
	Иначе // Без указания договора, известен только Контрагент.
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, Параметры, "Организация,Контрагент");
		ВестиГрафикПлатежей = Истина;
		ВестиПланГрафикИсполнения = Истина;
		
		Если Параметры.Свойство("СчетРасчетов") Тогда
			Если БухгалтерскийУчет.СчетВИерархии(Параметры.СчетРасчетов, "205.00,209.00") Тогда
				ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем;
			ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Параметры.СчетРасчетов, "206.00,302.00") Тогда
				ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком;
			ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Параметры.СчетРасчетов, "207.00") Тогда
				ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ПредоставленныйКредит;
			ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Параметры.СчетРасчетов, "301.12, 301.42") Тогда
				ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ВыпускЦенныхБумаг;
			ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Параметры.СчетРасчетов, "301.00") Тогда
				ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ПолученныйКредит;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	// Просроченную задолженность всегда показываем на текущий момент, актуальную.
	// Нет практической пользы от информации, какая просроченная задолженность была вчера или месяц назад.
	ДатаСведений = КонецДня(ТекущаяДатаСеанса());
	
	ЕстьРеквизитОтразитьВГрафикеИсполнения = Параметры.Свойство("ОтразитьВГрафикеИсполнения");
	Если ЕстьРеквизитОтразитьВГрафикеИсполнения Тогда
		ОтразитьВГрафикеИсполнения = ?(ЗначениеЗаполнено(Параметры.ОтразитьВГрафикеИсполнения), Параметры.ОтразитьВГрафикеИсполнения,
			Перечисления.СтатусыДокументовКонтрольИсполненияДоговоров.ОтразитьСейчас);
	КонецЕсли;
	
	ВидимостьНастройкиОтразитьВГрафикеИсполнения =
		(ЕстьРеквизитОтразитьВГрафикеИсполнения И ВестиПланГрафикИсполнения);
	Если ВидимостьНастройкиОтразитьВГрафикеИсполнения Тогда
		КонтрольИсполненияДоговоров.ЗаполнитьДоступныеСтатусыДокументов(
			Элементы.ОтразитьВГрафикеИсполнения.СписокВыбора);
	КонецЕсли;
	
	ЭлементыОтразитьВГрафикеИсполнения = Новый Массив;
	ЭлементыОтразитьВГрафикеИсполнения.Добавить("НадписьОтразитьВГрафикеИсполнения");
	ЭлементыОтразитьВГрафикеИсполнения.Добавить("ОтразитьВГрафикеИсполнения");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыОтразитьВГрафикеИсполнения, "Видимость", ВидимостьНастройкиОтразитьВГрафикеИсполнения);
	
	ОбновитьДанныеНаФорме();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьГрафикИсполненияДоговора(Команда)
	
	Если ЗначениеЗаполнено(Договор) Тогда
		КонтрольИсполненияДоговоровКлиент.ОткрытьГрафикИсполненияДоговора(
			Договор, , , ЭтотОбъект, ?(ЗначениеЗаполнено(ДокументСсылка), ДокументСсылка, Договор));
	Иначе
		Отбор = Новый Структура;
		Отбор.Вставить("Организация", Организация);
		КонтрольИсполненияДоговоровКлиент.ОткрытьГрафикИсполненияДоговора(
			Контрагент, , Отбор, ЭтотОбъект, ?(ЗначениеЗаполнено(ДокументСсылка), ДокументСсылка, Контрагент));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьГрафикИсполненияДоговора(Команда)
	
	ПараметрыВызова = Новый Структура;
	ПараметрыВызова.Вставить("ДокументОснование", ДокументСсылка);
	ПараметрыВызова.Вставить("Организация", Организация);
	ПараметрыВызова.Вставить("Контрагент", Контрагент);
	ПараметрыВызова.Вставить("ВалютаДокумента", ВалютаДокумента);
	
	КонтрольИсполненияДоговоровКлиент.ВвестиИзменитьГрафикПоДоговору(Договор, "",
		ПараметрыВызова, ЭтотОбъект, ?(ЗначениеЗаполнено(ДокументСсылка), ДокументСсылка, Договор));
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОК(Команда)
	ЗаписатьИЗакрытьЗавершение();
КонецПроцедуры

&НаКлиенте
Процедура КомандаОбновитьДанные(Команда)
	
	ОбновитьДанныеНаФорме();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьДанныеНаФорме()
	
	// Надписи, видимость.
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"Договор", "Видимость", ЗначениеЗаполнено(Договор));
	Если ЗначениеЗаполнено(Договор) Тогда
		Заголовок = НСтр("ru = 'Контроль исполнения договора'");
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаОбщиеСведения", "Заголовок",
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Данные по договору: %1'"), Договор) );
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОткрытьГрафик", "Заголовок",
			НСтр("ru = 'Исполнение договора'"));
	Иначе
		Заголовок = НСтр("ru = 'Контроль исполнения договоров'");
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаОбщиеСведения", "Заголовок",
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Данные по договорам контрагента: %1'"), Контрагент) );
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОткрытьГрафик", "Заголовок",
			НСтр("ru = 'Исполнение договоров'"));
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаГрафикПлатежей", "Видимость", ВестиГрафикПлатежей);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаПланГрафикЗакупокРеализации", "Видимость", ВестиПланГрафикИсполнения);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ПросроченоПлатежей", "Заголовок", СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Просрочено на %1'"), Формат(ДатаСведений, "ДЛФ=Д")) );
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ПросроченоЗакупокРеализации", "Заголовок", СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Просрочено на %1'"), Формат(ДатаСведений, "ДЛФ=Д")) );
	
	// Отбор данных графиков исполнения.
	ОтборОстатков = Новый Структура;
	ОтборОстатков.Вставить("Контрагент", Контрагент);
	Если ЗначениеЗаполнено(Договор) Тогда
		ОтборОстатков.Вставить("Договор", Договор);
	КонецЕсли;
	
	// График платежей.
	Если ВестиГрафикПлатежей Тогда
	
		Если ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком
			ИЛИ ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ПолученныйКредит
			ИЛИ ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ВыпускЦенныхБумаг
			ИЛИ ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии Тогда
			
			ЗадолженностьПоСрокамДолга = КонтрольИсполненияДоговоров.КлассифицироватьЗадолженностьПоСрокамДолга(
				КонтрольИсполненияДоговоров.НеисполненныеПлатежиПоставщикамКредиторам(ОтборОстатков, Организация),
					"ОплатитьДо", ДатаСведений);
			ЗапланированоПлатежей         = ЗадолженностьПоСрокамДолга.Запланировано;
			ПросроченоПлатежей            = ЗадолженностьПоСрокамДолга.Просрочено;
			ПросроченоПлатежейБолее30Дней = ЗадолженностьПоСрокамДолга.ПросроченоБолее30Дней;
			ПросроченоПлатежейБолее90Дней = ЗадолженностьПоСрокамДолга.ПросроченоБолее90Дней;
			
		ИначеЕсли ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем
			ИЛИ ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СОтправителемТрансферта
			ИЛИ ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ПредоставленныйКредит Тогда
			
			ЗадолженностьПоСрокамДолга = КонтрольИсполненияДоговоров.КлассифицироватьЗадолженностьПоСрокамДолга(
				КонтрольИсполненияДоговоров.НеисполненныеПлатежиОтПокупателейДебиторов(ОтборОстатков, Организация),
					"ОплатитьДо", ДатаСведений);
			ЗапланированоПлатежей         = ЗадолженностьПоСрокамДолга.Запланировано;
			ПросроченоПлатежей            = ЗадолженностьПоСрокамДолга.Просрочено;
			ПросроченоПлатежейБолее30Дней = ЗадолженностьПоСрокамДолга.ПросроченоБолее30Дней;
			ПросроченоПлатежейБолее90Дней = ЗадолженностьПоСрокамДолга.ПросроченоБолее90Дней;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// План-график закупок (реализации).
	Если ВестиПланГрафикИсполнения Тогда
	
		Если ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком Тогда
			
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
				"ГруппаПланГрафикЗакупокРеализации", "Заголовок", НСтр("ru = 'План-график закупок'"));
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
				"ПланЗакупокРеализации", "Заголовок", НСтр("ru = 'План закупок'"));
			
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НадписьОтразитьВГрафикеИсполнения", "Заголовок",
				НСтр("ru = 'Отразить документ в плане-графике закупок'") );
			
			ЗадолженностьПоСрокамДолга = КонтрольИсполненияДоговоров.КлассифицироватьЗадолженностьПоСрокамДолга(
				КонтрольИсполненияДоговоров.НеисполненныеОбязательстваПоставщиков(ОтборОстатков, Организация),
					"ИсполнитьДо", ДатаСведений);
			ПланЗакупокРеализации                  = ЗадолженностьПоСрокамДолга.Запланировано;
			ПросроченоЗакупокРеализации            = ЗадолженностьПоСрокамДолга.Просрочено;
			ПросроченоЗакупокРеализацииБолее30Дней = ЗадолженностьПоСрокамДолга.ПросроченоБолее30Дней;
			ПросроченоЗакупокРеализацииБолее90Дней = ЗадолженностьПоСрокамДолга.ПросроченоБолее90Дней;
			
		ИначеЕсли ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии Тогда
			
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
				"ГруппаПланГрафикЗакупокРеализации", "Заголовок", НСтр("ru = 'План-график исполнения'"));
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
				"ПланЗакупокРеализации", "Заголовок", НСтр("ru = 'План исполнения'"));
			
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НадписьОтразитьВГрафикеИсполнения", "Заголовок",
				НСтр("ru = 'Отразить документ в плане-графике исполнения'") );
			
			ЗадолженностьПоСрокамДолга = КонтрольИсполненияДоговоров.КлассифицироватьЗадолженностьПоСрокамДолга(
				КонтрольИсполненияДоговоров.НеисполненныеОбязательстваПоставщиков(ОтборОстатков, Организация),
					"ИсполнитьДо", ДатаСведений);
			ПланЗакупокРеализации                  = ЗадолженностьПоСрокамДолга.Запланировано;
			ПросроченоЗакупокРеализации            = ЗадолженностьПоСрокамДолга.Просрочено;
			ПросроченоЗакупокРеализацииБолее30Дней = ЗадолженностьПоСрокамДолга.ПросроченоБолее30Дней;
			ПросроченоЗакупокРеализацииБолее90Дней = ЗадолженностьПоСрокамДолга.ПросроченоБолее90Дней;
			
		ИначеЕсли ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем Тогда
			
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
				"ГруппаПланГрафикЗакупокРеализации", "Заголовок", НСтр("ru = 'План-график реализации'"));
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
				"ПланЗакупокРеализации", "Заголовок", НСтр("ru = 'План реализации'"));
			
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НадписьОтразитьВГрафикеИсполнения", "Заголовок",
				НСтр("ru = 'Отразить документ в плане-графике реализации'") );
			
			ЗадолженностьПоСрокамДолга = КонтрольИсполненияДоговоров.КлассифицироватьЗадолженностьПоСрокамДолга(
				КонтрольИсполненияДоговоров.НеисполненныеДоговораСПокупателями(ОтборОстатков, Организация),
					"ИсполнитьДо", ДатаСведений);
			ПланЗакупокРеализации                  = ЗадолженностьПоСрокамДолга.Запланировано;
			ПросроченоЗакупокРеализации            = ЗадолженностьПоСрокамДолга.Просрочено;
			ПросроченоЗакупокРеализацииБолее30Дней = ЗадолженностьПоСрокамДолга.ПросроченоБолее30Дней;
			ПросроченоЗакупокРеализацииБолее90Дней = ЗадолженностьПоСрокамДолга.ПросроченоБолее90Дней;
			
		ИначеЕсли ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СОтправителемТрансферта Тогда
			
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
				"ГруппаПланГрафикЗакупокРеализации", "Заголовок", НСтр("ru = 'План-график исполнения'"));
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
				"ПланЗакупокРеализации", "Заголовок", НСтр("ru = 'План исполнения'"));
			
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НадписьОтразитьВГрафикеИсполнения", "Заголовок",
				НСтр("ru = 'Отразить документ в плане-графике исполнения'") );
			
			ЗадолженностьПоСрокамДолга = КонтрольИсполненияДоговоров.КлассифицироватьЗадолженностьПоСрокамДолга(
				КонтрольИсполненияДоговоров.НеисполненныеДоговораСПокупателями(ОтборОстатков, Организация),
					"ИсполнитьДо", ДатаСведений);
			ПланЗакупокРеализации                  = ЗадолженностьПоСрокамДолга.Запланировано;
			ПросроченоЗакупокРеализации            = ЗадолженностьПоСрокамДолга.Просрочено;
			ПросроченоЗакупокРеализацииБолее30Дней = ЗадолженностьПоСрокамДолга.ПросроченоБолее30Дней;
			ПросроченоЗакупокРеализацииБолее90Дней = ЗадолженностьПоСрокамДолга.ПросроченоБолее90Дней;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

