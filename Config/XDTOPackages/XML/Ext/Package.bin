<package xmlns="http://v8.1c.ru/8.1/xdto" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://www.w3.org/XML/1998/namespace">
	<property form="Attribute" name="base" type="xsd:anyURI"/>
	<property form="Attribute" name="id" type="xsd:ID"/>
	<property form="Attribute" name="lang">
		<typeDef xsi:type="ValueType" memberTypes="xsd:language" variety="Union">
			<typeDef base="xsd:string" variety="Atomic">
				<enumeration/>
			</typeDef>
		</typeDef>
	</property>
	<property form="Attribute" name="space">
		<typeDef xsi:type="ValueType" base="xsd:NCName" variety="Atomic">
			<enumeration>default</enumeration>
			<enumeration>preserve</enumeration>
		</typeDef>
	</property>
</package>