<package xmlns="http://v8.1c.ru/8.1/xdto" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://schemas.openxmlformats.org/package/2006/relationships">
	<property xmlns:d2p1="http://schemas.openxmlformats.org/package/2006/relationships" name="Relationship" type="d2p1:CT_Relationship"/>
	<property xmlns:d2p1="http://schemas.openxmlformats.org/package/2006/relationships" name="Relationships" type="d2p1:CT_Relationships"/>
	<valueType name="ST_TargetMode" base="xs:string" variety="Atomic">
		<enumeration>External</enumeration>
		<enumeration>Internal</enumeration>
	</valueType>
	<objectType name="CT_Relationship">
		<property xmlns:d3p1="http://schemas.openxmlformats.org/package/2006/relationships" name="TargetMode" type="d3p1:ST_TargetMode" lowerBound="0" form="Attribute"/>
		<property name="Target" type="xs:anyURI" lowerBound="1" form="Attribute"/>
		<property name="Type" type="xs:anyURI" lowerBound="1" form="Attribute"/>
		<property name="Id" type="xs:ID" lowerBound="1" form="Attribute"/>
		<property name="__content" type="xs:string" form="Text"/>
	</objectType>
	<objectType name="CT_Relationships">
		<property xmlns:d3p1="http://schemas.openxmlformats.org/package/2006/relationships" ref="d3p1:Relationship" lowerBound="0" upperBound="-1"/>
	</objectType>
</package>