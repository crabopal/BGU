<package xmlns="http://v8.1c.ru/8.1/xdto" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://v8.1c.ru/8.1/language">
	<import namespace="http://v8.1c.ru/8.1/data/core"/>
	<property xmlns:d2p1="http://v8.1c.ru/8.1/language" name="codeFragment" type="d2p1:CodeFragmentText"/>
	<property xmlns:d2p1="http://v8.1c.ru/8.1/language" name="codeModule" type="d2p1:CodeModuleText"/>
	<property xmlns:d2p1="http://v8.1c.ru/8.1/language" name="expression" type="d2p1:ExpressionText"/>
	<valueType xmlns:d2p1="http://v8.1c.ru/8.1/language" base="d2p1:CodeModuleText" name="CodeFragmentText" variety="Atomic"/>
	<valueType xmlns:d2p1="http://v8.1c.ru/8.1/language" base="d2p1:V8CodeText" name="CodeModuleText" variety="Atomic"/>
	<valueType xmlns:d2p1="http://v8.1c.ru/8.1/language" base="d2p1:CodeFragmentText" name="ExpressionText" variety="Atomic"/>
	<valueType base="xsd:NCName" name="Identifier" variety="Atomic">
		<pattern>(_|\p{L})(_|\p{L}|\p{Nd})*</pattern>
	</valueType>
	<valueType base="xsd:string" name="V8CodeText" variety="Atomic"/>
	<valueType base="xsd:NCName" name="VariableName" variety="Atomic"/>
	<valueType xmlns:d2p1="http://v8.1c.ru/8.1/language" itemType="d2p1:VariableName" name="VariableNames" variety="List"/>
</package>