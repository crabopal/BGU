<package xmlns="http://v8.1c.ru/8.1/xdto" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="MSD_DATA_FHD/VerificationProtocol_1_0_1" elementFormQualified="true" attributeFormQualified="false">
	<property xmlns:d2p1="MSD_DATA_FHD/VerificationProtocol_1_0_2" name="Body" type="d2p1:Body"/>
	<valueType name="GUID" base="xs:string" variety="Atomic" maxLength="36"/>
	<objectType name="AccountType">
