		<property name="isBlockingErr" type="xs:boolean"/>
		<property name="DetailErrorDescription" type="xs:string"/>
		<property name="Value" type="xs:string"/>
	</objectType>
	<objectType name="Partition1Details">
		<property name="Date" type="xs:dateTime"/>
		<property name="Status" type="xs:string"/>
		<property name="StatusMessage" type="xs:string" nillable="true"/>
	</objectType>
	<objectType name="Partition1Type">
		<property xmlns:d3p1="MSD_DATA_FHD/VerificationProtocol_1_0_2" name="GUID" type="d3p1:GUID"/>
		<property name="FileName" type="xs:string"/>
		<property xmlns:d3p1="MSD_DATA_FHD/VerificationProtocol_1_0_2" name="Details" type="d3p1:Partition1Details" lowerBound="0" upperBound="-1"/>
