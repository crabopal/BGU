<package xmlns="http://v8.1c.ru/8.1/xdto" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="MSD_DATA_FHD/TransferRules/TableResult" elementFormQualified="true" attributeFormQualified="false">
	<property xmlns:d2p1="MSD_DATA_FHD/TransferRules/TableResult" name="Body" type="d2p1:Body"/>
	<objectType name="Body">
		<property xmlns:d3p1="MSD_DATA_FHD/TransferRules/TableResult" name="Period" type="d3p1:Period" lowerBound="0" upperBound="-1"/>
	</objectType>
	<objectType name="Period">
		<property name="Version" type="xs:string" lowerBound="0"/>
		<property name="VersionStartDate" type="xs:date" lowerBound="0"/>
		<property name="VersionApprovalDate" type="xs:dateTime" lowerBound="0"/>
		<property name="PeriodRepresentation" type="xs:string"/>
		<property name="Frequency">
			<typeDef xsi:type="ValueType" base="xs:string" variety="Atomic">
				<enumeration>Год</enumeration>
				<enumeration>ДевятьМесяцев</enumeration>
				<enumeration>Декада</enumeration>
				<enumeration>День</enumeration>
				<enumeration>Квартал</enumeration>
				<enumeration>Месяц</enumeration>
				<enumeration>Неделя</enumeration>
				<enumeration>Полугодие</enumeration>
				<enumeration>ПроизвольныйПериод</enumeration>
			</typeDef>
		</property>
		<property name="StartDate" type="xs:date"/>
		<property name="EndDate" type="xs:date"/>
		<property name="ActualVersion" type="xs:string" lowerBound="0" nillable="true"/>
		<property name="ActualVersionStartDate" type="xs:date" lowerBound="0" nillable="true"/>
		<property name="Coincides" type="xs:boolean" lowerBound="0"/>
	</objectType>
</package>