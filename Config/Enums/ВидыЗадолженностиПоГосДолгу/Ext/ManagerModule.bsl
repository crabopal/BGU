#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)
	Перем Организация;
	Перем НаДату;
	
	Если Параметры.Свойство("Счет") И ЗначениеЗаполнено(Параметры.Счет) Тогда
		СтандартнаяОбработка = Ложь;
		Параметры.Свойство("Организация", Организация);
		Параметры.Свойство("НаДату", НаДату);
		ДанныеВыбора = Новый СписокЗначений;
		ОграничитьДанныеВыбораПоСчету(ДанныеВыбора, Параметры.Счет, Организация, НаДату);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
	
#Область СлужебныеПроцедурыИФункции

Процедура ОграничитьДанныеВыбораПоСчету(ДанныеВыбора, Счет, Организация, НаДату)
	
	ДопустимыеВидыЗадолженностиПоСчету = ДопустимыеВидыЗадолженностиПоСчету(Счет, Организация, НаДату);
	Для Каждого ВидЗадолженности Из ДопустимыеВидыЗадолженностиПоСчету Цикл
		ДанныеВыбора.Добавить(ВидЗадолженности);
	КонецЦикла;
	
КонецПроцедуры

Функция ДопустимыеВидыЗадолженностиПоСчету(Счет, Организация = Неопределено, НаДату = Неопределено) Экспорт
	
	ВидыЗадолженности = Новый Массив;
	ВидыЗадолженности.Добавить(ВнутреннийДолг);
	ВидыЗадолженности.Добавить(ВнешнийДолг);
	
	Если Не ЗначениеЗаполнено(Счет) Тогда
		Возврат ВидыЗадолженности;
	КонецЕсли;
	
	ОтборПоСчетам = БухгалтерскийУчет.СписокСчетов(Счет, НаДату, , Организация);
	Если ОтборПоСчетам.Количество() = 0 Тогда
		Возврат ВидыЗадолженности;
	КонецЕсли;
	
	ВидыЗадолженностиПоСчету = Новый Массив;
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет") Тогда
		ВидыЗадолженностиПоСчету.Добавить(ВнутреннийДолг);
		Возврат ВидыЗадолженностиПоСчету;
	КонецЕсли;
	
	Для Каждого ВидЗадолженности Из ВидыЗадолженности Цикл
		//@skip-check query-in-loop
		ДопустимыеСчета = ДопустимыеСчетаПоВидуЗадолженности(ВидЗадолженности, НаДату, Организация);
		Если ЕстьПересечение(ОтборПоСчетам, ДопустимыеСчета) Тогда
			ВидыЗадолженностиПоСчету.Добавить(ВидЗадолженности);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ВидыЗадолженностиПоСчету;
	
КонецФункции

Функция ЕстьПересечение(ОтборПоСчетам, ДопустимыеСчета)
	Для Каждого Элемент Из ОтборПоСчетам Цикл
		Если ДопустимыеСчета.Найти(Элемент) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ДопустимыеСчетаПоВидуЗадолженности(ВидЗадолженности, НаДату = Неопределено, Организация = Неопределено) Экспорт
	
	Если ВидЗадолженности = ВнутреннийДолг Тогда
		ДопустимыеСчетаСтрокой = "301.10,301.20,301.30";
	Иначе
		ДопустимыеСчетаСтрокой = "301.20,301.30,301.40";
	КонецЕсли;
	
	ДопустимыеСчета = БухгалтерскийУчет.СписокСчетов(ДопустимыеСчетаСтрокой, НаДату, , Организация);
	
	Если ВидЗадолженности = ВнешнийДолг Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	ЕПСБУ.Ссылка КАК Ссылка
			|ИЗ
			|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
			|ГДЕ
			|	ЕПСБУ.Ссылка В (&Счета)
			|	И ЕПСБУ.Валютный";
		Запрос.УстановитьПараметр("Счета", ДопустимыеСчета);
		ДопустимыеСчета = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	КонецЕсли;
	
	Возврат ДопустимыеСчета;

КонецФункции

#КонецОбласти
	
#КонецЕсли