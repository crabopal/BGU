#Область ПрограммныйИнтерфейс

Функция ПоСчету(Счет) Экспорт
	
	Если БухгалтерскийУчет.СчетВИерархии(Счет, "101.00,102.00,103.00,108.00,111.60,21") Тогда
		Результат = НаБалансе;
	ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Счет, "106.00") Тогда
		Результат = КапВложение;
	ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Счет, "107.00") Тогда
		Результат = ВПути;
	ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Счет, "01") Тогда
		Результат = Арендованные;
	ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Счет, "02") Тогда
		Результат = НаОтветственномХранении;
	Иначе
		Результат = ПустаяСсылка();
	КонецЕсли;
	
	Возврат Результат;
	
