// @strict-types

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЦентрализованноеСнабжение.УстановитьУсловноеОформлениеСпискаВидовИзвещений(ЭтотОбъект);
	Параметры.Свойство("ТекущаяСтрока", НачальноеЗначениеСписка);
	НачальноеЗначениеСпискаЭДО = Параметры.НачальноеЗначениеСпискаЭДО;
	ЦентрализованноеСнабжение.ЗаполнитьСписокВидовИзвещений(ЭтотОбъект,
		Перечисления.ВидыОперацийВходящееИзвещение.ПустаяСсылка());
	Для Каждого Строка Из СписокВсеВиды Цикл
		Строка.ПервоеИзвещение = Истина;
	КонецЦикла;
	
	ПоказыватьВходящиеОперацииОтЗаказчика = Истина;
	ПоказыватьВходящиеОперацииОтПолучателя = Истина;
	ПоказыватьПодтверждениеПолученияОтЗаказчика = Истина;
	ПоказыватьПодтверждениеПолученияОтПолучателя = Истина;

	ОбновитьСоставВидимойТаблицы(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ЦентрализованноеСнабжениеКлиент.УстановитьТекущуюСтрокуСписка(ЭтотОбъект, НачальноеЗначениеСписка);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПоказыватьВходящиеОперацииОтЗаказчикаПриИзменении(Элемент)
	ПриИзмененииОтбораПоВидам();
КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьВходящиеОперацииОтПолучателяПриИзменении(Элемент)
	ПриИзмененииОтбораПоВидам();
КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьПодтверждениеПолученияОтЗаказчикаПриИзменении(Элемент)
	ПриИзмененииОтбораПоВидам();
КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьПодтверждениеПолученияОтПолучателяПриИзменении(Элемент)
	ПриИзмененииОтбораПоВидам();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ОбработатьВыборЗначения();
КонецПроцедуры

&НаКлиенте
Процедура СписокВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	ОбработатьВыборЗначения();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаВыбрать(Команда)
	ОбработатьВыборЗначения();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПриИзмененииОтбораПоВидам()
	ПараметрыЗаполнения = ПараметрыЗаполненияСписка(ЭтотОбъект);
	ЦентрализованноеСнабжениеКлиент.ПриИзмененииОтбораПоВидам(ЭтотОбъект, ПараметрыЗаполнения);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПараметрыЗаполненияСписка(Форма)
	ПараметрыЗаполнения = ЦентрализованноеСнабжениеКлиентСервер.ПараметрыОбновленияСоставаВидимойТаблицыПеречисления();
	ПараметрыЗаполнения.ПоказыватьОперацииОтЗаказчика = Форма.ПоказыватьВходящиеОперацииОтЗаказчика;
	ПараметрыЗаполнения.ПоказыватьОперацииОтПолучателя = Форма.ПоказыватьВходящиеОперацииОтПолучателя;
	ПараметрыЗаполнения.ПоказыватьОперацииЭДООтЗаказчика = Форма.ПоказыватьПодтверждениеПолученияОтЗаказчика;
	ПараметрыЗаполнения.ПоказыватьОперацииЭДООтПолучателя = Форма.ПоказыватьПодтверждениеПолученияОтПолучателя;
	ПараметрыЗаполнения.ЗаголовокОперацииОтЗаказчика = НСтр("ru = 'Входящие операции (документооборот со стороны отправителя)'");
	ПараметрыЗаполнения.ЗаголовокОперацииОтПолучателя = НСтр("ru = 'Входящие операции (документооборот со стороны получателя)'");
	ПараметрыЗаполнения.ЗаголовокОперацииЭДООтЗаказчика = НСтр("ru = 'Подтверждение операции ЭДО (документооборот со стороны отправителя)'");
	ПараметрыЗаполнения.ЗаголовокОперацииЭДООтПолучателя = НСтр("ru = 'Подтверждение операции ЭДО (документооборот со стороны получателя)'");
	Возврат ПараметрыЗаполнения;
КонецФункции

// Обновить состав видимой таблицы.
// 
// Параметры:
//  Форма - см. Перечисление.ВидыОперацийИсходящееИзвещение.Форма.ФормаВыбора2
&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьСоставВидимойТаблицы(Форма)
	ПараметрыЗаполнения = ПараметрыЗаполненияСписка(Форма);
	ЦентрализованноеСнабжениеКлиентСервер.ОбновитьСоставВидимойТаблицыПеречисления(Форма, ПараметрыЗаполнения);
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборЗначения()
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Или Не ЗначениеЗаполнено(ТекущиеДанные.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	ОповеститьОВыборе(ТекущиеДанные.Ссылка);
КонецПроцедуры

#КонецОбласти
