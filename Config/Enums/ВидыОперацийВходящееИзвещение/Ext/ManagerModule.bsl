#Область ПрограммныйИнтерфейс

// Относится ли ВидИзвещения к документообороту извещениями, который начинается
// на строне получателя.
// 
// Параметры:
//  ВидИзвещения - ПеречислениеСсылка.ВидыОперацийВходящееИзвещение
// 
// Возвращаемое значение:
//  Булево
Функция ДокументооборотСоСтороныПолучателя(ВидИзвещения) Экспорт
	Возврат Булево(КлассификацияВидовОпераций()
		.НайтиСтроки(Новый Структура("ВидИзвещения, СоСтороныПолучателя", ВидИзвещения, Истина)).Количество());
КонецФункции

// Операции, используемые при операциях без использования ЭДО.
// 
// Параметры:
//  СоСтороныПолучателя - Неопределено - Со стороны получателя
// 
// Возвращаемое значение:
//  Массив из ПеречислениеСсылка.ВидыОперацийВходящееИзвещение - Операции классические
Функция ОперацииКлассические(СоСтороныПолучателя = Неопределено) Экспорт
	Возврат ПолучитьОперацииПоОтбору(Новый Структура("Классический", Истина), СоСтороныПолучателя); 
КонецФункции

// Операции, используемые при операциях с использованием ЭДО.
// 
// Параметры:
//  СоСтороныПолучателя - Неопределено - Со стороны получателя
// 
// Возвращаемое значение:
//  Массив из ПеречислениеСсылка.ВидыОперацийВходящееИзвещение - Операции классические
Функция ОперацииЭДО(СоСтороныПолучателя = Неопределено) Экспорт
	Возврат ПолучитьОперацииПоОтбору(Новый Структура("ЭДО", Истина), СоСтороныПолучателя); 
КонецФункции

// Виды ответных операций.
// 
// Возвращаемое значение:
//  Соответствие - Виды ответных операций
Функция ВидыОтветныхОпераций() Экспорт
	Результат = Новый Соответствие;
	Результат.Вставить(ОтПолучателя_ПолучениеГрузополучателемНФАОтПоставщикаРезерв,
		ОтПолучателя_ПолучениеГрузополучателемНФАОтПоставщикаРезерв);
	
	Возврат Результат;
КонецФункции

// Классификация видов операций.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Классификация видов операций:
// * ВидИзвещения - ПеречислениеСсылка.ВидыОперацийВходящееИзвещение - 
// * Классический - Булево - 
// * ЭДО - Булево - 
// * СоСтороныОтправителя - Булево - 
// * СоСтороныПолучателя - Булево - 
Функция КлассификацияВидовОпераций() Экспорт
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ВидИзвещения", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыОперацийВходящееИзвещение"));
	Результат.Колонки.Добавить("Классический", Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("ЭДО", Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("СоСтороныОтправителя", Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("СоСтороныПолучателя", Новый ОписаниеТипов("Булево"));
	
	ДобавитьВТЗ(Результат, "ПолучениеНФА",																	Истина,	Истина,	Истина,	Ложь);
	ДобавитьВТЗ(Результат, "НачислениеДохода",																Истина,	Истина,	Истина,	Ложь);
	ДобавитьВТЗ(Результат, "ПолучениеДохода",																Истина,	Истина,	Истина,	Ложь);
	ДобавитьВТЗ(Результат, "ПодтверждениеПолученияНФА",														Истина,	Истина,	Истина,	Ложь);
	ДобавитьВТЗ(Результат, "ПолучениеФА",																	Истина,	Истина,	Истина,	Ложь);
	ДобавитьВТЗ(Результат, "ПолучениеОбязательств",															Истина,	Истина,	Истина,	Ложь);
	ДобавитьВТЗ(Результат, "ПолучениеРБП",																	Истина,	Истина,	Истина,	Ложь);
	ДобавитьВТЗ(Результат, "ПолучениеБСО",																	Истина,	Истина,	Истина,	Ложь);
	ДобавитьВТЗ(Результат, "ПолучениеФинансовыхВложений",													Истина,	Истина,	Истина,	Ложь);
	ДобавитьВТЗ(Результат, "ПолучениеВложенийВФинансовыеАктивы",											Истина,	Истина,	Истина,	Ложь);
	ДобавитьВТЗ(Результат, "РасчетыПоМБТ",																	Истина,	Истина,	Истина,	Ложь);
	ДобавитьВТЗ(Результат, "ПодтверждениеРасчетовПоМБТ",													Ложь,	Истина,	Истина,	Ложь);
	ДобавитьВТЗ(Результат, "ПодтверждениеПолученияРБП",														Ложь,	Истина,	Истина,	Ложь);
	ДобавитьВТЗ(Результат, "ПолучениеРасчетовПоПоставкамНФА",												Истина,	Истина,	Ложь,	Истина);
	ДобавитьВТЗ(Результат, "ПолучениеУточненияРасчетовПоПоставкамНФА",										Истина,	Истина,	Ложь,	Истина);
	ДобавитьВТЗ(Результат, "ПолучениеПодтвержденияРасчетовПоПоставкамНФА",									Ложь,	Истина,	Ложь,	Истина);
	ДобавитьВТЗ(Результат, "ПолучениеПодтвержденияУточненияРасчетовПоПоставкамНФА",							Ложь,	Истина,	Ложь,	Истина);
	ДобавитьВТЗ(Результат, "ОтПолучателя_ПолучениеГрузополучателемНФАОтПоставщикаРезерв",					Истина,	Ложь,	Ложь,	Истина);
	ДобавитьВТЗ(Результат, "ОтПолучателя_ПолучениеГрузополучателемНФАОтПоставщика",							Истина,	Ложь,	Ложь,	Истина);
	ДобавитьВТЗ(Результат, "ОтПолучателя_ПолучениеГрузополучателемНФАОтПоставщикаЭДО",						Ложь,	Истина,	Ложь,	Истина);
	ДобавитьВТЗ(Результат, "ОтПолучателя_ПодтверждениеПолученияГрузополучателемНФАОтПоставщикаЭДО",			Ложь,	Истина,	Ложь,	Истина);
	ДобавитьВТЗ(Результат, "ОтПолучателя_ПодтверждениеПолученияГрузополучателемНФАОтПоставщикаРезервЭДО",	Ложь,	Истина,	Ложь,	Истина);
	ДобавитьВТЗ(Результат, "ОтПолучателя_ПередачаСведенийОРазделенииЗемельныхУчастковОПУИЭДО", 				Ложь, 	Истина, Ложь, Истина);
	ДобавитьВТЗ(Результат, "ОтПолучателя_ОтражениеВУчетеРазделенияЗемельныхУчастковЭДО", 					Ложь, 	Истина, Ложь, Истина);
	ДобавитьВТЗ(Результат, "ОтПолучателя_ПолучениеСведенийОРазделенииЗемельныхУчастковОПУИ", 				Истина,	Ложь,	Ложь,	Истина);
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьОперацииПоОтбору(Отбор, СоСтороныПолучателя = Неопределено)
	Если СоСтороныПолучателя <> Неопределено Тогда
		Отбор.Вставить("СоСтороныПолучателя", СоСтороныПолучателя);
	КонецЕсли;
	ВидыОпераций = ЦентрализованноеСнабжениеПовтИсп.КлассификацияВидовОпераций(ПустаяСсылка());
	
	НайденныеОперации = ВидыОпераций.Скопировать(Отбор, "ВидИзвещения");
	Возврат НайденныеОперации.ВыгрузитьКолонку("ВидИзвещения");
КонецФункции

Процедура ДобавитьВТЗ(Классификатор, Имя, Классический, ЭДО, СоСтороныОтправителя, СоСтороныПолучателя)
	НоваяСтрока = Классификатор.Добавить();
	НоваяСтрока.ВидИзвещения = Перечисления.ВидыОперацийВходящееИзвещение[Имя];
	НоваяСтрока.Классический = Классический;
	НоваяСтрока.ЭДО = ЭДО;
	НоваяСтрока.СоСтороныОтправителя = СоСтороныОтправителя;
	НоваяСтрока.СоСтороныПолучателя = СоСтороныПолучателя;
КонецПроцедуры

#КонецОбласти

#КонецЕсли
