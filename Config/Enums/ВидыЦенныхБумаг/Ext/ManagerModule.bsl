#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)
	Перем Организация;
	Перем НаДату;
	
	Если Параметры.Свойство("Счет") И ЗначениеЗаполнено(Параметры.Счет) Тогда
		СтандартнаяОбработка = Ложь;
		Параметры.Свойство("Организация", Организация);
		Параметры.Свойство("НаДату", НаДату);
		ДанныеВыбора = Новый СписокЗначений;
		ОграничитьДанныеВыбораПоСчету(ДанныеВыбора, Параметры.Счет, Организация, НаДату);
	КонецЕсли;
	
КонецПроцедуры
	
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОграничитьДанныеВыбораПоСчету(ДанныеВыбора, Счет, Организация, НаДату)
	
	ВидыЦенныхБумагПоСчету = ВидыЦенныхБумагПоСчету(Счет, Организация, НаДату);
	Для Каждого ВидЦеннойБумаги Из ВидыЦенныхБумагПоСчету Цикл
		ДанныеВыбора.Добавить(ВидЦеннойБумаги);
	КонецЦикла;
	
КонецПроцедуры

Функция ВидыЦенныхБумагПоСчету(Счет, Организация = Неопределено, НаДату = Неопределено) Экспорт
	
	ВидыЦенныхБумаг = Новый Массив;
	ВидыЦенныхБумаг.Добавить(Акция);
	ВидыЦенныхБумаг.Добавить(Облигация);
	ВидыЦенныхБумаг.Добавить(Вексель);
	ВидыЦенныхБумаг.Добавить(Иные);
	
	Если Не ЗначениеЗаполнено(Счет) Тогда
		Возврат ВидыЦенныхБумаг;
	КонецЕсли;
	
	ОтборПоСчетам = БухгалтерскийУчет.СписокСчетов(Счет, НаДату, , Организация);
	Если ОтборПоСчетам.Количество() = 0 Тогда
		Возврат ВидыЦенныхБумаг;
	КонецЕсли;
	
	ВидыЦенныхБумагПоСчету = Новый Массив;
	
	Для Каждого ВидЦеннойБумаги Из ВидыЦенныхБумаг Цикл
		ДопустимыеСчета = ДопустимыеСчетаПоВидуЦеннойБумаги(ВидЦеннойБумаги, НаДату, Организация);
		Если ЕстьПересечение(ОтборПоСчетам, ДопустимыеСчета) Тогда
			ВидыЦенныхБумагПоСчету.Добавить(ВидЦеннойБумаги);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ВидыЦенныхБумагПоСчету;
	
КонецФункции

Функция ЕстьПересечение(ОтборПоСчетам, ДопустимыеСчета)
	Для Каждого Элемент Из ОтборПоСчетам Цикл
		Если ДопустимыеСчета.Найти(Элемент) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ДопустимыеСчетаПоВидуЦеннойБумаги(ВидЦенныхБумаг, НаДату = Неопределено, Организация = Неопределено) Экспорт
	
	Если ВидЦенныхБумаг = Акция Тогда
		ДопустимыеСчетаСтрокой = "204.31,31";
	ИначеЕсли ВидЦенныхБумаг = Облигация Тогда
		ДопустимыеСчетаСтрокой = "204.21";
	ИначеЕсли ВидЦенныхБумаг = Вексель Тогда
		ДопустимыеСчетаСтрокой = "204.22";
	Иначе
		ДопустимыеСчетаСтрокой = "204.23";
	КонецЕсли;
	
	Возврат БухгалтерскийУчет.СписокСчетов(ДопустимыеСчетаСтрокой, НаДату, , Организация);

КонецФункции

#КонецОбласти

#КонецЕсли