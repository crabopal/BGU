
Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)
	Если Параметры.Свойство("ТолькоПоступление") Тогда
		СтандартнаяОбработка = Ложь;
		ДанныеВыбора = Новый СписокЗначений;
		ДанныеВыбора.Добавить(Перечисления.ВидыОперацийИК.ПринятиеКУчетуИзготовление);
		ДанныеВыбора.Добавить(Перечисления.ВидыОперацийИК.Поступление);
		ДанныеВыбора.Добавить(Перечисления.ВидыОперацийИК.ПоступлениеЗабаланс);
		ДанныеВыбора.Добавить(Перечисления.ВидыОперацийИК.ВозвратАренда);
		ДанныеВыбора.Добавить(Перечисления.ВидыОперацийИК.ВозвратБезвозмездноеПользование);
		ДанныеВыбора.Добавить(Перечисления.ВидыОперацийИК.ВозвратУправление);
		ДанныеВыбора.Добавить(Перечисления.ВидыОперацийИК.ВозвратЗемУчастковИзПользования);
	ИначеЕсли Параметры.Свойство("ТолькоПередача") Тогда
		СтандартнаяОбработка = Ложь;
		ДанныеВыбора = Новый СписокЗначений;
		ДанныеВыбора.Добавить(Перечисления.ВидыОперацийИК.Передача);
		ДанныеВыбора.Добавить(Перечисления.ВидыОперацийИК.ПередачаАренда);
		ДанныеВыбора.Добавить(Перечисления.ВидыОперацийИК.ПередачаБезмозмездноеПользование);
	КонецЕсли;
КонецПроцедуры
