
Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)
	
	ДанныеВыбора = Новый СписокЗначений;
	Для к = 0 По Перечисления.ВидыОперацийОтчетКомиссионера.Количество() - 1 Цикл
		Значение = Перечисления.ВидыОперацийОтчетКомиссионера.Получить(к);
		Если Значение = ПредопределенноеЗначение("Перечисление.ВидыОперацийОтчетКомиссионера.ОтчетОСписании") Тогда
		Иначе
			ДанныеВыбора.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры
