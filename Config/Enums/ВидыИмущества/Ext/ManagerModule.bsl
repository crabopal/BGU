#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция ПоСчету(Счет) Экспорт
	
	Если Не ЗначениеЗаполнено(Счет) Тогда
		Возврат Перечисления.ВидыИмущества.ПустаяСсылка();
	КонецЕсли;
	
	Данные = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Счет, "Код,ДатаОкончанияДействия,Забалансовый");
	
	Если Данные.Код = "106.КС" Тогда
		Возврат Перечисления.ВидыИмущества.НедвижимоеИмущество;
	КонецЕсли;
	
	// Вид имущества определется только для Нефинансовых активов (счета 100 и 01,02,21).
	Если Данные.Забалансовый Тогда
		Если Не СтрНачинаетсяС(Данные.Код, "01.")
			И Не СтрНачинаетсяС(Данные.Код, "02.")
			И Не СтрНачинаетсяС(Данные.Код, "21.") Тогда
			Возврат Перечисления.ВидыИмущества.ПустаяСсылка();
		КонецЕсли;
	Иначе
		Если Не СтрНачинаетсяС(Данные.Код, "1") Тогда
			Возврат Перечисления.ВидыИмущества.ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;
	
	ПозТочка = Найти(Данные.Код, ".");
	КодСубсчета = Сред(Данные.Код, ПозТочка + 1);
	Если СтрДлина(КодСубсчета) <> 2 Тогда
		Возврат Перечисления.ВидыИмущества.ПустаяСсылка();
	КонецЕсли;
	КодГруппы = Сред(КодСубсчета, 1, 1);
	
	Если КодГруппы = "1" Тогда
		ВидИмущества = Перечисления.ВидыИмущества.НедвижимоеИмущество;
	ИначеЕсли КодГруппы = "2" Тогда
		ВидИмущества = Перечисления.ВидыИмущества.ДвижимоеОсобоЦенное;
	ИначеЕсли КодГруппы = "3" Тогда
		ВидИмущества = Перечисления.ВидыИмущества.ИноеДвижимое;
	ИначеЕсли КодГруппы = "4" Тогда
		Если ЗначениеЗаполнено(Данные.ДатаОкончанияДействия) И Данные.ДатаОкончанияДействия < '20180101' Тогда
			ВидИмущества = Перечисления.ВидыИмущества.Лизинг;
		Иначе
			ВидИмущества = Перечисления.ВидыИмущества.Аренда;
		КонецЕсли;
	ИначеЕсли КодГруппы = "5" Тогда
		ВидИмущества = Перечисления.ВидыИмущества.Казна;
	ИначеЕсли КодГруппы = "6" Тогда
		ВидИмущества = Перечисления.ВидыИмущества.ПраваПользованияНМА;
	ИначеЕсли КодГруппы = "9" Тогда
		ВидИмущества = Перечисления.ВидыИмущества.ВКонцессии;
	Иначе
		ВидИмущества = Перечисления.ВидыИмущества.ПустаяСсылка();
	КонецЕсли;
	
	Возврат ВидИмущества;
	
КонецФункции

// Возвращает список счетов капвложений (106.ХХ) в зависимости от вида имущества.
//
// Параметры:
//   ВидИмущества - ПеречислениеСсылка.ВидыИмущества - вид имущества для определения счетов капвложений
//   Дата - Дата - дата, на которую необходимо получить счета (по умолчанию Неопределено)
//   Организация - СправочникСсылка.Организации - организация, для которой необходимо получить счета (по умолчанию Неопределено)
//
// Возвращаемое значение:
//   Массив из ПланСчетовСсылка.ЕПСБУ - счета капвложений для указанного вида имущества
Функция СчетаКапвложенйПоВидуИмущества(ВидИмущества, Дата = Неопределено, Организация = Неопределено) Экспорт
	КодыСчетов = Новый Массив;
	Если ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.НедвижимоеИмущество") Тогда
		КодыСчетов = "106.10";
	ИначеЕсли ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ДвижимоеОсобоЦенное") Тогда
		КодыСчетов = "106.20";
	ИначеЕсли ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ИноеДвижимое") Тогда
		КодыСчетов = "106.30";
	ИначеЕсли ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.Лизинг") Тогда
		КодыСчетов = "106.40";
	ИначеЕсли ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.Казна") Тогда
		КодыСчетов = "106.50";
	ИначеЕсли ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ПраваПользованияНМА") Тогда
		КодыСчетов = "106.60";
	ИначеЕсли ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ВКонцессии") Тогда
		КодыСчетов = "106.90";
	КонецЕсли;	
	Счета = БухгалтерскийУчет.СписокСчетов(КодыСчетов, Дата,, Организация);
	
	Возврат Счета;
КонецФункции	

