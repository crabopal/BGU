#Область ОбработчикиСобытий

Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)
	
	Перем ЗначениеСвойства;
	
	Если Параметры.Свойство("ВидДокумента", ЗначениеСвойства) Тогда
		
		РазделыУчета = ВводНачальныхОстатковКлиентСервер.ПолучитьРазделыУчетаДляВводаОстатков(ЗначениеСвойства);
		
		Если Не Параметры.Свойство("ВызовИзФормыСписка") Тогда 
			// В помощнике Ввод остатков по учащимся производится на отдельной закладке.
			РазделыУчета.Удалить(РазделыУчета.Найти(Перечисления.РазделыУчетаДляВводаОстатков.Студенты));
		КонецЕсли;
		
		Если Не ПолучитьФункциональнуюОпцию("ИспользоватьУчетРодительскойПлаты") Тогда
			РазделыУчета.Удалить(РазделыУчета.Найти(Перечисления.РазделыУчетаДляВводаОстатков.РодительскаяПлата));
		КонецЕсли;
		
		Если РазделыУчета.Количество() > 0 Тогда
			СтандартнаяОбработка = Ложь;
			ДанныеВыбора = Новый СписокЗначений();
			ДанныеВыбора.ЗагрузитьЗначения(РазделыУчета);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

