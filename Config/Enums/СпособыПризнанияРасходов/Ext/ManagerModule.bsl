Функция ПараметрыВыбораСпособаПризнанияДоходов(ВидОперацииНачисленияДБП) Экспорт
	
	ДопустимыеСпособыПризнанияДоходов = Новый Массив;
	ДопустимыеСпособыПризнанияДоходов.Добавить(Перечисления.СпособыПризнанияРасходов.ПоМесяцам);
	ДопустимыеСпособыПризнанияДоходов.Добавить(Перечисления.СпособыПризнанияРасходов.ПоКалендарнымДням);
	Если ВидОперацииНачисленияДБП <> Перечисления.ВидыОперацийНачисленияДБП.ПередачаВБезвозмездноеПользование Тогда
		// При безвозмездном пользовании не может быть графика платежей.
		ДопустимыеСпособыПризнанияДоходов.Добавить(Перечисления.СпособыПризнанияРасходов.ПоГрафику);
	КонецЕсли;
	ДопустимыеСпособыПризнанияДоходов.Добавить(Перечисления.СпособыПризнанияРасходов.ВОсобомПорядке);
	
	ПараметрВыбора = Новый ПараметрВыбора("Отбор.Ссылка",
		Новый ФиксированныйМассив(ДопустимыеСпособыПризнанияДоходов));
	ПараметрыВыбораСпособаПризнанияДоходов = Новый Массив();
	ПараметрыВыбораСпособаПризнанияДоходов.Добавить(ПараметрВыбора);
	
	Возврат Новый ФиксированныйМассив(ПараметрыВыбораСпособаПризнанияДоходов);
	
КонецФункции

Функция ПараметрыВыбораСпособаПризнанияРасходов(ВидОперацииПринятияКУчетуПравПользованияОС) Экспорт
	
	ДопустимыеСпособыПризнанияРасходов = Новый Массив;
	ДопустимыеСпособыПризнанияРасходов.Добавить(Перечисления.СпособыПризнанияРасходов.ПоМесяцам);
	ДопустимыеСпособыПризнанияРасходов.Добавить(Перечисления.СпособыПризнанияРасходов.ПоКалендарнымДням);
	Если ВидОперацииПринятияКУчетуПравПользованияОС <>
			Перечисления.ВидыОперацийПринятияКУчетуПравПользованияОС.ПоступлениеВБезвозмездноеПользование Тогда
		// При безвозмездном пользовании не может быть графика платежей.
		ДопустимыеСпособыПризнанияРасходов.Добавить(Перечисления.СпособыПризнанияРасходов.ПоГрафику);
	КонецЕсли;
	ДопустимыеСпособыПризнанияРасходов.Добавить(Перечисления.СпособыПризнанияРасходов.ВОсобомПорядке);
	
	ПараметрВыбора = Новый ПараметрВыбора("Отбор.Ссылка",
		Новый ФиксированныйМассив(ДопустимыеСпособыПризнанияРасходов));
	ПараметрыВыбораСпособаПризнанияРасходов = Новый Массив();
	ПараметрыВыбораСпособаПризнанияРасходов.Добавить(ПараметрВыбора);
	
	Возврат Новый ФиксированныйМассив(ПараметрыВыбораСпособаПризнанияРасходов);
	
КонецФункции

