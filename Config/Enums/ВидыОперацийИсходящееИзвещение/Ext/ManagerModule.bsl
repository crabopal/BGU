	ДобавитьВТЗ(Результат, "ОтПолучателя_ОтражениеВУчетеРазделенияЗемельныхУчастковЭДО",					Ложь,	Истина,	Ложь,	Истина);
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)
	ДанныеВыбора = Новый СписокЗначений;
	ДанныеВыбораОтветные = Новый СписокЗначений;
	ДанныеВыбораОтПолучателя = Новый СписокЗначений;
	ОтветныеВиды = ЦентрализованноеСнабжение.ВидыОтветныхОперацийИсходящееИзвещение();
	СтрокаПоиска = Параметры.СтрокаПоиска;
	ЗаданаСтрокаПоиска = ЗначениеЗаполнено(СтрокаПоиска);
	ШаблонИзвещенияОтПолучателя = НСтр("ru = '%1 (извещение от получателя)'");
	ШаблонОтветногоИзвещения = НСтр("ru = '%1 (ответная операция ЭДО)'");
	Для Каждого ЗначениеПеречисления Из Перечисления.ВидыОперацийИсходящееИзвещение Цикл
		Наименование = Строка(ЗначениеПеречисления);
		Если ЗаданаСтрокаПоиска И НЕ СтрНачинаетсяС(Наименование, СтрокаПоиска) Тогда
			Продолжить;
		КонецЕсли;
		Если ОтветныеВиды.Получить(ЗначениеПеречисления) <> Неопределено Тогда
			Наименование = СтрШаблон(ШаблонОтветногоИзвещения, Наименование);
			ДанныеВыбораОтветные.Добавить(ЗначениеПеречисления, Наименование);
		ИначеЕсли ДокументооборотСоСтороныПолучателя(ЗначениеПеречисления) Тогда
			ДанныеВыбораОтПолучателя.Добавить(ЗначениеПеречисления,
				СтрШаблон(ШаблонИзвещенияОтПолучателя, Наименование));
		Иначе
			ДанныеВыбора.Добавить(ЗначениеПеречисления, Наименование);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ВидОтПолучателя Из ДанныеВыбораОтПолучателя Цикл
		ДанныеВыбора.Добавить(ВидОтПолучателя.Значение, ВидОтПолучателя.Представление);
	КонецЦикла;
	Для Каждого ОтветныйВид Из ДанныеВыбораОтветные Цикл
		ДанныеВыбора.Добавить(ОтветныйВид.Значение, ОтветныйВид.Представление);
	КонецЦикла;
	Если ДанныеВыбора.Количество() > 0 Тогда
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции 

Процедура ДобавитьВТЗ(Классификатор, Имя, Классический, ЭДО, СоСтороныОтправителя, СоСтороныПолучателя)
	НоваяСтрока = Классификатор.Добавить();
	НоваяСтрока.ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение[Имя];
	НоваяСтрока.Классический = Классический;
	НоваяСтрока.ЭДО = ЭДО;
	НоваяСтрока.СоСтороныОтправителя = СоСтороныОтправителя;
	НоваяСтрока.СоСтороныПолучателя = СоСтороныПолучателя;
КонецПроцедуры

#КонецОбласти

#КонецЕсли