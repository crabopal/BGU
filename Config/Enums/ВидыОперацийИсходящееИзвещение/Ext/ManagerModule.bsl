#Область ПрограммныйИнтерфейс

// Относится ли ВидИзвещения к документообороту извещениями, который начинается
// на строне получателя.
// 
// Параметры:
//  ВидИзвещения - ПеречислениеСсылка.ВидыОперацийИсходящееИзвещение
// 
// Возвращаемое значение:
//  Булево
Функция ДокументооборотСоСтороныПолучателя(ВидИзвещения) Экспорт
	ВидыОпераций = ЦентрализованноеСнабжениеПовтИсп.КлассификацияВидовОпераций(ПустаяСсылка());
	СтрокаВидаИзвещения = ВидыОпераций.Найти(ВидИзвещения, "ВидИзвещения");
	Если СтрокаВидаИзвещения <> Неопределено Тогда
		Возврат СтрокаВидаИзвещения.СоСтороныПолучателя;
	КонецЕсли;
	
	Возврат Ложь;
КонецФункции

// Виды ответных операций.
// 
// Возвращаемое значение:
//  Соответствие - Виды ответных операций
Функция ВидыОтветныхОпераций() Экспорт
	Возврат ЦентрализованноеСнабжение.ВидыОтветныхОперацийИсходящееИзвещение();
КонецФункции

// Классификация видов операций.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Классификация видов операций:
// * ВидИзвещения - ПеречислениеСсылка.ВидыОперацийИсходящееИзвещение - 
// * Классический - Булево - 
// * ЭДО - Булево - 
// * СоСтороныОтправителя - Булево - 
// * СоСтороныПолучателя - Булево - 
Функция КлассификацияВидовОпераций() Экспорт
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ВидИзвещения", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыОперацийИсходящееИзвещение"));
	Результат.Колонки.Добавить("Классический", Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("ЭДО", Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("СоСтороныОтправителя", Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("СоСтороныПолучателя", Новый ОписаниеТипов("Булево"));
	
