	ДобавитьВТЗ(Результат, "ПередачаТребований",															Истина,	Истина,	Истина,	Ложь);
	ДобавитьВТЗ(Результат, "ПередачаОбязательств",															Истина,	Истина,	Истина,	Ложь);
	ДобавитьВТЗ(Результат, "ПередачаФинансовыхВложений",													Истина,	Истина,	Истина,	Ложь);
	ДобавитьВТЗ(Результат, "ПередачаВложенийВФинансовыеАктивы",												Истина,	Истина,	Истина,	Ложь);
	ДобавитьВТЗ(Результат, "ПередачаРБП",																	Истина,	Истина,	Истина,	Ложь);
	ДобавитьВТЗ(Результат, "НачислениеДохода",																Истина,	Истина,	Истина,	Ложь);
	ДобавитьВТЗ(Результат, "ПолучениеНФАПоставщика",														Ложь,	Истина,	Истина,	Ложь);
	ДобавитьВТЗ(Результат, "ПолучениеНФАСоСклада",															Ложь,	Истина,	Истина,	Ложь);
	ДобавитьВТЗ(Результат, "ПолучениеБСО",																	Истина,	Истина,	Истина,	Ложь);
	ДобавитьВТЗ(Результат, "ПолучениеДенежныхСредств",														Ложь,	Истина,	Истина,	Ложь);
	ДобавитьВТЗ(Результат, "ПолучениеТребований",															Ложь,	Истина,	Истина,	Ложь);
	ДобавитьВТЗ(Результат, "ПолучениеОбязательств",															Истина,	Истина,	Истина,	Ложь);
	ДобавитьВТЗ(Результат, "ПолучениеДохода",																Истина,	Истина,	Истина,	Ложь);
	ДобавитьВТЗ(Результат, "ПолучениеФинансовыхВложений",													Истина,	Истина,	Истина,	Ложь);
	ДобавитьВТЗ(Результат, "ПолучениеВложенийВФинансовыеАктивы",											Истина,	Истина,	Истина,	Ложь);
	ДобавитьВТЗ(Результат, "РасчетыПоМБТ",																	Истина,	Истина,	Истина,	Ложь);
