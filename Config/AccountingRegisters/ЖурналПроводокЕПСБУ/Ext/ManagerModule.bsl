#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция ПолучитьДокументыДвиженийССубконтоСоставногоТипа(ВидыСубконто, КоличествоДокументов = "Все") Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка,
	|	ЕПСБУВидыСубконто.НомерСтроки
	|ПОМЕСТИТЬ ТаблицаСчетов
	|ИЗ
	|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ПО ЕПСБУВидыСубконто.Ссылка = ЕПСБУ.Ссылка
	|ГДЕ
	|	ЕПСБУВидыСубконто.ВидСубконто В(&ВидыСубконтоСоставногоТипа)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ" + ?(КоличествоДокументов = "Все", "", " ПЕРВЫЕ 500") + "
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор КАК Регистратор,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Период КАК Период
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|			,
	|			,
	|			СчетДт В
	|					(ВЫБРАТЬ
	|						ТаблицаСчетов.Ссылка
	|					ИЗ
	|						ТаблицаСчетов КАК ТаблицаСчетов)
	|				ИЛИ СчетКт В
	|					(ВЫБРАТЬ
	|						ТаблицаСчетов.Ссылка
	|					ИЗ
	|						ТаблицаСчетов КАК ТаблицаСчетов),
	|			,
	|			) КАК ЖурналПроводокЕПСБУДвиженияССубконто
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаСчетов КАК ТаблицаСчетовДт
	|		ПО ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт = ТаблицаСчетовДт.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаСчетов КАК ТаблицаСчетовКт
	|		ПО ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт = ТаблицаСчетовКт.Ссылка
	|ГДЕ
	|	(ЕСТЬNULL(ТаблицаСчетовДт.НомерСтроки, 0) = 1
	|				И ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт1 ЕСТЬ NULL 
	|			ИЛИ ЕСТЬNULL(ТаблицаСчетовДт.НомерСтроки, 0) = 2
	|				И ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт2 ЕСТЬ NULL 
	|			ИЛИ ЕСТЬNULL(ТаблицаСчетовДт.НомерСтроки, 0) = 3
	|				И ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт3 ЕСТЬ NULL 
	|			ИЛИ ЕСТЬNULL(ТаблицаСчетовКт.НомерСтроки, 0) = 1
	|				И ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1 ЕСТЬ NULL 
	|			ИЛИ ЕСТЬNULL(ТаблицаСчетовКт.НомерСтроки, 0) = 2
	|				И ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт2 ЕСТЬ NULL 
	|			ИЛИ ЕСТЬNULL(ТаблицаСчетовКт.НомерСтроки, 0) = 3
	|				И ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт3 ЕСТЬ NULL )
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период УБЫВ";
	Запрос.УстановитьПараметр("ВидыСубконтоСоставногоТипа", ВидыСубконто);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса;
	
КонецФункции

Процедура УстановитьПустоеЗначениеВДвиженияхССубконтоСоставногоТипа(ДокументыДвижений, Отказ = Ложь,
	НеБлокироватьДанные = Ложь, РегистрироватьНаУзлахОбмена = Истина, ВызыватьИсключениеПриОшибках = Ложь) Экспорт
	
	Если ДокументыДвижений.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Истина;
	
	УстановитьПривилегированныйРежим(Истина);
	
	ИспользоватьТранзакцию = НЕ ТранзакцияАктивна();
	
	Выборка = ДокументыДвижений.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если ИспользоватьТранзакцию Тогда
			НачатьТранзакцию();
		КонецЕсли;
		
		Если Не НеБлокироватьДанные Тогда
			
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("РегистрБухгалтерии.ЖурналПроводокЕПСБУ.НаборЗаписей");
			ЭлементБлокировки.УстановитьЗначение("Регистратор", Выборка.Регистратор);
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			Блокировка.Заблокировать();
			
		КонецЕсли;
		
		НаборЗаписей = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(Выборка.Регистратор);
		
		НаборЗаписей.Прочитать();
		
		Для каждого ЗаписьНабора Из НаборЗаписей Цикл
			
			Если ЗначениеЗаполнено(ЗаписьНабора.СчетДт) Тогда
				СвойстваСчетаДт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ЗаписьНабора.СчетДт);
				
				Для Счетчик = 1 По 3 Цикл
					
					ВидСубконтоЗаписи = Неопределено;
					СвойстваСчетаДт.Свойство("ВидСубконто" + Счетчик, ВидСубконтоЗаписи);
					Если ЗначениеЗаполнено(ВидСубконтоЗаписи) Тогда
						ТипЗначенияСубконтоЗаписи = Неопределено;
						СвойстваСчетаДт.Свойство("ВидСубконто" + Счетчик + "ТипЗначения", ТипЗначенияСубконтоЗаписи);
						Если ТипЗнч(ТипЗначенияСубконтоЗаписи) = Тип("ОписаниеТипов") Тогда
							ЗаписьНабора.СубконтоДт[ВидСубконтоЗаписи] = ТипЗначенияСубконтоЗаписи.ПривестиЗначение(ЗаписьНабора.СубконтоДт[ВидСубконтоЗаписи]);
						КонецЕсли;
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ЗаписьНабора.СчетКт) Тогда
				СвойстваСчетаКт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ЗаписьНабора.СчетКт);
				
				Для Счетчик = 1 По 3 Цикл
					
					ВидСубконтоЗаписи = Неопределено;
					СвойстваСчетаКт.Свойство("ВидСубконто" + Счетчик, ВидСубконтоЗаписи);
					Если ЗначениеЗаполнено(ВидСубконтоЗаписи) Тогда
						ТипЗначенияСубконтоЗаписи = Неопределено;
						СвойстваСчетаКт.Свойство("ВидСубконто" + Счетчик + "ТипЗначения", ТипЗначенияСубконтоЗаписи);
						Если ТипЗнч(ТипЗначенияСубконтоЗаписи) = Тип("ОписаниеТипов") Тогда
							ЗаписьНабора.СубконтоКт[ВидСубконтоЗаписи] = ТипЗначенияСубконтоЗаписи.ПривестиЗначение(ЗаписьНабора.СубконтоКт[ВидСубконтоЗаписи]);
						КонецЕсли;
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Попытка
			ОбновлениеИнформационнойБазы.ЗаписатьДанные(НаборЗаписей, РегистрироватьНаУзлахОбмена);
			
			Если ИспользоватьТранзакцию Тогда
				ЗафиксироватьТранзакцию();
			КонецЕсли;
		Исключение
			Если НЕ ВызыватьИсключениеПриОшибках Тогда
				// запишем ошибку в ЖР
				ТекстОшибки = НСтр("ru = 'Не удалось установить пустое значение субконто составного типа в проводках документа %1.
					|%2'");
				ЗаписьЖурналаРегистрации("Данные. Изменение",
					УровеньЖурналаРегистрации.Ошибка,
					,
					,
					СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
						Выборка.Регистратор, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
			КонецЕсли;
			Если ИспользоватьТранзакцию Тогда
				ОтменитьТранзакцию();
			КонецЕсли;
			Если ВызыватьИсключениеПриОшибках Тогда
				// используется при отложенных обработчиках обновления
				ВызватьИсключение;
			КонецЕсли;
			Возврат;
		КонецПопытки;
		
	КонецЦикла;
	
	Отказ = Ложь;
	
КонецПроцедуры

// Считает сумму проводок переданного набора записей регистра бухгалтерии или таблицы значений, в которую выгрузили набор записей.
// Подсчет ведется только по счетам указанного типа.
//
// Параметры:
//  Объект				 - РегистрБухгалтерииНаборЗаписей - Набор записей регистра бухгалтерии.
//						 - ТаблицаЗначений - Таблица значений, в которую выгружен набор записей регистра бухгалтерии.
//  ТипСчета			 - ПеречислениеСсылка.ТипыСчетов - тип счета, по которому вычисляется сумма.
//  ВключатьБалансовые	 - Булево - Включать проводки с балансовыми счетами в сумму.
//  ВключатьЗабалансовые - Булево - Включать проводки с забалансовыми счетами в сумму.
// 
// Возвращаемое значение:
// Число - Рассчитанная сумма операции.
//
Функция СуммаПроводок(Объект, ТипСчета, ВключатьБалансовые = Истина, ВключатьЗабалансовые = Ложь) Экспорт
	
	Результат = 0;
	ПроверятьТипСчета = ЗначениеЗаполнено(ТипСчета);
	Если ТипЗнч(Объект) = Тип("РегистрБухгалтерииНаборЗаписей.ЖурналПроводокЕПСБУ")
		ИЛИ ТипЗнч(Объект) = Тип("ТаблицаЗначений") Тогда
		
		Для каждого Запись Из Объект Цикл
			
			ЭтоБалансовыеСчета = Истина;
			
			Если ЗначениеЗаполнено(Запись.СчетДт) Тогда
				СвойстваСчетаДт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Запись.СчетДт);
				ЭтоБалансовыеСчета = НЕ СвойстваСчетаДт.Забалансовый;
			Иначе
				СвойстваСчетаДт = Неопределено;
				ЭтоБалансовыеСчета = Ложь;
				Если НЕ ВключатьЗабалансовые Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Запись.СчетКт) Тогда
				СвойстваСчетаКт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Запись.СчетКт);
			Иначе
				СвойстваСчетаКт = Неопределено;
				Если НЕ ВключатьЗабалансовые Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			Если НЕ ВключатьЗабалансовые И НЕ ЭтоБалансовыеСчета Тогда
				Продолжить;
			КонецЕсли;
			
			Если НЕ ВключатьБалансовые И ЭтоБалансовыеСчета Тогда
				Продолжить;
			КонецЕсли;
			
			Если НЕ ПроверятьТипСчета
				ИЛИ (СвойстваСчетаДт <> Неопределено И СвойстваСчетаДт.ТипСчета = ТипСчета)
				ИЛИ (СвойстваСчетаКт <> Неопределено И СвойстваСчетаКт.ТипСчета = ТипСчета) Тогда
					
				Если ТипЗнч(Запись.Сумма) = Тип("Число") Тогда
					Результат = Результат + Запись.Сумма;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Проверяет какие счета используются в наборе записей регистра бухгалтерии.
// Если используется КраткаяПроверка, то проверяется только использование Балансовых и забалансовых счетов.
// Остальные признаки могут содержать не правильные данные.
//
// Параметры:
//  Объект				 - РегистрБухгалтерииНаборЗаписей - Набор записей регистра бухгалтерии.
//						 - ТаблицаЗначений - Таблица значений, в которую выгружен набор записей регистра бухгалтерии.
//  КраткаяПроверка	 - Булево - 
// 
// Возвращаемое значение:
// Структура - содержит следующие ключи:
//	* Балансовый - Булево - используются балансовые счета.
//	* Забалансовый - Булево - используются забалансовые счета.
//	* Бухгалтерский - Булево - используются счета с типом "Бухгалтерский".
//	* Налоговый - Булево - используются счета с типом "Налоговый".
//	* Управленческий - Булево - используются счета с типом "Управленческий".
//	* Вспомогательный - Булево - используются счета с типом "Вспомогательный".
//
Функция ИспользуемыеСчета(Объект, КраткаяПроверка = Ложь) Экспорт
	
	Результат = Новый Структура("Балансовый, Забалансовый, Бухгалтерский, Налоговый, Управленческий, Вспомогательный");
	Результат.Балансовый      = Ложь;
	Результат.Забалансовый    = Ложь;
	Результат.Бухгалтерский   = Ложь;
	Результат.Налоговый       = Ложь;
	Результат.Управленческий  = Ложь;
	Результат.Вспомогательный = Ложь;
	
	Если ТипЗнч(Объект) = Тип("РегистрБухгалтерииНаборЗаписей.ЖурналПроводокЕПСБУ")
		ИЛИ ТипЗнч(Объект) = Тип("ТаблицаЗначений") Тогда
		
		Для каждого Запись Из Объект Цикл
			
			Если ЗначениеЗаполнено(Запись.СчетДт) Тогда
				СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Запись.СчетДт);
				Если СвойстваСчета.Забалансовый = Истина Тогда
					Результат.Забалансовый = Истина;
				Иначе
					Результат.Балансовый = Истина;
				КонецЕсли;
				Если СвойстваСчета.ТипСчета = Перечисления.ТипыСчетов.Бухгалтерский Тогда
					Результат.Бухгалтерский = Истина;
				ИначеЕсли СвойстваСчета.ТипСчета = Перечисления.ТипыСчетов.Налоговый Тогда
					Результат.Налоговый = Истина;
				ИначеЕсли СвойстваСчета.ТипСчета = Перечисления.ТипыСчетов.Управленческий Тогда
					Результат.Управленческий = Истина;
				ИначеЕсли СвойстваСчета.ТипСчета = Перечисления.ТипыСчетов.Вспомогательный Тогда
					Результат.Вспомогательный = Истина;
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Запись.СчетКт) Тогда
				СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Запись.СчетКт);
				Если СвойстваСчета.Забалансовый = Истина Тогда
					Результат.Забалансовый = Истина;
				Иначе
					Результат.Балансовый = Истина;
				КонецЕсли;
				Если СвойстваСчета.ТипСчета = Перечисления.ТипыСчетов.Бухгалтерский Тогда
					Результат.Бухгалтерский = Истина;
				ИначеЕсли СвойстваСчета.ТипСчета = Перечисления.ТипыСчетов.Налоговый Тогда
					Результат.Налоговый = Истина;
				ИначеЕсли СвойстваСчета.ТипСчета = Перечисления.ТипыСчетов.Управленческий Тогда
					Результат.Управленческий = Истина;
				ИначеЕсли СвойстваСчета.ТипСчета = Перечисления.ТипыСчетов.Вспомогательный Тогда
					Результат.Вспомогательный = Истина;
				КонецЕсли;
			КонецЕсли;
			
			Если КраткаяПроверка И Результат.Балансовый И Результат.Забалансовый Тогда
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Считает сумму проводок переданного набора записей регистра бухгалтерии или таблицы значений, в которую выгрузили набор записей.
// Использует функцию СуммаПроводок().
// Настройкой по умолчанию считается следующее:
//	ТипСчета = Перечисления.ТипыСчетов.Бухгалтерский.
//	Если в наборе есть проводки по балансовым счетам, то сумма вычисляется по балансовым счетам.
//	Если в наборе есть только прооводки по забалансовым счетам, то сумма вычисляется по забалансовым счетам.
//
// Параметры:
//  Объект				 - РегистрБухгалтерииНаборЗаписей - Набор записей регистра бухгалтерии.
//						 - ТаблицаЗначений - Таблица значений, в которую выгружен набор записей регистра бухгалтерии.
// 
// Возвращаемое значение:
// Число - Рассчитанная сумма операции.
//
Функция СуммаПроводокПоНастройкамПоУмолчанию(Объект) Экспорт
	
	Если ТипЗнч(Объект) <> Тип("РегистрБухгалтерииНаборЗаписей.ЖурналПроводокЕПСБУ")
		И ТипЗнч(Объект) <> Тип("ТаблицаЗначений") Тогда
		
		Возврат 0;
		
	КонецЕсли;
	
	ТипЧисло = Новый ОписаниеТипов("Число");
	СуммаБалансовые = 0;
	СуммаЗабалансовые = 0;
	ЗабалансовыеПроводкиДт = Новый Массив;
	ЗабалансовыеПроводкиКт = Новый Массив;
	ИспользуютсяБалансовыеСчета = Ложь;
	
	Для каждого Запись Из Объект Цикл
			
		ЭтоБалансовыеСчета = Ложь;
		СвойстваСчетаДт = Неопределено;
		СчетДтЗаполнен = Ложь;
		СчетКтЗаполнен = Ложь;
			
		Если ЗначениеЗаполнено(Запись.СчетДт) Тогда
			СвойстваСчетаДт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Запись.СчетДт);
			СчетДтЗаполнен = Истина;
		КонецЕсли;
		Если ЗначениеЗаполнено(Запись.СчетКт) Тогда
			СчетКтЗаполнен = Истина;
		КонецЕсли;
		
		Если СчетДтЗаполнен И НЕ СвойстваСчетаДт.Забалансовый Тогда
			ЭтоБалансовыеСчета = Истина;
			ИспользуютсяБалансовыеСчета = Истина;
			СуммаБалансовые = СуммаБалансовые + ТипЧисло.ПривестиЗначение(Запись.Сумма);
		КонецЕсли;
		
		Если НЕ ЭтоБалансовыеСчета Тогда
			Если СчетДтЗаполнен И СчетКтЗаполнен Тогда
				СуммаЗабалансовые = СуммаЗабалансовые + ТипЧисло.ПривестиЗначение(Запись.Сумма);
			ИначеЕсли СчетДтЗаполнен Тогда
				ЗабалансовыеПроводкиДт.Добавить(Запись);
			Иначе
				ЗабалансовыеПроводкиКт.Добавить(Запись);
			КонецЕсли;
		КонецЕсли;
			
	КонецЦикла;
	
	Если ИспользуютсяБалансовыеСчета Тогда
		// Сумма операции складывается из сумм балансовых проводок
		Возврат СуммаБалансовые;
	КонецЕсли;
	
	Если ЗабалансовыеПроводкиДт.Количество() = 0 И ЗабалансовыеПроводкиКт.Количество() = 0 Тогда
		// Дополнительная проверка на внутреннее перемещение не требуется
		Возврат СуммаЗабалансовые;
	КонецЕсли;
	
	ПроверяемыеПроводки = Новый ТаблицаЗначений;
	ПроверяемыеПроводки.Колонки.Добавить("Счет", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПроверяемыеПроводки.Колонки.Добавить("КПС", Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов, Null"));
	ПроверяемыеПроводки.Колонки.Добавить("КФО", Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПроверяемыеПроводки.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число, Null"));
	ПроверяемыеПроводки.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	ПроверяемыеПроводки.Колонки.Добавить("ЗаписьДт");
	
	Для Каждого ЗаписьДт Из ЗабалансовыеПроводкиДт Цикл
		ЗаписьДляПроверки = ПроверяемыеПроводки.Добавить();
		ЗаписьДляПроверки.Счет = ЗаписьДт.СчетДт;
		ЗаписьДляПроверки.КПС = ЗаписьДт.КПСДт;
		ЗаписьДляПроверки.КФО = ЗаписьДт.КФО;
		ЗаписьДляПроверки.Количество = ТипЧисло.ПривестиЗначение(ЗаписьДт.КоличествоДт);
		ЗаписьДляПроверки.Сумма = ТипЧисло.ПривестиЗначение(ЗаписьДт.Сумма);
		ЗаписьДляПроверки.ЗаписьДт = ЗаписьДт;
	КонецЦикла;
	
	ПроверяемыеПроводки.Индексы.Добавить("Счет, КПС, КФО, Количество, Сумма");
	Отбор = Новый Структура;
	Отбор.Вставить("Счет", ПланыСчетов.ЕПСБУ.ПустаяСсылка());
	Отбор.Вставить("КПС", Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка());
	Отбор.Вставить("КФО", Перечисления.КВД.ПустаяСсылка());
	Отбор.Вставить("Количество", 0);
	Отбор.Вставить("Сумма", 0);
	СопоставленныеПроводкиДт = Новый Массив;
	НесопоставленныеПроводкиКт = Новый Массив;
	
	Для Каждого ЗаписьКт Из ЗабалансовыеПроводкиКт Цикл
		Отбор.Счет = ЗаписьКт.СчетКт;
		Отбор.КПС = ЗаписьКт.КПСКт;
		Отбор.КФО = ЗаписьКт.КФО;
		Отбор.Количество = ЗаписьКт.КоличествоКт;
		Отбор.Сумма = ТипЧисло.ПривестиЗначение(ЗаписьКт.Сумма);
		
		ПодходящиеПроводкиДт = ПроверяемыеПроводки.НайтиСтроки(Отбор);
		Если ПодходящиеПроводкиДт.Количество() > 0 Тогда
			// Кредитовая запись подходит под внутреннее перемещение с найденной дебетовой записью
			СопоставленныеПроводкиДт.Добавить(ПодходящиеПроводкиДт[0].ЗаписьДт);
			ПроверяемыеПроводки.Удалить(ПодходящиеПроводкиДт[0]);
		Иначе
			НесопоставленныеПроводкиКт.Добавить(ЗаписьКт);
		КонецЕсли;
		
	КонецЦикла;
	
	// Все несопоставленные проводки Дт включаются в сумму операции
	СуммаЗабалансовые = СуммаЗабалансовые + ПроверяемыеПроводки.Итог("Сумма");
	// По сопоставленным проводкам сумму берем только из дебетовой записи, чтобы не было удвоений суммы
	Для Каждого СуммируемаяПроводкаДт Из СопоставленныеПроводкиДт Цикл
		СуммаЗабалансовые = СуммаЗабалансовые + СуммируемаяПроводкаДт.Сумма;
	КонецЦикла;
	Для Каждого СуммируемаяПроводкаКт Из НесопоставленныеПроводкиКт Цикл
		СуммаЗабалансовые = СуммаЗабалансовые + СуммируемаяПроводкаКт.Сумма;
	КонецЦикла;
	
	Возврат СуммаЗабалансовые;
	
КонецФункции

// Устанавливает новое значение в измерения и ресурсы регистра бухгалтерии. Имена реквизитов
// определяются автоматически по переданному признаку учета.
// 
// Параметры:
// 	Счета - Массив - массив ссылок ПланСчетовСсылка.ЕПСБУ
// 	      - ПланСчетовСсылка.ЕПСБУ - ссылка на счет
// 	ИмяПризнакаУчета - Строка - имя признака учета
// 	НовоеЗначение - Произвольный - новое значение
Процедура ОчиститьИзмерениеПоПризнакуУчета(Счета, Знач ИмяПризнакаУчета, НовоеЗначение) Экспорт
	
	Если Не ЗначениеЗаполнено(Счета) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ИмяПризнакаУчета) = Тип("Строка") Тогда
		ИмяПризнакаУчета = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ИмяПризнакаУчета);
	КонецЕсли;
	
	ПроверяемыеСчета = Новый Соответствие;
	Если ТипЗнч(Счета) = Тип("ПланСчетовСсылка.ЕПСБУ") Тогда
		ПроверяемыеСчета.Вставить(Счета, Счета);
	ИначеЕсли ТипЗнч(Счета) = Тип("Массив") Тогда
		Для Каждого ПроверяемыйСчет Из Счета Цикл
			ПроверяемыеСчета.Вставить(ПроверяемыйСчет, ПроверяемыйСчет);
		КонецЦикла;
	КонецЕсли;
	
	ЗаменяемыеИменаДт = ИменаИзменяемыхРеквизитов(ИмяПризнакаУчета,"Дт");
	ЗаменяемыеИменаКт = ИменаИзменяемыхРеквизитов(ИмяПризнакаУчета,"Кт");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЖурналПроводокЕПСБУ.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(,,
	|		СчетДт В (&Счета) И &ДопУсловиеДт
	|		ИЛИ СчетКт В (&Счета) И &ДопУсловиеКт,,) КАК ЖурналПроводокЕПСБУ";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДопУсловиеДт",
		ДопУсловиеЗапросаПоПризнакуУчета(ЗаменяемыеИменаДт, НовоеЗначение));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДопУсловиеКт",
		ДопУсловиеЗапросаПоПризнакуУчета(ЗаменяемыеИменаКт, НовоеЗначение));
	Запрос.УстановитьПараметр("Счета", Счета);
	Результат = Запрос.Выполнить();
	
	ВыборкаРегистратор = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаРегистратор.Следующий() Цикл
		
		НаборЗаписейРБ = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей();
		НаборЗаписейРБ.Отбор.Регистратор.Установить(ВыборкаРегистратор.Регистратор);
		НаборЗаписейРБ.Прочитать();
		
		Для Каждого Запись Из НаборЗаписейРБ Цикл
			Если ПроверяемыеСчета.Получить(Запись.СчетДт) <> Неопределено Тогда
				ОчиститьРеквизитыЗаписиНабора(Запись, ЗаменяемыеИменаДт, НовоеЗначение);
			КонецЕсли;
			Если ПроверяемыеСчета.Получить(Запись.СчетКт) <> Неопределено Тогда
				ОчиститьРеквизитыЗаписиНабора(Запись, ЗаменяемыеИменаКт, НовоеЗначение);
			КонецЕсли;
		КонецЦикла;
		
		НаборЗаписейРБ.ОбменДанными.Загрузка = Истина;
		НаборЗаписейРБ.Записать(Истина);
		
	КонецЦикла;
	
КонецПроцедуры

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт
	
	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

#КонецОбласти

#Область ОбновлениеИнформационнойБазы

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	// Проверяются проводки с ПустымЗначением вместо NULL в измерениях Валюта, Подразделение, КПС, КЭК
	
	ПолноеИмяРегистра = "РегистрБухгалтерии.ЖурналПроводокЕПСБУ";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВалютныйУчет"			, ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	Запрос.УстановитьПараметр("ВалютаРеглУчета"			, БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета());
	Запрос.УстановитьПараметр("УчетПоПодразделениям"	, ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Запрос.УстановитьПараметр("ПустоеПодразделение"		, Справочники.Подразделения.ПустаяСсылка());
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЖурналПроводокЕПСБУ.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ЖурналПроводокЕПСБУ
	|ГДЕ
	|	(ВЫБОР
	|				КОГДА НЕ ЕСТЬNULL(ЖурналПроводокЕПСБУ.СчетДт.Валютный, ЛОЖЬ)
	|					ТОГДА НЕ ЖурналПроводокЕПСБУ.ВалютаДт ЕСТЬ NULL
	|				КОГДА НЕ &ВалютныйУчет
	|					ТОГДА ЖурналПроводокЕПСБУ.ВалютаДт <> &ВалютаРеглУчета
	|				ИНАЧЕ ЛОЖЬ
	|			КОНЕЦ
	|			ИЛИ ВЫБОР
	|				КОГДА НЕ ЕСТЬNULL(ЖурналПроводокЕПСБУ.СчетКт.Валютный, ЛОЖЬ)
	|					ТОГДА НЕ ЖурналПроводокЕПСБУ.ВалютаКт ЕСТЬ NULL
	|				КОГДА НЕ &ВалютныйУчет
	|					ТОГДА ЖурналПроводокЕПСБУ.ВалютаКт <> &ВалютаРеглУчета
	|				ИНАЧЕ ЛОЖЬ
	|			КОНЕЦ
	|			ИЛИ ВЫБОР
	|				КОГДА НЕ ЕСТЬNULL(ЖурналПроводокЕПСБУ.СчетДт.УчетПоПодразделениям, ЛОЖЬ)
	|					ТОГДА НЕ ЖурналПроводокЕПСБУ.ПодразделениеДт ЕСТЬ NULL
	|				КОГДА НЕ &УчетПоПодразделениям
	|					ТОГДА ЖурналПроводокЕПСБУ.ПодразделениеДт <> &ПустоеПодразделение
	|				ИНАЧЕ ЛОЖЬ
	|			КОНЕЦ
	|			ИЛИ ВЫБОР
	|				КОГДА НЕ ЕСТЬNULL(ЖурналПроводокЕПСБУ.СчетКт.УчетПоПодразделениям, ЛОЖЬ)
	|					ТОГДА НЕ ЖурналПроводокЕПСБУ.ПодразделениеКт ЕСТЬ NULL
	|				КОГДА НЕ &УчетПоПодразделениям
	|					ТОГДА ЖурналПроводокЕПСБУ.ПодразделениеКт <> &ПустоеПодразделение
	|				ИНАЧЕ ЛОЖЬ
	|			КОНЕЦ
	|			ИЛИ НЕ ЕСТЬNULL(ЖурналПроводокЕПСБУ.СчетДт.УчетПоКПС, ЛОЖЬ)
	|				И НЕ ЖурналПроводокЕПСБУ.КПСДт ЕСТЬ NULL
	|			ИЛИ НЕ ЕСТЬNULL(ЖурналПроводокЕПСБУ.СчетКт.УчетПоКПС, ЛОЖЬ)
	|				И НЕ ЖурналПроводокЕПСБУ.КПСКт ЕСТЬ NULL
	|			ИЛИ НЕ ЕСТЬNULL(ЖурналПроводокЕПСБУ.СчетДт.УчетПоКЭК, ЛОЖЬ)
	|				И НЕ ЖурналПроводокЕПСБУ.КЭКДт ЕСТЬ NULL
	|			ИЛИ НЕ ЕСТЬNULL(ЖурналПроводокЕПСБУ.СчетКт.УчетПоКЭК, ЛОЖЬ)
	|				И НЕ ЖурналПроводокЕПСБУ.КЭККт ЕСТЬ NULL)";
	
	Регистраторы = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Регистратор");
	
	ОбновлениеИнформационнойБазы.ОтметитьРегистраторыКОбработке(Параметры, Регистраторы, ПолноеИмяРегистра);
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	ПолноеИмяРегистра = "РегистрБухгалтерии.ЖурналПроводокЕПСБУ";
	
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьРегистраторыРегистраДляОбработки(
		Параметры.Очередь, Неопределено, ПолноеИмяРегистра);
	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыОтметкиОбработки();
	ДополнительныеПараметры.ЭтоДвижения = Истина;
	ДополнительныеПараметры.ПолноеИмяРегистра = ПолноеИмяРегистра;
	
	ВалютныйУчет					= ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	ВалютаРегламентированногоУчета	= БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета();
	УчетПоПодразделениям			= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	ПустоеПодразделение				= Справочники.Подразделения.ПустаяСсылка();
	
	Параметры.ОбработкаЗавершена = Ложь;
	
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрБухгалтерии.ЖурналПроводокЕПСБУ.НаборЗаписей");
		ЭлементБлокировки.УстановитьЗначение("Регистратор", Выборка.Регистратор);
		
		Попытка
			Блокировка.Заблокировать();
		Исключение
			// Объект не удается заблокировать - попробуем обработать его на следующей итерации.
			// Отдельно обрабатывать ошибку не требуется, т.к. в худшем случае обработчик зациклится
			// и прервется автоматически.
			ОбновлениеИнформационнойБазыБГУ.СообщитьОНеудачнойБлокировке(Выборка.Регистратор);
			ЗафиксироватьТранзакцию();
			Продолжить;
		КонецПопытки;
		
		НаборЗаписей = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(Выборка.Регистратор);
		
		НаборЗаписей.Прочитать();
		Модифицированность = Ложь;
		
		Для Каждого СтрокаНабора Из НаборЗаписей Цикл
			
			ЕстьСчетДт = ЗначениеЗаполнено(СтрокаНабора.СчетДт);
			СвойстваСчетаДт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаНабора.СчетДт);
			
			ЕстьСчетКт = ЗначениеЗаполнено(СтрокаНабора.СчетКт);
			СвойстваСчетаКт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаНабора.СчетКт);
			
			// Проводки с ПустымЗначением вместо NULL в измерении Валюта
			Если Не ЕстьСчетДт Или Не СвойстваСчетаДт.Валютный Тогда
				УстановитьЗначение(СтрокаНабора.ВалютаДт, Null, Модифицированность);
			ИначеЕсли Не ВалютныйУчет Тогда
				УстановитьЗначение(СтрокаНабора.ВалютаДт, ВалютаРегламентированногоУчета, Модифицированность);
			КонецЕсли;
			Если Не ЕстьСчетКт Или Не СвойстваСчетаКт.Валютный Тогда
				УстановитьЗначение(СтрокаНабора.ВалютаКт, Null, Модифицированность);
			ИначеЕсли Не ВалютныйУчет Тогда
				УстановитьЗначение(СтрокаНабора.ВалютаКт, ВалютаРегламентированногоУчета, Модифицированность);
			КонецЕсли;
			
			// Проводки с ПустымЗначением вместо NULL в измерении Подразделение
			Если Не ЕстьСчетДт Или Не СвойстваСчетаДт.УчетПоПодразделениям Тогда
				УстановитьЗначение(СтрокаНабора.ПодразделениеДт, Null, Модифицированность);
			ИначеЕсли Не УчетПоПодразделениям Тогда
				УстановитьЗначение(СтрокаНабора.ПодразделениеДт, ПустоеПодразделение, Модифицированность);
			КонецЕсли;
			Если Не ЕстьСчетКт Или Не СвойстваСчетаКт.УчетПоПодразделениям Тогда
				УстановитьЗначение(СтрокаНабора.ПодразделениеКт, Null, Модифицированность);
			ИначеЕсли Не УчетПоПодразделениям Тогда
				УстановитьЗначение(СтрокаНабора.ПодразделениеКт, ПустоеПодразделение, Модифицированность);
			КонецЕсли;
			
			// Проводки с ПустымЗначением вместо NULL в измерении КПС
			Если Не ЕстьСчетДт Или Не СвойстваСчетаДт.УчетПоКПС Тогда
				УстановитьЗначение(СтрокаНабора.КПСДт, Null, Модифицированность);
			КонецЕсли;
			Если Не ЕстьСчетКт Или Не СвойстваСчетаКт.УчетПоКПС Тогда
				УстановитьЗначение(СтрокаНабора.КПСКт, Null, Модифицированность);
			КонецЕсли;
			
			// Проводки с ПустымЗначением вместо NULL в измерении КЭК
			Если Не ЕстьСчетДт Или Не СвойстваСчетаДт.УчетПоКЭК Тогда
				УстановитьЗначение(СтрокаНабора.КЭКДт, Null, Модифицированность);
			КонецЕсли;
			Если Не ЕстьСчетКт Или Не СвойстваСчетаКт.УчетПоКЭК Тогда
				УстановитьЗначение(СтрокаНабора.КЭККт, Null, Модифицированность);
			КонецЕсли;
			
		КонецЦикла;
		
		Если Не Модифицированность Тогда
			ЗафиксироватьТранзакцию();
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Регистратор, ДополнительныеПараметры);
			Продолжить;
		КонецЕсли;
		
		Попытка
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
			ЗафиксироватьТранзакцию();
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстСообщения = НСтр("ru = 'Не удалось записать проводки документа: %Документ% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Документ%", Выборка.Регистратор);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(
				ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				Выборка.Регистратор.Метаданные(),
				Выборка.Регистратор,
				ТекстСообщения);
			ВызватьИсключение;
			
		КонецПопытки;
		
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Параметры.Очередь, ПолноеИмяРегистра);
	
	Если Параметры.ОбработкаЗавершена И Выборка.Количество() > 0 Тогда
		Если РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.ПолучитьИспользованиеИтогов() Тогда
			РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.ПересчитатьИтоги();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьЗначение(ТекущееЗначение, НовоеЗначение, Модифицированность)
	
	Если ТекущееЗначение <> НовоеЗначение Тогда
		ТекущееЗначение = НовоеЗначение;
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОчиститьРеквизитыЗаписиНабора(Запись, ЗаменяемыеИмена, НовоеЗначение)
	Для Каждого Имя Из ЗаменяемыеИмена Цикл
		Запись[Имя] = НовоеЗначение;
	КонецЦикла;
КонецПроцедуры

Функция ИменаИзменяемыхРеквизитов(ИменаПризнаковУчета, СторонаПроводки)
	ПризнакиУчета = Новый Массив;
	Для Каждого ИмяПризнака Из ИменаПризнаковУчета Цикл
		ПризнакиУчета.Добавить(Метаданные.ПланыСчетов.ЕПСБУ.ПризнакиУчета.Найти(ИмяПризнака));
	КонецЦикла;
	
	ИменаРеквизитов = Новый Массив;
	
	ЖурналПроводок = Метаданные.РегистрыБухгалтерии.ЖурналПроводокЕПСБУ;
	Коллекции = Новый Массив;
	Коллекции.Добавить(ЖурналПроводок.Измерения);
	Коллекции.Добавить(ЖурналПроводок.Ресурсы);
	Для Каждого КоллекцияОбъектов Из Коллекции Цикл
		Для Каждого ОбъектМетаданных Из КоллекцияОбъектов Цикл
			Если ПризнакиУчета.Найти(ОбъектМетаданных.ПризнакУчета) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если ОбъектМетаданных.Балансовый Тогда
				ИмяОбъекта = ОбъектМетаданных.Имя;
			Иначе
				ИмяОбъекта = ОбъектМетаданных.Имя + СторонаПроводки;
			КонецЕсли;
			ИменаРеквизитов.Добавить(ИмяОбъекта);
		КонецЦикла;
	КонецЦикла;
	
	Возврат ИменаРеквизитов;
	
КонецФункции

Функция ДопУсловиеЗапросаПоПризнакуУчета(ИменаРеквизитов, НовоеЗначение)
	СоставДопУсловия = Новый Массив;
	
	Если НовоеЗначение = Null Тогда
		Условие = " ЕСТЬ НЕ NULL";
	Иначе
		Условие = " <> ЗНАЧЕНИЕ(" + НовоеЗначение.Метаданные().ПолноеИмя() + ".ПустаяСсылка)";
	КонецЕсли;
	
	Для Каждого ИмяОбъекта Из ИменаРеквизитов Цикл
		СоставДопУсловия.Добавить(ИмяОбъекта + Условие);
	КонецЦикла;
	
	Возврат "(" + СтрСоединить(СоставДопУсловия, " ИЛИ ") + ")";
	
КонецФункции

#КонецОбласти

#Область ОбработчикиРИБ

Процедура ВыполнитьКорректировкуСубконтоВПроводках() Экспорт
		
	ВидыСубконтоКОбработке = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВидыСубконто.Ссылка КАК ВидСубконто
	|ИЗ
	|	ПланВидовХарактеристик.ВидыСубконто КАК ВидыСубконто
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВидыСубконто.Наименование";
	
	ВидыСубконтоКОбработке = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ВидСубконто");
	
	ДокументыДвижений = ПолучитьДокументыДвиженийССубконтоСоставногоТипа(ВидыСубконтоКОбработке);
	
	УстановитьПустоеЗначениеВДвиженияхССубконтоСоставногоТипа(ДокументыДвижений);
	
	РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.ПересчитатьИтоги();
	
КонецПроцедуры

#КонецОбласти

