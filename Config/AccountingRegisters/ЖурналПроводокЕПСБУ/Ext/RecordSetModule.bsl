	|		КОГДА ВТ_АналитикиКонтроля.НеУчитыватьПартии3
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ЕПСБУОстатки.Субконто3
	|	КОНЕЦ,
	|	ЕПСБУОстатки.Организация,
	|	ЕПСБУОстатки.ИФО,
	|	ЕПСБУОстатки.КФО,
	|	ЕСТЬNULL(ЕПСБУОстатки.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)),
	|	ЕСТЬNULL(ЕПСБУОстатки.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУОбороты.Период КАК Период,
	|	ЕПСБУОбороты.Регистратор КАК Регистратор,
	|	ЕПСБУОбороты.Организация КАК Организация,
	|	ЕПСБУОбороты.ИФО КАК ИФО,
	|	ЕПСБУОбороты.КФО КАК КФО,
	|	ЕПСБУОбороты.Счет КАК Счет,
	|	ВЫБОР
	|		КОГДА ВТ_АналитикиКонтроля.НеУчитыватьПартии1
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ЕПСБУОбороты.Субконто1
	|	КОНЕЦ КАК Субконто1,
	|	ВЫБОР
	|		КОГДА ВТ_АналитикиКонтроля.НеУчитыватьПартии2
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ЕПСБУОбороты.Субконто2
	|	КОНЕЦ КАК Субконто2,
	|	ВЫБОР
	|		КОГДА ВТ_АналитикиКонтроля.НеУчитыватьПартии3
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ЕПСБУОбороты.Субконто3
	|	КОНЕЦ КАК Субконто3,
	|	ЕСТЬNULL(ЕПСБУОбороты.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) КАК КПС,
	|	ЕСТЬNULL(ЕПСБУОбороты.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК Подразделение,
	|	СУММА(ЕПСБУОбороты.КоличествоОборот) КАК КоличествоОборот,
	|	ЕСТЬNULL(ВТ_НачальныеОстатки.НачальныйОстаток, 0) КАК НачальныйОстаток
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|			&ГраницаНачалаОборотов,
	|			,
	|			Регистратор,
	|			Счет В
	|				(ВЫБРАТЬ
	|					ВТ_АналитикиКонтроля.Счет
	|				ИЗ
	|					ВТ_АналитикиКонтроля),
	|			,
	|			(Организация, КФО, ИФО) В
	|				(ВЫБРАТЬ
	|					ВТ_АналитикиКонтроля.Организация,
	|					ВТ_АналитикиКонтроля.КФО,
	|					ВТ_АналитикиКонтроля.ИФО
	|				ИЗ
	|					ВТ_АналитикиКонтроля),
	|			,
	|			) КАК ЕПСБУОбороты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_АналитикиКонтроля КАК ВТ_АналитикиКонтроля
	|		ПО ЕПСБУОбороты.Организация = ВТ_АналитикиКонтроля.Организация
	|			И ЕПСБУОбороты.ИФО = ВТ_АналитикиКонтроля.ИФО
	|			И ЕПСБУОбороты.КФО = ВТ_АналитикиКонтроля.КФО
	|			И ЕПСБУОбороты.Счет = ВТ_АналитикиКонтроля.Счет
	|			И (ВЫБОР
	|				КОГДА ВТ_АналитикиКонтроля.НеУчитыватьПартии1
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ЕПСБУОбороты.Субконто1 = ВТ_АналитикиКонтроля.Субконто1
	|			КОНЕЦ)
	|			И (ВЫБОР
	|				КОГДА ВТ_АналитикиКонтроля.НеУчитыватьПартии2
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ЕПСБУОбороты.Субконто2 = ВТ_АналитикиКонтроля.Субконто2
	|			КОНЕЦ)
	|			И (ВЫБОР
	|				КОГДА ВТ_АналитикиКонтроля.НеУчитыватьПартии3
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ЕПСБУОбороты.Субконто3 = ВТ_АналитикиКонтроля.Субконто3
	|			КОНЕЦ)
	|			И (ЕСТЬNULL(ЕПСБУОбороты.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) = ВТ_АналитикиКонтроля.КПС)
	|			И (ЕСТЬNULL(ЕПСБУОбороты.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) = ВТ_АналитикиКонтроля.Подразделение)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_НачальныеОстатки КАК ВТ_НачальныеОстатки
	|		ПО ЕПСБУОбороты.Организация = ВТ_НачальныеОстатки.Организация
	|			И ЕПСБУОбороты.ИФО = ВТ_НачальныеОстатки.ИФО
	|			И ЕПСБУОбороты.КФО = ВТ_НачальныеОстатки.КФО
	|			И ЕПСБУОбороты.Счет = ВТ_НачальныеОстатки.Счет
	|			И (ВЫБОР
	|				КОГДА ВТ_АналитикиКонтроля.НеУчитыватьПартии1
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ЕПСБУОбороты.Субконто1 = ВТ_НачальныеОстатки.Субконто1
	|			КОНЕЦ)
	|			И (ВЫБОР
	|				КОГДА ВТ_АналитикиКонтроля.НеУчитыватьПартии1
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ЕПСБУОбороты.Субконто2 = ВТ_НачальныеОстатки.Субконто2
	|			КОНЕЦ)
	|			И (ВЫБОР
	|				КОГДА ВТ_АналитикиКонтроля.НеУчитыватьПартии1
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ЕПСБУОбороты.Субконто3 = ВТ_НачальныеОстатки.Субконто3
	|			КОНЕЦ)
	|			И (ЕСТЬNULL(ЕПСБУОбороты.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) = ВТ_НачальныеОстатки.КПС)
	|			И (ЕСТЬNULL(ЕПСБУОбороты.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) = ВТ_НачальныеОстатки.Подразделение)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕПСБУОбороты.Период,
	|	ЕПСБУОбороты.Регистратор,
	|	ЕПСБУОбороты.Организация,
	|	ЕПСБУОбороты.ИФО,
	|	ЕПСБУОбороты.КФО,
	|	ЕПСБУОбороты.Счет,
	|	ВЫБОР
	|		КОГДА ВТ_АналитикиКонтроля.НеУчитыватьПартии1
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ЕПСБУОбороты.Субконто1
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ВТ_АналитикиКонтроля.НеУчитыватьПартии2
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ЕПСБУОбороты.Субконто2
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ВТ_АналитикиКонтроля.НеУчитыватьПартии3
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ЕПСБУОбороты.Субконто3
	|	КОНЕЦ,
	|	ЕСТЬNULL(ЕПСБУОбороты.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)),
	|	ЕСТЬNULL(ЕПСБУОбороты.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)),
	|	ЕСТЬNULL(ВТ_НачальныеОстатки.НачальныйОстаток, 0)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период,
	|	Регистратор";
	
	ДополнитьЗапросАналитикамиРезерва(Запрос, Параметры.РезервироватьМЗПриВыбытии, "ПоРегистраторам");
	
	Запрос.УстановитьПараметр("ГраницаОстатков", Новый Граница(Параметры.МоментВремени, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ГраницаНачалаОборотов", Новый Граница(Параметры.МоментВремени, ВидГраницы.Исключая));
	
	ТаблицаКонтроля = Запрос.Выполнить().Выгрузить();
	
	ТаблицаАналитик = ?(ТаблицаАналитик = Неопределено, Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("ВТ_АналитикиКонтроля").ПолучитьДанные().Выгрузить(), ТаблицаАналитик);
	КлючиАналитики = "Организация,ИФО,КФО,Счет,Субконто1,Субконто2,Субконто3,КПС,Подразделение";
	
	ТаблицаКонтроля.Индексы.Добавить(КлючиАналитики);
	Если Параметры.РезервироватьМЗПриВыбытии Тогда
		ТаблицаТекущихОстатковРезерва = Запрос.МенеджерВременныхТаблиц.Таблицы.Найти("ВТ_ДанныеТекущийРезервМЗ").ПолучитьДанные().Выгрузить();
		ТаблицаТекущихОстатковРезерва.Индексы.Добавить(КлючиАналитики);
	КонецЕсли;

	ОшибкиКонтроля = Неопределено;
	
	ОтборСтрок = Новый Структура(КлючиАналитики);
	
	Для Каждого Аналитика Из ТаблицаАналитик Цикл
		
		ЗаполнитьЗначенияСвойств(ОтборСтрок, Аналитика);
		Оборот = 0; Резерв = 0;ТекущийОстаток = 0;
		
		СтрокиКонтроля = ТаблицаКонтроля.НайтиСтроки(ОтборСтрок);
		Для Каждого ДанныеРегистратора Из СтрокиКонтроля Цикл
			
			Оборот = Оборот + ДанныеРегистратора.КоличествоОборот;
			ТекущийОстаток = Оборот + ДанныеРегистратора.НачальныйОстаток;
			
			Если Параметры.РезервироватьМЗПриВыбытии Тогда
				Резерв = ДанныеРегистратора.ОборотРезервМЗ + ДанныеРегистратора.НачальныйОстатокРезервМЗ;
				ТекущийОстаток = ТекущийОстаток - Резерв;
			КонецЕсли;
			
			Если ТекущийОстаток < 0 Тогда
				
				СтрокаСообщения = НСтр("ru = 'Изменение количества в текущем документе: %1, не хватает: %2 для проведения %3'") + Символы.ПС + НСтр("ru = 'по '");
				
				Если Резерв > 0 Тогда
					СтрокаСообщения = НСтр("ru = 'Изменение количества в текущем документе: %1, не хватает: %2 с учетом резерва: %8 для проведения %3'") +
						Символы.ПС + НСтр("ru = 'по '");
				КонецЕсли;
				
				ПараметрыДобавления = Новый Структура;
				ПараметрыДобавления.Вставить("УчетПоИФО", Параметры.УчетПоИФО);
				ПараметрыДобавления.Вставить("ТекущийОстаток", ТекущийОстаток);
				ПараметрыДобавления.Вставить("Резерв", Резерв);
				ПараметрыДобавления.Вставить("Регистратор", ДанныеРегистратора.Регистратор);

				ДобавитьОшибкуКонтроляОстатков(СтрокаСообщения, Аналитика, ОшибкиКонтроля, ПараметрыДобавления);
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если Параметры.РезервироватьМЗПриВыбытии Тогда
			СтрокиТекущийРезерв = ТаблицаТекущихОстатковРезерва.НайтиСтроки(ОтборСтрок);
			Если СтрокиТекущийРезерв.Количество() Тогда
				Резерв = СтрокиТекущийРезерв[0].ТекущийОстатокРезервМЗ - Резерв;
				Если Резерв > 0 Тогда
					ТекущийОстаток = ?(ТекущийОстаток = 0, СтрокиТекущийРезерв[0].ТекущийОстаток, ТекущийОстаток);
					ТекущийОстаток = ТекущийОстаток - Резерв;
					Если ТекущийОстаток < 0 Тогда
						
						СтрокаСообщения = НСтр("ru = 'Изменение количества в текущем документе: %1, не хватает текущего остатка на: %2 с учетом резерва: %8'") +
							Символы.ПС + НСтр("ru = 'по '");
						
						ПараметрыДобавления = Новый Структура;
						ПараметрыДобавления.Вставить("УчетПоИФО", Параметры.УчетПоИФО);
						ПараметрыДобавления.Вставить("ТекущийОстаток", ТекущийОстаток);
						ПараметрыДобавления.Вставить("Резерв", Резерв);
						
						ДобавитьОшибкуКонтроляОстатков(СтрокаСообщения, Аналитика, ОшибкиКонтроля, ПараметрыДобавления);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(ОшибкиКонтроля, Отказ);

КонецПроцедуры

Процедура ДобавитьОшибкуКонтроляОстатков(СтрокаСообщения, Аналитика, ОшибкиКонтроля, Параметры)
	
	Если ОшибкиКонтроля = Неопределено Тогда
		СтрокаСообщения = НСтр("ru = 'Контроль доступных остатков при изменении в прошлых периодах!'") + Символы.ПС + СтрокаСообщения;
	КонецЕсли;

	СтрокаСубконто = "%1: %2";
	Если ЗначениеЗаполнено(Аналитика.Субконто2) Тогда
		СтрокаСубконто = СтрокаСубконто + ", %3: %4";
	КонецЕсли;
	Если ЗначениеЗаполнено(Аналитика.Субконто3) Тогда
		СтрокаСубконто = СтрокаСубконто + ", %5: %6";
	КонецЕсли;
	
	СтрокаСубконто = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		СтрокаСубконто,
		Аналитика.ВидСубконто1, Аналитика.Субконто1,
		Аналитика.ВидСубконто2, Аналитика.Субконто2,
		Аналитика.ВидСубконто3, Аналитика.Субконто3);
	
	Если Параметры.УчетПоИФО Тогда
		СтрокаСообщения = СтрокаСообщения + "ИФО: %4, "
	КонецЕсли;
	
	СтрокаСообщения = СтрокаСообщения + "КФО: %5, ";
	СтрокаСообщения = СтрокаСообщения + СтрокаСубконто;
	
	Если Аналитика.УчетПоКПС Тогда
		СтрокаСообщения = СтрокаСообщения + ", КПС: %6";
	КонецЕсли;
	Если Аналитика.УчетПоПодразделениям Тогда
		СтрокаСообщения = СтрокаСообщения + ", Подразделение: %7";
	КонецЕсли;
	
	ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru='" +СтрокаСообщения + "'"),
		Аналитика.КоличествоИзменение,
		-Параметры.ТекущийОстаток,
		ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "Регистратор"),
		Аналитика.ИФО,
		Аналитика.КФО,
		Аналитика.КПС,
		Аналитика.Подразделение,
		Параметры.Резерв);
	
	ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(ОшибкиКонтроля, , ТекстОшибки);
	
КонецПроцедуры

Процедура ДополнитьЗапросАналитикамиРезерва(Запрос, РезервироватьМЗПриВыбытии, ТипКонтроля)
	
	Если Не РезервироватьМЗПриВыбытии Тогда
		Возврат;
	КонецЕсли;
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(Запрос.Текст);
	
	ТекстыЗапросовДобавления = Новый Массив;
	Если ТипКонтроля = "ПоРегистраторам" Тогда
		ТекстыЗапросовДобавления.Добавить(ТекстЗапросаВТ_НачальныеОстаткиРезервМЗ());
		ТекстыЗапросовДобавления.Добавить(ТекстЗапросаВТ_ОборотыРезервМЗ());
		ТекстыЗапросовДобавления.Добавить(ТекстЗапросаВТ_ДанныеТекущийРезервМЗ());
	Иначе
		ТекстыЗапросовДобавления.Добавить(ТекстЗапросаВТ_ТекущиеОстаткиРезервМЗ());
	КонецЕсли;
	
	Для Каждого ТекстЗапроса Из ТекстыЗапросовДобавления Цикл
		ЗапросПакетаВТ = СхемаЗапроса.ПакетЗапросов.Добавить();
		ЗапросПакетаВТ.УстановитьТекстЗапроса(ТекстЗапроса);
		СхемаЗапроса.ПакетЗапросов.Сдвинуть(ЗапросПакетаВТ, -1);
	КонецЦикла;

	ЗапросПакетаВыборка = СхемаЗапроса.ПакетЗапросов[СхемаЗапроса.ПакетЗапросов.Количество() -1];
	Если ТипКонтроля = "ПоРегистраторам" Тогда
		ДополнитьТекстТаблицыВыборки(ЗапросПакетаВыборка, "ЕПСБУОбороты");
	Иначе
		ДополнитьТекстТаблицыВыборки(ЗапросПакетаВыборка, "ВТ_АналитикиКонтроля");
	КонецЕсли;

	Запрос.Текст = СхемаЗапроса.ПолучитьТекстЗапроса();
		
Конецпроцедуры

Процедура ДополнитьТекстТаблицыВыборки(ЗапросПакета, ВнутренееИмяТаблицы)
	
	Оператор = ЗапросПакета.Операторы[0];
	
	Для Каждого ИсточникСхемыЗапроса Из Оператор.Источники Цикл
		Если ИсточникСхемыЗапроса.Источник.Псевдоним = "ВТ_АналитикиКонтроля" Тогда
			ИсточникСхемыЗапроса.Источник.ДоступныеПоля.Добавить("Номенклатура");
			ИсточникСхемыЗапроса.Источник.ДоступныеПоля.Добавить("ЦМО");
			ИсточникСхемыЗапроса.Источник.ДоступныеПоля.Добавить("ДопАналитика");
		КонецЕсли;
	КонецЦикла;
	
	ДобавитьУникальныеПоляАналитикРезерваМЗ(Оператор, ЗапросПакета, ВнутренееИмяТаблицы);
	
	Если ВнутренееИмяТаблицы = "ЕПСБУОбороты" Тогда
		ДобавитьСоединениеСВТРезервы(ЗапросПакета, Оператор, ВнутренееИмяТаблицы, "ВТ_НачальныеОстаткиРезервМЗ", "НачальныйОстатокРезервМЗ");
		ДобавитьСоединениеСВТРезервы(ЗапросПакета, Оператор, ВнутренееИмяТаблицы, "ВТ_ОборотыРезервыМЗ", "ОборотРезервМЗ");
	Иначе
		ДобавитьСоединениеСВТРезервы(ЗапросПакета, Оператор, ВнутренееИмяТаблицы, "ВТ_ТекущиеОстаткиРезервМЗ", "РезервМЗ");
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьУникальныеПоляАналитикРезерваМЗ(Оператор, ЗапросПакета, ВнутренееИмяТаблицы)
	
	Оператор.ВыбираемыеПоля.Добавить(ШаблонОсновнойАналитикиРезерв(ВнутренееИмяТаблицы));
	ЗапросПакета.Колонки[ЗапросПакета.Колонки.Количество()-1].Псевдоним = "Номенклатура";
	
	Оператор.ВыбираемыеПоля.Добавить(ШаблонЦМОРезерв(ВнутренееИмяТаблицы));
	ЗапросПакета.Колонки[ЗапросПакета.Колонки.Количество()-1].Псевдоним = "ЦМО";
	
	Оператор.ВыбираемыеПоля.Добавить(ШаблонДопАналитикиРезерв(ВнутренееИмяТаблицы));
	ЗапросПакета.Колонки[ЗапросПакета.Колонки.Количество()-1].Псевдоним = "ДопАналитика";
	
КонецПроцедуры

Процедура ДобавитьСоединениеСВТРезервы(ЗапросПакета, Оператор, ИмяТаблицыИсточника, ИмяТаблицыВТ, ПсевдонимПоля)
	
	ТаблицаВыборкиДанных = Оператор.Источники[0];
	
	ВТ_Резерв = Оператор.Источники.Добавить(ИмяТаблицыВТ, ИмяТаблицыВТ);
	ВТ_Резерв.Соединения.Очистить();
	
	ТаблицаВыборкиДанных.Соединения.Добавить(ВТ_Резерв.Источник.Псевдоним, СтрШаблон("%1.Организация = %2.Организация", ИмяТаблицыИсточника, ИмяТаблицыВТ));
	ТаблицаВыборкиДанных.Соединения.Добавить(ВТ_Резерв.Источник.Псевдоним, СтрШаблон("%1.ИФО = %2.ИФО", ИмяТаблицыИсточника, ИмяТаблицыВТ));
	ТаблицаВыборкиДанных.Соединения.Добавить(ВТ_Резерв.Источник.Псевдоним, СтрШаблон("%1.КФО = %2.КФО", ИмяТаблицыИсточника, ИмяТаблицыВТ));
	ТаблицаВыборкиДанных.Соединения.Добавить(ВТ_Резерв.Источник.Псевдоним, СтрШаблон("%1.Счет = %2.Счет", ИмяТаблицыИсточника, ИмяТаблицыВТ));
	ТаблицаВыборкиДанных.Соединения.Добавить(ВТ_Резерв.Источник.Псевдоним,
		ШаблонОсновнойАналитикиРезерв(ИмяТаблицыИсточника) + СтрШаблон(" = %1.Номенклатура", ИмяТаблицыВТ));
	ТаблицаВыборкиДанных.Соединения.Добавить(ВТ_Резерв.Источник.Псевдоним,
		ШаблонЦМОРезерв(ИмяТаблицыИсточника) + СтрШаблон(" = %1.ЦМО", ИмяТаблицыВТ));
	ТаблицаВыборкиДанных.Соединения.Добавить(ВТ_Резерв.Источник.Псевдоним,
		ШаблонДопАналитикиРезерв(ИмяТаблицыИсточника) + СтрШаблон(" = %1.ДопАналитика", ИмяТаблицыВТ));
	
	Если ИмяТаблицыИсточника = "ВТ_АналитикиКонтроля" Тогда
		СоединениеКПС = СтрШаблон("%1.КПС = %2.КПС", ИмяТаблицыИсточника, ИмяТаблицыВТ);
		СоединениеПодразделение = СтрШаблон("%1.Подразделение = %2.Подразделение", ИмяТаблицыИсточника, ИмяТаблицыВТ);
	Иначе
		СоединениеКПС = СтрШаблон("ЕСТЬNULL(%1.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) = %2.КПС", ИмяТаблицыИсточника, ИмяТаблицыВТ);
		СоединениеПодразделение = СтрШаблон("ЕСТЬNULL(%1.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) = %2.Подразделение", ИмяТаблицыИсточника, ИмяТаблицыВТ);
	КонецЕсли;
	
	ТаблицаВыборкиДанных.Соединения.Добавить(ВТ_Резерв.Источник.Псевдоним, СоединениеКПС);
	ТаблицаВыборкиДанных.Соединения.Добавить(ВТ_Резерв.Источник.Псевдоним, СоединениеПодразделение);
		
	Если ИмяТаблицыВТ = "ВТ_ОборотыРезервыМЗ" Тогда
		ТаблицаВыборкиДанных.Соединения.Добавить(ВТ_Резерв.Источник.Псевдоним, СтрШаблон("%1.Период >= %2.Период", ИмяТаблицыИсточника, ИмяТаблицыВТ));
		Оператор.ВыбираемыеПоля.Добавить(СтрШаблон("СУММА(ЕСТЬNULL(%1.%2, 0))", ИмяТаблицыВТ, ПсевдонимПоля));
		ЗапросПакета.Колонки[ЗапросПакета.Колонки.Количество()-1].Псевдоним = ПсевдонимПоля;
	Иначе
		Оператор.ВыбираемыеПоля.Добавить(СтрШаблон("ЕСТЬNULL(%1.%2, 0)", ИмяТаблицыВТ, ПсевдонимПоля));
		ЗапросПакета.Колонки[ЗапросПакета.Колонки.Количество()-1].Псевдоним = ПсевдонимПоля;
	КонецЕсли;
		
КонецПроцедуры

Функция ШаблонЦМОРезерв(ИмяТаблицы)
	
	Если ИмяТаблицы = "ВложенныйЗапрос" Тогда
		Возврат
		"	ВЫБОР
		|		КОГДА ВложенныйЗапрос.Субконто1 ССЫЛКА Справочник.ЦМО 
		|				И ВЫРАЗИТЬ(ВложенныйЗапрос.Счет КАК ПланСчетов.ЕПСБУ).Код <> &КодСчетаВыдачиВличноеПользованиеМЗ
		|			ТОГДА ВЫРАЗИТЬ(ВложенныйЗапрос.Субконто1 КАК Справочник.ЦМО)
		|		КОГДА ВложенныйЗапрос.Субконто2 ССЫЛКА Справочник.ЦМО 
		|				И ВЫРАЗИТЬ(ВложенныйЗапрос.Счет КАК ПланСчетов.ЕПСБУ).Код <> &КодСчетаВыдачиВличноеПользованиеМЗ
		|			ТОГДА ВЫРАЗИТЬ(ВложенныйЗапрос.Субконто2 КАК Справочник.ЦМО)
		|		КОГДА ВложенныйЗапрос.Субконто3 ССЫЛКА Справочник.ЦМО 
		|				И ВЫРАЗИТЬ(ВложенныйЗапрос.Счет КАК ПланСчетов.ЕПСБУ).Код <> &КодСчетаВыдачиВличноеПользованиеМЗ
		|			ТОГДА ВЫРАЗИТЬ(ВложенныйЗапрос.Субконто3 КАК Справочник.ЦМО)
		|		КОГДА ВложенныйЗапрос.Субконто1 ССЫЛКА Справочник.Контрагенты 
		|				И ВЫРАЗИТЬ(ВложенныйЗапрос.Счет КАК ПланСчетов.ЕПСБУ).Код = &КодСчетаВыдачиВличноеПользованиеМЗ
		|			ТОГДА ВЫРАЗИТЬ(ВложенныйЗапрос.Субконто1 КАК Справочник.Контрагенты)
		|		КОГДА ВложенныйЗапрос.Субконто2 ССЫЛКА Справочник.Контрагенты 
		|				И ВЫРАЗИТЬ(ВложенныйЗапрос.Счет КАК ПланСчетов.ЕПСБУ).Код = &КодСчетаВыдачиВличноеПользованиеМЗ
		|			ТОГДА ВЫРАЗИТЬ(ВложенныйЗапрос.Субконто2 КАК Справочник.Контрагенты)
		|		КОГДА ВложенныйЗапрос.Субконто3 ССЫЛКА Справочник.Контрагенты 
		|				И ВЫРАЗИТЬ(ВложенныйЗапрос.Счет КАК ПланСчетов.ЕПСБУ).Код = &КодСчетаВыдачиВличноеПользованиеМЗ
		|			ТОГДА ВЫРАЗИТЬ(ВложенныйЗапрос.Субконто3 КАК Справочник.Контрагенты)
		|	КОНЕЦ";
	Иначе
		Возврат "ВТ_АналитикиКонтроля.ЦМО";
	КонецЕсли;
	
КонецФункции

Функция ШаблонОсновнойАналитикиРезерв(ИмяТаблицы)
	
	Если ИмяТаблицы = "ВложенныйЗапрос" Тогда
		Возврат
		"	ВЫБОР
		|		КОГДА ВложенныйЗапрос.Субконто1 ССЫЛКА Справочник.Номенклатура
		|			ТОГДА ВЫРАЗИТЬ(ВложенныйЗапрос.Субконто1 КАК Справочник.Номенклатура)
		|		КОГДА ВложенныйЗапрос.Субконто2 ССЫЛКА Справочник.Номенклатура
		|			ТОГДА ВЫРАЗИТЬ(ВложенныйЗапрос.Субконто2 КАК Справочник.Номенклатура)
		|		КОГДА ВложенныйЗапрос.Субконто3 ССЫЛКА Справочник.Номенклатура
		|			ТОГДА ВЫРАЗИТЬ(ВложенныйЗапрос.Субконто3 КАК Справочник.Номенклатура)
		|	КОНЕЦ";
	Иначе
		Возврат "ВТ_АналитикиКонтроля.Номенклатура";
	КонецЕсли;
	
КонецФункции

Функция ШаблонДопАналитикиРезерв(ИмяТаблицы)
	
	Если ИмяТаблицы = "ВложенныйЗапрос" Тогда
		Возврат
		"	ВЫБОР
		|		КОГДА НЕ ВложенныйЗапрос.Субконто1 ССЫЛКА Справочник.Номенклатура
		|				И НЕ (ВложенныйЗапрос.Субконто1 ССЫЛКА Справочник.ЦМО
		|					И ВЫРАЗИТЬ(ВложенныйЗапрос.Счет КАК ПланСчетов.ЕПСБУ).Код <> &КодСчетаВыдачиВличноеПользованиеМЗ)
		|				И НЕ (ВложенныйЗапрос.Субконто1 ССЫЛКА Справочник.Контрагенты
		|					И ВЫРАЗИТЬ(ВложенныйЗапрос.Счет КАК ПланСчетов.ЕПСБУ).Код = &КодСчетаВыдачиВличноеПользованиеМЗ)
		|			ТОГДА
		|				ВЫБОР
		|					КОГДА ВложенныйЗапрос.ВидСубконто1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Партии)
		|				ТОГДА НЕОПРЕДЕЛЕНО
		|					ИНАЧЕ ВложенныйЗапрос.Субконто1
		|				КОНЕЦ
		|		КОГДА НЕ ВложенныйЗапрос.Субконто2 ССЫЛКА Справочник.Номенклатура
		|				И НЕ (ВложенныйЗапрос.Субконто2 ССЫЛКА Справочник.ЦМО
		|					И ВЫРАЗИТЬ(ВложенныйЗапрос.Счет КАК ПланСчетов.ЕПСБУ).Код <> &КодСчетаВыдачиВличноеПользованиеМЗ)
		|				И НЕ (ВложенныйЗапрос.Субконто2 ССЫЛКА Справочник.Контрагенты
		|					И ВЫРАЗИТЬ(ВложенныйЗапрос.Счет КАК ПланСчетов.ЕПСБУ).Код = &КодСчетаВыдачиВличноеПользованиеМЗ)
		|			ТОГДА
		|				ВЫБОР
		|					КОГДА ВложенныйЗапрос.ВидСубконто2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Партии)
		|				ТОГДА НЕОПРЕДЕЛЕНО
		|					ИНАЧЕ ВложенныйЗапрос.Субконто2
		|				КОНЕЦ
		|		КОГДА НЕ ВложенныйЗапрос.Субконто3 ССЫЛКА Справочник.Номенклатура
		|				И НЕ (ВложенныйЗапрос.Субконто3 ССЫЛКА Справочник.ЦМО
		|					И ВЫРАЗИТЬ(ВложенныйЗапрос.Счет КАК ПланСчетов.ЕПСБУ).Код <> &КодСчетаВыдачиВличноеПользованиеМЗ)
		|				И НЕ (ВложенныйЗапрос.Субконто3 ССЫЛКА Справочник.Контрагенты
		|					И ВЫРАЗИТЬ(ВложенныйЗапрос.Счет КАК ПланСчетов.ЕПСБУ).Код = &КодСчетаВыдачиВличноеПользованиеМЗ)
		|			ТОГДА
		|				ВЫБОР
		|					КОГДА ВложенныйЗапрос.ВидСубконто3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Партии)
		|				ТОГДА НЕОПРЕДЕЛЕНО
		|					ИНАЧЕ ВложенныйЗапрос.Субконто3
		|				КОНЕЦ
		|	КОНЕЦ";
	Иначе
		Возврат "ВТ_АналитикиКонтроля.ДопАналитика";
	КонецЕсли;
	
КонецФункции

Функция ТекстЗапросаВТ_НачальныеОстаткиРезервМЗ()
	
	Возврат "ВЫБРАТЬ
	|	РезервМЗОстатки.Организация КАК Организация,
	|	РезервМЗОстатки.ИФО КАК ИФО,
	|	РезервМЗОстатки.КФО КАК КФО,
	|	РезервМЗОстатки.СчетУчета КАК Счет,
	|	РезервМЗОстатки.Номенклатура КАК Номенклатура,
	|	РезервМЗОстатки.ЦМО КАК ЦМО,
	|	ВЫБОР
	|		КОГДА ВТ_АналитикиКонтроля.ДопАналитика = НЕОПРЕДЕЛЕНО
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ РезервМЗОстатки.ДопАналитика
	|	КОНЕЦ КАК ДопАналитика,
	|	РезервМЗОстатки.КПС КАК КПС,
	|	РезервМЗОстатки.Подразделение КАК Подразделение,
	|	СУММА(РезервМЗОстатки.КоличествоОстаток) КАК НачальныйОстатокРезервМЗ
	|ПОМЕСТИТЬ ВТ_НачальныеОстаткиРезервМЗ
	|ИЗ
	|	РегистрНакопления.РезервМЗ.Остатки(
	|			&ГраницаОстатков,
	|			(Организация, ИФО, КФО, СчетУчета, Номенклатура, ЦМО, КПС, Подразделение) В
	|				(ВЫБРАТЬ
	|					ВТ_АналитикиКонтроля.Организация,
	|					ВТ_АналитикиКонтроля.ИФО,
	|					ВТ_АналитикиКонтроля.КФО,
	|					ВТ_АналитикиКонтроля.Счет,
	|					ВТ_АналитикиКонтроля.Номенклатура,
	|					ВТ_АналитикиКонтроля.ЦМО,
	|					ВТ_АналитикиКонтроля.КПС,
	|					ВТ_АналитикиКонтроля.Подразделение
	|				ИЗ
	|					ВТ_АналитикиКонтроля)) КАК РезервМЗОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_АналитикиКонтроля КАК ВТ_АналитикиКонтроля
	|		ПО РезервМЗОстатки.Организация = ВТ_АналитикиКонтроля.Организация
	|			И РезервМЗОстатки.ИФО = ВТ_АналитикиКонтроля.ИФО
	|			И РезервМЗОстатки.КФО = ВТ_АналитикиКонтроля.КФО
	|			И РезервМЗОстатки.СчетУчета = ВТ_АналитикиКонтроля.Счет
	|			И (ВЫБОР
	|				КОГДА ВТ_АналитикиКонтроля.ДопАналитика = НЕОПРЕДЕЛЕНО
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ РезервМЗОстатки.ДопАналитика = ВТ_АналитикиКонтроля.ДопАналитика
	|			КОНЕЦ)
	|			И РезервМЗОстатки.Номенклатура = ВТ_АналитикиКонтроля.Номенклатура
	|			И РезервМЗОстатки.ЦМО = ВТ_АналитикиКонтроля.ЦМО
	|			И РезервМЗОстатки.КПС = ВТ_АналитикиКонтроля.КПС
	|			И РезервМЗОстатки.Подразделение = ВТ_АналитикиКонтроля.Подразделение
	|
	|СГРУППИРОВАТЬ ПО
	|	РезервМЗОстатки.Организация,
	|	РезервМЗОстатки.ИФО,
	|	РезервМЗОстатки.КФО,
	|	РезервМЗОстатки.СчетУчета,
	|	РезервМЗОстатки.Номенклатура,
	|	РезервМЗОстатки.ЦМО,
	|	ВЫБОР
	|		КОГДА ВТ_АналитикиКонтроля.ДопАналитика = НЕОПРЕДЕЛЕНО
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ РезервМЗОстатки.ДопАналитика
	|	КОНЕЦ,
	|	РезервМЗОстатки.КПС,
	|	РезервМЗОстатки.Подразделение";

КонецФункции

Функция ТекстЗапросаВТ_ТекущиеОстаткиРезервМЗ()
	
	Возврат "ВЫБРАТЬ
	|	РезервМЗОстатки.Организация КАК Организация,
	|	РезервМЗОстатки.ИФО КАК ИФО,
	|	РезервМЗОстатки.КФО КАК КФО,
	|	РезервМЗОстатки.СчетУчета КАК Счет,
