#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи)
	
	ПустойКПС			= Неопределено;
	ПустойКЭК			= Неопределено;
	ПустоеПодразделение	= NULL;
	ПустаяВалюта		= NULL;
	
	//  Исключение из стандарта 773
	// Измерения, привязанные к признаку учета должны содержать NULL,
	// если признак учета отключен. Однако, при выгрузке набора в таблицу значений
	// и загрузке набора из таблицы значение NULL преобразуется в пустое значение типа.
	// 
	Для Каждого ТекЗапись Из ЭтотОбъект Цикл
		УстановитьЗначенияПоУмолчанию(ТекЗапись);
	КонецЦикла;
	//  Исключение из стандарта 773

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("ОтключитьПроверку") Тогда
		Возврат;
	КонецЕсли;
	
	ДатыЗапретаИзменения.ПроверитьДатуЗапретаИзмененияПередЗаписьюНабораЗаписейРегистраБухгалтерии(ЭтотОбъект, Отказ, РежимЗаписи);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ГодНачалаВеденияУчета = БухгалтерскийУчетПовтИсп.ПолучитьГодНачалаВеденияУчетаВИнформационнойБазе();
	МинимальнаяДатаПроводки = Дата(ГодНачалаВеденияУчета, 1, 1);
	ГодНачалаВеденияУчета = Формат(ГодНачалаВеденияУчета, "ЧГ=0");
	
	ЕстьПравоИзмененияРабочихСчетов = Ложь;
	Если НЕ ЭтотОбъект.ДополнительныеСвойства.Свойство("ЕстьПравоИзмененияРабочихСчетов", ЕстьПравоИзмененияРабочихСчетов) Тогда
		ЕстьПравоИзмененияРабочихСчетов = ПравоДоступа("Изменение", Метаданные.РегистрыСведений.РабочиеСчета);
	КонецЕсли;
	
	ОтборРегистратор = ЭтотОбъект.Отбор.Найти("Регистратор");
	Если ОтборРегистратор <> Неопределено И ЗначениеЗаполнено(ОтборРегистратор.Значение) Тогда
		ДокументСсылка      = ОтборРегистратор.Значение;
		МетаданныеДокумента = ДокументСсылка.Метаданные();
		
	Иначе
		ДокументСсылка      = Неопределено;
		МетаданныеДокумента = Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ЗакрытиеГодаТехнологическое") Тогда
		РегистрыСведений.ОперацииДокументов.ЗаписатьДанныеОперации(ДокументСсылка,
			РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СуммаПроводокПоНастройкамПоУмолчанию(ЭтотОбъект),
			ЭтотОбъект.Количество() > 0);
		Возврат;
	КонецЕсли;
	
	НаборПроверен = Ложь;
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("НаборПроверен") Тогда
		НаборПроверен = ЭтотОбъект.ДополнительныеСвойства.НаборПроверен;
	КонецЕсли;
	
	ЭтоРучнаяОперация = ( ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ОперацияБух")
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.КорректировкаРегистров") );
	
	НеПроверятьЗаполнениеОборотныхСубконто =
		(ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПереносОстатковПоКПС")
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ЗакрытиеСчетовНалоговогоУчета")
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ЗакрытиеГода"));
	
	ЭтоПереносОстатков64н2018 =
		(   ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПереносОстатков64нНФА")
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПереносОстатков64нРасчеты") );
		
	ЭтоЗакрытие1718 = ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ЗакрытиеЗабалансовыхСчетовПоступленийИВыбытийДенежныхСредств");
	
	ЭтоЗагытиеГодаПриИзмененииТипа = Ложь;
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ЗакрытиеГода") 
		И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "ИзменениеТипаУчреждения") Тогда
		
		ЭтоЗагытиеГодаПриИзмененииТипа = Истина;
	КонецЕсли;
	
	ИспользоватьУчетПоИФО 				= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ИспользоватьУчетПоПодразделениям 	= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	ИспользоватьВалютныйУчет			= ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	ВалютаРегламентированногоУчета		= БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета();
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.Сторно")
		Или ЭтоПереносОстатков64н2018 Тогда
		ПроверятьИФО = Ложь;
	Иначе
		ПроверятьИФО = ИспользоватьУчетПоИФО;
	КонецЕсли;
	
	ТаблицаОшибок = Новый ТаблицаЗначений;
	ТаблицаОшибок.Колонки.Добавить("НомерПроводки");
	ТаблицаОшибок.Колонки.Добавить("ТекстОшибки");
	ТаблицаОшибок.Колонки.Добавить("ПолеОшибки");
	
	// Не выполняется проверка, если это перенос КПС, т.к. половина проводок будет с КПС по старой учетной политике (со старым КПС),
	//а вторая половина - по новой, с новым КПС. На одну и ту же дату.
	КонтролироватьОперацииНаСоответствиеРПС = Константы.КонтролироватьОперацииНаСоответствиеРПС.Получить() И НЕ НеПроверятьЗаполнениеОборотныхСубконто И НЕ ЭтоЗакрытие1718;
	
	Если КонтролироватьОперацииНаСоответствиеРПС Тогда
		ТаблицаРПС = Новый ТаблицаЗначений;
		ТаблицаРПС.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
		ТаблицаРПС.Колонки.Добавить("ИФО", Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
		ТаблицаРПС.Колонки.Добавить("КФО", Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
		ТаблицаРПС.Колонки.Добавить("Счет", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
		ТаблицаРПС.Колонки.Добавить("КПС", Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	КонецЕсли;
	
	// При отражении выпуска продукции субконто "Виды затрат" по кредиту счетов 109.60, Н20.01 не заполняется.
	ВидСубконтоВидыЗатрат = ПланыВидовХарактеристик.ВидыСубконто.ВидыЗатрат;
	Если ЭтотОбъект.Количество() > 0 Тогда
		// Для целей определения счетов 109.хх считаем, что все записи набора делаются одной датой.
		ДатаНабора        = ЭтотОбъект[0].Период;
		ОрганизацияНабора = ЭтотОбъект[0].Организация;
	Иначе
		ДатаНабора        = Неопределено;
		ОрганизацияНабора = Неопределено;
	КонецЕсли;
	Счет10960 = БухгалтерскийУчет.СчетПоКоду("109.60", ДатаНабора, ОрганизацияНабора);
	Если БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Счет10960).ЭлементГруппа Тогда
		Счет10961 = БухгалтерскийУчет.СчетПоКоду("109.61", ДатаНабора, ОрганизацияНабора);
	Иначе
		Счет10961 = Счет10960;
	КонецЕсли;
	
	СчетН2001 = БухгалтерскийУчет.СчетПоКоду("Н20.01", ДатаНабора, ОрганизацияНабора);
	
	Счет40130 = БухгалтерскийУчет.СчетПоКоду("401.30", ДатаНабора, ОрганизацияНабора);
	                                       
	СчетаБезКОСГУ = Новый Массив;
	СчетаБезКОСГУ.Добавить(Счет10961);
	
	ТипЧисло = Новый ОписаниеТипов("Число");
	
	// массив для проверки использованных в проводках счетов, что это не счет-группа
	МассивИспользованныхСчетов = Новый Массив;
	
	РегистрыСведений.СоответствиеСчетовОС.СкорректироватьСчета(ЭтотОбъект);
	
	Если НЕ НаборПроверен И ЭтотОбъект.Количество()>0 Тогда
		
		ДопЗначение = Неопределено;
		ДополнительныеСвойства.Свойство("КонтролироватьПериодСчета", ДопЗначение);
		КонтролироватьПериодСчета = (ДопЗначение <> Ложь);
		
		ТекНомерСтроки = -1;
		
		Для Каждого ТекЗапись Из ЭтотОбъект Цикл
			
			ТекЗапись.Содержание = СокрП(ТекЗапись.Содержание);
			
			ТекНомерСтроки = ТекНомерСтроки + 1;
			
			Если ТекЗапись.Период < МинимальнаяДатаПроводки Тогда
				ДобавитьОшибкуВТаблицу(ТаблицаОшибок.Добавить(), ТекНомерСтроки, "КФО",
					СтрЗаменить(НСтр("ru='Проводка %1. Год даты проводки раньше начала ведения учета в программе (%ГодНачалаВеденияУчета%)'"),
						"%ГодНачалаВеденияУчета%", ГодНачалаВеденияУчета));
			КонецЕсли;
			
			ТекЗаписьСчетДт = ТекЗапись.СчетДт;
			Если ЗначениеЗаполнено(ТекЗаписьСчетДт) И МассивИспользованныхСчетов.Найти(ТекЗаписьСчетДт) = Неопределено Тогда
				МассивИспользованныхСчетов.Добавить(ТекЗаписьСчетДт);
			КонецЕсли;
			ТекЗаписьСчетКт = ТекЗапись.СчетКт;
			Если ЗначениеЗаполнено(ТекЗаписьСчетКт) И МассивИспользованныхСчетов.Найти(ТекЗаписьСчетКт) = Неопределено Тогда
				МассивИспользованныхСчетов.Добавить(ТекЗаписьСчетКт);
			КонецЕсли;
			
			СвойстваСчетаДт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ТекЗаписьСчетДт);
			СвойстваСчетаКт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ТекЗаписьСчетКт);
			ЗначениеЗаполненоСчетДт = ЗначениеЗаполнено(ТекЗаписьСчетДт);
			ЗначениеЗаполненоСчетКт = ЗначениеЗаполнено(ТекЗаписьСчетКт);
			
			Если Не ЗначениеЗаполненоСчетДт И Не ЗначениеЗаполненоСчетКт Тогда
				ДобавитьОшибкуВТаблицу(ТаблицаОшибок.Добавить(), ТекНомерСтроки, "СчетДт",
										НСтр("ru='Проводка %1. Не заполнены оба счета'"));
			ИначеЕсли ЗначениеЗаполненоСчетДт И Не ЗначениеЗаполненоСчетКт
					И НЕ СвойстваСчетаДт.Забалансовый Тогда
				ДобавитьОшибкуВТаблицу(ТаблицаОшибок.Добавить(), ТекНомерСтроки, "СчетКт",
										НСтр("ru='Проводка %1. Не заполнен счет кредита'"));
			ИначеЕсли ЗначениеЗаполненоСчетКт И Не ЗначениеЗаполненоСчетДт
					И НЕ СвойстваСчетаКт.Забалансовый Тогда
				ДобавитьОшибкуВТаблицу(ТаблицаОшибок.Добавить(), ТекНомерСтроки, "СчетДт",
										НСтр("ru='Проводка %1. Не заполнен счет дебета'"));
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ТекЗапись.Период) Тогда
				ДобавитьОшибкуВТаблицу(ТаблицаОшибок.Добавить(), ТекНомерСтроки, "Период",
										НСтр("ru='Проводка %1. Не заполнен период'"));
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(ТекЗапись.Организация) Тогда
				ДобавитьОшибкуВТаблицу(ТаблицаОшибок.Добавить(), ТекНомерСтроки, "Организация",
										НСтр("ru='Проводка %1. Не заполнена организация'"));
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(ТекЗапись.КФО) Тогда
				ДобавитьОшибкуВТаблицу(ТаблицаОшибок.Добавить(), ТекНомерСтроки, "КФО",
										НСтр("ru='Проводка %1. Не заполнен КФО'"));
			КонецЕсли;
			Если ПроверятьИФО Тогда
				Если НЕ ЗначениеЗаполнено(ТекЗапись.ИФО) Тогда
					ДобавитьОшибкуВТаблицу(ТаблицаОшибок.Добавить(), ТекНомерСтроки, "ИФО",
											НСтр("ru='Проводка %1. Не заполнен ИФО'"));
				КонецЕсли;
			КонецЕсли;
			
			// Определяем дату перехода на новый ПС. До даты перехода допустимы
			// проводки по устаревшим счетам
			
			Если КонтролироватьПериодСчета Тогда
				ДатаПерехода = БухгалтерскийУчет.ДатаПереходаНаРедакциюПС(ТекЗапись.Организация, ТекЗапись.Период);
				Если Не ЗначениеЗаполнено(ДатаПерехода) Тогда
					// если на новый ПС не переходили - используем только старые счета
					ДатаПерехода = КонецГода(ТекЗапись.Период);
				КонецЕсли;
			Иначе
				ДатаПерехода = '00010101';
			КонецЕсли;
			
			Если ЗначениеЗаполненоСчетДт Тогда
				
				// В проводках по корректировке аналитики НУ не будем контролировать
				// заполнение КПС, Подразделений и обязательных субконто по дебету.
				ЭтоКорректировкаАналитикиНУ = ЭтоРучнаяОперация
					И НЕ ЗначениеЗаполненоСчетКт
					И БухгалтерскийУчет.СчетВИерархии(ТекЗаписьСчетДт, "Н10,Н41.01,Н43");
				
				// Контроль периода действия счета Дт.
				Если КонтролироватьПериодСчета И ЗначениеЗаполнено(СвойстваСчетаДт.ДатаНачалаДействия)
					И ТекЗапись.Период < НачалоДня(Макс(СвойстваСчетаДт.ДатаНачалаДействия, ДатаПерехода) - 24*60*60) // 1 день для переноса остатков.
				Или КонтролироватьПериодСчета И ЗначениеЗаполнено(СвойстваСчетаДт.ДатаОкончанияДействия)
					И ТекЗапись.Период > Макс(СвойстваСчетаДт.ДатаОкончанияДействия, ДатаПерехода) Тогда
					
					ДобавитьОшибкуВТаблицу(ТаблицаОшибок.Добавить(), ТекНомерСтроки, "СчетДт",
						СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
							НСтр("ru='Проводка %1. Период действия счета Дт %2 (%3 - %4) не соответствует дате проводки %5.'"),
								ТекНомерСтроки + 1,
								СвойстваСчетаДт.Код,
								Формат(СвойстваСчетаДт.ДатаНачалаДействия, "ДЛФ=Д; ДП='<не ограничено>'"),
								Формат(СвойстваСчетаДт.ДатаОкончанияДействия, "ДЛФ=Д; ДП='<не ограничено>'"),
								Формат(ТекЗапись.Период, "ДЛФ=Д")));
				КонецЕсли;
				
				Если СвойстваСчетаДт.УчетПоКПС Тогда
					Если НЕ ЗначениеЗаполнено(ТекЗапись.КПСДт)
						И НЕ ЭтоКорректировкаАналитикиНУ Тогда
						ДобавитьОшибкуВТаблицу(ТаблицаОшибок.Добавить(), ТекНомерСтроки, "КПСДт",
												НСтр("ru='Проводка %1. Не заполнен КПС дебета'"));
					КонецЕсли;
				Иначе
					Если ЗначениеЗаполнено(ТекЗапись.КПСДт) Тогда
						ТекЗапись.КПСДт = ПустойКПС;
					КонецЕсли;
				КонецЕсли;
				Если СвойстваСчетаДт.УчетПоКЭК Тогда
					Если НЕ ЗначениеЗаполнено(ТекЗапись.КЭКДт) Тогда
						ДобавитьОшибкуВТаблицу(ТаблицаОшибок.Добавить(), ТекНомерСтроки, "КЭКДт",
												НСтр("ru='Проводка %1. Не заполнен КЭК дебета'"));
					КонецЕсли;
				Иначе
					Если ЗначениеЗаполнено(ТекЗапись.КЭКДт) Тогда
						ТекЗапись.КЭКДт = ПустойКЭК;
					КонецЕсли;
				КонецЕсли;
				Если ИспользоватьУчетПоПодразделениям И СвойстваСчетаДт.УчетПоПодразделениям Тогда
					Если НЕ ЗначениеЗаполнено(ТекЗапись.ПодразделениеДт)
						И НЕ СвойстваСчетаДт.РазрешитьНеУказыватьПодразделение
						И НЕ ЭтоКорректировкаАналитикиНУ
						И НЕ ЭтоПереносОстатков64н2018 Тогда
						ДобавитьОшибкуВТаблицу(ТаблицаОшибок.Добавить(), ТекНомерСтроки, "ПодразделениеДт",
												НСтр("ru='Проводка %1. Не заполнено Подразделение дебета'"));
					КонецЕсли;
				Иначе
					Если ЗначениеЗаполнено(ТекЗапись.ПодразделениеДт) Тогда
						ТекЗапись.ПодразделениеДт = ПустоеПодразделение;
					КонецЕсли;
				КонецЕсли;
				Если СвойстваСчетаДт.Валютный Тогда
					// Если валютный учет не ведется, заполняем Валюту и валютную сумму значениями по умолчанию.
					// При включении функциональной опции ИспользоватьВалютныйУчет в регистре бухгалтерии будут правильные данные.
					Если НЕ ЗначениеЗаполнено(ТекЗапись.ВалютаДт) Тогда
						Если НЕ ИспользоватьВалютныйУчет Тогда
							ТекЗапись.ВалютаДт = ВалютаРегламентированногоУчета;
						ИначеЕсли БухгалтерскийУчет.СчетВИерархии(ТекЗаписьСчетДт, "АП") Тогда
							// По счету АП "Авансы полученные" валюта и валютная сумма должны быть заполнены всегда.
							ДобавитьОшибкуВТаблицу(ТаблицаОшибок.Добавить(), ТекНомерСтроки, "ВалютаДт",
								НСтр("ru='Проводка %1. Не заполнена Валюта дебета'"));
						КонецЕсли;
					КонецЕсли;
					СуммаПроводки = ТекЗапись.Сумма
						+ ТипЧисло.ПривестиЗначение(ТекЗапись.СуммаНеУчитываетсяНУ)
						+ ТипЧисло.ПривестиЗначение(ТекЗапись.СуммаЕНВД)
						+ ТипЧисло.ПривестиЗначение(ТекЗапись.СуммаНДС);
					Если НЕ ИспользоватьВалютныйУчет Тогда
						// Валютная сумма всегда равна рублевой.
						ТекЗапись.ВалютнаяСуммаДт = СуммаПроводки;
					ИначеЕсли ТекЗапись.ВалютнаяСуммаДт = 0 И СуммаПроводки <> 0 Тогда
						Если БухгалтерскийУчет.СчетВИерархии(ТекЗаписьСчетДт, "АП") Тогда
							// По счету АП "Авансы полученные" валюта и валютная сумма должны быть заполнены всегда.
							ДобавитьОшибкуВТаблицу(ТаблицаОшибок.Добавить(), ТекНомерСтроки, "ВалютнаяСуммаДт",
								НСтр("ru='Проводка %1. Не заполнена Валютная сумма дебета'"));
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
				// Проверяем заполнение субконто Дт.
				КоличествоСубконтоДт = СвойстваСчетаДт.КоличествоСубконто;
				Для Счетчик = 1 по КоличествоСубконтоДт Цикл
					
					ТекВидСубконто = СвойстваСчетаДт["ВидСубконто" + Счетчик];
					Если ЗначениеЗаполнено(ТекВидСубконто) Тогда
						Если Не ЗначениеЗаполнено(ТекЗапись.СубконтоДт[ТекВидСубконто])
							И ТекЗапись.СубконтоДт[ТекВидСубконто] <> Неопределено
							И СвойстваСчетаДт["ВидСубконто" + Счетчик + "ТипЗначения"].Типы().Количество() > 1 Тогда
							// пустое значение вида субконто составного типа должно быть "Неопределено"
							
							ТекЗапись.СубконтоДт[ТекВидСубконто] = Неопределено;
						Иначе
							// Приведение типа
							ТекЗапись.СубконтоДт[ТекВидСубконто] = СвойстваСчетаДт["ВидСубконто" + Счетчик + "ТипЗначения"]
								.ПривестиЗначение(ТекЗапись.СубконтоДт[ТекВидСубконто]);
						КонецЕсли;
					КонецЕсли;
					
					Если НеПроверятьЗаполнениеОборотныхСубконто И СвойстваСчетаДт["ВидСубконто" + Счетчик + "ТолькоОбороты"] Тогда
						Продолжить;
					КонецЕсли;
					
					// Для ввода остатков отключаем обязательность указания ЦМО по дебету счетов 105.00
					Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ВводНачальныхОстатков")
						И Лев(СвойстваСчетаДт["Код"], 3) = "105"
						И СвойстваСчетаДт["ВидСубконто" + Счетчик + "Наименование"] = "ЦМО"
						И СвойстваСчетаДт["ВидСубконто" + Счетчик + "Обязательный"]
						И НЕ ЗначениеЗаполнено(ТекЗапись.СубконтоДт[ТекВидСубконто]) Тогда
						
						Продолжить;
					КонецЕсли;
					
					Если СвойстваСчетаДт["ВидСубконто" + Счетчик + "Обязательный"]
					И НЕ ЗначениеЗаполнено(ТекЗапись.СубконтоДт[ТекВидСубконто])
					И НЕ ЭтоКорректировкаАналитикиНУ
					И НЕ ЭтоПереносОстатков64н2018 Тогда
						
						Если СвойстваСчетаДт["ВидСубконто"+Счетчик+"Суммовой"]
						ИЛИ (СвойстваСчетаДт["ВидСубконто"+Счетчик+"Количественный"] И ЗначениеЗаполнено(ТекЗапись.КоличествоДт)) Тогда
							ДобавитьОшибкуВТаблицу(ТаблицаОшибок.Добавить(), ТекНомерСтроки, "СубконтоДт"+Счетчик,
								НСтр("ru='Проводка %1. Не заполнено субконто дебета "+ТекВидСубконто.Наименование+"'"));
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЦикла;
				
				Если КонтролироватьОперацииНаСоответствиеРПС И ТекЗаписьСчетДт.УчетПоКПС
					И ТекЗаписьСчетДт.ТипСчета <> Перечисления.ТипыСчетов.Налоговый 
					И Не (ЭтоЗагытиеГодаПриИзмененииТипа И ТекЗаписьСчетДт = Счет40130) Тогда
					НовСтрока = ТаблицаРПС.Добавить();
					НовСтрока.Организация	= ТекЗапись.Организация;
					НовСтрока.ИФО			= ТекЗапись.ИФО;
					НовСтрока.КФО			= ТекЗапись.КФО;
					НовСтрока.Счет			= ТекЗапись.СчетДт;
					НовСтрока.КПС			= ТекЗапись.КПСДт;
				КонецЕсли;
				
			Иначе // Проводка по забалансовым счетам без СчетаДт - очищаем связанные реквизиты.
				ТекЗапись.КПСДт = Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка();
				ТекЗапись.КЭКДт = Справочники.КОСГУ.ПустаяСсылка();
				ТекЗапись.ПодразделениеДт = Справочники.Подразделения.ПустаяСсылка();
				ТекЗапись.ВалютаДт = Справочники.Валюты.ПустаяСсылка();
			КонецЕсли;
			
			Если ЗначениеЗаполненоСчетКт Тогда
				
				// Контроль периода действия счета Кт.
				Если КонтролироватьПериодСчета И ЗначениеЗаполнено(СвойстваСчетаКт.ДатаНачалаДействия)
					И ТекЗапись.Период < НачалоДня(Макс(СвойстваСчетаКт.ДатаНачалаДействия, ДатаПерехода) - 24*60*60) // 1 день для переноса остатков.
				Или КонтролироватьПериодСчета И ЗначениеЗаполнено(СвойстваСчетаКт.ДатаОкончанияДействия)
					И ТекЗапись.Период > Макс(СвойстваСчетаКт.ДатаОкончанияДействия, ДатаПерехода) Тогда
					ДобавитьОшибкуВТаблицу(ТаблицаОшибок.Добавить(), ТекНомерСтроки, "СчетКт",
						СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
							НСтр("ru='Проводка %1. Период действия счета Кт %2 (%3 - %4) не соответствует дате проводки %5.'"),
								ТекНомерСтроки + 1,
								СвойстваСчетаКт.Код,
								Формат(СвойстваСчетаКт.ДатаНачалаДействия, "ДЛФ=Д; ДП='<не ограничено>'"),
								Формат(СвойстваСчетаКт.ДатаОкончанияДействия, "ДЛФ=Д; ДП='<не ограничено>'"),
								Формат(ТекЗапись.Период, "ДЛФ=Д")));
				КонецЕсли;
				
				Если СвойстваСчетаКт.УчетПоКПС Тогда
					Если НЕ ЗначениеЗаполнено(ТекЗапись.КПСКт) Тогда
						ДобавитьОшибкуВТаблицу(ТаблицаОшибок.Добавить(), ТекНомерСтроки, "КПСКт",
												НСтр("ru='Проводка %1. Не заполнен КПС кредита'"));
					КонецЕсли;
				Иначе
					Если ЗначениеЗаполнено(ТекЗапись.КПСКт) Тогда
						ТекЗапись.КПСКт = ПустойКПС;
					КонецЕсли;
				КонецЕсли;
				Если СвойстваСчетаКт.УчетПоКЭК Тогда
					Если НЕ ЗначениеЗаполнено(ТекЗапись.КЭККт)
						И СчетаБезКОСГУ.Найти(ТекЗаписьСчетКт) = Неопределено Тогда
						ДобавитьОшибкуВТаблицу(ТаблицаОшибок.Добавить(), ТекНомерСтроки, "КЭККт",
												НСтр("ru='Проводка %1. Не заполнен КЭК кредита'"));
					КонецЕсли;
				Иначе	
					Если ЗначениеЗаполнено(ТекЗапись.КЭККт) Тогда
						ТекЗапись.КЭККт = ПустойКЭК;
					КонецЕсли;
				КонецЕсли;
				Если ИспользоватьУчетПоПодразделениям И СвойстваСчетаКт.УчетПоПодразделениям Тогда
					Если НЕ ЗначениеЗаполнено(ТекЗапись.ПодразделениеКт)
						И НЕ СвойстваСчетаКт.РазрешитьНеУказыватьПодразделение
						И НЕ ЭтоПереносОстатков64н2018 Тогда
						ДобавитьОшибкуВТаблицу(ТаблицаОшибок.Добавить(), ТекНомерСтроки, "ПодразделениеКт",
												НСтр("ru='Проводка %1. Не заполнено Подразделение кредита'"));
					КонецЕсли;
				Иначе
					Если ЗначениеЗаполнено(ТекЗапись.ПодразделениеКт) Тогда
						ТекЗапись.ПодразделениеКт = ПустоеПодразделение;
					КонецЕсли;
				КонецЕсли;
				Если СвойстваСчетаКт.Валютный Тогда
					// Если валютный учет не ведется, заполняем Валюту и валютную сумму значениями по умолчанию.
					// При включении функциональной опции ИспользоватьВалютныйУчет в регистре бухгалтерии будут правильные данные.
					Если НЕ ЗначениеЗаполнено(ТекЗапись.ВалютаКт) Тогда
						Если НЕ ИспользоватьВалютныйУчет Тогда
							ТекЗапись.ВалютаКт = ВалютаРегламентированногоУчета;
						ИначеЕсли БухгалтерскийУчет.СчетВИерархии(ТекЗаписьСчетКт, "АП") Тогда
							// По счету АП "Авансы полученные" валюта и валютная сумма должны быть заполнены всегда.
							ДобавитьОшибкуВТаблицу(ТаблицаОшибок.Добавить(), ТекНомерСтроки, "ВалютаКт",
								НСтр("ru='Проводка %1. Не заполнена Валюта кредита'"));
						КонецЕсли;
					КонецЕсли;
					СуммаПроводки = ТекЗапись.Сумма
						+ ТипЧисло.ПривестиЗначение(ТекЗапись.СуммаНеУчитываетсяНУ)
						+ ТипЧисло.ПривестиЗначение(ТекЗапись.СуммаЕНВД)
						+ ТипЧисло.ПривестиЗначение(ТекЗапись.СуммаНДС);
					Если НЕ ИспользоватьВалютныйУчет Тогда
						// Валютная сумма всегда равна рублевой.
						ТекЗапись.ВалютнаяСуммаКт = СуммаПроводки;
					ИначеЕсли ТекЗапись.ВалютнаяСуммаКт = 0 И СуммаПроводки <> 0 Тогда
						Если БухгалтерскийУчет.СчетВИерархии(ТекЗаписьСчетКт, "АП") Тогда
							// По счету АП "Авансы полученные" валюта и валютная сумма должны быть заполнены всегда.
							ДобавитьОшибкуВТаблицу(ТаблицаОшибок.Добавить(), ТекНомерСтроки, "ВалютнаяСуммаКт",
								НСтр("ru='Проводка %1. Не заполнена Валютная сумма кредита'"));
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
				// Проверяем заполнение субконто Кт.
				КоличествоСубконтоКт = СвойстваСчетаКт.КоличествоСубконто;
				Для Счетчик = 1 по КоличествоСубконтоКт Цикл
					
					ТекВидСубконто = СвойстваСчетаКт["ВидСубконто" + Счетчик];
					Если ЗначениеЗаполнено(ТекВидСубконто) Тогда
						Если Не ЗначениеЗаполнено(ТекЗапись.СубконтоКт[ТекВидСубконто])
							И ТекЗапись.СубконтоКт[ТекВидСубконто] <> Неопределено
							И СвойстваСчетаКт["ВидСубконто" + Счетчик + "ТипЗначения"].Типы().Количество() > 1 Тогда
							// пустое значение вида субконто составного типа должно быть "Неопределено"
							
							ТекЗапись.СубконтоКт[ТекВидСубконто] = Неопределено;
						Иначе
							// Приведение типа
							ТекЗапись.СубконтоКт[ТекВидСубконто] = СвойстваСчетаКт["ВидСубконто" + Счетчик + "ТипЗначения"]
								.ПривестиЗначение(ТекЗапись.СубконтоКт[ТекВидСубконто]);
						КонецЕсли;
					КонецЕсли;
					
					Если НеПроверятьЗаполнениеОборотныхСубконто И СвойстваСчетаКт["ВидСубконто" + Счетчик + "ТолькоОбороты"] Тогда
						Продолжить;
					КонецЕсли;
					
					Если СвойстваСчетаКт["ВидСубконто" + Счетчик + "Обязательный"]
						И Не ЗначениеЗаполнено(ТекЗапись.СубконтоКт[ТекВидСубконто])
						И Не ЭтоПереносОстатков64н2018 Тогда
						
						// При выпуске продукции Дт 105 - Кт 109.60 не проверяем заполнение обязательного субконто "Виды затрат".
						// При расчете себестоимости эти проводки будут сторнированы и заменены проводками с указанием видов затрат.
						Если ТекВидСубконто = ВидСубконтоВидыЗатрат
						   И (ТекЗаписьСчетКт = Счет10961 ИЛИ ТекЗаписьСчетКт = СчетН2001) Тогда
							Продолжить;
						КонецЕсли;
						
						Если СвойстваСчетаКт["ВидСубконто"+Счетчик+"Суммовой"]
						ИЛИ (СвойстваСчетаКт["ВидСубконто"+Счетчик+"Количественный"] И ЗначениеЗаполнено(ТекЗапись.КоличествоКт)) Тогда
							ДобавитьОшибкуВТаблицу(ТаблицаОшибок.Добавить(), ТекНомерСтроки, "СубконтоКт"+Счетчик,
								НСтр("ru='Проводка %1. Не заполнено субконто кредита "+ТекВидСубконто.Наименование+"'"));
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЦикла;
				
				Если КонтролироватьОперацииНаСоответствиеРПС И ТекЗаписьСчетКт.УчетПоКПС
					И ТекЗаписьСчетКт.ТипСчета <> Перечисления.ТипыСчетов.Налоговый
					И Не (ЭтоЗагытиеГодаПриИзмененииТипа И ТекЗаписьСчетКт = Счет40130)Тогда
					НовСтрока = ТаблицаРПС.Добавить();
					НовСтрока.Организация	= ТекЗапись.Организация;
					НовСтрока.ИФО			= ТекЗапись.ИФО;
					НовСтрока.КФО			= ТекЗапись.КФО;
					НовСтрока.Счет			= ТекЗаписьСчетКт;
					НовСтрока.КПС			= ТекЗапись.КПСКт;
				КонецЕсли;
				
			Иначе // Проводка по забалансовым счетам без СчетаКт - очищаем связанные реквизиты.
				ТекЗапись.КПСКт = Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка();
				ТекЗапись.КЭККт = Справочники.КОСГУ.ПустаяСсылка();
				ТекЗапись.ПодразделениеКт = Справочники.Подразделения.ПустаяСсылка();
				ТекЗапись.ВалютаКт = Справочники.Валюты.ПустаяСсылка();
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	РегистрыСведений.ОперацииДокументов.ЗаписатьДанныеОперации(ДокументСсылка,
		РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СуммаПроводокПоНастройкамПоУмолчанию(ЭтотОбъект),
		ЭтотОбъект.Количество() > 0);
	
	// проверка использования счетов-групп
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка,
	|	ЕПСБУ.Представление КАК Представление
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Ссылка В(&МассивСчетов)
	|	И ЕПСБУ.ЭлементГруппа = ИСТИНА";
	
	Запрос.УстановитьПараметр("МассивСчетов", МассивИспользованныхСчетов);
	СчетаГруппы = Запрос.Выполнить().Выгрузить();
	Если СчетаГруппы.Количество() > 0 Тогда
		ТекНомерСтроки = 0;
		
		Для каждого ТекЗапись Из ЭтотОбъект Цикл
			
			СтрокаСчета = СчетаГруппы.Найти(ТекЗапись.СчетДт, "Ссылка");
			Если СтрокаСчета <> Неопределено Тогда
				
				ДобавитьОшибкуВТаблицу(ТаблицаОшибок.Добавить(), ТекНомерСтроки, "СчетДт",
										СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(
										НСтр("ru='Проводка %1. В проводках не могут быть использованы группы счетов (счет дебета [ПредставлениеСчета])'"),
										Новый Структура("ПредставлениеСчета", СтрокаСчета.Представление)));
										
			КонецЕсли;
			СтрокаСчета = СчетаГруппы.Найти(ТекЗапись.СчетКт, "Ссылка");
			Если СтрокаСчета <> Неопределено Тогда
		
				ДобавитьОшибкуВТаблицу(ТаблицаОшибок.Добавить(), ТекНомерСтроки, "СчетКт",
										СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(
										НСтр("ru='Проводка %1. В проводках не могут быть использованы группы счетов (счет кредита) [ПредставлениеСчета]'"),
										Новый Структура("ПредставлениеСчета", СтрокаСчета.Представление)));
										
			КонецЕсли;
			ТекНомерСтроки = ТекНомерСтроки + 1;
			
		КонецЦикла;
	КонецЕсли;
	
	Если ТаблицаОшибок.Количество()>0 Тогда
		Если ЭтотОбъект.ДополнительныеСвойства.Свойство("ТаблицаОшибок") Тогда
			ЭтотОбъект.ДополнительныеСвойства.Вставить("ТаблицаОшибок", ТаблицаОшибок);
			Отказ = Истина;
		Иначе
			БухгалтерскиеОперацииСервер.СообщитьОбОшибкахПроведения(ТаблицаОшибок, Отказ);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если КонтролироватьОперацииНаСоответствиеРПС и ЭтотОбъект.Количество()>0 И ТаблицаРПС.Количество()>0 Тогда
		
		ТаблицаРПС.Свернуть("Организация, ИФО, КФО, Счет, КПС");
		Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ВводНачальныхОстатков")
			Или ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ВводНачальныхОстатковОС") Тогда
			// во вводе начальных остатков выбирается КПС из учетной политики следующиего года
			// на текущий момент учетной политики может не быть вообще
			ДатаУчетнойПолитики = КонецГода(ЭтотОбъект[0].Период)+1;
		Иначе
			ДатаУчетнойПолитики = ЭтотОбъект[0].Период;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ТаблицаРПС.Организация КАК Организация,
		|	ТаблицаРПС.ИФО КАК ИФО,
		|	ТаблицаРПС.КФО КАК КФО,
		|	ТаблицаРПС.Счет КАК Счет,
		|	ТаблицаРПС.КПС КАК КПС
		|ПОМЕСТИТЬ ВыбранныеСчета
		|ИЗ
		|	&ТаблицаРПС КАК ТаблицаРПС
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВыбранныеСчета.Организация КАК Организация,
		|	ВыбранныеСчета.ИФО КАК ИФО,
		|	ВыбранныеСчета.КФО КАК КФО,
		|	ВыбранныеСчета.Счет КАК Счет,
		|	ВыбранныеСчета.КПС КАК КПС,
		|	ЕСТЬNULL(РабочиеСчетаСрезПоследних.Актуален, ЛОЖЬ) КАК Актуален
		|ИЗ
		|	ВыбранныеСчета КАК ВыбранныеСчета
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РабочиеСчета.СрезПоследних(
		|				&Период,
		|				Организация = &Организация   
		|					И ИФО В
		|						(ВЫБРАТЬ
		|							ВыбранныеСчета.ИФО
		|						ИЗ
		|							ВыбранныеСчета)
		|					И КПС В
		|						(ВЫБРАТЬ
		|							ВыбранныеСчета.КПС
		|						ИЗ
		|							ВыбранныеСчета)
		|					И КФО В
		|						(ВЫБРАТЬ
		|							ВыбранныеСчета.КФО
		|						ИЗ
		|							ВыбранныеСчета)
		|					И Счет В
		|						(ВЫБРАТЬ
		|							ВыбранныеСчета.Счет
		|						ИЗ
		|							ВыбранныеСчета)) КАК РабочиеСчетаСрезПоследних
		|		ПО ВыбранныеСчета.Организация = РабочиеСчетаСрезПоследних.Организация
		|			И ВыбранныеСчета.ИФО = РабочиеСчетаСрезПоследних.ИФО
		|			И ВыбранныеСчета.КФО = РабочиеСчетаСрезПоследних.КФО
		|			И ВыбранныеСчета.Счет = РабочиеСчетаСрезПоследних.Счет
		|			И ВыбранныеСчета.КПС = РабочиеСчетаСрезПоследних.КПС
		|			И (РабочиеСчетаСрезПоследних.Актуален)
		|ГДЕ
		|	НЕ ЕСТЬNULL(РабочиеСчетаСрезПоследних.Актуален, ЛОЖЬ)";
		
		Если НЕ ИспользоватьУчетПоИФО Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ВыбранныеСчета.ИФО = РабочиеСчетаСрезПоследних.ИФО", "");
		КонецЕсли;
		Запрос.УстановитьПараметр("ТаблицаРПС", ТаблицаРПС);
		Запрос.УстановитьПараметр("Период", ДатаУчетнойПолитики);
		Запрос.УстановитьПараметр("Организация", ТаблицаРПС[0].Организация);
		Если ПривилегированныйРежим() Тогда
			Результат = Запрос.Выполнить();
		Иначе
			УстановитьПривилегированныйРежим(Истина);
			Результат = Запрос.Выполнить();
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		
		НесоответствиеРПС = Результат.Выгрузить();
		
		Если ЕстьПравоИзмененияРабочихСчетов Тогда
			
			ДопустимаяСтруктураРПС = БухгалтерскийУчетПовтИсп.ТекущаяСтруктураРПС(ТаблицаРПС[0].Организация,
																?(ИспользоватьУчетПоИФО, ТаблицаРПС[0].ИФО, Неопределено),
																ДатаУчетнойПолитики);
			
			Для каждого ТекНесоответствие Из НесоответствиеРПС Цикл
				
				// проверим соответствие учетной политике
				РабочийСчетСоответствуетУП = Истина;
				
				ДопустимыеВидыКПС = БухгалтерскийУчетПовтИсп.ВидыКПСПоУчетнойПолитике(ТекНесоответствие.Организация,
														?(ИспользоватьУчетПоИФО, ТекНесоответствие.ИФО, Неопределено),
														ТекНесоответствие.КФО,
														ДатаУчетнойПолитики);
				
				Если ДопустимаяСтруктураРПС = Справочники.СтруктурыРПС.ДляАвтономных И
					Не ТекНесоответствие.Счет.ДляАвтономных Тогда
					РабочийСчетСоответствуетУП = Ложь;
				ИначеЕсли ДопустимаяСтруктураРПС = Справочники.СтруктурыРПС.ДляБюджетных И
					Не ТекНесоответствие.Счет.ДляБюджетных Тогда
					РабочийСчетСоответствуетУП = Ложь;
				ИначеЕсли ДопустимаяСтруктураРПС = Справочники.СтруктурыРПС.ДляКазенных И
					Не ТекНесоответствие.Счет.ДляКазенных Тогда
					РабочийСчетСоответствуетУП = Ложь;
				КонецЕсли;
				
				Если НЕ РабочийСчетСоответствуетУП Тогда
					ДобавитьОшибкуВТаблицу(ТаблицаОшибок.Добавить(), 0, "",
											СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
											НСтр("ru='Выбранный счет %1 не соответствует текущей структуре рабочего плана счетов.'"),
											ТекНесоответствие.Счет));
				КонецЕсли;
				
				Если ДопустимыеВидыКПС.Найти(ТекНесоответствие.КПС.ВидПоказателя)=Неопределено Тогда
					РабочийСчетСоответствуетУП = Ложь;
					ДобавитьОшибкуВТаблицу(ТаблицаОшибок.Добавить(), 0, "",
											СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
											НСтр("ru='Выбранный КПС %1 не соответствует учетной политике.'"),
											ТекНесоответствие.КПС));
				КонецЕсли;
				
				Если НЕ РабочийСчетСоответствуетУП Тогда
					Отказ = Истина;
				КонецЕсли;
				
				Если НЕ Отказ Тогда
					
					МенеджерЗаписи = РегистрыСведений.РабочиеСчета.СоздатьМенеджерЗаписи();
					МенеджерЗаписи.Период		= ДатаУчетнойПолитики;
					МенеджерЗаписи.Организация	= ТекНесоответствие.Организация;
					МенеджерЗаписи.ИФО			= ТекНесоответствие.ИФО;
					МенеджерЗаписи.КФО			= ТекНесоответствие.КФО;
					МенеджерЗаписи.Счет			= ТекНесоответствие.Счет;
					МенеджерЗаписи.КПС			= ТекНесоответствие.КПС;
					МенеджерЗаписи.Актуален		= Истина;
					МенеджерЗаписи.Записать();
					
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе
			
			Для каждого ТекНесоответствие Из НесоответствиеРПС Цикл
				
				ДобавитьОшибкуВТаблицу(ТаблицаОшибок.Добавить(), 0, "",
										СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
										НСтр("ru='В рабочем плане счетов отсутствует счет %1'"),
										""+ТекНесоответствие.КПС+ТекНесоответствие.КФО+СтрЗаменить(ТекНесоответствие.Счет,".","")
										+"000"));
								
				
			КонецЦикла;
			
		КонецЕсли;
		
		Если ТаблицаОшибок.Количество()>0 Тогда
			
			ПредставлениеТиповойОперации = "";
			Если ДополнительныеСвойства.Свойство("ПредставлениеОперации") Тогда
				ПредставлениеТиповойОперации = Нстр("ru='Типовая операция: '") + ДополнительныеСвойства.ПредставлениеОперации + Символы.ПС;
			КонецЕсли;
			Для каждого ТекОшибка Из ТаблицаОшибок Цикл
				
				ПредставлениеСобытия = ПредставлениеТиповойОперации + Нстр("ru='Проводка '")+(ТекОшибка.НомерПроводки+1)+" "+ТекОшибка.ТекстОшибки;
				
				ЗаписьЖурналаРегистрации(	"Проведение документа.", 
											УровеньЖурналаРегистрации.Ошибка,
											МетаданныеДокумента,
											ДокументСсылка,
											ПредставлениеСобытия);
			
			КонецЦикла;
			
			Если ЭтотОбъект.ДополнительныеСвойства.Свойство("ТаблицаОшибок") Тогда
				ЭтотОбъект.ДополнительныеСвойства.Вставить("ТаблицаОшибок", ТаблицаОшибок);
				Отказ = Истина;
			Иначе
				БухгалтерскиеОперацииСервер.СообщитьОбОшибкахПроведения(ТаблицаОшибок, Отказ);
			КонецЕсли;
			Возврат;
		КонецЕсли;
		
		
	КонецЕсли;
	
	АктивностьЗаписей = ?(ЭтотОбъект.Количество() > 0, ЭтотОбъект[0].Активность, Ложь);
	
	Если АктивностьЗаписей И Не Отказ Тогда
		РегистрыСведений.УчетныеДанныеОбъектаОС.СформироватьДвиженияПоРегистру(ДокументСсылка, ЭтотОбъект);
		УчетУСН.СформироватьДвиженияПоНалоговомуУчетуУСН(ДокументСсылка, ЭтотОбъект);
		РегистрыНакопления.ОборотыРасчетовСУчредителями.СформироватьОборотыОЦИ(ДокументСсылка, ЭтотОбъект);
	КонецЕсли;
	
	Если Константы.КонтролироватьОстаткиНоменклатурыПриИзмененияхВПрошлыхПериодах.Получить() Тогда
		
		ДанныеПроведения = Новый Структура("Дата,Организация", ДатаНабора, ОрганизацияНабора);
		
		Если ДатаНабора = Неопределено Тогда
			ЗаполнитьТекущиеДанныеПроведения(ДокументСсылка, ДанныеПроведения);
		КонецЕсли;
		
		ПараметрыДанныхСчетов = УправлениеМатериальнымиЗапасами.ПараметрыДанныхСчетовУчетаМЗ(ДанныеПроведения.Организация, Ложь);
		ПараметрыДанныхСчетов.ДатаСчета = ДанныеПроведения.Дата;
		ПараметрыДанныхСчетов.Включать113 = Истина;
		ПараметрыДанныхСчетов.Включать106 = Истина;
		ПараметрыДанныхСчетов.Включать106ИК = Истина;
		ПараметрыДанныхСчетов.Включать108 = Истина;
		
		ДанныеСчетов = УправлениеМатериальнымиЗапасами.СчетаУчетаМатериальныхЗапасов(ПараметрыДанныхСчетов);
		ОтборСчетов = Новый Массив;
		Для Каждого ДанныеСчета Из ДанныеСчетов Цикл
			ОтборСчетов.Добавить(ДанныеСчета.Счет);
		КонецЦикла;
		
		БлокироватьДляИзменения = Истина;

		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЕПСБУ.Ссылка КАК Счет
		|ПОМЕСТИТЬ ВТ_СчетаКонтроля
		|ИЗ
		|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|ГДЕ
		|	НЕ ЕПСБУ.ЭлементГруппа
		|	И ЕПСБУ.Ссылка В ИЕРАРХИИ(&Счета)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕПСБУДвиженияССубконто.Организация КАК Организация,
		|	ЕПСБУДвиженияССубконто.ИФО КАК ИФО,
		|	ЕПСБУДвиженияССубконто.КФО КАК КФО,
		|	ЕПСБУДвиженияССубконто.СчетДт КАК СчетДт,
		|	ЕПСБУДвиженияССубконто.СубконтоДт1 КАК СубконтоДт1,
		|	ЕПСБУДвиженияССубконто.ВидСубконтоДт1 КАК ВидСубконтоДт1,
		|	ЕПСБУДвиженияССубконто.СубконтоДт2 КАК СубконтоДт2,
		|	ЕПСБУДвиженияССубконто.ВидСубконтоДт2 КАК ВидСубконтоДт2,
		|	ЕПСБУДвиженияССубконто.СубконтоДт3 КАК СубконтоДт3,
		|	ЕПСБУДвиженияССубконто.ВидСубконтоДт3 КАК ВидСубконтоДт3,
		|	ЕПСБУДвиженияССубконто.КПСДт КАК КПСДт,
		|	ЕПСБУДвиженияССубконто.ПодразделениеДт КАК ПодразделениеДт,
		|	ЕПСБУДвиженияССубконто.КоличествоДт КАК КоличествоДт,
		|	ЕПСБУДвиженияССубконто.СчетКт КАК СчетКт,
		|	ЕПСБУДвиженияССубконто.СубконтоКт1 КАК СубконтоКт1,
		|	ЕПСБУДвиженияССубконто.ВидСубконтоКт1 КАК ВидСубконтоКт1,
		|	ЕПСБУДвиженияССубконто.СубконтоКт2 КАК СубконтоКт2,
		|	ЕПСБУДвиженияССубконто.ВидСубконтоКт2 КАК ВидСубконтоКт2,
		|	ЕПСБУДвиженияССубконто.СубконтоКт3 КАК СубконтоКт3,
		|	ЕПСБУДвиженияССубконто.ВидСубконтоКт3 КАК ВидСубконтоКт3,
		|	ЕПСБУДвиженияССубконто.КПСКт КАК КПСКт,
		|	ЕПСБУДвиженияССубконто.ПодразделениеКт КАК ПодразделениеКт,
		|	ЕПСБУДвиженияССубконто.КоличествоКт КАК КоличествоКт
		|ПОМЕСТИТЬ ВТ_ДвиженияЕПСБУПередЗаписью
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
		|			,
		|			,
		|			Регистратор = &ДокументСсылка
		|				И Активность
		|				И Счет В
		|					(ВЫБРАТЬ
		|						ВТ_СчетаКонтроля.Счет
		|					ИЗ
		|						ВТ_СчетаКонтроля)
		|				И ВЫБОР
		|					КОГДА ВидСубконто1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
		|						ТОГДА ИСТИНА
		|					КОГДА ВидСубконто2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
		|						ТОГДА ИСТИНА
		|					КОГДА ВидСубконто3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
		|						ТОГДА ИСТИНА
		|					ИНАЧЕ ЛОЖЬ
		|				КОНЕЦ,
		|			,
		|			) КАК ЕПСБУДвиженияССубконто";
		
		
		Запрос.УстановитьПараметр("ДокументСсылка", ДокументСсылка);
		Запрос.УстановитьПараметр("Счета", ОтборСчетов);
		
		Запрос.Выполнить();
				
		МоментДокумента = ДокументСсылка.МоментВремени();

		ДанныеКонтроля = Новый Структура;
		ДанныеКонтроля.Вставить("МенеджерВТ", Запрос.МенеджерВременныхТаблиц);
		ДанныеКонтроля.Вставить("МоментВремени", ?(ДанныеПроведения.Дата = МоментДокумента.Дата, МоментДокумента, ДанныеПроведения.Дата));

		ДополнительныеСвойства.Вставить("ДанныеКонтроляОстатков", ДанныеКонтроля);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ, РежимЗаписи)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("ОтключитьПроверку") Тогда
		Возврат;
	КонецЕсли;
	
	Если ДополнительныеСвойства.Свойство("ДанныеКонтроляОстатков") Тогда
		
