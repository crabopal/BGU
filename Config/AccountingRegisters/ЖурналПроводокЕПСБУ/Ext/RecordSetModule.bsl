Процедура УстановитьЗначенияПоУмолчанию(СтрокаНабора)
	СвойстваСчетаДт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаНабора.СчетДт);
	УстановитьЗначенияПоУмолчаниюДтКт(СтрокаНабора, СвойстваСчетаДт, "Дт");
	СвойстваСчетаКт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаНабора.СчетКт);
	УстановитьЗначенияПоУмолчаниюДтКт(СтрокаНабора, СвойстваСчетаКт, "Кт");
	Если НЕ СвойстваСчетаДт.НалоговыйУчетНеУчитываемых И НЕ СвойстваСчетаКт.НалоговыйУчетНеУчитываемых Тогда
		СтрокаНабора.СуммаНеУчитываетсяНУ = Null;
	КонецЕсли;
	Если НЕ СвойстваСчетаДт.НалоговыйУчетЕНВД И НЕ СвойстваСчетаКт.НалоговыйУчетЕНВД Тогда
		СтрокаНабора.СуммаЕНВД = Null;
	КонецЕсли;
	Если НЕ СвойстваСчетаДт.НалоговыйУчетНДС И НЕ СвойстваСчетаКт.НалоговыйУчетНДС Тогда
		СтрокаНабора.СуммаНДС = Null;
	КонецЕсли;
КонецПроцедуры

Процедура УстановитьЗначенияПоУмолчаниюДтКт(СтрокаНабора, СвойстваСчета, ДтКт)
	
	Если НЕ СвойстваСчета.УчетПоПодразделениям Тогда
		СтрокаНабора["Подразделение" + ДтКт] = Null;
	КонецЕсли;
	Если НЕ СвойстваСчета.УчетПоКПС Тогда
		СтрокаНабора["КПС" + ДтКт] = Null;
	КонецЕсли;
	Если НЕ СвойстваСчета.УчетПоКЭК Тогда
		СтрокаНабора["КЭК" + ДтКт] = Null;
	КонецЕсли;
	Если НЕ СвойстваСчета.Валютный Тогда
		СтрокаНабора["Валюта" + ДтКт] = Null;
		СтрокаНабора["ВалютнаяСумма" + ДтКт] = Null;
	КонецЕсли;
	Если НЕ СвойстваСчета.Количественный Тогда
		СтрокаНабора["Количество" + ДтКт] = Null;
	КонецЕсли;
	ПроверитьУстановленныеСубконто(СтрокаНабора, СвойстваСчета, ДтКт);
	
КонецПроцедуры

Процедура ПроверитьУстановленныеСубконто(СтрокаНабора, СвойстваСчета, ДтКт)

	ЗначенияСубконто = Новый Соответствие;
	Для каждого ВидСубконтоСчета Из СтрокаНабора["Субконто" + ДтКт] Цикл
		ЗначенияСубконто.Вставить(ВидСубконтоСчета.Ключ, ВидСубконтоСчета.Значение);
	КонецЦикла;
	
	СтрокаНабора["Субконто" + ДтКт].Очистить();
	
	Для НомерСубконто = 1 По СвойстваСчета.КоличествоСубконто Цикл
		ВидСубконто = СвойстваСчета["ВидСубконто" + НомерСубконто];
		ТипСубконто = СвойстваСчета["ВидСубконто" + НомерСубконто + "ТипЗначения"];
		СтрокаНабора["Субконто" + ДтКт].Вставить(
			ВидСубконто,
			ТипСубконто.ПривестиЗначение(ЗначенияСубконто.Получить(ВидСубконто)));
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьОшибкуВТаблицу(СтрокаОшибки, НомерПроводки, ПолеОшибки, ТекстОшибки)
	СтрокаОшибки.НомерПроводки	= НомерПроводки;
	СтрокаОшибки.ПолеОшибки		= ПолеОшибки;
	СтрокаОшибки.ТекстОшибки 	= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, НомерПроводки+1);
КонецПроцедуры

#Область КонтрольОстатковПриИзмененииВпрошлыхПериодах

Процедура ЗаполнитьТекущиеДанныеПроведения(ДокументСсылка, ДанныеПроведения)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЖурналПроводокЕПСБУ.Период КАК Дата,
	|	ЖурналПроводокЕПСБУ.Организация КАК Организация
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ЖурналПроводокЕПСБУ
	|ГДЕ
	|	ЖурналПроводокЕПСБУ.Регистратор = &ДокументСсылка");
	
	Запрос.УстановитьПараметр("ДокументСсылка", ДокументСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ДанныеПроведения, Выборка);
	КонецЕсли;
	
КонецПроцедуры

Процедура КонтрольТекущихОстатковНаИзменения(Запрос, Отказ, Параметры)
	
	Запрос.Текст = Запрос.Текст +
	"ВЫБРАТЬ
	|	ЕПСБУОстатки.Счет КАК Счет,
	|	ВЫБОР
	|		КОГДА ВТ_АналитикиКонтроля.НеУчитыватьПартии1
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ЕПСБУОстатки.Субконто1
	|	КОНЕЦ КАК Субконто1,
	|	ВЫБОР
	|		КОГДА ВТ_АналитикиКонтроля.НеУчитыватьПартии2
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ЕПСБУОстатки.Субконто2
	|	КОНЕЦ КАК Субконто2,
	|	ВЫБОР
	|		КОГДА ВТ_АналитикиКонтроля.НеУчитыватьПартии3
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ЕПСБУОстатки.Субконто3
	|	КОНЕЦ КАК Субконто3,
	|	ЕПСБУОстатки.Организация КАК Организация,
	|	ЕПСБУОстатки.ИФО КАК ИФО,
	|	ЕПСБУОстатки.КФО КАК КФО,
	|	ЕСТЬNULL(ЕПСБУОстатки.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) КАК КПС,
	|	ЕСТЬNULL(ЕПСБУОстатки.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК Подразделение,
	|	СУММА(ЕПСБУОстатки.КоличествоОстаток) КАК ТекущийОстаток
	|ПОМЕСТИТЬ ВТ_ТекущиеОстатки
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			,
	|			Счет В
	|				(ВЫБРАТЬ
	|					ВТ_АналитикиКонтроля.Счет
	|				ИЗ
	|					ВТ_АналитикиКонтроля),
	|			,
	|			(Организация, КФО, ИФО) В
	|				(ВЫБРАТЬ
	|					ВТ_АналитикиКонтроля.Организация,
	|					ВТ_АналитикиКонтроля.КФО,
	|					ВТ_АналитикиКонтроля.ИФО
	|				ИЗ
	|					ВТ_АналитикиКонтроля)) КАК ЕПСБУОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_АналитикиКонтроля КАК ВТ_АналитикиКонтроля
	|		ПО ЕПСБУОстатки.Организация = ВТ_АналитикиКонтроля.Организация
	|			И ЕПСБУОстатки.ИФО = ВТ_АналитикиКонтроля.ИФО
	|			И ЕПСБУОстатки.КФО = ВТ_АналитикиКонтроля.КФО
	|			И ЕПСБУОстатки.Счет = ВТ_АналитикиКонтроля.Счет
	|			И (ВЫБОР
	|				КОГДА ВТ_АналитикиКонтроля.НеУчитыватьПартии1
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ЕПСБУОстатки.Субконто1 = ВТ_АналитикиКонтроля.Субконто1
	|			КОНЕЦ)
	|			И (ВЫБОР
	|				КОГДА ВТ_АналитикиКонтроля.НеУчитыватьПартии2
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ЕПСБУОстатки.Субконто2 = ВТ_АналитикиКонтроля.Субконто2
	|			КОНЕЦ)
	|			И (ВЫБОР
	|				КОГДА ВТ_АналитикиКонтроля.НеУчитыватьПартии3
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ЕПСБУОстатки.Субконто3 = ВТ_АналитикиКонтроля.Субконто3
	|			КОНЕЦ)
	|			И (ЕСТЬNULL(ЕПСБУОстатки.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) = ВТ_АналитикиКонтроля.КПС)
	|			И (ЕСТЬNULL(ЕПСБУОстатки.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) = ВТ_АналитикиКонтроля.Подразделение)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕПСБУОстатки.Счет,
	|	ВЫБОР
	|		КОГДА ВТ_АналитикиКонтроля.НеУчитыватьПартии1
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ЕПСБУОстатки.Субконто1
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ВТ_АналитикиКонтроля.НеУчитыватьПартии2
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ЕПСБУОстатки.Субконто2
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ВТ_АналитикиКонтроля.НеУчитыватьПартии3
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ЕПСБУОстатки.Субконто3
	|	КОНЕЦ,
	|	ЕПСБУОстатки.Организация,
	|	ЕПСБУОстатки.ИФО,
	|	ЕПСБУОстатки.КФО,
	|	ЕСТЬNULL(ЕПСБУОстатки.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)),
	|	ЕСТЬNULL(ЕПСБУОстатки.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_АналитикиКонтроля.Организация КАК Организация,
	|	ВТ_АналитикиКонтроля.ИФО КАК ИФО,
	|	ВТ_АналитикиКонтроля.КФО КАК КФО,
	|	ВТ_АналитикиКонтроля.Счет КАК Счет,
	|	ВТ_АналитикиКонтроля.Субконто1 КАК Субконто1,
	|	ВТ_АналитикиКонтроля.ВидСубконто1 КАК ВидСубконто1,
	|	ВТ_АналитикиКонтроля.Субконто2 КАК Субконто2,
	|	ВТ_АналитикиКонтроля.ВидСубконто2 КАК ВидСубконто2,
	|	ВТ_АналитикиКонтроля.Субконто3 КАК Субконто3,
	|	ВТ_АналитикиКонтроля.ВидСубконто3 КАК ВидСубконто3,
	|	ВТ_АналитикиКонтроля.КПС КАК КПС,
	|	ВТ_АналитикиКонтроля.Подразделение КАК Подразделение,
	|	ВТ_АналитикиКонтроля.УчетПоКПС КАК УчетПоКПС,
	|	ВТ_АналитикиКонтроля.УчетПоПодразделениям КАК УчетПоПодразделениям,
	|	ВТ_АналитикиКонтроля.КоличествоИзменение КАК КоличествоИзменение,
	|	ЕСТЬNULL(ВТ_ТекущиеОстатки.ТекущийОстаток, 0) КАК ТекущийОстаток
	|ИЗ
	|	ВТ_АналитикиКонтроля КАК ВТ_АналитикиКонтроля
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ТекущиеОстатки КАК ВТ_ТекущиеОстатки
	|		ПО ВТ_АналитикиКонтроля.Организация = ВТ_ТекущиеОстатки.Организация
	|			И ВТ_АналитикиКонтроля.ИФО = ВТ_ТекущиеОстатки.ИФО
	|			И ВТ_АналитикиКонтроля.КФО = ВТ_ТекущиеОстатки.КФО
	|			И ВТ_АналитикиКонтроля.Счет = ВТ_ТекущиеОстатки.Счет
	|			И ВТ_АналитикиКонтроля.Субконто1 = ВТ_ТекущиеОстатки.Субконто1
	|			И ВТ_АналитикиКонтроля.Субконто2 = ВТ_ТекущиеОстатки.Субконто2
	|			И ВТ_АналитикиКонтроля.Субконто3 = ВТ_ТекущиеОстатки.Субконто3
	|			И ВТ_АналитикиКонтроля.КПС = ВТ_ТекущиеОстатки.КПС
	|			И ВТ_АналитикиКонтроля.Подразделение = ВТ_ТекущиеОстатки.Подразделение";
	
	ДополнитьЗапросАналитикамиРезерва(Запрос, Параметры.РезервироватьМЗПриВыбытии, "ПоТекущищмОстаткам");
	
	ВыборкаКонтроля = Запрос.Выполнить().Выбрать();
	
	ОшибкиКонтроля = Неопределено;
	Резерв = 0;
	
	Пока ВыборкаКонтроля.Следующий() Цикл
		
		ТекущийОстаток = ВыборкаКонтроля.ТекущийОстаток;
		
		Если Параметры.РезервироватьМЗПриВыбытии Тогда
			Резерв = ВыборкаКонтроля.РезервМЗ;
			ТекущийОстаток = ТекущийОстаток - Резерв;
		КонецЕсли;
		
		Если ТекущийОстаток < 0 Тогда
			СтрокаСообщения = НСтр("ru = 'Изменение количества в текущем документе: %1, не хватает текущего остатка на: %2 '") + Символы.ПС + НСтр("ru = 'по '");
			
			Если Резерв > 0 Тогда
				СтрокаСообщения = НСтр("ru = 'Изменение количества в текущем документе: %1, не хватает текущего остатка на: %2 с учетом резерва: %8 '") +
					Символы.ПС + НСтр("ru = 'по '");
			КонецЕсли;
			
			ПараметрыДобавления = Новый Структура;
			ПараметрыДобавления.Вставить("УчетПоИФО", Параметры.УчетПоИФО);
			ПараметрыДобавления.Вставить("ТекущийОстаток", ТекущийОстаток);
			ПараметрыДобавления.Вставить("Резерв", Резерв);

			ДобавитьОшибкуКонтроляОстатков(СтрокаСообщения, ВыборкаКонтроля, ОшибкиКонтроля, ПараметрыДобавления);
		КонецЕсли;
	КонецЦикла;

	ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(ОшибкиКонтроля, Отказ);

КонецПроцедуры

