Процедура ДополнитьТаблицуВТ_АналитикиКонтроляУчетПартий(Запрос)
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(Запрос.Текст);
	
	ЗапросПакета = СхемаЗапроса.ПакетЗапросов[0];
	Оператор = ЗапросПакета.Операторы[0];
	ТаблицаТекущая = Оператор.Источники[0];
	
	Для НомерСубконто = 1 По 3 Цикл
		
		ПолеСубконто = Оператор.ВыбираемыеПоля.Найти(СтрШаблон("Субконто%1", НомерСубконто));
		Если ПолеСубконто = Неопределено Тогда
			Возврат;
		КонецЕсли;
		ИндексПолеСубконто = Оператор.ВыбираемыеПоля.Индекс(ПолеСубконто);
		
		Оператор.ВыбираемыеПоля[ИндексПолеСубконто] = Новый ВыражениеСхемыЗапроса(СтрШаблон(
		"ВЫБОР
		|	КОГДА ВложенныйЗапрос.ВидСубконто%1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Партии)
		|		ТОГДА НЕОПРЕДЕЛЕНО
		|	ИНАЧЕ ВложенныйЗапрос.Субконто%1
		|КОНЕЦ", НомерСубконто));
		
		ПолеНеУчитыватьПартииСубконто = Оператор.ВыбираемыеПоля.Найти("ЛОЖЬ");
		Если ПолеНеУчитыватьПартииСубконто = Неопределено Тогда
			Возврат;
		КонецЕсли;
		ИндексНеУчитыватьПартииСубконто = Оператор.ВыбираемыеПоля.Индекс(ПолеНеУчитыватьПартииСубконто);
		
		Оператор.ВыбираемыеПоля[ИндексНеУчитыватьПартииСубконто] = Новый ВыражениеСхемыЗапроса(СтрШаблон(
		"ВложенныйЗапрос.ВидСубконто%1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Партии)", НомерСубконто));
			
	КонецЦИкла;
	
	Запрос.Текст = СхемаЗапроса.ПолучитьТекстЗапроса();

КонецПроцедуры

