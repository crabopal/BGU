Функция ОпределитьПодходящийВидСчетаФактурыРеализация(ДокументРеализации) Экспорт
	
	Перем ТекстСообщения;
	
	Если УчетНДС.ДопустимВводСФНаОснованииРеализации(ДокументРеализации, ТекстСообщения) Тогда
		Возврат "СчетФактураВыданный";
		
	ИначеЕсли УчетНДС.ДопустимВводКСФНаОснованииРеализации(ДокументРеализации, ТекстСообщения) Тогда
		Возврат "КорректировочныйСчетФактураВыданный";
		
	ИначеЕсли УчетНДС.ДопустимВводИСФНаОснованииРеализации(ДокументРеализации, ТекстСообщения) Тогда
		Возврат "ИсправительныйСчетФактураВыданный";
		
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция ОпределитьПодходящийВидСчетаФактурыПоступления(ДокументПоступления) Экспорт
	
	Перем ТекстСообщения;
	
	Если УчетНДС.ДопустимВводСФНаОснованииПоступления(ДокументПоступления, ТекстСообщения) Тогда
		Возврат "СчетФактураПолученный";
		
	ИначеЕсли УчетНДС.ДопустимВводКСФНаОснованииПоступления(ДокументПоступления, ТекстСообщения) Тогда
		Возврат "КорректировочныйСчетФактураПолученный";
		
	ИначеЕсли УчетНДС.ДопустимВводИСФНаОснованииПоступления(ДокументПоступления, ТекстСообщения) Тогда
		Возврат "ИсправительныйСчетФактураПолученный";
		
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

// Возвращает дату регистрации счетов-фактур полученных и выданных в предыдущем периоде 
// (дата формирования движений по регистрам НДС).
// 
// Параметры:
// Организация (СправочникСсылка.Организации) -  Учреждение для определения налогового периода из учетной политики
// ДатаСФ (Дата) - Дата документа Счет-фактура
// 
// Возвращаемое значение:
//  Дату регистрации счет-фактуры в регистрах НДС
Функция ДатаРегистрацииСФвПредыдущемПериоде(Организация, ДатаСФ) Экспорт
	УчетнаяПолитика = ПлатежноРасчетныеДокументыПовтИсп.ПолучитьУчетнуюПолитикуОрганизации(Организация, ДатаСФ);
	ДатаРегистрации = НачалоКвартала(ДатаСФ) - 1;
	Если УчетнаяПолитика.НДСНалоговыйПериод = ПредопределенноеЗначение("Перечисление.Периодичность.Месяц") Тогда
		ДатаРегистрации = НачалоМесяца(ДатаСФ) - 1;
	КонецЕсли;

	Возврат НачалоДня(ДатаРегистрации);
КонецФункции	

// Возвращает дату формирования движений в регистрах НДС при проведении счетов-фактур
//
// СтруктураШапкиДокумента - структура или ДокументСсылка. Содержит данные шапки документа.
Функция ДатаФормированияДвиженияВРегистреНДС(СтруктураШапкиДокумента) Экспорт
	
	Если Документы.ТипВсеСсылки().Типы().Найти(СтруктураШапкиДокумента) <> Неопределено Тогда
		МетаДокумента = СтруктураШапкиДокумента.Метаданные();
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("РегистрацияВПредыдущемПериоде", МетаДокумента)
			И СтруктураШапкиДокумента.РегистрацияВПредыдущемПериоде Тогда
				
			ДатаРезультат = КонецДня(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
				СтруктураШапкиДокумента, 
				"ДатаРегистрацииВПредыдущемПериоде"));
		Иначе	
			ДатаРезультат = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтруктураШапкиДокумента, "Дата");
		КонецЕсли;	
	Иначе
		ДатаРезультат = СтруктураШапкиДокумента.Дата;
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтруктураШапкиДокумента, "РегистрацияВПредыдущемПериоде")
			И СтруктураШапкиДокумента.РегистрацияВПредыдущемПериоде Тогда
			ДатаРезультат = КонецДня(СтруктураШапкиДокумента.ДатаРегистрацииВПредыдущемПериоде);
		КонецЕсли;
	КонецЕсли;		
	
	Возврат(ДатаРезультат);
КонецФункции	

// Заполняет реквизит "ДатаРегистрацииВПредыдущемПериоде" счетов-фактур
// в обработчике "ПередЗаписью" объекта
// 
// Параметры:
//  ДокументОбъект - ДокументОбъект. Документ, для которого заполняем реквизит
Процедура УстановитьДатуДвиженийВРегистреНДС(ДокументОбъект) Экспорт
	Если ДокументОбъект.РегистрацияВПредыдущемПериоде Тогда
		ДатаРегистрации = ДатаРегистрацииСФвПредыдущемПериоде(ДокументОбъект.Организация, ДокументОбъект.Дата);
		Если ДатаРегистрации <> ДокументОбъект.ДатаРегистрацииВПредыдущемПериоде Тогда
			ДокументОбъект.ДатаРегистрацииВПредыдущемПериоде = ДатаРегистрации;
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры	

