
#Область ПрограммныйИнтерфейс

Функция СписокДетейДляТабеляОсновнаяПрограмма(Знач НачалоПериода, Знач ОкончаниеПериода, Знач Группа, Знач РебенокОтбор = Неопределено) Экспорт
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СоставГруппДДУ01.Ребенок КАК Ребенок
	               |ПОМЕСТИТЬ втСоставГрупп02
	               |ИЗ
	               |	РегистрСведений.СоставГруппДДУ КАК СоставГруппДДУ01
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СоставГруппДДУ КАК СоставГруппДДУ02
	               |		ПО СоставГруппДДУ01.Ребенок = СоставГруппДДУ02.Ребенок
	               |ГДЕ
	               |	СоставГруппДДУ01.Период = &НачалоПериода
	               |	И СоставГруппДДУ02.Период = ДОБАВИТЬКДАТЕ(&НачалоПериода, ДЕНЬ, 1)
	               |	И СоставГруппДДУ01.Актуальность = ЛОЖЬ
	               |	И СоставГруппДДУ02.Актуальность = ИСТИНА
				   |	И &УсловиеРебенокОтбор0
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Ребенок
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СоставГруппДДУ.Ребенок КАК Ребенок,
	               |	&НачалоПериода КАК НачалоПериода,
	               |	NULL КАК КонецПериода,
	               |	СоставГруппДДУ.Период КАК Период,
	               |	СоставГруппДДУ.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения
	               |ПОМЕСТИТЬ втСоставГрупп
	               |ИЗ
	               |	РегистрСведений.СоставГруппДДУ.СрезПоследних(&НачалоПериода, &УсловиеГруппаОрганизация1 И &УсловиеРебенокОтбор1) КАК СоставГруппДДУ
	               |ГДЕ
	               |	СоставГруппДДУ.Актуальность
	               |
	               |ОБЪЕДИНИТЬ
	               |
	               |ВЫБРАТЬ
	               |	СоставГруппДДУ.Ребенок,
	               |	ВЫБОР
	               |		КОГДА СоставГруппДДУ.Актуальность
	               |			ТОГДА СоставГруппДДУ.Период
	               |		ИНАЧЕ NULL
	               |	КОНЕЦ,
	               |	ВЫБОР
	               |		КОГДА НЕ СоставГруппДДУ.Актуальность
	               |			ТОГДА ВЫБОР
	               |					КОГДА ИСТИНА В
	               |							(ВЫБРАТЬ ПЕРВЫЕ 1
	               |								ИСТИНА
	               |							ИЗ
	               |								РегистрСведений.СоставГруппДДУ КАК Т
	               |							ГДЕ
	               |								СоставГруппДДУ.Ребенок = Т.Ребенок
	               |								И Т.Период = ДОБАВИТЬКДАТЕ(СоставГруппДДУ.Период, ДЕНЬ, 1)
	               |								И Т.Актуальность = ИСТИНА)
	               |						ТОГДА СоставГруппДДУ.Период
	               |					ИНАЧЕ ДОБАВИТЬКДАТЕ(СоставГруппДДУ.Период, ДЕНЬ, -1)
	               |				КОНЕЦ
	               |		ИНАЧЕ NULL
	               |	КОНЕЦ,
	               |	СоставГруппДДУ.Период,
	               |	СоставГруппДДУ.ГруппаДетскогоУчреждения
	               |ИЗ
	               |	РегистрСведений.СоставГруппДДУ КАК СоставГруппДДУ
	               |ГДЕ
	               |	СоставГруппДДУ.Период МЕЖДУ &НачалоПериода И &ОкончаниеПериода
	               |	И &УсловиеГруппаОрганизация2
				   |	И &УсловиеРебенокОтбор2
	               |
	               |ОБЪЕДИНИТЬ
	               |
	               |ВЫБРАТЬ
	               |	СоставГруппДДУ.Ребенок,
	               |	NULL,
	               |	&ОкончаниеПериода,
	               |	СоставГруппДДУ.Период,
	               |	СоставГруппДДУ.ГруппаДетскогоУчреждения
	               |ИЗ
	               |	РегистрСведений.СоставГруппДДУ.СрезПоследних(&ОкончаниеПериода, &УсловиеГруппаОрганизация1 И &УсловиеРебенокОтбор1) КАК СоставГруппДДУ
	               |ГДЕ
	               |	СоставГруппДДУ.Актуальность
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	втСоставГрупп.Ребенок КАК Ребенок,
	               |	втСоставГрупп.НачалоПериода КАК НачалоПериода,
	               |	МИНИМУМ(втСоставГруппВл.КонецПериода) КАК ОкончаниеПериода,
	               |	втСоставГрупп.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения
	               |ПОМЕСТИТЬ втСоставГруппИнтервалы
	               |ИЗ
	               |	втСоставГрупп КАК втСоставГрупп
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			втСоставГрупп.Ребенок КАК Ребенок,
	               |			втСоставГрупп.КонецПериода КАК КонецПериода,
	               |			втСоставГрупп.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения
	               |		ИЗ
	               |			втСоставГрупп КАК втСоставГрупп
	               |		ГДЕ
	               |			НЕ втСоставГрупп.КонецПериода ЕСТЬ NULL) КАК втСоставГруппВл
	               |		ПО втСоставГрупп.ГруппаДетскогоУчреждения = втСоставГруппВл.ГруппаДетскогоУчреждения
	               |			И втСоставГрупп.Ребенок = втСоставГруппВл.Ребенок
	               |ГДЕ
	               |	НЕ втСоставГрупп.НачалоПериода ЕСТЬ NULL
	               |	И втСоставГрупп.НачалоПериода <= втСоставГруппВл.КонецПериода
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	втСоставГрупп.Ребенок,
	               |	втСоставГрупп.НачалоПериода,
	               |	втСоставГрупп.ГруппаДетскогоУчреждения
	               |
	               |ОБЪЕДИНИТЬ
	               |
	               |ВЫБРАТЬ
	               |	втСоставГрупп.Ребенок,
	               |	&НачалоПериода,
	               |	&НачалоПериода,
	               |	втСоставГрупп.ГруппаДетскогоУчреждения
	               |ИЗ
	               |	втСоставГрупп КАК втСоставГрупп
	               |ГДЕ
	               |	втСоставГрупп.НачалоПериода ЕСТЬ NULL
	               |	И втСоставГрупп.КонецПериода = &НачалоПериода
	               |	И ИСТИНА В
	               |			(ВЫБРАТЬ ПЕРВЫЕ 1
	               |				ИСТИНА
	               |			ИЗ
	               |				ВтСоставГрупп02
	               |			ГДЕ
	               |				ВтСоставГрупп02.Ребенок = втСоставГрупп.Ребенок)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	втСоставГруппИнтервалы.Ребенок КАК Ребенок,
	               |	втСоставГруппИнтервалы.НачалоПериода КАК НачалоПериода,
	               |	втСоставГруппИнтервалы.ОкончаниеПериода КАК ОкончаниеПериода,
	               |	втСоставГруппИнтервалы.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения
	               |ПОМЕСТИТЬ втСоставГруппПериоды
	               |ИЗ
	               |	втСоставГруппИнтервалы КАК втСоставГруппИнтервалы
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	втСоставГрупп.Ребенок КАК Ребенок,
	               |	ВЫБОР
	               |		КОГДА Дети.ДатаПриема <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |				И Дети.ДатаПриема > втСоставГрупп.НачалоПериода
	               |			ТОГДА Дети.ДатаПриема
	               |		ИНАЧЕ втСоставГрупп.НачалоПериода
	               |	КОНЕЦ КАК НачалоПериода,
	               |	ВЫБОР
	               |		КОГДА Дети.ДатаВыбытия <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |				И Дети.ДатаВыбытия < втСоставГрупп.ОкончаниеПериода
	               |			ТОГДА Дети.ДатаВыбытия
	               |		ИНАЧЕ втСоставГрупп.ОкончаниеПериода
	               |	КОНЕЦ КАК ОкончаниеПериода,
	               |	втСоставГрупп.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения
	               |ИЗ
	               |	втСоставГруппПериоды КАК втСоставГрупп
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Дети КАК Дети
	               |		ПО втСоставГрупп.Ребенок = Дети.Ссылка
	               |ГДЕ
	               |	НЕ втСоставГрупп.НачалоПериода ЕСТЬ NULL
	               |	И ВЫБОР
	               |			КОГДА Дети.ДатаПриема <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |					И Дети.ДатаПриема > втСоставГрупп.НачалоПериода
	               |				ТОГДА Дети.ДатаПриема
	               |			ИНАЧЕ втСоставГрупп.НачалоПериода
	               |		КОНЕЦ <= ВЫБОР
	               |			КОГДА Дети.ДатаВыбытия <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |					И Дети.ДатаВыбытия < втСоставГрупп.ОкончаниеПериода
	               |				ТОГДА Дети.ДатаВыбытия
	               |			ИНАЧЕ втСоставГрупп.ОкончаниеПериода
	               |		КОНЕЦ";
				   
	Если ТипЗнч(Группа) = Тип("СправочникСсылка.ГруппыДетскогоУчреждения") Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеГруппаОрганизация1", "ГруппаДетскогоУчреждения = &Группа");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеГруппаОрганизация2", "СоставГруппДДУ.ГруппаДетскогоУчреждения = &Группа");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеГруппаОрганизация1", "Ребенок.Организация = &Группа");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеГруппаОрганизация2", "СоставГруппДДУ.Ребенок.Организация = &Группа");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РебенокОтбор) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеРебенокОтбор0", "СоставГруппДДУ01.Ребенок = &РебенокОтбор");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеРебенокОтбор1", "Ребенок = &РебенокОтбор");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеРебенокОтбор2", "СоставГруппДДУ.Ребенок = &РебенокОтбор");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеРебенокОтбор0", "Истина");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеРебенокОтбор1", "Истина");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеРебенокОтбор2", "Истина");
	КонецЕсли;	
	
	Запрос = Новый Запрос(ТекстЗапроса);

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("ОкончаниеПериода", ОкончаниеПериода);
	Запрос.УстановитьПараметр("Группа", Группа);
	Запрос.УстановитьПараметр("РебенокОтбор", РебенокОтбор);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция СписокДетейДляТабеляДополнительнаяПрограмма(Знач НачалоПериода, Знач ОкончаниеПериода, Знач Группа, Знач РебенокОтбор = Неопределено) Экспорт

	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СоставГруппДДУ01.Ребенок КАК Ребенок
	               |ПОМЕСТИТЬ втСоставГрупп02
	               |ИЗ
	               |	РегистрСведений.СоставГруппДДУДополнительныеУслуги КАК СоставГруппДДУ01
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СоставГруппДДУДополнительныеУслуги КАК СоставГруппДДУ02
	               |		ПО СоставГруппДДУ01.Ребенок = СоставГруппДДУ02.Ребенок
	               |ГДЕ
	               |	СоставГруппДДУ01.Период = &НачалоПериода
	               |	И СоставГруппДДУ02.Период = ДОБАВИТЬКДАТЕ(&НачалоПериода, ДЕНЬ, 1)
	               |	И СоставГруппДДУ01.Актуальность = ЛОЖЬ
	               |	И СоставГруппДДУ02.Актуальность = ИСТИНА
				   |	И &УсловиеРебенокОтбор0
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Ребенок
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СоставГруппДДУ.Ребенок КАК Ребенок,
	               |	&НачалоПериода КАК НачалоПериода,
	               |	NULL КАК КонецПериода,
	               |	СоставГруппДДУ.Период КАК Период,
	               |	СоставГруппДДУ.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения
	               |ПОМЕСТИТЬ втСоставГрупп
	               |ИЗ
	               |	РегистрСведений.СоставГруппДДУДополнительныеУслуги.СрезПоследних(&НачалоПериода, &УсловиеГруппаОрганизация1 И &УсловиеРебенокОтбор1) КАК СоставГруппДДУ
	               |ГДЕ
	               |	СоставГруппДДУ.Актуальность
	               |
	               |ОБЪЕДИНИТЬ
	               |
	               |ВЫБРАТЬ
	               |	СоставГруппДДУ.Ребенок,
	               |	ВЫБОР
	               |		КОГДА СоставГруппДДУ.Актуальность
	               |			ТОГДА СоставГруппДДУ.Период
	               |		ИНАЧЕ NULL
	               |	КОНЕЦ,
	               |	ВЫБОР
	               |		КОГДА НЕ СоставГруппДДУ.Актуальность
	               |			ТОГДА ВЫБОР
	               |					КОГДА ИСТИНА В
	               |							(ВЫБРАТЬ ПЕРВЫЕ 1
	               |								ИСТИНА
	               |							ИЗ
	               |								РегистрСведений.СоставГруппДДУДополнительныеУслуги КАК Т
	               |							ГДЕ
	               |								СоставГруппДДУ.Ребенок = Т.Ребенок
	               |								И СоставГруппДДУ.ГруппаДетскогоУчреждения = Т.ГруппаДетскогоУчреждения
	               |								И Т.Период = ДОБАВИТЬКДАТЕ(СоставГруппДДУ.Период, ДЕНЬ, 1)
	               |								И Т.Актуальность = ИСТИНА)
	               |						ТОГДА СоставГруппДДУ.Период
	               |					ИНАЧЕ ДОБАВИТЬКДАТЕ(СоставГруппДДУ.Период, ДЕНЬ, -1)
	               |				КОНЕЦ
	               |		ИНАЧЕ NULL
	               |	КОНЕЦ,
	               |	СоставГруппДДУ.Период,
	               |	СоставГруппДДУ.ГруппаДетскогоУчреждения
	               |ИЗ
	               |	РегистрСведений.СоставГруппДДУДополнительныеУслуги КАК СоставГруппДДУ
	               |ГДЕ
	               |	СоставГруппДДУ.Период МЕЖДУ &НачалоПериода И &ОкончаниеПериода
	               |	И &УсловиеГруппаОрганизация2
				   |	И &УсловиеРебенокОтбор2
	               |
	               |ОБЪЕДИНИТЬ
	               |
	               |ВЫБРАТЬ
	               |	СоставГруппДДУ.Ребенок,
	               |	NULL,
	               |	&ОкончаниеПериода,
	               |	СоставГруппДДУ.Период,
	               |	СоставГруппДДУ.ГруппаДетскогоУчреждения
	               |ИЗ
	               |	РегистрСведений.СоставГруппДДУДополнительныеУслуги.СрезПоследних(&ОкончаниеПериода, &УсловиеГруппаОрганизация1 И &УсловиеРебенокОтбор1) КАК СоставГруппДДУ
	               |ГДЕ
	               |	СоставГруппДДУ.Актуальность
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	втСоставГрупп.Ребенок КАК Ребенок,
	               |	втСоставГрупп.НачалоПериода КАК НачалоПериода,
	               |	МИНИМУМ(втСоставГруппВл.КонецПериода) КАК ОкончаниеПериода,
	               |	втСоставГрупп.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения
	               |ПОМЕСТИТЬ втСоставГруппИнтервалы
	               |ИЗ
	               |	втСоставГрупп КАК втСоставГрупп
	               |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			втСоставГрупп.Ребенок КАК Ребенок,
	               |			втСоставГрупп.КонецПериода КАК КонецПериода,
	               |			втСоставГрупп.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения
	               |		ИЗ
	               |			втСоставГрупп КАК втСоставГрупп
	               |		ГДЕ
	               |			НЕ втСоставГрупп.КонецПериода ЕСТЬ NULL) КАК втСоставГруппВл
	               |		ПО втСоставГрупп.ГруппаДетскогоУчреждения = втСоставГруппВл.ГруппаДетскогоУчреждения
	               |			И втСоставГрупп.Ребенок = втСоставГруппВл.Ребенок
	               |ГДЕ
	               |	НЕ втСоставГрупп.НачалоПериода ЕСТЬ NULL
	               |	И втСоставГрупп.НачалоПериода <= втСоставГруппВл.КонецПериода
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	втСоставГрупп.Ребенок,
	               |	втСоставГрупп.НачалоПериода,
	               |	втСоставГрупп.ГруппаДетскогоУчреждения
	               |
	               |ОБЪЕДИНИТЬ
	               |
	               |ВЫБРАТЬ
	               |	втСоставГрупп.Ребенок,
	               |	&НачалоПериода,
	               |	&НачалоПериода,
	               |	втСоставГрупп.ГруппаДетскогоУчреждения
	               |ИЗ
	               |	втСоставГрупп КАК втСоставГрупп
	               |ГДЕ
	               |	втСоставГрупп.НачалоПериода ЕСТЬ NULL
	               |	И втСоставГрупп.КонецПериода = &НачалоПериода
	               |	И ИСТИНА В
	               |			(ВЫБРАТЬ ПЕРВЫЕ 1
	               |				ИСТИНА
	               |			ИЗ
	               |				ВтСоставГрупп02
	               |			ГДЕ
	               |				ВтСоставГрупп02.Ребенок = втСоставГрупп.Ребенок)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	втСоставГруппИнтервалы.Ребенок КАК Ребенок,
	               |	втСоставГруппИнтервалы.НачалоПериода КАК НачалоПериода,
	               |	втСоставГруппИнтервалы.ОкончаниеПериода КАК ОкончаниеПериода,
	               |	втСоставГруппИнтервалы.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения
	               |ПОМЕСТИТЬ втСоставГруппПериоды
	               |ИЗ
	               |	втСоставГруппИнтервалы КАК втСоставГруппИнтервалы
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	втСоставГрупп.Ребенок КАК Ребенок,
	               |	ВЫБОР
	               |		КОГДА Дети.ДатаПриема <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |				И Дети.ДатаПриема > втСоставГрупп.НачалоПериода
	               |			ТОГДА Дети.ДатаПриема
	               |		ИНАЧЕ втСоставГрупп.НачалоПериода
	               |	КОНЕЦ КАК НачалоПериода,
	               |	ВЫБОР
	               |		КОГДА Дети.ДатаВыбытия <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |				И Дети.ДатаВыбытия < втСоставГрупп.ОкончаниеПериода
	               |			ТОГДА Дети.ДатаВыбытия
	               |		ИНАЧЕ втСоставГрупп.ОкончаниеПериода
	               |	КОНЕЦ КАК ОкончаниеПериода,
	               |	втСоставГрупп.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения
	               |ИЗ
	               |	втСоставГруппПериоды КАК втСоставГрупп
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Дети КАК Дети
	               |		ПО втСоставГрупп.Ребенок = Дети.Ссылка
	               |ГДЕ
	               |	НЕ втСоставГрупп.НачалоПериода ЕСТЬ NULL
	               |	И ВЫБОР
	               |			КОГДА Дети.ДатаПриема <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |					И Дети.ДатаПриема > втСоставГрупп.НачалоПериода
	               |				ТОГДА Дети.ДатаПриема
	               |			ИНАЧЕ втСоставГрупп.НачалоПериода
	               |		КОНЕЦ <= ВЫБОР
	               |			КОГДА Дети.ДатаВыбытия <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	               |					И Дети.ДатаВыбытия < втСоставГрупп.ОкончаниеПериода
	               |				ТОГДА Дети.ДатаВыбытия
	               |			ИНАЧЕ втСоставГрупп.ОкончаниеПериода
	               |		КОНЕЦ";
				   
	Если ТипЗнч(Группа) = Тип("СправочникСсылка.ГруппыДетскогоУчреждения") Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеГруппаОрганизация1", "ГруппаДетскогоУчреждения = &Группа");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеГруппаОрганизация2", "СоставГруппДДУ.ГруппаДетскогоУчреждения = &Группа");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеГруппаОрганизация1", "Ребенок.Организация = &Группа");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеГруппаОрганизация2", "СоставГруппДДУ.Ребенок.Организация = &Группа");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РебенокОтбор) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеРебенокОтбор0", "СоставГруппДДУ01.Ребенок = &РебенокОтбор");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеРебенокОтбор1", "Ребенок = &РебенокОтбор");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеРебенокОтбор2", "СоставГруппДДУ.Ребенок = &РебенокОтбор");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеРебенокОтбор0", "Истина");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеРебенокОтбор1", "Истина");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеРебенокОтбор2", "Истина");
	КонецЕсли;	
	
	Запрос = Новый Запрос(ТекстЗапроса);

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("ОкончаниеПериода", ОкончаниеПериода);
	Запрос.УстановитьПараметр("Группа", Группа);
	Запрос.УстановитьПараметр("РебенокОтбор", РебенокОтбор);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция СоставитьСписокДетейГруппыОсновнойОбразовательнойПрограммы(Знач НаДату = Неопределено, Знач ОкончаниеПериода = Неопределено, ОрганизацияГруппаДДУ, РассчитатьЗадолженность = Ложь) Экспорт

	Если Не ЗначениеЗаполнено(ОрганизацияГруппаДДУ) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если НаДату = Неопределено Тогда
		НаДату = ТекущаяДатаСеанса();
	КонецЕсли;
	
	НаДату = НачалоДня(НаДату);
	
	Если ОкончаниеПериода <> Неопределено Тогда
		ОкончаниеПериода = КонецДня(ОкончаниеПериода);
		Если ОкончаниеПериода < НаДату Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;

	Если ТипЗнч(ОрганизацияГруппаДДУ) = Тип("СправочникСсылка.Организации") Тогда
		Организация = ОрганизацияГруппаДДУ;
		ГруппаДДУ   = Неопределено;
		ОтборОрганизация = Организация;
	Иначе
		Организация = Неопределено;
		ГруппаДДУ   = ОрганизацияГруппаДДУ;
		ОтборОрганизация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОрганизацияГруппаДДУ,"Владелец");
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НаДату", НаДату);
	Запрос.УстановитьПараметр("ОкончаниеПериода", ОкончаниеПериода);
	Запрос.УстановитьПараметр("ГруппаДДУ", ГруппаДДУ);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ОтборОрганизация", ОтборОрганизация);

	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СоставГруппДДУ01.Ребенок КАК Ребенок
	|ПОМЕСТИТЬ втСоставГрупп02
	|ИЗ
	|	РегистрСведений.СоставГруппДДУ КАК СоставГруппДДУ01
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СоставГруппДДУ КАК СоставГруппДДУ02
	|		ПО СоставГруппДДУ01.Ребенок = СоставГруппДДУ02.Ребенок
	|ГДЕ
	|	СоставГруппДДУ01.Период = &НаДату
	|	И СоставГруппДДУ02.Период = ДОБАВИТЬКДАТЕ(&НаДату, ДЕНЬ, 1)
	|	И СоставГруппДДУ01.Актуальность = ЛОЖЬ
	|	И СоставГруппДДУ02.Актуальность = ИСТИНА
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ребенок";
	
	ТекстЗапроса = ТекстЗапроса + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	СоставГруппДДУСрезПоследних.Ребенок КАК Ребенок,
	|	СоставГруппДДУСрезПоследних.Ребенок.Организация КАК Организация,
	|	&НаДату КАК НачалоПериода,
	|	СоставГруппДДУСрезПоследних.ГруппаДетскогоУчреждения,
	|	СоставГруппДДУСрезПоследних.Ребенок.Контрагент КАК Контрагент,
	|	СоставГруппДДУСрезПоследних.Договор КАК ДоговорКонтрагента,
	|	СоставГруппДДУСрезПоследних.Льгота,
	|	СоставГруппДДУСрезПоследних.СтавкаОплаты,
	|	СоставГруппДДУСрезПоследних.Ребенок.ДатаВыбытия КАК ДатаВыбытия
	|ПОМЕСТИТЬ СписокДляРасчета
	|ИЗ
	|	РегистрСведений.СоставГруппДДУ.СрезПоследних(&Надату, Ребенок В
	|			(ВЫБРАТЬ
	|				Т1.Ссылка
	|			ИЗ
	|				Справочник.Дети КАК Т1
	|			ГДЕ
	|				Т1.Организация = &ОтборОрганизация)) КАК СоставГруппДДУСрезПоследних
	|ГДЕ
	|	СоставГруппДДУСрезПоследних.Актуальность
	|	И (СоставГруппДДУСрезПоследних.Ребенок.ДатаВыбытия = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ИЛИ СоставГруппДДУСрезПоследних.Ребенок.ДатаВыбытия > &НаДату)";
	
	Если ГруппаДДУ = Неопределено Тогда
		
		ТекстЗапроса = ТекстЗапроса + "	
		|	И СоставГруппДДУСрезПоследних.Ребенок.Организация = &Организация";

	Иначе	
		
		ТекстЗапроса = ТекстЗапроса + "	
		|	И СоставГруппДДУСрезПоследних.ГруппаДетскогоУчреждения = &ГруппаДДУ";
		
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + ОбщегоНазначенияБГУ.ТекстРазделителяОбъединенияЗапросов() +
	"ВЫБРАТЬ
	|	СоставГруппДДУСрезПоследних.Ребенок КАК Ребенок,
	|	СоставГруппДДУСрезПоследних.Ребенок.Организация КАК Организация,
	|	&НаДату КАК НачалоПериода,
	|	СоставГруппДДУСрезПоследних.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения,
	|	СоставГруппДДУСрезПоследних.Ребенок.Контрагент КАК Контрагент,
	|	СоставГруппДДУСрезПоследних.Договор КАК ДоговорКонтрагента,
	|	СоставГруппДДУСрезПоследних.Льгота КАК Льгота,
	|	СоставГруппДДУСрезПоследних.СтавкаОплаты КАК СтавкаОплаты,
	|	СоставГруппДДУСрезПоследних.Ребенок.ДатаВыбытия КАК ДатаВыбытия
	|ИЗ
	|	РегистрСведений.СоставГруппДДУ.СрезПоследних(&Надату, Ребенок В
	|			(ВЫБРАТЬ
	|				Т1.Ссылка
	|			ИЗ
	|				Справочник.Дети КАК Т1
	|			ГДЕ
	|				Т1.Организация = &ОтборОрганизация)) КАК СоставГруппДДУСрезПоследних
	|ГДЕ
	|	НЕ СоставГруппДДУСрезПоследних.Актуальность
	|	И ИСТИНА В
	|			(ВЫБРАТЬ ПЕРВЫЕ 1
	|				ИСТИНА
	|			ИЗ
	|				втСоставГрупп02
	|			ГДЕ
	|				втСоставГрупп02.Ребенок = СоставГруппДДУСрезПоследних.Ребенок)
	|	И (СоставГруппДДУСрезПоследних.Ребенок.ДатаВыбытия = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ИЛИ СоставГруппДДУСрезПоследних.Ребенок.ДатаВыбытия > &НаДату)
	|	И СоставГруппДДУСрезПоследних.ГруппаДетскогоУчреждения = &ГруппаДДУ";
	
	Если НЕ ОкончаниеПериода = Неопределено Тогда
		
		ТекстЗапроса = ТекстЗапроса + ОбщегоНазначенияБГУ.ТекстРазделителяОбъединенияЗапросов() +
		"ВЫБРАТЬ
		|	СоставГруппДДУ.Ребенок,
		|	СоставГруппДДУ.Ребенок.Организация,
		|	СоставГруппДДУ.Период,
		|	СоставГруппДДУ.ГруппаДетскогоУчреждения,
		|	СоставГруппДДУ.Ребенок.Контрагент,
		|	СоставГруппДДУ.Договор,
		|	СоставГруппДДУ.Льгота,
		|	СоставГруппДДУ.СтавкаОплаты,
		|	СоставГруппДДУ.Ребенок.ДатаВыбытия
		|ИЗ
		|	РегистрСведений.СоставГруппДДУ КАК СоставГруппДДУ
		|ГДЕ
		|	СоставГруппДДУ.Период > &НаДату
		|	И СоставГруппДДУ.Период < &ОкончаниеПериода";
		
		Если ГруппаДДУ = Неопределено Тогда
			
			ТекстЗапроса = ТекстЗапроса + "	
			|	И СоставГруппДДУ.Ребенок.Организация = &Организация";
			
		Иначе	
			
			ТекстЗапроса = ТекстЗапроса + "	
			|	И СоставГруппДДУ.ГруппаДетскогоУчреждения = &ГруппаДДУ";
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если РассчитатьЗадолженность Тогда
		
		ТекстЗапроса = ТекстЗапроса + ОбщегоНазначения.РазделительПакетаЗапросов() +
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕПСБУ.Ссылка КАК СчетЕПСБУ
		|ПОМЕСТИТЬ СчетаРасчетов
		|ИЗ
		|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|ГДЕ
		|	ЕПСБУ.Ссылка В ИЕРАРХИИ
		|			(ВЫБРАТЬ
		|				Выборка.Ссылка
		|			ИЗ
		|				ПланСчетов.ЕПСБУ КАК Выборка
		|			ГДЕ
		|				(Выборка.Код = ""205.30""
		|					ИЛИ Выборка.Код = ""205.55""
		|					ИЛИ Выборка.Код = ""205.80""))
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	СчетЕПСБУ";
		
	КонецЕсли;	
	
	ТекстЗапроса = ТекстЗапроса + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	СписокДляРасчета.Ребенок КАК Ребенок,
	|	СписокДляРасчета.Организация,
	|	СписокДляРасчета.НачалоПериода КАК НачалоПериода,";
	
	Если НЕ ОкончаниеПериода = Неопределено Тогда
		
		ТекстЗапроса = ТекстЗапроса + "
		|	ВЫБОР
		|		КОГДА НЕ ВложенныйЗапрос.ЕстьЗаписи ЕСТЬ NULL 
		|			ТОГДА ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|		КОГДА СписокДляРасчета.ДатаВыбытия = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|				ИЛИ СписокДляРасчета.ДатаВыбытия > &ОкончаниеПериода
		|			ТОГДА &ОкончаниеПериода
		|		ИНАЧЕ СписокДляРасчета.ДатаВыбытия
		|	КОНЕЦ КАК КонецПериода,";
		
	Иначе
		
		ТекстЗапроса = ТекстЗапроса + "
		|	ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0) КАК КонецПериода,";
		
	КонецЕсли;

	ТекстЗапроса = ТекстЗапроса + "
	|	СписокДляРасчета.ГруппаДетскогоУчреждения,
	|	СписокДляРасчета.Контрагент,
	|	СписокДляРасчета.ДоговорКонтрагента,
	|	СписокДляРасчета.Льгота,
	|	СписокДляРасчета.СтавкаОплаты,
	|	СписокДляРасчета.ДатаВыбытия,";
	
	Если РассчитатьЗадолженность Тогда
		
		ТекстЗапроса = ТекстЗапроса + "			   
		|	ЕСТЬNULL(ЕПСБУОстатки.СуммаОстаток, 0) КАК Задолженность";
		
	Иначе
		
		ТекстЗапроса = ТекстЗапроса + "			   
		|	0 КАК Задолженность";
		
	КонецЕсли;		   
	
	ТекстЗапроса = ТекстЗапроса + "			   
	|ИЗ
	|	СписокДляРасчета КАК СписокДляРасчета";
	
	Если НЕ ОкончаниеПериода = Неопределено Тогда
		
		ТекстЗапроса = ТекстЗапроса + "
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|		КОЛИЧЕСТВО(СоставГруппДДУ.Период) КАК ЕстьЗаписи,
		|			СоставГруппДДУ.Ребенок
		|		ИЗ
		|			РегистрСведений.СоставГруппДДУ КАК СоставГруппДДУ
		|		ГДЕ
		|			СоставГруппДДУ.Период < &ОкончаниеПериода
		|			И СоставГруппДДУ.Период > &НаДату
		|		СГРУППИРОВАТЬ ПО
		|			СоставГруппДДУ.Ребенок) КАК ВложенныйЗапрос
		|		ПО СписокДляРасчета.Ребенок = ВложенныйЗапрос.Ребенок";
		
	КонецЕсли;  
	
	Если РассчитатьЗадолженность Тогда
		
		ТекстЗапроса = ТекстЗапроса + "	
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|				&НаДату,
		|				Счет В
		|					(ВЫБРАТЬ
		|						СчетаРасчетов.СчетЕПСБУ
		|					ИЗ
		|						СчетаРасчетов),
		|				,
		|				) КАК ЕПСБУОстатки
		|		ПО (СписокДляРасчета.ДоговорКонтрагента = (ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто2 КАК Справочник.Договоры)))
		|			И (СписокДляРасчета.Контрагент = (ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.Контрагенты)))
		|			И (ЕПСБУОстатки.Организация = СписокДляРасчета.Организация)";
		
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + "
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ребенок,
	|	НачалоПериода";
	
	Запрос.Текст = ТекстЗапроса;
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция СоставитьСписокДетейГруппыДополнительнойОбразовательнойПрограммы(Знач НаДату = Неопределено, Знач ОкончаниеПериода = Неопределено, Знач ОрганизацияГруппаДДУ, РассчитатьЗадолженность = Ложь) Экспорт
	
	Если Не ЗначениеЗаполнено(ОрганизацияГруппаДДУ) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если НаДату = Неопределено Тогда
		НаДату = ТекущаяДатаСеанса();
	КонецЕсли;	
	
	НаДату = НачалоДня(НаДату);
	
	Если ОкончаниеПериода <> Неопределено Тогда
		ОкончаниеПериода = КонецДня(ОкончаниеПериода);
		Если ОкончаниеПериода < НаДату	Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(ОрганизацияГруппаДДУ) = Тип("СправочникСсылка.Организации") Тогда
		Организация = ОрганизацияГруппаДДУ;
		ГруппаДДУ   = Неопределено;
	Иначе
		Организация = Неопределено;
		ГруппаДДУ   = ОрганизацияГруппаДДУ;
	КонецЕсли;	

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НаДату", НаДату);
	Запрос.УстановитьПараметр("ОкончаниеПериода", ОкончаниеПериода);
	Запрос.УстановитьПараметр("ГруппаДДУ", ГруппаДДУ);
	Запрос.УстановитьПараметр("Организация", Организация);

	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СоставГруппДДУСрезПоследних.Ребенок КАК Ребенок,
	|	СоставГруппДДУСрезПоследних.Ребенок.Организация КАК Организация,
	|	&НаДату КАК НачалоПериода,
	|	СоставГруппДДУСрезПоследних.ГруппаДетскогоУчреждения,
	|	СоставГруппДДУСрезПоследних.Ребенок.Контрагент КАК Контрагент,
	|	СоставГруппДДУСрезПоследних.Договор КАК ДоговорКонтрагента,
	|	СоставГруппДДУСрезПоследних.Льгота,
	|	СоставГруппДДУСрезПоследних.СтавкаОплаты,
	|	СоставГруппДДУСрезПоследних.Ребенок.ДатаВыбытия КАК ДатаВыбытия
	|ПОМЕСТИТЬ СписокДляРасчета
	|ИЗ
	|	РегистрСведений.СоставГруппДДУДополнительныеУслуги.СрезПоследних(&Надату, ) КАК СоставГруппДДУСрезПоследних
	|ГДЕ
	|	(СоставГруппДДУСрезПоследних.Ребенок.ДатаВыбытия = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ИЛИ СоставГруппДДУСрезПоследних.Ребенок.ДатаВыбытия > &НаДату)
	|	И СоставГруппДДУСрезПоследних.Актуальность = ИСТИНА";
	
	Если ГруппаДДУ = Неопределено Тогда
		
		ТекстЗапроса = ТекстЗапроса + "	
		|	И СоставГруппДДУСрезПоследних.Ребенок.Организация = &Организация";

	Иначе	
		
		ТекстЗапроса = ТекстЗапроса + "	
		|	И СоставГруппДДУСрезПоследних.ГруппаДетскогоУчреждения = &ГруппаДДУ";
		
	КонецЕсли;	
	
	Если НЕ ОкончаниеПериода = Неопределено Тогда
		
		ТекстЗапроса = ТекстЗапроса + "
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СоставГруппДДУ.Ребенок,
		|	СоставГруппДДУ.Ребенок.Организация,
		|	СоставГруппДДУ.Период,
		|	СоставГруппДДУ.ГруппаДетскогоУчреждения,
		|	СоставГруппДДУ.Ребенок.Контрагент,
		|	СоставГруппДДУ.Договор,
		|	СоставГруппДДУ.Льгота,
		|	СоставГруппДДУ.СтавкаОплаты,
		|	СоставГруппДДУ.Ребенок.ДатаВыбытия
		|ИЗ
		|	РегистрСведений.СоставГруппДДУДополнительныеУслуги КАК СоставГруппДДУ
		|ГДЕ
		|	СоставГруппДДУ.Период > &НаДату
		|	И СоставГруппДДУ.Период < &ОкончаниеПериода
		|	И СоставГруппДДУ.Актуальность = ИСТИНА";
		
		Если ГруппаДДУ = Неопределено Тогда
			
			ТекстЗапроса = ТекстЗапроса + "	
			|	И СоставГруппДДУ.Ребенок.Организация = &Организация";
			
		Иначе	
			
			ТекстЗапроса = ТекстЗапроса + "	
			|	И СоставГруппДДУ.ГруппаДетскогоУчреждения = &ГруппаДДУ";
			
		КонецЕсли;
		
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + "
	|;";
	
	Если РассчитатьЗадолженность Тогда
		
		ТекстЗапроса = ТекстЗапроса + "				   
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕПСБУ.Ссылка КАК СчетЕПСБУ
		|ПОМЕСТИТЬ СчетаРасчетов
		|ИЗ
		|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|ГДЕ
		|	ЕПСБУ.Ссылка В ИЕРАРХИИ
		|			(ВЫБРАТЬ
		|				Выборка.Ссылка
		|			ИЗ
		|				ПланСчетов.ЕПСБУ КАК Выборка
		|			ГДЕ
		|				(Выборка.Код = ""205.30""
		|					ИЛИ Выборка.Код = ""205.55""
		|					ИЛИ Выборка.Код = ""205.80""))
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	СчетЕПСБУ
		|;";
		
	КонецЕсли;	
	
	ТекстЗапроса = ТекстЗапроса + "
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СписокДляРасчета.Ребенок КАК Ребенок,
	|	СписокДляРасчета.Организация,
	|	СписокДляРасчета.НачалоПериода КАК НачалоПериода,";
	
	Если НЕ ОкончаниеПериода = Неопределено Тогда
		
		ТекстЗапроса = ТекстЗапроса + "
		|	ВЫБОР
		|		КОГДА НЕ ВложенныйЗапрос.ЕстьЗаписи ЕСТЬ NULL 
		|			ТОГДА ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|		КОГДА СписокДляРасчета.ДатаВыбытия = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|				ИЛИ СписокДляРасчета.ДатаВыбытия > &ОкончаниеПериода
		|			ТОГДА &ОкончаниеПериода
		|		ИНАЧЕ СписокДляРасчета.ДатаВыбытия
		|	КОНЕЦ КАК КонецПериода,";
		
	Иначе
		
		ТекстЗапроса = ТекстЗапроса + "
		|	ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0) КАК КонецПериода,";
		
	КонецЕсли;

	ТекстЗапроса = ТекстЗапроса + "
	|	СписокДляРасчета.ГруппаДетскогоУчреждения,
	|	СписокДляРасчета.Контрагент,
	|	СписокДляРасчета.ДоговорКонтрагента,
	|	СписокДляРасчета.Льгота,
	|	СписокДляРасчета.СтавкаОплаты,
	|	СписокДляРасчета.ДатаВыбытия,";
	
	Если РассчитатьЗадолженность Тогда
		
		ТекстЗапроса = ТекстЗапроса + "			   
		|	ЕСТЬNULL(ЕПСБУОстатки.СуммаОстаток, 0) КАК Задолженность";
		
	Иначе
		
		ТекстЗапроса = ТекстЗапроса + "			   
		|	0 КАК Задолженность";
		
	КонецЕсли;		   
	
	ТекстЗапроса = ТекстЗапроса + "			   
	|ИЗ
	|	СписокДляРасчета КАК СписокДляРасчета";
	
	Если НЕ ОкончаниеПериода = Неопределено Тогда
		
		ТекстЗапроса = ТекстЗапроса + "
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|		КОЛИЧЕСТВО(СоставГруппДДУ.Период) КАК ЕстьЗаписи,
		|			СоставГруппДДУ.Ребенок
		|		ИЗ
		|			РегистрСведений.СоставГруппДДУДополнительныеУслуги КАК СоставГруппДДУ
		|		ГДЕ
		|			СоставГруппДДУ.Период < &ОкончаниеПериода
		|			И СоставГруппДДУ.Период > &НаДату
		|		СГРУППИРОВАТЬ ПО
		|			СоставГруппДДУ.Ребенок) КАК ВложенныйЗапрос
		|		ПО СписокДляРасчета.Ребенок = ВложенныйЗапрос.Ребенок";

		
	КонецЕсли;  
	
	Если РассчитатьЗадолженность Тогда
		
		ТекстЗапроса = ТекстЗапроса + "	
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|				&НаДату,
		|				Счет В
		|					(ВЫБРАТЬ
		|						СчетаРасчетов.СчетЕПСБУ
		|					ИЗ
		|						СчетаРасчетов),
		|				,
		|				) КАК ЕПСБУОстатки
		|		ПО (СписокДляРасчета.ДоговорКонтрагента = (ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто2 КАК Справочник.Договоры)))
		|			И (СписокДляРасчета.Контрагент = (ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.Контрагенты)))
		|			И (ЕПСБУОстатки.Организация = СписокДляРасчета.Организация)";
		
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + "
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ребенок,
	|	НачалоПериода";
	
	Запрос.Текст = ТекстЗапроса;
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции	

// Функция определяет количество рабочих дней для указанного периода и графика работы
//
// Параметры
//	Дата1		- дата начала периода
//	Дата2	- дата окончания периода
//	ГрафикРаботы	- график (или производственный календарь), который необходимо использовать, 
//		тип СправочникСсылка.Календари или СправочникСсылка.ПроизводственныеКалендари,
//		если не указан - используется поставляемый производственный календарь РФ
//
// Возвращаемое значение
//	Число		- количество рабочих дней между датами начала и окончания
//	При некорректном задании параметров или отсутствии данных календаря возвращается 0.
//
Функция ПолучитьКоличествоРабочихДнейПоКалендарю(Дата1, Дата2, Знач ГрафикРаботы = Неопределено) Экспорт
	
	Возврат РасчетыПоРодительскойПлате.КолРабДней(Дата1, Дата2, ГрафикРаботы);
	
КонецФункции

Функция КоличествоРабочихДнейПоГрафикуГруппы(Дата1, Дата2, ГруппаДДУ) Экспорт
	Если ЗначениеЗаполнено(ГруппаДДУ) Тогда
		ГрафикГруппы = РасчетыПоРодительскойПлате.ПолучитьКалендарныйГрафикГруппы(ГруппаДДУ, Дата1);
	Иначе
		ГрафикГруппы = Неопределено;
	КонецЕсли;
	Возврат ПолучитьКоличествоРабочихДнейПоКалендарю(Дата1, Дата2, ГрафикГруппы);
КонецФункции

Функция ЗадолженностьЗаУслугиДетскогоУчреждения(НаДату, Организация, Контрагент, Договор) Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК СчетЕПСБУ
	|ПОМЕСТИТЬ СчетаРасчетов
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Ссылка В ИЕРАРХИИ
	|			(ВЫБРАТЬ
	|				Выборка.Ссылка
	|			ИЗ
	|				ПланСчетов.ЕПСБУ КАК Выборка
	|			ГДЕ
	|				(Выборка.Код = ""205.30""
	|					ИЛИ Выборка.Код = ""205.55""
	|					ИЛИ Выборка.Код = ""205.80""))
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	СчетЕПСБУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУОстатки.СуммаОстаток КАК Задолженность
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&НаДату,
	|			Счет В
	|				(ВЫБРАТЬ
	|					СчетаРасчетов.СчетЕПСБУ
	|				ИЗ
	|					СчетаРасчетов),
	|			,
	|			Организация = &Организация) КАК ЕПСБУОстатки
	|ГДЕ
	|	(ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.Контрагенты)) = &Контрагент
	|	И (ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто2 КАК Справочник.Договоры)) = &Договор");
	
	Запрос.УстановитьПараметр("НаДату", 		НаДату);
	Запрос.УстановитьПараметр("Организация", 	Организация);
    Запрос.УстановитьПараметр("Контрагент", 	Контрагент);
    Запрос.УстановитьПараметр("Договор", 		Договор);
	
	Результат = 0;

	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Результат = Выборка.Задолженность; 
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции	

Функция ОплатыПоДоговоруЗаУслугиДетскогоУчреждения(НачалоПериода, КонецПериода, Организация, ИФО, Контрагент, Ребенок) Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК СчетЕПСБУ
	|ПОМЕСТИТЬ СчетаРасчетов
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Ссылка В ИЕРАРХИИ
	|			(ВЫБРАТЬ
	|				Выборка.Ссылка
	|			ИЗ
	|				ПланСчетов.ЕПСБУ КАК Выборка
	|			ГДЕ
	|				(Выборка.Код = ""205.30""
	|					ИЛИ Выборка.Код = ""205.55""
	|					ИЛИ Выборка.Код = ""205.80""))
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	СчетЕПСБУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК СчетЕПСБУ
	|ПОМЕСТИТЬ СчетаДенег
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Ссылка В ИЕРАРХИИ
	|			(ВЫБРАТЬ
	|				Выборка.Ссылка
	|			ИЗ
	|				ПланСчетов.ЕПСБУ КАК Выборка
	|			ГДЕ
	|				Выборка.Код = ""201.00"")
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	СчетЕПСБУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СоставГруппДДУСрезПоследних.Договор КАК Договор
	|ПОМЕСТИТЬ ДоговорыДетей
	|ИЗ
	|	РегистрСведений.СоставГруппДДУ.СрезПоследних(&КонецПериода, Ребенок = &Ребенок) КАК СоставГруппДДУСрезПоследних
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СоставГруппДДУ.Договор
	|ИЗ
	|	РегистрСведений.СоставГруппДДУ КАК СоставГруппДДУ
	|ГДЕ
	|	СоставГруппДДУ.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И СоставГруппДДУ.Ребенок = &Ребенок
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Договор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(- ЖурналПроводокЕПСБУОбороты.СуммаОборот) КАК Оплачено
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			Период,
	|			Счет В
	|				(ВЫБРАТЬ
	|					СчетаРасчетов.СчетЕПСБУ
	|				ИЗ
	|					СчетаРасчетов КАК СчетаРасчетов),
	|			,
	|			Организация = &Организация
	|				И ИФО = &ИФО,
	|			КорСчет В
	|				(ВЫБРАТЬ
	|					СчетаДенег.СчетЕПСБУ
	|				ИЗ
	|					СчетаДенег КАК СчетаДенег),
	|			) КАК ЖурналПроводокЕПСБУОбороты
	|ГДЕ
	|	(ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОбороты.Субконто1 КАК Справочник.Контрагенты)) = &Контрагент
	|	И ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОбороты.Субконто2 КАК Справочник.Договоры) В
	|			(ВЫБРАТЬ
	|				ДоговорыДетей.Договор
	|			ИЗ
	|				ДоговорыДетей КАК ДоговорыДетей)");
	 
	Запрос.УстановитьПараметр("НачалоПериода", 	НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", 	КонецПериода);
	Запрос.УстановитьПараметр("Организация", 	Организация);
	Запрос.УстановитьПараметр("ИФО", 			ИФО);
	Запрос.УстановитьПараметр("Контрагент", 	Контрагент);
	Запрос.УстановитьПараметр("Ребенок", 		Ребенок);
	
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() И ТипЗнч(Выборка.Оплачено) = Тип("Число") И Выборка.Оплачено > 0 Тогда
		
		Возврат Выборка.Оплачено;
		
	Иначе
		
		Возврат 0;
		
	КонецЕсли;	
		 
КонецФункции	

Процедура ЗаполнитьКоличествоДнейПосещений(ДатаНачала, ДатаОкончания, ТаблицаДетей, РодительскаяПлатаДопУслуги = 0, ГрафикРаботы = Неопределено) Экспорт
	Для Каждого Стр Из ТаблицаДетей Цикл
		
		Стр.ДнейПосещенияКОплате = РодительскаяПлата.ПолучитьКоличествоРабочихДнейПоКалендарю(Стр.НачалоПериода, Стр.КонецПериода, ГрафикРаботы);
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ТаблицаДетей", ТаблицаДетей);
	Запрос.УстановитьПараметр("РодительскаяПлатаДопУслуги", РодительскаяПлатаДопУслуги);
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьРедактируемыеТабелиРодительскаяПлата") Тогда
		// Заполнение по данным регистра ТабельУчетаПосещаемостиДетейСКорректировкой.
		// Для совместимости и перезаполнения старых документов учитываются документы ТабельУчетаПосещаемостиДетей.
		
		Запрос.УстановитьПараметр("ДатаНачалаМесяца", НачалоМесяца(ДатаНачала));
		Запрос.УстановитьПараметр("ДатаНачала", НачалоМесяца(ДатаНачала));
		Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
		
		ТекстЗапроса = "ВЫБРАТЬ
		               |	ТаблицаДетей.Ребенок КАК Ребенок,
		               |	ТаблицаДетей.НачалоПериода КАК НачалоПериода,
		               |	ТаблицаДетей.КонецПериода КАК КонецПериода
		               |ПОМЕСТИТЬ ВТ_Дети
		               |ИЗ
		               |	&ТаблицаДетей КАК ТаблицаДетей
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ВТ_Дети.Ребенок КАК Ребенок,
		               |	ВТ_Дети.НачалоПериода КАК НачалоПериода,
		               |	ВТ_Дети.КонецПериода КАК КонецПериода,
		               |	СУММА(ЕСТЬNULL(Невыходы.ВидНевыхода, 0) + ЕСТЬNULL(ТабельУчетаПосещаемостиДетейСКорректировкойОбороты.НеоплачиваемыеНевыходыОборот, 0)) КАК КоличествоНеоплачиваемыхНевыходов
		               |ИЗ
		               |	ВТ_Дети КАК ВТ_Дети
		               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТабельУчетаПосещаемостиДетей КАК Невыходы
		               |		ПО ВТ_Дети.Ребенок = Невыходы.Ребенок
		               |			И (Невыходы.ДатаНевыхода МЕЖДУ ВТ_Дети.НачалоПериода И ВТ_Дети.КонецПериода)
		               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТабельУчетаПосещаемостиДетейСКорректировкой.Обороты(&ДатаНачалаМесяца, &ДатаОкончания, , РодительскаяПлатаДопУслуги = &РодительскаяПлатаДопУслуги) КАК ТабельУчетаПосещаемостиДетейСКорректировкойОбороты
		               |		ПО ВТ_Дети.Ребенок = ТабельУчетаПосещаемостиДетейСКорректировкойОбороты.Ребенок
		               |ГДЕ
		               |	Невыходы.РодительскаяПлатаДопУслуги = &РодительскаяПлатаДопУслуги
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	ВТ_Дети.НачалоПериода,
		               |	ВТ_Дети.КонецПериода,
		               |	ВТ_Дети.Ребенок";
		
	Иначе
		// Заполнение по данным регистра ТабельУчетаПосещаемостиДетей.
		
		Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
		Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
		
		ТекстЗапроса = "ВЫБРАТЬ
		               |	ТаблицаДетей.Ребенок КАК Ребенок,
		               |	ТаблицаДетей.НачалоПериода КАК НачалоПериода,
		               |	ТаблицаДетей.КонецПериода КАК КонецПериода
		               |ПОМЕСТИТЬ ВТ_Дети
		               |ИЗ
		               |	&ТаблицаДетей КАК ТаблицаДетей
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	Невыходы.Ребенок КАК Ребенок,
		               |	ВТ_Дети.НачалоПериода КАК НачалоПериода,
		               |	ВТ_Дети.КонецПериода КАК КонецПериода,
		               |	СУММА(Невыходы.ВидНевыхода) КАК КоличествоНеоплачиваемыхНевыходов
		               |ИЗ
		               |	РегистрНакопления.ТабельУчетаПосещаемостиДетей КАК Невыходы
		               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Дети КАК ВТ_Дети
		               |		ПО Невыходы.Ребенок = ВТ_Дети.Ребенок
		               |			И (Невыходы.ДатаНевыхода МЕЖДУ ВТ_Дети.НачалоПериода И ВТ_Дети.КонецПериода)
		               |ГДЕ
		               |	Невыходы.РодительскаяПлатаДопУслуги = &РодительскаяПлатаДопУслуги
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	Невыходы.Ребенок,
		               |	ВТ_Дети.НачалоПериода,
		               |	ВТ_Дети.КонецПериода";
		
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	Невыходы = Запрос.Выполнить().Выбрать();
	
	Пока Невыходы.Следующий() Цикл
		СтрокиТаблицы = ТаблицаДетей.НайтиСтроки(Новый Структура("Ребенок, НачалоПериода, КонецПериода", Невыходы.Ребенок, Невыходы.НачалоПериода, Невыходы.КонецПериода));
		
		Если СтрокиТаблицы.Количество() > 0 Тогда
			СтрокиТаблицы[0].ДнейПосещенияКОплате = СтрокиТаблицы[0].ДнейПосещенияКОплате - Невыходы.КоличествоНеоплачиваемыхНевыходов;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Функция возвращает параметры настройки расчета компенсации родительской платы на определенную дату
// Параметры функции:
//	НаДату - дата, по состоянию на которую необходимо получить параметры
//	ВидПараметра - должен принимать одно из трех значений
//		1) СпособРасчета - глобальная настройка, расчет ведется по фактической оплате или по средней по региону (согласно №272-ФЗ)
//		2) ВидСтавки - возвращает вид ставки - дневная или месячная
//		3) Ставка - возвращает значение ставки
Функция ПолучитьПараметрыРасчетаКомпенсацииРодительскойПлаты(НаДату = '00010101000000', ВидПараметра = "СпособРасчета") Экспорт
	Результат = Неопределено;
	
	Если ВидПараметра = "СпособРасчета" Тогда
		Результат = Константы.СпособРасчетаКомпенсацииРодительскойПлаты.Получить();
	Иначе
		ПараметрыКомпенсации = РегистрыСведений.СтавкаКомпенсацииРодительскойПлаты.СрезПоследних(НаДату, );
		
		Если ПараметрыКомпенсации.Количество() > 0 Тогда
			Если ВидПараметра = "ВидСтавки" Тогда
				Результат = ПараметрыКомпенсации[0].ВидСтавки;
			ИначеЕсли ВидПараметра = "Ставка" Тогда
				Результат = ПараметрыКомпенсации[0].Ставка;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция ПредыдущийПериод(Дата, Период, Граница) Экспорт
	
	Если Граница <> "НАЧАЛО" И Граница <> "ОКОНЧАНИЕ" Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Значение параметра ""Граница"" в функции ""РодительскаяПлата.ПредыдущийПериод""
			|должно быть ""НАЧАЛО"" или ""ОКОНЧАНИЕ"".
			|Значение параметра: ""%1""'"), Граница);
	КонецЕсли;
	
	Если Период <> "МЕСЯЦ" И Период <> "КВАРТАЛ" Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Значение параметра ""Период"" в функции ""РодительскаяПлата.ПредыдущийПериод""
			|должно быть ""МЕСЯЦ"" или ""КВАРТАЛ"".
			|Значение параметра: ""%1""'"), Период);
	КонецЕсли;
	
	Если Период = "МЕСЯЦ" И Граница = "НАЧАЛО" Тогда
		Возврат НачалоМесяца(ДобавитьМесяц(Дата, -1));
	ИначеЕсли Период = "МЕСЯЦ" И Граница = "ОКОНЧАНИЕ" Тогда
		Возврат КонецМесяца(ДобавитьМесяц(Дата, -1));
	ИначеЕсли Период = "КВАРТАЛ" И Граница = "НАЧАЛО" Тогда
		Возврат НачалоКвартала(ДобавитьМесяц(Дата, -3));
	ИначеЕсли Период = "КВАРТАЛ" И Граница = "ОКОНЧАНИЕ" Тогда
		Возврат КонецКвартала(ДобавитьМесяц(Дата, -3));
	КонецЕсли;
	
КонецФункции

Процедура ВывестиСообщениеОбОшибке(Формула, Ссылка, ИнформацияОбОшибке) Экспорт

	ТекстСообщения = НСтр("ru = 'Не удалось вычислить значение по формуле. Подробности см. в журнале регистрации.'");
	ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	
	ТекстОшибки = СтрШаблон(НСтр("ru = 'Не удалось вычислить значение по формуле.
										|
										|Текст формулы:
										|%1
										|
										|Текст ошибки:
										|%2'"),
							Формула,
							ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
	ЗаписьЖурналаРегистрации(НСтр("ru = 'Вычисление значения по формуле'", ОбщегоНазначения.КодОсновногоЯзыка()),
		УровеньЖурналаРегистрации.Ошибка,
		?(Ссылка = Неопределено, Неопределено, Ссылка.Метаданные()),
		Ссылка,
		ТекстОшибки);

КонецПроцедуры

Функция ПолучитьКорректирующийТабельУчетаПосещаемости(ДокументОснование) Экспорт
	
	ДействующийДокумент = Документы.ТабельУчетаПосещаемостиДетейСКорректировкой.ПустаяСсылка();
	
	Если ЗначениеЗаполнено(ДокументОснование) Тогда
	
		Запрос = Новый Запрос;
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	ТабельУчетаПосещаемостиДетейСКорректировкой.Ссылка КАК ДействующийДокумент
		               |ИЗ
		               |	Документ.ТабельУчетаПосещаемостиДетейСКорректировкой КАК ТабельУчетаПосещаемостиДетейСКорректировкой
		               |ГДЕ
		               |	ТабельУчетаПосещаемостиДетейСКорректировкой.Основание = &Основание
		               |	И ТабельУчетаПосещаемостиДетейСКорректировкой.Проведен";
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("Основание", ДокументОснование);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ДействующийДокумент = Выборка.ДействующийДокумент;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ДействующийДокумент;
	
КонецФункции

#Область ЗаполнениеРасшифровкиПоРееструПоступлений

// Извлекает значения указанных полей из строки назначения платежа по реестру (ED108)
// Примеры строки назначение платежа:
// //ПЕТЕЧКИН ВАСИЛИЙ ПЕТЕЧКИН ИВАН АЛЕКСАНДРОВИЧ//PERSACC:000000000000001,CHILDFIO:ПЕТЕЧКИН ВАСИЛИЙ,INST:МАДОУ "ДЕТСКИЙ САД № 1",CLASSNUM:ГРУППА 1
// //ПЕТЕЧКИН ВАСИЛИЙ ПЕТЕЧКИН ИВАН АЛЕКСАНДРОВИЧ//PERSACC:000000000000001;CHILDFIO:ПЕТЕЧКИН ВАСИЛИЙ;INST:МАДОУ "ДЕТСКИЙ САД № 1";CLASSNUM:ГРУППА 1
// //ПЕТЕЧКИН ВАСИЛИЙ ПЕТЕЧКИН ИВАН АЛЕКСАНДРОВИЧ//PERSACC:000000000000001;CHILDFIO:ПЕТЕЧКИН ВАСИЛИЙ;PURPOSE2:РАЗВИВАЮЩАЯ СТУДИЯ;FIO:ПЕТЕЧКИН ИВАН АЛЕКСАНДРОВИЧ;OKTMO:45348000;CBC:00000000000000000130;TYPE_DOC:ПАСПОРТ РФ;ВИД_ДОК:ПАСПОРТ
// Разделитель ; или ,
// 
// Параметры:
//   СтрокаНазначениеПлатежа - Строка - строка назначения платежа
//   ИменаПолей - Строка - имена полей для извлечения, перечисленные через запятую, без двоеточия. 
//                         "ЛицевойСчет" - возвращает значение PERSACC
//                         "ФИОРебенка"  - возвращает значение CHILDFIO
//                         "НомерГруппы" - возвращает значение CLASSNUM
//
// Возвращаемое значение:
//   Структура - структура с ключами из ИменаПолей и извлеченными значениями (пустые строки, если значения не найдены)
//
Функция ЗначенияПолейСтрокиПлатежаПоРеестру(Знач СтрокаНазначениеПлатежа, Знач ИменаПолей = "") Экспорт
	
	Результат = Новый Структура;
	
	Если Не ЗначениеЗаполнено(ИменаПолей) Тогда
		ИменаПолей = "ЛицевойСчет,ФИОРебенка,НомерГруппы";
	КонецЕсли;
	
	ИменаПолей = СтрРазделить(ИменаПолей, ",");
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		Результат.Вставить(ИмяПоля, "");
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(СтрокаНазначениеПлатежа) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Позиция = СтрНайти(СтрокаНазначениеПлатежа, "//", , , 2);
	Если Позиция > 0 Тогда
		СтрокаНазначениеПлатежа = Сред(СтрокаНазначениеПлатежа, Позиция + 2);
	КонецЕсли;
	
	// определим разделитель
	Разделитель = "";
	Если СтрНайти(СтрокаНазначениеПлатежа, ";") > 0 Тогда
		Разделитель = ";";
	КонецЕсли;
	Если СтрНайти(СтрокаНазначениеПлатежа, ",") > 0 Тогда
		Разделитель = ?(ЗначениеЗаполнено(Разделитель),"",",");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Разделитель) Тогда
		Позиция = СтрНайти(СтрокаНазначениеПлатежа, "CHILDFIO:");
		Если Позиция > 1 Тогда
			Разделитель = Сред(СтрокаНазначениеПлатежа, Позиция - 1, 1);
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Разделитель) Тогда
		Разделитель = ";";
	КонецЕсли;
	
	Для Каждого ИмяПоля Из ИменаПолей Цикл
		Если ИмяПоля = "ЛицевойСчет" Тогда
			Ключ = "PERSACC:";
		ИначеЕсли ИмяПоля = "ФИОРебенка" Тогда
			Ключ = "CHILDFIO:";
		ИначеЕсли ИмяПоля = "НомерГруппы" Тогда
			Ключ = "CLASSNUM:";
		Иначе
			Ключ = ИмяПоля + ":";
		КонецЕсли;
		ЗначениеПоля = "";
		Позиция = СтрНайти(СтрокаНазначениеПлатежа, Ключ);
		Если Позиция > 0 Тогда
			ЗначениеПоля = Сред(СтрокаНазначениеПлатежа, Позиция + СтрДлина(Ключ));
		КонецЕсли;
		Позиция = СтрНайти(ЗначениеПоля, Разделитель);
		Если Позиция > 0 Тогда
			ЗначениеПоля = Лев(ЗначениеПоля, Позиция - 1);
		КонецЕсли;
		Результат[ИмяПоля] = ЗначениеПоля;
	КонецЦикла;	

	Возврат Результат;
	
КонецФункции

// Возвращает ссылку на группу детского учреждения по наименованию и организации-владельцу.
//
// Параметры:
//   Наименование - Строка - наименование группы
//   Организация - СправочникСсылка.Организации - организация-владелец группы
//
// Возвращаемое значение:
//   СправочникСсылка.ГруппыДетскогоУчреждения - ссылка на группу, если найдена единственная
//
Функция ГруппаДетскогоУчрежденияПоНаименованию(Наименование, Организация) Экспорт
	
	ГруппаДетскогоУчреждения = Справочники.ГруппыДетскогоУчреждения.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ГруппыДетскогоУчреждения.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ГруппыДетскогоУчреждения КАК ГруппыДетскогоУчреждения
		|ГДЕ
		|	ГруппыДетскогоУчреждения.Наименование = &Наименование
		|	И ГруппыДетскогоУчреждения.Владелец = &Организация
		|	И НЕ ГруппыДетскогоУчреждения.ПометкаУдаления
		|	И НЕ ГруппыДетскогоУчреждения.ЭтоГруппа";
	
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Количество() = 1 Тогда
		Выборка.Следующий();
		ГруппаДетскогоУчреждения = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат ГруппаДетскогоУчреждения;
	
КонецФункции

// Определяет данные ребенка, контрагента и договора по строке назначения платежа из реестра
//
// Параметры:
//   ПараметрыПолучения - Структура:
//     * Организация - СправочникСсылка.Организации
//     * ДатаДокумента - Дата
//     * СтрокаНазначенияПлатежа - Строка
//     * СоответствиеГрупп - Соответствие Из КлючИЗначение
//                             * Ключ - Строка
//                             * Значение - СправочникСсылка.ГруппыДетскогоУчреждения 
//     * ОпределитьРебенкаПоНазначению - Булево
//     * ОпределитьДоговорПоНазначению - Булево
//     * Ребенок - СправочникСсылка.Дети
//
// Возвращаемое значение:
//   Структура:
//     * Ребенок - СправочникСсылка.Дети
//     * Контрагент - СправочникСсылка.Контрагенты
//     * Договор - СправочникСсылка.Договоры
//
Функция ДанныеРебенкаПоСтрокеНазначенияПлатежа(ПараметрыПолучения) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Ребенок", Справочники.Дети.ПустаяСсылка());
	Результат.Вставить("Контрагент", Справочники.Контрагенты.ПустаяСсылка());
	Результат.Вставить("Договор", Справочники.Договоры.ПустаяСсылка());
	
	Организация = ПараметрыПолучения.Организация;
	ДатаДокумента = ПараметрыПолучения.ДатаДокумента;
	СтрокаНазначениеПлатежа = ПараметрыПолучения.СтрокаНазначениеПлатежа;
	СоответствиеГрупп = ПараметрыПолучения.СоответствиеГрупп;
	ОпределитьРебенкаПоНазначению = ПараметрыПолучения.ОпределитьРебенкаПоНазначению;
	ОпределитьДоговорПоНазначению = ПараметрыПолучения.ОпределитьДоговорПоНазначению;
	
	Если Не ОпределитьРебенкаПоНазначению И Не ОпределитьДоговорПоНазначению Тогда
		Возврат Результат;
	КонецЕсли;
	
	ЗначенияПолей = ЗначенияПолейСтрокиПлатежаПоРеестру(СтрокаНазначениеПлатежа);
	
	ЛицевойСчет = ЗначенияПолей.ЛицевойСчет;
	ФИОРебенка = ЗначенияПолей.ФИОРебенка;
	НомерГруппы = ЗначенияПолей.НомерГруппы;
	
	Если ОпределитьРебенкаПоНазначению И ЗначениеЗаполнено(ЛицевойСчет) И ЗначениеЗаполнено(ФИОРебенка) Тогда
		ДанныеРебенка = ДанныеРебенкаПоЛицевомуСчетуИФИО(ЛицевойСчет, ФИОРебенка, Организация);
		Если Не ЗначениеЗаполнено(ДанныеРебенка.Ребенок) Тогда
			ДанныеРебенка = ДанныеРебенкаПоФИО(ФИОРебенка, Организация);
		КонецЕсли;
		Результат.Ребенок = ДанныеРебенка.Ребенок;
		Результат.Контрагент = ДанныеРебенка.Контрагент;
	КонецЕсли;
	
	Если ОпределитьДоговорПоНазначению И Не ОпределитьРебенкаПоНазначению Тогда
		ТекущийРебенок = ПараметрыПолучения.Ребенок;
	Иначе
		ТекущийРебенок = Результат.Ребенок;
	КонецЕсли;
	
	Если ОпределитьДоговорПоНазначению И ЗначениеЗаполнено(ТекущийРебенок) Тогда
		ГруппаДДУ = СоответствиеГрупп[НомерГруппы];
		Если ЗначениеЗаполнено(ГруппаДДУ) Тогда
			Результат.Договор = ДоговорРебенкаПоГруппеДДУ(ТекущийРебенок, ГруппаДДУ, ДатаДокумента);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает данные ребенка по лицевому счету, ФИО и организации
//
// Параметры:
//   ЛицевойСчет - Строка - код лицевого счета
//   ФИОРебенка - Строка - ФИО ребенка
//   Организация - СправочникСсылка.Организации - организация
//
// Возвращаемое значение:
//   Структура:
//     * Ребенок - СправочникСсылка.Дети - ссылка на ребенка
//     * Контрагент - СправочникСсылка.Контрагенты - ссылка на контрагента
//
Функция ДанныеРебенкаПоЛицевомуСчетуИФИО(ЛицевойСчет, ФИОРебенка, Организация) Экспорт
	
	ДанныеРебенка = Новый Структура;
	ДанныеРебенка.Вставить("Ребенок", Справочники.Дети.ПустаяСсылка());
	ДанныеРебенка.Вставить("Контрагент", Справочники.Контрагенты.ПустаяСсылка());
	
	ЗапросРебенок = Новый Запрос;
	ЗапросРебенок.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Дети.Ссылка КАК Ребенок,
		|	Дети.Контрагент КАК Контрагент
		|ИЗ
		|	Справочник.Дети КАК Дети
		|ГДЕ
		|	Дети.Код = &ЛицевойСчет
		|	И Дети.Наименование = &ФИОРебенка
		|	И Дети.Организация = &Организация
		|	И НЕ Дети.ПометкаУдаления";
	
	ЗапросРебенок.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	ЗапросРебенок.УстановитьПараметр("ФИОРебенка", ФИОРебенка);
	ЗапросРебенок.УстановитьПараметр("Организация", Организация);
	
	РезультатЗапросаРебенок = ЗапросРебенок.Выполнить();
	ВыборкаРебенок = РезультатЗапросаРебенок.Выбрать();
	
	Если ВыборкаРебенок.Следующий() Тогда
		ДанныеРебенка.Ребенок = ВыборкаРебенок.Ребенок;
		ДанныеРебенка.Контрагент = ВыборкаРебенок.Контрагент;
	КонецЕсли;
	
	Возврат ДанныеРебенка;
	
КонецФункции

// Возвращает данные ребенка по ФИО в указанной организации.
// Если найдено более одной записи с переданным ФИО, возвращает пустую ссылку.
//
// Параметры:
//   ФИОРебенка - Строка - полное имя ребенка
//   Организация - СправочникСсылка.Организации - организация
//
// Возвращаемое значение:
//   Структура:
//     * Ребенок - СправочникСсылка.Дети - найденная запись ребенка или пустая ссылка
//     * Контрагент - СправочникСсылка.Контрагенты - связанный контрагент или пустая ссылка
//
Функция ДанныеРебенкаПоФИО(ФИОРебенка, Организация) Экспорт
	
	ДанныеРебенка = Новый Структура;
	ДанныеРебенка.Вставить("Ребенок", Справочники.Дети.ПустаяСсылка());
	ДанныеРебенка.Вставить("Контрагент", Справочники.Контрагенты.ПустаяСсылка());
	
	ЗапросРебенок = Новый Запрос;
	ЗапросРебенок.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Дети.Ссылка КАК Ребенок,
		|	Дети.Контрагент КАК Контрагент
		|ИЗ
		|	Справочник.Дети КАК Дети
		|ГДЕ
		|	Дети.Наименование = &ФИОРебенка
		|	И Дети.Организация = &Организация
		|	И НЕ Дети.ПометкаУдаления";
	
	ЗапросРебенок.УстановитьПараметр("ФИОРебенка", ФИОРебенка);
	ЗапросРебенок.УстановитьПараметр("Организация", Организация);
	
	РезультатЗапросаРебенок = ЗапросРебенок.Выполнить();
	ВыборкаРебенок = РезультатЗапросаРебенок.Выбрать();
	Если ВыборкаРебенок.Количество() = 1 Тогда
		ВыборкаРебенок.Следующий();
		ДанныеРебенка.Ребенок = ВыборкаРебенок.Ребенок;
		ДанныеРебенка.Контрагент = ВыборкаРебенок.Контрагент;
	КонецЕсли;
	
	Возврат ДанныеРебенка;
	
КонецФункции

// Возвращает договор ребенка по группе детского дошкольного учреждения на указанную дату
//
// Параметры:
//   Ребенок - СправочникСсылка.Дети
//   ГруппаДДУ - СправочникСсылка.ГруппыДетскогоУчреждения
//   ДатаДокумента - Дата
//
// Возвращаемое значение:
//   СправочникСсылка.Договоры
//
Функция ДоговорРебенкаПоГруппеДДУ(Ребенок, ГруппаДДУ, ДатаДокумента) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СоставГруппДДУ.Договор КАК Договор,
		|	0 КАК Порядок,
		|	СоставГруппДДУ.Период КАК Период
		|ИЗ
		|	РегистрСведений.СоставГруппДДУ КАК СоставГруппДДУ
		|ГДЕ
		|	СоставГруппДДУ.Ребенок = &Ребенок
		|	И СоставГруппДДУ.Период <= &ДатаДокумента
		|	И СоставГруппДДУ.ГруппаДетскогоУчреждения = &ГруппаДДУ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	СоставГруппДДУДоп.Договор КАК Договор,
		|	1 КАК Порядок,
		|	СоставГруппДДУДоп.Период
		|ИЗ
		|	РегистрСведений.СоставГруппДДУДополнительныеУслуги КАК СоставГруппДДУДоп
		|ГДЕ
		|	СоставГруппДДУДоп.Ребенок = &Ребенок
		|	И СоставГруппДДУДоп.Период <= &ДатаДокумента
		|	И СоставГруппДДУДоп.ГруппаДетскогоУчреждения = &ГруппаДДУ
		|
		|УПОРЯДОЧИТЬ ПО
		|	Порядок,
		|	Период УБЫВ";
	
	Запрос.УстановитьПараметр("ДатаДокумента", ДатаДокумента);
	Запрос.УстановитьПараметр("Ребенок", Ребенок);
	Запрос.УстановитьПараметр("ГруппаДДУ", ГруппаДДУ);
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДоговор = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДоговор.Следующий() Тогда
		Возврат ВыборкаДоговор.Договор;
	КонецЕсли;
	
	Возврат Справочники.Договоры.ПустаяСсылка();
	
КонецФункции

// Возвращает основной договор ребенка на указанную дату из регистра сведений СоставГруппДДУ
//
// Параметры:
//   Ребенок - СправочникСсылка.Дети
//   ДатаДокумента - Дата
