	ВыборкаДоговор = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДоговор.Следующий() Тогда
		Возврат ВыборкаДоговор.Договор;
	КонецЕсли;
	
	Возврат Справочники.Договоры.ПустаяСсылка();
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Возвращает данные регистров СоставГруппДДУ, ПараметрыКомпенсацииРодительскойПлатыПоДетям, ПлательщикиПоУслугамДДУ.
//
// Параметры:
//  Ребенок		 - СправочникСсылка.Дети
//  Организация	 - СправочникСсылка.Организации - если не заполнена, то дополнительно читается из параметра Ребенок
//  Дата		 - Дата - если не заполнена, то на текущую дату пользователя
// 
// Возвращаемое значение:
// 	Структура - Описание:
// * ДанныеГруппы - Структура -:
//   ** Ребенок - СправочникСсылка.Дети -
//   ** ГруппаДетскогоУчреждения - СправочникСсылка.ГруппыДетскогоУчреждения -
//   ** Льгота - СправочникСсылка.ЛьготыСтудентов -
//   ** СтавкаОплаты - СправочникСсылка.СтавкиОплатыОбразование -
//   ** Договор - СправочникСсылка.Договоры -
//   ** Актуальность - Булево -
// * ПараметрыКомпенсации - ТаблицаЗначений -:
//   ** Ребенок - СправочникСсылка.Дети -
//   ** НастройкаКомпенсации - СправочникСсылка.НастройкиРасчетовПоРодительскойПлате -
//   ** ДатаНачала - Дата -
//   ** ДатаОкончания - Дата -
//   ** Ставка - Число -
// * Плательщик - Структура -:
//   ** Ребенок - СправочникСсылка.Дети -
//   ** Плательщик - СправочникСсылка.Контрагенты -
//   ** СчетПлательщика - СправочникСсылка.БанковскиеИКазначейскиеСчета -
//
Функция ДанныеРебенка(Ребенок, Знач Организация = Неопределено, Знач Дата = Неопределено) Экспорт

	Если Не ЗначениеЗаполнено(Организация) Тогда
		Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ребенок, "Владелец");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Дата) Тогда
		Дата = ОбщегоНазначения.ТекущаяДатаПользователя();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	СоставГруппДДУСрезПоследних.Ребенок КАК Ребенок,
	|	СоставГруппДДУСрезПоследних.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения,
	|	СоставГруппДДУСрезПоследних.Льгота КАК Льгота,
	|	СоставГруппДДУСрезПоследних.СтавкаОплаты КАК СтавкаОплаты,
	|	СоставГруппДДУСрезПоследних.Договор КАК Договор,
	|	СоставГруппДДУСрезПоследних.Актуальность КАК Актуальность,
	|	ВЫБОР
	|		КОГДА СоставГруппДДУСрезПоследних.Актуальность
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК Порядок
	|ИЗ
	|	РегистрСведений.СоставГруппДДУ.СрезПоследних(&Период, Ребенок = &Ребенок) КАК СоставГруппДДУСрезПоследних
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПараметрыКомпенсацииРодительскойПлатыПоДетям.Ребенок КАК Ребенок,
	|	ПараметрыКомпенсацииРодительскойПлатыПоДетям.НастройкаКомпенсации КАК НастройкаКомпенсации,
	|	ПараметрыКомпенсацииРодительскойПлатыПоДетям.ДатаНачала КАК ДатаНачала,
	|	ПараметрыКомпенсацииРодительскойПлатыПоДетям.ДатаОкончания КАК ДатаОкончания,
	|	ПараметрыКомпенсацииРодительскойПлатыПоДетям.Ставка КАК Ставка
	|ИЗ
	|	РегистрСведений.ПараметрыКомпенсацииРодительскойПлатыПоДетям КАК ПараметрыКомпенсацииРодительскойПлатыПоДетям
	|ГДЕ
	|	ПараметрыКомпенсацииРодительскойПлатыПоДетям.Организация = &Организация
	|	И ПараметрыКомпенсацииРодительскойПлатыПоДетям.Ребенок = &Ребенок
	|	И ПараметрыКомпенсацииРодительскойПлатыПоДетям.ДатаНачала <= &Период
	|	И (ПараметрыКомпенсацииРодительскойПлатыПоДетям.ДатаОкончания >= &Период
	|			ИЛИ ПараметрыКомпенсацииРодительскойПлатыПоДетям.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПлательщикиПоУслугамДДУСрезПоследних.Ребенок КАК Ребенок,
	|	ПлательщикиПоУслугамДДУСрезПоследних.Плательщик КАК Плательщик,
	|	ПлательщикиПоУслугамДДУСрезПоследних.СчетПлательщика КАК СчетПлательщика
	|ИЗ
	|	РегистрСведений.ПлательщикиПоУслугамДДУ.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И Ребенок = &Ребенок) КАК ПлательщикиПоУслугамДДУСрезПоследних";
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Ребенок", Ребенок);
	Запрос.УстановитьПараметр("Период", Дата);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ТаблицаГрупп = РезультатЗапроса[0].Выгрузить();
	Если ТаблицаГрупп.Количество() = 0 Тогда
		СтрокаТаблицы = ТаблицаГрупп.Добавить();
	Иначе
		СтрокаТаблицы = ТаблицаГрупп[0];
	КонецЕсли;
	
	ТаблицаПлательщика = РезультатЗапроса[2].Выгрузить();
	Если ТаблицаПлательщика.Количество() = 0 Тогда
		СтрокаПлательщика = ТаблицаПлательщика.Добавить();
	Иначе
		СтрокаПлательщика = ТаблицаПлательщика[0];
	КонецЕсли;
	
	Возврат Новый Структура("ДанныеГруппы, ПараметрыКомпенсации, Плательщик",
		ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(СтрокаТаблицы),
		РезультатЗапроса[1].Выгрузить(),
		ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(СтрокаПлательщика));

КонецФункции

// Заполняет поля "ДоговорКонтрагента" и "ГруппаДетскогоУчреждения".
// Может использоваться в документах ПлановыеПоступленияОплатыРодительскаяПлата и НачислениеРодительскойПлаты. 
// 
// Параметры:
// 	СтрокаДокумента - СтрокаТабличнойЧасти - 
// 	Объект - ДанныеФормыСтруктура - 
Процедура ЗаполнитьГруппуИДоговорВСтрокеДокумента(СтрокаДокумента, Объект) Экспорт

	ДанныеРебенка = ДанныеАктуальнойГруппыРебенка(СтрокаДокумента.Ребенок,
		Объект.РодительскаяПлатаДопУслуги = 0,
		Объект.КонецПериода);

	Если ДанныеРебенка.Количество() = 0  Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(СтрокаДокумента.ДоговорКонтрагента) И ДанныеРебенка.Количество() = 1 Тогда
		СтрокаДокумента.ДоговорКонтрагента = ДанныеРебенка[0].Договор;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(СтрокаДокумента.ГруппаДетскогоУчреждения) И ЗначениеЗаполнено(СтрокаДокумента.ДоговорКонтрагента) Тогда
		Для Каждого СтрокаДанных Из ДанныеРебенка Цикл
			Если СтрокаДанных.Договор = СтрокаДокумента.ДоговорКонтрагента Тогда
				СтрокаДокумента.ГруппаДетскогоУчреждения = СтрокаДанных.ГруппаДетскогоУчреждения;
				// После изменения группы требуется пересчитать количество дней по графику и дней к оплате
				СтрокаДокумента.ДнейПосещенияПоГрафику = КоличествоРабочихДнейПоГрафикуГруппы(Объект.НачалоПериода,
					Объект.КонецПериода, СтрокаДокумента.ГруппаДетскогоУчреждения);
				СтрокаДокумента.ДнейПосещенияКОплате = Мин(СтрокаДокумента.ДнейПосещенияПоГрафику, СтрокаДокумента.ДнейПосещенияКОплате);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

// Устанавливает условное оформление поля "ПроцентКомпенсации" в табличной части.
//
// Параметры:
//  Форма				 - УправляемаяФорма - 
//  ИмяТабличнойЧасти	 - Строка - имя табличной части объекта
//
Процедура УстановитьУсловноеОформлениеПроцентКомпенсацииНеЗависитОтБазы(Форма, ИмяТабличнойЧасти) Экспорт
	
	ЭлементУО = Форма.УсловноеОформление.Элементы.Добавить();
	
	ЭлементУО.Использование = Истина;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементУО.Отбор, "Объект." + ИмяТабличнойЧасти + ".НеЗависитОтБазы", Истина);
	
	ПолеУО = ЭлементУО.Поля.Элементы.Добавить();
	ПолеУО.Поле = Новый ПолеКомпоновкиДанных(ИмяТабличнойЧасти + "ПроцентКомпенсации");
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста",            ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст",                 НСтр("ru = 'не используется'"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр",        Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);

	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДанныеАктуальнойГруппыРебенка(Ребенок, ОсновнаяГруппа, Дата)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СоставГруппДДУСрезПоследних.Ребенок КАК Ребенок,
	|	СоставГруппДДУСрезПоследних.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения,
	|	СоставГруппДДУСрезПоследних.Льгота КАК Льгота,
	|	СоставГруппДДУСрезПоследних.СтавкаОплаты КАК СтавкаОплаты,
	|	СоставГруппДДУСрезПоследних.Договор КАК Договор,
	|	СоставГруппДДУСрезПоследних.Актуальность КАК Актуальность
	|ИЗ
	|	РегистрСведений.СоставГруппДДУ.СрезПоследних(&Период, Ребенок = &Ребенок) КАК СоставГруппДДУСрезПоследних
	|
	|ГДЕ
	|	СоставГруппДДУСрезПоследних.Актуальность";
	Если НЕ ОсновнаяГруппа Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, ".СоставГруппДДУ.", ".СоставГруппДДУДополнительныеУслуги.");
	КонецЕсли;
	Запрос.УстановитьПараметр("Ребенок", Ребенок);
	Если ЗначениеЗаполнено(Дата) Тогда
		Запрос.УстановитьПараметр("Период", Дата);
	Иначе
		Запрос.УстановитьПараметр("Период", ТекущаяДатаСеанса());
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

#КонецОбласти


