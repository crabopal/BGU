////////////////////////////////////////////////////////////////////////////////
// ПРОГРАММНЫЙ ИНТЕРФЕЙС

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

Функция ПроверитьОтчеты(ВыбранныеОтчеты, ВидКС, ТолькоОшибочные) Экспорт 
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ДанныеРасшифровки = Новый Соответствие;
	
	МодульОтчета = Отчеты.ПроверкаКонтрольныхСоотношенийГУ.Создать();
	ДанныеОтобранныхОтчетов = МодульОтчета.ПолучитьТаблицуГруппировкиПротоколов();
	
	СчетчикРасшифровок = 0;
	Для каждого ОтчетСсылка Из ВыбранныеОтчеты Цикл
		
		Если СчетчикРасшифровок <> 0 Тогда
			СчетчикРасшифровок = СчетчикРасшифровок + 1;
		КонецЕсли;
		
		ОтчетОбъект = ОтчетСсылка.ПолучитьОбъект();
		ОтчетОбъект.ИнициализироватьКонтекст();
		
		РезультатПроверкиОтчета = ОтчетОбъект.ПолучитьРезультатПроверки(ВидКС);
		
		ДанныеПротокола = ОтчетОбъект.ПолучитьПротоколПроверки(ТолькоОшибочные, СчетчикРасшифровок);
		
		Если ТипЗнч(ДанныеПротокола) = Тип("Структура") Тогда
			
			ПротоколПроверки = Неопределено;
			Если ДанныеПротокола.Свойство("ТабличныйДокумент", ПротоколПроверки) И ТипЗнч(ПротоколПроверки) = Тип("ТабличныйДокумент") Тогда
				
				ОбластьОтчета = ТабличныйДокумент.Вывести(ПротоколПроверки);
				НачалоГруппировки = ОбластьОтчета.Верх+ПротоколПроверки.Области.ШапкаНижняяГраница.Верх;
				Если ОбластьОтчета.Низ >= НачалоГруппировки Тогда
					ОбластьГруппировки = ТабличныйДокумент.Область(НачалоГруппировки,,ОбластьОтчета.Низ);
					ОбластьГруппировки.Сгруппировать(,РасположениеЗаголовкаГруппировкиТабличногоДокумента.Начало);
				КонецЕсли;
				
			КонецЕсли;
			
			Значение = Неопределено;
			Если ДанныеПротокола.Свойство("ДанныеРасшифровки", Значение) И ТипЗнч(Значение) = Тип("Соответствие") Тогда
				
				Для каждого СтрокаСоответствия Из Значение Цикл
					
					ДанныеРасшифровки.Вставить(СтрокаСоответствия.Ключ, СтрокаСоответствия.Значение);
					
				КонецЦикла;
				
			КонецЕсли;
			
			ДанныеПротокола.Вставить("ОбъектИсточник",ОтчетОбъект.Ссылка);
		
			РеквизитыОтчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеПротокола.ОбъектИсточник,
				"ПериодОтчета,ИФО,ВидОтчета,ОписаниеАналитики,Организация,Ссылка");
			
			СтрокаПоОтчету = ДанныеОтобранныхОтчетов.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаПоОтчету,РеквизитыОтчета);
			СтрокаПоОтчету.ОтчетныйПериод		= РеквизитыОтчета.ПериодОтчета;
			СтрокаПоОтчету.ВсегоОшибок			= РезультатПроверкиОтчета.ВФОшибки + РезультатПроверкиОтчета.МФОшибки;
			СтрокаПоОтчету.ВсегоПредупреждений	= РезультатПроверкиОтчета.ВФПредупреждения + РезультатПроверкиОтчета.МФПредупреждения;
			
			ПротоколПроверкиПоОтчету = Новый Структура;
			ПротоколПроверкиПоОтчету.Вставить("ТабличныйДокумент",ДанныеПротокола.ТабличныйДокумент);
			ПротоколПроверкиПоОтчету.Вставить("ДанныеРасшифровки",ДанныеПротокола.ДанныеРасшифровки);
			СтрокаПоОтчету.ПротоколПроверки		= ПротоколПроверкиПоОтчету;
			
		ИначеЕсли ТипЗнч(ДанныеПротокола) = Тип("ТабличныйДокумент") Тогда
			
			ТабличныйДокумент.Вывести(ТабличныйДокумент);
			
		КонецЕсли;
		
	КонецЦикла;
	
	СтруктураДанныхПроверки = Новый Структура;
	СтруктураДанныхПроверки.Вставить("ТабличныйДокумент", ТабличныйДокумент);
	СтруктураДанныхПроверки.Вставить("ДанныеРасшифровки", ДанныеРасшифровки);
	СтруктураДанныхПроверки.Вставить("ДанныеОтобранныхОтчетов", ДанныеОтобранныхОтчетов);
	
	Результат = Новый Структура;
	Результат.Вставить("ПроверкаВыполненаУспешно",РезультатПроверкиОтчета.БезОшибок И РезультатПроверкиОтчета.БезПредупреждений);
	Результат.Вставить("БезОшибокРасчета",РезультатПроверкиОтчета.БезОшибокРасчета);
	Результат.Вставить("АдресДанныхПротокола", ПоместитьВоВременноеХранилище(СтруктураДанныхПроверки, Новый УникальныйИдентификатор));
	
	Возврат Результат;
	
КонецФункции // ПроверитьОтчет()
