#Область ПрограммныйИнтерфейс

Процедура ЗаполнитьОписанияИндикаторов(МассивИндикаторов, Знач ТипДокумента, Знач ОписаниеИндикатораПоУмолчанию) Экспорт
	
	Если ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьБСО")
		Или ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьНФА")
		Или ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьЦенныхБумаг")
		Или ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьНаличныхСредств") Тогда
		// Применяются два индикатора.
		
		ОписаниеИндикатора = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ОписаниеИндикатораПоУмолчанию);
		
		ОписаниеИндикатора.ИменаЭлементов.ГруппаИндикатора				= "ГруппаИндикаторКворумаПрисутствияРаздел2";
		ОписаниеИндикатора.ИменаЭлементов.КомиссияСсылка				= "Комиссия";
		ОписаниеИндикатора.ИменаЭлементов.ТабличнаяЧастьСоставКомиссии	= "СоставКомиссииРаздел2";
		ОписаниеИндикатора.ЭтоИнвентаризационнаяКомиссия				= Истина;
		
		МассивИндикаторов.Добавить(ОписаниеИндикатора);
		
		ОписаниеИндикатора = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ОписаниеИндикатораПоУмолчанию);
		
		ОписаниеИндикатора.ИменаЭлементов.ГруппаИндикатора				= "ГруппаИндикаторКворумаПрисутствияРаздел4";
		ОписаниеИндикатора.ИменаЭлементов.КомиссияСсылка				= "Комиссия";
		ОписаниеИндикатора.ИменаЭлементов.ТабличнаяЧастьСоставКомиссии	= "СоставКомиссииРаздел4";
		ОписаниеИндикатора.ЭтоИнвентаризационнаяКомиссия				= Истина;
		
		МассивИндикаторов.Добавить(ОписаниеИндикатора);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьРасчетовПоПоступлениям")
		Или ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьРасчетовСКонтрагентами")
		Или ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьОстатковНаСчетах")
		Или ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьГосДолгаВЦенныхБумагах")
		Или ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам")
		Или ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьГосДолгаПоПредоставленнымГарантиям")
		Или ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьКредитовИЗаймов")
		Или ТипДокумента = Тип("ДокументСсылка.АктОРезультатахИнвентаризацииНаличныхДС")
		Или ТипДокумента = Тип("ДокументСсылка.АктИнвентаризации")
		Или ТипДокумента = Тип("ДокументСсылка.АктОРезультатахИнвентаризации") Тогда
		// Комиссия считается инвентаризационной в целях расчета кворума присутствия.
		
		ОписаниеИндикатора = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ОписаниеИндикатораПоУмолчанию);
		
		ОписаниеИндикатора.ЭтоИнвентаризационнаяКомиссия = Истина;
		
		МассивИндикаторов.Добавить(ОписаниеИндикатора);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьТекстЗапросаКоличествоЧленовКомиссииВДокументах(ТекстЗапроса, Знач ТипДокумента) Экспорт
	
	Если ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьБСО") Тогда
		// 0510465
		ТекстЗапроса = ПолучитьТекстЗапросаКоличествоЧленовКомиссииВДокументах_ИнвентаризационнаяОписьБСО();
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьНФА") Тогда
		// 0510466
		ТекстЗапроса = ПолучитьТекстЗапросаКоличествоЧленовКомиссииВДокументах_ИнвентаризационнаяОписьНФА();
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьНаличныхСредств") Тогда
		// 0510467
		ТекстЗапроса = ПолучитьТекстЗапросаКоличествоЧленовКомиссииВДокументах_ИнвентаризационнаяОписьНаличныхСредств();
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьЦенныхБумаг") Тогда
		// 0510470
		ТекстЗапроса = ПолучитьТекстЗапросаКоличествоЧленовКомиссииВДокументах_ИнвентаризационнаяОписьЦенныхБумаг();
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьРезультатПроверкиДостиженияКворумаПрисутствия(РезультатПроверки, Знач ТипДокумента, Знач СведенияДокумента, Знач СведенияКомиссии) Экспорт
	
	Если ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьБСО")
		Или ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьНФА")
		Или ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьЦенныхБумаг")
		Или ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьНаличныхСредств") Тогда
		Кворум = ИндикаторКворумаПрисутствияКлиентСервер.ПолучитьКворумПрисутствияИнвентаризационнойКомиссииПоУмолчанию();
		
		ЕстьКворумПрисутствияРаздел2 = ИндикаторКворумаПрисутствияКлиентСервер.ЕстьКворумПрисутствия(
			СведенияДокумента.КоличествоСотрудниковВДокументеРаздел2,
			СведенияДокумента.КоличествоСотрудниковПрисутствуетРаздел2,
			Кворум);
		
		ЕстьКворумПрисутствияРаздел4 = ИндикаторКворумаПрисутствияКлиентСервер.ЕстьКворумПрисутствия(
			СведенияДокумента.КоличествоСотрудниковВДокументеРаздел4,
			СведенияДокумента.КоличествоСотрудниковПрисутствуетРаздел4,
			Кворум);
			
		КворумДостигнут = ЕстьКворумПрисутствияРаздел2 И ЕстьКворумПрисутствияРаздел4;
		
		Если Не ЕстьКворумПрисутствияРаздел4 Тогда
			ИмяПоляДляВыводаСообщения = "СоставКомиссииРаздел4";
		Иначе
			ИмяПоляДляВыводаСообщения = "СоставКомиссииРаздел2";
		КонецЕсли;
			
		РезультатПроверки.КворумДостигнут = КворумДостигнут;
		РезультатПроверки.ИмяПоляДляВыводаСообщения = ИмяПоляДляВыводаСообщения;
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьРасчетовПоПоступлениям")
		Или ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьОстатковНаСчетах") Тогда
		Кворум = ИндикаторКворумаПрисутствияКлиентСервер.ПолучитьКворумПрисутствияИнвентаризационнойКомиссииПоУмолчанию();
		
		РезультатПроверки.КворумДостигнут = ИндикаторКворумаПрисутствияКлиентСервер.ЕстьКворумПрисутствия(
			СведенияДокумента.КоличествоСотрудниковВДокументе,
			СведенияДокумента.КоличествоСотрудниковПрисутствует,
			Кворум);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДополнитьИсключаемыеДокументыПриПроверкеКворумаПрисутствия(ИсключаемыеДокументы, Список) Экспорт
	
	// СерииДокументов
	ИнвентаризацияСервер.ДополнитьИсключаемыеДокументыПриПроверкеКворумаПрисутствияДокументовСерии(ИсключаемыеДокументы, Список);
	// Конец СерииДокументов
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// 0510465
Функция ПолучитьТекстЗапросаКоличествоЧленовКомиссииВДокументах_ИнвентаризационнаяОписьБСО()
	
	Возврат "
	|ВЫБРАТЬ
	|	ДокументСсылка									КАК ДокументСсылка,
	|	КомиссияСсылка									КАК КомиссияСсылка,
	|	СУММА(КоличествоСотрудниковВДокументеРаздел2)	КАК КоличествоСотрудниковВДокументеРаздел2,
	|	СУММА(КоличествоСотрудниковПрисутствуетРаздел2)	КАК КоличествоСотрудниковПрисутствуетРаздел2,
	|	СУММА(КоличествоСотрудниковВДокументеРаздел4)	КАК КоличествоСотрудниковВДокументеРаздел4,
	|	СУММА(КоличествоСотрудниковПрисутствуетРаздел4)	КАК КоличествоСотрудниковПрисутствуетРаздел4
	|ИЗ
	|	(ВЫБРАТЬ
	|		Шапка.Ссылка										КАК ДокументСсылка,
	|		Шапка.Комиссия										КАК КомиссияСсылка,
	|		ЕСТЬNULL(КОЛИЧЕСТВО(ТЧСоставКомиссии.Ссылка), 0)	КАК КоличествоСотрудниковВДокументеРаздел2,
	|		ЕСТЬNULL(СУММА(ВЫБОР
	|			КОГДА НЕ ТЧСоставКомиссии.Отсутствует ТОГДА
	|				1
	|			ИНАЧЕ
	|				0
	|		КОНЕЦ), 0)											КАК КоличествоСотрудниковПрисутствуетРаздел2,
	|		0													КАК КоличествоСотрудниковВДокументеРаздел4,
	|		0													КАК КоличествоСотрудниковПрисутствуетРаздел4
	|	ИЗ
	|		Документ.ИнвентаризационнаяОписьБСО КАК Шапка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИнвентаризационнаяОписьБСО.СоставКомиссииРаздел2 КАК ТЧСоставКомиссии
	|			ПО	Шапка.Ссылка = ТЧСоставКомиссии.Ссылка
	|	ГДЕ
	|		Шапка.Ссылка В(&СписокДокументов)
	|	СГРУППИРОВАТЬ ПО
	|		Шапка.Ссылка,
	|		Шапка.Комиссия,
	|		0,
	|		0
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		Шапка.Ссылка										КАК ДокументСсылка,
	|		Шапка.Комиссия										КАК КомиссияСсылка,
	|		0													КАК КоличествоСотрудниковВДокументеРаздел2,
	|		0													КАК КоличествоСотрудниковПрисутствуетРаздел2,
	|		ЕСТЬNULL(КОЛИЧЕСТВО(ТЧСоставКомиссии.Ссылка), 0)	КАК КоличествоСотрудниковВДокументеРаздел4,
	|		ЕСТЬNULL(СУММА(ВЫБОР
	|			КОГДА НЕ ТЧСоставКомиссии.Отсутствует ТОГДА
	|				1
	|			ИНАЧЕ
	|				0
	|		КОНЕЦ), 0)											КАК КоличествоСотрудниковПрисутствуетРаздел4
	|	ИЗ
	|		Документ.ИнвентаризационнаяОписьБСО КАК Шапка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИнвентаризационнаяОписьБСО.СоставКомиссииРаздел4 КАК ТЧСоставКомиссии
	|			ПО	Шапка.Ссылка = ТЧСоставКомиссии.Ссылка
	|	ГДЕ
	|		Шапка.Ссылка В(&СписокДокументов)
	|	СГРУППИРОВАТЬ ПО
	|		Шапка.Ссылка,
	|		Шапка.Комиссия,
	|		0,
	|		0) КАК ВТ
	|СГРУППИРОВАТЬ ПО
	|	ДокументСсылка,
	|	КомиссияСсылка";
	
КонецФункции

