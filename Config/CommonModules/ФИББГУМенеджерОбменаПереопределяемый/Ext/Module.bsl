
// Процедура инициализирует запись регистра с датой регистрации изменений в бухгалтерском регистре.
//
// Параметры :
//	Запись - РегистрСведенийЗапись.ФИБОбменБГУРегистрацияЖурналПроводокЕПСБУ.
//
Процедура ИнициализироватьДатуРегистрации(Знач Запись) Экспорт
	Перем Отбор, Текст, МД, Таб;
	
	МД = НачалоДня(НачалоГода(ТекущаяДатаСеанса()) - 1);
	Если (МД <= Запись.ДатаРегистрации) Тогда
		Возврат;
	КонецЕсли;	
	Отбор = Новый Структура;
	Отбор.Вставить("Начало", Запись.ДатаРегистрации);
	Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	        |	ЕПСБУ.Период КАК Период
	        |ИЗ	РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ЕПСБУ
			|ГДЕ ЕПСБУ.Активность И (&Начало <= ЕПСБУ.Период)
			|УПОРЯДОЧИТЬ ПО ЕПСБУ.Период";
	Таб = ФИББГУМенеджерОбмена.ПолучитьДанные(Текст, Отбор);
	Если (Таб.Количество() = 0) Тогда
		Запись.ДатаРегистрации = ФИББГУМенеджерОбмена.ДатаГоризонта();
	Иначе
		Запись.ДатаРегистрации = Таб[0].Период;
	КонецЕсли;
	
КонецПроцедуры	

// Процедура увеличивает дату регистрации изменений в бухгалтерском регистре.
//
// Параметры :
//	ДатаРегистрации - Дата - новое значение даты регистрации.
//	ПервоеУвеличение - Булево - это первое увеличение даты регистрации.
//	ПериодРегистрацииВМесяцахЕПСБУ - Число - шаг периода регистрации в месяцах. 
//
Процедура УвеличитьДатуРегистрации(ДатаРегистрации, 
								   Знач ПервоеУвеличение,
								   Знач ПериодРегистрацииВМесяцахЕПСБУ) Экспорт
	
	Если (ПервоеУвеличение И (КонецГода(ДатаРегистрации) = КонецДня(ДатаРегистрации))) Тогда
		ДатаРегистрации = КонецДня(ДатаРегистрации) + 1;
	Иначе	
		ДатаРегистрации = НачалоДня(ДобавитьМесяц(ДатаРегистрации, ПериодРегистрацииВМесяцахЕПСБУ));
	КонецЕсли;	
	
КонецПроцедуры	

// Регистрация за период изменений в бухгалтерском регистре.
