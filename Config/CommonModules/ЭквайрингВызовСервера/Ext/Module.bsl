
// Функция выполняет получение параметров ЭТ.
//
Функция ПолучитьПараметрыЭТ(ЭквайринговыйТерминал) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЭквайринговыеТерминалы.ПодключаемоеОборудование КАК ИдентификаторУстройства,
	|	ЭквайринговыеТерминалы.ИспользоватьБезПодключенияОборудования КАК ИспользоватьБезПодключенияОборудования,
	|	ВЫБОР
	|		КОГДА ЭквайринговыеТерминалы.ИспользоватьУстройствоДляПечатиСлипЧеков
	|			ТОГДА ЭквайринговыеТерминалы.УстройствоПечатиСлипЧека
	|		ИНАЧЕ ЭквайринговыеТерминалы.ПодключаемоеОборудование
	|	КОНЕЦ КАК УстройствоПечатиСлипЧека,
	|	ЭквайринговыеТерминалы.ИспользоватьУстройствоДляПечатиСлипЧеков,
	|	ЭквайринговыеТерминалы.НеВводитьНомерПлатежнойКарты
	|ИЗ
	|	Справочник.ЭквайринговыеТерминалы КАК ЭквайринговыеТерминалы
	|ГДЕ
	|	ЭквайринговыеТерминалы.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ЭквайринговыйТерминал);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Возврат Новый Структура("ИдентификаторУстройства,
								|ИспользоватьБезПодключенияОборудования,
								|ИдентификаторУстройстваПечатиСлипЧека,
								|НеВводитьНомерПлатежнойКарты,
								|ИспользоватьУстройствоПечатиСлипЧека",
								Выборка.ИдентификаторУстройства,
								Выборка.ИспользоватьБезПодключенияОборудования,
								Выборка.УстройствоПечатиСлипЧека,
								Выборка.НеВводитьНомерПлатежнойКарты,
								Выборка.ИспользоватьУстройствоДляПечатиСлипЧеков
								
								
				);
		
	Иначе
		
		Возврат Новый Структура("ИдентификаторУстройства,
								|ИспользоватьБезПодключенияОборудования,
								|ИдентификаторУстройстваПечатиСлипЧека,
								|НеВводитьНомерПлатежнойКарты,
								|ИспользоватьУстройствоПечатиСлипЧека",
								Справочники.ПодключаемоеОборудование.ПустаяСсылка(),
								Истина,
								Справочники.ПодключаемоеОборудование.ПустаяСсылка(),
								Ложь,
								Ложь
				);
		
	КонецЕсли;
	
КонецФункции

Функция ПолучитьНастройкиОборудованияЭквайринга(РабочееМесто, Организация = Неопределено) Экспорт
	
	СтруктураДанныхЭквайринга = Новый Структура("ПДЭ,ЭТ,ФР");
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	НастройкиЭквайрингаДляРабочихМест.ПараметрыДоговораЭквайринга,
	|	НастройкиЭквайрингаДляРабочихМест.ЭквайринговыйТерминал,
	|	НастройкиЭквайрингаДляРабочихМест.ФискальныйРегистратор,
	|	НастройкиЭквайрингаДляРабочихМест.ПараметрыДоговораПлатежногоАгента КАК ПараметрыДоговораПлатежногоАгента
	|ИЗ
	|	РегистрСведений.НастройкиЭквайрингаДляРабочихМест КАК НастройкиЭквайрингаДляРабочихМест
	|ГДЕ
	|	НастройкиЭквайрингаДляРабочихМест.РабочееМесто = &РабочееМесто
	|	И ИСТИНА";
	
	Если ОбщегоНазначенияБГУПовтИсп.ЗначениеФункциональнойОпции("ИспользоватьЦентрализованнуюБухгалтерию") Тогда
		Если НЕ Организация = Неопределено Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И ИСТИНА", "И НастройкиЭквайрингаДляРабочихМест.Организация = &Организация");
		КонецЕсли;
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("РабочееМесто", РабочееМесто);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		СтруктураДанныхЭквайринга.Вставить("ПДЭ", Выборка.ПараметрыДоговораЭквайринга);
		СтруктураДанныхЭквайринга.Вставить("ЭТ", Выборка.ЭквайринговыйТерминал);
		СтруктураДанныхЭквайринга.Вставить("ФР", Выборка.ФискальныйРегистратор);
		СтруктураДанныхЭквайринга.Вставить("ПараметрыДоговораПлатежногоАгента", Выборка.ПараметрыДоговораПлатежногоАгента);
	Иначе
		СтруктураДанныхЭквайринга.Вставить("ПДЭ", Справочники.ПараметрыДоговораЭквайринга.ПустаяСсылка());
		СтруктураДанныхЭквайринга.Вставить("ЭТ", Справочники.ЭквайринговыеТерминалы.ПустаяСсылка());
		СтруктураДанныхЭквайринга.Вставить("ФР", Справочники.ФискальныеРегистраторы.ПустаяСсылка());
		СтруктураДанныхЭквайринга.Вставить("ПараметрыДоговораПлатежногоАгента", Справочники.ПараметрыДоговораПлатежногоАгента.ПустаяСсылка());
	КонецЕсли;
	
	Возврат СтруктураДанныхЭквайринга;
	
КонецФункции

// Функция возвращает процент торговой уступки для переданных
// договора эквайринга и вида оплаты - платежная карта.
//
// Параметры:
//  ДоговорЭквайринга - договор эквайринга, по которому нужно получить % торговой уступки.
//  ВидОплаты - вид оплаты, для которого  нужно получить % торговой уступки.
//
// Возвращаемое значение:
//  Число. Процент торговой уступки. 0 - если не найден.
//
Функция ПолучитьПроцентТорговойУступкиПлатежнаяКарта(ПараметрыДоговораЭквайринга, ВидПлатежнойКарты) Экспорт
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Тарифы.ПроцентТорговойУступки КАК ПроцентТорговойУступки
	|ИЗ
	|	Справочник.ПараметрыДоговораЭквайринга.ТарифыЗаРасчетноеОбслуживание КАК Тарифы
	|ГДЕ
	|	Тарифы.Ссылка = &ПараметрыДоговораЭквайринга
	|	И Тарифы.ВидПлатежнойКарты = &ВидПлатежнойКарты
	|");
		
	Запрос.УстановитьПараметр("ПараметрыДоговораЭквайринга", ПараметрыДоговораЭквайринга);
	Запрос.УстановитьПараметр("ВидПлатежнойКарты", ВидПлатежнойКарты);
		
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ПроцентТорговойУступки = Выборка.ПроцентТорговойУступки;
	Иначе
		ПроцентТорговойУступки = 0;
	КонецЕсли;

	Возврат ПроцентТорговойУступки;

КонецФункции

Функция ПолучитьПараметрыФР(ФискальныйРегистратор) Экспорт
	СтруктураДанныхФР = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ФискальныйРегистратор, "ПодключаемоеОборудование, ИспользоватьБезПодключенияОборудования");
	
	Возврат СтруктураДанныхФР;
КонецФункции	

Функция ПолучитьДанныеВидаКартыДоговораЭквайринга(ПараметрыДоговораЭквайринга, ВидКарты = Неопределено) Экспорт
	Результат = Неопределено;
	
	Если НЕ ЗначениеЗаполнено(ПараметрыДоговораЭквайринга) Тогда
		Возврат Результат;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Если ЗначениеЗаполнено(ВидКарты) Тогда
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПараметрыДоговораЭквайрингаТарифыЗаРасчетноеОбслуживание.ВидПлатежнойКарты КАК ВидПлатежнойКарты,
		|	ПараметрыДоговораЭквайрингаТарифыЗаРасчетноеОбслуживание.ПроцентТорговойУступки КАК ПроцентТорговойУступки,
		|	ПараметрыДоговораЭквайрингаТарифыЗаРасчетноеОбслуживание.СтавкаНДССКомисии КАК СтавкаНДССКомисии,
		|	ПараметрыДоговораЭквайрингаТарифыЗаРасчетноеОбслуживание.НДССКомиссииСверху КАК НДССКомиссииСверху
		|ИЗ
		|	Справочник.ПараметрыДоговораЭквайринга.ТарифыЗаРасчетноеОбслуживание КАК ПараметрыДоговораЭквайрингаТарифыЗаРасчетноеОбслуживание
		|ГДЕ
		|	ПараметрыДоговораЭквайрингаТарифыЗаРасчетноеОбслуживание.Ссылка = &ПараметрыДоговораЭквайринга
		|	И ПараметрыДоговораЭквайрингаТарифыЗаРасчетноеОбслуживание.ВидПлатежнойКарты = &ВидПлатежнойКарты";	
	Иначе	
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПараметрыДоговораЭквайрингаТарифыЗаРасчетноеОбслуживание.ВидПлатежнойКарты КАК ВидПлатежнойКарты,
		|	ПараметрыДоговораЭквайрингаТарифыЗаРасчетноеОбслуживание.ПроцентТорговойУступки КАК ПроцентТорговойУступки,
		|	ПараметрыДоговораЭквайрингаТарифыЗаРасчетноеОбслуживание.СтавкаНДССКомисии КАК СтавкаНДССКомисии,
		|	ПараметрыДоговораЭквайрингаТарифыЗаРасчетноеОбслуживание.НДССКомиссииСверху КАК НДССКомиссииСверху
		|ИЗ
		|	Справочник.ПараметрыДоговораЭквайринга.ТарифыЗаРасчетноеОбслуживание КАК ПараметрыДоговораЭквайрингаТарифыЗаРасчетноеОбслуживание
		|ГДЕ
		|	ПараметрыДоговораЭквайрингаТарифыЗаРасчетноеОбслуживание.ОсновнойВид = ИСТИНА
		|	И ПараметрыДоговораЭквайрингаТарифыЗаРасчетноеОбслуживание.Ссылка = &ПараметрыДоговораЭквайринга";	
	КонецЕсли;	
		
	Запрос.УстановитьПараметр("ПараметрыДоговораЭквайринга", ПараметрыДоговораЭквайринга);
	Запрос.УстановитьПараметр("ВидПлатежнойКарты", ВидКарты);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Новый Структура;
		Результат.Вставить("ВидПлатежнойКарты",Выборка.ВидПлатежнойКарты);
		Результат.Вставить("ПроцентТорговойУступки",Выборка.ПроцентТорговойУступки);
		Результат.Вставить("СтавкаНДССКомисии",Выборка.СтавкаНДССКомисии); 
		Результат.Вставить("НДССКомиссииСверху",Выборка.НДССКомиссииСверху);
	КонецЕсли;	
		
	Возврат Результат;
КонецФункции	

Функция ПолучитьМассивВидовПлатежныхКарт(ПараметрыДоговораЭквайринга) Экспорт
	Результат = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(ПараметрыДоговораЭквайринга) Тогда
		Возврат Результат;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПараметрыДоговораЭквайрингаТарифыЗаРасчетноеОбслуживание.ВидПлатежнойКарты
	|ИЗ
	|	Справочник.ПараметрыДоговораЭквайринга.ТарифыЗаРасчетноеОбслуживание КАК ПараметрыДоговораЭквайрингаТарифыЗаРасчетноеОбслуживание
	|ГДЕ
	|	ПараметрыДоговораЭквайрингаТарифыЗаРасчетноеОбслуживание.Ссылка = &ПараметрыДоговораЭквайринга";	
		
	Запрос.УстановитьПараметр("ПараметрыДоговораЭквайринга", ПараметрыДоговораЭквайринга);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Результат = РезультатЗапроса.ВыгрузитьКолонку("ВидПлатежнойКарты");
	
	Возврат Результат;
КонецФункции	

Функция ПолучитьМассивТерминалов(ПараметрыДоговораЭквайринга) Экспорт
	Результат = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(ПараметрыДоговораЭквайринга) Тогда
		Возврат Результат;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПараметрыДоговораЭквайрингаТерминалы.ЭквайринговыйТерминал
	|ИЗ
	|	Справочник.ПараметрыДоговораЭквайринга.Терминалы КАК ПараметрыДоговораЭквайрингаТерминалы
	|ГДЕ
	|	ПараметрыДоговораЭквайрингаТерминалы.Ссылка = &ПараметрыДоговораЭквайринга";	
		
	Запрос.УстановитьПараметр("ПараметрыДоговораЭквайринга", ПараметрыДоговораЭквайринга);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Результат = РезультатЗапроса.ВыгрузитьКолонку("ЭквайринговыйТерминал");
	
	Возврат Результат;
КонецФункции	

Функция ПолучитьМассивИсточниковСредств(ПараметрыДоговораЭквайринга) Экспорт
	Результат = ПлатежноРасчетныеДокументыПовтИсп.ДопустимыеИсточникиСредств(ПараметрыДоговораЭквайринга.ЛицевойСчет);
	
	Возврат Результат;
КонецФункции
