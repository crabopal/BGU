#Область ПрограммныйИнтерфейс

// В переданной коллекции заменяет детальные КЭК 34х/44х на групповые 340/440.
// Перед заменой проверяется применение детальных КЭК на дату. Если применяется детальный КЭК,
// то замена не производится.
//
// Параметры:
//  Коллекция	 - ТаблицаЗначений
//               - Табличная часть - 
//  ИменаКолонок - Массив из Строка - имена колонок, содержащих КЭК, который нужно заменять
//  Дата		 - Дата - дата для проверки применения детальных КЭК
//  Организация	 - Организация - организация для проверки применения детальных КЭК
//
Процедура ЗаменитьДетальныйКЭК340_440(Коллекция, ИменаКолонок, Дата, Организация) Экспорт
	
	Если БухгалтерскийУчетКлиентСервер.ПрименяетсяДетальныйКЭК340и440(Дата, Организация) Тогда
		Возврат;
	КонецЕсли;
	
	КЭКДляЗамены = КЭКДляЗамены340_440();
	КЭК340 = КЭКДляЗамены.Групповой340;
	КЭК440 = КЭКДляЗамены.Групповой440;
	Детальные340 = КЭКДляЗамены.Детальные340;
	Детальные440 = КЭКДляЗамены.Детальные440;
	Для Каждого ЭлементКоллекции Из Коллекция Цикл
		Для Каждого ИмяКолонки Из ИменаКолонок Цикл
			Если Детальные340.Получить(ЭлементКоллекции[ИмяКолонки]) <> Неопределено Тогда
				ЭлементКоллекции[ИмяКолонки] = КЭК340;
			ИначеЕсли Детальные440.Получить(ЭлементКоллекции[ИмяКолонки]) <> Неопределено Тогда
				ЭлементКоллекции[ИмяКолонки] = КЭК440;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

// Устанавливает доступность полей аналитики счета в таблице формы.
// Обрабатываются все строки табличной части. Устанавливаются колонки таблицы, относящиеся к одной колонке счета,
// указанной в параметре ИмяКолонкиСчет.
// Каждый ключ структуры ПоляАналитики обрабатывается функцией РасшифроватьОписаниеПоляАналитикиСчета.
// 
// Параметры:
//  ТабличнаяЧасть - ДанныеФормыКоллекция
//  ИмяКолонкиСчет - Строка - имя колонки табличной части
//  ПоляАналитики - Структура - может содержать свойства:
//   * Субконто1 - Строка
//   * Субконто2 - Строка
//   * Субконто3 - Строка
//   * Подразделение - Строка
//   * КПС - Строка
//   * КЭК - Строка
Процедура УстановитьДоступностьПолейАналитикиСчетаВТаблице(ТабличнаяЧасть, ИмяКолонкиСчет, ПоляАналитики) Экспорт
	// Собрать уникальные счета из колонки таблицы
	ВременнаяТаблица = ТабличнаяЧасть.Выгрузить(,ИмяКолонкиСчет); // ТаблицаЗначений
	ВременнаяТаблица.Свернуть(ИмяКолонкиСчет);
	ИспользуемыеСчета = ВременнаяТаблица.ВыгрузитьКолонку(ИмяКолонкиСчет);
	
	// Заполнить структуры свойств строки по каждому счету для дальнейшего заполнения в строках
	ДанныеПоВсемСчетам = Новый Соответствие;
	Для Каждого Счет Из ИспользуемыеСчета Цикл
		Если ЗначениеЗаполнено(Счет) Тогда
			ДанныеПоВсемСчетам.Вставить(Счет,
				БухгалтерскийУчетКлиентСервер.СвойстваПолейАналитикиСчета(Счет, ПоляАналитики));
		КонецЕсли;
	КонецЦикла;
	
	// Заполнить значения свойств счетов в табличную часть
	Для Каждого СтрокаТаблицы Из ТабличнаяЧасть Цикл
		ДанныеДляЗаполнения = ДанныеПоВсемСчетам[СтрокаТаблицы[ИмяКолонкиСчет]];
		Если ДанныеДляЗаполнения <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ДанныеДляЗаполнения);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Установить дату проведения документа в колонку "Период" в таблицах для проведения.
// Может вызываться из процедуры ИнициализироватьДанныеДокумента модуля менеджера документа.
// 
// Если в параметре "ПериодИлиСсылка" передана ссылка на документ, то дата проведения будет получена автоматически.
// Если переданная дата или полученная дата проведения пустая, то обработка таблиц не производится.
//
// ВАЖНО. Если передана ссылка документа, не включенного в определяемый тип "ДокументыСОтдельнойДатойПроведения",
// будет выборошено исключение.
// 
// Если параметры "ИменаТаблиц" и "ИменаТаблицИсключений" не заданы, то значение будет установлено во всех таблицах,
// имеющих колонку "Период".
// 
// Если в параметре "ИменаТаблиц" переданы имена таблиц, то установка колонки "Период" будет только в этих таблицах.
// Ожидается, что в структуре ТаблицыДляДвижений есть ключ на каждое переданное имя таблицы и в этих таблицах есть
// колонка "Период".
// 
// Если в параметре "ИменаТаблицИсключений" переданы имена таблиц, то значение будет установлено во всех таблицах,
// имеющих колонку "Период", за исключением переданных. Все переданные имена таблиц должны существовать в ключах
// структуры "ТаблицыДляДвижений".
// 
// Не допускается одновременная передача параметров "ИменаТаблиц" и "ИменаТаблицИсключений".
// 
// Параметры:
//  ТаблицыДляДвижений - Структура из ТаблицаЗначений
//  ПериодИлиСсылка - Дата - дата, которую нужно установить в таблицы для движений.
//  				- ДокументСсылка - документ, дату проведения которого нужно установить в таблицы для движений.
//  ИменаТаблиц - Строка - Имена таблиц, в которых нужно установить период. Все переданные имена должны существовать
//                         в ключах структуры ТаблицыДляДвижений. В каждой таблице должна быть колонка "Период".
//  ИменаТаблицИсключений - Строка - Имена таблиц исключений, в которых не нужно устанавливать период.
//                                   Все переданные имена должны существовать в ключах структуры ТаблицыДляДвижений.
//  
// Пример:
// 1. Установить переданную дату в поле "Период" всех таблиц 
//  БухгалтерскийУчет.УстановитьПериодВТаблицахДляПроведения(ТаблицыДляДвижений, ЗначениеДаты);
//    
// 2. Установить дату проведения документа в поле "Период" всех таблиц 
//  БухгалтерскийУчет.УстановитьПериодВТаблицахДляПроведения(ТаблицыДляДвижений, СсылкаНаДокумент);
//        
// 3. Установить дату проведения документа в поле "Период" таблицы "НаличиеДрагМатериаловВОбъектахНФА" 
//  БухгалтерскийУчет.УстановитьПериодВТаблицахДляПроведения(ТаблицыДляДвижений, СсылкаНаДокумент,
//  	"НаличиеДрагМатериаловВОбъектахНФА");
//        
// 4. Установить дату проведения документа в поле "Период" всех таблиц кроме "НаличиеДрагМатериаловВОбъектахНФА" 
//  БухгалтерскийУчет.УстановитьПериодВТаблицахДляПроведения(ТаблицыДляДвижений, СсылкаНаДокумент,
//  	"НаличиеДрагМатериаловВОбъектахНФА");
//
Процедура УстановитьПериодВТаблицахДляПроведения(ТаблицыДляДвижений, Знач ПериодИлиСсылка, ИменаТаблиц = "", ИменаТаблицИсключений = "") Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьОтдельнуюДатуПроведенияДокументов") Тогда
		Возврат;
	КонецЕсли;
	
	// Проверка параметров
		
	Если ПериодИлиСсылка = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'В процедуре БухгалтерскийУчет.УстановитьПериодВТаблицахДляПроведения не задан параметр ""ПериодИлиСсылка"".'");
	КонецЕсли;
	Если ТипЗнч(ПериодИлиСсылка) <> Тип("Дата")
			И Не Метаданные.ОпределяемыеТипы.ДокументыСОтдельнойДатойПроведения.Тип.СодержитТип(ТипЗнч(ПериодИлиСсылка)) Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Не правильный тип параметра ""ПериодИлиСсылка"": %1'"),
			ТипЗнч(ПериодИлиСсылка));
	КонецЕсли;
	Если ЗначениеЗаполнено(ИменаТаблиц) И ЗначениеЗаполнено(ИменаТаблицИсключений) Тогда
		ВызватьИсключение НСтр("ru = 'В процедуре БухгалтерскийУчет.УстановитьПериодВТаблицахДляПроведения одновременно заполнены параметры ""ИменаТаблиц"" и ""ИменаТаблицИсключений"".'");
	КонецЕсли;

	Таблица = Новый ТаблицаЗначений;
	ОбрабатываемыеТаблицы = Новый Массив; // Массив из ТаблицаЗначений
	Если ЗначениеЗаполнено(ИменаТаблиц) Тогда
		Для Каждого ИмяТаблицы Из СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(ИменаТаблиц) Цикл
			Если Не ТаблицыДляДвижений.Свойство(ИмяТаблицы, Таблица) Тогда
				ВызватьИсключение СтрШаблон(НСтр("ru = 'Не обнаружена таблица для проведения ""%1""'"), ИмяТаблицы);
			КонецЕсли;
			Если Таблица.Колонки.Найти("Период") = Неопределено Тогда
				ВызватьИсключение СтрШаблон(НСтр("ru = 'В таблице ""%1"" не обнаружена колонка ""Период"".'"),
					ИмяТаблицы);
			КонецЕсли;
			ОбрабатываемыеТаблицы.Добавить(Таблица);
		КонецЦикла;
	Иначе
		Если ЗначениеЗаполнено(ИменаТаблицИсключений) Тогда
			ТаблицыИсключения = Новый Структура(ИменаТаблицИсключений);
		Иначе
			ТаблицыИсключения = Новый Структура;
		КонецЕсли;
		// Постоянные исключения имен таблиц добавляются всегда, если в таблицах для движений есть указанные таблицы.
		Для Каждого ИмяИсключения Из ИсключенияИзУстановкиПериодаВТаблицахДляПроведения() Цикл
			Если ТаблицыДляДвижений.Свойство(ИмяИсключения) Тогда
				ТаблицыИсключения.Вставить(ИмяИсключения);
			КонецЕсли;
		КонецЦикла;
		Для Каждого КлючЗначение Из ТаблицыДляДвижений Цикл
			Если Не ТаблицыИсключения.Свойство(КлючЗначение.Ключ) Тогда
				Если КлючЗначение.Значение.Колонки.Найти("Период") <> Неопределено Тогда
					ОбрабатываемыеТаблицы.Добавить(КлючЗначение.Значение);
				КонецЕсли;
			Иначе
				ТаблицыИсключения.Удалить(КлючЗначение.Ключ);
			КонецЕсли;
		КонецЦикла;
		Если ТаблицыИсключения.Количество() > 0 Тогда
			ИменаОтсутствующихТаблиц = ОбщегоНазначенияКлиентСервер.КлючиСтруктурыВСтроку(ТаблицыИсключения);
			ВызватьИсключение СтрШаблон(НСтр("ru = 'Не обнаружены таблицы-исключения: %1'"), ИменаОтсутствующихТаблиц);
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(ПериодИлиСсылка) = Тип("Дата") Тогда
		Период = ПериодИлиСсылка;
	Иначе
		Период = УстановленнаяДатаПроведения(ПериодИлиСсылка);
	КонецЕсли;
	
	// Обработка таблиц

	Если Не ЗначениеЗаполнено(Период) Тогда
		// Отдельная дата проведения не установлена.
		// Период в таблицах менять не требуется.
		Возврат;
	КонецЕсли;
	
	Для Каждого Таблица Из ОбрабатываемыеТаблицы Цикл
		Таблица.ЗаполнитьЗначения(Период, "Период");
	КонецЦикла;	

КонецПроцедуры

// Дата проведения документа, установленная пользователем.
// Если дата не заполнена или документа нет в определяемом типе ДокументыСОтдельнойДатойПроведения, возвращается пустая дата.
// Полученный результат кэшируется на время вызова. Кэширование управляется параметром "ИспользоватьКэширование".
// Если в течение вызова сервера меняется значение установленной даты, то получать значение нужно без использования кэширования.
// 
// Параметры:
//  Ссылка - ОпределяемыйТип.ДокументыСОтдельнойДатойПроведения
//  ИспользоватьКэширование - Булево - кэшировать полученное значение через модуль повторного использования на время вызова
// 
// Возвращаемое значение:
//  Дата 
Функция УстановленнаяДатаПроведения(Ссылка, ИспользоватьКэширование = Истина) Экспорт
	Если ИспользоватьКэширование Тогда
		Возврат БухгалтерскийУчетПовтИспНаВремяВызова.УстановленнаяДатаПроведения(Ссылка);
	Иначе
		Возврат РегистрыСведений.ДатыПроведенияДокументов.УстановленнаяДатаПроведения(Ссылка);
	КонецЕсли;
КонецФункции

// Возвращает дату актульности плана счетов с учетом начала применения Организацией
//
Функция ДатаАктуальностиСчетов(Знач НаДатуДок = Неопределено, Знач Организация = Неопределено) Экспорт
	
	ДатаПерехода = '00010101'; 
	
	Если ТипЗнч(НаДатуДок) = Тип("Граница") Тогда
		НаДату = НаДатуДок.Значение;
		Если ТипЗнч(НаДату) = Тип("МоментВремени") Тогда
			НаДату = НаДату.Дата;
		КонецЕсли;	
	ИначеЕсли ТипЗнч(НаДатуДок) = Тип("МоментВремени") Тогда
	    НаДату = НаДатуДок.Дата;
	Иначе
		НаДату = НаДатуДок;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Организация) Тогда
		
		Если НаДату = Неопределено Тогда
			НаДату = ТекущаяДатаСеанса();
		КонецЕсли;
		
		ДатаПерехода = БухгалтерскийУчетПовтИсп.ДатаПереходаНаРедакциюПС(Организация, НачалоГода(НаДату));
		Если НЕ ЗначениеЗаполнено(ДатаПерехода) Тогда
			// если на новый ПС не переходили  - используем только старые счета
			ДатаПерехода = КонецГода(НаДату);
		КонецЕсли;	
		
	КонецЕсли;	
	
	Если ТипЗнч(НаДату) = Тип("Дата") Тогда
		
		// Чтобы избежать избыточного кэширования, определим актуальный счет на ближайшую дату изменения плана счетов.
		ДатыИзмененияПланаСчетов = БухгалтерскийУчетПовтИсп.ДатыИзмененияПланаСчетов();
		Для Каждого ДатаИзмененияПланаСчетов Из ДатыИзмененияПланаСчетов Цикл
			Если Макс(ДатаИзмененияПланаСчетов, ДатаПерехода) <= НаДату Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		ДатаАктуальностиСчетов = ДатаИзмененияПланаСчетов;
		
	Иначе // Организация не заполнена, НаДату = Неопределено и т.п.
		
		ДатаАктуальностиСчетов = НаДату;
		
	КонецЕсли;

	Возврат ДатаАктуальностиСчетов;
	
КонецФункции	

Функция ДатаПереходаНаРедакциюПС(Знач Организация, Знач НаДату) Экспорт
	
	//для оптимизации кэша приведем дату к началу года
	Возврат БухгалтерскийУчетПовтИсп.ДатаПереходаНаРедакциюПС(Организация, НачалоГода(НаДату));
	
КонецФункции	

Функция ПрименяетсяПриказ209н(Знач НаДату, Знач Организация) Экспорт
	
	Если НаДату < Дата('20190101') Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат НаДату >= БухгалтерскийУчетПовтИсп.ДатаПереходаНаРедакциюПС(Организация, НачалоГода(НаДату));
	
КонецФункции

//Возвращает КЭК счета по дебету или кредиту, в случае использования счетов уменьшений/увеличений или КЭК операции
//
Функция КЭКСчета(Организация, ИФО = Неопределено, КФО = Неопределено, НаДату, КодСчета, ДтКт="Дт", КЭКОперации = Неопределено, ДопустимыеКЭКСчета = Неопределено) Экспорт
	
	Если ТипЗнч(КодСчета) = Тип("Строка") Тогда
		Счет = СчетПоКоду(КодСчета, НаДату, Организация);
	ИначеЕсли ОбщегоНазначения.ЗначениеСсылочногоТипа(КодСчета) И ОбщегоНазначения.ВидОбъектаПоСсылке(КодСчета) = "ПланСчетов" Тогда
		Счет = КодСчета;
	Иначе
		Счет = ПланыСчетов.ЕПСБУ.ПустаяСсылка()
	КонецЕсли;
	
	Если Счет.Пустая() Тогда
		Возврат Справочники.КОСГУ.ПустаяСсылка();
	КонецЕсли;
	
	ДопустимыеКЭКСчета = БухгалтерскийУчетПовтИсп.ДопустимыеКЭКСчета(Счет);
	
	Если ДопустимыеКЭКСчета.Количество() > 2 Тогда
		
		Если ДопустимыеКЭКСчета.Найти(КЭКОперации) = Неопределено Тогда
			Возврат Справочники.КОСГУ.ПустаяСсылка();
		КонецЕсли;
		
		Возврат КЭКОперации;
		
	КонецЕсли;
	
	Если БухгалтерскийУчетПовтИсп.ТипКЭКПоУчетнойПолитике(Организация, ИФО, КФО, НаДату) = Перечисления.ТипыАналитическихПризнаков.ПроизвольнаяКлассификация Тогда
		
		Возврат БухгалтерскийУчетПовтИсп.КЭК0();
		
	КонецЕсли;
	
	Если НаДату < '20180101' И СчетВИерархии(Счет, "104.00") Тогда
		Если СчетВИерархии(Счет, "104.29,104.39,104.49,104.59") Тогда
			КодКЭК = "420";
		Иначе
			КодКЭК = "410";
		КонецЕсли;
		Возврат Справочники.КОСГУ.НайтиПоКоду(КодКЭК);
	КонецЕсли;
	
	Если ДтКт="Дт" Тогда
		
		Если ЗначениеЗаполнено(КЭКОперации)
			И Счет.КОСГУДт <> КЭКОперации
			И КЭКОперации.ПринадлежитЭлементу(Счет.КОСГУДт) Тогда
			Возврат КЭКОперации;
		КонецЕсли;
		
		Возврат Счет.КОСГУДт;
		
	Иначе
		
		Если ЗначениеЗаполнено(КЭКОперации)
			И Счет.КОСГУКт <> КЭКОперации
			И КЭКОперации.ПринадлежитЭлементу(Счет.КОСГУКт) Тогда
			Возврат КЭКОперации;
		КонецЕсли;
		
		Возврат Счет.КОСГУКт;
		
	КонецЕсли;
	
КонецФункции

// Определяет КЭК дебета или кредита в зависимости от учетной политики и используемой аналитики счета.
// Возвращает КЭК увеличения или уменьшения.
// Если заполнен КЭКОперации и у счета больше 2 разрешенных КЭК, то проверяет можно ли использовать этот КЭК с этим счетом.
// Если КЭК нельзя использовать со счетом, то возвращает пустое значение, иначе сам этот КЭК.
// Вызывается из проводок типовых операций.
// Структура ДанныеПроводки (см. БухгалтерскийУчетКлиентСервер.ПараметрыРасчетаКЭКПроводки())
//
// Параметры:
//  ДанныеПроводки	 - Структура - Структура с ключами:
//		*Организация - СправочникСсылка.Организации
//		*ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения
//		*КФО - ПеречислениеСсылка.КВД
//		*Дата - Дата
//		*Счет - ПланСчетовСсылка.ЕПСБУ
//		*Субконто1 - Характеристика.ВидыСубконто
//		*Субконто2 - Характеристика.ВидыСубконто
//		*Субконто3 - Характеристика.ВидыСубконто
//		*ДтКт - Строка - Сторона проводки "Дт" или "Кт"
//		*КЭКОперации - СправочникСсылка.КОСГУ - 
// 
// Возвращаемое значение:
// СправочникСсылка.КОСГУ - 
//
Функция КЭКПроводки(ДанныеПроводки) Экспорт
	
	Перем ДопустимыеКЭКСчета;  
	ДопКЭК = Неопределено;
	
	КОСГУ = КЭКСчета(ДанныеПроводки.Организация,
		ДанныеПроводки.ИФО,
		ДанныеПроводки.КФО,
		ДанныеПроводки.Дата,
		ДанныеПроводки.Счет,
		ДанныеПроводки.ДтКт,
		ДанныеПроводки.КЭКОперации,
		ДопустимыеКЭКСчета);
		
	Если НЕ ТипЗнч(ДопустимыеКЭКСчета) = Тип("Массив") ИЛИ ДопустимыеКЭКСчета.Количество() = 0 Тогда
		// Далее ничего не проверяем и не вычисляем - у счета нет допустимых КОСГУ
		Возврат КОСГУ;
	КонецЕсли;
	
	КОСГУКонтрагенты   = БухгалтерскийУчетКлиентСервер.КОСГУКонтрагенты();
	КОСГУМатериалы     = БухгалтерскийУчетКлиентСервер.КОСГУМатериалы();
	
	КодКОСГУ = ?(ЗначениеЗаполнено(КОСГУ), ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КОСГУ, "Код"), "-");
	
	БезДетализацииКОСГУ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеПроводки.Счет, "БезДетализацииКОСГУ");
	
	КОСГУНов = Неопределено;
	
	Если БезДетализацииКОСГУ Или НЕ ПрименяетсяПриказ209н(ДанныеПроводки.Дата, ДанныеПроводки.Организация) Тогда
		
		Если НЕ Прав(КодКОСГУ, 1) = "0" И СтрНайти(КОСГУКонтрагенты, Лев(КодКОСГУ, 2) + "0") > 0 Тогда
			КОСГУНов = БухгалтерскийУчетПовтИсп.КЭКПоКоду(Лев(КодКОСГУ, 2) + "0");
			Возврат КОСГУНов;
		КонецЕсли;
		
		Возврат КОСГУ;
		
	Иначе
		
		ЭтоКЭКМатериалов = Ложь;
		Если СчетВИерархии(ДанныеПроводки.Счет, "304.66,304.76,304.86,304.96") Тогда
			
			КодСтатьи = КодСтатьиОрганизации(ДанныеПроводки.Организация, ДанныеПроводки.Дата);
			КОСГУНов = БухгалтерскийУчетПовтИсп.КЭКПоКоду(Лев(КодКОСГУ, 2) + КодСтатьи);
			
		ИначеЕсли СтрНайти(КОСГУКонтрагенты, КодКОСГУ) > 0 Тогда
			
			//Определяем подстатью по типу контрагента
			Контрагент = ЗначениеСубконтоПроводкиПоТипу(ДанныеПроводки, Тип("СправочникСсылка.Контрагенты"));
			
			Если Контрагент = Неопределено Тогда
				ОбъектФинансовыхВложений = ЗначениеСубконтоПроводкиПоТипу(ДанныеПроводки, Тип("СправочникСсылка.ОбъектыФинансовыхВложений"));
				Если ОбъектФинансовыхВложений <> Неопределено Тогда
					Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбъектФинансовыхВложений, "Контрагент");
				КонецЕсли;
			КонецЕсли;
			
			Если НЕ Контрагент = Неопределено Тогда
				
				КодСтатьи = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент, "ТипКонтрагента.Код");
				
				Если ЗначениеЗаполнено(КодСтатьи) Тогда
					
					НовыйКодКОСГУ = ?(ДанныеПроводки.ВводОстатков = Истина, "00", Лев(КодКОСГУ, 2)) + КодСтатьи;
					НовыйКОСГУ = БухгалтерскийУчетПовтИсп.КЭКПоКоду(НовыйКодКОСГУ);
					
					Если ЗначениеЗаполнено(НовыйКОСГУ) Тогда
						КОСГУНов = НовыйКОСГУ; 
						Если ДанныеПроводки.ВводОстатков = Истина Тогда
							ДопКЭК = КОСГУНов; 
						КонецЕсли;	
					КонецЕсли;
					
				КонецЕсли;
			КонецЕсли;
			
		ИначеЕсли СтрНайти(КОСГУМатериалы, КодКОСГУ) > 0 Тогда
			ЭтоКЭКМатериалов = Истина;
			
		ИначеЕсли СчетВИерархии(ДанныеПроводки.Счет, "106.60") Тогда
			
			КапВложение = ЗначениеСубконтоПроводкиПоТипу(ДанныеПроводки, Тип("СправочникСсылка.ОсновныеСредства"));
			
			Если КапВложение <> Неопределено Тогда
				
				УчетныеДанные = УправлениеОсновнымиСредствами.ДанныеОбъектаОС(КапВложение, ДанныеПроводки.Дата);
				КодКЭК = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УчетныеДанные.КЭКВложений, "Код");
				КодСтатьи = Сред(КодКЭК, 3, 1);
				
				Если ЗначениеЗаполнено(КодСтатьи) Тогда
					КОСГУНов = БухгалтерскийУчетПовтИсп.КЭКПоКоду(Лев(КодКОСГУ, 2) + КодСтатьи);
				КонецЕсли;
				
			КонецЕсли;
			
		ИначеЕсли СчетВИерархии(ДанныеПроводки.Счет, "111.60, 25.61, 26.61") Тогда
			
			ППНМА = ЗначениеСубконтоПроводкиПоТипу(ДанныеПроводки, Тип("СправочникСсылка.ОсновныеСредства"));
			
			Если ППНМА <> Неопределено Тогда
				
				СПИ = УправлениеОсновнымиСредствами.СрокПолезногоИспользованияОС(ППНМА, ДанныеПроводки.Дата);
				КодСтатьи = ?(СПИ = 0, "3", "2");
				КОСГУНов = БухгалтерскийУчетПовтИсп.КЭКПоКоду(Лев(КодКОСГУ, 2) + КодСтатьи);
				
			КонецЕсли;
			
		ИначеЕсли СчетВИерархии(ДанныеПроводки.Счет, "01") Тогда
			
			Если БухгалтерскийУчетПовтИсп.ЕстьСубконтоСчета(
					ДанныеПроводки.Счет, ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства) Тогда
			
				Имущество = ЗначениеСубконтоПроводкиПоТипу(ДанныеПроводки, Тип("СправочникСсылка.ОсновныеСредства"));
				
				Если Имущество <> Неопределено Тогда
					
					ВидНФА = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Имущество, "ВидНФА");
					Если ВидНФА = Перечисления.ВидыНФА.НМА Тогда
						КодКЭК = "320";
					ИначеЕсли ВидНФА = Перечисления.ВидыНФА.НПА Тогда
						КодКЭК = "330";
					Иначе
						КодКЭК = "310";
					КонецЕсли;
					
					КОСГУНов = БухгалтерскийУчетПовтИсп.КЭКПоКоду(КодКЭК);
					
				КонецЕсли;
			ИначеЕсли БухгалтерскийУчетПовтИсп.ЕстьСубконтоСчета(
					ДанныеПроводки.Счет, ПланыВидовХарактеристик.ВидыСубконто.Номенклатура) Тогда
				
				ЭтоКЭКМатериалов = Истина;
				КодКОСГУ = "340";
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЭтоКЭКМатериалов Тогда
			Если БухгалтерскийУчетКлиентСервер.ПрименяетсяДетальныйКЭК340и440(
					ДанныеПроводки.Дата, ДанныеПроводки.Организация) Тогда
				Если СчетВИерархии(ДанныеПроводки.Счет, "108.00") Тогда
					КодСтатьи = "6";
				Иначе
					КодСтатьи = "0";
					Номенклатура = ЗначениеСубконтоПроводкиПоТипу(ДанныеПроводки, Тип("СправочникСсылка.Номенклатура")); // СправочникСсылка.Номенклатура
					
					Если Номенклатура <> Неопределено Тогда
						
						ТипНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "ТипНоменклатуры");
						КодСтатьи = УправлениеМатериальнымиЗапасамиКлиентСервер.КодСтатьиКОСГУПоТипуНоменклатуры(
							ТипНоменклатуры);
						
					КонецЕсли;
					
				КонецЕсли;
				
				Если КодСтатьи <> "0" Тогда
					КодКОСГУ = Лев(КодКОСГУ, 2) + КодСтатьи;
				КонецЕсли;
			КонецЕсли;
			КОСГУНов = БухгалтерскийУчетПовтИсп.КЭКПоКоду(КодКОСГУ);
		КонецЕсли;
		
	КонецЕсли;  
	
	Если КЭКВИерархии(КОСГУНов, ДопустимыеКЭКСчета) ИЛИ (ДанныеПроводки.ВводОстатков = Истина И ДопКЭК = КОСГУНов) Тогда
		Возврат КОСГУНов;
	Иначе
		Возврат КОСГУ;
	КонецЕсли;
	
КонецФункции

// Возвращает КОСГУ движения номенклатуры. До даты перехода на приказ 209н возвращается КОСГУ из счета.
// После даты перехода возвращается детальный КЭК.
//
// Параметры:
//  Организация		 - СправочникСсылка.Организации - Организация движения
//  ИФО				 - СправочникСсылка.ИсточникиФинансовогоОбеспечения - ИФО движения
//  КФО				 - ПеречислениеСсылка.КВД - КФО движения
//  Дата			 - Дата - Дата движения
//  Счет			 - ПланСчетов.ЕПСБУ - Счет движения (счет учета номенклатуры)
//  ТипНоменклатуры	 - Перечисление.ТипыНоменклатуры - тип номенклатуры
//  ДтКт			 - Строка - сторона проводки: "Дт" или "Кт"
// 
// Возвращаемое значение:
// СправочникСсылка.КОСГУ - полученный КОСГУ
//
Функция КЭКНоменклатуры(Организация, ИФО, КФО, Дата, Счет, ТипНоменклатуры, ДтКт) Экспорт
	
	Если Не БухгалтерскийУчетКлиентСервер.ПрименяетсяДетальныйКЭК340и440(Дата, Организация) Тогда
		Возврат КЭКСчета(Организация, ИФО, КФО, Дата, Счет, ДтКт);
	КонецЕсли;
	
	Если УправлениеМатериальнымиЗапасами.ЭтоТипНоменклатурыСОсобымКЭК(ТипНоменклатуры) Тогда
		КОСГУ = УправлениеМатериальнымиЗапасами.КЭКПоТипуНоменклатуры(ТипНоменклатуры, ДтКт);
		Если ЗначениеЗаполнено(КОСГУ) Тогда
			Возврат КОСГУ;
		КонецЕсли;
	КонецЕсли;
	
	КОСГУ = КЭКДетальныйСчета105(Организация, ИФО, КФО, Дата, Счет, ДтКт);
	Если ЗначениеЗаполнено(КОСГУ) Тогда
		Возврат КОСГУ;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Счет) Тогда
		КОСГУ = КЭКДетальныйНоменклатурыПоСчетуИК(Счет, Дата, Организация, ДтКт);
		Если ЗначениеЗаполнено(КОСГУ) Тогда
			Возврат КОСГУ;
		КонецЕсли;
		КОСГУ = КЭКСчета(Организация, ИФО, КФО, Дата, Счет, ДтКт);
		Если НЕ ЗначениеЗаполнено(КОСГУ) Тогда
			Возврат КОСГУ;
		КонецЕсли;
		КодКОСГУ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КОСГУ, "Код");
	Иначе
		КОСГУ = Справочники.КОСГУ.ПустаяСсылка();
		Если ДтКт = "Дт" Тогда
			КодКОСГУ = "340";
		Иначе
			КодКОСГУ = "440";
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КОСГУ) И КодКОСГУ <> "340" И КодКОСГУ <> "440" Тогда
		Возврат КОСГУ;
	КонецЕсли;
	
	КодСтатьи = УправлениеМатериальнымиЗапасамиКлиентСервер.КодСтатьиКОСГУПоТипуНоменклатуры(ТипНоменклатуры);
	
	Если КодСтатьи = "0" Тогда
		
		Возврат КОСГУ;
		
	КонецЕсли;
	
	Возврат БухгалтерскийУчетПовтИсп.КЭКПоКоду(Лев(КодКОСГУ, 2) + КодСтатьи);
	
КонецФункции

Функция КЭКДетальныйСчета105(Организация, ИФО, КФО, Дата, Счет, ДтКт)
	
	Если Не БухгалтерскийУчетКлиентСервер.ПрименяетсяДетальныйКЭК340и440(Дата, Организация) Тогда
		Возврат КЭКСчета(Организация, ИФО, КФО, Дата, Счет, ДтКт);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Счет) Тогда
		КодСчета = СокрП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Счет, "Код"));
	Иначе
		Возврат Справочники.КОСГУ.ПустаяСсылка();
	КонецЕсли;
	
	Если СтрДлина(КодСчета) <> 6 ИЛИ Лев(КодСчета, 4) <> "105." Тогда
		Возврат Справочники.КОСГУ.ПустаяСсылка();
	КонецЕсли;
	
	КодСтатьи = Прав(КодСчета, 1);
	КодСтатьиЧислом = ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(10).ПривестиЗначение(КодСтатьи);
	Если КодСтатьиЧислом = 0 Тогда
		Возврат КЭКСчета(Организация, ИФО, КФО, Дата, Счет, ДтКт);
	КонецЕсли;
	Если КодСтатьиЧислом > 6 Тогда
		КодСтатьи = "6";
	КонецЕсли;
	Если ДтКт = "Дт" Тогда
		КодКЭК = "34";
	Иначе
		КодКЭК = "44";
	КонецЕсли;
	КЭК = БухгалтерскийУчетПовтИсп.КЭКПоКоду(КодКЭК + КодСтатьи);
	
	Если ЗначениеЗаполнено(КЭК) Тогда
		Возврат КЭК;
	Иначе
		Возврат КЭКСчета(Организация, ИФО, КФО, Дата, Счет, ДтКт);
	КонецЕсли;
	
КонецФункции

Функция ПолучитьАналитическийСчетПоКЭК(Знач КЭК, ДопустимыеСчета = "", ПолучитьВсеСчета = Ложь, Знач НаДату = Неопределено, Знач Организация = Неопределено, Знач ИФО = Неопределено, Знач КПС = Неопределено) Экспорт
	
	Возврат БухгалтерскийУчетПовтИсп.ПолучитьАналитическийСчетПоКЭК(КЭК, ДопустимыеСчета, ПолучитьВсеСчета, ДатаАктуальностиСчетов(НаДату, Организация), Организация, ИФО, КПС);
	
КонецФункции

// Возвращает массив КЭК для использования в условиях запросов, отборах, параметрах выбора и пр.
// По умолчанию возвращает массив КЭК со всеми подчиненными элементами.
//
// Параметры:
//  КЭК - Строка, Массив, СправочникСсылка - КЭК, заданные списком кодов, ссылок или иным способом.
//  БезУчетаИерархии - Булево - признак исключения подчиненных элементов из итогового списка.
// 
// Пример:
//	БухгалтерскийУчет.СписокКЭК("100")
// 
// Возвращаемое значение:
//  Массив - массив ссылок на КЭК справочника "КОСГУ".
//
Функция СписокКЭК(КЭК, БезУчетаИерархии = Ложь) Экспорт
	
	Если ТипЗнч(КЭК) = Тип("Строка") Тогда
		
		МассивКЭК = СтрРазделить(СтрЗаменить(КЭК, " ", ""), ",", Ложь);
		КЭКЗаданыСсылками = Ложь;
		
	ИначеЕсли ТипЗнч(КЭК) = Тип("СправочникСсылка.КОСГУ") Тогда
		
		МассивКЭК = Новый Массив;
		МассивКЭК.Добавить(КЭК);
		КЭКЗаданыСсылками = Истина;
		
	ИначеЕсли ТипЗнч(КЭК) = Тип("Массив") Тогда
		
		МассивКЭК = КЭК;	
		КЭКЗаданыСсылками = Ложь;
		Если МассивКЭК.Количество() > 0 И ТипЗнч(МассивКЭК[0]) = Тип("СправочникСсылка.КОСГУ") Тогда
			КЭКЗаданыСсылками = Истина;
		КонецЕсли;
		
	Иначе
		Возврат Новый Массив;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивКЭК", МассивКЭК);
	
	Если КЭКЗаданыСсылками Тогда
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КОСГУ.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КОСГУ КАК КОСГУ
		|ГДЕ
		|	КОСГУ.Ссылка В ИЕРАРХИИ(&МассивКЭК)
		|
		|УПОРЯДОЧИТЬ ПО
		|	КОСГУ.Код";
		
	Иначе // КЭК заданы кодами
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КОСГУ.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ Родители
		|ИЗ
		|	Справочник.КОСГУ КАК КОСГУ
		|ГДЕ
		|	КОСГУ.Код В(&МассивКЭК)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КОСГУ.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КОСГУ КАК КОСГУ
		|ГДЕ
		|	КОСГУ.Ссылка В ИЕРАРХИИ
		|			(ВЫБРАТЬ
		|				Родители.Ссылка
		|			ИЗ
		|				Родители)
		|
		|УПОРЯДОЧИТЬ ПО
		|	КОСГУ.Код";
		
	КонецЕсли;
	
	Если БезУчетаИерархии Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "В ИЕРАРХИИ", "В");
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

// Проверяет принадлежность КЭК иерархии, заданной параметром Эталон.
//
// Параметры:
//	КЭК - СправочникСсылка.КОСГУ - КЭК, который необходимо проверить.
//	Эталон - Строка, Массив, СправочникСсылка.КОСГУ - иерархия КЭК.
//
// Пример:
//	БухгалтерскийУчет.КЭКВИерархии(КЭК, "150,160,190")
// 
// Возвращаемое значение:
//	Булево
// 
Функция КЭКВИерархии(КЭК, Эталон) Экспорт
	
	Если НЕ ЗначениеЗаполнено(КЭК) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТипЗнчЭталон = ТипЗнч(Эталон);
	Если ТипЗнчЭталон = Тип("Строка")
	 ИЛИ ТипЗнчЭталон = Тип("Массив")
	 ИЛИ ТипЗнчЭталон = Тип("СписокЗначений") Тогда
		
		Возврат (СписокКЭК(Эталон).Найти(КЭК) <> Неопределено);
		
	ИначеЕсли ТипЗнчЭталон = Тип("СправочникСсылка.КОСГУ") Тогда
		
		Возврат КЭК = Эталон ИЛИ КЭК.ПринадлежитЭлементу(Эталон);
		
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

// Возвращает ссылку на счет из плана счетов "ЕПСБУ" по коду, актуальный на заданную дату
// с учетом даты перехода на применение измененого плана счетов организацией.
//
// Параметры:
//  КодСчета - Строка - код счета.
//  НаДату  - Дата - дата, на которую необходимо получить актуальный счет.
//  Организация - СправочникСсылка.Организации - организация, для которой определяется счет
//
// 
// Пример:
//	БухгалтерскийУчет.СчетПоКоду("101.37", Объект.Дата, Объект.Организация)
// 
// Возвращаемое значение:
//  ПланСчетовСсылка - ссылка на счет с указанным кодом, актуальный на заданную дату для заданной организации.
//
Функция СчетПоКоду(КодСчета, Знач НаДату = Неопределено, Знач Организация = Неопределено) Экспорт
	
	Возврат БухгалтерскийУчетПовтИсп.СчетПоКоду(КодСчета, ДатаАктуальностиСчетов(НаДату, Организация));

КонецФункции

// Возвращает массив счетов для использования в условиях запросов, отборах, параметрах выбора и пр.
// По умолчанию возвращает массив счетов со всеми подчиненными субсчетами.
//
// Параметры:
//  Счета - Строка, Массив, СписокЗначений, ПланСчетовСсылка - счета, заданные списком кодов, ссылок или иным способом.
//  НаДату - Дата - дата актуальности, если необходимо получить список только актуальных счетов.
//  БезУчетаИерархии - Булево - признак исключения подчиненных счетов из итогового списка.
//  Организация - СправочникСсылка.Организации - организация, для которой определяются счета
// 
// Пример:
//	БухгалтерскийУчет.СписокСчетов("206.00, 302.00")
//	БухгалтерскийУчет.СписокСчетов("101.27, 101.37", Объект.Дата,, Объект.Организация)
// 
// Возвращаемое значение:
//  Массив - массив ссылок на счета плана счетов "ЕПСБУ".
//
Функция СписокСчетов(Счета, Знач НаДату = Неопределено, БезУчетаИерархии = Ложь, Знач Организация = Неопределено) Экспорт
	
	СчетаКэш = Счета;
	
	Если ТипЗнч(Счета) = Тип("СписокЗначений") Тогда // Приведем к простому типу для кэширования.
		
		СчетаКэш = Новый Структура;
		Для Каждого Счет Из Счета Цикл
			СчетаКэш.Вставить("Счет" + Счета.Индекс(Счет), Счет.Значение);
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(Счета) = Тип("Массив") Тогда // Приведем к простому типу для кэширования.
		
		СчетаКэш = Новый Структура;
		Для Индекс = 0 По Счета.Количество() - 1 Цикл
			СчетаКэш.Вставить("Счет" + Индекс, Счета[Индекс]);
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат БухгалтерскийУчетПовтИсп.СписокСчетов(СчетаКэш, ДатаАктуальностиСчетов(НаДату, Организация), БезУчетаИерархии);
	
КонецФункции

// Проверяет принадлежность счета иерархии, заданной параметром Эталон.
//
// Параметры:
//	Счет - ПланСчетовСсылка - счет, который необходимо проверить.
//	Эталон - Строка, Массив, ПланСчетовСсылка - иерархия счетов.
//
// Пример:
//	БухгалтерскийУчет.СчетВИерархии(Счет, "206.00, 302.00")
// 
// Возвращаемое значение:
//	Булево
// 
Функция СчетВИерархии(Счет, Эталон) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Счет) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТипЗнчЭталон = ТипЗнч(Эталон);
	Если ТипЗнчЭталон = Тип("Строка")
	 ИЛИ ТипЗнчЭталон = Тип("Массив")
	 ИЛИ ТипЗнчЭталон = Тип("СписокЗначений") Тогда
		
		Возврат (БухгалтерскийУчетПовтИсп.СписокСчетов(Эталон).Найти(Счет) <> Неопределено);
		
	ИначеЕсли ТипЗнчЭталон = Тип("ПланСчетовСсылка.ЕПСБУ") Тогда
		
		Возврат Счет = Эталон ИЛИ Счет.ПринадлежитЭлементу(Эталон);
		
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

// Возвращает массив субконто для использования в условиях запросов, отборах, параметрах выбора и пр.
//
// Параметры:
//  ВидыСубконтоСписок	 - Строка, Массив, СписокЗначений - субконто, заданные списком имен.
// 
// Возвращаемое значение:
//  Массив - массив ссылок на субконто.
//
Функция СписокСубконто(ИменаСубконто) Экспорт
	
	Результат = Новый Массив;
	
	Если ТипЗнч(ИменаСубконто) = Тип("Строка") Тогда
		СписокИменСубконто = СтрРазделить(СтрЗаменить(ИменаСубконто, " ", ""), ",", Ложь);
	ИначеЕсли ТипЗнч(ИменаСубконто) = Тип("Массив") Тогда
		СписокИменСубконто = ИменаСубконто;
	ИначеЕсли ТипЗнч(ИменаСубконто) = Тип("СписокЗначений") Тогда
		СписокИменСубконто = ИменаСубконто.ВыгрузитьЗначения();	
	Иначе
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого ИмяСубконто Из СписокИменСубконто Цикл		
		Результат.Добавить(ПланыВидовХарактеристик.ВидыСубконто[ИмяСубконто]);		
	КонецЦикла;	
	
	Возврат Результат;
	
КонецФункции

// Определяет значение субконто из списка возможных вариантов, заданных парами ВидСубконто-ЗначениеСубконто.
// 
// Параметры:
//  Счет              - ПланСчетовСсылка - счет, для которого нужно определить субконто;
//  НомерСубконто     - Число - номер субконто счета, для которого нужно определить субконто;
//  ВидСубконто1      - ПланВидовХарактеристикСсылка.ВидыСубконто, Строка - вид субконто (вариант 1);
//  ЗначениеСубконто1 - Произвольный - значение субконто (вариант 1);
//  ВидСубконто2      - ПланВидовХарактеристикСсылка.ВидыСубконто, Строка - вид субконто (вариант 2);
//  ЗначениеСубконто2 - Произвольный - значение субконто (вариант 2);
//  ВидСубконто3      - ПланВидовХарактеристикСсылка.ВидыСубконто, Строка - вид субконто (вариант 3);
//  ЗначениеСубконто3 - Произвольный - значение субконто (вариант 3);
//  ВидСубконто4      - ПланВидовХарактеристикСсылка.ВидыСубконто, Строка - вид субконто (вариант 4);
//  ЗначениеСубконто4 - Произвольный - значение субконто (вариант 4);
//  ВидСубконто5      - ПланВидовХарактеристикСсылка.ВидыСубконто, Строка - вид субконто (вариант 5);
//  ЗначениеСубконто5 - Произвольный - значение субконто (вариант 5);
//
// Возвращаемое значение:
//  Произвольный - значение субконто номер "НомерСубконто" к счету "Счет".
//
Функция ПолучитьЗначениеСубконто(Счет, НомерСубконто,
			ВидСубконто1="", ЗначениеСубконто1=Неопределено,
			ВидСубконто2="", ЗначениеСубконто2=Неопределено,
			ВидСубконто3="", ЗначениеСубконто3=Неопределено,
			ВидСубконто4="", ЗначениеСубконто4=Неопределено,
			ВидСубконто5="", ЗначениеСубконто5=Неопределено) Экспорт
			
	СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Счет);
	Если СвойстваСчета = Неопределено ИЛИ НомерСубконто > СвойстваСчета.КоличествоСубконто Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Попытаемся найти значение субконто среди доступных вариантов
	ВидыСубконто = Новый Массив;
	ВидыСубконто.Добавить(ВидСубконто1);
	ВидыСубконто.Добавить(ВидСубконто2);
	ВидыСубконто.Добавить(ВидСубконто3);
	ВидыСубконто.Добавить(ВидСубконто4);
	ВидыСубконто.Добавить(ВидСубконто5);
	
	ЗначенияСубконто = Новый Массив;
	ЗначенияСубконто.Добавить(ЗначениеСубконто1);
	ЗначенияСубконто.Добавить(ЗначениеСубконто2);
	ЗначенияСубконто.Добавить(ЗначениеСубконто3);
	ЗначенияСубконто.Добавить(ЗначениеСубконто4);
	ЗначенияСубконто.Добавить(ЗначениеСубконто5);
	
	ВариантыСубконто = Новый Соответствие;
	Для Сч = 0 По 4 Цикл
		
		Если НЕ ЗначениеЗаполнено(ВидыСубконто[Сч]) ИЛИ НЕ ЗначениеЗаполнено(ЗначенияСубконто[Сч]) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(ВидыСубконто[Сч]) = Тип("ПланВидовХарактеристикСсылка.ВидыСубконто") Тогда
			ВариантыСубконто.Вставить(ВидыСубконто[Сч], ЗначенияСубконто[Сч]);
		ИначеЕсли ТипЗнч(ВидыСубконто[Сч]) = Тип("Строка") Тогда
			ВариантыСубконто.Вставить(ПланыВидовХарактеристик.ВидыСубконто[ВидыСубконто[Сч]], ЗначенияСубконто[Сч]);
		КонецЕсли;
		
	КонецЦикла;
	
	ТребуемыйВидСубконто = СвойстваСчета["ВидСубконто" + НомерСубконто];
	Возврат ВариантыСубконто.Получить(ТребуемыйВидСубконто);
	
КонецФункции

// Процедура устанавливает субконто на счете. Если такое субконто на счете
// отсутствует, то ничего не делается.
//
// Параметры:
//		Счет - Счет, к которому относится субконто
//      Субконто - набор субконто
//		Номер или имя устанавливаемого субконто
//      Значение субконто - значение устанавливаемого субконто
//
Процедура УстановитьСубконто(Проводка, ДтКт, ИмяСубконто, ЗначениеСубконто) Экспорт

	Если НЕ ЗначениеЗаполнено(ИмяСубконто) Тогда
		Возврат;
	КонецЕсли;
	
	СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Проводка["Счет"+ДтКт]);
	
	Если ТипЗнч(ИмяСубконто) = Тип("ПланВидовХарактеристикСсылка.ВидыСубконто") Тогда
		
		ВидСубконто = ИмяСубконто;
		
	ИначеЕсли ТипЗнч(ИмяСубконто) = Тип("Число") Тогда

		Если ИмяСубконто > СвойстваСчета.КоличествоСубконто Тогда
			Возврат;
		КонецЕсли;

		ВидСубконто = СвойстваСчета["ВидСубконто" + ИмяСубконто];

	Иначе

		ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто[ИмяСубконто];

	КонецЕсли;
	
	Если СвойстваСчета.ВидСубконто1 = ВидСубконто Тогда
		НомерСубконто = 1;
	ИначеЕсли СвойстваСчета.ВидСубконто2 = ВидСубконто Тогда
		НомерСубконто = 2;
	ИначеЕсли СвойстваСчета.ВидСубконто3 = ВидСубконто Тогда
		НомерСубконто = 3;
	Иначе
		Возврат;
	КонецЕсли;
	
	Если ВидСубконто.ТипЗначения.СодержитТип(ТипЗнч(ЗначениеСубконто)) Тогда
		
		Проводка["ВидСубконто"+ДтКт+НомерСубконто] = ВидСубконто;
		Проводка["Субконто"+ДтКт+НомерСубконто]    = ЗначениеСубконто;
		
	КонецЕсли;

КонецПроцедуры // УстановитьСубконто()

Процедура УстановитьУсловноеОформлениеПолейАналитикиСчета(УсловноеОформление, ПоляАналитики, ИмяТаблицыФормы = "") Экспорт
	
	// Субконто
	Для Индекс = 1 По 3 Цикл
		
		Если ПоляАналитики.Свойство("Субконто" + Индекс) Тогда
			
			ИменаЭлементов = БухгалтерскийУчетКлиентСервер.РасшифроватьОписаниеПоляАналитикиСчета(
				ПоляАналитики["Субконто" + Индекс], ИмяТаблицыФормы);
			
			// Видимость Субконто.
			
			ЭлементУО = УсловноеОформление.Элементы.Добавить();
			
			ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, ИменаЭлементов.ИмяПоляФормы);
			
			ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
				ИменаЭлементов.ИмяТаблицыФормы + "." + ИменаЭлементов.ПризнакДоступностиПоля, ВидСравненияКомпоновкиДанных.Равно, 0);
			
			ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Индекс = 1); // 1-е субконто видно всегда.
			ЭлементУО.Оформление.УстановитьЗначениеПараметра("Доступность", Ложь);
			
			// Выделение не заполненного обязательного Субконто.
			
			ЭлементУО = УсловноеОформление.Элементы.Добавить();
			
			ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, ИменаЭлементов.ИмяПоляФормы);
			
			ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
				ИменаЭлементов.ИмяТаблицыФормы + "." + ИменаЭлементов.ПризнакДоступностиПоля, ВидСравненияКомпоновкиДанных.Равно, 1);
			
			ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
				ИменаЭлементов.ПутьКДаннымАналитикиСчета, ВидСравненияКомпоновкиДанных.НеЗаполнено);
			
			ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ПоясняющийОшибкуТекст);
			ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<...>'"));
			
			// Выделение не заполненного необязательного Субконто.
			
			ЭлементУО = УсловноеОформление.Элементы.Добавить();
			
			ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, ИменаЭлементов.ИмяПоляФормы);
			
			ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
				ИменаЭлементов.ИмяТаблицыФормы + "." + ИменаЭлементов.ПризнакДоступностиПоля, ВидСравненияКомпоновкиДанных.Равно, 2);
			
			ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
				ИменаЭлементов.ПутьКДаннымАналитикиСчета, ВидСравненияКомпоновкиДанных.НеЗаполнено);
			
			ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<...>'"));
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Подразделение
	Если ПоляАналитики.Свойство("Подразделение") Тогда
		
		ИменаЭлементов = БухгалтерскийУчетКлиентСервер.РасшифроватьОписаниеПоляАналитикиСчета(ПоляАналитики.Подразделение, ИмяТаблицыФормы);
		
		// Видимость Подразделения.
		
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		
		ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, ИменаЭлементов.ИмяПоляФормы);
		
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
			ИменаЭлементов.ИмяТаблицыФормы + "." + ИменаЭлементов.ПризнакДоступностиПоля, ВидСравненияКомпоновкиДанных.Равно, 0);
		
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
		
		// Выделение не заполненного обязательного Подразделения.
		
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		
		ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, ИменаЭлементов.ИмяПоляФормы);
		
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
			ИменаЭлементов.ИмяТаблицыФормы + "." + ИменаЭлементов.ПризнакДоступностиПоля, ВидСравненияКомпоновкиДанных.Равно, 1);
		
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
			ИменаЭлементов.ПутьКДаннымАналитикиСчета, ВидСравненияКомпоновкиДанных.НеЗаполнено);
		
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ПоясняющийОшибкуТекст);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<...>'"));
		
		// Выделение не заполненного необязательного Подразделения.
		
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		
		ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, ИменаЭлементов.ИмяПоляФормы);
		
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
			ИменаЭлементов.ИмяТаблицыФормы + "." + ИменаЭлементов.ПризнакДоступностиПоля, ВидСравненияКомпоновкиДанных.Равно, 2);
		
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
			ИменаЭлементов.ПутьКДаннымАналитикиСчета, ВидСравненияКомпоновкиДанных.НеЗаполнено);
		
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<...>'"));
		
		// Выделение не заполненного Подразделения, заполняемого автоматически (АвтоПодразделение = Истина).
		
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		
		ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, ИменаЭлементов.ИмяПоляФормы);
		
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
			ИменаЭлементов.ИмяТаблицыФормы + "." + ИменаЭлементов.ПризнакДоступностиПоля, ВидСравненияКомпоновкиДанных.Равно, 3);
		
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
			ИменаЭлементов.ПутьКДаннымАналитикиСчета, ВидСравненияКомпоновкиДанных.НеЗаполнено);
		
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<авто>'"));
		
	КонецЕсли;
	
	// КПС
	Если ПоляАналитики.Свойство("КПС") Тогда
		
		ИменаЭлементов = БухгалтерскийУчетКлиентСервер.РасшифроватьОписаниеПоляАналитикиСчета(ПоляАналитики.КПС, ИмяТаблицыФормы);
		
		// Видимость КПС
		
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		
		ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, ИменаЭлементов.ИмяПоляФормы);
		
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
			ИменаЭлементов.ИмяТаблицыФормы + "." + ИменаЭлементов.ПризнакДоступностиПоля, ВидСравненияКомпоновкиДанных.Равно, Ложь);
		
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Доступность", Ложь);
		
		// Выделение не заполненного КПС
		
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		
		ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, ИменаЭлементов.ИмяПоляФормы);
		
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
			ИменаЭлементов.ИмяТаблицыФормы + "." + ИменаЭлементов.ПризнакДоступностиПоля, ВидСравненияКомпоновкиДанных.Равно, Истина);
		
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
			ИменаЭлементов.ПутьКДаннымАналитикиСчета, ВидСравненияКомпоновкиДанных.НеЗаполнено);
		
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ПоясняющийОшибкуТекст);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<...>'"));
		
	КонецЕсли;
	
	// КЭК
	Если ПоляАналитики.Свойство("КЭК") Тогда
		
		ИменаЭлементов = БухгалтерскийУчетКлиентСервер.РасшифроватьОписаниеПоляАналитикиСчета(ПоляАналитики.КЭК, ИмяТаблицыФормы);
		
		// Видимость КЭК
		
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		
		ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, ИменаЭлементов.ИмяПоляФормы);
		
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
			ИменаЭлементов.ИмяТаблицыФормы + "." + ИменаЭлементов.ПризнакДоступностиПоля, ВидСравненияКомпоновкиДанных.Равно, Ложь);
		
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Доступность", Ложь);
		
		// Выделение не заполненного КЭК
		
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		
		ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, ИменаЭлементов.ИмяПоляФормы);
		
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
			ИменаЭлементов.ИмяТаблицыФормы + "." + ИменаЭлементов.ПризнакДоступностиПоля, ВидСравненияКомпоновкиДанных.Равно, Истина);
		
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
			ИменаЭлементов.ПутьКДаннымАналитикиСчета, ВидСравненияКомпоновкиДанных.НеЗаполнено);
		
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ПоясняющийОшибкуТекст);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<...>'"));
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьЗаполнениеСчетаИАналитики(ПроверяемыеРеквизиты, Объект, ИмяТабЧасти = Неопределено, Отказ = Ложь) Экспорт
	
	МетаданныеОбъекта = Объект.Метаданные();
	
	ПроверяемВТабЧастиОбъекта = (ИмяТабЧасти <> Неопределено);
	Если ПроверяемВТабЧастиОбъекта Тогда
		МетаданныеТабЧасти   = МетаданныеОбъекта.ТабличныеЧасти[ИмяТабЧасти];
		МетаданныеРеквизитов = МетаданныеТабЧасти.Реквизиты;
	Иначе
		МетаданныеТабЧасти   = Неопределено;
		МетаданныеРеквизитов = МетаданныеОбъекта.Реквизиты;
	КонецЕсли;
	
	ИмяПоляСчет = ПроверяемыеРеквизиты.Счет;
	ПроверитьЗаполнениеСчета = // Если проверка заполнения счета установлена в метаданных, не будем здесь проверять.
		НЕ (МетаданныеРеквизитов[ИмяПоляСчет].ПроверкаЗаполнения = ПроверкаЗаполнения.ВыдаватьОшибку);
	
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	Если ПроверяемВТабЧастиОбъекта Тогда
	
		Для Каждого СтрокаТабЧасти Из Объект[ИмяТабЧасти] Цикл
		
			// Счет
			Если НЕ ЗначениеЗаполнено(СтрокаТабЧасти[ИмяПоляСчет]) Тогда
				Если ПроверитьЗаполнениеСчета Тогда
					ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
						МетаданныеРеквизитов[ИмяПоляСчет].Синоним, СтрокаТабЧасти.НомерСтроки, МетаданныеТабЧасти.Синоним);
					ПолеОшибки = ИмяТабЧасти + "[" + Формат(СтрокаТабЧасти.НомерСтроки - 1, "ЧН=0; ЧГ=") + "]." + ИмяПоляСчет;
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Объект.Ссылка, ПолеОшибки, "Объект", Отказ);
				КонецЕсли;
				Продолжить; // Нет смысла проверять аналитику счета.
			КонецЕсли;
			
			СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаТабЧасти[ИмяПоляСчет]);
			
			// КПС
			Если ПроверяемыеРеквизиты.Свойство("КПС") Тогда
				ИмяПоля = ПроверяемыеРеквизиты.КПС;
				Если СвойстваСчета.УчетПоКПС
					И НЕ ЗначениеЗаполнено(СтрокаТабЧасти[ИмяПоля]) Тогда
					ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
						МетаданныеРеквизитов[ИмяПоля].Синоним, СтрокаТабЧасти.НомерСтроки, МетаданныеТабЧасти.Синоним);
					ПолеОшибки = ИмяТабЧасти + "[" + Формат(СтрокаТабЧасти.НомерСтроки - 1, "ЧН=0; ЧГ=") + "]." + ИмяПоля;
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Объект.Ссылка, ПолеОшибки, "Объект", Отказ);
				КонецЕсли;
			КонецЕсли;
			
			// КЭК
			Если ПроверяемыеРеквизиты.Свойство("КЭК") Тогда
				ИмяПоля = ПроверяемыеРеквизиты.КЭК;
				Если СвойстваСчета.УчетПоКЭК
					И НЕ ЗначениеЗаполнено(СтрокаТабЧасти[ИмяПоля]) Тогда
					ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
						МетаданныеРеквизитов[ИмяПоля].Синоним, СтрокаТабЧасти.НомерСтроки, МетаданныеТабЧасти.Синоним);
					ПолеОшибки = ИмяТабЧасти + "[" + Формат(СтрокаТабЧасти.НомерСтроки - 1, "ЧН=0; ЧГ=") + "]." + ИмяПоля;
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Объект.Ссылка, ПолеОшибки, "Объект", Отказ);
				КонецЕсли;
			КонецЕсли;
			
			// Подразделение
			Если ПроверяемыеРеквизиты.Свойство("Подразделение") Тогда
				ИмяПоля = ПроверяемыеРеквизиты.Подразделение;
				Если ИспользоватьУчетПоПодразделениям
					И СвойстваСчета.УчетПоПодразделениям
					И НЕ СвойстваСчета.РазрешитьНеУказыватьПодразделение
					И НЕ ЗначениеЗаполнено(СтрокаТабЧасти[ИмяПоля]) Тогда
					ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
						МетаданныеРеквизитов[ИмяПоля].Синоним, СтрокаТабЧасти.НомерСтроки, МетаданныеТабЧасти.Синоним);
					ПолеОшибки = ИмяТабЧасти + "[" + Формат(СтрокаТабЧасти.НомерСтроки - 1, "ЧН=0; ЧГ=") + "]." + ИмяПоля;
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Объект.Ссылка, ПолеОшибки, "Объект", Отказ);
				КонецЕсли;
			КонецЕсли;
			
			// Субконто
			Для НомерСубконто = 1 По СвойстваСчета.КоличествоСубконто Цикл
				
				Если ПроверяемыеРеквизиты.Свойство("Субконто" + НомерСубконто) Тогда
					ИмяПоля = ПроверяемыеРеквизиты["Субконто" + НомерСубконто];
					Если НЕ ЗначениеЗаполнено(СтрокаТабЧасти[ИмяПоля])
						И СвойстваСчета["ВидСубконто" + НомерСубконто + "Обязательный"] Тогда
						ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
							СвойстваСчета["ВидСубконто" + НомерСубконто + "Наименование"],
							СтрокаТабЧасти.НомерСтроки, МетаданныеТабЧасти.Синоним);
						ПолеОшибки = ИмяТабЧасти + "[" + Формат(СтрокаТабЧасти.НомерСтроки - 1, "ЧН=0; ЧГ=") + "]." + ИмяПоля;
						ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Объект.Ссылка, ПолеОшибки, "Объект", Отказ);
					КонецЕсли;
				КонецЕсли;
				
			КонецЦикла;
		
		КонецЦикла;
		
	Иначе // Проверяем в самом объекте.
		
		// Счет
		Если НЕ ЗначениеЗаполнено(Объект[ИмяПоляСчет]) Тогда
			Если ПроверитьЗаполнениеСчета Тогда
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение",
					МетаданныеРеквизитов[ИмяПоляСчет].Синоним);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Объект.Ссылка, ИмяПоляСчет, "Объект", Отказ);
			КонецЕсли;
			Возврат; // Нет смысла проверять аналитику счета.
		КонецЕсли;
		
		СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Объект[ИмяПоляСчет]);
		
		// КПС
		Если ПроверяемыеРеквизиты.Свойство("КПС") Тогда
			ИмяПоля = ПроверяемыеРеквизиты.КПС;
			Если СвойстваСчета.УчетПоКПС
				И НЕ ЗначениеЗаполнено(Объект[ИмяПоля]) Тогда
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение",
					МетаданныеРеквизитов[ИмяПоля].Синоним);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Объект.Ссылка, ИмяПоля, "Объект", Отказ);
			КонецЕсли;
		КонецЕсли;
		
		// КЭК
		Если ПроверяемыеРеквизиты.Свойство("КЭК") Тогда
			ИмяПоля = ПроверяемыеРеквизиты.КЭК;
			Если СвойстваСчета.УчетПоКЭК
				И НЕ ЗначениеЗаполнено(Объект[ИмяПоля]) Тогда
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение",
					МетаданныеРеквизитов[ИмяПоля].Синоним);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Объект.Ссылка, ИмяПоля, "Объект", Отказ);
			КонецЕсли;
		КонецЕсли;
		
		// Подразделение
		Если ПроверяемыеРеквизиты.Свойство("Подразделение") Тогда
			ИмяПоля = ПроверяемыеРеквизиты.Подразделение;
			Если ИспользоватьУчетПоПодразделениям
				И СвойстваСчета.УчетПоПодразделениям
				И НЕ СвойстваСчета.РазрешитьНеУказыватьПодразделение
				И НЕ ЗначениеЗаполнено(Объект[ИмяПоля]) Тогда
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение",
					МетаданныеРеквизитов[ИмяПоля].Синоним);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Объект.Ссылка, ИмяПоля, "Объект", Отказ);
			КонецЕсли;
		КонецЕсли;
		
		// Субконто
		Для НомерСубконто = 1 По СвойстваСчета.КоличествоСубконто Цикл
			
			Если ПроверяемыеРеквизиты.Свойство("Субконто" + НомерСубконто) Тогда
				ИмяПоля = ПроверяемыеРеквизиты["Субконто" + НомерСубконто];
				Если НЕ ЗначениеЗаполнено(Объект[ИмяПоля])
					И СвойстваСчета["ВидСубконто" + НомерСубконто + "Обязательный"] Тогда
					ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение",
						СвойстваСчета["ВидСубконто" + НомерСубконто + "Наименование"]);
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Объект.Ссылка, ИмяПоля, "Объект", Отказ);
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьЗаполнениеСчетаИАналитикиВСтрокеТабЧасти(СтрокаТабЧасти, ПроверяемыеРеквизиты, Объект, ИмяТабЧасти, Отказ = Ложь) Экспорт
	
	МетаданныеТабЧасти = Объект.Метаданные().ТабличныеЧасти[ИмяТабЧасти];
	МетаданныеРеквизитов = МетаданныеТабЧасти.Реквизиты;
	ИмяПоляСчет = ПроверяемыеРеквизиты.Счет;
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	// Счет
	Если НЕ ЗначениеЗаполнено(СтрокаТабЧасти[ИмяПоляСчет]) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
			МетаданныеРеквизитов[ИмяПоляСчет].Синоним, СтрокаТабЧасти.НомерСтроки, МетаданныеТабЧасти.Синоним);
		ПолеОшибки = ИмяТабЧасти + "[" + Формат(СтрокаТабЧасти.НомерСтроки - 1, "ЧН=0; ЧГ=") + "]." + ИмяПоляСчет;
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Объект.Ссылка, ПолеОшибки, "Объект", Отказ);
	КонецЕсли;
	
	СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаТабЧасти[ИмяПоляСчет]);
	
	// КПС
	Если ПроверяемыеРеквизиты.Свойство("КПС") Тогда
		ИмяПоля = ПроверяемыеРеквизиты.КПС;
		Если СвойстваСчета.УчетПоКПС
			И НЕ ЗначениеЗаполнено(СтрокаТабЧасти[ИмяПоля]) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
				МетаданныеРеквизитов[ИмяПоля].Синоним, СтрокаТабЧасти.НомерСтроки, МетаданныеТабЧасти.Синоним);
			ПолеОшибки = ИмяТабЧасти + "[" + Формат(СтрокаТабЧасти.НомерСтроки - 1, "ЧН=0; ЧГ=") + "]." + ИмяПоля;
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Объект.Ссылка, ПолеОшибки, "Объект", Отказ);
		КонецЕсли;
	КонецЕсли;
	
	// КЭК
	Если ПроверяемыеРеквизиты.Свойство("КЭК") Тогда
		ИмяПоля = ПроверяемыеРеквизиты.КЭК;
		Если СвойстваСчета.УчетПоКЭК
			И НЕ ЗначениеЗаполнено(СтрокаТабЧасти[ИмяПоля]) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
				МетаданныеРеквизитов[ИмяПоля].Синоним, СтрокаТабЧасти.НомерСтроки, МетаданныеТабЧасти.Синоним);
			ПолеОшибки = ИмяТабЧасти + "[" + Формат(СтрокаТабЧасти.НомерСтроки - 1, "ЧН=0; ЧГ=") + "]." + ИмяПоля;
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Объект.Ссылка, ПолеОшибки, "Объект", Отказ);
		КонецЕсли;
	КонецЕсли;
	
	// Подразделение
	Если ПроверяемыеРеквизиты.Свойство("Подразделение") Тогда
		ИмяПоля = ПроверяемыеРеквизиты.Подразделение;
		Если ИспользоватьУчетПоПодразделениям
			И СвойстваСчета.УчетПоПодразделениям
			И НЕ СвойстваСчета.РазрешитьНеУказыватьПодразделение
			И НЕ ЗначениеЗаполнено(СтрокаТабЧасти[ИмяПоля]) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
				МетаданныеРеквизитов[ИмяПоля].Синоним, СтрокаТабЧасти.НомерСтроки, МетаданныеТабЧасти.Синоним);
			ПолеОшибки = ИмяТабЧасти + "[" + Формат(СтрокаТабЧасти.НомерСтроки - 1, "ЧН=0; ЧГ=") + "]." + ИмяПоля;
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Объект.Ссылка, ПолеОшибки, "Объект", Отказ);
		КонецЕсли;
	КонецЕсли;
	
	// Субконто
	Для НомерСубконто = 1 По СвойстваСчета.КоличествоСубконто Цикл
		
		Если ПроверяемыеРеквизиты.Свойство("Субконто" + НомерСубконто) Тогда
			ИмяПоля = ПроверяемыеРеквизиты["Субконто" + НомерСубконто];
			Если НЕ ЗначениеЗаполнено(СтрокаТабЧасти[ИмяПоля])
				И СвойстваСчета["ВидСубконто" + НомерСубконто + "Обязательный"] Тогда
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
					СвойстваСчета["ВидСубконто" + НомерСубконто + "Наименование"],
					СтрокаТабЧасти.НомерСтроки, МетаданныеТабЧасти.Синоним);
				ПолеОшибки = ИмяТабЧасти + "[" + Формат(СтрокаТабЧасти.НомерСтроки - 1, "ЧН=0; ЧГ=") + "]." + ИмяПоля;
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Объект.Ссылка, ПолеОшибки, "Объект", Отказ);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Заполняет у элемента управления список выбора значениями КФО по данным источника и 
// учетной политике организации(пересечением).
//
// Параметры:
//	СписокКФО - список значений, который будет заполнен					
//	КФО       - значение реквизита, связанного с передаваемым элементом управления  
//	Источник  - массив, либо таблица значений, содержащие допустимые значения типа Перечисление.КВД				
//  ИмяРеквизита - имя реквизита таблицы значений (используется, если источник - таблица значений)
//  ИмяТЧ     - имя табличной части (используется, если источник - таблица значений)
//  СтруктураРазделителей - структура с ключами Организация, ИФО, Дата, по значениям которых будут получены данные учетной политики  
//
// Надо подумать - механизм не универсальный !!!
Процедура ЗаполнитьСписокКФО(СписокКФО, КФО, Источник, ИмяРеквизита="", ИмяТЧ="", СтруктураРазделителей = Неопределено) Экспорт
	МассивКФОизНастройкиРПС = Неопределено;
	Если СтруктураРазделителей <> Неопределено Тогда
		МассивКФОизНастройкиРПС = ПолучитьЗначенияОтбораКФОПоУчетнойПолитике(СтруктураРазделителей)
	КонецЕсли;
	
	Если ТипЗнч(Источник) = Тип("Массив") Тогда
		МассивКФО = Источник;
	ИначеЕсли ТипЗнч(Источник) = Тип("ТаблицаЗначений") Тогда
		Если ИмяРеквизита = "" Тогда
			Возврат;
		КонецЕсли;	
		
		Если ИмяТЧ = "" Тогда
			НайденнаяСтрока = Источник.Найти(ИмяРеквизита);
		Иначе	
			СтруктураПоиска = Новый Структура("ИмяРеквизита, ИмяТЧРеквизитаДокумента", ИмяРеквизита, ИмяТЧ);
			МассивНайденныхСтрок = Источник.НайтиСтроки(СтруктураПоиска);
			НайденнаяСтрока = ?(МассивНайденныхСтрок.Количество() = 0, Неопределено, МассивНайденныхСтрок[0]);
		КонецЕсли;	
		
		Если НайденнаяСтрока = Неопределено Тогда
			Возврат;
		КонецЕсли;	
		
		МассивКФО = НайденнаяСтрока.ДопустимыеЗначения;
	КонецЕсли;	
	Если МассивКФОизНастройкиРПС <> Неопределено Тогда
		МассивКФО = ОбщегоНазначенияБГУ.ПолучитьПересечениеМассивов(МассивКФО, МассивКФОизНастройкиРПС);
	КонецЕсли;	
	
	СписокКФО.ЗагрузитьЗначения(МассивКФО);
	НайденноеКФО = МассивКФО.Найти(КФО);
	Если НайденноеКФО = Неопределено И ЗначениеЗаполнено(КФО) Тогда
		КФО = Перечисления.КВД.ПустаяСсылка();
	КонецЕсли;	

КонецПроцедуры	

// Заполняет сумму проводки. Если какой-либо из счетов валютный, то
// заполняет валютную часть проводки (сумма, валюта)
//
//	Проводка (запись регистра бухгалтерии). Проводка, которую заполняем
//	СуммаВалютная (Число). Сумма в валюте
//	СуммаРублевая (Число). Сумма проводки в рублях
//	Валюта, КурсВалюты, КратностьВалюты. Параметры валютной суммы
//	ВалютныйДт, ВалютныйКт (Булево). Признак "Валютный" для счета дебета и кредита соответственно
//
// Если валюта не передана, то предполагается валюта регламентированного учета.
// Процедура работает следующим образом:
// - Если переданы  и СуммаВалютная и СуммаРублевая, то они и будут установлены в соответствующие места проводки
// - Если передана только СуммаВалютная с параметрами валюты, то сумма рублевая будет расчитана
// - Если передана толкь СуммаРублевая и параметры валюты валютной суммы, то сумма валютная будет расчитана
//
Процедура ЗаполнитьСуммыПроводки(Проводка, Знач СуммаВалютная = 0, Знач СуммаРублевая = 0, 
							Знач Валюта = "", Знач КурсВалюты = 1, Знач КратностьВалюты = 1, 
							Знач ВалютныйДт = Неопределено, Знач ВалютныйКт = Неопределено) Экспорт
	
							
	Если НЕ ЗначениеЗаполнено(Валюта) Тогда
		Валюта = Константы.ВалютаРегламентированногоУчета.Получить();	
	КонецЕсли;							
	
	ВалютаКон = Константы.ВалютаРегламентированногоУчета.Получить();
	
	Если ВалютныйДт = Неопределено Тогда
		ВалютныйДт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Проводка.СчетДт).Валютный;
	КонецЕсли;	
	
	Если ВалютныйКт = Неопределено Тогда
		ВалютныйКт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Проводка.СчетКт).Валютный;
	КонецЕсли;	
	
	Если СуммаРублевая <> 0 Тогда
		Проводка.Сумма = СуммаРублевая;
	Иначе	
		Если Валюта = ВалютаКон Тогда
			Проводка.Сумма = СуммаВалютная;
		Иначе	
			Проводка.Сумма = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(СуммаВалютная, 
				Новый Структура("Валюта, Курс, Кратность", Валюта, КурсВалюты, КратностьВалюты),
				Новый Структура("Валюта, Курс, Кратность", ВалютаКон, 1, 1));
		КонецЕсли;	
	КонецЕсли;	
	
	Если СуммаВалютная <> 0 Тогда
		Если ВалютныйДт Тогда
			Проводка.ВалютаДт = Валюта;
			Проводка.ВалютнаяСуммаДт = СуммаВалютная;
		КонецЕсли;	
		Если ВалютныйКт Тогда
			Проводка.ВалютаКт = Валюта;
			Проводка.ВалютнаяСуммаКт = СуммаВалютная;
		КонецЕсли;	
	Иначе
		Если ВалютныйДт Тогда
			Проводка.ВалютаДт = Валюта;
			Проводка.ВалютнаяСуммаДт = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(СуммаРублевая, 
				Новый Структура("Валюта, Курс, Кратность", ВалютаКон, 1, 1),
				Новый Структура("Валюта, Курс, Кратность", Валюта, КурсВалюты, КратностьВалюты));
		КонецЕсли;	
		Если ВалютныйКт Тогда
			Проводка.ВалютаКт = Валюта;
			Проводка.ВалютнаяСуммаКт = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(СуммаРублевая, 
				Новый Структура("Валюта, Курс, Кратность", ВалютаКон, 1, 1),
				Новый Структура("Валюта, Курс, Кратность", Валюта, КурсВалюты, КратностьВалюты));
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры	

// Обработчик события ПриСозданииНаСервере формы выбора КПС. 
// Устанавливает необходимые отборы списка.
//
// Параметры:
//	Форма - создаваемая форма
//	Отказ - признак отказа
//
Процедура ПриСозданииНаСервереФормыВыбораКПС(Отказ, Форма) Экспорт
	
	Перем СтруктураОграничений;
	
	УстановитьОтбор = Ложь;

	ОпределениеОграниченийВыбора(УстановитьОтбор, СтруктураОграничений, Форма.Параметры.ДополнительныйОтбор, Форма.Параметры, Форма.Список.Отбор);
		
	Если УстановитьОтбор Тогда
		
		Форма.НаДату = СтруктураОграничений.УстанавливаемаяДата;
		
		ОтборВидовКПС = ПолучитьВидыКПСПоУчетнойПолитикеИОграничениям(СтруктураОграничений.ОтборПоОграничениям, СтруктураОграничений.ОтборПоУчетнойПолитике); 
		
		ПредставлениеОтбора = СтрСоединить(ОтборВидовКПС.ВыгрузитьЗначения(), "; ");
		
		Если НЕ ЗначениеЗаполнено(ПредставлениеОтбора) Тогда
			ПредставлениеОтбора = "Не найдено";
		КонецЕсли;	
		
		ОтборВидовКПС.Добавить(Перечисления.ВидыКБК.ПустаяСсылка());
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Форма.Список.Отбор, "ВидПоказателя", ОтборВидовКПС, ВидСравненияКомпоновкиДанных.ВСписке,, Истина);
		
		Если НЕ ОтборВидовКПС.НайтиПоЗначению(ПредопределенноеЗначение("Перечисление.ВидыКБК.АУИБУ")) = Неопределено И ТипЗнч(СтруктураОграничений.ОтборПоОграничениям) = Тип("Массив") Тогда
			
			ОтборУточнениеКПС = ПолучитьУточнениеКПС(СтруктураОграничений.ОтборПоОграничениям);
			
			Если ОтборУточнениеКПС.Количество() > 1 Тогда
				ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Форма.Список.Отбор, "УточнениеПоказателя", ОтборУточнениеКПС, ВидСравненияКомпоновкиДанных.ВСписке,, Истина);
			КонецЕсли;
		КонецЕсли;

		Если ТипЗнч(СтруктураОграничений.ОтборПоСоставляющим) = Тип("Структура") Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Форма.Список.Отбор, "РазделПодразделКРБ",			СтруктураОграничений.ОтборПоСоставляющим.РазделПодразделКРБ,		ВидСравненияКомпоновкиДанных.Равно,, Истина);
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Форма.Список.Отбор, "ЦелеваяСтатьяКРБ",			СтруктураОграничений.ОтборПоСоставляющим.ЦелеваяСтатьяКРБ,			ВидСравненияКомпоновкиДанных.Равно,, Истина);
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Форма.Список.Отбор, "ПрограммаЦелевойСтатьиКРБ",	СтруктураОграничений.ОтборПоСоставляющим.ПрограммаЦелевойСтатьиКРБ,	ВидСравненияКомпоновкиДанных.Равно,, Истина);
			Если ОбщегоНазначенияБГУ.ЭлементЯвляетсяГруппой(СтруктураОграничений.ОтборПоСоставляющим.ВидРасходаКРБ) Тогда
				ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Форма.Список.Отбор, "ВидРасходаКРБ",			СтруктураОграничений.ОтборПоСоставляющим.ВидРасходаКРБ,				ВидСравненияКомпоновкиДанных.ВИерархии,, Истина);
				ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(Форма.Список.Отбор, "ВидРасходаКРБ",			ВидСравненияКомпоновкиДанных.НеРавно,								СтруктураОграничений.ОтборПоСоставляющим.ВидРасходаКРБ,,Истина);
			Иначе
				ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Форма.Список.Отбор, "ВидРасходаКРБ",			СтруктураОграничений.ОтборПоСоставляющим.ВидРасходаКРБ,				ВидСравненияКомпоновкиДанных.Равно,, Истина);
			КонецЕсли;
		КонецЕсли;
				
		Форма.ВидыПоказателей = ПредставлениеОтбора;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Форма.НаДату) Тогда
		Форма.НаДату = ТекущаяДатаСеанса();
	КонецЕсли;
	
	БюджетнаяКлассификацияКлиентСервер.УстановитьОтборНаДату(Форма, Форма.НаДату);
	 
КонецПроцедуры

Процедура ОпределениеОграниченийВыбора(УстановитьОтбор, СтруктураОграничений, ПараметрыДополнительныйОтбор = Неопределено, Параметры, СписокОтбор = Неопределено) Экспорт 
	
	Перем ЗначенияФильтра;
	Перем УстанавливаемаяДата;
	
	СтруктураОграничений = Новый Структура("ОтборПоОграничениям,ОтборПоУчетнойПолитике,ОтборПоСоставляющим,УстанавливаемаяДата");
	
	Если ТипЗнч(ПараметрыДополнительныйОтбор) = Тип("Структура") Тогда
		
		УстановитьОтбор = Истина;
		
		ПараметрыДополнительныйОтбор.Свойство("НаДату", СтруктураОграничений.УстанавливаемаяДата);
		
		Если ПараметрыДополнительныйОтбор.Свойство("ОграниченияКПС", ЗначенияФильтра) Тогда
			СтруктураОграничений.ОтборПоОграничениям = ПолучитьЗначенияОтбораКПСПоСпискуОграничений(ЗначенияФильтра);
		КонецЕсли;
		
		Если ПараметрыДополнительныйОтбор.Свойство("ОграниченияУчетнойПолитики", ЗначенияФильтра) Тогда
			СтруктураОграничений.ОтборПоУчетнойПолитике = ПолучитьЗначенияОтбораКПСПоУчетнойПолитике(ЗначенияФильтра);
		КонецЕсли;	
		
		Если ПараметрыДополнительныйОтбор.Свойство("ГруппаОтбораПоВР", ЗначенияФильтра) Тогда
			СтруктураОграничений.ОтборПоСоставляющим = Новый Структура;
			СтруктураОграничений.ОтборПоСоставляющим.Вставить("РазделПодразделКРБ"			,ЗначенияФильтра.РазделПодразделКРБ);
			СтруктураОграничений.ОтборПоСоставляющим.Вставить("ЦелеваяСтатьяКРБ"			,ЗначенияФильтра.ЦелеваяСтатьяКРБ);
			СтруктураОграничений.ОтборПоСоставляющим.Вставить("ПрограммаЦелевойСтатьиКРБ"	,ЗначенияФильтра.ПрограммаЦелевойСтатьиКРБ);
			СтруктураОграничений.ОтборПоСоставляющим.Вставить("ВидРасходаКРБ"				,ЗначенияФильтра.ВидРасходаКРБ);
		КонецЕсли;
		
		// Для ввода начальных остатков:
		Если ПараметрыДополнительныйОтбор.Свойство("НаДатуНачалаСледующегоГода") И ПараметрыДополнительныйОтбор.НаДатуНачалаСледующегоГода = Истина Тогда
			СтруктураОграничений.УстанавливаемаяДата = КонецГода(СтруктураОграничений.УстанавливаемаяДата) + 1;
		КонецЕсли;
		
	ИначеЕсли Параметры.Свойство("Отбор") И ТипЗнч(Параметры.Отбор) = Тип("Структура") И Параметры.Отбор.Количество() > 0 Тогда
		// пробуем установить ограгичения по переданному отбору
		
		УстановитьОтбор = Истина;
		
		ОграниченияУчетнойПолитики = Новый Структура;
		ОграниченияКПС	= Неопределено;
		
		Если Параметры.Отбор.Свойство("Организация") Тогда
			ОграниченияУчетнойПолитики.Вставить("Организация", Параметры.Отбор.Организация);
		КонецЕсли;
		Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") И Параметры.Отбор.Свойство("ИФО") Тогда
			ОграниченияУчетнойПолитики.Вставить("ИФО", Параметры.Отбор.ИФО);
		КонецЕсли;
		Если Параметры.Отбор.Свойство("КФО") Тогда
			ОграниченияУчетнойПолитики.Вставить("КФО", Параметры.Отбор.КФО);
		КонецЕсли;
		Если Параметры.Отбор.Свойство("НаДату") Тогда
			ОграниченияУчетнойПолитики.Вставить("НаДату", Параметры.Отбор.НаДату);
			СтруктураОграничений.УстанавливаемаяДата = Параметры.Отбор.НаДату;
		КонецЕсли;
		
		// Для плановых показателей
		Если Параметры.Свойство("ПериодПлана") И ЗначениеЗаполнено(Параметры.ПериодПлана) Тогда
			СтруктураОграничений.УстанавливаемаяДата = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.ПериодПлана, "ДатаОкончания");	
			Если ЗначениеЗаполнено(СтруктураОграничений.УстанавливаемаяДата) Тогда
				ОграниченияУчетнойПолитики.Вставить("НаДату", СтруктураОграничений.УстанавливаемаяДата);
			КонецЕсли;
		КонецЕсли;	
		
		// Для ввода начальных остатков:
		Если Параметры.Отбор.Свойство("НаДатуНачалаСледующегоГода") И Параметры.Отбор.НаДатуНачалаСледующегоГода = Истина Тогда
			СтруктураОграничений.УстанавливаемаяДата = КонецГода(СтруктураОграничений.УстанавливаемаяДата) + 1;
			ОграниченияУчетнойПолитики.Вставить("НаДату", СтруктураОграничений.УстанавливаемаяДата);
		КонецЕсли;
		
		Если ОграниченияУчетнойПолитики.Свойство("Организация") Тогда
			СтруктураОграничений.ОтборПоУчетнойПолитике = ПолучитьЗначенияОтбораКПСПоУчетнойПолитике(ОграниченияУчетнойПолитики);
		КонецЕсли;
		
		Если Параметры.Отбор.Свойство("ВидПоказателя") Тогда
			ОграниченияКПС	= Параметры.Отбор.ВидПоказателя;
		ИначеЕсли НЕ СписокОтбор = Неопределено И СписокОтбор.Элементы.Количество() > 0 Тогда
			Если НЕ СписокОтбор.ДоступныеПоляОтбора.Элементы.Найти("ВидПоказателя") = Неопределено Тогда
				Для Каждого ЭлементОтбора ИЗ СписокОтбор.Элементы Цикл
					Если  ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") 
						И ЭлементОтбора.ЛевоеЗначение = СписокОтбор.ДоступныеПоляОтбора.Элементы.Найти("ВидПоказателя").Поле Тогда
						
						ОграниченияКПС = ЭлементОтбора.ПравоеЗначение;	
						Прервать;
						
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		ИначеЕсли Параметры.Отбор.Свойство("ОграниченияКПС") Тогда
			ОграниченияКПС = ПолучитьЗначенияОтбораКПСПоСпискуОграничений(Параметры.Отбор.ОграниченияКПС);
		КонецЕсли;
		
		Если НЕ ОграниченияКПС	= Неопределено Тогда
			СтруктураОграничений.ОтборПоОграничениям = ПолучитьЗначенияОтбораКПСПоСпискуОграничений(ОграниченияКПС);
		КонецЕсли;
			
	КонецЕсли;

КонецПроцедуры

Функция ЗначениеЭлементаОтбора(ТипЗначенияЭлемента, ЗначениеЭлементаОтбора) Экспорт
	
	МетаданныеОбъекта = Метаданные.НайтиПоТипу(ТипЗначенияЭлемента.Типы()[0]);
	МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(МетаданныеОбъекта.ПолноеИмя());
	ЗначенияДляПоиска = СтрРазделить(ЗначениеЭлементаОтбора, ",");
	Результат = Новый Массив;
	Для Каждого ЗначениеПоиска Из ЗначенияДляПоиска Цикл
		Если ЗначениеЗаполнено(ЗначениеПоиска) Тогда
			ЗначениеПоКоду = МенеджерОбъекта.НайтиПоКоду(СокрЛП(ЗначениеПоиска));
		Иначе
			ЗначениеПоКоду = МенеджерОбъекта.ПустаяСсылка();
		КонецЕсли;
		Результат.Добавить(ЗначениеПоКоду);
	КонецЦикла;
	
	Если Результат.Количество() = 1 Тогда
		Возврат Результат[0];
	Иначе
		Возврат Результат;
	КонецЕсли;
	
КонецФункции


// Обработчик события ПриСозданииНаСервере формы выбора полного рабочего счета. 
// Устанавливает необходимые отборы списка.
//
// Параметры:
//	Форма - создаваемая форма
//	Отказ - признак отказа
//
Процедура ПриСозданииНаСервереФормыВыбораРабочегоСчета(Отказ, Форма) Экспорт
	
	Перем ОтборПоОграничениям, ОтборПоУчетнойПолитике, ОтборКФО, ЗначенияФильтра;
	
	// Отбор по дате актуальности
	Если ТипЗнч(Форма.Параметры.ДополнительныйОтбор) = Тип("Структура") Тогда
		Если Форма.Параметры.ДополнительныйОтбор.Свойство("НаДату", ЗначенияФильтра) Тогда
			Форма.НаДату = ЗначенияФильтра;
			Форма.Элементы.НаДату.ТолькоПросмотр = Истина;
		Иначе
			Форма.НаДату = ТекущаяДатаСеанса();
		КонецЕсли;
	Иначе
		Форма.НаДату = ТекущаяДатаСеанса();
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Форма.Список, "Период", Форма.НаДату, Истина);
	
	Если НЕ ТипЗнч(Форма.Параметры.ДополнительныйОтбор) = Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	// Отбор по счету
	Если Форма.Параметры.ДополнительныйОтбор.Свойство("Счет", ЗначенияФильтра) Тогда
		Если ОбщегоНазначения.ЗначениеСсылочногоТипа(ЗначенияФильтра) И ОбщегоНазначения.ВидОбъектаПоСсылке(ЗначенияФильтра) = "ПланСчетов" Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Форма.ЕПСБУ.Отбор, "Ссылка", ЗначенияФильтра, ВидСравненияКомпоновкиДанных.ВИерархии,, Истина);
		Иначе
			// передан список или массив счетов
			ОтборПоОграничениям = Новый СписокЗначений;
			Если ТипЗнч(ЗначенияФильтра) = Тип("СписокЗначений") Тогда
				Для Каждого Элемент Из ЗначенияФильтра Цикл
					Если ТипЗнч(Элемент.Значение) = Тип("Строка") Тогда
						СчетОграничения = СчетПоКоду(Элемент.Значение, Форма.НаДату, Форма.Организация);
						Если ЗначениеЗаполнено(СчетОграничения) Тогда
							ОтборПоОграничениям.Добавить(СчетОграничения);
						КонецЕсли;
					Иначе
						ОтборПоОграничениям.Добавить(Элемент.Значение);
					КонецЕсли;
				КонецЦикла;
			ИначеЕсли ТипЗнч(ЗначенияФильтра) = Тип("Массив") Тогда
				Для Каждого Элемент Из ЗначенияФильтра Цикл
					Если ТипЗнч(Элемент) = Тип("Строка") Тогда
						СчетОграничения = СчетПоКоду(Элемент, Форма.НаДату, Форма.Организация);
						Если ЗначениеЗаполнено(СчетОграничения) Тогда
							ОтборПоОграничениям.Добавить(СчетОграничения);
						КонецЕсли;
					Иначе
						ОтборПоОграничениям.Добавить(Элемент);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Форма.ЕПСБУ.Отбор, "Ссылка", ОтборПоОграничениям, ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии,, Истина);
		КонецЕсли;
	КонецЕсли;
	
	// Отбор по Учетной политике
	Если Форма.Параметры.ДополнительныйОтбор.Свойство("ОграниченияУчетнойПолитики", ЗначенияФильтра) Тогда
		
		// Организация
		Если ЗначенияФильтра.Свойство("Организация", Форма.Организация) Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Форма.Список.Отбор, "Организация", Форма.Организация, ВидСравненияКомпоновкиДанных.Равно,, Истина);
			Форма.Элементы.Организация.ТолькоПросмотр = ЗначениеЗаполнено(Форма.Организация);
		КонецЕсли;
		
		//ИФО
		Если ЗначенияФильтра.Свойство("ИФО", Форма.ИФО) Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Форма.Список.Отбор, "ИФО", Форма.ИФО, ВидСравненияКомпоновкиДанных.Равно,, Истина);
			Форма.Элементы.ИФО.ТолькоПросмотр = ЗначениеЗаполнено(Форма.ИФО);
		КонецЕсли;
		
		ЗначенияФильтра.Вставить("НаДату", Форма.НаДату);
		
		// Допустимые КФО (массив)
		
		ОтборКФО = ПолучитьЗначенияОтбораКФОПоУчетнойПолитике(ЗначенияФильтра);
		СписокКФО = Новый СписокЗначений;
		СписокКФО.ЗагрузитьЗначения(ОтборКФО);
		Форма.Элементы.КФО.СписокВыбора.ЗагрузитьЗначения(ОтборКФО);
		Форма.Элементы.КФО.РежимВыбораИзСписка = Истина;
		
		Если ЗначенияФильтра.Свойство("КФО", Форма.КФО) Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Форма.Список.Отбор, "КФО", Форма.КФО, ВидСравненияКомпоновкиДанных.Равно,, Истина);
		Иначе
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Форма.Список.Отбор, "КФО", СписокКФО, ВидСравненияКомпоновкиДанных.ВСписке,, Истина);
		КонецЕсли;
		
		ОтборПоУчетнойПолитике = ПолучитьЗначенияОтбораКПСПоУчетнойПолитике(ЗначенияФильтра);
		
		// Тип плана счетов учреждения
		СтруктураРПС = БухгалтерскийУчетПовтИсп.ТекущаяСтруктураРПС(Форма.Организация, Форма.ИФО, Форма.НаДату);
		Если СтруктураРПС = Неопределено Тогда
			ТипПланаСчетов = Неопределено;
		Иначе
			ТипПланаСчетов = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтруктураРПС, "ТипПланаСчетов");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТипПланаСчетов) Тогда
			Если ТипПланаСчетов = ПредопределенноеЗначение("Перечисление.ТипыПлановСчетов.ДляАвтономных") Тогда
				ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Форма.ЕПСБУ, "ДляАвтономных", Истина, , , Истина);
			ИначеЕсли ТипПланаСчетов = ПредопределенноеЗначение("Перечисление.ТипыПлановСчетов.ДляБюджетных") Тогда
				ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Форма.ЕПСБУ, "ДляБюджетных", Истина, , , Истина);
			ИначеЕсли ТипПланаСчетов = ПредопределенноеЗначение("Перечисление.ТипыПлановСчетов.ДляКазенных") Тогда
				ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Форма.ЕПСБУ, "ДляКазенных", Истина, , , Истина);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	// Отбор по видам КПС
	
	Если Форма.Параметры.ДополнительныйОтбор.Свойство("ОграниченияКПС", ЗначенияФильтра) Тогда
		ОтборПоОграничениям = ПолучитьЗначенияОтбораКПСПоСпискуОграничений(ЗначенияФильтра);
	КонецЕсли;
	
	ОтборВидовКПС = ПолучитьВидыКПСПоУчетнойПолитикеИОграничениям(ОтборПоОграничениям, ОтборПоУчетнойПолитике); 
	
	Форма.ВидПоказателя = СтрСоединить(ОтборВидовКПС.ВыгрузитьЗначения(), "; ");
	
	ОтборВидовКПС.Добавить(Перечисления.ВидыКБК.ПустаяСсылка());
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Форма.Список.Отбор, "КПС.ВидПоказателя", ОтборВидовКПС, ВидСравненияКомпоновкиДанных.ВСписке,, Истина);
	
	Если НЕ ОтборВидовКПС.НайтиПоЗначению(ПредопределенноеЗначение("Перечисление.ВидыКБК.АУИБУ")) = Неопределено И ТипЗнч(ОтборПоОграничениям) = Тип("Массив") Тогда
		//отбор по показателю уточнения 
		ОтборУточнениеКПС = Новый СписокЗначений;
		ОтборУточнениеКПС.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.ПустаяСсылка"));
		
		Если НЕ ОтборПоОграничениям.Найти(ПредопределенноеЗначение("Перечисление.ВидыКБК.КДБ")) = Неопределено Тогда
			ОтборУточнениеКПС.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.КДБ"));
		КонецЕсли;
		Если НЕ ОтборПоОграничениям.Найти(ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ")) = Неопределено Тогда
			ОтборУточнениеКПС.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ"));
		КонецЕсли;
		Если НЕ ОтборПоОграничениям.Найти(ПредопределенноеЗначение("Перечисление.ВидыКБК.КИФ")) = Неопределено Тогда
			ОтборУточнениеКПС.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.КИФ"));
		КонецЕсли;
		Если НЕ ОтборПоОграничениям.Найти(ПредопределенноеЗначение("Перечисление.ВидыКБК.гКБК")) = Неопределено Тогда
			ОтборУточнениеКПС.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.гКБК"));
		КонецЕсли;
		
		Если ОтборУточнениеКПС.Количество() > 1 Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Форма.Список.Отбор, "КПС.УточнениеПоказателя", ОтборУточнениеКПС, ВидСравненияКомпоновкиДанных.ВСписке,, Истина);
		КонецЕсли;
		
	КонецЕсли;
	
	// Начальные значения выбора
	Если Форма.Параметры.ДополнительныйОтбор.Свойство("ТекущаяСтрока", ЗначенияФильтра) Тогда
		Если ЗначенияФильтра.Свойство("Счет", ОтборПоОграничениям) Тогда
			Форма.Элементы.ЕПСБУ.ТекущаяСтрока = ОтборПоОграничениям;
		КонецЕсли;
		
		Запрос = Новый Запрос("ВЫБРАТЬ
		|	РабочиеСчетаСрезПоследних.Период,
		|	РабочиеСчетаСрезПоследних.Организация,
		|	РабочиеСчетаСрезПоследних.ИФО,
		|	РабочиеСчетаСрезПоследних.КФО,
		|	РабочиеСчетаСрезПоследних.Счет,
		|	РабочиеСчетаСрезПоследних.КПС,
		|	РабочиеСчетаСрезПоследних.Актуален
		|ИЗ
		|	РегистрСведений.РабочиеСчета.СрезПоследних(
		|			&Дата,
		|			Актуален = ИСТИНА
		|				И КПС = &КПС
		|				И КФО = &КФО
		|				И Счет = &Счет" + "
		|" + ?(ЗначенияФильтра.Свойство("Организация"), "И Организация = &Организация", "") + "
		|" + ?(ЗначенияФильтра.Свойство("ИФО"), "И ИФО = &ИФО", "") + "
		|) КАК РабочиеСчетаСрезПоследних");
		
		Запрос.УстановитьПараметр("Дата", Форма.НаДату);
		Запрос.УстановитьПараметр("КПС", ЗначенияФильтра.КПС);
		Запрос.УстановитьПараметр("КФО", ЗначенияФильтра.КФО);
		Запрос.УстановитьПараметр("Счет", ЗначенияФильтра.Счет);
		Запрос.УстановитьПараметр("Организация", ?(ЗначенияФильтра.Свойство("Организация"), ЗначенияФильтра.Организация, Неопределено));
		Запрос.УстановитьПараметр("ИФО", ?(ЗначенияФильтра.Свойство("ИФО"), ЗначенияФильтра.ИФО, Неопределено));
		
		Таб = Запрос.Выполнить().Выгрузить();
		
		Если Таб.Количество() > 0 Тогда
			
			СтрКлюча = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(Таб[0]);
			
			Форма.Элементы.Список.ТекущаяСтрока = РегистрыСведений.РабочиеСчета.СоздатьКлючЗаписи(СтрКлюча);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Обработчик события ПриСозданииНаСервере формы выбора Справочника КОСГУ (КЭК). 
// Устанавливает необходимые отборы списка.
//
// Параметры:
//	Форма - создаваемая форма
//	Отказ - признак отказа
//
Процедура ПриСозданииНаСервереФормыВыбораКЭК(Отказ, Форма) Экспорт
	
	// установка отбора из настройки типовой операции
	БухгалтерскиеОперацииСервер.УстановитьОтборСпискаИзНастроекКомпоновки(Форма.Список, Форма.Параметры, Форма);
	
	ОтборПоОграничениям = Новый Массив;
	Комментарий = "";
	
	ОтборПоОграничениям = ОграниченияКЭК(Форма.Параметры, Комментарий);
	
	Если ОтборПоОграничениям.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(Комментарий) Тогда
		Форма.Элементы.КомментарийОтбора.Видимость = Истина;		
		Форма.КомментарийОтбора = Комментарий;
	КонецЕсли;		
	
	ЕстьКЭК0 = ОтборПоОграничениям.Найти(БухгалтерскийУчетПовтИсп.КЭК0());
	
	Если НЕ ЕстьКЭК0 = Неопределено Тогда
		ОтборПоОграничениям.Удалить(ЕстьКЭК0);	
	КонецЕсли;	
	
	ОграниченияКЭК = Новый СписокЗначений;
	ОграниченияКЭК.ЗагрузитьЗначения(ОтборПоОграничениям);
	
	Если НЕ ЕстьКЭК0 = Неопределено Тогда
		ГруппаИЛИ = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(Форма.Список.Отбор.Элементы, "ГруппаИЛИ", ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли);
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаИЛИ, "Ссылка", ВидСравненияКомпоновкиДанных.Равно, БухгалтерскийУчетПовтИсп.КЭК0());
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаИЛИ, "Ссылка", ВидСравненияКомпоновкиДанных.ВСписке, ОграниченияКЭК);
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Форма.Список.Отбор, "Ссылка", ОграниченияКЭК, ВидСравненияКомпоновкиДанных.ВСписке,, Истина);
	КонецЕсли;	
	
	Форма.Элементы.Список.Отображение = ОтображениеТаблицы.Список;
	
КонецПроцедуры	

Функция ОграниченияКЭК(Параметры, Комментарий = "") Экспорт
	
	Перем Счет, ВидСравнения, ОтображениеСписка;
	Перем Организация, ИФО, КФО, НаДату;
	
	ОтборПоОграничениям = Новый Массив;
	
	Если НЕ Параметры.Свойство("ДополнительныйОтбор") Тогда
		Возврат ОтборПоОграничениям;
	КонецЕсли;	
	
	Если ТипЗнч(Параметры.ДополнительныйОтбор) = Тип("Структура") Тогда
		Если не Параметры.ДополнительныйОтбор.Свойство("Счет") 
			и не  Параметры.ДополнительныйОтбор.Свойство("ОграниченияКЭК") 
			и не  Параметры.ДополнительныйОтбор.Свойство("ГруппаОтбора") 
			и не  Параметры.ДополнительныйОтбор.Свойство("КПС") тогда
			Возврат ОтборПоОграничениям;
		КонецЕсли;
		
		ОтборВИерархии = Ложь;
		Если Параметры.ДополнительныйОтбор.Свойство("ВИЕРАРХИИ")
			И Параметры.ДополнительныйОтбор.ВИЕРАРХИИ = Истина Тогда
			ОтборВИерархии = Истина;
		КонецЕсли;	
		
		Если Параметры.ДополнительныйОтбор.Свойство("Счет", Счет)  Тогда
			Если ТипЗнч(Счет) = Тип("Строка") Тогда
				Счет = СчетПоКоду(Счет);
			КонецЕсли;	
			
			Если ОбщегоНазначения.ВидОбъектаПоСсылке(Счет) = "ПланСчетов" Тогда
				
				Комментарий = "Отбор по счету: " + Счет;
				
				Если Параметры.ДополнительныйОтбор.Свойство("ДК") И ЗначениеЗаполнено(Параметры.ДополнительныйОтбор.ДК) Тогда
					КЭКСчета = Счет["КОСГУ" + Параметры.ДополнительныйОтбор.ДК];
				Иначе
					КЭКСчета = Справочники.КОСГУ.ПустаяСсылка();
				КонецЕсли;
				
				Если ЗначениеЗаполнено(КЭКСчета) Тогда
					
					ОтборВИерархии = Истина;
					
					Если Параметры.ДополнительныйОтбор.Свойство("ОграниченияУчетнойПолитики") Тогда
						
						Параметры.ДополнительныйОтбор.ОграниченияУчетнойПолитики.Свойство("Организация", Организация);
						Параметры.ДополнительныйОтбор.ОграниченияУчетнойПолитики.Свойство("ИФО", ИФО);
						Параметры.ДополнительныйОтбор.ОграниченияУчетнойПолитики.Свойство("КФО", КФО);
						Параметры.ДополнительныйОтбор.Свойство("НаДату", НаДату);
						
						Если Не ЗначениеЗаполнено(НаДату) Тогда
							НаДату = ТекущаяДатаСеанса();
						КонецЕсли;	
						
						Если БухгалтерскийУчетПовтИсп.ТипКЭКПоУчетнойПолитике(Организация, ИФО, КФО, НаДату) = Перечисления.ТипыАналитическихПризнаков.ПроизвольнаяКлассификация Тогда
							КЭКСчета = БухгалтерскийУчетПовтИсп.КЭК0();
							ОтборВИерархии = Ложь;
						КонецЕсли;
					Иначе
						
						ОтборПоОграничениям.Добавить(БухгалтерскийУчетПовтИсп.КЭК0());
						
					КонецЕсли;
					
					ЭтоГрупповойКЭКСчета340и440 = СтрРазделить("340,440", ",").Найти(КЭКСчета.Код) <> Неопределено;
					ПрименяетсяДетальныйКЭК340и440 = Не Параметры.ДополнительныйОтбор.Свойство("Дата")
						Или Не Параметры.ДополнительныйОтбор.Свойство("Организация")
						Или БухгалтерскийУчетКлиентСервер.ПрименяетсяДетальныйКЭК340и440(
							Параметры.ДополнительныйОтбор.Дата, 
							Параметры.ДополнительныйОтбор.Организация); 
					
					Если Не ЭтоГрупповойКЭКСчета340и440 Или ПрименяетсяДетальныйКЭК340и440 Тогда
						ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ОтборПоОграничениям,
							СписокКЭК(КЭКСчета, Не ОтборВИерархии), Истина);
					Иначе
						ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ОтборПоОграничениям,
							ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(КЭКСчета), Истина);
					КонецЕсли;
					
				Иначе
					
					Запрос = Новый Запрос;
					Запрос.Текст = "ВЫБРАТЬ
					|	КЭКСчетов.КЭК КАК КЭК
					|ПОМЕСТИТЬ КЭКСчетов
					|ИЗ
					|	РегистрСведений.КЭКСчетов КАК КЭКСчетов
					|ГДЕ
					|	КЭКСчетов.Счет = &Счет
					|	И КЭКСчетов.Использовать = ИСТИНА
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ
					|	КОСГУ.Ссылка КАК КЭК
					|ИЗ
					|	Справочник.КОСГУ КАК КОСГУ
					|ГДЕ
					|	КОСГУ.Ссылка В ИЕРАРХИИ
					|			(ВЫБРАТЬ
					|				КЭКСчетов.КЭК КАК КЭК
					|			ИЗ
					|				КЭКСчетов)
					|	И (&ДополнительноеУсловие)";
					
					Если ОтборВИерархии Тогда
						// В запрос включаются КЭК-группы
						Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДополнительноеУсловие", "ИСТИНА");
					Иначе
						// В запрос не включаются КЭК-группы.
						// Исключение - КЭК 340, 440, 460.
						Запрос.Текст = СтрЗаменить(Запрос.Текст, "Справочник.КОСГУ КАК КОСГУ",
							"Справочник.КОСГУ КАК КОСГУ
							|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КОСГУ КАК КОСГУГРУППА
							|		ПО КОСГУ.Ссылка = КОСГУГРУППА.Родитель");
						Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДополнительноеУсловие",
							"КОСГУГРУППА.Ссылка ЕСТЬ NULL ИЛИ КОСГУ.Код В (&Код460)");
					КонецЕсли;
					
					Запрос.УстановитьПараметр("Счет", Счет);
					Запрос.УстановитьПараметр("Код460", СтрРазделить("340,440,460", ","));
					
					ОтборПоОграничениям = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("КЭК");
					
					Если ОтборПоОграничениям.Количество() = 0 Тогда
						Возврат ОтборПоОграничениям;
					КонецЕсли;
					
					Если ОтборПоОграничениям.Найти(БухгалтерскийУчетПовтИсп.КЭК0()) = Неопределено Тогда
						ОтборПоОграничениям.Добавить(БухгалтерскийУчетПовтИсп.КЭК0());
					КонецЕсли;	 
					
				КонецЕсли;
				
				// Для межотчетного периода  
				Если Параметры.Свойство("ПоказатьСкрытыеКоды") И Параметры.ПоказатьСкрытыеКоды Тогда
					МассивСчетов = СписокСчетов(ПланыСчетов.ЕПСБУ.КодыСчетовРасчетовКИСЕ());
					Если НЕ МассивСчетов.Найти(Счет) = Неопределено Тогда  
						МассивКодов = Новый Массив;
						МассивКодов.Добавить("001");
						МассивКодов.Добавить("002");
						МассивКодов.Добавить("003");
						МассивКодов.Добавить("004");
						МассивКодов.Добавить("005");
						МассивКодов.Добавить("006");
						МассивКодов.Добавить("007");
						МассивКодов.Добавить("008");
						МассивКодов.Добавить("009");
						Запрос = Новый Запрос("
						|ВЫБРАТЬ
						|	КОСГУ.Ссылка КАК Ссылка
						|ИЗ
						|	Справочник.КОСГУ КАК КОСГУ
						|ГДЕ
						|	КОСГУ.Код В(&СписокКодов)");
						Запрос.УстановитьПараметр("СписокКодов", МассивКодов); 
						Выборка = Запрос.Выполнить().Выбрать();
						Пока Выборка.Следующий() Цикл
							ОтборПоОграничениям.Добавить(Выборка.Ссылка);	
						КонецЦикла;
					КонецЕсли;	
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если Параметры.ДополнительныйОтбор.Свойство("КПС") 
			И ЗначениеЗаполнено(Параметры.ДополнительныйОтбор.КПС) Тогда
			
			СвойстваКПС = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Параметры.ДополнительныйОтбор.КПС, "ВидПоказателя, УточнениеПоказателя, Код");
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	СпрКОСГУ.Ссылка КАК КЭК
			|ПОМЕСТИТЬ КЭККПС
			|ИЗ
			|	РегистрСведений.СоответствиеКПСКОСГУ КАК СоответствиеКПСКОСГУ
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КОСГУ КАК СпрКОСГУ
			|		ПО СоответствиеКПСКОСГУ.КОСГУ = СпрКОСГУ.Код
			|			И (НЕ СпрКОСГУ.Ссылка ЕСТЬ NULL)
			|ГДЕ
			|	СоответствиеКПСКОСГУ.ТипДанных = &ТипДанных
			|	И СоответствиеКПСКОСГУ.ВидДохода = &ВидДохода
			|	И СоответствиеКПСКОСГУ.АналитическийКодДохода = &АналитическийКодДохода
			|	И СоответствиеКПСКОСГУ.ВидРасхода = &ВидРасхода
			|	И НЕ СоответствиеКПСКОСГУ.КОСГУ ЕСТЬ NULL
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	КОСГУ.Ссылка КАК КОСГУ
			|ИЗ
			|	Справочник.КОСГУ КАК КОСГУ
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КОСГУ КАК КОСГУГРУППА
			|		ПО КОСГУ.Ссылка = КОСГУГРУППА.Родитель
			|ГДЕ
			|	КОСГУ.Ссылка В ИЕРАРХИИ
			|			(ВЫБРАТЬ
			|				КЭККПС.КЭК КАК КЭК
			|			ИЗ
			|				КЭККПС)
			|	И (КОСГУГРУППА.Ссылка ЕСТЬ NULL 
			|			ИЛИ КОСГУ.Код = ""340""
			|			ИЛИ КОСГУ.Код = ""410""
			|			ИЛИ КОСГУ.Код = ""420""
			|			ИЛИ КОСГУ.Код = ""430"" 
			|			ИЛИ КОСГУ.Код = ""440""
			|			ИЛИ КОСГУ.Код = ""460"")";
			
			Если ОтборВИерархии Тогда
				Запрос.Текст = Запрос.Текст	+ "
				|ИТОГИ ПО
				|	КОСГУ ТОЛЬКО ИЕРАРХИЯ";
			КонецЕсли;	
			
			Если СвойстваКПС.ВидПоказателя = ПредопределенноеЗначение("Перечисление.ВидыКБК.КДБ")
				ИЛИ СвойстваКПС.УточнениеПоказателя = ПредопределенноеЗначение("Перечисление.ВидыКБК.КДБ") Тогда
				Запрос.УстановитьПараметр("ТипДанных", ПредопределенноеЗначение("Перечисление.ВидыКБК.КДБ"));
				Если СвойстваКПС.ВидПоказателя = ПредопределенноеЗначение("Перечисление.ВидыКБК.КДБ") Тогда
					Запрос.УстановитьПараметр("ВидДохода", Лев(СвойстваКПС.Код, 10));
					Комментарий = Комментарий + ?(ЗначениеЗаполнено(Комментарий),
					", ", "Отбор по") + " КВД: " + Лев(СвойстваКПС.Код, 10);
				Иначе
					Запрос.УстановитьПараметр("ВидДохода", "");
				КонецЕсли;
				Запрос.УстановитьПараметр("АналитическийКодДохода", Прав(СвойстваКПС.Код, 3));
				Комментарий = Комментарий + ?(ЗначениеЗаполнено(Комментарий),
				", ", "Отбор по") + " аналитическому коду: " + Прав(СвойстваКПС.Код, 3);
				Запрос.УстановитьПараметр("ВидРасхода", "");
			ИначеЕсли СвойстваКПС.ВидПоказателя = ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ")
				ИЛИ СвойстваКПС.УточнениеПоказателя = ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ") Тогда
				Запрос.УстановитьПараметр("ТипДанных", ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ"));
				Запрос.УстановитьПараметр("ВидДохода", "");
				Запрос.УстановитьПараметр("АналитическийКодДохода", "");
				Запрос.УстановитьПараметр("ВидРасхода", Прав(СвойстваКПС.Код, 3));
				Комментарий = Комментарий + ?(ЗначениеЗаполнено(Комментарий),
				", ", "Отбор по") + " КВР: " + Прав(СвойстваКПС.Код, 3);
			Иначе
				Запрос.УстановитьПараметр("ТипДанных", "");
				Запрос.УстановитьПараметр("ВидДохода", "");
				Запрос.УстановитьПараметр("АналитическийКодДохода", "");
				Запрос.УстановитьПараметр("ВидРасхода", "");
			КонецЕсли;
			
			РезультатЗапроса = Запрос.Выполнить();
			
			Если НЕ РезультатЗапроса.Пустой() Тогда
				
				МассивКодовКОСГУ = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("КОСГУ");
				ОтборПоОграничениямПредв = Новый Массив;
				Если МассивКодовКОСГУ.Количество() > 0 Тогда
					Для каждого КодКОСГУ из МассивКодовКОСГУ цикл
						Если ЗначениеЗаполнено(КодКОСГУ) И ОтборПоОграничениямПредв.Найти(КодКОСГУ) = Неопределено  тогда
							ОтборПоОграничениямПредв.Добавить(КодКОСГУ);
						КонецЕсли;	
					КонецЦикла;
				КонецЕсли;	
				
				Если ОтборПоОграничениямПредв.Количество() > 0 И ОтборПоОграничениям.Количество() > 0 Тогда
					ОтборПоОграничениям = ОбщегоНазначенияБГУ.ПолучитьПересечениеМассивов(ОтборПоОграничениямПредв, ОтборПоОграничениям);
				Иначе
					Для каждого КодКОСГУ из ОтборПоОграничениямПредв цикл
						Если ОтборПоОграничениям.Найти(КодКОСГУ) = Неопределено  тогда
							ОтборПоОграничениям.Добавить(КодКОСГУ);
						КонецЕсли;	
					КонецЦикла;
				КонецЕсли;	
			КонецЕсли;
			
		КонецЕсли;	
		
		Если Параметры.ДополнительныйОтбор.Свойство("ОграниченияКЭК") Тогда
			СписокОграниченийКЭК = Новый Массив;
			ДобавитьОграничения = Истина;
			
			Если ТипЗнч(Параметры.ДополнительныйОтбор.ОграниченияКЭК) = Тип("Массив") Тогда
				СписокОграниченийКЭК = СписокКЭК(Параметры.ДополнительныйОтбор.ОграниченияКЭК);
			ИначеЕсли ТипЗнч(Параметры.ДополнительныйОтбор.ОграниченияКЭК) = Тип("СписокЗначений") Тогда
				СписокОграниченийКЭК = Параметры.ДополнительныйОтбор.ОграниченияКЭК.ВыгрузитьЗначения();
			ИначеЕсли ТипЗнч(Параметры.ДополнительныйОтбор.ОграниченияКЭК) = Тип("Строка") Тогда
				СписокОграниченийКЭК = СписокКЭК(Параметры.ДополнительныйОтбор.ОграниченияКЭК);
			Иначе
				ДобавитьОграничения = Ложь;
			КонецЕсли;
			
			Если ДобавитьОграничения Тогда
				
				Если Параметры.ДополнительныйОтбор.Свойство("ВСпискеОграниченияКЭК") 
					И НЕ Параметры.ДополнительныйОтбор.ВСпискеОграниченияКЭК Тогда
					Запрос = Новый Запрос("ВЫБРАТЬ
					|	КОСГУ.Ссылка КАК Ссылка
					|ИЗ
					|	Справочник.КОСГУ КАК КОСГУ
					|ГДЕ
					|	НЕ КОСГУ.Ссылка В (&СписокСсылок)
					|			И НЕ КОСГУ.Ссылка В ИЕРАРХИИ (&СписокСсылок)");
					Запрос.УстановитьПараметр("СписокСсылок", СписокОграниченийКЭК);
					СписокОграниченийКЭК = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
				КонецЕсли;	
				
				Если СписокОграниченийКЭК.Количество() > 0 И ОтборПоОграничениям.Количество() > 0 Тогда
					ОтборПоОграничениям = ОбщегоНазначенияБГУ.ПолучитьПересечениеМассивов(СписокОграниченийКЭК, ОтборПоОграничениям);
				Иначе
					Для каждого ЭлементКЭК из СписокОграниченийКЭК цикл
						Если ОтборПоОграничениям.Найти(ЭлементКЭК) = неопределено  тогда
							ОтборПоОграничениям.Добавить(ЭлементКЭК);
						КонецЕсли;	
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если Параметры.ДополнительныйОтбор.Свойство("ГруппаОтбора") Тогда
			СписокОграниченийКЭК = Новый СписокЗначений;
			Индекс = ОтборПоОграничениям.Количество() - 1;
			Пока Индекс  >= 0 цикл
				Если ОтборПоОграничениям[Индекс].ЭтоГруппа или (не ОтборПоОграничениям[Индекс].ПринадлежитЭлементу(Параметры.ДополнительныйОтбор.ГруппаОтбора)) тогда
					ОтборПоОграничениям.Удалить(Индекс)
				КонецЕсли;
				Индекс = Индекс - 1;
			КонецЦикла;	
		КонецЕсли;	
		
	КонецЕсли;
	
	Возврат ОтборПоОграничениям;
	
КонецФункции	

// Обработчик события ПриОбработкеПолученияДанных менеджера перечисления КВД.
// Проверяет необходимость отбора элементов по учетной политике организации, а так же
// если задан отбор при настройке типовой операции
//
Процедура ПриОбработкеПолученияДанныхВыбораКВД(ДанныеВыбора, Параметры, СтандартнаяОбработка) Экспорт
	
	ОтборКВД = Неопределено;
	Если Параметры.Свойство("Организация") Тогда
		Организация = Параметры.Организация;
		НаДату = Неопределено;
		ИФО = Неопределено;
		Параметры.Свойство("НаДату", НаДату);
		Параметры.Свойство("ИФО", ИФО);
		
		// Для ввода начальных остатков:
		НаНачалоСледующегоГода = Неопределено;
		Параметры.Свойство("НаНачалоСледующегоГода", НаНачалоСледующегоГода);
		Если НаНачалоСледующегоГода = Истина И НЕ (НаДату = Неопределено) Тогда
			// Заменяем переданную дату:
			НаДату = КонецГода(НаДату) + 1;
		КонецЕсли;
		
		ОтборКВД = БухгалтерскийУчетПовтИсп.КФОПоУчетнойПолитике(Организация, ИФО, НаДату);
	КонецЕсли;
	Если Параметры.Свойство("Отбор") Тогда
		Если Параметры.Отбор.Свойство("Ссылка") Тогда
			Если ТипЗнч(Параметры.Отбор.Ссылка) = Тип("ФиксированныйМассив") Тогда
				Если ТипЗнч(ОтборКВД) = Тип("Массив") Тогда
					ОтборКВД = ОбщегоНазначенияБГУ.ПолучитьПересечениеМассивов(ОтборКВД, Параметры.Отбор.Ссылка)
				Иначе	
					ОтборКВД = Новый Массив;
					Для Каждого ЭлементМассива Из Параметры.Отбор.Ссылка Цикл
						ОтборКВД.Добавить(ЭлементМассива);
					КонецЦикла;
				КонецЕсли;
			ИначеЕсли ТипЗнч(Параметры.Отбор.Ссылка) = Тип("ПеречислениеСсылка.КВД") Тогда
				ОтборКВД = ОбщегоНазначенияБГУ.ПолучитьПересечениеМассивов(ОтборКВД,
					ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Параметры.Отбор.Ссылка))
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если Параметры.Свойство("ЛицевойСчет") Тогда
		ЛицевойСчет = Параметры.ЛицевойСчет;
		КФОПоЛСиИсточникуСредств = ПлатежноРасчетныеДокументыПовтИсп.ДопустимыеКФО(, ЛицевойСчет);
		ОтборКВД = ОбщегоНазначенияБГУ.ПолучитьПересечениеМассивов(ОтборКВД, КФОПоЛСиИсточникуСредств);
	КонецЕсли;
	Если Параметры.Свойство("СтрокаПоиска") И ЗначениеЗаполнено(Параметры.СтрокаПоиска) Тогда
		Если ТипЗнч(ОтборКВД) = Тип("Массив") Тогда
			КоллекцияЭлементовДляПоиска = ОбщегоНазначенияКлиентСервер.СкопироватьМассив(ОтборКВД);
		Иначе	
			КоллекцияЭлементовДляПоиска = Перечисления.КВД;
		КонецЕсли;
		ОтборКВД = Новый Массив;
		Для Каждого ЭлементКоллекции Из КоллекцияЭлементовДляПоиска Цикл
			Если Найти(Строка(ЭлементКоллекции), Параметры.СтрокаПоиска) Тогда
				ОтборКВД.Добавить(ЭлементКоллекции);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	БухгалтерскиеОперацииСервер.УстановитьОтборБыстрогоВыбораИзНастроекКомпоновки(ДанныеВыбора,
																				  Параметры,
																				  СтандартнаяОбработка, 
																				  ОтборКВД);
	
КонецПроцедуры

Процедура ДополнитьТекстЗапросаЖурналаУсловиемПоПравам(ТекстЗапроса, ИмяЖурнала, СписокВидовДокументов = Неопределено) Экспорт

	Если СписокВидовДокументов = Неопределено Тогда
		СписокВидовДокументов = Новый СписокЗначений;
	Иначе
		СписокВидовДокументов.Очистить();
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	АвторизованныйПользователь = Пользователи.АвторизованныйПользователь();
	ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(АвторизованныйПользователь.ИдентификаторПользователяИБ);;
	УсловиеЗапроса = "";
	Для каждого ТекДокум Из Метаданные.ЖурналыДокументов[ИмяЖурнала].РегистрируемыеДокументы Цикл
	
		Если ПравоДоступа("Просмотр", ТекДокум, ПользовательИБ) Тогда
			СписокВидовДокументов.Добавить(ТекДокум.Имя, ТекДокум.Представление());
			УсловиеЗапроса = УсловиеЗапроса + "ИЛИ ЖурналДокументовЖурналОпераций.Ссылка ССЫЛКА Документ."+ТекДокум.Имя+Символы.ПС;			
		КонецЕсли;
	
	КонецЦикла;
	УсловиеЗапроса = Сред(УсловиеЗапроса, 5);
	ПозицияГруппировки = Найти(ВРег(ТекстЗапроса), "СГРУППИРОВАТЬ ПО");
	Если ПозицияГруппировки = 0 Тогда
		ТекстЗапроса = ТекстЗапроса
						+ Символы.ПС + "Где" + Символы.ПС + УсловиеЗапроса;
	Иначе
		ТекстЗапроса = Лев(ТекстЗапроса, ПозицияГруппировки-1)
						 + Символы.ПС + "Где" + Символы.ПС + УсловиеЗапроса
						 + Сред(ТекстЗапроса, ПозицияГруппировки);
	КонецЕсли;

КонецПроцедуры

Функция ВедетсяУчетПоПодразделениям(СписокСчетов, СписокСчетовИсключений = Неопределено) Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если СписокСчетовИсключений = Неопределено Тогда
		СписокСчетовИсключений = Новый СписокЗначений;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МАКСИМУМ(ЕПСБУ.УчетПоПодразделениям) КАК УчетПоПодразделениям
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Ссылка В ИЕРАРХИИ(&СписокСчетов)
	|	И НЕ ЕПСБУ.Ссылка В ИЕРАРХИИ (&СписокСчетовИсключений)";
	Запрос.УстановитьПараметр("СписокСчетов",			СписокСчетов);
	Запрос.УстановитьПараметр("СписокСчетовИсключений",	СписокСчетовИсключений);
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат Ложь;
	Иначе
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Возврат (Выборка.УчетПоПодразделениям = Истина);
	КонецЕсли;
	
КонецФункции  

// Возвращает максимальное значение признаков учета для счетов, включая всех подчиненных.
// Коды счетов передаются массивом ссылок. Так же задаются при необходимости счета исключения.
// Возвращается структура с ключами - именами признаков учета. Значения ключей - максимум по каждому признаку учета.
// Если счета не найдены, то все признаки равны Ложь.
//
// Параметры:
//  Счета - Массив Из ПланСчетовСсылка.ЕПСБУ - массив счетов, в иерархии которых получаются признаки
//  СчетаИсключения - Массив Из ПланСчетовСсылка.ЕПСБУ - массив счетов, исключаемых из запроса. 
//  	Исключаются все счета в иерархии.
// 
// Возвращаемое значение:
// Структура - максимум по каждому признаку:
//	* Валютный - Булево - 
//	* Количественный - Булево - 
//	* УчетПоКПС - Булево - 
//	* УчетПоПодразделениям - Булево - 
//	* УчетПоКЭК - Булево - 
//	* РазрешитьНеУказыватьПодразделение - Булево - 
Функция ПолучитьПризнакиУчетаПоСсылкам(Счета, СчетаИсключения = Неопределено) Экспорт
	Если СчетаИсключения = Неопределено Тогда
		СчетаИсключения = Новый Массив;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЕСТЬNULL(МАКСИМУМ(ЕПСБУ.Валютный), ЛОЖЬ) КАК Валютный,
	               |	ЕСТЬNULL(МАКСИМУМ(ЕПСБУ.Количественный), ЛОЖЬ) КАК Количественный,
	               |	ЕСТЬNULL(МАКСИМУМ(ЕПСБУ.УчетПоКПС), ЛОЖЬ) КАК УчетПоКПС,
	               |	ЕСТЬNULL(МАКСИМУМ(ЕПСБУ.УчетПоПодразделениям), ЛОЖЬ) КАК УчетПоПодразделениям,
	               |	ЕСТЬNULL(МАКСИМУМ(ЕПСБУ.РазрешитьНеУказыватьПодразделение), ЛОЖЬ) КАК РазрешитьНеУказыватьПодразделение,
	               |	ЕСТЬNULL(МАКСИМУМ(ЕПСБУ.УчетПоКЭК), ЛОЖЬ) КАК УчетПоКЭК
	               |ИЗ
	               |	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	               |ГДЕ
	               |	ЕПСБУ.Ссылка В ИЕРАРХИИ (&Счета)
	               |		И НЕ ЕПСБУ.Ссылка В ИЕРАРХИИ (&СчетаИсключения)";
	               
	Запрос.УстановитьПараметр("Счета", Счета);
	Запрос.УстановитьПараметр("СчетаИсключения", СчетаИсключения);
	
	Результат = Новый Структура(
		"Валютный, Количественный, УчетПоКПС, УчетПоПодразделениям, УчетПоКЭК, РазрешитьНеУказыватьПодразделение",
		Ложь, Ложь, Ложь, Ложь, Ложь, Ложь);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;

	Возврат Результат;
КонецФункции

// Проверяет счета на наличие обязательности заполнения подразделения.
// Если хоть один счет из списка требует подразделение возвращает ИСТИНА
// Можно использовать в обработчике "ОбработкаПроверкиЗаполнения" объектов
//
// Параметры:
//  СпСчетов - Массив - список счетов, которые нужно проверить
//
// Возвращаемое значение:
//  Булево - Истина, если есть хоть один счет, который требует обязательного заполнения 
//				подразделения
Функция ЕстьСчетаСОбязательнымЗаполнениемПодразделения(СпСчетов) Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.УчетПоПодразделениям
	|			И НЕ ЕПСБУ.РазрешитьНеУказыватьПодразделение
	|	И ЕПСБУ.Ссылка В ИЕРАРХИИ(&СпСчетов)"; 
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СпСчетов", СпСчетов);
	
	Возврат(Запрос.Выполнить().Выбрать().Количество() > 0);
КонецФункции	

// Проверяет, включен ли переданный документ-объект в лист кассовой книги
// Можно указать проверять ли только в проведенных листах кассовой книги, или во всех
// Если документ в включен в лист кассовой книги, то
// в параметр ЛистКассовойКниги устанавливается структура с ключами:
//		Ссылка - ссылка на лист кассовой книги,
//		НомерЛиста - номер листа кассовой книги
//
// Возвращаемое значение: булево. Истина - документ включен в отчет кассира
//
Функция КассовыйОрдерВключенВОтчетКассира(ДокументОбъект, ЛистКассовойКниги = Неопределено, Проведен = Истина) Экспорт

	// незаписанный документ точно не включен в отчет кассира
	Если ДокументОбъект.Ссылка.Пустая() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// если параметр Проведен = Истина, то ищем только в проведенных документах
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЛистКассовойКнигиКассовыеОрдера.Ссылка КАК Ссылка,
	|	ЛистКассовойКнигиКассовыеОрдера.Ссылка.НомерЛиста КАК НомерЛиста
	|ИЗ
	|	Документ.ЛистКассовойКниги_52н.КассовыеОрдера КАК ЛистКассовойКнигиКассовыеОрдера
	|ГДЕ
	|	ЛистКассовойКнигиКассовыеОрдера.КассовыйДокумент = &КассовыйДокумент
	|	И &ДопУсловие
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЛистКассовойКнигиКассовыеОрдера.Ссылка,
	|	ЛистКассовойКнигиКассовыеОрдера.Ссылка.НомерЛиста
	|ИЗ
	|	Документ.ЛистКассовойКнигиФондовый_52н.КассовыеОрдера КАК ЛистКассовойКнигиКассовыеОрдера
	|ГДЕ
	|	ЛистКассовойКнигиКассовыеОрдера.КассовыйДокумент = &КассовыйДокумент
	|	И &ДопУсловие
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЛистКассовойКнигиКассовыеОрдера.Ссылка,
	|	ЛистКассовойКнигиКассовыеОрдера.Ссылка.НомерЛиста
	|ИЗ
	|	Документ.ЛистКассовойКниги.КассовыеОрдера КАК ЛистКассовойКнигиКассовыеОрдера
	|ГДЕ
	|	ЛистКассовойКнигиКассовыеОрдера.КассовыйДокумент = &КассовыйДокумент
	|	И &ДопУсловие
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЛистКассовойКнигиКассовыеОрдера.Ссылка,
	|	ЛистКассовойКнигиКассовыеОрдера.Ссылка.НомерЛиста
	|ИЗ
	|	Документ.ЛистКассовойКнигиФондовый.КассовыеОрдера КАК ЛистКассовойКнигиКассовыеОрдера
	|ГДЕ
	|	ЛистКассовойКнигиКассовыеОрдера.КассовыйДокумент = &КассовыйДокумент
	|	И &ДопУсловие";
				    
	Если Проведен Тогда				   
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДопУсловие", "ЛистКассовойКнигиКассовыеОрдера.Ссылка.Проведен");
	Иначе	
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ДопУсловие", "ИСТИНА");
	КонецЕсли;				   
	
	Запрос.УстановитьПараметр("КассовыйДокумент", ДокументОбъект.Ссылка);
	
	// для ускорения выполнения запроса не будем использовать RLS
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		ЛистКассовойКниги = Новый Структура("Ссылка, НомерЛиста", Результат.Ссылка, Результат.НомерЛиста);
		
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;

КонецФункции // КассовыйОрдерВключенВОтчетКассира()

// Проверяет, есть ли за дату кассового ордера проведенный документ "Отчет кассира"
// Если Отчет кассира за этот день есть, то
// в параметр ЛистКассовойКниги устанавливается структура с ключами:
//		Ссылка - ссылка на лист кассовой книги,
//		НомерЛиста - номер листа кассовой книги
//
// Возвращаемое значение: булево. Истина - за дату кассового ордера есть проведенный "Отчет кассира"
//
Функция ЕстьПроведенныйОтчетКассираЗаЭтотДень(ДокументОбъект, ЛистКассовойКниги = Неопределено) Экспорт
		
	Постфикс   = "";
	ДопУсловие = "";
	
	Если (Найти(Строка(ТипЗнч(ДокументОбъект)), "фондовый") > 0) Тогда
		Если ПолучитьФункциональнуюОпцию("ФондоваяКнигаОтдельноОтДенежной") Тогда	
			Постфикс   = "Фондовый";	
		Иначе
			ДопУсловие = "И ЛистКассовойКниги.Фондовый"
		КонецЕсли;
	Иначе
		ДопУсловие = "И НЕ ЛистКассовойКниги.Фондовый"
	КонецЕсли;
	
	Запрос       = Новый Запрос;
	Запрос.Текст = "
	
	|ВЫБРАТЬ 
	|	ЛистКассовойКниги.Ссылка КАК Ссылка,
	|	ЛистКассовойКниги.Ссылка.НомерЛиста КАК НомерЛиста
	|ИЗ
	|	Документ.ЛистКассовойКниги" + Постфикс + "_52н КАК ЛистКассовойКниги
	|ГДЕ
	|	ЛистКассовойКниги.Дата МЕЖДУ &ДатаНач И &ДатаКон
	|   И ЛистКассовойКниги.Проведен " + ДопУсловие + "
	|	И (ЛистКассовойКниги.Организация.Ссылка = &Организация)" + 
	?(Константы.ИспользоватьУчетПоПодразделениям.Получить(), "И (ЛистКассовойКниги.Подразделение = &Подразделение)", "") + "
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ 
	|	ЛистКассовойКниги.Ссылка,
	|	ЛистКассовойКниги.Ссылка.НомерЛиста
	|ИЗ
	|	Документ.ЛистКассовойКниги" + Постфикс + " КАК ЛистКассовойКниги
	|ГДЕ
	|	ЛистКассовойКниги.Дата МЕЖДУ &ДатаНач И &ДатаКон
	|   И ЛистКассовойКниги.Проведен " + ДопУсловие + "
	|	И (ЛистКассовойКниги.Организация.Ссылка = &Организация)" + 
	?(Константы.ИспользоватьУчетПоПодразделениям.Получить(), "И (ЛистКассовойКниги.Подразделение = &Подразделение)", "") + "
	|";
				    
	Запрос.УстановитьПараметр("ДатаНач",       НачалоДня(ДокументОбъект.Дата));
	Запрос.УстановитьПараметр("ДатаКон",       КонецДня(ДокументОбъект.Дата));
	Запрос.УстановитьПараметр("Организация",   ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("Подразделение", ДокументОбъект.Подразделение);
	
	// для ускорения выполнения запроса не будем использовать RLS
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		ЛистКассовойКниги = Новый Структура("Ссылка, НомерЛиста", Результат.Ссылка, Результат.НомерЛиста);	
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;	
	
КонецФункции // ЕстьПроведенныйОтчетКассираЗаЭтотДень()

Функция ПолучитьСвойстваСчетов(Знач СписокСчетов, ВключаяПодчиненные = Ложь, ИменаРеквизитов = "", Знач ИмяПланаСчетов = Неопределено) Экспорт
	
	Если ИмяПланаСчетов = Неопределено Тогда
		ИмяПланаСчетов = "ЕПСБУ";
	КонецЕсли;
	
	СчетаДляЗапроса = Новый Массив;
	Если ТипЗнч(СписокСчетов) = Тип("Строка") Тогда
		СписокСчетов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СписокСчетов, ",");
	КонецЕсли;
	Если ТипЗнч(СписокСчетов) = Тип("Массив") ИЛИ ТипЗнч(СписокСчетов) = Тип("ФиксированныйМассив") Тогда
		Для каждого ТекСчет Из СписокСчетов Цикл
			СчетаДляЗапроса.Добавить(ТекСчет);
		КонецЦикла; 
	ИначеЕсли ТипЗнч(СписокСчетов) = Тип("СписокЗначений") Тогда
		Для каждого ТекСчет Из СписокСчетов Цикл
			СчетаДляЗапроса.Добавить(ТекСчет.Значение);
		КонецЦикла;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Если СчетаДляЗапроса.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИменаРеквизитов) Тогда
		ВременнаяСтруктура = Новый Структура(ИменаРеквизитов);
		ТребуетсяСубконто 			= ВременнаяСтруктура.Свойство("Субконто");
		ТребуетсяКоличествоСубконто = ВременнаяСтруктура.Свойство("КоличествоСубконто");
	Иначе
		ТребуетсяСубконто = Истина;
		ТребуетсяКоличествоСубконто = Истина;
	КонецЕсли;
	ПроверятьСубконто = ТребуетсяСубконто ИЛИ ТребуетсяКоличествоСубконто;
	
	ТипЗначенияМассива = ТипЗнч(СчетаДляЗапроса[0]);
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ЕПСБУ.Ссылка,
	               |	ЕПСБУ.ВерсияДанных,
	               |	ЕПСБУ.ПометкаУдаления,
	               |	ЕПСБУ.Предопределенный,
	               |	ЕПСБУ.Родитель,
	               |	ЕПСБУ.Код,
	               |	ЕПСБУ.Наименование,
	               |	ЕПСБУ.Порядок,
	               |	ЕПСБУ.Вид,
	               |	ЕПСБУ.Забалансовый,
	               |	ЕПСБУ.ЗапретитьИспользоватьВПроводках,
	               |	ЕПСБУ.НомерЖурнала,
	               |	ЕПСБУ.НомерЖурнала.Приоритет Как НомерЖурналаПриоритет,
	               |	ЕПСБУ.КОСГУДт,
	               |	ЕПСБУ.КОСГУКт,
	               |	ЕПСБУ.ЭлементГруппа,
	               |	ЕПСБУ.ДляКазенных,
	               |	ЕПСБУ.ДляБюджетных,
	               |	ЕПСБУ.ДляАвтономных,
	               |	ЕПСБУ.ТипСчета,
	               |	ЕПСБУ.Валютный,
	               |	ЕПСБУ.Количественный,
	               |	ЕПСБУ.УчетПоКПС,
	               |	ЕПСБУ.УчетПоПодразделениям,
	               |	ЕПСБУ.УчетПоКЭК,
	               |	ЕПСБУ.ВидыСубконто.(
	               |		Ссылка,
	               |		НомерСтроки,
	               |		ВидСубконто,
	               |		Предопределенное,
	               |		Обязательный,
	               |		ТолькоОбороты,
	               |		Суммовой,
	               |		Валютный,
	               |		Количественный,
	               |		ВидСубконто.Наименование КАК Наименование,
	               |		ВидСубконто.ТипЗначения КАК ТипЗначения
	               |	)
	               |ИЗ
	               |	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	               |ГДЕ";
	Если ТипЗначенияМассива = Тип("Строка") Тогда
		Если ВключаяПодчиненные Тогда
			ТекстЗапроса = ТекстЗапроса + "				   
	               |	ЕПСБУ.Ссылка В Иерархии(Выбрать
				   |								Т.Ссылка
				   |							Из
				   |								ПланСчетов.ЕПСБУ Как Т
				   |							Где
				   |								Т.Код В (&СчетаДляЗапроса))";
		Иначе
			ТекстЗапроса = ТекстЗапроса + "				   
	               |	ЕПСБУ.Код В(&СчетаДляЗапроса)";
		КонецЕсли;
	ИначеЕсли ОбщегоНазначения.ЭтоСсылка(ТипЗначенияМассива) И ОбщегоНазначения.ВидОбъектаПоТипу(ТипЗначенияМассива) = "ПланСчетов" Тогда
		Если ВключаяПодчиненные Тогда
			ТекстЗапроса = ТекстЗапроса + "				   
	               |	ЕПСБУ.Ссылка В Иерархии(Выбрать
				   |								Т.Ссылка
				   |							Из
				   |								ПланСчетов.ЕПСБУ Как Т
				   |							Где
				   |								Т.Ссылка В (&СчетаДляЗапроса))";
		Иначе
			ТекстЗапроса = ТекстЗапроса + "				   
	               |	ЕПСБУ.Ссылка В(&СчетаДляЗапроса)";
		КонецЕсли;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	МаксКоличествоСубконто = БухгалтерскийУчетПовтИсп.ПолучитьМаксКоличествоСубконто();
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СчетаДляЗапроса", СчетаДляЗапроса);
	Выборка = Запрос.Выполнить().Выбрать();
	
	ДанныеСчетов = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		
		ДанныеСчета = ПустаяСтруктураОписанияСчета(ИмяПланаСчетов, ИменаРеквизитов);
		ЗаполнитьЗначенияСвойств(ДанныеСчета, Выборка);
		
		Если ПроверятьСубконто Тогда
			
			КоличествоСубконто = 0;
			ВыборкаСубконто = Выборка.ВидыСубконто.Выбрать();
			Пока ВыборкаСубконто.Следующий() Цикл
				КоличествоСубконто = КоличествоСубконто + 1;
				Если ТребуетсяСубконто Тогда
					Индекс = ВыборкаСубконто.НомерСтроки;
					ДанныеСчета.Вставить("ВидСубконто" + Индекс,                   		ВыборкаСубконто.ВидСубконто);
					ДанныеСчета.Вставить("ВидСубконто" + Индекс + "Наименование",  		ВыборкаСубконто.Наименование);
					ДанныеСчета.Вставить("ВидСубконто" + Индекс + "ТипЗначения",   		ВыборкаСубконто.ТипЗначения);
					ДанныеСчета.Вставить("ВидСубконто" + Индекс + "Суммовой",      		ВыборкаСубконто.Суммовой);
					ДанныеСчета.Вставить("ВидСубконто" + Индекс + "ТолькоОбороты", 		ВыборкаСубконто.ТолькоОбороты);
					ДанныеСчета.Вставить("ВидСубконто" + Индекс + "ВводПустыхСубконто",	Не ВыборкаСубконто.Обязательный); // оставлено для совместимости, использовать признак "Обязательный"
					ДанныеСчета.Вставить("ВидСубконто" + Индекс + "Обязательный",		ВыборкаСубконто.Обязательный);
				КонецЕсли;
			КонецЦикла;
			Если ТребуетсяКоличествоСубконто Тогда
				ДанныеСчета.КоличествоСубконто = КоличествоСубконто;
			КонецЕсли;
		КонецЕсли;
		ДанныеСчетов.Вставить(Выборка.Ссылка, Новый ФиксированнаяСтруктура(ДанныеСчета));
		
	КонецЦикла; 
	
	Возврат Новый ФиксированноеСоответствие(ДанныеСчетов);
	
КонецФункции

// Функция возвращает массив дат содержащий:
// - даты изменения учетной политики организации
// - даты начала действия счетов
// - даты после окончания действия счетов (дата окончания + 1 день)
// - даты перехода на применения новых редакций ПС
// 
// Параметры:
// 	Организация - СправочникСсылка.Организации - 
// Возвращаемое значение:
// 	Массив - элементы типа Дата
Функция ДатыИзмененияУчетнойПолитики(Организация) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УчетнаяПолитикаОрганизаций.Период КАК Период
	|ИЗ
	|	РегистрСведений.УчетнаяПолитикаОрганизаций КАК УчетнаяПолитикаОрганизаций
	|ГДЕ
	|	УчетнаяПолитикаОрганизаций.Организация = &Организация
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЕПСБУ.ДатаНачалаДействия
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДОБАВИТЬКДАТЕ(ЕПСБУ.ДатаОкончанияДействия, ДЕНЬ, 1)
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДатыПереходаНаПрименениеРедакцийПС.ДатаНачалаПрименения
	|ИЗ
	|	РегистрСведений.ДатыПереходаНаПрименениеРедакцийПС КАК ДатыПереходаНаПрименениеРедакцийПС
	|ГДЕ
	|	ДатыПереходаНаПрименениеРедакцийПС.Организация = &Организация
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период УБЫВ";
	Запрос.УстановитьПараметр("Организация", Организация);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Период");
	
КонецФункции

Функция ДатаУстановкиУчетнойПолитики(Организация, Дата) Экспорт

	ДатаНачалаДействия = Дата(1,1,1);
	ДатыИзменения = ДатыИзмененияУчетнойПолитики(Организация);
	Для каждого ТекДатаИзменения Из ДатыИзменения Цикл
	
		Если ТекДатаИзменения<=Дата Тогда
			Если ДатаНачалаДействия<ТекДатаИзменения Тогда
				ДатаНачалаДействия=ТекДатаИзменения;
			КонецЕсли;
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат ДатаНачалаДействия;

КонецФункции

// Функция - Есть движения документа по регистру бухгалтерии
//
// Параметры:
//  СсылкаДокумента	 - 	ДокументСсылка - документ, для которого надо проверить наличие движений в регистре бухгалтерии 
// 
// Возвращаемое значение:
//   Булево, Истина - в регистре бухгалтерии движения есть, иначе - Ложь 
//
Функция ЕстьДвиженияДокументаПоРегиструБухгалтерии(СсылкаДокумента) Экспорт
	
	ЕстьДвижения = Ложь;
	
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЖурналПроводокЕПСБУ.Регистратор
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ЖурналПроводокЕПСБУ
	|ГДЕ
	|	ЖурналПроводокЕПСБУ.Регистратор = &Регистратор");
	
	Запрос.УстановитьПараметр("Регистратор", СсылкаДокумента);
	
	УстановитьПривилегированныйРежим(Истина);
	ЕстьДвижения = НЕ Запрос.Выполнить().Пустой();
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ЕстьДвижения; 
	
КонецФункции	

// Возвращает проводки документов с отбором по счету, кор.счету.
//
// Параметры:
//  Документы - ДокументСсылка, Массив - документ(ы), для которых нужно получить реквизиты проводок.
//  Счет - ПланСчетовСсылка.ЕПСБУ, Строка - код счета или счет, проводки по которому нужно получить.
//  ДтКт - "Дт" или "Кт" - сторона проводки, с которой должен быть Счет. Если параметр не указан, выбираются проводки с указанным Счетом как по Дт, так и по Кт.
//  КорСчет - ПланСчетовСсылка.ЕПСБУ, Строка - код счета или счет, ополнительное условие отбора проводок.
//
// Возвращаемое значение:
//   РезультатЗапроса по проводкам документов с учетом отборов.
//
Функция ПроводкиДокументов(Документы, Счет = Неопределено, ДтКт = "", КорСчет = Неопределено, Первые = 0) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕПСБУДвиженияССубконто.Регистратор КАК Регистратор,
	|	ЕПСБУДвиженияССубконто.Организация КАК Организация,
	|	ЕПСБУДвиженияССубконто.ИФО КАК ИФО,
	|	ЕПСБУДвиженияССубконто.КФО КАК КФО,
	|	ЕПСБУДвиженияССубконто.СчетДт КАК СчетДт,
	|	ЕПСБУДвиженияССубконто.СубконтоДт1 КАК СубконтоДт1,
	|	ЕПСБУДвиженияССубконто.СубконтоДт2 КАК СубконтоДт2,
	|	ЕПСБУДвиженияССубконто.СубконтоДт3 КАК СубконтоДт3,
	|	ЕПСБУДвиженияССубконто.ВидСубконтоДт1 КАК ВидСубконтоДт1,
	|	ЕПСБУДвиженияССубконто.ВидСубконтоДт2 КАК ВидСубконтоДт2,
	|	ЕПСБУДвиженияССубконто.ВидСубконтоДт3 КАК ВидСубконтоДт3,
	|	ЕПСБУДвиженияССубконто.СчетКт КАК СчетКт,
	|	ЕПСБУДвиженияССубконто.СубконтоКт1 КАК СубконтоКт1,
	|	ЕПСБУДвиженияССубконто.СубконтоКт2 КАК СубконтоКт2,
	|	ЕПСБУДвиженияССубконто.СубконтоКт3 КАК СубконтоКт3,
	|	ЕПСБУДвиженияССубконто.ВидСубконтоКт1 КАК ВидСубконтоКт1,
	|	ЕПСБУДвиженияССубконто.ВидСубконтоКт2 КАК ВидСубконтоКт2,
	|	ЕПСБУДвиженияССубконто.ВидСубконтоКт3 КАК ВидСубконтоКт3,
	|	ВЫБОР
	|		КОГДА &УчетПоПодразделениям
	|				И ЕПСБУДвиженияССубконто.СчетДт.УчетПоПодразделениям
	|			ТОГДА ЕПСБУДвиженияССубконто.ПодразделениеДт
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК ПодразделениеДт,
	|	ВЫБОР
	|		КОГДА &УчетПоПодразделениям
	|				И ЕПСБУДвиженияССубконто.СчетКт.УчетПоПодразделениям
	|			ТОГДА ЕПСБУДвиженияССубконто.ПодразделениеКт
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК ПодразделениеКт,
	|	ЕПСБУДвиженияССубконто.КПСДт КАК КПСДт,
	|	ЕПСБУДвиженияССубконто.КПСКт КАК КПСКт,
	|	ЕПСБУДвиженияССубконто.КЭКДт КАК КЭКДт,
	|	ЕПСБУДвиженияССубконто.КЭККт КАК КЭККт,
	|	ЕПСБУДвиженияССубконто.ВалютаДт КАК ВалютаДт,
	|	ЕПСБУДвиженияССубконто.ВалютаКт КАК ВалютаКт,
	|	ЕПСБУДвиженияССубконто.ХарактеристикаДвиженияДт КАК ХарактеристикаДвиженияДт,
	|	ЕПСБУДвиженияССубконто.ХарактеристикаДвиженияКт КАК ХарактеристикаДвиженияКт,
	|	ЕПСБУДвиженияССубконто.Сумма КАК Сумма,
	|	ЕПСБУДвиженияССубконто.ВалютнаяСуммаДт КАК ВалютнаяСуммаДт,
	|	ЕПСБУДвиженияССубконто.ВалютнаяСуммаКт КАК ВалютнаяСуммаКт,
	|	ЕПСБУДвиженияССубконто.КоличествоДт КАК КоличествоДт,
	|	ЕПСБУДвиженияССубконто.КоличествоКт КАК КоличествоКт
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|			,
	|			,
	|			Активность
	|				И &УсловиеПоРегистраторам
	|				И &УсловиеПоСчету
	|				И &УсловиеПоКорСчету,
	|			НомерСтроки,
	|			&Первые) КАК ЕПСБУДвиженияССубконто";
	
	Если ТипЗнч(Документы) = Тип("Массив") Тогда
		Запрос.УстановитьПараметр("Регистраторы", Документы);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоРегистраторам", "Регистратор В(&Регистраторы)");
	Иначе
		Запрос.УстановитьПараметр("Регистратор", Документы);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоРегистраторам", "Регистратор = &Регистратор");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Счет) Тогда
		
		СчетСсылка = ?(ТипЗнч(Счет) = Тип("Строка"), СписокСчетов(Счет), Счет);
		Запрос.УстановитьПараметр("Счет", СчетСсылка);
		
		Если ДтКт="Дт" Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоСчету", "СчетДт В ИЕРАРХИИ (&Счет)");
		ИначеЕсли ДтКт="Кт" Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоСчету", "СчетКт В ИЕРАРХИИ (&Счет)");
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоСчету", "Счет В ИЕРАРХИИ (&Счет)");
		КонецЕсли;
		
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоСчету", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КорСчет) Тогда
		КорСчетСсылка = ?(ТипЗнч(КорСчет) = Тип("Строка"), СписокСчетов(КорСчет), КорСчет);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоКорСчету", "КорСчет В ИЕРАРХИИ (&КорСчет)");
		Запрос.УстановитьПараметр("КорСчет", КорСчетСсылка);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоКорСчету", "ИСТИНА");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Первые", Первые);
	Запрос.УстановитьПараметр("УчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	
	Возврат Запрос.Выполнить();
	
КонецФункции

Функция ПолучитьВидыКПСПоУчетнойПолитикеИОграничениям(ОтборПоОграничениям, ОтборПоУчетнойПолитике) Экспорт 
	
	ЗначенияФильтра = Новый Массив;
	ПредставлениеОтбора = "";
	
	Если ТипЗнч(ОтборПоОграничениям) = Тип("Массив") Тогда
		Если ТипЗнч(ОтборПоУчетнойПолитике) = Тип("Массив") Тогда
			Если ОтборПоОграничениям.Количество() > 0 И ОтборПоУчетнойПолитике.Количество() > 0 Тогда 
				// получить пересечение массива
				ЗначенияФильтра = ОбщегоНазначенияБГУ.ПолучитьПересечениеМассивов(ОтборПоОграничениям, ОтборПоУчетнойПолитике);
			Иначе
				ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ЗначенияФильтра, ?(ОтборПоУчетнойПолитике.Количество() > 0, ОтборПоУчетнойПолитике, ОтборПоОграничениям), Истина);
			КонецЕсли;
		Иначе
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ЗначенияФильтра, ОтборПоОграничениям, Истина);
		КонецЕсли;
	ИначеЕсли ТипЗнч(ОтборПоУчетнойПолитике) = Тип("Массив") Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ЗначенияФильтра, ОтборПоУчетнойПолитике, Истина);
	КонецЕсли;
	
	ОтборВидовКПС = Новый СписокЗначений;
	
	Для Каждого Значение Из ЗначенияФильтра Цикл
		ОтборВидовКПС.Добавить(Значение);
	КонецЦикла;
	
	Возврат ОтборВидовКПС;
	
КонецФункции

Функция ПолучитьУточнениеКПС(ОтборПоОграничениям) Экспорт
	
	//отбор по показателю уточнения 
	ОтборУточнениеКПС = Новый СписокЗначений;
	ОтборУточнениеКПС.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.ПустаяСсылка"));
	
	Если НЕ ОтборПоОграничениям.Найти(ПредопределенноеЗначение("Перечисление.ВидыКБК.КДБ")) = Неопределено Тогда
		ОтборУточнениеКПС.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.КДБ"));
	КонецЕсли;
	Если НЕ ОтборПоОграничениям.Найти(ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ")) = Неопределено Тогда
		ОтборУточнениеКПС.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ"));
	КонецЕсли;
	Если НЕ ОтборПоОграничениям.Найти(ПредопределенноеЗначение("Перечисление.ВидыКБК.КИФ")) = Неопределено Тогда
		ОтборУточнениеКПС.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.КИФ"));
	КонецЕсли;
	Если НЕ ОтборПоОграничениям.Найти(ПредопределенноеЗначение("Перечисление.ВидыКБК.гКБК")) = Неопределено Тогда
		ОтборУточнениеКПС.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.гКБК"));
	КонецЕсли;
	
	Возврат ОтборУточнениеКПС;
	
КонецФункции			

// Параметры заполнения таблицы документа зачет авансов.
// 
// Параметры:
//  Документ - ДокументОбъект, ДанныеФормыСтруктура -
// 
// Возвращаемое значение:
//  Структура - Параметры заполнения таблицы документа зачет авансов:
// * ПоВсемКФО - Булево
// * ПоВсемКПС - Булево 
// * ПериодОстатков - Граница
// * Организация - СправочникСсылка.Организации 
// * Дата - Дата
// * Ссылка - ДокументСсылка
// * КЭКРасчетов - СправочникСсылка.КОСГУ
// * СчетРасчетов - ПланСчетовСсылка.ЕПСБУ
// * КПС - СправочникСсылка.КлассификационныеПризнакиСчетов
Функция ПараметрыЗаполненияТаблицыДокументаЗачетАвансов(Документ) Экспорт
	
	Параметры = Новый Структура("ПоВсемКФО, ПоВсемКПС, ПериодОстатков, Организация, Дата, Ссылка, КЭКРасчетов, СчетРасчетов, КПС, КПСРасчетовВТЧ");
	
	ЗаполнитьЗначенияСвойств(Параметры, Документ, "Организация, Дата, Ссылка");
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Документ, "КФО")
		И ЗначениеЗаполнено(Документ.КФО) Тогда
		
		Параметры.ПоВсемКФО = Ложь;
		
	Иначе
		
		Параметры.ПоВсемКФО = Истина;
	
	КонецЕсли;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Документ, "КПС")
		И ЗначениеЗаполнено(Документ.КПС) Тогда
		
		Параметры.ПоВсемКПС = Ложь;
		
	Иначе
		
		Параметры.ПоВсемКПС = Истина;
	
	КонецЕсли;
	
	Возврат Параметры;
	
КонецФункции

// Проверяет, что документ подключен к механизму исправления ошибок прошлых лет, в соответствии с федеральным стандартом.
// У таких документов при выборе типовой операции можно указать порядок исправления ошибок прошлых лет.
// 
// Параметры:
// 	Документ - ДокументСсылка, ДокументОбъект, СправочникСсылка.ИдентификаторыОбъектовМетаданных - проверяемый документ.
// Возвращаемое значение:
// 	Булево - Истина, если исправление ошибок прошлых лет этим документом можно выполнить. Ложь - если нельзя.
Функция ПоДокументуВозможноИсправлениеОшибок(Документ) Экспорт
	
	Если ТипЗнч(Документ) = Тип("СправочникСсылка.ИдентификаторыОбъектовМетаданных") Тогда
		ПроверяемаяСсылка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "ЗначениеПустойСсылки");
	Иначе
		ТипДокумента = ТипЗнч(Документ);
		Если ОбщегоНазначения.ЭтоСсылка(ТипДокумента) Тогда
			ПроверяемаяСсылка = Документ;
		Иначе
			ПроверяемаяСсылка = Документ.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Метаданные.ОпределяемыеТипы.ДокументыПоддерживающиеИсправлениеОшибокПрошлыхЛет.Тип.СодержитТип(ТипЗнч(ПроверяемаяСсылка));
	
КонецФункции

// Параметры исправления ошибок для функции ОтразитьИсправлениеОшибокПрошлыхЛетВТаблицеПроводок
// 
// Возвращаемое значение:
// 	Структура - параметры исправления ошибок:
// * ПорядокИсправленияОшибок - ПеречислениеСсылка.ПорядокИсправленияОшибокПрошлыхЛет -
// * ВыявительОшибки - ПеречислениеСсылка.ВыявительОшибокПрошлыхЛет -
// * ПричинаОшибки - СправочникСсылка.ПричиныОшибокПрошлыхЛет -
Функция ПараметрыИсправленияОшибокПрошлыхЛет() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("ПорядокИсправленияОшибок", Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка());
	Результат.Вставить("ВыявительОшибки", Перечисления.ВыявительОшибокПрошлыхЛет.ПустаяСсылка());
	Результат.Вставить("ПричинаОшибки", Справочники.ПричиныОшибокПрошлыхЛет.ПустаяСсылка());
	Возврат Результат;
КонецФункции

// Устарела. См. ОтразитьИсправлениеОшибокПрошлыхЛетВТаблицеПроводок()
// Модифицирует таблицу проводок в соответствии с выбранным порядком исправления ошибок.
// 
// Параметры:
// 	ТаблицаПроводок - ТаблицаЗначений - модифицируемая таблица проводок.
// 	ПорядокИсправленияОшибок - ПеречислениеСсылка.ПорядокИсправленияОшибокПрошлыхЛет - порядок исправления ошибок.
//                           
Процедура ОтразитьИсправлениеОшибокВТаблицеПроводок(ТаблицаПроводок, ПорядокИсправленияОшибок, Отказ) Экспорт
	ПараметрыИсправленияОшибок = ПараметрыИсправленияОшибокПрошлыхЛет();
	ПараметрыИсправленияОшибок.ПорядокИсправленияОшибок = ПорядокИсправленияОшибок;
	ОтразитьИсправлениеОшибокПрошлыхЛетВТаблицеПроводок(ТаблицаПроводок, ПараметрыИсправленияОшибок, Отказ);
КонецПроцедуры

// Модифицирует таблицу проводок в соответствии с выбранным порядком исправления ошибок.
// 
// Параметры:
// 	ТаблицаПроводок - ТаблицаЗначений - Описание
// 	ПараметрыИсправленияОшибок - Структура - см. ПараметрыИсправленияОшибокПрошлыхЛет()
// 	Отказ
Процедура ОтразитьИсправлениеОшибокПрошлыхЛетВТаблицеПроводок(ТаблицаПроводок, ПараметрыИсправленияОшибок, Отказ) Экспорт
	
	Если ТаблицаПроводок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Считаем что все проводки сформированы на одну дату
	Дата = ТаблицаПроводок[0].Период;
	
	ПорядокИсправленияОшибок	= ПараметрыИсправленияОшибок.ПорядокИсправленияОшибок;
	ВыявительОшибки				= ПараметрыИсправленияОшибок.ВыявительОшибки;
	ПричинаОшибки				= ПараметрыИсправленияОшибок.ПричинаОшибки;
	
	// Параметры ошибок по балансовым счетам
	
	ДанныеСчетов = Новый Соответствие;
	
	Если Дата < '20210101' Тогда
		
		Если ПорядокИсправленияОшибок = Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода Тогда
			
			ДанныеСчетов.Вставить("401.10", "401.18");
			ДанныеСчетов.Вставить("401.20", "401.28");
			ДанныеСчетов.Вставить("304.04", "304.84");
			ДанныеСчетов.Вставить("304.06", "304.86");
			
			СчетКорКод = "304.86";
			
		ИначеЕсли ПорядокИсправленияОшибок = Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода Тогда
			
			ДанныеСчетов.Вставить("401.10", "401.19");
			ДанныеСчетов.Вставить("401.20", "401.29");
			ДанныеСчетов.Вставить("304.04", "304.94");
			ДанныеСчетов.Вставить("304.06", "304.96");
			
			СчетКорКод = "304.96";
			
		КонецЕсли;
		
	Иначе
		
		Если ПорядокИсправленияОшибок = Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода
			И ВыявительОшибки = Перечисления.ВыявительОшибокПрошлыхЛет.Самостоятельно Тогда
			
			ДанныеСчетов.Вставить("401.10", "401.18");
			ДанныеСчетов.Вставить("401.20", "401.28");
			ДанныеСчетов.Вставить("304.06", "304.86");
			
			СчетКорКод = "304.86";
			
		ИначеЕсли ПорядокИсправленияОшибок = Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода
			И ВыявительОшибки = Перечисления.ВыявительОшибокПрошлыхЛет.ОрганКонтроля Тогда
			
			ДанныеСчетов.Вставить("401.10", "401.16");
			ДанныеСчетов.Вставить("401.20", "401.26");
			ДанныеСчетов.Вставить("304.06", "304.66");
			
			СчетКорКод = "304.66";
			
		ИначеЕсли ПорядокИсправленияОшибок = Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода
			И ВыявительОшибки = Перечисления.ВыявительОшибокПрошлыхЛет.Самостоятельно Тогда
			
			ДанныеСчетов.Вставить("401.10", "401.19");
			ДанныеСчетов.Вставить("401.20", "401.29");
			ДанныеСчетов.Вставить("304.06", "304.96");
			
			СчетКорКод = "304.96";
			
		ИначеЕсли ПорядокИсправленияОшибок = Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода
			И ВыявительОшибки = Перечисления.ВыявительОшибокПрошлыхЛет.ОрганКонтроля Тогда
			
			ДанныеСчетов.Вставить("401.10", "401.17");
			ДанныеСчетов.Вставить("401.20", "401.27");
			ДанныеСчетов.Вставить("304.06", "304.76");
			
			СчетКорКод = "304.76";
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ДанныеСчетов.Количество() > 0 Тогда
		
		ШаблонОшибки = НСтр("ru = 'Не найден счет ""%1""'");
		
		ЗаменаСчетов = Новый Соответствие;
		Для Каждого СтрокаСчета Из ДанныеСчетов Цикл
			Счет1 = СчетПоКоду(СтрокаСчета.Ключ, Дата);
			Если Не ЗначениеЗаполнено(Счет1) Тогда
				ТекстСообщения = СтрШаблон(ШаблонОшибки, СтрокаСчета.Ключ);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);
			КонецЕсли;
			Счет2 = СчетПоКоду(СтрокаСчета.Значение, Дата);
			Если Не ЗначениеЗаполнено(Счет2) Тогда
				ТекстСообщения = СтрШаблон(ШаблонОшибки, СтрокаСчета.Значение);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);
				СвойстваСчета2 = Неопределено;
			Иначе
				СвойстваСчета2 = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Счет2);
			КонецЕсли;
			ЗаменаСчетов.Вставить(Счет1, СвойстваСчета2);
		КонецЦикла;
		
		СчетКорСсылка = СчетПоКоду(СчетКорКод, Дата);
		Если Не ЗначениеЗаполнено(СчетКорСсылка) Тогда
			ТекстСообщения = СтрШаблон(ШаблонОшибки, СчетКорКод);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);
			СчетКор = Неопределено;
		Иначе
			СчетКор = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетКорСсылка);
		КонецЕсли;
		
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		
		КодСтатьи = КодСтатьиОрганизации(ТаблицаПроводок[0].Организация, Дата);
		КЭКСчетКорДт = БухгалтерскийУчетПовтИсп.КЭКПоКоду("83" + КодСтатьи);
		КЭКСчетКорКт = БухгалтерскийУчетПовтИсп.КЭКПоКоду("73" + КодСтатьи);
		
	КонецЕсли;
	
	ИсходныеПроводки = ТаблицаПроводок.Скопировать();
	
	ТаблицаПроводок.Очистить();
	
	СвойстваДт = "СчетДт,ВидСубконтоДт1,ВидСубконтоДт2,ВидСубконтоДт3,СубконтоДт1,СубконтоДт2,СубконтоДт3,ВалютаДт,ВалютнаяСуммаДт,КПСДт,КЭКДт,КоличествоДт,ПодразделениеДт,ХарактеристикаДвиженияДт";
	СвойстваКт = "СчетКт,ВидСубконтоКт1,ВидСубконтоКт2,ВидСубконтоКт3,СубконтоКт1,СубконтоКт2,СубконтоКт3,ВалютаКт,ВалютнаяСуммаКт,КПСДт,КЭКДт,КоличествоКт,ПодразделениеКт,ХарактеристикаДвиженияКт";
	
	Для Каждого Проводка Из ИсходныеПроводки Цикл
		
		НоваяПроводка = ТаблицаПроводок.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяПроводка, Проводка);
		
		СвойстваСчетаДт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Проводка.СчетДт);
		СвойстваСчетаКт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Проводка.СчетКт);
		
		// Балансовые счета
		Если ЗначениеЗаполнено(Проводка.СчетДт) И ЗначениеЗаполнено(Проводка.СчетКт)
			И СвойстваСчетаДт.ТипСчета = Перечисления.ТипыСчетов.Бухгалтерский И СвойстваСчетаКт.ТипСчета = Перечисления.ТипыСчетов.Бухгалтерский
			И Не СвойстваСчетаДт.Забалансовый И Не СвойстваСчетаКт.Забалансовый Тогда
			
			Если Лев(СвойстваСчетаДт.Код, 1) <> "5" И Лев(СвойстваСчетаКт.Код, 1) <> "5" Тогда
				
				БылаЗамена = Ложь;
				
				СчетЗамены = ЗаменаСчетов[Проводка.СчетДт];
				Если СчетЗамены <> Неопределено Тогда
					ПодставитьСчетВПроводку(НоваяПроводка, "Дт", СчетЗамены, ПричинаОшибки);
					БылаЗамена = Истина;
				КонецЕсли;
				
				СчетЗамены = ЗаменаСчетов[Проводка.СчетКт];
				Если СчетЗамены <> Неопределено Тогда
					ПодставитьСчетВПроводку(НоваяПроводка, "Кт", СчетЗамены, ПричинаОшибки);
					БылаЗамена = Истина;
				КонецЕсли;
				
				Если Не БылаЗамена Тогда
					
					ПодставитьСчетВПроводку(НоваяПроводка, "Кт", СчетКор, ПричинаОшибки);
					НоваяПроводка["КЭККт"] = КЭКСчетКорКт;
					
					НоваяПроводка = ТаблицаПроводок.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяПроводка, Проводка);
					
					ПодставитьСчетВПроводку(НоваяПроводка, "Дт", СчетКор, ПричинаОшибки);
					НоваяПроводка["КЭКДт"] = КЭКСчетКорДт;
					
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе
			
			ПодменаПоСчетДт = Ложь;
			
			Если ЗначениеЗаполнено(Проводка.СчетДт) Тогда
				Если СвойстваСчетаДт.ТипСчета = Перечисления.ТипыСчетов.Бухгалтерский И СвойстваСчетаДт.Забалансовый Тогда
					ПодставитьСчетВПроводкуЗабаланс(НоваяПроводка, "Кт", ПорядокИсправленияОшибок, ВыявительОшибки);
					ПодменаПоСчетДт = Истина;
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Проводка.СчетКт) Тогда
				
				Если ПодменаПоСчетДт Тогда
					НоваяПроводка = ТаблицаПроводок.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяПроводка, Проводка,, СвойстваДт);
				КонецЕсли;
				
				Если СвойстваСчетаКт.ТипСчета = Перечисления.ТипыСчетов.Бухгалтерский И СвойстваСчетаКт.Забалансовый Тогда
					ПодставитьСчетВПроводкуЗабаланс(НоваяПроводка, "Дт", ПорядокИсправленияОшибок, ВыявительОшибки);
					Если ЗначениеЗаполнено(Проводка.СчетДт) И Не ПодменаПоСчетДт Тогда
						НоваяПроводка = ТаблицаПроводок.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяПроводка, Проводка,, СвойстваКт);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Возвращает идентификатор контрагента по 61н (соответствует идентификатору контрагента в ГИС ГМП 2.х).
// 
// Параметры:
// 	Контрагент - СправочникСсылка.Контрагенты - контрагент, идентификатор которого надо получить
//	ВидДокумента - Строка - для физ.лиц может быть указан вид документа, по которому надо получить идентификатор: 01 - 14, 22, 24 - 26, 28 - 30. 
//		(еще должен быть 21 - ИНН, но в 61н его почему то нет.)
//		Если вид документа не указан, для физлиц возвращается первый сформированный идентификатор.
//		Если указан из допустимого перечня, то идентификатор формируется только по данному виду документа.
//			
// Возвращаемое значение:
// 	Строка - сформированный идентификатор контрагента, 22 символа. Если сформировать не получилось, то пустая строка.
Функция ИдентификаторКонтрагента(Контрагент, ВидДокумента = Неопределено) Экспорт
	
	СписокКонтрагентов = Новый Массив();
	СписокКонтрагентов.Добавить(Контрагент);
	
	Результат = ИдентификаторыКонтрагентов(СписокКонтрагентов, ВидДокумента);
	
	Идентификатор = Результат.Получить(Контрагент);
	
	Если Идентификатор = Неопределено Тогда
		Идентификатор = "";
	КонецЕсли;
	
	Возврат Идентификатор;
	
КонецФункции

// Возвращает идентификатор контрагента по 61н (соответствует идентификатору контрагента в ГИС ГМП 2.х).
// 
// Параметры:
// 	Контрагент - СправочникСсылка.Контрагенты - контрагент, идентификатор которого надо получить
// 	СписокКонтрагентов - Массив из СправочникСсылка.Контрагенты - контрагенты, идентификаторы которых надо получить
//  МожноИННФизлицам - Булево, если Истина, то для физ.лиц может формироваться Идентификатор по ИНН (код 21) - Истина может быть только для ГИС ГМП
//  НужноИдентификаторов - Число, количество формируемых идентификаторов, больше одного может быть только у физ.лиц.
//	ВидДокумента - Строка - для физ.лиц может быть указан вид документа, по которому надо получить идентификатор: 01 - 14, 22, 24 - 26, 28 - 30. 
//		Если МожноИННФизлицам = Истина, то можно еще значение 21, для ИНН
//		Если вид документа не указан, для физлиц возвращается заданное количество сформированных идентификаторов, если данные для этого есть.
//		Если указан из допустимого перечня, то идентификатор формируется только по данному виду документа.
//	МассивКодовДокументовФК - Массив из строк 01 - 14, 21(ИНН!), 22, 24 - 26, 28 - 30 - может быть задан свой массив для изменения приоритета формирования идентификаторов
//			
// Возвращаемое значение:
// 	Строка или массив с идентификаторами, если НужноИдентификаторов = 1 тогда строка, иначе массив  
//		- сформированный идентификатор контрагента, 22 символа. Если сформировать не получилось, то пустая строка.
Функция НесколькоИдентификаторовКонтрагента(Контрагент, Знач МожноИННФизлицам = Ложь, Знач НужноИдентификаторов = 1,  ВидДокумента = Неопределено, МассивКодовДокументовФК = Неопределено) Экспорт
	
	СписокКонтрагентов = Новый Массив();
	СписокКонтрагентов.Добавить(Контрагент);
	
	Если Не ЗначениеЗаполнено(НужноИдентификаторов) Тогда
		НужноИдентификаторов = 1;
	КонецЕсли;
	
	Результат = ПолучитьНесколькоИдентификаторовКонтрагентов(СписокКонтрагентов, МожноИННФизлицам, НужноИдентификаторов, ВидДокумента, МассивКодовДокументовФК);
	
	СформированныеИдентификаторыКонтрагента = Результат.Получить(Контрагент);
		
	Если СформированныеИдентификаторыКонтрагента = Неопределено Тогда
		Если НужноИдентификаторов = 1 Тогда
			СформированныеИдентификаторыКонтрагента = "";
		Иначе
			СформированныеИдентификаторыКонтрагента = Новый Массив;
			СформированныеИдентификаторыКонтрагента.Добавить("");
		КонецЕсли;
	КонецЕсли;
	
	Возврат СформированныеИдентификаторыКонтрагента;
	
КонецФункции

// Возвращает идентификаторы списка контрагента по 61н (соответствует идентификатору контрагента в ГИС ГМП 2.х).
// 
// Параметры:
// 	СписокКонтрагентов - Массив из СправочникСсылка.Контрагенты - контрагенты, идентификаторы которых надо получить
//	ВидДокумента - Строка - для физ.лиц может быть указан вид документа, по которому надо получить идентификатор: 01 - 14, 22, 24 - 26, 28 - 30. 
//		(еще должен быть 21 - ИНН, но в 61н его почему то нет.)
//		Если вид документа не указан, для физлиц возвращается первый сформированный идентификатор.
//		Если указан из допустимого перечня, то идентификатор формируется только по данному виду документа.
//			
// Возвращаемое значение:
// 	Соответствие
//	 Ключ		- СправочникСсылка.Контрагенты
//	 Значение	- Строка - сформированный идентификатор контрагента, 22 символа. Если сформировать не получилось, то пустая строка.
Функция ИдентификаторыКонтрагентов(СписокКонтрагентов, ВидДокумента = Неопределено) Экспорт
	
	МожноИННФизлицам = Ложь;//по 61н ИНН для физлиц нельзя использовать как идентификатор, а в ГИС ГМП можно
	НужноИдентификаторов = 1;
	Результат = ПолучитьНесколькоИдентификаторовКонтрагентов(СписокКонтрагентов,МожноИННФизлицам,НужноИдентификаторов,ВидДокумента);
	Возврат Результат;
	
КонецФункции	

// Возвращает идентификаторы списка контрагента по 61н / ГИС ГМП 2.х (соответствует идентификатору контрагента в ГИС ГМП 2.х).
// 
// Параметры:
// 	СписокКонтрагентов - Массив из СправочникСсылка.Контрагенты - контрагенты, идентификаторы которых надо получить
//  МожноИННФизлицам - Булево, если Истина, то для физ.лиц может формироваться Идентификатор по ИНН (код 21) - Истина может быть только для ГИС ГМП
//  НужноИдентификаторов - Число, количество формируемых идентификаторов, больше одного может быть только у физ.лиц.
//	ВидДокумента - Строка - для физ.лиц может быть указан вид документа, по которому надо получить идентификатор: 01 - 14, 22, 24 - 26, 28 - 30. 
//		если МожноИННФизлицам = Истина, то можно еще значение 21, для ИНН
//		Если вид документа не указан, для физлиц возвращается заданное количество сформированных идентификаторов, если данные для этого есть.
//		Если указан из допустимого перечня, то идентификатор формируется только по данному виду документа.
//	МассивКодовДокументовФК - Массив из строк 01 - 14, 21(ИНН!), 22, 24 - 26, 28 - 30 - может быть задан свой массив для изменения приоритета формирования идентификаторов
//
// Возвращаемое значение:
// 	Соответствие
//	 Ключ		- СправочникСсылка.Контрагенты
//	 Значение	
//		- Если НужноИдентификаторов = 1 Тогда Строка - сформированный идентификатор контрагента, 22 символа. Если сформировать не получилось, то пустая строка.
//		- Если НужноИдентификаторов > 1 Тогда Массив сформированных идентификаторов контрагента, элемент массива - строка, 22 символа. Если сформировать не получилось, то пустая строка.
//
Функция ПолучитьНесколькоИдентификаторовКонтрагентов(СписокКонтрагентов, Знач МожноИННФизлицам = Ложь, Знач НужноИдентификаторов = 1, ВидДокумента = Неопределено, МассивКодовДокументовФК = Неопределено) Экспорт
	//Если это юр.лицо, то:
	//если юр.лицо - резидент РФ, то ИД = "2" + "00" + ИНН + КПП
	//если юр.лицо - НЕ резидент РФ, то ИД = "3" + нули + ИНН(КИО) + КПП, если ИНН(КИО) нет, то налоговый номер + коды страны
	МассивСтран = Новый Массив;
	МассивСтран.Добавить(Справочники.СтраныМира.Россия);
	МассивСтран.Добавить(Справочники.СтраныМира.ПустаяСсылка());
	
	//несколько идентификаторов может быть только у физлиц
	Если НЕ ЗначениеЗаполнено(НужноИдентификаторов) Тогда
		НужноИдентификаторов = 1;
	КонецЕсли;
	
	Если МассивКодовДокументовФК <> Неопределено Тогда
		МассивКодовФК = МассивКодовДокументовФК;	
	Иначе
		//Если это физ. лицо, то:
		//если физ.лицо - ИП или САМОЗАНЯТЫЙ (согласно 61н) - то есть тип контрагента "6", то ИД = "4" + нули + ИНН 
		//для остальных физ.лиц - по перечню документов
		МассивКодовФК = Новый Массив;
		МассивКодовФК.Добавить("01");
		МассивКодовФК.Добавить("02");
		МассивКодовФК.Добавить("03");
		МассивКодовФК.Добавить("04");
		МассивКодовФК.Добавить("05");
		МассивКодовФК.Добавить("06");
		МассивКодовФК.Добавить("07");
		МассивКодовФК.Добавить("08");
		МассивКодовФК.Добавить("09");
		МассивКодовФК.Добавить("10");
		МассивКодовФК.Добавить("11");
		МассивКодовФК.Добавить("12");
		МассивКодовФК.Добавить("13");
		МассивКодовФК.Добавить("14"); //СНИЛС
		//15-20 - зарезервировано
		
		Если МожноИННФизлицам = Истина Тогда
			МассивКодовФК.Добавить("21"); //ИНН - сейчас нет в 61н, но по форматам ГИС ГМП 2.х должно быть
		КонецЕсли;
		
		МассивКодовФК.Добавить("22");
		//23 - зарезервивовано	
		МассивКодовФК.Добавить("24");
		МассивКодовФК.Добавить("25");
		МассивКодовФК.Добавить("26");
		//27 - зарезервивовано
		МассивКодовФК.Добавить("28");
		МассивКодовФК.Добавить("29");
		МассивКодовФК.Добавить("30");
		
		Если ЗначениеЗаполнено(ВидДокумента)
			И МассивКодовФК.Найти(ВидДокумента) <> Неопределено Тогда
			//если передан вид документа по которому формируем идентификатор, то для физ.лиц формируем только по нему
			МассивКодовФК.Очистить();
			МассивКодовФК.Добавить(ВидДокумента);
		КонецЕсли;
	КонецЕсли;
	
	СтрокаБуквЦифр = "0123456789АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯABCDEFGHIJKLMNOPQRSTUVWXYZ";//
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("СписокСсылок",		СписокКонтрагентов);
	ЗапросПоиск.УстановитьПараметр("ДопустимыеКоды",	МассивКодовФК);
	ЗапросПоиск.УстановитьПараметр("МассивСтран",		МассивСтран);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Свойства указанных контрагентов (подготовка)
	|//
	|ВЫБРАТЬ
	|	Ссылка						КАК Ссылка,
	|	ВидКонтрагента				КАК ВидКонтрагента,
	|	ЮридическоеФизическоеЛицо	КАК ЮридическоеФизическоеЛицо,
	|	ТипКонтрагента.Код			КАК ТипКонтрагентаКод
	|ПОМЕСТИТЬ
	|	Контрагенты
	|ИЗ
	|	Справочник.Контрагенты
	|ГДЕ
	|	Ссылка В(&СписокСсылок)
	|ИНДЕКСИРОВАТЬ ПО
	|	ЮридическоеФизическоеЛицо
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Сведения юр.лиц
	|//
	|ВЫБРАТЬ
	|	Контрагенты.Ссылка								КАК Ссылка,
	|	ЮридическиеЛица.ИНН								КАК ИНН,
	|	ЮридическиеЛица.КПП								КАК КПП,
	|	ВЫБОР
	|		КОГДА НЕ ЮридическиеЛица.СтранаРегистрации В (&МассивСтран)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ											КАК ИностраннаяОрганизация,
	|	ЮридическиеЛица.НалоговыйНомер					КАК НалоговыйНомер,
	|	ЮридическиеЛица.СтранаРегистрации.КодАльфа2		КАК СимвольныйКодСтраны,
	|	ЮридическиеЛица.СтранаРегистрации.Код			КАК КодСтраны
	|ИЗ
	|	Контрагенты
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЮридическиеЛица КАК ЮридическиеЛица
	|		ПО Контрагенты.ЮридическоеФизическоеЛицо = ЮридическиеЛица.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Сведения физ.лиц
	|//
	|ВЫБРАТЬ
	|	Контрагенты.Ссылка										КАК Ссылка,
	|	Контрагенты.ТипКонтрагентаКод							КАК ТипКонтрагентаКод,
	|	ФизическиеЛица.ИНН										КАК ИНН,
	|	ФизическиеЛица.ОГРНИП									КАК ОГРНИП,
	|	ФизическиеЛица.СтраховойНомерПФР						КАК СтраховойНомерПФР,
	|	ДокументыФизическихЛицСрезПоследних.ВидДокумента.КодФК	КАК КодФК,
	|	ДокументыФизическихЛицСрезПоследних.Серия				КАК Серия,
	|	ДокументыФизическихЛицСрезПоследних.Номер				КАК Номер
	|ИЗ
	|	Контрагенты
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФизическиеЛица
	|		ПО Контрагенты.ЮридическоеФизическоеЛицо = ФизическиеЛица.Ссылка
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыФизическихЛиц.СрезПоследних КАК ДокументыФизическихЛицСрезПоследних
	|		ПО (ДокументыФизическихЛицСрезПоследних.Физлицо = ФизическиеЛица.Ссылка
	|			И ДокументыФизическихЛицСрезПоследних.ВидДокумента.КодФК В (&ДопустимыеКоды))
	|УПОРЯДОЧИТЬ ПО
	|	КодФК
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Виды указанных контрагентов
	|//
	|ВЫБРАТЬ
	|	Ссылка			КАК Ссылка,
	|	ВидКонтрагента	КАК ВидКонтрагента
	|ИЗ
	|	Контрагенты";
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатыЗапроса = ЗапросПоиск.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	
	ТаблицаСведенияЮрЛиц = РезультатыЗапроса[1].Выгрузить();
	ТаблицаСведенияЮрЛиц.Индексы.Добавить("Ссылка");
	
	ТаблицаСведенияФизЛиц = РезультатыЗапроса[2].Выгрузить();
	ТаблицаСведенияФизЛиц.Индексы.Добавить("Ссылка");
	ТаблицаСведенияФизЛиц.Индексы.Добавить("Ссылка,КодФК");
	
	ТаблицаВидыКонтрагентов = РезультатыЗапроса[3].Выгрузить();
	ТаблицаВидыКонтрагентов.Индексы.Добавить("Ссылка");
	
	ЮрЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо;
	ФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо;
	
	Результат = Новый Соответствие();
	
	Поиск		= Новый Структура("Ссылка");
	ПоискКодФК	= Новый Структура("Ссылка,КодФК");
	
	Для Каждого Контрагент Из СписокКонтрагентов Цикл
		МассивРезультатов = Новый Массив;
		СформированныйИдентификатор = "";
				
		Если Не ЗначениеЗаполнено(Контрагент) Тогда
			Если НужноИдентификаторов = 1 Тогда
				Результат.Вставить(Контрагент, СформированныйИдентификатор);
			Иначе
				МассивРезультатов.Добавить(СформированныйИдентификатор);
				Результат.Вставить(Контрагент, МассивРезультатов);
			КонецЕсли;
			
			Продолжить;
		КонецЕсли;
		
		Поиск.Ссылка		= Контрагент;
		ПоискКодФК.Ссылка	= Контрагент;
		
		МассивСтрок = ТаблицаВидыКонтрагентов.НайтиСтроки(Поиск);
		
		ВидКонтрагента = МассивСтрок[0].ВидКонтрагента;
		
		//
		// Юр.лицо
		//
		Если ВидКонтрагента = ЮрЛицо Тогда
			МассивСтрок = ТаблицаСведенияЮрЛиц.НайтиСтроки(Поиск);
			
			Если МассивСтрок.Количество() = 0 Тогда
				Если НужноИдентификаторов = 1 Тогда
					Результат.Вставить(Контрагент, СформированныйИдентификатор);
				Иначе
					МассивРезультатов.Добавить(СформированныйИдентификатор);
					Результат.Вставить(Контрагент, МассивРезультатов);
				КонецЕсли;
				
				Продолжить;
			КонецЕсли;
			
			СтрокаДанныхЮрлица = МассивСтрок[0];
			
			ИНН = СокрЛП(СтрокаДанныхЮрлица.ИНН);
			КПП = СокрЛП(СтрокаДанныхЮрлица.КПП);
			
			Если ЗначениеЗаполнено(ИНН)
				И ЗначениеЗаполнено(КПП) Тогда
				
				ИННКПП = ИНН+КПП;
				
				СформированныйИдентификатор = ?(СтрокаДанныхЮрлица.ИностраннаяОрганизация,"3","2") + СтроковыеФункцииКлиентСервер.ДополнитьСтроку(ИННКПП,21,"0","Слева");
				
			ИначеЕсли СтрокаДанныхЮрлица.ИностраннаяОрганизация
				И ЗначениеЗаполнено(СтрокаДанныхЮрлица.НалоговыйНомер) Тогда
				
				НалоговыйНомер = СокрЛП(ВРег(СтрокаДанныхЮрлица.НалоговыйНомер));
				НедопустимыеСимволы = СтрСоединить(СтрРазделить(НалоговыйНомер,СтрокаБуквЦифр,Ложь));//удаляем разрешенные символы и оставляем недопустимые
								
				Если НедопустимыеСимволы<>"" Тогда								
					НалоговыйНомер = СтрСоединить(СтрРазделить(НалоговыйНомер,НедопустимыеСимволы,Ложь));//удаляем найденне недопустимые символы оставляем только разрешенные									
				КонецЕсли;
				ПолныйКодСтраны = СтрокаДанныхЮрлица.СимвольныйКодСтраны + СтрокаДанныхЮрлица.КодСтраны;
				Если ЗначениеЗаполнено(НалоговыйНомер) Тогда
					СформированныйИдентификатор = "300" + СтроковыеФункцииКлиентСервер.ДополнитьСтроку(НалоговыйНомер,14,"0","Слева")+ПолныйКодСтраны;
				КонецЕсли;
				
			КонецЕсли;
			
			Если НужноИдентификаторов = 1 Тогда
				Результат.Вставить(Контрагент, СформированныйИдентификатор);
			Иначе
				МассивРезультатов.Добавить(СформированныйИдентификатор);
				Результат.Вставить(Контрагент, МассивРезультатов);
			КонецЕсли;
						
		// Физ.лицо
		//
		ИначеЕсли ВидКонтрагента = ФизЛицо Тогда
			МассивСтрок = ТаблицаСведенияФизЛиц.НайтиСтроки(Поиск);
			
			Если МассивСтрок.Количество() = 0 Тогда
				
				Если НужноИдентификаторов = 1 Тогда
					Результат.Вставить(Контрагент, СформированныйИдентификатор);
				Иначе
					МассивРезультатов.Добавить(СформированныйИдентификатор);
					Результат.Вставить(Контрагент, МассивРезультатов);
				КонецЕсли;
							
				Продолжить;
			КонецЕсли;
			
			СтрокаДанныхФизлица = МассивСтрок[0];
			
			Если ЗначениеЗаполнено(СтрокаДанныхФизлица.ОГРНИП)
				ИЛИ СтрокаДанныхФизлица.ТипКонтрагентаКод = "6" Тогда
				
				//это ИП ИЛИ САМОЗАНЯТЫЙ (тип контрагента = 6) - идентификатор только по ИНН
				Если ЗначениеЗаполнено(СтрокаДанныхФизлица.ИНН) Тогда
						
					ИНН = СокрЛП(СтрокаДанныхФизлица.ИНН);
					СформированныйИдентификатор = "4" + СтроковыеФункцииКлиентСервер.ДополнитьСтроку(ИНН,21,"0","Слева");
						
				КонецЕсли;
				
				Если НужноИдентификаторов = 1 Тогда
					Результат.Вставить(Контрагент, СформированныйИдентификатор);
				Иначе
					МассивРезультатов.Добавить(СформированныйИдентификатор);
					Результат.Вставить(Контрагент, МассивРезультатов);
				КонецЕсли;
				
			Иначе
				
				//несколько идентификаторов может быть только у физлиц
				КоличествоСформированныхИдентификаторов = 0;
				Для Каждого ТекДок Из МассивКодовФК Цикл
					СформированныйИдентификатор = "";
					
					Если ТекДок = "14" Тогда
						СНИЛС = СтрЗаменить(СтрокаДанныхФизлица.СтраховойНомерПФР,"-","");
						СНИЛС = СтрЗаменить(СНИЛС," ","");
						
						Если ЗначениеЗаполнено(СНИЛС) Тогда
							СформированныйИдентификатор = "114" + СтроковыеФункцииКлиентСервер.ДополнитьСтроку(СНИЛС,19,"0","Слева");
						КонецЕсли;
					ИначеЕсли ТекДок = "21" Тогда
						ИНН = СокрЛП(СтрокаДанныхФизлица.ИНН);
						ИННОбработан = Истина;
						Если ЗначениеЗаполнено(ИНН) Тогда
							СформированныйИдентификатор = "121" + СтроковыеФункцииКлиентСервер.ДополнитьСтроку(ИНН,19,"0","Слева");
						КонецЕсли;
					Иначе
						ПоискКодФК.КодФК = ТекДок;
						
						МассивСтрок = ТаблицаСведенияФизЛиц.НайтиСтроки(ПоискКодФК);
						
						Если МассивСтрок.Количество() = 0 Тогда
							Продолжить;
						КонецЕсли;
						
						СтрокаПоВидуДокумента = МассивСтрок[0];
						
						СтрокаПоВидуДокумента.Серия = СокрЛП(СтрокаПоВидуДокумента.Серия);
						СтрокаПоВидуДокумента.Номер = СокрЛП(СтрокаПоВидуДокумента.Номер);
					
						//если заполнена серия или номер, попробуем сформировать идентификатор
						Если ЗначениеЗаполнено(СтрокаПоВидуДокумента.Серия)
							ИЛИ ЗначениеЗаполнено(СтрокаПоВидуДокумента.Номер) Тогда
														
							//приведем к верхнему регистру и удалим недопустимые символы
							Если ЗначениеЗаполнено(СтрокаПоВидуДокумента.Серия) Тогда
								
								СтрокаПоВидуДокумента.Серия = ВРег(СтрокаПоВидуДокумента.Серия);
								НедопустимыеСимволы = СтрСоединить(СтрРазделить(СтрокаПоВидуДокумента.Серия,СтрокаБуквЦифр,Ложь));//удаляем разрешенные символы и оставляем недопустимые
								
								Если НедопустимыеСимволы<>"" Тогда								
									СтрокаПоВидуДокумента.Серия = СтрСоединить(СтрРазделить(СтрокаПоВидуДокумента.Серия,НедопустимыеСимволы,Ложь));//удаляем найденне недопустимые символы оставляем только разрешенные									
								КонецЕсли;
								
							КонецЕсли;
							
							Если ЗначениеЗаполнено(СтрокаПоВидуДокумента.Номер) Тогда
								
								СтрокаПоВидуДокумента.Номер = ВРег(СтрокаПоВидуДокумента.Номер);
								НедопустимыеСимволы = СтрСоединить(СтрРазделить(СтрокаПоВидуДокумента.Номер,СтрокаБуквЦифр,Ложь));//удаляем разрешенные символы и оставляем недопустимые
								
								Если НедопустимыеСимволы<>"" Тогда
									СтрокаПоВидуДокумента.Номер = СтрСоединить(СтрРазделить(СтрокаПоВидуДокумента.Номер,НедопустимыеСимволы,Ложь));//оставляем только разрешенные
								КонецЕсли;
								
							КонецЕсли;
							
							//если после удаления недопустимых символов что-то осталось, значит сформируем идентификатор
							Если ЗначениеЗаполнено(СтрокаПоВидуДокумента.Серия)
								ИЛИ ЗначениеЗаполнено(СтрокаПоВидуДокумента.Номер) Тогда
								
								СерияНомер = СтрокаПоВидуДокумента.Серия + СтрокаПоВидуДокумента.Номер;
								
								СформированныйИдентификатор = "1" + ТекДок + СтроковыеФункцииКлиентСервер.ДополнитьСтроку(СерияНомер,19,"0","Слева");
								
							КонецЕсли;
						КонецЕсли;
						
					КонецЕсли;
					
					Если ЗначениеЗаполнено(СформированныйИдентификатор) Тогда
						КоличествоСформированныхИдентификаторов = КоличествоСформированныхИдентификаторов + 1;
						Если НужноИдентификаторов = 1 Тогда
							Результат.Вставить(Контрагент, СформированныйИдентификатор);
						Иначе
							МассивРезультатов.Добавить(СформированныйИдентификатор);
							Результат.Вставить(Контрагент, МассивРезультатов);
						КонецЕсли;
						
						Если КоличествоСформированныхИдентификаторов >= НужноИдентификаторов Тогда					
							Прервать;
						КонецЕсли;
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
				
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции


// Определяет наличие видов субконто хотя бы на одном из счетов списка, а также признаки учета субконто хотя бы на одном из счетов списка.
// Если хотя бы на одном счете есть субконто, или установлен признак учета субконто, то для соответствующего свойства возвращается Истина.
// Если на всех счетах отсутствует субконто, или сброшен признак учета субконто, то для соответствующего свойства возвращается Ложь.
// Применяется для настройки форм документов, настройки видимости элементов, и т.п.
//
// Параметры:
//	СписокСчетов		- Массив, СписокЗначений	- ссылки на счета ЕПСБУ;
//	ВидыСубконтоСтрокой	- Строка	- наименования видов субконто, через запятую.
//
// Возвращаемое значение:
//	Структура
//	  * Ключ		- Строка	- наименование вида субконто.
//								Возвращаемое значение содержит ключи (наименования) всех видов субконто,
//								переданных в параметре ВидыСубконтоСтрокой;
//	  * Значение	- Структура	- обнаруженные субконто и их признаки учета для указанного списка счетов.
//								Структура содержит следующие ключи:
//								* ЕстьСубконто			- тип Булево	- признак наличия субконто хотя бы на одном из счетов списка;
//								* ПризнакиУчетаСубконто	- тип Структура	- признаки учета субконто хотя бы на одном из счетов списка;
//																		Структура содержит следующие ключи:
//																		* Суммовой
//																		* Валютный
//																		* Количественный
//																		* Обязательный
//
// Пример использования:
//	НаличиеСубконто = БухгалтерскийУчет.ЕстьСубконтоСписокСчетов(Счета106хП, "ЦМО");
//	СвойстваСубконтоЦМО = НаличиеСубконто["ЦМО"];
//	ЦМООбязательное = СвойстваСубконтоЦМО.ЕстьСубконто И СвойстваСубконтоЦМО.ПризнакиУчетаСубконто.Обязательный;
Функция ЕстьСубконтоСписокСчетов(СписокСчетов, ВидыСубконтоСтрокой) Экспорт
	
	ИменаСубконто = СтрРазделить(ВидыСубконтоСтрокой, ", ", Ложь);
	
	ВидыСубконто = Новый Массив();
	
	Для Каждого ИмяСубконто Из ИменаСубконто Цикл
		ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто[ИмяСубконто]);
	КонецЦикла;
	
	ПризнакиУчетаСубконто = Новый Структура();
	ПризнакиУчетаСубконто.Вставить("Суммовой",			Ложь);
	ПризнакиУчетаСубконто.Вставить("Валютный",			Ложь);
	ПризнакиУчетаСубконто.Вставить("Количественный",	Ложь);
	ПризнакиУчетаСубконто.Вставить("Обязательный",		Ложь);
	
	ШаблонПризнакиУчетаСубконто = Новый ФиксированнаяСтруктура(ПризнакиУчетаСубконто);
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивСчетов", СписокСчетов);
	ЗапросПоиск.УстановитьПараметр("МассивВидовСубконто", ВидыСубконто);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Наличие указанных видов субконто
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка			КАК Счет,
	|	ВидСубконто		КАК ВидСубконто,
	|	
	|	// Признаки учета субконто
	|	Суммовой		КАК Суммовой,
	|	Валютный		КАК Валютный,
	|	Количественный	КАК Количественный,
	|	Обязательный	КАК Обязательный
	|ИЗ
	|	ПланСчетов.ЕПСБУ.ВидыСубконто
	|ГДЕ
	|	Ссылка В(&МассивСчетов)
	|	И ВидСубконто В(&МассивВидовСубконто)
	|";
	
	ТаблицаСубконто = ЗапросПоиск.Выполнить().Выгрузить();
	
	Результат = Новый Структура();
	
	Поиск = Новый Структура();
	
	Для Каждого ИмяСубконто Из ИменаСубконто Цикл
		
		Если Результат.Свойство(ИмяСубконто) Тогда
			Продолжить;
		КонецЕсли;
		
		Поиск.Вставить("ВидСубконто", ПланыВидовХарактеристик.ВидыСубконто[ИмяСубконто]);
		
		МассивСтрок = ТаблицаСубконто.НайтиСтроки(Поиск);
		
		ЕстьСубконто = (МассивСтрок.Количество() > 0);
		
		Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
			
			ПризнакиУчетаСубконто = Новый Структура(ШаблонПризнакиУчетаСубконто);
			
			Для Каждого Элемент Из ШаблонПризнакиУчетаСубконто Цикл
				ПризнакУчета = Элемент.Ключ;
				
				Если СтрокаТаблицы[ПризнакУчета] Тогда
					ПризнакиУчетаСубконто.Вставить(ПризнакУчета, Истина);
				КонецЕсли;
			КонецЦикла;
			
		КонецЦикла;
		
		СвойстваСубконто = Новый Структура();
		СвойстваСубконто.Вставить("ЕстьСубконто",			ЕстьСубконто);
		СвойстваСубконто.Вставить("ПризнакиУчетаСубконто",	ПризнакиУчетаСубконто);
		
		Результат.Вставить(ИмяСубконто, СвойстваСубконто);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Заменяет на NULL реквизиты проводок, отключенные признаками учета счета.
// Например, на не валютном счете устанавливает NULL в колонки Валюта и ВалютнаяСумма.
//
// Параметры:
//  ТаблицаПроводок	 - ТаблицаЗначений	 - обязательно должна содержать колонки:
//    *СчетДт - ПланСчетовСсылка.ЕПСБУ -
//    *КПСДт - ПланСчетовСсылка.КлассификационныеПризнакиСчетов -
//    *КЭКДт - ПланСчетовСсылка.КОСГУ -
//    *ПодразделениеДт - ПланСчетовСсылка.Подразделения -
//    *ВалютаДт - ПланСчетовСсылка.Валюты -
//    *ВалютнаяСуммаДт - Число -
//    *КоличествоДт - Число -
//    *СчетКт - ПланСчетовСсылка.ЕПСБУ -
//    *КПСКт - ПланСчетовСсылка.КлассификационныеПризнакиСчетов -
//    *КЭККт - ПланСчетовСсылка.КОСГУ -
//    *ПодразделениеКт - ПланСчетовСсылка.Подразделения -
//    *ВалютаКт - ПланСчетовСсылка.Валюты -
//    *ВалютнаяСуммаКт - Число -
//    *КоличествоКт - Число -
//
Процедура ОчиститьРеквизитыПроводокПоПризнакамУчета(ТаблицаПроводок) Экспорт

	Для каждого Проводка Из ТаблицаПроводок Цикл
		
		ПризнакиУчета = ПризнакиУчетаСчета(Проводка.СчетДт);
		БухгалтерскийУчетКлиентСервер.ОчиститьРеквизитыКорреспонденцииПроводкиПоПризнакамУчета(Проводка, ПризнакиУчета, "Дт");
		
		ПризнакиУчета = ПризнакиУчетаСчета(Проводка.СчетКт);
		БухгалтерскийУчетКлиентСервер.ОчиститьРеквизитыКорреспонденцииПроводкиПоПризнакамУчета(Проводка, ПризнакиУчета, "Кт");
	
	КонецЦикла;

КонецПроцедуры

// Возвращает наименование печатной формы по коду формы (ОКУД)
//
// Параметры:
//  КодФормы - Строка - код формы по ОКУД
//
// Возвращаемое значение:
//  Строка - наименование формы
Функция НаименованиеПечатнойФормы(КодФормы) Экспорт
	Результат = "";
	Если КодФормы = "0510440" Тогда
		Результат = НСтр("ru = 'Решение о прекращении признания активами объектов нефинансовых активов'");
	ИначеЕсли КодФормы = "0504143" Тогда
		Результат = НСтр("ru = 'Акт о списании мягкого и хозяйственного инвентаря'");
	ИначеЕсли КодФормы = "0510466" Тогда
		Результат = НСтр("ru = 'Инвентаризационная опись (сличительная ведомость) по объектам нефинансовых активов'");
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

Функция ПодразделениеОбязательно(СписокСчетов) Экспорт
	
	Если СписокСчетов.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СписокСчетов", СписокСчетов);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Ссылка В(&СписокСчетов)
	|	И ЕПСБУ.УчетПоПодразделениям
	|	И НЕ ЕПСБУ.РазрешитьНеУказыватьПодразделение";
	
	Результат = Не Запрос.Выполнить().Пустой();
	
	Возврат Результат;
	
КонецФункции

Функция ПереченьПричинПросроченнойЗадолженности(ВидЗадолженности) Экспорт
	
	ПричиныОбразованияЗадолженности = Новый Массив;
	
	// Перечни причин образования задолженности согласно требованиям приказов Минфина 33н, 191н.
	Если ВидЗадолженности = Перечисления.ВидыЗадолженности.Дебиторская Тогда
		
		ПричиныОбразованияЗадолженности.Добавить(НСтр("ru = '03 - контрагентами нарушены сроки выполнения работ, работы по договору в установленный срок не выполнены'"));
		ПричиныОбразованияЗадолженности.Добавить(НСтр("ru = '81 - смерть физического лица, плательщика платежей в бюджет или объявление его умершим в порядке, установленном гражданским процессуальным законодательством Российской Федерации'"));
		ПричиныОбразованияЗадолженности.Добавить(НСтр("ru = '82 - документы на оплату за поставленный товар, оказанные услуги, выполненные работы контрагентом представлены с нарушением сроков'"));
		ПричиныОбразованияЗадолженности.Добавить(НСтр("ru = '84 - банкротство плательщика платежей в бюджет (налогоплательщика) в части задолженности по платежам в бюджет, не погашенным по причине недостаточности имущества должника и (или) невозможности их погашения учредителями (участниками) организации в пределах и порядке, которые установлены законодательством Российской Федерации'"));
		ПричиныОбразованияЗадолженности.Добавить(НСтр("ru = '85 - наличие судебного акта, в соответствии с которым администратор доходов бюджета утрачивает возможность взыскания задолженности по платежам в бюджет'"));
		ПричиныОбразованияЗадолженности.Добавить(НСтр("ru = '86 - вынесение судебным приставом-исполнителем постановления об окончании исполнительного производства и о возвращении взыскателю исполнительного документа в соответствии с законодательством Российской Федерации'"));
		ПричиныОбразованияЗадолженности.Добавить(НСтр("ru = '89 - иные причины возникновения просроченной дебиторской задолженности (дополнительная информация раскрывается в Таблице Пояснительной записки)'"));
		
	ИначеЕсли ВидЗадолженности = Перечисления.ВидыЗадолженности.Кредиторская Тогда
		
		ПричиныОбразованияЗадолженности.Добавить(НСтр("ru = '01 - банкротство контрагента (поставщика, исполнителя работ, услуг)'"));
		ПричиныОбразованияЗадолженности.Добавить(НСтр("ru = '02 - банкротство налогоплательщика'"));
		ПричиныОбразованияЗадолженности.Добавить(НСтр("ru = '03 - контрагентами нарушены сроки выполнения работ, работы по договору в установленный срок не выполнены'"));
		ПричиныОбразованияЗадолженности.Добавить(НСтр("ru = '04 - документы на оплату за поставленный товар, оказанные услуги, выполненные работы контрагентом представлены с нарушением сроков'"));
		ПричиныОбразованияЗадолженности.Добавить(НСтр("ru = '05 - иные причины возникновения просроченной кредиторской задолженности (дополнительная информация раскрывается в Таблице Пояснительной записки)'"));
		
	КонецЕсли;
	
	Возврат ПричиныОбразованияЗадолженности;
	
КонецФункции

#Область РавномерноеПризнаниеДоходовРасходов

Функция ДоляОчередногоМесяцаПриРавномерномПризнанииДоходовРасходов(Способ, Знач ОчереднойМесяц, Знач НачалоПериода, Знач КонецПериода, ПротоколРасчета = Неопределено) Экспорт
	
	ПротоколРасчета = Новый Структура;
	ПротоколРасчета.Вставить("Числитель",   0); // Вес очередного месяца (при расчете по месяцам - количество месяцев; при расчете по дням - количество дней в очередном месяце)
	ПротоколРасчета.Вставить("Знаменатель", 0); // Количество месяцев (дней), в течение которых осталось погашать стоимость (включая очередной месяц)
	
	// Приведем NULL, Неопределено и пр. к пустой дате.
	НачалоПериода = ?(НЕ ЗначениеЗаполнено(НачалоПериода), Дата('00010101'), НачалоПериода);
	КонецПериода  = ?(НЕ ЗначениеЗаполнено(КонецПериода),  Дата('00010101'), КонецПериода);
	
	ОчереднойМесяц  = НачалоМесяца(ОчереднойМесяц);
	
	Если ОчереднойМесяц < НачалоМесяца(НачалоПериода) Тогда
		Возврат 0;
	КонецЕсли;
	
	Если ОчереднойМесяц > НачалоМесяца(КонецПериода) Тогда
		// Это, вероятно, результат ошибки в учете.
		// Ошибку пользователь может исправить разными способами.
		// Для того, чтобы он мог выбрать подходящий способ, автоматически счет не закрываем.
		Возврат 0;
	КонецЕсли;
	
	Если Способ = Перечисления.СпособыПризнанияРасходов.ПоКалендарнымДням Тогда
		
		Если НачалоМесяца(ОчереднойМесяц) > НачалоМесяца(НачалоПериода) Тогда
			НачалоОстаткаПериода = НачалоМесяца(ОчереднойМесяц);
			ПротоколРасчета.Числитель = День(КонецМесяца(ОчереднойМесяц));
		Иначе
			НачалоОстаткаПериода = НачалоПериода;
			Если НачалоМесяца(ОчереднойМесяц) < НачалоМесяца(НачалоПериода) Тогда
				ПротоколРасчета.Числитель = 0;
			Иначе
				ОчереднойМесяц = Макс(ОчереднойМесяц, НачалоПериода);
				ПротоколРасчета.Числитель = День(КонецМесяца(ОчереднойМесяц)) - День(ОчереднойМесяц) + 1;
			КонецЕсли;
		КонецЕсли;
		
		ПротоколРасчета.Знаменатель = Окр((КонецДня(КонецПериода) - НачалоОстаткаПериода + 1) / 24 / 60 / 60, 0);
		// Количество дней между НачалоОстаткаПериода и КонецПериода.
		// Здесь операции с датами имеют следующий смысл:
		// a. КонецДня(КонецПериода) + 1: получаем дату начала следующего дня, чтобы количество секунд было кратным целым суткам
		// b. (a) - НачалоОстаткаПериода: получаем количество секунд.
		// Однако, в выражении порядок слагаемых другой, чтобы обеспечить корректное преобразование типов.
		
		Если ПротоколРасчета.Знаменатель < ПротоколРасчета.Числитель Тогда
			// Такое может быть в последнем месяце признания доходов, расходов.
			ПротоколРасчета.Числитель = ПротоколРасчета.Знаменатель;
		КонецЕсли;
		
	ИначеЕсли Способ = Перечисления.СпособыПризнанияРасходов.ПоМесяцам Тогда
		
		Если ОчереднойМесяц = НачалоМесяца(НачалоПериода) Тогда
			// Так как оперируем остатком, то можно сэкономить и в расчет принимать только оставшийся срок признания доходов, расходов.
			ПараметрыПризнания = ПараметрыПризнанияДоходовРасходовПоМесяцам(НачалоПериода, КонецПериода);
		Иначе
			ПараметрыПризнания = ПараметрыПризнанияДоходовРасходовПоМесяцам(ОчереднойМесяц, КонецПериода);
		КонецЕсли;
		
		ПротоколРасчета.Знаменатель = ПараметрыПризнания.ВсегоКоличествоМесяцев;
		
		Если ОчереднойМесяц >= ПараметрыПризнания.НачалоПериодаЦелыхМесяцев
			И ОчереднойМесяц <= ПараметрыПризнания.КонецПериодаЦелыхМесяцев Тогда
			ПротоколРасчета.Числитель = 1;
		Иначе
			НецелыйМесяц = ПараметрыПризнания.НецелыеМесяцы.Найти(ОчереднойМесяц, "Месяц");
			Если НецелыйМесяц <> Неопределено Тогда
				ПротоколРасчета.Числитель = НецелыйМесяц.Вес;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ПротоколРасчета.Знаменатель = 0 Тогда
		Возврат 0;
	Иначе
		Возврат ПротоколРасчета.Числитель / ПротоколРасчета.Знаменатель;
	КонецЕсли;
	
КонецФункции

Функция КоличествоМесяцевДнейМеждуДатами(СпособПризнанияРасходов, ДатаНачала, ДатаОкончания) Экспорт
	
	Если ДатаНачала > ДатаОкончания Тогда
		Возврат 0; // Срок списания еще не начался.
	КонецЕсли;
	
	Если СпособПризнанияРасходов = Перечисления.СпособыПризнанияРасходов.ПоМесяцам Тогда
		
		// Общее количество месяцев списания.
		ПараметрыПризнания = ПараметрыПризнанияДоходовРасходовПоМесяцам(ДатаНачала, ДатаОкончания);
		Возврат ПараметрыПризнания.ВсегоКоличествоМесяцев;
		
	ИначеЕсли СпособПризнанияРасходов = Перечисления.СпособыПризнанияРасходов.ПоКалендарнымДням Тогда
		
		// Количество календарных дней между датами.
		Возврат Окр((КонецДня(ДатаОкончания) - ДатаНачала + 1) / 24 / 60 / 60, 0);
		
	Иначе // В особом порядке и пр. - целое число месяцев списания.
		
		РазницаМесяцев = Месяц(ДатаОкончания) - Месяц(ДатаНачала) + 1;
		РазницаЛет = Год(ДатаОкончания) - Год(ДатаНачала);
		Возврат РазницаМесяцев + 12 * РазницаЛет;
		
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область МежотчетныйПериод

// Возвращает номер уточнения периода по переданному виду межотчетного периода
//
// Параметры:
//  ВидМежотчетногоПериода	 - ПеречислениеСсылка.ВидыМежотчетногоПериода - вид межотчетного периода
// 
// Возвращаемое значение:
// Число - номер уточнения периода.
//
Функция ЗначениеУточненияПериода(ВидМежотчетногоПериода) Экспорт

	Если ВидМежотчетногоПериода = Перечисления.ВидыМежотчетногоПериода.ЗаключениеСчетов Тогда
		Возврат 1;
	ИначеЕсли ВидМежотчетногоПериода = Перечисления.ВидыМежотчетногоПериода.ТехнологическиеОперации Тогда
		Возврат 4;
	ИначеЕсли ВидМежотчетногоПериода = Перечисления.ВидыМежотчетногоПериода.ИзменениеВалютыБаланса Тогда
		Возврат 7;
	ИначеЕсли ВидМежотчетногоПериода = Перечисления.ВидыМежотчетногоПериода.СлужебныеОперации Тогда
		Возврат 9;	
	Иначе
		Возврат 0;
	КонецЕсли;

КонецФункции

// Возвращает начало периода (границу) с учетом вида межотчетного периода
//
Функция НачалоПериодаСУточнением(НачалоПериода, ВидМежотчетногоПериода = Неопределено, ТолькоУказанныйПериод = Ложь) Экспорт 
	
	Период = НачалоДня(НачалоПериода);
	
	Если ЗначениеЗаполнено(ВидМежотчетногоПериода) И ТолькоУказанныйПериод Тогда
		Период = Новый Граница(Новый МоментВремениСУточнениемПериода(КонецДня(НачалоПериода), ЗначениеУточненияПериода(ВидМежотчетногоПериода) - 1), ВидГраницы.Исключая);
	КонецЕсли;
	
	Возврат Период;
		
КонецФункции

// Возвращает конец периода (границу) с учетом вида межотчетного периода
//
Функция КонецПериодаСУточнением(КонецПериода, ВидМежотчетногоПериода = Неопределено, ТолькоУказанныйПериод = Ложь) Экспорт 
	
	Если ЗначениеЗаполнено(ВидМежотчетногоПериода) Тогда
		Период = Новый Граница(Новый МоментВремениСУточнениемПериода(КонецДня(КонецПериода), ЗначениеУточненияПериода(ВидМежотчетногоПериода)), ВидГраницы.Включая);
	Иначе
		Период = Новый Граница(КонецДня(КонецПериода), ВидГраницы.Включая);
	КонецЕсли;
	
	Возврат Период;
		
КонецФункции

// Проверяет наличие операций межотчетного периода в указанной дате.
//
// Параметры:
//	Период - Дата
//	Организация - СправочникСсылка.Организации
//
// Возвращаемое значение:
//	Булево
//
Функция ЕстьОперацииМежотчетногоПериода(Период, Организация) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК ЕстьОперации
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ЖурналПроводокЕПСБУ
	|ГДЕ
	|	ЖурналПроводокЕПСБУ.Период = &Период
	|	И ЖурналПроводокЕПСБУ.УточнениеПериода > 0
	|	И ЖурналПроводокЕПСБУ.Организация = &Организация";
	
	Запрос.Параметры.Вставить("Период", 	 Период);
	Запрос.Параметры.Вставить("Организация", Организация);
	
	Возврат Не Запрос.Выполнить().Пустой();
КонецФункции

#КонецОбласти

#Область НалоговыеРеквизиты

// Плучает значения налоговых реквизитов по их строковому представлению
//
// Параметры:
//  Объект - Структура, ДанныеФормыСтруктура, ДокументОбъект, ДокументСсылка
//
// Возвращаемое значение:
//  Структура, ключи:
//  	ПолеВводаГодПериода
//		ПолеВводаДатаПериода
//		ПолеВводаНомерПериода
//  	ПолеВводаПоказательДаты
//		ПолеВводаПоказательНомера
//		ПолеВводаПоказательОснования
//		ПолеВводаПоказательПериода
//		ПолеВводаПоказательТипа
//		ПолеВводаСтатусСоставителя
//		ПолеВводаКодТаможенногоОргана
//
Функция ПолучитьЗначенияНалоговыхРеквизитов(Объект) Экспорт
	
	Результат = Новый Структура;
		
	Если ЗначениеЗаполнено(Объект.СтатусСоставителя) И СокрЛП(Объект.СтатусСоставителя) <> "0" Тогда
		Попытка
			Результат.Вставить("ПолеВводаСтатусСоставителя", Перечисления.СтатусыСоставителя["_"+СокрЛП(Объект.СтатусСоставителя)]);
		Исключение
			Результат.Вставить("ПолеВводаСтатусСоставителя", Перечисления.СтатусыСоставителя.ПустаяСсылка());
		КонецПопытки;
	Иначе
		Результат.Вставить("ПолеВводаСтатусСоставителя", Перечисления.СтатусыСоставителя.ПустаяСсылка());
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ПоказательОснования) И СокрЛП(Объект.ПоказательОснования) <> "0" Тогда
		Попытка
			Результат.Вставить("ПолеВводаПоказательОснования", Перечисления.ОснованияПлатежа[СокрЛП(Объект.ПоказательОснования)]);
		Исключение
			Результат.Вставить("ПолеВводаПоказательОснования", Перечисления.ОснованияПлатежа.ПустаяСсылка());
		КонецПопытки;
	Иначе
		Результат.Вставить("ПолеВводаПоказательОснования", Перечисления.ОснованияПлатежа.ПустаяСсылка());
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ПоказательТипа) И СокрЛП(Объект.ПоказательТипа) <> "0" Тогда
		Попытка
			Результат.Вставить("ПолеВводаПоказательТипа", Перечисления.ПоказателиТипа[СокрЛП(Объект.ПоказательТипа)]);
		Исключение
			Результат.Вставить("ПолеВводаПоказательТипа", Перечисления.ПоказателиТипа.ПустаяСсылка());
		КонецПопытки;
	Иначе
		Результат.Вставить("ПолеВводаПоказательТипа", Перечисления.ПоказателиТипа.ПустаяСсылка());
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ПоказательПериода) И Объект.ПоказательПериода <> "0" Тогда
		
		Результат.Вставить("ПолеВводаКодТаможенногоОргана", Объект.ПоказательПериода);
		
		СоставПериода = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Объект.ПоказательПериода, ".");
		
		Если СоставПериода.Количество() = 3 Тогда
			
			Если ЗначениеЗаполнено(СоставПериода[0])
				И ЗначениеЗаполнено(СоставПериода[1])
				И ЗначениеЗаполнено(СоставПериода[2]) Тогда
				Попытка
					ПолеВводаДатаПериода = Дата(СоставПериода[2], СоставПериода[1], СоставПериода[0]);
				Исключение
					ПолеВводаДатаПериода = ПлатежноРасчетныеДокументы.ПустоеЗначениеТипа(Тип("Дата"));
				КонецПопытки;
				
				Результат.Вставить("ПолеВводаДатаПериода", ПолеВводаДатаПериода);
				
				Если ЗначениеЗаполнено(ПолеВводаДатаПериода) Тогда
					Результат.Вставить("ПолеВводаПоказательПериода", Перечисления.ПоказателиПериода["ДАТА"]);
					Результат.Вставить("ПолеВводаНомерПериода", 0);
					Результат.Вставить("ПолеВводаГодПериода",   0);
				Иначе
					Попытка
						Результат.Вставить("ПолеВводаПоказательПериода", Перечисления.ПоказателиПериода[СоставПериода[0]]);
					Исключение
						Результат.Вставить("ПолеВводаПоказательПериода", Перечисления.ПоказателиПериода.ПустаяСсылка());
					КонецПопытки;
					Если ЗначениеЗаполнено(Результат.ПолеВводаПоказательПериода) Тогда
						Результат.Вставить("ПолеВводаНомерПериода", СоставПериода[1]);
						Результат.Вставить("ПолеВводаГодПериода",   СоставПериода[2]);
					Иначе
						Результат.Вставить("ПолеВводаНомерПериода", 0);
						Результат.Вставить("ПолеВводаГодПериода",   0);
					КонецЕсли;
				КонецЕсли;
				
			Иначе
				Результат.Вставить("ПолеВводаПоказательПериода", Перечисления.ПоказателиПериода.ПустаяСсылка());
                Результат.Вставить("ПолеВводаДатаПериода", "");
				Результат.Вставить("ПолеВводаНомерПериода", 0);
				Результат.Вставить("ПолеВводаГодПериода",   0);
			КонецЕсли;
		Иначе
			Результат.Вставить("ПолеВводаПоказательПериода", Перечисления.ПоказателиПериода.ПустаяСсылка());
			Результат.Вставить("ПолеВводаДатаПериода", "");
			Результат.Вставить("ПолеВводаНомерПериода", 0);
			Результат.Вставить("ПолеВводаГодПериода",   0);
		КонецЕсли;	
	Иначе
		Результат.Вставить("ПолеВводаПоказательПериода", Перечисления.ПоказателиПериода.ПустаяСсылка());
		Результат.Вставить("ПолеВводаДатаПериода", "");
		Результат.Вставить("ПолеВводаНомерПериода", 0);
		Результат.Вставить("ПолеВводаГодПериода",   0);
	КонецЕсли;	
	
	Если Объект.ПоказательНомера <> "0" Тогда
		Результат.Вставить("ПолеВводаПоказательНомера", Объект.ПоказательНомера);
	Иначе
		Результат.Вставить("ПолеВводаПоказательНомера", "");
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(Объект.ПоказательДаты) И СокрЛП(Объект.ПоказательДаты) <> "0" Тогда
		СоставДаты = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СокрЛП(Объект.ПоказательДаты), ".");
		Если СоставДаты.Количество() = 3 
			И ЗначениеЗаполнено(СоставДаты[0])
			И ЗначениеЗаполнено(СоставДаты[1])
			И ЗначениеЗаполнено(СоставДаты[2]) Тогда
			Попытка
				Результат.Вставить("ПолеВводаПоказательДаты", Дата(СоставДаты[2], СоставДаты[1], СоставДаты[0]));
			Исключение
				Результат.Вставить("ПолеВводаПоказательДаты", "");
			КонецПопытки;
		Иначе
			Результат.Вставить("ПолеВводаПоказательДаты", "");
		КонецЕсли;
	Иначе
		Результат.Вставить("ПолеВводаПоказательДаты", "");
	КонецЕсли;
	
	Результат.Вставить("ТипНалоговогоПериодаСтрокой", ОбщегоНазначенияБГУПовтИсп.СвойствоЗначенияПеречисления(Результат.ПолеВводаПоказательПериода, "Имя")); 
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьНастройкиВидаНалоговогоПлатежа(Знач ВидНалога, Знач НаДату = Неопределено, Знач Организация = Неопределено) Экспорт
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("КодГлавыБК",					"КодГлавыБК");
	СтруктураРеквизитов.Вставить("БК",							"Классификатор");
	СтруктураРеквизитов.Вставить("ОчередностьПлатежа",			"ОчередностьПлатежа");
	СтруктураРеквизитов.Вставить("СтатусСоставителя",			"СтатусСоставителя");
	СтруктураРеквизитов.Вставить("ЗаполнятьНезаполненныеНулем",	"ЗаполнятьНезаполненныеНулем");
	СтруктураРеквизитов.Вставить("ТаможенныйПлатеж",			"ТаможенныйПлатеж");
	СтруктураРеквизитов.Вставить("ТекстНазначенияПлатежаВида",	"ТекстНазначенияПлатежа");
	СтруктураРеквизитов.Вставить("СчетУчета",					"СчетУчета");
	
	Если ЗначениеЗаполнено(ВидНалога) Тогда 
		
		СтруктураРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВидНалога, СтруктураРеквизитов);
		
		СтруктураРеквизитов.Вставить("СчетУчета", СчетПоКоду(СтруктураРеквизитов.СчетУчета, НаДату, Организация));
		
	Иначе
		
		Для Каждого КлючИЗначение Из СтруктураРеквизитов Цикл
			
			СтруктураРеквизитов.Вставить(КлючИЗначение.Ключ, "");
			
		КонецЦикла;
		
	КонецЕсли;
	
	СтруктураРеквизитов.Вставить("КодБКНалога", СтруктураРеквизитов.КодГлавыБК + СтруктураРеквизитов.БК);
	
	Возврат СтруктураРеквизитов;
	
КонецФункции	

Функция ПолучитьНастройкиНалоговогоПлатежа(Знач Налог, ДополнитьНастройкамиВида = Ложь, Знач НаДату = Неопределено, Знач Организация = Неопределено) Экспорт
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("ВидНалогаИлиПлатежа");
	СтруктураРеквизитов.Вставить("Контрагент");
	СтруктураРеквизитов.Вставить("СчетКонтрагента");
	СтруктураРеквизитов.Вставить("ИННПлательщика");   
	СтруктураРеквизитов.Вставить("КПППлательщика");
    СтруктураРеквизитов.Вставить("РегистрационныйНомер");
    СтруктураРеквизитов.Вставить("КодОКТМО");
    СтруктураРеквизитов.Вставить("КодОКАТО"); 
	СтруктураРеквизитов.Вставить("ПоказательОснования");         
	СтруктураРеквизитов.Вставить("ПоказательПериода");
	СтруктураРеквизитов.Вставить("ПоказательТипа");
	СтруктураРеквизитов.Вставить("КодТаможенногоОргана");
	СтруктураРеквизитов.Вставить("ТекстНазначенияПлатежа");
                        
    СтруктураРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Налог, СтруктураРеквизитов);
	
	Если ДополнитьНастройкамиВида  Тогда
		
		НастройкиВида = ПолучитьНастройкиВидаНалоговогоПлатежа(СтруктураРеквизитов.ВидНалогаИлиПлатежа, НаДату, Организация);
		
		Для Каждого КлючИЗначение Из НастройкиВида Цикл
			
			СтруктураРеквизитов.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
			
		КонецЦикла;
		
	КонецЕсли;	
		
    Возврат СтруктураРеквизитов;
	
КонецФункции	

