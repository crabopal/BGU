								   + "Наименование,"
								   + "Код,"
								   + "Родитель,"
								   + "Вид,"
								   + "Забалансовый,"
								   + "ЗапретитьИспользоватьВПроводках,"
								   + "НомерЖурнала,"
								   + "НомерЖурналаПриоритет,"
								   + "УчетПоКПС,"
								   + "УчетПоКЭК,"
								   + "УчетПоПодразделениям,"
								   + "КОСГУДт,"
								   + "КОСГУКт,"
								   + "ДляКазенных,"
								   + "ДляБюджетных,"
								   + "ДляАвтономных,"
								   + "Валютный,"
								   + "Количественный,"
								   + "ЭлементГруппа,"
								   + "КоличествоСубконто",
								   ПланыСчетов[ИмяПланаСчетов].ПустаяСсылка(),
								   "",
								   "",
								   ПланыСчетов[ИмяПланаСчетов].ПустаяСсылка(),
								   ВидСчета.АктивноПассивный,
								   Ложь,
								   Ложь,
								   Справочники.Журналы.ПустаяСсылка(),
								   0,
								   Ложь,
								   Ложь,
								   Ложь,
								   Справочники.КОСГУ.ПустаяСсылка(),
								   Справочники.КОСГУ.ПустаяСсылка(),
								   Ложь,
								   Ложь,
								   Ложь,
								   Ложь,
								   Ложь,
								   Ложь,
								   0);
	МаксКоличествоСубконто = БухгалтерскийУчетПовтИсп.ПолучитьМаксКоличествоСубконто();
	Для Индекс = 1 По МаксКоличествоСубконто Цикл
		СтруктураСчета.Вставить("ВидСубконто" + Индекс,                   		Неопределено);
		СтруктураСчета.Вставить("ВидСубконто" + Индекс + "Наименование",  		"");
		СтруктураСчета.Вставить("ВидСубконто" + Индекс + "ТипЗначения",   		Неопределено);
		СтруктураСчета.Вставить("ВидСубконто" + Индекс + "Суммовой",      		Ложь);
		СтруктураСчета.Вставить("ВидСубконто" + Индекс + "ТолькоОбороты", 		Ложь);
		СтруктураСчета.Вставить("ВидСубконто" + Индекс + "ВводПустыхСубконто", 	Ложь);
		СтруктураСчета.Вставить("ВидСубконто" + Индекс + "Обязательный", 		Ложь);
	КонецЦикла;
	
	// если требуются все реквизиты, то возвращается эталонная структура
	Если ИменаРеквизитов = "" Тогда
		Возврат СтруктураСчета;
	// если требуется только часть реквизитов, то создается структура с требуемыми реквизитами 
	// и заполняется значениями из эталонной структуры
	Иначе
		СтруктураРезультат = Новый Структура(ИменаРеквизитов);
		Если СтруктураРезультат.Свойство("Субконто") Тогда
			СтруктураРезультат.Удалить("Субконто");
			МаксКоличествоСубконто = БухгалтерскийУчетПовтИсп.ПолучитьМаксКоличествоСубконто();
			Для Индекс = 1 По МаксКоличествоСубконто Цикл
				СтруктураРезультат.Вставить("ВидСубконто" + Индекс,                   		Неопределено);
				СтруктураРезультат.Вставить("ВидСубконто" + Индекс + "Наименование",  		"");
				СтруктураРезультат.Вставить("ВидСубконто" + Индекс + "ТипЗначения",   		Неопределено);
				СтруктураРезультат.Вставить("ВидСубконто" + Индекс + "Суммовой",      		Ложь);
				СтруктураРезультат.Вставить("ВидСубконто" + Индекс + "ТолькоОбороты", 		Ложь);
				СтруктураРезультат.Вставить("ВидСубконто" + Индекс + "ВводПустыхСубконто", 	Ложь);
				СтруктураРезультат.Вставить("ВидСубконто" + Индекс + "Обязательный", 		Ложь);
			КонецЦикла;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(СтруктураРезультат, СтруктураСчета);
		Возврат СтруктураРезультат;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьЗначенияОтбораКФОПоУчетнойПолитике(СписокОграничений)
	
	Перем Организация, ИФО, НаДату;
	
	Результат = Новый Массив;
	
	СписокОграничений.Свойство("Организация", Организация);
	СписокОграничений.Свойство("ИФО", ИФО);
	СписокОграничений.Свойство("НаДату", НаДату);
	
	Результат = БухгалтерскийУчетПовтИсп.КФОПоУчетнойПолитике(Организация, ИФО, НаДату); 
	
	Возврат Результат;

	
КонецФункции	

Функция ПолучитьЗначенияОтбораКПСПоСпискуОграничений(СписокОграничений)
	
	Результат = Новый Массив;
	
	ИсточникОграничений = Новый Массив;
	
	Если ТипЗнч(СписокОграничений) = Тип("СписокЗначений") Тогда
		Для Каждого Элемент Из СписокОграничений Цикл
			ИсточникОграничений.Добавить(Элемент.Значение);
		КонецЦикла;
	ИначеЕсли ТипЗнч(СписокОграничений) = Тип("Массив") ИЛИ ТипЗнч(СписокОграничений) = Тип("ФиксированныйМассив")Тогда
		Для Каждого Элемент Из СписокОграничений Цикл
			ИсточникОграничений.Добавить(Элемент);
		КонецЦикла;
	Иначе
		ИсточникОграничений.Добавить(СписокОграничений);
	КонецЕсли;
	
	Для Каждого Элемент Из ИсточникОграничений Цикл
		Если ОбщегоНазначения.ВидОбъектаПоСсылке(Элемент) = "Перечисление" Тогда
			Если Результат.Найти(Элемент) = Неопределено Тогда
				Результат.Добавить(Элемент);
			КонецЕсли;
		ИначеЕсли ОбщегоНазначения.ВидОбъектаПоСсылке(Элемент) = "ПланСчетов" Тогда
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Результат, БухгалтерскийУчетПовтИсп.ПолучитьДопустимыеВидыКПССчета(Элемент), Истина);
		КонецЕсли;
	КонецЦикла;	
	
	Если НЕ Результат.Найти(ПредопределенноеЗначение("Перечисление.ВидыКБК.Произвольный")) = Неопределено
		И Результат.Найти(ПредопределенноеЗначение("Перечисление.ВидыКБК.АУИБУ")) = Неопределено Тогда
		Результат.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.АУИБУ"));
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции	

Функция ПолучитьЗначенияОтбораКПСПоУчетнойПолитике(СписокОграничений)
	
	Перем Организация, ИФО, КФО, НаДату;
	
	СписокОграничений.Свойство("Организация", Организация);
	СписокОграничений.Свойство("КФО",         КФО);
	СписокОграничений.Свойство("НаДату",      НаДату);
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		СписокОграничений.Свойство("ИФО", ИФО);
	КонецЕсли;
	
	// В параметрах функций ПовтИсп нельзя использовать мутабельные типы
	Если Организация <> Неопределено И НЕ ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Организация)) Тогда
		Организация = Неопределено;
	КонецЕсли;
	Если ИФО <> Неопределено И НЕ ОбщегоНазначения.ЭтоСсылка(ТипЗнч(ИФО)) Тогда
		ИФО = Неопределено;
	КонецЕсли;
	Если КФО <> Неопределено И НЕ ОбщегоНазначения.ЭтоСсылка(ТипЗнч(КФО)) Тогда
		КФО = Неопределено;
	КонецЕсли;
	
	// Если не заполнена организация, то вернуть все возможные виды КПС
	Если ЗначениеЗаполнено(Организация) Тогда
		Результат = БухгалтерскийУчетПовтИсп.ВидыКПСПоУчетнойПолитике(Организация, ИФО, КФО, НаДату);
	Иначе
		Результат = ВсеВидыКПС();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ВсеВидыКПС()

	Результат = Новый Массив;
	Результат.Добавить(Перечисления.ВидыКБК.гКБК);
	Результат.Добавить(Перечисления.ВидыКБК.КДБ);
	Результат.Добавить(Перечисления.ВидыКБК.КИФ);
	Результат.Добавить(Перечисления.ВидыКБК.КРБ);
	Результат.Добавить(Перечисления.ВидыКБК.АУИБУ);
	Результат.Добавить(Перечисления.ВидыКБК.Произвольный);
	
	Возврат Результат;

КонецФункции

// Определяет параметры признания доходов, расходов способом "По месяцам" для конкретного периода,
// в течение которого стоимость включается в доходы, расходы.
// Детально порядок расчета описан в комментариях в коде функции.
//
// Параметры:
//  НачалоПериода	 - Дата - начало периода, в течение которого стоимость должна быть включена в доходы, расходы
//  КонецПериода	 - Дата - конец периода, в течение которого стоимость должна быть включена в доходы, расходы
// Возвращаемое значение:
//  Структура - описывает порядок признания доходов, расходов в течение периода (профиль во времени)
//    * ВсегоКоличествоМесяцев - Число - количество месяцев в периоде, в виде десятичной дроби
//    * ЦелоеКоличествоМесяцев - Число - количество целых календарных месяцев в рамках периода, меньше или равно ВсегоКоличествоМесяцев
//    * НачалоПериодаЦелыхМесяцев - Дата - начало периода целых календарных месяцев в рамках периода
//    * КонецПериодаЦелыхМесяцев - Дата - конец периода целых календарных месяцев в рамках периода
//    * НецелыеМесяцы - ТаблицаЗначений - информация о нецелых календарных месяцах в рамках периода; 
//              каждая строка таблицы соответствует месяцу; может быть до двух нецелых месяцев - первый и последний
//       ** Месяц       - Дата  - начало нецелого месяца
//       ** Числитель   - Число - количество дней признания доходов, расходов в месяце
//       ** Знаменатель - Число - количество дней в месяце
//       ** Вес         - Число - вес месяца относительно целого календарного месяца, меньше 1
Функция ПараметрыПризнанияДоходовРасходовПоМесяцам(Знач НачалоПериода, Знач КонецПериода)
	
	Расчет = Новый Структура;
	Расчет.Вставить("ВсегоКоличествоМесяцев",    0);
	
	Расчет.Вставить("ЦелоеКоличествоМесяцев",    0);
	Расчет.Вставить("НачалоПериодаЦелыхМесяцев", '0001-01-01');
	Расчет.Вставить("КонецПериодаЦелыхМесяцев",  '0001-01-01');
	
	Расчет.Вставить("НецелыеМесяцы", Новый ТаблицаЗначений);
	Расчет.НецелыеМесяцы.Колонки.Добавить("Месяц",       ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	Расчет.НецелыеМесяцы.Колонки.Добавить("Числитель",   Новый ОписаниеТипов("Число"));
	Расчет.НецелыеМесяцы.Колонки.Добавить("Знаменатель", Новый ОписаниеТипов("Число"));
	Расчет.НецелыеМесяцы.Колонки.Добавить("Вес",         Новый ОписаниеТипов("Число"));
	
	НачалоПериода = НачалоДня(НачалоПериода);
	КонецПериода  = КонецДня(КонецПериода);
	
	Если Не ЗначениеЗаполнено(НачалоПериода) Или Не ЗначениеЗаполнено(КонецПериода) Или НачалоПериода > КонецПериода Тогда
		Возврат Расчет;
	КонецЕсли;
	
	// В общем виде формула выглядит так:
	//
	// ВсегоКоличествоМесяцев = ВесПервогоМесяца + СуммаВесовЦелыхКалендарныхМесяцев + ВесПоследнегоМесяца, 
	// где
	//   ВесПервогоМесяца    = КоличествоДнейДействияВПервомМесяце    / КоличествоДнейПервогоМесяца;
	//   ВесПоследнегоМесяца = КоличествоДнейДействияВПоследнемМесяце / КоличествоДнейПоследнегоМесяца;
	//
	// Отдельные слагаемые могут отсутствовать.
	// Так, если период начинается в первый день месяца и заканчивается в последний день месяца (другими словами, первый и последний месяцы периода - полные),
	// то ВсегоКоличествоМесяцев = СуммаВесовЦелыхКалендарныхМесяцев.
	// СуммаВесовЦелыхКалендарныхМесяцев - натуральное число, включая 0.
	
	ПервыйМесяцПолный    = (НачалоМесяца(НачалоПериода) = НачалоПериода);
	ПоследнийМесяцПолный = (КонецМесяца(КонецПериода) = КонецПериода);
	
	Расчет.НачалоПериодаЦелыхМесяцев = ?(ПервыйМесяцПолный,    НачалоПериода, КонецМесяца(НачалоПериода) + 1);
	Расчет.КонецПериодаЦелыхМесяцев  = ?(ПоследнийМесяцПолный, КонецПериода,  НачалоМесяца(КонецПериода) - 1);
	
	// Часть срока, которая может быть выражена в календарных месяцах (целом числе месяцев)
	Если Расчет.НачалоПериодаЦелыхМесяцев < Расчет.КонецПериодаЦелыхМесяцев Тогда
		Расчет.ЦелоеКоличествоМесяцев    = (Год(Расчет.КонецПериодаЦелыхМесяцев) - Год(Расчет.НачалоПериодаЦелыхМесяцев)) * 12 
			+ Месяц(Расчет.КонецПериодаЦелыхМесяцев) - Месяц(Расчет.НачалоПериодаЦелыхМесяцев) + 1;
		Расчет.ВсегоКоличествоМесяцев    = Расчет.ЦелоеКоличествоМесяцев;
	КонецЕсли;
	
	Если ПервыйМесяцПолный И ПоследнийМесяцПолный Тогда
		Возврат Расчет;
	КонецЕсли;
	
	// Часть (части) периода, которые приходятся на неполные месяцы
	//
	// Не учитываем, что период может быть выражен целым числом месяцев.
	// Например, с 15 января по 14 февраля - это 1 месяц, но для расчета принимаем длину этого периода как 17/31 + 14/28 ~ 1.048 месяца.
	
	Если Не ПервыйМесяцПолный И Не ПоследнийМесяцПолный И НачалоМесяца(НачалоПериода) = НачалоМесяца(КонецПериода) Тогда
		
		// вырожденный случай: период начинается после начала месяца и заканчивается до его окончания
		ОписаниеМесяца = Расчет.НецелыеМесяцы.Добавить();
		ОписаниеМесяца.Месяц = НачалоМесяца(НачалоПериода);
		ОписаниеМесяца.Числитель   = День(КонецПериода) - День(НачалоПериода) + 1;
		ОписаниеМесяца.Знаменатель = ОписаниеМесяца.Числитель;
		
	Иначе
	
		Если Не ПервыйМесяцПолный Тогда
			ОписаниеМесяца = Расчет.НецелыеМесяцы.Добавить();
			ОписаниеМесяца.Месяц = НачалоМесяца(НачалоПериода);
			ОписаниеМесяца.Числитель   = День(КонецМесяца(НачалоПериода)) - День(НачалоПериода) + 1;
			ОписаниеМесяца.Знаменатель = День(КонецМесяца(НачалоПериода));
		КонецЕсли;
		
		Если Не ПоследнийМесяцПолный Тогда
			ОписаниеМесяца = Расчет.НецелыеМесяцы.Добавить();
			ОписаниеМесяца.Месяц = НачалоМесяца(КонецПериода);
			ОписаниеМесяца.Числитель   = День(КонецПериода);
			ОписаниеМесяца.Знаменатель = День(КонецМесяца(КонецПериода));
		КонецЕсли;
	
	КонецЕсли;

	Для Каждого ОписаниеМесяца Из Расчет.НецелыеМесяцы Цикл
		ОписаниеМесяца.Вес = ОписаниеМесяца.Числитель / ОписаниеМесяца.Знаменатель;
		Расчет.ВсегоКоличествоМесяцев = Расчет.ВсегоКоличествоМесяцев + ОписаниеМесяца.Вес;
	КонецЦикла;
	
	Возврат Расчет;
	
КонецФункции

Процедура ПодставитьСчетВПроводку(Проводка, ДтКт, СвойстваСчета, ПричинаОшибки)
	
	Проводка["Счет" + ДтКт] = СвойстваСчета.Ссылка;
	ЗаполнитьСубконто(Проводка, ДтКт, СвойстваСчета, ПричинаОшибки);
	
	Проводка.ЖурналОпераций = СвойстваСчета.НомерЖурнала;
	
	Если Не СвойстваСчета.Количественный Тогда
		Проводка["Количество" + ДтКт] = Null;
	КонецЕсли;
	
	Если Не СвойстваСчета.Валютный Тогда
		Проводка["Валюта" + ДтКт]  = Null;
		Проводка["ВалютнаяСумма" + ДтКт] = Null;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПодставитьСчетВПроводкуЗабаланс(Проводка, ДтКт, ПорядокИсправленияОшибок, ВыявительОшибки)
	
	Проводка["Счет" + ДтКт] = ПланыСчетов.ЕПСБУ.ИсправлениеОшибокЗабаланс;
	
	Проводка["ВидСубконто" + ДтКт + "1"] = ПланыВидовХарактеристик.ВидыСубконто.ИсточникИнформацииОбОшибке;
	Проводка["ВидСубконто" + ДтКт + "2"] = ПланыВидовХарактеристик.ВидыСубконто.ПериодВозникновенияОшибки;
	
	Проводка["Субконто" + ДтКт + "1"] = ВыявительОшибки;
	Проводка["Субконто" + ДтКт + "2"] = ПорядокИсправленияОшибок;
	
	Проводка["Количество"		+ ДтКт]			= Null;
	Проводка["Валюта"			+ ДтКт]			= Null;
	Проводка["ВалютнаяСумма"	+ ДтКт]			= Null;
	Проводка["ВидСубконто"		+ ДтКт + "3"]	= ПланыВидовХарактеристик.ВидыСубконто.ПустаяСсылка();
	Проводка["Субконто"			+ ДтКт + "3"]	= Null;
	
КонецПроцедуры

Процедура ЗаполнитьСубконто(Проводка, ДтКт, СвойстваСчета, ПричинаОшибки)
	
	МаксКоличествоСубконто = БухгалтерскийУчетПовтИсп.ПолучитьМаксКоличествоСубконто();
	
	ЗначенияСубконто = Новый Соответствие;
	Для Сч = 1 По МаксКоличествоСубконто Цикл
		ВидСубконто		 = Проводка["ВидСубконто" + ДтКт + Сч];
		ЗначениеСубконто = Проводка["Субконто" + ДтКт + Сч];
		ЗначенияСубконто.Вставить(ВидСубконто, ЗначениеСубконто);
	КонецЦикла;
	
	ЗначенияСубконто.Вставить(ПланыВидовХарактеристик.ВидыСубконто.ПричиныОшибокПрошлыхЛет, ПричинаОшибки);
	
	Для Сч = 1 По МаксКоличествоСубконто Цикл
		ВидСубконто = СвойстваСчета["ВидСубконто" + Сч];
		Если ВидСубконто = Неопределено Тогда
			Проводка["ВидСубконто" + ДтКт + Сч] = ПланыВидовХарактеристик.ВидыСубконто.ПустаяСсылка();
			Проводка["Субконто"    + ДтКт + Сч] = Неопределено;
		Иначе
			Проводка["ВидСубконто" + ДтКт + Сч] = ВидСубконто;
			Проводка["Субконто"    + ДтКт + Сч] = ЗначенияСубконто[ВидСубконто];
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция КодСтатьиОрганизации(Организация, Дата)
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат "0";
	КонецЕсли;
	
	ТипПланаСчетов = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Организация, Дата).СтруктураРПС.ТипПланаСчетов;
	
	Если Не ЗначениеЗаполнено(ТипПланаСчетов) Тогда
		КодСтатьи = "0";
	ИначеЕсли ТипПланаСчетов = ПредопределенноеЗначение("Перечисление.ТипыПлановСчетов.ДляКазенных") Тогда
		КодСтатьи = "1";
	Иначе
		КодСтатьи = "2";
	КонецЕсли;
	
	Возврат КодСтатьи;
	
КонецФункции

Функция ЗначениеСубконтоПроводкиПоТипу(Проводка, ТипСубконто)
	
	Если ТипЗнч(Проводка.Субконто1) = ТипСубконто Тогда
		Значение = Проводка.Субконто1;
	ИначеЕсли ТипЗнч(Проводка.Субконто2) = ТипСубконто Тогда
		Значение = Проводка.Субконто2;
	ИначеЕсли ТипЗнч(Проводка.Субконто3) = ТипСубконто Тогда
		Значение = Проводка.Субконто3;
	Иначе
		Значение = Неопределено;
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

Функция ПризнакиУчетаСчета(Счет)

	Если ЗначениеЗаполнено(Счет) Тогда
		СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Счет);
	Иначе
		СвойстваСчета = Новый Структура("УчетПоКПС, УчетПоКЭК, УчетПоПодразделениям, Валютный, Количественный",
			Ложь, Ложь, Ложь, Ложь, Ложь);
	КонецЕсли;
		
	Возврат СвойстваСчета;

КонецФункции

#КонецОбласти
