Функция КЭКДляЗамены340_440()
	КЭК340 = БухгалтерскийУчетПовтИсп.КЭКПоКоду("340");
	КЭК440 = БухгалтерскийУчетПовтИсп.КЭКПоКоду("440");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОСГУ.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КОСГУ КАК КОСГУ
	|ГДЕ
	|	КОСГУ.Ссылка В ИЕРАРХИИ(&КЭК340)
	|	И КОСГУ.Ссылка <> &КЭК340
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОСГУ.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.КОСГУ КАК КОСГУ
	|ГДЕ
	|	КОСГУ.Ссылка В ИЕРАРХИИ(&КЭК440)
	|	И КОСГУ.Ссылка <> &КЭК440";
	Запрос.УстановитьПараметр("КЭК340", КЭК340);
	Запрос.УстановитьПараметр("КЭК440", КЭК440);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Детальные340 = Новый Соответствие;
	Выборка340 = РезультатЗапроса[0].Выбрать();
	Пока Выборка340.Следующий() Цикл
		Детальные340.Вставить(Выборка340.Ссылка, Истина);
	КонецЦикла;
	
	Детальные440 = Новый Соответствие;
	Выборка440 = РезультатЗапроса[1].Выбрать();
	Пока Выборка440.Следующий() Цикл
		Детальные440.Вставить(Выборка440.Ссылка, Истина);
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("Групповой340", КЭК340);
	Результат.Вставить("Групповой440", КЭК440);
	Результат.Вставить("Детальные340", Детальные340);
	Результат.Вставить("Детальные440", Детальные440);
	
	Возврат Результат;
	
КонецФункции

Функция КЭКДетальныйНоменклатурыПоСчетуИК(Счет, Дата, Организация, ДтКт)
	Если Счет = СчетПоКоду("108.57", Дата, Организация) Тогда
		Если ДтКт = "Дт" Тогда
			Возврат БухгалтерскийУчетПовтИсп.КЭКПоКоду("349");
		Иначе
			Возврат БухгалтерскийУчетПовтИсп.КЭКПоКоду("449");
		КонецЕсли;
	ИначеЕсли СчетВИерархии(Счет, "108.00") Тогда
		Если ДтКт = "Дт" Тогда
			Возврат БухгалтерскийУчетПовтИсп.КЭКПоКоду("346");
		Иначе
			Возврат БухгалтерскийУчетПовтИсп.КЭКПоКоду("446");
		КонецЕсли;
	Иначе
		Возврат Справочники.КОСГУ.ПустаяСсылка();
	КонецЕсли;
