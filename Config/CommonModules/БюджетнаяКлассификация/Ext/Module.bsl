	ИначеЕсли ТипОбъекта = Тип("СправочникОбъект.СтатьиКИФ") Тогда
		
		БюджетнаяКлассификацияСобытия.УправлениеПериодомДействияПодчиненныхЭлементовЯвно(ЭлементОбъект,Отказ,Ложь,ТаблицаОшибок,СоответствиеЭталоновДанных,СоответствиеАктуализации,НужноЗаполнятьТаблицуАктуализации); 
		
	// Целевые статьи КРБ		
	ИначеЕсли ТипОбъекта = Тип("СправочникОбъект.ПрограммыЦелевыхСтатейКРБ") Тогда
		
		БюджетнаяКлассификацияСобытия.УправлениеПериодомДействияПодчиненныхЭлементовЯвно(ЭлементОбъект,Отказ,Ложь,ТаблицаОшибок,СоответствиеЭталоновДанных,СоответствиеАктуализации,НужноЗаполнятьТаблицуАктуализации);  
		
	ИначеЕсли ТипОбъекта = Тип("СправочникОбъект.ЦелевыеСтатьиКРБ") Тогда
		
		БюджетнаяКлассификацияСобытия.ПриЗаписиЦелевыхСтатейКРБ(ЭлементОбъект,Отказ,Ложь,ТаблицаОшибок,СоответствиеЭталоновДанных,СоответствиеАктуализации,НужноЗаполнятьТаблицуАктуализации);
		
		БюджетнаяКлассификацияСобытия.ОпределитьПодчиненныеЭлементыДляАвтоиерархииЯвно(ЭлементОбъект,Отказ,Ложь,ТаблицаОшибок,СоответствиеЭталоновДанных,СоответствиеАктуализации,НужноЗаполнятьТаблицуАктуализации);  
		БюджетнаяКлассификацияСобытия.УправлениеПериодомДействияПодчиненныхЭлементовЯвно(ЭлементОбъект,Отказ,Ложь,ТаблицаОшибок,СоответствиеЭталоновДанных,СоответствиеАктуализации,НужноЗаполнятьТаблицуАктуализации); 
		
	// КДБ
	ИначеЕсли ТипОбъекта = Тип("СправочникОбъект.ВидыДоходовКДБ") Тогда	
		
		БюджетнаяКлассификацияСобытия.ПриЗаписиВидыДоходовКДБ(ЭлементОбъект,Отказ,Ложь,ТаблицаОшибок,СоответствиеЭталоновДанных,СоответствиеАктуализации,НужноЗаполнятьТаблицуАктуализации);
		
		БюджетнаяКлассификацияСобытия.УправлениеПериодомДействияПодчиненныхЭлементовЯвно(ЭлементОбъект,Отказ,Ложь,ТаблицаОшибок,СоответствиеЭталоновДанных,СоответствиеАктуализации,НужноЗаполнятьТаблицуАктуализации); 
		
	КонецЕсли;
	
	БюджетнаяКлассификацияПереопределяемый.ВыполнитьПроцедурыПриЗаписиПослеОсновныхОбработчиков(ЭлементОбъект,ТаблицаОшибок,СоответствиеЭталоновДанных,СоответствиеАктуализации,НужноЗаполнятьТаблицуАктуализации);
	
	КонечноеКоличествоОшибок = ТаблицаОшибок.НайтиСтроки(Новый Структура("КатегорияОшибки",0)).Количество();	
	
	Возврат Отказ ИЛИ КонечноеКоличествоОшибок<>КоличествоОшибок;
	
КонецФункции

// Процедура откатывает все изменения по сохраненной структуре данных для ссылок элементов справочников-классификаторов,
// при этом запись выполняется в режиме ОбменДанными.Загрузка = Истина и никакие подписки не вызываются
//
Процедура ОткатитьИзмененияПоСоответствиюЭталонныхДанных(СоответствиеЭталоновДанных) Экспорт
	
	Для Каждого КлючИЗначение Из СоответствиеЭталоновДанных Цикл
		
		ТекОбъект = КлючИЗначение.Ключ.ПолучитьОбъект();	
		ЗаполнитьЭлементПоКопии(ТекОбъект, КлючИЗначение.Значение);		
		ТекОбъект.ОбменДанными.Загрузка = Истина;
		ТекОбъект.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьЭлементПоКопии(ЭлементОбъект,КопияВСтруктуре)
	
	ЗаполнитьЗначенияСвойств(ЭлементОбъект,КопияВСтруктуре.Реквизиты);
	
	Для Каждого КлючИЗначение Из КопияВСтруктуре.ТЧ Цикл
		ЭлементОбъект[КлючИЗначение.Ключ].Загрузить(КлючИЗначение.Значение);			
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьКопиюЭлементаВСтруктуре(ЭлементОбъект) Экспорт
	
	ТипОбъекта = ТипЗнч(ЭлементОбъект);
	
	Если ТипОбъекта = Тип("СправочникОбъект.ВидыРасходовКРБ") Тогда
		Реквизиты = "НаименованиеПолное,ДатаНачалаДействия,ДатаОкончанияДействия,ОкончаниеДействия,Бюджет,Код,Родитель,ПометкаУдаления";
		ТабличныеЧасти = Новый Массив;
	ИначеЕсли ТипОбъекта = Тип("СправочникОбъект.ГлавыПоБюджетнойКлассификации") Тогда
		Реквизиты = "НаименованиеПолное,ДатаНачалаДействия,ДатаОкончанияДействия,ОкончаниеДействия,Бюджет,Код,ПометкаУдаления";
		ТабличныеЧасти = Новый Массив;
	ИначеЕсли ТипОбъекта = Тип("СправочникОбъект.КОСГУ") Тогда
		Реквизиты = "НаименованиеПолное,Код,Родитель,ПометкаУдаления";
		ТабличныеЧасти = Новый Массив;	
	ИначеЕсли ТипОбъекта = Тип("СправочникОбъект.АналитическиеКодыКПС") Тогда
		Реквизиты = "НаименованиеПолное,Код,Родитель,ПометкаУдаления";
		ТабличныеЧасти = Новый Массив;		
	ИначеЕсли ТипОбъекта = Тип("СправочникОбъект.РазделыПодразделыКРБ") Тогда					
		Реквизиты = "НаименованиеПолное,ЭлементГруппа,Код,Родитель,ПометкаУдаления";
		ТабличныеЧасти = Новый Массив;
	// КИФ	
	ИначеЕсли ТипОбъекта = Тип("СправочникОбъект.ВидыКИФ") Тогда
		Реквизиты = "НаименованиеПолное,Бюджет,Код,Наименование,Владелец,ПометкаУдаления";
		ТабличныеЧасти = Новый Массив;		
	ИначеЕсли ТипОбъекта = Тип("СправочникОбъект.ГруппыПодгруппыКИФ") Тогда
		Реквизиты = "НаименованиеПолное,Элемент,ЭлементГруппа,Код,Наименование,Родитель,ПометкаУдаления";
		ТабличныеЧасти = Новый Массив;
		ТабличныеЧасти.Добавить("ДопустимыеКОСГУ");		
	ИначеЕсли ТипОбъекта = Тип("СправочникОбъект.СтатьиКИФ") Тогда		
		Реквизиты = "НаименованиеПолное,Элемент,ДатаНачалаДействия,ДатаОкончанияДействия,ОкончаниеДействия,ЭлементГруппа,Код,Наименование,Родитель,Владелец,ПометкаУдаления";
		ТабличныеЧасти = Новый Массив;
		ТабличныеЧасти.Добавить("ДопустимыеКОСГУ");
	// Целевые статьи КРБ	
	ИначеЕсли ТипОбъекта = Тип("СправочникОбъект.ПрограммыЦелевыхСтатейКРБ") Тогда
		Реквизиты = "НаименованиеПолное,ДатаНачалаДействия,ДатаОкончанияДействия,ОкончаниеДействия,ЦелеваяСтатья,Бюджет,Код,Наименование,ПометкаУдаления";
		ТабличныеЧасти = Новый Массив;			
	ИначеЕсли ТипОбъекта = Тип("СправочникОбъект.ЦелевыеСтатьиКРБ") Тогда
		Реквизиты = "НаименованиеПолное,ДатаНачалаДействия,ДатаОкончанияДействия,ОкончаниеДействия,Бюджет,Код,Наименование,Родитель,ПометкаУдаления";
		ТабличныеЧасти = Новый Массив;
	// КДБ	
	ИначеЕсли ТипОбъекта = Тип("СправочникОбъект.ВидыДоходовКДБ") Тогда
		Реквизиты = "НаименованиеПолное,ДатаНачалаДействия,ДатаОкончанияДействия,ОкончаниеДействия,Код,Наименование,Родитель,ПометкаУдаления";
		ТабличныеЧасти = Новый Массив;
		ТабличныеЧасти.Добавить("АналитическиеГруппы");
	ИначеЕсли ТипОбъекта = Тип("СправочникОбъект.ГруппыПодвидовКДБ") Тогда
		Реквизиты = "НаименованиеПолное,Код,Наименование,ВидДохода,Бюджет,ПометкаУдаления";
		ТабличныеЧасти = Новый Массив;
	КонецЕсли;
	
	КопияВСтруктуре = Новый Структура("Реквизиты,ТЧ");
	КопияВСтруктуре.Реквизиты = Новый Структура(Реквизиты);
	ЗаполнитьЗначенияСвойств(КопияВСтруктуре.Реквизиты,ЭлементОбъект);
	СтруктураТЧ = Новый Структура;
	Для Каждого ЭлМас Из ТабличныеЧасти Цикл
		СтруктураТЧ.Вставить(ЭлМас,ЭлементОбъект[ЭлМас].Выгрузить());				
	КонецЦикла;
	КопияВСтруктуре.ТЧ = СтруктураТЧ;
	
	Возврат КопияВСтруктуре;
	
КонецФункции

#КонецОбласти

#Область ПроцедурыРаботыСоСтруктуройКлассификаторов

Функция ПолучитьСтруктуруКодаКлассификатора(Знач ИмяМетаданных) Экспорт
	
	ИмяМакета = "СтруктураКода";
	
	МетаданныеСправочника = Метаданные.НайтиПоПолномуИмени(ИмяМетаданных);
	
	Если МетаданныеСправочника = Неопределено Тогда
		ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Объект метаданных %1 не найден.'"),
		ИмяМетаданных);
	КонецЕсли;
	
	Если МетаданныеСправочника.Макеты.Найти(ИмяМакета) = Неопределено Тогда
		ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'У справочника «%1» отсутствует информация о структуре кода.'"),
		МетаданныеСправочника.Представление());
	КонецЕсли;
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(Справочники[МетаданныеСправочника.Имя].ПолучитьМакет(ИмяМакета).ПолучитьТекст());
	Возврат СериализаторXDTO.ПрочитатьXML(ЧтениеXML);
	
КонецФункции

Функция ПолучитьТаблицуПриказовОБК() Экспорт
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПриказыОБК.Ссылка,
	|	ПриказыОБК.Наименование,
	|	ПриказыОБК.НаименованиеПолное,
	|	ПриказыОБК.ДатаНачала
	|ПОМЕСТИТЬ ПриказыОБК
	|ИЗ
	|	Справочник.ПриказыОБК КАК ПриказыОБК
	|ГДЕ
	|	ПриказыОБК.ПометкаУдаления = ЛОЖЬ
	|   И НЕ ПриказыОБК.ДатаНачала < ДАТАВРЕМЯ(2016, 1, 1) 
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПриказыОБК.Ссылка,
	|	ПриказыОБК.Наименование,
	|	ПриказыОБК.НаименованиеПолное,
	|	ПриказыОБК.ДатаНачала КАК ДатаНачала,
	|	ЕСТЬNULL(МИНИМУМ(ДОБАВИТЬКДАТЕ(ПриказыОБК1.ДатаНачала, ДЕНЬ, -1)), ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаОкончания,
	|	ВЫБОР
	|		КОГДА ПриказыОБК.Ссылка = Константы.ПриказОБК
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоРабочийПриказ
	|ИЗ
	|	(ВЫБРАТЬ
	|		ЗНАЧЕНИЕ(Справочник.ПриказыОБК.ПустаяСсылка) КАК Ссылка,
	|		"""" КАК Наименование,
	|		"""" КАК НаименованиеПолное,
	|		ДАТАВРЕМЯ(1, 1, 1) КАК ДатаНачала
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ПриказыОБК.Ссылка,
	|		ПриказыОБК.Наименование,
	|		ПриказыОБК.НаименованиеПолное,
	|		ПриказыОБК.ДатаНачала
	|	ИЗ
	|		ПриказыОБК КАК ПриказыОБК) КАК ПриказыОБК
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПриказыОБК КАК ПриказыОБК1
	|		ПО ПриказыОБК.ДатаНачала < ПриказыОБК1.ДатаНачала
	|		ЛЕВОЕ СОЕДИНЕНИЕ Константы КАК Константы
	|		ПО (Константы.ПриказОБК = ПриказыОБК.Ссылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	ПриказыОБК.ДатаНачала,
	|	ПриказыОБК.Ссылка,
	|	ПриказыОБК.Наименование,
	|	ВЫБОР
	|		КОГДА ПриказыОБК.Ссылка = Константы.ПриказОБК
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ,
	|	ПриказыОБК.НаименованиеПолное
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаНачала УБЫВ");
	
	ТаблицаПриказов = Запрос.Выполнить().Выгрузить();
	
	// Если в таблице только запись с пустыми датами, очищаем.
	Если ТаблицаПриказов.Количество() = 1 Тогда
		ТаблицаПриказов.Очистить();
	КонецЕсли;
	
	ТаблицаПриказов.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(120)));
	Для каждого СтрокаТаблицыПриказов Из ТаблицаПриказов Цикл
		
		ПредставлениеСрокаДействия = 
		?(ЗначениеЗаполнено(СтрокаТаблицыПриказов.ДатаНачала),
		Формат(СтрокаТаблицыПриказов.ДатаНачала, "ДФ=dd.MM.yyyy"),
		"...")
		+ " - "
		+ ?(ЗначениеЗаполнено(СтрокаТаблицыПриказов.ДатаОкончания),
		Формат(СтрокаТаблицыПриказов.ДатаОкончания, "ДФ=dd.MM.yyyy"),
		"...");
		
		Если ЗначениеЗаполнено(СтрокаТаблицыПриказов.Ссылка) Тогда
			ПредставлениеПриказа = ПредставлениеСрокаДействия + " "
			+ "(" + СтрокаТаблицыПриказов.Наименование + ")";
		Иначе
			ПредставлениеПриказа = ПредставлениеСрокаДействия;
		КонецЕсли;
		
		СтрокаТаблицыПриказов.Представление = ПредставлениеПриказа;
		
	КонецЦикла;
	
	Возврат ТаблицаПриказов;
	
КонецФункции

Функция ПолучитьТаблицуМанифестовОбновлений() Экспорт
	
	Результат = Новый ТаблицаЗначений;
