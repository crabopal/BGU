#Область СлужебныеПроцедурыИФункции

Процедура ОбъединитьОсновнойИДополнительныйОтбор(Знач СтруктураОсновнойОтбор, Знач СтруктураДополнительныйОтбор, Знач ИмяОтбора)
	
	Перем СписокРезультат;
	
	ТекущееЗначение    = СтруктураОсновнойОтбор[ИмяОтбора];
	ЗначениеДополнения = СтруктураДополнительныйОтбор[ИмяОтбора];
	
	Если ЭтоОдиночноеЗначение(ТекущееЗначение) Тогда
		
		Если ЭтоОдиночноеЗначение(ЗначениеДополнения) Тогда
			СписокРезультат = Новый СписокЗначений;
			СписокРезультат.Добавить(ТекущееЗначение);
			СписокРезультат.Добавить(ЗначениеДополнения);
		Иначе
			СписокРезультат = ПолучитьСписокЗначенийИзКоллекции(ЗначениеДополнения);
			СписокРезультат.Вставить(0,ТекущееЗначение);
		КонецЕсли;
		
	Иначе
		СписокРезультат = ПолучитьСписокЗначенийИзКоллекции(ТекущееЗначение);
		
		Если ЭтоОдиночноеЗначение(ЗначениеДополнения) Тогда
			СписокРезультат.Добавить(ЗначениеДополнения);
		Иначе
			Для Каждого Элемент Из ЗначениеДополнения Цикл
				Если ТипЗнч(ЗначениеДополнения) = Тип("СписокЗначений") Тогда
					СписокРезультат.Добавить(Элемент.Значение);
				Иначе
					СписокРезультат.Добавить(Элемент);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
	СтруктураОсновнойОтбор.Вставить(ИмяОтбора, СписокРезультат);
	
КонецПроцедуры

Функция ЭтоОдиночноеЗначение(Знач Значение)
	
	Возврат Не (ТипЗнч(Значение) = Тип("Массив")
	Или ТипЗнч(Значение) = Тип("ФиксированныйМассив")
	Или ТипЗнч(Значение) = Тип("СписокЗначений"));
	
КонецФункции

Функция ПолучитьСписокЗначенийИзКоллекции(Знач ИсходнаяКоллекция)
	
	Если ТипЗнч(ИсходнаяКоллекция) = Тип("СписокЗначений") Тогда
		Возврат ОбщегоНазначения.СкопироватьРекурсивно(ИсходнаяКоллекция);
	Иначе
		Результат = Новый СписокЗначений;
		Для Каждого Элемент Из ИсходнаяКоллекция Цикл
			Результат.Добавить(Элемент);
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;
	
КонецФункции

