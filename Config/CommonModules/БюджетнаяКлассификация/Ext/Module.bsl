
////////////////////////////////////////////////////////////////////////////////
// БЮДЖЕТНАЯ КЛАССИФИКАЦИЯ
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Функция ищет ссылки на компоненты КБК по полному коду КБК.
//
// Параметры:
//  КодБК        - Строка - код бюджетной классификации (17 знаков).
//  ВидКБК       - Строка, ПеречислениеСсылка.ВидыКБК - гКБК, КРБ, КДБ, КИФ;
//                 вид КБК, чей код передан.
//  Бюджет       - СправочникСсылка.Бюджеты - бюджет, для которого ищутся
//                 коды бюджетных классификаторов.
//  Дата         - Дата - дата на которую действует передаваемый КБК.
//  Результат    - ФиксированнаяСтруктура, вых. - структура с найденными
//                 компонентами. Имена свойств соответствуют именам реквизитов
//                 справочника КБК. Состав свойств зависит от вида КБК.
//
// Возвращаемое значение:
//  Булево. Истина, если комплект кодов найден. Ложь, если хотя бы один
//  код не был найден. Параметр Результат устанавливается в любом случае,
//  ненайденные компоненты будут иметь значение Неопределено.
//
Функция НайтиКомпонентыКБК(Знач КодБК, Знач ВидКБК, Знач Бюджет = Неопределено, Знач ДатаЗначения, Результат, Знач ВидКПСАУБУ = Неопределено) Экспорт
	
	Если СтрДлина(КодБК) <> 17 И СтрДлина(КодБК) <> 20 Тогда
		ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Неверное значение параметра КодБК (%1).'"),
		КодБК);
	КонецЕсли;
	
	Если ТипЗнч(ДатаЗначения) <> Тип("Дата") ИЛИ НЕ ЗначениеЗаполнено(ДатаЗначения) Тогда
		ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Неверное значение параметра Дата (%1).'"),
		ДатаЗначения);
	КонецЕсли;
	
	Если ТипЗнч(ВидКБК) = Тип("Строка") Тогда
		Если ВидКБК = "гКБК" Тогда
			ВидКБК = Перечисления.ВидыКБК.гКБК;
		ИначеЕсли ВидКБК = "КДБ" Тогда
			ВидКБК = Перечисления.ВидыКБК.КДБ;
		ИначеЕсли ВидКБК = "КРБ" Тогда
			ВидКБК = Перечисления.ВидыКБК.КРБ;
		ИначеЕсли ВидКБК = "КИФ" Тогда
			ВидКБК = Перечисления.ВидыКБК.КИФ;
		ИначеЕсли ВидКБК = "АУИБУ" Тогда
			ВидКБК = Перечисления.ВидыКБК.АУИБУ;
		КонецЕсли;
	КонецЕсли;	
	
	Если НЕ ТипЗнч(ВидКБК) = Тип("ПеречислениеСсылка.ВидыКБК") Тогда 
		ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Неверное значение параметра ВидКБК (%1).'"),
		ВидКБК);
	КонецЕсли;
	
	ДопустимыеАналитическиеГруппыКИФ = БюджетнаяКлассификацияКлиентСервер.АналитическиеКодыИсточников(Истина);
	ДопустимыеАналитическиеГруппыКДБ = БюджетнаяКлассификацияКлиентСервер.АналитическиеКодыДоходов(Истина);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата",    ДатаЗначения);
	
	Если ВидКБК = Перечисления.ВидыКБК.гКБК Тогда
		
		Структура = Новый Структура("Код", КодБК); 
		
	ИначеЕсли ВидКБК = Перечисления.ВидыКБК.КДБ Тогда
		
		Если Найти(ДопустимыеАналитическиеГруппыКДБ, Сред(КодБК, 15, 3)) = Неопределено Тогда 
			ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Недопустимый код аналитической группы КДБ: (%1).'"), Прав(КодБК, 3));
		КонецЕсли;
		
		Структура = Новый Структура("ВидДоходаКДБ, ГруппаПодвидаКДБ, АналитическаяГруппаКДБ");
		
		Запрос.УстановитьПараметр("ВидДоходаКДБКод",  			Лев(КодБК, 10));
		Запрос.УстановитьПараметр("ГруппаПодвидаКДБКод", 		Сред(КодБК, 11, 4));
		Запрос.УстановитьПараметр("АналитическаяГруппаКДБКод", 	Сред(КодБК, 15, 3));
		
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка) КАК КОСГУ
		|ПОМЕСТИТЬ КОСГУПустаяСсылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ВЫБОР
		|		КОГДА &АналитическаяГруппаКДБКод = ""000""
		|			ТОГДА КОСГУПустаяСсылка.КОСГУ
		|		ИНАЧЕ ЕСТЬNULL(АналитическиеГруппыКДБ.Ссылка, НЕОПРЕДЕЛЕНО)
		|	КОНЕЦ КАК АналитическаяГруппаКДБ
		|ПОМЕСТИТЬ АналитическиеГруппыКДБ
		|ИЗ
		|	КОСГУПустаяСсылка КАК КОСГУПустаяСсылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КОСГУ КАК АналитическиеГруппыКДБ
		|		ПО (АналитическиеГруппыКДБ.ПометкаУдаления = ЛОЖЬ)
		|			И (АналитическиеГруппыКДБ.Код = &АналитическаяГруппаКДБКод)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ВЫБОР
		|		КОГДА &ВидДоходаКДБКод = ""0000000000""
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыДоходовКДБ.ПустаяСсылка)
		|		ИНАЧЕ ЕСТЬNULL(ВидыДоходовКДБ.Ссылка, НЕОПРЕДЕЛЕНО)
		|	КОНЕЦ КАК ВидДоходаКДБ,
		|	ЕСТЬNULL(АналитическиеГруппыКДБ.АналитическаяГруппаКДБ, НЕОПРЕДЕЛЕНО) КАК АналитическаяГруппаКДБ
		|ПОМЕСТИТЬ ВидыДоходаКДБ
		|ИЗ
		|	АналитическиеГруппыКДБ КАК АналитическиеГруппыКДБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыДоходовКДБ КАК ВидыДоходовКДБ
		|		ПО (ВидыДоходовКДБ.ПометкаУдаления = ЛОЖЬ)
		|			И (ВидыДоходовКДБ.Код = &ВидДоходаКДБКод)
		|			И (ВидыДоходовКДБ.ДатаНачалаДействия <= &Дата)
		|			И (ВидыДоходовКДБ.ДатаОкончанияДействия >= &Дата)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ВидыДоходаКДБ.АналитическаяГруппаКДБ КАК АналитическаяГруппаКДБ,
		|	ВидыДоходаКДБ.ВидДоходаКДБ КАК ВидДоходаКДБ,
		|	ВЫБОР
		|		КОГДА &ГруппаПодвидаКДБКод = ""0000""
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.ГруппыПодвидовКДБ.ПустаяСсылка)
		|		ИНАЧЕ ЕСТЬNULL(ГруппыПодвидовКДБ.Ссылка, НЕОПРЕДЕЛЕНО)
		|	КОНЕЦ КАК ГруппаПодвидаКДБ
		|ИЗ
		|	ВидыДоходаКДБ КАК ВидыДоходаКДБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГруппыПодвидовКДБ КАК ГруппыПодвидовКДБ
		|		ПО (ГруппыПодвидовКДБ.ВидДохода = ВидыДоходаКДБ.ВидДоходаКДБ
		|				ИЛИ ГруппыПодвидовКДБ.ВидДохода = ЗНАЧЕНИЕ(Справочник.ВидыДоходовКДБ.ПустаяСсылка))
		|			И (НЕ(ВидыДоходаКДБ.ВидДоходаКДБ = НЕОПРЕДЕЛЕНО
		|					ИЛИ ВидыДоходаКДБ.ВидДоходаКДБ = ЗНАЧЕНИЕ(Справочник.ВидыДоходовКДБ.ПустаяСсылка)))
		|			И (ГруппыПодвидовКДБ.ПометкаУдаления = ЛОЖЬ)
		|			И (ГруппыПодвидовКДБ.Код = &ГруппаПодвидаКДБКод)";
		
		Если НЕ Бюджет = Неопределено Тогда
			Запрос.Текст = Запрос.Текст + "	
			|	И (ГруппыПодвидовКДБ.Бюджет В (&Бюджеты))";
		КонецЕсли;
		
	ИначеЕсли ВидКБК = Перечисления.ВидыКБК.КРБ Тогда
		
		Структура = Новый Структура("РазделПодразделКРБ, ЦелеваяСтатьяКРБ, ПрограммаЦелевойСтатьиКРБ, ВидРасходаКРБ");
		
		Запрос.УстановитьПараметр("РазделПодразделКРБКод",  		Лев(КодБК, 4));
		Запрос.УстановитьПараметр("ЦелеваяСтатьяКРБКод", 			Сред(КодБК, 5, 5));
		Запрос.УстановитьПараметр("ПрограммаЦелевойСтатьиКРБКод", 	Сред(КодБК, 10, 5));
		Запрос.УстановитьПараметр("ВидРасходаКРБКод", 				Сред(КодБК, 15, 3));
		
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЗНАЧЕНИЕ(Справочник.РазделыПодразделыКРБ.ПустаяСсылка) КАК РазделПодразделКРБ
		|ПОМЕСТИТЬ РазделыПодразделыКРБПустаяСсылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ВЫБОР
		|		КОГДА &РазделПодразделКРБКод = ""0000""
		|			ТОГДА РазделыПодразделыКРБПустаяСсылка.РазделПодразделКРБ
		|		ИНАЧЕ ЕСТЬNULL(РазделыПодразделыКРБ.Ссылка, НЕОПРЕДЕЛЕНО)
		|	КОНЕЦ КАК РазделПодразделКРБ
		|ПОМЕСТИТЬ РазделыПодразделыКРБ
		|ИЗ
		|	РазделыПодразделыКРБПустаяСсылка КАК РазделыПодразделыКРБПустаяСсылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РазделыПодразделыКРБ КАК РазделыПодразделыКРБ
		|		ПО (РазделыПодразделыКРБ.ПометкаУдаления = ЛОЖЬ)
		|			И (РазделыПодразделыКРБ.Код = &РазделПодразделКРБКод)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ВЫБОР
		|		КОГДА &ВидРасходаКРБКод = ""000""
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыРасходовКРБ.ПустаяСсылка)
		|		ИНАЧЕ ЕСТЬNULL(ВидыРасходовКРБ.Ссылка, НЕОПРЕДЕЛЕНО)
		|	КОНЕЦ КАК ВидРасходаКРБ,
		|	ЕСТЬNULL(РазделыПодразделыКРБ.РазделПодразделКРБ, НЕОПРЕДЕЛЕНО) КАК РазделПодразделКРБ
		|ПОМЕСТИТЬ ВидыРасходаКРБ
		|ИЗ
		|	РазделыПодразделыКРБ КАК РазделыПодразделыКРБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыРасходовКРБ КАК ВидыРасходовКРБ
		|		ПО (ВидыРасходовКРБ.ПометкаУдаления = ЛОЖЬ)
		|			И (ВидыРасходовКРБ.Код = &ВидРасходаКРБКод)
		|			И (ВидыРасходовКРБ.ДатаНачалаДействия <= &Дата)
		|			И (ВидыРасходовКРБ.ДатаОкончанияДействия >= &Дата)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ВидыРасходаКРБ.РазделПодразделКРБ,
		|	ВидыРасходаКРБ.ВидРасходаКРБ,
		|	ВЫБОР
		|		КОГДА &ЦелеваяСтатьяКРБКод = ""00000""
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.ЦелевыеСтатьиКРБ.ПустаяСсылка)
		|		ИНАЧЕ ЕСТЬNULL(ЦелевыеСтатьиКРБ.Ссылка, НЕОПРЕДЕЛЕНО)
		|	КОНЕЦ КАК ЦелеваяСтатьяКРБ
		|ПОМЕСТИТЬ ЦелевыеСтатьи
		|ИЗ
		|	ВидыРасходаКРБ КАК ВидыРасходаКРБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЦелевыеСтатьиКРБ КАК ЦелевыеСтатьиКРБ
		|		ПО (ЦелевыеСтатьиКРБ.ПометкаУдаления = ЛОЖЬ)
		|			И (ЦелевыеСтатьиКРБ.Код = &ЦелеваяСтатьяКРБКод)
		|			И (ЦелевыеСтатьиКРБ.ДатаНачалаДействия <= &Дата)
		|			И (ЦелевыеСтатьиКРБ.ДатаОкончанияДействия >= &Дата)";
		
		Если НЕ Бюджет = Неопределено Тогда
			Запрос.Текст = Запрос.Текст + "	
			|	И (ЦелевыеСтатьиКРБ.Бюджет В (&Бюджеты))";
		КонецЕсли;
		
		Запрос.Текст = Запрос.Текст + "	
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЦелевыеСтатьи.РазделПодразделКРБ КАК РазделПодразделКРБ,
		|	ЦелевыеСтатьи.ВидРасходаКРБ КАК ВидРасходаКРБ,
		|	ЦелевыеСтатьи.ЦелеваяСтатьяКРБ КАК ЦелеваяСтатьяКРБ,
		|	ВЫБОР
		|		КОГДА &ПрограммаЦелевойСтатьиКРБКод = ""00000""
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.ПрограммыЦелевыхСтатейКРБ.ПустаяСсылка)
		|		ИНАЧЕ ЕСТЬNULL(ПрограммыЦелевыхСтатейКРБ.Ссылка, НЕОПРЕДЕЛЕНО)
		|	КОНЕЦ КАК ПрограммаЦелевойСтатьиКРБ
		|ИЗ
		|	ЦелевыеСтатьи КАК ЦелевыеСтатьи
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПрограммыЦелевыхСтатейКРБ КАК ПрограммыЦелевыхСтатейКРБ
		|		ПО (ПрограммыЦелевыхСтатейКРБ.ПометкаУдаления = ЛОЖЬ)
		|			И (ПрограммыЦелевыхСтатейКРБ.Код = &ПрограммаЦелевойСтатьиКРБКод)
		|			И (ПрограммыЦелевыхСтатейКРБ.ЦелеваяСтатья = ЗНАЧЕНИЕ(Справочник.ЦелевыеСтатьиКРБ.ПустаяСсылка)
		|				ИЛИ ПрограммыЦелевыхСтатейКРБ.ЦелеваяСтатья = ЦелевыеСтатьи.ЦелеваяСтатьяКРБ)
		|			И (НЕ(ЦелевыеСтатьи.ЦелеваяСтатьяКРБ = НЕОПРЕДЕЛЕНО
		|					ИЛИ ЦелевыеСтатьи.ЦелеваяСтатьяКРБ = ЗНАЧЕНИЕ(Справочник.ЦелевыеСтатьиКРБ.ПустаяСсылка)))
		|			И (ПрограммыЦелевыхСтатейКРБ.ДатаНачалаДействия <= &Дата)
		|			И (ПрограммыЦелевыхСтатейКРБ.ДатаОкончанияДействия >= &Дата)";
		
		Если НЕ Бюджет = Неопределено Тогда
			Запрос.Текст = Запрос.Текст + "	
			|	И (ПрограммыЦелевыхСтатейКРБ.Бюджет В (&Бюджеты))";
		КонецЕсли;
		
	ИначеЕсли ВидКБК = Перечисления.ВидыКБК.КИФ Тогда
		
		Если Найти(ДопустимыеАналитическиеГруппыКИФ, Сред(КодБК, 15, 3)) = Неопределено Тогда 
			ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Недопустимый код аналитической группы КИФ: (%1).'"), Сред(КодБК, 15, 3));
		КонецЕсли;
		
		Структура = Новый Структура("ГруппаПодгруппаКИФ, СтатьяКИФ, ВидКИФ, АналитическаяГруппаКИФ");
		
		Запрос.УстановитьПараметр("ГруппаПодгруппаКИФКод", 		Лев(КодБК, 4));
		Запрос.УстановитьПараметр("СтатьяКИФКод",          		Сред(КодБК, 5, 6));
		Запрос.УстановитьПараметр("ВидКИФКод",  				Сред(КодБК, 11, 4));
		Запрос.УстановитьПараметр("АналитическаяГруппаКИФКод", 	Сред(КодБК, 15, 3));
		
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка) КАК КОСГУ
		|ПОМЕСТИТЬ КОСГУПустаяСсылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ВЫБОР
		|		КОГДА &АналитическаяГруппаКИФКод = ""000""
		|			ТОГДА КОСГУПустаяСсылка.КОСГУ
		|		ИНАЧЕ ЕСТЬNULL(АналитическиеГруппыКИФ.Ссылка, НЕОПРЕДЕЛЕНО)
		|	КОНЕЦ КАК АналитическаяГруппаКИФ
		|ПОМЕСТИТЬ АналитическиеГруппыКИФ
		|ИЗ
		|	КОСГУПустаяСсылка КАК КОСГУПустаяСсылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КОСГУ КАК АналитическиеГруппыКИФ
		|		ПО (АналитическиеГруппыКИФ.ПометкаУдаления = ЛОЖЬ)
		|			И (АналитическиеГруппыКИФ.Код = &АналитическаяГруппаКИФКод)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	АналитическиеГруппыКИФ.АналитическаяГруппаКИФ КАК АналитическаяГруппаКИФ,
		|	ВЫБОР
		|		КОГДА &ГруппаПодгруппаКИФКод = ""0000""
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.ГруппыПодгруппыКИФ.ПустаяСсылка)
		|		ИНАЧЕ ЕСТЬNULL(ГруппыПодгруппыКИФ.Ссылка, НЕОПРЕДЕЛЕНО)
		|	КОНЕЦ КАК ГруппаПодгруппаКИФ
		|ПОМЕСТИТЬ ГруппыПодгруппы
		|ИЗ
		|	АналитическиеГруппыКИФ КАК АналитическиеГруппыКИФ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГруппыПодгруппыКИФ КАК ГруппыПодгруппыКИФ
		|		ПО (ГруппыПодгруппыКИФ.ПометкаУдаления = ЛОЖЬ)
		|			И (ГруппыПодгруппыКИФ.Код = &ГруппаПодгруппаКИФКод)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ВЫБОР
		|		КОГДА &СтатьяКИФКод = ""000000""
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.СтатьиКИФ.ПустаяСсылка)
		|		ИНАЧЕ ЕСТЬNULL(СтатьиКИФ.Ссылка, НЕОПРЕДЕЛЕНО)
		|	КОНЕЦ КАК СтатьяКИФ,
		|	ГруппыПодгруппы.АналитическаяГруппаКИФ,
		|	ГруппыПодгруппы.ГруппаПодгруппаКИФ
		|ПОМЕСТИТЬ Статьи
		|ИЗ
		|	ГруппыПодгруппы КАК ГруппыПодгруппы
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтатьиКИФ КАК СтатьиКИФ
		|		ПО ГруппыПодгруппы.ГруппаПодгруппаКИФ = СтатьиКИФ.Владелец
		|			И (СтатьиКИФ.ПометкаУдаления = ЛОЖЬ)
		|			И (СтатьиКИФ.Код = &СтатьяКИФКод)
		|			И (СтатьиКИФ.ДатаНачалаДействия <= &Дата)
		|			И (СтатьиКИФ.ДатаОкончанияДействия >= &Дата)";
		
		Если НЕ Бюджет = Неопределено Тогда
			Запрос.Текст = Запрос.Текст + "	
			|	И (СтатьиКИФ.Бюджет В (&Бюджеты))";
		КонецЕсли;
		
		Запрос.Текст = Запрос.Текст + "
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	Статьи.АналитическаяГруппаКИФ КАК АналитическаяГруппаКИФ,
		|	Статьи.СтатьяКИФ КАК СтатьяКИФ,
		|	Статьи.ГруппаПодгруппаКИФ КАК ГруппаПодгруппаКИФ,
		|	ВЫБОР
		|		КОГДА &ВидКИФКод = ""0000""
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыКИФ.ПустаяСсылка)
		|		ИНАЧЕ ЕСТЬNULL(ВидыКИФ.Ссылка, НЕОПРЕДЕЛЕНО)
		|	КОНЕЦ КАК ВидКИФ
		|ИЗ
		|	Статьи КАК Статьи
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыКИФ КАК ВидыКИФ
		|		ПО Статьи.СтатьяКИФ = ВидыКИФ.Владелец
		|			И (ВидыКИФ.ПометкаУдаления = ЛОЖЬ)
		|			И (ВидыКИФ.Код = &ВидКИФКод)";
		
		Если НЕ Бюджет = Неопределено Тогда
			Запрос.Текст = Запрос.Текст + "	
			|	И (ВидыКИФ.Бюджет В (&Бюджеты))";
		КонецЕсли;
		
	ИначеЕсли ВидКБК = Перечисления.ВидыКБК.АУИБУ Тогда
		
		Структура = Новый Структура("РазделПодразделКРБ, АналитическийКодКПС");
		
		Запрос.УстановитьПараметр("РазделПодразделКРБКод",  	Лев(КодБК, 4));
		Запрос.УстановитьПараметр("АналитическийКодКПСКод", 	Сред(КодБК, 5, 10));
		
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЗНАЧЕНИЕ(Справочник.РазделыПодразделыКРБ.ПустаяСсылка) КАК РазделПодразделКРБ
		|ПОМЕСТИТЬ РазделыПодразделыКРБПустаяСсылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ВЫБОР
		|		КОГДА &РазделПодразделКРБКод = ""0000""
		|			ТОГДА РазделыПодразделыКРБПустаяСсылка.РазделПодразделКРБ
		|		ИНАЧЕ ЕСТЬNULL(РазделыПодразделыКРБ.Ссылка, НЕОПРЕДЕЛЕНО)
		|	КОНЕЦ КАК РазделПодразделКРБ
		|ПОМЕСТИТЬ РазделыПодразделыКРБ
		|ИЗ
		|	РазделыПодразделыКРБПустаяСсылка КАК РазделыПодразделыКРБПустаяСсылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РазделыПодразделыКРБ КАК РазделыПодразделыКРБ
		|		ПО (РазделыПодразделыКРБ.ПометкаУдаления = ЛОЖЬ)
		|			И (РазделыПодразделыКРБ.Код = &РазделПодразделКРБКод)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ВЫБОР
		|		КОГДА &АналитическийКодКПСКод = ""0000000000""
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.АналитическиеКодыКПС.ПустаяСсылка)
		|		ИНАЧЕ ЕСТЬNULL(АналитическийКодКПС.Ссылка, НЕОПРЕДЕЛЕНО)
		|	КОНЕЦ КАК АналитическийКодКПС,
		|	ЕСТЬNULL(РазделыПодразделыКРБ.РазделПодразделКРБ, НЕОПРЕДЕЛЕНО) КАК РазделПодразделКРБ
		|ПОМЕСТИТЬ АналитическиеКодыКПС
		|ИЗ
		|	РазделыПодразделыКРБ КАК РазделыПодразделыКРБ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.АналитическиеКодыКПС КАК АналитическийКодКПС
		|		ПО (АналитическийКодКПС.ПометкаУдаления = ЛОЖЬ)
		|			И (АналитическийКодКПС.Код = &АналитическийКодКПСКод)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	АналитическиеКодыКПС.РазделПодразделКРБ,
		|	АналитическиеКодыКПС.АналитическийКодКПС,";
		
		Если ТипЗнч(ВидКПСАУБУ) = Тип("Строка") Тогда
			Если ВидКПСАУБУ = "КДБ" Тогда
				ВидКПСАУБУ = Перечисления.ВидыКБК.КДБ;
			ИначеЕсли ВидКПСАУБУ = "КРБ" Тогда
				ВидКПСАУБУ = Перечисления.ВидыКБК.КРБ;
			ИначеЕсли ВидКПСАУБУ = "КИФ" Тогда
				ВидКПСАУБУ = Перечисления.ВидыКБК.КИФ;
			КонецЕсли;
		КонецЕсли;	
		
		Если НЕ ТипЗнч(ВидКПСАУБУ) = Тип("ПеречислениеСсылка.ВидыКБК") Тогда 
			ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Неверное значение параметра Вид КПС АУ и БУ (%1).'"),
			ВидКПСАУБУ);
		КонецЕсли;
		
		Если ВидКПСАУБУ = Перечисления.ВидыКБК.КРБ Тогда
			
			Структура.Вставить("ВидРасходаКРБ");
			Запрос.УстановитьПараметр("ВидРасходаКРБКод",  	Сред(КодБК, 15, 3));
			
			Запрос.Текст = Запрос.Текст + "
			|	ВЫБОР
			|		КОГДА &ВидРасходаКРБКод = ""000""
			|			ТОГДА ЗНАЧЕНИЕ(Справочник.ВидыРасходовКРБ.ПустаяСсылка)
			|		ИНАЧЕ ЕСТЬNULL(ВидыРасходовКРБ.Ссылка, НЕОПРЕДЕЛЕНО)
			|	КОНЕЦ КАК ВидРасходаКРБ
			|ИЗ
			|	АналитическиеКодыКПС КАК АналитическиеКодыКПС
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыРасходовКРБ КАК ВидыРасходовКРБ
			|		ПО (ВидыРасходовКРБ.ПометкаУдаления = ЛОЖЬ)
			|			И (ВидыРасходовКРБ.Код = &ВидРасходаКРБКод)";
			
		ИначеЕсли ВидКПСАУБУ = Перечисления.ВидыКБК.КДБ Тогда
			
			Если Найти(ДопустимыеАналитическиеГруппыКДБ, Сред(КодБК, 15, 3)) = Неопределено Тогда 
				ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Недопустимый код аналитической группы КДБ: (%1).'"), Сред(КодБК, 15, 3));
			КонецЕсли;
			
			Структура.Вставить("АналитическаяГруппаКДБ");
			Запрос.УстановитьПараметр("АналитическаяГруппаКДБКод",  Сред(КодБК, 15, 3));
			
			Запрос.Текст = Запрос.Текст + "
			|	ВЫБОР
			|		КОГДА &АналитическаяГруппаКДБКод = ""000""
			|			ТОГДА ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)
			|		ИНАЧЕ ЕСТЬNULL(КОСГУ.Ссылка, НЕОПРЕДЕЛЕНО)
			|	КОНЕЦ КАК АналитическаяГруппаКДБ
			|ИЗ
			|	АналитическиеКодыКПС КАК АналитическиеКодыКПС
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КОСГУ КАК КОСГУ
			|		ПО (КОСГУ.ПометкаУдаления = ЛОЖЬ)
			|			И (КОСГУ.Код = &АналитическаяГруппаКДБКод)";
			
		ИначеЕсли ВидКПСАУБУ = Перечисления.ВидыКБК.КИФ Тогда
			
			Если Найти(ДопустимыеАналитическиеГруппыКИФ, Сред(КодБК, 15, 3)) = Неопределено Тогда 
				ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Недопустимый код аналитической группы КИФ: (%1).'"), Сред(КодБК, 15, 3));
			КонецЕсли;
			
			Структура.Вставить("АналитическаяГруппаКИФ");
			Запрос.УстановитьПараметр("АналитическаяГруппаКИФКод",  Сред(КодБК, 15, 3));
			
			Запрос.Текст = Запрос.Текст + "
			|	ВЫБОР
			|		КОГДА &АналитическаяГруппаКИФКод = ""000""
			|			ТОГДА ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)
			|		ИНАЧЕ ЕСТЬNULL(КОСГУ.Ссылка, НЕОПРЕДЕЛЕНО)
			|	КОНЕЦ КАК АналитическаяГруппаКИФ
			|ИЗ
			|	АналитическиеКодыКПС КАК АналитическиеКодыКПС
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КОСГУ КАК КОСГУ
			|		ПО (КОСГУ.ПометкаУдаления = ЛОЖЬ)
			|			И (КОСГУ.Код = &АналитическаяГруппаКИФКод)";
			
		Иначе	
			ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Неверное значение параметра Вид КПС АУ и БУ (%1).'"),
			ВидКПСАУБУ);
		КонецЕсли;
		
	Иначе
		ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Неверное значение параметра ВидКБК (%1).'"),
		ВидКБК);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Запрос.Текст) Тогда
		УстановитьПривилегированныйРежим(Истина);
		Если НЕ Бюджет = Неопределено Тогда
			Бюджеты = Справочники.Бюджеты.ПолучитьВышестоящие(Бюджет);
			Запрос.УстановитьПараметр("Бюджеты", Бюджеты);
		КонецЕсли;	
		РезультатЗапроса = Запрос.Выполнить();
		УстановитьПривилегированныйРежим(Ложь);
		
		Если НЕ РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			ЗаполнитьЗначенияСвойств(Структура, Выборка); 
		КонецЕсли;
	КонецЕсли;
	
	Если СтрДлина(КодБК) = 20 Тогда
		// Для статьи плана попробуем определить КОСГУ
		ЗапросКОСГУ = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ВЫБОР
		|		КОГДА &КОСГУКод = ""000""
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)
		|		ИНАЧЕ ЕСТЬNULL(СправочникКОСГУ.Ссылка, НЕОПРЕДЕЛЕНО)
		|	КОНЕЦ КАК КОСГУ
		|ИЗ
		|	Справочник.КОСГУ КАК СправочникКОСГУ
		|ГДЕ
		|	СправочникКОСГУ.Код = &КОСГУКод");
		ЗапросКОСГУ.УстановитьПараметр("КОСГУКод",  Прав(КодБК, 3));
		
		УстановитьПривилегированныйРежим(Истина);
		Выборка = ЗапросКОСГУ.Выполнить().Выбрать();
		УстановитьПривилегированныйРежим(Ложь);
		
		Если Выборка.Следующий() Тогда
			Структура.Вставить("КОСГУ", Выборка.КОСГУ);
		Иначе
			Структура.Вставить("КОСГУ", Неопределено);
		КонецЕсли;
	КонецЕсли;
	
	РезультатЗаполненКорректно = Истина;
	
	Для Каждого КлючИЗначение Из Структура Цикл
		Если КлючИЗначение.Значение = Неопределено Тогда
			РезультатЗаполненКорректно = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Результат = Новый ФиксированнаяСтруктура(Структура);
	
	Возврат РезультатЗаполненКорректно;
	
КонецФункции

Функция ПредставлениеЭлементаБюджетногоКлассификатора(Знач Ссылка) Экспорт
	
	МетаданныеСправочника = Ссылка.Метаданные();
	
	Если МетаданныеСправочника <> Неопределено Тогда
		Если МетаданныеСправочника.ДлинаНаименования <> 0 Тогда
			Представление = ?(ОбщегоНазначения.ЗначениеСсылочногоТипа(Ссылка), ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Наименование"), Ссылка.Наименование);
		Иначе
			Представление = ?(ОбщегоНазначения.ЗначениеСсылочногоТипа(Ссылка), ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "Код"), Ссылка.Код);
		КонецЕсли;
	КонецЕсли;
	
	ПредставлениеТипа = МетаданныеСправочника.РасширенноеПредставлениеОбъекта;
	Если ПустаяСтрока(ПредставлениеТипа) Тогда
		ПредставлениеТипа = МетаданныеСправочника.ПредставлениеОбъекта;
	КонецЕсли;
	Если ПустаяСтрока(ПредставлениеТипа) Тогда
		ПредставлениеТипа = МетаданныеСправочника.Синоним;
	КонецЕсли;
	
	Возврат СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
	"%1 (%2)", Представление, ПредставлениеТипа);
	
КонецФункции

Функция ПредставлениеСправочникаБюджетногоКлассификатора(Знач Ссылка) Экспорт
	
	МетаданныеСправочника = Ссылка.Метаданные();
	
	ПредставлениеТипа = МетаданныеСправочника.РасширенноеПредставлениеОбъекта;
	Если ПустаяСтрока(ПредставлениеТипа) Тогда
		ПредставлениеТипа = МетаданныеСправочника.ПредставлениеОбъекта;
	КонецЕсли;
	Если ПустаяСтрока(ПредставлениеТипа) Тогда
		ПредставлениеТипа = МетаданныеСправочника.Синоним;
	КонецЕсли;
	
	Возврат ПредставлениеТипа;
	
КонецФункции

// Возвращает вид бюджетного классификатора по аналитическому коду КДБ (КИФ) или вида расходов КРБ.
//
// Параметры:
//  АналитическийКод - Строка, 3 - аналитический код КДБ (КИФ) или вид расходов КРБ. 
//  ПолныйКод - Строка, 20 - Код БК или - Строка, 17 - КПС.  
//              Используется для уточнения вида аналитического кода в случае
//              пересечения значений классификатороа аналитичесаких кодов КИФ и видов расходов КРБ
//
// Возвращаемое значение:
//  ПеречислениеСсылка.ВидыКБК
//
Функция ВидКБКПоАналитическомуКоду(АналитическийКод, ПолныйКод = "") Экспорт   
	
	КодыДоходов = БюджетнаяКлассификацияКлиентСервер.АналитическиеКодыДоходов(); 
	КодыИсточников = БюджетнаяКлассификацияКлиентСервер.АналитическиеКодыИсточников();
	КодыТребующиеПроверкиКИФКРБ = БюджетнаяКлассификацияКлиентСервер.АналитическиеКодыТребующиеПроверкиКИФКРБ();
	КодыТребующиеПроверкиКИФКДБ = БюджетнаяКлассификацияКлиентСервер.АналитическиеКодыТребующиеПроверкиКИФКДБ();
	
	Если НЕ ЗначениеЗаполнено(АналитическийКод) ИЛИ НЕ СтрДлина(АналитическийКод) = 3 Тогда
		Возврат(ПредопределенноеЗначение("Перечисление.ВидыКБК.ПустаяСсылка"));
	КонецЕсли;  
	
	ДлинаКода = СтрДлина(ПолныйКод);
	ВозможноЭтоКИФКРБ = (КодыТребующиеПроверкиКИФКРБ.Найти(АналитическийКод) <> Неопределено);
	ВозможноЭтоКИФКДБ = (КодыТребующиеПроверкиКИФКДБ.Найти(АналитическийКод) <> Неопределено);
	
	Если (ВозможноЭтоКИФКРБ = Ложь
			И ВозможноЭтоКИФКДБ = Ложь)
		ИЛИ НЕ (ДлинаКода = 20 
			ИЛИ  ДлинаКода = 17) Тогда
		
		Если НЕ КодыДоходов.Найти(АналитическийКод) = Неопределено Тогда
			Возврат(ПредопределенноеЗначение("Перечисление.ВидыКБК.КДБ")); 
		КонецЕсли;
		Если НЕ КодыИсточников.Найти(АналитическийКод) = Неопределено Тогда
			Возврат(ПредопределенноеЗначение("Перечисление.ВидыКБК.КИФ")); 
		КонецЕсли;  
		Если НЕ Справочники.ВидыРасходовКРБ.НайтиПоКоду(АналитическийКод) = Неопределено Тогда
			Возврат(ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ")); 
		КонецЕсли;   
	Иначе
		Если ДлинаКода = 20 Тогда
			Первые4 = Сред(ПолныйКод, 4, 4);
			Следующие6 = Сред(ПолныйКод, 8, 6);
		ИначеЕсли ДлинаКода = 17 Тогда
			Первые4 = Сред(ПолныйКод, 1, 4);
			Следующие6 = Сред(ПолныйКод, 5, 6);
		Иначе  
			Возврат(ПредопределенноеЗначение("Перечисление.ВидыКБК.ПустаяСсылка")); 	
		КонецЕсли; 
		Запрос = Новый Запрос("ВЫБРАТЬ
		|	СтатьиКИФ.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.СтатьиКИФ КАК СтатьиКИФ
		|ГДЕ
		|	СтатьиКИФ.Код = &Следующие6
		|	И СтатьиКИФ.Владелец.Код = &Первые4");
		Запрос.УстановитьПараметр("Следующие6", Следующие6);
		Запрос.УстановитьПараметр("Первые4", Первые4); 
		Результат = Запрос.Выполнить();
		Если Результат.Пустой() Тогда
			Если ВозможноЭтоКИФКРБ Тогда			
				Возврат(ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ"));
			Иначе
				Возврат(ПредопределенноеЗначение("Перечисление.ВидыКБК.КДБ"));
			КонецЕсли;
		Иначе
			Возврат(ПредопределенноеЗначение("Перечисление.ВидыКБК.КИФ"));
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат(ПредопределенноеЗначение("Перечисление.ВидыКБК.ПустаяСсылка"));
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// РАБОТА С УПРАВЛЯЕМЫМИ ФОРМАМИ БЮДЖЕТНЫХ КЛАССИФИКАТОРОВ
//

// Обработчик события ПриСозданииНаСервере для списков бюджетных классификаторов.
//
// Параметры:
//	Форма - создаваемая форма
//	Отказ - признак отказа
//	СоответствиеЭлементовОтбора - соответствие. Ключ - поле справочника, 
//												Значение - имя реквизита формы, связанного с отбором
//
Процедура ПриСозданииНаСервереФормыСписка(Форма, Отказ, СоответствиеЭлементовОтбора = Неопределено, НедоступныеЭлементыБыстрогоОтбора = Неопределено) Экспорт
	
	Перем ОтборНаДату;
	
	Если ТипЗнч(Форма.Параметры.ДополнительныйОтбор) = Тип("Структура") Тогда
		// Объединение отборов
		Для Каждого ДопОтбор Из Форма.Параметры.ДополнительныйОтбор Цикл
			Если ДопОтбор.Ключ = "НаДату" Тогда // НаДату - это особый вид отбора
				ОтборНаДату = ДопОтбор.Значение;
			Иначе
				
				Если Форма.Параметры.Отбор.Свойство(ДопОтбор.Ключ) Тогда
					ОбъединитьОсновнойИДополнительныйОтбор(Форма.Параметры.Отбор, Форма.Параметры.ДополнительныйОтбор, ДопОтбор.Ключ);
				Иначе
					Форма.Параметры.Отбор.Вставить(ДопОтбор.Ключ, ДопОтбор.Значение);
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ОтборНаДату) И Форма.Параметры.Свойство("НаДату") Тогда
		ОтборНаДату = Форма.Параметры.НаДату;
	КонецЕсли;	
	
	Если СоответствиеЭлементовОтбора <> Неопределено Тогда
		
		Для Каждого ЭлементСоответствия Из СоответствиеЭлементовОтбора Цикл
			ЗначениеОтбора = Неопределено;
			Если Форма.Параметры.Отбор.Свойство(ЭлементСоответствия.Ключ, ЗначениеОтбора) Тогда
				
				Если Не ЭтоОдиночноеЗначение(ЗначениеОтбора) Тогда
					Если ЗначениеОтбора.Количество() > 0 Тогда
						
						Форма[ЭлементСоответствия.Значение] = ?(ТипЗнч(ЗначениеОтбора) = Тип("СписокЗначений"),
						ЗначениеОтбора[0].Значение,
						ЗначениеОтбора[0]);
					КонецЕсли;
				Иначе
					
					Форма[ЭлементСоответствия.Значение] = ЗначениеОтбора;
					
				КонецЕсли;
				
				Если НедоступныеЭлементыБыстрогоОтбора <> Неопределено Тогда
					
					ИмяЭлемента = НедоступныеЭлементыБыстрогоОтбора.Получить(ЭлементСоответствия.Ключ);
					
					Если ИмяЭлемента <> Неопределено Тогда
						
						Форма.Элементы[ИмяЭлемента].ТолькоПросмотр 		= Истина;
						
					КонецЕсли;
					
				КонецЕсли;
				
			ИначеЕсли ЭлементСоответствия.Ключ = "НаДату" Тогда 
				Если НЕ ЗначениеЗаполнено(ОтборНаДату) Тогда
					ОтборНаДату = ТекущаяДатаСеанса();
				КонецЕсли;	
				Форма[ЭлементСоответствия.Значение] = ОтборНаДату;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Если установлен отбор по бюджету - добавим вышестоящие
	//	
	Для Каждого ЭлементОтбора Из Форма.Параметры.Отбор Цикл
		
		Если ТипЗнч(ЭлементОтбора.Значение) = Тип("СправочникСсылка.Бюджеты") И ЗначениеЗаполнено(ЭлементОтбора.Значение) Тогда
			
			Массив = МассивВышестоящихБюджетов(ЭлементОтбора.Значение);
			
			Если Массив.Количество() > 1 Тогда
				
				Форма.Параметры.Отбор.Вставить(ЭлементОтбора.Ключ, Массив);
				
			КонецЕсли;
			
			Прервать;
			
		КонецЕсли;	
		
	КонецЦикла;	
	
	Если ЗначениеЗаполнено(ОтборНаДату) Тогда
		БюджетнаяКлассификацияКлиентСервер.УстановитьОтборНаДату(Форма, ОтборНаДату);
	КонецЕсли;
	
КонецПроцедуры 

Функция МассивВышестоящихБюджетов(Бюджет) Экспорт
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ
	|	Бюджеты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Бюджеты КАК Бюджеты
	|ГДЕ
	|	Бюджеты.Ссылка = &Ссылка
	|ИТОГИ ПО
	|	Ссылка ТОЛЬКО ИЕРАРХИЯ");
	
	Запрос.УстановитьПараметр("Ссылка", Бюджет);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции	

// Обработчик события ОбработкаПолученияДанныхВыбора для менеджеров справочников классификации
//
Процедура ОбработкаПолученияДанныхВыбораБюджетнойКлассификации(ДанныеВыбора, Параметры, СтандартнаяОбработка) Экспорт
	
	Перем ДополнительныйОтбор;
	
	Если Параметры.Свойство("ДополнительныйОтбор", ДополнительныйОтбор)
		И ТипЗнч(ДополнительныйОтбор) = Тип("Структура") Тогда
		
		Для Каждого ДопОтбор Из ДополнительныйОтбор Цикл
			Если ДопОтбор.Ключ <> "НаДату" Тогда // НаДату - это особый вид отбора, в обработке выбора не применяется
				
				Если Параметры.Отбор.Свойство(ДопОтбор.Ключ) Тогда
					ОбъединитьОсновнойИДополнительныйОтбор(Параметры.Отбор, ДополнительныйОтбор, ДопОтбор.Ключ);
					// В обработке выбора список значений не отрабатывает. Нужен ФиксированныйМассив.
					МассивЗначенийОтбора = Параметры.Отбор[ДопОтбор.Ключ].ВыгрузитьЗначения();
					Параметры.Отбор[ДопОтбор.Ключ] = Новый ФиксированныйМассив(МассивЗначенийОтбора);
				Иначе
					Параметры.Отбор.Вставить(ДопОтбор.Ключ, ДопОтбор.Значение);
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры 

// Обработчик получения данных выбора справочника КОСГУ (КЭК)
//
// Параметры соответствуют параметрам процедуры ОбработкаПолученияДанныхВыбора()
// менеджера перечисления
//
Процедура ПриОбработкеПолученияДанныхВыбораКОСГУ(ДанныеВыбора, Параметры, СтандартнаяОбработка) Экспорт
	
	МодифицироватьПараметрыФормыОтбораКОСГУ(Параметры);
	
	БюджетнаяКлассификацияПереопределяемый.ПриОбработкеПолученияДанныхВыбораКОСГУ(ДанныеВыбора, Параметры, СтандартнаяОбработка);
	
КонецПроцедуры

Процедура МодифицироватьПараметрыФормыОтбораКОСГУ(Параметры) Экспорт
	
	ОтборКод = Неопределено;
	
	Если НЕ Параметры.Свойство("Отбор") Тогда
		Возврат;
	КонецЕсли;	
	
	Если Параметры.Отбор.Свойство("ВидДоходов") Тогда
		
		Запрос = Новый Запрос("
		|ВЫБРАТЬ
		|	ВидыДоходовКДБАналитическиеГруппы.АналитическаяГруппа.Код КАК КОСГУ
		|ИЗ
		|	Справочник.ВидыДоходовКДБ.АналитическиеГруппы КАК ВидыДоходовКДБАналитическиеГруппы
		|ГДЕ
		|	ВидыДоходовКДБАналитическиеГруппы.Ссылка = &Ссылка");
		
		Запрос.УстановитьПараметр("Ссылка", Параметры.Отбор.ВидДоходов);
		
		Выборка = Запрос.Выполнить().Выгрузить();
		
		Если Выборка.Количество() > 0 Тогда
			
			ОтборКод = Выборка.ВыгрузитьКолонку("КОСГУ");
			
		КонецЕсли;
		
	ИначеЕсли Параметры.Отбор.Свойство("ГруппаПодгруппаКИФ") ИЛИ Параметры.Отбор.Свойство("СтатьяКИФ") Тогда
		
		ГруппаПодгруппаКИФ 	= Неопределено;
		СтатьяКИФ 			= Неопределено;
		Параметры.Отбор.Свойство("ГруппаПодгруппаКИФ", ГруппаПодгруппаКИФ);
		Параметры.Отбор.Свойство("СтатьяКИФ", СтатьяКИФ);
		
		Если ЗначениеЗаполнено(СтатьяКИФ) Тогда
			
			Запрос = Новый Запрос("
			|ВЫБРАТЬ
			|	СтатьиКИФДопустимыеКОСГУ.КОСГУ.Код КАК КОСГУ
			|ИЗ
			|	Справочник.СтатьиКИФ.ДопустимыеКОСГУ КАК СтатьиКИФДопустимыеКОСГУ
			|ГДЕ
			|	СтатьиКИФДопустимыеКОСГУ.Ссылка = &Ссылка");
			
			Запрос.УстановитьПараметр("Ссылка", СтатьяКИФ);
			
			Выборка = Запрос.Выполнить().Выгрузить();
			
			Если Выборка.Количество() > 0 Тогда
				
				ОтборКод = Выборка.ВыгрузитьКолонку("КОСГУ");
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если ОтборКод = Неопределено И ЗначениеЗаполнено(ГруппаПодгруппаКИФ) Тогда
			
			Запрос = Новый Запрос("
			|ВЫБРАТЬ
			|	ГруппыПодгруппыКИФДопустимыеКОСГУ.КОСГУ.Код КАК КОСГУ
			|ИЗ
			|	Справочник.ГруппыПодгруппыКИФ.ДопустимыеКОСГУ КАК ГруппыПодгруппыКИФДопустимыеКОСГУ
			|ГДЕ
			|	ГруппыПодгруппыКИФДопустимыеКОСГУ.Ссылка = &Ссылка");
			
			Запрос.УстановитьПараметр("Ссылка", ГруппаПодгруппаКИФ);
			
			Выборка = Запрос.Выполнить().Выгрузить();
			
			Если Выборка.Количество() > 0 Тогда
				
				ОтборКод = Выборка.ВыгрузитьКолонку("КОСГУ");
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;	 
	
	Если НЕ ОтборКод = Неопределено Тогда
		
		Параметры.Отбор.Вставить("Код", Новый ФиксированныйМассив(ОтборКод));
		
	КонецЕсли;
	
КонецПроцедуры	

Функция ПолучитьКодыОтбораПоШаблону(Параметры, ИмяСправочника) Экспорт
	
	НовыйОтборКод = Новый Массив;
	
	Если Параметры.Свойство("Отбор") И ЗначениеЗаполнено(Параметры.Отбор) И Параметры.Отбор.Свойство("Код") Тогда
		
		КодыПодобно = Новый Массив;
		КодыСписок = Новый Массив;
		Для Каждого КодОтбор Из Параметры.Отбор.Код Цикл
			ЗначениеОтбора = КодОтбор.Значение;
			ЗначениеОтбора = СтрЗаменить(КодОтбор.Значение, "*", "_");// Символ * может использоваться как _ в конструкции ПОДОБНО.
			
			Если Найти(ЗначениеОтбора, "_") > 0 
				ИЛИ Найти(ЗначениеОтбора, "%") > 0 
				ИЛИ Найти(ЗначениеОтбора, "[") > 0 Тогда
				КодыПодобно.Добавить(ЗначениеОтбора);
			Иначе
				КодыСписок.Добавить(ЗначениеОтбора);
			КонецЕсли;	
		КонецЦикла;
		
		Запрос = Новый Запрос;
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	%ИмяСправочника%.Код КАК Код
		|ИЗ
		|	Справочник.%ИмяСправочника% КАК %ИмяСправочника%
		|ГДЕ
		|	%ИмяСправочника%.Код В(&СписокКодов) 
		|	%ОтборПодобно%";
		
		ТекстОтборПодобно = "";
		СчОтборов = 1;
		Для Каждого ОтборПодобно Из КодыПодобно Цикл
			
			ТекстОтборПодобно = ТекстОтборПодобно + " ИЛИ %ИмяСправочника%.Код ПОДОБНО &ОтборПодобно"+СчОтборов;
			Запрос.УстановитьПараметр("ОтборПодобно"+СчОтборов, ОтборПодобно);
			
			СчОтборов = СчОтборов + 1;
		КонецЦикла;
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ОтборПодобно%", ТекстОтборПодобно);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ИмяСправочника%", ИмяСправочника);
		
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("СписокКодов", КодыСписок);
		
		ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
		НовыйОтборКод = ТаблицаРезультат.ВыгрузитьКолонку("Код");
		
	КонецЕсли;
	
	Возврат Новый ФиксированныйМассив(НовыйОтборКод);
	
КонецФункции

Процедура УстановитьУсловноеОформлениеПоляВидКПСБУАУВСписке(Список, ИмяПоля = "ВидПоказателя", ИмяПоляУточнения = "УточнениеПоказателя") Экспорт
	
	УсловноеОформление 	= Список.УсловноеОформление.Элементы;
	
	// Доходы
	ЭлементОформления 	= УсловноеОформление.Добавить();
	ОформляемоеПоле 	= ЭлементОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
	
	ГруппаОтбора = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(ЭлементОформления.Отбор.Элементы, "Доходы", ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбора, ИмяПоля, ПредопределенноеЗначение("Перечисление.ВидыКБК.АУИБУ"), ВидСравненияКомпоновкиДанных.Равно,, Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбора, ИмяПоляУточнения, ПредопределенноеЗначение("Перечисление.ВидыКБК.КДБ"), ВидСравненияКомпоновкиДанных.Равно,, Истина);
	
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Текст", "КДБ для АУ и БУ");
	
	ЭлементОформления.Использование = Истина;
	
	// Расходы
	ЭлементОформления 	= УсловноеОформление.Добавить();
	ОформляемоеПоле 	= ЭлементОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
	
	ГруппаОтбора = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(ЭлементОформления.Отбор.Элементы, "Расходы", ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбора, ИмяПоля, ПредопределенноеЗначение("Перечисление.ВидыКБК.АУИБУ"), ВидСравненияКомпоновкиДанных.Равно,, Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбора, ИмяПоляУточнения, ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ"), ВидСравненияКомпоновкиДанных.Равно,, Истина);
	
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Текст", "КРБ для АУ и БУ");
	
	ЭлементОформления.Использование = Истина;
	
	// Источники
	ЭлементОформления 	= УсловноеОформление.Добавить();
	ОформляемоеПоле 	= ЭлементОформления.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
	
	ГруппаОтбора = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(ЭлементОформления.Отбор.Элементы, "Источники", ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбора, ИмяПоля, ПредопределенноеЗначение("Перечисление.ВидыКБК.АУИБУ"), ВидСравненияКомпоновкиДанных.Равно,, Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбора, ИмяПоляУточнения, ПредопределенноеЗначение("Перечисление.ВидыКБК.КИФ"), ВидСравненияКомпоновкиДанных.Равно,, Истина);
	
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Текст", "КИФ для АУ и БУ");
	
	ЭлементОформления.Использование = Истина;
	
КонецПроцедуры	

