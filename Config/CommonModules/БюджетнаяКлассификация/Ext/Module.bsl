Процедура ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,СпрСсылка,ТекстОшибки,КатегорияОшибки = 0) Экспорт
	
	НоваяСтрокаОшибки = ТаблицаОшибок.Добавить();
	НоваяСтрокаОшибки.ИмяОбъекта = СпрСсылка.Метаданные().Синоним;
	НоваяСтрокаОшибки.СсылкаНаЭлементОшибки = СпрСсылка;				
	НоваяСтрокаОшибки.ОписаниеОшибки = ТекстОшибки;
	НоваяСтрокаОшибки.КатегорияОшибки = КатегорияОшибки;
	
КонецПроцедуры

Функция ВыполнитьПроцедурыПередЗаписью(ЭлементОбъект,ТаблицаОшибок,СоответствиеЭталоновДанных,СоответствиеАктуализации,НужноЗаполнятьТаблицуАктуализации) Экспорт
	
	Отказ = Ложь;
	КоличествоОшибок = ТаблицаОшибок.НайтиСтроки(Новый Структура("КатегорияОшибки",0)).Количество();
	
	БюджетнаяКлассификацияПереопределяемый.ВыполнитьПроцедурыПередЗаписьюДоОсновныхОбработчиков(ЭлементОбъект,ТаблицаОшибок,СоответствиеЭталоновДанных,СоответствиеАктуализации,НужноЗаполнятьТаблицуАктуализации);
	
	ТипОбъекта = ТипЗнч(ЭлементОбъект);
	// Подписки перед записью объекта
	// Простые справочники
	Если ТипОбъекта = Тип("СправочникОбъект.ВидыРасходовКРБ") Тогда
		
		БюджетнаяКлассификацияСобытия.ЗаполнитьДатуОкончанияДействияЯвно(ЭлементОбъект,Отказ);         
		БюджетнаяКлассификацияСобытия.ПроверитьУникальностьКодаЯвно(ЭлементОбъект,Отказ,ТаблицаОшибок);  
		
	ИначеЕсли ТипОбъекта = Тип("СправочникОбъект.ГлавыПоБюджетнойКлассификации") Тогда
		
		БюджетнаяКлассификацияСобытия.ЗаполнитьДатуОкончанияДействияЯвно(ЭлементОбъект,Отказ);
		БюджетнаяКлассификацияСобытия.ПроверитьУникальностьКодаЯвно(ЭлементОбъект,Отказ,ТаблицаОшибок);  
		
	ИначеЕсли ТипОбъекта = Тип("СправочникОбъект.КОСГУ") Тогда
		
		БюджетнаяКлассификацияСобытия.ОпределитьРодителяДляАвтоиерархииЯвно(ЭлементОбъект,Отказ);
		
	ИначеЕсли ТипОбъекта = Тип("СправочникОбъект.РазделыПодразделыКРБ") Тогда			
		
		БюджетнаяКлассификацияСобытия.ОпределитьРодителяДляАвтоиерархииЯвно(ЭлементОбъект,Отказ);
		
	// КИФ	
	ИначеЕсли ТипОбъекта = Тип("СправочникОбъект.ВидыКИФ") Тогда
		
		БюджетнаяКлассификацияСобытия.УстановитьПолныйКодЯвно(ЭлементОбъект,Отказ);
		
	ИначеЕсли ТипОбъекта = Тип("СправочникОбъект.ГруппыПодгруппыКИФ") Тогда
		
		БюджетнаяКлассификацияСобытия.ОпределитьРодителяДляАвтоиерархииЯвно(ЭлементОбъект,Отказ);
		БюджетнаяКлассификацияСобытия.УстановитьПолныйКодЯвно(ЭлементОбъект,Отказ); 
		
	ИначеЕсли ТипОбъекта = Тип("СправочникОбъект.СтатьиКИФ") Тогда
		
		БюджетнаяКлассификацияСобытия.ЗаполнитьДатуОкончанияДействияЯвно(ЭлементОбъект,Отказ);
		БюджетнаяКлассификацияСобытия.УстановитьПолныйКодЯвно(ЭлементОбъект,Отказ);
		БюджетнаяКлассификацияСобытия.ПроверитьУникальностьКодаЯвно(ЭлементОбъект,Отказ,ТаблицаОшибок);		
		
	// Целевые статьи КРБ	
	ИначеЕсли ТипОбъекта = Тип("СправочникОбъект.ПрограммыЦелевыхСтатейКРБ") Тогда
		
		БюджетнаяКлассификацияСобытия.ЗаполнитьДатуОкончанияДействияЯвно(ЭлементОбъект,Отказ);
		БюджетнаяКлассификацияСобытия.УстановитьПолныйКодЯвно(ЭлементОбъект,Отказ);
		БюджетнаяКлассификацияСобытия.ПроверитьУникальностьКодаЯвно(ЭлементОбъект,Отказ,ТаблицаОшибок);
		
	ИначеЕсли ТипОбъекта = Тип("СправочникОбъект.ЦелевыеСтатьиКРБ") Тогда
		
		БюджетнаяКлассификацияСобытия.ПередЗаписьюЦелевыхСтатейКРБ(ЭлементОбъект,Отказ);
		
		БюджетнаяКлассификацияСобытия.ЗаполнитьДатуОкончанияДействияЯвно(ЭлементОбъект,Отказ);
		БюджетнаяКлассификацияСобытия.ОпределитьРодителяДляАвтоиерархииЯвно(ЭлементОбъект,Отказ);
		БюджетнаяКлассификацияСобытия.УстановитьПолныйКодЯвно(ЭлементОбъект,Отказ);
		БюджетнаяКлассификацияСобытия.ПроверитьУникальностьКодаЯвно(ЭлементОбъект,Отказ,ТаблицаОшибок);
		
	// КДБ
	ИначеЕсли ТипОбъекта = Тип("СправочникОбъект.ВидыДоходовКДБ") Тогда
		
		БюджетнаяКлассификацияСобытия.ПередЗаписьюВидыДоходовКДБ(ЭлементОбъект,Отказ);
		
		БюджетнаяКлассификацияСобытия.ЗаполнитьДатуОкончанияДействияЯвно(ЭлементОбъект,Отказ);
		БюджетнаяКлассификацияСобытия.УстановитьПолныйКодЯвно(ЭлементОбъект,Отказ);
		БюджетнаяКлассификацияСобытия.ПроверитьУникальностьКодаЯвно(ЭлементОбъект,Отказ,ТаблицаОшибок);
		
	ИначеЕсли ТипОбъекта = Тип("СправочникОбъект.ГруппыПодвидовКДБ") Тогда	
		
		БюджетнаяКлассификацияСобытия.УстановитьПолныйКодЯвно(ЭлементОбъект,Отказ);
		
	КонецЕсли;
	
	БюджетнаяКлассификацияПереопределяемый.ВыполнитьПроцедурыПередЗаписьюПослеОсновныхОбработчиков(ЭлементОбъект,ТаблицаОшибок,СоответствиеЭталоновДанных,СоответствиеАктуализации,НужноЗаполнятьТаблицуАктуализации);
	
	КонечноеКоличествоОшибок = ТаблицаОшибок.НайтиСтроки(Новый Структура("КатегорияОшибки",0)).Количество();	
	Возврат Отказ ИЛИ КонечноеКоличествоОшибок<>КоличествоОшибок;
	
КонецФункции

Функция ВыполнитьПроцедурыПриЗаписи(ЭлементОбъект,ТаблицаОшибок,СоответствиеЭталоновДанных,СоответствиеАктуализации,НужноЗаполнятьТаблицуАктуализации) Экспорт
	
	Отказ = Ложь;
	
