Процедура ОткрытьДобавлениеСпискомДМ(Форма, Объект, ОбъектНФА, ИнвНомер, Количество, ВидОбъектаДМ) Экспорт
	
	Если НЕ ПроверитьЗаполнениеОбязательныхРеквизитов(Форма, Объект, Истина) Тогда
		Возврат;
	КонецЕсли;
	
	Если ВидОбъектаДМ = "Лом" Тогда
		ВариантВводаДанных = 1;
	Иначе	
		ВариантВводаДанных = 0;
	КонецЕсли;	
	
	Параметры = Новый Структура("Отбор", Новый Структура);
	
	Параметры.Вставить("ОбъектНФА",	ОбъектНФА);
	Параметры.Вставить("ИнвНомер",	ИнвНомер);
	Параметры.Вставить("Количество",Количество);
	Параметры.Вставить("Ссылка",	Объект.Ссылка);
	Параметры.Вставить("ВариантВводаДанных",	ВариантВводаДанных);
	
	Форма.ДополнитьПараметрыДобавленияДМ(Параметры);	
	
	ОткрытьФорму("Обработка.ДобавлениеСпискаДМ.Форма", Параметры, Форма);
	
КонецПроцедуры	

Процедура ОткрытьДобавлениеСпискомДМДляПеречняОбъектов(Форма, Объект, АдресТаблицыОбъектовНФА, ВидОбъектаДМ) Экспорт
	
	Если ВидОбъектаДМ = "Лом" Тогда
		ВариантВводаДанных = 2;
	Иначе	
		ВариантВводаДанных = 3;
	КонецЕсли;	
	
	Параметры = Новый Структура("Отбор", Новый Структура);
	
	Параметры.Вставить("АдресТаблицыОбъектовНФА",		АдресТаблицыОбъектовНФА);
	Параметры.Вставить("Ссылка",						Объект.Ссылка);
	Параметры.Вставить("ВариантВводаДанных",			ВариантВводаДанных);
	
	Форма.ДополнитьПараметрыДобавленияДМ(Параметры);	
	
	ОткрытьФорму("Обработка.ДобавлениеСпискаДМ.Форма", Параметры, Форма);
	
КонецПроцедуры	

Функция ПроверитьЗаполнениеОбязательныхРеквизитов(Форма, Объект, СообщатьОбОшибках = Ложь) Экспорт 

	ПроверяемыеПараметры = Форма.СтруктураПроверяемыхРеквизитовДМ();
	Отказ = ОбщегоНазначенияБГУКлиентСервер.ПроверитьЗаполнениеРеквизитов(ПроверяемыеПараметры, Объект, СообщатьОбОшибках);
	
	Возврат НЕ Отказ;

КонецФункции

Функция ПолучитьКлючСтроки(ОъектНФА, ИнвНомер) Экспорт
	Результат = СокрЛП(ОъектНФА.УникальныйИдентификатор())+"_"+СокрЛП(ИнвНомер);
	
	Возврат Результат;
КонецФункции

Функция ЗаполнитьМассивДоступныхЗначенийАналитикиОперации(ВидДвиженияДМ = Неопределено) Экспорт
	
	МассивТиповАналитикиОперации = Новый Массив;
	
	Если (ВидДвиженияДМ = Неопределено)
		ИЛИ (ВидДвиженияДМ = ПредопределенноеЗначение("Перечисление.ВидыДвиженийДрагМатериалов.ПустаяСсылка")) Тогда
		МассивТиповАналитикиОперации.Добавить(ПредопределенноеЗначение("Перечисление.ТипыАналитикиОперацииСДрагМатериалами.ПоступилоИзГосфондаРоссии"));
		МассивТиповАналитикиОперации.Добавить(ПредопределенноеЗначение("Перечисление.ТипыАналитикиОперацииСДрагМатериалами.ИзрасходованоНаПроизводство"));
		МассивТиповАналитикиОперации.Добавить(ПредопределенноеЗначение("Перечисление.ТипыАналитикиОперацииСДрагМатериалами.ИзрасходованоНаНаучноИсследовательскиеЦели"));
		МассивТиповАналитикиОперации.Добавить(ПредопределенноеЗначение("Перечисление.ТипыАналитикиОперацииСДрагМатериалами.РеализованоДругимОрганизациям"));
	Иначе
		Если (ВидДвиженияДМ = "Поступление") ИЛИ (ВидДвиженияДМ = ПредопределенноеЗначение("Перечисление.ВидыДвиженийДрагМатериалов.ПринятиеКУчету")) Тогда
			МассивТиповАналитикиОперации.Добавить(ПредопределенноеЗначение("Перечисление.ТипыАналитикиОперацииСДрагМатериалами.ПоступилоИзГосфондаРоссии"));
		ИначеЕсли (ВидДвиженияДМ = "Списание") ИЛИ (ВидДвиженияДМ = ПредопределенноеЗначение("Перечисление.ВидыДвиженийДрагМатериалов.Списание")) Тогда
			МассивТиповАналитикиОперации.Добавить(ПредопределенноеЗначение("Перечисление.ТипыАналитикиОперацииСДрагМатериалами.ИзрасходованоНаПроизводство"));
			МассивТиповАналитикиОперации.Добавить(ПредопределенноеЗначение("Перечисление.ТипыАналитикиОперацииСДрагМатериалами.ИзрасходованоНаНаучноИсследовательскиеЦели"));
			МассивТиповАналитикиОперации.Добавить(ПредопределенноеЗначение("Перечисление.ТипыАналитикиОперацииСДрагМатериалами.РеализованоДругимОрганизациям"));
			МассивТиповАналитикиОперации.Добавить(ПредопределенноеЗначение("Перечисление.ТипыАналитикиОперацииСДрагМатериалами.СданоДляПереработкиИАффинажа"));
			МассивТиповАналитикиОперации.Добавить(ПредопределенноеЗначение("Перечисление.ТипыАналитикиОперацииСДрагМатериалами.СданоДляПереработкиИАффинажаОрганизацииЗаготовителю"));
		Конецесли;
	КонецЕсли;
	
	Возврат МассивТиповАналитикиОперации;
КонецФункции	