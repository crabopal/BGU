Функция ПолучитьДатуИзПараметра(ЗначениеПараметра) Экспорт
	Перем ДатаПараметра;
	Если ТипЗнч(ЗначениеПараметра) = Тип("Дата") Тогда
		ДатаПараметра = ЗначениеПараметра;
	ИначеЕсли ТипЗнч(ЗначениеПараметра) = Тип("Граница") Тогда
		//
		Если ТипЗнч(ЗначениеПараметра.Значение) = Тип("МоментВремениСУточнениемПериода") Тогда
			ДатаПараметра = ЗначениеПараметра.Значение.Дата;
		Иначе
			ДатаПараметра = ЗначениеПараметра.Значение;
		КонецЕсли;
		//
	ИначеЕсли ТипЗнч(ЗначениеПараметра) = Тип("МоментВремени") Тогда
		ДатаПараметра = ЗначениеПараметра.Дата;
	Иначе
		ДатаПараметра = '00010101';
	КонецЕсли;
	
	Возврат ДатаПараметра
	
КонецФункции

// Возвращает массив счетов для использования в условиях запросов, отборах, параметрах выбора и пр.
// По умолчанию возвращает массив счетов со всеми подчиненными субсчетами.
//
// Параметры:
//  Счета - Строка, Массив, СписокЗначений, ПланСчетовСсылка - счета, заданные списком кодов, ссылок или иным способом.
//  НаДату - Дата - дата актуальности, если необходимо получить список только актуальных счетов.
//  БезУчетаИерархии - Булево - признак исключения подчиненных счетов из итогового списка.
// 
// Пример:
//	ЗаполнениеОтчетности.СписокСчетов("206.00, 302.00")
//	ЗаполнениеОтчетности.СписокСчетов("101.27, 101.37", Объект.Дата)
// 
// Возвращаемое значение:
//  Массив - массив ссылок на счета плана счетов "ЕПСБУ".
//
Функция ПолучитьМассивСчетов(Счета, НаДату = Неопределено, БезУчетаИерархии = Ложь) Экспорт

	Возврат БухгалтерскийУчет.СписокСчетов(Счета, НаДату, БезУчетаИерархии);

КонецФункции

Функция ПреобразоватьКонецПериода(КонецПериода) Экспорт
	Перем ДатаПараметра;
	Если ТипЗнч(КонецПериода) = Тип("Дата") Тогда
		ДатаПараметра = Новый Граница(КонецПериода,ВидГраницы.Включая);
	ИначеЕсли ТипЗнч(КонецПериода) = Тип("Граница") Тогда
		ДатаПараметра = КонецПериода;
	Иначе
		ДатаПараметра = КонецПериода;
	КонецЕсли;
	
	Возврат ДатаПараметра
	
КонецФункции

Функция ДобавитьЗаписьВКартуДанных(АдресКарты, СтрокаРесурсов, ЗначениеР1 = Неопределено, ЗначениеР2 = Неопределено, ЗначениеР3 = Неопределено, ЗначениеР4 = Неопределено, ЗначениеР5 = Неопределено,
								ЗначениеР6 = Неопределено, ЗначениеР7 = Неопределено, ЗначениеР8 = Неопределено, ЗначениеР9 = Неопределено, ЗначениеР10 = Неопределено,
								СтрокаИзмерений, Значение1 = Неопределено, Значение2 = Неопределено, Значение3 = Неопределено, Значение4 = Неопределено, Значение5 = Неопределено,							
								Значение6 = Неопределено, Значение7 = Неопределено, Значение8 = Неопределено, Значение9 = Неопределено, Значение10 = Неопределено,
								ИмяКлюча = "",Ключ = Неопределено) Экспорт
								
								
	КартаДанных = ЗаполнениеОтчетностиСерверПовтИсп.ПолучитьИзВременногоХранилищаПовтИсп(АдресКарты);
	
	Если ТипЗнч(КартаДанных) <> Тип("ТаблицаЗначений") Тогда
		
		ТекстОшибки = НСтр("ru = 'Не удалось получить значение карты данных при вычислении значения вычисляемого поля'");
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	СтруктураЗИ = Новый Структура("Значение1,Значение2,Значение3,Значение4,Значение5,Значение6,Значение7,Значение8,Значение9,Значение10",
		Значение1,Значение2,Значение3,Значение4,Значение5,Значение6,Значение7,Значение8,Значение9,Значение10);							
								
	СтруктураЗР = Новый Структура("ЗначениеР1,ЗначениеР2,ЗначениеР3,ЗначениеР4,ЗначениеР5,ЗначениеР6,ЗначениеР7,ЗначениеР8,ЗначениеР9,ЗначениеР10",
		ЗначениеР1,ЗначениеР2,ЗначениеР3,ЗначениеР4,ЗначениеР5,ЗначениеР6,ЗначениеР7,ЗначениеР8,ЗначениеР9,ЗначениеР10);							

	
	ПараметрыПоиска = Новый Структура;
	
	МассивИзмерений = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаИзмерений);
	
	КоличествоИзмерений = ?(МассивИзмерений.Количество() > 10, 10, МассивИзмерений.Количество());
	
	СтрокаИндексов = "";
	Для ном = 1 По КоличествоИзмерений Цикл		
		ПараметрыПоиска.Вставить(МассивИзмерений[ном - 1], СтруктураЗИ["Значение"+ном]);
		ТекКолонка = КартаДанных.Колонки.Найти(МассивИзмерений[ном - 1]);
		Если ТекКолонка = Неопределено Тогда
			КартаДанных.Колонки.Добавить(МассивИзмерений[ном - 1]);
			ИмяКолонки = МассивИзмерений[ном - 1];
		Иначе
			ИмяКолонки = ТекКолонка.Имя;
		КонецЕсли;
		СтрокаИндексов = СтрокаИндексов + ", "+ИмяКолонки;
	КонецЦикла;
	СтрокаИндексов = Сред(СтрокаИндексов,3);
	
	ПараметрыРесурсов = Новый Структура;
	
	МассивРесурсов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаРесурсов);
	КоличествоРесурсов = ?(МассивРесурсов.Количество() > 10, 10, МассивРесурсов.Количество());
	
	Для ном = 1 По КоличествоРесурсов Цикл
		
		ПараметрыРесурсов.Вставить(МассивРесурсов[ном - 1], СтруктураЗР["ЗначениеР"+ном]);
		
	КонецЦикла;
	
	НуженИндекс = Истина;
	Для Каждого ТекИндекс Из КартаДанных.Индексы Цикл
		Если Строка(ТекИндекс) = СтрокаИндексов Тогда
			НуженИндекс = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если НуженИндекс Тогда
		КартаДанных.Индексы.Добавить(СтрокаИндексов);
	КонецЕсли;
	
	НайденныеСтроки = КартаДанных.НайтиСтроки(ПараметрыПоиска);							
								
	Если НайденныеСтроки.Количество() > 0 Тогда
		
		ТекСтрока = НайденныеСтроки[0];
		
		Если ЗначениеЗаполнено(ИмяКлюча) И ТипЗнч(ТекСтрока[ИмяКлюча]) = Тип("Массив") Тогда
			Если ТекСтрока[ИмяКлюча].Найти(Ключ) = Неопределено Тогда
				Для Каждого КлючИЗначение Из ПараметрыРесурсов Цикл
					ТекСтрока[КлючИЗначение.Ключ]=ТекСтрока[КлючИЗначение.Ключ]+КлючИЗначение.Значение;
				КонецЦикла;
				ТекСтрока[ИмяКлюча].Добавить(Ключ);
			КонецЕсли;
		Иначе
			Для Каждого КлючИЗначение Из ПараметрыРесурсов Цикл
				ТекСтрока[КлючИЗначение.Ключ]=ТекСтрока[КлючИЗначение.Ключ]+КлючИЗначение.Значение;
			КонецЦикла;
			Если ЗначениеЗаполнено(ИмяКлюча) Тогда
				ТекСтрока[ИмяКлюча] = Новый Массив;
				ТекСтрока[ИмяКлюча].Добавить(Ключ);
			КонецЕсли;
		КонецЕсли; 
		
		
		//ЗаполнитьЗначенияСвойств(ТекСтрока,ПараметрыРесурсов);
	Иначе
		ТекСтрока = КартаДанных.Добавить();
		ЗаполнитьЗначенияСвойств(ТекСтрока,ПараметрыПоиска);
		ЗаполнитьЗначенияСвойств(ТекСтрока,ПараметрыРесурсов);
		Если ЗначениеЗаполнено(ИмяКлюча) Тогда
			ТекСтрока[ИмяКлюча] = Новый Массив;
			ТекСтрока[ИмяКлюча].Добавить(Ключ);
		КонецЕсли;
	КонецЕсли;
	
	ПоместитьВоВременноеХранилище(КартаДанных,АдресКарты);
	
	Возврат Истина;
	
КонецФункции

Функция РассчитатьИзменениеЗадолженности(ВидЗадолженности,ВариантРасчета,Знач ОстатокДН=0,Знач ОстатокКН=0,Знач ОстатокДК=0,Знач ОстатокКК=0,Знач ДенДт=0,Знач НеДенДт=0,Знач ДенКт=0,Знач НеДенКт=0,НужноеПоле) Экспорт
	//ВидЗадолженности = "Дебиторская" или "Кредиторская"
	//ВариантРасчета = приоритет заполнения формы - "Дебиторская" или "Кредиторская"
	//Если вариант расчета совпадает с видом, то текущая форма ВидаЗадолженности уменьшиться на измениение противоположной формы.
	
	ТекСтр = Новый Структура;
	ТекСтр.Вставить("ОстатокДН",ОстатокДН);
	ТекСтр.Вставить("ОстатокКН",ОстатокКН);
	ТекСтр.Вставить("ОстатокДК",ОстатокДК);
	ТекСтр.Вставить("ОстатокКК",ОстатокКК);
	
	ТекСтр.Вставить("ДенДт",ДенДт);
	ТекСтр.Вставить("ДенКт",ДенКт);
	ТекСтр.Вставить("НеДенДт",НеДенДт);
	ТекСтр.Вставить("НеДенКт",НеДенКт);
	
	ИсхСтр = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ТекСтр);
	
	Если ВариантРасчета = "Дт" Тогда
	
		Если (ИсхСтр.ОстатокКН=0 И ИсхСтр.ОстатокКК = 0) 
			Или (ИсхСтр.ОстатокКН=ИсхСтр.ОстатокКК) Тогда
			//все обороты отражаем в форме по дебиторской задолженности
			
			Если ВидЗадолженности = "Кредиторская" Тогда
				//Очистим обороты Кредиторской
				ТекСтр.ДенДт = 0;
				ТекСтр.ДенКт = 0;
				ТекСтр.НеДенДт = 0;
				ТекСтр.НеДенКт = 0;
			КонецЕсли;
			
		Иначе  				
			// ОстатокКН<>0 или ОстатокКК <> 0, то 				
			Если ИсхСтр.ОстатокКК > ИсхСтр.ОстатокКН Тогда 				
				//кредиторка могла увеличиться прежде всего за счет неденежных кредитовых оборотов, 
				//затем - денежных, затем отрицательных дебетовых оборотов (сначала - неденежных, затем денежных)
				
				//Исправить так:
				//1) ДенКт
				//2) НеДенКт
				//3) затем отрицательных дебетовых оборотов (сначала - неденежных, затем денежных)
				Если ИсхСтр.ДенКт>=(ИсхСтр.ОстатокКК-ИсхСтр.ОстатокКН) тогда
					Если ВидЗадолженности = "Кредиторская" Тогда
						//В форме по кредиторской задолженности отражаем (ОстатокКК-ОстатокКН) в недежных расчетах в кредитовых оборотах
						ТекСтр.ДенКт= ИсхСтр.ОстатокКК-ИсхСтр.ОстатокКН;
						ТекСтр.ДенДт = 0;
						ТекСтр.НеДенКт = 0;
						ТекСтр.НеДенДт = 0;
					ИначеЕсли ВидЗадолженности = "Дебиторская" Тогда
						//В форме по дебиторской задолженности отражаем уменьшение кредитовых оборотов на (ОстатокКК-ОстатокКН) в недежных расчетах 
						ТекСтр.ДенКт= ИсхСтр.ДенКт - (ИсхСтр.ОстатокКК-ИсхСтр.ОстатокКН);
					КонецЕсли;
										
				Иначе		
					//1) За счет недежных кт
					// Т.к. только кредитовых оборотов не хватает на увеличение кредиторской задолженности,
					// то в форме по кредиторской задолженности отражаем НеДенКт в недежных расчетах в кредитовых оборотах,
					// а в дебиторской НеДенКт будет 0.
					
					
					Если ВидЗадолженности = "Кредиторская" Тогда	
						//ТекСтр.ДенКт= ТекСтр.ДенКт; //не меняем
					ИначеЕсли ВидЗадолженности = "Дебиторская" Тогда
						ТекСтр.ДенКт= 0;
					КонецЕсли;
					
					//2) За счет дежных кт	
					Если ИсхСтр.НеДенКт>=(ИсхСтр.ОстатокКК-ИсхСтр.ОстатокКН-ИсхСтр.ДенКт) тогда	
						//В форме по кредиторской задолженности отражаем (ОстатокКК-ОстатокКН-НеДенКт) в дежных расчетах в кредитовых оборотах
						
						Если ВидЗадолженности = "Кредиторская" Тогда	
							//В форме по кредиторской задолженности отражаем (ОстатокКК-ОстатокКН-НеДенКт) в дежных расчетах в кредитовых оборотах
							ТекСтр.НеДенКт= (ИсхСтр.ОстатокКК-ИсхСтр.ОстатокКН-ИсхСтр.ДенКт);
							ТекСтр.ДенДт = 0;
							ТекСтр.НеДенДт = 0;
						ИначеЕсли ВидЗадолженности = "Дебиторская" Тогда
							//В форме по дебиторской задолженности отражаем уменьшение кредитовых денежных на сумму, отражаемую в кредиторской форме
							ТекСтр.НеДенКт=ИсхСтр.НеДенКт-(ИсхСтр.ОстатокКК-ИсхСтр.ОстатокКН-ИсхСтр.ДенКт);
						КонецЕсли;
												
					Иначе
						// Т.к. только кредитовых оборотов не хватает на увеличение кредиторской задолженности,
						// то в форме по кредиторской задолженности отражаем ДенКт в дежных расчетах в кредитовых оборотах,
						// а в дебиторской ДенКт будет 0.
						
						Если ВидЗадолженности = "Кредиторская" Тогда	
							//ТекСтр.НеДенКт= ТекСтр.НеДенКт; //не меняем
						ИначеЕсли ВидЗадолженности = "Дебиторская" Тогда
							ТекСтр.НеДенКт= 0;
						КонецЕсли;
						
						//3) за счет отрицательных оборотов недежных Дт
						
						Если ИсхСтр.НеДенДт<0 Тогда		
							Если -ИсхСтр.НеДенДт>=(ИсхСтр.ОстатокКК-ИсхСтр.ОстатокКН-ИсхСтр.НеДенКт-ИсхСтр.ДенКт) Тогда	
																
								Если ВидЗадолженности = "Кредиторская" Тогда	
									//В форме по кредиторской задолженности отражаем (ОстатокКК-ОстатокКН-НеДенКт-ДенКт) со знаком минус в недежных расчетах в дебетовых оборотах
									ТекСтр.НеДенДт= -(ИсхСтр.ОстатокКК-ИсхСтр.ОстатокКН-ИсхСтр.НеДенКт-ИсхСтр.ДенКт);
									ТекСтр.ДенДт = 0;
								ИначеЕсли ВидЗадолженности = "Дебиторская" Тогда
									//В форме по дебиторской задолженности отражаем уменьшение дебетовых неденежных на сумму, отражаемую в кредиторской форме
									ТекСтр.НеДенДт=ИсхСтр.НеДенДт+(ИсхСтр.ОстатокКК-ИсхСтр.ОстатокКН-ИсхСтр.НеДенКт-ИсхСтр.ДенКт);
								КонецЕсли;
																
							Иначе
								// Т.к. только не денежных оборотов не хватает на увеличение кредиторской задолженности,
								// то в форме по кредиторской задолженности отражаем НеДенДт в дежных расчетах в кредитовых оборотах,
								// а в дебиторской НеДенДт будет 0.
								
								//4) дополняем денежными Дт
								Если ВидЗадолженности = "Кредиторская" Тогда
									//В форме по кредиторской задолженности отражаем НеДенДт в недежных расчетах в дебетовых оборотах
									//ТекСтр.НеДенДт= ТекСтр.НеДенДт; //не меняем
									
									//В форме по кредиторской задолженности отражаем (ОстатокКК-ОстатокКН-НеДенКт-ДенКт+НеДенДт) со знаком минус в дежных расчетах в дебетовых оборотах
									ТекСтр.ДенДт = -(ИсхСтр.ОстатокКК-ИсхСтр.ОстатокКН-ИсхСтр.НеДенКт-ИсхСтр.ДенКт+ИсхСтр.НеДенДт);
								ИначеЕсли ВидЗадолженности = "Дебиторская" Тогда
									ТекСтр.НеДенДт= 0;
									
									ТекСтр.ДенДт=ИсхСтр.ДенДт+(ИсхСтр.ОстатокКК-ИсхСтр.ОстатокКН-ИсхСтр.НеДенКт-ИсхСтр.ДенКт+ИсхСтр.НеДенДт);
								КонецЕсли;	
							КонецЕсли	
						Иначе
							Если ВидЗадолженности = "Кредиторская" Тогда	
								//В форме по кредиторской задолженности отражаем (ОстатокКК-ОстатокКН-НеДенКт-ДенКт) со знаком минус в дежных расчетах в дебетовых оборотах	
								ТекСтр.ДенДт= -(ИсхСтр.ОстатокКК-ИсхСтр.ОстатокКН-ИсхСтр.НеДенКт-ИсхСтр.ДенКт);
								ТекСтр.НеДенДт= 0;
							ИначеЕсли ВидЗадолженности = "Дебиторская" Тогда
								//В форме по дебиторской задолженности отражаем уменьшение дебетовых неденежных на сумму, отражаемую в кредиторской форме
								ТекСтр.ДенДт=ИсхСтр.ДенДт+(ИсхСтр.ОстатокКК-ИсхСтр.ОстатокКН-ИсхСтр.НеДенКт-ИсхСтр.ДенКт);
							КонецЕсли;
						КонецЕсли;		
					КонецЕсли;			
				КонецЕсли;				
			Иначе		
