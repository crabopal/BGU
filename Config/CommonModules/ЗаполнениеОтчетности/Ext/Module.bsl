	КонецЕсли;
	
	Возврат ТекСтр[НужноеПоле];
	
КонецФункции

Функция СвернутьКартуДанных(АдресКарты, СтрокаИзмерений, СтрокаРесурсов) Экспорт
	
	КартаДанных = ЗаполнениеОтчетностиСерверПовтИсп.ПолучитьИзВременногоХранилищаПовтИсп(АдресКарты);
	
	Если ТипЗнч(КартаДанных) <> Тип("ТаблицаЗначений") Тогда
		
		ТекстОшибки = НСтр("ru = 'Не удалось получить значение карты данных при вычислении значения вычисляемого поля'");
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	КартаДанных.Свернуть(СтрокаИзмерений,СтрокаРесурсов);
	
	ПоместитьВоВременноеХранилище(КартаДанных,АдресКарты);
	
	Возврат Истина;
	
КонецФункции

Функция ГлаваПоБКОрганизации(Знач Организация, Знач ИФО) Экспорт

	Возврат БюджетнаяОтчетностьПолучениеНСИ.ГлаваПоБКПолучательОтчета(Организация,ИФО);
	
КонецФункции

// Получает контрагента, соответствующего организации по ИНН, КПП, Бюджету
//
// Параметры
//  Организация - СправочникСсылка.Организации
//  СоздаватьКонтрагента - булево - Истина - если контрагента нет, то будет создан, Ложь - контрагент создан не будет
//
// Возвращаемое значение:
//   СправочникСсылка.Контрагенты - найденный контрагент. Если не найден, возвращается пустая ссылка.
//
Функция ПолучитьКонтрагентаПоОрганизации(Знач Организация,Знач СоздаватьКонтрагента = Ложь, РезультатСтруктурой = Истина) Экспорт
	

	Возврат ЗаполнениеОтчетностиПовтИсп.ВернутьКонтрагентаПоОрганизации(Организация,СоздаватьКонтрагента,РезультатСтруктурой);	

				
КонецФункции

// Определяет, что Значение1 находится в иерархии Значения2
//
// Параметры
//  Значение1 - Любой тип
//  Значение2 - Любой тип
//
// Возвращаемое значение:
//   Истина   - Значение1 находится в иерархии Значения2
//
Функция ВИерархии(Значение1, Значение2) Экспорт
	
	Тип1 = ТипЗнч(Значение1);
	Тип2 = ТипЗнч(Значение2);
	
	Если Тип1 <> Тип2 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СтрокаТипа = ЗаполнениеОтчетности.ВернутьСтрокуТипаПоТипу(ТипЗнч(Значение2), "Запрос");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Таблица.Ссылка
		|ИЗ
		|	%1 КАК Таблица
		|ГДЕ
		|	Таблица.Ссылка = &Значение1
		|	И Таблица.Ссылка В ИЕРАРХИИ(&Значение2)";
		
	Запрос.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Запрос.Текст, СтрокаТипа);
		
	Запрос.УстановитьПараметр("Значение1", Значение1);
	Запрос.УстановитьПараметр("Значение2", Значение2);
	
	Результат = Запрос.Выполнить();
	
	Возврат НЕ Результат.Пустой();
	
КонецФункции

// Определяет, что Значение1 принадлежит коллекции Значения2
//
// Параметры
//  Значение1 - Любой тип
//  Значение2 - Любой тип, Массив или Список значений
//
// Возвращаемое значение:
//   Истина   - Значение1 принадлежит коллекции Значения2
//
Функция ВСписке(Значение1, Значение2) Экспорт
	
	Тип1 = ТипЗнч(Значение1);
	Тип2 = ТипЗнч(Значение2);
	
	Коллекция = Новый СписокЗначений();
	
	Если Тип2 = Тип("Массив") Тогда
		Коллекция.ЗагрузитьЗначения(Значение2);
	ИначеЕсли Тип2 = Тип("СписокЗначений") Тогда
		Коллекция.ЗагрузитьЗначения(Значение2.ВыгрузитьЗначения());
	Иначе
		Коллекция.Добавить(Значение2);
	КонецЕсли;
	
	Возврат Коллекция.НайтиПоЗначению(Значение1) <> Неопределено;
	
КонецФункции

// Получает значения реквизита у переданного по ссылке объекта информационной базы
//
// Параметры
//  Ссылка - Ссылочный тип
//  ИмяРеквизита - Строка с разделителями ".", определяющая путь до реквизита
//
// Возвращаемое значение:
//   Значение реквизита  - если есть такой реквизит
//   Неопределено  - если такого реквизита нет
//
Функция ЗначениеРеквизита(Знач Ссылка,Знач ИмяРеквизита) Экспорт

	Возврат ЗаполнениеОтчетностиПовтИсп.ЗначениеРеквизита(Ссылка,ИмяРеквизита);
	
КонецФункции

// Получает значение аналитики валюта по коду справочника валюты
//
// Параметры
//  КодВалюты - Строка, код валюты
//
// Возвращаемое значение:
//   Ссылка на справочник "Субконто"
//
Функция ПолучитьАналитикуВалютаПоКоду(Знач КодВалюты) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Субконто.Ссылка КАК Валюта
		|ИЗ
		|	Справочник.Субконто КАК Субконто
		|ГДЕ
		|	ВЫРАЗИТЬ(Субконто.Владелец КАК ПланВидовХарактеристик.АналитикаОтчетов).ПубличныйИдентификатор = ""urn:entities-1c-ru:currency""
		|	И Субконто.Код = &Код";
	
	Запрос.УстановитьПараметр("Код", КодВалюты);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		
		Возврат Неопределено;
		
	Иначе
		
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		
		Возврат Выборка.Валюта;
		
	КонецЕсли;
	
КонецФункции

// Получает элемент произвольного классификатора по коду вида аналитики
// Если элемент не найден, то создается новый элемент с указанным наименованием.
// Новые элементы создаются в транзакции, устанавливает блокировку на справочник "Субконто"
//
// Параметры
//  КодКлассификатора - Строка, код искомого элемента произвольного классификатора
//  КодАналитикиОтчетов - Строка, код аналитики отчета
//  НаименованиеКлассификатора - Строка, наименование создаваемого элемента произвольного классификатора
//                             - Если не указано, то в качестве наименования используется код
//  ЗначениеПоУмолчанию - Значение возвращаемое если элемент с указанным кодом не найден
//                      - Если не задано, то возвращается Неопределено
//
// Возвращаемое значение:
//   Ссылка на справочник "Субконто" - если есть такой элемент или если он создан
//   ЗначениеПоУмолчанию  - если нет возможности найти или создать элемент
//   При возникновении исключительной ситуации при создании элемента вызывает исключение
//
Функция ПолучитьКлассификаторПоКлючу(Знач КодКлассификатора, Знач КодАналитикиОтчетов, Знач НаименованиеКлассификатора = "", Знач ЗначениеПоУмолчанию = Неопределено, РезультатСтруктурой = Истина, АктуализироватьНаименование = Ложь) Экспорт
	

	Возврат ЗаполнениеОтчетностиПовтИсп.ВернутьКлассификаторПоКлючу(КодКлассификатора,КодАналитикиОтчетов,НаименованиеКлассификатора,ЗначениеПоУмолчанию,РезультатСтруктурой,АктуализироватьНаименование);	

	
КонецФункции

// Получает код организации или контрагента, такие как ИНН, КПП, УБП, ОКПО и пр.
//
// Параметры
// Ссылка - Ссылка на справочник "Контрагенты" или "Организации"
// Код - Строка, код реквизита
//     - Допустимые значения: "ИНН", "КПП", "КодПоРПБС", "КодПоППП", 
//                            "КодОКАТО", "ОКПО", "ОКАТО", "УБП", "КодУБП",
//                            "КодРПБС", "ППП", "КонтрагентПППБюджет", "КонтрагентПППЭлементБюджета"
// ЗначениеПоУмолчанию - Значение возвращаемое если передано значение отличное от типов "Контрагенты" или "Организации"
//                     - или значение указанного кода не найдено. Если не задано, то возвращается Неопределено;
//
// Возвращаемое значение:
//  Значение Кода (без преобразовани типа) - если код найден
//  ЗначениеПоУмолчанию - если код не найден
//
Функция ПолучитьКод(Знач Ссылка, Знач Код, Знач ЗначениеПоУмолчанию = Неопределено) Экспорт
	
	ТипЗначения = ТипЗнч(Ссылка);
	
	Если (ТипЗначения <> Тип("СправочникСсылка.Контрагенты") И ТипЗначения <> Тип("СправочникСсылка.Организации")) Тогда
		
		Возврат ЗначениеПоУмолчанию;
		
	Иначе
		
		Если Код = "КонтрагентПППБюджет" И ТипЗначения = Тип("СправочникСсылка.Контрагенты") Тогда
			
			ИскомыйРеквизит = "КодПоППП.Бюджет";
			Если ЗаполнениеОтчетности.ТекущаяКонфигурация() = "БГУ2" Тогда
				ИскомыйРеквизит = "ЮридическоеФизическоеЛицо."+ИскомыйРеквизит;
			КонецЕсли;
			
			Возврат ЗаполнениеОтчетности.ЗначениеРеквизита(Ссылка, ИскомыйРеквизит);
			
		ИначеЕсли Код = "КонтрагентПППЭлементБюджета" И ТипЗначения = Тип("СправочникСсылка.Контрагенты") Тогда
			
			ИскомыйРеквизит = "КодПоППП.Бюджет.Элемент";
			Если ЗаполнениеОтчетности.ТекущаяКонфигурация() = "БГУ2" Тогда
				ИскомыйРеквизит = "ЮридическоеФизическоеЛицо."+ИскомыйРеквизит;
			КонецЕсли;
			
			Возврат ЗаполнениеОтчетности.ЗначениеРеквизита(Ссылка, ИскомыйРеквизит);
			
		ИначеЕсли Код = "ОКОПФ" Тогда
			
			Если ТипЗначения = Тип("СправочникСсылка.Контрагенты") Тогда
				
				ЗначениеОКОПФ = ПолучитьХарактеристикуКонтрагента(Ссылка,"КодПоОКОПФ");
				Если ЗначениеЗаполнено(ЗначениеОКОПФ) Тогда
					Возврат СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗначениеОКОПФ,"Код"));
				Иначе
					Возврат "";
				КонецЕсли;
				
			Иначе
				Возврат СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка,"КодКОПФ.Код"));
			КонецЕсли;
			
		Иначе
			
			Попытка
				Код = БюджетнаяОтчетностьПолучениеНСИ.ПолучитьКод(Ссылка, Код, Ложь);
			Исключение
				Возврат ЗначениеПоУмолчанию;
			КонецПопытки;
			
		КонецЕсли;
		
		Если ПустаяСтрока(Код) Тогда
			Возврат ЗначениеПоУмолчанию;
		Иначе
			Возврат Код;
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции

// Получает наименование организации или контрагента. Возвращает значения НаименованиеПолное, если оно не заполнено, то возвращается Наименование
//
// Параметры
//  Ссылка - Ссылка на справочник "Контрагенты" или "Организации"
//  ПриоритетСокращенногоНаименования - Булево. Установка в Истина указывает что необходимо вернуть сокращенное наименование
//                                    - если оно не задано, то обрабатываются прочие реквизиты. По умолчанию - Ложь;
//  ЗначениеПоУмолчанию - Значение возвращаемое при невозможности получения наименования
//
// Возвращаемое значение:
//  Строка, ОфициальноеНаименование
//  ЗначениеПоУмолчанию - при невозможности получения наименования
//
Функция ПолучитьОфициальноеНаименование(Знач Ссылка, Знач ПриоритетСокращенного = Неопределено, Знач ЗначениеПоУмолчанию = Неопределено) Экспорт
	
	ТипЗначения = ТипЗнч(Ссылка);
	
	Если (ТипЗначения <> Тип("СправочникСсылка.Контрагенты") И ТипЗначения <> Тип("СправочникСсылка.Организации"))
		ИЛИ (ПриоритетСокращенного <> Неопределено И ТипЗнч(ПриоритетСокращенного) <> Тип("Булево")) Тогда
		
		Возврат ЗначениеПоУмолчанию;
		
	Иначе
		
		Попытка
			ОфициальноеНаименование = БюджетнаяОтчетностьПолучениеНСИ.ОфициальноеНаименование(Ссылка, ПриоритетСокращенного);
		Исключение
			Возврат ЗначениеПоУмолчанию;
		КонецПопытки;
		
		Если ПустаяСтрока(ОфициальноеНаименование) Тогда
			Возврат ЗначениеПоУмолчанию;
		Иначе
			Возврат ОфициальноеНаименование;
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции

// Получает реквизита договора
//
// Параметры:
//  ДоговорСсылка - Ссылка на договор
//  РеквизитДоговора - Строка. Возможные варианты значений: "Окончание" - получение даты окончания договора,
//                                                          "Просрочен" - получение признака просроченности договора,
//                                                          "КрупнаяСделка" - получение признака, что договор является крупной сделкой,
//                                                          "СделкаСЗаинт" - получение признака, что договор является сделкой с заинтересованностью,
//                                                          "УчетныйНомерОбязательства" - получение значения из регистра сведений УчетныеНомераОбязательств,
//                                                          "КОФК" - получение кода ОФК из регистра сведений СрокиИсполненияИСуммыОбязательств,
//                                                          "СуммаПоДоговору" - получение суммы по договору из регистра СрокиИсполненияИСуммыОбязательств,
//                                                          "ЛьготнаяАренда" - получение признака, что по договору оказываются услуги аренды на льготных условиях.
//  ЗначениеНеопределено - Значение возвращаемое если элемент с указанным реквизитом договора не найден. Если не задано, то возвращается Неопределено;
//  Период - Дата, на которую получаются значения
//
// Возвращаемое значение:
//  Значение реквизита без преобразования типа
//  ЗначениеНеопределено - если передан реквизит договора кроме указанных выше
//
Функция ПолучитьРеквизитДоговора(Знач ДоговорСсылка, Знач РеквизитДоговора, Знач ЗначениеНеопределено = Неопределено, Период = Неопределено) Экспорт
	
	Возврат ЗаполнениеОтчетностиСерверПереопределяемый.ПолучитьРеквизитДоговора(ДоговорСсылка,РеквизитДоговора,ЗначениеНеопределено,Период);
		
КонецФункции

// Получает строковое представление типа переданного значения
//
// Параметры:
//  Значение - Проверяемое значение
//  Режим - Вид возвращаемого типа. Возможнве значения: "" - тип ссылки на объект,
//                                                      "Менеджер" - тип менеджера объекта,
//                                                      "Запрос" - тип для использования в запросе;
//
// Возвращаемое значение:
//  Строка, строкове представление типа в зависимости от режима
//
Функция ПолучитьТипЗначенияСтрокой(Ссылка, Знач Режим = "") Экспорт
	
	ТекТип = ТипЗнч(Ссылка);
	
	Если ТекТип = Неопределено ИЛИ ТекТип = Тип("Неопределено") ИЛИ ТекТип = Тип("Null") Тогда
		
		Возврат "";
		
	Иначе
		
		Возврат ЗаполнениеОтчетности.ВернутьСтрокуТипаПоТипу(ТекТип , Режим);
		
	КонецЕсли;
	
КонецФункции

// Получения значения дополнительной характеристики договора по коду вида аналитики
//
// Параметры:
//  ДоговорСсылка - Ссылка на договор
//  ВидХарактеристики - Код вида характеристики
//  Период - Дата на которую необходимо получить значение характеристики
//  ЗначениеПоУмолчанию - Значение возвращаемое если характеристика не найдена. Если не задано, то возвращается Неопределено
//
// Возвращаемое значение:
//  Значение реквизита без преобразования типа
//  ЗначениеНеопределено - если нет возможности получить характеристику
//
Функция ПолучитьХарактеристикуДоговора(Знач ДоговорСсылка, Знач ВидХарактеристики, Знач Период, Знач ЗначениеНеопределено = Неопределено) Экспорт
	
	Если ТипЗнч(Период) <> Тип("Дата") ИЛИ ПустаяСтрока(ВидХарактеристики) ИЛИ ТипЗнч(ДоговорСсылка) <> Тип("СправочникСсылка.Договоры") Тогда
		
		Возврат ЗначениеНеопределено;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	

	Запрос.Текст = 	
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ХарактеристикиОбязательствСрезПоследних.ЗначениеХарактеристики КАК ЗначениеХарактеристики
		|ИЗ
		|	РегистрСведений.ХарактеристикиОбязательств.СрезПоследних(
		|			&Период,
		|			Договор = &Договор
		|				И ВидХарактеристики.Код = &ВидХарактеристики) КАК ХарактеристикиОбязательствСрезПоследних";		
		

	
	Запрос.УстановитьПараметр("ВидХарактеристики", ВидХарактеристики);
	Запрос.УстановитьПараметр("Договор", ДоговорСсылка);
	Запрос.УстановитьПараметр("Период", Период);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		
		Возврат ЗначениеНеопределено;
		
	Иначе
		
		ВыборкаДетальныеЗаписи = Результат.Выбрать();
		ВыборкаДетальныеЗаписи.Следующий();
		
		Возврат ВыборкаДетальныеЗаписи.ЗначениеХарактеристики;
		
	КонецЕсли;
	
КонецФункции

Функция ПолучитьХарактеристикуКонтрагента(Знач КонтрагентСсылка, Знач ВидХарактеристики, Знач ЗначениеНеопределено = Неопределено) Экспорт
	
	Если ПустаяСтрока(ВидХарактеристики) ИЛИ ТипЗнч(КонтрагентСсылка) <> Тип("СправочникСсылка.Контрагенты") Тогда
		
		Возврат ЗначениеНеопределено;
		
	КонецЕсли;
	

	//Проверим реквизит
	ЗначениеРеквизита = ЗаполнениеОтчетностиСерверПереопределяемый.ПолучитьЗначениеДополнительногоРеквизитаСправочника(КонтрагентСсылка,ВидХарактеристики);
	
	Если ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
		Возврат ЗначениеРеквизита;
	КонецЕсли;
	
	//Проверим доп. сведение
	ЗначениеСведения = ЗаполнениеОтчетностиСерверПереопределяемый.ПолучитьЗначениеДополнительныхСведений(КонтрагентСсылка,ВидХарактеристики);
	
	Возврат ЗначениеСведения;


КонецФункции

// Определяет, что документ предназначен для формирования операции по закрытию финансового года:
//      Закрытие балансовых счетов в конце года,
//      Закрытие счетов санкционирования завершаемого финансового года,
//      Закрытие забалансовых счетов поступления и выбытия денежных средств,
//      Перенос остатков по забалансовым счетам,
//      Перенос остатков по счетам ОС,
//      Перенос остатков по счетам МЗ,
//      Перенос остатков по счетам расчетов.
//
// Параметры:
//  Ссылка - Любая ссылка
//
// Возвращаемое значение:
//  Истина - если передана ссылка на документ закрытие
//
Функция ЭтоДокументЗакрытие(Знач Ссылка) Экспорт
	
	ТипДокумента = ТипЗнч(Ссылка);
		
	МассивДокументовЗакрытие = ЗаполнениеОтчетностиПовтИсп.ПолучитьМассивТиповДокументовЗакрытияГода();
		
	Если МассивДокументовЗакрытие.Найти(ТипДокумента) = Неопределено Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

