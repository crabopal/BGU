// Проверяет, соответствует ли указанное значение параметру.
//      Если параметр - список значений или массив, то при пустом параметре результат проверки положительный.
//      Если параметр - значение ссылочного типа, то при незаполненном значении результат проверки положительный.
//
// Параметры:
//  ПроверяемоеЗначение - Значение, которое следует проверить на вхождение в коллекцию или соответствие значению параметра.
//  ПараметрНастройки - Список значений, Массив или значение ссылочного типа, с которым выполняется сверка.
//
// Возвращаемое значение:
//  Истина - если значение соответствует параметру
//
Функция ПроверитьЗначениеПоПараметру(ПроверяемоеЗначение, ПараметрНастройки) Экспорт
	
	ЗначениеНайдено = Ложь;
	
	ТипПарамера = ТипЗнч(ПараметрНастройки);
	Если ТипПарамера = Тип("СписокЗначений") Тогда
		
		Если ПараметрНастройки.Количество() > 0 Тогда
			ЗначениеНайдено = ПараметрНастройки.НайтиПоЗначению(ПроверяемоеЗначение) <> Неопределено;
		Иначе
			ЗначениеНайдено = Истина;
		КонецЕсли;
		
	ИначеЕсли ТипПарамера = Тип("Массив") Тогда
		
		Если ПараметрНастройки.Количество() > 0 Тогда
			ЗначениеНайдено = ПараметрНастройки.Найти(ПроверяемоеЗначение) <> Неопределено;
		Иначе
			ЗначениеНайдено = Истина;
		КонецЕсли;
		
	Иначе
		Если ЗначениеЗаполнено(ПараметрНастройки) Тогда
			ЗначениеНайдено = ПараметрНастройки = ПроверяемоеЗначение;
		Иначе
			ЗначениеНайдено = Истина;
		КонецЕсли;	
	КонецЕсли;
	
	Возврат ЗначениеНайдено;
	
КонецФункции

