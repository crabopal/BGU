// Проверяет, что реквизит "СчетУчета" равен значению в ключе локального кэша формы, если ключ есть в кэше.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения:
//    * Объект - ДанныеФормыСтруктура:
//      ** СчетУчета - ПланСчетовСсылка.ЕПСБУ
//    * КэшПараметров - Структура:
//      ** Локальные - Структура:
//        *** Счет108 - ПланСчетовСсылка.ЕПСБУ
//  ИмяКлючаЛокальногоКэша - Строка
// 
// Возвращаемое значение:
//  Булево - 
Функция СчетУчетаРавенЗначению(Форма, ИмяКлючаЛокальногоКэша) Экспорт
	Возврат Форма.Объект.СчетУчета = ОбщегоНазначенияБГУКлиентСервер.СвойствоЛокальногоКэшаФормы(Форма, ИмяКлючаЛокальногоКэша);
КонецФункции

// Обязательность заполнения реквизита.
// 
// Параметры:
//  Объект - ДокументОбъект
//         - ДанныеФормыСтруктура
//  ИмяРеквизита - Строка
// 
// Возвращаемое значение:
//  Булево - Истина - реквизит обязателен к заполнению
Функция ОбязательностьЗаполненияРеквизита(Объект, ИмяРеквизита) Экспорт
	
	Ссылка = Объект.Ссылка;
	
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.ПоступлениеМЗ") Тогда
		Возврат ОбязательностьЗаполненияРеквизита_ПоступлениеМЗ(Объект, ИмяРеквизита);
	КонецЕсли;
	
КонецФункции

// В поступлении МЗ возможен учет НДС.
// 
// Параметры:
//  ОбъектИлиФорма - ДокументОбъект.ПоступлениеМЗ
//                 - см. Документ.ПоступлениеМЗ.Форма.ФормаДокумента
// 
// Возвращаемое значение:
//  Булево - В поступлении МЗ возможен учет НДС
Функция ВПоступленииМЗВозможенУчетНДС(ОбъектИлиФорма) Экспорт
	
	Если ТипЗнч(ОбъектИлиФорма) = Тип("ФормаКлиентскогоПриложения") Тогда
		Объект = ОбъектИлиФорма.Объект; // см. Документ.ПоступлениеМЗ.Форма.ФормаДокумента.Объект
	Иначе
		//@skip-check statement-type-change
		Объект = ОбъектИлиФорма;
	КонецЕсли;
	
	Если Не ПоступлениеМЗЭтоПоступлениеИлиВозврат(Объект.ВидПоступленияМЗ) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(ОбъектИлиФорма) = Тип("ФормаКлиентскогоПриложения") Тогда
		Если Не СчетУчетаРавен105(ОбъектИлиФорма) И Не СчетУчетаРавен106(ОбъектИлиФорма) 
			И Не СчетУчетаРавенЗначению(ОбъектИлиФорма, "Счет0233") И Не СчетУчетаРавенЗначению(ОбъектИлиФорма, "Счет0234") Тогда
			Возврат Ложь;
		КонецЕсли; 
	Иначе
		Если БухгалтерскийУчетВызовСервера.СписокСчетов("105.00, 106.00, 02.33, 02.34", Объект.Дата, Истина, Объект.Организация).Найти(Объект.СчетУчета) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли; 
	КонецЕсли;
	
	Если ПервичныеДокументыБГУКлиентСервер.ВыбранУказанныйПервичныйДокумент(Объект.ПервичныйДокумент, "АктПриемаПередачи0510448") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Поступление МЗ - Это поступление или возврат.
// 
// Параметры:
//  ВидПоступления - ПеречислениеСсылка.ВидыПоступленийМЗ
// 
// Возвращаемое значение:
//  Булево - Это поступление или возврат
Функция ПоступлениеМЗЭтоПоступлениеИлиВозврат(ВидПоступления) Экспорт
	Возврат ВидПоступления = ПредопределенноеЗначение(
		"Перечисление.ВидыПоступленийМЗ.Поступление")
		ИЛИ ВидПоступления = ПредопределенноеЗначение(
		"Перечисление.ВидыПоступленийМЗ.ПоступлениеОтПоставщика")
		ИЛИ ВидПоступления = ПредопределенноеЗначение(
		"Перечисление.ВидыПоступленийМЗ.ПоступлениеКомиссионныхТоваров")
		ИЛИ ВидПоступления = ПредопределенноеЗначение(
		"Перечисление.ВидыПоступленийМЗ.ВозвратОтПокупателя");
КонецФункции

// Установить ограничение типов основания в форме документа "Решение о прекращении признания объектом".
// 
// Параметры:
//  Форма - см. Документ.РешениеОПрекращенииПризнанияАктивомМЗ.Форма.ФормаДокумента
//	ВсеДопустимыеТипы - Массив из Тип
Процедура УстановитьОграничениеТиповОснования_Решение0510440(Форма, ВсеДопустимыеТипы) Экспорт
	ДопустимыйТипОснования = ВыбранныйВидОснования_Решение0510440(Форма.Объект);
	ИспользуемыеТипы = ?(ЗначениеЗаполнено(ДопустимыйТипОснования),
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДопустимыйТипОснования),
		ВсеДопустимыеТипы);
	Форма.Элементы.ОснованиеДокументИнвентаризации.ОграничениеТипа = Новый ОписаниеТипов(ИспользуемыеТипы);
КонецПроцедуры

// Выбранный вид основания в форме документа "Решение о прекращении признания объектом".
// 
// Параметры:
//  Объект - ДанныеФормыСтруктура - Объект
// 
// Возвращаемое значение:
//  Тип, Неопределено -
Функция ВыбранныйВидОснования_Решение0510440(Объект) Экспорт
	Для Каждого Строка Из Объект.Основание Цикл
		Если ЗначениеЗаполнено(Строка.ДокументИнвентаризации) Тогда
			Возврат ТипЗнч(Строка.ДокументИнвентаризации);
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

