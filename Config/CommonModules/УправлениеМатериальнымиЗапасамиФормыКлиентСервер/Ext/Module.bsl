// @strict-types

#Область ПрограммныйИнтерфейс

// Установить свойства элементов группы корректировка.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения:
//   * Объект - ДанныеФормыСтруктура:
//     ** ЭтоКорректировка - Булево
//     ** НомерКорректировки - Число
//     ** ДокументОснование - ДокументСсылка
//   * КорректирующийДокумент - ДокументСсылка
//   * НадписьКорректировка - Строка
Процедура УстановитьСвойстваЭлементовГруппыКорректировка(Форма) Экспорт

	ЧастиСтроки = Новый Массив; // Массив из Строка
	Объект = Форма.Объект;
	Если Объект.ЭтоКорректировка Тогда
		ЧастиСтроки.Добавить(СтрШаблон(НСтр("ru = 'Корректировка №%1. Корректируемый документ: '"), Объект.НомерКорректировки));
		СсылкаНаДок = ПолучитьНавигационнуюСсылку(Объект.ДокументОснование);
		СсылкаНаКорректируемыйДокумент = Новый ФорматированнаяСтрока(Строка(Объект.ДокументОснование), , , , СсылкаНаДок);
		ЧастиСтроки.Добавить(СсылкаНаКорректируемыйДокумент);
	КонецЕсли;
	Если ЗначениеЗаполнено(Форма.КорректирующийДокумент) Тогда
		Если ЧастиСтроки.Количество() > 0 Тогда
			ЧастиСтроки.Добавить(" ");
		КонецЕсли;
		ЧастиСтроки.Добавить(НСтр("ru = 'Введен корректирующий документ: '"));
		СсылкаНаДок = ПолучитьНавигационнуюСсылку(Форма.КорректирующийДокумент);
		СсылкаНаКорректирующийДокумент = Новый ФорматированнаяСтрока(Строка(Форма.КорректирующийДокумент), , , , СсылкаНаДок);
		ЧастиСтроки.Добавить(СсылкаНаКорректирующийДокумент);
	КонецЕсли;
	Если ЧастиСтроки.Количество() > 0 Тогда
		Форма.НадписьКорректировка = Новый ФорматированнаяСтрока(ЧастиСтроки);
	Иначе
		Форма.НадписьКорректировка = "";
	КонецЕсли;
	
	ВидимостьЭлементов = Форма.Объект.ЭтоКорректировка ИЛИ ЗначениеЗаполнено(Форма.КорректирующийДокумент);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГруппаКорректировка",
		"Видимость", ВидимостьЭлементов);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "НадписьКорректировка",
		"Видимость", ВидимостьЭлементов);
	
	Если Объект.ЭтоКорректировка И Объект.ДокументОснование = Объект.Ссылка Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'В поле ""Документ основание"" выбран этот же документ'"), , "Объект.ДокументОснование");
	КонецЕсли;

КонецПроцедуры

// Установить текст заголовков корректировки в строке.
// 
// Параметры:
//  Строка - ДанныеФормыЭлементКоллекции:
//   * ЗаголовокДоКорректировки - Строка
//   * ЗаголовокПослеКорректировки - Строка
Процедура УстановитьТекстЗаголовковКорректировкиВСтроке(Строка) Экспорт

	Строка.ЗаголовокДоКорректировки    = НСтр("ru = 'До корректировки'");
	Строка.ЗаголовокПослеКорректировки = НСтр("ru = 'После корректировки'");

КонецПроцедуры

// Установить текст заголовков корректировки в таблице.
// 
// Параметры:
//  Таблица - ДанныеФормыКоллекция
Процедура УстановитьТекстЗаголовковКорректировкиВТаблице(Таблица) Экспорт

	Для Каждого Строка Из Таблица Цикл
		УстановитьТекстЗаголовковКорректировкиВСтроке(Строка);
	КонецЦикла;

КонецПроцедуры

// Установить переключатель резервирование.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения:
//   * Объект - ДанныеФормыСтруктура
Процедура УстановитьПереключательРезервирование(Форма) Экспорт
	РезервированиеНФАКлиентСервер.УстановитьПереключательРезервирование(Форма, Форма.Объект);
КонецПроцедуры

// Проверяет, что реквизит "СчетУчета" равен значению в ключе локального кэша формы Счет105, если ключ есть в кэше.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения:
//    * Объект - ДанныеФормыСтруктура:
//      ** СчетУчета - ПланСчетовСсылка.ЕПСБУ
//    * КэшПараметров - Структура:
//      ** Локальные - Структура:
//        *** Счет105 - ПланСчетовСсылка.ЕПСБУ
// 
// Возвращаемое значение:
//  Булево - Поступление на счет105
Функция СчетУчетаРавен105(Форма) Экспорт
	Возврат СчетУчетаРавенЗначению(Форма, "Счет105"); 
КонецФункции
	
