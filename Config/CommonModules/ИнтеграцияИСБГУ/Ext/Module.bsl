Функция ПредставлениеОбъекта(ПараметрОбъект) Экспорт
	
	Если ПараметрОбъект = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	МетаданныеОбъекта = ?(ТипЗнч(ПараметрОбъект) = Тип("Строка"), Метаданные.НайтиПоПолномуИмени(ПараметрОбъект), ПараметрОбъект);
	
	Представление = Новый Структура("ПредставлениеОбъекта");
	ЗаполнитьЗначенияСвойств(Представление, МетаданныеОбъекта);
	Если Не ПустаяСтрока(Представление.ПредставлениеОбъекта) Тогда
		Возврат Представление.ПредставлениеОбъекта;
	КонецЕсли;
	
	Возврат МетаданныеОбъекта.Представление();
	
КонецФункции

Процедура ЗаполнитьДанныеМОДУПД_5_03(ОбщиеПараметры) Экспорт 

	Если СтрДлина(ОбщиеПараметры.СсылкаНаОбъект.ИдентификаторФИАС) > 36 Тогда
		АдресXML 	= СокрЛП(ОбщиеПараметры.СсылкаНаОбъект.ИдентификаторФИАС);
		
		СведенияОбАдресе = РаботаСАдресами.СведенияОбАдресе(АдресXML, Новый Структура("КодыАдреса", Истина));
		Если ЗначениеЗаполнено(СведенияОбАдресе.ИдентификаторДома) Тогда 
			УточненныйКод 	= СведенияОбАдресе.ИдентификаторДома;
		Иначе
			УточненныйКод 	= СведенияОбАдресе.ИдентификаторАдресногоОбъекта;	
		КонецЕсли;
	Иначе	
		АдресXML 		= РаботаСАдресами.АдресПоИдентификатору(СокрЛП(ОбщиеПараметры.СсылкаНаОбъект.ИдентификаторФИАС));
		УточненныйКод 	= ОбщиеПараметры.СсылкаНаОбъект.ИдентификаторФИАС;
	КонецЕсли;
			
	ДеревоДанных 	= ОбщиеПараметры.ДеревоЭД;                        
	ПутьУчастник 	= "СведенияОСчетеФактуре.СведенияОГрузополучателях.НомерСтроки.Грузополучатель";
	
	ТаблицаКодовФИАСДляТегаТекстовойИнформации = Новый ТаблицаЗначений;
	ТаблицаКодовФИАСДляТегаТекстовойИнформации.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	ТаблицаКодовФИАСДляТегаТекстовойИнформации.Колонки.Добавить("Значение",      Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(2000)));
	
	ПутьКДаннымСтроки 							= "СведенияОСчетеФактуре.СведенияОГрузополучателях.НомерСтроки.Грузополучатель";
	ПутьКДаннымАдресаОбъект 					= ".Адрес.ТипАдреса.АвтоматическиЗаполняемый.ОбъектКонтактнойИнформации";
	ПутьКДаннымАдресаВидКонтактнойИнформации 	= ".Адрес.ТипАдреса.АвтоматическиЗаполняемый.ВидКонтактнойИнформации";
	
	ЭлектронноеВзаимодействиеИСМП.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ПутьКДаннымСтроки + ПутьКДаннымАдресаОбъект, Неопределено);
	ЭлектронноеВзаимодействиеИСМП.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ПутьКДаннымСтроки + ПутьКДаннымАдресаВидКонтактнойИнформации, Неопределено);
	
	ЭлектронноеВзаимодействиеИСМП.ЗаполнитьАдресУчастникаУПД_5_02(ОбщиеПараметры.ДеревоЭД, АдресXML, "", ПутьУчастник, ТаблицаКодовФИАСДляТегаТекстовойИнформации, УточненныйКод);
	
	Если ТаблицаКодовФИАСДляТегаТекстовойИнформации.Количество() Тогда
		Путь = "СведенияОСчетеФактуре.ИнформационноеПолеФХЖ.ТекстоваяИнформация";
		Для Каждого СтрокаВывода Из ТаблицаКодовФИАСДляТегаТекстовойИнформации Цикл
			ЭлектронноеВзаимодействиеИСМП.ДобавитьЗаписьВТаблицуДерева(ОбщиеПараметры.ДеревоЭД, СтрокаВывода, Путь);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

