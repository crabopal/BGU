#Область СлужебныйПрограммныйИнтерфейс

Функция СостояниеАктуальногоЭлектронногоДокумента(УчетныйДокумент, ИдентификаторКомандыПечати) Экспорт
	
	Возврат ВнутреннийЭДО.СостояниеАктуальногоЭлектронногоДокумента(УчетныйДокумент, ИдентификаторКомандыПечати);
	
КонецФункции

Функция ДанныеДокументовДляПодписиБГУ(ЭлектронныеДокументы, ИдентификаторФормы, ВидПодписи, Сертификат) Экспорт
	
	ДанныеДокументов = Новый Структура;
	
	НаборДанныхДляПодписи = Новый Массив;
	
	ПростаяПодпись = ВидПодписи = ПредопределенноеЗначение("Перечисление.ВидыЭлектронныхПодписейБГУ.Простая");
	
	РеквизитыДокументов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(
		ЭлектронныеДокументы, "ВидДокумента, ДатаДокумента, НомерДокумента, ОсновнойФайл, ОсновнойФайлPDF, УчетныйДокумент");
	
	ОрганизацииИДолжностиПоДокументам = Новый Соответствие;
	
	Для Каждого РеквизитыДокумента Из РеквизитыДокументов Цикл
		
		ЭлектронныйДокумент = РеквизитыДокумента.Ключ;
		ЗначенияРеквизитов = РеквизитыДокумента.Значение;
		
		Заголовок = ВнутреннийЭДОКлиентСервер.ПредставлениеДокументаПоСвойствам(ЗначенияРеквизитов);
		ОсновнойФайл = ЗначенияРеквизитов.ОсновнойФайл;
		ОсновнойФайлPDF = ЗначенияРеквизитов.ОсновнойФайлPDF;
		
		ПараметрыДанныхФайла = РаботаСФайламиКлиентСервер.ПараметрыДанныхФайла();
		ПараметрыДанныхФайла.ПолучатьСсылкуНаДвоичныеДанные = Истина;
		ПараметрыДанныхФайла.ИдентификаторФормы = ИдентификаторФормы;
		
		ДанныеФайла = РаботаСФайлами.ДанныеФайла(ОсновнойФайл, ПараметрыДанныхФайла);
		
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(ДанныеФайла.СсылкаНаДвоичныеДанныеФайла);
		ТабличныйДокументОсновной = ВнутреннийЭДО.ТабличныйДокументИзДвоичныхДанныхАрхива(ДвоичныеДанные);
		АдресТабличногоДокумента = ПоместитьВоВременноеХранилище(ТабличныйДокументОсновной, ИдентификаторФормы);

		ДанныеДокумента = Новый Структура;
		ДанныеДокумента.Вставить("Данные", ДанныеФайла.СсылкаНаДвоичныеДанныеФайла);
		ДанныеДокумента.Вставить("Заголовок", Заголовок);
		ДанныеДокумента.Вставить("АдресТабличногоДокумента", АдресТабличногоДокумента);
		
		ДанныеДокумента.Вставить("УчетныйДокумент", ЗначенияРеквизитов.УчетныйДокумент);
		ДанныеДокумента.Вставить("ЭлектронныйДокумент", ЭлектронныйДокумент);
		ДанныеДокумента.Вставить("ФайлДляПодписи", ОсновнойФайл);
		ДанныеДокумента.Вставить("ВидПодписи", ВидПодписи);
		
		ДанныеДокумента.Вставить("ЭтоДанныеPDF", Ложь);
	
		НаборДанныхДляПодписи.Добавить(ДанныеДокумента);
		
		Если ЗначениеЗаполнено(ОсновнойФайлPDF) Тогда
			ДанныеФайлаPDF = РаботаСФайлами.ДанныеФайла(ОсновнойФайлPDF, ПараметрыДанныхФайла);
		
			ДанныеДокумента = Новый Структура;
			ДанныеДокумента.Вставить("Данные", ДанныеФайлаPDF.СсылкаНаДвоичныеДанныеФайла);
			ДанныеДокумента.Вставить("Заголовок", Заголовок + " (pdf)");
			ДанныеДокумента.Вставить("АдресТабличногоДокумента", АдресТабличногоДокумента);
			
			ДанныеДокумента.Вставить("УчетныйДокумент", ЗначенияРеквизитов.УчетныйДокумент);
			ДанныеДокумента.Вставить("ЭлектронныйДокумент", ЭлектронныйДокумент);
			ДанныеДокумента.Вставить("ФайлДляПодписи", ОсновнойФайлPDF);
			ДанныеДокумента.Вставить("ВидПодписи", ВидПодписи);
			
			ДанныеДокумента.Вставить("ЭтоДанныеPDF", Истина);
			
			НаборДанныхДляПодписи.Добавить(ДанныеДокумента);
		КонецЕсли;
		
		Если ПростаяПодпись Тогда
			ОрганизацииИДолжностиПоДокументам.Вставить(ЭлектронныйДокумент, Новый Структура("Организация, Должность"));
		КонецЕсли;
		
	КонецЦикла;
	
	ДанныеДокументов.Вставить("НаборДанных", НаборДанныхДляПодписи);
	
	Если ПростаяПодпись Тогда
		
		ТекущийПользователь = Пользователи.ТекущийПользователь();
		
		СведенияДляПростойПодписи = Новый Структура("ПолноеИмя, ОрганизацииИДолжности", "", ОрганизацииИДолжностиПоДокументам);
		
		ВнутреннийЭДО.ЗаполнитьСведенияОПользователе(ТекущийПользователь, СведенияДляПростойПодписи);
		
		ДанныеДокументов.Вставить("СведенияДляПростойПодписи", СведенияДляПростойПодписи);
	ИначеЕсли ЗначениеЗаполнено(Сертификат) Тогда
		ДанныеДокументов.Вставить("ДоступныеСертификаты", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Сертификат));
	Иначе
		//ДанныеДокументов.Вставить("ДоступныеСертификаты", ВнутреннийЭДО.ДоступныеДляВыбораСертификатыКлючейЭП());
		ДанныеДокументов.Вставить("ДоступныеСертификаты", Новый Массив);
	КонецЕсли;
	
	Возврат ДанныеДокументов;
	
КонецФункции

Процедура ПодписатьЭлектроннойПодписью(ОписаниеДанных) Экспорт
	
	Отказ = Ложь;
	ОписаниеОшибки = "";
	ВнутреннийЭДО.ПроверитьВозможностьИспользованияПростойПодписи(ОписаниеДанных, Отказ, ОписаниеОшибки);
	Если Отказ Тогда
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
		Возврат;
	КонецЕсли;
	
	Для Каждого Данные Из ОписаниеДанных Цикл
		
		ВнутреннийЭДО.ПодписатьЭлектронныйДокумент(Данные);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ТипыУчетныхДокументовВнутреннегоЭДО() Экспорт
	
	Возврат ВнутреннийЭДО.ТипыУчетныхДокументовВнутреннегоЭДО();
	
КонецФункции

Функция ДокументОбрабатываетсяВнутреннимЭДОБЭД(УчетныйДокумент) Экспорт
	
	Возврат ВнутреннийЭДО.ДокументОбрабатываетсяВнутреннимЭДОБЭД(УчетныйДокумент);
	
КонецФункции

Функция ЕстьДокументыНеУчаствующиеВЭДОБЭД(УчетныеДокументы) Экспорт
	
	// Если хотя бы один документ не обрабатывается внутренним ЭДО БЭД, то возвращается Истина
	Для Каждого УчетныйДокумент Из УчетныеДокументы Цикл
		Если НЕ ВнутреннийЭДО.ДокументОбрабатываетсяЭДОБЭД(УчетныйДокумент) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ПараметрыПросмотраЭлектронногоДокумента(УчетныйДокумент) Экспорт
	
	ПараметрыПросмотра = Новый Структура;
	ПараметрыПросмотра.Вставить("ПараметрыЕдинственногоДокумента", Новый Структура);
	ПараметрыПросмотра.Вставить("ДокументОбрабатываетсяВнутреннимЭДОБЭД",
		ДокументОбрабатываетсяВнутреннимЭДОБЭД(УчетныйДокумент));
	ПараметрыПросмотра.Вставить("ЕстьПравоЧтенияВнутреннихЭлектронныхДокументов", Истина);
	ПараметрыПросмотра.Вставить("ДокументПодходитДляВнутреннегоЭДОБГУ", Истина);
	
	Если ПараметрыПросмотра.ДокументОбрабатываетсяВнутреннимЭДОБЭД Тогда
		Возврат ПараметрыПросмотра;
	КонецЕсли;
	
	Если НЕ ПравоДоступа("Чтение", Метаданные.Документы.ВнутреннийЭлектронныйДокумент) Тогда
		ПараметрыПросмотра.ЕстьПравоЧтенияВнутреннихЭлектронныхДокументов = Ложь;
		Возврат ПараметрыПросмотра;
	КонецЕсли;
	
	Если НЕ Метаданные.ОпределяемыеТипы.ОснованиеВнутреннегоЭлектронногоДокумента.Тип.СодержитТип(ТипЗнч(УчетныйДокумент)) Тогда
		ПараметрыПросмотра.ДокументПодходитДляВнутреннегоЭДОБГУ = Ложь;
		Возврат ПараметрыПросмотра;
	КонецЕсли;
	
	Идентификаторы = Новый Соответствие;
	
	Для Каждого Строка Из ВнутреннийЭДО.ЭлектронныеДокументыАктуальные(УчетныйДокумент) Цикл
		Идентификаторы.Вставить(Строка.ИдентификаторКомандыПечати, Строка.ЭлектронныйДокумент);
	КонецЦикла;
	
	ИдентификаторДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(УчетныйДокумент));
	МетаданныеОбъекта = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(ИдентификаторДокумента);
	
	ОбъектыСоСпециальнымиКомандамиПечати = ВнутреннийЭДОПереопределяемый.ОбъектыСоСпециальнымиКомандамиПечати();
	
	Если ОбъектыСоСпециальнымиКомандамиПечати[ТипЗнч(УчетныйДокумент)] <> Неопределено Тогда
		КомандыПечати = ОбъектыСоСпециальнымиКомандамиПечати[ТипЗнч(УчетныйДокумент)];
	Иначе
		КомандыПечати = ВнутреннийЭДО.КомандыПечатиОбъекта(МетаданныеОбъекта);
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(УчетныйДокумент, "Организация") Тогда
		Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УчетныйДокумент, "Организация");
	Иначе
		Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(УчетныйДокумент, "Владелец");
	КонецЕсли;
	
	Для Каждого Строка Из ВнутреннийЭДО.ЭлектронныеДокументыИзНастройки(Организация, ИдентификаторДокумента) Цикл
		Если Идентификаторы[Строка.ИдентификаторКомандыПечати] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		КомандаПечати = ВнутреннийЭДО.КомандаПечатиПоИдентификатору(КомандыПечати, Строка.ИдентификаторКомандыПечати);
		Если КомандаПечати <> Неопределено
			И НЕ ВнутреннийЭДО.КомандаПечатиПодходитПоУсловиям(КомандаПечати, УчетныйДокумент) Тогда
			Продолжить;
		КонецЕсли;
		Идентификаторы.Вставить(Строка.ИдентификаторКомандыПечати, "");
	КонецЦикла;
	
	Если Идентификаторы.Количество() <> 1 Тогда
		Возврат ПараметрыПросмотра;
	КонецЕсли;
	
	Для Каждого Идентификатор Из Идентификаторы Цикл
		Если ЗначениеЗаполнено(Идентификатор.Значение) Тогда
			ПараметрыПросмотра.ПараметрыЕдинственногоДокумента = ВнутреннийЭДОКлиентСервер.ПараметрыОткрытияЭлектронногоДокумента();
			ПараметрыПросмотра.ПараметрыЕдинственногоДокумента.ЭлектронныйДокумент = Идентификатор.Значение;
		Иначе
			КомандаПечати = ВнутреннийЭДО.КомандаПечатиПоИдентификатору(КомандыПечати, Идентификатор.Ключ);
			
			Если Не ЗначениеЗаполнено(КомандаПечати) Тогда
				Продолжить;
			КонецЕсли;
			
			ПараметрыДокумента = ПараметрыНовогоЭлектронногоДокумента(УчетныйДокумент);
			ПараметрыДокумента.ИдентификаторКомандыПечати = Идентификатор.Ключ;
			ПараметрыДокумента.ВидДокумента = КомандаПечати.Представление;
			
			ПараметрыПросмотра.ПараметрыЕдинственногоДокумента = ПараметрыДокумента;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ПараметрыПросмотра;
	
КонецФункции

Функция ПараметрыЭлектронногоДокумента(УчетныйДокумент, ИдентификаторКомандыПечати) Экспорт
	
	ПараметрыДокумента = Новый Структура;
	ПараметрыДокумента.Вставить("АктуальныйЭлектронныйДокумент", Неопределено);
	ПараметрыДокумента.Вставить("ПараметрыНовогоЭлектронногоДокумента", Неопределено);
	
	ПараметрыДокумента.АктуальныйЭлектронныйДокумент =
		ВнутреннийЭДО.АктуальныйЭлектронныйДокумент(УчетныйДокумент, ИдентификаторКомандыПечати);
	
	Если НЕ ЗначениеЗаполнено(ПараметрыДокумента.АктуальныйЭлектронныйДокумент) Тогда
		
		КомандыПечати = ВнутреннийЭДО.КомандыПечатиОбъекта(УчетныйДокумент.Метаданные());
		КомандаПечати = ВнутреннийЭДО.КомандаПечатиПоИдентификатору(КомандыПечати, ИдентификаторКомандыПечати);
		
		ПараметрыДокумента.ПараметрыНовогоЭлектронногоДокумента =
			ПараметрыНовогоЭлектронногоДокумента(УчетныйДокумент);
		ПараметрыДокумента.ПараметрыНовогоЭлектронногоДокумента.ВидДокумента =
			?(КомандаПечати = Неопределено, "", КомандаПечати.Представление);
		ПараметрыДокумента.ПараметрыНовогоЭлектронногоДокумента.ИдентификаторКомандыПечати = ИдентификаторКомандыПечати;
		
	КонецЕсли;
	
	Возврат ПараметрыДокумента;
	
КонецФункции

Функция ПараметрыНовогоЭлектронногоДокумента(УчетныйДокумент) Экспорт
	
	ПараметрыДокумента = ВнутреннийЭДОКлиентСервер.ПараметрыОткрытияЭлектронногоДокумента();
	
	ПараметрыУчетногоДокумента = ВнутреннийЭДО.ПараметрыУчетногоДокумента(УчетныйДокумент);
	
	ПараметрыДокумента.УчетныйДокумент = УчетныйДокумент;
	ПараметрыДокумента.ИдентификаторДокумента = ПараметрыУчетногоДокумента.ИдентификаторДокумента;
	ПараметрыДокумента.НомерДокумента = ПараметрыУчетногоДокумента.НомерДокумента;
	ПараметрыДокумента.ДатаДокумента = ПараметрыУчетногоДокумента.ДатаДокумента;
	ПараметрыДокумента.Организация = ПараметрыУчетногоДокумента.Организация;
	
	ВнутреннийЭДОПереопределяемый.ПриЗаполненииПараметровНовогоЭлектронногоДокумента(ПараметрыДокумента);
	
	Возврат ПараметрыДокумента;
	
КонецФункции

Функция ТребуетсяОткрытьЭлектронныйДокументБГУпоКомандеЭДО(УчетныйДокумент) Экспорт
	
	Если ОбщегоНазначения.ЗначениеСсылочногоТипа(УчетныйДокумент) Тогда
		Ссылка = УчетныйДокумент;
	Иначе
		Ссылка = УчетныйДокумент.Ссылка;
	КонецЕсли;
	
	Если НЕ ВнутреннийЭДО.ДокументОбрабатываетсяЭДОБЭД(Ссылка) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ДанныеВнутреннегоЭДО(Параметры) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Состояние", "");
	Результат.Вставить("ТолькоПросмотр", Ложь);
	
	Если НЕ ВнутреннийЭДОПереопределяемый.ИспользуютсяВнутренниеДокументы() Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ДокументОбрабатываетсяВнутреннимЭДОБЭД(Параметры.Ссылка) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТипыДокументовВнутреннегоЭДО = Новый ОписаниеТипов(ВнутреннийЭДОПовтИсп.ТипыУчетныхДокументовВнутреннегоЭДО());
	Если НЕ ТипыДокументовВнутреннегоЭДО.СодержитТип(ТипЗнч(Параметры.Ссылка)) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.Состояние = ВнутреннийЭДО.СостояниеУчетногоДокумента(Параметры.Ссылка).ПредставлениеСостояния;
	Результат.ТолькоПросмотр = ВнутреннийЭДО.ТребуетсяЗапретитьРедактированиеФормыДокумента(Параметры.Организация, Параметры.Ссылка);
	
	Возврат Результат;
	
КонецФункции

Функция СокращенноеИмяФайла(ИмяФайла, ТребуемаяДлина) Экспорт
	
	Возврат ОбщегоНазначения.СократитьСтрокуКонтрольнойСуммой(ИмяФайла, ТребуемаяДлина);
	
КонецФункции

Функция ПолучитьКонстантуПроверятьСведенияОДолжностиПодписантаПЭП() Экспорт 

	Возврат Константы.ПроверятьСведенияОДолжностиПодписантаПЭП.Получить(); 
	
КонецФункции

//*********************************

// Создает внутренние электронные документы по данным документов "Регистр учета"
//
// Параметры:
//  ДанныеРегистров - Массив - содержит элементы типа Структура, которые содержат 
//  							данные сзданных документов "Регистр учета"
//	Маршрут - СправочникСсылка.МаршрутыПодписанияБГУ ИЛИ Массив - массив эмулирует дерево маршрута 							  
Процедура СоздатьЭДпоДаннымРегистровУчета(ДанныеРегистров, Маршрут) Экспорт
	Для каждого ДанныеРегистра из ДанныеРегистров Цикл
		ПараметрыДокумента = ПараметрыНовогоЭлектронногоДокумента(ДанныеРегистра.РегистрУчета);
		НовыйЭД = Документы.ВнутреннийЭлектронныйДокумент.СоздатьДокумент();
		НовыйЭД.Заполнить(Новый Структура);
		ЗаполнитьЗначенияСвойств(НовыйЭД, ПараметрыДокумента);
		НовыйЭД.Дата = ПараметрыДокумента.ДатаДокумента;

		Описание = ВнутреннийЭДО.ОписаниеНовогоЭлектронногоДокумента(ПараметрыДокумента);
		НовыйЭД.ДополнительныеСвойства.Вставить("АдресОсновногоФайла", Описание.АдресОсновногоФайла);
		НовыйЭД.ДополнительныеСвойства.Вставить("ИмяФайла", Описание.ИмяФайла);
		НовыйЭД.ДополнительныеСвойства.Вставить("АдресОсновногоФайлаPDF", Описание.АдресОсновногоФайлаPDF);
		НовыйЭД.ДополнительныеСвойства.Вставить("ИмяФайлаPDF", Описание.ИмяФайлаPDF);
		
		СоставМаршрута = Неопределено;
		Если ТипЗнч(Маршрут) = Тип("СправочникСсылка.МаршрутыПодписанияБГУ") Тогда
			СоставМаршрута = ВнутреннийЭДО.СоставМаршрутаПодписания(Маршрут);
		ИначеЕсли ТипЗнч(Маршрут) = Тип("Массив") Тогда	
			Если Маршрут.Количество() = 0 Тогда
				Возврат;
			КонецЕсли;	
			
			ДеревоМаршрута = Новый ДеревоЗначений();
			Для каждого ТекКолонка из Маршрут[0] Цикл
				Если ТекКолонка.Ключ = "Строки" Тогда
					Продолжить;
				КонецЕсли;	
				ДеревоМаршрута.Колонки.Добавить(ТекКолонка.Ключ);
			КонецЦикла;
			СформироватьДеревоМаршрутаИзМассива(Маршрут, ДеревоМаршрута.Строки);
			ВнутреннийЭДО.ЗаполнитьТаблицуСоставМаршрутаПоДереву(ДеревоМаршрута, СоставМаршрута);
		КонецЕсли;
			
		Если СоставМаршрута = Неопределено Тогда
			Возврат;
		КонецЕсли;		
		НовыйЭД.ДополнительныеСвойства.Вставить("СоставМаршрута", СоставМаршрута);
		Попытка
			НовыйЭД.Записать();
		Исключение
			ТекстОшибки = СтрШаблон(НСтр(
				"ru = 'Для документа %1 не создан внутренний электронный документ. Ошибка при записи документа.'"),
				ДанныеРегистра.РегистрУчета);
			ИмяСобытия = НСтр("ru = 'Создание внутреннего электронного документа. Запись документа'");	
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, НовыйЭД.Метаданные(),,ТекстОшибки);
		КонецПопытки;		
	КонецЦикла;	
КонецПроцедуры	

// Возвращает маршрут подписания для учетного документа из настроек
//
// Параметры:
//  УчетныйДокумент - ОпределяемыйТип.ОснованиеВнутреннегоЭлектронногоДокумента - учетный документ, 
//     для которого оперделяем маршрут из настройки
//
// Возвращаемое значение:
//  - СправочникСсылка.МаршрутыПодписанияБГУ - если в настройках маршрута нет, то вернется пустая ссылка 
Функция МаршрутИзНастройкиВнутреннегоЭДОБГУ(УчетныйДокумент) Экспорт
	ПараметрыДокумента = ПараметрыНовогоЭлектронногоДокумента(УчетныйДокумент);
	Возврат(РегистрыСведений.НастройкиВнутреннегоЭДОБГУ.МаршрутИзНастройкиВнутреннегоЭДОБГУ(
		ПараметрыДокумента.Организация, 
		ПараметрыДокумента.УчетныйДокумент, 
		ПараметрыДокумента.ИдентификаторКомандыПечати));
КонецФункции	

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СформироватьДеревоМаршрутаИзМассива(МассивМаршрута, ДеревоМаршрута)
	Для каждого ТекСтрока из МассивМаршрута Цикл
		Строка = ДеревоМаршрута.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, ТекСтрока,, "Строки");
		СформироватьДеревоМаршрутаИзМассива(ТекСтрока.Строки, Строка.Строки);
	КонецЦикла;	
КонецПроцедуры	 

#КонецОбласти
