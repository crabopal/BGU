Функция ПолучитьЗначениеСубконтоПроводки(НомерСубконто, СторонаПроводки = "",
		Регистратор, Организация, ИФО, Подразделение, КФО, Счет, КПС, КЭК,
		ПрименятьОтборПоСуммеВРублях = Ложь, СуммаВРублях = 0,
		Валюта = Неопределено, ПрименятьОтборПоСуммеВВалюте = Ложь, СуммаВВалюте = 0) Экспорт
	
	УказанаСторонаДт = (НРег(СторонаПроводки) = "дт");
	УказанаСторонаКт = (НРег(СторонаПроводки) = "кт");
	
	Если ЗначениеЗаполнено(СторонаПроводки) И Не УказанаСторонаДт И Не УказанаСторонаКт Тогда
		МассивТекстов = Новый Массив();
		МассивТекстов.Добавить(НСтр("ru='Некорректное значение параметра СторонаПроводки процедуры ПолучитьЗначениеСубконтоПроводки().'"));
		МассивТекстов.Добавить(НСтр("ru='Ожидается значение ""Дт"" или ""Кт"" или пустая строка.'"));
		
		ВызватьИсключение СтрСоединить(МассивТекстов, " ");
	КонецЕсли;
	
	АвтоВыборСтороны = Не УказанаСторонаДт И Не УказанаСторонаКт;
	
	ПрименятьОтборПоИФО = ЗначениеЗаполнено(ИФО);
	ПрименятьОтборПоПодразделению = ЗначениеЗаполнено(Подразделение);
	ПрименятьОтборПоВалюте = ЗначениеЗаполнено(Валюта);
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("Регистратор", Регистратор);
	ЗапросПоиск.УстановитьПараметр("Организация", Организация);
	ЗапросПоиск.УстановитьПараметр("КФО", КФО);
	ЗапросПоиск.УстановитьПараметр("Сумма", СуммаВРублях);
	ЗапросПоиск.УстановитьПараметр("ПрименятьОтборПоСумме", ПрименятьОтборПоСуммеВРублях);
	ЗапросПоиск.УстановитьПараметр("Счет", Счет);
	ЗапросПоиск.УстановитьПараметр("КПС", КПС);
	ЗапросПоиск.УстановитьПараметр("КЭК", КЭК);
	ЗапросПоиск.УстановитьПараметр("ИФО", ИФО);
	ЗапросПоиск.УстановитьПараметр("ПрименятьОтборПоИФО", ПрименятьОтборПоИФО);
	ЗапросПоиск.УстановитьПараметр("Подразделение", Подразделение);
	ЗапросПоиск.УстановитьПараметр("ПрименятьОтборПоПодразделению", ПрименятьОтборПоПодразделению);
	ЗапросПоиск.УстановитьПараметр("Валюта", Валюта);
	ЗапросПоиск.УстановитьПараметр("ПрименятьОтборПоВалюте", ПрименятьОтборПоВалюте);
	ЗапросПоиск.УстановитьПараметр("ВалютнаяСумма", СуммаВВалюте);
	ЗапросПоиск.УстановитьПараметр("ПрименятьОтборПоВалютнойСумме", ПрименятьОтборПоСуммеВВалюте);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ
	|	НомерСтроки				КАК НомерСтроки,
	|	(СчетДт = &Счет
	|		И КПСДт = &КПС
	|		И КЭКДт = &КЭК
	|		И ВЫБОР
	|			КОГДА &ПрименятьОтборПоПодразделению ТОГДА
	|				ПодразделениеДт = &Подразделение
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ПрименятьОтборПоВалюте ТОГДА
	|				ВалютаДт = &Валюта
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ПрименятьОтборПоВалютнойСумме ТОГДА
	|				ВалютнаяСуммаДт = &ВалютнаяСумма
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ)				КАК СовпадаетСторонаДт,
	|	(СчетКт = &Счет
	|		И КПСКт = &КПС
	|		И КЭККт = &КЭК
	|		И ВЫБОР
	|			КОГДА &ПрименятьОтборПоПодразделению ТОГДА
	|				ПодразделениеКт = &Подразделение
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ПрименятьОтборПоВалюте ТОГДА
	|				ВалютаКт = &Валюта
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ПрименятьОтборПоВалютнойСумме ТОГДА
	|				ВалютнаяСуммаКт = &ВалютнаяСумма
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ)				КАК СовпадаетСторонаКт,
	|	СубконтоДт1				КАК СубконтоДт1,
	|	СубконтоДт2				КАК СубконтоДт2,
	|	СубконтоДт3				КАК СубконтоДт3,
	|	СубконтоКт1				КАК СубконтоКт1,
	|	СубконтоКт2				КАК СубконтоКт2,
	|	СубконтоКт3				КАК СубконтоКт3
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|		,
	|		,
	|		Регистратор = &Регистратор
	|		И Активность
	|		И Организация = &Организация
	|		И КФО = &КФО
	|		И ВЫБОР
	|			КОГДА &ПрименятьОтборПоСумме ТОГДА
	|				Сумма = &Сумма
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И Счет = &Счет
	|		И КПС = &КПС
	|		И КЭК = &КЭК
	|		И ВЫБОР
	|			КОГДА &ПрименятьОтборПоИФО ТОГДА
	|				ИФО = &ИФО
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ПрименятьОтборПоПодразделению ТОГДА
	|				Подразделение = &Подразделение
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ПрименятьОтборПоВалюте ТОГДА
	|				Валюта = &Валюта
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ПрименятьОтборПоВалютнойСумме ТОГДА
	|				ВалютнаяСумма = &ВалютнаяСумма
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ)
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Выборка = ЗапросПоиск.Выполнить().Выбрать();
	
	ЗначениеСубконто = Неопределено;
	
	Пока Выборка.Следующий() Цикл
		Если Выборка.СовпадаетСторонаДт Тогда
			Если УказанаСторонаДт Или АвтоВыборСтороны Тогда
				ВыбраннаяСторона = "Дт";
			Иначе
				Продолжить;
			КонецЕсли;
			
		ИначеЕсли Выборка.СовпадаетСторонаКт Тогда
			Если УказанаСторонаКт Или АвтоВыборСтороны Тогда
				ВыбраннаяСторона = "Кт";
			Иначе
				Продолжить;
			КонецЕсли;
			
		Иначе
			Продолжить;
		КонецЕсли;
		
		ИмяПоля = СтрШаблон("Субконто%1%2", ВыбраннаяСторона, НомерСубконто);
		
		ЗначениеСубконто = Выборка[ИмяПоля];
		
		Прервать;
	КонецЦикла;
	
	Возврат ЗначениеСубконто;
	
КонецФункции

