															ДокументСсылка.Дата,
															ИмяТЧ,
															КолонкаОС,
															КолонкаКоличество,
															ЦМО,
															КФО,
															КПС,
															ИФО,
															ИспПодразделение,
															Ложь,
															Ложь,
															Истина,
															ВнеоборотныйАктив);
											
	Если ТаблицаОС.Итог("Нехватка") = 0 Тогда
		Если БлокироватьДанные Тогда																				
			СтруктураПараметров = Новый Структура("ТипТаблицы, ИмяТаблицы, ИсточникДанных",
													"РегистрБухгалтерии", "ЖурналПроводокЕПСБУ", ТаблицаОС);
				
			ЗначенияБлокировки = Новый Соответствие;
			ЗначенияБлокировки.Вставить("Период", ДокументСсылка.Дата);
			ЗначенияБлокировки.Вставить("Организация", ДокументСсылка.Организация);
			ЗначенияБлокировки.Вставить("КФО", КФО);
			ЗначенияБлокировки.Вставить("ИФО", ИФО);
			ОписаниеИсточника = Новый Соответствие;
			ОписаниеИсточника.Вставить("КПС", "КПС");
			ОписаниеИсточника.Вставить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства, "ОсновноеСредство");
			ОписаниеИсточника.Вставить("Счет", "Счет");
			Отказ = Ложь;
			ОбщегоНазначенияБГУ.УстановитьУправляемуюБлокировку(СтруктураПараметров, ЗначенияБлокировки, ОписаниеИсточника, Отказ);
			Если Отказ Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
		Возврат Истина;
	КонецЕсли;
	Для каждого ТекСтрОС Из ТаблицаОС Цикл
	
		Если ТекСтрОС.Нехватка > 0 Тогда
			ТекстСообщения = НСтр("ru='По внеоборотному активу ""%1"" на счете %2.%3.%4 по ЦМО ""%5"" не хватает количества'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
