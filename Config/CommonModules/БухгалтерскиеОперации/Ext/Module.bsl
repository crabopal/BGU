	//			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не найдена стоимость %1'"),
	//																						""+ТекСтрТЧ.ОсновноеСредство.Наименование+"(код "+ТекСтрТЧ.ОсновноеСредство.Код+")");
	//			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
	//		ИначеЕсли ТекСтрТЧ.Количество>ТекСтрОС.КоличествоМОЛ Тогда
	//			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не хватает количества %1'"),
	//																						""+ТекСтрТЧ.ОсновноеСредство.Наименование+"(код "+ТекСтрТЧ.ОсновноеСредство.Код+")");
	//			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
	//		КонецЕсли;				
	//			
	//	КонецЦикла; 
	//	
	КонецЕсли;
		
	Возврат НЕ Отказ;
КонецФункции

Функция ПолучитьРеквизитСписанияОСОперУчет(ДокументСсылка, ИмяРеквизита,  НомерСтроки = 0) Экспорт
	
	ТаблицаОС = БухгалтерскиеОперацииПовтИсп.ТаблицаОСДляСписанияОперУчет(ДокументСсылка);
	
	Если НомерСтроки = 0 Тогда
		НайденнаяСтрока = ?(ТаблицаОС.Количество()=1, ТаблицаОС[0], ТаблицаОС.Найти(ДокументСсылка.ИнвентарныйНомер, "ИнвНомер"));
	Иначе
		СтрокаДокумента = ДокументСсылка.ОсновныеСредства[НомерСтроки-1];
		КопияТаблицыОС  = ТаблицаОС.Скопировать(Новый Структура("ОсновноеСредство", СтрокаДокумента.ОсновноеСредство));
		НайденнаяСтрока = ?(КопияТаблицыОС.Количество()=1, КопияТаблицыОС[0], КопияТаблицыОС.Найти(СтрокаДокумента.ИнвентарныйНомер, "ИнвНомер"));
	КонецЕсли;
	
	Возврат ПолучитьЗначениеРеквизитаСтроки(НайденнаяСтрока, ИмяРеквизита);
	
КонецФункции

// Функция проверяет, изменился ли МОЛ и подразделение.
// Используется для определения необходимости формирования проводок по счетам,
// на которых может вестись учет по МОЛ и в разрезе подразделений.
//
Функция ИзменилсяМОЛПодразделение(	МолОтправитель = Неопределено, 
									МолПолучатель = Неопределено, 
									ПодразделениеОтправитель = Неопределено, 
									ПодразделениеПолучатель = Неопределено, 
									УчитыватьФО = Истина,
									УчитыватьПризнакУчета = Истина,
									Знач СчетУчета = Неопределено) Экспорт
	
	Если СчетУчета = Неопределено Тогда
		СчетУчета = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	КонецЕсли;
	
	// Проверяем МОЛ.
	Если УчитыватьПризнакУчета Тогда
		Если БухгалтерскийУчетПовтИсп.НаСчетеВедетсяУчетПоЦМО(СчетУчета) Тогда
			Если МолОтправитель <> МолПолучатель Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;
	Иначе
		Если МолОтправитель <> МолПолучатель Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	// Проверяем подразделение.
	Если УчитыватьФО Тогда
		Если Не ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если УчитыватьПризнакУчета Тогда
		Если НЕ ЗначениеЗаполнено(СчетУчета) 
			ИЛИ НЕ БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетУчета).УчетПоПодразделениям Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ПодразделениеОтправитель <> ПодразделениеПолучатель;

КонецФункции

Функция МожноПровестиСписаниеИК(ДокументСсылка) Экспорт
	
	КПСиСчетУчетавТЧ = Ложь;
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПередачаОбъектовИК") 
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеОбъектовИК") Тогда
		ОСДокумента = ДокументСсылка.ОсновныеСредства.Выгрузить(,"ОсновноеСредство,КПС,СчетУчета,Количество,Сумма,СуммаАмортизации");
		КПСиСчетУчетавТЧ = Истина;
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеГруппОбъектовИК")
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПередачаГруппОбъектовИК") Тогда
		ОСДокумента = ДокументСсылка.ОсновныеСредства.Выгрузить(,"ОсновноеСредство,Количество,Сумма,СуммаАмортизации");
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПередачаЗданияИК")
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПередачаОбъектаИК")
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеТранспортаИК")
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеАвтотранспортаИК")
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеОбъектаИК") Тогда
		ОСДокумента = Новый ТаблицаЗначений;
		ОСДокумента.Колонки.Добавить("ОсновноеСредство",	Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
		ОСДокумента.Колонки.Добавить("Количество", 			Новый ОписаниеТипов("Число"));
		ОСДокумента.Колонки.Добавить("Сумма", 				Новый ОписаниеТипов("Число"));
		ОСДокумента.Колонки.Добавить("СуммаАмортизации", 	Новый ОписаниеТипов("Число"));
		СтрОС = ОСДокумента.Добавить();
		СтрОС.ОсновноеСредство 	= ДокументСсылка.ОсновноеСредство;
		СтрОС.Количество 		= 1;
		СтрОС.Сумма 			= ДокументСсылка.Сумма;
		СтрОС.СуммаАмортизации 	= ДокументСсылка.СуммаАмортизации;
	Иначе
