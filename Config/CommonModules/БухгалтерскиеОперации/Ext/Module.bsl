	|			ТОГДА ДанныеДок.ВалютнаяСуммаДт - ЕСТЬNULL(ОбъединеннаяТаблицаОстДвиж.ВалютнаяСуммаДт, 0)
	|		ИНАЧЕ -ДанныеДок.ВалютнаяСуммаДт + ЕСТЬNULL(ОбъединеннаяТаблицаОстДвиж.ВалютнаяСуммаДт, 0)
	|	КОНЕЦ КАК ВалютнаяСуммаДт,
	|	ВЫБОР
	|		КОГДА ДанныеДок.ВалютнаяСуммаКт > 0
	|			ТОГДА ДанныеДок.ВалютнаяСуммаКт - ЕСТЬNULL(ОбъединеннаяТаблицаОстДвиж.ВалютнаяСуммаКт, 0)
	|		ИНАЧЕ -ДанныеДок.ВалютнаяСуммаКт + ЕСТЬNULL(ОбъединеннаяТаблицаОстДвиж.ВалютнаяСуммаКт, 0)
	|	КОНЕЦ КАК ВалютнаяСуммаКт,
	|	ДанныеДок.ОсновноеСредство КАК ОсновноеСредство
	|ПОМЕСТИТЬ СоединенныеТаблицы
	|ИЗ
	|	ДанныеДок КАК ДанныеДок
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиПоРБ КАК ОбъединеннаяТаблицаОстДвиж
	|		ПО ДанныеДок.Подразделение = ОбъединеннаяТаблицаОстДвиж.Подразделение
	|			И ДанныеДок.Валюта = ОбъединеннаяТаблицаОстДвиж.Валюта
	|			И ДанныеДок.Субконто1 = ОбъединеннаяТаблицаОстДвиж.Субконто1
	|			И ДанныеДок.Субконто2 = ОбъединеннаяТаблицаОстДвиж.Субконто2
	|			И ДанныеДок.Субконто3 = ОбъединеннаяТаблицаОстДвиж.Субконто3
	|			И ДанныеДок.Счет = ОбъединеннаяТаблицаОстДвиж.Счет
	|			И (ВЫБОР
	|				КОГДА ДанныеДок.Счет.УчетПоКПС
	|					ТОГДА ДанныеДок.СтарыйКПС = ОбъединеннаяТаблицаОстДвиж.КПС
	|				ИНАЧЕ ИСТИНА
	|			КОНЕЦ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СоединенныеТаблицы.Счет КАК Счет,
	|	СоединенныеТаблицы.НомерСтроки КАК НомерСтроки,
	|	СоединенныеТаблицы.СтарыйКПС КАК СтарыйКПС,
	|	СоединенныеТаблицы.СуммаДт КАК СуммаДт,
	|	СоединенныеТаблицы.СуммаКт КАК СуммаКт,
	|	СоединенныеТаблицы.КоличествоДт КАК КоличествоДт,
	|	СоединенныеТаблицы.КоличествоКт КАК КоличествоКт,
	|	СоединенныеТаблицы.ВалютнаяСуммаДт КАК ВалютнаяСуммаДт,
	|	СоединенныеТаблицы.ВалютнаяСуммаКт КАК ВалютнаяСуммаКт,
	|	СоединенныеТаблицы.ОсновноеСредство КАК ОсновноеСредство
	|ИЗ
	|	СоединенныеТаблицы КАК СоединенныеТаблицы
	|ГДЕ
	|	(СоединенныеТаблицы.СуммаДт > 0
	|			ИЛИ СоединенныеТаблицы.СуммаКт > 0
	|			ИЛИ СоединенныеТаблицы.КоличествоДт > 0
	|			ИЛИ СоединенныеТаблицы.КоличествоКт > 0
	|			ИЛИ СоединенныеТаблицы.ВалютнаяСуммаДт > 0
	|			ИЛИ СоединенныеТаблицы.ВалютнаяСуммаКт > 0)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеДокАмортизация.ОсновноеСредство КАК ОсновноеСредство,
	|	ДанныеДокАмортизация.СчетАмортизации КАК СчетАмортизации,
	|	ДанныеДокАмортизация.СуммаАмортизации КАК СуммаАмортизации,
	|	ДанныеДокАмортизация.СтарыйКПС КАК СтарыйКПС,
	|	ДанныеДокАмортизация.Подразделение КАК Подразделение
	|ПОМЕСТИТЬ ТаблицаАмортизации
	|ИЗ
	|	Документ.ПереносОстатковПоКПС.ПереводАмортизации КАК ДанныеДокАмортизация
	|ГДЕ
	|	ДанныеДокАмортизация.СуммаАмортизации <> 0
	|	И ДанныеДокАмортизация.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Субконто1, НЕОПРЕДЕЛЕНО) КАК Субконто1,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОстатки.Счет.УчетПоКПС
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.КПС
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)
	|	КОНЕЦ КАК КПС,
	|	ВЫБОР
	|		КОГДА ИспользоватьУчетПоПодразделениям.Значение
	|				И ЖурналПроводокЕПСБУОстатки.Счет.УчетПоПодразделениям
	|			ТОГДА ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение,
	|	СУММА(ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.СуммаОстатокКт, 0)) КАК СуммаКт
	|ПОМЕСТИТЬ ОстаткиПоРБАмортизация
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&ДатаОстатков,
	|			Счет В
	|				(ВЫБРАТЬ
	|					ТаблицаАмортизации.СчетАмортизации
	|				ИЗ
	|					ТаблицаАмортизации КАК ТаблицаАмортизации),
	|			,
	|			КФО = &КФО
	|				И Организация = &Организация
	|				И ВЫБОР
	|					КОГДА &ОтборПоИФО
	|						ТОГДА ИФО = &ИФО
	|					ИНАЧЕ ИСТИНА
	|				КОНЕЦ
	|				И Субконто1 В
	|					(ВЫБРАТЬ
	|						ТаблицаАмортизации.ОсновноеСредство
	|					ИЗ
	|						ТаблицаАмортизации КАК ТаблицаАмортизации)) КАК ЖурналПроводокЕПСБУОстатки,
	|	Константа.ИспользоватьУчетПоПодразделениям КАК ИспользоватьУчетПоПодразделениям
	|ГДЕ
	|	ВЫБОР
	|			КОГДА &ОтборПоПодразделению
	|				ТОГДА ВЫБОР
	|						КОГДА ИспользоватьУчетПоПодразделениям.Значение
	|								И ЖурналПроводокЕПСБУОстатки.Счет.УчетПоПодразделениям
	|							ТОГДА ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))
	|						ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|					КОНЕЦ = &Подразделение
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|СГРУППИРОВАТЬ ПО
	|	ЖурналПроводокЕПСБУОстатки.Счет,
	|	ВЫБОР
	|		КОГДА ИспользоватьУчетПоПодразделениям.Значение
	|				И ЖурналПроводокЕПСБУОстатки.Счет.УчетПоПодразделениям
	|			ТОГДА ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Субконто1, НЕОПРЕДЕЛЕНО),
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОстатки.Счет.УчетПоКПС
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.КПС
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)
	|	КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаАмортизации.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаАмортизации.СчетАмортизации КАК СчетАмортизации,
	|	ВЫБОР
	|		КОГДА ТаблицаАмортизации.СуммаАмортизации > 0
	|			ТОГДА ТаблицаАмортизации.СуммаАмортизации - ЕСТЬNULL(ОбъединеннаяТаблицаАмортизация.СуммаКт, 0)
	|		ИНАЧЕ ТаблицаАмортизации.СуммаАмортизации + ЕСТЬNULL(ОбъединеннаяТаблицаАмортизация.СуммаКт, 0)
	|	КОНЕЦ КАК СуммаАмортизации,
	|	ТаблицаАмортизации.СтарыйКПС КАК СтарыйКПС,
	|	ТаблицаАмортизации.Подразделение КАК Подразделение
	|ПОМЕСТИТЬ СоединенныеТаблицыАмортизации
	|ИЗ
	|	ТаблицаАмортизации КАК ТаблицаАмортизации
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиПоРБАмортизация КАК ОбъединеннаяТаблицаАмортизация
	|		ПО ТаблицаАмортизации.ОсновноеСредство = ОбъединеннаяТаблицаАмортизация.Субконто1
	|			И ТаблицаАмортизации.СчетАмортизации = ОбъединеннаяТаблицаАмортизация.Счет
	|			И ТаблицаАмортизации.СтарыйКПС = ОбъединеннаяТаблицаАмортизация.КПС
	|			И ТаблицаАмортизации.Подразделение = ОбъединеннаяТаблицаАмортизация.Подразделение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СоединенныеТаблицыАмортизации.ОсновноеСредство КАК ОсновноеСредство,
	|	СоединенныеТаблицыАмортизации.СчетАмортизации КАК СчетАмортизации,
	|	СоединенныеТаблицыАмортизации.СуммаАмортизации КАК СуммаАмортизации,
	|	СоединенныеТаблицыАмортизации.Подразделение КАК Подразделение
	|ИЗ
	|	СоединенныеТаблицыАмортизации КАК СоединенныеТаблицыАмортизации
	|ГДЕ
	|	СоединенныеТаблицыАмортизации.СуммаАмортизации > 0";
	
	ЕстьОтборПоПодразделению = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") И ДанныеДокумента.ОтборПоПодразделению;
	ГраницаОстатков = БухгалтерскийУчет.КонецПериодаСУточнением(ДанныеДокумента.Дата, ДанныеДокумента.ВидМежотчетногоПериода); 
	
	Запрос.УстановитьПараметр("Ссылка"					, ДокументСсылка);
	Запрос.УстановитьПараметр("Организация"				, ДанныеДокумента.Организация);
	Запрос.УстановитьПараметр("КФО"						, ДанныеДокумента.КФО);
	Запрос.УстановитьПараметр("ИФО"						, ДанныеДокумента.ИФО);
	Запрос.УстановитьПараметр("ОтборПоИФО"				, ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Запрос.УстановитьПараметр("ДатаОстатков"			, ГраницаОстатков);
	Запрос.УстановитьПараметр("ОтборПоПодразделению"	, ЕстьОтборПоПодразделению);
	Запрос.УстановитьПараметр("Подразделение"			, ДанныеДокумента.Подразделение);
	
	Результат = Запрос.ВыполнитьПакет();
	
	// Стоимость
	Выборка = Результат[3].Выбрать();
	НомСообщения = 0;
	
	Пока Выборка.Следующий() Цикл
		
		СписокНедостач = Новый Массив;
		Если Выборка.СуммаДт > 0 Тогда
			СписокНедостач.Добавить(НСтр("ru = 'суммы (дт)'") + " " + Выборка.СуммаДт);
		КонецЕсли;
		Если Выборка.СуммаКт > 0 Тогда
			СписокНедостач.Добавить(НСтр("ru = 'суммы (кт)'") + " " + Выборка.СуммаКт);
		КонецЕсли;
		Если Выборка.КоличествоДт > 0 Тогда
			СписокНедостач.Добавить(НСтр("ru = 'количества (дт)'") + " " + Выборка.КоличествоДт);
		КонецЕсли;
		Если Выборка.КоличествоКт > 0 Тогда
			СписокНедостач.Добавить(НСтр("ru = 'количества (кт)'") + " " + Выборка.КоличествоКт);
		КонецЕсли;
		Если Выборка.ВалютнаяСуммаДт > 0 Тогда
			СписокНедостач.Добавить(НСтр("ru = 'вал. суммы (дт)'") + " " + Выборка.ВалютнаяСуммаДт);
		КонецЕсли;
		Если Выборка.ВалютнаяСуммаКт > 0 Тогда
			СписокНедостач.Добавить(НСтр("ru = 'вал. суммы (кт)'") + " " + Выборка.ВалютнаяСуммаКт);
		КонецЕсли;
		ТекстНедостачи = СтрСоединить(СписокНедостач, ", ");
		Шаблон = НСтр("ru = 'По основному средству ""%1"" не хватает %2'");
		ТекстСообщения = СтрШаблон(Шаблон, Выборка.ОсновноеСредство, ТекстНедостачи);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);
		
		НомСообщения = НомСообщения + 1;
		Если НомСообщения > 10 Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	//Амортизация
	Выборка = Результат[7].Выбрать();
	НомСообщения = 0;
	
	Пока Выборка.Следующий() Цикл
		
		ТекстНедостачи = "";
		Если Выборка.СуммаАмортизации > 0 Тогда
			ТекстНедостачи = "суммы амортизации "+ Выборка.СуммаАмортизации;
		КонецЕсли;
		Если ЕстьОтборПоПодразделению И ЗначениеЗаполнено(Выборка.Подразделение) Тогда
			ТекстНедостачи = ТекстНедостачи + " по подразделению "+ Выборка.Подразделение;
		КонецЕсли;
		Шаблон = НСтр("ru='По счету %1 для основного средства ""%2"" не хватает %3'");
		ТекстСообщения = СтрШаблон(Шаблон, Выборка.СчетАмортизации, Выборка.ОсновноеСредство, ТекстНедостачи);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);
		
		НомСообщения = НомСообщения + 1;
		Если НомСообщения > 10 Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Не Отказ;
	
КонецФункции

Функция УстановитьБлокировкуПоДокументуПереносКПСКФО_Расчеты(ДокументСсылка) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Отказ = Ложь;
	Блокировка = Новый БлокировкаДанных;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Переводы.СтарыйКПС,
	|	Переводы.Ссылка.КФО КАК КФО,
	|	Переводы.Счет КАК Счет,
	|	Переводы.Ссылка.Организация КАК Организация
	|ИЗ
	|	Документ.ПереносОстатковПоКПС.Переводы КАК Переводы
	|ГДЕ
	|	Переводы.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка",	ДокументСсылка);
	РезультатЗапроса = Запрос.Выполнить();
		
	ЭлементБлокировки = Блокировка.Добавить("РегистрБухгалтерии.ЖурналПроводокЕПСБУ");
	ЭлементБлокировки.ИсточникДанных = РезультатЗапроса;
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Счет",        "Счет");
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("КФО",         "КФО");
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("КПС",         "СтарыйКПС");
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Организация", "Организация");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;

	Попытка
		Блокировка.Заблокировать();
	Исключение
		Отказ = Истина;
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки());
	КонецПопытки;
		
	Возврат Не Отказ;
КонецФункции

Функция ПроверитьОстаткиДляПереносаКПСКФО_Расчеты(ДокументСсылка, УстанавливатьБлокировку = Ложь) Экспорт
	
	Отказ = Ложь;
	
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если УстанавливатьБлокировку Тогда
		Отказ = Не УстановитьБлокировкуПоОрганизацииДокументаПереносКПС(ДокументСсылка);
		Если Отказ Тогда
			Возврат Не Отказ;
		КонецЕсли;
	КонецЕсли;
	
	ДанныеДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка,
		"Дата, ВидМежотчетногоПериода, Организация, КФО, ИФО, ОтборПоПодразделению, Подразделение, Проведен");
	Если ДанныеДокумента.Проведен Тогда
		ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
