	|						ТОГДА ДанныеДок.Количество + ЕСТЬNULL(ОбъединеннаяТаблицаОстДвиж.Количество, 0)
	|					ИНАЧЕ -ДанныеДок.Количество - ЕСТЬNULL(ОбъединеннаяТаблицаОстДвиж.Количество, 0)
