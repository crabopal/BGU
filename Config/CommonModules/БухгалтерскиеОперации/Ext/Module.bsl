Функция СодержаниеПроводкиБСО(СодержаниеПроводки, БСО, Серия, НачальныйНомер, КонечныйНомер) Экспорт
	
	Если Не ЗначениеЗаполнено(НачальныйНомер) И НЕ ЗначениеЗаполнено(КонечныйНомер) Тогда
		ПредставлениеНомера = "";
	ИначеЕсли НачальныйНомер = КонечныйНомер Тогда
		ПредставлениеНомера = СокрЛП(НачальныйНомер);
	ИначеЕсли НЕ ЗначениеЗаполнено(НачальныйНомер) Тогда
		ПредставлениеНомера = СокрЛП(КонечныйНомер);
	ИначеЕсли НЕ ЗначениеЗаполнено(КонечныйНомер) Тогда
		ПредставлениеНомера = СокрЛП(НачальныйНомер);
	Иначе
		ПредставлениеНомера = СокрЛП(НачальныйНомер) + "-" + СокрЛП(КонечныйНомер);
	КонецЕсли;
	
	Возврат СодержаниеПроводки + " "
		+ БухгалтерскиеОперации.ПолноеНаименованиеОбъекта(БСО)
		+ ?(ЗначениеЗаполнено(Серия), "; " + БухгалтерскиеОперации.ПолноеНаименованиеОбъекта(Серия), "")
		+ ?(ЗначениеЗаполнено(ПредставлениеНомера), "; " + ПредставлениеНомера, "");
	
КонецФункции

