Функция ТекстОшибкиКЭКПроводки(ДанныеПроводки)

	ШаблонПараметра = "%1: %2";
	ИспользуемыеПараметры = Новый Массив;
	ИспользуемыеПараметры.Добавить(СтрШаблон(ШаблонПараметра, ДанныеПроводки.ДтКт));
	ИспользуемыеПараметры.Добавить(СтрШаблон(ШаблонПараметра, НСтр("ru = 'Организация'"), ДанныеПроводки.Организация));
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		ИспользуемыеПараметры.Добавить(СтрШаблон(ШаблонПараметра, НСтр("ru = 'ИФО'"), ДанныеПроводки.ИФО));
	КонецЕсли;
	ИспользуемыеПараметры.Добавить(СтрШаблон(ШаблонПараметра, НСтр("ru = 'Дата'"), ДанныеПроводки.Дата));
	ИспользуемыеПараметры.Добавить(СтрШаблон(ШаблонПараметра, НСтр("ru = 'Счет'"), ДанныеПроводки.Счет));
	Если ЗначениеЗаполнено(ДанныеПроводки.Субконто1) Тогда
		ИспользуемыеПараметры.Добавить(СтрШаблон(ШаблонПараметра, НСтр("ru = 'Субконто 1'"), ДанныеПроводки.Субконто1));
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеПроводки.Субконто2) Тогда
		ИспользуемыеПараметры.Добавить(СтрШаблон(ШаблонПараметра, НСтр("ru = 'Субконто 2'"), ДанныеПроводки.Субконто2));
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеПроводки.Субконто3) Тогда
		ИспользуемыеПараметры.Добавить(СтрШаблон(ШаблонПараметра, НСтр("ru = 'Субконто 3'"), ДанныеПроводки.Субконто3));
	КонецЕсли;
	
	ТекстОшибки = СтрШаблон(НСтр("ru = 'Не удалось опредить КЭК проводки. Используемые параметры:
		|%1'"), СтрСоединить(ИспользуемыеПараметры, Символы.ПС));
	
	Возврат ТекстОшибки;
	
КонецФункции

