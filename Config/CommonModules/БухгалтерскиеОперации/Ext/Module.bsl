	Возврат ТаблицаПользовательскихФункций;

КонецФункции // ПолучитьОписаниеПользовательскихФункций()

Функция ОписанияГруппПользовательскихФункций()
	
	ОписанияГрупп = Новый Соответствие;
	ДобавитьОписаниеГруппыПользовательскихФункций(ОписанияГрупп, "Общие", НСтр("ru = 'Общие функции'"), 1);
	ДобавитьОписаниеГруппыПользовательскихФункций(ОписанияГрупп, "ПланСчетов", НСтр("ru = 'План счетов, свойства счетов'"), 2);
	ДобавитьОписаниеГруппыПользовательскихФункций(ОписанияГрупп, "КЭК", НСтр("ru = 'КЭК'"), 3);
	ДобавитьОписаниеГруппыПользовательскихФункций(ОписанияГрупп, "КПС", НСтр("ru = 'КПС'"), 4);
	ДобавитьОписаниеГруппыПользовательскихФункций(ОписанияГрупп, "РП", НСтр("ru = 'Родительская плата'"), 5);
	ДобавитьОписаниеГруппыПользовательскихФункций(ОписанияГрупп, "ОС", НСтр("ru = 'Основные средства'"), 6);
	ДобавитьОписаниеГруппыПользовательскихФункций(ОписанияГрупп, "МЗ", НСтр("ru = 'Материальные запасы'"), 7);
	ДобавитьОписаниеГруппыПользовательскихФункций(ОписанияГрупп, "Услуги", НСтр("ru = 'Услуги, работы'"), 8);
	ДобавитьОписаниеГруппыПользовательскихФункций(ОписанияГрупп, "БСО", НСтр("ru = 'БСО'"), 9);
	ДобавитьОписаниеГруппыПользовательскихФункций(ОписанияГрупп, "НДС", НСтр("ru = 'НДС'"), 10);
	ДобавитьОписаниеГруппыПользовательскихФункций(ОписанияГрупп, "НУ", НСтр("ru = 'НУ'"), 11);
	ДобавитьОписаниеГруппыПользовательскихФункций(ОписанияГрупп, "УСН", НСтр("ru = 'УСН'"), 12);
	ДобавитьОписаниеГруппыПользовательскихФункций(ОписанияГрупп, "ВводНачальныхОстатков", НСтр("ru = 'Ввод начальных остатков'"), 90);
	ДобавитьОписаниеГруппыПользовательскихФункций(ОписанияГрупп, "Прочие", НСтр("ru = 'Прочие'"), 99);
	
	Возврат ОписанияГрупп;
	
КонецФункции

Процедура ДобавитьОписаниеГруппыПользовательскихФункций(ОписанияГрупп, Имя, Синоним, Порядок)
	ОписанияГрупп.Вставить(Имя, Новый Структура("Синоним, Порядок", Синоним, Порядок));
КонецПроцедуры

Функция ОписаниеГруппыПользовательскихФункцийПоИмени(Знач Имя)
	Если ПустаяСтрока(Имя) Тогда
		Имя = "Прочие";
	КонецЕсли;
	ОписаниеГруппы = ОписанияГруппПользовательскихФункций().Получить(Имя);
	
	Если ОписаниеГруппы = Неопределено Тогда
		ВызватьИсключение "Используется не корректное имя группы пользовательских функций: " + Имя;
	КонецЕсли;
	
	Возврат ОписаниеГруппы;
КонецФункции

// Добавляет новую строку в таблицу пользовательских функций. При добавлении имена функций
// указываются без имени модуля. Имя модуля подставляется автоматически.
//
// Параметры:
//  ТаблицаПользовательскихФункций	 - ТаблицаЗначений - Таблица, в которую добавляется функция.
//  ИмяФункции						 - Строка - имя функции без имени модуля.
//  ОписаниеФункции					 - Строка - описание функции для пользователя.
//  Используется					 - Булево - возможность отключения функции, чтобы пользователь не мог ее выбрать.
//
Процедура ДобавитьОписаниеПользовательскойФункции(ТаблицаПользовательскихФункций, ИмяФункции, ОписаниеФункции = "",
	Используется = Истина, Группа = "") Экспорт

	СтрокаФункции = ТаблицаПользовательскихФункций.Добавить();
	СтрокаФункции.ИмяФункции = ИмяФункции;
	СтрокаФункции.Используется = Используется;
	Если ПустаяСтрока(ОписаниеФункции) Тогда
		СтрокаФункции.Описание = НСтр("ru = '<Описание не задано>'");
	Иначе
		СтрокаФункции.Описание = ОписаниеФункции;
	КонецЕсли;
	
	ОписаниеГруппы = ОписаниеГруппыПользовательскихФункцийПоИмени(Группа);
	СтрокаФункции.СинонимГруппы = ОписаниеГруппы.Синоним;
	СтрокаФункции.ПорядокГруппы = ОписаниеГруппы.Порядок;

КонецПроцедуры

Процедура ЗаполнитьОписанияПользовательскихФункцийУсловийОпераций(ТаблицаФункций) Экспорт
	
	ДобавитьОписаниеПользовательскойФункции(ТаблицаФункций, "ДенежныхДокументовДостаточноДляСписания()",
		НСтр("ru = 'Проверяет достаточность остатка денежных документов для списания.
					|Если остатка недостаточно для списания, формирует сообщения пользователю.'"));
	ДобавитьОписаниеПользовательскойФункции(ТаблицаФункций, "КоличествоМЗвПутиДостаточноДляСписания(Документ.Ссылка, Документ.ИФО, ДополнительныеРеквизиты.КФО, ДополнительныеРеквизиты.КПСОперации, Документ.Подразделение, Документ.Контрагент, ДополнительныеРеквизиты.СчетУчетаМЗ)");
	ДобавитьОписаниеПользовательскойФункции(ТаблицаФункций, "КоличествоОСДостаточноДляСписания(Документ.Ссылка,  Документ.ИФО, Документ.КФО, Документ.КПС,  <ЦМО>, <Подразделение>, Истина, Ложь, ТиповаяОперация.УстанавливатьБлокировку)");
	ДобавитьОписаниеПользовательскойФункции(ТаблицаФункций, "МатериальныхЗапасовДостаточноДляСписания(<ВидУчета>)",
		НСтр("ru = 'Проверяет достаточность остатка материальных запасов для списания по указанному виду учета: ""БУ"", ""НУ"".
					|Если остатка материальных запасов недостаточно для списания, формирует сообщения пользователю.'"));
