Функция ПодготовитсяКСписаниюОСОперУчет(ДокументСсылка, УстанавливатьБлокировку = Ложь) Экспорт
	Отказ = Ложь;
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если УстанавливатьБлокировку Тогда
		Отказ = НЕ УстановитьБлокировкуПоДокументуОС(ДокументСсылка);
		Если Отказ Тогда
			Возврат Не Отказ;
		КонецЕсли;
	КонецЕсли;
	
	ТаблицаОС = БухгалтерскиеОперацииПовтИсп.ТаблицаОСДляСписанияОперУчет(ДокументСсылка);	
	
	Если ТаблицаОС = Неопределено Тогда
		Отказ = Истина;
		Возврат НЕ Отказ;
	КонецЕсли;
	
	Сумма = 0;
	СуммаАмортизации = 0;
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПередачаОбъектаОС") 
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПередачаЗдания") 
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеОбъектаОС") 
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеТранспорта") 
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеАвтотранспорта") Тогда
		
		Сумма = 0;
		Количество = 0;
		Если ТаблицаОС.Количество()>0 Тогда
			Сумма = ТаблицаОС[0].Сумма;
			Количество = ТаблицаОС[0].Количество;
		КонецЕсли;
							
		Если Количество>0 Тогда
			Цена = Сумма / Количество;
		Иначе
			Цена = 0;
		КонецЕсли;
		
		Сумма 				= Цена;
		СуммаАмортизации	= 0;
		
		Если ДокументСсылка.Сумма <> Сумма
			ИЛИ ДокументСсылка.СуммаАмортизации <> СуммаАмортизации Тогда
			
			ТекстСообщения = НСтр("ru='Балансовая стоимость или амортизация в документе не соответствуют остаткам в учете'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПередачаГруппОбъектовОС") 
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеГруппОбъектовОС") 		
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.АктСписанияМягкогоИХозИнвентаряОС") Тогда		
		
		КопияТЧ = ДокументСсылка.ОсновныеСредства.Выгрузить();
		КопияТЧ.Свернуть("ОсновноеСредство", "Количество, Сумма, СуммаАмортизации");
		
		Для каждого ТекСтрТЧ Из КопияТЧ Цикл
		
			ТекСтрОС = ТаблицаОС.Найти(ТекСтрТЧ.ОсновноеСредство, "ОсновноеСредство");
			Если ТекСтрОС = Неопределено Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не найдена стоимость %1'"),
																							""+ТекСтрТЧ.ОсновноеСредство.Наименование+"(код "+ТекСтрТЧ.ОсновноеСредство.Код+")");
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
			ИначеЕсли ТекСтрТЧ.Количество>ТекСтрОС.КоличествоМОЛ Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не хватает количества %1'"),
																							""+ТекСтрТЧ.ОсновноеСредство.Наименование+"(код "+ТекСтрТЧ.ОсновноеСредство.Код+")");
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
			КонецЕсли;				
				
		КонецЦикла; 
		
	//ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ТребованиеНакладнаяОС") Тогда		
	//	
	//	КопияТЧ = ДокументСсылка.ОсновныеСредства.Выгрузить();
