	|			И ДанныеДок.Субконто2 = ОбъединеннаяТаблицаОстДвиж.Субконто2
	|			И ДанныеДок.Субконто3 = ОбъединеннаяТаблицаОстДвиж.Субконто3
	|			И ДанныеДок.Счет = ОбъединеннаяТаблицаОстДвиж.Счет
	|			И (ВЫБОР
	|				КОГДА ДанныеДок.Счет.УчетПоКПС
	|					ТОГДА ДанныеДок.СтарыйКПС = ОбъединеннаяТаблицаОстДвиж.КПС
	|				ИНАЧЕ ИСТИНА
	|			КОНЕЦ)
	|			И ДанныеДок.КЭК = ОбъединеннаяТаблицаОстДвиж.КЭК
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СоединенныеТаблицы.Счет КАК Счет,
	|	СоединенныеТаблицы.НомерСтроки КАК НомерСтроки,
	|	СоединенныеТаблицы.СтарыйКПС КАК СтарыйКПС,
	|	СоединенныеТаблицы.СуммаДт КАК СуммаДт,
	|	СоединенныеТаблицы.СуммаКт КАК СуммаКт,
	|	СоединенныеТаблицы.КоличествоДт КАК КоличествоДт,
	|	СоединенныеТаблицы.КоличествоКт КАК КоличествоКт,
	|	СоединенныеТаблицы.ВалютнаяСуммаДт КАК ВалютнаяСуммаДт,
	|	СоединенныеТаблицы.ВалютнаяСуммаКт КАК ВалютнаяСуммаКт
	|ИЗ
	|	СоединенныеТаблицы КАК СоединенныеТаблицы
	|ГДЕ
	|	(СоединенныеТаблицы.СуммаДт > 0
	|			ИЛИ СоединенныеТаблицы.СуммаКт > 0
	|			ИЛИ СоединенныеТаблицы.КоличествоДт > 0
	|			ИЛИ СоединенныеТаблицы.КоличествоКт > 0
	|			ИЛИ СоединенныеТаблицы.ВалютнаяСуммаДт > 0
	|			ИЛИ СоединенныеТаблицы.ВалютнаяСуммаКт > 0)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	//Исправлено 22.06
	//ГраницаОстатков = БухгалтерскийУчет.КонецПериодаСУточнением(ДанныеДокумента.Дата, ДанныеДокумента.ВидМежотчетногоПериода);
	ГраницаОстатков = Новый Граница(КонецДня(ДанныеДокумента.Дата) + 1, ВидГраницы.Исключая);
	
	Запрос.УстановитьПараметр("Ссылка"					, ДокументСсылка);
	Запрос.УстановитьПараметр("Организация"				, ДанныеДокумента.Организация);
	Запрос.УстановитьПараметр("КФО"						, ДанныеДокумента.КФО);
	Запрос.УстановитьПараметр("ИФО"						, ДанныеДокумента.ИФО);
	Запрос.УстановитьПараметр("ОтборПоИФО"				, ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Запрос.УстановитьПараметр("ДатаОстатков"			, ГраницаОстатков);
	Запрос.УстановитьПараметр("ОтборПоПодразделению"	, ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") И ДанныеДокумента.ОтборПоПодразделению);
	Запрос.УстановитьПараметр("Подразделение"			, ДанныеДокумента.Подразделение);
	// Исправлено 22.06
	//Запрос.УстановитьПараметр("ОборотныеСчета"			, ПланыСчетов.ЕПСБУ.СчетаСОборотнымКЭК());
	
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	НомСообщения = 0;
	
	Пока Выборка.Следующий() Цикл
		
		СписокНедостач = Новый Массив;
		Если Выборка.СуммаДт > 0 Тогда
			СписокНедостач.Добавить("суммы (дт) " + Выборка.СуммаДт);
		КонецЕсли;
		Если Выборка.СуммаКт > 0 Тогда
			СписокНедостач.Добавить("суммы (кт) " + Выборка.СуммаКт);
		КонецЕсли;
		
		Если Выборка.КоличествоДт > 0 Тогда
			СписокНедостач.Добавить("количества (дт) " + Выборка.КоличествоДт);
		КонецЕсли;
		Если Выборка.КоличествоКт > 0 Тогда
			СписокНедостач.Добавить("количества (кт) " + Выборка.КоличествоКт);
		КонецЕсли;
		Если Выборка.ВалютнаяСуммаДт > 0 Тогда
			СписокНедостач.Добавить("вал. суммы (дт) " + Выборка.ВалютнаяСуммаДт);
		КонецЕсли;
		Если Выборка.ВалютнаяСуммаКт > 0 Тогда
			СписокНедостач.Добавить("вал. суммы (кт) " + Выборка.ВалютнаяСуммаКт);
		КонецЕсли;
		ТекстНедостачи = СтрСоединить(СписокНедостач, ", ");
		Шаблон = НСтр("ru='По счету %1 для строки %2 не хватает %3'");
		ТекстСообщения = СтрШаблон(Шаблон, Выборка.Счет, Выборка.НомерСтроки, ТекстНедостачи);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);
		
		НомСообщения = НомСообщения + 1;
		Если НомСообщения > 10 Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Не Отказ;
	
КонецФункции

Функция УстановитьБлокировкуПоОрганизацииДокументаПереносКПС(ДокументСсылка)
	
	Отказ = Ложь;
	ДанныеДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Организация, Дата");
	
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрБухгалтерии.ЖурналПроводокЕПСБУ");
	ЭлементБлокировки.УстановитьЗначение("Период", ДанныеДокумента.Дата);
	ЭлементБлокировки.УстановитьЗначение("Организация", ДанныеДокумента.Организация);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	Попытка
		Блокировка.Заблокировать();
	Исключение
		Отказ = Истина;
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки());
	КонецПопытки;
	
	Возврат Не Отказ;
	
КонецФункции


