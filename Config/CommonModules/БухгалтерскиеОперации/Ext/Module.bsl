	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Субконто1, НЕОПРЕДЕЛЕНО),
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Субконто2, НЕОПРЕДЕЛЕНО),
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Субконто3, НЕОПРЕДЕЛЕНО),
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОстатки.Счет.УчетПоКПС
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.КПС
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)
	|	КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеДок.Счет КАК Счет,
	|	ДанныеДок.Субконто1 КАК Субконто1,
	|	ДанныеДок.Субконто2 КАК Субконто2,
	|	ДанныеДок.СтарыйКПС КАК СтарыйКПС,
	|	ДанныеДок.Подразделение КАК Подразделение,
	|	ДанныеДок.Валюта КАК Валюта,
	|	ДанныеДок.КЭК КАК КЭК,
	|	ДанныеДок.НомерСтроки КАК НомерСтроки,
	|	ВЫБОР
	|		КОГДА ДанныеДок.СуммаДт > 0
	|			ТОГДА ДанныеДок.СуммаДт - ЕСТЬNULL(ОбъединеннаяТаблицаОстДвиж.СуммаДт, 0)
	|		ИНАЧЕ -ДанныеДок.СуммаДт + ЕСТЬNULL(ОбъединеннаяТаблицаОстДвиж.СуммаДт, 0)
	|	КОНЕЦ КАК СуммаДт,
	|	ВЫБОР
	|		КОГДА ДанныеДок.СуммаКт > 0
	|			ТОГДА ДанныеДок.СуммаКт - ЕСТЬNULL(ОбъединеннаяТаблицаОстДвиж.СуммаКт, 0)
	|		ИНАЧЕ -ДанныеДок.СуммаКт + ЕСТЬNULL(ОбъединеннаяТаблицаОстДвиж.СуммаКт, 0)
	|	КОНЕЦ КАК СуммаКт,
	|	ВЫБОР
	|		КОГДА ДанныеДок.КоличествоДт > 0
	|			ТОГДА ДанныеДок.КоличествоДт - ЕСТЬNULL(ОбъединеннаяТаблицаОстДвиж.КоличествоДт, 0)
	|		ИНАЧЕ -ДанныеДок.КоличествоДт + ЕСТЬNULL(ОбъединеннаяТаблицаОстДвиж.КоличествоДт, 0)
	|	КОНЕЦ КАК КоличествоДт,
	|	ВЫБОР
	|		КОГДА ДанныеДок.КоличествоКт > 0
	|			ТОГДА ДанныеДок.КоличествоКт - ЕСТЬNULL(ОбъединеннаяТаблицаОстДвиж.КоличествоКт, 0)
	|		ИНАЧЕ -ДанныеДок.КоличествоКт + ЕСТЬNULL(ОбъединеннаяТаблицаОстДвиж.КоличествоКт, 0)
	|	КОНЕЦ КАК КоличествоКт,
	|	ВЫБОР
	|		КОГДА ДанныеДок.ВалютнаяСуммаДт > 0
	|			ТОГДА ДанныеДок.ВалютнаяСуммаДт - ЕСТЬNULL(ОбъединеннаяТаблицаОстДвиж.ВалютнаяСуммаДт, 0)
	|		ИНАЧЕ -ДанныеДок.ВалютнаяСуммаДт + ЕСТЬNULL(ОбъединеннаяТаблицаОстДвиж.ВалютнаяСуммаДт, 0)
	|	КОНЕЦ КАК ВалютнаяСуммаДт,
	|	ВЫБОР
	|		КОГДА ДанныеДок.ВалютнаяСуммаКт > 0
	|			ТОГДА ДанныеДок.ВалютнаяСуммаКт - ЕСТЬNULL(ОбъединеннаяТаблицаОстДвиж.ВалютнаяСуммаКт, 0)
	|		ИНАЧЕ -ДанныеДок.ВалютнаяСуммаКт + ЕСТЬNULL(ОбъединеннаяТаблицаОстДвиж.ВалютнаяСуммаКт, 0)
	|	КОНЕЦ КАК ВалютнаяСуммаКт
	|ПОМЕСТИТЬ СоединенныеТаблицы
	|ИЗ
	|	ДанныеДок КАК ДанныеДок
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиПоРБ КАК ОбъединеннаяТаблицаОстДвиж
	|		ПО (ДанныеДок.КЭК = ЕСТЬNULL(ОбъединеннаяТаблицаОстДвиж.КЭК, ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)))
	|			И ДанныеДок.Подразделение = ОбъединеннаяТаблицаОстДвиж.Подразделение
	|			И ДанныеДок.Валюта = ОбъединеннаяТаблицаОстДвиж.Валюта
	|			И ДанныеДок.Субконто1 = ОбъединеннаяТаблицаОстДвиж.Субконто1
	|			И ДанныеДок.Субконто2 = ОбъединеннаяТаблицаОстДвиж.Субконто2
	|			И ДанныеДок.Субконто3 = ОбъединеннаяТаблицаОстДвиж.Субконто3
	|			И ДанныеДок.Счет = ОбъединеннаяТаблицаОстДвиж.Счет
	|			И (ВЫБОР
	|				КОГДА ДанныеДок.Счет.УчетПоКПС
	|					ТОГДА ДанныеДок.СтарыйКПС = ОбъединеннаяТаблицаОстДвиж.КПС
	|				ИНАЧЕ ИСТИНА
	|			КОНЕЦ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СоединенныеТаблицы.Счет КАК Счет,
	|	СоединенныеТаблицы.НомерСтроки КАК НомерСтроки,
	|	СоединенныеТаблицы.СтарыйКПС КАК СтарыйКПС,
	|	СоединенныеТаблицы.СуммаДт КАК СуммаДт,
	|	СоединенныеТаблицы.СуммаКт КАК СуммаКт,
	|	СоединенныеТаблицы.КоличествоДт КАК КоличествоДт,
	|	СоединенныеТаблицы.КоличествоКт КАК КоличествоКт,
	|	СоединенныеТаблицы.ВалютнаяСуммаДт КАК ВалютнаяСуммаДт,
	|	СоединенныеТаблицы.ВалютнаяСуммаКт КАК ВалютнаяСуммаКт
	|ИЗ
	|	СоединенныеТаблицы КАК СоединенныеТаблицы
	|ГДЕ
	|	(СоединенныеТаблицы.СуммаДт > 0
	|			ИЛИ СоединенныеТаблицы.СуммаКт > 0
	|			ИЛИ СоединенныеТаблицы.КоличествоДт > 0
	|			ИЛИ СоединенныеТаблицы.КоличествоКт > 0
	|			ИЛИ СоединенныеТаблицы.ВалютнаяСуммаДт > 0
	|			ИЛИ СоединенныеТаблицы.ВалютнаяСуммаКт > 0)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	ГраницаОстатков = БухгалтерскийУчет.КонецПериодаСУточнением(ДанныеДокумента.Дата, ДанныеДокумента.ВидМежотчетногоПериода); 
	
	Запрос.УстановитьПараметр("Ссылка"					, ДокументСсылка);
	Запрос.УстановитьПараметр("Организация"				, ДанныеДокумента.Организация);
	Запрос.УстановитьПараметр("КФО"						, ДанныеДокумента.КФО);
	Запрос.УстановитьПараметр("ИФО"						, ДанныеДокумента.ИФО);
	Запрос.УстановитьПараметр("ОтборПоИФО"				, ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Запрос.УстановитьПараметр("ДатаОстатков"			, ГраницаОстатков);
	Запрос.УстановитьПараметр("ОтборПоПодразделению"	, ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") И ДанныеДокумента.ОтборПоПодразделению);
	Запрос.УстановитьПараметр("Подразделение"			, ДанныеДокумента.Подразделение);
	
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	НомСообщения = 0;
	
	Пока Выборка.Следующий() Цикл
		
		СписокНедостач = Новый Массив;
		Если Выборка.СуммаДт > 0 Тогда
			СписокНедостач.Добавить("суммы (дт) " + Выборка.СуммаДт);
		КонецЕсли;
		Если Выборка.СуммаКт > 0 Тогда
			СписокНедостач.Добавить("суммы (кт) " + Выборка.СуммаКт);
		КонецЕсли;
		
		Если Выборка.КоличествоДт > 0 Тогда
			СписокНедостач.Добавить("количества (дт) " + Выборка.КоличествоДт);
		КонецЕсли;
		Если Выборка.КоличествоКт > 0 Тогда
			СписокНедостач.Добавить("количества (кт) " + Выборка.КоличествоКт);
		КонецЕсли;
		Если Выборка.ВалютнаяСуммаДт > 0 Тогда
			СписокНедостач.Добавить("вал. суммы (дт) " + Выборка.ВалютнаяСуммаДт);
		КонецЕсли;
		Если Выборка.ВалютнаяСуммаКт > 0 Тогда
			СписокНедостач.Добавить("вал. суммы (кт) " + Выборка.ВалютнаяСуммаКт);
		КонецЕсли;
		ТекстНедостачи = СтрСоединить(СписокНедостач, ", ");
		Шаблон = НСтр("ru='Для строки %1 не хватает %2'");
		ТекстСообщения = СтрШаблон(Шаблон, Выборка.НомерСтроки, ТекстНедостачи);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);
		
		НомСообщения = НомСообщения + 1;
		Если НомСообщения > 10 Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Не Отказ;
	
КонецФункции

Функция УстановитьБлокировкуПоДокументуПереносКПСКФО_МЗ(ДокументСсылка) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Отказ = Ложь;
	Блокировка = Новый БлокировкаДанных;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Переводы.СтарыйКПС,
	|	Переводы.Ссылка.КФО КАК КФО,
	|	Переводы.Счет КАК Счет,
	|	Переводы.Ссылка.Организация КАК Организация
	|ИЗ
	|	Документ.ПереносОстатковПоКПС.Переводы КАК Переводы
	|ГДЕ
	|	Переводы.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка",	ДокументСсылка);
	РезультатЗапроса = Запрос.Выполнить();
		
	ЭлементБлокировки = Блокировка.Добавить("РегистрБухгалтерии.ЖурналПроводокЕПСБУ");
	ЭлементБлокировки.ИсточникДанных = РезультатЗапроса;
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Счет",        "Счет");
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("КФО",         "КФО");
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("КПС",         "СтарыйКПС");
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Организация", "Организация");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;

	Попытка
		Блокировка.Заблокировать();
	Исключение
		Отказ = Истина;
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки());
	КонецПопытки;
	
	Возврат Не Отказ;
КонецФункции

Функция ПроверитьОстаткиДляПереносаКПСКФО_МЗ(ДокументСсылка, УстанавливатьБлокировку = Ложь) Экспорт
	
	Отказ = Ложь;
	
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если УстанавливатьБлокировку Тогда
		Отказ = Не УстановитьБлокировкуПоОрганизацииДокументаПереносКПС(ДокументСсылка);
		Если Отказ Тогда
			Возврат Не Отказ;
		КонецЕсли;
	КонецЕсли;
	
	ДанныеДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка,
		"Дата, ВидМежотчетногоПериода, Организация, КФО, ИФО, ОтборПоПодразделению, Подразделение, Проведен");
	Если ДанныеДокумента.Проведен Тогда
		ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
		ОбщегоНазначенияБГУ.УдалитьДвиженияДокумента(ДокументОбъект.Движения,"ЖурналПроводокЕПСБУ");
		ДокументОбъект.Движения.ЖурналПроводокЕПСБУ.Записывать = Истина;
		ДокументОбъект.Движения.ЖурналПроводокЕПСБУ.Записать();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПереносОстатковПоКПСПереводы.Счет КАК Счет,
	|	ВЫБОР
	|		КОГДА ПереносОстатковПоКПСПереводы.Субконто1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ПереносОстатковПоКПСПереводы.Субконто1
	|	КОНЕЦ КАК Субконто1,
	|	ВЫБОР
	|		КОГДА ПереносОстатковПоКПСПереводы.Субконто2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ПереносОстатковПоКПСПереводы.Субконто2
	|	КОНЕЦ КАК Субконто2,
	|	ВЫБОР
	|		КОГДА ПереносОстатковПоКПСПереводы.Субконто3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ПереносОстатковПоКПСПереводы.Субконто3
	|	КОНЕЦ КАК Субконто3,
	|	ПереносОстатковПоКПСПереводы.СтарыйКПС КАК СтарыйКПС,
	|	ВЫБОР
	|		КОГДА ИспользоватьУчетПоПодразделениям.Значение
	|				И ЕПСБУ.УчетПоПодразделениям
	|			ТОГДА ПереносОстатковПоКПСПереводы.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение,
	|	ВЫБОР
	|		КОГДА ИспользоватьВалютныйУчет.Значение
	|				И ЕПСБУ.Валютный
	|			ТОГДА ПереносОстатковПоКПСПереводы.Валюта
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|	КОНЕЦ КАК Валюта,
	|	МИНИМУМ(ПереносОстатковПоКПСПереводы.НомерСтроки) КАК НомерСтроки,
	|	СУММА(ПереносОстатковПоКПСПереводы.СуммаДт) КАК СуммаДт,
	|	СУММА(ПереносОстатковПоКПСПереводы.СуммаКт) КАК СуммаКт,
	|	СУММА(ВЫБОР
	|			КОГДА ИспользоватьВалютныйУчет.Значение
	|					И ЕПСБУ.Валютный
	|				ТОГДА ПереносОстатковПоКПСПереводы.ВалютнаяСуммаДт
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ВалютнаяСуммаДт,
	|	СУММА(ВЫБОР
	|			КОГДА ИспользоватьВалютныйУчет.Значение
	|					И ЕПСБУ.Валютный
	|				ТОГДА ПереносОстатковПоКПСПереводы.ВалютнаяСуммаКт
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ВалютнаяСуммаКт,
	|	СУММА(ВЫБОР
	|			КОГДА ЕПСБУ.Количественный
	|				ТОГДА ПереносОстатковПоКПСПереводы.КоличествоДт
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоДт,
	|	СУММА(ВЫБОР
	|			КОГДА ЕПСБУ.Количественный
	|				ТОГДА ПереносОстатковПоКПСПереводы.КоличествоКт
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоКт
	|ПОМЕСТИТЬ ДанныеДок
	|ИЗ
	|	Документ.ПереносОстатковПоКПС.Переводы КАК ПереносОстатковПоКПСПереводы
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ПО ПереносОстатковПоКПСПереводы.Счет = ЕПСБУ.Ссылка,
	|	Константа.ИспользоватьВалютныйУчет КАК ИспользоватьВалютныйУчет,
	|	Константа.ИспользоватьУчетПоПодразделениям КАК ИспользоватьУчетПоПодразделениям
	|ГДЕ
	|	ПереносОстатковПоКПСПереводы.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ПереносОстатковПоКПСПереводы.Счет,
	|	ПереносОстатковПоКПСПереводы.СтарыйКПС,
	|	ВЫБОР
	|		КОГДА ИспользоватьВалютныйУчет.Значение
	|				И ЕПСБУ.Валютный
	|			ТОГДА ПереносОстатковПоКПСПереводы.Валюта
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ИспользоватьУчетПоПодразделениям.Значение
	|				И ЕПСБУ.УчетПоПодразделениям
	|			ТОГДА ПереносОстатковПоКПСПереводы.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА ПереносОстатковПоКПСПереводы.Субконто1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка)
	|			ТОГДА НЕОПРЕДЕЛЕНО
