Функция ВычислитьСуммуПоРасчитаннойСреднейЦенеВА(ДокументСсылка,
												НомерСтроки,
												ВнеоборотныйАктив,
												Знач ИФО = Неопределено,
												Знач КФО = Неопределено,
												Знач КПС = Неопределено,
												Знач ЦМО = Неопределено,
												Знач Подразделение = Неопределено,
												Количество) Экспорт
	БалансовыеСчета = Ложь;
	ЗабалансовыеСчета = Ложь;
	Вложения = Истина;
	
	Если НЕ ЗначениеЗаполнено(ИФО) Тогда
		ИФО = Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(КФО) Тогда
		КФО = Перечисления.КВД.ПустаяСсылка();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(КПС) Тогда
		КПС = Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ЦМО) Тогда
		ЦМО = Справочники.ЦМО.ПустаяСсылка();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Подразделение) Тогда
		Подразделение = Справочники.Подразделения.ПустаяСсылка();
	КонецЕсли;
	ИспПодразделение = ?(ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"), Подразделение, Неопределено);
	
	ИмяТЧ = "ОсновныеСредства";
	КолонкаОС = "ОсновноеСредство";
	КолонкаКоличество = "Количество";
	
	ТаблицаОС = БухгалтерскиеОперацииПовтИсп.ПолучитьОстаткиОС(ДокументСсылка,
															ДокументСсылка.Дата,
															ИмяТЧ,
															КолонкаОС,
															КолонкаКоличество,
															ЦМО,
															КФО,
															КПС,
															ИФО,
															ИспПодразделение,
															БалансовыеСчета,
															ЗабалансовыеСчета,
															Вложения,
															ВнеоборотныйАктив);
	СтрокаОС = ТаблицаОС.Найти(ВнеоборотныйАктив, "ОсновноеСредство");					
	Если СтрокаОС = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	Если Количество = СтрокаОС.КоличествоОстаток Тогда
		СуммаПроводки = СтрокаОС.СуммаОстаток;
	ИначеЕсли СтрокаОС.КоличествоОстаток = СтрокаОС.КоличествоДокумента Тогда
		Цена = СтрокаОС.СуммаОстаток / СтрокаОС.КоличествоОстаток;
		СуммаПроводки = Окр(Цена * Количество, 2);
		Если Цена <> Окр(Цена, 2) Тогда
			// если документом списывается все доступное количество материала, несколькими строчками документа
			// и есть округление цены, то необходимо в последней строке сделать корректировку суммы, чтоб списать
			// всю стоимость
			Отбор = Новый Структура("ОсновноеСредство", ВнеоборотныйАктив);
			МассивСтрокДокумента = ДокументСсылка[ИмяТЧ].НайтиСтроки(Отбор);
			ЭтоПоследняяСтрока = Истина;
			РаспределилиСумму = 0;
			Для Каждого ТекСтрокаДокумента Из МассивСтрокДокумента Цикл
				
				Если ТекСтрокаДокумента.НомерСтроки > НомерСтроки Тогда
					ЭтоПоследняяСтрока = Ложь;
					Прервать;
				ИначеЕсли ТекСтрокаДокумента.НомерСтроки <> НомерСтроки Тогда
					РаспределилиСумму = РаспределилиСумму + Окр(Цена * ТекСтрокаДокумента.Количество, 2);	
				КонецЕсли;
				
			КонецЦикла;
			
			Если ЭтоПоследняяСтрока Тогда
				
				СуммаПроводки = СтрокаОС.СуммаОстаток - РаспределилиСумму;		
								
			КонецЕсли;
			
		КонецЕсли;
	Иначе
		Цена = СтрокаОС.СуммаОстаток / СтрокаОС.КоличествоОстаток;
		СуммаПроводки = Окр(Цена * Количество, 2);
	КонецЕсли;
	
	Возврат СуммаПроводки;
КонецФункции											

Функция ВычислитьСуммуПоРасчитаннойСреднейЦенеОС(ДокументСсылка,
												НомерСтроки,
												ОсновноеСредство,
												Знач ИФО = Неопределено,
												Знач КФО = Неопределено,
												Знач КПС = Неопределено,
												Знач ЦМО = Неопределено,
												Знач Подразделение = Неопределено,
												Количество,
												БалансЗабаланс = "",
												Вложения = Ложь) Экспорт
	БалансовыеСчета = Ложь;
	ЗабалансовыеСчета = Ложь;
	Если БалансЗабаланс = "Бал" Тогда
		БалансовыеСчета = Истина;
	ИначеЕсли БалансЗабаланс = "Заб" Тогда
		ЗабалансовыеСчета = Истина;
	ИначеЕсли НЕ Вложения Тогда
		Возврат 0;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ИФО) Тогда
		ИФО = Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(КФО) Тогда
		КФО = Перечисления.КВД.ПустаяСсылка();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(КПС) Тогда
		КПС = Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ЦМО) Тогда
		ЦМО = Справочники.ЦМО.ПустаяСсылка();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Подразделение) Тогда
		Подразделение = Справочники.Подразделения.ПустаяСсылка();
	КонецЕсли;
	ИспПодразделение = ?(ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"), Подразделение, Неопределено);
	
	ИмяТЧ = "ОсновныеСредства";
	КолонкаОС = "ОсновноеСредство";
	КолонкаКоличество = "Количество";
	
	ТаблицаОС = БухгалтерскиеОперацииПовтИсп.ПолучитьОстаткиОС(ДокументСсылка,
															ДокументСсылка.Дата,
															ИмяТЧ,
															КолонкаОС,
															КолонкаКоличество,
															ЦМО,
															КФО,
															КПС,
															ИФО,
															ИспПодразделение,
															БалансовыеСчета,
															ЗабалансовыеСчета,
															Вложения);
	СтрокаОС = ТаблицаОС.Найти(ОсновноеСредство, "ОсновноеСредство");
	Если СтрокаОС = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	Если Количество = СтрокаОС.КоличествоОстаток Тогда
		СуммаПроводки = СтрокаОС.СуммаОстаток;
	ИначеЕсли СтрокаОС.КоличествоОстаток = СтрокаОС.КоличествоДокумента Тогда
		Цена = СтрокаОС.СуммаОстаток / СтрокаОС.КоличествоОстаток;
		СуммаПроводки = Окр(Цена * Количество, 2);
		Если Цена <> Окр(Цена, 2) Тогда
			// если документом списывается все доступное количество материала, несколькими строчками документа
			// и есть округление цены, то необходимо в последней строке сделать корректировку суммы, чтоб списать
			// всю стоимость
			Отбор = Новый Структура("ОсновноеСредство", ОсновноеСредство);
			МассивСтрокДокумента = ДокументСсылка[ИмяТЧ].НайтиСтроки(Отбор);
			ЭтоПоследняяСтрока = Истина;
			РаспределилиСумму = 0;
			Для Каждого ТекСтрокаДокумента Из МассивСтрокДокумента Цикл
				
				Если ТекСтрокаДокумента.НомерСтроки > НомерСтроки Тогда
					ЭтоПоследняяСтрока = Ложь;
					Прервать;
				ИначеЕсли ТекСтрокаДокумента.НомерСтроки <> НомерСтроки Тогда
					РаспределилиСумму = РаспределилиСумму + Окр(Цена * ТекСтрокаДокумента.Количество, 2);
				КонецЕсли;
				
			КонецЦикла;
			
			Если ЭтоПоследняяСтрока Тогда
				
				СуммаПроводки = СтрокаОС.СуммаОстаток - РаспределилиСумму;
				
			КонецЕсли;
			
		КонецЕсли;
	Иначе
		Цена = ?(СтрокаОС.КоличествоОстаток = 0, 0, СтрокаОС.СуммаОстаток / СтрокаОС.КоличествоОстаток);
		СуммаПроводки = Окр(Цена * Количество, 2);
	КонецЕсли;
	
	Возврат СуммаПроводки;
	
КонецФункции

