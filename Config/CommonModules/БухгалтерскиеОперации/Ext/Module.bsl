// Процедура устанавливает последнюю ошибку и функцию в контекст проведения. Вызывается из функции "ПроверитьЗаполнение".
// Если контекст проведения не передан, то он будет получен из временного хранилища и, после изменения, помещен назад.
//
// Параметры:
//  ТекстОшибки			 - Строка - текст ошибки,
//  ИмяФункции			 - Строка - имя функции, где произошла ошибка,
//  КонтекстПроведения	 - Структура - контекст проведения операции,
//						- Неопределено - будет изменен контекст во временном хранилище.
Процедура ДобавитьОшибкуВКонтекстПроведения(ТекстОшибки, ИмяФункции, Знач КонтекстПроведения = Неопределено) Экспорт
	ПолучитьКонтекстПроведения = КонтекстПроведения = Неопределено;
	Если ПолучитьКонтекстПроведения Тогда
		КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	КонецЕсли;
	Если КонтекстПроведения.Свойство("ПоследняяОшибка") Тогда
		КонтекстПроведения.ПоследняяОшибка 	= ТекстОшибки;
		КонтекстПроведения.ПоследняяФункция	= ВРЕГ(ИмяФункции);
	КонецЕсли;
	Если ПолучитьКонтекстПроведения Тогда
		БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	КонецЕсли;
КонецПроцедуры

Функция ПроверитьЗаполнение(ЗначениеЗаполнения, ТекстФормулы, ИмяТабличнойЧасти, НомерСтроки = 0, ПрерыватьОбработку = Ложь) Экспорт

	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	Если КонтекстПроведения.ПроверятьЗаполнениеРеквизитов
			И НЕ ЗначениеЗаполнено(ЗначениеЗаполнения) Тогда
		ОбработатьНезаполненныйРеквизит(ТекстФормулы, ИмяТабличнойЧасти, НомерСтроки, ПрерыватьОбработку);
	КонецЕсли;
	
	Возврат ЗначениеЗаполнения;

КонецФункции // ПроверитьЗаполнение()

Процедура ОбработатьНезаполненныйРеквизит(ТекстФормулы, ИмяТабличнойЧасти, НомерСтроки, ПрерыватьОбработку)
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	КонтекстПроведения.Отказ = Истина;
	
	ТиповаяОперация = КонтекстПроведения.ТиповаяОперация;
	ИдентификаторДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТиповаяОперация, "ИдентификаторДокумента");
	
	Если Лев(ТекстФормулы, 24) = "ДОПОЛНИТЕЛЬНЫЕРЕКВИЗИТЫ." Тогда
		ИмяРеквизита 	= Сред(ТекстФормулы, 25);
		ИмяПоляОшибки	= ИмяРеквизита;
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	РеквизитыТиповыхОпераций.Наименование
		               |ИЗ
		               |	Справочник.РеквизитыТиповыхОпераций КАК РеквизитыТиповыхОпераций
		               |ГДЕ
		               |	РеквизитыТиповыхОпераций.Владелец = &ТиповаяОперация
		               |	И НЕ РеквизитыТиповыхОпераций.ЭтоГруппа
		               |	И НЕ РеквизитыТиповыхОпераций.ПометкаУдаления
		               |	И РеквизитыТиповыхОпераций.ИмяДляФормулы = &ИмяДляФормулы";
		Запрос.УстановитьПараметр("ТиповаяОперация",	ТиповаяОперация);
		Запрос.УстановитьПараметр("ИмяДляФормулы",		ИмяРеквизита);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ЗаголовокРеквизита = Выборка.Наименование;
		Иначе
			ЗаголовокРеквизита = ИмяРеквизита;
		КонецЕсли;
		
		ТекстОшибки 	= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
														НСтр("ru = 'Не заполнен обязательный дополнительный реквизит операции ""%1""'"),
														ЗаголовокРеквизита);
	ИначеЕсли Лев(ТекстФормулы, 9) = "ДОКУМЕНТ." Тогда
		ИмяРеквизита 		= Сред(ТекстФормулы, 10);
		ИмяПоляОшибки		= "Объект." + ИмяРеквизита;
		ЗаголовокРеквизита 	= "";
		
		Если ЗначениеЗаполнено(ИдентификаторДокумента) Тогда
			МетаданныеДокумента = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(ИдентификаторДокумента);
			Реквизит = МетаданныеДокумента.Реквизиты.Найти(ИмяРеквизита);
			Если Реквизит <> Неопределено Тогда
				ЗаголовокРеквизита = Реквизит.Синоним;
			Иначе
				ЗаголовокРеквизита = ИмяРеквизита;
			КонецЕсли;
		Иначе
			ЗаголовокРеквизита = ИмяРеквизита;
		КонецЕсли;
		
		ТекстОшибки 	= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
														НСтр("ru = 'Не заполнен реквизит документа ""%1""'"),
														ЗаголовокРеквизита);
	ИначеЕсли Лев(ТекстФормулы, 14) = "СТРОКАТАБЛИЦЫ." Тогда
		
		ЗаголовокРеквизита 				= "";
		ПредставлениеТабличнойЧасти 	= "";
		ИмяРеквизита 					= Сред(ТекстФормулы, 15);
		
		Если ЗначениеЗаполнено(ИдентификаторДокумента) Тогда
			МетаданныеДокумента = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(ИдентификаторДокумента);
			
			ТабличнаяЧасть	= МетаданныеДокумента.ТабличныеЧасти.Найти(ИмяТабличнойЧасти);
			Если ТабличнаяЧасть <> Неопределено Тогда
				ПредставлениеТабличнойЧасти = ТабличнаяЧасть.Синоним;
				Реквизит = ТабличнаяЧасть.Реквизиты.Найти(ИмяРеквизита);
				Если Реквизит <> Неопределено Тогда
					ЗаголовокРеквизита = Реквизит.Синоним;
				Иначе
					ЗаголовокРеквизита = ИмяРеквизита;
				КонецЕсли;
			Иначе
				ДополнительныеИсточникДанных = Справочники.ДополнительныеИсточникиДанныхДляТиповыхОпераций.ПолучитьИсточникиДанных(ТиповаяОперация);
				СтрокаИсточникДанных = ДополнительныеИсточникДанных.Найти(ИмяТабличнойЧасти, "ИмяИсточника");
				Если СтрокаИсточникДанных <> Неопределено Тогда
					ПредставлениеТабличнойЧасти = СтрокаИсточникДанных.Наименование + " (дополнительный источник данных)";
					ЗаголовокРеквизита = ИмяРеквизита;
				КонецЕсли;
			КонецЕсли;
		Иначе
			ЗаголовокРеквизита = ИмяРеквизита;	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(НомерСтроки) Тогда
			ИмяПоляОшибки	= "Объект." + ИмяТабличнойЧасти + "[" + (НомерСтроки - 1) + "]." + ИмяРеквизита;
			ТекстОшибки 	= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
								НСтр("ru = 'Не заполнен реквизит ""%1"" в строке %2 таблицы ""%3""'"),
								ЗаголовокРеквизита,
								Строка(НомерСтроки),
								ПредставлениеТабличнойЧасти);
		Иначе
			ИмяПоляОшибки	= "Объект." + ИмяТабличнойЧасти;
			ТекстОшибки 	= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
								НСтр("ru = 'Не заполнен реквизит ""%1"" в строке таблицы ""%2""'"),
								ЗаголовокРеквизита,
								ПредставлениеТабличнойЧасти);
		КонецЕсли;
	Иначе
		ИмяПоляОшибки 	= "";
		//КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
		Если НЕ ПустаяСтрока(КонтекстПроведения.ПоследняяОшибка)
			И (КонтекстПроведения.ПоследняяФункция = ТекстФормулы
				ИЛИ "БУХГАЛТЕРСКИЕОПЕРАЦИИ." + КонтекстПроведения.ПоследняяФункция = ТекстФормулы
				ИЛИ "БУХГАЛТЕРСКИЕОПЕРАЦИИПЕРЕОПРЕДЕЛЯЕМЫЙ." + КонтекстПроведения.ПоследняяФункция = ТекстФормулы) Тогда
			ТекстОшибки		= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
															НСтр("ru = 'Ошибка вычисления формулы ""%2"".
																	|%1'"),
															//НСтр("ru = '%1 в формуле ""%2""'"),
															КонтекстПроведения.ПоследняяОшибка,
															СтрЗаменить(ТекстФормулы, """", """"""));
		Иначе
			ТекстОшибки		= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
															НСтр("ru = 'Не заполнен реквизит по формуле ""%1""'"),
															СтрЗаменить(ТекстФормулы, """", """"""));
		КонецЕсли;
		Если Не ПустаяСтрока(ИмяТабличнойЧасти) И ЗначениеЗаполнено(НомерСтроки) Тогда			
			Если ЗначениеЗаполнено(ИдентификаторДокумента) Тогда
				МетаданныеДокумента = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(ИдентификаторДокумента);
			
				ТабличнаяЧасть	= МетаданныеДокумента.ТабличныеЧасти.Найти(ИмяТабличнойЧасти);
				Если ТабличнаяЧасть <> Неопределено Тогда
					ПредставлениеТабличнойЧасти = ТабличнаяЧасть.Синоним;
				Иначе
					ПредставлениеТабличнойЧасти = ИмяТабличнойЧасти;
				КонецЕсли;
			Иначе
				ПредставлениеТабличнойЧасти = ИмяТабличнойЧасти;
			КонецЕсли;
			
			ПредставлениеТабличнойЧасти = ИмяТабличнойЧасти;
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
									НСтр("ru = 'Ошибка в строке %1 таблицы ""%2"". %3'"),
									Строка(НомерСтроки),
									ПредставлениеТабличнойЧасти,
									ТекстОшибки);
				
		КонецЕсли;
		
	КонецЕсли;
	
	БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстОшибки, ИмяПоляОшибки,,КонтекстПроведения);
	
	Если ПрерыватьОбработку И НЕ КонтекстПроведения.Свойство("ТестовоеЗаполнение") Тогда
		КонтекстПроведения.ИсключениеПриПроверкеЗаполнения = Истина;
		БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	
КонецПроцедуры

Функция ПолучитьЗначениеРеквизитаСтроки(Строка, ИмяРеквизита)
	
	Если Строка = Неопределено Тогда
		ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Ошибка определения реквизита %1'"), ИмяРеквизита);
	КонецЕсли;
	
	Попытка
		Возврат Строка[ИмяРеквизита];
	Исключение
		ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Реквизит %1 не найден'"), ИмяРеквизита);
	КонецПопытки;
	
КонецФункции

Функция ПроверитьОбязательныеПараметрыФункции(Параметры, ИмяФункции)

	Результат = Истина;
	
	Для каждого ПараметрФункции Из Параметры Цикл
	
		Если Не ЗначениеЗаполнено(ПараметрФункции.Значение) Тогда
			СтрокаОшибки = СтрШаблон(НСтр("ru = 'Не указан обязательный параметр ""%1""'"), ПараметрФункции.Ключ);
			ДобавитьОшибкуВКонтекстПроведения(СтрокаОшибки, ИмяФункции);
			Результат = Ложь;
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат Результат;

КонецФункции

Процедура ДобавитьОшибкуНеПравильныйТипПараметра(ИмяПараметра, ЗначениеПараметра, ИмяФункции)

	СтрокаОшибки = СтрШаблон(НСтр("ru = 'Задан не правильный тип параметра ""%1"": ""%2"" (тип: %3)'"),
		ИмяПараметра, Строка(ЗначениеПараметра), Строка(ТипЗнч(ЗначениеПараметра)));
	ДобавитьОшибкуВКонтекстПроведения(СтрокаОшибки, ИмяФункции);

КонецПроцедуры

#КонецОбласти
