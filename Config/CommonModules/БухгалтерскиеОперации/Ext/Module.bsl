Функция СчетУчетаОС(ОсновноеСредство, Период = Неопределено) Экспорт
	
	СчетУчетаОС = БухгалтерскиеОперацииПовтИсп.СчетУчетаОС(ОсновноеСредство, Период);
	
	Если НЕ ЗначениеЗаполнено(СчетУчетаОС) Тогда
		ТекстПериода = "";
		ТипПериода = ТипЗнч(Период);
		Если ТипПериода = Тип("Дата") Тогда
			ТекстПериода = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = ' на %1'"), Формат(Период, "ДФ=""дд ММММ гггг 'г.' ЧЧ:мм:сс"""));
		ИначеЕсли Документы.ТипВсеСсылки().СодержитТип(ТипПериода) Тогда
			ТекстПериода = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = ' на %1'"), Формат(Период.Дата, "ДФ=""дд ММММ гггг 'г.' ЧЧ:мм:сс"""));
		КонецЕсли;
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Невозможно определить счет учета внеоборотного актива ""%1""%2.'"),
				Строка(ОсновноеСредство), ТекстПериода);
		БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстСообщения, "СчетУчетаОС");
	КонецЕсли;
	
	Возврат СчетУчетаОС;
	
КонецФункции

