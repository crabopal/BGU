Функция КоличествоОСвПутиДостаточноДляСписания(ДокументСсылка, ИФО,
	КФО = Неопределено, КПС = Неопределено, Подразделение, Контрагент, ПоступлениеОСвПути) Экспорт
	
	Отказ = Ложь;
	
	ПараметрИФО           = ?(ЗначениеЗаполнено(ИФО) И ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"),
		ИФО, Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
	ПараметрКФО           = ?(ЗначениеЗаполнено(КФО), КФО, Перечисления.КВД.ПустаяСсылка());
	ПараметрКПС           = ?(ЗначениеЗаполнено(КПС), КПС, Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка());
	ПараметрПодразделение = ?(ЗначениеЗаполнено(Подразделение)
		И ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"),
		Подразделение, Справочники.Подразделения.ПустаяСсылка());
	ПараметрКонтрагент    = ?(ЗначениеЗаполнено(Контрагент), Контрагент, Справочники.Контрагенты.ПустаяСсылка());
	
	ТаблицаОС = БухгалтерскиеОперацииПовтИсп.ПолучитьОстаткиОСвПути(ДокументСсылка,
		ДокументСсылка.Дата, "КапВложения", ПараметрИФО, ПараметрКФО, ПараметрКПС,
		ПараметрПодразделение, ПараметрКонтрагент, ПоступлениеОСвПути);
	
	Если ТаблицаОС.Итог("Нехватка")>0 Тогда
		ТекстСообщения = НСтр("ru='Недостаточно внеоборотных активов для оприходования:'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
		Для каждого ТекСтр Из ТаблицаОС Цикл
			
			Если ТекСтр.Нехватка > 0 Тогда
				ТекстСообщения = НСтр("ru='Остаток %1 %2 из необходимых %3'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
					Строка(ТекСтр.КоличествоОстаток), ТекСтр.ВнеоборотныйАктивНаименование, Строка(ТекСтр.Количество));
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
			КонецЕсли;
		
		КонецЦикла;
	КонецЕсли;
	
	Возврат Не Отказ;
КонецФункции

Функция МожноПровестиСписаниеОСВОперУчете(ДокументСсылка) Экспорт
	
	ДопустимыеТипыФункции = Новый Массив;
	ДопустимыеТипыФункции.Добавить(Тип("ДокументСсылка.ПередачаГруппОбъектовОС"));
	ДопустимыеТипыФункции.Добавить(Тип("ДокументСсылка.СписаниеЛитературы"));
	ДопустимыеТипыФункции.Добавить(Тип("ДокументСсылка.СписаниеГруппОбъектовОС"));
	ДопустимыеТипыФункции.Добавить(Тип("ДокументСсылка.АктСписанияМягкогоИХозИнвентаряОС"));
	ДопустимыеТипыФункции.Добавить(Тип("ДокументСсылка.НакладнаяНаВнутреннееПеремещениеОС2"));
	ДопустимыеТипыФункции.Добавить(Тип("ДокументСсылка.ПередачаОбъектовОС"));
	ДопустимыеТипыФункции.Добавить(Тип("ДокументСсылка.СписаниеОбъектовОС"));
	ДопустимыеТипыФункции.Добавить(Тип("ДокументСсылка.СписаниеТранспорта"));
	
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Ложь;
	ИначеЕсли ДопустимыеТипыФункции.Найти(ТипЗнч(ДокументСсылка)) = Неопределено Тогда
		ВызватьИсключение "Функция ""МожноПровестиСписаниеОСВОперУчете"" не рассчитана на работу с документом """ + ТипЗнч(ДокументСсылка) + """";
	КонецЕсли;
	
	ТаблицаОС = Новый ТаблицаЗначений;
	ТаблицаОС.Колонки.Добавить("ОсновноеСредство"	, Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ТаблицаОС.Колонки.Добавить("ИнвентарныйНомер"	, Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	ТаблицаОС.Колонки.Добавить("КПС"				, Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаОС.Колонки.Добавить("КФО"				, Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ТаблицаОС.Колонки.Добавить("Сумма"				, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18,2)));
	ТаблицаОС.Колонки.Добавить("СуммаАмортизации"	, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18,2)));
	ТаблицаОС.Колонки.Добавить("Количество"			, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,3)));
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.НакладнаяНаВнутреннееПеремещениеОС2") Тогда
		ИмяРеквизитаЦМО = "ЦМООтправитель";
		ИмяРеквизитаПодразделение = "ПодразделениеОтправитель";
	Иначе
		ИмяРеквизитаЦМО = "ЦМО";
		ИмяРеквизитаПодразделение = "Подразделение";
	КонецЕсли;
	
	мРеквизиты = ДокументСсылка.Метаданные().Реквизиты;
	
	КПСвШапке = ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПередачаГруппОбъектовОС")
		Или ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеЛитературы")
		Или ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеТранспорта");

	ДокументСДатойПроведения = Метаданные.ОпределяемыеТипы.ДокументыСОтдельнойДатойПроведения.Тип.СодержитТип(ТипЗнч(ДокументСсылка));
	ЕстьДатаСписания = мРеквизиты.Найти("ДатаСписанияСБухУчета") <> Неопределено ИЛИ ДокументСДатойПроведения;
	
	ПризнакиУчета = БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("21");
	ИспользоватьУчетПоКПС = ПризнакиУчета.УчетПоКПС;
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеТранспорта") Тогда
		СтрокаРеквизитов = "КПС,КФО,Дата,Организация,ИФО,ЦМО,Подразделение,ОсновноеСредство,ИнвентарныйНомер,Сумма,СуммаАмортизации";
		ДанныеДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, СтрокаРеквизитов);
		ЦМОДокумента			= ДанныеДокумента.ЦМО;
		ПодразделениеДокумента	= ДанныеДокумента.Подразделение;
		НоваяСтрокаОС = ТаблицаОС.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаОС, ДанныеДокумента);
		НоваяСтрокаОС.Количество = 1;
	Иначе
		ЕстьРеквизитКФОВТабличнойЧасти = мРеквизиты.Найти("КФОВТабличнойЧасти") <> Неопределено;
		ЕстьРеквизитКФО = мРеквизиты.Найти("КФО") <> Неопределено;
		
		Если КПСвШапке Тогда
			СтрокаРеквизитов = "КПС,";
		Иначе
			СтрокаРеквизитов = "";
		КонецЕсли;
		Если ЕстьРеквизитКФО Тогда
			СтрокаРеквизитов = СтрокаРеквизитов + "КФО,";
		КонецЕсли;
		Если ЕстьРеквизитКФОВТабличнойЧасти Тогда
			СтрокаРеквизитов = СтрокаРеквизитов + "КФОВТабличнойЧасти,";
		КонецЕсли;
		Если ЕстьДатаСписания И НЕ ДокументСДатойПроведения Тогда
			СтрокаРеквизитов = СтрокаРеквизитов + "ДатаСписанияСБухУчета,";
		КонецЕсли;
		СтрокаРеквизитов = СтрокаРеквизитов + "Дата,Организация,ИФО,ОсновныеСредства," + ИмяРеквизитаЦМО + "," + ИмяРеквизитаПодразделение;
		ДанныеДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, СтрокаРеквизитов);
		КФОвШапке = ЕстьРеквизитКФОВТабличнойЧасти И НЕ ДанныеДокумента.КФОВТабличнойЧасти ИЛИ НЕ ЕстьРеквизитКФОВТабличнойЧасти И ЕстьРеквизитКФО;
		ЦМОДокумента			= ДанныеДокумента[ИмяРеквизитаЦМО];
		ПодразделениеДокумента	= ДанныеДокумента[ИмяРеквизитаПодразделение];
		ВыборкаОС = ДанныеДокумента.ОсновныеСредства.Выбрать();
		Пока ВыборкаОС.Следующий() Цикл
			НоваяСтрокаОС = ТаблицаОС.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаОС, ВыборкаОС);
			Если КПСвШапке Тогда
				НоваяСтрокаОС.КПС = ДанныеДокумента.КПС;
			КонецЕсли;
			Если НЕ ИспользоватьУчетПоКПС Тогда
				НоваяСтрокаОС.КПС = Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка();
			КонецЕсли;
			Если КФОвШапке Тогда
				НоваяСтрокаОС.КФО = ДанныеДокумента.КФО;
			ИначеЕсли ЕстьРеквизитКФОВТабличнойЧасти И ДанныеДокумента.КФОВТабличнойЧасти Тогда
				НоваяСтрокаОС.КФО = ВыборкаОС.КФО;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;    
	
	Если ДокументСДатойПроведения Тогда    
		ДанныеДокумента.Вставить("ДатаСписанияСБухУчета", БухгалтерскийУчет.УстановленнаяДатаПроведения(ДокументСсылка));
	КонецЕсли;	
	
	Отказ = Ложь;
	
	ТаблицаОС.Свернуть("ОсновноеСредство, ИнвентарныйНомер, КПС, КФО", "Сумма, СуммаАмортизации, Количество");
	СписокОС = ТаблицаОС.ВыгрузитьКолонку("ОсновноеСредство");
	
	Если ЕстьДатаСписания И ЗначениеЗаполнено(ДанныеДокумента.ДатаСписанияСБухУчета)
		И НачалоДня(ДанныеДокумента.ДатаСписанияСБухУчета) <> НачалоДня(ДанныеДокумента.Дата) Тогда
		Период = Новый МоментВремени(ДанныеДокумента.ДатаСписанияСБухУчета);
	Иначе
		Период = ДокументСсылка.МоментВремени();
	КонецЕсли;
	
	ОстаткиОС = УправлениеОсновнымиСредствами.ОпределитьЗабСтоимостьСпискаОС(
		СписокОС,
		Период,
		ДанныеДокумента.Организация,
		?(КФОвШапке, ДанныеДокумента.КФО, Неопределено),
		?(КПСвШапке, ДанныеДокумента.КПС, Неопределено),
		ЦМОДокумента,
		ДанныеДокумента.ИФО,
		ПодразделениеДокумента);
		
	Для Каждого ТекОС Из ТаблицаОС Цикл
		
		НайденыСтроки = Новый Массив;
		Отбор = Новый Структура("ОсновноеСредство, КПС, КФО", ТекОС.ОсновноеСредство, ТекОС.КПС, ТекОС.КФО);
		НайденыСтроки = ОстаткиОС.НайтиСтроки(Отбор);
		Если НайденыСтроки.Количество()=1 Тогда
			
			Если НайденыСтроки[0].КоличествоМОЛ < ТекОС.Количество Тогда
				ТекстСообщения = НСтр("ru = 'Недостаточно ""%1"" в оперативном учете'");
				ТекстСообщения = СтрШаблон(ТекстСообщения, ТекОС.ОсновноеСредство.Наименование);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
				Продолжить;
			КонецЕсли;
			
			Если НайденыСтроки[0].КоличествоМОЛ = ТекОС.Количество Тогда
				СуммаТекОС = НайденыСтроки[0].СуммаТекОС;
			Иначе
				СуммаТекОС = НайденыСтроки[0].Цена * ТекОС.Количество;
			КонецЕсли;
			Если СуммаТекОС <> ТекОС.Сумма Тогда
				ТекстСообщения = НСтр("ru = 'Стоимость ""%1"" в оперативном учете не совпадает с учетной'");
				ТекстСообщения = СтрШаблон(ТекстСообщения, ТекОС.ОсновноеСредство.Наименование);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
			КонецЕсли;
			
		Иначе
			ТекстСообщения = НСтр("ru='Не найдена стоимость ""%1"" в оперативном учете'");
			ТекстСообщения = СтрШаблон(ТекстСообщения, ТекОС.ОсновноеСредство.Наименование);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Не Отказ;
	
КонецФункции

Функция МожноПровестиСписаниеОСЗабаланс(ДокументСсылка) Экспорт
	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Отказ = Ложь;
	
	ТаблицаОС = БухгалтерскиеОперацииПовтИсп.ПолучитьОстаткиОСЗабаланс(ДокументСсылка);
	
	Если ТаблицаОС.Итог("Нехватка")<>0 Тогда
		Отказ = Истина;
		ТекстСообщения = Нстр("ru='Не хватает количества %1 инв.№%2 в строке %3'");
		Для каждого ТекОС Из ТаблицаОС Цикл
		
			Если ТекОС.Нехватка<>0 Тогда
				
				ОбщегоНазначения.СообщитьПользователю(
					СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
						Строка(ТекОС.ОсновноеСредство), Строка(ТекОС.ИнвентарныйНомер), Строка(ТекОС.НомерСтроки)),,
						"Объект.ОсновныеСредства["+(ТекОС.НомерСтроки-1)+"].Количество");
				
			КонецЕсли;
		
		КонецЦикла; 
	КонецЕсли;
	
	Возврат НЕ Отказ;
	
КонецФункции

Функция ПолучитьРеквизитСписанияОСЗабаланс(ДокументСсылка, НомерСтроки, ИмяРеквизита) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТаблицаОС = БухгалтерскиеОперацииПовтИсп.ПолучитьОстаткиОСЗабаланс(ДокументСсылка);
	
	Возврат ТаблицаОС[НомерСтроки-1][ИмяРеквизита];
	
КонецФункции

Функция ПолучитьВидБезвозмездногоПользования(ДокументСсылка, Организация, Контрагент, НФА) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Значение
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В (&СписокСчетов),
	|			&Субконто,
	|			Организация = &Организация
	|				И Субконто1 = &Контрагент
	|				И Субконто2 = &НФА) КАК ЖурналПроводокЕПСБУОстатки";
	
	Запрос.УстановитьПараметр("Период"		, ДокументСсылка.МоментВремени());
	Запрос.УстановитьПараметр("СписокСчетов", БухгалтерскийУчет.СписокСчетов("26"));
	Запрос.УстановитьПараметр("Организация"	, Организация);
	Запрос.УстановитьПараметр("Субконто"	, БухгалтерскийУчет.СписокСубконто("Контрагенты,ОсновныеСредства,ВидыБезвозмездногоПользования"));
	Запрос.УстановитьПараметр("Контрагент"	, Контрагент);
	Запрос.УстановитьПараметр("НФА"			, НФА);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Значение;
	Иначе
		Результат = Null;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьРеквизитАмортизацииТекущегоМесяцаОС(Ссылка, ОсновноеСредство, ТребуемыеДанные, ВидУчета = "БУ") Экспорт
	
	ТаблицыАмортизации = БухгалтерскиеОперацииПовтИсп.ПолучитьТаблицыАмортизацииТекущегоМесяца(Ссылка, Ложь);
	ТаблицаАмортизации = ?(ВидУчета = "БУ", ТаблицыАмортизации.ТаблицаНачисленияАмортизацииБУ,
											ТаблицыАмортизации.ТаблицаНачисленияАмортизацииНУ);
	
	НайденнаяСтрока = ?(ТаблицаАмортизации.Количество()=0, Неопределено,
		ТаблицаАмортизации.Найти(ОсновноеСредство, "ОсновноеСредство"));
	Если НайденнаяСтрока = Неопределено Тогда
		Если Найти(ВРЕГ(ТребуемыеДанные), "СУММААМОРТИЗАЦИИ") > 0 Тогда
			Возврат 0;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Если ТребуемыеДанные = "КПСЗатрат" Тогда
		Если НЕ ЗначениеЗаполнено(НайденнаяСтрока[ТребуемыеДанные]) Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Если ТребуемыеДанные = "СуммаАмортизации" Тогда
		ТребуемыеДанные = ?(ВидУчета = "БУ", "СуммаАмортизацииБУ", "СуммаАмортизацииНУ");
	КонецЕсли;
	
	ПолученноеЗначение = ПолучитьЗначениеРеквизитаСтроки(НайденнаяСтрока, ТребуемыеДанные);
	
	ЭтоГрупповойУчет = ПолучитьЗначениеРеквизитаСтроки(НайденнаяСтрока, "ГрупповойУчет");
	Если ЭтоГрупповойУчет И ТребуемыеДанные = "СуммаАмортизацииНУ" Тогда // Из расчета одного инвентарного номера, одной единицы.
		ПолученноеЗначение = ПолученноеЗначение / ПолучитьЗначениеРеквизитаСтроки(НайденнаяСтрока, "Количество");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ПолученноеЗначение) Тогда
		КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
		КонтекстПроведения.ПоследняяФункция = ВРег("БухгалтерскиеОперации.ПолучитьРеквизитАмортизацииТекущегоМесяцаОС");
		КонтекстПроведения.ПоследняяОшибка = СтрШаблон(НСтр("ru = 'Не заполнено значение реквизита ""%1""'"), ТребуемыеДанные);
		БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	КонецЕсли;
	
	Возврат ПолученноеЗначение;
	
КонецФункции

Функция ПолучитьРеквизитАмортизацииТекущегоМесяцаИК(Ссылка, ОсновноеСредство, ТребуемыеДанные) Экспорт
	
	ТаблицыАмортизации = БухгалтерскиеОперацииПовтИсп.ПолучитьТаблицыАмортизацииТекущегоМесяца(Ссылка, Истина);
	ТаблицаАмортизации = ТаблицыАмортизации.ТаблицаНачисленияАмортизацииБУ;
	
	НайденнаяСтрока = ?(ТаблицаАмортизации.Количество()=0, Неопределено,
		ТаблицаАмортизации.Найти(ОсновноеСредство, "ОсновноеСредство"));
	Если НайденнаяСтрока = Неопределено Тогда
		Если Найти(ВРЕГ(ТребуемыеДанные), "СУММААМОРТИЗАЦИИ") > 0 Тогда
			Возврат 0;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	// Для совместимости с уже использующимися вызовами нужно изменить названия некоторых колонок.
	Если ТребуемыеДанные = "СуммаАмортизации" Тогда
		ИмяКолонки = "СуммаАмортизацииБУ";
	ИначеЕсли ТребуемыеДанные = "СчетУчетаЗатрат" Тогда
		ИмяКолонки = "СчетЗатрат";
	ИначеЕсли ТребуемыеДанные = "Субконто1Затрат" Тогда
		ИмяКолонки = "СубконтоЗатрат1";
	ИначеЕсли ТребуемыеДанные = "Субконто2Затрат" Тогда
		ИмяКолонки = "СубконтоЗатрат2";
	ИначеЕсли ТребуемыеДанные = "Субконто3Затрат" Тогда
		ИмяКолонки = "СубконтоЗатрат3";
	Иначе
		ИмяКолонки = ТребуемыеДанные;
	КонецЕсли;
	
	Возврат ПолучитьЗначениеРеквизитаСтроки(НайденнаяСтрока, ИмяКолонки);
	
КонецФункции

Функция ПолучитьПараметрыАмортизацииОС(ОсновноеСредство, Период, ИмяПараметра, КПСПоУмолчанию = Неопределено) Экспорт
	
	ТипПериода = ТипЗнч(Период);
	Если Документы.ТипВсеСсылки().СодержитТип(ТипПериода) Тогда
		
		ДокументСсылка = Период; // Период сведений задан ссылкой на документ.
		// Кэшируем параметры амортизации для всех объектов ОС, НМА в документе.
		ТаблицаПараметрыАмортизации = БухгалтерскиеОперацииПовтИсп.ПараметрыАмортизацииОбъектовОС(ДокументСсылка);
		
		НайденнаяСтрока = ?(ТаблицаПараметрыАмортизации.Количество()=0, Неопределено,
			ТаблицаПараметрыАмортизации.Найти(ОсновноеСредство, "ОсновноеСредство"));
		Если НайденнаяСтрока = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ПараметрыАмортизации = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(НайденнаяСтрока);
		
	Иначе
		
		// Период сведений задан датой - кэшируем параметры амортизации для конкретного объекта ОС, НМА.
		ПараметрыАмортизации = БухгалтерскиеОперацииПовтИсп.ПолучитьПараметрыАмортизацииОС(
			ОсновноеСредство, Период);
		
	КонецЕсли;
	
	Если ИмяПараметра = "КПСЗатрат" Тогда
		
		Если ЗначениеЗаполнено(ПараметрыАмортизации[ИмяПараметра]) Тогда
			Возврат ПараметрыАмортизации[ИмяПараметра];
		Иначе
			Возврат КПСПоУмолчанию;
		КонецЕсли;
		
	Иначе
		Возврат ПараметрыАмортизации[ИмяПараметра];
	КонецЕсли;
	
КонецФункции

Функция ПолучитьСчетМЗВПути(Знач СчетУчета) Экспорт
	
	СчетВПути = УправлениеМатериальнымиЗапасамиПовтИсп.СчетВПутиПоСчетуУчетаМЗ(СчетУчета);
	
	Возврат СчетВПути;
	
КонецФункции

// Проверяет корректность указания количества и стоимости вложений в НФА в документах принятия ОС к учету
// при принятии к учету объекта ОС по сформированной стоимости вложений
//
Функция КоличествоИСтоимостьВложенийВНФАУказаныКорректно(ДокументСсылка) Экспорт
	
	Отказ = Ложь;
	
	ТипСсылки = ТипЗнч(ДокументСсылка);
	
	// Контролируем только в документах принятия к учету ОС при приобретении.
	Если ТипСсылки <> Тип("ДокументСсылка.ПринятиеКУчетуЗдания")
		И ТипСсылки <> Тип("ДокументСсылка.ПринятиеКУчетуОбъектаОС")
		И ТипСсылки <> Тип("ДокументСсылка.ПринятиеКУчетуОС")
		И ТипСсылки <> Тип("ДокументСсылка.ПринятиеКУчетуОбъектовОС") Тогда
		Возврат НЕ Отказ;
	КонецЕсли;
	
	ВидПоступления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "ВидПоступления");
	Если ВидПоступления <> Перечисления.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуПриобретение Тогда
		Возврат НЕ Отказ;
	КонецЕсли;
	
	МетаданныеДокумента = ДокументСсылка.Метаданные();
	// Получим требуемые данные ссылки
	СтруктураДанных = Новый Структура("Организация, Дата, КФО, ВидПоступления, Подразделение, ИФО, ВнеоборотныйАктив,"
		+ "СчетКредита, РасходыНеУчитываетсяНУ, РасходыЕНВД");
	Если МетаданныеДокумента.Реквизиты.Найти("КПС") <> Неопределено Тогда
		СтруктураДанных.Вставить("КПС");
	Иначе
		СтруктураДанных.Вставить("КПС", "Значение(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)");
	КонецЕсли;
	Если ТипСсылки = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовОС") Тогда
		СтруктураДанных.Вставить("КапитальныеВложения");
		СтруктураДанных.Вставить("СуммаВложенийНУ");
	Иначе
		СтруктураДанных.Вставить("Количество");
		СтруктураДанных.Вставить("ПервоначальнаяСтоимость");
		СтруктураДанных.Вставить("ПервоначальнаяСтоимостьНУ");
	КонецЕсли;
	ДанныеДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, СтруктураДанных);
	
	ОтражатьВНалоговомУчете = НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(
		ДанныеДокумента.Организация, ДанныеДокумента.Дата, ДанныеДокумента.КФО);
	
	ПараметрыОстатков = Новый Структура;
	ПараметрыОстатков.Вставить("ПериодОстатков", Новый Граница(ДокументСсылка.МоментВремени(), ВидГраницы.Исключая));
	ПараметрыОстатков.Вставить("Дата",           ДанныеДокумента.Дата);
	ПараметрыОстатков.Вставить("Организация",    ДанныеДокумента.Организация);
	ПараметрыОстатков.Вставить("Подразделение",  ДанныеДокумента.Подразделение);
	ПараметрыОстатков.Вставить("ИФО",            ДанныеДокумента.ИФО);
	ПараметрыОстатков.Вставить("КФО",            ДанныеДокумента.КФО);
	ПараметрыОстатков.Вставить("КПС",            ДанныеДокумента.КПС);
	ПараметрыОстатков.Вставить("ОбъектВложений", ДанныеДокумента.ВнеоборотныйАктив);
	ПараметрыОстатков.Вставить("СчетВложений",   ДанныеДокумента.СчетКредита);
	
	Если ТипСсылки = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовОС") Тогда
	
		Остатки = УправлениеОсновнымиСредствами.ПолучитьТаблицуОстатковВложенийВНФА(ПараметрыОстатков);
		ОстаткиПоОбъектуВложений = Остатки.ОстаткиБУ;
		КапитальныеВложения = ДанныеДокумента.КапитальныеВложения.Выгрузить();
		
		Если ОстаткиПоОбъектуВложений.Итог("Количество") < КапитальныеВложения.Итог("Количество") Тогда
			
			ТекстОшибки = НСтр("ru='Указанное количество превышает остаток по счету %3.
				|Остаток: %1; Не хватает: %2'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
				ОстаткиПоОбъектуВложений.Итог("Количество"),
				КапитальныеВложения.Итог("Количество") - ОстаткиПоОбъектуВложений.Итог("Количество"),
				ДокументСсылка.СчетКредита);
				
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Корректность",
				НСтр("ru = 'Количество'"), , , ТекстОшибки);
				
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
				ДокументСсылка, "Количество", "Объект", Отказ);
			
		КонецЕсли;
		
		ШаблонТекстаОшибки = НСтр("ru='Указанная сумма превышает остаток по счету %3, КПС %4.
			|Остаток: %1; Не хватает: %2'");
			
		Для каждого СтрокаВложений Из КапитальныеВложения Цикл
		
			СтрокаОстатков = ОстаткиПоОбъектуВложений.Найти(СтрокаВложений.КПС, "КПС");
			ОстатокПоКПС = ?(СтрокаОстатков = Неопределено, 0, СтрокаОстатков.Сумма);
			
			Если ОстатокПоКПС < СтрокаВложений.Сумма Тогда
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонТекстаОшибки,
					ОстатокПоКПС,
					СтрокаВложений.Сумма - ОстатокПоКПС,
					ДанныеДокумента.СчетКредита,
					СтрокаВложений.КПС);
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
					НСтр("ru = 'Сумма вложений'"), СтрокаВложений.НомерСтроки, "Капитальные вложения", ТекстОшибки);
					
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументСсылка,
					"КапитальныеВложения[" + (СтрокаВложений.НомерСтроки - 1) + "].Сумма", "Объект");
					
			КонецЕсли;
			
		КонецЦикла;
		
		#Область НалоговыйУчет
		Если ОтражатьВНалоговомУчете Тогда
			
			ОстаткиПоОбъектуВложений = Остатки.ОстаткиНУ;
			
			Если ОстаткиПоОбъектуВложений.Итог("СуммаНУ") < ДанныеДокумента.СуммаВложенийНУ Тогда
				
				ТекстОшибки = НСтр("ru='Указанная сумма превышает остаток по счету %3.
					|Остаток: %1; Не хватает: %2'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
					ОстаткиПоОбъектуВложений.Итог("СуммаНУ"),
					ДанныеДокумента.СуммаВложенийНУ - ОстаткиПоОбъектуВложений.Итог("СуммаНУ"),
					"Н08");
					
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Корректность",
					НСтр("ru = 'Сумма вложений (НУ)'"), , , ТекстОшибки);
					
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
					ДокументСсылка, "СуммаВложенийНУ", "Объект");
				
			КонецЕсли;
			
			Если ОстаткиПоОбъектуВложений.Итог("СуммаНеУчитываетсяНУ") < ДанныеДокумента.РасходыНеУчитываетсяНУ Тогда
				
				ТекстОшибки = НСтр("ru='Указанная сумма превышает остаток по счету %3.
					|Остаток: %1; Не хватает: %2'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
					ОстаткиПоОбъектуВложений.Итог("СуммаНеУчитываетсяНУ"),
					ДанныеДокумента.РасходыНеУчитываетсяНУ - ОстаткиПоОбъектуВложений.Итог("СуммаНеУчитываетсяНУ"),
					"Н08");
					
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Корректность",
					НСтр("ru = 'Расходы, не учитываемые при налогообложении (НУ)'"), , , ТекстОшибки);
					
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
					ДокументСсылка, "РасходыНеУчитываетсяНУ", "Объект");
				
			КонецЕсли;
			
			Если ОстаткиПоОбъектуВложений.Итог("СуммаЕНВД") < ДанныеДокумента.РасходыЕНВД Тогда
				
				ТекстОшибки = НСтр("ru='Указанная сумма превышает остаток по счету %3.
					|Остаток: %1; Не хватает: %2'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
					ОстаткиПоОбъектуВложений.Итог("СуммаЕНВД"),
					ДанныеДокумента.РасходыЕНВД - ОстаткиПоОбъектуВложений.Итог("СуммаЕНВД"),
					"Н08");
					
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Корректность",
					НСтр("ru = 'Расходы по деятельности с особым порядком налогообложения (ЕНВД и пр.)'"), , , ТекстОшибки);
					
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
					ДокументСсылка, "РасходыЕНВД", "Объект", Отказ);
				
			КонецЕсли;
			
		КонецЕсли;
		#КонецОбласти
		
	Иначе
		
		ОстаткиПоОбъектуВложений = УправлениеОсновнымиСредствами.ПолучитьОстаткиПоОбъектуВложенийВНФА(ПараметрыОстатков);
		
		Если ОстаткиПоОбъектуВложений.Количество < ДанныеДокумента.Количество Тогда
			
			ТекстОшибки = НСтр("ru='Указанное количество превышает остаток по счету %3.
				|Остаток: %1; Не хватает: %2'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
				ОстаткиПоОбъектуВложений.Количество,
				ДанныеДокумента.Количество - ОстаткиПоОбъектуВложений.Количество,
				ДанныеДокумента.СчетКредита);
				
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Корректность",
				НСтр("ru = 'Количество'"), , , ТекстОшибки);
				
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
				ДокументСсылка, "Количество", "Объект", Отказ);
			
		КонецЕсли;
		
		// Если принимаем к учету все количество по объекту вложений, проверим корректность списания стоимости
		Если ОстаткиПоОбъектуВложений.Количество = ДанныеДокумента.Количество Тогда
			
			// Проверяем разницу цены. При большом количестве разница сумм может быть значительно больше чем 0.01.
			РазницаЦен = МодульЧисла(ДанныеДокумента.ПервоначальнаяСтоимость - Окр(ОстаткиПоОбъектуВложений.Сумма / ОстаткиПоОбъектуВложений.Количество, 2));
			Если РазницаЦен > 0.01 Тогда
				
				ТекстСообщения = НСтр("ru='Первоначальная стоимость не соответствует остатку по счету %4.
					|Остаток: %1; Первоначальная стоимость: %2; Количество объектов: %3'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
					ОбщегоНазначенияБГУ.ФорматСумм(ОстаткиПоОбъектуВложений.Сумма),
					ОбщегоНазначенияБГУ.ФорматСумм(ДанныеДокумента.ПервоначальнаяСтоимость),
					ДанныеДокумента.Количество,
					ДанныеДокумента.СчетКредита);
					
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
					ДокументСсылка, "ПервоначальнаяСтоимость", "Объект");
				
			КонецЕсли;
			
			#Область НалоговыйУчет
			Если ОтражатьВНалоговомУчете Тогда
				
				// Проверяем разницу цены. При большом количестве разница сумм может быть значительно больше чем 0.01.
				РазницаЦен = МодульЧисла(ДанныеДокумента.ПервоначальнаяСтоимостьНУ - Окр(ОстаткиПоОбъектуВложений.СуммаНУ / ОстаткиПоОбъектуВложений.Количество, 2));
				Если РазницаЦен > 0.01 Тогда
					
					ТекстСообщения = НСтр("ru='Первоначальная стоимость (НУ) не соответствует остатку по счету %4.
						|Остаток: %1; Первоначальная стоимость: %2; Количество объектов: %3'");
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
						ОбщегоНазначенияБГУ.ФорматСумм(ОстаткиПоОбъектуВложений.СуммаНУ),
						ОбщегоНазначенияБГУ.ФорматСумм(ДанныеДокумента.ПервоначальнаяСтоимостьНУ),
						ДанныеДокумента.Количество,
						"Н08");
						
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
						ДокументСсылка, "ПервоначальнаяСтоимостьНУ", "Объект");
					
				КонецЕсли;
				
				// Проверяем разницу цены. При большом количестве разница сумм может быть значительно больше чем 0.01.
				РазницаЦен = МодульЧисла(ДанныеДокумента.РасходыНеУчитываетсяНУ - Окр(ОстаткиПоОбъектуВложений.СуммаНеУчитываетсяНУ / ОстаткиПоОбъектуВложений.Количество, 2));
				Если РазницаЦен > 0.01 Тогда
					
					ТекстСообщения = НСтр("ru='Сумма расходов, не учитываемых при налогообложении, не соответствует остатку по счету %4.
						|Остаток: %1; Сумма расходов: %2; Количество объектов: %3'");
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
						ОбщегоНазначенияБГУ.ФорматСумм(ОстаткиПоОбъектуВложений.СуммаНеУчитываетсяНУ),
						ОбщегоНазначенияБГУ.ФорматСумм(ДанныеДокумента.РасходыНеУчитываетсяНУ),
						ДанныеДокумента.Количество,
						"Н08");
						
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
						ДокументСсылка, "РасходыНеУчитываетсяНУ", "Объект");
					
				КонецЕсли;
				
				// Проверяем разницу цены. При большом количестве разница сумм может быть значительно больше чем 0.01.
				РазницаЦен = МодульЧисла(ДанныеДокумента.РасходыЕНВД - Окр(ОстаткиПоОбъектуВложений.СуммаЕНВД / ОстаткиПоОбъектуВложений.Количество, 2));
				Если РазницаЦен > 0.01 Тогда
					
					ТекстСообщения = НСтр("ru='Сумма расходов по деятельности с особым порядком налогообложения (ЕНВД и пр.), не соответствует остатку по счету %4.
						|Остаток: %1; Сумма расходов: %2; Количество объектов: %3'");
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
						ОбщегоНазначенияБГУ.ФорматСумм(ОстаткиПоОбъектуВложений.СуммаЕНВД),
						ОбщегоНазначенияБГУ.ФорматСумм(ДанныеДокумента.РасходыЕНВД),
						ДанныеДокумента.Количество,
						"Н08");
						
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
						ДокументСсылка, "РасходыЕНВД", "Объект");
					
				КонецЕсли;
				
			КонецЕсли;
			#КонецОбласти
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат НЕ Отказ;
	
КонецФункции

Функция ВидНФАПоСчетуВложений(СчетВложений) Экспорт
	Возврат УправлениеОсновнымиСредствамиПовтИсп.ВидНФАпоСчетуВложений(СчетВложений);
КонецФункции

Функция СостояниеОС(ДокументСсылка, ОсновноеСредство, ИнвНомер) Экспорт
	
	Возврат БухгалтерскиеОперацииПовтИсп.СостояниеОС(ДокументСсылка, ОсновноеСредство, ИнвНомер);
	
КонецФункции

Функция СрокПолезногоИспользованияОС(ОсновноеСредство, Период = Неопределено) Экспорт
	
	Возврат УправлениеОсновнымиСредствами.СрокПолезногоИспользованияОС(ОсновноеСредство, Период);
	
КонецФункции

Функция СодержаниеПроводкиОС(СодержаниеПроводки, ОсновноеСредство, ИнвентарныйНомер="") Экспорт
	
	Возврат СокрЛП(СодержаниеПроводки) + " "
		+ ?(ЗначениеЗаполнено(ИнвентарныйНомер), "инв. №:" + БухгалтерскиеОперации.ПредставлениеОбъекта(ИнвентарныйНомер) + ", ", "")
		+ БухгалтерскиеОперации.ПолноеНаименованиеОбъекта(ОсновноеСредство);
	
КонецФункции

// Устанавливает исключительную управляемую блокировку РегистрБухгалтерии.ЖурналПроводокЕПСБУ и РегистрСведений.СобытияОС.
// Возвращает результат попытки заблокировать данные.
//
// Параметры:
//  ДокументСсылка	- ДокументСсылка.ПередачаОбъектаОС -,
// 					- ДокументСсылка.ПередачаЗдания -,
// 					- ДокументСсылка.СписаниеОбъектаОС -,
// 					- ДокументСсылка.СписаниеАвтотранспорта -,
// 					- ДокументСсылка.ПередачаГруппОбъектовОС -,
// 					- ДокументСсылка.СписаниеГруппОбъектовОС -,
// 					- ДокументСсылка.СписаниеЛитературы -,
// 					- ДокументСсылка.АктСписанияМягкогоИХозИнвентаряОС -,
// 					- ДокументСсылка.ТребованиеНакладнаяОС -,
// Возвращаемое значение:
//  Булево - Истина - данные удалось заблокировать, Ложь - если не удалось.
Функция УстановитьБлокировкуПоДокументуОС(ДокументСсылка) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Отказ = Ложь;
	Блокировка = Новый БлокировкаДанных;
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПередачаОбъектаОС")
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПередачаЗдания")
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеОбъектаОС")
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеТранспорта")
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеАвтотранспорта") Тогда
		
		ЭлементБлокировки = Блокировка.Добавить("РегистрБухгалтерии.ЖурналПроводокЕПСБУ");
		
		ЕстьСчетУчетаВДокументе = ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеОбъектаОС")
								ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеТранспорта")
								ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеАвтотранспорта");
		ТребуемыеРеквизиты = "ОсновноеСредство,ИнвентарныйНомер";
		Если ЕстьСчетУчетаВДокументе Тогда
			ТребуемыеРеквизиты = ТребуемыеРеквизиты + ",СчетУчета";
		Иначе
			ТребуемыеРеквизиты = ТребуемыеРеквизиты + ",ВидОперации";
		КонецЕсли;
		
		ДанныеДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, ТребуемыеРеквизиты);
		
		Если ЕстьСчетУчетаВДокументе Тогда
			ЭлементБлокировки.УстановитьЗначение("Счет", ДанныеДокумента.СчетУчета);
		ИначеЕсли ДанныеДокумента.ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаКапвложений Тогда
			ЭлементБлокировки.УстановитьЗначение("Счет", УправлениеОсновнымиСредствами.СчетВложенийОС(ДанныеДокумента.ОсновноеСредство, ДокументСсылка));
		Иначе
			ЭлементБлокировки.УстановитьЗначение("Счет", УправлениеОсновнымиСредствами.СчетУчетаОС(ДанныеДокумента.ОсновноеСредство, ДокументСсылка));
		КонецЕсли;
		ЭлементБлокировки.УстановитьЗначение(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства, ДанныеДокумента.ОсновноеСредство);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.СобытияОС");
		ЭлементБлокировки.УстановитьЗначение("ОсновноеСредство",	ДанныеДокумента.ОсновноеСредство);
		ЭлементБлокировки.УстановитьЗначение("ИнвНомер",			ДанныеДокумента.ИнвентарныйНомер);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПередачаГруппОбъектовОС")
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеГруппОбъектовОС")
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеЛитературы")
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.АктСписанияМягкогоИХозИнвентаряОС")
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ТребованиеНакладнаяОС") Тогда
		
		Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "Организация");
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаДокумента.ОсновноеСредство КАК ОсновноеСредство,
		|	ТаблицаДокумента.ИнвентарныйНомер КАК ИнвентарныйНомер
		|ИЗ
		|	Документ.[ИмяДокумента].ОсновныеСредства КАК ТаблицаДокумента
		|ГДЕ
		|	ТаблицаДокумента.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТаблицаДокумента.ОсновноеСредство КАК ОсновноеСредство,
		|	ЕСТЬNULL(УчетныеДанныеОС.СчетУчета, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) КАК СчетУчета
		|ИЗ
		|	Документ.[ИмяДокумента].ОсновныеСредства КАК ТаблицаДокумента
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних(
		|				&Период,
		|				&Организация = Организация
		|					И ОсновноеСредство В
		|						(ВЫБРАТЬ
		|							ТаблицаДокумента.ОсновноеСредство КАК ОсновноеСредство
		|						ИЗ
		|							Документ.[ИмяДокумента].ОсновныеСредства КАК ТаблицаДокумента
		|						ГДЕ
		|							ТаблицаДокумента.Ссылка = &Ссылка)) КАК УчетныеДанныеОС
		|		ПО ТаблицаДокумента.ОсновноеСредство = УчетныеДанныеОС.ОсновноеСредство
		|ГДЕ
		|	ТаблицаДокумента.Ссылка = &Ссылка
		|	И ЕСТЬNULL(УчетныеДанныеОС.СчетУчета, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) <> ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)";
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "[ИмяДокумента]", ДокументСсылка.Метаданные().Имя);
		
		Запрос.УстановитьПараметр("Организация", Организация);
		Запрос.УстановитьПараметр("Ссылка",      ДокументСсылка);
		Запрос.УстановитьПараметр("Период",      Новый Граница(ДокументСсылка.МоментВремени(), ВидГраницы.Исключая));
		РезультатЗапроса = Запрос.ВыполнитьПакет();
		
		ЭлементБлокировки = Блокировка.Добавить("РегистрБухгалтерии.ЖурналПроводокЕПСБУ");
		ЭлементБлокировки.ИсточникДанных = РезультатЗапроса[1];
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Счет", "СчетУчета");
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства, "ОсновноеСредство");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.СобытияОС");
		ЭлементБлокировки.ИсточникДанных = РезультатЗапроса[0];
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("ОсновноеСредство",	"ОсновноеСредство");
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("ИнвНомер",			"ИнвентарныйНомер");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		
	Иначе
		
		Возврат Истина;
		
	КонецЕсли;
	
	Попытка
		Блокировка.Заблокировать();
	Исключение
		Отказ = Истина;
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки());
	КонецПопытки;
	
	Возврат Не Отказ;
	
КонецФункции

Функция ДоговорНФА(Период, Организация, НФА, ЭтоКапВложение = Ложь) Экспорт
	
	Возврат БухгалтерскиеОперацииПовтИсп.ДоговорНФА(Период, Организация, НФА, ЭтоКапВложение);
	
КонецФункции

// Устарела. Использовать ДоговорНФА
Функция ДоговорПраваПользованияНМА(Период, Организация, НМА) Экспорт
	
	Возврат ДоговорНФА(Период, Организация, НМА);
	
КонецФункции

// балансовые ОС

Функция ПодготовитсяКСписаниюОСБаланс(ДокументСсылка, ЭтоКапВложение = Ложь, УстанавливатьБлокировку = Ложь) Экспорт
	
	Отказ = Ложь;
	
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если УстанавливатьБлокировку Тогда
		Отказ = Не УстановитьБлокировкуПоДокументуОС(ДокументСсылка);
		Если Отказ Тогда
			Возврат Не Отказ;
		КонецЕсли;
	КонецЕсли;
	
	Если ЭтоКапВложение Тогда
		ТаблицаОС = БухгалтерскиеОперацииПовтИсп.ТаблицаОСДляСписания(ДокументСсылка, ЭтоКапВложение);
		
		Если ТаблицаОС = Неопределено Тогда
			Отказ = Истина;
			Возврат НЕ Отказ;
		КонецЕсли;
		
		Сумма = 0;
		СуммаАмортизации = 0;
		Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПередачаОбъектаОС")
			ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПередачаЗдания")
			ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеОбъектаОС")
			ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеТранспорта")
			ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеАвтотранспорта") Тогда
			КоличествоВТаблице = ТаблицаОС.Количество();
			Если КоличествоВТаблице=1 Тогда
				Сумма				= ТаблицаОС[0].БалансоваяСтоимость/?(ТаблицаОС[0].КоличествоВсего=0,1,ТаблицаОС[0].КоличествоВсего);
				СуммаАмортизации	= 0;
			Иначе
				Сумма				= 0;
				СуммаАмортизации	= 0;
			КонецЕсли;
			
			Если ДокументСсылка.Сумма <> Сумма
				ИЛИ ДокументСсылка.СуммаАмортизации <> СуммаАмортизации Тогда
				
				ТекстСообщения = НСтр("ru='Балансовая стоимость или амортизация в документе не соответствуют остаткам в учете'");
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
			КонецЕсли;
		ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПередачаГруппОбъектовОС")
			ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеГруппОбъектовОС")
			ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеЛитературы")
			ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.АктСписанияМягкогоИХозИнвентаряОС") Тогда
			
			ЭтоСписаниеЛитературы = ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеЛитературы");
			
			КопияТЧ = ДокументСсылка.ОсновныеСредства.Выгрузить();
			
			Для каждого ТекСтрТЧ Из КопияТЧ Цикл
				
				СтрокиОстатков = ТаблицаОС.НайтиСтроки(Новый Структура("ОсновноеСредство, ИнвентарныйНомер", ТекСтрТЧ.ОсновноеСредство, ТекСтрТч.ИнвентарныйНомер));
				Если СтрокиОстатков.Количество() = 0 Тогда
					ТекСтрОС = Неопределено;
				Иначе
					ТекСтрОС = СтрокиОстатков[0];
				КонецЕсли;
				
				Если ТекСтрОС = Неопределено Тогда
					ТекстСообщения = СтрШаблон(НСтр("ru='Не найдена стоимость %1'"), ""+ТекСтрТЧ.ОсновноеСредство.Наименование+"(код "+ТекСтрТЧ.ОсновноеСредство.Код+")");
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
				ИначеЕсли ТекСтрТЧ.Количество>ТекСтрОС.КоличествоОстатокМОЛ Тогда
					ТекстСообщения = СтрШаблон(НСтр("ru='Не хватает количества %1'"), ""+ТекСтрТЧ.ОсновноеСредство.Наименование+"(код "+ТекСтрТЧ.ОсновноеСредство.Код+")");
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
				Иначе
					// для библиотечного фонда без инв. номера проверяем только чтобы суммы не превышали остатки в учете
					Если ЭтоСписаниеЛитературы И НЕ ЗначениеЗаполнено(ТекСтрТЧ.ИнвентарныйНомер) Тогда
						Если ТекСтрТЧ.Сумма > ТекСтрОС.КоличествоОстатокМОЛ Тогда
							ТекстСообщения = СтрШаблон(НСтр("ru='Указанная балансовая сумма %1 больше, чем остатки в учете'"),
								""+ТекСтрТЧ.ОсновноеСредство.Наименование+"(код "+ТекСтрТЧ.ОсновноеСредство.Код+")");
							ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
						КонецЕсли;
					Иначе
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
		ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ТребованиеНакладнаяОС")
			Или ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.НакладнаяНаВнутреннееПеремещениеОС2") Тогда
			
			КопияТЧ = ДокументСсылка.ОсновныеСредства.Выгрузить();
			
			Для Каждого ТекСтрТЧ Из КопияТЧ Цикл
			
				СтрокиОстатков = ТаблицаОС.НайтиСтроки(Новый Структура("ОсновноеСредство, ИнвНомер", ТекСтрТЧ.ОсновноеСредство, ТекСтрТч.ИнвентарныйНомер));
				Если СтрокиОстатков.Количество() = 0 Тогда
					ТекСтрОС = Неопределено;
				Иначе
					ТекСтрОС = СтрокиОстатков[0];
				КонецЕсли;
				
				ТекСтрОС = ТаблицаОС.Найти(ТекСтрТЧ.ОсновноеСредство, "ОсновноеСредство");
				Если ТекСтрОС = Неопределено Тогда
					ТекстСообщения = СтрШаблон(НСтр("ru='Не найдена стоимость %1'"), ""+ТекСтрТЧ.ОсновноеСредство.Наименование+"(код "+ТекСтрТЧ.ОсновноеСредство.Код+")");
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
				ИначеЕсли ТекСтрТЧ.Количество > ТекСтрОС.КоличествоМОЛ Тогда
					ТекстСообщения = СтрШаблон(НСтр("ru='Не хватает количества %1'"), ""+ТекСтрТЧ.ОсновноеСредство.Наименование+"(код "+ТекСтрТЧ.ОсновноеСредство.Код+")");
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
				ИначеЕсли МодульЧисла(ТекСтрТЧ.Сумма - ТекСтрОС.СуммаТекОС) > 0.01 Тогда
					
					ТекстСообщения = СтрШаблон(НСтр("ru='Балансовая стоимость %1 не соответствуют остаткам в учете'"),
						""+ТекСтрТЧ.ОсновноеСредство.Наименование+"(код "+ТекСтрТЧ.ОсновноеСредство.Код+")");
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	Иначе
		
		ТаблицаОстатков = БухгалтерскиеОперацииПовтИсп.ОстаткиОСНМАНПА(ДокументСсылка);
		
		Для Каждого СтрокаОстатков Из ТаблицаОстатков Цикл
			
			Если СтрокаОстатков.НомерСтроки = 0 Тогда
				Поле = "";
			Иначе
				Поле = СтрШаблон("Объект.ОсновныеСредства[%1].ОсновноеСредство", СтрокаОстатков.НомерСтроки - 1);
			КонецЕсли;
			
			Если СтрокаОстатков.СуммаОстаток = 0 Тогда
				
				Шаблон = НСтр("ru = 'Не обнаружено остатков ""%1"" код ""%2""'");
				ТекстСообщения = СтрШаблон(Шаблон, СтрокаОстатков.Наименование, СтрокаОстатков.Код);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументСсылка, Поле,,Отказ);
				
			ИначеЕсли СтрокаОстатков.Количество > СтрокаОстатков.КоличествоОстаток Тогда
				
				Шаблон = НСтр("ru = 'Количество в документе (%1) больше количества в остатках (%2) по объекту ""%3"" код ""%4""'");
				ТекстСообщения = СтрШаблон(Шаблон, Формат(СтрокаОстатков.Количество, "ЧГ=0"),
					Формат(СтрокаОстатков.КоличествоОстаток, "ЧГ=0"), СтрокаОстатков.Наименование, СтрокаОстатков.Код);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументСсылка, Поле,,Отказ);
				
			Иначе
				
				Если СтрокаОстатков.Сумма > СтрокаОстатков.СуммаОстаток Тогда
					
					Шаблон = НСтр("ru = 'Сумма в документе (%1) превышает сумму в остатках (%2) по объекту ""%3"" код ""%4""'");
					ТекстСообщения = СтрШаблон(Шаблон, Формат(СтрокаОстатков.Сумма, "ЧДЦ=2"),
						Формат(СтрокаОстатков.СуммаОстаток, "ЧДЦ=2"), СтрокаОстатков.Наименование, СтрокаОстатков.Код);
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументСсылка, Поле,,Отказ);
					
				КонецЕсли;
				
				Если СтрокаОстатков.СуммаАмортизации > СтрокаОстатков.СуммаАмортизацииОстаток Тогда
					
					Шаблон = НСтр("ru = 'Сумма амортизации в документе (%1) превышает сумму в остатках (%2) по объекту ""%3"" код ""%4""'");
					ТекстСообщения = СтрШаблон(Шаблон, Формат(СтрокаОстатков.СуммаАмортизации, "ЧДЦ=2"),
						Формат(СтрокаОстатков.СуммаАмортизацииОстаток, "ЧДЦ=2"), СтрокаОстатков.Наименование, СтрокаОстатков.Код);
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументСсылка, Поле,,Отказ);
					
				КонецЕсли;
				
				Если СтрокаОстатков.СуммаОбесценения > СтрокаОстатков.СуммаОбесцененияОстаток Тогда
					
					Шаблон = НСтр("ru = 'Сумма обесценения в документе (%1) превышает сумму в остатках (%2) по объекту ""%3"" код ""%4""'");
					ТекстСообщения = СтрШаблон(Шаблон, Формат(СтрокаОстатков.СуммаОбесценения, "ЧДЦ=2"),
						Формат(СтрокаОстатков.СуммаОбесцененияОстаток, "ЧДЦ=2"), СтрокаОстатков.Наименование, СтрокаОстатков.Код);
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументСсылка, Поле,,Отказ);
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Не Отказ;
	
КонецФункции

Функция ПолучитьРеквизитСписанияОСБаланс(ДокументСсылка, ИмяРеквизита, ЭтоКапВложение = Ложь, НомерСтроки = 0, ОстанавливатьПриОшибке = Истина) Экспорт
	
	Если ЭтоКапВложение = Истина Тогда
		ТаблицаОС = БухгалтерскиеОперацииПовтИсп.ТаблицаОСДляСписания(ДокументСсылка, ЭтоКапВложение);
	Иначе
		ТаблицаОС = БухгалтерскиеОперацииПовтИсп.НОВАЯ_ОСтаткиОСНМАНПА(ДокументСсылка);
	КонецЕсли;
	
	ИмяКолонкиИнвНомер = "";
	Если ТаблицаОС.Колонки.Найти("ИнвНомер") <> Неопределено Тогда
		ИмяКолонкиИнвНомер = "ИнвНомер";
	ИначеЕсли ТаблицаОС.Колонки.Найти("ИнвентарныйНомер") <> Неопределено Тогда
		ИмяКолонкиИнвНомер = "ИнвентарныйНомер";
	КонецЕсли;
	
	Если НомерСтроки = 0 Тогда
		НайденнаяСтрока = ?(ТаблицаОС.Количество()=1 ИЛИ ПустаяСтрока(ИмяКолонкиИнвНомер), ТаблицаОС[0], ТаблицаОС.Найти(ДокументСсылка.ИнвентарныйНомер, ИмяКолонкиИнвНомер));
	Иначе
		СтрокаДокумента = ДокументСсылка.ОсновныеСредства[НомерСтроки - 1];
		
		Если НЕ ЗначениеЗаполнено(ИмяКолонкиИнвНомер) Тогда
			Отбор = Новый Структура("ОсновноеСредство", СтрокаДокумента.ОсновноеСредство);
		Иначе	
			Отбор = Новый Структура("ОсновноеСредство, " + ИмяКолонкиИнвНомер, СтрокаДокумента.ОсновноеСредство, СтрокаДокумента.ИнвентарныйНомер);
		КонецЕсли;	
		
		НайденныеСтроки = ТаблицаОС.НайтиСтроки(Отбор);
		НайденнаяСтрока = Неопределено;
		Если НайденныеСтроки.Количество() > 0 Тогда
			НайденнаяСтрока = НайденныеСтроки[0];
		КонецЕсли;	
	КонецЕсли;
	
	Если Не ОстанавливатьПриОшибке И НайденнаяСтрока = Неопределено Тогда
		НайденнаяСтрока = ТаблицаОС.Добавить();
	КонецЕсли;
	
	Возврат ПолучитьЗначениеРеквизитаСтроки(НайденнаяСтрока, ИмяРеквизита);
	
КонецФункции

