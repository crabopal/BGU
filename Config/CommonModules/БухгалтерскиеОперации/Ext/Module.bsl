Функция РеквизитШапкиРавенЗначению(ДокументСсылка, ИмяРеквизита, Значение) Экспорт
	
	Отказ = Ложь;
	
	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка,ИмяРеквизита) <> Значение Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'Значение реквизита %1 некорректно для выбранной бухгалтерской операции. Ожидается значение ""%2"".'"),
						ИмяРеквизита, Значение);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументСсылка, ИмяРеквизита, "Объект");
		Отказ = Истина;
	КонецЕсли;
	
	Возврат НЕ Отказ;
	
КонецФункции

Функция ВсеРеквизитыТабличнойЧастиРавныЗначению(ДокументСсылка, ИмяТабличнойЧасти, ИмяРеквизита, Значение) Экспорт
	
	Отказ = Ложь;
	
	СтруктураПолей = Новый Структура(ИмяРеквизита,ИмяРеквизита);
	
	РезультатЗапросаПоТЧ = СформироватьЗапросПоТабличнойЧасти(ДокументСсылка,ИмяТабличнойЧасти,СтруктураПолей);
	Выборка = РезультатЗапросаПоТЧ.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка[ИмяРеквизита] <> Значение Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
							НСтр("ru = 'Значение реквизита %1 некорректно для выбранной бухгалтерской операции. Ожидается значение ""%2"".'"),
							ИмяРеквизита, Значение);
			ИндексСтроки = Выборка.НомерСтроки - 1;
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументСсылка, ИмяТабличнойЧасти+"["+ИндексСтроки+"]."+ИмяРеквизита, "Объект");
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат НЕ Отказ;
	
КонецФункции

Функция ВсеРазделыЛССоответствуютКФО(ДокументСсылка, ИмяТабличнойЧасти, ИмяРеквизита, ЗначениеКФО) Экспорт   
	
	ИмяДокумента = ДокументСсылка.Метаданные().Имя; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ 
	|	Док." + ИмяРеквизита + " КАК РазделЛС,  
	|	Док." + ИмяРеквизита + ".КодПоступленияЕБП КАК КодПоступления 
	|
	|ИЗ 
	|	Документ." + ИмяДокумента + "."+ СокрЛП(ИмяТабличнойЧасти) + " КАК Док
	|
	|ГДЕ
	|	Док.Ссылка = &ДокументСсылка";

	// Параметры запроса.
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка." + ИмяДокумента) Тогда
		Запрос.УстановитьПараметр("ДокументСсылка" , ДокументСсылка);
	Иначе	
		Запрос.УстановитьПараметр("ДокументСсылка" , ДокументСсылка.Ссылка);
	КонецЕсли;	

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл 
		КФОРаздела = ПлатежноРасчетныеДокументыКлиентСервер.КФОПоКодуПоступленияЕБП(Выборка.КодПоступления);
		Если КФОРаздела <> ЗначениеКФО Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
							НСтр("ru = 'Раздел лицевого счета %1 не может использоваться для выбранной бухгалтерской операции.'"),
							Выборка.РазделЛС);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументСсылка);
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

    Возврат Истина;
	
КонецФункции	

Функция ЗначениеРеквизитаРодительскойТаблицыПоИдентификатору(ДокументСсылка, Идентификатор, ИмяРеквизита,
	ИмяРодительскойТаблицы = "РасшифровкаПлатежа", ИмяИдентификатора = "ИдентификаторСтроки") Экспорт
	
	ИмяДок = ДокументСсылка.Метаданные().Имя;
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ
	|	РодительскаяТаблица." + ИмяРеквизита + " КАК Значение
	|ИЗ
	|	Документ." + ИмяДок + "." + ИмяРодительскойТаблицы + " КАК РодительскаяТаблица
	|ГДЕ
	|	РодительскаяТаблица.Ссылка = &Ссылка
	|	И РодительскаяТаблица." + ИмяИдентификатора + " = &Идентификатор"); 
	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Значение;
	КонецЕсли;	
	
	Возврат Неопределено;
	
КонецФункции	


// По переданной структуре полей формирует запрос по табличной части документа.
//
// Параметры: 
//  ДокументОбъект    - объект проводимого документа, 
//  ИмяТабличнойЧасти - строка, имя табличной части,
//  СтруктураПолей    - структура, ключ структуры содержит псевдоним поля запроса, значение - строку запроса,
//
// Возвращаемое значение:
//  Результат запроса.
//
Функция СформироватьЗапросПоТабличнойЧасти(ДокументОбъект, ИмяТабличнойЧасти, СтруктураПолей) Экспорт

	ТекстЗапроса = "";

	Для Каждого Реквизит Из СтруктураПолей Цикл

		ТекстЗапроса  = ТекстЗапроса + ",
		|	Док." + Реквизит.Значение + " КАК " + СокрЛП(Реквизит.Ключ);

	КонецЦикла;

	ИмяДокумента = ДокументОбъект.Метаданные().Имя;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ 
	|	Док.НомерСтроки " + ТекстЗапроса + "
	|
	|ИЗ 
	|	Документ." + ИмяДокумента + "."+ СокрЛП(ИмяТабличнойЧасти) + " КАК Док
	|
	|ГДЕ
	|	Док.Ссылка = &ДокументСсылка";

	// Установим параметры запроса.
	
	Если ТипЗнч(ДокументОбъект) = Тип("ДокументСсылка." + ИмяДокумента) Тогда
		Запрос.УстановитьПараметр("ДокументСсылка" , ДокументОбъект);
	Иначе	
		Запрос.УстановитьПараметр("ДокументСсылка" , ДокументОбъект.Ссылка);
	КонецЕсли;	

	Возврат Запрос.Выполнить();

КонецФункции

Функция ОперацияОтраженаВУчетеДоПослеПереходаНаПриказ64н2018(ДоПосле, ВводОстатков = Ложь) Экспорт
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	ДокументОбъект = КонтекстПроведения.ДокументОбъект;
	
	ДатаПереходаНаРедакцию64н = БухгалтерскийУчетПовтИсп.ДатаПереходаНаРедакциюПС(ДокументОбъект.Организация, Дата('20180101'));
	Если НЕ ЗначениеЗаполнено(ДатаПереходаНаРедакцию64н) Тогда
		ДатаПереходаНаРедакцию64н = КонецГода('20180101');
	КонецЕсли;
	
	ДатаПроведенияДокумента = ДокументОбъект.Дата;
	
	Если ВводОстатков Тогда
		// Для документа ввода остатков для проверки даты используем дату начала следующего года
		// и не выводим сообщение при нарушении контроля
		
		ДатаПроведенияДокумента = КонецГода(ДокументОбъект.Дата) + 1;
	КонецЕсли;
	
	// Если документ проводится другой датой, отличной от даты документа.
	ДокументыСОтложеннымИсполнением =
		Метаданные.РегистрыСведений.СостояниеПлатежноРасчетныхДокументов.Измерения.ПлатежноРасчетныйДокумент.Тип;
	Если ДокументыСОтложеннымИсполнением.СодержитТип(ТипЗнч(ДокументОбъект.Ссылка)) Тогда
		ДатаИсполненияДокумента = БухгалтерскиеОперации.ДатаИсполненияДокумента(ДокументОбъект.Ссылка);
		Если ЗначениеЗаполнено(ДатаИсполненияДокумента) Тогда
			ДатаПроведенияДокумента = ДатаИсполненияДокумента;
		КонецЕсли;
	КонецЕсли;
	
	ОперацияОтраженаВУчетеДоПереходаНаПриказ64н2018 = (НачалоДня(ДатаПроведенияДокумента) < НачалоДня(ДатаПереходаНаРедакцию64н));
	
	Если (ДоПосле = "ДО") Тогда
		
		Если НЕ ОперацияОтраженаВУчетеДоПереходаНаПриказ64н2018 И НЕ ВводОстатков Тогда
			ОбщегоНазначения.СообщитьПользователю(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru='Типовая операция ""%1"" может использоваться только ДО даты перехода на редакцию Плана счетов по Приказу 64н - до %2.'"),
						КонтекстПроведения.ТиповаяОперация,
						Формат(ДатаПереходаНаРедакцию64н, "ДЛФ=Д")));
		КонецЕсли;
		
		Возврат ОперацияОтраженаВУчетеДоПереходаНаПриказ64н2018;
		
	ИначеЕсли (ДоПосле = "ПОСЛЕ") Тогда
		
		Если ОперацияОтраженаВУчетеДоПереходаНаПриказ64н2018 И НЕ ВводОстатков Тогда
			ОбщегоНазначения.СообщитьПользователю(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru='Типовая операция ""%1"" может использоваться только ПОСЛЕ даты перехода на редакцию Плана счетов по Приказу 64н - после %2.'"),
						КонтекстПроведения.ТиповаяОперация,
						Формат(ДатаПереходаНаРедакцию64н, "ДЛФ=Д")));
		КонецЕсли;
		
		Возврат НЕ ОперацияОтраженаВУчетеДоПереходаНаПриказ64н2018;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

