// Это казенное учреждение.
// 
// Параметры:
//  Организация - СправочникСсылка.Организации
//  Дата - Дата
// 
// Возвращаемое значение:
//  Булево
Функция ЭтоКазенноеУчреждение(Организация, Дата) Экспорт
	Возврат БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Организация, Дата).ЭтоКазенноеУчреждение;
КонецФункции

Функция НомерЖурнала(СчетДт, СчетКт) Экспорт
	
	Возврат БухгалтерскийУчетПовтИсп.НомерЖурнала(СчетДт, СчетКт);
	
КонецФункции

Функция ДатаИсполненияДокумента(Документ) Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	|	СостояниеПлатежноРасчетныхДокументов.ДатаПроведения
	|ИЗ
	|	РегистрСведений.СостояниеПлатежноРасчетныхДокументов КАК СостояниеПлатежноРасчетныхДокументов
	|ГДЕ
	|	СостояниеПлатежноРасчетныхДокументов.ПлатежноРасчетныйДокумент = &Документ");
	 
	Запрос.УстановитьПараметр("Документ", Документ);
	
	ДатаПроведения = "";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ДатаПроведения = Выборка.ДатаПроведения;
	КонецЕсли;
	
	Возврат ДатаПроведения;
	
КонецФункции

Функция СтатусДокумента(Документ)  Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	СостояниеПлатежноРасчетныхДокументов.Статус
	                      |ИЗ
	                      |	РегистрСведений.СостояниеПлатежноРасчетныхДокументов КАК СостояниеПлатежноРасчетныхДокументов
	                      |ГДЕ
	                      |	СостояниеПлатежноРасчетныхДокументов.ПлатежноРасчетныйДокумент = &Документ");
	 
	Запрос.УстановитьПараметр("Документ", Документ);
	
	Статус = "";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Статус = Выборка.Статус;
	КонецЕсли;
	
	Возврат Статус;
	
КонецФункции

// Получает реквизит подтверждающего документа из статуса.
Функция ПолучитьРеквизитПодтверждающегоДокумента(ВидРеквизита, ДокументСсылка) Экспорт
	
	СостояниеДокумента = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(ДокументСсылка);
	
	Если ЗначениеЗаполнено(СостояниеДокумента.НомерПодтверждающегоДокумента) И ЗначениеЗаполнено(СостояниеДокумента.ДатаПодтверждающегоДокумента) Тогда
		Если (ВидРеквизита = "ВидПодтверждающегоДокумента") И НЕ ЗначениеЗаполнено(СостояниеДокумента.ВидПодтверждающегоДокумента) Тогда
			ПечатныйОбраз = СостояниеДокумента.ПервичныйОбразИРеквизиты.Получить();
			Если ПечатныйОбраз = Неопределено Тогда
				Возврат  ДокументСсылка.Метаданные().Синоним;
			КонецЕсли;	
			Если ТипЗнч(ПечатныйОбраз) = Тип("Массив") Тогда
				Если ПечатныйОбраз.Количество()> 0 Тогда
					ПечатныйОбраз = ПечатныйОбраз[0]
				КонецЕсли;
			КонецЕсли;	
			Если ТипЗнч(ПечатныйОбраз) = Тип("Структура") Тогда
				ВидОперации = "";
		        ПечатныйОбраз.Свойство("ВидОперации", ВидОперации);
				НайденныйВид = ОпределитьВидПодтверждающегоДокумента(ВидОперации);
				Возврат ?(НайденныйВид = "", ДокументСсылка.Метаданные().Синоним, НайденныйВид);  
			Иначе
				Возврат "";
			КонецЕсли;
		Иначе
			Возврат СостояниеДокумента[ВидРеквизита];
		КонецЕсли;	
	Иначе
		Если ВидРеквизита = "НомерПодтверждающегоДокумента" Тогда
			Возврат ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "Номер"));
		ИначеЕсли ВидРеквизита = "ДатаПодтверждающегоДокумента" Тогда
			Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "Дата");
		ИначеЕсли ВидРеквизита = "ВидПодтверждающегоДокумента" Тогда
			Возврат  ДокументСсылка.Метаданные().Синоним;
		КонецЕсли;
	КонецЕсли;

	Возврат "";
	
КонецФункции

// Возвращает название подтверждающего документа по номеру вида операции (из данных казначейства).
Функция ОпределитьВидПодтверждающегоДокумента(ВидОперации) Экспорт
	
	Возврат ПлатежноРасчетныеДокументы.ОпределитьВидПодтверждающегоДокумента(ВидОперации);
		
КонецФункции	

Функция СчетПоКЭК(КЭК, ДопустимыеСчета = "", ПолучитьВсеСчета = Ложь, Знач НаДату = Неопределено, Знач Организация = Неопределено, Знач ИФО = Неопределено, Знач КПС = Неопределено) Экспорт
	
	// Проверить заполнение входных параметров
	ОбязательныеПараметры = Новый Структура("КЭК", КЭК);
	Если Не ПроверитьОбязательныеПараметрыФункции(ОбязательныеПараметры, "СчетПоКЭК") Тогда
		Возврат ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	КонецЕсли;
	
	Если НаДату = Неопределено ИЛИ Организация = Неопределено ИЛИ ИФО = Неопределено Тогда
		КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
		Если НаДату = Неопределено Тогда
			НаДату = КонтекстПроведения.ДокументОбъект.Дата;
		КонецЕсли;
		Если Организация = Неопределено Тогда
			Организация = КонтекстПроведения.ДокументОбъект.Организация;
		КонецЕсли;
		Если ИФО = Неопределено Тогда
			Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ИФО", КонтекстПроведения.ДокументОбъект.Метаданные()) Тогда
				ИФО = КонтекстПроведения.ДокументОбъект.ИФО;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	СчетПоКЭК = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(КЭК, ДопустимыеСчета, ПолучитьВсеСчета, НаДату, Организация, ИФО, КПС);
	
	Если Не ЗначениеЗаполнено(СчетПоКЭК) Тогда
		Если ПустаяСтрока(ДопустимыеСчета) Тогда
			СтрокаОшибки = НСтр("ru = 'По КЭК = ""%1"" невозможно определить счет'");
		Иначе
			СтрокаОшибки = НСтр("ru = 'По КЭК = ""%1"" невозможно определить счет из допустимых счетов = ""%2""'");
		КонецЕсли;
		
		ДобавитьОшибкуВКонтекстПроведения(	СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
											Строка(СтрокаОшибки),
											Строка(КЭК),
											Строка(ДопустимыеСчета)),
											"СчетПоКЭК");
	КонецЕсли;
	
	Возврат СчетПоКЭК;
	
КонецФункции

Функция СчетНалога(НалогСборПлатеж, Знач НаДату = Неопределено) Экспорт
	
	// Проверить заполнение входных параметров
	ОбязательныеПараметры = Новый Структура("НалогСборПлатеж", НалогСборПлатеж);
	Если Не ПроверитьОбязательныеПараметрыФункции(ОбязательныеПараметры, "СчетНалога") Тогда
		Возврат ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	КонецЕсли;
	
	Если ТипЗнч(НалогСборПлатеж) = Тип("СправочникСсылка.НалогиИПлатежиОрганизации") Тогда 
		СтруктураПоиска = Новый Структура("СчетНалога", "ВидНалогаИлиПлатежа.СчетУчета");
	ИначеЕсли ТипЗнч(НалогСборПлатеж) = Тип("СправочникСсылка.ВидыНалоговИПлатежей") Тогда 
		СтруктураПоиска = Новый Структура("СчетНалога", "СчетУчета");
	Иначе
		ДобавитьОшибкуНеПравильныйТипПараметра("НалогСборПлатеж", НалогСборПлатеж, "СчетНалога");
		Возврат ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	КонецЕсли;
	
	КодСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НалогСборПлатеж, СтруктураПоиска).СчетНалога;
	
	Если Не ЗначениеЗаполнено(КодСчета) Тогда
		СтрокаОшибки = СтрШаблон(НСтр("ru = 'Не указан код счета налога/сбора: ""%1""'"),
			НалогСборПлатеж);
		ДобавитьОшибкуВКонтекстПроведения(СтрокаОшибки, "СчетНалога");
		Возврат ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	КонецЕсли;
	
	Если НаДату = Неопределено Тогда
		КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
		НаДату = КонтекстПроведения.ДокументОбъект.Дата;
	КонецЕсли;
	
	СчетПоКоду = БухгалтерскийУчет.СчетПоКоду(КодСчета, НаДату);
	
	Если Не ЗначениеЗаполнено(СчетПоКоду) Тогда
		СтрокаОшибки = СтрШаблон(НСтр("ru = 'Не найден счет с кодом ""%1"", актуальный на %2'"),
			Строка(КодСчета), Формат(НаДату, "ДЛФ=D"));
		ДобавитьОшибкуВКонтекстПроведения(СтрокаОшибки, "СчетНалога");
		Возврат ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	КонецЕсли;
	
	Возврат СчетПоКоду;
	
КонецФункции

Функция ВидНалогаНСиПЗ(НаДату) Экспорт
	
	Возврат Справочники.ВидыНалоговИПлатежей.ВидНалогаНСиПЗ(НаДату);
	
КонецФункции

Функция РазделЛицевогоСчетаПоКФО(ЛицевойСчет, КФО) Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	РазделыЛицевыхСчетовДопустимыеКФО.Ссылка
	                      |ИЗ
	                      |	Справочник.РазделыЛицевыхСчетов.ДопустимыеКФО КАК РазделыЛицевыхСчетовДопустимыеКФО
	                      |ГДЕ
	                      |	РазделыЛицевыхСчетовДопустимыеКФО.Ссылка.Владелец = &Владелец
	                      |	И РазделыЛицевыхСчетовДопустимыеКФО.КФО = &КФО");
						  
	Запрос.УстановитьПараметр("Владелец", ЛицевойСчет);
	Запрос.УстановитьПараметр("КФО", КФО);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.РазделыЛицевыхСчетов.ПустаяСсылка();
	
КонецФункции

Функция РазделЛицевогоСчетаПоИсточникуСредств(ЛицевойСчет, ИсточникСредств, ИсполняемыйДоговор = Неопределено) Экспорт
	
	РазделЛицевогоСчетаПоИсточникуСредств = БухгалтерскийУчетПовтИсп.РазделЛицевогоСчетаПоИсточникуСредств(ЛицевойСчет, ИсточникСредств, ИсполняемыйДоговор);
	
	Если Не ЗначениеЗаполнено(РазделЛицевогоСчетаПоИсточникуСредств) Тогда
		ТекстОшибки = "";
		Если Не ЗначениеЗаполнено(ЛицевойСчет) Тогда
			ТекстОшибки = ТекстОшибки + НСтр("ru = 'Не заполнен лицевой счет.'");
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ИсточникСредств) Тогда
			Если Не ПустаяСтрока(ТекстОшибки) Тогда
				ТекстОшибки = ТекстОшибки + " ";
			КонецЕсли;
			ТекстОшибки = ТекстОшибки + НСтр("ru = 'Не заполнен источник средств'");
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ИсполняемыйДоговор)
			И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЛицевойСчет, "КазначейскоеСопровождениеНаРазделах") Тогда
			Если Не ПустаяСтрока(ТекстОшибки) Тогда
				ТекстОшибки = ТекстОшибки + " ";
			КонецЕсли;
			ТекстОшибки = ТекстОшибки + НСтр("ru = 'Не заполнен исполняемый договор'");
		КонецЕсли;
		Если ПустаяСтрока(ТекстОшибки) Тогда
			
			ТекстОшибки = НСтр("ru = 'У лицевого счета %1 не задан раздел для источника средств = ""%2""'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
																				  Строка(ЛицевойСчет),
																				  Строка(ИсточникСредств));
			
		КонецЕсли;
		ДобавитьОшибкуВКонтекстПроведения(ТекстОшибки, "РазделЛицевогоСчетаПоИсточникуСредств");
	КонецЕсли;
	
	Возврат РазделЛицевогоСчетаПоИсточникуСредств;
	
КонецФункции

Функция КФОПоРазделуЛицевогоСчета(РазделЛицевогоСчета) Экспорт
	
	КодПоступления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РазделЛицевогоСчета, "КодПоступленияЕБП");
	
	КФО = ПлатежноРасчетныеДокументыКлиентСервер.КФОПоКодуПоступленияЕБП(КодПоступления);
	
	Если НЕ ЗначениеЗаполнено(КФО) Тогда
		ТекстОшибки = НСтр("ru = 'Не удалось оперелить КФО по разделу лицевого счета ""%1""'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, Строка(РазделЛицевогоСчета));
		ДобавитьОшибкуВКонтекстПроведения(ТекстОшибки, "КФОПоРазделуЛицевогоСчета");
	КонецЕсли;
	
	Возврат КФО;
	
КонецФункции	
	
Функция КЭКСчета(Организация, ИФО = Неопределено, КФО = Неопределено, НаДату, КодСчета, ДтКт="Дт", КЭКОперации = Неопределено) Экспорт
	
	Если ТипЗнч(КодСчета) = Тип("Строка") Тогда 
		Счет = БухгалтерскийУчет.СчетПоКоду(КодСчета, НаДату, Организация);
	ИначеЕсли ОбщегоНазначения.ЗначениеСсылочногоТипа(КодСчета) И ОбщегоНазначения.ВидОбъектаПоСсылке(КодСчета) = "ПланСчетов" Тогда
		Счет = КодСчета;
	Иначе
		Счет = ПланыСчетов.ЕПСБУ.ПустаяСсылка()
	КонецЕсли;
	
	Если Счет.Пустая() Тогда
		ДобавитьОшибкуВКонтекстПроведения(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
											НСтр("ru = 'Не удалось найти счет по переданному параметру ""КодСчета"" = ""%1""'"),
											Строка(КодСчета)),
										  "КЭКСчета");
		Возврат Справочники.КОСГУ.ПустаяСсылка();
	КонецЕсли;

	ДопустимыеКЭКСчета =  БухгалтерскийУчетПовтИсп.ДопустимыеКЭКСчета(Счет);
	
	Если ДопустимыеКЭКСчета.Количество() > 2 Тогда
		
		Если ДопустимыеКЭКСчета.Найти(КЭКОперации) = Неопределено Тогда
			ДобавитьОшибкуВКонтекстПроведения(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
											НСтр("ru = 'КЭК ""%1"" не является допустимым для счета ""%2""'"),
											Строка(КЭКОперации), Строка(КодСчета)),
										  "КЭКСчета");
			Возврат Справочники.КОСГУ.ПустаяСсылка();
		КонецЕсли;
		
		Возврат КЭКОперации;
		
	КонецЕсли;

	Если БухгалтерскийУчетПовтИсп.ТипКЭКПоУчетнойПолитике(Организация, ИФО, КФО, НаДату) = Перечисления.ТипыАналитическихПризнаков.ПроизвольнаяКлассификация Тогда
	
		КЭК0 = БухгалтерскийУчетПовтИсп.КЭК0();

		Если НЕ ЗначениеЗаполнено(КЭК0) Тогда
			ДобавитьОшибкуВКонтекстПроведения(НСтр("ru = 'Не найден КЭК с кодом ""000""'"), "КЭКСчета");	
		КонецЕсли;
			
		Возврат КЭК0;
								  
	КонецЕсли; 
		
	Если НаДату < '20180101' И БухгалтерскийУчет.СчетВИерархии(Счет, "104.00") Тогда
		Если БухгалтерскийУчет.СчетВИерархии(Счет, "104.29,104.39,104.49,104.59") Тогда
			КодКЭК = "420";
		Иначе			
			КодКЭК = "410";
		КонецЕсли;
		Возврат Справочники.КОСГУ.НайтиПоКоду(КодКЭК);
	КонецЕсли;
	
	Если ДтКт="Дт" Тогда
		
		Если НЕ ЗначениеЗаполнено(Счет.КОСГУДт) Тогда
			ДобавитьОшибкуВКонтекстПроведения(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
												НСтр("ru = 'У счета ""%1"" не заполнен реквизит ""КОСГУ по дебету""'"),
												Строка(КодСчета)),
											  "КЭКСчета");
		КонецЕсли;
		
		Возврат Счет.КОСГУДт;
			
	Иначе
		
		Если НЕ ЗначениеЗаполнено(Счет.КОСГУКт) Тогда
			ДобавитьОшибкуВКонтекстПроведения(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
												НСтр("ru = 'У счета ""%1"" не заполнен реквизит ""КОСГУ по кредиту""'"),
												Строка(КодСчета)),
											  "КЭКСчета");
		КонецЕсли;
									  
		Возврат Счет.КОСГУКт;
	
	КонецЕсли; 
	
КонецФункции

// Определяет КЭК дебета или кредита в зависимости от учетной политики и используемой аналитики счета.
// В типовой операции указывается только параметр "ДтКт".
// Остальные параметры устанавливаются автоматически из указанной стороны проводки.
//
// Параметры:
//  Организация	 - СправочникСсылка.Организации - 
//  ИФО			 - СправочникСсылка.ИсточникиФинансовогоОбеспечения - 
//  КФО			 - ПеречислениеСсылка.КВД - 
//  Дата		 - Дата - 
//  Счет		 - ПланСчетовСсылка.ЕПСБУ - 
//  Субконто1	 - Характеристика.ВидыСубконто - 
//  Субконто2	 - Характеристика.ВидыСубконто - 
//  Субконто3	 - Характеристика.ВидыСубконто - 
//  ДтКт		 - Строка - 
// 
// Возвращаемое значение:
//   СправочникСсылка.КОСГУ, Неопределено -
//
//@skip-check method-too-many-params
Функция КЭКПроводки(Организация, ИФО, КФО, Дата, Счет, Субконто1, Субконто2, Субконто3, ДтКт) Экспорт
	
	
	КЭК = БухгалтерскиеОперацииПовтИсп.КЭКПроводки(Организация, ИФО, КФО, Дата, Счет,
		Субконто1, Субконто2, Субконто3, ДтКт);
	
	Если Не ЗначениеЗаполнено(КЭК) Тогда
		ДанныеПроводки = БухгалтерскийУчетКлиентСервер.ПараметрыРасчетаКЭКПроводки();
		ДанныеПроводки.Организация = Организация;
		ДанныеПроводки.ИФО         = ИФО;
		ДанныеПроводки.КФО         = КФО;
		ДанныеПроводки.Дата        = Дата;
		ДанныеПроводки.Счет        = Счет;
		ДанныеПроводки.Субконто1   = Субконто1;
		ДанныеПроводки.Субконто2   = Субконто2;
		ДанныеПроводки.Субконто3   = Субконто3;
		ДанныеПроводки.ДтКт        = ДтКт;
		ДобавитьОшибкуВКонтекстПроведения(ТекстОшибкиКЭКПроводки(ДанныеПроводки), "КЭКПроводки");
	КонецЕсли;
	
	Возврат КЭК;
	
КонецФункции

// Определяет КЭК дебета или кредита в зависимости от учетной политики и используемой аналитики счета.
// Параметр ""ИспользуемыйКОСГУ"" определяет какой КОСГУ берется, дебетовый или кредитовый.
// Функция используется, когда в дебет проводки подставляется КОСГУ кредита или в кредит проводки подставляется КОСГУ дебета.
// Возвращает КЭК увеличения или уменьшения.
// В типовой операции указывается только "ДтКт" и "используемый ДтКт".
// По значению ДтКт подбираются параметры из проводки, после этого "ИспользуемыйДтКт" передается в параметр "ДтКт".
//
// Параметры:
//  Организация	 - СправочникСсылка.Организации - 
//  ИФО			 - СправочникСсылка.ИсточникиФинансовогоОбеспечения - 
//  КФО			 - ПеречислениеСсылка.КВД - 
//  Дата		 - Дата - 
//  Счет		 - ПланСчетовСсылка.ЕПСБУ - 
//  Субконто1	 - Характеристика.ВидыСубконто - 
//  Субконто2	 - Характеристика.ВидыСубконто - 
//  Субконто3	 - Характеристика.ВидыСубконто - 
//  ДтКт		 - Строка - 
// 
// Возвращаемое значение:
//   - 
//
Функция КЭКПроводкиСВыборомДтКт(Организация, ИФО, КФО, Дата, Счет, Субконто1, Субконто2, Субконто3, ДтКт) Экспорт
	
	КЭК = БухгалтерскиеОперацииПовтИсп.КЭКПроводки(Организация, ИФО, КФО, Дата, Счет,
		Субконто1, Субконто2, Субконто3, ДтКт);
	
	Если Не ЗначениеЗаполнено(КЭК) Тогда
		ДанныеПроводки = БухгалтерскийУчетКлиентСервер.ПараметрыРасчетаКЭКПроводки();
		ДанныеПроводки.Организация = Организация;
		ДанныеПроводки.ИФО         = ИФО;
		ДанныеПроводки.КФО         = КФО;
		ДанныеПроводки.Дата        = Дата;
		ДанныеПроводки.Счет        = Счет;
		ДанныеПроводки.Субконто1   = Субконто1;
		ДанныеПроводки.Субконто2   = Субконто2;
		ДанныеПроводки.Субконто3   = Субконто3;
		ДанныеПроводки.ДтКт        = ДтКт;
		ДобавитьОшибкуВКонтекстПроведения(ТекстОшибкиКЭКПроводки(ДанныеПроводки), "КЭКПроводкиСВыборомДтКт");
	КонецЕсли;
	
	Возврат КЭК;
	
КонецФункции

// Проверяет допустимость использования КЭК с указанным счетом.
// Возвращает КЭКОперации, если такой КЭК допустим с выбранным счетом и анлитикой. Если КЭК не допустим, возвращает пустой КЭК.
// В типовой операции указывается только параметр "ДтКт" и "КЭКОперации".
// Остальные параметры устанавливаются автоматически из указанной стороны проводки.
//
// Параметры:
//  Организация	 - СправочникСсылка.Организации - 
//  ИФО			 - СправочникСсылка.ИсточникиФинансовогоОбеспечения - 
//  КФО			 - ПеречислениеСсылка.КВД - 
//  Дата		 - Дата - 
//  Счет		 - ПланСчетовСсылка.ЕПСБУ - 
//  Субконто1	 - Характеристика.ВидыСубконто - 
//  Субконто2	 - Характеристика.ВидыСубконто - 
//  Субконто3	 - Характеристика.ВидыСубконто - 
//  ДтКт		 - Строка - 
//  КЭКОперации	 - СправочникСсылка.КОСГУ - 
// 
// Возвращаемое значение:
//   - СправочникСсылка.КОСГУ
//
Функция ДопустимыйКЭКПроводки(Организация, ИФО, КФО, Дата, Счет, Субконто1, Субконто2, Субконто3, ДтКт, КЭКОперации) Экспорт
	
	ДанныеПроводки = БухгалтерскийУчет.ПараметрыРасчетаКЭКПроводки();
	ДанныеПроводки.Организация = Организация;
	ДанныеПроводки.ИФО         = ИФО;
	ДанныеПроводки.КФО         = КФО;
	ДанныеПроводки.Дата        = Дата;
	ДанныеПроводки.Счет        = Счет;
	ДанныеПроводки.Субконто1   = Субконто1;
	ДанныеПроводки.Субконто2   = Субконто2;
	ДанныеПроводки.Субконто3   = Субконто3;
	ДанныеПроводки.ДтКт        = ДтКт;
	ДанныеПроводки.КЭКОперации = КЭКОперации;
	
	КЭК = БухгалтерскийУчет.КЭКПроводки(ДанныеПроводки);
	
	Если Не ЗначениеЗаполнено(КЭК) Тогда
		ДобавитьОшибкуВКонтекстПроведения(ТекстОшибкиКЭКПроводки(ДанныеПроводки), "ДопустимыйКЭКПроводки");
	КонецЕсли;
	
	Возврат КЭК;
	
КонецФункции

Функция ИспользуетсяПроизвольныйТипКЭК(Организация, ИФО = Неопределено, КФО = Неопределено, НаДату) Экспорт
	
	Возврат (БухгалтерскийУчетПовтИсп.ТипКЭКПоУчетнойПолитике(Организация, ИФО, КФО, НаДату) = Перечисления.ТипыАналитическихПризнаков.ПроизвольнаяКлассификация);
	
КонецФункции

Функция ИспользуетсяПроизвольныйТипКПС(Организация, ИФО = Неопределено, КФО = Неопределено, НаДату) Экспорт
	
	Возврат (БухгалтерскийУчетПовтИсп.ТипКПСПоУчетнойПолитике(Организация, ИФО, КФО, НаДату) = Перечисления.ТипыАналитическихПризнаков.ПроизвольнаяКлассификация);
	
КонецФункции

Функция АналитическийКЭКпоСчету(Счет) Экспорт
	
	Если Не ЗначениеЗаполнено(Счет) Тогда
		ТекстОшибки = НСтр("ru = 'Не задан счет.'");
		ДобавитьОшибкуВКонтекстПроведения(ТекстОшибки, "АналитическийКЭКпоСчету");
		Возврат ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	КонецЕсли;
	
	КЭКпоСчету = БухгалтерскийУчетПовтИсп.АналитическийКЭКпоСчету(Счет);
	
	Если Не ЗначениеЗаполнено(КЭКпоСчету) Тогда
		ТекстОшибки = НСтр("ru = 'В регистре ""Соответствие аналитических счетов КЭК"" отсутствует запись для счета ""%1""'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, Строка(Счет));
		ДобавитьОшибкуВКонтекстПроведения(ТекстОшибки, "АналитическийКЭКпоСчету");
	КонецЕсли;
	
	Возврат КЭКпоСчету;
	
КонецФункции

Функция КПССчета(Организация, ИФО = Неопределено, КФО, Период, Счет, КПСКорр = Неопределено) Экспорт
	
	КПССчета = БухгалтерскиеОперацииПовтИсп.КПССчета(Организация, ИФО, КФО, Период, Счет,, КПСКорр);
	
	Если Не ЗначениеЗаполнено(КПССчета) Тогда
		
		Если ЗначениеЗаполнено(ИФО) Тогда
			ТекстОшибки = НСтр("ru = 'Не найден рабочий счет для ИФО = ""%4"", КФО = ""%1"",  счет ЕПСБУ=""%2"", действующий %3.'");
		Иначе		 
			ТекстОшибки = НСтр("ru = 'Не найден рабочий счет для КФО = ""%1"",  счет ЕПСБУ=""%2"", действующий %3.'");
		КонецЕсли;
		ТекстОшибки = ТекстОшибки + НСтр("ru = '
									|Добавьте счет в рабочий план счетов.'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
		Строка(КФО),
		Строка(Счет),
		Формат(Период, "ДЛФ=D"),
		Строка(ИФО));
		
		ДобавитьОшибкуВКонтекстПроведения(ТекстОшибки, "КПССчета");																			
		
	КонецЕсли;
	
	Возврат КПССчета;
	
КонецФункции

Функция СчетПоКоду(КодСчета, Знач НаДату = Неопределено) Экспорт
	
	// Проверить заполнение входных параметров
	ОбязательныеПараметры = Новый Структура("КодСчета", КодСчета);
	Если Не ПроверитьОбязательныеПараметрыФункции(ОбязательныеПараметры, "СчетПоКоду") Тогда
		Возврат ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	КонецЕсли;
	
	Если НаДату = Неопределено Тогда
		КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
		НаДату = КонтекстПроведения.ДокументОбъект.Дата;
	КонецЕсли;
	
	Если КодСчета = "27" Тогда
		СчетПоКоду = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
		СписокСчетов = БухгалтерскийУчет.СписокСчетов(КодСчета, НаДату, Истина);
		Для каждого Счет Из СписокСчетов Цикл
			Если НЕ БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Счет).ЭлементГруппа Тогда
				СчетПоКоду = Счет;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	Иначе
		СчетПоКоду = БухгалтерскийУчет.СчетПоКоду(КодСчета, НаДату);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СчетПоКоду) Тогда
		СтрокаОшибки = СтрШаблон(НСтр("ru = 'Не найден счет с кодом ""%1"", актуальный на %2'"),
			Строка(КодСчета), Формат(НаДату, "ДЛФ=D"));
		ДобавитьОшибкуВКонтекстПроведения(СтрокаОшибки, "СчетПоКоду");
		Возврат ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	КонецЕсли;
	
	Возврат СчетПоКоду;
	
КонецФункции

// Ищет элемент КЭК по переданному коду. Если не найден, то возвращает пустую ссылку.
//
// Параметры:
//  КодКЭК	 - Строка - код, по которому ищется КЭК.
// 
// Возвращаемое значение:
// СправочникСсылка.КОСГУ - найденный КЭК.
//
Функция КЭКПоКоду(КодКЭК) Экспорт
	
	КЭКПоКоду = БухгалтерскийУчетПовтИсп.КЭКПоКоду(КодКЭК);
	
	Если Не ЗначениеЗаполнено(КЭКПоКоду) Тогда
		СтрокаОшибки = СтрШаблон(НСтр("ru = 'Не найден КЭК с кодом ""%1""'"), Строка(КодКЭК));
		ДобавитьОшибкуВКонтекстПроведения(СтрокаОшибки, "КЭКПоКоду");
	КонецЕсли;
	
	Возврат КЭКПоКоду;
	
КонецФункции

// Функция ищет элемент справочника КПС по коду.
//
// Параметры:
//  КодКПС       - Строка, код бюджетной классификации (17 знаков).
//  НаДату       - Дата, дата по состоянию на которую действует искомый КПС,
//                 по умолчанию поиск производится на текущую дату сеанса.
//  ВидКПС       - ПеречислениеСсылка.ВидыКБК, вид КПС для ограничения зоны поиска,
//                 необязателен.
//
// Возврващаемое значение:
//  Справочникссылка.КлассификационныеПризнакиСчетов, если элемент не найден - ПустаяСсылка.
//
Функция КПСПоКоду(КодКПС, НаДату = Неопределено, ВидКПС = Неопределено) Экспорт
	
	КПСПоКоду = БухгалтерскийУчетПовтИсп.КПСПоКоду(КодКПС, НаДату, ВидКПС);
	
	Если Не ЗначениеЗаполнено(КПСПоКоду) Тогда
		
		Если ЗначениеЗаполнено(ВидКПС) Тогда
			
			СтрокаОшибки = НСтр("ru = 'Не найден КПС вида ""%3"" с кодом ""%1"" действующий %2'");
			
		Иначе
			
			СтрокаОшибки = НСтр("ru = 'Не найден КПС с кодом ""%1"" действующий %2'");
			
		КонецЕсли;
		
		СтрокаОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
													СтрокаОшибки,
													Строка(КодКПС),
													Формат(?(ЗначениеЗаполнено(НаДату), НаДату, ТекущаяДатаСеанса()),"ДЛФ=D"),
													Строка(ВидКПС));	
		ДобавитьОшибкуВКонтекстПроведения(СтрокаОшибки, "КПСПоКоду");
		
	КонецЕсли;
	
	Возврат КПСПоКоду;
	
КонецФункции

// Функция ищет элемент справочника КПС по коду БК налога.
//
// Параметры:
//  Налог        - Справочникссылка.ВидыНалоговИПлатежей
//  НаДату       - Дата, дата по состоянию на которую действует искомый КПС,
//                 по умолчанию поиск производится на текущую дату сеанса.
//
// Возврващаемое значение:
//  Справочникссылка.КлассификационныеПризнакиСчетов, если элемент не найден - ПустаяСсылка.
//
Функция КПСНалога(Налог, НаДату = Неопределено) Экспорт
	
	// Проверку на заполнение результата не делаем, обработку пустого значения
	// проводим в настройке операции

	Если ЗначениеЗаполнено(Налог) Тогда
		КодКПС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Налог, "Классификатор");
	Иначе
		Возврат ПредопределенноеЗначение("Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка");
	КонецЕсли;	
	
		Возврат БухгалтерскийУчетПовтИсп.КПСПоКоду(КодКПС, НаДату);
	
КонецФункции

//Возвращает КПС для счета 17 или 18, используемый автономными и (или) бюджетными учреждениями
//при отражении в учете возвратов прошлых лет
//
// Параметры:
//  КПС_Счета20100   - Справочникссылка.КлассификационныеПризнакиСчетов
//  АналитическийКод - Строка, аналитический код, которым следует заменить
//                     последние 3 символа КПС, использованного для счета 20100
//  НаДату           - Дата, дата по состоянию на которую действует искомый КПС,
//                     по умолчанию поиск производится на текущую дату сеанса.
//
// Возврващаемое значение:
//  Справочникссылка.КлассификационныеПризнакиСчетов, если элемент не найден - ПустаяСсылка.
//
Функция КПСВозвратаПрошлыхЛет(КПС_Счета20100, АналитическийКод, НаДату = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(КПС_Счета20100) Тогда
		Возврат Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка();
		//ошибку не добавляем, будет сообщение о незаполненном КПС счета 20100
	КонецЕсли;
	
	НачальныеЗначения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(КПС_Счета20100, "Код, ВидПоказателя");
	
	ИскомыйКод = Лев(НачальныеЗначения.Код, 14) + АналитическийКод;
	
	КПСПоКоду = БухгалтерскийУчетПовтИсп.КПСПоКоду(ИскомыйКод, НаДату, НачальныеЗначения.ВидПоказателя);
	
	Если Не ЗначениеЗаполнено(КПСПоКоду) Тогда
		
		СтрокаОшибки = НСтр("ru = 'Не найден КПС для отражения возврата прошлых лет по забалансовому счету вида ""%3"" с кодом ""%1"" действующий %2'");
		
		СтрокаОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
													СтрокаОшибки,
													Строка(ИскомыйКод),
													Формат(?(ЗначениеЗаполнено(НаДату), НаДату, ТекущаяДатаСеанса()),"ДЛФ=D"),
													Строка(НачальныеЗначения.ВидПоказателя));	
		ДобавитьОшибкуВКонтекстПроведения(СтрокаОшибки, "КПСВозвратаПрошлыхЛет");
		
	КонецЕсли;
	
	Возврат КПСПоКоду;

КонецФункции	

// Функция ищет элемент справочника КПС соответствующий реквизитам статьи
// плана поступлений и выбытий.
//
// Параметры:
//  СтатьяПлана  - СправочникСсылка.СтатьиПланаПоступленийВыбытий.
//  СоздаватьКПС - Булево, признак необходимости создания нового КПС при неудачном
//                 поиске.
//
// Возврващаемое значение:
//  Справочникссылка.КлассификационныеПризнакиСчетов, если элемент не найден и не
//  создан - ПустаяСсылка.
//
Функция КПСПоСтатьеПланаПоступленийВыбытий(СтатьяПлана, СоздаватьКПС = Истина, ГодПлана = 0) Экспорт
	
	Перем ВидБК, УточнениеБК;
	
	СтруктураБК = Новый Структура(ПлановыеПоказателиДеятельности.ОпределитьКомпонентыБКСтатьиПлана(СтатьяПлана, ВидБК,, УточнениеБК)); 
	
	Если ЗначениеЗаполнено(ГодПлана) Тогда
		СтруктураБК.ДатаНачалаДействия = Макс(СтруктураБК.ДатаНачалаДействия, Дата(ГодПлана, 1, 1));
		СтруктураБК.ДатаОкончанияДействия = Мин(СтруктураБК.ДатаОкончанияДействия, Дата(ГодПлана, 12, 31));
	КонецЕсли;	
	
	КПСПоСтатьеПланаПоступленийВыбытий = Справочники.КлассификационныеПризнакиСчетов
													.НайтиСоздатьКПСПоСтруктуреБК(Новый ФиксированнаяСтруктура(СтруктураБК), ВидБК, СоздаватьКПС, УточнениеБК);
													
	Если Не ЗначениеЗаполнено(КПСПоСтатьеПланаПоступленийВыбытий) Тогда
		
		СтрокаОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
													НСтр("ru = 'Не удалось определить КПС по статье ""%1""'"),
													Строка(СтатьяПлана));
		ДобавитьОшибкуВКонтекстПроведения(СтрокаОшибки, "КПСПоСтатьеПланаПоступленийВыбытий");
		
	КонецЕсли;
	
	Возврат КПСПоСтатьеПланаПоступленийВыбытий;
	
			
КонецФункции	

// Функция вызывает одноименную функцию подсистемы ПрефиксацияОбъектов
// Получает номер документа для вывода на печать; из номера удаляются префиксы и лидирующие нули
// Функция:
// отбрасывает префикс организации,
// отбрасывает префикс информационной базы (опционально),
// отбрасывает пользовательские префиксы (опционально),
// удаляет лидирующие нули в номере объекта
//
// Параметры
//  НомерОбъекта  - Строка
//  УдалитьПрефиксИнформационнойБазы  - Булево
//  УдалитьПользовательскийПрефикс  - Булево
//
// Возвращаемое значение:
//   Строка
//
Функция ПолучитьНомерНаПечать(Знач НомерОбъекта, УдалитьПрефиксИнформационнойБазы = Ложь, УдалитьПользовательскийПрефикс = Ложь) Экспорт

	Возврат ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(НомерОбъекта, УдалитьПрефиксИнформационнойБазы, УдалитьПользовательскийПрефикс);  		

КонецФункции // ПолучитьНомерНаПечать()

Функция ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка,Знач Номер) Экспорт
	
	Возврат БухгалтерскиеОперацииПовтИсп.ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка, Номер);
	
КонецФункции

// Возвращает сумму изменения по отношению предыдущей версии документа от текущего для указанной аналитики
//
// Параметры
//  Обязательство - СправочникСсылка.Договоры - ссылка на обязательство
//  Документ - ДокументСсылка.РегистрацияОбязательствИСведенийПоДоговорам - текущий документ
//  КФО - ПеречислениеСсылка.КВД - КФО проверяемой строки
//  КПС - СправочникСсылка.КлассификационныеПризнакиСчетов - КПС проверяемой строки
//  КЭК - СправочникСсылка.КОСГУ - КЭК проверяемой строки
//  Номенклатура - СправочникСсылка.Номенклатура, СправочникСсылка.ОсновныеСредства - предмет проверяемой строки
//  ОКП - Строка(7) - ОКП проверяемой строки
//  ЕдиницаИзмерения - СправочникСсылка.КлассификаторЕдиницИзмерения - единица измерения проверяемой строки
//  ПериодПлана - СправочникСсылка.Периоды - период проверяемой строки
//  РазделЛицевогоСчета - СправочникСсылка.РазделыЛицевыхСчетов - раздел лицевого счета проверяемой строки
//  КодЦели - СправочникСсылка.ВидыЦелевыхСредств - код цели проверяемой строки
//  КодМероприятия - СправочникСсылка.Мероприятия - код мероприятия проверяемой строки
//  ДопКлассификация - СправочникСсылка.ДополнительнаяБюджетнаяКлассификация - доп. классификация проверяемой строки
//  Сумма - Число - сумма проверямой строки из текущего документа
//
// Возвращаемое значение:
//   Число - сумма изменения относительно предыдущей версии документа
//
Функция ПолучитьСуммуИзмененияПоОбязательству(Обязательство, Документ, КФО, КПС, КЭК, Номенклатура, ОКП ,ЕдиницаИзмерения, ПериодПлана, РазделЛицевогоСчета, КодЦели, КодМероприятия, ДопКлассификация, Сумма, Безусловная = 0) Экспорт 
	
