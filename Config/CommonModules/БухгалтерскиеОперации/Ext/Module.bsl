Функция ЭтоСчетГруппа(Знач КодСчета, Знач НаДату = Неопределено) Экспорт
	
	// Проверить заполнение входных параметров
	ОбязательныеПараметры = Новый Структура("КодСчета", КодСчета);
	Если Не ПроверитьОбязательныеПараметрыФункции(ОбязательныеПараметры, "ЭтоСчетГруппа") Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ТипЗнч(КодСчета) = Тип("Строка") Тогда
		Если НаДату = Неопределено Тогда
			КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
			НаДату = КонтекстПроведения.ДокументОбъект.Дата;
		КонецЕсли;
		Счет = БухгалтерскийУчет.СчетПоКоду(КодСчета, НаДату);
		
		Если Не ЗначениеЗаполнено(Счет) Тогда
			СтрокаОшибки = СтрШаблон(НСтр("ru = 'Не найден счет с кодом ""%1"", актуальный на %2'"),
				Строка(КодСчета), Формат(НаДату, "ДЛФ=D"));
			ДобавитьОшибкуВКонтекстПроведения(СтрокаОшибки, "ЭтоСчетГруппа");
			Возврат Ложь;
		КонецЕсли;
	ИначеЕсли ТипЗнч(КодСчета) = Тип("ПланСчетовСсылка.ЕПСБУ") Тогда
		Счет = КодСчета;
	Иначе
		ДобавитьОшибкуНеПравильныйТипПараметра("КодСчета", КодСчета, "ЭтоСчетГруппа");
		Возврат Ложь;
	КонецЕсли;
	
	Возврат БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Счет).ЭлементГруппа;

КонецФункции // ЭтоСчетГруппа()

