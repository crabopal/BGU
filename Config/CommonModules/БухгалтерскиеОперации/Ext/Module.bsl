Функция МожноПровестиВыбытиеФинансовыхВложений(ДокументСсылка) Экспорт
	
	ТаблицаЦенныхБумаг = ТаблицаОстатковЦенныхБумаг(ДокументСсылка);
	
	Возврат ТаблицаЦенныхБумаг.Итог("Нехватка") = 0;
	
КонецФункции

Функция ТаблицаОстатковЦенныхБумаг(ДокументСсылка)
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "МоментВремени, Организация");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("Период", Новый Граница(РеквизитыДокумента.МоментВремени, ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Организация", РеквизитыДокумента.Организация);
	Запрос.УстановитьПараметр("СчетаЦенныхБумаг", БухгалтерскийУчет.СписокСчетов("204.20, 204.31"));
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВыбытиеФинансовыхВложений.ОбъектФинансовыхВложений КАК ЦеннаяБумага,
	|	ВыбытиеФинансовыхВложений.Количество КАК Количество
	|ПОМЕСТИТЬ ТаблицаДокумента
	|ИЗ
	|	Документ.ВыбытиеФинансовыхВложений КАК ВыбытиеФинансовыхВложений
	|ГДЕ
	|	ВыбытиеФинансовыхВложений.Ссылка = &Ссылка
	|	И ВыбытиеФинансовыхВложений.СчетУчета В(&СчетаЦенныхБумаг)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаДокумента.ЦеннаяБумага КАК ЦеннаяБумага,
	|	ТаблицаДокумента.Количество КАК Количество,
	|	ЦенныеБумагиОстатки.КоличествоОстаток КАК КоличествоОстаток,
	|	ВЫБОР
	|		КОГДА ТаблицаДокумента.Количество > ЕСТЬNULL(ЦенныеБумагиОстатки.КоличествоОстаток, 0)
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Нехватка
	|ИЗ
	|	ТаблицаДокумента КАК ТаблицаДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ЦенныеБумаги.Остатки(
	|				&Период,
	|				Организация = &Организация
	|					И ЦеннаяБумага В
	|						(ВЫБРАТЬ
	|							ТаблицаДокумента.ЦеннаяБумага
	|						ИЗ
	|							ТаблицаДокумента)) КАК ЦенныеБумагиОстатки
	|		ПО ТаблицаДокумента.ЦеннаяБумага = ЦенныеБумагиОстатки.ЦеннаяБумага";
	
	ТаблицаЦенныхБумаг = Запрос.Выполнить().Выгрузить();
	Для Каждого СтрокаЦеннаяБумага Из ТаблицаЦенныхБумаг Цикл
		
		Если СтрокаЦеннаяБумага.Нехватка = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Указанное количество вложений ""%1"" превышает доступный остаток.
				|В документе: %2; Остаток: %3'"),
			СтрокаЦеннаяБумага.ЦеннаяБумага,
			СтрокаЦеннаяБумага.Количество,
			СтрокаЦеннаяБумага.КоличествоОстаток);
			
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		
	КонецЦикла;
	
	Возврат ТаблицаЦенныхБумаг;
	
КонецФункции

