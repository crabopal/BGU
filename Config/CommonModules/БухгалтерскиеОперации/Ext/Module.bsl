		ДобавитьОшибкуВКонтекстПроведения(СтрокаОшибки, "СчетПоставщикаТМЦ");
		Возврат ПланыСчетов.ЕПСБУ.ПустаяСсылка();
		
	Иначе
		
		Возврат СчетПоставщикаТМЦ;
		
	КонецЕсли;

