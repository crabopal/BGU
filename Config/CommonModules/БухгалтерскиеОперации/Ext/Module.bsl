			ТекстПериода = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = ' на %1'"), Формат(Период, "ДФ=""дд ММММ гггг 'г.' ЧЧ:мм:сс"""));
		ИначеЕсли Документы.ТипВсеСсылки().СодержитТип(ТипПериода) Тогда
			ТекстПериода = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = ' на %1'"), Формат(Период.Дата, "ДФ=""дд ММММ гггг 'г.' ЧЧ:мм:сс"""));
		КонецЕсли;
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Невозможно определить счет учета вложений для внеоборотного актива ""%1""%2.'"),
