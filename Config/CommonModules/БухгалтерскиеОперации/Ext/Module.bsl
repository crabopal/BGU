Функция ОпределитьСчетПоВидуИмущества(ВидИмущества,КодИсходногоСчета) Экспорт
	Результат = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	Если ЗначениеЗаполнено(ВидИмущества) Тогда
		ИндексВидаИмущества = Перечисления.ВидыИмущества.Индекс(ВидИмущества)+1;
		НовыйКод = Лев(КодИсходногоСчета,3)+ИндексВидаИмущества+Сред(КодИсходногоСчета,5);
		Результат = БухгалтерскиеОперации.СчетПоКоду(НовыйКод);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ОпределитьСчетПоВидуИмущества_Общий(ВидИмущества,КодИсходногоСчета) Экспорт
	Результат = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	Если ЗначениеЗаполнено(ВидИмущества) Тогда
		ИндексВидаИмущества = Перечисления.ВидыИмущества.Индекс(ВидИмущества)+1;
		Если (Лев(КодИсходногоСчета,3)= "101") 
			ИЛИ (Лев(КодИсходногоСчета,3)= "102") 
			ИЛИ (Лев(КодИсходногоСчета,3)= "105") 
			ИЛИ (Лев(КодИсходногоСчета,3)= "106") 
			ИЛИ (Лев(КодИсходногоСчета,3)= "113") Тогда
			НовыйКод = Лев(КодИсходногоСчета,4)+ИндексВидаИмущества+Сред(КодИсходногоСчета,6);
		ИначеЕсли Лев(КодИсходногоСчета,3)= "108" Тогда
			Если Сред(КодИсходногоСчета,6,2) = "01" Тогда
				НовыйКод = "108.51";
			ИначеЕсли Сред(КодИсходногоСчета,6,2) = "02" Тогда
				НовыйКод = "108.52";
			ИначеЕсли Сред(КодИсходногоСчета,6,2) = "03" Тогда
				НовыйКод = "108.54";
			ИначеЕсли Сред(КодИсходногоСчета,6,2) = "04" Тогда
				НовыйКод = "108.55";
			КонецЕсли;
		КонецЕсли;
		Результат = БухгалтерскиеОперации.СчетПоКоду(НовыйКод);
	КонецЕсли;
	Возврат Результат;
КонецФункции

