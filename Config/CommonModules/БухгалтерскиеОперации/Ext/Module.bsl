	|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиПоРБ КАК ОбъединеннаяТаблицаОстДвиж
	|		ПО ДанныеДок.СтарыйКПС = ОбъединеннаяТаблицаОстДвиж.КПС
	|			И (ДанныеДок.КЭК = ЕСТЬNULL(ОбъединеннаяТаблицаОстДвиж.КЭК, ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)))
	|			И ДанныеДок.Подразделение = ОбъединеннаяТаблицаОстДвиж.Подразделение
	|			И ДанныеДок.Валюта = ОбъединеннаяТаблицаОстДвиж.Валюта
	|			И ДанныеДок.Субконто1 = ОбъединеннаяТаблицаОстДвиж.Субконто1
	|			И ДанныеДок.Субконто2 = ОбъединеннаяТаблицаОстДвиж.Субконто2
	|			И ДанныеДок.Субконто3 = ОбъединеннаяТаблицаОстДвиж.Субконто3
	|			И ДанныеДок.Счет = ОбъединеннаяТаблицаОстДвиж.Счет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СоединенныеТаблицы.Счет КАК Счет,
	|	СоединенныеТаблицы.НомерСтроки КАК НомерСтроки,
	|	СоединенныеТаблицы.СтарыйКПС КАК СтарыйКПС,
	|	СоединенныеТаблицы.Количество КАК Количество,
	|	СоединенныеТаблицы.Сумма КАК Сумма,
	|	СоединенныеТаблицы.ВалютнаяСумма КАК ВалютнаяСумма
	|ИЗ
	|	СоединенныеТаблицы КАК СоединенныеТаблицы
	|ГДЕ
	|	(СоединенныеТаблицы.Сумма > 0
	|			ИЛИ СоединенныеТаблицы.Количество > 0
	|			ИЛИ СоединенныеТаблицы.ВалютнаяСумма > 0)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	ГраницаОстатков = БухгалтерскийУчет.КонецПериодаСУточнением(ДанныеДокумента.Дата, ДанныеДокумента.ВидМежотчетногоПериода);
	
	Запрос.УстановитьПараметр("ДатаОстатков"			, ГраницаОстатков);
	Запрос.УстановитьПараметр("Ссылка"					, ДокументСсылка);
	Запрос.УстановитьПараметр("Организация"				, ДанныеДокумента.Организация);
	Запрос.УстановитьПараметр("КФО"						, ДанныеДокумента.КФО);
	Запрос.УстановитьПараметр("ИФО"						, ДанныеДокумента.ИФО);
	Запрос.УстановитьПараметр("ОтборПоИФО"				, ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Запрос.УстановитьПараметр("ОтборПоПодразделению"	, ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") И ДанныеДокумента.ОтборПоПодразделению);
	Запрос.УстановитьПараметр("Подразделение"			, ДанныеДокумента.Подразделение);
	
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	НомСообщения = 0;
	
	Пока Выборка.Следующий() Цикл
		
		СписокНедостач = Новый Массив;
		Если Выборка.Сумма > 0 Тогда
			СписокНедостач.Добавить("суммы " + Выборка.Сумма);
		КонецЕсли;
		Если Выборка.Количество > 0 Тогда
			СписокНедостач.Добавить("количества " + Выборка.Количество);
		КонецЕсли;
		Если Выборка.ВалютнаяСумма > 0 Тогда
			СписокНедостач.Добавить("вал. суммы " + Выборка.ВалютнаяСумма);
		КонецЕсли;
		ТекстНедостачи = СтрСоединить(СписокНедостач, ", ");
		Шаблон = НСтр("ru='По счету %1 для строки %2 не хватает %3'");
		ТекстСообщения = СтрШаблон(Шаблон, Выборка.Счет, Выборка.НомерСтроки, ТекстНедостачи);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);
		
		НомСообщения = НомСообщения + 1;
		Если НомСообщения > 10 Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Не Отказ;
	
КонецФункции

Функция УстановитьБлокировкуПоДокументуПереносКПС(ДокументСсылка) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Отказ = Ложь;
	Блокировка = Новый БлокировкаДанных;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Переводы.СтарыйКПС,
	|	Переводы.Ссылка.КФО КАК КФО,
	|	Переводы.Счет КАК Счет,
	|	Переводы.Ссылка.Организация КАК Организация
	|ИЗ
	|	Документ.ПереносОстатковПоКПС.Переводы КАК Переводы
	|ГДЕ
	|	Переводы.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка",	ДокументСсылка);
	РезультатЗапроса = Запрос.Выполнить();
		
	ЭлементБлокировки = Блокировка.Добавить("РегистрБухгалтерии.ЖурналПроводокЕПСБУ");
	ЭлементБлокировки.ИсточникДанных = РезультатЗапроса;
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Счет",        "Счет");
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("КФО",         "КФО");
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("КПС",         "СтарыйКПС");
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Организация", "Организация");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;

	Попытка
		Блокировка.Заблокировать();
	Исключение
		Отказ = Истина;
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки());
	КонецПопытки;
		
	Возврат Не Отказ;
КонецФункции

