		               |						ОсДокумента.ОсновноеСредство
		               |					ИЗ
		               |						ОсДокумента КАК ОсДокумента)) КАК ЖурналПроводокЕПСБУОстатки
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	ЖурналПроводокЕПСБУОстатки.Счет,
		               |	ЖурналПроводокЕПСБУОстатки.Субконто1
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ОсДокументаСоСчетами.ОсновноеСредство,
		               |	ПРЕДСТАВЛЕНИЕ(ОсДокументаСоСчетами.ОсновноеСредство) КАК ПредставлениеОС,
		               |	ОсДокументаСоСчетами.Количество,
		               |	ОсДокументаСоСчетами.Сумма,
		               |	ОсДокументаСоСчетами.СуммаАмортизации,
		               |	ЕСТЬNULL(БалансоваяСтоимость.КоличествоОстатокДт, 0) КАК КоличествоОстаток,
		               |	ЕСТЬNULL(БалансоваяСтоимость.СуммаОстатокДт, 0) КАК СуммаОстаток,
		               |	ЕСТЬNULL(Амортизация.СуммаОстатокКт, 0) КАК АмортизацияОстаток,
		               |	ВЫБОР
		               |		КОГДА &ВестиАналитическийИИнвентарныйУчет
		               |			ТОГДА ВЫБОР
		               |					КОГДА ОсДокументаСоСчетами.Количество > ЕСТЬNULL(БалансоваяСтоимость.КоличествоОстатокДт, 0)
		               |						ТОГДА ИСТИНА
		               |					ИНАЧЕ ЛОЖЬ
		               |				КОНЕЦ
		               |		ИНАЧЕ ЛОЖЬ
		               |	КОНЕЦ КАК НехваткаКоличества,
		               |	ВЫБОР
		               |		КОГДА ОсДокументаСоСчетами.Сумма > ЕСТЬNULL(БалансоваяСтоимость.СуммаОстатокДт, 0)
		               |			ТОГДА ИСТИНА
		               |		ИНАЧЕ ЛОЖЬ
		               |	КОНЕЦ КАК НехваткаСуммы,
		               |	ОсДокументаСоСчетами.СчетУчета,
		               |	ОсДокументаСоСчетами.СчетАмортизации,
		               |	ПРЕДСТАВЛЕНИЕ(ОсДокументаСоСчетами.СчетУчета) КАК СчетУчетаПредставление,
		               |	ПРЕДСТАВЛЕНИЕ(ОсДокументаСоСчетами.СчетАмортизации) КАК СчетАмортизацииПредставление,
		               |	ВЫБОР
		               |		КОГДА ОсДокументаСоСчетами.СуммаАмортизации > ЕСТЬNULL(Амортизация.СуммаОстатокКт, 0)
		               |			ТОГДА ИСТИНА
		               |		ИНАЧЕ ЛОЖЬ
		               |	КОНЕЦ КАК НехваткаАмортизации
		               |ИЗ
		               |	ОсДокументаСоСчетами КАК ОсДокументаСоСчетами
		               |		ЛЕВОЕ СОЕДИНЕНИЕ Остатки КАК БалансоваяСтоимость
		               |		ПО ОсДокументаСоСчетами.ОсновноеСредство = БалансоваяСтоимость.Субконто1
		               |			И ОсДокументаСоСчетами.СчетУчета = БалансоваяСтоимость.Счет
		               |		ЛЕВОЕ СОЕДИНЕНИЕ Остатки КАК Амортизация
		               |		ПО ОсДокументаСоСчетами.ОсновноеСредство = Амортизация.Субконто1
		               |			И ОсДокументаСоСчетами.СчетАмортизации = Амортизация.Счет" ;
					   
		РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Дата,Организация,КФО,КПС,ИФО,Подразделение");				   
		Запрос.УстановитьПараметр("КПС", РеквизитыДокумента.КПС);
	Иначе	
		Запрос.Текст = "ВЫБРАТЬ
		               |	ВЫРАЗИТЬ(ОСДокумента.ОсновноеСредство КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
		               |	ОСДокумента.КПС,
		               |	ОСДокумента.СчетУчета,
		               |	ОСДокумента.Количество,
		               |	ОСДокумента.Сумма,
		               |	ОСДокумента.СуммаАмортизации
		               |ПОМЕСТИТЬ ОСДокумента
		               |ИЗ
		               |	&ОСДокумента КАК ОСДокумента
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	ОСДокумента.ОсновноеСредство,
		               |	ОСДокумента.Количество,
		               |	ОСДокумента.Сумма,
		               |	ОСДокумента.СуммаАмортизации,
		               |	ОСДокумента.СчетУчета КАК СчетУчета,
		               |	СоответствиеСчетовОС.СчетАмортизации,
		               |	ОСДокумента.КПС
		               |ПОМЕСТИТЬ ОсДокументаСоСчетами
		               |ИЗ
		               |	ОСДокумента КАК ОСДокумента
		               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеСчетовОС КАК СоответствиеСчетовОС
		               |		ПО ОСДокумента.СчетУчета = СоответствиеСчетовОС.СчетОС
		               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних(&Период, ) КАК УчетныеДанныеОбъектаОССрезПоследних
		               |		ПО ОСДокумента.ОсновноеСредство = УчетныеДанныеОбъектаОССрезПоследних.ОсновноеСредство
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ЖурналПроводокЕПСБУОстатки.Счет,
		               |	ЖурналПроводокЕПСБУОстатки.Субконто1,
		               |	СУММА(ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт) КАК СуммаОстатокДт,
		               |	СУММА(ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт) КАК КоличествоОстатокДт,
		               |	СУММА(ЖурналПроводокЕПСБУОстатки.СуммаОстатокКт) КАК СуммаОстатокКт
		               |ПОМЕСТИТЬ Остатки
		               |ИЗ
		               |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		               |			&Период,
		               |			Счет В
		               |				(ВЫБРАТЬ
		               |					Т1.СчетУчета
		               |				ИЗ
		               |					ОсДокументаСоСчетами КАК Т1
		               |			
		               |				ОБЪЕДИНИТЬ ВСЕ
		               |			
		               |				ВЫБРАТЬ
		               |					Т2.СчетАмортизации
		               |				ИЗ
		               |					ОсДокументаСоСчетами КАК Т2),
		               |			,
		               |			Организация = &Организация
		               |				И КФО = &КФО
		               |				И &УсловиеИФО
		               |				И &УсловиеПодразделение
		               |				И Субконто1 В
		               |					(ВЫБРАТЬ
		               |						ОсДокумента.ОсновноеСредство
		               |					ИЗ
		               |						ОсДокумента КАК ОсДокумента)) КАК ЖурналПроводокЕПСБУОстатки
		               |
		               |СГРУППИРОВАТЬ ПО
		               |	ЖурналПроводокЕПСБУОстатки.Счет,
		               |	ЖурналПроводокЕПСБУОстатки.Субконто1
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ОсДокументаСоСчетами.ОсновноеСредство,
		               |	ПРЕДСТАВЛЕНИЕ(ОсДокументаСоСчетами.ОсновноеСредство) КАК ПредставлениеОС,
		               |	ОсДокументаСоСчетами.Количество,
		               |	ОсДокументаСоСчетами.Сумма,
		               |	ОсДокументаСоСчетами.СуммаАмортизации,
		               |	ЕСТЬNULL(БалансоваяСтоимость.КоличествоОстатокДт, 0) КАК КоличествоОстаток,
		               |	ЕСТЬNULL(БалансоваяСтоимость.СуммаОстатокДт, 0) КАК СуммаОстаток,
		               |	ЕСТЬNULL(Амортизация.СуммаОстатокКт, 0) КАК АмортизацияОстаток,
		               |	ВЫБОР
		               |		КОГДА &ВестиАналитическийИИнвентарныйУчет
		               |			ТОГДА ВЫБОР
		               |					КОГДА ОсДокументаСоСчетами.Количество > ЕСТЬNULL(БалансоваяСтоимость.КоличествоОстатокДт, 0)
		               |						ТОГДА ИСТИНА
		               |					ИНАЧЕ ЛОЖЬ
		               |				КОНЕЦ
		               |		ИНАЧЕ ЛОЖЬ
		               |	КОНЕЦ КАК НехваткаКоличества,
		               |	ВЫБОР
		               |		КОГДА ОсДокументаСоСчетами.Сумма > ЕСТЬNULL(БалансоваяСтоимость.СуммаОстатокДт, 0)
		               |			ТОГДА ИСТИНА
		               |		ИНАЧЕ ЛОЖЬ
		               |	КОНЕЦ КАК НехваткаСуммы,
		               |	ОсДокументаСоСчетами.СчетУчета,
		               |	ОсДокументаСоСчетами.СчетАмортизации,
		               |	ПРЕДСТАВЛЕНИЕ(ОсДокументаСоСчетами.СчетУчета) КАК СчетУчетаПредставление,
		               |	ПРЕДСТАВЛЕНИЕ(ОсДокументаСоСчетами.СчетАмортизации) КАК СчетАмортизацииПредставление,
		               |	ВЫБОР
		               |		КОГДА ОсДокументаСоСчетами.СуммаАмортизации > ЕСТЬNULL(Амортизация.СуммаОстатокКт, 0)
		               |			ТОГДА ИСТИНА
		               |		ИНАЧЕ ЛОЖЬ
		               |	КОНЕЦ КАК НехваткаАмортизации,
		               |	ОсДокументаСоСчетами.КПС
		               |ИЗ
		               |	ОсДокументаСоСчетами КАК ОсДокументаСоСчетами
		               |		ЛЕВОЕ СОЕДИНЕНИЕ Остатки КАК БалансоваяСтоимость
		               |		ПО ОсДокументаСоСчетами.ОсновноеСредство = БалансоваяСтоимость.Субконто1
		               |			И ОсДокументаСоСчетами.СчетУчета = БалансоваяСтоимость.Счет
		               |		ЛЕВОЕ СОЕДИНЕНИЕ Остатки КАК Амортизация
		               |		ПО ОсДокументаСоСчетами.ОсновноеСредство = Амортизация.Субконто1
		               |			И ОсДокументаСоСчетами.СчетАмортизации = Амортизация.Счет" ;
		
		
		
		РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Дата,Организация,КФО,ИФО,Подразделение");				   
	КонецЕсли;
	
	УчетнаяПолитика = БухгалтерскийУчетПовтИсп.УчетнаяПолитикаОрганизации(РеквизитыДокумента.Организация, 
		БухгалтерскийУчет.ДатаУстановкиУчетнойПолитики(РеквизитыДокумента.Организация, РеквизитыДокумента.Дата));

	ДатаСписания = БухгалтерскийУчет.УстановленнаяДатаПроведения(ДокументСсылка);
	ДатаСписания = ?(ЗначениеЗаполнено(ДатаСписания), ДатаСписания, РеквизитыДокумента.Дата);

	Запрос.УстановитьПараметр("Период",								ДатаСписания);				   
	Запрос.УстановитьПараметр("ОСДокумента",						ОСДокумента);
	Запрос.УстановитьПараметр("Организация",						РеквизитыДокумента.Организация);
	Запрос.УстановитьПараметр("КФО",								РеквизитыДокумента.КФО);
	Запрос.УстановитьПараметр("ВестиАналитическийИИнвентарныйУчет",	УчетнаяПолитика.ВедениеАналитическогоУчетаИмуществаКазны = Истина);
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИФО = &ИФО");																									
		Запрос.УстановитьПараметр("ИФО",							РеквизитыДокумента.ИФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИСТИНА");	
	КонецЕсли;
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
		И БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("108.00").УчетПоПодразделениям Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПодразделение", "Подразделение = &Подразделение");
		Запрос.УстановитьПараметр("Подразделение",					РеквизитыДокумента.Подразделение);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПодразделение", "ИСТИНА");
	КонецЕсли;
	
	Результат = Истина;
	Выборка = Запрос.Выполнить().Выбрать();
	Ошибка = НСтр("ru='На счете [КПС].[КФО].[Счет] по объекту [Объект] [Показатель] ([ЗначениеПоказателя]) меньше требуемого в документе [Требуется]'");
	
	Если НЕ КПСиСчетУчетавТЧ Тогда
		ПараметрыОшибки = Новый Структура("КПС,КФО,Счет,Объект,Показатель,ЗначениеПоказателя,Требуется", РеквизитыДокумента.КПС,РеквизитыДокумента.КФО);
	Иначе
		ПараметрыОшибки = Новый Структура("КФО,Счет,Объект,Показатель,ЗначениеПоказателя,Требуется, КПС", РеквизитыДокумента.КФО);
	КонецЕсли;	
	Пока Выборка.Следующий() Цикл
		Если Выборка.НехваткаКоличества ИЛИ Выборка.НехваткаСуммы ИЛИ Выборка.НехваткаАмортизации Тогда
			Результат = Ложь;
			Если КПСиСчетУчетавТЧ Тогда
				ЗаполнитьЗначенияСвойств(ПараметрыОшибки, Выборка, "КПС");
			КонецЕсли;
			Если Выборка.НехваткаКоличества Тогда
				ПараметрыОшибки.Счет 				= Выборка.СчетУчетаПредставление;
				ПараметрыОшибки.Объект	 			= Выборка.ПредставлениеОС;
				ПараметрыОшибки.Показатель 			= НСтр("ru='количество'");
				ПараметрыОшибки.ЗначениеПоказателя	= Выборка.КоличествоОстаток;
				ПараметрыОшибки.Требуется 			= Выборка.Количество;
				ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(Ошибка, ПараметрыОшибки));
			КонецЕсли;
			Если Выборка.НехваткаСуммы Тогда
				ПараметрыОшибки.Счет 				= Выборка.СчетУчетаПредставление;
				ПараметрыОшибки.Объект	 			= Выборка.ПредставлениеОС;
				ПараметрыОшибки.Показатель 			= НСтр("ru='сумма'");
				ПараметрыОшибки.ЗначениеПоказателя	= Формат(Выборка.СуммаОстаток, "ЧДЦ=2; ЧН=0");
				ПараметрыОшибки.Требуется 			= Формат(Выборка.Сумма, "ЧДЦ=2");
				ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(Ошибка, ПараметрыОшибки));
			КонецЕсли;
			Если Выборка.НехваткаАмортизации Тогда
				ПараметрыОшибки.Счет 				= Выборка.СчетУчетаПредставление;
				ПараметрыОшибки.Объект	 			= Выборка.ПредставлениеОС;
				ПараметрыОшибки.Показатель 			= НСтр("ru='сумма амортизации'");
				ПараметрыОшибки.ЗначениеПоказателя	= Формат(Выборка.АмортизацияОстаток, "ЧДЦ=2; ЧН=0");
				ПараметрыОшибки.Требуется 			= Формат(Выборка.СуммаАмортизации, "ЧДЦ=2");
				ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(Ошибка, ПараметрыОшибки));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция МожноПровестиВозвратИК(ДокументСсылка, Знач КФО=Неопределено) Экспорт
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПринятиеКУчетуОбъектаИК")
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПринятиеКУчетуЗданияИК") Тогда
		ТаблицаОС = Новый ТаблицаЗначений;
		ТаблицаОС.Колонки.Добавить("ОсновноеСредство", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
		ТаблицаОС.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
		ТаблицаОС.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
		
		РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Дата, Организация, Подразделение, ИФО"
																+", Контрагент, ВидПоступления, ОсновноеСредство,ПервоначальнаяСтоимость");
		СтрОС = ТаблицаОС.Добавить();
		СтрОС.ОсновноеСредство	= РеквизитыДокумента.ОсновноеСредство;
		СтрОС.Количество 		= 1;
		СтрОС.Сумма 			= РеквизитыДокумента.ПервоначальнаяСтоимость;
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовИК") Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	ПринятиеКУчетуОбъектовИКОсновныеСредства.ОсновноеСредство,
		                      |	ПринятиеКУчетуОбъектовИКОсновныеСредства.Количество,
		                      |	ПринятиеКУчетуОбъектовИКОсновныеСредства.Сумма
		                      |ИЗ
		                      |	Документ.ПринятиеКУчетуОбъектовИК.ОсновныеСредства КАК ПринятиеКУчетуОбъектовИКОсновныеСредства
		                      |ГДЕ
		                      |	ПринятиеКУчетуОбъектовИКОсновныеСредства.Ссылка = &Ссылка");
		Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
		ТаблицаОС = Запрос.Выполнить().Выгрузить();
		РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Дата, Организация, Подразделение, ИФО, Контрагент, ВидПоступления");
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПринятиеКУчетуИК") Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	ПринятиеКУчетуИКОсновныеСредства.ОсновноеСредство,
		                      |	ПринятиеКУчетуИКОсновныеСредства.Количество,
		                      |	ПринятиеКУчетуИКОсновныеСредства.Сумма
		                      |ИЗ
		                      |	Документ.ПринятиеКУчетуИК.ОсновныеСредства КАК ПринятиеКУчетуИКОсновныеСредства
		                      |ГДЕ
		                      |	ПринятиеКУчетуИКОсновныеСредства.Ссылка = &Ссылка");
		Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
		ТаблицаОС = Запрос.Выполнить().Выгрузить();
		РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Дата, Организация, Подразделение, ИФО, Контрагент, ВидПоступления");
	Иначе
		ВызватьИсключение НСтр("ru='Функция МожноПровестиВозвратИК не предназначена для данного вида документа'");
	КонецЕсли;
	
	
	
	Если КФО = Неопределено Тогда
		КФО = Перечисления.КВД.Бюджет;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Выразить(ОсДокумента.ОсновноеСредство Как Справочник.ОсновныеСредства) Как ОсновноеСредство,
	               |	ОсДокумента.Сумма,
	               |	ОсДокумента.Количество
	               |ПОМЕСТИТЬ ОсДокумента
	               |ИЗ
	               |	&ОсДокумента КАК ОсДокумента
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВложенныйЗапрос.ОсновноеСредство,
	               |	ВложенныйЗапрос.Сумма,
	               |	ВложенныйЗапрос.Количество,
	               |	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт,
	               |	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт,
	               |	ВЫБОР
	               |		КОГДА ВложенныйЗапрос.Сумма > ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт, 0)
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК НехваткаСумма,
	               |	ВЫБОР
	               |		КОГДА &ВестиИнвентарныйУчет
	               |			ТОГДА ВЫБОР
	               |					КОГДА ВложенныйЗапрос.Количество > ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт, 0)
	               |						ТОГДА ИСТИНА
	               |					ИНАЧЕ ЛОЖЬ
	               |				КОНЕЦ
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК НехваткаКоличество,
	               |	Представление(ВложенныйЗапрос.ОсновноеСредство) Как ОсновноеСредствоПредставление
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ОсДокумента.ОсновноеСредство КАК ОсновноеСредство,
	               |		СУММА(ОсДокумента.Сумма) КАК Сумма,
	               |		СУММА(ОсДокумента.Количество) КАК Количество
	               |	ИЗ
	               |		ОсДокумента КАК ОсДокумента
	               |	
	               |	СГРУППИРОВАТЬ ПО
	               |		ОсДокумента.ОсновноеСредство) КАК ВложенныйЗапрос
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	               |				&Период,
	               |				Счет В (&Счет),
	               |				,
	               |				Организация = &Организация
	               |					//И Подразделение = &Подразделение
	               |					//И ИФО = &ИФО
	               |					И КФО = &КФО
	               |					И (ВЫРАЗИТЬ(Субконто1 КАК Справочник.Контрагенты)) = &Контрагент
	               |					И Субконто2 В (Выбрать ОсДокумента.ОсновноеСредство Из ОсДокумента)) КАК ЖурналПроводокЕПСБУОстатки
	               |		ПО ВложенныйЗапрос.ОсновноеСредство = ЖурналПроводокЕПСБУОстатки.Субконто2
	               |ГДЕ
	               |	(ВЫБОР
	               |				КОГДА ВложенныйЗапрос.Сумма > ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт, 0)
	               |					ТОГДА ИСТИНА
	               |				ИНАЧЕ ЛОЖЬ
	               |			КОНЕЦ
	               |			ИЛИ ВЫБОР
	               |				КОГДА &ВестиИнвентарныйУчет
	               |					ТОГДА ВЫБОР
	               |							КОГДА ВложенныйЗапрос.Количество > ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт, 0)
	               |								ТОГДА ИСТИНА
	               |							ИНАЧЕ ЛОЖЬ
	               |						КОНЕЦ
	               |				ИНАЧЕ ЛОЖЬ
	               |			КОНЕЦ)";
	Запрос.УстановитьПараметр("ОсДокумента", ТаблицаОС);
	Запрос.УстановитьПараметр("Период", РеквизитыДокумента.Дата);
	Запрос.УстановитьПараметр("Организация", РеквизитыДокумента.Организация);
	Запрос.УстановитьПараметр("КФО", КФО);
	Запрос.УстановитьПараметр("Контрагент", РеквизитыДокумента.Контрагент);
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//И ИФО = &ИФО", "И ИФО = &ИФО");
		Запрос.УстановитьПараметр("ИФО", РеквизитыДокумента.ИФО);
	КонецЕсли;
	Если РеквизитыДокумента.ВидПоступления = Перечисления.ВидыОперацийИК.ВозвратАренда Тогда
		КодСчета = "25";
	Иначе	
		КодСчета = "26";		
	КонецЕсли;
	Запрос.УстановитьПараметр("Счет", БухгалтерскийУчет.СписокСчетов(КодСчета, РеквизитыДокумента.Дата,,
		РеквизитыДокумента.Организация));
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
		И БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета(КодСчета).УчетПоПодразделениям Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//И Подразделение = &Подразделение", "И Подразделение = &Подразделение");
		Запрос.УстановитьПараметр("Подразделение", РеквизитыДокумента.Подразделение);
	КонецЕсли;
	Запрос.УстановитьПараметр("ВестиИнвентарныйУчет", БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(РеквизитыДокумента.Организация, РеквизитыДокумента.Дата)
																.ВедениеАналитическогоУчетаИмуществаКазны = Истина);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Истина;
	КонецЕсли;
	ОшибкаСумма = НСтр("ru='По основному средству [ОС] сумма в документе ([СуммаВДокументе]) больше суммы в учете ([СуммаВУчете])'");
	ОшибкаКоличество = НСтр("ru='По основному средству [ОС] количество в документе ([КоличествоВДокументе]) больше количества в учете ([КоличествоВУчете])'");
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.НехваткаСумма Тогда
			ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер
										.ВставитьПараметрыВСтроку(ОшибкаСумма, Новый Структура("ОС, СуммаВДокументе, СуммаВУчете",
																				Выборка.ОсновноеСредствоПредставление, Выборка.Сумма, Выборка.СуммаОстатокДт)));
		КонецЕсли;																				
		Если Выборка.НехваткаКоличество Тогда
			ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер
										.ВставитьПараметрыВСтроку(ОшибкаКоличество, Новый Структура("ОС, КоличествоВДокументе, КоличествоВУчете",
																				Выборка.ОсновноеСредствоПредставление, Выборка.Количество, Выборка.КоличествоОстатокДт)));
		КонецЕсли;																				
	
	КонецЦикла; 
	Возврат Ложь;
	
КонецФункции

Функция МожноПровестиВозвратОбъектовОС(ДокументСсылка) Экспорт
	
	Возврат УправлениеОсновнымиСредствами.МожноПровестиВозвратОбъектовОС(ДокументСсылка);
	
КонецФункции

#КонецОбласти

#Область УчетПравПользования

Функция ПроверитьОстаткиПравПользования(ДокументСсылка, УстанавливатьБлокировку = Ложь) Экспорт
	
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если УстанавливатьБлокировку Тогда
		Отказ = Не УстановитьБлокировкуПоДокументуПраваПользования(ДокументСсылка);
		Если Отказ Тогда
			Возврат Не Отказ;
		КонецЕсли;
	КонецЕсли;
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка,
		"Организация,ИФО,Дата,ПодразделениеОтправитель,ЦМООтправитель");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка"			, ДокументСсылка);
	Запрос.УстановитьПараметр("Период"			, ЗначенияРеквизитов.Дата);
	Запрос.УстановитьПараметр("Организация"		, ЗначенияРеквизитов.Организация);
	Запрос.УстановитьПараметр("ИФО"				, ЗначенияРеквизитов.ИФО);
	Запрос.УстановитьПараметр("Подразделение"	, ЗначенияРеквизитов.ПодразделениеОтправитель);
	Запрос.УстановитьПараметр("ЦМО"				, ЗначенияРеквизитов.ЦМООтправитель);
	Запрос.Текст =
	
	"ВЫБРАТЬ
	|	ОсновныеСредства.НомерСтроки КАК НомерСтроки,
	|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ОсновныеСредства.Договор КАК Договор,
	|	ОсновныеСредства.СчетУчета КАК СчетУчета,
	|	ОсновныеСредства.КФО КАК КФО,
	|	ОсновныеСредства.КПС КАК КПС,
	|	ОсновныеСредства.Сумма КАК Сумма
	|ПОМЕСТИТЬ Таблица
	|ИЗ
	|	Документ.ВнутреннееПеремещениеОбъектовПравПользованияОС.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Субконто1 КАК ОсновноеСредство,
	|	Остатки.Субконто2 КАК Договор,
	|	Остатки.Счет КАК Счет,
	|	Остатки.КФО КАК КФО,
	|	Остатки.КПС КАК КПС,
	|	Остатки.СуммаОстаток КАК СуммаОстаток
	|ПОМЕСТИТЬ Остатки
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В
	|				(ВЫБРАТЬ
	|					Таблица.СчетУчета КАК СчетУчета
	|				ИЗ
	|					Таблица КАК Таблица),
	|			,
	|			Организация = &Организация
	|				И ИФО = &ИФО
	|				И Подразделение = &Подразделение
	|				И Субконто3 = &ЦМО
	|				И (Субконто1, Субконто2) В
	|					(ВЫБРАТЬ
	|						Таблица.ОсновноеСредство КАК ОсновноеСредство,
	|						Таблица.Договор КАК Договор
	|					ИЗ
	|						Таблица КАК Таблица)) КАК Остатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Таблица.НомерСтроки КАК НомерСтроки,
	|	Таблица.ОсновноеСредство.Наименование КАК ОсновноеСредство,
	|	Таблица.Договор.Наименование КАК Договор,
	|	Таблица.Сумма,
	|	Остатки.СуммаОстаток
	|ИЗ
	|	Таблица КАК Таблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ Остатки КАК Остатки
	|		ПО Таблица.ОсновноеСредство = Остатки.ОсновноеСредство
	|			И Таблица.Договор = Остатки.Договор
	|			И Таблица.СчетУчета = Остатки.Счет
	|			И Таблица.КФО = Остатки.КФО
	|			И Таблица.КПС = Остатки.КПС
	|ГДЕ
	|	Таблица.Сумма > ЕСТЬNULL(Остатки.СуммаОстаток, 0)";
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИФО = &ИФО", "ИСТИНА");
	КонецЕсли;
	
	Если Не УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетПравПользованияПоПодразделениям() Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Подразделение = &Подразделение", "ИСТИНА");
	КонецЕсли;
	
	ТаблицаОстатков = Запрос.Выполнить().Выгрузить();
	
	Отказ = Ложь;
	
	Для Каждого ТекСтрока Из ТаблицаОстатков Цикл
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Строка %1: Указанная сумма права пользования ""%2 - %3"" больше, чем остатки в учете'"),
			ТекСтрока.НомерСтроки, ТекСтрока.ОсновноеСредство, ТекСтрока.Договор);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
	КонецЦикла;
	
	Возврат Не Отказ;
	
КонецФункции

// Устанавливает исключительную управляемую блокировку РегистрБухгалтерии.ЖурналПроводокЕПСБУ
// Возвращает результат попытки заблокировать данные.
//
// Параметры:
//  ДокументСсылка	- ДокументСсылка.ВнутреннееПеремещениеОбъектовПравПользованияОС -,
// Возвращаемое значение:
//  Булево - Истина - данные удалось заблокировать, Ложь - если не удалось.
//
Функция УстановитьБлокировкуПоДокументуПраваПользования(ДокументСсылка) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
		
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ТаблицаДокумента.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаДокумента.Договор КАК Договор,
	|	ТаблицаДокумента.СчетУчета КАК СчетУчета
	|ИЗ
	|	Документ.[ИмяДокумента].ОсновныеСредства КАК ТаблицаДокумента
	|ГДЕ
	|	ТаблицаДокумента.Ссылка = &Ссылка";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "[ИмяДокумента]", ДокументСсылка.Метаданные().Имя);	
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Блокировка = Новый БлокировкаДанных;	
	ЭлементБлокировки = Блокировка.Добавить("РегистрБухгалтерии.ЖурналПроводокЕПСБУ");
	ЭлементБлокировки.ИсточникДанных = РезультатЗапроса;
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Счет", "СчетУчета");
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства, "ОсновноеСредство");
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных(ПланыВидовХарактеристик.ВидыСубконто.Договоры, "Договор");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	
	Попытка
		Отказ = Ложь;
		Блокировка.Заблокировать();
	Исключение
		Отказ = Истина;
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки());
	КонецПопытки;
	
	Возврат Не Отказ;
	
КонецФункции

#КонецОбласти

#Область УчетМатериальныхЗапасов

// Возвращает счет обесценения биологических активов по счету учета БА.
// 
// Параметры:
//  СчетУчетаБА - ПланСчетовСсылка.ЕПСБУ
// 
// Возвращаемое значение:
//  ПланСчетовСсылка.ЕПСБУ -  Счет обесценения БА
Функция СчетОбесцененияБА(СчетУчетаБА) Экспорт
	Если Не ЗначениеЗаполнено(СчетУчетаБА) Тогда
		ТекстОшибки = НСтр("ru = 'В функцию БухгалтерскиеОперации.СчетОбесцененияБА не передан счет учета биологического актива'");
		БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстОшибки);
		Возврат ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	КонецЕсли;
	СчетОбесценения = БухгалтерскиеОперацииПовтИсп.СчетОбесцененияБА(СчетУчетаБА);
	Если Не ЗначениеЗаполнено(СчетОбесценения) Тогда
		ТекстОшибки = СтрШаблон(НСтр("ru = 'В функции БухгалтерскиеОперации.СчетОбесцененияБА не удалось определить счет биологического актива по счету %1'"),
			СчетУчетаБА);
		БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстОшибки);
	КонецЕсли;
	Возврат СчетОбесценения;
КонецФункции

// Функция возвращает ссылку на счет учета, установленный в карточке номенклатуры
//
Функция СчетУчетаСсылкаИзНоменклатуры(Номенклатура) Экспорт
	
	СчетУчетаСсылкаИзНоменклатуры = БухгалтерскиеОперацииПовтИсп.СчетУчетаСсылкаИзНоменклатуры(Номенклатура);
	
	Если Не ЗначениеЗаполнено(СчетУчетаСсылкаИзНоменклатуры) Тогда
		
		Если Не ЗначениеЗаполнено(Номенклатура) Тогда
			ТекстОшибки = НСтр("ru = 'Не заполнена номенклатура'");
		Иначе
			РеквизитыНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, "Наименование, СчетУчета");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
								НСтр("ru = 'Для номенклатуры ""%1"" не определен счет учета ""%2""'"),
								РеквизитыНоменклатуры.Наименование,
								Строка(РеквизитыНоменклатуры.СчетУчета));
		КонецЕсли;
							
		ДобавитьОшибкуВКонтекстПроведения(ТекстОшибки, "СчетУчетаСсылкаИзНоменклатуры");
		
	КонецЕсли;
		
	Возврат СчетУчетаСсылкаИзНоменклатуры;
	
КонецФункции

// Функция возвращает вид субконто доп. аналитики учета материальных запасов на счете
//
Функция ВидДопАналитикиУчетаМЗ(СчетУчета) Экспорт
	
	ВидыДополнительнойАналитикиУчетаМЗ = УправлениеМатериальнымиЗапасамиПовтИсп.ПолучитьВидыДополнительнойАналитикиУчетаМЗ();
	Возврат ВидыДополнительнойАналитикиУчетаМЗ.Получить(СчетУчета);
	
КонецФункции

// Содержание проводки в операциях с материальными запасами
//
Функция СодержаниеПроводкиМПЗ(СодержаниеПроводки, Номенклатура) Экспорт
	
	Возврат СокрЛП(СодержаниеПроводки) + ": "
		+ ПолноеНаименованиеОбъекта(Номенклатура);
	
КонецФункции

Функция МатериальныхЗапасовДостаточноДляСписания(Знач ВидУчета = "БУ") Экспорт

	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	Если КонтекстПроведения.Отказ Тогда
		Возврат Истина; // Есть ошибки при формировании источников данных.
	КонецЕсли;
	
	// Превышение остатка материальных запасов.
	ТаблицаСписания = Неопределено;
	Если КонтекстПроведения.ДополнительныеСвойства.Свойство("ТаблицаСписаниеМатериальныхЗапасов") Тогда
		ТаблицаСписания = КонтекстПроведения.ДополнительныеСвойства.ТаблицаСписаниеМатериальныхЗапасов;
	ИначеЕсли КонтекстПроведения.ДополнительныеСвойства.Свойство("ТаблицаСписаниеПродуктовПитания") Тогда
		ТаблицаСписания = КонтекстПроведения.ДополнительныеСвойства.ТаблицаСписаниеПродуктовПитания;
	Иначе
		ВызватьИсключение "Не обнаружена таблица списания материальных запасов.
			|Необходимо подключить источник данных ""Списание материальных запасов"" (""Списание продуктов питания"").";
	КонецЕсли;
	
	МатериальныхЗапасовДостаточноДляСписания =
		Не УправлениеМатериальнымиЗапасами.ОстатокПревышенПоТаблицеСписания(ТаблицаСписания, ВидУчета);
	
	// Превышение остатка возвратной тары.
	Если МатериальныхЗапасовДостаточноДляСписания 
			И КонтекстПроведения.ДополнительныеСвойства.Свойство("ТаблицаСписаниеВозвратнойТары") Тогда
		
		ТаблицаСписания = КонтекстПроведения.ДополнительныеСвойства.ТаблицаСписаниеВозвратнойТары;
		МатериальныхЗапасовДостаточноДляСписания =
			Не УправлениеМатериальнымиЗапасами.ОстатокПревышенПоТаблицеСписания(ТаблицаСписания, ВидУчета);
		
	КонецЕсли;
	
	Возврат МатериальныхЗапасовДостаточноДляСписания;

КонецФункции

Функция РеквизитСписанияМатериальныхЗапасов(ИмяРеквизита, ИмяСписка, НомерСтроки, ВидУчета="БУ") Экспорт
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	
	ТаблицаСписания = Неопределено;
	Если КонтекстПроведения.ДополнительныеСвойства.Свойство("ТаблицаСписаниеМатериальныхЗапасов") Тогда
		ТаблицаСписания = КонтекстПроведения.ДополнительныеСвойства.ТаблицаСписаниеМатериальныхЗапасов;
	ИначеЕсли КонтекстПроведения.ДополнительныеСвойства.Свойство("ТаблицаСписаниеПродуктовПитания") Тогда
		ТаблицаСписания = КонтекстПроведения.ДополнительныеСвойства.ТаблицаСписаниеПродуктовПитания;
	Иначе
		ВызватьИсключение "Не обнаружена таблица списания материальных запасов.
			|Необходимо подключить источник данных ""Списание материальных запасов"" (""Списание продуктов питания"").";
	КонецЕсли;
	
	НайденныеСтроки = ТаблицаСписания.НайтиСтроки(Новый Структура("ИмяСписка,НомерСтроки,ВидУчета", ИмяСписка, НомерСтроки, ВидУчета));
	НайденнаяСтрока = ?(НайденныеСтроки.Количество() > 0, НайденныеСтроки[0], Неопределено);
	
	Возврат ПолучитьЗначениеРеквизитаСтроки(НайденнаяСтрока, ИмяРеквизита);
	
КонецФункции

// МЗ в пути

Функция КоличествоМЗвПутиДостаточноДляСписания(	ДокументСсылка,
												ИФО,
												КФО,
												КПС,
												Подразделение,
												Контрагент,
												СчетУчетаМЗвПути) Экспорт
												
	Отказ = Ложь;												
	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;
												
	ПараметрИФО 				= ?(ЗначениеЗаполнено(ИФО) И ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"), 				
																			ИФО, 				Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());												
	ПараметрКФО 				= ?(ЗначениеЗаполнено(КФО), 				КФО, 				Перечисления.КВД.ПустаяСсылка());												
	ПараметрКПС 				= ?(ЗначениеЗаполнено(КПС), 				КПС, 				Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка());												
	ПараметрПодразделение 		= ?(ЗначениеЗаполнено(Подразделение) И ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"),
																			Подразделение,		Справочники.Подразделения.ПустаяСсылка());												
	ПараметрКонтрагент			= ?(ЗначениеЗаполнено(Контрагент),			Контрагент, 		Справочники.Контрагенты.ПустаяСсылка());
	
	ТаблицаМатериалы = БухгалтерскиеОперацииПовтИсп.ПолучитьОстаткиМЗвПути(	ДокументСсылка,
																			ДокументСсылка.Дата,
																			"Материалы",
																			СчетУчетаМЗвПути,
																			ПараметрИФО,
																			ПараметрКФО,
																			ПараметрКПС,
																			ПараметрПодразделение,
																			ПараметрКонтрагент);
	Если ТаблицаМатериалы.Итог("Нехватка")>0 Тогда
		Для каждого ТекСтр Из ТаблицаМатериалы Цикл
			
			Если ТекСтр.Нехватка > 0 Тогда
				ТекстСообщения = НСтр("ru='Недостаточно материала для оприходования: не оприходовано %1 %2 %3 из необходимых %4'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
																						Строка(ТекСтр.КоличествоОстаток),
																						Строка(ТекСтр.ЕдиницаИзмерения),
																						ТекСтр.НоменклатураНаименование,
																						Строка(ТекСтр.Количество));
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);																		
			КонецЕсли;
		
		КонецЦикла; 		
	КонецЕсли;
																			
	ТаблицаТара = БухгалтерскиеОперацииПовтИсп.ПолучитьОстаткиМЗвПути(		ДокументСсылка,
																			ДокументСсылка.Дата,
																			"ВозвратнаяТара",
																			СчетУчетаМЗвПути,
																			ПараметрИФО,
																			ПараметрКФО,
																			ПараметрКПС,
																			ПараметрПодразделение,
																			ПараметрКонтрагент);
	Если ТаблицаТара.Итог("Нехватка")>0 Тогда
		Для каждого ТекСтр Из ТаблицаТара Цикл
			
			Если ТекСтр.Нехватка > 0 Тогда
				ТекстСообщения = НСтр("ru='Недостаточно тары для оприходования: не оприходовано %1 %2 %3 из необходимых %4'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
																						Строка(ТекСтр.КоличествоОстаток),
																						Строка(ТекСтр.ЕдиницаИзмерения),
																						ТекСтр.НоменклатураНаименование,
																						Строка(ТекСтр.Количество));
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);																		
			КонецЕсли;
		
		КонецЦикла; 		
	КонецЕсли;
																			
	Возврат Не Отказ;											
												
КонецФункции

// Имущество казны

Функция МожноПровестиСписаниеМЗИК(ДокументСсылка) Экспорт
	
	ТаблицаНоменклатуры = БухгалтерскиеОперацииПовтИсп.ПолучитьОстаткиМатериаловИК(ДокументСсылка);
	Если ТаблицаНоменклатуры = Неопределено Тогда
		ВызватьИсключение НСтр("ru='Функция БухгалтерскиеОперации.МожноПровестиСписаниеМЗИК не используется для данного документа'");	
	КонецЕсли;
	
	НайденыСтроки = ТаблицаНоменклатуры.НайтиСтроки(Новый Структура("Нехватка", Истина));
	Если НайденыСтроки.Количество()=0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Организация, ИФО, Подразделение, КФО");
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
		И БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("108.00").УчетПоПодразделениям Тогда
		ТекстСообщения = НСтр("ru='По номенклатуре ""%1"" на счете %2.%3.%4 по подразделению %5 не хватает количества'");	
	Иначе
		ТекстСообщения = НСтр("ru='По номенклатуре ""%1"" на счете %2.%3.%4 не хватает количества'");
	КонецЕсли;
	Для каждого ТекСтрока Из НайденыСтроки Цикл
	
		ОбщегоНазначения.СообщитьПользователю(
						СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
																				ТекСтрока.НоменклатураПредставление,
																				Строка(ТекСтрока.КПС),
																				Строка(РеквизитыДокумента.КФО),
																				Строка(ТекСтрока.Счет),
																				Строка(РеквизитыДокумента.Подразделение)));
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ПолучитьСуммуСписанияМЗИК(ДокументСсылка, НомерСтроки) Экспорт
	ТаблицаНоменклатуры = БухгалтерскиеОперацииПовтИсп.ПолучитьОстаткиМатериаловИК(ДокументСсылка);
	ТекСтрока = ТаблицаНоменклатуры.Найти(НомерСтроки, "НомерСтроки");
	Возврат ТекСтрока.СуммаСписания;
КонецФункции

#КонецОбласти

#Область УчетМатериаловВПользовании

Функция ПроверитьОстаткиМЗвПользовании(ДокументСсылка, КФО, ЦМООтправитель = Неопределено,
	ПодразделениеОтправитель = Неопределено) Экспорт
	
	Возврат УправлениеМатериальнымиЗапасами.ТаблицаСписанияМЗВПользовании(
		ДокументСсылка,
		КФО,
		ЦМООтправитель,
		ПодразделениеОтправитель).Найти(Истина, "ОстатокПревышен") = Неопределено;
	
КонецФункции // ПроверитьОстаткиМЗвПользовании()

#КонецОбласти

#Область УчетУслугРабот

Функция МожноСписатьЗатратыПоУслугам(ДокументСсылка) Экспорт
	
	Если ТипЗнч(ДокументСсылка)<>Тип("ДокументСсылка.СписаниеЗатратПоУслугам") Тогда
		ОбщегоНазначения.СообщитьПользователю(
									СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
									НСтр("ru='Функция ""МожноСписатьЗатратыПоУслугам"" может использоваться только в документе ""%1""'"),
									Метаданные.Документы.СписаниеЗатратПоУслугам.Синоним));
		Возврат Ложь;
	КонецЕсли;
	
	Отказ = Ложь;
	
	// Получим данные о затратах из документов списания и со счетов БУ и НУ.
	ОстаткиЗатрат = Документы.СписаниеЗатратПоУслугам.ОстаткиЗатратПоДокументамСписания(ДокументСсылка);
	
	ВыборкаВидУчета = ОстаткиЗатрат["ЗатратыПоДаннымУчета1"].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаВидУчета.Следующий() Цикл
		
		ВыборкаТипЗатрат = ВыборкаВидУчета.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаТипЗатрат.Следующий() Цикл
		ВыборкаНоменклатура = ВыборкаТипЗатрат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаНоменклатура.Следующий() Цикл
		ВыборкаУслугаРасход = ВыборкаНоменклатура.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаУслугаРасход.Следующий() Цикл
			
			Выборка = ВыборкаУслугаРасход.Выбрать();
			Пока Выборка.Следующий() Цикл
				
				СуммаКСписанию = ?(Выборка.ВидУчета="НУ", Выборка.СуммаКСписаниюНУ, Выборка.СуммаКСписанию);
				СуммаОстаток   = Выборка.СуммаОстаток;
				
				Если СуммаКСписанию <= СуммаОстаток Тогда
					Продолжить;
				КонецЕсли;
				
				ТекстОшибки =  НСтр("ru='Сумма списания: %1"+Символы.ПС+"превышает остаток: %2'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
					Формат(СуммаКСписанию, "ЧЦ=18; ЧДЦ=2"), Формат(СуммаОстаток, "ЧЦ=18; ЧДЦ=2"));
				
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Некорректно заполнена колонка ""%1"" в строке затрат ""%2"" по виду затрат ""%3"".
                           |
                           |%4'"),
					?(Выборка.ВидУчета="НУ", НСтр("ru = 'Сумма НУ'"), НСтр("ru = 'Сумма'")),
					Выборка.УслугаРасход,
					Выборка.ВидЗатрат,
					ТекстОшибки);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументСсылка, , , Отказ);
				
				
			КонецЦикла;
			
		КонецЦикла;
		КонецЦикла;
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат НЕ Отказ;
	
КонецФункции

Функция ПараметрСписанияДоходовБудущихПериодов(ИмяПараметра, Договор, Организация, НаДату) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПараметрыСписанияДоходовБудущихПериодов.Регистратор КАК Регистратор,
	|	ПараметрыСписанияДоходовБудущихПериодов.ВидОперации КАК ВидОперации,
	|	ПараметрыСписанияДоходовБудущихПериодов.СпособПризнанияДоходов КАК СпособПризнанияДоходов,
	|	ПараметрыСписанияДоходовБудущихПериодов.ДатаНачалаСписания КАК ДатаНачалаСписания,
	|	ПараметрыСписанияДоходовБудущихПериодов.ДатаОкончанияСписания КАК ДатаОкончанияСписания,
	|	ПараметрыСписанияДоходовБудущихПериодов.СчетДоходов КАК СчетДоходов,
	|	ПараметрыСписанияДоходовБудущихПериодов.СубконтоДоходов1 КАК СубконтоДоходов1,
	|	ПараметрыСписанияДоходовБудущихПериодов.СубконтоДоходов2 КАК СубконтоДоходов2,
	|	ПараметрыСписанияДоходовБудущихПериодов.СубконтоДоходов3 КАК СубконтоДоходов3,
	|	ПараметрыСписанияДоходовБудущихПериодов.ВидДеятельностиНУ КАК ВидДеятельностиНУ,
	|	ПараметрыСписанияДоходовБудущихПериодов.СчетДоходовНУ КАК СчетДоходовНУ,
	|	ПараметрыСписанияДоходовБудущихПериодов.СтатьяПрочихДоходовНУ КАК СтатьяПрочихДоходовНУ
	|ИЗ
	|	РегистрСведений.ПараметрыСписанияДоходовБудущихПериодов.СрезПоследних(
	|			&ДатаСреза,
	|			Договор = &Договор
	|				И Организация = &Организация) КАК ПараметрыСписанияДоходовБудущихПериодов";
	Запрос.УстановитьПараметр("ДатаСреза",   НаДату);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Договор",     Договор);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат ПолучитьЗначениеРеквизитаСтроки(Выборка, ИмяПараметра);
	КонецЕсли;
	
КонецФункции

// Содержание проводки при равномерном признании доходов в течение периода.
//
Функция СодержаниеПроводкиДБП(СодержаниеПроводки, Договор) Экспорт
	
	Если ТипЗнч(Договор) = Тип("СправочникСсылка.Договоры")
		И ЗначениеЗаполнено(Договор.Контрагент) Тогда
		Возврат СокрЛП(СодержаниеПроводки) + ": "
			+ БухгалтерскиеОперации.ПредставлениеОбъекта(Договор) + ", "
			+ БухгалтерскиеОперации.ПредставлениеОбъекта(Договор.Контрагент);
	Иначе
		Возврат СокрЛП(СодержаниеПроводки) + ": "
			+ БухгалтерскиеОперации.ПредставлениеОбъекта(Договор);
	КонецЕсли;
	
КонецФункции

