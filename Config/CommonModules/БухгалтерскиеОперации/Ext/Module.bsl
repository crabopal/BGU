Функция ПолучитьРеквизитСписанияОСвНУ(ДокументСсылка, ОсновноеСредство, ИмяРеквизита, ЭтоКапВложение = Ложь) Экспорт
	
	ТаблицаОС = БухгалтерскиеОперацииПовтИсп.ТаблицаОСДляСписанияНУ(ДокументСсылка, ЭтоКапВложение);
	
	НайденнаяСтрока = ?(ТаблицаОС.Количество()>0, ТаблицаОС.Найти(ОсновноеСредство, "ОсновноеСредство"), Неопределено);
	Если НайденнаяСтрока = Неопределено Тогда
		Если Найти(ИмяРеквизита, "Стоимость") > 0
			Или Найти(ИмяРеквизита, "Сумма") > 0
			Или Найти(ИмяРеквизита, "Количество") > 0 Тогда
			Возврат 0;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	ПолученноеЗначение = ПолучитьЗначениеРеквизитаСтроки(НайденнаяСтрока, ИмяРеквизита);
	
	ЭтоГрупповойУчет = ПолучитьЗначениеРеквизитаСтроки(НайденнаяСтрока, "ГрупповойУчет");
	Если ЭтоГрупповойУчет // Из расчета одного инвентарного номера, одной единицы.
		И (Найти(ИмяРеквизита, "Стоимость") > 0 Или Найти(ИмяРеквизита, "СуммаНачисленнойАмортизации") > 0) Тогда
		ПолученноеЗначение = ПолученноеЗначение / ПолучитьЗначениеРеквизитаСтроки(НайденнаяСтрока, "Количество");
	КонецЕсли;
	
	Возврат ПолученноеЗначение;
	
КонецФункции

Функция ПолучитьСуммуСписанияАмортизацииНУ(ДокументСсылка, ОсновноеСредство, ВидСуммы="") Экспорт

	Возврат ПолучитьРеквизитСписанияОСвНУ(ДокументСсылка, ОсновноеСредство, "СуммаНачисленнойАмортизации"+ВидСуммы)
		  + ПолучитьРеквизитАмортизацииТекущегоМесяцаОС(ДокументСсылка, ОсновноеСредство, "СуммаАмортизации"+ВидСуммы, "НУ");

КонецФункции

Функция ПолучитьСуммуСписанияСтоимостиНУ(ДокументСсылка, ОсновноеСредство, ВидСуммы="") Экспорт

	Возврат ПолучитьРеквизитСписанияОСвНУ(ДокументСсылка, ОсновноеСредство, "ОстаточнаяСтоимость"+ВидСуммы)
		  - ПолучитьРеквизитСписанияОСвНУ(ДокументСсылка, ОсновноеСредство, "СуммаНачисленнойАмортизации"+ВидСуммы)
		  - ПолучитьРеквизитАмортизацииТекущегоМесяцаОС(ДокументСсылка, ОсновноеСредство, "СуммаАмортизации"+ВидСуммы, "НУ");

КонецФункции

