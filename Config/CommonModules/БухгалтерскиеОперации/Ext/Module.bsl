// Устанавливает блокировку журнала бухгалтерии по счетам, организации и периоду.
//
// Параметры
//  Организация  - СправочникСсылка.Организации
//  Период  - Дата
//  СтрокаСчетов  - Строка
//  УстанавливатьБлокировку  - Булево - признак необходимости установки блокировки. Используется для управления
//										необходимостью блокировки с помощью флажка в настройке операции.
//
// Возвращаемое значение:
//   Булево - Истина - если блокировка установлена или не заполнена строка счетов, Ложь - если не удалось заблокировать.
//
Функция УстановитьБлокировкуПоСчетам(Организация, Период, СтрокаСчетов = "", УстанавливатьБлокировку = Ложь) Экспорт
	Если НЕ УстанавливатьБлокировку или СтрокаСчетов = "" Тогда
		Возврат Истина;
	КонецЕсли;
	
	МассивСчетов = Новый Массив;
	МассивКодовСчетов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаСчетов, ",");
	Для каждого ТекКодСчета Из МассивКодовСчетов Цикл
	
		ТекСчет = БухгалтерскийУчет.СчетПоКоду(ТекКодСчета, Период, Организация);
		Если ЗначениеЗаполнено(ТекСчет) Тогда
			МассивСчетов.Добавить(ТекСчет);	
		КонецЕсли;
	
	КонецЦикла; 
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ЕПСБУ.Ссылка
	               |ИЗ
	               |	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	               |ГДЕ
	               |	ЕПСБУ.Ссылка В ИЕРАРХИИ(&МассивСчетов)
	               |	И ЕПСБУ.ЭлементГруппа = ЛОЖЬ";
				   
	УстановитьПривилегированныйРежим(Истина);				   
	Запрос = Новый Запрос(ТекстЗапроса);			   
	Запрос.УстановитьПараметр("МассивСчетов", МассивСчетов);
	ТаблицаСчетов = Запрос.Выполнить().Выгрузить();
	
	СтруктураПараметров = Новый Структура("ТипТаблицы, ИмяТаблицы, ИсточникДанных",
										  "РегистрБухгалтерии", "ЖурналПроводокЕПСБУ", ТаблицаСчетов);
		
	ЗначенияБлокировки = Новый Соответствие;
	ЗначенияБлокировки.Вставить("Период", Период);
	ЗначенияБлокировки.Вставить("Организация", Организация);
	ОписаниеИсточника = Новый Соответствие;
	ОписаниеИсточника.Вставить("Счет", "Ссылка");
	Отказ = Ложь;
	ОбщегоНазначенияБГУ.УстановитьУправляемуюБлокировку(СтруктураПараметров, ЗначенияБлокировки, ОписаниеИсточника, Отказ);
	
	Возврат НЕ Отказ;

КонецФункции // УстановитьБлокировкуПоСчетам()

