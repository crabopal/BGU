// Функция возвращает значение реквизита из проводок указанного документа.
// Предполагается, что значение указанного реквизита одинаковое во всех проводках этого документа.
// 
Функция РеквизитПроводкиДокумента(ИмяРеквизита, ДокументСсылка, Счет, ДтКт="", КорСчет=Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ИмяРеквизита)
	 ИЛИ НЕ ЗначениеЗаполнено(ДокументСсылка)
	 ИЛИ НЕ ЗначениеЗаполнено(Счет) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	РеквизитыПроводок = БухгалтерскиеОперацииПовтИсп.ПолучитьРеквизитыПроводокДокумента(ДокументСсылка, Счет, ДтКт, КорСчет);
	
	Если ЗначениеЗаполнено(РеквизитыПроводок) Тогда
		Возврат ПолучитьЗначениеРеквизитаСтроки(РеквизитыПроводок, ИмяРеквизита);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

// Возвращает значение реквизита строки табличной части документа.
// Может использоваться при формировании проводок по таблице дополнительных источников данных,
// в которых есть реквизиты идентификации строки табличной части документа ИмяСписка и НомерСтроки.
//
Функция РеквизитСтрокиДокумента(ИмяРеквизита, ИмяТабличнойЧасти, НомерСтроки) Экспорт
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	ДокументОбъект = КонтекстПроведения.ДокументОбъект;
	
	ТабличнаяЧасть = ДокументОбъект[ИмяТабличнойЧасти];
	Если НомерСтроки > ТабличнаяЧасть.Количество() Тогда
		Возврат Неопределено;
	Иначе
		СтрокаТабличнойЧасти = ТабличнаяЧасть.Получить(НомерСтроки - 1);
		Возврат СтрокаТабличнойЧасти[ИмяРеквизита];
	КонецЕсли;
	
КонецФункции

