Функция ОпределитьНовыйСчетАмортизации(ВидИмущества,Субконто1,Субконто2,Субконто3,ТекСчет,Дата,Организация,ИФО,СчетАмортизации) Экспорт
	
	ОС = ОпределитьОСИзСубконто(Субконто1,Субконто2,Субконто3);
	
	СчетПоступления = ОпределитьСчетОприходования_ОС(ВидИмущества,Субконто1,Субконто2,Субконто3,ТекСчет,Дата,Организация,ИФО,Ложь);
	Если НЕ ЗначениеЗаполнено(СчетПоступления) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Не получилось определить счет оприходования для "+ОС+"'"));
		НовыйСчетАмортизации = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	Иначе
		НовыйСчетАмортизации = БухгалтерскиеОперации.СчетАмортизацииОС(СчетПоступления);
		Если НЕ ЗначениеЗаполнено(НовыйСчетАмортизации) Тогда
			НовыйСчетАмортизации  = СчетАмортизации;
		КонецЕсли;
	КонецЕсли;
	
	Возврат НовыйСчетАмортизации;			
	
КонецФункции

Функция ОпределитьОСИзСубконто(Субконто1,Субконто2,Субконто3) Экспорт
	ОС = Справочники.ОсновныеСредства.ПустаяСсылка();
	Если ТипЗнч(Субконто1) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
		ОС = Субконто1;
	ИначеЕсли ТипЗнч(Субконто2) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
		ОС = Субконто2;
	ИначеЕсли ТипЗнч(Субконто3) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
		ОС = Субконто3;
	КонецЕсли;
	Возврат ОС;
КонецФункции

