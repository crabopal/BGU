// Устарела.
Функция ПолучитьБухгалтерскуюОперациюДокумента(СсылкаДокумента) Экспорт   
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ОперацииДокументов.Операция КАК Ссылка
	|ИЗ
	|	РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
	|ГДЕ
	|	ОперацииДокументов.Документ = &СсылкаДокумента";
	
	Запрос.УстановитьПараметр("СсылкаДокумента", СсылкаДокумента);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе	
		Возврат Неопределено;
	КонецЕсли;	
	
КонецФункции	

// Устарела.
Функция МожноПровестиСписаниеОС(ДокументСсылка, ЭтоКапВложение = Ложь) Экспорт
	Отказ = Ложь;
	ПроверятьТолькоКоличество = Ложь;
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПередачаГруппОбъектовОС")
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеГруппОбъектовОС") 
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеЛитературы") 
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.АктСписанияМягкогоИХозИнвентаряОС") Тогда
		ТаблицаОС = ДокументСсылка.ОсновныеСредства.Выгрузить(,"ОсновноеСредство, ИнвентарныйНомер, Сумма, СуммаАмортизации, Количество");
		ИмяРеквизитаЦМО 			= "ЦМО";
		ИмяРеквизитаПодразделение 	= "Подразделение";
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПередачаЗдания")
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПередачаОбъектаОС")
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеТранспорта")
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеАвтотранспорта")
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеОбъектаОС") Тогда
		ТаблицаОС = Документы.СписаниеГруппОбъектовОС.СоздатьДокумент().ОсновныеСредства.Выгрузить(,"ОсновноеСредство, ИнвентарныйНомер, Сумма, СуммаАмортизации, Количество");	
		НовСтр = ТаблицаОС.Добавить();
		НовСтр.ОсновноеСредство = ДокументСсылка.ОсновноеСредство;
		НовСтр.ИнвентарныйНомер = ДокументСсылка.ИнвентарныйНомер;
		НовСтр.Сумма 			= ДокументСсылка.Сумма;
		НовСтр.СуммаАмортизации = ДокументСсылка.СуммаАмортизации;
		НовСтр.Количество 		= 1;
		ИмяРеквизитаЦМО 			= "ЦМО";
		ИмяРеквизитаПодразделение 	= "Подразделение";
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.АктСписанияМягкогоИХозИнвентаряОС") Тогда
		ТаблицаОС = ДокументСсылка.ОсновныеСредства.Выгрузить(,"ОсновноеСредство, ИнвентарныйНомер, Количество");
		ТаблицаОС.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
		ТаблицаОС.Колонки.Добавить("СуммаАмортизации", Новый ОписаниеТипов("Число"));
		ПроверятьТолькоКоличество = Истина;
		ИмяРеквизитаЦМО 			= "ЦМО";
		ИмяРеквизитаПодразделение 	= "Подразделение";
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ТребованиеНакладнаяОС")
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.НакладнаяНаВнутреннееПеремещениеОС2") Тогда
		ТаблицаОС = ДокументСсылка.ОсновныеСредства.Выгрузить(,"ОсновноеСредство, ИнвентарныйНомер, Количество, Сумма");
		ТаблицаОС.Колонки.Добавить("СуммаАмортизации", Новый ОписаниеТипов("Число"));
		ПроверятьТолькоКоличество = Истина;
		ИмяРеквизитаЦМО 			= "ЦМООтправитель";
		ИмяРеквизитаПодразделение 	= "ПодразделениеОтправитель";
	Иначе
		// недопустимый тип параметра
		Возврат Ложь;
	КонецЕсли;
	
	ТаблицаОС.Свернуть("ОсновноеСредство, ИнвентарныйНомер, Сумма, СуммаАмортизации, Количество");
	СписокОС = ТаблицаОс.ВыгрузитьКолонку("ОсновноеСредство");
	ВидНФАДокумента = Перечисления.ВидыНФА.ПустаяСсылка();
	Если СписокОС.Количество()>0 Тогда
		ВидНФАДокумента = БухгалтерскиеОперацииСервер.ЗначениеРеквизита(СписокОС[0], "ВидНФА");
	КонецЕсли;
	
	Если ЭтоКапВложение Тогда
		ОстаткиОС = УправлениеОсновнымиСредствами.ОпределитьСтоимостьСпискаНФА(	СписокОС,
																				ДокументСсылка.МоментВремени(),
																				ДокументСсылка.Организация,
																				ДокументСсылка.КФО,
																				ДокументСсылка.КПС,
																				ДокументСсылка.ИФО,
																				ДокументСсылка[ИмяРеквизитаПодразделение]);
	Иначе																		
		ОстаткиОС = УправлениеОсновнымиСредствами.ОпределитьСтоимостьСпискаОС(	СписокОС,
																				ДокументСсылка.МоментВремени(),
																				ДокументСсылка.Организация,
																				ДокументСсылка.КФО,
																				ДокументСсылка.КПС,
																				ДокументСсылка[ИмяРеквизитаЦМО],
																				ДокументСсылка.ИФО,
																				ДокументСсылка[ИмяРеквизитаПодразделение]);
	КонецЕсли;																	
	Для каждого ТекОС Из ТаблицаОС Цикл
		
		НайденыСтроки = Новый Массив;
		Если ЗначениеЗаполнено(ТекОС.ИнвентарныйНомер) Тогда
			Отбор = Новый Структура("ОсновноеСредство, ИнвНомер", ТекОС.ОсновноеСредство, ТекОС.ИнвентарныйНомер);
			НайденыСтроки = ОстаткиОС.НайтиСтроки(Отбор);
		Иначе
			Отбор = Новый Структура("ОсновноеСредство", ТекОС.ОсновноеСредство);
			НайденыСтроки = ОстаткиОС.НайтиСтроки(Отбор);
		КонецЕсли;
		Если НайденыСтроки.Количество()=1 Тогда
			Если ЭтоКапВложение Тогда
				
				Если НайденыСтроки[0].СуммаТекОС / ?(НайденыСтроки[0].КоличествоВсего=0, 1, НайденыСтроки[0].КоличествоВсего) <> ТекОС.Сумма Тогда
					ТекстСообщения = НСтр("ru='Балансовая стоимость %1 не совпадает с учетной'");
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ТекОС.ОсновноеСредство.Наименование);
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
				КонецЕсли;
				
				Если НайденыСтроки[0].КоличествоВсего < ТекОС.Количество Тогда
					ТекстСообщения = НСтр("ru='Не хватает количества %1'");
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ТекОС.ОсновноеСредство.Наименование);
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
				КонецЕсли;
				
			Иначе
				
				Если НЕ ПроверятьТолькоКоличество И НайденыСтроки[0].СуммаТекОС <> ТекОС.Сумма Тогда
					ТекстСообщения = НСтр("ru='Балансовая стоимость %1 не совпадает с учетной'");
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ТекОС.ОсновноеСредство.Наименование);
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
				КонецЕсли;
				
				Если Не ПроверятьТолькоКоличество И
					((НайденыСтроки[0].АмортизацияТекОС <> ТекОС.СуммаАмортизации И ЗначениеЗаполнено(НайденыСтроки[0].АмортизацияТекОС))
					ИЛИ (Не ЗначениеЗаполнено(НайденыСтроки[0].АмортизацияТекОС) И ТекОС.СуммаАмортизации <> 0)) Тогда
					ТекстСообщения = НСтр("ru='Сумма амортизации %1 не совпадает с учетной'");
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ТекОС.ОсновноеСредство.Наименование);
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
				КонецЕсли;
				
				Если НайденыСтроки[0].КоличествоМОЛ < ТекОС.Количество Тогда
					ТекстСообщения = НСтр("ru='Не хватает количества %1'");
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ТекОС.ОсновноеСредство.Наименование);
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
				КонецЕсли;
			КонецЕсли;
			
		Иначе
			ТекстСообщения = НСтр("ru='Не найдена балансовая стоимость %1'");	
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ТекОС.ОсновноеСредство.Наименование);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
		КонецЕсли;
			
	КонецЦикла; 																		

	Возврат НЕ Отказ;
	
КонецФункции

// Устарела. Следует использовать функцию ОтражатьВНалоговомУчете(...),
// либо НалоговыйУчетКлиентСервер.ВедетсяНалоговыйУчетПоКФО(КФО).
//
Функция ВедетсяНалоговыйУчетПоКФО(Знач КФО = Неопределено) Экспорт
	
	МассивКФОдляНУ = НалоговыйУчетКлиентСервер.ПолучитьМассивКФОдляНалоговогоУчета();
	Если МассивКФОдляНУ.Найти(КФО) = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Устарела. Следует использовать функцию ОтражатьВНалоговомУчете(...),
// либо НалоговыйУчетВызовСервера.ПлательщикНалогаНаПрибыль(Организация, Период).
//
Функция ВедетсяНалоговыйУчетПоНалогуНаПрибыль(Организация, Дата) Экспорт
	
	Если ЗначениеЗаполнено(Организация) И ЗначениеЗаполнено(Дата) Тогда
		
		УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Организация, КонецДня(Дата));
		Если УчетнаяПолитика.СистемаНалогообложения <> Перечисления.СистемыНалогообложения.Общая Тогда
			Возврат Ложь;
		КонецЕсли;
		
	Иначе
		// Не заданы учреждение и дата. Неизвестно по какой системе налогообложения вести налоговый учет.
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Устарела. Следует использовать функцию ПолучитьЗначениеСубконто(...).
//
Функция УстановитьСубконтоНУ(СчетНУ, НомерСубконто, ЗначениеСубконтоПоУмолчанию=Неопределено,
			ИмяСубконто1="", ЗначениеСубконто1=Неопределено,
			ИмяСубконто2="", ЗначениеСубконто2=Неопределено,
			ИмяСубконто3="", ЗначениеСубконто3=Неопределено,
			ИмяСубконто4="", ЗначениеСубконто4=Неопределено,
			ИмяСубконто5="", ЗначениеСубконто5=Неопределено) Экспорт
	
	// Значение субконто задано явно
	Если ЗначениеЗаполнено(ЗначениеСубконтоПоУмолчанию) Тогда
		Возврат ЗначениеСубконтоПоУмолчанию;
	КонецЕсли;
	
	Возврат ПолучитьЗначениеСубконто(СчетНУ, НомерСубконто,
			ИмяСубконто1, ЗначениеСубконто1,
			ИмяСубконто2, ЗначениеСубконто2,
			ИмяСубконто3, ЗначениеСубконто3,
			ИмяСубконто4, ЗначениеСубконто4,
			ИмяСубконто5, ЗначениеСубконто5);
	
КонецФункции

// Устарела. Следует использовать источник данных БухгалтерскиеОперацииИсточникиДанных.СписаниеМатериальныхЗапасов()
// Функция возвращает реквизиты списания из таблицы списанной номенклатуры
//
Функция ПолучитьРеквизитСписанияНоменклатуры(ИмяРеквизита, ДокументСсылка, НомерСтроки, ИмяСписка="Материалы", ВидУчета="БУ") Экспорт

	ТаблицаСписания = БухгалтерскиеОперацииПовтИсп.ТаблицаСписанияНоменклатуры(ДокументСсылка);
	
	НайденныеСтроки = ТаблицаСписания.НайтиСтроки(Новый Структура("НомерСтроки, ИмяСписка, ВидУчета", НомерСтроки, ИмяСписка, ВидУчета));
	Если НайденныеСтроки.Количество()=1 Тогда
		НайденнаяСтрока = НайденныеСтроки[0];
	ИначеЕсли НайденныеСтроки.Количество()>1 Тогда // списано несколькими строками
		СтрокиТаблицыСписания = ТаблицаСписания.Скопировать(НайденныеСтроки);
		СтрокиТаблицыСписания.Свернуть("СчетУчета,Номенклатура,ЦМО,СубконтоДоп,КФО,ИФО,КПС,Подразделение", "Стоимость,СтоимостьНеУчитываетсяНУ,СтоимостьЕНВД");
		НайденнаяСтрока = СтрокиТаблицыСписания[0];
	Иначе
		НайденнаяСтрока = Неопределено;
	КонецЕсли;
	
	Если ИмяРеквизита = "Сумма" Тогда
		ИмяРеквизита = "Стоимость";
	ИначеЕсли ИмяРеквизита = "СуммаНеУчитываетсяНУ" Тогда
		ИмяРеквизита = "СтоимостьНеУчитываетсяНУ";
	ИначеЕсли ИмяРеквизита = "СуммаЕНВД" Тогда
		ИмяРеквизита = "СтоимостьЕНВД";
	КонецЕсли;
	
	Если ИмяРеквизита = "ВидЗатрат" Тогда
		ИмяРеквизита = "ДополнительныйВидЗатрат";
	КонецЕсли;
	
	Возврат ПолучитьЗначениеРеквизитаСтроки(НайденнаяСтрока, ИмяРеквизита);

КонецФункции

// Устарела. Следует использовать БухгалтерскиеОперации.МатериальныхЗапасовДостаточноДляСписания()
// Функция производит контроль достаточности остатков номенклатуры для списания документом
//
Функция НоменклатурыДостаточноДляСписания(Знач ДокументСсылка, Знач ВидУчета = "БУ", Знач УстанавливатьБлокировку) Экспорт

	ТаблицаСписания = БухгалтерскиеОперацииПовтИсп.ТаблицаСписанияНоменклатуры(ДокументСсылка);
	СтрокиОстатокПревышен = ТаблицаСписания.НайтиСтроки(Новый Структура("ВидУчета,ОстатокПревышен", ВидУчета, Истина));
	
	Возврат (СтрокиОстатокПревышен.Количество() = 0);

КонецФункции

// Устарела. Функция проверяет наличие необходимых для проведения документов материалов. 
// Если количество материалов достаточно для проведения документа, то при установке флага БлокироватьДанные
// устанавливается управляемая блокировка.
//
// Функция используется при проверке условия формирования операции.
//
// Параметры:
//	ДокументСсылка - ссылка на документ
//	ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения
//	КФО - ПеречислениеСсылка.КВД
//	КПС - СправочникСсылка.КлассификационныеПризнакиСчетов
// 	ЦМО - СправочникСсыкла.ЦМО
//	Подразделение - СправочникСсылка.Подразделения
//	БлокироватьДанные - Булево - признак необходимости блокировки данных в начале формирования проводок.
//
// Возвращаемое значение:
//	Булево - Истина - если материалов достаточно для проведения документа, 
//			Ложь - если материалов недостаточно или не смогли установить блокировку
//
Функция КоличествоНоменклатурыДостаточноДляСписания(ДокументСсылка,
													Знач ИФО = Неопределено,
													Знач КФО = Неопределено,
													Знач КПС = Неопределено,
													Знач ЦМО = Неопределено,
													Знач Подразделение = Неопределено,
													БлокироватьДанные = Ложь) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ИФО) Тогда
		ИФО = Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(КФО) Тогда
		КФО = Перечисления.КВД.ПустаяСсылка();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(КПС) Тогда
		КПС = Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ЦМО) Тогда
		ЦМО = Справочники.ЦМО.ПустаяСсылка();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Подразделение) Тогда
		Подразделение = Справочники.Подразделения.ПустаяСсылка();
	КонецЕсли;
	
	ИмяТЧ = "МатериальныеЗапасы";
	КолонкаМатериал = "Номенклатура";
	КолонкаКоличество = "Количество";
	ИмяТЧВозвратнаяТара = Неопределено;
	
	// Для всех типов документов необходимо прописать имена используемых реквизитов и ТЧ.
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.АктСписанияМЗ") Тогда
		ИмяТЧ = "Материалы";
		КолонкаМатериал = "Номенклатура";
		КолонкаКоличество = "Количество";
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.АктСписанияМягкогоИХозИнвентаря") Тогда
		ИмяТЧ = "Материалы";
		КолонкаМатериал = "Номенклатура";
		КолонкаКоличество = "Количество";
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ТребованиеНакладная0315006") Тогда
		ИмяТЧ = "Материалы";
		КолонкаМатериал = "Номенклатура";
		КолонкаКоличество = "Количество";
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.НакладнаяНаОтпускМ15") Тогда
		ИмяТЧ = "Материалы";
		КолонкаМатериал = "Номенклатура";
		КолонкаКоличество = "Количество";
		ИмяТЧВозвратнаяТара = "ВозвратнаяТара";
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12") Тогда
		ИмяТЧ = "Номенклатура";
		КолонкаМатериал = "Номенклатура";
		КолонкаКоличество = "Количество";
		ИмяТЧВозвратнаяТара = "ВозвратнаяТара";
	КонецЕсли;
	ИспПодразделение = ?(ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"), Подразделение, Неопределено);
	СтруктураПараметров = Новый Структура("Период, ИмяТЧ, КолонкаМатериал, КолонкаКоличество, ЦМО, КФО, КПС, ИФО, Подразделение, ИмяТЧВозвратнаяТара",
											ДокументСсылка.Дата,
											ИмяТЧ,
											КолонкаМатериал,
											КолонкаКоличество,
											ЦМО,
											КФО,
											КПС,
											ИФО,
											ИспПодразделение,
											ИмяТЧВозвратнаяТара);
									
	
	ТаблицаМатериалов = БухгалтерскиеОперацииПовтИсп.ПолучитьОстаткиМатериалов(ДокументСсылка, СтруктураПараметров);
	
	Если ТаблицаМатериалов.Итог("Нехватка") = 0 Тогда
		
		Если БлокироватьДанные Тогда																				
			СтруктураПараметров = Новый Структура("ТипТаблицы, ИмяТаблицы, ИсточникДанных",
													"РегистрБухгалтерии", "ЖурналПроводокЕПСБУ", ТаблицаМатериалов);
				
			ЗначенияБлокировки = Новый Соответствие;
			ЗначенияБлокировки.Вставить("Период", ДокументСсылка.Дата);
			ЗначенияБлокировки.Вставить("Организация", ДокументСсылка.Организация);
			ЗначенияБлокировки.Вставить("КФО", КФО);
			ЗначенияБлокировки.Вставить("ИФО", ИФО);
			ОписаниеИсточника = Новый Соответствие;
			ОписаниеИсточника.Вставить("КПС", "КПС");
			ОписаниеИсточника.Вставить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура, "Номенклатура");
			ОписаниеИсточника.Вставить("Счет", "Счет");
			Отказ = Ложь;
			ОбщегоНазначенияБГУ.УстановитьУправляемуюБлокировку(СтруктураПараметров, ЗначенияБлокировки, ОписаниеИсточника, Отказ);
			Если Отказ Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
		
		Возврат Истина;
		
	Иначе // Каких-то материалов не хватает.
		
		Для каждого ТекСтрМатериал Из ТаблицаМатериалов Цикл
		
			Если ТекСтрМатериал.Нехватка > 0 Тогда
				
				ТекстОшибки = НСтр("ru='Указанное количество превышает остаток по счету %2.%3.%4 и ЦМО ""%1"".
					|Остаток: %5; Не хватает: %6'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
					Строка(ЦМО),
					Строка(КПС),
					Строка(КФО),
					Строка(ТекСтрМатериал.НоменклатураСчетУчета),
					ТекСтрМатериал.КоличествоМОЛ,
					ТекСтрМатериал.КоличествоДокумента - ТекСтрМатериал.КоличествоМОЛ);
					
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Некорректно заполнена колонка ""%1"" списка ""%2"" по номенклатуре ""%3"".
					|
					|%4'"), НСтр("ru = 'Количество'"), ИмяТЧ, Строка(ТекСтрМатериал.НоменклатураДокумента), ТекстОшибки);
					
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументСсылка, ИмяТЧ, "Объект");
				
			КонецЕсли;
		
		КонецЦикла;
		
		Возврат Ложь;
		
	КонецЕсли;
	
КонецФункции

// Устарела. Проверяет наличие остатков необходимого количества материалов.
// Список материалов берется из табличной части указанного документа списания.
// Если количество материалов достаточно для проведения документа,
// то при установке флага БлокироватьДанные устанавливается управляемая блокировка.
//
// Функция используется при проверке условия формирования операции.
//
// Параметры:
//	ДокументСписанияСсылка	- ссылка на документ списания, содержащий табличную часть
//							с номенклатурой и ее количеством;
//	Счет
//	ИФО
//	КФО
//	КПС
// 	ЦМО
//	Подразделение
//	БлокироватьДанные	- признак необходимости блокировки данных в начале формирования проводок.
//						(булево)
//
// Возврат:
//	Булево	- Истина - если материалов достаточно для проведения документа, 
//			Ложь - если материалов недостаточно или не смогли установить блокировку
//
Функция КоличествоНоменклатурыДостаточноДляСписанияЗабаланс(ДокументСписанияСсылка,
															Счет,
															Знач ИФО = Неопределено,
															Знач КФО = Неопределено,
															Знач КПС = Неопределено,
															Знач ЦМО = Неопределено,
															Знач Подразделение = Неопределено,
															БлокироватьДанные = Ложь) Экспорт
	
	СтруктураПараметров = Новый Структура("
		|ДатаОстатков,
		|Счет,
		|ЦМО,
		|Подразделение,
		|ИФО,
		|КФО,
		|КПС",
		ДокументСписанияСсылка["Дата"],
		Счет,
		ЦМО,
		Подразделение,
		ИФО,
		КФО,
		КПС);
		
	//Если ТипЗнч(ДокументСписанияСсылка) = Тип("ДокументСсылка.АктСписанияМЗ") Тогда
		ИмяТаблЧастиМатериалы	= "Материалы";
		ИмяКолонкиНоменклатура	= "Номенклатура";
		СтруктураПараметров.Вставить("ИмяТаблЧастиМатериалы",	ИмяТаблЧастиМатериалы);
		СтруктураПараметров.Вставить("ИмяКолонкиНоменклатура",	ИмяКолонкиНоменклатура);
		СтруктураПараметров.Вставить("ИмяКолонкиКоличество",	"Количество");
	//КонецЕсли;
	
	НехваткаИОстатки = БухгалтерскиеОперацииПовтИсп.ПолучитьОстаткиМатериаловЗабаланс(ДокументСписанияСсылка, СтруктураПараметров);
	ДЗНехватка = НехваткаИОстатки["Нехватка"];
	
	Если ДЗНехватка.Строки.Количество() = 0 Тогда
		
		Если БлокироватьДанные Тогда
			ТаблицаМатериалов = НехваткаИОстатки["Остатки"];
			ТаблицаМатериалов.Колонки.Добавить("КПС",	Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
			ТаблицаМатериалов.Колонки.Добавить("Счет",	Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
			ТаблицаМатериалов.ЗаполнитьЗначения(КПС,	"КПС");
			ТаблицаМатериалов.ЗаполнитьЗначения(Счет,	"Счет");
			
			СтруктураПараметров = Новый Структура("ТипТаблицы, ИмяТаблицы, ИсточникДанных",
				"РегистрБухгалтерии",
				"ЖурналПроводокЕПСБУ",
				ТаблицаМатериалов);
			
			ЗначенияБлокировки = Новый Соответствие;
			ЗначенияБлокировки.Вставить("Период",		ДокументСписанияСсылка["Дата"]);
			ЗначенияБлокировки.Вставить("Организация",	ДокументСписанияСсылка["Организация"]);
			ЗначенияБлокировки.Вставить("КФО", КФО);
			ЗначенияБлокировки.Вставить("ИФО", ИФО);
			ОписаниеИсточника = Новый Соответствие;
			ОписаниеИсточника.Вставить("КПС", "КПС");
			ОписаниеИсточника.Вставить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура, "Номенклатура");
			ОписаниеИсточника.Вставить("Счет", "Счет");
			Отказ = Ложь;
			ОбщегоНазначенияБГУ.УстановитьУправляемуюБлокировку(СтруктураПараметров, ЗначенияБлокировки, ОписаниеИсточника, Отказ);
			Если Отказ Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
		
		Возврат Истина;
		
	Иначе // Каких-то материалов не хватает.
		
		СчетПредставление = ?(ЗначениеЗаполнено(КПС), Строка(КПС) + ".", "")
			+ ?(ЗначениеЗаполнено(КФО), КФО, "0") + "." + Счет;
		
		Для Каждого СтрокаИтого Из ДЗНехватка.Строки Цикл
			
			НомераСтрок = СтрокаИтого.Строки.ВыгрузитьКолонку("НомерСтроки");
			
			ИндексСтроки = НомераСтрок[0] - 1;
			ОднаСтрока = (НомераСтрок.Количество() = 1);
			
			НомераСтрокПредставление = ?(ОднаСтрока,
				НомераСтрок[0],
				СтрСоединить(НомераСтрок, ", "));
			НехваткаПредставление = Формат(СтрокаИтого["КоличествоНехватка"], "ЧГ=")
				+ ?(ЗначениеЗаполнено(СтрокаИтого["ЕдИзм"]),
					Символы.НПП + СтрокаИтого["ЕдИзм"],
					"");
			
			ТекстОшибки = НСтр("ru='Указанное количество превышает остаток по счету %1.
				|Не хватает: %2'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
				СчетПредставление,
				НехваткаПредставление);
				
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Некорректно заполнена колонка ""%1"" "+?(ОднаСтрока,"в строке","в строках")+" %2 списка ""%3"" по номенклатуре ""%4"".
				|
				|%5'"), НСтр("ru = 'Количество'"), НомераСтрокПредставление, ИмяТаблЧастиМатериалы, Строка(СтрокаИтого.Номенклатура), ТекстОшибки);
				
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументСписанияСсылка, ИмяТаблЧастиМатериалы+"["+ИндексСтроки+"].Количество", "Объект");
			
		КонецЦикла;
		
		Возврат Ложь;
		
	КонецЕсли;
	
КонецФункции

// Устарела. Функция расчитывает сумму проводки по списанию или перемещению материала. 
//
// Параметры:
//	ДокументСсылка - ссылка на документ
//	НомерСтроки	- Число - номер текущей строки документа
//	Номенклатура - СправочникСсылка.Номенклатура
//	ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения
//	КФО - ПеречислениеСсылка.КВД
//	КПС - СправочникСсылка.КлассификационныеПризнакиСчетов
// 	ЦМО - СправочникСсыкла.ЦМО
//	Подразделение - СправочникСсылка.Подразделения
//	Количество - Число - количество списания в текущей строке
// 
// Возвращаемое значение:
//	Число - Сумма текущей проводки
//
Функция ВычислитьСуммуПоРасчитаннойСреднейЦенеМЗ(ДокументСсылка,
												НомерСтроки,
												Номенклатура,
												ИФО = Неопределено,
												КФО = Неопределено,
												КПС = Неопределено,
												ЦМО = Неопределено,
												Подразделение = Неопределено,
												Количество,
												ИмяТЧ="") Экспорт

	Если НЕ ЗначениеЗаполнено(ИФО) Тогда
		ИФО = Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(КФО) Тогда
		КФО = Перечисления.КВД.ПустаяСсылка();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(КПС) Тогда
		КПС = Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ЦМО) Тогда
		ЦМО = Справочники.ЦМО.ПустаяСсылка();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Подразделение) Тогда
		Подразделение = Справочники.Подразделения.ПустаяСсылка();
	КонецЕсли;
	
	КолонкаМатериал = "Номенклатура";
	КолонкаКоличество = "Количество";
	//Если ИмяТЧ = "" Тогда
		ИмяТЧ = "МатериальныеЗапасы";
		ИмяТЧВозвратнаяТара = Неопределено;
		// Для всех типов документов необходимо прописать имена используемых реквизитов и ТЧ.
		
		Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.АктСписанияМЗ") Тогда
			ИмяТЧ = "Материалы";
			КолонкаМатериал = "Номенклатура";
			КолонкаКоличество = "Количество";
		ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.АктСписанияМягкогоИХозИнвентаря") Тогда
			ИмяТЧ = "Материалы";
			КолонкаМатериал = "Номенклатура";
			КолонкаКоличество = "Количество";
		ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ТребованиеНакладная0315006") Тогда
			ИмяТЧ = "Материалы";
			КолонкаМатериал = "Номенклатура";
			КолонкаКоличество = "Количество";
		ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.НакладнаяНаОтпускМ15") Тогда
			ИмяТЧ = "Материалы";
			КолонкаМатериал = "Номенклатура";
			КолонкаКоличество = "Количество";
			ИмяТЧВозвратнаяТара = "ВозвратнаяТара";
		ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12") Тогда
			ИмяТЧ = "Номенклатура";
			КолонкаМатериал = "Номенклатура";
			КолонкаКоличество = "Количество";
			ИмяТЧВозвратнаяТара = "ВозвратнаяТара";
		КонецЕсли;
	//КонецЕсли;
		
	ИспПодразделение = ?(ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"), Подразделение, Неопределено);
	СтруктураПараметров = Новый Структура("Период, ИмяТЧ, КолонкаМатериал, КолонкаКоличество, ЦМО, КФО, КПС, ИФО, Подразделение, ИмяТЧВозвратнаяТара",
											ДокументСсылка.Дата,
											ИмяТЧ,
											КолонкаМатериал,
											КолонкаКоличество,
											ЦМО,
											КФО,
											КПС,
											ИФО,
											ИспПодразделение,
											ИмяТЧВозвратнаяТара);
	
	ТаблицаМатериалов = БухгалтерскиеОперацииПовтИсп.ПолучитьОстаткиМатериалов(ДокументСсылка,СтруктураПараметров);
																				//ДокументСсылка.Дата,
																				//ИмяТЧ,
																				//КолонкаМатериал,
																				//КолонкаКоличество,
																				//ЦМО,
																				//КФО,
																				//КПС,
																				//ИФО,
																				//ИспПодразделение);
	СтрокаНоменклатура = ТаблицаМатериалов.Найти(Номенклатура, "Номенклатура");
	Если СтрокаНоменклатура = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	
	Если Количество = СтрокаНоменклатура.КоличествоОстаток Тогда
		СуммаПроводки = СтрокаНоменклатура.СуммаОстаток;
	ИначеЕсли СтрокаНоменклатура.КоличествоОстаток = СтрокаНоменклатура.КоличествоДокумента Тогда
		Цена = СтрокаНоменклатура.СуммаОстаток / СтрокаНоменклатура.КоличествоОстаток;
		СуммаПроводки = Окр(Цена * Количество, 2);
		Если Цена <> Окр(Цена, 2) Тогда
			// если документом списывается все доступное количество материала, несколькими строчками документа
			// и есть округление цены, то необходимо в последней строке сделать корректировку суммы, чтоб списать
			// всю стоимость
			Отбор = Новый Структура("Номенклатура", Номенклатура);
			МассивСтрокДокумента = ДокументСсылка[ИмяТЧ].НайтиСтроки(Отбор);
			ЭтоПоследняяСтрока = Истина;
			РаспределилиСумму = 0;
			Для Каждого ТекСтрокаДокумента Из МассивСтрокДокумента Цикл
				
				Если ТекСтрокаДокумента.НомерСтроки > НомерСтроки Тогда
					ЭтоПоследняяСтрока = Ложь;
					Прервать;
				ИначеЕсли ТекСтрокаДокумента.НомерСтроки <> НомерСтроки Тогда
					РаспределилиСумму = РаспределилиСумму + Окр(Цена * ТекСтрокаДокумента.Количество, 2);	
				КонецЕсли;
				
			КонецЦикла;
			
			Если ЭтоПоследняяСтрока Тогда
				
				СуммаПроводки = СтрокаНоменклатура.СуммаОстаток - РаспределилиСумму;		
								
			КонецЕсли;
			
		КонецЕсли;
	ИначеЕсли СтрокаНоменклатура.КоличествоОстаток = 0 Тогда
		СуммаПроводки = 0;
	Иначе
		Цена = СтрокаНоменклатура.СуммаОстаток / СтрокаНоменклатура.КоличествоОстаток;
		СуммаПроводки = Окр(Цена * Количество, 2);
	КонецЕсли;
	
	Возврат СуммаПроводки;
    
КонецФункции // ПолучитьСуммуПроводкиПоМЗ()

// Устарела. Рассчитывает сумму проводки по списанию или перемещению материала с указанного счета. 
//
// Параметры:
//	ДокументСписанияСсылка	- ссылка на документ списания, содержащий табличную часть
//							с номенклатурой и ее количеством;
//	НомерСтроки	- номер текущей строки в табл.части "Материалы" документа,
//				для которой здесь рассчитывается величина суммы проводки;
//	Счет
//	ИФО
//	КФО
//	КПС
//	ЦМО
//	Подразделение
//
// Возврат:
//	Число	- сумма проводки для текущей строки, рассчитывается как Цена*Количество.
Функция ВычислитьСуммуПоРасчитаннойСреднейЦенеМЗЗабаланс(ДокументСписанияСсылка,
												НомерСтроки,
												Счет,
												ИФО = Неопределено,
												КФО = Неопределено,
												КПС = Неопределено,
												ЦМО = Неопределено,
												Подразделение = Неопределено) Экспорт
	// Возвращаемое значение:
	СуммаПроводки = 0;
	
	СтруктураПараметров = Новый Структура("
		|ДатаОстатков,
		|Счет,
		|ЦМО,
		|Подразделение,
		|ИФО,
		|КФО,
		|КПС",
		ДокументСписанияСсылка["Дата"],
		Счет,
		ЦМО,
		Подразделение,
		ИФО,
		КФО,
		КПС);
		
	//Если ТипЗнч(ДокументСписанияСсылка) = Тип("ДокументСсылка.АктСписанияМЗ") Тогда
		ИмяТаблЧастиМатериалы	= "Материалы";
		ИмяКолонкиНоменклатура	= "Номенклатура";
		ИмяКолонкиКоличество	= "Количество";
		СтруктураПараметров.Вставить("ИмяТаблЧастиМатериалы",	ИмяТаблЧастиМатериалы);
		СтруктураПараметров.Вставить("ИмяКолонкиНоменклатура",	ИмяКолонкиНоменклатура);
		СтруктураПараметров.Вставить("ИмяКолонкиКоличество",	ИмяКолонкиКоличество);
	//КонецЕсли;
	
	// Текущие остатки номенклатуры:
	НехваткаИОстатки = БухгалтерскиеОперацииПовтИсп.ПолучитьОстаткиМатериаловЗабаланс(ДокументСписанияСсылка, СтруктураПараметров);
	ТЗОстатки = НехваткаИОстатки["Остатки"];
	
	// Текущая строка таблицы документа:
	ТекСтрокаДокумента	= ДокументСписанияСсылка[ИмяТаблЧастиМатериалы][НомерСтроки - 1];
	ТекНоменклатура		= ТекСтрокаДокумента[ИмяКолонкиНоменклатура];
	ТекКоличество		= ТекСтрокаДокумента[ИмяКолонкиКоличество];
	
	// Величина остатка текущей номенклатуры:
	СтрокаОстаток		= ТЗОстатки.Найти(ТекНоменклатура, "Номенклатура");
	СуммаОстаток		= СтрокаОстаток["СуммаОстаток"];
	КоличествоОстаток	= СтрокаОстаток["КоличествоОстаток"];
	Цена = ?(КоличествоОстаток = 0,
		0,
		СуммаОстаток / КоличествоОстаток);
	
	Поиск = Новый Структура(ИмяКолонкиНоменклатура, ТекНоменклатура);
	МассивСтрокДокумента = ДокументСписанияСсылка[ИмяТаблЧастиМатериалы].НайтиСтроки(Поиск);
	КолвоСтрокДокумента = МассивСтрокДокумента.Количество();
	Если КолвоСтрокДокумента = 1 Тогда
		Если ТекКоличество = КоличествоОстаток Тогда
			СуммаПроводки = Окр(СуммаОстаток, 2);
		Иначе
			СуммаПроводки = Окр(ТекКоличество * Цена, 2);
		КонецЕсли;
		
	Иначе
		// Если документом списывается все доступное количество материала
		// несколькими строчками документа, то может получиться округление цены,
		// и необходимо в последней строке сделать корректировку суммы,
		// чтобы списать всю стоимость.
		
		ВремТЗ = ДокументСписанияСсылка[ИмяТаблЧастиМатериалы].Выгрузить(МассивСтрокДокумента, "НомерСтроки," + ИмяКолонкиКоличество);
		ВремТЗ.Сортировать("НомерСтроки УБЫВ");
		НомерПоследнейСтроки = ВремТЗ[0]["НомерСтроки"];
		
		КорректироватьСумму = (ВремТЗ.Итог(ИмяКолонкиКоличество) = КоличествоОстаток)
			И НомерСтроки = НомерПоследнейСтроки;
			
		Если КорректироватьСумму Тогда
			// Итог сумм предыдущих проводок по текущей номенклатуре:
			ИтогСуммПроводок = 0;
			Для ИндексСтроки = 1 По КолвоСтрокДокумента-1 Цикл // начиная с 1; 0 пропускаем.
				ИтогСуммПроводок = ИтогСуммПроводок + Окр(Цена * ВремТЗ[ИндексСтроки][ИмяКолонкиКоличество], 2);
			КонецЦикла;
			// Сумма этой (последней) проводки по текущей номенклатуре:
			СуммаПроводки = Окр(СуммаОстаток - ИтогСуммПроводок, 2);
			
		Иначе
			СуммаПроводки = Окр(ТекКоличество * Цена, 2);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СуммаПроводки;
	
КонецФункции

// Устарела.
Функция ПодготовитсяКСписаниюМЗЗабаланс(ДокументСсылка, УстанавливатьБлокировку = Ложь) Экспорт

	Если ДокументСсылка.Пустая() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Параметры = БухгалтерскиеОперацииПовтИсп.ПараметрыСписанияМЗ(ДокументСсылка);
	ТаблицаОстатков = БухгалтерскиеОперацииПовтИсп.ТаблицаМЗДляСписанияЗабаланс(Параметры);
	
	СтрокиСНехваткой = ТаблицаОстатков.НайтиСтроки(Новый Структура("Нехватка", Истина));
	Если СтрокиСНехваткой.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	ТекстСообщенияОбОшибке = НСтр("ru = 'По ""%1"" в остатках %2 из необходимых %3 %4. (Строка: %5)'");
	
	Для каждого ТекСтрокаСНехваткой Из СтрокиСНехваткой Цикл
		
		СтрокиТекущейНоменклатуры = ТаблицаОстатков.НайтиСтроки(Новый Структура("Номенклатура, ДополнительнаяАналитикаСчета",
																				ТекСтрокаСНехваткой.Номенклатура,
																				ТекСтрокаСНехваткой.ДополнительнаяАналитикаСчета));
		Если СтрокиТекущейНоменклатуры.Количество() = 1 Тогда
			НомераСтрок = СтрокиТекущейНоменклатуры[0].НомерСтроки;
			ПолеОбъекта = "Объект.Материалы[" + (СтрокиТекущейНоменклатуры[0].НомерСтроки - 1) + "].Номенклатура";
		Иначе
			НомераСтрок = "";
			Для каждого СтрокаНоменклатуры Из СтрокиТекущейНоменклатуры Цикл
				НомераСтрок = НомераСтрок + "," + СтрокаНоменклатуры.НомерСтроки;
			КонецЦикла;
			НомераСтрок = Сред(НомераСтрок, 2);
			ПолеОбъекта = "";
		КонецЕсли;
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
														ТекстСообщенияОбОшибке,
														ТекСтрокаСНехваткой.ПредставлениеНоменклатуры,
														Формат(ТекСтрокаСНехваткой.КоличествоОстаток, "ЧДЦ=3"),
														Формат(ТекСтрокаСНехваткой.КоличествоПоДокументуВсего, "ЧДЦ=3"),
														ТекСтрокаСНехваткой.ПредставлениеЕдиницыИзмерения,
														НомераСтрок);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
										                  ДокументСсылка,
														  ПолеОбъекта);
	
	КонецЦикла;
	
	Возврат Ложь;

КонецФункции // ПодготовитсяКСписаниюМЗЗабаланс()

// Устарела.
Функция РеквизитСписанияМЗЗабаланс(ИмяРеквизита, ДокументСсылка, НомерСтроки = 0) Экспорт
	
	Параметры = БухгалтерскиеОперацииПовтИсп.ПараметрыСписанияМЗ(ДокументСсылка);
	ТаблицаОстатков = БухгалтерскиеОперацииПовтИсп.ТаблицаМЗДляСписанияЗабаланс(Параметры);
	
	СтрокаТаблицы = ТаблицаОстатков.Найти(НомерСтроки, "НомерСтроки");
	Возврат ПолучитьЗначениеРеквизитаСтроки(СтрокаТаблицы, ИмяРеквизита);
	
КонецФункции

// Устарела.
Функция ПолучитьСуммуСписанияМЗвНУ(ДокументСсылка, НомерСтроки, ИмяСписка="") Экспорт
	
	Если НЕ ЗначениеЗаполнено(ИмяСписка) Тогда
		Возврат ПолучитьРеквизитСписанияНоменклатуры("Сумма", ДокументСсылка, НомерСтроки, , "НУ");
	Иначе
		Возврат ПолучитьРеквизитСписанияНоменклатуры("Сумма", ДокументСсылка, НомерСтроки, ИмяСписка, "НУ");
	КонецЕсли;
	
КонецФункции

// Устарела.
Функция ПолучитьПолнуюСтоимостьСписанияНоменклатуры(ДокументСсылка, НомерСтроки, ИмяСписка="Материалы", ВидУчета="БУ") Экспорт

	Возврат ПолучитьРеквизитСписанияНоменклатуры("Сумма",                ДокументСсылка, НомерСтроки, ИмяСписка, ВидУчета)
	      + ПолучитьРеквизитСписанияНоменклатуры("СуммаНеУчитываетсяНУ", ДокументСсылка, НомерСтроки, ИмяСписка, ВидУчета)
	      + ПолучитьРеквизитСписанияНоменклатуры("СуммаЕНВД",            ДокументСсылка, НомерСтроки, ИмяСписка, ВидУчета);

КонецФункции

// Устарела.
Функция РассчитатьСтоимостьВложенияВНФА(ДокументСсылка) Экспорт
	
	СтоимостьНФА = БухгалтерскиеОперацииПовтИсп.РассчитатьСтоимостьВложенияВНФА(ДокументСсылка);	
	
	Возврат СтоимостьНФА<>Неопределено;
	
КонецФункции

// Устарела.
Функция ВычислитьСуммуПоРассчитаннойСтоимостиВложенийВНФА(ДокументСсылка, НомерСтроки) Экспорт
	
	СтоимостьНФА = БухгалтерскиеОперацииПовтИсп.РассчитатьСтоимостьВложенияВНФА(ДокументСсылка);	
	
	Если СтоимостьНФА = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПринятиеКУчетуОС") Тогда
		Если ДокументСсылка.ОсновныеСредства.Итог("Количество") = СтоимостьНФА.Количество Тогда
			Если НомерСтроки = ДокументСсылка.ОсновныеСредства.Количество() Тогда
				Возврат СтоимостьНФА.Сумма - (ДокументСсылка.ОсновныеСредства.Итог("Количество")-ДокументСсылка.ОсновныеСредства[НомерСтроки-1].Количество)*ДокументСсылка.ПервоначальнаяСтоимость;
			КонецЕсли;
		КонецЕсли;
		Возврат ДокументСсылка.ОсновныеСредства[НомерСтроки-1].Количество * ДокументСсылка.ПервоначальнаяСтоимость;
	КонецЕсли;
	
	Возврат 0;
КонецФункции

// Устарела.
Функция ПолучитьРеквизитЗачетаАвансаПолученного(Сумма,
												Дата, 
												Организация, 
												ИФО, 
												КФО,
												КПС, 
												Подразделение, 
												Контрагент, 
												Договор, 
												СчетРасчетов, 
												ИмяРеквизита, 
												Знач НомерСтроки=0) Экспорт
	Если НомерСтроки = NULL Тогда
		НомерСтроки = 0;
	КонецЕсли;
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();	
	
	СохраненныеДанные = КонтекстПроведения.ТаблицаАвансов;
	
	Если СохраненныеДанные = Неопределено Тогда
		СохраненныеДанные = Новый ТаблицаЗначений;
		СохраненныеДанные.Колонки.Добавить("СчетРасчетов",			Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
		СохраненныеДанные.Колонки.Добавить("СчетАванса",			Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
		СохраненныеДанные.Колонки.Добавить("КФО", 					Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
		СохраненныеДанные.Колонки.Добавить("КПС", 					Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
		СохраненныеДанные.Колонки.Добавить("СуммаАванса",			Новый ОписаниеТипов("Число"));
		СохраненныеДанные.Колонки.Добавить("НомерСтроки",			Новый ОписаниеТипов("Число"));
		// данные сохраняем по каждому контрагенту, на случай, если в документе много контрагентов
		СохраненныеДанные.Колонки.Добавить("Контрагент",			Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
		СохраненныеДанные.Колонки.Добавить("Договор",				Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	КонецЕсли;
	
	СохраненныйАванс = СохраненныеДанные.Найти(НомерСтроки, "НомерСтроки");
	Если СохраненныйАванс<>Неопределено И ИмяРеквизита <> "КурсоваяРазница" Тогда
		Возврат СохраненныйАванс[ИмяРеквизита];
	КонецЕсли;
	
	Авансы = БухгалтерскиеОперацииПовтИсп.ТаблицаСуммаАвансовПолученныхПолная(КонтекстПроведения.Ссылка,
																			  Дата, 
																			  Организация, 
																			  ИФО, 
																			  Неопределено, 
																			  Неопределено, 
																			  Подразделение, 
																			  Контрагент, 
																			  Договор);
	
	Если СчетРасчетов = Неопределено Тогда
		СтруктураПоиска = Новый Структура("КФО, КПС", КФО, КПС);
	Иначе
		СтруктураПоиска = Новый Структура("СчетРасчетов, КФО, КПС", СчетРасчетов, КФО, КПС);
	КонецЕсли;
	
	НайденныеАвансы = Авансы.НайтиСтроки(СтруктураПоиска);
	Если НайденныеАвансы.Количество() = 0 Тогда
		// авансы не обнаружены
		Возврат 0;
	КонецЕсли;
	ТекущийАванс = НайденныеАвансы[0];
	
	Если ВРег(ИмяРеквизита) = Врег("КурсоваяРазница") Тогда
		Отбор = Новый Структура("Валюта", ТекущийАванс.Валюта);
		
		ТекущийКурс = РегистрыСведений.КурсыВалют.СрезПоследних(Дата, Отбор);
		
		Если ТекущийКурс.Количество() > 0 Тогда
			Курс = ТекущийКурс[0].Курс;
			Кратность = ТекущийКурс[0].Кратность;
		Иначе
			Курс = 1;
			Кратность = 1;
		КонецЕсли;
		
		Возврат ТекущийАванс.ВалютнаяСуммаАванса * Курс / Кратность - ТекущийАванс.РублеваяСуммаАванса;
	КонецЕсли;
	
	СтруктураПоиска = Новый Структура("СчетАванса, КФО, КПС", ТекущийАванс.СчетАванса, КФО, КПС);
	СтруктураПоиска.Вставить("Контрагент", Контрагент);
	СтруктураПоиска.Вставить("Договор", Договор);
	ЗачтенныйАванс = СохраненныеДанные.Скопировать(СтруктураПоиска, "СчетАванса, КФО, КПС, СуммаАванса")
									  .Итог("СуммаАванса");
	
	СуммаЗачета = Мин(Макс(ТекущийАванс.ОстатокАванса - ЗачтенныйАванс, 0), Сумма);
	Если СуммаЗачета = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	СохраненныйАванс = СохраненныеДанные.Добавить();
	ЗаполнитьЗначенияСвойств(СохраненныйАванс, ТекущийАванс, "СчетРасчетов, СчетАванса, КФО, КПС");
	СохраненныйАванс.НомерСтроки = НомерСтроки;
	СохраненныйАванс.СуммаАванса = СуммаЗачета;
	СохраненныйАванс.Контрагент = Контрагент;
	СохраненныйАванс.Договор = Договор;
	
	КонтекстПроведения.ТаблицаАвансов = СохраненныеДанные;
	
	Результат = СохраненныйАванс[ИмяРеквизита];
	
	Если ИмяРеквизита = "СчетАванса" И НЕ ЗначениеЗаполнено(Результат) Тогда
		
		СтрокаОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
													НСтр("ru = 'Для счета %1 не определен счет авансов'"),
													Строка(СчетРасчетов));
		ДобавитьОшибкуВКонтекстПроведения(СтрокаОшибки, "ПолучитьРеквизитЗачетаАвансаПолученного", КонтекстПроведения);
		
	КонецЕсли;
	
	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	
	Возврат Результат;
	
КонецФункции

// Устарела.
Функция ПолучитьРеквизитЗачетаАвансаВыданного(	Сумма,
												Дата,
												Организация, 
												ИФО, 
												КФО, 
												КПС, 
												Подразделение, 
												Контрагент, 
												Договор, 
												СчетРасчетов, 
												ИмяРеквизита, 
												Знач НомерСтроки=0) Экспорт
												
	Если НомерСтроки = NULL Тогда
		НомерСтроки = 0;
	КонецЕсли;
												
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();	
	
	СохраненныеДанные = КонтекстПроведения.ТаблицаАвансов;
	Если СохраненныеДанные = Неопределено Тогда
		СохраненныеДанные = Новый ТаблицаЗначений;
		СохраненныеДанные.Колонки.Добавить("СчетРасчетов",	Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
		СохраненныеДанные.Колонки.Добавить("СчетАванса",	Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
		СохраненныеДанные.Колонки.Добавить("КФО", 			Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
		СохраненныеДанные.Колонки.Добавить("КПС", 			Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
		СохраненныеДанные.Колонки.Добавить("СуммаАванса",	Новый ОписаниеТипов("Число"));
		СохраненныеДанные.Колонки.Добавить("НомерСтроки",	Новый ОписаниеТипов("Число"));
	КонецЕсли;												
	
	СохраненныеАвансы = СохраненныеДанные.НайтиСтроки(Новый Структура("СчетРасчетов, КФО, КПС, НомерСтроки",
																	   СчетРасчетов, КФО, КПС, НомерСтроки));
	Если СохраненныеАвансы.Количество() = 1 Тогда
		Возврат СохраненныеАвансы[0][ИмяРеквизита];
	КонецЕсли;

	Авансы = БухгалтерскиеОперацииПовтИсп.ТаблицаСуммАвансовВыданныхПолная(	КонтекстПроведения.Ссылка,
																			Дата,
																			Организация,
																			ИФО,
																			Неопределено,
																			Неопределено,
																			Подразделение,
																			Контрагент,
																			Договор);
																	
	Если СчетРасчетов = Неопределено Тогда
		СтрокиАванса = Авансы.НайтиСтроки(Новый Структура("КФО, КПС", КФО, КПС));
	Иначе
        СтрокиАванса = Авансы.НайтиСтроки(Новый Структура("СчетРасчетов, КФО, КПС", СчетРасчетов, КФО, КПС));
	КонецЕсли;
	
	Если СтрокиАванса.Количество()=0 Тогда
		// авансов нет
		Возврат 0;
	КонецЕсли;
	
	СтрокаАванса = СтрокиАванса[0];
	
	Если ВРег(ИмяРеквизита) = Врег("КурсоваяРазница") Тогда
		Отбор = Новый Структура("Валюта", СтрокаАванса.Валюта);
		
		ТекущийКурс = РегистрыСведений.КурсыВалют.СрезПоследних(Дата, Отбор);
		
		Если ТекущийКурс.Количество() > 0 Тогда
			Курс = ТекущийКурс[0].Курс;
			Кратность = ТекущийКурс[0].Кратность;
		Иначе
			Курс = 1;
			Кратность = 1;
		КонецЕсли;
		
		Возврат СтрокаАванса.ВалютнаяСуммаАванса * Курс / Кратность - СтрокаАванса.РублеваяСуммаАванса;
	КонецЕсли;	
	
	Если ВРЕГ(ИмяРеквизита) = ВРЕГ("СчетАванса") Тогда
		Возврат СтрокаАванса.СчетАванса;
	КонецЕсли;
	
	СохраненныеАвансы = СохраненныеДанные.Скопировать(Новый Структура("СчетРасчетов, КФО, КПС",
																	   СчетРасчетов, КФО, КПС));
	
	СуммаАванса = Мин(Макс(СтрокаАванса.СуммаАванса-СохраненныеАвансы.Итог("СуммаАванса"), 0), Сумма);
	
	СохраненныйАванс = СохраненныеДанные.Добавить();
	ЗаполнитьЗначенияСвойств(СохраненныйАванс, СтрокаАванса, "СчетРасчетов, КФО, КПС, СчетАванса");
	СохраненныйАванс.НомерСтроки = НомерСтроки;
    СохраненныйАванс.СуммаАванса = СуммаАванса;
	
	КонтекстПроведения.ТаблицаАвансов = СохраненныеДанные;
	
	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	
	Если СуммаАванса = 0 Тогда
		// аванс уже распределен полностью
		Возврат 0;
	КонецЕсли;
	
	Возврат СохраненныйАванс[ИмяРеквизита];
	
КонецФункции												

// Устарела.
Функция РеквизитЗачетаАвансаВыданного(	Сумма,
										Дата,
										Организация, 
										ИФО, 
										КФО, 
										КПС = Неопределено, 
										Подразделение, 
										Контрагент, 
										Договор, 
										СчетРасчетов, 
										ИмяРеквизита, 
										Знач Итератор = 0,
										Знач НомерСтроки=0,
										Знач ИмяТЧ = "") Экспорт
												
	Перем ОстатокПоТекущейСтроке;											
												
	Если НомерСтроки = NULL Тогда
		НомерСтроки = 0;
	КонецЕсли;
												
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	
	СохраненныеДанные = КонтекстПроведения.ТаблицаАвансов;
	Если СохраненныеДанные = Неопределено Тогда
		СохраненныеДанные = Новый ТаблицаЗначений;
		СохраненныеДанные.Колонки.Добавить("СчетРасчетов",	Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
		СохраненныеДанные.Колонки.Добавить("СчетАванса",	Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
		СохраненныеДанные.Колонки.Добавить("КФО", 			Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
		СохраненныеДанные.Колонки.Добавить("КПС", 			Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
		СохраненныеДанные.Колонки.Добавить("ДокументАванса");
		СохраненныеДанные.Колонки.Добавить("СуммаАванса",	Новый ОписаниеТипов("Число"));
		СохраненныеДанные.Колонки.Добавить("НомерСтроки",	Новый ОписаниеТипов("Число"));
		СохраненныеДанные.Колонки.Добавить("Итератор",		Новый ОписаниеТипов("Число"));
	КонецЕсли;												
	
	СохраненныеАвансы = СохраненныеДанные.НайтиСтроки(Новый Структура("СчетРасчетов, КФО, КПС, НомерСтроки, Итератор",
																	   СчетРасчетов, КФО, КПС, НомерСтроки, Итератор));
	Если СохраненныеАвансы.Количество() = 1 Тогда
		Возврат СохраненныеАвансы[0][ИмяРеквизита];
	КонецЕсли;
	
	
	Если НЕ КонтекстПроведения.ДополнительныеСвойства.Свойство("ОстатокПоТекущейСтроке" + ИмяТЧ + НомерСтроки, ОстатокПоТекущейСтроке) Тогда
		ОстатокПоТекущейСтроке = Сумма;
	ИначеЕсли ОстатокПоТекущейСтроке = 0 Тогда
		Возврат 0;
	КонецЕсли;

	Авансы = БухгалтерскиеОперацииПовтИсп.ТаблицаСуммАвансовВыданныхПолная(	КонтекстПроведения.Ссылка,
																			Дата,
																			Организация,
																			ИФО,
																			Неопределено,
																			Неопределено,
																			Подразделение,
																			Контрагент,
																			Договор);
																			
	СтрокиАванса = Авансы.НайтиСтроки(Новый Структура("СчетРасчетов, КФО, КПС, СтрокаЗачтена", СчетРасчетов, КФО, КПС, Ложь));
	Если СтрокиАванса.Количество()=0 Тогда
		// авансов нет
		Возврат 0;
	КонецЕсли;
	
	СтрокаАванса = СтрокиАванса[0];
	
	Если ВРЕГ(ИмяРеквизита) = ВРЕГ("СчетАванса") Тогда
		Возврат СтрокаАванса.СчетАванса;
	КонецЕсли;
	
	СуммаАванса = Мин(Макс(СтрокаАванса.СуммаАванса-СтрокаАванса.СуммаЗачтено, 0), Мин(Сумма, ОстатокПоТекущейСтроке));
	ОстатокПоТекущейСтроке = ОстатокПоТекущейСтроке - СуммаАванса;
	
	СохраненныйАванс = СохраненныеДанные.Добавить();
	ЗаполнитьЗначенияСвойств(СохраненныйАванс, СтрокаАванса, "СчетРасчетов, КФО, КПС, СчетАванса, ДокументАванса");
	СохраненныйАванс.НомерСтроки = НомерСтроки;
	СохраненныйАванс.Итератор = Итератор;
	СохраненныйАванс.СуммаАванса = СуммаАванса;
	
	СтрокаАванса.СуммаЗачтено = СтрокаАванса.СуммаЗачтено + СуммаАванса;
	Если СтрокаАванса.СуммаАванса = СтрокаАванса.СуммаЗачтено Тогда
		СтрокаАванса.СтрокаЗачтена = Истина;
	КонецЕсли;
	
	КонтекстПроведения.ТаблицаАвансов = СохраненныеДанные;
	КонтекстПроведения.ДополнительныеСвойства.Вставить("ОстатокПоТекущейСтроке" + ИмяТЧ + НомерСтроки, ОстатокПоТекущейСтроке);
	
	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	
	Если СуммаАванса = 0 Тогда
		// аванс уже распределен полностью
		Возврат 0;
	КонецЕсли;
	
	Возврат СохраненныйАванс[ИмяРеквизита];
	
КонецФункции												

// Устарела.
Функция ПолучитьТаблицуЗачетаАвансаВыданного(	Дата,
												Организация, 
												ИФО, 
												КФО, 
												КПС, 
												Подразделение, 
												Контрагент, 
												Договор, 
												СчетРасчетов) Экспорт

	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();	
	Авансы = БухгалтерскиеОперацииПовтИсп.ТаблицаСуммАвансовВыданныхПолная(	КонтекстПроведения.Ссылка,
																			Дата,
																			Организация,
																			ИФО,
																			КФО,
																			КПС,
																			Подразделение,
																			Контрагент,
																			Договор);
																			
	Возврат Авансы;

КонецФункции // ПолучитьТаблицуЗачетаАвансаВыданного()

// Устарела.
Функция ПолучитьОстатокАвансаВыданного(	СуммаИзДокумента, Дата, Организация, ИФО, КФО, КПС, Подразделение, Субконто1, Субконто2, Субконто3, СчетАванса) Экспорт
    Перем Контрагент;
    Перем Договор;
    Перем ДокументАванса;
	
	Если ТипЗнч(Субконто1) = Тип("СправочникСсылка.Контрагенты") Тогда
		Контрагент = Субконто1;
	ИначеЕсли ТипЗнч(Субконто2) = Тип("СправочникСсылка.Контрагенты") Тогда
		Контрагент = Субконто2;
	ИначеЕсли ТипЗнч(Субконто3) = Тип("СправочникСсылка.Контрагенты") Тогда
		Контрагент = Субконто3;
	КонецЕсли;
	
	Если ТипЗнч(Субконто2) = Тип("СправочникСсылка.Договоры") Тогда
		Договор = Субконто2;
	ИначеЕсли ТипЗнч(Субконто3) = Тип("СправочникСсылка.Договоры") Тогда
		Договор = Субконто3;
	ИначеЕсли ТипЗнч(Субконто1) = Тип("СправочникСсылка.Договоры") Тогда
		Договор = Субконто1;
	КонецЕсли;
	
	Если Субконто3 <> Неопределено И Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(Субконто3)) Тогда
		ДокументАванса = Субконто3;	
	ИначеЕсли Субконто2 <> Неопределено И Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(Субконто2)) Тогда
		ДокументАванса = Субконто2;	
	ИначеЕсли Субконто1 <> Неопределено И Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(Субконто1)) Тогда
		ДокументАванса = Субконто1;	
	КонецЕсли;
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	Авансы = БухгалтерскиеОперацииПовтИсп.ТаблицаСуммАвансовВыданныхПолная(	КонтекстПроведения.Ссылка,
																			Дата,
																			Организация,
																			ИФО,
																			Неопределено,
																			Неопределено,
																			Подразделение,
																			Контрагент,
																			Договор);

	Отбор = Новый Структура;
	Отбор.Вставить("КФО",				КФО);
	Отбор.Вставить("КПС",				КПС);
	Отбор.Вставить("ДокументАванса",	ДокументАванса);
	Отбор.Вставить("СчетАванса",		СчетАванса);
	
	ТекстОшибки = "";
	
	СтрокиАвансов = Авансы.НайтиСтроки(Отбор);
	Если СтрокиАвансов.Количество() = 0 Тогда
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		               		НСтр("ru = 'Не обнаружено остатков аванса по сочетанию: КФО=""%1"", КПС=""%2"", Счет=""%3"", Документ аванса=""%4""'"),
							КФО, КПС, СчетАванса, ДокументАванса);
	ИначеЕсли СтрокиАвансов[0].СуммаАванса - СтрокиАвансов[0].СуммаЗачтено < СуммаИзДокумента Тогда
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		               		НСтр("ru = 'Недостаточно остатков аванса по сочетанию: КФО=""%1"", КПС=""%2"", Счет=""%3"", Документ аванса=""%4""'"),
							КФО, КПС, СчетАванса, ДокументАванса);
	КонецЕсли;
	
	Если ПустаяСтрока(ТекстОшибки) Тогда
		
		Результат = СуммаИзДокумента;
		СтрокиАвансов[0].СуммаЗачтено = СтрокиАвансов[0].СуммаЗачтено + Результат;
		
	Иначе
		
		Результат = 0;
		ДобавитьОшибкуВКонтекстПроведения(ТекстОшибки, "ПолучитьОстатокАвансаВыданного", КонтекстПроведения);
		
	КонецЕсли;
	
	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	
	Возврат Результат;	

КонецФункции // ПолучитьОстатокАвансаВыданного()

