#Область ПрограммныйИнтерфейс

// Функция возвращает наличие кворума присутствия. Может использоваться для документов с голосованием комиссии.
// 
// Параметры:
//   ВсегоСотрудников - Число(10) - общее количество сотрудников
//   ВсегоПрисутствующих - Число(10) - количество присутствующих сотрудников
//   Кворум - Число(5,2) - минимальный процент присутствующих, необходимый для наличия кворума
//
// Возвращаемое значение:
//  Булево - Истина, если кворум есть, иначе Ложь
//
Функция ЕстьКворумПрисутствия(ВсегоСотрудников, ВсегоПрисутствующих, Кворум) Экспорт
	
	Если ВсегоСотрудников = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Окр(100 * ВсегоПрисутствующих / ВсегоСотрудников, 3) >= Окр(Кворум, 3);
	
КонецФункции

Функция ПолучитьИмяРеквизитаНастроек() Экспорт
	
	Возврат "НастройкиМеханизмаИндикаторКворумаПрисутствия";
	
КонецФункции

Функция ПолучитьКворумПрисутствияИнвентаризационнойКомиссииПоУмолчанию() Экспорт
	
	Возврат 100 * 2/3;
	
КонецФункции

Процедура ОбновитьИндикатор(Форма, Элемент = Неопределено) Экспорт
	
	ИмяРеквизитаНастроек = ИндикаторКворумаПрисутствияКлиентСервер.ПолучитьИмяРеквизитаНастроек();
	
	НастройкиМеханизма = Форма[ИмяРеквизитаНастроек];
	
	Если Элемент <> Неопределено Тогда
		НастройкиИндикаторов = ОпределитьНастройкиИндикаторовПоЭлементу(Форма, Элемент);
	Иначе
		НастройкиИндикаторов = НастройкиМеханизма;
	КонецЕсли;
	
	Для Каждого НастройкиИндикатора Из НастройкиИндикаторов Цикл
		ИменаЭлементов = НастройкиИндикатора.ИменаЭлементов;
		
		КомиссияСсылка = Форма.Объект[НастройкиИндикатора.ОписаниеИндикатора.ИменаЭлементов.КомиссияСсылка];
		
		Если ЗначениеЗаполнено(КомиссияСсылка) Тогда
			СвойстваКомиссии = НастройкиИндикатора.СвойстваКомиссии;
			
			КоличествоВДокументе = ПолучитьКоличествоЧленовКомиссииВДокументе(Форма, НастройкиИндикатора);
			
			Если ЕстьКворумПрисутствия(КоличествоВДокументе.Всего, КоличествоВДокументе.Присутствует, СвойстваКомиссии.Кворум) Тогда
				ОбозначениеЭлемента = "СтраницаКворумДостигнут";
			Иначе
				ОбозначениеЭлемента = "СтраницаКворумНеДостигнут";
			КонецЕсли;
		Иначе
			ОбозначениеЭлемента = "СтраницаКворумНеДостигнут";
		КонецЕсли;
		
		Форма.Элементы[ИменаЭлементов.ГруппаСтраниц].ТекущаяСтраница = Форма.Элементы[ИменаЭлементов[ОбозначениеЭлемента]];
	КонецЦикла;
	
КонецПроцедуры

Функция ОпределитьНастройкиИндикаторовПоЭлементу(Форма, Элемент) Экспорт
	
	НастройкиИндикаторов = Новый Массив();
	
	ИмяРеквизитаНастроек = ИндикаторКворумаПрисутствияКлиентСервер.ПолучитьИмяРеквизитаНастроек();
	
	НастройкиМеханизма = Форма[ИмяРеквизитаНастроек];
	
	Для Каждого НастройкиИндикатора Из НастройкиМеханизма Цикл
		Для Каждого ЭлементСтруктуры Из НастройкиИндикатора.ОписаниеИндикатора.ИменаЭлементов Цикл
			Если Элемент.Имя = ЭлементСтруктуры.Значение Тогда
				НастройкиИндикаторов.Добавить(НастройкиИндикатора);
				
				Продолжить;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат НастройкиИндикаторов;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьКоличествоЧленовКомиссииВДокументе(Форма, НастройкиИндикатора)
	
	СоставКомиссии = Форма.Объект[НастройкиИндикатора.ОписаниеИндикатора.ИменаЭлементов.ТабличнаяЧастьСоставКомиссии];
	
	КоличествоСтрок = СоставКомиссии.Количество();
	
	Поиск = Новый Структура("Отсутствует", Ложь);
	
	МассивСтрок = СоставКомиссии.НайтиСтроки(Поиск);
	
	КоличествоСотрудниковПрисутствует = МассивСтрок.Количество();
	
	КоличествоЧленовКомиссии = Новый Структура();
	КоличествоЧленовКомиссии.Вставить("Всего", КоличествоСтрок);
	КоличествоЧленовКомиссии.Вставить("Присутствует", КоличествоСотрудниковПрисутствует);
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма.Объект, "Председатель") Тогда
		КоличествоЧленовКомиссии.Всего = КоличествоЧленовКомиссии.Всего + 1;
		КоличествоЧленовКомиссии.Присутствует = КоличествоЧленовКомиссии.Присутствует + 1;
	КонецЕсли;
	
	Возврат КоличествоЧленовКомиссии;
	
КонецФункции

#КонецОбласти
