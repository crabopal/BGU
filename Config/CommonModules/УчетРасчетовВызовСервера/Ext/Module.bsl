
#Область УстаревшиеПроцедурыИФункции

// Не используется.
Функция ПараметрыСчетаРасчетовПоКЭК(КЭК, ДопустимыеСчета, Знач НаДату, Знач Организация) Экспорт
	
	ПараметрыСчетаРасчетов = Новый Структура;
	ПараметрыСчетаРасчетов.Вставить("СчетРасчетов",
		ПредопределенноеЗначение("ПланСчетов.ЕПСБУ.ПустаяСсылка"));
	ПараметрыСчетаРасчетов.Вставить("ДопСубконтоРасчетовНомер", 0);
	ПараметрыСчетаРасчетов.Вставить("ДопСубконтоРасчетовВид",
		ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка"));
	ПараметрыСчетаРасчетов.Вставить("ДопСубконтоРасчетовОбязательный", Ложь);
	
	Если НЕ ЗначениеЗаполнено(КЭК) Тогда
		Возврат ПараметрыСчетаРасчетов;
	КонецЕсли;
	
	ПараметрыСчетаРасчетов.СчетРасчетов =
		БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(КЭК, ДопустимыеСчета,, НаДату, Организация);
	
	СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ПараметрыСчетаРасчетов.СчетРасчетов);
	Для НомерСубконто = 1 По СвойстваСчета.КоличествоСубконто Цикл
	
		ВидСубконто = СвойстваСчета["ВидСубконто" + НомерСубконто];
		Если ВидСубконто = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.Контрагенты")
		 ИЛИ ВидСубконто = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.Договоры") Тогда
			Продолжить; // Пропускаем.
		Иначе
			ПараметрыСчетаРасчетов.ДопСубконтоРасчетовНомер = НомерСубконто;
			ПараметрыСчетаРасчетов.ДопСубконтоРасчетовВид   = ВидСубконто;
			ПараметрыСчетаРасчетов.ДопСубконтоРасчетовОбязательный =
				СвойстваСчета["ВидСубконто" + НомерСубконто + "Обязательный"];
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат ПараметрыСчетаРасчетов;
	
КонецФункции

// Не используется.
Функция ПривестиТипДопСубконтоРасчетовВРасшифровкеПлатежа(ДопСубконтоРасчетов, ВидДопСубконтоРасчетов) Экспорт
	
	Если ЗначениеЗаполнено(ВидДопСубконтоРасчетов) Тогда
		Возврат ВидДопСубконтоРасчетов.ТипЗначения.ПривестиЗначение(ДопСубконтоРасчетов);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

#КонецОбласти
