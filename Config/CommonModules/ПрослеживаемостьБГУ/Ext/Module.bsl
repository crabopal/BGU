		//Если СтрокиВложений.Количество() > 0 Тогда
		//	ПараметрыОтраженияВПрослеживаемости.ЭтоПеремещение = Истина;
		//	ДобавитьДвиженияВложенияВИзготовлениеОСМЗВТаблицуРНПТ(
		//	ТаблицаПроводок.Скопировать(СтрокиВложений, "СубконтоДт1, СубконтоКт1, КоличествоКт, Сумма"),
		//	ПараметрыОтраженияВПрослеживаемости.РНПТ_МЗ,
		//	ПараметрыОтраженияВПрослеживаемости,
		//	СтрокиВложений[0].ВидСубконтоДт1);
		//Иначе
		//	СтрокиВложений = СтрокиПереносаМЗНаЗабаланс(ТаблицаПроводок, ДокументОбъект);
		//	Если СтрокиВложений.Количество() > 0 Тогда
		//		ПараметрыОтраженияВПрослеживаемости.ЭтоПеремещение = Истина;
		//		ДобавитьДвиженияПереносаМЗНаЗабаланс(
		//		ТаблицаПроводок.Скопировать(СтрокиВложений),
		//		ПараметрыОтраженияВПрослеживаемости.РНПТ_МЗ,
