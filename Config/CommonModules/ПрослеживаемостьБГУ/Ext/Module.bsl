Функция ВидСопроводительногоДокументаОтражающегоСодержаниеОперации(ДокументОбъект) Экспорт

	ТипДокумента = ТипЗнч(ДокументОбъект.Ссылка);
	
	Если ТипДокумента = Тип("ДокументСсылка.СчетФактураВыданный")
		Или ТипДокумента = Тип("ДокументСсылка.СчетФактураПолученный")
		Или ТипДокумента = Тип("ДокументСсылка.РегистрацияСтрокиКнигиПокупок") Тогда
		
		Возврат Справочники.ТипыДокументов.СчетФактура;
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный")
		Или ТипДокумента = Тип("ДокументСсылка.ИсправительныйСчетФактураПолученный")
		Или ТипДокумента = Тип("ДокументСсылка.КорректировочныйСчетФактураВыданный")
		Или ТипДокумента = Тип("ДокументСсылка.КорректировочныйСчетФактураПолученный") Тогда
		
		Возврат Справочники.ТипыДокументов.КорректировочныйСчетФактура;
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.НакладнаяНаОтпускМ15")
		Или ТипДокумента = Тип("ДокументСсылка.ПоступлениеОС")
		Или ТипДокумента = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовОС")
		Или ТипДокумента = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12")
		Или ТипДокумента = Тип("ДокументСсылка.ПередачаОбъектовОС")
		Или ТипДокумента = Тип("ДокументСсылка.ПоступлениеМЗ") Тогда
		
		Возврат Справочники.ТипыДокументов.Накладная;
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.АктСписанияМЗ")
		Или ТипДокумента = Тип("ДокументСсылка.АктСписанияМягкогоИХозИнвентаря")
		Или ТипДокумента = Тип("ДокументСсылка.АктОбОказанииУслуг")
		Или ТипДокумента = Тип("ДокументСсылка.СдачаЭтапаРабот")
		Или ТипДокумента = Тип("ДокументСсылка.АктСписанияМягкогоИХозИнвентаряОС")
		Или ТипДокумента = Тип("ДокументСсылка.РеконструкцияОС")
		Или ТипДокумента = Тип("ДокументСсылка.СписаниеОбъектовОС")
		Или ТипДокумента = Тип("ДокументСсылка.СписаниеТранспорта")
		Или ТипДокумента = Тип("ДокументСсылка.ТребованиеНакладная0315006") Тогда
		
		Возврат Справочники.ТипыДокументов.Акт;
		
	Иначе
		
		Возврат Справочники.ТипыДокументов.ПустаяСсылка();
		
	КонецЕсли;

КонецФункции

Функция ЕстьОстаткиПрослеживаемыхНФА(Отбор, ОС = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	
	СхемаЗапроса = Новый СхемаЗапроса;
	ОператорыВыбора = СхемаЗапроса.ПакетЗапросов[0].Операторы[0];
	
	Если ОС Тогда
		ИсточникНФА = ОператорыВыбора.Источники.Добавить("РегистрНакопления.ПрослеживаемыеОС.Остатки", "ПрослеживаемыеНФАОстатки")
	Иначе
		ИсточникНФА = ОператорыВыбора.Источники.Добавить("РегистрНакопления.ПрослеживаемыеТовары.Остатки", "ПрослеживаемыеНФАОстатки");
	КонецЕсли;
	
	ОператорыВыбора.ВыбираемыеПоля.Добавить("ПрослеживаемыеНФАОстатки.КоличествоОстаток");
	
	Период = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Отбор, "Период");
	Если ЗначениеЗаполнено(Период) Тогда
		ИсточникНФА.Источник.Параметры[0].Выражение = Новый ВыражениеСхемыЗапроса("&Период");
		Запрос.УстановитьПараметр("Период", Период);
	КонецЕсли;
	
	ТекстУсловия ="";

	ОтборНФА = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Отбор, "НФА");
	Если ЗначениеЗаполнено(ОтборНФА) Тогда
		ТекстНФА = ?(ОС, "ОсновноеСредство", "Номенклатура");
		УсловиеНФА = СтрШаблон("(%1 = &Ссылка ИЛИ Комплектующее = &Ссылка)", ТекстНФА);
		ТекстУсловия = ?(ЗначениеЗаполнено(ТекстУсловия), " И "+ УсловиеНФА, УсловиеНФА);
		Запрос.УстановитьПараметр("Ссылка", ОтборНФА);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекстУсловия) Тогда
		ИсточникНФА.Источник.Параметры[1].Выражение = Новый ВыражениеСхемыЗапроса(ТекстУсловия);
	КонецЕсли;
	
	ОператорыВыбора.Отбор.Добавить("ПрослеживаемыеНФАОстатки.КоличествоОстаток <> 0");
	
	Запрос.Текст = СхемаЗапроса.ПолучитьТекстЗапроса();
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Не РезультатЗапроса.Пустой();
		
КонецФункции

// Вызывается перед записью элемента справочника НФА для регистрации изменениий признаков прослеживаемости
// 
// Параметры:
//  Отказ - Булево
//  СправочникНФАОбъект - СправочникОбъект - (ОсновныеСредства,Номенклатура)
Процедура ОбработкаИзмененияПризнаковПрослеживаемости(Отказ, СправочникНФАОбъект) Экспорт

	Ссылка = СправочникНФАОбъект.Ссылка;
	Если Ссылка.Пустая()
			ИЛИ НЕ ВедетсяУчетПрослеживаемыхТоваров(Дата(1,1,1))
			ИЛИ СправочникНФАОбъект.ПометкаУдаления
			Тогда
		Возврат;
	КонецЕсли;
	
	ОС = ТипЗнч(СправочникНФАОбъект) = Тип("СправочникОбъект.ОсновныеСредства");
	
	ЕстьПризнакКомплекта = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СправочникНФАОбъект, "КомплектСПрослеживаемымиТоварами");
	СтрокаРеквизитовПрослеживаемости = ?(ЕстьПризнакКомплекта, "КомплектСПрослеживаемымиТоварами,ПрослеживаемыйТовар", "ПрослеживаемыйТовар");

	ПризнакиПрослеживаемости = Новый Структура("КомплектСПрослеживаемымиТоварами,ПрослеживаемыйТовар", Ложь, Ложь);
	ЗаполнитьЗначенияСвойств(ПризнакиПрослеживаемости, СправочникНФАОбъект, СтрокаРеквизитовПрослеживаемости);
	
	ТекущиеПризнакиПрослеживаемости = Новый Структура("КомплектСПрослеживаемымиТоварами,ПрослеживаемыйТовар", Ложь, Ложь);
	ЗаполнитьЗначенияСвойств(ТекущиеПризнакиПрослеживаемости,
		ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, СтрокаРеквизитовПрослеживаемости), СтрокаРеквизитовПрослеживаемости);
	
	Если ТекущиеПризнакиПрослеживаемости.ПрослеживаемыйТовар <> ПризнакиПрослеживаемости.ПрослеживаемыйТовар
		ИЛИ ТекущиеПризнакиПрослеживаемости.КомплектСПрослеживаемымиТоварами <> ПризнакиПрослеживаемости.КомплектСПрослеживаемымиТоварами Тогда
		ПериодИзменений = ОбщегоНазначения.ТекущаяДатаПользователя();
		
		Если (ТекущиеПризнакиПрослеживаемости.ПрослеживаемыйТовар И Не ПризнакиПрослеживаемости.ПрослеживаемыйТовар)
				ИЛИ (ТекущиеПризнакиПрослеживаемости.КомплектСПрослеживаемымиТоварами И Не ПризнакиПрослеживаемости.КомплектСПрослеживаемымиТоварами) Тогда
			Если ПрослеживаемостьБГУ.ЕстьОстаткиПрослеживаемыхНФА(Новый Структура("НФА", Ссылка), ОС) Тогда
				ИмяОстатков = ?(ОС, "ОС", "товары");
				ТекстСообщения = СтрШаблон(
					НСтр("ru = 'По %1 существуют остатки в регистре ""Прослеживаемые %2"" изменение прослеживаемости невозможно'"), Ссылка, ИмяОстатков);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
				Отказ = Истина;
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		СтрокаИстории = СправочникНФАОбъект.ИсторияПрослеживаемости.Найти(ПериодИзменений, "ДатаИзменения");
		Если СтрокаИстории = Неопределено Тогда
			СтрокаИстории = СправочникНФАОбъект.ИсторияПрослеживаемости.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаИстории, ТекущиеПризнакиПрослеживаемости);
			СтрокаИстории.ДатаИзменения = ПериодИзменений;
		Иначе
			СправочникНФАОбъект.ИсторияПрослеживаемости.Удалить(СтрокаИстории);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Пустая таблица операции с прослеживаемыми товарами.
// 
// Возвращаемое значение:
//  ТаблицаЗначений -  Пустая таблица операции с прослеживаемыми товарами:
// * Организация - СправочникСсылка.Организации - 
// * ОтражениеВОтчетности - ПеречислениеСсылка.ПорядокОтраженияВОтчетностиПоПрослеживаемости - 
// * ПериодОперации - Дата - 
// * ДокументОперации - ОпределяемыйТип.ОснованиеПрослеживаемойОперации 
// * РНПТ - ОпределяемыйТип.РНПТ 
// * Контрагент - ОпределяемыйТип.КонтрагентПрослеживаемость 
// * Номенклатура - ОпределяемыйТип.НоменклатураПрослеживаемость 
// * ОсновноеСредство - ОпределяемыйТип.НоменклатураПрослеживаемость
// * КапитальноеВложение - ОпределяемыйТип.НоменклатураПрослеживаемость
// * Комплектующее - ОпределяемыйТип.НоменклатураПрослеживаемость
// * КодОперации - СправочникСсылка.КодыОперацийПрослеживаемости - 
// * Количество - Число - 
// * КоличествоПрослеживаемости - Число - 
// * СуммаБезНДС - Число - 
// * ТипДокументаВПрослеживаемости - СправочникСсылка.ТипыДокументов - 
// * НомерДокумента - Строка - 
// * ДатаДокумента - Дата -
// * ЭтоСписание - Булево 
// * Период - Дата - 
// * СтранаПроисхождения - СправочникСсылка.СтраныМира
Функция ПустаяТаблицаОперацииСПрослеживаемымиТоварами()
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	Результат.Колонки.Добавить("ОтражениеВОтчетности", Новый ОписаниеТипов("ПеречислениеСсылка.ПорядокОтраженияВОтчетностиПоПрослеживаемости"));
	Результат.Колонки.Добавить("ПериодОперации", Новый ОписаниеТипов("Дата"));
	Результат.Колонки.Добавить("ДокументОперации", Метаданные.ОпределяемыеТипы.ОснованиеПрослеживаемойОперации.Тип);
	Результат.Колонки.Добавить("РНПТ", Метаданные.ОпределяемыеТипы.РНПТ.Тип);
	Результат.Колонки.Добавить("Контрагент", Метаданные.ОпределяемыеТипы.КонтрагентПрослеживаемость.Тип);
	Результат.Колонки.Добавить("КапитальноеВложение", Метаданные.ОпределяемыеТипы.НоменклатураПрослеживаемость.Тип);
	Результат.Колонки.Добавить("Номенклатура", Метаданные.ОпределяемыеТипы.НоменклатураПрослеживаемость.Тип);
	Результат.Колонки.Добавить("ОсновноеСредство", Метаданные.ОпределяемыеТипы.НоменклатураПрослеживаемость.Тип);
	Результат.Колонки.Добавить("ИнвентарныйНомер", Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	Результат.Колонки.Добавить("Комплектующее", Метаданные.ОпределяемыеТипы.НоменклатураПрослеживаемость.Тип);
	Результат.Колонки.Добавить("ВариантКомплекта", Новый ОписаниеТипов("СправочникСсылка.ВариантыКомплектовМЗПТ"));
	Результат.Колонки.Добавить("КодОперации", Новый ОписаниеТипов("СправочникСсылка.КодыОперацийПрослеживаемости"));
	Результат.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("КоличествоПрослеживаемости", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("КоличествоВложений", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("СуммаБезНДС", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("ТипДокументаВПрослеживаемости", Новый ОписаниеТипов("СправочникСсылка.ТипыДокументов"));
	Результат.Колонки.Добавить("НомерДокумента", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ДатаДокумента", Новый ОписаниеТипов("Дата"));
	Результат.Колонки.Добавить("ЭтоСписание", Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("ЭтоСторно", Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));
	Результат.Колонки.Добавить("СтранаПроисхождения", Новый ОписаниеТипов("СправочникСсылка.СтраныМира"));
	Результат.Колонки.Добавить("ИдентификаторСтроки", Новый ОписаниеТипов("Строка"));

	Возврат Результат;
КонецФункции

Функция ОперацииСПрослеживаемымиТоварамиДвижениеСчетаФактурыБезУчетаСуммыНДС(ДокументОбъект)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаОтраженияВПрослеживаемости", КонецДня(ДокументОбъект.Дата));
	Запрос.УстановитьПараметр("Организация", ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("Период", ДокументОбъект.Дата);
	ТипДокумента = ТипЗнч(ДокументОбъект);
	Если ТипДокумента = Тип("ДокументОбъект.СчетФактураВыданный")
		ИЛИ ТипДокумента = Тип("ДокументОбъект.ИсправительныйСчетФактураВыданный")
		ИЛИ ТипДокумента = Тип("ДокументОбъект.КорректировочныйСчетФактураВыданный") Тогда
		
		Запрос.УстановитьПараметр("ОтражениеВОтчетностиСФ", Перечисления.ПорядокОтраженияВОтчетностиПоПрослеживаемости.КнигаПродаж);
	Иначе
		Запрос.УстановитьПараметр("ОтражениеВОтчетностиСФ", Перечисления.ПорядокОтраженияВОтчетностиПоПрослеживаемости.КнигаПокупок);
	КонецЕсли;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОперацииСПрослеживаемымиТоварами.Организация КАК Организация,
	|	ОперацииСПрослеживаемымиТоварами.ОтражениеВОтчетности КАК ОтражениеВОтчетности,
	|	ОперацииСПрослеживаемымиТоварами.ПериодОперации КАК ПериодОперации,
	|	ОперацииСПрослеживаемымиТоварами.ДокументОперации КАК ДокументОперации,
	|	ОперацииСПрослеживаемымиТоварами.РНПТ КАК РНПТ,
	|	ОперацииСПрослеживаемымиТоварами.Контрагент КАК Контрагент,
	|	ОперацииСПрослеживаемымиТоварами.Номенклатура КАК Номенклатура,
	|	ОперацииСПрослеживаемымиТоварами.КодОперации КАК КодОперации,
	|	ОперацииСПрослеживаемымиТоварами.Количество КАК Количество,
	|	ОперацииСПрослеживаемымиТоварами.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости,
	|	ОперацииСПрослеживаемымиТоварами.СуммаБезНДС КАК СуммаБезНДС,
	|	ОперацииСПрослеживаемымиТоварами.ТипДокументаВПрослеживаемости КАК ТипДокументаВПрослеживаемости,
	|	ОперацииСПрослеживаемымиТоварами.НомерДокумента КАК НомерДокумента,
	|	ОперацииСПрослеживаемымиТоварами.ДатаДокумента КАК ДатаДокумента
	|ПОМЕСТИТЬ ВТ_ОперацииСПрослеживаемымиТоварами
	|ИЗ
	|	РегистрСведений.ОперацииСПрослеживаемымиТоварами.СрезПоследних(
	|			&ДатаОтраженияВПрослеживаемости,
	|			Организация = &Организация
	|				И ОтражениеВОтчетности = ЗНАЧЕНИЕ(Перечисление.ПорядокОтраженияВОтчетностиПоПрослеживаемости.ОтчетОбОперациях)
	|				И Регистратор В (&УсловиеДокументОснование)) КАК ОперацииСПрослеживаемымиТоварами
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОперацииСПрослеживаемымиТоварами.Организация КАК Организация,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.ОтражениеВОтчетности КАК ОтражениеВОтчетности,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.ПериодОперации КАК ПериодОперации,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.ДокументОперации КАК ДокументОперации,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.РНПТ КАК РНПТ,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.Контрагент КАК Контрагент,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.Номенклатура КАК Номенклатура,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.КодОперации КАК КодОперации,
	|	0 КАК Количество,
	|	0 КАК КоличествоПрослеживаемости,
	|	0 КАК СуммаБезНДС,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.ТипДокументаВПрослеживаемости КАК ТипДокументаВПрослеживаемости,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.НомерДокумента КАК НомерДокумента,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.ДатаДокумента КАК ДатаДокумента,
	|	&Период КАК Период
	|ИЗ
	|	ВТ_ОперацииСПрослеживаемымиТоварами КАК ВТ_ОперацииСПрослеживаемымиТоварами
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_ОперацииСПрослеживаемымиТоварами.Организация,
	|	&ОтражениеВОтчетностиСФ,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.ПериодОперации,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.ДокументОперации,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.РНПТ,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.Контрагент,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.Номенклатура,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.КодОперации,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.Количество,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.КоличествоПрослеживаемости,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.СуммаБезНДС,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.ТипДокументаВПрослеживаемости,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.НомерДокумента,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.ДатаДокумента,
	|	&Период
	|ИЗ
	|	ВТ_ОперацииСПрослеживаемымиТоварами КАК ВТ_ОперацииСПрослеживаемымиТоварами";
	
	МетаданныеДокумента = ДокументОбъект.Метаданные();
	
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ДокументКорректировки", МетаданныеДокумента) Тогда
		УсловиеДокументОснование = "&ДокументКорректировки";
		Запрос.УстановитьПараметр("ДокументКорректировки", ДокументОбъект.ДокументКорректировки);
		
	
	ИначеЕсли МетаданныеДокумента.ТабличныеЧасти.Найти("ДокументыОснования") <> Неопределено Тогда
				
		УсловиеДокументОснование =
		"ВЫБРАТЬ
		|	ТаблицаДокументыОснования.ДокументОснование КАК ДокументОснование
		|ИЗ
		|	&ТаблицаДокументыОснования КАК ТаблицаДокументыОснования
		|ГДЕ
		|	ТаблицаДокументыОснования.Ссылка = &Ссылка";
		
		ИмяТаблицы = МетаданныеДокумента.ПолноеИмя() + ".ДокументыОснования";
		УсловиеДокументОснование = СтрЗаменить(УсловиеДокументОснование, "&ТаблицаДокументыОснования", ИмяТаблицы);
		Запрос.УстановитьПараметр("Ссылка", ДокументОбъект.Ссылка);
	Иначе
		УсловиеДокументОснование = "&ДокументОснование";
		Запрос.УстановитьПараметр("ДокументОснование", ДокументОбъект.ДокументОснование);
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеДокументОснование", УсловиеДокументОснование);
	
	Результат = Запрос.Выполнить().Выгрузить();
	Возврат Результат;
	
КонецФункции

// Счет фактура полученный регистрируется в книге продаж.
// 
// Параметры:
//  ДокументОбъект - ДокументОбъект.СчетФактураПолученный
// 
// Возвращаемое значение:
//  Булево
Функция СчетФактураПолученныйРегистрируетсяВКнигеПродаж(ДокументОбъект)
	Для каждого СтрокаНФА Из ДокументОбъект.СоставНФА Цикл
		Если СтрокаНФА.НДСКВычету
			И (СтрокаНФА.СуммаНДС <> 0 Или УчетНДСКлиентСервер.РегистрироватьВычетПриНулевойСуммеНалога()) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Операции с прослеживаемыми товарами запись книги покупок ГТДИмпорт.
// 
// Параметры:
//  ДокументОбъект - ДокументОбъект.РегистрацияСтрокиКнигиПокупок
// 
// Возвращаемое значение:
//  Неопределено, ТаблицаЗначений - Операции с прослеживаемыми товарами запись книги покупок ГТДИмпорт
Функция ОперацииСПрослеживаемымиТоварамиЗаписьКнигиПокупокГТДИмпорт(ДокументОбъект)
	Если ТипЗнч(ДокументОбъект.ДокументОснование) <> Тип("ДокументСсылка.ГТДИмпорт") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаОтраженияВПрослеживаемости", КонецДня(ДокументОбъект.Дата));
	Запрос.УстановитьПараметр("Организация", ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("Период", ДокументОбъект.Дата);
	Запрос.УстановитьПараметр("ОтражениеВОтчетностиСФ", Перечисления.ПорядокОтраженияВОтчетностиПоПрослеживаемости.КнигаПокупок);
	Запрос.УстановитьПараметр("ГТДИмпорт", ДокументОбъект.ДокументОснование);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОперацииСПрослеживаемымиТоварами.Организация КАК Организация,
	|	ОперацииСПрослеживаемымиТоварами.ОтражениеВОтчетности КАК ОтражениеВОтчетности,
	|	ОперацииСПрослеживаемымиТоварами.ПериодОперации КАК ПериодОперации,
	|	ОперацииСПрослеживаемымиТоварами.ДокументОперации КАК ДокументОперации,
	|	ОперацииСПрослеживаемымиТоварами.РНПТ КАК РНПТ,
	|	ОперацииСПрослеживаемымиТоварами.Контрагент КАК Контрагент,
	|	ОперацииСПрослеживаемымиТоварами.Номенклатура КАК Номенклатура,
	|	ОперацииСПрослеживаемымиТоварами.КодОперации КАК КодОперации,
	|	ОперацииСПрослеживаемымиТоварами.Количество КАК Количество,
	|	ОперацииСПрослеживаемымиТоварами.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости,
	|	ОперацииСПрослеживаемымиТоварами.СуммаБезНДС КАК СуммаБезНДС,
	|	ОперацииСПрослеживаемымиТоварами.ТипДокументаВПрослеживаемости КАК ТипДокументаВПрослеживаемости,
	|	ОперацииСПрослеживаемымиТоварами.НомерДокумента КАК НомерДокумента,
	|	ОперацииСПрослеживаемымиТоварами.ДатаДокумента КАК ДатаДокумента
	|ПОМЕСТИТЬ ВТ_ОперацииСПрослеживаемымиТоварами
	|ИЗ
	|	РегистрСведений.ОперацииСПрослеживаемымиТоварами.СрезПоследних(
	|			&ДатаОтраженияВПрослеживаемости,
	|			Организация = &Организация
	|				И ОтражениеВОтчетности = ЗНАЧЕНИЕ(Перечисление.ПорядокОтраженияВОтчетностиПоПрослеживаемости.ОтчетОбОперациях)
	|				И Регистратор В
	|					(ВЫБРАТЬ
	|						ТаблицаДокументыОснования.ДокументПартии КАК ДокументПартии
	|					ИЗ
	|						Документ.ГТДИмпорт.Материалы КАК ТаблицаДокументыОснования
	|					ГДЕ
	|						ТаблицаДокументыОснования.Ссылка = &ГТДИмпорт
	|			
	|					ОБЪЕДИНИТЬ ВСЕ
	|			
	|					ВЫБРАТЬ
	|						ТаблицаДокументыОснования.ДокументПартии КАК ДокументПартии
	|					ИЗ
	|						Документ.ГТДИмпорт.ОсновныеСредства КАК ТаблицаДокументыОснования
	|					ГДЕ
	|						ТаблицаДокументыОснования.Ссылка = &ГТДИмпорт)) КАК ОперацииСПрослеживаемымиТоварами
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОперацииСПрослеживаемымиТоварами.Организация КАК Организация,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.ОтражениеВОтчетности КАК ОтражениеВОтчетности,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.ПериодОперации КАК ПериодОперации,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.ДокументОперации КАК ДокументОперации,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.РНПТ КАК РНПТ,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.Контрагент КАК Контрагент,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.Номенклатура КАК Номенклатура,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.КодОперации КАК КодОперации,
	|	0 КАК Количество,
	|	0 КАК КоличествоПрослеживаемости,
	|	0 КАК СуммаБезНДС,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.ТипДокументаВПрослеживаемости КАК ТипДокументаВПрослеживаемости,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.НомерДокумента КАК НомерДокумента,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.ДатаДокумента КАК ДатаДокумента,
	|	&Период КАК Период
	|ИЗ
	|	ВТ_ОперацииСПрослеживаемымиТоварами КАК ВТ_ОперацииСПрослеживаемымиТоварами
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_ОперацииСПрослеживаемымиТоварами.Организация,
	|	&ОтражениеВОтчетностиСФ,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.ПериодОперации,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.ДокументОперации,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.РНПТ,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.Контрагент,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.Номенклатура,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.КодОперации,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.Количество,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.КоличествоПрослеживаемости,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.СуммаБезНДС,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.ТипДокументаВПрослеживаемости,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.НомерДокумента,
	|	ВТ_ОперацииСПрослеживаемымиТоварами.ДатаДокумента,
	|	&Период
	|ИЗ
	|	ВТ_ОперацииСПрослеживаемымиТоварами КАК ВТ_ОперацииСПрослеживаемымиТоварами";
	
	Результат = Запрос.Выполнить().Выгрузить();
	Возврат Результат;
КонецФункции

Функция ОперацииСПрослеживаемымиТоварамиЗаписьКнигиПокупокПоСчетФактуре(ДокументОбъект)
	ДокументОснование = ДокументОбъект.ДокументОснование.ПолучитьОбъект();
	Если ДокументОснование = Неопределено Или СчетФактураПолученныйРегистрируетсяВКнигеПродаж(ДокументОснование) Тогда
		Возврат Неопределено;
	Иначе
		Возврат ОперацииСПрослеживаемымиТоварамиДвижениеСчетаФактурыБезУчетаСуммыНДС(ДокументОснование);
	КонецЕсли;
КонецФункции

