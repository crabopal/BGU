Процедура ДобавитьДвиженияВложенияВИзготовлениеОСМЗВТаблицуРНПТ(ВложенияОригинал, ТаблицаРНПТ, ПараметрыОтраженияВПрослеживаемости, ВидСубконтоИзготовления)

	Если ВидСубконтоИзготовления = ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства Тогда
		ИмяКолонкиПрихода = "ОсновноеСредство";
		ТаблицаПриходов = ПараметрыОтраженияВПрослеживаемости.РНПТ_ОС;
	ИначеЕсли ВидСубконтоИзготовления = ПланыВидовХарактеристик.ВидыСубконто.Номенклатура Тогда
		ИмяКолонкиПрихода = "Номенклатура";
		ТаблицаПриходов = ПараметрыОтраженияВПрослеживаемости.РНПТ_МЗ;
		РаспределитьСуммыТоваровПоРНПТ(ТаблицаРНПТ, "Номенклатура");
	Иначе
		Возврат;
	КонецЕсли;

	
	ОтборРНПТ = Новый Структура("Номенклатура, ОсновноеСредство, РНПТ");

	// ТаблицаРНПТ в дальшейшем может меняться, поэтому поиск выполняем по копии таблицы
	ИсходнаяТаблицаРНПТ = ТаблицаРНПТ.Скопировать();
	
	Вложения = ВложенияОригинал.Скопировать();
	Вложения.Свернуть("СубконтоДт1, СубконтоКт1", "КоличествоКт, Сумма");
	Вложения.Колонки.Добавить("Коэффициент", ОбщегоНазначения.ОписаниеТипаЧисло(15, 8));
	Вложения.Индексы.Добавить("СубконтоКт1");
	Изготавливаемые = Вложения.Скопировать(, "СубконтоДт1");
	Изготавливаемые.Свернуть("СубконтоДт1");
	Если Изготавливаемые.Количество() = 1 Тогда
		// Списание на изготовление НФА всегда выполняется на 1 объект
		Вложения.ЗаполнитьЗначения(1, "Коэффициент");
	Иначе
		// Вложение одного объекта в несколько НФА - распределить пропроционально сумме,
		// т.к. количества на счете 106 может не быть.
		СуммыВложений = Вложения.ВыгрузитьКолонку("Сумма");
		Коэффициенты = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(1, СуммыВложений, 10);
		Вложения.ЗагрузитьКолонку(Коэффициенты, "Коэффициент");
	КонецЕсли;

	Отбор = Новый Структура("СубконтоКт1");
	
	Для Каждого СтрокаСписания Из ИсходнаяТаблицаРНПТ Цикл
		Если СтрокаСписания.ЭтоСписание Тогда
			
			Если ЗначениеЗаполнено(СтрокаСписания.ОсновноеСредство) Тогда
				Отбор.СубконтоКт1 = СтрокаСписания.ОсновноеСредство;
			Иначе
				Отбор.СубконтоКт1 = СтрокаСписания.Номенклатура;
			КонецЕсли;
			
			СтрокиИзготовления = Вложения.НайтиСтроки(Отбор);
			
			Для Каждого СтрокаИ Из СтрокиИзготовления Цикл
				
				СтрокаПрихода = ТаблицаПриходов.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаПрихода, СтрокаСписания);
				СтрокаПрихода[ИмяКолонкиПрихода] = СтрокаИ.СубконтоДт1;
				СтрокаПрихода.ЭтоСписание = Ложь;
				СтрокаПрихода.Количество = СтрокаСписания.Количество * СтрокаИ.Коэффициент;
				СтрокаПрихода.КоличествоПрослеживаемости = СтрокаСписания.КоличествоПрослеживаемости * СтрокаИ.Коэффициент;
				
				Если Не ЗначениеЗаполнено(СтрокаПрихода.Комплектующее) Тогда
					СтрокаПрихода.Комплектующее = Отбор.СубконтоКт1;
					ЗаполнитьЗначенияСвойств(ОтборРНПТ, СтрокаСписания);
					СтрокиРНПТ = ИсходнаяТаблицаРНПТ.НайтиСтроки(ОтборРНПТ);
					Если СтрокиРНПТ.Количество() > 0 Тогда
						СтрокаПрихода.СуммаБезНДС = СтрокиРНПТ[0].СуммаБезНДС * СтрокаИ.Коэффициент;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	ПустойВариант = Справочники.ВариантыКомплектовМЗПТ.ПустаяСсылка();
	ОтборСтрок = Новый Структура("ЭтоСписание", ПараметрыОтраженияВПрослеживаемости.ЭтоВыпуск);
	СтрокиКОчисткеВарианта = ТаблицаРНПТ.НайтиСтроки(ОтборСтрок);
	Для Каждого СтрокаКонтроля Из СтрокиКОчисткеВарианта Цикл
		СтрокаКонтроля.ВариантКомплекта = ПустойВариант;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьДвиженияПереносаМЗНаЗабаланс(ПроводкиЗабаланс, ТаблицаРНПТ, ПараметрыОтраженияВПрослеживаемости)
	// ТаблицаРНПТ в дальшейшем может меняться, поэтому поиск выполняем по копии таблицы
	ИсходнаяТаблицаРНПТ = ТаблицаРНПТ.Скопировать();
	
	ТипЧисло = Новый ОписаниеТипов("Число");
	НоменклатураЗабаланс = Новый Соответствие;
	Для Каждого Проводка Из ПроводкиЗабаланс Цикл
		Если ТипЗнч(Проводка.СубконтоДт1) = Тип("СправочникСсылка.Номенклатура") Тогда
			Номенклатура = Проводка.СубконтоДт1;
		ИначеЕсли ТипЗнч(Проводка.СубконтоДт2) = Тип("СправочникСсылка.Номенклатура") Тогда
			Номенклатура = Проводка.СубконтоДт2;
		ИначеЕсли ТипЗнч(Проводка.СубконтоДт3) = Тип("СправочникСсылка.Номенклатура") Тогда
			Номенклатура = Проводка.СубконтоДт3;
		Иначе
			Продолжить;
		КонецЕсли;
		НоменклатураЗабаланс.Вставить(Номенклатура,
			ТипЧисло.ПривестиЗначение(НоменклатураЗабаланс.Получить(Номенклатура)) + Проводка.КоличествоДт);
	КонецЦикла;
	
	Отбор = Новый Структура("Номенклатура", Справочники.Номенклатура.ПустаяСсылка());
	Для Каждого Номенклатура Из НоменклатураЗабаланс Цикл
	
		Отбор.Номенклатура = Номенклатура.Ключ;
		СтрокиНоменклатуры = ИсходнаяТаблицаРНПТ.НайтиСтроки(Отбор);
		
		Для Каждого Строка Из СтрокиНоменклатуры Цикл
			НоваяСтрока = ТаблицаРНПТ.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			НоваяСтрока.ЭтоСписание = Ложь;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьДвиженияПереносаОСНаЗабаланс(ПроводкиЗабаланс, ТаблицаРНПТ, ПараметрыОтраженияВПрослеживаемости)
	// ТаблицаРНПТ в дальшейшем может меняться, поэтому поиск выполняем по копии таблицы
	ИсходнаяТаблицаРНПТ = ТаблицаРНПТ.Скопировать();
	
	ТипЧисло = Новый ОписаниеТипов("Число");
	ОСЗабаланс = Новый Соответствие;
	Для Каждого Проводка Из ПроводкиЗабаланс Цикл
		Если ТипЗнч(Проводка.СубконтоДт1) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
			ОС = Проводка.СубконтоДт1;	
		ИначеЕсли ТипЗнч(Проводка.СубконтоДт2) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
			ОС = Проводка.СубконтоДт2;	
		ИначеЕсли ТипЗнч(Проводка.СубконтоДт3) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
			ОС = Проводка.СубконтоДт3;	
		Иначе
			Продолжить;
		КонецЕсли;
		ОСЗабаланс.Вставить(ОС, 
			ТипЧисло.ПривестиЗначение(ОСЗабаланс.Получить(ОС)) + Проводка.КоличествоДт);
	КонецЦикла;
	
	НулевыеСтроки = Новый Массив;
	Отбор = Новый Структура("ОсновноеСредство", Справочники.ОсновныеСредства.ПустаяСсылка());
	Для Каждого ОсновноеСредство Из ОСЗабаланс Цикл
		КоличествоОсталось = ОсновноеСредство.Значение;
		Отбор.ОсновноеСредство = ОсновноеСредство.Ключ;
		СтрокиОС = ИсходнаяТаблицаРНПТ.НайтиСтроки(Отбор);
		Для Каждого Строка Из СтрокиОС Цикл
			Если ЗначениеЗаполнено(Строка.Комплектующее) Тогда
				Количество = Строка.Количество;
			Иначе
				Количество = Мин(КоличествоОсталось, Строка.Количество);
			КонецЕсли;
			Если Количество = 0 Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрока = ТаблицаРНПТ.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			НоваяСтрока.ЭтоСписание = Ложь;
			НоваяСтрока.Количество = Количество;
			НоваяСтрока.КоличествоПрослеживаемости = Строка.Количество * Строка.КоличествоПрослеживаемости / Количество;
			Строка.Количество = Строка.Количество - НоваяСтрока.Количество;
			Строка.КоличествоПрослеживаемости = Строка.КоличествоПрослеживаемости - НоваяСтрока.КоличествоПрослеживаемости;
			Если Не ЗначениеЗаполнено(Строка.Комплектующее) Тогда
				КоличествоОсталось = КоличествоОсталось - Количество;
				Если Строка.Количество = 0 Тогда
					НулевыеСтроки.Добавить(Строка);
				КонецЕсли;
				Если КоличествоОсталось = 0 Тогда
					Прервать;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Для Каждого НулеваяСтрока Из НулевыеСтроки Цикл
			ИсходнаяТаблицаРНПТ.Удалить(НулеваяСтрока);
		КонецЦикла;
		НулевыеСтроки.Очистить();
	КонецЦикла;
	
КонецПроцедуры

// Сформировать движения прослеживаемые товары по данным объекта.
// 
// Параметры:
//  ДокументОбъект - ДокументОбъект
//  ТаблицаРНПТ - см. ПустаяТаблицаОперацииСПрослеживаемымиТоварами
//  ОС_МЗ - Строка - "МЗ" или "ОС"
//  ТолькоСписание - Булево
Процедура СформироватьДвиженияПрослеживаемыеТоварыПоДаннымОбъекта(ДокументОбъект, ТаблицаРНПТ, ОС_МЗ, ТолькоСписание)
	
	Если ОС_МЗ = "МЗ" Тогда
		ПрослеживаемыеТовары = ДокументОбъект.Движения.Найти("ПрослеживаемыеТовары");
		ТаблицаДляЗаписи = РегистрыНакопления.ПрослеживаемыеТовары.СоздатьНаборЗаписей().ВыгрузитьКолонки(); 
	ИначеЕсли ОС_МЗ = "ОС" Тогда
		ПрослеживаемыеТовары = ДокументОбъект.Движения.Найти("ПрослеживаемыеОС");
		ТаблицаДляЗаписи = РегистрыНакопления.ПрослеживаемыеОС.СоздатьНаборЗаписей().ВыгрузитьКолонки(); 
	Иначе
		ПрослеживаемыеТовары = Неопределено;
	КонецЕсли;
	
	Если ПрослеживаемыеТовары = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаДляЗаписи.Колонки.Добавить("ЭтоСписание", Новый ОписаниеТипов("Булево"));
	ТаблицаДляЗаписи.Колонки.Добавить("ЭтоСторно", Новый ОписаниеТипов("Булево"));

	Для каждого СтрокаРНПТ Из ТаблицаРНПТ Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаДляЗаписи.Добавить(), СтрокаРНПТ);
	КонецЦикла;
	
	СвернутьТаблицуРНПТ(ТаблицаДляЗаписи);
	
	ПрослеживаемыеТовары.Очистить();
	ПрослеживаемыеТовары.Записывать = Истина;
	
	Если ТолькоСписание Тогда
		ОбрабатываемыеДвижения = ТаблицаДляЗаписи.НайтиСтроки(Новый Структура("ЭтоСписание", Истина));
	Иначе
		ОбрабатываемыеДвижения = ТаблицаДляЗаписи;
	КонецЕсли;
	
	ОснованиеДляВозвратаПоставщику = ОснованиеДляВозвратаПоставщику(ДокументОбъект);
	
	Для Каждого СтрокаРНПТ Из ОбрабатываемыеДвижения Цикл
		НовоеДвижение = ПрослеживаемыеТовары.Добавить();
		ЗаполнитьЗначенияСвойств(НовоеДвижение, СтрокаРНПТ);
		Если СтрокаРНПТ.ЭтоСписание Тогда
			НовоеДвижение.ВидДвижения = ВидДвиженияНакопления.Расход;
			Если ОснованиеДляВозвратаПоставщику <> Неопределено Тогда
				НовоеДвижение.ОснованиеДляВозврата = ОснованиеДляВозвратаПоставщику;
			КонецЕсли;
		Иначе
			НовоеДвижение.ВидДвижения = ВидДвиженияНакопления.Приход;
		КонецЕсли;
	КонецЦикла;
	ПрослеживаемыеТовары.УстановитьАктивность(Истина);
	
	Если ПолучитьФункциональнуюОпцию("ФормированиеПроводокОбособленноОтДокумента") Тогда
		ПрослеживаемыеТовары.Записать(Истина);
	КонецЕсли;
	
	Если ДокументОбъект.Движения.Найти("СоставыКомплектовМЗПТ") <> Неопределено Тогда
		 ПрослеживаемыеТовары.ДополнительныеСвойства.Вставить("ЗаписьСостава", Истина);
	КонецЕсли;	
	
КонецПроцедуры

Процедура ЗаполнитьОбщееКоличествоВТаблицеОС(Объект, ТаблицаОС, ОстаткиРНПТ)
	
	Если ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовОС") Тогда
		ТаблицаОС.ЗаполнитьЗначения(Объект.Количество, "ОбщееКоличество");
	ИначеЕсли ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.РешениеОПризнанииОбъектовОС") Тогда
		ТаблицаОС.ЗаполнитьЗначения(Объект.КоличествоВложений, "ОбщееКоличество");
	ИначеЕсли ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.РеконструкцияОС") Тогда
		ТаблицаОС.ЗаполнитьЗначения(Объект.ОсновныеСредства.Количество(), "ОбщееКоличество");
	ИначеЕсли (ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.СписаниеОбъектовОС")
			И Объект.ВидОперации = Перечисления.ВидыОперацийСписанияОС.СписаниеКапвложений)
		ИЛИ (ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ПередачаОбъектовОС")
			И Объект.ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаКапвложений) Тогда
		ЗаполнитьОбщееКоличествоОСПоОстаткам106(Объект, ТаблицаОС);
	ИначеЕсли ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.АктОбУтилизацииОС")
			ИЛИ ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.АктОбУтилизацииОСИК") Тогда
		ЗаполнитьОбщееКоличествоОСПоАктуОбУтилизацииОС(Объект, ТаблицаОС, ОстаткиРНПТ);
	Иначе
		ЗаполнитьОбщееКоличествоОСПоРегиструСтоимостьОбъектовОС(Объект, ТаблицаОС);
	КонецЕсли;
КонецПроцедуры

Процедура ЗаполнитьОбщееКоличествоОСПоАктуОбУтилизацииОС(Объект, ТаблицаОС, ОстаткиРНПТ)
	ТипЧисло = Новый ОписаниеТипов("Число");
	КоличествоВыбранныхОС = Новый Соответствие;
	Для каждого СтрокаРНПТ Из ОстаткиРНПТ Цикл
		Если Не ЗначениеЗаполнено(СтрокаРНПТ.Комплектующее) Тогда
			КоличествоОС = ТипЧисло.ПривестиЗначение(КоличествоВыбранныхОС.Получить(СтрокаРНПТ.ОсновноеСредство));
			КоличествоВыбранныхОС.Вставить(СтрокаРНПТ.ОсновноеСредство, КоличествоОС + СтрокаРНПТ.Количество);
		КонецЕсли;
	КонецЦикла;
	Для каждого СтрокаОС Из ТаблицаОС Цикл
		КоличествоРНПТПоОС = КоличествоВыбранныхОС.Получить(СтрокаОС.ОсновноеСредство);
		Если КоличествоРНПТПоОС = Неопределено Тогда
			СтрокаОС.ОбщееКоличество = СтрокаОС.Количество;
		Иначе
			СтрокаОС.ОбщееКоличество = КоличествоРНПТПоОС;
		КонецЕсли;
	КонецЦикла; 
КонецПроцедуры

Процедура ЗаполнитьОбщееКоличествоОСПоРегиструСтоимостьОбъектовОС(Объект, ТаблицаОС)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьОбъектовОСОстатки.КоличествоОстаток КАК ОбщееКоличество
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство В (&ОсновныеСредства)
	|				И ВидРаспоряжения = &ВидРаспоряжения) КАК СтоимостьОбъектовОСОстатки";
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ОсновныеСредства", ТаблицаОС.ВыгрузитьКолонку("ОсновноеСредство"));
	Если Объект.Ссылка.Пустая() Тогда
		Период = Новый Граница(Объект.Дата, ВидГраницы.Включая);
	Иначе
		Период = Новый Граница(Объект.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;
	Запрос.УстановитьПараметр("Период", Период);
	ВидРаспоряжения = ВидРаспоряженияПриСписанииОС(Объект);
	Если Не ЗначениеЗаполнено(ВидРаспоряжения) Тогда
		ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.НаБалансе;
	КонецЕсли;
	ОстаткиПоКонтрагентам = ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.НаХранении
		Или ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.ПолученоВПользование;
	Если ОстаткиПоКонтрагентам Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "РегистрНакопления.СтоимостьОбъектовОС", "РегистрНакопления.СтоимостьОбъектовОСПоКонтрагентам");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ВидРаспоряжения", ВидРаспоряжения);
	
	ОстаткиОС = Запрос.Выполнить().Выгрузить();
	ОстаткиОС.Индексы.Добавить("ОсновноеСредство");
	
	Для каждого СтрокаОС Из ТаблицаОС Цикл
	
		Остаток = ОстаткиОС.НайтиСтроки(Новый Структура("ОсновноеСредство", СтрокаОС.ОсновноеСредство));
		Если Остаток.Количество() > 0 Тогда
			СтрокаОС.ОбщееКоличество = Остаток[0].ОбщееКоличество;
		КонецЕсли;
	
	КонецЦикла; 
КонецПроцедуры

Функция ВидРаспоряженияПриСписанииОС(Объект)
	ТипСсылки = ТипЗнч(Объект.Ссылка);
	ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.ПустаяСсылка();
	Если ТипСсылки = Тип("ДокументСсылка.СписаниеОбъектовОС") Тогда
		Если Объект.ВидОперации = Перечисления.ВидыОперацийСписанияОС.СписаниеСобственныхОСОперУчет Тогда
			ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.ОперативныйУчет;
		ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийСписанияОС.СписаниеОСнаХранении Тогда
			ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.НаХранении;
		ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийСписанияОС.СписаниеОСПолученныхВПользование Тогда
			ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.ПолученоВПользование;
		КонецЕсли;
	ИначеЕсли ТипСсылки = Тип("ДокументСсылка.ПередачаОбъектовОС") Тогда
		Если Объект.ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаСобственныхОСОперУчет Тогда
			ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.ОперативныйУчет;
		ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаОСПолученныхВПользование Тогда
			ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.ПолученоВПользование;
		ИначеЕсли Объект.ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаОСнаХранении Тогда
			ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.НаХранении;
		КонецЕсли;
	ИначеЕсли ТипСсылки = Тип("ДокументСсылка.СписаниеТранспорта") Тогда
		Если Объект.ВидОперации = Перечисления.ВидыОперацийСписанияОС.СписаниеОСнаХранении Тогда
			ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.НаХранении;
		КонецЕсли;
	КонецЕсли;
	Возврат ВидРаспоряжения;
КонецФункции

Процедура ЗаполнитьОбщееКоличествоОСПоОстаткам106(Объект, ТаблицаОС)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК ОбщееКоличество
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&Период, Счет В (&Счета106), &Субконто, Организация = &Организация
	|	И Субконто1 В (&ОсновныеСредства)) КАК ЖурналПроводокЕПСБУОстатки";
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Счета106", БухгалтерскийУчет.СписокСчетов("106.00"));
	Запрос.УстановитьПараметр("ОсновныеСредства", ТаблицаОС.ВыгрузитьКолонку("ОсновноеСредство"));
	Запрос.УстановитьПараметр("Субконто", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(
		ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства));
	Если Объект.Ссылка.Пустая() Тогда
		Период = Новый Граница(Объект.Дата, ВидГраницы.Включая);
	Иначе
		Период = Новый Граница(Объект.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;
	Запрос.УстановитьПараметр("Период", Период);
	ОстаткиОС = Запрос.Выполнить().Выгрузить();
	ОстаткиОС.Индексы.Добавить("ОсновноеСредство");
	
	Для каждого СтрокаОС Из ТаблицаОС Цикл
	
		Остаток = ОстаткиОС.НайтиСтроки(Новый Структура("ОсновноеСредство", СтрокаОС.ОсновноеСредство));
		Если Остаток.Количество() > 0 Тогда
			СтрокаОС.ОбщееКоличество = Остаток[0].ОбщееКоличество;
		КонецЕсли;
	
	КонецЦикла; 

КонецПроцедуры

Процедура ЗаполнитьОстатокБУСоставныеОС(Объект, ТаблицаОС)

	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОсновныеСредства.Ссылка КАК Ссылка,
	|	ЕСТЬNULL(ДанныеИзИстории.ПрослеживаемыйТовар, ОсновныеСредства.ПрослеживаемыйТовар) КАК ПрослеживаемыйТовар
	|ПОМЕСТИТЬ ВТ_СоставныеОС
	|ИЗ
	|	Справочник.ОсновныеСредства КАК ОсновныеСредства
	|		{ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			Т2.Ссылка КАК Ссылка,
	|			Т2.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар
	|		ИЗ
	|			Справочник.ОсновныеСредства.ИсторияПрослеживаемости КАК Т2
	|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|					МИНИМУМ(Т1.ДатаИзменения) КАК ДатаИзменения,
	|					Т1.Ссылка КАК Ссылка
	|				ИЗ
	|					Справочник.Номенклатура.ИсторияПрослеживаемости КАК Т1
	|				ГДЕ
	|					Т1.ДатаИзменения > &ДатаПроверки
	|				
	|				СГРУППИРОВАТЬ ПО
	|					Т1.Ссылка) КАК Т1
	|				ПО Т2.Ссылка = Т1.Ссылка
	|					И Т2.ДатаИзменения = Т1.ДатаИзменения) КАК ДанныеИзИстории
	|		ПО ОсновныеСредства.Ссылка = ДанныеИзИстории.Ссылка}
	|ГДЕ
	|	НЕ ЕСТЬNULL(ДанныеИзИстории.ПрослеживаемыйТовар, ОсновныеСредства.ПрослеживаемыйТовар)
	|	И ОсновныеСредства.Ссылка В(&ОсновныеСредства)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕПСБУОстатки.КоличествоОстаток КАК Количество,
	|	ВЫБОР
	|		КОГДА ЕПСБУОстатки.Субконто1 ССЫЛКА Справочник.ОсновныеСредства
	|			ТОГДА ЕПСБУОстатки.Субконто1
	|		КОГДА ЕПСБУОстатки.Субконто2 ССЫЛКА Справочник.ОсновныеСредства
	|			ТОГДА ЕПСБУОстатки.Субконто2
	|		КОГДА ЕПСБУОстатки.Субконто3 ССЫЛКА Справочник.ОсновныеСредства
	|			ТОГДА ЕПСБУОстатки.Субконто3
	|	КОНЕЦ КАК ОсновноеСредство
	|ПОМЕСТИТЬ ВТ_ОстаткиБУ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			НЕ Счет В (&СчетаИсключения),
	|			,
	|			Организация = &Организация
	|				И ВЫБОР
	|					КОГДА Субконто1 ССЫЛКА Справочник.ОсновныеСредства
	|						ТОГДА Субконто1 В
	|								(ВЫБРАТЬ
	|									ВТ_СоставныеОС.Ссылка
	|								ИЗ
	|									ВТ_СоставныеОС)
	|					КОГДА Субконто2 ССЫЛКА Справочник.ОсновныеСредства
	|						ТОГДА Субконто2 В
	|								(ВЫБРАТЬ
	|									ВТ_СоставныеОС.Ссылка
	|								ИЗ
	|									ВТ_СоставныеОС)
	|					КОГДА Субконто3 ССЫЛКА Справочник.ОсновныеСредства
	|						ТОГДА Субконто3 В
	|								(ВЫБРАТЬ
	|									ВТ_СоставныеОС.Ссылка
	|								ИЗ
	|									ВТ_СоставныеОС)
	|				КОНЕЦ) КАК ЕПСБУОстатки
	|ГДЕ
	|	ЕПСБУОстатки.КоличествоОстаток > 0
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_СоставныеОС.Ссылка КАК ОсновноеСредство,
	|	ЕСТЬNULL(ВТ_ОстаткиБУ.Количество, 0) КАК Количество
	|ИЗ
	|	ВТ_СоставныеОС КАК ВТ_СоставныеОС
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОстаткиБУ КАК ВТ_ОстаткиБУ
	|		ПО ВТ_СоставныеОС.Ссылка = ВТ_ОстаткиБУ.ОсновноеСредство";
	
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ОсновныеСредства", ТаблицаОС.ВыгрузитьКолонку("ОсновноеСредство"));
		
	Если Объект.Ссылка.Пустая() Тогда
		Период = Новый Граница(Объект.Дата, ВидГраницы.Включая);
	Иначе
		Период = Новый Граница(Объект.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("ДатаПроверки", Объект.Дата);
	Запрос.УстановитьПараметр("СчетаИсключения", БухгалтерскийУчет.СписокСчетов("21,24,25,26,27.01", Объект.Дата, , Объект.Организация));
	
	ОстаткиБУ = Запрос.Выполнить().Выгрузить();
	ОстаткиБУ.Индексы.Добавить("ОсновноеСредство");
	
	Для Каждого СтрокаОС Из ТаблицаОС Цикл
	
		Остаток = ОстаткиБУ.НайтиСтроки(Новый Структура("ОсновноеСредство", СтрокаОС.ОсновноеСредство));
		Если Остаток.Количество() Тогда
			СтрокаОС.ОстатокБУСоставноеОС = Остаток[0].Количество;
			СтрокаОС.ЭтоСоставноеОС = Истина;
		КонецЕсли;
	
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьВТаблицуОССоставДокумента(Объект, ТаблицаОС)
	ОбъектыСПроцедуройВМенеджере = Новый Массив;
	ОбъектыСПроцедуройВМенеджере.Добавить(Тип("ДокументОбъект.ПереводОбъектовОСизГрупповогоУчетаНаИндивидуальный"));
	
	Если ОбъектыСПроцедуройВМенеджере.Найти(ТипЗнч(Объект)) <> Неопределено Тогда
		МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Объект.Ссылка);
		МенеджерОбъекта.ДобавитьВТаблицуОССоставДокумента(Объект, ТаблицаОС)
	Иначе	
		ЕстьРеквизитОсновноеСредство = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "ОсновноеСредство");
		ЕстьРеквизитВнеоборотныйАктив = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "ВнеоборотныйАктив");
		ЕстьРеквизитКапитальноеВложение = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "КапитальноеВложение");
		Если ЕстьРеквизитОсновноеСредство Тогда
			НоваяСтрока = ТаблицаОС.Добавить();
			НоваяСтрока.НомерСтроки = 1;
			НоваяСтрока.ОсновноеСредство = Объект.ОсновноеСредство;
			НоваяСтрока.Количество = 1;
		Иначе
			ЕстьРеквизитПрослеживаемыйТовар = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(
				Объект.ОсновныеСредства[0], "ПрослеживаемыйТовар");
			ЕстьРеквизитКоличество = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(
				Объект.ОсновныеСредства[0], "Количество");
			Если ЕстьРеквизитПрослеживаемыйТовар Тогда
				ПрослеживаемыеСтроки = Объект.ОсновныеСредства.НайтиСтроки(Новый Структура("ПрослеживаемыйТовар", Истина));
			Иначе
				ПрослеживаемыеСтроки = Объект.ОсновныеСредства;
			КонецЕсли;
			Для каждого ПрослеживаемаяСтрока Из ПрослеживаемыеСтроки Цикл
				Если Не ЗначениеЗаполнено(ПрослеживаемаяСтрока.ИдентификаторСтроки) Тогда
					ПрослеживаемаяСтрока.ИдентификаторСтроки = Новый УникальныйИдентификатор;
				КонецЕсли;
				НоваяСтрока = ТаблицаОС.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ПрослеживаемаяСтрока);
				Если ЕстьРеквизитВнеоборотныйАктив Тогда
					НоваяСтрока.ОсновноеСредство = Объект.ВнеоборотныйАктив;
				ИначеЕсли ЕстьРеквизитКапитальноеВложение Тогда
					НоваяСтрока.ОсновноеСредство = Объект.КапитальноеВложение;
				КонецЕсли;
				Если НЕ ЕстьРеквизитКоличество Тогда
					НоваяСтрока.Количество = 1;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Пустая таблица ОС для вычисления РНПТ к списанию
// 
// Возвращаемое значение:
//  ТаблицаЗначений -  Пустая таблица ОС:
// * НомерСтроки - Число - 
// * ОсновноеСредство - СправочникСсылка.ОсновныеСредства - 
// * ИдентификаторСтроки - Строка - 
// * Количество - Число - 
// * ОбщееКоличество - Число - 
Функция ПустаяТаблицаОС()
	ТаблицаОС = Новый ТаблицаЗначений;
	ТаблицаОС.Колонки.Добавить("НомерСтроки",          Новый ОписаниеТипов("Число"));
	ТаблицаОС.Колонки.Добавить("ОсновноеСредство",     Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ТаблицаОС.Колонки.Добавить("ИдентификаторСтроки",  Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(36, ДопустимаяДлина.Фиксированная)));
	ТаблицаОС.Колонки.Добавить("Количество",           Новый ОписаниеТипов("Число"));
	ТаблицаОС.Колонки.Добавить("ОбщееКоличество",      Новый ОписаниеТипов("Число"));
	ТаблицаОС.Колонки.Добавить("ОстатокБУСоставноеОС", Новый ОписаниеТипов("Число"));
	ТаблицаОС.Колонки.Добавить("ЭтоСоставноеОС",       Новый ОписаниеТипов("Число"));

	Возврат ТаблицаОС;
КонецФункции

Функция ИдентификаторыСтрокСРНПТ(Таблица)
	Результат = Новый Соответствие;
	Если Таблица.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Если НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Таблица[0], "ИдентификаторСтроки") Тогда
		Результат.Вставить("                                    ", Истина);
	Иначе	
		Для каждого Строка Из Таблица Цикл
			Результат.Вставить(Строка.ИдентификаторСтроки, Истина);
		КонецЦикла; 
	КонецЕсли; 
	Возврат Результат;
КонецФункции

Процедура ПодобратьРНПТКСписаниюОС(Знач ИдентификаторыСтрокСРНПТ, Знач Объект, Знач ОстаткиРНПТ, Знач РанееСписанныеСтроки, Знач ТаблицаОС)
	
	ТипЧисло = Новый ОписаниеТипов("Число");

	ЕстьРеквизитВнеоборотныйАктив = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект,
		"ВнеоборотныйАктив");
	Отбор = Новый Структура;
	Если ЕстьРеквизитВнеоборотныйАктив Тогда
		Отбор.Вставить("ОсновноеСредство", Объект.ВнеоборотныйАктив);
	КонецЕсли;
	// Подобрать РНПТ в строки без РНПТ
	Для Каждого СтрокаТабличнойЧасти Из ТаблицаОС Цикл
		Если ИдентификаторыСтрокСРНПТ.Получить(СтрокаТабличнойЧасти.ИдентификаторСтроки) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		УдаляемыеРНПТ = Новый Массив;
		Если Не ЕстьРеквизитВнеоборотныйАктив Тогда
			Отбор.Вставить("ОсновноеСредство", СтрокаТабличнойЧасти.ОсновноеСредство);
		КонецЕсли;

		ОсталосьСписать = СтрокаТабличнойЧасти.Количество;
		СписанноеКоличествоПоОС = ТипЧисло.ПривестиЗначение(РанееСписанныеСтроки.Получить(
			СтрокаТабличнойЧасти.ОсновноеСредство));
		КоличествоОстаток = СтрокаТабличнойЧасти.ОбщееКоличество - СписанноеКоличествоПоОС;
		Если КоличествоОстаток = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаТабличнойЧасти.ЭтоСоставноеОС Тогда
			ВсегоРНПТ = ОстаткиРНПТ.Скопировать(Отбор).Итог("Количество");
			ОсталосьСписать = ОсталосьСписать * ВсегоРНПТ
				/ ?(СтрокаТабличнойЧасти.ОстатокБУСоставноеОС > 0, СтрокаТабличнойЧасти.ОстатокБУСоставноеОС, КоличествоОстаток);
		КонецЕсли;
		
		ПодходящиеОстаткиРНПТ = ОстаткиРНПТ.НайтиСтроки(Отбор);
		
		Для Каждого РаспределяемыйРНПТ Из ПодходящиеОстаткиРНПТ Цикл
			ПараметрыСтроки = Новый Структура("Количество, КоличествоПрослеживаемости, СуммаБезНДС", 0, 0, 0);
			
			Если ОсталосьСписать = 0 Тогда
				Продолжить;
			КонецЕсли;
			ПараметрыСтроки.Количество = Мин(РаспределяемыйРНПТ.Количество, ОсталосьСписать);
			
			Если ЗначениеЗаполнено(РаспределяемыйРНПТ.Комплектующее) Тогда
				КоэффициентСписания = ПараметрыСтроки.Количество / РаспределяемыйРНПТ.Количество;
				ПараметрыСтроки.КоличествоПрослеживаемости = РаспределяемыйРНПТ.КоличествоПрослеживаемости
					* КоэффициентСписания;
				ПараметрыСтроки.СуммаБезНДС = РаспределяемыйРНПТ.СуммаБезНДС * КоэффициентСписания;
			Иначе
				ПараметрыСтроки.КоличествоПрослеживаемости = ОсталосьСписать
					* РаспределяемыйРНПТ.КоличествоПрослеживаемости / РаспределяемыйРНПТ.Количество;
			КонецЕсли;
			
			ОсталосьСписать = ОсталосьСписать - ПараметрыСтроки.Количество;
			
			НоваяСтрокаРНПТ = Объект.СведенияПрослеживаемости.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаРНПТ, РаспределяемыйРНПТ);
			Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(НоваяСтрокаРНПТ, "ИдентификаторСтроки") Тогда
				НоваяСтрокаРНПТ.ИдентификаторСтроки = СтрокаТабличнойЧасти.ИдентификаторСтроки;
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(НоваяСтрокаРНПТ, ПараметрыСтроки);

			РаспределяемыйРНПТ.Количество = РаспределяемыйРНПТ.Количество - ПараметрыСтроки.Количество;
			РаспределяемыйРНПТ.КоличествоПрослеживаемости = РаспределяемыйРНПТ.КоличествоПрослеживаемости
				- ПараметрыСтроки.КоличествоПрослеживаемости;
			РаспределяемыйРНПТ.СуммаБезНДС = РаспределяемыйРНПТ.СуммаБезНДС - ПараметрыСтроки.СуммаБезНДС;
			Если РаспределяемыйРНПТ.Количество = 0 Тогда
				УдаляемыеРНПТ.Добавить(РаспределяемыйРНПТ);
			КонецЕсли;

		КонецЦикла;
		СписанноеКоличествоПоОС = ТипЧисло.ПривестиЗначение(РанееСписанныеСтроки.Получить(
			СтрокаТабличнойЧасти.ОсновноеСредство)) + СтрокаТабличнойЧасти.Количество;
		РанееСписанныеСтроки.Вставить(СтрокаТабличнойЧасти.ОсновноеСредство, СписанноеКоличествоПоОС);
		Для Каждого НулевойРНПТ Из УдаляемыеРНПТ Цикл
			ОстаткиРНПТ.Удалить(НулевойРНПТ);
		КонецЦикла;

	КонецЦикла;

КонецПроцедуры

Процедура ОтметитьСписаниеВыбранныхРНПТОС(Знач ИдентификаторыСтрокСРНПТ, Знач Объект, Знач ОстаткиРНПТ, Отказ, Знач РанееСписанныеСтроки, Знач ТаблицаОС)
	
	Если Объект.СведенияПрослеживаемости.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ЕстьКолонкаИдентификаторСтроки = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(
		Объект.СведенияПрослеживаемости[0], "ИдентификаторСтроки");

	ТипЧисло = Новый ОписаниеТипов("Число");

	Для Каждого СтрокаТабличнойЧасти Из ТаблицаОС Цикл
		Если ИдентификаторыСтрокСРНПТ.Получить(СтрокаТабличнойЧасти.ИдентификаторСтроки) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ЕстьКолонкаИдентификаторСтроки Тогда
			СтрокиРНПТ = Объект.СведенияПрослеживаемости.НайтиСтроки(Новый Структура("ИдентификаторСтроки",
				СтрокаТабличнойЧасти.ИдентификаторСтроки));
		Иначе
			СтрокиРНПТ = Объект.СведенияПрослеживаемости;
		КонецЕсли;
		Для Каждого РНПТ Из СтрокиРНПТ Цикл
			Отбор = Новый Структура;
			Отбор.Вставить("РНПТ", РНПТ.РНПТ);
			Отбор.Вставить("ОсновноеСредство", СтрокаТабличнойЧасти.ОсновноеСредство);
			Отбор.Вставить("Комплектующее", ?(ЗначениеЗаполнено(РНПТ.Комплектующее), РНПТ.Комплектующее, Неопределено));
			УдаляемыеРНПТ = Новый Массив;

			ПодходящиеРНПТ = ОстаткиРНПТ.НайтиСтроки(Отбор);
			Если ПодходящиеРНПТ.Количество() = 0 Тогда
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru='Для целей учета прослеживаемости не списано %1 РНПТ %2 (в остатках %3)'"), Формат(
					РНПТ.Количество, "ЧЦ=15; ЧДЦ=3"), РНПТ.РНПТ, 0);
				ИмяТабличнойЧасти = "ОсновныеСредства";
				Поле = "" + ИмяТабличнойЧасти + "[" + Формат(СтрокаТабличнойЧасти.НомерСтроки - 1, "ЧГ=") + "].РНПТ";
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Объект.Ссылка, Поле, "Объект", Отказ);
				Продолжить;
			КонецЕсли;
			Для Каждого СписываемыйРНПТ Из ПодходящиеРНПТ Цикл
				Если РНПТ.Количество > СписываемыйРНПТ.Количество Тогда
					ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru='Для целей учета прослеживаемости не списано %1 РНПТ %2 (в остатках %3)'"), Формат(
						РНПТ.Количество, "ЧЦ=15; ЧДЦ=3"), РНПТ.РНПТ, СписываемыйРНПТ.Количество);
					ИмяТабличнойЧасти = "ОсновныеСредства";
					Поле = "" + ИмяТабличнойЧасти + "[" + Формат(СтрокаТабличнойЧасти.НомерСтроки - 1, "ЧГ=") + "].РНПТ";
					ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Объект.Ссылка, Поле, "Объект", Отказ);
				Иначе
					СписываемыйРНПТ.Количество = СписываемыйРНПТ.Количество - РНПТ.Количество;
					СписываемыйРНПТ.КоличествоПрослеживаемости = СписываемыйРНПТ.КоличествоПрослеживаемости
						- РНПТ.КоличествоПрослеживаемости;
					Если СписываемыйРНПТ.Количество = 0 Тогда
						УдаляемыеРНПТ.Добавить(СписываемыйРНПТ);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;

			Для Каждого НулевойРНПТ Из УдаляемыеРНПТ Цикл
				ОстаткиРНПТ.Удалить(НулевойРНПТ);
			КонецЦикла;

		КонецЦикла;
		СписанноеКоличествоПоОС = ТипЧисло.ПривестиЗначение(РанееСписанныеСтроки.Получить(
			СтрокаТабличнойЧасти.ОсновноеСредство)) + СтрокаТабличнойЧасти.Количество;
		РанееСписанныеСтроки.Вставить(СтрокаТабличнойЧасти.ОсновноеСредство, СписанноеКоличествоПоОС);
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьРНПТВТаблицеМЗПриПроведении(Объект, Отказ, РежимЗаписи, ИмяТч)
	
	Если РежимЗаписи <> РежимЗаписиДокумента.Проведение Тогда
		Возврат;
	КонецЕсли;
	
	ОснованиеДляВозвратаПоставщику = ОснованиеДляВозвратаПоставщику(Объект);
	Если ОснованиеДляВозвратаПоставщику <> Неопределено Тогда
		СверитьОстаткиРНПТ(Объект, Отказ, ИмяТч);
	Иначе
		Если НЕ РезервированиеНФА.ЭтоРезервированиеНФА(Объект) Тогда
			ПодобратьРНПТ(Объект, Отказ, ИмяТч);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ТребуетсяДвижениеОперацииСПрослеживаемымиТоварами(ДокументОбъект)
	ТипДокумента = ТипЗнч(ДокументОбъект.Ссылка);
	Если ТипДокумента = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовОС") Тогда
		Возврат УправлениеОсновнымиСредствамиКлиентСервер.ПризнакЕстьПрослеживаемыеТоварыВТабличнойЧасти(ДокументОбъект.ВидПоступления);
	КонецЕсли;
	Если ТипДокумента = Тип("ДокументСсылка.ПередачаОбъектовОС") Тогда
		Возврат НЕ Справочники.Контрагенты.КонтрагентРезидентТаможенногоСоюза(ДокументОбъект.Контрагент);
	КонецЕсли;
	Если ТипДокумента = Тип("ДокументСсылка.СписаниеТранспорта")
			Или ТипДокумента = Тип("ДокументСсылка.СписаниеОбъектовОС") Тогда
		Возврат НЕ ДокументОбъект.ПринятьНаХранение;
	КонецЕсли;
	Если ТипДокумента = Тип("ДокументСсылка.РеконструкцияОС") 
		ИЛИ ТипДокумента = Тип("ДокументСсылка.ВыпускПродукцииСоСчета106")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.ПереводОбъектовОСизГрупповогоУчетаНаИндивидуальный") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
КонецФункции

Функция СтрокиВложенияОСВИзготовлениеОС(ТаблицаПроводок)
	
	Счета106 = БухгалтерскийУчет.СписокСчетов("106.00");
	Счета101 = БухгалтерскийУчет.СписокСчетов("101.00");
	
	ТипОС = Тип("СправочникСсылка.ОсновныеСредства");
	СтрокиВложений = Новый Массив;
	
	Для Каждого Проводка Из ТаблицаПроводок Цикл
		
		ТребуетсяДвижение = Ложь;
		// Проводка вида Дт 106 - Кт 101
		ТребуетсяДвижение = ТребуетсяДвижение
			Или (Счета106.Найти(Проводка.СчетДт) <> Неопределено И Счета101.Найти(Проводка.СчетКт) <> Неопределено);
		// Проводка вида Дт 106 - Кт 106
		ТребуетсяДвижение = ТребуетсяДвижение
			Или (Счета106.Найти(Проводка.СчетДт) <> Неопределено И Счета106.Найти(Проводка.СчетКт) <> Неопределено);
		// Проводка вида Дт 101 - Кт 106
		ТребуетсяДвижение = ТребуетсяДвижение
			Или (Счета101.Найти(Проводка.СчетДт) <> Неопределено И Счета106.Найти(Проводка.СчетКт) <> Неопределено);
		
		Если ТребуетсяДвижение Тогда
			ЕстьСубконтоДтОС = (ТипЗнч(Проводка.СубконтоДт1) = ТипОС
				ИЛИ ТипЗнч(Проводка.СубконтоДт2) = ТипОС
				ИЛИ ТипЗнч(Проводка.СубконтоДт3) = ТипОС);
		
			Если ЕстьСубконтоДтОС Тогда
				СтрокиВложений.Добавить(Проводка);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СтрокиВложений;
	
КонецФункции

Функция СтрокиПереносаОСНаЗабаланс(ТаблицаПроводок)
	Счета02 = Новый Соответствие;
	Для Каждого Счет Из БухгалтерскийУчет.СписокСчетов("02") Цикл
		Счета02.Вставить(Счет, Истина);
	КонецЦикла;
	
	ЗабалансовыеСтроки = Новый Массив;
	Для Каждого Проводка Из ТаблицаПроводок Цикл
		Если Счета02.Получить(Проводка.СчетДт) <> Неопределено Тогда
			ЗабалансовыеСтроки.Добавить(Проводка);
		КонецЕсли;
	КонецЦикла;
	Возврат ЗабалансовыеСтроки;
КонецФункции

Функция СтрокиПеремещенияМЗ (ТаблицаПроводок, ДокументОбъект, ЭтоВыпуск)

	МассивСчетовПроизводствоМЗ = БухгалтерскийУчет.СписокСчетов("106.00", ДокументОбъект.Дата,, ДокументОбъект.Организация);
	Если ЭтоВыпуск Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивСчетовПроизводствоМЗ,
			БухгалтерскийУчет.СписокСчетов("105.00", ДокументОбъект.Дата,, ДокументОбъект.Организация));
	КонецЕсли;
	
	СчетаДляПроизводства = Новый Соответствие;
	Для Каждого Счет Из МассивСчетовПроизводствоМЗ Цикл
		СчетаДляПроизводства.Вставить(Счет, Истина);
	КонецЦикла;

	ПараметрыСчетов = УправлениеМатериальнымиЗапасами.ПараметрыДанныхСчетовУчетаМЗ(ДокументОбъект.Организация, Ложь);
	ПараметрыСчетов.Включать105 = Ложь;
	
	ЗабалансовыеСчета = Новый Соответствие;
	Для Каждого ОписаниеСчета Из УправлениеМатериальнымиЗапасами.СчетаУчетаМатериальныхЗапасов(ПараметрыСчетов) Цикл
		ЗабалансовыеСчета.Вставить(ОписаниеСчета.Счет, Истина);
	КонецЦикла;
	
	Счет109 = Неопределено;
	
	Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.АктСписанияМЗ") Тогда
		Если ТаблицаПроводок.Количество() Тогда
			
			СтрокаПроводка = ТаблицаПроводок[0];
			Если СтрокаПроводка.ВидСубконтоДт1 = ПланыВидовХарактеристик.ВидыСубконто.Номенклатура Тогда
				
				РеквизитыКонтроля = Новый Структура;
				РеквизитыКонтроля.Вставить("Тип", "ТипНоменклатуры");
				РеквизитыКонтроля.Вставить("ПрослеживаемыеТовары", "КомплектСПрослеживаемымиТоварами");
				РеквизитыКонтроля = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаПроводка.СубконтоДт1, РеквизитыКонтроля);
				Если РеквизитыКонтроля.Тип = Перечисления.ТипыНоменклатуры.Работа
					И РеквизитыКонтроля.ПрослеживаемыеТовары Тогда
					
					Счет109 = БухгалтерскийУчет.СчетПоКоду("109.60", ДокументОбъект.Дата, ДокументОбъект.Организация);
					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	СтрокиВложенийПроизводствоМЗ = Новый Массив;
	ЗабалансовыеСтроки = Новый Массив;
	СтрокиВложенийВРаботы = Новый Массив;
	
	Для Каждого Проводка Из ТаблицаПроводок Цикл
		
		Если СчетаДляПроизводства.Получить(Проводка.СчетДт) <> Неопределено Тогда
			СтрокиВложенийПроизводствоМЗ.Добавить(Проводка);
		КонецЕсли;
		
		Если ЗабалансовыеСчета.Получить(Проводка.СчетДт) <> Неопределено Тогда
			ЗабалансовыеСтроки.Добавить(Проводка);
		КонецЕсли;
		
		Если Проводка.СчетДт = Счет109 Тогда
			СтрокиВложенийВРаботы.Добавить(Проводка);
		КонецЕсли;
		
	КонецЦикла;

	СтруктураВозврата = Новый Структура("ТипПеремещения, Строки", Неопределено, Новый Массив);
	
	Если СтрокиВложенийПроизводствоМЗ.Количество() Тогда
		СтруктураВозврата.ТипПеремещения = "Производство";
		СтруктураВозврата.Строки = СтрокиВложенийПроизводствоМЗ;
	ИначеЕсли ЗабалансовыеСтроки.Количество() Тогда
		СтруктураВозврата.ТипПеремещения = "Забаланс";
		СтруктураВозврата.Строки = ЗабалансовыеСтроки;
	ИначеЕсли СтрокиВложенийВРаботы.Количество() И НЕ ЗабалансовыеСтроки.Количество() Тогда
		СтруктураВозврата.ТипПеремещения = "Работы";
		СтруктураВозврата.Строки = СтрокиВложенийВРаботы;
	КонецЕсли;
	
	Возврат СтруктураВозврата;

КонецФункции

Процедура УстановитьСвойстваРНПТ(ТаблицаРНПТ)
	
	Если ТаблицаРНПТ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из ТаблицаРНПТ Цикл
		
		МенеджерЗаписи = РегистрыСведений.СвойстваРНПТ.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, СтрокаТаблицы);
		МенеджерЗаписи.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПодобратьРНПТИзИсходногоДокумента(ДокументОбъект, ОсталосьПодобрать, СтрокаТабличнойЧасти, ТаблицаРНПТИсходныйДокумент)
	
	Если ТаблицаРНПТИсходныйДокумент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИсходныеРНПТ = ТаблицаРНПТИсходныйДокумент.НайтиСтроки(Новый Структура("ИдентификаторСтроки, СтранаПроисхождения", 
	СтрокаТабличнойЧасти.ИдентификаторСтроки, СтрокаТабличнойЧасти.СтранаПроисхождения));
	
	Для Каждого ИсходныйРНПТ ИЗ ИсходныеРНПТ Цикл
		Если ОсталосьПодобрать = 0 Тогда
			Прервать;
		КонецЕсли;
		
		Если ОсталосьПодобрать >= ИсходныйРНПТ.Количество Тогда
			НоваяСтрока = ДокументОбъект.СведенияПрослеживаемости.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ИсходныйРНПТ);
			НоваяСтрока.ИдентификаторСтроки = СтрокаТабличнойЧасти.ИдентификаторСтроки;
			ОсталосьПодобрать = ОсталосьПодобрать - ИсходныйРНПТ.Количество;
			ТаблицаРНПТИсходныйДокумент.Удалить(ИсходныйРНПТ);
		Иначе
			НоваяСтрока = ДокументОбъект.СведенияПрослеживаемости.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ИсходныйРНПТ);
			НоваяСтрока.ИдентификаторСтроки = СтрокаТабличнойЧасти.ИдентификаторСтроки;
			НоваяСтрока.Количество = ОсталосьПодобрать;
			
			МассивКоэффициентов = Новый Массив;
			МассивКоэффициентов.Добавить(ИсходныйРНПТ.Количество - ОсталосьПодобрать);
			МассивКоэффициентов.Добавить(ОсталосьПодобрать);
			МассивСумм = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(
			ИсходныйРНПТ.КоличествоПрослеживаемости, МассивКоэффициентов, 11);
			
			НоваяСтрока.КоличествоПрослеживаемости = МассивСумм[1];
			
			ИсходныйРНПТ.Количество = ИсходныйРНПТ.Количество - ОсталосьПодобрать;
			ИсходныйРНПТ.КоличествоПрослеживаемости = ИсходныйРНПТ.КоличествоПрослеживаемости - МассивСумм[1];
			
			ОсталосьПодобрать = 0;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПодобратьРНПТИзОстатков(ДокументОбъект, ОсталосьПодобрать, СтрокаТабличнойЧасти, ТаблицаРНПТОстатки, Комплект = Ложь)
			
	Отбор = Новый Структура("Номенклатура, Активность", СтрокаТабличнойЧасти.Номенклатура, Истина);
	ТаблицаПотребностейКомплекта = Новый ТаблицаЗначений;
	ТаблицаПотребностейКомплекта.Колонки.Добавить("Комплектующее", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаПотребностейКомплекта.Колонки.Добавить("Потребность", Новый ОписаниеТипов("Число"));
	ПотребностиПоСоставу = Ложь;
	
	Если НЕ Комплект Тогда
		Отбор.Вставить("СтранаПроисхождения", СтрокаТабличнойЧасти.СтранаПроисхождения);
	Иначе
		Если НЕ ЭтоВыпускМЗ(ДокументОбъект) И НЕ ЭтоОказаниеУслуг(ДокументОбъект) Тогда
			Отбор.Вставить("ВариантКомплекта", СтрокаТабличнойЧасти.ВариантКомплектаПТ);
			Параметры = Новый Структура("Номенклатура, Организация, ВариантКомплекта",
			СтрокаТабличнойЧасти.Номенклатура, ДокументОбъект.Организация, СтрокаТабличнойЧасти.ВариантКомплектаПТ);
			ТаблицаПотребностейКомплекта = РегистрыСведений.СоставыКомплектовМЗПТ.ПолучитьТаблицуОбеспеченияКомплекта(Параметры, СтрокаТабличнойЧасти.Количество);
			ПотребностиПоСоставу = Истина;
		КонецЕсли;
	КонецЕсли;
	
	ОстаткиРНПТ = ТаблицаРНПТОстатки.НайтиСтроки(Отбор);
	
	Для Каждого ПодобранныйРНПТ Из ОстаткиРНПТ Цикл
		
		Если ОсталосьПодобрать = 0 И Не Комплект Тогда
			Прервать;
		КонецЕсли;
		
		Если Комплект Тогда
			СтрокиПотребностиКомплектующего = ТаблицаПотребностейКомплекта.НайтиСтроки(Новый Структура("Комплектующее", ПодобранныйРНПТ.Комплектующее));
			Если СтрокиПотребностиКомплектующего.Количество() Тогда
				Если СтрокиПотребностиКомплектующего[0].Потребность = 0 Тогда
					 Продолжить;
				КонецЕсли;
				КоличествоСписания = СтрокиПотребностиКомплектующего[0].Потребность;
			Иначе
				КоличествоСписания = СтрокаТабличнойЧасти.Количество * ПодобранныйРНПТ.КоличествоВложений;
			КонецЕсли;
		Иначе
			КоличествоСписания = ОсталосьПодобрать;
		КонецЕсли;
		
		КоэффициентСписания = КоличествоСписания / ПодобранныйРНПТ.Количество;
		
		НоваяСтрока = ДокументОбъект.СведенияПрослеживаемости.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ПодобранныйРНПТ);
		НоваяСтрока.ИдентификаторСтроки = СтрокаТабличнойЧасти.ИдентификаторСтроки;
		
		Если КоэффициентСписания >= 1 Тогда
			ОстатокСписания = КоличествоСписания - ПодобранныйРНПТ.Количество;
			ОсталосьПодобрать = ?(Комплект, Макс(ОсталосьПодобрать, ОстатокСписания), ОстатокСписания);
			ПодобранныйРНПТ.Активность = Ложь;
		Иначе
			ПараметрыСтроки = Новый Структура("Количество, КоличествоПрослеживаемости, СуммаБезНДС", 0, 0, 0);
			ПараметрыСтроки.Количество = КоличествоСписания;
			ПараметрыСтроки.КоличествоПрослеживаемости = ПодобранныйРНПТ.КоличествоПрослеживаемости * КоэффициентСписания;
			ПараметрыСтроки.СуммаБезНДС = ПодобранныйРНПТ.СуммаБезНДС * КоэффициентСписания;
			
			ПодобранныйРНПТ.Количество = ПодобранныйРНПТ.Количество - ПараметрыСтроки.Количество;
			ПодобранныйРНПТ.КоличествоПрослеживаемости = ПодобранныйРНПТ.КоличествоПрослеживаемости - ПараметрыСтроки.КоличествоПрослеживаемости;
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ПараметрыСтроки);
			ОсталосьПодобрать = 0;
		КонецЕсли;
		
		Если ПотребностиПоСоставу Тогда
			СтрокиПотребностиКомплектующего[0].Потребность = ОсталосьПодобрать;
		КонецЕсли;
		
	КонецЦикла;
			
КонецПроцедуры

Процедура ДоработатьТекстЗапроса(ТекстЗапроса, МетаданныеДокумента)

	ИмяДокумента = МетаданныеДокумента.ПолноеИмя();
	Если МетаданныеДокумента.ТабличныеЧасти.Найти("Номенклатура") <> Неопределено Тогда
		ТЧМатериалы = "Номенклатура";
	Иначе
		ТЧМатериалы = "Материалы";
	КонецЕсли;
	Шаблон = "%1.%2";
	ИмяТаблицыМатериалы = СтрШаблон(Шаблон, ИмяДокумента, ТЧМатериалы);
	ИмяТаблицыСведенияПрослеживаемости = СтрШаблон(Шаблон, ИмяДокумента, "СведенияПрослеживаемости");
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВТ_ТаблицаМатериалы", ИмяТаблицыМатериалы);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВТ_ТаблицаДокумент", ИмяДокумента);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВТ_ТаблицаСведенияПрослеживаемости", ИмяТаблицыСведенияПрослеживаемости);

КонецПроцедуры

Функция ТаблицаРНПТИсходныйДокумент(ДокументОбъект, ТаблицаТоваров)
	
	МетаданныеДокумента = ДокументОбъект.Метаданные();
	Если Не ОбщегоНазначения.ЕстьРеквизитОбъекта("ЭтоКорректировка", МетаданныеДокумента)
		ИЛИ НЕ ДокументОбъект.ЭтоКорректировка Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументРеализации", ДокументОбъект.ДокументОснование);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаСведенияПрослеживаемости.РНПТ КАК РНПТ,
	|	ТаблицаСведенияПрослеживаемости.Комплектующее КАК Комплектующее,
	|	ТаблицаСведенияПрослеживаемости.Количество КАК Количество,
	|	ТаблицаСведенияПрослеживаемости.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости,
	|	ТаблицаСведенияПрослеживаемости.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ТаблицаМатериалы.Номенклатура КАК Номенклатура,
	|	ТаблицаМатериалы.СтранаПроисхождения КАК СтранаПроисхождения
	|ИЗ
	|	ВТ_ТаблицаМатериалы КАК ТаблицаМатериалы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТаблицаСведенияПрослеживаемости КАК ТаблицаСведенияПрослеживаемости
	|		ПО ТаблицаМатериалы.ИдентификаторСтроки = ТаблицаСведенияПрослеживаемости.ИдентификаторСтроки
	|ГДЕ
	|	ТаблицаМатериалы.Ссылка = &ДокументРеализации
	|	И ТаблицаСведенияПрослеживаемости.Ссылка = &ДокументРеализации";
	
	ДоработатьТекстЗапроса(Запрос.Текст, МетаданныеДокумента);
	
	ТаблицаРНПТИсходныйДокумент = Запрос.Выполнить().Выгрузить();
	ТаблицаРНПТИсходныйДокумент.Индексы.Добавить("ИдентификаторСтроки");
	ТаблицаРНПТИсходныйДокумент.Индексы.Добавить("СтранаПроисхождения");
	Возврат ТаблицаРНПТИсходныйДокумент;
	
КонецФункции

Процедура УстановитьПараметрыКорректировкиРНПТОстатки(Запрос, ДокументОбъект)
	
	Запрос.УстановитьПараметр("ЭтоКорректировка", Ложь);
	Запрос.УстановитьПараметр("ДокументОснование", Неопределено);
	Запрос.УстановитьПараметр("ПериодОснование", Дата(1,1,1));
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДокументОбъект, "ЭтоКорректировка")
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДокументОбъект, "ДокументОснование") Тогда
		Если ДокументОбъект.ЭтоКорректировка И ЗначениеЗаполнено(ДокументОбъект.ДокументОснование) Тогда
			Запрос.УстановитьПараметр("ЭтоКорректировка", ДокументОбъект.ЭтоКорректировка);
			Запрос.УстановитьПараметр("ДокументОснование", ДокументОбъект.ДокументОснование);
			Запрос.УстановитьПараметр("ПериодОснование", Новый Граница(ДокументОбъект.ДокументОснование.МоментВремени()));
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ТаблицаРНПТОстатки(ДокументОбъект, ТаблицаТоваров, ЭтоКомиссия)
	
	Попытка
		// Блокируем регистр ПрослеживаемыеТовары для получения остатков
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.ПрослеживаемыеТовары");
		ЭлементБлокировки.УстановитьЗначение("Организация", ДокументОбъект.Организация);
		ЭлементБлокировки.УстановитьЗначение("Период", Новый Диапазон(, ДокументОбъект.Дата));
		ЭлементБлокировки.ИсточникДанных = ТаблицаТоваров;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Номенклатура", "Номенклатура");
		
		Блокировка.Заблокировать();
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Организация",    ДокументОбъект.Организация);
		Запрос.УстановитьПараметр("ТаблицаТоваров", ТаблицаТоваров);
		Запрос.УстановитьПараметр("Субконто", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(
		ПланыВидовХарактеристик.ВидыСубконто.Номенклатура));
		Если ДокументОбъект.Ссылка.Пустая() Тогда
			Период = Новый Граница(ДокументОбъект.Дата, ВидГраницы.Включая);
		Иначе
			Период = Новый Граница(ДокументОбъект.Ссылка.МоментВремени(), ВидГраницы.Исключая);
		КонецЕсли;
		Запрос.УстановитьПараметр("Период", Период);
		УстановитьПараметрыКорректировкиРНПТОстатки(Запрос, ДокументОбъект);
				
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
		|	&ТаблицаТоваровСтранаПроисхождения КАК СтранаПроисхождения,
		|	ТаблицаТоваров.Количество КАК Количество
		|ПОМЕСТИТЬ ТаблицаТоваров
		|ИЗ
		|	&ТаблицаТоваров КАК ТаблицаТоваров
		|ГДЕ
		|	ТаблицаТоваров.Количество > 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОстаткиРНПТИтоги.Организация КАК Организация,
		|	ОстаткиРНПТИтоги.РНПТ КАК РНПТ,
		|	ОстаткиРНПТИтоги.Номенклатура КАК Номенклатура,
		|	ОстаткиРНПТИтоги.Комплектующее КАК Комплектующее,
		|	ОстаткиРНПТИтоги.ВариантКомплекта КАК ВариантКомплекта,
		|	ОстаткиРНПТИтоги.СтранаПроисхождения КАК СтранаПроисхождения,
		|	СУММА(ОстаткиРНПТИтоги.КоличествоОстаток) КАК КоличествоОстаток,
		|	СУММА(ОстаткиРНПТИтоги.КоличествоПрослеживаемостиОстаток) КАК КоличествоПрослеживаемостиОстаток,
		|	СУММА(ОстаткиРНПТИтоги.СуммаБезНДСОстаток) КАК СуммаБезНДСОстаток
		|ПОМЕСТИТЬ ПрослеживаемыеТоварыОстатки
		|ИЗ
		|	(ВЫБРАТЬ
		|		ПрослеживаемыеТоварыОстатки.Организация КАК Организация,
		|		ПрослеживаемыеТоварыОстатки.РНПТ КАК РНПТ,
		|		ПрослеживаемыеТоварыОстатки.Номенклатура КАК Номенклатура,
		|		ПрослеживаемыеТоварыОстатки.Комплектующее КАК Комплектующее,
		|		ПрослеживаемыеТоварыОстатки.ВариантКомплекта КАК ВариантКомплекта,
		|		ПрослеживаемыеТоварыОстатки.СтранаПроисхождения КАК СтранаПроисхождения,
		|		ПрослеживаемыеТоварыОстатки.КоличествоОстаток КАК КоличествоОстаток,
		|		ПрослеживаемыеТоварыОстатки.КоличествоПрослеживаемостиОстаток КАК КоличествоПрослеживаемостиОстаток,
		|		ПрослеживаемыеТоварыОстатки.СуммаБезНДСОстаток КАК СуммаБезНДСОстаток
		|	ИЗ
		|		РегистрНакопления.ПрослеживаемыеТовары.Остатки(
		|				&Период,
		|				Организация = &Организация
		|					И Номенклатура В
		|						(ВЫБРАТЬ
		|							ТаблицаТоваров.Номенклатура КАК Номенклатура
		|						ИЗ
		|							ТаблицаТоваров КАК ТаблицаТоваров)) КАК ПрослеживаемыеТоварыОстатки
		|	ГДЕ
		|		ПрослеживаемыеТоварыОстатки.КоличествоОстаток > 0
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ПрослеживаемыеТоварыОбороты.Организация,
		|		ПрослеживаемыеТоварыОбороты.РНПТ,
		|		ПрослеживаемыеТоварыОбороты.Номенклатура,
		|		ПрослеживаемыеТоварыОбороты.Комплектующее,
		|		ПрослеживаемыеТоварыОбороты.ВариантКомплекта,
		|		ПрослеживаемыеТоварыОбороты.СтранаПроисхождения,
		|		ПрослеживаемыеТоварыОбороты.КоличествоРасход,
		|		ПрослеживаемыеТоварыОбороты.КоличествоПрослеживаемостиРасход,
		|		ПрослеживаемыеТоварыОбороты.СуммаБезНДСРасход
		|	ИЗ
		|		РегистрНакопления.ПрослеживаемыеТовары.Обороты(
		|				&ПериодОснование,
		|				&ПериодОснование,
		|				Регистратор,
		|				Организация = &Организация
		|					И &ЭтоКорректировка
		|					И Номенклатура В
		|						(ВЫБРАТЬ
		|							ТаблицаТоваров.Номенклатура КАК Номенклатура
		|						ИЗ
		|							ТаблицаТоваров КАК ТаблицаТоваров)) КАК ПрослеживаемыеТоварыОбороты
		|	ГДЕ
		|		ПрослеживаемыеТоварыОбороты.Регистратор = &ДокументОснование) КАК ОстаткиРНПТИтоги
		|
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиРНПТИтоги.Организация,
		|	ОстаткиРНПТИтоги.РНПТ,
		|	ОстаткиРНПТИтоги.Номенклатура,
		|	ОстаткиРНПТИтоги.Комплектующее,
		|	ОстаткиРНПТИтоги.ВариантКомплекта,
		|	ОстаткиРНПТИтоги.СтранаПроисхождения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
		|	ТаблицаТоваров.СтранаПроисхождения КАК СтранаПроисхождения,
		|	ПрослеживаемыеТоварыОстатки.Комплектующее КАК Комплектующее,
		|	ПрослеживаемыеТоварыОстатки.ВариантКомплекта КАК ВариантКомплекта,
		|	ПрослеживаемыеТоварыОстатки.КоличествоОстаток КАК Количество,
		|	1 КАК КоличествоВложений,
		|	ПрослеживаемыеТоварыОстатки.КоличествоПрослеживаемостиОстаток КАК КоличествоПрослеживаемости,
		|	ПрослеживаемыеТоварыОстатки.РНПТ КАК РНПТ,
		|	ПрослеживаемыеТоварыОстатки.СуммаБезНДСОстаток КАК СуммаБезНДС,
		|	СвойстваРНПТ.ДатаПоступления КАК ДатаПоступления,
		|	ПрослеживаемыеТоварыОстатки.РНПТ.Код КАК РНПТКод,
		|	ЛОЖЬ КАК Комплект,
		|	ИСТИНА КАК Активность
		|ИЗ
		|	ТаблицаТоваров КАК ТаблицаТоваров
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПрослеживаемыеТоварыОстатки КАК ПрослеживаемыеТоварыОстатки
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвойстваРНПТ КАК СвойстваРНПТ
		|			ПО ПрослеживаемыеТоварыОстатки.Организация = СвойстваРНПТ.Организация
		|				И ПрослеживаемыеТоварыОстатки.РНПТ = СвойстваРНПТ.РНПТ
		|		ПО ТаблицаТоваров.Номенклатура = ПрослеживаемыеТоварыОстатки.Номенклатура
		|			И ТаблицаТоваров.СтранаПроисхождения = ПрослеживаемыеТоварыОстатки.СтранаПроисхождения
		|ГДЕ
		|	ПрослеживаемыеТоварыОстатки.Комплектующее = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ТаблицаТоваров.Номенклатура,
		|	ПрослеживаемыеТоварыОстатки.СтранаПроисхождения,
		|	ПрослеживаемыеТоварыОстатки.Комплектующее,
		|	ПрослеживаемыеТоварыОстатки.ВариантКомплекта,
		|	ПрослеживаемыеТоварыОстатки.КоличествоОстаток,
		|	ВЫБОР
		|		КОГДА НЕ СоставыКомплектовМЗПТ.КоличествоВложений ЕСТЬ NULL
		|			ТОГДА СоставыКомплектовМЗПТ.КоличествоВложений
		|		ИНАЧЕ ПрослеживаемыеТоварыОстатки.КоличествоПрослеживаемостиОстаток / ТаблицаТоваров.Количество
		|	КОНЕЦ,
		|	ПрослеживаемыеТоварыОстатки.КоличествоПрослеживаемостиОстаток,
		|	ПрослеживаемыеТоварыОстатки.РНПТ,
		|	ПрослеживаемыеТоварыОстатки.СуммаБезНДСОстаток,
		|	СвойстваРНПТ.ДатаПоступления,
		|	ПрослеживаемыеТоварыОстатки.РНПТ.Код,
		|	ИСТИНА,
		|	ИСТИНА
		|ИЗ
		|	ТаблицаТоваров КАК ТаблицаТоваров
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПрослеживаемыеТоварыОстатки КАК ПрослеживаемыеТоварыОстатки
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвойстваРНПТ КАК СвойстваРНПТ
		|			ПО ПрослеживаемыеТоварыОстатки.Организация = СвойстваРНПТ.Организация
		|				И ПрослеживаемыеТоварыОстатки.РНПТ = СвойстваРНПТ.РНПТ
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоставыКомплектовМЗПТ КАК СоставыКомплектовМЗПТ
		|			ПО ПрослеживаемыеТоварыОстатки.Организация = СоставыКомплектовМЗПТ.Организация
		|				И ПрослеживаемыеТоварыОстатки.Номенклатура = СоставыКомплектовМЗПТ.Комплект
		|				И ПрослеживаемыеТоварыОстатки.Комплектующее = СоставыКомплектовМЗПТ.Комплектующее
		|				И ПрослеживаемыеТоварыОстатки.ВариантКомплекта = СоставыКомплектовМЗПТ.ВариантКомплекта
		|		ПО ТаблицаТоваров.Номенклатура = ПрослеживаемыеТоварыОстатки.Номенклатура
		|ГДЕ
		|	ПрослеживаемыеТоварыОстатки.Комплектующее <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаПоступления,
		|	РНПТКод";
		
		Если ЭтоОказаниеУслуг(ДокументОбъект) Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТаблицаТоваровСтранаПроисхождения", "ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)");
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТаблицаТоваровСтранаПроисхождения", "ТаблицаТоваров.СтранаПроисхождения");
		КонецЕсли;

		ТаблицаРНПТОстатки = Запрос.Выполнить().Выгрузить();
	
	Исключение
		ВызватьИсключение;
	КонецПопытки;
	
	ТаблицаРНПТОстатки.Индексы.Добавить("Комплект");
	
	Возврат ТаблицаРНПТОстатки;
	
КонецФункции

Функция ОстаткиРНПТОС(Объект) Экспорт
	
	ТаблицаОС = Новый ТаблицаЗначений;
	ТаблицаОС.Колонки.Добавить("ОсновноеСредство", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ТаблицаОС.Колонки.Добавить("СтранаПроисхождения", Новый ОписаниеТипов("СправочникСсылка.СтраныМира"));
	
	ОбъектыСПроцедуройВМенеджере = Новый Массив;
	ОбъектыСПроцедуройВМенеджере.Добавить(Тип("ДокументОбъект.ПереводОбъектовОСизГрупповогоУчетаНаИндивидуальный"));
	
	Если ОбъектыСПроцедуройВМенеджере.Найти(ТипЗнч(Объект)) <> Неопределено Тогда
		МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Объект.Ссылка);
		МенеджерОбъекта.ТаблицаОСдляОстатковРНПТ(Объект, ТаблицаОС)
	Иначе	
		ЕстьРеквизитВнеоборотныйАктив = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "ВнеоборотныйАктив");
		ЕстьРеквизитОсновноеСредство = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "ОсновноеСредство");
		ЕстьРеквизитКапитальноеВложение = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "КапитальноеВложение");
		Если ЕстьРеквизитВнеоборотныйАктив
			Или ЕстьРеквизитОсновноеСредство
			Или ЕстьРеквизитКапитальноеВложение Тогда
			НоваяСтрока = ТаблицаОС.Добавить();
			Если ЕстьРеквизитВнеоборотныйАктив Тогда
				НоваяСтрока.ОсновноеСредство = Объект.ВнеоборотныйАктив;
			ИначеЕсли ЕстьРеквизитОсновноеСредство Тогда
				НоваяСтрока.ОсновноеСредство = Объект.ОсновноеСредство;
			ИначеЕсли ЕстьРеквизитКапитальноеВложение Тогда
				НоваяСтрока.ОсновноеСредство = Объект.КапитальноеВложение;
			КонецЕсли;
			НоваяСтрока.СтранаПроисхождения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НоваяСтрока.ОсновноеСредство, "СтранаПроисхождения");
		Иначе
			Для каждого СтрокаОС Из Объект.ОсновныеСредства Цикл
				ЗаполнитьЗначенияСвойств(ТаблицаОС.Добавить(), СтрокаОС);
			КонецЦикла; 
		КонецЕсли;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Если Объект.Ссылка.Пустая() Тогда
		Период = Новый Граница(Объект.Дата, ВидГраницы.Включая);
	Иначе
		Период = Новый Граница(Объект.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("ТаблицаОС", ТаблицаОС);
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаОС.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОС.СтранаПроисхождения КАК СтранаПроисхождения
	|ПОМЕСТИТЬ ТаблицаОС
	|ИЗ
	|	&ТаблицаОС КАК ТаблицаОС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПрослеживаемыеОСОстатки.РНПТ КАК РНПТ,
	|	ПрослеживаемыеОСОстатки.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ПрослеживаемыеОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	ВЫБОР
	|		КОГДА ПрослеживаемыеОСОстатки.Комплектующее = ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)
	|				ИЛИ ПрослеживаемыеОСОстатки.Комплектующее = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ПрослеживаемыеОСОстатки.Комплектующее
	|	КОНЕЦ КАК Комплектующее,
	|	СУММА(ПрослеживаемыеОСОстатки.КоличествоОстаток) КАК КоличествоОстаток,
	|	СУММА(ПрослеживаемыеОСОстатки.КоличествоПрослеживаемостиОстаток) КАК КоличествоПрослеживаемостиОстаток,
	|	СУММА(ПрослеживаемыеОСОстатки.СуммаБезНДСОстаток) КАК СуммаБезНДСОстаток
	|ПОМЕСТИТЬ ОстаткиРНПТ
	|ИЗ
	|	РегистрНакопления.ПрослеживаемыеОС.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						ТаблицаОС.ОсновноеСредство КАК ОсновноеСредство
	|					ИЗ
	|						ТаблицаОС КАК ТаблицаОС)) КАК ПрослеживаемыеОСОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ПрослеживаемыеОСОстатки.РНПТ,
	|	ПрослеживаемыеОСОстатки.СтранаПроисхождения,
	|	ПрослеживаемыеОСОстатки.ОсновноеСредство,
	|	ВЫБОР
	|		КОГДА ПрослеживаемыеОСОстатки.Комплектующее = ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)
	|				ИЛИ ПрослеживаемыеОСОстатки.Комплектующее = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ПрослеживаемыеОСОстатки.Комплектующее
	|	КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаОС.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОС.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ОстаткиРНПТ.Комплектующее КАК Комплектующее,
	|	ОстаткиРНПТ.РНПТ КАК РНПТ,
	|	ЕСТЬNULL(ОстаткиРНПТ.КоличествоОстаток, 0) КАК Количество,
	|	ЕСТЬNULL(ОстаткиРНПТ.КоличествоПрослеживаемостиОстаток, 0) КАК КоличествоПрослеживаемости,
	|	ЕСТЬNULL(ОстаткиРНПТ.СуммаБезНДСОстаток, 0) КАК СуммаБезНДС,
	|	ЕСТЬNULL(СвойстваРНПТ.ДатаПоступления, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаПоступления,
	|	ОстаткиРНПТ.РНПТ.Код КАК РНПТКод
	|ИЗ
	|	ТаблицаОС КАК ТаблицаОС
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиРНПТ КАК ОстаткиРНПТ
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвойстваРНПТ КАК СвойстваРНПТ
	|			ПО ОстаткиРНПТ.РНПТ = СвойстваРНПТ.РНПТ
	|				И (СвойстваРНПТ.Организация = &Организация)
	|		ПО ТаблицаОС.ОсновноеСредство = ОстаткиРНПТ.ОсновноеСредство
	|			И ТаблицаОС.СтранаПроисхождения = ОстаткиРНПТ.СтранаПроисхождения
	|ГДЕ
	|	ОстаткиРНПТ.Комплектующее = НЕОПРЕДЕЛЕНО
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаОС.ОсновноеСредство,
	|	ОстаткиРНПТ.СтранаПроисхождения,
	|	ОстаткиРНПТ.Комплектующее,
	|	ОстаткиРНПТ.РНПТ,
	|	ЕСТЬNULL(ОстаткиРНПТ.КоличествоОстаток, 0),
	|	ЕСТЬNULL(ОстаткиРНПТ.КоличествоПрослеживаемостиОстаток, 0),
	|	ЕСТЬNULL(ОстаткиРНПТ.СуммаБезНДСОстаток, 0),
	|	ЕСТЬNULL(СвойстваРНПТ.ДатаПоступления, ДАТАВРЕМЯ(1, 1, 1)),
	|	ОстаткиРНПТ.РНПТ.Код
	|ИЗ
	|	ТаблицаОС КАК ТаблицаОС
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиРНПТ КАК ОстаткиРНПТ
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СвойстваРНПТ КАК СвойстваРНПТ
	|			ПО ОстаткиРНПТ.РНПТ = СвойстваРНПТ.РНПТ
	|				И (СвойстваРНПТ.Организация = &Организация)
	|		ПО ТаблицаОС.ОсновноеСредство = ОстаткиРНПТ.ОсновноеСредство
	|ГДЕ
	|	ОстаткиРНПТ.Комплектующее <> НЕОПРЕДЕЛЕНО
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаПоступления,
	|	РНПТКод";
	
	Результат = Запрос.Выполнить().Выгрузить();
	Возврат Результат;

КонецФункции

Процедура СверитьОстаткиРНПТ(ДокументОбъект, Отказ, ИмяТабличнойЧасти, ДокументОснованиеВТЧ = Ложь) Экспорт
	
	ТаблицаТоваров = ДокументОбъект[ИмяТабличнойЧасти].Выгрузить();
	ТаблицаРНПТОстатки = ТаблицаРНПТОстаткиВозвратПоставщику(ДокументОбъект, ТаблицаТоваров, ДокументОснованиеВТЧ);
	ТаблицаРНПТОстаткиКомплекты = ТаблицаРНПТОстатки.Скопировать(Новый Структура("Комплект", Истина));
	ТаблицаРНПТОстаткиТовары = ТаблицаРНПТОстатки.Скопировать(Новый Структура("Комплект", Ложь));
	
	Для Каждого СтрокаТабличнойЧасти ИЗ ДокументОбъект[ИмяТабличнойЧасти] Цикл
		Если НЕ СтрокаТабличнойЧасти.ПрослеживаемыйТовар Тогда
			Продолжить;
		КонецЕсли;
		
		Комплект = СтрокаТабличнойЧасти.КомплектСПрослеживаемымиТоварами;
		
		Если ДокументОснованиеВТЧ Тогда
			Если НЕ ЗначениеЗаполнено(СтрокаТабличнойЧасти.Сделка) Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		СтрокиСРНПТ = ДокументОбъект.СведенияПрослеживаемости.НайтиСтроки(
		Новый Структура("ИдентификаторСтроки", СтрокаТабличнойЧасти.ИдентификаторСтроки));
		Для Каждого СтрокаСРНПТ ИЗ СтрокиСРНПТ Цикл
			Если Комплект Тогда
				СверитьСОстаткамиВПрослеживаемости(ДокументОбъект, Отказ, СтрокаСРНПТ, 
									СтрокаТабличнойЧасти, ТаблицаРНПТОстаткиКомплекты, ИмяТабличнойЧасти,,,Комплект);
			Иначе
				СверитьСОстаткамиВПрослеживаемости(ДокументОбъект, Отказ, СтрокаСРНПТ, 
									СтрокаТабличнойЧасти, ТаблицаРНПТОстаткиТовары, ИмяТабличнойЧасти,,,Комплект);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Функция ТаблицаРНПТОстаткиВозвратПоставщику(ДокументОбъект, ТаблицаТоваров, УказыватьСделкуВСтроке)
	// Блокируем регистр ПрослеживаемыеТовары для получения остатков
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.ПрослеживаемыеТовары");
	ЭлементБлокировки.УстановитьЗначение("Организация", ДокументОбъект.Организация);
	ЭлементБлокировки.УстановитьЗначение("Период", Новый Диапазон(, ДокументОбъект.Дата));
	ЭлементБлокировки.ИсточникДанных = ТаблицаТоваров;
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Номенклатура", "Номенклатура");
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("СтранаПроисхождения", "СтранаПроисхождения");

	Блокировка.Заблокировать();

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация",            ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("Основание",              ДокументОбъект.ДокументОснование);
	Запрос.УстановитьПараметр("ТаблицаТоваров",         ТаблицаТоваров);
	Запрос.УстановитьПараметр("ТекущийДокумент",        ДокументОбъект.Ссылка);
	Запрос.УстановитьПараметр("ДатаТекущегоДокумента",  КонецДня(ДокументОбъект.Дата));
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаТоваров.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ ТаблицаТоваров
	|ИЗ
	|	&ТаблицаТоваров КАК ТаблицаТоваров
	|ГДЕ
	|	ТаблицаТоваров.ПрослеживаемыйТовар = ИСТИНА
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПоступленияМинусВозврат.Номенклатура КАК Номенклатура,
	|	ПоступленияМинусВозврат.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ПоступленияМинусВозврат.ВариантКомплекта КАК ВариантКомплекта,
	|	ПоступленияМинусВозврат.Комплектующее КАК Комплектующее,
	|	ПоступленияМинусВозврат.РНПТ КАК РНПТ,
	|	СУММА(ПоступленияМинусВозврат.Количество) КАК Количество,
	|	СУММА(ПоступленияМинусВозврат.КоличествоПрослеживаемости) КАК КоличествоПрослеживаемости,
	|	ПоступленияМинусВозврат.Комплект КАК Комплект,
	|	СУММА(ПоступленияМинусВозврат.СуммаБезНДС) КАК СуммаБезНДС,
	|	ПоступленияМинусВозврат.Активность КАК Активность
	|ПОМЕСТИТЬ ПоступленияМинусВозвратСводно
	|ИЗ
	|	(ВЫБРАТЬ
	|		ПоступившиеТовары.Номенклатура КАК Номенклатура,
	|		ПоступившиеТовары.Количество КАК Количество,
	|		ПоступившиеТовары.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости,
	|		ПоступившиеТовары.РНПТ КАК РНПТ,
	|		ПоступившиеТовары.СтранаПроисхождения КАК СтранаПроисхождения,
	|		ПоступившиеТовары.Комплектующее <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка) КАК Комплект,
	|		ПоступившиеТовары.ВариантКомплекта КАК ВариантКомплекта,
	|		ПоступившиеТовары.Комплектующее КАК Комплектующее,
	|		ПоступившиеТовары.СуммаБезНДС КАК СуммаБезНДС,
	|		ИСТИНА КАК Активность
	|	ИЗ
	|		РегистрНакопления.ПрослеживаемыеТовары КАК ПоступившиеТовары
	|	ГДЕ
	|		ПоступившиеТовары.Номенклатура В
	|				(ВЫБРАТЬ
	|					ТаблицаТоваров.Номенклатура
	|				ИЗ
	|					ТаблицаТоваров)
	|		И ПоступившиеТовары.Регистратор = &Основание
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ВозвращенныеТовары.Номенклатура,
	|		ВЫБОР
	|			КОГДА ВозвращенныеТовары.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|				ТОГДА ВозвращенныеТовары.Количество
	|			ИНАЧЕ -ВозвращенныеТовары.Количество
	|		КОНЕЦ,
	|		ВЫБОР
	|			КОГДА ВозвращенныеТовары.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|				ТОГДА ВозвращенныеТовары.КоличествоПрослеживаемости
	|			ИНАЧЕ -ВозвращенныеТовары.КоличествоПрослеживаемости
	|		КОНЕЦ,
	|		ВозвращенныеТовары.РНПТ,
	|		ВозвращенныеТовары.СтранаПроисхождения,
	|		ВозвращенныеТовары.Комплектующее <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка),
	|		ВозвращенныеТовары.ВариантКомплекта,
	|		ВозвращенныеТовары.Комплектующее,
	|		ВЫБОР
	|			КОГДА ВозвращенныеТовары.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|				ТОГДА -ВозвращенныеТовары.СуммаБезНДС
	|			ИНАЧЕ ВозвращенныеТовары.СуммаБезНДС
	|		КОНЕЦ,
	|		ИСТИНА
	|	ИЗ
	|		ТаблицаТоваров КАК ТаблицаТоваров
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ПрослеживаемыеТовары КАК ВозвращенныеТовары
	|			ПО (&Организация = ВозвращенныеТовары.Организация)
	|				И ТаблицаТоваров.Номенклатура = ВозвращенныеТовары.Номенклатура
	|				И (ВозвращенныеТовары.Период <= &ДатаТекущегоДокумента)
	|				И (ВозвращенныеТовары.Регистратор <> &ТекущийДокумент)
	|	ГДЕ
	|		ВозвращенныеТовары.Номенклатура В
	|				(ВЫБРАТЬ
	|					ТаблицаТоваров.Номенклатура
	|				ИЗ
	|					ТаблицаТоваров)
	|		И ВозвращенныеТовары.ОснованиеДляВозврата = &Основание) КАК ПоступленияМинусВозврат
	|
	|СГРУППИРОВАТЬ ПО
	|	ПоступленияМинусВозврат.РНПТ,
	|	ПоступленияМинусВозврат.Номенклатура,
	|	ПоступленияМинусВозврат.Комплект,
	|	ПоступленияМинусВозврат.ВариантКомплекта,
	|	ПоступленияМинусВозврат.Комплектующее,
	|	ПоступленияМинусВозврат.Активность,
	|	ПоступленияМинусВозврат.СтранаПроисхождения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПоступленияМинусВозвратСводно.Номенклатура КАК Номенклатура,
	|	ПоступленияМинусВозвратСводно.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ПоступленияМинусВозвратСводно.ВариантКомплекта КАК ВариантКомплекта,
	|	ПоступленияМинусВозвратСводно.Комплектующее КАК Комплектующее,
	|	ПоступленияМинусВозвратСводно.РНПТ КАК РНПТ,
	|	ПоступленияМинусВозвратСводно.Количество КАК Количество,
	|	ПоступленияМинусВозвратСводно.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости,
	|	ПоступленияМинусВозвратСводно.СуммаБезНДС КАК СуммаБезНДС,
	|	ПоступленияМинусВозвратСводно.Активность КАК Активность,
	|	ЕСТЬNULL(СоставыКомплектовМЗПТ.КоличествоВложений, 1) КАК КоличествоВложений,
	|	ПоступленияМинусВозвратСводно.Комплект КАК Комплект
	|ИЗ
	|	ПоступленияМинусВозвратСводно КАК ПоступленияМинусВозвратСводно
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоставыКомплектовМЗПТ КАК СоставыКомплектовМЗПТ
	|		ПО ПоступленияМинусВозвратСводно.Номенклатура = СоставыКомплектовМЗПТ.Комплект
	|			И ПоступленияМинусВозвратСводно.ВариантКомплекта = СоставыКомплектовМЗПТ.ВариантКомплекта
	|			И (&Организация = СоставыКомплектовМЗПТ.Организация)
	|			И ПоступленияМинусВозвратСводно.Комплектующее = СоставыКомплектовМЗПТ.Комплектующее
	|ГДЕ
	|	ПоступленияМинусВозвратСводно.Количество > 0";
	
	ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	
	ТаблицаРезультат.Индексы.Добавить("Номенклатура, СтранаПроисхождения, Комплектующее, ВариантКомплекта, Комплект, Активность");
	
	Возврат ТаблицаРезультат;
	
КонецФункции

Процедура СверитьОстаткиСИсходнымДокументомРеализации(СтрокаТабличнойЧасти, ТаблицаРНПТИсходныйДокумент, ТребуемоеКоличество, ТребуемоеКоличествоПрослеживаемости)
	
	Если ТаблицаРНПТИсходныйДокумент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОтборИсходныйДокумент = Новый Структура("ИдентификаторСтроки, СтранаПроисхождения", 
	СтрокаТабличнойЧасти.ИдентификаторСтроки, СтрокаТабличнойЧасти.СтранаПроисхождения);
	ИсходныеРНПТ = ТаблицаРНПТИсходныйДокумент.НайтиСтроки(ОтборИсходныйДокумент);
	Для Каждого ИсходныйРНПТ ИЗ ИсходныеРНПТ Цикл
		Если ТребуемоеКоличество = 0 И ТребуемоеКоличествоПрослеживаемости = 0 Тогда
			Прервать;
		КонецЕсли;
		Если ИсходныйРНПТ.Количество <= ТребуемоеКоличество
			И ИсходныйРНПТ.КоличествоПрослеживаемости <= ТребуемоеКоличествоПрослеживаемости Тогда
			ТребуемоеКоличество = ТребуемоеКоличество - ИсходныйРНПТ.Количество;
			ТребуемоеКоличествоПрослеживаемости = ТребуемоеКоличествоПрослеживаемости - ИсходныйРНПТ.КоличествоПрослеживаемости;
			ТаблицаРНПТИсходныйДокумент.Удалить(ИсходныйРНПТ);
		Иначе
			Если ИсходныйРНПТ.Количество > ТребуемоеКоличество Тогда
				ИсходныйРНПТ.Количество = ИсходныйРНПТ.Количество - ТребуемоеКоличество;
				ТребуемоеКоличество = 0;
			Иначе
				ТребуемоеКоличество = ТребуемоеКоличество - ИсходныйРНПТ.Количество;
			КонецЕсли;
			Если ИсходныйРНПТ.КоличествоПрослеживаемости > ТребуемоеКоличествоПрослеживаемости Тогда
				ИсходныйРНПТ.КоличествоПрослеживаемости = ИсходныйРНПТ.КоличествоПрослеживаемости - ТребуемоеКоличествоПрослеживаемости;
				ТребуемоеКоличествоПрослеживаемости = 0;
			Иначе
				ТребуемоеКоличествоПрослеживаемости = ТребуемоеКоличествоПрослеживаемости - ИсходныйРНПТ.КоличествоПрослеживаемости;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура СверитьСОстаткамиВПрослеживаемости(ДокументОбъект, Отказ, СтрокаСРНПТ, СтрокаТабличнойЧасти, ТаблицаРНПТОстатки, ИмяТабличнойЧасти,
											ЭтоВыпускПродукции = Ложь, ДокументОснованиеВТЧ = Ложь, Комплект)
	
	ТребуемоеКоличество = СтрокаСРНПТ.Количество;
	ТребуемоеКоличествоПрослеживаемости = СтрокаСРНПТ.КоличествоПрослеживаемости; 
	ТребуемоеКоличествоПереопределение = 0;
	КонтрольКоличестваВДокументе = Истина;
	Отбор = Новый Структура("Номенклатура, РНПТ, Активность", СтрокаТабличнойЧасти.Номенклатура, СтрокаСРНПТ.РНПТ, Истина);
	
	Если НЕ Комплект Тогда
		Отбор.Вставить("СтранаПроисхождения",СтрокаТабличнойЧасти.СтранаПроисхождения);
	Иначе
		Отбор.Вставить("Комплектующее", СтрокаСРНПТ.Комплектующее);
		Если НЕ ЭтоВыпускМЗ(ДокументОбъект) И НЕ ЭтоОказаниеУслуг(ДокументОбъект) Тогда
			Отбор.Вставить("ВариантКомплекта", СтрокаТабличнойЧасти.ВариантКомплектаПТ);
		Иначе
			КонтрольКоличестваВДокументе = Ложь;
		КонецЕсли;
	КонецЕсли;

	ОтборСведения = Новый Структура("ИдентификаторСтроки, Комплектующее", СтрокаСРНПТ.ИдентификаторСтроки, СтрокаСРНПТ.Комплектующее);

	СтрокиПовторов = ДокументОбъект.СведенияПрослеживаемости.НайтиСтроки(ОтборСведения);
	Если СтрокиПовторов.Количество() > 1 Тогда
		Для Каждого СтрокаПовтора Из СтрокиПовторов Цикл
			ТребуемоеКоличествоПереопределение = ТребуемоеКоличествоПереопределение + СтрокаПовтора.Количество;
		КонецЦикла;
	КонецЕсли;
		
	ОстаткиРНПТ = ТаблицаРНПТОстатки.НайтиСтроки(Отбор);
	
	Если ОстаткиРНПТ.Количество() = 0
		ИЛИ ОстаткиРНПТ[0].Количество < ТребуемоеКоличество
		ИЛИ ОстаткиРНПТ[0].КоличествоПрослеживаемости < ТребуемоеКоличествоПрослеживаемости Тогда
		Если ЭтоВыпускПродукции Тогда
			ИмяТабличнойЧасти = "Продукция";
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Для целей учета прослеживаемости не списано %1 РНПТ %2 по материалу %3'"),
			Формат(ТребуемоеКоличество, "ЧЦ=15; ЧДЦ=3"),
			СтрокаСРНПТ.РНПТ,
			СтрокаТабличнойЧасти.Номенклатура);
			СтрокаПродукции = ДокументОбъект.Продукция.Найти(СтрокаТабличнойЧасти.КлючСтроки, "КлючСтроки");
			НомерСтроки = ?(СтрокаПродукции = Неопределено, 0,СтрокаПродукции.НомерСтроки-1);
			Поле = "" + ИмяТабличнойЧасти + "["+ Формат(НомерСтроки,"ЧГ=") + "].Материалы";
			
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ДокументОбъект.Ссылка, Поле, , Отказ);
			
		Иначе
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Для целей учета прослеживаемости не списано %1 РНПТ %2'"),
			Формат(ТребуемоеКоличество, "ЧЦ=15; ЧДЦ=3"),
			СтрокаСРНПТ.РНПТ);
			Поле = "" + ИмяТабличнойЧасти + "["+ Формат(СтрокаТабличнойЧасти.НомерСтроки-1,"ЧГ=") + "].РНПТ";
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ДокументОбъект.Ссылка, Поле, "Объект", Отказ);
		КонецЕсли;
		
	Иначе
		
		Если СтрокаТабличнойЧасти.Количество * ОстаткиРНПТ[0].КоличествоВложений
			<> ?(ТребуемоеКоличествоПереопределение = 0, ТребуемоеКоличество, ТребуемоеКоличествоПереопределение) И КонтрольКоличестваВДокументе Тогда
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Количество в документе не соответствует количеству РНПТ %1 РНПТ %2'"),
			Формат(ТребуемоеКоличество, "ЧЦ=15; ЧДЦ=3"),
			СтрокаСРНПТ.РНПТ);
			Поле = "" + ИмяТабличнойЧасти + "["+ Формат(СтрокаТабличнойЧасти.НомерСтроки-1,"ЧГ=") + "].РНПТ";
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ДокументОбъект.Ссылка, Поле, "Объект", Отказ);

		Иначе
			Если ОстаткиРНПТ[0].Количество > ТребуемоеКоличество
				И ОстаткиРНПТ[0].КоличествоПрослеживаемости > ТребуемоеКоличествоПрослеживаемости Тогда
				ОстаткиРНПТ[0].Количество = ОстаткиРНПТ[0].Количество - ТребуемоеКоличество;
				ОстаткиРНПТ[0].КоличествоПрослеживаемости = ОстаткиРНПТ[0].КоличествоПрослеживаемости - ТребуемоеКоличествоПрослеживаемости;
			Иначе
				ОстаткиРНПТ[0].Активность = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Функция ОтражатьВПрослеживаемости(ОбъектСсылка) Экспорт
	
	РеквизитыДляЗапроса = Новый Массив;
	
	Если ТипЗнч(ОбъектСсылка) = Тип("ДокументСсылка.АктОбУтилизацииМЗ")
		Или ТипЗнч(ОбъектСсылка) = Тип("ДокументОбъект.АктОбУтилизацииМЗ") Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ОтражатьВПрослеживаемости", ОбъектСсылка.Метаданные()) Тогда
		РеквизитыДляЗапроса.Добавить("ОтражатьВПрослеживаемости");
	КонецЕсли;
	
	Если ТипЗнч(ОбъектСсылка) = Тип("ДокументСсылка.ПоступлениеМЗ")
		Или ТипЗнч(ОбъектСсылка) = Тип("ДокументОбъект.ПоступлениеМЗ") Тогда
		РеквизитыДляЗапроса.Добавить("ВидПоступленияМЗ");
	КонецЕсли;
	
	Если ТипЗнч(ОбъектСсылка) = Тип("ДокументСсылка.НакладнаяНаОтпускМ15")
		Или ТипЗнч(ОбъектСсылка) = Тип("ДокументОбъект.НакладнаяНаОтпускМ15") Тогда
		РеквизитыДляЗапроса.Добавить("ВидПередачиМЗ");
	КонецЕсли;
	
	Если РеквизитыДляЗапроса.Количество() > 0 Тогда
		Если Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(ОбъектСсылка)) Тогда
			ДанныеДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОбъектСсылка, РеквизитыДляЗапроса);
		Иначе
			ДанныеДокумента = Новый Структура(СтрСоединить(РеквизитыДляЗапроса));
			ЗаполнитьЗначенияСвойств(ДанныеДокумента, ОбъектСсылка);
		КонецЕсли;
	Иначе
		ДанныеДокумента = Новый Структура;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеДокумента, "ВидПоступленияМЗ") = Перечисления.ВидыПоступленийМЗ.ПоступлениеОтПоставщика Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ДанныеДокумента.Свойство("ВидПередачиМЗ")
		И (ДанныеДокумента.ВидПередачиМЗ = Перечисления.ВидыПередачиМЗ.ВозвратПоставщику
			ИЛИ ДанныеДокумента.ВидПередачиМЗ = Перечисления.ВидыПередачиМЗ.ПередачаНаСторону
			ИЛИ ДанныеДокумента.ВидПередачиМЗ = Перечисления.ВидыПередачиМЗ.Реализация) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеДокумента, "ОтражатьВПрослеживаемости", Истина);
	
КонецФункции

Процедура УстановитьОтражатьВПрослеживаемости(Объект, Значение)
	
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ОтражатьВПрослеживаемости", Объект.Метаданные()) Тогда
		Объект.ОтражатьВПрослеживаемости = Значение;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьЗаполнениеСтраныПроисхождения(Объект, ПрослеживаемыеТовары, ИмяТаблицы, Отказ)

	Для Каждого СтрокаТаблицы Из ПрослеживаемыеТовары Цикл
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.СтранаПроисхождения) Тогда
			ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение", НСтр("ru = 'Страна происхождения'"),
				СтрокаТаблицы.НомерСтроки, ИмяТаблицы);
			ПутьКПолю = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТаблицы, СтрокаТаблицы.НомерСтроки, "СтранаПроисхождения");
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Объект, ПутьКПолю, "Объект", Отказ);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполненияПоступление(Объект, ПрослеживаемыеТовары, Отказ)
	
	ТекстСообщенияРасшифровка = НСтр("ru = 'Количество РНПТ не совпадает с количеством товара в строке.'");
	
	МассивНоменклатурыПТ = Новый Массив;
	Для Каждого ЭлементПТ Из ПрослеживаемыеТовары Цикл
		МассивНоменклатурыПТ.Добавить(ЭлементПТ.Номенклатура);
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из ПрослеживаемыеТовары Цикл
	
		Если СтрокаТаблицы.КомплектСПрослеживаемымиТоварами Тогда
			Продолжить;
		КонецЕсли;
		
		СведенияПрослеживаемостиТовара = Объект.СведенияПрослеживаемости.НайтиСтроки(Новый Структура("ИдентификаторСтроки", СтрокаТаблицы.ИдентификаторСтроки));
		КоличествоРНПТ = 0;
		Для Каждого СтрокаРНПТ Из СведенияПрослеживаемостиТовара Цикл
			КоличествоРНПТ = КоличествоРНПТ + СтрокаРНПТ.Количество;
		КонецЦикла;
		Если КоличествоРНПТ <> СтрокаТаблицы.Количество Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность", НСтр("ru = 'РНПТ'"),
				СтрокаТаблицы.НомерСтроки, "Материалы", ТекстСообщенияРасшифровка);
			ПутьКПолю = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Материалы", СтрокаТаблицы.НомерСтроки, "РНПТ");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Объект, ПутьКПолю, "Объект", Отказ);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры
 
Функция МассивыНоменклатурыИОС(МассивНоменклатуры)
	
	ТипНоменклатура = Тип("СправочникСсылка.Номенклатура");
	ТипОС = Тип("СправочникСсылка.ОсновныеСредства");
	
	СтруктураВозврата = Новый Структура("Номенклатура, ОС", Новый Массив, Новый Массив);
	Индекс = МассивНоменклатуры.ВГраница();
	
	Пока Индекс >= 0 Цикл
		ТипЭлемента = ТипЗнч(МассивНоменклатуры[Индекс]);
		Если ТипЭлемента = ТипНоменклатура Тогда
			СтруктураВозврата.Номенклатура.Добавить(МассивНоменклатуры[Индекс]);
		ИначеЕсли ТипЭлемента = ТипОС Тогда
			СтруктураВозврата.ОС.Добавить(МассивНоменклатуры[Индекс]);
		Иначе
			МассивНоменклатуры.Удалить(Индекс);
		КонецЕсли;
		
		Индекс = Индекс - 1;
	КонецЦикла;
	
	Возврат СтруктураВозврата;
	
КонецФункции

Функция ДеревоЗначенийОтчетОбОперациях()
	
	НовоеДеревоЗначений = Новый ДеревоЗначений();
	НовоеДеревоЗначений.Колонки.Добавить("Данные");
	НовоеДеревоЗначений.Колонки.Добавить("ДанныеМногострочныхЧастей");
	НовоеДеревоЗначений.Колонки.Добавить("АдресТабличногоДокумента");
	
	Возврат НовоеДеревоЗначений;
	
КонецФункции

#Область ОбработчикПослеФормированияПроводок

// Параметры отражения в прослеживаемости документа.
// 
// Параметры:
//  ДокументОбъект - ДокументОбъект
//  ДополнительныеСвойства - Структура
// 
// Возвращаемое значение:
//  Структура -  см. ПараметрыОтраженияВПрослеживаемости
Функция ПараметрыОтраженияВПрослеживаемостиДокумента(ДокументОбъект, ДополнительныеСвойства, ЕстьТаблицаПроводок)
	Если ОсобоеЗаполнениеПараметровОтраженияВПрослеживаемости(ДокументОбъект) Тогда
		МенеджерДокумента = ОбщегоНазначения.МенеджерОбъектаПоСсылке(ДокументОбъект.Ссылка);
		ПараметрыОтраженияВПрослеживаемости = МенеджерДокумента.ПараметрыОтраженияВПрослеживаемости(ДокументОбъект); // см. ПараметрыОтраженияВПрослеживаемости
	Иначе
		ПараметрыОтраженияВПрослеживаемости = ПараметрыОтраженияВПрослеживаемости();
		ПараметрыОтраженияВПрослеживаемости.КонтрагентЧленЕАЭС =
			(ЭтоРеализация(ДокументОбъект) Или ЭтоРеализацияОС(ДокументОбъект)
			Или ЭтоПоступлениеМЗ(ДокументОбъект) ИЛИ ЭтоПоступлениеОС(ДокументОбъект))
			И ОбщегоНазначения.ЕстьРеквизитОбъекта("Контрагент", ДокументОбъект.Метаданные())
			И Справочники.Контрагенты.КонтрагентРезидентТаможенногоСоюза(ДокументОбъект.Контрагент);
		Если ТекстЗапросаТаблицаРНПТВМенеджере(ДокументОбъект) Тогда
			РНПТПоДокументу = ОперацииСПрослеживаемымиТоварами(ДокументОбъект, ДополнительныеСвойства);
		ИначеЕсли ЭтоСчетФактура(ДокументОбъект) Тогда
			РНПТПоДокументу = ОперацииСПрослеживаемымиТоварамиДвижениеСчетаФактуры(ДокументОбъект);
		ИначеЕсли ЭтоСписаниеМЗ(ДокументОбъект) Тогда
			РНПТПоДокументу = ОперацииСПрослеживаемымиТоварамиПриСписании_МЗ(ДокументОбъект, ДополнительныеСвойства);
		ИначеЕсли ТипЗнч(ДокументОбъект.Ссылка) = Тип("ДокументСсылка.СписаниеТранспорта") Тогда
			РНПТПоДокументу = ОперацииСПрослеживаемымиТоварамиПриСписанииТранспорта(ДокументОбъект, ДополнительныеСвойства);
		ИначеЕсли ТипЗнч(ДокументОбъект.Ссылка) = Тип("ДокументСсылка.РешениеОПрекращенииПризнанияАктивом")
				Или ЭтоСписаниеОС(ДокументОбъект) Тогда
			РНПТПоДокументу = ОперацииСПрослеживаемымиТоварамиПриСписании_ОС(ДокументОбъект, ДополнительныеСвойства);
		ИначеЕсли ЭтоСтрокаКнигиПокупок(ДокументОбъект) Тогда
			РНПТПоДокументу = ОперацииСПрослеживаемымиТоварамиЗаписьКнигиПокупок(ДокументОбъект);
		Иначе
			РНПТПоДокументу = ОперацииСПрослеживаемымиТоварамиПервичноеДвижение(ДокументОбъект, ДополнительныеСвойства);
			Если РНПТПоДокументу <> Неопределено Тогда
				РаспределитьСуммыТоваровПоРНПТ(РНПТПоДокументу);
			КонецЕсли;
		КонецЕсли;
		Если РНПТПоДокументу = Неопределено Тогда
			Возврат ПараметрыОтраженияВПрослеживаемости;
		КонецЕсли;

		Если Метаданные.Подсистемы.УчетГосУчрежденийПодсистемы.Подсистемы
				.УчетНФА.Подсистемы.УчетОСНМАНПА.Состав.Содержит(ДокументОбъект.Метаданные()) Тогда
			ИспользуемаяТаблицаРНПТ = ПараметрыОтраженияВПрослеживаемости.РНПТ_ОС;
			Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.РешениеОПризнанииОбъектовОС") Тогда
				ПараметрыОтраженияВПрослеживаемости.ЭтоПеремещение = Истина;
			КонецЕсли;
		Иначе
			ИспользуемаяТаблицаРНПТ = ПараметрыОтраженияВПрослеживаемости.РНПТ_МЗ;
		КонецЕсли;
		Для Каждого БазоваяСтрокаРНПТ Из РНПТПоДокументу Цикл
			НоваяСтрокаРНПТ = ИспользуемаяТаблицаРНПТ.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаРНПТ, БазоваяСтрокаРНПТ);
		КонецЦикла;
		Если ЭтоСписаниеМЗ(ДокументОбъект.Ссылка)
				Или ЭтоСписаниеОС(ДокументОбъект.Ссылка)
				Или ЭтоРеализация(ДокументОбъект.Ссылка)
				Или ЭтоРеализацияОС(ДокументОбъект.Ссылка) Тогда
			ПараметрыОтраженияВПрослеживаемости.ЭтоСписание = Истина;
			ИспользуемаяТаблицаРНПТ.ЗаполнитьЗначения(Истина, "ЭтоСписание");
		КонецЕсли;
		Если ЭтоВыпускМЗ(ДокументОбъект) Тогда
			ПараметрыОтраженияВПрослеживаемости.ЭтоВыпуск = Истина;
		КонецЕсли;
	КонецЕсли;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДокументОбъект, "ЭтоКорректировка")
			И ДокументОбъект.ЭтоКорректировка Тогда
		ДополнитьТаблицуРНПТДаннымиКорректируемогоДокумента(ПараметрыОтраженияВПрослеживаемости, ДокументОбъект);
	КонецЕсли;
	Если ЕстьТаблицаПроводок Тогда
		// Если есть таблица проводок, значит это формирование движений из обработчика типовой операции.
		// В этом случае нужно скорректировать дату движений на дату фактического проведения документа.
		ПараметрыОтраженияВПрослеживаемости.ДатаПроведения = БухгалтерскийУчет.УстановленнаяДатаПроведения(
			ДокументОбъект.Ссылка);
	КонецЕсли;
	Возврат ПараметрыОтраженияВПрослеживаемости;
КонецФункции

// Дополнить таблицу РНПТДанными корректируемого документа.
// 
// Параметры:
//  ПараметрыОтраженияВПрослеживаемости - см. ПараметрыОтраженияВПрослеживаемости
//  ДокументОбъект - ДокументОбъект
Процедура ДополнитьТаблицуРНПТДаннымиКорректируемогоДокумента(ПараметрыОтраженияВПрослеживаемости, ДокументОбъект)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Списание", ПараметрыОтраженияВПрослеживаемости.ЭтоСписание);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	&Период КАК Период,
	|	ПрослеживаемыеТовары.ВидДвижения КАК ВидДвижения,
	|	ПрослеживаемыеТовары.Организация КАК Организация,
	|	ПрослеживаемыеТовары.Номенклатура КАК Номенклатура,
	|	ПрослеживаемыеТовары.ВариантКомплекта КАК ВариантКомплекта,
	|	ПрослеживаемыеТовары.Комплектующее КАК Комплектующее,
	|	ПрослеживаемыеТовары.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ПрослеживаемыеТовары.РНПТ КАК РНПТ,
	|	ПрослеживаемыеТовары.Количество КАК Количество,
	|	ПрослеживаемыеТовары.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости,
	|	ПрослеживаемыеТовары.СуммаБезНДС КАК СуммаБезНДС,
	|	ПрослеживаемыеТовары.ДатаРеализации КАК ДатаРеализации,
	|	ПрослеживаемыеТовары.ОснованиеДляВозврата КАК ОснованиеДляВозврата,
	|	НЕ &Списание КАК ЭтоСписание,
	|	ИСТИНА КАК ЭтоСторно
	|ИЗ
	|	РегистрНакопления.ПрослеживаемыеТовары КАК ПрослеживаемыеТовары
	|ГДЕ
	|	ПрослеживаемыеТовары.Регистратор = &Регистратор
	|	И ВЫБОР
	|			КОГДА &Списание
	|				ТОГДА ПрослеживаемыеТовары.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|			ИНАЧЕ ПрослеживаемыеТовары.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|		КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	&Период КАК Период,
	|	ПрослеживаемыеОС.ВидДвижения КАК ВидДвижения,
	|	ПрослеживаемыеОС.Организация КАК Организация,
	|	ПрослеживаемыеОС.ОсновноеСредство КАК ОсновноеСредство,
	|	ПрослеживаемыеОС.РНПТ КАК РНПТ,
	|	ПрослеживаемыеОС.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ПрослеживаемыеОС.Комплектующее КАК Комплектующее,
	|	-ПрослеживаемыеОС.Количество КАК Количество,
	|	-ПрослеживаемыеОС.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости,
	|	ПрослеживаемыеОС.СуммаБезНДС КАК СуммаБезНДС,
	|	ПрослеживаемыеОС.ДатаРеализации КАК ДатаРеализации,
	|	ПрослеживаемыеОС.ОснованиеДляВозврата КАК ОснованиеДляВозврата
	|ИЗ
	|	РегистрНакопления.ПрослеживаемыеОС КАК ПрослеживаемыеОС
	|ГДЕ
	|	ПрослеживаемыеОС.Регистратор = &Регистратор";
	Запрос.УстановитьПараметр("Регистратор", ДокументОбъект.ДокументОснование);
	Запрос.УстановитьПараметр("Период", ДокументОбъект.Дата);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ВыборкаМЗ = РезультатЗапроса[0].Выбрать();
	Пока ВыборкаМЗ.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ПараметрыОтраженияВПрослеживаемости.РНПТ_МЗ.Добавить(), ВыборкаМЗ);
	КонецЦикла;
	ВыборкаОС = РезультатЗапроса[1].Выбрать();
	Пока ВыборкаОС.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ПараметрыОтраженияВПрослеживаемости.РНПТ_ОС.Добавить(), ВыборкаОС);
	КонецЦикла;
	
КонецПроцедуры

Процедура СвернутьТаблицуРНПТ(ТаблицаРНПТ)
	БазовыеИменаИтоговыхКолонок = "Количество, КоличествоПрослеживаемости, СуммаБезНДС";
	БазовыеИменаИтоговыхКолонокИндексированно = Новый Структура(БазовыеИменаИтоговыхКолонок);
	ИменаИтоговыхКолонок = Новый Массив;
	ИменаКолонокСвертки = Новый Массив;
	Для Каждого Колонка Из ТаблицаРНПТ.Колонки Цикл
		Если Не БазовыеИменаИтоговыхКолонокИндексированно.Свойство(Колонка.Имя) Тогда
			ИменаКолонокСвертки.Добавить(Колонка.Имя);
		Иначе
			ИменаИтоговыхКолонок.Добавить(Колонка.Имя);
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаРНПТ.Свернуть(СтрСоединить(ИменаКолонокСвертки, ","),
		СтрСоединить(ИменаИтоговыхКолонок, ","));

	Индекс = ТаблицаРНПТ.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если ПоляРавныЗначению(ТаблицаРНПТ[Индекс], ИменаИтоговыхКолонок, 0) Тогда
			ТаблицаРНПТ.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	
	// Для сортировки таблицы для колонку ВидДвижения требуется передвинуть в конец
	ИменаКолонокСвертки.Удалить(ИменаКолонокСвертки.Найти("ВидДвижения"));
	ИндексКолонкиЭтоСписание = ИменаКолонокСвертки.Найти("ЭтоСписание");
	Если ИндексКолонкиЭтоСписание <> Неопределено Тогда
		ИменаКолонокСвертки.Удалить(ИндексКолонкиЭтоСписание);
	КонецЕсли;
	// Для сравнения строк используются все колонки, кроме "ВидДвижения"
	ИменаКолонокСравнения = Новый ФиксированныйМассив(ИменаКолонокСвертки);
	ИменаКолонокСвертки.Добавить("ВидДвижения");
	Если ИндексКолонкиЭтоСписание <> Неопределено Тогда
		ИменаКолонокСвертки.Добавить("ЭтоСписание");
	КонецЕсли;
	ТаблицаРНПТ.Сортировать(СтрСоединить(ИменаКолонокСвертки, ","));
	
	// В полученной таблице могут быть соседние строки, различные только по виду движения.
	// Их нужно свернуть в одну
	МаксИндекс = ТаблицаРНПТ.Количество() - 1;
	Индекс = 0;
	Пока Индекс <= МаксИндекс - 1 Цикл
		СтрокиРавны = Истина;
		Для Каждого ИмяКолонки Из ИменаКолонокСравнения Цикл
			Если ТаблицаРНПТ[Индекс][ИмяКолонки] <> ТаблицаРНПТ[Индекс + 1][ИмяКолонки] Тогда
				СтрокиРавны = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не СтрокиРавны Тогда
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;
		Если ТаблицаРНПТ[Индекс]["Количество"] > ТаблицаРНПТ[Индекс + 1]["Количество"] Тогда
			Для Каждого ИмяКолонки Из ИменаИтоговыхКолонок Цикл
				ТаблицаРНПТ[Индекс][ИмяКолонки] = ТаблицаРНПТ[Индекс][ИмяКолонки] - ТаблицаРНПТ[Индекс + 1][ИмяКолонки]; 
				ТаблицаРНПТ[Индекс][ИмяКолонки + 1] = ТаблицаРНПТ[Индекс + 1][ИмяКолонки] - ТаблицаРНПТ[Индекс + 1][ИмяКолонки]; 
			КонецЦикла;
		Иначе
			Для Каждого ИмяКолонки Из ИменаИтоговыхКолонок Цикл
				ТаблицаРНПТ[Индекс + 1][ИмяКолонки] = ТаблицаРНПТ[Индекс + 1][ИмяКолонки] - ТаблицаРНПТ[Индекс][ИмяКолонки]; 
				ТаблицаРНПТ[Индекс][ИмяКолонки] = ТаблицаРНПТ[Индекс][ИмяКолонки] - ТаблицаРНПТ[Индекс][ИмяКолонки]; 
			КонецЦикла;
		КонецЕсли;
		Если ПоляРавныЗначению(ТаблицаРНПТ[Индекс], ИменаИтоговыхКолонок, 0) Тогда
			ТаблицаРНПТ.Удалить(Индекс);
			Индекс = Индекс - 1;
			МаксИндекс = МаксИндекс - 1;
		КонецЕсли;
		Если ПоляРавныЗначению(ТаблицаРНПТ[Индекс + 1], ИменаИтоговыхКолонок, 0) Тогда
			ТаблицаРНПТ.Удалить(Индекс + 1);
			МаксИндекс = МаксИндекс - 1;
		КонецЕсли;	
		Индекс = Индекс + 1;
	КонецЦикла;
	
КонецПроцедуры

Функция ПоляРавныЗначению(ОбъектИлиСтрока, ИменаКолонок, Значение)
	Для Каждого ИмяКолонки Из ИменаКолонок Цикл
		Если ОбъектИлиСтрока[ИмяКолонки] <> Значение Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Процедура РаспределитьСуммуПоМассивуСтрок(Строки, Сумма, ИмяКолонкиКоэффициент, ИмяКолонкиСумма) Экспорт
	Если Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Индекс = 0;
	СуммаКоэффициентов = 0;
	ОбщееКоличество = 0;
	УчтеннаяСумма = 0;
	СтрокаСЕдиничнымКоличеством = Неопределено;
	ИндексМаксимальногоКоэффицента = 0;
	Для Каждого Строка Из Строки Цикл
		СуммаКоэффициентов = СуммаКоэффициентов + Строка[ИмяКолонкиКоэффициент];
		ОбщееКоличество = ОбщееКоличество + Строка.Количество;
		Если СтрокаСЕдиничнымКоличеством = Неопределено И Строка.Количество = 1 Тогда
			СтрокаСЕдиничнымКоличеством = Строка;
		КонецЕсли;
		Если Строка[ИмяКолонкиКоэффициент] > Строки[ИндексМаксимальногоКоэффицента][ИмяКолонкиКоэффициент] Тогда
			ИндексМаксимальногоКоэффицента = Индекс;
		КонецЕсли;	
		Индекс = Индекс + 1;
	КонецЦикла;
	Для Каждого Строка Из Строки Цикл
		СуммаДляСтроки = Окр(Сумма * Строка[ИмяКолонкиКоэффициент] / СуммаКоэффициентов / Строка.Количество, 2)
			* Строка.Количество;
		Строка[ИмяКолонкиСумма] = СуммаДляСтроки;
		УчтеннаяСумма = УчтеннаяСумма + СуммаДляСтроки; 
	КонецЦикла;
	Если УчтеннаяСумма <> Сумма Тогда
		Если СтрокаСЕдиничнымКоличеством <> Неопределено Тогда
			КорректируемаяСтрока = СтрокаСЕдиничнымКоличеством;
		Иначе
			КорректируемаяСтрока = Строки[ИндексМаксимальногоКоэффицента];
		КонецЕсли;
		КорректируемаяСтрока[ИмяКолонкиСумма] = КорректируемаяСтрока[ИмяКолонкиСумма] + Сумма - УчтеннаяСумма;
	КонецЕсли;
КонецПроцедуры

Функция ТекстЗапросаТаблицаРНПТВМенеджере(ДокументОбъект)
	ТипДокумента = ТипЗнч(ДокументОбъект);
	
	ОбъектыСПроцедуройВМенеджере = Новый Массив;
	
	Возврат (ОбъектыСПроцедуройВМенеджере.Найти(ТипДокумента) <> Неопределено);
КонецФункции

Процедура ЗаполнитьТаблицуДвиженийОперацииСПрослеживаемымиТоварами(ТаблицаРНПТ, ТаблицаДляЗаписи)
	
	ЕстьКолонкаОсновноеСредство = ТаблицаРНПТ.Колонки.Найти("ОсновноеСредство") <> Неопределено;
	
	Для Каждого СтрокаРНПТ Из ТаблицаРНПТ Цикл
		Если Не ЗначениеЗаполнено(СтрокаРНПТ.КодОперации) Тогда
			Продолжить;
		КонецЕсли;
		НовоеДвижение = ТаблицаДляЗаписи.Добавить();
		ЗаполнитьЗначенияСвойств(НовоеДвижение, СтрокаРНПТ);
		Если ЕстьКолонкаОсновноеСредство Тогда
			Если ЗначениеЗаполнено(СтрокаРНПТ.Комплектующее) Тогда
				НовоеДвижение.Номенклатура = СтрокаРНПТ.Комплектующее;
			ИначеЕсли ЗначениеЗаполнено(СтрокаРНПТ.ОсновноеСредство) Тогда
				НовоеДвижение.Номенклатура = СтрокаРНПТ.ОсновноеСредство;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция РассчитатьТаблицуРНПТПоОстаточнойСтоимостиОС(ДокументОбъект, ТаблицаРНПТ, КолонкаОтбораОС)
	
	Если ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДокументОбъект.ДополнительныеСвойства, "ТаблицыДляДвижений") = Неопределено Тогда
		ДокументОбъект.ДополнительныеСвойства.Вставить("ТаблицыДляДвижений", Новый Структура);
		ИмяДокумента = ДокументОбъект.Метаданные().Имя;
		Документы[ИмяДокумента].ИнициализироватьДанныеДокумента(ДокументОбъект.Ссылка, ДокументОбъект.ДополнительныеСвойства);
	КонецЕсли;
	
	ТаблицаАмортизации = РегистрыНакопления.АмортизацияОбъектовОС.СоздатьНаборЗаписей().ВыгрузитьКолонки("ОсновноеСредство,ИнвентарныйНомер,СуммаАмортизации");
	
	Если ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДокументОбъект.ДополнительныеСвойства.ТаблицыДляДвижений, "АмортизацияОбъектовОС") <> Неопределено Тогда
		Если ДокументОбъект.ДополнительныеСвойства.ТаблицыДляДвижений.АмортизацияОбъектовОС.Колонки.Найти("ЭтоСписание") <> Неопределено Тогда
			ТаблицаАмортизации = ДокументОбъект.ДополнительныеСвойства.ТаблицыДляДвижений.АмортизацияОбъектовОС.Скопировать(Новый Структура("ЭтоСписание", Истина),
			"ОсновноеСредство,ИнвентарныйНомер,СуммаАмортизации");
		КонецЕсли;
	КонецЕсли;
	
	ТаблицаБалансовойСтоимости = ?(ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДокументОбъект.ДополнительныеСвойства.ТаблицыДляДвижений, "СтоимостьОбъектовОС") = Неопределено,
	РегистрыНакопления.СтоимостьОбъектовОС.СоздатьНаборЗаписей().ВыгрузитьКолонки("ОсновноеСредство,ИнвентарныйНомер,Стоимость"),
	ДокументОбъект.ДополнительныеСвойства.ТаблицыДляДвижений.СтоимостьОбъектовОС.Скопировать(,"ОсновноеСредство,ИнвентарныйНомер,Стоимость"));
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	&ПолеОС КАК ОсновноеСредство,
	|	ТаблицаРНПТ.ИнвентарныйНомер КАК ИнвентарныйНомер
	|ПОМЕСТИТЬ ВТ_ТаблицаОС
	|ИЗ
	|	&ТаблицаРНПТ КАК ТаблицаРНПТ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаБалансовойСтоимости.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаБалансовойСтоимости.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ВЫРАЗИТЬ(ТаблицаБалансовойСтоимости.Стоимость КАК ЧИСЛО(18, 2)) КАК Стоимость
	|ПОМЕСТИТЬ ВТ_ТаблицаБалансовойСтоимости
	|ИЗ
	|	&ТаблицаБалансовойСтоимости КАК ТаблицаБалансовойСтоимости
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаАмортизации.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаАмортизации.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ВЫРАЗИТЬ(ТаблицаАмортизации.СуммаАмортизации КАК ЧИСЛО(18, 2)) КАК СуммаАмортизации
	|ПОМЕСТИТЬ ВТ_ТаблицаАмортизации
	|ИЗ
	|	&ТаблицаАмортизации КАК ТаблицаАмортизации
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаОстаточнойСтоимостиОС.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОстаточнойСтоимостиОС.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СУММА(ТаблицаОстаточнойСтоимостиОС.Стоимость) КАК ОстаточнаяСтоимость
	|ИЗ
	|	(ВЫБРАТЬ
	|		ТаблицаБалансовойСтоимости.ОсновноеСредство КАК ОсновноеСредство,
	|		ТаблицаБалансовойСтоимости.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|		ТаблицаБалансовойСтоимости.Стоимость КАК Стоимость
	|	ИЗ
	|		ВТ_ТаблицаБалансовойСтоимости КАК ТаблицаБалансовойСтоимости
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		СтоимостьОбъектовОС.ОсновноеСредство,
	|		СтоимостьОбъектовОС.ИнвентарныйНомер,
	|		СтоимостьОбъектовОС.Стоимость
	|	ИЗ
	|		РегистрНакопления.СтоимостьОбъектовОС КАК СтоимостьОбъектовОС
	|	ГДЕ
	|		СтоимостьОбъектовОС.Организация = &Организация
	|		И СтоимостьОбъектовОС.ВидРаспоряжения В (ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе), ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ОперативныйУчет))
	|		И СтоимостьОбъектовОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Списание)
	|		И СтоимостьОбъектовОС.Активность
	|		И СтоимостьОбъектовОС.Период <= &Период
	|		И (СтоимостьОбъектовОС.ОсновноеСредство, СтоимостьОбъектовОС.ИнвентарныйНомер) В
	|				(ВЫБРАТЬ
	|					ВТ_ТаблицаОС.ОсновноеСредство,
	|					ВТ_ТаблицаОС.ИнвентарныйНомер
	|				ИЗ
	|					ВТ_ТаблицаОС)
	|		И СтоимостьОбъектовОС.Регистратор <> &ТекущийДокумент
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ТаблицаАмортизации.ОсновноеСредство,
	|		ТаблицаАмортизации.ИнвентарныйНомер,
	|		-ТаблицаАмортизации.СуммаАмортизации
	|	ИЗ
	|		ВТ_ТаблицаАмортизации КАК ТаблицаАмортизации
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		АмортизацияОбъектовОС.ОсновноеСредство,
	|		АмортизацияОбъектовОС.ИнвентарныйНомер,
	|		-АмортизацияОбъектовОС.СуммаАмортизации
	|	ИЗ
	|		РегистрНакопления.АмортизацияОбъектовОС КАК АмортизацияОбъектовОС
	|	ГДЕ
	|		АмортизацияОбъектовОС.Организация = &Организация
	|		И АмортизацияОбъектовОС.ЭтоСписание
	|		И АмортизацияОбъектовОС.Активность
	|		И АмортизацияОбъектовОС.Период <= &Период
	|		И (АмортизацияОбъектовОС.ОсновноеСредство, АмортизацияОбъектовОС.ИнвентарныйНомер) В
	|				(ВЫБРАТЬ
	|					ВТ_ТаблицаОС.ОсновноеСредство,
	|					ВТ_ТаблицаОС.ИнвентарныйНомер
	|				ИЗ
	|					ВТ_ТаблицаОС)
	|		И АмортизацияОбъектовОС.Регистратор <> &ТекущийДокумент) КАК ТаблицаОстаточнойСтоимостиОС
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаОстаточнойСтоимостиОС.ОсновноеСредство,
	|	ТаблицаОстаточнойСтоимостиОС.ИнвентарныйНомер
	|
	|ИМЕЮЩИЕ
	|	СУММА(ТаблицаОстаточнойСтоимостиОС.Стоимость) >= 0"
	;
	
	Запрос.УстановитьПараметр("ТаблицаБалансовойСтоимости", ТаблицаБалансовойСтоимости);
	Запрос.УстановитьПараметр("ТаблицаАмортизации", ТаблицаАмортизации);
	Запрос.УстановитьПараметр("ТаблицаРНПТ", ТаблицаРНПТ);
	Запрос.УстановитьПараметр("Организация", ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("Организация", ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("Период", ДокументОбъект.Дата);
	Запрос.УстановитьПараметр("ТекущийДокумент", ДокументОбъект.Ссылка);
	Если КолонкаОтбораОС = "ОсновноеСредство" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПолеОС", "ТаблицаРНПТ.ОсновноеСредство");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПолеОС", "ТаблицаРНПТ.Комплектующее");
	КонецЕсли;
	
	ТаблицаОстаточнойСтоимостиОС = Запрос.Выполнить().Выгрузить();
	ТаблицаРНПТВыбытие = ТаблицаРНПТ.Скопировать();
	ТаблицаРНПТВыбытие.Колонки.Добавить("ИндексСтроки", Новый ОписаниеТипов("Число"));
	Для Каждого СтрокаТаблицаРНПТ Из ТаблицаРНПТВыбытие Цикл
		СтрокаТаблицаРНПТ.ИндексСтроки = ТаблицаРНПТВыбытие.Индекс(СтрокаТаблицаРНПТ);
	КонецЦикла;
	
	Если ТаблицаОстаточнойСтоимостиОС.Количество() Тогда
		Для Каждого СтрокаОстаточнойСтоимостиОС Из ТаблицаОстаточнойСтоимостиОС Цикл
			ОтборИН = Новый Структура;
			ОтборИН.Вставить(КолонкаОтбораОС, СтрокаОстаточнойСтоимостиОС.ОсновноеСредство);
			ОтборИН.Вставить("ИнвентарныйНомер", СтрокаОстаточнойСтоимостиОС.ИнвентарныйНомер);
			Если КолонкаОтбораОС <> "ОсновноеСредство" Тогда
				ОтборИН.Вставить("ЭтоСписание", Ложь);
			КонецЕсли;
			ТаблицаРНПТИнвНомера = ТаблицаРНПТВыбытие.Скопировать(ОтборИН);
			Если ТаблицаРНПТИнвНомера.Итог("СуммаБезНДС") > СтрокаОстаточнойСтоимостиОС.ОстаточнаяСтоимость Тогда
				МассивСумм = ТаблицаРНПТИнвНомера.ВыгрузитьКолонку("СуммаБезНДС");
				Если СтрокаОстаточнойСтоимостиОС.ОстаточнаяСтоимость = 0 Тогда
					СуммыОстаточнойСтоимости = МассивСумм;
					Для Инд = 0 По СуммыОстаточнойСтоимости.Количество()-1 Цикл
						СуммыОстаточнойСтоимости[Инд] = СтрокаОстаточнойСтоимостиОС.ОстаточнаяСтоимость;
					КонецЦикла;
				Иначе
					СуммыОстаточнойСтоимости = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(СтрокаОстаточнойСтоимостиОС.ОстаточнаяСтоимость, МассивСумм);
				КонецЕсли;
				ИндексСумм = 0;
				Для Каждого СтрокаРНПТИнвНомер Из ТаблицаРНПТИнвНомера Цикл
					ТаблицаРНПТВыбытие[СтрокаРНПТИнвНомер.ИндексСтроки].СуммаБезНДС = СуммыОстаточнойСтоимости[ИндексСумм];
					ИндексСумм = ИндексСумм +1;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат ТаблицаРНПТВыбытие;
КонецФункции

Процедура СформироватьДвиженияОперацииСПрослеживаемымиТоварами(ДокументОбъект, ТаблицаРНПТ, ТаблицаДляЗаписи)
	
	Если ТаблицаРНПТ <> Неопределено И ТаблицаРНПТ.Количество() Тогда
		
		Если ЭтоВыбытиеОС(ДокументОбъект) Тогда
			ЗаполнитьТаблицуДвиженийОперацииСПрослеживаемымиТоварами(РассчитатьТаблицуРНПТПоОстаточнойСтоимостиОС(ДокументОбъект, ТаблицаРНПТ, "ОсновноеСредство"), ТаблицаДляЗаписи);
		Иначе
			ЗаполнитьТаблицуДвиженийОперацииСПрослеживаемымиТоварами(ТаблицаРНПТ, ТаблицаДляЗаписи);
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура ЗаписатьДвиженияОперацииСПрослеживаемымиТоварами(ДокументОбъект, ТаблицаДляЗаписи)
	ОперацииСПрослеживаемымиТоварами = ДокументОбъект.Движения.ОперацииСПрослеживаемымиТоварами;
	ОперацииСПрослеживаемымиТоварами.Записывать = Истина;

	// Свернуть таблицу перед записью, т.к. одинаковые РНПТ могут быть в нескольких строках по разным объектам
	
	СуммируемыеКолонки = Новый Массив;
	Для Каждого Ресурс Из ОперацииСПрослеживаемымиТоварами.Метаданные().Ресурсы Цикл
		Если Ресурс.Тип.СодержитТип(Тип("Число")) Тогда
			СуммируемыеКолонки.Добавить(Ресурс.Имя);
		КонецЕсли;
	КонецЦикла;
	
	СуммируемыеКолонкиСтрокой = СтрСоединить(СуммируемыеКолонки, ",");
	ИменаСуммируемыхКолонок = Новый Структура(СуммируемыеКолонкиСтрокой);
	УникальныеКолонки = Новый Массив;
	Для Каждого КолонкаТаблицы Из ТаблицаДляЗаписи.Колонки Цикл
		Если Не ИменаСуммируемыхКолонок.Свойство(КолонкаТаблицы.Имя) Тогда
			УникальныеКолонки.Добавить(КолонкаТаблицы.Имя);
		КонецЕсли;
	КонецЦикла;
	ТаблицаДляЗаписи.Свернуть(СтрСоединить(УникальныеКолонки, ","), СуммируемыеКолонкиСтрокой);
	
	ОперацииСПрослеживаемымиТоварами.Загрузить(ТаблицаДляЗаписи);
	ОперацииСПрослеживаемымиТоварами.УстановитьАктивность(Истина);
	
	Если ПолучитьФункциональнуюОпцию("ФормированиеПроводокОбособленноОтДокумента") Тогда
		ОперацииСПрослеживаемымиТоварами.Записать(Истина);
	КонецЕсли;
	
КонецПроцедуры

Процедура РаспределитьСуммыТоваровПоРНПТ(ТаблицаРНПТ, ИмяКолонки = "Номенклатура")
	НоменклатураДокумента = ТаблицаРНПТ.Скопировать(, ИмяКолонки + ",ИдентификаторСтроки");
	НоменклатураДокумента.Свернуть(ИмяКолонки + ",ИдентификаторСтроки");
	
	Если НоменклатураДокумента.Количество() = ТаблицаРНПТ.Количество() Тогда
		// Каждая номенклатура только по 1 РНПТ
		Возврат;
	КонецЕсли;
	
	ТаблицаРНПТ.Сортировать(ИмяКолонки + ", РНПТ");
	ТаблицаРНПТ.Индексы.Добавить(ИмяКолонки); 
	Отбор = Новый Структура(ИмяКолонки + ",ИдентификаторСтроки");
	
	Если ТаблицаРНПТ.Колонки.Найти("Комплектующее") <> Неопределено Тогда
		ТаблицаРНПТ.Колонки.Добавить("ПересчитатьСумму");
		Для Каждого СтрокаТРНПТ Из ТаблицаРНПТ Цикл
			СтрокаТРНПТ.ПересчитатьСумму = Не ЗначениеЗаполнено(СтрокаТРНПТ.Комплектующее);
		КонецЦикла;
		Отбор.Вставить("ПересчитатьСумму", Истина); 
		ТаблицаРНПТ.Индексы.Добавить("ПересчитатьСумму");
	КонецЕсли;
	
	Для каждого Номенклатура Из НоменклатураДокумента Цикл
		
		ЗаполнитьЗначенияСвойств(Отбор, Номенклатура, ИмяКолонки + ",ИдентификаторСтроки");
		СтрокиНоменклатуры = ТаблицаРНПТ.НайтиСтроки(Отбор);
		
		Если СтрокиНоменклатуры.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;
		
		СуммаБезНДС = СтрокиНоменклатуры[0].СуммаБезНДС;
		Количества = Новый Массив;
		Для каждого РаспределяемаяСтрока Из СтрокиНоменклатуры Цикл
			Количества.Добавить(РаспределяемаяСтрока.Количество);
		КонецЦикла; 
		
		Суммы = ОбщегоНазначенияКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(СуммаБезНДС, Количества);
		Индекс = 0;
		Для каждого РаспределяемаяСтрока Из СтрокиНоменклатуры Цикл
			Если Суммы <> Неопределено Тогда
				РаспределяемаяСтрока.СуммаБезНДС = Суммы[Индекс];
			КонецЕсли;
			Индекс = Индекс + 1;
		КонецЦикла; 
	
	КонецЦикла; 
КонецПроцедуры

Функция ОперацииСПрослеживаемымиТоварамиПервичноеДвижение(ДокументОбъект, ДополнительныеСвойства)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументОбъект.Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаДокумент.Дата КАК Период,
	|	ТаблицаДокумент.Ссылка КАК Регистратор,
	|	ТаблицаДокумент.Организация КАК Организация,
	|	ЗНАЧЕНИЕ(Перечисление.ПорядокОтраженияВОтчетностиПоПрослеживаемости.ОтчетОбОперациях) КАК ОтражениеВОтчетности,
	|	НАЧАЛОПЕРИОДА(ТаблицаДокумент.Дата, КВАРТАЛ) КАК ПериодОперации,
	|	ТаблицаДокумент.Ссылка КАК ДокументОперации,
	|	ТаблицаСведенияПрослеживаемости.РНПТ КАК РНПТ,
	|	ТаблицаСведенияПрослеживаемости.Комплектующее КАК Комплектующее,
	|	&ПолеВариантКомплекта КАК ВариантКомплекта,
	|	&ПолеКонтрагент КАК Контрагент,
	|	&ПолеНоменклатура КАК Номенклатура,
	|	ТаблицаДокумент.КодОперацииПрослеживаемости КАК КодОперации,
	|	СУММА(ТаблицаСведенияПрослеживаемости.Количество) КАК Количество,
	|	СУММА(ТаблицаСведенияПрослеживаемости.КоличествоПрослеживаемости) КАК КоличествоПрослеживаемости,
	|	СУММА(&ПолеСумма) КАК СуммаБезНДС,
	|	ЗНАЧЕНИЕ(Справочник.ТипыДокументов.УПД) КАК ТипДокументаВПрослеживаемости,
	|	&НомерПервичногоДокумента КАК НомерДокумента,
	|	&ДатаПервичногоДокумента КАК ДатаДокумента,
	|	ТаблицаМатериалы.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ВЫБОР
	|		КОГДА ТаблицаСведенияПрослеживаемости.Комплектующее = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА ТаблицаМатериалы.СтранаПроисхождения
	|		ИНАЧЕ ЕСТЬNULL(СпрНоменклатура.СтранаПроисхождения, ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка))
	|	КОНЕЦ КАК СтранаПроисхождения
	|ИЗ
	|	ВТ_ТаблицаМатериалы КАК ТаблицаМатериалы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТаблицаДокумент КАК ТаблицаДокумент
	|		ПО ТаблицаМатериалы.Ссылка = ТаблицаДокумент.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТаблицаСведенияПрослеживаемости КАК ТаблицаСведенияПрослеживаемости
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СпрНоменклатура
	|			ПО ТаблицаСведенияПрослеживаемости.Комплектующее = СпрНоменклатура.Ссылка
	|		ПО ТаблицаМатериалы.Ссылка = ТаблицаСведенияПрослеживаемости.Ссылка
	|			И ТаблицаМатериалы.ИдентификаторСтроки = ТаблицаСведенияПрослеживаемости.ИдентификаторСтроки
	|ГДЕ
	|	ТаблицаСведенияПрослеживаемости.Ссылка = &Ссылка
	|	И ТаблицаДокумент.Ссылка = &Ссылка
	|	И ТаблицаМатериалы.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаДокумент.Дата,
	|	ТаблицаДокумент.Ссылка,
	|	ТаблицаДокумент.Организация,
	|	НАЧАЛОПЕРИОДА(ТаблицаДокумент.Дата, КВАРТАЛ),
	|	ТаблицаСведенияПрослеживаемости.РНПТ,
	|	&ПолеНоменклатура,
	|	&ПолеКонтрагент,
	|	ТаблицаСведенияПрослеживаемости.Комплектующее,
	|	&ПолеВариантКомплекта,
	|	ТаблицаДокумент.КодОперацииПрослеживаемости,
	|	ТаблицаМатериалы.ИдентификаторСтроки,
	|	ТаблицаДокумент.Ссылка,
	|	ВЫБОР
	|		КОГДА ТаблицаСведенияПрослеживаемости.Комплектующее = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА ТаблицаМатериалы.СтранаПроисхождения
	|		ИНАЧЕ ЕСТЬNULL(СпрНоменклатура.СтранаПроисхождения, ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка))
	|	КОНЕЦ";
	
	ДоработатьТекстЗапросаДвиженийПрослеживаемыеТовары(Запрос.Текст, ДокументОбъект);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДокументОбъект, "ЭтоКорректировка")
			И ДокументОбъект.ЭтоКорректировка Тогда
		ПроверенныеДокументы = Новый Соответствие;
		ДокументОснование = ДокументОбъект.ДокументОснование;
		Пока Истина Цикл
			РеквизитыОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование,
				"ЭтоКорректировка, Дата, ДокументОснование");
			Если ПроверенныеДокументы.Получить(ДокументОснование) <> Неопределено Тогда
				ВызватьИсключение НСтр("ru = 'Циклическая цепочки корректировок'");
			КонецЕсли;
			Если Не РеквизитыОснования.ЭтоКорректировка Тогда
				Результат.ЗаполнитьЗначения(НачалоКвартала(РеквизитыОснования.Дата), "ПериодОперации");
				Прервать;
			КонецЕсли;
			ПроверенныеДокументы.Вставить(ДокументОснование);
			ДокументОснование = РеквизитыОснования.ДокументОснование;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ОперацииСПрослеживаемымиТоварамиПриСписании_МЗ(ДокументОбъект, ДополнительныеСвойства) Экспорт

	СписаниеМЗ = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДополнительныеСвойства, "ТаблицаСписаниеМатериальныхЗапасов");
	Если СписаниеМЗ = Неопределено Тогда
		СписаниеМЗ = УправлениеМатериальнымиЗапасами.ПустаяТаблицаСписаниеМатериальныхЗапасов();
	КонецЕсли;
	СписаниеМЗ = СписаниеМЗ.Скопировать(Новый Структура("ВидУчета", "БУ"));
	СписаниеМЗ.Свернуть("НомерСтроки", "Стоимость");
	
	Период = Новый Граница(ДокументОбъект.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	
	ТипДокументаВПрослеживаемости = ВидСопроводительногоДокументаОтражающегоСодержаниеОперации(ДокументОбъект); 
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументОбъект.Ссылка);
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("СуммыСписания", СписаниеМЗ);
	Запрос.УстановитьПараметр("Организация", ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("ТипДокументаВПрослеживаемости", ТипДокументаВПрослеживаемости); 
	УстановитьПараметрыКорректировкиРНПТОстатки(Запрос, ДокументОбъект);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СуммыСписания.НомерСтроки КАК НомерСтроки,
	|	СуммыСписания.Стоимость КАК Сумма
	|ПОМЕСТИТЬ СуммыСписания
	|ИЗ
	|	&СуммыСписания КАК СуммыСписания
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаМатериалы.Ссылка КАК Ссылка,
	|	&ПолеНоменклатура КАК Номенклатура,
	|	ТаблицаМатериалы.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	&ПолеСтранаПроисхождения КАК СтранаПроисхождения,
	|	&ПолеВариантКомплекта КАК ВариантКомплекта,
	|	ТаблицаМатериалы.НомерСтроки КАК НомерСтроки,
	|	ТаблицаСведенияПрослеживаемости.РНПТ КАК РНПТ,
	|	ТаблицаСведенияПрослеживаемости.Комплектующее КАК Комплектующее,
	|	ТаблицаСведенияПрослеживаемости.Количество КАК Количество,
	|	ТаблицаСведенияПрослеживаемости.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости
	|ПОМЕСТИТЬ ВТ_ДанныеТЧ
	|ИЗ
	|	ВТ_ТаблицаМатериалы КАК ТаблицаМатериалы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТаблицаСведенияПрослеживаемости КАК ТаблицаСведенияПрослеживаемости
	|		ПО ТаблицаМатериалы.Ссылка = ТаблицаСведенияПрослеживаемости.Ссылка
	|			И ТаблицаМатериалы.ИдентификаторСтроки = ТаблицаСведенияПрослеживаемости.ИдентификаторСтроки
	|ГДЕ
	|	ТаблицаМатериалы.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОстаткиРПНТИтоги.Организация КАК Организация,
	|	ОстаткиРПНТИтоги.РНПТ КАК РНПТ,
	|	ОстаткиРПНТИтоги.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ОстаткиРПНТИтоги.Комплектующее КАК Комплектующее,
	|	ОстаткиРПНТИтоги.ВариантКомплекта КАК ВариантКомплекта,
	|	ОстаткиРПНТИтоги.Номенклатура КАК Номенклатура,
	|	СУММА(ОстаткиРПНТИтоги.Количество) КАК Количество,
	|	СУММА(ОстаткиРПНТИтоги.СуммаБезНДС) КАК СуммаБезНДС
	|ПОМЕСТИТЬ ОстаткиРНПТКомплекты
	|ИЗ
	|	(ВЫБРАТЬ
	|		ПрослеживаемыеТоварыОстатки.Организация КАК Организация,
	|		ПрослеживаемыеТоварыОстатки.РНПТ КАК РНПТ,
	|		ПрослеживаемыеТоварыОстатки.СтранаПроисхождения КАК СтранаПроисхождения,
	|		ПрослеживаемыеТоварыОстатки.Комплектующее КАК Комплектующее,
	|		ПрослеживаемыеТоварыОстатки.ВариантКомплекта КАК ВариантКомплекта,
	|		ПрослеживаемыеТоварыОстатки.Номенклатура КАК Номенклатура,
	|		ПрослеживаемыеТоварыОстатки.КоличествоОстаток КАК Количество,
	|		ПрослеживаемыеТоварыОстатки.СуммаБезНДСОстаток КАК СуммаБезНДС
	|	ИЗ
	|		РегистрНакопления.ПрослеживаемыеТовары.Остатки(
	|				&Период,
	|				Организация = &Организация
	|					И Комплектующее <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|					И &УсловиеОтбора) КАК ПрослеживаемыеТоварыОстатки
	|	ГДЕ
	|		ПрослеживаемыеТоварыОстатки.КоличествоОстаток > 0
	|		И ПрослеживаемыеТоварыОстатки.СуммаБезНДСОстаток > 0
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ПрослеживаемыеТоварыОбороты.Организация,
	|		ПрослеживаемыеТоварыОбороты.РНПТ,
	|		ПрослеживаемыеТоварыОбороты.СтранаПроисхождения,
	|		ПрослеживаемыеТоварыОбороты.Комплектующее,
	|		ПрослеживаемыеТоварыОбороты.ВариантКомплекта,
	|		ПрослеживаемыеТоварыОбороты.Номенклатура,
	|		ПрослеживаемыеТоварыОбороты.КоличествоРасход,
	|		ПрослеживаемыеТоварыОбороты.СуммаБезНДСРасход
	|	ИЗ
	|		РегистрНакопления.ПрослеживаемыеТовары.Обороты(
	|				&ПериодОснование,
	|				&ПериодОснование,
	|				Регистратор,
	|				Организация = &Организация
	|					И &ЭтоКорректировка
	|					И Комплектующее <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|					И &УсловиеОтбора) КАК ПрослеживаемыеТоварыОбороты
	|	ГДЕ
	|		ПрослеживаемыеТоварыОбороты.Регистратор = &ДокументОснование) КАК ОстаткиРПНТИтоги
	|
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиРПНТИтоги.Организация,
	|	ОстаткиРПНТИтоги.РНПТ,
	|	ОстаткиРПНТИтоги.СтранаПроисхождения,
	|	ОстаткиРПНТИтоги.Комплектующее,
	|	ОстаткиРПНТИтоги.ВариантКомплекта,
	|	ОстаткиРПНТИтоги.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаДокумент.Дата КАК Период,
	|	ТаблицаДокумент.Ссылка КАК Регистратор,
	|	ТаблицаДокумент.Организация КАК Организация,
	|	ЗНАЧЕНИЕ(Перечисление.ПорядокОтраженияВОтчетностиПоПрослеживаемости.ОтчетОбОперациях) КАК ОтражениеВОтчетности,
	|	НАЧАЛОПЕРИОДА(ТаблицаДокумент.Дата, КВАРТАЛ) КАК ПериодОперации,
	|	ТаблицаДокумент.Ссылка КАК ДокументОперации,
	|	ДанныеТЧ.РНПТ КАК РНПТ,
	|	&ПолеКонтрагент КАК Контрагент,
	|	ДанныеТЧ.Номенклатура КАК Номенклатура,
	|	ДанныеТЧ.ВариантКомплекта КАК ВариантКомплекта,
	|	ДанныеТЧ.Комплектующее КАК Комплектующее,
	|	ТаблицаДокумент.КодОперацииПрослеживаемости КАК КодОперации,
	|	ДанныеТЧ.Количество КАК Количество,
	|	ДанныеТЧ.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ДанныеТЧ.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости,
	|	ВЫБОР
	|		КОГДА ДанныеТЧ.Комплектующее = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА ЕСТЬNULL(СуммыСписания.Сумма, 0)
	|		ИНАЧЕ ЕСТЬNULL(ОстаткиРНПТКомплекты.СуммаБезНДС / ОстаткиРНПТКомплекты.Количество * ДанныеТЧ.Количество, 0)
	|	КОНЕЦ КАК СуммаБезНДС,
	|	&ТипДокументаВПрослеживаемости КАК ТипДокументаВПрослеживаемости,
	|	ТаблицаДокумент.Номер КАК НомерДокумента,
	|	ТаблицаДокумент.Дата КАК ДатаДокумента,
	|	ВЫБОР
	|		КОГДА ДанныеТЧ.Комплектующее = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА ДанныеТЧ.СтранаПроисхождения
	|		ИНАЧЕ ОстаткиРНПТКомплекты.СтранаПроисхождения
	|	КОНЕЦ КАК СтранаПроисхождения,
	|	ЕСТЬNULL(СоставыКомплектовМЗПТ.КоличествоВложений, 0) КАК КоличествоВложений
	|ИЗ
	|	ВТ_ДанныеТЧ КАК ДанныеТЧ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТаблицаДокумент КАК ТаблицаДокумент
	|		ПО ДанныеТЧ.Ссылка = ТаблицаДокумент.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ СуммыСписания КАК СуммыСписания
	|		ПО ДанныеТЧ.НомерСтроки = СуммыСписания.НомерСтроки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиРНПТКомплекты КАК ОстаткиРНПТКомплекты
	|		ПО ДанныеТЧ.Номенклатура = ОстаткиРНПТКомплекты.Номенклатура
	|			И ДанныеТЧ.РНПТ = ОстаткиРНПТКомплекты.РНПТ
	|			И ДанныеТЧ.Комплектующее = ОстаткиРНПТКомплекты.Комплектующее
	|			И (&УсловиеСоединения)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоставыКомплектовМЗПТ КАК СоставыКомплектовМЗПТ
	|		ПО (ОстаткиРНПТКомплекты.Организация = СоставыКомплектовМЗПТ.Организация)
	|			И (ОстаткиРНПТКомплекты.Номенклатура = СоставыКомплектовМЗПТ.Комплект)
	|			И (ОстаткиРНПТКомплекты.Комплектующее = СоставыКомплектовМЗПТ.Комплектующее)
	|			И (ОстаткиРНПТКомплекты.ВариантКомплекта = СоставыКомплектовМЗПТ.ВариантКомплекта)
	|ГДЕ
	|	ТаблицаДокумент.Ссылка = &Ссылка";
	
	Если ЭтоВыпускМЗ(ДокументОбъект) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОтбора", "(РНПТ, Номенклатура) В
		|					(ВЫБРАТЬ
		|						ВТ_ДанныеТЧ.РНПТ,
		|						ВТ_ДанныеТЧ.Номенклатура
		|					ИЗ
		|						ВТ_ДанныеТЧ)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеСоединения", "ИСТИНА");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОтбора", "(РНПТ, Номенклатура, ВариантКомплекта) В
		|					(ВЫБРАТЬ
		|						ВТ_ДанныеТЧ.РНПТ,
		|						ВТ_ДанныеТЧ.Номенклатура,
		|						ВТ_ДанныеТЧ.ВариантКомплекта
		|					ИЗ
		|						ВТ_ДанныеТЧ)"); 
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеСоединения", "ДанныеТЧ.ВариантКомплекта = ОстаткиРНПТКомплекты.ВариантКомплекта");
	КонецЕсли;
		
	ДоработатьТекстЗапросаДвиженийПрослеживаемыеТовары(Запрос.Текст, ДокументОбъект);
	
	Результат = Запрос.Выполнить().Выгрузить();
	Возврат Результат;

КонецФункции

Функция ОперацииСПрослеживаемымиТоварами(ДокументОбъект, ДополнительныеСвойства)
	
	Если ДокументОбъект.Ссылка.Пустая() Тогда
		Период = Новый Граница(ДокументОбъект.Дата, ВидГраницы.Включая);
	Иначе
		Период = Новый Граница(ДокументОбъект.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;
	
	ТипДокументаВПрослеживаемости = ВидСопроводительногоДокументаОтражающегоСодержаниеОперации(ДокументОбъект); 
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("Ссылка", ДокументОбъект.Ссылка);
	Запрос.УстановитьПараметр("Организация", ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("ТипДокументаВПрослеживаемости", ТипДокументаВПрослеживаемости);

	МенеджерДокумента = ОбщегоНазначения.МенеджерОбъектаПоСсылке(ДокументОбъект.Ссылка);
	Запрос.Текст = МенеджерДокумента.ТекстЗапросаТаблицаРНПТПоДокументу();

	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ОперацииСПрослеживаемымиТоварамиПриСписании_ОС(ДокументОбъект, ДополнительныеСвойства)

	Если ДокументОбъект.Ссылка.Пустая() Тогда
		Период = Новый Граница(ДокументОбъект.Дата, ВидГраницы.Включая);
	Иначе
		Период = Новый Граница(ДокументОбъект.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;

	ТипДокументаВПрослеживаемости = ВидСопроводительногоДокументаОтражающегоСодержаниеОперации(ДокументОбъект); 
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("Ссылка", ДокументОбъект.Ссылка);
	Запрос.УстановитьПараметр("Организация", ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("ТипДокументаВПрослеживаемости", ТипДокументаВПрослеживаемости);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПрослеживаемыеОСОстатки.Организация КАК Организация,
	|	ПрослеживаемыеОСОстатки.РНПТ КАК РНПТ,
	|	ПрослеживаемыеОСОстатки.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ПрослеживаемыеОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	ВЫБОР
	|		КОГДА ПрослеживаемыеОСОстатки.Комплектующее = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|				ИЛИ ПрослеживаемыеОСОстатки.Комплектующее = ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ ПрослеживаемыеОСОстатки.Комплектующее
	|	КОНЕЦ КАК Комплектующее,
	|	ПрослеживаемыеОСОстатки.КоличествоОстаток КАК Количество,
	|	ПрослеживаемыеОСОстатки.КоличествоПрослеживаемостиОстаток КАК КоличествоПрослеживаемости,
	|	ПрослеживаемыеОСОстатки.СуммаБезНДСОстаток КАК СуммаБезНДС
	|ПОМЕСТИТЬ ОстаткиРНПТ
	|ИЗ
	|	РегистрНакопления.ПрослеживаемыеОС.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И РНПТ В
	|					(ВЫБРАТЬ
	|						ТаблицаСведенияПрослеживаемости.РНПТ
	|					ИЗ
	|						ВТ_ТаблицаСведенияПрослеживаемости КАК ТаблицаСведенияПрослеживаемости
	|					ГДЕ
	|						ТаблицаСведенияПрослеживаемости.Ссылка = &Ссылка)) КАК ПрослеживаемыеОСОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаМатериалы.Ссылка КАК Ссылка,
	|	ТаблицаСведенияПрослеживаемости.РНПТ КАК РНПТ,
	|	&ПолеОсновноеСредство КАК ОсновноеСредство,
	|	&ПолеИнвНомерОС КАК ИнвентарныйНомер,
	|	ТаблицаСведенияПрослеживаемости.Количество КАК Количество,
	|	ТаблицаСведенияПрослеживаемости.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости,
	|	ТаблицаСведенияПрослеживаемости.Комплектующее КАК Комплектующее
	|ПОМЕСТИТЬ РНПТОС
	|ИЗ
	|	ВТ_ТаблицаМатериалы КАК ТаблицаМатериалы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТаблицаСведенияПрослеживаемости КАК ТаблицаСведенияПрослеживаемости
	|		ПО ТаблицаМатериалы.Ссылка = ТаблицаСведенияПрослеживаемости.Ссылка
	|			И ТаблицаМатериалы.ИдентификаторСтроки = ТаблицаСведенияПрослеживаемости.ИдентификаторСтроки
	|ГДЕ
	|	ТаблицаСведенияПрослеживаемости.Ссылка = &Ссылка
	|	И ТаблицаМатериалы.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаДокумент.Дата КАК Период,
	|	ТаблицаДокумент.Ссылка КАК Регистратор,
	|	ТаблицаДокумент.Организация КАК Организация,
	|	ЗНАЧЕНИЕ(Перечисление.ПорядокОтраженияВОтчетностиПоПрослеживаемости.ОтчетОбОперациях) КАК ОтражениеВОтчетности,
	|	НАЧАЛОПЕРИОДА(ТаблицаДокумент.Дата, КВАРТАЛ) КАК ПериодОперации,
	|	ТаблицаДокумент.Ссылка КАК ДокументОперации,
	|	РНПТОС.РНПТ КАК РНПТ,
	|	&ПолеКонтрагент КАК Контрагент,
	|	РНПТОС.ОсновноеСредство КАК ОсновноеСредство,
	|	РНПТОС.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	РНПТОС.Комплектующее КАК Комплектующее,
	|	ТаблицаДокумент.КодОперацииПрослеживаемости КАК КодОперации,
	|	СУММА(РНПТОС.Количество) КАК Количество,
	|	СУММА(РНПТОС.КоличествоПрослеживаемости) КАК КоличествоПрослеживаемости,
	|	СУММА(ВЫБОР
	|			КОГДА ОстаткиРНПТ.Количество = 0
	|				ТОГДА 0
	|			КОГДА РНПТОС.Количество < ОстаткиРНПТ.Количество
	|				ТОГДА ОстаткиРНПТ.СуммаБезНДС * РНПТОС.Количество / ОстаткиРНПТ.Количество
	|			ИНАЧЕ ОстаткиРНПТ.СуммаБезНДС
	|		КОНЕЦ) КАК СуммаБезНДС,
	|	&ТипДокументаВПрослеживаемости КАК ТипДокументаВПрослеживаемости,
	|	ТаблицаДокумент.Номер КАК НомерДокумента,
	|	ТаблицаДокумент.Дата КАК ДатаДокумента,
	|	ОстаткиРНПТ.СтранаПроисхождения
	|ИЗ
	|	РНПТОС КАК РНПТОС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТаблицаДокумент КАК ТаблицаДокумент
	|		ПО РНПТОС.Ссылка = ТаблицаДокумент.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОстаткиРНПТ КАК ОстаткиРНПТ
	|		ПО РНПТОС.ОсновноеСредство = ОстаткиРНПТ.ОсновноеСредство
	|			И РНПТОС.Комплектующее = ОстаткиРНПТ.Комплектующее
	|			И РНПТОС.РНПТ = ОстаткиРНПТ.РНПТ
	|ГДЕ
	|	ТаблицаДокумент.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаДокумент.Дата,
	|	ТаблицаДокумент.Ссылка,
	|	ТаблицаДокумент.Организация,
	|	РНПТОС.РНПТ,
	|	&ПолеКонтрагент,
	|	РНПТОС.ОсновноеСредство,
	|	РНПТОС.ИнвентарныйНомер,
	|	РНПТОС.Комплектующее,
	|	ТаблицаДокумент.КодОперацииПрослеживаемости,
	|	&ТипДокументаВПрослеживаемости,
	|	ТаблицаДокумент.Номер,
	|	ОстаткиРНПТ.СтранаПроисхождения";
	
	ДоработатьТекстЗапросаДвиженийПрослеживаемыеТовары(Запрос.Текст, ДокументОбъект);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ОперацииСПрослеживаемымиТоварамиПриСписанииТранспорта(ДокументОбъект, ДополнительныеСвойства)

	Если ДокументОбъект.Ссылка.Пустая() Тогда
		Период = Новый Граница(ДокументОбъект.Дата, ВидГраницы.Включая);
	Иначе
		Период = Новый Граница(ДокументОбъект.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;
	
	ТипДокументаВПрослеживаемости = ВидСопроводительногоДокументаОтражающегоСодержаниеОперации(ДокументОбъект); 
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументОбъект.Ссылка);
	Запрос.УстановитьПараметр("Организация", ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("ОсновноеСредство", ДокументОбъект.ОсновноеСредство);
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("ТипДокументаВПрослеживаемости", ТипДокументаВПрослеживаемости);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПрослеживаемыеОСОстатки.Организация КАК Организация,
	|	ПрослеживаемыеОСОстатки.РНПТ КАК РНПТ,
	|	ПрослеживаемыеОСОстатки.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ПрослеживаемыеОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	ПрослеживаемыеОСОстатки.Комплектующее КАК Комплектующее,
	|	ПрослеживаемыеОСОстатки.КоличествоОстаток КАК Количество,
	|	ПрослеживаемыеОСОстатки.КоличествоПрослеживаемостиОстаток КАК КоличествоПрослеживаемости,
	|	ПрослеживаемыеОСОстатки.СуммаБезНДСОстаток КАК СуммаБезНДС
	|ПОМЕСТИТЬ ОстаткиРНПТ
	|ИЗ
	|	РегистрНакопления.ПрослеживаемыеОС.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство = &ОсновноеСредство) КАК ПрослеживаемыеОСОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СписаниеТранспорта.Ссылка КАК Ссылка,
	|	СписаниеТранспорта.ОсновноеСредство КАК ОсновноеСредство,
	|	СписаниеТранспортаСведенияПрослеживаемости.РНПТ КАК РНПТ,
	|	СписаниеТранспортаСведенияПрослеживаемости.Количество КАК Количество,
	|	СписаниеТранспортаСведенияПрослеживаемости.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости,
	|	СписаниеТранспортаСведенияПрослеживаемости.Комплектующее КАК Комплектующее
	|ПОМЕСТИТЬ РНПТОС
	|ИЗ
	|	Документ.СписаниеТранспорта.СведенияПрослеживаемости КАК СписаниеТранспортаСведенияПрослеживаемости
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СписаниеТранспорта КАК СписаниеТранспорта
	|		ПО СписаниеТранспортаСведенияПрослеживаемости.Ссылка = СписаниеТранспорта.Ссылка
	|ГДЕ
	|	СписаниеТранспорта.Ссылка = &Ссылка
	|	И СписаниеТранспортаСведенияПрослеживаемости.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаДокумент.Дата КАК Период,
	|	ТаблицаДокумент.Ссылка КАК Регистратор,
	|	ТаблицаДокумент.Организация КАК Организация,
	|	ЗНАЧЕНИЕ(Перечисление.ПорядокОтраженияВОтчетностиПоПрослеживаемости.ОтчетОбОперациях) КАК ОтражениеВОтчетности,
	|	НАЧАЛОПЕРИОДА(ТаблицаДокумент.Дата, КВАРТАЛ) КАК ПериодОперации,
	|	ТаблицаДокумент.Ссылка КАК ДокументОперации,
	|	РНПТОС.РНПТ КАК РНПТ,
	|	ТаблицаДокумент.Контрагент КАК Контрагент,
	|	РНПТОС.ОсновноеСредство КАК ОсновноеСредство,
	|	РНПТОС.Комплектующее КАК Комплектующее,
	|	ТаблицаДокумент.КодОперацииПрослеживаемости КАК КодОперации,
	|	СУММА(РНПТОС.Количество) КАК Количество,
	|	СУММА(РНПТОС.КоличествоПрослеживаемости) КАК КоличествоПрослеживаемости,
	|	СУММА(ВЫБОР
	|			КОГДА ОстаткиРНПТ.Количество = 0
	|				ТОГДА 0
	|			КОГДА РНПТОС.Количество < ОстаткиРНПТ.Количество
	|				ТОГДА ОстаткиРНПТ.СуммаБезНДС * РНПТОС.Количество / ОстаткиРНПТ.Количество
	|			ИНАЧЕ ОстаткиРНПТ.СуммаБезНДС
	|		КОНЕЦ) КАК СуммаБезНДС,
	|	ВЫБОР
	|		КОГДА РНПТОС.Комплектующее = НЕОПРЕДЕЛЕНО
	|			ИЛИ РНПТОС.Комплектующее = ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)
	|			ИЛИ РНПТОС.Комплектующее = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА РНПТОС.ОсновноеСредство.СтранаПроисхождения
	|		ИНАЧЕ РНПТОС.Комплектующее.СтранаПроисхождения
	|	КОНЕЦ КАК СтранаПроисхождения,
	|	&ТипДокументаВПрослеживаемости КАК ТипДокументаВПрослеживаемости,
	|	ТаблицаДокумент.Номер КАК НомерДокумента,
	|	ТаблицаДокумент.Дата КАК ДатаДокумента
	|ИЗ
	|	РНПТОС КАК РНПТОС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СписаниеТранспорта КАК ТаблицаДокумент
	|		ПО РНПТОС.Ссылка = ТаблицаДокумент.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОстаткиРНПТ КАК ОстаткиРНПТ
	|		ПО РНПТОС.ОсновноеСредство = ОстаткиРНПТ.ОсновноеСредство
	|			И РНПТОС.Комплектующее = ОстаткиРНПТ.Комплектующее
	|ГДЕ
	|	ТаблицаДокумент.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаДокумент.Дата,
	|	ТаблицаДокумент.Ссылка,
	|	ТаблицаДокумент.Организация,
	|	РНПТОС.РНПТ,
	|	РНПТОС.ОсновноеСредство,
	|	РНПТОС.Комплектующее,
	|	ТаблицаДокумент.КодОперацииПрослеживаемости,
	|	ТаблицаДокумент.Номер,
	|	ТаблицаДокумент.Контрагент,
	|	ВЫБОР
	|		КОГДА РНПТОС.Комплектующее = НЕОПРЕДЕЛЕНО
	|			ИЛИ РНПТОС.Комплектующее = ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)
	|			ИЛИ РНПТОС.Комплектующее = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА РНПТОС.ОсновноеСредство.СтранаПроисхождения
	|		ИНАЧЕ РНПТОС.Комплектующее.СтранаПроисхождения
	|	КОНЕЦ,
	|	&ТипДокументаВПрослеживаемости";
	
//	ДоработатьТекстЗапросаДвиженийПрослеживаемыеТовары(Запрос.Текст, ДокументОбъект);
	
	Результат = Запрос.Выполнить().Выгрузить();
	Возврат Результат;

КонецФункции

Функция ОперацииСПрослеживаемымиТоварамиДвижениеСчетаФактуры(ДокументОбъект)
	
	ТипДокумента = ТипЗнч(ДокументОбъект);
	
	Если ТипДокумента = Тип("ДокументОбъект.СчетФактураПолученный") Тогда
		Если Не СчетФактураПолученныйРегистрируетсяВКнигеПродаж(ДокументОбъект) Тогда
			Возврат ПустаяТаблицаОперацииСПрослеживаемымиТоварами();
		КонецЕсли;
	КонецЕсли;
	
	Возврат ОперацииСПрослеживаемымиТоварамиДвижениеСчетаФактурыБезУчетаСуммыНДС(ДокументОбъект);
	
КонецФункции

Функция ОперацииСПрослеживаемымиТоварамиЗаписьКнигиПокупок(ДокументОбъект)
	Если ТипЗнч(ДокументОбъект.ДокументОснование) = Тип("ДокументСсылка.ГТДИмпорт") Тогда
		Возврат ОперацииСПрослеживаемымиТоварамиЗаписьКнигиПокупокГТДИмпорт(ДокументОбъект);
	ИначеЕсли ТипЗнч(ДокументОбъект.ДокументОснование) = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
		Возврат ОперацииСПрослеживаемымиТоварамиЗаписьКнигиПокупокПоСчетФактуре(ДокументОбъект);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

Процедура СформироватьДвиженияПрослеживаемыеТоварыОтгруженныеВЕАЭС_МЗ(ДокументОбъект, ДополнительныеСвойства)
	
	РеализацияМЗ = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДополнительныеСвойства, "ТаблицаРеализацияМатериальныхЗапасов");
	Если РеализацияМЗ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	РеализацияМЗ.Свернуть("НомерСтроки", "СуммаРуб, СуммаНДСРуб");
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументОбъект.Ссылка);
	Запрос.УстановитьПараметр("СуммыРеализации", РеализацияМЗ);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СуммыРеализации.НомерСтроки КАК НомерСтроки,
	|	СуммыРеализации.СуммаРуб КАК Сумма,
	|	СуммыРеализации.СуммаНДСРуб КАК СуммаНДС
	|ПОМЕСТИТЬ СуммыРеализации
	|ИЗ
	|	&СуммыРеализации КАК СуммыРеализации
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаДокумент.Дата КАК Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	ТаблицаДокумент.Организация КАК Организация,
	|	ТаблицаДокумент.Контрагент КАК Контрагент,
	|	ТаблицаДокумент.Ссылка КАК СопроводительныйДокумент,
	|	&ПолеНоменклатура КАК Номенклатура,
	|	ТаблицаСведенияПрослеживаемости.РНПТ КАК РНПТ,
	|	ТаблицаМатериалы.НомерСтроки КАК ПорядковыйНомер,
	|	ТаблицаСведенияПрослеживаемости.Количество КАК Количество,
	|	ТаблицаСведенияПрослеживаемости.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости,
	|	СуммыРеализации.Сумма - СуммыРеализации.СуммаНДС КАК Сумма
	|ИЗ
	|	ВТ_ТаблицаМатериалы КАК ТаблицаМатериалы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТаблицаДокумент КАК ТаблицаДокумент
	|		ПО ТаблицаМатериалы.Ссылка = ТаблицаДокумент.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТаблицаСведенияПрослеживаемости КАК ТаблицаСведенияПрослеживаемости
	|		ПО ТаблицаМатериалы.Ссылка = ТаблицаСведенияПрослеживаемости.Ссылка
	|			И ТаблицаМатериалы.ИдентификаторСтроки = ТаблицаСведенияПрослеживаемости.ИдентификаторСтроки
	|		ЛЕВОЕ СОЕДИНЕНИЕ СуммыРеализации КАК СуммыРеализации
	|		ПО ТаблицаМатериалы.НомерСтроки = СуммыРеализации.НомерСтроки
	|ГДЕ
	|	ТаблицаДокумент.Ссылка = &Ссылка
	|	И ТаблицаМатериалы.Ссылка = &Ссылка
	|	И ТаблицаСведенияПрослеживаемости.Ссылка = &Ссылка";
	
	ДоработатьТекстЗапросаДвиженийПрослеживаемыеТовары(Запрос.Текст, ДокументОбъект);
	
	ПрослеживаемыеТоварыОтгруженныеВЕАЭС = ДокументОбъект.Движения.ПрослеживаемыеТоварыОтгруженныеВЕАЭС;
	ПрослеживаемыеТоварыОтгруженныеВЕАЭС.Очистить();
	ПрослеживаемыеТоварыОтгруженныеВЕАЭС.Записывать = Истина;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НовоеДвижение = ПрослеживаемыеТоварыОтгруженныеВЕАЭС.Добавить();
		ЗаполнитьЗначенияСвойств(НовоеДвижение, Выборка);
		
	КонецЦикла;
	
	Если ПолучитьФункциональнуюОпцию("ФормированиеПроводокОбособленноОтДокумента") Тогда
		ПрослеживаемыеТоварыОтгруженныеВЕАЭС.Записать(Истина);
	КонецЕсли;

КонецПроцедуры

// Сформировать движения прослеживаемые товары отгруженные ВЕАЭС ОС.
// 
// Параметры:
//  ДокументОбъект - ДокументОбъект -  Документ объект
//  ДополнительныеСвойства - Структура -  Дополнительные свойства
Процедура СформироватьДвиженияПрослеживаемыеТоварыОтгруженныеВЕАЭС_ОС(ДокументОбъект, ДополнительныеСвойства)
	
	Если ДокументОбъект.Ссылка.Пустая() Тогда
		Период = Новый Граница(ДокументОбъект.Дата, ВидГраницы.Включая);
	Иначе
		Период = Новый Граница(ДокументОбъект.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("Ссылка", ДокументОбъект.Ссылка);
	Запрос.УстановитьПараметр("Организация", ДокументОбъект.Организация);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПрослеживаемыеОСОстатки.Организация КАК Организация,
	|	ПрослеживаемыеОСОстатки.РНПТ КАК РНПТ,
	|	ПрослеживаемыеОСОстатки.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ПрослеживаемыеОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	ПрослеживаемыеОСОстатки.Комплектующее КАК Комплектующее,
	|	ПрослеживаемыеОСОстатки.КоличествоОстаток КАК КоличествоОстаток,
	|	ПрослеживаемыеОСОстатки.КоличествоПрослеживаемостиОстаток КАК КоличествоПрослеживаемостиОстаток,
	|	ПрослеживаемыеОСОстатки.СуммаБезНДСОстаток КАК СуммаБезНДСОстаток
	|ПОМЕСТИТЬ ОстаткиРНПТ
	|ИЗ
	|	РегистрНакопления.ПрослеживаемыеОС.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И РНПТ В
	|					(ВЫБРАТЬ
	|						ТаблицаСведенияПрослеживаемости.РНПТ
	|					ИЗ
	|						ВТ_ТаблицаСведенияПрослеживаемости КАК ТаблицаСведенияПрослеживаемости
	|					ГДЕ
	|						ТаблицаСведенияПрослеживаемости.Ссылка = &Ссылка)) КАК ПрослеживаемыеОСОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаДокумент.Дата КАК Период,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	ТаблицаДокумент.Организация КАК Организация,
	|	ТаблицаДокумент.Контрагент КАК Контрагент,
	|	ТаблицаДокумент.Ссылка КАК СопроводительныйДокумент,
	|	&ПолеНоменклатура КАК ОсновноеСредство,
	|	ТаблицаСведенияПрослеживаемости.РНПТ КАК РНПТ,
	|	ТаблицаМатериалы.НомерСтроки КАК ПорядковыйНомер,
	|	ТаблицаСведенияПрослеживаемости.Количество КАК Количество,
	|	ТаблицаСведенияПрослеживаемости.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости,
	|	ТаблицаСведенияПрослеживаемости.Комплектующее КАК Комплектующее
	|ПОМЕСТИТЬ РНПТОС
	|ИЗ
	|	ВТ_ТаблицаМатериалы КАК ТаблицаМатериалы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТаблицаДокумент КАК ТаблицаДокумент
	|		ПО ТаблицаМатериалы.Ссылка = ТаблицаДокумент.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТаблицаСведенияПрослеживаемости КАК ТаблицаСведенияПрослеживаемости
	|		ПО ТаблицаМатериалы.Ссылка = ТаблицаСведенияПрослеживаемости.Ссылка
	|			И ТаблицаМатериалы.ИдентификаторСтроки = ТаблицаСведенияПрослеживаемости.ИдентификаторСтроки
	|ГДЕ
	|	ТаблицаДокумент.Ссылка = &Ссылка
	|	И ТаблицаМатериалы.Ссылка = &Ссылка
	|	И ТаблицаСведенияПрослеживаемости.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РНПТОС.Период КАК Период,
	|	РНПТОС.ВидДвижения КАК ВидДвижения,
	|	РНПТОС.Организация КАК Организация,
	|	РНПТОС.Контрагент КАК Контрагент,
	|	РНПТОС.СопроводительныйДокумент КАК СопроводительныйДокумент,
	|	РНПТОС.РНПТ КАК РНПТ,
	|	РНПТОС.ПорядковыйНомер КАК ПорядковыйНомер,
	|	РНПТОС.Количество КАК Количество,
	|	РНПТОС.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости,
	|	ВЫБОР
	|		КОГДА РНПТОС.Комплектующее = НЕОПРЕДЕЛЕНО
	|			ТОГДА РНПТОС.ОсновноеСредство
	|		ИНАЧЕ РНПТОС.Комплектующее
	|	КОНЕЦ КАК Номенклатура,
	|	ОстаткиРНПТ.СуммаБезНДСОстаток КАК Сумма
	|ИЗ
	|	РНПТОС КАК РНПТОС
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиРНПТ КАК ОстаткиРНПТ
	|		ПО РНПТОС.Организация = ОстаткиРНПТ.Организация
	|			И РНПТОС.РНПТ = ОстаткиРНПТ.РНПТ
	|			И РНПТОС.ОсновноеСредство = ОстаткиРНПТ.ОсновноеСредство
	|			И РНПТОС.Комплектующее = ОстаткиРНПТ.Комплектующее";
	
	ДоработатьТекстЗапросаДвиженийПрослеживаемыеТовары(Запрос.Текст, ДокументОбъект);
	
	ПрослеживаемыеТоварыОтгруженныеВЕАЭС = ДокументОбъект.Движения.ПрослеживаемыеТоварыОтгруженныеВЕАЭС;
	ПрослеживаемыеТоварыОтгруженныеВЕАЭС.Очистить();
	ПрослеживаемыеТоварыОтгруженныеВЕАЭС.Записывать = Истина;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НовоеДвижение = ПрослеживаемыеТоварыОтгруженныеВЕАЭС.Добавить();
		ЗаполнитьЗначенияСвойств(НовоеДвижение, Выборка);
		
	КонецЦикла;
	
	Если ПолучитьФункциональнуюОпцию("ФормированиеПроводокОбособленноОтДокумента") Тогда
		ПрослеживаемыеТоварыОтгруженныеВЕАЭС.Записать(Истина);
	КонецЕсли;

КонецПроцедуры

Процедура ДоработатьТекстЗапросаДвиженийПрослеживаемыеТовары(ТекстЗапроса, ДокументОбъект, ТипОперации = Неопределено)
	МетаданныеДокумента = ДокументОбъект.Метаданные();
	ИмяДокумента = МетаданныеДокумента.ПолноеИмя();
	ТЧМатериалы = ИмяОсновнойТабличнойЧастиДокумента(МетаданныеДокумента);
	РеквизитНоменклатура = ИмяРеквизитаНоменклатура(МетаданныеДокумента, ТЧМатериалы);
	Шаблон = "%1.%2";
	ИмяТаблицыМатериалы = СтрШаблон(Шаблон, ИмяДокумента, ТЧМатериалы);
	ИмяТаблицыСведенияПрослеживаемости = СтрШаблон(Шаблон, ИмяДокумента, "СведенияПрослеживаемости");
	ЕстьРеквизитВариантКомплекта = МетаданныеДокумента.ТабличныеЧасти[ТЧМатериалы].Реквизиты.Найти("ВариантКомплектаПТ") <> Неопределено;
	
	Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ТребованиеНакладная0315006") Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеСумма", "ТаблицаМатериалы.СуммаПередачи");
	ИначеЕсли ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ПоступлениеОС") Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеСумма",
		"ВЫБОР
		|	КОГДА ТаблицаСведенияПрослеживаемости.Комплектующее = НЕОПРЕДЕЛЕНО
		|	ИЛИ ТаблицаСведенияПрослеживаемости.Комплектующее = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|	ИЛИ ТаблицаСведенияПрослеживаемости.Комплектующее = ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)
		|		ТОГДА ТаблицаМатериалы.Всего - ТаблицаМатериалы.СуммаНДС
		|	ИНАЧЕ ТаблицаСведенияПрослеживаемости.СуммаБезНДС
		|КОНЕЦ");
	ИначеЕсли ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ПринятиеКУчетуОбъектовОС")
		Или ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.РешениеОПризнанииОбъектовОС")
		Или ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.РешениеОПризнанииОбъектовОСИК") Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеСумма",
		"ВЫБОР
		|	КОГДА ТаблицаСведенияПрослеживаемости.Комплектующее = НЕОПРЕДЕЛЕНО
		|	ИЛИ ТаблицаСведенияПрослеживаемости.Комплектующее = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|	ИЛИ ТаблицаСведенияПрослеживаемости.Комплектующее = ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)
		|		ТОГДА ТаблицаМатериалы.Сумма
		|	ИНАЧЕ ТаблицаСведенияПрослеживаемости.СуммаБезНДС
		|КОНЕЦ");
	ИначеЕсли ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ПоступлениеМЗ") Тогда	
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеСумма",
		"ВЫБОР
		|	КОГДА ТаблицаСведенияПрослеживаемости.Комплектующее = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|		ТОГДА ТаблицаМатериалы.Всего - ТаблицаМатериалы.СуммаНДС
		|	ИНАЧЕ ТаблицаСведенияПрослеживаемости.СуммаБезНДС
		|КОНЕЦ");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
			"&ПолеСумма",
			"ТаблицаМатериалы.Всего - ТаблицаМатериалы.СуммаНДС");
	КонецЕсли;
	
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Контрагент", МетаданныеДокумента) Тогда
		ПолеКонтрагент = "ТаблицаДокумент.Контрагент";
	Иначе
		ПолеКонтрагент = "ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)";
	КонецЕсли;
	
	Если ЭтоВыбытиеОС(ДокументОбъект) Тогда
		ПолеИнвНомерОС = "ТаблицаМатериалы.ИнвентарныйНомер";
	Иначе
		ПолеИнвНомерОС = "ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)";
	КонецЕсли;
		
	Если ЭтоОказаниеУслуг(ДокументОбъект) Тогда
		ПолеСтранаПроисхождения = "ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)";
	Иначе
		ПолеСтранаПроисхождения = "ТаблицаМатериалы.СтранаПроисхождения";
	КонецЕсли;

	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеНоменклатура", "ТаблицаМатериалы." + РеквизитНоменклатура);
	
	Если Не ОбщегоНазначения.ЕстьРеквизитОбъекта("КодОперацииПрослеживаемости", МетаданныеДокумента) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТаблицаДокумент.КодОперацииПрослеживаемости", "ЗНАЧЕНИЕ(Справочник.КодыОперацийПрослеживаемости.Реализация)");
	КонецЕсли;
					
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ДатаПервичногоДокумента", МетаданныеДокумента) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДатаПервичногоДокумента", "ТаблицаДокумент.ДатаПервичногоДокумента");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НомерПервичногоДокумента", "ТаблицаДокумент.НомерПервичногоДокумента");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ДатаПервичногоДокумента", "ТаблицаДокумент.Дата");
		НомерДокумента = РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
			ДокументОбъект.Ссылка, ДокументОбъект.Номер);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НомерПервичногоДокумента", """" + НомерДокумента + """");
	КонецЕсли;
	
	Если ЕстьРеквизитВариантКомплекта Тогда
		ПолеВариантКомплекта = "ТаблицаМатериалы.ВариантКомплектаПТ";
	Иначе
		ПолеВариантКомплекта = "ЗНАЧЕНИЕ(Справочник.ВариантыКомплектовМЗПТ.ПустаяСсылка)";
	КонецЕсли;
	
	Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.РеконструкцияОС") Тогда
		ПолеОсновноеСредствоТаблицыМатериалы = "ТаблицаМатериалы.Ссылка.ВнеоборотныйАктив";
	Иначе
		ПолеОсновноеСредствоТаблицыМатериалы = "ТаблицаМатериалы.ОсновноеСредство";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВТ_ТаблицаМатериалы", ИмяТаблицыМатериалы);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВТ_ТаблицаДокумент", ИмяДокумента);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВТ_ТаблицаСведенияПрослеживаемости", ИмяТаблицыСведенияПрослеживаемости);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеКонтрагент", ПолеКонтрагент); 
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеВариантКомплекта", ПолеВариантКомплекта);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеОсновноеСредство", ПолеОсновноеСредствоТаблицыМатериалы);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеИнвНомерОС", ПолеИнвНомерОС);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеСтранаПроисхождения", ПолеСтранаПроисхождения);

КонецПроцедуры

Функция ИмяОсновнойТабличнойЧастиДокумента(МетаданныеДокумента)

	ПроверяемыеИмена = Новый Массив;
	ПроверяемыеИмена.Добавить("Номенклатура");
	ПроверяемыеИмена.Добавить("Материалы");
	ПроверяемыеИмена.Добавить("КапВложения");
	ПроверяемыеИмена.Добавить("ОсновныеСредства");
	ПроверяемыеИмена.Добавить("Продукция");
	ПроверяемыеИмена.Добавить("УслугиОказанные");
	ПроверяемыеИмена.Добавить("СоставЭтапаРабот");
	
	Для каждого Имя Из ПроверяемыеИмена Цикл
		Если МетаданныеДокумента.ТабличныеЧасти.Найти(Имя) <> Неопределено Тогда
			Возврат Имя;
		КонецЕсли;
	КонецЦикла;
	
	ВызватьИсключение "Не предусмотрено движение по регистру ""ОперацииСПрослеживаемымиТоварами""";

КонецФункции

Функция ИмяРеквизитаНоменклатура(МетаданныеДокумента, ИмяТЧ)
	
	ПроверяемыеИмена = Новый Массив;
	ПроверяемыеИмена.Добавить("Номенклатура");
	ПроверяемыеИмена.Добавить("ВнеоборотныйАктив");
	ПроверяемыеИмена.Добавить("ОсновноеСредство");

	ТабличнаяЧасть = МетаданныеДокумента.ТабличныеЧасти[ИмяТЧ];
	Для каждого Имя Из ПроверяемыеИмена Цикл
		Если ТабличнаяЧасть.Реквизиты.Найти(Имя) <> Неопределено Тогда
			Возврат Имя;
		КонецЕсли;
	КонецЦикла;
		
	ВызватьИсключение "Не предусмотрено движение по регистру ""ОперацииСПрослеживаемымиТоварами""";

КонецФункции

