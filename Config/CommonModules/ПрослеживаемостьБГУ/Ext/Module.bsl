Процедура ЗаполнитьОтчетОбОперациях(ПараметрыОтчета, Контейнер) Экспорт
	
	Если ПараметрыОтчета.Свойство("ДатаНачалаРасширенногоПериодаОтчета") Тогда
		НачалоПериодаОтчета = ПараметрыОтчета.ДатаНачалаРасширенногоПериодаОтчета;
	Иначе
		НачалоПериодаОтчета = ПараметрыОтчета.мДатаНачалаПериодаОтчета;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Организация", Новый ФиксированныйМассив(ПрослеживаемостьПереопределяемый.ВсяОрганизация(ПараметрыОтчета.Организация)));
	Запрос.УстановитьПараметр("НачалоПериода", НачалоКвартала(НачалоПериодаОтчета));
	Запрос.УстановитьПараметр("КонецПериода", КонецКвартала(ПараметрыОтчета.мДатаКонцаПериодаОтчета));
	Запрос.УстановитьПараметр("ДатаПодписи", КонецДня(Макс(ПараметрыОтчета.ДатаПодписи, ПараметрыОтчета.мДатаКонцаПериодаОтчета)));
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОперацииСПрослеживаемымиТоварами.ДокументОперации КАК ДокументОперации,
	|	ОперацииСПрослеживаемымиТоварами.Период КАК ДатаОперации,
	|	ОперацииСПрослеживаемымиТоварами.Организация КАК Организация,
	|	ОперацииСПрослеживаемымиТоварами.КодОперации КАК КодОперации,
	|	ОперацииСПрослеживаемымиТоварами.Контрагент КАК Контрагент,
	|	ОперацииСПрослеживаемымиТоварами.ТипДокументаВПрослеживаемости КАК ТипДокументаВПрослеживаемости,
	|	ОперацииСПрослеживаемымиТоварами.РНПТ КАК РНПТ,
	|	ОперацииСПрослеживаемымиТоварами.КоличествоПрослеживаемости КАК Количество,
	|	ОперацииСПрослеживаемымиТоварами.СуммаБезНДС КАК СуммаБезНДС,
	|	ОперацииСПрослеживаемымиТоварами.НомерДокумента КАК НомерДокумента,
	|	ОперацииСПрослеживаемымиТоварами.ДатаДокумента КАК ДатаДокумента,
	|	ОперацииСПрослеживаемымиТоварами.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ ВсеОперации
	|ИЗ
	|	РегистрСведений.ОперацииСПрослеживаемымиТоварами КАК ОперацииСПрослеживаемымиТоварами
	|ГДЕ
	|	ОперацииСПрослеживаемымиТоварами.Период <= &ДатаПодписи
	|	И ОперацииСПрослеживаемымиТоварами.Организация В(&Организация)
	|	И ОперацииСПрослеживаемымиТоварами.ОтражениеВОтчетности = ЗНАЧЕНИЕ(Перечисление.ПорядокОтраженияВОтчетностиПоПрослеживаемости.ОтчетОбОперациях)
	|	И ОперацииСПрослеживаемымиТоварами.Период >= &НачалоПериода
	|	И ОперацииСПрослеживаемымиТоварами.Период <= &КонецПериода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВсеОперации.ДатаОперации КАК ДатаОперации,
	|	ВсеОперации.ДокументОперации КАК ДокументОперации,
	|	ВсеОперации.Организация КАК Организация,
	|	ВсеОперации.КодОперации КАК КодОперации,
	|	ВсеОперации.Контрагент КАК Контрагент,
	|	ВсеОперации.ТипДокументаВПрослеживаемости КАК ТипДокументаВПрослеживаемости,
	|	ВсеОперации.Номенклатура.КодТНВЭД КАК КодТНВЭД,
	|	ВсеОперации.РНПТ КАК РНПТ,
	|	ВЫБОР ВсеОперации.ТипДокументаВПрослеживаемости
	|		КОГДА ЗНАЧЕНИЕ(Справочник.ТипыДокументов.СчетФактура)
	|			ТОГДА 1
	|		КОГДА ЗНАЧЕНИЕ(Справочник.ТипыДокументов.КорректировочныйСчетФактура)
	|			ТОГДА 2
	|		КОГДА ЗНАЧЕНИЕ(Справочник.ТипыДокументов.УПД)
	|			ТОГДА 3
	|		КОГДА ЗНАЧЕНИЕ(Справочник.ТипыДокументов.УКД)
	|			ТОГДА 4
	|		ИНАЧЕ 5
	|	КОНЕЦ КАК КодТипаДокумента,
	|	СУММА(ВсеОперации.Количество) КАК Количество,
	|	СУММА(ВсеОперации.СуммаБезНДС) КАК СуммаБезНДС,
	|	ВсеОперации.НомерДокумента КАК НомерДокумента,
	|	ВсеОперации.ДатаДокумента КАК ДатаДокумента,
	|	ВсеОперации.Контрагент.ИНН КАК ИНН,
	|	ВсеОперации.Контрагент.КПП КАК КПП,
	|	ВЫБОР
	|		КОГДА ВсеОперации.Контрагент.ЮридическоеФизическоеЛицо ССЫЛКА Справочник.ЮридическиеЛица
	|			ТОГДА ВЫРАЗИТЬ(ВсеОперации.Контрагент.ЮридическоеФизическоеЛицо КАК Справочник.ЮридическиеЛица).НаименованиеПолное
	|		ИНАЧЕ ВсеОперации.Контрагент.НаименованиеСокращенное
	|	КОНЕЦ КАК НаименованиеКонтрагента,
	|	ВсеОперации.Номенклатура.КодТНВЭД.ЕдиницаИзмерения.Код КАК ЕдиницаИзмерения
	|ИЗ
	|	ВсеОперации КАК ВсеОперации
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВсеОперации КАК СторнирующиеЗаписи
	|		ПО ВсеОперации.Организация = СторнирующиеЗаписи.Организация
	|			И ВсеОперации.КодОперации = СторнирующиеЗаписи.КодОперации
	|			И ВсеОперации.Контрагент = СторнирующиеЗаписи.Контрагент
	|			И ВсеОперации.ТипДокументаВПрослеживаемости = СторнирующиеЗаписи.ТипДокументаВПрослеживаемости
	|			И ВсеОперации.Номенклатура = СторнирующиеЗаписи.Номенклатура
	|			И ВсеОперации.РНПТ = СторнирующиеЗаписи.РНПТ
	|			И (СторнирующиеЗаписи.Количество = 0)
	|ГДЕ
	|	СторнирующиеЗаписи.Организация ЕСТЬ NULL
	|
	|СГРУППИРОВАТЬ ПО
	|	ВсеОперации.ДатаОперации,
	|	ВсеОперации.ДокументОперации,
	|	ВсеОперации.Организация,
	|	ВсеОперации.КодОперации,
	|	ВсеОперации.Контрагент,
	|	ВсеОперации.ТипДокументаВПрослеживаемости,
	|	ВсеОперации.Номенклатура.КодТНВЭД,
	|	ВсеОперации.РНПТ,
	|	ВсеОперации.НомерДокумента,
	|	ВсеОперации.ДатаДокумента,
	|	ВсеОперации.Контрагент.ИНН,
	|	ВсеОперации.Контрагент.КПП,
	|	ВсеОперации.Номенклатура.КодТНВЭД.ЕдиницаИзмерения.Код,
	|	ВЫБОР
	|		КОГДА ВсеОперации.Контрагент.ЮридическоеФизическоеЛицо ССЫЛКА Справочник.ЮридическиеЛица
	|			ТОГДА ВЫРАЗИТЬ(ВсеОперации.Контрагент.ЮридическоеФизическоеЛицо КАК Справочник.ЮридическиеЛица).НаименованиеПолное
	|		ИНАЧЕ ВсеОперации.Контрагент.НаименованиеСокращенное
	|	КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДокументОперации";
	
	Результат = Запрос.Выполнить();
	
	Если Не Результат.Пустой() Тогда
		
		Реестр = Контейнер.Реестр;
		Реестр.Строки.Очистить();
		НоваяСтраница = Реестр.Строки.Добавить();
		
		НоваяСтраница.Данные = Новый Структура("СтоимостьИтого", 0);
		НоваяСтраница.ДанныеМногострочныхЧастей = Новый Структура("П10000", ДеревоЗначенийОтчетОбОперациях());
		Счетчик = 1;
		
		Выборка = Результат.Выбрать();
		Пока Выборка.СледующийПоЗначениюПоля("ДокументОперации") Цикл
				
			Если Счетчик > ПараметрыОтчета.МаксКолСтрокНаСтранице Тогда
				
				НоваяСтраница = Реестр.Строки.Добавить();
				НоваяСтраница.Данные = Новый Структура("СтоимостьИтого", 0);
				НоваяСтраница.ДанныеМногострочныхЧастей = Новый Структура("П10000", ДеревоЗначенийОтчетОбОперациях());
				
				Счетчик = 1;
				
			КонецЕсли;
			
			НоваяСтрокаОперации = НоваяСтраница.ДанныеМногострочныхЧастей.П10000.Строки.Добавить();
			СтруктураДанныхОперации = Новый Структура;
			СтруктураДанныхОперации.Вставить("П1000001", 0);
			СтруктураДанныхОперации.Вставить("П1000002", Выборка.ДатаОперации);
			СтруктураДанныхОперации.Вставить("П1000003", Выборка.КодОперации);
			СтруктураДанныхОперации.Вставить("П1000004", Выборка.КодТипаДокумента);
			СтруктураДанныхОперации.Вставить("П1000005", Выборка.НомерДокумента);
			СтруктураДанныхОперации.Вставить("П1000006", Выборка.ДатаДокумента);
			СтруктураДанныхОперации.Вставить("П1000007", Выборка.НаименованиеКонтрагента);
			СтруктураДанныхОперации.Вставить("П1000008", Выборка.ИНН);
			СтруктураДанныхОперации.Вставить("П1000009", Выборка.КПП);
			
			НоваяСтрокаОперации.Данные = СтруктураДанныхОперации;
			НоваяСтрокаОперации.ДанныеМногострочныхЧастей = Новый Структура("П11000", ДеревоЗначенийОтчетОбОперациях());
			
			Пока Выборка.СледующийПоЗначениюПоля("РНПТ") Цикл
				НовыйРНПТ = НоваяСтрокаОперации.ДанныеМногострочныхЧастей.П11000.Строки.Добавить();
				
				НовыйРНПТ.Данные = Новый Структура;
				НовыйРНПТ.Данные.Вставить("П1100010", Выборка.РНПТ);
				НовыйРНПТ.Данные.Вставить("П1100011", Выборка.ЕдиницаИзмерения);
				НовыйРНПТ.Данные.Вставить("П1100012", Выборка.Количество);
				НовыйРНПТ.Данные.Вставить("П1100013", Выборка.СуммаБезНДС);
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОсобоеЗаполнениеПараметровОтраженияВПрослеживаемости(ДокументОбъект)
	ТипДокумента = ТипЗнч(ДокументОбъект);
	
	ОбъектыСПроцедуройВМенеджере = Новый Массив;
	ОбъектыСПроцедуройВМенеджере.Добавить(Тип("ДокументОбъект.ПринятиеКУчетуОбъектовОС"));
	ОбъектыСПроцедуройВМенеджере.Добавить(Тип("ДокументОбъект.ПоступлениеОС"));
	ОбъектыСПроцедуройВМенеджере.Добавить(Тип("ДокументОбъект.ПереводОбъектовОСизГрупповогоУчетаНаИндивидуальный"));
	
	Возврат(ОбъектыСПроцедуройВМенеджере.Найти(ТипДокумента) <> Неопределено);
КонецФункции

Процедура СформироватьДвиженияПрослеживаемостиПоДокументу(ТаблицаПроводок, ДокументОбъект, ДополнительныеРеквизиты) Экспорт
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
	ДополнительныеСвойства = КонтекстПроведения.ДополнительныеСвойства;
	
	// Параметры для формирования движений
	ПараметрыОтраженияВПрослеживаемости = ПараметрыОтраженияВПрослеживаемостиДокумента(ДокументОбъект,
		ДополнительныеСвойства, ТаблицаПроводок <> Неопределено);
	Если ЗначениеЗаполнено(ПараметрыОтраженияВПрослеживаемости.ДатаПроведения) Тогда
		ПараметрыОтраженияВПрослеживаемости.РНПТ_МЗ.ЗаполнитьЗначения(
			ПараметрыОтраженияВПрослеживаемости.ДатаПроведения,
			"Период");
		ПараметрыОтраженияВПрослеживаемости.РНПТ_ОС.ЗаполнитьЗначения(
			ПараметрыОтраженияВПрослеживаемости.ДатаПроведения,
			"Период");
	КонецЕсли;

	// Таблица проводок не задана, если это проведение без выбранной типовой операции или это резервирование МЗ
	ОбрабатыватьТолькоСписание = (ТаблицаПроводок = Неопределено);
	
	// Добавить движения перемещения РНПТ между объектами
	Если Не ОбрабатыватьТолькоСписание И Не ПараметрыОтраженияВПрослеживаемости.КонтрагентЧленЕАЭС Тогда
		ДобавитьДвиженияПеремещенияРНПТМеждуОбъектами(ДокументОбъект, ТаблицаПроводок,
			ПараметрыОтраженияВПрослеживаемости);
	КонецЕсли;
	
	// Отражение в отчете об операциях с прослеживамыми товарами или книге покупок (продаж)
	Если Не ПараметрыОтраженияВПрослеживаемости.КонтрагентЧленЕАЭС 
			И НЕ ОбрабатыватьТолькоСписание 
			И НЕ ПараметрыОтраженияВПрослеживаемости.ЭтоПеремещение
			И ТребуетсяДвижениеОперацииСПрослеживаемымиТоварами(ДокументОбъект) Тогда
		ОперацииСПрослеживаемымиТоварами = РегистрыСведений.ОперацииСПрослеживаемымиТоварами
			.СоздатьНаборЗаписей().ВыгрузитьКолонки();
		СформироватьДвиженияОперацииСПрослеживаемымиТоварами(ДокументОбъект,
			ПараметрыОтраженияВПрослеживаемости.РНПТ_МЗ, ОперацииСПрослеживаемымиТоварами);
		СформироватьДвиженияОперацииСПрослеживаемымиТоварами(ДокументОбъект,
			ПараметрыОтраженияВПрослеживаемости.РНПТ_ОС, ОперацииСПрослеживаемымиТоварами);
		ЗаписатьДвиженияОперацииСПрослеживаемымиТоварами(ДокументОбъект, ОперацииСПрослеживаемымиТоварами);
	КонецЕсли;
	
	Если ПараметрыОтраженияВПрослеживаемости.ЭтоПеремещение И ЭтоСписаниеОСВКомплект(ДокументОбъект)Тогда
		ПараметрыОтраженияВПрослеживаемости.РНПТ_ОС = РассчитатьТаблицуРНПТПоОстаточнойСтоимостиОС(ДокументОбъект,
		ПараметрыОтраженияВПрослеживаемости.РНПТ_ОС,
		"Комплектующее");
	КонецЕсли;
	
	// Отражение в регистрах остатков РНПТ
	Если Не ПараметрыОтраженияВПрослеживаемости.КонтрагентЧленЕАЭС
			Или ПараметрыОтраженияВПрослеживаемости.ЭтоСписание Тогда
		СформироватьДвиженияПрослеживаемыеТоварыПоДаннымОбъекта(ДокументОбъект,
			ПараметрыОтраженияВПрослеживаемости.РНПТ_МЗ, "МЗ", ОбрабатыватьТолькоСписание);
		СформироватьДвиженияПрослеживаемыеТоварыПоДаннымОбъекта(ДокументОбъект,
			ПараметрыОтраженияВПрослеживаемости.РНПТ_ОС, "ОС", ОбрабатыватьТолькоСписание);
	КонецЕсли;
	
	// Реализация в ЕАЭС
	Если ПараметрыОтраженияВПрослеживаемости.КонтрагентЧленЕАЭС
			И ПараметрыОтраженияВПрослеживаемости.ЭтоСписание Тогда
		Если ПараметрыОтраженияВПрослеживаемости.РНПТ_МЗ.Количество() > 0 Тогда
			СформироватьДвиженияПрослеживаемыеТоварыОтгруженныеВЕАЭС_МЗ(ДокументОбъект, ДополнительныеСвойства);
		ИначеЕсли ПараметрыОтраженияВПрослеживаемости.РНПТ_ОС.Количество() > 0 Тогда
			СформироватьДвиженияПрослеживаемыеТоварыОтгруженныеВЕАЭС_ОС(ДокументОбъект, ДополнительныеСвойства);
		КонецЕсли;
	КонецЕсли;

	Если Метаданные.ОпределяемыеТипы.ОснованиеДляПолученияРНПТ.Тип.СодержитТип(ТипЗнч(ДокументОбъект.Ссылка)) Тогда
		РегистрыСведений.РегистрацияПрослеживаемыхТоваров.ОбновитьСостояние(ДокументОбъект.Ссылка,
			ДокументОбъект.Ссылка);
	КонецЕсли;
		
КонецПроцедуры

// Добавить движения перемещения РНПТМежду объектами.
// 
// Параметры:
//  ДокументОбъект - ДокументОбъект
//  ТаблицаПроводок - ТаблицаЗначений
//  ПараметрыОтраженияВПрослеживаемости - см. ПараметрыОтраженияВПрослеживаемости
Процедура ДобавитьДвиженияПеремещенияРНПТМеждуОбъектами(ДокументОбъект, ТаблицаПроводок, ПараметрыОтраженияВПрослеживаемости)

	Если ПараметрыОтраженияВПрослеживаемости.ЭтоПеремещение
		Или Не ПараметрыОтраженияВПрослеживаемости.ЭтоСписание Тогда
		Возврат;
	КонецЕсли;
	
	МетаданныеДокумента = ДокументОбъект.Метаданные();
	ВозможноПеремещениеМатериалов = МетаданныеДокумента.Движения.Содержит(Метаданные.РегистрыНакопления.ПрослеживаемыеТовары);
	ВозможноПеремещениеОС = МетаданныеДокумента.Движения.Содержит(Метаданные.РегистрыНакопления.ПрослеживаемыеОС);
	ВозможноПеремещениеОСМЗ = ВозможноПеремещениеМатериалов И ВозможноПеремещениеОС;
	
	Если ВозможноПеремещениеОСМЗ ИЛИ ПараметрыОтраженияВПрослеживаемости.ЭтоВыпуск Тогда
		
		СтруктураСтрокиПеремещений = СтрокиПеремещенияМЗ(ТаблицаПроводок, ДокументОбъект, ПараметрыОтраженияВПрослеживаемости.ЭтоВыпуск);
		Если СтруктураСтрокиПеремещений.ТипПеремещения <> Неопределено Тогда
				ПараметрыОтраженияВПрослеживаемости.ЭтоПеремещение = Истина;
		КонецЕсли;
		
		Если СтруктураСтрокиПеремещений.ТипПеремещения = "Производство"
			ИЛИ СтруктураСтрокиПеремещений.ТипПеремещения = "Работы" Тогда
			
			ДобавитьДвиженияВложенияВИзготовлениеОСМЗВТаблицуРНПТ(
			ТаблицаПроводок.Скопировать(СтруктураСтрокиПеремещений.Строки, "СубконтоДт1, СубконтоКт1, КоличествоКт, Сумма"),
			ПараметрыОтраженияВПрослеживаемости.РНПТ_МЗ,
			ПараметрыОтраженияВПрослеживаемости,
			СтруктураСтрокиПеремещений.Строки[0].ВидСубконтоДт1);
			
		ИначеЕсли СтруктураСтрокиПеремещений.ТипПеремещения = "Забаланс" Тогда
			
			ДобавитьДвиженияПереносаМЗНаЗабаланс(
			ТаблицаПроводок.Скопировать(СтруктураСтрокиПеремещений.Строки),
			ПараметрыОтраженияВПрослеживаемости.РНПТ_МЗ,
			ПараметрыОтраженияВПрослеживаемости);
			
		КонецЕсли;
		
