#КонецОбласти

#Область ОбработчикПослеФормированияПроводок

// Формирует движения прослеживаемости при формировании проводок типовой операции
// 
// Параметры:
//  ТаблицаПроводок - ТаблицаЗначений
//  ДокументОбъект - ДокументОбъект
//  ДополнительныеРеквизиты - Структура
Процедура СформироватьДвиженияПрослеживаемости(ТаблицаПроводок, ДокументОбъект, ДополнительныеРеквизиты) Экспорт
	
	Движения = ДокументОбъект.Движения;
	Если Движения.Найти("ОперацииСПрослеживаемымиТоварами") = Неопределено
		И Движения.Найти("ПрослеживаемыеОС") = Неопределено
		И Движения.Найти("ПрослеживаемыеТовары") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ВедетсяУчетПрослеживаемыхТоваров(ДокументОбъект.Дата) Тогда
		Возврат;
	КонецЕсли;
	
	Если РезервированиеНФА.ЭтоРезервированиеНФА(ДокументОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	СформироватьДвиженияПрослеживаемостиПоДокументу(ТаблицаПроводок, ДокументОбъект, ДополнительныеРеквизиты);

КонецПроцедуры
	
#КонецОбласти 

#Область Инвентаризация

Процедура ЗаполнитьПрослеживаемыеТовары(ДокументОбъект, ТолькоИзлишки) Экспорт
	
	ТаблицаТоваров = ПолучитьДанныеЗаполненияПрослеживаемыхТоваров(ДокументОбъект, ТолькоИзлишки);
	
	ДокументОбъект["ПрослеживаемыеТовары"].Загрузить(ТаблицаТоваров);
	
КонецПроцедуры

Функция ПолучитьДанныеЗаполненияПрослеживаемыхТоваров(ДокументОбъект, ТолькоИзлишки)
	
	Настройки = ПолучитьНастройкиПрослеживаемостиДляИнвентаризации(ДокументОбъект.Ссылка, ТолькоИзлишки);
	
	ТаблицаТоваров = ПолучитьТаблицуПрослеживаемыхТоваров(ДокументОбъект, Настройки);
	
	ВычестьЗарегистрированныеВПрослеживаемостиПоказатели(
		ТаблицаТоваров,
		ДокументОбъект["Организация"],
		ДокументОбъект["ДатаИнвентаризации"]);
		
	ТаблицаТоваров.Колонки.Найти("Товар").Имя = Настройки.ИмяКолонкиТоварПриемник;
	
	Возврат ТаблицаТоваров;
	
КонецФункции

Функция ПолучитьНастройкиПрослеживаемостиДляИнвентаризации(ДокументСсылка, ТолькоИзлишки)
	
	ТипДокумента = ТипЗнч(ДокументСсылка);
	
	ИменаКолонокИсточник = Новый Структура();
	
	Если ТипДокумента = Тип("ДокументСсылка.ИнвентаризацияМЗ") Тогда
		
		// Табличная часть-источник
		ИмяТабличнойЧастиИсточник = "Материалы";
		
		ИменаКолонокИсточник.Вставить("Товар", "Номенклатура");
		
		Если ТолькоИзлишки Тогда
			ИменаКолонокИсточник.Вставить("Количество",	"ИзлишекКоличество");
			ИменаКолонокИсточник.Вставить("Сумма",		"ИзлишекСумма");
		Иначе
			ИменаКолонокИсточник.Вставить("Количество",	"КоличествоУчет");
			ИменаКолонокИсточник.Вставить("Сумма",		"СуммаУчет");
		КонецЕсли;
		
		// Табличная часть-приемник ПрослеживаемыеТовары
		// Все прочие колонки табличной части-приемника называются одинаково во всех документах инвентаризации
		ИмяКолонкиТоварПриемник = "Номенклатура";
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ИнвентаризацияОС") Тогда
		
		// Табличная часть-источник
		ИмяТабличнойЧастиИсточник = "Инвентаризация";
		
		ИменаКолонокИсточник.Вставить("Товар", "ОсновноеСредство");
		
		Если ТолькоИзлишки Тогда
			ИменаКолонокИсточник.Вставить("Количество",	"КоличествоИзлишков");
			ИменаКолонокИсточник.Вставить("Сумма",		"СуммаИзлишков");
		Иначе
			ИменаКолонокИсточник.Вставить("Количество",	"КоличествоБУ");
			ИменаКолонокИсточник.Вставить("Сумма",		"СуммаБУ");
		КонецЕсли;
	
		// Табличная часть-приемник ПрослеживаемыеТовары
		// Все прочие колонки табличной части-приемника называются одинаково во всех документах инвентаризации
		ИмяКолонкиТоварПриемник = "ОС";
		
	Иначе
		ВызватьИсключение СтрШаблон(НСтр("ru='Указан неожидаемый тип документа инвентаризации ""%1"" в параметре функции ПолучитьНастройкиПрослеживаемостиДляИнвентаризации'"), ТипДокумента);
	КонецЕсли;
	
	Настройки = Новый Структура();
	Настройки.Вставить("ИмяТабличнойЧастиИсточник",	ИмяТабличнойЧастиИсточник);
	Настройки.Вставить("ИменаКолонокИсточник",		ИменаКолонокИсточник);
	Настройки.Вставить("ИмяКолонкиТоварПриемник",	ИмяКолонкиТоварПриемник);
	
	Возврат Настройки;
	
КонецФункции

Функция ПолучитьТаблицуПрослеживаемыхТоваров(ДокументОбъект, Настройки)
	
	ИмяТабличнойЧастиИсточник	= Настройки.ИмяТабличнойЧастиИсточник;
	ИменаКолонокИсточник		= Настройки.ИменаКолонокИсточник;
	
	ТабличнаяЧасть = ДокументОбъект[ИмяТабличнойЧастиИсточник];
	
	ТаблицаТоваров = ТабличнаяЧасть.Выгрузить(, ИменаКолонокИсточник.Товар + "," + ИменаКолонокИсточник.Количество + "," + ИменаКолонокИсточник.Сумма);
	
	ТаблицаТоваров.Колонки.Найти(ИменаКолонокИсточник.Товар).Имя		= "Товар";
	ТаблицаТоваров.Колонки.Найти(ИменаКолонокИсточник.Количество).Имя	= "Количество";
	ТаблицаТоваров.Колонки.Найти(ИменаКолонокИсточник.Сумма).Имя		= "Сумма";
	
	ТаблицаТоваров.Свернуть("Товар", "Количество,Сумма");
	
	ОставитьТолькоПрослеживаемыеТовары(ТаблицаТоваров);
	
	Возврат ТаблицаТоваров;
	
КонецФункции

Процедура ОставитьТолькоПрослеживаемыеТовары(ТаблицаТоваров)
	
	МассивТоваров = ТаблицаТоваров.ВыгрузитьКолонку("Товар");
	
	Количество = МассивТоваров.Количество();
	
	Для Счетчик = 1 По Количество Цикл
		Индекс = Количество - Счетчик;
		
		Если НЕ ЗначениеЗаполнено(МассивТоваров[Индекс]) Тогда
			МассивТоваров.Удалить(Индекс);
		КонецЕсли;
	КонецЦикла;
	
	Если МассивТоваров.Количество() > 0 Тогда
		СвойстваТоваров = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(МассивТоваров, "ПрослеживаемыйТовар");
	Иначе
		СвойстваТоваров = Новый Соответствие();
	КонецЕсли;
	
	КоличествоСтрок = ТаблицаТоваров.Количество();
	
	Для Счетчик = 1 По КоличествоСтрок Цикл
		СтрокаТаблицы = ТаблицаТоваров[КоличествоСтрок - Счетчик];
		
		ЭтоПрослеживаемыйТовар = (СвойстваТоваров.Получить(СтрокаТаблицы["Товар"]) = Истина);
		
		Если НЕ ЭтоПрослеживаемыйТовар Тогда
			ТаблицаТоваров.Удалить(СтрокаТаблицы);
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

Процедура ВычестьЗарегистрированныеВПрослеживаемостиПоказатели(ТаблицаТоваров, Знач Организация, Знач ДатаОстатков)
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ТаблицаТоваров",	ТаблицаТоваров);
	ЗапросПоиск.УстановитьПараметр("Организация",		Организация);
	ЗапросПоиск.УстановитьПараметр("ДатаОстатков",		ДатаОстатков);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Исходная таблица товаров (исключены дубли)
	|//
	|ВЫБРАТЬ
	|	ТЗ.Товар		КАК Товар,
	|	ТЗ.Количество	КАК Количество,
	|	ТЗ.Сумма		КАК Сумма
	|ПОМЕСТИТЬ
	|	ТаблицаТоваров
	|ИЗ
	|	&ТаблицаТоваров  КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Начатая регистрация
	|//
	|ВЫБРАТЬ
	|	Номенклатура		КАК Товар,
	|	СУММА(Количество)	КАК Количество,
	|	СУММА(Сумма)		КАК Сумма
	|ПОМЕСТИТЬ
	|	ТоварыНачатаРегистрация
	|ИЗ
	|	РегистрСведений.РегистрацияПрослеживаемыхТоваров
	|ГДЕ
	|	Организация = &Организация
	|	И ПериодСобытия <= &ДатаОстатков
	|	И Номенклатура В (ВЫБРАТЬ Товар ИЗ ТаблицаТоваров)
	|СГРУППИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Завершенная регистрация
	|//
	|ВЫБРАТЬ
	|	Номенклатура		КАК Товар,
	|	КоличествоОстаток	КАК Количество
	|ПОМЕСТИТЬ
	|	ТоварыЗавершенаРегистрация
	|ИЗ
	|	РегистрНакопления.ПрослеживаемыеТовары.Остатки(
	|		&ДатаОстатков,
	|		Организация = &Организация
	|		И Номенклатура В (ВЫБРАТЬ Товар ИЗ ТаблицаТоваров)
	|	) КАК Остатки
	|ГДЕ
	|	КоличествоОстаток > 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОсновноеСредство	КАК Товар,
	|	КоличествоОстаток	КАК Количество
	|ИЗ
	|	РегистрНакопления.ПрослеживаемыеОС.Остатки(
	|		&ДатаОстатков,
	|		Организация = &Организация
	|		И ОсновноеСредство В (ВЫБРАТЬ Товар ИЗ ТаблицаТоваров)
	|	) КАК Остатки
	|ГДЕ
	|	КоличествоОстаток > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Потенциал новой регистрации товаров
	|//
	|ВЫБРАТЬ
	|	ТаблицаТоваров.Товар										КАК Товар,
	|	ТаблицаТоваров.Количество
	|		- ЕСТЬNULL(ТоварыНачатаРегистрация.Количество, 0)
	|		- ЕСТЬNULL(ТоварыЗавершенаРегистрация.Количество, 0)	КАК Количество,
	|	ТаблицаТоваров.Сумма
	|		- ЕСТЬNULL(ТоварыНачатаРегистрация.Сумма, 0)			КАК Сумма
	|ПОМЕСТИТЬ
	|	ПотенциалРегистрации
	|ИЗ
	|	ТаблицаТоваров
	|	ЛЕВОЕ СОЕДИНЕНИЕ ТоварыНачатаРегистрация
	|		ПО	ТаблицаТоваров.Товар = ТоварыНачатаРегистрация.Товар
	|	ЛЕВОЕ СОЕДИНЕНИЕ ТоварыЗавершенаРегистрация
	|		ПО	ТаблицаТоваров.Товар = ТоварыЗавершенаРегистрация.Товар
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [4]. Новая регистрация товаров
	|//
	|ВЫБРАТЬ
	|	Товар			КАК Товар,
	|	Количество		КАК Количество,
	|	ВЫБОР
	|		КОГДА Сумма	>= 0 ТОГДА
	|			Сумма
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ			КАК Сумма
	|ИЗ
	|	ПотенциалРегистрации
	|ГДЕ
	|	Количество > 0
	|;";
	
	ТаблицаТоваров = ЗапросПоиск.Выполнить().Выгрузить();
	
КонецПроцедуры

#КонецОбласти

