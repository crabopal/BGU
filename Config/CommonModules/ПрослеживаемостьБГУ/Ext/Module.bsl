		//		СтрокиВложений = СтрокиВключенияМЗВРаботы(ТаблицаПроводок, ДокументОбъект);
		//		Если СтрокиВложений.Количество() > 0 Тогда
		//			ПараметрыОтраженияВПрослеживаемости.ЭтоПеремещение = Истина;
