#Область ОбработчикиОбновленияИнформационнойБазы

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНа_2_106(Параметры, ИмяТаблицы) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СведенияПрослеживаемости.Ссылка КАК Ссылка
	|ИЗ
	|	#ИмяТаблицы КАК СведенияПрослеживаемости
	|ГДЕ
	|	СведенияПрослеживаемости.Комплектующее <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|	И СведенияПрослеживаемости.СтранаПроисхождения = ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)";
	РегистрируемыеСсылки = Новый Массив;
	КоличествоСсылок = 0;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "#ИмяТаблицы", ИмяТаблицы);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		РегистрируемыеСсылки.Добавить(Выборка.Ссылка);
		КоличествоСсылок = КоличествоСсылок + 1;
		Если КоличествоСсылок = 1000 Тогда
			ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, РегистрируемыеСсылки);
			РегистрируемыеСсылки.Очистить();
			КоличествоСсылок = 0;
		КонецЕсли;
	КонецЦикла;
	
	Если РегистрируемыеСсылки.Количество() > 0 Тогда
		ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, РегистрируемыеСсылки);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаВерсию_2_106(Параметры, ПолноеИмяОбъекта, ИмяТЧМатериалы) Экспорт

	Параметры.ОбработкаЗавершена = Ложь;
	МетаданныеДокумента = Метаданные.НайтиПоПолномуИмени(ПолноеИмяОбъекта);
	ОбъектовОбработано = 0;
	ПроблемныхОбъектов = 0;
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыВыборкиДанныхДляОбработки();
	ДополнительныеПараметры.ИмяВременнойТаблицы = "ВТ_СсылкиДляОбработки";
	ОбновлениеИнформационнойБазы.СоздатьВременнуюТаблицуСсылокДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта, МенеджерВременныхТаблиц, ДополнительныеПараметры);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Материалы.Ссылка КАК Ссылка,
	|	Материалы.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	Материалы.Ссылка.ВерсияДанных КАК ВерсияДанных,
	|	Материалы.Номенклатура КАК Номенклатура,
	|	Материалы.ВариантКомплектаПТ КАК ВариантКомплектаПТ,
	|	Материалы.НомерСтроки КАК НомерСтрокиМатериалы,
	|	СведенияПрослеживаемости.Комплектующее КАК Комплектующее,
	|	СведенияПрослеживаемости.РНПТ КАК РНПТ,
	|	СведенияПрослеживаемости.НомерСтроки КАК НомерСтрокиСведедения
	|ПОМЕСТИТЬ ВТ_ДанныеДокументов
	|ИЗ
	|	#ИмяТаблицыНоменклатура КАК Материалы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ #ИмяТаблицыСП КАК СведенияПрослеживаемости
	|		ПО Материалы.Ссылка = СведенияПрослеживаемости.Ссылка
	|			И Материалы.ИдентификаторСтроки = СведенияПрослеживаемости.ИдентификаторСтроки
	|			И (Материалы.Номенклатура.КомплектСПрослеживаемымиТоварами)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СсылкиДляОбработки КАК ВТ_СсылкиДляОбработки
	|		ПО Материалы.Ссылка = ВТ_СсылкиДляОбработки.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_ДанныеДокументов.Ссылка КАК Ссылка,
	|	ВТ_ДанныеДокументов.ВерсияДанных КАК ВерсияДанных,
	|	ЕСТЬNULL(ПрослеживаемыеТовары.СтранаПроисхождения, КомплектующееСсылка.СтранаПроисхождения) КАК СтранаПроисхождения,
	|	ВТ_ДанныеДокументов.НомерСтрокиСведедения КАК НомерСтрокиСведедения,
	|	ВТ_ДанныеДокументов.НомерСтрокиМатериалы КАК НомерСтрокиМатериалы
	|ИЗ
	|	ВТ_ДанныеДокументов КАК ВТ_ДанныеДокументов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ПрослеживаемыеТовары КАК ПрослеживаемыеТовары
	|		ПО ВТ_ДанныеДокументов.Ссылка = ПрослеживаемыеТовары.Регистратор
	|			И ВТ_ДанныеДокументов.Номенклатура = ПрослеживаемыеТовары.Номенклатура
	|			И ВТ_ДанныеДокументов.ВариантКомплектаПТ = ПрослеживаемыеТовары.ВариантКомплекта
	|			И ВТ_ДанныеДокументов.Комплектующее = ПрослеживаемыеТовары.Комплектующее
	|			И ВТ_ДанныеДокументов.РНПТ = ПрослеживаемыеТовары.РНПТ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК КомплектующееСсылка
	|		ПО ВТ_ДанныеДокументов.Комплектующее = КомплектующееСсылка.Ссылка
	|ИТОГИ
	|	МАКСИМУМ(ВерсияДанных)
	|ПО
	|	Ссылка,
	|	НомерСтрокиМатериалы";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "#ИмяТаблицыНоменклатура", ПолноеИмяОбъекта+"."+ИмяТЧМатериалы);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "#ИмяТаблицыСП", ПолноеИмяОбъекта+".СведенияПрослеживаемости");

	ВыборкаСсылка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаСсылка.Следующий() Цикл
		
		НачатьТранзакцию();
		Попытка
			ПредставлениеОбъекта = Строка(ВыборкаСсылка.Ссылка);
			
			Блокировка = Новый БлокировкаДанных;
			Элемент = Блокировка.Добавить(ПолноеИмяОбъекта);
			Элемент.УстановитьЗначение("Ссылка", ВыборкаСсылка.Ссылка);
			Элемент.Режим = РежимБлокировкиДанных.Исключительный;
			
			Блокировка.Заблокировать();

			РасхождениеВерсий = Ложь;
			
			ОбработкаТранзакцииДанныхДляПереходаНаВерсию_2_106(ВыборкаСсылка, ПолноеИмяОбъекта, ИмяТЧМатериалы, ПроблемныхОбъектов, РасхождениеВерсий);
			ЗафиксироватьТранзакцию();
			
			Если РасхождениеВерсий Тогда
				Продолжить;
			КонецЕсли;
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстСообщения = НСтр("ru = 'Не удалось обработать объект: %Документ% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Документ%", ПредставлениеОбъекта);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Предупреждение,
			МетаданныеДокумента,
			ВыборкаСсылка.Ссылка,
			ТекстСообщения);
			ПроблемныхОбъектов = ПроблемныхОбъектов + 1;
			// Прервать текущую итерацию цикла, чтобы не увеличивать счетчик обработанных объектов.
			Продолжить;
			
		КонецПопытки;
		ОбъектовОбработано = ОбъектовОбработано + 1;
		
	КонецЦикла;
	
	Если ПроблемныхОбъектов <> 0 Тогда
		ТекстСообщения = СтрШаблон(
		НСтр("ru = 'Не удалось обработать некоторые документы ""%1"" (пропущены): %2'"),
		МетаданныеДокумента.Синоним,
		ПроблемныхОбъектов);
		ВызватьИсключение ТекстСообщения;
	ИначеЕсли ОбъектовОбработано > 0 Тогда
		ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
		УровеньЖурналаРегистрации.Информация, МетаданныеДокумента,,
		СтрШаблон(НСтр("ru = 'Обработана очередная порция документов ""%1"": %2'"),
		МетаданныеДокумента.Синоним,
		ОбъектовОбработано));
	КонецЕсли;
	
	Параметры.ОбработкаЗавершена = Не ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта)
КонецПроцедуры

Процедура ОбработкаТранзакцииДанныхДляПереходаНаВерсию_2_106(ВыборкаСсылка, ПолноеИмяОбъекта, ИмяТЧМатериалы, ПроблемныхОбъектов, РасхождениеВерсий)
	
	Объект = ВыборкаСсылка.Ссылка.ПолучитьОбъект();
	
	Если Объект = Неопределено Тогда
		ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(ВыборкаСсылка.Ссылка);
	Иначе
		
		Если Объект.ВерсияДанных <> ВыборкаСсылка.ВерсияДанных Тогда
			ПроблемныхОбъектов = ПроблемныхОбъектов + 1;
			РасхождениеВерсий = Истина;
			Возврат;
		КонецЕсли;
		
		Объект.Заблокировать();
		
		ВыборкаСтрокаМатериалы = ВыборкаСсылка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаСтрокаМатериалы.Следующий() Цикл
			
			СтрокаНоменклатура = Объект[ИмяТЧМатериалы][ВыборкаСтрокаМатериалы.НомерСтрокиМатериалы-1];
			СтрокаНоменклатура.КомплектСПрослеживаемымиТоварами = Истина;
			
			ВыборкаДанныеСведений = ВыборкаСтрокаМатериалы.Выбрать();
			Пока ВыборкаДанныеСведений.Следующий() Цикл
				СтрокаСведений = Объект.СведенияПрослеживаемости[ВыборкаДанныеСведений.НомерСтрокиСведедения-1];
				СтрокаСведений.СтранаПроисхождения = ВыборкаДанныеСведений.СтранаПроисхождения;
			КонецЦикла;
			
		КонецЦикла;
		
		Если Объект.Модифицированность() Тогда
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
		Иначе
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(ВыборкаСсылка.Ссылка);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
