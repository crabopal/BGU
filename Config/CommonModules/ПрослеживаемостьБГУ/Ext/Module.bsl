#Область ПрограммныйИнтерфейс

// Есть прослеживаемые товары.
// 
// Параметры:
//  ТабличнаяЧасть - ТабличнаяЧасть
//  			   - ДанныеФормыКоллекция
//  	* ПрослеживаемыйТовар - Булево
// 
// Возвращаемое значение:
//  Булево -  Есть прослеживаемые товары
Функция ЕстьПрослеживаемыеТовары(ТабличнаяЧасть) Экспорт

	Возврат ТабличнаяЧасть.НайтиСтроки(Новый Структура("ПрослеживаемыйТовар", Истина)).Количество() > 0;

КонецФункции

// Проверка, что в табличной части есть непрослеживаемые товары, в состав которых входят прослеживаемые.
// Проверяет, что выбранные в таблице СведенияПрослеживаемости идентификаторы строк есть в основной таблице
// 
// Параметры:
//  ТабличнаяЧасть - ТабличнаяЧасть:
//  	* ИдентификаторСтроки - Строка
//  СведенияПрослеживаемости - ТабличнаяЧасть:
//  	* ИдентификаторСтроки - Строка
// 
// Возвращаемое значение:
//  Булево -  Есть комплекты с прослеживаемыми товарами
Функция ЕстьКомплектыСПрослеживаемымиТоварами(ТабличнаяЧасть, СведенияПрослеживаемости) Экспорт
	ИспользуемыеИдентификаторы = Новый Соответствие;
	Для Каждого Строка Из ТабличнаяЧасть Цикл
		ИспользуемыеИдентификаторы.Вставить(Строка.ИдентификаторСтроки, Истина);
	КонецЦикла;
	
	Для Каждого СтрокаПрослеживаемости Из СведенияПрослеживаемости Цикл
		Если ИспользуемыеИдентификаторы.Получить(СтрокаПрослеживаемости.ИдентификаторСтроки) = Истина Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Проверяет остатки по объекту в регистре ПрослеживаемыеОС.
// 
// Параметры:
//  ОсновноеСредство - СправочникСсылка.ОсновныеСредства
//  Объект - ДокументОбъект
// 
// Возвращаемое значение:
//  Булево -  Прослеживаемое основное средство
Функция ПрослеживаемоеОсновноеСредство(ОсновноеСредство, Объект) Экспорт

	Если Не ЗначениеЗаполнено(ОсновноеСредство) Тогда
		Возврат Ложь;
	КонецЕсли;

	Возврат ПрослеживаемыеОсновныеСредства(Объект, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ОсновноеСредство))
		.Получить(ОсновноеСредство);

КонецФункции

// Прослеживаемые основные средства.
// 
// Параметры:
//  Объект - ДокументОбъект
//  ОсновныеСредства - Массив из СправочникСсылка.ОсновныеСредства -  Основные средства
// 
// Возвращаемое значение:
//  Соответствие из СправочникСсылка.ОсновныеСредства -  Прослеживаемые основные средства
Функция ПрослеживаемыеОсновныеСредства(Объект, ОсновныеСредства) Экспорт
	
	Если Не Объект.Ссылка.Пустая() Тогда
		ПериодЗапроса = Новый Граница(Объект.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	ИначеЕсли ЗначениеЗаполнено(Объект.Дата) Тогда
		ПериодЗапроса = Новый Граница(КонецДня(Объект.Дата), ВидГраницы.Включая);
	Иначе
		ПериодЗапроса = Новый Граница(КонецДня(ОбщегоНазначения.ТекущаяДатаПользователя()), ВидГраницы.Включая);
	КонецЕсли;
	
	БезОстатков = ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ПоступлениеОС");
	ДатаПроверки = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ОбщегоНазначения.ТекущаяДатаПользователя());
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОсновныеСредства", ОсновныеСредства);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Период", ПериодЗапроса);
	Запрос.УстановитьПараметр("ВедетсяУчетПрослеживаемыхТоваров", ВедетсяУчетПрослеживаемыхТоваров(ДатаПроверки));
	Запрос.УстановитьПараметр("ДатаПроверки", ДатаПроверки);

	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ПрослеживаемыеОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	ПрослеживаемыеОСОстатки.Комплектующее КАК Комплектующее,
	|	ПрослеживаемыеОСОстатки.Комплектующее ССЫЛКА Справочник.ОсновныеСредства
	|			И НЕ ПрослеживаемыеОСОстатки.Комплектующее = ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)
	|		ИЛИ ПрослеживаемыеОСОстатки.Комплектующее ССЫЛКА Справочник.Номенклатура
	|			И НЕ ПрослеживаемыеОСОстатки.Комплектующее = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка) КАК КомплектующееЗаполнено
	|ПОМЕСТИТЬ ОстаткиПрослеживаемыхОС
	|ИЗ
	|	РегистрНакопления.ПрослеживаемыеОС.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство В (&ОсновныеСредства)) КАК ПрослеживаемыеОСОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОсновныеСредства.Ссылка КАК ОсновноеСредство,
	|	&ВедетсяУчетПрослеживаемыхТоваров И ЕСТЬNULL(ДанныеИзИстории.ПрослеживаемыйТовар, ОсновныеСредства.ПрослеживаемыйТовар) КАК ПрослеживаемыйТовар
	|ПОМЕСТИТЬ ВТ_ПризнакиСправочник
	|ИЗ
	|	Справочник.ОсновныеСредства КАК ОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			Т2.Ссылка КАК Ссылка,
	|			Т2.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар
	|		ИЗ
	|			Справочник.ОсновныеСредства.ИсторияПрослеживаемости КАК Т2
	|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|					МИНИМУМ(Т1.ДатаИзменения) КАК ДатаИзменения,
	|					Т1.Ссылка КАК Ссылка
	|				ИЗ
	|					Справочник.ОсновныеСредства.ИсторияПрослеживаемости КАК Т1
	|				ГДЕ
	|					Т1.ДатаИзменения > &ДатаПроверки
	|				
	|				СГРУППИРОВАТЬ ПО
	|					Т1.Ссылка) КАК Т1
	|				ПО Т2.Ссылка = Т1.Ссылка
	|					И Т2.ДатаИзменения = Т1.ДатаИзменения) КАК ДанныеИзИстории
	|		ПО &ВедетсяУчетПрослеживаемыхТоваров И ОсновныеСредства.Ссылка = ДанныеИзИстории.Ссылка
	|ГДЕ
	|	ОсновныеСредства.Ссылка В(&ОсновныеСредства)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОстаткиПрослеживаемыхОС.ОсновноеСредство КАК ОсновноеСредство,
	|	ИСТИНА КАК ПрослеживаемыйТовар
	|ПОМЕСТИТЬ ВТ_ПризнакиКомплектов
	|ИЗ
	|	ОстаткиПрослеживаемыхОС КАК ОстаткиПрослеживаемыхОС
	|ГДЕ
	|	ОстаткиПрослеживаемыхОС.КомплектующееЗаполнено
	|	И ОстаткиПрослеживаемыхОС.Комплектующее.ПрослеживаемыйТовар
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.ОсновноеСредство КАК ОсновноеСредство,
	|	МАКСИМУМ(ВложенныйЗапрос.ПрослеживаемыйТовар) КАК ПрослеживаемыйТовар
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВТ_ПризнакиСправочник.ОсновноеСредство КАК ОсновноеСредство,
	|		ВТ_ПризнакиСправочник.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар
	|	ИЗ
	|		ВТ_ПризнакиСправочник КАК ВТ_ПризнакиСправочник
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ВТ_ПризнакиКомплектов.ОсновноеСредство,
	|		ВТ_ПризнакиКомплектов.ПрослеживаемыйТовар
	|	ИЗ
	|		ВТ_ПризнакиКомплектов КАК ВТ_ПризнакиКомплектов) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.ОсновноеСредство";
	
	
	Если БезОстатков Тогда
		СхемаЗапроса = Новый СхемаЗапроса;
		СхемаЗапроса.УстановитьТекстЗапроса(Запрос.Текст);

		МаксИндекс = СхемаЗапроса.ПакетЗапросов.Количество()-1;
		Для Индекс = -МаксИндекс По 0 Цикл
			ЗапросПакета = СхемаЗапроса.ПакетЗапросов[-Индекс];
			Если ЗапросПакета.ТаблицаДляПомещения = "ВТ_ПризнакиКомплектов" 
				ИЛИ ЗапросПакета.ТаблицаДляПомещения = "ОстаткиПрослеживаемыхОС" Тогда
				СхемаЗапроса.ПакетЗапросов.Удалить(-Индекс);
			ИначеЕсли ЗапросПакета.ТаблицаДляПомещения = "" Тогда
				ЗапросПакета.Операторы[0].Источники[0].Источник.Запрос.Операторы.Удалить(1);
			КонецЕсли;
		КонецЦикла;

		Запрос.Текст = СхемаЗапроса.ПолучитьТекстЗапроса();
	КонецЕсли;
	
	Результат = Новый Соответствие;
	Для каждого ОсновноеСредство Из ОсновныеСредства Цикл
		Результат.Вставить(ОсновноеСредство, Ложь);
	КонецЦикла;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.ОсновноеСредство, Выборка.ПрослеживаемыйТовар);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Удаляет строки с указанным идентификатором из таблицы Объект.СведенияПрослеживаемости
// 
// Параметры:
//  Объект - ДокументОбъект
//  ИдентификаторСтроки - Строка, Неопределено -  Идентификатор строки
Процедура УдалитьСтрокиРНПТ(Объект, ИдентификаторСтроки = Неопределено) Экспорт
	
	Если ИдентификаторСтроки = Неопределено Тогда
		Объект.СведенияПрослеживаемости.Очистить();
	Иначе
		СтрокиСРНПТ = Объект.СведенияПрослеживаемости.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
		
		Для Каждого СтрокаСРНПТ Из СтрокиСРНПТ Цикл
			Объект.СведенияПрослеживаемости.Удалить(СтрокаСРНПТ);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

// Обновить записи регистра РегистрацияПрослеживаемыхТоваров
// 
// Параметры:
//  Ссылка - ДокументСсылка
Процедура ЗарегистрироватьПрослеживаемыйТовар(Ссылка) Экспорт
	
	РегистрыСведений.РегистрацияПрослеживаемыхТоваров.ОбновитьСостояние(Ссылка, Ссылка);
	
КонецПроцедуры

// Возвращает дату до которой необходимо отправить уведомление о ввозе/вывозе в налоговую инспекцию
// Параметры:
// Дата - Дата - дата поступления прослеживаемых товаров
// Возвращаемое значение:
// 	Дата - тип дата, день до которого нужно отправить уведомление о ввозе
Функция СрокПодачиУведомления(Дата) Экспорт
	
	КоличествоРабочихДнейОтсрочки = 5;
	День = 24 * 60 * 60; // количество секунд в одном дне

	ПроизводственныйКалендарь = КалендарныеГрафики.ОсновнойПроизводственныйКалендарь();
	
	Если НЕ ЗначениеЗаполнено(ПроизводственныйКалендарь) Тогда
		Возврат Дата + КоличествоРабочихДнейОтсрочки * День;
	КонецЕсли;
	
	Отбор = Новый Структура;
	Отбор.Вставить("Год",                       Год(Дата));
	Отбор.Вставить("Дата",                      Дата);
	Отбор.Вставить("ПроизводственныйКалендарь", ПроизводственныйКалендарь);
	
	ДанныеДня = РегистрыСведений.ДанныеПроизводственногоКалендаря.Получить(Отбор);
	
	ДатаДокументаЭтоВыходной = (ДанныеДня.ВидДня <> Перечисления.ВидыДнейПроизводственногоКалендаря.Рабочий И 
								ДанныеДня.ВидДня <> Перечисления.ВидыДнейПроизводственногоКалендаря.Предпраздничный);
	
	Если ДатаДокументаЭтоВыходной Тогда
		// Отсрочка меньше на один день
		СрокУведомления = КалендарныеГрафики.ДатаПоКалендарю(
			ПроизводственныйКалендарь, Дата, КоличествоРабочихДнейОтсрочки - 1, Ложь);
	Иначе
		СрокУведомления = КалендарныеГрафики.ДатаПоКалендарю(
			ПроизводственныйКалендарь, Дата, КоличествоРабочихДнейОтсрочки, Ложь);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СрокУведомления) Тогда
		Возврат Дата + КоличествоРабочихДнейОтсрочки * День;
	Иначе
		Возврат СрокУведомления;
	КонецЕсли;
	
КонецФункции

// Добавляет запрос получения данных для обновления регистра СвойстваРНПТ
// 
// Параметры:
//  Ссылка - ДокументСсылка
//  Запрос - Запрос
//  НомераТаблиц  - Структура
Процедура ИнициализироватьЗапросыСвойстваРНПТ(Ссылка, Запрос, НомераТаблиц) Экспорт
	МетаданныеДокумента = Ссылка.Метаданные();
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СведенияПрослеживаемости.Ссылка.Организация КАК Организация,
	|	СведенияПрослеживаемости.РНПТ КАК РНПТ,
	|	СведенияПрослеживаемости.Ссылка.Дата КАК ДатаПоступления
	|ИЗ
	|	&СведенияПрослеживаемости КАК СведенияПрослеживаемости
	|ГДЕ
	|	СведенияПрослеживаемости.Ссылка = &Ссылка";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СведенияПрослеживаемости", "Документ." + МетаданныеДокумента.Имя + ".СведенияПрослеживаемости");
	НомераТаблиц.Вставить("ТаблицаРНПТ", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() + ТекстЗапроса;
КонецПроцедуры

// Обновляет записи регистра СвойстваРНПТ
// 
// Параметры:
//  Объект - ДокументОбъект
Процедура СформироватьДвижения(Объект) Экспорт
	
	Если Не ВедетсяУчетПрослеживаемыхТоваров(Объект.Дата) Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаРНПТ = Неопределено;
	Если Объект.ДополнительныеСвойства.ТаблицыДляДвижений.Свойство("ТаблицаРНПТ", ТаблицаРНПТ) Тогда
		УстановитьСвойстваРНПТ(ТаблицаРНПТ);
	КонецЕсли;
	
КонецПроцедуры

// Возвращает признак применения Федерального Закона от 09.11.2020 № 371-ФЗ
// который вводит понятие прослеживаемости для определенных групп товаров
// Параметры:
//   Дата - Дата - дата на которую необходимо определить признак применения ФЗ
// Возвращаемое значение:
//  Булево - признак применения
//           Истина - ФЗ применяется
//           Ложь   - ФЗ не применяется
Функция ВедетсяУчетПрослеживаемыхТоваров(Знач Дата) Экспорт
	
	Если Не ПолучитьФункциональнуюОпцию("ВестиУчетПрослеживаемыхТоваров") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Дата) Тогда
		Дата = ОбщегоНазначения.ТекущаяДатаПользователя();
	КонецЕсли;
	
	Возврат ПрослеживаемостьБГУКлиентСервер.ВедетсяУчетПрослеживаемыхТоваров(Дата);
	
КонецФункции

// Обработчик ПередЗаписью документа со списанием МЗ.
// 
// Параметры:
//  Объект - ДокументОбъект
//  Отказ - Булево
//  РежимЗаписи - РежимЗаписиДокумента
Процедура СписаниеМЗПриЗаписи(Объект, Отказ, РежимЗаписи, ИмяТч = "Материалы") Экспорт
	
	Если ОтражатьВПрослеживаемости(Объект) И ЕстьПрослеживаемыеТовары(Объект[ИмяТч]) Тогда
		ПроверитьРНПТВТаблицеМЗПриПроведении(Объект, Отказ, РежимЗаписи, ИмяТч);
	Иначе
		Объект.СведенияПрослеживаемости.Очистить();
	КонецЕсли;

КонецПроцедуры

// Обработчик ПередЗаписью документа с поступлением или выпуском комплекта(МЗ) с ПТ.
// 
// Параметры:
//  Объект - ДокументОбъект
//  Отказ - Булево
//  РежимЗаписи - РежимЗаписиДокумента
Процедура УстановкаВариантаКомплектаВТЧДокументов(Объект, ИмяТч = "Материалы", ВидОперации, Отказ) Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|	ТаблицаТоваров.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ ВТ_Товары
	|ИЗ
	|	&ТаблицаТоваров КАК ТаблицаТоваров
	|ГДЕ
	|	ТаблицаТоваров.ВариантКомплектаПТ = ЗНАЧЕНИЕ(Справочник.ВариантыКомплектовМЗПТ.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СпрНоменклатура.Ссылка КАК Номенклатура,
	|	ВТ_Товары.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ ВТ_Комплекты
	|ИЗ
	|	Справочник.Номенклатура КАК СпрНоменклатура
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Товары КАК ВТ_Товары
	|		ПО СпрНоменклатура.Ссылка = ВТ_Товары.Номенклатура
	|ГДЕ
	|	СпрНоменклатура.КомплектСПрослеживаемымиТоварами
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВариантыКомплектовМЗПТ.Ссылка КАК Ссылка,
	|	ВариантыКомплектовМЗПТ.Владелец КАК Владелец
	|ПОМЕСТИТЬ ВТ_ОсновныеВарианты
	|ИЗ
	|	Справочник.ВариантыКомплектовМЗПТ КАК ВариантыКомплектовМЗПТ
	|ГДЕ
	|	ВариантыКомплектовМЗПТ.Владелец В
	|			(ВЫБРАТЬ
	|				Вт_Комплекты.Номенклатура
	|			ИЗ
	|				Вт_Комплекты)
	|	И ВариантыКомплектовМЗПТ.ОсновнойВариант
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВариантыКомплектовМЗПТ.Ссылка КАК Ссылка,
	|	ВариантыКомплектовМЗПТ.Владелец КАК Владелец
	|ПОМЕСТИТЬ ВТ_Варианты
	|ИЗ
	|	Справочник.ВариантыКомплектовМЗПТ КАК ВариантыКомплектовМЗПТ
	|ГДЕ
	|	ВариантыКомплектовМЗПТ.Владелец В
	|			(ВЫБРАТЬ
	|				Вт_Комплекты.Номенклатура
	|			ИЗ
	|				Вт_Комплекты)
	|	И НЕ ВариантыКомплектовМЗПТ.ОсновнойВариант 
	|	И &ОперацияОприходования
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Комплекты.Номенклатура КАК Номенклатура,
	|	ВТ_Комплекты.НомерСтроки КАК НомерСтроки,
	|	ЕСТЬNULL(ВТ_ОсновнойВариант.Ссылка, ЗНАЧЕНИЕ(Справочник.ВариантыКомплектовМЗПТ.ПустаяСсылка)) КАК ОсновнойВариант,
	|	ЕСТЬNULL(ВТ_Варианты.Ссылка, ЗНАЧЕНИЕ(Справочник.ВариантыКомплектовМЗПТ.ПустаяСсылка)) КАК ПервыйВариант
	|ИЗ
	|	ВТ_Комплекты КАК ВТ_Комплекты
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОсновныеВарианты КАК ВТ_ОсновнойВариант
	|		ПО ВТ_Комплекты.Номенклатура = ВТ_ОсновнойВариант.Владелец
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Варианты КАК ВТ_Варианты
	|		ПО ВТ_Комплекты.Номенклатура = ВТ_Варианты.Владелец
	|ГДЕ
	|	(ВТ_Варианты.Ссылка ЕСТЬ NULL
	|			ИЛИ ВТ_Варианты.Ссылка В
	|				(ВЫБРАТЬ ПЕРВЫЕ 1
	|					Т.Ссылка
	|				ИЗ
	|					ВТ_Варианты КАК Т
	|				ГДЕ
	|					Т.Владелец = ВТ_Комплекты.Номенклатура))");
	
	Запрос.УстановитьПараметр("ТаблицаТоваров", Объект[ИмяТч].Выгрузить(,"Номенклатура, ВариантКомплектаПТ, НомерСтроки"));
	Запрос.УстановитьПараметр("ОперацияОприходования", ВидОперации = "Оприходование комплекта");
	
	Результат = Запрос.Выполнить();
	
	Если Не Результат.Пустой() Тогда
		ВыборкаНоменклатураКомплекты = Результат.Выбрать();
		Ошибки = Неопределено;
		Пока ВыборкаНоменклатураКомплекты.Следующий() Цикл
			
			Если ЗначениеЗаполнено(ВыборкаНоменклатураКомплекты.ОсновнойВариант) Тогда
				ТекущийВариант = ВыборкаНоменклатураКомплекты.ОсновнойВариант;
			Иначе
				Если ВидОперации = "Оприходование комплекта" Тогда
					Если ЗначениеЗаполнено(ВыборкаНоменклатураКомплекты.ПервыйВариант) Тогда
						Блокировка = Новый БлокировкаДанных;
						ЭлементБлокировки = Блокировка.Добавить("Справочник.ВариантыКомплектовМЗПТ");
						ЭлементБлокировки.УстановитьЗначение("Ссылка", ВыборкаНоменклатураКомплекты.ПервыйВариант);
						ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
						Блокировка.Заблокировать();
						ТекущийВариант = ВыборкаНоменклатураКомплекты.ПервыйВариант.ПолучитьОбъект();
						ТекущийВариант.Заблокировать();
						ТекущийВариант.ОсновнойВариант = Истина;
						ТекущийВариант.Записать();
					Иначе
						ТекущийВариантНовый = Справочники.ВариантыКомплектовМЗПТ.СоздатьЭлемент();
						ТекущийВариантНовый.Владелец = ВыборкаНоменклатураКомплекты.Номенклатура;
						ТекущийВариантНовый.Наименование = "Основной";
						ТекущийВариантНовый.ОсновнойВариант = Истина;
						ТекущийВариантНовый.Записать();
						ТекущийВариант = ТекущийВариантНовый.Ссылка;
					КонецЕсли;
				Иначе
					ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru='Не указан вариант комплекта в строке %1 !'"),
					ВыборкаНоменклатураКомплекты.НомерСтроки);
					Поле = "" +ИмяТч + "["+ Формат(ВыборкаНоменклатураКомплекты.НомерСтроки-1,"ЧГ=") + "].Номенклатура";
					
					ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки,
						Поле, ТекстОшибки,,ВыборкаНоменклатураКомплекты.НомерСтроки,,ВыборкаНоменклатураКомплекты.НомерСтроки-1);
				КонецЕсли;
			КонецЕсли;
			
			Если Ошибки = Неопределено Тогда
				Объект[ИмяТч][ВыборкаНоменклатураКомплекты.НомерСтроки-1].ВариантКомплектаПТ = ТекущийВариант;
			КонецЕсли;
		КонецЦикла;
		ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки, Отказ);
	КонецЕсли;
	
КонецПроцедуры

// Обработчик ПередЗаписью документа списания ОС.
// 
// Параметры:
//  Объект - ДокументОбъект
//  Отказ - Булево
//  РежимЗаписи - РежимЗаписиДокумента
Процедура СписаниеОСПриЗаписи(Объект, Отказ, РежимЗаписи) Экспорт
	ТипОбъекта = ТипЗнч(Объект);
	Если ТипОбъекта = Тип("ДокументОбъект.СписаниеТранспорта")
		И Объект.ВидОперации <> Перечисления.ВидыОперацийСписанияОС.СписаниеКапвложений
		И Объект.ВидОперации <> Перечисления.ВидыОперацийСписанияОС.СписаниеСобственныхОС
		И Объект.ВидОперации <> Перечисления.ВидыОперацийСписанияОС.СписаниеСобственныхОСОперУчет
		И Объект.ВидОперации <> Перечисления.ВидыОперацийСписанияОС.СписаниеОСнаХранении Тогда
		Возврат;
	КонецЕсли;
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение Тогда
		ПодобратьРНПТОС(Объект, Отказ);
	КонецЕсли;
КонецПроцедуры

// Очищает таблицу сведений о прослеживаемых товарах в документе 
// и сбрасывает значение реквизита ОтражатьВПрослеживаемости (если он есть)
// 
// Параметры:
//  Объект - ДокументОбъект
Процедура ПриЗаписиОбъекта(Объект) Экспорт
	Если НЕ ВедетсяУчетПрослеживаемыхТоваров(Объект.Дата)
		ИЛИ НЕ ОтражатьВПрослеживаемости(Объект) Тогда
		Объект.СведенияПрослеживаемости.Очистить();
		УстановитьОтражатьВПрослеживаемости(Объект, Ложь);
	КонецЕсли;
КонецПроцедуры

// Заполняет списываемые РНПТ в документе.
// 
// Параметры:
//  ДокументОбъект - ДокументОбъект -  Документ объект
//  Отказ - Булево -  Отказ
//  ИмяТабличнойЧасти - Строка -  Имя табличной части
Процедура ПодобратьРНПТ(ДокументОбъект, Отказ, ИмяТабличнойЧасти = "Материалы") Экспорт
	
	ТаблицаТоваров = ДокументОбъект[ИмяТабличнойЧасти].Выгрузить();
	
	Если ТаблицаТоваров.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ТаблицаРНПТИсходныйДокумент = ТаблицаРНПТИсходныйДокумент(ДокументОбъект, ТаблицаТоваров);
	ТаблицаРНПТОстатки = ТаблицаРНПТОстатки(ДокументОбъект, ТаблицаТоваров, Ложь);
	ТаблицаРНПТОстаткиКомплекты = ТаблицаРНПТОстатки.Скопировать(Новый Структура("Комплект",Истина));
	ТаблицаРНПТОстаткиТовары = ТаблицаРНПТОстатки.Скопировать(Новый Структура("Комплект",Ложь));
	
	Для Каждого СтрокаТабличнойЧасти ИЗ ДокументОбъект[ИмяТабличнойЧасти] Цикл

		Если НЕ СтрокаТабличнойЧасти.ПрослеживаемыйТовар Тогда
			Продолжить;
		КонецЕсли;
		
		Комплект = СтрокаТабличнойЧасти.КомплектСПрослеживаемымиТоварами;

		Если Не ЗначениеЗаполнено(СтрокаТабличнойЧасти.ИдентификаторСтроки) Тогда
			СтрокаТабличнойЧасти.ИдентификаторСтроки = Новый УникальныйИдентификатор;
		КонецЕсли;
		
		СтрокиСРНПТ = ДокументОбъект.СведенияПрослеживаемости.НайтиСтроки(Новый Структура("ИдентификаторСтроки", СтрокаТабличнойЧасти.ИдентификаторСтроки));
		КоличествоРНПТ = СтрокиСРНПТ.Количество();
		
		Если КоличествоРНПТ = 0 Тогда
			// Подобрать РНПТ
		
			ОсталосьПодобрать = СтрокаТабличнойЧасти.Количество;
			Если ТаблицаРНПТИсходныйДокумент <> Неопределено Тогда
				// Если корректировка, то добавляем РНПТ из исходного документа
				ПодобратьРНПТИзИсходногоДокумента(ДокументОбъект, ОсталосьПодобрать, СтрокаТабличнойЧасти, ТаблицаРНПТИсходныйДокумент);
			КонецЕсли;
			
			Если ОсталосьПодобрать <> 0 Тогда
				// Добавляем РНПТ из остатков.
				Если Комплект Тогда
					ОсталосьПодобрать = 0;
					ПодобратьРНПТИзОстатков(ДокументОбъект, ОсталосьПодобрать, СтрокаТабличнойЧасти, ТаблицаРНПТОстаткиКомплекты, Комплект);
				Иначе
					ПодобратьРНПТИзОстатков(ДокументОбъект, ОсталосьПодобрать, СтрокаТабличнойЧасти, ТаблицаРНПТОстаткиТовары, Комплект);
				КонецЕсли;
			КонецЕсли;
			
			Если ОсталосьПодобрать <> 0 Тогда
				ТекстОшибки = СтрШаблон(НСтр("ru='Для целей учета прослеживаемости не списано %1 товара %2 (%3)'"),
					Формат(ОсталосьПодобрать, "ЧЦ=15; ЧДЦ=3"),
					СтрокаТабличнойЧасти.Номенклатура,
					СтрокаТабличнойЧасти.СтранаПроисхождения);
				Поле = "" + ИмяТабличнойЧасти + "["+ Формат(СтрокаТабличнойЧасти.НомерСтроки-1,"ЧГ=") + "].Количество";
				
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ДокументОбъект.Ссылка, Поле, "Объект", Отказ);
			КонецЕсли;
			
		Иначе
			// Проверить остатки РНПТ
			
			// Проверяем наличие указанных РНПТ на остатках
			Для Каждого СтрокаСРНПТ ИЗ СтрокиСРНПТ Цикл
				ТребуемоеКоличество = СтрокаСРНПТ.Количество;
				ТребуемоеКоличествоПрослеживаемости = СтрокаСРНПТ.КоличествоПрослеживаемости;
				
				СверитьОстаткиСИсходнымДокументомРеализации(СтрокаТабличнойЧасти, ТаблицаРНПТИсходныйДокумент, ТребуемоеКоличество, ТребуемоеКоличествоПрослеживаемости);
				
				Если ТребуемоеКоличество = 0
					И ТребуемоеКоличествоПрослеживаемости = 0 Тогда
					// Значит в строке корректировочного документа только РНПТ из исходного документа реализации.
					Продолжить;
				КонецЕсли;
				
				// По новым РНПТ контролируем остатки в регистре.
				
				Если Комплект Тогда
					СверитьСОстаткамиВПрослеживаемости(ДокументОбъект, Отказ, СтрокаСРНПТ, СтрокаТабличнойЧасти, ТаблицаРНПТОстаткиКомплекты, ИмяТабличнойЧасти, Ложь,,Комплект);
				Иначе
					СверитьСОстаткамиВПрослеживаемости(ДокументОбъект, Отказ, СтрокаСРНПТ, СтрокаТабличнойЧасти, ТаблицаРНПТОстаткиТовары, ИмяТабличнойЧасти, Ложь,,Комплект);
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	СуммируемыеКолонки = "Количество, КоличествоПрослеживаемости";
	Если ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("СуммаБезНДС", ДокументОбъект.Метаданные(), "СведенияПрослеживаемости") Тогда
		СуммируемыеКолонки = СуммируемыеКолонки + ", СуммаБезНДС";
	КонецЕсли;
	ДокументОбъект.СведенияПрослеживаемости.Свернуть("РНПТ, ИдентификаторСтроки, Комплектующее, СтранаПроисхождения", СуммируемыеКолонки);
	
КонецПроцедуры

// Заполняет списываемые РНПТ в табличную часть документа по методу FIFO. 
// Если РНПТ уже выбраны, то проверяет возможность их списания.
// 
// Параметры:
//  Объект - ДокументОбъект
//  Отказ - Булево
Процедура ПодобратьРНПТОС(Объект, Отказ) Экспорт
	
	ТаблицаОС = ПустаяТаблицаОС();
	ДобавитьВТаблицуОССоставДокумента(Объект, ТаблицаОС);
	
	Если ТаблицаОС.Количество() = 0 Тогда
		Если Объект.СведенияПрослеживаемости.Количество() > 0 Тогда
			Объект.СведенияПрослеживаемости.Очистить();
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	ОстаткиРНПТ = ОстаткиРНПТОС(Объект);
	ЗаполнитьОбщееКоличествоВТаблицеОС(Объект, ТаблицаОС, ОстаткиРНПТ);
	ЗаполнитьОстатокБУСоставныеОС(Объект, ТаблицаОС);
	
	ИдентификаторыСтрокСРНПТ = ИдентификаторыСтрокСРНПТ(Объект.СведенияПрослеживаемости);
	РанееСписанныеСтроки = Новый Соответствие;
	
	// Отметить списание выбранных РНПТ
	ОтметитьСписаниеВыбранныхРНПТОС(ИдентификаторыСтрокСРНПТ, Объект, ОстаткиРНПТ, Отказ, РанееСписанныеСтроки, ТаблицаОС);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ПодобратьРНПТКСписаниюОС(ИдентификаторыСтрокСРНПТ, Объект, ОстаткиРНПТ, РанееСписанныеСтроки, ТаблицаОС);

КонецПроцедуры

// Проверяет заполнение РНПТ в строках документа
// 
// Параметры:
//  Объект - ДокументОбъект
//  Отказ - Булево
//  ИмяТаблицы - Строка -  Имя таблицы
Процедура ОбработкаПроверкиЗаполнения(Объект, Отказ, ИмяТаблицы = "Материалы") Экспорт
	
	Если НЕ ПрослеживаемостьБГУКлиентСервер.ВедетсяУчетПрослеживаемыхТоваров(Объект.Дата) Тогда
		Возврат;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "ОтражатьВПрослеживаемости")
		И НЕ Объект.ОтражатьВПрослеживаемости Тогда
		Возврат;
	КонецЕсли;
	
	ПрослеживаемыеТовары = Объект[ИмяТаблицы].НайтиСтроки(Новый Структура("ПрослеживаемыйТовар", Истина));
	Если ПрослеживаемыеТовары.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПроверитьЗаполнениеСтраныПроисхождения(Объект, ПрослеживаемыеТовары, ИмяТаблицы, Отказ);
	
	ОтражатьВПрослеживаемости = ОтражатьВПрослеживаемости(Объект);
	Если Не ОтражатьВПрослеживаемости Тогда
		Возврат;
	КонецЕсли;
	
	ТипОбъекта = ТипЗнч(Объект);
	Если ((ТипОбъекта = Тип("ДокументОбъект.ПоступлениеМЗ")
		ИЛИ ТипОбъекта = Тип("ДокументОбъект.ПоступлениеМЗВПути"))
		И НЕ Справочники.Контрагенты.КонтрагентРезидентТаможенногоСоюза(Объект.Контрагент))
		ИЛИ (ТипОбъекта = Тип("ДокументОбъект.ТребованиеНакладная0315006")
			И Объект.ВидПеремещения = Перечисления.ВидыПеремещенияМЗ.ВозвратИзНТТ) Тогда
		
		ОбработкаПроверкиЗаполненияПоступление(Объект, ПрослеживаемыеТовары, Отказ);
		
	КонецЕсли;
	
КонецПроцедуры

// Устанавливает значение колонки ПрослеживаемыйТовар
// 
// Параметры:
//  ДокументОбъект - ДокументОбъект, ДанныеФормыСтруктура
//  ТабличнаяЧасть - ТабличнаяЧасть
//  ВестиУчетПрослеживаемыхТоваров - Булево
//  ИмяКолонкиНоменклатура - Строка -  Имя колонки номенклатура
//  ЕстьПрослеживаемыйТовар - Неопределено -  Есть прослеживаемый товар
Процедура ОбновитьПризнакПрослеживаемости(ДокументОбъект, ТабличнаяЧасть, Знач ВестиУчетПрослеживаемыхТоваров, Знач ИмяКолонкиНоменклатура = "Номенклатура", ЕстьПрослеживаемыйТовар = Неопределено) Экспорт
	
	ЕстьПрослеживаемыйТовар = Ложь;
	
	Если НЕ ВестиУчетПрослеживаемыхТоваров Тогда
		Для Каждого СтрокаТаблицы Из ТабличнаяЧасть Цикл
			СтрокаТаблицы.ПрослеживаемыйТовар = Ложь;
		КонецЦикла;
	Иначе
		
		// Получим реквизиты используемой номенклатуры в таблице.
		МассивНоменклатуры = ОбщегоНазначения.ВыгрузитьКолонку(ТабличнаяЧасть.Выгрузить(), ИмяКолонкиНоменклатура, Истина); // Массив из СправочникСсылка.Номенклатура
		
		МассивыПоТипам = МассивыНоменклатурыИОС(МассивНоменклатуры);
		
		РеквизитыНоменклатуры = УправлениеМатериальнымиЗапасами.ПризнакиПрослеживаемостиНоменклатуры(МассивыПоТипам.Номенклатура, ДокументОбъект.Дата);
		ПрослеживаемыеОС = ПрослеживаемыеОсновныеСредства(ДокументОбъект, МассивыПоТипам.ОС);
		
		Для Каждого СтрокаТаблицы Из ТабличнаяЧасть Цикл
			СтрокаТаблицы.ПрослеживаемыйТовар = Ложь;
			
			НФА = СтрокаТаблицы[ИмяКолонкиНоменклатура];
			
			ЭтоПрослеживаемыйТовар = (ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РеквизитыНоменклатуры.Получить(НФА), "КомплектСПрослеживаемымиТоварами", Ложь) = Истина
				ИЛИ ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РеквизитыНоменклатуры.Получить(НФА), "ПрослеживаемыйТовар", Ложь) = Истина);
				
			ЭтоПрослеживаемоеОС = ПрослеживаемыеОС.Получить(НФА) = Истина;
			
			Если Не ЭтоПрослеживаемыйТовар И Не ЭтоПрослеживаемоеОС Тогда
				Продолжить;
			КонецЕсли;
			
			ЕстьПрослеживаемыйТовар = Истина;
			
			СтрокаТаблицы.ПрослеживаемыйТовар = Истина;
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры

// Процедура удаления проведения первичных документов
// 
// Параметры:
// Регистратор - ДокументСсылка - Документ регистратор
// 
Процедура УдалениеПроведенияПервичногоДокумента(Регистратор) Экспорт
	
	Если НЕ ПолучитьФункциональнуюОпцию("ВестиУчетПрослеживаемыхТоваров") Тогда
		Возврат;
	КонецЕсли;
	
	РегистрыСведений.РегистрацияПрослеживаемыхТоваров.ОбновитьСостояниеУдалениеПроведенияПервичногоДокумента(Регистратор);
	
КонецПроцедуры

// Обработка проведения уведомления об остатках и уведомления о ввозе прослеживаемых товаров.
// 
// Параметры:
//  Параметры - Структура
//  Движения - КоллекцияДвижений
//  Отказ - Булево
Процедура ОбработкаПроведенияУведомления(Параметры, Движения, Отказ) Экспорт
	
	ДвиженияМЗ = Движения.ПрослеживаемыеТовары;
	ДвиженияМЗ.Записывать = Истина;
	ДвиженияОС = Движения.ПрослеживаемыеОС;
	ДвиженияОС.Записывать = Истина;

	Если Не ЗначениеЗаполнено(Параметры.Реквизиты[0].РНПТ) Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого Строка Из Параметры.ТаблицаТоваров Цикл
		
		Если ЗначениеЗаполнено(Строка.ОсновноеСредство) Тогда
			// Это остатки комплектующих
			СтрокаДвиженияОС = ДвиженияОС.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаДвиженияОС, Строка);
			ЗаполнитьЗначенияСвойств(СтрокаДвиженияОС, Параметры.Реквизиты[0]);
			СтрокаДвиженияОС.Комплектующее = Строка.Номенклатура;
			СтрокаДвиженияОС.СуммаБезНДС = Строка.Сумма;
		ИначеЕсли ТипЗнч(Строка.Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
			СтрокаДвижения = ДвиженияМЗ.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаДвижения, Строка);
			ЗаполнитьЗначенияСвойств(СтрокаДвижения, Параметры.Реквизиты[0]);
		ИначеЕсли ТипЗнч(Строка.Номенклатура) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
			СтрокаДвиженияОС = ДвиженияОС.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаДвиженияОС, Строка);
			ЗаполнитьЗначенияСвойств(СтрокаДвиженияОС, Параметры.Реквизиты[0]);
			СтрокаДвиженияОС.ОсновноеСредство = Строка.Номенклатура;
			СтрокаДвиженияОС.СуммаБезНДС = Строка.Сумма;
		КонецЕсли;
	
	КонецЦикла;

	ТаблицаРНПТ = РегистрыСведений.СвойстваРНПТ.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	Для каждого Строка Из Параметры.ТаблицаТоваров Цикл
		НоваяСтрока = ТаблицаРНПТ.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Параметры.Реквизиты[0]);
		НоваяСтрока.ДатаПоступления = Параметры.Реквизиты[0].Период;
	КонецЦикла;
	
	УстановитьСвойстваРНПТ(ТаблицаРНПТ);
	
КонецПроцедуры

// После подбора ОС.
// 
// Параметры:
//  Объект - ДанныеФормыСтруктура
//  ДобавленныеСтроки - Массив из СтрокаТабличнойЧасти
//  ИмяКолонкиОС - Строка -  Имя колонки ОС
Процедура ПослеПодбораОС(Объект, ДобавленныеСтроки, ИмяКолонкиОС = "ОсновноеСредство") Экспорт

	ОсновныеСредства = Новый Массив;
	Для каждого Строка Из ДобавленныеСтроки Цикл
		ОсновныеСредства.Добавить(Строка[ИмяКолонкиОС]);
	КонецЦикла;
	ДанныеОС = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(ОсновныеСредства, "СтранаПроисхождения");
	
	ПрослеживаемыеОС = ПрослеживаемыеОсновныеСредства(Объект, ОсновныеСредства);
	
	Для каждого Строка Из ДобавленныеСтроки Цикл
		ДанныеОбъекта = ДанныеОС.Получить(Строка[ИмяКолонкиОС]);
		Строка.ПрослеживаемыйТовар = ПрослеживаемыеОС.Получить(Строка[ИмяКолонкиОС]);
		Строка.СтранаПроисхождения = ДанныеОбъекта.СтранаПроисхождения;
	КонецЦикла;

КонецПроцедуры

// Счета учета МЗ по которым возможны остатки МЗ с учетом прослеживаемости.
// 
// Параметры:
//  Дата - Дата
//  Организация - СправочникСсылка.Организации
// 
// Возвращаемое значение:
//  Массив из ПланСчетовСсылка.ЕПСБУ -  Счета учета НФАСПрослеживаемостью
Функция СчетаУчетаНФАСПрослеживаемостью(Дата, Организация) Экспорт

	Результат = Новый Массив;
	Результат.Добавить(БухгалтерскийУчет.СчетПоКоду("105.00", Дата, Организация));
	Результат.Добавить(БухгалтерскийУчет.СчетПоКоду("12", Дата, Организация));
	Результат.Добавить(БухгалтерскийУчет.СчетПоКоду("02.4", Дата, Организация));
	Результат.Добавить(БухгалтерскийУчет.СчетПоКоду("09", Дата, Организация));
	Результат.Добавить(БухгалтерскийУчет.СчетПоКоду("13.2", Дата, Организация));
	
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Результат, БухгалтерскийУчет.СписокСчетов("07", Дата, , Организация));
	
	Возврат Результат;

КонецФункции

// Обработка проведения.
// 
// Параметры:
//  ДокументОбъект - ДокументОбъект
Процедура ОбработкаПроведения(ДокументОбъект) Экспорт
	Перем ДанныеАвтоПроведения; // Структура
	Перем ТаблицаПроводок; // ТаблицаЗначений
	Если ДокументОбъект.ДополнительныеСвойства.Свойство("ДанныеАвтоПроведения", ДанныеАвтоПроведения)
			И ДанныеАвтоПроведения.Свойство("ТаблицаПроводок", ТаблицаПроводок)
			И ТипЗнч(ТаблицаПроводок) = Тип("ТаблицаЗначений")
			И ТаблицаПроводок.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;

	СформироватьДвиженияПрослеживаемостиПоДокументу(Неопределено, ДокументОбъект, Новый Структура);
КонецПроцедуры

// Параметры отражения в прослеживаемости.
// 
// Возвращаемое значение:
//  Структура -  Параметры отражения в прослеживаемости:
// * ДатаПроведения - Дата
// * ЭтоСписание - Булево - 
// * ЭтоПеремещение - Булево - 
// * КонтрагентЧленЕАЭС - Булево - 
// * РНПТ_ОС - см. ПустаяТаблицаОперацииСПрослеживаемымиТоварами 
// * РНПТ_МЗ - см. ПустаяТаблицаОперацииСПрослеживаемымиТоварами 
Функция ПараметрыОтраженияВПрослеживаемости() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("ДатаПроведения", '00010101');
	Результат.Вставить("ЭтоСписание", Ложь);
	Результат.Вставить("ЭтоПеремещение", Ложь);
	Результат.Вставить("ЭтоВыпуск", Ложь);
	Результат.Вставить("КонтрагентЧленЕАЭС", Ложь);
	Результат.Вставить("РНПТ_ОС", ПустаяТаблицаОперацииСПрослеживаемымиТоварами());
	Результат.Вставить("РНПТ_МЗ", ПустаяТаблицаОперацииСПрослеживаемымиТоварами());
	Возврат Результат;
КонецФункции

// Контроль заполнения реквизитов прослеживаемости в табличной части "Сведения прослеживаемости"
// 
// Параметры:
//  Форма - УправляемаяФорма
//  ИмяОсновнойТаблицы - Строка
//  Отказ - Булево
Процедура КонтрольЗаполненияСведенийПрослеживаемости(Форма, ИмяОсновнойТаблицы, Отказ) Экспорт

	Если Не Форма.ВедетсяУчетПрослеживаемыхТоваров И Не Форма.ЕстьПрослеживаемыеТовары Тогда
		Возврат;
	КонецЕсли;
	
	ДокументОбъект = Форма.Объект;
	
	Если Не ДокументОбъект.СведенияПрослеживаемости.Количество() ИЛИ Не ДокументОбъект[ИмяОсновнойТаблицы].Количество() Тогда
		Возврат;
	КонецЕсли;
	
	ВТ_СведенияПрослеживаемости = ДокументОбъект.СведенияПрослеживаемости.Выгрузить();
	ВТ_СведенияПрослеживаемости.Индексы.Добавить("ИдентификаторСтроки");
		
	ОшибкиВводаРНПТ = Неопределено;
	
	Для Каждого СтрокаТаблицы Из ДокументОбъект[ИмяОсновнойТаблицы] Цикл
		
		СтрокиРНПТ = ВТ_СведенияПрослеживаемости.НайтиСтроки(Новый Структура("ИдентификаторСтроки", СтрокаТаблицы.ИдентификаторСтроки));
		
		ПолеОшибки = "Объект." + ИмяОсновнойТаблицы + "[%1].РНПТ";
		Если Не СтрокиРНПТ.Количество() Тогда
			Если СтрокаТаблицы.ПрослеживаемыйТовар Тогда
				ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(ОшибкиВводаРНПТ, ПолеОшибки, "Не указаны РНПТ", ,СтрокаТаблицы.НомерСтроки, ,СтрокаТаблицы.НомерСтроки-1);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		Для Каждого СтрокаРНПТ Из СтрокиРНПТ Цикл
			
			Если Не СтрокаТаблицы.ПрослеживаемыйТовар Тогда
				Если Не ЗначениеЗаполнено(СтрокаРНПТ.Комплектующее) Тогда
					ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(ОшибкиВводаРНПТ, ПолеОшибки,
						"Не заполнено комплектующее в поле ""РНПТ""", ,СтрокаТаблицы.НомерСтроки, ,СтрокаТаблицы.НомерСтроки-1);
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(ОшибкиВводаРНПТ, Отказ);

КонецПроцедуры

// Удаляет строки в табличной части "Сведения прослеживаемости", несвязанные по идентификатору со строками основной табличной части
// 
// Параметры:
//  ДокументОбъект - ДокументОбъект
//  ИмяОсновнойТаблицы - Строка
//
Процедура УдалитьНеиспользуемыеСтрокиСведенийПрослеживаемости(ДокументОбъект, ИмяОсновнойТаблицы, МЗ = Ложь) Экспорт

	Если Не ВедетсяУчетПрослеживаемыхТоваров(ДокументОбъект.Дата) ИЛИ Не ДокументОбъект.СведенияПрослеживаемости.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ВТ_СведенияПрослеживаемости.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ВТ_СведенияПрослеживаемости.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ ВТ_СведенияПрослеживаемости
	|ИЗ
	|	&СведенияПрослеживаемости КАК ВТ_СведенияПрослеживаемости
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	&ПолеПрослеживаемыйТовар
	|	ВТ_ОсновнаяТаблица.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ВТ_ОсновнаяТаблица.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ ВТ_ОсновнаяТаблица
	|ИЗ
	|	&ОсновнаяТаблица КАК ВТ_ОсновнаяТаблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_СведенияПрослеживаемости.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	ВТ_СведенияПрослеживаемости КАК ВТ_СведенияПрослеживаемости
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОсновнаяТаблица КАК ВТ_ОсновнаяТаблица
	|		ПО ВТ_СведенияПрослеживаемости.ИдентификаторСтроки = ВТ_ОсновнаяТаблица.ИдентификаторСтроки
	|ГДЕ
	|	(ВТ_ОсновнаяТаблица.НомерСтроки ЕСТЬ NULL
	|			ИЛИ &УсловиеПрослеживаемыйТовар)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки УБЫВ");
	
	Запрос.УстановитьПараметр("СведенияПрослеживаемости", ДокументОбъект.СведенияПрослеживаемости);
	Запрос.УстановитьПараметр("ОсновнаяТаблица", ДокументОбъект[ИмяОсновнойТаблицы]);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПолеПрослеживаемыйТовар", ?(МЗ, "ВТ_ОсновнаяТаблица.ПрослеживаемыйТовар,", ""));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПрослеживаемыйТовар", ?(МЗ, "НЕ ВТ_ОсновнаяТаблица.ПрослеживаемыйТовар", "ЛОЖЬ"));
	
	ВыборкаНомеровСтрок = Запрос.Выполнить().Выбрать();
	Пока ВыборкаНомеровСтрок.Следующий() Цикл
		ДокументОбъект.СведенияПрослеживаемости.Удалить(ДокументОбъект.СведенияПрослеживаемости[ВыборкаНомеровСтрок.НомерСтроки - 1]);
	КонецЦикла;
	
КонецПроцедуры
 

#Область ПомощникПолученияРНПТ

// Получить начальные данные для заполнения помощника получения РНПТ.
// 
// Параметры:
//  Период - Дата
//  Организация - СправочникСсылка.Организации
// 
// Возвращаемое значение:
//  ТаблицаЗначений -  Получить начальные данные
Функция ПолучитьНачальныеДанные(Период, Организация) Экспорт

	СубконтоМЗ = Новый Массив;
	СубконтоМЗ.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	СубконтоМЗ.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
	
	СубконтоОС = Новый Массив;
	СубконтоОС.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	СубконтоОС.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ПериодОстатков", Новый Граница(КонецДня(Период), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("НачалоПериода", ПрослеживаемостьБГУКлиентСервер.ДатаНачалаУчетаПрослеживаемыхТоваров());
	Запрос.УстановитьПараметр("СубконтоМЗ", СубконтоМЗ);
	Запрос.УстановитьПараметр("СубконтоОС", СубконтоОС);
	Запрос.УстановитьПараметр("ВсеСчета101", БухгалтерскийУчет.СписокСчетов("101.00"));
	Запрос.УстановитьПараметр("ВсеСчета105", БухгалтерскийУчет.СписокСчетов("105.00"));
	Запрос.УстановитьПараметр("ВсеСчета106", БухгалтерскийУчет.СписокСчетов("106.00"));
	Запрос.УстановитьПараметр("ВсеСчета21", БухгалтерскийУчет.СписокСчетов("21"));
	Запрос.УстановитьПараметр("Счет101", БухгалтерскийУчет.СчетПоКоду("101.00"));
	Запрос.УстановитьПараметр("Счет105", БухгалтерскийУчет.СчетПоКоду("105.00"));
	Запрос.УстановитьПараметр("Счет106", БухгалтерскийУчет.СчетПоКоду("106.00"));
	Запрос.УстановитьПараметр("Счет21", БухгалтерскийУчет.СчетПоКоду("21"));
	Запрос.УстановитьПараметр("ЕдиницаИзмеренияПоУмолчанию", Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("796"));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура) КАК Номенклатура,
	|	0 КАК Сумма,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК Количество,
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.ЦМО) КАК ЦМО,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОстатки.Счет В (&ВсеСчета105)
	|			ТОГДА &Счет105
	|		ИНАЧЕ &Счет106
	|	КОНЕЦ КАК ГруппаСчетов
	|ПОМЕСТИТЬ ТаблицаОстатков
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&ПериодОстатков, Счет В (&ВсеСчета105, &ВсеСчета106), &СубконтоМЗ, Организация = &Организация) КАК ЖурналПроводокЕПСБУОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	|		ПО ЖурналПроводокЕПСБУОстатки.Субконто1 = Номенклатура.Ссылка
	|ГДЕ
	|	Номенклатура.ПрослеживаемыйТовар
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства),
	|	0,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт,
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.ЦМО),
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОстатки.Счет В (&ВсеСчета101)
	|			ТОГДА &Счет101
	|		КОГДА ЖурналПроводокЕПСБУОстатки.Счет В (&ВсеСчета21)
	|			ТОГДА &Счет21
	|		ИНАЧЕ &Счет106
	|	КОНЕЦ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&ПериодОстатков, Счет В (&ВсеСчета101, &ВсеСчета106, &ВсеСчета21), &СубконтоОС, Организация = &Организация) КАК ЖурналПроводокЕПСБУОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ОсновныеСредства КАК Номенклатура
	|		ПО ЖурналПроводокЕПСБУОстатки.Субконто1 = Номенклатура.Ссылка
	|ГДЕ
	|	Номенклатура.ПрослеживаемыйТовар
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РегистрацияПрослеживаемыхТоваров.Номенклатура КАК Номенклатура,
	|	СУММА(РегистрацияПрослеживаемыхТоваров.Количество) КАК Количество,
	|	СУММА(РегистрацияПрослеживаемыхТоваров.Сумма) КАК Сумма,
	|	РегистрацияПрослеживаемыхТоваров.Основание КАК ДокументРегистрации,
	|	РегистрацияПрослеживаемыхТоваров.Основание.ЦМО КАК ЦМО,
	|	РегистрацияПрослеживаемыхТоваров.ТНВЭД КАК ТНВЭД,
	|	РегистрацияПрослеживаемыхТоваров.СтранаПроисхождения КАК СтранаПроисхождения
	|ПОМЕСТИТЬ ЗарегистрированныеОстаткиПоОснованию
	|ИЗ
	|	РегистрСведений.РегистрацияПрослеживаемыхТоваров КАК РегистрацияПрослеживаемыхТоваров
	|ГДЕ
	|	РегистрацияПрослеживаемыхТоваров.Организация = &Организация
	|	И РегистрацияПрослеживаемыхТоваров.ВидОперации = ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРегистрацииПрослеживаемыхТоваров.ИнвентаризацияТоваров)
	|	И РегистрацияПрослеживаемыхТоваров.ПериодСобытия <= КОНЕЦПЕРИОДА(&Период, МЕСЯЦ)
	|
	|СГРУППИРОВАТЬ ПО
	|	РегистрацияПрослеживаемыхТоваров.Номенклатура,
	|	РегистрацияПрослеживаемыхТоваров.Основание,
	|	РегистрацияПрослеживаемыхТоваров.Основание.ЦМО,
	|	РегистрацияПрослеживаемыхТоваров.ТНВЭД,
	|	РегистрацияПрослеживаемыхТоваров.СтранаПроисхождения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПрослеживаемыеТоварыОбороты.Номенклатура КАК Номенклатура,
	|	СУММА(ПрослеживаемыеТоварыОбороты.КоличествоПриход) КАК КоличествоПриход,
	|	СУММА(ПрослеживаемыеТоварыОбороты.КоличествоРасход) КАК КоличествоРасход,
	|	ВЫБОР
	|		КОГДА ПрослеживаемыеТоварыОбороты.Регистратор ССЫЛКА Документ.ТребованиеНакладная0315006
	|			ТОГДА ВЫРАЗИТЬ(ПрослеживаемыеТоварыОбороты.Регистратор КАК Документ.ТребованиеНакладная0315006).ЦМООтправитель
	|		ИНАЧЕ ПрослеживаемыеТоварыОбороты.Регистратор.ЦМО
	|	КОНЕЦ КАК ЦМО,
	|	ПрослеживаемыеТоварыОбороты.РНПТ КАК РНПТ,
	|	ВЫБОР
	|		КОГДА НЕ ПрослеживаемыеТоварыОбороты.Регистратор ССЫЛКА Документ.УведомлениеОбОстаткахПрослеживаемыхТоваров
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоРНПТОтПоставщика,
	|	ПрослеживаемыеТоварыОбороты.СтранаПроисхождения КАК СтранаПроисхождения
	|ПОМЕСТИТЬ ПрослеживаемыеТоварыСРНПТ
	|ИЗ
	|	РегистрНакопления.ПрослеживаемыеТовары.Обороты(&НачалоПериода, &Период, Регистратор, Организация = &Организация) КАК ПрослеживаемыеТоварыОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	ПрослеживаемыеТоварыОбороты.Номенклатура,
	|	ВЫБОР
	|		КОГДА ПрослеживаемыеТоварыОбороты.Регистратор ССЫЛКА Документ.ТребованиеНакладная0315006
	|			ТОГДА ВЫРАЗИТЬ(ПрослеживаемыеТоварыОбороты.Регистратор КАК Документ.ТребованиеНакладная0315006).ЦМООтправитель
	|		ИНАЧЕ ПрослеживаемыеТоварыОбороты.Регистратор.ЦМО
	|	КОНЕЦ,
	|	ПрослеживаемыеТоварыОбороты.РНПТ,
	|	ВЫБОР
	|		КОГДА НЕ ПрослеживаемыеТоварыОбороты.Регистратор ССЫЛКА Документ.УведомлениеОбОстаткахПрослеживаемыхТоваров
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ,
	|	ПрослеживаемыеТоварыОбороты.СтранаПроисхождения
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПрослеживаемыеОСОбороты.ОсновноеСредство,
	|	СУММА(ПрослеживаемыеОСОбороты.КоличествоПриход),
	|	СУММА(ПрослеживаемыеОСОбороты.КоличествоРасход),
	|	ВЫБОР
	|		КОГДА ПрослеживаемыеОСОбороты.Регистратор ССЫЛКА Документ.ТребованиеНакладная0315006
	|			ТОГДА ВЫРАЗИТЬ(ПрослеживаемыеОСОбороты.Регистратор КАК Документ.ТребованиеНакладная0315006).ЦМОПолучатель
	|		ИНАЧЕ ПрослеживаемыеОСОбороты.Регистратор.ЦМО
	|	КОНЕЦ,
	|	ПрослеживаемыеОСОбороты.РНПТ,
	|	ВЫБОР
	|		КОГДА НЕ ПрослеживаемыеОСОбороты.Регистратор ССЫЛКА Документ.УведомлениеОбОстаткахПрослеживаемыхТоваров
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ,
	|	ПрослеживаемыеОСОбороты.СтранаПроисхождения
	|ИЗ
	|	РегистрНакопления.ПрослеживаемыеОС.Обороты(&НачалоПериода, &Период, Регистратор, Организация = &Организация) КАК ПрослеживаемыеОСОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	ПрослеживаемыеОСОбороты.ОсновноеСредство,
	|	ВЫБОР
	|		КОГДА ПрослеживаемыеОСОбороты.Регистратор ССЫЛКА Документ.ТребованиеНакладная0315006
	|			ТОГДА ВЫРАЗИТЬ(ПрослеживаемыеОСОбороты.Регистратор КАК Документ.ТребованиеНакладная0315006).ЦМОПолучатель
	|		ИНАЧЕ ПрослеживаемыеОСОбороты.Регистратор.ЦМО
	|	КОНЕЦ,
	|	ПрослеживаемыеОСОбороты.РНПТ,
	|	ПрослеживаемыеОСОбороты.СтранаПроисхождения,
	|	ВЫБОР
	|		КОГДА НЕ ПрослеживаемыеОСОбороты.Регистратор ССЫЛКА Документ.УведомлениеОбОстаткахПрослеживаемыхТоваров
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПрослеживаемыеТоварыСРНПТ.РНПТ КАК РНПТ,
	|	ПрослеживаемыеТоварыСРНПТ.СтранаПроисхождения КАК СтранаПроисхождения
	|ПОМЕСТИТЬ СписокРНПТОтПоставщика
	|ИЗ
	|	ПрослеживаемыеТоварыСРНПТ КАК ПрослеживаемыеТоварыСРНПТ
	|ГДЕ
	|	ПрослеживаемыеТоварыСРНПТ.ЭтоРНПТОтПоставщика
	|
	|СГРУППИРОВАТЬ ПО
	|	ПрослеживаемыеТоварыСРНПТ.РНПТ,
	|	ПрослеживаемыеТоварыСРНПТ.СтранаПроисхождения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПрослеживаемыеТоварыСРНПТ.Номенклатура КАК Номенклатура,
	|	СУММА(ПрослеживаемыеТоварыСРНПТ.КоличествоПриход - ПрослеживаемыеТоварыСРНПТ.КоличествоРасход) КАК Остаток,
	|	ПрослеживаемыеТоварыСРНПТ.ЦМО КАК ЦМО,
	|	ПрослеживаемыеТоварыСРНПТ.СтранаПроисхождения КАК СтранаПроисхождения
	|ПОМЕСТИТЬ ТаблицаОстатковПрослеживаемогоТовараСРНПТОтПоставщика
	|ИЗ
	|	ПрослеживаемыеТоварыСРНПТ КАК ПрослеживаемыеТоварыСРНПТ
	|ГДЕ
	|	ПрослеживаемыеТоварыСРНПТ.РНПТ В
	|			(ВЫБРАТЬ
	|				СписокРНПТОтПоставщика.РНПТ
	|			ИЗ
	|				СписокРНПТОтПоставщика КАК СписокРНПТОтПоставщика)
	|
	|СГРУППИРОВАТЬ ПО
	|	ПрослеживаемыеТоварыСРНПТ.Номенклатура,
	|	ПрослеживаемыеТоварыСРНПТ.ЦМО,
	|	ПрослеживаемыеТоварыСРНПТ.СтранаПроисхождения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаОстатковБезОснования.Номенклатура КАК Номенклатура,
	|	СУММА(ЕСТЬNULL(ТаблицаОстатковБезОснования.Количество, 0) - ЕСТЬNULL(ТаблицаОстатковПоОснованию.Количество, 0) - ЕСТЬNULL(ТаблицаОстатковПрослеживаемогоТовараСРНПТОтПоставщика.Остаток, 0)) КАК Количество,
	|	СУММА(ЕСТЬNULL(ТаблицаОстатковБезОснования.Сумма, 0) - ЕСТЬNULL(ТаблицаОстатковПоОснованию.Сумма, 0)) КАК Сумма,
	|	ТаблицаОстатковБезОснования.ЦМО КАК ЦМО,
	|	ТаблицаОстатковПрослеживаемогоТовараСРНПТОтПоставщика.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ТаблицаОстатковБезОснования.ГруппаСчетов КАК ГруппаСчетов
	|ПОМЕСТИТЬ ТаблицаОстатковБезОснования
	|ИЗ
	|	ТаблицаОстатков КАК ТаблицаОстатковБезОснования
	|		ЛЕВОЕ СОЕДИНЕНИЕ ЗарегистрированныеОстаткиПоОснованию КАК ТаблицаОстатковПоОснованию
	|		ПО ТаблицаОстатковБезОснования.Номенклатура = ТаблицаОстатковПоОснованию.Номенклатура
	|			И ТаблицаОстатковБезОснования.ЦМО = ТаблицаОстатковПоОснованию.ЦМО
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаОстатковПрослеживаемогоТовараСРНПТОтПоставщика КАК ТаблицаОстатковПрослеживаемогоТовараСРНПТОтПоставщика
	|		ПО ТаблицаОстатковБезОснования.Номенклатура = ТаблицаОстатковПрослеживаемогоТовараСРНПТОтПоставщика.Номенклатура
	|			И ТаблицаОстатковБезОснования.ЦМО = ТаблицаОстатковПрослеживаемогоТовараСРНПТОтПоставщика.ЦМО
	|ГДЕ
	|	ЕСТЬNULL(ТаблицаОстатковБезОснования.Количество, 0) - ЕСТЬNULL(ТаблицаОстатковПоОснованию.Количество, 0) > 0
	|	И ТаблицаОстатковПоОснованию.Количество ЕСТЬ NULL
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаОстатковБезОснования.Номенклатура,
	|	ТаблицаОстатковБезОснования.ЦМО,
	|	ТаблицаОстатковПрослеживаемогоТовараСРНПТОтПоставщика.СтранаПроисхождения,
	|	ТаблицаОстатковБезОснования.ГруппаСчетов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗарегистрированныеОстатки.Номенклатура КАК Номенклатура,
	|	СУММА(ЗарегистрированныеОстатки.Количество) КАК Количество,
	|	СУММА(ЗарегистрированныеОстатки.Сумма) КАК Сумма,
	|	ЗарегистрированныеОстатки.ДокументРегистрации КАК ДокументРегистрации,
	|	НоменклатураСправочник.ОКП КАК КодОКПД2,
	|	НоменклатураСправочник.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ЗарегистрированныеОстатки.ТНВЭД КАК КодТНВЭД,
	|	КлассификаторТНВЭД.ЕдиницаИзмерения КАК ЕдиницаПрослеживаемости,
	|	ВЫБОР
	|		КОГДА НоменклатураСправочник.ВесПоСертификатуТовара > 0
	|			ТОГДА ЗарегистрированныеОстатки.Количество * НоменклатураСправочник.ВесПоСертификатуТовара
	|		ИНАЧЕ ЗарегистрированныеОстатки.Количество
	|	КОНЕЦ КАК КоличествоПрослеживаеомсти,
