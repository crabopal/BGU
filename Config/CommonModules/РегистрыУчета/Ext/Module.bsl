
#Область ПрограммныйИнтерфейс

Процедура ПриСозданииНаСервере(Форма, ГруппаФормы = "", ТипФормы = "ФормаОтчета") Экспорт
	
	Если НЕ ПравоДоступа("Изменение", Метаданные.Документы.РегистрУчета) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипФормы = "ФормаОтчета" Тогда    
				
		МетаданныеОтчета = Форма.РеквизитФормыВЗначение("Отчет").Метаданные();
		
		ИмяОтчета = МетаданныеОтчета.Имя;
		ПолноеИмяОтчета = МетаданныеОтчета.ПолноеИмя();  
		
		Если СтрНачинаетсяС(ПолноеИмяОтчета, "ВнешнийОтчет.") Тогда
			Возврат;
		КонецЕсли;	

		Попытка
			Если НЕ Отчеты[ИмяОтчета].ЭтоРегистрУчета() Тогда
				Возврат;
			КонецЕсли;
		Исключение
			Возврат;
		КонецПопытки;
						
		НаименованиеВидаРегистра = "";
		
		КлючВарианта = Неопределено;
		Форма.Параметры.Свойство("КлючВарианта", КлючВарианта);
		Если НЕ ЗначениеЗаполнено(КлючВарианта) Тогда
			КлючВарианта = Форма.КлючТекущегоВарианта;
		КонецЕсли;
		
		ВидРегистра = Справочники.ВидыРегистровУчета.ПолучитьВидРегистраБухгалтерскогоУчетаДляОтчета(
			ПолноеИмяОтчета, КлючВарианта, НаименованиеВидаРегистра);
		
		ОбработчикКоманды = "Подключаемый_Команда";
		
	ИначеЕсли ТипФормы = "ФормаПечати" Тогда
		
		Если НЕ Форма.Параметры.ПараметрыПечати.ДополнительныеПараметры.Свойство("РегистрУчета") Тогда
			Возврат;
		КонецЕсли;
		
		Если Форма.Параметры.ПараметрКоманды.Количество() < 1 Тогда
			Возврат;
		КонецЕсли;
		
		ОбъектМетаданных = Форма.Параметры.ПараметрКоманды[0].Метаданные();
		
		ПолноеИмяОтчета = ОбъектМетаданных.ПолноеИмя();
		
		ИдентификаторКомандыПечати = Форма.Параметры.ИменаМакетов;
		
		Если Форма.Параметры.ПараметрыПечати.Свойство("Представление") Тогда
			НаименованиеВидаРегистра = Форма.Параметры.ПараметрыПечати.Представление;
		Иначе
			КомандыПечати = УправлениеПечатью.КомандыПечатиОбъекта(ОбъектМетаданных);
			КомандаПечати = КомандыПечати.Найти(ИдентификаторКомандыПечати, "Идентификатор");
			Если КомандаПечати <> Неопределено Тогда
				НаименованиеВидаРегистра = КомандаПечати.Представление;
			Иначе
				ВызватьИсключение НСтр("ru = 'Не найдена команда печати с идентификатором: '") + ИдентификаторКомандыПечати;
			КонецЕсли;
		КонецЕсли;
		
		ВидРегистра = Справочники.ВидыРегистровУчета.ПолучитьВидРегистраБухгалтерскогоУчетаДляПечатнойформы(
			ПолноеИмяОтчета, ИдентификаторКомандыПечати, НаименованиеВидаРегистра);
		
		ОбработчикКоманды = "Подключаемый_ВыполнитьКоманду";
		
	Иначе
		
		Возврат;
		
	КонецЕсли;
	
	ГруппаДляКнопок = Неопределено;
	
	Если ЗначениеЗаполнено(ГруппаФормы) Тогда
		ГруппаДляКнопок = Форма.Элементы[ГруппаФормы];
	ИначеЕсли НЕ Форма.ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиФормы.Нет Тогда
		ГруппаДляКнопок = Форма.Элементы.КоманднаяПанель
	Иначе
		//Добавляем в первую группу вида "Командная панель"
		Для Каждого ЭлементФормы Из Форма.Элементы Цикл
			Если ЭлементФормы.Вид = ВидГруппыФормы.КоманднаяПанель Тогда
				ГруппаДляКнопок = ЭлементФормы;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ГруппаДляКнопок = Неопределено Тогда
		// не нашли, куда разместить команды
		Возврат;
	КонецЕсли;
	
	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ВидРегистраУчета", Новый ОписаниеТипов("СправочникСсылка.ВидыРегистровУчета")));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ИспользуетсяЭП", Новый ОписаниеТипов("Булево")));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ТипФормы", Новый ОписаниеТипов("Строка")));
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	Если ЕстьРеквизитФормы(Форма, "ПостоянныеРеквизиты") Тогда
		Форма.ПостоянныеРеквизиты.Добавить("ВидРегистраУчета");
		Форма.ПостоянныеРеквизиты.Добавить("ИспользуетсяЭП");
	КонецЕсли;
	
	Форма.ИспользуетсяЭП = ПолучитьФункциональнуюОпцию("ИспользоватьЭлектронныеПодписи");
	Форма.ВидРегистраУчета = ВидРегистра;
	Форма.ТипФормы = ТипФормы;
	
	// Добавление команд и кнопок
	ПодменюИмя = "РегистрУчета";
	
	КомандаСохранитьРегистр = Форма.Команды.Добавить("СохранитьРегистрУчета");
	КомандаСохранитьРегистр.Действие  = ОбработчикКоманды;
	КомандаСохранитьРегистр.Заголовок = НСтр("ru = 'Сохранить'");
	КомандаСохранитьРегистр.Подсказка = НСтр("ru = 'Сохранить регистр учета в архиве.'");
	
	КомандаСохранитьРегистрРаздельно = Форма.Команды.Добавить("СохранитьРегистрУчетаРаздельно");
	КомандаСохранитьРегистрРаздельно.Действие  = ОбработчикКоманды;
	КомандаСохранитьРегистрРаздельно.Заголовок = НСтр("ru = 'Сохранить (раздельно для каждого объекта)'");
	КомандаСохранитьРегистрРаздельно.Подсказка = 
		НСтр("ru = 'Сохранить регистры учета в архиве (раздельно для каждого объекта).'");
		
	Если ВнутреннийЭДОПереопределяемый.ИспользуютсяВнутренниеДокументы() Тогда
		КомандаСохранитьИПодписатьРегистр = Форма.Команды.Добавить("СохранитьРегистрУчетаИСоздатьВнутрЭД");
		КомандаСохранитьИПодписатьРегистр.Действие  = ОбработчикКоманды;
		КомандаСохранитьИПодписатьРегистр.Картинка  = БиблиотекаКартинок.Оригинал;
		КомандаСохранитьИПодписатьРегистр.Заголовок = НСтр("ru = 'Сохранить и создать внутр. ЭД'");
		КомандаСохранитьИПодписатьРегистр.Подсказка = НСтр("ru = 'Сохранить регистр учета в архиве и создать внутренний электронный документ'");

		КомандаСохранитьИПодписатьРегистрРаздельно = 
			Форма.Команды.Добавить("СохранитьРегистрУчетаИСоздатьВнутрЭДРаздельно");
		КомандаСохранитьИПодписатьРегистрРаздельно.Действие  = ОбработчикКоманды;
		КомандаСохранитьИПодписатьРегистрРаздельно.Картинка  = БиблиотекаКартинок.Оригинал;
		КомандаСохранитьИПодписатьРегистрРаздельно.Заголовок = 
			НСтр("ru = 'Сохранить и создать внутр. ЭД (раздельно для каждого объекта)'");
		КомандаСохранитьИПодписатьРегистрРаздельно.Подсказка = 
			НСтр("ru = 'Сохранить регистр учета в архиве и создать внутренний электронный документ (раздельно для каждого объекта)'");
	Иначе
		КомандаСохранитьИПодписатьРегистр = Неопределено;
	КонецЕсли;
	
	КомандаАрхив = Форма.Команды.Добавить("АрхивРегистровУчета");
	КомандаАрхив.Действие  = ОбработчикКоманды;
	КомандаАрхив.Заголовок = НСтр("ru = 'Открыть архив'");
	КомандаАрхив.Подсказка = НСтр("ru = 'Открыть архив сохраненных регистров учета.'");
	
	Если ЕстьРеквизитФормы(Форма, "ПостоянныеКоманды") Тогда
		Форма.ПостоянныеКоманды.Добавить(КомандаАрхив.Имя);
		Форма.ПостоянныеКоманды.Добавить(КомандаСохранитьРегистр.Имя);
		Если КомандаСохранитьИПодписатьРегистр <> Неопределено Тогда
			Форма.ПостоянныеКоманды.Добавить(КомандаСохранитьИПодписатьРегистр.Имя);
		КонецЕсли;
	КонецЕсли;
	
	Подменю 			= Форма.Элементы.Добавить(ПодменюИмя, Тип("ГруппаФормы"), ГруппаДляКнопок);
	Подменю.Вид 		= ВидГруппыФормы.Подменю;
	Подменю.Заголовок 	= НСтр("ru = 'Регистр учета'");
	Подменю.Картинка 	= БиблиотекаКартинок.ПакетыОтчетов;
	
	ЭлементСохранитьРегистр = Форма.Элементы.Добавить(КомандаСохранитьРегистр.Имя, Тип("КнопкаФормы"), Подменю);
	ЭлементСохранитьРегистр.ИмяКоманды = КомандаСохранитьРегистр.Имя;
	
	ЭлементСохранитьРегистрРаздельно = 
		Форма.Элементы.Добавить(КомандаСохранитьРегистрРаздельно.Имя, Тип("КнопкаФормы"), Подменю);
	ЭлементСохранитьРегистрРаздельно.ИмяКоманды = КомандаСохранитьРегистрРаздельно.Имя;
	ЭлементСохранитьРегистрРаздельно.Видимость = Ложь;
	
	Если КомандаСохранитьИПодписатьРегистр <> Неопределено Тогда
		ЭлементСохранитьРегистрУчетаИПодписатьЭП = Форма.Элементы.Добавить(КомандаСохранитьИПодписатьРегистр.Имя, Тип("КнопкаФормы"), Подменю);
		ЭлементСохранитьРегистрУчетаИПодписатьЭП.ИмяКоманды = КомандаСохранитьИПодписатьРегистр.Имя;
	КонецЕсли;
	
	Если КомандаСохранитьИПодписатьРегистрРаздельно <> Неопределено Тогда
		ЭлементСохранитьРегистрУчетаИПодписатьЭПРаздельно = 
			Форма.Элементы.Добавить(КомандаСохранитьИПодписатьРегистрРаздельно.Имя, Тип("КнопкаФормы"), Подменю);
		ЭлементСохранитьРегистрУчетаИПодписатьЭПРаздельно.ИмяКоманды = КомандаСохранитьИПодписатьРегистрРаздельно.Имя;
		ЭлементСохранитьРегистрУчетаИПодписатьЭПРаздельно.Видимость = Ложь;
	КонецЕсли;
	
	ЭлементАрхив = Форма.Элементы.Добавить(КомандаАрхив.Имя, Тип("КнопкаФормы"), Подменю);
	ЭлементАрхив.ИмяКоманды = КомандаАрхив.Имя;
	
КонецПроцедуры

Процедура ДополнитьСвойстваРегистраУчета(СвойстваРегистраУчета, Знач Отчет) Экспорт
	
	Если ТипЗнч(Отчет) = Тип("Структура") Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(СвойстваРегистраУчета, Отчет, Истина);
		Возврат;
	КонецЕсли;
	
	ИмяОтчета = СвойстваРегистраУчета.ВидРегистра.Отчет.Имя;
	
	Попытка
		Отчеты[ИмяОтчета].СвойстваРегистраУчета(Отчет, СвойстваРегистраУчета);
	Исключение
		СвойстваРегистраУчета.Вставить("НетДанных", Истина);
	КонецПопытки;
	
КонецПроцедуры

Функция СохранитьРегистрУчета(СвойстваРегистраУчета, Знач Отчет, НастройкиВРегистр) Экспорт
	
	ДополнитьСвойстваРегистраУчета(СвойстваРегистраУчета, Отчет);
	
	Если СвойстваРегистраУчета.Свойство("НетДанных") Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Если НЕ ПроверитьВозможностьСохраненияРезультата(СвойстваРегистраУчета) Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	РегистрУчета = Документы.РегистрУчета.СоздатьДокумент();
	РегистрУчета.Заполнить(СвойстваРегистраУчета);
	СсылкаНового = Документы.РегистрУчета.ПолучитьСсылку();
	IDРегистра = СсылкаНового.УникальныйИдентификатор();
	РегистрУчета.УстановитьСсылкуНового(СсылкаНового);
	РегистрУчетаВХранилище = СформироватьРегистрУчетаИзТабличногоДокумента(СвойстваРегистраУчета.ТаблицаРегистра, IDРегистра);
	
	Если НастройкиВРегистр Тогда
		
		РегистрУчетаВХранилищеMXL = СформироватьРегистрУчетаИзТабличногоДокумента(
			СвойстваРегистраУчета.ТаблицаРегистра, IDРегистра, ПредопределенноеЗначение("Перечисление.ФорматыСохраненияОтчетов.MXL"));
		
		Если ТипЗнч(Отчет) = Тип("Структура") Тогда
			Настройки = Неопределено;
			ПользовательскиеНастройки = Неопределено;
		Иначе
			Настройки = Отчет.КомпоновщикНастроек.Настройки;
			ПользовательскиеНастройки = ПолучитьПользовательскиеНастройки(Отчет.КомпоновщикНастроек.ПользовательскиеНастройки);
		КонецЕсли;
		
		НастройкиДляСохранения = Новый Структура("Настройки, ПользовательскиеНастройки", Настройки, ПользовательскиеНастройки);
		
		РегистрУчета.ПользовательскиеНастройкиОтчета = Новый ХранилищеЗначения(НастройкиДляСохранения, Новый СжатиеДанных(9));
		
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		
		ИмяФайла = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(РегистрУчета.Описание);
		ТаблицаФорматов = УправлениеПечатью.НастройкиФорматовСохраненияТабличногоДокумента();
		
		// собственно регистр учета в заданносм пользователем формате
		//
		НастройкиФормата = ТаблицаФорматов.НайтиСтроки(Новый Структура("Ссылка", РегистрУчета.ФорматСохраненияФайла))[0];
		
		РегистрУчета.Записать();

		ПараметрыФайла = Новый Структура();
		ПараметрыФайла.Вставить("Автор", Пользователи.ТекущийПользователь());
		ПараметрыФайла.Вставить("ВладелецФайлов", РегистрУчета.Ссылка);
		ПараметрыФайла.Вставить("ИмяБезРасширения", ИмяФайла);
		ПараметрыФайла.Вставить("РасширениеБезТочки", НастройкиФормата.Расширение);
		ПараметрыФайла.Вставить("ВремяИзмененияУниверсальное", РегистрУчета.Дата);
				
		ДобавленныйФайл = РаботаСФайлами.ДобавитьФайл(
			ПараметрыФайла, РегистрУчетаВХранилище, "", РегистрУчета.Описание);
			
		Если НастройкиВРегистр Тогда	
			// табличный документ (MXL) - для контроля, служебный файл	
			//
			НастройкиФормата = ТаблицаФорматов.НайтиСтроки(Новый Структура("Ссылка", ПредопределенноеЗначение("Перечисление.ФорматыСохраненияОтчетов.MXL")))[0];
			
			ПараметрыФайла = Новый Структура();
			ПараметрыФайла.Вставить("Автор", Пользователи.ТекущийПользователь());
			ПараметрыФайла.Вставить("ВладелецФайлов", РегистрУчета.Ссылка);
			ПараметрыФайла.Вставить("ИмяБезРасширения", ИмяФайла);
			ПараметрыФайла.Вставить("РасширениеБезТочки", НастройкиФормата.Расширение);
			ПараметрыФайла.Вставить("ВремяИзмененияУниверсальное", РегистрУчета.Дата);
			ПараметрыФайла.Вставить("Служебный", Истина);
			
			ДобавленныйФайл = РаботаСФайлами.ДобавитьФайл(
				ПараметрыФайла, РегистрУчетаВХранилищеMXL, "", РегистрУчета.Описание);
			
			РегистрУчета.РегистрMXL = ДобавленныйФайл; 
			
		КонецЕсли;
		
		РегистрУчета.Записать();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		// Запись в журнал регистрации не требуется
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		Пока ИнформацияОбОшибке.Причина <> Неопределено Цикл
			ИнформацияОбОшибке = ИнформацияОбОшибке.Причина;
		КонецЦикла;
		ТекстСообщения = НСтр("ru = 'Регистр учета не сохранен'") + Символы.ПС + ИнформацияОбОшибке.Описание;
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		
		Возврат Неопределено;
		
	КонецПопытки;
	
	ДанныеСохранения = Новый Структура("РегистрУчета", РегистрУчета.Ссылка);
	
	СвойстваПрисоединенногоФайла = Документы.РегистрУчета.ПолучитьСвойстваПрисоединенногоФайлаРегистра(РегистрУчета.Ссылка, Истина);
	
	ДанныеСохранения.Вставить("ОписаниеРегистра", 	РегистрУчета.Описание);
	ДанныеСохранения.Вставить("ПрисоединенныйФайл", СвойстваПрисоединенногоФайла.ПрисоединенныйФайл);
	ДанныеСохранения.Вставить("ДанныеФайла", 		СвойстваПрисоединенногоФайла.ДанныеФайла);
	
	Возврат ДанныеСохранения;
	
КонецФункции

Функция СохранитьРегистрыУчета(СвойстваРегистровУчета, НастройкиВРегистр) Экспорт
	
	Результат = Новый Массив;
	
	НачатьТранзакцию();
	Попытка
		
		Для Каждого РегистрУчета Из СвойстваРегистровУчета Цикл
			
			СвойстваРегистраУчета = РегистрУчета.СвойстваРегистраУчета;
			Отчет = РегистрУчета.ДанныеОтчета;
			
			ДополнитьСвойстваРегистраУчета(СвойстваРегистраУчета, Отчет);
			
			Если СвойстваРегистраУчета.Свойство("НетДанных") Тогда
				ОтменитьТранзакцию();
				Возврат Неопределено;
			КонецЕсли;
			
			Если НЕ ПроверитьВозможностьСохраненияРезультата(СвойстваРегистраУчета) Тогда
				ОтменитьТранзакцию();
				Возврат Неопределено;
			КонецЕсли;
			
			РегистрУчета = Документы.РегистрУчета.СоздатьДокумент();
			РегистрУчета.Заполнить(СвойстваРегистраУчета);
			СсылкаНового = Документы.РегистрУчета.ПолучитьСсылку();
			IDРегистра = СсылкаНового.УникальныйИдентификатор();
			РегистрУчета.УстановитьСсылкуНового(СсылкаНового);
			РегистрУчетаВХранилище = СформироватьРегистрУчетаИзТабличногоДокумента(СвойстваРегистраУчета.ТаблицаРегистра, IDРегистра);
			
			Если НастройкиВРегистр Тогда
				
				РегистрУчетаВХранилищеMXL = СформироватьРегистрУчетаИзТабличногоДокумента(
					СвойстваРегистраУчета.ТаблицаРегистра, IDРегистра, ПредопределенноеЗначение("Перечисление.ФорматыСохраненияОтчетов.MXL"));
				
				Если ТипЗнч(Отчет) = Тип("Структура") Тогда
					Настройки = Неопределено;
					ПользовательскиеНастройки = Неопределено;
				ИначеЕсли СвойстваРегистраУчета.Свойство("КомпоновщикНастроекПоОбъекту") Тогда
					Настройки = СвойстваРегистраУчета.КомпоновщикНастроекПоОбъекту.Настройки;
					ПользовательскиеНастройки = ПолучитьПользовательскиеНастройки(
						СвойстваРегистраУчета.КомпоновщикНастроекПоОбъекту.ПользовательскиеНастройки);
				Иначе
					Настройки = Отчет.КомпоновщикНастроек.Настройки;
					ПользовательскиеНастройки = ПолучитьПользовательскиеНастройки(Отчет.КомпоновщикНастроек.ПользовательскиеНастройки);
				КонецЕсли;
				
				НастройкиДляСохранения = Новый Структура("Настройки, ПользовательскиеНастройки", Настройки, ПользовательскиеНастройки);
				
				РегистрУчета.ПользовательскиеНастройкиОтчета = Новый ХранилищеЗначения(НастройкиДляСохранения, Новый СжатиеДанных(9));
				
			КонецЕсли;
			
			
			ИмяФайла = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(РегистрУчета.Описание);
			ТаблицаФорматов = УправлениеПечатью.НастройкиФорматовСохраненияТабличногоДокумента();
			
			// регистр учета в заданном пользователем формате
			НастройкиФормата = ТаблицаФорматов.НайтиСтроки(Новый Структура("Ссылка", РегистрУчета.ФорматСохраненияФайла))[0];
			
			РегистрУчета.Записать();
			
			ПараметрыФайла = Новый Структура();
			ПараметрыФайла.Вставить("Автор", Пользователи.ТекущийПользователь());
			ПараметрыФайла.Вставить("ВладелецФайлов", РегистрУчета.Ссылка);
			ПараметрыФайла.Вставить("ИмяБезРасширения", ИмяФайла);
			ПараметрыФайла.Вставить("РасширениеБезТочки", НастройкиФормата.Расширение);
			ПараметрыФайла.Вставить("ВремяИзмененияУниверсальное", РегистрУчета.Дата);
			
			ДобавленныйФайл = РаботаСФайлами.ДобавитьФайл(
				ПараметрыФайла, РегистрУчетаВХранилище, "", РегистрУчета.Описание);
			
			Если НастройкиВРегистр Тогда
				
				// табличный документ (MXL) - для контроля, служебный файл
				НастройкиФормата = ТаблицаФорматов.НайтиСтроки(Новый Структура("Ссылка",
					ПредопределенноеЗначение("Перечисление.ФорматыСохраненияОтчетов.MXL")))[0];
				
				ПараметрыФайла = Новый Структура();
				ПараметрыФайла.Вставить("Автор", Пользователи.ТекущийПользователь());
				ПараметрыФайла.Вставить("ВладелецФайлов", РегистрУчета.Ссылка);
				ПараметрыФайла.Вставить("ИмяБезРасширения", ИмяФайла);
				ПараметрыФайла.Вставить("РасширениеБезТочки", НастройкиФормата.Расширение);
				ПараметрыФайла.Вставить("ВремяИзмененияУниверсальное", РегистрУчета.Дата);
				ПараметрыФайла.Вставить("Служебный", Истина);
				
				ДобавленныйФайл = РаботаСФайлами.ДобавитьФайл(
					ПараметрыФайла, РегистрУчетаВХранилищеMXL, "", РегистрУчета.Описание);
				
				РегистрУчета.РегистрMXL = ДобавленныйФайл; 
				
			КонецЕсли;
			
			РегистрУчета.Записать();
			
			ДанныеСохранения = Новый Структура("РегистрУчета", РегистрУчета.Ссылка);
			
			СвойстваПрисоединенногоФайла = Документы.РегистрУчета.ПолучитьСвойстваПрисоединенногоФайлаРегистра(РегистрУчета.Ссылка, Истина);
			
			ДанныеСохранения.Вставить("ОписаниеРегистра", РегистрУчета.Описание);
			ДанныеСохранения.Вставить("ПрисоединенныйФайл", СвойстваПрисоединенногоФайла.ПрисоединенныйФайл);
			ДанныеСохранения.Вставить("ДанныеФайла", СвойстваПрисоединенногоФайла.ДанныеФайла);
			
			Результат.Добавить(ДанныеСохранения);
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		// Запись в журнал регистрации не требуется
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		Пока ИнформацияОбОшибке.Причина <> Неопределено Цикл
			ИнформацияОбОшибке = ИнформацияОбОшибке.Причина;
		КонецЦикла;
		ТекстСообщения = НСтр("ru = 'Регистр учета не сохранен'") + Символы.ПС + ИнформацияОбОшибке.Описание;
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		
		Возврат Неопределено;
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьФорматСохраненияРегистров() Экспорт
	
	ФорматРегистра = Константы.ФорматСохраненияРегистровУчета.Получить();
	Возврат ?(ЗначениеЗаполнено(ФорматРегистра), ФорматРегистра, Перечисления.ФорматыСохраненияОтчетов.PDF);
	
КонецФункции

Функция ПолучитьПользовательскиеНастройки(Настройки) Экспорт
	
	ЭлементыНастроек = Настройки.Элементы;
	
	Для Каждого ЭлементНастройки Из ЭлементыНастроек Цикл
		Если ТипЗнч(ЭлементНастройки) <> Тип("ЗначениеПараметраНастроекКомпоновкиДанных")
			ИЛИ НЕ ЭлементНастройки.Использование Тогда
			
			Продолжить;
		КонецЕсли;
		
		// Убираем относительный период из настроек
		Если ТипЗнч(ЭлементНастройки.Значение) = Тип("СтандартныйПериод") Тогда
			НовыйПериод = Новый СтандартныйПериод;
			НовыйПериод.Вариант = ВариантСтандартногоПериода.ПроизвольныйПериод;
			НовыйПериод.ДатаНачала = ЭлементНастройки.Значение.ДатаНачала;
			НовыйПериод.ДатаОкончания = ЭлементНастройки.Значение.ДатаОкончания;
			ЭлементНастройки.Значение = НовыйПериод;
		ИначеЕсли ТипЗнч(ЭлементНастройки.Значение) = Тип("СтандартнаяДатаНачала") Тогда
			НовыйПериод = Новый СтандартнаяДатаНачала;
			НовыйПериод.Вариант = ВариантСтандартнойДатыНачала.ПроизвольнаяДата;
			НовыйПериод.Дата = ЭлементНастройки.Значение.Дата;
			ЭлементНастройки.Значение = НовыйПериод;
		КонецЕсли;	
		
	КонецЦикла;
	
	Возврат Настройки
	
КонецФункции

Процедура ИнициализироватьКомпоновщикНастроек(Форма, ВариантОтчета, ВидимостьПараметров,
	ОбъектРегистр = "Объект", Компоновщик = "КомпоновщикНастроекКД",
	ПользовательскиеНастройки = "ПользовательскиеНастройкиОтчета") Экспорт
	
	УникальныйИдентификаторФормы = Форма.УникальныйИдентификатор;
	СохраненныеНастройки = Форма[ОбъектРегистр].Ссылка.ПолучитьОбъект()[ПользовательскиеНастройки].Получить();
	
	Если СохраненныеНастройки = Неопределено Тогда
		Возврат;
	ИначеЕсли ТипЗнч(СохраненныеНастройки) = Тип("Структура")
		И СохраненныеНастройки.Настройки = Неопределено
		И СохраненныеНастройки.ПользовательскиеНастройки = Неопределено Тогда
		Возврат;
	ИначеЕсли Не ЗначениеЗаполнено(ВариантОтчета) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыПодключения = Новый Структура;
	ПараметрыПодключения.Вставить("СсылкаВарианта",              ВариантОтчета);
	ПараметрыПодключения.Вставить("ИдентификаторФормы",          УникальныйИдентификаторФормы);
	Если ТипЗнч(СохраненныеНастройки) = Тип("Структура") Тогда
		ПараметрыПодключения.Вставить("НастройкиКД", СохраненныеНастройки.Настройки);
		ПараметрыПодключения.Вставить("ПользовательскиеНастройкиКД", СохраненныеНастройки.ПользовательскиеНастройки);
		Попытка
			Подключение = ВариантыОтчетов.ПодключитьОтчетИЗагрузитьНастройки(ПараметрыПодключения);
		Исключение
			ПараметрыПодключения.Удалить("НастройкиКД");
			Подключение = ВариантыОтчетов.ПодключитьОтчетИЗагрузитьНастройки(ПараметрыПодключения);
		КонецПопытки
	Иначе
		ПараметрыПодключения.Вставить("ПользовательскиеНастройкиКД", СохраненныеНастройки);
		Подключение = ВариантыОтчетов.ПодключитьОтчетИЗагрузитьНастройки(ПараметрыПодключения);
	КонецЕсли;
	
	Если Подключение.Успех Тогда
		ВидимостьПараметров = Истина;
		Форма[Компоновщик] = Подключение.Объект.КомпоновщикНастроек;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьДанныеСравнения(Форма, ВариантОтчета, СохраненнаяТаблица,
	ОбъектРегистр = "Объект", ПользовательскиеНастройки = "ПользовательскиеНастройкиОтчета") Экспорт
	
	УникальныйИдентификаторФормы = Форма.УникальныйИдентификатор;
	СохраненныеНастройки = Форма[ОбъектРегистр].Ссылка.ПолучитьОбъект()[ПользовательскиеНастройки].Получить();
	
	ПараметрыПодключения = Новый Структура;
	ПараметрыПодключения.Вставить("СсылкаВарианта",              ВариантОтчета);
	ПараметрыПодключения.Вставить("ИдентификаторФормы",          УникальныйИдентификаторФормы);
	Если ТипЗнч(СохраненныеНастройки) = Тип("Структура") Тогда
		ПараметрыПодключения.Вставить("НастройкиКД", СохраненныеНастройки.Настройки);
		ПараметрыПодключения.Вставить("ПользовательскиеНастройкиКД", СохраненныеНастройки.ПользовательскиеНастройки);
		Попытка
			Подключение = ВариантыОтчетов.СформироватьОтчет(ПараметрыПодключения, Ложь, Ложь);
		Исключение
			ПараметрыПодключения.Удалить("НастройкиКД");
			Подключение = ВариантыОтчетов.СформироватьОтчет(ПараметрыПодключения, Ложь, Ложь);
		КонецПопытки
	Иначе
		ПараметрыПодключения.Вставить("ПользовательскиеНастройкиКД", СохраненныеНастройки);
		Подключение = ВариантыОтчетов.СформироватьОтчет(ПараметрыПодключения, Ложь, Ложь);
	КонецЕсли;
	
	ТаблицаОтчета = ПоместитьВоВременноеХранилище(Подключение.ТабличныйДокумент); 
	
	РезультатБД = РаботаСФайлами.ДанныеФайла(СохраненнаяТаблица);
	
	ТабличныеДокументыСтруктура = Новый Структура("Левый, Правый", ТаблицаОтчета, РезультатБД.СсылкаНаДвоичныеДанныеФайла);
	АдресТабличныхДокументов = ПоместитьВоВременноеХранилище(ТабличныеДокументыСтруктура, Неопределено);
	
	ПараметрыОткрытияФормы = Новый Структура("АдресТабличныхДокументов, ЗаголовокЛевый, ЗаголовокПравый", 
		АдресТабличныхДокументов, "Текущие данные базы", "Сохраненные данные регистра");
		
	Возврат ПараметрыОткрытияФормы;	

КонецФункции

Процедура ПечатьДокументовПриСозданииНаСервере(Форма, Отказ, СтандартнаяОбработка) Экспорт
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ПроцессыОбработкиДокументов") Тогда
		ПриСозданииНаСервере(Форма, "КоманднаяПанельПраваяЧасть", "ФормаПечати");
	КонецЕсли;
	
КонецПроцедуры

// Формирует копию исходного компоновщика настроек, и заменяет в нем в параметре данных список объектов
// одним объектом, по которому сохраняется регистр учета.
// Используется для модификации компоновщика настроек при групповом формировании регистров учета.
// Когда в одном табличном документе выводятся несколько отчетов по разным объектам, например, инвентарные карточки
// по нескольким объектам. И по каждому объекту нужно сформировать отдельный регистр учета.
//   
// Можно использовать, если отбор отчета по объектам задается в СКД параметром!
//
// Параметры:
//  НастрокиКНИсходные - НастройкиКомпоновкиДанных - исходные настройки компоновщика настроек отчета
//  ПараметрДанных - ПараметрКомпоновкиДанных - параметр исходных настроек, в значении которого задан список объектов,
//    по которым формируется отбор. 
//  СвойстваРегистраУчета - Структура - структура, в которую будет добавлен новый модифицированный компоновщик
//  настроек с ключом "КомпоновщикНастроекПоОбъекту"   
Процедура УстановитьВСвойстваКомпоновщикСОтборомПоОбъекту(
	НастрокиКНИсходные, ПараметрДанных, СвойстваРегистраУчета) Экспорт
	
	НовыйКН = Новый КомпоновщикНастроекКомпоновкиДанных(); 
	НовыйКН.ЗагрузитьНастройки(НастрокиКНИсходные);
	ДанныеЭлемента = Новый Структура("Значение, Представление");
	ТекЭлемент = ПараметрДанных.Значение.НайтиПоЗначению(СвойстваРегистраУчета.Объект);
	Если ТекЭлемент <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ДанныеЭлемента, ТекЭлемент);
	КонецЕсли;	
	ЭлементНастройки = НовыйКН.ПользовательскиеНастройки.Элементы.Найти(
		ПараметрДанных.ИдентификаторПользовательскойНастройки);
	Если ЭлементНастройки <> Неопределено Тогда
		ЭлементНастройки.Значение.Очистить();
		ЭлементНастройки.Значение.Добавить(ДанныеЭлемента.Значение, ДанныеЭлемента.Представление);
	КонецЕсли;	
	СвойстваРегистраУчета.Вставить("КомпоновщикНастроекПоОбъекту", НовыйКН);
КонецПроцедуры	 

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Процедура ЗаполнитьСвойстваРегистраУчета(ОтчетОбъект, СвойстваРегистраУчета) Экспорт
	
	СвойстваРегистраУчета.Вставить("НачалоПериода");
	СвойстваРегистраУчета.Вставить("КонецПериода");
	СвойстваРегистраУчета.Вставить("Организация");
	
	НастройкиОтчета = ОтчетОбъект.КомпоновщикНастроек.ПолучитьНастройки();
	
	ПараметрПериод = НастройкиОтчета.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Период"));
	Если ПараметрПериод <> Неопределено И ПараметрПериод.Использование Тогда
		СвойстваРегистраУчета.Вставить("НачалоПериода", ПараметрПериод.Значение.ДатаНачала);
		СвойстваРегистраУчета.Вставить("КонецПериода", ПараметрПериод.Значение.ДатаОкончания);
	КонецЕсли;
	
	Организация = НайтиВОтбореРекурсивно(НастройкиОтчета.Отбор, "Организация");
	
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		ВызватьИсключение "Не задана организация";
	КонецЕсли;
	
	СвойстваРегистраУчета.Вставить("Организация", Организация);
	
	СвойстваРегистраУчета.Вставить("ДополнениеИмени", "");
	
КонецПроцедуры

Функция НайтиВОтбореРекурсивно(Коллекция, ИмяПоля) Экспорт
	
	Для Каждого ЭлементОтбора Из Коллекция.Элементы Цикл
	
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			Значение = НайтиВОтбореРекурсивно(ЭлементОтбора, ИмяПоля);
			Если ЗначениеЗаполнено(Значение) Тогда
				Возврат Значение;
			КонецЕсли;
		Иначе
			Если ЭлементОтбора.Использование
				И ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно
				И ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоля) Тогда
				Возврат ЭлементОтбора.ПравоеЗначение;
			КонецЕсли;
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПроверитьВозможностьСохраненияРезультата(СвойстваРегистраУчета)
	
	Если Не ЗначениеЗаполнено(СвойстваРегистраУчета.ВидРегистра) Тогда
		
		ТекстСообщения = Нстр("ru = 'Для отчета не задан вид регистра в справочнике ""Виды регистров учета"", отчет не сохранен!'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат Ложь;
		
	КонецЕсли;
	
	Если СвойстваРегистраУчета.СостояниеРегистра Тогда
		ТекстСообщения = Нстр("ru = 'Отчет не может быть сохранен'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(СвойстваРегистраУчета.Организация) <> Тип("СправочникСсылка.Организации")
		ИЛИ Не ЗначениеЗаполнено(СвойстваРегистраУчета.Организация) Тогда
		
		ТекстСообщения = Нстр("ru = 'Для отчета не задана Организация, отчет не сохранен!'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат Ложь;
		
	КонецЕсли;
	
	Если СвойстваРегистраУчета.ОтчетНеЗаполнен Тогда
		СообщениеОбОшибке = НСтр("ru='В отчете отсутствуют данные, отчет не сохранен!'");
		ОбщегоНазначения.СообщитьПользователю(СообщениеОбОшибке);
		Возврат Ложь;
	КонецЕсли;
	
	Если СвойстваРегистраУчета.ПроверитьВозможностьСозданияВнутреннегоЭД
		И НЕ ЕстьПодходящиеКомандыПечати(СвойстваРегистраУчета) Тогда
		СообщениеОбОшибке = НСтр("ru='Для создания внутреннего электронного документа необходимо включить использование'")
			+ НСтр("ru=' данного вида регистра учета в настройках внутреннего ЭДО'");
		ОбщегоНазначения.СообщитьПользователю(СообщениеОбОшибке);
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ЕстьРеквизитФормы(Форма, ИмяРеквизита)
	
	Для Каждого РеквизитФормы Из Форма.ПолучитьРеквизиты() Цикл
		Если ВРег(РеквизитФормы.Имя) = ВРег(ИмяРеквизита) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция СформироватьРегистрУчетаИзТабличногоДокумента(ХранилищеТабличногоДокумента, Описание, ФорматСохраненияФайла = Неопределено)
	
	// подготовка временной папки
	ИмяВременнойПапки = ПолучитьИмяВременногоФайла();
	СоздатьКаталог(ИмяВременнойПапки);
	
	ТаблицаФорматов = УправлениеПечатью.НастройкиФорматовСохраненияТабличногоДокумента();
	
	Если ФорматСохраненияФайла = Неопределено Тогда
		ФорматСохраненияФайла = ПолучитьФорматСохраненияРегистров();
	КонецЕсли;
	
	НастройкиФормата = ТаблицаФорматов.НайтиСтроки(Новый Структура("Ссылка", ФорматСохраненияФайла))[0];
	
	ПечатнаяФорма = ПолучитьИзВременногоХранилища(ХранилищеТабличногоДокумента);
	
	Если НЕ ПечатнаяФорма.АвтоМасштаб Тогда
		ПечатнаяФорма.АвтоМасштаб = Истина;
	КонецЕсли;
	
	ПолноеИмяФайла = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ИмяВременнойПапки) 
					+ ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(Описание);
	
	ПечатнаяФорма.Записать(ПолноеИмяФайла, НастройкиФормата.ТипФайлаТабличногоДокумента);
	
	Если НастройкиФормата.ТипФайлаТабличногоДокумента = ТипФайлаТабличногоДокумента.HTML Тогда
		ВставитьКартинкиВHTML(ПолноеИмяФайла);
	КонецЕсли;
	
	ДвоичныеДанные = Новый ДвоичныеДанные(ПолноеИмяФайла);
	ПутьВоВременномХранилище = ПоместитьВоВременноеХранилище(ДвоичныеДанные, Новый УникальныйИдентификатор);
	
	УдалитьФайлы(ИмяВременнойПапки);
	
	Возврат ПутьВоВременномХранилище;
	
КонецФункции

Процедура ВставитьКартинкиВHTML(ИмяФайлаHTML)
	
	ТекстовыйДокумент = Новый ТекстовыйДокумент();
	ТекстовыйДокумент.Прочитать(ИмяФайлаHTML, КодировкаТекста.UTF8);
	ТекстHTML = ТекстовыйДокумент.ПолучитьТекст();
	
	ФайлHTML = Новый Файл(ИмяФайлаHTML);
	
	ИмяПапкиКартинок = ФайлHTML.ИмяБезРасширения + "_files";
	ПутьКПапкеКартинок = СтрЗаменить(ФайлHTML.ПолноеИмя, ФайлHTML.Имя, ИмяПапкиКартинок);
	
	// ожидается, что в папке будут только картинки
	ФайлыКартинок = НайтиФайлы(ПутьКПапкеКартинок, "*");
	
	Для Каждого ФайлКартинки Из ФайлыКартинок Цикл
		КартинкаТекстом = Base64Строка(Новый ДвоичныеДанные(ФайлКартинки.ПолноеИмя));
		КартинкаТекстом = "data:image/" + Сред(ФайлКартинки.Расширение,2) + ";base64," + Символы.ПС + КартинкаТекстом;
		
		ТекстHTML = СтрЗаменить(ТекстHTML, ИмяПапкиКартинок + "\" + ФайлКартинки.Имя, КартинкаТекстом);
	КонецЦикла;
		
	ТекстовыйДокумент.УстановитьТекст(ТекстHTML);
	ТекстовыйДокумент.Записать(ИмяФайлаHTML, КодировкаТекста.UTF8);
	
КонецПроцедуры

Функция ЕстьПодходящиеКомандыПечати(СвойстваРегистраУчета)
	
	ТипУчетногоДокумента = Тип("ДокументСсылка.РегистрУчета");
	Организация = СвойстваРегистраУчета.Организация;
	
	ИдентификаторДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипУчетногоДокумента);
	МетаданныеОбъекта = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(ИдентификаторДокумента);
	
	ОбъектыСоСпециальнымиКомандамиПечати = ВнутреннийЭДОПереопределяемый.ОбъектыСоСпециальнымиКомандамиПечати();
	
	Если ОбъектыСоСпециальнымиКомандамиПечати[ТипУчетногоДокумента] <> Неопределено Тогда
		КомандыПечати = ОбъектыСоСпециальнымиКомандамиПечати[ТипУчетногоДокумента];
	Иначе
		КомандыПечати = ВнутреннийЭДО.КомандыПечатиОбъекта(МетаданныеОбъекта);
	КонецЕсли;
	
	Для Каждого Строка Из ВнутреннийЭДО.ЭлектронныеДокументыИзНастройки(Организация, ИдентификаторДокумента) Цикл
		
		КомандаПечати = ВнутреннийЭДО.КомандаПечатиПоИдентификатору(КомандыПечати, Строка.ИдентификаторКомандыПечати);
		Если КомандаПечати <> Неопределено
			И НЕ ВнутреннийЭДО.КомандаПечатиПодходитПоУсловиям(КомандаПечати, СвойстваРегистраУчета.ВидРегистра) Тогда
			Продолжить;
		КонецЕсли;
		
		Возврат Истина;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

#КонецОбласти