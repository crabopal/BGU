// ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ РАБОТЫ С ОПИСАНИЯМИ ТИПОВ

Функция ПолучитьОписаниеТиповПоТипуЗначения(Значение) Экспорт
	
	МассивТипов = Новый Массив;
	Массивтипов.Добавить(ТипЗнч(Значение));
	
	Возврат Новый ОписаниеТипов(МассивТипов);
	
КонецФункции

// Служебная функция, предназначенная для получения описания типов строки, заданной длины.
// 
// Параметры:
//  ДлинаСтроки - число, длина строки.
//
// Возвращаемое значение:
//  Объект "ОписаниеТипов" для строки указанной длины.
//
Функция ПолучитьОписаниеТиповСтроки(ДлинаСтроки) Экспорт

	Массив = Новый Массив; 
	Массив.Добавить(Тип("Строка"));

	КвалификаторСтроки = Новый КвалификаторыСтроки(ДлинаСтроки, ДопустимаяДлина.Переменная);

	Возврат Новый ОписаниеТипов(Массив, , КвалификаторСтроки);

КонецФункции 

// Служебная функция, предназначенная для получения описания типов числа, заданной разрядности.
// 
// Параметры:
//  Разрядность 			- число, разряд числа.
//  РазрядностьДробнойЧасти - число, разряд дробной части.
//
// Возвращаемое значение:
//  Объект "ОписаниеТипов" для числа указанной разрядности.
//
Функция ПолучитьОписаниеТиповЧисла(Разрядность,РазрядностьДробнойЧасти=0) Экспорт

	Массив = Новый Массив;

	Массив.Добавить(Тип("Число"));
	КвалификаторЧисла = Новый КвалификаторыЧисла(Разрядность,РазрядностьДробнойЧасти);

	Возврат Новый ОписаниеТипов(Массив, КвалификаторЧисла);

КонецФункции  

// Служебная функция, предназначенная для получения описания типов даты
// 
// Параметры:
//  ЧастиДаты - системное перечисление ЧастиДаты.
// 
Функция ПолучитьОписаниеТиповДаты(ЧастиДаты) Экспорт

	Массив = Новый Массив;
	Массив.Добавить(Тип("Дата"));

	КвалификаторДаты = Новый КвалификаторыДаты(ЧастиДаты);

	Возврат Новый ОписаниеТипов(Массив, , , КвалификаторДаты);

КонецФункции  

// Предназначена для получения пустого значения заданного типа:
//	примитивного, или ссылочного. Используется
//
// Параметры:
//	ЗаданныйТип   - тип, пустое значение которого нужно получить
//
Функция ПустоеЗначениеТипа(ЗаданныйТип) Экспорт

	Если ЗаданныйТип = Тип("Число") Тогда
		Возврат 0;

	ИначеЕсли ЗаданныйТип = Тип("Строка") Тогда
		Возврат "";

	ИначеЕсли ЗаданныйТип = Тип("Дата") Тогда
		Возврат '00010101000000';

	ИначеЕсли ЗаданныйТип = Тип("Булево") Тогда
		Возврат Ложь;

	Иначе
		Возврат Новый (ЗаданныйТип);

	КонецЕсли;

КонецФункции 

Функция ПолучитьДопустимыеРеквизитыАналитикиПоТипу(ТипЗначенияАналитики) Экспорт
	СоответствиеДопустимыхРеквизитов = БюджетнаяОтчетностьСерверПовтИсп.ПолучитьРеквизитыАналитикиОперандов();
	
	МассивРеквизитов = СоответствиеДопустимыхРеквизитов[ТипЗначенияАналитики];
	
	Возврат МассивРеквизитов;

КонецФункции

// Функция - ПолучитьОписаниеТиповБК
//
// Параметры
// Аналитика - ПланВидовХарактеристик.АналитикаОтчетов - Аналитика отчета
// РеквизитыАналитики - Структура с параметрами "ТипЗначения, ВидКлассификатораБК" - Необязательный
//
// Возвращаемое значение:
// ОписаниеТипов - Описание типов, соответствующих аналитике бюджетной классификации
Функция ПолучитьОписаниеТиповБК(Аналитика, РеквизитыАналитики=Неопределено)Экспорт
	
	Если РеквизитыАналитики = Неопределено Тогда
		Возврат БюджетнаяОтчетностьПовтИсп.ПолучитьОписаниеТиповБК(Аналитика);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(РеквизитыАналитики.ВидКлассификатораБК) Тогда
		Результат = РеквизитыАналитики.ТипЗначения;
	Иначе
		Если РеквизитыАналитики.ВидКлассификатораБК = Перечисления.ВидыКлассификаторовОтчетов.АналитическиеКодыКПС Тогда
			Результат = Новый ОписаниеТипов("СправочникСсылка.АналитическиеКодыКПС");
		ИначеЕсли РеквизитыАналитики.ВидКлассификатораБК = Перечисления.ВидыКлассификаторовОтчетов.ВидыДоходовКДБ Тогда
			Результат = Новый ОписаниеТипов("СправочникСсылка.ВидыДоходовКДБ");
		ИначеЕсли РеквизитыАналитики.ВидКлассификатораБК = Перечисления.ВидыКлассификаторовОтчетов.ВидыКИФ Тогда
			Результат = Новый ОписаниеТипов("СправочникСсылка.ВидыКИФ");
		ИначеЕсли РеквизитыАналитики.ВидКлассификатораБК = Перечисления.ВидыКлассификаторовОтчетов.ВидыРасходовКРБ Тогда
			Результат = Новый ОписаниеТипов("СправочникСсылка.ВидыРасходовКРБ");
		ИначеЕсли РеквизитыАналитики.ВидКлассификатораБК = Перечисления.ВидыКлассификаторовОтчетов.ГлавыПоБюджетнойКлассификации Тогда
			Результат = Новый ОписаниеТипов("СправочникСсылка.ГлавыПоБюджетнойКлассификации");
		ИначеЕсли РеквизитыАналитики.ВидКлассификатораБК = Перечисления.ВидыКлассификаторовОтчетов.ГруппыПодвидовКДБ Тогда
			Результат = Новый ОписаниеТипов("СправочникСсылка.ГруппыПодвидовКДБ");
		ИначеЕсли РеквизитыАналитики.ВидКлассификатораБК = Перечисления.ВидыКлассификаторовОтчетов.ГруппыПодгруппыКИФ Тогда
			Результат = Новый ОписаниеТипов("СправочникСсылка.ГруппыПодгруппыКИФ");
		ИначеЕсли РеквизитыАналитики.ВидКлассификатораБК = Перечисления.ВидыКлассификаторовОтчетов.КОСГУ Тогда
			Результат = Новый ОписаниеТипов("СправочникСсылка.КОСГУ");
		ИначеЕсли РеквизитыАналитики.ВидКлассификатораБК = Перечисления.ВидыКлассификаторовОтчетов.КОСГУ_ВидыРасходовКРБ Тогда
			Результат = Новый ОписаниеТипов("СправочникСсылка.ВидыРасходовКРБ,СправочникСсылка.КОСГУ");
		ИначеЕсли РеквизитыАналитики.ВидКлассификатораБК = Перечисления.ВидыКлассификаторовОтчетов.ПрограммыЦелевыхСтатейКРБ Тогда
			Результат = Новый ОписаниеТипов("СправочникСсылка.ПрограммыЦелевыхСтатейКРБ");
		ИначеЕсли РеквизитыАналитики.ВидКлассификатораБК = Перечисления.ВидыКлассификаторовОтчетов.РазделыПодразделыКРБ Тогда
			Результат = Новый ОписаниеТипов("СправочникСсылка.РазделыПодразделыКРБ");
		ИначеЕсли РеквизитыАналитики.ВидКлассификатораБК = Перечисления.ВидыКлассификаторовОтчетов.СтатьиКИФ Тогда
			Результат = Новый ОписаниеТипов("СправочникСсылка.СтатьиКИФ");
		ИначеЕсли РеквизитыАналитики.ВидКлассификатораБК = Перечисления.ВидыКлассификаторовОтчетов.ЦелевыеСтатьиКРБ Тогда
			Результат = Новый ОписаниеТипов("СправочникСсылка.ЦелевыеСтатьиКРБ");
		Иначе
			ТекстСообщения = Нстр("ru='В виде аналитики %1 указан не корректный вид классификатора БК'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,Строка(Аналитика));
			ВызватьИсключение ТекстСообщения;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьВидыАналитикиСТипомСтрока() Экспорт
	
	СоответствиеАналитики = Новый Соответствие;
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	АналитикаОтчетов.Ссылка
	               |ИЗ
	               |	ПланВидовХарактеристик.АналитикаОтчетов КАК АналитикаОтчетов
	               |ГДЕ
	               |	АналитикаОтчетов.ВидКлассификатораБК <> ЗНАЧЕНИЕ(Перечисление.ВидыКлассификаторовОтчетов.ПустаяСсылка)";
	Запрос.Текст = ТекстЗапроса;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СоответствиеАналитики.Вставить(Выборка.Ссылка,Истина);
	КонецЦикла;
	
	Возврат СоответствиеАналитики;
	
КонецФункции

