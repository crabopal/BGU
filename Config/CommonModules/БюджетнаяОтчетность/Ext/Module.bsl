// Получает соответствие видов аналитики и их кодов.
//
// Параметры
//  ВидыАналитики - Массив видов аналитики
//
// Возвращаемое значение:
//   Соответствие - Вид аналитики -> код вида аналитики
//
Функция КодыВидовАналитики(ВидыАналитики) Экспорт
 
	Запрос 		 = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	АналитикаОтчетов.Ссылка,
	|	АналитикаОтчетов.Код
	|ИЗ
	|	ПланВидовХарактеристик.АналитикаОтчетов КАК АналитикаОтчетов
	|ГДЕ
	|	АналитикаОтчетов.Ссылка В(&ВидыАналитики)";
	
	Запрос.УстановитьПараметр("ВидыАналитики",ВидыАналитики);
	
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Ссылка,СокрП(Выборка.Код));
	КонецЦикла;

	Возврат Результат;
	
КонецФункции // КодыВидовАналитики()

// Возвращает признак того, что переданная в качестве параметра строка
// может быть использована в качестве кода объекта.
//
Функция СтрокаМожетИспользоватьсяВКачествеКода(Знач Стр) Экспорт
	
	Если ПустаяСтрока(Стр) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Стр = ВРЕГ(СокрЛП(Стр));
	
	РусАнглАлфавит = "АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯABCDEFGHIJKLMNOPQRSTUVWXYZ";
	РусАнглАлфавитИВспомогательныеСимволы = "АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯABCDEFGHIJKLMNOPQRSTUVWXYZ_0123456789";
	
	Если Найти(РусАнглАлфавит, Сред(Стр, 1, 1)) = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Инд = 2 По СтрДлина(Стр) Цикл
		Если Найти(РусАнглАлфавитИВспомогательныеСимволы, Сред(Стр, Инд, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

// Возвращает объект типа ОписаниеТипов, соответствующий указанному значению 
// типа ПеречислениеСсылка.ТипыЗначенийПоказателейОтчетов.
//
Функция ПолучитьОписаниеТиповДляЗначенияПоказателя(ТипЗначения) Экспорт
	
	Если ТипЗначения = Перечисления.ТипыЗначенийПоказателейОтчетов.Число Тогда
		Возврат ОписаниеТиповЧисловогоЗначенияПоказателя();
	ИначеЕсли ТипЗначения = Перечисления.ТипыЗначенийПоказателейОтчетов.Строка Тогда
		Возврат (Новый ОписаниеТипов("Строка"));
	ИначеЕсли ТипЗначения = Перечисления.ТипыЗначенийПоказателейОтчетов.Дата Тогда
		Возврат (Новый ОписаниеТипов("Дата"));
	Иначе
		Возврат (Новый ОписаниеТипов("Булево"));
	КонецЕсли;
	
КонецФункции

// Возвращает строковое представление экземпляра отчета
//
// Параметры
//  Отчет		 - ДокументСсылка - отчет для которого необходимо получить представление
//
//  ЕстьОрганизация - признак добавления в строку информации об организации
//  ЕстьПериод		- признак добавления в строку информации о периоде отчета
//  ВидОтчетаКратко - признак вывода только кода ОКУД отчета.
//
// Возвращаемое значение:
//   Строка
//
Функция ПолучитьПредставлениеЭкземпляраОтчета(Отчет,ЕстьОрганизация = Истина, ЕстьПериод = Истина, ВидОтчетаКратко = Истина) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВидыОтчетов.Наименование,
	|	ВидыОтчетов.КодФормыПоКлассификатору
	|ИЗ
	|	Справочник.ВидыОтчетов КАК ВидыОтчетов
	|ГДЕ
	|	ВидыОтчетов.Ссылка = &ВидОтчета";
	
	Запрос.УстановитьПараметр("ВидОтчета",Отчет.ВидОтчета);
	
	Если ЕстьОрганизация Тогда
		Запрос.Текст = Запрос.Текст + "
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Организации.Наименование,
		|	NULL
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	Организации.Ссылка = &Организация";
		
		Запрос.УстановитьПараметр("Организация",Отчет.Организация);
	КонецЕсли;
	
	Если ЕстьПериод Тогда
		Запрос.Текст = Запрос.Текст + "
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Периоды.Наименование,
		|	NULL
		|ИЗ
		|	Справочник.Периоды КАК Периоды
		|ГДЕ
		|	Периоды.Ссылка = &Период";
		Запрос.УстановитьПараметр("Период",Отчет.ПериодОтчета);
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	ИсходныйТекст = "Отчет "+?(ВидОтчетаКратко,"Ф. "+Выборка.КодФормыПоКлассификатору,Выборка.Наименование)
					+ ", №" + Отчет.Номер;
					
	Если ЕстьОрганизация Тогда
		Выборка.Следующий();
		ИсходныйТекст = ИсходныйТекст + ", Учреждение: " + Выборка.Наименование;
	КонецЕсли;
	
	Если ЕстьПериод Тогда
		Выборка.Следующий();
		ИсходныйТекст = ИсходныйТекст + ", Период отчета: " + Выборка.Наименование;
	КонецЕсли;
	
	Возврат ИсходныйТекст;
	
КонецФункции // ПолучитьПредставлениеЭкземпляраОтчета()

// Возвращает строковое представление вида контактной информации объекта
//
// Параметры
//  Объект		 - Ссылка на элемент справочника, чью контактную информацию нужно определить
//  ИмяВидаКИ	 - Имя предопределенного элемента справочника ВидыКонтактнойИнформации
//  ИмяТипаКИ	 - Имя значениея перечисления ТипыКонтактнойИнформации
//
// Возвращаемое значение:
//   Строка
// 
Функция ПолучитьПредставлениеКонтактнойИнформации(Знач Объект,Знач ИмяВидаКИ,Знач ИмяТипаКИ)Экспорт
	
	Попытка

		ВидКИ = ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации."+ИмяВидаКИ);
		ТипКИ = ПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации."+ИмяТипаКИ);
	Исключение
		Возврат "";
	КонецПопытки;

	Запрос = Новый Запрос;
	

	Если ТипЗнч(Объект) = Тип("СправочникСсылка.Контрагенты") Тогда
		ТекОбъект = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект,"ЮридическоеФизическоеЛицо");
		Если НЕ ЗначениеЗаполнено(ТекОбъект) Тогда
			ТекОбъект = Объект;	
		КонецЕсли;
	Иначе
		ТекОбъект = Объект;
	КонецЕсли;
	ИмяСпр = ТекОбъект.Метаданные().Имя;
	
	Запрос.Текст = 
		"ВЫБРАТЬ Первые 1
		|	МойСпрКонтактнаяИнформация.Представление
		|ИЗ
		|	Справочник."+ИмяСпр+".КонтактнаяИнформация КАК МойСпрКонтактнаяИнформация
		|ГДЕ
		|	МойСпрКонтактнаяИнформация.Тип = &Тип
		|	И МойСпрКонтактнаяИнформация.Вид = &Вид
		|	И МойСпрКонтактнаяИнформация.Ссылка = &Объект";
			

	Запрос.УстановитьПараметр("Объект",ТекОбъект);
	Запрос.УстановитьПараметр("Тип",ТипКИ);
	Запрос.УстановитьПараметр("Вид",ВидКИ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат СокрЛП(ВыборкаДетальныеЗаписи.Представление); 	
	КонецЕсли;
	
	Возврат "";
КонецФункции

Функция ПолучитьМассивНаследуемыхПравил(ВидОтчета,ПравилоПроверки) Экспорт
	
	Если Не ЗначениеЗаполнено(ПравилоПроверки) Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(ПравилаПроверки.Ссылка) КАК КоличествоПравил
		|ИЗ
		|	Справочник.ПравилаПроверки КАК ПравилаПроверки
		|ГДЕ
		|	ПравилаПроверки.Владелец = &Владелец";
	
	Запрос.УстановитьПараметр("Владелец", ВидОтчета);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	КоличествоПравилВидаОтчета = 1;
	Если Выборка.Следующий() Тогда
		КоличествоПравилВидаОтчета = Выборка.КоличествоПравил;
	КонецЕсли;
	
	Если КоличествоПравилВидаОтчета = 1 Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	МаксимальнаяДлинаПути = КоличествоПравилВидаОтчета;
	
	Пролог = "ВЫБРАТЬ
	         |	Т1.Ссылка КАК НачалоДуги,
	         |	Т1.ПравилоПроверки КАК КонецДуги
	         |ПОМЕСТИТЬ ЗамыканияДлины1
	         |ИЗ
	         |	Справочник.ПравилаПроверки.БазовыеПравилаПроверки КАК Т1
	         |ГДЕ
	         |	Т1.Ссылка.Владелец = &Владелец
	         |
	         |ОБЪЕДИНИТЬ
	         |
	         |ВЫБРАТЬ
	         |	Т2.Ссылка,
	         |	Т2.Ссылка
	         |ИЗ
	         |	Справочник.ПравилаПроверки КАК Т2
	         |ГДЕ
	         |	Т2.Ссылка.Владелец = &Владелец;
			 |";

    Рефрен = "ВЫБРАТЬ РАЗЛИЧНЫЕ
             |	ПерваяДуга.НачалоДуги,
             |	ВтораяДуга.КонецДуги
             |ПОМЕСТИТЬ ЗамыканияДлины#2
             |ИЗ
             |	ЗамыканияДлины#1 КАК ПерваяДуга
             |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ЗамыканияДлины#1 КАК ВтораяДуга
             |		ПО ПерваяДуга.КонецДуги = ВтораяДуга.НачалоДуги
             |;
             |
             |////////////////////////////////////////////////////////////////////////////////
             |УНИЧТОЖИТЬ ЗамыканияДлины#1;
			 |";

    Эпилог = "ВЫБРАТЬ
             |	Результаты.НачалоДуги КАК Предок,
             |	Результаты.КонецДуги КАК Потомок
             |ИЗ
             |	ЗамыканияДлины#2 КАК Результаты
             |ГДЕ
             |	Результаты.НачалоДуги <> Результаты.КонецДуги
			 |	И Результаты.НачалоДуги = &ПравилоПроверки";
	
    Запрос = Новый Запрос(Пролог);
	Запрос.УстановитьПараметр("Владелец",ВидОтчета);
	Запрос.УстановитьПараметр("ПравилоПроверки",ПравилоПроверки);
	
    МаксимальнаяДлинаЗамыканий = 1;

    Пока МаксимальнаяДлинаЗамыканий < МаксимальнаяДлинаПути Цикл

        Запрос.Текст = Запрос.Текст + СтрЗаменить(СтрЗаменить(Рефрен, "#1", Формат(МаксимальнаяДлинаЗамыканий, "ЧГ=0")), "#2", Формат(2 * МаксимальнаяДлинаЗамыканий, "ЧГ=0"));

        МаксимальнаяДлинаЗамыканий = 2 * МаксимальнаяДлинаЗамыканий

    КонецЦикла;

    Запрос.Текст = Запрос.Текст + СтрЗаменить(Эпилог, "#2", Формат(МаксимальнаяДлинаЗамыканий, "ЧГ=0"));
	
	УстановитьПривилегированныйРежим(Истина);
	Результат = Запрос.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	МассивНаследуемыхПравил = Результат.ВыгрузитьКолонку("Потомок");
	
	Возврат МассивНаследуемыхПравил;	
	
КонецФункции

Функция ПолучитьТаблицуНаследуемыхПравил(ВидОтчета) Экспорт
	
	Если Не ЗначениеЗаполнено(ВидОтчета) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(ПравилаПроверки.Ссылка) КАК КоличествоПравил
		|ИЗ
		|	Справочник.ПравилаПроверки КАК ПравилаПроверки
		|ГДЕ
		|	ПравилаПроверки.Владелец = &Владелец";
	
	Запрос.УстановитьПараметр("Владелец", ВидОтчета);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	КоличествоПравилВидаОтчета = 1;
	Если Выборка.Следующий() Тогда
		КоличествоПравилВидаОтчета = Выборка.КоличествоПравил;
	КонецЕсли;
	
	Если КоличествоПравилВидаОтчета <= 1 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	МаксимальнаяДлинаПути = КоличествоПравилВидаОтчета;
	
	Пролог = "ВЫБРАТЬ
	         |	Т1.Ссылка КАК НачалоДуги,
	         |	Т1.ПравилоПроверки КАК КонецДуги
	         |ПОМЕСТИТЬ ЗамыканияДлины1
	         |ИЗ
	         |	Справочник.ПравилаПроверки.БазовыеПравилаПроверки КАК Т1
	         |ГДЕ
	         |	Т1.Ссылка.Владелец = &Владелец
	         |
	         |ОБЪЕДИНИТЬ
	         |
	         |ВЫБРАТЬ
	         |	Т2.Ссылка,
	         |	Т2.Ссылка
	         |ИЗ
	         |	Справочник.ПравилаПроверки КАК Т2
	         |ГДЕ
	         |	Т2.Ссылка.Владелец = &Владелец;
			 |";

    Рефрен = "ВЫБРАТЬ РАЗЛИЧНЫЕ
             |	ПерваяДуга.НачалоДуги,
             |	ВтораяДуга.КонецДуги
             |ПОМЕСТИТЬ ЗамыканияДлины#2
             |ИЗ
             |	ЗамыканияДлины#1 КАК ПерваяДуга
             |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ЗамыканияДлины#1 КАК ВтораяДуга
             |		ПО ПерваяДуга.КонецДуги = ВтораяДуга.НачалоДуги
             |;
             |
             |////////////////////////////////////////////////////////////////////////////////
             |УНИЧТОЖИТЬ ЗамыканияДлины#1;
			 |";

    Эпилог = "ВЫБРАТЬ
             |	Результаты.НачалоДуги КАК Предок,
             |	Результаты.КонецДуги КАК Потомок
             |ИЗ
             |	ЗамыканияДлины#2 КАК Результаты
             |ГДЕ
             |	Результаты.НачалоДуги <> Результаты.КонецДуги";
	
    Запрос = Новый Запрос(Пролог);
	Запрос.УстановитьПараметр("Владелец",ВидОтчета);
	
    МаксимальнаяДлинаЗамыканий = 1;

    Пока МаксимальнаяДлинаЗамыканий < МаксимальнаяДлинаПути Цикл

        Запрос.Текст = Запрос.Текст + СтрЗаменить(СтрЗаменить(Рефрен, "#1", Формат(МаксимальнаяДлинаЗамыканий, "ЧГ=0")), "#2", Формат(2 * МаксимальнаяДлинаЗамыканий, "ЧГ=0"));

        МаксимальнаяДлинаЗамыканий = 2 * МаксимальнаяДлинаЗамыканий

    КонецЦикла;

    Запрос.Текст = Запрос.Текст + СтрЗаменить(Эпилог, "#2", Формат(МаксимальнаяДлинаЗамыканий, "ЧГ=0"));
	
	УстановитьПривилегированныйРежим(Истина);
	Результат = Запрос.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;	
	
КонецФункции

