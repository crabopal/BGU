Функция ПолучитьБлижайшиеПользовательскиеНастройки(ВидОтчета, ПериодОтчета, Организация)
	
	МассивОрганизаций = Новый Массив;
	МассивОрганизаций.Добавить(Справочники.Организации.ПустаяСсылка());
	Если ЗначениеЗаполнено(Организация) Тогда 
		МассивОрганизаций.Добавить(Организация);
	КонецЕсли;
	
	МассивПериодичностей = Новый Массив;
	МассивПериодичностей.Добавить(БюджетнаяОтчетностьСервер.ПолучитьМенеджерПериодичность().ПустаяСсылка());
	Если ЗначениеЗаполнено(ПериодОтчета) И ТипЗнч(ПериодОтчета) = Тип("СправочникСсылка.Периоды") И Не ПериодОтчета.Произвольный Тогда
		МассивПериодичностей.Добавить(ПериодОтчета.Периодичность);
	КонецЕсли;
	
	СтруктураНастроек = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидОтчета", ВидОтчета);
	Запрос.УстановитьПараметр("Организации", МассивОрганизаций);
	Запрос.УстановитьПараметр("Периодичности", МассивПериодичностей);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ИспользуемыеНастройкиОтчетов.Организация КАК Организация,
	|	ИспользуемыеНастройкиОтчетов.Редакция.ДатаДействия КАК ДатаДействия,
	|	ИспользуемыеНастройкиОтчетов.БланкДляОтображения,
	|	ИспользуемыеНастройкиОтчетов.БланкДляПечати,
	|	ИспользуемыеНастройкиОтчетов.ПравилоОбработки,
	|	ИспользуемыеНастройкиОтчетов.ПравилоПроверки
	|ИЗ
	|	РегистрСведений.ИспользуемыеНастройкиОтчетов КАК ИспользуемыеНастройкиОтчетов
	|ГДЕ
	|	ИспользуемыеНастройкиОтчетов.ВидОтчета = &ВидОтчета
	|	И ИспользуемыеНастройкиОтчетов.Организация В(&Организации)
	|	И ИспользуемыеНастройкиОтчетов.Периодичность В(&Периодичности)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаДействия,
	|	Организация УБЫВ,
	|	ИспользуемыеНастройкиОтчетов.Периодичность УБЫВ";
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		СтруктураНастроек = Новый Структура("Источник,БланкДляОтображения,БланкДляПечати,ПравилоОбработки,ПравилоПроверки","БлижайшиеПользовательскиеНастройки");
		ЗаполнитьЗначенияСвойств(СтруктураНастроек,Выборка);
	КонецЕсли;
	
	Возврат СтруктураНастроек;
	
КонецФункции

