	МассивЦветов.Добавить("Maroon");
	МассивЦветов.Добавить("DarkSlateGray");
	МассивЦветов.Добавить("DarkSlateBlue");
	МассивЦветов.Добавить("DarkGoldenRod");
	
	Возврат МассивЦветов;
	
КонецФункции

