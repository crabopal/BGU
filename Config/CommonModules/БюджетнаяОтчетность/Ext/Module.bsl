// ПРОЦЕДУРЫ И ФУНКЦИИ ДЛЯ ОБРАБОТКИ ПРОЦЕДУР ЗАПОЛНЕНИЯ И ВЫЧИСЛЕНИЯ ПОКАЗАТЕЛЕЙ ОТЧЕТОВ

// Возвращает значение актуальности настроек правила обработки.
//
Функция ДанныеПараметрическойНастройкиАктуальны(ПравилоОбработки) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИСТИНА КАК Актуальность
	|ИЗ
	|	РегистрСведений.ХранилищеПараметрическойНастройки КАК ХранилищеПараметрическойНастройки
	|ГДЕ
	|	ХранилищеПараметрическойНастройки.ПравилоОбработки = &ПравилоОбработки";
	
	Запрос.УстановитьПараметр("ПравилоОбработки",ПравилоОбработки);
	
	Если Не Запрос.Выполнить().Пустой() Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;

КонецФункции // ДанныеПараметрическойНастройкиАктуальны()

// Значение параметрических настроек правила обработки.
//
Функция ПолучитьДанныеПараметрическойНастройки(ПравилоОбработки) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ХранилищеПараметрическойНастройки.ДанныеПараметрическойНастройки
	|ИЗ
	|	РегистрСведений.ХранилищеПараметрическойНастройки КАК ХранилищеПараметрическойНастройки
	|ГДЕ
	|	ХранилищеПараметрическойНастройки.ПравилоОбработки = &ПравилоОбработки";
	
	Запрос.УстановитьПараметр("ПравилоОбработки",ПравилоОбработки);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ДанныеПараметрическойНастройки.Получить();
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции // ПолучитьДанныеПараметрическойНастройки()

// Записывает/Очищает данные в хранилище настройки.
//
// Параметры
//  ПравилоОбработки  - правило-владелец настройки.
//
//  ДанныеПараметрики - данные настройки. Если Данные = Неопределено,
//                 		то существующие данные удаляются.
//
Процедура ЗаписатьДанныеПараметрическойНастройки(ПравилоОбработки, ДанныеПараметрики) Экспорт
	
	Если ВыполняетсяЗагрузкаКомплекта() Тогда
		СообщениеПриЗагрузкеКомплекта();
		Возврат;
	КонецЕсли;
	
	НаборЗаписейРегистра = РегистрыСведений.ХранилищеПараметрическойНастройки.СоздатьНаборЗаписей();
	НаборЗаписейРегистра.Отбор.ПравилоОбработки.Установить(ПравилоОбработки);
	
	Если Не ДанныеПараметрики = Неопределено Тогда
		
		Запись = НаборЗаписейРегистра.Добавить();
		Запись.ПравилоОбработки 				= ПравилоОбработки;
		Запись.ДанныеПараметрическойНастройки   = Новый ХранилищеЗначения(ДанныеПараметрики);
		
	КонецЕсли;
	
	НаборЗаписейРегистра.Записать();

КонецПроцедуры // УдалитьДанныеПараметрическойНастройки()

// Функция создает запрос для параметрической настройки отбора при расчете
// контрольных соотношений и при параметрическом заполнении отчета.
//
// Параметры:
//  ПоказательОтбор - показатель, к значениям которого выполняется запрос
//
//  РаскрыватьПоАналитике - Флаг присутствия в запросе полей "Аналитика1-АналитикаN".
//							При наличии этих полей в запросе суммы значений показателей будут
//							представлены в разрезе значений аналитики.
//
// Возвращаемое значение:
//  Запрос - запрос содержащий сформированный текст и необходимые параметры
//
Функция СоздатьЗапросПараметрическойНастройки(ПоказательОтбор, РаскрыватьПоАналитике = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	
	локВидОтчета = ПоказательОтбор.Владелец;
	
	// Отбор доп. реквизитов.
	
	ТабРеквизитов = БюджетнаяОтчетность.ЗаполнитьВидыАналитикОтчета(локВидОтчета);
	
	ОтборДопРеквизитов = БюджетнаяОтчетность.ПолучитьТаблицуНастроекОтбора();
	БюджетнаяОтчетность.ДобавитьОтборПоРеквизиту(ОтборДопРеквизитов,"ВидОтчета",локВидОтчета);
	
	Для Каждого ДопРеквизит Из ТабРеквизитов Цикл 
		БюджетнаяОтчетность.ДобавитьОтборПоРеквизиту(ОтборДопРеквизитов,СокрП(Сред(ДопРеквизит.КодАналитики,10)),Неопределено);
	КонецЦикла;
	
	ТекстДопРеквизиты = БюджетнаяОтчетность.ПодготовитьЗапросПоДопРеквизитам(ОтборДопРеквизитов, Запрос, ТабРеквизитов, Истина, Ложь);
	
	// Отбор аналитики
	ОтборАналитики = БюджетнаяОтчетность.ПолучитьТаблицуНастроекОтбора();
	
	ЧислоАналитик = БюджетнаяОтчетность.ЧислоДопАналитик(локВидОтчета,ПоказательОтбор.ГруппаРаскрытия);
	
	Для Сч = 1 По ЧислоАналитик Цикл 
		БюджетнаяОтчетность.ДобавитьОтборПоРеквизиту(ОтборАналитики,"Аналитика"+Сч,Неопределено);
	КонецЦикла;

	ТекстАналитика = БюджетнаяОтчетность.ПодготовитьЗапросПоказателейСАналитикой(ПоказательОтбор, ОтборАналитики, Запрос, Ложь, Ложь, Ложь);
	
	Если РаскрыватьПоАналитике Тогда
		ОтборАналитики.Очистить();
		ТекстЗначения  = БюджетнаяОтчетность.ПодготовитьЗапросПоказателейСАналитикой(ПоказательОтбор, ОтборАналитики, Запрос, Ложь, Ложь);
	КонецЕсли;
	
	// Формирование итогового запроса.
	ТекстЗапроса = 
	ТекстДопРеквизиты + "
	|{ГДЕ
	|	УниверсальныйРегламентированныйОтчет.Организация.*,
	|	УниверсальныйРегламентированныйОтчет.ПериодОтчета.*";
	Для Каждого ДопРеквизит Из ТабРеквизитов Цикл
		
		КодАналитики = СокрП(Сред(ДопРеквизит.КодАналитики,10));
		
		ТекстЗапроса = ТекстЗапроса + ",
		|	ВЫРАЗИТЬ(Значения"+КодАналитики+".Значение КАК " + ДопРеквизит.ТаблицаАналитики + ") КАК " + КодАналитики;
		
	КонецЦикла;                     
	ТекстЗапроса = ТекстЗапроса + "}
	|
	|;
	|";
	
	ТекстЗапроса = ТекстЗапроса + "	
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаДопРеквизитов.ЭкземплярОтчета КАК ЭкземплярОтчета,
	|	ЗначенияАналитики.ЗначениеЧисло 	 КАК Значение,
	|	ЗначенияАналитики.ИтогПоПоказателю КАК ИтогПоПоказателю,
	|	ЗначенияАналитики.ПромежуточныйИтог КАК ПромежуточныйИтог";
	
	Если РаскрыватьПоАналитике Тогда
		
		ТекстПолей 			= "";
		ТекстNULL			= "";
		Для Сч = 1 По ЧислоАналитик Цикл
			
			ТекстПолей = ТекстПолей+",
			|	ЗначенияАналитики.Аналитика"+Сч;
			
			ТекстNULL = ТекстNULL + ",
			|	Неопределено";
			
		КонецЦикла;
		
		ТекстЗапроса = ТекстЗапроса + ТекстПолей;
		
	КонецЕсли;	
	
	ТекстЗапроса = ТекстЗапроса + "	
	|ИЗ
	|	ТаблицаДопРеквизитов КАК ТаблицаДопРеквизитов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ("+ТекстАналитика+") КАК ЗначенияАналитики
	|		ПО ТаблицаДопРеквизитов.ЭкземплярОтчета = ЗначенияАналитики.ЭкземплярОтчета";

	
	Если ЧислоАналитик > 0 Тогда 
		
		МассивОтборов = Новый Массив;
		Для Сч = 1 По ЧислоАналитик Цикл
			МассивОтборов.Добавить(Символы.ПС+"ЗначенияАналитики.Аналитика"+Сч+".*"); 
		КонецЦикла;
		
		ТекстЗапроса = ТекстЗапроса + "
		|{ГДЕ " + СтрСоединить(МассивОтборов, ",") + "}";
	КонецЕсли;
	
	// Значения итоговых показателей
	Если РаскрыватьПоАналитике Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ТаблицаДопРеквизитов.ЭкземплярОтчета КАК ЭкземплярОтчета,
		|	ЗначенияИтогов.ЗначениеЧисло 	 КАК Значение,
		|	ЗначенияИтогов.ИтогПоПоказателю КАК ИтогПоПоказателю,
		|	ЗначенияИтогов.ПромежуточныйИтог КАК ПромежуточныйИтог" + ТекстNULL + "
		|ИЗ
		|	ТаблицаДопРеквизитов КАК ТаблицаДопРеквизитов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ("+ТекстЗначения+") КАК ЗначенияИтогов
		|		ПО ТаблицаДопРеквизитов.ЭкземплярОтчета = ЗначенияИтогов.ЭкземплярОтчета";
		
	КонецЕсли;
	
	// Формируем структуру для возможной сериализации запроса
	
	СтруктураЗапрос = Новый Структура("Текст,Параметры");
	
	СтруктураЗапрос.Текст 	  = ТекстЗапроса;
	СтруктураЗапрос.Параметры = ОбщегоНазначенияКлиентСервер.СкопироватьРекурсивно(Запрос.Параметры);
	
	Возврат СтруктураЗапрос;
	
КонецФункции

// Выполняет разбор формулы контрольного соотношения на левую и правую части,
//  формирует список операндов формулы, используемых в каждой из частей.
//
Процедура РазобратьКонтрольноеСоотношение(СтрокаСоотношение) Экспорт
	
	КонецЛевойЧасти=0;
	НачалоПравойЧасти=0;
	Условие="";
	
	ИсходныйТекст=СтрокаСоотношение.Процедура;
	
	СписокУсловий=Новый Массив;
	СписокУсловий.Добавить("<");
	СписокУсловий.Добавить(">");
	СписокУсловий.Добавить("=");
	
	ОткрытыхСкобок=0;
	ЕстьУсловие=Ложь;
	ДлинаТекста=СтрДлина(ИсходныйТекст);
	
	Для КодСимв=1 По ДлинаТекста Цикл
		
		ТекСимв=Сред(ИсходныйТекст,КодСимв,1);
		
		Если ТекСимв=" " Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		Если ТекСимв="(" ИЛИ ТекСимв="[" Тогда
			ОткрытыхСкобок=ОткрытыхСкобок+1;
		ИначеЕсли ТекСимв=")" ИЛИ ТекСимв="]" Тогда
			ОткрытыхСкобок=ОткрытыхСкобок-1;
		КонецЕсли;
		
		Если ЕстьУсловие Тогда
			
			Если СписокУсловий.Найти(ТекСимв)=Неопределено Тогда
				
				НачалоПравойЧасти=КодСимв;
				
				Прервать;
				
			Иначе
				
				Условие=Условие+ТекСимв;
				
			КонецЕсли;
			
		ИначеЕсли (Не СписокУсловий.Найти(ТекСимв)=Неопределено) И ОткрытыхСкобок=0 Тогда
			
			ЕстьУсловие=Истина;
			КонецЛевойЧасти=КодСимв-1;
			Условие=Условие+ТекСимв;
			
		КонецЕсли;
		
	КонецЦикла;
	
	СтрокаСоотношение.ВыражениеЛев			 = Лев(ИсходныйТекст,КонецЛевойЧасти);
	СтрокаСоотношение.ВыражениеПрав			 = Сред(ИсходныйТекст,НачалоПравойЧасти);
	СтрокаСоотношение.СписокИспользуемыхЛев	 = РазобратьОперанды(СтрокаСоотношение.ВыражениеЛев);
	СтрокаСоотношение.СписокИспользуемыхПрав = РазобратьОперанды(СтрокаСоотношение.ВыражениеПрав);
	
	СтрокаСоотношение.Условие=Условие;
	
КонецПроцедуры // РазобратьКонтрольноеСоотношение()

// Возвращает список кодов операндов, использованных в формуле расчета показателя 
// и формирует строку для проверки на синтаксическую правильность формулы.
//
// Параметры
//  ТекстФормула   - Строка, текст формулы процедуры расчета.
//  ТекстДляПроверки - Строка, переменная в которую помещается строка для проверки.
// Возвращаемое значение
//  СписокЗначений - список операндов, найденных в формуле.
//
Функция РазобратьОперанды(ТекстФормула, ТекстДляПроверки = Неопределено, ЕстьАбсолютныеЗначения=Ложь) Экспорт
	
	СписокКодов=Новый СписокЗначений;
	
	ТекстБезОперандовМассив = Новый Массив;
	
	Инд = 1;
	ПозицияКонца = 0;
	
	ДлинаТекста = СтрДлина(ТекстФормула);
	
	ПозицияНачала = СтрНайти(ТекстФормула,"[",,,Инд);
	Пока ПозицияНачала>0 Цикл
		Если ПозицияКонца = 0 Тогда
			ТекстДляДобавления = Сред(ТекстФормула,1,ПозицияНачала-1);
					
		Иначе
			//от конца прошлого операнда до начала нового
			
			ТекстДляДобавления = Сред(ТекстФормула,ПозицияКонца+1,ПозицияНачала - ПозицияКонца -1);
			
		КонецЕсли;
		Если ЗначениеЗаполнено(ТекстДляДобавления) Тогда
			ТекстБезОперандовМассив.Добавить(ТекстДляДобавления);
		Иначе
			ТекстБезОперандовМассив.Добавить(" ");//если начало с операнда
		КонецЕсли;
		
		ПозицияКонца = СтрНайти(ТекстФормула,"]",,,Инд);	
		
		Если ПозицияКонца>0 Тогда
			ТекКод = Сред(ТекстФормула,ПозицияНачала+1,ПозицияКонца-ПозицияНачала-1);
			Если СписокКодов.НайтиПоЗначению(ТекКод)=Неопределено Тогда		
				СписокКодов.Добавить(ТекКод);			
			КонецЕсли;
		Иначе
			ТекстДляДобавления = Сред(ТекстФормула,ПозицияНачала);//такого быть не должно
			Прервать;
		КонецЕсли;
		Инд = Инд + 1;
		ПозицияНачала = СтрНайти(ТекстФормула,"[",,,Инд);
	КонецЦикла;
	
	Если ДлинаТекста>ПозицияКонца Тогда
		ТекстДляДобавления = Сред(ТекстФормула,ПозицияКонца+1,ДлинаТекста - ПозицияКонца);
		ТекстБезОперандовМассив.Добавить(ТекстДляДобавления);
	Иначе
		ТекстБезОперандовМассив.Добавить(" ");//если заканчивается операндом
	КонецЕсли;
		
	
	//если в блоках текста между операндами есть цифры и знаки, значит признак ЕстьАбсолютныеЗначения = Истина
	Для Каждого ТекБлок Из ТекстБезОперандовМассив Цикл
		ЕстьЧисло = СтрРазделить(ТекБлок,"123456789",Истина).Количество()> 1;
		ЕстьЗнак = СтрРазделить(ТекБлок,"+-=<>",Истина).Количество()>1;
		
		Если ЕстьЧисло И ЕстьЗнак Тогда
			ЕстьАбсолютныеЗначения=Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ТекстДляПроверки = СтрСоединить(ТекстБезОперандовМассив, " 1 ");//получим текст без операндов в одной строке, заменив операнды на 1
	
	Возврат СписокКодов;	
	
КонецФункции // РазобратьОперанды(ТекстПроцедуры)

// Формирует таблицу показателей, значения которых пересчитываются по формулам.
//
Функция ПолучитьПорядокВычисленияПоказателей(ПравилоОбработки,ВидОтчета) Экспорт
	
	Перем ОбъектПроверки; // Объект для синтаксического контроля.
	
	// Результирующая таблица показателей	
	Показатели=Новый ТаблицаЗначений;
	Показатели.Колонки.Добавить("Код");
	Показатели.Колонки.Добавить("Показатель");
	Показатели.Колонки.Добавить("Процедура");
	Показатели.Колонки.Добавить("СпособОбработки");
	Показатели.Колонки.Добавить("ПоказателиТекущегоОтчета",Новый ОписаниеТипов("Булево"));
	Показатели.Колонки.Добавить("СписокИспользуемых");
	Показатели.Колонки.Добавить("Порядок");
	Показатели.Колонки.Добавить("ЕстьАбсолютныеЗначения",Новый ОписаниеТипов("Булево"));
	
	// Получим вычисляемые показатели
	
	Запрос = Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	ПоказателиОтчетов.Ссылка КАК Показатель,
	             |	ПоказателиОтчетов.Код КАК Код,
	             |	ПоказателиОтчетов.СпособОбработки КАК СпособОбработки
	             |ПОМЕСТИТЬ Показатели
	             |ИЗ
	             |	Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
	             |ГДЕ
	             |	ПоказателиОтчетов.Владелец = &ВидОтчета
	             |
	             |ИНДЕКСИРОВАТЬ ПО
	             |	Показатель
	             |;
	             |
	             |////////////////////////////////////////////////////////////////////////////////
	             |ВЫБРАТЬ
	             |	Показатели.Показатель КАК Показатель,
	             |	Показатели.Код КАК Код,
	             |	Показатели.СпособОбработки КАК СпособОбработки,
	             |	ЕСТЬNULL(ПроцедурыОбработки.Процедура, """") КАК Процедура
	             |ИЗ
	             |	Показатели КАК Показатели
	             |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	             |			ПравилаОбработкиПроцедурыОбработкиПоказателей.Показатель КАК Показатель,
	             |			ПравилаОбработкиПроцедурыОбработкиПоказателей.Процедура КАК Процедура
	             |		ИЗ
	             |			Справочник.ПравилаОбработки.ПроцедурыОбработкиПоказателей КАК ПравилаОбработкиПроцедурыОбработкиПоказателей
	             |		ГДЕ
	             |			ПравилаОбработкиПроцедурыОбработкиПоказателей.Ссылка = &Правило) КАК ПроцедурыОбработки
	             |		ПО Показатели.Показатель = ПроцедурыОбработки.Показатель";
	
	Запрос.УстановитьПараметр("Правило",ПравилоОбработки);
	Запрос.УстановитьПараметр("ВидОтчета",ВидОтчета);
	
	ТабПоказатели=Запрос.Выполнить().Выгрузить();
	ТабПоказатели.Колонки.Добавить("СписокИспользуемых");
	ТабПоказатели.Колонки.Добавить("СокрКод");
	ТабПоказатели.Колонки.Добавить("ЕстьАбсолютныеЗначения",Новый ОписаниеТипов("Булево"));
	
	// Заполним для каждого показателя список кодов других показателей этого отчета, используемых
	// при расчете.
	
	Для Каждого СтрПоказательТаб ИЗ ТабПоказатели Цикл
		
		ТекФормулаДляПроверки = "";
		
		СписокИспользуемых 					= РазобратьОперанды(СтрПоказательТаб.Процедура,ТекФормулаДляПроверки,СтрПоказательТаб.ЕстьАбсолютныеЗначения);
		СтрПоказательТаб.СписокИспользуемых = СписокИспользуемых;
		
		Если Не ПустаяСтрока(ТекФормулаДляПроверки) Тогда
			
			Если Не СинтаксическийКонтрольФормулы(ТекФормулаДляПроверки, СтрПоказательТаб.Код, Истина, ОбъектПроверки) Тогда
				Возврат Неопределено;
			КонецЕсли;
			
		КонецЕсли;	
		
		СтрПоказательТаб.СокрКод=СокрЛП(СтрПоказательТаб.Код);
		
	КонецЦикла;
	
	Уровень = 1;
	
	// Сохраним исходную таблицу для возможной проверки
	
	ТабПоказателиПроверка=ТабПоказатели.Скопировать();
	ТабПоказателиПроверка.Индексы.Добавить("СокрКод");
	
	ФормулыКорректны=ПроверитьОперандыФормулРасчета(ТабПоказатели,ТабПоказателиПроверка);
	
	Если НЕ ФормулыКорректны Тогда 
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	//В данном соответствии будут коды обработанных показателей.
	СоответствиеОбработанныхКодов = Новый Соответствие;
	
	Пока ТабПоказатели.Количество()>0 Цикл
		
		МассивОбработанных=Новый Массив;
		
		Для Каждого Показатель ИЗ ТабПоказатели Цикл
			
			ЕстьВычисляемыеПозже=Ложь;
			
			Для Каждого Код ИЗ Показатель.СписокИспользуемых Цикл
				
				Если ПустаяСтрока(Код.Значение) Тогда
					
					Продолжить;
					
				КонецЕсли;
				
				ЭтоАналитика = Лев(Код.Значение,9) = "Аналитика";
				Если СоответствиеОбработанныхКодов[Код.Значение] = Неопределено И ЭтоАналитика = Ложь  Тогда
					
					// В формуле расчета есть показатели, которые на данном шаге вычислений
					// еще не определены
					
					ЕстьВычисляемыеПозже=Истина;
					Прервать;
					
				КонецЕсли;
				
			КонецЦикла;
			
			Если НЕ (ЕстьВычисляемыеПозже И Показатель.СписокИспользуемых.Количество()>0) Тогда
				
				СтрПоказатель=Показатели.Добавить();
				
				ЗаполнитьЗначенияСвойств(СтрПоказатель,Показатель,,"Код");
				
				СтрПоказатель.Код=Показатель.СокрКод;
				СтрПоказатель.Порядок=Уровень;
				
				МассивОбработанных.Добавить(Показатель);
				
				Уровень=Уровень+1;
				
				СоответствиеОбработанныхКодов.Вставить(Показатель.СокрКод,Показатель.СокрКод);
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого Обработанный ИЗ МассивОбработанных Цикл  // Удаляем уже упорядоченные показатели
			
			ТабПоказатели.Удалить(Обработанный);
			
		КонецЦикла;
		
		Если МассивОбработанных.Количество()=0 И ТабПоказатели.Количество()>0 Тогда
						
			Возврат Неопределено;
			
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Показатели.Сортировать("Порядок");
	
	Возврат Показатели;
	
КонецФункции // ПолучитьПорядокВычисленияПоказателей()

// Формирует дерево порядка пересчета показателей.
//
Функция ПолучитьДеревоПересчетаПоказателей(мПоказателиДляОбработки) Экспорт
	
	мПоказателиДляобработки.Сортировать("Порядок Убыв");
	
	ДеревоПересчета=Новый ДеревоЗначений;
	ДеревоПересчета.Колонки.Добавить("КодПоказателя");
	
	//В соответствие будем добавлять коды показателей, которые уже есть в дереве,
	//т.к. для больших форм поиск в дереве на наличие существующих показателей выполняется долго.
	СоответствиеОбработанныхПоказаетелей = Новый Соответствие;
		
	Для Каждого СтрПоказатель ИЗ мПоказателиДляобработки Цикл
		//Проверка на наличие показателя в соответсвии быстрее, чем поиск в дереве
		Если СоответствиеОбработанныхПоказаетелей[СтрПоказатель.Код]=Неопределено Тогда
			НоваяСтрока=ДеревоПересчета.Строки.Добавить();
			НоваяСтрока.КодПоказателя=СтрПоказатель.Код;
			
			СоответствиеОбработанныхПоказаетелей.Вставить(СтрПоказатель.Код,СтрПоказатель.Код);
			
			Если СтрПоказатель.СписокИспользуемых.Количество()>0 Тогда
				
				СформироватьДеревоРекурсивноЗависимых(НоваяСтрока,СтрПоказатель,мПоказателиДляОбработки,СоответствиеОбработанныхПоказаетелей);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	мПоказателиДляобработки.Сортировать("Порядок");
	
	Возврат ДеревоПересчета;
	
КонецФункции // ПолучитьДеревоПересчетаПоказателей()

// Возвращает значение использования дополнения межотчетного периода 
// в зависимости от конфигурации
Функция ИспользуетсяМежотчетныйПериод() Экспорт
	
	Возврат Истина;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ УПРАВЛЕНИЯ НАСТРОЙКАМИ ПЕЧАТНЫХ ФОРМ

// Функция возвращает код единицы измерения по ОКЕИ.
//
Функция КодЕдиницыИзмерения(ЕдиницаИзмерения) Экспорт
	Если ЕдиницаИзмерения = Перечисления.ПорядкиОкругленияОтчетности.Окр1 Тогда
		Возврат "383";
	ИначеЕсли ЕдиницаИзмерения = Перечисления.ПорядкиОкругленияОтчетности.Окр1000 Тогда
		Возврат "384";
	ИначеЕсли ЕдиницаИзмерения = Перечисления.ПорядкиОкругленияОтчетности.Окр1000000 Тогда
		Возврат "385";
	Иначе
		Возврат "";
	КонецЕсли;
КонецФункции


////////////////////////////////////////////////////////////////////////////////
// ФУНКЦИИ УПАКОВКИ И ВОССТАНОВЛЕНИЯ ССЫЛОЧНЫХ ЗНАЧЕНИЙ ОТБОРА

// Преобразует настройку отбора операнда в объект информационной базы.
//
Функция ПреобразоватьНастройкуОтбора(НастройкаОтбора) Экспорт

	Если ТипЗнч(НастройкаОтбора) = Тип("СписокЗначений") Тогда
		
		СписокРезультат = Новый СписокЗначений;
		
		Для Каждого ЭлементСписка Из НастройкаОтбора Цикл
			СписокРезультат.Добавить(ПреобразоватьНастройкуОтбора(ЭлементСписка.Значение));
		КонецЦикла;
		
		Возврат СписокРезультат;
		
	ИначеЕсли ТипЗнч(НастройкаОтбора) = Тип("Структура") и НастройкаОтбора.Свойство("КодВидаСубконто") Тогда
		
		ВидСубконто = ПланыВидовХарактеристик.АналитикаОтчетов.НайтиПоКоду(НастройкаОтбора.КодВидаСубконто);
		Если ВидСубконто.Пустая() Тогда
			Сообщить("Не найден вид субконто с кодом "+НастройкаОтбора.КодВидаСубконто,СтатусСообщения.Внимание);
			Возврат Строка(НастройкаОтбора.Значение);
		КонецЕсли;
		
		ТипСубконто = ВидСубконто.ТипЗначения;
		РеквизитСинхронизации = НастройкаОтбора.РеквизитСинхронизации;
		
		Если Перечисления.ТипВсеСсылки().СодержитТип(ТипСубконто.Типы()[0]) Тогда // Получение значения перечисления.
			
			МетаданныеПеречисления = Метаданные.НайтиПоТипу(ТипСубконто.Типы()[0]);
			Менеджер = Перечисления[МетаданныеПеречисления.Имя];
			
			Если РеквизитСинхронизации = "Идентификатор" Тогда				
				Попытка
					ЗначениеПеречисления = Менеджер[НастройкаОтбора.Значение];
				Исключение
					Сообщить("Не удалось получить значение субконто " + ВидСубконто + ": " + НастройкаОтбора.Значение,СтатусСообщения.Внимание);
					ЗначениеПеречисления = Строка(НастройкаОтбора.Значение);
				КонецПопытки;
			ИначеЕсли РеквизитСинхронизации = "Представление" Тогда
				
				ЗначениеНайдено = Ложь;
				Для Каждого ЗначениеПеречисления Из Менеджер Цикл
					
					Если Строка(ЗначениеПеречисления) = НастройкаОтбора.Значение Тогда
						ЗначениеНайдено = Истина;
						Прервать;
					КонецЕсли;
					
				КонецЦикла;
				
				Если Не ЗначениеНайдено Тогда
					ЗначениеПеречисления = Строка(НастройкаОтбора.Значение);
				КонецЕсли;
				
			Иначе
				
				Сообщить("Неверный реквизит синхронизации "+ РеквизитСинхронизации +" для субконто "+ВидСубконто,СтатусСообщения.Внимание);
				Возврат Строка(НастройкаОтбора.Значение);
				
			КонецЕсли;
			
			Возврат ЗначениеПеречисления;
			
		Иначе // Получение значения из справочника.
			
			МетаданныеСправочника = Метаданные.НайтиПоТипу(ТипСубконто.Типы()[0]);
			Если РеквизитСинхронизации <> "Код" И РеквизитСинхронизации <> "Наименование" И МетаданныеСправочника.Реквизиты.Найти(РеквизитСинхронизации) = Неопределено Тогда
				Сообщить("Неверный реквизит синхронизации "+ РеквизитСинхронизации +" для субконто "+ВидСубконто,СтатусСообщения.Внимание);
				Возврат Строка(НастройкаОтбора.Значение);
			КонецЕсли;
			
			Запрос = Новый Запрос;
			
			ТекстЗапроса = "
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	Спр.Ссылка
			|ИЗ 
			|	"+МетаданныеСправочника.ПолноеИмя()+" КАК Спр
			|ГДЕ
			|	Спр." + РеквизитСинхронизации + " = &РеквизитСинхронизации";
			
			Если ТипСубконто.СодержитТип(Тип("СправочникСсылка.Субконто")) Тогда
				ТекстЗапроса = ТекстЗапроса + "
				|	И Спр.Владелец = &ВидСубконто";
				
				Запрос.УстановитьПараметр("ВидСубконто",ВидСубконто);
			КонецЕсли;
			
			Запрос.Текст = ТекстЗапроса;
			
			Запрос.УстановитьПараметр("РеквизитСинхронизации",НастройкаОтбора.Значение);
			Выборка = Запрос.Выполнить().Выбрать();
			
			Если Выборка.Следующий() Тогда
				
				Возврат Выборка.Ссылка;
				
			Иначе
				
				Сообщить("Поиск значения субконто "+ВидСубконто+".
				|Не удалось найти элемент "+МетаданныеСправочника.ПолноеИмя()+" со значением реквизита "+РеквизитСинхронизации+"="+НастройкаОтбора.Значение,СтатусСообщения.Внимание);
				Возврат Строка(НастройкаОтбора.Значение);
				
			КонецЕсли;
			
			
		КонецЕсли;
		
	Иначе
		
		Возврат НастройкаОтбора;
		
	КонецЕсли;

КонецФункции

Функция ПреобразоватьНастройкуОтбораПоРеквизиту(НастройкаОтбора, ВидСравнения, РеквизитАналитики, ВидАналитики) Экспорт

	
    ТипСубконто = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидАналитики,"ТипЗначения");
	ТипОбъекта = ТипСубконто.Типы()[0];
	МетаданныеСправочника = Метаданные.НайтиПоТипу(ТипОбъекта);
	
	ПустаяСсылка = ТипСубконто.ПривестиЗначение(Неопределено);
	
	Запрос = Новый Запрос;
	
	Если ТипЗнч(НастройкаОтбора) = Тип("СписокЗначений")
		И СокрЛП(ВРег(ВидСравнения)) = "ПОДОБНО" Тогда
		
		Инд = 1;
		МассивУсловийПервый = Новый Массив;
		МассивУсловийВторой = Новый Массив;
		Для Каждого СтрСписка Из НастройкаОтбора Цикл
			ИмяПараметра = "РеквизитСинхронизации_"+Формат(Инд,"ЧГ=0");
			Запрос.УстановитьПараметр(ИмяПараметра,СокрЛП(СтрСписка.Значение));		
		    МассивУсловийПервый.Добавить("Спр." + РеквизитАналитики +" "+ ВидСравнения+" (&"+ИмяПараметра+")");
			МассивУсловийВторой.Добавить("&ПустойКод "+ ВидСравнения+" (&"+ИмяПараметра+")");
			Инд = Инд + 1;
		КонецЦикла;
		
		СтрокаУсловийПервая = "("+СтрСоединить(МассивУсловийПервый," ИЛИ "+Символы.ПС)+")";
		СтрокаУсловийВторая = СтрСоединить(МассивУсловийВторой," ИЛИ "+Символы.ПС);
		
		ТекстЗапроса = "
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ 
			|	Спр.Ссылка
			|ИЗ 
			|	"+МетаданныеСправочника.ПолноеИмя()+" КАК Спр
			|ГДЕ
			|	"+СтрокаУсловийПервая;
	
	    Если ТипСубконто.СодержитТип(Тип("СправочникСсылка.Субконто")) Тогда
			ТекстЗапроса = ТекстЗапроса + "
			|	И Спр.Владелец = &ВидСубконто";
			
			Запрос.УстановитьПараметр("ВидСубконто",БюджетнаяОтчетностьСерверПовтИсп.ПолучитьВладельцаСубконтоДляАналитики(ВидАналитики));
		КонецЕсли;
		ТекстЗапроса = ТекстЗапроса + "
			|ОБЪЕДИНИТЬ ВСЕ
			|ВЫБРАТЬ
			|	&ПустаяСсылка
			|ГДЕ
			|	"+СтрокаУсловийВторая;
		
		
		Запрос.Текст = ТекстЗапроса;
		
	Иначе	
		ТекстЗапроса = "
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ 
		|	Спр.Ссылка
		|ИЗ 
		|	"+МетаданныеСправочника.ПолноеИмя()+" КАК Спр
		|ГДЕ
		|	Спр." + РеквизитАналитики +" "+ ВидСравнения+" (&РеквизитСинхронизации)";
		
		Если ТипСубконто.СодержитТип(Тип("СправочникСсылка.Субконто")) Тогда
			ТекстЗапроса = ТекстЗапроса + "
			|	И Спр.Владелец = &ВидСубконто";
			
			Запрос.УстановитьПараметр("ВидСубконто",БюджетнаяОтчетностьСерверПовтИсп.ПолучитьВладельцаСубконтоДляАналитики(ВидАналитики));
		КонецЕсли;
		ТекстЗапроса = ТекстЗапроса + "
		|ОБЪЕДИНИТЬ ВСЕ
		|ВЫБРАТЬ
		|	&ПустаяСсылка
		|ГДЕ
		|	&ПустойКод " + ВидСравнения+" (&РеквизитСинхронизации)";
		
		
		Запрос.Текст = ТекстЗапроса;
	
		Запрос.УстановитьПараметр("РеквизитСинхронизации",НастройкаОтбора);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ПустаяСсылка",ПустаяСсылка);
	
	ДлинаРеквизита = 0;	
	Если НРег(РеквизитАналитики) = "код" Тогда
		ДлинаРеквизита = МетаданныеСправочника.ДлинаКода;
	ИначеЕсли НРег(РеквизитАналитики) = "наименование" Тогда
		ДлинаРеквизита = МетаданныеСправочника.ДлинаНаименования;
	Иначе
		ТекРеквизит = МетаданныеСправочника.Реквизиты.Найти(РеквизитАналитики);
		Если ТекРеквизит<>Неопределено Тогда
			ДлинаРеквизита = Мин(150,ТекРеквизит.Тип.КвалификаторыСтроки.Длина);
		КонецЕсли;
	КонецЕсли;
	
	ПустойКод = СтроковыеФункцииКлиентСервер.ДополнитьСтроку("",ДлинаРеквизита,"0");
	Запрос.УстановитьПараметр("ПустойКод", ПустойКод);
	
	Выборка = Запрос.Выполнить().Выбрать();
	СписокРезультат = Новый СписокЗначений;

	Пока Выборка.Следующий() Цикл
		СписокРезультат.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Возврат СписокРезультат;
				
КонецФункции

Функция ПреобразоватьНастройкуОтбораБК(НастройкаОтбора, ВидСравнения, ВидАналитики) Экспорт
	
	СоответствиеРезультат = Новый Соответствие;//чтобы не искать дубли значений
	
	СписокРезультат = Новый СписокЗначений;
	ТипСубконто = БюджетнаяОтчетность.ПолучитьОписаниеТиповБК(ВидАналитики);
	Для Каждого ТипОбъекта Из ТипСубконто.Типы() Цикл
		МетаданныеСправочника = Метаданные.НайтиПоТипу(ТипОбъекта);
		
		// При отборе по фиксированному значению (списку фиксированных значений),
		// заполняем список переданными значениями и пустой строкой
		Если ВидСравнения = "В" Тогда
			Если ТипЗнч(НастройкаОтбора) = Тип("СписокЗначений") Тогда
				Для Каждого Стр Из НастройкаОтбора Цикл
					СоответствиеРезультат.Вставить(СокрЛП(Стр.Значение));
				КонецЦикла;
			Иначе
				СоответствиеРезультат.Вставить(СокрЛП(НастройкаОтбора));
			КонецЕсли;
			
			Запрос = Новый Запрос;
			ТекстЗапроса = "
			|ВЫБРАТЬ
			|	"""" КАК Код
			|ГДЕ
			|	&ПустойКод В (&НастройкаОтбора)";
			
			Запрос.Текст = ТекстЗапроса;
			ПустойКод = СтроковыеФункцииКлиентСервер.ДополнитьСтроку("", МетаданныеСправочника.ДлинаКода, "0");
			Запрос.УстановитьПараметр("ПустойКод", ПустойКод);
			Запрос.УстановитьПараметр("НастройкаОтбора", НастройкаОтбора);
			
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				СоответствиеРезультат.Вставить(СокрЛП(Выборка.Код));
			КонецЦикла;
			
			Прервать;
			
		// Для вида сравнения "ПОДОБНО" просто передаем в запрос строку отбора
		ИначеЕсли ВидСравнения = "ПОДОБНО" Тогда
			РеквизитСинхронизации = НастройкаОтбора;
			
		// Для выбора значений справочника по иерархии ищем ссылки на переданные строковые коды
		ИначеЕсли ВидСравнения = "В ИЕРАРХИИ" Тогда
			Запрос = Новый Запрос;
			ТекстЗапроса = "
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ 
			|	Спр.Ссылка
			|ИЗ 
			|	"+МетаданныеСправочника.ПолноеИмя()+" КАК Спр
			|ГДЕ
			|	Спр.Код В (&НастройкаОтбора)";
			
			Запрос.Текст = ТекстЗапроса;
			Запрос.УстановитьПараметр("НастройкаОтбора", НастройкаОтбора);
			РеквизитСинхронизации = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(0);
		КонецЕсли;
		
		// Выбираем значения справочника
		Запрос = Новый Запрос;
		ТекстЗапроса = "
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ 
		|	Спр.Код КАК Код
		|ИЗ 
		|	"+МетаданныеСправочника.ПолноеИмя()+" КАК Спр
		|ГДЕ";
		
		Если ВидСравнения = "ПОДОБНО" Тогда
			ТекстЗапроса = ТекстЗапроса + "
			|	Спр.Код ";
		Иначе
			ТекстЗапроса = ТекстЗапроса + "
			|	Спр.Ссылка ";
		КонецЕсли;
		
		ТекстЗапроса = ТекстЗапроса + ВидСравнения+" (&РеквизитСинхронизации)
		|ОБЪЕДИНИТЬ ВСЕ
		|ВЫБРАТЬ
		|	"""" КАК Код
		|ГДЕ
		|	&ПустойКод "+ ВидСравнения+" (&НастройкаОтбора)";
		
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("РеквизитСинхронизации", РеквизитСинхронизации);
		ПустойКод = СтроковыеФункцииКлиентСервер.ДополнитьСтроку("", МетаданныеСправочника.ДлинаКода, "0");
		Запрос.УстановитьПараметр("ПустойКод", ПустойКод);
		Запрос.УстановитьПараметр("НастройкаОтбора", НастройкаОтбора);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			СоответствиеРезультат.Вставить(СокрЛП(Выборка.Код));
		КонецЦикла;
		
	КонецЦикла;
	
	Для Каждого КлючИЗначение Из СоответствиеРезультат Цикл
		СписокРезультат.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	
	Возврат СписокРезультат;
	
КонецФункции

Функция ПреобразоватьНастройкуОтбораБКПодобноСписку(НастройкаОтбора, ВидАналитики) Экспорт
	
	СоответствиеРезультат = Новый Соответствие;//чтобы не искать дубли значений
	
	СписокРезультат = Новый СписокЗначений;
	ТипСубконто = БюджетнаяОтчетность.ПолучитьОписаниеТиповБК(ВидАналитики);
	
	МассивУсловийПервый = Новый Массив;
	МассивУсловийВторой = Новый Массив;
	
	Запрос = Новый Запрос;
	
	Инд = 1;
	Для Каждого СтрСписка Из НастройкаОтбора Цикл
		ИмяПараметра = "РеквизитСинхронизации_"+Формат(Инд,"ЧГ=0");
		Запрос.УстановитьПараметр(ИмяПараметра,СокрЛП(СтрСписка.Значение));		
	    МассивУсловийПервый.Добавить("Спр.Код ПОДОБНО &"+ИмяПараметра);
		МассивУсловийВторой.Добавить("&ПустойКод ПОДОБНО &"+ИмяПараметра);
		Инд = Инд + 1;
	КонецЦикла;
	
	СтрокаУсловийПервая = СтрСоединить(МассивУсловийПервый," ИЛИ "+Символы.ПС);
	СтрокаУсловийВторая = СтрСоединить(МассивУсловийВторой," ИЛИ "+Символы.ПС);
	
	Для Каждого ТипОбъекта Из ТипСубконто.Типы() Цикл
		МетаданныеСправочника = Метаданные.НайтиПоТипу(ТипОбъекта);
					
		// Выбираем значения справочника
		
		ТекстЗапроса = "
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ 
		|	Спр.Код КАК Код
		|ИЗ 
		|	"+МетаданныеСправочника.ПолноеИмя()+" КАК Спр
		|ГДЕ
		|	"+СтрокаУсловийПервая+"
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	"""" КАК Код
		|ГДЕ
		|	"+СтрокаУсловийВторая;
		
		Запрос.Текст = ТекстЗапроса;
		ПустойКод = СтроковыеФункцииКлиентСервер.ДополнитьСтроку("", МетаданныеСправочника.ДлинаКода, "0");
		Запрос.УстановитьПараметр("ПустойКод", ПустойКод);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			СоответствиеРезультат.Вставить(СокрЛП(Выборка.Код));
		КонецЦикла;
		
	КонецЦикла;
	
	Для Каждого КлючИЗначение Из СоответствиеРезультат Цикл
		СписокРезультат.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	
	Возврат СписокРезультат;
	
КонецФункции

// Сохраняет ссылку в текстовое представление, доступное для синхронизации.
//
// Параметры
//  Значение	 - Сохраняемое значение
//
//  ВидАналитики - вид аналитики значения
//
// Возвращаемое значение:
//   Структура - структура настройки синхронизации.
//
Функция УпаковатьЗначениеОтбора(Значение,ВидАналитики,РеквизитСинхронизации) Экспорт
	
	Если ТипЗнч(Значение) = Тип("СписокЗначений") Тогда 
		
		ХранимыйСписок = Новый СписокЗначений;
		
		Для Каждого ЭлементСписка Из Значение Цикл
			
			ХранимыйСписок.Добавить(УпаковатьЗначениеОтбора(ЭлементСписка.Значение,ВидАналитики,РеквизитСинхронизации));
			
		КонецЦикла;
		
		Возврат ХранимыйСписок;
	ИначеЕсли ТипЗнч(Значение) = Тип("Структура") Тогда
		
		Возврат Значение; //Значение уже упаковано
		
	КонецЕсли;
	
	СтруктураДанных = Новый Структура("КодВидаСубконто,РеквизитСинхронизации,Значение");
	ТипАналитики = ВидАналитики.ТипЗначения.Типы()[0];
	
	СтруктураДанных.КодВидаСубконто 		= СокрП(ВидАналитики.Код);
	СтруктураДанных.РеквизитСинхронизации 	= РеквизитСинхронизации;
	
	// Получение значения
	
	СохраняемоеЗначение = "";
	МетаданныеЗначения = Метаданные.НайтиПоТипу(ТипАналитики);
	
	Если Перечисления.ТипВсеСсылки().СодержитТип(ТипАналитики) Тогда
		МенеджерПеречисления = Перечисления[МетаданныеЗначения.Имя];
		
		Если РеквизитСинхронизации = "Идентификатор" Тогда
			
			Для Каждого ЗначениеПеречисления Из МетаданныеЗначения.ЗначенияПеречисления Цикл
				
				Если МенеджерПеречисления[ЗначениеПеречисления.Имя] = Значение Тогда
					СохраняемоеЗначение = ЗначениеПеречисления.Имя;
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе
			
			СохраняемоеЗначение = Строка(Значение);
			
		КонецЕсли;
		
	Иначе
		
		Попытка // Такого реквизита может и не быть
			СохраняемоеЗначение = Значение[РеквизитСинхронизации];
		Исключение // В этом случае, значение не упаковывается.
			СохраняемоеЗначение = Значение;
		КонецПопытки;
		
	КонецЕсли;
	
	СтруктураДанных.Значение = СохраняемоеЗначение;
	
	Возврат СтруктураДанных;

КонецФункции // УпаковатьЗначениеОтбора(Операнд,СтрАналитики)


