Функция ПолучитьПараметрыСравнения(СсылкаНаОтчет,УникальныйИдентификатор,АдресРезультатаЗаполнения = Неопределено) Экспорт
	РезультатЗаполненияПоУчету = Неопределено;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ОтчетСсылка",СсылкаНаОтчет);
	
	ТребуемыеРеквизиты = "ВидОтчета,Организация";
	
	Если ЭтоАдресВременногоХранилища(АдресРезультатаЗаполнения) Тогда
		РезультатЗаполненияПоУчету = ПолучитьИзВременногоХранилища(АдресРезультатаЗаполнения);
		РеквизитыОтчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОтчет,ТребуемыеРеквизиты);
	Иначе
		РеквизитыОтчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОтчет,ТребуемыеРеквизиты+",РезультатЗаполнения");
		РезультатЗаполненияПоУчету = РеквизитыОтчета.РезультатЗаполнения.Получить();
		Если РезультатЗаполненияПоУчету = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ РезультатЗаполненияПоУчету.Свойство("ДатаЗаполнения") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтруктураБланков = Новый Структура;
	Если РезультатЗаполненияПоУчету.Свойство("Бланк") Тогда
		//старый вариант - одностраничный бланк
		СтруктураБланков.Вставить("Стр_1",РезультатЗаполненияПоУчету.Бланк);
	ИначеЕсли РезультатЗаполненияПоУчету.Свойство("СтруктураБланков") Тогда
		//новый вариант - многостраничный бланк
		СтруктураБланков = РезультатЗаполненияПоУчету.СтруктураБланков;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	//Если НЕ (РезультатЗаполненияПоУчету.Свойство("Бланк")
	//	И РезультатЗаполненияПоУчету.Свойство("ДатаЗаполнения")) Тогда
	//	Возврат Неопределено;
	//КонецЕсли;
	
	//БланкАвтозаполнения = РезультатЗаполненияПоУчету.Бланк;
	
	//ПараметрыФормы.Вставить("ТабличныйДокументВерсия2",ПоместитьВоВременноеХранилище(БланкАвтозаполнения,УникальныйИдентификатор));
	
	ПараметрыФормы.Вставить("СтруктураБланков",СтруктураБланков);
	
	ШаблонЗаголовка = "%1%2, %3";
	ТекстЗаголовка = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонЗаголовка,
					Строка(РеквизитыОтчета.ВидОтчета),
					", "+Строка(РеквизитыОтчета.Организация),
					Строка(СсылкаНаОтчет));
	
	ПараметрыФормы.Вставить("Наименование1", СсылкаНаОтчет);
	ПараметрыФормы.Вставить("Наименование2", "Данные автозаполнения по учетным данным на "+Формат(РезультатЗаполненияПоУчету.ДатаЗаполнения,"ДФ=dd.MM.yyyy"));
	ПараметрыФормы.Вставить("ТекстЗаголовка", ТекстЗаголовка);
						
	
	Возврат ПараметрыФормы;	
	
КонецФункции

//Данная функция определяет, выполняется ли загрузка комплекта в текущий момент времени
Функция ВыполняетсяЗагрузкаКомплекта() Экспорт
	ЗагрузкаВыполняется = Константы.ВыполняетсяЗагрузкаКомплектаОтчетности.Получить();
	
	Если ЗагрузкаВыполняется = Истина Тогда
		ДатаНачалаЗагрузки = Константы.ДатаНачалаЗагрузкиКомплектаОтчетности.Получить();
		
		Если ЗначениеЗаполнено(ДатаНачалаЗагрузки) Тогда
			Если ТекущаяДата()>ДатаНачалаЗагрузки+10800 Тогда
				//Прошло более 3х часов, но комплект все еще загружается.
				//Вероятно, был сбой, программа завершилась аварийно и загрузка сейчас не выполняется.
				//Сбросим признак выполнения загрузки.
				УстановитьПривилегированныйРежим(Истина);
				Константы.ВыполняетсяЗагрузкаКомплектаОтчетности.Установить(Ложь);
				Константы.ДатаНачалаЗагрузкиКомплектаОтчетности.Установить(Неопределено);
			    УстановитьПривилегированныйРежим(Ложь);
				Возврат Ложь;
			Иначе
				//Прошло менее 3х часов, возможно комплект все еще загружается.
				Возврат Истина;
			КонецЕсли;
		Иначе
			//Стоит признак выполнения загрузки, но не указана дата начала.
			//Это не стандартная ситуация.
			//Сбросим признак выполнения загрузки.
			УстановитьПривилегированныйРежим(Истина);
			Константы.ВыполняетсяЗагрузкаКомплектаОтчетности.Установить(Ложь);
		    УстановитьПривилегированныйРежим(Ложь);
			Возврат Ложь;
		КонецЕсли;	
	КонецЕсли;
	
	//Загрузка не выполняется, все ок.
	Возврат Ложь;
	
КонецФункции

//Выводит сообщение о невозможности использования отчетности из-за процесса загрузки комплекта.
Процедура СообщениеПриЗагрузкеКомплекта() Экспорт
	
	ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Происходит обновление комплекта регламентированной бухгалтерской отчетности.
		|На время обновления работа с регламентированными отчетами ограничена.'"));
			
КонецПроцедуры

Функция РазобратьОперандыКС(ТекстФормула) Экспорт
	
	СписокКодов=Новый СписокЗначений;
	
	Инд = 1;
	ПозицияНачала = СтрНайти(ТекстФормула,"[",,,Инд);
	Пока ПозицияНачала>0 Цикл
		ПозицияКонца = СтрНайти(ТекстФормула,"]",,,Инд);
		Если ПозицияКонца>0 Тогда
			ТекКод = Сред(ТекстФормула,ПозицияНачала+1,ПозицияКонца-ПозицияНачала-1);
			Если СписокКодов.НайтиПоЗначению(ТекКод)=Неопределено Тогда		
				СписокКодов.Добавить(ТекКод);			
			КонецЕсли;
		Иначе
			Прервать;
		КонецЕсли;
		Инд = Инд + 1;
		ПозицияНачала = СтрНайти(ТекстФормула,"[",,,Инд);
	КонецЦикла;
	
	Возврат СписокКодов;	
	
КонецФункции // РазобратьОперандыКС(ТекстПроцедуры)

Процедура РазобратьКС(СтрокаСоотношение) Экспорт
	
	КонецЛевойЧасти=0;
	НачалоПравойЧасти=0;
	Условие="";
	
	ИсходныйТекст=СокрЛП(СтрокаСоотношение.Процедура);
	
	СписокУсловий=Новый Массив;
	СписокУсловий.Добавить("<");
	СписокУсловий.Добавить(">");
	СписокУсловий.Добавить("=");
	
	ФормулаОбработана = ОпределитьВыраженияКС(ИсходныйТекст,"<",Условие,КонецЛевойЧасти,НачалоПравойЧасти,СписокУсловий);
	
	Если ФормулаОбработана = Ложь Тогда
		
		ФормулаОбработана = ОпределитьВыраженияКС(ИсходныйТекст,">",Условие,КонецЛевойЧасти,НачалоПравойЧасти,СписокУсловий);	
		
	КонецЕсли;	
	
	Если ФормулаОбработана = Ложь Тогда
		
		ФормулаОбработана = ОпределитьВыраженияКС(ИсходныйТекст,"=",Условие,КонецЛевойЧасти,НачалоПравойЧасти,СписокУсловий);	
		
	КонецЕсли;
	
	СтрокаСоотношение.ВыражениеЛев=Лев(ИсходныйТекст,КонецЛевойЧасти);
	СтрокаСоотношение.ВыражениеПрав=Сред(ИсходныйТекст,НачалоПравойЧасти);

	СтрокаСоотношение.СписокИспользуемыхЛев=РазобратьОперандыКС(СтрокаСоотношение.ВыражениеЛев);
	СтрокаСоотношение.СписокИспользуемыхПрав=РазобратьОперандыКС(СтрокаСоотношение.ВыражениеПрав);
	
	СтрокаСоотношение.Условие=Условие;
	
КонецПроцедуры

Функция ЭтоСравнениеВСкобке(ТекстФормула)
	
	ЭтоЗнакСравненияВСкобке = Ложь;
		
	Инд = 1;
	ПозицияНачалаС1 = СтрНайти(ТекстФормула,"(",,,Инд);
	Пока ПозицияНачалаС1>0 Цикл
		ПозицияКонцаС1 = СтрНайти(ТекстФормула,")",,,Инд);
		Если ПозицияКонцаС1=0 Тогда
			//Это знак сравнения в скобке
			ЭтоЗнакСравненияВСкобке = Истина;
			Прервать;
			
			
		КонецЕсли;
		Инд = Инд + 1;
		ПозицияНачалаС1 = СтрНайти(ТекстФормула,"(",,,Инд);
	КонецЦикла;
	//Нужно ли?	
	Если ЭтоЗнакСравненияВСкобке = Ложь Тогда 
	    Инд = 1;
		ПозицияНачалаС2 = СтрНайти(ТекстФормула,"[",,,Инд);
		Пока ПозицияНачалаС2>0 Цикл
			ПозицияКонцаС2 = СтрНайти(ТекстФормула,"]",,,Инд);
			Если ПозицияКонцаС2=0 Тогда
				//Это знак сравнения в скобке
				ЭтоЗнакСравненияВСкобке = Истина;
				Прервать;
				
				
			КонецЕсли;
			Инд = Инд + 1;
			ПозицияНачалаС2 = СтрНайти(ТекстФормула,"[",,,Инд);
		КонецЦикла;
	КонецЕсли;
	
	Возврат ЭтоЗнакСравненияВСкобке;
	
КонецФункции

Функция ОпределитьВыраженияКС(ИсходныйТекст,ЗнакСравнения,Условие,КонецЛевойЧасти,НачалоПравойЧасти,СписокУсловий)
	
	Инд = 1;
	ПозицияЗнака = СтрНайти(ИсходныйТекст,ЗнакСравнения,,,Инд);
	ФормулаОбработана = Ложь;
	Пока ПозицияЗнака >0 Цикл
		
		ТекстФормулы = Лев(ИсходныйТекст,ПозицияЗнака);
		
		ЭтоЗнакСравненияВСкобке = ЭтоСравнениеВСкобке(ТекстФормулы);
		Если ЭтоЗнакСравненияВСкобке = Ложь Тогда
			
			Условие = ЗнакСравнения;
			КонецЛевойЧасти = ПозицияЗнака-1;
			Сдвиг = 1;
			СледСимвол = Сред(ИсходныйТекст,ПозицияЗнака+Сдвиг,1);
			Пока СледСимвол = " " Цикл
				Сдвиг = Сдвиг +1;
				СледСимвол = Сред(ИсходныйТекст,ПозицияЗнака+Сдвиг,1);
			КонецЦикла;
			НачалоПравойЧасти = ПозицияЗнака+Сдвиг;
			Если СписокУсловий.Найти(СледСимвол) <> Неопределено Тогда
				Условие = Условие + СледСимвол;
				НачалоПравойЧасти = НачалоПравойЧасти+1;
			КонецЕсли;
			ФормулаОбработана = Истина;
			Прервать;
		КонецЕсли;
		Инд = Инд+1;
		ПозицияЗнака = СтрНайти(ИсходныйТекст,ЗнакСравнения,,,Инд);
	КонецЦикла;	
	
	Возврат ФормулаОбработана;
	
КонецФункции

Функция ПолучитьМассивСлужебныхСимволов() Экспорт
	
	// Инициируем массив специальных символов
	
	МассивСлужебныхСимволов=Новый Массив;
	МассивСлужебныхСимволов.Добавить("+");
	МассивСлужебныхСимволов.Добавить("-");
	МассивСлужебныхСимволов.Добавить("*");
	МассивСлужебныхСимволов.Добавить("/");
	МассивСлужебныхСимволов.Добавить("=");
	МассивСлужебныхСимволов.Добавить(";");
	МассивСлужебныхСимволов.Добавить(" ");
	МассивСлужебныхСимволов.Добавить("(");
	МассивСлужебныхСимволов.Добавить(")");
	МассивСлужебныхСимволов.Добавить(",");
	МассивСлужебныхСимволов.Добавить(Символы.ВК);
	МассивСлужебныхСимволов.Добавить(Символы.ВТаб);
	МассивСлужебныхСимволов.Добавить(Символы.НПП);
	МассивСлужебныхСимволов.Добавить(Символы.ПС);
	МассивСлужебныхСимволов.Добавить(Символы.ПФ);
	МассивСлужебныхСимволов.Добавить(Символы.Таб);
	
	Возврат МассивСлужебныхСимволов;
	
КонецФункции // ПолучитьМассивСлужебныхСимволов()


