// ПРОЦЕДУРЫ ДИНАМИЧЕСКОГО ФОРМИРОВАНИЯ ТЕКСТА ЗАПРОСА К ЭКЗЕМПЛЯРАМ ОТЧЕТОВ

// Функция возвращает число объявленных аналитических разрезов для вида отчета
//
// Параметры
//  ВидОтчета	 	- СправочникСсылка.ВидыОтчетов - вид отчета
//                 	  для которого определяется число доп. аналитик
//
//  ГруппаРаскрытия - СправочникСсылка.ГруппыРаскрытия. - группа, для которой
//						определяется число доп. аналитик. Если не указана, возвращается
//						максимальное число аналитик среди всех групп раскрытия.
//
// Возвращаемое значение:
//   Число. Число доп. аналитик
//
Функция ЧислоДопАналитик(ВидОтчета, ГруппаРаскрытия = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕСТЬNULL(МАКСИМУМ(ГруппыРаскрытия.ЧислоАналитик),0) КАК ЧислоАналитик
	|ИЗ
	|	(ВЫБРАТЬ
	|		КОЛИЧЕСТВО(ГруппыРаскрытияАналитика.ВидАналитики) КАК ЧислоАналитик,
	|		ГруппыРаскрытияАналитика.Ссылка КАК Ссылка
	|	ИЗ
	|		Справочник.ГруппыРаскрытия.Аналитика КАК ГруппыРаскрытияАналитика
	|	ГДЕ
	|		ГруппыРаскрытияАналитика.Ссылка.Владелец = &Владелец";
	Если ГруппаРаскрытия <> Неопределено Тогда
		Запрос.Текст = Запрос.Текст + "
		|И	ГруппыРаскрытияАналитика.Ссылка = &ГруппаРаскрытия";
		Запрос.УстановитьПараметр("ГруппаРаскрытия", ГруппаРаскрытия);
	КонецЕсли;
	Запрос.Текст = Запрос.Текст + "
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ГруппыРаскрытияАналитика.Ссылка) КАК ГруппыРаскрытия";
	
	Запрос.УстановитьПараметр("Владелец", ВидОтчета);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ЧислоАналитик;
	Иначе
		Возврат 0;
	КонецЕсли;

КонецФункции // ЧислоДопАналитик()

// Получает таблицу, предназначенную для передачи в качестве параметра
// в функцию СформироватьТекстОтбораЭкземпляры для настройки отбора по реквизитам отчета.
//
// Возвращаемое значение:
//   ТаблицаЗначений - ИмяПараметра,ВидОтбора
//
Функция ПолучитьТаблицуНастроекОтбора() Экспорт

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ИмяПараметра");
	Таблица.Колонки.Добавить("ВидСравнения");
	Таблица.Колонки.Добавить("ЗначениеОтбора");
	
	Возврат Таблица;

КонецФункции // ПолучитьТаблицуНастроекОтбора()

// Осуществляет добавление отбора по реквизитам.
//
// Параметры
//  ТабОтбора - таблица значений с настройками отбора
//
//  ЗначениеОтбора - Произвольное значение
//
Процедура ДобавитьОтборПоРеквизиту(ТабОтбора, ИмяОтбора, ЗначениеОтбора, текВидСравнения = Неопределено) Экспорт
 
	Значение	 = ЗначениеОтбора;
	ТипПараметра = ТипЗнч(Значение);
		
	Если ТипПараметра <> Тип("Массив") И ТипПараметра <> Тип("СписокЗначений") Тогда				
		ОтборРеквизитов = ТабОтбора.Добавить();
		ОтборРеквизитов.ИмяПараметра = ИмяОтбора;
		ОтборРеквизитов.ВидСравнения = ?(текВидСравнения = Неопределено,ВидСравнения.Равно,текВидСравнения);
		ОтборРеквизитов.ЗначениеОтбора = Значение;
	Иначе
		ОтборРеквизитов = ТабОтбора.Добавить();
		ОтборРеквизитов.ИмяПараметра = ИмяОтбора;
		ОтборРеквизитов.ВидСравнения = ?(текВидСравнения = Неопределено,ВидСравнения.ВСписке,текВидСравнения);
		ОтборРеквизитов.ЗначениеОтбора = Значение;
	КонецЕсли;
	
КонецПроцедуры // ДобавитьОтборПоРеквизиту()

// Формирует текст запроса для отбора экземпляров отчета по реквизитам и доп. реквизитам.
// В качестве параметров принимает таблицы значений, полученные из функции ПолучитьТаблицуНастроекОтбора.
//
// Параметры:
//  МассивОтборРеквизиты - Имена параметров совпадаеют с кодами доп. реквизитов
//  МассивотборПараметры - Имена параметров совпадают с реквизитами документа НастраиваемыйОтчет.
//
// Возвращаемое значение:
//	Текст запроса
//
Функция СформироватьТекстОтбораЭкземпляры(МассивОтборРеквизиты,МассивОтборПараметры,ИмяПараметраВидОтчета = "ВидОтчета") Экспорт
	
	ТекстЗапроса="";
	
	Если МассивОтборРеквизиты.Количество()>0 Тогда
		ТекстЗапроса="ВЫБРАТЬ РАЗРЕШЕННЫЕ 
		|	ТабДок.ЭкземплярОтчета КАК ЭкземплярОтчета
		|ИЗ
		|	(ВЫБРАТЬ 
		|		ТДок.Ссылка КАК ЭкземплярОтчета
		|		ИЗ
		|			Документ.УниверсальныйРегламентированныйОтчет КАК ТДок
		|		ГДЕ
		|			ТДок.ВидОтчета = &"+ИмяПараметраВидОтчета +"
		|			И ТДок.ПометкаУдаления = Ложь
		|";
				
		Для Каждого СтрПараметр ИЗ МассивОтборПараметры Цикл
				
			МетодОтбора = ПолучитьМетодОтбора(СтрПараметр.ВидСравнения,СтрПараметр.ИмяПараметра);
			
			ТекстЗапроса=ТекстЗапроса+"	
			|	И ТДок."+СтрПараметр.ИмяПараметра+МетодОтбора;
			
		КонецЦикла;
				
		ТекстЗапроса = ТекстЗапроса + ") КАК ТабДок
			|ГДЕ
			| ";
		
		ТекстОтбор="";
		
		Для Каждого СтрРеквизит ИЗ МассивОтборРеквизиты Цикл
			
			МетодОтбора = ПолучитьМетодОтбора(СтрРеквизит.ВидСравнения,СтрРеквизит.ИмяПараметра);
			
			ТекстОтбор=ТекстОтбор+"И Истина 
				|	В (Выбрать Первые 1 Истина
				|		ИЗ РегистрСведений.ЗначенияДополнительныхРеквизитовОтчета КАК Т1
				|		Где Т1.ЭкземплярОтчета = ТабДок.ЭкземплярОтчета
				|			И Т1.ВидАналитики = &"+СтрРеквизит.ИмяПараметра+"_ВидАналитики
				|			И Т1.Значение"+МетодОтбора+")
				|";
			
			
		КонецЦикла;
		
		ТекстЗапроса=ТекстЗапроса+Сред(ТекстОтбор,3);
	Иначе
		
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УниверсальныйРегламентированныйОтчет.Ссылка КАК ЭкземплярОтчета
		|ИЗ
		|	Документ.УниверсальныйРегламентированныйОтчет КАК УниверсальныйРегламентированныйОтчет
		|ГДЕ
		|	УниверсальныйРегламентированныйОтчет.ВидОтчета = &"+ИмяПараметраВидОтчета + "
		|	И УниверсальныйРегламентированныйОтчет.ПометкаУдаления = Ложь";
					
		Для Каждого СтрПараметр ИЗ МассивОтборПараметры Цикл
			
			МетодОтбора = ПолучитьМетодОтбора(СтрПараметр.ВидСравнения,СтрПараметр.ИмяПараметра);
			
			ТекстЗапроса=ТекстЗапроса+"	
			|	И УниверсальныйРегламентированныйОтчет."+СтрПараметр.ИмяПараметра+МетодОтбора;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ТекстЗапроса;
		
КонецФункции // СформироватьТекстОтбораЭкземпляры

Функция ПолучитьМетодОтбора(НужныйВидСравнения,ИмяПараметра)Экспорт 
	
	Если НужныйВидСравнения = ВидСравнения.Равно Тогда
		МетодОтбора = " = &"+ИмяПараметра;
		
	ИначеЕсли НужныйВидСравнения = ВидСравнения.НеРавно Тогда
		МетодОтбора = " <> &"+ИмяПараметра;
		
	ИначеЕсли НужныйВидСравнения = ВидСравнения.ВСписке Тогда
		МетодОтбора = " В (&"+ИмяПараметра+")";
		
	ИначеЕсли НужныйВидСравнения = ВидСравнения.НеВСписке Тогда
		МетодОтбора = " НЕ В (&"+ИмяПараметра+")";
		
	ИначеЕсли НужныйВидСравнения = ВидСравнения.ВИерархии
		Или НужныйВидСравнения = ВидСравнения.ВСпискеПоИерархии Тогда
		МетодОтбора = " В ИЕРАРХИИ(&"+ИмяПараметра+")";
		
	ИначеЕсли НужныйВидСравнения = ВидСравнения.НеВИерархии
		Или НужныйВидСравнения = ВидСравнения.НеВСпискеПоИерархии Тогда
		МетодОтбора = " НЕ В ИЕРАРХИИ(&"+ИмяПараметра+")";
		
	Иначе
		ВызватьИсключение НСтр("ru = 'Неизвестный тип сравнения.'");
	КонецЕсли;
	Возврат МетодОтбора;
	
КонецФункции	

// Формирует временную таблицу запроса (Документ.УниверсальныйРегламентированныйОтчет) по структуре отбора.
//
// Параметры:
//  ОтборДопРеквизитов - Имена параметров совпадаеют с кодами доп. реквизитов или реквизитов отчета.
//
Функция ПодготовитьЗапросПоДопРеквизитам(ОтборДопРеквизитов, Запрос = Неопределено, ПараметрыДопРеквизитов = Неопределено, Знач ПоместитьВоВременнуюТаблицу = Истина, Знач ВыполнятьЗапрос = Истина) Экспорт
	
	Если ТипЗнч(Запрос) <> Тип("Запрос") Тогда
		Запрос = Новый Запрос;		
	КонецЕсли;
	
	Если ПоместитьВоВременнуюТаблицу Тогда
		Если Запрос.МенеджерВременныхТаблиц = Неопределено Тогда
			Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		КонецЕсли;
	Иначе
		ВыполнятьЗапрос = Ложь;
	КонецЕсли;
	
	НаборПолей 			= "";
	СоединениеТаблиц    = "";
	УсловияОтбора		= "";
	
	// Определение параметров доп. реквизитов
	Если ПараметрыДопРеквизитов = Неопределено Тогда
		СтрОтборВидОтчета = ОтборДопРеквизитов.Найти("ВидОтчета","ИмяПараметра");
		Если НЕ СтрОтборВидОтчета = Неопределено и СтрОтборВидОтчета.ВидСравнения = ВидСравнения.Равно Тогда
			ПараметрыДопРеквизитов = ЗаполнитьВидыАналитикОтчета(СтрОтборВидОтчета.ЗначениеОтбора);
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого ЭлементОтбора Из ОтборДопРеквизитов Цикл
		
		МетодОтбора = ПолучитьМетодОтбора(ЭлементОтбора.ВидСравнения,ЭлементОтбора.ИмяПараметра);
		
		Если Не Метаданные.Документы.УниверсальныйРегламентированныйОтчет.Реквизиты.Найти(ЭлементОтбора.ИмяПараметра) = Неопределено Тогда
			 
			УсловияОтбора = УсловияОтбора + Символы.ПС + ?(ПустаяСтрока(УсловияОтбора),"","И ") + 
			"УниверсальныйРегламентированныйОтчет."+ЭлементОтбора.ИмяПараметра + МетодОтбора;
			Запрос.УстановитьПараметр(ЭлементОтбора.ИмяПараметра,ЭлементОтбора.ЗначениеОтбора);
			
		Иначе
			
			Если ЗначениеЗаполнено(ПараметрыДопРеквизитов) Тогда
				СтрНастройки = ПараметрыДопРеквизитов.Найти("Реквизит_"+ЭлементОтбора.ИмяПараметра,"КодАналитики");
				Если СтрНастройки = Неопределено Тогда
					ТекстПоля = "Значения"+ЭлементОтбора.ИмяПараметра+".Значение КАК " + ЭлементОтбора.ИмяПараметра;
				Иначе
					ТекстПоля = "ВЫРАЗИТЬ(Значения"+ЭлементОтбора.ИмяПараметра+".Значение КАК "+СтрНастройки.ТаблицаАналитики+") КАК " + ЭлементОтбора.ИмяПараметра;
				КонецЕсли;
			Иначе
				ТекстПоля 	 = "Значения"+ЭлементОтбора.ИмяПараметра+".Значение КАК " + ЭлементОтбора.ИмяПараметра;
				СтрНастройки = Неопределено;
			КонецЕсли;
			
			НаборПолей = НаборПолей + ",
			|"+ТекстПоля;
			
			СоединениеТаблиц = СоединениеТаблиц + "
			|ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			|		ЗначенияДополнительныхРеквизитовОтчета.ЭкземплярОтчета,
			|		ЗначенияДополнительныхРеквизитовОтчета.Значение
			|	ИЗ
			|		РегистрСведений.ЗначенияДополнительныхРеквизитовОтчета КАК ЗначенияДополнительныхРеквизитовОтчета
			|	ГДЕ";
			Если СтрНастройки = Неопределено Тогда
				СоединениеТаблиц = СоединениеТаблиц + "
				|		ЗначенияДополнительныхРеквизитовОтчета.ДополнительныйРеквизитОтчета.Код = """+ЭлементОтбора.ИмяПараметра+"""";
			Иначе
				СоединениеТаблиц = СоединениеТаблиц + "
				|		ЗначенияДополнительныхРеквизитовОтчета.ВидАналитики = &ВидАналитики" + ЭлементОтбора.ИмяПараметра;
				
				Запрос.УстановитьПараметр("ВидАналитики" + ЭлементОтбора.ИмяПараметра,СтрНастройки.ВидАналитики);
				
			КонецЕсли;
			
			Если ЭлементОтбора.ЗначениеОтбора <> Неопределено Тогда
				
				СоединениеТаблиц = СоединениеТаблиц + "
				|		И ЗначенияДополнительныхРеквизитовОтчета.Значение " + МетодОтбора;
				
				Запрос.УстановитьПараметр(ЭлементОтбора.ИмяПараметра,ЭлементОтбора.ЗначениеОтбора);
			КонецЕсли;
			
			СоединениеТаблиц = СоединениеТаблиц + ") КАК Значения"+ЭлементОтбора.ИмяПараметра+"
			|ПО УниверсальныйРегламентированныйОтчет.Ссылка = Значения"+ЭлементОтбора.ИмяПараметра+".ЭкземплярОтчета";
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ТипЗнч(ПоместитьВоВременнуюТаблицу) = Тип("Строка") Тогда
		ИмяВременнойТаблицы = ПоместитьВоВременнуюТаблицу;
		ПоместитьВоВременнуюТаблицу = Истина;
	Иначе
		ИмяВременнойТаблицы = "ТаблицаДопРеквизитов";
	КонецЕсли;
	
	Запрос.Текст = 
	"ВЫБРАТЬ" + ?(ПоместитьВоВременнуюТаблицу Или ВыполнятьЗапрос, " РАЗРЕШЕННЫЕ", "") + "
	| УниверсальныйРегламентированныйОтчет.Ссылка 		КАК ЭкземплярОтчета,
	| УниверсальныйРегламентированныйОтчет.Организация 	КАК Организация,
	| УниверсальныйРегламентированныйОтчет.ПериодОтчета КАК ПериодОтчета,
	| УниверсальныйРегламентированныйОтчет.ВидОтчета	КАК ВидОтчета" +
	НаборПолей + 
	?(ПоместитьВоВременнуюТаблицу,Символы.ПС + "ПОМЕСТИТЬ "+ИмяВременнойТаблицы,"") + "
	|ИЗ 
	| Документ.УниверсальныйРегламентированныйОтчет КАК УниверсальныйРегламентированныйОтчет" + 
	СоединениеТаблиц + "
	|ГДЕ" + 
	УсловияОтбора;
	Если ВыполнятьЗапрос Тогда
		Запрос.Выполнить();
	КонецЕсли;
	
	Возврат Запрос.Текст;
	
КонецФункции //ПодготовитьЗапросПоДопРеквизитам()

// Формирует временную таблицу запроса (РегистрСведений.ЗначенияПоказателейОтчетов) по структуре отбора
//
// Параметры
//  Показатель - раскрываемый показатель
//
//  ТаблицаОтбораАналитики  - поля и способы отбора
//
Функция ПодготовитьЗапросПоказателейСАналитикой(Показатель, ТаблицаОтбораАналитики, Запрос = Неопределено, Знач ПоместитьВоВременнуюТаблицу = Истина, Знач ВыполнятьЗапрос = Истина, ВключатьИтоги = Истина) Экспорт

	Сч = 1;
	
	Если ТипЗнч(Запрос) <> Тип("Запрос") Тогда
		Запрос = Новый Запрос;		
	КонецЕсли;
	
	Если ПоместитьВоВременнуюТаблицу Тогда
		Если Запрос.МенеджерВременныхТаблиц = Неопределено Тогда
			Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		КонецЕсли;
	Иначе
		ВыполнятьЗапрос = Ложь;
	КонецЕсли;	
	
	ТекстСоединения 	= "";		
	УсловиеСоединения 	= "";
	ТекстТаблица		= "";
	ТекстПоля			= "";
	ТекстОбщиеУсловия	= "";
	
	Если ТипЗнч(Показатель) = Тип("Массив") и Показатель.Количество() > 0 Тогда
		ГруппаРаскрытия = Показатель[0].ГруппаРаскрытия;
	ИначеЕсли ТипЗнч(Показатель) = Тип("СправочникСсылка.ПоказателиОтчетов") Тогда
		ГруппаРаскрытия = Показатель.ГруппаРаскрытия;
	Иначе
		ГруппаРаскрытия = Справочники.ГруппыРаскрытия.ПустаяСсылка();
	КонецЕсли;
	
	ПараметрыГруппыРаскрытия = БюджетнаяОтчетность.ЗаполнитьВидыАналитикГруппыРаскрытия(ГруппаРаскрытия);
	
	Если ТаблицаОтбораАналитики.Количество() > 0 Тогда
		Для Каждого СтрРеквизит ИЗ ТаблицаОтбораАналитики Цикл
			
			Если Лев(СтрРеквизит.ИмяПараметра,9) <> "Аналитика" Тогда
				
				МетодОтбора = ПолучитьМетодОтбора(СтрРеквизит.ВидСравнения,СтрРеквизит.ИмяПараметра);
				
				ТекстОбщиеУсловия = "
				|И ЗначенияПоказателейОтчетов."+СтрРеквизит.ИмяПараметра+МетодОтбора;
				
				Запрос.УстановитьПараметр(СтрРеквизит.ИмяПараметра,СтрРеквизит.ЗначениеОтбора);
				
				Продолжить;
			КонецЕсли;
			
			ТекТаблица = "Таб"+СтрРеквизит.ИмяПараметра;
			
			ПараметрОтбора = ПараметрыГруппыРаскрытия.Найти(СтрРеквизит.ИмяПараметра,"КодАналитики");
			Если ПараметрОтбора = Неопределено Тогда
				Сообщить("Не определена аналитика """+СтрРеквизит.ИмяПараметра+""". Отбор невозможен",СтатусСообщения.Внимание);
				Возврат "";
			КонецЕсли;
			
			ТекстПоля = ТекстПоля + "
			|	ВЫРАЗИТЬ("+ТекТаблица+".Значение КАК "+ ПараметрОтбора.ТаблицаАналитики +") КАК "+СтрРеквизит.ИмяПараметра+",";
			
			Если Сч = 1 Тогда
				ТекстТаблица = "
				|	"+ТекТаблица+".ЭкземплярОтчета КАК ЭкземплярОтчета,
				|	"+ТекТаблица+".ГруппаРаскрытия КАК ГруппаРаскрытия,
				|	"+ТекТаблица+".Индекс КАК Индекс
				|ИЗ
				|	РегистрСведений.АналитикаПоказателей КАК "+ТекТаблица;
				
				ПерваяТаблица = ТекТаблица;
				
			Иначе 
				
				ТекстСоединения = ТекстСоединения + "
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПоказателей КАК "+ТекТаблица+"
				|		ПО "+ПерваяТаблица+".ЭкземплярОтчета = "+ТекТаблица+".ЭкземплярОтчета
				|			И "+ПерваяТаблица+".ГруппаРаскрытия = "+ТекТаблица+".ГруппаРаскрытия
				|			И "+ПерваяТаблица+".Индекс = "+ТекТаблица+".Индекс";
				
			КонецЕсли;
			
			УсловиеСоединения = УсловиеСоединения + "
			|	И "+ТекТаблица+".ВидАналитики = &ВидАналитики"+СтрРеквизит.ИмяПараметра;
			
			Запрос.УстановитьПараметр("ВидАналитики"+СтрРеквизит.ИмяПараметра, ПараметрОтбора.ВидАналитики);
			
			Если СтрРеквизит.ЗначениеОтбора <> Неопределено Тогда
				
				МетодОтбора = ПолучитьМетодОтбора(СтрРеквизит.ВидСравнения,СтрРеквизит.ИмяПараметра);
				
				УсловиеСоединения = УсловиеСоединения + "
				|	И "+ТекТаблица+".Значение"+МетодОтбора;
					
				Запрос.УстановитьПараметр(СтрРеквизит.ИмяПараметра, СтрРеквизит.ЗначениеОтбора);
			КонецЕсли;
			
			Сч = Сч + 1;
		КонецЦикла;
	Иначе
		ТекстОбщиеУсловия = "
		|	И ЗначенияПоказателейОтчетов.Индекс = 0";
	КонецЕсли;
	
	Если ТаблицаОтбораАналитики.Количество() > 0 Тогда
		ТекстСоединения = "
		|	" + ?(ВключатьИтоги,"ЛЕВОЕ","ВНУТРЕННЕЕ") + " СОЕДИНЕНИЕ (ВЫБРАТЬ "
		+ ТекстПоля
		+ ТекстТаблица
		+ ТекстСоединения + "
		|ГДЕ" + Сред(СокрЛ(УсловиеСоединения),2)+") КАК ЗначенияАналитики
		|	ПО ЗначенияПоказателейОтчетов.ЭкземплярОтчета  = ЗначенияАналитики.ЭкземплярОтчета
		|		И ЗначенияПоказателейОтчетов.Показатель.ГруппаРаскрытия = ЗначенияАналитики.ГруппаРаскрытия
		|		И ЗначенияПоказателейОтчетов.Индекс = ЗначенияАналитики.Индекс";
	Иначе
		ТекстСоединения = "";
	КонецЕсли;
	
	
	// Основной запрос
	Если ТипЗнч(ПоместитьВоВременнуюТаблицу) = Тип("Строка") Тогда
		ИмяВременнойТаблицы = ПоместитьВоВременнуюТаблицу;
		ПоместитьВоВременнуюТаблицу = Истина;
	Иначе
		ИмяВременнойТаблицы = "ЗначенияСАналитикой";
	КонецЕсли;
	
	ТекстЗапросаАналитика = 
	"ВЫБРАТЬ" + ?(ПоместитьВоВременнуюТаблицу Или ВыполнятьЗапрос, " РАЗРЕШЕННЫЕ", "") + "
	|	ЗначенияПоказателейОтчетов.Показатель,
	|	ЗначенияПоказателейОтчетов.ЭкземплярОтчета,
	|	ВЫБОР
	|		КОГДА ЗначенияПоказателейОтчетов.Индекс = 0 ТОГДА
	|			ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ИтогПоПоказателю,
	|	ЗначенияПоказателейОтчетов.ПромежуточныйИтог КАК ПромежуточныйИтог,
	|	ЗначенияПоказателейОтчетов.Значение,
	|	ЗначенияПоказателейОтчетов.ЗначениеЧисло,
	|	ЗначенияПоказателейОтчетов.ЗначениеНеограниченнаяСтрока";
	
	Для Каждого СтрРеквизит ИЗ ТаблицаОтбораАналитики Цикл
		Если Лев(СтрРеквизит.ИмяПараметра,9) = "Аналитика" Тогда
			ТекстЗапросаАналитика = ТекстЗапросаАналитика + ",
			|	ЗначенияАналитики."+СтрРеквизит.ИмяПараметра;
		КонецЕсли;
	КонецЦикла;
	
	ТекстЗапросаАналитика = ТекстЗапросаАналитика + 
	?(ПоместитьВоВременнуюТаблицу,Символы.ПС + "ПОМЕСТИТЬ " + ИмяВременнойТаблицы,"") + "
	|ИЗ
	|	РегистрСведений.ЗначенияПоказателейОтчетов КАК ЗначенияПоказателейОтчетов"
	+ ТекстСоединения;
	
	ТекстЗапросаАналитика = ТекстЗапросаАналитика + "
	|ГДЕ
	|	ЗначенияПоказателейОтчетов.Показатель В(&Показатель)" + ТекстОбщиеУсловия;
	
	Запрос.УстановитьПараметр("Показатель",Показатель);
	
	Запрос.Текст = ТекстЗапросаАналитика;
	Если ВыполнятьЗапрос Тогда
		Попытка
			Запрос.Выполнить();
		Исключение
			Сообщить("Неверные параметры формирования запроса:" + ОписаниеОшибки(),СтатусСообщения.Внимание);
		КонецПопытки;
	КонецЕсли;
	
	Возврат ТекстЗапросаАналитика;

КонецФункции // ПодготовитьЗапросПоказателейСАналитикой()


////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ РАБОТЫ СО СХЕМАМИ КОМПОНОВКИ ДАННЫХ

// Возвращает имя источника данных, для указания его в наборе.
//
Функция ИмяЛокальногоИсточникаДанных(СхемаКомпоновки) Экспорт

	Если СхемаКомпоновки.ИсточникиДанных.Количество() = 0 Тогда
		НовыйИсточник = СхемаКомпоновки.ИсточникиДанных.Добавить();
		НовыйИсточник.Имя = "ИсточникДанных1";
		НовыйИсточник.ТипИсточникаДанных = "Local";
	Иначе
				
		Для Каждого ИсточникДанныхСхемы из СхемаКомпоновки.ИсточникиДанных Цикл
			
			Если ПустаяСтрока(ИсточникДанныхСхемы.СтрокаСоединения) и ИсточникДанныхСхемы.ТипИсточникаДанных = "Local" Тогда
				Возврат ИсточникДанныхСхемы.Имя;
			КонецЕсли;
			
		КонецЦикла;
		
		НовыйИсточник = СхемаКомпоновки.ИсточникиДанных.Добавить();
		НовыйИсточник.Имя = "ИсточникДанных1";
		НовыйИсточник.ТипИсточникаДанных = "Local";
		
	КонецЕсли;
	
	Возврат НовыйИсточник.Имя;

КонецФункции // ИмяЛокальногоИсточникаДанных()

// Добавляет в схему компоновки данных набор данных-объект
// источником которого является таблица значений.
//
// Параметры:
//  СхемаКомпоновки - исходная схема компоновки данных
//
//  ТаблицаЗначений - таблица значений, которая является источником данных
//
//	ИмяНабора		- Строка. Имя набора данных
//
//	ЗаменятьСуществующий - Булево. Если в схеме есть набор с таким именем, он может быть заменен
//
//	ВозвращаемоеЗначение:
//	 Булево. Истина, если схема успешно добавлена
//
Функция ДобавитьТаблицуЗначенийВНаборыДанныхСхемыКомпоновкиДанных(СхемаКомпоновки, ТаблицаЗначений, ИмяНабора, ЗаменятьСуществующий = Ложь) Экспорт

	Набор = СхемаКомпоновки.НаборыДанных.Найти(ИмяНабора);
	
	Если Не ЗаменятьСуществующий и Не Набор = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не Набор = Неопределено Тогда
		СхемаКомпоновки.НаборыДанных.Удалить(Набор);
	КонецЕсли;
	
	Набор 			 	 = СхемаКомпоновки.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
	Набор.Имя 		 	 = ИмяНабора;
	Набор.ИмяОбъекта 	 = ИмяНабора;
	Набор.ИсточникДанных = ИмяЛокальногоИсточникаДанных(СхемаКомпоновки);
	
	Для Каждого Колонка Из ТаблицаЗначений.Колонки Цикл
	
		Поле = Набор.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		Поле.Поле 		 = Колонка.Имя;
		Поле.ПутьКДанным = Колонка.Имя;
		Поле.Заголовок	 = ?(ПустаяСтрока(Колонка.Заголовок),Колонка.Имя,Колонка.Заголовок);
		Поле.ТипЗначения = Колонка.ТипЗначения;
		
	КонецЦикла;
	
	Возврат Истина;

КонецФункции // ДобавитьТаблицуЗначенийВНаборыДанных()

// Устанавливает параметр данных, описанный в схеме
//
// Параметры:
//  СхемаКомпоновки - исходная схема компоновки данных
//
//  ИмяПараметра 	- имя устанавливаемого параметра
//
//	Значение		- значение параметра
//
Процедура УстановитьПараметрСхемыКомпоновкиДанных(СхемаКомпоновки, ИмяПараметра, Значение) Экспорт

	ПараметрСхемы = СхемаКомпоновки.Параметры.Найти(ИмяПараметра);
	Если ПараметрСхемы = Неопределено Тогда
		ПараметрСхемы 			= СхемаКомпоновки.Параметры.Добавить();
		ПараметрСхемы.Имя  		= ИмяПараметра;
		ПараметрСхемы.Заголовок	= ИмяПараметра;
	КонецЕсли;
	
	ПараметрСхемы.ВключатьВДоступныеПоля 	= Ложь;			
	ПараметрСхемы.ОграничениеИспользования 	= Истина;
	
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		ПараметрСписок = Новый СписокЗначений;
		ПараметрСписок.ЗагрузитьЗначения(Значение);
		
		ПараметрСхемы.ТипЗначения = БюджетнаяОтчетность.ПолучитьОписаниеТиповПоТипуЗначения(Значение[0]);
		
		ПараметрСхемы.ДоступенСписокЗначений = Истина;
		ПараметрСхемы.Значение = ПараметрСписок;
		
	Иначе
		ПараметрСхемы.ТипЗначения = БюджетнаяОтчетность.ПолучитьОписаниеТиповПоТипуЗначения(Значение);
		ПараметрСхемы.Значение = Значение;
	КонецЕсли;

КонецПроцедуры // УстановитьПараметрСхемыКомпоновкиДанных()

// Функция проверяет, находится ли объект в режиме загрузки комплекта отчетности.
//
Функция ЗагрузкаКомплектаОтчетности(Объект) Экспорт

	Возврат Объект.ДополнительныеСвойства.Свойство("ЗагрузкаКомплектаОтчетности") и Объект.ДополнительныеСвойства.ЗагрузкаКомплектаОтчетности;

КонецФункции // ЭтоЗагрузкаКомплектаОтчетности()


// Обработчик события ПередЗаписью всех объектов структуры отчета.
//
Процедура ОбработчикПередЗаписьюКомпонентовОтчета(ИсточникСобытия, Отказ) Экспорт

	ИсточникСобытия.Код = СокрП(ИсточникСобытия.Код);

КонецПроцедуры // ОбработчикПередЗаписьюКомпонентовОтчета()

// Выполняет запрос по таблице значений, средствами построителя запроса.
//
// Параметры:
//  СтруктураОтбора - ключ     - имя колонки
//			  		- значение - Структура (ВидСравнения,Значение)
//
//  ИменаКолонок	- массив имен колонок, добавляемых в результат запроса.
//
// Возвращаемое значение:
//   РезультатЗапроса
//
Функция РезультатЗапросаПоТаблицеЗначений(Таблица, СтруктураОтбора = Неопределено, Знач ИменаКолонок = Неопределено) Экспорт

	Построитель = Новый ПостроительЗапроса;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(Таблица);
	
	// Поля
	Если Не ИменаКолонок = Неопределено Тогда
		Если ТипЗнч(ИменаКолонок) = Тип("Строка") Тогда
			ИменаКолонок = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ИменаКолонок);
		КонецЕсли;
		
		Построитель.ВыбранныеПоля.Очистить();
		Для Каждого Имя Из ИменаКолонок Цикл
			Построитель.ВыбранныеПоля.Добавить(Имя);
		КонецЦикла;
		
	КонецЕсли;
	
	// Отборы
	Если Не СтруктураОтбора = Неопределено Тогда
		Для Каждого ЭлементОтбораСтруктура Из СтруктураОтбора Цикл
			
			Если ТипЗнч(ЭлементОтбораСтруктура.Значение) = Тип("Структура") Тогда
				ПараметрОтбора = ЭлементОтбораСтруктура.Значение;
			Иначе
				ПараметрОтбора = Новый Структура("ВидСравнения,Значение");
				
				Если ТипЗнч(ЭлементОтбораСтруктура.Значение) = Тип("СписокЗначений") Тогда
					ПараметрОтбора.ВидСравнения = ВидСравнения.ВСписке;
					ПараметрОтбора.Значение		= ЭлементОтбораСтруктура.Значение;
				ИначеЕсли ТипЗнч(ЭлементОтбораСтруктура.Значение) = Тип("Массив") Тогда
					ПараметрОтбора.ВидСравнения = ВидСравнения.ВСписке;
					ПараметрОтбора.Значение		= Новый СписокЗначений;
					ПараметрОтбора.Значение.ЗагрузитьЗначения(ЭлементОтбораСтруктура.Значение);
				Иначе
					ПараметрОтбора.ВидСравнения = ВидСравнения.Равно;
					ПараметрОтбора.Значение		= ЭлементОтбораСтруктура.Значение;
				КонецЕсли;
			КонецЕсли;
			
			ЭлементОтбора = Построитель.Отбор.Добавить(ЭлементОтбораСтруктура.Ключ);
			ЭлементОтбора.ВидСравнения 	= ПараметрОтбора.ВидСравнения;
			ЭлементОтбора.Значение 		= ПараметрОтбора.Значение;
			ЭлементОтбора.Использование = Истина;
			
		КонецЦикла;
	КонецЕсли;
	
	Построитель.Выполнить();
	
	Возврат Построитель.Результат;

КонецФункции // РезультатЗапросаПоТаблицеЗначений()

////////////////////////////////////////////////////////////////////////////////
// ФУНКЦИИ РАБОТЫ С РЕГИСТРОМ СВЕДЕНИЙ "НАСТРОЙКИ ОТЧЕТОВ ПО УМОЛЧАНИЮ".

// Получает настройки для вида отчета, применяемые в текущем контексте.
//
// Параметры:
//  ВидОтчета				 - СправочникСсылка.ВидыОтчетов	 - Вид отчета, для которого необходимо получить настройки.
//  ПериодОтчета			 - СправочникСсылка.Периоды		 - Период для которого необходимо получить настройки.
//  Организация				 - СправочникСсылка.Организации	 - Организация для которой необходимо получить настройки.
//  Редакция				 - СправочникСсылка.РедакцииОтчетности	 - Редакция для которой нужно получить настройки.
//  ИспользуемыеИсточники	 - Строка								 - испольууемые источники данных через запятую. Возможные значения ПользовательскиеНастройкиОтчета,НастройкиПоУмолчанию,БлижайшиеПользовательскиеНастройки,БлижайшиеНастройкиПоУмолчанию
// Возвращаемое значение:
//  Структура - Имена свойств соответствуют ресурсам регистра сведений НастройкиОтчетовПоУмолчанию.
Функция ПолучитьНастройкиОтчета(ВидОтчета, ПериодОтчета, Организация, Редакция = Неопределено,Знач ИспользуемыеИсточники = Неопределено) Экспорт
	
	Если ИспользуемыеИсточники = Неопределено Тогда 
		Если НЕ ЗначениеЗаполнено(Редакция) Тогда 
			ИспользуемыеИсточники = "ПользовательскиеНастройкиОтчета,НастройкиПоУмолчанию,БлижайшиеПользовательскиеНастройки,БлижайшиеНастройкиПоУмолчанию";
		Иначе 
			ИспользуемыеИсточники = "ПользовательскиеНастройкиОтчета,НастройкиПоУмолчанию";
		КонецЕсли;	
	КонецЕсли;
	ИспользуемыеИсточникиМассив = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ИспользуемыеИсточники);
	
	Результат = Неопределено;
	
	Если ИспользуемыеИсточникиМассив.Найти("ПользовательскиеНастройкиОтчета") <> Неопределено Тогда 
		Результат = ПолучитьПользовательскиеНастройкиОтчета(ВидОтчета, ПериодОтчета, Организация, Редакция);
		Если Результат <> Неопределено Тогда 
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Если ИспользуемыеИсточникиМассив.Найти("НастройкиПоУмолчанию") <> Неопределено Тогда 
		Результат = ПолучитьНастройкиПоУмолчанию(ВидОтчета, ПериодОтчета, Редакция);
		Если Результат <> Неопределено Тогда 
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Если ИспользуемыеИсточникиМассив.Найти("БлижайшиеПользовательскиеНастройки") <> Неопределено Тогда 
		Результат = ПолучитьБлижайшиеПользовательскиеНастройки(ВидОтчета, ПериодОтчета, Организация);
		Если Результат <> Неопределено Тогда 
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Если ИспользуемыеИсточникиМассив.Найти("БлижайшиеНастройкиПоУмолчанию") <> Неопределено Тогда 
		Результат = ПолучитьБлижайшиеНастройкиПоУмолчанию(ВидОтчета, ПериодОтчета);
		Если Результат <> Неопределено Тогда 
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // ПолучитьНастройкиОтчета()

Функция ПолучитьПользовательскиеНастройкиОтчета(ВидОтчета, ПериодОтчета, Организация, Редакция)

	Запрос = Новый Запрос();
	
	ТекстУсловияПриказ = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИспользуемыеНастройкиОтчетов.Редакция
		|ИЗ
		|	РегистрСведений.ИспользуемыеНастройкиОтчетов КАК ИспользуемыеНастройкиОтчетов
		|ГДЕ
		|	ИспользуемыеНастройкиОтчетов.ВидОтчета = &ВидОтчета
		|	И ИспользуемыеНастройкиОтчетов.Редакция.ДатаДействия <= &ДатаДействия
		|
		|УПОРЯДОЧИТЬ ПО
		|	ИспользуемыеНастройкиОтчетов.Редакция.ДатаДействия УБЫВ";
		
	ТекстУсловияПериодичность = "";
	
	Если ЗначениеЗаполнено(Редакция) Тогда // Редакция указана
		
		Если ТипЗнч(Редакция) = Тип("СправочникСсылка.РедакцииОтчетности") Тогда // в виде ссылки справочника РедакцииОтчетов.

			ТекстУсловияПриказ = "&ПриказОбОтчетности";
			Запрос.УстановитьПараметр("ПриказОбОтчетности",Редакция);
			
		ИначеЕсли ТипЗнч(Редакция) = Тип("Дата") Тогда // в виде даты.
			
			Запрос.УстановитьПараметр("ДатаДействия",Редакция);
			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ПериодОтчета) = Тип("СправочникСсылка.РедакцииОтчетности") Тогда // Редакция указана в параметре "ПериодОтчета"
		
		ТекстУсловияПриказ = "&ПриказОбОтчетности";
		Запрос.УстановитьПараметр("ПриказОбОтчетности",ПериодОтчета);
		
	Иначе
		
		Запрос.УстановитьПараметр("ДатаДействия", ТекущаяДатаСеанса());

	КонецЕсли;
	
	// Фильтр по периоду отчета
	Если ТипЗнч(ПериодОтчета) = Тип("СправочникСсылка.Периоды") и Не ПериодОтчета.Пустая() Тогда
		
		Если Не ПериодОтчета.Произвольный Тогда
			ТекстУсловияПериодичность = "ИЛИ ИспользуемыеНастройкиОтчетов.Периодичность = &Периодичность";
			Запрос.УстановитьПараметр("Периодичность",ПериодОтчета.Периодичность);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Редакция) Тогда
			Запрос.УстановитьПараметр("ДатаДействия",КонецДня(ПериодОтчета.ДатаОкончания) + 1);
		КонецЕсли;
			
	КонецЕсли;
		
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ИспользуемыеНастройкиОтчетов.Организация КАК Организация,
	|	ИспользуемыеНастройкиОтчетов.Редакция.ДатаДействия КАК ДатаДействия,
	|	ИспользуемыеНастройкиОтчетов.БланкДляОтображения,
	|	ИспользуемыеНастройкиОтчетов.БланкДляПечати,
	|	ИспользуемыеНастройкиОтчетов.ПравилоОбработки,
	|	ИспользуемыеНастройкиОтчетов.ПравилоПроверки
	|ИЗ
	|	РегистрСведений.ИспользуемыеНастройкиОтчетов КАК ИспользуемыеНастройкиОтчетов
	|ГДЕ
	|	ИспользуемыеНастройкиОтчетов.ВидОтчета = &ВидОтчета
	|	И ИспользуемыеНастройкиОтчетов.Организация В (&Организация, ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка))
	|	И (ИспользуемыеНастройкиОтчетов.Периодичность = &ПериодПустаяСсылка "+ТекстУсловияПериодичность+")
	|	И ИспользуемыеНастройкиОтчетов.Редакция В("+ТекстУсловияПриказ+")
	|
	|УПОРЯДОЧИТЬ ПО
	|	Организация УБЫВ,
	|	Периодичность УБЫВ";
		
	
	Запрос.УстановитьПараметр("ВидОтчета"		,ВидОтчета);
	Запрос.УстановитьПараметр("Организация"		,Организация);
	Запрос.УстановитьПараметр("ПериодПустаяСсылка", БюджетнаяОтчетностьСервер.ПолучитьМенеджерПериодичность().ПустаяСсылка());
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда	
		СтруктураНастроек = Новый Структура("Источник,БланкДляОтображения,БланкДляПечати,ПравилоОбработки,ПравилоПроверки","ПользовательскиеНастройкиОтчета");
		ЗаполнитьЗначенияСвойств(СтруктураНастроек,Выборка);
		Возврат СтруктураНастроек;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции // ПолучитьНастройкиОтчета()

