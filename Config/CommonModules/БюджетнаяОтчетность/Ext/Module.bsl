Функция ДоступныНовыеВерсииКомплектов(ИмяФормы = Неопределено,ПроверятьПрава=Ложь) Экспорт
	
	//комплект загружается только в главном узле	
	Если ОбщегоНазначения.ЭтоПодчиненныйУзелРИБ() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ОбщегоНазначения.РазделениеВключено()
		И НЕ ОбщегоНазначения.ДоступноИспользованиеРазделенныхДанных() Тогда 
		//это неразделенный режим в разделенной базе, ничего делать не нужно
		Возврат Ложь;
	КонецЕсли;
	
	ТекРаботаВЛокальномРежиме = ПолучитьФункциональнуюОпцию("РаботаВЛокальномРежиме");
	ТекРаботаВМоделиСервиса = ПолучитьФункциональнуюОпцию("РаботаВМоделиСервиса");
	
	ИмяФормы = "";
	Если ТекРаботаВЛокальномРежиме Тогда
		ИмяФормы = "Обработка.ИмпортКейса.Форма.ФормаЗагрузкиКомплектовСоСтраницыПоддержки";
	ИначеЕсли ТекРаботаВМоделиСервиса Тогда
		ИмяФормы = "Обработка.ИмпортКейса.Форма.ФормаЗагрузкиКомплектовИзПоставляемыхДанных";
	КонецЕсли;
	
	Если ПроверятьПрава=Истина Тогда
		//если нужно проверять права, то смотрим, может ли пользвоатель загружать комплекты
		Если ПравоДоступа("Просмотр", Метаданные.Обработки.ИмпортКейса) = Ложь Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	ЕстьНоваяВерсия = Ложь;		
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	УстановленныеКомплектыОтчетности.ИдентификаторКомплекта КАК ИдентификаторКомплекта,
		|	УстановленныеКомплектыОтчетности.Версия КАК ТекущаяВерсия,
		|	ДоступныеКомплектыОтчетности.Версия КАК ДоступнаяВерсия
		|ИЗ
		|	РегистрСведений.УстановленныеКомплектыОтчетности КАК УстановленныеКомплектыОтчетности
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДоступныеКомплектыОтчетности КАК ДоступныеКомплектыОтчетности
		|		ПО УстановленныеКомплектыОтчетности.ИдентификаторКомплекта = ДоступныеКомплектыОтчетности.ИдентификаторКомплекта
		|ГДЕ
		|	УстановленныеКомплектыОтчетности.НеИспользуется = ЛОЖЬ
		|	И УстановленныеКомплектыОтчетности.Версия <> ДоступныеКомплектыОтчетности.Версия";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		РезультатСравнения = Обработки.ИмпортКейса.СравнитьВерсииКомплектов(ВыборкаДетальныеЗаписи.ДоступнаяВерсия, ВыборкаДетальныеЗаписи.ТекущаяВерсия);
		
		Если РезультатСравнения.Результат>0 Тогда		
			ЕстьНоваяВерсия = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЕстьНоваяВерсия;
	
КонецФункции

Процедура ПриЗаписиПоставляемыхДанныхБГУ(Источник, Отказ) Экспорт

	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ВидДанныхКомплект = "КомплектОтчГосУчр";
	
	Если Источник.ВидДанных <> ВидДанныхКомплект Тогда
		Возврат;
	КонецЕсли;
	
	ВерсияИзПоставляемыхДанных = "";
	НаименованиеКомплекта = "";
	ИдентификаторКомплекта = "";
	Описание = "";
	
	Для Каждого СтрТЧ Из Источник.ХарактеристикиДанных Цикл
		Если СтрТЧ.Характеристика = "Идентификатор" Тогда
			ИдентификаторКомплекта = СтрТЧ.Значение;
		ИначеЕсли СтрТЧ.Характеристика = "Представление"
			ИЛИ СтрТЧ.Характеристика = "Наименование" Тогда
			//В типовой обработке представление формируесят как "Комплект отчетности (" + ОписаниеКомплекта.title + ")"
			НаименованиеКомплекта = СтрТЧ.Значение;
			Если СтрНачинаетсяС(НаименованиеКомплекта,"Комплект отчетности (") Тогда
				ДлинаНаименования = СтрДлина(НаименованиеКомплекта);
				ДлинаПрефикса = СтрДлина("Комплект отчетности (");
				НаименованиеКомплекта = Сред(НаименованиеКомплекта,ДлинаПрефикса+1,ДлинаНаименования-ДлинаПрефикса-1);
			КонецЕсли;
		ИначеЕсли СтрТЧ.Характеристика = "ОписаниеДанных"
			ИЛИ СтрТЧ.Характеристика = "ОписаниеВерсии" Тогда
			Описание = СтрТЧ.Значение;
			//В описани есть Версия комплекта
			МассивСтрокОписаний = СтрРазделить(Описание,Символы.ПС,Ложь);
			Для Каждого ЧастьОписания Из МассивСтрокОписаний Цикл
				Если СтрНачинаетсяС(ЧастьОписания,"Версия ") Тогда
					ВерсияИзПоставляемыхДанных = СокрЛП(Сред(ЧастьОписания,СтрДлина("Версия ")+1));
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	МассивУстаревшихИдКомплектов = БюджетнаяОтчетность.ПолучитьМассивУстаревшихИдКомплектов();
	
	Если МассивУстаревшихИдКомплектов.Найти(ИдентификаторКомплекта) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВерсияИзПоставляемыхДанных)
		И ЗначениеЗаполнено(ИдентификаторКомплекта) Тогда
		
		ВерсияВРегистре = Неопределено;
		
		УстановитьПривилегированныйРежим(Истина);
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ИдентификаторКомплекта", ИдентификаторКомплекта);
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	СОКРЛП(ДоступныеКомплектыОтчетности.Версия) КАК Версия
			|ИЗ
			|	РегистрСведений.ДоступныеКомплектыОтчетности КАК ДоступныеКомплектыОтчетности
			|ГДЕ
			|	ДоступныеКомплектыОтчетности.ИдентификаторКомплекта = &ИдентификаторКомплекта";
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			ВерсияВРегистре = ВыборкаДетальныеЗаписи.Версия;
		КонецЕсли;
		
		Если ВерсияВРегистре <> ВерсияИзПоставляемыхДанных Тогда
			ЗаписьРС = РегистрыСведений.ДоступныеКомплектыОтчетности.СоздатьМенеджерЗаписи();
			ЗаписьРС.ИдентификаторКомплекта = ИдентификаторКомплекта;
			ЗаписьРС.Версия = ВерсияИзПоставляемыхДанных;
			ЗаписьРС.Наименование = НаименованиеКомплекта;
			ЗаписьРС.Записать(Истина);	
		КонецЕсли;
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;		

КонецПроцедуры

Функция ПолучитьМассивУстаревшихИдКомплектов() Экспорт
	
	МассивУстаревшихИдКомплектов = Новый Массив;
	МассивУстаревшихИдКомплектов.Добавить("urn:entities-1c-ru:reports/case-metadata/staterep/33/2.0"); //33н, устарел с 2018
	МассивУстаревшихИдКомплектов.Добавить("urn:entities-1c-ru:reports/case-metadata/staterep/191/2.0");//191н, устарел с 2018
	МассивУстаревшихИдКомплектов.Добавить("urn:entities-1c-ru:reports/case-metadata/forep/2.0");       //ФО, устарел с 2018
	МассивУстаревшихИдКомплектов.Добавить("urn:entities-1c-ru:reports/case-metadata/000000025");       //правила заполнения долгосрочной, просроченной 191н 
	МассивУстаревшихИдКомплектов.Добавить("urn:entities-1c-ru:reports/case-metadata/000000024");       //правила заполнения долгосрочной, просроченной 33н
	МассивУстаревшихИдКомплектов.Добавить("urn:entities-1c-ru:reports/case-metadata/staterep/2.0");    //общий комплект, устарел давно
	МассивУстаревшихИдКомплектов.Добавить("urn:entities-1c-ru:reports/case-metadata/staterep-bgu2");   //комплект только для БГУ2, устарел давно	
	
	БюджетнаяОтчетностьСерверПереопределяемый.ПриЗаполненииУстаревшихКомплектов(МассивУстаревшихИдКомплектов);
	
	Возврат МассивУстаревшихИдКомплектов;
	
КонецФункции

//Информирование о новой версии комплекта
Процедура ДобавитьИнформационнуюПанельНаФорму(ЭлементыФормы) Экспорт
			
	НужноВыводитьПанельНовыеВерсииКомплектов = БюджетнаяОтчетность.ДоступныНовыеВерсииКомплектов();
	
	Если НужноВыводитьПанельНовыеВерсииКомплектов Тогда
		ТекРаботаВЛокальномРежиме = ПолучитьФункциональнуюОпцию("РаботаВЛокальномРежиме");
		ТекРаботаВМоделиСервиса = ПолучитьФункциональнуюОпцию("РаботаВМоделиСервиса");
	
		ИнфПанели = ЭлементыФормы.Найти("ИнформационныеПанели");
		ГруппаСообщение = ЭлементыФормы.Добавить("ГруппаИнформированияОКомплекте", Тип("ГруппаФормы"), ИнфПанели);
		ГруппаСообщение.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		ГруппаСообщение.Отображение = ОтображениеОбычнойГруппы.Нет;
		ГруппаСообщение.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
		ГруппаСообщение.ОтображатьЗаголовок = Ложь;	
		ГруппаСообщение.ЦветФона = ЦветаСтиля.ЦветФонаПодсказки;
		ГруппаСообщение.РастягиватьПоГоризонтали = Истина;
		
		НоваяВерсияКомплектаДекорацияКартинка = ЭлементыФормы.Добавить("НоваяВерсияКомплектаДекорацияКартинка", Тип("ДекорацияФормы"),ГруппаСообщение);
		НоваяВерсияКомплектаДекорацияКартинка.Вид = ВидДекорацииФормы.Картинка;
		НоваяВерсияКомплектаДекорацияКартинка.Картинка = БиблиотекаКартинок.ИнформацияНовости16Статичная;	
		
		НоваяВерсияКомплектаДекорацияНадписьСообщение = ЭлементыФормы.Добавить("НоваяВерсияКомплектаДекорацияНадписьСообщение", Тип("ДекорацияФормы"),ГруппаСообщение);
		НоваяВерсияКомплектаДекорацияНадписьСообщение.Вид = ВидДекорацииФормы.Надпись;
		НоваяВерсияКомплектаДекорацияНадписьСообщение.АвтоМаксимальнаяШирина = Ложь;
		
		Если ПравоДоступа("Просмотр", Метаданные.Обработки.ИмпортКейса) Тогда   
			НоваяВерсияКомплектаДекорацияНадписьСообщение.Заголовок = НСтр("ru='Доступны новые версии комплектов бухгалтерской/бюджетной отчетности. '");
			
			Если ТекРаботаВЛокальномРежиме Тогда
				НоваяВерсияКомплектаДекорацияНадписьЗагрузить = ЭлементыФормы.Добавить("НоваяВерсияКомплектаДекорацияНадписьЗагрузитьЛокально", Тип("ДекорацияФормы"),ГруппаСообщение);
			ИначеЕсли ТекРаботаВМоделиСервиса Тогда
				НоваяВерсияКомплектаДекорацияНадписьЗагрузить = ЭлементыФормы.Добавить("НоваяВерсияКомплектаДекорацияНадписьЗагрузитьОблако", Тип("ДекорацияФормы"),ГруппаСообщение);
			КонецЕсли;
			
			НоваяВерсияКомплектаДекорацияНадписьЗагрузить.Вид = ВидДекорацииФормы.Надпись;
			НоваяВерсияКомплектаДекорацияНадписьЗагрузить.Заголовок = НСтр("ru='Загрузить'");
			
			НоваяВерсияКомплектаДекорацияНадписьЗагрузить.Гиперссылка = Истина;
			НоваяВерсияКомплектаДекорацияНадписьЗагрузить.УстановитьДействие("Нажатие", "Подключаемый_ВыполнитьНазначаемуюКоманду");
		Иначе
			НоваяВерсияКомплектаДекорацияНадписьСообщение.Заголовок = НСтр("ru='Доступны новые версии комплектов бухгалтерской/бюджетной отчетности. Для загрузки обратитесь к администратору.'");	
		КонецЕсли;			
		
		НоваяВерсияКомплектаДекорацияНадписьЗакрыть = ЭлементыФормы.Добавить("НоваяВерсияКомплектаДекорацияНадписьЗакрыть", Тип("ДекорацияФормы"),ГруппаСообщение);
		НоваяВерсияКомплектаДекорацияНадписьЗакрыть.Вид = ВидДекорацииФормы.Надпись;
		НоваяВерсияКомплектаДекорацияНадписьЗакрыть.Заголовок = "Закрыть";
		НоваяВерсияКомплектаДекорацияНадписьЗакрыть.Гиперссылка = Истина;
		НоваяВерсияКомплектаДекорацияНадписьЗакрыть.АвтоМаксимальнаяШирина = Ложь;
		НоваяВерсияКомплектаДекорацияНадписьЗакрыть.ГоризонтальноеПоложениеВГруппе = ГоризонтальноеПоложениеЭлемента.Право;
		НоваяВерсияКомплектаДекорацияНадписьЗакрыть.УстановитьДействие("Нажатие", "Подключаемый_ВыполнитьНазначаемуюКоманду");
	КонецЕсли;		
КонецПроцедуры

