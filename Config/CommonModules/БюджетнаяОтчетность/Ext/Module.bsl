// ФУНКЦИИ РАБОТЫ С СОГЛАСОВАННЫМИ АНАЛИТИКАМИ
//

// Функция возвращает дерево настроек согласованных аналитик БК и параметров работы с ними.
// Параметры:
// АналитикаГруппыРаскрытия - Таблица значений аналитик группы раскрытия, не обязательно
//
// Возвращаемое значение:
//   Дерево значений, описывающее схему работы согласованных аналитик БК
//
Функция ПараметрыВыбораСогласованныхАналитик(АналитикаГруппыРаскрытия=Неопределено) Экспорт

	ДеревоТипов = Новый ДеревоЗначений;
	ДеревоТипов.Колонки.Добавить("ТипДанных" 	,Новый ОписаниеТипов("Тип"));
	
	ДеревоТипов.Колонки.Добавить("ВидАналитики"	,Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.АналитикаОтчетов"));

	//заполняется только в том случае, если в текущей группе раскрытия для главного вида аналитики(детализируемого)
	//присутствует только 1 детальный вид аналитики
	ДеревоТипов.Колонки.Добавить("ДетальныйВидАналитики",Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.АналитикаОтчетов"));

	ДеревоТипов.Колонки.Добавить("Отбор" 	  	,Новый ОписаниеТипов("Структура"));
	ДеревоТипов.Колонки.Добавить("СвязиОтбора" 	,Новый ОписаниеТипов("ТаблицаЗначений"));
	ДеревоТипов.Колонки.Добавить("СвязиВыбора" 	,Новый ОписаниеТипов("ТаблицаЗначений"));
	ДеревоТипов.Колонки.Добавить("ФормаВыбора");
	
	Если АналитикаГруппыРаскрытия <> Неопределено Тогда
		ДополнитьСвязаннымиАналитикамиГруппыРаскрытия(ДеревоТипов, АналитикаГруппыРаскрытия);		
	КонецЕсли;
	
	////////////////////////////////////////////////////////////////////////////////
	// КЛАССИФИКАЦИЯ ДОХОДОВ.
	
	// Группа
	СтрГруппа             = ДеревоТипов.Строки.Добавить();
	СтрГруппа.ТипДанных   = Тип("СправочникСсылка.ГруппыПодгруппыКДБ");
	СтрГруппа.ФормаВыбора = "ПолнаяКлассификация";
	ДобавитьСвязьВыбора(СтрГруппа, Неопределено, 1, Тип("СправочникСсылка.СтатьиПодстатьиКДБ"));
	ДобавитьСвязьВыбора(СтрГруппа, Неопределено, 2, Тип("СправочникСсылка.ПодвидыКДБ"));
	// Статья
	СтрСтатья           = СтрГруппа.Строки.Добавить();
	СтрСтатья.ТипДанных = Тип("СправочникСсылка.СтатьиПодстатьиКДБ");
	ДобавитьСвязьВыбора(СтрСтатья, "Владелец", -1, Тип("СправочникСсылка.ГруппыПодгруппыКДБ"));
	ДобавитьСвязьВыбора(СтрСтатья, Неопределено, 1, Тип("СправочникСсылка.ПодвидыКДБ"));
	// Подвид
	СтрПодвид           = СтрСтатья.Строки.Добавить();
	СтрПодвид.ТипДанных = Тип("СправочникСсылка.ПодвидыКДБ");
	ДобавитьСвязьВыбора(СтрПодвид, "Владелец", -1, Тип("СправочникСсылка.СтатьиПодстатьиКДБ"));
	ДобавитьСвязьВыбора(СтрПодвид, "Владелец.Владелец", -2, Тип("СправочникСсылка.ГруппыПодгруппыКДБ"));
	
	
	// КЛАССИФИКАЦИЯ ДОХОДОВ 2016.
	
	// ВидДохода
	СтрГруппа             = ДеревоТипов.Строки.Добавить();
	СтрГруппа.ТипДанных   = Тип("СправочникСсылка.ВидыДоходовКДБ");
	СтрГруппа.ФормаВыбора = "ПолнаяКлассификация";
	ДобавитьСвязьВыбора(СтрГруппа, "ГруппаПодвида", 1, Тип("СправочникСсылка.ГруппыПодвидовКДБ"));
	ДобавитьСвязьВыбора(СтрГруппа, "АналитическаяГруппа", 2, Тип("СправочникСсылка.КОСГУ"));
	// ПодвидДохода
	СтрСтатья           = СтрГруппа.Строки.Добавить();
	СтрСтатья.ТипДанных = Тип("СправочникСсылка.ГруппыПодвидовКДБ");
	ДобавитьСвязьВыбора(СтрСтатья, "ВидДохода", -1, Тип("СправочникСсылка.ВидыДоходовКДБ"));
	ДобавитьСвязьОтбора(СтрСтатья, "ВидДохода", -1);
	
	// АналитическаяГруппа
	СтрСтатья           = СтрГруппа.Строки.Добавить();
	СтрСтатья.ТипДанных = Тип("СправочникСсылка.КОСГУ");
	ДобавитьСвязьВыбора(СтрСтатья, "АналитическаяГруппа", -2, Тип("СправочникСсылка.ВидыДоходовКДБ"));
	ДобавитьСвязьОтбора(СтрСтатья, "ВидДохода", -2);
	
	////////////////////////////////////////////////////////////////////////////////
	// ЦЕЛЕВЫЕ СТАТЬИ РАСХОДОВ.
	
	// Целевая статья
	СтрЦелеваяСтатья 			 = ДеревоТипов.Строки.Добавить();
	СтрЦелеваяСтатья.ТипДанных 	 = Тип("СправочникСсылка.ЦелевыеСтатьиКРБ");
	СтрЦелеваяСтатья.ФормаВыбора = "ПолнаяКлассификация";
	ДобавитьСвязьВыбора(СтрЦелеваяСтатья, Неопределено, 1, Тип("СправочникСсылка.ПрограммыЦелевыхСтатейКРБ"));
	ДобавитьСвязьВыбора(СтрЦелеваяСтатья, Неопределено, 2, Тип("СправочникСсылка.ПодпрограммыЦелевыхСтатейКРБ"));
	// Программа ЦС
	СтрПрограммаЦС 				= СтрЦелеваяСтатья.Строки.Добавить();
	СтрПрограммаЦС.ТипДанных    = Тип("СправочникСсылка.ПрограммыЦелевыхСтатейКРБ");
	
	ДобавитьСвязьВыбора(СтрПрограммаЦС, "ЦелеваяСтатья", -1, Тип("СправочникСсылка.ЦелевыеСтатьиКРБ"), 2);
	ДобавитьСвязьВыбора(СтрПрограммаЦС, Неопределено, 1, Тип("СправочникСсылка.ПодпрограммыЦелевыхСтатейКРБ"));
	// Подпрограмма ЦС
	СтрПодпрограмма 			= СтрПрограммаЦС.Строки.Добавить();
	СтрПодпрограмма.ТипДанных	= Тип("СправочникСсылка.ПодпрограммыЦелевыхСтатейКРБ");
	СтрПодпрограмма.ФормаВыбора = "";
	ДобавитьСвязьВыбора(СтрПодпрограмма, "Владелец", -1, Тип("СправочникСсылка.ПрограммыЦелевыхСтатейКРБ"));
	ДобавитьСвязьВыбора(СтрПодпрограмма, "Владелец.ЦелеваяСтатья", -2, Тип("СправочникСсылка.ЦелевыеСтатьиКРБ"), 2);
	
	////////////////////////////////////////////////////////////////////////////////
	// КЛАССИФИКАЦИЯ ИСТОЧНИКОВ ФИНАНСИРОВАНИЯ.
	
	// Группа
	СтрГруппа 			  = ДеревоТипов.Строки.Добавить();
	СтрГруппа.ТипДанных   = Тип("СправочникСсылка.ГруппыПодгруппыКИФ");
	СтрГруппа.ФормаВыбора = "ПолнаяКлассификация";
	ДобавитьСвязьВыбора(СтрГруппа, "СтатьяКИФ", 1, Тип("СправочникСсылка.СтатьиКИФ"));
	ДобавитьСвязьВыбора(СтрГруппа, "ПодвидВидаКИФ", 2, Тип("СправочникСсылка.ВидыКИФ"));
	ДобавитьСвязьВыбора(СтрГруппа, "АнГруппаКИФ", 3, Тип("СправочникСсылка.КОСГУ"));
	
	// Статья
	СтрСтатья 			= СтрГруппа.Строки.Добавить();
	СтрСтатья.ТипДанных = Тип("СправочникСсылка.СтатьиКИФ");
	ДобавитьСвязьВыбора(СтрСтатья, "ГруппаПодгруппаКИФ", -1, Тип("СправочникСсылка.ГруппыПодгруппыКИФ"));
	ДобавитьСвязьВыбора(СтрСтатья, "ПодвидВидаКИФ", 1, Тип("СправочникСсылка.ВидыКИФ"));
	ДобавитьСвязьВыбора(СтрСтатья, "АнГруппаКИФ", 2, Тип("СправочникСсылка.КОСГУ"));
	
	// Вид КИФ
	СтрПодвид			= СтрСтатья.Строки.Добавить();
	СтрПодвид.ТипДанных = Тип("СправочникСсылка.ВидыКИФ");
	ДобавитьСвязьВыбора(СтрПодвид, "СтатьяКИФ", -1, Тип("СправочникСсылка.СтатьиКИФ"));
	ДобавитьСвязьВыбора(СтрПодвид, "ГруппаПодгруппаКИФ", -2, Тип("СправочникСсылка.ГруппыПодгруппыКИФ"));
	ДобавитьСвязьВыбора(СтрПодвид, "АнГруппаКИФ", 1, Тип("СправочникСсылка.КОСГУ"));
		
	////////////////////////////////////////////////////////////////////////////////
	// ГЛАВЫ ПО БК+БЮДЖЕТ+ЭЛЕМЕНТ БЮДЖЕТА
	
	// Глава по БК
	СтрГлава = ДеревоТипов.Строки.Добавить();
	СтрГлава.ТипДанных 	 = Тип("СправочникСсылка.ГлавыПоБюджетнойКлассификации");
	СтрГлава.СвязиВыбора = СоздатьТаблицуСвязейВыбораАналитики();
	СтрГлава.ФормаВыбора = "";
	ДобавитьСвязьВыбора(СтрГлава, "Бюджет", 1, Тип("СправочникСсылка.Бюджеты"));
	ДобавитьСвязьВыбора(СтрГлава, "Бюджет.Элемент", 2, Тип("СправочникСсылка.ЭлементыБюджета"));
	// Бюджет
	СтрБюджет 			  = СтрГлава.Строки.Добавить();
	СтрБюджет.ТипДанных   = Тип("СправочникСсылка.Бюджеты");
	СтрБюджет.ФормаВыбора = "";
	ДобавитьСвязьВыбора(СтрБюджет, "Элемент", 1, Тип("СправочникСсылка.ЭлементыБюджета"));
	
	////////////////////////////////////////////////////////////////////////////////
	// специфичные для конфигураций 
	
	БюджетнаяОтчетностьСерверПереопределяемый.ДополнитьПараметрыВыбораСогласованныхАналитик(ДеревоТипов);	
	
	Возврат ДеревоТипов;

КонецФункции // ПараметрыВыбораСогласованныхАналитик()

Процедура ДополнитьСвязаннымиАналитикамиГруппыРаскрытия(ДеревоТипов,АналитикаГруппыРаскрытия)
	
	//Принцип работы:
	//Процедура дополняет дерево сценариев выбора связанными аналитиками произвольного классификатора текущей группы раскрытия.
	//Особенности реализации:
	//1. Если есть независимые пары Главная - Детальная, то при выборе значения в любой из ячеек этих аналитик
	//доступен выбор полной классификации, и можно выбрать сразу значения для двух аналитик, как в классификаторе Целевых статей расходов.
	//2. Если для Главной аналитики в текущей группе раскрытия есть только 1 детальный вид аналитики, 
	//и Главная аналитики не является детальной аналитикой для другой аналитики,
	//то эта пара аналитик считаются независимой парой и при выборе значения в главной ячейке доступен выбор полной классификации, как в п.1.
	//3. Если для Главной аналитики в текущей группе раскрытия есть несколько детальных видов аналитики,
	//то при выборе значения в главной аналитике доступен выбор значений этой главной аналитики, без детальных.
	//4. Есля Главная аналитика является детальной аналитикой для другой аналитики,
	//то при выборе значения в главной аналитике выполняется выбор как в п.5
	//5. При выборе значения в каждой из детальных аналитик - доступен выбор значений этих аналитик с отбором по значению главной аналитики.
	//Если при этом значение главной аналитики не заполнено, то доступен выбор из полной классификации.
	
	СоответствиеАналитикИндексов = Новый Соответствие;
	МассивАнализируемыхАналитик = Новый Массив;
	ТипСубконто = Тип("СправочникСсылка.Субконто");
	Для Каждого СтрТЧ Из АналитикаГруппыРаскрытия Цикл
		Если ЗначениеЗаполнено(СтрТЧ.ВидАналитики)
			И СтрТЧ.ТипЗначения.СодержитТип(ТипСубконто) Тогда
			МассивАнализируемыхАналитик.Добавить(СтрТЧ.ВидАналитики);
			СоответствиеАналитикИндексов.Вставить(СтрТЧ.ВидАналитики,АналитикаГруппыРаскрытия.Индекс(СтрТЧ));
		КонецЕсли;
	КонецЦикла;
	
	Если МассивАнализируемыхАналитик.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	АналитикаОтчетов.Код КАК Код,
		|	АналитикаОтчетов.ПубличныйИдентификатор КАК ПубличныйИдентификатор,
		|	АналитикаОтчетов.АналитикаВладелецКод КАК АналитикаВладелецКод,
		|	АналитикаОтчетов.АналитикаВладелецПубличныйИдентификатор КАК АналитикаВладелецПубличныйИдентификатор,
		|	АналитикаОтчетов.Ссылка КАК Ссылка
		|ИЗ
		|	ПланВидовХарактеристик.АналитикаОтчетов КАК АналитикаОтчетов
		|ГДЕ
		|	АналитикаОтчетов.Ссылка В(&МассивСсылок)";
	
	Запрос.УстановитьПараметр("МассивСсылок", МассивАнализируемыхАналитик);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТаблицаРеквизитов = РезультатЗапроса.Выгрузить();
	
	ЕстьДетальные = Ложь;
	//на всякий случай
	Для Каждого СтрТЧ Из ТаблицаРеквизитов Цикл
		СтрТЧ.ПубличныйИдентификатор = СокрЛП(СтрТЧ.ПубличныйИдентификатор);
		СтрТЧ.АналитикаВладелецКод = СокрЛП(СтрТЧ.АналитикаВладелецКод);
		СтрТЧ.Код = СокрЛП(СтрТЧ.Код);
		СтрТЧ.АналитикаВладелецПубличныйИдентификатор = СокрЛП(СтрТЧ.АналитикаВладелецПубличныйИдентификатор);
		
		ЕстьДетальные = ЕстьДетальные ИЛИ ЗначениеЗаполнено(СтрТЧ.АналитикаВладелецКод);
	КонецЦикла;
	
	Если ЕстьДетальные = Ложь Тогда
		Возврат;//связанных аналитик нет
	КонецЕсли;
	
	ТаблицаРеквизитов.Индексы.Добавить("Код,ПубличныйИдентификатор");
	ТаблицаРеквизитов.Индексы.Добавить("АналитикаВладелецКод,АналитикаВладелецПубличныйИдентификатор");
	
	Для Каждого СтрТЧ Из ТаблицаРеквизитов Цикл
		Если ЗначениеЗаполнено(СтрТЧ.АналитикаВладелецКод)
			И ЗначениеЗаполнено(СтрТЧ.АналитикаВладелецПубличныйИдентификатор) Тогда
			
			ДетальнаяАналитика = СтрТЧ.Ссылка;
			
			//это возможная детальная аналитика
			СтруктураПоиска = Новый Структура("Код,ПубличныйИдентификатор",СтрТЧ.АналитикаВладелецКод,СтрТЧ.АналитикаВладелецПубличныйИдентификатор);
			МассивНайденныхСтрок = ТаблицаРеквизитов.НайтиСтроки(СтруктураПоиска);
			Если МассивНайденныхСтрок.Количество()>0 Тогда //найдена пара
				
				ГлавнаяАналитика = МассивНайденныхСтрок[0].Ссылка;
				
				ИндексГлавнойСтроки = СоответствиеАналитикИндексов[ГлавнаяАналитика];
				ИндексДетальнойСтроки = СоответствиеАналитикИндексов[ДетальнаяАналитика];
				
				СмещениеГл = 1;//по умолчанию считаем, что детальная идет следующей				
				СмещениеГл = ИндексДетальнойСтроки - ИндексГлавнойСтроки;//смещение детальной аналитики относительно главной в порядке аналитик группы раскрытия
								
				//Проверим, есть ли еще детальные аналитики для этой главной аналитики
				СтруктураПоискаДетальных = Новый Структура("АналитикаВладелецКод,АналитикаВладелецПубличныйИдентификатор",СтрТЧ.АналитикаВладелецКод,СтрТЧ.АналитикаВладелецПубличныйИдентификатор);
				МассивНайденныхДетальных = ТаблицаРеквизитов.НайтиСтроки(СтруктураПоискаДетальных);
				
				ЭтоНезависимаяПараАналитик = Истина;
				Если МассивНайденныхДетальных.Количество()>1 Тогда//есть несколько детальных для этой главной аналитики
					ЭтоНезависимаяПараАналитик = Ложь;
				КонецЕсли;
				
				Если ЭтоНезависимаяПараАналитик Тогда
					//если детальная только одна, проверим, что главная не является детальной для другой аналитики
					Если ЗначениеЗаполнено(МассивНайденныхСтрок[0].АналитикаВладелецКод)
						И ЗначениеЗаполнено(МассивНайденныхСтрок[0].АналитикаВладелецПубличныйИдентификатор) Тогда
						
						СтруктураПоискаГлавной = Новый Структура("АналитикаВладелецКод,АналитикаВладелецПубличныйИдентификатор",МассивНайденныхСтрок[0].АналитикаВладелецКод,МассивНайденныхСтрок[0].АналитикаВладелецПубличныйИдентификатор);
						МассивНайденныхГлавных = ТаблицаРеквизитов.НайтиСтроки(СтруктураПоискаГлавной);
						Если МассивНайденныхГлавных.Количество()>0 Тогда
							//это пара аналитик 2-3, из цепочки 1-2-3
							ЭтоНезависимаяПараАналитик = Ложь;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
				СтрГлавная              = ДеревоТипов.Строки.Добавить();
				СтрГлавная.ТипДанных    = Тип("СправочникСсылка.Субконто");
				СтрГлавная.ВидАналитики = ГлавнаяАналитика;
				
				//устанавливается в случае, если для данной главной аналитики в текущей группе раскрытия есть только 1 детальный вид аналитики
				Если ЭтоНезависимаяПараАналитик Тогда
					СтрГлавная.ДетальныйВидАналитики = ДетальнаяАналитика; 
				КонецЕсли;
				
				СтрГлавная.ФормаВыбора  = "ПолнаяКлассификация";
					
				ДобавитьСвязьВыбора(СтрГлавная, Неопределено, СмещениеГл, Тип("СправочникСсылка.Субконто"),,Ложь);
								
				СтрДетальная           = СтрГлавная.Строки.Добавить();
				СтрДетальная.ТипДанных = Тип("СправочникСсылка.Субконто");
				СтрДетальная.ВидАналитики = ДетальнаяАналитика;
				СтрДетальная.ФормаВыбора  = "ПолнаяКлассификация";
								
				ДобавитьСвязьВыбора(СтрДетальная, "ЭлементВладелец", -СмещениеГл, Тип("СправочникСсылка.Субконто"),,Ложь);
				
				Если ЭтоНезависимаяПараАналитик = Ложь Тогда
					//Отбор для детальной аналитики по значению главной аналитики - добавляется только для цепочек (1-2 1-3 или 1-2-3)
					ДобавитьСвязьОтбора(СтрДетальная,"ЭлементВладелец",-СмещениеГл);
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ФУНКЦИИ ПРЕОБРАЗОВАНИЯ ИМЕН.

// Функция формирует код на основании наименования.
//
Функция СформироватьКодНаОснованииНаименования(Наименование,ДлинаКода=0,ИмяСправочника="",Владелец=Неопределено) Экспорт
	
	ТаблицаСлов=Новый ТаблицаЗначений;
	ТаблицаСлов.Колонки.Добавить("Слово");
	ТаблицаСлов.Колонки.Добавить("ПорядокСлова");
	ТаблицаСлов.Колонки.Добавить("ДлинаСлова");
	ТаблицаСлов.Колонки.Добавить("ЧастьСлова");
	ТаблицаСлов.Колонки.Добавить("ДлинаЧастиСлова");
	
	Если ДлинаКода=0 И ПустаяСтрока(ИмяСправочника) Тогда
		ДлинаКода=20;
	ИначеЕсли НЕ ПустаяСтрока(ИмяСправочника) Тогда
		ДлинаКода=Метаданные.Справочники[ИмяСправочника].ДлинаКода;
	КонецЕсли;
		
	ТекБуфер = "";
	ЗаполнениеСлова = Ложь;
	ПорядокСлова=1;
	
	Для Инд = 1 По СтрДлина(Наименование) Цикл
		ТекСимвол = ПроверитьНаПравильностьСимвол(Сред(Наименование, Инд, 1));
		Если ПустаяСтрока(ТекСимвол) Тогда
			Если ЗаполнениеСлова Тогда
				Если НЕ ПустаяСтрока(ТекБуфер) Тогда
					
					НоваяСтрока=ТаблицаСлов.Добавить();
					НоваяСтрока.Слово=ТекБуфер;
					НоваяСтрока.ДлинаСлова=СтрДлина(ТекБуфер);
					НоваяСтрока.ПорядокСлова=ПорядокСлова;
					
					ПорядокСлова=ПорядокСлова+1;
					
				КонецЕсли;
				ЗаполнениеСлова = Ложь;
				ТекБуфер = "";
				
			КонецЕсли;
		Иначе
			Если НЕ ЗаполнениеСлова Тогда
				ЗаполнениеСлова = Истина;
			КонецЕсли;
			
			ТекБуфер = ТекБуфер + ТекСимвол;
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ ПустаяСтрока(ТекБуфер) Тогда
		НоваяСтрока=ТаблицаСлов.Добавить();
		НоваяСтрока.Слово=ТекБуфер;
		НоваяСтрока.ДлинаСлова=СтрДлина(ТекБуфер);
		НоваяСтрока.ПорядокСлова=ПорядокСлова;
	КонецЕсли;
	
	Если ТаблицаСлов.Количество()=0 Тогда
		Возврат "";
	КонецЕсли;
	
	СредДлина=Окр(ДлинаКода/ТаблицаСлов.Количество(),0,РежимОкругления.Окр15как10);
	ОсталосьСимволов=ДлинаКода;
	
	ТаблицаСлов.Сортировать("ДлинаСлова");
	
	Для Индекс=1 По ТаблицаСлов.Количество() Цикл
		
		ТекСлово=ТаблицаСлов[Индекс-1];
		
		Если ТекСлово.ДлинаСлова<СредДлина Тогда 	// Свободный остаток от слова, 
													//длина которых меньше текущего среднего, передается на последующие слова.
			
			ТекСлово.ЧастьСлова=ТекСлово.Слово;
			ОсталосьСимволов=ОсталосьСимволов-ТекСлово.ДлинаСлова;
			
			Если НЕ Индекс=ТаблицаСлов.Количество() Тогда
				
				СредДлина=Окр(ОсталосьСимволов/(ТаблицаСлов.Количество()-Индекс),0,РежимОкругления.Окр15как10);
				
			КонецЕсли;
			
		Иначе
			
			ТекСлово.ЧастьСлова=Лев(ТекСлово.Слово,СредДлина);
			
		КонецЕсли;
		
	КонецЦикла;
			
	ТаблицаСлов.Сортировать("ПорядокСлова");
	
	ТекКод = "";

	Для Каждого Слово ИЗ ТаблицаСлов Цикл
		
		ТекКод=ТекКод+ВРЕГ(ЛЕВ(Слово.ЧастьСлова,1))+Сред(Слово.ЧастьСлова,2);
		
	КонецЦикла;
		
	ПроектКода = ВернутьАлфавитноЦифровоеПредставление(ТекКод);
	
	Если ПустаяСтрока(ИмяСправочника) Тогда
		Возврат ПроектКода;
	Иначе
		Возврат ПолучитьВозможныйКодСправочника(ПроектКода,ДлинаКода,ИмяСправочника,Владелец);
	КонецЕсли;
	
КонецФункции

// Функция проверяет, является ли Символ алфавитно-цифровым и если является, возвращает символ
// иначе пустой символ.
// Параметры:
//  Символ         - Строка, Символ для проверки.
// Результат:
//  Строка, Символ, если он алфавитно-цифровой, иначе - пустая строка.
Функция ПроверитьНаПравильностьСимвол(Символ)     
	СтрокаЭталон = "АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯABCDEFGHIJKLMNOPQRSTUVWXYZ1234567890";
	Возврат ?(Найти(СтрокаЭталон, ВРег(Символ)) = 0, "", Символ);
КонецФункции


// Функция формирует код справочника по заданному шаблону
//
// Параметры:
//
//  ПроектКода	- Шаблон кода, который желательно получить.
//
//	ДлинаКода	- Максимальная длина кода справочника (Необязательный).
//
//	ИмяСправочника - Идентификатор справочника.
//
//  Владелец	- Владелец элемента справочника.
//
// Возвращаемое значение:
//  Строка - Код справочника по шаблону с суффиксом нумерации похожих кодов.
//
Функция ПолучитьВозможныйКодСправочника(ПроектКода,ДлинаКода,ИмяСправочника,Владелец) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Справочники[ИмяСправочника].НайтиПоКоду(ПроектКода,,,Владелец)) Тогда
		Возврат ПроектКода;
	КонецЕсли;
	
	Если ДлинаКода=0 И ПустаяСтрока(ИмяСправочника) Тогда
		ДлинаКода=20;
	Иначе
		ДлинаКода=Метаданные.Справочники[ИмяСправочника].ДлинаКода;
	КонецЕсли;
	
	Если СтрДлина(СокрЛП(ПроектКода)) - ДлинаКода < -2 Тогда
		ТекПрефикс2 = СокрЛП(ПроектКода);
		ТекПрефикс3 = СокрЛП(ПроектКода);
	Иначе
		ТекПрефикс2 = Лев(СокрЛП(ПроектКода), ДлинаКода - 2);
		ТекПрефикс3 = Лев(СокрЛП(ПроектКода), ДлинаКода - 3);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	ТекстЗапроса = "ВЫБРАТЬ
	|	ТекСправочник.Код КАК Код,
	|	ВЫБОР
	|		КОГДА ТекСправочник.Код ПОДОБНО &Префикс3
	|			ТОГДА 3
	|		ИНАЧЕ 2
	|	КОНЕЦ КАК РазрядностьНомера
	|ИЗ
	|	Справочник."+ИмяСправочника+" КАК ТекСправочник";
	
	Если ЗначениеЗаполнено(Владелец) Тогда
		
		ТекстЗапроса=ТекстЗапроса+"
		
		|ГДЕ
		|	ТекСправочник.Владелец = &Владелец
		|	И (ТекСправочник.Код ПОДОБНО &Префикс2
		|			ИЛИ ТекСправочник.Код ПОДОБНО &Префикс3)";
		
		Запрос.УстановитьПараметр("Владелец",Владелец);
		
	Иначе
		
		ТекстЗапроса=ТекстЗапроса+"
		
		|ГДЕ
		|(ТекСправочник.Код ПОДОБНО &Префикс2
		|			ИЛИ ТекСправочник.Код ПОДОБНО &Префикс3)";
		
	КонецЕсли;
	
	ТекстЗапроса=ТекстЗапроса+"
	|УПОРЯДОЧИТЬ ПО
	|	РазрядностьНомера УБЫВ,
	|	Код УБЫВ";
	
	Запрос.УстановитьПараметр("Префикс2" , ТекПрефикс2 + "[0-9][0-9]%");
	Запрос.УстановитьПараметр("Префикс3" , ТекПрефикс3 + "[0-9][0-9][0-9]%");
	
	Запрос.Текст=ТекстЗапроса;
	
	Результат= Запрос.Выполнить().Выбрать();
	
	Если НЕ Результат.Следующий() Тогда
		Код = ТекПрефикс2 + "01";
		Возврат Код;
	КонецЕсли;
	
	МаксЗапись  = Результат.Код;
	
	Если ЗначениеЗаполнено(МаксЗапись) Тогда
		
		ТекРазрядностьНомера=Результат.РазрядностьНомера;
		МаксЗапись    = СокрЛП(МаксЗапись);
		ЧисловаяЧасть = Прав(МаксЗапись, ТекРазрядностьНомера);
			
		Попытка
			МаксЗначение = Число(ЧисловаяЧасть);
			
			НовоеЗначение=МаксЗначение+1;
			Если НовоеЗначение>=100 Тогда
				
				ТекРазрядностьНомера=3;
				
			КонецЕсли;
			
			Код = Лев(МаксЗапись, СтрДлина(МаксЗапись) - ТекРазрядностьНомера) + Формат(НовоеЗначение, "ЧЦ="+ТекРазрядностьНомера+"; ЧВН=");
		Исключение
			Код = Лев(МаксЗапись, СтрДлина(МаксЗапись) - ТекРазрядностьНомера) + ?(ТекРазрядностьНомера=2,"01","001");
		КонецПопытки;
		
	Иначе
		
		Код = ТекПрефикс2 + "01";
		
	КонецЕсли;
	
	Возврат Код;
	
КонецФункции // ПолучитьВозможныйКодСправочника()

// Функция заменяет все не алфавитно-цифровые символы на знак подчеркивания.
// Параметры
//  Код            - Строка, Значение кода, которое необходимо преобразовать.
// Возвращаемое значение
//  Строка, преобразованное значение кода.
//
Функция ВернутьАлфавитноЦифровоеПредставление(Код, РазрешитьЦифрыВНачале = Ложь, РазрешитьСлужебныеСимволы = Ложь) Экспорт
	
	Возврат БюджетнаяОтчетностьКлиентСервер.ВернутьАлфавитноЦифровоеПредставление(Код, РазрешитьЦифрыВНачале, РазрешитьСлужебныеСимволы);
	
КонецФункции


////////////////////////////////////////////////////////////////////////////////
// РАБОТА С ФОРМАМИ ВЫБОРА КОМПОНЕНТОВ ОТЧЕТА

// Вызывается при создании на сервере формы справочника, являющегося частью описания универсального отчета
//
Процедура ПриСозданииНаСервереФормыСпискаКомпонентаОтчета(ЭтаФорма, ДинамическийСписок, ИмяРеквизитаВидОтчета = Неопределено, ЭлементВидОтчета = Неопределено) Экспорт

	ЕстьВидОтчета = Не (ЭлементВидОтчета = Неопределено или ИмяРеквизитаВидОтчета = Неопределено);
	
	Если ЭтаФорма.Параметры.Свойство("ЗапретитьИзменениеВладельца") Тогда
		ЗапретитьИзменениеВладельца = ЭтаФорма.Параметры.ЗапретитьИзменениеВладельца;
	Иначе
		ЗапретитьИзменениеВладельца = Ложь;
	КонецЕсли;
	
	Если ЭтаФорма.Параметры.Отбор.Свойство("Владелец") Тогда
		
		ЗначениеОтбораВладелец = ЭтаФорма.Параметры.Отбор.Владелец;
		
		Если ТипЗнч(ЗначениеОтбораВладелец) = Тип("СправочникСсылка.ВидыОтчетов") Тогда
			
			// Автоотбор по владельцу будет задан программно
			ЭтаФорма.Параметры.Отбор.Удалить("Владелец");
			
		Иначе
			
			// Это СписокЗначений или Массив, программный отбор установлен не будет.
			ЗначениеОтбораВладелец = Неопределено;
			
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(ЭтаФорма.Параметры.ТекущаяСтрока) Тогда
		
		// Открытие из поля выбора без отбора по владельцу, но с текущим значением
		ЗначениеОтбораВладелец =  ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтаФорма.Параметры.ТекущаяСтрока,"Владелец");
		
	Иначе
		
		// Открытие формы без информации о владельце
		ЗначениеОтбораВладелец = Справочники.ВидыОтчетов.ПустаяСсылка();
		
	КонецЕсли;
	
	Если ЗначениеОтбораВладелец <> Неопределено Тогда
		
		// 1. Устанавливаем отбор по владельцу с доступностью в зависимости от параметра ЗапретитьИзменениеВладельца
		
		ЭлементОтбора = ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ДинамическийСписок.Отбор,
								"Владелец",
								ВидСравненияКомпоновкиДанных.Равно,
								ЗначениеОтбораВладелец,
								,
								Истина);

		// 2. Отражаем отбор в элементе быстрого отбора
		
		Если ЕстьВидОтчета Тогда
			ЭтаФорма[ИмяРеквизитаВидОтчета] = ЗначениеОтбораВладелец;
		КонецЕсли;
		
		// 3. Устанавливаем доступность изменения отбора
		Если ЗапретитьИзменениеВладельца Тогда
			
			ЭлементВидОтчета.ТолькоПросмотр = Истина;
			
		Иначе
			
			ЭлементОтбора.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Обычный;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // ПриСозданииНаСервереФормыКомпонентаОтчета()


////////////////////////////////////////////////////////////////////////////////
// ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ОБРАБОТКИ ФОРМУЛ.

// Выполняет синтаксический контроль формулы в контексте экземпляра отчета.
//
Функция СинтаксическийКонтрольФормулы(Знач ТекстФормулы, КодПоказателя, РежимВычисления, ОбъектПроверки = Неопределено)

	Если ОбъектПроверки = Неопределено Тогда
		ОбъектПроверки = Документы.УниверсальныйРегламентированныйОтчет.СоздатьДокумент();
	КонецЕсли;
	
	Если Не РежимВычисления Тогда
		ТекстФормулы = "ЭтотМодуль = """";
		|" + ТекстФормулы;
	КонецЕсли;
	
	ПроверкаПройдена = ОбъектПроверки.ПроверитьМодуль(ТекстФормулы,"",РежимВычисления);
	
	Если Не ПроверкаПройдена Тогда
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Формула для показателя: «%1» содержит синтаксические ошибки'"),
			КодПоказателя);
		
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			
	КонецЕсли;
	
	Возврат ПроверкаПройдена;

КонецФункции // СинтаксическийКонтрольФормулы()

Функция ПроверитьОперандыФормулРасчета(ТабПоказатели,ТабПоказателиПроверка)
	
	ФормулыКорректны=Истина;
	ТекстОшибок="";
	
	Для Каждого Показатель ИЗ ТабПоказатели Цикл
		
		Для Каждого Код ИЗ Показатель.СписокИспользуемых Цикл
			
			НайденаОшибка=Ложь;
			
			Если ПустаяСтрока(Код.Значение) Тогда
				Продолжить;
			КонецЕсли;
			
			// Проверяем на корректность указания кодов показателей в формуле	
			Если Лев(Код.Значение,9) <> "Аналитика" И ТабПоказателиПроверка.Найти(Код.Значение,"СокрКод") = Неопределено Тогда
				
				// Используемый код показателя не принадлежит к показателям данного отчета.
				
				#Если Клиент Тогда
					ТекстОшибок=ТекстОшибок+Символы.ПС+"Формула расчета показателя "+Показатель.СокрКод+": не найден показатель с кодом "+Код.Значение;
				#КонецЕсли
				
				НайденаОшибка=Истина;
				ФормулыКорректны=Ложь;
				
			КонецЕсли;
			
			Если Код.Значение=Показатель.СокрКод Тогда
				
				// В формуле расчета используется значение самого показателя 
				
				#Если Клиент Тогда
					ТекстОшибок=ТекстОшибок+Символы.ПС+"Формула расчета показателя "+Показатель.СокрКод+" использует значение самого показателя";
				#КонецЕсли
				
				НайденаОшибка=Истина;
				ФормулыКорректны=Ложь;
				
			КонецЕсли;
			
			Если Не НайденаОшибка Тогда
				
				// Проверим наличие циклической ссылки рекурсивно.
				
				СтрИспользуемыйПоказатель=ТабПоказателиПроверка.Найти(Код.Значение,"СокрКод");
				
				Если НЕ СтрИспользуемыйПоказатель=Неопределено Тогда
					
					ЭтапыЦикла=Новый ТаблицаЗначений;
					
					ЭтапыЦикла.Колонки.Добавить("Показатель");
					ЭтапыЦикла.Колонки.Добавить("Операнд");
					
					НовыйЭтап=ЭтапыЦикла.Добавить();
					НовыйЭтап.Показатель=Показатель.СокрКод;
					НовыйЭтап.Операнд=Код.Значение;
					
					СформироватьСписокРекурсивноИспользуемых(Показатель.СокрКод,СтрИспользуемыйПоказатель,ТабПоказателиПроверка,ЭтапыЦикла);
					
					Если НЕ ЭтапыЦикла.Найти(Показатель.СокрКод,"Операнд")=Неопределено Тогда
						
						// В списке рекурсивно используемых показателей присутствует исходный.
						
						ФормулыКорректны=Ложь;
						
						#Если Клиент Тогда
							ТекстОшибок=ТекстОшибок+Символы.ПС+Показатель.СокрКод+": обнаружена циклическая ссылка в расчетах";
						#КонецЕсли
						
						Для Каждого Код Из ЭтапыЦикла Цикл
							
							#Если Клиент Тогда
								ТекстОшибок=ТекстОшибок+Символы.ПС+Код.Показатель+" - "+Код.Операнд+?(Код.Операнд=Показатель.СокрКод,"!!","");
							#КонецЕсли
							
							Если Код.Операнд=Показатель.СокрКод Тогда
								
								Прервать;
								
							КонецЕсли;
							
						КонецЦикла;
																	
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
				
	КонецЦикла;
		
	Если Не ПустаяСтрока(ТекстОшибок) Тогда
		
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибок);
		
	КонецЕсли;	
		
	Возврат ФормулыКорректны;
	
КонецФункции // ПроверитьОперандыФормулРасчета()

// Формирует цепочку формул расчета показателей, приводящую к зацикливанию расчета
//
Процедура СформироватьСписокРекурсивноИспользуемыхПоказатель(ИсходныйПоказатель,СтрИспользуемыйПоказатель,ЭтапыЦикла,ПравилоОбработки)
	
	Для Каждого Показатель ИЗ СтрИспользуемыйПоказатель.СписокИспользуемых Цикл
		
		Если НЕ ЭтапыЦикла.Найти(Показатель.Значение,"Операнд")=Неопределено Тогда
			
			Возврат;
						
		КонецЕсли;
		
		НовыйЭтап=ЭтапыЦикла.Добавить();
		НовыйЭтап.Показатель=СтрИспользуемыйПоказатель.СокрКод;
		НовыйЭтап.Операнд=Показатель.Значение;
		
		Если Показатель.Значение=ИсходныйПоказатель  Тогда
			
			Возврат;
			
		КонецЕсли;
		
	КонецЦикла;
	
	МассивКодов=Новый Массив;
	Для Каждого Код Из СтрИспользуемыйПоказатель.СписокИспользуемых Цикл
		МассивКодов.Добавить(СокрП(Код.Значение));
	КонецЦикла;	
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	ПравилаОбработкиПроцедурыОбработкиПоказателей.Показатель.Ссылка КАК Показатель,
	             |	ПравилаОбработкиПроцедурыОбработкиПоказателей.Показатель.Код КАК Код,
	             |	ПравилаОбработкиПроцедурыОбработкиПоказателей.Показатель.Владелец КАК ВидОтчета,
	             |	ПравилаОбработкиПроцедурыОбработкиПоказателей.Процедура,
	             |	ЛОЖЬ КАК ПроизвольныйКод,
	             |	ЛОЖЬ КАК ПоказателиТекущегоОтчета
	             |ИЗ
	             |	Справочник.ПравилаОбработки.ПроцедурыОбработкиПоказателей КАК ПравилаОбработкиПроцедурыОбработкиПоказателей
	             |ГДЕ
	             |	ПравилаОбработкиПроцедурыОбработкиПоказателей.Ссылка = &ПравилоОбработки
	             |	И ПравилаОбработкиПроцедурыОбработкиПоказателей.Показатель.Код В(&Код)
	             |	И ПравилаОбработкиПроцедурыОбработкиПоказателей.Показатель.СпособОбработки = &Вычисление";
				 
	Запрос.УстановитьПараметр("ПравилоОбработки",ПравилоОбработки);
	Запрос.УстановитьПараметр("Код",МассивКодов);
	Запрос.УстановитьПараметр("Вычисление",Перечисления.СпособыОбработкиПоказателейОтчетов.Вычисление);
	
	ТабПоказатели=Запрос.Выполнить().Выгрузить();
	
	ТабПоказатели.Колонки.Добавить("СписокИспользуемых");
	ТабПоказатели.Колонки.Добавить("СокрКод");
	
	// Заполним для каждого показателя список кодов других показателей этого отчета, используемых
	// при расчете.
	
	Для Каждого СтрПоказательТаб ИЗ ТабПоказатели Цикл
		
		СтрПоказательТаб.СписокИспользуемых=РазобратьОперанды(СтрПоказательТаб.Процедура);
		
		СтрПоказательТаб.СокрКод=СокрЛП(СтрПоказательТаб.Код);
		
		Если СтрПоказательТаб.СписокИспользуемых.Количество()>0 Тогда
			
			СформироватьСписокРекурсивноИспользуемыхПоказатель(ИсходныйПоказатель,СтрПоказательТаб,ЭтапыЦикла,ПравилоОбработки);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // СформироватьСписокРекурсивноИспользуемыхПоказатель

// Формирует цепочку формул расчета показателей, приводящую к зацикливанию расчета
//
Процедура СформироватьСписокРекурсивноИспользуемых(ИсходныйПоказатель,СтрИспользуемыйПоказатель,ТабПоказателиПроверка,ЭтапыЦикла)
	
	Для Каждого Показатель ИЗ СтрИспользуемыйПоказатель.СписокИспользуемых Цикл
		
		Если НЕ ЭтапыЦикла.Найти(Показатель.Значение,"Операнд")=Неопределено Тогда
			
			Прервать;
			
		КонецЕсли;
		
		НовыйЭтап=ЭтапыЦикла.Добавить();
		НовыйЭтап.Показатель=СтрИспользуемыйПоказатель.СокрКод;
		НовыйЭтап.Операнд=Показатель.Значение;
		
		Если Показатель.Значение=ИсходныйПоказатель  Тогда
			
			Прервать;
			
		Иначе
			
			ТекПоказатель=ТабПоказателиПроверка.Найти(Показатель.Значение,"СокрКод");
			
			Если Не ТекПоказатель=Неопределено Тогда
				
				СформироватьСписокРекурсивноИспользуемых(ИсходныйПоказатель,ТекПоказатель,ТабПоказателиПроверка,ЭтапыЦикла);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // СформироватьСписокРекурсивноИспользуемых

Процедура СформироватьДеревоРекурсивноЗависимых(СтрокаДерева,СтрПоказатель,мПоказателиДляОбработки,СоответствиеОбработанныхПоказаетелей)
	
	Для Каждого ИспользуемыйПоказатель ИЗ СтрПоказатель.СписокИспользуемых Цикл
		
		КодОперанда = ?(СтрПоказатель.ПоказателиТекущегоОтчета,?(ПустаяСтрока(ИспользуемыйПоказатель.Представление),"",ИспользуемыйПоказатель.Представление),ИспользуемыйПоказатель.Значение);
		
		//В данном случае не проверяем наличие в СоответствиеОбработанныхПоказаетелей, 
		//т.к. требуется проверка на наличие показателя именно в текущей строке дерева.
		Если СтрокаДерева.Строки.Найти(КодОперанда,"КодПоказателя",Истина)=Неопределено Тогда
			
			НоваяСтрока=СтрокаДерева.Строки.Добавить();
			НоваяСтрока.КодПоказателя = КодОперанда;
			
			//Сохраним добавленный показатель
			СоответствиеОбработанныхПоказаетелей.Вставить(КодОперанда,КодОперанда);
			
			ИспользуемыйПоказатель = мПоказателиДляОбработки.Найти(КодОперанда,"Код");
			
			Если (НЕ ИспользуемыйПоказатель = Неопределено) И ИспользуемыйПоказатель.СписокИспользуемых.Количество() > 0 Тогда
				
				Если ИспользуемыйПоказатель.СписокИспользуемых = СтрПоказатель.СписокИспользуемых Тогда
					Продолжить;
				КонецЕсли;
				
				СформироватьДеревоРекурсивноЗависимых(НоваяСтрока,ИспользуемыйПоказатель,мПоказателиДляОбработки,СоответствиеОбработанныхПоказаетелей);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
			
КонецПроцедуры // СформироватьДеревоРекурсивноЗависимых()

// Создает таблицу для использования в параметрах выбора аналитик.
//
Функция СоздатьТаблицуСвязейОтбораАналитики()

	ТаблицаСвязей = Новый ТаблицаЗначений;
	ТаблицаСвязей.Колонки.Добавить("ПолеОтбора"	,Новый ОписаниеТипов("Строка"));
	ТаблицаСвязей.Колонки.Добавить("Смещение"	,Новый ОписаниеТипов("Число"));
	
	Возврат ТаблицаСвязей;

КонецФункции // СоздатьТаблицуСвязейОтбораАналитики()

// Создает таблицу для обратного распределения выбранного значения по аналитикам.
//
Функция СоздатьТаблицуСвязейВыбораАналитики()  

	ТаблицаСвязей = Новый ТаблицаЗначений;
	ТаблицаСвязей.Колонки.Добавить("Смещение"	   ,Новый ОписаниеТипов("Число"));
	ТаблицаСвязей.Колонки.Добавить("ПолеСсылки"	   ,Новый ОписаниеТипов("Строка"));
	ТаблицаСвязей.Колонки.Добавить("ТребуемыйТип"  ,Новый ОписаниеТипов("Тип"));
	
	// Режим изменения связанного значения
	// 0 - изменять всегда
	// 1 - не изменять никогда
	// 2 - изменять, но не очищать (пустое связанное значение не приводит к изменению данных)
	
	ТаблицаСвязей.Колонки.Добавить("РежимИзменения",Новый ОписаниеТипов("Число")); // 0 - изменять, 1 - не изменять
	
	Возврат ТаблицаСвязей;

КонецФункции // СоздатьТаблицуСвязейОтбораАналитики()


