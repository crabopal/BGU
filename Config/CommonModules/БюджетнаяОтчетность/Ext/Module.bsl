
Функция СформироватьТекстТранзитивногоЗамыкания(ИмяСправочника, МаксимальнаяДлинаПути,ВключаяПустыеСсылки=Ложь,ИмяТаблицы="") Экспорт
	
	ТекстПролог = 
	"ВЫБРАТЬ
	|	МойСправочник.Родитель КАК НачалоДуги,
	|	МойСправочник.Ссылка КАК КонецДуги
	|ПОМЕСТИТЬ ЗамыканияДлины1
	|ИЗ
	|	Справочник.ВидыРасходовКРБ КАК МойСправочник
	|"+?(ВключаяПустыеСсылки,"", "ГДЕ Родитель <> Значение(Справочник.ВидыРасходовКРБ.ПустаяСсылка)")+"
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	МойСправочник.Ссылка,
	|	МойСправочник.Ссылка
	|ИЗ
	|	Справочник.ВидыРасходовКРБ КАК МойСправочник
	|;";

	ТекстРефрен = "
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПерваяДуга.НачалоДуги,
	|	ВтораяДуга.КонецДуги
	|ПОМЕСТИТЬ ЗамыканияДлины#2
	|ИЗ
	|	ЗамыканияДлины#1 КАК ПерваяДуга
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ЗамыканияДлины#1 КАК ВтораяДуга
	|		ПО ПерваяДуга.КонецДуги = ВтораяДуга.НачалоДуги
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ЗамыканияДлины#1
	|;";
	
	Эпилог = "
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Эпилог.НачалоДуги КАК Предок,
	|	Эпилог.КонецДуги КАК Потомок
	|"+?(ЗначениеЗаполнено(ИмяТаблицы),"ПОМЕСТИТЬ "+ИмяТаблицы,"")+"
	|ИЗ
	|	ЗамыканияДлины#2 КАК Эпилог
	|ГДЕ
	|	Эпилог.НачалоДуги <> Эпилог.КонецДуги";

    ТекстЗапроса = СтрЗаменить(ТекстПролог, "ВидыРасходовКРБ", ИмяСправочника);

    МаксимальнаяДлинаЗамыканий = 1;

    Пока МаксимальнаяДлинаЗамыканий < МаксимальнаяДлинаПути Цикл

    	ТекстЗапроса = ТекстЗапроса + СтрЗаменить(СтрЗаменить(ТекстРефрен, "#1", Формат(МаксимальнаяДлинаЗамыканий, "ЧГ=0")), "#2", Формат(2 * МаксимальнаяДлинаЗамыканий, "ЧГ=0"));

    	МаксимальнаяДлинаЗамыканий = 2 * МаксимальнаяДлинаЗамыканий;

    КонецЦикла;

    ТекстЗапроса = ТекстЗапроса + СтрЗаменить(Эпилог, "#2", Формат(МаксимальнаяДлинаЗамыканий, "ЧГ=0"));

    Возврат ТекстЗапроса;

КонецФункции

Функция НайтиСсылкуПоКодуАналитикиИБюджету(Организация, ПериодОтчета, ЗначениеЗаполнения, ИмяВидаСправочника, 
								ПроверятьДату = Ложь, ПроверятьБюджет = Ложь,
								ЭлементВладелец = Неопределено, РеквизитВладелец = "", ИмяВидаВладельца = "") Экспорт
								
	ПараметрыПоиска = Новый Структура();
	ПараметрыПоиска.Вставить("Организация",			Организация);
	ПараметрыПоиска.Вставить("ПериодОтчета",		ПериодОтчета);
	ПараметрыПоиска.Вставить("ЗначениеЗаполнения",	ЗначениеЗаполнения);
	ПараметрыПоиска.Вставить("ИмяВидаСправочника",	ИмяВидаСправочника);
	ПараметрыПоиска.Вставить("ПроверятьДату",		ПроверятьДату);
	ПараметрыПоиска.Вставить("ПроверятьБюджет",		ПроверятьБюджет);
	ПараметрыПоиска.Вставить("ЭлементВладелец",		ЭлементВладелец);
	ПараметрыПоиска.Вставить("РеквизитВладелец",	РеквизитВладелец);
	ПараметрыПоиска.Вставить("ИмяВидаВладельца",	ИмяВидаВладельца);
	
	ЗначениеАналитики = ЗаполнениеОтчетностиПовтИсп.НайтиКодАналитикиПоБюджету(ПараметрыПоиска);
	
	Возврат ЗначениеАналитики;
	
КонецФункции

// Возвращает версию редакции вида отчета.
//
// Параметры
//  ВидОтчета    - Вид отчета, для которого необходимо
//                 определить редакцию
//  ДатаРедакции - Дата актуальности редакции
//
// Возвращаемое значение:
//   СправочникСсылка.РедакцииОтчетности - значение редакции отчетности. 
//		пустая ссылка, если редакция не найдена.
//
Функция ПолучитьРедакциюОтчета(ВидОтчета,ДатаРедакции) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 1
	|	НастройкиОтчетовПоУмолчанию.Редакция,
	|	НастройкиОтчетовПоУмолчанию.Редакция.ДатаДействия
	|ИЗ
	|	РегистрСведений.НастройкиОтчетовПоУмолчанию КАК НастройкиОтчетовПоУмолчанию
	|ГДЕ
	|	НастройкиОтчетовПоУмолчанию.ВидОтчета = &ВидОтчета
	|	И НастройкиОтчетовПоУмолчанию.Редакция.ДатаДействия <= &ДатаДействия
	|
	|УПОРЯДОЧИТЬ ПО
	|	НастройкиОтчетовПоУмолчанию.Редакция.ДатаДействия УБЫВ";
	
	Если ТипЗнч(ДатаРедакции) = Тип("СправочникСсылка.Периоды") Тогда
		ДатаДействия = КонецДня(ДатаРедакции.ДатаОкончания) + 1;
	Иначе
		ДатаДействия = ДатаРедакции;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ВидОтчета"	,ВидОтчета);
	Запрос.УстановитьПараметр("ДатаДействия",ДатаДействия);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Редакция;
	Иначе
		
		ОбщегоНазначения.СообщитьПользователю(
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Не найдено ни одной редакции для отчета %1'"),
				Строка(ВидОтчета)));
		
		Возврат Справочники.РедакцииОтчетности.ПустаяСсылка();
		
	КонецЕсли;

КонецФункции // ПолучитьРедакциюОтчета()

// Определяет актуальность указанного бланка отчетной формы по списку редакций
//
Функция РедакцияБланкаАктуальна(Знач ВидОтчета, Знач БланкОтчета) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИСТИНА КАК БланкАктуален
	|ИЗ
	|	(ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 1
	|		НастройкиОтчетовПоУмолчанию.Редакция КАК Редакция,
	|		НастройкиОтчетовПоУмолчанию.Редакция.ДатаДействия КАК ДатаДействия,
	|		ВЫБОР
	|			КОГДА НастройкиОтчетовПоУмолчанию.БланкДляОтображения = &БланкОтчета
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ КАК РедакцияТекущегоБланка
	|	ИЗ
	|		РегистрСведений.НастройкиОтчетовПоУмолчанию КАК НастройкиОтчетовПоУмолчанию
	|	ГДЕ
	|		НастройкиОтчетовПоУмолчанию.ВидОтчета = &ВидОтчета
	|	
	|	УПОРЯДОЧИТЬ ПО
	|		НастройкиОтчетовПоУмолчанию.Редакция.ДатаДействия УБЫВ) КАК Редакции
	|ГДЕ
	|	Редакции.РедакцияТекущегоБланка";
	
	Запрос.УстановитьПараметр("ВидОтчета"  , ВидОтчета);
	Запрос.УстановитьПараметр("БланкОтчета", БланкОтчета);
	
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции // РедакцияБланкаАктуальна()

// Функция заполняет список значений аналитик переданной группы раскрытия показателя
// Параметры:
//	ОбъектАналитики - объект, виды аналитики которого анализируются.
//
Функция ЗаполнитьВидыАналитикГруппыРаскрытия(ОбъектАналитики) Экспорт
	
	ТаблицаАналитик=Новый ТаблицаЗначений;
	ТаблицаАналитик.Колонки.Добавить("КодАналитики");
	ТаблицаАналитик.Колонки.Добавить("НаименованиеАналитики");
	ТаблицаАналитик.Колонки.Добавить("ВидАналитики");
	ТаблицаАналитик.Колонки.Добавить("СписокЗначенийАналитики");
	ТаблицаАналитик.Колонки.Добавить("ТипДанныхАналитики");
	ТаблицаАналитик.Колонки.Добавить("ПредставлениеАналитики");
	ТаблицаАналитик.Колонки.Добавить("ТаблицаАналитики");
	ТаблицаАналитик.Колонки.Добавить("ВидКлассификатораБК");
	
	Если ОбъектАналитики=Неопределено Тогда
		Возврат ТаблицаАналитик;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ГруппыРаскрытияАналитика.НомерСтроки КАК НомерАналитики,
	|	ГруппыРаскрытияАналитика.ВидАналитики.Наименование КАК НаименованиеАналитики,
	|	ГруппыРаскрытияАналитика.ВидАналитики КАК ВидАналитики,
	|	ГруппыРаскрытияАналитика.ВидАналитики.СписокЗначений КАК СписокЗначенийАналитики,
	|	ГруппыРаскрытияАналитика.ВидАналитики.ТипЗначения КАК ОписаниеТипов,
	|	ГруппыРаскрытияАналитика.ВидАналитики.ВидКлассификатораБК КАК ВидКлассификатораБК
	|ИЗ
	|	Справочник.ГруппыРаскрытия.Аналитика КАК ГруппыРаскрытияАналитика
	|ГДЕ
	|	ГруппыРаскрытияАналитика.Ссылка = &ГруппаРаскрытия";
	
	Запрос.УстановитьПараметр("ГруппаРаскрытия",ОбъектАналитики);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ВидАналитики = Выборка.ВидАналитики;
		НоваяСтрока=ТаблицаАналитик.Добавить();
		НоваяСтрока.НаименованиеАналитики 	= Выборка.НаименованиеАналитики;
		НоваяСтрока.ВидАналитики			= ВидАналитики;
		НоваяСтрока.СписокЗначенийАналитики	= Выборка.СписокЗначенийАналитики;
		НоваяСтрока.ПредставлениеАналитики	= "Аналитика"+Выборка.НомерАналитики+": "+Выборка.НаименованиеАналитики;
		НоваяСтрока.ТипДанныхАналитики		= Выборка.ОписаниеТипов.Типы()[0];
		НоваяСтрока.КодАналитики			= "Аналитика"+Выборка.НомерАналитики;
		НоваяСтрока.ТаблицаАналитики=?(НоваяСтрока.ТипДанныхАналитики = Тип("Строка"), "", Метаданные.НайтиПоТипу(НоваяСтрока.ТипДанныхАналитики).ПолноеИмя());
		НоваяСтрока.ВидКлассификатораБК = Выборка.ВидКлассификатораБК;
		
	КонецЦикла;
	
	Возврат ТаблицаАналитик;
	
КонецФункции // ЗаполнитьВидыАналитикГруппыРаскрытия()

// Функция заполняет список значений аналитик переданного объекта (вида отчета или группы раскрытия показателя).
// Параметры:
//	ОбъектАналитики - объект, виды аналитики которого анализируются.
//  ТаблицаАналитик- Таблица значений, список, в который помещаются наименования
//	 аналитик показателя.
//
Функция ЗаполнитьВидыАналитикОтчета(ВидОтчета) Экспорт
	
	ТаблицаАналитик=Новый ТаблицаЗначений;
	ТаблицаАналитик.Колонки.Добавить("ДополнительныйРеквизит");
	ТаблицаАналитик.Колонки.Добавить("КодАналитики");
	ТаблицаАналитик.Колонки.Добавить("НаименованиеАналитики");
	ТаблицаАналитик.Колонки.Добавить("ВидАналитики");
	ТаблицаАналитик.Колонки.Добавить("СписокЗначенийАналитики");
	ТаблицаАналитик.Колонки.Добавить("ТипДанныхАналитики");
	ТаблицаАналитик.Колонки.Добавить("ПредставлениеАналитики");
	ТаблицаАналитик.Колонки.Добавить("ТаблицаАналитики");
	ТаблицаАналитик.Колонки.Добавить("ВидКлассификатораБК");
	
	Если ВидОтчета=Неопределено Тогда
		Возврат ТаблицаАналитик;
	КонецЕсли;
	
	Запрос=Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	ДополнительныеРеквизитыОтчетов.Код,
	             |	ДополнительныеРеквизитыОтчетов.Наименование,
	             |	ДополнительныеРеквизитыОтчетов.ВидАналитики,
				 |	ДополнительныеРеквизитыОтчетов.ВидАналитики.СписокЗначений КАК СписокЗначенийАналитики,
				 |	ДополнительныеРеквизитыОтчетов.ВидАналитики.ТипЗначения КАК ТипЗначения,
	             |	ДополнительныеРеквизитыОтчетов.Ссылка КАК ДополнительныйРеквизит,
				 |	ДополнительныеРеквизитыОтчетов.ВидАналитики.ВидКлассификатораБК КАК ВидКлассификатораБК
	             |ИЗ
	             |	Справочник.ДополнительныеРеквизитыОтчетов КАК ДополнительныеРеквизитыОтчетов
	             |ГДЕ
	             |	ДополнительныеРеквизитыОтчетов.Владелец = &ВидОтчета
	             |	И (НЕ ДополнительныеРеквизитыОтчетов.ПометкаУдаления)";
				 
	Запрос.УстановитьПараметр("ВидОтчета",ВидОтчета);
	
	Результат=Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		
		НоваяСтрока=ТаблицаАналитик.Добавить();
		НоваяСтрока.ДополнительныйРеквизит=Результат.ДополнительныйРеквизит;
		НоваяСтрока.НаименованиеАналитики=Результат.Наименование;
		НоваяСтрока.ВидАналитики=Результат.ВидАналитики;
		НоваяСтрока.СписокЗначенийАналитики=Результат.СписокЗначенийАналитики;
		НоваяСтрока.ПредставлениеАналитики="Реквизит отчета: "+Результат.Наименование;
		НоваяСтрока.ТипДанныхАналитики=Результат.ТипЗначения.Типы()[0];
		НоваяСтрока.КодАналитики="Реквизит_"+СокрЛП(Результат.Код);
		НоваяСтрока.ТаблицаАналитики=?(НоваяСтрока.ТипДанныхАналитики = Тип("Строка"), "", Метаданные.НайтиПоТипу(НоваяСтрока.ТипДанныхАналитики).ПолноеИмя());
		НоваяСтрока.ВидКлассификатораБК = Результат.ВидКлассификатораБК;
		
	КонецЦикла;	
	
	Возврат ТаблицаАналитик;
	
КонецФункции // ЗаполнитьВидыАналитикОтчета()

// Получает таблицу дополнительных реквизитов вида отчета
//
// Параметры
//  ВидОтчета	 - вид отчета, для которого необходимо получить реквизиты
//
Функция ПолучитьТаблицуДополнительныхРеквизитов(ВидОтчета) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДополнительныеРеквизитыОтчетов.Код,
	|	ДополнительныеРеквизитыОтчетов.Наименование,
	|	ДополнительныеРеквизитыОтчетов.ВидАналитики,
	|	ДополнительныеРеквизитыОтчетов.ВидАналитики.ТипЗначения КАК ТипЗначения,
	|	ДополнительныеРеквизитыОтчетов.ПорядковыйНомер КАК ПорядковыйНомер,
	|	ДополнительныеРеквизитыОтчетов.Обязательный,
	|	ДополнительныеРеквизитыОтчетов.Ссылка КАК ДополнительныйРеквизит,
	|	НЕОПРЕДЕЛЕНО КАК Значение
	|ИЗ
	|	Справочник.ДополнительныеРеквизитыОтчетов КАК ДополнительныеРеквизитыОтчетов
	|ГДЕ
	|	ДополнительныеРеквизитыОтчетов.Владелец = &ВидОтчета";
	
	Запрос.УстановитьПараметр("ВидОтчета",ВидОтчета);
	
	Таблица = Запрос.Выполнить().Выгрузить();
	Таблица.Колонки.Добавить("КороткийКод",БюджетнаяОтчетность.ПолучитьОписаниеТиповСтроки(20));
	Для Каждого СтрокаРеквизит Из Таблица Цикл 
		
		СтрокаРеквизит.КороткийКод = СокрП(СтрокаРеквизит.Код);
		
	КонецЦикла;
	
	Таблица.Колонки.Удалить(Таблица.Колонки.Код);
	Таблица.Колонки.КороткийКод.Имя = "Код";
	
	Возврат Таблица;

КонецФункции // ПолучитьТаблицуДополнительныхРеквизитов()

// Функция возвращает полное описание вида отчета.
//
Функция ПредставлениеВидаОтчета(ВидОтчета) Экспорт

