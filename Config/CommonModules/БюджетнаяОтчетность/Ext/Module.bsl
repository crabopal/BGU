// Устарела
// реализована в другом месте, не экспортируется 
Функция ПолучитьСписокИменГруппРаскрытия(ВидОтчета,ВыводитьСтроки=Истина) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст="ВЫБРАТЬ РАЗЛИЧНЫЕ
	             |	ПоказателиОтчетов.ГруппаРаскрытия.Код КАК Код,
	             |	ПоказателиОтчетов.ГруппаРаскрытия.Наименование КАК Наименование,
	             |	"""" КАК КодСтроки
	             |ИЗ
	             |	Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
	             |ГДЕ
	             |	ПоказателиОтчетов.Владелец = &Владелец
	             |	И ПоказателиОтчетов.ГруппаРаскрытия <> &ПустаяГруппаРаскрытия";
	
	Если ВыводитьСтроки Тогда
		
		Запрос.Текст=Запрос.Текст+"
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ПоказателиОтчетов.ГруппаРаскрытия.Код,
		|	ПоказателиОтчетов.ГруппаРаскрытия.Наименование,
		|	ПоказателиОтчетов.Строка.Код
		|ИЗ
		|	Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
		|ГДЕ
		|	ПоказателиОтчетов.Владелец = &Владелец
		|	И ПоказателиОтчетов.ГруппаРаскрытия <> &ПустаяГруппаРаскрытия";
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Владелец", ВидОтчета);
	Запрос.УстановитьПараметр("ПустаяГруппаРаскрытия",Справочники.ГруппыРаскрытия.ПустаяСсылка());
	
	СписокИмен = Новый СписокЗначений;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СписокИмен.Добавить(СокрЛП(Выборка.Код)+?(НЕ ПустаяСтрока(Выборка.КодСтроки),"_"+СокрЛП(Выборка.КодСтроки),""), СокрЛП(Выборка.Наименование));
	КонецЦикла;
	Возврат СписокИмен;
	
КонецФункции

// Устарела
// реализована в другом месте, не экспортируется 
Функция СравнитьСтруктурыЗначений(Структура1, Структура2) Экспорт
	
	Если НЕ ТипЗнч(Структура1)=ТипЗнч(Структура2) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ Структура1.Количество()=Структура1.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого Элемент ИЗ Структура1 Цикл
		
		Если Не Структура2.Свойство(Элемент.Ключ) Тогда
			Возврат Ложь;
		ИначеЕсли НЕ ТипЗнч(Элемент.Значение)=ТипЗнч(Структура2[Элемент.Ключ]) Тогда
			Возврат Ложь;
		ИначеЕсли ТипЗнч(Элемент.Значение)=Тип("Структура") И (НЕ СравнитьСтруктурыЗначений(Элемент.Значение,Структура2[Элемент.Ключ])) Тогда
			Возврат Ложь;
		ИначеЕсли НЕ Элемент.Значение=Структура2[Элемент.Ключ] Тогда
			Возврат Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции  

