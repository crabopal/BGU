// Добавление связи, выполняемой после выбора значения.
//
Функция ДобавитьСвязьВыбора(Знач СценарийВыбора, Знач ПолеСсылки, Знач Смещение, Знач ТребуемыйТип, Знач РежимИзменения = 0, АвтосвязьОтбора = Истина) Экспорт

	Если СценарийВыбора.СвязиВыбора.Колонки.Количество() = 0 Тогда
		СценарийВыбора.СвязиВыбора = СоздатьТаблицуСвязейВыбораАналитики();
	КонецЕсли;
	
	СтрСвязь                = СценарийВыбора.СвязиВыбора.Добавить();
	СтрСвязь.ПолеСсылки     = ПолеСсылки;
	СтрСвязь.Смещение	    = Смещение;
	СтрСвязь.ТребуемыйТип   = ТребуемыйТип;
	СтрСвязь.РежимИзменения = РежимИзменения;

	Если АвтосвязьОтбора и Смещение = -1 Тогда
		
		ДобавитьСвязьОтбора(СценарийВыбора, ПолеСсылки, Смещение);
		
	КонецЕсли;
	
	Возврат СтрСвязь;
	
КонецФункции // ДобавитьСвязьВыбора()

// Добавление связи, выполняемой перед выбором значения (параметр выбора).
//
Функция ДобавитьСвязьОтбора(Знач СценарийВыбора, Знач ПолеОтбора, Знач Смещение)

	Если СценарийВыбора.СвязиОтбора.Колонки.Количество() = 0 Тогда
		СценарийВыбора.СвязиОтбора = СоздатьТаблицуСвязейОтбораАналитики();
	КонецЕсли;
	
	СтрСвязьОтбора = СценарийВыбора.СвязиОтбора.Добавить();
	СтрСвязьОтбора.ПолеОтбора = ПолеОтбора;
	СтрСвязьОтбора.Смещение   = Смещение;
	
	Возврат СтрСвязьОтбора;

КонецФункции // ДобавитьСвязьОтбора()


