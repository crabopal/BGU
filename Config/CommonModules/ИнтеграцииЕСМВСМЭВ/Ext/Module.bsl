	|          <CanonicalizationMethod Algorithm=""http://www.w3.org/2001/10/xml-exc-c14n#""/>
	|          <SignatureMethod Algorithm=""%SignatureMethod%""/>
	|          <Reference
	|             URI=""#Id-wssecdata-9d1846d63850bd1a8cd1c392a77b8a0d2f4f""
