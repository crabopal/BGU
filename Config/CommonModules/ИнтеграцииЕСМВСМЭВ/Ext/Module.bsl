	Методы.Вставить("ОтправитьФайлыПакетаФоновое", Истина);
	Методы.Вставить("ПолучитьОтветыИзОчередиЕСМВФоновое", Истина);
КонецПроцедуры

#КонецОбласти 

#Область СлужебныеПроцедурыИФункции

Процедура ОтправитьПодтверждениеЕСМВ(ДополнительныеПараметры)
	
	ПараметрыЗапроса = ДополнительныеПараметры.ПараметрыЗапроса;
	ДополнитьПараметрыПодтверждение(ПараметрыЗапроса);
	
	Если ПараметрыЗапроса.Сообщения.Количество() ТОгда
		Попытка 
			
			ТекстЗапроса = "<typ:ackMessagesRequest>";
			
			Для каждого СтрокаСообщение Из ПараметрыЗапроса.Сообщения Цикл
				
				ТекстЗапроса = ТекстЗапроса + "
				|    <typ:ackMessage>
				|        <typ:senderSystemId>" + СтрокаСообщение.Отправитель + "</typ:senderSystemId>
				|        <typ:targetSystemId>" + СтрокаСообщение.Получатель + "</typ:targetSystemId>
				|        <typ:documentType>" + СтрокаСообщение.ТипДокумента + "</typ:documentType>
				|        <typ:packageId>" + СтрокаСообщение.ИдентификаторСообщения + "</typ:packageId>
				|                <typ:statusCode>0</typ:statusCode>
				|                <typ:statusMessage>Успешное выполнение</typ:statusMessage>
				|    </typ:ackMessage>"
				
			КонецЦикла;	
			
			ТекстЗапроса = ТекстЗапроса + "
			|</typ:ackMessagesRequest>";
			
			ПараметрыЗапроса.Вставить("КодВидаСведений", ПараметрыЗапроса.КодВидаСведений);				
			ПодписатьТело(ТекстЗапроса, ПараметрыЗапроса); 
		Исключение 
			ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			МодульЖурналРегистрации = ОбщегоНазначения.ОбщийМодуль("ЖурналРегистрации");
			МодульЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(НСтр("ru = ПолучениеОтветовИзОчередиЕСМВСервер'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,,,"Тип опроса очереди: " + ?(ЗначениеЗаполнено(ПараметрыЗапроса.ТипЗапроса), ПараметрыЗапроса.ТипЗапроса, "Все")  + ". 
			|" + ТекстОшибки);
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Получение сообщений не подтверждено. Подробности см. в журнале регистрации.'"));
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьТаблицуТаксономии(Организация, ОтчетныйПериод)
	
	ДатаЗапроса = ТекущаяДатаСеанса();	
	
	Запрос = Новый Запрос;
	Если ЗначениеЗаполнено(ОтчетныйПериод) Тогда
		Запрос.Текст = МодульСбораДанных.ПолучитьТекстЗапросаТаксономииПоОтчетномуПериоду();
		Запрос.УстановитьПараметр("Период", ОтчетныйПериод);
	Иначе	
		Запрос.Текст = МодульСбораДанных.ПолучитьТекстЗапросаТаксономии();
		Запрос.УстановитьПараметр("Сдвиг", Константы.СдвигАвтоформированияДанныхДляМСД.Получить());
		Запрос.УстановитьПараметр("ТекущаяДата", ДатаЗапроса);
	КонецЕсли;	
	Запрос.УстановитьПараметр("Организация", Организация);
	
	РезультатЗапроса = Запрос.ВыполнитьПакетСПромежуточнымиДанными();
	
	ТаблицаДляПреобразования = РезультатЗапроса[РезультатЗапроса.Количество()-1].Выгрузить();
	
	Если ТаблицаДляПреобразования.Количество() = 0 Тогда
		Возврат Неопределено;	
	КонецЕсли;
		
	ТаблицаДляПреобразования.Колонки.Добавить("ВерсияДатаНачала", Новый ОписаниеТипов("Дата")); 
	ТаблицаДляПреобразования.Колонки.Добавить("Версия", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(50))); 
	ТаблицаДляПреобразования.Колонки.Добавить("ВерсияДатаУтверждения", Новый ОписаниеТипов("Дата"));

	Для каждого СтрокаТаблицаДляПреобразования Из ТаблицаДляПреобразования Цикл
		ВерсияТаксономии = ОбщегоНазначенияМСД.ТекущаяВерсияТаксономии(СтрокаТаблицаДляПреобразования.ДатаОкончания, Организация);
		Если НЕ ВерсияТаксономии = Неопределено Тогда
			СтрокаТаблицаДляПреобразования.Версия = ВерсияТаксономии.Версия;
			СтрокаТаблицаДляПреобразования.ВерсияДатаНачала = ВерсияТаксономии.Период;
			СтрокаТаблицаДляПреобразования.ВерсияДатаУтверждения = ВерсияТаксономии.ДатаУтверждения;
		КонецЕсли;	
	КонецЦикла;
	
	ТаблицаРезультат = ТаблицаДляПреобразования.Скопировать(,
	"ВерсияДатаНачала,Версия,ВерсияДатаУтверждения,ДатаНачала,ДатаОкончания,Периодичность,ПредставлениеПериода"); 
	
	ПространствоИменСверкаТаксономии = "MSD_DATA_FHD/TransferRules/TableResult"; 
	ОбъектBody = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип(ПространствоИменСверкаТаксономии, "Body"));
	
	Для каждого СтрокаТаблицы Из ТаблицаРезультат Цикл
		ОбъектPeriod = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип(ПространствоИменСверкаТаксономии, "Period"));
	    ОбъектPeriod.Version = СтрокаТаблицы.Версия;
		ОбъектPeriod.VersionStartDate = СтрокаТаблицы.ВерсияДатаНачала;
		ОбъектPeriod.VersionApprovalDate = СтрокаТаблицы.ВерсияДатаУтверждения;
		ОбъектPeriod.PeriodRepresentation = СтрокаТаблицы.ПредставлениеПериода;	
		ОбъектPeriod.Frequency = МодульСбораДанных.ПолучитьИмяПеречисления(СтрокаТаблицы.Периодичность);
		ОбъектPeriod.StartDate = СтрокаТаблицы.ДатаНачала; 
		ОбъектPeriod.EndDate = СтрокаТаблицы.ДатаОкончания;
		ОбъектBody.Period.Добавить(ОбъектPeriod);
	КонецЦикла;
	
	ЗаписьXML = Новый ЗаписьXML;
    ЗаписьXML.УстановитьСтроку();
    ФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ОбъектBody);
    ТекстОбъектBody = ЗаписьXML.Закрыть();    
    Возврат Base64Строка(ПолучитьДвоичныеДанныеИзСтроки(ТекстОбъектBody));
	
КонецФункции 

Функция ПолучитьПакетПоИдентификаторуСообщения(ПараметрыЗапроса)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ИсторияОбменаЕСМВСМЭВСрезПоследних.ДополнительныеДанные КАК ДополнительныеДанные
	|ИЗ
	|	РегистрСведений.ИсторияОбменаЕСМВСМЭВ.СрезПоследних(
	|			,
	|			Организация = &Организация
	|				И ВидСведений = &ВидСведений
	|				И ИдентификаторСообщения = &ИДСообщения) КАК ИсторияОбменаЕСМВСМЭВСрезПоследних"; 
	
	Запрос.УстановитьПараметр("ВидСведений", Перечисления.ВидыСведенийЕСМВСМЭВ.ПакетПередаваемыхДанных);
	Запрос.УстановитьПараметр("ИДСообщения", ПараметрыЗапроса.ИДИнициализирующегоСообщения);
	Запрос.УстановитьПараметр("Организация", ПараметрыЗапроса.Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.ДополнительныеДанные;	
	КонецЕсли;
	
КонецФункции

Функция ВернутьКонтрольнуюСуммуЗаголовков(ОбъединеннаяСтрокаЗаголовков)
	
	ХешированиеДанных = Новый ХешированиеДанных(ХешФункция.SHA256);
	ХешированиеДанных.Добавить(ОбъединеннаяСтрокаЗаголовков);
	КонтрольнаяСуммаЗаголовков = ХешированиеДанных.ХешСумма;
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(КонтрольнаяСуммаЗаголовков));
	
КонецФункции 

Функция ПолучитьВложениеМТОМВФорматеBase64(ДД)
	
	СтрокаBase64 = Base64Строка(ДД);
	СтрокаBase64 = СтрЗаменить(СтрокаBase64, Символы.ПС, "");
	СтрокаBase64 = СтрЗаменить(СтрокаBase64, Символы.ВК, "");
	
	Возврат СтрокаBase64;
	
КонецФункции

Процедура ЕСМВДобавитьТелоЗапросВложениеМТОМ(ТекстЗапроса, ПараметрыЗапроса)
	
	ТекстЗапроса = "
	|--uuid:" + ПараметрыЗапроса.ИдентификаторДокумента + "
	|Content-Type: application/xop+xml; charset=UTF-8; type=""text/xml""
	|Content-Transfer-Encoding: 8bit
	|Content-ID: <rootpart@soapui.org>
	|
	|" + ТекстЗапроса + "
	|
	|--uuid:" + ПараметрыЗапроса.ИдентификаторДокумента + "
	|Content-Type: application/zip; charset=UTF-8
	|Content-Transfer-Encoding: base64
	|Content-ID: <" + ПараметрыЗапроса.ИдентификаторВложенияМТОМ + ">
	|Content-Disposition: attachment; name=""" + ПараметрыЗапроса.ИмяФайлаВложенияМТОМ + """; filename=""" + ПараметрыЗапроса.ИмяФайлаВложенияМТОМ + """
	|
	|" + ПараметрыЗапроса.ДанныеФайлаВложения + "
	|--uuid:" + ПараметрыЗапроса.ИдентификаторДокумента + "--";
	
КонецПроцедуры  

Процедура ОтправитьФайлыПакетаЕСМВ(Организация, МассивФайлов)
	
	Если МассивФайлов.Количество() Тогда
		Действие = Перечисления.ДействияПередачиЕСМВСМЭВ.Отправка;
		ПараметрыЗапроса = ПолучитьПараметрыЗапроса(Организация, Действие, "Пакет");
		Если ПараметрыЗапроса.Отказ Тогда
			ОбщегоНазначения.СообщитьПользователю(ПараметрыЗапроса.ТекстОшибки);
			Возврат;
		КонецЕсли;
	Иначе
		Возврат;
	КонецЕсли;
	
	Для каждого СтрокаВидСведений Из ПараметрыЗапроса.ВидыСведений Цикл
		
		ПараметрыЗапроса.Вставить("КодВидаСведений", СтрокаВидСведений.КодВидаСведений); 
		ПараметрыЗапроса.Вставить("ВидСведений", СтрокаВидСведений.ВидСведений);
		ПараметрыЗапроса.Вставить("ТипДокумента", СтрокаВидСведений.ТипДокумента);
		
		Для каждого СтрокаФайл Из МассивФайлов Цикл
			
			ИмяФайлаВложенияМТОМ = СтрокаФайл.ПолноеИмяФайла;
			ИдентификаторВложенияМТОМ = Новый УникальныйИдентификатор();
			ДанныеФайлаВложения = СтрокаФайл.ДанныеФайлаBase64;
			
			ХешФайлаВложения = ПолучитьХешВложения(ДанныеФайлаВложения);
			
			ИдентификаторДокумента = Новый УникальныйИдентификатор(СтрокаФайл.ИдентификаторДокумента);
			ИдентификаторСообщения = Новый УникальныйИдентификатор(); 
			
			ПараметрыЗапроса.Вставить("Пакет", СтрокаФайл.ДанныеВыборки.Пакет);
			ПараметрыЗапроса.Вставить("ИдентификаторДокумента", ИдентификаторДокумента);
			ПараметрыЗапроса.Вставить("ИдентификаторСообщения", ИдентификаторСообщения);
			ПараметрыЗапроса.Вставить("ИмяФайлаВложенияМТОМ", ИмяФайлаВложенияМТОМ);
			ПараметрыЗапроса.Вставить("ИдентификаторВложенияМТОМ", ИдентификаторВложенияМТОМ);
			ПараметрыЗапроса.Вставить("ДанныеФайлаВложения", ДанныеФайлаВложения);
			ПараметрыЗапроса.Вставить("ДанныеВыборки", СтрокаФайл.ДанныеВыборки);		
			
			ПараметрыПакета = МодульСбораДанных.ПолучитьПараметрыПакета(СтрокаФайл.ДанныеВыборки.Пакет);			
			ТекстПараметрыПакета =
					"            <typ:param name=""MSD-DateTimeStartFormationISSI"" value=""" + ПараметрыПакета.ДатаВремяНачалаФормированияИССИ + """/>" + "
					|            <typ:param name=""MSD-DateTimeEndFormationISSI"" value=""" + ПараметрыПакета.ДатаВремяЗавершенияФормированияИССИ + """/>" + "
					|            <typ:param name=""MSD-DateTimeSignedISSI"" value=""" + ПараметрыПакета.ДатаВремяПодписанияИССИ + """/>" + "
					|            <typ:param name=""MSD-DateTimeSendingISSI"" value=""" + ПараметрыПакета.ДатаВремяОтправкиИССИ + """/>";
			
			ТекстЗапроса = "<typ:transferDocumentRequest xmlns:xs=""http://www.w3.org/2001/XMLSchema"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"" xmlns=""http://www.roskazna.ru/eb/services/transferDocumentService/types"" versionId=""1.0"">
			|    <typ:header>
			|        <typ:packageId>" + ИдентификаторСообщения + "</typ:packageId>" + ?(ЗначениеЗаполнено(СтрокаВидСведений.ИДОтправителя), "
			|        <typ:senderSystemId>" + СтрокаВидСведений.ИДОтправителя + "</typ:senderSystemId>", "") + "
			|        <typ:targetSystemId>" + СтрокаВидСведений.ИДПолучателя + "</typ:targetSystemId>
			|        <typ:documentType>" + СтрокаВидСведений.ТипДокумента + "</typ:documentType>
			|        <typ:documentGuid>" + ИдентификаторДокумента + "</typ:documentGuid>
			|        <typ:creationDateTime>" + ПолучитьТекущуюУниверсальнуюДатуВISOUTC() + "</typ:creationDateTime>
			|        <typ:params>
			|            <typ:param name=""MSD-SRCode"" value=""" + ПараметрыЗапроса.КодПоРПБС + """/>" 
			+ ТекстПараметрыПакета + "
			|        </typ:params>
			|    </typ:header>";
			
			//Вложение МТОМ
			ТекстЗапроса = ТекстЗапроса + "
			|    <typ:attachments>
			|        <typ:attachment>
			|            <typ:fileName>" + ИмяФайлаВложенияМТОМ + "</typ:fileName>
			|            <typ:contentType>application/zip</typ:contentType>
			|            <typ:content><inc:Include href=""cid:" + ИдентификаторВложенияМТОМ + """ xmlns:inc=""http://www.w3.org/2004/08/xop/include""/></typ:content>
			|            <typ:params>
			|                <typ:param name=""hash_oid"" value=""2.16.840.1.101.3.4.2.1""/>
			|                <typ:param name=""hash_hexdigest"" value=""" + ХешФайлаВложения + """/>
			|            </typ:params>
			|        </typ:attachment>
			|</typ:attachments>";
			
			ТекстЗапроса = ТекстЗапроса + "
			|</typ:transferDocumentRequest>";  
			
			ПодписатьТело(ТекстЗапроса, ПараметрыЗапроса); 
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОтправитьЗапросНаСверкуЕСМВ(Организация, ТипЗапроса, ДополнительныеПараметры = Неопределено)
	
	Действие = Перечисления.ДействияПередачиЕСМВСМЭВ.Отправка;
	ОтчетныйПериод = Неопределено;
	Если НЕ ДополнительныеПараметры = Неопределено Тогда
		Если ДополнительныеПараметры.Свойство("ОтчетныйПериод") Тогда
			ОтчетныйПериод = ДополнительныеПараметры.ОтчетныйПериод;
		КонецЕсли; 
	КонецЕсли;	
	ПараметрыЗапроса = ПолучитьПараметрыЗапроса(Организация, Действие, ТипЗапроса, ОтчетныйПериод);
	Если ПараметрыЗапроса.Отказ Тогда
		ОбщегоНазначения.СообщитьПользователю(ПараметрыЗапроса.ТекстОшибки);
		Возврат;
	КонецЕсли;
	ПараметрыЗапроса.Вставить("Пакет", Неопределено);
	МассивФайлов = Новый Массив; 
	НужнаСверка = Истина;
	Если НЕ ДополнительныеПараметры = Неопределено Тогда 
		Если ДополнительныеПараметры.Свойство("ГодЗапроса") Тогда
			ПараметрыЗапроса.Вставить("ГодЗапроса", ДополнительныеПараметры.ГодЗапроса);
			ДатаЗапроса = Дата(ДополнительныеПараметры.ГодЗапроса,1,1);
		Иначе
			ДатаЗапроса = ПараметрыЗапроса.ДатаЗапроса;
		КонецЕсли; 
		Если ДополнительныеПараметры.Свойство("МассивФайлов") Тогда 
			Если НЕ ДополнительныеПараметры.МассивФайлов.Количество() Тогда
				Возврат;
			КонецЕсли;	
			МассивФайлов = ДополнительныеПараметры.МассивФайлов;
		КонецЕсли;
		Если ДополнительныеПараметры.Свойство("НужнаСверка") Тогда 
			НужнаСверка = ДополнительныеПараметры.НужнаСверка;
		КонецЕсли;
		Если ДополнительныеПараметры.Свойство("ВключитьРежимОтладки") Тогда 
			ПараметрыЗапроса.Вставить("ВключитьРежимОтладки", ДополнительныеПараметры.ВключитьРежимОтладки);
		КонецЕсли;
	Иначе
		ДатаЗапроса = ПараметрыЗапроса.ДатаЗапроса;
	КонецЕсли; 
	
	Если ТипЗапроса = "СтатусПакета" Тогда
		Если МассивФайлов.Количество() Тогда 
			Для каждого СтрокаФайл Из МассивФайлов Цикл
				ПараметрыЗапроса.Вставить("ИдентификаторДокумента", СтрокаФайл.ИдентификаторДокумента);
				Прервать;
			КонецЦикла;
		Иначе
			Возврат;	
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗапроса = "Таксономия" И НужнаСверка И ПараметрыЗапроса.ТаблицаРезультат = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Настройка программы для получения таксономии через ЕСМВ не выполнена. 
		|Для получения таксономии заранее должны быть загружены сведения о сроках предоставления данных МСД.'", ОбщегоНазначения.КодОсновногоЯзыка()));
		Возврат;	
	КонецЕсли;
	
	Для каждого СтрокаВидСведений Из ПараметрыЗапроса.ВидыСведений Цикл
		
		Если ТипЗапроса = "СтатусПакета" Тогда
			ИдентификаторДокумента = ПараметрыЗапроса.ИдентификаторДокумента;
		Иначе
			ИдентификаторДокумента = Новый УникальныйИдентификатор();
			ПараметрыЗапроса.Вставить("ИдентификаторДокумента", ИдентификаторДокумента);
		КонецЕсли;
		ИдентификаторСообщения = Новый УникальныйИдентификатор();
		ПараметрыЗапроса.Вставить("ИдентификаторСообщения", ИдентификаторСообщения);
		
		ТекстЗапроса = "<typ:transferDocumentRequest xmlns:xs=""http://www.w3.org/2001/XMLSchema"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"" xmlns=""http://www.roskazna.ru/eb/services/transferDocumentService/types"" versionId=""1.0"">
		|    <typ:header>
		|        <typ:packageId>" + ИдентификаторСообщения + "</typ:packageId>" + ?(ЗначениеЗаполнено(СтрокаВидСведений.ИДОтправителя), "
		|        <typ:senderSystemId>" + СтрокаВидСведений.ИДОтправителя + "</typ:senderSystemId>", "") + "
		|        <typ:targetSystemId>" + СтрокаВидСведений.ИДПолучателя + "</typ:targetSystemId>
		|        <typ:documentType>" + СтрокаВидСведений.ТипДокумента + "</typ:documentType>
		|        <typ:documentGuid>" + ИдентификаторДокумента + "</typ:documentGuid>
		|        <typ:creationDateTime>" + ПолучитьТекущуюУниверсальнуюДатуВISOUTC() + "</typ:creationDateTime>
		|        <typ:params>
		|            <typ:param name=""MSD-SRCode"" value=""" + ПараметрыЗапроса.КодПоРПБС + """/>
		|            <typ:param name=""MSD-ReportDate"" value=""" + ДатаЗапроса + """/>" + ?(ТипЗапроса = "СтатусПакета", "", " 
		|            <typ:param name=""MSD-NeedCheck"" value=""" + ?(НужнаСверка, "true", "false") + """/>" + ?(ТипЗапроса = "Сроки", "
		|            <typ:param name=""MSD-Hash"" value=""" + ПараметрыЗапроса.ХешСрокиПредоставления + """/>", ?(НужнаСверка," 
		|            <typ:param name=""MSD-TableResult"" value=""" + ПараметрыЗапроса.ТаблицаРезультат + """/>" , ""))) + "
		|        </typ:params>
		|    </typ:header>";
		
		ТекстЗапроса = ТекстЗапроса + "
		|</typ:transferDocumentRequest>";   
		
		ПараметрыЗапроса.Вставить("КодВидаСведений", СтрокаВидСведений.КодВидаСведений);
		ПараметрыЗапроса.Вставить("ВидСведений", СтрокаВидСведений.ВидСведений);
		ПараметрыЗапроса.Вставить("ТипДокумента", СтрокаВидСведений.ТипДокумента);
		
		ПодписатьТело(ТекстЗапроса, ПараметрыЗапроса);  
		
	КонецЦикла;
	
	
КонецПроцедуры

Процедура ОтправкаЗапроса(ДополнительныеПараметры)
	
	ТекстОтвета = "";
	
	Хост = ДополнительныеПараметры.ПараметрыЗапроса.АдресСервера;
	
	Заголовки = ДополнительныеПараметры.ЗаголовкиЗапроса;
	ИмяСервиса = ДополнительныеПараметры.ПараметрыЗапроса.ТочкаСервиса;
	Кодировка = "UTF-8";
	
	Попытка
		ИнтернетПрокси = Неопределено;
		Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ПолучениеФайловИзИнтернета") Тогда
			МодульПолучениеФайловИзИнтернета = ОбщегоНазначения.ОбщийМодуль("ПолучениеФайловИзИнтернета");
			ИнтернетПрокси = МодульПолучениеФайловИзИнтернета.ПолучитьПрокси("https");
		КонецЕсли;
		
		ДДСертификата = ПолучитьДДСертификата(ДополнительныеПараметры.ПараметрыЗапроса.ТранспортныйСертификат);
        СертификатКриптографии = Новый СертификатКриптографии(ДДСертификата);
        ЗащищенноеСоединениеOpenSSL = Новый ЗащищенноеСоединениеOpenSSL(СертификатКриптографии);
        
        Соединение = Новый HTTPСоединение(Хост,,,,ИнтернетПрокси,,ЗащищенноеСоединениеOpenSSL);
		
		ДополнительныеПараметры.ПараметрыЗапроса.Вставить("Период", УниверсальноеВремя(ТекущаяДатаСеанса()));
		
		HTTPЗапрос = Новый HTTPЗапрос(ИмяСервиса, Заголовки);
		HTTPЗапрос.УстановитьТелоИзСтроки(СокрЛП(ДополнительныеПараметры.ТекстЗапроса), Кодировка);
		HTTPОтвет = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
		
		ЗаголовкиОтвета = HTTPОтвет.Заголовки;
		
		ТекстОтветаHTTP = HTTPОтвет.ПолучитьТелоКакСтроку(Кодировка); 
		
		Если ДополнительныеПараметры.ПараметрыЗапроса.Свойство("ВключитьРежимОтладки") Тогда
			Если ДополнительныеПараметры.ПараметрыЗапроса.ВключитьРежимОтладки Тогда
				
				ЗаголовкиЗапроса = "";
				Для каждого СтрЗаголовкиЗапроса Из Заголовки Цикл
					ЗаголовкиЗапроса = ЗаголовкиЗапроса + "
					|" + СтрЗаголовкиЗапроса.Ключ + ": " + СтрЗаголовкиЗапроса.Значение;	
				КонецЦикла; 
				
				ЗаголовкиОтветаТекст = "";
				Для каждого СтрЗаголовкиОтвета Из ЗаголовкиОтвета Цикл
					ЗаголовкиОтветаТекст = ЗаголовкиОтветаТекст + "
					|" + СтрЗаголовкиОтвета.Ключ + ": " + СтрЗаголовкиОтвета.Значение;	
				КонецЦикла;

				
				ТекстРежимОтладки = СтрШаблон(НСтр("ru='Имя сервиса:
				|
				|%1
				|
				|Заголовки запроса: 
				|%2 
				|
				|Текст запроса:
				|
				|%3 
				|
				|Заголовки ответа: 
				|%4
				|
				|Текст ответа:
				|
				|%5
				|'"), ИмяСервиса, ЗаголовкиЗапроса, СокрЛП(ДополнительныеПараметры.ТекстЗапроса), ЗаголовкиОтветаТекст, ТекстОтветаHTTP);
				ОбщегоНазначения.СообщитьПользователю(ТекстРежимОтладки);
				
			КонецЕсли;	
		КонецЕсли;	
		
		Если HTTPОтвет.КодСостояния >= 300 Тогда
			Попытка
				ЧтениеJSON = Новый ЧтениеJSON;
				ЧтениеJSON.УстановитьСтроку(ТекстОтветаHTTP);
				Результат = ПрочитатьJSON(ЧтениеJSON);
				ЧтениеJSON.Закрыть();
				СообщениеТекст = "";
				Если Результат.type = "INCORRECT_CLIENT_INFO_SYSTEM" Тогда
					СообщениеТекст = НСтр("ru = 'не найден клиент по указанному в настройках техническому наименованию внешней ИС'");
				ИначеЕсли Результат.type = "INVALID_REQUEST_HEADER" Тогда
					СообщениеТекст = НСтр("ru = 'в запросе отсутствует или некорректно указан обязательный заголовок'"); 
				ИначеЕсли Результат.type = "JINN_SERVICE" Тогда
					СообщениеТекст = НСтр("ru = 'в запросе указана некорректная подпись'");
                ИначеЕсли Результат.type = "INCORRECT_CHECKSUM" Тогда
					СообщениеТекст = НСтр("ru = 'в запросе указана некорректная контрольная сумма'");
				ИначеЕсли Результат.type = "DELAY_ERROR" Тогда
					СообщениеТекст = НСтр("ru = 'в запросе время превышает допустимое расхождение времени между значением в заголовке и временем получения запроса'");
				ИначеЕсли Результат.type = "OAUTH2_NOT_ALLOWED" Тогда
					СообщениеТекст = НСтр("ru = 'протокол OAuth 2.0 не разрешен для информационной системы'");
				ИначеЕсли Результат.type = "INCORRECT_CERTIFICATE" Тогда
					СообщениеТекст = НСтр("ru = 'в запросе указан некорректный сертификат'");
				ИначеЕсли Результат.type = "EMPTY_TARGET_INFO_SYSTEM_ROLES" Тогда
					СообщениеТекст = НСтр("ru = 'нет активных ролей'");
				ИначеЕсли Результат.type = "ACTION_NOT_ALLOWED" Тогда
					СообщениеТекст = НСтр("ru = 'в запросе указан некорректный метод'");
				ИначеЕсли Результат.type = "INTERNAL_SERVER_ERROR" Тогда
					СообщениеТекст = НСтр("ru = 'в запросе указан некорректный хост'");
				КонецЕсли;
				Если ЗначениеЗаполнено(СообщениеТекст) Тогда
					ТекстОшибки = СтрШаблон(НСтр("ru = 'Ошибка обработки команды по причине: %1. Подробности см. в журнале регистрации.'"), СообщениеТекст);
					МодульЖурналРегистрации = ОбщегоНазначения.ОбщийМодуль("ЖурналРегистрации");
					МодульЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(НСтр("ru = 'ОтправкаЗапросовЕСМВСервер'", ОбщегоНазначения.КодОсновногоЯзыка()),
					УровеньЖурналаРегистрации.Ошибка,,,ТекстОтветаHTTP);
					ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
					Возврат;
				Иначе
					ВызватьИсключение "Код состояния: " + HTTPОтвет.КодСостояния + "
					|" + ТекстОтветаHTTP;
				КонецЕсли;	
			Исключение
			   	ВызватьИсключение "Код состояния: " + HTTPОтвет.КодСостояния + "
				|" + ТекстОтветаHTTP;
			КонецПопытки; 
		КонецЕсли;
		
		МассивФайлов = Новый Массив;
		
		ContentType = ЗаголовкиОтвета.Получить("Content-Type");
		ПотокДанных = HTTPОтвет.ПолучитьТелоКакПоток();
		
		Если СтрНайти(ContentType, "multipart") > 0 Тогда
			Разделитель = ПолучитьРазделительСоставногоЗапроса(ЗаголовкиОтвета);
			ЗначениеStart = ПолучитьИмяStartЗапроса(ЗаголовкиОтвета);
			
			СтрРезультата = ПрочитатьСоставнойЗапрос(ЗначениеStart, Разделитель, ПотокДанных);
			Если СтрРезультата.Ошибка Тогда
				ВызватьИсключение СтрРезультата.ТекстОшибки; 
			КонецЕсли;    
			
			МассивФайлов = СтрРезультата.МассивФайлов; 
			ЗакрытьПоток = Ложь;
		Иначе       
			ПотокДанных.Перейти(0, ПозицияВПотоке.Начало);
			ЗакрытьПоток = Истина;	
		КонецЕсли;
		
		Если МассивФайлов.Количество() Тогда
			
			Для каждого СтрокаФайл Из МассивФайлов Цикл
				ДД = СтрокаФайл.content;
				ДД = ПолучитьСтрокуИзДвоичныхДанных(base64Значение(ПолучитьСтрокуИзДвоичныхДанных(ДД)));
				СтрокаФайл.Вставить("ДД", ДД);
			КонецЦикла;
			
			ТекстОтвета = ПолучитьСтрокуИзДвоичныхДанных(base64значение(ПолучитьСтрокуИзДвоичныхДанных(СтрРезультата.ОсновнойЗапрос)));
			ЧтениеXML = Новый ЧтениеXML;
			ЧтениеXML.УстановитьСтроку(ТекстОтвета);
		Иначе
			ЧтениеXML = Новый ЧтениеXML;
			ЧтениеXML.ОткрытьПоток(ПотокДанных);
		КонецЕсли;
		
		Данные = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
		ОбъектBody = Данные.Body;
		
		ЧтениеXML.Закрыть();
		Если ЗакрытьПоток Тогда
			ПотокДанных.Закрыть();
		КонецЕсли;
		
		Отказ = Ложь;
		ПроверитьИОбработатьОшибку(ОбъектBody, ДополнительныеПараметры, Отказ);
		
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		
		ДополнительныеПараметры.Вставить("ТекстОтвета", ТекстОтветаHTTP);
		ДополнительныеПараметры.Вставить("МассивФайлов", МассивФайлов);
		ОбработатьСообщение(ОбъектBody, ДополнительныеПараметры);
		
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		МодульЖурналРегистрации = ОбщегоНазначения.ОбщийМодуль("ЖурналРегистрации");
		МодульЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(НСтр("ru = 'ОтправкаЗапросовЕСМВСервер'", ОбщегоНазначения.КодОсновногоЯзыка()),
		УровеньЖурналаРегистрации.Ошибка,,,ТекстОшибки);
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Ошибка обработки команды. Подробности см. в журнале регистрации.'"));
		
	КонецПопытки;
	
КонецПроцедуры 

Функция ПолучитьПараметрыПередачи(ПараметрыЗапроса)
	
	СтруктураРезультат = Новый Структура;
	
	Для Каждого КлючИЗначение Из ПараметрыЗапроса Цикл
		СтруктураРезультат.Вставить(КлючИЗначение.Ключ, 
		ОбщегоНазначения.СкопироватьРекурсивно(КлючИЗначение.Значение, Ложь));
	КонецЦикла;
	
	Возврат СтруктураРезультат;
	
КонецФункции

Процедура ДобавитьСтрокуВТаблицуЗаголовков(Таблица, Имя, Значение)
	
	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.Имя = Имя;
	НоваяСтрока.Значение = Значение;
	
КонецПроцедуры

#Область ОбработкаСообщений

Процедура ПроверитьИОбработатьОшибку(ОбъектBody, ДополнительныеПараметры, Отказ)
	
	Если НЕ ОбъектBody.Свойства().Получить("Fault") = Неопределено Тогда 
		ТекстОшибки = ОбъектBody.Fault.faultcode + ": " + ОбъектBody.Fault.faultstring;
		МодульЖурналРегистрации = ОбщегоНазначения.ОбщийМодуль("ЖурналРегистрации");
		МодульЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(НСтр("ru='ПолучениеОтветовИзОчередиЕСМВСервер'", ОбщегоНазначения.КодОсновногоЯзыка()),
		УровеньЖурналаРегистрации.Ошибка,,, "Тип опроса очереди: " + ?(ЗначениеЗаполнено(ДополнительныеПараметры.ПараметрыЗапроса.ТипЗапроса), ДополнительныеПараметры.ПараметрыЗапроса.ТипЗапроса, "Все")  + ". 
		|" + ТекстОшибки);
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Ошибка обработки команды. Подробности см. в журнале регистрации.'")); 
		Отказ = Истина;		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьСообщение(ОбъектBody, ДополнительныеПараметры)
	
	Если ДополнительныеПараметры.ПараметрыЗапроса.ДействиеПередачи = Перечисления.ДействияПередачиЕСМВСМЭВ.Отправка Тогда			 
		ОбработатьОтправкуЗапроса(ОбъектBody, ДополнительныеПараметры);		 
	ИначеЕсли ДополнительныеПараметры.ПараметрыЗапроса.ДействиеПередачи = Перечисления.ДействияПередачиЕСМВСМЭВ.Получение Тогда
		ОбработатьПолучениеОтвета(ОбъектBody, ДополнительныеПараметры);
	Иначе
		ОбработатьПодтверждениеПолучения(ОбъектBody, ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры	

Процедура ОбработатьОтправкуЗапроса(ОбъектBody, ДополнительныеПараметры)
	
	ДополнительныеПараметры.ПараметрыЗапроса.Вставить("ИДИнициализирующегоСообщения", ДополнительныеПараметры.ПараметрыЗапроса.ИдентификаторСообщения); 
	ДополнительныеПараметры.ПараметрыЗапроса.Вставить("СодержаниеСообщения", Перечисления.СодержанияСообщенийЕСМВСМЭВ.Данные);  
	ПараметрыПередачи = ПолучитьПараметрыПередачи(ДополнительныеПараметры.ПараметрыЗапроса);
	
	ТекстОшибки = НСтр("ru='Подробности см. в истории обмена ЕСМВ.'");
	СообщениеОбОшибке = Истина;
	
	Если НЕ ОбъектBody.Свойства().Получить("transferDocumentResponse") = Неопределено Тогда
		Если НЕ ОбъектBody.transferDocumentResponse.Свойства().Получить("status") = Неопределено Тогда
			Если НЕ ОбъектBody.transferDocumentResponse.status.Свойства().Получить("statusCode") = Неопределено Тогда
				Если ОбъектBody.transferDocumentResponse.status.statusCode = "0" Тогда
					СообщениеОбОшибке = Ложь;
				Иначе
					Если ТипЗнч(ОбъектBody.transferDocumentResponse.status.statusMessage) = Тип("Строка") Тогда
						ТекстОшибки = ОбъектBody.transferDocumentResponse.status.statusMessage;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;  
	
	Если СообщениеОбОшибке Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Сообщение не было отправлено. '") + ТекстОшибки); 
	Иначе
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='В сервис отправлен запрос на получение данных.'"));
	КонецЕсли; 
	
	Если ДополнительныеПараметры.ПараметрыЗапроса.ВидСведений = Перечисления.ВидыСведенийЕСМВСМЭВ.ПакетПередаваемыхДанных Тогда
		ЗаписатьСтатусПакетаДанных(ПараметрыПередачи, ?(СообщениеОбОшибке, ТекстОшибки, "")); 
	Иначе
		Если НЕ СообщениеОбОшибке Тогда 
			ОтразитьДанныеЗапроса(ПараметрыПередачи);
		КонецЕсли;
	КонецЕсли; 
	ПараметрыПередачи = ПолучитьПараметрыПередачи(ДополнительныеПараметры.ПараметрыЗапроса);
	ЗаписатьВИсториюОбмена(ДополнительныеПараметры.ТекстЗапроса, ДополнительныеПараметры.ТекстОтвета, ПараметрыПередачи);
	
КонецПроцедуры

Процедура ОбработатьПолучениеОтвета(ОбъектBody, ДополнительныеПараметры, АдресРезультат = "")
	
	Если ТипЗнч(ОбъектBody) = Тип("Строка") Тогда
		ОбъектBody = ОбщегоНазначения.ОбъектXDTOИзСтрокиXML(ОбъектBody);		
	КонецЕсли;
	
	Если НЕ ОбъектBody.Свойства().Получить("transferDocumentRequests") = Неопределено Тогда
		Если НЕ ОбъектBody.transferDocumentRequests.Свойства().Получить("transferDocumentRequest") = Неопределено Тогда
			
			МассивДокументов = Новый Массив;
			Если ТипЗнч(ОбъектBody.transferDocumentRequests.transferDocumentRequest) = Тип("СписокXDTO") Тогда
				МассивДокументов = ОбъектBody.transferDocumentRequests.transferDocumentRequest;
			Иначе
				МассивДокументов.Добавить(ОбъектBody.transferDocumentRequests.transferDocumentRequest);
			КонецЕсли;
			
			МассивДокументовПодтверждение = Новый Массив;
			
			Для каждого СтрокаДокумент Из МассивДокументов Цикл
				Если НЕ СтрокаДокумент.Свойства().Получить("header") = Неопределено Тогда
					Если НЕ СтрокаДокумент.header.Свойства().Получить("documentType") = Неопределено Тогда
						
						ДатаОтвета = СтрокаДокумент.header.creationDateTime;
						ДатаОтвета = Дата(Лев(ДатаОтвета, 4), Сред(ДатаОтвета, 6, 2), Сред(ДатаОтвета, 9, 2), 
						Сред(ДатаОтвета, 12, 2), Сред(ДатаОтвета, 15, 2), Сред(ДатаОтвета, 18, 2));
						ДополнительныеПараметры.ПараметрыЗапроса.Вставить("ДатаОтвета", ДатаОтвета);
						
						ИДИнициализирующегоСообщения = "";
						ИдентификаторДокумента = ""; 
						СистемаПолучатель = ""; 
						ТаблицаРезультатXDTO = "";
						Совпадает = "";
						Статус = "";
						
						Если НЕ СтрокаДокумент.header.Свойства().Получить("params") = Неопределено Тогда 
							Если НЕ СтрокаДокумент.header.params.Свойства().Получить("param") = Неопределено Тогда
								МассивПараметров = Новый Массив;
								Если ТипЗнч(СтрокаДокумент.header.params.param) = Тип("СписокXDTO") Тогда
									МассивПараметров = СтрокаДокумент.header.params.param;
								Иначе
									МассивПараметров.Добавить(СтрокаДокумент.header.params.param);
								КонецЕсли;
								
								Для каждого СтрокаПараметр Из МассивПараметров Цикл
									Если СтрокаПараметр.name = "MSD_ParentRequest_packageId" Тогда
										ИДИнициализирующегоСообщения = Новый УникальныйИдентификатор(СтрокаПараметр.value);
									ИначеЕсли СтрокаПараметр.name = "MSD_ParentRequest_documentGuid" Тогда
										ИдентификаторДокумента = Новый УникальныйИдентификатор(СтрокаПараметр.value); 
									ИначеЕсли СтрокаПараметр.name = "MSD_TableResult" Тогда
										ТаблицаРезультатXDTO = ПолучитьСтрокуИзДвоичныхДанных(Base64Значение(СтрЗаменить(СтрокаПараметр.value," ", "")));
									ИначеЕсли СтрокаПараметр.name = "POIB-Request-TargetSystem-ID" Тогда
										СистемаПолучатель = СтрокаПараметр.value; 
									ИначеЕсли СтрокаПараметр.name = "MSD_Coincides" Тогда
										Совпадает = СтрокаПараметр.value; 
									ИначеЕсли СтрокаПараметр.name = "MSD-StatusCode" Тогда
										Статус = СтрокаПараметр.value;
									КонецЕсли;
								КонецЦикла;
							КонецЕсли;
						КонецЕсли;
						Если ЗначениеЗаполнено(СистемаПолучатель) Тогда
							ОрганизацияПолучатель = ПолучитьОрганизациюПоИдентификаторуИС(СистемаПолучатель);
							Если ЗначениеЗаполнено(ОрганизацияПолучатель) Тогда
								ДополнительныеПараметры.ПараметрыЗапроса.Вставить("Организация", ОрганизацияПолучатель);	
							КонецЕсли;	
						КонецЕсли;
						
						ДополнительныеПараметры.ПараметрыЗапроса.Вставить("ТипДокумента", СтрокаДокумент.header.documentType);
						ИдентификаторСообщения = Новый УникальныйИдентификатор(СтрокаДокумент.header.packageId);
											
						ЭтоКвитанция = (СтрокаДокумент.header.documentType = "transferDocumentReceipt");
						Если ЭтоКвитанция Тогда
							ИДИнициализирующегоСообщения = Новый УникальныйИдентификатор(СтрокаДокумент.document.transferDocumentReceipt.packageId);
							ИдентификаторДокумента = Новый УникальныйИдентификатор(СтрокаДокумент.document.transferDocumentReceipt.documentGuid);
							ДополнительныеПараметры.ПараметрыЗапроса.Вставить("ИдентификаторСообщения", Новый УникальныйИдентификатор(СтрокаДокумент.header.packageId));
							ДополнительныеПараметры.ПараметрыЗапроса.Вставить("ИДИнициализирующегоСообщения", ИДИнициализирующегоСообщения);
							ДополнительныеПараметры.ПараметрыЗапроса.Вставить("ИдентификаторДокумента", ИдентификаторДокумента);
							
							ОписаниеОшибки = "";
							Если Не ЗначениеЗаполнено(Статус) Тогда
								Статус = "0";
								Если Не СтрокаДокумент.document.transferDocumentReceipt.status.Свойства().Получить("statusCode") = Неопределено Тогда
									Статус = СтрокаДокумент.document.transferDocumentReceipt.status.statusCode;
								КонецЕсли; 
							КонецЕсли;
							Если Не Статус = "0" И НЕ Статус = "1" Тогда
								Если Не СтрокаДокумент.document.transferDocumentReceipt.status.Свойства().Получить("statusDetail") = Неопределено 
									И ТипЗнч(СтрокаДокумент.document.transferDocumentReceipt.status.statusDetail) = Тип("Строка") Тогда
									ОписаниеОшибки = СтрокаДокумент.document.transferDocumentReceipt.status.statusDetail;
								ИначеЕсли ТипЗнч(СтрокаДокумент.document.transferDocumentReceipt.status.statusMessage) = Тип("Строка") Тогда
									ОписаниеОшибки = СтрокаДокумент.document.transferDocumentReceipt.status.statusMessage;
								КонецЕсли;
							КонецЕсли;
							ДополнительныеПараметры.ПараметрыЗапроса.Вставить("ОписаниеОшибки", ОписаниеОшибки);
							Если СтрокаДокумент.header.senderSystemId = "ESMV" Тогда
								ДополнительныеПараметры.ПараметрыЗапроса.Вставить("СодержаниеСообщения", Перечисления.СодержанияСообщенийЕСМВСМЭВ.ТранспортнаяКвитанция);
							Иначе
								ДополнительныеПараметры.ПараметрыЗапроса.Вставить("СодержаниеСообщения", Перечисления.СодержанияСообщенийЕСМВСМЭВ.ПрикладнаяКвитанция);
							КонецЕсли;
							
							ПараметрыПередачи = ПолучитьПараметрыПередачи(ДополнительныеПараметры.ПараметрыЗапроса);
							
							Если ДополнительныеПараметры.ПараметрыЗапроса.ВидСведений = Перечисления.ВидыСведенийЕСМВСМЭВ.ПакетПередаваемыхДанных Тогда
								ЗаписатьСтатусКвитанции(ИДИнициализирующегоСообщения, Статус, ПараметрыПередачи);
							Иначе
								ПараметрыПередачи.Вставить("ИдентификаторСообщения", ПараметрыПередачи.ИДИнициализирующегоСообщения);
								ОтразитьДанныеЗапроса(ПараметрыПередачи, Статус);
							КонецЕсли;
							Если Совпадает = "true" Тогда
								ОтразитьСтатусСверки(ПараметрыПередачи);	
							КонецЕсли;
						Иначе							
														
							ДополнительныеПараметры.ПараметрыЗапроса.Вставить("ИдентификаторСообщения", ИдентификаторСообщения);
							ДополнительныеПараметры.ПараметрыЗапроса.Вставить("ИДИнициализирующегоСообщения", ИДИнициализирующегоСообщения);
							ДополнительныеПараметры.ПараметрыЗапроса.Вставить("ИдентификаторДокумента", ИдентификаторДокумента);
							
							СтруктураПараметров = Новый Структура;
							ЕстьОрганизация = Ложь;	
							Если ДополнительныеПараметры.ПараметрыЗапроса.Свойство("Организация") И ЗначениеЗаполнено(ДополнительныеПараметры.ПараметрыЗапроса.Организация) Тогда
								СтруктураПараметров.Вставить("Организация", ДополнительныеПараметры.ПараметрыЗапроса.Организация);
								ЕстьОрганизация = Истина;
							КонецЕсли;
							
							ДанныеФайлов = Новый Массив;
							Если НЕ СтрокаДокумент.Свойства().Получить("attachments") = Неопределено Тогда 
								Если НЕ СтрокаДокумент.attachments.Свойства().Получить("attachment") = Неопределено Тогда 
									Если ТипЗнч(СтрокаДокумент.attachments.attachment) = Тип("СписокXDTO") Тогда
										ДанныеФайлов = СтрокаДокумент.attachments.attachment;
									Иначе
										ДанныеФайлов.Добавить(СтрокаДокумент.attachments.attachment);
									КонецЕсли; 
								КонецЕсли;
							КонецЕсли;
														
							Для каждого СтрокаДанныеФайла Из ДанныеФайлов Цикл
								
								ИДФайла = СтрЗаменить(СтрокаДанныеФайла.content.Include.href, "cid:", "");
							
								ДД = Неопределено;
								Для каждого СтрокаФайл Из ДополнительныеПараметры.МассивФайлов Цикл
									Если СтрокаФайл.fileName = ИДФайла Тогда						
										Если СтрНайти(СтрокаФайл.ДД, "</Body>--") > 0 Тогда
											ДанныеСтрока = СокрЛП(СтрЗаменить(СтрокаФайл.ДД, "</Body>--", "</Body>"));
											ДД = Base64Строка(ПолучитьДвоичныеДанныеИзСтроки(ДанныеСтрока));
										Иначе
											ДД = СтрокаФайл.ДД;
										КонецЕсли;	
										Прервать;
									КонецЕсли;	
								КонецЦикла;
								
								СтруктураПараметров.Вставить("Данные", ДД);
																
								Если ДополнительныеПараметры.ПараметрыЗапроса.ВидСведений = Перечисления.ВидыСведенийЕСМВСМЭВ.Протокол 
									ИЛИ ДополнительныеПараметры.ПараметрыЗапроса.ВидСведений = Перечисления.ВидыСведенийЕСМВСМЭВ.СтатусПакета Тогда
									СтруктураПараметров.Вставить("ИдентификаторПакета", ДополнительныеПараметры.ПараметрыЗапроса.ИдентификаторДокумента);
									МодульСбораДанных.ЗагрузитьПротокол(СтруктураПараметров);
								ИначеЕсли ДополнительныеПараметры.ПараметрыЗапроса.ВидСведений = Перечисления.ВидыСведенийЕСМВСМЭВ.СрокиПредоставления Тогда 																		 
									МодульСбораДанных.ЗагрузитьСрокиПредоставленияДанных(СтруктураПараметров);
								ИначеЕсли ДополнительныеПараметры.ПараметрыЗапроса.ВидСведений = Перечисления.ВидыСведенийЕСМВСМЭВ.Таксономия Тогда 																		                                                                                                                           									
									ЗагрузитьТаксономию(СтруктураПараметров, ?(ЕстьОрганизация, СтруктураПараметров.Организация, Неопределено));
								КонецЕсли;
								
							КонецЦикла; 
							
							Если ДополнительныеПараметры.ПараметрыЗапроса.ВидСведений = Перечисления.ВидыСведенийЕСМВСМЭВ.Таксономия Тогда 																		                                                                                                                           	
								Если ЗначениеЗаполнено(ТаблицаРезультатXDTO) Тогда
									СтруктураПараметров.Вставить("ТаблицаРезультатXDTO", ТаблицаРезультатXDTO);
									ОбработатьОтветСверкиТаксономии(СтруктураПараметров, ?(ЕстьОрганизация, СтруктураПараметров.Организация, Неопределено));
								КонецЕсли;	
							КонецЕсли;
														
							ДополнительныеПараметры.ПараметрыЗапроса.Вставить("СодержаниеСообщения", Перечисления.СодержанияСообщенийЕСМВСМЭВ.Данные);							 
							ПараметрыПередачи = ПолучитьПараметрыПередачи(ДополнительныеПараметры.ПараметрыЗапроса);
							ПараметрыПередачи.Вставить("ИдентификаторСообщения", ПараметрыПередачи.ИДИнициализирующегоСообщения);
							ОтразитьДанныеЗапроса(ПараметрыПередачи, "1");
							Если ДополнительныеПараметры.ПараметрыЗапроса.ВидСведений = Перечисления.ВидыСведенийЕСМВСМЭВ.СрокиПредоставления 
								ИЛИ ДополнительныеПараметры.ПараметрыЗапроса.ВидСведений = Перечисления.ВидыСведенийЕСМВСМЭВ.Таксономия Тогда 
								ОтразитьСтатусСверки(ПараметрыПередачи);
							КонецЕсли;
						КонецЕсли;
						СтруктураДокумента = Новый Структура;
						СтруктураДокумента.Вставить("ТипДокумента", ПараметрыПередачи.ТипДокумента); 
						СтруктураДокумента.Вставить("СодержаниеСообщения", ПараметрыПередачи.СодержаниеСообщения);
						СтруктураДокумента.Вставить("ИдентификаторСообщения", ИдентификаторСообщения);
						СтруктураДокумента.Вставить("ИДИнициализирующегоСообщения",  ПараметрыПередачи.ИДИнициализирующегоСообщения);
						СтруктураДокумента.Вставить("ИдентификаторДокумента", ПараметрыПередачи.ИдентификаторДокумента);
						СтруктураДокумента.Вставить("Отправитель", СтрокаДокумент.header.senderSystemId);
						СтруктураДокумента.Вставить("Получатель", СтрокаДокумент.header.targetSystemId);
						МассивДокументовПодтверждение.Добавить(СтруктураДокумента);
						ЗаписатьВИсториюОбмена(ДополнительныеПараметры.ТекстЗапроса, ДополнительныеПараметры.ТекстОтвета, ПараметрыПередачи);	
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			ДополнительныеПараметры.ПараметрыЗапроса.Вставить("Сообщения", МассивДокументовПодтверждение);
			Если ЗначениеЗаполнено(АдресРезультат) Тогда
				ПоместитьВоВременноеХранилище(МассивДокументовПодтверждение, АдресРезультат);	
			Иначе
				ОтправитьПодтверждениеЕСМВ(ДополнительныеПараметры);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры	

Процедура ОбработатьПолучениеОтветаВФоне(Параметры, АдресРезультат) Экспорт
	ОбработатьПолучениеОтвета(Параметры.ОбъектBody, Параметры.ДополнительныеПараметры, АдресРезультат);	
КонецПроцедуры	

Процедура ОбработатьПодтверждениеПолучения(ОбъектBody, ДополнительныеПараметры)
	
	Если НЕ ОбъектBody.Свойства().Получить("ackMessagesResponse") = Неопределено Тогда
		Если НЕ ОбъектBody.ackMessagesResponse.Свойства().Получить("ackResult") = Неопределено Тогда
			
			МассивДокументов = Новый Массив;
			Если ТипЗнч(ОбъектBody.ackMessagesResponse.ackResult) = Тип("СписокXDTO") Тогда
				МассивДокументов = ОбъектBody.ackMessagesResponse.ackResult;
			Иначе
				МассивДокументов.Добавить(ОбъектBody.ackMessagesResponse.ackResult);
			КонецЕсли;
			
			Для каждого СтрокаДокумент Из МассивДокументов Цикл  
				Если XMLЗначение(Тип("Булево"), СтрокаДокумент.succeeded) Тогда
					ЗаписатьВИсториюОбмена(ДополнительныеПараметры.ТекстЗапроса, ДополнительныеПараметры.ТекстОтвета, ДополнительныеПараметры.ПараметрыЗапроса);
				Иначе
					ТекстОшибки = НСтр("ru = 'Получение сообщений не подтверждено.'");
					Если НЕ СтрокаДокумент.Свойства().Получить("succeededInfo") = Неопределено Тогда
						ТекстОшибки = СтрокаДокумент.succeededInfo;	
					КонецЕсли;	
					МодульЖурналРегистрации = ОбщегоНазначения.ОбщийМодуль("ЖурналРегистрации");
					МодульЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(НСтр("ru='ПодтверждениеПолученияЕСМВСервер'", ОбщегоНазначения.КодОсновногоЯзыка()),
					УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
					ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Получение сообщений не подтверждено. Подробности см. в журнале регистрации.'"));
				КонецЕсли;	
			КонецЦикла; 
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры	

#КонецОбласти

Функция ПреобразоватьXDTOВТаблицуЗначений(ОбъектBody) 

	ТЗДанные = Новый ТаблицаЗначений;
	ТЗДанные.Колонки.Добавить("Версия", 				 Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(50)));
	ТЗДанные.Колонки.Добавить("ВерсияДатаНачала", 		 Новый ОписаниеТипов("Дата"));
	ТЗДанные.Колонки.Добавить("ВерсияТекущая", 			 Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(50)));
	ТЗДанные.Колонки.Добавить("ВерсияТекущаяДатаНачала", Новый ОписаниеТипов("Дата")); 
	ТЗДанные.Колонки.Добавить("Совпадает", 				 Новый ОписаниеТипов("Булево"));
	ТЗДанные.Колонки.Добавить("ВерсияДатаУтверждения",   Новый ОписаниеТипов("Дата"));
	ТЗДанные.Колонки.Добавить("ПредставлениеПериода",    Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(50)));
	ТЗДанные.Колонки.Добавить("Периодичность", 			 Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(50)));
	ТЗДанные.Колонки.Добавить("ДатаНачала", 			 Новый ОписаниеТипов("Дата")); 
	ТЗДанные.Колонки.Добавить("ДатаОкончания", 			 Новый ОписаниеТипов("Дата"));
	
	СписокXDTO = Новый Массив;
	
	Если НЕ ОбъектBody.Свойства().Получить("Period") = Неопределено Тогда 	
		Если ТипЗнч(ОбъектBody.Period) = Тип("СписокXDTO") Тогда
			СписокXDTO = ОбъектBody.Period;	
		Иначе
			СписокXDTO.Добавить(ОбъектBody.Period);
		КонецЕсли;
	КонецЕсли;
	
	Для каждого СтрокаТаблицы Из СписокXDTO Цикл
		НоваяСтрока = ТЗДанные.Добавить();
		НоваяСтрока.Версия  				= СтрокаТаблицы.Version;
		НоваяСтрока.ВерсияДатаНачала  		= СтрокаТаблицы.VersionStartDate;
		НоваяСтрока.ВерсияТекущая  			= СтрокаТаблицы.ActualVersion;
		НоваяСтрока.ВерсияТекущаяДатаНачала = СтрокаТаблицы.ActualVersionStartDate; 
		НоваяСтрока.Совпадает   			= СтрокаТаблицы.Coincides;
		НоваяСтрока.ПредставлениеПериода    = СтрокаТаблицы.PeriodRepresentation;
		НоваяСтрока.Периодичность   		= СтрокаТаблицы.Frequency;
		НоваяСтрока.ДатаНачала  			= СтрокаТаблицы.StartDate;
		НоваяСтрока.ДатаОкончания   		= СтрокаТаблицы.EndDate; 
	КонецЦикла;	
	
	Возврат ТЗДанные;
	
КонецФункции

#КонецОбласти 

#Область СоставнойЗапросMultipart

Функция ПрочитатьСоставнойЗапрос(ЗначениеStart, Разделитель, ПотокДанных)
	
	ШаблонОшибки = "При чтении пакета transferdocument произошла ошибка: %1";
	
	Результат = Новый Структура("ОсновнойЗапрос, МассивФайлов, ФорматMTOM, Ошибка, ТекстОшибки", 
	Неопределено,
	Новый Массив, 
	Истина, 
	Ложь, 
	"");
	
	
	Если Разделитель = Неопределено Тогда
		ТекстОшибки = СтрШаблон(ШаблонОшибки, " не указан разделитель частей multipart тела" );
		
		Результат.Ошибка = Истина;
		Результат.ТекстОшибки = ТекстОшибки;
		
		Возврат Результат;
		
	КонецЕсли;
	
	Маркеры = Новый Массив();
	
	Маркеры.Добавить(ПолучитьБуферДвоичныхДанныхИзСтроки("--" + Разделитель + "--"));
	Маркеры.Добавить(ПолучитьБуферДвоичныхДанныхИзСтроки("--" + Разделитель + Символы.ВК + Символы.ПС));
	Маркеры.Добавить(ПолучитьБуферДвоичныхДанныхИзСтроки("--" + Разделитель + Символы.ВК));
	Маркеры.Добавить(ПолучитьБуферДвоичныхДанныхИзСтроки("--" + Разделитель + Символы.ПС));
	Маркеры.Добавить(ПолучитьБуферДвоичныхДанныхИзСтроки("--" + Разделитель));
	
	Маркеры.Добавить(ПолучитьБуферДвоичныхДанныхИзСтроки("------=" + Разделитель + "--"));
	Маркеры.Добавить(ПолучитьБуферДвоичныхДанныхИзСтроки("------=" + Разделитель + Символы.ВК + Символы.ПС));
	Маркеры.Добавить(ПолучитьБуферДвоичныхДанныхИзСтроки("------=" + Разделитель + Символы.ВК));
	Маркеры.Добавить(ПолучитьБуферДвоичныхДанныхИзСтроки("------=" + Разделитель + Символы.ПС));
	Маркеры.Добавить(ПолучитьБуферДвоичныхДанныхИзСтроки("------=" + Разделитель)); 
	
	МассивФайлов = Новый Массив;
	
	ЧтениеДанных = Новый ЧтениеДанных(ПотокДанных);
	ПотокДанных.Перейти(0, ПозицияВПотоке.Начало);    
	
	// Перейти к началу первой части.
	ЧтениеДанных.ПропуститьДо(Маркеры);
	БуферДвоичныхДанныхПакета = ЧтениеДанных.ПрочитатьВБуферДвоичныхДанных();
	МассивБуферДвоичныхДанных = БуферДвоичныхДанныхПакета.Разделить(Маркеры);  
	
	БуферДвоичныхДанныхПакета = Неопределено;
	
	Для Индекс = 0 по МассивБуферДвоичныхДанных.ВГраница()-1 Цикл
		
		ПотокВПамяти = новый ПотокВПамяти(МассивБуферДвоичныхДанных[Индекс]);
		ЧтениеЧасти = Новый ЧтениеДанных(ПотокВПамяти);
		
		ЗаголовкиЧасти = ПрочитатьЗаголовкиСоставногоЗапроса(ЧтениеЧасти);
		
		СтрокаID = "";
		
		Если Результат.ОсновнойЗапрос = Неопределено Тогда
			ID = ЗаголовкиЧасти.Получить("Content-ID"); 
			Если ЗначениеStart = Неопределено ИЛИ ЗначениеStart = ID Тогда
				ДвоичныеДанныеОсновногоЗапроса = ЧтениеЧасти.Прочитать().ПолучитьДвоичныеДанные(); 
				Результат.ОсновнойЗапрос = ДвоичныеДанныеОсновногоЗапроса; 
				ЧтениеЧасти.Закрыть();  
				ЧтениеЧасти = Неопределено;  
				ПотокВПамяти.Закрыть(); 
				ПотокВПамяти = Неопределено;
				МассивБуферДвоичныхДанных[Индекс] = Неопределено;
				Продолжить;
			КонецЕсли;
		Иначе 
			
			ID = ЗаголовкиЧасти.Получить("Content-ID");
			ID = СтрЗаменить(ID,">",""); 
			ID = СтрЗаменить(ID,"<",""); 
			
			СтрокаID = ID;
		КонецЕсли; 
		
		Если ЗначениеЗаполнено(СтрокаID) Тогда 
			
			СтрФайла = Новый Структура("fileName, content, typeTransferContent, typeContent");
			СтрФайла.fileName = СтрокаID;
			
			ДвоичныеДанныеФайла = ЧтениеЧасти.Прочитать().ПолучитьДвоичныеДанные(); 
			СтрФайла.content = ДвоичныеДанныеФайла;    
			
			СтрФайла.typeTransferContent = ЗаголовкиЧасти.Получить("Content-Transfer-Encoding"); 
			СтрФайла.typeContent = ЗаголовкиЧасти.Получить("Content-Type");
			
			МассивФайлов.Добавить(СтрФайла);
			
		КонецЕсли;                    
		
		ЧтениеЧасти.Закрыть();  
		ЧтениеЧасти = Неопределено; 
		ПотокВПамяти.Закрыть(); 
		ПотокВПамяти = Неопределено;
		МассивБуферДвоичныхДанных[Индекс] = Неопределено;
	КонецЦикла;
	
	МассивБуферДвоичныхДанных = Неопределено;
	
	ЧтениеДанных.Закрыть(); 
	ЧтениеДанных = Неопределено;
	
	ПотокДанных.Закрыть(); 
	ПотокДанных = Неопределено;
	
	Результат.МассивФайлов = МассивФайлов;
	
	Возврат Результат;        
	
КонецФункции

Функция ПолучитьРазделительСоставногоЗапроса(Заголовки)
	
	ТипСодержимого = Заголовки.Получить("Content-Type");   
	Свойства = СтрРазделить(ТипСодержимого, ";", Ложь);    
	Граница = Неопределено;
	
	Для Каждого Свойство Из Свойства Цикл
		
		Части = СтрРазделить(Свойство, "=", Ложь);       
		ИмяСвойства = СокрЛП(Части[0]);       
		Если ВРег(ИмяСвойства) <> ВРег("boundary") Тогда           
			Продолжить;            
		КонецЕсли;		
		Граница = СтрЗаменить(СокрЛП(Сред(Свойство,СтрНайти(Свойство,"=")+1)),"""","");       
		Прервать;        
	КонецЦикла;
	
	Возврат Граница;
	
КонецФункции

Функция ПрочитатьЗаголовкиСоставногоЗапроса(Чтение)
	
	Заголовки = Новый Соответствие();
	
	Пока Истина Цикл
		
		Строка = Чтение.ПрочитатьСтроку();
		
		Если ПустаяСтрока(Строка) Тогда
			Прервать;
		КонецЕсли;
		
		Части = СтрРазделить(Строка, ":");
		
		Если Части.Количество() = 1 И СтрНайти(Строка,"=") > 1 Тогда 
			
			ПервоеВхождение = СтрНайти(Строка,"=");
			ИмяЗаголовка = СокрЛП(Лев(Строка,ПервоеВхождение-1));
			Значение = СтрЗаменить(СокрЛП(Сред(Строка,ПервоеВхождение+1)),"""","");
			
		Иначе	
			ИмяЗаголовка = СокрЛП(Части[0]); 
			Если Части.Количество() > 1 Тогда
				Значение = СокрЛП(Части[1]);
			Иначе	
				Значение = "";
			КонецЕсли;            
		КонецЕсли;
		
		Если СтрЗаканчиваетсяНа(Значение,";") Тогда
			Значение = Лев(Значение,СтрДлина(Значение)-1); 
		КонецЕсли;
		
		Заголовки.Вставить(ИмяЗаголовка, Значение);
		
	КонецЦикла;
	
	Возврат Заголовки;
	
КонецФункции

Функция ПолучитьИмяStartЗапроса(Заголовки)
	
	ТипСодержимого = Заголовки.Получить("Content-Type");   
	Свойства = СтрРазделить(ТипСодержимого, ";", Ложь);    
	Граница = Неопределено;
	
	Для Каждого Свойство Из Свойства Цикл
		
		Части = СтрРазделить(Свойство, "=", Ложь);        
		ИмяСвойства = СокрЛП(Части[0]);      
		Если ВРег(ИмяСвойства) <> ВРег("start") Тогда            
			Продолжить;           
		КонецЕсли;
		
		Если Части.Количество() > 1 Тогда
			Граница = СтрЗаменить(СокрЛП(Части[1]),"""","");
		КонецЕсли;
		
		Прервать;
		
	КонецЦикла;
	
	Возврат Граница;
	
КонецФункции

#КонецОбласти

#Область ПодписаниеНаСервере

