
#Область ПрограммныйИнтерфейс

Функция ПолучитьОрганизациюПоИдентификаторуИС(СистемаПолучатель) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КодИСОрганизацийМСД.Организация КАК Организация
	|ИЗ
	|	РегистрСведений.КодИСОрганизацийМСД КАК КодИСОрганизацийМСД
	|ГДЕ
	|	КодИСОрганизацийМСД.КодИС = &КодИС";
	
	Запрос.УстановитьПараметр("КодИС", СистемаПолучатель);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Организация; 
	КонецЕсли;
	
КонецФункции	

Функция ПолучитьПараметрыЗапроса(Организация, Действие, ТипЗапроса = "", ОтчетныйПериод = Неопределено) Экспорт   
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Отказ", Ложь);
	СтруктураПараметров.Вставить("ТекстОшибки", "");

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КодИСОрганизацийМСД.КодИС КАК КодИС,
	|	КодИСОрганизацийМСД.Организация КАК Организация,
	|	Организации.КодПоРПБС КАК КодПоРПБС,
	|	КодИСОрганизацийМСД.ТранспортныйСертификат КАК ТранспортныйСертификат
	|ИЗ
	|	РегистрСведений.КодИСОрганизацийМСД КАК КодИСОрганизацийМСД
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|		ПО КодИСОрганизацийМСД.Организация = Организации.Ссылка
	|ГДЕ
	|	Организации.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДанныеВидовСведенийЕСМВСМЭВ.КодВидаСведений КАК КодВидаСведений,
	|	ДанныеВидовСведенийЕСМВСМЭВ.МнемоникаОтправителя КАК ИДОтправителя,
	|	ДанныеВидовСведенийЕСМВСМЭВ.МнемоникаПолучателя КАК ИДПолучателя,
	|	ДанныеВидовСведенийЕСМВСМЭВ.ВидСведений КАК ВидСведений,
	|	ДанныеВидовСведенийЕСМВСМЭВ.ТипДокумента КАК ТипДокумента
	|ИЗ
	|	РегистрСведений.ДанныеВидовСведенийЕСМВСМЭВ КАК ДанныеВидовСведенийЕСМВСМЭВ
	|ГДЕ
	|	ДанныеВидовСведенийЕСМВСМЭВ.СпособПередачи = &СпособПередачи
	|	И ДанныеВидовСведенийЕСМВСМЭВ.ВидСведений В(&ВидСведений)
	|	И ДанныеВидовСведенийЕСМВСМЭВ.ДействиеПередачи = &ДействиеПередачи
	|	И ДанныеВидовСведенийЕСМВСМЭВ.СодержаниеСообщений = &СодержаниеСообщений
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеПодключенияЕСМВСМЭВ.АдресСервера КАК АдресСервера,
	|	ДанныеПодключенияЕСМВСМЭВ.ТочкаСервиса КАК ТочкаСервиса,
	|	ДанныеПодключенияЕСМВСМЭВ.SOAPДействие КАК ИДДействия
	|ИЗ
	|	РегистрСведений.ДанныеПодключенияЕСМВСМЭВ КАК ДанныеПодключенияЕСМВСМЭВ
	|ГДЕ
	|	ДанныеПодключенияЕСМВСМЭВ.СпособПередачи = &СпособПередачи
	|	И ДанныеПодключенияЕСМВСМЭВ.ДействиеПередачи = &ДействиеПередачи";
	
	СтруктураПараметров.Вставить("ДействиеПередачи", Действие);  
	СтруктураПараметров.Вставить("СпособПередачи", Константы.ОсновнойСпособПередачиДанныхВМСД.Получить());
	СтруктураПараметров.Вставить("ТипЗапроса", ТипЗапроса);
	
	МассивВидСведений = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(ТипЗапроса) Тогда
		МассивВидСведений.Добавить(Перечисления.ВидыСведенийЕСМВСМЭВ.ПакетПередаваемыхДанных);
		МассивВидСведений.Добавить(Перечисления.ВидыСведенийЕСМВСМЭВ.СрокиПредоставления);
		МассивВидСведений.Добавить(Перечисления.ВидыСведенийЕСМВСМЭВ.Протокол);
		МассивВидСведений.Добавить(Перечисления.ВидыСведенийЕСМВСМЭВ.Таксономия);
		МассивВидСведений.Добавить(Перечисления.ВидыСведенийЕСМВСМЭВ.СтатусПакета);
	Иначе
		МассивВидСведений.Добавить(ПолучитьВидСведенийПоТипуЗапроса(ТипЗапроса));
	КонецЕсли;
	
	СтруктураПараметров.Вставить("ВидСведений", МассивВидСведений); 
	
	Запрос.УстановитьПараметр("ВидСведений", СтруктураПараметров.ВидСведений);
	Запрос.УстановитьПараметр("ДействиеПередачи", СтруктураПараметров.ДействиеПередачи);
	Запрос.УстановитьПараметр("СодержаниеСообщений", Перечисления.СодержанияСообщенийЕСМВСМЭВ.Данные);
	Запрос.УстановитьПараметр("СпособПередачи", СтруктураПараметров.СпособПередачи);
	Запрос.УстановитьПараметр("Ссылка", Организация);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаКоды = РезультатЗапроса[0].Выбрать();
	
	Если ВыборкаКоды.Следующий() Тогда
		Если ЗначениеЗаполнено(ВыборкаКоды.КодИС) Тогда
			СтруктураПараметров.Вставить("КодИС", ВыборкаКоды.КодИС);
		Иначе
			СтруктураПараметров.Вставить("Отказ", Истина);
			СтруктураПараметров.Вставить("ТекстОшибки", "Настройка программы для взаимодействия с ЕСМВ не выполнена. 
			|Не заполнено техническое наименование внешней ИС.");
			Возврат СтруктураПараметров;
		КонецЕсли;

		Если ЗначениеЗаполнено(ВыборкаКоды.КодПоРПБС) Тогда
			СтруктураПараметров.Вставить("КодПоРПБС", ВыборкаКоды.КодПоРПБС);
		Иначе
			СтруктураПараметров.Вставить("Отказ", Истина);
			СтруктураПараметров.Вставить("ТекстОшибки", "Настройка программы для взаимодействия с ЕСМВ не выполнена. 
			|Не заполнен учетный номер организации.");
			Возврат СтруктураПараметров;
		КонецЕсли;

		Если ЗначениеЗаполнено(ВыборкаКоды.ТранспортныйСертификат) Тогда
			СтруктураПараметров.Вставить("ТранспортныйСертификат", ВыборкаКоды.ТранспортныйСертификат); 
		Иначе
			СтруктураПараметров.Вставить("Отказ", Истина);
			СтруктураПараметров.Вставить("ТекстОшибки", "Настройка программы для взаимодействия с ЕСМВ не выполнена. 
			|Не заполнен транспортный сертификат ЭП для подписания отправляемых пакетов.");
			Возврат СтруктураПараметров;
		КонецЕсли;

		СтруктураПараметров.Вставить("Организация", ВыборкаКоды.Организация);
	Иначе
		СтруктураПараметров.Вставить("Отказ", Истина);
		СтруктураПараметров.Вставить("ТекстОшибки", "Настройка программы для взаимодействия с ЕСМВ не выполнена. 
		|Не заполнены техническое наименование внешней ИС и транспортный сертификат ЭП.");
		Возврат СтруктураПараметров;
	КонецЕсли;
	
	ВыборкаВидСведений = РезультатЗапроса[1].Выбрать();
	
	МассивВидыСведений = Новый Массив;
	Пока ВыборкаВидСведений.Следующий() Цикл
		СтруктураВидСведений = Новый Структура;
		СтруктураВидСведений.Вставить("КодВидаСведений", ВыборкаВидСведений.КодВидаСведений);
		СтруктураВидСведений.Вставить("ИДОтправителя", ВыборкаВидСведений.ИДОтправителя);
		СтруктураВидСведений.Вставить("ИДПолучателя", ВыборкаВидСведений.ИДПолучателя);  
		СтруктураВидСведений.Вставить("ВидСведений", ВыборкаВидСведений.ВидСведений);
		СтруктураВидСведений.Вставить("ТипДокумента", ВыборкаВидСведений.ТипДокумента); 
		МассивВидыСведений.Добавить(СтруктураВидСведений);
	КонецЦикла;  
	СтруктураПараметров.Вставить("ВидыСведений", МассивВидыСведений);
	
	ВыборкаДанныеПодключения = РезультатЗапроса[2].Выбрать();
	
	Если ВыборкаДанныеПодключения.Следующий() Тогда
		СтруктураПараметров.Вставить("АдресСервера", ВыборкаДанныеПодключения.АдресСервера); 
		СтруктураПараметров.Вставить("ТочкаСервиса", ВыборкаДанныеПодключения.ТочкаСервиса);
		СтруктураПараметров.Вставить("ИДДействия", ВыборкаДанныеПодключения.ИДДействия);
	КонецЕсли;
	
	СтруктураПараметров.Вставить("ДатаЗапроса", УниверсальноеВремя(ТекущаяДатаСеанса()));
	
	РеквизитыОбъекта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтруктураПараметров.ТранспортныйСертификат, "Программа, Отпечаток");
	СтруктураПараметров.Вставить("Программа", РеквизитыОбъекта.Программа); 
	СтруктураПараметров.Вставить("Отпечаток", РеквизитыОбъекта.Отпечаток);
	
	Если Действие = Перечисления.ДействияПередачиЕСМВСМЭВ.Отправка Тогда
		Если ТипЗапроса = "Сроки" Тогда
			ХешСрокиПредоставления = МодульСбораДанных.ПолучитьХешСрокиПредоставления(СтруктураПараметров.ДатаЗапроса, Организация);
			СтруктураПараметров.Вставить("ХешСрокиПредоставления", ХешСрокиПредоставления);
		ИначеЕсли ТипЗапроса = "Таксономия" Тогда
			ТаблицаРезультат = ПолучитьТаблицуТаксономии(Организация, ОтчетныйПериод);
			СтруктураПараметров.Вставить("ТаблицаРезультат", ТаблицаРезультат);
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтруктураПараметров;
	
КонецФункции 

Функция ПолучитьМассивфайловПакета(Организация, Пакет = Неопределено) Экспорт
	
	МодульРаботаСФайлами = ОбщегоНазначения.ОбщийМодуль("РаботаСФайлами");
	МассивФайлов = Новый Массив;
	РезультатЗапроса = МодульСбораДанных.ПолучитьФайлыПакета(Организация, Пакет, Истина);
	
	ШаблонДанныеВыборки = Новый Структура;
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		ШаблонДанныеВыборки.Вставить(Колонка.Имя);
	КонецЦикла;
	
	ВыборкаФайлы = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаФайлы.Следующий() Цикл
		ДанныеВыборки = ОбщегоНазначения.СкопироватьРекурсивно(ШаблонДанныеВыборки);
		СтруктураФайла = Новый Структура;
		ФайлВыгрузки = Документы.ПакетыДанныхДляМСД.ПрисоединенныйФайлВыгрузки(ВыборкаФайлы.Пакет, ВыборкаФайлы.ИмяПакета);
		Если НЕ ФайлВыгрузки = Неопределено Тогда
			
			ДД = МодульРаботаСФайлами.ДвоичныеДанныеФайла(ФайлВыгрузки); 
			
			Хеш = Новый ХешированиеДанных(ХешФункция.SHA1);
			Хеш.Добавить(ДД); 
			КонтрольнаяСумма = НРег(СтрЗаменить(Хеш.ХешСумма, " ", ""));
			
			Если НЕ КонтрольнаяСумма = ВыборкаФайлы.КонтрольнаяСумма Тогда 
				Продолжить;	
			КонецЕсли;	
			
			СтруктураФайла.Вставить("ИмяПакета", ВыборкаФайлы.ИмяПакета);
			СтруктураФайла.Вставить("ИдентификаторДокумента", ВыборкаФайлы.ИдентификаторПакета);
			СтруктураФайла.Вставить("ПолноеИмяФайла", ВыборкаФайлы.ПолноеИмяФайла);
			СтруктураФайла.Вставить("ДанныеФайлаBase64", ПолучитьВложениеМТОМВФорматеBase64(ДД));
			ЗаполнитьЗначенияСвойств(ДанныеВыборки, ВыборкаФайлы);
			СтруктураФайла.Вставить("ДанныеВыборки", ДанныеВыборки);
			МассивФайлов.Добавить(СтруктураФайла);
			
		КонецЕсли;	
	КонецЦикла;
	Возврат МассивФайлов; 
	
КонецФункции

Функция ПолучитьОсновнойСпособПередачиДанных() Экспорт
	Возврат Константы.ОсновнойСпособПередачиДанныхВМСД.Получить();	
КонецФункции

Функция ПолучитьТекущуюУниверсальнуюДатуВISOUTC() Экспорт
	Возврат XMLСтрока(ТекущаяУниверсальнаяДата()) + "Z";
КонецФункции                                                

Функция ВернутьСтруктураВJSON(СтруктураAdditionalAttributes) Экспорт
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, СтруктураAdditionalAttributes);
	
	Возврат ЗаписьJSON.Закрыть();	
КонецФункции 

Функция ОтправлятьФайлыНаКлиенте() Экспорт
	Возврат Константы.СторонаЗапросовОтправкиПакетовЕСМВСМЭВ.Получить() = Перечисления.СтороныВыполненияЗапросовЕСМВСМЭВ.Клиент 
	ИЛИ ОбщегоНазначения.ИнформационнаяБазаФайловая();		
КонецФункции 

Функция ОтправлятьЗапросыНаКлиенте() Экспорт
	Возврат Константы.СторонаЗапросовСроковТаксономииЕСМВСМЭВ.Получить() = Перечисления.СтороныВыполненияЗапросовЕСМВСМЭВ.Клиент 
	ИЛИ ОбщегоНазначения.ИнформационнаяБазаФайловая();		
КонецФункции 

Процедура ОтправитьЗапросНаСверку(Организация, ТипЗапроса, ДополнительныеПараметры = Неопределено) Экспорт
	
	Попытка
		Если ПолучитьОсновнойСпособПередачиДанных() = Перечисления.СпособыПередачиДанныхВМСД.ВнешнийПОИБ Тогда
			ОтправитьЗапросНаСверкуЕСМВ(Организация, ТипЗапроса, ДополнительныеПараметры);
		Иначе
			//СМЭВ
		КонецЕсли;
	Исключение 
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		МодульЖурналРегистрации = ОбщегоНазначения.ОбщийМодуль("ЖурналРегистрации");
		МодульЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(НСтр("ru = 'ОтправкаФайловЕСМВСервер'", ОбщегоНазначения.КодОсновногоЯзыка()),
		УровеньЖурналаРегистрации.Ошибка,,,ТекстОшибки);
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Запрос на сверку не отправлен. Подробности см. в журнале регистрации.'"));
	КонецПопытки;
	
КонецПроцедуры  

// Выполняет отправку пакетов из очереди в МСД ПУиО через 1С:Шину.
//
Процедура ВыполнитьОтправкуВМСД(Организация) Экспорт				
	
	МассивФайлов = ПолучитьМассивфайловПакета(Организация);
	Если ОтправлятьФайлыНаКлиенте() Тогда
		Если МассивФайлов.Количество() Тогда
			ЗафиксироватьЗаданиеКлиент(Организация, "Пакет");	
		КонецЕсли;	
	Иначе	
		ОтправитьФайлыПакета(Организация, МассивФайлов);	
	КонецЕсли;
	
КонецПроцедуры  

// Выполняет отправку присоединенных файлов указанного пакета в МСД ПУиО.
//
// Параметры:
//  Пакет	- 	ДокументСсылка.ПакетыДанныхДляМСД
//
Процедура ОтправитьФайлыПакета(Организация, МассивФайлов) Экспорт  
	
	Попытка
		Если ПолучитьОсновнойСпособПередачиДанных() = Перечисления.СпособыПередачиДанныхВМСД.ВнешнийПОИБ Тогда
			ОтправитьФайлыПакетаЕСМВ(Организация, МассивФайлов);	
		Иначе
			//СМЭВ
		КонецЕсли;
	Исключение 
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		МодульЖурналРегистрации = ОбщегоНазначения.ОбщийМодуль("ЖурналРегистрации");
		МодульЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(НСтр("ru = ОтправкаФайловЕСМВСервер'", ОбщегоНазначения.КодОсновногоЯзыка()),
		УровеньЖурналаРегистрации.Ошибка,,,ТекстОшибки);
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Пакет не отправлен. Подробности см. в журнале регистрации.'"));
	КонецПопытки;	
	
КонецПроцедуры      

Процедура ПолучитьОтветыИзОчередиЕСМВ(Организация, ТипЗапроса = "") Экспорт
	
	Попытка
		Действие = Перечисления.ДействияПередачиЕСМВСМЭВ.Получение;
		ПараметрыЗапроса = ПолучитьПараметрыЗапроса(Организация, Действие, ТипЗапроса);
		Если ПараметрыЗапроса.Отказ Тогда
			ОбщегоНазначения.СообщитьПользователю(ПараметрыЗапроса.ТекстОшибки);
			Возврат;
		КонецЕсли;
		ПараметрыЗапроса.Вставить("Пакет", Неопределено);
		
		Для каждого СтрокаВидСведений Из ПараметрыЗапроса.ВидыСведений Цикл
			
			ТекстЗапроса = "		
			|        <typ:getMessagesRequest>
			|            <typ:targetSystemId>" + СтрокаВидСведений.ИДПолучателя + "</typ:targetSystemId>
			|            <typ:count>5</typ:count>
			|        </typ:getMessagesRequest>";
			
			ПараметрыЗапроса.Вставить("КодВидаСведений", СтрокаВидСведений.КодВидаСведений); 
			ПараметрыЗапроса.Вставить("ВидСведений", СтрокаВидСведений.ВидСведений); 
			ПараметрыЗапроса.Вставить("ТипДокумента", СтрокаВидСведений.ТипДокумента);
			
			ПодписатьТело(ТекстЗапроса, ПараметрыЗапроса); 
			
		КонецЦикла;
	Исключение 
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		МодульЖурналРегистрации = ОбщегоНазначения.ОбщийМодуль("ЖурналРегистрации");
		МодульЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(НСтр("ru = ПолучениеОтветовИзОчередиЕСМВСервер", ОбщегоНазначения.КодОсновногоЯзыка()),
		УровеньЖурналаРегистрации.Ошибка,,,"Тип опроса очереди: " + ?(ЗначениеЗаполнено(ТипЗапроса), ТипЗапроса, "Все")  + ". 
		|" + ТекстОшибки);
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Ответы не получены. Подробности см. в журнале регистрации.'"));
	КонецПопытки;
	
КонецПроцедуры  

Процедура ДополнитьПараметрыПодтверждение(ПараметрыЗапроса) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДанныеПодключенияЕСМВСМЭВ.SOAPДействие КАК SOAPДействие
	|ИЗ
	|	РегистрСведений.ДанныеПодключенияЕСМВСМЭВ КАК ДанныеПодключенияЕСМВСМЭВ
	|ГДЕ
	|	ДанныеПодключенияЕСМВСМЭВ.СпособПередачи = &СпособПередачи
	|	И ДанныеПодключенияЕСМВСМЭВ.ДействиеПередачи = &ДействиеПередачи";
	
	ДействиеПередачи = Перечисления.ДействияПередачиЕСМВСМЭВ.Подтверждение;
	Запрос.УстановитьПараметр("ДействиеПередачи", ДействиеПередачи);
	Запрос.УстановитьПараметр("СпособПередачи", Перечисления.СпособыПередачиДанныхВМСД.ВнешнийПОИБ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ПараметрыЗапроса.Вставить("ДействиеПередачи", ДействиеПередачи);
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ПараметрыЗапроса.Вставить("ИДДействия", ВыборкаДетальныеЗаписи.SOAPДействие);
	КонецЕсли;
	
КонецПроцедуры	
	
Функция ПолучитьХешВложения(ДанныеФайлаВложения) Экспорт
	ХешированиеДанных = Новый ХешированиеДанных(ХешФункция.SHA256);
	ХешированиеДанных.Добавить(ДанныеФайлаВложения);
	ХешФайлаВложения = ХешированиеДанных.ХешСумма;
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(ХешФайлаВложения));	
КонецФункции

Функция ПолучитьДДСертификата(СертификатЭП) Экспорт
    Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СертификатЭП, "ДанныеСертификата").Получить();
