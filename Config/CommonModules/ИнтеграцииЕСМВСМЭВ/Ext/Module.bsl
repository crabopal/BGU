КонецФункции

Функция Подписать(ОписаниеДанных, ПаролиСертификатов = Неопределено, МенеджерКриптографии = Неопределено, СертификатКриптографии)
	
	Если ПаролиСертификатов = Неопределено Тогда
		ПаролиСертификатов = НовыеПаролиСертификатов();
	КонецЕсли;
	
	ВидОперации = НСтр("ru = 'Установка подписи на сервере'");
	ПодробноеПредставлениеОшибки = "";
	
	МодульЭлектроннаяПодпись = ОбщегоНазначения.ОбщийМодуль("ЭлектроннаяПодпись");
	
	Если МенеджерКриптографии = Неопределено Тогда
		МенеджерКриптографии = МодульЭлектроннаяПодпись.МенеджерКриптографии("Подписание", Ложь, ПодробноеПредставлениеОшибки,
		ОписаниеДанных.Программа);
	КонецЕсли;
	
	Если МенеджерКриптографии = Неопределено Тогда
		Возврат МенеджерКриптографии;
	КонецЕсли;
	
	Если СертификатКриптографии = Неопределено Тогда
		Возврат СертификатКриптографии;
	КонецЕсли;
	
	Пароль = ОписаниеДанных.Пароль;
	Если ЗначениеЗаполнено(Пароль) Тогда
		ПаролиСертификатов.Вставить(ОписаниеДанных.Сертификат, Пароль);
	Иначе
		ПарольИзКэша = ПаролиСертификатов.Получить(ОписаниеДанных.Сертификат);
		Если ЗначениеЗаполнено(ПарольИзКэша) Тогда
			Пароль = ПарольИзКэша;
		КонецЕсли;
	КонецЕсли;
	
	ОписаниеДанных.Вставить("ПаролиСертификатов", ПаролиСертификатов);	
	МенеджерКриптографии.ПарольДоступаКЗакрытомуКлючу = Пароль;	
	ДанныеНабора = ОписаниеДанных.Данные;
	
	ДвоичныеДанныеПодписи = МенеджерКриптографии.Подписать(ДанныеНабора, СертификатКриптографии);
	
	СвойстваСертификата = МодульЭлектроннаяПодпись.СвойстваСертификата(СертификатКриптографии);
	СвойстваСертификата.Вставить("ДвоичныеДанные", СертификатКриптографии.Выгрузить());
	
	МодульПользователи = ОбщегоНазначения.ОбщийМодуль("Пользователи");
	
	СвойстваПодписи = НовыеСвойстваПодписи();
	СвойстваПодписи.Подпись = ДвоичныеДанныеПодписи;
	СвойстваПодписи.УстановившийПодпись = МодульПользователи.АвторизованныйПользователь();
	СвойстваПодписи.ДатаПодписи = МодульЭлектроннаяПодпись.ДатаПодписания(ДвоичныеДанныеПодписи);;
	СвойстваПодписи.Сертификат = СвойстваСертификата.ДвоичныеДанные;
	СвойстваПодписи.Отпечаток = СвойстваСертификата.Отпечаток;
	СвойстваПодписи.КомуВыданСертификат = СвойстваСертификата.КомуВыдан;
	
	ОписаниеДанных.Вставить("СвойстваПодписи", СвойстваПодписи);
	ОписаниеДанных.Вставить("ВыбранныйСертификат", ОписаниеДанных.Сертификат);
	
	Возврат ОписаниеДанных;
	
КонецФункции  

Функция НовыеСвойстваПодписи()
	
	СвойстваПодписи = Новый Структура;
	СвойстваПодписи.Вставить("Подпись");
	СвойстваПодписи.Вставить("Сертификат");
	СвойстваПодписи.Вставить("Отпечаток", "");
	СвойстваПодписи.Вставить("КомуВыданСертификат", "");
	СвойстваПодписи.Вставить("ДатаПодписи", Дата(1, 1, 1));
	СвойстваПодписи.Вставить("ИмяФайлаПодписи", "");
	СвойстваПодписи.Вставить("ПодписьВерна", Ложь);
	СвойстваПодписи.Вставить("ДатаПроверкиПодписи", Дата(1, 1, 1));
	СвойстваПодписи.Вставить("УстановившийПодпись",
	ПредопределенноеЗначение("Справочник.СертификатыКлючейЭлектроннойПодписиИШифрования.ПустаяСсылка"));
	СвойстваПодписи.Вставить("Комментарий", "");
	СвойстваПодписи.Вставить("ТипПодписи", ПредопределенноеЗначение("Перечисление.ТипыПодписиКриптографии.ПустаяСсылка"));
	СвойстваПодписи.Вставить("ПропуститьПриПродлении", Ложь);
	СвойстваПодписи.Вставить("СрокДействияПоследнейМеткиВремени");
	СвойстваПодписи.Вставить("ПорядковыйНомер");
	СвойстваПодписи.Вставить("ПодписанныйОбъект");
	СвойстваПодписи.Вставить("ОшибкаПриАвтоматическомПродлении");
	СвойстваПодписи.Вставить("ОписаниеСертификата");
	СвойстваПодписи.Вставить("ДатаПодписиИзМетки", Дата(1, 1, 1));
	СвойстваПодписи.Вставить("ИдентификаторПодписи", Неопределено);
	
	Возврат СвойстваПодписи;
	
КонецФункции

Функция НовоеОписаниеПодписываемыхДанных()
	
	Параметры = Новый Структура;
	Параметры.Вставить("Данные", Неопределено);
	Параметры.Вставить("Сертификат", Справочники.СертификатыКлючейЭлектроннойПодписиИШифрования.ПустаяСсылка());
	Параметры.Вставить("Отпечаток", "");
	Параметры.Вставить("Программа", Справочники.ПрограммыЭлектроннойПодписиИШифрования.ПустаяСсылка());
	Параметры.Вставить("Пароль", "");
	
	Возврат Параметры;
	
КонецФункции 

Функция НовыеПаролиСертификатов()
	
	Возврат Новый Соответствие;
	
КонецФункции

Процедура ПодписатьТело(ТекстЗапроса, ПараметрыЗапроса)
	
	МодульЖурналРегистрации = ОбщегоНазначения.ОбщийМодуль("ЖурналРегистрации");
	МодульЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(НСтр("ru = 'ПодписаниеЗапросаЕСМВСервер'", ОбщегоНазначения.КодОсновногоЯзыка()),
	УровеньЖурналаРегистрации.Информация,,,НСтр("ru='Подписание тела запроса - начало'", ОбщегоНазначения.КодОсновногоЯзыка()));

	ОписаниеДанных = Новый Структура;
	ОписаниеДанных.Вставить("ПоказатьКомментарий", Истина);
	ОписаниеДанных.Вставить("Операция",            НСтр("ru = 'Подписание данных'"));
	ОписаниеДанных.Вставить("ЗаголовокДанных",     НСтр("ru = 'Данные'"));
	
	МодульЭлектроннаяПодпись = ОбщегоНазначения.ОбщийМодуль("ЭлектроннаяПодпись");
	
	ПараметрыКонверта = МодульЭлектроннаяПодпись.ПараметрыКонвертаXML();
	ПараметрыКонверта.Вариант = "www.roskazna.ru";
	ПараметрыКонверта.СообщениеXML = ТекстЗапроса;
	
	КонвертXML = КонвертXML(ПараметрыКонверта);
	ПараметрыXMLDSig = МодульЭлектроннаяПодпись.ПараметрыXMLDSig();
	
	МодульЭлектроннаяПодписьСлужебный = ОбщегоНазначения.ОбщийМодуль("ЭлектроннаяПодписьСлужебный");
	ПараметрыСоздания = МодульЭлектроннаяПодписьСлужебный.ПараметрыСозданияМенеджераКриптографии();
	ПараметрыСоздания.Программа = ПараметрыЗапроса.Программа;
	ПараметрыСоздания.ОписаниеОшибки = Новый Структура;
	ПараметрыСоздания.ПоказатьОшибку = Истина;
	
	МенеджерКриптографии = МодульЭлектроннаяПодписьСлужебный.МенеджерКриптографии("Подписание", ПараметрыСоздания);
	Если МенеджерКриптографии = Неопределено Тогда
		ТекстОшибки = НСтр("ru='Не удалось получить менеджер криптографии. Проверьте настройки приложения электронной подписи и шифрования на сервере и повторите попытку.'", ОбщегоНазначения.КодОсновногоЯзыка());	
		ВызватьИсключение ТекстОшибки; 
	КонецЕсли;	
	ПараметрыЗапроса.Вставить("МенеджерКриптографии", МенеджерКриптографии);
	
	СертификатКриптографии = МодульЭлектроннаяПодписьСлужебный.ПолучитьСертификатПоОтпечатку(
	ПараметрыЗапроса.Отпечаток, Истина, Ложь, ПараметрыЗапроса.Программа); 
	
	Если СертификатКриптографии = Неопределено Тогда
		ТекстОшибки = НСтр("ru='Не удалось получить сертификат криптографии. Проверьте установку сертификата криптографии в личном хранилище сертификатов на сервере и повторите попытку.'", ОбщегоНазначения.КодОсновногоЯзыка());	
		ВызватьИсключение ТекстОшибки; 
	КонецЕсли;
	
	ПараметрыЗапроса.Вставить("СертификатКриптографии", СертификатКриптографии);		
	
	КонвертXML = МодульЭлектроннаяПодписьСлужебный.Подписать(КонвертXML, ПараметрыXMLDSig, СертификатКриптографии, МенеджерКриптографии);  
	
	ТекстЗапроса = КонвертXML;
	
	Если НЕ ПараметрыЗапроса.Пакет = Неопределено Тогда
		ЕСМВДобавитьТелоЗапросВложениеМТОМ(ТекстЗапроса, ПараметрыЗапроса);
	КонецЕсли;
	
	МодульЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(НСтр("ru = 'ПодписаниеЗапросаЕСМВСервер'", ОбщегоНазначения.КодОсновногоЯзыка()),
	УровеньЖурналаРегистрации.Информация,,,НСтр("ru='Подписание тела запроса - конец'", ОбщегоНазначения.КодОсновногоЯзыка()));

	ПолучитьЗаголовки(ТекстЗапроса, ПараметрыЗапроса);
	
КонецПроцедуры

Процедура ПолучитьЗаголовки(ТекстЗапроса, ПараметрыЗапроса) 
	
	ЗаголовкиЗапроса = Новый Соответствие;
	
	ЗаголовкиЗапроса.Вставить("POIB-Request-SenderSystem-ID", ПараметрыЗапроса.КодИС);
	ЗаголовкиЗапроса.Вставить("POIB-Request-TargetSystem-ID", "MSD");
	ЗаголовкиЗапроса.Вставить("POIB-Request-ResourceType-ID", "MSD_Exchange");
	ЗаголовкиЗапроса.Вставить("POIB-Request-Resource-ID", ПараметрыЗапроса.КодВидаСведений);
	ЗаголовкиЗапроса.Вставить("POIB-Request-Action-ID", ПараметрыЗапроса.ИДДействия);
	
	СтруктураAdditionalAttributes = Новый Структура("CURRENT_IS_UUID", ПараметрыЗапроса.КодИС);
	Значение = Base64Строка(ПолучитьДвоичныеДанныеИзСтроки(ВернутьСтруктураВJSON(СтруктураAdditionalAttributes)));
	Значение = СтрЗаменить(СтрЗаменить(СтрЗаменить(Значение, Символы.ВК, ""), Символы.ПС, ""), Символы.ПФ, "");
	
	ЗаголовкиЗапроса.Вставить("POIB-Request-AdditionalAttributes", Значение);
	ЗаголовкиЗапроса.Вставить("POIB-Request-TimeStamp", ПолучитьТекущуюУниверсальнуюДатуВISOUTC());
	
	СоответствиеДопЗаголовков = Новый Соответствие;
	СоответствиеДопЗаголовков.Вставить("Accept-Encoding", "gzip,deflate");
	СоответствиеДопЗаголовков.Вставить("Content-Type", ?(ПараметрыЗапроса.Пакет = Неопределено, "text/xml", "multipart/related; type=""application/xop+xml""; start=""<rootpart@soapui.org>""; start-info=""text/xml""; boundary=""uuid:" + ПараметрыЗапроса.ИдентификаторДокумента + """"));
	СоответствиеДопЗаголовков.Вставить("SOAPAction", ?(ПараметрыЗапроса.ИДДействия = "sendMessage", "transferDocument", ПараметрыЗапроса.ИДДействия));
	СоответствиеДопЗаголовков.Вставить("User-Agent", "1C:Enterprise");
	
	СтрокаДопЗаголовков = "";
	Для Каждого ДопЗаголовок Из СоответствиеДопЗаголовков Цикл
		Если ЗначениеЗаполнено(СтрокаДопЗаголовков) Тогда
			СтрокаДопЗаголовков = СтрокаДопЗаголовков + ",";
		КонецЕсли;		
		СтрокаДопЗаголовков = СтрокаДопЗаголовков + ДопЗаголовок.Ключ;		
	КонецЦикла;
	
	ЗаголовкиЗапроса.Вставить("POIB-HeadersToTarget", СтрокаДопЗаголовков);
	
	МассивДопЗаголовков = СтрРазделить(СтрокаДопЗаголовков, ",", Ложь);
	Для Каждого ДопЗаголовок Из МассивДопЗаголовков Цикл 
		ЗаголовкиЗапроса.Вставить(ДопЗаголовок, СоответствиеДопЗаголовков.Получить(ДопЗаголовок));
	КонецЦикла;
	
	Результат = ПолучитьКонтрольнуюСуммуЗаголовковОтправкаДанных(ЗаголовкиЗапроса, ТекстЗапроса, ПараметрыЗапроса.ТочкаСервиса);
	Если Результат.Отказ Тогда
		ВызватьИсключение(НСтр("ru='Не удалось получить контрольную сумму заголовков.'", ОбщегоНазначения.КодОсновногоЯзыка()));
	КонецЕсли;
	
	ЗаголовкиЗапроса.Вставить("POIB-Request-Checksum", Результат.Значение);
	
	ПодписатьЗаголовки(ТекстЗапроса, ЗаголовкиЗапроса, ПараметрыЗапроса);
	
КонецПроцедуры

Процедура ПодписатьЗаголовки(ТекстЗапроса, ЗаголовкиЗапроса, ПараметрыЗапроса)
		
	Результат = ПолучитьКонтрольнуюСуммуЗаголовковОтправкаДанных(ЗаголовкиЗапроса, ТекстЗапроса, ПараметрыЗапроса.ТочкаСервиса, Истина);
	Если Результат.Отказ Тогда
		ВызватьИсключение (НСтр("ru='Не удалось получить контрольную сумму заголовков с учетом подписания.'", ОбщегоНазначения.КодОсновногоЯзыка()));
	КонецЕсли;
	
	МодульЖурналРегистрации = ОбщегоНазначения.ОбщийМодуль("ЖурналРегистрации");
	МодульЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(НСтр("ru = 'ПодписаниеЗапросаЕСМВСервер'", ОбщегоНазначения.КодОсновногоЯзыка()),
	УровеньЖурналаРегистрации.Информация,,,НСтр("ru='Подписание заголовков запроса - начало'", ОбщегоНазначения.КодОсновногоЯзыка()));

	HexПредставлениеКонтрольнойСуммыЗаголовков = Результат.Значение;
	
	ОписаниеДанных = НовоеОписаниеПодписываемыхДанных();
	ОписаниеДанных.Данные = ПолучитьДвоичныеДанныеИзСтроки(HexПредставлениеКонтрольнойСуммыЗаголовков); 
	ОписаниеДанных.Сертификат = ПараметрыЗапроса.ТранспортныйСертификат; 
	ОписаниеДанных.Отпечаток = ПараметрыЗапроса.Отпечаток;
	ОписаниеДанных.Программа = ПараметрыЗапроса.Программа;
	
	ОписаниеДанных = Подписать(ОписаниеДанных,,ПараметрыЗапроса.МенеджерКриптографии, ПараметрыЗапроса.СертификатКриптографии);
	ПараметрыЗапроса.Вставить("МенеджерКриптографии", Неопределено); 
	ПараметрыЗапроса.Вставить("СертификатКриптографии", Неопределено);

	
	ДополнительныеПараметры = Новый Структура;
	ЗаголовкиЗапроса.Вставить("POIB-Request-Signature", ПреобразоватьПодписьПередаваемыхДанныхВBase64(ОписаниеДанных.СвойстваПодписи.Подпись));
	
	ДополнительныеПараметры.Вставить("ЗаголовкиЗапроса", ЗаголовкиЗапроса);
	ДополнительныеПараметры.Вставить("ПараметрыЗапроса", ПараметрыЗапроса); 
	ДополнительныеПараметры.Вставить("ТекстЗапроса", ТекстЗапроса);   
	
	МодульЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации(НСтр("ru = 'ПодписаниеЗапросаЕСМВСервер'", ОбщегоНазначения.КодОсновногоЯзыка()),
	УровеньЖурналаРегистрации.Информация,,,НСтр("ru='Подписание заголовков запроса - конец'", ОбщегоНазначения.КодОсновногоЯзыка()));
	
	ОтправкаЗапроса(ДополнительныеПараметры);	
	
КонецПроцедуры  

#КонецОбласти

#Область АвтоматическийОбменНаКлиенте

Процедура ЗафиксироватьЗаданиеКлиент(Организация, ТипЗапроса) Экспорт
	
	СтруктураЗадания = Новый Структура;
	СтруктураЗадания.Вставить("Период", УниверсальноеВремя(ТекущаяДатаСеанса()));
	СтруктураЗадания.Вставить("Организация", Организация); 
	СтруктураЗадания.Вставить("ИдентификаторЗадания", Новый УникальныйИдентификатор);	
	СтруктураЗадания.Вставить("ВидСведений", ПолучитьВидСведенийПоТипуЗапроса(ТипЗапроса));
	СтруктураЗадания.Вставить("Статус", Перечисления.СтатусыЗаданийМСД.Создано);
	
	РегистрыСведений.ЗаданияОбменаКлиентМСД.ОтразитьДанныеЗадания(СтруктураЗадания);
	
КонецПроцедуры 

Процедура ОтразитьДанныеЗадания(СтруктураЗадания) Экспорт
	РегистрыСведений.ЗаданияОбменаКлиентМСД.ОтразитьДанныеЗадания(СтруктураЗадания);		
КонецПроцедуры

Функция ПолучитьВидСведенийПоТипуЗапроса(ТипЗапроса) Экспорт
	
	Если ТипЗапроса = "Сроки" Тогда
		Возврат Перечисления.ВидыСведенийЕСМВСМЭВ.СрокиПредоставления;	
	ИначеЕсли ТипЗапроса = "Таксономия" Тогда
		Возврат Перечисления.ВидыСведенийЕСМВСМЭВ.Таксономия;
	ИначеЕсли ТипЗапроса = "Пакет" Тогда
		Возврат Перечисления.ВидыСведенийЕСМВСМЭВ.ПакетПередаваемыхДанных;
	ИначеЕсли ТипЗапроса = "Протокол" Тогда
		Возврат Перечисления.ВидыСведенийЕСМВСМЭВ.Протокол; 
	Иначе
		Возврат Перечисления.ВидыСведенийЕСМВСМЭВ.СтатусПакета;		
	КонецЕсли;

КонецФункции

Функция ПолучитьЗаданияОбмена(Организация) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЗаданияОбменаКлиентМСДСрезПоследних.ИдентификаторЗадания КАК ИдентификаторЗадания,
		|	ЗаданияОбменаКлиентМСДСрезПоследних.ВидСведений КАК ВидСведений,
		|	ЗаданияОбменаКлиентМСДСрезПоследних.Период КАК Период
		|ИЗ
		|	РегистрСведений.ЗаданияОбменаКлиентМСД.СрезПоследних(, Организация = &Организация) КАК ЗаданияОбменаКлиентМСДСрезПоследних
		|ГДЕ
		|	ЗаданияОбменаКлиентМСДСрезПоследних.Статус = &СтатусСоздано
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВидСведений,
		|	Период УБЫВ";
	
	Запрос.УстановитьПараметр("СтатусСоздано", Перечисления.СтатусыЗаданийМСД.Создано);
	Запрос.УстановитьПараметр("Организация", Организация);
		
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Возврат ОбщегоНазначения.ТаблицаЗначенийВМассив(РезультатЗапроса);
	
КонецФункции 

#КонецОбласти
