Функция ПреобразоватьПодписьПередаваемыхДанныхВBase64(Подпись) Экспорт
	Возврат СтрЗаменить(СтрЗаменить(СтрЗаменить(Base64Строка(Подпись), Символы.ВК, ""), Символы.ПС, ""), Символы.ПФ, "");
КонецФункции 

Функция ПолучитьКонтрольнуюСуммуЗаголовковОтправкаДанных(ЗаголовкиЗапросаСоответствие, ТекстЗапроса, ИмяСервиса, Подписание = Ложь) Экспорт
	
	СтруктураРезультат = Новый Структура("Отказ,Значение", Ложь, "");
	
	ЗаголовкиЗапроса = Новый ТаблицаЗначений;
	ЗаголовкиЗапроса.Колонки.Добавить("Имя");
	ЗаголовкиЗапроса.Колонки.Добавить("Значение");
	
	ДобавитьСтрокуВТаблицуЗаголовков(ЗаголовкиЗапроса, "POIB-Request-SenderSystem-ID", 		ЗаголовкиЗапросаСоответствие.Получить("POIB-Request-SenderSystem-ID"));
	ДобавитьСтрокуВТаблицуЗаголовков(ЗаголовкиЗапроса, "POIB-Request-TargetSystem-ID", 		ЗаголовкиЗапросаСоответствие.Получить("POIB-Request-TargetSystem-ID"));
	ДобавитьСтрокуВТаблицуЗаголовков(ЗаголовкиЗапроса, "POIB-Request-ResourceType-ID", 		ЗаголовкиЗапросаСоответствие.Получить("POIB-Request-ResourceType-ID"));
	ДобавитьСтрокуВТаблицуЗаголовков(ЗаголовкиЗапроса, "POIB-Request-Resource-ID", 			ЗаголовкиЗапросаСоответствие.Получить("POIB-Request-Resource-ID"));
	ДобавитьСтрокуВТаблицуЗаголовков(ЗаголовкиЗапроса, "POIB-Request-Action-ID", 			ЗаголовкиЗапросаСоответствие.Получить("POIB-Request-Action-ID"));	
	ДобавитьСтрокуВТаблицуЗаголовков(ЗаголовкиЗапроса, "POIB-Request-AdditionalAttributes", ЗаголовкиЗапросаСоответствие.Получить("POIB-Request-AdditionalAttributes"));
	ДобавитьСтрокуВТаблицуЗаголовков(ЗаголовкиЗапроса, "POIB-Request-TimeStamp", 			ЗаголовкиЗапросаСоответствие.Получить("POIB-Request-TimeStamp"));	
	ДобавитьСтрокуВТаблицуЗаголовков(ЗаголовкиЗапроса, "POIB-HeadersToTarget", 				ЗаголовкиЗапросаСоответствие.Получить("POIB-HeadersToTarget")); 
	Если Подписание Тогда
		ДобавитьСтрокуВТаблицуЗаголовков(ЗаголовкиЗапроса, "POIB-Request-Checksum", 		ЗаголовкиЗапросаСоответствие.Получить("POIB-Request-Checksum"));	
	КонецЕсли;	
	
	МассивДопЗаголовков = СтрРазделить(ЗаголовкиЗапросаСоответствие.Получить("POIB-HeadersToTarget"), ",", Ложь);
	Для Каждого ДопЗаголовок Из МассивДопЗаголовков Цикл 
		ДобавитьСтрокуВТаблицуЗаголовков(ЗаголовкиЗапроса, ДопЗаголовок, ЗаголовкиЗапросаСоответствие.Получить(ДопЗаголовок));
	КонецЦикла; 
	
	ОбъединеннаяСтрокаЗаголовков = "";
	Для Каждого ТекЗаголовок Из ЗаголовкиЗапроса Цикл		
		ОбъединеннаяСтрокаЗаголовков = ОбъединеннаяСтрокаЗаголовков + СокрЛП(ТекЗаголовок.Значение);		
	КонецЦикла;
	
	СтрокаДляРасчетаКонтрольнойСуммы = ИмяСервиса + ОбъединеннаяСтрокаЗаголовков + СокрЛП(ТекстЗапроса);
	HexПредставлениеКонтрольнойСуммыЗаголовков = ВернутьКонтрольнуюСуммуЗаголовков(СтрокаДляРасчетаКонтрольнойСуммы);
	СтруктураРезультат.Значение = HexПредставлениеКонтрольнойСуммыЗаголовков;
	
	Возврат СтруктураРезультат;
	
КонецФункции

#КонецОбласти

#Область ЗаписьДанных

Процедура ЗаписатьСтатусКвитанции(ИдентификаторСообщения, Статус, ПараметрыЗапроса) Экспорт
	
	ИмяСобытия = "ОбменЕСМВ";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИдентификаторСообщения", ИдентификаторСообщения);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ПакетыДанныхМСДСрезПоследних.Пакет КАК Пакет,
	               |	ПакетыДанныхМСДСрезПоследних.Организация КАК Организация,
	               |	ПакетыДанныхМСДСрезПоследних.ИдентификаторПакета КАК ИдентификаторПакета,
	               |	ПакетыДанныхМСДСрезПоследних.ДатаФормирования КАК ДатаФормирования,
	               |	ПакетыДанныхМСДСрезПоследних.ИмяПакета КАК ИмяПакета,
	               |	ПакетыДанныхМСДСрезПоследних.ВидПередаваемыхДанных КАК ВидПередаваемыхДанных,
	               |	ПакетыДанныхМСДСрезПоследних.ПериодСтрокой КАК ПериодСтрокой,
	               |	ПакетыДанныхМСДСрезПоследних.КонтрольнаяСумма КАК КонтрольнаяСумма,
	               |	ПакетыДанныхМСДСрезПоследних.СпособПередачи КАК СпособПередачи,
	               |	ПакетыДанныхМСДСрезПоследних.Статус КАК Статус,
	               |	ПакетыДанныхМСДСрезПоследних.ДатаСтатуса КАК ДатаСтатуса,
	               |	ПакетыДанныхМСДСрезПоследних.ПолноеИмяФайла КАК ПолноеИмяФайла,
	               |	ПакетыДанныхМСДСрезПоследних.ОписаниеОшибки КАК ОписаниеОшибки,
	               |	ПакетыДанныхДляМСД.НачалоПериода КАК НачалоПериода,
	               |	ПакетыДанныхДляМСД.ОкончаниеПериода КАК ОкончаниеПериода,
	               |	ПакетыДанныхМСДСрезПоследних.ИдентификаторСообщения КАК ИдентификаторСообщения,
	               |	ИСТИНА КАК ЭтоПакет
	               |ИЗ
	               |	РегистрСведений.ПакетыДанныхМСД.СрезПоследних(, ) КАК ПакетыДанныхМСДСрезПоследних
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПакетыДанныхДляМСД КАК ПакетыДанныхДляМСД
	               |		ПО ПакетыДанныхМСДСрезПоследних.Пакет = ПакетыДанныхДляМСД.Ссылка
	               |ГДЕ
	               |	ПакетыДанныхМСДСрезПоследних.ИдентификаторСообщения = &ИдентификаторСообщения
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	NULL,
	               |	NULL,
	               |	NULL,
	               |	NULL,
	               |	NULL,
	               |	NULL,
	               |	NULL,
	               |	NULL,
	               |	NULL,
	               |	NULL,
	               |	NULL,
	               |	NULL,
	               |	NULL,
	               |	NULL,
	               |	NULL,
	               |	ЗапросыДанныхМСД.ИдентификаторСообщения,
	               |	ЛОЖЬ
	               |ИЗ
	               |	РегистрСведений.ЗапросыДанныхМСД КАК ЗапросыДанныхМСД
	               |ГДЕ
	               |	ЗапросыДанныхМСД.ИдентификаторСообщения = &ИдентификаторСообщения";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,, 
		НСтр("ru='При обработке сообщения произошла ошибка: Не найдено отправленное сообщение с ИД'") + Символы.НПП + ИдентификаторСообщения);
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	Если НЕ Выборка.ЭтоПакет Тогда
		Возврат;	
	КонецЕсли;
	
	Запись = РегистрыСведений.ПакетыДанныхМСД.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(Запись, Выборка);
	Если ПараметрыЗапроса.Свойство("ДатаОтвета") Тогда
		Запись.Период = ПараметрыЗапроса.ДатаОтвета;
	Иначе
		Запись.Период = УниверсальноеВремя(ТекущаяДатаСеанса());
	КонецЕсли;
	
	
	Если Статус = "0" Тогда
		Если ПараметрыЗапроса.СодержаниеСообщения = Перечисления.СодержанияСообщенийЕСМВСМЭВ.ТранспортнаяКвитанция Тогда
			Запись.Статус = Перечисления.СтатусыПакетовМСД.ВПути;
		Иначе
			Запись.Статус = Перечисления.СтатусыПакетовМСД.ВОчереди;
		КонецЕсли;
	Иначе
		Запись.Статус = МодульСбораДанных.ПолучитьСтатусПоКоду(Статус); 
		Если ПараметрыЗапроса.Свойство("ОписаниеОшибки") И ЗначениеЗаполнено(ПараметрыЗапроса.ОписаниеОшибки) Тогда
			Если ПараметрыЗапроса.СодержаниеСообщения = Перечисления.СодержанияСообщенийЕСМВСМЭВ.ТранспортнаяКвитанция Тогда
				Запись.Статус = Перечисления.СтатусыПакетовМСД.ОшибкаДоставки;	
			КонецЕсли;	
			Запись.ОписаниеОшибки = ПараметрыЗапроса.ОписаниеОшибки;	
		КонецЕсли;	
	КонецЕсли;
	
	Запись.ДатаСтатуса = УниверсальноеВремя(ТекущаяДатаСеанса());
	Запись.Записать(Истина);  
	
	ПараметрыЗакрытиеПериода = МодульСбораДанных.ПолучитьПараметрыЗакрытияПериода();
	ЗаполнитьЗначенияСвойств(ПараметрыЗакрытиеПериода, Выборка);
	ПараметрыЗакрытиеПериода.Статус = Запись.Статус;
	
	МодульСбораДанных.ЗакрытиеПериодаСинхронизацияСМСД(ПараметрыЗакрытиеПериода);
	
КонецПроцедуры	

Процедура ЗаписатьСтатусПакетаДанных(ПараметрыЗапроса, ОписаниеОшибки = "") Экспорт
	
	Запись = РегистрыСведений.ПакетыДанныхМСД.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(Запись, ПараметрыЗапроса.ДанныеВыборки); 
	Если ПараметрыЗапроса.Свойство("ДатаОтвета") Тогда
		Запись.Период = ПараметрыЗапроса.ДатаОтвета;
	Иначе
		Запись.Период = УниверсальноеВремя(ТекущаяДатаСеанса());
	КонецЕсли;
	Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда 
		Запись.Статус 					= Перечисления.СтатусыПакетовМСД.ОшибкаДоставки;
	Иначе
		Запись.Статус 					= Перечисления.СтатусыПакетовМСД.Отправлен;
	КонецЕсли;
	Запись.ДатаСтатуса 				= УниверсальноеВремя(ТекущаяДатаСеанса());
	Запись.ИдентификаторСообщения 	= ПараметрыЗапроса.ИдентификаторСообщения;
	Запись.ОписаниеОшибки 			= ОписаниеОшибки;
	Запись.Записать(Истина);
	
КонецПроцедуры

Процедура ЗаписатьВИсториюОбмена(ТекстЗапроса, ТекстОтвета, ПараметрыЗапроса) Экспорт
	
	Запись = РегистрыСведений.ИсторияОбменаЕСМВСМЭВ.СоздатьМенеджерЗаписи();
	Если ПараметрыЗапроса.Свойство("ДатаОтвета") Тогда
		Запись.Период = ПараметрыЗапроса.ДатаОтвета;
	Иначе 
		Если ПараметрыЗапроса.Свойство("Период") И ЗначениеЗаполнено(ПараметрыЗапроса.Период) Тогда 
			Запись.Период = ПараметрыЗапроса.Период;
		Иначе
			Запись.Период = УниверсальноеВремя(ТекущаяДатаСеанса()); 
		КонецЕсли; 
	КонецЕсли;
	Запись.Организация = ПараметрыЗапроса.Организация;
	Запись.ВидСведений = ПараметрыЗапроса.ВидСведений;
	Запись.ИдентификаторСообщения = ПараметрыЗапроса.ИдентификаторСообщения;
	Запись.ДействиеПередачи = ПараметрыЗапроса.ДействиеПередачи;
	Запись.СпособПередачи = ПараметрыЗапроса.СпособПередачи;
	Запись.СодержаниеСообщения = ПараметрыЗапроса.СодержаниеСообщения;
	Запись.ТипДокумента = ПараметрыЗапроса.ТипДокумента;
	Если Константы.СохранятьЗапросыОтветыЕСМВСМЭВ.Получить() Тогда
		Запись.СообщениеЗапрос = Новый ХранилищеЗначения(ТекстЗапроса);
		Запись.СообщениеОтвет = Новый ХранилищеЗначения(ТекстОтвета);
	КонецЕсли; 
	Запись.ИдентификаторИсходногоЗапроса = ПараметрыЗапроса.ИДИнициализирующегоСообщения;
	Запись.ИдентификаторДокумента = ПараметрыЗапроса.ИдентификаторДокумента;
	Если ПараметрыЗапроса.Свойство("Пакет") Тогда 
		Пакет = ПараметрыЗапроса.Пакет;
		Если НЕ ЗначениеЗаполнено(Пакет) Тогда
			Пакет = ПолучитьПакетПоИдентификаторуСообщения(ПараметрыЗапроса);	
		КонецЕсли;	
		Запись.ДополнительныеДанные = Пакет;
	КонецЕсли;
	Запись.Записать();
	
КонецПроцедуры 

Процедура ОтразитьДанныеЗапроса(ДополнительныеПараметры, Статус = "") Экспорт
	
	Если ДополнительныеПараметры.ВидСведений = Перечисления.ВидыСведенийЕСМВСМЭВ.СрокиПредоставления Тогда
		ДополнительныеПараметры.Вставить("ТипСообщения", Перечисления.ТипыСообщенийМСД.СрокиПредоставления);	
	ИначеЕсли ДополнительныеПараметры.ВидСведений = Перечисления.ВидыСведенийЕСМВСМЭВ.Таксономия Тогда 
		ДополнительныеПараметры.Вставить("ТипСообщения", Перечисления.ТипыСообщенийМСД.Таксономия);
	ИначеЕсли ДополнительныеПараметры.ВидСведений = Перечисления.ВидыСведенийЕСМВСМЭВ.СтатусПакета 
		ИЛИ ДополнительныеПараметры.ВидСведений = Перечисления.ВидыСведенийЕСМВСМЭВ.Протокол Тогда
		ДополнительныеПараметры.Вставить("ТипСообщения", Перечисления.ТипыСообщенийМСД.ПротоколЗагрузки);
		ДополнительныеПараметры.Вставить("ДополнительныеДанные", Строка(ДополнительныеПараметры.ИдентификаторДокумента));
	КонецЕсли;
	
	Если ДополнительныеПараметры.ДействиеПередачи = Перечисления.ДействияПередачиЕСМВСМЭВ.Отправка Тогда
		Если НЕ ДополнительныеПараметры.Свойство("ДатаЗапроса") Тогда
			ДополнительныеПараметры.Вставить("ДатаЗапроса", УниверсальноеВремя(ТекущаяДатаСеанса()));
		КонецЕсли;
		ДополнительныеПараметры.Вставить("Период", ДополнительныеПараметры.ДатаЗапроса); 
		Если ДополнительныеПараметры.ВидСведений = Перечисления.ВидыСведенийЕСМВСМЭВ.СрокиПредоставления Тогда
			Если ДополнительныеПараметры.Свойство("ГодЗапроса") Тогда
				ДополнительныеПараметры.Вставить("ДополнительныеДанные", ДополнительныеПараметры.ГодЗапроса);
			Иначе
				ДополнительныеПараметры.Вставить("ДополнительныеДанные", Год(ДополнительныеПараметры.ДатаЗапроса));
			КонецЕсли;
		КонецЕсли;
	Иначе
		Если НЕ ДополнительныеПараметры.Свойство("ДатаОтвета") Тогда
			ДополнительныеПараметры.Вставить("ДатаОтвета", УниверсальноеВремя(ТекущаяДатаСеанса()));	
		КонецЕсли;
		ДополнительныеПараметры.Удалить("ДатаЗапроса");
		Если НЕ ДополнительныеПараметры.ВидСведений = Перечисления.ВидыСведенийЕСМВСМЭВ.Протокол Тогда
			ДополнительныеПараметры.Удалить("Период"); 
		КонецЕсли;
	КонецЕсли;
	
	Если ДополнительныеПараметры.ДействиеПередачи = Перечисления.ДействияПередачиЕСМВСМЭВ.Отправка Тогда 
		ДополнительныеПараметры.Вставить("Статус", Перечисления.СтатусыПакетовМСД.Отправлен);
	Иначе
		Если Статус = "0" Тогда
			Если ДополнительныеПараметры.СодержаниеСообщения = Перечисления.СодержанияСообщенийЕСМВСМЭВ.ТранспортнаяКвитанция Тогда
				ДополнительныеПараметры.Вставить("Статус", Перечисления.СтатусыПакетовМСД.ВПути);
			Иначе
				ДополнительныеПараметры.Вставить("Статус", Перечисления.СтатусыПакетовМСД.ВОчереди);
			КонецЕсли;
		ИначеЕсли Статус = "1" Тогда
			ДополнительныеПараметры.Вставить("Статус", Перечисления.СтатусыПакетовМСД.Обработан);
		ИначеЕсли Статус = "5" Тогда
			ДополнительныеПараметры.Вставить("Статус", Перечисления.СтатусыПакетовМСД.ОшибкаОбработки);
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ДополнительныеПараметры.Свойство("ИдентификаторПакета") И ДополнительныеПараметры.Свойство("ИдентификаторДокумента") Тогда
		ДополнительныеПараметры.Вставить("ИдентификаторПакета", ДополнительныеПараметры.ИдентификаторДокумента);		
	КонецЕсли;	
	
	РегистрыСведений.ЗапросыДанныхМСД.ОтразитьДанныеЗапроса(ДополнительныеПараметры);
	
КонецПроцедуры	

Процедура ЗаписатьСтатусПротокола(Выборка, Статус) Экспорт
	
	ТекущаяДата = УниверсальноеВремя(ТекущаяДатаСеанса());
	Запись = РегистрыСведений.ПакетыДанныхМСД.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(Запись, Выборка);
	Запись.Период = ТекущаяДата;
	Запись.Статус = Статус;	
	Запись.ДатаСтатуса = ТекущаяДата;
	Запись.Записать(Истина);
	
КонецПроцедуры

Процедура ОтразитьСтатусСверки(ПараметрыЗапроса) Экспорт
	Если ПараметрыЗапроса.ВидСведений = Перечисления.ВидыСведенийЕСМВСМЭВ.СрокиПредоставления Тогда
		ПараметрыЗапроса.Вставить("ТипСообщения", Перечисления.ТипыСообщенийМСД.СрокиПредоставления);
	Иначе
		ПараметрыЗапроса.Вставить("ТипСообщения", Перечисления.ТипыСообщенийМСД.Таксономия);
	КонецЕсли;
	Если ПараметрыЗапроса.Свойство("ДатаОтвета") Тогда
		ПараметрыЗапроса.Вставить("Период", ПараметрыЗапроса.ДатаОтвета);
	Иначе 
		Если НЕ (ПараметрыЗапроса.Свойство("Период") И ЗначениеЗаполнено(ПараметрыЗапроса.Период)) Тогда 
			ПараметрыЗапроса.Вставить("Период", УниверсальноеВремя(ТекущаяДатаСеанса())); 
		КонецЕсли; 
	КонецЕсли;
	Если ПараметрыЗапроса.ВидСведений = Перечисления.ВидыСведенийЕСМВСМЭВ.СрокиПредоставления Тогда
		ПараметрыЗапроса.Вставить("ДополнительныеДанные", Год(ПараметрыЗапроса.Период));  
	КонецЕсли;
	ПараметрыЗапроса.Вставить("Статус", Перечисления.СтатусыСверкиМСД.Совпадает);
	РегистрыСведений.ЗапросыНаСверкуДанныхМСД.ОтразитьСтатусСверки(ПараметрыЗапроса);	
КонецПроцедуры	

#КонецОбласти

Процедура ЗагрузитьТаксономию(СтруктураПараметров, Организация = Неопределено) Экспорт			
	МодульСбораДанных.ЗагрузитьТаксономиюСервисИнтеграции(СтруктураПараметров, Организация);
КонецПроцедуры

Процедура ОбработатьОтветСверкиТаксономии(СтруктураПараметров, Организация = Неопределено) Экспорт
	Если СтруктураПараметров.Свойство("ТаблицаРезультатXDTO") Тогда
		
		ЧтениеXML = Новый ЧтениеXML();
		ЧтениеXML.УстановитьСтроку(СтруктураПараметров.ТаблицаРезультатXDTO);
		ПространствоИменСверкаТаксономии = "MSD_DATA_FHD/TransferRules/TableResult";
		ТаблицаРезультатXDTO = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML, ФабрикаXDTO.Тип(ПространствоИменСверкаТаксономии, "Body"));
		ЧтениеXML.Закрыть();
		
		ТаблицаРезультат = ПреобразоватьXDTOВТаблицуЗначений(ТаблицаРезультатXDTO);	
		
		Для каждого СтрокаТаблицы Из ТаблицаРезультат Цикл  
		
			Если НЕ СтрокаТаблицы.Совпадает Тогда
													
				Если ЗначениеЗаполнено(СтрокаТаблицы.Версия) Тогда 						
					ЗаписьСтатус = РегистрыСведений.СтатусыВерсийЕФ.СоздатьМенеджерЗаписи();
					ЗаписьСтатус.Организация = Организация;
					ВерсияТекущаяДатаНачала = СтрокаТаблицы.ВерсияТекущаяДатаНачала; 
					ВерсияДатаНачала = СтрокаТаблицы.ВерсияДатаНачала;
					ЗаписьСтатус.Период = Макс(ВерсияДатаНачала, ВерсияТекущаяДатаНачала);
					ЗаписьСтатус.Версия = СтрокаТаблицы.Версия;
					ЗаписьСтатус.Статус = Перечисления.СтатусыВерсийЕФ.НеДействительный;
					ЗаписьСтатус.Записать();					
				КонецЕсли; 
									
			КонецЕсли; 
			
			Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.ВерсияТекущая) Тогда
				Текст = НСтр("ru = 'Актуальная версия таксономии не найдена'");
				ЗаписьЖурналаРегистрации("ОбработкаОтветаНаЗапросТаксономииЕСМВ",
				УровеньЖурналаРегистрации.Ошибка,,,Текст);
				ПараметрыЗапроса = Новый Структура("Период, ТипСообщения", УниверсальноеВремя(ТекущаяДатаСеанса()), Перечисления.ТипыСообщенийМСД.Таксономия);
				РегистрыСведений.ЗапросыНаСверкуДанныхМСД.ОтразитьСтатусСверкиОшибка(ПараметрыЗапроса, Текст);
			КонецЕсли;

		КонецЦикла;	
	
	КонецЕсли;
КонецПроцедуры	

Функция ПолучитьУниверсальноеВремя() Экспорт
	Возврат УниверсальноеВремя(ТекущаяДатаСеанса());	
КонецФункции 

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
