Функция СписокНастроекКлассификацииТоваровИУслуг(Номенклатура, ДатаСведений) Экспорт

	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НастройкаСоответствияНоменклатуреСервиса.НоменклатураЕдиногоКаталогаТоваровИУслуг КАК НоменклатураКлассификатора,
	|	НастройкаСоответствияНоменклатуреСервиса.НоменклатураЕдиногоКаталогаТоваровИУслуг.ТипНоменклатурыКаталога КАК ТипКлассификатора
	|ИЗ
	|	РегистрСведений.НастройкаСоответствияНоменклатуреСервиса КАК НастройкаСоответствияНоменклатуреСервиса
	|ГДЕ
	|	НастройкаСоответствияНоменклатуреСервиса.Номенклатура = &Номенклатура
	|
	|УПОРЯДОЧИТЬ ПО
	|	НоменклатураКлассификатора";
	
	Запрос.УстановитьПараметр("Период", 	КонецДня(ДатаСведений));
	Запрос.УстановитьПараметр("Номенклатура",	Номенклатура);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выгрузить();
	
КонецФункции

#КонецОбласти

Процедура ЗаписатьПривязкуНоменклатурыЕдиногоКлассификатора(НоменклатураБГУ, НоменклатураЕдиногоКаталога, ТекстОшибки = "") Экспорт
	Если ЗначениеЗаполнено(НоменклатураБГУ) И ЗначениеЗаполнено(НоменклатураЕдиногоКаталога) Тогда
		Если НоменклатураЕдиногоКаталога.ТипНоменклатурыКаталога = Перечисления.ТипыНоменклатурыЕдиногоКаталогаТоваровИУслуг.НоменклатураСервиса Тогда
			Попытка
				НаборЗаписей = РегистрыСведений.НастройкаСоответствияНоменклатуреСервиса.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.НоменклатураЕдиногоКаталогаТоваровИУслуг.Установить(НоменклатураЕдиногоКаталога, Истина);
				
				НоваяСтрока = НаборЗаписей.Добавить();
				
				НоваяСтрока.Номенклатура = НоменклатураБГУ;
				НоваяСтрока.НоменклатураЕдиногоКаталогаТоваровИУслуг = НоменклатураЕдиногоКаталога;
				
				Если ТипЗнч(НоменклатураБГУ) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
					НоваяСтрока.Организация = НоменклатураБГУ.Организация;
				КонецЕсли;
				
				НаборЗаписей.Записать();
			Исключение
				Отказ = Истина;
				
				ЗаписьЖурналаРегистрации(
					НСтр("ru = 'Запись соответствия номенклатуры 1С:Номенклатура номенклатуре ИБ '"),
					УровеньЖурналаРегистрации.Ошибка,
					НоменклатураБГУ.Метаданные(),
					НоменклатураБГУ,
					ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				
				ТекстОшибки = НСтр("ru = 'Ошибка при записи соответствия номенклатуры 1С:Номенклатура номенклатуре ИБ 
					|Подробности см. в Журнале регистрации.'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			КонецПопытки;
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры	

Функция НоменклатураЕдиногоКаталогаПоИдентификатору(ИдентификаторСервиса) Экспорт
	Результат = Справочники.ЕдиныйКаталогОписанийТоваровИУслуг.ПустаяСсылка();
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторСервиса) Тогда
		Возврат Результат;
	КонецЕсли;	
	
	ИдентификаторыСервиса = Новый Структура;
	ИдентификаторыСервиса.Вставить("ИдентификаторНоменклатуры", ИдентификаторСервиса);
	ИдентификаторыСервиса.Вставить("ИдентификаторХарактеристики", "");
	
	МассивИд = Новый Массив;
	МассивИд.Добавить(ИдентификаторыСервиса);
	
	ДанныеНоменклатуры = РаботаСНоменклатурой.НоменклатураИХарактеристикиПоИдентификаторамСПроверкойВСервисе(МассивИд);
	
	СсылкаНаНоменклатуру = Справочники.Классификатор1СНоменклатура.ПустаяСсылка();
	Для каждого ТекСтрока Из ДанныеНоменклатуры Цикл
		СсылкаНаНоменклатуру = ТекСтрока.Номенклатура;	
	КонецЦикла;	
	
	Запрос = Новый Запрос;
	
	Если ЗначениеЗаполнено(СсылкаНаНоменклатуру) Тогда
		ТекстЗапроса = "ВЫБРАТЬ
		               |	ЕдиныйКаталогОписанийТоваровИУслуг.Ссылка КАК Ссылка
		               |ИЗ
		               |	Справочник.ЕдиныйКаталогОписанийТоваровИУслуг КАК ЕдиныйКаталогОписанийТоваровИУслуг
		               |ГДЕ
		               |	ЕдиныйКаталогОписанийТоваровИУслуг.НоменклатураКаталога = &СсылкаНаНоменклатуру
		               |	И ЕдиныйКаталогОписанийТоваровИУслуг.ТипНоменклатурыКаталога = &ТипНоменклатурыКаталога";
	Иначе	
		ТекстЗапроса = "ВЫБРАТЬ
		               |	ЕдиныйКаталогОписанийТоваровИУслуг.Ссылка КАК Ссылка
		               |ИЗ
		               |	Справочник.ЕдиныйКаталогОписанийТоваровИУслуг КАК ЕдиныйКаталогОписанийТоваровИУслуг
		               |ГДЕ
		               |	ВЫРАЗИТЬ(ЕдиныйКаталогОписанийТоваровИУслуг.НоменклатураКаталога КАК Справочник.Классификатор1СНоменклатура).ИдентификаторСервиса = &ИдентификаторСервиса
		               |	И ЕдиныйКаталогОписанийТоваровИУслуг.ТипНоменклатурыКаталога = &ТипНоменклатурыКаталога";
	КонецЕсли;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ТипНоменклатурыКаталога", Перечисления.ТипыНоменклатурыЕдиногоКаталогаТоваровИУслуг.НоменклатураСервиса);
	Запрос.УстановитьПараметр("ИдентификаторСервиса", СокрЛП(ИдентификаторСервиса));
	Запрос.УстановитьПараметр("СсылкаНаНоменклатуру", СсылкаНаНоменклатуру);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;	
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

Процедура СоздатьПривязкуКлассификатораСервиса1СНоменклатура(НоменклатураКонтрагента, НоменклатураИБ, Отказ, ТекстОшибки) Экспорт
	Если ПолучитьФункциональнуюОпцию("ИспользоватьСервисРаботаСНоменклатурой") Тогда
		Если ЗначениеЗаполнено(НоменклатураКонтрагента) И ЗначениеЗаполнено(НоменклатураИБ) Тогда
			Номенклатура = НоменклатураИБ.Номенклатура;
			ИдентификаторСервиса = НоменклатураКонтрагента.ИдентификаторНоменклатурыСервиса;
			НоменклатураЕдиногоКаталога = НоменклатураЕдиногоКаталогаПоИдентификатору(ИдентификаторСервиса);
				
			Если НЕ ЗначениеЗаполнено(НоменклатураЕдиногоКаталога) Тогда
				НаименованиеНоменклатурыИзЭД = НоменклатураКонтрагента.Наименование;
				
				Если НЕ ЗначениеЗаполнено(НаименованиеНоменклатурыИзЭД) Тогда
					Если ЗначениеЗаполнено(Номенклатура) Тогда
						НаименованиеНоменклатурыИзЭД = Номенклатура.Наименование;
					Иначе
						НаименованиеНоменклатурыИзЭД = НСтр("ru = 'Номенклатура сервиса не загружена'");
					КонецЕсли;	
				КонецЕсли;
				
				СоздатьНоменклатуруИзЭД(ИдентификаторСервиса, НаименованиеНоменклатурыИзЭД, НоменклатураКонтрагента.ИдентификаторХарактеристикиСервиса);					
				
				НоменклатураЕдиногоКаталога = НоменклатураЕдиногоКаталогаПоИдентификатору(ИдентификаторСервиса);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Номенклатура) И ЗначениеЗаполнено(НоменклатураЕдиногоКаталога) Тогда
				ЗаписатьПривязкуНоменклатурыЕдиногоКлассификатора(Номенклатура, НоменклатураЕдиногоКаталога, ТекстОшибки);
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

// Формирует перечень доступных для выгрузки дополнительных реквизитов Номенклатуры
// 
// Параметры:
//  ДополнительныеРеквизиты - ТаблицаЗначений - дополнительные реквизиты номенклатуры.
//    Колонки:
//    * Свойство - Ссылка - ссылка на доп.реквизит.
//    * Синоним - Строка - пользовательское представление доп.реквизита.
//    * ВидНоменклатуры - Ссылка - вид номенклатуры (соответствует набору доп.реквизитов). Для общих реквизитов не заполняется (пустая ссылка).
//    * ВидНоменклатурыНаименование - Строка - пользовательское представление набора доп.реквизитов. Пример: "Столы (вид номенклатуры)".
//    * ИспользоватьХарактеристики - Булево - признак использования характеристик по виду номенклатуры.
//    Если виды номенклатуры не используются, достаточно заполнить только первые 2 колонки.
//  ВидыНоменклатуры - СписокЗначений, Неопределено - виды номенклатуры, для которых нужно получить доп.реквизиты.
//                                      Если передано Неопределено, то нужно получить доп.реквизиты по всем видам номенклатуры без отбора.
// 
Процедура ДополнительныеРеквизитыНоменклатурыДляВыгрузки(ДополнительныеРеквизиты, ВидыНоменклатуры) Экспорт
	
	ДополнительныеРеквизиты.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	"""" КАК ВидНоменклатуры,
	               |	"""" КАК ВидНоменклатурыНаименование,
	               |	ЛОЖЬ КАК ИспользоватьХарактеристики,
	               |	ДополнительныеРеквизиты.Ссылка КАК Свойство,
	               |	ДополнительныеРеквизиты.Заголовок КАК Синоним
	               |ИЗ
	               |	Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеРеквизиты КАК Наборы
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК ДополнительныеРеквизиты
	               |		ПО Наборы.Свойство = ДополнительныеРеквизиты.Ссылка
	               |
	               |ОБЪЕДИНИТЬ
	               |
	               |ВЫБРАТЬ
	               |	"""",
	               |	&ПояснениеОбщие,
	               |	ЛОЖЬ,
	               |	ДополнительныеРеквизиты.Ссылка,
	               |	ДополнительныеРеквизиты.Заголовок
	               |ИЗ
	               |	ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения КАК ДополнительныеРеквизиты
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеРеквизиты КАК Наборы
	               |		ПО ДополнительныеРеквизиты.Ссылка = Наборы.Свойство
	               |ГДЕ
	               |	Наборы.ИмяПредопределенногоНабора = ""Справочник_Номенклатура_Общие""";
	
	Запрос.УстановитьПараметр("ПояснениеОбщие", НСтр("ru = 'Общие доп.реквизиты'"));
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ДополнительныеРеквизиты.Добавить(), Выборка);
	КонецЦикла;
	
КонецПроцедуры

