////////////////////////////////////////////////////////////////////////////////
// <Заполнение отчетности форма отчета клиент сервер: реализация методов формы УниверсальныйРегламентированныйОтчет для системы заполнения.>
//  
////////////////////////////////////////////////////////////////////////////////

////////////////////////////////////////////////////////////////////////////////
// ПРОГРАММНЫЙ ИНТЕРФЕЙС

Процедура РасшифроватьАвтозаполнение(ФормаОтчета, АдресТаблицыПоказателей) Экспорт 
	
	
	СтруктураФормы = Новый Структура("Объект,ПравилоЗаполнения,АдресТаблицыРасшифровки,АдресОбъектаОтчет");
	ЗаполнитьЗначенияСвойств(СтруктураФормы,ФормаОтчета);

	АдресРезультатаРасшифровки = ЗаполнениеОтчетностиФормаОтчетаВызовСервера.ВыполнитьРасшифровкуАвтозаполнения(СтруктураФормы, АдресТаблицыПоказателей);
	
	Если АдресРезультатаРасшифровки <> Неопределено Тогда
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("АдресДанныхОтображения"   , АдресРезультатаРасшифровки);
		ПараметрыФормы.Вставить("РежимОбработкиРасшифровки", "Автозаполнение");
		
		ОткрытьФорму("Документ.УниверсальныйРегламентированныйОтчет.Форма.РасшифровкаПоказателей", ПараметрыФормы, ФормаОтчета, Истина);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыполнитьДействиеКоманды(Команда,ФормаОтчета) Экспорт 
	
		
	СтруктураКоманды = ПолучитьСтруктуруКоманды(Команда,ФормаОтчета);
	
	ВыполнитьКоманду(ФормаОтчета, СтруктураКоманды.ИмяМетода, СтруктураКоманды.ИндексМетода,, СтруктураКоманды.ПравилоЗаполнения);
	
КонецПроцедуры

Процедура ВвестиПараметрыИВыполнитьДействиеКоманды(Команда, ФормаОтчета, ОбработкаЗавершения)Экспорт
	
	СтруктураКоманды = ПолучитьСтруктуруКоманды(Команда,ФормаОтчета);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Событие","");
	ПараметрыФормы.Вставить("ИмяМетода",СтруктураКоманды.ИмяМетода);
	ПараметрыФормы.Вставить("ИндексМетода",СтруктураКоманды.ИндексМетода);
	ПараметрыФормы.Вставить("РеквизитыДокумента", ПолучитьРеквизитыОтчетногоДокумента(ФормаОтчета,СтруктураКоманды.ПравилоЗаполнения));
	ПараметрыФормы.Вставить("ДополнительныеРеквизиты", СформироватьСтруктуруДополнительныхРеквизитов(ФормаОтчета));
	ПараметрыФормы.Вставить("АдресСохраненныхНастроек", ФормаОтчета.АдресСохраненныхНастроек);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяФормы","Обработка.ОбработкаДанныхОтчетности.Форма." + СтруктураКоманды.ИмяМетода); 
	ДополнительныеПараметры.Вставить("ПараметрыФормы",ПараметрыФормы);
	ДополнительныеПараметры.Вставить("ВладелецФормы",ФормаОтчета);
	ДополнительныеПараметры.Вставить("ПервичнаяПроверка","ТипЗнч(Результат) = Тип(""Структура"") и Результат.Свойство(""АдресПараметров"") и ЭтоАдресВременногоХранилища(Результат.АдресПараметров)");
	
	СтруктураОбработкиРезультата = Новый Структура;
	СтруктураОбработкиРезультата.Вставить("ФормаОтчета",ФормаОтчета);
	СтруктураОбработкиРезультата.Вставить("СтруктураКоманды",СтруктураКоманды);
	СтруктураОбработкиРезультата.Вставить("ОбработкаЗавершения",ОбработкаЗавершения);
	
	ДополнительныеПараметры.Вставить("ОбработкаРезультата",Новый ОписаниеОповещения("ВвестиПараметрыИВыполнитьДействиеКомандыЗавершение",ЗаполнениеОтчетностиФормаОтчетаКлиент,СтруктураОбработкиРезультата));
		
	БюджетнаяОтчетностьКлиент.ОткрытьФормуСПростойОбработкой(ДополнительныеПараметры);
	
КонецПроцедуры


Процедура ВывестиРазделСправки(Команда,ФормаОтчета)Экспорт
	
	СтруктураКоманды = ПолучитьСтруктуруКоманды(Команда,ФормаОтчета);
	
	ОткрытьФорму("Обработка.ОбработкаДанныхОтчетности.Форма." + СтруктураКоманды.ИмяМетода, СтруктураКоманды, ФормаОтчета);
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

Функция ПолучитьСтруктуруКоманды(Команда,ФормаОтчета)
	
	СтруктураКоманды = Новый Структура;
	
	ПозПравила = Найти(Команда.Имя,"__");
	
	ИмяКомандыДляОбработки = Команда.Имя;
	ИмяПравила = "";
	Если ПозПравила <> 0 Тогда
		ИмяПравила = Сред(Команда.Имя,1,ПозПравила+1);
		ИмяКомандыДляОбработки = Сред(Команда.Имя,ПозПравила+2);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяПравила) Тогда
		НайденныеСтроки = ФормаОтчета.ТаблицаПравилЗаполнения.НайтиСтроки(Новый Структура("ИмяКоманды",ИмяПравила));
		Если НайденныеСтроки.Количество() > 0 Тогда
			СтруктураКоманды.Вставить("ПравилоЗаполнения",НайденныеСтроки[0].Правило);
		КонецЕсли;
	КонецЕсли;
	
	// Выделим индекс строки табличной части из имения команды
	Поз = ЗаполнениеОтчетностиКлиентСервер.НайтиПодстрокуПрав(ИмяКомандыДляОбработки, "_");
	Если Поз <> 0 Тогда
		
		ИндексМетодаСтрока = Сред(ИмяКомандыДляОбработки, Поз + 1);
		Если ЗаполнениеОтчетностиКлиентСервер.ВсеСимволыСтрокиЧисловые(ИндексМетодаСтрока) Тогда
			
			ИмяМетода = Лев(ИмяКомандыДляОбработки, Поз - 1);
			ИндексМетода = Число(ИндексМетодаСтрока);
			
		КонецЕсли;
		
	Иначе
		
		ИмяМетода = ИмяКомандыДляОбработки;
		ИндексМетода = Неопределено;
		
	КонецЕсли;
	
	СтруктураКоманды.Вставить("ИмяМетода", ИмяМетода);
	СтруктураКоманды.Вставить("ИндексМетода", ИндексМетода);
	
	Если НЕ СтруктураКоманды.Свойство("ПравилоЗаполнения") Тогда
		СтруктураКоманды.Вставить("ПравилоЗаполнения", ФормаОтчета.ПравилоЗаполнения);
	КонецЕсли;
	
	Возврат СтруктураКоманды;
	
КонецФункции

Процедура ВыполнитьКоманду(ФормаОтчета, Знач ИмяМетода, Знач ИндексМетода, Знач АдресПараметров = "", ТекПравилоЗаполнения) 
	
	ТекстСообщения = "";
	СтруктураОповещения = Неопределено;
	
	Если СтрНачинаетсяС(ИмяМетода,"РассчитатьГруппировочныеИтогиПоГруппам") Тогда
		ФормаОтчета.СохранитьДанныеБланковДоВыполненияКоманды();
	КонецЕсли;
	
	СтруктураФормы = Новый Структура("Объект,УникальныйИдентификатор,АдресОбъектаОтчет,АдресТаблицыРасшифровки");
	ЗаполнитьЗначенияСвойств(СтруктураФормы,ФормаОтчета);
	СтруктураФормы.Вставить("ПравилоЗаполнения",ТекПравилоЗаполнения);
	
	ПараметрыВыполения = Новый Структура;
	ПараметрыВыполения.Вставить("ФормаОтчета", СтруктураФормы);
	ПараметрыВыполения.Вставить("ИмяМетода", ИмяМетода);
	ПараметрыВыполения.Вставить("ИндексМетода", ИндексМетода);
	ПараметрыВыполения.Вставить("АдресПараметров", АдресПараметров);
	ПараметрыВыполения.Вставить("ПараметрыМетода", Неопределено);
	ПараметрыВыполения.Вставить("ТекстСообщения", ТекстСообщения);
	ПараметрыВыполения.Вставить("СтруктураОповещения", СтруктураОповещения);
	ПараметрыВыполения.Вставить("УникальныйИдентификатор", ФормаОтчета.УникальныйИдентификатор);
		
	Результат  = ЗаполнениеОтчетностиФормаОтчетаВызовСервера.ВыполнитьФоновоеЗаполнение(ПараметрыВыполения);
	
	ФормаОтчета.АдресХранилища       = Результат.АдресХранилища;
	ФормаОтчета.ИдентификаторЗадания = Результат.ИдентификаторЗадания;
	ФормаОтчета.ЗаданиеВыполнено     = Результат.ЗаданиеВыполнено;
	
	ФормаОтчета.Подключаемый_ОбработатьРезультатВыполненияКоманды();
				
КонецПроцедуры

Функция СформироватьСтруктуруДополнительныхРеквизитов(ФормаОтчета)
	
	ДополнительныеРеквизиты = Новый Структура;
	
	Для Каждого Реквизит из ФормаОтчета.ТаблицаДополнительныхРеквизитов Цикл
		ДополнительныеРеквизиты.Вставить(СокрП(Реквизит.Код), Реквизит.ТипЗначения.ПривестиЗначение(Реквизит.Значение));
	КонецЦикла;
	
	Возврат ДополнительныеРеквизиты;
	
КонецФункции

Функция ПолучитьРеквизитыОтчетногоДокумента(ФормаОтчета,ТекПравилоЗаполнения)
	
	СтруктураРеквизитов = Новый Структура;
	
	СтруктураРеквизитов.Вставить("ОтчетныйДокумент", ФормаОтчета.Объект.Ссылка);
	СтруктураРеквизитов.Вставить("Организация", ФормаОтчета.Объект.Организация);
	СтруктураРеквизитов.Вставить("ВидОтчета", ФормаОтчета.Объект.ВидОтчета);
	СтруктураРеквизитов.Вставить("ПравилоЗаполнения", ТекПравилоЗаполнения);
	СтруктураРеквизитов.Вставить("ПериодОтчета", ФормаОтчета.Объект.ПериодОтчета);
	СтруктураРеквизитов.Вставить("ИФО", ФормаОтчета.Объект.ИФО);
	
	Возврат СтруктураРеквизитов;
	
КонецФункции

Процедура ВвестиПараметрыИВыполнитьДействиеКомандыЗавершение(Результат, ДополнительныеПараметры) Экспорт 
	
	ВыполнитьКоманду(ДополнительныеПараметры.ФормаОтчета, ДополнительныеПараметры.СтруктураКоманды.ИмяМетода,
	ДополнительныеПараметры.СтруктураКоманды.ИндексМетода, Результат.АдресПараметров,ДополнительныеПараметры.СтруктураКоманды.ПравилоЗаполнения);
	
	Если ДополнительныеПараметры.ОбработкаЗавершения <> Неопределено Тогда 
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОбработкаЗавершения,Результат);
	КонецЕсли;	
	
КонецПроцедуры	

