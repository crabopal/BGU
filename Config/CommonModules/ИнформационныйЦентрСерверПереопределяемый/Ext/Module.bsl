#Область ПрограммныйИнтерфейс

// Определяет ссылку поиска информации.
// Например сайт ИТС.
// Структура должна быть следующая:
//	Если к адресу ссылки добавить строку поиска, и перейти по данному адресу, то
//	в результате мы должны перейти форму результатов поиска.
//
// Параметры:
//	СсылкаПоискаИнформации - Строка - адрес.
//
//@skip-warning Пустой метод
Процедура ОпределитьСсылкуПоискаИнформации(СсылкаПоискаИнформации) Экспорт
	
КонецПроцедуры

Процедура ОбщиеМакетыСИнформационнымиСсылками(МассивМакетов) Экспорт
	
	МассивМакетов.Добавить(ПолучитьОбщийМакет("ИнформационныеСсылки_БГУ"));
	
КонецПроцедуры

// Определяет массив полных путей к формам, в которых используются информационные ссылки.
//
// Параметры:
//  МассивФорм - Массив - массив полных путей к формам.
//
//@skip-warning Пустой метод
Процедура ФормыСИнформационнымиСсылками(МассивФорм) Экспорт
	
	КлассыМетаданных = Новый Массив;
	
	КлассыМетаданных.Добавить("ПланыОбмена");
	КлассыМетаданных.Добавить("Справочники");
	КлассыМетаданных.Добавить("Документы");
	КлассыМетаданных.Добавить("ЖурналыДокументов");
	КлассыМетаданных.Добавить("Перечисления");
	КлассыМетаданных.Добавить("Отчеты");
	КлассыМетаданных.Добавить("Обработки");
	КлассыМетаданных.Добавить("ПланыВидовХарактеристик");
	КлассыМетаданных.Добавить("ПланыСчетов");
	КлассыМетаданных.Добавить("ПланыВидовРасчета");
	КлассыМетаданных.Добавить("РегистрыСведений");
	КлассыМетаданных.Добавить("РегистрыНакопления");
	КлассыМетаданных.Добавить("РегистрыБухгалтерии");
	КлассыМетаданных.Добавить("РегистрыРасчета");
	КлассыМетаданных.Добавить("БизнесПроцессы");
	КлассыМетаданных.Добавить("Задачи");
	КлассыМетаданных.Добавить("ХранилищаНастроек");
	КлассыМетаданных.Добавить("КритерииОтбора");
	
	КлассМетаданных     = Метаданные["ОбщиеФормы"];
	КоличествоЭлементов = КлассМетаданных.Количество();
	Для ИтерацияЭлементов = 0 По КоличествоЭлементов - 1 Цикл 
		ПолныйПутьКФорме = КлассМетаданных.Получить(ИтерацияЭлементов).ПолноеИмя();
		МассивФорм.Добавить(ПолныйПутьКФорме);
	КонецЦикла;
		
	Для Каждого ИмяКлассаМетаданного Из КлассыМетаданных Цикл	
		КлассМетаданных     = Метаданные[ИмяКлассаМетаданного];
		КоличествоЭлементов = КлассМетаданных.Количество();
		Для ИтерацияЭлементов = 0 По КоличествоЭлементов - 1 Цикл 
			ФормыКлассаМетаданных = КлассМетаданных.Получить(ИтерацияЭлементов).Формы;
			КоличествоФорм        = ФормыКлассаМетаданных.Количество();
			Для ИтерацияФорм = 0 По КоличествоФорм - 1 Цикл 
				ПолныйПутьКФорме = ФормыКлассаМетаданных.Получить(ИтерацияФорм).ПолноеИмя();
				МассивФорм.Добавить(ПолныйПутьКФорме);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
		
КонецПроцедуры

#КонецОбласти

