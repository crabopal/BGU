#Область ЭПДВДокументахУчета

Процедура ОформитьЭПД(Форма, ЭлементФормы) Экспорт
	Объект = Форма.Объект;
	СписокОснований = ЭлектронныеДокументыБГУВызовСервера.СписокСчетовНаОплатуПокупателю(Объект);
	СписокОснований.Добавить(Объект.Ссылка);
	
	СписокЗаявок = ЭлектронныеДокументыБГУВызовСервера.ЭлектронныеДокументыПоОснованию(СписокОснований, Тип("ДокументСсылка.ЭлектронныйЗаказЗаявка"));
	
	ЗаказЗаявкаСсылка = Неопределено;
	Для каждого КлючИЗначение Из СписокЗаявок Цикл
		Если ЗначениеЗаполнено(ЗаказЗаявкаСсылка) И КлючИЗначение.Пометка Тогда
			ЗаказЗаявкаСсылка = Неопределено;
			Прервать;
		ИначеЕсли КлючИЗначение.Пометка Тогда
			ЗаказЗаявкаСсылка = КлючИЗначение.Значение;
		КонецЕсли;
	КонецЦикла;
	
	// Если есть заявка, лишних вопросов не задаем, сразу формируем
	Если ЗначениеЗаполнено(ЗаказЗаявкаСсылка) Тогда 
		
		ДанныеЗаполнения = Новый Структура;    
		ДанныеЗаполнения.Вставить("Основание", ЗаказЗаявкаСсылка); 
		
		ДанныеЗаполнения.Вставить("ДокументыОснования", Новый Массив);
		МассивОснований = ДанныеЗаполнения.ДокументыОснования;
		МассивОснований.Добавить(Новый Структура("ДокументОснование", Объект.Ссылка));
				

		ОткрытьФорму("Документ.ЭлектроннаяТранспортнаяНакладная.ФормаОбъекта", Новый Структура("ЗначенияЗаполнения", ДанныеЗаполнения));  
		
		Возврат;
	КонецЕсли;
	
	ВыбратьТипДокумента(Форма, ЭлементФормы);
КонецПроцедуры

Асинх Процедура ВыбратьТипДокумента(Форма, ЭлементФормы)
	ТипыДокументов = Новый СписокЗначений;
	ТипыДокументов.Добавить("ЭлектроннаяТранспортнаяНакладная", НСтр("ru = 'Электронная транспортная накладная'"));
	ТипыДокументов.Добавить("ЭлектроннаяЗаказЗаявка", 			НСтр("ru = 'Электронная заказ (заявка)'"));
	
	РезультатВыбора = Ждать Форма.ВыбратьИзСпискаАсинх(ТипыДокументов, ЭлементФормы);
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Форма.Объект.Ссылка.Пустая() ИЛИ Форма.Модифицированность Тогда
		Результат = Ждать ЗаписатьДокумент(РезультатВыбора, Форма);
		Если НЕ Результат Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если РезультатВыбора.Значение = "ЭлектроннаяЗаказЗаявка" Тогда
		СоздатьЭлектроннуюЗаказЗаявку(Форма);
	Иначе
		СоздатьЭлектроннуюТранспортнуюНакладную(Форма);
	КонецЕсли;
КонецПроцедуры

Асинх Функция ЗаписатьДокумент(РезультатВыбора, Форма)
	ТекстВопроса = НСтр("ru = 'Документ еще не записан. Записать?'");
	Результат = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Форма.Записать();
	
	Возврат Истина;
КонецФункции

Процедура СоздатьЭлектроннуюЗаказЗаявку(Форма) Экспорт
	ДокументОснование = Форма.Объект.Ссылка;
	ПараметрыОткрытия = Новый Структура("ЗначенияЗаполнения", ЭлектронныеДокументыБГУВызовСервера.ДанныеДляЗаполненияЭЗЗ(ДокументОснование));
	
	ОповешениеОЗакрытии = Новый ОписаниеОповещения("СоздатьЭПДЗавершение", ЭтотОбъект, Форма);
	ОткрытьФорму("Документ.ЭлектронныйЗаказЗаявка.ФормаОбъекта", ПараметрыОткрытия,,,,,ОповешениеОЗакрытии);
КонецПроцедуры

Процедура СоздатьЭлектроннуюТранспортнуюНакладную(Форма) Экспорт 
	ДокументОснование = Форма.Объект.Ссылка;
	
	ПараметрыОткрытия = Новый Структура("ЗначенияЗаполнения", ЭлектронныеДокументыБГУВызовСервера.ДанныеДляЗаполненияЭТрН(ДокументОснование));
	ОповешениеОЗакрытии = Новый ОписаниеОповещения("СоздатьЭПДЗавершение", ЭтотОбъект, Форма);
	ОткрытьФорму("Документ.ЭлектроннаяТранспортнаяНакладная.ФормаОбъекта", ПараметрыОткрытия,,,,,ОповешениеОЗакрытии);
КонецПроцедуры


Процедура СоздатьЭПДЗавершение(Результат, Форма) Экспорт
	ЭлектронныеДокументыБГУКлиентСервер.ОбновитьТекстЭПД(Форма);
КонецПроцедуры

Процедура ОткрытьСписокЭПД(Форма) Экспорт
	Если НЕ ЗначениеЗаполнено(Форма.ЭПДСсылка) Тогда
		СписокОснований = ЭлектронныеДокументыБГУВызовСервера.СписокСчетовНаОплатуПокупателю(Форма.Объект);
		СписокОснований.Добавить(Форма.Объект.Ссылка);
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("КлючНазначенияФормы",    Строка(Новый УникальныйИдентификатор));
		ПараметрыОтбора.Вставить("ОтборДокументОснование", СписокОснований);
		
		ОткрытьФорму("Обработка.ЭлектронныеПеревозочныеДокументы.Форма.ФормаСпискаЭПД", ПараметрыОтбора);
	Иначе
		ПоказатьЗначение(,Форма.ЭПДСсылка);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти


