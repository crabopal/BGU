// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

Функция ОпределитьДату(РасчетнаяДата)
	
	Если Не ЗначениеЗаполнено(РасчетнаяДата) Тогда
		#Если Клиент Тогда
			Результат = ТекущаяДата();
		#Иначе
			Результат = ТекущаяДатаСеанса();
		#КонецЕсли
	Иначе
		Результат = РасчетнаяДата;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьЗначенияПеречисления(Текст, Разделитель = ",")
	
	Результат = Новый Массив;
	
	ДлинаОбщая = СтрДлина(Текст);
	Значение = "";
	Сч = 1;
	СчСкобок = 0;
	КавычкиЗакрыты = Истина;
	Пока Сч <= ДлинаОбщая Цикл
		Символ = Сред(Текст, Сч, 1);
		Если Символ = "(" Тогда
			СчСкобок = СчСкобок + 1;
		ИначеЕсли Символ = ")" Тогда
			СчСкобок = СчСкобок - 1;
		ИначеЕсли Символ = """" Тогда
			КавычкиЗакрыты = Не КавычкиЗакрыты;
		ИначеЕсли Символ = "," Тогда
			Если КавычкиЗакрыты И СчСкобок = 0 Тогда
				Результат.Добавить(СокрЛП(Значение));
				Значение = "";
				Символ = "";						
			КонецЕсли;
		КонецЕсли;
		Значение = Значение + Символ; 
		Сч = Сч + 1;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Значение) Тогда
		Результат.Добавить(СокрЛП(Значение));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


