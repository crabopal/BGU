// Формирирует данные для вывода печтных форм требования-накладной 0510451.
// 
// Параметры:
//  МассивОбъектов - Массив из ДокументСсылка
// 
// Возвращаемое значение:
//  Структура:
//   * ДанныеШапки - см. ТаблицаШапкиДляПечатиТребованияНакладной0510451
//   * ТабличнаяЧасть - Соответствие Из Массив из см. ЗаголовокТабличнойЧастиТребованияНакладной0510451
//
Функция ДанныеДляПечатиТребованияНакладной0510451(МассивОбъектов)
	
	ДанныеОрганизацийПечати = ОбщиеСведенияДокументовДляПечати(МассивОбъектов);
	ДанныеГруппНФА = ГруппыОбъектовНФА();
	РезультатЗапроса = ЗапросДляПечатиТребованияНакладной0510451(МассивОбъектов);
	ВыборкаШапка = РезультатЗапроса.ДанныеШапки;

	ДвиженияДокументов = УправлениеМатериальнымиЗапасами.ДвиженияДокументов(МассивОбъектов);
	ДвиженияДокументов.Индексы.Добавить("Ссылка, НомерСтроки");
	
	ДанныеТабличныхЧастей = Новый Соответствие;
	ДанныеШапки = ТаблицаШапкиДляПечатиТребованияНакладной0510451();
	Пока ВыборкаШапка.Следующий() Цикл
		СтрокаШапки = ДанныеШапки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаШапки, ВыборкаШапка);
		СтрокаШапки.Номер = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ВыборкаШапка.Ссылка, ВыборкаШапка.Номер);
		
		ДанныеОрганизации = ДанныеОрганизацийПечати.Получить(ВыборкаШапка.Ссылка);
		СтрокаШапки.НаименованиеОрганизации = ДанныеОрганизации.НаименованиеОрганизации;
		СтрокаШапки.НаименованиеОбособленногоПодразделения = ДанныеОрганизации.НаименованиеОбособленногоПодразделения;
		СтрокаШапки.НаименованиеСтруктурногоПодразделения = ДанныеОрганизации.СтруктурноеПодразделение;
		СтрокаШапки.Учредитель = ДанныеОрганизации.Учредитель;
		СтрокаШапки.БюджетНаименование = ДанныеОрганизации.БюджетНаименование;
		СтрокаШапки.КодРПБС = ДанныеОрганизации.КодРПБС;
		СтрокаШапки.КодРПБСПодр = ДанныеОрганизации.КодРПБСОбособленногоПодразделения;
		СтрокаШапки.ГлаваБК = ДанныеОрганизации.ГлаваБК;
		СтрокаШапки.ОКТМО = ДанныеОрганизации.ОКТМО;

		// Данные о сотрудниках
		ПоляСотрудника = "СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, НаименованиеПолное, Должность, ДолжностьНаименование, ДолжностьНаименованиеПолное, Код";
		СотрудникиДокумента = Новый Массив;
		СотрудникиДокумента.Добавить(ВыборкаШапка.УполномоченноеЛицо);
		СотрудникиДокумента.Добавить(ВыборкаШапка.Затребовал);
		СотрудникиДокумента.Добавить(ВыборкаШапка.СотрудникОтправитель);
		СотрудникиДокумента.Добавить(ВыборкаШапка.СотрудникПолучатель);
		ДанныеСотрудников = Справочники.Сотрудники.ДанныеСотрудников(СотрудникиДокумента, ПоляСотрудника, ВыборкаШапка.Дата);
		
		ДанныеСотрудника = ДанныеСотрудников.Получить(ВыборкаШапка.УполномоченноеЛицо);
		Если ЗначениеЗаполнено(ДанныеСотрудника.ДолжностьНаименованиеПолное) Тогда
			СтрокаШапки.УполномоченноеЛицоДолжность = ДанныеСотрудника.ДолжностьНаименованиеПолное;
		Иначе
			СтрокаШапки.УполномоченноеЛицоДолжность = ДанныеСотрудника.ДолжностьНаименование;
		КонецЕсли;
		СтрокаШапки.УполномоченноеЛицоФИО = КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина);
		
		ДанныеСотрудника = ДанныеСотрудников.Получить(ВыборкаШапка.Затребовал);
		Если ЗначениеЗаполнено(ДанныеСотрудника.ДолжностьНаименованиеПолное) Тогда
			СтрокаШапки.ЗатребовалДолжность = ДанныеСотрудника.ДолжностьНаименованиеПолное;
		Иначе
			СтрокаШапки.ЗатребовалДолжность = ДанныеСотрудника.ДолжностьНаименование;
		КонецЕсли;
		СтрокаШапки.ЗатребовалФИО = КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина);
		СтрокаШапки.УчетныйНомерЗатребовал = ДанныеСотрудника.Код;
		
		ДанныеСотрудника = ДанныеСотрудников.Получить(ВыборкаШапка.СотрудникОтправитель);
		СтрокаШапки.ЦМООтправитель = ДанныеСотрудника.НаименованиеПолное;
		СтрокаШапки.УчетныйНомерОтправитель = ДанныеСотрудника.Код;
		Если ЗначениеЗаполнено(ДанныеСотрудника.ДолжностьНаименованиеПолное) Тогда
			СтрокаШапки.ОтпустилДолжность = ДанныеСотрудника.ДолжностьНаименованиеПолное;
		Иначе
			СтрокаШапки.ОтпустилДолжность = ДанныеСотрудника.ДолжностьНаименование;
		КонецЕсли;
		СтрокаШапки.ОтпустилФИО = КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина);
		
		ДанныеСотрудника = ДанныеСотрудников.Получить(ВыборкаШапка.СотрудникПолучатель);
		СтрокаШапки.ЦМОПолучатель= ДанныеСотрудника.НаименованиеПолное;
		СтрокаШапки.УчетныйНомерПолучатель = ДанныеСотрудника.Код;
		Если ЗначениеЗаполнено(ДанныеСотрудника.ДолжностьНаименованиеПолное) Тогда
			СтрокаШапки.ПолучилДолжность = ДанныеСотрудника.ДолжностьНаименованиеПолное;
		Иначе
			СтрокаШапки.ПолучилДолжность = ДанныеСотрудника.ДолжностьНаименование;
		КонецЕсли;
		СтрокаШапки.ПолучилФИО = КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина);
		
		СтрокаШапки.ОтветственныйДолжность = ДанныеОрганизации.ОтветственныйДолжность;
		СтрокаШапки.ОтветственныйФИО = КорреспондентыКлиентСервер.ФИО(ДанныеОрганизации.ОтветственныйФИО, Истина);
		СтрокаШапки.ОтветственныйТелефон = ДанныеОрганизации.ОтветственныйТелефон;
		СтрокаШапки.ОтветственныйЭлПочта = ДанныеОрганизации.ОтветственныйЭлПочта;
		
		ТабличныеЧасти = РезультатЗапроса.ДанныеТабличныхЧастей.Получить(ТипЗнч(ВыборкаШапка.Ссылка));
		
		ТабличныеЧасти.Сбросить();
		Если ТабличныеЧасти.НайтиСледующий(Новый Структура("Ссылка", ВыборкаШапка.Ссылка)) Тогда
			СтрокиДокумента = ТабличныеЧасти.Выбрать();
		Иначе
			СтрокиДокумента = Неопределено;
		КонецЕсли;
	
		СтрокиНФАПоГруппам = Новый Соответствие;
		ИспользуемыеГруппы = Новый ТаблицаЗначений;
		ИспользуемыеГруппы.Колонки.Добавить("КодГруппы", Новый ОписаниеТипов("Строка"));
		ИспользуемыеГруппы.Колонки.Добавить("ПорядокСчета", Новый ОписаниеТипов("Строка"));
		
		ДанныеТабличныхЧастейДокумента = Новый Массив;
		Пока СтрокиДокумента <> Неопределено И СтрокиДокумента.Следующий() Цикл
			
			КодГрупповогоСчета = Строка(СтрокиДокумента.КФО);
			ТекущаяГруппаНФА = ДанныеГруппНФА.Получить(СтрокиДокумента.СчетУчета);
			Если ТекущаяГруппаНФА <> Неопределено Тогда
				КодГрупповогоСчета = КодГрупповогоСчета + "." + ТекущаяГруппаНФА.Код;
			КонецЕсли;
			
			ГруппировочнаяСтрока = СтрокиНФАПоГруппам.Получить(КодГрупповогоСчета);
			Если ГруппировочнаяСтрока = Неопределено Тогда
				ЗаголовокТабличнойЧасти = ЗаголовокТабличнойЧастиТребованияНакладной0510451();
				СтрокаИспользуемыхГрупп = ИспользуемыеГруппы.Добавить();
				СтрокаИспользуемыхГрупп.КодГруппы = КодГрупповогоСчета;
				Если ТекущаяГруппаНФА <> Неопределено Тогда
					ЗаголовокТабличнойЧасти.КодГруппыНФА = КодГрупповогоСчета;
					ЗаголовокТабличнойЧасти.ГруппаНФА    = ТекущаяГруппаНФА.Наименование;
					СтрокаИспользуемыхГрупп.ПорядокСчета = Строка(СтрокиДокумента.КФО) + ТекущаяГруппаНФА.Порядок;
				КонецЕсли;
				СоставТабличнойЧасти = ЗаголовокТабличнойЧасти.Состав;
				СтрокиНФАПоГруппам.Вставить(КодГрупповогоСчета, ЗаголовокТабличнойЧасти);
			Иначе
				СоставТабличнойЧасти = ГруппировочнаяСтрока.Состав;
			КонецЕсли;
	
			НоваяСтрокаСостава = СоставТабличнойЧасти.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаСостава, СтрокиДокумента);
			НоваяСтрокаСостава.КодСтроки = СтрокиДокумента.НомерСтроки;
			Если Не ЗначениеЗаполнено(НоваяСтрокаСостава.НомерНоменклатурный) Тогда
				НоваяСтрокаСостава.НомерНоменклатурный = СтрокиДокумента.НФАКод;
			КонецЕсли;
			Если ТипЗнч(ВыборкаШапка.Ссылка) = Тип("ДокументСсылка.ТребованиеНакладнаяИК") Тогда
				УчетнаяПолитика = Справочники.Организации.ПолучитьУчетнуюПолитику(
					ВыборкаШапка.Организация, ВыборкаШапка.Дата);
				СуммаУказанаВДокументе = Не УчетнаяПолитика.ВедениеАналитическогоУчетаИмуществаКазны;
			Иначе
				СуммаУказанаВДокументе = ВыборкаШапка.СуммаУказанаВДокументе; 
			КонецЕсли;
			Если СуммаУказанаВДокументе Тогда
				Если НоваяСтрокаСостава.Цена = 0 И НоваяСтрокаСостава.Количество <> 0 Тогда
					НоваяСтрокаСостава.Цена = НоваяСтрокаСостава.Сумма / НоваяСтрокаСостава.Количество;
				КонецЕсли;
			Иначе
				ОтборСтрокиДокумента = Новый Структура("Ссылка, НомерСтроки", ВыборкаШапка.Ссылка, СтрокиДокумента.НомерСтроки);
				СтрокиДвижений = ДвиженияДокументов.НайтиСтроки(ОтборСтрокиДокумента);
				Если СтрокиДвижений.Количество() > 0 Тогда
					СтрокаСебестоимости = СтрокиДвижений[0];
					НоваяСтрокаСостава.Сумма = СтрокаСебестоимости.Сумма;
					НоваяСтрокаСостава.Цена = СтрокаСебестоимости.Цена;
				Иначе
					Если НоваяСтрокаСостава.Цена = 0 И НоваяСтрокаСостава.Количество <> 0 Тогда
						НоваяСтрокаСостава.Цена = НоваяСтрокаСостава.Сумма / НоваяСтрокаСостава.Количество;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			ДанныеБСО = Новый Структура;
			ДанныеБСО.Вставить("Номенклатура");
			ДанныеБСО.Вставить("СерияБСО");
			ДанныеБСО.Вставить("НомерНачальный");
			ДанныеБСО.Вставить("НомерКонечный");
			ДанныеБСО.Вставить("ТипНоменклатуры");
			ЗаполнитьЗначенияСвойств(ДанныеБСО, СтрокиДокумента);
			Если ТипЗнч(ДанныеБСО.Номенклатура) = Тип("СправочникСсылка.БСО")
					Или ДанныеБСО.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.БСО Тогда
				Если ЗначениеЗаполнено(ДанныеБСО.СерияБСО) Тогда
					НоваяСтрокаСостава.НФАНаименование = СтрШаблон(НСтр("ru = '%1 (серия %2)'"),
						НоваяСтрокаСостава.НФАНаименование, ДанныеБСО.СерияБСО);
				КонецЕсли;
				НоваяСтрокаСостава.НомерНоменклатурный = ПредставлениеНомеровБСОПоПриказу61н(
					ДанныеБСО.НомерНачальный, ДанныеБСО.НомерКонечный);
			КонецЕсли;
		КонецЦикла;
		
		ДанныеТабличныхЧастейДокумента = Новый Массив;
		ИспользуемыеГруппы.Сортировать("ПорядокСчета");
		Для Каждого ИспользуемаяГруппа Из ИспользуемыеГруппы Цикл
			СтрокиГруппы = СтрокиНФАПоГруппам.Получить(ИспользуемаяГруппа.КодГруппы);
			ДанныеТабличныхЧастейДокумента.Добавить(СтрокиГруппы);
		КонецЦикла;
		ДанныеТабличныхЧастей.Вставить(ВыборкаШапка.Ссылка, ДанныеТабличныхЧастейДокумента);
		
	КонецЦикла;
	
	ДанныеДляПечати = Новый Структура;
	ДанныеДляПечати.Вставить("ДанныеШапки", ДанныеШапки);
	ДанныеДляПечати.Вставить("ТабличнаяЧасть", ДанныеТабличныхЧастей);
	
	Возврат ДанныеДляПечати;
	
КонецФункции

Функция ЗапросДляПечатиТребованияНакладной0510451(МассивОбъектов)
	ДокументыПоТипам = ОбщегоНазначенияБГУ.ДокументыПоТипам(МассивОбъектов);
	ЧастиЗапросаШапки = Новый Массив;
	ЧастиОсновногоЗапроса = Новый Массив;
	Запрос = Новый Запрос;
	
	ЧастиОсновногоЗапроса.Добавить("");
	Счетчик = 1;
	Для Каждого ТипДокумента Из ДокументыПоТипам Цикл
		МенеджерДокумента = ОбщегоНазначения.МенеджерОбъектаПоСсылке(ТипДокумента.Значение[0]);
		ИмяПараметра = "&МассивОбектов" + Счетчик;
		ЧастиЗапросаШапки.Добавить(
			СтрЗаменить(МенеджерДокумента.ТекстЗапросаШапкиДляПечатиТребованияНакладной0510451(),
						"&МассивОбъектов",
						ИмяПараметра));
		ЧастиОсновногоЗапроса.Добавить(
			СтрЗаменить(МенеджерДокумента.ТекстЗапросаТаблицДляПечатиТребованияНакладной0510451(),
						"&МассивОбъектов",
						ИмяПараметра));
		Запрос.УстановитьПараметр(Сред(ИмяПараметра, 2), ТипДокумента.Значение);
	КонецЦикла;
	ЧастиОсновногоЗапроса[0] = СтрСоединить(ЧастиЗапросаШапки, ОбщегоНазначенияБГУ.ТекстРазделителяОбъединенияЗапросов("ВСЕ"));

	ТекстЗапроса = СтрСоединить(ЧастиОсновногоЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов());
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
	// Установить "Разрешенные" во все запросы
	ТекущийНомер = 1;
	Для Каждого ЗапросПакета Из СхемаЗапроса.ПакетЗапросов Цикл
		ЗапросПакета.ВыбиратьРазрешенные = Истина;
		Если ТекущийНомер = 1 Тогда
			ЗапросПакета.Порядок.Добавить("Дата");
			ЗапросПакета.Порядок.Добавить("Номер");
		Иначе
			// Установить упорядочивание и итоги
			ЗапросПакета.Порядок.Добавить("Ссылка");
			ЗапросПакета.Порядок.Добавить("НомерСтроки");
			ЗапросПакета.КонтрольныеТочкиИтогов.Добавить("Ссылка");
		КонецЕсли;
		ТекущийНомер = ТекущийНомер + 1;
	КонецЦикла;
	Запрос.Текст = СхемаЗапроса.ПолучитьТекстЗапроса();

	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	ДатаСчетов106БезПартии = '20210101';
	Запрос.УстановитьПараметр("Счета106хП", БухгалтерскийУчет.СписокСчетов("106.2П,106.3П", ДатаСчетов106БезПартии));
	Запрос.УстановитьПараметр("ЕдИзмШт", Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("796"));
	Запрос.УстановитьПараметр("Счет10856", БухгалтерскийУчет.СчетПоКоду("108.56"));
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ДанныеЗапроса = Новый Структура;
	ДанныеЗапроса.Вставить("ДанныеШапки", РезультатЗапроса[0].Выбрать());
	ДанныеЗапроса.Вставить("ДанныеТабличныхЧастей", Новый Соответствие);
	НомерЗапроса = 1;
	Для Каждого ТипДокумента Из ДокументыПоТипам Цикл
		ДанныеЗапроса.ДанныеТабличныхЧастей.Вставить(ТипДокумента.Ключ, РезультатЗапроса[НомерЗапроса].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
		НомерЗапроса = НомерЗапроса + 1;
	КонецЦикла;
	Возврат ДанныеЗапроса;
	
КонецФункции

#КонецОбласти

#КонецОбласти 

