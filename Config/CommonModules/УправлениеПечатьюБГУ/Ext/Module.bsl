
////////////////////////////////////////////////////////////////////////////////
// УправлениеПечатьюБГУ
// Содержит процедуры и функции формирующие печатные формы документов
//  
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

#Область ИнтерфейсИнтеграцииСБСП

// Добавляет команды печати бухгалтерских справок
//
Процедура ДобавитьКомандыПечатиБухгалтерскойСправки(КомандыПечати, ИмяФормы = "") Экспорт
	
	Если ПравоДоступа("Просмотр", Метаданные.РегистрыБухгалтерии.ЖурналПроводокЕПСБУ) Тогда
		
		ПроверкаПроведенияПередПечатью = Не ЗначениеЗаполнено(ИмяФормы)
			Или Не ФормаПринадлежитОбъекту(ИмяФормы, "ОперацияБух");
		
		// Бухгалтерская справка (развернутая)
		КомандаПечати									= КомандыПечати.Добавить();
		КомандаПечати.МенеджерПечати					= "Обработка.ПечатьБухгалтерскойСправки";
		КомандаПечати.Идентификатор						= "Справка0504833";
		КомандаПечати.Представление						= НСтр("ru = 'Справка ф. 0504833 (развернутая)'");
		КомандаПечати.Порядок							= 97;
		КомандаПечати.ПроверкаПроведенияПередПечатью	= ПроверкаПроведенияПередПечатью;
		КомандаПечати.ТипыОбъектовПечати				= ОбщегоНазначенияБГУПовтИсп.СписокДокументовСДвижениямиПоРБ();
		ПервичныеДокументыБГУ.УстановитьСвойстваКомандыПечати(КомандаПечати, Ложь);
		
		// Бухгалтерская справка (52н)
		КомандаПечати									= КомандыПечати.Добавить();
		КомандаПечати.МенеджерПечати					= "Обработка.ПечатьБухгалтерскойСправки";
		КомандаПечати.Идентификатор						= "Справка0504833_52";
		КомандаПечати.Представление						= НСтр("ru = 'Справка ф. 0504833'");
		КомандаПечати.Порядок							= 98;
		КомандаПечати.ПроверкаПроведенияПередПечатью	= ПроверкаПроведенияПередПечатью;
		КомандаПечати.ТипыОбъектовПечати				= ОбщегоНазначенияБГУПовтИсп.СписокДокументовСДвижениямиПоРБ();
		ПервичныеДокументыБГУ.УстановитьСвойстваКомандыПечати(КомандаПечати, Ложь);
		
		// Бухгалтерская справка
		КомандаПечати									= КомандыПечати.Добавить();
		КомандаПечати.МенеджерПечати					= "Обработка.ПечатьБухгалтерскойСправки";
		КомандаПечати.Идентификатор						= "Справка0504833_173";
		КомандаПечати.Представление						= НСтр("ru = '(устарел) Справка ф. 0504833 (173н)'");
		КомандаПечати.Порядок							= 200;
		КомандаПечати.ПроверкаПроведенияПередПечатью	= ПроверкаПроведенияПередПечатью;
		КомандаПечати.ТипыОбъектовПечати				= ОбщегоНазначенияБГУПовтИсп.СписокДокументовСДвижениямиПоРБ();
		
	КонецЕсли;
	
КонецПроцедуры

// Добавляет команды печати движений документа
//
Процедура ДобавитьКомандыПечатиДвиженийДокумента(КомандыПечати, ИмяФормы = "") Экспорт
	
	ПроверкаПроведенияПередПечатью = Не ЗначениеЗаполнено(ИмяФормы)
		Или Не ФормаПринадлежитОбъекту(ИмяФормы, "ОперацияБух");
	
	// Движения документа
	КомандаПечати									= КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати					= "Отчет.ДвиженияДокумента";
	КомандаПечати.Идентификатор						= "ДвиженияДокумента";
	КомандаПечати.Представление						= НСтр("ru = 'Движения документа'");
	КомандаПечати.Порядок							= 99;
	КомандаПечати.ПроверкаПроведенияПередПечатью	= ПроверкаПроведенияПередПечатью;
	КомандаПечати.Обработчик						= "УправлениеПечатьюБГУКлиент.ДвиженияДокумента";
	КомандаПечати.ТипыОбъектовПечати				= ОбщегоНазначенияБГУПовтИсп.СписокДокументовСДвижениямиПоРНРС();
	
КонецПроцедуры

// Переопределяет список команд печати, получаемый функцией
//
Процедура ПередДобавлениемКомандПечати(ИмяФормы, КомандыПечати, СтандартнаяОбработка) Экспорт
	
	// Устаревший отчет, следует использовать отчет БСП
	//ДобавитьКомандыПечатиДвиженийДокумента(КомандыПечати, ИмяФормы);
	
	СоставИмениФормы = СтрРазделить(ИмяФормы, ".");
	
	Если СоставИмениФормы[0] = "ЖурналДокументов" И СоставИмениФормы[1] = "ЖурналОпераций" Тогда
		
		// В целях повышения производительности для Журнала операций оставляем печать только 
		// бухгалтерской справки
		СтандартнаяОбработка = Ложь;
		
		ДобавитьКомандыПечатиБухгалтерскойСправки(КомандыПечати, ИмяФормы);
		
	КонецЕсли;
	
КонецПроцедуры

//Определяет объекты, в которых есть процедура ДобавитьКомандыПечати()
//
Процедура ПриОпределенииОбъектовСКомандамиПечати(СписокОбъектов) Экспорт
	
	ИсключаемыеТипыДокументов = Метаданные.ОпределяемыеТипы.ОбъектыБезПроцедурПечатиВМенеджере.Тип;
	
	Для каждого Документ Из Метаданные.Документы Цикл
		
		Если ИсключаемыеТипыДокументов.СодержитТип(Тип("ДокументСсылка." + Документ.Имя)) Тогда
			Продолжить;
		КонецЕсли;
		
		СписокОбъектов.Добавить(Документы[Документ.Имя]);
		
	КонецЦикла;
	
	СписокОбъектов.Добавить(Справочники.ДоверенностиНалогоплательщика);
	СписокОбъектов.Добавить(Справочники.Договоры);
	СписокОбъектов.Добавить(Справочники.Контрагенты);
	СписокОбъектов.Добавить(Справочники.Организации);
	СписокОбъектов.Добавить(Справочники.ОсновныеСредства);
	СписокОбъектов.Добавить(Справочники.ПечатныеФормыВидовКартСведенийОбИмуществе);
	СписокОбъектов.Добавить(Справочники.Сотрудники);
	СписокОбъектов.Добавить(Справочники.Студенты);
	СписокОбъектов.Добавить(Справочники.ФизическиеЛица);
	СписокОбъектов.Добавить(Справочники.КарточкиКапвложений);
	
	// Интеграция ВЕТИС
	СписокОбъектов.Добавить(Справочники.ВетеринарноСопроводительныйДокументВЕТИС);
	СписокОбъектов.Добавить(Документы.ВходящаяТранспортнаяОперацияВЕТИС);
	СписокОбъектов.Добавить(Документы.ИнвентаризацияПродукцииВЕТИС);
	СписокОбъектов.Добавить(Документы.ИсходящаяТранспортнаяОперацияВЕТИС);
	СписокОбъектов.Добавить(Документы.ЗапросСкладскогоЖурналаВЕТИС);
	СписокОбъектов.Добавить(Документы.ПроизводственнаяОперацияВЕТИС);  
	
	// ИнтеграцияИСМП
	СписокОбъектов.Добавить(Документы.МаркировкаТоваровИСМП);
	СписокОбъектов.Добавить(Документы.ВыводИзОборотаИСМП);
	СписокОбъектов.Добавить(Документы.ЗаказНаЭмиссиюКодовМаркировкиСУЗ);
	СписокОбъектов.Добавить(Документы.ПеремаркировкаТоваровИСМП);
	СписокОбъектов.Добавить(Документы.СписаниеКодовМаркировкиИСМП);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ПроцессыОбработкиДокументов") Тогда
		МодульПроцессыОбработкиДокументов = ОбщегоНазначения.ОбщийМодуль("ПроцессыОбработкиДокументов");
		МодульПроцессыОбработкиДокументов.ПриОпределенииОбъектовСКомандамиПечати(СписокОбъектов);
	КонецЕсли;
	
КонецПроцедуры

// Вызывается после завершения вызова процедуры Печать менеджера печати объекта
//
Процедура ПриПечати(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ПроцессыОбработкиДокументов") Тогда
		МодульПроцессыОбработкиДокументов = ОбщегоНазначения.ОбщийМодуль("ПроцессыОбработкиДокументов");
		МодульПроцессыОбработкиДокументов.ПриПечати(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода);
	КонецЕсли;
	
	ВнутреннийЭДО.ПриПечати(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода);
	
КонецПроцедуры

// Переопределяет параметры отправки печатных форм при подготовке письма.
// Может использоваться, например, для подготовки текста письма.
//
// Параметры:
//  ПараметрыОтправки - Структура - коллекция параметров:
//   * Получатель - Массив - коллекция имен получателей;
//   * Тема - Строка - тема письма;
//   * Текст - Строка - текст письма;
//   * Вложения - Структура - коллекция вложений:
//    ** АдресВоВременномХранилище - Строка - адрес вложения во временном хранилище;
//    ** Представление - Строка - имя файла вложения.
//  ОбъектыПечати - Массив - коллекция объектов, по которым сформированы печатные формы.
//  ПараметрыВывода - Структура - параметр ПараметрыВывода в вызове процедуры Печать.
//  ПечатныеФормы - ТаблицаЗначений - коллекция табличных документов:
//   * Название - Строка - название печатной формы;
//   * ТабличныйДокумент - ТабличныйДокумент - печатая форма.
//
Процедура ПередОтправкойПоПочте(ПараметрыОтправки, ПараметрыВывода, ОбъектыПечати, ПечатныеФормы) Экспорт
	
	Если ОбъектыПечати.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ОбъектыПечати.Количество() > 0 Тогда 
		
		ОбщегоНазначенияБГУ.ЗаполнитьАдресаПередОтправкойПоПочте(ПараметрыОтправки.Получатель, ОбъектыПечати[0]);
		
		ПараметрыОтправки.Тема = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбъектыПечати[0], "Представление");
		
	КонецЕсли;
	
КонецПроцедуры

// Определяет набор подписей и печатей для документов.
//
// Параметры:
//  Документы      - Массив    - коллекция ссылок на объекты печати;
//  ПодписиИПечати - Соответствие - коллекция объектов печати и комплектов подписей/печатей к ним:
//   * Ключ     - ЛюбаяСсылка - ссылка на объект печати;
//   * Значение - Структура   - комплект подписей и печатей:
//     ** Ключ     - Строка - идентификатор подписи или печати в макете печатной формы, 
//                            должен начинаться с "Подпись...", "Печать..." или "Факсимиле...",
//                            например, "ПодписьРуководителя", "ПечатьОрганизации";
//     ** Значение - Картинка - изображение подписи или печати.
//
Процедура ПриПолученииПодписейИПечатей(Документы, ПодписиИПечати) Экспорт
	
	ДокументыПоТипам = Новый Соответствие;
	Для Каждого Документ Из Документы Цикл
		ТипДокумента = ТипЗнч(Документ);
		Если ДокументыПоТипам[ТипДокумента] = Неопределено Тогда
			ДокументыПоТипам[ТипДокумента] = Новый Массив;
		КонецЕсли;
		ДокументыПоТипам[ТипДокумента].Добавить(Документ);
	КонецЦикла;
	
	Печати 			= Новый Соответствие;
	Руководители  	= Новый Соответствие;
	ГлБухгалтеры	= Новый Соответствие;
	
	Для Каждого ДокументыПоТипу Из ДокументыПоТипам Цикл
		ТипДокумента = ДокументыПоТипу.Ключ;
		СписокДокументов = ДокументыПоТипу.Значение;
		
		ИмяРеквизитаГлавныйБухгалтер = "";
		ИмяРеквизитаРуководитель = "";
		СтрокаРеквизиты = "";
		
		РеквизитыДокумента = Метаданные.НайтиПоТипу(ТипДокумента).Реквизиты;
		
		Если РеквизитыДокумента.Найти("Организация") = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаРеквизиты = "Организация";
		
		Если НЕ РеквизитыДокумента.Найти("Руководитель") = Неопределено Тогда
			ИмяРеквизитаРуководитель = "Руководитель";
			СтрокаРеквизиты = СтрокаРеквизиты + ", " + ИмяРеквизитаРуководитель;
		КонецЕсли;
		
		Если НЕ РеквизитыДокумента.Найти("ГлавныйБухгалтер") = Неопределено Тогда
			ИмяРеквизитаГлавныйБухгалтер = "ГлавныйБухгалтер";
			СтрокаРеквизиты = СтрокаРеквизиты + ", " + ИмяРеквизитаГлавныйБухгалтер;
		ИначеЕсли НЕ РеквизитыДокумента.Найти("ГлБухгалтер") = Неопределено Тогда
			ИмяРеквизитаГлавныйБухгалтер = "ГлБухгалтер";
			СтрокаРеквизиты = СтрокаРеквизиты + ", " + ИмяРеквизитаГлавныйБухгалтер;
		КонецЕсли;
		
		ПодписиИПечатиВДокументах = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(СписокДокументов, СтрокаРеквизиты);
		
		Для Каждого ПодписиИПечатьВДокументе Из ПодписиИПечатиВДокументах Цикл
			
			Документ = ПодписиИПечатьВДокументе.Ключ;
			
			Организация 	= ПодписиИПечатьВДокументе.Значение.Организация;
			Если ЗначениеЗаполнено(ИмяРеквизитаРуководитель) Тогда
				Руководитель 	= ПодписиИПечатьВДокументе.Значение[ИмяРеквизитаРуководитель]; 
			КонецЕсли;	
			Если ЗначениеЗаполнено(ИмяРеквизитаГлавныйБухгалтер) Тогда	
				ГлБухгалтер 	= ПодписиИПечатьВДокументе.Значение[ИмяРеквизитаГлавныйБухгалтер];
			КонецЕсли;	
			
			ПодписиДокумента = Новый Структура;
			
			Печать = Печати[Организация];
			Если Печать = Неопределено Тогда
				Печать = ПечатьОрганизации(Организация);
				Печати.Вставить(Организация, Печать);
			КонецЕсли;
			ПодписиДокумента.Вставить("ПечатьОрганизации", Печать); 
			
			Если ЗначениеЗаполнено(ИмяРеквизитаРуководитель) Тогда
				ПодписьРук = Руководители[Руководитель];
				Если ПодписьРук = Неопределено Тогда
					ПодписьРук = ПодписьСотрудника(Руководитель);
					Руководители.Вставить(Руководитель, ПодписьРук);
				КонецЕсли;
				ПодписиДокумента.Вставить("ПодписьРуководителя", ПодписьРук); 
				ПодписиДокумента.Вставить("ФаксимилеРуководитель", ПодписьРук); //для счета-фактуры
			Иначе
				ПодписиДокумента.Вставить("ПодписьРуководителя", Новый Картинка); 
				ПодписиДокумента.Вставить("ФаксимилеРуководитель", Новый Картинка); //для счета-фактуры
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ИмяРеквизитаГлавныйБухгалтер) Тогда
				ПодписьБух = ГлБухгалтеры[ГлБухгалтер];
				Если ПодписьБух = Неопределено Тогда
					ПодписьБух = ПодписьСотрудника(ГлБухгалтер);
					ГлБухгалтеры.Вставить(ГлБухгалтер, ПодписьБух);
				КонецЕсли;
				ПодписиДокумента.Вставить("ПодписьГлавногоБухгалтера", ПодписьБух);
				ПодписиДокумента.Вставить("ФаксимилеГлавныйБухгалтер", ПодписьБух);
			Иначе
				ПодписиДокумента.Вставить("ПодписьГлавногоБухгалтера", Новый Картинка); 
				ПодписиДокумента.Вставить("ФаксимилеГлавныйБухгалтер", Новый Картинка);
			КонецЕсли;
			
			ПодписиДокумента.Вставить("ФаксимилеПредприниматель", Новый Картинка); //для счета-фактуры
			
			ПодписиИПечати.Вставить(Документ, ПодписиДокумента);
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

// см. УправлениеПечатьюПереопределяемый.ПечатьДокументовПриСозданииНаСервере
Процедура ПечатьДокументовПриСозданииНаСервере(Форма, Отказ, СтандартнаяОбработка) Экспорт
	
	ВнутреннийЭДО.ПечатьДокументовПриСозданииНаСервере(Форма, Отказ, СтандартнаяОбработка);
	
	РегистрыУчета.ПечатьДокументовПриСозданииНаСервере(Форма, Отказ, СтандартнаяОбработка);
	
КонецПроцедуры

#КонецОбласти

#Область СведенияОбУчреждении

// Заполняет параметры для макета заголовка печатных форм документов сведениями об учреждении, подразделении, учредителе и т.п.
//
// Параметры:
//	ЗначенияПараметров	- Структура	- в эту структуру будут добавлены новые значения
//	ДокументСсылка		- Ссылка на печатаемый документ
//	СведенияУчреждений	- Соответствие	- результат функции УправлениеПечатьюБГУ.ОбщиеСведенияДокументовДляПечати()
Процедура ЗаполнитьПараметрыСведенийУчреждения(ЗначенияПараметров, Знач ДокументСсылка, Знач СведенияУчреждений) Экспорт
	
	Сведения = СведенияУчреждений.Получить(ДокументСсылка);
	
	ЗначенияПараметров.Вставить("УчреждениеНаименование",					Сведения.НаименованиеОрганизации);
	ЗначенияПараметров.Вставить("УчреждениеКодПоРПБС",						Сведения.КодРПБС);
	ЗначенияПараметров.Вставить("ОбособленноеПодразделениеНаименование",	Сведения.НаименованиеОбособленногоПодразделения);
	ЗначенияПараметров.Вставить("ОбособленноеПодразделениеКодПоРПБС",		Сведения.КодРПБСОбособленногоПодразделения);
	ЗначенияПараметров.Вставить("СтруктурноеПодразделениеНаименование",		Сведения.СтруктурноеПодразделение);
	ЗначенияПараметров.Вставить("ГлаваНаименование",						Сведения.Учредитель);
	ЗначенияПараметров.Вставить("ГлаваКод",									Сведения.ГлаваБК);
	ЗначенияПараметров.Вставить("БюджетНаименование",						Сведения.БюджетНаименование);
	ЗначенияПараметров.Вставить("КодОКТМО",									Сведения.ОКТМО);
	
КонецПроцедуры

// Получает данные для заполнения шапки документов приказа 61н.
// Также получаются данные сотрудника из реквизита ОтветственныйИсполнитель, если он есть в документе.
// Структурное подразделение заполняется из данных сотрудника - ОтветственногоИсполнителя.
// 
// Параметры:
//  МассивОбъектов - Массив из ДокументСсылка
// 
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//  * Ключ - ДокументСсылка
//  * Значение - см. НовыйОбщиеСведенияДокументовДляПечати
Функция ОбщиеСведенияДокументовДляПечати(МассивОбъектов) Экспорт
	
	ДокументыПоТипам = ОбщегоНазначенияБГУ.ДокументыПоТипам(МассивОбъектов);
	
	ШаблонТекстаЗапроса =
	"ВЫБРАТЬ
	|	ТаблицаДокумент.Ссылка,
	|	ТаблицаДокумент.Дата,
	|	ТаблицаДокумент.Организация,
	|	ТаблицаДокумент.ИФО,
	|	ТаблицаДокумент.ОтветственныйИсполнитель КАК ОтветственныйИсполнитель,
	|	Сотрудники.Контрагент КАК ОтветственныйИсполнительКонтрагент
	|ИЗ
	|	#Документ КАК ТаблицаДокумент
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК Сотрудники
	|	ПО ТаблицаДокумент.ОтветственныйИсполнитель = Сотрудники.Ссылка
	|ГДЕ
	|	ТаблицаДокумент.Ссылка В (&МассивОбъектов)";
	ЧастиЗапроса = Новый Массив;
	Запрос = Новый Запрос;
	Индекс = 1;  
	ЕстУчетИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	Для Каждого КлючЗначение Из ДокументыПоТипам Цикл
		МетаданныеДокумента = Метаданные.НайтиПоТипу(КлючЗначение.Ключ);
		ИмяДокумента = МетаданныеДокумента.ПолноеИмя();
		Часть = СтрЗаменить(ШаблонТекстаЗапроса, "#Документ", ИмяДокумента);
		Часть = СтрЗаменить(Часть, "&МассивОбъектов", "&МассивОбъектов" + Индекс);
		ИмяРеквизитаОтветственногоИсполнителя = ИмяРеквизитаОтветственногоИсполнителя(КлючЗначение.Ключ);
		Если НЕ ОбщегоНазначения.ЕстьРеквизитОбъекта(ИмяРеквизитаОтветственногоИсполнителя, МетаданныеДокумента) Тогда
			Часть = СтрЗаменить(Часть, "ТаблицаДокумент.ОтветственныйИсполнитель", "NULL");
		Иначе
			Часть = СтрЗаменить(Часть, "ТаблицаДокумент.ОтветственныйИсполнитель", "ТаблицаДокумент."+ИмяРеквизитаОтветственногоИсполнителя);
		КонецЕсли; 
		Если НЕ ЕстУчетИФО ИЛИ НЕ ОбщегоНазначения.ЕстьРеквизитОбъекта("ИФО", МетаданныеДокумента) Тогда
			Часть = СтрЗаменить(Часть, "ТаблицаДокумент.ИФО", "NULL КАК ИФО");
		КонецЕсли;
		Запрос.УстановитьПараметр("МассивОбъектов" + Индекс, КлючЗначение.Значение);
		ЧастиЗапроса.Добавить(Часть);
		Индекс = Индекс + 1;
	КонецЦикла;
	
	ТекстЗапроса = СтрСоединить(ЧастиЗапроса, ОбщегоНазначенияБГУ.ТекстРазделителяОбъединенияЗапросов("ВСЕ"));
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
	ПервыйЗапрос = СхемаЗапроса.ПакетЗапросов[0];
	ПервыйЗапрос.ВыбиратьРазрешенные = Истина;
	ПервыйЗапрос.ТаблицаДляПомещения = "ВтОрганизацииДокументов";
	
	ТекстЗапроса = СхемаЗапроса.ПолучитьТекстЗапроса();
	
	ТекстЗапроса = ТекстЗапроса + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	ВтОрганизацииДокументов.Ссылка КАК Ссылка,
	|	МАКСИМУМ(ДанныеСотрудников.Период) КАК Период,
	|	ВтОрганизацииДокументов.ОтветственныйИсполнитель КАК ОтветственныйИсполнитель
	|ПОМЕСТИТЬ ИзмененияДанныхСотрудников
	|ИЗ
	|	ВтОрганизацииДокументов КАК ВтОрганизацииДокументов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеСотрудников КАК ДанныеСотрудников
	|		ПО ВтОрганизацииДокументов.ОтветственныйИсполнитель = ДанныеСотрудников.Сотрудник
	|			И ВтОрганизацииДокументов.Дата >= ДанныеСотрудников.Период
	|
	|СГРУППИРОВАТЬ ПО
	|	ВтОрганизацииДокументов.Ссылка,
	|	ВтОрганизацииДокументов.ОтветственныйИсполнитель
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИзмененияДанныхСотрудников.Ссылка КАК Ссылка,
	|	ДанныеСотрудников.Подразделение КАК Подразделение,
	|	ДанныеСотрудников.Должность КАК Должность
	|ПОМЕСТИТЬ ДанныеОтветственных
	|ИЗ
	|	ИзмененияДанныхСотрудников КАК ИзмененияДанныхСотрудников
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеСотрудников КАК ДанныеСотрудников
	|		ПО ИзмененияДанныхСотрудников.Период = ДанныеСотрудников.Период
	|			И ИзмененияДанныхСотрудников.ОтветственныйИсполнитель = ДанныеСотрудников.Сотрудник
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВтОрганизацииДокументов.ОтветственныйИсполнительКонтрагент КАК ОтветственныйИсполнительКонтрагент,
	|	ВЫРАЗИТЬ(Контрагенты.ЮридическоеФизическоеЛицо КАК Справочник.ФизическиеЛица) КАК ФизическоеЛицо,
	|	ВтОрганизацииДокументов.Ссылка КАК Ссылка,
	|	ВтОрганизацииДокументов.Дата КАК Дата
	|ПОМЕСТИТЬ ФизЛицаОтветственныхЛиц
	|ИЗ
	|	ВтОрганизацииДокументов КАК ВтОрганизацииДокументов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО ВтОрганизацииДокументов.ОтветственныйИсполнительКонтрагент = Контрагенты.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ФИОФизическихЛиц.Период) КАК Период,
	|	ФИОФизическихЛиц.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ФизЛицаОтветственныхЛиц.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ДатыИзмененияФИО
	|ИЗ
	|	ФизЛицаОтветственныхЛиц КАК ФизЛицаОтветственныхЛиц
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизическихЛиц КАК ФИОФизическихЛиц
	|		ПО ФизЛицаОтветственныхЛиц.ФизическоеЛицо = ФИОФизическихЛиц.ФизическоеЛицо
	|			И ФизЛицаОтветственныхЛиц.Дата >= ФИОФизическихЛиц.Период
	|
	|СГРУППИРОВАТЬ ПО
	|	ФизЛицаОтветственныхЛиц.Ссылка,
	|	ФИОФизическихЛиц.ФизическоеЛицо
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДатыИзмененияФИО.Ссылка КАК Ссылка,
	|	ФИОФизическихЛиц.Фамилия КАК Фамилия,
	|	ФИОФизическихЛиц.Имя КАК Имя,
	|	ФИОФизическихЛиц.Отчество КАК Отчество
	|ПОМЕСТИТЬ ФИООтветственных
	|ИЗ
	|	ДатыИзмененияФИО КАК ДатыИзмененияФИО
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизическихЛиц КАК ФИОФизическихЛиц
	|		ПО ДатыИзмененияФИО.ФизическоеЛицо = ФИОФизическихЛиц.ФизическоеЛицо
	|			И ДатыИзмененияФИО.Период = ФИОФизическихЛиц.Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВтОрганизацииДокументов.Ссылка КАК Ссылка,
	|	ЕСТЬNULL(ВтОрганизацииДокументов.ОтветственныйИсполнитель, ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)) КАК ОтветственныйИсполнитель,
	|	ЕСТЬNULL(Контрагенты.ЮридическоеФизическоеЛицо, ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)) КАК ОтветственныйИсполнительФизЛицо,
	|	ЕСТЬNULL(ДанныеОтветственных.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК ПодразделениеОтветственного,
	|	ВЫБОР
	|		КОГДА ДанныеОтветственных.Подразделение ЕСТЬ NULL
	|			ТОГДА """"
	|		КОГДА ДанныеОтветственных.Подразделение.НаименованиеПолное = """"
	|			ТОГДА ДанныеОтветственных.Подразделение.Наименование
	|		ИНАЧЕ ДанныеОтветственных.Подразделение.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеСтруктурногоПодразделения,
	|	ЕСТЬNULL(ДанныеОтветственных.Должность.Наименование, """") КАК ДолжностьОтветственногоКратко,
	|	ВЫБОР
	|		КОГДА ДанныеОтветственных.Должность ЕСТЬ NULL
	|			ТОГДА """"
	|		ИНАЧЕ ДанныеОтветственных.Должность.НаименованиеПолное
	|	КОНЕЦ КАК ДолжностьОтветственного,
	|	Организации.Ссылка КАК ОрганизацияИсточник,
	|	ВЫБОР
	|		КОГДА Организации.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|			ТОГДА Организации.Ссылка
	|		ИНАЧЕ Организации.ГоловнаяОрганизация
	|	КОНЕЦ КАК Организация,
	|	ВЫБОР
	|		КОГДА Организации.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|			ТОГДА ВЫБОР
	|					КОГДА Организации.НаименованиеПолное <> """"
	|						ТОГДА Организации.НаименованиеПолное
	|					ИНАЧЕ Организации.Наименование
	|				КОНЕЦ
	|		ИНАЧЕ ВЫБОР
	|				КОГДА Организации.ГоловнаяОрганизация.НаименованиеПолное <> """"
	|					ТОГДА Организации.ГоловнаяОрганизация.НаименованиеПолное
	|				ИНАЧЕ Организации.ГоловнаяОрганизация.Наименование
	|			КОНЕЦ
	|	КОНЕЦ КАК НаименованиеОрганизации,
	|	ВЫБОР
	|		КОГДА Организации.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
	|			ТОГДА Организации.ИНН
	|		ИНАЧЕ Организации.ГоловнаяОрганизация.ИНН
	|	КОНЕЦ КАК ИНН,
	|	ВЫБОР
	|		КОГДА Организации.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
	|			ТОГДА Организации.КПП
	|		ИНАЧЕ Организации.ГоловнаяОрганизация.КПП
	|	КОНЕЦ КАК КПП,
	|	ВЫБОР
	|		КОГДА Организации.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
	|			ТОГДА Организации.КодПоРПБС
	|		ИНАЧЕ Организации.ГоловнаяОрганизация.КодПоРПБС
	|	КОНЕЦ КАК КодРПБС,
	|	ВЫБОР
	|		КОГДА Организации.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
	|		ИНАЧЕ Организации.Ссылка
	|	КОНЕЦ КАК ОбособленноеПодразделение,
	|	ВЫБОР
	|		КОГДА Организации.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|			ТОГДА """"
	|		ИНАЧЕ ВЫБОР
	|				КОГДА Организации.НаименованиеПолное <> """"
	|					ТОГДА Организации.НаименованиеПолное
	|				ИНАЧЕ Организации.Наименование
	|			КОНЕЦ
	|	КОНЕЦ КАК НаименованиеОбособленногоПодразделения,
	|	ВЫБОР
	|		КОГДА Организации.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Организации.Пустаяссылка)
	|			ТОГДА """"
	|		ИНАЧЕ Организации.КодПоРПБС
	|	КОНЕЦ КАК КодРПБСОбособленногоПодразделения,
	|	ВЫБОР
	|		КОГДА НЕ ИстФО.Ссылка ЕСТЬ NULL
	|				И ИстФО.ИспользоватьРеквизитыИФО
	|			ТОГДА ЕСТЬNULL(ИстФО.КодГлавыБК.Код, """")
	|		ИНАЧЕ ЕСТЬNULL(Организации.КодПоППП.Код, """")
	|	КОНЕЦ КАК ГлаваБК,
	|	ВЫБОР
	|		КОГДА НЕ ИстФО.Ссылка ЕСТЬ NULL
	|				И ИстФО.ИспользоватьРеквизитыИФО
	|			ТОГДА ЕСТЬNULL(ИстФО.КодГлавыБК.НаименованиеПолное, """")
	|		ИНАЧЕ ЕСТЬNULL(Организации.КодПоППП.НаименованиеПолное, """")
	|	КОНЕЦ КАК Учредитель,
	|	ВЫБОР
	|		КОГДА НЕ ИстФО.Ссылка ЕСТЬ NULL
	|				И ИстФО.ИспользоватьРеквизитыИФО
	|			ТОГДА ЕСТЬNULL(ИстФО.Бюджет.НаименованиеПолное, """")
	|		ИНАЧЕ ЕСТЬNULL(Организации.Бюджет.НаименованиеПолное, """")
	|	КОНЕЦ КАК БюджетНаименование,
	|	ВЫБОР
	|		КОГДА НЕ ИстФО.Ссылка ЕСТЬ NULL
	|				И ИстФО.ИспользоватьРеквизитыИФО
	|			ТОГДА ЕСТЬNULL(ИстФО.Бюджет.Код, """")
	|		ИНАЧЕ ЕСТЬNULL(Организации.Бюджет.Код, """")
	|	КОНЕЦ КАК ОКТМО,
	|	ВЫБОР
	|		КОГДА НЕ ИстФО.Ссылка ЕСТЬ NULL
	|				И ИстФО.ИспользоватьРеквизитыИФО
	|			ТОГДА ЕСТЬNULL(ИстФО.Бюджет.НаименованиеПубличноПравовогоОбразования, """")
	|		ИНАЧЕ ЕСТЬNULL(Организации.Бюджет.НаименованиеПубличноПравовогоОбразования, """")
	|	КОНЕЦ КАК УчредительППО,
	|	ФИООтветственных.Фамилия КАК Фамилия,
	|	ФИООтветственных.Имя КАК Имя,
	|	ФИООтветственных.Отчество КАК Отчество
	|ИЗ
	|	ВтОрганизацииДокументов КАК ВтОрганизацииДокументов
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДанныеОтветственных КАК ДанныеОтветственных
	|		ПО ВтОрганизацииДокументов.Ссылка = ДанныеОтветственных.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|		ПО ВтОрганизацииДокументов.Организация = Организации.Ссылка 
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИсточникиФинансовогоОбеспечения КАК ИстФО
	|		ПО ВтОрганизацииДокументов.ИФО = ИстФО.Ссылка 
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО ВтОрганизацииДокументов.ОтветственныйИсполнительКонтрагент = Контрагенты.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ФИООтветственных КАК ФИООтветственных
	|		ПО ВтОрганизацииДокументов.Ссылка = ФИООтветственных.Ссылка";

	Запрос.Текст = ТекстЗапроса;
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	ВсеОрганизации = ОбщегоНазначения.ВыгрузитьКолонку(РезультатЗапроса, "ОрганизацияИсточник", Истина);
	ВидыКИОрганизаций = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);
	КИОрганизаций = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъектов(ВсеОрганизации, , ВидыКИОрганизаций);
	КИОрганизаций.Индексы.Добавить("Объект");
	ОтборОрганизация = Новый Структура("Объект", Справочники.Организации.ПустаяСсылка());
	
	ВсеФизЛица = ОбщегоНазначения.ВыгрузитьКолонку(РезультатЗапроса, "ОтветственныйИсполнительФизЛицо", Истина);
	ВидыКИФизЛиц = Новый Массив;
	ВидыКИФизЛиц.Добавить(Справочники.ВидыКонтактнойИнформации.ТелефонРабочийФизическиеЛица); 
	ВидыКИФизЛиц.Добавить(Справочники.ВидыКонтактнойИнформации.EmailФизическиеЛица); 
	КИФизЛиц = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъектов(ВсеФизЛица, , ВидыКИФизЛиц);
	КИФизЛиц.Индексы.Добавить("Объект, Вид");
	ОтборТелефон = Новый Структура("Объект, Вид",
		Справочники.Организации.ПустаяСсылка(), Справочники.ВидыКонтактнойИнформации.ТелефонРабочийФизическиеЛица);
	ОтборПочта = Новый Структура("Объект, Вид",
		Справочники.Организации.ПустаяСсылка(), Справочники.ВидыКонтактнойИнформации.EmailФизическиеЛица);
	
	Результат = Новый Соответствие;
	Для Каждого Выборка Из РезультатЗапроса Цикл
		ДанныеОрганизации = НовыйОбщиеСведенияДокументовДляПечати();
		
		ДанныеОрганизации.Организация = Выборка.Организация;
		ДанныеОрганизации.НаименованиеОрганизации = Выборка.НаименованиеОрганизации;
		ДанныеОрганизации.ИНН = Выборка.ИНН;
		ДанныеОрганизации.КПП = Выборка.КПП;
        ОтборОрганизация.Объект = Выборка.ОрганизацияИсточник;
		СтрокиКИ = КИОрганизаций.НайтиСтроки(ОтборОрганизация);
		Если СтрокиКИ.Количество() > 0 Тогда
			ДанныеОрганизации.ЮридическийАдресОрганизации = СтрокиКИ[0].Представление;
		КонецЕсли;
		ДанныеОрганизации.КодРПБС = Выборка.КодРПБС;
		ДанныеОрганизации.НаименованиеОбособленногоПодразделения = Выборка.НаименованиеОбособленногоПодразделения;
        ДанныеОрганизации.КодРПБСОбособленногоПодразделения = Выборка.КодРПБСОбособленногоПодразделения;
        ДанныеОрганизации.ГлаваБК = Выборка.ГлаваБК;
        ДанныеОрганизации.Учредитель = Выборка.Учредитель;
        ДанныеОрганизации.УчредительППО = Выборка.УчредительППО;
		
        ДанныеОрганизации.БюджетНаименование = Выборка.БюджетНаименование;
        ДанныеОрганизации.ОКТМО = Выборка.ОКТМО;

		ДанныеОрганизации.ОтветственныйИсполнитель = Выборка.ОтветственныйИсполнитель;
		Если ЗначениеЗаполнено(Выборка.ДолжностьОтветственного) Тогда
			ДанныеОрганизации.ОтветственныйДолжность = Выборка.ДолжностьОтветственного; 
		Иначе
			ДанныеОрганизации.ОтветственныйДолжность = Выборка.ДолжностьОтветственногоКратко; 
		КонецЕсли;
		ДанныеОрганизации.ОтветственныйДолжностьКратко = Выборка.ДолжностьОтветственногоКратко;	
		ДанныеОрганизации.ОтветственныйФИО = СтрСоединить(ОбщегоНазначенияБГУ.Массив(Выборка.Фамилия, Выборка.Имя, Выборка.Отчество), " "); 
		ДанныеОрганизации.ОтветственныйФамилияИнициалы = КорреспондентыКлиентСервер.ФИО(Новый Структура("Фамилия, Имя, Отчество", 
														 Выборка.Фамилия, Выборка.Имя, Выборка.Отчество));					
        ОтборТелефон.Объект = Выборка.ОтветственныйИсполнительФизЛицо;
		СтрокиКИ = КИФизЛиц.НайтиСтроки(ОтборТелефон);
		Если СтрокиКИ.Количество() > 0 Тогда
			ДанныеОрганизации.ОтветственныйТелефон = СтрокиКИ[0].Представление;
		КонецЕсли;
		
		ОтборПочта.Объект = Выборка.ОтветственныйИсполнительФизЛицо;
		СтрокиКИ = КИФизЛиц.НайтиСтроки(ОтборПочта);
		Если СтрокиКИ.Количество() > 0 Тогда
			ДанныеОрганизации.ОтветственныйЭлПочта = СтрокиКИ[0].Представление;
		КонецЕсли;
										
		ДанныеОрганизации.СтруктурноеПодразделение = Выборка.ПодразделениеОтветственного;
		ДанныеОрганизации.НаименованиеСтруктурногоПодразделения = СокрЛП(Выборка.НаименованиеСтруктурногоПодразделения);
				
		Результат.Вставить(Выборка.Ссылка, ДанныеОрганизации);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ИмяРеквизитаОтветственногоИсполнителя(ТипДокумента)
	
	ИмяРеквизита = "ОтветственныйИсполнитель";
	
	Если ТипДокумента = Тип("ДокументСсылка.ЗаявкаОбоснованиеЗакупкиМалогоОбъемаЧерезПодотчетноеЛицо") Тогда
		ИмяРеквизита = "ПодотчетноеЛицо";
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ОтчетОРасходахПодотчетногоЛица") Тогда
		ИмяРеквизита = "Сотрудник";
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьБСО")
		Или ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьНаличныхСредств")
		Или ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьНФА")
		Или ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьОстатковНаСчетах")
		Или ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьРасчетовПоПоступлениям")
		Или ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьГосДолгаВЦенныхБумагах")
		Или ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьГосДолгаПоПредоставленнымГарантиям")
		Или ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам")
		Или ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьЦенныхБумаг") Тогда
		ИмяРеквизита = "ОтветственныйИсполнительБухгалтерскойСлужбы";
	КонецЕсли;
	
	Возврат ИмяРеквизита;
	
КонецФункции

#КонецОбласти

#Область ПечатьРезультатовГолосования

Процедура ЗаполнитьПараметрыИтоговГолосованияПриПечати(ЗначенияПараметров, Знач ИдентификаторСтроки, Знач РезультатыГолосования) Экспорт
	
	Перем	ИтогГолосования,
			РезолюцияПоИтогуГолосования;
	
	Поиск = Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки);
	
	МассивСтрок = РезультатыГолосования.НайтиСтроки(Поиск);
	
	Если МассивСтрок.Количество() > 0
		И МассивСтрок[0].ГолосованиеПоСтрокеЗавершено Тогда
		
		ПерваяСтрока = МассивСтрок[0];
		
		ИтогГолосования = ПерваяСтрока.ИтогГолосования;
		
		Если ПерваяСтрока.РезолюцияКомиссииОдобрена Тогда
			РезолюцияПоИтогуГолосования = "";
		Иначе
			РезолюцияПоИтогуГолосования = НСтр("ru = 'снято с обсуждения'");
		КонецЕсли;
		
	Иначе
		// Результаты голосования по строке документа не найдены.
		
		ИтогГолосования = 0;
		
		РезолюцияПоИтогуГолосования = "";
		
	КонецЕсли;
	
	ЗначенияПараметров.Вставить("ИтогГолосования",				ИтогГолосования);
	ЗначенияПараметров.Вставить("РезолюцияПоИтогуГолосования",	РезолюцияПоИтогуГолосования);
	
КонецПроцедуры

Процедура ВывестиПриложенияПриПечати(ТабДокумент, Знач ДокументСсылка, Знач ОбластьМакетаПриложение) Экспорт
	
	Файлы = УправлениеПечатьюБГУ.ПолучитьСписокФайловДокумента(ДокументСсылка);
	
	Для Каждого Приложение Из Файлы Цикл
		
		ОбластьМакетаПриложение.Параметры.Заполнить(Приложение);
		
		ТабДокумент.Вывести(ОбластьМакетаПриложение);
		
	КонецЦикла;
	
КонецПроцедуры

// Параметры:
//	ТабДокумент					- ТабличныйДокумент	- заполняемый табличный документ.
//	ДокументСсылка				- ДокументСсылка	- печатаемый документ.
//	ОбластьМакетаЧленКомиссии	- ТабличныйДокумент	- заполняемая область макета для одного члена комиссии.
//	СоставКомиссий				- ТаблицаЗначений	- общая таблица состава комиссий всех печатаемых документов.
//		Результат функции ОбщегоНазначенияБГУ.СоставКомиссийПоДокументам(МассивОбъектов).
//	ПараметрыВывода				- Структура			- результат функции ПараметрыВыводаСоставаКомиссииПриПечати().
Процедура ВывестиСоставКомиссииПриПечати(ТабДокумент, Знач ДокументСсылка, Знач ОбластьМакетаЧленКомиссии, Знач СоставКомиссий, Знач ПараметрыВывода = Неопределено) Экспорт
	
	Если СоставКомиссий.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ПараметрыВывода = Неопределено Тогда
		ПараметрыВывода = ПараметрыВыводаСоставаКомиссииПриПечати();
	КонецЕсли;
	
	// ПРЕДСЕДАТЕЛЬ
	
	ОтборСтрок = Новый Структура("Ссылка,Председатель", ДокументСсылка, Истина);
	
	ВывестиМассивСтрокСоставаКомисииПриПечати(ТабДокумент, СоставКомиссий, ОбластьМакетаЧленКомиссии, ОтборСтрок, ПараметрыВывода.ЗаголовокПредседателя,, ПараметрыВывода);
	
	// УПОЛНОМОЧЕННЫЕ ПРЕДСЕДАТЕЛЕМ ЛИЦА
	
	Если ПараметрыВывода.ПризнакРабочейКомиссии Тогда
		ОтборСтрок = Новый Структура("Ссылка,Председатель,УполномоченноеПредседателемЛицо", ДокументСсылка, Ложь, Истина);
		
		ВывестиМассивСтрокСоставаКомисииПриПечати(ТабДокумент, СоставКомиссий, ОбластьМакетаЧленКомиссии, ОтборСтрок, ПараметрыВывода.ЗаголовокУполномоченногоЛица,, ПараметрыВывода);
	КонецЕсли;
	
	// РЯДОВЫЕ ЧЛЕНЫ КОМИССИИ
	
	Если ПараметрыВывода.ПризнакРабочейКомиссии Тогда
		ОтборСтрок = Новый Структура("Ссылка,Председатель,УполномоченноеПредседателемЛицо", ДокументСсылка, Ложь, Ложь);
	Иначе
		ОтборСтрок = Новый Структура("Ссылка,Председатель", ДокументСсылка, Ложь);
	КонецЕсли;
	
	ВывестиМассивСтрокСоставаКомисииПриПечати(ТабДокумент, СоставКомиссий, ОбластьМакетаЧленКомиссии, ОтборСтрок, ПараметрыВывода.ЗаголовокПервогоРядовогоЧлена, ПараметрыВывода.ЗаголовокПоследующихРядовыхЧленов, ПараметрыВывода);
	
КонецПроцедуры

Функция ПараметрыВыводаСоставаКомиссииПриПечати() Экспорт
	
	ПараметрыВывода = Новый Структура();
	ПараметрыВывода.Вставить("ЗаголовокПредседателя",				НСтр("ru='Председатель комиссии'"));
	ПараметрыВывода.Вставить("ЗаголовокПервогоРядовогоЧлена",		НСтр("ru='Члены комиссии'"));
	ПараметрыВывода.Вставить("ЗаголовокПоследующихРядовыхЧленов",	НСтр("ru=''"));
	ПараметрыВывода.Вставить("ЗаголовокУполномоченногоЛица",		НСтр("ru='Уполномоченное председателем лицо'"));
	ПараметрыВывода.Вставить("ПризнакРабочейКомиссии",				Ложь);
	
	НастройкиДополнительныхСведений = Новый Структура();
	НастройкиДополнительныхСведений.Вставить("ВыводитьПричинуОтсутствия", Ложь);
	НастройкиДополнительныхСведений.Вставить("ВыводитьЗамещающегоСотрудника", Ложь);
	
	ПараметрыВывода.Вставить("ВыводитьДополнительныеСведения",	Ложь);
	ПараметрыВывода.Вставить("НастройкиДополнительныхСведений",	НастройкиДополнительныхСведений);
	
	Возврат ПараметрыВывода;
	
КонецФункции

Процедура ВывестиМассивСтрокСоставаКомисииПриПечати(ТабДокумент, СоставКомиссий, ОбластьМакетаЧленКомиссии, ОтборСтрок, Заголовок1, Заголовок2иДалее = Неопределено, ПараметрыВывода)
	
	МассивСтрок = СоставКомиссий.НайтиСтроки(ОтборСтрок);
	
	ЗначенияПараметров = Новый Структура();
	
	ПерваяСтрока = Истина;
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		Заголовок = ?(ПерваяСтрока Или Заголовок2иДалее = Неопределено, Заголовок1, Заголовок2иДалее);
		
		ФИО = КорреспондентыКлиентСервер.ФИО(СтрокаТаблицы, Истина);
		
		ЗначенияПараметров.Вставить("Заголовок",				Заголовок);
		ЗначенияПараметров.Вставить("ДолжностьЧленаКомиссии",	СтрокаТаблицы.Должность);
		ЗначенияПараметров.Вставить("ФИОЧленаКомиссии",			ФИО);
		ЗначенияПараметров.Вставить("ФИО",						ФИО);
		
		Если ПараметрыВывода.ВыводитьДополнительныеСведения Тогда
			ЗаполнитьДополнительныеСведенияВСтрокеЧленаКомиссииПриПечати(ЗначенияПараметров, СтрокаТаблицы, ПараметрыВывода);
		КонецЕсли;
		
		ОбластьМакетаЧленКомиссии.Параметры.Заполнить(СтрокаТаблицы);
		ОбластьМакетаЧленКомиссии.Параметры.Заполнить(ЗначенияПараметров);
		
		Если Не ТабДокумент.ПроверитьВывод(ОбластьМакетаЧленКомиссии) Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ТабДокумент.Вывести(ОбластьМакетаЧленКомиссии);
		
		ПерваяСтрока = Ложь;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьДополнительныеСведенияВСтрокеЧленаКомиссииПриПечати(ЗначенияПараметров, СтрокаТаблицы, ПараметрыВывода)
	
	НастройкиДополнительныхСведений = ПараметрыВывода.НастройкиДополнительныхСведений;
	
	МассивСведений = Новый Массив();
	
	Если СтрокаТаблицы.Отсутствует И НастройкиДополнительныхСведений.ВыводитьПричинуОтсутствия Тогда
		МассивСведений.Добавить(СтрШаблон(НСтр("ru='Отсутствует (%1)'"), СтрокаТаблицы.ПричинаОтсутствия));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаТаблицы.ЗамещающийСотрудник) И НастройкиДополнительныхСведений.ВыводитьЗамещающегоСотрудника Тогда
		ЗамещающийСотрудникФИО = КорреспондентыКлиентСервер.ФИО(СтрокаТаблицы, Истина, "ЗамещающийСотрудник");
		
		МассивСведений.Добавить(СтрШаблон(НСтр("ru='Замещает %1 %2'"), СтрокаТаблицы.ЗамещающийСотрудникДолжность, ЗамещающийСотрудникФИО));
	КонецЕсли;
	
	ЗначенияПараметров.Вставить("ДополнительныеСведения", СтрСоединить(МассивСведений, ", "));
	
КонецПроцедуры

#КонецОбласти

#Область ОбщиеТаблицыДанныхПечатиФорм61н

// Таблица файлы для печати (приказ 61н).
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Таблица файлы для печати (приказ 61н):
// * ИмяФайла - Строка -
