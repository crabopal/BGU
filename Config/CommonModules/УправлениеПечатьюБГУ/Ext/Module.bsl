	|ИТОГИ ПО
	|	Ссылка,
	|	КФО,
	|	КодГруппыНФА";
	
	Данные = Запрос.ВыполнитьПакет();
	
	ВыборкаДокументов	= Данные[2].Выбрать();
	ВыборкаНФА			= Данные[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Результат = ТаблицаШапкиДляПечатиНакладнаяНаВнутреннееПеремещениеНФА0510450();
	
	Пока ВыборкаДокументов.Следующий() Цикл
		
		СтрокаДокумента = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДокумента, ВыборкаДокументов);
		СтрокаДокумента.ГруппыНФА = ТаблицаГруппыПередаваемыхОбъектовНакладнаяНаВнутреннееПеремещениеНФА0510450();

		// Адреса подразделений получателя и отправителя
		СтрокаДокумента.НаименованиеПодразделенияОтправителя = ПредставлениеПодразделенияДля0510450(
				СтрокаДокумента.НаименованиеПодразделенияОтправителя, ВыборкаДокументов.МестоХраненияОтправитель);
		СтрокаДокумента.НаименованиеПодразделенияПолучателя = ПредставлениеПодразделенияДля0510450(
				СтрокаДокумента.НаименованиеПодразделенияПолучателя, ВыборкаДокументов.МестоХраненияПолучатель);

		// Данные о сотрудниках
		ПоляСотрудника = "СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность, ДолжностьНаименование";
		ДанныеОтправителя = Новый Структура(ПоляСотрудника, ВыборкаДокументов.Отправитель, ВыборкаДокументов.Дата);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеОтправителя);
		ДанныеПолучателя = Новый Структура(ПоляСотрудника, ВыборкаДокументов.Получатель, ВыборкаДокументов.Дата);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеПолучателя);
		
		СтрокаДокумента.НомерАкта = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(
			ВыборкаДокументов.Ссылка, ВыборкаДокументов.Номер);
		СтрокаДокумента.ДатаАкта = ВыборкаДокументов.Дата;
		СтрокаДокумента.ФИООтправителя = КорреспондентыКлиентСервер.ФИО(ДанныеОтправителя,,, Ложь, Истина);
		СтрокаДокумента.ФИОПолучателя = КорреспондентыКлиентСервер.ФИО(ДанныеПолучателя ,,, Ложь, Истина);
		
		// Таблица
		СтруктураПоиска = Новый Структура("Ссылка", ВыборкаДокументов.Ссылка);
		ВыборкаНФА.Сбросить();
		Если ВыборкаНФА.НайтиСледующий(СтруктураПоиска) Тогда
			ВыборкаКФО = ВыборкаНФА.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаКФО.Следующий() Цикл
				// Выборка по КФО
				ВыборкаГруппа = ВыборкаКФО.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Пока ВыборкаГруппа.Следующий() Цикл
					// Выборка по Счету-группе
					СтрокаГруппы = СтрокаДокумента.ГруппыНФА.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаГруппы, ВыборкаГруппа);
					СтрокаГруппы.КодГруппыНФА = "" + ВыборкаГруппа.КФО + "." + СтрокаГруппы.КодГруппыНФА; 
					СтрокаГруппы.Состав = ТаблицаСоставПередаваемыхОбъектовНакладнаяНаВнутреннееПеремещениеНФА0510450();
					
					ВыборкаСтрока = ВыборкаГруппа.Выбрать();
					Пока ВыборкаСтрока.Следующий() Цикл
						СтрокаНФА = СтрокаГруппы.Состав.Добавить();
						ЗаполнитьЗначенияСвойств(СтрокаНФА, ВыборкаСтрока);
					КонецЦикла;
				
				КонецЦикла;
				
			КонецЦикла;
		Иначе
			СтрокаГруппы = СтрокаДокумента.ГруппыНФА.Добавить();
			СтрокаГруппы.Состав = ТаблицаСоставПередаваемыхОбъектовНакладнаяНаВнутреннееПеремещениеНФА0510450();
		КонецЕсли;
		
		// ЦМО
		СтрокаДокумента.НаименованиеДолжностиОтправителя = ДанныеОтправителя.ДолжностьНаименование;
		СтрокаДокумента.ДолжностьОтправителя = ДанныеОтправителя.Должность;
		СтрокаДокумента.ФИООтправителяРасшифровка = КорреспондентыКлиентСервер.ФИО(ДанныеОтправителя);
		СтрокаДокумента.Отправитель = ВыборкаДокументов.Отправитель;
		СтрокаДокумента.НаименованиеДолжностиПолучателя = ДанныеПолучателя.ДолжностьНаименование;
		СтрокаДокумента.ДолжностьПолучателя = ДанныеПолучателя.Должность;
		СтрокаДокумента.ФИОПолучателяРасшифровка = КорреспондентыКлиентСервер.ФИО(ДанныеПолучателя);
		СтрокаДокумента.Получатель = ВыборкаДокументов.Получатель;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Данные документов по учету МЗ для печати формы Накладная на внутреннее перемещение НФА (0510450).
// 
// Параметры:
//  МассивОбъектов - Массив из ДокументСсылка
// 
// Возвращаемое значение:
//   см. ТаблицаШапкиДляПечатиНакладнаяНаВнутреннееПеремещениеНФА0510450
Функция ДанныеДляПечати0510450_МЗ(МассивОбъектов)
	ДанныеГруппНФА = ГруппыОбъектовНФА();
	РезультатЗапроса = ЗапросДляПечатиТребованияНакладной0510451(МассивОбъектов);
	ВыборкаДокументов = РезультатЗапроса.ДанныеШапки;

	ДвиженияДокументов = УправлениеМатериальнымиЗапасами.ДвиженияДокументов(МассивОбъектов);
	ДвиженияДокументов.Индексы.Добавить("Ссылка, НомерСтроки");

	Результат = ТаблицаШапкиДляПечатиНакладнаяНаВнутреннееПеремещениеНФА0510450();
	НеобязательныеРеквизиты = Новый Структура;
	НеобязательныеРеквизиты.Вставить("НомерНоменклатурный");
	НеобязательныеРеквизиты.Вставить("НФАДопНаименование");
	НеобязательныеРеквизиты.Вставить("СерияБСО");
	НеобязательныеРеквизиты.Вставить("НомерНачальный");
	НеобязательныеРеквизиты.Вставить("НомерКонечный");
	НеобязательныеРеквизиты.Вставить("ТипНоменклатуры");
	
	Пока ВыборкаДокументов.Следующий() Цикл
		
		СтрокаДокумента = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДокумента, ВыборкаДокументов);
		СтрокаДокумента.ГруппыНФА = ТаблицаГруппыПередаваемыхОбъектовНакладнаяНаВнутреннееПеремещениеНФА0510450();

		СтрокаДокумента.НомерАкта = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(
			ВыборкаДокументов.Ссылка, ВыборкаДокументов.Номер);
		СтрокаДокумента.ДатаАкта = ВыборкаДокументов.Дата;

		// Данные о сотрудниках
		ПоляСотрудника = "СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность, ДолжностьНаименование, ДолжностьНаименованиеПолное, Код";
		СотрудникиДокумента = Новый Массив;
		СотрудникиДокумента.Добавить(ВыборкаДокументов.СотрудникОтправитель);
		СотрудникиДокумента.Добавить(ВыборкаДокументов.СотрудникПолучатель);
		ДанныеСотрудников = Справочники.Сотрудники.ДанныеСотрудников(СотрудникиДокумента, ПоляСотрудника, ВыборкаДокументов.Дата);
		ДанныеОтправителя = ДанныеСотрудников.Получить(ВыборкаДокументов.СотрудникОтправитель);
		ДанныеПолучателя = ДанныеСотрудников.Получить(ВыборкаДокументов.СотрудникПолучатель);
		
		СтрокаДокумента.ФИООтправителя = КорреспондентыКлиентСервер.ФИО(ДанныеОтправителя,,, Ложь, Истина);
		СтрокаДокумента.ФИОПолучателя = КорреспондентыКлиентСервер.ФИО(ДанныеПолучателя ,,, Ложь, Истина);
		СтрокаДокумента.ТабНомОтправитель = ДанныеОтправителя.Код;
		СтрокаДокумента.ТабНомПолучатель = ДанныеПолучателя.Код;

		// Адреса подразделений получателя и отправителя
		СтрокаДокумента.НаименованиеПодразделенияОтправителя = ПредставлениеПодразделенияДля0510450(
				ВыборкаДокументов.НаименованиеОтправитель, ВыборкаДокументов.МестоХраненияОтправитель);
		СтрокаДокумента.НаименованиеПодразделенияПолучателя = ПредставлениеПодразделенияДля0510450(
				ВыборкаДокументов.НаименованиеПолучатель, ВыборкаДокументов.МестоХраненияПолучатель);

		Если ЗначениеЗаполнено(ДанныеОтправителя.ДолжностьНаименованиеПолное) Тогда
			СтрокаДокумента.НаименованиеДолжностиОтправителя = ДанныеОтправителя.ДолжностьНаименованиеПолное;
		Иначе
			СтрокаДокумента.НаименованиеДолжностиОтправителя = ДанныеОтправителя.ДолжностьНаименование;
		КонецЕсли;
		СтрокаДокумента.ДолжностьОтправителя = ДанныеОтправителя.Должность;
		СтрокаДокумента.ФИООтправителяРасшифровка = КорреспондентыКлиентСервер.ФИО(ДанныеОтправителя);
		СтрокаДокумента.Отправитель = ВыборкаДокументов.СотрудникОтправитель;
		Если ЗначениеЗаполнено(ДанныеПолучателя.ДолжностьНаименованиеПолное) Тогда
			СтрокаДокумента.НаименованиеДолжностиПолучателя = ДанныеПолучателя.ДолжностьНаименованиеПолное;
		Иначе
			СтрокаДокумента.НаименованиеДолжностиПолучателя = ДанныеПолучателя.ДолжностьНаименование;
		КонецЕсли;
		СтрокаДокумента.ДолжностьПолучателя = ДанныеПолучателя.Должность;
		СтрокаДокумента.ФИОПолучателяРасшифровка = КорреспондентыКлиентСервер.ФИО(ДанныеПолучателя);
		СтрокаДокумента.Получатель = ВыборкаДокументов.СотрудникПолучатель;
		
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ВыборкаДокументов, "ДокументОснование") Тогда
			СтрокаДокумента.Основание = ВыборкаДокументов.ДокументОснование;
		КонецЕсли;
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ВыборкаДокументов, "ДокументОснованиеНомер") Тогда
			СтрокаДокумента.ОснованиеНомер = ВыборкаДокументов.ДокументОснованиеНомер;
		КонецЕсли;
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ВыборкаДокументов, "ДокументОснованиеДата") Тогда
			СтрокаДокумента.ОснованиеДата = ВыборкаДокументов.ДокументОснованиеДата;
		КонецЕсли;
		
		// Таблица
		ТабличныеЧасти = РезультатЗапроса.ДанныеТабличныхЧастей.Получить(ТипЗнч(ВыборкаДокументов.Ссылка));
		
		ТабличныеЧасти.Сбросить();
		Если ТабличныеЧасти.НайтиСледующий(Новый Структура("Ссылка", ВыборкаДокументов.Ссылка)) Тогда
			СтрокиДокумента = ТабличныеЧасти.Выбрать();
		Иначе
			СтрокиДокумента = Неопределено;
		КонецЕсли;
	
		СтрокиНФАПоГруппам = Новый Соответствие;
		ИспользуемыеГруппы = Новый ТаблицаЗначений;
		ИспользуемыеГруппы.Колонки.Добавить("КодГруппы", Новый ОписаниеТипов("Строка"));
		ИспользуемыеГруппы.Колонки.Добавить("ПорядокСчета", Новый ОписаниеТипов("Строка"));
		
		Пока СтрокиДокумента <> Неопределено И СтрокиДокумента.Следующий() Цикл
			
			КодГрупповогоСчета = Строка(СтрокиДокумента.КФО);
			ТекущаяГруппаНФА = ДанныеГруппНФА.Получить(СтрокиДокумента.СчетУчета);
			Если ТекущаяГруппаНФА <> Неопределено Тогда
				КодГрупповогоСчета = КодГрупповогоСчета + "." + ТекущаяГруппаНФА.Код;
			КонецЕсли;
			
			ГруппировочнаяСтрока = СтрокиНФАПоГруппам.Получить(КодГрупповогоСчета);
			Если ГруппировочнаяСтрока = Неопределено Тогда
				ЗаголовокТабличнойЧасти = СтрокаДокумента.ГруппыНФА.Добавить();
				ЗаголовокТабличнойЧасти.Состав = ТаблицаСоставПередаваемыхОбъектовНакладнаяНаВнутреннееПеремещениеНФА0510450();
				СтрокаИспользуемыхГрупп = ИспользуемыеГруппы.Добавить();
				СтрокаИспользуемыхГрупп.КодГруппы = КодГрупповогоСчета;
				Если ТекущаяГруппаНФА <> Неопределено Тогда
					ЗаголовокТабличнойЧасти.КодГруппыНФА = КодГрупповогоСчета;
					ЗаголовокТабличнойЧасти.ГруппаНФА    = ТекущаяГруппаНФА.Наименование;
					СтрокаИспользуемыхГрупп.ПорядокСчета = Строка(СтрокиДокумента.КФО) + ТекущаяГруппаНФА.Порядок;
				КонецЕсли;
				СоставТабличнойЧасти = ЗаголовокТабличнойЧасти.Состав;
				СтрокиНФАПоГруппам.Вставить(КодГрупповогоСчета, ЗаголовокТабличнойЧасти);
			Иначе
				СоставТабличнойЧасти = ГруппировочнаяСтрока.Состав;
			КонецЕсли;
	
			НоваяСтрокаСостава = СоставТабличнойЧасти.Добавить();
			ЗаполнитьЗначенияСвойств(НеобязательныеРеквизиты, СтрокиДокумента);
			Если ЗначениеЗаполнено(НеобязательныеРеквизиты.НомерНоменклатурный) Тогда
				НоваяСтрокаСостава.ИнвентарныйНомер = НеобязательныеРеквизиты.НомерНоменклатурный;
			Иначе		
				НоваяСтрокаСостава.ИнвентарныйНомер = СтрокиДокумента.НФАКод;
			КонецЕсли;
			НоваяСтрокаСостава.КодЕИ = СтрокиДокумента.ЕдИзмКод;
			НоваяСтрокаСостава.КодСтроки = СтрокиДокумента.НомерСтроки;
			НоваяСтрокаСостава.Количество = СтрокиДокумента.Количество;
			НоваяСтрокаСостава.НаименованиеДоп = НеобязательныеРеквизиты.НФАДопНаименование;
			НоваяСтрокаСостава.НаименованиеЕИ = СтрокиДокумента.ЕдИзмНаименование;
			НоваяСтрокаСостава.НаименованиеНФА = СтрокиДокумента.НФАНаименование;
			НоваяСтрокаСостава.НФА = СтрокиДокумента.Номенклатура;
			НоваяСтрокаСостава.Сумма = СтрокиДокумента.Сумма;
	
			Если ВыборкаДокументов.СуммаУказанаВДокументе Тогда
				Если НоваяСтрокаСостава.Цена = 0 И НоваяСтрокаСостава.Количество <> 0 Тогда
					НоваяСтрокаСостава.Цена = НоваяСтрокаСостава.Сумма / НоваяСтрокаСостава.Количество;
				КонецЕсли;
			Иначе
				ОтборСтрокиДокумента = Новый Структура("Ссылка, НомерСтроки", ВыборкаДокументов.Ссылка, СтрокиДокумента.НомерСтроки);
				СтрокиДвижений = ДвиженияДокументов.НайтиСтроки(ОтборСтрокиДокумента);
				Если СтрокиДвижений.Количество() > 0 Тогда
					СтрокаСебестоимости = СтрокиДвижений[0];
					НоваяСтрокаСостава.Сумма = СтрокаСебестоимости.Сумма;
					НоваяСтрокаСостава.Цена = СтрокаСебестоимости.Цена;
				Иначе
					Если НоваяСтрокаСостава.Цена = 0 И НоваяСтрокаСостава.Количество <> 0 Тогда
						НоваяСтрокаСостава.Цена = НоваяСтрокаСостава.Сумма / НоваяСтрокаСостава.Количество;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			Если ТипЗнч(СтрокиДокумента.Номенклатура) = Тип("СправочникСсылка.БСО")
					Или НеобязательныеРеквизиты.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.БСО Тогда
				Если ЗначениеЗаполнено(НеобязательныеРеквизиты.СерияБСО) Тогда
					НоваяСтрокаСостава.НаименованиеНФА = СтрШаблон(НСтр("ru = '%1 (серия %2)'"),
						НоваяСтрокаСостава.НаименованиеНФА, НеобязательныеРеквизиты.СерияБСО);
				КонецЕсли;
				НоваяСтрокаСостава.ИнвентарныйНомер = ПредставлениеНомеровБСОПоПриказу61н(
					НеобязательныеРеквизиты.НомерНачальный, НеобязательныеРеквизиты.НомерКонечный);
			КонецЕсли;
		
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Результат;

КонецФункции

Функция ДанныеДляПечати0510454(МассивОбъектов)
	ДокументыПоТипам = ОбщегоНазначенияБГУ.ДокументыПоТипам(МассивОбъектов);
	ДокументыМЗ = Новый Массив;
	ДокументыОС = Новый Массив;
	
	Для Каждого КлючИЗначение Из ДокументыПоТипам Цикл
		Если КлючИЗначение.Ключ = Тип("ДокументСсылка.АктСписанияМЗ") Тогда
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ДокументыМЗ, КлючИЗначение.Значение);
		Иначе
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ДокументыОС, КлючИЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
	
	ДанныеДляПечати = ТаблицаШапкиДляПечатиАктаСписанияОбъектовНФА0510454();
	
	ДобавитьДанныеДляПечати0510454_ОС(ДанныеДляПечати, ДокументыОС);
	Документы.АктСписанияМЗ.ДобавитьДанныеДляПечатиАктаСписанияНФА0510454(ДанныеДляПечати, ДокументыМЗ);
	
	Возврат ДанныеДляПечати;
КонецФункции

