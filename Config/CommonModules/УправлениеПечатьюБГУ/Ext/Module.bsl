	|			ТОГДА """"
	|		ИНАЧЕ Документ.Организация.КодПоРПБС
	|	КОНЕЦ КАК КодРПБСПодр,
	|	Документ.Организация.КодПоППП.НаименованиеПолное КАК Учредитель,
	|	Документ.Организация.КодПоППП.Код КАК ГлаваБК,
	|	Документ.Организация.Бюджет.НаименованиеПолное КАК БюджетНаименование,
	|	Документ.Организация.Бюджет.Код КАК ОКТМО,
	|	Документ.ПодразделениеОтправитель КАК ПодразделениеОтправитель,
	|	ВЫБОР
	|		КОГДА Документ.ПодразделениеОтправитель.НаименованиеПолное = """"
	|			ТОГДА Документ.ПодразделениеОтправитель.Наименование
	|		ИНАЧЕ Документ.ПодразделениеОтправитель.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеПодразделенияОтправителя,
