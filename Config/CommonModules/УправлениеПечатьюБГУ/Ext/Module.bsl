	|ВЫБРАТЬ
	|	ВТ_НФА.Ссылка КАК Ссылка,
	|	ВТ_НФА.НомерСтроки КАК КодСтроки,
	|	ВТ_НФА.НФА КАК НФА,
	|	ВЫБОР
	|		КОГДА ВТ_НФА.НФА.НаименованиеПолное = """"
	|			ТОГДА ВТ_НФА.НФА.Наименование
	|		ИНАЧЕ ВТ_НФА.НФА.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеНФА,
	|	ВТ_НФА.НФА.Код КАК НаименованиеДоп,
	|	ВТ_НФА.ИнвентарныйНомер КАК ИнвентарныйНомерСсылка,
	|	ПРЕДСТАВЛЕНИЕ(ВТ_НФА.ИнвентарныйНомер) КАК ИнвентарныйНомер,
	|	ВЫБОР
	|		КОГДА НЕ ВТ_НФА.ИнвентарныйНомер ЕСТЬ NULL
	|				И ВТ_НФА.ИнвентарныйНомер ССЫЛКА Справочник.ИнвентарныеНомераОС
	|				И ВТ_НФА.ИнвентарныйНомер <> ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
	|			ТОГДА ВТ_НФА.ИнвентарныйНомер.НомерПаспорта
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК НомерДоп,
	|	""шт"" КАК НаименованиеЕИ,
	|	""796"" КАК КодЕИ,
	|	ВТ_НФА.Количество КАК Количество,
	|	ВТ_НФА.Цена КАК Цена,
	|	ВТ_НФА.Сумма КАК Сумма,
	|	ВТ_НФА.КФО КАК КФО,
	|	ВТ_НФА.СчетГруппа КАК КодГруппыНФА,
	|	ВТ_НФА.СчетГруппа.Наименование КАК ГруппаНФА
	|ИЗ
