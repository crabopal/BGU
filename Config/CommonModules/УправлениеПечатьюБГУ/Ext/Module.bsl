// Данные для печати акта о списании БСО0510461.
// 
// Параметры:
//  МассивОбъектов - Массив из ДокументСсылка
// 
// Возвращаемое значение:
//  см. ТаблицаШапкиДляПечатиАктаОСписанииБСО0510461
Функция ДанныеДляПечатиАктаОСписанииБСО0510461(МассивОбъектов)
	
	ДанныеДляПечати = ТаблицаШапкиДляПечатиАктаОСписанииБСО0510461();
	
	Для Каждого Документ Из ОбщегоНазначенияБГУ.ДокументыПоТипам(МассивОбъектов) Цикл
		МенеджерДокумента = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Документ.Значение[0]);
		МенеджерДокумента.ДобавитьДанныеДляПечатиАктаОСписанииБСО0510461(ДанныеДляПечати, Документ.Значение);
	КонецЦикла;
	
	// Заполнить данные, которые можно заполнять одинаково для всех видов документов
	ДанныеОрганизацийПечати = ОбщиеСведенияДокументовДляПечати(МассивОбъектов);
	
	Для Каждого СтрокаШапки Из ДанныеДляПечати Цикл
		ДанныеОрганизации = ДанныеОрганизацийПечати.Получить(СтрокаШапки.Ссылка);
		СтрокаШапки.НаименованиеОрганизации = ДанныеОрганизации.НаименованиеОрганизации;
		СтрокаШапки.НаименованиеОбособленногоПодразделения = ДанныеОрганизации.НаименованиеОбособленногоПодразделения;
		СтрокаШапки.Учредитель = ДанныеОрганизации.Учредитель;
		СтрокаШапки.БюджетНаименование = ДанныеОрганизации.БюджетНаименование;
		СтрокаШапки.КодРПБС = ДанныеОрганизации.КодРПБС;
		СтрокаШапки.КодРПБСПодр = ДанныеОрганизации.КодРПБСОбособленногоПодразделения;
		СтрокаШапки.ГлаваБК = ДанныеОрганизации.ГлаваБК;
		СтрокаШапки.ОКТМО = ДанныеОрганизации.ОКТМО;
		СтрокаШапки.НаименованиеСтруктурногоПодразделения = ДанныеОрганизации.СтруктурноеПодразделение;

		СтрокаШапки.ОтветственныйДолжность = ДанныеОрганизации.ОтветственныйДолжность;
		СтрокаШапки.ОтветственныйФИО = КорреспондентыКлиентСервер.ФИО(ДанныеОрганизации.ОтветственныйФИО, Истина);
		СтрокаШапки.ОтветственныйТелефон = ДанныеОрганизации.ОтветственныйТелефон;
		СтрокаШапки.ОтветственныйЭлПочта = ДанныеОрганизации.ОтветственныйЭлПочта;
	КонецЦикла;
	
	Возврат ДанныеДляПечати;
	
КонецФункции

// Вывести файлы в печатную форму приказа61н.
// 
// Параметры:
//  ФайлыДокумента - см. ТаблицаФайлыДляПечатиПриказ61н
//  ТабличныйДокумент - ТабличныйДокумент
//  ОбластьПриложение - ТабличныйДокумент
Процедура ВывестиФайлыВПечатнуюФормуПриказа61н(ФайлыДокумента, ТабличныйДокумент, ОбластьПриложение)
	ПараметрыОбласти = Новый Структура("Номер", 0);
	Для Каждого Приложение Из ФайлыДокумента Цикл
		ПараметрыОбласти.Номер = ПараметрыОбласти.Номер + 1;
		ОбластьПриложение.Параметры.Заполнить(ПараметрыОбласти);
		ОбластьПриложение.Параметры.Заполнить(Приложение);
		ТабличныйДокумент.Вывести(ОбластьПриложение);
	КонецЦикла;
КонецПроцедуры

// Вывести комиссию в печатную форму приказа61н.
// 
// Параметры:
//  Комиссия - см. ТаблицаКомиссияДляПечатиПриказ61н
//  ТабличныйДокумент - ТабличныйДокумент
//  ОбластьЧленКомиссии - ТабличныйДокумент
Процедура ВывестиКомиссиюВПечатнуюФормуПриказа61н(Комиссия, ТабличныйДокумент, ОбластьЧленКомиссии)
	ПерваяСтрокаКомиссии = Истина;
	Для Каждого СтрокаКомиссии Из Комиссия Цикл
		ПараметрПредставление = Новый Структура("ПредставлениеЧленаКомиссии", "");
		Если СтрокаКомиссии.Председатель Тогда
			ПараметрПредставление.ПредставлениеЧленаКомиссии = "Председатель комиссии";
		ИначеЕсли ПерваяСтрокаКомиссии Тогда
			ПараметрПредставление.ПредставлениеЧленаКомиссии = "Члены комиссии";
			ПерваяСтрокаКомиссии = Ложь;
		КонецЕсли;
		ОбластьЧленКомиссии.Параметры.Заполнить(ПараметрПредставление);
		ОбластьЧленКомиссии.Параметры.Заполнить(СтрокаКомиссии);
		ТабличныйДокумент.Вывести(ОбластьЧленКомиссии);	
	КонецЦикла;
КонецПроцедуры

Функция ПредставлениеДолжностиДляПечатиАктСписанияМЗ0504230(Знач Должность)

	Должность = СокрЛП(Должность);
	Если СтрДлина(Должность) < 2 Тогда
		Возврат Должность;
	Иначе
		Возврат Нрег(Лев(Должность, 1)) + Сред(Должность, 2);
	КонецЕсли;

КонецФункции

// Новый данные организации.
// 
// Возвращаемое значение:
//  Структура - Новый данные организации:
// * Организация - СправочникСсылка.Организации - с учетом наличия головной организации (либо сама организация, либо головная)
// * НаименованиеОрганизации - Строка -
// * ИНН - Строка -
// * КодРПБС - Строка -
// * БюджетНаименование - Строка -
// * ГлаваБК - Строка -
// * ЮридическийАдресОрганизации - Строка -
// * Учредитель - Строка -
// * ОбособленноеПодразделение - СправочникСсылка.Организации - либо сама организация, либо пустая ссылка
// * НаименованиеОбособленногоПодразделения - Строка -
// * КодРПБСОбособленногоПодразделения - Строка -
// * КПП - Строка -
// * ОКТМО - Строка -
// * ОтветственныйДолжность - Строка -
// * ОтветственныйИсполнитель - СправочникСсылка.Сотрудники -
// * ОтветственныйТелефон - Строка -
// * ОтветственныйФИО - Строка -
// * ОтветственныйЭлПочта - Строка -
// * СтруктурноеПодразделение - СправочникСсылка.Подразделения -
// * НаименованиеСтруктурногоПодразделения - Строка -
Функция НовыйОбщиеСведенияДокументовДляПечати() 
	
	ДанныеОрганизации = Новый Структура;   
	
	ДанныеОрганизации.Вставить("Организация", Справочники.Организации.ПустаяСсылка());
	ДанныеОрганизации.Вставить("НаименованиеОрганизации", ""); 
	ДанныеОрганизации.Вставить("ИНН", "");
	ДанныеОрганизации.Вставить("КПП", "");
    ДанныеОрганизации.Вставить("ЮридическийАдресОрганизации", "");
    ДанныеОрганизации.Вставить("КодРПБС", "");
    ДанныеОрганизации.Вставить("ОбособленноеПодразделение", Справочники.Организации.ПустаяСсылка());
	ДанныеОрганизации.Вставить("НаименованиеОбособленногоПодразделения", "");
	ДанныеОрганизации.Вставить("КодРПБСОбособленногоПодразделения", "");
    ДанныеОрганизации.Вставить("ГлаваБК", "");
	ДанныеОрганизации.Вставить("Учредитель", "");  // Наименование органа осуществляющего функции и  полномочия учредителя (наименование главы БК)
	ДанныеОрганизации.Вставить("УчредительППО", ""); // Наименование органа исполнительной власти - учредителя государственного (муниципального) учреждения
	
	ДанныеОрганизации.Вставить("БюджетНаименование", "");
	ДанныеОрганизации.Вставить("ОКТМО", ""); // ОКТМО бюджета (публично-правового образования)

	ДанныеОрганизации.Вставить("ОтветственныйИсполнитель", Справочники.Сотрудники.ПустаяСсылка());
	ДанныеОрганизации.Вставить("ОтветственныйДолжность", ""); // Полное наименование должности сотрудника 
	ДанныеОрганизации.Вставить("ОтветственныйДолжностьКратко", ""); // Краткое наименование должности сотрудника 
	ДанныеОрганизации.Вставить("ОтветственныйТелефон", "");
