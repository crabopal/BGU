Процедура ВывестиНачалоНовойСтраницы(ТабличныйДокумент, ОбластьНачалоСтраницы, НомерСтраницы)

	НомерСтраницы = НомерСтраницы + 1;
	ОбластьНачалоСтраницы.Параметры.Заполнить(Новый Структура("НомерСтраницы", НомерСтраницы));
	
	ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	ТабличныйДокумент.Вывести(ОбластьНачалоСтраницы);

КонецПроцедуры

Функция ПолучитьШиринуОбласти(Область)
	
	Ширина = 0;
	
	Для Сч = 1 По Область.ШиринаТаблицы Цикл
		
		Ячейка = Область.Область(1, Сч, 1, Сч);
		Ширина = Ширина + ?(Ячейка.ШиринаКолонки = 0, 9, Ячейка.ШиринаКолонки);
		
	КонецЦикла;
	
	Коэффициент = 10 / Область.Область().Шрифт.Размер;

	Возврат Цел(Ширина * Коэффициент);
	
КонецФункции

// Формирует строку из массива слов, которая помещается в область шириной "ШиринаВСимволах".
// Выбор слов из массива начинается с индекса "ТекИндекс"
Функция СобратьСтрокуИзМассиваДляОбласти(МассивСлов, ТекИндекс, ШиринаВСимволах)
	
	СловаСтроки = Новый Массив;
	ВсегоСимволов = 0;
	
	Для к = ТекИндекс по МассивСлов.Количество()-1 Цикл
				
		ТекСлово = МассивСлов[к];
		
		//ПозРазд = СтрНайти(ТекСлово, Символы.ПС);
		//Если ПозРазд > 0 Тогда
		//	МассивСлов.Вставить(к+1, Сред(ТекСлово, ПозРазд+1)); 
		//	ТекСлово = Сред(ТекСлово, 1, ПозРазд-1);			
		//КонецЕсли;
		
		ВсегоСимволов = ВсегоСимволов + СтрДлина(" " + ТекСлово);
		
		Если ВсегоСимволов <= ШиринаВСимволах Тогда
			СловаСтроки.Добавить(ТекСлово);
			ТекИндекс = ТекИндекс + 1;
		КонецЕсли;
		
		Если ВсегоСимволов >= ШиринаВСимволах Тогда
			Прервать;
		КонецЕсли;

	КонецЦикла;	
	
	Возврат СтрСоединить(СловаСтроки, " ");
	
КонецФункции

// Выводит длинные строки в многострочные части печатных форм. 
//
// Параметры:
// СтрокаВывода - строка - которую будем выводить
// ТабДокумент - ТабличныйДокумент
// Область1 - ОбластьЯчеекТабличногоДокумента - Укороченная строка, с которой начинается вывод
// Область2 - ОбластьЯчеекТабличногоДокумента - Полная строка, котороя будет множиться
// НаименованиеЯчейкиОбласть1 - Строка - Наименование области Область1
// НаименованиеЯчейкиОбласть2 - Строка - Наименование области Область2
//
// Возвращает количество выведенных строк
Функция ВывестиДлиннуюСтрокуАктСписанияМЗ0504230(СтрокаВывода, ТабДокумент, Область1, Область2, НаименованиеЯчейкиОбласть1,
	НаименованиеЯчейкиОбласть2)
	
	МассивСтрок = СтрРазделить(СтрокаВывода, Символы.ПС, Ложь);
	МассивСлов = Новый Массив;
	Для каждого ТекСтрока Из МассивСтрок Цикл
		
		МассивСловТекущейСтроки =  СтрРазделить(ТекСтрока, " ", Ложь);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивСлов, МассивСловТекущейСтроки);
		МассивСлов.Добавить(Символы.ПС);
	
	КонецЦикла;
	
	Если МассивСлов.Количество() > 0 Тогда
		МассивСлов.Удалить(МассивСлов.ВГраница());
	КонецЕсли;
	
	ЯчейкаОбласть1 = Область1.Область(НаименованиеЯчейкиОбласть1);
	ЯчейкаОбласть2 = Область2.Область(НаименованиеЯчейкиОбласть2);
	
	ЧислоСимволов1 = Цел(ЯчейкаОбласть1.ШиринаКолонки * (ЯчейкаОбласть1.Право - ЯчейкаОбласть1.Лево + 1));
	ЧислоСимволов2 = Цел(ЯчейкаОбласть2.ШиринаКолонки * (ЯчейкаОбласть2.Право - ЯчейкаОбласть2.Лево + 1));
	
	ТекИндекс = 0;
	Область1.Параметры.Установить(0, СобратьСтрокуИзМассиваДляОбластиАктСписанияМЗ0504230(МассивСлов, ТекИндекс, ЧислоСимволов1));
	ТабДокумент.Вывести(Область1);
	КолВыведенныхСтрок = 1;
	Пока ТекИндекс <= МассивСлов.Количество() - 1 Цикл
		Область2.Параметры.Установить(0, СобратьСтрокуИзМассиваДляОбластиАктСписанияМЗ0504230(МассивСлов, ТекИндекс, ЧислоСимволов2));
		ТабДокумент.Вывести(Область2);
		КолВыведенныхСтрок = КолВыведенныхСтрок + 1;
	КонецЦикла;
	
	Возврат КолВыведенныхСтрок;
	
КонецФункции

// Формирует строку из массива слов, которая помещается в область шириной "ШиринаВСимволах".
// Выбор слов из массива начинается с индекса "ТекИндекс"
// 
// Параметры:
//  МассивСлов - Массив из Строка -  Массив слов
//  ТекИндекс - Число -  Тек индекс
//  ШиринаВСимволах - Число -  Ширина в символах
// 
// Возвращаемое значение:
//  Произвольный, Строка -  Собрать строку из массива для области
Функция СобратьСтрокуИзМассиваДляОбластиАктСписанияМЗ0504230(МассивСлов, ТекИндекс, ШиринаВСимволах)
	ТекСтрока = "";
	ВсегоСимволов = 0;
	Для к = ТекИндекс по МассивСлов.Количество()-1 Цикл
		ТекСлово = МассивСлов[к];
		Если ТекСлово = Символы.ПС Тогда
			ТекИндекс = ТекИндекс  + 1;
			Прервать;
		КонецЕсли;	
		Если СтрДлина(ТекСлово) > ШиринаВСимволах И ВсегоСимволов = 0 Тогда
			ТекСтрока = ТекСлово;
			ТекИндекс = ТекИндекс  + 1;
			Прервать;
		КонецЕсли;	
		ВсегоСимволов = ВсегоСимволов + СтрДлина(" " + ТекСлово);
		Если ВсегоСимволов < ШиринаВСимволах Тогда
			ТекСтрока = ТекСтрока + " " + ТекСлово;
			ТекИндекс = ТекИндекс  + 1;
		ИначеЕсли ВсегоСимволов = ШиринаВСимволах Тогда
			ТекСтрока = ТекСтрока + " " + ТекСлово;
			ТекИндекс = ТекИндекс  + 1;
			Прервать;
		Иначе
			Прервать
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат ТекСтрока;
КонецФункции

Функция ЕстьДопСубконтоСчетаУчетаМЗ(Счет, Кэш)
	
	СубконтоИзКэша = Кэш.Получить(Счет);
	Если СубконтоИзКэша <> Неопределено Тогда
		Возврат ЗначениеЗаполнено(СубконтоИзКэша);
	КонецЕсли;
	
	ДопСубконто = ПланыВидовХарактеристик.ВидыСубконто.ПустаяСсылка();
	СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Счет);
	Для Индекс = 1 По СвойстваСчета.КоличествоСубконто Цикл
		Субконто = СвойстваСчета["ВидСубконто" + Индекс];
		ЭтоСтандартноеСубконто = Субконто = ПланыВидовХарактеристик.ВидыСубконто.Номенклатура
			ИЛИ Субконто = ПланыВидовХарактеристик.ВидыСубконто.ЦМО
			ИЛИ Субконто = ПланыВидовХарактеристик.ВидыСубконто.Партии И НЕ СвойстваСчета["ВидСубконто" + Индекс + "Обязательный"];
		Если Не ЭтоСтандартноеСубконто Тогда
			ДопСубконто = Субконто;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Кэш.Вставить(Счет, ДопСубконто);
	Возврат ЗначениеЗаполнено(ДопСубконто);
	
КонецФункции

Функция НаименованиеНФА0510448(Строка)
	Если ТипЗнч(Строка.НФА) = Тип("СправочникСсылка.Номенклатура")
			И ЗначениеЗаполнено(Строка.ЕдИзмНаименование) Тогда
		Возврат СокрП(Строка.НаименованиеНФА) + ", " + Строка.ЕдИзмНаименование; 
	КонецЕсли;
	Возврат Строка.НаименованиеНФА;
КонецФункции

// Формирует представление подразделения для ф. 0510450 "Накладная на внутреннее перемещение".
// Состоит из "Наименование подразделения // Адрес места хранения из ЦМО"
//
// Параметры:
//   НаименованиеПодразделения - Строка - Наименование подразделения
//   МестоХранения - СправочникСсылка.МестаХранения - Место хранения из ЦМО
//
// Возвращаемое значение:
//   Строка - Представление подразделения в формате "Наименование // Адрес"
Функция ПредставлениеПодразделенияДля0510450(НаименованиеПодразделения, МестоХранения)
	ПредставлениеПодразделения = ?(ЗначениеЗаполнено(НаименованиеПодразделения), НаименованиеПодразделения, ""); 
	Если ЗначениеЗаполнено(МестоХранения) Тогда
		АдресМХ = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(
			МестоХранения, Справочники.ВидыКонтактнойИнформации.АдресМестаХранения);
		Если ЗначениеЗаполнено(АдресМХ) Тогда	
			ПредставлениеПодразделения = ПредставлениеПодразделения + "//" + АдресМХ;
		КонецЕсли;		 
	КонецЕсли;	
	
	Возврат ПредставлениеПодразделения;
КонецФункции	

// Функция - Данные для печати0510450 ОС
//
// Параметры:
//  МассивОбъектов	 - Массив из ДокументСсылка
// 
// Возвращаемое значение:
//  см. ТаблицаШапкиДляПечатиНакладнаяНаВнутреннееПеремещениеНФА0510450
//
Функция ДанныеДляПечати0510450_ОС(МассивОбъектов)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Документ.Ссылка КАК Ссылка,
	|	Документ.Дата КАК Дата,
	|	Документ.Номер КАК Номер,
	|	Документ.Организация КАК Организация,
	|	Документ.ПодразделениеОтправитель КАК ПодразделениеОтправитель,
	|	Документ.ПодразделениеПолучатель КАК ПодразделениеПолучатель,
	|	Документ.ЦМООтправитель КАК ЦМООтправитель,
	|	Документ.ЦМОПолучатель КАК ЦМОПолучатель,
	|	Документ.ВидПервичногоДокумента КАК ОснованиеДляАкта,
	|	Документ.ДатаПервичногоДокумента КАК ДатаОснованияДляАкта,
	|	Документ.НомерПервичногоДокумента КАК НомерОснованияДляАкта,
	|	Документ.Ответственный КАК Ответственный,
	|	NULL КАК ОтветственныйИсполнитель
	|ПОМЕСТИТЬ ВТ_Документ
	|ИЗ
	|	Документ.НакладнаяНаВнутреннееПеремещениеОС2 КАК Документ
	|ГДЕ
	|	Документ.Ссылка В(&МассивОбъектов)
	|	И Документ.ВидОперации <> ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПеремещениеОС.ПеремещениеОСМеждуСчетами)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Документ.Ссылка,
	|	Документ.Дата,
	|	Документ.Номер,
	|	Документ.Организация,
	|	Документ.ПодразделениеОтправитель,
	|	Документ.ПодразделениеПолучатель,
