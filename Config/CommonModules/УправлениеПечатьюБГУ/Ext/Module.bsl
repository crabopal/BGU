// Сопоставить движения со строками табличной части строго.
// 
// Параметры:
//  Параметры - см. СопоставитьДвиженияСоСтрокамиТабличнойЧасти_Параметры
//  НеобработанныеСтроки - Массив из СтрокаТаблицыЗначений - Необработанные строки
Процедура СопоставитьДвиженияСоСтрокамиТабличнойЧастиСтрого(Параметры, НеобработанныеСтроки)
	ВыборкаМатериалы = Параметры.ВыборкаМатериалы;
	ТаблицаДвижений = Параметры.ТаблицаДвижений;
	СтруктураОтбора = ОбщегоНазначения.СкопироватьРекурсивно(Параметры.СоответствиеКолонок);
	СтруктураОтбора.Вставить("НомерСтрокиДокумента", 0);
	Пока ВыборкаМатериалы.Следующий() Цикл
		Если Параметры.Свойство("Ссылка") И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ВыборкаМатериалы, "Ссылка")
			И Параметры.Ссылка <> ВыборкаМатериалы.Ссылка Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ИменаКолонок Из Параметры.СоответствиеКолонок Цикл
			СтруктураОтбора[ИменаКолонок.Ключ] = ВыборкаМатериалы[ИменаКолонок.Значение];
		КонецЦикла;
		Если ЗначениеЗаполнено(Параметры.ИмяКолонкиКЭК)
			И СтруктураОтбора.Свойство(Параметры.ИмяКолонкиКЭК)
			И НЕ ЗначениеЗаполнено(СтруктураОтбора[Параметры.ИмяКолонкиКЭК]) Тогда
			
			Номенклатура = ВыборкаМатериалы[Параметры.ИмяКолонкиНоменклатура]; // СправочникСсылка.Номенклатура
			Если Параметры.ТипНоменклатурыВТаблице Тогда
				ТипНоменклатуры = ВыборкаМатериалы.ТипНоменклатуры;
			Иначе
				ТипНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "ТипНоменклатуры");
			КонецЕсли;
			Если Параметры.КФОВТаблице Тогда
				КФО = ВыборкаМатериалы.КФО;
			Иначе
				КФО = Параметры.КФО;
			КонецЕсли;
			СтруктураОтбора[Параметры.ИмяКолонкиКЭК] =  БухгалтерскийУчет.КЭКНоменклатуры(
				Параметры.Организация,
				Параметры.ИФО,
				КФО,
				Параметры.Дата,
				ВыборкаМатериалы.СчетУчета,
				ТипНоменклатуры,
				"Кт");
		КонецЕсли;
		ТекущиеДвижения = ТаблицаДвижений.НайтиСтроки(СтруктураОтбора);
		Если ТекущиеДвижения.Количество() > 0 И НЕ ЕстьДвиженияБезКоличества(ТаблицаДвижений) Тогда
			ТекущиеДвижения[0].НомерСтрокиДокумента = ВыборкаМатериалы.НомерСтроки;
		Иначе
			НеобработанныеСтроки.Добавить(ВыборкаМатериалы.НомерСтроки);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ЕстьДвиженияБезКоличества(ТаблицаДвижений)
	Для Каждого Строка Из ТаблицаДвижений Цикл
		Если Строка.Количество = 0 И Строка.Сумма <> 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Процедура СопоставитьДвиженияСоСтрокамиТабличнойЧастиБезУчетаДопСубконто(Параметры, НеобработанныеСтроки)
	ВыборкаМатериалы = Параметры.ВыборкаМатериалы;
	ТаблицаДвижений = Параметры.ТаблицаДвижений;
	НесоотнесенныеДвижения = ТаблицаДвижений.НайтиСтроки(Новый Структура("НомерСтрокиДокумента", 0));
	КопияТаблицыДвижений = ТаблицаДвижений.Скопировать(НесоотнесенныеДвижения);

	КолонкиСвертки = Новый Массив;
	СуммируемыеКолонки = Новый Структура(Параметры.ИменаСуммируемыхКолонок);
	КолонкаДопСубконто = Новый Структура("ДопСубконто");
	Для Каждого КолонкаТаблицы Из КопияТаблицыДвижений.Колонки Цикл
		Если Не СуммируемыеКолонки.Свойство(КолонкаТаблицы.Имя)
			И Не КолонкаДопСубконто.Свойство(КолонкаТаблицы.Имя) Тогда
			КолонкиСвертки.Добавить(КолонкаТаблицы.Имя);
		КонецЕсли;
	КонецЦикла;
	
	КопияТаблицыДвижений.Свернуть(СтрСоединить(КолонкиСвертки, ","), Параметры.ИменаСуммируемыхКолонок);

	СтруктураОтбора = ОбщегоНазначения.СкопироватьРекурсивно(Параметры.СоответствиеКолонокУпрощенное);
	СтруктураОтбораДоп = ОбщегоНазначения.СкопироватьРекурсивно(СтруктураОтбора);
	СтруктураОтбораДоп.Вставить("НомерСтрокиДокумента", 0);
	ВыборкаМатериалы.Сбросить();
	Пока ВыборкаМатериалы.Следующий() Цикл
		Если Параметры.Свойство("Ссылка") И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ВыборкаМатериалы, "Ссылка")
			И Параметры.Ссылка <> ВыборкаМатериалы.Ссылка Тогда
			Продолжить;
		КонецЕсли;
		Если НеобработанныеСтроки.Найти(ВыборкаМатериалы.НомерСтроки) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ИменаКолонок Из Параметры.СоответствиеКолонокУпрощенное Цикл
			СтруктураОтбора[ИменаКолонок.Ключ] = ВыборкаМатериалы[ИменаКолонок.Значение];
		КонецЦикла;

		ТекущиеДвижения = КопияТаблицыДвижений.НайтиСтроки(СтруктураОтбора);
		Если ТекущиеДвижения.Количество() > 0 Тогда
			ТекущееДвижение = ТекущиеДвижения[0];
			
			Если ВыборкаМатериалы.Количество = ТекущееДвижение.Количество Тогда
				Сумма = ТекущееДвижение.Сумма;
			ИначеЕсли ВыборкаМатериалы.Количество < ТекущееДвижение.Количество Тогда
				Если ТекущееДвижение.Количество <> 0 Тогда
					Сумма = Окр(ВыборкаМатериалы.Количество * ТекущееДвижение.Сумма / ТекущееДвижение.Количество, 2);
				Иначе
					Сумма = 0;
				КонецЕсли;
			Иначе
				Сумма = 0;
			КонецЕсли;
			
			УчтенноеКоличество = Мин(ТекущееДвижение.Количество, ВыборкаМатериалы.Количество);
			ТекущееДвижение.Количество = ТекущееДвижение.Количество - УчтенноеКоличество;
			ТекущееДвижение.Сумма = ТекущееДвижение.Сумма - Сумма;
			
			НоваяСтрокаДвижения = ТаблицаДвижений.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаДвижения, ТекущееДвижение);
			НоваяСтрокаДвижения.Количество = УчтенноеКоличество;
			НоваяСтрокаДвижения.Сумма = Сумма;
			НоваяСтрокаДвижения.НомерСтрокиДокумента = ВыборкаМатериалы.НомерСтроки;
			
			// В исходной таблице нужно уменьшить остаток на учетнное количество
			
			УдаляемыеСтроки = Новый Массив;
			
			КоличествоВсего = УчтенноеКоличество;
			СуммаВсего = Сумма;
			
			ЗаполнитьЗначенияСвойств(СтруктураОтбораДоп, СтруктураОтбора);
			СтрокиИсходнойТаблицы = ТаблицаДвижений.НайтиСтроки(СтруктураОтбораДоп);
			Для каждого СтрокаИсходной Из СтрокиИсходнойТаблицы Цикл
			
				ВычитаемоеКоличество = Мин(СтрокаИсходной.Количество, УчтенноеКоличество);
				ВычитаемаяСумма = Мин(СтрокаИсходной.Сумма, Сумма);
				
				СтрокаИсходной.Количество = СтрокаИсходной.Количество - ВычитаемоеКоличество;
				СтрокаИсходной.Сумма = СтрокаИсходной.Сумма - ВычитаемаяСумма;
				Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаИсходной, "КоличествоОстаток") Тогда
					СтрокаИсходной.КоличествоОстаток = СтрокаИсходной.КоличествоОстаток - ВычитаемоеКоличество;
					СтрокаИсходной.СуммаОстаток = СтрокаИсходной.СуммаОстаток - ВычитаемаяСумма;
				КонецЕсли;
				
				КоличествоВсего = КоличествоВсего - ВычитаемоеКоличество;
				СуммаВсего = СуммаВсего - ВычитаемаяСумма;
				
				Если СтрокаИсходной.Количество = 0 Тогда
					УдаляемыеСтроки.Добавить(СтрокаИсходной);
				КонецЕсли;
				
			КонецЦикла;
			
			Для каждого УдаляемаяСтрока Из УдаляемыеСтроки Цикл
				ТаблицаДвижений.Удалить(УдаляемаяСтрока);
			КонецЦикла;
			
		КонецЕсли;

	КонецЦикла;
	
КонецПроцедуры

Функция ФормаПринадлежитОбъекту(ИмяФормы, ИмяОбъекта)

	СоставИмениФормы = СтрРазделить(ИмяФормы, ".");
	Возврат СоставИмениФормы.Количество() > 1
		И СоставИмениФормы[1] = ИмяОбъекта;

КонецФункции

Функция КартинкаИзФайла(Файл)
	
	ДвоичныеДанные = Неопределено;
	
	Если ЗначениеЗаполнено(Файл) Тогда
		ДвоичныеДанные = РаботаСФайлами.ДвоичныеДанныеФайла(Файл, Ложь);
	КонецЕсли;
	
	Если ДвоичныеДанные = Неопределено Тогда
		Возврат Новый Картинка;
	КонецЕсли;
	
	Возврат Новый Картинка(ДвоичныеДанные, Истина);
	
КонецФункции
 
// Используется при печати "Ведомости на выдачу МЗ на нужды учреждения". Выводит подвал страницы.
// 
Процедура ВывестиПодвалВедомостиНаВыдачу(ТабличныйДокумент, ОблИтого, Документ, ДвиженияМатериалов,МассивТМЦ,
		МассивКоличествНаСтранице,ИндексСтраницы)
		
	ТипЧисло = ОбщегоНазначения.ОписаниеТипаЧисло(15,3);
	
	ПараметрыПодвала = Новый Структура;
	Для ИндексИтога = 0 По МассивКоличествНаСтранице.ВГраница() Цикл
		
		ТекущийИтог = МассивКоличествНаСтранице[ИндексИтога];
		ПараметрыПодвала.Вставить("ИтогоМатериал" + (ИндексИтога + 1), ТекущийИтог);
		ТекущийИндексТМЦ = (ИндексИтога) + (ИндексСтраницы - 1) * 10;
		Если ТекущийИндексТМЦ <= МассивТМЦ.ВГраница() Тогда
			ТекущийМатериал = МассивТМЦ.Получить(ТекущийИндексТМЦ);
			СтрокиИтогТМЦ = ДвиженияМатериалов.НайтиСтроки(
				Новый Структура("Ссылка, Номенклатура", Документ, ТекущийМатериал));
			Если СтрокиИтогТМЦ.Количество() > 0 Тогда
				
				ИтогоКоличествоТМЦ = ТипЧисло.ПривестиЗначение(СтрокиИтогТМЦ[0].Количество);
				ИтогоСуммаТМЦ = СтрокиИтогТМЦ[0].Сумма;
				Если ИтогоКоличествоТМЦ <> 0 Тогда
					ПараметрыПодвала.Вставить("СуммаМатериал" + (ИндексИтога + 1),
						Окр(ИтогоСуммаТМЦ * ТекущийИтог / ИтогоКоличествоТМЦ, 2));
				КонецЕсли;
				ПараметрыПодвала.Вставить("ЦенаМатериал" + (ИндексИтога + 1),
						СтрокиИтогТМЦ[0].Цена);
				
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	ОчиститьПараметрыОбласти(ОблИтого);
	ОблИтого.Параметры.Заполнить(ПараметрыПодвала);
	ТабличныйДокумент.Вывести(ОблИтого);
	
	Для ИндексИтога = 0 По МассивКоличествНаСтранице.ВГраница() Цикл
		МассивКоличествНаСтранице[ИндексИтога] = 0;
	КонецЦикла;
КонецПроцедуры

Процедура ВывестиРазделы1и2в0504101(ТабличныйДокумент, Макет, ВыборкаДокументов, ВыборкаОС,
	Данные, НомерСтраницы)
	
	Раздел1_Шапка		= Макет.ПолучитьОбласть("Раздел1_Шапка");
	Раздел1_Строка		= Макет.ПолучитьОбласть("Раздел1_Строка");
	Раздел1_Подвал		= Макет.ПолучитьОбласть("Раздел1_Подвал");
	Раздел1_Отступ		= Макет.ПолучитьОбласть("Раздел1_Отступ");
	
	Раздел2_Шапка		= Макет.ПолучитьОбласть("Раздел2_Шапка");
	Раздел2_Строка		= Макет.ПолучитьОбласть("Раздел2_Строка");
	Область_НачалоСтр	= Макет.ПолучитьОбласть("НачалоСтраницы");
	
	ТаблицаХарактеристик = Данные.ТаблицаХарактеристики.СкопироватьКолонки();
	ТаблицаХарактеристик.Колонки.Добавить("НомерСтроки");
	
	ТабличныйДокумент.Вывести(Раздел1_Шапка);
	
	СтруктураПоиска = Новый Структура("Ссылка", ВыборкаДокументов.Ссылка);
	Количество			= 0;
	Сумма				= 0;
	СуммаАмортизации	= 0;
	
	ВыборкаОС.Сбросить();
	
	Пока ВыборкаОС.НайтиСледующий(СтруктураПоиска) Цикл
		
		Если ВыборкаДокументов.Передача Тогда
			
			ФактическийСрокЭксплуатации = УправлениеОсновнымиСредствами.РассчитатьМесяцыЭксплуатации(,
				ВыборкаОС.ДатаВводаВЭксплуатацию, ?(ВыборкаДокументов.Принятие,
					ВыборкаДокументов.Дата, ВыборкаДокументов.ДатаСписания));
			ПараметрыСтроки = Новый Структура("СрокЭкспл", ФактическийСрокЭксплуатации);
			Если ВыборкаДокументов.Принятие Тогда
				ПараметрыСтроки.Вставить("ИнвентарныйНомер", "");
			КонецЕсли;
			
			Раздел1_Строка.Параметры.Заполнить(ВыборкаОС);
			Раздел1_Строка.Параметры.Заполнить(ПараметрыСтроки);
			ТабличныйДокумент.Вывести(Раздел1_Строка);
			
			Количество			= Количество		+ ВыборкаОС.Количество;
			Сумма				= Сумма				+ ВыборкаОС.Сумма;
			СуммаАмортизации	= СуммаАмортизации	+ ВыборкаОС.СуммаАмортизации;
			
		КонецЕсли;
		
		Данные.Вставить("МожетСодержатьДрагМатериалы", ВыборкаОС.МожетСодержатьДрагМатериалы);
		Данные.Вставить("ДатаСписания", ВыборкаДокументов.ДатаСписания);
		
		СтруктураПоискаОС = Новый Структура("ОсновноеСредство", ВыборкаОС.ОсновноеСредствоСсылка);
		Справочники.ОсновныеСредства.ЗаполнитьТаблицуДопХарактеристик(
			Данные, СтруктураПоискаОС,, ВыборкаОС.ИнвентарныйНомерСсылка);
		Для НомерСтроки = 1 По Данные.ТаблицаХарактеристики.Количество() Цикл
			СтрокаХар = ТаблицаХарактеристик.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаХар, Данные.ТаблицаХарактеристики[НомерСтроки-1]);
			СтрокаХар.НомерСтроки = Строка(ВыборкаОС.НомерСтроки) + "." + Строка(НомерСтроки);
		КонецЦикла;
		
	КонецЦикла;
	
	Раздел1_Подвал.Параметры.Заполнить(Новый Структура("Количество,Сумма,СуммаАмортизации",Количество,Сумма,СуммаАмортизации));
	ТабличныйДокумент.Вывести(Раздел1_Подвал);
	
	// если отступ между разделами 1 и 2, шапка и одна строка раздела 2 не умещаются,
	// то начинать новый лист
	ОбластиДляПроверки = Новый Массив;
	ОбластиДляПроверки.Добавить(Раздел1_Отступ);
	ОбластиДляПроверки.Добавить(Раздел2_Шапка);
	Если ТаблицаХарактеристик.Количество() > 0 Тогда
		Раздел2_Строка.Параметры.Заполнить(ТаблицаХарактеристик[0]);
		ОбластиДляПроверки.Добавить(Раздел2_Строка);
	КонецЕсли;
	Если ТабличныйДокумент.ПроверитьВывод(ОбластиДляПроверки) Тогда
		ТабличныйДокумент.Вывести(Раздел1_Отступ);
		ТабличныйДокумент.Вывести(Раздел2_Шапка);
	Иначе
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		НомерСтраницы = НомерСтраницы + 1;
		Область_НачалоСтр.Параметры.Заполнить(Новый Структура("НомерСтраницы", НомерСтраницы));
		ТабличныйДокумент.Вывести(Область_НачалоСтр);
		ТабличныйДокумент.Вывести(Раздел2_Шапка);
	КонецЕсли;
	
	Для Каждого СтрокаХарактеристик Из ТаблицаХарактеристик Цикл
		
		Раздел2_Строка.Параметры.Заполнить(СтрокаХарактеристик);
		Если Не ТабличныйДокумент.ПроверитьВывод(Раздел2_Строка) Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			НомерСтраницы = НомерСтраницы + 1;
			Область_НачалоСтр.Параметры.Заполнить(Новый Структура("НомерСтраницы", НомерСтраницы));
			ТабличныйДокумент.Вывести(Область_НачалоСтр);
			ТабличныйДокумент.Вывести(Раздел2_Шапка);
		КонецЕсли;
		ТабличныйДокумент.Вывести(Раздел2_Строка);
		
	КонецЦикла;
	
КонецПроцедуры

// Список счетов с группами второго уровня.
// 
// Возвращаемое значение:
//  Соответствие из Структура:
//   * Группа - ПланСчетовСсылка.ЕПСБУ
//   * Порядок - Строка
//   * Код - Строка
//   * Наименование - Строка
//
Функция ГруппыОбъектовНФА() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ОтображаемыеСчета
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Ссылка В(&ВсеСчета)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка,
	|	ЕПСБУ.Родитель КАК Родитель,
	|	ЕПСБУ.ЭлементГруппа КАК ЭлементГруппа,
	|	ЕПСБУ.Код КАК Код,
	|	ЕПСБУ.Наименование КАК Наименование,
	|	ЕПСБУ.Порядок КАК Порядок
	|ПОМЕСТИТЬ ПроверяемыеСчетаИзБазы
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Ссылка В ИЕРАРХИИ(&ВсеСчета)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА ДопустимыеСчета.Ссылка ЕСТЬ NULL
	|			ТОГДА ЕПСБУ.Ссылка
	|		ИНАЧЕ ЕПСБУ.Родитель
	|	КОНЕЦ КАК Родитель,
	|	ЕПСБУ.ЭлементГруппа КАК ЭлементГруппа,
	|	ЕПСБУ.Код КАК Код,
	|	ЕПСБУ.Наименование КАК Наименование,
	|	ЕПСБУ.Порядок КАК Порядок
	|ПОМЕСТИТЬ ПроверяемыеСчетаПервогоУровня
	|ИЗ
	|	ПроверяемыеСчетаИзБазы КАК ЕПСБУ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПроверяемыеСчетаИзБазы КАК ДопустимыеСчета
	|		ПО ЕПСБУ.Родитель = ДопустимыеСчета.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПроверяемыеСчета.Ссылка КАК Ссылка,
	|	ЕСТЬNULL(ПроверяемыеРодители.Родитель, ПроверяемыеСчета.Родитель) КАК Родитель,
	|	ПроверяемыеСчета.ЭлементГруппа КАК ЭлементГруппа,
	|	ПроверяемыеСчета.Код КАК Код,
	|	ПроверяемыеСчета.Наименование КАК Наименование,
	|	ПроверяемыеСчета.Порядок КАК Порядок
	|ПОМЕСТИТЬ ПроверяемыеСчетаВторогоУровня
	|ИЗ
	|	ПроверяемыеСчетаПервогоУровня КАК ПроверяемыеСчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПроверяемыеСчетаПервогоУровня КАК ПроверяемыеРодители
	|		ПО ПроверяемыеСчета.Родитель = ПроверяемыеРодители.Ссылка
	|ГДЕ
	|	НЕ ПроверяемыеСчета.ЭлементГруппа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПроверяемыеСчета.Ссылка КАК Ссылка,
	|	ЕСТЬNULL(ПроверяемыеРодители.Родитель, ПроверяемыеСчета.Родитель) КАК Родитель,
	|	ПроверяемыеСчета.ЭлементГруппа КАК ЭлементГруппа,
	|	ПроверяемыеСчета.Код КАК Код,
	|	ПроверяемыеСчета.Наименование КАК Наименование,
	|	ПроверяемыеСчета.Порядок КАК Порядок
	|ПОМЕСТИТЬ ПроверяемыеСчетаТретьегоУровня
	|ИЗ
	|	ПроверяемыеСчетаВторогоУровня КАК ПроверяемыеСчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПроверяемыеСчетаПервогоУровня КАК ПроверяемыеРодители
	|		ПО ПроверяемыеСчета.Родитель = ПроверяемыеРодители.Ссылка
	|ГДЕ
	|	НЕ ПроверяемыеСчета.ЭлементГруппа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ПроверяемыеРодители.Код, ПроверяемыеСчета.Код) КАК Код,
	|	ЕСТЬNULL(ПроверяемыеРодители.Наименование, ПроверяемыеСчета.Наименование) КАК Наименование,
	|	ПроверяемыеСчета.Ссылка КАК Ссылка,
	|	ПроверяемыеСчета.Родитель КАК Группа,
	|	ЕСТЬNULL(ПроверяемыеРодители.Порядок, ПроверяемыеСчета.Порядок) КАК Порядок
	|ИЗ
