		ЭтоСписаниеКапвложений = (ВОСписаниеКапвложений.Найти(ВыборкаДокументов.ВидОперации) <> Неопределено);
		Если ЭтоСписаниеКапвложений Тогда
			// Этот документ списыает капвложения. В ф. 0510454, в этом случае, в гр.7, раздела 1 "Иной номер объекта"
			// выводится учетный номер объекта капвложений
			МассивККВ = Новый Массив;
			ВыборкаОбъектов.Сбросить();
			Пока ВыборкаОбъектов.НайтиСледующий(СтруктураПоиска) Цикл
				Если НЕ ЗначениеЗаполнено(ВыборкаОбъектов.КарточкаКапвложений) Тогда
					Продолжить;
				КонецЕсли;	 
				МассивККВ.Добавить(ВыборкаОбъектов.КарточкаКапвложений);
			КонецЦикла;	
			ДанныеККВ = Справочники.КарточкиКапвложений.УчетныеНомераОбъектовКапвложений(МассивККВ);
		КонецЕсли;	
		
		ВыборкаОбъектов.Сбросить();
		Пока ВыборкаОбъектов.НайтиСледующий(СтруктураПоиска) Цикл
			СтрокаСведенияОбОбъектах = СтрокаДокумента.СведенияОбОбъектах.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаСведенияОбОбъектах, ВыборкаОбъектов);
			
			Если ЭтоСписаниеКапвложений Тогда
				СтрокаКарточки = ДанныеККВ.Найти(ВыборкаОбъектов.КарточкаКапвложений, "КарточкаКапвложений");
				Если СтрокаКарточки <> Неопределено 
					И ЗначениеЗаполнено(СтрокаКарточки.УчетныйНомерОбъектаКапвложений) Тогда
					СтрокаСведенияОбОбъектах.ИнойНомер = СтрокаКарточки.УчетныйНомерОбъектаКапвложений; 
				КонецЕсли;	
			КонецЕсли;	
		КонецЦикла;

		СтрокаДокумента.СоставКомиссии = ТаблицаСоставКомиссииДляПечатиАктаСписанияОбъектовНФА0510454();		
		СоставКомиссий.Сбросить();
		Пока СоставКомиссий.НайтиСледующий(СтруктураПоиска) Цикл
			ЗаполнитьЗначенияСвойств(СтрокаДокумента.СоставКомиссии.Добавить(), СоставКомиссий);
		КонецЦикла;

		СтрокаДокумента.Приложения = ТаблицаФайлыДляПечатиАктаСписанияОбъектовНФА0510454();		
		ВыборкаФайлы.Сбросить();
		Пока ВыборкаФайлы.НайтиСледующий(СтруктураПоиска) Цикл
			ЗаполнитьЗначенияСвойств(СтрокаДокумента.Приложения.Добавить(), ВыборкаФайлы);
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

