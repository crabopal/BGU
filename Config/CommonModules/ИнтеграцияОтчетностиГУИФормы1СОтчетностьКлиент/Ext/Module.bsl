// ПРОГРАММНЫЙ ИНТЕРФЕЙС
////////////////////////////////////////////////////////////////////////////////
// Служебные
	

Процедура ПоказатьСостояниеОтправкиОтчетаВнутр(Результат, ДополнительныеПараметры) Экспорт 
	
	Если ДополнительныеПараметры.Этап = "Начало" Тогда 
		Ссылка = ДополнительныеПараметры.Ссылка;
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Этап","1");
		ДополнительныеПараметры.Вставить("Ссылка",Ссылка);
		ДополнительныеПараметры.Вставить("ДанныеОтчета");
		ДополнительныеПараметры.Вставить("ДокументОтправки");
		
		
		Оповещения = Новый ОписаниеОповещения("ПоказатьСостояниеОтправкиОтчетаВнутр", ЭтотОбъект, ДополнительныеПараметры);
		ВыполнитьОбработкуОповещения(Оповещения);
		Возврат;
		
	КонецЕсли;
	
	//Начало
	////////////////////////////////////////////////////////////////////////////////
	// Этап 1
	
	Если ДополнительныеПараметры.Этап = "1" Тогда 
		
		ДанныеОтчетов = ИнтеграцияОтчетностиГУИФормы1СОтчетностьВызовСервера.ПолучитьДанныеОтчетов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДополнительныеПараметры.Ссылка));
		ВозможныеДокументыОтпраки = ИнтеграцияОтчетностиГУИФормы1СОтчетностьВызовСервера.ПолучитьЭлДокПоОтчету(ДополнительныеПараметры.Ссылка);
		
		Если Не ЗначениеЗаполнено(ДанныеОтчетов) Тогда 
			
			Шаблон = НСтр(
			"ru = 'Не удалось получить данные отчета ""%1"". '");
			Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, ДополнительныеПараметры.Ссылка);
			ПоказатьПредупреждение(,Сообщение);
			Возврат
		Иначе 
			ДанныеОтчета = ДанныеОтчетов[0];
		КонецЕсли;
		
		Если ДанныеОтчета.НеОтправляетсяВКонтролирующийОрган Тогда
			
			Шаблон = НСтр(
			"ru = '""%1"" не сдается в электронном виде'");
			Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, ДанныеОтчета.НаименованиеОтчета);
			ПоказатьПредупреждение(,Сообщение);
			Возврат;
			
		КонецЕсли;
		
		Если ДанныеОтчета.СостояниеСдачиОтчетности = ПредопределенноеЗначение("Перечисление.СостояниеСдачиОтчетности.ДокументооборотНеНачат") Тогда
			
			Сообщение = НСтр(
			"ru = 'Просмотр подробной информации о состоянии отчета 
			|возможен только после его отправки'");
			ПоказатьПредупреждение(,Сообщение);
			Возврат;
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ВозможныеДокументыОтпраки) Тогда 
			
			Шаблон = НСтр(
			"ru = 'Не удалось найти документ ""Бухгалтерский отчет (электронный документ)"" которым отправлялся отчет ""%1"". '");
			Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, ДополнительныеПараметры.Ссылка);
			ПоказатьПредупреждение(,Сообщение);
			Возврат;

			
		КонецЕсли;	
		
		ДополнительныеПараметры.ДанныеОтчета = ДанныеОтчета;
		
		Если ВозможныеДокументыОтпраки.количество() > 1 Тогда 
			
			
			Шаблон = НСтр(
			"ru = 'Найдено несколько документов ""Бухгалтерский отчет (электронный документ)"" для отчета ""%1"".
			|Информацию по какому из них нужно показать?'");
			Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, ДополнительныеПараметры.Ссылка);
			
			СписокКнопок = Новый СписокЗначений;
			Для Каждого ВозможныйВариант из ВозможныеДокументыОтпраки Цикл 
				СписокКнопок.Добавить(ВозможныйВариант, СтрЗаменить(Строка(ВозможныйВариант),"Бухгалтерский отчет (электронный документ) ",""));
			КонецЦикла;	
			СписокКнопок.Добавить(КодВозвратаДиалога.Отмена);
			
			
			ДополнительныеПараметры.Этап = "2";
			
			Оповещения = Новый ОписаниеОповещения("ПоказатьСостояниеОтправкиОтчетаВнутр", ЭтотОбъект, ДополнительныеПараметры);
			ПоказатьВопрос(Оповещения, Сообщение, СписокКнопок);
			Возврат;
			
		Иначе 
			
	       	ДополнительныеПараметры.Этап = "3";
			
			ДополнительныеПараметры.ДокументОтправки = ВозможныеДокументыОтпраки[0];
			
			Оповещения = Новый ОписаниеОповещения("ПоказатьСостояниеОтправкиОтчетаВнутр", ЭтотОбъект, ДополнительныеПараметры);
			ВыполнитьОбработкуОповещения(Оповещения);
			Возврат;
		КонецЕсли;
		
	КонецЕсли;	

	// Этап 1
	////////////////////////////////////////////////////////////////////////////////
	// Этап 2

	Если ДополнительныеПараметры.Этап = "2" Тогда
		
		Если ТипЗнч(Результат) <> Тип("ДокументСсылка.ЭлектронныйДокументБухгалтерскийОтчет") Тогда 
			Возврат;
		КонецЕсли;	
		
		ДополнительныеПараметры.Этап = "3";
		
		ДополнительныеПараметры.ДокументОтправки = Результат;
		
		Оповещения = Новый ОписаниеОповещения("ПоказатьСостояниеОтправкиОтчетаВнутр", ЭтотОбъект, ДополнительныеПараметры);
		ВыполнитьОбработкуОповещения(Оповещения);
		Возврат;
		
	КонецЕсли;	
	
	// Этап 2
	////////////////////////////////////////////////////////////////////////////////
	// Этап 3
	
	Если ДополнительныеПараметры.Этап = "3" Тогда
		
		ДополнительныеПараметры.Этап = "4";
		
		Оповещения = Новый ОписаниеОповещения("ПоказатьСостояниеОтправкиОтчетаВнутр", ЭтотОбъект, ДополнительныеПараметры);
		ДокументооборотСКОКлиент.ПолучитьКонтекстЭДО(Оповещения);
		Возврат;	
		
	КонецЕсли;	
	
	// Этап 3
	////////////////////////////////////////////////////////////////////////////////
	// Этап 4

	
	Если ДополнительныеПараметры.Этап = "4" Тогда
		Если ЗначениеЗаполнено(Результат.ТекстОшибки) Тогда 
			ПоказатьПредупреждение(,Результат.ТекстОшибки);
			Возврат;
		КонецЕсли;
		
		КонтекстЭДО = Результат.КонтекстЭДО;
		КонтекстЭДО.ПоказатьФормуСтатусовОтправки(ДополнительныеПараметры.ДокументОтправки);	
		
	КонецЕсли;
	
	
КонецПроцедуры	


