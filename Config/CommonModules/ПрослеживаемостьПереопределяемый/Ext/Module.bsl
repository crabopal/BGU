// Возвращает представление документа на форме
//
// Параметры:
//  Документ - ДокументСсылка - ссылка на документ
//  
// Возвращаемое значение:
//  Строка - Текст, составленный по ссылке документа
// 
Функция ПредставлениеДокумента(Документ) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Документ)Тогда
		Возврат "";
	КонецЕсли;
	
	ПараметрыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Документ, "Номер, Дата");
	ТипДокумента = ТипЗнч(Документ);
	
	Если ТипДокумента = Тип("ДокументСсылка.ИнвентаризацияМЗ") Тогда
		
		ПредставлениеДокумента = НСтр("ru='Инвентаризация МЗ'");
			
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ИнвентаризацияОС") Тогда
		
		ПредставлениеДокумента = НСтр("ru='Инвентаризация ОС'");
			
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.УведомлениеОбОстаткахПрослеживаемыхТоваров") Тогда
		
		ПредставлениеДокумента = НСтр("ru='Уведомление об остатках'");
			
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.УведомлениеОВвозеПрослеживаемыхТоваров") Тогда
		
		ПредставлениеДокумента = НСтр("ru='Уведомление о ввозе'");
			
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.УведомлениеОПеремещенииПрослеживаемыхТоваров") Тогда
		
		ПредставлениеДокумента = НСтр("ru='Уведомление о перемещении'");
			
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ПоступлениеМЗ") Тогда
		
		ПредставлениеДокумента = НСтр("ru='Поступление МЗ'");
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ПоступлениеОС") Тогда
		
		ПредставлениеДокумента = НСтр("ru='Поступление ОС'");
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовОС") Тогда
		
		ПредставлениеДокумента = НСтр("ru='Принятие к учету ОС'");
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.РегистрацияОстатковПрослеживаемыхКомплектующихОС") Тогда
		
		ПредставлениеДокумента = НСтр("ru='Остатки комплектующих'");
		
	Иначе
		ПредставлениеДокумента = "";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПредставлениеДокумента) Тогда
		ТекстОснование = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='%3 №%1 от %2'"),
			ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ПараметрыДокумента.Номер, Истина, Ложь), 
			Формат(ПараметрыДокумента.Дата, "ДФ=dd.MM.yyyy"),
			ПредставлениеДокумента);
	Иначе
		ТекстОснование = "";
	КонецЕсли;
	
	Возврат ТекстОснование;
	
КонецФункции

