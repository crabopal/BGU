Процедура ЗаполнитьСтраницыБланкаПоИерархии(СтрокиДерева, МассивСтраниц) Экспорт
	
	Для Инд = 0 По СтрокиДерева.Количество()-1 Цикл
		СтрокаДерева = СтрокиДерева[Инд];
		МассивСтраниц.Добавить(СтрокаДерева);
		ПодчиненныеСтроки = СтрокаДерева.Строки;
		Если ПодчиненныеСтроки.Количество() > 0 Тогда
			ЗаполнитьСтраницыБланкаПоИерархии(ПодчиненныеСтроки, МассивСтраниц);
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры	

