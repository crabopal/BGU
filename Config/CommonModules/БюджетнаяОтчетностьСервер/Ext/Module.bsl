// ПРОЦЕДУРЫ ИНИЦИАЛИЗАЦИИ УНИВЕРСАЛЬНОГО ОТЧЕТА
//

Функция ЕстьГруппыРаскрытия(ВидОтчета) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ Первые 1
		|	ГруппыРаскрытия.Ссылка
		|ИЗ
		|	Справочник.ГруппыРаскрытия КАК ГруппыРаскрытия
		|ГДЕ
		|	ГруппыРаскрытия.Владелец = &Владелец";
	
	Запрос.УстановитьПараметр("Владелец", ВидОтчета);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат НЕ РезультатЗапроса.Пустой();	
	
КонецФункции

Функция НайтиГруппуРаскрытия(ВидОтчета,КодГруппыРаскрытия) Экспорт
	
	НайденнаяГруппаРаскрытия = Справочники.ГруппыРаскрытия.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ГруппыРаскрытия.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ГруппыРаскрытия КАК ГруппыРаскрытия
		|ГДЕ
		|	ГруппыРаскрытия.Владелец = &Владелец
		|	И ГруппыРаскрытия.Код = &Код";
	
	Запрос.УстановитьПараметр("Владелец", ВидОтчета);
	Запрос.УстановитьПараметр("Код", КодГруппыРаскрытия);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		НайденнаяГруппаРаскрытия = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат НайденнаяГруппаРаскрытия;	
КонецФункции

// Создает основные внутренние таблицы контекста отчета.
//
Функция ИнициализироватьКонтекстОтчета(Знач РеквизитыОтчета) Экспорт

	Контекст = Новый Структура;
	
	Запрос = Новый Запрос;
	
	ВОтчетеЕстьГруппыРаскрытия = ЕстьГруппыРаскрытия(РеквизитыОтчета.ВидОтчета);
	
	мЧислоДопАналитик = БюджетнаяОтчетность.ЧислоДопАналитик(РеквизитыОтчета.ВидОтчета);
		
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗначенияПоказателейОтчетов.Показатель КАК Показатель,
		|	ЗначенияПоказателейОтчетов.Индекс КАК Индекс,
		|	ЗначенияПоказателейОтчетов.ПромежуточныйИтог,
		|	ЗначенияПоказателейОтчетов.ЗначениеЧисло КАК ЗначениеЧисло,
		|	ЗначенияПоказателейОтчетов.Значение КАК Значение,
		|	ЗначенияПоказателейОтчетов.ЗначениеНеограниченнаяСтрока КАК ЗначениеНеограниченнаяСтрока
		|ПОМЕСТИТЬ ЗначенияПоказателей
		|ИЗ
		|	РегистрСведений.ЗначенияПоказателейОтчетов КАК ЗначенияПоказателейОтчетов
		|ГДЕ
		|	ЗначенияПоказателейОтчетов.ЭкземплярОтчета = &ЭкземплярОтчета
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Показатель
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПоказателиОтчетов.Ссылка КАК Ссылка,
		|	ПоказателиОтчетов.Код,
		|	ПоказателиОтчетов.Наименование,
		|	ПоказателиОтчетов.ВидИтога,
		|	ПоказателиОтчетов.ГруппаРаскрытия,
		|	ЕСТЬNULL(ПоказателиОтчетов.ГруппаРаскрытия.Код, """") КАК КодГруппыРаскрытия,
		|	ПоказателиОтчетов.Колонка КАК Колонка,
		|	ПоказателиОтчетов.Колонка.Наименование КАК НаименованиеКолонки,
		|	ПоказателиОтчетов.НеФинансовый,
		|	ПоказателиОтчетов.ИндивидуальнаяТочность,
		|	ПоказателиОтчетов.УровеньТочностиПоказателя,
		|	ПоказателиОтчетов.СпособОбработки,
		|	ПоказателиОтчетов.Строка КАК Строка,
		|	ПоказателиОтчетов.ТипЗначения,
		|	ВЫБОР
		|		КОГДА &УчитыватьАктуальность
		|			ТОГДА ПоказателиОтчетов.Отключен
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Отключен,
		|	ПоказателиОтчетов.НеМасштабируется,
		|	ЕСТЬNULL(ЗначенияПоказателей.Индекс, 0) КАК Индекс,
		|	ЗначенияПоказателей.Значение КАК Значение,
		|	ЗначенияПоказателей.ЗначениеНеограниченнаяСтрока КАК ЗначениеНеограниченнаяСтрока,
		|	ЗначенияПоказателей.ПромежуточныйИтог,
		|	ПоказателиОтчетов.Колонка.Код КАК КодКолонки,
		|	ПоказателиОтчетов.Строка.Код КАК КодСтрока,
		|	ПоказателиОтчетов.Строка.ПорядковыйНомер КАК ПорядковыйНомерСтроки,
		|	ПоказателиОтчетов.Колонка.ПорядковыйНомер КАК ПорядковыйНомерКолонки,
		|	ПоказателиОтчетов.НеограниченнаяДлина КАК НеограниченнаяДлина,
		|	ПоказателиОтчетов.РазрешитьПромежуточныеИтоги
		|ИЗ
		|	Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
		|		ЛЕВОЕ СОЕДИНЕНИЕ ЗначенияПоказателей КАК ЗначенияПоказателей
		|		ПО ПоказателиОтчетов.Ссылка = ЗначенияПоказателей.Показатель
		|ГДЕ
		|	ПоказателиОтчетов.Владелец = &ВидОтчета
		|
		|УПОРЯДОЧИТЬ ПО
		|	Индекс";
		
	ТекРег = ?(ЗначениеЗаполнено(РеквизитыОтчета.мДокументОснование), РеквизитыОтчета.мДокументОснование, РеквизитыОтчета.Ссылка);
	
	Запрос.УстановитьПараметр("ЭкземплярОтчета"	, ТекРег);
	Запрос.УстановитьПараметр("ВидОтчета"		, РеквизитыОтчета.ВидОтчета);
	Запрос.УстановитьПараметр("УчитыватьАктуальность", 
		БюджетнаяОтчетность.РедакцияБланкаАктуальна(РеквизитыОтчета.ВидОтчета, РеквизитыОтчета.ШаблонОтчета));
		
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	ИменаПолейДляИсключения = ",Показатель,Индекс,ВидАналитики,ЗначениеАналитики,НомерАналитики,ПромежуточныйИтог,ЗначениеЧисло,ЗначениеНеограниченнаяСтрока,";
	
	мПоказатели			 = Новый ТаблицаЗначений;
	ОписаниеТиповРесурсаЗначение = Метаданные.РегистрыСведений.ЗначенияПоказателейОтчетов.Ресурсы.Значение.Тип;
	ОписаниеТиповРесурсаЗначение = Новый ОписаниеТипов(ОписаниеТиповРесурсаЗначение,,,,Новый КвалификаторыСтроки);

	Для Каждого КолонкаЗапроса Из Результат.Колонки Цикл
		Если Найти(ИменаПолейДляИсключения, ","+КолонкаЗапроса.Имя+",") = 0 Тогда
			ТипКолонки = КолонкаЗапроса.ТипЗначения;
			Если КолонкаЗапроса.Имя = "Значение" Тогда
				мПоказатели.Колонки.Добавить(КолонкаЗапроса.Имя,ОписаниеТиповРесурсаЗначение);
			ИначеЕсли ТипКолонки.СодержитТип(Тип("Строка")) и ТипКолонки.КвалификаторыСтроки.ДопустимаяДлина = ДопустимаяДлина.Фиксированная Тогда
				ТипКолонки = БюджетнаяОтчетность.ПолучитьОписаниеТиповСтроки(ТипКолонки.КвалификаторыСтроки.Длина);
				мПоказатели.Колонки.Добавить(КолонкаЗапроса.Имя,ТипКолонки);
			Иначе
				мПоказатели.Колонки.Добавить(КолонкаЗапроса.Имя,ТипКолонки);
			КонецЕсли;			
		КонецЕсли;
	КонецЦикла;
		
	мПоказателиРаскрытия = Новый ТаблицаЗначений;
			
	мПоказателиРаскрытия.Колонки.Добавить("Показатель"		 ,БюджетнаяОтчетность.ПолучитьОписаниеТиповПоТипуЗначения(Справочники.ПоказателиОтчетов.ПустаяСсылка()));
	мПоказателиРаскрытия.Колонки.Добавить("Индекс"			 ,БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(7));
	мПоказателиРаскрытия.Колонки.Добавить("Значение"		 ,ОписаниеТиповРесурсаЗначение);
	мПоказателиРаскрытия.Колонки.Добавить("ПромежуточныйИтог",БюджетнаяОтчетность.ПолучитьОписаниеТиповБулево());
	мПоказателиРаскрытия.Колонки.Добавить("ГруппаРаскрытия",  Новый ОписаниеТипов("СправочникСсылка.ГруппыРаскрытия"));
	
	ТипАналитики = Метаданные.ПланыВидовХарактеристик.АналитикаОтчетов.Тип;
	
	Для Сч = 1 По мЧислоДопАналитик Цикл
		мПоказателиРаскрытия.Колонки.Добавить("Аналитика"+Сч, ТипАналитики);
	КонецЦикла;
	
	СоответствиеПустойТип = Новый Соответствие;
	СоответствиеПустойТип.Вставить(Перечисления.ТипыЗначенийПоказателейОтчетов.Число, 0);
	СоответствиеПустойТип.Вставить(Перечисления.ТипыЗначенийПоказателейОтчетов.Строка, "");
	СоответствиеПустойТип.Вставить(Перечисления.ТипыЗначенийПоказателейОтчетов.Дата, '00010101000000');
	СоответствиеПустойТип.Вставить(Перечисления.ТипыЗначенийПоказателейОтчетов.Булево, Ложь);
	
	// Обход основного запроса и формирование таблиц раскрытия и итогов показателей
	РежимОбхода = ?(мЧислоДопАналитик = 0,ОбходРезультатаЗапроса.Прямой,ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Выборка = Результат.Выбрать(РежимОбхода);
	
	Пока Выборка.Следующий() Цикл		
				
		Если Выборка.Индекс = 0 Тогда
			
			СтрокаПоказатель = мПоказатели.Добавить();
			
			ЗаполнитьЗначенияСвойств(СтрокаПоказатель,Выборка,,"Значение");
			Если ЗначениеЗаполнено(Выборка.Значение) Тогда
				Если Выборка.НеограниченнаяДлина Тогда
					СтрокаПоказатель.Значение = Выборка.ЗначениеНеограниченнаяСтрока;
				Иначе
					СтрокаПоказатель.Значение = Выборка.Значение;
				КонецЕсли;
			Иначе
				СтрокаПоказатель.Значение = СоответствиеПустойТип[Выборка.ТипЗначения];
			КонецЕсли;
			
			СтрокаПоказатель.Код = СокрП(СтрокаПоказатель.Код);
			СтрокаПоказатель.КодГруппыРаскрытия = СокрП(СтрокаПоказатель.КодГруппыРаскрытия);
			СтрокаПоказатель.КодСтрока			= СокрП(СтрокаПоказатель.КодСтрока);
			СтрокаПоказатель.КодКолонки			= СокрП(СтрокаПоказатель.КодКолонки);
			
			СтрокаПоказатель.Отключен = Выборка.Отключен и Выборка.Значение = Null;
			
		Иначе
			
			СтрокаАналитика = мПоказателиРаскрытия.Добавить();
			СтрокаАналитика.Показатель  = Выборка.Ссылка;
			СтрокаАналитика.Индекс		= Выборка.Индекс;
			СтрокаАналитика.Значение	= ?(Выборка.НеограниченнаяДлина,Выборка.ЗначениеНеограниченнаяСтрока,Выборка.Значение);
			СтрокаАналитика.ПромежуточныйИтог = Выборка.ПромежуточныйИтог;
			СтрокаАналитика.ГруппаРаскрытия = Выборка.ГруппаРаскрытия;
		КонецЕсли;
					
	КонецЦикла;
	
	НовИндекс = мПоказателиРаскрытия.Индексы.Добавить("ГруппаРаскрытия,Индекс");
	
	Если мЧислоДопАналитик > 0 Тогда
		ВыборкаАналитика = ПолучитьВыборкуАналитики(ТекРег);
		ТекГруппа = Неопределено;
		ТекИндекс = Неопределено;
		
		СтруктураЗначений = Новый Структура;
		Первый = Истина;
		Пока ВыборкаАналитика.Следующий() Цикл
			
			Если Первый Тогда
				ТекГруппа = ВыборкаАналитика.ГруппаРаскрытия;
				ТекИндекс = ВыборкаАналитика.Индекс;
				Первый = Ложь;
			КонецЕсли;
			
			Если ТекГруппа <> ВыборкаАналитика.ГруппаРаскрытия
				ИЛИ ТекИндекс <> ВыборкаАналитика.Индекс Тогда
				СтруктураПоиска = Новый Структура("ГруппаРаскрытия,Индекс",ТекГруппа,ТекИндекс);
				МассивСтрок = мПоказателиРаскрытия.НайтиСтроки(СтруктураПоиска);
				
				Для Каждого СтрТЧ Из МассивСтрок Цикл
					ЗаполнитьЗначенияСвойств(СтрТЧ,СтруктураЗначений);
				КонецЦикла;
				
				СтруктураЗначений = Новый Структура;
			КонецЕсли;	
			
			
			ТекущийТип = ВыборкаАналитика.ВидАналитики.ТипЗначения;
			ТекущееЗначение = ТекущийТип.ПривестиЗначение(ВыборкаАналитика.ЗначениеАналитики);
			
			СтруктураЗначений.Вставить("Аналитика"+ВыборкаАналитика.НомерАналитики,ТекущееЗначение);
			
			ТекГруппа = ВыборкаАналитика.ГруппаРаскрытия;
			ТекИндекс = ВыборкаАналитика.Индекс;
		КонецЦикла;
		
		Если ТекГруппа <> Неопределено Тогда
			СтруктураПоиска = Новый Структура("ГруппаРаскрытия,Индекс",ТекГруппа,ТекИндекс);
			МассивСтрок = мПоказателиРаскрытия.НайтиСтроки(СтруктураПоиска);
			
			Для Каждого СтрТЧ Из МассивСтрок Цикл
				ЗаполнитьЗначенияСвойств(СтрТЧ,СтруктураЗначений);
			КонецЦикла;
		КонецЕсли;		
		
	КонецЕсли;
	
	мПоказателиРаскрытия.Индексы.Удалить(НовИндекс);
	
	мПоказатели.Колонки.Добавить("ДанныеРасчета",Новый ОписаниеТипов("Структура"));
	мПоказатели.Колонки.Добавить("СохраненныеДанныеАктуальны",Новый ОписаниеТипов("Булево"));
	
	мПоказатели.ЗаполнитьЗначения(Истина,"СохраненныеДанныеАктуальны");
	мПоказатели.Индексы.Добавить("Код");
	мПоказатели.Индексы.Добавить("Ссылка");
	
	мПоказателиРаскрытия.Индексы.Добавить("Показатель");
	
	// ДополнительныеРеквизиты
	Запрос=Новый Запрос;
	Запрос.Текст=	
	"ВЫБРАТЬ
	|	ДополнительныеРеквизитыОтчетов.Код,
	|	ДополнительныеРеквизитыОтчетов.Наименование,
	|	ДополнительныеРеквизитыОтчетов.ВидАналитики,
	|	ДополнительныеРеквизитыОтчетов.Обязательный,
	|	ДополнительныеРеквизитыОтчетов.Ссылка КАК ДополнительныйРеквизит,
	|	ДополнительныеРеквизитыОтчетов.ПорядковыйНомер КАК ПорядковыйНомер,
	|	ЗначенияРеквизитов.Значение,
	|	ДополнительныеРеквизитыОтчетов.ВидАналитики.ТипЗначения КАК ТипЗначения,
	|	ДополнительныеРеквизитыОтчетов.ВидАналитики.ВидКлассификатораБК КАК ВидКлассификатораБК
	|ИЗ
	|	Справочник.ДополнительныеРеквизитыОтчетов КАК ДополнительныеРеквизитыОтчетов
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ЗначенияДополнительныхРеквизитовОтчета.ВидАналитики КАК ВидАналитики,
	|			ЗначенияДополнительныхРеквизитовОтчета.Значение КАК Значение
	|		ИЗ
	|			РегистрСведений.ЗначенияДополнительныхРеквизитовОтчета КАК ЗначенияДополнительныхРеквизитовОтчета
	|		ГДЕ
	|			ЗначенияДополнительныхРеквизитовОтчета.ЭкземплярОтчета = &ЭкземплярОтчета) КАК ЗначенияРеквизитов
	|		ПО ДополнительныеРеквизитыОтчетов.ВидАналитики = ЗначенияРеквизитов.ВидАналитики
	|ГДЕ
	|	ДополнительныеРеквизитыОтчетов.Владелец = &ВидОтчета
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПорядковыйНомер";
	
	Запрос.УстановитьПараметр("ВидОтчета", РеквизитыОтчета.ВидОтчета);
	Запрос.УстановитьПараметр("ЭкземплярОтчета", ТекРег);
	
	мДополнительныеРеквизиты = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.Прямой);
	
	// обрезаем коды.
	мДополнительныеРеквизиты.Колонки.Код.Имя = "Имя";
	мДополнительныеРеквизиты.Колонки.Добавить("Код",БюджетнаяОтчетность.ПолучитьОписаниеТиповСтроки(20));
	
	Для Каждого Стр Из мДополнительныеРеквизиты Цикл
		
		Стр.Код = СокрЛП(Стр.Имя);
		
		Если Стр.Значение = Неопределено ИЛИ Стр.Значение = Null 
			 ИЛИ (Не ЗначениеЗаполнено(Стр.Значение) И ТипЗнч(Стр.Значение) <> Стр.ВидАналитики.ТипЗначения.Типы()[0]) Тогда
			Стр.Значение = БюджетнаяОтчетность.ПустоеЗначениеТипа(Стр.ВидАналитики.ТипЗначения.Типы()[0]);
		КонецЕсли;
		
	КонецЦикла;
	
	мДополнительныеРеквизиты.Колонки.Удалить(мДополнительныеРеквизиты.Колонки.Имя);
	мДополнительныеРеквизиты.Индексы.Добавить("Код");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	БланкиОтчетов.ПараметрыНастройкиБланка
	|ИЗ
	|	Справочник.БланкиОтчетов КАК БланкиОтчетов
	|ГДЕ
	|	БланкиОтчетов.Ссылка = &ШаблонОтчета";
	
	Запрос.УстановитьПараметр("ШаблонОтчета", РеквизитыОтчета.ШаблонОтчета);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		мНастройкиБланка = Выборка.ПараметрыНастройкиБланка;
	Иначе
		мНастройкиБланка = Неопределено;
	КонецЕсли;
	
	Контекст = Новый Структура;
	Контекст.Вставить("мПоказатели",мПоказатели);
	Контекст.Вставить("мПоказателиРаскрытия",мПоказателиРаскрытия);
	Контекст.Вставить("мДополнительныеРеквизиты",мДополнительныеРеквизиты);
	Контекст.Вставить("мЧислоДопАналитик",мЧислоДопАналитик);
	Контекст.Вставить("мНастройкиБланка",мНастройкиБланка);
	
	Возврат Контекст;

КонецФункции // ИнициализироватьКонтекст()

Функция ПолучитьВыборкуАналитики(ЭкземплярОтчета)
	ЗапросКАналитике = Новый Запрос("ВЫБРАТЬ
	                                |	АналитикаПоказателей.ВидАналитики КАК ВидАналитики,
	                                |	АналитикаПоказателей.ГруппаРаскрытия КАК ГруппаРаскрытия,
	                                |	АналитикаПоказателей.Индекс КАК Индекс,
	                                |	ГруппыРаскрытияАналитика.НомерСтроки КАК НомерАналитики,
	                                |	АналитикаПоказателей.Значение КАК ЗначениеАналитики,
	                                |	АналитикаПоказателей.ЭкземплярОтчета КАК ЭкземплярОтчета
	                                |ИЗ
	                                |	РегистрСведений.АналитикаПоказателей КАК АналитикаПоказателей
	                                |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГруппыРаскрытия.Аналитика КАК ГруппыРаскрытияАналитика
	                                |		ПО АналитикаПоказателей.ГруппаРаскрытия = ГруппыРаскрытияАналитика.Ссылка
	                                |			И АналитикаПоказателей.ВидАналитики = ГруппыРаскрытияАналитика.ВидАналитики
	                                |ГДЕ
	                                |	АналитикаПоказателей.ЭкземплярОтчета = &ЭкземплярОтчета
	                                |
	                                |УПОРЯДОЧИТЬ ПО
	                                |	ГруппаРаскрытия,
	                                |	Индекс");
									
	ЗапросКАналитике.УстановитьПараметр("ЭкземплярОтчета",ЭкземплярОтчета);
	Результат = ЗапросКАналитике.Выполнить();
	
	ВыборкаАналитика = Результат.Выбрать();
	ЗапросКАналитике = Неопределено;
	Результат = Неопределено;	
	
	Возврат ВыборкаАналитика;
КонецФункции

