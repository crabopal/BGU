Функция ПолучитьСтраницуПоддержкиКонфигурации() Экспорт
	
	ИмяКонфигурации = Метаданные.Имя;
	
	АдресСтраницыПоддержки = "";
	
	Если ИмяКонфигурации = "БухгалтерияГосударственногоУчреждения" Тогда //ПРОФ
		
		АдресСтраницыПоддержки = "https://releases.1c.ru/project/StateAccounting20";
		
	ИначеЕсли ИмяКонфигурации = "БухгалтерияГосударственногоУчрежденияКОРП" Тогда //КОРП
		
		АдресСтраницыПоддержки = "https://releases.1c.ru/project/StateAccountingCorp";
		
	ИначеЕсли ИмяКонфигурации = "БухгалтерияГосударственногоУчрежденияБазовая" Тогда //Базовая
		
		АдресСтраницыПоддержки = "https://releases.1c.ru/project/StateAccountingBase20";
		
	КонецЕсли;
	
	БюджетнаяОтчетностьСерверПереопределяемый.ПриПолученииСтраницыПоддержкиКонфигурации(АдресСтраницыПоддержки);
	
	Возврат АдресСтраницыПоддержки;
	
КонецФункции

Процедура ПолучитьДоступныеКомплектыСоСтраницыПоддержкиКонфигурации() Экспорт
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(
		Метаданные.РегламентныеЗадания.ПолучениеДоступныхКомплектовОтчетностиСоСтраницыПоддержки);
		
		
	ДанныеАутентификации = Неопределено;
	УстановитьПривилегированныйРежим(Истина);
	ДанныеАутентификации = ИнтернетПоддержкаПользователей.ДанныеАутентификацииПользователяИнтернетПоддержки();
	Если ДанныеАутентификации <> Неопределено Тогда
		ДанныеАутентификации.Логин = КодироватьСтроку(ДанныеАутентификации.Логин, СпособКодированияСтроки.КодировкаURL);
		ДанныеАутентификации.Пароль = КодироватьСтроку(ДанныеАутентификации.Пароль, СпособКодированияСтроки.КодировкаURL);
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	ДанныеАутентификацииЗаполнены = (ДанныеАутентификации <> Неопределено);
	
	ТекЗадание = Метаданные.РегламентныеЗадания.ПолучениеДоступныхКомплектовОтчетностиСоСтраницыПоддержки;
	Если ДанныеАутентификацииЗаполнены = Ложь Тогда
		
		ТекстОшибки = НСтр("ru='Не подключена Интернет-поддержка. Информация о комплектах не получена.'");
		ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("Комплекты отчетности. Получение доступных комплектов со страницы поддержки",УровеньЖурналаРегистрации.Предупреждение,ТекЗадание,ТекстОшибки);

		Возврат;	
	КонецЕсли;
	
	АдресСтраницыПоддержки = БюджетнаяОтчетностьСервер.ПолучитьСтраницуПоддержкиКонфигурации();
	СообщатьОбОшибкахПолученияДанных = Ложь;
	КукиДляНужнойСтраницы = "";
	
	ТекстОшибки = "";
	СтраницаСайта = Обработки.ИмпортКейса.ПолучитьДанныеНаСервере(АдресСтраницыПоддержки,КукиДляНужнойСтраницы,ДанныеАутентификации,СообщатьОбОшибкахПолученияДанных,ТекстОшибки);
	
	Если НЕ ЗначениеЗаполнено(СтраницаСайта) Тогда
		ТекстСообщения = НСтр("ru='Не удалось получить данные со страницы поддержки конфигурации.'");
		ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("Комплекты отчетности. Получение доступных комплектов со страницы поддержки",УровеньЖурналаРегистрации.Ошибка,ТекЗадание,ТекстСообщения);

		ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("Комплекты отчетности. Получение доступных комплектов со страницы поддержки",УровеньЖурналаРегистрации.Ошибка,ТекЗадание,ТекстОшибки);

		Возврат;	
	КонецЕсли;
	
	ТипСтрока = ОбщегоНазначения.ОписаниеТипаСтрока(0);
	ТипБулево = Новый ОписаниеТипов("Булево");
	ТипЧисло = ОбщегоНазначения.ОписаниеТипаЧисло(10);
	
	ТаблицаФайлов = Новый ТаблицаЗначений;//колонки должны быть как в форме ФормаЗагрузкиКомплектовСоСтраницыПоддержки обработки ИмпортКейса
	ТаблицаФайлов.Колонки.Добавить("Наименование",ТипСтрока);
	ТаблицаФайлов.Колонки.Добавить("Адрес",ТипСтрока);
	ТаблицаФайлов.Колонки.Добавить("ИмяФайла",ТипСтрока);
	ТаблицаФайлов.Колонки.Добавить("Расширение",ТипСтрока);
	ТаблицаФайлов.Колонки.Добавить("Описание",ТипСтрока);
	ТаблицаФайлов.Колонки.Добавить("ВерсияНаСайте",ТипСтрока);
	ТаблицаФайлов.Колонки.Добавить("ТекущаяВерсия",ТипСтрока);
	ТаблицаФайлов.Колонки.Добавить("ИдентификаторКомплекта",ТипСтрока);
	ТаблицаФайлов.Колонки.Добавить("ВерсияНаСайтеСДатой",ТипСтрока);
	ТаблицаФайлов.Колонки.Добавить("ЕстьОбновление",ТипБулево);
	ТаблицаФайлов.Колонки.Добавить("Информация",ТипСтрока);
	ТаблицаФайлов.Колонки.Добавить("ЗагруженаБолееНоваяВерсия",ТипБулево);
	ТаблицаФайлов.Колонки.Добавить("ПрогрессУстановки",ТипСтрока);
	ТаблицаФайлов.Колонки.Добавить("ИндексКартинки",ТипЧисло);
	ТаблицаФайлов.Колонки.Добавить("Загрузить",ТипБулево);
	ТаблицаФайлов.Колонки.Добавить("АдресКомплекта",ТипСтрока);
	ТаблицаФайлов.Колонки.Добавить("ВерсияПредставление",ТипСтрока);
	ТаблицаФайлов.Колонки.Добавить("НеИспользуется",ТипБулево);
	
	Обработки.ИмпортКейса.ЗаполнитьТаблицуФайловПоДаннымСтраницыПоддержки(СтраницаСайта,ТаблицаФайлов);
	
	СоответствиеДоступныхКомплектов = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СОКРЛП(ДоступныеКомплектыОтчетности.ИдентификаторКомплекта) КАК ИдентификаторКомплекта,
		|	СОКРЛП(ДоступныеКомплектыОтчетности.Версия) КАК Версия
		|ИЗ
		|	РегистрСведений.ДоступныеКомплектыОтчетности КАК ДоступныеКомплектыОтчетности";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СоответствиеДоступныхКомплектов.Вставить(ВыборкаДетальныеЗаписи.ИдентификаторКомплекта,ВыборкаДетальныеЗаписи.Версия);
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Для Каждого СтрТЧ Из ТаблицаФайлов Цикл
		Если ЗначениеЗаполнено(СтрТЧ.ИдентификаторКомплекта) Тогда
			
			Если СоответствиеДоступныхКомплектов[СтрТЧ.ИдентификаторКомплекта] <> СтрТЧ.ВерсияНаСайте Тогда
			
				ЗаписьРС = РегистрыСведений.ДоступныеКомплектыОтчетности.СоздатьМенеджерЗаписи();
				ЗаписьРС.ИдентификаторКомплекта = СтрТЧ.ИдентификаторКомплекта;
				ЗаписьРС.Версия = СтрТЧ.ВерсияНаСайте;
				ЗаписьРС.Наименование = СтрТЧ.Наименование;
				ЗаписьРС.Записать(Истина);
				
			КонецЕсли;
		КонецЕсли;
				
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

