	Возврат Новый Структура("Строка,Перечисление,Булево,ХранилищеЗначения","Строка","Перечисление","Булево","ХранилищеЗначения");
	
КонецФункции

Функция ИспользоватьОбменСоСводомОтчетов() Экспорт
	
	Если ОбщегоНазначения.ПодсистемаСуществует("УчетГосУчрежденийПодсистемы.РегламентированнаяБухОтчетность.ОбменСоСводомОтчетов") Тогда
		Возврат ПолучитьФункциональнуюОпцию("ИспользоватьОбменСоСводомОтчетов");
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьСостояниеОтчетаВСводеОтчетов(Ссылка) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	СостоянияОтправленныхОтчетовСрезПоследних.Состояние
		|ИЗ
		|	РегистрСведений.СостоянияОтправленныхОтчетов.СрезПоследних(, ДокументОтчет = &Ссылка) КАК СостоянияОтправленныхОтчетовСрезПоследних";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Состояние;
	КонецЕсли;
		
	Возврат Перечисления.СостоянияОтчетов.ПустаяСсылка();
		
КонецФункции


