// РЕДАКТИРОВАНИЕ ОТЧЕТА В УПРАВЛЯЕМОМ РЕЖИМЕ


// Процедуры работы с согласованными аналитиками

Функция КоллекцияАналитикГруппыРаскрытия(ГруппаРаскрытия) Экспорт

	Возврат БюджетнаяОтчетностьСерверПовтИсп.КоллекцияАналитикГруппыРаскрытия(ГруппаРаскрытия);

КонецФункции // КоллекцияАналитикГруппыРаскрытия()

Функция ПодменитьСценарийДляВидыДоходовКДБ(Знач ИсточникАналитики, Знач АналитикаГруппыРаскрытия, Знач ПозицияТекущегоТипа, Знач ДеревоСвязейАналитики, ВидАналитикиСценария,Сдвиг)
	
	Если ПозицияТекущегоТипа - Сдвиг < 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ПозицияТекущегоТипа > (АналитикаГруппыРаскрытия.Количество() - 1) Тогда
		Возврат Неопределено;
	КонецЕсли;
		
	СтрокаАналитики = АналитикаГруппыРаскрытия[ПозицияТекущегоТипа-Сдвиг];
	ТекОписаниеТипов = БюджетнаяОтчетность.ПолучитьОписаниеТиповБК(СтрокаАналитики.ВидАналитики);
	
	Если ТекОписаниеТипов.СодержитТип(Тип("СправочникСсылка.ВидыДоходовКДБ")) Тогда
				 
		НайденныйСценарий = ПодобратьСценарийВводаАналитики(ИсточникАналитики, 
			АналитикаГруппыРаскрытия[ПозицияТекущегоТипа-Сдвиг].ВидАналитики,
			ДеревоСвязейАналитики);
		Если НайденныйСценарий <> Неопределено Тогда
			ВидАналитикиСценария = АналитикаГруппыРаскрытия[ПозицияТекущегоТипа-Сдвиг].ВидАналитики;
		КонецЕсли;
		Возврат НайденныйСценарий;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

Функция ПодменитьСценарийДляВидыДоходовКИФ(Знач ИсточникАналитики, Знач АналитикаГруппыРаскрытия, Знач ПозицияТекущегоТипа, Знач ДеревоСвязейАналитики, ВидАналитикиСценария,Сдвиг)
	
	Если ПозицияТекущегоТипа - Сдвиг < 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ПозицияТекущегоТипа > (АналитикаГруппыРаскрытия.Количество() - 1) Тогда
		Возврат Неопределено;
	КонецЕсли;
		
	СтрокаАналитики = АналитикаГруппыРаскрытия[ПозицияТекущегоТипа-Сдвиг];
	ТекОписаниеТипов = БюджетнаяОтчетность.ПолучитьОписаниеТиповБК(СтрокаАналитики.ВидАналитики);
	
	Если ТекОписаниеТипов.СодержитТип(Тип("СправочникСсылка.ГруппыПодгруппыКИФ")) Тогда
				 
		НайденныйСценарий = ПодобратьСценарийВводаАналитики(ИсточникАналитики, 
			АналитикаГруппыРаскрытия[ПозицияТекущегоТипа-Сдвиг].ВидАналитики,
			ДеревоСвязейАналитики);
		Если НайденныйСценарий <> Неопределено Тогда
			ВидАналитикиСценария = АналитикаГруппыРаскрытия[ПозицияТекущегоТипа-Сдвиг].ВидАналитики;
		КонецЕсли;
		Возврат НайденныйСценарий;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

Функция ПодобратьСценарийВводаАналитики(Знач ИсточникАналитики, Знач ВидАналитики, Знач ДеревоСвязейАналитики = Неопределено,ИспользуемыйВидАналитики = Неопределено) Экспорт

	Если ТипЗнч(ИсточникАналитики) = Тип("СправочникСсылка.ГруппыРаскрытия") Тогда
		АналитикаГруппыРаскрытия = КоллекцияАналитикГруппыРаскрытия(ИсточникАналитики);
	ИначеЕсли ТипЗнч(ИсточникАналитики) = Тип("СправочникСсылка.ВидыОтчетов") Тогда
		АналитикаГруппыРаскрытия = БюджетнаяОтчетностьСерверПовтИсп.ПереченьАналитикУровняОтчета(ИсточникАналитики);
	Иначе // Таблица значений
		АналитикаГруппыРаскрытия = ИсточникАналитики;
	КонецЕсли;
	
	Если ДеревоСвязейАналитики = Неопределено Тогда
		ДеревоСвязейАналитики = БюджетнаяОтчетность.ПараметрыВыбораСогласованныхАналитик(АналитикаГруппыРаскрытия);
	КонецЕсли;
	
	СтрАналитики          = АналитикаГруппыРаскрытия.Найти(ВидАналитики,"ВидАналитики");
	РеквизитыАналитики = Новый Структура("ТипЗначения,ВидКлассификатораБК",СтрАналитики.ТипЗначения,СтрАналитики.ВидКлассификатораБК);
	ТипТекущегоЗначения = БюджетнаяОтчетность.ПолучитьОписаниеТиповБК(СтрАналитики.ВидАналитики, РеквизитыАналитики).Типы()[0];
		
	// Поиск позиции текущего типа в группе раскрытия.
	
	ПозицияТекущегоТипа = ПозицияВидаАналитики(АналитикаГруппыРаскрытия, ВидАналитики);
	
	Если ТипТекущегоЗначения = Тип("СправочникСсылка.КОСГУ")  Тогда
		НовыйСценарий = ПодменитьСценарийДляВидыДоходовКДБ(ИсточникАналитики, АналитикаГруппыРаскрытия, ПозицияТекущегоТипа,ДеревоСвязейАналитики,ИспользуемыйВидАналитики,2);
		Если НовыйСценарий <> Неопределено Тогда			
			Возврат НовыйСценарий;
		КонецЕсли;
		
		НовыйСценарий = ПодменитьСценарийДляВидыДоходовКИФ(ИсточникАналитики, АналитикаГруппыРаскрытия, ПозицияТекущегоТипа,ДеревоСвязейАналитики,ИспользуемыйВидАналитики,3);
		Если НовыйСценарий <> Неопределено Тогда			
			Возврат НовыйСценарий;
		КонецЕсли;
		
	ИначеЕсли ТипТекущегоЗначения = Тип("СправочникСсылка.ГруппыПодвидовКДБ")  Тогда
		НовыйСценарий = ПодменитьСценарийДляВидыДоходовКДБ(ИсточникАналитики, АналитикаГруппыРаскрытия, ПозицияТекущегоТипа,ДеревоСвязейАналитики,ИспользуемыйВидАналитики,1);
		Если НовыйСценарий <> Неопределено Тогда			
			Возврат НовыйСценарий;
		КонецЕсли;
		
	ИначеЕсли ТипТекущегоЗначения = Тип("СправочникСсылка.СтатьиКИФ")  Тогда
		НовыйСценарий = ПодменитьСценарийДляВидыДоходовКИФ(ИсточникАналитики, АналитикаГруппыРаскрытия, ПозицияТекущегоТипа,ДеревоСвязейАналитики,ИспользуемыйВидАналитики,1);
		Если НовыйСценарий <> Неопределено Тогда			
			Возврат НовыйСценарий;
		КонецЕсли;
	ИначеЕсли ТипТекущегоЗначения = Тип("СправочникСсылка.ВидыКИФ")  Тогда
		НовыйСценарий = ПодменитьСценарийДляВидыДоходовКИФ(ИсточникАналитики, АналитикаГруппыРаскрытия, ПозицияТекущегоТипа,ДеревоСвязейАналитики,ИспользуемыйВидАналитики,2);
		Если НовыйСценарий <> Неопределено Тогда			
			Возврат НовыйСценарий;
		КонецЕсли;
	КонецЕсли;
	
	// Поиск наиболее подходящего куста дерева типов.
	Если ПозицияТекущегоТипа < 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
		
	Если ТипТекущегоЗначения = Тип("СправочникСсылка.Субконто") Тогда
		//возможно это выбор связанных аналитик
		ВозможныеСценарииВыбора  = ДеревоСвязейАналитики.Строки.НайтиСтроки(Новый Структура("ТипДанных,ВидАналитики",ТипТекущегоЗначения,ВидАналитики),Истина);
	Иначе
		ВозможныеСценарииВыбора  = ДеревоСвязейАналитики.Строки.НайтиСтроки(Новый Структура("ТипДанных",ТипТекущегоЗначения),Истина);
	КонецЕсли;
	
	СчетчикиСовпадений = Новый Соответствие;
	МаксимумСовпадений = 0;
	
	Для Каждого СценарийВыбора Из ВозможныеСценарииВыбора Цикл
		ЧислоСовпадений = СценарийВыбораМожетИспользоватьсяВДаннойГруппе(СценарийВыбора,АналитикаГруппыРаскрытия,ПозицияТекущегоТипа);
		Если ЧислоСовпадений > 0 Тогда
			МаксимумСовпадений = Макс(МаксимумСовпадений,ЧислоСовпадений);
			СчетчикиСовпадений.Вставить(ЧислоСовпадений,СценарийВыбора);
		КонецЕсли;
	КонецЦикла;
	
	ПрименяемыйСценарийВыбора = СчетчикиСовпадений[МаксимумСовпадений];
	
	Возврат ПрименяемыйСценарийВыбора;
	
КонецФункции // ВыбратьСценарийВводаАналитики()

Функция ПозицияВидаАналитики(Знач ИсточникАналитики, Знач ВидАналитики)

	Если ТипЗнч(ИсточникАналитики) = Тип("СправочникСсылка.ГруппыРаскрытия") Тогда
		АналитикаГруппыРаскрытия = КоллекцияАналитикГруппыРаскрытия(ИсточникАналитики);
	ИначеЕсли ТипЗнч(ИсточникАналитики) = Тип("СправочникСсылка.ВидыОтчетов") Тогда
		АналитикаГруппыРаскрытия = БюджетнаяОтчетностьСерверПовтИсп.ПереченьАналитикУровняОтчета(ИсточникАналитики);
	Иначе // Таблица значений
		АналитикаГруппыРаскрытия = ИсточникАналитики;
	КонецЕсли;
	
	СтрАналитики = АналитикаГруппыРаскрытия.Найти(ВидАналитики,"ВидАналитики");
	Если СтрАналитики = Неопределено Тогда
		Возврат -1
	Иначе
		Возврат АналитикаГруппыРаскрытия.Индекс(СтрАналитики);
	КонецЕсли;

КонецФункции // ПозицияВидаАналитики()

Функция СценарийВыбораМожетИспользоватьсяВДаннойГруппе(СценарийВыбора, АналитикаГруппыРаскрытия, ПозицияТекущегоТипа)
 
	Если ПозицияТекущегоТипа = -1 Тогда
		Возврат 0;
	КонецЕсли;

	СчетчикСовпадений = 0;
	
	ЭтоВыборСвязанныхАналитик = ЗначениеЗаполнено(СценарийВыбора.ВидАналитики);
	
	Если ЭтоВыборСвязанныхАналитик Тогда
		//Т.к. сценарии связанных аналитик дополняются для текущей группы раскрытия, 
		//то сценарий уже МОЖЕТ использоваться в данной группе.
		//Нужно только добавить приоритет, т.к. одна аналитики может быть одновременно и главной и детальной у разных аналитик:
		//Если это детальная аналитика, то у нее приоритет выше - 2
		//Если это главная аналитика, то у нее приоритет ниже - 1

		
		Если СценарийВыбора.Родитель = Неопределено Тогда
			СчетчикСовпадений = 1;
		Иначе
			СчетчикСовпадений = 2;
		КонецЕсли;	
				
	Иначе
		//обычный сценарий выбора
		// Поиск вверх.
		ТекущаяСтрокаТипа = СценарийВыбора;
		Индекс			  = ПозицияТекущегоТипа;
		
		Пока ТекущаяСтрокаТипа <> Неопределено Цикл
			Если Индекс >= 0 и ТекущаяСтрокаТипа <> СценарийВыбора Тогда
				РеквизитыАналитики = Новый Структура("ТипЗначения,ВидКлассификатораБК",АналитикаГруппыРаскрытия[Индекс].ТипЗначения,АналитикаГруппыРаскрытия[Индекс].ВидКлассификатораБК);
				ОписаниеТиповАналитики = БюджетнаяОтчетность.ПолучитьОписаниеТиповБК(АналитикаГруппыРаскрытия[Индекс].ВидАналитики, РеквизитыАналитики);
				Если ОписаниеТиповАналитики.СодержитТип(ТекущаяСтрокаТипа.ТипДанных) Тогда
					СчетчикСовпадений = СчетчикСовпадений + 1;
				КонецЕсли;
			КонецЕсли;
			
			ТекущаяСтрокаТипа = ТекущаяСтрокаТипа.Родитель;
			Индекс = Индекс - 1;
			
		КонецЦикла;
		
		// Поиск вниз.
		ТекущаяСтрокаТипа = СценарийВыбора;
		Индекс			  = ПозицияТекущегоТипа;
		Пока Истина Цикл
			Если Индекс < АналитикаГруппыРаскрытия.Количество() и ТекущаяСтрокаТипа <> СценарийВыбора Тогда
				РеквизитыАналитики = Новый Структура("ТипЗначения,ВидКлассификатораБК",АналитикаГруппыРаскрытия[Индекс].ТипЗначения,АналитикаГруппыРаскрытия[Индекс].ВидКлассификатораБК);
				ОписаниеТиповАналитики = БюджетнаяОтчетность.ПолучитьОписаниеТиповБК(АналитикаГруппыРаскрытия[Индекс].ВидАналитики, РеквизитыАналитики);
				Если ОписаниеТиповАналитики.СодержитТип(ТекущаяСтрокаТипа.ТипДанных) Тогда
					СчетчикСовпадений = СчетчикСовпадений + 1;
				КонецЕсли;
			КонецЕсли;
			
			Если ТекущаяСтрокаТипа.Строки.Количество() Тогда
				ТекущаяСтрокаТипа = ТекущаяСтрокаТипа.Строки[0];
				Индекс = Индекс + 1;
			Иначе
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	Возврат СчетчикСовпадений;
	
КонецФункции // СценарийВыбораМожетИспользоватьсяВДаннойГруппе()

// После выбора значения тип выбранного значения может отличаться от первоначального.
// Процедура обрабатывает данную ситуацию и возвращает новый сценарий выбора.
//
Функция ИзменитьСценарийПослеВыбораЗначения(Знач ПрименяемыйСценарий, Знач ИсточникАналитики, Знач ВидАналитики, Знач ВыбранноеЗначение) Экспорт

	Перем КореньДерева;
	
	Если ПрименяемыйСценарий.ТипДанных = ТипЗнч(ВыбранноеЗначение) Тогда
		Возврат Новый Структура("ПрименяемыйСценарий,ВидАналитики",ПрименяемыйСценарий,ВидАналитики);
	КонецЕсли;
	
	ТекСтрока = ПрименяемыйСценарий;
	Пока Истина Цикл
		Если ТекСтрока.Родитель = Неопределено Тогда
			КореньДерева = ТекСтрока;
			Прервать;
		Иначе
			ТекСтрока = ТекСтрока.Родитель;
		КонецЕсли;
	КонецЦикла;

	НовыйСценарий = КореньДерева.Строки.Найти(ТипЗнч(ВыбранноеЗначение),"ТипДанных",Истина);
	Если НовыйСценарий = ПрименяемыйСценарий Тогда
		Возврат Новый Структура("ПрименяемыйСценарий,ВидАналитики",ПрименяемыйСценарий,ВидАналитики);
	ИначеЕсли Не НовыйСценарий = Неопределено Тогда
		
		Если ТипЗнч(ИсточникАналитики) = Тип("СправочникСсылка.ГруппыРаскрытия") Тогда
			КоллекцияАналитик = КоллекцияАналитикГруппыРаскрытия(ИсточникАналитики);
		ИначеЕсли ТипЗнч(ИсточникАналитики) = Тип("СправочникСсылка.ВидыОтчетов") Тогда
			КоллекцияАналитик = БюджетнаяОтчетностьСерверПовтИсп.ПереченьАналитикУровняОтчета(ИсточникАналитики);
		Иначе // Таблица значений
			КоллекцияАналитик = ИсточникАналитики;
		КонецЕсли;
		
		ТекущийУровень         = ПрименяемыйСценарий.Уровень();
		НовыйУровень           = НовыйСценарий.Уровень();
		ПозицияВСпискеАналитик = ПозицияВидаАналитики(ИсточникАналитики, ВидАналитики);
		ИскомыйИндекс          = ПозицияВСпискеАналитик+НовыйУровень-ТекущийУровень;
		
		Если ИскомыйИндекс > 0 и ИскомыйИндекс < КоллекцияАналитик.Количество() Тогда
			СтрокаНовойАналитики = КоллекцияАналитик[ИскомыйИндекс];
			
			РеквизитыАналитики = Новый Структура("ТипЗначения,ВидКлассификатораБК",СтрокаНовойАналитики.ТипЗначения,СтрокаНовойАналитики.ВидКлассификатораБК);
			ОписаниеТиповАналитики = БюджетнаяОтчетность.ПолучитьОписаниеТиповБК(СтрокаНовойАналитики.ВидАналитики, РеквизитыАналитики);
			Если ОписаниеТиповАналитики.СодержитТип(ТипЗнч(ВыбранноеЗначение)) Тогда
				Возврат Новый Структура("ПрименяемыйСценарий,ВидАналитики",НовыйСценарий,СтрокаНовойАналитики.ВидАналитики);
			Иначе
				Возврат Неопределено;
			КонецЕсли;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции // ИзменитьСценарийПослеВыбораЗначения()

// При использовании сценария ввода начальное поле значения может отличаться от выбранного.
//  Функция позволяет получить новые значения связанных элементов.
//
Функция ЗначенияОбработкиВыбораПоСценариюВвода(Знач ИсточникАналитики, Знач ПредыдущийВидАналитики, Знач ВыбранноеЗначение,СообщатьОПроблеме = Истина) Экспорт

	Если ТипЗнч(ИсточникАналитики) = Тип("СправочникСсылка.ГруппыРаскрытия") Тогда
		КоллекцияАналитик = КоллекцияАналитикГруппыРаскрытия(ИсточникАналитики);
	ИначеЕсли ТипЗнч(ИсточникАналитики) = Тип("СправочникСсылка.ВидыОтчетов") Тогда
		КоллекцияАналитик = БюджетнаяОтчетностьСерверПовтИсп.ПереченьАналитикУровняОтчета(ИсточникАналитики);
	Иначе // Таблица значений
		КоллекцияАналитик = ИсточникАналитики;
	КонецЕсли;
	
	СтрАналитики          = КоллекцияАналитик.Найти(ПредыдущийВидАналитики,"ВидАналитики");
	ПредыдущийТипЗначения = СтрАналитики.ТипЗначения.Типы()[0];
	
	ИспользуемыйВидАналитики = Неопределено;
	
	ПредыдущийСценарий = ПодобратьСценарийВводаАналитики(ИсточникАналитики, ПредыдущийВидАналитики,,ИспользуемыйВидАналитики);
	
	Если ЗначениеЗаполнено(ИспользуемыйВидАналитики) Тогда
		СтрАналитики          = КоллекцияАналитик.Найти(ИспользуемыйВидАналитики,"ВидАналитики");
		ПредыдущийТипЗначения = СтрАналитики.ТипЗначения.Типы()[0];
		ПредыдущийВидАналитики = ИспользуемыйВидАналитики;
	КонецЕсли;
	
	Если ПредыдущийСценарий = Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Выбранное значение не может быть использовано в данном отчете.'"));
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		Если ВыбранноеЗначение.Свойство("ГруппаПодгруппаКИФ") Тогда
			//для выбора значения из полного классификатора КИФ
			РабочееЗначение = ВыбранноеЗначение.ГруппаПодгруппаКИФ;
		Иначе
			РабочееЗначение = ВыбранноеЗначение.Ссылка;
		КонецЕсли;
	Иначе
		РабочееЗначение = ВыбранноеЗначение;
	КонецЕсли;
	ПараметрыНовогоСценария = ИзменитьСценарийПослеВыбораЗначения(ПредыдущийСценарий, ИсточникАналитики, ПредыдущийВидАналитики, РабочееЗначение);
	
	Если Не ПараметрыНовогоСценария = Неопределено Тогда
		ПрименяемыйСценарий = ПараметрыНовогоСценария.ПрименяемыйСценарий;
		НовыйВидАналитики   = ПараметрыНовогоСценария.ВидАналитики;
	Иначе
		Если СообщатьОПроблеме = Истина Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Выбранное значение не может быть использовано в данном отчете.'"));
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;

	ИзмененныеЗначенияАналитик = Новый Структура;
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		ПоляИзменяемыхЗначений = ЗначенияОбработкиВыбораИзСтруктуры(ПрименяемыйСценарий, ВыбранноеЗначение);
	Иначе
		ПоляИзменяемыхЗначений = ЗначенияОбработкиВыбораИзЗапроса(ПрименяемыйСценарий, ВыбранноеЗначение);
		Если ПоляИзменяемыхЗначений = Неопределено Тогда
			ПоляИзменяемыхЗначений = ЗначенияОбработкиВыбораИзСтруктуры(ПрименяемыйСценарий, Новый Структура("Ссылка",ВыбранноеЗначение));
		КонецЕсли;
	КонецЕсли;
	
	Если ПоляИзменяемыхЗначений = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПозицияТекущегоТипа = ПозицияВидаАналитики(ИсточникАналитики, НовыйВидАналитики);
	
	// Поиск наиболее подходящего куста дерева типов.
	Если ПозицияТекущегоТипа < 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтрокаАналитики = КоллекцияАналитик[ПозицияТекущегоТипа];
	
	ИзмененныеЗначенияАналитик.Вставить(СтрокаАналитики.КодВидаАналитики, РабочееЗначение);
	
	Если ЗначениеЗаполнено(ПрименяемыйСценарий.ВидАналитики) Тогда
		//Это выбор связанных аналитик
		Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура")
			И ВыбранноеЗначение.Свойство("СоответствиеВыбранныхЗначений")
			И ТипЗнч(ВыбранноеЗначение.СоответствиеВыбранныхЗначений) = Тип("Соответствие") Тогда
			//СоответствиеВыбранныхЗначений - соответствие, где ключ - вид аналитики, а значение - значение этого вида аналитики
			
			Для Каждого КлючИЗначениеВыбранныхАналитик Из ВыбранноеЗначение.СоответствиеВыбранныхЗначений Цикл
				ТекСтрАналитики = КоллекцияАналитик.Найти(КлючИЗначениеВыбранныхАналитик.Ключ,"ВидАналитики");
				Если ТекСтрАналитики<>Неопределено Тогда
					ИзмененныеЗначенияАналитик.Вставить(ТекСтрАналитики.КодВидаАналитики,КлючИЗначениеВыбранныхАналитик.Значение);
				КонецЕсли;
			КонецЦикла;
					
		КонецЕсли;
		
	Иначе
		СчетчикИмен = 1;
		Для Каждого СтрСвязь Из ПрименяемыйСценарий.СвязиВыбора Цикл
			Индекс = ПозицияТекущегоТипа+СтрСвязь.Смещение;
			Если Индекс >= 0 и Индекс < КоллекцияАналитик.Количество() Тогда
				СтрокаАналитики = КоллекцияАналитик[Индекс];
				
				РеквизитыАналитики = Новый Структура("ТипЗначения,ВидКлассификатораБК",СтрокаАналитики.ТипЗначения,СтрокаАналитики.ВидКлассификатораБК);
				ОписаниеТиповАналитики = БюджетнаяОтчетность.ПолучитьОписаниеТиповБК(СтрокаАналитики.ВидАналитики, РеквизитыАналитики);
				Если ОписаниеТиповАналитики.СодержитТип(СтрСвязь.ТребуемыйТип) Тогда
					
					НовоеЗначение = ПоляИзменяемыхЗначений["Поле"+СчетчикИмен];
					
					Если СтрСвязь.РежимИзменения = 0 // Заменять всегда
						или (СтрСвязь.РежимИзменения = 2 и ЗначениеЗаполнено(НовоеЗначение)) Тогда // Заменять только на непустое значение
						
						ИзмененныеЗначенияАналитик.Вставить(СтрокаАналитики.КодВидаАналитики, ?(ЗначениеЗаполнено(СтрокаАналитики.ВидКлассификатораБК), СокрЛП(НовоеЗначение), НовоеЗначение));
						
					КонецЕсли;
					
				КонецЕсли;
				СчетчикИмен = СчетчикИмен + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат ИзмененныеЗначенияАналитик;
	
КонецФункции // ЗначенияОбработкиВыбораПоСценариюВвода()

Функция ЗначенияОбработкиВыбораИзСтруктуры(Знач ПрименяемыйСценарий, Знач ВыбранноеЗначение)
	
	СчетчикИмен = 1;
	ИзмененныеЗначенияАналитик = Новый Структура;
	
	Для Каждого СтрСвязь Из ПрименяемыйСценарий.СвязиВыбора Цикл
		
		Если ЗначениеЗаполнено(СтрСвязь.ПолеСсылки) и ВыбранноеЗначение.Свойство(СтрСвязь.ПолеСсылки) Тогда
			Ключ = СтрСвязь.ПолеСсылки;
			ИзмененныеЗначенияАналитик.Вставить("Поле"+СчетчикИмен, ВыбранноеЗначение[Ключ]);
		Иначе
			ИзмененныеЗначенияАналитик.Вставить("Поле"+СчетчикИмен, "");
		КонецЕсли;
		
		СчетчикИмен = СчетчикИмен + 1;
		
	КонецЦикла;
	
	Возврат ИзмененныеЗначенияАналитик;
	
КонецФункции

Функция ЗначенияОбработкиВыбораИзЗапроса(Знач ПрименяемыйСценарий, Знач ВыбранноеЗначение)
	
	ТипВыбранногоЗначения = ТипЗнч(ВыбранноеЗначение);
	ИмяТаблицы            = Метаданные.НайтиПоТипу(ТипВыбранногоЗначения).ПолноеИмя();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка",ВыбранноеЗначение);
	
	ПоляЗапроса = "";
	СчетчикИмен = 1;
	
	Для Каждого СтрСвязь Из ПрименяемыйСценарий.СвязиВыбора Цикл
		
		ВыражениеЗапроса = ?(ЗначениеЗаполнено(СтрСвязь.ПолеСсылки),
								"Спр." + СтрСвязь.ПолеСсылки
								,"""""");
		
		ПоляЗапроса = ПоляЗапроса + ",
		|	" + ВыражениеЗапроса + " КАК Поле" + СчетчикИмен;
		
		СчетчикИмен = СчетчикИмен + 1;
	КонецЦикла;
	
	Запрос.Текст = 
	"ВЫБРАТЬ" 
	+ Сред(ПоляЗапроса,2) + "
	|ИЗ
	|	" + ИмяТаблицы + " КАК Спр
	|ГДЕ
	|	Спр.Ссылка = &Ссылка";
	
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат Выборка;
	
КонецФункции

Функция ПодготовитьКонтекстОтбора(СценарийВвода,БланкОтчета,КодМакета,ПереченьАналитик) Экспорт

	Запрос 		 = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	БланкиОтчетовМакетРаскрытий.Макет
	|ИЗ
	|	Справочник.БланкиОтчетов.МакетРаскрытий КАК БланкиОтчетовМакетРаскрытий
	|ГДЕ
	|	БланкиОтчетовМакетРаскрытий.Ссылка = &БланкОтчета
	|	И БланкиОтчетовМакетРаскрытий.КодГруппыРаскрытия = &КодМакета";
	
	Запрос.УстановитьПараметр("БланкОтчета",БланкОтчета);
	Запрос.УстановитьПараметр("КодМакета"  ,КодМакета);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	МакетСтроки = Выборка.Макет.Получить();
	Если ТипЗнч(МакетСтроки) = Тип("Структура") Тогда
		МакетСтроки = МакетСтроки.Содержимое;
	КонецЕсли;
	
	// Поиск позиции текущего типа в группе раскрытия.
	ПозицияТекущегоТипа = -1;
	
	Для Каждого СтрАналитика Из ПереченьАналитик Цикл
		
		Если ЗначениеЗаполнено(СценарийВвода.ВидАналитики) Тогда
			Если СтрАналитика.ВидАналитики = СценарийВвода.ВидАналитики Тогда
				ПозицияТекущегоТипа = ПереченьАналитик.Индекс(СтрАналитика);
				Прервать;
			КонецЕсли;
		Иначе
		
			ОписаниеТиповАналитики = БюджетнаяОтчетность.ПолучитьОписаниеТиповБК(СтрАналитика.ВидАналитики);	
			Если ОписаниеТиповАналитики.СодержитТип(СценарийВвода.ТипДанных) Тогда
				ПозицияТекущегоТипа = ПереченьАналитик.Индекс(СтрАналитика);
				Прервать;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	МассивСвязейОтбора = Новый Массив;
	
	КонтекстныйОтбор = Новый Структура("ТребуетсяВызовСервера",Ложь);
	
	Для Каждого СтрСвязь Из СценарийВвода.СвязиОтбора Цикл
		Индекс = ПозицияТекущегоТипа+СтрСвязь.Смещение;
		Если Индекс >= 0 и Индекс < ПереченьАналитик.Количество() Тогда
			СтрокаАналитики = ПереченьАналитик[Индекс];
			СвязьОбработана = Ложь;
			ИмяОбластиМакета = КодМакета + "_" + СтрокаАналитики.ИмяОбъектаАналитики;
			
			Для Каждого Область Из МакетСтроки.Области Цикл
				Если Область.ТипОбласти = ТипОбластиЯчеекТабличногоДокумента.Прямоугольник и Область.СодержитЗначение
					 и Лев(Область.Имя,СтрДлина(ИмяОбластиМакета)) = ИмяОбластиМакета Тогда
					 
					СвязьОтбора = Новый Структура("ПолеОтбора,ИмяОбласти",СтрСвязь.ПолеОтбора,Область.Имя); 
					МассивСвязейОтбора.Добавить(СвязьОтбора);
					СвязьОбработана = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если Не СвязьОбработана Тогда
				// Не все требуемые аналитики присутствуют в макете
				// При выборе потребуется дополнительный серверный вызов.
				МассивСвязейОтбора.Очистить();
				Прервать;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	Если МассивСвязейОтбора.Количество() = 0 Тогда
		
		КонтекстныйОтбор.ТребуетсяВызовСервера = Истина;
		
		Для Каждого СтрСвязь Из СценарийВвода.СвязиОтбора Цикл
			Индекс = ПозицияТекущегоТипа+СтрСвязь.Смещение;
			Если Индекс >= 0 и Индекс < ПереченьАналитик.Количество() Тогда
				СтрокаАналитики = ПереченьАналитик[Индекс];
				СвязьОтбора = Новый Структура("ПолеОтбора,ИмяОбласти",СтрСвязь.ПолеОтбора,СтрокаАналитики.ИмяОбъектаАналитики); 
				МассивСвязейОтбора.Добавить(СвязьОтбора);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	КонтекстныйОтбор.Вставить("МассивСвязейОтбора",МассивСвязейОтбора);
	
	Возврат КонтекстныйОтбор;
	
КонецФункции // ПодготовитьКонтекстОтбора()


// функции интерактивного редактирования

// Запрашивает тип области с сервера для открытия нужной формы выбора.
//
// Возвращаемое значение:
//   Структура: ВидОбласти, НастройкиЯчейки (ЕстьПредставление, ЕстьСвязанныеРеквизиты, ЕстьВыборИзКПС)
//
Функция ПолучитьПараметрыОбластиСервер(Знач ВидОтчета, Знач АдресНастроек, Знач ИмяОбласти, Знач РежимРазбора = "ВТелеОтчета") Экспорт
	
	ВидОбласти = ПолучитьВидИсточникаДанныхОбласти(ВидОтчета,ИмяОбласти);
	Если ВидОбласти < 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Здесь требуется формирование структуры с параметрами.
	Результат = Новый Структура;
	Результат.Вставить("ВидОбласти"		,ВидОбласти);
	Результат.Вставить("НастройкиЯчейки",Неопределено);
	Результат.Вставить("ВидАналитики"	,Неопределено);
	Результат.Вставить("ИмяТипа"	 	,Неопределено);
	Результат.Вставить("ГруппаРаскрытия",Неопределено);
	Результат.Вставить("СценарийВвода"	,Неопределено);

	Результат.Вставить("ДоступныеЗначения",Неопределено);
	Результат.Вставить("ВидКлассификатораБК",Неопределено);
	
	мНастройки = ПолучитьИзВременногоХранилища(АдресНастроек);
	Если Не мНастройки = Неопределено Тогда
		СтрНастроек = мНастройки.НастройкиБланка.Найти(ИмяОбласти);
		
		Если СтрНастроек <> Неопределено Тогда
			
			НастройкиЯчейки = Новый Структура;
			НастройкиЯчейки.Вставить("ЕстьСвязанныеРеквизиты",СтрНастроек.ЕстьСвязанныеРеквизиты);
			НастройкиЯчейки.Вставить("ЕстьПредставление"	 ,СтрНастроек.ЕстьПредставление);
			НастройкиЯчейки.Вставить("ЕстьВыборИзКПС"		 ,СтрНастроек.ЕстьВыборИзКПС);
			НастройкиЯчейки.Вставить("ЕстьСписокДоступныхЗначений",СтрНастроек.ЕстьСписокДоступныхЗначений);			
			НастройкиЯчейки.Вставить("ЕстьВыборЗначенийИзСписка",СтрНастроек.ЕстьВыборЗначенийИзСписка);
			
			Если ВидОбласти = 2 
				И СтрНастроек.ЕстьСписокДоступныхЗначений Тогда
				Результат.Вставить("ДоступныеЗначения",СтрНастроек.СтруктураНастроек.СписокДоступныхЗначений);
			КонецЕсли;
			
			Если (ВидОбласти = 0
					ИЛИ ВидОбласти = 5)
				И СтрНастроек.ЕстьВыборЗначенийИзСписка Тогда
				МассивСтруктурДляВыбора = Новый Массив;
				
				Если СтрНастроек.СтруктураНастроек.Свойство("НастройкаВыбораЗначенийИзСписка")
					И ТипЗнч(СтрНастроек.СтруктураНастроек.НастройкаВыбораЗначенийИзСписка) = Тип("Структура") Тогда
					Если СтрНастроек.СтруктураНастроек.НастройкаВыбораЗначенийИзСписка.Свойство("ТаблицаНастройки")
						И ТипЗнч(СтрНастроек.СтруктураНастроек.НастройкаВыбораЗначенийИзСписка.ТаблицаНастройки) = Тип("ТаблицаЗначений") Тогда
						
						ТаблицаНастройки = СтрНастроек.СтруктураНастроек.НастройкаВыбораЗначенийИзСписка.ТаблицаНастройки;
						ЕстьКолонкаДР = ТаблицаНастройки.Колонки.Найти("ДоступноРедактирование") <> Неопределено;
						Для Каждого СтрТЧ Из ТаблицаНастройки Цикл
							СтруктураЗначений = Новый Структура("Значение,Представление,ДоступноРедактирование",
								СтрТЧ.Значение,СтрТЧ.Представление,Ложь);
							Если ЕстьКолонкаДР Тогда
								СтруктураЗначений.Вставить("ДоступноРедактирование", СтрТЧ.ДоступноРедактирование);
							КонецЕсли;
							МассивСтруктурДляВыбора.Добавить(СтруктураЗначений);
						КонецЦикла;
						
					КонецЕсли;
				КонецЕсли;
				
				НастройкиЯчейки.Вставить("МассивСтруктурДляВыбора",МассивСтруктурДляВыбора);
			КонецЕсли;
			
			Результат.НастройкиЯчейки = НастройкиЯчейки;
			
		КонецЕсли;
		
	КонецЕсли;
	
	
	Если ВидОбласти = 5 Тогда
		
		ЭтоВыводВТелеОтчета = (РежимРазбора = "ВТелеОтчета");
		АдресКлючевогоСлова = ?(ЭтоВыводВТелеОтчета, 2, 1);
		
		// Получить группу раскрытия для ячейки раскрытия.
		КодыАдресаЯчейки = СтрРазделить(ИмяОбласти,"_");
		Если Лев(КодыАдресаЯчейки[АдресКлючевогоСлова],10) <> "Показатель" Тогда
			Возврат Неопределено; // Неправильное имя области.
		КонецЕсли;
		
		КодГруппыРаскрытия = КодыАдресаЯчейки[0];
		
		ТекГруппаРаскрытия = НайтиГруппуРаскрытия(ВидОтчета,КодГруппыРаскрытия);
		Результат.Вставить("ГруппаРаскрытия",ТекГруппаРаскрытия);
		
	ИначеЕсли ВидОбласти = 4 Тогда
		
		ЭтоВыводВТелеОтчета = (РежимРазбора = "ВТелеОтчета");
		АдресКлючевогоСлова      = ?(ЭтоВыводВТелеОтчета, 2, 1);
		
		// Получить вид аналитики для ячейки раскрытия.
		КодыАдресаЯчейки = СтрРазделить(ИмяОбласти,"_");
		Если Лев(КодыАдресаЯчейки[АдресКлючевогоСлова],9) <> "Аналитика" Тогда
			Возврат Неопределено; // Неправильное имя области.
		КонецЕсли;
		
		ПереченьАналитик = БюджетнаяОтчетностьСерверПовтИсп.ПереченьАналитикПоГруппамРаскрытия(ВидОтчета);
		УсловияПоиска    = Новый Структура("КодГруппыРаскрытия",КодыАдресаЯчейки[0]);
		ПереченьАналитик = ПереченьАналитик.Скопировать(УсловияПоиска);
		
		СтрГруппыРаскрытия = ПереченьАналитик.Найти(КодыАдресаЯчейки[АдресКлючевогоСлова],"ИмяОбъектаАналитики");
		Если Не СтрГруппыРаскрытия = Неопределено Тогда
			Результат.ВидАналитики = СтрГруппыРаскрытия.ВидАналитики;
			Результат.ИмяТипа = СтрГруппыРаскрытия.ИмяТипаДанных;
			Результат.ГруппаРаскрытия = СтрГруппыРаскрытия.ГруппаРаскрытия;
			Результат.ВидКлассификатораБК = СтрГруппыРаскрытия.ВидКлассификатораБК;
			
			ИспользуемыйВидАналитики = Неопределено;
			СценарийВвода = ПодобратьСценарийВводаАналитики(СтрГруппыРаскрытия.ГруппаРаскрытия, СтрГруппыРаскрытия.ВидАналитики,,ИспользуемыйВидАналитики);
			Если СценарийВвода <> Неопределено Тогда
				СценарийВводаКлиент = КлиентскийСценарийВвода(СценарийВвода);
				Если СценарийВводаКлиент <> Неопределено и СценарийВводаКлиент.ЕстьКонтекстныйОтбор Тогда
					
					Если ЭтоВыводВТелеОтчета Тогда
						КодМакета = КодыАдресаЯчейки[0]+"_"+КодыАдресаЯчейки[1];
					Иначе
						КодМакета = КодыАдресаЯчейки[0];
					КонецЕсли;
					
					КонтекстныйОтбор = ПодготовитьКонтекстОтбора(СценарийВвода, мНастройки.БланкОтчета, КодМакета, ПереченьАналитик);
					СценарийВводаКлиент.Вставить("ТребуетсяВызовСервера",КонтекстныйОтбор.ТребуетсяВызовСервера);
					СценарийВводаКлиент.Вставить("СвязиОтбора"			,КонтекстныйОтбор.МассивСвязейОтбора);
				КонецЕсли;
				Если ЗначениеЗаполнено(ИспользуемыйВидАналитики) Тогда
					СценарийВводаКлиент.Вставить("ВидАналитикиСценария",ИспользуемыйВидАналитики);
				КонецЕсли;
				Результат.СценарийВвода = СценарийВводаКлиент;
			КонецЕсли;
			
		Иначе
			Возврат Неопределено; // Неправильное имя ячейки (не определено в бланке).
		КонецЕсли;
		
	ИначеЕсли ВидОбласти = 3 Тогда
		// Получить вид аналитики для ячейки доп. реквизита.
		
		ПереченьАналитик = БюджетнаяОтчетностьСерверПовтИсп.ПереченьАналитикУровняОтчета(ВидОтчета);
		СтрАналитики 	 = ПереченьАналитик.Найти(ИмяОбласти,"ИмяОбъектаАналитики");
		Если Не СтрАналитики = Неопределено Тогда
			Результат.ВидАналитики = СтрАналитики.ВидАналитики;
			Результат.ИмяТипа = СтрАналитики.ИмяТипаДанных;
			Результат.ВидКлассификатораБК = СтрАналитики.ВидКлассификатораБК;
			
			ИспользуемыйВидАналитики = Неопределено;
			СценарийВвода = ПодобратьСценарийВводаАналитики(ПереченьАналитик, СтрАналитики.ВидАналитики,,ИспользуемыйВидАналитики);
			Если СценарийВвода <> Неопределено Тогда
				СценарийВводаКлиент = КлиентскийСценарийВвода(СценарийВвода);
				Если СценарийВводаКлиент <> Неопределено и СценарийВводаКлиент.ЕстьКонтекстныйОтбор Тогда
					
					МассивСвязейОтбора = Новый Массив;
					//для доп.реквизитов не передаем настройки отбора, т.к. это редкий сценарий					
					СценарийВводаКлиент.Вставить("ТребуетсяВызовСервера",Ложь);
					СценарийВводаКлиент.Вставить("СвязиОтбора"			,Новый Массив);
					
				КонецЕсли;
				Если ЗначениеЗаполнено(ИспользуемыйВидАналитики) Тогда
					СценарийВводаКлиент.Вставить("ВидАналитикиСценария",ИспользуемыйВидАналитики);
				КонецЕсли;
				Результат.СценарийВвода = СценарийВводаКлиент;
			КонецЕсли;
			
		Иначе
			Возврат Неопределено;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции // ПолучитьПараметрыОбластиСервер()

// Возвращает вид данных в ячейке.
//
// 0 - показатель отчета (не используется в механизме свойств)
// 1 - реквизит метаданных отчета
// 2 - параметр отчета
// 3 - дополнительный реквизит
// 4 - строка раскрытия по аналитике
// 5 - показатель раскрытия
//
// -1  ячейка не связана с данными отчета.
//
Функция ПолучитьВидИсточникаДанныхОбласти(Знач ВидОтчета, Знач ИмяЯчейки) Экспорт

	Если ВРег(ИмяЯчейки) = ВРег("Дата") Или ВРег(ИмяЯчейки) = ВРег("Номер")
	 Или Метаданные.Документы.УниверсальныйРегламентированныйОтчет.Реквизиты.Найти(ИмяЯчейки) <> Неопределено Тогда
		Возврат 1;
	КонецЕсли;
	
	Если Найти(ИмяЯчейки,"_Аналитика") > 0 Тогда
		Возврат 4;
	КонецЕсли;
	
	Если Найти(ИмяЯчейки,"_Показатель") > 0 Тогда
		Возврат 5;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Источники.ИскомыйТип
	|ИЗ
	|	(ВЫБРАТЬ
	|		2 КАК ИскомыйТип,
	|		ВидыОтчетовПараметрыОтчета.Код КАК Код
	|	ИЗ
	|		Справочник.ВидыОтчетов.ПараметрыОтчета КАК ВидыОтчетовПараметрыОтчета
	|	ГДЕ
	|		ВидыОтчетовПараметрыОтчета.Ссылка = &ВидОтчета
	|		И ВидыОтчетовПараметрыОтчета.Код = &Код
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		3,
	|		ДополнительныеРеквизитыОтчетов.Код
	|	ИЗ
	|		Справочник.ДополнительныеРеквизитыОтчетов КАК ДополнительныеРеквизитыОтчетов
	|	ГДЕ
	|		ДополнительныеРеквизитыОтчетов.Владелец = &ВидОтчета
	|		И ДополнительныеРеквизитыОтчетов.Код = &Код
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		0,
	|		ПоказателиОтчетов.Код
	|	ИЗ
	|		Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
	|	ГДЕ
	|		ПоказателиОтчетов.Владелец = &ВидОтчета
	|		И ПоказателиОтчетов.Код = &Код) КАК Источники";
	
	Запрос.УстановитьПараметр("ВидОтчета", ВидОтчета);
	Запрос.УстановитьПараметр("Код"		 , ИмяЯчейки);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ИскомыйТип;
	КонецЕсли;
	
	Возврат -1;

КонецФункции // ПолучитьВидИсточникаДанныхОбласти()

Функция КлиентскийСценарийВвода(Знач СценарийВвода) Экспорт
 
	Если Не СценарийВвода = Неопределено Тогда
		
		СценарийВводаКлиент = Новый Структура;
		ТекущаяФорма 		= СценарийВвода.ФормаВыбора;
		СтрокаТекущейФормы  = СценарийВвода;
		
		Пока ТекущаяФорма = Неопределено Цикл
			ТекущаяФорма = СтрокаТекущейФормы.ФормаВыбора;
			Если ТекущаяФорма = Неопределено Тогда
				СтрокаТекущейФормы = СтрокаТекущейФормы.Родитель;
			КонецЕсли;
		КонецЦикла;
		
		Если ТекущаяФорма = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Неверно настроено дерево связей аналитики'");
		КонецЕсли;
		
		ИмяТипа 	= Метаданные.НайтиПоТипу(СтрокаТекущейФормы.ТипДанных).ПолноеИмя();
		ФормаВыбора = ?(ТекущаяФорма = "",ИмяТипа + ".ФормаВыбора",ИмяТипа + ".Форма." + ТекущаяФорма);
		
		СценарийВводаКлиент.Вставить("ФормаВыбора"			,ФормаВыбора);
		СценарийВводаКлиент.Вставить("ЕстьКонтекстныйОтбор"	,(СценарийВвода.СвязиОтбора.Количество() > 0));
		СценарийВводаКлиент.Вставить("ЕстьСвязиВыбора"		,(СценарийВвода.СвязиВыбора.Количество() > 0));
		СценарийВводаКлиент.Вставить("ФиксированныйОтбор"	,СценарийВвода.Отбор);
		
		СценарийВводаКлиент.Вставить("ДетальныйВидАналитики",СценарийВвода.ДетальныйВидАналитики);
		
		Возврат СценарийВводаКлиент;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции // КлиентскийСценарийВвода()

