Функция ВозможноРедактированиеСубконто(Субконто) Экспорт 
	
	Если не ЗначениеЗаполнено(Субконто.Владелец) Тогда 
		Возврат Истина;
	КонецЕсли;
	
	Если ТипЗнч(Субконто.Владелец) <> Тип("ПланВидовХарактеристикСсылка.АналитикаОтчетов") 
		и ТипЗнч(Субконто.Владелец) <> Тип("СправочникСсылка.СпискиЗначенийАналитик") Тогда 
		Возврат Истина;
	КонецЕсли;
	
	Если Не БюджетнаяОтчетностьКлиентСервер.КонфигурацияЯвляетсяПодчиненной() Тогда 
		Возврат Истина;
	КонецЕсли;
	
	Возврат Субконто.Владелец.ВозможностьРедактированияВПодчиненныхКонфигурациях; 
	
КонецФункции	

Процедура ОбработатьРеквизитДляХеша(ТекОбъект,ИмяРеквизита,МассивФормированияХеша,ВидРеквизита,ДопустимыеВидыРеквизита) Экспорт
	
	МассивФормированияХеша.Добавить(ИмяРеквизита);
	МассивФормированияХеша.Добавить("=");
		
	Если ВидРеквизита = ДопустимыеВидыРеквизита.Строка Тогда
		
		МассивФормированияХеша.Добавить(СокрЛП(ТекОбъект[ИмяРеквизита]));
		
	ИначеЕсли ВидРеквизита = ДопустимыеВидыРеквизита.Перечисление Тогда
		
		Если ЗначениеЗаполнено(ТекОбъект[ИмяРеквизита]) Тогда
			ДобавляемоеЗначение = ОбщегоНазначения.ИмяЗначенияПеречисления(ТекОбъект[ИмяРеквизита]);
		Иначе
			ДобавляемоеЗначение = "";
		КонецЕсли;
		МассивФормированияХеша.Добавить(ДобавляемоеЗначение);
		
	ИначеЕсли ВидРеквизита = ДопустимыеВидыРеквизита.Булево Тогда
		
		Если ТекОбъект[ИмяРеквизита] Тогда
			ДобавляемоеЗначение = "Истина";
		Иначе
			ДобавляемоеЗначение = "Ложь";
		КонецЕсли;
		МассивФормированияХеша.Добавить(ДобавляемоеЗначение);
		
	ИначеЕсли ВидРеквизита = ДопустимыеВидыРеквизита.ХранилищеЗначения Тогда
		
		МассивФормированияХеша.Добавить(СтрЗаменить(ЗначениеВСтрокуВнутр(ТекОбъект[ИмяРеквизита]),Символы.ВК,""));
		
	Иначе
		//Не должно такого быть
		
	КонецЕсли;
	
	МассивФормированияХеша.Добавить(Символы.ПС);
	
КонецПроцедуры

