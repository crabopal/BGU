
////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ ЗАПИСИ УНИВЕРСАЛЬНОГО ОТЧЕТА
//

// Записывает движения документа на сервере приложения.
//
Процедура ЗаписатьДвиженияУниверсальногоОтчета(Знач Ссылка, Знач Контекст, УдалятьДвижения = Истина) Экспорт
	
	// Запись значений показателей.
	
	КоличествоЗаписейВНаборе = БюджетнаяОтчетностьСерверПовтИсп.МаксимальныйРазмерНабораЗаписейОтчета();
	
	Счетчик=1;
		
	Если УдалятьДвижения Тогда
		
		НаборЗаписей = РегистрыСведений.ЗначенияПоказателейОтчетов.СоздатьНаборЗаписей(); 	
		НаборЗаписей.Отбор.ЭкземплярОтчета.Установить(Ссылка); 
		НаборЗаписей.Записать();
		
		НаборЗаписей = РегистрыСведений.АналитикаПоказателей.СоздатьНаборЗаписей(); 	
		НаборЗаписей.Отбор.ЭкземплярОтчета.Установить(Ссылка); 
		НаборЗаписей.Записать();
		
		НаборЗаписей = РегистрыСведений.ЗначенияДополнительныхРеквизитовОтчета.СоздатьНаборЗаписей(); 	
		НаборЗаписей.Отбор.ЭкземплярОтчета.Установить(Ссылка); 
		НаборЗаписей.Записать();
		
	КонецЕсли;
	
	СоответствиеАналитики = БюджетнаяОтчетность.ПолучитьВидыАналитикиСТипомСтрока();
	
	//Запись показателей
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("мПоказатели"			,Контекст.мПоказатели);
	Запрос.УстановитьПараметр("мПоказателиРаскрытия",Контекст.мПоказателиРаскрытия);
	
	ПоляАналитики = "";
	Для Сч = 1 По Контекст.мЧислоДопАналитик Цикл
		ПоляАналитики = ПоляАналитики + ",
		|	мПоказателиРаскрытия.Аналитика" + Сч;
	КонецЦикла;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	мПоказатели.Ссылка КАК Показатель,
	|	мПоказатели.ТипЗначения,
	|	мПоказатели.НеограниченнаяДлина,
	|	мПоказатели.ГруппаРаскрытия,
	|	мПоказатели.Значение
	|ПОМЕСТИТЬ мПоказатели
	|ИЗ
	|	&мПоказатели КАК мПоказатели
	|ГДЕ
	|	НЕ мПоказатели.Отключен
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Показатель
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	мПокРаскрытия.*
	|ПОМЕСТИТЬ мПокРаскрытия
	|ИЗ
	|	&мПоказателиРаскрытия КАК мПокРаскрытия
	|ИНДЕКСИРОВАТЬ ПО
	|	Показатель
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	мПоказателиРаскрытия.Показатель КАК Показатель,
	|	мПоказателиРаскрытия.Индекс,
	|	мПоказатели.ТипЗначения,
	|	мПоказатели.НеограниченнаяДлина,
	|	мПоказатели.ГруппаРаскрытия,
	|	мПоказателиРаскрытия.ПромежуточныйИтог,
	|	мПоказателиРаскрытия.Значение"
	+ ПоляАналитики + "
	|ПОМЕСТИТЬ мПоказателиРаскрытия
	|ИЗ
	|	мПокРаскрытия КАК мПоказателиРаскрытия
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ мПоказатели КАК мПоказатели
	|	ПО мПоказателиРаскрытия.Показатель = мПоказатели.Показатель
	|
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	мПоказатели.Показатель,
	|	0 КАК Индекс,
	|	ЛОЖЬ КАК ПромежуточныйИтог,
	|	мПоказатели.ТипЗначения,
	|	мПоказатели.НеограниченнаяДлина,
	|	мПоказатели.Значение
	|ИЗ
	|	мПоказатели КАК мПоказатели";
	
	Если Контекст.мПоказателиРаскрытия.Количество() > 0 Тогда
		Запрос.Текст = Запрос.Текст + "
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	мПоказателиРаскрытия.Показатель,
		|	мПоказателиРаскрытия.Индекс,
		|	мПоказателиРаскрытия.ПромежуточныйИтог,
		|	мПоказателиРаскрытия.ТипЗначения,
		|	мПоказателиРаскрытия.НеограниченнаяДлина,
		|	мПоказателиРаскрытия.Значение
		|ИЗ
		|	мПоказателиРаскрытия КАК мПоказателиРаскрытия
		|УПОРЯДОЧИТЬ ПО
		|	Индекс
		|;
		|////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	мПоказателиРаскрытия.Индекс,
		|	мПоказателиРаскрытия.ГруппаРаскрытия"
		+ ПоляАналитики + "
		|ИЗ
		|	мПоказателиРаскрытия КАК мПоказателиРаскрытия
		|УПОРЯДОЧИТЬ ПО
		|	Индекс
		|
		|ИТОГИ ПО
		|	ГруппаРаскрытия";
		
	КонецЕсли;
	
	РезультатыЗапросов = Запрос.ВыполнитьПакет();
	ВыборкаПоказатели  = РезультатыЗапросов[3].Выбрать();
	
	СозданыЗаписи = Ложь;
	Пока ВыборкаПоказатели.Следующий() Цикл
		
		Если Счетчик=1 Тогда
			
			СозданыЗаписи = Истина;
			НаборЗаписей  = РегистрыСведений.ЗначенияПоказателейОтчетов.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ЭкземплярОтчета.Установить(Ссылка);
			
		КонецЕсли;
		
		Движение = НаборЗаписей.Добавить(); 
		
		Движение.ЭкземплярОтчета    = Ссылка;
		Движение.Показатель     	= ВыборкаПоказатели.Показатель;
		
		// Запись ресурсов регистра
		
		// ЗначениеЧисло
		Если ВыборкаПоказатели.ТипЗначения = Перечисления.ТипыЗначенийПоказателейОтчетов.Число Тогда
			Попытка
				ЗначениеЧисло = Число(ВыборкаПоказатели.Значение);
			Исключение
				ЗначениеЧисло = 0;
			КонецПопытки;
			Движение.ЗначениеЧисло 	= ЗначениеЧисло;
			
			Движение.Значение = ЗначениеЧисло;
		Иначе
			Движение.Значение = ВыборкаПоказатели.Значение;
		КонецЕсли;		 
		
		// ЗначениеНеограниченнаяСтрока
		Если ВыборкаПоказатели.НеограниченнаяДлина Тогда
			Движение.ЗначениеНеограниченнаяСтрока = ВыборкаПоказатели.Значение;
		КонецЕсли;
		
		Движение.Индекс 			= ВыборкаПоказатели.Индекс;
		Движение.ПромежуточныйИтог 	= ВыборкаПоказатели.ПромежуточныйИтог;
		
		Если Счетчик>=КоличествоЗаписейВНаборе Тогда
			НаборЗаписей.Записать(Ложь);
			СозданыЗаписи = Ложь;
			Счетчик		  = 1;
		Иначе
			Счетчик=Счетчик+1;
		КонецЕсли;
		
	КонецЦикла;
	
	Если СозданыЗаписи Тогда
		НаборЗаписей.Записать(Ложь);
	КонецЕсли;
	
	Счетчик = 1;
	Если ЗначениеЗаполнено(Контекст.мПоказателиРаскрытия) Тогда
		
		СозданыЗаписи = Ложь;
		
		КэшГруппРаскрытия = КэшДанныхПоГруппамРаскрытия(Контекст.ВидОтчета,Контекст.мЧислоДопАналитик);
		ВыборкаГруппРаскрытия = РезультатыЗапросов[4].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаГруппРаскрытия.Следующий() Цикл
			
			ДанныеГруппы = КэшГруппРаскрытия.Найти(ВыборкаГруппРаскрытия.ГруппаРаскрытия,"ГруппаРаскрытия");
			
			// У группы может не быть аналитик. В этом случае не пишем ничего в регистр.
			Если ДанныеГруппы.ЧислоАналитик > 0 Тогда
				
				ВыборкаЗначений = ВыборкаГруппРаскрытия.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				
				Пока ВыборкаЗначений.Следующий() Цикл						
					
					Для Сч = 1 По ДанныеГруппы.ЧислоАналитик Цикл
						
						Если Счетчик = 1 Тогда
							НаборЗаписейАналитика = РегистрыСведений.АналитикаПоказателей.СоздатьНаборЗаписей();
							НаборЗаписейАналитика.Отбор.ЭкземплярОтчета.Установить(Ссылка);
							СозданыЗаписи 		  = Истина;
						КонецЕсли;
						
						ЗаписьРегистра 					 = НаборЗаписейАналитика.Добавить();
						ЗаписьРегистра.ЭкземплярОтчета 	 = Ссылка;
						ЗаписьРегистра.ГруппаРаскрытия	 = ВыборкаЗначений.ГруппаРаскрытия;
						ЗаписьРегистра.Индекс			 = ВыборкаЗначений.Индекс;
						ЗаписьРегистра.ВидАналитики		 = ДанныеГруппы["ВидАналитики"+Сч];
						
						Если СоответствиеАналитики[ЗаписьРегистра.ВидАналитики] = Истина Тогда
							//обрежем пробелы, если есть.
							ЗаписьРегистра.Значение = СокрЛП(ВыборкаЗначений["Аналитика"+Сч]);
						Иначе
							ЗаписьРегистра.Значение = ВыборкаЗначений["Аналитика"+Сч];
						КонецЕсли;
						
						Если Счетчик >= КоличествоЗаписейВНаборе Тогда
							НаборЗаписейАналитика.Записать(Ложь);
							СозданыЗаписи 	= Ложь;
							Счетчик 		= 1;
						Иначе
							Счетчик = Счетчик+1;
						КонецЕсли;
						
					КонецЦикла;
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если СозданыЗаписи Тогда
			НаборЗаписейАналитика.Записать(Ложь);
		КонецЕсли;
		
	КонецЕсли;
	
	// Дополнительные реквизиты отчета
	
	НаборЗаписей = РегистрыСведений.ЗначенияДополнительныхРеквизитовОтчета.СоздатьНаборЗаписей(); 
	НаборЗаписей.Отбор.ЭкземплярОтчета.Установить(Ссылка);
	
	Для Каждого Реквизит ИЗ Контекст.мДополнительныеРеквизиты Цикл
		
		Движение=НаборЗаписей.Добавить();
		Движение.ЭкземплярОтчета 				= Ссылка;
		Движение.ВидАналитики	 				= Реквизит.ВидАналитики;
		Движение.ДополнительныйРеквизитОтчета 	= Реквизит.ДополнительныйРеквизит;
		
		Если СоответствиеАналитики[Движение.ВидАналитики] = Истина Тогда
			//обрежем пробелы, если есть.
			Движение.Значение = СокрЛП(Реквизит.Значение);
		Иначе
			Движение.Значение = Реквизит.Значение;
		КонецЕсли;
		
	КонецЦикла;
	
	НаборЗаписей.Записать(Ложь);
	
	Контекст = Неопределено;
	
КонецПроцедуры // ЗаписатьДвиженияУниверсальногоОтчета()

// Таблица настроек для групп раскрытия.
//
Функция КэшДанныхПоГруппамРаскрытия(ВидОтчета, ЧислоАналитик)
	
	Запрос = Новый Запрос;
		
	КэшНастроекГруппРаскрытия = Новый ТаблицаЗначений;
	
	Для Инд = 1 По ЧислоАналитик Цикл
		
		СтроковыйИндекс = Формат(Инд, "ЧДЦ=0; ЧН=0");
		Если Не ЗначениеЗаполнено(КэшНастроекГруппРаскрытия) Тогда
			КэшНастроекГруппРаскрытия.Колонки.Добавить("ВидАналитики" + СтроковыйИндекс,Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.АналитикаОтчетов"));
			КэшНастроекГруппРаскрытия.Колонки.Добавить("ТипЗначенияАналитики" + СтроковыйИндекс);
			КэшНастроекГруппРаскрытия.Колонки.Добавить("ОбязательнаяАналитика" + СтроковыйИндекс);
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(КэшНастроекГруппРаскрытия) Тогда
		КэшНастроекГруппРаскрытия.Колонки.Добавить("ГруппаРаскрытия" 	,Новый ОписаниеТипов("СправочникСсылка.ГруппыРаскрытия"));
		КэшНастроекГруппРаскрытия.Колонки.Добавить("КодГруппыРаскрытия"	,БюджетнаяОтчетность.ПолучитьОписаниеТиповСтроки(20));
		КэшНастроекГруппРаскрытия.Колонки.Добавить("РазрешитьСовпаденияИзмерений",Новый ОписаниеТипов("Булево"));
		КэшНастроекГруппРаскрытия.Колонки.Добавить("ЧислоАналитик"		,БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(10));
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Владелец", ВидОтчета);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ГруппыРаскрытия.Ссылка КАК ГруппаРаскрытия,
	|	ГруппыРаскрытия.Код КАК КодГруппыРаскрытия,
	|	ГруппыРаскрытия.РазрешитьСовпаденияИзмерений,
	|	ЕСТЬNULL(ГруппыРаскрытияАналитика.НомерСтроки,0) КАК НомерАналитики,
	|	ГруппыРаскрытияАналитика.ВидАналитики,
	|	ГруппыРаскрытияАналитика.Обязательный КАК ОбязательнаяАналитика,
	|	ГруппыРаскрытияАналитика.ВидАналитики.ТипЗначения КАК ТипЗначенияАналитики
	|ИЗ
	|	Справочник.ГруппыРаскрытия КАК ГруппыРаскрытия
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГруппыРаскрытия.Аналитика КАК ГруппыРаскрытияАналитика
	|		ПО ГруппыРаскрытия.Ссылка = ГруппыРаскрытияАналитика.Ссылка
	|ГДЕ ГруппыРаскрытия.Владелец = &Владелец
	|
	|ИТОГИ ПО
	|	ГруппаРаскрытия";
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока Выборка.Следующий() Цикл
		
		ИскомаяСтрока = КэшНастроекГруппРаскрытия.Найти(Выборка.ГруппаРаскрытия,"ГруппаРаскрытия");
		Если ИскомаяСтрока = Неопределено Тогда
			ИскомаяСтрока = КэшНастроекГруппРаскрытия.Добавить();
			ИскомаяСтрока.ГруппаРаскрытия = Выборка.ГруппаРаскрытия;
		КонецЕсли;
		
		ИскомаяСтрока.КодГруппыРаскрытия = СокрЛП(Выборка.КодГруппыРаскрытия);
		ИскомаяСтрока.РазрешитьСовпаденияИзмерений = Выборка.РазрешитьСовпаденияИзмерений;
		Аналитики = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		ИскомаяСтрока.ЧислоАналитик = Аналитики.Количество();
		Пока Аналитики.Следующий() Цикл
			
			Если Аналитики.НомерАналитики = 0 Тогда
				Если ИскомаяСтрока.ЧислоАналитик = 1 Тогда
					ИскомаяСтрока.ЧислоАналитик = 0;
				КонецЕсли;
				Прервать;
			КонецЕсли;
			
			ИскомаяСтрока["ВидАналитики"+Аналитики.НомерАналитики] 			= Аналитики.ВидАналитики;
			ИскомаяСтрока["ТипЗначенияАналитики"+Аналитики.НомерАналитики] 	= Аналитики.ТипЗначенияАналитики;
			ИскомаяСтрока["ОбязательнаяАналитика"+Аналитики.НомерАналитики] = Аналитики.ОбязательнаяАналитика;				
			
		КонецЦикла;
	КонецЦикла;
	
	КэшНастроекГруппРаскрытия.Индексы.Добавить("ГруппаРаскрытия");		
	
	Возврат КэшНастроекГруппРаскрытия;
	
КонецФункции // КэшДанныхПоГруппамРаскрытия()

// Блокировка движений по регистрам.
//
Процедура УстановитьБлокировкуДвиженийДокумента(Ссылка) Экспорт

	Блокировка = Новый БлокировкаДанных;
	
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ЗначенияДополнительныхРеквизитовОтчета");
	ЭлементБлокировки.УстановитьЗначение("ЭкземплярОтчета",Ссылка);
	
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.АналитикаПоказателей");
	ЭлементБлокировки.УстановитьЗначение("ЭкземплярОтчета",Ссылка);
	
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ЗначенияПоказателейОтчетов");
	ЭлементБлокировки.УстановитьЗначение("ЭкземплярОтчета",Ссылка);
	
	Блокировка.Заблокировать();

КонецПроцедуры



Функция ПолучитьДетализируемыйКлассификаторПоКоду(КодКлассификатора,ИдентификаторКлассификатора) Экспорт
	
	Если НЕ ЗначениеЗаполнено(КодКлассификатора) Тогда
		Возврат ПланыВидовХарактеристик.АналитикаОтчетов.ПустаяСсылка();
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	АналитикаОтчетов.Ссылка КАК Ссылка,
		|	АналитикаОтчетов.Код КАК Код
		|ИЗ
		|	ПланВидовХарактеристик.АналитикаОтчетов КАК АналитикаОтчетов
		|ГДЕ
		|	АналитикаОтчетов.Код = &Код
		|	И АналитикаОтчетов.ПубличныйИдентификатор = &ПубличныйИдентификатор
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("Код", КодКлассификатора);
	Запрос.УстановитьПараметр("ПубличныйИдентификатор", ИдентификаторКлассификатора);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;
	
	Возврат ПланыВидовХарактеристик.АналитикаОтчетов.ПустаяСсылка();

КонецФункции

Функция ПолучитьДетализируемоеЗначениеКлассификатораПоКоду(КодЗначения,Классификатор) Экспорт
	
	Если НЕ ЗначениеЗаполнено(КодЗначения) Тогда
		Возврат Справочники.Субконто.ПустаяСсылка();
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Субконто.Ссылка КАК Ссылка,
		|	Субконто.Код КАК Код
		|ИЗ
		|	Справочник.Субконто КАК Субконто
		|ГДЕ
		|	Субконто.Код = &Код
		|	И Субконто.Владелец = &Владелец
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("Код", КодЗначения);
	Запрос.УстановитьПараметр("Владелец", Классификатор);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.Субконто.ПустаяСсылка();

КонецФункции

Функция ПолучитьДетализируемыйКлассификаторПоСсылке(СсылкаНаКлассификатор) Экспорт
	
	Если НЕ ЗначениеЗаполнено(СсылкаНаКлассификатор) Тогда
		Возврат ПланыВидовХарактеристик.АналитикаОтчетов.ПустаяСсылка();
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	АналитикаОтчетов.Ссылка КАК Ссылка,
		|	АналитикаОтчетов.Код КАК Код
		|ИЗ
		|	ПланВидовХарактеристик.АналитикаОтчетов КАК АналитикаОтчетовИсходныйКлассификатор
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.АналитикаОтчетов КАК АналитикаОтчетов
		|		ПО АналитикаОтчетовИсходныйКлассификатор.АналитикаВладелецКод = АналитикаОтчетов.Код
		|			И АналитикаОтчетовИсходныйКлассификатор.АналитикаВладелецПубличныйИдентификатор = АналитикаОтчетов.ПубличныйИдентификатор
		|ГДЕ
		|	АналитикаОтчетовИсходныйКлассификатор.Ссылка = &СсылкаНаКлассификатор
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("СсылкаНаКлассификатор", СсылкаНаКлассификатор);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;
	
	Возврат ПланыВидовХарактеристик.АналитикаОтчетов.ПустаяСсылка();

КонецФункции



