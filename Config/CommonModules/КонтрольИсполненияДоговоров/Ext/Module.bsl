	КонецЕсли;
	
	Запрос.УстановитьПараметр("КорректируемыйДокумент", КорректируемыйДокумент);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ИсполнениеДоговоровСПокупателями = РезультатЗапроса[0].Выгрузить();
	ИсполнениеОбязательствПоставщиками = РезультатЗапроса[1].Выгрузить();
	
	Если ДанныеДокумента.ЭтоКорректировка Тогда
		
		ПоляПоиска = "ВидДвижения, Организация, Контрагент, Договор, СчетРасчетов, Валюта, ИФО, КФО, КПС, КЭК, ИсполнитьДо, Сумма";
