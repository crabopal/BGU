	// Отступ.
	ДекорацияОтступ = ФормаДокумента.Элементы.Добавить("ПланированиеИКонтрольОтступ", Тип("ДекорацияФормы"), ГруппаЭлементов);
	ДекорацияОтступ.Вид = ВидДекорацииФормы.Надпись;
	ДекорацияОтступ.АвтоМаксимальнаяШирина = Ложь;
	ДекорацияОтступ.РастягиватьПоГоризонтали = Истина;
	
	// Запланировано платежей, план закупок / реализации.
	ЗапланированоПлатежей = ФормаДокумента.Элементы.Добавить("ПланированиеИКонтрольЗапланированоПлатежей", Тип("ПолеФормы"), ГруппаЭлементов);
	ЗапланированоПлатежей.Вид = ВидПоляФормы.ПолеВвода;
	ЗапланированоПлатежей.ПутьКДанным = "ИтогЗапланированоПлатежей";
	ЗапланированоПлатежей.ТолькоПросмотр = Истина;
	ЗапланированоПлатежей.Ширина = 16;
	ЗапланированоПлатежей.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Центр;
	
	ПланЗакупокРеализации = ФормаДокумента.Элементы.Добавить("ПланированиеИКонтрольПланЗакупокРеализации", Тип("ПолеФормы"), ГруппаЭлементов);
	ПланЗакупокРеализации.Вид = ВидПоляФормы.ПолеВвода;
	ПланЗакупокРеализации.ПутьКДанным = "ИтогПланЗакупокРеализации";
	ПланЗакупокРеализации.ТолькоПросмотр = Истина;
	ПланЗакупокРеализации.Ширина = 16;
	ПланЗакупокРеализации.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Центр;
	
	// Кнопка "Обновить итоги".
	КомандаОбновитьИтоги = ФормаДокумента.Команды.Добавить("ПланированиеИКонтрольОбновитьИтоги");
	КомандаОбновитьИтоги.Действие    = "Подключаемый_КонтрольИсполненияДоговоровОбновитьИтоги";
	КомандаОбновитьИтоги.Заголовок   = НСтр("ru='Обновить'");
	КомандаОбновитьИтоги.Подсказка   = НСтр("ru='Обновить итоги'");
	КомандаОбновитьИтоги.Картинка    = БиблиотекаКартинок.Обновить;
	КомандаОбновитьИтоги.Отображение = ОтображениеКнопки.Картинка;
	КомандаОбновитьИтоги.ИзменяетСохраняемыеДанные = Ложь;
	
	КнопкаОбновитьИтоги = ФормаДокумента.Элементы.Добавить("ПланированиеИКонтрольОбновитьИтоги", Тип("КнопкаФормы"), ГруппаЭлементов);
	КнопкаОбновитьИтоги.ИмяКоманды = "ПланированиеИКонтрольОбновитьИтоги";
	КнопкаОбновитьИтоги.Вид = ВидКнопкиФормы.Гиперссылка;
