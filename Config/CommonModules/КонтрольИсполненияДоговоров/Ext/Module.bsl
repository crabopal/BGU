
#Область ПрограммныйИнтерфейс

Функция ВедетсяГрафикПлатежейПоДоговору(Договор) Экспорт
	
	Если ЗначениеЗаполнено(Договор) Тогда
		// Проверим установку признака в договоре.
		ВестиГрафикПлатежей = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор, "ВестиГрафикПлатежей");
		Возврат ?(ВестиГрафикПлатежей = Неопределено, Ложь, ВестиГрафикПлатежей);
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Функция ВедетсяГрафикПлатежейПоСчетуРасчетов(СчетРасчетов, ЭтоПоступление) Экспорт
	
	Если ЗначениеЗаполнено(СчетРасчетов) Тогда
		
		Если ЭтоПоступление Тогда
			// Поступление кредитных средств на счет учрежения (Дт 201.00 Кт 301.00)
			// не отражается в графике платежей по кредитному договору,
			// отражаются только выплаты по кредиту полученному.
			Возврат БухгалтерскийУчет.СчетВИерархии(СчетРасчетов, "205.00,209.00,206.00,302.00,207.00");
		Иначе
			// Перечисление кредитных средств на счет заемщику (Дт 207.00 Кт 201.00)
			// не отражается в графике платежей по кредитному договору,
			// отражаются только входящие платежи по возврату предоставленного кредита с процентами.
			Возврат БухгалтерскийУчет.СчетВИерархии(СчетРасчетов, "205.00,209.00,206.00,302.00,301.00");
		КонецЕсли;
		
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Функция ЕстьГрафикПоДоговору(Договор, ВидГрафика = "") Экспорт
	
	Если НЕ ЗначениеЗаполнено(Договор) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Договор", Договор);
	
	// Будем искать хотя бы одно движение-приход (план платежей).
	ТекстЗапросаЕстьГрафикПлатежей =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ОплатаПоставщикамКредиторам.Договор КАК Договор,
	|	ОплатаПоставщикамКредиторам.Сумма КАК Сумма
	|ИЗ
	|	РегистрНакопления.ОплатаПоставщикамКредиторам КАК ОплатаПоставщикамКредиторам
	|ГДЕ
	|	ОплатаПоставщикамКредиторам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|	И ОплатаПоставщикамКредиторам.Договор = &Договор";
	
	// Будем искать хотя бы одно движение-приход (план-график закупок, реализации).
	ТекстЗапросаЕстьПланГрафикИсполнения =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИсполнениеОбязательствПоставщиками.Договор КАК Договор,
	|	ИсполнениеОбязательствПоставщиками.Сумма КАК Сумма
	|ИЗ
	|	РегистрНакопления.ИсполнениеОбязательствПоставщиками КАК ИсполнениеОбязательствПоставщиками
	|ГДЕ
	|	ИсполнениеОбязательствПоставщиками.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|	И ИсполнениеОбязательствПоставщиками.Договор = &Договор";
	
	Если ВидГрафика = "ГрафикПлатежей" Тогда
		Запрос.Текст = ТекстЗапросаЕстьГрафикПлатежей;
	ИначеЕсли ВидГрафика = "ПланГрафикИсполнения" Тогда
		Запрос.Текст = ТекстЗапросаЕстьПланГрафикИсполнения;
	Иначе // Любой график.
		Запрос.Текст = ТекстЗапросаЕстьГрафикПлатежей + "
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|" + ТекстЗапросаЕстьПланГрафикИсполнения;
	КонецЕсли;
	
	ВидДоговора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор, "ВидДоговора");
	Если ВидДоговора <> Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком
		И ВидДоговора <> Перечисления.ВидыДоговоровКонтрагентов.ПолученныйКредит
		И ВидДоговора <> Перечисления.ВидыДоговоровКонтрагентов.ВыпускЦенныхБумаг
		И ВидДоговора <> Перечисления.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии Тогда // Смотрим в других регистрах.
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ОплатаПоставщикамКредиторам", "ОплатаОтПокупателейДебиторов");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИсполнениеОбязательствПоставщиками", "ИсполнениеДоговоровСПокупателями");
	КонецЕсли;
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

Функция ГрафикПлатежейПоДоговору(Организация, Договор, Периодичность = "Месяц", ДатаНачала = Неопределено, ДатаОкончания = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ГрафикПлатежей.Организация КАК Организация,
	|	ГрафикПлатежей.Контрагент КАК Контрагент,
	|	ГрафикПлатежей.Договор КАК Договор,
	|	ГрафикПлатежей.ВидРасчетов КАК ВидРасчетов,
	|	ГрафикПлатежей.Валюта КАК Валюта,
	|	ГрафикПлатежей.ИФО КАК ИФО,
	|	ГрафикПлатежей.КФО КАК КФО,
	|	ГрафикПлатежей.КПС КАК КПС,
	|	ГрафикПлатежей.КЭК КАК КЭК,
	|	ГрафикПлатежей.ДопКлассификация КАК ДопКлассификация,
	|	ГрафикПлатежей.КодМероприятия КАК КодМероприятия,
	|	ГрафикПлатежей.КодЦели КАК КодЦели,
	|	ГрафикПлатежей.СчетРасчетов КАК СчетРасчетов,
	|	ГрафикПлатежей.ОплатитьДо КАК ОплатитьДо,
	|	ГрафикПлатежей.Период КАК Период,
	|	ГрафикПлатежей.СуммаПриход КАК Сумма
	|ИЗ
	|	РегистрНакопления.ОплатаПоставщикамКредиторам.Обороты(
	|			&ДатаНачала,
	|			&ДатаОкончания,
	|			Месяц,
	|			Организация = &Организация
	|				И Договор В (&Договор)
	|				И Договор.ВидДоговора В (&ВидыДоговоровСПоставщикамиКредиторами)) КАК ГрафикПлатежей
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ГрафикПлатежей.Организация,
	|	ГрафикПлатежей.Контрагент,
	|	ГрафикПлатежей.Договор,
	|	ГрафикПлатежей.ВидРасчетов,
	|	ГрафикПлатежей.Валюта,
	|	ГрафикПлатежей.ИФО,
	|	ГрафикПлатежей.КФО,
	|	ГрафикПлатежей.КПС,
	|	ГрафикПлатежей.КЭК,
	|	ГрафикПлатежей.ДопКлассификация,
	|	ГрафикПлатежей.КодМероприятия,
	|	ГрафикПлатежей.КодЦели,
	|	ГрафикПлатежей.СчетРасчетов,
	|	ГрафикПлатежей.ОплатитьДо,
	|	ГрафикПлатежей.Период,
	|	ГрафикПлатежей.СуммаПриход
	|ИЗ
	|	РегистрНакопления.ОплатаОтПокупателейДебиторов.Обороты(
	|			&ДатаНачала,
	|			&ДатаОкончания,
	|			Месяц,
	|			Организация = &Организация
	|				И Договор В (&Договор)
	|				И Договор.ВидДоговора В (&ВидыДоговоровСПокупателямиДебиторами)) КАК ГрафикПлатежей
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОплатитьДо";
	Запрос.УстановитьПараметр("Организация",   Организация);
	Запрос.УстановитьПараметр("Договор",       Договор);
	Запрос.УстановитьПараметр("ДатаНачала",    ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	
	Запрос.УстановитьПараметр("ВидыДоговоровСПоставщикамиКредиторами", КонтрольИсполненияДоговоровКлиентСервер.ВидыДоговоровСПоставщикамиКредиторами());
	Запрос.УстановитьПараметр("ВидыДоговоровСПокупателямиДебиторами", КонтрольИсполненияДоговоровКлиентСервер.ВидыДоговоровСПокупателямиДебиторами());
	
	Если Периодичность <> "Месяц" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Месяц", Периодичность);
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ГрафикИсполненияПоДоговору(Организация, Договор, Периодичность = "Месяц", ДатаНачала = Неопределено, ДатаОкончания = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ГрафикИсполнения.Организация КАК Организация,
	|	ГрафикИсполнения.Контрагент КАК Контрагент,
	|	ГрафикИсполнения.Договор КАК Договор,
	|	ГрафикИсполнения.Валюта КАК Валюта,
	|	ГрафикИсполнения.ИФО КАК ИФО,
	|	ГрафикИсполнения.КФО КАК КФО,
	|	ГрафикИсполнения.КПС КАК КПС,
	|	ГрафикИсполнения.КЭК КАК КЭК,
	|	ГрафикИсполнения.СчетРасчетов КАК СчетРасчетов,
	|	ГрафикИсполнения.ИсполнитьДо КАК ИсполнитьДо,
	|	ГрафикИсполнения.Период КАК Период,
	|	ГрафикИсполнения.СуммаПриход КАК Сумма
	|ИЗ
	|	РегистрНакопления.ИсполнениеОбязательствПоставщиками.Обороты(
	|			&ДатаНачала,
	|			&ДатаОкончания,
	|			Месяц,
	|			Организация = &Организация
	|				И Договор В (&Договор)
	|				И Договор.ВидДоговора В (&ВидыДоговоровСПоставщикамиКредиторами)) КАК ГрафикИсполнения
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ГрафикИсполнения.Организация,
	|	ГрафикИсполнения.Контрагент,
	|	ГрафикИсполнения.Договор,
	|	ГрафикИсполнения.Валюта,
	|	ГрафикИсполнения.ИФО,
	|	ГрафикИсполнения.КФО,
	|	ГрафикИсполнения.КПС,
	|	ГрафикИсполнения.КЭК,
	|	ГрафикИсполнения.СчетРасчетов,
	|	ГрафикИсполнения.ИсполнитьДо,
	|	ГрафикИсполнения.Период,
	|	ГрафикИсполнения.СуммаПриход
	|ИЗ
	|	РегистрНакопления.ИсполнениеДоговоровСПокупателями.Обороты(
	|			&ДатаНачала,
	|			&ДатаОкончания,
	|			Месяц,
	|			Организация = &Организация
	|				И Договор В (&Договор)
	|				И Договор.ВидДоговора В (&ВидыДоговоровСПокупателямиДебиторами)) КАК ГрафикИсполнения
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИсполнитьДо";
	Запрос.УстановитьПараметр("Организация",   Организация);
	Запрос.УстановитьПараметр("Договор",       Договор);
	Запрос.УстановитьПараметр("ДатаНачала",    ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	
	ВидыДоговоровСПоставщикамиКредиторами = Новый Массив;
	ВидыДоговоровСПоставщикамиКредиторами.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком);
	ВидыДоговоровСПоставщикамиКредиторами.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии);
	Запрос.УстановитьПараметр("ВидыДоговоровСПоставщикамиКредиторами", ВидыДоговоровСПоставщикамиКредиторами);
	
	ВидыДоговоровСПокупателямиДебиторами = Новый Массив;
	ВидыДоговоровСПокупателямиДебиторами.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
	ВидыДоговоровСПокупателямиДебиторами.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СОтправителемТрансферта);
	Запрос.УстановитьПараметр("ВидыДоговоровСПокупателямиДебиторами", ВидыДоговоровСПокупателямиДебиторами);
	
	Если Периодичность <> "Месяц" Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Месяц", Периодичность);
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция СписокОчередныхПлатежейПоГрафику(Организация, Договор, Отбор, ДоступенРежимАвто = Истина) Экспорт
	
	СписокОчередныхПлатежей = Новый СписокЗначений;
	
	Если ДоступенРежимАвто Тогда
		СписокОчередныхПлатежей.Добавить(Дата('00010101'), НСтр("ru = '<авто>'"));
	КонецЕсли;
	
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, "ВидДоговора,ВестиГрафикПлатежей");
	
	ИспользоватьДетализациюПоКОСГУВГрафиках = ИспользоватьДетализациюПоКОСГУВГрафикахПоДоговорам(РеквизитыДоговора.ВидДоговора);
	Если Не ИспользоватьДетализациюПоКОСГУВГрафиках Тогда
		Если Отбор.Свойство("КЭК") Тогда
			Отбор.Удалить("КЭК");
		КонецЕсли;
	КонецЕсли;
	
	ИспользоватьДополнительнуюАналитикуВГрафикахПлатежей = ИспользоватьДополнительнуюАналитикуВГрафикахПлатежей(РеквизитыДоговора.ВидДоговора);
	Если Не ИспользоватьДополнительнуюАналитикуВГрафикахПлатежей Тогда
		Если Отбор.Свойство("ДопКлассификация") Тогда
			Отбор.Удалить("ДопКлассификация");
		КонецЕсли;
		Если Отбор.Свойство("КодМероприятия") Тогда
			Отбор.Удалить("КодМероприятия");
		КонецЕсли;
		Если Отбор.Свойство("КодЦели") Тогда
			Отбор.Удалить("КодЦели");
		КонецЕсли;
	КонецЕсли;
	
	ВидыДоговоровСПокупателямиДебиторами = КонтрольИсполненияДоговоровКлиентСервер.ВидыДоговоровСПокупателямиДебиторами();
	ВидыДоговоровСПоставщикамиКредиторами = КонтрольИсполненияДоговоровКлиентСервер.ВидыДоговоровСПоставщикамиКредиторами();
	
	НеисполненныеПлатежи = Новый ТаблицаЗначений;
	Если ВидыДоговоровСПоставщикамиКредиторами.Найти(РеквизитыДоговора.ВидДоговора) <> Неопределено Тогда
		
		НеисполненныеПлатежи = КонтрольИсполненияДоговоров.НеисполненныеПлатежиПоставщикамКредиторам(Отбор, Организация);
		НеисполненныеПлатежи.Свернуть("ЭтоПоступление,ОплатитьДо,Валюта", "Сумма");
		НеисполненныеПлатежи.Сортировать("ОплатитьДо");
		
	ИначеЕсли ВидыДоговоровСПокупателямиДебиторами.Найти(РеквизитыДоговора.ВидДоговора) <> Неопределено Тогда
		
		НеисполненныеПлатежи = КонтрольИсполненияДоговоров.НеисполненныеПлатежиОтПокупателейДебиторов(Отбор, Организация);
		НеисполненныеПлатежи.Свернуть("ЭтоПоступление,ОплатитьДо,Валюта", "Сумма");
		НеисполненныеПлатежи.Сортировать("ОплатитьДо");
		
	КонецЕсли;
	
	Для Каждого Платеж Из НеисполненныеПлатежи Цикл
		
		Если Отбор.Свойство("ЭтоПоступление") И (Отбор.ЭтоПоступление <> Платеж.ЭтоПоступление) Тогда
			Продолжить;
		КонецЕсли;
		
		СписокОчередныхПлатежей.Добавить(Платеж.ОплатитьДо,
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1: %2'"),
				Формат(Платеж.ОплатитьДо, "ДЛФ=Д"),
				ОбщегоНазначенияБГУ.ФорматСумм(Платеж.Сумма, Платеж.Валюта, "0") ));
		
	КонецЦикла;
	
	Возврат СписокОчередныхПлатежей;
	
КонецФункции

// Рассчитывает предельную дату оплату задолженности (ОплатитьДо) на основе срока оплаты задолженности, установленного в договоре.
//
Функция ПредельнаяДатаОплатыЗадолженности(ДатаОперации, Договор) Экспорт
	
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, "СрокОплаты,СрокОплатыВРабочихДнях");
	
	Если РеквизитыДоговора.СрокОплаты > 0 Тогда
		
		Если РеквизитыДоговора.СрокОплатыВРабочихДнях Тогда // В рабочих днях.
			ПроизводственныйКалендарь = КалендарныеГрафики.ОсновнойПроизводственныйКалендарь();
			Возврат КалендарныеГрафики.ДатаПоКалендарю(ПроизводственныйКалендарь, ДатаОперации, РеквизитыДоговора.СрокОплаты, Ложь);
		Иначе // В календарных днях.
			Возврат ДатаОперации + РеквизитыДоговора.СрокОплаты * (24*60*60);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Дата('00010101'); // Не определена, ОплатитьДо указывается вручную.
	
КонецФункции

// Базовые функции получения информации по регистрам графиков исполнения договоров.

Функция НеисполненныеПлатежиПоставщикамКредиторам(ОтборОстатков, Организация, НаДату = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МоментВремени", НаДату);
	Запрос.УстановитьПараметр("Организация",   Организация);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОплатаПоставщикамКредиторамОстатки.Организация КАК Организация,
	|	ОплатаПоставщикамКредиторамОстатки.Контрагент КАК Контрагент,
	|	ОплатаПоставщикамКредиторамОстатки.Договор КАК Договор,
	|	ОплатаПоставщикамКредиторамОстатки.ВидРасчетов КАК ВидРасчетов,
	|	ОплатаПоставщикамКредиторамОстатки.Валюта КАК Валюта,
	|	ОплатаПоставщикамКредиторамОстатки.ИФО КАК ИФО,
	|	ОплатаПоставщикамКредиторамОстатки.КФО КАК КФО,
	|	ОплатаПоставщикамКредиторамОстатки.КПС КАК КПС,
	|	ОплатаПоставщикамКредиторамОстатки.КЭК КАК КЭК,
	|	ОплатаПоставщикамКредиторамОстатки.СчетРасчетов КАК СчетРасчетов,
	|	ОплатаПоставщикамКредиторамОстатки.ДопКлассификация КАК ДопКлассификация,
	|	ОплатаПоставщикамКредиторамОстатки.КодМероприятия КАК КодМероприятия,
	|	ОплатаПоставщикамКредиторамОстатки.КодЦели КАК КодЦели,
	|	ОплатаПоставщикамКредиторамОстатки.ОплатитьДо КАК ОплатитьДо,
	|	ВЫБОР
	|		КОГДА ОплатаПоставщикамКредиторамОстатки.СуммаОстаток > 0
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЭтоПоступление,
	|	ОплатаПоставщикамКредиторамОстатки.СуммаОстаток КАК Сумма
	|ИЗ
	|	РегистрНакопления.ОплатаПоставщикамКредиторам.Остатки(
	|			&МоментВремени,
	|			Организация = &Организация
	|				И &УсловиеПоИФО
	|				И &УсловиеПоКФО
	|				И &УсловиеПоКПС
	|				И &УсловиеПоКЭК
	|				И &УсловиеПоСчетРасчетов
	|				И &УсловиеПоКонтрагент
	|				И &УсловиеПоДоговор
	|				И &УсловиеПоВалюта
	|				И &УсловиеПоВидРасчетов
	|				И &УсловиеПоКодЦели
	|				И &УсловиеПоКодМероприятия
	|				И &УсловиеПоДопКлассификация
	|				И &УсловиеПоОплатитьДо) КАК ОплатаПоставщикамКредиторамОстатки
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОплатитьДо";
	
	УстановитьОтборОстатков(Запрос, ОтборОстатков);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

