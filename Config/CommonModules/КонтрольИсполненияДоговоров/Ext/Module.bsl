	Результат = Запрос.ВыполнитьПакет();
	
	ТаблицаОстаткиПоСчетам = Результат[НомераТаблиц.ОстаткиПоСчетам].Выгрузить();
	АнализЗадолженности = Результат[НомераТаблиц.СводныеПоказатели].Выгрузить();
	
	// Режим заполнения с учетом исправлений ошибок прошлых лет.
	Если ЗаполнятьСУчетомИсправленияОшибокПрошлыхЛет Тогда
		СкорректироватьТаблицуОстатковПоДаннымИсправленияОшибокПрошлыхЛет(ТаблицаОстаткиПоСчетам,
			Организация, НаДату, ПараметрыАнализаЗадолженности.КонецПериодаИсправленияОшибокПрошлыхЛет, Отбор);
		СкорректироватьТаблицуАнализаПоДаннымИсправленияОшибокПрошлыхЛет(АнализЗадолженности,
			Организация, НаДату, ПараметрыАнализаЗадолженности.КонецПериодаИсправленияОшибокПрошлыхЛет, Отбор);
	КонецЕсли;
	
	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Любой));
	// Классификация задолженности.
	АнализЗадолженности.Колонки.Добавить("ВидЗадолженности",
		Новый ОписаниеТипов("ПеречислениеСсылка.ВидыЗадолженности"));
	АнализЗадолженности.Колонки.Добавить("ТипЗадолженности", // "Дт205, Дт206, Дт207, Дт208, Кт205, Кт208, Кт302, Кт301, Кт30401".
		Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(10)));
	АнализЗадолженности.Колонки.Добавить("СчетОстатков", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	// Вычисляемые показатели.
	АнализЗадолженности.Колонки.Добавить("Остаток",                 ОписаниеТипаСуммы); // Остаток задолженности на счете расчетов.
	АнализЗадолженности.Колонки.Добавить("Краткосрочная",           ОписаниеТипаСуммы); // Менее 1 года от отчетной даты = краткосрочная (итого).
	АнализЗадолженности.Колонки.Добавить("Долгосрочная",            ОписаниеТипаСуммы); // Более 1 года от отчетной даты = долгосрочная (итого).
	АнализЗадолженности.Колонки.Добавить("ДолгосрочнаяБолее2Лет",   ОписаниеТипаСуммы); // Более 2 лет от отчетной даты.
	АнализЗадолженности.Колонки.Добавить("ДолгосрочнаяБолее3Лет",   ОписаниеТипаСуммы); // Более 3 лет от отчетной даты.
	АнализЗадолженности.Колонки.Добавить("ДолгосрочнаяБолее5Лет",   ОписаниеТипаСуммы); // Более 5 лет от отчетной даты.
	АнализЗадолженности.Колонки.Добавить("Просроченная",            ОписаниеТипаСуммы); // Менее отчетной даты = просроченная итого.
	АнализЗадолженности.Колонки.Добавить("ПросроченнаяБолее30Дней", ОписаниеТипаСуммы); // Просроченная более 30 дней.
	АнализЗадолженности.Колонки.Добавить("ПросроченнаяБолее60Дней", ОписаниеТипаСуммы); // Просроченная более 60 дней.
	АнализЗадолженности.Колонки.Добавить("ПросроченнаяБолее90Дней", ОписаниеТипаСуммы); // Просроченная более 90 дней.
	АнализЗадолженности.Колонки.Добавить("ПросроченнаяБолее180Дней", ОписаниеТипаСуммы); // Просроченная более 180 дней.
	АнализЗадолженности.Колонки.Добавить("ПросроченнаяБолее1Года",  ОписаниеТипаСуммы); // Просроченная более 1 года от отчетной даты.
	АнализЗадолженности.Колонки.Добавить("ПросроченнаяБолее3Лет",   ОписаниеТипаСуммы); // Просроченная более 3-х лет от отчетной даты.
	АнализЗадолженности.Колонки.Добавить("ТекущаяКраткосрочная",    ОписаниеТипаСуммы); // Краткосрочная за исключением просроченной.
	АнализЗадолженности.Колонки.Добавить("КраткосрочнаяДоКонцаГода",ОписаниеТипаСуммы); // Краткосрочная до конца текущего года.
	
	// Колонки с суммами, пересчитанными в рубли (валюту регламентированного учета).
	АнализЗадолженности.Колонки.Добавить("ОстатокРуб", ОписаниеТипаСуммы); // Остаток задолженности на счете расчетов.
	КолонкиПросроченнаяКраткосрочнаяДолгосрочная = Новый Массив;
	КоличествоКолонок = АнализЗадолженности.Колонки.Количество();
	Для ИндексКолонки = 26 По КоличествоКолонок - 1 Цикл
		ТекущаяКолонка = АнализЗадолженности.Колонки[ИндексКолонки];
		Если СтрНайти(ТекущаяКолонка.Имя, "Просроченная") > 0
			ИЛИ СтрНайти(ТекущаяКолонка.Имя, "Краткосрочная") > 0
			ИЛИ СтрНайти(ТекущаяКолонка.Имя, "Долгосрочная") > 0 Тогда
			АнализЗадолженности.Колонки.Добавить(ТекущаяКолонка.Имя + "Руб", ОписаниеТипаСуммы);
			КолонкиПросроченнаяКраткосрочнаяДолгосрочная.Добавить(ТекущаяКолонка.Имя);
		КонецЕсли;
	КонецЦикла;
	
	АнализЗадолженности.Колонки.Добавить("ЭтоНераспределенныйОстаток", Новый ОписаниеТипов("Булево"));
	
	АнализЗадолженности.Индексы.Добавить("ЭтоНераспределенныйОстаток,Организация,КФО,КПС,СчетРасчетов,Контрагент,Договор,Валюта"+
		?(ИспользоватьУчетПоИФО, ",ИФО", ""));
	
	// Информация, связанная с договорами контрагентов.
	СписокДоговоров = ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(ТаблицаОстаткиПоСчетам.ВыгрузитьКолонку("Договор"));
	Если ПолучитьФункциональнуюОпцию("СрокИсполненияВРегистреСрокиИсполненияИСуммыОбязательств") Тогда
		ДатаСведений = ?(ЗаполнятьСУчетомИсправленияОшибокПрошлыхЛет, ПараметрыАнализаЗадолженности.КонецПериодаИсправленияОшибокПрошлыхЛет, НаДату);
		СвойстваДоговоров = УчетРасчетов.СрокиИсполненияИСуммыОбязательствПоДоговорам(СписокДоговоров, ДатаСведений);
	Иначе // Дата исполнения указывается в справочнике "Договоры" в реквизите "Окончание" (закладка "Свойства").
		СвойстваДоговоров = ИнвентаризацияСервер.ПолучитьДатыОкончанияДоговоров(СписокДоговоров);
	КонецЕсли;
	
	Для Каждого ОстаткиПоСчетам Из ТаблицаОстаткиПоСчетам Цикл
		
		НераспределеннаяСуммаДт = ОстаткиПоСчетам.ОстатокДт;
		НераспределеннаяСуммаКт = ОстаткиПоСчетам.ОстатокКт;
		Если НераспределеннаяСуммаДт = 0 И НераспределеннаяСуммаКт = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ЭтоДт205 = БухгалтерскийУчет.СчетВИерархии(ОстаткиПоСчетам.СчетРасчетов, "205.00,209.00") И (НераспределеннаяСуммаДт > 0);
		ЭтоКт205 = БухгалтерскийУчет.СчетВИерархии(ОстаткиПоСчетам.СчетРасчетов, "205.00,209.00") И (НераспределеннаяСуммаКт > 0);
		ЭтоДт206 = БухгалтерскийУчет.СчетВИерархии(ОстаткиПоСчетам.СчетРасчетов, "206.00") И (НераспределеннаяСуммаДт > 0);
		ЭтоКт302 = БухгалтерскийУчет.СчетВИерархии(ОстаткиПоСчетам.СчетРасчетов, "302.00") И (НераспределеннаяСуммаКт > 0);
		ЭтоДт207 = БухгалтерскийУчет.СчетВИерархии(ОстаткиПоСчетам.СчетРасчетов, "207.00") И (НераспределеннаяСуммаДт > 0);
		ЭтоКт301 = БухгалтерскийУчет.СчетВИерархии(ОстаткиПоСчетам.СчетРасчетов, "301.00") И (НераспределеннаяСуммаКт > 0);
		ЭтоДт208 = БухгалтерскийУчет.СчетВИерархии(ОстаткиПоСчетам.СчетРасчетов, "208.00") И (НераспределеннаяСуммаДт > 0);
		ЭтоКт208 = БухгалтерскийУчет.СчетВИерархии(ОстаткиПоСчетам.СчетРасчетов, "208.00") И (НераспределеннаяСуммаКт > 0);
		ЭтоКт30401 = БухгалтерскийУчет.СчетВИерархии(ОстаткиПоСчетам.СчетРасчетов, "304.01") И (НераспределеннаяСуммаКт > 0);
		
		Если ЭтоДт206 Тогда // Для остатков по 206.00 данные графиков по договорам с контрагентами ищем по счетам 302.00.
			СчетРасчетов = СчетРасчетовПоСчетуАвансовВыданных(ОстаткиПоСчетам.СчетРасчетов, НаДату, Организация);
		Иначе
			СчетРасчетов = ОстаткиПоСчетам.СчетРасчетов;
		КонецЕсли;
		
		ВестиГрафикПлатежей = ОстаткиПоСчетам.ВестиГрафикПлатежей;
		ВестиПланГрафикИсполнения = ОстаткиПоСчетам.ВестиПланГрафикИсполнения;
		
		НайденныеСтроки = Новый Массив;
		Если ЭтоДт205 И Не ВестиГрафикПлатежей Тогда
			// Дебетовый остаток 205.00, 209.00 (дебиторская задолженность покупателей).
			// Ожидаем оплату от покупателей (дебиторов), при этом график платежей по договору не ведется.
		ИначеЕсли ЭтоКт205 И Не ВестиПланГрафикИсполнения Тогда
			// Кредитовый остаток 205.00, 209.00 (аванс от покупателя).
			// Ожидаем реализацию товаров, услуг, работ покупателю, при этом план-график реализации по договору не ведется.
		ИначеЕсли ЭтоДт206 И Не ВестиПланГрафикИсполнения Тогда
			// Дебетовый остаток 206.00 (аванс выданный).
			// Ожидаем поступление от поставщика, при этом план-график закупок по договору не ведется.
		ИначеЕсли ЭтоКт302 И Не ВестиГрафикПлатежей Тогда
			// Кредитовый остаток 302.00 (кредиторская задолженность поставщиков).
			// Ожидаем оплату поставщику (кредитору), при этом график платежей по договору не ведется.
		ИначеЕсли ЭтоДт207 И Не ВестиГрафикПлатежей Тогда
			// Дебетовый остаток 207.00 (дебиторская задолженность по выданным кредитам, займам).
			// Ожидаем оплату от дебитора, при этом график платежей по договору не ведется.
		ИначеЕсли ЭтоКт301 И Не ВестиГрафикПлатежей Тогда
			// Кредитовый остаток 301.00 (кредиторская задолженность по полученным кредитам, займам).
			// Ожидаем оплату кредитору, при этом график платежей по договору не ведется.
		ИначеЕсли ЭтоДт208 Или ЭтоКт208 Тогда
			// По счетам 208.00 используется только упрощенный режим классификации задолженности по срокам, графики не используются.
			
		Иначе // Поиск данных графиков по договору.
			ОтборПоОстаткам = Новый Структура("Организация,КФО,КПС,Контрагент,Договор");
			ЗаполнитьЗначенияСвойств(ОтборПоОстаткам, ОстаткиПоСчетам);
			ОтборПоОстаткам.Вставить("СчетРасчетов", СчетРасчетов);
			ОтборПоОстаткам.Вставить("ЭтоНераспределенныйОстаток", Ложь);
			Если ИспользоватьУчетПоИФО Тогда
				ОтборПоОстаткам.Вставить("ИФО", ОстаткиПоСчетам.ИФО);
			КонецЕсли;
			Если ИспользоватьВалютныйУчет И ЗначениеЗаполнено(ОстаткиПоСчетам.Валюта) Тогда
				ОтборПоОстаткам.Вставить("Валюта", ОстаткиПоСчетам.Валюта);
			Иначе // В графиках по договорам с контрагентами измерение Валюта заполняется всегда, даже если не ведется учет расчетов в иностранных валютах. 
				ОтборПоОстаткам.Вставить("Валюта", ВалютаРегламентированногоУчета);
			КонецЕсли;
			НайденныеСтроки = АнализЗадолженности.НайтиСтроки(ОтборПоОстаткам);
		КонецЕсли;
		
		Для Каждого СтрокаГрафика Из НайденныеСтроки Цикл
			
			ПогашеннаяСуммаДт = 0;
			ПогашеннаяСуммаКт = 0;
			
			Если ЭтоДт205 Тогда // Дебетовый остаток 205.00, 209.00.
				
				Если ИспользоватьВалютныйУчет И ЗначениеЗаполнено(ОстаткиПоСчетам.Валюта) И ОстаткиПоСчетам.Валюта <> ВалютаРегламентированногоУчета Тогда
					КурсРасчетов = ?(ОстаткиПоСчетам.ОстатокДт = 0, 1, ОстаткиПоСчетам.ОстатокДтРуб / ОстаткиПоСчетам.ОстатокДт);
				Иначе
					КурсРасчетов = 1;
				КонецЕсли;
				
				// Ожидаем оплату от покупателей (дебиторов). Собираем показатели по рег. ОплатаОтПокупателейДебиторов.
				ПогашеннаяСуммаДт = АнализЗадолженностиРассчитатьВычисляемыеПоказателиВСтроке(СтрокаГрафика, НаДату,
					НераспределеннаяСуммаДт,
					СтрокаГрафика.СуммаПросроченныеПлатежиОтПокупателейДебиторов,
					СтрокаГрафика.ВсегоЗапланированоПлатежиОтПокупателейДебиторов,
					КурсРасчетов,
					КолонкиПросроченнаяКраткосрочнаяДолгосрочная);
				
				Если ПогашеннаяСуммаДт <> 0 Тогда
					СтрокаГрафика.ВидЗадолженности = Перечисления.ВидыЗадолженности.Дебиторская;
					СтрокаГрафика.ТипЗадолженности = "Дт205";
					СтрокаГрафика.СчетОстатков = ОстаткиПоСчетам.СчетРасчетов;
				КонецЕсли;
				
			ИначеЕсли ЭтоКт205 Тогда // Кредитовый остаток 205.00, 209.00.
				
				Если ИспользоватьВалютныйУчет И ЗначениеЗаполнено(ОстаткиПоСчетам.Валюта) И ОстаткиПоСчетам.Валюта <> ВалютаРегламентированногоУчета Тогда
					КурсРасчетов = ?(ОстаткиПоСчетам.ОстатокКт = 0, 1, ОстаткиПоСчетам.ОстатокКтРуб / ОстаткиПоСчетам.ОстатокКт);
				Иначе
					КурсРасчетов = 1;
				КонецЕсли;
				
				// Аванс, ожидаем реализацию товаров, услуг, работ покупателю. Собираем показатели по рег. ИсполнениеДоговоровСПокупателями.
				ПогашеннаяСуммаКт = АнализЗадолженностиРассчитатьВычисляемыеПоказателиВСтроке(СтрокаГрафика, НаДату,
					НераспределеннаяСуммаКт,
					СтрокаГрафика.СуммаПросроченныеОбязательстваПоДоговорамСПокупателями,
					СтрокаГрафика.ВсегоЗапланированоОбязательстваПоДоговорамСПокупателями,
					КурсРасчетов,
					КолонкиПросроченнаяКраткосрочнаяДолгосрочная);
				
				Если ПогашеннаяСуммаКт <> 0 Тогда
					СтрокаГрафика.ВидЗадолженности = Перечисления.ВидыЗадолженности.Кредиторская;
					СтрокаГрафика.ТипЗадолженности = "Кт205";
					СтрокаГрафика.СчетОстатков = ОстаткиПоСчетам.СчетРасчетов;
				КонецЕсли;
				
			ИначеЕсли ЭтоДт206 Тогда // Дебетовый остаток 206.00. Кредитовый остаток невозможен, т.к. счет активный.
				
				Если ИспользоватьВалютныйУчет И ЗначениеЗаполнено(ОстаткиПоСчетам.Валюта) И ОстаткиПоСчетам.Валюта <> ВалютаРегламентированногоУчета Тогда
					КурсРасчетов = ?(ОстаткиПоСчетам.ОстатокДт = 0, 1, ОстаткиПоСчетам.ОстатокДтРуб / ОстаткиПоСчетам.ОстатокДт);
				Иначе
					КурсРасчетов = 1;
				КонецЕсли;
				
				// Ожидаем поступление от поставщика. Собираем показатели по рег. ИсполнениеОбязательствПоставщиками.
				ПогашеннаяСуммаДт = АнализЗадолженностиРассчитатьВычисляемыеПоказателиВСтроке(СтрокаГрафика, НаДату,
					НераспределеннаяСуммаДт,
					СтрокаГрафика.СуммаПросроченныеОбязательстваПоставщиков,
					СтрокаГрафика.ВсегоЗапланированоОбязательстваПоставщиков,
					КурсРасчетов,
					КолонкиПросроченнаяКраткосрочнаяДолгосрочная);
				
				Если ПогашеннаяСуммаДт <> 0 Тогда
					СтрокаГрафика.ВидЗадолженности = Перечисления.ВидыЗадолженности.Дебиторская;
					СтрокаГрафика.ТипЗадолженности = "Дт206";
					СтрокаГрафика.СчетОстатков = ОстаткиПоСчетам.СчетРасчетов;
				КонецЕсли;
				
			ИначеЕсли ЭтоКт302 Тогда // Кредитовый остаток 302.00.
				
				Если ИспользоватьВалютныйУчет И ЗначениеЗаполнено(ОстаткиПоСчетам.Валюта) И ОстаткиПоСчетам.Валюта <> ВалютаРегламентированногоУчета Тогда
					КурсРасчетов = ?(ОстаткиПоСчетам.ОстатокКт = 0, 1, ОстаткиПоСчетам.ОстатокКтРуб / ОстаткиПоСчетам.ОстатокКт);
				Иначе
					КурсРасчетов = 1;
				КонецЕсли;
				
				// Ожидаем оплату поставщику (кредитору). Собираем показатели по рег. ОплатаПоставщикамКредиторам.
				ПогашеннаяСуммаКт = АнализЗадолженностиРассчитатьВычисляемыеПоказателиВСтроке(СтрокаГрафика, НаДату,
					НераспределеннаяСуммаКт,
					СтрокаГрафика.СуммаПросроченныеПлатежиПоставщикамКредиторам,
