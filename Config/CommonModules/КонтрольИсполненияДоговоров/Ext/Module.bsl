		ПредыдущиеДвиженияПоставщиками = РезультатЗапроса[3].Выгрузить();
		ПредыдущиеДвиженияПоставщиками.Индексы.Добавить(ПоляПоиска);
		Отбор = Новый Структура(ПоляПоиска);
		КорректировкаПредыдущихДвижений = Новый Массив;
		
		Для Каждого СтрокаДвижения Из ИсполнениеОбязательствПоставщиками Цикл
			ЗаполнитьЗначенияСвойств(Отбор, СтрокаДвижения);
			ПредыдущиеДвижения = ПредыдущиеДвиженияПоставщиками.НайтиСтроки(Отбор);
			Если ПредыдущиеДвижения.Количество() > 0 Тогда
				КорректировкаПредыдущихДвижений.Добавить(СтрокаДвижения);
				ПредыдущиеДвиженияПоставщиками.Удалить(ПредыдущиеДвижения[0]);
			КонецЕсли;
		КонецЦикла; 
		Для Каждого СтрокаДвижения Из КорректировкаПредыдущихДвижений Цикл
			ИсполнениеОбязательствПоставщиками.Удалить(СтрокаДвижения);
		КонецЦикла; 
		
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ИсполнениеДоговоровСПокупателями", ИсполнениеДоговоровСПокупателями);
	Результат.Вставить("ИсполнениеОбязательствПоставщиками", ИсполнениеОбязательствПоставщиками);
	Возврат Результат;

КонецФункции

Функция СчетРасчетовПоСчетуАвансовВыданных(СчетАвансов, Дата, Организация) Экспорт
	
	// В графиках по договорам с поставщиками счет расчетов всегда 302.хх, приведем счета 206.хх.
	Возврат БухгалтерскийУчет.СчетПоКоду("302." + Прав(Строка(СчетАвансов), 2), Дата, Организация);
	
КонецФункции

// Автоматически распределяет отрицательные суммы из соответствующих в графике по договору
// на строки с положительными суммами в порядке возрастания дат исполнения (оплаты). 
//
Процедура СкорректироватьГрафикАвтоматически(ДокументОбъект, ИмяТаблицы, ВидДоговора) Экспорт
	
	ИспользоватьДетализациюПоКОСГУВГрафикахПоДоговорам = КонтрольИсполненияДоговоров.ИспользоватьДетализациюПоКОСГУВГрафикахПоДоговорам(ВидДоговора);
	ИспользоватьДополнительнуюАналитикуВГрафикахПлатежей = КонтрольИсполненияДоговоров.ИспользоватьДополнительнуюАналитикуВГрафикахПлатежей(ВидДоговора);
	
	ТаблицаГрафик = ДокументОбъект[ИмяТаблицы].Выгрузить();
	Если ИмяТаблицы = "ГрафикПлатежей" Тогда
		РеквизитыПоиска = "ВидРасчетов,СчетРасчетов,КФО,КПС"
			+ ?(ИспользоватьДетализациюПоКОСГУВГрафикахПоДоговорам, ",КЭК", "")
			+ ?(ИспользоватьДополнительнуюАналитикуВГрафикахПлатежей, ",ДопКлассификация,КодМероприятия,КодЦели", "");
		СуммыКРаспределению = ТаблицаГрафик.Скопировать(, РеквизитыПоиска);
	Иначе
		РеквизитыПоиска = "СчетРасчетов,КФО,КПС"
			+ ?(ИспользоватьДетализациюПоКОСГУВГрафикахПоДоговорам, ",КЭК", "");
		СуммыКРаспределению = ТаблицаГрафик.Скопировать(, РеквизитыПоиска);
	КонецЕсли;
	СуммыКРаспределению.Свернуть(РеквизитыПоиска);
	СуммыКРаспределению.Колонки.Добавить("СуммаВВалюте", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(15, 2));
	
	// Распределение отрицательных остатков по отдельным датам исполнения
	// на очередные строки с положительными остатками в порядке возрастания даты исполнения.
	Для Каждого СтрокаГрафика Из ДокументОбъект[ИмяТаблицы] Цикл
		
		Отбор = Новый Структура(РеквизитыПоиска);
		ЗаполнитьЗначенияСвойств(Отбор, СтрокаГрафика, РеквизитыПоиска);
		Если Отбор.Свойство("ВидРасчетов") И НЕ ЗначениеЗаполнено(Отбор.ВидРасчетов) Тогда
			// Если минус по пустому виду расчетов, распределяем на первые неисполненные платежи по виду расчетов "Основной долг".
			Отбор.ВидРасчетов = Перечисления.ВидыРасчетовПоЗаймам.ОсновнойДолг;
		КонецЕсли;
		НайденныеСтроки = СуммыКРаспределению.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		СтрокаИтогов = НайденныеСтроки[0];
		
		Если СтрокаГрафика.СуммаВВалютеДоИзменений < 0 Тогда // Запомним отрицательный остаток.
			СтрокаИтогов.СуммаВВалюте = СтрокаИтогов.СуммаВВалюте + СтрокаГрафика.СуммаВВалютеДоИзменений;
			СтрокаГрафика.СуммаВВалюте = (-1) * СтрокаГрафика.СуммаВВалютеДоИзменений;
			СтрокаГрафика.СуммаВВалютеПослеИзменений = СтрокаГрафика.СуммаВВалютеДоИзменений + СтрокаГрафика.СуммаВВалюте;
			
		ИначеЕсли СтрокаГрафика.СуммаВВалютеДоИзменений > 0 И СтрокаИтогов.СуммаВВалюте < 0 Тогда // Можно зачесть отрицательный остаток.
			ПогаситьСуммаВВалюте = Мин(СтрокаГрафика.СуммаВВалютеДоИзменений, (-1) * СтрокаИтогов.СуммаВВалюте);
			Если ПогаситьСуммаВВалюте > 0 Тогда
				СтрокаГрафика.СуммаВВалюте = (-1) * ПогаситьСуммаВВалюте;
				СтрокаГрафика.СуммаВВалютеПослеИзменений = СтрокаГрафика.СуммаВВалютеДоИзменений + СтрокаГрафика.СуммаВВалюте;
				СтрокаИтогов.СуммаВВалюте = СтрокаИтогов.СуммаВВалюте + ПогаситьСуммаВВалюте;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Добавляет и заполняет колонку "ИсправлениеОшибокПрошлыхЛет" в таблице движений по регистру графиков.
//
Процедура УстановитьПризнакИсправлениеОшибокПрошлыхЛетВДвиженияхПоРегистру(ТаблицыДвижений, ИмяРегистра) Экспорт
	
	Если ТаблицыДвижений.Свойство(ИмяРегистра) Тогда
		ТаблицаДвиженийРегистра = ТаблицыДвижений[ИмяРегистра];
		Если ТаблицаДвиженийРегистра.Колонки.Найти("ИсправлениеОшибокПрошлыхЛет") = Неопределено Тогда
			ТаблицаДвиженийРегистра.Колонки.Добавить("ИсправлениеОшибокПрошлыхЛет", Новый ОписаниеТипов("Булево"));
		КонецЕсли;
		ТаблицаДвиженийРегистра.ЗаполнитьЗначения(Истина, "ИсправлениеОшибокПрошлыхЛет");
	КонецЕсли;
	
КонецПроцедуры

	#Область БухгалтерскиеОперацииИсточникиДанных

// ОплатаПоставщикамКредиторам

// Структура таблицы для формирования движений по регистру "Оплата поставщикам, кредиторам".
//
Функция ПустаяТаблицаОплатаПоставщикамКредиторам() Экспорт

	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Идентификация строки.
	ПустаяТаблица.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	
	// Счет и аналитика учета расчетов с контрагентами.
	ПустаяТаблица.Колонки.Добавить("КЭК",          Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ПустаяТаблица.Колонки.Добавить("СчетРасчетов", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("Контрагент",   Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ПустаяТаблица.Колонки.Добавить("Договор",      Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ПустаяТаблица.Колонки.Добавить("Валюта",       Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	
	// Дополнительная аналитика расчетов.
	ПустаяТаблица.Колонки.Добавить("ДопКлассификация", Новый ОписаниеТипов("СправочникСсылка.ДополнительнаяБюджетнаяКлассификация"));
	ПустаяТаблица.Колонки.Добавить("КодМероприятия",   Новый ОписаниеТипов("СправочникСсылка.Мероприятия"));
	ПустаяТаблица.Колонки.Добавить("КодЦели",          Новый ОписаниеТипов("СправочникСсылка.ВидыЦелевыхСредств"));
	
	// Данные графика платежей.
	ПустаяТаблица.Колонки.Добавить("ВидРасчетов", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыРасчетовПоЗаймам"));
	ПустаяТаблица.Колонки.Добавить("ОплатитьДо",  Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ПустаяТаблица.Колонки.Добавить("Сумма", ОписаниеТипаСуммы);
	
	// Дополнительные колонки.
	ПустаяТаблица.Колонки.Добавить("ВидДоговора",     Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДоговоровКонтрагентов"));
	ПустаяТаблица.Колонки.Добавить("ИсточникСредств", Новый ОписаниеТипов("СправочникСсылка.ИсточникиСредств"));
	ПустаяТаблица.Колонки.Добавить("Регистратор", Метаданные.ОпределяемыеТипы.РегистраторыРегистраБухгалтерии.Тип);
	
	Возврат ПустаяТаблица;

КонецФункции

// Формирует таблицу источника данных "Оплата поставщикам, кредиторам".
//
Функция ТаблицаОплатаПоставщикамКредиторам(РасшифровкаПлатежаУнифицированная, ДокументОбъект, Реквизиты, Отказ) Экспорт
	
	ТаблицаОплатаПоставщикамКредиторам = ПустаяТаблицаОплатаПоставщикамКредиторам();
	
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров") Тогда
		Возврат ТаблицаОплатаПоставщикамКредиторам; // Контроль не ведется.
	КонецЕсли;
	
	МетаданныеДокумента = Реквизиты.Ссылка.Метаданные();
	Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("Оплачено", МетаданныеДокумента) // ПКО, РКО и подобные.
		И Не ДокументОбъект.Оплачено Тогда
		Возврат ТаблицаОплатаПоставщикамКредиторам; // Не отражаем исполнение графика платежей.
	КонецЕсли;
	
	Реквизиты.Вставить("ИспользоватьУчетПоИФО", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет", ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	Реквизиты.Вставить("ИспользоватьДетализациюПоКОСГУ", ПолучитьФункциональнуюОпцию("ИспользоватьДетализациюПоКОСГУВГрафикахСПоставщиками"));
	Реквизиты.Вставить("ИспользоватьДополнительнуюАналитику", ПолучитьФункциональнуюОпцию("ИспользоватьДополнительнуюАналитикуВГрафикахПлатежейСПоставщиками"));
	
	// Оставим только нужные строки - расчеты с поставщиками (кредиторами) и ведением графика платежей.
	ПлатежиПоДоговорамСКонтролемИсполнения = РасшифровкаПлатежаУнифицированная.СкопироватьКолонки();
	Для Каждого СтрокаРасшифровки Из РасшифровкаПлатежаУнифицированная Цикл
		
		Если НЕ СтрокаРасшифровки.ВестиГрафикПлатежей
			ИЛИ СтрокаРасшифровки.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем
			ИЛИ СтрокаРасшифровки.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СОтправителемТрансферта
			ИЛИ БухгалтерскийУчет.СчетВИерархии(СтрокаРасшифровки.СчетРасчетов, "205.00,209.00")
			ИЛИ СтрокаРасшифровки.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ПредоставленныйКредит
			ИЛИ БухгалтерскийУчет.СчетВИерархии(СтрокаРасшифровки.СчетРасчетов, "207.00") Тогда
			Продолжить;
		КонецЕсли;
		
		Платеж = ПлатежиПоДоговорамСКонтролемИсполнения.Добавить();
		ЗаполнитьЗначенияСвойств(Платеж, СтрокаРасшифровки);
		
		// Поменяем 206.хх на соответствующий 302.хх, т.к. плановые данные (график платежей) вводятся только в разрезе 302.хх.
		Если БухгалтерскийУчет.СчетВИерархии(Платеж.СчетРасчетов, "206.00") Тогда
			Платеж.СчетРасчетов = СчетРасчетовПоСчетуАвансовВыданных(Платеж.СчетРасчетов, Реквизиты.Дата, Реквизиты.Организация);
		КонецЕсли;
		
	КонецЦикла;
	Если ПлатежиПоДоговорамСКонтролемИсполнения.Количество() = 0 Тогда
		Возврат ТаблицаОплатаПоставщикамКредиторам;
	КонецЕсли;
	
	Колонки = ПлатежиПоДоговорамСКонтролемИсполнения.Колонки;
	Если Не Реквизиты.ИспользоватьДетализациюПоКОСГУ Тогда
		Колонки.Удалить(Колонки.Индекс(Колонки.КЭК));
	КонецЕсли;
	Если Не Реквизиты.ИспользоватьДополнительнуюАналитику Тогда
		Колонки.Удалить(Колонки.Индекс(Колонки.ДопКлассификация));
		Колонки.Удалить(Колонки.Индекс(Колонки.КодМероприятия));
		Колонки.Удалить(Колонки.Индекс(Колонки.КодЦели));
	КонецЕсли;
	
	НеисполненныеПлатежи = НеисполненныеПлатежиПоставщикамКредиторам(ПлатежиПоДоговорамСКонтролемИсполнения, Реквизиты.Организация);
	
	Для Каждого Платеж Из ПлатежиПоДоговорамСКонтролемИсполнения Цикл
		
		НераспределенныйОстаток = Платеж.СуммаРасчетов;
		
		Отбор = Новый Структура("ЭтоПоступление,Контрагент,ВидРасчетов,КФО,КПС,СчетРасчетов");
		ЗаполнитьЗначенияСвойств(Отбор, Платеж);
		
		Если ЗначениеЗаполнено(Платеж.Договор) Тогда
			Отбор.Вставить("Договор", Платеж.Договор);
		КонецЕсли;
		Если Реквизиты.ИспользоватьУчетПоИФО Тогда
			Отбор.Вставить("ИФО", Платеж.ИФО);
		КонецЕсли;
		Если Реквизиты.ИспользоватьВалютныйУчет Тогда
			Отбор.Вставить("Валюта", Платеж.Валюта);
		КонецЕсли;
		Если Реквизиты.ИспользоватьДетализациюПоКОСГУ Тогда
			Отбор.Вставить("КЭК", Платеж.КЭК);
		КонецЕсли;
		Если Реквизиты.ИспользоватьДополнительнуюАналитику Тогда
			Отбор.Вставить("ДопКлассификация", Платеж.ДопКлассификация);
			Отбор.Вставить("КодМероприятия",   Платеж.КодМероприятия);
			Отбор.Вставить("КодЦели",          Платеж.КодЦели);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Платеж.ОплатитьДо) Тогда
			Отбор.Вставить("ОплатитьДо", Платеж.ОплатитьДо);
		КонецЕсли;
		
		НайденныеНеисполненныеПлатежи = ?(НеисполненныеПлатежи.Количество() > 0, НеисполненныеПлатежи.НайтиСтроки(Отбор),
			НеисполненныеПлатежи.СкопироватьКолонки());
		ДобавитьСтрокиОплатыЗадолженностиПоГрафику(
			ТаблицаОплатаПоставщикамКредиторам,
			НераспределенныйОстаток,
			НайденныеНеисполненныеПлатежи,
			Платеж,
			Реквизиты, Отказ);
		
		ДобавитьСтрокуОплатыЗадолженностиСверхГрафика(
			ТаблицаОплатаПоставщикамКредиторам,
			НераспределенныйОстаток,
			Платеж,
			Реквизиты);
		
	КонецЦикла;
	
	Возврат ТаблицаОплатаПоставщикамКредиторам;
	
КонецФункции

Процедура ДобавитьСтрокиОплатыЗадолженностиПоГрафику(ТаблицаОплат, НераспределеннаяСумма, НеисполненныеПлатежи, Платеж, Реквизиты, Отказ)
	
	Знак = ?(Платеж.ЭтоПоступление, -1, +1);
	ЭтоРегистрацияИсполненияДоговоров = (ТипЗнч(Реквизиты.Ссылка) = Тип("ДокументСсылка.РегистрацияИсполненияДоговоров"));
	
	Для Каждого СтрокаОстатка Из НеисполненныеПлатежи Цикл
		
		Если НераспределеннаяСумма <= 0 Тогда
			Прервать;
		КонецЕсли;
		
		ПогашеннаяСумма = Мин(НераспределеннаяСумма, Знак * СтрокаОстатка.Сумма);
		Если ПогашеннаяСумма <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаОплаты = ТаблицаОплат.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаОплаты, СтрокаОстатка,
			"ИФО,КФО,КПС,КЭК,СчетРасчетов,Контрагент,Договор,Валюта,ВидРасчетов,ОплатитьДо,
			|КодЦели,КодМероприятия,ДопКлассификация");
		ЗаполнитьЗначенияСвойств(СтрокаОплаты, Платеж,
			"ИмяСписка,СинонимСписка,НомерСтроки,ВидДоговора,ИсточникСредств");
		
		СтрокаОплаты.Сумма = Знак * ПогашеннаяСумма;
		НераспределеннаяСумма = НераспределеннаяСумма - ПогашеннаяСумма;
		
		СтрокаОплаты.Регистратор = ?(ЭтоРегистрацияИсполненияДоговоров, Платеж.Регистратор, Реквизиты.Ссылка);
		
		СтрокаОстатка.Сумма = СтрокаОстатка.Сумма - СтрокаОплаты.Сумма;
		
	КонецЦикла;
	
	Если НераспределеннаяСумма > 0 И Не ЭтоРегистрацияИсполненияДоговоров Тогда
		
		ТекстОшибки = НСтр("ru='Сумма оплаты превышает остаток неоплаченной задолженности по графику платежей.
			|
			|Указана сумма оплаты: %1; Остаток задолженности по графику: %2; Превышение: %3'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
			ОбщегоНазначенияБГУ.ФорматСумм(Платеж.СуммаРасчетов, Платеж.Валюта, "0"),
			ОбщегоНазначенияБГУ.ФорматСумм(Платеж.СуммаРасчетов - НераспределеннаяСумма, Платеж.Валюта, "0"),
			ОбщегоНазначенияБГУ.ФорматСумм(НераспределеннаяСумма, Платеж.Валюта, "0"));
		
		ИмяСписка = ?(ЗначениеЗаполнено(Платеж.ИмяСписка), Платеж.ИмяСписка, "РасшифровкаПлатежа");
		Если ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("СуммаВал", Реквизиты.Ссылка.Метаданные(), "РасшифровкаПлатежа") Тогда
			ПолеСумма = ИмяСписка + "[" + Формат(Платеж.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].СуммаВал";
		Иначе
			ПолеСумма = ИмяСписка + "[" + Формат(Платеж.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Сумма";
		КонецЕсли;
		
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Реквизиты.Ссылка, ПолеСумма, "Объект");
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьСтрокуОплатыЗадолженностиСверхГрафика(ТаблицаОплат, НераспределеннаяСумма, Платеж, Реквизиты)
	
	Знак = ?(Платеж.ЭтоПоступление, -1, +1);
	ЭтоРегистрацияИсполненияДоговоров = (ТипЗнч(Реквизиты.Ссылка) = Тип("ДокументСсылка.РегистрацияИсполненияДоговоров"));
	
	Если НераспределеннаяСумма <= 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаОплаты = ТаблицаОплат.Добавить();
	
	ЗаполнитьЗначенияСвойств(СтрокаОплаты, Платеж,
		"ИФО,КФО,КПС,СчетРасчетов,Контрагент,Договор,Валюта,ВидРасчетов,ОплатитьДо,
		|ИмяСписка,СинонимСписка,НомерСтроки,ВидДоговора,ИсточникСредств");
	
	Если Реквизиты.ИспользоватьДетализациюПоКОСГУ Тогда
		СтрокаОплаты.КЭК = Платеж.КЭК;
	КонецЕсли;
	Если Реквизиты.ИспользоватьДополнительнуюАналитику Тогда
		ЗаполнитьЗначенияСвойств(СтрокаОплаты, Платеж, "КодЦели,КодМероприятия,ДопКлассификация");
	КонецЕсли;
	
	СтрокаОплаты.Регистратор = ?(ЭтоРегистрацияИсполненияДоговоров, Платеж.Регистратор, Реквизиты.Ссылка);
	
	СтрокаОплаты.Сумма = Знак * НераспределеннаяСумма;
	
КонецПроцедуры

// ОплатаОтПокупателейДебиторов

// Структура таблицы для формирования движений по регистру "Оплата от покупателей, дебиторов".
//
Функция ПустаяТаблицаОплатаОтПокупателейДебиторов() Экспорт

	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Идентификация строки.
	ПустаяТаблица.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	
	// Счет и аналитика учета расчетов с контрагентами.
	ПустаяТаблица.Колонки.Добавить("КЭК",          Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ПустаяТаблица.Колонки.Добавить("СчетРасчетов", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("Контрагент",   Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ПустаяТаблица.Колонки.Добавить("Договор",      Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ПустаяТаблица.Колонки.Добавить("Валюта",       Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	
	// Дополнительная аналитика расчетов.
	ПустаяТаблица.Колонки.Добавить("ДопКлассификация", Новый ОписаниеТипов("СправочникСсылка.ДополнительнаяБюджетнаяКлассификация"));
	ПустаяТаблица.Колонки.Добавить("КодМероприятия",   Новый ОписаниеТипов("СправочникСсылка.Мероприятия"));
	ПустаяТаблица.Колонки.Добавить("КодЦели",          Новый ОписаниеТипов("СправочникСсылка.ВидыЦелевыхСредств"));
	
	// Данные графика платежей.
	ПустаяТаблица.Колонки.Добавить("ВидРасчетов", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыРасчетовПоЗаймам"));
	ПустаяТаблица.Колонки.Добавить("ОплатитьДо",  Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ПустаяТаблица.Колонки.Добавить("Сумма", ОписаниеТипаСуммы);
	
	// Дополнительные колонки.
	ПустаяТаблица.Колонки.Добавить("ВидДоговора",     Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДоговоровКонтрагентов"));
	ПустаяТаблица.Колонки.Добавить("ИсточникСредств", Новый ОписаниеТипов("СправочникСсылка.ИсточникиСредств"));
	ПустаяТаблица.Колонки.Добавить("Регистратор", Метаданные.ОпределяемыеТипы.РегистраторыРегистраБухгалтерии.Тип);
	
	Возврат ПустаяТаблица;

КонецФункции

// Формирует таблицу источника данных "Оплата от покупателей, дебиторов".
//
Функция ТаблицаОплатаОтПокупателейДебиторов(РасшифровкаПлатежаУнифицированная, ДокументОбъект, Реквизиты, Отказ) Экспорт
	
	ТаблицаОплатаОтПокупателейДебиторов = ПустаяТаблицаОплатаОтПокупателейДебиторов();
	
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров") Тогда
		Возврат ТаблицаОплатаОтПокупателейДебиторов; // Контроль не ведется.
	КонецЕсли;
	
	МетаданныеДокумента = Реквизиты.Ссылка.Метаданные();
	Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("Оплачено", МетаданныеДокумента) // ПКО, РКО и подобные.
		И Не ДокументОбъект.Оплачено Тогда
		Возврат ТаблицаОплатаОтПокупателейДебиторов; // Не отражаем исполнение графика платежей.
	КонецЕсли;
	
	Реквизиты.Вставить("ИспользоватьУчетПоИФО", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет", ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	Реквизиты.Вставить("ИспользоватьДетализациюПоКОСГУ", ПолучитьФункциональнуюОпцию("ИспользоватьДетализациюПоКОСГУВГрафикахСПокупателями"));
	Реквизиты.Вставить("ИспользоватьДополнительнуюАналитику", ПолучитьФункциональнуюОпцию("ИспользоватьДополнительнуюАналитикуВГрафикахПлатежейСПокупателями"));
	
	// Оставим только нужные строки - расчеты с покупателями (дебиторами) и ведением графика платежей.
	ПлатежиПоДоговорамСКонтролемИсполнения = РасшифровкаПлатежаУнифицированная.СкопироватьКолонки();
	Для Каждого СтрокаРасшифровки Из РасшифровкаПлатежаУнифицированная Цикл
		
		Если НЕ СтрокаРасшифровки.ВестиГрафикПлатежей
			ИЛИ СтрокаРасшифровки.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком
			ИЛИ СтрокаРасшифровки.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии
			ИЛИ БухгалтерскийУчет.СчетВИерархии(СтрокаРасшифровки.СчетРасчетов, "206.00,302.00")
			ИЛИ СтрокаРасшифровки.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ПолученныйКредит
			ИЛИ СтрокаРасшифровки.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ВыпускЦенныхБумаг
			ИЛИ БухгалтерскийУчет.СчетВИерархии(СтрокаРасшифровки.СчетРасчетов, "301.00") Тогда
			Продолжить;
		КонецЕсли;
		
		Платеж = ПлатежиПоДоговорамСКонтролемИсполнения.Добавить();
		ЗаполнитьЗначенияСвойств(Платеж, СтрокаРасшифровки);
		
	КонецЦикла;
	Если ПлатежиПоДоговорамСКонтролемИсполнения.Количество() = 0 Тогда
		Возврат ТаблицаОплатаОтПокупателейДебиторов;
	КонецЕсли;
	
	Колонки = ПлатежиПоДоговорамСКонтролемИсполнения.Колонки;
	Если Не Реквизиты.ИспользоватьДетализациюПоКОСГУ Тогда
		Колонки.Удалить(Колонки.Индекс(Колонки.КЭК));
	КонецЕсли;
	Если Не Реквизиты.ИспользоватьДополнительнуюАналитику Тогда
		Колонки.Удалить(Колонки.Индекс(Колонки.ДопКлассификация));
		Колонки.Удалить(Колонки.Индекс(Колонки.КодМероприятия));
		Колонки.Удалить(Колонки.Индекс(Колонки.КодЦели));
	КонецЕсли;
	
	НеисполненныеПлатежи = НеисполненныеПлатежиОтПокупателейДебиторов(ПлатежиПоДоговорамСКонтролемИсполнения, Реквизиты.Организация);
	
	Для Каждого Платеж Из ПлатежиПоДоговорамСКонтролемИсполнения Цикл
		
		НераспределенныйОстаток = Платеж.СуммаРасчетов;
		
		Отбор = Новый Структура("ЭтоПоступление,Контрагент,ВидРасчетов,КФО,КПС,СчетРасчетов");
		ЗаполнитьЗначенияСвойств(Отбор, Платеж);
		
		Если ЗначениеЗаполнено(Платеж.Договор) Тогда
			Отбор.Вставить("Договор", Платеж.Договор);
		КонецЕсли;
		Если Реквизиты.ИспользоватьУчетПоИФО Тогда
			Отбор.Вставить("ИФО", Платеж.ИФО);
		КонецЕсли;
		Если Реквизиты.ИспользоватьВалютныйУчет Тогда
			Отбор.Вставить("Валюта", Платеж.Валюта);
		КонецЕсли;
		Если Реквизиты.ИспользоватьДетализациюПоКОСГУ Тогда
			Отбор.Вставить("КЭК", Платеж.КЭК);
		КонецЕсли;
		Если Реквизиты.ИспользоватьДополнительнуюАналитику Тогда
			Отбор.Вставить("ДопКлассификация", Платеж.ДопКлассификация);
			Отбор.Вставить("КодМероприятия",   Платеж.КодМероприятия);
			Отбор.Вставить("КодЦели",          Платеж.КодЦели);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Платеж.ОплатитьДо) Тогда
			Отбор.Вставить("ОплатитьДо", Платеж.ОплатитьДо);
		КонецЕсли;
		
		НайденныеНеисполненныеПлатежи = ?(НеисполненныеПлатежи.Количество() > 0, НеисполненныеПлатежи.НайтиСтроки(Отбор),
			НеисполненныеПлатежи.СкопироватьКолонки());
		ДобавитьСтрокиОплатыОтПокупателейПоГрафику(
			ТаблицаОплатаОтПокупателейДебиторов,
			НераспределенныйОстаток,
			НайденныеНеисполненныеПлатежи,
			Платеж,
			Реквизиты, Отказ);
		
		ДобавитьСтрокуОплатыОтПокупателейСверхГрафика(
			ТаблицаОплатаОтПокупателейДебиторов,
			НераспределенныйОстаток,
			Платеж,
			Реквизиты);
		
	КонецЦикла;
	
	Возврат ТаблицаОплатаОтПокупателейДебиторов;
	
КонецФункции

Процедура ДобавитьСтрокиОплатыОтПокупателейПоГрафику(ТаблицаОплат, НераспределеннаяСумма, НеисполненныеПлатежи, Платеж, Реквизиты, Отказ)
	
	Знак = ?(Платеж.ЭтоПоступление, +1, -1);
	ЭтоРегистрацияИсполненияДоговоров = (ТипЗнч(Реквизиты.Ссылка) = Тип("ДокументСсылка.РегистрацияИсполненияДоговоров"));
	
	Для Каждого СтрокаОстатка Из НеисполненныеПлатежи Цикл
		
		Если НераспределеннаяСумма <= 0 Тогда
			Прервать;
		КонецЕсли;
		
		ПогашеннаяСумма = Мин(НераспределеннаяСумма, Знак * СтрокаОстатка.Сумма);
		Если ПогашеннаяСумма <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаОплаты = ТаблицаОплат.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаОплаты, СтрокаОстатка,
			"ИФО,КФО,КПС,КЭК,СчетРасчетов,Контрагент,Договор,Валюта,ВидРасчетов,ОплатитьДо,
			|КодЦели,КодМероприятия,ДопКлассификация");
		ЗаполнитьЗначенияСвойств(СтрокаОплаты, Платеж,
			"ИмяСписка,СинонимСписка,НомерСтроки,ВидДоговора,ИсточникСредств");
		
		СтрокаОплаты.Регистратор = ?(ЭтоРегистрацияИсполненияДоговоров, Платеж.Регистратор, Реквизиты.Ссылка);
		
		СтрокаОплаты.Сумма = Знак * ПогашеннаяСумма;
		НераспределеннаяСумма = НераспределеннаяСумма - ПогашеннаяСумма;
		
		СтрокаОстатка.Сумма = СтрокаОстатка.Сумма - СтрокаОплаты.Сумма;
		
	КонецЦикла;
	
	Если НераспределеннаяСумма > 0 И Не ЭтоРегистрацияИсполненияДоговоров Тогда
		
		ТекстОшибки = НСтр("ru='Сумма оплаты превышает остаток неоплаченной задолженности по графику платежей по договору %4 (%5).
			|
			|Указана сумма оплаты: %1; Остаток задолженности по графику: %2; Превышение: %3'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
			ОбщегоНазначенияБГУ.ФорматСумм(Платеж.СуммаРасчетов, Платеж.Валюта, "0"),
			ОбщегоНазначенияБГУ.ФорматСумм(Платеж.СуммаРасчетов - НераспределеннаяСумма, Платеж.Валюта, "0"),
			ОбщегоНазначенияБГУ.ФорматСумм(НераспределеннаяСумма, Платеж.Валюта, "0"),
			Платеж.Договор,
			Платеж.Контрагент);
		
		ИмяСписка = ?(ЗначениеЗаполнено(Платеж.ИмяСписка), Платеж.ИмяСписка, "РасшифровкаПлатежа");
		Если ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("СуммаВал", Реквизиты.Ссылка.Метаданные(), "РасшифровкаПлатежа") Тогда
			ПолеСумма = ИмяСписка + "[" + Формат(Платеж.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].СуммаВал";
		Иначе
			ПолеСумма = ИмяСписка + "[" + Формат(Платеж.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Сумма";
		КонецЕсли;
		
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Реквизиты.Ссылка, ПолеСумма, "Объект");
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьСтрокуОплатыОтПокупателейСверхГрафика(ТаблицаОплат, НераспределеннаяСумма, Платеж, Реквизиты)
	
	Знак = ?(Платеж.ЭтоПоступление, +1, -1);
	ЭтоРегистрацияИсполненияДоговоров = (ТипЗнч(Реквизиты.Ссылка) = Тип("ДокументСсылка.РегистрацияИсполненияДоговоров"));
	
	Если НераспределеннаяСумма = 0 Тогда // Отрицательная сумма может возникать при переносе оплаты между договорами покупателей (учащихся).
		Возврат;
	КонецЕсли;
	
	СтрокаОплаты = ТаблицаОплат.Добавить();
	
	ЗаполнитьЗначенияСвойств(СтрокаОплаты, Платеж,
		"ИФО,КФО,КПС,СчетРасчетов,Контрагент,Договор,Валюта,ВидРасчетов,ОплатитьДо,
		|ИмяСписка,СинонимСписка,НомерСтроки,ВидДоговора,ИсточникСредств");
	
	Если Реквизиты.ИспользоватьДетализациюПоКОСГУ Тогда
		СтрокаОплаты.КЭК = Платеж.КЭК;
	КонецЕсли;
	Если Реквизиты.ИспользоватьДополнительнуюАналитику Тогда
		ЗаполнитьЗначенияСвойств(СтрокаОплаты, Платеж, "КодЦели,КодМероприятия,ДопКлассификация");
	КонецЕсли;
	
	СтрокаОплаты.Регистратор = ?(ЭтоРегистрацияИсполненияДоговоров, Платеж.Регистратор, Реквизиты.Ссылка);
	
	СтрокаОплаты.Сумма = Знак * НераспределеннаяСумма;
	
КонецПроцедуры

// ИсполнениеОбязательствПоставщиками

// Структура таблицы для формирования движений по регистру "Исполнение обязательств поставщиками".
//
Функция ПустаяТаблицаИсполнениеОбязательствПоставщиками() Экспорт

	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Идентификация строки.
	ПустаяТаблица.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	
	// Счет и аналитика учета расчетов с контрагентами.
	ПустаяТаблица.Колонки.Добавить("КЭК",          Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ПустаяТаблица.Колонки.Добавить("СчетРасчетов", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("Контрагент",   Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ПустаяТаблица.Колонки.Добавить("Договор",      Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ПустаяТаблица.Колонки.Добавить("Валюта",       Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	
	// Данные графика исполнения обязательств.
	ПустаяТаблица.Колонки.Добавить("ИсполнитьДо", Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ПустаяТаблица.Колонки.Добавить("Сумма", ОписаниеТипаСуммы);
	
	// Дополнительные колонки.
	ПустаяТаблица.Колонки.Добавить("ВидДоговора", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДоговоровКонтрагентов"));
	ПустаяТаблица.Колонки.Добавить("Регистратор", Метаданные.ОпределяемыеТипы.РегистраторыРегистраБухгалтерии.Тип);
	
	Возврат ПустаяТаблица;
	
КонецФункции

// Формирует таблицу исполнения обязательств поставщиками.
//
Функция ТаблицаИсполнениеОбязательствПоставщиками(ТаблицыПоступления, ДокументОбъект, Реквизиты, Отказ) Экспорт
	
	ТаблицаИсполнениеОбязательствПоставщиками = ПустаяТаблицаИсполнениеОбязательствПоставщиками();
	
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров") Тогда
		Возврат ТаблицаИсполнениеОбязательствПоставщиками; // Контроль не ведется.
	КонецЕсли;
	
	МетаданныеДокумента = Реквизиты.Ссылка.Метаданные();
	
	Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ОтразитьВГрафикеИсполненияДоговора", МетаданныеДокумента)
		И ЗначениеЗаполнено(ДокументОбъект.ОтразитьВГрафикеИсполненияДоговора)
		И ДокументОбъект.ОтразитьВГрафикеИсполненияДоговора <> Перечисления.СтатусыДокументовКонтрольИсполненияДоговоров.ОтразитьСейчас Тогда
		Возврат ТаблицаИсполнениеОбязательствПоставщиками; // Не отражаем автоматически.
	КонецЕсли;
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ИспользоватьВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	ИспользоватьДетализациюПоКОСГУ = ПолучитьФункциональнуюОпцию("ИспользоватьДетализациюПоКОСГУВГрафикахСПоставщиками");
	
	Для Каждого ТаблицаПоступления Из ТаблицыПоступления Цикл
		
		ИмяТаблицы = ТаблицаПоступления.Ключ;
		Таблица    = ТаблицаПоступления.Значение;
		
		Если Таблица.Колонки.Найти("Договор") = Неопределено Тогда // Договор в шапке документа.
			
			Если НЕ ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("Договор", МетаданныеДокумента) Тогда
				Продолжить; // Невозможно определить договор.
			КонецЕсли;
			
			РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОбъект.Договор,
				"Ссылка,Контрагент,ВидДоговора,ВестиПланГрафикИсполнения");
			Если НЕ РеквизитыДоговора.ВестиПланГрафикИсполнения
				ИЛИ НЕ (РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком
					ИЛИ РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии) Тогда
				Продолжить;
			КонецЕсли;
			
			ПоступленияПоДоговорамСГрафикомПоставок = Таблица.Скопировать();
			ПоступленияПоДоговорамСГрафикомПоставок.Колонки.Добавить("Контрагент",
				Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
			ПоступленияПоДоговорамСГрафикомПоставок.Колонки.Добавить("Договор",
				Новый ОписаниеТипов("СправочникСсылка.Договоры"));
			ПоступленияПоДоговорамСГрафикомПоставок.Колонки.Добавить("ВидДоговора",
				Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДоговоровКонтрагентов"));
			ПоступленияПоДоговорамСГрафикомПоставок.ЗаполнитьЗначения(РеквизитыДоговора.Контрагент,  "Контрагент");
			ПоступленияПоДоговорамСГрафикомПоставок.ЗаполнитьЗначения(РеквизитыДоговора.Ссылка,      "Договор");
			ПоступленияПоДоговорамСГрафикомПоставок.ЗаполнитьЗначения(РеквизитыДоговора.ВидДоговора, "ВидДоговора");
			
		Иначе // В таблице есть колонка "Договор".
		
			РеквизитыДоговоров = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(
				ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(Таблица.ВыгрузитьКолонку("Договор")),
					"ВидДоговора,ВестиПланГрафикИсполнения");
				
			// Оставим только строки по договорам нужных видов с контролем исполнения.
			ПоступленияПоДоговорамСГрафикомПоставок = Таблица.СкопироватьКолонки();
			ПоступленияПоДоговорамСГрафикомПоставок.Колонки.Добавить("ВидДоговора",
				Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДоговоровКонтрагентов"));
			Для Каждого СтрокаПоступления Из Таблица Цикл
				
				Если НЕ ЗначениеЗаполнено(СтрокаПоступления.Договор) Тогда
					Продолжить;
				КонецЕсли;
				
				ВидДоговора = РеквизитыДоговоров[СтрокаПоступления.Договор].ВидДоговора;
				ВестиПланГрафикИсполнения = РеквизитыДоговоров[СтрокаПоступления.Договор].ВестиПланГрафикИсполнения;
				Если ВестиПланГрафикИсполнения
					И (ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком
					ИЛИ ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии) Тогда
					НоваяСтрока = ПоступленияПоДоговорамСГрафикомПоставок.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПоступления);
					НоваяСтрока.ВидДоговора = ВидДоговора;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		Если ПоступленияПоДоговорамСГрафикомПоставок.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ЕстьКолонкаСчетРасчетов = (Таблица.Колонки.Найти("СчетРасчетов") <> Неопределено);
		ЕстьКолонкаКПС          = (Таблица.Колонки.Найти("КПС") <> Неопределено);
		ЕстьКолонкаКПСРасчетов  = (Таблица.Колонки.Найти("КПСРасчетов") <> Неопределено);
		ЕстьКолонкаКЭК          = (Таблица.Колонки.Найти("КЭК") <> Неопределено);
		ЕстьКолонкаВалюта       = (Таблица.Колонки.Найти("Валюта") <> Неопределено);
		ЕстьКолонкаВидУчета     = (Таблица.Колонки.Найти("ВидУчета") <> Неопределено);
		
		ЕстьКолонкаОтразитьВГрафикеИсполнения =
			(Таблица.Колонки.Найти("ОтразитьВГрафикеИсполненияДоговора") <> Неопределено);
		
		Колонки = ПоступленияПоДоговорамСГрафикомПоставок.Колонки;
		Если ЕстьКолонкаКЭК И Не ИспользоватьДетализациюПоКОСГУ Тогда
			Колонки.Удалить(Колонки.Индекс(Колонки.КЭК));
		КонецЕсли;
		
		НеисполненныеОбязательства = НеисполненныеОбязательстваПоставщиков(ПоступленияПоДоговорамСГрафикомПоставок, Реквизиты.Организация);
		
		Для Каждого Поступление Из ПоступленияПоДоговорамСГрафикомПоставок Цикл
			
			Если ЕстьКолонкаОтразитьВГрафикеИсполнения
				И ЗначениеЗаполнено(Поступление.ОтразитьВГрафикеИсполненияДоговора)
				И Поступление.ОтразитьВГрафикеИсполненияДоговора <> Перечисления.СтатусыДокументовКонтрольИсполненияДоговоров.ОтразитьСейчас Тогда
				Продолжить;
			КонецЕсли;
			Если ЕстьКолонкаВидУчета И Поступление.ВидУчета <> "БУ" Тогда
				Продолжить;
			КонецЕсли;
			
			НераспределенныйОстаток = Поступление.СуммаВал;
			
			Отбор = Новый Структура("Контрагент,КФО");
			ЗаполнитьЗначенияСвойств(Отбор, Поступление);
			
			Если ЗначениеЗаполнено(Поступление.Договор) Тогда
				Отбор.Вставить("Договор", Поступление.Договор);
			КонецЕсли;
			Если ИспользоватьУчетПоИФО Тогда
				Отбор.Вставить("ИФО", Поступление.ИФО);
			КонецЕсли;
			Если ИспользоватьВалютныйУчет Тогда
				Отбор.Вставить("Валюта", ?(ЕстьКолонкаВалюта, Поступление.Валюта, БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета()) );
			Иначе
				Отбор.Вставить("Валюта", БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета());
			КонецЕсли;
			
			Если ИмяТаблицы = "ПоступлениеМатериальныхЗапасов" Тогда
				
				Отбор.Вставить("СчетРасчетов", Поступление.СчетРасчетов);
				Отбор.Вставить("КПС", Поступление.КПСРасчетов);
				Если ИспользоватьДетализациюПоКОСГУ Тогда
					Отбор.Вставить("КЭК", Поступление.КЭК);
				КонецЕсли;
				
			ИначеЕсли ИмяТаблицы = "ВозвратМатериальныхЗапасовПоставщику" Тогда
				
				Отбор.Вставить("СчетРасчетов", Реквизиты.СчетРасчетов);
				Отбор.Вставить("КПС", Реквизиты.КПСРасчетов);
				Если ИспользоватьДетализациюПоКОСГУ Тогда
					Отбор.Вставить("КЭК", БухгалтерскиеОперации.КЭКСчета(
						Реквизиты.Организация, Поступление.ИФО, Поступление.КФО, Реквизиты.Дата, Поступление.СчетУчета, "Дт"));
				КонецЕсли;
				
			ИначеЕсли ИмяТаблицы = "ПоступлениеОсновныхСредств" Тогда
				
				Отбор.Вставить("СчетРасчетов", Поступление.СчетРасчетов);
				Отбор.Вставить("КПС", Поступление.КПС);
				Если ИспользоватьДетализациюПоКОСГУ Тогда
					Если БухгалтерскийУчет.СчетВИерархии(Поступление.СчетВложений, "106.60") Тогда
						Отбор.Вставить("КЭК", БухгалтерскийУчетПовтИсп.АналитическийКЭКпоСчету(Поступление.СчетРасчетов));
					Иначе
						Отбор.Вставить("КЭК", БухгалтерскиеОперации.КЭКСчета(
							Реквизиты.Организация, Поступление.ИФО, Поступление.КФО, Реквизиты.Дата, Поступление.СчетВложений, "Дт"));
					КонецЕсли;
				КонецЕсли;
				
			ИначеЕсли ИмяТаблицы = "ВложенияВоВнеоборотныеАктивы" Тогда
				
				Отбор.Вставить("СчетРасчетов", Поступление.СчетРасчетов);
				Отбор.Вставить("КПС", Поступление.КПС);
				Если ИспользоватьДетализациюПоКОСГУ Тогда
					Если БухгалтерскийУчет.СчетВИерархии(Поступление.СчетВложений, "106.60") Тогда
						Отбор.Вставить("КЭК", БухгалтерскийУчетПовтИсп.АналитическийКЭКпоСчету(Поступление.СчетРасчетов));
					Иначе
						Отбор.Вставить("КЭК", БухгалтерскиеОперации.КЭКСчета(
							Реквизиты.Организация, Поступление.ИФО, Поступление.КФО, Реквизиты.Дата, Поступление.СчетВложений, "Дт"));
					КонецЕсли;
				КонецЕсли;
				
			Иначе
			
				// СчетРасчетов.
				Если Реквизиты.Свойство("СчетРасчетов") Тогда
					Отбор.Вставить("СчетРасчетов", Реквизиты.СчетРасчетов);
				ИначеЕсли ЕстьКолонкаСчетРасчетов Тогда
					Отбор.Вставить("СчетРасчетов", Поступление.СчетРасчетов);
				Иначе
					Отбор.Вставить("СчетРасчетов", ПланыСчетов.ЕПСБУ.ПустаяСсылка());
				КонецЕсли;
				
				// КПС.
				Если Реквизиты.Свойство("КПСРасчетов") Тогда
					Отбор.Вставить("КПС", Реквизиты.КПСРасчетов);
				ИначеЕсли ЕстьКолонкаКПСРасчетов Тогда
					Отбор.Вставить("КПС", Поступление.КПСРасчетов);
				ИначеЕсли ЕстьКолонкаКПС Тогда
					Отбор.Вставить("КПС", Поступление.КПС);
				Иначе
					Отбор.Вставить("КПС", Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка());
				КонецЕсли;
				
				// КЭК.
				Если ИспользоватьДетализациюПоКОСГУ Тогда
					Если ЕстьКолонкаКЭК Тогда
						Отбор.Вставить("КЭК", Поступление.КЭК);
					Иначе
						Отбор.Вставить("КЭК", Справочники.КОСГУ.ПустаяСсылка());
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			
			НайденныеНеисполненныеОбязательства = ?(НеисполненныеОбязательства.Количество() > 0, НеисполненныеОбязательства.НайтиСтроки(Отбор),
				НеисполненныеОбязательства.СкопироватьКолонки());
			ДобавитьСтрокиИсполненияОбязательствПоГрафику(
				ТаблицаИсполнениеОбязательствПоставщиками,
				НераспределенныйОстаток,
				НайденныеНеисполненныеОбязательства,
				Поступление,
				ИмяТаблицы,
				Реквизиты, Отказ);
			
			ДобавитьСтрокуИсполненияОбязательствСверхГрафика(
				ТаблицаИсполнениеОбязательствПоставщиками,
				НераспределенныйОстаток,
				Отбор,
				Поступление,
				ИмяТаблицы,
				Реквизиты);
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТаблицаИсполнениеОбязательствПоставщиками;
	
КонецФункции

Процедура ДобавитьСтрокиИсполненияОбязательствПоГрафику(ТаблицаИсполнениеОбязательствПоставщиками, НераспределеннаяСумма, НеисполненныеОбязательства, Поступление, ИмяТаблицы, Реквизиты, Отказ) Экспорт
	
	Знак = ?(СтрНайти(ИмяТаблицы, "Возврат") > 0, -1, +1);
	ЭтоРегистрацияИсполненияДоговоров = (ИмяТаблицы = "РегистрацияИсполненияДоговоров");
	
	Для Каждого СтрокаОстатка Из НеисполненныеОбязательства Цикл
		
		Если НераспределеннаяСумма <= 0 Тогда
			Прервать;
		КонецЕсли;
		
		ПогашеннаяСумма = Мин(НераспределеннаяСумма, Знак * СтрокаОстатка.Сумма);
		Если ПогашеннаяСумма <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаИсполнение = ТаблицаИсполнениеОбязательствПоставщиками.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаИсполнение, СтрокаОстатка,
			"ИФО,КФО,КПС,КЭК,СчетРасчетов,Контрагент,Договор,Валюта,ИсполнитьДо");
		ЗаполнитьЗначенияСвойств(СтрокаИсполнение, Поступление,
			"ИмяСписка,СинонимСписка,НомерСтроки,ВидДоговора");
		
		СтрокаИсполнение.Регистратор = ?(ЭтоРегистрацияИсполненияДоговоров, Поступление.Регистратор, Реквизиты.Ссылка);
		
		СтрокаИсполнение.Сумма = Знак * ПогашеннаяСумма;
		НераспределеннаяСумма = НераспределеннаяСумма - ПогашеннаяСумма;
		
		СтрокаОстатка.Сумма = СтрокаОстатка.Сумма - СтрокаИсполнение.Сумма;
		
	КонецЦикла;
	
	Если НераспределеннаяСумма > 0 И Не ЭтоРегистрацияИсполненияДоговоров Тогда
		
		ТекстОшибки = НСтр("ru='Сумма поступления превышает остаток неисполненных обязательств по плану-графику закупок.
			|
			|Указана сумма поступления: %1; Остаток обязательств по графику: %2; Превышение: %3'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
			ОбщегоНазначенияБГУ.ФорматСумм(Поступление.СуммаВал, Поступление.Валюта, "0"),
			ОбщегоНазначенияБГУ.ФорматСумм(Поступление.СуммаВал - НераспределеннаяСумма, Поступление.Валюта, "0"),
			ОбщегоНазначенияБГУ.ФорматСумм(НераспределеннаяСумма, Поступление.Валюта, "0"));
		
		Если ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("Всего", Реквизиты.Ссылка.Метаданные(), Поступление.ИмяСписка) Тогда
			ПолеСумма = Поступление.ИмяСписка + "[" + Формат(Поступление.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Всего";
		ИначеЕсли ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("Сумма", Реквизиты.Ссылка.Метаданные(), Поступление.ИмяСписка) Тогда
			ПолеСумма = Поступление.ИмяСписка + "[" + Формат(Поступление.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Сумма";
		Иначе
			ПолеСумма = "";
		КонецЕсли;
		
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Реквизиты.Ссылка, ПолеСумма, "Объект");
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьСтрокуИсполненияОбязательствСверхГрафика(ТаблицаИсполнениеОбязательствПоставщиками, НераспределеннаяСумма, Отбор, Поступление, ИмяТаблицы, Реквизиты) Экспорт
	
	Знак = ?(СтрНайти(ИмяТаблицы, "Возврат") > 0, -1, +1);
	ЭтоРегистрацияИсполненияДоговоров = (ИмяТаблицы = "РегистрацияИсполненияДоговоров");
	
	Если НераспределеннаяСумма <= 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаИсполнение = ТаблицаИсполнениеОбязательствПоставщиками.Добавить();
	ЗаполнитьЗначенияСвойств(СтрокаИсполнение, Поступление,
		"ИмяСписка,СинонимСписка,НомерСтроки,ВидДоговора");
	ЗаполнитьЗначенияСвойств(СтрокаИсполнение, Отбор,
		"КФО,КПС,СчетРасчетов,Контрагент,Валюта");
	
	Если Отбор.Свойство("Договор") Тогда
		СтрокаИсполнение.Договор = Отбор.Договор;
	КонецЕсли;
	Если Отбор.Свойство("ИФО") Тогда
		СтрокаИсполнение.ИФО = Отбор.ИФО;
	КонецЕсли;
	Если Отбор.Свойство("КЭК") Тогда
		СтрокаИсполнение.КЭК = Отбор.КЭК;
	КонецЕсли;
	
	СтрокаИсполнение.Регистратор = ?(ЭтоРегистрацияИсполненияДоговоров, Поступление.Регистратор, Реквизиты.Ссылка);
	
	СтрокаИсполнение.Сумма = Знак * НераспределеннаяСумма;
	
КонецПроцедуры

// ИсполнениеДоговоровСПокупателями

// Структура таблицы для формирования движений по регистру "Исполнение договоров с покупателями".
//
Функция ПустаяТаблицаИсполнениеДоговоровСПокупателями() Экспорт

	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Идентификация строки.
	ПустаяТаблица.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	
	// Счет и аналитика учета расчетов с контрагентами.
	ПустаяТаблица.Колонки.Добавить("КЭК",          Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ПустаяТаблица.Колонки.Добавить("СчетРасчетов", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("Контрагент",   Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ПустаяТаблица.Колонки.Добавить("Договор",      Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ПустаяТаблица.Колонки.Добавить("Валюта",       Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	
	// Данные графика исполнения обязательств.
	ПустаяТаблица.Колонки.Добавить("ИсполнитьДо", Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ПустаяТаблица.Колонки.Добавить("Сумма", ОписаниеТипаСуммы);
	
	// Дополнительные колонки.
	ПустаяТаблица.Колонки.Добавить("ВидДоговора", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДоговоровКонтрагентов"));
	ПустаяТаблица.Колонки.Добавить("Регистратор", Метаданные.ОпределяемыеТипы.РегистраторыРегистраБухгалтерии.Тип);
	
	Возврат ПустаяТаблица;
	
КонецФункции

// Формирует таблицу исполнения договоров с покупателями.
//
Функция ТаблицаИсполнениеДоговоровСПокупателями(ТаблицыРеализации, ДокументОбъект, Реквизиты, Отказ) Экспорт
	
	ТаблицаИсполнениеДоговоровСПокупателями = ПустаяТаблицаИсполнениеДоговоровСПокупателями();
	
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров") Тогда
		Возврат ТаблицаИсполнениеДоговоровСПокупателями; // Контроль не ведется.
	КонецЕсли;
	
	МетаданныеДокумента = Реквизиты.Ссылка.Метаданные();
	
	Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ОтразитьВГрафикеИсполненияДоговора", МетаданныеДокумента)
		И ЗначениеЗаполнено(ДокументОбъект.ОтразитьВГрафикеИсполненияДоговора)
		И ДокументОбъект.ОтразитьВГрафикеИсполненияДоговора <> Перечисления.СтатусыДокументовКонтрольИсполненияДоговоров.ОтразитьСейчас Тогда
		Возврат ТаблицаИсполнениеДоговоровСПокупателями; // Не отражаем автоматически.
	КонецЕсли;
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ИспользоватьВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	ИспользоватьДетализациюПоКОСГУ = ПолучитьФункциональнуюОпцию("ИспользоватьДетализациюПоКОСГУВГрафикахСПокупателями");
	
	Для Каждого ТаблицаРеализации Из ТаблицыРеализации Цикл
		
		ИмяТаблицы = ТаблицаРеализации.Ключ;
		Таблица    = ТаблицаРеализации.Значение;
		
		Если Таблица.Колонки.Найти("Договор") = Неопределено Тогда // Договор в шапке документа.
			
			Если НЕ ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("Договор", МетаданныеДокумента) Тогда
				Продолжить; // Невозможно определить договор.
			КонецЕсли;
			
			РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОбъект.Договор,
				"Ссылка,Контрагент,ВидДоговора,ВестиПланГрафикИсполнения");
			Если НЕ РеквизитыДоговора.ВестиПланГрафикИсполнения
				ИЛИ НЕ (РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем
					ИЛИ РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СОтправителемТрансферта) Тогда
				Продолжить;
			КонецЕсли;
			
			ОтгрузкиПоДоговорамСГрафикомРеализации = Таблица.Скопировать();
			ОтгрузкиПоДоговорамСГрафикомРеализации.Колонки.Добавить("Контрагент",
				Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
			ОтгрузкиПоДоговорамСГрафикомРеализации.Колонки.Добавить("Договор",
				Новый ОписаниеТипов("СправочникСсылка.Договоры"));
			ОтгрузкиПоДоговорамСГрафикомРеализации.Колонки.Добавить("ВидДоговора",
				Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДоговоровКонтрагентов"));
			ОтгрузкиПоДоговорамСГрафикомРеализации.ЗаполнитьЗначения(РеквизитыДоговора.Контрагент,  "Контрагент");
			ОтгрузкиПоДоговорамСГрафикомРеализации.ЗаполнитьЗначения(РеквизитыДоговора.Ссылка,      "Договор");
			ОтгрузкиПоДоговорамСГрафикомРеализации.ЗаполнитьЗначения(РеквизитыДоговора.ВидДоговора, "ВидДоговора");
			
		Иначе // В таблице есть колонка "Договор".
		
			РеквизитыДоговоров = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(
				ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(Таблица.ВыгрузитьКолонку("Договор")),
					"ВидДоговора,ВестиПланГрафикИсполнения");
				
			// Оставим только строки по договорам нужных видов с контролем исполнения.
			ОтгрузкиПоДоговорамСГрафикомРеализации = Таблица.СкопироватьКолонки();
			ОтгрузкиПоДоговорамСГрафикомРеализации.Колонки.Добавить("ВидДоговора",
				Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДоговоровКонтрагентов"));
			Для Каждого СтрокаРеализации Из Таблица Цикл
				
				Если НЕ ЗначениеЗаполнено(СтрокаРеализации.Договор) Тогда
					Продолжить;
				КонецЕсли;
				
				ВидДоговора = РеквизитыДоговоров[СтрокаРеализации.Договор].ВидДоговора;
				ВестиПланГрафикИсполнения = РеквизитыДоговоров[СтрокаРеализации.Договор].ВестиПланГрафикИсполнения;
				Если ВестиПланГрафикИсполнения
					И (ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем
					ИЛИ ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СОтправителемТрансферта) Тогда
					НоваяСтрока = ОтгрузкиПоДоговорамСГрафикомРеализации.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРеализации);
					НоваяСтрока.ВидДоговора = ВидДоговора;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		Если ОтгрузкиПоДоговорамСГрафикомРеализации.Количество() = 0 Тогда
			Возврат ТаблицаИсполнениеДоговоровСПокупателями;
		КонецЕсли;
		
		ЕстьКолонкаСчетРасчетов = (Таблица.Колонки.Найти("СчетРасчетов") <> Неопределено);
		ЕстьКолонкаКПС          = (Таблица.Колонки.Найти("КПС") <> Неопределено);
		ЕстьКолонкаКЭК          = (Таблица.Колонки.Найти("КЭК") <> Неопределено);
		ЕстьКолонкаВалюта       = (Таблица.Колонки.Найти("Валюта") <> Неопределено);
		
		ЕстьКолонкаОтразитьВГрафикеИсполнения =
			(Таблица.Колонки.Найти("ОтразитьВГрафикеИсполненияДоговора") <> Неопределено);
		
		Колонки = ОтгрузкиПоДоговорамСГрафикомРеализации.Колонки;
		Если ЕстьКолонкаКЭК И Не ИспользоватьДетализациюПоКОСГУ Тогда
			Колонки.Удалить(Колонки.Индекс(Колонки.КЭК));
		КонецЕсли;
		
		НеисполненныеДоговора = НеисполненныеДоговораСПокупателями(ОтгрузкиПоДоговорамСГрафикомРеализации, Реквизиты.Организация);
		
		Для Каждого Реализация Из ОтгрузкиПоДоговорамСГрафикомРеализации Цикл
			
			Если ЕстьКолонкаОтразитьВГрафикеИсполнения
				И ЗначениеЗаполнено(Реализация.ОтразитьВГрафикеИсполненияДоговора)
				И Реализация.ОтразитьВГрафикеИсполненияДоговора <> Перечисления.СтатусыДокументовКонтрольИсполненияДоговоров.ОтразитьСейчас Тогда
				Продолжить;
			КонецЕсли;
			
			НераспределенныйОстаток = Реализация.СуммаВал;
			
			Отбор = Новый Структура("Контрагент,КФО");
			ЗаполнитьЗначенияСвойств(Отбор, Реализация);
			
			Если ЗначениеЗаполнено(Реализация.Договор) Тогда
				Отбор.Вставить("Договор", Реализация.Договор);
			КонецЕсли;
			Если ИспользоватьУчетПоИФО Тогда
				Отбор.Вставить("ИФО", Реализация.ИФО);
			КонецЕсли;
			Если ИспользоватьВалютныйУчет Тогда
				Отбор.Вставить("Валюта", ?(ЕстьКолонкаВалюта, Реализация.Валюта, БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета()) );
			Иначе
				Отбор.Вставить("Валюта", БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета());
			КонецЕсли;
			
			Если ИмяТаблицы = "РеализацияМатериальныхЗапасов"
				ИЛИ ИмяТаблицы = "РеализацияОсновныхСредств" Тогда
				
				Отбор.Вставить("СчетРасчетов", Реализация.СчетРасчетов);
				Отбор.Вставить("КПС", Реализация.КПС);
				Если ИспользоватьДетализациюПоКОСГУ Тогда
					Отбор.Вставить("КЭК", Реализация.КЭКДоходов);
				КонецЕсли;
				
			Иначе // РеализацияУслугРабот и пр.
				
				// СчетРасчетов.
				Если ЕстьКолонкаСчетРасчетов Тогда
					Отбор.Вставить("СчетРасчетов", Реализация.СчетРасчетов);
				Иначе
					Отбор.Вставить("СчетРасчетов", ПланыСчетов.ЕПСБУ.ПустаяСсылка());
				КонецЕсли;
				
				// КПС.
				Если ЕстьКолонкаКПС Тогда
					Отбор.Вставить("КПС", Реализация.КПС);
				Иначе
					Отбор.Вставить("КПС", Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка());
				КонецЕсли;
				
				// КЭК.
				Если ИспользоватьДетализациюПоКОСГУ Тогда
					Если ЕстьКолонкаКЭК Тогда
						Отбор.Вставить("КЭК", Реализация.КЭК);
					Иначе
						Отбор.Вставить("КЭК", Справочники.КОСГУ.ПустаяСсылка());
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			
			НайденныеНеисполненныеДоговора = ?(НеисполненныеДоговора.Количество() > 0, НеисполненныеДоговора.НайтиСтроки(Отбор),
				НеисполненныеДоговора.СкопироватьКолонки());
			ДобавитьСтрокиИсполненияДоговоровПоГрафику(
				ТаблицаИсполнениеДоговоровСПокупателями,
				НераспределенныйОстаток,
				НайденныеНеисполненныеДоговора,
				Реализация,
				ИмяТаблицы,
				Реквизиты, Отказ);
			
			ДобавитьСтрокуИсполненияДоговоровСверхГрафика(
				ТаблицаИсполнениеДоговоровСПокупателями,
				НераспределенныйОстаток,
				Отбор,
				Реализация,
				ИмяТаблицы,
				Реквизиты);
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТаблицаИсполнениеДоговоровСПокупателями;
	
КонецФункции

Процедура ДобавитьСтрокиИсполненияДоговоровПоГрафику(ТаблицаИсполнениеДоговоровСПокупателями, НераспределеннаяСумма, НеисполненныеДоговора, Реализация, ИмяТаблицы, Реквизиты, Отказ) Экспорт
	
	Знак = ?(СтрНайти(ИмяТаблицы, "Возврат") > 0, -1, +1);
	ЭтоРегистрацияИсполненияДоговоров = (ИмяТаблицы = "РегистрацияИсполненияДоговоров");
	
	Для Каждого СтрокаОстатка Из НеисполненныеДоговора Цикл
		
		Если НераспределеннаяСумма <= 0 Тогда
			Прервать;
		КонецЕсли;
		
		ПогашеннаяСумма = Мин(НераспределеннаяСумма, Знак * СтрокаОстатка.Сумма);
		Если ПогашеннаяСумма <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаИсполнение = ТаблицаИсполнениеДоговоровСПокупателями.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаИсполнение, СтрокаОстатка,
			"ИФО,КФО,КПС,КЭК,СчетРасчетов,Контрагент,Договор,Валюта,ИсполнитьДо");
		ЗаполнитьЗначенияСвойств(СтрокаИсполнение, Реализация,
			"ИмяСписка,СинонимСписка,НомерСтроки,ВидДоговора");
		
		СтрокаИсполнение.Регистратор = ?(ЭтоРегистрацияИсполненияДоговоров, Реализация.Регистратор, Реквизиты.Ссылка);
		
		СтрокаИсполнение.Сумма = Знак * ПогашеннаяСумма;
		НераспределеннаяСумма = НераспределеннаяСумма - ПогашеннаяСумма;
		
		СтрокаОстатка.Сумма = СтрокаОстатка.Сумма - СтрокаИсполнение.Сумма;
		
	КонецЦикла;
	
	Если НераспределеннаяСумма > 0 И Не ЭтоРегистрацияИсполненияДоговоров Тогда
		
		ТекстОшибки = НСтр("ru='Сумма реализации превышает остаток неисполненных обязательств по плану-графику реализации.
			|
			|Указана сумма реализации: %1; Остаток обязательств по графику: %2; Превышение: %3'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
			ОбщегоНазначенияБГУ.ФорматСумм(Реализация.СуммаВал, Реализация.Валюта, "0"),
			ОбщегоНазначенияБГУ.ФорматСумм(Реализация.СуммаВал - НераспределеннаяСумма, Реализация.Валюта, "0"),
			ОбщегоНазначенияБГУ.ФорматСумм(НераспределеннаяСумма, Реализация.Валюта, "0"));
		
		Если ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("Всего", Реквизиты.Ссылка.Метаданные(), Реализация.ИмяСписка) Тогда
			ПолеСумма = Реализация.ИмяСписка + "[" + Формат(Реализация.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Всего";
		ИначеЕсли ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("Сумма", Реквизиты.Ссылка.Метаданные(), Реализация.ИмяСписка) Тогда
			ПолеСумма = Реализация.ИмяСписка + "[" + Формат(Реализация.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Сумма";
		Иначе
			ПолеСумма = "";
		КонецЕсли;
		
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Реквизиты.Ссылка, ПолеСумма, "Объект");
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьСтрокуИсполненияДоговоровСверхГрафика(ТаблицаИсполнениеДоговоровСПокупателями, НераспределеннаяСумма, Отбор, Реализация, ИмяТаблицы, Реквизиты) Экспорт
	
	Знак = ?(СтрНайти(ИмяТаблицы, "Возврат") > 0, -1, +1);
	ЭтоРегистрацияИсполненияДоговоров = (ИмяТаблицы = "РегистрацияИсполненияДоговоров");
	
	Если НераспределеннаяСумма = 0 Тогда
		// Отрицательные суммы (сторно доходов от реализации, излишне начисленных в предыдущих периодах)
		// также регистрируем в исполнении плана-графика релазиации.
		Возврат;
	КонецЕсли;
	
	СтрокаИсполнение = ТаблицаИсполнениеДоговоровСПокупателями.Добавить();
	ЗаполнитьЗначенияСвойств(СтрокаИсполнение, Реализация,
		"ИмяСписка,СинонимСписка,НомерСтроки,ВидДоговора");
	ЗаполнитьЗначенияСвойств(СтрокаИсполнение, Отбор,
		"КФО,КПС,СчетРасчетов,Контрагент,Валюта");
	
	Если Отбор.Свойство("Договор") Тогда
		СтрокаИсполнение.Договор = Отбор.Договор;
	КонецЕсли;
	Если Отбор.Свойство("ИФО") Тогда
		СтрокаИсполнение.ИФО = Отбор.ИФО;
	КонецЕсли;
	Если Отбор.Свойство("КЭК") Тогда
		СтрокаИсполнение.КЭК = Отбор.КЭК;
	КонецЕсли;
	
	СтрокаИсполнение.Регистратор = ?(ЭтоРегистрацияИсполненияДоговоров, Реализация.Регистратор, Реквизиты.Ссылка);
	
	СтрокаИсполнение.Сумма = Знак * НераспределеннаяСумма;
	
КонецПроцедуры

// ПланОплатПоФактуПоступленияРеализации

// Структура таблицы источника данных "План оплат по факту поступления, реализации".
//
Функция ПустаяТаблицаПланОплатПоФактуПоступленияРеализации() Экспорт

	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Признак доходы / расходы. Определяется по КЭК (КОСГУ) расчетов.
	ПустаяТаблица.Колонки.Добавить("ЭтоДоходы", Новый ОписаниеТипов("Булево"));
	
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	
	// Счет и аналитика учета расчетов с контрагентами.
	ПустаяТаблица.Колонки.Добавить("КЭК",          Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ПустаяТаблица.Колонки.Добавить("СчетРасчетов", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("Контрагент",   Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ПустаяТаблица.Колонки.Добавить("Договор",      Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ПустаяТаблица.Колонки.Добавить("Валюта",       Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	
	// Дополнительная аналитика расчетов.
	ПустаяТаблица.Колонки.Добавить("ДопКлассификация", Новый ОписаниеТипов("СправочникСсылка.ДополнительнаяБюджетнаяКлассификация"));
	ПустаяТаблица.Колонки.Добавить("КодМероприятия",   Новый ОписаниеТипов("СправочникСсылка.Мероприятия"));
	ПустаяТаблица.Колонки.Добавить("КодЦели",          Новый ОписаниеТипов("СправочникСсылка.ВидыЦелевыхСредств"));
	
	// Данные графика платежей.
	ПустаяТаблица.Колонки.Добавить("ВидРасчетов", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыРасчетовПоЗаймам"));
	ПустаяТаблица.Колонки.Добавить("ОплатитьДо",  Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ПустаяТаблица.Колонки.Добавить("Сумма", ОписаниеТипаСуммы);
	
	// Дополнительные колонки.
	ПустаяТаблица.Колонки.Добавить("ВидДоговора", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДоговоровКонтрагентов"));
	ПустаяТаблица.Колонки.Добавить("РасчетыВВалюте", Новый ОписаниеТипов("Булево"));
	
	Возврат ПустаяТаблица;

КонецФункции

// Формирует таблицу источника данных "План оплат по факту поступления, реализации".
//
Функция ТаблицаПланОплатПоФактуПоступленияРеализации(ТаблицаРасчетовСЗачетомАвансов, ДокументОбъект, Реквизиты, Отказ) Экспорт
	
	ТаблицаПланОплатПоФактуПоступленияРеализации = ПустаяТаблицаПланОплатПоФактуПоступленияРеализации();
	
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров") Тогда
		Возврат ТаблицаПланОплатПоФактуПоступленияРеализации; // Контроль не ведется.
	КонецЕсли;
	
	МетаданныеДокумента = ДокументОбъект.Метаданные();
	Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ЗапланироватьОплату", МетаданныеДокумента) // Документы реализации, поступления товаров, работ, услуг.
		И Не ДокументОбъект.ЗапланироватьОплату Тогда
		Возврат ТаблицаПланОплатПоФактуПоступленияРеализации; // Не отражаем в графике платежей.
	КонецЕсли;
	
	Реквизиты.Вставить("ИспользоватьУчетПоИФО", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет", ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	Реквизиты.Вставить("ИспользоватьДетализациюПоКОСГУВГрафикахСПокупателями",
		ПолучитьФункциональнуюОпцию("ИспользоватьДетализациюПоКОСГУВГрафикахСПокупателями"));
	Реквизиты.Вставить("ИспользоватьДетализациюПоКОСГУВГрафикахСПоставщиками",
		ПолучитьФункциональнуюОпцию("ИспользоватьДетализациюПоКОСГУВГрафикахСПоставщиками"));
	Реквизиты.Вставить("ИспользоватьДополнительнуюАналитикуВГрафикахПлатежейСПокупателями",
		ПолучитьФункциональнуюОпцию("ИспользоватьДополнительнуюАналитикуВГрафикахПлатежейСПокупателями"));
	Реквизиты.Вставить("ИспользоватьДополнительнуюАналитикуВГрафикахПлатежейСПоставщиками",
		ПолучитьФункциональнуюОпцию("ИспользоватьДополнительнуюАналитикуВГрафикахПлатежейСПоставщиками"));
	
	Для Каждого СтрокаРасчетов Из ТаблицаРасчетовСЗачетомАвансов Цикл
		
		Если СтрокаРасчетов.ЭтоЗачетАванса Тогда
			Продолжить; // Уже оплачено.
		КонецЕсли;
		
		ВестиГрафикПлатежей = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаРасчетов.Договор, "ВестиГрафикПлатежей");
		Если Не ВестиГрафикПлатежей Тогда
			Продолжить; // График платежей по договору не ведется.
		КонецЕсли;
		
		ЭтоДоходы = БухгалтерскийУчет.СчетВИерархии(СтрокаРасчетов.СчетРасчетов, "205.00,209.00");
		Если ЭтоДоходы И СтрокаРасчетов.ВидДоговора <> Перечисления.ВидыДоговоровКонтрагентов.СПокупателем Тогда
			ТекстОшибки = НСтр("ru='Невозможно запланировать оплату реализованных товаров, работ, услуг по договору вида ""%1"".
				|Операции реализации товаров, работ, услуг отражаются по договорам вида ""%2"".'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
				СтрокаРасчетов.ВидДоговора,
				Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Реквизиты.Ссылка, "ЗапланироватьОплату", "Объект");
			Продолжить;
		ИначеЕсли Не ЭтоДоходы И СтрокаРасчетов.ВидДоговора <> Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком Тогда
			ТекстОшибки = НСтр("ru='Невозможно запланировать оплату поступивших товаров, работ, услуг по договору вида ""%1"".
				|Операции поступления товаров, работ, услуг отражаются по договорам вида ""%2"".'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
				СтрокаРасчетов.ВидДоговора,
				Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Реквизиты.Ссылка, "ЗапланироватьОплату", "Объект");
			Продолжить;
		КонецЕсли;
		
		СтрокаОплаты = ТаблицаПланОплатПоФактуПоступленияРеализации.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрокаОплаты, СтрокаРасчетов,
			"ИФО,КФО,КПС,СчетРасчетов,Контрагент,Договор,Валюта,
			|ВидДоговора,РасчетыВВалюте");
		
		СтрокаОплаты.ЭтоДоходы = ЭтоДоходы;
		
		ИспользоватьДополнительнуюАналитику = ?(ЭтоДоходы,
			Реквизиты.ИспользоватьДополнительнуюАналитикуВГрафикахПлатежейСПокупателями,
			Реквизиты.ИспользоватьДополнительнуюАналитикуВГрафикахПлатежейСПоставщиками);
		ИспользоватьДетализациюПоКОСГУ = ?(ЭтоДоходы,
			Реквизиты.ИспользоватьДетализациюПоКОСГУВГрафикахСПокупателями,
			Реквизиты.ИспользоватьДетализациюПоКОСГУВГрафикахСПоставщиками);
		
		Если Реквизиты.Свойство("ВидРасчетов") И ЗначениеЗаполнено(Реквизиты.ВидРасчетов) Тогда
			СтрокаОплаты.ВидРасчетов = Реквизиты.ВидРасчетов;
		Иначе
			СтрокаОплаты.ВидРасчетов = Перечисления.ВидыРасчетовПоЗаймам.ОсновнойДолг;
		КонецЕсли;
		
		Если ИспользоватьДополнительнуюАналитику Тогда
			// На данный момент этот сценарий не поддерживается.
		КонецЕсли;
		Если ИспользоватьДетализациюПоКОСГУ Тогда
			СтрокаОплаты.КЭК = БухгалтерскийУчетПовтИсп.АналитическийКЭКпоСчету(СтрокаОплаты.СчетРасчетов);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаОплаты.Валюта) И Не Реквизиты.ИспользоватьВалютныйУчет Тогда
			СтрокаОплаты.Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
		КонецЕсли;
		
		СтрокаОплаты.ОплатитьДо = ДокументОбъект.ОплатитьДо;
		СтрокаОплаты.Сумма = СтрокаРасчетов.СуммаРасчетов;
		
	КонецЦикла;
	
	Возврат ТаблицаПланОплатПоФактуПоступленияРеализации;
	
КонецФункции

// ДатаИсполненияПриПоступленииСредствВР

// Структура таблицы источника данных "Дата исполнения при поступлении средств (304 01)".
//
Функция ПустаяТаблицаДатаИсполненияПриПоступленииСредствВР() Экспорт

	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	
	// Счет и аналитика учета расчетов с контрагентами.
	ПустаяТаблица.Колонки.Добавить("КЭК",          Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ПустаяТаблица.Колонки.Добавить("СчетРасчетов", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("Контрагент",   Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ПустаяТаблица.Колонки.Добавить("Договор",      Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ПустаяТаблица.Колонки.Добавить("Валюта",       Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	
	// Дополнительная аналитика расчетов.
	ПустаяТаблица.Колонки.Добавить("ДопКлассификация", Новый ОписаниеТипов("СправочникСсылка.ДополнительнаяБюджетнаяКлассификация"));
	ПустаяТаблица.Колонки.Добавить("КодМероприятия",   Новый ОписаниеТипов("СправочникСсылка.Мероприятия"));
	ПустаяТаблица.Колонки.Добавить("КодЦели",          Новый ОписаниеТипов("СправочникСсылка.ВидыЦелевыхСредств"));
	
	// Данные графика платежей.
	ПустаяТаблица.Колонки.Добавить("ВидРасчетов", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыРасчетовПоЗаймам"));
	ПустаяТаблица.Колонки.Добавить("ОплатитьДо",  Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ПустаяТаблица.Колонки.Добавить("Сумма", ОписаниеТипаСуммы);
	
	Возврат ПустаяТаблица;

КонецФункции

// Формирует таблицу источника данных "Дата исполнения при поступлении средств (304 01)".
//
Функция ТаблицаДатаИсполненияПриПоступленииСредствВР(РасшифровкаПлатежаУнифицированная, ДокументОбъект, Реквизиты, Отказ) Экспорт
	
	ТаблицаДатаИсполненияПриПоступленииСредствВР = ПустаяТаблицаДатаИсполненияПриПоступленииСредствВР();
	
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров") Тогда
		Возврат ТаблицаДатаИсполненияПриПоступленииСредствВР; // Контроль не ведется.
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Реквизиты.ДатаИсполнения) Тогда
		Возврат ТаблицаДатаИсполненияПриПоступленииСредствВР; // Дата исполнения не указана.
	КонецЕсли;
	
	Для Каждого Платеж Из РасшифровкаПлатежаУнифицированная Цикл
		
		Если Не ЗначениеЗаполнено(Платеж.Договор) Тогда
			ТекстОшибки = НСтр("ru='Для отражения даты исполнения по средствам во временном распоряжении (счет 304.01) необходимо заполнить поле «Договор» (основание возникновения обязательств).'");
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Реквизиты.Ссылка, , "Объект");
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаДатаИсполненияПриПоступленииСредствВР.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Платеж);
		
		Если Не ЗначениеЗаполнено(Платеж.ВидРасчетов) Тогда
			// По средствам во временном распоряжении учитывается только "Основной долг".
			НоваяСтрока.ВидРасчетов = Перечисления.ВидыРасчетовПоЗаймам.ОсновнойДолг;
		КонецЕсли;
		Если Реквизиты.Свойство("КПС30401") И ЗначениеЗаполнено(Реквизиты.КПС30401) Тогда
			НоваяСтрока.КПС = Реквизиты.КПС30401;
		КонецЕсли;
		
		НоваяСтрока.КЭК = БухгалтерскийУчетПовтИсп.КЭК0(); // По средствам во временном распоряжении используется КЭК 000.
		
		НоваяСтрока.Сумма = Платеж.СуммаРасчетов;
		НоваяСтрока.ОплатитьДо = Реквизиты.ДатаИсполнения;
		
	КонецЦикла;
	
	Возврат ТаблицаДатаИсполненияПриПоступленииСредствВР;
	
КонецФункции

// Структура таблицы источника данных "Дата исполнения при перечислении средств (304 01)".
//
Функция ПустаяТаблицаДатаИсполненияПриПеречисленииСредствВР() Экспорт

	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	
	// Счет и аналитика учета расчетов с контрагентами.
	ПустаяТаблица.Колонки.Добавить("КЭК",          Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ПустаяТаблица.Колонки.Добавить("СчетРасчетов", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("Контрагент",   Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ПустаяТаблица.Колонки.Добавить("Договор",      Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ПустаяТаблица.Колонки.Добавить("Валюта",       Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	
	// Дополнительная аналитика расчетов.
	ПустаяТаблица.Колонки.Добавить("ДопКлассификация", Новый ОписаниеТипов("СправочникСсылка.ДополнительнаяБюджетнаяКлассификация"));
	ПустаяТаблица.Колонки.Добавить("КодМероприятия",   Новый ОписаниеТипов("СправочникСсылка.Мероприятия"));
	ПустаяТаблица.Колонки.Добавить("КодЦели",          Новый ОписаниеТипов("СправочникСсылка.ВидыЦелевыхСредств"));
	
	// Данные графика платежей.
	ПустаяТаблица.Колонки.Добавить("ВидРасчетов", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыРасчетовПоЗаймам"));
	ПустаяТаблица.Колонки.Добавить("ОплатитьДо",  Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ПустаяТаблица.Колонки.Добавить("Сумма", ОписаниеТипаСуммы);
	
	Возврат ПустаяТаблица;

КонецФункции

// Формирует таблицу источника данных "Дата исполнения при перечислении средств (304 01)".
//
Функция ТаблицаДатаИсполненияПриПеречисленииСредствВР(РасшифровкаПлатежаУнифицированная, ДокументОбъект, Реквизиты, Отказ) Экспорт
	
	ТаблицаДатаИсполненияПриПеречисленииСредствВР = ПустаяТаблицаДатаИсполненияПриПеречисленииСредствВР();
	
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров") Тогда
		Возврат ТаблицаДатаИсполненияПриПеречисленииСредствВР; // Контроль не ведется.
	КонецЕсли;
	
	Реквизиты.Вставить("ИспользоватьУчетПоИФО", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет", ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	Реквизиты.Вставить("ИспользоватьДетализациюПоКОСГУ", ПолучитьФункциональнуюОпцию("ИспользоватьДетализациюПоКОСГУВГрафикахСПоставщиками"));
	Реквизиты.Вставить("ИспользоватьДополнительнуюАналитику", ПолучитьФункциональнуюОпцию("ИспользоватьДополнительнуюАналитикуВГрафикахПлатежейСПоставщиками"));
	
	Для Каждого Платеж Из РасшифровкаПлатежаУнифицированная Цикл
		Если Не ЗначениеЗаполнено(Платеж.ВидРасчетов) Тогда
			// По средствам во временном распоряжении учитывается только "Основной долг".
			Платеж.ВидРасчетов = Перечисления.ВидыРасчетовПоЗаймам.ОсновнойДолг;
		КонецЕсли;
		Если Реквизиты.Свойство("Контрагент") И ЗначениеЗаполнено(Реквизиты.Контрагент) Тогда
			Платеж.Контрагент = Реквизиты.Контрагент;
		КонецЕсли;
		Если Реквизиты.Свойство("КПС30401") И ЗначениеЗаполнено(Реквизиты.КПС30401) Тогда
			Платеж.КПС = Реквизиты.КПС30401;
		КонецЕсли;
		Если Реквизиты.ИспользоватьДетализациюПоКОСГУ Тогда
			Платеж.КЭК = БухгалтерскийУчетПовтИсп.КЭК0(); // По средствам во временном распоряжении используется КЭК 000.
		Иначе
			Платеж.КЭК = Справочники.КОСГУ.ПустаяСсылка(); // Учет по КЭК не ведется.
		КонецЕсли;
	КонецЦикла;
	Если Не Реквизиты.ИспользоватьДополнительнуюАналитику Тогда
		РасшифровкаПлатежаУнифицированная.Колонки.Удалить("ДопКлассификация");
		РасшифровкаПлатежаУнифицированная.Колонки.Удалить("КодМероприятия");
		РасшифровкаПлатежаУнифицированная.Колонки.Удалить("КодЦели");
	КонецЕсли;
	
	НеисполненныеПлатежи = НеисполненныеПлатежиПоставщикамКредиторам(РасшифровкаПлатежаУнифицированная, ДокументОбъект.Организация);
	
	// Погашаем неисполненные платежи в порядке возрастания даты исполнения (ОплатитьДо).
	Для Каждого Платеж Из РасшифровкаПлатежаУнифицированная Цикл
		
		Если Не ЗначениеЗаполнено(Платеж.Договор) Тогда
			Продолжить;
		КонецЕсли;
		
		НераспределенныйОстаток = Платеж.СуммаРасчетов;
		
		Отбор = Новый Структура("ЭтоПоступление,Контрагент,ВидРасчетов,КФО,КПС,СчетРасчетов");
		ЗаполнитьЗначенияСвойств(Отбор, Платеж);
		
		Если ЗначениеЗаполнено(Платеж.Договор) Тогда
			Отбор.Вставить("Договор", Платеж.Договор);
		КонецЕсли;
		Если Реквизиты.ИспользоватьУчетПоИФО Тогда
			Отбор.Вставить("ИФО", Платеж.ИФО);
		КонецЕсли;
		Если Реквизиты.ИспользоватьВалютныйУчет Тогда
			Отбор.Вставить("Валюта", Платеж.Валюта);
		КонецЕсли;
		Если Реквизиты.ИспользоватьДополнительнуюАналитику Тогда
			Отбор.Вставить("ДопКлассификация", Платеж.ДопКлассификация);
			Отбор.Вставить("КодМероприятия",   Платеж.КодМероприятия);
			Отбор.Вставить("КодЦели",          Платеж.КодЦели);
		КонецЕсли;
		
		НайденныеНеисполненныеПлатежи = ?(НеисполненныеПлатежи.Количество() > 0, НеисполненныеПлатежи.НайтиСтроки(Отбор),
			НеисполненныеПлатежи.СкопироватьКолонки());
		ДобавитьСтрокиПеречислениеСредствВРПоГрафику(
			ТаблицаДатаИсполненияПриПеречисленииСредствВР,
			НераспределенныйОстаток,
			НайденныеНеисполненныеПлатежи,
			Платеж,
			Реквизиты, Отказ);
		
	КонецЦикла;
	
	Возврат ТаблицаДатаИсполненияПриПеречисленииСредствВР;
	
КонецФункции

Процедура ДобавитьСтрокиПеречислениеСредствВРПоГрафику(ТаблицаОплат, НераспределеннаяСумма, НеисполненныеПлатежи, Платеж, Реквизиты, Отказ)
	
	Для Каждого СтрокаОстатка Из НеисполненныеПлатежи Цикл
		
		Если НераспределеннаяСумма <= 0 Тогда
			Прервать;
		КонецЕсли;
		
		ПогашеннаяСумма = Мин(НераспределеннаяСумма, СтрокаОстатка.Сумма);
		Если ПогашеннаяСумма <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаОплаты = ТаблицаОплат.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаОплаты, СтрокаОстатка,
			"ИФО,КФО,КПС,КЭК,СчетРасчетов,Контрагент,Договор,Валюта,ВидРасчетов,ОплатитьДо,
			|КодЦели,КодМероприятия,ДопКлассификация");
		
		СтрокаОплаты.Сумма = ПогашеннаяСумма;
		НераспределеннаяСумма = НераспределеннаяСумма - ПогашеннаяСумма;
		СтрокаОстатка.Сумма = СтрокаОстатка.Сумма - СтрокаОплаты.Сумма;
		
	КонецЦикла;
	
	Если НераспределеннаяСумма > 0 Тогда
		
		ТекстОшибки = НСтр("ru='Не определена дата исполнения задолженности по средствам во временном распоряжении, сумма оплаты превышает остаток неоплаченной задолженности по графику платежей.
			|
			|Указана сумма оплаты: %1; Остаток задолженности по графику: %2; Превышение: %3'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
			ОбщегоНазначенияБГУ.ФорматСумм(Платеж.СуммаРасчетов, Платеж.Валюта, "0"),
			ОбщегоНазначенияБГУ.ФорматСумм(Платеж.СуммаРасчетов - НераспределеннаяСумма, Платеж.Валюта, "0"),
			ОбщегоНазначенияБГУ.ФорматСумм(НераспределеннаяСумма, Платеж.Валюта, "0"));
		
		ИмяСписка = ?(ЗначениеЗаполнено(Платеж.ИмяСписка), Платеж.ИмяСписка, "РасшифровкаПлатежа");
		Если ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("СуммаВал", Реквизиты.Ссылка.Метаданные(), "РасшифровкаПлатежа") Тогда
			ПолеСумма = ИмяСписка + "[" + Формат(Платеж.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].СуммаВал";
		Иначе
			ПолеСумма = ИмяСписка + "[" + Формат(Платеж.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Сумма";
		КонецЕсли;
		
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Реквизиты.Ссылка, ПолеСумма, "Объект");
		
	КонецЕсли;
	
КонецПроцедуры

	#КонецОбласти

	#Область ДетализацияПоКОСГУВГрафикахПоДоговорам

Функция ИспользоватьДетализациюПоКОСГУВГрафикахПоДоговорам(ВидДоговора) Экспорт
	
	ИспользоватьДетализациюПоКОСГУ = Ложь;
	Если ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком
		ИЛИ ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ПолученныйКредит
		ИЛИ ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ВыпускЦенныхБумаг
		ИЛИ ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии Тогда
		ИспользоватьДетализациюПоКОСГУ = ПолучитьФункциональнуюОпцию("ИспользоватьДетализациюПоКОСГУВГрафикахСПоставщиками");
	ИначеЕсли ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем
		ИЛИ ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СОтправителемТрансферта
		ИЛИ ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ПредоставленныйКредит Тогда
		ИспользоватьДетализациюПоКОСГУ = ПолучитьФункциональнуюОпцию("ИспользоватьДетализациюПоКОСГУВГрафикахСПокупателями");
	КонецЕсли;
	
	Возврат ИспользоватьДетализациюПоКОСГУ;
	
КонецФункции

// Отключение настройки "Использовать детализацию по КОСГУ в графиках - с покупателями".
// Вызывается через подситему ДлительныеОперации при изменении константы в форме НастройкаПараметровУчета.
// 
// Параметры:
// 	ПараметрыПроцедуры - Структура - не используется
// 	АдресРезультата - Строка - не используется
Процедура ОтключитьДетализациюПоКОСГУВГрафикахСПокупателями(ПараметрыПроцедуры, АдресРезультата) Экспорт
	
	ОтключитьДетализациюПоКОСГУВГрафикахПоДоговорам("ИспользоватьДетализациюПоКОСГУВГрафикахСПокупателями");
	
КонецПроцедуры

// Отключение настройки "Использовать детализацию по КОСГУ в графиках - с поставщиками".
// Вызывается через подситему ДлительныеОперации при изменении константы в форме НастройкаПараметровУчета.
// 
// Параметры:
// 	ПараметрыПроцедуры - Структура - не используется
// 	АдресРезультата - Строка - не используется
Процедура ОтключитьДетализациюПоКОСГУВГрафикахСПоставщиками(ПараметрыПроцедуры, АдресРезультата) Экспорт
	
	ОтключитьДетализациюПоКОСГУВГрафикахПоДоговорам("ИспользоватьДетализациюПоКОСГУВГрафикахСПоставщиками");
	
КонецПроцедуры

// Отключение настройки "Использовать детализацию по КОСГУ в графиках - с покупателями / с поставщиками".
// 
// Параметры:
// 	ИмяКонстанты - Строка - "ИспользоватьДетализациюПоКОСГУВГрафикахСПокупателями", либо "ИспользоватьДетализациюПоКОСГУВГрафикахСПоставщиками"
Процедура ОтключитьДетализациюПоКОСГУВГрафикахПоДоговорам(ИмяКонстанты)
	
	Если ИмяКонстанты = "ИспользоватьДетализациюПоКОСГУВГрафикахСПокупателями" Тогда
		ИмяРегистра1 = "ОплатаОтПокупателейДебиторов";
		ИмяРегистра2 = "ИсполнениеДоговоровСПокупателями";
	ИначеЕсли ИмяКонстанты = "ИспользоватьДетализациюПоКОСГУВГрафикахСПоставщиками" Тогда
		ИмяРегистра1 = "ОплатаПоставщикамКредиторам";
		ИмяРегистра2 = "ИсполнениеОбязательствПоставщиками";
	Иначе
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		
		// Блокируем константу и весь регистр накопления.
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Константа." + ИмяКонстанты);
		ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления." + ИмяРегистра1 + ".НаборЗаписей");
		ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления." + ИмяРегистра2 + ".НаборЗаписей");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		
		ОтключитьДетализациюПоКОСГУВРегистре(ИмяРегистра1);
		ОтключитьДетализациюПоКОСГУВРегистре(ИмяРегистра2);
		
		Константы[ИмяКонстанты].Установить(Ложь);
		ЗафиксироватьТранзакцию();
		
	Исключение	
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Отключение детализации по КОСГУ в графиках исполнения договоров'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// Очищает значения в измерении КЭК в регистрах ОплатаОтПокупателейДебиторов, ОплатаПоставщикамКредиторам, ИсполнениеДоговоровСПокупателями, ИсполнениеОбязательствПоставщиками.
// 
// Параметры:
// 	ИмяРегистра - Строка - "ОплатаОтПокупателейДебиторов", либо "ОплатаПоставщикамКредиторам", либо "ИсполнениеДоговоровСПокупателями", либо "ИсполнениеОбязательствПоставщиками"
Процедура ОтключитьДетализациюПоКОСГУВРегистре(ИмяРегистра)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОплатаОтПокупателейДебиторов.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрНакопления.ОплатаОтПокупателейДебиторов КАК ОплатаОтПокупателейДебиторов
	|ГДЕ
	|	ОплатаОтПокупателейДебиторов.КЭК <> ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ОплатаОтПокупателейДебиторов", ИмяРегистра);
	Результат = Запрос.Выполнить();

	ВыборкаРегистратор = Результат.Выбрать();
	Пока ВыборкаРегистратор.Следующий() Цикл
		
		НаборЗаписей = РегистрыНакопления[ИмяРегистра].СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(ВыборкаРегистратор.Регистратор);
		НаборЗаписей.Прочитать();
		
		Для Каждого Запись Из НаборЗаписей Цикл
			Запись.КЭК = Справочники.КОСГУ.ПустаяСсылка();
		КонецЦикла;
		
		НаборЗаписей.ОбменДанными.Загрузка = Истина;
		НаборЗаписей.Записать(Истина);
		
	КонецЦикла;
	
КонецПроцедуры

	#КонецОбласти

	#Область ДополнительнаяАналитикаВГрафикахПлатежей

Функция ИспользоватьДополнительнуюАналитикуВГрафикахПлатежей(ВидДоговора) Экспорт
	
	ИспользоватьДополнительнуюАналитикуВГрафикахПлатежей = Ложь;
	Если ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком
		ИЛИ ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ПолученныйКредит
		ИЛИ ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ВыпускЦенныхБумаг
		ИЛИ ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии Тогда
		ИспользоватьДополнительнуюАналитикуВГрафикахПлатежей = ПолучитьФункциональнуюОпцию("ИспользоватьДополнительнуюАналитикуВГрафикахПлатежейСПоставщиками");
	ИначеЕсли ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем
		ИЛИ ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СОтправителемТрансферта
		ИЛИ ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ПредоставленныйКредит Тогда
		ИспользоватьДополнительнуюАналитикуВГрафикахПлатежей = ПолучитьФункциональнуюОпцию("ИспользоватьДополнительнуюАналитикуВГрафикахПлатежейСПокупателями");
	КонецЕсли;
	
	Возврат ИспользоватьДополнительнуюАналитикуВГрафикахПлатежей;
	
КонецФункции

// Отключение настройки "Использовать дополнительную аналитику в графиках платежей - с покупателями".
// Вызывается через подситему ДлительныеОперации при изменении константы в форме НастройкаПараметровУчета.
// 
// Параметры:
// 	ПараметрыПроцедуры - Структура - не используется
// 	АдресРезультата - Строка - не используется
Процедура ОтключитьДополнительнуюАналитикуВГрафикахПлатежейСПокупателями(ПараметрыПроцедуры, АдресРезультата) Экспорт
	
	ОтключитьДополнительнуюАналитикуВГрафикахПлатежей("ИспользоватьДополнительнуюАналитикуВГрафикахПлатежейСПокупателями");
	
КонецПроцедуры

// Отключение настройки "Использовать дополнительную аналитику в графиках платежей - с поставщиками".
// Вызывается через подситему ДлительныеОперации при изменении константы в форме НастройкаПараметровУчета.
// 
// Параметры:
// 	ПараметрыПроцедуры - Структура - не используется
// 	АдресРезультата - Строка - не используется
Процедура ОтключитьДополнительнуюАналитикуВГрафикахПлатежейСПоставщиками(ПараметрыПроцедуры, АдресРезультата) Экспорт
	
	ОтключитьДополнительнуюАналитикуВГрафикахПлатежей("ИспользоватьДополнительнуюАналитикуВГрафикахПлатежейСПоставщиками");
	
КонецПроцедуры

// Отключение настройки "Использовать дополнительную аналитику в графиках платежей - с покупателями / с поставщиками".
// 
// Параметры:
// 	ИмяКонстанты - Строка - "ИспользоватьДополнительнуюАналитикуВГрафикахПлатежейСПокупателями", либо "ИспользоватьДополнительнуюАналитикуВГрафикахПлатежейСПоставщиками"
Процедура ОтключитьДополнительнуюАналитикуВГрафикахПлатежей(ИмяКонстанты)
	
	Если ИмяКонстанты = "ИспользоватьДополнительнуюАналитикуВГрафикахПлатежейСПокупателями" Тогда
		ИмяРегистра = "ОплатаОтПокупателейДебиторов";
	ИначеЕсли ИмяКонстанты = "ИспользоватьДополнительнуюАналитикуВГрафикахПлатежейСПоставщиками" Тогда
		ИмяРегистра = "ОплатаПоставщикамКредиторам";
	Иначе
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		
		// Блокируем константу и весь регистр накопления.
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Константа." + ИмяКонстанты);
		ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления." + ИмяРегистра + ".НаборЗаписей");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		
		ОтключитьДополнительнуюАналитикуВРегистре(ИмяРегистра);
		
		Константы[ИмяКонстанты].Установить(Ложь);
		ЗафиксироватьТранзакцию();
		
	Исключение	
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Отключение дополнительной аналитики в графиках платежей'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// Очищает значения в измерениях ДопКлассификация, КодМероприятия, КодЦели в регистрах ОплатаОтПокупателейДебиторов и ОплатаПоставщикамКредиторам.
// 
// Параметры:
// 	ИмяРегистра - Строка - "ОплатаОтПокупателейДебиторов", либо "ОплатаПоставщикамКредиторам"
Процедура ОтключитьДополнительнуюАналитикуВРегистре(ИмяРегистра)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОплатаОтПокупателейДебиторов.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрНакопления.ОплатаОтПокупателейДебиторов КАК ОплатаОтПокупателейДебиторов
	|ГДЕ
	|	НЕ(ОплатаОтПокупателейДебиторов.ДопКлассификация = ЗНАЧЕНИЕ(Справочник.ДополнительнаяБюджетнаяКлассификация.ПустаяСсылка)
	|				И ОплатаОтПокупателейДебиторов.КодМероприятия = ЗНАЧЕНИЕ(Справочник.Мероприятия.ПустаяСсылка)
	|				И ОплатаОтПокупателейДебиторов.КодЦели = ЗНАЧЕНИЕ(Справочник.ВидыЦелевыхСредств.ПустаяСсылка))";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ОплатаОтПокупателейДебиторов", ИмяРегистра);
	Результат = Запрос.Выполнить();

	ВыборкаРегистратор = Результат.Выбрать();
	Пока ВыборкаРегистратор.Следующий() Цикл
		
		НаборЗаписей = РегистрыНакопления[ИмяРегистра].СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(ВыборкаРегистратор.Регистратор);
		НаборЗаписей.Прочитать();
		
		Для Каждого Запись Из НаборЗаписей Цикл
			Запись.ДопКлассификация = Справочники.ДополнительнаяБюджетнаяКлассификация.ПустаяСсылка();
			Запись.КодМероприятия   = Справочники.Мероприятия.ПустаяСсылка();
			Запись.КодЦели          = Справочники.ВидыЦелевыхСредств.ПустаяСсылка();
		КонецЦикла;
		
		НаборЗаписей.ОбменДанными.Загрузка = Истина;
		НаборЗаписей.Записать(Истина);
		
	КонецЦикла;
	
КонецПроцедуры

	#КонецОбласти

	#Область АнализЗадолженности

Функция КлассифицироватьЗадолженностьПоСрокамДолга(ТаблицаНеисполненные, ИмяКолонкиСрокДолга, НаДату) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Запланировано", 0);
	Результат.Вставить("Просрочено", 0);
	Результат.Вставить("ПросроченоБолее30Дней", 0);
	Результат.Вставить("ПросроченоБолее90Дней", 0);
	
	ДатаПросрочено            = КонецДня(НаДату - 1*24*60*60);
	ДатаПросроченоБолее30Дней = КонецДня(НаДату - 31*24*60*60);
	ДатаПросроченоБолее90Дней = КонецДня(НаДату - 91*24*60*60);
	
	Для Каждого СтрокаНеисполненные Из ТаблицаНеисполненные Цикл
		
		Результат.Запланировано = Результат.Запланировано + СтрокаНеисполненные.Сумма;
		
		Если ЗначениеЗаполнено(СтрокаНеисполненные[ИмяКолонкиСрокДолга]) Тогда
			Если СтрокаНеисполненные[ИмяКолонкиСрокДолга] <= ДатаПросрочено Тогда
				Результат.Просрочено = Результат.Просрочено + СтрокаНеисполненные.Сумма;
			КонецЕсли;
			Если СтрокаНеисполненные[ИмяКолонкиСрокДолга] <= ДатаПросроченоБолее30Дней Тогда
				Результат.ПросроченоБолее30Дней = Результат.ПросроченоБолее30Дней + СтрокаНеисполненные.Сумма;
			КонецЕсли;
			Если СтрокаНеисполненные[ИмяКолонкиСрокДолга] <= ДатаПросроченоБолее90Дней Тогда
				Результат.ПросроченоБолее90Дней = Результат.ПросроченоБолее90Дней + СтрокаНеисполненные.Сумма;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

	#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьОтборОстатков(Запрос, ОтборОстатков)
	
	Если ТипЗнч(ОтборОстатков) = Тип("Структура") Тогда
		ТипОтбораОстатков = "Структура";
	ИначеЕсли ТипЗнч(ОтборОстатков) = Тип("ТаблицаЗначений") Тогда
		ТипОтбораОстатков = "ТаблицаЗначений";
	Иначе
		ТипОтбораОстатков = "Отсутствует";
	КонецЕсли;
	
	// ИФО.
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	Если ИспользоватьУчетПоИФО И ТипОтбораОстатков = "ТаблицаЗначений"
		И ОтборОстатков.Колонки.Найти("ИФО") <> Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоИФО", "ИФО В (&ИФО)");
		Запрос.УстановитьПараметр("ИФО", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
			ОтборОстатков.ВыгрузитьКолонку("ИФО")) );
	ИначеЕсли ИспользоватьУчетПоИФО И ТипОтбораОстатков = "Структура" И ОтборОстатков.Свойство("ИФО") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоИФО", "ИФО В (&ИФО)");
		Запрос.УстановитьПараметр("ИФО", ОтборОстатков.ИФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоИФО", "ИСТИНА");
	КонецЕсли;
	
	// КФО.
	Если ТипОтбораОстатков = "ТаблицаЗначений"
		И ОтборОстатков.Колонки.Найти("КФО") <> Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоКФО", "КФО В (&КФО)");
		Запрос.УстановитьПараметр("КФО", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
			ОтборОстатков.ВыгрузитьКолонку("КФО")) );
	ИначеЕсли ТипОтбораОстатков = "Структура" И ОтборОстатков.Свойство("КФО") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоКФО", "КФО В (&КФО)");
		Запрос.УстановитьПараметр("КФО", ОтборОстатков.КФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоКФО", "ИСТИНА");
	КонецЕсли;
	
	// КПС.
	Если ТипОтбораОстатков = "ТаблицаЗначений"
		И ОтборОстатков.Колонки.Найти("КПСРасчетов") <> Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоКПС", "КПС В (&КПС)");
		Запрос.УстановитьПараметр("КПС", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
			ОтборОстатков.ВыгрузитьКолонку("КПСРасчетов")) );
	ИначеЕсли ТипОтбораОстатков = "ТаблицаЗначений"
		И ОтборОстатков.Колонки.Найти("КПС") <> Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоКПС", "КПС В (&КПС)");
		Запрос.УстановитьПараметр("КПС", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
			ОтборОстатков.ВыгрузитьКолонку("КПС")) );
	ИначеЕсли ТипОтбораОстатков = "Структура" И ОтборОстатков.Свойство("КПСРасчетов") Тогда
