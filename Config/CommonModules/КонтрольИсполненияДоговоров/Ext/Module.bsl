	#Область АнализЗадолженности

// Параметры анализа задолженности для функции АнализЗадолженности.
//
// Возвращаемое значение:
//  Структура:
//   * ИспользоватьДанныеГрафиковПоДоговорамНаДатуАнализаЗадолженности - Булево.
//   * ЗаполнятьСУчетомИсправленияОшибокПрошлыхЛет - Булево.
//   * КонецПериодаИсправленияОшибокПрошлыхЛет - Дата.
//
Функция НовыеПараметрыАнализаЗадолженности() Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ИспользоватьДанныеГрафиковПоДоговорамНаДатуАнализаЗадолженности", Неопределено);
	Результат.Вставить("ЗаполнятьСУчетомИсправленияОшибокПрошлыхЛет", Ложь);
	Результат.Вставить("КонецПериодаИсправленияОшибокПрошлыхЛет", Дата(1, 1, 1));
	
	Возврат Результат;
	
КонецФункции

// Пустая таблица со структурой колонок возвращаемого значения функции АнализЗадолженности.
//
Функция НовыйАнализЗадолженности() Экспорт
	
	Возврат КонтрольИсполненияДоговоров.АнализЗадолженности(
			Справочники.Организации.ПустаяСсылка(),
				Дата(1,1,1));
	
КонецФункции

// Базовая функция анализа задолженности (дебиторская, кредиторская) по расчетам с контрагентами (счета 205.00, 302.00 и др.).
//
Функция АнализЗадолженности(Знач Организация, Знач НаДату,
	Знач Отбор = Неопределено, Знач ВидЗадолженности = Неопределено, Знач ТипЗадолженности = Неопределено,
	ПараметрыАнализаЗадолженности = Неопределено) Экспорт
	
	Если ТипЗнч(ПараметрыАнализаЗадолженности) = Тип("Булево") Тогда
		// До версии 2.0.106 это был параметр ИспользоватьДанныеГрафиковПоДоговорамНаДатуАнализаЗадолженности типа Булево.
		ИспользоватьДанныеГрафиковПоДоговорамНаДатуАнализаЗадолженности = ПараметрыАнализаЗадолженности;
		ПараметрыАнализаЗадолженности = НовыеПараметрыАнализаЗадолженности();
		ПараметрыАнализаЗадолженности.ИспользоватьДанныеГрафиковПоДоговорамНаДатуАнализаЗадолженности =
			ИспользоватьДанныеГрафиковПоДоговорамНаДатуАнализаЗадолженности;
	КонецЕсли;
	Если ПараметрыАнализаЗадолженности = Неопределено Тогда
		ПараметрыАнализаЗадолженности = НовыеПараметрыАнализаЗадолженности();
	КонецЕсли;
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ИспользоватьВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	ВалютаРегламентированногоУчета = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета();
	
	ИспользоватьДанныеГрафиковПоДоговорамНаДатуАнализаЗадолженности =
		?(ПараметрыАнализаЗадолженности.ИспользоватьДанныеГрафиковПоДоговорамНаДатуАнализаЗадолженности <> Неопределено,
			ПараметрыАнализаЗадолженности.ИспользоватьДанныеГрафиковПоДоговорамНаДатуАнализаЗадолженности,
			ПолучитьФункциональнуюОпцию("ИспользоватьДанныеГрафиковПоДоговорамНаДатуАнализаЗадолженности"));
	
	ЗаполнятьСУчетомИсправленияОшибокПрошлыхЛет = // Режим "С учетом исправления ошибок прошлых лет".
		(НачалоГода(НаДату) = НачалоДня(НаДату)) // Только при заполнении на начало года.
		И ИспользоватьДанныеГрафиковПоДоговорамНаДатуАнализаЗадолженности // При использовании актуальных данных графиков исправления ошибок прошлых лет уже включены.
		И ПараметрыАнализаЗадолженности.ЗаполнятьСУчетомИсправленияОшибокПрошлыхЛет;
	
	Если ЗаполнятьСУчетомИсправленияОшибокПрошлыхЛет Тогда
		// В режиме "С учетом исправления ошибок прошлых лет" остатки по счетам расчетов определяем на начало дня (начало года).
		НаДату = НачалоДня(НаДату);
	Иначе // В противном случае остатки по объектам учета определяются на конец дня, указанного в поле "Сведения от".
		НаДату = КонецДня(НаДату);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НаДату",         Новый Граница(НаДату, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("НаДатуПлюсДень", Запрос.Параметры.НаДату.Значение + 1); // Следующий момент времени относительно границы остатков (НаДату).
	Запрос.УстановитьПараметр("Организация",    Организация);
	Запрос.УстановитьПараметр("ВалютаРеглУчета", ВалютаРегламентированногоУчета);
	
	Запрос.УстановитьПараметр("ИспользоватьДанныеГрафиковПоДоговорамНаДатуАнализаЗадолженности",
		ИспользоватьДанныеГрафиковПоДоговорамНаДатуАнализаЗадолженности);
	
	ВидыСубконтоКонтрагентыДоговоры = Новый Массив;
	ВидыСубконтоКонтрагентыДоговоры.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
	ВидыСубконтоКонтрагентыДоговоры.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
	Запрос.УстановитьПараметр("ВидыСубконтоКонтрагентыДоговоры", ВидыСубконтоКонтрагентыДоговоры);
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СводныеПоказатели.Организация КАК Организация,
	|	СводныеПоказатели.Контрагент КАК Контрагент,
	|	СводныеПоказатели.Договор КАК Договор,
	|	СводныеПоказатели.ВидРасчетов КАК ВидРасчетов,
	|	ВЫБОР
	|		КОГДА СводныеПоказатели.ВидРасчетов = ЗНАЧЕНИЕ(Перечисление.ВидыРасчетовПоЗаймам.Проценты)
	|			ТОГДА 1
	|		КОГДА СводныеПоказатели.ВидРасчетов = ЗНАЧЕНИЕ(Перечисление.ВидыРасчетовПоЗаймам.ОсновнойДолг)
	|			ТОГДА 2
	|		КОГДА СводныеПоказатели.ВидРасчетов = ЗНАЧЕНИЕ(Перечисление.ВидыРасчетовПоЗаймам.ПениНаПроценты)
	|			ТОГДА 3
