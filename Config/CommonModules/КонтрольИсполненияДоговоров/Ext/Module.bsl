	КомандаОткрытьГрафикИсполненияДоговора.Заголовок   = НСтр("ru='Отчет'");
	КомандаОткрытьГрафикИсполненияДоговора.Подсказка   = НСтр("ru='Открыть график исполнения договора'");
	КомандаОткрытьГрафикИсполненияДоговора.Картинка    = БиблиотекаКартинок.Отчет;
	КомандаОткрытьГрафикИсполненияДоговора.Отображение = ОтображениеКнопки.Картинка;
	КомандаОткрытьГрафикИсполненияДоговора.ИзменяетСохраняемыеДанные = Ложь;
	
	КнопкаОткрытьГрафикИсполненияДоговора = ФормаДокумента.Элементы.Добавить("ПланированиеИКонтрольОткрытьГрафикИсполненияДоговора", Тип("КнопкаФормы"), ГруппаЭлементов);
	КнопкаОткрытьГрафикИсполненияДоговора.ИмяКоманды = "ПланированиеИКонтрольОткрытьГрафикИсполненияДоговора";
	КнопкаОткрытьГрафикИсполненияДоговора.Вид = ВидКнопкиФормы.Гиперссылка;
	КнопкаОткрытьГрафикИсполненияДоговора.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Центр;
	
	// Кнопка "Изменить график исполнения договора".
	КомандаИзменитьГрафикИсполненияДоговора = ФормаДокумента.Команды.Добавить("ПланированиеИКонтрольИзменитьГрафикИсполненияДоговора");
	КомандаИзменитьГрафикИсполненияДоговора.Действие    = "Подключаемый_КонтрольИсполненияДоговоровИзменитьГрафик";
	КомандаИзменитьГрафикИсполненияДоговора.Заголовок   = НСтр("ru='Изменить'");
	КомандаИзменитьГрафикИсполненияДоговора.Подсказка   = НСтр("ru='Изменить график исполнения договора'");
	КомандаИзменитьГрафикИсполненияДоговора.Картинка    = БиблиотекаКартинок.Календарь;
	КомандаИзменитьГрафикИсполненияДоговора.Отображение = ОтображениеКнопки.КартинкаИТекст;
	КомандаИзменитьГрафикИсполненияДоговора.ИзменяетСохраняемыеДанные = Ложь;
	
	КнопкаИзменитьГрафикИсполненияДоговора = ФормаДокумента.Элементы.Добавить("ПланированиеИКонтрольИзменитьГрафикИсполненияДоговора", Тип("КнопкаФормы"), ГруппаЭлементов);
	КнопкаИзменитьГрафикИсполненияДоговора.ИмяКоманды = "ПланированиеИКонтрольИзменитьГрафикИсполненияДоговора";
	КнопкаИзменитьГрафикИсполненияДоговора.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
	КнопкаИзменитьГрафикИсполненияДоговора.ВертикальноеПоложениеВГруппе = ВертикальноеПоложениеЭлемента.Центр;
	
КонецПроцедуры

Процедура НарисоватьГруппуКонтрольИсполнения(ГруппаЭлементов, ФормаДокумента, ДокументОбъект)
	
	МетаданныеДокумента = ДокументОбъект.Метаданные();
	ЕстьНастрокаОтразитьВГрафикеИсполненияДоговора =
		ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ОтразитьВГрафикеИсполненияДоговора", МетаданныеДокумента);
	
	Если ЕстьНастрокаОтразитьВГрафикеИсполненияДоговора
		И ЗначениеЗаполнено(ДокументОбъект.ОтразитьВГрафикеИсполненияДоговора) Тогда
		ОтразитьВГрафикеИсполненияДоговора = ДокументОбъект.ОтразитьВГрафикеИсполненияДоговора;
	Иначе // Если для документа не предусмотрено управление статусом отражения - отражаем.
		ОтразитьВГрафикеИсполненияДоговора = Перечисления.СтатусыДокументовКонтрольИсполненияДоговоров.ОтразитьСейчас;
	КонецЕсли;
	
	// Декорация "Отразить в графике исполнения - Отразить сейчас".
	ДекорацияОтражатьВГрафике = ФормаДокумента.Элементы.Добавить("КонтрольИсполненияДоговоровОтразитьСейчас", Тип("ДекорацияФормы"), ГруппаЭлементов);
	ДекорацияОтражатьВГрафике.Вид = ВидДекорацииФормы.Картинка;
	ДекорацияОтражатьВГрафике.Картинка = БиблиотекаКартинок.СтатусДокументаОтразитьИсполнениеПланаСейчас;
	ДекорацияОтражатьВГрафике.Видимость = ЕстьНастрокаОтразитьВГрафикеИсполненияДоговора
		И ОтразитьВГрафикеИсполненияДоговора = Перечисления.СтатусыДокументовКонтрольИсполненияДоговоров.ОтразитьСейчас;
	ДекорацияОтражатьВГрафике.РастягиватьПоГоризонтали = Ложь;
	
	// Декорация "Отразить в графике исполнения - Отразить потом".
	ДекорацияНеОтражатьВГрафике = ФормаДокумента.Элементы.Добавить("КонтрольИсполненияДоговоровОтразитьПозднее", Тип("ДекорацияФормы"), ГруппаЭлементов);
	ДекорацияНеОтражатьВГрафике.Вид = ВидДекорацииФормы.Картинка;
	ДекорацияНеОтражатьВГрафике.Картинка = БиблиотекаКартинок.СтатусДокументаОтразитьИсполнениеПланаПозднее;
	ДекорацияНеОтражатьВГрафике.Видимость = ЕстьНастрокаОтразитьВГрафикеИсполненияДоговора
		И ОтразитьВГрафикеИсполненияДоговора = Перечисления.СтатусыДокументовКонтрольИсполненияДоговоров.ОтразитьПозднее;
	ДекорацияНеОтражатьВГрафике.РастягиватьПоГоризонтали = Ложь;
	
	// Декорация "Отразить в графике исполнения - Не отражать".
	ДекорацияНеОтражатьВГрафике = ФормаДокумента.Элементы.Добавить("КонтрольИсполненияДоговоровНеОтражать", Тип("ДекорацияФормы"), ГруппаЭлементов);
	ДекорацияНеОтражатьВГрафике.Вид = ВидДекорацииФормы.Картинка;
	ДекорацияНеОтражатьВГрафике.Картинка = БиблиотекаКартинок.СтатусДокументаНеОтражатьИсполнениеПлана;
	ДекорацияНеОтражатьВГрафике.Видимость = ЕстьНастрокаОтразитьВГрафикеИсполненияДоговора
		И ОтразитьВГрафикеИсполненияДоговора = Перечисления.СтатусыДокументовКонтрольИсполненияДоговоров.НеОтражать;
	ДекорацияНеОтражатьВГрафике.РастягиватьПоГоризонтали = Ложь;
	
	// Декорация "Отразить в графике исполнения - Календарь".
	ДекорацияОтражатьВГрафике = ФормаДокумента.Элементы.Добавить("КонтрольИсполненияДоговоровКалендарь", Тип("ДекорацияФормы"), ГруппаЭлементов);
	ДекорацияОтражатьВГрафике.Вид = ВидДекорацииФормы.Картинка;
	ДекорацияОтражатьВГрафике.Картинка = БиблиотекаКартинок.Календарь;
	ДекорацияОтражатьВГрафике.Видимость = НЕ ЕстьНастрокаОтразитьВГрафикеИсполненияДоговора;
	ДекорацияОтражатьВГрафике.РастягиватьПоГоризонтали = Ложь;
	ДекорацияОтражатьВГрафике.Ширина = 1;
	
	// Гиперссылка "Контроль".
	КомандаПоказатьСтатус = ФормаДокумента.Команды.Добавить("КонтрольИсполненияДоговоровПоказатьСтатус");
	КомандаПоказатьСтатус.Действие    = "Подключаемый_КонтрольИсполненияДоговоровПоказатьСтатус";
	КомандаПоказатьСтатус.Заголовок   = НСтр("ru='Контроль'");
	КомандаПоказатьСтатус.Подсказка   = НСтр("ru='Контроль исполнения договора'");
	КомандаПоказатьСтатус.ИзменяетСохраняемыеДанные = Ложь;
	
	КнопкаПоказатьСтатус = ФормаДокумента.Элементы.Добавить("КонтрольИсполненияДоговоровПоказатьСтатус", Тип("КнопкаФормы"), ГруппаЭлементов);
	КнопкаПоказатьСтатус.ИмяКоманды = "КонтрольИсполненияДоговоровПоказатьСтатус";
	КнопкаПоказатьСтатус.Вид = ВидКнопкиФормы.Гиперссылка;
	КнопкаПоказатьСтатус.Отображение = ОтображениеКнопки.Текст;
	КнопкаПоказатьСтатус.РастягиватьПоГоризонтали = Ложь;
	КнопкаПоказатьСтатус.ТолькоВоВсехДействиях = Ложь;
	
КонецПроцедуры

	#Область АнализЗадолженности

Функция АнализЗадолженностиРассчитатьВычисляемыеПоказателиВСтроке(СтрокаГрафика, Знач НаДату, НераспределенныйОстаток, Знач СуммаПросрочено, Знач СуммаНеисполнено,
			КурсРасчетов, КолонкиПросроченнаяКраткосрочнаяДолгосрочная)
	
	Если НаДату = НачалоГода(НаДату) Тогда // При заполнении в режиме "С учетом исправления ошибок прошлых лет", в противном случае НаДату приведено к концу дня.
		НаДату = НачалоГода(НаДату) - 1; // Корректируем дату для корректной классификации задолженности по срокам исполнения.
	КонецЕсли;
	
	КонецТекущегоГода = КонецГода(НаДату);
	КонецПериодаКраткосрочнойЗадолженности = КонецДня(ДобавитьМесяц(НаДату, 12));
	Более2ЛетОтДатыАнализа = КонецДня(ДобавитьМесяц(НаДату, 12*2));
	Более3ЛетОтДатыАнализа = КонецДня(ДобавитьМесяц(НаДату, 12*3));
	Более5ЛетОтДатыАнализа = КонецДня(ДобавитьМесяц(НаДату, 12*5));
	ДатаПросроченоБолее30Дней = КонецДня(НаДату - 31*24*60*60);
	ДатаПросроченоБолее60Дней = КонецДня(НаДату - 61*24*60*60);
	ДатаПросроченоБолее90Дней = КонецДня(НаДату - 91*24*60*60);
	ДатаПросроченоБолее180Дней = КонецДня(НаДату - 181*24*60*60);
	ДатаПросроченоБолее1Года = КонецДня(ДобавитьМесяц(НаДату, -12));
	ДатаПросроченоБолее3Лет = КонецДня(ДобавитьМесяц(НаДату, -3*12));
	
	СуммаПросрочено  = ?(ЗначениеЗаполнено(СуммаПросрочено),  СуммаПросрочено,  0);
	СуммаНеисполнено = ?(ЗначениеЗаполнено(СуммаНеисполнено), СуммаНеисполнено, 0);
	
	ПогашеннаяСумма = 0;
	
	Если СуммаПросрочено > 0 Тогда // Просроченная задолженность.
		
		ПогашеннаяСумма = Мин(СуммаПросрочено, НераспределенныйОстаток);
		СтрокаГрафика.Остаток       = СтрокаГрафика.Остаток       + ПогашеннаяСумма;
		СтрокаГрафика.Просроченная  = СтрокаГрафика.Просроченная  + ПогашеннаяСумма;
		СтрокаГрафика.Краткосрочная = СтрокаГрафика.Краткосрочная + ПогашеннаяСумма;
		
		// Срок исполнения просроченной задолженности <= отчетной даты (НаДату), это заведомо <= конца года.
		СтрокаГрафика.КраткосрочнаяДоКонцаГода = СтрокаГрафика.КраткосрочнаяДоКонцаГода + ПогашеннаяСумма;
		
		Если СтрокаГрафика.СрокИсполнения <= ДатаПросроченоБолее30Дней Тогда
			СтрокаГрафика.ПросроченнаяБолее30Дней = СтрокаГрафика.ПросроченнаяБолее30Дней + ПогашеннаяСумма;
		КонецЕсли;
		Если СтрокаГрафика.СрокИсполнения <= ДатаПросроченоБолее60Дней Тогда
			СтрокаГрафика.ПросроченнаяБолее60Дней = СтрокаГрафика.ПросроченнаяБолее60Дней + ПогашеннаяСумма;
		КонецЕсли;
		Если СтрокаГрафика.СрокИсполнения <= ДатаПросроченоБолее90Дней Тогда
			СтрокаГрафика.ПросроченнаяБолее90Дней = СтрокаГрафика.ПросроченнаяБолее90Дней + ПогашеннаяСумма;
		КонецЕсли;
		Если СтрокаГрафика.СрокИсполнения <= ДатаПросроченоБолее180Дней Тогда
			СтрокаГрафика.ПросроченнаяБолее180Дней = СтрокаГрафика.ПросроченнаяБолее180Дней + ПогашеннаяСумма;
		КонецЕсли;
		Если СтрокаГрафика.СрокИсполнения <= ДатаПросроченоБолее1Года Тогда
			СтрокаГрафика.ПросроченнаяБолее1Года = СтрокаГрафика.ПросроченнаяБолее1Года + ПогашеннаяСумма;
		КонецЕсли;
		Если СтрокаГрафика.СрокИсполнения <= ДатаПросроченоБолее3Лет Тогда
			СтрокаГрафика.ПросроченнаяБолее3Лет = СтрокаГрафика.ПросроченнаяБолее3Лет + ПогашеннаяСумма;
		КонецЕсли;
		
	ИначеЕсли СуммаНеисполнено > 0 Тогда // Неисполненные платежи, закупки, реализации после даты анализа.
		
		ПогашеннаяСумма = Мин(СуммаНеисполнено, НераспределенныйОстаток);
		СтрокаГрафика.Остаток = СтрокаГрафика.Остаток + ПогашеннаяСумма;
		
		Если НачалоДня(СтрокаГрафика.СрокИсполнения) = Дата(2999, 12, 31) Тогда // Краткосрочная по Письму Минфина от 26.02.2024 № 02-06-08/16384.
			СтрокаГрафика.Краткосрочная = СтрокаГрафика.Краткосрочная + ПогашеннаяСумма;
		ИначеЕсли СтрокаГрафика.СрокИсполнения > КонецПериодаКраткосрочнойЗадолженности Тогда // Долгосрочная.
			СтрокаГрафика.Долгосрочная = СтрокаГрафика.Долгосрочная + ПогашеннаяСумма;
			Если СтрокаГрафика.СрокИсполнения > Более2ЛетОтДатыАнализа Тогда
				СтрокаГрафика.ДолгосрочнаяБолее2Лет = СтрокаГрафика.ДолгосрочнаяБолее2Лет + ПогашеннаяСумма;
			КонецЕсли;
			Если СтрокаГрафика.СрокИсполнения > Более3ЛетОтДатыАнализа Тогда
				СтрокаГрафика.ДолгосрочнаяБолее3Лет = СтрокаГрафика.ДолгосрочнаяБолее3Лет + ПогашеннаяСумма;
			КонецЕсли;
			Если СтрокаГрафика.СрокИсполнения > Более5ЛетОтДатыАнализа Тогда
				СтрокаГрафика.ДолгосрочнаяБолее5Лет = СтрокаГрафика.ДолгосрочнаяБолее5Лет + ПогашеннаяСумма;
			КонецЕсли;
		Иначе // Краткосрочная.
			СтрокаГрафика.Краткосрочная = СтрокаГрафика.Краткосрочная + ПогашеннаяСумма;
			Если СтрокаГрафика.СрокИсполнения <= КонецТекущегоГода Тогда
				СтрокаГрафика.КраткосрочнаяДоКонцаГода = СтрокаГрафика.КраткосрочнаяДоКонцаГода + ПогашеннаяСумма;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	СтрокаГрафика.ТекущаяКраткосрочная = СтрокаГрафика.Краткосрочная - СтрокаГрафика.Просроченная;
	
	// Пересчет в валюту регламентированного учета по курсу в остатке на счете расчетов.
	СтрокаГрафика.ОстатокРуб = СтрокаГрафика.Остаток * КурсРасчетов;
	Для Каждого КолонкаПросроченнаяКраткосрочнаяДолгосрочная Из КолонкиПросроченнаяКраткосрочнаяДолгосрочная Цикл
		СтрокаГрафика[КолонкаПросроченнаяКраткосрочнаяДолгосрочная + "Руб"] = СтрокаГрафика[КолонкаПросроченнаяКраткосрочнаяДолгосрочная] * КурсРасчетов;
	КонецЦикла;
	
	Возврат ПогашеннаяСумма;
	
КонецФункции

Процедура СкорректироватьТаблицуОстатковПоДаннымИсправленияОшибокПрошлыхЛет(ТаблицаОстаткиПоСчетам, Знач Организация, Знач НачалоПериода, Знач КонецПериода, Знач Отбор)
	
	// Операции исправления ошибок прошлых лет с начала текущего года.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(КонецПериода));
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Обороты.Организация КАК Организация,
	|	Обороты.ИФО КАК ИФО,
	|	Обороты.КФО КАК КФО,
	|	Обороты.КПС КАК КПС,
	|	Обороты.СчетРасчетов КАК СчетРасчетов,
	|	Обороты.Контрагент КАК Контрагент,
	|	Обороты.Договор КАК Договор,
	|	ЕСТЬNULL(Обороты.Договор.ВестиГрафикПлатежей, ЛОЖЬ) КАК ВестиГрафикПлатежей,
	|	ЕСТЬNULL(Обороты.Договор.ВестиПланГрафикИсполнения, ЛОЖЬ) КАК ВестиПланГрафикИсполнения,
	|	Обороты.Валюта КАК Валюта,
	|	СУММА(Обороты.СуммаОборот) КАК СуммаОборот,
	|	СУММА(Обороты.ВалютнаяСуммаОборот) КАК ВалютнаяСуммаОборот,
	|	СУММА(Обороты.СуммаОборотДт) КАК СуммаОборотДт,
	|	СУММА(Обороты.ВалютнаяСуммаОборотДт) КАК ВалютнаяСуммаОборотДт,
	|	СУММА(Обороты.СуммаОборотКт) КАК СуммаОборотКт,
	|	СУММА(Обороты.ВалютнаяСуммаОборотКт) КАК ВалютнаяСуммаОборотКт
	|ИЗ
	|	(ВЫБРАТЬ
	|		ЕПСБУОбороты.Организация КАК Организация,
	|		ЕПСБУОбороты.ИФО КАК ИФО,
	|		ЕПСБУОбороты.КФО КАК КФО,
	|		ЕПСБУОбороты.КПС КАК КПС,
	|		ЕПСБУОбороты.Счет КАК СчетРасчетов,
	|		ВЫРАЗИТЬ(ЕПСБУОбороты.Субконто1 КАК Справочник.Контрагенты) КАК Контрагент,
	|		ВЫРАЗИТЬ(ЕПСБУОбороты.Субконто2 КАК Справочник.Договоры) КАК Договор,
	|		ВЫБОР
	|			КОГДА ЕПСБУОбороты.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|				ТОГДА &ВалютаРеглУчета
	|			ИНАЧЕ ЕСТЬNULL(ЕПСБУОбороты.Валюта, &ВалютаРеглУчета)
	|		КОНЕЦ КАК Валюта,
	|		ЕПСБУОбороты.СуммаОборот КАК СуммаОборот,
	|		ЕПСБУОбороты.ВалютнаяСуммаОборот КАК ВалютнаяСуммаОборот,
	|		ЕПСБУОбороты.СуммаОборотДт КАК СуммаОборотДт,
	|		ЕПСБУОбороты.СуммаОборотКт КАК СуммаОборотКт,
	|		ЕПСБУОбороты.ВалютнаяСуммаОборотДт КАК ВалютнаяСуммаОборотДт,
	|		ЕПСБУОбороты.ВалютнаяСуммаОборотКт КАК ВалютнаяСуммаОборотКт
	|	ИЗ
	|		РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|				&НачалоПериода,
	|				&КонецПериода,
	|				Авто,
	|				&УсловиеПоСчетОстатков,
	|				,
	|				Организация = &Организация
	|					И &УсловиеПоИФО
	|					И &УсловиеПоКФО
	|					И &УсловиеПоКПС
	|					И &УсловиеПоСубконто1
	|					И &УсловиеПоСубконто2,
	|				КорСчет В (&МассивСчетовОшибок),
	|				) КАК ЕПСБУОбороты) КАК Обороты
	|
	|СГРУППИРОВАТЬ ПО
	|	Обороты.Организация,
	|	Обороты.ИФО,
	|	Обороты.КФО,
	|	Обороты.КПС,
	|	Обороты.СчетРасчетов,
	|	Обороты.Контрагент,
	|	Обороты.Договор,
	|	ЕСТЬNULL(Обороты.Договор.ВестиГрафикПлатежей, ЛОЖЬ),
	|	ЕСТЬNULL(Обороты.Договор.ВестиПланГрафикИсполнения, ЛОЖЬ),
	|	Обороты.Валюта";
	
	Запрос.УстановитьПараметр("МассивСчетовОшибок", БухгалтерскийУчет.СписокСчетов(
		"304.84, 304.94, 304.66, 304.76, 304.86, 304.96, 
		|401.16, 401.17, 401.18, 401.19, 
		|401.26, 401.27, 401.28, 401.29"));
	
	ИспользоватьВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	Запрос.УстановитьПараметр("ВалютаРеглУчета", ВалютаРегламентированногоУчета);
	
	УстановитьОтборОстатков(Запрос, Отбор);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.СуммаОборот = 0 И Выборка.ВалютнаяСуммаОборот = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		// Добавляем исправления ошибок прошлых лет отдельными строками.
		НоваяСтрока = ТаблицаОстаткиПоСчетам.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка,
			"Организация,ИФО,КФО,КПС,СчетРасчетов,Контрагент,Договор,Валюта,
			|ВестиГрафикПлатежей,ВестиПланГрафикИсполнения");
		
		// Дебетовый оборот увеличивает (уменьшает) остаток по дебету,
		// кредитовый оборот увеличивает (уменьшает) остаток по кредиту.
		Если ИспользоватьВалютныйУчет И ЗначениеЗаполнено(Выборка.Валюта) И Выборка.Валюта <> ВалютаРегламентированногоУчета Тогда
			НоваяСтрока.ОстатокДт    = Выборка.ВалютнаяСуммаОборотДт;
			НоваяСтрока.ОстатокДтРуб = Выборка.СуммаОборотДт;
			НоваяСтрока.ОстатокКт    = Выборка.ВалютнаяСуммаОборотКт;
			НоваяСтрока.ОстатокКтРуб = Выборка.СуммаОборотКт;
		Иначе
			НоваяСтрока.ОстатокДт    = Выборка.СуммаОборотДт;
			НоваяСтрока.ОстатокДтРуб = Выборка.СуммаОборотДт;
			НоваяСтрока.ОстатокКт    = Выборка.СуммаОборотКт;
			НоваяСтрока.ОстатокКтРуб = Выборка.СуммаОборотКт;
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаОстаткиПоСчетам.Свернуть("Организация,ИФО,КФО,КПС,СчетРасчетов,Контрагент,Договор,Валюта,ВестиГрафикПлатежей,ВестиПланГрафикИсполнения",
		"ОстатокДт,ОстатокДтРуб,ОстатокКт,ОстатокКтРуб");
	
	// Сальдо остатка.
	Для Каждого СтрокаОстатков Из ТаблицаОстаткиПоСчетам Цикл
		
		Если СтрокаОстатков.ОстатокДт > СтрокаОстатков.ОстатокКт Тогда
			СтрокаОстатков.ОстатокДт = СтрокаОстатков.ОстатокДт - СтрокаОстатков.ОстатокКт;
			СтрокаОстатков.ОстатокКт = 0;
		Иначе
			СтрокаОстатков.ОстатокКт = СтрокаОстатков.ОстатокКт - СтрокаОстатков.ОстатокДт;
			СтрокаОстатков.ОстатокДт = 0;
		КонецЕсли;
		Если СтрокаОстатков.ОстатокДтРуб > СтрокаОстатков.ОстатокКтРуб Тогда
			СтрокаОстатков.ОстатокДтРуб = СтрокаОстатков.ОстатокДтРуб - СтрокаОстатков.ОстатокКтРуб;
			СтрокаОстатков.ОстатокКтРуб = 0;
		Иначе
			СтрокаОстатков.ОстатокКтРуб = СтрокаОстатков.ОстатокКтРуб - СтрокаОстатков.ОстатокДтРуб;
			СтрокаОстатков.ОстатокДтРуб = 0;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СкорректироватьТаблицуАнализаПоДаннымИсправленияОшибокПрошлыхЛет(АнализЗадолженности, Знач Организация, Знач НачалоПериода, Знач КонецПериода, Знач Отбор)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(КонецПериода));
	Запрос.УстановитьПараметр("ГраницаПросроченной", КонецДня(Запрос.Параметры.НачалоПериода - 1));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СводныеПоказатели.Организация КАК Организация,
	|	СводныеПоказатели.Контрагент КАК Контрагент,
	|	СводныеПоказатели.Договор КАК Договор,
	|	СводныеПоказатели.ВидРасчетов КАК ВидРасчетов,
	|	ВЫБОР
	|		КОГДА СводныеПоказатели.ВидРасчетов = ЗНАЧЕНИЕ(Перечисление.ВидыРасчетовПоЗаймам.Проценты)
	|			ТОГДА 1
	|		КОГДА СводныеПоказатели.ВидРасчетов = ЗНАЧЕНИЕ(Перечисление.ВидыРасчетовПоЗаймам.ОсновнойДолг)
	|			ТОГДА 2
	|		КОГДА СводныеПоказатели.ВидРасчетов = ЗНАЧЕНИЕ(Перечисление.ВидыРасчетовПоЗаймам.ПениНаПроценты)
	|			ТОГДА 3
	|		КОГДА СводныеПоказатели.ВидРасчетов = ЗНАЧЕНИЕ(Перечисление.ВидыРасчетовПоЗаймам.ПениНаОсновнойДолг)
	|			ТОГДА 4
	|		КОГДА СводныеПоказатели.ВидРасчетов = ЗНАЧЕНИЕ(Перечисление.ВидыРасчетовПоЗаймам.Штрафы)
	|			ТОГДА 5
	|		ИНАЧЕ 9
	|	КОНЕЦ КАК ВидРасчетовСортировка,
	|	СводныеПоказатели.Валюта КАК Валюта,
	|	СводныеПоказатели.ИФО КАК ИФО,
	|	СводныеПоказатели.КФО КАК КФО,
	|	СводныеПоказатели.КПС КАК КПС,
	|	СводныеПоказатели.СчетРасчетов КАК СчетРасчетов,
	|	СводныеПоказатели.СрокИсполнения КАК СрокИсполнения,
	|	СУММА(СводныеПоказатели.СуммаПросроченныеПлатежиПоставщикамКредиторам) КАК СуммаПросроченныеПлатежиПоставщикамКредиторам,
	|	СУММА(СводныеПоказатели.СуммаПросроченныеОбязательстваПоставщиков) КАК СуммаПросроченныеОбязательстваПоставщиков,
	|	СУММА(СводныеПоказатели.СуммаПросроченныеПлатежиОтПокупателейДебиторов) КАК СуммаПросроченныеПлатежиОтПокупателейДебиторов,
	|	СУММА(СводныеПоказатели.СуммаПросроченныеОбязательстваПоДоговорамСПокупателями) КАК СуммаПросроченныеОбязательстваПоДоговорамСПокупателями,
	|	СУММА(СводныеПоказатели.СуммаНеисполненныеПлатежиПоставщикамКредиторам) КАК СуммаНеисполненныеПлатежиПоставщикамКредиторам,
	|	СУММА(СводныеПоказатели.СуммаНеисполненныеОбязательстваПоставщиков) КАК СуммаНеисполненныеОбязательстваПоставщиков,
	|	СУММА(СводныеПоказатели.СуммаНеисполненныеПлатежиОтПокупателейДебиторов) КАК СуммаНеисполненныеПлатежиОтПокупателейДебиторов,
	|	СУММА(СводныеПоказатели.СуммаНеисполненныеОбязательстваПоДоговорамСПокупателями) КАК СуммаНеисполненныеОбязательстваПоДоговорамСПокупателями,
	|	СУММА(СводныеПоказатели.СуммаПросроченныеПлатежиПоставщикамКредиторам + СводныеПоказатели.СуммаНеисполненныеПлатежиПоставщикамКредиторам) КАК ВсегоЗапланированоПлатежиПоставщикамКредиторам,
	|	СУММА(СводныеПоказатели.СуммаПросроченныеОбязательстваПоставщиков + СводныеПоказатели.СуммаНеисполненныеОбязательстваПоставщиков) КАК ВсегоЗапланированоОбязательстваПоставщиков,
	|	СУММА(СводныеПоказатели.СуммаПросроченныеПлатежиОтПокупателейДебиторов + СводныеПоказатели.СуммаНеисполненныеПлатежиОтПокупателейДебиторов) КАК ВсегоЗапланированоПлатежиОтПокупателейДебиторов,
	|	СУММА(СводныеПоказатели.СуммаПросроченныеОбязательстваПоДоговорамСПокупателями + СводныеПоказатели.СуммаНеисполненныеОбязательстваПоДоговорамСПокупателями) КАК ВсегоЗапланированоОбязательстваПоДоговорамСПокупателями
	|ИЗ
	|	(ВЫБРАТЬ
	|		ОплатаПоставщикамКредиторам.Организация КАК Организация,
	|		ОплатаПоставщикамКредиторам.Контрагент КАК Контрагент,
	|		ОплатаПоставщикамКредиторам.Договор КАК Договор,
	|		ОплатаПоставщикамКредиторам.ВидРасчетов КАК ВидРасчетов,
	|		ОплатаПоставщикамКредиторам.Валюта КАК Валюта,
	|		ОплатаПоставщикамКредиторам.ИФО КАК ИФО,
	|		ОплатаПоставщикамКредиторам.КФО КАК КФО,
	|		ОплатаПоставщикамКредиторам.КПС КАК КПС,
	|		ОплатаПоставщикамКредиторам.СчетРасчетов КАК СчетРасчетов,
	|		ОплатаПоставщикамКредиторам.ОплатитьДо КАК СрокИсполнения,
