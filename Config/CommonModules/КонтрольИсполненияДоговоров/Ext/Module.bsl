Процедура НарисоватьГруппуПланированиеИКонтроль(ГруппаЭлементов, ФормаДокумента, ДокументОбъект)
	
	МетаданныеДокумента = ДокументОбъект.Метаданные();
	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Любой));
	
	// Добавляемые реквизиты формы.
	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ИтогЗапланированоПлатежей", ОписаниеТипаСуммы));
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ИтогПланЗакупокРеализации", ОписаниеТипаСуммы));
	ФормаДокумента.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	// Отображение группы.
	ГруппаЭлементов.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
