Процедура ОчиститьДвиженияРегистровПодсистемы(ДокументОбъект) Экспорт
	
	Если ДокументОбъект.ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	
	МетаданныеДокумента = ДокументОбъект.Метаданные();
	
	РегистрыПодсистемы = Новый Массив;
	РегистрыПодсистемы.Добавить("ОплатаПоставщикамКредиторам");
	РегистрыПодсистемы.Добавить("ОплатаОтПокупателейДебиторов");
	РегистрыПодсистемы.Добавить("ИсполнениеОбязательствПоставщиками");
	РегистрыПодсистемы.Добавить("ИсполнениеДоговоровСПокупателями");
	
	УстановитьПривилегированныйРежим(Истина);
	
	Для Каждого ИмяРегистра Из РегистрыПодсистемы Цикл
		
		Если МетаданныеДокумента.Движения.Содержит(Метаданные.РегистрыНакопления[ИмяРегистра]) Тогда
			Движения = ДокументОбъект.Движения[ИмяРегистра];
			Движения.Прочитать();
			Движения.Очистить();
			Движения.Записать(); // Записываем, чтобы не влияли на запросы по остаткам при проведении.
		КонецЕсли;
		
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура ЗаполнитьДатуИзмененияГрафиков(НаборЗаписей) Экспорт
	
	ДатаИзмененияГрафиков = Дата(1, 1, 1);
	Если НаборЗаписей.Количество() > 0 И НаборЗаписей.Отбор.Количество() > 0 Тогда
		ОтборПоРегистратору = НаборЗаписей.Отбор.Найти("Регистратор");
		Если ОтборПоРегистратору.ВидСравнения = ВидСравнения.Равно И ЗначениеЗаполнено(ОтборПоРегистратору.Значение) Тогда
			ДатаИзмененияГрафиков = ОтборПоРегистратору.Значение.Дата;
			Для Каждого Запись Из НаборЗаписей Цикл
				Если Запись.ВидДвижения = ВидДвиженияНакопления.Приход // Только для плановых данных: Оплата (план), Исполнение (план).
					И Не ЗначениеЗаполнено(Запись.ДатаИзмененияГрафиков) Тогда
					Запись.ДатаИзмененияГрафиков = ДатаИзмененияГрафиков;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОтразитьОплату(ДокументОбъект, ТаблицаОплатаПоставщикамКредиторам = Неопределено, ТаблицаОплатаОтПокупателейДебиторов = Неопределено) Экспорт
	
	Если ДокументОбъект.ЭтоНовый() Тогда
		Возврат; // Просмотр проводок в новом документе.
	КонецЕсли;
	
	МетаданныеДокумента = ДокументОбъект.Метаданные();
	
	ЕстьОплатаПоставщикамКредиторам = МетаданныеДокумента.Движения.Содержит(Метаданные.РегистрыНакопления.ОплатаПоставщикамКредиторам);
	ЕстьОплатаОтПокупателейДебиторов = МетаданныеДокумента.Движения.Содержит(Метаданные.РегистрыНакопления.ОплатаОтПокупателейДебиторов);
	Если НЕ (ЕстьОплатаПоставщикамКредиторам ИЛИ ЕстьОплатаОтПокупателейДебиторов) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЕстьОплатаПоставщикамКредиторам И ТаблицаОплатаПоставщикамКредиторам <> Неопределено Тогда
		
		ОплатаПоставщикамКредиторам = ДокументОбъект.Движения.ОплатаПоставщикамКредиторам;
		ОплатаПоставщикамКредиторам.Записывать = Истина;
		
		Для Каждого СтрокаОплаты Из ТаблицаОплатаПоставщикамКредиторам Цикл
			
			Если СтрокаОплаты.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком
			 ИЛИ СтрокаОплаты.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ПолученныйКредит
			 ИЛИ СтрокаОплаты.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ВыпускЦенныхБумаг
			 ИЛИ СтрокаОплаты.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии Тогда
				
				Движение = ОплатаПоставщикамКредиторам.Добавить();
				Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
				Движение.Период      = УчетРасчетов.ПериодПолученияОстатков(ДокументОбъект, "Дата");
				Движение.Организация = ДокументОбъект.Организация;
				ЗаполнитьЗначенияСвойств(Движение, СтрокаОплаты,
					"ИФО,КФО,КПС,КЭК,Контрагент,Договор,Валюта,СчетРасчетов,ВидРасчетов,ДопКлассификация,КодМероприятия,КодЦели,ОплатитьДо");
				
				Движение.Сумма = СтрокаОплаты.Сумма;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЕстьОплатаОтПокупателейДебиторов И ТаблицаОплатаОтПокупателейДебиторов <> Неопределено Тогда
		
		ОплатаОтПокупателейДебиторов = ДокументОбъект.Движения.ОплатаОтПокупателейДебиторов;
		ОплатаОтПокупателейДебиторов.Записывать = Истина;
		
		Для Каждого СтрокаОплаты Из ТаблицаОплатаОтПокупателейДебиторов Цикл
			
			Если СтрокаОплаты.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем
			 ИЛИ СтрокаОплаты.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СОтправителемТрансферта
			 ИЛИ СтрокаОплаты.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ПредоставленныйКредит Тогда
				
				Движение = ДокументОбъект.Движения.ОплатаОтПокупателейДебиторов.Добавить();
				Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
				Движение.Период      = УчетРасчетов.ПериодПолученияОстатков(ДокументОбъект, "Дата");
				Движение.Организация = ДокументОбъект.Организация;
				ЗаполнитьЗначенияСвойств(Движение, СтрокаОплаты,
					"ИФО,КФО,КПС,КЭК,Контрагент,Договор,Валюта,СчетРасчетов,ВидРасчетов,ДопКлассификация,КодМероприятия,КодЦели,ОплатитьДо");
				
				Движение.Сумма = СтрокаОплаты.Сумма;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОтразитьИсполнениеДоговоров(ДокументОбъект, ТаблицаИсполнениеОбязательствПоставщиками = Неопределено, ТаблицаИсполнениеДоговоровСПокупателями = Неопределено) Экспорт
	
	// Требуется дополнительное свойство при формировании проводок для предварительного просмотра.
	// Сейчас нельзя этого понять. Предварительный просмотр выполняется с записью объекта, но с откатом транзакции записи после формирования проводок.
	//Если ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДокументОбъект.ДополнительныеСвойства, "ЭтоНовый", Ложь) Тогда
	//	Возврат; // Просмотр проводок в новом документе.
	//КонецЕсли;
	
	МетаданныеДокумента = ДокументОбъект.Метаданные();
	
	ЕстьИсполнениеОбязательствПоставщиками = МетаданныеДокумента.Движения.Содержит(Метаданные.РегистрыНакопления.ИсполнениеОбязательствПоставщиками);
	ЕстьИсполнениеДоговоровСПокупателями   = МетаданныеДокумента.Движения.Содержит(Метаданные.РегистрыНакопления.ИсполнениеДоговоровСПокупателями);
	Если НЕ (ЕстьИсполнениеОбязательствПоставщиками ИЛИ ЕстьИсполнениеДоговоровСПокупателями) Тогда
		Возврат;
	КонецЕсли;
	
	Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ЭтоКорректировка", МетаданныеДокумента) И ДокументОбъект.ЭтоКорректировка Тогда
		КорректируемыеДвижения = ДвиженияКорректируемогоДокумента(ДокументОбъект.ДокументОснование);
	Иначе
		КорректируемыеДвижения = Неопределено;
	КонецЕсли;
	
	Если ЕстьИсполнениеОбязательствПоставщиками И ТаблицаИсполнениеОбязательствПоставщиками <> Неопределено Тогда
	
		ИсполнениеОбязательствПоставщиками = ДокументОбъект.Движения.ИсполнениеОбязательствПоставщиками;
		ИсполнениеОбязательствПоставщиками.Записывать = Истина;
		
		Если КорректируемыеДвижения <> Неопределено Тогда
			Для Каждого Движение Из КорректируемыеДвижения.ИсполнениеОбязательствПоставщиками Цикл
				НовоеДвижение = ИсполнениеОбязательствПоставщиками.Добавить();
				ЗаполнитьЗначенияСвойств(НовоеДвижение, Движение);
				НовоеДвижение.Период = ДокументОбъект.Дата;
			КонецЦикла;
		КонецЕсли;
		
		Для Каждого СтрокаИсполнения Из ТаблицаИсполнениеОбязательствПоставщиками Цикл
			
			Если СтрокаИсполнения.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком
				ИЛИ СтрокаИсполнения.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии
				ИЛИ СтрокаИсполнения.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ПолученныйКредит
				ИЛИ СтрокаИсполнения.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ВыпускЦенныхБумаг Тогда
				
				Движение = ИсполнениеОбязательствПоставщиками.Добавить();
				Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
				Движение.Период      = ДокументОбъект.Дата;
				Движение.Организация = ДокументОбъект.Организация;
				ЗаполнитьЗначенияСвойств(Движение, СтрокаИсполнения,
					"ИФО,КФО,КПС,КЭК,Контрагент,Договор,Валюта,СчетРасчетов,ИсполнитьДо");
				
				Движение.Сумма = СтрокаИсполнения.Сумма;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЕстьИсполнениеДоговоровСПокупателями И ТаблицаИсполнениеДоговоровСПокупателями <> Неопределено Тогда
	
		ИсполнениеДоговоровСПокупателями = ДокументОбъект.Движения.ИсполнениеДоговоровСПокупателями;
		ИсполнениеДоговоровСПокупателями.Записывать = Истина;
		
		Если КорректируемыеДвижения <> Неопределено Тогда
			Для Каждого Движение Из КорректируемыеДвижения.ИсполнениеДоговоровСПокупателями Цикл
				НовоеДвижение = ИсполнениеДоговоровСПокупателями.Добавить();
				ЗаполнитьЗначенияСвойств(НовоеДвижение, Движение);
				НовоеДвижение.Период = ДокументОбъект.Дата;
			КонецЦикла; 
		КонецЕсли;
		
		Для Каждого СтрокаИсполнения Из ТаблицаИсполнениеДоговоровСПокупателями Цикл
			
			Если СтрокаИсполнения.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем
			 ИЛИ СтрокаИсполнения.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СОтправителемТрансферта
			 ИЛИ СтрокаИсполнения.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ПредоставленныйКредит Тогда
				
				Движение = ИсполнениеДоговоровСПокупателями.Добавить();
				Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
				Движение.Период      = ДокументОбъект.Дата;
				Движение.Организация = ДокументОбъект.Организация;
				ЗаполнитьЗначенияСвойств(Движение, СтрокаИсполнения,
					"ИФО,КФО,КПС,КЭК,Контрагент,Договор,Валюта,СчетРасчетов,ИсполнитьДо");
				
				Движение.Сумма = СтрокаИсполнения.Сумма;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗапланироватьОплатуПоФактуПоступленияРеализации(ДокументОбъект, ТаблицаПланОплатПоФактуПоступленияРеализации) Экспорт
	
	Если ДокументОбъект.ЭтоНовый() Тогда
		Возврат; // Просмотр проводок в новом документе.
	КонецЕсли;
	
	МетаданныеДокумента = ДокументОбъект.Метаданные();
	
	ЕстьОплатаПоставщикамКредиторам = МетаданныеДокумента.Движения.Содержит(Метаданные.РегистрыНакопления.ОплатаПоставщикамКредиторам);
	ЕстьОплатаОтПокупателейДебиторов = МетаданныеДокумента.Движения.Содержит(Метаданные.РегистрыНакопления.ОплатаОтПокупателейДебиторов);
	Если НЕ (ЕстьОплатаПоставщикамКредиторам ИЛИ ЕстьОплатаОтПокупателейДебиторов) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЕстьОплатаПоставщикамКредиторам Тогда
		
		ОплатаПоставщикамКредиторам = ДокументОбъект.Движения.ОплатаПоставщикамКредиторам;
		ОплатаПоставщикамКредиторам.Записывать = Истина;
		
		Для Каждого СтрокаОплаты Из ТаблицаПланОплатПоФактуПоступленияРеализации Цикл
			
			Если СтрокаОплаты.ЭтоДоходы Тогда
				Продолжить;
			КонецЕсли;
			
			Движение = ОплатаПоставщикамКредиторам.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
			Движение.Организация = ДокументОбъект.Организация;
			ЗаполнитьЗначенияСвойств(Движение, СтрокаОплаты,
				"ИФО,КФО,КПС,КЭК,Контрагент,Договор,Валюта,СчетРасчетов,ВидРасчетов,ДопКлассификация,КодМероприятия,КодЦели,ОплатитьДо");
			Движение.Период = СтрокаОплаты.ОплатитьДо;
			
			Движение.Сумма = СтрокаОплаты.Сумма;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЕстьОплатаОтПокупателейДебиторов Тогда
		
		ОплатаОтПокупателейДебиторов = ДокументОбъект.Движения.ОплатаОтПокупателейДебиторов;
		ОплатаОтПокупателейДебиторов.Записывать = Истина;
		
		Для Каждого СтрокаОплаты Из ТаблицаПланОплатПоФактуПоступленияРеализации Цикл
			
			Если Не СтрокаОплаты.ЭтоДоходы Тогда
				Продолжить;
			КонецЕсли;
			
			Движение = ДокументОбъект.Движения.ОплатаОтПокупателейДебиторов.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
			Движение.Организация = ДокументОбъект.Организация;
			ЗаполнитьЗначенияСвойств(Движение, СтрокаОплаты,
				"ИФО,КФО,КПС,КЭК,Контрагент,Договор,Валюта,СчетРасчетов,ВидРасчетов,ДопКлассификация,КодМероприятия,КодЦели,ОплатитьДо");
			Движение.Период = СтрокаОплаты.ОплатитьДо;
			
			Движение.Сумма = СтрокаОплаты.Сумма;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОтразитьДатуИсполненияПоСредствамВоВременномРаспоряжении(ДокументОбъект, ТаблицаДатаИсполненияПриПоступленииСредствВР, ТаблицаДатаИсполненияПриПеречисленииСредствВР) Экспорт
	
	Если ДокументОбъект.ЭтоНовый() Тогда
		Возврат; // Просмотр проводок в новом документе.
	КонецЕсли;
	
	МетаданныеДокумента = ДокументОбъект.Метаданные();
	
	ОплатаПоставщикамКредиторам = ДокументОбъект.Движения.ОплатаПоставщикамКредиторам;
	ОплатаПоставщикамКредиторам.Записывать = Истина;
	
	Для Каждого СтрокаОплаты Из ТаблицаДатаИсполненияПриПоступленииСредствВР Цикл
		
		Движение = ОплатаПоставщикамКредиторам.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход; // План оплаты.
		Движение.Организация = ДокументОбъект.Организация;
		ЗаполнитьЗначенияСвойств(Движение, СтрокаОплаты,
			"ИФО,КФО,КПС,КЭК,Контрагент,Договор,Валюта,СчетРасчетов,ВидРасчетов,ДопКлассификация,КодМероприятия,КодЦели,ОплатитьДо");
		Движение.Период = СтрокаОплаты.ОплатитьДо;
		
		Движение.Сумма = СтрокаОплаты.Сумма;
		
	КонецЦикла;
	
	Для Каждого СтрокаОплаты Из ТаблицаДатаИсполненияПриПеречисленииСредствВР Цикл
		
		Движение = ОплатаПоставщикамКредиторам.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход; // Факт оплаты.
		Движение.Организация = ДокументОбъект.Организация;
		ЗаполнитьЗначенияСвойств(Движение, СтрокаОплаты,
			"ИФО,КФО,КПС,КЭК,Контрагент,Договор,Валюта,СчетРасчетов,ВидРасчетов,ДопКлассификация,КодМероприятия,КодЦели,ОплатитьДо");
		Движение.Период = УчетРасчетов.ПериодПолученияОстатков(ДокументОбъект, "Дата");
		
		Движение.Сумма = СтрокаОплаты.Сумма;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработатьПодборПлатежейПоГрафику(ДокументОбъект, АдресВыбранныхПлатежейВХранилище) Экспорт
	
	МетаданныеДокумента = ДокументОбъект.Метаданные();
	
	ЕстьДетализацияПлатежа = ОбщегоНазначенияБГУ.ЕстьТабЧастьДокумента("ДетализацияПлатежа", МетаданныеДокумента);
	ЕстьРасшифровкаПлатежа = ОбщегоНазначенияБГУ.ЕстьТабЧастьДокумента("РасшифровкаПлатежа", МетаданныеДокумента);
	ЕстьВалютаДокумента    = ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ВалютаДокумента", МетаданныеДокумента);
	ЕстьКорСчет            = ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("КорСчет", МетаданныеДокумента);
	
	ВалютаРубли = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета();
	ВалютаДокумента = ?(ЕстьВалютаДокумента, ДокументОбъект.ВалютаДокумента, ВалютаРубли);
	
	Если ВалютаДокумента <> ВалютаРубли Тогда
		КоэффициентРуб = ДокументОбъект.Курс / ?(ДокументОбъект.Кратность=0, 1, ДокументОбъект.Кратность);
	Иначе
		КоэффициентРуб = 1;
	КонецЕсли;
	
	ТаблицаВыбранныхПлатежей = ПолучитьИзВременногоХранилища(АдресВыбранныхПлатежейВХранилище);
	
	Если ЕстьРасшифровкаПлатежа И ЕстьДетализацияПлатежа Тогда // это РСКП
		
		ЕстьКолонкаСуммаВал = ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("СуммаВал", МетаданныеДокумента, "РасшифровкаПлатежа");
		ЕстьКолонкаДоговор  = ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("Договор", МетаданныеДокумента, "РасшифровкаПлатежа");
		
		ЕстьКолонкаКонтрагент = ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("Контрагент", МетаданныеДокумента, "РасшифровкаПлатежа");
		ЕстьРеквизитКонтрагент = ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("Контрагент", МетаданныеДокумента); 
		
		ПлатежиПоКБК = ТаблицаВыбранныхПлатежей.Скопировать();
		ПлатежиПоКБК.Свернуть("КФО,КПС,КодЦели", "Сумма");
		
		Если ДокументОбъект.РасшифровкаПлатежа.Количество() = 1 
			И НЕ ЗначениеЗаполнено(ДокументОбъект.РасшифровкаПлатежа[0].СуммаВал) Тогда 
			ДокументОбъект.РасшифровкаПлатежа.Очистить(); 
			ДокументОбъект.ДетализацияПлатежа.Очистить();
		КонецЕсли;	
		
		Для Каждого ПлатежПоБК Из ПлатежиПоКБК Цикл
			
			СтрРасшифровка = ДокументОбъект.РасшифровкаПлатежа.Добавить(); 
			СтрРасшифровка.ИдентификаторСтроки = Новый УникальныйИдентификатор; 
			СтрРасшифровка.КБКНазначениеПлатежа = ПлатежПоБК.КПС;
			СтрРасшифровка.КодЦели = ПлатежПоБК.КодЦели;
			СтрРасшифровка.РазделЛС = ПлатежноРасчетныеДокументы.РазделЛСПоКодуПоступленияИлиКФО(ДокументОбъект.ЛицевойСчет, ДокументОбъект.Дата,, ПлатежПоБК.КФО); 
			СтрРасшифровка.СуммаВал = ПлатежПоБК.Сумма; 
			
			СтрокиДетализации = ТаблицаВыбранныхПлатежей.НайтиСтроки(Новый Структура("КФО, КПС, КодЦели", ПлатежПоБК.КФО, ПлатежПоБК.КПС, ПлатежПоБК.КодЦели)); 
			
			Для Каждого СтрокаДетализации Из СтрокиДетализации Цикл
				НовСтр = ДокументОбъект.ДетализацияПлатежа.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтр, СтрРасшифровка); 
				НовСтр.ОплатитьДо = СтрокаДетализации.ОплатитьДо;
				НовСтр.ВидРасчетов = СтрокаДетализации.ВидРасчетов;
				НовСтр.СчетРасчетов = СтрокаДетализации.СчетРасчетов;
				НовСтр.КОСГУНазначениеПлатежа = СтрокаДетализации.КЭК;
				НовСтр.КодМероприятия = СтрокаДетализации.КодМероприятия;
				НовСтр.ДопКлассификация = СтрокаДетализации.ДопКлассификация;
				НовСтр.СуммаВал = СтрокаДетализации.Сумма;
				НовСтр.СпособПогашенияЗадолженности = ПредопределенноеЗначение("Перечисление.СпособыПогашенияЗадолженности.Автоматически");
				Если ЕстьКорСчет И БухгалтерскийУчет.СчетВИерархии(ДокументОбъект.КорСчет, "206.00") Тогда
					// В графике платежей по договорам с поставщиками счет расчетов всегда 302.хх, приведем его к 206.хх.
					НовСтр.СчетРасчетов = УчетРасчетов.ОпределитьСчетАвансов(НовСтр.СчетРасчетов,
					ДокументОбъект.Дата, ДокументОбъект.Организация);
				КонецЕсли;
				НовСтр.Контрагент = ДокументОбъект.Контрагенты[0].Контрагент;
			КонецЦикла;	      
		КонецЦикла;	                     
		
		ДокументОбъект.НесколькоКодовБК = ?(ДокументОбъект.РасшифровкаПлатежа.Количество() > 1, 1, 0); 
		ДокументОбъект.СуммаДокументаВВалюте = ДокументОбъект.РасшифровкаПлатежа.Итог("СуммаВал");
		
	ИначеЕсли ЕстьРасшифровкаПлатежа Тогда
		
		ЕстьКолонкаСуммаВал = ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("СуммаВал", МетаданныеДокумента, "РасшифровкаПлатежа");
		ЕстьКолонкаДоговор  = ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("Договор", МетаданныеДокумента, "РасшифровкаПлатежа");
		
		ЕстьКолонкаКонтрагент = ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("Контрагент", МетаданныеДокумента, "РасшифровкаПлатежа");
		ЕстьРеквизитКонтрагент = ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("Контрагент", МетаданныеДокумента);
		
		Для Каждого Платеж Из ТаблицаВыбранныхПлатежей Цикл
			
			НоваяСтрока = ДокументОбъект.РасшифровкаПлатежа.Добавить();
			
			НоваяСтрока.СпособПогашенияЗадолженности = Перечисления.СпособыПогашенияЗадолженности.Автоматически;
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Платеж,
				"КФО,СчетРасчетов,КодЦели,КодМероприятия,ДопКлассификация,ВидРасчетов,ОплатитьДо");
			
			Если ЕстьКорСчет И БухгалтерскийУчет.СчетВИерархии(ДокументОбъект.КорСчет, "206.00") Тогда
				// В графике платежей по договорам с поставщиками счет расчетов всегда 302.хх, приведем его к 206.хх.
				НоваяСтрока.СчетРасчетов = УчетРасчетов.ОпределитьСчетАвансов(НоваяСтрока.СчетРасчетов,
					ДокументОбъект.Дата, ДокументОбъект.Организация);
			КонецЕсли;
			
			Если ЕстьКолонкаКонтрагент И ЕстьРеквизитКонтрагент Тогда
				НоваяСтрока.Контрагент = ДокументОбъект.Контрагент;
			КонецЕсли;
			Если ЕстьКолонкаДоговор Тогда
				НоваяСтрока.Договор = Платеж.Договор;
			КонецЕсли;
			
			Если МетаданныеДокумента.Имя = "КассовоеПоступление"
			 ИЛИ МетаданныеДокумента.Имя = "КассовоеВыбытие"
			 ИЛИ МетаданныеДокумента.Имя = "ЗаявкаНаКассовыйРасход"
			 ИЛИ МетаданныеДокумента.Имя = "ПлатежноеПоручение" Тогда
				
				НоваяСтрока.КБКНазначениеПлатежа   = Платеж.КПС;
				НоваяСтрока.КОСГУНазначениеПлатежа = Платеж.КЭК;
				
				ДопустимыеИсточникиСредств = ПлатежноРасчетныеДокументыПовтИсп.ДопустимыеИсточникиСредств(
					ДокументОбъект.ЛицевойСчет, НоваяСтрока.КФО);
				Если ДопустимыеИсточникиСредств.Количество() > 0 Тогда
					НоваяСтрока.ИсточникСредств = ДопустимыеИсточникиСредств[0];
				КонецЕсли;
				
			ИначеЕсли МетаданныеДокумента.Имя = "ПриходныйКассовыйОрдер"
				ИЛИ МетаданныеДокумента.Имя = "РасходныйКассовыйОрдер" Тогда
				
				НоваяСтрока.КПС = Платеж.КПС;
				НоваяСтрока.КЭК = Платеж.КЭК;
				
			КонецЕсли;
			
			СуммаВал = ?(Платеж.Сумма < 0, (-1) * Платеж.Сумма, Платеж.Сумма);
			
			Если ВалютаДокумента <> ВалютаРубли Тогда
				
				Если ЕстьКолонкаСуммаВал Тогда
					НоваяСтрока.СуммаВал = СуммаВал;
					НоваяСтрока.Сумма    = НоваяСтрока.СуммаВал * КоэффициентРуб;
				Иначе
					НоваяСтрока.Сумма = СуммаВал;
				КонецЕсли;
				
			Иначе
				
				НоваяСтрока.Сумма = СуммаВал;
				Если ЕстьКолонкаСуммаВал Тогда
					НоваяСтрока.СуммаВал = НоваяСтрока.Сумма;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе // Документы оплаты без табличной части "Расшифровка платежа".
		
		Если ТаблицаВыбранныхПлатежей.Количество() > 0 Тогда
			
			Платеж = ТаблицаВыбранныхПлатежей[0]; // Должен быть ровно 1 выбранный платеж, но если несколько, берем только первый.
			
			ДокументОбъект.СпособПогашенияЗадолженности = Перечисления.СпособыПогашенияЗадолженности.Автоматически;
			
			ЗаполнитьЗначенияСвойств(ДокументОбъект, Платеж,
				"КФО,СчетРасчетов,КодЦели,КодМероприятия,ДопКлассификация,ВидРасчетов,ОплатитьДо");
			
			Если ЕстьКорСчет И БухгалтерскийУчет.СчетВИерархии(ДокументОбъект.КорСчет, "206.00") Тогда
				// В графике платежей по договорам с поставщиками счет расчетов всегда 302.хх, приведем его к 206.хх.
				ДокументОбъект.СчетРасчетов = УчетРасчетов.ОпределитьСчетАвансов(ДокументОбъект.СчетРасчетов,
					ДокументОбъект.Дата, ДокументОбъект.Организация);
			КонецЕсли;
			
			ДокументОбъект.КБКНазначениеПлатежа   = Платеж.КПС;
			ДокументОбъект.КОСГУНазначениеПлатежа = Платеж.КЭК;
			
			ДопустимыеИсточникиСредств = ПлатежноРасчетныеДокументыПовтИсп.ДопустимыеИсточникиСредств(
				ДокументОбъект.ЛицевойСчет, ДокументОбъект.КФО);
			Если ДопустимыеИсточникиСредств.Количество() > 0 Тогда
				ДокументОбъект.ИсточникСредств = ДопустимыеИсточникиСредств[0];
			КонецЕсли;
			
			СуммаВал = ?(Платеж.Сумма < 0, (-1) * Платеж.Сумма, Платеж.Сумма);
			
			ДокументОбъект.СуммаДокумента = СуммаВал;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновитьГруппуКонтрольИсполнения(ФормаДокумента, ДокументОбъект, ИмяГруппы = "ГруппаКонтрольИсполнения") Экспорт
	
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров") Тогда
		Возврат;
	КонецЕсли;
	
	МетаданныеДокумента = ДокументОбъект.Метаданные();
	
	ЕстьДоговорВШапке = Ложь;
	Договор = Справочники.Договоры.ПустаяСсылка();
	Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("Договор", МетаданныеДокумента)
		И ТипЗнч(ДокументОбъект.Договор) = Тип("СправочникСсылка.Договоры") Тогда
		ЕстьДоговорВШапке = Истина;
		Договор = ДокументОбъект.Договор;
	ИначеЕсли ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ДоговорКонтрагента", МетаданныеДокумента)
		И ТипЗнч(ДокументОбъект.ДоговорКонтрагента) = Тип("СправочникСсылка.Договоры") Тогда
		ЕстьДоговорВШапке = Истина;
		Договор = ДокументОбъект.ДоговорКонтрагента;
	КонецЕсли;
	
	РеквизитыДоговора = Неопределено;
	ВестиГрафикПлатежей = Ложь;
	ВестиПланГрафикИсполнения = Ложь;
	Если ЗначениеЗаполнено(Договор) Тогда
		
		РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, "ВидДоговора,ВестиГрафикПлатежей,ВестиПланГрафикИсполнения");
		ВестиГрафикПлатежей = ?(РеквизитыДоговора.ВестиГрафикПлатежей = Неопределено, Ложь, РеквизитыДоговора.ВестиГрафикПлатежей);
		ВестиПланГрафикИсполнения = ?(РеквизитыДоговора.ВестиПланГрафикИсполнения = Неопределено, Ложь, РеквизитыДоговора.ВестиПланГрафикИсполнения);
		
	ИначеЕсли ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("Контрагент", МетаданныеДокумента)
		И ТипЗнч(ДокументОбъект.Контрагент) = Тип("СправочникСсылка.Контрагенты")
		И ЗначениеЗаполнено(ДокументОбъект.Контрагент)
		И НЕ ЕстьДоговорВШапке Тогда
		
		// Для документов с договорами в табличной части будем показывать группу "Планирование и контроль",
		// если хотя бы по одному договору ведутся графики.
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	МАКСИМУМ(Договоры.ВестиГрафикПлатежей) КАК ВестиГрафикПлатежей,
		|	МАКСИМУМ(Договоры.ВестиПланГрафикИсполнения) КАК ВестиПланГрафикИсполнения
		|ИЗ
		|	Справочник.Договоры КАК Договоры
		|ГДЕ
		|	Договоры.Организация = &Организация
		|	И Договоры.Контрагент = &Контрагент
		|	И НЕ Договоры.ПометкаУдаления";
		Запрос.УстановитьПараметр("Организация", ДокументОбъект.Организация);
		Запрос.УстановитьПараметр("Контрагент",  ДокументОбъект.Контрагент);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ВестиГрафикПлатежей       = ?(Выборка.ВестиГрафикПлатежей = NULL,       Ложь, Выборка.ВестиГрафикПлатежей);
			ВестиПланГрафикИсполнения = ?(Выборка.ВестиПланГрафикИсполнения = NULL, Ложь, Выборка.ВестиПланГрафикИсполнения);
		КонецЕсли;
		
	КонецЕсли;
	
	ПоказыватьГруппуКонтрольИсполнения = (ВестиГрафикПлатежей ИЛИ ВестиПланГрафикИсполнения)
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ФормаДокумента.Элементы, ИмяГруппы);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ФормаДокумента.Элементы,
		ИмяГруппы, "Видимость", ПоказыватьГруппуКонтрольИсполнения);
	
	Если ПоказыватьГруппуКонтрольИсполнения Тогда
		
		Если ФормаДокумента.Элементы[ИмяГруппы].ПодчиненныеЭлементы.Количество() = 0 Тогда
			НарисоватьГруппуКонтрольИсполнения(ФормаДокумента.Элементы[ИмяГруппы], ФормаДокумента, ДокументОбъект);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновитьГруппуПланированиеИКонтроль(ФормаДокумента, ДокументОбъект, ИмяГруппы = "ГруппаПланированиеИКонтроль") Экспорт
	
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров") Тогда
		Возврат;
	КонецЕсли;
	
	МетаданныеДокумента = ДокументОбъект.Метаданные();
	
	ЕстьДоговорВШапке = Ложь;
	Договор = Справочники.Договоры.ПустаяСсылка();
	Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("Договор", МетаданныеДокумента)
		И ТипЗнч(ДокументОбъект.Договор) = Тип("СправочникСсылка.Договоры") Тогда
		ЕстьДоговорВШапке = Истина;
		Договор = ДокументОбъект.Договор;
	ИначеЕсли ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ДоговорКонтрагента", МетаданныеДокумента)
		И ТипЗнч(ДокументОбъект.ДоговорКонтрагента) = Тип("СправочникСсылка.Договоры") Тогда
		ЕстьДоговорВШапке = Истина;
		Договор = ДокументОбъект.ДоговорКонтрагента;
	КонецЕсли;
	
	РеквизитыДоговора = Неопределено;
	ВестиГрафикПлатежей = Ложь;
	ВестиПланГрафикИсполнения = Ложь;
	Если ЗначениеЗаполнено(Договор) Тогда
		
		РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, "ВидДоговора,ВестиГрафикПлатежей,ВестиПланГрафикИсполнения");
		ВестиГрафикПлатежей = ?(РеквизитыДоговора.ВестиГрафикПлатежей = Неопределено, Ложь, РеквизитыДоговора.ВестиГрафикПлатежей);
		ВестиПланГрафикИсполнения = ?(РеквизитыДоговора.ВестиПланГрафикИсполнения = Неопределено, Ложь, РеквизитыДоговора.ВестиПланГрафикИсполнения);
		
	ИначеЕсли ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("Контрагент", МетаданныеДокумента)
		И ТипЗнч(ДокументОбъект.Контрагент) = Тип("СправочникСсылка.Контрагенты")
		И ЗначениеЗаполнено(ДокументОбъект.Контрагент)
		И НЕ ЕстьДоговорВШапке Тогда
		
		// Для документов с договорами в табличной части будем показывать группу "Планирование и контроль",
		// если хотя бы по одному договору ведутся графики.
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	МАКСИМУМ(Договоры.ВестиГрафикПлатежей) КАК ВестиГрафикПлатежей,
		|	МАКСИМУМ(Договоры.ВестиПланГрафикИсполнения) КАК ВестиПланГрафикИсполнения
		|ИЗ
		|	Справочник.Договоры КАК Договоры
		|ГДЕ
		|	Договоры.Организация = &Организация
		|	И Договоры.Контрагент = &Контрагент
		|	И НЕ Договоры.ПометкаУдаления";
		Запрос.УстановитьПараметр("Организация", ДокументОбъект.Организация);
		Запрос.УстановитьПараметр("Контрагент",  ДокументОбъект.Контрагент);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ВестиГрафикПлатежей       = ?(Выборка.ВестиГрафикПлатежей = NULL,       Ложь, Выборка.ВестиГрафикПлатежей);
			ВестиПланГрафикИсполнения = ?(Выборка.ВестиПланГрафикИсполнения = NULL, Ложь, Выборка.ВестиПланГрафикИсполнения);
		КонецЕсли;
		
	КонецЕсли;
	
	ПоказыватьГруппуПланированиеИКонтроль = (ВестиГрафикПлатежей ИЛИ ВестиПланГрафикИсполнения)
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ФормаДокумента.Элементы, ИмяГруппы);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ФормаДокумента.Элементы,
		ИмяГруппы, "Видимость", ПоказыватьГруппуПланированиеИКонтроль);
	
	Если ПоказыватьГруппуПланированиеИКонтроль Тогда
		
		Если ФормаДокумента.Элементы[ИмяГруппы].ПодчиненныеЭлементы.Количество() = 0 Тогда
			НарисоватьГруппуПланированиеИКонтроль(ФормаДокумента.Элементы[ИмяГруппы], ФормаДокумента, ДокументОбъект);
		КонецЕсли;
		
		Отбор = Новый Структура;
		Отбор.Вставить("Контрагент", ДокументОбъект.Контрагент);
		Если ЕстьДоговорВШапке И ЗначениеЗаполнено(Договор) Тогда
			Отбор.Вставить("Договор", Договор);
		КонецЕсли;
		Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО")
			И ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ИФО", МетаданныеДокумента) Тогда
			Отбор.Вставить("ИФО", ДокументОбъект.ИФО);
		КонецЕсли;
		
		// График платежей.
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ФормаДокумента.Элементы,
			"ПланированиеИКонтрольЗапланированоПлатежей", "Видимость", ВестиГрафикПлатежей);
		
		Если ВестиГрафикПлатежей Тогда
			
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ФормаДокумента.Элементы,
				"ПланированиеИКонтрольЗапланированоПлатежей", "Заголовок", НСтр("ru='Запланировано платежей'"));
			
			Если ЗначениеЗаполнено(РеквизитыДоговора)
				И РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком Тогда
				
				ИтогЗапланированоПлатежей =
					КонтрольИсполненияДоговоров.НеисполненныеПлатежиПоставщикамКредиторам(Отбор, ДокументОбъект.Организация).Итог("Сумма");
				
			ИначеЕсли ЗначениеЗаполнено(РеквизитыДоговора)
				И РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем Тогда
				
				ИтогЗапланированоПлатежей =
					КонтрольИсполненияДоговоров.НеисполненныеПлатежиОтПокупателейДебиторов(Отбор, ДокументОбъект.Организация).Итог("Сумма");
				
			Иначе
				
				ИтогЗапланированоПлатежей =
					КонтрольИсполненияДоговоров.НеисполненныеПлатежиПоставщикамКредиторам(Отбор, ДокументОбъект.Организация).Итог("Сумма")
					+ КонтрольИсполненияДоговоров.НеисполненныеПлатежиОтПокупателейДебиторов(Отбор, ДокументОбъект.Организация).Итог("Сумма");
				
			КонецЕсли;
			
			ФормаДокумента.ИтогЗапланированоПлатежей = ИтогЗапланированоПлатежей;
			
		КонецЕсли;
		
		// План-график закупок / реализации.
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ФормаДокумента.Элементы,
			"ПланированиеИКонтрольПланЗакупокРеализации", "Видимость", ВестиПланГрафикИсполнения);
		
		Если ВестиПланГрафикИсполнения Тогда
			
			Если ЗначениеЗаполнено(РеквизитыДоговора)
				И РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком Тогда
				
				ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ФормаДокумента.Элементы,
					"ПланированиеИКонтрольПланЗакупокРеализации", "Заголовок",
						?(ВестиГрафикПлатежей, НСтр("ru='план закупок'"), НСтр("ru='План закупок'")));
				
				ИтогПланЗакупокРеализации =
					КонтрольИсполненияДоговоров.НеисполненныеОбязательстваПоставщиков(Отбор, ДокументОбъект.Организация).Итог("Сумма");
				
			ИначеЕсли ЗначениеЗаполнено(РеквизитыДоговора)
				И РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем Тогда
				
				ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ФормаДокумента.Элементы,
					"ПланированиеИКонтрольПланЗакупокРеализации", "Заголовок",
						?(ВестиГрафикПлатежей, НСтр("ru='план реализации'"), НСтр("ru='План реализации'")));
				
				ИтогПланЗакупокРеализации =
					КонтрольИсполненияДоговоров.НеисполненныеДоговораСПокупателями(Отбор, ДокументОбъект.Организация).Итог("Сумма");
				
			Иначе
				
				ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ФормаДокумента.Элементы,
					"ПланированиеИКонтрольПланЗакупокРеализации", "Заголовок",
						?(ВестиГрафикПлатежей, НСтр("ru='план исполнения'"), НСтр("ru='План исполнения'")));
				
				ИтогПланЗакупокРеализации =
					КонтрольИсполненияДоговоров.НеисполненныеОбязательстваПоставщиков(Отбор, ДокументОбъект.Организация).Итог("Сумма")
					+ КонтрольИсполненияДоговоров.НеисполненныеДоговораСПокупателями(Отбор, ДокументОбъект.Организация).Итог("Сумма");
				
			КонецЕсли;
			
			ФормаДокумента.ИтогПланЗакупокРеализации = ИтогПланЗакупокРеализации;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьГрафикиИсполненияПоДоговору(ДокументОбъект, Договор, ДокументОснование, ВидГрафика = "") Экспорт
	
	МетаданныеДокумента = ДокументОбъект.Метаданные();
	
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор,
		"ВидДоговора,ВестиГрафикПлатежей,ВестиПланГрафикИсполнения");
	
	Если МетаданныеДокумента.Имя = "РегистрацияГрафиковИсполненияДоговоров" Тогда // По всем договорам, необязательно с ведением графиков.
		ВестиГрафикПлатежей = Истина;
		ВестиПланГрафикИсполнения = Истина;
	Иначе
		ВестиГрафикПлатежей = ?(РеквизитыДоговора.ВестиГрафикПлатежей = Неопределено, Ложь, РеквизитыДоговора.ВестиГрафикПлатежей);
		ВестиПланГрафикИсполнения = ?(РеквизитыДоговора.ВестиПланГрафикИсполнения = Неопределено, Ложь, РеквизитыДоговора.ВестиПланГрафикИсполнения);
	КонецЕсли;
	
	ЗаполнятьГрафикПлатежей = (ВидГрафика = "ГрафикПлатежей") ИЛИ НЕ ЗначениеЗаполнено(ВидГрафика);
	ЗаполнятьПланГрафикИсполнения = (ВидГрафика = "ПланГрафикИсполнения") ИЛИ НЕ ЗначениеЗаполнено(ВидГрафика);
	
	ИспользоватьИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО")
		И ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ИФО", МетаданныеДокумента);
	
	// Отбор плановых данных для заполнения.
	Отбор = Новый Структура("Контрагент,Договор");
	ЗаполнитьЗначенияСвойств(Отбор, ДокументОбъект);
	Если ИспользоватьИФО И ЗначениеЗаполнено(ДокументОбъект.ИФО) Тогда
		Отбор.Вставить("ИФО", ДокументОбъект.ИФО);
	КонецЕсли;
	
	// Первоначальное заполнение графика платежей актуальными данными из регистров (AS-IS).
	Если ВестиГрафикПлатежей И ЗаполнятьГрафикПлатежей Тогда
		
		ДокументОбъект.ГрафикПлатежей.Очистить(); // Первоначальное заполнение, очищаем все имеющиеся данные.
		
		НеисполненныеПлатежи = Новый ТаблицаЗначений;
		Если РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком
			ИЛИ РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ПолученныйКредит
			ИЛИ РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ВыпускЦенныхБумаг
			ИЛИ РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии Тогда
			
			НеисполненныеПлатежи = КонтрольИсполненияДоговоров.НеисполненныеПлатежиПоставщикамКредиторам(
				Отбор, ДокументОбъект.Организация);
			
		ИначеЕсли РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем
			ИЛИ РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СОтправителемТрансферта
			ИЛИ РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ПредоставленныйКредит Тогда
			
			НеисполненныеПлатежи = КонтрольИсполненияДоговоров.НеисполненныеПлатежиОтПокупателейДебиторов(
				Отбор, ДокументОбъект.Организация);
			
		КонецЕсли;
		
		Если ИспользоватьИФО
			И Не ЗначениеЗаполнено(ДокументОбъект.ИФО)
			И НеисполненныеПлатежи.Количество() > 0 Тогда
			// Определяем ИФО по первой строке графика, т.к. он должен быть единый для всего договора.
			ДокументОбъект.ИФО = НеисполненныеПлатежи[0].ИФО;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ДокументОбъект.ВалютаДокумента)
			И НеисполненныеПлатежи.Количество() > 0 Тогда
			// Определяем валюту по первой строке графика, т.к. она должна быть единой для всего договора.
			ДокументОбъект.ВалютаДокумента = НеисполненныеПлатежи[0].Валюта;
		КонецЕсли;
		
		Для Каждого НеисполненныйПлатеж Из НеисполненныеПлатежи Цикл
			
			Если НеисполненныйПлатеж.Валюта <> ДокументОбъект.ВалютаДокумента Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ДокументОбъект.ГрафикПлатежей.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, НеисполненныйПлатеж);
			
			НоваяСтрока.ЗапретИзменения = Истина;
			
			НоваяСтрока.СуммаВВалютеДоИзменений    = НеисполненныйПлатеж.Сумма;
			НоваяСтрока.СуммаВВалютеПослеИзменений = НеисполненныйПлатеж.Сумма;
			НоваяСтрока.СуммаВВалюте = 0;
			
		КонецЦикла;
		
		ДокументОбъект.ГрафикПлатежей.Сортировать("ОплатитьДо,ВидРасчетов,СчетРасчетов");
		
	КонецЕсли;
	
	// Первоначальное заполнение графика закупок (реализации) актуальными данными из регистров (AS-IS).
	Если ВестиПланГрафикИсполнения И ЗаполнятьПланГрафикИсполнения Тогда
		
		ДокументОбъект.ГрафикИсполнения.Очистить(); // Первоначальное заполнение, очищаем все имеющиеся данные.
		
		НеисполненныеОбязательства = Новый ТаблицаЗначений;
		Если РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком
			ИЛИ РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии Тогда
			
			НеисполненныеОбязательства = КонтрольИсполненияДоговоров.НеисполненныеОбязательстваПоставщиков(
				Отбор, ДокументОбъект.Организация);
			
		ИначеЕсли РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем
			ИЛИ РеквизитыДоговора.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СОтправителемТрансферта Тогда
			
			НеисполненныеОбязательства = КонтрольИсполненияДоговоров.НеисполненныеДоговораСПокупателями(
				Отбор, ДокументОбъект.Организация);
			
		КонецЕсли;
		
		Если ИспользоватьИФО
			И Не ЗначениеЗаполнено(ДокументОбъект.ИФО)
			И НеисполненныеОбязательства.Количество() > 0 Тогда
			// Определяем ИФО по первой строке графика, т.к. он должен быть единый для всего договора.
			ДокументОбъект.ИФО = НеисполненныеОбязательства[0].ИФО;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ДокументОбъект.ВалютаДокумента)
			И НеисполненныеОбязательства.Количество() > 0 Тогда
			// Определяем валюту по первой строке графика, т.к. она должна быть единой для всего договора.
			ДокументОбъект.ВалютаДокумента = НеисполненныеОбязательства[0].Валюта;
		КонецЕсли;
		
		Для Каждого НеисполненноеОбязательство Из НеисполненныеОбязательства Цикл
			
			Если НеисполненноеОбязательство.Валюта <> ДокументОбъект.ВалютаДокумента Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ДокументОбъект.ГрафикИсполнения.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, НеисполненноеОбязательство);
			
			НоваяСтрока.ЗапретИзменения = Истина;
			
			НоваяСтрока.СуммаВВалютеДоИзменений    = НеисполненноеОбязательство.Сумма;
			НоваяСтрока.СуммаВВалютеПослеИзменений = НеисполненноеОбязательство.Сумма;
			НоваяСтрока.СуммаВВалюте = 0;
			
		КонецЦикла;
		
		ДокументОбъект.ГрафикИсполнения.Сортировать("ИсполнитьДо,СчетРасчетов");
		
	КонецЕсли;
	
	// Добавим суммы в графики по данным документа-основания (TO-BE).
	// Из документов-оснований интересуют только документы оплаты (плюс, счета на оплату) и документы поступления (отгрузки),
	// т.к. из документов планирования все данные уже взяли на предыдущем этапе из регистров.
	Если ЗначениеЗаполнено(ДокументОснование)
		И НЕ ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.РегистрацияОбязательствИСведенийПоДоговорам")
		И НЕ ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.РегистрацияГрафиковИсполненияДоговоров") Тогда
		
		ЗаполанироватьОплату = Ложь;
		ЗаполанироватьПоступлениеОтгрузку = Ложь;
		Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПриходныйКассовыйОрдер")
		 ИЛИ ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.РасходныйКассовыйОрдер")
		 ИЛИ ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.КассовоеПоступление")
		 ИЛИ ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.КассовоеВыбытие")
		 ИЛИ ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПлатежноеПоручение")
		 ИЛИ ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЗаявкаНаКассовыйРасход")
		 ИЛИ ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЗаявкаНаКассовыйРасходСокращенная")
		 ИЛИ ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЗаявкаНаВозврат") Тогда
			ЗаполанироватьПоступлениеОтгрузку = Истина;
		Иначе
			ЗаполанироватьОплату = Истина;
		КонецЕсли;
		
		Если ЗаполанироватьОплату И ЗаполнятьГрафикПлатежей Тогда
			
			ПроводкиПоступлениеАктивов   = БухгалтерскийУчет.ПроводкиДокументов(ДокументОснование, "302.00", "Кт").Выгрузить();
			ПроводкиЗачетАвансовВыданных = БухгалтерскийУчет.ПроводкиДокументов(ДокументОснование, "302.00", "Дт", "206.00").Выгрузить();
			
			// Рассчитаем суммы поступлений с учетом их оплаты авансом.
			ПроводкиПоступлениеАктивов.Колонки.Добавить("ОплаченоАвансом", Новый ОписаниеТипов("Число"));
			Для Каждого ЗачетАвансовВыданных Из ПроводкиЗачетАвансовВыданных Цикл
				
				Отбор = Новый Структура("Организация,ИФО,КФО");
				ЗаполнитьЗначенияСвойств(Отбор, ЗачетАвансовВыданных);
				Отбор.Вставить("СчетКт",      ЗачетАвансовВыданных.СчетДт);
				Отбор.Вставить("КПСКт",       ЗачетАвансовВыданных.КПСДт);
				Отбор.Вставить("СубконтоКт1", ЗачетАвансовВыданных.СубконтоДт1);
				Отбор.Вставить("СубконтоКт2", ЗачетАвансовВыданных.СубконтоДт2);
				Отбор.Вставить("СубконтоКт3", ЗачетАвансовВыданных.СубконтоДт3);
				НайденныеПроводки = ПроводкиПоступлениеАктивов.НайтиСтроки(Отбор);
				
				ОбщегоНазначенияБГУ.РаспределитьСуммуПоСтрокамТаблицы(ЗачетАвансовВыданных.Сумма,
					НайденныеПроводки, "ОплаченоАвансом", "Сумма");
				
			КонецЦикла;
			
			ПроводкиПоступлениеАктивов.Свернуть("КФО,СчетКт,КПСКт,СубконтоКт1,СубконтоКт2,КЭКДт", "Сумма, ОплаченоАвансом");
			АктуальныйГрафикПлатежей = ДокументОбъект.ГрафикПлатежей.Выгрузить();
			Для Каждого ПоступлениеАктивов Из ПроводкиПоступлениеАктивов Цикл
				
				Если ПоступлениеАктивов.СубконтоКт1 <> ДокументОбъект.Контрагент
					ИЛИ ПоступлениеАктивов.СубконтоКт2 <> ДокументОбъект.Договор Тогда
					Продолжить;
				КонецЕсли;
				
				// По графику платежей определим уже запланированную сумму платежей.
				Отбор = Новый Структура;
				Отбор.Вставить("КФО", ПоступлениеАктивов.КФО);
				Отбор.Вставить("КПС", ПоступлениеАктивов.КПСКт);
				Отбор.Вставить("КЭК", ПоступлениеАктивов.КЭКДт);
				Отбор.Вставить("СчетРасчетов", ПоступлениеАктивов.СчетКт);
				УжеЗапланированныеПлатежи = АктуальныйГрафикПлатежей.Скопировать(Отбор, "СуммаВВалютеДоИзменений").Итог("СуммаВВалютеДоИзменений");
				
				// Превышение поступлений над запланированной суммой платежей добавим в график отдельной строкой.
				НоваяСтрока = ДокументОбъект.ГрафикПлатежей.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Отбор);
				НоваяСтрока.ЗапретИзменения = Ложь;
				НоваяСтрока.ВидРасчетов = Перечисления.ВидыРасчетовПоЗаймам.ОсновнойДолг; // по умолчанию
				НоваяСтрока.СуммаВВалюте = (ПоступлениеАктивов.Сумма - ПоступлениеАктивов.ОплаченоАвансом) - УжеЗапланированныеПлатежи;
				
			КонецЦикла;
			
		КонецЕсли;
		
		Если ЗаполанироватьПоступлениеОтгрузку И ЗаполнятьПланГрафикИсполнения Тогда
			
			ПроводкиАвансыВыданные = БухгалтерскийУчет.ПроводкиДокументов(ДокументОснование, "206.00", "Дт").Выгрузить();
			ПроводкиАвансыВыданные.Свернуть("КФО,СчетДт,КПСДт,СубконтоДт1,СубконтоДт2", "Сумма");
			
			АктуальныйГрафикИсполнения = ДокументОбъект.ГрафикИсполнения.Выгрузить();
			Для Каждого АвансВыданный Из ПроводкиАвансыВыданные Цикл
				
				Если АвансВыданный.СубконтоДт1 <> ДокументОбъект.Контрагент
					ИЛИ АвансВыданный.СубконтоДт1 <> ДокументОбъект.Договор Тогда
					Продолжить;
				КонецЕсли;
				
				// По графику поставок определим уже запланированную сумму поставок.
				Отбор = Новый Структура;
				Отбор.Вставить("КФО", АвансВыданный.КФО);
				Отбор.Вставить("КПС", АвансВыданный.КПСДт);
				Отбор.Вставить("КЭК", БухгалтерскийУчетПовтИсп.АналитическийКЭКпоСчету(АвансВыданный.СчетДт));
				Отбор.Вставить("СчетРасчетов", АвансВыданный.СчетДт);
				УжеЗапланированныеПоступления = АктуальныйГрафикИсполнения.Скопировать(Отбор, "СуммаВВалютеДоИзменений").Итог("СуммаВВалютеДоИзменений");
				
				// Превышение выданных авансов над запланированной суммой поступлений добавим в график отдельной строкой.
				НоваяСтрока = ДокументОбъект.ГрафикИсполнения.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Отбор);
				НоваяСтрока.ЗапретИзменения = Ложь;
				НоваяСтрока.СуммаВВалюте = АвансВыданный.Сумма - УжеЗапланированныеПоступления;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьДоступныеСтатусыДокументов(ДоступныеСтатусы, СКартинками = Истина) Экспорт
	
	ДоступныеСтатусы.Очистить();
	ДоступныеСтатусы.Добавить(Перечисления.СтатусыДокументовКонтрольИсполненияДоговоров.ОтразитьСейчас,
		НСтр("ru = 'Отразить сейчас'"), , ?(СКартинками, БиблиотекаКартинок.СтатусДокументаОтразитьИсполнениеПланаСейчас, Неопределено));
	ДоступныеСтатусы.Добавить(Перечисления.СтатусыДокументовКонтрольИсполненияДоговоров.ОтразитьПозднее,
		НСтр("ru = 'Отразить позднее'"), , ?(СКартинками, БиблиотекаКартинок.СтатусДокументаОтразитьИсполнениеПланаПозднее, Неопределено));
	ДоступныеСтатусы.Добавить(Перечисления.СтатусыДокументовКонтрольИсполненияДоговоров.НеОтражать,
		НСтр("ru = 'Не отражать'"), , ?(СКартинками, БиблиотекаКартинок.СтатусДокументаНеОтражатьИсполнениеПлана, Неопределено));
	
КонецПроцедуры

Функция ТекстПредупрежденияУчетЗадолженностиВРазрезеДатИсполнения() Экспорт
	
	Возврат НСтр("ru = 'Для учета задолженности в разрезе дат исполнения следует включить опцию ""Вести и контролировать исполнение графиков по договорам с контрагентами"" в настройках параметров учета (закладка ""Ведение учета"")'");
	
КонецФункции

