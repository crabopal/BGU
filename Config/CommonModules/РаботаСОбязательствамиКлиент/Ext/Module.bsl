Функция ОбработкаКомандыПечатиСведенияБО(ПараметрКоманды) Экспорт
	
	МассивДокументов = ПараметрКоманды.ОбъектыПечати;
	МассивДокументовДляПечати = Новый Массив;
	ТекстОшибки = "";
	МассивСтруктурДляПечати = РаботаСОбязательствамиВызовСервера.СформироватьСтруктуруДляПечати0506101(МассивДокументов);
	
	Для каждого ЭлементСтруктуры Из МассивСтруктурДляПечати Цикл
		
		Если ЭлементСтруктуры.Ошибка Тогда
			ТекстСообщения = СтрЗаменить(ЭлементСтруктуры.ТекстОшибки, "_Документ_", ЭлементСтруктуры.Наименование);
			ТекстОшибки = ТекстОшибки + ?(ТекстОшибки = "", "", Символы.ПС) + ТекстСообщения;		
		Иначе
			МассивДокументовДляПечати.Добавить(ЭлементСтруктуры.Документ);
		КонецЕсли; 
		
	КонецЦикла; 	
	
	Если МассивДокументовДляПечати.Количество() > 0 Тогда
		
		УправлениеПечатьюКлиент.ВыполнитьКомандуПечати("Обработка.ПечатьСведенийПоДоговорамИОбязательствам", ПараметрКоманды.Идентификатор, МассивДокументовДляПечати, ПараметрКоманды.Форма);
		
	КонецЕсли; 
	
	Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
		
		СообщениеТекст = НСтр("ru = 'Нельзя напечатать Форму ""Сведения о бюджетном обязательстве"" по причине:
											 |%ТекстОшибки%'");
		СообщениеТекст = СтрЗаменить(СообщениеТекст, "%ТекстОшибки%", ТекстОшибки);
		ВызватьИсключение СообщениеТекст;
		
	КонецЕсли; 
	
КонецФункции

