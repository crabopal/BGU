// ПРОГРАММНЫЙ ИНТЕРФЕЙС

// Определяет, что все символы в строке представляют собой цифры
//
// Параметры:
//  СтрокаТекста - Строка, исходная строка текста
//
// Возвращаемое значение:
// 	Истина - если все символы строки числовые
//
Функция ВсеСимволыСтрокиЧисловые(Знач СтрокаТекста) Экспорт
	
	СимволыЧисло = "0123456789";
	
	Для НомСимв = 1 По СтрДлина(СтрокаТекста) Цикл
		
		Если Найти(СимволыЧисло, Сред(СтрокаТекста, НомСимв, 1)) = 0 Тогда
			
			Возврат Ложь;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

// Находит в строке текста запроса позицию начала и окончания выражения поля запроса исключая псевдоним
//
// Параметры:
//  ТекстЗапроса - Текст запроса (или его фрагмент)
//  Начало - Число, предполагаемая позиция начала выражения поля запроса
//  Конец - Число, предполагаемая позиция окончания выражения поля запроса
//
// Возвращаемое значение:
//  Истина - если поле найдено
//
Функция ВыделитьПолеЗапроса(Знач ТекстЗапроса, Начало, Конец) Экспорт
	
	ПозЗапятая = НайтиПодстрокуЛев(ТекстЗапроса, ",", Начало, 1);
	
	// Нет запятой в запросе
	Если ПозЗапятая = 0 Тогда
		
		Конец = Начало - 1;
		ПозПС = НайтиПодстрокуЛев(ТекстЗапроса, Символы.ПС, Конец - 1, 1);
		Если ПозПС = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		Начало = ПозПС + 1;
		
	// Есть запятая в конце поля
	ИначеЕсли ПустаяСтрока(Подстрока(ТекстЗапроса, ПозЗапятая + 1,Начало - 1)) Тогда
		
		Конец = ПозЗапятая - 1;
		ПозЗапятая = НайтиПодстрокуЛев(ТекстЗапроса, ",", Конец, 1);
		ПозПС = НайтиПодстрокуЛев(ТекстЗапроса, Символы.ПС, Конец, 1);
		Если ПозПС = 0 Тогда
			Возврат Ложь;
		ИначеЕсли ПозЗапятая < ПозПС Тогда
			Начало = ПозПС + 1;
		Иначе
			Начало = ПозЗапятая + 1;
		КонецЕсли;
		
	// Найдена запятая в конце предыдущего поля
	Иначе
		
		Конец = Начало - 1;
		ПозПС = НайтиПодстрокуЛев(ТекстЗапроса, Символы.ПС, Начало - 1, 1);
		Если ПозПС = 0 Тогда
			Возврат Ложь;
		ИначеЕсли ПозЗапятая < ПозПС Тогда
			Начало = ПозПС + 1;
		Иначе
			Начало = ПозЗапятая + 1;
		КонецЕсли;
		
	КонецЕсли;
	
	СжатьГраницы(ТекстЗапроса, Начало, Конец);
	
	ПозКАК = НайтиПодстрокуПрав(ТекстЗапроса, "как", Начало, Конец);
	
	Если ПозКАК <> 0 Тогда
		
		Конец = ПозКАК - 1;
		СжатьГраницы(ТекстЗапроса, Начало, Конец);
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Выполняет поиск с право на лево подстроки в строке начиная с указанной позиции "НачальнаяПозицияПоиска"
//
// Параметры:
//  СтрокаТекста - Строка текста для поиска
//  Подстрока - Искомая подстрока
//  НачальнаяПозицияПоиска - Число, позиция начала поиска
//  ДлинаПодстроки - Число, длина искомой подстроки
//
// Возвращаемое значение:
//  Позицию начала найденной подстроки - если она найдена
//  0 - если подстрока не найдена
//
Функция НайтиПодстрокуЛев(Знач СтрокаТекста, Знач Подстрока, Знач НачальнаяПозицияПоиска = 1, Знач ДлинаПодстроки = 0) Экспорт
	
	Если ДлинаПодстроки = 0 Тогда
		ДлинаПодстроки = СтрДлина(Подстрока);
	КонецЕсли;
	
	Если ДлинаПодстроки = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	Конец = НачальнаяПозицияПоиска - ДлинаПодстроки;
	
	Для Ном = 1 По Конец Цикл
		
		НомСимв = НачальнаяПозицияПоиска - Ном + 1;
		
		СтрокаПоиска = Сред(СтрокаТекста, НомСимв, ДлинаПодстроки);
		
		Если СтрокаПоиска = Подстрока Тогда
			
			Возврат НомСимв;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат 0;
	
КонецФункции

// Выполняет поиск с лева на право подстроки в строке начиная с указанной позиции "Начало" в пределех позиции "Конец"
//
// Параметры:
//  СтрокаТекста - Строка текста для поиска
//  Подстрока - Искомая подстрока
//  Начало - Число, позиция начала поиска
//  Конец - Число, позиция окончания поиска
//
// Возвращаемое значение:
//  Позицию начала найденной подстроки - если она найдена
//  0 - если подстрока не найдена
//
Функция НайтиПодстрокуПрав(Знач СтрокаТекста, Знач Подстрока, Знач Начало = 1, Знач Конец = 0) Экспорт
	
	Если Начало > 1 Тогда
		СтрокаТекста = Сред(СтрокаТекста, Начало);
	КонецЕсли;
	
	Поз = Найти(СтрокаТекста, Подстрока);
	
	Если Поз <> 0 Тогда
		
		Поз = Начало + Поз - 1;
		
	КонецЕсли;
	
	Если Конец <> 0 И Поз > Конец Тогда
		
		Поз = 0;
		
	КонецЕсли;
	
	Возврат Поз;
	
КонецФункции

// Выполняет поиск элемента отбора по полю компоновки данных
//
// Параметры:
//  Поле - поле компоновки данных, или его имя
//  Коллекция - коллекция элементов отбора
//  ПоРодителю - если установлен, то учитывается только левая часть имени поля до точки
//  ПоПравомуЗначению - если установлен, то поле берется из правого значения элемента отбора
//
// Возвращаемое значение:
//  ЭлементОтбора - найденный элемент отбора
//  Неопределено - если элемент отбора не найден
//
Функция НайтиЭлементОтбора(Знач Поле, Знач Коллекция, Знач ПоРодителю = Ложь, Знач ПоПравомуЗначению = Ложь) Экспорт
	
	Перем ИмяПоля;
	
	Если ТипЗнч(Поле) = Тип("ПолеКомпоновкиДанных") Тогда
		ИмяПоля = Строка(Поле);
	ИначеЕсли ТипЗнч(Поле) = Тип("Строка") Тогда
		ИмяПоля = СокрЛП(Поле);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(Коллекция) <> Тип("КоллекцияЭлементовОтбораКомпоновкиДанных") Тогда
		
		Возврат Неопределено;
		
	КонецЕсли; 
	
	Если ПоРодителю Тогда
		
		Поз = Найти(ИмяПоля, ".");
		Если Поз <> 0 Тогда
			
			ИмяПоля = Лев(ИмяПоля, Поз - 1);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Для каждого ЭлементОтбора Из Коллекция Цикл
		
		Если ПоПравомуЗначению Тогда
			Если ТипЗнч(ЭлементОтбора.ПравоеЗначение) = Тип("ПолеКомпоновкиДанных") Тогда
				ЗначениеДляСравнения = Строка(ЭлементОтбора.ПравоеЗначение);
			Иначе
				Продолжить;
			КонецЕсли;
		Иначе
			ЗначениеДляСравнения = Строка(ЭлементОтбора.ЛевоеЗначение);
		КонецЕсли;
		
		Если ПоРодителю Тогда
			
			Поз = Найти(ЗначениеДляСравнения, ".");
			Если Поз <> 0 Тогда
				
				ЗначениеДляСравнения = Лев(ЗначениеДляСравнения, Поз - 1);
				
			КонецЕсли;
			
		КонецЕсли; 
		
		Если ЗначениеДляСравнения = ИмяПоля Тогда
			
			Возврат ЭлементОтбора;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции // НайтиЭлементОтбора()

// Получает подстроку из строки начиная с начальной позиции и заканчивая конечной (включительно)
//
// Параметры:
//  СтрокаТекста - Строка текста для поиска
//  Начало - Число, позиция начала подстроки
//  Конец - Число, позиция окончания подстроки
//
// Возвращаемое значение:
//  Строка текста, полученная из исходной строки
//
Функция Подстрока(Знач СтрокаТекста, Знач Начало, Знач Конец = 0) Экспорт
	
	Если Конец = 0 Тогда
		Возврат Сред(СтрокаТекста, Начало);
	Иначе
		Возврат Сред(СтрокаТекста, Начало, Конец - Начало + 1);
	КонецЕсли;
	
КонецФункции

// Получает новое значение не повторяющееся в переданной коллекции
//
// Параметры:
//  ИмяПоля - Строка - Имя поля коллекции.
//  Коллекция - Строка - Коллекция для поиска.
//  Индекс - Строка - Индекст текущей строки коллекции, для исключения её при поиске.
//  Значение - Строка - Исходное значение.
//  СтрокаРазделитель - Строка - Строка отделющая имя поля от индекса поиска.
//  ШиринаПоля - Строка - Требуемая ширина поля.
//
// Возвращаемое значение:
//  Строка, новое уникальное значение в коллекции
//
Функция ПолучитьУникальноеЗначениеСтроковогоПоляКоллекции(Знач ИмяПоля, Знач Коллекция, Знач Индекс, Знач Значение, Знач СтрокаРазделитель = "", Знач ШиринаПоля = 0) Экспорт
	
	Возврат ВыполнитьРекурсивныйПоискЗначения(ИмяПоля, Коллекция, Индекс, Значение, СтрокаРазделитель, ШиринаПоля);
	
КонецФункции

// Смещает позицию начало и конец до первых значащих символов
//
// Параметры:
//  ТекстСтроки - строка текста
//  Начало - позиция начала, с которой происходит поиск значащих символов (с лева на право)
//  Конец - позиция окончания поиска, с которой происходит поиск значащих символов (с права на лево)
//
// Возвращаемое значение:
//  Нет
//
Процедура СжатьГраницы(Знач ТекстСтроки, Начало, Конец) Экспорт
	
	Поз = Начало;
	Пока Поз <= Конец И ПустаяСтрока(Сред(ТекстСтроки, Поз, 1)) Цикл
		Поз = Поз + 1;
	КонецЦикла;
	Начало = Поз;
	
	Для Ном = 1 По Конец - Начало + 1 Цикл
		НомСимв = Конец - Ном + 1;
		Если НЕ ПустаяСтрока(Сред(ТекстСтроки, НомСимв, 1)) Тогда
			Конец = НомСимв;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Получает модифицированный текст запроса в котором удалены поля и указанным именем
//
// Параметры:
//  ТекстЗапроса - Текст запроса
//  ИмяПоля - Имя поля запроса, поиск осуществляется по шаблону: "//" + ИмяПоля + Постфикс
//          - Постфикс: _Поле, _ДоступноеПоле, _ПараметрВТ
//
// Возвращаемое значение:
//  ТекстЗапроса - модифицированный текст запроса
//
Функция УдалитьПолеЗапроса(Знач ТекстЗапроса, Знач ИмяПоля) Экспорт
	
	ТекстЗапроса1 = НРег(ТекстЗапроса);
	
	//Удаление поля
	ИмяПоля1 = НРег("//"+ИмяПоля + "_Поле");
	ДлинаИмени = СтрДлина(ИмяПоля1);
	Поз = Найти(ТекстЗапроса1, ИмяПоля1);
	
	Пока Поз <> 0 Цикл
		
		Начало = Поз;
		Конец = 0;
		
		Если ВыделитьПолеЗапроса(ТекстЗапроса1, Начало, Конец) Тогда
			
			ТекстЗапроса = Подстрока(ТекстЗапроса, 1, Начало - 1) + Подстрока(ТекстЗапроса, Поз + ДлинаИмени);
			ТекстЗапроса1 = НРег(ТекстЗапроса);
			
		Иначе
			
			Продолжить;
			
		КонецЕсли;
		
		Поз = Найти(ТекстЗапроса1, ИмяПоля1);
		
	КонецЦикла;
	
	МассивПозиций = Новый Массив;
	
	Поз1 = НайтиПодстрокуПрав(ТекстЗапроса1, "поместить");
	Если Поз1 <> 0 Тогда
		МассивПозиций.Добавить(Поз1);
	КонецЕсли;
	
	Поз2 = НайтиПодстрокуПрав(ТекстЗапроса1, "из");
	Если Поз2 <> 0 Тогда
		МассивПозиций.Добавить(Поз2);
	КонецЕсли;
	
	Поз3 = НайтиПодстрокуПрав(ТекстЗапроса1, "{выбрать");
	Если Поз3 <> 0 Тогда
		МассивПозиций.Добавить(Поз3);
	КонецЕсли;
	
	Поз = 0;
	Для каждого Элемент Из МассивПозиций Цикл
		Если Поз = 0 ИЛИ Элемент < Поз Тогда
			Поз = Элемент;
		КонецЕсли;
	КонецЦикла;
	
	Если Поз <> 0 И ПустаяСтрока(Подстрока(ТекстЗапроса, Начало, Поз - 1)) Тогда
		
		Поз = НайтиПодстрокуЛев(ТекстЗапроса, ",", Начало, 1);
		
		Если Поз <> 0 Тогда
			
			ТекстЗапроса = Подстрока(ТекстЗапроса, 1, Поз - 1) + Подстрока(ТекстЗапроса, Поз + 1);
			ТекстЗапроса1 = НРег(ТекстЗапроса);
			
		КонецЕсли;
		
	КонецЕсли;
	
	//Удаление выбранного поля
	ИмяПоля1 = НРег("//"+ИмяПоля + "_ДоступноеПоле");
	ДлинаИмени = СтрДлина(ИмяПоля1);
	Поз = Найти(ТекстЗапроса1, ИмяПоля1);
	Пока Поз <> 0 Цикл
		
		Начало = Поз;
		Конец = 0;
		
		Если ВыделитьПолеЗапроса(ТекстЗапроса1, Начало, Конец) Тогда
			
			ТекстЗапроса = Подстрока(ТекстЗапроса, 1, Начало - 1) + Подстрока(ТекстЗапроса, Поз + ДлинаИмени);
			ТекстЗапроса1 = НРег(ТекстЗапроса);
			
		Иначе
			
			Продолжить;
			
		КонецЕсли;
		
		Поз = Найти(ТекстЗапроса1, ИмяПоля1);
		
	КонецЦикла;
	
	Поз = НайтиПодстрокуПрав(ТекстЗапроса1, "}", Начало - 1);
	
	Если Поз <> 0 И ПустаяСтрока(Подстрока(ТекстЗапроса, Начало, Поз - 1)) Тогда
		
		Поз = НайтиПодстрокуЛев(ТекстЗапроса, ",", Начало, 1);
		
		Если Поз <> 0 Тогда
			
			ТекстЗапроса = Подстрока(ТекстЗапроса, 1, Поз - 1) + Подстрока(ТекстЗапроса, Поз + 1);
			ТекстЗапроса1 = НРег(ТекстЗапроса);
			
		КонецЕсли;
		
	КонецЕсли;
	
	//Удаление параметра виртуальной таблицы
	ИмяПоля1 = НРег("//"+ИмяПоля + "_ПараметрВТ");
	ДлинаИмени = СтрДлина(ИмяПоля1);
	Поз = Найти(ТекстЗапроса1, ИмяПоля1);
	Пока Поз <> 0 Цикл
		
		Начало = Поз;
		Конец = 0;
		
		Если ВыделитьПолеЗапроса(ТекстЗапроса1, Начало, Конец) Тогда
			
			ТекстЗапроса = Подстрока(ТекстЗапроса, 1, Начало - 1) + Подстрока(ТекстЗапроса, Поз + ДлинаИмени);
			ТекстЗапроса1 = НРег(ТекстЗапроса);
			
		Иначе
			
			Продолжить;
			
		КонецЕсли;
		
		Поз = Найти(ТекстЗапроса1, ИмяПоля1);
		
	КонецЦикла;
	
	Поз = НайтиПодстрокуПрав(ТекстЗапроса1, "}", Начало - 1);
	
	Если Поз <> 0 И ПустаяСтрока(Подстрока(ТекстЗапроса, Начало, Поз - 1)) Тогда
		
		Поз = НайтиПодстрокуЛев(ТекстЗапроса, ",", Начало, 1);
		
		Если Поз <> 0 Тогда
			
			ТекстЗапроса = Подстрока(ТекстЗапроса, 1, Поз - 1) + Подстрока(ТекстЗапроса, Поз + 1);
			ТекстЗапроса1 = НРег(ТекстЗапроса);
			
		КонецЕсли;
		
	КонецЕсли;
	
	//Удаление поля условия
	ИмяПоля1 = НРег("//"+ИмяПоля + "_Условие");
	ДлинаИмени = СтрДлина(ИмяПоля1);
	Поз = Найти(ТекстЗапроса1, ИмяПоля1);
	Пока Поз <> 0 Цикл
		
		Начало = Поз;
		Конец = 0;
		
		Если ВыделитьПолеЗапроса(ТекстЗапроса1, Начало, Конец) Тогда
			
			ТекстЗапроса = Подстрока(ТекстЗапроса, 1, Начало - 1) + Подстрока(ТекстЗапроса, Поз + ДлинаИмени);
			ТекстЗапроса1 = НРег(ТекстЗапроса);
			
		Иначе
			
			Продолжить;
			
		КонецЕсли;
		
		Поз = Найти(ТекстЗапроса1, ИмяПоля1);
		
	КонецЦикла;
	
	Поз = НайтиПодстрокуПрав(ТекстЗапроса1, "}", Начало - 1);
	
	Если Поз <> 0 И ПустаяСтрока(Подстрока(ТекстЗапроса, Начало, Поз - 1)) Тогда
		
		Поз = НайтиПодстрокуЛев(ТекстЗапроса, ",", Начало, 1);
		
		Если Поз <> 0 Тогда
			
			ТекстЗапроса = Подстрока(ТекстЗапроса, 1, Поз - 1) + Подстрока(ТекстЗапроса, Поз + 1);
			ТекстЗапроса1 = НРег(ТекстЗапроса);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

