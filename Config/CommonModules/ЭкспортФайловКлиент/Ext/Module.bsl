
#Область СлужебныеПроцедурыИФункции

Функция ЗначениеКлючаНастройки(Настройка, Ключ)
	
	Значение = Неопределено;
	
	Если Настройка.Свойство(Ключ, Значение) И Не ЗначениеЗаполнено(Значение) Тогда
		Значение = Неопределено;
	КонецЕсли;
	
	Возврат Значение;	
	
КонецФункции	

#КонецОбласти

// Процедура отправляет сформированные в документе "Задание на экспорт" файлы по заданной настройке
// ЗаданиеСсылка - ссылка на документ "Задание на экспорт"
// НастройкаОбмена - ссылка на справочник "Настройка обмена файлами"
// ВыбранныйКаталогВыгрузки - строка - переопределенный пользователем каталог выгрузки(при выгрузке в каталог)
// ТекстОшибки - строка - в эту строку будет помещен текст ошибки, при ее возникновении при отправке по HTTP
//
Процедура ЭкспортФайловЗаданияНаЭкспорт(ЗаданиеСсылка, НастройкаОбменаСсылка, ВыбранныйКаталогВыгрузки = Неопределено, ТекстОшибки = Неопределено, ИдентификаторФормы = Неопределено,ДополнительныеПараметры = Неопределено) Экспорт	
	
	Если ТекстОшибки = Неопределено Тогда
		ТекстОшибки = "";
	КонецЕсли;
	МассивФайлов = Неопределено;
	
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура") Тогда
		ДополнительныеПараметры.Свойство("МассивФайлов",МассивФайлов);
	КонецЕсли;
		
	СтруктураДанных = ЭкспортФайлов.ПолучитьСтруктуруДанныхДляЭкспорта(НастройкаОбменаСсылка, ЗаданиеСсылка, ИдентификаторФормы, МассивФайлов);
	
	Если СтруктураДанных.НастройкаОбмена.СпособОбмена = ПредопределенноеЗначение("Перечисление.СпособыВыгрузкиФайловПередачи.WebСервис") Тогда
		
		ВыполнятьОбменНаСервере = Истина;
		
		#Если НЕ ВебКлиент Тогда
			
		Если СтруктураДанных.НастройкаОбмена.Свойство("ОбменНаКлиенте") Тогда
			ВыполнятьОбменНаСервере = СтруктураДанных.НастройкаОбмена.ОбменНаКлиенте<>Истина;
		КонецЕсли;
			
		#КонецЕсли
		
		Если ВыполнятьОбменНаСервере Тогда
			//все делаем на сервере
			ЭкспортФайлов.ОтправитьФайлыПоHTTP(ЗаданиеСсылка, Неопределено, ТекстОшибки, ДополнительныеПараметры);
			
		Иначе
			//выполняем обмен с клиента
			ОтправитьФайлыПоHTTPНаКлиенте(ЗаданиеСсылка,СтруктураДанных,ТекстОшибки,ДополнительныеПараметры);
		КонецЕсли;
		
			
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			Возврат;
		КонецЕсли;
		
	Иначе	
	    //получаем настройки и файлы на клиенте и в зависимости от способа выгружаем
			
		НастройкаОбмена 			= СтруктураДанных.НастройкаОбмена;
		ФайлыДляПереноса 			= СтруктураДанных.ПрикрепленныеФайлы;
		ИмяОбщегоМодуляОбработки 	= СтруктураДанных.ИмяОбщегоМодуляОбработки;
		ДанныеФайлов 				= СтруктураДанных.ДанныеФайлов;//Соответствие
		
		Если ФайлыДляПереноса.Количество() 	= 0 Тогда
			ТекстСообщения 					= НСтр("ru='Нет ни одного подготовленного файла для отправления!'" );
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
			Возврат;
		КонецЕсли;	
		
		Если НастройкаОбмена.СпособОбмена = ПредопределенноеЗначение("Перечисление.СпособыВыгрузкиФайловПередачи.Каталог")
			И ЗначениеЗаполнено(ВыбранныйКаталогВыгрузки) Тогда
			КаталогВыгрузки = ВыбранныйКаталогВыгрузки;
		Иначе
			КаталогВыгрузки = НастройкаОбмена.ПутьНаСервере;
		КонецЕсли;
		
		КаталогВыгрузки     = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(КаталогВыгрузки);
		
		Если НастройкаОбмена.СпособОбмена = ПредопределенноеЗначение("Перечисление.СпособыВыгрузкиФайловПередачи.FTP") Тогда
									
			КаталогВыгрузки = СтрЗаменить(КаталогВыгрузки, "\", "/");
			
			#Если НЕ ВебКлиент Тогда
				
			ОбщийРазмер     = 0;
			
			Для Каждого ДанныеФайла Из ДанныеФайлов Цикл
				
				ОбщийРазмер = ОбщийРазмер + ДанныеФайла.Значение.Размер;
				
			КонецЦикла;
			
			Попытка
				Соединение     = ЭкспортФайловКлиентСервер.ПолучитьСоединениеСИнтернет(НастройкаОбмена);
			Исключение
			
				ТекстСообщения = НСтр("ru = 'Ошибка инициализации подключения к FTP-серверу: '") + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
				
				Возврат;
				
			КонецПопытки;
			
			ПотокВПамяти = Новый ПотокВПамяти;
					
			Попытка
			
				Для каждого ФайлДляПереноса Из ФайлыДляПереноса Цикл
				
					ДанныеФайла             = ДанныеФайлов.Получить(ФайлДляПереноса);	
				  	ПолноеИмяФайла          = КаталогВыгрузки + ДанныеФайла.ИмяФайла;	
					
					ДополнительныеПараметры = Новый Структура("Соединение, ПолноеИмяФайла, ПотокВПамяти, Смещение, ОбщийРазмер, ЗаданиеСсылка", 
					                                           Соединение, ПолноеИмяФайла, ПотокВПамяти, ДанныеФайла.Размер, ОбщийРазмер, ЗаданиеСсылка);
					ОписаниеОповещения      = Новый ОписаниеОповещения("ЗавершениеЗаписиВПоток", ЭтотОбъект, ДополнительныеПараметры);					
				
				    ПолучитьИзВременногоХранилища(ДанныеФайла.СсылкаНаДвоичныеДанныеФайла).НачатьЗапись(ОписаниеОповещения, ПотокВПамяти);
									
				КонецЦикла; 
								
			Исключение
				
				ТекстСообщения = НСтр("ru = 'Ошибка при попытке записи файлов на FTP-ресурс: '") + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
				
				Возврат;
				
			КонецПопытки;	
			
			#Иначе  
			// это веб клиент
			Попытка
				
				ЭкспортФайлов.ЗаписатьНаFTPресурс(НастройкаОбмена, КаталогВыгрузки, ФайлыДляПереноса, ДанныеФайлов);
				Состояние(НСтр("ru = 'Файлы успешно сохранены на FTP'"));
				
			Исключение
				
				ТекстСообщения = НСтр("ru = 'Не удалось записать файлы на FTP-ресурс: '") + ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
				
				Возврат;
				
			КонецПопытки;	
				
			#КонецЕсли
			
		Иначе  
			//это локальный каталог
			Попытка
				
				//КаталогВыгрузки = НастройкаОбмена.ПутьВыгрузкиПоУмолчанию;
				Если НЕ ЗначениеЗаполнено(КаталогВыгрузки) Тогда
					ТекстСообщения = НСтр("ru='Не удалось записать файлы по причине: Не указан каталог выгрузки.'");
					ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	                Возврат;
				КонецЕсли;
								
				КонтролироватьОбмен = СтруктураДанных.КонтролироватьБезопасностьОбменаЧерезКаталог;
				СохранитьФайлыНаДиск(ФайлыДляПереноса, КаталогВыгрузки, ДанныеФайлов, КонтролироватьОбмен);
							
			Исключение
				
				ТекстСообщения = НСтр("ru='Не удалось записать файлы по причине: " + ОписаниеОшибки()+"'");
				ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
				Возврат;
				
			КонецПопытки;
						
		КонецЕсли;
	КонецЕсли;
	
	Если СтруктураДанных.НастройкаОбмена.СпособОбмена <> ПредопределенноеЗначение("Перечисление.СпособыВыгрузкиФайловПередачи.FTP") Тогда
	//для FTP выполняется после завершения всех ассинхронных процедур	
	
		СписокТиповДляОповещений = Новый СписокЗначений;
		ЭкспортФайлов.ИзменитьСтатусПРДВыгруженныхДокументов(ЗаданиеСсылка, СписокТиповДляОповещений);
		Для Каждого СтрСписка Из СписокТиповДляОповещений Цикл
			ОповеститьОбИзменении(СтрСписка.Значение);
		КонецЦикла;
		
	КонецЕсли;	
		
КонецПроцедуры

Процедура ЗавершениеЗаписиВПоток(ДополнительныеПараметры) Экспорт
	
	Соединение                 = ДополнительныеПараметры["Соединение"];
	ПотокВПамяти               = ДополнительныеПараметры["ПотокВПамяти"];
	ПолноеИмяФайла             = ДополнительныеПараметры["ПолноеИмяФайла"];
	
	ПотокВПамяти.Перейти((-1)*ДополнительныеПараметры["Смещение"], ПозицияВПотоке.Конец);
	Соединение.Записать(ПолноеИмяФайла, ПотокВПамяти);
	Состояние(НСтр("ru = 'Файл успешно сохранен на FTP '"), , ПолноеИмяФайла);
	
	Если ПотокВПамяти.Размер() = ДополнительныеПараметры["ОбщийРазмер"] Тогда  //все файлы записаны в поток
		 ОписаниеОповещения    = Новый ОписаниеОповещения("ЗавершениеЗакрытияПотока", ЭтотОбъект, ДополнительныеПараметры);
		 ПотокВПамяти.НачатьЗакрытие(ОписаниеОповещения);
	КонецЕсли;	
	
КонецПроцедуры

Процедура ЗавершениеЗакрытияПотока(ДополнительныеПараметры) Экспорт
	
	СписокТиповДляОповещений = Новый СписокЗначений;
	ЭкспортФайлов.ИзменитьСтатусПРДВыгруженныхДокументов(ДополнительныеПараметры["ЗаданиеСсылка"], СписокТиповДляОповещений);
	Для Каждого СтрСписка Из СписокТиповДляОповещений Цикл
		ОповеститьОбИзменении(СтрСписка.Значение);
	КонецЦикла;
	
КонецПроцедуры

Процедура СохранитьФайлыНаДиск(ФайлыДляПереноса, КаталогВыгрузки, ДанныеФайлов, КонтролироватьОбмен = Ложь)
	
	ПолучаемыеФайлы = Новый Массив;

	Если КонтролироватьОбмен Тогда
		// Сформируем таблицу для для передачи данных о выгрузенных файлах в форму безопасности
		МассивФайл_Хеш = Новый Массив;
	КонецЕсли;	

	
	Для каждого ФайлДляПереноса Из ФайлыДляПереноса Цикл
	
		ДанныеФайла            = ДанныеФайлов.Получить(ФайлДляПереноса);	
	  	ПолноеИмяФайла         = КаталогВыгрузки + ДанныеФайла.ИмяФайла;	
				
		ПолучаемыйФайл  = Новый ОписаниеПередаваемогоФайла(ПолноеИмяФайла, ДанныеФайла.СсылкаНаДвоичныеДанныеФайла);
		ПолучаемыеФайлы.Добавить(ПолучаемыйФайл);
			
		Если КонтролироватьОбмен Тогда
			
			// Категория проблемы: 0 - нет проблем, 1 - файл удален, 2 - файл изменен
			МассивФайл_Хеш.Добавить(Новый Структура("Каталог, ИмяФайла, ХешДанных, КатегорияПроблемы",
								КаталогВыгрузки, ДанныеФайла.ИмяФайла, 
								ЭкспортФайлов.ХешСуммаДанных_МД5(ДанныеФайла.СсылкаНаДвоичныеДанныеФайла), 0));
		КонецЕсли;	

	КонецЦикла; 
	
	ДопПараметры = Новый Структура("КонтролироватьОбмен, МассивФайл_Хеш", КонтролироватьОбмен, МассивФайл_Хеш);
	ПараметрыСообщения = Новый Структура("ДопПараметры, ПолучаемыеФайлы", ДопПараметры, ПолучаемыеФайлы);  
 	Оповещение = Новый ОписаниеОповещения("ПоместитьФайлыНаДиск", ЭтотОбъект, ПараметрыСообщения);
		
	ОбщегоНазначенияКлиент.ПроверитьРасширениеРаботыСФайламиПодключено(Оповещение); 
		
КонецПроцедуры

Процедура ПоместитьФайлыНаДиск(Подключено, ПараметрыСообщения) Экспорт
	
	НачатьПолучениеФайлов(Новый ОписаниеОповещения("СохранениеФайловНаДискЗавершение", ЭтотОбъект, ПараметрыСообщения.ДопПараметры), 
						  ПараметрыСообщения.ПолучаемыеФайлы, , Ложь);
	
КонецПроцедуры	

Процедура СохранениеФайловНаДискЗавершение(ПолученныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ДополнительныеПараметры.КонтролироватьОбмен Тогда
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("МассивФайл_Хеш", ДополнительныеПараметры.МассивФайл_Хеш);
		ОткрытьФорму("Документ.ЗаданиеНаЭкспортДанныхВБанкиКС.Форма.КонтрольБезопасностиОбменаСБанком", 
					ПараметрыФормы ,,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца );
		
	Иначе
		Для каждого ПолученныйФайл Из ПолученныеФайлы Цикл
			ПолноеИмяФайла = ПолученныйФайл.Имя;
			
			Если ПолученныеФайлы <> Неопределено Тогда
				Состояние(НСтр("ru = 'Файл успешно сохранен'"), , ПолноеИмяФайла);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;	
	
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура") Тогда
		Если ДополнительныеПараметры.Свойство("ОписаниеОповещения") Тогда
			ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОписаниеОповещения);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОтправитьФайлыПоHTTPНаКлиенте(ЗаданиеСсылка,СтруктураДанных ,ТекстОшибки=Неопределено,ДополнительныеПараметры=Неопределено) Экспорт
		
	НастройкаОбмена = СтруктураДанных.НастройкаОбмена;

	ДопПарметрыНастройки = СтруктураДанных.ДопПарметрыНастройки;
	ФайлыДляПереноса = СтруктураДанных.ПрикрепленныеФайлы;
	ДанныеФайлов = СтруктураДанных.ДанныеФайлов;
	ЗаголовкиФайлов = СтруктураДанных.ЗаголовкиФайлов;
	ИспользоватьBOM = НастройкаОбмена.ИспользоватьBOM;
								
	АдресРесурса = "";
	СоединениеHTTP = ЭкспортФайловКлиентСервер.ПолучитьСоединениеСИнтернет(НастройкаОбмена, АдресРесурса);
	СоответствиеОтветов = Новый Соответствие;
	Для Каждого ФайлДляПереноса Из ФайлыДляПереноса Цикл	
		
		Попытка
			
			Заголовки = ЗаголовкиФайлов[ФайлДляПереноса];			
			ЗапросHTTP = Новый HTTPЗапрос(АдресРесурса, Заголовки);
			ДанныеФайла = ДанныеФайлов.Получить(ФайлДляПереноса);
			ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(ДанныеФайла.СсылкаНаДвоичныеДанныеФайла);
			
			Если Не ИспользоватьBOM Тогда
				УдалитьBOMСимволы(ДвоичныеДанныеФайла, НастройкаОбмена.КодировкаТекстаФайла);							
			КонецЕсли;
			
			ЗапросHTTP.УстановитьТелоИзДвоичныхДанных(ДвоичныеДанныеФайла);
			
			ОтветHTTP = СоединениеHTTP.ОтправитьДляОбработки(ЗапросHTTP);
			Ответ = ОтветHTTP.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);	
			
			СоответствиеОтветов.Вставить(ФайлДляПереноса,Ответ);

		Исключение
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='"+ОписаниеОшибки()+"'"));
			ТекстОшибки = ОписаниеОшибки();
			Прервать;
		КонецПопытки;
									
	КонецЦикла;
	
	ЭкспортФайлов.ОбработатьРезультатОтправкиФайлов(ЗаданиеСсылка,СтруктураДанных,СоответствиеОтветов,ТекстОшибки,ДополнительныеПараметры);
	
КонецПроцедуры

Процедура УдалитьBOMСимволы(Данные, Кодировка)
	
	// Символы BOM могут быть только в кодировке Unicode
	Если Кодировка = "UTF8" И Сред(Данные, 1, 8) = "EF BB BF" Тогда
		Строка64 = Base64Строка(Данные);
		Строка64 = Прав(Строка64,СтрДлина(Строка64)-4); // Удаляем 3 символа BOM
		Данные = Base64Значение(Строка64);
	ИначеЕсли Кодировка = "UTF16" Тогда
		ПервыеСимволы = Сред(Данные, 1, 5);
		Если ПервыеСимволы = "FE FF" Или ПервыеСимволы = "FF FE" Тогда
			Строка64 = Base64Строка(Данные);
			Строка64 = Прав(Строка64,СтрДлина(Строка64)-3); // Удаляем 2 символа BOM
			Данные = Base64Значение(Строка64);			
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

//Процедура отправляет сообщения из таблицы в сервис.
//Используется для обмена со СМЭВ3 на клиенте.
Асинх Функция ОтправитьФайлыВСервисНаКлиенте(ТаблицаСообщений,Знач ЗаголовкиФорматов,ПараметрыНастройки,ОграничениеОчереди=0,ФорматПодтверждения,КомпонентаПодписи) Экспорт
	
#Если Не ВебКлиент Тогда
		
	ОбменСКлиента = Истина;
	ТекстОшибки = "";
	ЕстьОшибки = Ложь;
	
	НастройкаОбменаСтруктурой = ПараметрыНастройки;

	//ДопПарметрыНастройки = СтруктураДанных.ДопПарметрыНастройки;
	//ФайлыДляПереноса = СтруктураДанных.ПрикрепленныеФайлы;
	//ДанныеФайлов = СтруктураДанных.ДанныеФайлов;
	
	ИспользоватьBOM = ?(НастройкаОбменаСтруктурой.ИспользоватьBOM,ИспользованиеByteOrderMark.Использовать,ИспользованиеByteOrderMark.НеИспользовать);
								
	АдресРесурса = "";
	СоединениеHTTP = ЭкспортФайловКлиентСервер.ПолучитьСоединениеСИнтернет(НастройкаОбменаСтруктурой, АдресРесурса);
	СоответствиеОтветов = Новый Соответствие;
	
	МассивСтрокКОбработке = Новый Массив;
	
	ТекУчастник = Неопределено;
	Для Каждого СтрТЧ Из ТаблицаСообщений Цикл	
		
		ПозицияНачалаФайла = 1;
		Если СтрНачинаетсяС(СтрТЧ.СодержимоеФайла,"<?")  Тогда
			ПозицияНачалаФайла = СтрНайти(СтрТЧ.СодержимоеФайла,"?>")+2;
			СтрТЧ.СодержимоеФайла = СокрЛП(Сред(СтрТЧ.СодержимоеФайла,ПозицияНачалаФайла));
		КонецЕсли;
		
		//СтрТЧ.СодержимоеФайла = СокрЛП(СтрЗаменить(СтрТЧ.СодержимоеФайла,"<?xml version=""1.0"" encoding=""UTF-8""?>",""));
		Если СтрТЧ.Подписано = Ложь Тогда
			Продолжить;
		КонецЕсли;
		
		МассивСтрокКОбработке.Добавить(СтрТЧ.ПолучитьИдентификатор());
		ТекУчастник = СтрТЧ.ТекущийУчастник;
	КонецЦикла;
	
	ПараметрыОчередиСообщений = ГосУслуги.ПолучитьПараметрыОчередиСообщений(НастройкаОбменаСтруктурой.Ссылка);
	ПараметрыОчередиСообщений.Вставить("ДатаНачалаОбмена",ТекущаяДата());
	Если ОграничениеОчереди <> 0 Тогда
		//ОграничениеОчереди - заполняется при обмене с ГИС ГМП, если это автоматическое получение данных из очереди
		Если ПараметрыОчередиСообщений.МасимальноеКоличествоСообщений>0 Тогда			
			ПараметрыОчередиСообщений.МасимальноеКоличествоСообщений = Мин(ОграничениеОчереди,ПараметрыОчередиСообщений.МасимальноеКоличествоСообщений);
		Иначе
			ПараметрыОчередиСообщений.МасимальноеКоличествоСообщений = ОграничениеОчереди;
		КонецЕсли;
	КонецЕсли;
	
	ПодписьНаКлиенте = Ложь;
		
	ШаблонСообщенияПодтверждения = "";
	Если ЗначениеЗаполнено(ФорматПодтверждения)
		И ЗначениеЗаполнено(ТекУчастник) Тогда
		ШаблонСообщенияПодтверждения = ГосУслуги.СформироватьШаблонСообщенияПодтверждения(ТекУчастник,ФорматПодтверждения);
		
		ПозицияНачалаФайла = 1;
		Если СтрНачинаетсяС(ШаблонСообщенияПодтверждения,"<?")  Тогда
			ПозицияНачалаФайла = СтрНайти(ШаблонСообщенияПодтверждения,"?>")+2;
			ШаблонСообщенияПодтверждения = СокрЛП(Сред(ШаблонСообщенияПодтверждения,ПозицияНачалаФайла));
		КонецЕсли;
		
		ПодписьНаКлиенте = ГосУслугиКлиентСервер.НужнаКомпонентаПодписиНаКлиенте();
	КонецЕсли;
	
	НастройкиПодписиУчастников = Неопределено;
	Если ЗначениеЗаполнено(ШаблонСообщенияПодтверждения)
		И ПодписьНаКлиенте Тогда
		НастройкиПодписиУчастников = ГосУслуги.ПолучитьНастройкиПодписиУчастников20(ТекУчастник);
	КонецЕсли;
	
	//Выполняем обмен с сервисом.
	//Если это запрос данных из очереди, то при получении в ответе данных,
	//копируем строку запроса и выполняем запрос следующего сообщения из очереди.
	Пока МассивСтрокКОбработке.Количество()>0 Цикл
		МассивСтрокКОбработке = Ждать ОтправитьВыбранныеФайлыВСервис(ТаблицаСообщений,
			МассивСтрокКОбработке,
			ЗаголовкиФорматов,
			СоединениеHTTP,
			АдресРесурса,
			ИспользоватьBOM,
			ПараметрыОчередиСообщений,
			ФорматПодтверждения,
			ШаблонСообщенияПодтверждения,
			ПодписьНаКлиенте,
			КомпонентаПодписи,
			НастройкиПодписиУчастников);
	КонецЦикла;
			
	Возврат ТекстОшибки;
	
#Иначе
	ВызватьИсключение НСтр("ru = 'Недопустимый вызов метода в веб-клиенте.'");
#КонецЕсли

КонецФункции

Асинх Функция ОтправитьВыбранныеФайлыВСервис(ТаблицаСообщений,
	МассивСтрокКОбработке,
	ЗаголовкиФорматов,
	СоединениеHTTP,
	АдресРесурса,
	ИспользоватьBOM,
	ПараметрыОчередиСообщений,
	ФорматПодтверждения,
	ШаблонСообщенияПодтверждения,
	ПодписьНаКлиенте,
	КомпонентаПодписи,
	НастройкиПодписиУчастников)
	
	МассивНовыхСтрокКОбработке = Новый Массив;
	
	ЕстьОтборПоКоличеству = ПараметрыОчередиСообщений.МасимальноеКоличествоСообщений>0;
	
	ФразаИдентификатор = "%ТутБудетИдентификаторСообщения%";
		
	Для Каждого СтрИд Из МассивСтрокКОбработке Цикл	
		
		СтрТЧ = ТаблицаСообщений.НайтиПоИдентификатору(СтрИд);
		
		Если СтрТЧ.Подписано = Ложь Тогда
			Продолжить;
		КонецЕсли;
		
		ПозицияНачалаФайла = 1;
		Если СтрНачинаетсяС(СтрТЧ.СодержимоеФайла,"<?")  Тогда
			ПозицияНачалаФайла = СтрНайти(СтрТЧ.СодержимоеФайла,"?>")+2;
			СтрТЧ.СодержимоеФайла = СокрЛП(Сред(СтрТЧ.СодержимоеФайла,ПозицияНачалаФайла));
		КонецЕсли;
				
		Попытка
			
			Заголовки = ЗаголовкиФорматов[СтрТЧ.ФорматОбмена];			
			ЗапросHTTP = Новый HTTPЗапрос(АдресРесурса, Заголовки);
			
			ЗапросHTTP.УстановитьТелоИзСтроки(СтрТЧ.СодержимоеФайла,КодировкаТекста.UTF8,ИспользоватьBOM);//ИзДвоичныхДанных(ДвоичныеДанныеФайла);
			
			ОтветHTTP = СоединениеHTTP.ОтправитьДляОбработки(ЗапросHTTP);
			
			СтрТЧ.КодСостояния = ОтветHTTP.КодСостояния;
			
			Ответ = ОтветHTTP.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
			СтрТЧ.СообщениеОтвет = Ответ;
			
			СтрТЧ.ДатаОбмена = ТекущаяДата();
			
			Если ОтветHTTP.КодСостояния <> 200 Тогда
				СтрТЧ.СтатусОтправки = ПредопределенноеЗначение("Перечисление.РезультатыОтправкиСообщенийВСМЭВ.Ошибка");
				ЕстьОшибки = Истина;
			Иначе	
							
				Если СтрТЧ.ВидСообщения = ПредопределенноеЗначение("Перечисление.ТипыЗапросовСМЭВ3.ЗапросДанныхИзОчередиСМЭВ")
					ИЛИ СтрТЧ.ВидСообщения = ПредопределенноеЗначение("Перечисление.ТипыЗапросовСМЭВ3.ЗапросДанныхИзОчередиСтатусов") Тогда
					
					СтрТЧ.СтатусОтправки = ПредопределенноеЗначение("Перечисление.РезультатыОтправкиСообщенийВСМЭВ.Отправлен");
					
					ИдентификаторСообщенияДляПодтверждения = "";
					Если ЭкспортФайловКлиентСервер.ВОтветеЕстьДанные(Ответ, ИдентификаторСообщенияДляПодтверждения) Тогда
						СтрТЧ.ЕстьДанные = Истина;
						//если очередь не поддерживается, то ответ без подтверждения можно получить только 1 по каждому виду сведений, потом надо запрашивать снова 
						
						Если ЗначениеЗаполнено(ШаблонСообщенияПодтверждения)
							И ЗначениеЗаполнено(ИдентификаторСообщенияДляПодтверждения) Тогда
							
							СообщениеДляПодтверждения = СтрЗаменить(ШаблонСообщенияПодтверждения,ФразаИдентификатор,ИдентификаторСообщенияДляПодтверждения);
							
							ТекстОшибки = "";
							ПодтверждаемСразу = Ложь;
							ПодтверждениеПодписано = Ложь;
							
							Если ПодписьНаКлиенте = Ложь Тогда
								//мы на клиенте, а подпись выполняется на сервере, можем сходить на сервер и подписать сообщение и подтвердить получение
								
								ПодтверждаемСразу = Истина;
								
								ПодтверждениеПодписано = ГосУслуги.ПодписатьПодтверждениеПолученияСообщенияНаСервереСКлиента(СтрТЧ.ТекущийУчастник,
									СообщениеДляПодтверждения,ТекстОшибки);
																	
							ИначеЕсли ПодписьНаКлиенте = Истина Тогда
								//мы на клиенте и подпись на клиенте, можем сразу подписать сообщение и подтвердить получение 
								
								ПодтверждаемСразу = Истина;
								
								СтруктураРезультата = Ждать ГосУслугиКлиент.ПодписатьПодтверждениеПолученияСообщенияНаКлиенте(СтрТЧ.ТекущийУчастник,
									СообщениеДляПодтверждения,КомпонентаПодписи,НастройкиПодписиУчастников);
									
								ТекстОшибки = СтруктураРезультата.ТекстОшибки;
								СообщениеДляПодтверждения = СтруктураРезультата.СодержимоеФайла;
								Если ЗначениеЗаполнено(СообщениеДляПодтверждения) Тогда
									ПодтверждениеПодписано = Истина;
								КонецЕсли;
								
							КонецЕсли;
							
							Если ЗначениеЗаполнено(ТекстОшибки) Тогда
								ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
							КонецЕсли;
							
							Если ПодтверждаемСразу = Истина
								И ПодтверждениеПодписано Тогда
								
								НоваяСтрокаПодтверждения = ТаблицаСообщений.Добавить();
								НоваяСтрокаПодтверждения.СодержимоеФайла = СообщениеДляПодтверждения;
								НоваяСтрокаПодтверждения.ИдентификаторСообщения = ИдентификаторСообщенияДляПодтверждения;
								НоваяСтрокаПодтверждения.ФорматОбмена = ФорматПодтверждения;
								НоваяСтрокаПодтверждения.ВидСообщения = ПредопределенноеЗначение("Перечисление.ТипыЗапросовСМЭВ3.ПодтверждениеПолученияСообщенияСМЭВ");
								НоваяСтрокаПодтверждения.ТекущийУчастник = СтрТЧ.ТекущийУчастник;
								НоваяСтрокаПодтверждения.СтатусОтправки = ПредопределенноеЗначение("Перечисление.РезультатыОтправкиСообщенийВСМЭВ.НеОтправлен");
								НоваяСтрокаПодтверждения.Подписано = Истина;
								НоваяСтрокаПодтверждения.НомерПакета = ТаблицаСообщений.Количество();
								
								Попытка
									
									Заголовки = ЗаголовкиФорматов[ФорматПодтверждения];			
									ЗапросHTTP = Новый HTTPЗапрос(АдресРесурса, Заголовки);
									
									ЗапросHTTP.УстановитьТелоИзСтроки(НоваяСтрокаПодтверждения.СодержимоеФайла,КодировкаТекста.UTF8,ИспользоватьBOM);//ИзДвоичныхДанных(ДвоичныеДанныеФайла);
									
									ОтветHTTP = СоединениеHTTP.ОтправитьДляОбработки(ЗапросHTTP);
									
									НоваяСтрокаПодтверждения.КодСостояния = ОтветHTTP.КодСостояния;
									
									Ответ = ОтветHTTP.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
									НоваяСтрокаПодтверждения.СообщениеОтвет = Ответ;
									
									Если ОтветHTTP.КодСостояния <> 200 Тогда
										НоваяСтрокаПодтверждения.СтатусОтправки = ПредопределенноеЗначение("Перечисление.РезультатыОтправкиСообщенийВСМЭВ.Ошибка");
										ЕстьОшибки = Истина;
									Иначе
										НоваяСтрокаПодтверждения.СтатусОтправки = ПредопределенноеЗначение("Перечисление.РезультатыОтправкиСообщенийВСМЭВ.Отправлен");										
									КонецЕсли;
									
									НоваяСтрокаПодтверждения.ДатаОбмена = ТекущаяДата();
									
									СтрТЧ.Подтверждено = Истина;
								
								Исключение
		
									НоваяСтрокаПодтверждения.СтатусОтправки = ПредопределенноеЗначение("Перечисление.РезультатыОтправкиСообщенийВСМЭВ.НеОтправлен");
												
									ЕстьОшибки = Истина;
									ТекстОшибки = Нстр("ru='Не удалось отправить сообщение в сервис по причине: %1'");
									ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ОписаниеОшибки());
									
									ЭкспортФайловКлиентСервер.ДобавитьОшибку(НоваяСтрокаПодтверждения.ТаблицаОшибок, ТекстОшибки, "");
									
								КонецПопытки;
							КонецЕсли;
							
						КонецЕсли;	
						
						//если в ответе есть данные, и поддерживается очередь,
						//или мы уже подтвердили полученное сообщение, и по этому сообщению-запросу можно еще раз запросить ответ,
						//то добавим новую строку запроса данных из очереди, чтобы сразу получить еще
						
						Если ПараметрыОчередиСообщений.ОчередьПоддерживается
							ИЛИ (СтрТЧ.Подтверждено  
								И СтрТЧ.ПоддерживаетПовторныйЗапрос) Тогда
							
							ДатаОкончанияОбмена = ТекущаяДата();
							//При обмене с ГИС ГМП необходимо за 15 минут подтвердить все полученные сообщения, 
							//иначе они снова будут приходить при запросе.
							//Поэтому на получение сообщений из очереди выделяем 6 минут - 360 секунд.
							//Если за это время не были получены все сообщения, то после подтверждения полученных сообщений,
							//в обработке обмена будет предложено запросить данные из очереди еще раз.
							
							ВремяЕсть = ДатаОкончанияОбмена - ПараметрыОчередиСообщений.ДатаНачалаОбмена < ПараметрыОчередиСообщений.МаксимальнаяДлительность;
							КоличествоЕсть = Истина;
							Если ЕстьОтборПоКоличеству Тогда
								КоличествоЕсть = ТаблицаСообщений.Количество() < ПараметрыОчередиСообщений.МасимальноеКоличествоСообщений;
							КонецЕсли;
							
							Если ВремяЕсть 
								И КоличествоЕсть Тогда
							
								НоваяСтрока = ТаблицаСообщений.Добавить();
								ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрТЧ,,"ТаблицаОшибок,СообщениеОтвет,СтатусОтправки,КодСостояния,ЕстьДанные,Подтверждено");
								НоваяСтрока.НомерПакета = ТаблицаСообщений.Количество();
								
								МассивНовыхСтрокКОбработке.Добавить(НоваяСтрока.ПолучитьИдентификатор());
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				ИначеЕсли СтрТЧ.ВидСообщения = ПредопределенноеЗначение("Перечисление.ТипыЗапросовСМЭВ3.ПодтверждениеПолученияСообщенияСМЭВ") Тогда
					СтрТЧ.СтатусОтправки = ПредопределенноеЗначение("Перечисление.РезультатыОтправкиСообщенийВСМЭВ.Отправлен");
				Иначе
					//передача запроса данных в обработку
					СтрТЧ.СтатусОтправки = ПредопределенноеЗначение("Перечисление.РезультатыОтправкиСообщенийВСМЭВ.ВОчереди");
				КонецЕсли;
			КонецЕсли;
			
		Исключение
			
			СтрТЧ.СтатусОтправки = ПредопределенноеЗначение("Перечисление.РезультатыОтправкиСообщенийВСМЭВ.НеОтправлен");
						
			ЕстьОшибки = Истина;
			ТекстОшибки = Нстр("ru='Не удалось отправить сообщение в сервис по причине: %1'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ОписаниеОшибки());
			
			ЭкспортФайловКлиентСервер.ДобавитьОшибку(СтрТЧ.ТаблицаОшибок, ТекстОшибки, "");
			
			Продолжить;
		КонецПопытки;
		
	КонецЦикла;
		
	Возврат МассивНовыхСтрокКОбработке;
	
КонецФункции


Процедура ВыгрузитьФайлыЛокально(ТаблицаСообщений,РезультатФормирования,ПараметрыНастройки,ЕстьОшибки,ТекстОшибки,ОписаниеОповещения) Экспорт
				
	Если ПараметрыНастройки.СпособОбмена = ПредопределенноеЗначение("Перечисление.СпособыВыгрузкиФайловПередачи.Каталог") Тогда
		
		КаталогВыгрузки = ПараметрыНастройки.ПутьВыгрузкиПоУмолчанию;
		
		//это локальный каталог
		Попытка
			
			//КаталогВыгрузки = НастройкаОбмена.ПутьВыгрузкиПоУмолчанию;
			Если НЕ ЗначениеЗаполнено(КаталогВыгрузки) Тогда
				ТекстСообщения = НСтр("ru='Не удалось записать файлы по причине: Не указан каталог выгрузки.'");
				ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
                Возврат;
			КонецЕсли;
			
			КаталогВыгрузки = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(КаталогВыгрузки);
						
			СоответствиеФайлов = ЭкспортФайлов.ЗаписатьТаблицуСообщенийВДвоичныеДанные(ТаблицаСообщений,РезультатФормирования);
			ПолучаемыеФайлы = Новый Массив;
			
			УстанавливаемыйСтатус = ПредопределенноеЗначение("Перечисление.РезультатыОтправкиСообщенийВСМЭВ.ВыгруженВКаталог");
			Для Каждого СтрТЧ Из ТаблицаСообщений Цикл
	            СтрТЧ.ДатаОбмена = ТекущаяДата();
				
				СтруктураФайла  = СоответствиеФайлов.Получить(СтрТЧ.ИдентификаторСообщения);
				Если ЗначениеЗаполнено(СтруктураФайла.ИмяФайла) Тогда
					ПолноеИмяФайла = КаталогВыгрузки + СтруктураФайла.ИмяФайла;
				Иначе
			  		ПолноеИмяФайла = КаталогВыгрузки + СтрТЧ.ИдентификаторСообщения + ".xml";	
				КонецЕсли;
				
				ПолучаемыйФайл  = Новый ОписаниеПередаваемогоФайла(ПолноеИмяФайла, СтруктураФайла.Данные);
				ПолучаемыеФайлы.Добавить(ПолучаемыйФайл);
				
				СтрТЧ.СтатусОтправки = УстанавливаемыйСтатус;

			КонецЦикла;
			
			ДопПараметры = Новый Структура("КонтролироватьОбмен, МассивФайл_Хеш,ОписаниеОповещения", Ложь, Новый Массив,ОписаниеОповещения);
			ПараметрыСообщения = Новый Структура("ДопПараметры, ПолучаемыеФайлы", ДопПараметры, ПолучаемыеФайлы);  
		 	Оповещение = Новый ОписаниеОповещения("ПоместитьФайлыНаДиск", ЭтотОбъект, ПараметрыСообщения);
				
			ОбщегоНазначенияКлиент.ПроверитьРасширениеРаботыСФайламиПодключено(Оповещение);
	
		Исключение
			
			ТекстСообщения = НСтр("ru='Не удалось записать файлы по причине: %1'");
			
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,ОписаниеОшибки());
			
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
			Возврат;
			
		КонецПопытки;
		
	КонецЕсли;
КонецПроцедуры