
#Область ПрограммныйИнтерфейс

// См. одноименную процедуру общего модуля "ПользователиПереопределяемый".
//
Процедура ПриПолученииПрочихНастроек(СведенияОПользователе, Настройки) Экспорт
	
	ИдентификаторНастройки = "ПользовательскиеНастройкиКонсолиРуководителя";
	
	КлючОбъекта = "Отчет.КонсольРуководителя/ОстаткиДенежныхСредств/ТекущиеПользовательскиеНастройки";
	
	Фильтр = Новый Структура;
	Фильтр.Вставить("Пользователь", СведенияОПользователе.ИмяПользователяИнформационнойБазы);
	Фильтр.Вставить("КлючОбъекта", КлючОбъекта);
	
	Выборка = ХранилищеСистемныхНастроек.Выбрать(Фильтр);
	Если Выборка.Следующий() Тогда
		
		ИнформацияОНастройке = Новый Структура;
		
		НазваниеНастройки = НСтр("ru = 'Настройки консоли руководителя'");
		
		СписокНастроек = Новый СписокЗначений;
		СписокНастроек.Добавить(Выборка.Настройки);
		
		ИнформацияОНастройке.Вставить("НазваниеНастройки", НазваниеНастройки);
		ИнформацияОНастройке.Вставить("КартинкаНастройки", БиблиотекаКартинок.Отчет);
		ИнформацияОНастройке.Вставить("СписокНастроек", СписокНастроек);
		
		Настройки.Вставить(ИдентификаторНастройки, ИнформацияОНастройке);
		
	КонецЕсли;
	
КонецПроцедуры

// См. одноименную процедуру общего модуля "ПользователиПереопределяемый".
//
Процедура ПриСохраненииПрочихНастроек(СведенияОПользователе, Настройки) Экспорт
	
	Если Настройки.ИдентификаторНастройки = "ПользовательскиеНастройкиКонсолиРуководителя" Тогда
		
		КлючОбъекта = "Отчет.КонсольРуководителя/ОстаткиДенежныхСредств/ТекущиеПользовательскиеНастройки";
		
		Значение = Настройки.ЗначениеНастройки[0].Значение;
		
		ХранилищеСистемныхНастроек.Сохранить(
			КлючОбъекта, , Значение, , СведенияОПользователе.ИмяПользователяИнформационнойБазы);
		
	КонецЕсли;
	
КонецПроцедуры

// См. одноименную процедуру общего модуля "ПользователиПереопределяемый".
//
Процедура ПриУдаленииПрочихНастроек(СведенияОПользователе, Настройки) Экспорт
	
	Если Настройки.ИдентификаторНастройки = "ПользовательскиеНастройкиКонсолиРуководителя" Тогда
		
		КлючОбъекта = "Отчет.КонсольРуководителя/ОстаткиДенежныхСредств/ТекущиеПользовательскиеНастройки";
		
		ХранилищеСистемныхНастроек.Удалить(КлючОбъекта, , СведенияОПользователе.ИмяПользователяИнформационнойБазы);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти