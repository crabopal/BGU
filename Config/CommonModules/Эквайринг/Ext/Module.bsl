Функция ЗадолженностьБанка(Организация, ДатаСведений, НаКонецДня = Ложь) Экспорт
	Результат = 0;
	ПериодСведений = ?(НаКонецДня, Новый Граница(КонецДня(ДатаСведений), ВидГраницы.Включая), 
						НачалоДня(ДатаСведений));   
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 	"ВЫБРАТЬ
	               	|	ЖурналПроводокЕПСБУОстатки.СуммаОстаток
	               	|ИЗ
	               	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&ПериодСведений, Счет В (&Счет20123), , Организация = &Организация) КАК ЖурналПроводокЕПСБУОстатки";
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ПериодСведений", ПериодСведений);
	Запрос.УстановитьПараметр("Счет20123", БухгалтерскийУчетПовтИсп.СписокСчетов("201.23"));
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.СуммаОстаток; 
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

Функция НаименованиеОрганизации(Организация) Экспорт
	Результат = "";
	
	Если ЗначениеЗаполнено(Организация) Тогда
		Если СокрЛП(Организация.НаименованиеСокращенное) = "" Тогда
			Результат = Организация.Наименование;
		Иначе
			Результат = Организация.НаименованиеСокращенное;
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

Функция ДопустимыеИсточникиСредств(ЛицевойСчет,КФО = Неопределено) Экспорт
	
	Если КФО = Неопределено Тогда
		КФО = ПредопределенноеЗначение("Перечисление.КВД.ПустаяСсылка");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РазделыЛицевыхСчетовДопустимыеКФО.Ссылка.ИсточникСредств КАК ИС
	|ИЗ
	|	Справочник.РазделыЛицевыхСчетов.ДопустимыеКФО КАК РазделыЛицевыхСчетовДопустимыеКФО
	|ГДЕ
	|	РазделыЛицевыхСчетовДопустимыеКФО.Ссылка.Владелец = &ЛС
	|	И (РазделыЛицевыхСчетовДопустимыеКФО.КФО = &КФО
	|			ИЛИ &КФО = ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка))";
	
	Запрос.УстановитьПараметр("ЛС",ЛицевойСчет);
	Запрос.УстановитьПараметр("КФО",КФО);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ИС");
	
КонецФункции

Функция ЕстьСчетФактураДляЭквайринговойОперации(ЭквайринговаяОперация) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СчетФактураВыданный.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
	|ГДЕ
	|	СчетФактураВыданный.ДокументОснование = &ДокументОснование
	|	И СчетФактураВыданный.ПометкаУдаления = ЛОЖЬ";	
	
	Запрос.УстановитьПараметр("ДокументОснование", ЭквайринговаяОперация);
	ТаблицаСФ = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаСФ;
КонецФункции	