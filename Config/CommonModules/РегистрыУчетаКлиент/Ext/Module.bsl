
#Область ПрограммныйИнтерфейс


// Процедура - Обработчик команды работы с регистром учета
//
// Параметры:
//  ФормаОтчета	 	- 	управляемая форма, контекст работы команды - 
//  Команда		 	- 	команда формы 
//  ТабРезультат	- 	строка, имя реквизита формы, в котором содержится табличный
//						документ, должен совпадать с имененм связанного элемента формы 
//
Процедура ОбработчикКомандыРаботыСРегистромУчета(ФормаОтчета, Команда, ТабРезультат, НастройкиВРегистр = Истина) Экспорт
	
	Если Команда.Имя = "СохранитьРегистрУчета" Тогда
		
		СохранитьРегистрУчета(ФормаОтчета, ТабРезультат, НастройкиВРегистр);
		
	ИначеЕсли Команда.Имя = "СохранитьРегистрУчетаРаздельно" Тогда
		
		СохранитьРегистрУчета(ФормаОтчета, ТабРезультат, НастройкиВРегистр, Истина);
		
	ИначеЕсли Команда.Имя = "СохранитьРегистрУчетаИСоздатьВнутрЭД" Тогда
		
		СохранитьРегистрУчетаИСоздатьВнутрЭД(ФормаОтчета, ТабРезультат);
		
	ИначеЕсли Команда.Имя = "СохранитьРегистрУчетаИСоздатьВнутрЭДРаздельно" Тогда
		
		СохранитьРегистрУчетаИСоздатьВнутрЭД(ФормаОтчета, ТабРезультат, Истина);
		
	ИначеЕсли Команда.Имя = "АрхивРегистровУчета" Тогда
		
		ОткрытьАрхивРегистровУчета(ФормаОтчета);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Сохраняет табличный документ как регистр учета
// 
//
Асинх Процедура СохранитьРегистрУчета(Форма, ТабРезультат, НастройкиВРегистр, ГрупповоеСохранение = Ложь)
	
	СвойстваРегистровУчета = Новый Массив;
	
	Если Форма.ТипФормы = "ФормаПечати" Тогда
		
		Для Каждого ОбъектПечати Из Форма.ОбъектыПечати Цикл
			
			Объект = ОбъектПечати.Значение;
			ИмяОбласти = ОбъектПечати.Представление;
			
			Если Форма.ОбъектыПечати.Количество() = 1 Тогда
				СвойстваРегистраУчета = СвойстваРегистраУчета(Форма, ТабРезультат);
			Иначе
				СвойстваРегистраУчета = СвойстваРегистраУчета(Форма, ТабРезультат, ИмяОбласти);
			КонецЕсли;
			
			СвойстваРегистраУчета.ПроверитьВозможностьСозданияВнутреннегоЭД = Ложь;
			
			Если Форма.Параметры.ПараметрыПечати.ДополнительныеПараметры.Свойство("СвойстваРегистраУчета") Тогда
				ДанныеОтчета = Форма.Параметры.ПараметрыПечати.ДополнительныеПараметры["СвойстваРегистраУчета"];
			ИначеЕсли Форма.Параметры.ПараметрыПечати.ДополнительныеПараметры.Свойство("СвойстваРегистровУчета") Тогда
				ДанныеОтчета = Форма.Параметры.ПараметрыПечати.ДополнительныеПараметры["СвойстваРегистровУчета"][Объект];
			Иначе
				ДанныеОтчета = Новый Структура;
			КонецЕсли;
			
			СвойстваРегистровУчета.Добавить(
				Новый Структура("СвойстваРегистраУчета, ДанныеОтчета",
				СвойстваРегистраУчета, ДанныеОтчета));
			
		КонецЦикла;
		
	Иначе
		Если ГрупповоеСохранение Тогда
			КонтрольНаКоличествоПройден = Ждать КонтрольНаКоличествоРегистровПройден(Форма.ОбъектыПечати);
			
			Если НЕ КонтрольНаКоличествоПройден Тогда
				Возврат;
			КонецЕсли;	
			
			Для Каждого ОбъектПечати Из Форма.ОбъектыПечати Цикл
				Объект = ОбъектПечати.Значение;
				ИмяОбласти = ОбъектПечати.Представление;
				
				Если Форма.ОбъектыПечати.Количество() = 1 Тогда
					СвойстваРегистраУчета = СвойстваРегистраУчета(Форма, ТабРезультат);
				Иначе
					СвойстваРегистраУчета = СвойстваРегистраУчета(Форма, ТабРезультат, ИмяОбласти, Объект);
				КонецЕсли;
				СвойстваРегистраУчета.ПроверитьВозможностьСозданияВнутреннегоЭД = Ложь;
				
				ДанныеОтчета = Форма.Отчет;
				
				СвойстваРегистровУчета.Добавить(
					Новый Структура("СвойстваРегистраУчета, ДанныеОтчета",
					СвойстваРегистраУчета, ДанныеОтчета));
			КонецЦикла;
		Иначе	
			СвойстваРегистраУчета = СвойстваРегистраУчета(Форма, ТабРезультат);
			СвойстваРегистраУчета.ПроверитьВозможностьСозданияВнутреннегоЭД = Ложь;
			
			ДанныеОтчета = Форма.Отчет;
			
			СвойстваРегистровУчета.Добавить(
				Новый Структура("СвойстваРегистраУчета, ДанныеОтчета",
				СвойстваРегистраУчета, ДанныеОтчета));
		КонецЕсли;		
		
	КонецЕсли;
	
	ДанныеСохраненныхРегистров = РегистрыУчетаВызовСервера.СохранитьРегистрыУчета(СвойстваРегистровУчета, НастройкиВРегистр);
	
	Если ДанныеСохраненныхРегистров <> Неопределено Тогда
		
		Для Каждого ДанныеСохранения Из ДанныеСохраненныхРегистров Цикл
			
			Оповестить("Запись_ПрисоединенныйФайл", Новый Структура, ДанныеСохранения.ПрисоединенныйФайл);
			
			Если ДанныеСохраненныхРегистров.Количество() = 1 Тогда
				
				ПоказатьОповещениеПользователя(
					НСтр("ru = 'Сохранен регистр учета'"),
					ПолучитьНавигационнуюСсылку(ДанныеСохранения.РегистрУчета),
					ДанныеСохранения.ОписаниеРегистра,
					БиблиотекаКартинок.Информация32);
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если ДанныеСохраненныхРегистров.Количество() > 1 Тогда
			
			ТекстОповещения = СтрШаблон(НСтр("ru='Сохранено %1 учета'"),
				СтрокаСЧислом(";%1 регистр;;%1 регистра;%1 регистров;%1 регистра",
				ДанныеСохраненныхРегистров.Количество(), ВидЧисловогоЗначения.Количественное, "L=ru"));
			
			ПоказатьОповещениеПользователя(
				ТекстОповещения,
				,
				,
				БиблиотекаКартинок.Информация32);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

/// Открывает список сохраненных регистров учета с отбором
// Вызывается из формы отчета
//
Процедура ОткрытьАрхивРегистровУчета(Форма)
	
	СвойстваРегистраУчета = Новый Структура("Организация, НачалоПериода, КонецПериода, ВидРегистра");
	
	СвойстваРегистраУчета.Вставить("ВидРегистра", Форма.ВидРегистраУчета);
	
	Если Форма.ТипФормы = "ФормаПечати" Тогда
		ДанныеОтчета = Новый Структура;
		Если НЕ Форма.Параметры.ПараметрыПечати.ДополнительныеПараметры.Свойство("СвойстваРегистраУчета", ДанныеОтчета) Тогда
			ДанныеОтчета = Новый Структура;
		КонецЕсли;
	Иначе
		ДанныеОтчета = Форма.Отчет;
	КонецЕсли;
	
	РегистрыУчетаВызовСервера.ДополнитьСвойстваРегистраУчета(СвойстваРегистраУчета, ДанныеОтчета);
	
	Если ЗначениеЗаполнено(СвойстваРегистраУчета.ВидРегистра) Тогда
		
		ПараметрыОткрытияФормы = Новый Структура();
		ПараметрыОткрытияФормы.Вставить("Отбор", СвойстваРегистраУчета);
		
		ОткрытьФорму("Документ.РегистрУчета.ФормаСписка", ПараметрыОткрытияФормы);
		
	КонецЕсли;
	
КонецПроцедуры

Асинх Процедура СохранитьРегистрУчетаИСоздатьВнутрЭД(Форма, ТабРезультат, ГрупповоеСохранение = Ложь)
	
	Если ГрупповоеСохранение Тогда
		КонтрольНаКоличествоПройден = Ждать КонтрольНаКоличествоРегистровПройден(Форма.ОбъектыПечати);
		
		Если НЕ КонтрольНаКоличествоПройден Тогда
			Возврат;
		КонецЕсли;	
		
		СвойстваРегистровУчета = Новый Массив;
		КоличествоОбъектов = Форма.ОбъектыПечати.Количество();
		Для Каждого ОбъектПечати Из Форма.ОбъектыПечати Цикл
			Объект = ОбъектПечати.Значение;
			ИмяОбласти = ОбъектПечати.Представление;
			
			Если КоличествоОбъектов = 1 Тогда
				СвойстваРегистраУчета = СвойстваРегистраУчета(Форма, ТабРезультат);
			Иначе
				СвойстваРегистраУчета = СвойстваРегистраУчета(Форма, ТабРезультат, ИмяОбласти, Объект);
			КонецЕсли;
			СвойстваРегистраУчета.ПроверитьВозможностьСозданияВнутреннегоЭД = Ложь;
			
			ДанныеОтчета = Форма.Отчет;
			
			СвойстваРегистровУчета.Добавить(
				Новый Структура("СвойстваРегистраУчета, ДанныеОтчета",
				СвойстваРегистраУчета, ДанныеОтчета));
		КонецЦикла;
		ДанныеСохраненныхРегистров = 
			РегистрыУчетаВызовСервера.СохранитьРегистрыУчета(СвойстваРегистровУчета, Истина);
			
		Если ДанныеСохраненныхРегистров.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		// По данным сохраненных регистров создадим ЭД и установиим для них маршрут подписания.
		// Маршрут подписания получим, либо из настройки, либо откроем форму выбора маршрута
		ТекМаршрутПодписания = ВнутреннийЭДОВызовСервера.МаршрутИзНастройкиВнутреннегоЭДОБГУ(
			ДанныеСохраненныхРегистров[0].РегистрУчета);
		Если ЗначениеЗаполнено(ТекМаршрутПодписания) Тогда
			// Маршрут есть. Создадим документы
			ВнутреннийЭДОВызовСервера.СоздатьЭДпоДаннымРегистровУчета(
				ДанныеСохраненныхРегистров, ТекМаршрутПодписания);	
		Иначе	
			ПараметрыФормы = Новый Структура;
			ДеревоМаршрута = "";
			ПараметрыФормы.Вставить("Маршрут", ДеревоМаршрута);
			
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("ДанныеСохраненныхРегистров", ДанныеСохраненныхРегистров);
			ДопПараметры.Вставить("ПараметрыДокумента");
			ОповещениеВыборМаршрута_Завершение = Новый ОписаниеОповещения(
				"ВыборМаршрута_Завершение", ЭтотОбъект, ДопПараметры);
			ОткрытьФорму("Справочник.МаршрутыПодписанияБГУ.Форма.ВыборИзДокумента", 
				ПараметрыФормы,,,,, ОповещениеВыборМаршрута_Завершение);
		КонецЕсли;	 
	Иначе	
		СвойстваРегистраУчета = СвойстваРегистраУчета(Форма, ТабРезультат);
		СвойстваРегистраУчета.ПроверитьВозможностьСозданияВнутреннегоЭД = Истина;
		ДанныеСохранения = РегистрыУчетаВызовСервера.СохранитьРегистрУчета(СвойстваРегистраУчета, Форма.Отчет, Истина);
		
		Если ДанныеСохранения = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ПараметрыДокумента = ВнутреннийЭДОВызовСервера.ПараметрыНовогоЭлектронногоДокумента(ДанныеСохранения.РегистрУчета);
		ВнутреннийЭДОКлиент.ОткрытьФормуЭлектронногоДокумента(ПараметрыДокумента);
	КонецЕсли;	
	
КонецПроцедуры

Функция СвойстваРегистраУчета(Форма, ТабРезультат, ИмяОбласти = "", Объект = Неопределено)
	
	СвойстваРегистраУчета = Новый Структура("Организация, ПодразделениеОрганизации, ВключатьОбособленныеПодразделения,
	|НачалоПериода, КонецПериода, ВидРегистра, ТаблицаРегистра, ИспользуетсяЭП, СостояниеРегистра, ОтчетНеЗаполнен,
	|ПроверитьВозможностьСозданияВнутреннегоЭД, Объект");
	
	Если ПустаяСтрока(ИмяОбласти) Тогда
		ТаблицаРегистра = Форма[ТабРезультат];
	Иначе
		ТаблицаРегистра = РегистрыУчетаВызовСервера.ОбластьТабличногоДокументаПоИмени(Форма[ТабРезультат], ИмяОбласти);
	КонецЕсли;
	СвойстваРегистраУчета.Вставить("ТаблицаРегистра",
		ПоместитьВоВременноеХранилище(ТаблицаРегистра, Новый УникальныйИдентификатор));
	СвойстваРегистраУчета.Вставить("ИспользуетсяЭП", Форма.ИспользуетсяЭП);
	Если Форма.Элементы.Найти(ТабРезультат) = Неопределено Тогда
		СвойстваРегистраУчета.Вставить("СостояниеРегистра", Ложь);
	Иначе
		СвойстваРегистраУчета.Вставить("СостояниеРегистра", Форма.Элементы[ТабРезультат].ОтображениеСостояния.Видимость); 
	КонецЕсли;
	СвойстваРегистраУчета.Вставить("ОтчетНеЗаполнен", Форма[ТабРезультат].ШиринаТаблицы = 0);
	СвойстваРегистраУчета.Вставить("ВидРегистра", Форма.ВидРегистраУчета);
	СвойстваРегистраУчета.Вставить("Объект", Объект);
	
	Возврат СвойстваРегистраУчета;
	
КонецФункции

Процедура ВыборМаршрута_Завершение(РезультатВыбора, Параметры) Экспорт
	Если ТипЗнч(РезультатВыбора.Маршрут) = Тип("СправочникСсылка.МаршрутыПодписанияБГУ") Тогда
		МаршрутПодписания = РезультатВыбора.Маршрут;
		ВнутреннийЭДОВызовСервера.СоздатьЭДпоДаннымРегистровУчета(
			Параметры.ДанныеСохраненныхРегистров, МаршрутПодписания);	
	ИначеЕсли ТипЗнч(РезультатВыбора.Маршрут) = Тип("ДанныеФормыДерево") Тогда
		КолонкиДереваСтр = 
		"ВидПодписи, Группа, Идентификатор, ИндексКартинки, ОсновноеЗначение, 
		|Подписант, Сертификат, ЭтоСтрокаУсловия, Строки";

		МассивМаршрута = Новый Массив;
		СформироватьМассивМаршрута(РезультатВыбора.Маршрут, МассивМаршрута, КолонкиДереваСтр);
		ВнутреннийЭДОВызовСервера.СоздатьЭДпоДаннымРегистровУчета(
			Параметры.ДанныеСохраненныхРегистров, МассивМаршрута);	
	КонецЕсли;
КонецПроцедуры	

// Эмулирует дерево значений через массив структур для передаче данных типа ДанныеФормыДерево на сервер
//
// Параметры:
//  Маршрут - ДанныеФормыДерево - маршрут в виде дерева
//  МассивМаршрута - Массив - исходящий параметр. Заполняется в процедуре
//  КолонкиДереваСтр - Строка - имена колонок дерева, разделенные запятыми
Процедура СформироватьМассивМаршрута(Маршрут, МассивМаршрута, КолонкиДереваСтр)
	Строки = Маршрут.ПолучитьЭлементы();
	Если Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
		
	Для каждого Строка из Строки Цикл
		ДанныеСтроки = Новый Структура(КолонкиДереваСтр);
		ЗаполнитьЗначенияСвойств(ДанныеСтроки, Строка);
		ДанныеСтроки.Вставить("Строки", Новый Массив);
		МассивМаршрута.Добавить(ДанныеСтроки);
		СформироватьМассивМаршрута(Строка, ДанныеСтроки.Строки, КолонкиДереваСтр);
	КонецЦикла;	
КонецПроцедуры	 

Асинх Функция КонтрольНаКоличествоРегистровПройден(СписокОбъектов)
	Результат = Истина;
	
	Лимит = 20;
	КоличествоОбъектов = СписокОбъектов.Количество();
	Если КоличествоОбъектов > Лимит Тогда
		ТекстВопроса = СтрШаблон(
			НСтр("ru = 'Будут сформированы документы ""Регистр учета"" в количестве %1 шт. 
			|Это может занять длительное время. Продолжить?'"), КоличествоОбъектов);
		Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Нет);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Результат = Ложь;
		КонецЕсли;				
	КонецЕсли;
		
	Возврат Результат;	
КонецФункции	

#КонецОбласти