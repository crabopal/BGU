Процедура УдалитьСохраненныеНастройкиПоложенияФорм(Параметры) Экспорт
	Параметры.ОбработкаЗавершена = Истина;
	ВремяНачала = ТекущаяУниверсальнаяДатаВМиллисекундах();
	МаксимальноеВремяОкончания = 0;
	Если ОбщегоНазначения.ИнформационнаяБазаФайловая() Тогда
		КоличествоУдаляемыхЗаписейЗаИтерацию = 0;
		// В файловой базе время работы ограничивается 20 мин
		МаксимальноеВремяОкончания = ВремяНачала + 20 * 60 * 1000;
	Иначе
		КоличествоУдаляемыхЗаписейЗаИтерацию = 10000;
	КонецЕсли;
	
	ИменаФорм = Новый Массив;
	ИменаФорм.Добавить("Документ.ВводНачальныхОстатков.Форма.ИмуществоКазныСтрока");
	ИменаФорм.Добавить("Документ.ВводНачальныхОстатков.Форма.ОССобытияСтрока");
	ИменаФорм.Добавить("Документ.ВводНачальныхОстатков.Форма.ОССтрока");
	ИменаФорм.Добавить("Документ.ЗаданиеНаЭкспортДанныхВБанкиКС.Форма.ФормаДокумента");
	ИменаФорм.Добавить("Документ.ЗакрытиеСчетовБиотрансформации.Форма.ФормаВводаСчетаДебета");
	ИменаФорм.Добавить("Документ.ЗакрытиеСчетовПроизводственныхЗатрат");
	ИменаФорм.Добавить("Документ.ИзвещениеОНачисленииДоходов.Форма.КонструкторГрафикаПлатежей");
	ИменаФорм.Добавить("Документ.ОперацияБух.Форма.ДополнительныеДействия");
	ИменаФорм.Добавить("Документ.РегистрацияГрафиковИсполненияДоговоров.Форма.КонструкторГрафиковИсполненияДоговоров");
	ИменаФорм.Добавить("Документ.СписаниеЗатратПоУслугам.Форма.ФормаВводаСчетаДебета");
	ИменаФорм.Добавить("Обработка.ФормированиеБухгалтерскихПроводок.Форма.ФормаРазрешенияРедактирования");
	ИменаФорм.Добавить("ОбщаяФорма.ВводНесколькихДокументовНаОснованииОдного");
	ИменаФорм.Добавить("ОбщаяФорма.КонтрольИсполненияДоговоров");
	ИменаФорм.Добавить("ОбщаяФорма.НастройкаОтраженияВУчете");
	ИменаФорм.Добавить("ОбщаяФорма.ФормаЗаполненияРеквизитовТиповыхОпераций");
	ИменаФорм.Добавить("ОбщаяФорма.ФормаЦеныНДСВалюта");
	ИменаФорм.Добавить("Перечисление.ВидыОперацийИсходящееИзвещение.Форма.ФормаВыбора");
	ИменаФорм.Добавить("Справочник.БСО.Форма.НастройкаПодбора");
	ИменаФорм.Добавить("Справочник.БСО.Форма.ФормаВводаКоличества");
	ИменаФорм.Добавить("Справочник.ТиповыеОперации.Форма.ФормаПредварительногоПросмотра");
	
	ВидыФорм = Новый Массив;
	ВидыФорм.Добавить("НастройкиОкнаТонкогоКлиента");
	ВидыФорм.Добавить("НастройкиОкнаМобильногоКлиента");
	ВидыФорм.Добавить("НастройкиОкнаМобильнойПлатформы");
	
	УдаленоНастроек = 0;
	ПрерываниеПоТаймауту = Ложь;

	ТаблицаНастроек = Новый ТаблицаЗначений;
	ТаблицаНастроек.Колонки.Добавить("КлючОбъекта", Новый ОписаниеТипов("Строка"));
	ТаблицаНастроек.Колонки.Добавить("Пользователь", Новый ОписаниеТипов("Строка"));
	Выборка = ХранилищеСистемныхНастроек.Выбрать();
	Пока Истина Цикл
		Попытка
			ЕстьСледующей = Выборка.Следующий();
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Ошибка выполнения'", ОбщегоНазначения.КодОсновногоЯзыка()),
				УровеньЖурналаРегистрации.Ошибка,,,
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
			Параметры.ОбработкаЗавершена = Ложь;
			Прервать;
		КонецПопытки;
		Если Не ЕстьСледующей Тогда
			Прервать;
		КонецЕсли;
		Если Выборка.КлючНастроек <> "" Тогда
			Продолжить;
		КонецЕсли;
		ЭтоНастройкаЗаданнойФормы = Ложь;
		Для Каждого ИмяФормы Из ИменаФорм Цикл
			Если СтрНачинаетсяС(Выборка.КлючОбъекта, ИмяФормы) Тогда
				ЭтоНастройкаЗаданнойФормы = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ЭтоНастройкаЗаданнойФормы Тогда
			ЧастиИмени = СтрРазделить(Выборка.КлючОбъекта, "/");
			Если ВидыФорм.Найти(ЧастиИмени[ЧастиИмени.ВГраница()]) = Неопределено Тогда
				ЭтоНастройкаЗаданнойФормы = Ложь;
			КонецЕсли;
		КонецЕсли;
		Если Не ЭтоНастройкаЗаданнойФормы Тогда
			Продолжить;
		КонецЕсли;
		Настройка = ТаблицаНастроек.Добавить();
		Настройка.КлючОбъекта = Выборка.КлючОбъекта;
		Настройка.Пользователь = Выборка.Пользователь;
		Если КоличествоУдаляемыхЗаписейЗаИтерацию = 0 Тогда
			Если МаксимальноеВремяОкончания < ТекущаяУниверсальнаяДатаВМиллисекундах() Тогда
				ПрерываниеПоТаймауту = Истина;
				Прервать;
			КонецЕсли;
		ИначеЕсли ТаблицаНастроек.Количество() = КоличествоУдаляемыхЗаписейЗаИтерацию Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Настройка Из ТаблицаНастроек Цикл
		ХранилищеСистемныхНастроек.Удалить(Настройка.КлючОбъекта, "", Настройка.Пользователь);
		УдаленоНастроек = УдаленоНастроек + 1;
	КонецЦикла;
	
	РезультатОбработки = СтрШаблон(НСтр("ru = 'УдалитьСохраненныеНастройкиПоложенияФорм.
		|Удалено настроек: %1'"), УдаленоНастроек);
	Если ПрерываниеПоТаймауту Тогда
		РезультатОбработки = РезультатОбработки + Символы.ПС
			+ НСтр("ru = 'Прервано по истечении 20 минут.'");
	КонецЕсли;
	ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
		УровеньЖурналаРегистрации.Информация,
		,
		,
		РезультатОбработки);
	
	Если ТаблицаНастроек.Количество() < КоличествоУдаляемыхЗаписейЗаИтерацию
			Или УдаленоНастроек = 0
			Или КоличествоУдаляемыхЗаписейЗаИтерацию = 0 Тогда
		// Были выбраны все настройки
		// или за итерацию не было удалено ни одной настройки
		// или это файловая база (выполняется только одна итерация не дольше 20 мин)
		Параметры.ОбработкаЗавершена = Истина;
	Иначе
		// Необходимо проинформировать вызывающий модуль, что обработчик что-то сделал.
		// Иначе он может быть признан зациклившимся.
		ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Константы.ОсновнаяОрганизация);
		Параметры.ОбработкаЗавершена = Ложь;
	КонецЕсли;

КонецПроцедуры

