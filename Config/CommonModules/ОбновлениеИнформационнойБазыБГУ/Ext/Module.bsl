#Область ПервоначальноеЗаполнение

Процедура ВыполнитьПервоначальноеЗаполнениеОбщихДанныхИБ() Экспорт
	
	Если ПланыОбмена.ГлавныйУзел() = Неопределено Тогда	
		
		// загрузить поставляемые типовые операции
		Справочники.ПоставляемыеТиповыеОперации.ЗагрузитьЭлементы();
		
	КонецЕсли;
	
	// Загрузка правил обмена и регистрации для плана обмена БГУЗБУ2
	ОбменДаннымиСервер.ВыполнитьОбновлениеПравилДляОбменаДанными();
		
	ЗаполнитьРеквизитыКлючевыхОпераций();
	
КонецПроцедуры

Процедура ВыполнитьПервоначальноеЗаполнениеИБ() Экспорт
	
	// константы
	//Константы.ИспользоватьПолнотекстовыйПоиск.Установить(Истина);
	Константы.ИспользоватьДополнительныеРеквизитыИСведения.Установить(Истина);
	
	//Константы.КонтрольОбязательств.Установить(Перечисления.СпособыКонтроляРасходов.НетКонтроля);
	Константы.КонтрольОбязательств.Установить(Ложь);
	
	Константы.ФормированиеПроводокПриПроведенииДокумента.Установить(Истина);
	
	// В новых ИБ для классификации дебиторской и кредиторской задолженности в основном режиме
	// используются "данные графиков по договорам на дату анализа (инвентаризации) задолженности".
	// Вариант "актуальные данные графиков по договорам с контрагентами" считается устаревшим.
	Константы.ИспользоватьДанныеГрафиковПоДоговорамНаДатуАнализаЗадолженности.Установить(Истина);
	// В новых ИБ срок исполнения указывается в регистре СрокИсполненияВРегистреСрокиИсполненияИСуммыОбязательств.
	// Вариант, при котором срок исполнения указывается в карточке договора в реквизите "Окончание", считается устаревшим.
	Константы.СрокИсполненияВРегистреСрокиИсполненияИСуммыОбязательств.Установить(Истина);
	
	//Вызов функций заполнения данных для пустой информационной базы
	
	//Валюта регламентированного учета, руб
	Константы.ВалютаРегламентированногоУчета.СоздатьМенеджерЗначения().УстановитьПоУмолчанию();
	
	// НДС
	УчетНДС.УстановитьПредельноеКоличествоЗаписейВРазделеДекларацииПоНДС();
	
	Если ПланыОбмена.ГлавныйУзел() = Неопределено Тогда // В подчиненных узлах РИБ не выполняется
		
		Справочники.Журналы.ЗагрузитьЭлементы();
		
		Справочники.СтатусыОперацийНачисленияДоходов.ЗагрузитьЭлементы();
		
		// Формирование плана счетов
		ПланыСчетов.ЕПСБУ.СоздатьНовыеСчета();
		// Установить свойства предопределенных счетов
		ПланыСчетов.ЕПСБУ.ЗаполнитьПредопределенныеСчета();
		
		// Заполнение настроек печати префикса номера документов в печатных формах
		РегистрыСведений.НастройкиПечатиПрефиксаНомера.ОбновитьПереченьДокументовНастройки(Истина);
		
		// дополнительные реквизиты организаций
		УправлениеСвойствамиБГУ.ЗагрузитьЭлементыДопРеквизитовОрганизаций();
		
		// дополнительные реквизиты контрагентов
		УправлениеСвойствамиБГУ.ЗагрузитьЭлементыДопСведенийКонтрагентов();
		
		// дополнительные реквизиты договоров
		УправлениеСвойствамиБГУ.ЗагрузитьЭлементыДопСведенийДоговоров();
		
		// в последнюю очередь
		// Настройки типовых операций
		ПланыВидовХарактеристик.ДополнительныеРеквизитыОпераций.ИнициализироватьПредопределенныеЭлементыПВХ();
		Справочники.ТиповыеОперации.ОбновлениеТиповыхОпераций();
		Справочники.ПравилаЗаполненияТиповойОперацииПриВводеНаОсновании.ОбновитьДанныеСправочника();
		
		//Создание основного шаблона заполнения поля "Назначение платежа" документа "Квитанция на оплату"
		Справочники.ШаблоныЗаполненияНПКвитанцииНаОплату.СоздатьОсновнойШаблонЗаполнения();
		
		//Создание настройки актуализации по умолчанию из макета
		Справочники.НастройкаВариантовДействийАктуализацииНачислений.ЗагрузитьНастройкуИзМакета();
		
		//Загружает список видов альтернативных идентификаторов из макета
		Справочники.ВидыАльтернативныхИдентификаторовПолучателейГосуслуг.ЗагрузитьВидыАльтернативныхИдентификаторовИзМакета();
		
		// Загрузка видов операций отражения зарплаты
		Справочники.ВидыОперацийОтраженияЗарплаты.ЗаполнитьПоУмолчанию();
		
		// Загрузка поставляемых данных подсистемы "Реестр имущества"
		РеестрИмуществаСервер.ОбновитьПоставляемыеДанные(Ложь, Истина);
		
		//Создание групп для драг. материалов и заполнение предопределенных элементов в группах
		Справочники.ДрагМеталлы.НастроитьРазмещениеВГруппахПредопределенныхЭлементов();
		
		Справочники.ПричиныОтсутствияСотрудников.ЗагрузитьЭлементы();
		
	КонецЕсли;
	// Формирование плана счетов
	
	
	// Объекты взаимодействия структурных частей ЕПСБУ
	РегистрыСведений.СоответствияАналитическихСчетовКЭК.ЗагрузитьНастройки();
	Справочники.СтруктурыРПС.ЗаполнитьПредопределенныеНастройки();
	
	// Прочие справочники
	Справочники.ВидыДокументовФизическихЛиц.ЗагрузитьЭлементы();
	Справочники.Периоды.ЗагрузитьЭлементы();
	Справочники.БанковскиеСимволы.ЗагрузитьЭлементы();
	Справочники.ВидыНалоговИПлатежей.ЗаполнитьПредопределенныеЭлементы();
	Справочники.ВидыРезервов.ЗагрузитьЭлементы();
	Справочники.ВидыВыплатНаКартыМИР.ЗагрузитьЭлементы(); 
	Справочники.ПричиныОшибокПрошлыхЛет.ЗагрузитьЭлементы();
	
	Справочники.СубъектыРФ.ЗагрузитьЭлементы();
	
	РегистрыСведений.ПредельныеСрокиИсполненияПоПлатежамВБюджеты.ЗагрузитьИзМакета("СрокиИсполнения2026");
	
	// Значения по умолчанию документов/справочников
