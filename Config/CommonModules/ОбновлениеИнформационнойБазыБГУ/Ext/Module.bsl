Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию_ВерсииОбъектов(Параметры) Экспорт

	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыОтметкиОбработки();
	ДополнительныеПараметры.ЭтоНезависимыйРегистрСведений = Истина;
	ДополнительныеПараметры.ПолноеИмяРегистра = "РегистрСведений.ВерсииОбъектов";
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Т.Объект КАК Объект,
	|	Т.НомерВерсии КАК НомерВерсии
	|ИЗ
	|	РегистрСведений.ВерсииОбъектов КАК Т
	|ГДЕ
	|	Т.Объект <> НЕОПРЕДЕЛЕНО
	|	И Т.НомерВерсии = &НомерВерсии
	|	И НЕ Т.ЕстьДанныеВерсии
	|	И Т.ДатаВерсии >= &НачальнаяДатаВозможныхОшибок
	|	И Т.ТипВерсииОбъекта = ЗНАЧЕНИЕ(Перечисление.ТипыВерсийОбъекта.ИзмененоПользователем)";
	Запрос.УстановитьПараметр("НомерВерсии", 1);
	Запрос.УстановитьПараметр("НачальнаяДатаВозможныхОшибок", '20260416');
	
	Выборка = Запрос.Выполнить().Выбрать();
	ТаблицаРегистрации = РегистрыСведений.ВерсииОбъектов.СоздатьНаборЗаписей().ВыгрузитьКолонки("Объект,НомерВерсии");
	Счетчик = 0;
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаРегистрации.Добавить(), Выборка);
		Счетчик = Счетчик + 1;
		Если Счетчик = 1000 Тогда
			ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, ТаблицаРегистрации, ДополнительныеПараметры);
			Счетчик = 0;
			ТаблицаРегистрации.Очистить();
		КонецЕсли;
	КонецЦикла;

	Если Счетчик > 0 Тогда
		ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, ТаблицаРегистрации, ДополнительныеПараметры);
	КонецЕсли;

КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию_ВерсииОбъектов(Параметры) Экспорт
	ПолноеИмяОбъекта = "РегистрСведений.ВерсииОбъектов";
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	ДанныеДляОбработки = ОбновлениеИнформационнойБазы.СоздатьВременнуюТаблицуИзмеренийНезависимогоРегистраСведенийДляОбработки(
		Параметры.Очередь, ПолноеИмяОбъекта, МенеджерВременныхТаблиц);
	Параметры.ОбработкаЗавершена = Не ДанныеДляОбработки.ЕстьДанныеДляОбработки;
	Если Не ДанныеДляОбработки.ЕстьЗаписиВоВременнойТаблице Тогда
		ТекстСообщения = 
			НСтр("ru = 'Пропущена итерация обработчика обновления ""ОбновлениеИнформационнойБазыБГУ.ОбработатьДанныеДляПереходаНаНовуюВерсию_ВерсииОбъектов""
					   |Нет данных для обработки.'");
		ОбновлениеИнформационнойБазы.ЗаписатьСобытиеВЖурналРегистрации(
			ТекстСообщения,
			УровеньЖурналаРегистрации.Информация,
			Параметры);
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВТДляОбработкиВерсииОбъектов.Объект КАК Объект,
	|	ВТДляОбработкиВерсииОбъектов.НомерВерсии КАК НомерВерсии,
	|	Т.Объект ЕСТЬ НЕ NULL  КАК ВерсияСуществует,
	|	ЕСТЬNULL(Т.ЕстьДанныеВерсии, ЛОЖЬ) КАК ЕстьДанныеВерсии,
	|	ЕСТЬNULL(Т.ТипВерсииОбъекта, ЗНАЧЕНИЕ(Перечисление.ТипыВерсийОбъекта.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.ТипыВерсийОбъекта.ИзмененоПользователем) КАК ИзмененоПользователем
	|ИЗ
	|	#ВТДляОбработки КАК ВТДляОбработкиВерсииОбъектов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВерсииОбъектов КАК Т
	|		ПО ВТДляОбработкиВерсииОбъектов.Объект = Т.Объект
	|			И ВТДляОбработкиВерсииОбъектов.НомерВерсии = Т.НомерВерсии";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "#ВТДляОбработки", ДанныеДляОбработки.ИмяВременнойТаблицы);
	Выборка = Запрос.Выполнить().Выбрать();
	КоличествоУспешных = 0;
	КоличествоОшибок = 0;

	// Таблица для отметки обработки излишне зарегистрированных записей
	ОбрабатываемыеДанные = Новый ТаблицаЗначений;
	ОбрабатываемыеДанные.Колонки.Добавить("Объект");
	ОбрабатываемыеДанные.Колонки.Добавить("НомерВерсии");

	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыОтметкиОбработки();
	ДополнительныеПараметры.ЭтоНезависимыйРегистрСведений = Истина;
	ДополнительныеПараметры.ПолноеИмяРегистра = ПолноеИмяОбъекта;
		
	Пока Выборка.Следующий() Цикл
		
		ОбрабатываемыеДанные.Очистить();
		ОбработкаУспешная = Ложь;
		НачатьТранзакцию();
		Попытка
			
			Если Выборка.Объект = Неопределено Тогда
				ТребуетсяОбработка = Ложь;
				МетаданныеОбъекта = Неопределено;
			Иначе
				МетаданныеОбъекта = Выборка.Объект.Метаданные(); // ОбъектМетаданных
				
				// Проверять нужно только записи документов, поддерживающих отдельную дату проведения, у которых 
				// не записаны данные версии
				ТребуетсяОбработка = Выборка.ВерсияСуществует
					И Не Выборка.ЕстьДанныеВерсии
					И ОбщегоНазначения.ЭтоДокумент(МетаданныеОбъекта)
					И Метаданные.ОпределяемыеТипы.ДокументыСОтдельнойДатойПроведения.Тип.СодержитТип(ТипЗнч(Выборка.Объект));
			КонецЕсли;
			
			Если ТребуетсяОбработка Тогда
				Блокировка = Новый БлокировкаДанных;
				ЭлементБлокировки = Блокировка.Добавить(МетаданныеОбъекта.ПолноеИмя());
				ЭлементБлокировки.УстановитьЗначение("Ссылка", Выборка.Объект);
				ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ВерсииОбъектов");
				ЭлементБлокировки.УстановитьЗначение("Объект", Выборка.Объект);
				ЭлементБлокировки.УстановитьЗначение("НомерВерсии", Выборка.НомерВерсии);
				
				Блокировка.Заблокировать();
			
				// Если объект существует в базе, значит запись не нужно удалять.
				Если ОбщегоНазначения.СсылкаСуществует(Выборка.Объект) Тогда
					ТребуетсяОбработка = Ложь;
				КонецЕсли;
			КонецЕсли;
									
			Если ТребуетсяОбработка Тогда
				// Дополнительная проверка набора после установки блокировки.
				НаборЗаписей = РегистрыСведений.ВерсииОбъектов.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.Объект.Установить(Выборка.Объект, Истина);
				НаборЗаписей.Отбор.НомерВерсии.Установить(Выборка.НомерВерсии, Истина);
				НаборЗаписей.Прочитать();
				
				// Если нет записи, соответствующей условиям, то не нужно удалять.
				Если НаборЗаписей.Количество() = 0
					Или НаборЗаписей[0].ЕстьДанныеВерсии
					Или НаборЗаписей[0].ТипВерсииОбъекта <> Перечисления.ТипыВерсийОбъекта.ИзмененоПользователем Тогда
					ТребуетсяОбработка = Ложь;
				КонецЕсли;
			КонецЕсли;
			
			Если ТребуетсяОбработка Тогда
				ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей, РежимЗамещения.Удаление);
			Иначе
				ЗаполнитьЗначенияСвойств(ОбрабатываемыеДанные.Добавить(),  Выборка);
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(ОбрабатываемыеДанные, ДополнительныеПараметры);
			КонецЕсли;
			ОбработкаУспешная = Истина;
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ОбработкаУспешная = Ложь;
			Если МетаданныеОбъекта = Неопределено Тогда
				МетаданныеОбъекта = Метаданные.РегистрыСведений.ВерсииОбъектов;
			КонецЕсли;
			ОбновлениеИнформационнойБазы.ЗаписатьОшибкуВЖурналРегистрации(МетаданныеОбъекта, , ИнформацияОбОшибке(),
				УровеньЖурналаРегистрации.Ошибка);
		КонецПопытки;
		
		Если ОбработкаУспешная Тогда
			КоличествоУспешных = КоличествоУспешных + 1;
		Иначе
			КоличествоОшибок = КоличествоОшибок + 1;
		КонецЕсли;
	КонецЦикла;
	
	ТекстСообщения = СтрШаблон(
		НСтр("ru = 'Выполнена порция обработчика обновления ""ОбновлениеИнформационнойБазыБГУ.ОбработатьДанныеДляПереходаНаНовуюВерсию_ВерсииОбъектов""
				   |Обработано: %1,
				   |Ошибок: %2'"),
		КоличествоУспешных, КоличествоОшибок);
	ОбновлениеИнформационнойБазы.ЗаписатьСобытиеВЖурналРегистрации(
		ТекстСообщения,
		УровеньЖурналаРегистрации.Информация,
		Параметры);
	Параметры.ОбработкаЗавершена = Не ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Параметры.Очередь,
		ПолноеИмяОбъекта);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

