Процедура ЗаполнитьОКОПФ() Экспорт  
	
	// В момент обновления ОКОПФ может быть еще не получен из ИПП.
	// Заполняем по макетам для переноса данных
	
	Макеты = Новый Массив;
	Макеты.Добавить(Справочники.ОПФ.ПолучитьМакет("ОПФ")); 
	Макеты.Добавить(Справочники.ОПФ.ПолучитьМакет("ОПФ2026"));  
	
	Для Каждого Макет Из Макеты Цикл
		ОбластьКод = Макет.ПолучитьОбласть("Код");
		ОбластьНаименование = Макет.ПолучитьОбласть("Наименование");  
		н = 1;
		Пока (Истина) Цикл
			н = н + 1;
			ТекКод = СокрЛП(ОбластьКод.Область(н, 1).Текст);  
			ТекНаименование = СокрЛП(ОбластьНаименование.Область(н, 1).Текст);
			Если НЕ ЗначениеЗаполнено(ТекКод) Тогда
				Прервать;
			КонецЕсли;  
			ТекСсылка = Справочники.ОбщероссийскийКлассификаторОрганизационноПравовыхФорм.НайтиПоКоду(ТекКод);
			Если ТекСсылка.Пустая() Тогда
            	ТекОбъект = Справочники.ОбщероссийскийКлассификаторОрганизационноПравовыхФорм.СоздатьЭлемент();
			Иначе 
				ТекОбъект = ТекСсылка.ПолучитьОбъект();
			КонецЕсли;
			ТекОбъект.НаименованиеПолное = ТекНаименование; 
			ТекОбъект.Код = ТекКод;
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ТекОбъект);
		КонецЦикла;
	КонецЦикла;	
	
КонецПроцедуры	

Процедура ЗаполнитьОКОПФВКонтрагентах() Экспорт    
	
	ПВХКодОПФ = ПредопределенноеЗначение("ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения.КодОПФ").ПолучитьОбъект();
	ПВХКодОПФ.Наименование = "(Не используется) Код ОПФ";
	ПВХКодОПФ.Заголовок = "(Не используется) Код ОПФ";
	ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ПВХКодОПФ);
	
	УправлениеСвойствамиБГУ.ЗагрузитьЭлементыДопСведенийКонтрагентов();
	НаборКонтрагенты = УправлениеСвойствами.НаборСвойствПоИмени("Справочник_Контрагенты");
	ОбъектНабор = НаборКонтрагенты.ПолучитьОбъект();
	СтрокаСтарогоОПФ = ОбъектНабор.ДополнительныеРеквизиты.НайтиСтроки(Новый Структура("Свойство", ПредопределенноеЗначение("ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения.КодОПФ")));
	Если СтрокаСтарогоОПФ.Количество() > 0 Тогда
		СтрокаСтарогоОПФ = СтрокаСтарогоОПФ[0];
		Смещение = ОбъектНабор.ДополнительныеРеквизиты.Количество() - СтрокаСтарогоОПФ.НомерСтроки;
		Если Смещение > 0 Тогда
			ОбъектНабор.ДополнительныеРеквизиты.Сдвинуть(СтрокаСтарогоОПФ, Смещение); 
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ОбъектНабор);
		КонецЕсли;
	КонецЕсли;
	
	ТекРеквизит = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.КодОПФ;
	ДопРеквизитОбъект = ТекРеквизит.ПолучитьОбъект();
    ДопРеквизитОбъект.Виден = Ложь;
	ДопРеквизитОбъект.Доступен = Ложь;   
	ДопРеквизитОбъект.Заголовок = ДопРеквизитОбъект.Наименование;
	ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДопРеквизитОбъект);	
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ
	|	КонтрагентыДополнительныеРеквизиты.Ссылка КАК Контрагент,
	|	ОбщероссийскийКлассификаторОрганизационноПравовыхФорм.Ссылка КАК НовыйОКОПФ
	|ИЗ
	|	Справочник.Контрагенты.ДополнительныеРеквизиты КАК КонтрагентыДополнительныеРеквизиты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОбщероссийскийКлассификаторОрганизационноПравовыхФорм КАК ОбщероссийскийКлассификаторОрганизационноПравовыхФорм
	|		ПО КонтрагентыДополнительныеРеквизиты.Значение.Код = ОбщероссийскийКлассификаторОрганизационноПравовыхФорм.Код
	|ГДЕ
	|	КонтрагентыДополнительныеРеквизиты.Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения.КодОПФ)
	|	И НЕ (ВЫРАЗИТЬ(КонтрагентыДополнительныеРеквизиты.Значение КАК Справочник.ОПФ)) = ЗНАЧЕНИЕ(Справочник.ОПФ.ПустаяСсылка)"); 
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл 
		Если ЗначениеЗаполнено(Выборка.НовыйОКОПФ) Тогда
			Свойства = Новый Соответствие;
			Свойства.Вставить(ПредопределенноеЗначение("ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения.КодОПФ"), ПредопределенноеЗначение("Справочник.ОПФ.ПустаяСсылка"));
			Свойства.Вставить(ПредопределенноеЗначение("ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения.КодПоОКОПФ"), Выборка.НовыйОКОПФ);
			КонтрагентОбъект = Выборка.Контрагент.ПолучитьОбъект();
			УправлениеСвойствами.УстановитьСвойстваУОбъекта(КонтрагентОбъект, Свойства);
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(КонтрагентОбъект);
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры	  

Процедура ЗаполнитьОКОПФВОрганизациях() Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Организации.Ссылка КАК Организация,
	|	ОбщероссийскийКлассификаторОрганизационноПравовыхФорм.Ссылка КАК НовыйОКОПФ
	|ИЗ
	|	Справочник.Организации КАК Организации
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОбщероссийскийКлассификаторОрганизационноПравовыхФорм КАК ОбщероссийскийКлассификаторОрганизационноПравовыхФорм
	|		ПО Организации.УдалитьКодКОПФ.Код = ОбщероссийскийКлассификаторОрганизационноПравовыхФорм.Код
	|ГДЕ
	|	НЕ Организации.УдалитьКодКОПФ = ЗНАЧЕНИЕ(Справочник.ОПФ.ПустаяСсылка)");
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл 
		Если ЗначениеЗаполнено(Выборка.НовыйОКОПФ) Тогда
			ОрганизацияОбъект = Выборка.Организация.ПолучитьОбъект();
			ОрганизацияОбъект.КодКОПФ = Выборка.НовыйОКОПФ;
			ОрганизацияОбъект.УдалитьКодКОПФ = ПредопределенноеЗначение("Справочник.ОПФ.ПустаяСсылка");   
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ОрганизацияОбъект);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры	

