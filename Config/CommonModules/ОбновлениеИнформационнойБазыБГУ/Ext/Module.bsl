#Область СлужебныеПроцедурыИспользуемыеДругимиОбработчиками


// Функция проверяет существование объекта и неизменность версии объекта.
// Используется в отложенных обработчиках, когда ссылки для обработки получаются
// с использованием временной таблицы, возвращаемой функцией
// ОбновлениеИнформационнойБазы.СоздатьВременнуюТаблицуСсылокДляОбработки.
// Между чтением в запросе и началом обработки объект может быть изменен
// или удален пользователем.
// Контроль версии объекта позволяет не блокировать всю порцию обрабатываемых объектов.
//
// Если объект удален или изменен, то удаляется регистрация из плана обмена для обновления.
//
// Параметры:
//  Ссылка		 - ЛюбаяСсылка - проверяемая ссылка.
//  ВерсияДанных - Строка - версия данных объекта, прочитанная из базы.
// 
// Возвращаемое значение:
// ЛюбойОбъект, Неопределено - полученный объект. Если объект удален или изменен, то Неопределено.
//
Функция ПроверитьПолучитьОбъект(Ссылка,ВерсияДанных) Экспорт
	
	Объект = Ссылка.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Ссылка);
		Возврат Неопределено;
	КонецЕсли;
	Если Объект.ВерсияДанных <> ВерсияДанных Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Объект;
	
КонецФункции

Процедура СообщитьОНеудачнойБлокировке(Ссылка) Экспорт
	ТекстСообщения = НСтр("ru = 'Не удалось заблокировать объект: %Объект% по причине: %Причина%'");
	ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Объект%", Ссылка);
	ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
							УровеньЖурналаРегистрации.Предупреждение,
							Ссылка.Метаданные(),
							Ссылка,
							ТекстСообщения);
КонецПроцедуры

Процедура СообщитьОНеудачнойОбработке(Ссылка, Знач ПредставлениеСсылки = Неопределено) Экспорт
	Если ПредставлениеСсылки = Неопределено Тогда
		ПредставлениеСсылки = Строка(Ссылка);
	КонецЕсли;
	ТекстСообщения = НСтр("ru = 'Не удалось обработать объект: %Объект% по причине: %Причина%'");
	ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Объект%", ПредставлениеСсылки);
	ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
							УровеньЖурналаРегистрации.Предупреждение,
							Ссылка.Метаданные(),
							Ссылка,
							ТекстСообщения);
КонецПроцедуры


