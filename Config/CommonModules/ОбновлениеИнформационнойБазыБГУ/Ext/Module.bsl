		|	НастройкиРасчетовПоРодительскойПлатеНастройки.ПредставлениеФормулы КАК ПредставлениеФормулы
		|ИЗ
		|	Справочник.НастройкиРасчетовПоРодительскойПлате.Настройки КАК НастройкиРасчетовПоРодительскойПлатеНастройки
		|ГДЕ
		|	НастройкиРасчетовПоРодительскойПлатеНастройки.НомерСтроки = 1";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ТекущееПредставлениеФормулы = СокрЛП(ВыборкаДетальныеЗаписи.ПредставлениеФормулы);
		НовоеПредставлениеФормулы   = СтрЗаменить(ТекущееПредставлениеФормулы, 
			"РасчетыПоРодительскойПлате.СуммаФактическойОплаты(НАЧАЛОПЕРИОДА(&Период.ДатаНачала,""МЕСЯЦ""),КОНЕЦПЕРИОДА(&Период.ДатаОкончания,""МЕСЯЦ"")",
			"РасчетыПоРодительскойПлате.СуммаФактическойОплаты(НачалоПериода,КонецПериода");
		
		Если ТекущееПредставлениеФормулы <> НовоеПредставлениеФормулы Тогда
			
			НастройкаОбъект                                   = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
			НастройкаОбъект.Настройки[0].ПредставлениеФормулы = НовоеПредставлениеФормулы;
			НастройкаОбъект.Настройки[0].Схема                = Новый ХранилищеЗначения(
				Справочники.НастройкиРасчетовПоРодительскойПлате.СхемаДляВыпискиКвитанций(НовоеПредставлениеФормулы));
			
			ОбновлениеИнформационнойБазы.ЗаписатьДанные(НастройкаОбъект);
		
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

