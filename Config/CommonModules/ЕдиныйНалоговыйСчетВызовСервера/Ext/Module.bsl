
#Область СлужебныйПрограммныйИнтерфейс

Функция ДанныеПечатиУведомления(Ссылка) Экспорт
	
	ДанныеПечатиУведомления = НовыеДанныеПечатиУведомления();

	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, "Уведомление,РазрешитьРедактированиеУведомления");
	Реквизиты          = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыДокумента.Уведомление, "Ссылка,ВидУведомления,Организация");
	ДанныеПечатиУведомления.УведомленияДляПечати = Реквизиты.Ссылка;
	
	СписокПечатаемыхЛистов = УведомлениеОСпецрежимахНалогообложенияВызовСервера.ПечатьУведомленияБРО(Реквизиты.Ссылка);
	Для Каждого Элт Из СписокПечатаемыхЛистов Цикл 
		ЗначениеДляМодификации = Элт.Значение;
		ТабДок = ПолучитьИзВременногоХранилища(ЗначениеДляМодификации[0]);
		УИД = Новый УникальныйИдентификатор;
		ЗначениеДляМодификации[0] = ПоместитьВоВременноеХранилище(ТабДок, УИД);
		ЗначениеДляМодификации[1] = УИД;
	КонецЦикла;
	ДанныеПечатиУведомления.Вставить("СписокПечатаемыхЛистов", СписокПечатаемыхЛистов);

	ДанныеПечатиУведомления.ДополнительныеПараметры.Вставить("ЗаголовокФормы",
		СтрШаблон("%1 (%2)", Реквизиты.ВидУведомления, Реквизиты.Организация));
		
	Если Не РеквизитыДокумента.РазрешитьРедактированиеУведомления Тогда
		ДанныеПечатиУведомления.ПоследнийЦиклОбмена = ПоследнийЦиклОбмена(Реквизиты);
	КонецЕсли;	

	Возврат ДанныеПечатиУведомления;

КонецФункции

Функция ПараметрыОткрытияОСВРасшифровкаСальдоЕНП(Знач Организация, Знач ДатаАктуальности) Экспорт
	
	СчетЕНП        = БухгалтерскийУчет.СчетПоКоду("303.14");
	СвойстваСчета  = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетЕНП);
	ВсяОрганизация = Справочники.Организации.ВсяОрганизация(Организация);
	
	ПользовательскиеНастройки = Новый ПользовательскиеНастройкиКомпоновкиДанных;
	
	ДополнительныеСвойства = ПользовательскиеНастройки.ДополнительныеСвойства;
	
	ДополнительныеСвойства.Вставить("НачалоПериода", НачалоГода(ДатаАктуальности));
	ДополнительныеСвойства.Вставить("КонецПериода",  КонецДня(ДатаАктуальности));
	ДополнительныеСвойства.Вставить("Счет",          СчетЕНП);
	
	Если ВсяОрганизация.Количество() = 1 Тогда
		ДополнительныеСвойства.Вставить("Организация", Организация);
	КонецЕсли;
	
	ДополнительныеСвойства.Вставить("ПоСубсчетам",               Истина);
	ДополнительныеСвойства.Вставить("ПоказательБУ",              Истина);
	ДополнительныеСвойства.Вставить("ПоказательНеУчитываетсяНУ", Ложь);
	ДополнительныеСвойства.Вставить("ПоказательЕНВД",            Ложь);
	ДополнительныеСвойства.Вставить("ПоказательНДС",             Ложь);
	ДополнительныеСвойства.Вставить("ПоказательВалютнаяСумма",   Ложь);
	ДополнительныеСвойства.Вставить("ПоказательКоличество",      Ложь);
	
	Группировка = Новый Массив;
	
	Если ВсяОрганизация.Количество() > 1 Тогда
		
		ОписаниеГруппировки = Новый Структура;
		ОписаниеГруппировки.Вставить("Использование",  Истина);
		ОписаниеГруппировки.Вставить("Поле",           "Организация");
		ОписаниеГруппировки.Вставить("Представление",  "Организация");
		ОписаниеГруппировки.Вставить("ТипГруппировки", 0);
		Группировка.Добавить(ОписаниеГруппировки);
		
		Отбор = ПользовательскиеНастройки.Элементы.Добавить(Тип("ОтборКомпоновкиДанных"));
		Отбор.ИдентификаторПользовательскойНастройки = "Отбор";
		
		СписокОтбора = Новый СписокЗначений;
		СписокОтбора.ЗагрузитьЗначения(ВсяОрганизация);
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(Отбор, "Организация", СписокОтбора,
			ВидСравненияКомпоновкиДанных.ВСписке);
		
	КонецЕсли;
	
	Для Счетчик = 1 По СвойстваСчета.КоличествоСубконто Цикл
		ОписаниеГруппировки = Новый Структура;
		ОписаниеГруппировки.Вставить("Использование",  Истина);
		ОписаниеГруппировки.Вставить("Поле",           "Субконто" + Счетчик);
		ОписаниеГруппировки.Вставить("Представление",  СвойстваСчета["ВидСубконто" + Счетчик].Наименование);
		ОписаниеГруппировки.Вставить("ТипГруппировки", 0);
		Группировка.Добавить(ОписаниеГруппировки);
	КонецЦикла;

	ДополнительныеСвойства.Вставить("Группировка",      Группировка);

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимРасшифровки",          Истина);
	ПараметрыФормы.Вставить("ВидРасшифровки",            2);
	ПараметрыФормы.Вставить("СформироватьПриОткрытии",   Истина);
	ПараметрыФормы.Вставить("ПользовательскиеНастройки", ПользовательскиеНастройки);
	
    Возврат ПараметрыФормы;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыеДанныеПечатиУведомления()
	
	Результат = Новый Структура;
	Результат.Вставить("УведомленияДляПечати");
	Результат.Вставить("СписокПечатаемыхЛистов");
	Результат.Вставить("ДополнительныеПараметры", Новый Структура);
	Результат.Вставить("ПоследнийЦиклОбмена",     Неопределено);
	
	Возврат Результат;
	
КонецФункции

Функция ПоследнийЦиклОбмена(Реквизиты)

	КонтролирующийОрган = ?(УведомлениеОСпецрежимахНалогообложенияПовтИсп.ВидыУведомленийВФНС()[Реквизиты.ВидУведомления] = Истина,
		Перечисления.ТипыКонтролирующихОрганов.ФНС, Неопределено);
		
	СтатусОтправки 			 = Неопределено;
	СостояниеСдачиОтчетности = Неопределено;
	ТекущееСостояние 		 = Неопределено;
	ЦиклОбмена 				 = Неопределено;
	ПоследнийЦиклОбмена 	 = Неопределено;
	
	ЭлектронныйДокументооборотСКонтролирующимиОрганами.ОпределитьСтатусИСостояниеСдачиОтчетности(
		Реквизиты.Ссылка, Реквизиты.Организация, КонтролирующийОрган, СостояниеСдачиОтчетности, СтатусОтправки);
	СтатусОтправкиВЖурнале = УведомлениеОСпецрежимахНалогообложения.СохраненныйСтатусОтправкиУведомления(Реквизиты);
	
	МожноПечататьСЭЦП = СтрНачинаетсяС(СтатусОтправки, "Сдано")
		И СостояниеСдачиОтчетности = Перечисления.СостояниеСдачиОтчетности.ПоложительныйРезультатДокументооборота
		И СтрНайти(СтатусОтправки, СтатусОтправкиВЖурнале) = 1;
		
	Если МожноПечататьСЭЦП Тогда 
		ТекущееСостояние = РегламентированнаяОтчетность.ТекущееСостояниеОтправки(Реквизиты.Ссылка, КонтролирующийОрган);
		ЦиклОбмена = ДокументооборотСКОВызовСервера.ПолучитьПоследнийЦиклОбмена(Реквизиты.Ссылка);
	КонецЕсли;
	
	Если ТекущееСостояние <> Неопределено И ЗначениеЗаполнено(ЦиклОбмена) Тогда
		ПоследнийЦиклОбмена = ЦиклОбмена;
	КонецЕсли;
	
    Возврат ПоследнийЦиклОбмена;
	
КонецФункции

#КонецОбласти

