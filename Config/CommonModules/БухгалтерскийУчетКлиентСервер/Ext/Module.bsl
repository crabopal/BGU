// Устарела. Следует использовать БухгалтерскийУчет.СчетВИерархии
// Проверяет принадлежность счета иерархии, заданной параметром Эталон.
//
// Параметры:
//	Счет - ПланСчетовСсылка - счет, который необходимо проверить.
//	Эталон - Строка, Массив, ПланСчетовСсылка - иерархия счетов.
//
// Пример:
//	БухгалтерскийУчетКлиентСервер.СчетВИерархии(Счет, "206.00, 302.00")
// 
// Возвращаемое значение:
//	Булево
// 
Функция СчетВИерархии(Счет, Эталон) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Счет) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТипЗнчЭталон = ТипЗнч(Эталон);
	Если ТипЗнчЭталон = Тип("Строка") Тогда
		
		Возврат (БухгалтерскийУчетВызовСервераПовтИсп.СписокСчетов(Эталон).Найти(Счет) <> Неопределено);
		
	ИначеЕсли ТипЗнчЭталон = Тип("СписокЗначений") Тогда // Приведем к простому типу для кэширования.
		
		СчетаКэш = Новый Структура;
		Для Каждого Счет Из Эталон Цикл
			СчетаКэш.Вставить("Счет" + Эталон.Индекс(Счет), Счет.Значение);
		КонецЦикла;
		Возврат (БухгалтерскийУчетВызовСервераПовтИсп.СписокСчетов(СчетаКэш).Найти(Счет) <> Неопределено);
		
	ИначеЕсли ТипЗнчЭталон = Тип("Массив") Тогда // Приведем к простому типу для кэширования.
		
		СчетаКэш = Новый Структура;
		Для Индекс = 0 По Эталон.Количество() - 1 Цикл
			СчетаКэш.Вставить("Счет" + Индекс, Эталон[Индекс]);
		КонецЦикла;
		Возврат (БухгалтерскийУчетВызовСервераПовтИсп.СписокСчетов(СчетаКэш).Найти(Счет) <> Неопределено);
		
	ИначеЕсли ТипЗнчЭталон = Тип("ПланСчетовСсылка.ЕПСБУ") Тогда
		
		Возврат Счет = Эталон ИЛИ Счет.ПринадлежитЭлементу(Эталон);
		
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

