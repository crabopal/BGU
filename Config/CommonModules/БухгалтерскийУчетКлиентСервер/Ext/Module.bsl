 #Область СлужебныеПроцедурыИФункции

Функция СубконтоЗаполняетсяАвтоматически(Счет, НомерСубконто, Знач СвойстваСчета = Неопределено)
	
	Если СвойстваСчета = Неопределено Тогда
		СвойстваСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(Счет);
	КонецЕсли;
	
	ВидСубконто = СвойстваСчета["ВидСубконто" + НомерСубконто];
	Если ВидСубконто = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.Партии")
	   И БухгалтерскийУчетКлиентСервер.СчетВИерархии(Счет, "105.00") Тогда
		// Партионный учет на счетах 105.ХХ ведется автоматически, субконто "Партии" не нужно указывать.
		Возврат Истина;
	ИначеЕсли ВидСубконто = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.ДокументыРасчетов")
	   И БухгалтерскийУчетКлиентСервер.СчетВИерархии(Счет, "206.00") Тогда
		// В случае аванса поставщику документом расчетов будет являться сам документ аванса.
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Процедура ДополнитьПредставлениеКоличественногоСубконто(ЗначениеСубконто, ПредставлениеСубконто, СвойстваСчета, ПараметрыОбъекта)
	
	Если НЕ СвойстваСчета.Количественный Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ПараметрыОбъекта.Свойство("Количество") ИЛИ ПараметрыОбъекта.Количество = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ЗначениеСубконто) ИЛИ ТипЗнч(ЗначениеСубконто) <> Тип("СправочникСсылка.Номенклатура") Тогда
		Возврат;
	КонецЕсли;
	
	ПредставлениеСубконто = ПредставлениеСубконто
		+ " ("
		+ Строка(ПараметрыОбъекта.Количество)
		+ ?(ПараметрыОбъекта.Свойство("ЕдиницаИзмерения") И ЗначениеЗаполнено(ПараметрыОбъекта.ЕдиницаИзмерения),
				" " + Строка(ПараметрыОбъекта.ЕдиницаИзмерения),
				"")
		+ ")";
	
КонецПроцедуры

// Конструктор свойств счета и аналитики счета, используемых для установки параметров выбора субконто.
// 
// Возвращаемое значение:
//  Структура - Имена полей формы:
// * ПоляФормы - Структура:
//   ** Субконто1 - Строка
//   ** Субконто2 - Строка
//   ** Субконто3 - Строка
// * ПоляОбъекта - Структура - Имена полей объекта:
//   ** СчетУчета - Строка
//   ** Субконто1 - Строка
//   ** Субконто2 - Строка
//   ** Субконто3 - Строка
// * ДопРеквизиты - Структура
//
Функция НовыеПараметрыУстановкиСвойствСубконто()
	
	Результат = Новый Структура;
	
	ПоляФормы = Новый Структура;
	ПоляФормы.Вставить("Субконто1");
	ПоляФормы.Вставить("Субконто2");
	ПоляФормы.Вставить("Субконто3");
	Результат.Вставить("ПоляФормы", ПоляФормы);
	
	ПоляОбъекта = Новый Структура;
	ПоляОбъекта.Вставить("СчетУчета", "СчетУчета");
	ПоляОбъекта.Вставить("Субконто1");
	ПоляОбъекта.Вставить("Субконто2");
	ПоляОбъекта.Вставить("Субконто3");
	Результат.Вставить("ПоляОбъекта", ПоляОбъекта);
	
	ДопРеквизиты = Новый Структура;
	Результат.Вставить("ДопРеквизиты", ДопРеквизиты);
	
	Возврат Результат;
	
КонецФункции

Функция ДанныеУстановкиПараметровСубконто(Объект, ПараметрыУстановки)
	
	Результат = Новый Структура;
	
	ПоляОбъекта  = ПараметрыУстановки.ПоляОбъекта;
	ДопРеквизиты = ПараметрыУстановки.ДопРеквизиты;
	
	Для Индекс = 1 По 3 Цикл
		Если НЕ ЗначениеЗаполнено(ПоляОбъекта["Субконто" + Индекс]) Тогда
			Продолжить;
		КонецЕсли;
		ЗначениеСубконто = Объект[ПоляОбъекта["Субконто" + Индекс]];
		ТипСубконто = ТипЗнч(ЗначениеСубконто);
		Если ТипСубконто = Тип("СправочникСсылка.Контрагенты") Тогда
			Результат.Вставить("Контрагент", ЗначениеСубконто);
		ИначеЕсли ТипСубконто = Тип("СправочникСсылка.ВидыНалоговИПлатежей") Тогда
			Результат.Вставить("ВидНалогаИлиПлатежа", ЗначениеСубконто);
		ИначеЕсли ТипСубконто = Тип("СправочникСсылка.ВидыДенежныхДокументов") Тогда
			Результат.Вставить("ВидДенежногоДокумента", ЗначениеСубконто);
		ИначеЕсли ТипСубконто = Тип("СправочникСсылка.БСО") Тогда
			Результат.Вставить("БСО", ЗначениеСубконто);
		КонецЕсли;
		Если Индекс = 1 Тогда
			Результат.Вставить("Субконто1", ЗначениеСубконто);
		КонецЕсли;
	КонецЦикла;
	Результат.Вставить("СчетУчета", Объект[ПоляОбъекта.СчетУчета]);
	
	Для каждого ДопРеквизит Из ДопРеквизиты Цикл
		Результат.Вставить(ДопРеквизит.Ключ, ДопРеквизит.Значение);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура УстановитьПараметрыВыбораСубконто(Форма, Объект, ПараметрыУстановки, ДанныеОбъекта)
	
	Элементы = Форма.Элементы;
	
	ПоляОбъекта = ПараметрыУстановки.ПоляОбъекта;
	ПоляФормы   = ПараметрыУстановки.ПоляФормы;
	
	ВидыПараметров = Новый Соответствие;
	ДобавитьВидыПараметровСвязьПоОрганизации(ВидыПараметров);
	
	ВидыПараметров.Вставить(Тип("СправочникСсылка.Договоры"), 					"Договоры");
	ВидыПараметров.Вставить(Тип("СправочникСсылка.РазделыЛицевыхСчетов"), 		"РазделыЛицевыхСчетов");
	ВидыПараметров.Вставить(Тип("СправочникСсылка.НалогиИПлатежиОрганизации"), 	"НалогиИПлатежиОрганизации");
	ВидыПараметров.Вставить(Тип("СправочникСсылка.ДенежныеДокументы"), 			"ДенежныеДокументы");
	ВидыПараметров.Вставить(Тип("СправочникСсылка.РасходыУСН"), 				"РасходыУСН");
	ВидыПараметров.Вставить(Тип("СправочникСсылка.ДополнительнаяБюджетнаяКлассификация"),
		"ДополнительнаяБюджетнаяКлассификация");
	ВидыПараметров.Вставить(Тип("СправочникСсылка.СерииБСО"), 					"СерииБСО");
	ВидыПараметров.Вставить(Тип("СправочникСсылка.Субконто"), 					"Субконто");
	
	Для Индекс = 1 По 3 Цикл
		Если НЕ ЗначениеЗаполнено(ПоляФормы["Субконто" + Индекс])
			ИЛИ НЕ ЗначениеЗаполнено(ПоляОбъекта["Субконто" + Индекс]) Тогда
			Продолжить;
		КонецЕсли;
		
		ЭлементФормыСубконто = Элементы.Найти(ПоляФормы["Субконто" + Индекс]);
		Если ЭлементФормыСубконто = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ТипСубконто   = ТипЗнч(Объект[ПоляОбъекта["Субконто" + Индекс]]);
		ВидПараметров = ВидыПараметров[ТипСубконто];
		Если ВидПараметров <> Неопределено Тогда
			
			МассивПараметров = Новый Массив();
			Если ВидПараметров = "Организация" Тогда
				Если ДанныеОбъекта.Свойство("Организация") Тогда
					МассивПараметров.Добавить(Новый ПараметрВыбора("Отбор.Организация", ДанныеОбъекта.Организация));
				КонецЕсли;
			ИначеЕсли ВидПараметров = "Владелец" Тогда
				Если ДанныеОбъекта.Свойство("Организация") Тогда
					МассивПараметров.Добавить(Новый ПараметрВыбора("Отбор.Владелец", ДанныеОбъекта.Организация));
				КонецЕсли;
			ИначеЕсли ВидПараметров = "Договоры" Тогда
				Если ДанныеОбъекта.Свойство("Организация") Тогда
					МассивПараметров.Добавить(Новый ПараметрВыбора("Отбор.Организация", ДанныеОбъекта.Организация));
				КонецЕсли;
				Если ДанныеОбъекта.Свойство("Контрагент") Тогда
					МассивПараметров.Добавить(Новый ПараметрВыбора("Отбор.Контрагент", ДанныеОбъекта.Контрагент));
				КонецЕсли;
			ИначеЕсли ВидПараметров = "РазделыЛицевыхСчетов" Тогда
				Если ДанныеОбъекта.Свойство("Организация") Тогда
					МассивПараметров.Добавить(Новый ПараметрВыбора("Отбор.Организация", ДанныеОбъекта.Организация));
				КонецЕсли;
			ИначеЕсли ВидПараметров = "НалогиИПлатежиОрганизации" Тогда
				Если ДанныеОбъекта.Свойство("Организация") Тогда
					МассивПараметров.Добавить(Новый ПараметрВыбора("Отбор.Владелец", ДанныеОбъекта.Организация));
				КонецЕсли;
				Если ДанныеОбъекта.Свойство("ВидНалогаИлиПлатежа") Тогда
					МассивПараметров.Добавить(Новый ПараметрВыбора("Отбор.ВидНалогаИлиПлатежа", ДанныеОбъекта.ВидНалогаИлиПлатежа));
				КонецЕсли;
			ИначеЕсли ВидПараметров = "ДенежныеДокументы" Тогда
				Если ДанныеОбъекта.Свойство("ВидДенежногоДокумента") Тогда
					МассивПараметров.Добавить(Новый ПараметрВыбора("Отбор.Владелец", ДанныеОбъекта.ВидДенежногоДокумента));
				КонецЕсли;
			ИначеЕсли ВидПараметров = "РасходыУСН" Тогда
				Если ДанныеОбъекта.Свойство("СчетУчета") Тогда
					МассивПараметров.Добавить(Новый ПараметрВыбора("Отбор.Счет", ДанныеОбъекта.СчетУчета));
				КонецЕсли;
				Если ДанныеОбъекта.Свойство("Субконто1") Тогда
					МассивПараметров.Добавить(Новый ПараметрВыбора("Отбор.Субконто1", ДанныеОбъекта.Субконто1));
				КонецЕсли;
			ИначеЕсли ВидПараметров = "ДополнительнаяБюджетнаяКлассификация" Тогда
				Если ДанныеОбъекта.Свойство("КПС") Тогда
					МассивПараметров.Добавить(Новый ПараметрВыбора("КПС", ДанныеОбъекта.КПС));
				КонецЕсли;
				Если ДанныеОбъекта.Свойство("КЭК") Тогда
					МассивПараметров.Добавить(Новый ПараметрВыбора("КЭК", ДанныеОбъекта.КЭК));
				КонецЕсли;
			ИначеЕсли ВидПараметров = "СерииБСО" Тогда
				Если ДанныеОбъекта.Свойство("БСО") Тогда
					МассивПараметров.Добавить(Новый ПараметрВыбора("Отбор.Владелец", ДанныеОбъекта.БСО));
				КонецЕсли;
			ИначеЕсли ВидПараметров = "Субконто" И ДанныеОбъекта.Свойство("СчетУчета") Тогда
				СвойстваСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(ДанныеОбъекта.СчетУчета);
				МассивПараметров.Добавить(Новый ПараметрВыбора("Отбор.Владелец", СвойстваСчета["ВидСубконто" + Индекс]));
			КонецЕсли;
			
			Если МассивПараметров.Количество() > 0 Тогда
				ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметров);
				ЭлементФормыСубконто.ПараметрыВыбора = ПараметрыВыбора;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОчиститьСубконтоПриИзмененииСубконто(Объект, ПараметрыУстановки, НомерСубконто)
	
	ТипыСубконтоДляОчистки = ТипыСубконтоДляОчисткиПриИзмененииСубконто();
	
	ПоляОбъекта = ПараметрыУстановки.ПоляОбъекта;
	
	Для Индекс = НомерСубконто + 1 По 3 Цикл
		
		Если НЕ ЗначениеЗаполнено(ПоляОбъекта["Субконто" + Индекс]) Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяПоля = ПоляОбъекта["Субконто" + Индекс];

		Если ЗначениеЗаполнено(ИмяПоля)
			И ЗначениеЗаполнено(Объект[ИмяПоля]) Тогда
			ТипПоля = ТипЗнч(Объект[ИмяПоля]);
			Если ТипыСубконтоДляОчистки[ТипПоля] <> Неопределено Тогда
				Объект[ИмяПоля] = Новый (ТипПоля);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьВидыПараметровСвязьПоОрганизации(ВидыПараметров)

	ТипыСубконтоСвязанныеСОрганизацией = БухгалтерскийУчетВызовСервераПовтИсп.ТипыСубконтоСвязанныеСОрганизацией();
	ОбщегоНазначенияКлиентСервер.ДополнитьСоответствие(ВидыПараметров, ТипыСубконтоСвязанныеСОрганизацией, Истина);

КонецПроцедуры

Функция ТипыСубконтоДляОчисткиПриИзмененииСубконто()
	
	ТипыСубконтоДляОчистки = Новый Соответствие;
	ТипыСубконтоДляОчистки.Вставить(Тип("СправочникСсылка.Договоры"), Истина);
	ТипыСубконтоДляОчистки.Вставить(Тип("СправочникСсылка.НалогиИПлатежиОрганизации"), Истина);
	ТипыСубконтоДляОчистки.Вставить(Тип("СправочникСсылка.ДенежныеДокументы"), Истина);
	ТипыСубконтоДляОчистки.Вставить(Тип("СправочникСсылка.РасходыУСН"), Истина);
	ТипыСубконтоДляОчистки.Вставить(Тип("СправочникСсылка.СерииБСО"), Истина);
	
	Возврат ТипыСубконтоДляОчистки;

КонецФункции

#КонецОбласти

