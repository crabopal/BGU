// @strict-types

#Область ПрограммныйИнтерфейс

// Коды операций прослеживаемости.
// 
// Возвращаемое значение:
//  ФиксированноеСоответствие из см. ПрослеживаемостьБГУКлиентСервер.КодОперацииПрослеживаемости
Функция КодыОперацийПрослеживаемости() Экспорт
	Результат = Новый Соответствие;
	Выборка = ВыборкаКодовОперацийПрослеживаемости();
	Пока Выборка.Следующий() Цикл
		СтрокаРезультат = ПрослеживаемостьБГУКлиентСервер.КодОперацииПрослеживаемости();
		СтрокаРезультат.Код = Выборка.Код;
		СтрокаРезультат.Наименование = Выборка.Наименование;
		СтрокаРезультат.ПометкаУдаления = Выборка.ПометкаУдаления;
		Результат.Вставить(Выборка.Ссылка, Новый ФиксированнаяСтруктура(СтрокаРезультат));
	КонецЦикла;
	Возврат Новый ФиксированноеСоответствие(Результат);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выборка кодов операций прослеживаемости.
// 
// Возвращаемое значение:
//  ВыборкаИзРезультатаЗапроса - Выборка кодов операций прослеживаемости:
//   * Ссылка - СправочникСсылка.КодыОперацийПрослеживаемости
//   * Код - Строка
//   * Наименование - Строка
//   * ПометкаУдаления - Булево
Функция ВыборкаКодовОперацийПрослеживаемости()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КодыОперацийПрослеживаемости.Ссылка,
	|	КодыОперацийПрослеживаемости.Код,
	|	КодыОперацийПрослеживаемости.Наименование,
	|	КодыОперацийПрослеживаемости.ПометкаУдаления
	|ИЗ
	|	Справочник.КодыОперацийПрослеживаемости КАК КодыОперацийПрослеживаемости";
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат Выборка;	
КонецФункции

#КонецОбласти
