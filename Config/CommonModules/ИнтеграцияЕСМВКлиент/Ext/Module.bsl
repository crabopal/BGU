
// Параметры:
//  ПараметрыОбмена- Структура:
//		* Организация - СправочникСсылка.Организации
//		* ЛицевойСчет - СправочникСсылка.ЛицевыеСчета
//		* НастройкиУчастника - Фиксированная структура
//      	* АдресАвторизации - Строка.
//      	* АдресЗагрузкиФайлов - Строка.
//      	* АдресПередачиПакетов - Строка.
//      	* АдресЗапросаРезультатов - Строка.
//      	* АдресЗапросаДокументов - Строка.
//      	* АдресЗапросаФайлов - Строка.
//      	* Сертификат - СправочникСсылка.СертификатыКлючейЭлектроннойПодписиИШифрования. 
//      	* МодульИнтеграции - ПеречислениеСсылка.МодулиИнтеграции 
//		* НастройкиОбмена - Фиксированная структура
//      	* ВидОбмена - СправочникСсылка.ТипыОбменаБанкиКС
//      	* НастройкаФорматов - СправочникСсылка.НастройкаФорматовОбменаБанкиКС
//		* ИмяПроцедурыОбмена - Строка 
//		* СписокДокументов - Массив - ДокументСсылка - спиок документов для обработки 
//
Процедура НачатьЦиклОбмена(ПараметрыОбмена) Экспорт
		
	// Выполняем авторизацию отдельно и возвращаем токен на клиент, потому что токен будет шифроваться, и надо расшифровать его закрытым ключем.
	// Т.к. работа с криптографией может быть настроена на клиенте, а не на сервере, то необходим возврат токена на клиент. 
    //
	ГУИДАвторизации = Новый УникальныйИдентификатор;
	ТребуетсяРасшифровка = Ложь; 
	КлючЗаписиСообщенияАвторизации = Неопределено;
	ТокенАвторизации = ИнтеграцияЕСМВВызовСервера.ПройтиАвторизацию(ПараметрыОбмена.Организация, ГУИДАвторизации, ПараметрыОбмена.НастройкиУчастника, ТребуетсяРасшифровка);
	Если ТокенАвторизации = Неопределено Тогда
		Возврат;
	КонецЕсли;    
	
	ДополнительныеПараметры = ОбщегоНазначенияКлиент.СкопироватьРекурсивно(ПараметрыОбмена);
	ДополнительныеПараметры.Вставить("ГУИДАвторизации", ГУИДАвторизации);
	ДополнительныеПараметры.Вставить("ТребуетсяРасшифровка", ТребуетсяРасшифровка);
	ДополнительныеПараметры.Вставить("ТокенАвторизации", ТокенАвторизации); 
	
	Если ТребуетсяРасшифровка Тогда
		
		ДвочиныеДанныеТокена = Base64Значение(ТокенАвторизации);

		ОписаниеДанных = Новый Структура;
		ОписаниеДанных.Вставить("Операция", "Расшифровка токена авторизации для обмена с ЕСМВ");
		ОписаниеДанных.Вставить("ЗаголовокДанных","Токен авторизации");
		ОписаниеДанных.Вставить("Данные", ДвочиныеДанныеТокена);

		ОтборСертификатов = Новый Массив;
		ОтборСертификатов.Добавить(ПараметрыОбмена.НастройкиУчастника.Сертификат);
		ОписаниеДанных.Вставить("ОтборСертификатов", ОтборСертификатов);
		ОписаниеДанных.Вставить("БезПодтверждения", Истина);
		ОписаниеДанных.Вставить("РазрешитьЗапоминатьПароль", Истина);
						
		ОбработкаРезультата = Новый ОписаниеОповещения("ПродолжениеЦиклаОбменаПослеРасшифровкиТокенаАвторизации", ЭтотОбъект, ДополнительныеПараметры);

		ЭлектроннаяПодписьКлиент.Расшифровать(ОписаниеДанных, ЭтотОбъект, ОбработкаРезультата);
		
	Иначе
		ПродолжениеЦиклаОбменаПослеРасшифровкиТокенаАвторизации(Неопределено, ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры  

Процедура ПродолжениеЦиклаОбменаПослеРасшифровкиТокенаАвторизации(Результат, ДополнительныеПараметры) Экспорт 
	
	Организация = ДополнительныеПараметры.Организация; 
	ЛицевойСчет = ДополнительныеПараметры.ЛицевойСчет;
	ГУИДАвторизации = ДополнительныеПараметры.ГУИДАвторизации;
	ТребуетсяРасшифровка = ДополнительныеПараметры.ТребуетсяРасшифровка;
	ИмяПроцедурыОбмена = ДополнительныеПараметры.ИмяПроцедурыОбмена; 
	НастройкиУчастника = ДополнительныеПараметры.НастройкиУчастника;
	
	РасшифровкаВыполнена = Ложь;
	Если ТребуетсяРасшифровка Тогда
		Если Результат <> Неопределено 
			И Результат.Успех Тогда 
			ТокенАвторизации = "";
			ИнтеграцияЕСМВВызовСервера.ЗаписатьРасшифрованныйТокен(Результат.РасшифрованныеДанные, Организация, ГУИДАвторизации, ТокенАвторизации);
			РасшифровкаВыполнена = Истина;
		Иначе
			ТекстСообщения = НСтр("ru='При обмене с ЕСМВ по организации ""%1"" с сертификатом ""%2"", не удалось расшифровать токен авторизации.'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Организация, НастройкиУчастника.Сертификат);
			// Дополнить сообщение об ошибке
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
			ИнтеграцияЕСМВВызовСервера.ЗаписатьОшибкуРасшифровки(Организация, ГУИДАвторизации, ТекстСообщения);
		КонецЕсли;
	Иначе
		ТокенАвторизации = ДополнительныеПараметры.ТокенАвторизации;
	КонецЕсли; 
	
	ДополнительныеПараметры.Вставить("ТокенАвторизации", ТокенАвторизации); 
	
	Если РасшифровкаВыполнена
		ИЛИ ТребуетсяРасшифровка = Ложь Тогда
		
		Если ИмяПроцедурыОбмена = "ОтправитьОтмеченныеДокументыЕСМВ" Тогда  
			
			ДополнительныеПараметры.Вставить("ОтправленныеДокументы", Новый Массив); 
			ИнтеграцияЕСМВВызовСервера.ОтправитьОтмеченныеДокументы(ДополнительныеПараметры);
			Оповестить("ОтправитьОтмеченныеДокументыЕСМВ", ДополнительныеПараметры.ОтправленныеДокументы); 
					
		ИначеЕсли ИмяПроцедурыОбмена = "ЗапроситьДокументыИзЕСМВ" Тогда
			
			ИнтеграцияЕСМВВызовСервера.ЗапроситьДокументыИзЕСМВ(ДополнительныеПараметры);
            Оповестить("ЗапроситьДокументыИзЕСМВ");

		ИначеЕсли ИмяПроцедурыОбмена = "ЗапроситьРезультатыОбработки" Тогда
			
			ИнтеграцияЕСМВВызовСервера.ЗапроситьРезультатыОбработки(ДополнительныеПараметры); 
			Оповестить("ЗапроситьРезультатыОбработкиЕСМВ");
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры  

Процедура ОткрытьФормуНастроекУчастникаЕСМВ(Организация) Экспорт
	
	ПарамерыЗаписи = Новый Структура;
	КлючЗаписи = ИнтеграцияЕСМВВызовСервера.ПолучитьКлючЗаписиНастройкиОрганизаций(Организация);
	Если КлючЗаписи = Неопределено Тогда
		 ПарамерыЗаписи.Вставить("Организация", Организация);
	 Иначе
		 ПарамерыЗаписи.Вставить("Ключ", КлючЗаписи);
	КонецЕсли;	 
	ОткрытьФорму("РегистрСведений.НастройкиОрганизацийДляОбменаЕСМВ.ФормаЗаписи", ПарамерыЗаписи); 
	
Конецпроцедуры	

