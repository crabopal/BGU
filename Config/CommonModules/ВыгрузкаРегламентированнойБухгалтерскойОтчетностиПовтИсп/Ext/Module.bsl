// служебные 

Функция ПолучитьМассивИменИспользуемыхТранспортов() Экспорт 
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СпособыВыгрузкиФайлов.Ссылка КАК Ссылка
	|ИЗ
	|	Перечисление.СпособыВыгрузкиФайлов КАК СпособыВыгрузкиФайлов";
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаРезультатаЗапроса Из РезультатЗапроса Цикл 
		
		Результат.Добавить(ПолучитьПолноеИмяПредопределенногоЗначения(СтрокаРезультатаЗапроса.Ссылка));
		
	КонецЦикла;
	
	Возврат Результат;	
	
КонецФункции

Функция ТранспортИспользуется(ИмяТранспорта) Экспорт 
	
	ИспользуемыеТранспорты = ВыгрузкаРегламентированнойБухгалтерскойОтчетностиПовтИсп.ПолучитьМассивИменИспользуемыхТранспортов();
	
	Если ИмяТранспорта = "Перечисление.СпособыВыгрузкиФайлов.ОбменСФНС" Тогда 
		Возврат ИспользуемыеТранспорты.Найти(ИмяТранспорта) <> Неопределено И ОбщегоНазначения.ПодсистемаСуществует("УчетГосУчрежденийПодсистемы.РегламентированнаяБухОтчетность.ВыгрузкаРегламентированнойБухгалтерскойОтчетности.ОбменСФНС");
	Иначе 
		Возврат ИспользуемыеТранспорты.Найти(ИмяТранспорта) <> Неопределено; 
	КонецЕсли;
	
КонецФункции	

