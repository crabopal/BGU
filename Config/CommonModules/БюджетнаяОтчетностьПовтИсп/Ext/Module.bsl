Функция КонтрагентСуществуетПоДаннымФНС(Контрагент) Экспорт
	РеквизитыКонтрагента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Контрагент,"ИНН,КПП");
	Возврат ПроверкаКонтрагентовВызовСервера.КонтрагентСуществует(Контрагент,РеквизитыКонтрагента.ИНН,РеквизитыКонтрагента.КПП);	
КонецФункции

Функция ВозможноИспользованиеПроверкиКонтрагентов() Экспорт
	Возврат ПроверкаКонтрагентов.ИспользованиеПроверкиВозможно();	
КонецФункции

Функция ПолучитьОписаниеТиповБК(Аналитика) Экспорт
	
	РеквизитыАналитики = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Аналитика, "ТипЗначения, ВидКлассификатораБК");
	
	Если НЕ ЗначениеЗаполнено(РеквизитыАналитики.ВидКлассификатораБК) Тогда
		Результат = РеквизитыАналитики.ТипЗначения;
	Иначе
		Если РеквизитыАналитики.ВидКлассификатораБК = Перечисления.ВидыКлассификаторовОтчетов.АналитическиеКодыКПС Тогда
			Результат = Новый ОписаниеТипов("СправочникСсылка.АналитическиеКодыКПС");
		ИначеЕсли РеквизитыАналитики.ВидКлассификатораБК = Перечисления.ВидыКлассификаторовОтчетов.ВидыДоходовКДБ Тогда
			Результат = Новый ОписаниеТипов("СправочникСсылка.ВидыДоходовКДБ");
		ИначеЕсли РеквизитыАналитики.ВидКлассификатораБК = Перечисления.ВидыКлассификаторовОтчетов.ВидыКИФ Тогда
			Результат = Новый ОписаниеТипов("СправочникСсылка.ВидыКИФ");
		ИначеЕсли РеквизитыАналитики.ВидКлассификатораБК = Перечисления.ВидыКлассификаторовОтчетов.ВидыРасходовКРБ Тогда
			Результат = Новый ОписаниеТипов("СправочникСсылка.ВидыРасходовКРБ");
		ИначеЕсли РеквизитыАналитики.ВидКлассификатораБК = Перечисления.ВидыКлассификаторовОтчетов.ГлавыПоБюджетнойКлассификации Тогда
			Результат = Новый ОписаниеТипов("СправочникСсылка.ГлавыПоБюджетнойКлассификации");
		ИначеЕсли РеквизитыАналитики.ВидКлассификатораБК = Перечисления.ВидыКлассификаторовОтчетов.ГруппыПодвидовКДБ Тогда
			Результат = Новый ОписаниеТипов("СправочникСсылка.ГруппыПодвидовКДБ");
		ИначеЕсли РеквизитыАналитики.ВидКлассификатораБК = Перечисления.ВидыКлассификаторовОтчетов.ГруппыПодгруппыКИФ Тогда
			Результат = Новый ОписаниеТипов("СправочникСсылка.ГруппыПодгруппыКИФ");
		ИначеЕсли РеквизитыАналитики.ВидКлассификатораБК = Перечисления.ВидыКлассификаторовОтчетов.КОСГУ Тогда
			Результат = Новый ОписаниеТипов("СправочникСсылка.КОСГУ");
		ИначеЕсли РеквизитыАналитики.ВидКлассификатораБК = Перечисления.ВидыКлассификаторовОтчетов.КОСГУ_ВидыРасходовКРБ Тогда
			Результат = Новый ОписаниеТипов("СправочникСсылка.ВидыРасходовКРБ,СправочникСсылка.КОСГУ");
		ИначеЕсли РеквизитыАналитики.ВидКлассификатораБК = Перечисления.ВидыКлассификаторовОтчетов.ПрограммыЦелевыхСтатейКРБ Тогда
			Результат = Новый ОписаниеТипов("СправочникСсылка.ПрограммыЦелевыхСтатейКРБ");
		ИначеЕсли РеквизитыАналитики.ВидКлассификатораБК = Перечисления.ВидыКлассификаторовОтчетов.РазделыПодразделыКРБ Тогда
			Результат = Новый ОписаниеТипов("СправочникСсылка.РазделыПодразделыКРБ");
		ИначеЕсли РеквизитыАналитики.ВидКлассификатораБК = Перечисления.ВидыКлассификаторовОтчетов.СтатьиКИФ Тогда
			Результат = Новый ОписаниеТипов("СправочникСсылка.СтатьиКИФ");
		ИначеЕсли РеквизитыАналитики.ВидКлассификатораБК = Перечисления.ВидыКлассификаторовОтчетов.ЦелевыеСтатьиКРБ Тогда
			Результат = Новый ОписаниеТипов("СправочникСсылка.ЦелевыеСтатьиКРБ");
		Иначе
			ТекстСообщения = Нстр("ru='В виде аналитики %1 указан не корректный вид классификатора БК'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,Строка(Аналитика));
			ВызватьИсключение ТекстСообщения;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСоответствиеПроверяемыхСпособовВычисления() Экспорт
	//способы вычисления, для которых анализируется поле УточнениеСпособаОпределения, например, наличие ссылок	
	СоответствиеПроверяемыхСпособовВычисления = Новый Соответствие;
	СоответствиеПроверяемыхСпособовВычисления.Вставить(Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение,Истина);
	СоответствиеПроверяемыхСпособовВычисления.Вставить(Перечисления.СпособыВычисленияПараметровОперандов.СписокФиксированныхЗначений,Истина);
	СоответствиеПроверяемыхСпособовВычисления.Вставить(Перечисления.СпособыВычисленияПараметровОперандов.ЗначениеПоИерархии,Истина);
	СоответствиеПроверяемыхСпособовВычисления.Вставить(Перечисления.СпособыВычисленияПараметровОперандов.ВСпискеПоИерархии,Истина);

	СоответствиеПроверяемыхСпособовВычисления.Вставить(Перечисления.СпособыВычисленияПараметровОперандов.НеФиксированноеЗначение,Истина);
	СоответствиеПроверяемыхСпособовВычисления.Вставить(Перечисления.СпособыВычисленияПараметровОперандов.НеСписокФиксированныхЗначений,Истина);
	СоответствиеПроверяемыхСпособовВычисления.Вставить(Перечисления.СпособыВычисленияПараметровОперандов.НеЗначениеПоИерархии,Истина);
	СоответствиеПроверяемыхСпособовВычисления.Вставить(Перечисления.СпособыВычисленияПараметровОперандов.НеВСпискеПоИерархии,Истина);
	
	Возврат СоответствиеПроверяемыхСпособовВычисления;
КонецФункции

Функция ПолучитьСоответствиеИсключаемыхСпособовВычисления() Экспорт
	//способы вычисления, для которых не анализируется значение в поле УточнениеСпособаОпределения 
	СоответствиеИсключаемыхСпособов = Новый Соответствие;
	СоответствиеИсключаемыхСпособов.Вставить(Перечисления.СпособыВычисленияПараметровОперандов.ОрганизацияОтчета,Истина);
	СоответствиеИсключаемыхСпособов.Вставить(Перечисления.СпособыВычисленияПараметровОперандов.ПериодОтчета,Истина);
	СоответствиеИсключаемыхСпособов.Вставить(Перечисления.СпособыВычисленияПараметровОперандов.ДополнительныйРеквизит,Истина);
	СоответствиеИсключаемыхСпособов.Вставить(Перечисления.СпособыВычисленияПараметровОперандов.НеИспользуется,Истина);
	СоответствиеИсключаемыхСпособов.Вставить(Перечисления.СпособыВычисленияПараметровОперандов.ГодПредыдущий,Истина);
	СоответствиеИсключаемыхСпособов.Вставить(Перечисления.СпособыВычисленияПараметровОперандов.АналогичныйПериодПредыдущегоГода,Истина);
	
	Возврат СоответствиеИсключаемыхСпособов;
КонецФункции


Функция ОписаниеТиповВсеПеречисления() Экспорт
	
	ТипыПеречислений = Перечисления.ТипВсеСсылки();
	Возврат ТипыПеречислений;
	
КонецФункции

Функция ПолучитьИдентификаторыВидовАналитик() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	АналитикаОтчетов.Ссылка КАК Ссылка,
		|	АналитикаОтчетов.ПубличныйИдентификатор КАК ПубличныйИдентификатор
		|ИЗ
		|	ПланВидовХарактеристик.АналитикаОтчетов КАК АналитикаОтчетов";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	СоответствиеИдентификаторовАналитик = Новый Соответствие;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СоответствиеИдентификаторовАналитик.Вставить(ВыборкаДетальныеЗаписи.Ссылка,СокрЛП(ВыборкаДетальныеЗаписи.ПубличныйИдентификатор));
	КонецЦикла;
	
	Возврат СоответствиеИдентификаторовАналитик;
КонецФункции

Функция ПолучитьИменаПеречисленияСпособыВычисленияПараметровОперандов() Экспорт
	СоответствиеИмяПеречисленияСВПО = Новый Соответствие;
	СоответствиеИмяПеречисленияСВПО.Вставить(Перечисления.СпособыВычисленияПараметровОперандов.ПустаяСсылка(),"ПустаяСсылка");
	Для Каждого ТекЗнач Из Метаданные.Перечисления.СпособыВычисленияПараметровОперандов.ЗначенияПеречисления Цикл
		СоответствиеИмяПеречисленияСВПО.Вставить(Перечисления.СпособыВычисленияПараметровОперандов[ТекЗнач.Имя],ТекЗнач.Имя);
	КонецЦикла;
	
	Возврат СоответствиеИмяПеречисленияСВПО;
КонецФункции