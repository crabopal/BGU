
Процедура ИнициализироватьИПроверитьОбластьЗаполнения(ОбластьСсылка,Принудительно=Ложь) Экспорт
	
	//При загрузке комплекта выполняется только загрузка областей заполнения, без инициализации СКД.
	//Инициализация выполняется при первом обращении к области.
	
	Если Принудительно = Ложь Тогда
		//проверим, нужно ли инициализировать
		Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбластьСсылка,"Инициализирована") = Истина Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ОбластьОбъект = ОбластьСсылка.ПолучитьОбъект();
	ОбластьОбъект.ДополнительныеСвойства.Вставить("Инициализировать", Истина);
	ОбластьОбъект.ДополнительныеСвойства.Вставить("ПроверятьСхемуЗаполнения", Истина);
	
	ОбластьОбъект.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов",Истина);//отключим, чтобы можно было инициализировать в дочерних узлах РИБа
	
	УстановитьПривилегированныйРежим(Истина);
	
	ОбластьОбъект.Записать();
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры