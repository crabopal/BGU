				//	СрокЭкспл  = "";
				//КонецЕсли;
			КонецЕсли;
			ОбластьСтр_2_Параметры.Вставить("СрокЭкспл", СрокЭкспл);
			ЗаполнитьЗначенияСвойств(ОбластьСтр_2_Параметры, ВыборкаДокументы);
			
			Если ВыборкаДокументы.НормаАморт <> 0 Тогда
				ОбластьСтр_2_Параметры.НормаАморт = "" + ВыборкаДокументы.НормаАморт + "%";
			КонецЕсли;
			
			ОбластьСтр_2_Параметры.НачАмортизация	= ОбластьСтр_2_Параметры.НачАмортизация + АмортизацияТекущегоМесяца;
			ОбластьСтр_2_Параметры.ОстСтоимость		= ОбластьСтр_2_Параметры.ОстСтоимость - АмортизацияТекущегоМесяца; 
			ОбластьСтр_2.Параметры.Заполнить(ОбластьСтр_2_Параметры);
		    ТабличныйДокумент.Вывести(ОбластьСтр_2);
		
		    ТабличныйДокумент.Вывести(ОбластьСтр_2_1);
			
			//Если ВидПечати <> "ОС1" Тогда
				
			ВывелиСтрок = 0;
			СтруктураПоиска = Новый Структура("ОсновноеСредство", ВыборкаДокументы.ОсновноеСредство);
			ВыборкаДрагМеталлы.Сбросить();
			Пока ВыборкаДрагМеталлы.НайтиСледующий(СтруктураПоиска) Цикл
				ОбластьДрагметаллПараметры = Новый Структура("НазвДетали,Драгметалл,КодДрагМеталла,НазвЕИ,ВесДраг");
				ОбластьДрагметалл.Параметры.Заполнить(ВыборкаДрагМеталлы);
				ТабличныйДокумент.Вывести(ОбластьДрагметалл);
				ВывелиСтрок = ВывелиСтрок + 1;
			КонецЦикла;
			Если ВидПечати = "ОС1" Тогда
				Для Счетчик = ВывелиСтрок По 3 Цикл
					ТабличныйДокумент.Вывести(ОбластьДрагметалл_2);
				КонецЦикла;
			Иначе
				Для каждого ТекХарактеристика Из ДополнительныеХарактеристики Цикл
					
					Если ЗначениеЗаполнено(ТекХарактеристика.Значение) Тогда
						ОбластьХарактеристикиПараметры = Новый Структура("ВидХарактеристики,НазваниеХарактеристики",
																		  ТекХарактеристика.Ключ,
																		  ТекХарактеристика.Значение);	
						ОбластьХарактеристики.Параметры.Заполнить(ОбластьХарактеристикиПараметры);
						ТабличныйДокумент.Вывести(ОбластьХарактеристики);
					КонецЕсли;
				
				КонецЦикла; 
			КонецЕсли;
				
			//КонецЕсли;
			
			ОбластьСтр_2_2.Параметры.Заполнить(ОбластьСтр_2_2_Параметры);
		    ТабличныйДокумент.Вывести(ОбластьСтр_2_2);
			Если ВидПечати = "ОС1" Тогда
				Для каждого ТекХарактеристика Из ДополнительныеХарактеристики Цикл
					
					Если ЗначениеЗаполнено(ТекХарактеристика.Значение) Тогда
						ОбластьХарактеристикиПараметры = Новый Структура("ВидХарактеристики,НазваниеХарактеристики",
																		  ТекХарактеристика.Ключ,
																		  ТекХарактеристика.Значение);	
						ОбластьХарактеристики.Параметры.Заполнить(ОбластьХарактеристикиПараметры);
						ТабличныйДокумент.Вывести(ОбластьХарактеристики);
					КонецЕсли;
				
				КонецЦикла; 
			КонецЕсли;
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();		
			
			// ДатаВыпуска,
			
		КонецЕсли;
		
		// --------------- 3 страница------------------
		
		Если ВидПечати = "ОС1б" Тогда
			
			ТабличныйДокумент.Вывести(ОбластьШапка3);
			
			ИтогЦенаПродажи = 0;
			ИтогНачСтоимость = 0;
			Для каждого СтрокаДокумента Из СтрокиДокумента Цикл
			
				ОбластьСтрока3.Параметры.Заполнить(СтрокаДокумента);
				ТабличныйДокумент.Вывести(ОбластьСтрока3);
				Если СтрокаДокумента.Свойство("пЦенаПродажи") Тогда
					ИтогЦенаПродажи = ИтогЦенаПродажи + СтрокаДокумента.пЦенаПродажи;
				КонецЕсли;
				Если СтрокаДокумента.Свойство("пНачСтоимость") Тогда
					ИтогНачСтоимость = ИтогНачСтоимость + СтрокаДокумента.пНачСтоимость;
				КонецЕсли;
			
			КонецЦикла;
			
			ОбластьПодвал_3_Параметры = Новый Структура;
			ОбластьПодвал_3_Параметры.Вставить("ИтогЦенаПродажи",	ИтогЦенаПродажи);
			ОбластьПодвал_3_Параметры.Вставить("ИтогНачСтоимость",	ИтогНачСтоимость);
			ОбластьПодвал_3_Параметры.Вставить("ГлавБухСдатчика",	ГлавБухСдатчика);
			ОбластьПодвал_3_Параметры.Вставить("ДолжностьМОЛсдал",	ДолжностьМОЛсдал);
			ОбластьПодвал_3_Параметры.Вставить("ФИОМОЛсдал",		ФИОМОЛсдал);
			ОбластьПодвал_3_Параметры.Вставить("ТабНомМОЛсдал",		ТабНомМОЛсдал);
			ОбластьПодвал3.Параметры.Заполнить(ОбластьПодвал_3_Параметры);
			ТабличныйДокумент.Вывести(ОбластьПодвал3);
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			
		Иначе
			
			ОбластьСтр_3_1_Параметры = Новый Структура("ТекстПриложения");
			ЗаполнитьЗначенияСвойств(ОбластьСтр_3_1_Параметры, ВыборкаДокументы);
			ОбластьСтр_3_1.Параметры.Заполнить(ОбластьСтр_3_1_Параметры);
		    ТабличныйДокумент.Вывести(ОбластьСтр_3_1);
			
			// Комиссия
			Для каждого СтрокаОбластиКомиссия Из МассивОбластейКомиссии Цикл
				ТабличныйДокумент.Вывести(СтрокаОбластиКомиссия);	
			КонецЦикла; 
		
			ОбластьСтр_3_2_Параметры = Новый Структура;
			ОбластьСтр_3_2_Параметры.Вставить("ГлавБухПолучателя",	ГлавБухПолучателя);
			ОбластьСтр_3_2_Параметры.Вставить("ДолжностьМОЛ",		ДолжностьМОЛ);
			ОбластьСтр_3_2_Параметры.Вставить("ФИОМОЛ",				ФИОМОЛ);
			ОбластьСтр_3_2_Параметры.Вставить("ТабНомМОЛ",			ТабНомМОЛ);
			ОбластьСтр_3_2_Параметры.Вставить("ГлавБухСдатчика",	ГлавБухСдатчика);
			ОбластьСтр_3_2_Параметры.Вставить("ДолжностьМОЛсдал",	ДолжностьМОЛсдал);
			ОбластьСтр_3_2_Параметры.Вставить("ФИОМОЛсдал",			ФИОМОЛсдал);
			ОбластьСтр_3_2_Параметры.Вставить("ТабНомМОЛсдал",		ТабНомМОЛсдал);
			
			ОбластьСтр_3_2.Параметры.Заполнить(ОбластьСтр_3_2_Параметры);
		    ТабличныйДокумент.Вывести(ОбластьСтр_3_2);
		КонецЕсли;
		
		Если ВидПечати = "ОС1б" Тогда
		
			// --------------- 4 страница------------------
		
			ТабличныйДокумент.Вывести(ОбластьШапка4);
			Для каждого СтрокаДокумента Из СтрокиДокумента Цикл
			
				ОбластьСтрока4.Параметры.Заполнить(СтрокаДокумента);
			    ТабличныйДокумент.Вывести(ОбластьСтрока4);
			
			КонецЦикла; 
			
			Подвал4_Параметры = Новый Структура;
			Подвал4_Параметры.Вставить("ГлавБухПолучателя",	ГлавБухПолучателя);
			Подвал4_Параметры.Вставить("ДолжностьМОЛ",		ДолжностьМОЛ);
			Подвал4_Параметры.Вставить("ФИОМОЛ",			ФИОМОЛ);
			Подвал4_Параметры.Вставить("ТабНомМОЛ",			ТабНомМОЛ);
			ОбластьПодвал4.Параметры.Заполнить(Подвал4_Параметры);
		    ТабличныйДокумент.Вывести(ОбластьПодвал4);
		КонецЕсли;			
			
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, 
		                                               НомерСтрокиНачало, ОбъектыПечати, ВыборкаДокументы.Ссылка);
		
	КонецЦикла;		
		
КонецПроцедуры

///////////////////////////////
// ДВИЖЕНИЯ ПО РЕГИСТРАМ

// Подготовка таблиц для формирования движений по регистрам СтоимостьОбъектовОС и АмортизацияОбъектовОС
// при выбытии (списании, передаче) объектов ОС и НМА (в т.ч. для имущества казны).
//
Процедура ДобавитьТаблицыСписанияОСПоРегистрамНакопления(Запрос, НомераТаблиц, ДокументСсылка, Параметры) Экспорт
	
	ТаблицаСписания =
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ТаблицаОсновныеСредства.ДатаСписанияСБухУчета = ДАТАВРЕМЯ(1, 1, 1)
	//|		ИЛИ &ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ОперативныйУчет)
	|			ТОГДА ТаблицаОсновныеСредства.Дата
	|		ИНАЧЕ ТаблицаОсновныеСредства.ДатаСписанияСБухУчета
	|	КОНЕЦ КАК Дата,
	|	ТаблицаОсновныеСредства.Организация КАК Организация,
	|	ТаблицаОсновныеСредства.Подразделение КАК Подразделение,
	|	ТаблицаОсновныеСредства.ЦМО КАК ЦМО,
	|	ТаблицаОсновныеСредства.Договор КАК Договор,
	|	ТаблицаОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТаблицаОсновныеСредства.Количество КАК Количество,
	|	ТаблицаОсновныеСредства.Сумма КАК Сумма,
	|	ТаблицаОсновныеСредства.СуммаАмортизации КАК СуммаАмортизации,
	|	ТаблицаОсновныеСредства.СуммаОбесценения КАК СуммаОбесценения,
	|	ТаблицаОсновныеСредства.СуммаАмортизацииЗаТекущийМесяц КАК СуммаАмортизацииТекущегоМесяца,
	|	ТаблицаОсновныеСредства.НазваниеДокумента КАК НазваниеДокумента,
	|	ТаблицаОсновныеСредства.НомерДокумента КАК НомерДокумента,
	|	ТаблицаОсновныеСредства.ДатаДокумента КАК ДатаДокумента,
	|	ТаблицаОсновныеСредства.ПричинаСписания КАК ПричинаСписания
	|ПОМЕСТИТЬ ОсновныеСредстваКСписанию
	|ИЗ
	|	ТаблицаОсновныеСредства КАК ТаблицаОсновныеСредства
	|ГДЕ
	|	&СписатьСтоимостьИАмортизацию";
	
	ЕстьДоговор = (СтрНайти(Запрос.Текст, "КАК Договор") <> 0);
	
	Если Параметры.НачислитьАмортизациюПриСписании Тогда
		
		Если СтрНайти(Запрос.Текст, "СуммаАмортизацииЗаТекущийМесяц") = 0 Тогда
			
			// В документе остутствует колонка с амортизацией за текущий месяц.	
			// Рассчитаем амортизацию, начисляемую при выбытии объекта в текущем месяце.
			
			ТаблицыАмортизации = БухгалтерскиеОперацииПовтИсп.ПолучитьТаблицыАмортизацииТекущегоМесяца(ДокументСсылка, Параметры.ЭтоИмуществоКазны);
			АмортизацияТекущегоМесяца = ТаблицыАмортизации.ТаблицаНачисленияАмортизацииБУ;
			
			НомераТаблиц.Вставить("АмортизацияТекущегоМесяца", НомераТаблиц.Количество());
			Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
			"ВЫБРАТЬ
			|	АмортизацияТекущегоМесяца.ОсновноеСредство КАК ОсновноеСредство,
			|	АмортизацияТекущегоМесяца.СуммаАмортизацииБУ КАК СуммаАмортизации
			|ПОМЕСТИТЬ АмортизацияТекущегоМесяца
			|ИЗ
			|	&АмортизацияТекущегоМесяца КАК АмортизацияТекущегоМесяца
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	ОсновноеСредство";
			Запрос.УстановитьПараметр("АмортизацияТекущегоМесяца", АмортизацияТекущегоМесяца);
			
			ТаблицаСписания = СтрЗаменить(ТаблицаСписания, "ТаблицаОсновныеСредства.СуммаАмортизацииЗаТекущийМесяц",
				"ЕСТЬNULL(АмортизацияТекущегоМесяца.СуммаАмортизации, 0)");
			
			ТаблицаСписания = СтрЗаменить(ТаблицаСписания, "КАК ТаблицаОсновныеСредства", "КАК ТаблицаОсновныеСредства
			|		ЛЕВОЕ СОЕДИНЕНИЕ АмортизацияТекущегоМесяца КАК АмортизацияТекущегоМесяца
			|		ПО ТаблицаОсновныеСредства.ОсновноеСредство = АмортизацияТекущегоМесяца.ОсновноеСредство");
			
		КонецЕсли;
		
	Иначе
		
		ТаблицаСписания = СтрЗаменить(ТаблицаСписания, "ТаблицаОсновныеСредства.СуммаАмортизацииЗаТекущийМесяц", "0");
		
	КонецЕсли;
	
	Если СтрНайти(Запрос.Текст, "ТаблицаОсновныеСредства.СуммаОбесценения") = 0 Тогда
		ТаблицаСписания = СтрЗаменить(ТаблицаСписания, "ТаблицаОсновныеСредства.СуммаОбесценения", "0");
	КонецЕсли;
	Если СтрНайти(Запрос.Текст, "ТаблицаОсновныеСредства.НазваниеДокумента") = 0 Тогда
		ТаблицаСписания = СтрЗаменить(ТаблицаСписания, "ТаблицаОсновныеСредства.НазваниеДокумента", """""");
	КонецЕсли;
	Если СтрНайти(Запрос.Текст, "ТаблицаОсновныеСредства.НомерДокумента") = 0 Тогда
		ТаблицаСписания = СтрЗаменить(ТаблицаСписания, "ТаблицаОсновныеСредства.НомерДокумента", """""");
	КонецЕсли;
	Если СтрНайти(Запрос.Текст, "ТаблицаОсновныеСредства.ДатаДокумента") = 0 Тогда
		ТаблицаСписания = СтрЗаменить(ТаблицаСписания, "ТаблицаОсновныеСредства.ДатаДокумента", "ДатаВремя(1,1,1)");
	КонецЕсли;
	Если Не ЕстьДоговор Тогда
		ТаблицаСписания = СтрЗаменить(ТаблицаСписания, "ТаблицаОсновныеСредства.Договор", "Значение(Справочник.Договоры.ПустаяСсылка)");
	КонецЕсли;
	
	ЕстьПолеПередачаЧастейОбъектов = Ложь;
	Если Параметры.ПереместитьСтоимостьПоЦМО Тогда
		
		ТаблицаПеремещение =
		"ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ТаблицаОсновныеСредства.ДатаСписанияСБухУчета = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА ТаблицаОсновныеСредства.Дата
		|		ИНАЧЕ ТаблицаОсновныеСредства.ДатаСписанияСБухУчета
		|	КОНЕЦ КАК Дата,
		|	ТаблицаОсновныеСредства.Организация КАК Организация,
		|	ТаблицаОсновныеСредства.ЦМО КАК ЦМО,
		|	ТаблицаОсновныеСредства.ЦМОПолучатель КАК ЦМОПолучатель,
		|	ВЫБОР
		|		КОГДА &УчетПоПодразделениям
		|			ТОГДА ТаблицаОсновныеСредства.Подразделение
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
		|	КОНЕЦ КАК Подразделение,
		|	ВЫБОР
		|		КОГДА &УчетПоПодразделениям
		|			ТОГДА 
		|				ВЫБОР
		|					КОГДА ТаблицаОсновныеСредства.ПередачаЧастейОбъектов
		|						ТОГДА ТаблицаОсновныеСредства.Подразделение
		|					ИНАЧЕ ТаблицаОсновныеСредства.ПодразделениеПолучатель
		|				КОНЕЦ	
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
		|	КОНЕЦ КАК ПодразделениеПолучатель,
		|	ТаблицаОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
		|	ТаблицаОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	ТаблицаОсновныеСредства.Договор КАК Договор,
		|	ТаблицаОсновныеСредства.Количество КАК Количество,
		|	ТаблицаОсновныеСредства.Сумма КАК Сумма,
		|	ТаблицаОсновныеСредства.НазваниеДокумента КАК НазваниеДокумента,
		|	ТаблицаОсновныеСредства.НомерДокумента КАК НомерДокумента,
		|	ТаблицаОсновныеСредства.ДатаДокумента КАК ДатаДокумента,
		|	"""" КАК ПричинаСписания
		|ПОМЕСТИТЬ ОсновныеСредстваКПеремещению
		|ИЗ
		|	ТаблицаОсновныеСредства КАК ТаблицаОсновныеСредства
		|ГДЕ
		|	(ТаблицаОсновныеСредства.Сумма <> 0
		|	ИЛИ ТаблицаОсновныеСредства.Количество <> 0)
		|	И (ТаблицаОсновныеСредства.ЦМО <> ТаблицаОсновныеСредства.ЦМОПолучатель
		|	ИЛИ ВЫБОР
		|		КОГДА &УчетПоПодразделениям
		|			ТОГДА ТаблицаОсновныеСредства.Подразделение <> ТаблицаОсновныеСредства.ПодразделениеПолучатель
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ)
		|	И НЕ &ПередачаЧастейОбъектов";
		
		Если СтрНайти(Запрос.Текст, "ТаблицаОсновныеСредства.НазваниеДокумента") = 0 Тогда
			ТаблицаПеремещение = СтрЗаменить(ТаблицаПеремещение, "ТаблицаОсновныеСредства.НазваниеДокумента", """""");
		КонецЕсли;
		Если СтрНайти(Запрос.Текст, "ТаблицаОсновныеСредства.НомерДокумента") = 0 Тогда
			ТаблицаПеремещение = СтрЗаменить(ТаблицаПеремещение, "ТаблицаОсновныеСредства.НомерДокумента", """""");
		КонецЕсли;
		Если СтрНайти(Запрос.Текст, "ТаблицаОсновныеСредства.ДатаДокумента") = 0 Тогда
			ТаблицаПеремещение = СтрЗаменить(ТаблицаПеремещение, "ТаблицаОсновныеСредства.ДатаДокумента", "ДатаВремя(1,1,1)");
		КонецЕсли;
		Если Не ЕстьДоговор Тогда
			ТаблицаПеремещение = СтрЗаменить(ТаблицаПеремещение, "ТаблицаОсновныеСредства.Договор", "Значение(Справочник.Договоры.ПустаяСсылка)");
		КонецЕсли;
		// При передаче части объекта перемещения по ЦМО не должно быть
		ЕстьПолеПередачаЧастейОбъектов = (СтрНайти(Запрос.Текст, "ПередачаЧастейОбъектов") <> 0);
		ТаблицаПеремещение = СтрЗаменить(ТаблицаПеремещение, "&ПередачаЧастейОбъектов", 
			?(ЕстьПолеПередачаЧастейОбъектов, "ТаблицаОсновныеСредства.ПередачаЧастейОбъектов", "ЛОЖЬ"));
		
	Иначе
		
		ТаблицаПеремещение =
		"ВЫБРАТЬ ПЕРВЫЕ 0
		|	NULL КАК Дата,
		|	NULL КАК Организация,
		|	NULL КАК ЦМО,
		|	NULL КАК ЦМОПолучатель,
		|	NULL КАК Подразделение,
		|	NULL КАК ПодразделениеПолучатель,
		|	NULL КАК ОсновноеСредство,
		|	NULL КАК ИнвентарныйНомер,
		|	NULL КАК Договор,
		|	NULL КАК Количество,
		|	NULL КАК Сумма,
		|	NULL КАК НазваниеДокумента,
		|	NULL КАК НомерДокумента,
		|	NULL КАК ДатаДокумента,
		|	NULL КАК ПричинаСписания
		|ПОМЕСТИТЬ ОсновныеСредстваКПеремещению";
		
	КонецЕсли;
	
	НомераТаблиц.Вставить("ОсновныеСредстваКСписанию", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() + ТаблицаСписания;
	Запрос.УстановитьПараметр("СписатьСтоимостьИАмортизацию", Параметры.СписатьСтоимостьИАмортизацию);
	
	НомераТаблиц.Вставить("ОсновныеСредстваКПеремещению", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() + ТаблицаПеремещение;
	
	// Движения по регистру накопления СтоимостьОбъектовОС.
	НомераТаблиц.Вставить("СтоимостьОбъектовОС", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	&ВидРаспоряжения КАК ВидРаспоряжения,
	|	СтоимостьОбъектовОС.Дата КАК Период,
	|	СтоимостьОбъектовОС.Организация КАК Организация,
	|	СтоимостьОбъектовОС.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьОбъектовОС.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СтоимостьОбъектовОС.ЦМО КАК ЦМО,
	|	СтоимостьОбъектовОС.Подразделение КАК Подразделение,
	|	СтоимостьОбъектовОС.Договор КАК Договор,
	|	СтоимостьОбъектовОС.Сумма КАК Стоимость,
	|	СтоимостьОбъектовОС.Количество КАК Количество,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВнутреннееПеремещение) КАК Событие,
	|	СтоимостьОбъектовОС.НазваниеДокумента КАК НазваниеДокумента,
	|	СтоимостьОбъектовОС.НомерДокумента КАК НомерДокумента,
	|	СтоимостьОбъектовОС.ДатаДокумента КАК ДатаДокумента,
	|	СтоимостьОбъектовОС.ПричинаСписания КАК Причина
	|ИЗ
	|	ОсновныеСредстваКПеремещению КАК СтоимостьОбъектовОС
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход),
	|	&ВидРаспоряжения,
	|	СтоимостьОбъектовОС.Дата,
	|	СтоимостьОбъектовОС.Организация,
	|	СтоимостьОбъектовОС.ОсновноеСредство,
	|	СтоимостьОбъектовОС.ИнвентарныйНомер,
	|	СтоимостьОбъектовОС.ЦМОПолучатель,
	|	СтоимостьОбъектовОС.ПодразделениеПолучатель,
	|	СтоимостьОбъектовОС.Договор,
	|	СтоимостьОбъектовОС.Сумма,
	|	СтоимостьОбъектовОС.Количество,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВнутреннееПеремещение),
	|	СтоимостьОбъектовОС.НазваниеДокумента,
	|	СтоимостьОбъектовОС.НомерДокумента,
	|	СтоимостьОбъектовОС.ДатаДокумента,
	|	СтоимостьОбъектовОС.ПричинаСписания
	|ИЗ
	|	ОсновныеСредстваКПеремещению КАК СтоимостьОбъектовОС
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход),
	|	&ВидРаспоряжения,
	|	СтоимостьОбъектовОС.Дата,
	|	СтоимостьОбъектовОС.Организация,
	|	СтоимостьОбъектовОС.ОсновноеСредство,
	|	СтоимостьОбъектовОС.ИнвентарныйНомер,
	|	СтоимостьОбъектовОС.ЦМО,
	|	ВЫБОР
	|		КОГДА &УчетПоПодразделениям
	|			ТОГДА СтоимостьОбъектовОС.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ,
	|	СтоимостьОбъектовОС.Договор,
	|	СтоимостьОбъектовОС.Сумма,
	|	СтоимостьОбъектовОС.Количество,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Списание),
	|	СтоимостьОбъектовОС.НазваниеДокумента,
	|	СтоимостьОбъектовОС.НомерДокумента,
	|	СтоимостьОбъектовОС.ДатаДокумента,
	|	СтоимостьОбъектовОС.ПричинаСписания
	|ИЗ
	|	ОсновныеСредстваКСписанию КАК СтоимостьОбъектовОС
	|ГДЕ
	|	(СтоимостьОбъектовОС.Сумма <> 0
	|			ИЛИ СтоимостьОбъектовОС.Количество <> 0)";
	
	Если Параметры.ЭтоИмуществоКазны Тогда
		УчетПоПодразделениям = УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетИКПоПодразделениям();
	Иначе
		УчетПоПодразделениям = УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетОСПоПодразделениям();
	КонецЕсли;
	Запрос.УстановитьПараметр("УчетПоПодразделениям", УчетПоПодразделениям);
	Запрос.УстановитьПараметр("ВидРаспоряжения", Параметры.ВидРаспоряжения);
	
	// Движения по регистру накопления АмортизацияОбъектовОС.
	НомераТаблиц.Вставить("АмортизацияОбъектовОС", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	АмортизацияОбъектовОС.Дата КАК Период,
	|	АмортизацияОбъектовОС.Организация КАК Организация,
	|	АмортизацияОбъектовОС.ОсновноеСредство КАК ОсновноеСредство,
	|	АмортизацияОбъектовОС.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	АмортизацияОбъектовОС.СуммаАмортизацииТекущегоМесяца КАК СуммаАмортизации,
	|	0 КАК СуммаОбесценения,
	|	ЛОЖЬ КАК ЭтоСписание
	|ИЗ
	|	ОсновныеСредстваКСписанию КАК АмортизацияОбъектовОС
	|ГДЕ
	|	АмортизацияОбъектовОС.СуммаАмортизацииТекущегоМесяца <> 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход),
	|	АмортизацияОбъектовОС.Дата,
	|	АмортизацияОбъектовОС.Организация,
	|	АмортизацияОбъектовОС.ОсновноеСредство,
	|	АмортизацияОбъектовОС.ИнвентарныйНомер,
	|	АмортизацияОбъектовОС.СуммаАмортизации + АмортизацияОбъектовОС.СуммаАмортизацииТекущегоМесяца,
	|	АмортизацияОбъектовОС.СуммаОбесценения,
	|	ИСТИНА
	|ИЗ
	|	ОсновныеСредстваКСписанию КАК АмортизацияОбъектовОС
	|ГДЕ
	|	(АмортизацияОбъектовОС.СуммаАмортизации + АмортизацияОбъектовОС.СуммаАмортизацииТекущегоМесяца <> 0
	|			ИЛИ АмортизацияОбъектовОС.СуммаОбесценения <> 0)";
	
	Если ЗначениеЗаполнено(Параметры.ВидРаспоряженияУКонтрагента) Тогда
		
		// Движения по регистру накопления СтоимостьОбъектовОСПоКонтрагентам.
		НомераТаблиц.Вставить("СтоимостьОбъектовОСПоКонтрагентам", НомераТаблиц.Количество());
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	&ВидДвижения КАК ВидДвижения,
		|	&ВидРаспоряженияУКонтрагента КАК ВидРаспоряжения,
		|
		|	ВЫБОР
		|		КОГДА ТаблицаОсновныеСредства.ДатаСписанияСБухУчета = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА ТаблицаОсновныеСредства.Дата
		|		ИНАЧЕ ТаблицаОсновныеСредства.ДатаСписанияСБухУчета
		|	КОНЕЦ КАК Период,
		|	ТаблицаОсновныеСредства.Организация КАК Организация,
		|	ВЫБОР
		|		КОГДА &УчетПоПодразделениямКонтрагент
		|			ТОГДА &ПолеПодразделение
		|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
		|	КОНЕЦ КАК Подразделение,
		|	ТаблицаОсновныеСредства.ЦМО КАК ЦМО,
		|	ТаблицаОсновныеСредства.Контрагент КАК Контрагент,
		|	ТаблицаОсновныеСредства.Договор КАК Договор,
		|	ТаблицаОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
		|	ТаблицаОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	ТаблицаОсновныеСредства.Количество КАК Количество,
		|	ТаблицаОсновныеСредства.Сумма КАК Стоимость,
		|	ТаблицаОсновныеСредства.НазваниеДокумента КАК НазваниеДокумента,
		|	ТаблицаОсновныеСредства.НомерДокумента КАК НомерДокумента,
		|	ТаблицаОсновныеСредства.ДатаДокумента КАК ДатаДокумента,
		|	ВЫБОР
		|		КОГДА &ВидДвижения = &ВидДвиженияРНРасход
		|			ТОГДА ТаблицаОсновныеСредства.ПричинаСписания
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК Причина
		|ИЗ
		|	ТаблицаОсновныеСредства КАК ТаблицаОсновныеСредства";
		
		Если Параметры.ПереместитьСтоимостьПоЦМО Тогда
			Если ЕстьПолеПередачаЧастейОбъектов Тогда
				// При передаче части объекта ЦМО меняться не должен
				ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТаблицаОсновныеСредства.ЦМО", "
					|ВЫБОР
					|	КОГДА ТаблицаОсновныеСредства.ПередачаЧастейОбъектов
					|		ТОГДА ТаблицаОсновныеСредства.ЦМО
					|	ИНАЧЕ ТаблицаОсновныеСредства.ЦМОПолучатель
					|КОНЕЦ");
			Иначе
				ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ".ЦМО", ".ЦМОПолучатель");
			КонецЕсли;	
		КонецЕсли;
		Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеОбъектовОС")
			Или ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеТранспорта")
			Или ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.АктСписанияМягкогоИХозИнвентаряОС")
			Или ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеЛитературы") 
			Или ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СписаниеОбъектовИК") Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ТаблицаОсновныеСредства.ЦМО",
			"ВЫБОР КОГДА ТаблицаОсновныеСредства.ЦМОПолучатель = Значение(Справочник.ЦМО.ПустаяСсылка)
			|		ТОГДА ТаблицаОсновныеСредства.ЦМО
			|	ИНАЧЕ ТаблицаОсновныеСредства.ЦМОПолучатель
			|КОНЕЦ");
		КонецЕсли;
		Если Параметры.ВидРаспоряженияУКонтрагента = Перечисления.ВидыРаспоряженияОС.НаХранении
			И Параметры.ПоступлениеКонтрагенту Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ".Сумма", ".Количество");
		КонецЕсли;
		
		Если Не ЕстьДоговор Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, 
				"ТаблицаОсновныеСредства.Договор", "ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)");
		КонецЕсли;
		
		КодСчета =
			?(Параметры.ВидРаспоряженияУКонтрагента = Перечисления.ВидыРаспоряженияОС.ПолученоВПользование	, "01",
			?(Параметры.ВидРаспоряженияУКонтрагента = Перечисления.ВидыРаспоряженияОС.НаХранении			, "02",
			?(Параметры.ВидРаспоряженияУКонтрагента = Перечисления.ВидыРаспоряженияОС.ПереданоВУправление	, "24",
			?(Параметры.ВидРаспоряженияУКонтрагента = Перечисления.ВидыРаспоряженияОС.ПереданоВАренду		, "25",
			?(Параметры.ВидРаспоряженияУКонтрагента = Перечисления.ВидыРаспоряженияОС.ПереданоВПользование	, "26",
			"")))));
		Запрос.УстановитьПараметр("УчетПоПодразделениямКонтрагент", ?(КодСчета = "", Ложь,
			ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
			И БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета(КодСчета).УчетПоПодразделениям));
			
		Запрос.УстановитьПараметр("ВидРаспоряженияУКонтрагента", Параметры.ВидРаспоряженияУКонтрагента);
		ВидДвижения = ?(Параметры.ПоступлениеКонтрагенту, ВидДвиженияНакопления.Приход, ВидДвиженияНакопления.Расход);
		Запрос.УстановитьПараметр("ВидДвижения", ВидДвижения);
		Запрос.УстановитьПараметр("ВидДвиженияРНРасход", ВидДвиженияНакопления.Расход);
		
		ПолеПодразделение = "ТаблицаОсновныеСредства.Подразделение";
		Если (ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПередачаОбъектовИК")
			ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПередачаОбъектовОС")) 
			И ВидДвижения = ВидДвиженияНакопления.Приход Тогда
				
			Если Параметры.Свойство("ПередачаЧастейОбъектов") И Параметры.ПередачаЧастейОбъектов Тогда
				ПолеПодразделение = "ТаблицаОсновныеСредства.Подразделение";
			Иначе
				ПолеПодразделение = "ТаблицаОсновныеСредства.ПодразделениеПолучатель";
			КонецЕсли;	
		КонецЕсли;		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеПодразделение", ПолеПодразделение);
		Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() + ТекстЗапроса;
		
	КонецЕсли;
	
КонецПроцедуры

// Формирует общие параметры списания ОС по регистрам накопления в зависимости от вида операции
//
// Параметры:
//  ВидОперации - ПеречислениеСсылка - ссылка на перечисление, соответствующее передаваемому виду операции
//
// Возвращаемое значение:
//  Структура. Ключи:
//	 * НачислитьАмортизациюПриСписании - Булево
//	 * СписатьСтоимостьИАмортизацию - Булево
//	 * ЭтоИмуществоКазны - Булево
//	 * ПереместитьСтоимостьПоЦМО - Булево
//	 * СписатьСтоимостьОперУчет - Булево
//	 * ВидРаспоряжения - Перечислениессылка.ВидыРаспоряженияОС
//	 * ВидРаспоряженияУКонтрагента - ПеречислениеСсылка.ВидыРаспоряженияОС
//	 * ПоступлениеКонтрагенту - Булево
Функция ПараметрыСписанияОСПоРегистрамНакопления(ВидОперации = Неопределено) Экспорт
	
	Параметры = Новый Структура;
	Параметры.Вставить("НачислитьАмортизациюПриСписании"	, Истина);
	Параметры.Вставить("СписатьСтоимостьИАмортизацию"		, Истина);
	Параметры.Вставить("ЭтоИмуществоКазны"					, Ложь);
	Параметры.Вставить("ПереместитьСтоимостьПоЦМО"			, Ложь);
	Параметры.Вставить("СписатьСтоимостьОперУчет"			, Ложь);
	Параметры.Вставить("ВидРаспоряжения"					, Перечисления.ВидыРаспоряженияОС.НаБалансе);
	Параметры.Вставить("ВидРаспоряженияУКонтрагента"		, Перечисления.ВидыРаспоряженияОС.ПустаяСсылка());
	Параметры.Вставить("ПоступлениеКонтрагенту"				, Истина);
	Параметры.Вставить("ПередачаЧастейОбъектов"				, Ложь);
	
	Если ВидОперации <> Неопределено Тогда
		Параметры.НачислитьАмортизациюПриСписании = 
			УправлениеОсновнымиСредствамиКлиентСервер.ЭтоВыбытиеОСБаланс(ВидОперации);
		Параметры.СписатьСтоимостьИАмортизацию = 
			УправлениеОсновнымиСредствамиКлиентСервер.ЭтоВыбытиеОСБаланс(ВидОперации)
			Или ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаСобственныхОСОперУчет
			Или ВидОперации = Перечисления.ВидыОперацийПередачиОС.РеализацияСобственныхОСОперУчет
			Или ВидОперации = Перечисления.ВидыОперацийСписанияОС.СписаниеСобственныхОСОперУчет;
		Параметры.СписатьСтоимостьОперУчет = 
			(ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаСобственныхОСОперУчет);
		
		Параметры.ЭтоИмуществоКазны = (ТипЗнч(ВидОперации) = Тип("ПеречислениеСсылка.ВидыОперацийИК"));
		
		Параметры.ПереместитьСтоимостьПоЦМО = 
			УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПередачаВПользование(ВидОперации)
			И НЕ ВидОперации = Перечисления.ВидыОперацийИК.ПередачаИКвФинансовуюАренду
			И НЕ ВидОперации = Перечисления.ВидыОперацийИК.ВозвратЗемУчастковИзПользования
			И НЕ ВидОперации = Перечисления.ВидыОперацийИК.ПередачаЗемУчастковВПользование;
			
		Если ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаСобственныхОСОперУчет
			Или ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаОСОперУчетАренда
			Или ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаОСОперУчетВПользование
			Или ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаОСОперУчетВУправление
			Или ВидОперации = Перечисления.ВидыОперацийПередачиОС.РеализацияСобственныхОСОперУчет
			Или ВидОперации = Перечисления.ВидыОперацийСписанияОС.СписаниеСобственныхОСОперУчет Тогда
			Параметры.ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.ОперативныйУчет;
		КонецЕсли;
		Если УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПередачаВПользование(ВидОперации) Тогда
			Если УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПередачаВУправление(ВидОперации) Тогда
				Параметры.ВидРаспоряженияУКонтрагента = Перечисления.ВидыРаспоряженияОС.ПереданоВУправление;
			ИначеЕсли УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПередачаВАренду(ВидОперации) Тогда
				Параметры.ВидРаспоряженияУКонтрагента = Перечисления.ВидыРаспоряженияОС.ПереданоВАренду;
			Иначе
				Параметры.ВидРаспоряженияУКонтрагента = Перечисления.ВидыРаспоряженияОС.ПереданоВПользование;
			КонецЕсли;
		ИначеЕсли ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаОСПолученныхВПользование
			Или ВидОперации = Перечисления.ВидыОперацийСписанияОС.СписаниеОСПолученныхВПользование
			Или ВидОперации = Перечисления.ВидыОперацийИК.ПередачаИКПолученныхВПользование 
			Или ВидОперации = Перечисления.ВидыОперацийИК.СписаниеИКПолученноеВПользование Тогда
			Параметры.ВидРаспоряженияУКонтрагента = Перечисления.ВидыРаспоряженияОС.ПолученоВПользование;
		ИначеЕсли ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаОСнаХранении
			Или ВидОперации = Перечисления.ВидыОперацийСписанияОС.СписаниеОСнаХранении
			Или ВидОперации = Перечисления.ВидыОперацийИК.ПередачаОСнаХранении 
			Или ВидОперации = Перечисления.ВидыОперацийИК.СписаниеИКнаХранении Тогда
			Параметры.ВидРаспоряженияУКонтрагента = Перечисления.ВидыРаспоряженияОС.НаХранении;
		КонецЕсли;
		Если ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаОСПолученныхВПользование
			Или ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаОСнаХранении
			Или ВидОперации = Перечисления.ВидыОперацийСписанияОС.СписаниеОСПолученныхВПользование
			Или ВидОперации = Перечисления.ВидыОперацийСписанияОС.СписаниеОСнаХранении
			Или ВидОперации = Перечисления.ВидыОперацийИК.ПередачаИКПолученныхВПользование
			Или ВидОперации = Перечисления.ВидыОперацийИК.ПередачаОСнаХранении 
			Или ВидОперации = Перечисления.ВидыОперацийИК.СписаниеИКПолученноеВПользование 
			Или ВидОперации = Перечисления.ВидыОперацийИК.СписаниеИКнаХранении Тогда
			Параметры.ПоступлениеКонтрагенту = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Параметры;
	
КонецФункции

// Формирует текст запроса для определения договора для прав пользования НМА (счета 111.60) для документов
// списания ОС. Это дописка к основному запросу по документу, формируемому в модуле менеджера документа списания в 
// процедуре "ИнициализироватьДанныеДокумента".
//
// Параметры:
//  Запрос - Запрос - основной запрос по документу из процедуры модуля менеджера документа
//  РеквизитыДокумента - Структура - обязательные ключи*
//	 * Дата - Дата - дата документа
//   * Организация - СправочникСсылка.Организации - организация из документа
//   * Ссылка - ДокументСсылка - ссылка на документ, из которого выззывается процедура
Процедура ДополнитьТекстЗапросаДоговоромИзРНСтоимостьОС(Запрос, РеквизитыДокумента) Экспорт
	ВидДокумента = РеквизитыДокумента.Ссылка.Метаданные().Имя;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПустойДоговор_ПодЗамену", "ЕстьNULL(ОстаткиОС.Договор, ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка))");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ГДЕ", "
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.СтоимостьОбъектовОС.Остатки(
	|				&Период,
	|				Организация = &Организация
	|					И ОсновноеСредство В (ВЫБРАТЬ ВТ.ОсновноеСредство ИЗ Документ." + ВидДокумента + ".ОсновныеСредства КАК ВТ ГДЕ ВТ.Ссылка = &Ссылка)
	|					И ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)) КАК ОстаткиОС
	|		ПО ТаблицаОсновныеСредства.ОсновноеСредство = ОстаткиОС.ОсновноеСредство
	|			И ТаблицаОсновныеСредства.ИнвентарныйНомер = ОстаткиОС.ИнвентарныйНомер
	|ГДЕ");

	Запрос.УстановитьПараметр("Период"      , РеквизитыДокумента.Дата);
	Запрос.УстановитьПараметр("Организация" , РеквизитыДокумента.Организация);
КонецПроцедуры	

// ПРОЧИЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Функция возвращает пределы стоимости ОС для определения
//  способа начисления амортизации. Пределы стоимости периодические.
//
// Параметры:
//  ДатаРасчета	 - Дата - Дата получения параметров
// Возвращаемое значение:
// Структура - содержит ключи:
//	*ПервыйПределОС - Число - предел стоимости для списания при принятии к учету;
//	*ВторойПределОС - Число - предел стоимости для начисления 100% амортизации при принятии к учету.
Функция ПолучитьПараметрыУчетаОС(Дата = Неопределено) Экспорт
	
	Если Дата = Неопределено Тогда
		Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Результат = Новый Структура("ПервыйПределОС, ВторойПределОС", 0, 0);
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(ПараметрыУчетаОССрезПоследних.ПервыйПределОС, 0) КАК ПервыйПределОС,
	|	ЕСТЬNULL(ПараметрыУчетаОССрезПоследних.ВторойПределОС, 0) КАК ВторойПределОС
	|ИЗ
	|	РегистрСведений.ПараметрыУчетаОС.СрезПоследних(&Период, ) КАК ПараметрыУчетаОССрезПоследних";
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Период", Дата);
	РезультатЗапроса = Запрос.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает счет и аналитику затрат, а также параметры начисления амортизации в БУ и НУ
// для одного объекта ОС, НМА, НПА.
//
Функция ПолучитьПараметрыАмортизацииОС(ОсновноеСредство, Период = Неопределено) Экспорт
	
	ТаблицаПараметров = ПараметрыАмортизацииОбъектовОС(ОсновноеСредство, Период);
	Если ТаблицаПараметров.Количество() > 0 Тогда
		// Параметры амортизации в первой строке.
		СтрокаТаблицы = ТаблицаПараметров[0];
	Иначе
		// Параметры амортизации не найдены. Добавим новую строку, чтобы вернуть пустую структуру.
		СтрокаТаблицы = ТаблицаПараметров.Добавить();
	КонецЕсли;
	
	Возврат ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(СтрокаТаблицы);
	
КонецФункции

// Возвращает счет и аналитику затрат, а также параметры начисления амортизации в БУ и НУ
// для объектов ОС, НМА, НПА.
//
Функция ПараметрыАмортизацииОбъектовОС(ОсновныеСредства, Период = Неопределено) Экспорт
	
	Если ТипЗнч(ОсновныеСредства) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
		МассивОбъектовОС = Новый Массив;
		МассивОбъектовОС.Добавить(ОсновныеСредства);
	Иначе // Передан массив объектов типа "СправочникСсылка.ОсновныеСредства".
		МассивОбъектовОС = ОсновныеСредства;
	КонецЕсли;
	
	ОписаниеТиповСубконто    = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	ОписаниеТиповВидСубконто = Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто");
	
	ПараметрыАмортизацииОС = Новый ТаблицаЗначений;
	Колонки = ПараметрыАмортизацииОС.Колонки;
	Колонки.Добавить("ОсновноеСредство",    Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	// Счет и аналитика затрат по амортизации.
	Колонки.Добавить("СчетУчетаЗатрат",     Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	Колонки.Добавить("КЭКЗатрат",           Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	Колонки.Добавить("КПСЗатрат",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	Колонки.Добавить("ПодразделениеЗатрат", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	Колонки.Добавить("Субконто1Затрат",     ОписаниеТиповСубконто);
	Колонки.Добавить("Субконто2Затрат",     ОписаниеТиповСубконто);
	Колонки.Добавить("Субконто3Затрат",     ОписаниеТиповСубконто);
	Колонки.Добавить("СубконтоНУЗатрат",    ОписаниеТиповСубконто);
	Колонки.Добавить("ВидСубконто1Затрат",  ОписаниеТиповВидСубконто);
	Колонки.Добавить("ВидСубконто2Затрат",  ОписаниеТиповВидСубконто);
	Колонки.Добавить("ВидСубконто3Затрат",  ОписаниеТиповВидСубконто);
	// Параметры начисления амортизации (БУ).
	Колонки.Добавить("ПорядокПогашенияСтоимости",
		Новый ОписаниеТипов("ПеречислениеСсылка.ПорядокПогашенияСтоимостиОС"));
	Колонки.Добавить("СпособНачисленияАмортизации",
		Новый ОписаниеТипов("ПеречислениеСсылка.СпособНачисленияАмортизации"));
	Колонки.Добавить("НачислятьАмортизацию",        Новый ОписаниеТипов("Булево"));
	// Параметры начисления амортизации (НУ).
	Колонки.Добавить("ПорядокВключенияСтоимостиВСоставРасходовНУ",
		Новый ОписаниеТипов("ПеречислениеСсылка.ПорядокВключенияСтоимостиОСВСоставРасходовНУ"));
	Колонки.Добавить("НачислятьАмортизациюНУ",      Новый ОписаниеТипов("Булево"));
	Колонки.Добавить("ПервоначальнаяСтоимостьНУ",   Новый ОписаниеТипов("Число"));
	Колонки.Добавить("РасходыНеУчитываетсяНУ",      Новый ОписаниеТипов("Число"));
	Колонки.Добавить("РасходыЕНВД",                 Новый ОписаниеТипов("Число"));
	// Амортизационная премия (НУ).
	Колонки.Добавить("ДокументАмортизационнойПремии",
		ПланыВидовХарактеристик.ВидыСубконто.ДокументыАмортизационнойПремии.ТипЗначения);
	Колонки.Добавить("СчетРасходовПоАмортизационнойПремии",
		Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	Колонки.Добавить("ПодразделениеРасходовПоАмортизационнойПремии",
		Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	Колонки.Добавить("Субконто1РасходовПоАмортизационнойПремии", ОписаниеТиповСубконто);
	Колонки.Добавить("Субконто2РасходовПоАмортизационнойПремии", ОписаниеТиповСубконто);
	Колонки.Добавить("Субконто3РасходовПоАмортизационнойПремии", ОписаниеТиповСубконто);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектовОС", МассивОбъектовОС);
	
	ТипПериода = ТипЗнч(Период);
	Если ЗначениеЗаполнено(Период) Тогда
		Если ТипПериода = Тип("Дата") Тогда
			ГраницаСреза = Новый Граница(Период, ВидГраницы.Включая);
		ИначеЕсли Документы.ТипВсеСсылки().СодержитТип(ТипПериода) Тогда
			ГраницаСреза = Новый Граница(Период.МоментВремени(), ВидГраницы.Исключая);
		ИначеЕсли ТипПериода = Тип("Граница") Тогда
			ГраницаСреза = Период;
		КонецЕсли;
	Иначе
		ГраницаСреза = '00010101000000'; // Последнее актуальное значение регистра.
	КонецЕсли;
	Запрос.УстановитьПараметр("ГраницаСреза", ГраницаСреза);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	АмортизацияОС.ОсновноеСредство КАК ОсновноеСредство,
	|	АмортизацияОС.СчетУчетаЗатрат КАК СчетУчетаЗатрат,
	|	АмортизацияОС.Подразделение КАК Подразделение,
