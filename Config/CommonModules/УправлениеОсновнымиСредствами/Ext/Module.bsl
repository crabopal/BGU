	|	ПринятиеКУчетуОСОсновныеСредства.ИнвентарныйНомер.ДатаВыпуска КАК ДатаВыпуска,
	|	ПринятиеКУчетуОСОсновныеСредства.Сумма КАК пНачСтоимость,
	|	ВЫБОР
	|		КОГДА ПринятиеКУчетуОСОсновныеСредства.Количество = 0
	|			ТОГДА 0
	|		ИНАЧЕ ВЫРАЗИТЬ(ПринятиеКУчетуОСОсновныеСредства.Сумма / ПринятиеКУчетуОСОсновныеСредства.Количество КАК ЧИСЛО(18, 2))
	|	КОНЕЦ КАК пЦенаЕдиницы,
	|	ВЫБОР
	|		КОГДА ПринятиеКУчетуОСОсновныеСредства.ОсновноеСредство.ИзготовительОС.НаименованиеПолное = """"
	|			ТОГДА ПринятиеКУчетуОСОсновныеСредства.ОсновноеСредство.ИзготовительОС.Наименование
	|		ИНАЧЕ ПринятиеКУчетуОСОсновныеСредства.ОсновноеСредство.ИзготовительОС.НаименованиеПолное
	|	КОНЕЦ КАК Изготовитель,
	|	ПРЕДСТАВЛЕНИЕ(УчетныеДанныеОбъектаОССрезПоследних.СчетУчета) КАК СчетУчета,
	|	ПРЕДСТАВЛЕНИЕ(УчетныеДанныеОбъектаОССрезПоследних.СчетУчета.КОСГУДт) КАК КЭК,
	|	ВЫБОР
	|		КОГДА ПринятиеКУчетуОСОсновныеСредства.ОсновноеСредство.АмортизационнаяГруппа = ЗНАЧЕНИЕ(Перечисление.АмортизационныеГруппы.ПустаяСсылка)
	|			ТОГДА """"
	|		ИНАЧЕ ПринятиеКУчетуОСОсновныеСредства.ОсновноеСредство.АмортизационнаяГруппа.Порядок + 1
	|	КОНЕЦ КАК НомерАмортГруппы,
	|	ВЫБОР
	|		КОГДА ПринятиеКУчетуОСОсновныеСредства.ДатаВводаВЭксплуатацию = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА 0
	|		ИНАЧЕ ПринятиеКУчетуОСОсновныеСредства.Сумма - ПринятиеКУчетуОСОсновныеСредства.СуммаАмортизации
	|	КОНЕЦ КАК ОстСтоимость
	|ИЗ
	|	Документ.ПринятиеКУчетуОС.ОсновныеСредства КАК ПринятиеКУчетуОСОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
	|		ПО ПринятиеКУчетуОСОсновныеСредства.Ссылка = ОперацииДокументов.Документ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних КАК УчетныеДанныеОбъектаОССрезПоследних
	|		ПО ПринятиеКУчетуОСОсновныеСредства.ОсновноеСредство = УчетныеДанныеОбъектаОССрезПоследних.ОсновноеСредство
	|ГДЕ
	|	&ЕстьОС1б
	|	И ПринятиеКУчетуОСОсновныеСредства.Ссылка В(&МассивОбъектовОС1б)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомСтр
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПринятиеКУчетуЗданияСоставКомиссии.Ссылка КАК Ссылка,
	|	ПринятиеКУчетуЗданияСоставКомиссии.НомерСтроки КАК НомерСтроки,
	|	ПринятиеКУчетуЗданияСоставКомиссии.ДолжностьЧленаКомиссии КАК ДолжностьЧленаКомиссии,
	|	ПринятиеКУчетуЗданияСоставКомиссии.ФамилияЧленаКомиссии КАК ФамилияЧленаКомиссии,
	|	ПринятиеКУчетуЗданияСоставКомиссии.ИмяЧленаКомиссии КАК ИмяЧленаКомиссии,
	|	ПринятиеКУчетуЗданияСоставКомиссии.ОтчествоЧленаКомиссии КАК ОтчествоЧленаКомиссии
	|ИЗ
	|	Документ.ПринятиеКУчетуЗдания.СоставКомиссии КАК ПринятиеКУчетуЗданияСоставКомиссии
	|ГДЕ
	|	&ЕстьОС1а
	|	И ПринятиеКУчетуЗданияСоставКомиссии.Ссылка В(&МассивОбъектовОС1а)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПринятиеКУчетуОбъектаОССоставКомиссии.Ссылка,
	|	ПринятиеКУчетуОбъектаОССоставКомиссии.НомерСтроки,
	|	ПринятиеКУчетуОбъектаОССоставКомиссии.ДолжностьЧленаКомиссии,
	|	ПринятиеКУчетуОбъектаОССоставКомиссии.ФамилияЧленаКомиссии,
	|	ПринятиеКУчетуОбъектаОССоставКомиссии.ИмяЧленаКомиссии,
	|	ПринятиеКУчетуОбъектаОССоставКомиссии.ОтчествоЧленаКомиссии
	|ИЗ
	|	Документ.ПринятиеКУчетуОбъектаОС.СоставКомиссии КАК ПринятиеКУчетуОбъектаОССоставКомиссии
	|ГДЕ
	|	&ЕстьОС1_
	|	И ПринятиеКУчетуОбъектаОССоставКомиссии.Ссылка В(&МассивОбъектовОС1)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПринятиеКУчетуОССоставКомиссии.Ссылка,
	|	ПринятиеКУчетуОССоставКомиссии.НомерСтроки,
	|	ПринятиеКУчетуОССоставКомиссии.ДолжностьЧленаКомиссии,
	|	ПринятиеКУчетуОССоставКомиссии.ФамилияЧленаКомиссии,
	|	ПринятиеКУчетуОССоставКомиссии.ИмяЧленаКомиссии,
	|	ПринятиеКУчетуОССоставКомиссии.ОтчествоЧленаКомиссии
	|ИЗ
	|	Документ.ПринятиеКУчетуОС.СоставКомиссии КАК ПринятиеКУчетуОССоставКомиссии
	|ГДЕ
	|	&ЕстьОС1б
	|	И ПринятиеКУчетуОССоставКомиссии.Ссылка В(&МассивОбъектовОС1б)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОсновныеСредстваДополнительныеРеквизиты.Ссылка КАК ОсновноеСредство,
	|	ОсновныеСредстваДополнительныеРеквизиты.Свойство КАК Свойство,
	|	ОсновныеСредстваДополнительныеРеквизиты.Свойство.Заголовок КАК ПредставлениеСвойства,
	|	ОсновныеСредстваДополнительныеРеквизиты.Значение КАК Значение
	|ИЗ
	|	Справочник.ОсновныеСредства.ДополнительныеРеквизиты КАК ОсновныеСредстваДополнительныеРеквизиты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СписокОС КАК СписокОС
	|		ПО ОсновныеСредстваДополнительныеРеквизиты.Ссылка = СписокОС.ОсновноеСредство
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ДополнительныеСведения.Объект,
	|	ДополнительныеСведения.Свойство,
	|	ДополнительныеСведения.Свойство.Заголовок,
	|	ДополнительныеСведения.Значение
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СписокОС КАК СписокОС
	|		ПО ДополнительныеСведения.Объект = СписокОС.ОсновноеСредство
	|ГДЕ
	|	ДополнительныеСведения.Объект ССЫЛКА Справочник.ОсновныеСредства
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА КАК ОсновноеСредство,
	|	ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА КАК Справочник.ОсновныеСредства).НаименованиеПолное + "" / "" + ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОстатки.ИнвНомер КАК Справочник.ИнвентарныеНомераОС).Код КАК НазвДетали,
	|	ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОстатки.ВидДрагМатериала КАК Справочник.ДрагМеталлы).Наименование КАК Драгметалл,
	|	ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОстатки.ВидДрагМатериала КАК Справочник.ДрагМеталлы).Код КАК КодДрагМеталла,
	|	ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОстатки.ЕдИзм КАК Справочник.КлассификаторЕдиницИзмерения).Наименование КАК НазвЕИ,
	|	ЕСТЬNULL(НаличиеДрагМатериаловВОбъектахНФАОстатки.МассаДМОстаток, 0) КАК ВесДраг
	|ИЗ
	|	СписокОС КАК СписокОС
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.НаличиеДрагМатериаловВОбъектахНФА.Остатки КАК НаличиеДрагМатериаловВОбъектахНФАОстатки
	|		ПО СписокОС.ОсновноеСредство = НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА
	|			И СписокОС.ИнвентарныйНомер = НаличиеДрагМатериаловВОбъектахНФАОстатки.ИнвНомер";
	
	Если МассивОбъектовОС1.Количество() > 0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ЕстьОС1_", "ИСТИНА");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ЕстьОС1_", "ЛОЖЬ");
	КонецЕсли;
	Если МассивОбъектовОС1а.Количество() > 0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ЕстьОС1а", "ИСТИНА");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ЕстьОС1а", "ЛОЖЬ");
	КонецЕсли;
	Если МассивОбъектовОС1б.Количество() > 0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ЕстьОС1б", "ИСТИНА");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ЕстьОС1б", "ЛОЖЬ");
	КонецЕсли;
	Запрос.УстановитьПараметр("МассивОбъектов"		, МассивОбъектов);
	Запрос.УстановитьПараметр("МассивОбъектовОС1"	, МассивОбъектовОС1);
	Запрос.УстановитьПараметр("МассивОбъектовОС1а"	, МассивОбъектовОС1а);
	Запрос.УстановитьПараметр("МассивОбъектовОС1б"	, МассивОбъектовОС1б);
	Запрос.УстановитьПараметр("Счета101"			, БухгалтерскийУчет.СписокСчетов("101.00"));
	
	Возврат Запрос.ВыполнитьПакет();
		
КонецФункции // ДокументыДляПечатиАктОС1_ПринятиеКУчету()

Функция ДокументыДляПечатиАктОС1_Передача(МассивОбъектов, ПечататьОС1, ПечататьОС1а, ПечататьОС1б) Экспорт
	
	МассивОбъектовОС1 = Новый Массив;
	МассивОбъектовОС1а = Новый Массив;
	МассивОбъектовОС1б = Новый Массив;
	
	ТипДокументовОС1	= ОписаниеТиповДокументовОС1("ОС1", "Расход");
	ТипДокументовОС1а	= ОписаниеТиповДокументовОС1("ОС1а", "Расход");
	ТипДокументовОС1б	= ОписаниеТиповДокументовОС1("ОС1б", "Расход");
	
	Для каждого ТекДокумент Из МассивОбъектов Цикл
	
		ТипЗнчДок = ТипЗнч(ТекДокумент);
		Если ТипДокументовОС1а.СодержитТип(ТипЗнчДок) И ПечататьОС1а Тогда
			МассивОбъектовОС1а.Добавить(ТекДокумент);
		ИначеЕсли ТипДокументовОС1.СодержитТип(ТипЗнчДок) И ПечататьОС1 Тогда
			МассивОбъектовОС1.Добавить(ТекДокумент);
		ИначеЕсли ТипДокументовОС1б.СодержитТип(ТипЗнчДок) И ПечататьОС1б Тогда
			МассивОбъектовОС1б.Добавить(ТекДокумент);
		КонецЕсли;
	
	КонецЦикла;
	
	Запрос = Новый Запрос;	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("МассивОбъектов",		МассивОбъектов);
	Запрос.УстановитьПараметр("МассивОбъектовОС1",	МассивОбъектовОС1);
	Запрос.УстановитьПараметр("МассивОбъектовОС1а",	МассивОбъектовОС1а);
	Запрос.УстановитьПараметр("МассивОбъектовОС1б",	МассивОбъектовОС1б);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ПередачаЗдания.ОсновноеСредство,
	|	1 КАК ВидДок,
	|	ПередачаЗдания.ИнвентарныйНомер
	|ПОМЕСТИТЬ ВсеОСДокументов
	|ИЗ
	|	Документ.ПередачаЗдания КАК ПередачаЗдания
	|ГДЕ
	|	ПередачаЗдания.Ссылка В(&МассивОбъектовОС1а)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ПередачаОбъектаОС.ОсновноеСредство,
	|	0,
	|	ПередачаОбъектаОС.ИнвентарныйНомер
	|ИЗ
	|	Документ.ПередачаОбъектаОС КАК ПередачаОбъектаОС
	|ГДЕ
	|	ПередачаОбъектаОС.Ссылка В(&МассивОбъектовОС1)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ПередачаГруппОбъектовОСОсновныеСредства.ОсновноеСредство,
	|	2,
	|	ПередачаГруппОбъектовОСОсновныеСредства.ИнвентарныйНомер
	|ИЗ
	|	Документ.ПередачаГруппОбъектовОС.ОсновныеСредства КАК ПередачаГруппОбъектовОСОсновныеСредства
	|ГДЕ
	|	ПередачаГруппОбъектовОСОсновныеСредства.Ссылка В(&МассивОбъектовОС1б)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВсеОСДокументов.ОсновноеСредство
	|ИЗ
	|	ВсеОСДокументов КАК ВсеОСДокументов
	|ГДЕ
	|	ВсеОСДокументов.ВидДок = 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВсеОСДокументов.ОсновноеСредство
	|ИЗ
	|	ВсеОСДокументов КАК ВсеОСДокументов
	|ГДЕ
	|	ВсеОСДокументов.ВидДок = 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВсеОСДокументов.ОсновноеСредство
	|ИЗ
	|	ВсеОСДокументов КАК ВсеОСДокументов
	|ГДЕ
	|	ВсеОСДокументов.ВидДок = 2";
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	Запрос.УстановитьПараметр("Объекты_ОС1а", РезультатЗапроса[1].Выгрузить().ВыгрузитьКолонку("ОсновноеСредство"));
	Запрос.УстановитьПараметр("Объекты_ОС1", РезультатЗапроса[2].Выгрузить().ВыгрузитьКолонку("ОсновноеСредство"));
	Запрос.УстановитьПараметр("Объекты_ОС1б", РезультатЗапроса[3].Выгрузить().ВыгрузитьКолонку("ОсновноеСредство"));
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВсеОСДокументов.ОсновноеСредство КАК ОсновноеСредство,
	|	ВсеОСДокументов.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	МАКСИМУМ(ЕСТЬNULL(СобытияОСВводВЭкспл.ДатаСобытия, ДАТАВРЕМЯ(1, 1, 1))) КАК ДатаВводаВЭксплуатацию,
	|	МАКСИМУМ(ЕСТЬNULL(СобытияОСПринятиеКУчету.ДатаСобытия, ДАТАВРЕМЯ(1, 1, 1))) КАК ДатаПринятияКУчету
	|ПОМЕСТИТЬ ВсеОСДатыСобытий
	|ИЗ
	|	ВсеОСДокументов КАК ВсеОСДокументов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СобытияОС КАК СобытияОСПринятиеКУчету
	|		ПО ВсеОСДокументов.ОсновноеСредство = СобытияОСПринятиеКУчету.ОсновноеСредство
	|			И (СобытияОСПринятиеКУчету.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету))
	|			И ВсеОСДокументов.ИнвентарныйНомер = СобытияОСПринятиеКУчету.ИнвНомер
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СобытияОС КАК СобытияОСВводВЭкспл
	|		ПО ВсеОСДокументов.ОсновноеСредство = СобытияОСВводВЭкспл.ОсновноеСредство
	|			И ВсеОСДокументов.ИнвентарныйНомер = СобытияОСВводВЭкспл.ИнвНомер
	|			И (СобытияОСВводВЭкспл.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВводВЭксплуатацию))
	|
	|СГРУППИРОВАТЬ ПО
	|	ВсеОСДокументов.ОсновноеСредство,
	|	ВсеОСДокументов.ИнвентарныйНомер
	|;
	|
