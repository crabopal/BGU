	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаУчетаОС.ОсновноеСредство КАК ОсновноеСредство,
	               |	СУММА(ТаблицаУчетаОС.Количество) КАК Количество
	               |ПОМЕСТИТЬ ТаблицаОСИтог
	               |ИЗ
	               |	ТаблицаУчетаОС КАК ТаблицаУчетаОС
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТаблицаУчетаОС.ОсновноеСредство
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	ОсновноеСредство
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Т.ОсновноеСредство,
	               |	Т.ИнвентарныйНомер,
	               |	Т.Состояние,
	               |	Т.КоличествоВсего,
	               |	Т.КоличествоВЭксплуатации,
	               |	Т.БалансоваяСтоимость,
	               |	Т.КоличествоОстаток,
	               |	Т.БалансоваяСтоимостьМОЛ,
	               |	Т.КоличествоОстатокМОЛ,
	               |	Т.СуммаАмортизации,
	               |	Т.Амортизация,
	               |	Т.СтоимостьЕдиницы,
	               |	Т.СтоимостьЕдиницыНеокругленная,
	               |	Т.ОсновноеСредствоНаименование,
	               |	Т.ОсновноеСредствоКод,
	               |	Т.ИнвентарныйНомерКод,
	               |	Т.КоличествоВДокументе,
	               |	ВЫБОР
	               |		КОГДА Т.ИнвентарныйНомер <> ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
	               |				И Т.КоличествоВДокументе = Т.КоличествоОстатокМОЛ
	               |				И Т.СтоимостьЕдиницы <> Т.СтоимостьЕдиницыНеокругленная
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК ТребуетсяПроверка,
	               |	Т.КПСТаблицы,
	               |	Т.КПСОстатков
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ТаблицаОСпоМОЛ.ОсновноеСредство КАК ОсновноеСредство,
	               |		ТаблицаОСпоМОЛ.ИнвНомер КАК ИнвентарныйНомер,
	               |		ТаблицаОСпоМОЛ.Состояние КАК Состояние,
	               |		ТаблицаОСпоМОЛ.КоличествоВсего КАК КоличествоВсего,
	               |		ТаблицаОСпоМОЛ.КоличествоВЭксплуатации КАК КоличествоВЭксплуатации,
	               |		ЕСТЬNULL(ОстаткиБалансВсего.БалансоваяСтоимость, 0) КАК БалансоваяСтоимость,
	               |		ЕСТЬNULL(ОстаткиБалансВсего.КоличествоОстаток, 0) КАК КоличествоОстаток,
	               |		ЕСТЬNULL(ОстаткиБалансВсего.БалансоваяСтоимостьЦМО, 0) КАК БалансоваяСтоимостьМОЛ,
	               |		ЕСТЬNULL(ОстаткиБалансВсего.КоличествоОстатокЦМО, 0) КАК КоличествоОстатокМОЛ,
	               |		ЕСТЬNULL(ОстаткиАмортизация.СуммаОстатокКт, 0) КАК СуммаАмортизации,
	               |		ВЫБОР
	               |			КОГДА ТаблицаОСпоМОЛ.ПорядокПогашенияСтоимости = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации)
	               |				ТОГДА ВЫБОР
	               |						КОГДА ТаблицаОСпоМОЛ.СпособНачисленияАмортизации = ЗНАЧЕНИЕ(Перечисление.СпособНачисленияАмортизации.ПриВводеВЭксплуатацию)
	               |							ТОГДА ВЫБОР
	               |									КОГДА ТаблицаОСпоМОЛ.ВведеноВЭксплуатацию = ИСТИНА
	               |										ТОГДА ВЫБОР
	               |												КОГДА ЕСТЬNULL(ТаблицаОСпоМОЛ.КоличествоВЭксплуатации, 0) <> 0
	               |													ТОГДА ВЫРАЗИТЬ(ЕСТЬNULL(ОстаткиАмортизация.СуммаОстатокКт, 0) / ЕСТЬNULL(ТаблицаОСпоМОЛ.КоличествоВЭксплуатации, 0) КАК ЧИСЛО(18, 2))
	               |												ИНАЧЕ ВЫРАЗИТЬ(0 КАК ЧИСЛО(18, 2))
	               |											КОНЕЦ
	               |									ИНАЧЕ 0
	               |								КОНЕЦ
	               |						КОГДА ТаблицаОСпоМОЛ.СпособНачисленияАмортизации = ЗНАЧЕНИЕ(Перечисление.СпособНачисленияАмортизации.Линейный)
	               |							ТОГДА ЕСТЬNULL(ОстаткиАмортизация.СуммаОстатокКт, ВЫРАЗИТЬ(0 КАК ЧИСЛО(18, 2)))
	               |						ИНАЧЕ ВЫРАЗИТЬ(0 КАК ЧИСЛО(18, 2))
	               |					КОНЕЦ
	               |			ИНАЧЕ ВЫРАЗИТЬ(0 КАК ЧИСЛО(18, 2))
	               |		КОНЕЦ КАК Амортизация,
	               |		ВЫБОР
	               |			КОГДА ЕСТЬNULL(ОстаткиБалансВсего.КоличествоОстатокЦМО, 0) <> 0
	               |				ТОГДА ВЫРАЗИТЬ(ОстаткиБалансВсего.БалансоваяСтоимостьЦМО / ОстаткиБалансВсего.КоличествоОстатокЦМО КАК ЧИСЛО(18, 2))
	               |			ИНАЧЕ ВЫРАЗИТЬ(0 КАК ЧИСЛО(18, 2))
	               |		КОНЕЦ КАК СтоимостьЕдиницы,
	               |		ВЫБОР
	               |			КОГДА ЕСТЬNULL(ОстаткиБалансВсего.КоличествоОстатокЦМО, 0) <> 0
	               |				ТОГДА ВЫРАЗИТЬ(ОстаткиБалансВсего.БалансоваяСтоимостьЦМО / ОстаткиБалансВсего.КоличествоОстатокЦМО КАК ЧИСЛО(19, 3))
	               |			ИНАЧЕ ВЫРАЗИТЬ(0 КАК ЧИСЛО(19, 3))
	               |		КОНЕЦ КАК СтоимостьЕдиницыНеокругленная,
	               |		ТаблицаОСпоМОЛ.ОсновноеСредство.Наименование КАК ОсновноеСредствоНаименование,
	               |		ТаблицаОСпоМОЛ.ОсновноеСредство.Код КАК ОсновноеСредствоКод,
	               |		ТаблицаОСпоМОЛ.ИнвНомер.Код КАК ИнвентарныйНомерКод,
	               |		ТаблицаОСИтог.Количество КАК КоличествоВДокументе,
	               |		ТаблицаУчетаОС.КПС КАК КПСТаблицы,
	               |		ОстаткиБалансВсего.КПС КАК КПСОстатков
	               |	ИЗ
	               |		ТаблицаУчетаОС КАК ТаблицаУчетаОС
	               |			ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаОСпоМОЛ КАК ТаблицаОСпоМОЛ
	               |				ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиБалансВсего КАК ОстаткиБалансВсего
	               |				ПО ТаблицаОСпоМОЛ.ОсновноеСредство = ОстаткиБалансВсего.ОсновноеСредство
	               |				ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиАмортизация КАК ОстаткиАмортизация
	               |				ПО ТаблицаОСпоМОЛ.ОсновноеСредство = ОстаткиАмортизация.ОсновноеСредство
	               |			ПО ТаблицаУчетаОС.ОсновноеСредство = ТаблицаОСпоМОЛ.ОсновноеСредство
	               |				И ТаблицаУчетаОС.ИнвентарныйНомер = ТаблицаОСпоМОЛ.ИнвНомер
	               |			ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаОСИтог КАК ТаблицаОСИтог
	               |			ПО ТаблицаУчетаОС.ОсновноеСредство = ТаблицаОСИтог.ОсновноеСредство) КАК Т";
	
	СубконтоОС = Новый Массив;
	СубконтоОС.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	СубконтоОСЦМО = Новый Массив;
	СубконтоОСЦМО.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	СубконтоОСЦМО.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Если НЕ ЗначениеЗаполнено(ПараметрыПолученияОстатков.Ссылка) Тогда
		ПериодОстатков = Новый Граница(ПараметрыПолученияОстатков.Период, ВидГраницы.Включая);
	Иначе
		ПериодОстатков = Новый Граница(ПараметрыПолученияОстатков.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;
	Запрос.УстановитьПараметр("Период",			ПериодОстатков);
	Запрос.УстановитьПараметр("Организация",	ПараметрыПолученияОстатков.Организация);
	Запрос.УстановитьПараметр("КПС", 			ПараметрыПолученияОстатков.КПС);
	Запрос.УстановитьПараметр("ПоВсемКПС", 		НЕ ЗначениеЗаполнено(ПараметрыПолученияОстатков.КПС));
	Запрос.УстановитьПараметр("КФО", 			ПараметрыПолученияОстатков.КФО);
	Запрос.УстановитьПараметр("ЦМО",			ПараметрыПолученияОстатков.ЦМО);
	Запрос.УстановитьПараметр("СубконтоОС",		СубконтоОС);
	Запрос.УстановитьПараметр("СубконтоОСЦМО",	СубконтоОСЦМО);
	Если ПараметрыПолученияОстатков.ТаблицаОС.Количество() > 0 Тогда
		ТаблицаОС = ПараметрыПолученияОстатков.ТаблицаОС;
	Иначе
		ТаблицаОС = ПустаяТаблицаОСДляРасчетаОстатков();
		НоваяСтрока = ТаблицаОС.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ПараметрыПолученияОстатков, "ОсновноеСредство, ИнвентарныйНомер");
		НоваяСтрока.Количество = 1;
	КонецЕсли;
	Запрос.УстановитьПараметр("ТаблицаОС",		ТаблицаОС);
	Если ПараметрыПолученияОстатков.ИспользоватьУчетПоИФО Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИФО = &ИФО");
		Запрос.УстановитьПараметр("ИФО",		ПараметрыПолученияОстатков.ИФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИСТИНА");
	КонецЕсли;
	Если ПараметрыПолученияОстатков.ИспользоватьУчетПоПодразделениям Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПодразделениеБаланс", "ВЫБОР
	               |			КОГДА ИСТИНА В
	               |					(ВЫБРАТЬ ПЕРВЫЕ 1
	               |						ИСТИНА
	               |					ИЗ
	               |						ТаблицаСчетов КАК ТаблицаСчетов
	               |					ГДЕ
	               |						ТаблицаСчетов.СчетУчета = ЖурналПроводокЕПСБУОстатки.Счет
	               |						И ТаблицаСчетов.УчетПоПодразделениямБаланс = ИСТИНА)
	               |				ТОГДА ВЫБОР
	               |						КОГДА ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) = &Подразделение
	               |							ТОГДА ИСТИНА
	               |						ИНАЧЕ ЛОЖЬ
	               |					КОНЕЦ
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПодразделениеАморт", "ВЫБОР
	               |			КОГДА ИСТИНА В
	               |					(ВЫБРАТЬ ПЕРВЫЕ 1
	               |						ИСТИНА
	               |					ИЗ
	               |						ТаблицаСчетов КАК ТаблицаСчетов
	               |					ГДЕ
	               |						ТаблицаСчетов.СчетАмортизации = ЖурналПроводокЕПСБУОстатки.Счет
	               |						И ТаблицаСчетов.УчетПоПодразделениямАморт = ИСТИНА
	               |						И ТаблицаСчетов.СчетАмортизации <> ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка))
	               |				ТОГДА ВЫБОР
	               |						КОГДА ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) = &Подразделение
	               |							ТОГДА ИСТИНА
	               |						ИНАЧЕ ЛОЖЬ
	               |					КОНЕЦ
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ");				   
		Запрос.УстановитьПараметр("Подразделение", ПараметрыПолученияОстатков.Подразделение);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЖурналПроводокЕПСБУОстатки.Подразделение", "ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПодразделениеБаланс", "ИСТИНА");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПодразделениеАморт", "ИСТИНА");
	КонецЕсли;
	
	ТаблицаОстатков = Запрос.Выполнить().Выгрузить();
	ТребующиеПроверки = ТаблицаОстатков.Скопировать(Новый Структура("ТребуетсяПроверка", Истина), 
													"ОсновноеСредство, БалансоваяСтоимостьМОЛ, СуммаАмортизации, СтоимостьЕдиницы, Амортизация");
	ТребующиеПроверки.Свернуть("ОсновноеСредство, БалансоваяСтоимостьМОЛ, СуммаАмортизации", "СтоимостьЕдиницы, Амортизация");
	Для каждого ТекТребующийПроверки Из ТребующиеПроверки Цикл
	
		Погрешность = ТекТребующийПроверки.БалансоваяСтоимостьМОЛ - ТекТребующийПроверки.СтоимостьЕдиницы;
		Если Погрешность <> 0 Тогда
			СтрокиОС = ТаблицаОстатков.НайтиСтроки(Новый Структура("ОсновноеСредство", ТекТребующийПроверки.ОсновноеСредство));
			Если ТекТребующийПроверки.СуммаАмортизации <> ТекТребующийПроверки.Амортизация Тогда
				// требуется корректировка амортизации: корректировки ставим в первый объект с амортизацией
				Для каждого ТекСтрокаОС Из СтрокиОС Цикл
					Если ТекСтрокаОС.Амортизация <> 0 Тогда
						
						ТекСтрокаОС.СтоимостьЕдиницы	= ТекСтрокаОС.СтоимостьЕдиницы	+ Погрешность;	
						ТекСтрокаОС.Амортизация 		= ТекСтрокаОС.Амортизация 		+ Погрешность;
						Прервать;
						
					КонецЕсли;
				КонецЦикла;
			Иначе
				// не требуется корректировка амортизации: корректировки ставим в первый объект без амортизации
				Для каждого ТекСтрокаОС Из СтрокиОС Цикл
					Если ТекСтрокаОС.Амортизация = 0 Тогда
						
						ТекСтрокаОС.СтоимостьЕдиницы = ТекСтрокаОС.СтоимостьЕдиницы + Погрешность;	
						Прервать;
						
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	
	КонецЦикла; 
	
	Возврат ТаблицаОстатков;

КонецФункции // ОстаткиОСНМАНПАбаланс()

// Получает данные из таблицы остатков ОС полученных из функции ОстаткиОСНМАНПАбаланс
// Параметры:
//	ОстаткиОС - ТаблицаЗначений - результат функции ОстаткиОСНМАНПАбаланс
//	ОсновноеСредство - СправочникСсылка.ОсновноеСредство
//	ИнвентарныйНомер - СправочникСсылка.ИнвентарныеНомераОС - если ОС без инв. номера, то передавать пустую ссылку
//	Количество - Число - запрашиваемое количество ОС
// Возвращаемые параметры:
//	Цена - Число
//	Сумма - Число - если запрашиваемое количество <> количеству остатка, то стоимость расчитывается как цена * Сумма
//	СуммаАмортизации - Число - необязательный. Если ИнвентарныйНомер не заполнен, то СуммаАмортизации = 0. 
//
Процедура ЗаполнитьДанныеОстатковОСизТаблицыОстатков(ОстаткиОС, ОсновноеСредство, ИнвентарныйНомер, Количество, Цена, Сумма, СуммаАмортизации = 0, ЭтоБиблиотечныйФонд = Ложь) Экспорт
	
	СтруктураПоиска = Новый Структура("ОсновноеСредство, ИнвентарныйНомер", ОсновноеСредство, ИнвентарныйНомер);	
	Цена 				= 0;
	Сумма 				= 0;
	СуммаАмортизации	= 0;
	СтрокиОстатков = ОстаткиОС.НайтиСтроки(СтруктураПоиска);
	Если СтрокиОстатков.Количество() > 0 Тогда
		СтрокаОстатков	= СтрокиОстатков[0];
		Цена 			= СтрокаОстатков.СтоимостьЕдиницы;
		Если ЗначениеЗаполнено(ИнвентарныйНомер) Тогда
			Сумма 				= Количество * Цена;
			СуммаАмортизации	= Количество * СтрокаОстатков.Амортизация;
		Иначе
			Если Количество = СтрокаОстатков.КоличествоОстатокМОЛ Тогда
				Сумма = СтрокаОстатков.БалансоваяСтоимостьМОЛ;
			Иначе
				Сумма = Количество * Цена;
			КонецЕсли;
			Если ЭтоБиблиотечныйФонд = Истина Тогда
				Если СтрокаОстатков.КоличествоОстаток <> 0
					И СтрокаОстатков.КоличествоОстаток <> Количество Тогда
					СуммаАмортизации = Количество * СтрокаОстатков.СуммаАмортизации / СтрокаОстатков.КоличествоОстаток;
				Иначе
					СуммаАмортизации = СтрокаОстатков.СуммаАмортизации;
				КонецЕсли;
				СуммаАмортизации = Мин(СуммаАмортизации, Сумма);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПолучитьОстаткиОСпоТаблицеОстатковОпер(ТаблицаОС, ОсновноеСредство, Сумма, Количество = 0, Цена = 0) Экспорт
	
	КоличествоВТаблице = ТаблицаОС.Количество();
	Если КоличествоВТаблице = 0 Тогда
		Количество 	= 0;
		Сумма		= 0;
		Цена		= 0;
		Возврат;
	КонецЕсли;
	
	//ТекСтрокаОС = ТаблицаОС[0];
	ТекСтрокаОС = ТаблицаОС.Найти(ОсновноеСредство, "ОсновноеСредство");
	Если ТекСтрокаОС = Неопределено Тогда
		Цена		= 0;
		Количество	= 0;
		Сумма		= 0;
	Иначе
		
		Цена				= ТекСтрокаОС.Цена;
		Если Количество = 0 Тогда
			Количество = 1;
		ИначеЕсли Количество > ТекСтрокаОС.Количество Тогда
			Количество = ТекСтрокаОС.Количество;
		КонецЕсли;
		
		Если Количество = ТекСтрокаОС.Количество Тогда
			Сумма = ТекСтрокаОС.Сумма;
		Иначе
			Сумма = Количество * Цена;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура РассчитатьТекущуюСтрокуСписанияОС(ТекущаяСтрока, ПараметрыРасчета, ДополнительныеРеквизиты = Неопределено) Экспорт
	Перем ВидУчета, ПериодОстатков, Организация, ИФО, КФО, КПС, ЦМО, Подразделение, Ссылка, ВыбраныИнвНомера;
	
	ПолучитьРеквизитыОсновногоСредства(ТекущаяСтрока, ДополнительныеРеквизиты);
	ПараметрыРасчета.Свойство("ВидУчета", 			ВидУчета);
	ПараметрыРасчета.Свойство("ПериодОстатков",		ПериодОстатков);
	ПараметрыРасчета.Свойство("Организация",		Организация);
	ПараметрыРасчета.Свойство("ИФО", 				ИФО);
	ПараметрыРасчета.Свойство("КФО", 				КФО);
	ПараметрыРасчета.Свойство("КПС", 				КПС);
	ПараметрыРасчета.Свойство("ЦМО", 				ЦМО);
	ПараметрыРасчета.Свойство("Подразделение", 		Подразделение);
	ПараметрыРасчета.Свойство("Ссылка", 			Ссылка);
	ПараметрыРасчета.Свойство("ВыбраныИнвНомера",	ВыбраныИнвНомера);
	ЕстьИнвентарныйНомер = ТекущаяСтрока.Свойство("ИнвентарныйНомер");
	ЕстьСуммаАмортизации = ТекущаяСтрока.Свойство("СуммаАмортизации");
	
	Если ВидУчета = 0 Тогда	
		ТаблицаОС = ОпределитьСтоимостьСпискаОС(ТекущаяСтрока.ОсновноеСредство,
												ПериодОстатков,
												Организация,
												КФО,
												КПС,
												ЦМО,
												ИФО,
												Подразделение,
												Ссылка);
		ПолучитьОстаткиОСпоТаблицеОстатков(	ТаблицаОС,
											ТекущаяСтрока.ОсновноеСредство, 
											?(ЕстьИнвентарныйНомер, ТекущаяСтрока.ИнвентарныйНомер, Неопределено), 
											ТекущаяСтрока.Количество, 
											ТекущаяСтрока.Сумма, 
											?(ЕстьСуммаАмортизации, ТекущаяСтрока.СуммаАмортизации, 0), 
											ТекущаяСтрока.Цена, 
											ВыбраныИнвНомера); 
	ИначеЕсли ВидУчета = 1 Тогда
		ТаблицаОС = ОпределитьЗабСтоимостьСпискаОС(	ТекущаяСтрока.ОсновноеСредство,
													ПериодОстатков,
													Организация,
													КФО,
													КПС,
													ЦМО,
													ИФО,
													Подразделение);
		ПолучитьОстаткиОСпоТаблицеОстатковОпер(	ТаблицаОС, 
												ТекущаяСтрока.ОсновноеСредство, 
												ТекущаяСтрока.Сумма, 
												ТекущаяСтрока.Количество, 
												ТекущаяСтрока.Цена);
	КонецЕсли;
	
КонецПроцедуры

// Устарела. Для чтения параметров учетной политики следует использовать функции чтения учетной политики,
// например, Справочники.Организации.ПолучитьУчетнуюПолитику(...).
// Функция определяет ведется ли аналитический учет имущества казны
//
Функция ВестиАналитическийУчетКазны(ДатаРасчета, Организация) Экспорт
	ВестиПоАналитике = Ложь;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаРасчета", ДатаРасчета);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УчетнаяПолитикаОрганизацийСрезПоследних.Организация,
	|	УчетнаяПолитикаОрганизацийСрезПоследних.ВедениеАналитическогоУчетаИмуществаКазны
	|ИЗ
	|	РегистрСведений.УчетнаяПолитикаОрганизаций.СрезПоследних(&ДатаРасчета, Организация = &Организация) КАК УчетнаяПолитикаОрганизацийСрезПоследних";
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		ВестиПоАналитике = Результат.ВедениеАналитическогоУчетаИмуществаКазны;
	КонецЕсли;
	Возврат ВестиПоАналитике;
КонецФункции

// Устарела.
// Функция возвращает фиксированную структуру содержащую все значения перечисления с
// с переданным именем.
//
// Параметры
//  ИмяПеречисления - Имя перечисления, для которого требуется получить структуру со значениями.
//
// Возвращаемое значение:
//   ФиксированнаяСтруктура - ФиксированнаяСтруктура содержащая значения перечисления.
//   	Ключ - имя значения, Знеачение - значение перечисления (ссылка).
//
Функция ПолучитьСтруктуруСоЗначениямиПеречисления(Знач ИмяПеречисления) Экспорт
	
	Результат = Новый Структура;
	Для каждого МетаданныеЗначения Из Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления Цикл
		Результат.Вставить(МетаданныеЗначения.Имя, Перечисления[ИмяПеречисления][МетаданныеЗначения.Имя]);
	КонецЦикла;
	
	Возврат Новый ФиксированнаяСтруктура(Результат);
	
КонецФункции

// Устарела.
// Функция возвращает фиксированное соответствие содержащее все значения перечисления с
// с переданным именем.
//
// Параметры
//  ИмяПеречисления - Имя перечисления, для которого требуется получить структуру со значениями.
//
// Возвращаемое значение:
//   ФиксированноеСоответствие - ФиксированноеСоответствие содержащее значения перечисления.
//   	Ключ - значения перечисления, Знеачение - имя значение перечисления.
//
Функция ПолучитьСоответствиеЗначенийПеречисленияИменам(ИмяПеречисления) Экспорт
	
	Результат = Новый Соответствие;
	Для каждого МетаданныеЗначения Из Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления Цикл
		Результат.Вставить(Перечисления[ИмяПеречисления][МетаданныеЗначения.Имя], МетаданныеЗначения.Имя);
	КонецЦикла;
	
	Возврат Новый ФиксированноеСоответствие(Результат);
	
КонецФункции

