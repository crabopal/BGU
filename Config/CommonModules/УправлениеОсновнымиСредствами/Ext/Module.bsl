Функция ОписаниеТиповДокументовОС1(ИмяАкта = Неопределено, ВидДвижения = Неопределено)
	
	ТипДокум = Новый Массив;
	Если ИмяАкта = Неопределено ИЛИ ИмяАкта = "ОС1" Тогда
		Если ВидДвижения = Неопределено ИЛИ ВидДвижения = "Приход" Тогда
			ТипДокум.Добавить(Тип("ДокументСсылка.ПринятиеКУчетуОбъектаОС"));
		КонецЕсли;
		Если ВидДвижения = Неопределено ИЛИ ВидДвижения = "Расход" Тогда
			ТипДокум.Добавить(Тип("ДокументСсылка.ПередачаОбъектаОС"));
		КонецЕсли;
	КонецЕсли;
	Если ИмяАкта = Неопределено ИЛИ ИмяАкта = "ОС1а" Тогда
		Если ВидДвижения = Неопределено ИЛИ ВидДвижения = "Приход" Тогда
			ТипДокум.Добавить(Тип("ДокументСсылка.ПринятиеКУчетуЗдания"));
		КонецЕсли;
		Если ВидДвижения = Неопределено ИЛИ ВидДвижения = "Расход" Тогда
			ТипДокум.Добавить(Тип("ДокументСсылка.ПередачаЗдания"));
		КонецЕсли;
	КонецЕсли;
	Если ИмяАкта = Неопределено ИЛИ ИмяАкта = "ОС1б" Тогда
		Если ВидДвижения = Неопределено ИЛИ ВидДвижения = "Приход" Тогда
			ТипДокум.Добавить(Тип("ДокументСсылка.ПринятиеКУчетуОС"));
		КонецЕсли;
		Если ВидДвижения = Неопределено ИЛИ ВидДвижения = "Расход" Тогда
			ТипДокум.Добавить(Тип("ДокументСсылка.ПередачаГруппОбъектовОС"));
		КонецЕсли;
	КонецЕсли;
	Возврат Новый ОписаниеТипов(ТипДокум);
	
КонецФункции

Функция ПлатежныеРеквизитыПоТребованиюБанка(ЛицевойСчет, РеквизитыЛицевогоСчета)
	
	Рекв = "";
	Если ЗначениеЗаполнено(РеквизитыЛицевогоСчета) Тогда
		РеквизитыПлательщика = Новый Структура("НомерСчетаПлательщика, НаименованиеБанкаПлательщика, БикБанкаПлательщика, СчетБанкаПлательщика",
												"СчетНомер", "Банк", "БИК", "КоррСчет");
		ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(ЛицевойСчет,
																				РеквизитыЛицевогоСчета,	
																				РеквизитыПлательщика);
		Рекв = "счет № " + РеквизитыПлательщика.НомерСчетаПлательщика 
			 + " в " + РеквизитыПлательщика.НаименованиеБанкаПлательщика 
			 + ", БИК " + РеквизитыПлательщика.БикБанкаПлательщика 
			 + ?(ЗначениеЗаполнено(РеквизитыПлательщика.СчетБанкаПлательщика),", кор.счет " + РеквизитыПлательщика.СчетБанкаПлательщика, "");

	КонецЕсли;
	Возврат Рекв;	 

КонецФункции

Функция ПредставлениеАдреса(Организация)

	Если ТипЗнч(Организация) = Тип("СправочникСсылка.Организации") Тогда
		Адрес	= УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Организация,
													Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);		
		Телефон	= УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Организация, 
													Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации);		
		Факс	= УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Организация, 
													Справочники.ВидыКонтактнойИнформации.ФаксОрганизации);
	Иначе
		Адрес	= Справочники.Контрагенты.ПолучитьКонтактнуюИнформацию(Организация, 
																	   Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты);
		Телефон = Справочники.Контрагенты.ПолучитьКонтактнуюИнформацию(Организация, 
																	   Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагенты);
		Факс	= "";
	КонецЕсли;
	
	Возврат "" + Адрес + ?(ПустаяСтрока(Телефон), "", ", тел.: "+Телефон) + ?(ПустаяСтрока(Факс), "", ", факс: "+Факс);

КонецФункции // ПредставлениеАдреса()

Процедура ЗаполнитьДанныеОтветственногоЛица(Организация, Дата, ВидОтветственногоЛица, ФИО = "", Должность = "")
	
	ОтветственноеЛицо = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(ВидОтветственногоЛица,
																						 Организация,
																						 Дата);
	ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность", 
										ОтветственноеЛицо.ОтветственноеЛицоСсылка, Дата);
	Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
	Должность = ДанныеСотрудника.Должность;
	ФИО = КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина);

КонецПроцедуры

Процедура НапечататьОС1(ДанныеДокументов, ОбъектыПечати, ТабличныйДокумент) Экспорт

	ВыборкаДокументы			= ДанныеДокументов[1].Выбрать();
	ВыборкаОбъекты				= ДанныеДокументов[2].Выбрать();
	ВыборкаКомиссии				= ДанныеДокументов[3].Выбрать();
	ВыборкаХарактеристики		= ДанныеДокументов[4].Выбрать();
	ВыборкаДрагМеталлы			= ДанныеДокументов[5].Выбрать();
	Если ДанныеДокументов.Количество() > 6 Тогда
		ВыбораАмортизацияТекМесяца	= ДанныеДокументов[6].Выгрузить();
	Иначе
		ВыбораАмортизацияТекМесяца = Новый ТаблицаЗначений;
	КонецЕсли;
	
    ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ПринятиеКУчетуОС_ОС1";
	
	ПервыйДокумент = Истина;
	
	ТипДокументовОС1	= ОписаниеТиповДокументовОС1("ОС1");
	ТипДокументовОС1а	= ОписаниеТиповДокументовОС1("ОС1а");
	ТипДокументовОС1б	= ОписаниеТиповДокументовОС1("ОС1б");
	
	ТипДокументовПриход = ОписаниеТиповДокументовОС1(,"Приход");
	
	Пока ВыборкаДокументы.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		
    	НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		Если ТипДокументовОС1.СодержитТип(ТипЗнч(ВыборкаДокументы.Ссылка)) Тогда
			ВидПечати = "ОС1";
		ИначеЕсли ТипДокументовОС1а.СодержитТип(ТипЗнч(ВыборкаДокументы.Ссылка)) Тогда
			ВидПечати = "ОС1а";
		ИначеЕсли ТипДокументовОС1б.СодержитТип(ТипЗнч(ВыборкаДокументы.Ссылка)) Тогда
			ВидПечати = "ОС1б";
		КонецЕсли;
		ВидДвижения = ?(ТипДокументовПриход.СодержитТип(ТипЗнч(ВыборкаДокументы.Ссылка)), "Приход", "Расход");
		
		Если ВидПечати = "ОС1" Тогда
			Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_ОС_1");
			ОбластьСтр_1 			= Макет.ПолучитьОбласть("Стр_1");
			ОбластьСтр_2 			= Макет.ПолучитьОбласть("Стр_2");
			ОбластьСтр_2_1 			= Макет.ПолучитьОбласть("Стр_2_1");
			ОбластьДрагметалл 		= Макет.ПолучитьОбласть("Драгметалл");
			ОбластьДрагметалл_2		= Макет.ПолучитьОбласть("Дрметалл_2");
			ОбластьСтр_2_2 			= Макет.ПолучитьОбласть("Стр_2_2");
			ОбластьХарактеристики	= Макет.ПолучитьОбласть("Характеристики");
			ОбластьСтр_2_3 			= Макет.ПолучитьОбласть("Стр_2_3");
			ОбластьСтр_3_1 			= Макет.ПолучитьОбласть("Стр_3_1");
			ОбластьКомиссия 		= Макет.ПолучитьОбласть("Комиссия");
			ОбластьСтр_3_2 			= Макет.ПолучитьОбласть("Стр_3_2");
		ИначеЕсли ВидПечати = "ОС1а" Тогда
			Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_ОС_1а");
			ОбластьСтр_1 			= Макет.ПолучитьОбласть("Стр_1");
			ОбластьСтр_2 			= Макет.ПолучитьОбласть("Стр_2");
			ОбластьСтр_2_1 			= Макет.ПолучитьОбласть("Стр_2_1");
			ОбластьХарактеристики	= Макет.ПолучитьОбласть("Характеристики");
			ОбластьДрагметалл 		= Макет.ПолучитьОбласть("Драгметалл");
			ОбластьДрагметалл_2		= Макет.ПолучитьОбласть("Драгметалл_2");
			ОбластьСтр_2_2 			= Макет.ПолучитьОбласть("Стр_2_2");
			ОбластьСтр_3_1 			= Макет.ПолучитьОбласть("Стр_3_1");
			ОбластьКомиссия 		= Макет.ПолучитьОбласть("Комиссия");
			ОбластьСтр_3_2 			= Макет.ПолучитьОбласть("Стр_3_2");
		ИначеЕсли ВидПечати = "ОС1б" Тогда
			Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_ОС_1б");
			ОбластьСтр_1 		= Макет.ПолучитьОбласть("Шапка1");
			ОбластьШапка2		= Макет.ПолучитьОбласть("Шапка2");
			ОбластьСтр_2 		= Макет.ПолучитьОбласть("Строка2");
			ОбластьСтрока2П 	= Макет.ПолучитьОбласть("Строка2П");
			ОбластьПодвал2_1 	= Макет.ПолучитьОбласть("Подвал2_1");
			ОбластьКомиссия 	= Макет.ПолучитьОбласть("Комиссия");
			ОбластьПодвал2_2	= Макет.ПолучитьОбласть("Подвал2_2");
			ОбластьШапка3 		= Макет.ПолучитьОбласть("Шапка3");
			ОбластьСтрока3 		= Макет.ПолучитьОбласть("Строка3");
			ОбластьСтрока3П 	= Макет.ПолучитьОбласть("Строка3П");
			ОбластьПодвал3 		= Макет.ПолучитьОбласть("Подвал3");
			ОбластьШапка4 		= Макет.ПолучитьОбласть("Шапка4");
			ОбластьСтрока4 		= Макет.ПолучитьОбласть("Строка4");
			ОбластьПодвал4 		= Макет.ПолучитьОбласть("Подвал4");
		КонецЕсли;
		
		// --------------- подготовка значений параметров ------------------
		
		МассивОбластейКомиссии = Новый Массив;
		
		пСтатусЧленаКомиссии	= "Председатель комиссии";
		пДолжностьЧленаКомиссии = ВыборкаДокументы.ДолжностьПредседателяКомиссии;
		пЧленКомиссии			= КорреспондентыКлиентСервер.ФИО(Новый Структура("Фамилия, Имя, Отчество",
		               																ВыборкаДокументы.ФамилияПредседателяКомиссии,
		               																ВыборкаДокументы.ИмяПредседателяКомиссии,
		               																ВыборкаДокументы.ОтчествоПредседателяКомиссии));
		ОбластьКомиссия_Параметры = Новый Структура("пСтатусЧленаКомиссии,пДолжностьЧленаКомиссии,пЧленКомиссии",
								 					 пСтатусЧленаКомиссии,пДолжностьЧленаКомиссии,пЧленКомиссии);																		
		ОбластьКомиссия = Макет.ПолучитьОбласть("Комиссия");																		
		ОбластьКомиссия.Параметры.Заполнить(ОбластьКомиссия_Параметры);
		МассивОбластейКомиссии.Добавить(ОбластьКомиссия);
		
		пСтатусЧленаКомиссии = "Члены комиссии:";
		СтруктураПоиска = Новый Структура("Ссылка", ВыборкаДокументы.Ссылка);
		ВыборкаКомиссии.Сбросить();
		КоличествоЧленовКомиссии = 0;
		Пока ВыборкаКомиссии.НайтиСледующий(СтруктураПоиска) Цикл
			
			пДолжностьЧленаКомиссии = ВыборкаКомиссии.ДолжностьЧленаКомиссии;
			пЧленКомиссии			= КорреспондентыКлиентСервер.ФИО(Новый Структура("Фамилия, Имя, Отчество",
				               																ВыборкаКомиссии.ФамилияЧленаКомиссии,
				               																ВыборкаКомиссии.ИмяЧленаКомиссии,
				               																ВыборкаКомиссии.ОтчествоЧленаКомиссии));
			ОбластьКомиссия_Параметры = Новый Структура("пСтатусЧленаКомиссии,пДолжностьЧленаКомиссии,пЧленКомиссии",
														 пСтатусЧленаКомиссии,пДолжностьЧленаКомиссии,пЧленКомиссии);																		
			ОбластьКомиссия = Макет.ПолучитьОбласть("Комиссия");																
			ОбластьКомиссия.Параметры.Заполнить(ОбластьКомиссия_Параметры);
			МассивОбластейКомиссии.Добавить(ОбластьКомиссия);
			
			пСтатусЧленаКомиссии = "";
			
			КоличествоЧленовКомиссии = КоличествоЧленовКомиссии + 1;
			
		КонецЦикла;
		
		Пока КоличествоЧленовКомиссии < 3 Цикл
		
			ОбластьКомиссия_Параметры = Новый Структура("пСтатусЧленаКомиссии,пДолжностьЧленаКомиссии,пЧленКомиссии",
														 пСтатусЧленаКомиссии,"","");
														 
			ОбластьКомиссия = Макет.ПолучитьОбласть("Комиссия");																
			ОбластьКомиссия.Параметры.Заполнить(ОбластьКомиссия_Параметры);
			МассивОбластейКомиссии.Добавить(ОбластьКомиссия);
			
			пСтатусЧленаКомиссии = "";
			
			КоличествоЧленовКомиссии = КоличествоЧленовКомиссии + 1;
		
		КонецЦикла; 
		
		РукДолжнПолучателя	= "";
		РукПолучателя		= "";
		ГлавБухПолучателя	= "";
		РукДолжнСдатчика	= "";
		РукСдатчика			= "";
		ГлавБухСдатчика		= "";
		ДолжностьМОЛ		= "";
	    ФИОМОЛ				= "";
		ТабНомМОЛ			= "";
		ДолжностьМОЛсдал	= "";
		ФИОМОЛсдал			= "";
		ТабНомМОЛСдал		= "";
		ДатаПередачи		= "";
		Если ВидДвижения = "Приход" Тогда
			НаимПолучателя		= ВыборкаДокументы.НаимПолучателя;
			КодОКПОПолучателя	= ВыборкаДокументы.КодОКПОПолучателя;
			
			ЗаполнитьДанныеОтветственногоЛица(	ВыборкаДокументы.Получатель,
												ВыборкаДокументы.пДата, 
												Перечисления.ОтветственныеЛицаОрганизаций.Руководитель, 
												РукПолучателя,
												РукДолжнПолучателя);
			ЗаполнитьДанныеОтветственногоЛица(	ВыборкаДокументы.Получатель,
												ВыборкаДокументы.пДата, 
												Перечисления.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер, 
												ГлавБухПолучателя);
			ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность",
												ВыборкаДокументы.МОЛ, 
												ВыборкаДокументы.пДата);
			Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
			ДолжностьМОЛ	= ДанныеСотрудника.Должность;
		    ФИОМОЛ			= КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина);
			ТабНомМОЛ		= ВыборкаДокументы.ТабНомМОЛ;
			
			РеквПолучателя = ПлатежныеРеквизитыПоТребованиюБанка(ВыборкаДокументы.ЛицевойСчет, ВыборкаДокументы.РеквизитыЛицевогоСчета);
			
			ДанныеСдатчика = Новый Структура("СсылкаНаОбъект, Период, НаименованиеПолное, КодОКПО", ВыборкаДокументы.Сдатчик, ВыборкаДокументы.пДата);
			Справочники.Контрагенты.ПолучитьДанныеКонтрагента(ДанныеСдатчика, Истина);
			НаимСдатчика	= ДанныеСдатчика.НаименованиеПолное;
			КодОКПОСдатчика	= ДанныеСдатчика.КодОКПО;
			
			РеквСдатчика = ПлатежныеРеквизитыПоТребованиюБанка(ВыборкаДокументы.СчетСдатчика, ВыборкаДокументы.СчетСдатчика);
			АмортизацияТекущегоМесяца = 0;

		Иначе
			
			ЗаполнитьДанныеОтветственногоЛица(	ВыборкаДокументы.Сдатчик,
												ВыборкаДокументы.пДата, 
												Перечисления.ОтветственныеЛицаОрганизаций.Руководитель, 
												РукСдатчика,
												РукДолжнСдатчика);
			ЗаполнитьДанныеОтветственногоЛица(	ВыборкаДокументы.Сдатчик,
												ВыборкаДокументы.пДата, 
												Перечисления.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер, 
												ГлавБухСдатчика);
			ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность",
												ВыборкаДокументы.МОЛСдал, 
												ВыборкаДокументы.пДата);
			Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
			ДолжностьМОЛсдал	= ДанныеСотрудника.Должность;
		    ФИОМОЛсдал			= КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина);
			ТабНомМОЛСдал		= ВыборкаДокументы.ТабНомМОЛСдал;
			
			ДанныеПолучателя = Новый Структура("СсылкаНаОбъект, Период, НаименованиеПолное, КодОКПО", ВыборкаДокументы.Получатель, ВыборкаДокументы.пДата);
			Справочники.Контрагенты.ПолучитьДанныеКонтрагента(ДанныеПолучателя, Истина);
			НаимПолучателя		= ДанныеПолучателя.НаименованиеПолное;
			КодОКПОПолучателя	= ДанныеПолучателя.КодОКПО;
			
