	|	СписокОС.КоэффициентУскорения КАК КоэффициентУскорения,
	|	СписокОС.ПараметрВыработки КАК ПараметрВыработки,
	|	СписокОС.ПредполагаемыйОбъемВыработки КАК ПредполагаемыйОбъемВыработки,
	|	События.ДатаПринятияКУчету КАК ДатаПринятияКУчету,
	|	ЕСТЬNULL(Амортизация.АмортизацияНаДатуРасчета, 0) КАК АмортизацияНаКонецПериода,
	|	ЕСТЬNULL(Обесценение.СуммаОбесценения, 0) КАК ОбесценениеНаКонецПериода,
	|	СписокОС.СтоимостьНаДатуРасчета - ЕСТЬNULL(Амортизация.АмортизацияНаДатуРасчета, 0) -
	|		ЕСТЬNULL(Обесценение.СуммаОбесценения, 0) КАК ОстаточнаяСтоимость,
	|	ЕСТЬNULL(ОстаткиНаНачалоГода.СтоимостьНаНачалоГода, 0) - ЕСТЬNULL(АмортизацияНаНачалоГода.СуммаАмортизации, 0) -
	|		ЕСТЬNULL(ОбесценениеНаНачалоГода.СуммаОбесценения, 0) КАК ОстаточнаяСтоимостьНаНачалоГода,
	|	ЕСТЬNULL(Выработка.КоличествоОборот, 0) КАК ОбъемВыработки,
	|	ЕСТЬNULL(ОтражениеАмортизации.СчетУчетаЗатрат, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) КАК СчетЗатрат,
	|	ЕСТЬNULL(ОтражениеАмортизации.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК
	|		ПодразделениеЗатрат,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ОтражениеАмортизации.КПС,
	|			ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)
	|			ТОГДА СписокОС.КПС
	|		ИНАЧЕ ОтражениеАмортизации.КПС
	|	КОНЕЦ КАК КПСЗатрат,
	|	ЕСТЬNULL(ОтражениеАмортизации.КЭК, ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)) КАК КЭКЗатрат,
	|	ОтражениеАмортизации.Субконто1 КАК СубконтоЗатрат1,
	|	ОтражениеАмортизации.Субконто2 КАК СубконтоЗатрат2,
	|	ОтражениеАмортизации.Субконто3 КАК СубконтоЗатрат3
	|ИЗ
	|	СписокОС_БУ КАК СписокОС
	|		ЛЕВОЕ СОЕДИНЕНИЕ События_БУ КАК События
	|		ПО СписокОС.ОсновноеСредство = События.ОсновноеСредство
	|		И СписокОС.ИнвентарныйНомер = События.ИнвентарныйНомер
	|		ЛЕВОЕ СОЕДИНЕНИЕ Амортизация_БУ КАК Амортизация
	|		ПО СписокОС.ОсновноеСредство = Амортизация.ОсновноеСредство
	|		И СписокОС.ИнвентарныйНомер = Амортизация.ИнвентарныйНомер
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиНаНачалоГода_БУ КАК ОстаткиНаНачалоГода
	|		ПО СписокОС.ОсновноеСредство = ОстаткиНаНачалоГода.ОсновноеСредство
	|		И СписокОС.ИнвентарныйНомер = ОстаткиНаНачалоГода.ИнвентарныйНомер
	|		ЛЕВОЕ СОЕДИНЕНИЕ АмортизацияНаНачалоГода_БУ КАК АмортизацияНаНачалоГода
	|		ПО СписокОС.ОсновноеСредство = АмортизацияНаНачалоГода.ОсновноеСредство
	|		И СписокОС.ИнвентарныйНомер = АмортизацияНаНачалоГода.ИнвентарныйНомер
	|		ЛЕВОЕ СОЕДИНЕНИЕ Выработка_БУ КАК Выработка
	|		ПО СписокОС.ОсновноеСредство = Выработка.ОсновноеСредство
	|		И СписокОС.ПараметрВыработки = Выработка.ПараметрВыработки
	|		И События.ИнвентарныйНомер = Выработка.ИнвентарныйНомер
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОтражениеАмортизации КАК ОтражениеАмортизации
	|		ПО СписокОС.ОсновноеСредство = ОтражениеАмортизации.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ Обесценение_БУ КАК Обесценение
	|		ПО СписокОС.ОсновноеСредство = Обесценение.ОсновноеСредство
	|		И СписокОС.ИнвентарныйНомер = Обесценение.ИнвентарныйНомер
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОбесценениеНаНачалоГода_БУ КАК ОбесценениеНаНачалоГода
	|		ПО СписокОС.ОсновноеСредство = ОбесценениеНаНачалоГода.ОсновноеСредство
	|		И СписокОС.ИнвентарныйНомер = ОбесценениеНаНачалоГода.ИнвентарныйНомер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Амортизация_БУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ОстаткиНаНачалоГода_БУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ АмортизацияНаНачалоГода_БУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Выработка_БУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ События_БУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Амортизация_РН_НаДаутРасчетов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ СтоимостьОС_НаНачалоГода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Амортизация_РН_НаНачалоГода";             
	
	Возврат ТекстЗапроса;
	
КонецФункции

// Выполняет запросы, получает данные для расчета амортизации.
//
// Параметры: см. описание функции УправлениеОсновнымиСредствами.РасчетАмортизацииОСиНМА().
//
// Возвращаемое значение: см. описание функции УправлениеОсновнымиСредствами.РасчетАмортизацииОСиНМА().
//
Функция ПодготовитьТаблицыДляРасчетаАмортизацииОСиНМА(ОсновныеСредства, Реквизиты,
			ЭтоРегламентноеНачислениеАмортизации, ЭтоИмуществоКазны)
	
	Запрос = Новый Запрос;
	СмещениеНомера = 0;  
	НачислятьАмортизациюПервымЧислом = 
		Справочники.Организации.ПолучитьУчетнуюПолитику(Реквизиты.Организация, Реквизиты.Дата).НачислятьАмортизациюПервымЧислом;
	
	// 1. Формируем список ОС и НМА, по которым необходимо начислить амортизацию в БУ и НУ
	Если ЭтоРегламентноеНачислениеАмортизации Тогда
		
		ОтражаетсяВНалоговомУчете = НалоговыйУчетВызовСервера.ПлательщикНалогаНаПрибыль(
			Реквизиты.Организация, Реквизиты.Дата);
		
		УсловиеОС = "ИСТИНА";
		
		Если ОсновныеСредства.Количество() > 0 Тогда // Задан отбор по КФО и Счету учета.
			
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ТаблицаОтборПоКФОиСчетуУчета.СчетУчета КАК СчетУчета,
			|	ТаблицаОтборПоКФОиСчетуУчета.КФО КАК КФО
			|ПОМЕСТИТЬ ТаблицаОтборПоКФОиСчетуУчета
			|ИЗ
			|	&ТаблицаОтборПоКФОиСчетуУчета КАК ТаблицаОтборПоКФОиСчетуУчета
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	СчетУчета,
			|	КФО";
			
			СмещениеНомера = 1;
			Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета();
			
			Запрос.УстановитьПараметр("ТаблицаОтборПоКФОиСчетуУчета", ОсновныеСредства);
			Запрос.УстановитьПараметр("СписокКФО", ОсновныеСредства.ВыгрузитьКолонку("КФО"));
			
			УсловиеКФО = "КФО В (&СписокКФО)";
			ОтборПоКФОиСчетуУчета = 
			"(ОстаткиНаКонецМесяца.КФО, ОстаткиНаКонецМесяца.Счет) В
			|				(ВЫБРАТЬ
			|					ТаблицаОтборПоКФОиСчетуУчета.КФО,
			|					ТаблицаОтборПоКФОиСчетуУчета.СчетУчета
			|				ИЗ
			|					ТаблицаОтборПоКФОиСчетуУчета КАК ТаблицаОтборПоКФОиСчетуУчета)";
			
		Иначе // Без отбора по КФО и Счету учета.
			
			УсловиеКФО = "ИСТИНА";
			ОтборПоКФОиСчетуУчета = "ИСТИНА";
			
		КонецЕсли;
		
	Иначе
		
		ОтражаетсяВНалоговомУчете = НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(
			Реквизиты.Организация, Реквизиты.Дата, Реквизиты.КФО);
		
		МассивКФО = Новый Массив;
		МассивКФО.Добавить(Реквизиты.КФО);
		
		Запрос.УстановитьПараметр("СписокКФО"	, МассивКФО);
		Запрос.УстановитьПараметр("СписокОС"	, ОсновныеСредства);
		
		УсловиеКФО	= "КФО В (&СписокКФО)";
		УсловиеОС	= "Субконто1 В (&СписокОС)";
		ОтборПоКФОиСчетуУчета = "ИСТИНА";
		
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + ТекстЗапроса_ТаблицыДляРасчетаАмортизацииБУ(НачислятьАмортизациюПервымЧислом); 
	
	Если ОтражаетсяВНалоговомУчете Тогда
		
		Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
			ТекстЗапроса_ТаблицыДляРасчетаАмортизацииНУ();
		
		КодыТолькоЛинейный = "101.11,101.12,101.13,101.21,101.22,101.23,101.31,101.32,101.33,101.41,101.42,101.43,102.00";
		
		Запрос.УстановитьПараметр("СписокСчетовТолькоЛинейный"				, БухгалтерскийУчет.СписокСчетов(КодыТолькоЛинейный));
		Запрос.УстановитьПараметр("СчетаНУпоУчетуОСиНМА"					, БухгалтерскийУчет.СписокСчетов("Н01, Н04"));
		Запрос.УстановитьПараметр("СчетаНУАмортизацииОСиНМА"				, БухгалтерскийУчет.СписокСчетов("Н02, Н05"));
		Запрос.УстановитьПараметр("СчетаАмортизационнойПремии"				, БухгалтерскийУчет.СписокСчетов("НКВ"));
		
		Запрос.УстановитьПараметр("СчетАмортизацияОсновныхСредствНУ"		, БухгалтерскийУчет.СчетПоКоду("Н02"	, Реквизиты.Дата));
		Запрос.УстановитьПараметр("СчетАмортизацияНематериальныхАктивовНУ"	, БухгалтерскийУчет.СчетПоКоду("Н05"	, Реквизиты.Дата));
		Запрос.УстановитьПараметр("СчетПрямыеРасходыПроизводстваНУ"			, БухгалтерскийУчет.СчетПоКоду("Н20.01"	, Реквизиты.Дата));
		Запрос.УстановитьПараметр("СчетКосвенныеРасходыПроизводстваНУ"		, БухгалтерскийУчет.СчетПоКоду("Н20.02"	, Реквизиты.Дата));
		Запрос.УстановитьПараметр("СчетПрямыеНакладныеРасходыНУ"			, БухгалтерскийУчет.СчетПоКоду("Н25.01"	, Реквизиты.Дата));
		Запрос.УстановитьПараметр("СчетКосвенныеНакладныеРасходыНУ"			, БухгалтерскийУчет.СчетПоКоду("Н25.02"	, Реквизиты.Дата));
		Запрос.УстановитьПараметр("СчетПрямыеОбщехозяйственныеРасходыНУ"	, БухгалтерскийУчет.СчетПоКоду("Н26.01"	, Реквизиты.Дата));
		Запрос.УстановитьПараметр("СчетКосвенныеОбщехозяйственныеРасходыНУ"	, БухгалтерскийУчет.СчетПоКоду("Н26.02"	, Реквизиты.Дата));
		Запрос.УстановитьПараметр("СчетИздержкиОбращенияНУ"					, БухгалтерскийУчет.СчетПоКоду("Н44"	, Реквизиты.Дата));
		Запрос.УстановитьПараметр("СчетПрочиеРасходыНУ"						, БухгалтерскийУчет.СчетПоКоду("Н91.02"	, Реквизиты.Дата));
		
		Запрос.УстановитьПараметр("ДатаПереходаКЛинейномуМетоду", ПолучитьДатуПереходаКЛинейномуМетоду(
			Реквизиты.Дата, Реквизиты.Организация));
		
		СубконтоКВ = Новый Массив();
		СубконтоКВ.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
		СубконтоКВ.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ДокументыАмортизационнойПремии);
		Запрос.УстановитьПараметр("СубконтоКВ", СубконтоКВ);
		
	КонецЕсли;
	
	// ИФО.
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		Если ЗначениеЗаполнено(Реквизиты.ИФО) Тогда
			Запрос.УстановитьПараметр("ИФО", Реквизиты.ИФО); // Отбор по ИФО.
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИФО = &ИФО");
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИСТИНА");
		КонецЕсли;
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ОстаткиНаКонецМесяца.ИФО",
			"ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "НУСтоимостьНаНачалоПериода.ИФО",
			"ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "НУАмортизацияОстаткиИОбороты.ИФО",
			"ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "АмортизационнаяПремия.ИФО",
			"ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИСТИНА");
	КонецЕсли;
	
	Если ЭтоИмуществоКазны Тогда
		ВедетсяУчетПоПодразделениям = УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетИКПоПодразделениям();
		СписокСчетов = "108.00";
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.НачислениеАмортизацииОС", "Документ.НачислениеАмортизацииИК");
	Иначе
		ВедетсяУчетПоПодразделениям = УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетОСПоПодразделениям();
		СписокСчетов = "101.00,102.00,111.60";
	КонецЕсли;
	
	// Подразделение.
	Если ВедетсяУчетПоПодразделениям Тогда
		Если ЗначениеЗаполнено(Реквизиты.Подразделение) Тогда
			Запрос.УстановитьПараметр("Подразделение", Реквизиты.Подразделение); // Отбор по Подразделению.
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПодразделение", "Подразделение = &Подразделение");
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПодразделение", "ИСТИНА");
		КонецЕсли;
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ОстаткиНаКонецМесяца.Подразделение",
			"ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПодразделение", "ИСТИНА");
	КонецЕсли;
	
	// КФО, Счет учета.
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", УсловиеКФО);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ОтборПоКФОиСчетуУчета", ОтборПоКФОиСчетуУчета);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОС", УсловиеОС);
	
	МетодыНачисления = Новый Массив;
	МетодыНачисления.Добавить(Перечисления.СпособНачисленияАмортизации.Линейный);
	МетодыНачисления.Добавить(Перечисления.СпособНачисленияАмортизации.УменьшаемогоОстатка);
	МетодыНачисления.Добавить(Перечисления.СпособНачисленияАмортизации.ПропорциональноОбъемуПродукции);
	
	Запрос.УстановитьПараметр("Организация"			, Реквизиты.Организация);
	Запрос.УстановитьПараметр("СписокСчетов"		, БухгалтерскийУчет.СписокСчетов(СписокСчетов));
	Запрос.УстановитьПараметр("СчетАмортизации"		, БухгалтерскийУчет.СписокСчетов("104.00"));
	Запрос.УстановитьПараметр("СчетОбесценения"		, БухгалтерскийУчет.СписокСчетов("114.00"));
	Запрос.УстановитьПараметр("МетодыНачисления"	, МетодыНачисления);
	Запрос.УстановитьПараметр("НачалоМесяца"		, НачалоМесяца(Реквизиты.Дата));
	Запрос.УстановитьПараметр("НачалоГода"			, НачалоГода(Реквизиты.Дата));
	Запрос.УстановитьПараметр("КонецМесяца"			, Новый Граница(КонецМесяца(Реквизиты.Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("КонецПредМесяца"		, Новый Граница(НачалоМесяца(Реквизиты.Дата)-1, ВидГраницы.Включая));   
	Запрос.УстановитьПараметр("КонецМесяцаДата"		, КонецМесяца(Реквизиты.Дата));
	
	Запрос.УстановитьПараметр("ДатаРасчета", ?(НачислятьАмортизациюПервымЧислом, Запрос.Параметры.НачалоМесяца, Запрос.Параметры.КонецМесяца));
	
	Результат = Запрос.ВыполнитьПакет();

	ИндексТаблицыБУ = 28;
	ИндексТаблицыНУ = 62;
	Если НачислятьАмортизациюПервымЧислом Тогда
		ИндексТаблицыБУ = 24;
		ИндексТаблицыНУ = 58;
	КонецЕсли;	
	
	ТаблицыАмортизации = Новый Структура;
	ТаблицыАмортизации.Вставить("ТаблицаАмортизацияБУ", Результат[ИндексТаблицыБУ + СмещениеНомера].Выгрузить());
	ТаблицыАмортизации.Вставить("ТаблицаАмортизацияНУ",
		?(ОтражаетсяВНалоговомУчете, Результат[ИндексТаблицыНУ + СмещениеНомера].Выгрузить(), Новый ТаблицаЗначений));
	
	Возврат ТаблицыАмортизации;
	
КонецФункции

Функция ПолучитьДатуПереходаКЛинейномуМетоду(ДатаРасчета, Организация)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация",   Организация);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(ДатаРасчета));

	Запрос.Текст =
	"ВЫБРАТЬ
	|	УчетнаяПолитикаОрганизацийСрезПоследних.Период
	|ПОМЕСТИТЬ НелинейныйМетод
	|ИЗ
	|	РегистрСведений.УчетнаяПолитикаОрганизаций.СрезПоследних(
	|			&НачалоПериода,
	|			Организация = &Организация
	|				И МетодНачисленияАмортизацииНУ = ЗНАЧЕНИЕ(Перечисление.МетодыНачисленияАмортизации.Нелинейный)) КАК УчетнаяПолитикаОрганизацийСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УчетнаяПолитикаОрганизаций.Период
	|ПОМЕСТИТЬ ЛинейныйМетод
	|ИЗ
	|	РегистрСведений.УчетнаяПолитикаОрганизаций КАК УчетнаяПолитикаОрганизаций
	|ГДЕ
	|	УчетнаяПолитикаОрганизаций.Организация = &Организация
	|	И УчетнаяПолитикаОрганизаций.МетодНачисленияАмортизацииНУ = ЗНАЧЕНИЕ(Перечисление.МетодыНачисленияАмортизации.Линейный)
	|	И УчетнаяПолитикаОрганизаций.Период МЕЖДУ ДАТАВРЕМЯ(2009, 1, 1) И &НачалоПериода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(МИНИМУМ(ЛинейныйМетод.Период), ДАТАВРЕМЯ(2009, 1, 1)) КАК ДатаПереходаКЛинейномуМетоду
	|ИЗ
	|	НелинейныйМетод КАК НелинейныйМетод
	|		ЛЕВОЕ СОЕДИНЕНИЕ ЛинейныйМетод КАК ЛинейныйМетод
	|		ПО НелинейныйМетод.Период < ЛинейныйМетод.Период";
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Возврат Выборка.ДатаПереходаКЛинейномуМетоду;

КонецФункции

Функция ПолучитьНормуПоАмортизационнойГруппе(АмортизационнаяГруппа)
	
	НормаАмортизации = Неопределено;
	
	Если АмортизационнаяГруппа = Перечисления.АмортизационныеГруппы.ПерваяГруппа Тогда
		НормаАмортизации         = 14.3;
	ИначеЕсли АмортизационнаяГруппа = Перечисления.АмортизационныеГруппы.ВтораяГруппа Тогда
		НормаАмортизации    =  8.8;
	ИначеЕсли АмортизационнаяГруппа = Перечисления.АмортизационныеГруппы.ТретьяГруппа Тогда
		НормаАмортизации    =  5.6;
	ИначеЕсли АмортизационнаяГруппа = Перечисления.АмортизационныеГруппы.ЧетвертаяГруппа Тогда
		НормаАмортизации =  3.8;
	ИначеЕсли АмортизационнаяГруппа = Перечисления.АмортизационныеГруппы.ПятаяГруппа Тогда
		НормаАмортизации     =  2.7;
	ИначеЕсли АмортизационнаяГруппа = Перечисления.АмортизационныеГруппы.ШестаяГруппа Тогда
		НормаАмортизации    =  1.8;
	ИначеЕсли АмортизационнаяГруппа = Перечисления.АмортизационныеГруппы.СедьмаяГруппа Тогда
		НормаАмортизации   =  1.3;
	ИначеЕсли АмортизационнаяГруппа = Перечисления.АмортизационныеГруппы.ВосьмаяГруппа Тогда
		НормаАмортизации   =  1.0;
	ИначеЕсли АмортизационнаяГруппа = Перечисления.АмортизационныеГруппы.ДевятаяГруппа Тогда
		НормаАмортизации   =  0.8;
	ИначеЕсли АмортизационнаяГруппа = Перечисления.АмортизационныеГруппы.ДесятаяГруппа Тогда
		НормаАмортизации   =  0.7;
	КонецЕсли;
	
	Возврат НормаАмортизации;
	
КонецФункции

Функция ТекстЗапроса_ТаблицыДляРасчетаАмортизацииНУ()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ОстаткиБУ.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	|	ОстаткиБУ.КоличествоОстатокДт КАК Количество
	|ПОМЕСТИТЬ ОстаткиБУ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&ДатаРасчета,
	|			Счет В (&СписокСчетов),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
	|			Организация = &Организация
	|				И &УсловиеКФО
	|				И &УсловиеИФО
	|				И Субконто1 В
	|					(ВЫБРАТЬ
	|						СписокОС.ОсновноеСредство
	|					ИЗ
	|						ОстаткиНаДатуРасчета_БУ КАК СписокОС)) КАК ОстаткиБУ
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ОстаткиНаКонецМесяца.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОС,
	|	ОстаткиНаКонецМесяца.ИФО КАК ИФО,
	|	ОстаткиНаКонецМесяца.КФО КАК КФО,
	|	ОстаткиНаКонецМесяца.Счет КАК СчетУчета,
	|	ЕСТЬNULL(ОстаткиНаКонецМесяца.СуммаОстатокДт, 0) КАК НУСтоимостьНаКонецПериода,
	|	ЕСТЬNULL(ОстаткиНаКонецМесяца.СуммаНеУчитываетсяНУОстатокДт, 0) КАК НУСтоимостьНеУчитываетсяНУНаКонецПериода,
	|	ЕСТЬNULL(ОстаткиНаКонецМесяца.СуммаЕНВДОстатокДт, 0) КАК НУСтоимостьЕНВДНаКонецПериода
	|ПОМЕСТИТЬ ОстаткиНаКонецМесяца_НУ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&ДатаРасчета,
	|			Счет В (&СчетаНУпоУчетуОСиНМА),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
	|			Организация = &Организация
	|				И &УсловиеКФО
	|				И &УсловиеИФО
	|				И Субконто1 В
	|					(ВЫБРАТЬ
	|						СписокОС.ОсновноеСредство
	|					ИЗ
	|						ОстаткиНаДатуРасчета_БУ КАК СписокОС)) КАК ОстаткиНаКонецМесяца
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОС,
	|	КФО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОстаткиНаКонецМесяца.ОС КАК ОС,
	|	ОстаткиНаКонецМесяца.ОС.ГрупповойУчет КАК ГрупповойУчет,
	|	ОстаткиНаКонецМесяца.ИФО КАК ИФО,
	|	ОстаткиНаКонецМесяца.КФО КАК КФО,
	|	ОстаткиНаКонецМесяца.СчетУчета КАК СчетУчета,
	|	ОстаткиНаКонецМесяца.НУСтоимостьНаКонецПериода КАК НУСтоимостьНаКонецПериода,
	|	ОстаткиНаКонецМесяца.НУСтоимостьНеУчитываетсяНУНаКонецПериода КАК НУСтоимостьНеУчитываетсяНУНаКонецПериода,
	|	ОстаткиНаКонецМесяца.НУСтоимостьЕНВДНаКонецПериода КАК НУСтоимостьЕНВДНаКонецПериода,
	|	СписокОС_БУ.СчетУчета КАК СчетУчетаБУ,
	|	СписокОС_БУ.Подразделение КАК Подразделение,
	|	ЕСТЬNULL(ОстаткиБУ.Количество, 1) КАК Количество
	|ПОМЕСТИТЬ СписокОС_НУ
	|ИЗ
	|	ОстаткиНаКонецМесяца_НУ КАК ОстаткиНаКонецМесяца
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОстаткиНаДатуРасчета_БУ КАК СписокОС_БУ
	|		ПО ОстаткиНаКонецМесяца.ОС = СписокОС_БУ.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиБУ КАК ОстаткиБУ
	|		ПО ОстаткиНаКонецМесяца.ОС = ОстаткиБУ.ОсновноеСредство
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОС,
	|	КФО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ОстаткиНаКонецМесяца_НУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НачислениеАмортизацииНУ.ОсновноеСредство КАК ОсновноеСредство,
	|	НачислениеАмортизацииНУ.НачислятьАмортизацию КАК НачислятьАмортизацию
	|ПОМЕСТИТЬ НачислениеАмортизацииНУ1
	|ИЗ
	|	РегистрСведений.НачислениеАмортизацииОСНалоговыйУчет.СрезПоследних(
	|			&ДатаРасчета,
	|			Организация = &Организация
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						СписокОС_НУ.ОС
	|					ИЗ
	|						СписокОС_НУ)) КАК НачислениеАмортизацииНУ
	|ГДЕ
	|	НачислениеАмортизацииНУ.НачислятьАмортизацию = ИСТИНА
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПервоначальныеСведенияНУ.ОсновноеСредство КАК ОсновноеСредство,
	|	ПервоначальныеСведенияНУ.ПорядокВключенияСтоимостиВСоставРасходов КАК ПорядокВключенияСтоимостиВСоставРасходов
	|ПОМЕСТИТЬ ПервоначальныеСведенияНУ1
	|ИЗ
	|	РегистрСведений.ПервоначальныеСведенияОСНалоговыйУчет.СрезПоследних(
	|			&КонецПредМесяца,
	|			ОсновноеСредство В
	|				(ВЫБРАТЬ
	|					СписокОС_НУ.ОС
	|				ИЗ
	|					СписокОС_НУ)) КАК ПервоначальныеСведенияНУ
	|ГДЕ
	|	ПервоначальныеСведенияНУ.ПорядокВключенияСтоимостиВСоставРасходов = ЗНАЧЕНИЕ(Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтоимостьОбъектовОС.ОсновноеСредство КАК ОсновноеСредство,
	|	ВЫБОР
	|		КОГДА СтоимостьОбъектовОС.ОсновноеСредство.ГрупповойУчет
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
	|		ИНАЧЕ СтоимостьОбъектовОС.ИнвентарныйНомер
	|	КОНЕЦ КАК ИнвНомер,
	|	ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ВведеноВЭксплуатацию) КАК Состояние
	|ПОМЕСТИТЬ МестонахождениеОСНУ1
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(
	|			&КонецПредМесяца,
	|			Организация = &Организация
	|				И ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						СписокОС_НУ.ОС
	|					ИЗ
	|						СписокОС_НУ)) КАК СтоимостьОбъектовОС
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СобытияОС.СрезПоследних(
	|				&КонецПредМесяца,
	|				Организация = &Организация
	|					И Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВводВЭксплуатацию)
	|					И ОсновноеСредство В
	|						(ВЫБРАТЬ
	|							СписокОС_НУ.ОС
	|						ИЗ
	|							СписокОС_НУ)) КАК СобытияОС
	|		ПО СтоимостьОбъектовОС.ОсновноеСредство = СобытияОС.ОсновноеСредство
	|			И СтоимостьОбъектовОС.ИнвентарныйНомер = СобытияОС.ИнвНомер
	|ГДЕ
	|	ЕСТЬNULL(СобытияОС.ДатаСобытия, ДАТАВРЕМЯ(1, 1, 1)) <> ДАТАВРЕМЯ(1, 1, 1)
	|
	|СГРУППИРОВАТЬ ПО
	|	СтоимостьОбъектовОС.ОсновноеСредство,
	|	ВЫБОР
	|		КОГДА СтоимостьОбъектовОС.ОсновноеСредство.ГрупповойУчет
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
	|		ИНАЧЕ СтоимостьОбъектовОС.ИнвентарныйНомер
	|	КОНЕЦ
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НУСтоимостьНаНачалоПериода.ИФО КАК ИФО,
	|	НУСтоимостьНаНачалоПериода.КФО КАК КФО,
	|	НУСтоимостьНаНачалоПериода.Счет КАК Счет,
	|	ВЫРАЗИТЬ(НУСтоимостьНаНачалоПериода.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	|	НУСтоимостьНаНачалоПериода.СуммаОстатокДт КАК СуммаОстатокДт,
	|	НУСтоимостьНаНачалоПериода.СуммаНеУчитываетсяНУОстатокДт КАК СуммаНеУчитываетсяНУОстатокДт,
	|	НУСтоимостьНаНачалоПериода.СуммаЕНВДОстатокДт КАК СуммаЕНВДОстатокДт
	|ПОМЕСТИТЬ НУСтоимостьНаНачалоПериода1
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&НачалоМесяца,
	|			Счет В (&СчетаНУпоУчетуОСиНМА),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
	|			Организация = &Организация
	|				И &УсловиеКФО
	|				И &УсловиеИФО
	|				И Субконто1 В
	|					(ВЫБРАТЬ
	|						СписокОС_НУ.ОС
	|					ИЗ
	|						СписокОС_НУ)) КАК НУСтоимостьНаНачалоПериода
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КФО,
	|	Счет,
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НУАмортизацияОстаткиИОбороты.ИФО КАК ИФО,
	|	НУАмортизацияОстаткиИОбороты.КФО КАК КФО,
	|	ВЫРАЗИТЬ(НУАмортизацияОстаткиИОбороты.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	|	НУАмортизацияОстаткиИОбороты.СуммаНачальныйОстатокКт КАК СуммаНачальныйОстатокКт,
	|	НУАмортизацияОстаткиИОбороты.СуммаНеУчитываетсяНУНачальныйОстатокКт КАК СуммаНеУчитываетсяНУНачальныйОстатокКт,
	|	НУАмортизацияОстаткиИОбороты.СуммаЕНВДНачальныйОстатокКт КАК СуммаЕНВДНачальныйОстатокКт,
