//////////////////////////////////////////////////////////////////////////////////
// УПРАВЛЕНИЕ ОСНОВНЫМИ СРЕДСТВАМИ                                              //
//////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Процедуры и функции получения данных объектов ОС (НМА, НПА).

Функция ДанныеОбъектаОС(ОсновноеСредство, Период = Неопределено) Экспорт
	
	ДанныеОбъекта = Новый Структура;
	// Данные регистра сведений "Учетные данные ОС".
	ДанныеОбъекта.Вставить("СчетУчета"		, ПланыСчетов.ЕПСБУ.ПустаяСсылка());
	ДанныеОбъекта.Вставить("СчетВложений"	, ПланыСчетов.ЕПСБУ.ПустаяСсылка());
	ДанныеОбъекта.Вставить("СчетВПути"		, ПланыСчетов.ЕПСБУ.ПустаяСсылка());
	ДанныеОбъекта.Вставить("СчетНаХранении"	, ПланыСчетов.ЕПСБУ.ПустаяСсылка());
	ДанныеОбъекта.Вставить("ВидУчета"		, Перечисления.ВидыУчетаНФА.ПустаяСсылка());
	ДанныеОбъекта.Вставить("ВидИмущества"	, Перечисления.ВидыИмущества.ПустаяСсылка());
	ДанныеОбъекта.Вставить("КПС"			, Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка());
	ДанныеОбъекта.Вставить("КФО"			, Перечисления.КВД.ПустаяСсылка());
	ДанныеОбъекта.Вставить("КЭК"			, Справочники.КОСГУ.ПустаяСсылка());
	ДанныеОбъекта.Вставить("КЭКВложений"	, Справочники.КОСГУ.ПустаяСсылка());
	// Реквизиты справочника "Основные средства".
	ДанныеОбъекта.Вставить("Организация"				, Справочники.Организации.ПустаяСсылка());
	ДанныеОбъекта.Вставить("ВидНФА"						, Перечисления.ВидыНФА.ПустаяСсылка());
	ДанныеОбъекта.Вставить("ТипНФА"						, Перечисления.ТипыНФА.ПустаяСсылка());
	ДанныеОбъекта.Вставить("ГрупповойУчет"				, Ложь);
	ДанныеОбъекта.Вставить("АмортизационнаяГруппа"		, Перечисления.АмортизационныеГруппы.ПустаяСсылка());
	ДанныеОбъекта.Вставить("КодОКОФ"					, Справочники.ОбщероссийскийКлассификаторОсновныхФондов.ПустаяСсылка());
	ДанныеОбъекта.Вставить("ПервоначальнаяСтоимость"	, 0);
	ДанныеОбъекта.Вставить("ПрослеживаемыйТовар"        , Ложь);
	ДанныеОбъекта.Вставить("СтранаПроисхождения"        , Справочники.СтраныМира.ПустаяСсылка());
	ДанныеОбъекта.Вставить("ЕдинственнаяКарточкаКапвложений", Справочники.КарточкиКапвложений.ПустаяСсылка());
	
	Если НЕ ЗначениеЗаполнено(ОсновноеСредство) Тогда
		Возврат ДанныеОбъекта;
	КонецЕсли;
	
	ТипПериода = ТипЗнч(Период);
	Если ЗначениеЗаполнено(Период) Тогда
		Если ТипПериода = Тип("Дата") Тогда
			ГраницаСреза = Новый Граница(Период, ВидГраницы.Включая);
		ИначеЕсли Документы.ТипВсеСсылки().СодержитТип(ТипПериода) Тогда
			ГраницаСреза = Новый Граница(Период.МоментВремени(), ВидГраницы.Исключая);
		ИначеЕсли ТипПериода = Тип("Граница") Тогда
			ГраницаСреза = Период;
		КонецЕсли;
	Иначе
		ГраницаСреза = '00010101000000'; // Последнее актуальное значение регистра.
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	УчетныеДанныеОбъектаОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	УчетныеДанныеОбъектаОССрезПоследних.СчетУчета КАК СчетУчета,
	|	УчетныеДанныеОбъектаОССрезПоследних.ВидУчета КАК ВидУчета,
	|	УчетныеДанныеОбъектаОССрезПоследних.ВидИмущества КАК ВидИмущества,
	|	УчетныеДанныеОбъектаОССрезПоследних.КФО КАК КФО,
	|	УчетныеДанныеОбъектаОССрезПоследних.КПС КАК КПС,
	|	УчетныеДанныеОбъектаОССрезПоследних.КЭК КАК КЭК
	|ПОМЕСТИТЬ УчетныеДанныеСчетУчета
	|ИЗ
	|	РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних(
	|			&ГраницаСреза,
	|			ОсновноеСредство = &ОсновноеСредство
	|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчетаНФА.НаБалансе)) КАК УчетныеДанныеОбъектаОССрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	УчетныеДанныеОбъектаОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	УчетныеДанныеОбъектаОССрезПоследних.СчетУчета КАК СчетВложений,
	|	УчетныеДанныеОбъектаОССрезПоследних.ВидУчета КАК ВидУчета,
	|	УчетныеДанныеОбъектаОССрезПоследних.ВидИмущества КАК ВидИмущества,
	|	УчетныеДанныеОбъектаОССрезПоследних.КЭК КАК КЭК
	|ПОМЕСТИТЬ УчетныеДанныеСчетВложений
	|ИЗ
	|	РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних(
	|			&ГраницаСреза,
	|			ОсновноеСредство = &ОсновноеСредство
	|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчетаНФА.КапВложение)) КАК УчетныеДанныеОбъектаОССрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	УчетныеДанныеОбъектаОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	УчетныеДанныеОбъектаОССрезПоследних.СчетУчета КАК СчетВПути,
	|	УчетныеДанныеОбъектаОССрезПоследних.ВидУчета КАК ВидУчета,
	|	УчетныеДанныеОбъектаОССрезПоследних.ВидИмущества КАК ВидИмущества
	|ПОМЕСТИТЬ УчетныеДанныеСчетВПути
	|ИЗ
	|	РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних(
	|			&ГраницаСреза,
	|			ОсновноеСредство = &ОсновноеСредство
	|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчетаНФА.ВПути)) КАК УчетныеДанныеОбъектаОССрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	УчетныеДанныеОбъектаОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	УчетныеДанныеОбъектаОССрезПоследних.СчетУчета КАК СчетНаХранении,
	|	УчетныеДанныеОбъектаОССрезПоследних.ВидУчета КАК ВидУчета,
	|	УчетныеДанныеОбъектаОССрезПоследних.ВидИмущества КАК ВидИмущества
	|ПОМЕСТИТЬ УчетныеДанныеСчетНаХранении
	|ИЗ
	|	РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних(
	|			&ГраницаСреза,
	|			ОсновноеСредство = &ОсновноеСредство
	|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчетаНФА.НаОтветственномХранении)) КАК УчетныеДанныеОбъектаОССрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.ПервоначальнаяСтоимость КАК ПервоначальнаяСтоимость
	|ПОМЕСТИТЬ ПервоначальныеСведенияОСБухгалтерскийУчет
	|ИЗ
	|	РегистрСведений.ПервоначальныеСведенияОСБухгалтерскийУчет.СрезПоследних(&ГраницаСреза, ОсновноеСредство = &ОсновноеСредство) КАК ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КарточкиКапвложений.ОбъектВложений КАК ОсновноеСредство,
	|	КарточкиКапвложений.Ссылка КАК ЕдинственнаяКарточкаКапвложений
	|ПОМЕСТИТЬ КарточкаКапвложений
	|ИЗ
	|	Справочник.КарточкиКапвложений КАК КарточкиКапвложений
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			КарточкиКапвложений.ОбъектВложений КАК ОбъектВложений,
	|			КОЛИЧЕСТВО(КарточкиКапвложений.Ссылка) КАК Количество
	|		ИЗ
	|			Справочник.КарточкиКапвложений КАК КарточкиКапвложений
	|		ГДЕ
	|			КарточкиКапвложений.ОбъектВложений = &ОсновноеСредство
	|		
	|		СГРУППИРОВАТЬ ПО
	|			КарточкиКапвложений.ОбъектВложений
	|		
	|		ИМЕЮЩИЕ
	|			КОЛИЧЕСТВО(КарточкиКапвложений.Ссылка) = 1) КАК ВложенныйЗапрос
	|		ПО (ВложенныйЗапрос.ОбъектВложений = КарточкиКапвложений.ОбъектВложений)
	|ГДЕ
	|	КарточкиКапвложений.ОбъектВложений = &ОсновноеСредство
	|	И НЕ ВложенныйЗапрос.ОбъектВложений ЕСТЬ NULL
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОсновныеСредства.Организация КАК Организация,
	|	ОсновныеСредства.ВидНФА КАК ВидНФА,
	|	ОсновныеСредства.ТипНФА КАК ТипНФА,
	|	ОсновныеСредства.ГрупповойУчет КАК ГрупповойУчет,
	|	ОсновныеСредства.АмортизационнаяГруппа КАК АмортизационнаяГруппа,
	|	ОсновныеСредства.КодОКОФ КАК КодОКОФ,
	|	ОсновныеСредства.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар,
	|	ВЫБОР
	|		КОГДА ОсновныеСредства.ПрослеживаемыйТовар
	|			ТОГДА ОсновныеСредства.СтранаПроисхождения
	|		ИНАЧЕ &СтранаРоссия
	|	КОНЕЦ КАК СтранаПроисхождения,
	|	ЕСТЬNULL(ПервоначальныеСведенияОСБухгалтерскийУчет.ПервоначальнаяСтоимость, 0) КАК ПервоначальнаяСтоимость,
	|	ЕСТЬNULL(УД_НаБалансе.ВидУчета, ЕСТЬNULL(УД_КапВложения.ВидУчета, ЕСТЬNULL(УД_ВПути.ВидУчета, ЕСТЬNULL(УД_НаХранении.ВидУчета, ЗНАЧЕНИЕ(Перечисление.ВидыУчетаНФА.ПустаяСсылка))))) КАК ВидУчета,
	|	ЕСТЬNULL(УД_НаБалансе.ВидИмущества, ЕСТЬNULL(УД_КапВложения.ВидИмущества, ЕСТЬNULL(УД_ВПути.ВидИмущества, ЕСТЬNULL(УД_НаХранении.ВидИмущества, ЗНАЧЕНИЕ(Перечисление.ВидыИмущества.ПустаяСсылка))))) КАК ВидИмущества,
	|	ЕСТЬNULL(УД_НаБалансе.СчетУчета, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) КАК СчетУчета,
	|	ЕСТЬNULL(УД_НаБалансе.КЭК, ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)) КАК КЭК,
	|	ЕСТЬNULL(УД_КапВложения.СчетВложений, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) КАК СчетВложений,
	|	ЕСТЬNULL(УД_КапВложения.КЭК, ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)) КАК КЭКВложений,
	|	ЕСТЬNULL(УД_ВПути.СчетВПути, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) КАК СчетВПути,
	|	ЕСТЬNULL(УД_НаХранении.СчетНаХранении, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) КАК СчетНаХранении,
	|	ЕСТЬNULL(УД_НаБалансе.КФО, ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка)) КАК КФО,
	|	ЕСТЬNULL(УД_НаБалансе.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) КАК КПС,
	|	ЕСТЬNULL(КарточкаКапвложений.ЕдинственнаяКарточкаКапвложений, ЗНАЧЕНИЕ(Справочник.КарточкиКапвложений.ПустаяСсылка)) КАК ЕдинственнаяКарточкаКапвложений
	|ИЗ
	|	Справочник.ОсновныеСредства КАК ОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ УчетныеДанныеСчетУчета КАК УД_НаБалансе
	|		ПО ОсновныеСредства.Ссылка = УД_НаБалансе.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ УчетныеДанныеСчетВложений КАК УД_КапВложения
	|		ПО ОсновныеСредства.Ссылка = УД_КапВложения.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ УчетныеДанныеСчетВПути КАК УД_ВПути
	|		ПО ОсновныеСредства.Ссылка = УД_ВПути.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ УчетныеДанныеСчетНаХранении КАК УД_НаХранении
	|		ПО ОсновныеСредства.Ссылка = УД_НаХранении.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПервоначальныеСведенияОСБухгалтерскийУчет КАК ПервоначальныеСведенияОСБухгалтерскийУчет
	|		ПО ОсновныеСредства.Ссылка = ПервоначальныеСведенияОСБухгалтерскийУчет.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ КарточкаКапвложений КАК КарточкаКапвложений
	|		ПО ОсновныеСредства.Ссылка = КарточкаКапвложений.ОсновноеСредство
	|ГДЕ
	|	ОсновныеСредства.Ссылка = &ОсновноеСредство";
	
	Запрос.УстановитьПараметр("ОсновноеСредство", ОсновноеСредство);
	Запрос.УстановитьПараметр("ГраницаСреза", ГраницаСреза);
	Запрос.УстановитьПараметр("СтранаРоссия", Справочники.СтраныМира.Россия);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ДанныеОбъекта, Выборка);
	КонецЕсли;
	
	Возврат ДанныеОбъекта;
	
КонецФункции

Функция ДанныеОбъектовОС(ОсновныеСредства, Период = Неопределено) Экспорт
	
	ТипПериода = ТипЗнч(Период);
	Если ЗначениеЗаполнено(Период) Тогда
		Если ТипПериода = Тип("Дата") Тогда
			ГраницаСреза = Новый Граница(Период, ВидГраницы.Включая);
		ИначеЕсли Документы.ТипВсеСсылки().СодержитТип(ТипПериода) Тогда
			ГраницаСреза = Новый Граница(Период.МоментВремени(), ВидГраницы.Исключая);
		ИначеЕсли ТипПериода = Тип("Граница") Тогда
			ГраницаСреза = Период;
		КонецЕсли;
	Иначе
		ГраницаСреза = '00010101000000'; // Последнее актуальное значение регистра.
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УчетныеДанныеОбъектаОССрезПоследних.Организация КАК Организация,
	|	УчетныеДанныеОбъектаОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	УчетныеДанныеОбъектаОССрезПоследних.СчетУчета КАК СчетУчета,
	|	УчетныеДанныеОбъектаОССрезПоследних.ВидУчета КАК ВидУчета,
	|	УчетныеДанныеОбъектаОССрезПоследних.ВидИмущества КАК ВидИмущества
	|ПОМЕСТИТЬ УчетныеДанныеСчетУчета
	|ИЗ
	|	РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних(
	|			&ГраницаСреза,
	|			ОсновноеСредство В (&ОсновныеСредства)
	|				И НЕ СчетУчета В (&СчетаУчетаВложений)
	|				И НЕ СчетУчета В (&СчетаУчетаВПути)) КАК УчетныеДанныеОбъектаОССрезПоследних
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство,
	|	Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УчетныеДанныеОбъектаОССрезПоследних.Организация КАК Организация,
	|	УчетныеДанныеОбъектаОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	УчетныеДанныеОбъектаОССрезПоследних.СчетУчета КАК СчетВложений,
	|	УчетныеДанныеОбъектаОССрезПоследних.ВидУчета КАК ВидУчета,
	|	УчетныеДанныеОбъектаОССрезПоследних.ВидИмущества КАК ВидИмущества
