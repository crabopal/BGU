// Устарела.
Процедура УстановитьОграниченияСчетовДляЭлемента(ЭлементСчетУчета, ВидНФА, ВидУчета, ВидИмущества) Экспорт

	ОграниченияСписокСчетов = Новый Массив;
	
	Если ЗначениеЗаполнено(ВидНФА) Тогда
		
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ОграниченияСписокСчетов,
									 УправлениеОсновнымиСредствамиПовтИсп.ПолучитьМассивСчетовУчетаНФА(ВидНФА, ВидУчета, ВидИмущества, Ложь));
	Иначе	
		ОграниченияСписокСчетов.Добавить("101.00");
		ОграниченияСписокСчетов.Добавить("01");
		ОграниченияСписокСчетов.Добавить("02");
		ОграниченияСписокСчетов.Добавить("102.00");
		ОграниченияСписокСчетов.Добавить("103.00");
		ОграниченияСписокСчетов.Добавить("106.00");
		Если ПолучитьФункциональнуюОпцию("ВестиУчетИмуществаКазны") Тогда
			ОграниченияСписокСчетов.Добавить("108.00");
		КонецЕсли;	
	КонецЕсли;
	
	МассивПараметровВыбора = Новый Массив;
	МассивПараметровВыбора.Добавить(Новый ПараметрВыбора("ОграниченияСписокСчетов", Новый ФиксированныйМассив(ОграниченияСписокСчетов)));
	Для каждого ТекущийПараметрВыбора Из ЭлементСчетУчета.ПараметрыВыбора Цикл
	
		Если ВРЕГ(ТекущийПараметрВыбора.Имя) <> ВРЕГ("ОграниченияСписокСчетов") Тогда
			МассивПараметровВыбора.Добавить(ТекущийПараметрВыбора);
		КонецЕсли;
	
	КонецЦикла; 
	ЭлементСчетУчета.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметровВыбора);
	
КонецПроцедуры // УстановитьСвязиПараметровВыбораСчетаУчета()

// Процедуры и функции формирования инвентарных номеров по заданному шаблону.

// Устарела.
// Функция определяет есть ли в базе инвентарные номера с
// заданным префиксом и максимальный порядковый номер для этого 
// префикса
Функция ОпределитьПорядковыйНомер(Организация, Префикс, ДлинаНомера) Экспорт
	
	// Структура номера: [префикс][порядковый номер][пробелы]
	
	ДлинаПрефикса			= СтрДлина(Префикс);
	ДлинаПорядковогоНомера	= ДлинаНомера - ДлинаПрефикса;
	ДлинаВсегоНомера		= 30; // Длина кода справочника ИнвентарныеНомераОС
	
	ШаблонПоиска = Префикс;
	Для Сч = 1 По ДлинаПорядковогоНомера Цикл
		ШаблонПоиска = ШаблонПоиска + "[0-9]"; 
	КонецЦикла;
	Для Сч = ДлинаНомера + 1 По ДлинаВсегоНомера Цикл
		ШаблонПоиска = ШаблонПоиска + " ";
	КонецЦикла;
	
	ТекстЗапроса = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПОДСТРОКА(ИнвентарныеНомераОС.Код, &НачальнаяПозиция, &Длина) КАК Значение	
	|ИЗ
	|	Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	|ГДЕ
	|	ИнвентарныеНомераОС.Владелец = &Организация
	|	И ИнвентарныеНомераОС.Код ПОДОБНО &ШаблонПоиска
	|
	|УПОРЯДОЧИТЬ ПО
	|	Значение УБЫВ";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Организация"		, Организация);
	Запрос.УстановитьПараметр("ШаблонПоиска"	, ШаблонПоиска);
	Запрос.УстановитьПараметр("НачальнаяПозиция", ДлинаПрефикса + 1);
	Запрос.УстановитьПараметр("Длина"			, ДлинаПорядковогоНомера);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		НомерЧислом = Число(Выборка.Значение);
	Иначе
		НомерЧислом = 0;		
	КонецЕсли;
	
	ПорядковыйНомер = Формат(НомерЧислом + 1, "ЧЦ=" + ДлинаПорядковогоНомера + "; ЧВН=; ЧГ=");
	
	Возврат ПорядковыйНомер;

КонецФункции

// Устарела.
// Функция формирования инвентарного номера для заданного ОС
//
Функция СформироватьИнвентарныйНомер(ЗапросШаблон, ДатаПоступления, ОС,
	КПС = Неопределено, КФО = Неопределено, СчетУчета = Неопределено, ФормироватьСОшибками = Ложь, СообщатьОбОшибках = Истина) Экспорт
	
	СтруктураШаблона = Новый Структура;
	СтруктураШаблона.Вставить("ПрефиксКода"		, "");
	СтруктураШаблона.Вставить("ПорядковыйНомер"	, "");
	СтруктураШаблона.Вставить("ИнвНомер"		, "");
	
	Если ЗапросШаблон.Пустой() Тогда
		Возврат СтруктураШаблона; 	
	КонецЕсли;
	
	ВыборкаШаблон = ЗапросШаблон.Выбрать();
	ВыборкаШаблон.Следующий();
	
	ТребуемыеПараметры = Новый Соответствие;
	ТребуемыеПараметры.Вставить("КПС"		, КПС);
	ТребуемыеПараметры.Вставить("КФО"		, КФО);
	ТребуемыеПараметры.Вставить("Дата"		, ДатаПоступления);
	ТребуемыеПараметры.Вставить("СчетУчета"	, СчетУчета);
		
	Организация		= ВыборкаШаблон.ТекОрганизация;
	ДлинаИнвНомера	= ВыборкаШаблон.ДлинаИнвНомера;
	Шаблон			= ВыборкаШаблон.Шаблон;
	ВыборкаСостава	= ВыборкаШаблон.СоставИнвНомера.Выгрузить();
	ЕстьОшибки		= Ложь;
	
	СтруктураШаблона.ПрефиксКода = ПолучитьПрефикс(ВыборкаСостава, Организация, ДатаПоступления, ОС, ТребуемыеПараметры, ЕстьОшибки, СообщатьОбОшибках);
	
	Если ФормироватьСОшибками Или Не ЕстьОшибки Тогда
		ПрефиксПоиска = ?(ВыборкаШаблон.БезУчетаПрефикса, Лев("______________________________", СтрДлина(СтруктураШаблона.ПрефиксКода)), СтруктураШаблона.ПрефиксКода);
		СтруктураШаблона.ПорядковыйНомер  = ОпределитьПорядковыйНомер(Организация, ПрефиксПоиска, ДлинаИнвНомера);
		СтруктураШаблона.ИнвНомер         = СтруктураШаблона.ПрефиксКода + СтруктураШаблона.ПорядковыйНомер;
	КонецЕсли;
	
	Возврат СтруктураШаблона;
	
КонецФункции

// Устарела.
// Функция определения префикса инвентарного номера в соответствии с заданным шаблоном.
//
Функция ПолучитьПрефикс(СоставИнвНомера, ТекУчреждение, ДатаПоступления, ОС = Неопределено, ТребуемыеПараметры = Неопределено, ЕстьОшибки = Ложь, СообщатьОбОшибках = Истина)
	Префикс = "";
	Если ТребуемыеПараметры = Неопределено Тогда
		ТребуемыеПараметры = Новый Соответствие;
	КонецЕсли;
	СКД = Новый СхемаКомпоновкиДанных;
	ИсточникДанных = СКД.ИсточникиДанных.Добавить();
	ИсточникДанных.Имя = "ИсточникДанных1";
	ИсточникДанных.ТипИсточникаДанных = "Local";
	
	НаборДанных = СКД.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
	НаборДанных.ИсточникДанных = "ИсточникДанных1";
	НаборДанных.Имя = "НаборДанных1";
	
	ВычисляемыеПоля = СКД.ВычисляемыеПоля;
	
	СоответствияФункций = Новый Соответствие;
	СоответствияФункций.Вставить("сокрлп(","ОбщийМодульСКД.ОбщееСокрЛП(");
	СоответствияФункций.Вставить("число(","ОбщийМодульСКД.ОбщееЧисло(");
	
	ТекстЗапроса = "";
	СоставИнвНомера.Сортировать("НомерСтроки");
	МассивИменПараметров = Новый Массив;
	МассивИменПараметров.Добавить("Дата");
	МассивИменПараметров.Добавить("КПС");
	МассивИменПараметров.Добавить("КФО");
	МассивИменПараметров.Добавить("СчетУчета");
	ЕстьРеквизитыОС = Ложь;
	
	Для Каждого СтрокаСостава Из СоставИнвНомера Цикл
		ИмяРеквизита = СокрЛП(СтрокаСостава.ТипРеквизита);
		Если ИмяРеквизита <> "Текст" Тогда
			Продолжить;
		КонецЕсли;
		МассивИменПараметров.Добавить("Текст"+СтрокаСостава.НомерСтроки);
		ТребуемыеПараметры.Вставить("Текст"+СтрокаСостава.НомерСтроки,СтрокаСостава.Выражение);
	КонецЦикла;
	
	Для Каждого Параметр Из МассивИменПараметров Цикл
		ПараметрСхемы = СКД.Параметры.Добавить();
		ПараметрСхемы.Имя = Параметр;
		ПараметрСхемы.Значение = ТребуемыеПараметры.Получить(Параметр);
		ПараметрСхемы.ОграничениеИспользования	= Истина;	
	КонецЦикла;
	Для Каждого СтрокаСостава Из СоставИнвНомера Цикл
		
		ИмяРеквизита          = СокрЛП(СтрокаСостава.ТипРеквизита);
		Если НЕ ЗначениеЗаполнено(ИмяРеквизита) Тогда
			Продолжить;
		КонецЕсли;
		Выражение             = СокрЛП(СтрокаСостава.Выражение);
		Символ                = СтрокаСостава.Символ;
		
		ИмяРеквизитаВВыражении = ИмяРеквизита;
		Если МассивИменПараметров.Найти(ИмяРеквизита)<>Неопределено Тогда
			ИмяРеквизитаВВыражении = "&"+ИмяРеквизита;
		КонецЕсли;
		
		Если ИмяРеквизита = "Дата" Тогда
			Если ЗначениеЗаполнено(Выражение) Тогда
				ТекстВыражения = " Формат(&Дата,"""+Выражение+""") ";
			КонецЕсли;
		ИначеЕсли (ИмяРеквизита = "") И (Символ = "N") Тогда
			// порядковый номер должен быть в конце
			Прервать;
			
		ИначеЕсли ИмяРеквизита = "АмортизационнаяГруппа" Тогда
			Если ЗначениеЗаполнено(ОС) Тогда
				Если НЕ ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОС,"АмортизационнаяГруппа")) Тогда
					ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Для выбранного основного средства не заполнена амортизационная группа. Префикс не сформирован.'"));
					Возврат Префикс;
				КонецЕсли;
			КонецЕсли;
			
			ТекстВыражения = " Формат(ОбщегоНазначенияБГУ.СвойствоЗначенияПеречисления(АмортизационнаяГруппа,""Индекс"") +1,""ЧЦ=2; ЧВН="") ";
		ИначеЕсли ИмяРеквизита = "Текст" Тогда
			ТекстВыражения = "&Текст"+СтрокаСостава.НомерСтроки;
		Иначе
			ТекстВыражения = "";
			
			Если Найти(Выражение,ИмяРеквизита) Тогда
				ТекстВыражения = СтрЗаменить(Выражение,ИмяРеквизита,ИмяРеквизитаВВыражении);
			Иначе
				ТекстВыражения = ИмяРеквизитаВВыражении;
			КонецЕсли;
		КонецЕсли;
		Если МассивИменПараметров.Найти(ИмяРеквизита) = Неопределено И ИмяРеквизита <> "Текст" Тогда
			ЕстьРеквизитыОС = Истина;
			Если Найти(ТекстЗапроса,"ОС."+ИмяРеквизита) = 0 Тогда
				ОбщийМодульСКД.ДобавитьПолеВНаборДанных(НаборДанных,ИмяРеквизита,"","",,Истина);
				ТекстЗапроса = ТекстЗапроса + ", ОС."+ИмяРеквизита+" КАК " + ИмяРеквизита;
			КонецЕсли;
		КонецЕсли;			
		
		// Формирование вычисляемых полей.	
		ТекПоле = ВычисляемыеПоля.Добавить();
		ТекПоле.ПутьКДанным = "СлужебноеПоле_"+СтрокаСостава.НомерСтроки;//Выборка.ПолеФайлаПередачи+"_"+Выборка.НомерСтроки;
		ТекПоле.Заголовок = ИмяРеквизита;
		ОбщийМодульСКД.ЗаменитьСоответсвия(ТекстВыражения, СоответствияФункций);
		ОбщийМодульСКД.ЗаменитьСтроковыеФункции(ТекстВыражения);
		ОбщийМодульСКД.ЗаменитьУсловныйОператор(ТекстВыражения);
		ТекПоле.Выражение = ТекстВыражения;
	КонецЦикла;
	//ТекстЗапроса = ""+Сред(ТекстЗапроса,3);
	//Если НЕ ЗначениеЗаполнено(ТекстЗапроса) Тогда
	ТекстЗапроса = " ""СлужебноеПоле"" КАК Сл_Поле" +ТекстЗапроса;
	//КонецЕсли;
	ТекстЗапроса = "Выбрать "+ ТекстЗапроса + " ИЗ Справочник.ОсновныеСредства КАК ОС ГДЕ ОС.Ссылка = &Ссылка";
	
	НаборДанных.Запрос = ТекстЗапроса;
	ПараметрСхемы = СКД.Параметры.Добавить();
	ПараметрСхемы.Имя = "Ссылка";
	ПараметрСхемы.Значение = ОС;
	ПараметрСхемы.ОграничениеИспользования	= Истина;
	
	//Добавление в структуру СКД полей.
	ГруппировкаСКД = СКД.НастройкиПоУмолчанию.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ГруппировкаСКД.Имя = "ДетальныеЗаписи";
	ГруппировкаСКД.Использование = Истина;
	
	Поле = ГруппировкаСКД.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	Поле.Поле = Новый ПолеКомпоновкиДанных("Сл_Поле");
	Поле.Использование = Истина;
	Поле.Заголовок = "Сл_Поле";
	
	Для Каждого ВычПоле Из СКД.ВычисляемыеПоля Цикл 
		Поле = ГруппировкаСКД.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		Поле.Поле = Новый ПолеКомпоновкиДанных(ВычПоле.ПутьКДанным);
		Поле.Использование = Истина;
		Поле.Заголовок = ВычПоле.Заголовок;
	КонецЦикла;
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СКД,СКД.НастройкиПоУмолчанию,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки,,,Истина);
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Новый ТаблицаЗначений);
	РезультатВывода = ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
	
	ДанныеРезультата = "";
	ЕстьДанные = Ложь;
	Если РезультатВывода.Количество()>0 Тогда
		ДанныеРезультата = РезультатВывода[0];
		ЕстьДанные = Истина;
	КонецЕсли;
	
	Для Каждого СтрокаСостава Из СоставИнвНомера Цикл
		ИмяРеквизита          = СокрЛП(СтрокаСостава.ТипРеквизита);
		Символ                = СтрокаСостава.Символ;
		Если НЕ ЗначениеЗаполнено(ИмяРеквизита) Тогда
			Продолжить;
		ИначеЕсли (ИмяРеквизита = "") И (Символ = "N") Тогда
			// порядковый номер должен быть в конце 
			Прервать;	
		КонецЕсли;
		
		СоставПрефикса = "";
		Режим = "Слева";
		Если ЕстьДанные Тогда
			СоставПрефикса = ДанныеРезультата["СлужебноеПоле_"+СтрокаСостава.НомерСтроки];
			Если НЕ ЗначениеЗаполнено(СоставПрефикса) Тогда
				ЕстьОшибки = Истина;
				Если СообщатьОбОшибках Тогда
					ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru='Не заполнено значения поля ""%1"", префикс не сформирован.'"),ИмяРеквизита));
				КонецЕсли;	
				Префикс = "";
				Прервать;
			КонецЕсли;
			Если СтрокаСостава.УдалятьПробелы Тогда
				СоставПрефикса = СтрЗаменить(СоставПрефикса," ","");
			КонецЕсли;
			Если СтрокаСостава.ТипРеквизита = "КодПоОКОФ" Тогда
				СоставПрефикса = СтрЗаменить(СоставПрефикса, ".", "");
				Режим = "Справа";
			КонецЕсли;			
			СоставПрефикса = Лев(СоставПрефикса,СтрокаСостава.ДлинаРеквизита);			
		КонецЕсли;
		СоставПрефикса = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(СоставПрефикса, СтрокаСостава.ДлинаРеквизита,, Режим);
		Префикс = Префикс + СоставПрефикса; 
	КонецЦикла;
	
	Возврат Префикс;
	
КонецФункции

// Устарела.
//
Функция ПолучитьПереданныйИнвентарныйНомерИСуммуПередачи(Параметры, ЕстьСубконтоДоговоры, ИспользоватьИнвентарныйНомер, ИспользоватьТаблицу = Ложь) Экспорт
	
	ТаблицаРезультат = Новый ТаблицаЗначений;
	ТаблицаРезультат.Колонки.Добавить("ОсновноеСредство", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ТаблицаРезультат.Колонки.Добавить("ИнвентарныйНомер", Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	ТаблицаРезультат.Колонки.Добавить("СуммаОстатокБал");
	ТаблицаРезультат.Колонки.Добавить("КоличествоОстатокБал");
	ТаблицаРезультат.Колонки.Добавить("СуммаОстатокЗаб");
	ТаблицаРезультат.Колонки.Добавить("КоличествоОстатокЗаб");
	
	Результат = Новый Структура("ИнвентарныйНомер, Сумма, Количество", Справочники.ИнвентарныеНомераОС.ПустаяСсылка(), 0, 0);
	
	Если Не ИспользоватьТаблицу Тогда
		Возврат Результат;
	Иначе
		Возврат ТаблицаРезультат;
	КонецЕсли;
	
КонецФункции

// Устарела. Использовать ФактическийСрокЭксплуатации
//
Функция РассчитатьСрокЭксплуатации(ОсновноеСредство,ИнвНомер,Организация,ТекДата,УчитыватьПринятие = Истина) Экспорт
	ДатаПринятияКУчету     =  '00010101';
	ДатаВводаВЭксплуатацию =  '00010101';
	
	Если УчитыватьПринятие Тогда
		ПолучитьДокументСобытияОС(ОсновноеСредство, ИнвНомер, Организация, Перечисления.ВидыСобытийОС.ПринятиеКУчету,    "", ДатаПринятияКУчету);
	КонецЕсли;
	ПолучитьДокументСобытияОС(ОсновноеСредство, ИнвНомер, Организация, Перечисления.ВидыСобытийОС.ВводВЭксплуатацию,"", ДатаВводаВЭксплуатацию);
	
	Если (ДатаПринятияКУчету='00010101') ИЛИ (ДатаВводаВЭксплуатацию='00010101') Тогда
		ДатаВвода  = Макс(ДатаПринятияКУчету,ДатаВводаВЭксплуатацию);
	Иначе
		ДатаВвода  = Мин(ДатаПринятияКУчету,ДатаВводаВЭксплуатацию);
	КонецЕсли;
	Если ДатаВвода  =  '00010101' Тогда
		СрокЭксплМ = 0;
		СрокЭкспл  = "";
	Иначе
		СрокЭксплМ = РассчитатьМесяцыЭксплуатации(ДатаПринятияКУчету,ДатаВводаВЭксплуатацию,ТекДата);
		СрокЭкспл  = МесяцВГод(СрокЭксплМ);
	КонецЕсли;
	Результат = Новый Структура;
	Результат.Вставить("СрокЭкспл", СрокЭкспл);
	Результат.Вставить("СрокЭксплМ", СрокЭксплМ);
	Результат.Вставить("ДатаВвода", ДатаВвода);
	Результат.Вставить("ДатаПринятияКУчету",ДатаПринятияКУчету);
	Результат.Вставить("ДатаВводаВЭксплуатацию",ДатаВводаВЭксплуатацию);
	Возврат Результат;
КонецФункции

// Устарела.
//
//Получает документ и дату для указанного состояния основного средства по бух учету
//
// Параметры
//
//
// Возвращаемое значение
//  Дата и документ - через указанные параметры процедуры.
//
Процедура ПолучитьДокументСобытияОС(ОсновноеСредство, ИнвНомерП=Неопределено, Организация, Событие, ДокРегистратор, ДатаДокРегистратора) Экспорт
	ТекстУсловия = "";
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Событие",     Событие);
	Запрос.УстановитьПараметр("ОС",          ОсновноеСредство);
	Запрос.УстановитьПараметр("Организация", Организация);
	Если ИнвНомерП = Неопределено Тогда
		Запрос.УстановитьПараметр("ИнвНомер",  Неопределено);
	Иначе
		ТипЗначения = ТипЗнч(ИнвНомерП);
		Если ТипЗначения = Тип("Строка") Тогда
			ИнвНомерЭлемент = Справочники.ИнвентарныеНомераОС.НайтиПоКоду(ИнвНомерП,,,Организация);
			Если ИнвНомерЭлемент <> Справочники.ИнвентарныеНомераОС.ПустаяСсылка() Тогда
				ИнвНомер = ИнвНомерЭлемент;
			КонецЕсли;
		Иначе
			ИнвНомер = ИнвНомерП;
		КонецЕсли;
		Запрос.УстановитьПараметр("ИнвНомер",  ИнвНомер);
	КонецЕсли;
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СобытияОССрезПервых.Регистратор КАК Документ,
	|	СобытияОССрезПервых.ДатаСобытия
	|ИЗ
	|	РегистрСведений.СобытияОС.СрезПервых(
	|			,
	|			Организация = &Организация
	|				И ОсновноеСредство = &ОС
	|				И (ИнвНомер = &ИнвНомер
	|					ИЛИ &ИнвНомер = НЕОПРЕДЕЛЕНО)
	|				И Событие = &Событие) КАК СобытияОССрезПервых";
	
	ВыборкаДоков = Запрос.Выполнить().Выбрать();

	Если ВыборкаДоков.Следующий()  Тогда
		ДокРегистратор      = ВыборкаДоков.Документ;
		ДатаДокРегистратора = ВыборкаДоков.ДатаСобытия;

	Иначе
		ДокРегистратор      = Неопределено;
		ДатаДокРегистратора = '00010101';

	КонецЕсли;

КонецПроцедуры

// Устарела.
//
Функция ПолучитьДатыПередачВозвратовПользование(ТаблицаОС, Организация, Период, Ссылка)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТаблицаОС.ОсновноеСредство КАК ОсновноеСредство,
	               |	ТаблицаОС.ИнвентарныйНомер КАК ИнвентарныйНомер,
	               |	ТаблицаОС.НомерСтроки
	               |ПОМЕСТИТЬ ОсновныеСредства
	               |ИЗ
	               |	&ТаблицаОС КАК ТаблицаОС
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	ОсновноеСредство,
	               |	ИнвентарныйНомер
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	МаксимумМоментВремени.ОсновноеСредство КАК ОсновноеСредство,
	               |	МаксимумМоментВремени.ИнвНомер КАК ИнвНомер,
	               |	МаксимумМоментВремени.Событие,
	               |	МаксимумМоментВремени.ДатаСобытия,
	               |	МаксимумМоментВремени.МоментВремени
	               |ПОМЕСТИТЬ Передачи
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		СобытияОС.ОсновноеСредство КАК ОсновноеСредство,
	               |		СобытияОС.ИнвНомер КАК ИнвНомер,
	               |		СобытияОС.Событие КАК Событие,
	               |		СобытияОС.ДатаСобытия КАК ДатаСобытия,
	               |		СобытияОС.МоментВремени КАК МоментВремени
	               |	ИЗ
	               |		(ВЫБРАТЬ
	               |			СобытияОС.ОсновноеСредство КАК ОсновноеСредство,
	               |			ЕстьNULL(СобытияОС.ИнвНомер, Значение(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)) КАК ИнвНомер,
	               |			СобытияОС.Событие КАК Событие,
	               |			МАКСИМУМ(СобытияОС.ДатаСобытия) КАК ДатаСобытия
	               |		ИЗ
	               |			РегистрСведений.СобытияОС КАК СобытияОС
	               |				ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОсновныеСредства КАК ОсновныеСредства
	               |				ПО СобытияОС.ОсновноеСредство = ОсновныеСредства.ОсновноеСредство
	               |					И ЕстьNULL(СобытияОС.ИнвНомер, ЗНачение(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)) = ОсновныеСредства.ИнвентарныйНомер
	               |		ГДЕ
	               |			СобытияОС.Период <= &Период И &УсловиеМоментВремени
	               |			И СобытияОС.Организация = &Организация
	               |			И СобытияОС.Событие В (&ПередачаАренда, &ПередачаБезвозмездная)
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			СобытияОС.ОсновноеСредство,
	               |			СобытияОС.ИнвНомер,
	               |			СобытияОС.Событие) КАК МаксимумДатаСобытия
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СобытияОС КАК СобытияОС
	               |			ПО МаксимумДатаСобытия.ОсновноеСредство = СобытияОС.ОсновноеСредство
	               |				И МаксимумДатаСобытия.ИнвНомер = СобытияОС.ИнвНомер
	               |				И МаксимумДатаСобытия.Событие = СобытияОС.Событие
	               |				И МаксимумДатаСобытия.ДатаСобытия = СобытияОС.ДатаСобытия
	               |				И (СобытияОС.Организация = &Организация)) КАК МаксимумМоментВремени
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	ОсновноеСредство,
	               |	ИнвНомер
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Т.ОсновноеСредство КАК ОсновноеСредство,
	               |	Т.ИнвНомер КАК ИнвНомер,
	               |	МАКСИМУМ(Т.ДатаСобытия) КАК ДатаСобытия,
	               |	Т.Событие
	               |ПОМЕСТИТЬ Возвраты
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		СобытияОС.ОсновноеСредство КАК ОсновноеСредство,
	               |		СобытияОС.ИнвНомер КАК ИнвНомер,
	               |		СобытияОС.ДатаСобытия КАК ДатаСобытия,
	               |		&ПередачаАренда КАК Событие
	               |	ИЗ
	               |		Передачи КАК Передачи
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СобытияОС КАК СобытияОС
	               |			ПО Передачи.ОсновноеСредство = СобытияОС.ОсновноеСредство
	               |				И Передачи.ИнвНомер = СобытияОС.ИнвНомер
	               |				И Передачи.ДатаСобытия < СобытияОС.ДатаСобытия И &УсловиеМоментВремени
	               |	ГДЕ
	               |		Передачи.Событие = &ПередачаАренда
	               |		И СобытияОС.Событие = &ВозвратАренда
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		СобытияОС.ОсновноеСредство,
	               |		СобытияОС.ИнвНомер,
	               |		СобытияОС.ДатаСобытия,
	               |		&ПередачаАренда
	               |	ИЗ
	               |		Передачи КАК Передачи
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СобытияОС КАК СобытияОС
	               |			ПО Передачи.ОсновноеСредство = СобытияОС.ОсновноеСредство
	               |				И Передачи.ИнвНомер = СобытияОС.ИнвНомер
	               |				И Передачи.ДатаСобытия = СобытияОС.ДатаСобытия И &УсловиеМоментВремени
	               |	ГДЕ
	               |		Передачи.Событие = &ПередачаАренда
	               |		И СобытияОС.Событие = &ВозвратАренда
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		СобытияОС.ОсновноеСредство,
	               |		СобытияОС.ИнвНомер,
	               |		СобытияОС.ДатаСобытия,
	               |		&ПередачаБезвозмездная
	               |	ИЗ
	               |		Передачи КАК Передачи
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СобытияОС КАК СобытияОС
	               |			ПО Передачи.ОсновноеСредство = СобытияОС.ОсновноеСредство
	               |				И Передачи.ИнвНомер = СобытияОС.ИнвНомер
	               |				И Передачи.ДатаСобытия < СобытияОС.ДатаСобытия И &УсловиеМоментВремени
	               |	ГДЕ
	               |		Передачи.Событие = &ПередачаБезвозмездная
	               |		И СобытияОС.Событие = &ВозвратБезвозмездная
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		СобытияОС.ОсновноеСредство,
	               |		СобытияОС.ИнвНомер,
	               |		СобытияОС.ДатаСобытия,
	               |		&ПередачаБезвозмездная
	               |	ИЗ
	               |		Передачи КАК Передачи
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СобытияОС КАК СобытияОС
	               |			ПО Передачи.ОсновноеСредство = СобытияОС.ОсновноеСредство
	               |				И Передачи.ИнвНомер = СобытияОС.ИнвНомер
	               |				И Передачи.ДатаСобытия = СобытияОС.ДатаСобытия
	               |				И Передачи.МоментВремени < СобытияОС.МоментВремени И &УсловиеМоментВремени
	               |	ГДЕ
	               |		Передачи.Событие = &ПередачаБезвозмездная
	               |		И СобытияОС.Событие = &ВозвратБезвозмездная) КАК Т
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	Т.ОсновноеСредство,
	               |	Т.ИнвНомер,
	               |	Т.Событие
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	ОсновноеСредство,
	               |	ИнвНомер
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОсновныеСредства.НомерСтроки,
	               |	ОсновныеСредства.ОсновноеСредство,
	               |	ОсновныеСредства.ИнвентарныйНомер,
	               |	Передачи.Событие,
	               |	Передачи.ДатаСобытия КАК ДатаПередачи,
	               |	Возвраты.ДатаСобытия КАК ДатаВозврата,
	               |	ПРЕДСТАВЛЕНИЕ(ОсновныеСредства.ОсновноеСредство),
	               |	ПРЕДСТАВЛЕНИЕ(ОсновныеСредства.ИнвентарныйНомер)
	               |ИЗ
	               |	ОсновныеСредства КАК ОсновныеСредства
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Передачи КАК Передачи
	               |			ЛЕВОЕ СОЕДИНЕНИЕ Возвраты КАК Возвраты
	               |			ПО Передачи.ОсновноеСредство = Возвраты.ОсновноеСредство
	               |				И Передачи.ИнвНомер = Возвраты.ИнвНомер
	               |				И Передачи.Событие = Возвраты.Событие
	               |		ПО ОсновныеСредства.ОсновноеСредство = Передачи.ОсновноеСредство
	               |			И ОсновныеСредства.ИнвентарныйНомер = Передачи.ИнвНомер";
	Если Ссылка.Пустая() Тогда
		Запрос.УстановитьПараметр("УсловиеМоментВремени", Истина);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеМоментВремени", "СобытияОС.МоментВремени < &МоментВремени");
		Запрос.УстановитьПараметр("МоментВремени", Ссылка.МоментВремени());
	КонецЕсли;
	Запрос.УстановитьПараметр("ТаблицаОС",				ТаблицаОС);
	Запрос.УстановитьПараметр("Организация",			Организация);
	Запрос.УстановитьПараметр("Период",					Период);
	Запрос.УстановитьПараметр("ПередачаБезвозмездная",	Перечисления.ВидыСобытийОС.ПередачаВБезвозмездноеПользование);
	Запрос.УстановитьПараметр("ПередачаАренда",			Перечисления.ВидыСобытийОС.СдачаВАренду);
	Запрос.УстановитьПараметр("ВозвратБезвозмездная",	Перечисления.ВидыСобытийОС.ВозвратИзБезвозмездногоПользования);
	Запрос.УстановитьПараметр("ВозвратАренда",			Перечисления.ВидыСобытийОС.ВозвратИзАренды);
	
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции // ПолучитьДатыПередачВозвратовПользование()

// Устарела.
//
Процедура ПроверитьСобытиеОСвПользовании(ТаблицаОС, Организация, Период, Ссылка, Передача = Истина, ОжидаемоеСобытие = Неопределено, Отказ, ПолеОшибки = Неопределено) Экспорт
	Перем Ошибки;

	ДатыПередачВозвратов = ПолучитьДатыПередачВозвратовПользование(ТаблицаОС, Организация, Период, Ссылка);
	
	СоответствиеСобытий = Новый Соответствие;
	Если Передача Тогда
		ТекстОшибки = НСтр("ru = 'Основное средство ""%1"", инв. №%2 передано в %3 %4'");
		СоответствиеСобытий.Вставить(Перечисления.ВидыСобытийОС.ПередачаВБезвозмездноеПользование, Нстр("ru = 'безмозмездное пользование'"));
		СоответствиеСобытий.Вставить(Перечисления.ВидыСобытийОС.СдачаВАренду, Нстр("ru = 'аренду'"));
	Иначе
		ТекстОшибки = НСтр("ru = 'Основное средство ""%1"", инв. №%2 возвращено из %3 %4'");
		СоответствиеСобытий.Вставить(Перечисления.ВидыСобытийОС.ПередачаВБезвозмездноеПользование, Нстр("ru = 'безмозмездного пользования'"));
		СоответствиеСобытий.Вставить(Перечисления.ВидыСобытийОС.СдачаВАренду, Нстр("ru = 'аренды'"));
	КонецЕсли;
	
	Если ПолеОшибки = Неопределено Тогда
		ПолеОшибки = "Объект.ОсновноеСредство";
	КонецЕсли;
	
	Для каждого Строка Из ДатыПередачВозвратов Цикл
		
		Если НЕ ЗначениеЗаполнено(Строка.ИнвентарныйНомер) Тогда
			// объекты без инв. номера не проверяем
			Продолжить;
		КонецЕсли;
		
		Если Передача Тогда
			Если ЗначениеЗаполнено(Строка.ДатаПередачи) И Не ЗначениеЗаполнено(Строка.ДатаВозврата) Тогда
				ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки,
					ПолеОшибки,
					СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
						Строка.ОсновноеСредствоПредставление, 
						СокрЛП(Строка.ИнвентарныйНомерПредставление),
						СоответствиеСобытий.Получить(Строка.Событие),
						Формат(Строка.ДатаПередачи, "ДЛФ=D")),
					Неопределено, Строка.НомерСтроки-1);
			КонецЕсли;
		Иначе
			ЕстьСобытиеПередача = Ложь;
			Если Строка.Событие = ОжидаемоеСобытие Тогда
				ЕстьСобытиеПередача = Истина;
				Если ЗначениеЗаполнено(Строка.ДатаВозврата) Тогда
					ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки,
						ПолеОшибки,
						СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
							Строка.ОсновноеСредствоПредставление, 
							СокрЛП(Строка.ИнвентарныйНомерПредставление),
							СоответствиеСобытий.Получить(Строка.Событие),
							Формат(Строка.ДатаВозврата, "ДЛФ=D")),
						Неопределено, Строка.НомерСтроки-1);
				КонецЕсли;
			КонецЕсли;
			Если Не ЕстьСобытиеПередача Тогда
				ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки,
					ПолеОшибки,
					СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'Основное средство ""%1"", инв. №%2 не передано в %3'"),
						Строка.ОсновноеСредствоПредставление, 
						СокрЛП(Строка.ИнвентарныйНомерПредставление),
						?(Строка.Событие = ОжидаемоеСобытие,
							Нстр("ru = 'безмозмездное пользование'"),
							Нстр("ru = 'аренду'"))),
					Неопределено, Строка.НомерСтроки-1);
						
			КонецЕсли;
		КонецЕсли;
	
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки, Отказ);

КонецПроцедуры

// Устарела.
//
Функция СписокКодовСчетовПоШаблону(Шаблон) Экспорт
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ЕПСБУ.Код КАК Код
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	&Отбор";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Отбор",
		"Код ПОДОБНО """ + СтрЗаменить(СтрЗаменить(Шаблон, " ", ""), ",", """ ИЛИ Код ПОДОБНО """) + """");
	
	Запрос = Новый Запрос(ТекстЗапроса);
	
	СписокКодов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Код");
	
	Возврат СтрСоединить(СписокКодов, ",");
	
КонецФункции

#КонецОбласти

#Область ИмущественныеНалоги

// Используется при заполнения документов по начислению имущественных налогов.
// Определяет рекомендуемый КПС для учета налога.
//
// Параметры:
//  ВидНалога	- ПеречислениеСсылка.ВидыИмущественныхНалогов
//  КПСУчетаОС  - СправочникСсылка.КлассификационныеПризнакиСчетов - КПС объекта налогообложения
//  НаДату      - Дата
//
// Возвращаемое значение:
//   СправочникСсылка.КлассификационныеПризнакиСчетов - Рекомендуемый КПС
//
Функция КПСУчетаНалогаПоУмолчанию(ВидНалога, КПСУчетаОС, НаДату) Экспорт
	
	КПСУчетаНалога = Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка();
	
	Если Не ЗначениеЗаполнено(ВидНалога) Или Не ЗначениеЗаполнено(КПСУчетаОС) Тогда
		Возврат КПСУчетаНалога;	
	КонецЕсли;

	РеквизитыКПСУчетаОС = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(КПСУчетаОС,
		"Код, ВидПоказателя");
	
	Если РеквизитыКПСУчетаОС.ВидПоказателя = Перечисления.ВидыКБК.Произвольный Тогда
		Возврат КПСУчетаОС;	
	КонецЕсли;

	// Приказ Минфина России от 24.05.2022 N 82н, Приложение N 3
	КодыВидовРасходаПоВидуНалога = Новый Соответствие;
	КодыВидовРасходаПоВидуНалога.Вставить(Перечисления.ВидыИмущественныхНалогов.ТранспортныйНалог, 	"852");
	КодыВидовРасходаПоВидуНалога.Вставить(Перечисления.ВидыИмущественныхНалогов.ЗемельныйНалог, 	"851");
	КодыВидовРасходаПоВидуНалога.Вставить(Перечисления.ВидыИмущественныхНалогов.НалогНаИмущество, 	"851");
	
	КодВидаРасхода = КодыВидовРасходаПоВидуНалога[ВидНалога]; 
	
	Если КодВидаРасхода <> Неопределено Тогда

		КодКПС = СтрШаблон("%1%2", Лев(РеквизитыКПСУчетаОС.Код, 14), КодВидаРасхода);
		КПСУчетаНалога = БухгалтерскийУчетПовтИсп.КПСПоКоду(КодКПС, НаДату, РеквизитыКПСУчетаОС.ВидПоказателя);
		
	КонецЕсли;

	Возврат КПСУчетаНалога;	
КонецФункции

#КонецОбласти

#Область ОпределениеСчетаУчета

// Возвращает таблицу кодов счетов 101.00 группы в зависимости от типа НФА
//
// Параметры:
//  Организация  - СправочникСсылка.Организации
//  Дата         - Дата
//
// Возвращаемое значение:
//   ТаблицаЗначений
Функция СчетаГруппыОСПоТипамНФА(Дата, Организация) Экспорт
	
	СчетаУчетаОС = Новый ТаблицаЗначений;
	СчетаУчетаОС.Колонки.Добавить("ТипНФА", Новый ОписаниеТипов("ПеречислениеСсылка.ТипыНФА"));
	СчетаУчетаОС.Колонки.Добавить("ВидИмущества", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыИмущества"));
	СчетаУчетаОС.Колонки.Добавить("Счет", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));

	Если Не ЗначениеЗаполнено(Дата) Тогда
		Дата = ОбщегоНазначения.ТекущаяДатаПользователя();
	КонецЕсли;
	
	СчетаГруппыОС = СчетаГруппыОС(Дата, Организация);
	
	//101.1X
	ДобавитьСтрокуТаблицыСчетаУчетаОС(Перечисления.ТипыНФА.ЖилыеПомещения, Перечисления.ВидыИмущества.НедвижимоеИмущество, "101.11", СчетаУчетаОС, СчетаГруппыОС);
	ДобавитьСтрокуТаблицыСчетаУчетаОС(Перечисления.ТипыНФА.НежилыеПомещения, Перечисления.ВидыИмущества.НедвижимоеИмущество, "101.12", СчетаУчетаОС, СчетаГруппыОС);
	ДобавитьСтрокуТаблицыСчетаУчетаОС(Перечисления.ТипыНФА.Сооружения, Перечисления.ВидыИмущества.НедвижимоеИмущество, "101.12", СчетаУчетаОС, СчетаГруппыОС);
	ДобавитьСтрокуТаблицыСчетаУчетаОС(Перечисления.ТипыНФА.ИнвестиционнаяНедвижимость, Перечисления.ВидыИмущества.НедвижимоеИмущество, "101.13", СчетаУчетаОС, СчетаГруппыОС);
	ДобавитьСтрокуТаблицыСчетаУчетаОС(Перечисления.ТипыНФА.Транспорт, Перечисления.ВидыИмущества.НедвижимоеИмущество, "101.15", СчетаУчетаОС, СчетаГруппыОС);

	//101.2X
	ДобавитьСтрокуТаблицыСчетаУчетаОС(Перечисления.ТипыНФА.НежилыеПомещения, Перечисления.ВидыИмущества.ДвижимоеОсобоЦенное, "101.22", СчетаУчетаОС, СчетаГруппыОС);
	ДобавитьСтрокуТаблицыСчетаУчетаОС(Перечисления.ТипыНФА.Оборудование, Перечисления.ВидыИмущества.ДвижимоеОсобоЦенное, "101.24", СчетаУчетаОС, СчетаГруппыОС);
