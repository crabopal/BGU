					Иначе 
						СтруктураНовойТаблицыМногостраничныхРазделов.Вставить(Показатель.Ключ, ОбщегоНазначенияБГУКлиентСервер.ПустоеЗначениеТипа(ТипЗнч(Показатель.Значение)));
