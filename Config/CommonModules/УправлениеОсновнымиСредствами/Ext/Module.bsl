	|	ЕСТЬNULL(ВТ_ДополнительныеРеквизиты.ДатаПрекращенияРегистрации, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаПрекращенияРегистрации,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(СобытияОССрезПоследних.ИнвНомер.ДатаВыпуска, ДАТАВРЕМЯ(1, 1, 1)) = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА 0
	|		ИНАЧЕ ГОД(СобытияОССрезПоследних.ИнвНомер.ДатаВыпуска)
	|	КОНЕЦ КАК ГодВыпуска,
	|	1 КАК ДоляВПравеОбщейСобственностиЧислитель,
	|	1 КАК ДоляВПравеОбщейСобственностиЗнаменатель,
	|	0 КАК ПовышающийКоэффициент
	|ИЗ
	|	ВТ_Разрез КАК ВТ_Разрез
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РазличныеЗаписи КАК ВТ_РазличныеЗаписи
	|		ПО ВТ_Разрез.ОсновноеСредство = ВТ_РазличныеЗаписи.ОсновноеСредство
	|			И ВТ_Разрез.КодПоОКАТО = ВТ_РазличныеЗаписи.КодПоОКАТО
	|			И ВТ_Разрез.КодВидаТранспортногоСредства = ВТ_РазличныеЗаписи.КодВидаТранспортногоСредства
	|			И ВТ_Разрез.НалоговаяБаза = ВТ_РазличныеЗаписи.НалоговаяБаза
	|			И ВТ_Разрез.ЕдиницаИзмеренияНалоговойБазы = ВТ_РазличныеЗаписи.ЕдиницаИзмеренияНалоговойБазы
	|			И ВТ_Разрез.НалоговаяСтавка = ВТ_РазличныеЗаписи.НалоговаяСтавка
	|			И (ВТ_Разрез.КоличествоЛьгот <> 1
	|				ИЛИ ВТ_РазличныеЗаписи.НалоговаяЛьгота <> &ЛьготаНеПрименяется)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДополнительныеРеквизиты КАК ВТ_ДополнительныеРеквизиты
	|		ПО ВТ_Разрез.ОсновноеСредство = ВТ_ДополнительныеРеквизиты.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СобытияОС.СрезПоследних(
	|				&Период12,
	|				Организация = &Организация
	|					И Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)) КАК СобытияОССрезПоследних
	|		ПО ВТ_Разрез.ОсновноеСредство = СобытияОССрезПоследних.ОсновноеСредство
	|
	|УПОРЯДОЧИТЬ ПО
	|	КодПоОКАТО,
	|	ОсновноеСредство";
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

	ПутьКРегистру = "(меню ""Налоги / Транспортный налог / Регистрация транспортных средств"")";
	
	Если Выборка.Количество() = 0 Тогда
		
		ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru='Отсутствуют данные о регистрации транспортных средств  на %1 для %2
		|%3'"), 
		ПредставлениеПериода(НачалоДня(ПараметрыОтчета.мДатаНачалаПериодаОтчета), КонецДня(ПараметрыОтчета.мДатаКонцаПериодаОтчета),"ФП = Истина")
		,ПараметрыОтчета.Организация, ПутьКРегистру));
		
		Возврат;
		
	КонецЕсли;
	
	
	ОчиститьРаздел(Контейнер.Раздел2);
	
	ПерваяСтраница = Истина;
		
	Пока Выборка.Следующий() Цикл
		
		СтраницаРаздел2 = ПоказателиРаздела(Контейнер.Раздел2, Не ПерваяСтраница);
		ПерваяСтраница = Ложь;
		
		СтраницаРаздел2.П000020002003			= Выборка.КодПоОКАТО;
		СтраницаРаздел2.П000020003003			= Выборка.КодВидаТранспортногоСредства;
		СтраницаРаздел2.П000020004003			= Выборка.ИдентификационныйНомер;
		СтраницаРаздел2.П000020005003			= Выборка.Марка;
		СтраницаРаздел2.П000020006003			= Выборка.РегистрационныйЗнак;
		СтраницаРаздел2.П000020007003			= Выборка.ДатаРегистрации;
		СтраницаРаздел2.П000020008003			= Выборка.ДатаПрекращенияРегистрации;
