КонецФункции

// Устарела. Фунция определяет есть ли в справочнике инвентарных номеров
// записи для заданной организации
Функция ЕстьЭлементыВСправочникеИнвНомер(Организация) Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Спр.Ссылка
	|ИЗ
	|	Справочник.ИнвентарныеНомераОС КАК Спр
	|ГДЕ
	|	Спр.Владелец = &Организация";
	
	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции

Функция ПолучитьИмяПоказателяРасшифровки(ИДИменПоказателей, ПараметрыОтчета) Экспорт
	
	ИмяПоказателя = Неопределено;
	
	ТаблицаРасшифровок = ПолучитьИзВременногоХранилища(ПараметрыОтчета.АдресВременногоХранилищаРасшифровки);
	
	Если ТипЗнч(ТаблицаРасшифровок) = Тип("ТаблицаЗначений") Тогда
		ИмяПоказателя = ИДИменПоказателей[0];
		
		НомерТекущейСтраницы = 0;
		ПараметрыОтчета.Свойство("НомерТекущейСтраницы", НомерТекущейСтраницы);
		Если ЗначениеЗаполнено(НомерТекущейСтраницы) Тогда
			ИмяПоказателя = ИмяПоказателя + "_" + НомерТекущейСтраницы;
		КонецЕсли;
		
		СтрокаРасшифровки = ТаблицаРасшифровок.Найти(ИмяПоказателя, "ИмяПоказателя");
		Если СтрокаРасшифровки = Неопределено Тогда
			ИмяПоказателя = Неопределено;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ИмяПоказателя;
	
КонецФункции

