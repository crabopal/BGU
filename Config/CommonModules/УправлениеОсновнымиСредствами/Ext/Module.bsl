	|	ОстаткиБаланс.Счет КАК Счет,
	|	ОстаткиБаланс.ОсновноеСредство КАК ОсновноеСредство,
	|	ОстаткиБаланс.ОсновноеСредство.Наименование КАК ОсновноеСредствоНаименование,
	|	ОстаткиБаланс.ОсновноеСредство.Код КАК ОсновноеСредствоКод,
	|	ОстаткиБаланс.ОсновноеСредство.ГрупповойУчет КАК ГрупповойУчет,
	|	ОстаткиБаланс.ЦМО КАК ЦМО,
	|	ОстаткиБаланс.Договор КАК Договор,
	|	ОстаткиБаланс.БалансоваяСтоимость КАК БалансоваяСтоимость,
	|	ОстаткиБаланс.КоличествоОстаток КАК КоличествоОстаток,
	|	ОстаткиБаланс.КПС КАК КПС,
	|	ОстаткиБаланс.КФО КАК КФО
	|ИЗ
	|	ОстаткиБаланс КАК ОстаткиБаланс
	|ГДЕ
	|	ОстаткиБаланс.УсловиеПодразделение = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстаткиБаланс.Счет КАК Счет,
	|	ОстаткиБаланс.ОсновноеСредство КАК ОсновноеСредство,
	|	СУММА(ОстаткиБаланс.БалансоваяСтоимость) КАК БалансоваяСтоимость,
	|	СУММА(ОстаткиБаланс.КоличествоОстаток) КАК КоличествоОстаток,
	|	ОстаткиБаланс.КПС КАК КПС,
	|	ОстаткиБаланс.КФО КАК КФО
	|ИЗ
	|	ОстаткиБаланс КАК ОстаткиБаланс
	|
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиБаланс.Счет,
	|	ОстаткиБаланс.ОсновноеСредство,
	|	ОстаткиБаланс.КПС,
	|	ОстаткиБаланс.КФО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстаткиАморт.ОсновноеСредство КАК ОсновноеСредство,
	|	ОстаткиАморт.СуммаАморт КАК СуммаАморт,
	|	ОстаткиАморт.КПС КАК КПС,
	|	ОстаткиАморт.КФО КАК КФО
	|ИЗ
	|	ОстаткиАмортизация КАК ОстаткиАморт
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Местонахождение.ОсновноеСредство КАК ОсновноеСредство,
	|	Местонахождение.ИнвНомер КАК ИнвентарныйНомер,
	|	Местонахождение.ИнвНомер.Код КАК ИнвентарныйНомерКод,
	|	Местонахождение.ЦМО КАК ЦМО,
	|	Местонахождение.Состояние КАК Состояние,
	|	Местонахождение.БезИнвентарногоНомера КАК БезИнвентарногоНомера,
	|	Местонахождение.ВведеноВЭксплуатацию КАК ВведеноВЭксплуатацию,
	|	СУММА(ЕСТЬNULL(МестонахождениеВЭкспл.КоличествоВЭксплуатации, 0)) КАК КоличествоВЭксплуатации,
	|	СУММА(ЕСТЬNULL(МестонахождениеВЭкспл.КоличествоВсего, 0)) КАК КоличествоВсего,
	|	МАКСИМУМ(ЕСТЬNULL(МестонахождениеВЭксплВсего.КоличествоВЭксплуатации, 0)) КАК КоличествоВЭксплуатацииВсего
	|ИЗ
	|	Местонахождение КАК Местонахождение
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			Местонахождение.ОсновноеСредство КАК ОсновноеСредство,
	|			Местонахождение.ИнвНомер КАК ИнвентарныйНомер,
	|			Местонахождение.ЦМО КАК ЦМО,
	|			ВЫБОР
	|				КОГДА Местонахождение.ВведеноВЭксплуатацию
	|					ТОГДА 1
	|				ИНАЧЕ 0
	|			КОНЕЦ КАК КоличествоВЭксплуатации,
	|			1 КАК КоличествоВсего
	|		ИЗ
	|			Местонахождение КАК Местонахождение) КАК МестонахождениеВЭкспл
	|		ПО Местонахождение.ОсновноеСредство = МестонахождениеВЭкспл.ОсновноеСредство
	|			И Местонахождение.ЦМО = МестонахождениеВЭкспл.ЦМО
	|			И Местонахождение.ИнвНомер = МестонахождениеВЭкспл.ИнвентарныйНомер
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			Местонахождение.ОсновноеСредство КАК ОсновноеСредство,
	|			КОЛИЧЕСТВО(Местонахождение.ВведеноВЭксплуатацию) КАК КоличествоВЭксплуатации
	|		ИЗ
	|			Местонахождение КАК Местонахождение
	|		ГДЕ
	|			Местонахождение.ВведеноВЭксплуатацию
	|		
	|		СГРУППИРОВАТЬ ПО
	|			Местонахождение.ОсновноеСредство) КАК МестонахождениеВЭксплВсего
	|		ПО (МестонахождениеВЭксплВсего.ОсновноеСредство = МестонахождениеВЭкспл.ОсновноеСредство)
	|
	|СГРУППИРОВАТЬ ПО
	|	Местонахождение.ОсновноеСредство,
	|	Местонахождение.ИнвНомер,
	|	Местонахождение.ИнвНомер.Код,
	|	Местонахождение.ЦМО,
	|	Местонахождение.Состояние,
	|	Местонахождение.БезИнвентарногоНомера,
	|	Местонахождение.ВведеноВЭксплуатацию
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстаткиОбесц.ОсновноеСредство КАК ОсновноеСредство,
	|	ОстаткиОбесц.СуммаОбесц КАК СуммаОбесц,
	|	ОстаткиОбесц.КПС КАК КПС,
	|	ОстаткиОбесц.КФО КАК КФО
	|ИЗ
	|	ОстаткиОбесценения КАК ОстаткиОбесц";

	НачальныйИндексДанныхВЗапросе = НачальныйИндексДанныхВЗапросе + 2;
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ОстаткиБаланс = РезультатЗапроса[НачальныйИндексДанныхВЗапросе].Выгрузить();
	ОстаткиБалансВсего = РезультатЗапроса[НачальныйИндексДанныхВЗапросе + 1].Выгрузить();
	ОстаткиАморт = РезультатЗапроса[НачальныйИндексДанныхВЗапросе + 2].Выгрузить();
	Местонахождение = РезультатЗапроса[НачальныйИндексДанныхВЗапросе + 3].Выгрузить();
	ОстаткиОбесц = РезультатЗапроса[НачальныйИндексДанныхВЗапросе + 4].Выгрузить();
	
	Для каждого ТекСтрокаОС Из ТаблицаОС Цикл
		
		СтрокаИнвентарногоНомера = Неопределено;
		СтрокаБалансоваяСтоимость = Неопределено;
		
		УстанавливатьИнвентарныйНомер = ПараметрыПолученияОстатков.УстанавливатьИнвентарныйНомер;
		
		ЕстьБалансоваяСтоимость = Истина;
		Если Не ПараметрыПолученияОстатков.ИспользуемыйСчет = "ПолученныеПоЦС" Тогда
			Если УстанавливатьИнвентарныйНомер ИЛИ НЕ ЗначениеЗаполнено(ТекСтрокаОС.ИнвентарныйНомер) Тогда
				
				Отбор = Новый Структура("ОсновноеСредство, ЦМО");
				ЗаполнитьЗначенияСвойств(Отбор, ПараметрыПолученияОстатков);
				ЗаполнитьЗначенияСвойств(Отбор, ТекСтрокаОС);
				СтрокиМестонахождения = Местонахождение.НайтиСтроки(Отбор);
				Если СтрокиМестонахождения.Количество() > 1 Тогда
					УстанавливатьИнвентарныйНомер = Ложь;
				ИначеЕсли СтрокиМестонахождения.Количество() > 0 Тогда
					СтрокаИнвентарногоНомера = СтрокиМестонахождения[0];
				ИначеЕсли УстанавливатьИнвентарныйНомер Тогда
					ЕстьБалансоваяСтоимость = Ложь;
				КонецЕсли;
				
			Иначе
				
				Если УчетПоЦМОБаланс Тогда
					// Если есть ЦМО на балансе, то есть и в регистре накопления "Стоимость остатков ОС",
					// из которого получается таблица "Местонахождение"
					Отбор = Новый Структура("ОсновноеСредство, ЦМО, ИнвентарныйНомер");
				Иначе	
					Отбор = Новый Структура("ОсновноеСредство, ИнвентарныйНомер");
				КонецЕсли;	
				ЗаполнитьЗначенияСвойств(Отбор, ПараметрыПолученияОстатков);
				ЗаполнитьЗначенияСвойств(Отбор, ТекСтрокаОС);
				СтрокиМестонахождения = Местонахождение.НайтиСтроки(Отбор);
				Если СтрокиМестонахождения.Количество() > 0 Тогда
					СтрокаИнвентарногоНомера = СтрокиМестонахождения[0];
				Иначе
					// если по указанному инв. номеру нет остатков, то инв. номер уже у другого ЦМО
					ЕстьБалансоваяСтоимость = Ложь;
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
		
		Если ЕстьБалансоваяСтоимость Тогда
			ОтборБаланс = Новый Структура("ОсновноеСредство", ТекСтрокаОС.ОсновноеСредство);
			Если НЕ ПараметрыПолученияОстатков.УстанавливатьКПС И УчетПоКПСБаланс Тогда
				ОтборБаланс.Вставить("КПС", ТекСтрокаОС.КПС);
			КонецЕсли;
			Если ПараметрыПолученияОстатков.УстанавливатьКФО = Ложь Тогда
				ОтборБаланс.Вставить("КФО", ТекСтрокаОС.КФО);
			КонецЕсли;
			Если УчетПоЦМОБаланс Тогда
				ОтборБаланс.Вставить("ЦМО", ПараметрыПолученияОстатков.ЦМО);
			КонецЕсли;	
			
			СтрокиБаланс = ОстаткиБаланс.НайтиСтроки(ОтборБаланс);
			СтрокаБалансоваяСтоимость = Неопределено;
			Если СтрокиБаланс.Количество() > 0 Тогда
				СтрокаБалансоваяСтоимость = СтрокиБаланс[0];
				Если СтрокаБалансоваяСтоимость.БалансоваяСтоимость = 0 Тогда
					ЕстьБалансоваяСтоимость = Ложь;
				КонецЕсли;
			Иначе
				ЕстьБалансоваяСтоимость = Ложь;
			КонецЕсли;
		КонецЕсли;
		
		ЭтоБиблиотечныйФонд = (ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекСтрокаОС.ОсновноеСредство, "ТипНФА") =
								Перечисления.ТипыНФА.БиблиотечныйФонд);
		
		Если Не ЕстьБалансоваяСтоимость И ПараметрыПолученияОстатков.ПолучатьАмортизациюБезБалансовойСтоимости Тогда
			
			Если ПараметрыПолученияОстатков.ПолучатьАмортизациюБезБалансовойСтоимости Тогда
				
				Отбор = Новый Структура("ОсновноеСредство", ТекСтрокаОС.ОсновноеСредство);
				Отбор.Вставить("КПС", ТекСтрокаОС.КПС);
				Если ЗначениеЗаполнено(ПараметрыПолученияОстатков.КФО) Тогда
					Отбор.Вставить("КФО", ПараметрыПолученияОстатков.КФО);
				КонецЕсли;
				СтрокиАморт = ОстаткиАморт.НайтиСтроки(Отбор);
				
				Если СтрокиАморт.Количество() > 0 Тогда
					СтрокаОстатков = ТаблицаОстатков.Добавить();
					СтрокаОстатков.ОсновноеСредство = ТекСтрокаОС.ОсновноеСредство;
					СтрокаОстатков.ЭтоБиблиотечныйФонд = ЭтоБиблиотечныйФонд;
					СтрокаОстатков.КПСТаблицы = ТекСтрокаОС.КПС;
					СтрокаОстатков.КФОТаблицы = ТекСтрокаОС.КФО;
					СтрокаОстатков.СуммаАмортизации = СтрокиАморт[0].СуммаАморт;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если Не ЕстьБалансоваяСтоимость Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаОстатков = ТаблицаОстатков.Добавить();
		СтрокаОстатков.ОсновноеСредство = ТекСтрокаОС.ОсновноеСредство;
		СтрокаОстатков.ЭтоБиблиотечныйФонд = ЭтоБиблиотечныйФонд;
		Если УстанавливатьИнвентарныйНомер И СтрокаИнвентарногоНомера <> Неопределено Тогда
			СтрокаОстатков.ИнвентарныйНомер = СтрокаИнвентарногоНомера.ИнвентарныйНомер;
		Иначе
			СтрокаОстатков.ИнвентарныйНомер = ТекСтрокаОС.ИнвентарныйНомер;
		КонецЕсли;
		Если СтрокаИнвентарногоНомера <> Неопределено Тогда
			СтрокаОстатков.Состояние = СтрокаИнвентарногоНомера.Состояние;
		КонецЕсли;
		СтрокаОстатков.КПСТаблицы = ТекСтрокаОС.КПС;
		СтрокаОстатков.КПСОстатков = СтрокаБалансоваяСтоимость.КПС;
		СтрокаОстатков.КФОТаблицы = ТекСтрокаОС.КФО;
		СтрокаОстатков.КФООстатков = СтрокаБалансоваяСтоимость.КФО;
		СтрокаОстатков.Счет = СтрокаБалансоваяСтоимость.Счет;
		СтрокаОстатков.Договор = СтрокаБалансоваяСтоимость.Договор;
		
		Отбор = Новый Структура("ОсновноеСредство, Счет, КПС, КФО");
		ЗаполнитьЗначенияСвойств(Отбор, СтрокаБалансоваяСтоимость);
		ОстаткиВсего = ОстаткиБалансВсего.НайтиСтроки(Отбор)[0];
		Если СтрокаИнвентарногоНомера = Неопределено Тогда
			СтрокаОстатков.КоличествоВсего = ОстаткиВсего.КоличествоОстаток;
			СтрокаОстатков.КоличествоВЭксплуатации = ОстаткиВсего.КоличествоОстаток;
			СтрокаОстатков.ИнвентарныйНомерКод = "";
		Иначе
			СтрокаОстатков.КоличествоВсего = СтрокаИнвентарногоНомера.КоличествоВсего;
			СтрокаОстатков.КоличествоВЭксплуатации = СтрокаИнвентарногоНомера.КоличествоВЭксплуатации;
			СтрокаОстатков.ИнвентарныйНомерКод = СокрП(СтрокаИнвентарногоНомера.ИнвентарныйНомерКод);
		КонецЕсли;
		СтрокаОстатков.БалансоваяСтоимость = ОстаткиВсего.БалансоваяСтоимость;
		СтрокаОстатков.КоличествоОстаток = ОстаткиВсего.КоличествоОстаток;
		СтрокаОстатков.БалансоваяСтоимостьМОЛ = СтрокаБалансоваяСтоимость.БалансоваяСтоимость;
		СтрокаОстатков.КоличествоОстатокМОЛ = СтрокаБалансоваяСтоимость.КоличествоОстаток;
		СтрокаОстатков.СтоимостьЕдиницыНеокругленная = ?(СтрокаОстатков.КоличествоОстатокМОЛ = 0, 0, 
			СтрокаОстатков.БалансоваяСтоимостьМОЛ / СтрокаОстатков.КоличествоОстатокМОЛ);
		СтрокаОстатков.СтоимостьЕдиницы = Окр(СтрокаОстатков.СтоимостьЕдиницыНеокругленная, 2);
		СтрокаОстатков.ОсновноеСредствоНаименование = СтрокаБалансоваяСтоимость.ОсновноеСредствоНаименование;
		СтрокаОстатков.ОсновноеСредствоКод = СтрокаБалансоваяСтоимость.ОсновноеСредствоКод;
		
		СтрокаОстатков.КоличествоВДокументе = ТекСтрокаОС.Количество;
		
		СтрокаОстатков.СуммаАмортизации = 0;
		СтрокаОстатков.Амортизация = 0;

		Если ПараметрыПолученияОстатков.ПолучатьАмортизацию 
			И (СтрокаИнвентарногоНомера <> Неопределено ИЛИ ЭтоБиблиотечныйФонд) Тогда
		
			Отбор = Новый Структура("ОсновноеСредство", ТекСтрокаОС.ОсновноеСредство);
			Отбор.Вставить("КПС", СтрокаБалансоваяСтоимость.КПС);
			Отбор.Вставить("КФО", СтрокаБалансоваяСтоимость.КФО);
			СтрокиАморт = ОстаткиАморт.НайтиСтроки(Отбор);
			
			Если СтрокиАморт.Количество() > 0 Тогда
				СтрокаОстатков.СуммаАмортизации = СтрокиАморт[0].СуммаАморт;
			КонецЕсли;
			
			Если Не СтрокаБалансоваяСтоимость.ГрупповойУчет Тогда
				СтрокаОстатков.Амортизация = СтрокаОстатков.СуммаАмортизации;
			ИначеЕсли ЭтоБиблиотечныйФонд Тогда
				СтрокаОстатков.Амортизация = СтрокаОстатков.СтоимостьЕдиницыНеокругленная * СтрокаОстатков.КоличествоВДокументе;				
			ИначеЕсли СтрокаИнвентарногоНомера <> Неопределено И СтрокаИнвентарногоНомера.ВведеноВЭксплуатацию Тогда
				СтрокаОстатков.Амортизация = СтрокаОстатков.СуммаАмортизации / СтрокаИнвентарногоНомера.КоличествоВЭксплуатацииВсего;
			КонецЕсли;
			
			Если НЕ ЭтоБиблиотечныйФонд Тогда
				// колонка сумма амортизации для библ. содержит полную сумму амортизации. Используется в вызовах из форм документов
				// в остальных случаях содержит сумму аморт. текущего инв. номера ОС. Используется в типовых операциях
				СтрокаОстатков.СуммаАмортизации = СтрокаОстатков.Амортизация;
			КонецЕсли;
			
		КонецЕсли;
	
		Если ПараметрыПолученияОстатков.ПолучатьОбесценение И СтрокаИнвентарногоНомера <> Неопределено Тогда
			Отбор = Новый Структура("ОсновноеСредство", ТекСтрокаОС.ОсновноеСредство);
			Отбор.Вставить("КПС", СтрокаБалансоваяСтоимость.КПС);
			Отбор.Вставить("КФО", СтрокаБалансоваяСтоимость.КФО);
			СтрокиОбесц = ОстаткиОбесц.НайтиСтроки(Отбор);
			
			Если СтрокиОбесц.Количество() > 0 Тогда
				СтрокаОстатков.СуммаОбесценения = СтрокиОбесц[0].СуммаОбесц;
			КонецЕсли;

			Если СтрокаБалансоваяСтоимость.ГрупповойУчет 
				И СтрокаИнвентарногоНомера <> Неопределено
				И СтрокаИнвентарногоНомера.КоличествоВЭксплуатацииВсего <> 0 Тогда
				СтрокаОстатков.СуммаОбесценения = СтрокаОстатков.СуммаОбесценения 
					/ СтрокаИнвентарногоНомера.КоличествоВЭксплуатацииВсего;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла; 
	
	Возврат ТаблицаОстатков;
	
КонецФункции // ПолучитьОстатки()

// Возвращает остатки вложений в нефинансовые активы для заданного объекта вложений
//
Функция ПолучитьОстаткиПоОбъектуВложенийВНФА(Параметры) Экспорт

	Остатки = Новый Структура("ОбъектВложений, Количество, Сумма, СуммаНУ, СуммаНеУчитываетсяНУ, СуммаЕНВД",
		Параметры.ОбъектВложений, 0, 0, 0, 0, 0);
	Остатки.Вставить("КПС", Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка());
	Остатки.Вставить("Счет", ПланыСчетов.ЕПСБУ.ПустаяСсылка());
	
	НомераТаблиц = Новый Структура;
	Запрос = Новый Запрос;
	
	СчетВложений = Параметры.СчетВложений;
	Если Не ЗначениеЗаполнено(СчетВложений) Тогда
		СчетВложений = УправлениеОсновнымиСредствами.СчетВложенийОС(Параметры.ОбъектВложений, Параметры.ПериодОстатков);
		Остатки.Вставить("Счет", СчетВложений);
	КонецЕсли;
	Запрос.УстановитьПараметр("ПериодОстатков", Параметры.ПериодОстатков);
	Запрос.УстановитьПараметр("Организация",    Параметры.Организация);
	Запрос.УстановитьПараметр("Подразделение",  Параметры.Подразделение);
	Запрос.УстановитьПараметр("ИФО",            Параметры.ИФО);
	Запрос.УстановитьПараметр("КФО",            Параметры.КФО);
	Запрос.УстановитьПараметр("КПС",            Параметры.КПС);
	Запрос.УстановитьПараметр("СчетВложений",   СчетВложений);
	Запрос.УстановитьПараметр("ОбъектВложений", Параметры.ОбъектВложений);
	
	НомераТаблиц.Вставить("ОстаткиБУ", НомераТаблиц.Количество());
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОбъектВложений,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстаток КАК Сумма,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстаток КАК Количество,
	|	ЖурналПроводокЕПСБУОстатки.Счет,
	|	ЖурналПроводокЕПСБУОстатки.КПС
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&ПериодОстатков,
	|			Счет = &СчетВложений,
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
	|			Организация = &Организация
	|				И &УсловиеИФО
	|				И &УсловиеПодразделение
	|				И &УсловиеКПС
	|				И КФО = &КФО
	|				И Субконто1 = &ОбъектВложений) КАК ЖурналПроводокЕПСБУОстатки";
	
	ОтражатьВНалоговомУчете = НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(Параметры.Организация, Параметры.Дата, Параметры.КФО);
	Если ОтражатьВНалоговомУчете Тогда
		
		Запрос.УстановитьПараметр("СчетаВложенийНУ", БухгалтерскийУчет.СписокСчетов("Н08"));
		
		НомераТаблиц.Вставить("ОстаткиНУ", НомераТаблиц.Количество());
		Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОбъектВложений,
		|	ЖурналПроводокЕПСБУОстатки.СуммаОстаток КАК СуммаНУ,
		|	ЖурналПроводокЕПСБУОстатки.СуммаНеУчитываетсяНУОстаток КАК СуммаНеУчитываетсяНУ,
		|	ЖурналПроводокЕПСБУОстатки.СуммаЕНВДОстаток КАК СуммаЕНВД
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&ПериодОстатков,
		|			Счет В (&СчетаВложенийНУ),
		|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
		|			Организация = &Организация
		|				И &УсловиеИФО
		|				И КФО = &КФО
		|				И Субконто1 = &ОбъектВложений) КАК ЖурналПроводокЕПСБУОстатки";
		
	КонецЕсли;
	
	// Отборы по ИФО и Подразделению
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
		И БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетВложений).УчетПоПодразделениям;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО",
		?(ИспользоватьУчетПоИФО, "ИФО = &ИФО", "ИСТИНА"));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПодразделение",
		?(ИспользоватьУчетПоПодразделениям, "Подразделение = &Подразделение", "ИСТИНА"));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКПС",
		?(ЗначениеЗаполнено(Параметры.КПС), "КПС = &КПС", "ИСТИНА"));
	
	Результат = Запрос.ВыполнитьПакет();
	
	ВыборкаБУ = Результат[НомераТаблиц.ОстаткиБУ].Выбрать();
	Если ВыборкаБУ.Следующий() Тогда
		Остатки.Количество	= ВыборкаБУ.Количество;
		Остатки.Сумма		= ВыборкаБУ.Сумма;
		Остатки.КПС			= ВыборкаБУ.КПС;
		Остатки.Счет		= ВыборкаБУ.Счет;
	КонецЕсли;
	
	Если ОтражатьВНалоговомУчете Тогда
		
		ВыборкаНУ = Результат[НомераТаблиц.ОстаткиНУ].Выбрать();
		Если ВыборкаНУ.Следующий() Тогда
			Остатки.СуммаНУ              = ВыборкаНУ.СуммаНУ;
			Остатки.СуммаНеУчитываетсяНУ = ВыборкаНУ.СуммаНеУчитываетсяНУ;
			Остатки.СуммаЕНВД            = ВыборкаНУ.СуммаЕНВД;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Остатки;

КонецФункции

Функция СтруктураПараметровПолученияОстатков(Объект, ДатаСписанияСБухУчета = Неопределено) Экспорт

	СтруктураПараметров = ПустаяСтруктураПараметровПолученияОстатков();
	Если Объект.Ссылка.Пустая() Тогда
		Если ЗначениеЗаполнено(ДатаСписанияСБухУчета) Тогда
			СтруктураПараметров.Период = КонецДня(ДатаСписанияСБухУчета);
		Иначе
			СтруктураПараметров.Период = КонецДня(Объект.Дата);
		КонецЕсли;
	Иначе
		СтруктураПараметров.Ссылка = Объект.Ссылка;
		Если ЗначениеЗаполнено(ДатаСписанияСБухУчета)
			И НачалоДня(ДатаСписанияСБухУчета) <> НачалоДня(Объект.Дата) Тогда
			СтруктураПараметров.Период = ДатаСписанияСБухУчета;
		Иначе
			СтруктураПараметров.Период = Объект.Дата;
		КонецЕсли;
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(СтруктураПараметров, Объект);
	Возврат СтруктураПараметров;

КонецФункции // СтруктураПараметровПолученияОстатков()

Процедура ОчиститьНеиспользуемыеРеквизитыПринятияКУчету(ПорядокПогашенияСтоимости, СпособНачисленияАмортизации, НачислятьАмортизацию = Ложь, СчетУчетаЗатрат,
														КЭКЗатрат, КПСЗатрат, ПодразделениеЗатрат, СубконтоЗатрат1, СубконтоЗатрат2, СубконтоЗатрат3) Экспорт
	Если (ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается
		ИЛИ Не ЗначениеЗаполнено(ПорядокПогашенияСтоимости))
		И ЗначениеЗаполнено(СпособНачисленияАмортизации) Тогда
		СпособНачисленияАмортизации = Неопределено;
	КонецЕсли;
	
	Если СпособНачисленияАмортизации <> Перечисления.СпособНачисленияАмортизации.Линейный
		И НачислятьАмортизацию Тогда
		НачислятьАмортизацию = Ложь;
	КонецЕсли;
	
	Если (ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается
		ИЛИ НЕ ЗначениеЗаполнено(ПорядокПогашенияСтоимости))
		И ЗначениеЗаполнено(СчетУчетаЗатрат) Тогда
		СчетУчетаЗатрат = Неопределено;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СчетУчетаЗатрат) Тогда
		Если ЗначениеЗаполнено(КЭКЗатрат) Тогда
			КЭКЗатрат = Неопределено;
		КонецЕсли;
		Если ЗначениеЗаполнено(КПСЗатрат) Тогда
			КПСЗатрат = Неопределено;
		КонецЕсли;
		Если ЗначениеЗаполнено(ПодразделениеЗатрат) Тогда
			ПодразделениеЗатрат = Неопределено;
		КонецЕсли;
		КоличествоСубконто = 0;
	Иначе
		КоличествоСубконто = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетУчетаЗатрат).КоличествоСубконто;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СубконтоЗатрат1)
		И КоличествоСубконто < 1 Тогда
		СубконтоЗатрат1 = Неопределено;
	КонецЕсли;
	Если ЗначениеЗаполнено(СубконтоЗатрат2)
		И КоличествоСубконто < 2 Тогда
		СубконтоЗатрат2 = Неопределено;
	КонецЕсли;
	Если ЗначениеЗаполнено(СубконтоЗатрат3)
		И КоличествоСубконто < 3 Тогда
		СубконтоЗатрат3 = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

// исп. УСТАРЕЛА.
// Функция рассчитывает балансовую стоимость и сумму начисленной амортизации для списка ОС.
// Параметры:
//	СписокОС - СправочникСсылка.ОсновныеСредства или Массив 
//	Период	- Дата - период рассчета
//	Организация - СправочникСсылка.Организации
//	КФО - ПеречислениеСсылка.КВД
//	КПС - СправочникСсылка.КлассификационныеПризнакиСчетов
//	ЦМО - СправочникСсылка.ЦМО
//	ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения
//	Подразделение - СправочникСсылка.Подразделения
//	СписокКонтрагентов
//
// Возвращаемое значение:
//	ТаблицаЗначений, содержащая колонки:
//		СчетУчета
//		КПСУчета
//		ОсновноеСредство
//		ЦМО
//		БалансоваяСтоимость
//		Количество
//		СчетАмортизации
//		СуммаАмортизации
//
Функция ОпределитьСтоимостьСпискаОС(СписокОС, Период, Организация, КФО, КПС, ЦМО, ИФО=Неопределено, Подразделение = Неопределено, Ссылка = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	СписокСчетов 		= Новый Массив;
	СчетаАмортизации	= Новый Массив;
	
	Если ТипЗнч(СписокОС) <> Тип("Массив") Тогда
		ВрМассив = Новый Массив;
		ВрМассив.Добавить(СписокОС);
	Иначе
		ВрМассив = СписокОС;
	КонецЕсли;
	
	ЕстьУчетПоПодразделениям = УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетОСПоПодразделениям();
	
	Запрос.УстановитьПараметр("Период", Новый Граница(Период, ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Организация", 						Организация);
	Запрос.УстановитьПараметр("КФО", 								КФО);
	Запрос.УстановитьПараметр("КПС", 								КПС);
	Запрос.УстановитьПараметр("ЦМО", 								ЦМО);
	Запрос.УстановитьПараметр("ИФО", 								ИФО);
	Запрос.УстановитьПараметр("Подразделение", 						Подразделение);
	Запрос.УстановитьПараметр("СписокОС", 							ВрМассив);
	Запрос.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",	ЕстьУчетПоПодразделениям);
	Запрос.УстановитьПараметр("Счет103",							БухгалтерскийУчет.СписокСчетов("103.00"));
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		УсловиеМоментВремени = "Истина";
		Запрос.УстановитьПараметр("МоментВремени",					Период);
	Иначе
		Запрос.УстановитьПараметр("МоментВремени",					Ссылка.МоментВремени());
		УсловиеМоментВремени = "Регистратор.МоментВремени < &МоментВремени";
	КонецЕсли;
	Если ЕстьУчетПоПодразделениям Тогда
		УсловиеПодразделение = "Подразделение = &Подразделение";
	Иначе
		УсловиеПодразделение = "Истина";
	КонецЕсли;
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		УсловиеИФО = "ИФО = &ИФО";
	Иначе
		УсловиеИФО = "Истина";
	КонецЕсли;
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОсновныеСредства.Ссылка КАК ОС,
	|	УчетныеДанныеОбъектаОССрезПоследних.СчетУчета КАК СчетУчета
	|ПОМЕСТИТЬ ОсновныеСредстваИСчета
	|ИЗ
	|	Справочник.ОсновныеСредства КАК ОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних(&Период, ) КАК УчетныеДанныеОбъектаОССрезПоследних
	|		ПО (УчетныеДанныеОбъектаОССрезПоследних.ОсновноеСредство = ОсновныеСредства.Ссылка)
	|ГДЕ
	|	ОсновныеСредства.Ссылка В(&СписокОС)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК СчетОС
	|ПОМЕСТИТЬ ТаблицаСчетовНПА
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Ссылка В(&Счет103)
	|	И ЕПСБУ.ЭлементГруппа = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СоответствиеСчетовОС.СчетОС КАК СчетОС,
	|	СоответствиеСчетовОС.СчетАмортизации КАК СчетАмортизации,
	|	СоответствиеСчетовОС.ЗабалансовыйСчет КАК ЗабалансовыйСчет
	|ПОМЕСТИТЬ СчетаОС
	|ИЗ
	|	ОсновныеСредстваИСчета КАК ОсновныеСредстваИСчета
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеСчетовОС КАК СоответствиеСчетовОС
	|		ПО ОсновныеСредстваИСчета.СчетУчета = СоответствиеСчетовОС.СчетОС,
	|	Справочник.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка В(&СписокОС)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	СчетаНПА.СчетОС,
	|	ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка),
	|	ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
	|ИЗ
	|	ТаблицаСчетовНПА КАК СчетаНПА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвНомер,
	|	СтоимостьОбъектовОСОстатки.ЦМО КАК ЦМО,
	|	ВЫБОР
	|		КОГДА СтоимостьОбъектовОСОстатки.ИнвентарныйНомер = ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
	|			ТОГДА ИСТИНА
