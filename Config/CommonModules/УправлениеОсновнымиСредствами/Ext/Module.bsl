КонецФункции

Процедура ДобавитьСтрокуТаблицыСчетаУчетаОС(ТипНФА, ВидИмущества, КодСчета, ТаблицаСчетаГруппыОС, КодыСчетовОС)
	
	СчетСсылка = КодыСчетовОС.Получить(КодСчета);

	Если СчетСсылка <> Неопределено Тогда
		НоваяСтрока = ТаблицаСчетаГруппыОС.Добавить();
		НоваяСтрока.ТипНФА = ТипНФА;
		НоваяСтрока.ВидИмущества = ВидИмущества;
		НоваяСтрока.Счет = СчетСсылка;
	КонецЕсли;
	
Конецпроцедуры

Функция СчетаГруппыОС(Дата, Организация)
	
	СчетаГруппы101 = Новый Соответствие;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Счет
	|ПОМЕСТИТЬ СчетаЕПСБУ
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Код = ""101.00""
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Счет,
	|	ЕПСБУ.Код КАК Код
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Ссылка В ИЕРАРХИИ
	|			(ВЫБРАТЬ
	|				СчетаЕПСБУ.Счет
	|			ИЗ
	|				СчетаЕПСБУ)
	|	И ЕПСБУ.ДатаНачалаДействия <= &НаДату
	|	И (ЕПСБУ.ДатаОкончанияДействия = &ПустаяДата
	|			ИЛИ ЕПСБУ.ДатаОкончанияДействия >= &НаДату)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЕПСБУ.Код");
	
	Запрос.УстановитьПараметр("НаДату",     НачалоДня(БухгалтерскийУчет.ДатаАктуальностиСчетов(Дата, Организация)));
	Запрос.УстановитьПараметр("ПустаяДата", Дата("00010101000000"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СчетаГруппы101.Вставить(Выборка.Код, Выборка.Счет);
	КонецЦикла;
	
	Возврат СчетаГруппы101;

КонецФункции 

// Возврашает счета учета прав пользования ОС, НПА (111.4Х, 302.2Х, 401.60) по типу НФА.
//
// Параметры:
//	ТипНФА - ПеречислениеСсылка.ТипыНФА - тип объекта, значение реквизита ТипНФА справочника "Основные средства, НМА, НПА".
//
// Возвращаемое значение:
//	Структура, содержащая счета учета ПланСчетовСсылка.ЕПСБУ в соответствующих полях СчетУчета, СчетРасчетов.
//
Функция СчетаУчетаПравПользованияОСПоТипуНФА(ТипНФА, Период = Неопределено) Экспорт
	
	СчетаУчета = Новый Структура;
	
	Если ТипНФА = ПредопределенноеЗначение("Перечисление.ТипыНФА.ЖилыеПомещения") Тогда
		СчетаУчета.Вставить("СчетУчета", БухгалтерскийУчет.СчетПоКоду("111.41", Период));
	ИначеЕсли ТипНФА = ПредопределенноеЗначение("Перечисление.ТипыНФА.НежилыеПомещения")
		ИЛИ ТипНФА = ПредопределенноеЗначение("Перечисление.ТипыНФА.Сооружения") Тогда
		СчетаУчета.Вставить("СчетУчета", БухгалтерскийУчет.СчетПоКоду("111.42", Период));
	ИначеЕсли ТипНФА = ПредопределенноеЗначение("Перечисление.ТипыНФА.Оборудование") Тогда
		СчетаУчета.Вставить("СчетУчета", БухгалтерскийУчет.СчетПоКоду("111.44", Период));
	ИначеЕсли ТипНФА = ПредопределенноеЗначение("Перечисление.ТипыНФА.Транспорт") Тогда
		СчетаУчета.Вставить("СчетУчета", БухгалтерскийУчет.СчетПоКоду("111.45", Период));
	ИначеЕсли ТипНФА = ПредопределенноеЗначение("Перечисление.ТипыНФА.Инвентарь") Тогда
		СчетаУчета.Вставить("СчетУчета", БухгалтерскийУчет.СчетПоКоду("111.46", Период));
	ИначеЕсли ТипНФА = ПредопределенноеЗначение("Перечисление.ТипыНФА.Биоресурсы") Тогда
		СчетаУчета.Вставить("СчетУчета", БухгалтерскийУчет.СчетПоКоду("111.47", Период));
	ИначеЕсли ТипНФА = ПредопределенноеЗначение("Перечисление.ТипыНФА.НепроизведенныеАктивы") Тогда
		СчетаУчета.Вставить("СчетУчета", БухгалтерскийУчет.СчетПоКоду("111.49", Период));
	Иначе
		СчетаУчета.Вставить("СчетУчета", БухгалтерскийУчет.СчетПоКоду("111.48", Период));
	КонецЕсли;
	
	Если ТипНФА = ПредопределенноеЗначение("Перечисление.ТипыНФА.НепроизведенныеАктивы") Тогда
		СчетаУчета.Вставить("СчетРасчетов", БухгалтерскийУчет.СчетПоКоду("302.29", Период));
	Иначе
		СчетаУчета.Вставить("СчетРасчетов", БухгалтерскийУчет.СчетПоКоду("302.24", Период));
	КонецЕсли;
	
	СчетаУчета.Вставить("СчетРезервов", БухгалтерскийУчет.СчетПоКоду("401.60", Период));
	
	Возврат СчетаУчета;
	
КонецФункции

#КонецОбласти

#Область КонтрольСуммОбъектовИКапвложенийПриПринятииКУчету

// Возвращает текстовое сообщение о неравенстве количества объектов и вложений при равенстве их сумм.
//
// Параметры:
//   КоличествоОбъектов - Число - количество объектов
//   КоличествоВложений - Число - количество вложений
//
// Возвращаемое значение:
//   Строка - текст сообщения о неравенстве количества объектов и вложений при равенстве сумм
Функция ТекстНеравнстваКоличествОбъектовИВложенийПриРавенствеСумм(КоличествоОбъектов, КоличествоВложений) Экспорт
	Текст = НСтр("ru='Сумма вложений списывается полностью, а количество вложений - нет.
		|В этом случае, количество принимаемых к учету объектов должно быть равно количеству вложений.
		|Количество в табличной части: %1, капитальных вложений: %2'");
	Текст = СтрШаблон(Текст, КоличествоОбъектов, КоличествоВложений);
	
	Возврат Текст;
КонецФункции	

// Возвращает текст сообщения о превышении количества объектов в табличной части над количеством объектов капитальных вложений.
//
// Параметры:
//   КоличествоОбъектов - Число - количество объектов в табличной части
//   КоличествоВложений - Число - количество объектов капитальных вложений
//
// Возвращаемое значение:
//   Строка - текст сообщения с подставленными значениями
Функция ТекстПревышенияКоличестваОбъектовНадКоличествомВложения(КоличествоОбъектов, КоличествоВложений) Экспорт
	Текст = НСтр("ru='Количество объектов в табличной части превышает количество объектов капитальных вложений.
		|В табличной части: %1, капитальных вложений: %2'");
	Текст = СтрШаблон(Текст, КоличествоОбъектов, КоличествоВложений);
	
	Возврат Текст;
КонецФункции	

// Возвращает текст сообщения о превышении итоговой стоимости объектов над суммой вложений.
//
// Параметры:
//   СуммаТЧ - Число - стоимость объектов, принимаемых к учету
//   СуммаВложений - Число - сумма вложений
//
// Возвращаемое значение:
//   Строка - текст сообщения
Функция ТекстПревышенияСуммыОбъектвоНадСуммойВложения(СуммаТЧ, СуммаВложений) Экспорт
	Текст = НСтр("ru = 'Итоговая стоимость объектов в табличной части больше суммы вложений.
				|В табличной части: %1, сумма вложений: %2'");
	Текст = СтрШаблон(Текст, СуммаТЧ, СуммаВложений);
				
	Возврат Текст;
КонецФункции	

// Проверяет соответствие суммы объектов основных средств, принимаемых к учету со счета вложений (106.ХХ) 
// и суммы вложений. Если сумма объектов больше, чем сумма вложений, то Отказ устанавливается в ИСТИНА.
// Если меньше, контроль не блокирующий. 
//
// Параметры:
//  СуммаОбъектов - Число - сумма всех объектов в табличной части документа
//  СуммаВложений - Число - сумма капитальных вложений документа
//  СчетВложений - ПланСчетовСсылка.ЕПСБУ - счет вложений из документа
//  Отказ - Булево - Флаг отказа от записи документа
//  ОбъектСсылка - ДокументСсылка - ссылка из реквизита формы "Объект", из которой вызывается процедура
Процедура ПроверитьСуммыОбъектовИКапвложений(СуммаОбъектов, СуммаВложений, СчетВложений, ОбъектСсылка, Отказ) Экспорт
	Текст = "";
	Если СуммаВложений < СуммаОбъектов Тогда
		Отказ = Истина;
		Текст = ТекстПревышенияСуммыОбъектвоНадСуммойВложения(СуммаОбъектов, СуммаВложений);
	ИначеЕсли СуммаВложений > СуммаОбъектов Тогда
		Остаток = СуммаВложений - СуммаОбъектов;
		Текст = НСтр("ru = 'Итоговая стоимость объектов в табличной части меньше суммы вложений.
			|На счете %1 останется остаток %2 руб.'");
		Текст = СтрШаблон(Текст, СчетВложений, Остаток);	
	КонецЕсли;	
	Если ЗначениеЗаполнено(Текст) Тогда
		ОбщегоНазначения.СообщитьПользователю(Текст, ОбъектСсылка);
	КонецЕсли;		
КонецПроцедуры

#КонецОбласти
	
#Область СервисРегистрацииОбремененийИнвентарныхОбъектов
	
// Проверяет наличие незарегистрированных обременений для переданных инвентарных объектов.
//
// Параметры:
//   Контрагент - СправочникСсылка.Контрагенты - Контрагент, которому передаются объекты
//   Договор - СправочникСсылка.Договоры - Договор, по которому передаются объекты
//   Объекты - ТаблицаЗначений - Таблица с объектами основных средств для проверки с колонками:
//   	ИнвентарныйНомер - СправочникСсылка.ИнвентарныеНомераОС
//
// Возвращаемое значение:
//   Булево - Истина, если есть незарегистрированные обременения, иначе Ложь
Функция ЕстьНезарегистрированныеОбременения(Контрагент, Договор, Объекты) Экспорт
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ТаблицаОбременения.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	&ДокументОбремененияДата КАК ДокументОбремененияДата,
	|	&ДокументОбремененияНомерДляСвязи КАК ДокументОбремененияНомерДляСвязи,
	|	&Контрагент КАК Контрагент
	|ПОМЕСТИТЬ ОбремененияИзДокумента1
	|ИЗ
	|	&ТаблицаОбременения КАК ТаблицаОбременения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОбремененияИзДокумента1.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ОбремененияИзДокумента1.ДокументОбремененияДата КАК ДокументОбремененияДата,
	|	ОбремененияИзДокумента1.ДокументОбремененияНомерДляСвязи КАК ДокументОбремененияНомерДляСвязи,
	|	ОбремененияИзДокумента1.Контрагент КАК Контрагент
	|ПОМЕСТИТЬ ОбремененияИзДокумента
	|ИЗ
	|	ОбремененияИзДокумента1 КАК ОбремененияИзДокумента1
	|ГДЕ
	|	ИнвентарныйНомер <> ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)	
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ИнвентарныеНомераОСОбременения.Ссылка КАК ИнвентарныйНомер,
	|	ИнвентарныеНомераОСОбременения.Контрагент КАК Контрагент,
	|	ВРЕГ(СОКРЛП(ИнвентарныеНомераОСОбременения.ДокументОбремененияНомер)) КАК ДокументОбремененияНомерДляСвязи,
	|	НАЧАЛОПЕРИОДА(ИнвентарныеНомераОСОбременения.ДокументОбремененияДата, День) КАК ДокументОбремененияДата
	|ПОМЕСТИТЬ ОбремененияИзСправочника1
	|ИЗ
	|	Справочник.ИнвентарныеНомераОС.Обременения КАК ИнвентарныеНомераОСОбременения
	|ГДЕ
	|	ИнвентарныеНомераОСОбременения.Ссылка В
	|		(ВЫБРАТЬ
	|			Таб.ИнвентарныйНомер
	|		ИЗ
	|			ОбремененияИзДокумента КАК Таб)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОбремененияИзСправочника.ИнвентарныйНомер КАК ИнвентарныйНомер
	|ПОМЕСТИТЬ ОбремененияИзСправочника
	|ИЗ
	|	ОбремененияИзСправочника1 КАК ОбремененияИзСправочника
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОбремененияИзДокумента КАК ОбремененияИзДокумента
	|		ПО ОбремененияИзСправочника.Контрагент = ОбремененияИзДокумента.Контрагент
	|		И ОбремененияИзСправочника.ДокументОбремененияДата = ОбремененияИзДокумента.ДокументОбремененияДата
	|		И
	|			ОбремененияИзСправочника.ДокументОбремененияНомерДляСвязи = ОбремененияИзДокумента.ДокументОбремененияНомерДляСвязи
	|		И ОбремененияИзСправочника.ДокументОбремененияДата = ОбремененияИзДокумента.ДокументОбремененияДата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОбремененияИзДокумента.ИнвентарныйНомер КАК ИнвентарныйНомер
	|ИЗ
	|	ОбремененияИзДокумента КАК ОбремененияИзДокумента
	|ГДЕ
	|	НЕ ОбремененияИзДокумента.ИнвентарныйНомер В
	|		(ВЫБРАТЬ
	|			Таб.ИнвентарныйНомер
	|		ИЗ
	|			ОбремененияИзСправочника КАК Таб)";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Если ЗначениеЗаполнено(Договор) Тогда
		РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, 
			"ВидОбязательства, ДатаДоговора, НомерДоговора");
		Запрос.УстановитьПараметр("ДокументОбремененияВид", РеквизитыДоговора.ВидОбязательства);
		Запрос.УстановитьПараметр("ДокументОбремененияНомер", РеквизитыДоговора.НомерДоговора);
		Запрос.УстановитьПараметр("ДокументОбремененияНомерДляСвязи", СокрЛП(ВРЕГ(РеквизитыДоговора.НомерДоговора)));
		Запрос.УстановитьПараметр("ДокументОбремененияДата", НачалоДня(РеквизитыДоговора.ДатаДоговора));
	Иначе
		Запрос.УстановитьПараметр("ДокументОбремененияВид", "");
		Запрос.УстановитьПараметр("ДокументОбремененияНомер", "");
		Запрос.УстановитьПараметр("ДокументОбремененияНомерДляСвязи", "");
		Запрос.УстановитьПараметр("ДокументОбремененияДата", '00010101');
	КонецЕсли;		
	
	Запрос.УстановитьПараметр("ТаблицаОбременения", Объекты);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат(Выборка.Количество() > 0);
КонецФункции	

#КонецОбласти	
