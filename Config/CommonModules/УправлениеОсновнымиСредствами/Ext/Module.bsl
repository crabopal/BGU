КонецПроцедуры

Процедура ТекстУсловияСтроки3(Приемник, НомерСтрокиПолный, Условие)
	
	Шаблон = "СУММА(ВЫБОР КОГДА %1 ТОГДА Показатели.Колонка%2 ИНАЧЕ 0 КОНЕЦ) КАК %3";
	
	Для НомерКолонки = 3 По 12 Цикл
		ИмяЯчейки = "П00" + "1" + НомерСтрокиПолный + Формат(НомерКолонки, "ЧЦ=2; ЧН=00; ЧВН=");
		Формула = СтрШаблон(Шаблон, Условие, Формат(НомерКолонки), ИмяЯчейки);
		Приемник.Добавить(Формула);
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьНаименованиеПоказателя3(ИмяПоля)
	
	НомерСтроки		= Сред(ИмяПоля, 5, 2);
	НомерПодстроки	= Строка(Число(Сред(ИмяПоля, 7, 2)));
	НомерКолонки	= Строка(Число(Сред(ИмяПоля, 9, 2)));	
	
	НаименованиеПоказателя = "Строка № " + НомерСтроки
		+ ?(НомерПодстроки = "0", "", "." + НомерПодстроки)
		+ ", колонка " + НомерКолонки;
	
	Возврат НаименованиеПоказателя;
	
КонецФункции

Функция ЧистыйКодПоОКВЭД(КодОКВЭД)
	
	Если Не ЗначениеЗаполнено(КодОКВЭД) Тогда
		Возврат "";
	КонецЕсли;
	
	Класс = Лев(КодОКВЭД, 2);
	
	Попытка
		К = Число(Класс);
	Исключение
		Возврат "";
	КонецПопытки;
	
	Если		К >= 01 И К <= 03 Тогда Р = "A"
	ИначеЕсли	К >= 05 И К <= 09 Тогда Р = "B"
	ИначеЕсли	К >= 10 И К <= 33 Тогда Р = "C"
	ИначеЕсли	К >= 35 И К <= 35 Тогда Р = "D"
	ИначеЕсли	К >= 36 И К <= 39 Тогда Р = "E"
	ИначеЕсли	К >= 41 И К <= 43 Тогда Р = "F"
	ИначеЕсли	К >= 45 И К <= 47 Тогда Р = "G"
	ИначеЕсли	К >= 49 И К <= 53 Тогда Р = "H"
	ИначеЕсли	К >= 55 И К <= 56 Тогда Р = "I"
	ИначеЕсли	К >= 58 И К <= 63 Тогда Р = "J"
	ИначеЕсли	К >= 64 И К <= 66 Тогда Р = "K"
	ИначеЕсли	К >= 68 И К <= 68 Тогда Р = "L"
	ИначеЕсли	К >= 69 И К <= 75 Тогда Р = "M"
	ИначеЕсли	К >= 77 И К <= 82 Тогда Р = "N"
	ИначеЕсли	К >= 84 И К <= 84 Тогда Р = "O"
	ИначеЕсли	К >= 85 И К <= 85 Тогда Р = "P"
	ИначеЕсли	К >= 86 И К <= 88 Тогда Р = "Q"
	ИначеЕсли	К >= 90 И К <= 93 Тогда Р = "R"
	ИначеЕсли	К >= 94 И К <= 96 Тогда Р = "S"
	ИначеЕсли	К >= 97 И К <= 98 Тогда Р = "T"
	ИначеЕсли	К >= 99 И К <= 99 Тогда Р = "U"
		
	Иначе Р = "" КонецЕсли;
	
	Возврат Р;
	
КонецФункции

Функция СреднегодоваяСтоимостьФорма11К(ПараметрыОтчета, ОСФонда)
	
	Схема = Отчеты.РасчетСреднегодовойСтоимостиИмущества.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	
	Выражение = "ВЫБОР КОГДА ЕСТЬNULL(Подразделение.ОбособленноеПодразделение, ЛОЖЬ) ТОГДА Подразделение ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка) КОНЕЦ";
	ОбщийМодульСКД.ДобавитьВычисляемоеПолеКомпоновкиДанных(Схема, "ОбособленноеПодразделение", Выражение);
	
	ВычисляемоеПоле = Схема.ВычисляемыеПоля.Найти("СреднегодоваяСтоимость");
	ВычисляемоеПоле.Выражение =
	"ВЫБОР
	|	КОГДА Период В (&КрайниеМесяцы)
	|		ТОГДА СуммаБаланс / 2
	|	ИНАЧЕ СуммаБаланс
	|КОНЕЦ";
	
	Ресурс = Схема.ПоляИтога.Найти("СреднегодоваяСтоимость");
	Ресурс.Выражение = "СУММА(СреднегодоваяСтоимость) / 12";
	
	ПараметрМесяцы = Схема.Параметры.Добавить();
	ПараметрМесяцы.Имя = "КрайниеМесяцы";
	ПараметрМесяцы.ДоступенСписокЗначений = Истина;
	ПараметрМесяцы.ТипЗначения = Новый ОписаниеТипов("Дата");
	
	СтрокаСхемы = ПоместитьВоВременноеХранилище(Схема);
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СтрокаСхемы));
	
	ПериодОтчета = ПараметрыОтчета.мДатаКонцаПериодаОтчета+1;
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ПериодОтчета", ПериодОтчета);
	
	КрайниеМесяцы = Новый Массив;
	КрайниеМесяцы.Добавить(ПараметрыОтчета.мДатаНачалаПериодаОтчета);
	КрайниеМесяцы.Добавить(ПараметрыОтчета.мДатаКонцаПериодаОтчета);
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "КрайниеМесяцы", КрайниеМесяцы);
	
	СтруктураПодр = КомпоновщикНастроек.Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ОбщийМодульСКД.ДобавитьПолеГруппировкиКомпоновкиДанных(СтруктураПодр, "ОбособленноеПодразделение");
	СтруктураПодр.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	СтруктураПодр.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
	
	СтруктураОС = СтруктураПодр.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ОбщийМодульСКД.ДобавитьПолеГруппировкиКомпоновкиДанных(СтруктураОС, "ОсновноеСредство");
	СтруктураОС.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	СтруктураОС.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
	
	Выбор = КомпоновщикНастроек.Настройки.Выбор;
	ОбщийМодульСКД.ДобавитьВыбранноеПолеКомпоновкиДанных(Выбор, "ОбособленноеПодразделение");
	ОбщийМодульСКД.ДобавитьВыбранноеПолеКомпоновкиДанных(Выбор, "ОсновноеСредство");
	ОбщийМодульСКД.ДобавитьВыбранноеПолеКомпоновкиДанных(Выбор, "ОсновноеСредство.Наименование");
	ОбщийМодульСКД.ДобавитьВыбранноеПолеКомпоновкиДанных(Выбор, "СреднегодоваяСтоимость");
	
	Отбор = КомпоновщикНастроек.Настройки.Отбор;
	ОбщийМодульСКД.ДобавитьЭлементОтбораКомпоновкиДанных(Отбор, "Организация",, ПараметрыОтчета.Организация);
	ОбщийМодульСКД.ДобавитьЭлементОтбораКомпоновкиДанных(Отбор, "ОсновноеСредство", ВидСравненияКомпоновкиДанных.ВСписке, ОСФонда);
	Если ПараметрыОтчета.Свойство("Подразделение") Тогда
		
		ВидСравненияПоПодразделению = ?(ПараметрыОтчета.ИсключитьДанныеОбособленныхПодразделений,
			ВидСравненияКомпоновкиДанных.НеВСписке,
			ВидСравненияКомпоновкиДанных.ВСписке);
		
		ОбщийМодульСКД.ДобавитьЭлементОтбораКомпоновкиДанных(
			Отбор,
			"Подразделение",
			ВидСравненияПоПодразделению,
			ПараметрыОтчета["Подразделение"]);
			
	КонецЕсли;
	
	ПолеПорядка = КомпоновщикНастроек.Настройки.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
	ПолеПорядка.Поле = Новый ПолеКомпоновкиДанных("ОбособленноеПодразделение");
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметрВывода(КомпоновщикНастроек,
		"ВертикальноеРасположениеОбщихИтогов", РасположениеИтоговКомпоновкиДанных.Нет);
	
	НастройкиДляКомпоновкиМакета = КомпоновщикНастроек.ПолучитьНастройки();

	// Рассчет среднегодовой стоимости выполняется в отчете "РасчетСреднегодовойСтоимостиИмущества", который
	// используется для декларации по налогу на имущество. И там считается стоимость только ОС. Стоимость НМА
	// и имущества казны не рассчитывается. Поэтому передаем массив видов НФА, который включает НМА и флаг расчета имущества казны.
	ПараметрыРасчетаСтоимости = Новый Структура;
	
	ВидыНФА = Новый Массив;
	ВидыНФА.Добавить(ПредопределенноеЗначение("Перечисление.ВидыНФА.ОС"));
	ВидыНФА.Добавить(ПредопределенноеЗначение("Перечисление.ВидыНФА.НМА"));
	ВидыНФА.Добавить(ПредопределенноеЗначение("Перечисление.ВидыНФА.Казна"));
	ПараметрыРасчетаСтоимости.Вставить("ВидыНФА", ВидыНФА);
	
	Если ПараметрыОтчета.ИмуществоКазны Тогда
		ПараметрыРасчетаСтоимости.Вставить("ИмуществоКазны", ПараметрыОтчета.ИмуществоКазны);
	КонецЕсли;	        
	
	ОсновнойНаборДанных = Отчеты.РасчетСреднегодовойСтоимостиИмущества.ОсновнойНаборДанных(
		ПараметрыОтчета.мДатаНачалаПериодаОтчета, ПериодОтчета, НастройкиДляКомпоновкиМакета, ПараметрыРасчетаСтоимости);
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	Результат = Новый ДеревоЗначений;
	
	Попытка
		МакетКомпоновки = КомпоновщикМакета.Выполнить(Схема, НастройкиДляКомпоновкиМакета,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
		ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
		ВнешниеНаборыДанных = Новый Структура("ОсновнойНаборДанных", ОсновнойНаборДанных);
		ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных,, Истина);
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
		ПроцессорВывода.УстановитьОбъект(Результат);
		
		ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
	Исключение
		
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Расчет среднедоговой стоимости для ""Форма 11 (Краткая)""'"),
			УровеньЖурналаРегистрации.Ошибка,,,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция ДанныеСреднегоВозрастаФонда(ПараметрыОтчета, ОСФонда, Год = 2020)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация"	, ПараметрыОтчета.Организация);
	Запрос.УстановитьПараметр("Период"		, ПараметрыОтчета.мДатаКонцаПериодаОтчета);
	Запрос.УстановитьПараметр("ОС"			, ОСФонда);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьОбъектовОСОстатки.СтоимостьОстаток КАК Стоимость,
	|	ЕСТЬNULL(СтоимостьОбъектовОСОстатки.ИнвентарныйНомер.ДатаВыпуска, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаВыпуска,
	|	ЕСТЬNULL(СтоимостьОбъектовОСОстатки.ОсновноеСредство.КодОКОФ.Код, """") КАК КодОКОФ
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство В (&ОС)
	|				И Подразделение В (&Подразделение)) КАК СтоимостьОбъектовОСОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Остатки.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ_Остатки.ОсновноеСредство.Наименование КАК НаименованиеОС,
	|	ВТ_Остатки.Стоимость КАК Стоимость,
	|	РАЗНОСТЬДАТ(ВТ_Остатки.ДатаВыпуска, &Период, ДЕНЬ) КАК Возраст,
	|	ВЫРАЗИТЬ(ВТ_Остатки.КодОКОФ КАК СТРОКА(3)) КАК КодОКОФ3
	|ПОМЕСТИТЬ ВТ_Возраст
	|ИЗ
	|	ВТ_Остатки КАК ВТ_Остатки
	|ГДЕ
	|	ВТ_Остатки.ДатаВыпуска <> ДАТАВРЕМЯ(1, 1, 1)
	|	И ВТ_Остатки.КодОКОФ <> """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	&Стр21 КАК КодПоля,
	|	ВТ_Возраст.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ_Возраст.НаименованиеОС КАК НаименованиеОС,
	|	ВТ_Возраст.Стоимость КАК Стоимость,
	|	ВТ_Возраст.Возраст КАК Возраст
	|ИЗ
	|	ВТ_Возраст КАК ВТ_Возраст
	|ГДЕ
	|	ВТ_Возраст.КодОКОФ3 В (""100"", ""210"")
	|ИТОГИ
	|	СУММА(Стоимость),
	|	СРЕДНЕЕ(Возраст)
	|ПО
	|	КодПоля
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	&Стр22 КАК КодПоля,
	|	ВТ_Возраст.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ_Возраст.НаименованиеОС КАК НаименованиеОС,
	|	ВТ_Возраст.Стоимость КАК Стоимость,
	|	ВТ_Возраст.Возраст КАК Возраст
	|ИЗ
	|	ВТ_Возраст КАК ВТ_Возраст
	|ГДЕ
	|	ВТ_Возраст.КодОКОФ3 = ""220""
	|ИТОГИ
	|	СУММА(Стоимость),
	|	СРЕДНЕЕ(Возраст)
	|ПО
	|	КодПоля
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	&Стр23 КАК КодПоля,
	|	ВТ_Возраст.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ_Возраст.НаименованиеОС КАК НаименованиеОС,
	|	ВТ_Возраст.Стоимость КАК Стоимость,
	|	ВТ_Возраст.Возраст КАК Возраст
	|ИЗ
	|	ВТ_Возраст КАК ВТ_Возраст
	|ГДЕ
	|	ВТ_Возраст.КодОКОФ3 В (""320"", ""330"")
	|ИТОГИ
	|	СУММА(Стоимость),
	|	СРЕДНЕЕ(Возраст)
	|ПО
	|	КодПоля
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	&Стр24 КАК КодПоля,
	|	ВТ_Возраст.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ_Возраст.НаименованиеОС КАК НаименованиеОС,
	|	ВТ_Возраст.Стоимость КАК Стоимость,
	|	ВТ_Возраст.Возраст КАК Возраст
	|ИЗ
	|	ВТ_Возраст КАК ВТ_Возраст
	|ГДЕ
	|	ВТ_Возраст.КодОКОФ3 = ""310""
	|ИТОГИ
	|	СУММА(Стоимость),
	|	СРЕДНЕЕ(Возраст)
	|ПО
	|	КодПоля";
	
	Если ПараметрыОтчета.Свойство("Подразделение") Тогда
		
		Запрос.УстановитьПараметр("Подразделение", ПараметрыОтчета["Подразделение"]);
		
		Если ПараметрыОтчета.ИсключитьДанныеОбособленныхПодразделений Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Подразделение В (&Подразделение)", "И НЕ Подразделение В (&Подразделение)");
		КонецЕсли;
		
	Иначе
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Подразделение В (&Подразделение)", "");
		
	КонецЕсли;
	
	Если Год >= 2021 Тогда
		
		Запрос.УстановитьПараметр("Стр21", "П000030102103");
		Запрос.УстановитьПараметр("Стр22", "П000030102203");
		Запрос.УстановитьПараметр("Стр23", "П000030102303");
		Запрос.УстановитьПараметр("Стр24", "П000030102403");
		
	Иначе
		
		Запрос.УстановитьПараметр("Стр21", "П003210003");
		Запрос.УстановитьПараметр("Стр22", "П003220003");
		Запрос.УстановитьПараметр("Стр23", "П003230003");
		Запрос.УстановитьПараметр("Стр24", "П003240003");
		
	КонецЕсли;
	
	Данные = Запрос.ВыполнитьПакет();
	
	Результат = Новый Массив;
	Для Сч = 1 По 4 Цикл
		Результат.Добавить(Данные[Сч+1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ДанныеСреднегоВозрастаФонда_2024(ПараметрыОтчета, МенеджерВременныхТаблиц)
	
	ТекстЗапроса =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_Показатели.ПоказательСтроки КАК ПоказательСтроки,
		|	ВТ_Показатели.ОсновноеСредство КАК ОсновноеСредство,
		|	ВТ_Показатели.НаименованиеОС КАК НаименованиеОС
		|ПОМЕСТИТЬ ВТ_ОСТребуетсяРасчетСредннегоВозраста
		|ИЗ
		|	ВТ_Показатели КАК ВТ_Показатели
		|ГДЕ
		|	ВТ_Показатели.Колонка09 > 0
		|	И ВТ_Показатели.ПоказательСтроки В (&ПоказательСтроки02, &ПоказательСтроки04, &ПоказательСтроки06,
		|		&ПоказательСтроки07, &ПоказательСтроки08)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
		|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	СтоимостьОбъектовОСОстатки.СтоимостьОстаток КАК Стоимость
		|ПОМЕСТИТЬ ВТ_Остатки
		|ИЗ
		|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(&ПериодОстатки, Организация = &Организация
		|	И ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)
		|	И ОсновноеСредство В
		|		(ВЫБРАТЬ
		|			ВТ_ОСТребуетсяРасчетСредннегоВозраста.ОсновноеСредство
		|		ИЗ
		|			ВТ_ОСТребуетсяРасчетСредннегоВозраста КАК ВТ_ОСТребуетсяРасчетСредннегоВозраста)
		|	И &УсловиеПоПодразделению) КАК СтоимостьОбъектовОСОстатки
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫБОР ВТ_ОСТребуетсяРасчетСредннегоВозраста.ПоказательСтроки
		|		КОГДА &ПоказательСтроки02
		|			ТОГДА &ПоказательСтроки21
		|		КОГДА &ПоказательСтроки04
		|			ТОГДА &ПоказательСтроки22
		|		КОГДА &ПоказательСтроки06
		|			ТОГДА &ПоказательСтроки23
		|		КОГДА &ПоказательСтроки07
		|			ТОГДА &ПоказательСтроки23
		|		КОГДА &ПоказательСтроки08
		|			ТОГДА &ПоказательСтроки24
		|		ИНАЧЕ ""ПоказательНеОпределен""
		|	КОНЕЦ КАК ПоказательСтроки,
		|	ВТ_Остатки.ОсновноеСредство КАК ОсновноеСредство,
		|	ВТ_ОСТребуетсяРасчетСредннегоВозраста.НаименованиеОС КАК НаименованиеОС,
		|	ВТ_Остатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	ЕСТЬNULL(ИнвентарныеНомераОС.Код, """") КАК ИнвентарныйНомерКод,
		|	ВТ_Остатки.Стоимость КАК Стоимость,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ИнвентарныеНомераОС.ДатаВыпуска, ДАТАВРЕМЯ(1, 1, 1)) = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА 0
		|		ИНАЧЕ РАЗНОСТЬДАТ(ИнвентарныеНомераОС.ДатаВыпуска, &КонецПериода, ДЕНЬ)
		|	КОНЕЦ КАК Возраст
		|ИЗ
		|	ВТ_Остатки КАК ВТ_Остатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
		|		ПО ВТ_Остатки.ИнвентарныйНомер = ИнвентарныеНомераОС.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОСТребуетсяРасчетСредннегоВозраста КАК ВТ_ОСТребуетсяРасчетСредннегоВозраста
		|		ПО ВТ_Остатки.ОсновноеСредство = ВТ_ОСТребуетсяРасчетСредннегоВозраста.ОсновноеСредство
		|ГДЕ
		|	ЕСТЬNULL(ИнвентарныеНомераОС.ДатаВыпуска, ДАТАВРЕМЯ(1, 1, 1)) <> ДАТАВРЕМЯ(1, 1, 1)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПоказательСтроки,
		|	НаименованиеОС,
		|	ИнвентарныйНомерКод
		|ИТОГИ
		|	СУММА(Стоимость)
		|ПО
		|	ПоказательСтроки";
	
	Если ПараметрыОтчета.Свойство("Подразделение") Тогда

		Если ПараметрыОтчета.ИсключитьДанныеОбособленныхПодразделений Тогда
			УсловиеПоПодразделению = "НЕ Подразделение В (&Подразделение)";
		Иначе
			УсловиеПоПодразделению = "Подразделение В (&Подразделение)";
		КонецЕсли;
		
	Иначе
		УсловиеПоПодразделению = "ИСТИНА";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоПодразделению", УсловиеПоПодразделению);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Организация", ПараметрыОтчета.Организация);
	Запрос.УстановитьПараметр("КонецПериода", ПараметрыОтчета.мДатаКонцаПериодаОтчета);
	Запрос.УстановитьПараметр("ПериодОстатки", ПараметрыОтчета.мДатаКонцаПериодаОтчета + 1);
	Запрос.УстановитьПараметр("ПоказательСтроки02", "П0000101002");
	Запрос.УстановитьПараметр("ПоказательСтроки04", "П0000101004");
	Запрос.УстановитьПараметр("ПоказательСтроки06", "П0000101006");
	Запрос.УстановитьПараметр("ПоказательСтроки07", "П0000101007");
	Запрос.УстановитьПараметр("ПоказательСтроки08", "П0000101008");
	Запрос.УстановитьПараметр("ПоказательСтроки21", "П000030102103");
	Запрос.УстановитьПараметр("ПоказательСтроки22", "П000030102203");
	Запрос.УстановитьПараметр("ПоказательСтроки23", "П000030102303");
	Запрос.УстановитьПараметр("ПоказательСтроки24", "П000030102403");
	
	Если ПараметрыОтчета.Свойство("Подразделение") Тогда
		Запрос.УстановитьПараметр("Подразделение", ПараметрыОтчета["Подразделение"]);
	КонецЕсли;
	
	Возврат Запрос.Выполнить();
	
КонецФункции

Процедура ТекстУсловияСтроки4(Приемник, НомерСтрокиПолный, Условие)
	
	Шаблон = "СУММА(ВЫБОР КОГДА %1 ТОГДА Показатели.Колонка%2 ИНАЧЕ 0 КОНЕЦ) КАК %3";
	
	Для НомерКолонки = 3 По 12 Цикл
		Если (НомерСтрокиПолный = "20" Или НомерСтрокиПолный = "21") И НомерКолонки <> 4 И НомерКолонки <> 9 Тогда
			Продолжить;
		КонецЕсли;
		ИмяЯчейки = "П00001010" + НомерСтрокиПолный + Формат(НомерКолонки, "ЧЦ=2; ЧВН=");
		Формула = СтрШаблон(Шаблон, Условие, Формат(НомерКолонки), ИмяЯчейки);
		Приемник.Добавить(Формула);
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьНаименованиеПоказателя4(ИмяПоля)
	
	НомераСтрок = Новый Соответствие;
	НомераСтрок.Вставить("14", "131");
	НомераСтрок.Вставить("15", "132");
	НомераСтрок.Вставить("16", "133");
	НомераСтрок.Вставить("17", "134");
	НомераСтрок.Вставить("18", "135");
	НомераСтрок.Вставить("19", "14");
	НомераСтрок.Вставить("20", "141");
	НомераСтрок.Вставить("21", "142");
	
	НомерСтроки  = Сред(ИмяПоля, 10, 2);
	НомерКолонки = Строка(Число(Сред(ИмяПоля, 12, 2)));
	
	Если НомераСтрок[НомерСтроки] <> Неопределено Тогда
		НомерСтроки = НомераСтрок[НомерСтроки];
	КонецЕсли;
	
	НаименованиеПоказателя = "Строка № " + НомерСтроки + ", колонка " + НомерКолонки;
	
	Возврат НаименованиеПоказателя;
	
КонецФункции

Функция СписокОбособленныхПодразделений11К(ПараметрыОтчета)
	
	// Иерархия подразделений в обособленных подразделениях не предусмотрена
	// но на всякий случай получаем подразделения с учетом иерархии
	
	Если ПараметрыОтчета.ИсключитьДанныеОбособленныхПодразделений Тогда
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	Подразделения.Ссылка КАК ОбособленноеПодразделение
		|ПОМЕСТИТЬ ВТ
		|ИЗ
		|	Справочник.Подразделения КАК Подразделения
		|ГДЕ
		|	Подразделения.Владелец = &Организация
		|	И Подразделения.ОбособленноеПодразделение
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Подразделения.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Подразделения КАК Подразделения
		|ГДЕ
		|	Подразделения.Владелец = &Организация
		|	И Подразделения.Ссылка В ИЕРАРХИИ
		|			(ВЫБРАТЬ
		|				ВТ.ОбособленноеПодразделение КАК ОбособленноеПодразделение
		|			ИЗ
		|				ВТ КАК ВТ)";
		
	Иначе
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	Подразделения.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Подразделения КАК Подразделения
		|ГДЕ
		|	Подразделения.Владелец = &Организация
		|	И Подразделения.Ссылка В ИЕРАРХИИ(&Подразделение)";
		
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Организация", ПараметрыОтчета.Организация);
	Запрос.УстановитьПараметр("Подразделение", ПараметрыОтчета.ОбособленноеПодразделение);
	
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Возврат Результат;
	
КонецФункции

Процедура ОчиститьПоказателиТаблицы1Формы11К(ПоляОтчета)
	
	Для НомерСтроки = 2 По 19 Цикл
		Если НомерСтроки = 5 Или НомерСтроки = 9 Или НомерСтроки = 13 Тогда
			Продолжить;
		КонецЕсли;
		Для НомерКолонки = 3 По 12 Цикл
			ИмяПоказателя = "П00001010" + Формат(НомерСтроки, "ЧЦ=2; ЧВН=") + Формат(НомерКолонки, "ЧЦ=2; ЧВН=");
			Если ПоляОтчета.Свойство(ИмяПоказателя) Тогда
				ПоляОтчета[ИмяПоказателя] = 0;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ПоляОтчета["П000010102004"] = 0;
	ПоляОтчета["П000010102104"] = 0;
	ПоляОтчета["П000010102009"] = 0;
	ПоляОтчета["П000010102109"] = 0;
	
КонецПроцедуры

#КонецОбласти

#Область ЗаявлениеОЛьготеПоТранспортномуЗемельномуНалогу

Процедура ПолучитьСведенияОПоказателяхОтчетаУведомлениеЛьготаТранспортЗемля(ИДРедакцииОтчета, ПоказателиОтчета) Экспорт
	
	Если ИДРедакцииОтчета = "Форма2019_1" Или ИДРедакцииОтчета = "Форма2021_1" Тогда
		
		РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "ВидТС"				, Истина, Ложь);
		РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "МаркаТС"			, Истина, Ложь);
		РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "РегЗнакТС"			, Истина, Ложь);
		РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "КодНалЛьготТр"		, Истина, Ложь);
		РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "СтруктЕдЗакон"		, Истина, Ложь);
		
		РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "НомКадастрЗУ"		, Истина, Ложь);
		РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "КодНалЛьготЗем"	, Истина, Ложь);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьОтчетУведомлениеЛьготаТранспортЗемля(ИДРедакцииОтчета, ПараметрыОтчета, Контейнер) Экспорт
	
	Если ИДРедакцииОтчета = "Форма2019_1" Или ИДРедакцииОтчета = "Форма2021_1" Тогда
		ЗаполнитьЗаявлениеОЛьготеПоТранспортномуЗемельномуНалогу2019(ПараметрыОтчета, Контейнер);
	КонецЕсли;
	
КонецПроцедуры

// Заполняет показатели регламентированного отчета.
//
// Параметры:
//  ПараметрыОтчета - Структура - параметры для заполнения отчета.
//  Контейнер - Структура - структура, в которую помещаются заполненные показатели отчета.
//
Процедура ЗаполнитьЗаявлениеОЛьготеПоТранспортномуЗемельномуНалогу2019(ПараметрыОтчета, Контейнер) Экспорт
	
	Период = ?(ЗначениеЗаполнено(ПараметрыОтчета.ДатаПодписи), ПараметрыОтчета.ДатаПодписи, ОбщегоНазначения.ТекущаяДатаПользователя());
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация"		, ПараметрыОтчета.Организация);
	Запрос.УстановитьПараметр("НалоговыйОрган"	, ПараметрыОтчета.РегистрацияВИФНС);
	Запрос.УстановитьПараметр("Период"			, Период);
	
	#Область ЛьготыПоТранспортнымСредствам
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РегистрацияТС.ОсновноеСредство КАК ОсновноеСредство,
	|	РегистрацияТС.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	РегистрацияТС.КодВидаТранспортногоСредства КАК КодВидаТС,
	|	РегистрацияТС.КодНалоговойЛьготы КАК КодНалоговойЛьготы,
	|	РегистрацияТС.РегиональныйКодЛьготы КАК РегиональныйКодЛьготы
	|ПОМЕСТИТЬ Налог
	|ИЗ
	|	РегистрСведений.РегистрацияТранспортныхСредств.СрезПоследних(&Период, Организация = &Организация) КАК РегистрацияТС
	|ГДЕ
	|	РегистрацияТС.ВидЗаписи = ЗНАЧЕНИЕ(Перечисление.ВидЗаписиОРегистрации.Регистрация)
	|	И ВЫБОР
	|			КОГДА РегистрацияТС.НалоговыйОрган = ЗНАЧЕНИЕ(Справочник.РегистрацииВНалоговомОргане.ПустаяСсылка)
	|				ТОГДА РегистрацияТС.Организация.РегистрацияВНалоговомОргане
	|			ИНАЧЕ РегистрацияТС.НалоговыйОрган
	|		КОНЕЦ = &НалоговыйОрган
	|	И НЕ РегистрацияТС.НалоговаяЛьгота В (ЗНАЧЕНИЕ(Перечисление.ВидыНалоговыхЛьготПоТранспортномуНалогу.ПустаяСсылка), ЗНАЧЕНИЕ(Перечисление.ВидыНалоговыхЛьготПоТранспортномуНалогу.НеПрименяется))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПаспортаТранспортныхСредствСрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	ПаспортаТранспортныхСредствСрезПоследних.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ПаспортаТранспортныхСредствСрезПоследних.Марка КАК Марка,
	|	ПаспортаТранспортныхСредствСрезПоследних.Модель КАК Модель,
	|	ПаспортаТранспортныхСредствСрезПоследних.РегистрационныйЗнак КАК РегистрационныйЗнак
	|ПОМЕСТИТЬ ПТС
	|ИЗ
	|	РегистрСведений.ПаспортаТранспортныхСредств.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						Налог.ОсновноеСредство КАК ОсновноеСредство
	|					ИЗ
	|						Налог КАК Налог)) КАК ПаспортаТранспортныхСредствСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Налог.КодВидаТС КАК КодВидаТС,
	|	Налог.КодНалоговойЛьготы КАК КодНалоговойЛьготы,
	|	Налог.РегиональныйКодЛьготы КАК РегиональныйКодЛьготы,
	|	ПТС.Марка КАК Марка,
	|	ПТС.Модель КАК Модель,
	|	ПТС.РегистрационныйЗнак КАК РегистрационныйЗнак
	|ИЗ
	|	Налог КАК Налог
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПТС КАК ПТС
	|		ПО Налог.ОсновноеСредство = ПТС.ОсновноеСредство
	|			И Налог.ИнвентарныйНомер = ПТС.ИнвентарныйНомер
	|
	|УПОРЯДОЧИТЬ ПО
	|	РегистрационныйЗнак";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	// Подготовим таблицу соответствия кодов видов ТС, используемых в декларации по транспортному налогу,
	// и номеров категорий ТС, используемых в заявлении на льготу 
	Макет = РегистрыСведений.РегистрацияТранспортныхСредств.ПолучитьМакет("КодыВидовИКатегорииТС");
	КодыВидовИКатегорииТС = ОбщегоНазначения.ПрочитатьXMLВТаблицу(Макет.ПолучитьТекст()).Данные;
	
	Пока Выборка.Следующий() Цикл
		
		// Контейнер приходит с пустой таблицей раздела 5 (Транспорт) 
		ДанныеСтраницы = Контейнер.Транспорт.Добавить();
		ДанныеСтраницы.УИД = Новый УникальныйИдентификатор;
		
		НайденнаяСтрока = КодыВидовИКатегорииТС.Найти(Выборка.КодВидаТС, "КодВида");
		Если НайденнаяСтрока <> Неопределено Тогда
			ДанныеСтраницы.ВидТС = НайденнаяСтрока.НомерКатегории;
		КонецЕсли;
		
		МаркаМодель = СокрЛП(СокрЛП(Выборка.Марка) + " " + СокрЛП(Выборка.Модель));
		
		ДанныеСтраницы.МаркаТС			= МаркаМодель;
		ДанныеСтраницы.РегЗнакТС		= Выборка.РегистрационныйЗнак;
		ДанныеСтраницы.КодНалЛьготТр	= Выборка.КодНалоговойЛьготы;
		ДанныеСтраницы.СтруктЕдЗакон	= Выборка.РегиональныйКодЛьготы;
		
	КонецЦикла;
	
	#КонецОбласти
	
	#Область ЛьготыПоЗемельнымУчасткам
	
	// Коды льгот указаны в приложении №2 к порядку заполнения формы заявления о льготе (Приказ ФНС России от 25.07.2019 N ММВ-7-21/377@)
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РегистрацияЗУ.ОсновноеСредство КАК ОсновноеСредство,
	|	РегистрацияЗУ.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ВЫБОР
	|		КОГДА РегистрацияЗУ.НалоговаяЛьготаПоНалоговойБазе = ЗНАЧЕНИЕ(Перечисление.ВидыНалоговыхЛьготПоЗемельномуНалогуПоНалоговойБазе.УменьшениеНалоговойБазы)
	|				ИЛИ РегистрацияЗУ.НеОблагаемаяНалогомСумма > 0
	|			ТОГДА ""3022100""
	|		КОГДА РегистрацияЗУ.СуммаУменьшенияСуммыНалога > 0
	|				ИЛИ РегистрацияЗУ.ПроцентУменьшенияСуммыНалога > 0
	|			ТОГДА ""3022200""
	|		КОГДА РегистрацияЗУ.НалоговаяЛьготаПоНалоговойБазе = ЗНАЧЕНИЕ(Перечисление.ВидыНалоговыхЛьготПоЗемельномуНалогуПоНалоговойБазе.НеОблагаемаяНалогомПлощадь)
	|			ТОГДА ""3022300""
	|		КОГДА РегистрацияЗУ.НалоговаяЛьготаПоНалоговойБазе = ЗНАЧЕНИЕ(Перечисление.ВидыНалоговыхЛьготПоЗемельномуНалогуПоНалоговойБазе.ОсвобождениеОтНалогообложенияМестное)
	|			ТОГДА ""3022400""
	|		КОГДА РегистрацияЗУ.СниженнаяНалоговаяСтавка > 0
	|			ТОГДА ""3022500""
	|		ИНАЧЕ РегистрацияЗУ.КодНалоговойЛьготыОсвобождениеОтНалогообложенияПоСтатье395
	|	КОНЕЦ КАК КодНалоговойЛьготы
	|ПОМЕСТИТЬ Налог
	|ИЗ
	|	РегистрСведений.РегистрацияЗемельныхУчастков.СрезПоследних(&Период, Организация = &Организация) КАК РегистрацияЗУ
	|ГДЕ
	|	РегистрацияЗУ.ВидЗаписи = ЗНАЧЕНИЕ(Перечисление.ВидЗаписиОРегистрации.Регистрация)
	|	И ВЫБОР
	|			КОГДА РегистрацияЗУ.НалоговыйОрган = ЗНАЧЕНИЕ(Справочник.РегистрацииВНалоговомОргане.ПустаяСсылка)
	|				ТОГДА РегистрацияЗУ.Организация.РегистрацияВНалоговомОргане
	|			ИНАЧЕ РегистрацияЗУ.НалоговыйОрган
	|		КОНЕЦ = &НалоговыйОрган
	|	И (НЕ РегистрацияЗУ.НалоговаяЛьготаПоНалоговойБазе В (ЗНАЧЕНИЕ(Перечисление.ВидыНалоговыхЛьготПоЗемельномуНалогуПоНалоговойБазе.ПустаяССылка), ЗНАЧЕНИЕ(Перечисление.ВидыНалоговыхЛьготПоЗемельномуНалогуПоНалоговойБазе.НеПрименяется))
	|			ИЛИ РегистрацияЗУ.НеОблагаемаяНалогомСумма > 0
	|			ИЛИ РегистрацияЗУ.СниженнаяНалоговаяСтавка > 0
	|			ИЛИ РегистрацияЗУ.ПроцентУменьшенияСуммыНалога > 0
	|			ИЛИ РегистрацияЗУ.СуммаУменьшенияСуммыНалога > 0)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СведенияКадастровогоУчетаСрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	СведенияКадастровогоУчетаСрезПоследних.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СведенияКадастровогоУчетаСрезПоследних.КадастровыйНомер КАК КадастровыйНомер
	|ПОМЕСТИТЬ СведенияКадастра
	|ИЗ
	|	РегистрСведений.СведенияКадастровогоУчета.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						Налог.ОсновноеСредство КАК ОсновноеСредство
	|					ИЗ
	|						Налог КАК Налог)) КАК СведенияКадастровогоУчетаСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Налог.КодНалоговойЛьготы КАК КодНалоговойЛьготы,
	|	СведенияКадастра.КадастровыйНомер КАК КадастровыйНомер
	|ИЗ
	|	Налог КАК Налог
	|		ЛЕВОЕ СОЕДИНЕНИЕ СведенияКадастра КАК СведенияКадастра
	|		ПО Налог.ОсновноеСредство = СведенияКадастра.ОсновноеСредство
	|			И Налог.ИнвентарныйНомер = СведенияКадастра.ИнвентарныйНомер
	|
	|УПОРЯДОЧИТЬ ПО
	|	КадастровыйНомер";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		// Контейнер приходит с пустой таблицей раздела 6 (Земля)
		ДанныеСтраницы = Контейнер.Земля.Добавить();
		ДанныеСтраницы.УИД = Новый УникальныйИдентификатор;
		
		ДанныеСтраницы.НомКадастрЗУ		= Выборка.КадастровыйНомер;
		ДанныеСтраницы.КодНалЛьготЗем	= Выборка.КодНалоговойЛьготы;
		
	КонецЦикла;
	
	#КонецОбласти
	
КонецПроцедуры

#КонецОбласти

#Область СообщениеОНаличииТранспортыхСредствЗемельныхУчастков

Процедура ПолучитьСведенияОПоказателяхОтчетаУведомлениеСообщениеТранспортЗемля(ИДРедакцииОтчета, ПоказателиОтчета) Экспорт
	
	Если ИДРедакцииОтчета = "Форма2020_1" Или ИДРедакцииОтчета = "Форма2021_1" Тогда
		
		// Транспорт
		РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "ВидТС"			, Истина, Ложь);
		РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "СерНомПасп"	, Истина, Ложь);
		РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "ИдНомТС"		, Истина, Ложь);
		РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "МаркаТС"		, Истина, Ложь);
		РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "РегЗнакТС"		, Истина, Ложь);
		РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "ДатаРегТС"		, Истина, Ложь);
		РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "ДатаСнУчетТС"	, Истина, Ложь);
		
		// Земля
		РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "НомКадастрЗУ"	, Истина, Ложь);
		
	ИначеЕсли ИДРедакцииОтчета = "Форма2023_1" Тогда
		
		// Транспорт
		РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "ВидТС"			, Истина, Ложь);
		РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "СерНомПасп"	, Истина, Ложь);
		РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "ИдНомТС"		, Истина, Ложь);
		РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "МаркаТС"		, Истина, Ложь);
		РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "РегЗнакТС"		, Истина, Ложь);
		
		// Земля
		РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "НомКадастрЗУ"	, Истина, Ложь);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьОтчетУведомлениеСообщениеТранспортЗемля(ИДРедакцииОтчета, ПараметрыОтчета, Контейнер) Экспорт
	
	Если ИДРедакцииОтчета = "Форма2020_1" Или ИДРедакцииОтчета = "Форма2021_1" Тогда
		ЗаполнитьСообщениеПоТранспоруЗемельнымУчастках2020(ПараметрыОтчета, Контейнер);
	ИначеЕсли ИДРедакцииОтчета = "Форма2023_1" Тогда
		ЗаполнитьСообщениеПоТранспоруЗемельнымУчастках2020(ПараметрыОтчета, Контейнер, 2023);
	КонецЕсли;
	
КонецПроцедуры

// Заполняет показатели регламентированного отчета.
//
// Параметры:
//  ПараметрыОтчета - Структура - параметры для заполнения отчета.
//  Контейнер - Структура - структура, в которую помещаются заполненные показатели отчета.
//
Процедура ЗаполнитьСообщениеПоТранспоруЗемельнымУчастках2020(ПараметрыОтчета, Контейнер, Год = 2020) Экспорт
	
	Период = ?(ЗначениеЗаполнено(ПараметрыОтчета.ДатаПодписи), ПараметрыОтчета.ДатаПодписи, ОбщегоНазначения.ТекущаяДатаПользователя());
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация"		, ПараметрыОтчета.Организация);
	Запрос.УстановитьПараметр("НалоговыйОрган"	, ПараметрыОтчета.РегистрацияВИФНС);
	Запрос.УстановитьПараметр("Период"			, Период);
	
	#Область Транспорт
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РегистрацияТС.ОсновноеСредство КАК ОсновноеСредство,
	|	РегистрацияТС.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	РегистрацияТС.КодВидаТранспортногоСредства КАК КодВидаТС
	|ПОМЕСТИТЬ Налог
	|ИЗ
	|	РегистрСведений.РегистрацияТранспортныхСредств.СрезПоследних(&Период, Организация = &Организация) КАК РегистрацияТС
	|ГДЕ
	|	РегистрацияТС.ВидЗаписи = ЗНАЧЕНИЕ(Перечисление.ВидЗаписиОРегистрации.Регистрация)
	|	И ВЫБОР
	|			КОГДА РегистрацияТС.НалоговыйОрган = ЗНАЧЕНИЕ(Справочник.РегистрацииВНалоговомОргане.ПустаяСсылка)
	|				ТОГДА РегистрацияТС.Организация.РегистрацияВНалоговомОргане
	|			ИНАЧЕ РегистрацияТС.НалоговыйОрган
	|		КОНЕЦ = &НалоговыйОрган
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПаспортаТранспортныхСредствСрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	ПаспортаТранспортныхСредствСрезПоследних.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ПаспортаТранспортныхСредствСрезПоследних.СерияНомер КАК СерияНомер,
	|	ПаспортаТранспортныхСредствСрезПоследних.ИдентификационныйНомер КАК ИдентификационныйНомер,
	|	ПаспортаТранспортныхСредствСрезПоследних.Марка КАК Марка,
	|	ПаспортаТранспортныхСредствСрезПоследних.Модель КАК Модель,
	|	ПаспортаТранспортныхСредствСрезПоследних.РегистрационныйЗнак КАК РегистрационныйЗнак,
	|	ПаспортаТранспортныхСредствСрезПоследних.ДатаРегистрации КАК ДатаРегистрации,
	|	ПаспортаТранспортныхСредствСрезПоследних.ДатаСнятияСУчета КАК ДатаСнятияСУчета
	|ПОМЕСТИТЬ ПТС
	|ИЗ
	|	РегистрСведений.ПаспортаТранспортныхСредств.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						Налог.ОсновноеСредство КАК ОсновноеСредство
	|					ИЗ
	|						Налог КАК Налог)) КАК ПаспортаТранспортныхСредствСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Налог.ОсновноеСредство КАК ОсновноеСредство,
	|	Налог.КодВидаТС КАК КодВидаТС,
	|	ПТС.СерияНомер КАК СерияНомер,
	|	ПТС.ИдентификационныйНомер КАК ИдентификационныйНомер,
	|	ПТС.Марка КАК Марка,
	|	ПТС.Модель КАК Модель,
	|	ПТС.РегистрационныйЗнак КАК РегистрационныйЗнак,
	|	ПТС.ДатаРегистрации КАК ДатаРегистрации,
	|	ПТС.ДатаСнятияСУчета КАК ДатаСнятияСУчета
	|ИЗ
	|	Налог КАК Налог
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПТС КАК ПТС
	|		ПО Налог.ОсновноеСредство = ПТС.ОсновноеСредство
	|			И Налог.ИнвентарныйНомер = ПТС.ИнвентарныйНомер
	|
	|УПОРЯДОЧИТЬ ПО
	|	РегистрационныйЗнак";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	// Подготовим таблицу соответствия кодов видов ТС, используемых в декларации по транспортному налогу,
	// и номеров категорий ТС, используемых в заявлении на льготу
	Макет = РегистрыСведений.РегистрацияТранспортныхСредств.ПолучитьМакет("КодыВидовИКатегорииТС");
	КодыВидовИКатегорииТС = ОбщегоНазначения.ПрочитатьXMLВТаблицу(Макет.ПолучитьТекст()).Данные;
	
	Пока Выборка.Следующий() Цикл
		
		ДанныеСтраницы = Контейнер.Транспорт.Добавить();
		ДанныеСтраницы.УИД = Новый УникальныйИдентификатор;
		
		НайденнаяСтрока = КодыВидовИКатегорииТС.Найти(Выборка.КодВидаТС, "КодВида");
		ВидТС = ?(НайденнаяСтрока = Неопределено, "", НайденнаяСтрока.НомерКатегории);
		
		МаркаМодель = СокрЛП(СокрЛП(Выборка.Марка) + " " + СокрЛП(Выборка.Модель));
		
		ДанныеСтраницы.ВидТС		= ВидТС;
		ДанныеСтраницы.СерНомПасп	= Выборка.СерияНомер;
		ДанныеСтраницы.ИдНомТС		= Выборка.ИдентификационныйНомер;
		ДанныеСтраницы.МаркаТС		= МаркаМодель;
		ДанныеСтраницы.РегЗнакТС	= Выборка.РегистрационныйЗнак;
		
		Если Год < 2023 Тогда
			ДанныеСтраницы.ДатаРегТС	= Выборка.ДатаРегистрации;
			ДанныеСтраницы.ДатаСнУчетТС	= Выборка.ДатаСнятияСУчета;
		КонецЕсли;
		
	КонецЦикла;
	
	#КонецОбласти
	
	#Область ЗемельныеУчастки
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РегистрацияЗУ.ОсновноеСредство КАК ОсновноеСредство,
	|	РегистрацияЗУ.ИнвентарныйНомер КАК ИнвентарныйНомер
	|ПОМЕСТИТЬ Налог
	|ИЗ
	|	РегистрСведений.РегистрацияЗемельныхУчастков.СрезПоследних(&Период, Организация = &Организация) КАК РегистрацияЗУ
	|ГДЕ
	|	РегистрацияЗУ.ВидЗаписи = ЗНАЧЕНИЕ(Перечисление.ВидЗаписиОРегистрации.Регистрация)
	|	И ВЫБОР
	|			КОГДА РегистрацияЗУ.НалоговыйОрган = ЗНАЧЕНИЕ(Справочник.РегистрацииВНалоговомОргане.ПустаяСсылка)
	|				ТОГДА РегистрацияЗУ.Организация.РегистрацияВНалоговомОргане
	|			ИНАЧЕ РегистрацияЗУ.НалоговыйОрган
	|		КОНЕЦ = &НалоговыйОрган
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СведенияКадастровогоУчетаСрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	СведенияКадастровогоУчетаСрезПоследних.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СведенияКадастровогоУчетаСрезПоследних.КадастровыйНомер КАК КадастровыйНомер
	|ПОМЕСТИТЬ СведенияКадастра
	|ИЗ
	|	РегистрСведений.СведенияКадастровогоУчета.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						Налог.ОсновноеСредство КАК ОсновноеСредство
	|					ИЗ
	|						Налог КАК Налог)) КАК СведенияКадастровогоУчетаСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Налог.ОсновноеСредство КАК ОсновноеСредство,
	|	СведенияКадастра.КадастровыйНомер КАК КадастровыйНомер
	|ИЗ
	|	Налог КАК Налог
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СведенияКадастра КАК СведенияКадастра
	|		ПО Налог.ОсновноеСредство = СведенияКадастра.ОсновноеСредство
	|			И Налог.ИнвентарныйНомер = СведенияКадастра.ИнвентарныйНомер
	|
	|УПОРЯДОЧИТЬ ПО
	|	КадастровыйНомер";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ДанныеСтраницы = Контейнер.Земля.Добавить();
		ДанныеСтраницы.УИД = Новый УникальныйИдентификатор;
		
		ДанныеСтраницы.НомКадастрЗУ = Выборка.КадастровыйНомер;
		
	КонецЦикла;
	
	#КонецОбласти
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область БухгалтерскиеОперации

Функция КЭКСчетаПриВводеОстатков(Организация, ИФО, КФО, Дата, Счет, ДтКт)
	
	Если БухгалтерскийУчетПовтИсп.ТипКЭКПоУчетнойПолитике(Организация, ИФО, КФО, КонецГода(Дата) + 1) =
			Перечисления.ТипыАналитическихПризнаков.ПроизвольнаяКлассификация Тогда
		ИспользоватьКЭК0 = Истина;
	Иначе
		ЭтоКонецГода = ((Месяц(Дата) = 12) И (День(Дата) = 31));
		ЭтоСчетСОборотнымКЭК = НЕ (БухгалтерскийУчетПовтИсп.СчетаСОборотнымКЭК().Найти(Счет) = Неопределено);
		ИспользоватьКЭК0 = (ЭтоКонецГода И ЭтоСчетСОборотнымКЭК);
	КонецЕсли;
	
	Если ИспользоватьКЭК0 Тогда
		Возврат БухгалтерскийУчетПовтИсп.КЭК0();
	Иначе
		Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Счет, "КОСГУ" + ДтКт);
	КонецЕсли;
	
КонецФункции

// Структура таблицы для функций ПодготовитьТаблицуРеализацияОсновныхСредствПоДокументу
// и ПодготовитьТаблицуРеализацияИмуществаКазныПоДокументу
Функция ПустаяТаблицаРеализацияОсновныхСредствПоДокументу()

	ОписаниеТипаСуммы        = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества   = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	ОписаниеТиповВидСубконто = Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто");
	
	ТаблицаДокумента = Новый ТаблицаЗначений;
	// Идентификация строки.
	ТаблицаДокумента.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ТаблицаДокумента.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ТаблицаДокумента.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	// Общие разрезы учета.
	ТаблицаДокумента.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ТаблицаДокумента.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ТаблицаДокумента.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаДокумента.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	// Реализуемый объект ОС, НМА, НПА.
	ТаблицаДокумента.Колонки.Добавить("ОсновноеСредство", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ТаблицаДокумента.Колонки.Добавить("ИнвентарныйНомер", Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	// Покупатель.
	ТаблицаДокумента.Колонки.Добавить("СчетРасчетов",  Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаДокумента.Колонки.Добавить("КЭКДоходов",    Новый ОписаниеТипов("СправочникСсылка.КОСГУ")); // 172.
	ТаблицаДокумента.Колонки.Добавить("Контрагент",    Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТаблицаДокумента.Колонки.Добавить("Договор",       Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ТаблицаДокумента.Колонки.Добавить("Валюта",        Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	// Количественные и суммовые характеристики.
	ТаблицаДокумента.Колонки.Добавить("Количество",    ОписаниеТипаКоличества);
	ТаблицаДокумента.Колонки.Добавить("Сумма",         ОписаниеТипаСуммы); // Сумма с НДС в валюте документа.
	ТаблицаДокумента.Колонки.Добавить("СтавкаНДС",     Новый ОписаниеТипов("ПеречислениеСсылка.СтавкиНДС"));
	ТаблицаДокумента.Колонки.Добавить("СуммаНДС",      ОписаниеТипаСуммы); // Сумма НДС в валюте документа.
	
	Возврат ТаблицаДокумента;

КонецФункции 

#КонецОбласти

#Область НачислениеАмортизации

Функция ТекстЗапроса_ТаблицыДляРасчетаАмортизацииБУ(НачислятьАмортизациюПервымЧислом)
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство
	|ПОМЕСТИТЬ ВТ_АмортизацияЗаТекущийМесяц1
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(&НачалоМесяца, &КонецМесяца, Организация = &Организация
	|	И СчетКт В (&СчетАмортизации)
	|	И &УсловиеОС
	|	И Регистратор ССЫЛКА Документ.НачислениеАмортизацииОС,,) КАК ЖурналПроводокЕПСБУДвиженияССубконто
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АмортизацияОбъектовОС.ОсновноеСредство КАК ОсновноеСредство,
	|	АмортизацияОбъектовОС.ИнвентарныйНомер КАК ИнвентарныйНомер
	|ПОМЕСТИТЬ ВТ_АмортизацияЗаТекущийМесяц
	|ИЗ
	|	РегистрНакопления.АмортизацияОбъектовОС КАК АмортизацияОбъектовОС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_АмортизацияЗаТекущийМесяц1 КАК ВТ_АмортизацияЗаТекущийМесяц
	|		ПО АмортизацияОбъектовОС.ОсновноеСредство = ВТ_АмортизацияЗаТекущийМесяц.ОсновноеСредство
	|ГДЕ
	|	АмортизацияОбъектовОС.Активность
	|	И АмортизацияОбъектовОС.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|	И АмортизацияОбъектовОС.Период МЕЖДУ &НачалоМесяца И &КонецМесяцаДата
	|	И Организация = &Организация
	|	И АмортизацияОбъектовОС.Регистратор ССЫЛКА Документ.НачислениеАмортизацииОС
	|	И АмортизацияОбъектовОС.ОсновноеСредство В
	|		(ВЫБРАТЬ
	|			Таб.ОсновноеСредство
	|		ИЗ
	|			ВТ_АмортизацияЗаТекущийМесяц1 КАК Таб)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство,
	|	ИнвентарныйНомер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ОстаткиНаКонецМесяца.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	|	ОстаткиНаКонецМесяца.ИФО КАК ИФО,
	|	ОстаткиНаКонецМесяца.КФО КАК КФО,
	|	ОстаткиНаКонецМесяца.КПС КАК КПС,
	|	ОстаткиНаКонецМесяца.Подразделение КАК Подразделение,
	|	ОстаткиНаКонецМесяца.Счет КАК СчетУчета,
	|	ОстаткиНаКонецМесяца.СуммаОстатокДт КАК СтоимостьНаДатуРасчета
	|ПОМЕСТИТЬ ОстаткиНаДатуРасчета_БУ1
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&ДатаРасчета, Счет В (&СписокСчетов),
	|		ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства), Организация = &Организация
	|	И &УсловиеИФО
	|	И &УсловиеКФО
	|	И &УсловиеПодразделение
	|	И &УсловиеОС
	|	И НЕ Субконто1 В
	|		(ВЫБРАТЬ
	|			ВТ.ОсновноеСредство
	|		ИЗ
	|			ВТ_АмортизацияЗаТекущийМесяц КАК ВТ)) КАК ОстаткиНаКонецМесяца
	|ГДЕ
	|	ОстаткиНаКонецМесяца.СуммаОстатокДт > 0
	|	И &ОтборПоКФОиСчетуУчета
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ОстаткиНаДатуРасчета_БУ.ИФО КАК ИФО,
	|	ОстаткиНаДатуРасчета_БУ.КФО КАК КФО,
	|	ОстаткиНаДатуРасчета_БУ.КПС КАК КПС,
	|	ОстаткиНаДатуРасчета_БУ.Подразделение КАК Подразделение,
	|	ОстаткиНаДатуРасчета_БУ.СчетУчета КАК СчетУчета,
	|	СтоимостьОбъектовОСОстатки.СтоимостьОстаток КАК СтоимостьНаДатуРасчета
	|ПОМЕСТИТЬ ОстаткиНаДатуРасчета_БУ
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(&ДатаРасчета, Организация = &Организация
	|	И ОсновноеСредство В
	|		(ВЫБРАТЬ
	|			Таб.ОсновноеСредство
	|		ИЗ
	|			ОстаткиНаДатуРасчета_БУ1 КАК Таб)) КАК СтоимостьОбъектовОСОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОстаткиНаДатуРасчета_БУ1 КАК ОстаткиНаДатуРасчета_БУ
	|		ПО СтоимостьОбъектовОСОстатки.ОсновноеСредство = ОстаткиНаДатуРасчета_БУ.ОсновноеСредство
	|			И СтоимостьОбъектовОСОстатки.Подразделение = ОстаткиНаДатуРасчета_БУ.Подразделение
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство,
	|	ИнвентарныйНомер,
	|	КФО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВТ_АмортизацияЗаТекущийМесяц1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ОстаткиНаДатуРасчета_БУ1";
	
	Если НЕ НачислятьАмортизациюПервымЧислом Тогда
		ТекстЗапроса = ТекстЗапроса + ОбщегоНазначения.РазделительПакетаЗапросов() + "ВЫБРАТЬ
		|	ВЫРАЗИТЬ(ОстаткиНаНачалоМесяца.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство
		|ПОМЕСТИТЬ ОстаткиНаНачалоМесяца_БУ1
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&НачалоМесяца, Счет В (&СписокСчетов),
		|		ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства), Организация = &Организация
		|	И &УсловиеИФО
		|	И &УсловиеКФО
		|	И Субконто1 В
		|		(ВЫБРАТЬ
		|			ВТ.ОсновноеСредство
		|		ИЗ
		|			ОстаткиНаДатуРасчета_БУ КАК ВТ)) КАК ОстаткиНаНачалоМесяца
		|ГДЕ
		|	ОстаткиНаНачалоМесяца.СуммаОстатокДт > 0
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ОсновноеСредство
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
		|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер
		|ПОМЕСТИТЬ ОстаткиНаНачалоМесяца_БУ
		|ИЗ
		|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(&НачалоМесяца,
		|		ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)
		|	И Организация = &Организация
		|	И ОсновноеСредство В
		|		(ВЫБРАТЬ
		|			Таб.ОсновноеСредство
		|		ИЗ
		|			ОстаткиНаНачалоМесяца_БУ1 КАК Таб)) КАК СтоимостьОбъектовОСОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОстаткиНаНачалоМесяца_БУ1 КАК ОстаткиНаНачалоМесяца_БУ
		|		ПО СтоимостьОбъектовОСОстатки.ОсновноеСредство = ОстаткиНаНачалоМесяца_БУ.ОсновноеСредство
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ОсновноеСредство,
		|	ИнвентарныйНомер
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ ОстаткиНаНачалоМесяца_БУ1";
	КонецЕсли;                     
	
	ТекстЗапроса = ТекстЗапроса + ОбщегоНазначения.РазделительПакетаЗапросов() + "
	|ВЫБРАТЬ
	|	ПараметрыАмортизацииБУ.ОсновноеСредство КАК ОсновноеСредство,
	|	ПараметрыАмортизацииБУ.СпособНачисленияАмортизации КАК СпособНачисленияАмортизации
	|ПОМЕСТИТЬ ПараметрыАмортизацииОС_БУ
	|ИЗ
	|	РегистрСведений.ПараметрыАмортизацииОСБухгалтерскийУчет.СрезПоследних(
	|			&ДатаРасчета,
	|			Организация = &Организация
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						ВТ.ОсновноеСредство
	|					ИЗ
	|						ОстаткиНаДатуРасчета_БУ КАК ВТ)) КАК ПараметрыАмортизацииБУ
	|ГДЕ
	|	ПараметрыАмортизацииБУ.ПорядокПогашенияСтоимости = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации)
	|	И ПараметрыАмортизацииБУ.СпособНачисленияАмортизации В(&МетодыНачисления)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РасчетАмортизацииОС.ОсновноеСредство КАК ОсновноеСредство,
	|	РасчетАмортизацииОС.Период КАК ПериодРасчета,
	|	РасчетАмортизацииОС.СрокПолезногоИспользования КАК СрокПолезногоИспользования,
	|	ВЫБОР
	|		КОГДА РасчетАмортизацииОС.КоэффициентУскорения = 0
	|			ТОГДА 1
	|		ИНАЧЕ РасчетАмортизацииОС.КоэффициентУскорения
	|	КОНЕЦ КАК КоэффициентУскорения,
	|	РасчетАмортизацииОС.ПараметрВыработки КАК ПараметрВыработки,
	|	РасчетАмортизацииОС.ПредполагаемыйОбъемВыработки КАК ПредполагаемыйОбъемВыработки,
	|	ВЫБОР
	|		КОГДА РасчетАмортизацииОС.СрокИспользованияДляВычисленияАмортизации > 0
	|				И РасчетАмортизацииОС.СтоимостьДляВычисленияАмортизации <> 0
	|			ТОГДА РасчетАмортизацииОС.СрокИспользованияДляВычисленияАмортизации
	|		ИНАЧЕ РасчетАмортизацииОС.СрокПолезногоИспользования
	|	КОНЕЦ КАК СрокИспользованияДляВычисленияАмортизации,
	|	ВЫБОР
	|		КОГДА РасчетАмортизацииОС.СрокИспользованияДляВычисленияАмортизации > 0
	|				И РасчетАмортизацииОС.СтоимостьДляВычисленияАмортизации <> 0
	|			ТОГДА РасчетАмортизацииОС.СтоимостьДляВычисленияАмортизации
	|		ИНАЧЕ NULL
	|	КОНЕЦ КАК СтоимостьДляВычисленияАмортизации
	|ПОМЕСТИТЬ РасчетАмортизацииОС_БУ
	|ИЗ
	|	РегистрСведений.РасчетАмортизацииОС.СрезПоследних(
	|			&ДатаРасчета,
	|			ОсновноеСредство В
	|				(ВЫБРАТЬ
	|					ВТ.ОсновноеСредство
	|				ИЗ
	|					ПараметрыАмортизацииОС_БУ КАК ВТ)) КАК РасчетАмортизацииОС
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НачислениеАмортизацииБУ.ОсновноеСредство КАК ОсновноеСредство,
	|	НачислениеАмортизацииБУ.НачислятьАмортизацию КАК НачислятьАмортизацию
	|ПОМЕСТИТЬ НачислениеАмортизацииОС_БУ
	|ИЗ
	|	РегистрСведений.НачислениеАмортизацииОСБухгалтерскийУчет.СрезПоследних(
	|			&ДатаРасчета,
	|			Организация = &Организация
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						ВТ.ОсновноеСредство
	|					ИЗ
	|						ПараметрыАмортизацииОС_БУ КАК ВТ)) КАК НачислениеАмортизацииБУ
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство";
	
	Если НЕ НачислятьАмортизациюПервымЧислом Тогда
		ТекстЗапроса = ТекстЗапроса + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() + "
		|ВЫБРАТЬ
		|	СписокОС.ОсновноеСредство КАК ОсновноеСредство,
		|	СписокОС.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	СписокОС.ИФО КАК ИФО,
		|	СписокОС.КФО КАК КФО,
		|	СписокОС.КПС КАК КПС,
		|	СписокОС.Подразделение КАК Подразделение,
		|	СписокОС.СчетУчета КАК СчетУчета,
		|	СписокОС.СтоимостьНаДатуРасчета КАК СтоимостьНаДатуРасчета,
		|	ПараметрыАмортизацииОС.СпособНачисленияАмортизации КАК СпособНачисленияАмортизации,
		|	РасчетАмортизацииОС.СрокПолезногоИспользования КАК СрокПолезногоИспользования,
		|	РасчетАмортизацииОС.СрокИспользованияДляВычисленияАмортизации КАК СрокИспользованияДляВычисленияАмортизации,
		|	ЕСТЬNULL(РасчетАмортизацииОС.СтоимостьДляВычисленияАмортизации, СписокОС.СтоимостьНаДатуРасчета) КАК СтоимостьДляВычисленияАмортизации,
		|	РасчетАмортизацииОС.КоэффициентУскорения КАК КоэффициентУскорения,
		|	РасчетАмортизацииОС.ПараметрВыработки КАК ПараметрВыработки,
		|	РасчетАмортизацииОС.ПредполагаемыйОбъемВыработки КАК ПредполагаемыйОбъемВыработки,
		|	РасчетАмортизацииОС.ПериодРасчета КАК ПериодРасчета
		|ПОМЕСТИТЬ СписокОС_БУ
		|ИЗ
		|	ОстаткиНаДатуРасчета_БУ КАК СписокОС
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОстаткиНаНачалоМесяца_БУ КАК ОстаткиНаНачалоМесяца
		|		ПО СписокОС.ОсновноеСредство = ОстаткиНаНачалоМесяца.ОсновноеСредство
		|		И СписокОС.ИнвентарныйНомер = ОстаткиНаНачалоМесяца.ИнвентарныйНомер
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПараметрыАмортизацииОС_БУ КАК ПараметрыАмортизацииОС
		|		ПО СписокОС.ОсновноеСредство = ПараметрыАмортизацииОС.ОсновноеСредство
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РасчетАмортизацииОС_БУ КАК РасчетАмортизацииОС
		|		ПО СписокОС.ОсновноеСредство = РасчетАмортизацииОС.ОсновноеСредство
		|		ЛЕВОЕ СОЕДИНЕНИЕ НачислениеАмортизацииОС_БУ КАК НачислениеАмортизацииОС
		|		ПО СписокОС.ОсновноеСредство = НачислениеАмортизацииОС.ОсновноеСредство
		|ГДЕ
		|	ЕСТЬNULL(НачислениеАмортизацииОС.НачислятьАмортизацию, ИСТИНА)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ОсновноеСредство";  
	Иначе	
		ТекстЗапроса = ТекстЗапроса + ОбщегоНазначения.РазделительПакетаЗапросов() + "
		|ВЫБРАТЬ
		|	СписокОС.ОсновноеСредство КАК ОсновноеСредство,
		|	СписокОС.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	СписокОС.ИФО КАК ИФО,
		|	СписокОС.КФО КАК КФО,
		|	СписокОС.КПС КАК КПС,
		|	СписокОС.Подразделение КАК Подразделение,
		|	СписокОС.СчетУчета КАК СчетУчета,
		|	СписокОС.СтоимостьНаДатуРасчета КАК СтоимостьНаДатуРасчета,
		|	ПараметрыАмортизацииОС.СпособНачисленияАмортизации КАК СпособНачисленияАмортизации,
		|	РасчетАмортизацииОС.СрокПолезногоИспользования КАК СрокПолезногоИспользования,
		|	РасчетАмортизацииОС.СрокИспользованияДляВычисленияАмортизации КАК СрокИспользованияДляВычисленияАмортизации,
		|	ЕСТЬNULL(РасчетАмортизацииОС.СтоимостьДляВычисленияАмортизации, СписокОС.СтоимостьНаДатуРасчета) КАК СтоимостьДляВычисленияАмортизации,
		|	РасчетАмортизацииОС.КоэффициентУскорения КАК КоэффициентУскорения,
