// Функция определяет фактический срок эксплуатации
//
// Параметры:
//  ОсновноеСредство - СправочникСсылка.ОсновныеСредства - ОС, для которого делаем расчет
//  ИнвентарныйНомер - СправочникСсылка.ИнвентарныеНомераОС - инвентарный номер ОС, для которого делаем расчет
//  Организация - СправочникСсылка.Организации - организация
//  Период - Дата - дата, до которой рассчитываем фактический срок
//  НачислятьАмортизациюПервымЧислом - Булево - элемент учетной политики. Если не передан, то вычисляется.
//
// Возвращаемое значение:
//  - Число - фактический срок эксплуатации в месяцах
Функция ФактическийСрокЭксплуатации(ОсновноеСредство, ИнвентарныйНомер, 
	Организация, Период, Знач НачислятьАмортизациюПервымЧислом = Неопределено) Экспорт
	
	ДатыСобытий = ДатыСобытийОС_ПринятияИВвода(Организация, ОсновноеСредство, ИнвентарныйНомер, Период);
	
	СрокЭксплуатации = ФактическийСрокЭксплуатацииРасчет(
		ДатыСобытий.ДатаПринятиеКУчету, 
		ДатыСобытий.ДатаВводВЭксплуатацию, 
		Организация, Период, НачислятьАмортизациюПервымЧислом);
	
	Возврат СрокЭксплуатации;
КонецФункции

// Функция определяет фактический срок эксплуатации
//
// Параметры:
//  ДатаПринятиеКУчету - Дата - дата принятия к учету ОС
//  ДатаВводВЭксплуатацию - Дата - дата ввода в эксплуатацию ОС
//  Организация - СправочникСсылка.Организации - организация
//  Период - Дата - дата, до которой рассчитываем фактический срок
//  НачислятьАмортизациюПервымЧислом - Булево - элемент учетной политики. Если не передан, то вычисляется.
//
// Возвращаемое значение:
//  - Число - фактический срок эксплуатации в месяцах
Функция ФактическийСрокЭксплуатацииРасчет(ДатаПринятиеКУчету, ДатаВводВЭксплуатацию, 
	Организация, Период, Знач НачислятьАмортизациюПервымЧислом = Неопределено) Экспорт
	
	ДатаКонец = ДатаКонечная_ФактическийСрокЭксплуатации(
		Период, ДатаПринятиеКУчету, Организация, НачислятьАмортизациюПервымЧислом);
	
	ДатаНачало = ?(ЗначениеЗаполнено(ДатаВводВЭксплуатацию)
		И ДатаВводВЭксплуатацию < ДатаПринятиеКУчету, ДатаВводВЭксплуатацию, ДатаПринятиеКУчету);
	СрокЭксплуатации = РассчитатьМесяцыЭксплуатации(,ДатаНачало, ДатаКонец);
	
	Возврат СрокЭксплуатации;
КонецФункции

// Функция корректирует дату, до которой нужно считать фактический срок эксплуатации, переданную из источника с учетом 
// дополнительных условий  
//
// Параметры:
//  ДатаОтсчета - Дата - дата, до которой будет рассчитан фактический срок эксплуатации, переданная из источника, 
//  					и которую нужно скорректировать. Например, дата документа, из которого вызвана функция 
//  ДатаПринятияКУчету - Дата                        
//  Организация - СправочникСсылка.Организации - организация
//  НачислятьАмортизациюПервымЧислом - Булево - элемент учетной политики. Если не передан, то вычисляется.
//
// Возвращаемое значение:
//  - Дата - дата, до которой будет рассчитан фактический срок эксплуатации
Функция ДатаКонечная_ФактическийСрокЭксплуатации(
	ДатаОтсчета, ДатаПринятияКУчету, Организация, Знач НачислятьАмортизациюПервымЧислом = Неопределено) Экспорт
	
	Если НачислятьАмортизациюПервымЧислом = Неопределено Тогда
		НачислятьАмортизациюПервымЧислом = 
			Справочники.Организации.ПолучитьУчетнуюПолитику(Организация, ДатаОтсчета).НачислятьАмортизациюПервымЧислом;
	КонецЕсли;	
	
	ДатаКонечная = ?(НачалоМесяца(ДатаПринятияКУчету) = НачалоМесяца(ДатаОтсчета) 
		ИЛИ НачислятьАмортизациюПервымЧислом, ДатаОтсчета, НачалоМесяца(ДатаОтсчета)-1);
	
	Возврат ДатаКонечная;
КонецФункции	

// Определяет даты ввода в эксплуатацию и принятия к учету ОС, НМА, НПА
//
// Параметры:
//  Организация - СправочникСсылка.Организации
//  ОсновноеСредство - СправочникСсылка.ОсновныеСредства
//  ИнвентарныйНомер - СправочникСсылка.ИнвентарныеНомераОС
//
// Возвращаемое значение:
//  Структура - см. СтруктураДатыСобытийОС_ПринятияИВвода    
Функция ДатыСобытийОС_ПринятияИВвода(Организация, ОсновноеСредство, ИнвентарныйНомер, Дата) Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация"     , Организация);
	Запрос.УстановитьПараметр("ОсновноеСредство", ОсновноеСредство);
	Запрос.УстановитьПараметр("ИнвентарныйНомер", ИнвентарныйНомер);
	Запрос.УстановитьПараметр("Дата1", Дата);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СобытияОССрезПервых.Событие КАК Событие,
	|	СобытияОССрезПервых.ДатаСобытия КАК ДатаСобытия
	|ИЗ
	|	РегистрСведений.СобытияОС.СрезПоследних(&Дата1, Организация = &Организация
	|	И ОсновноеСредство = &ОсновноеСредство
	|	И ИнвНомер = &ИнвентарныйНомер
	|	И (Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)
	|	ИЛИ Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВводВЭксплуатацию))) КАК СобытияОССрезПервых";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = СтруктураДатыСобытийОС_ПринятияИВвода();
	
	Пока Выборка.Следующий() Цикл
		Если Выборка.Событие = Перечисления.ВидыСобытийОС.ПринятиеКУчету Тогда
			Результат.ДатаПринятиеКУчету = Выборка.ДатаСобытия;
		ИначеЕсли Выборка.Событие = Перечисления.ВидыСобытийОС.ВводВЭксплуатацию Тогда
			Результат.ДатаВводВЭксплуатацию = Выборка.ДатаСобытия;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

// Вовзращает структуру, описывающую даты ввода в эксплуатацию и принятия к учету ОС, НМА, НПА
//
// Возвращаемое значение:
//  Структура:
//    * ДатаПринятиеКУчету - Дата
//    * ДатаВводВЭксплуатацию - Дата
Функция СтруктураДатыСобытийОС_ПринятияИВвода() Экспорт
	Возврат Новый Структура("ДатаПринятиеКУчету, ДатаВводВЭксплуатацию", '00010101', '00010101');
КонецФункции	

// Функция определяет фактический срок эксплуатации в месяцах
//
Функция РассчитатьМесяцыЭксплуатации(П1 = Неопределено, ДатаВводаВЭксплуатацию, ТекДата) Экспорт
	
	Если Не ЗначениеЗаполнено(ДатаВводаВЭксплуатацию) Тогда
		Возврат 0;
	КонецЕсли;
	
	Если НачалоМесяца(ДатаВводаВЭксплуатацию) > НачалоМесяца(ТекДата) Тогда
		Возврат 0;
	КонецЕсли;
	
	КоличествоЛет		= Год(ТекДата) - Год(ДатаВводаВЭксплуатацию);
	КоличествоМесяцев	= Месяц(ТекДата) - Месяц(ДатаВводаВЭксплуатацию);
	
	СрокЭксплуатации = КоличествоЛет * 12 + КоличествоМесяцев;
	
	Возврат СрокЭксплуатации;	
	
КонецФункции

#КонецОбласти

#Область ЗаполнениеДокументов

Функция ПолучитьТаблицуОстатковВложенийВНФА(Параметры, ПоБУ = Истина, ПоНУ = Истина) Экспорт
	Перем СчетВложений;
	Перем ИФО;
	Перем КФО;
	Перем КПС;
	Перем Подразделение;
	Перем ОбъектВложений;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПериодОстатков", Параметры.ПериодОстатков);
	Запрос.УстановитьПараметр("Организация", Параметры.Организация);
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	
	Если ПоБУ Тогда
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЖурналПроводокЕПСБУОстатки.Организация КАК Организация,
		|	&ПолеИФО КАК ИФО,
		|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
		|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
		|	&ПолеПодразделение КАК Подразделение,
		|	ЖурналПроводокЕПСБУОстатки.Счет КАК СчетВложений,
		|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОбъектВложений,
		|	ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка) КАК ЦМО,
		|	ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка) КАК Договор,
		|	ЖурналПроводокЕПСБУОстатки.СуммаОстаток КАК Сумма,
		|	ЖурналПроводокЕПСБУОстатки.КоличествоОстаток КАК Количество,
		|	0 КАК СуммаАмортизации,
		|	ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка) КАК СчетАмортизации,
		|	0 КАК СуммаОбесценения
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&ПериодОстатков,
		|			Счет В (&СчетаВложенийБУ1),
		|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
		|			Организация = &Организация
		|				И &УсловиеИФО
		|				И &УсловиеКФО
		|				И &УсловиеКПС
		|				И &УсловиеПодразделение
		|				И &УсловиеНФА) КАК ЖурналПроводокЕПСБУОстатки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЖурналПроводокЕПСБУОстатки.Организация,
		|	&ПолеИФО,
		|	ЖурналПроводокЕПСБУОстатки.КФО,
		|	ЖурналПроводокЕПСБУОстатки.КПС,
		|	&ПолеПодразделение,
		|	ЖурналПроводокЕПСБУОстатки.Счет,
		|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства),
		|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.ЦМО),
		|	ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка),
		|	ЖурналПроводокЕПСБУОстатки.СуммаОстаток,
		|	ЖурналПроводокЕПСБУОстатки.КоличествоОстаток,
		|	0,
		|	ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка),
		|	0
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&ПериодОстатков,
		|			Счет В (&СчетаВложенийБУ2),
		|			&Субконто2,
		|			Организация = &Организация
		|				И &УсловиеИФО
		|				И &УсловиеКФО
		|				И &УсловиеКПС
		|				И &УсловиеПодразделение
		|				И &УсловиеНФА) КАК ЖурналПроводокЕПСБУОстатки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЖурналПроводокЕПСБУОстатки.Организация,
		|	&ПолеИФО,
		|	ЖурналПроводокЕПСБУОстатки.КФО,
		|	ЖурналПроводокЕПСБУОстатки.КПС,
		|	&ПолеПодразделение,
		|	ЖурналПроводокЕПСБУОстатки.Счет,
		|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства),
		|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.ЦМО),
		|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Справочник.Договоры),
		|	ЖурналПроводокЕПСБУОстатки.СуммаОстаток,
		|	ЖурналПроводокЕПСБУОстатки.КоличествоОстаток,
		|	0,
		|	ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка),
		|	0
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&ПериодОстатков,
		|			Счет В (&СчетаВложенийБУ3),
		|			&Субконто3,
		|			Организация = &Организация
		|				И &УсловиеИФО
		|				И &УсловиеКФО
		|				И &УсловиеКПС
		|				И &УсловиеПодразделение
		|				И &УсловиеНФА) КАК ЖурналПроводокЕПСБУОстатки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЖурналПроводокЕПСБУОстатки.Организация,
		|	&ПолеИФО,
		|	ЖурналПроводокЕПСБУОстатки.КФО,
		|	ЖурналПроводокЕПСБУОстатки.КПС,
		|	&ПолеПодразделение,
		|	ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка),
		|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства),
		|	ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка),
		|	ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка),
		|	0,
		|	0,
		|	-ЖурналПроводокЕПСБУОстатки.СуммаОстаток,
		|	ЖурналПроводокЕПСБУОстатки.Счет,
		|	0
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&ПериодОстатков,
		|			Счет В (&СчетаАмортизацииБУ),
		|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
		|			Организация = &Организация
		|				И &УсловиеИФО
		|				И &УсловиеКФО
		|				И &УсловиеКПС
		|				И &УсловиеПодразделение
		|				И &УсловиеНФА) КАК ЖурналПроводокЕПСБУОстатки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЖурналПроводокЕПСБУОстатки.Организация,
		|	&ПолеИФО,
		|	ЖурналПроводокЕПСБУОстатки.КФО,
		|	ЖурналПроводокЕПСБУОстатки.КПС,
		|	&ПолеПодразделение,
		|	ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка),
		|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства),
		|	ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка),
		|	ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка),
		|	0,
		|	0,
		|	0,
		|	ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка),
		|	-ЖурналПроводокЕПСБУОстатки.СуммаОстаток
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&ПериодОстатков,
		|			Счет В (&СчетаОбесцененияБУ),
		|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
		|			Организация = &Организация
		|				И &УсловиеИФО
		|				И &УсловиеКФО
		|				И &УсловиеКПС
		|				И &УсловиеПодразделение
		|				И &УсловиеНФА) КАК ЖурналПроводокЕПСБУОстатки";
		
		Субконто = Новый Массив;
		Субконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
		Субконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
		Запрос.УстановитьПараметр("Субконто2", Субконто);
		
		Субконто = Новый Массив;
		Субконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
		Субконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
		Субконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
		Запрос.УстановитьПараметр("Субконто3", Субконто);
		
		УказанСчетВложений = Параметры.Свойство("СчетВложений", СчетВложений) И ЗначениеЗаполнено(СчетВложений);
		Если УказанСчетВложений Тогда
			Если ТипЗнч(СчетВложений) = Тип("Массив") Тогда
				СписокСчетов = СчетВложений;
			Иначе
				СписокСчетов = Новый Массив;
				СписокСчетов.Добавить(СчетВложений);
			КонецЕсли;
		Иначе
			СписокСчетов = БухгалтерскийУчет.СписокСчетов("106.00");
		КонецЕсли;
		
		СписокСчетов1 = Новый Массив;
		СписокСчетов2 = Новый Массив;
		СписокСчетов3 = Новый Массив;
		Для Каждого Счет Из СписокСчетов Цикл
			Если БухгалтерскийУчетПовтИсп.ЕстьСубконтоСчета(Счет, ПланыВидовХарактеристик.ВидыСубконто.Договоры) Тогда
				СписокСчетов3.Добавить(Счет);
			ИначеЕсли БухгалтерскийУчетПовтИсп.ЕстьСубконтоСчета(Счет, ПланыВидовХарактеристик.ВидыСубконто.ЦМО) Тогда
				СписокСчетов2.Добавить(Счет);
			Иначе
				СписокСчетов1.Добавить(Счет);
			КонецЕсли;
		КонецЦикла;
		
		Запрос.УстановитьПараметр("СчетаВложенийБУ1"	, СписокСчетов1);
		Запрос.УстановитьПараметр("СчетаВложенийБУ2"	, СписокСчетов2);
		Запрос.УстановитьПараметр("СчетаВложенийБУ3"	, СписокСчетов3);
		Запрос.УстановитьПараметр("СчетаАмортизацииБУ"	, БухгалтерскийУчет.СписокСчетов("104.00"));
		Запрос.УстановитьПараметр("СчетаОбесцененияБУ"	, БухгалтерскийУчет.СписокСчетов("114.00"));
		
		Если ИспользоватьУчетПоИФО Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПолеИФО", "ЖурналПроводокЕПСБУОстатки.ИФО");
			Если Параметры.Свойство("ИФО", ИФО) И ЗначениеЗаполнено(ИФО) Тогда
				Запрос.УстановитьПараметр("ИФО", ИФО);
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИФО В (&ИФО)");
			Иначе
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИСТИНА");
			КонецЕсли;
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПолеИФО", "ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИСТИНА");
		КонецЕсли;
		
		Если Параметры.Свойство("КФО", КФО) И ЗначениеЗаполнено(КФО) Тогда
			Запрос.УстановитьПараметр("КФО", КФО);
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "КФО В (&КФО)");
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "ИСТИНА");
		КонецЕсли;
		
		Если Параметры.Свойство("КПС", КПС) И ЗначениеЗаполнено(КПС) Тогда
			Запрос.УстановитьПараметр("КПС", КПС);
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКПС", "КПС В (&КПС)");
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКПС", "ИСТИНА");
		КонецЕсли;
		
		ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
		Если ИспользоватьУчетПоПодразделениям Тогда
			
			Если УказанСчетВложений Тогда
				СвойстваСчетаВложений = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетВложений);
				ВедетсяУчетПоПодразделениям = ?(СвойстваСчетаВложений <> Неопределено, СвойстваСчетаВложений.УчетПоПодразделениям,
					БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("106.00").УчетПоПодразделениям);
			Иначе
				ВедетсяУчетПоПодразделениям = БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("106.00").УчетПоПодразделениям;
			КонецЕсли;
			
			Если ВедетсяУчетПоПодразделениям Тогда
				
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПолеПодразделение", "ЖурналПроводокЕПСБУОстатки.Подразделение");
				Если Параметры.Свойство("Подразделение", Подразделение) И ЗначениеЗаполнено(Подразделение) Тогда
					Запрос.УстановитьПараметр("Подразделение", Подразделение);
					Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПодразделение", "Подразделение В (&Подразделение)");
				Иначе
					Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПодразделение", "ИСТИНА");
				КонецЕсли;
				
			Иначе
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПолеПодразделение", "ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)");
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПодразделение", "ИСТИНА");
			КонецЕсли;
			
		Иначе
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПолеПодразделение", "ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)");
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПодразделение", "ИСТИНА");
			
		КонецЕсли;
	КонецЕсли;
	
	Если ПоНУ Тогда
		Если Параметры.Свойство("КФО", КФО) И ЗначениеЗаполнено(КФО) Тогда
			ОтражатьВНалоговомУчете = НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(Параметры.Организация, Параметры.Дата, КФО);
		Иначе
			ОтражатьВНалоговомУчете = НалоговыйУчетВызовСервера.ПлательщикНалогаНаПрибыль(Параметры.Организация, Параметры.Дата);
		КонецЕсли;
		Если ОтражатьВНалоговомУчете Тогда
			
			Запрос.УстановитьПараметр("СчетаВложенийНУ", БухгалтерскийУчет.СписокСчетов("Н08"));
			
			ТекстЗапросаНУ =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ОстаткиНУ.Организация КАК Организация,
			|	ОстаткиНУ.ИФО КАК ИФО,
			|	ОстаткиНУ.КФО КАК КФО,
			|	ОстаткиНУ.КПС КАК КПС,
			|	ОстаткиНУ.Подразделение КАК Подразделение,
			|	ОстаткиНУ.Счет КАК СчетВложений,
			|	ВЫРАЗИТЬ(ОстаткиНУ.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОбъектВложений,
			|	ВЫРАЗИТЬ(ОстаткиНУ.Субконто2 КАК Справочник.ЦМО) КАК ЦМО,
			|	ОстаткиНУ.СуммаОстаток КАК СуммаНУ,
			|	ОстаткиНУ.СуммаНеУчитываетсяНУОстаток КАК СуммаНеУчитываетсяНУ,
			|	ОстаткиНУ.СуммаЕНВДОстаток КАК СуммаЕНВД
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
			|			&ПериодОстатков,
			|			Счет В (&СчетаВложенийНУ),
			|			&ВидыСубконтоНУ,
			|			Организация = &Организация
			|				И &УсловиеИФО
			|				И &УсловиеКФО
			|				И &УсловиеКПС
			|				И &УсловиеПодразделение
			|				И &УсловиеНФА) КАК ОстаткиНУ";
			
			Если ИспользоватьУчетПоИФО Тогда
				ТекстЗапросаНУ = СтрЗаменить(ТекстЗапросаНУ, "&УсловиеИФО", "ИФО В (&ИФО)");
				Запрос.УстановитьПараметр("ИФО", ИФО);
			Иначе
				ТекстЗапросаНУ = СтрЗаменить(ТекстЗапросаНУ, "ОстаткиНУ.ИФО", "ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)");
				ТекстЗапросаНУ = СтрЗаменить(ТекстЗапросаНУ, "&УсловиеИФО", "ИСТИНА");
			КонецЕсли;
			
			Если Параметры.Свойство("КФО", КФО) И ЗначениеЗаполнено(КФО) Тогда
				ТекстЗапросаНУ = СтрЗаменить(ТекстЗапросаНУ, "&УсловиеКФО", "КФО В (&КФО)");
				Запрос.УстановитьПараметр("КФО", КФО);
			Иначе
				ТекстЗапросаНУ = СтрЗаменить(ТекстЗапросаНУ, "&УсловиеКФО", "ИСТИНА");
			КонецЕсли;
			
			Если НалоговыйУчетПовтИсп.ВедетсяУчетКапВложенийНУПоПодразделениям(Параметры.Дата) Тогда
				Если Параметры.Свойство("Подразделение", Подразделение) И ЗначениеЗаполнено(Подразделение) Тогда
					ТекстЗапросаНУ = СтрЗаменить(ТекстЗапросаНУ, "&УсловиеПодразделение", "Подразделение В (&Подразделение)");
					Запрос.УстановитьПараметр("Подразделение", Подразделение);
				Иначе
					ТекстЗапросаНУ = СтрЗаменить(ТекстЗапросаНУ, "&УсловиеПодразделение", "ИСТИНА");
				КонецЕсли;
			Иначе
				ТекстЗапросаНУ = СтрЗаменить(ТекстЗапросаНУ, "ОстаткиНУ.Подразделение", "ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)");
				ТекстЗапросаНУ = СтрЗаменить(ТекстЗапросаНУ, "&УсловиеПодразделение", "ИСТИНА");
			КонецЕсли;
			
			Если НалоговыйУчетПовтИсп.ВедетсяУчетКапВложенийНУПоКПС(Параметры.Дата) Тогда
				Если Параметры.Свойство("КПС", КПС) И ЗначениеЗаполнено(КПС) Тогда
					ТекстЗапросаНУ = СтрЗаменить(ТекстЗапросаНУ, "&УсловиеКПС", "КПС В (&КПС)");
					Запрос.УстановитьПараметр("КПС", КПС);
				Иначе
					ТекстЗапросаНУ = СтрЗаменить(ТекстЗапросаНУ, "&УсловиеКПС", "ИСТИНА");
				КонецЕсли;
			Иначе
				ТекстЗапросаНУ = СтрЗаменить(ТекстЗапросаНУ, "ОстаткиНУ.КПС", "ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)");
				ТекстЗапросаНУ = СтрЗаменить(ТекстЗапросаНУ, "&УсловиеКПС", "ИСТИНА");
			КонецЕсли;
			
			Если НалоговыйУчетПовтИсп.ВедетсяУчетКапВложенийНУПоЦМО(Параметры.Дата) Тогда
				ВидыСубконтоНУ = Новый Массив;
				ВидыСубконтоНУ.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
				ВидыСубконтоНУ.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
			Иначе
				ТекстЗапросаНУ = СтрЗаменить(ТекстЗапросаНУ, "ВЫРАЗИТЬ(ОстаткиНУ.Субконто2 КАК Справочник.ЦМО)", "ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка)");
				ВидыСубконтоНУ = Новый Массив;
				ВидыСубконтоНУ.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
			КонецЕсли;
			Запрос.УстановитьПараметр("ВидыСубконтоНУ", ВидыСубконтоНУ);
			
		Иначе
			
			ТекстЗапросаНУ = 
			"ВЫБРАТЬ
			|	ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка) КАК Организация,
			|	ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка) КАК ИФО,
			|	ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка) КАК КФО,
			|	ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка) КАК КПС,
			|	ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка) КАК Подразделение,
			|	ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка) КАК СчетВложений,
			|	ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка) КАК ОбъектВложений,
			|	ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка) КАК ЦМО,
			|	0 КАК СуммаНУ,
			|	0 КАК СуммаНеУчитываетсяНУ,
			|	0 КАК СуммаЕНВД
			|ГДЕ
			|	ЛОЖЬ";
			
		КонецЕсли;
		Запрос.Текст = Запрос.Текст 
			+ ?(ЗначениеЗаполнено(Запрос.Текст), ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета(), "") 
			+ ТекстЗапросаНУ;
	КонецЕсли;
	
	Если Параметры.Свойство("ОбъектВложений", ОбъектВложений) И ЗначениеЗаполнено(ОбъектВложений) Тогда
		
		Запрос.УстановитьПараметр("ОбъектВложений", ОбъектВложений);
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеНФА", "Субконто1 В (&ОбъектВложений)");
		
	Иначе
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеНФА", "ИСТИНА");
		
	КонецЕсли;
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ОстаткиВложенийВНФА = Новый Структура;
	ОстаткиВложенийВНФА.Вставить("ОстаткиБУ", Новый ТаблицаЗначений());
	ОстаткиВложенийВНФА.Вставить("ОстаткиНУ", Новый ТаблицаЗначений());

	ИДЗапроса = 0;
	Если ПоБУ Тогда
		ОстаткиВложенийВНФА.Вставить("ОстаткиБУ", РезультатЗапроса[ИДЗапроса].Выгрузить());
		ИДЗапроса = ИДЗапроса + 1;
	КонецЕсли;
	Если ПоНУ Тогда	
		ОстаткиВложенийВНФА.Вставить("ОстаткиНУ", РезультатЗапроса[ИДЗапроса].Выгрузить());
	КонецЕсли;	
	
	Возврат ОстаткиВложенийВНФА;
	
КонецФункции

// Заполняет данные капвложений на закладке "Стоимость вложений" документов принятия ОС, НМА, НПА к учету.
//
// Параметры:
//  Объект -  ДокументОбъект - документ объект, для которого ведется расчет
//  ВидДокумента - Строка - Вид документа, как он задан в конфигурации
//	ПоБУ - Булево - флаг заполнения данных по БУ
//	ПоНУ - Булево - флаг заполнения данных по НУ
Процедура ЗаполнитьКапитальныеВложенияПоОстаткам(Объект, ВидДокумента = "", ПоБУ = Истина, ПоНУ = Истина) Экспорт
	
	ЕстьНУ = Истина;
	Если ВидДокумента = "РешениеОПризнанииОбъектовОС" Тогда
		ИмяПоляСчета   = "СчетВложений";
		ОбъектВложений = Объект["КапитальноеВложение"];
	ИначеЕсли ВидДокумента = "РешениеОПризнанииОбъектовОСИК" Тогда
		ИмяПоляСчета   = "СчетВложений";
		ОбъектВложений = Объект["КапитальноеВложение"];
		ЕстьНУ         = Ложь;
	ИначеЕсли ВидДокумента = "ПринятиеКУчетуОбъектовИК" Тогда
		ИмяПоляСчета   = "СчетВложений";
		ОбъектВложений = Объект["ВнеоборотныйАктив"];
		ЕстьНУ         = Ложь;
	Иначе
		ИмяПоляСчета   = "СчетКредита";
		ОбъектВложений = Объект["ВнеоборотныйАктив"];
	КонецЕсли;	
	
	ЕстьНУ = ЕстьНУ И ПоНУ;

	ПараметрыОстатков = Новый Структура;
	ПараметрыОстатков.Вставить("Дата",				Объект.Дата);
	ПараметрыОстатков.Вставить("Организация",		Объект.Организация);
	ПараметрыОстатков.Вставить("Подразделение",		Объект.Подразделение);
	ПараметрыОстатков.Вставить("ИФО",				Объект.ИФО);
	ПараметрыОстатков.Вставить("КФО",				Объект.КФО);

	ПараметрыОстатков.Вставить("ОбъектВложений",	ОбъектВложений);
	ПараметрыОстатков.Вставить("СчетВложений",		Объект[ИмяПоляСчета]);
	ПараметрыОстатков.Вставить("ПериодОстатков",
		?(Объект.Ссылка.Пустая(), КонецДня(Объект.Дата), Объект.Ссылка.МоментВремени()));
	
	ОстаткиПоОбъектуВложений = ПолучитьТаблицуОстатковВложенийВНФА(ПараметрыОстатков, ПоБУ, ПоНУ);
		
	Если ПоБУ Тогда
		РанееНачислено = ОтраженныеСуммыПогашенияСтоимости(ПараметрыОстатков);
		
		ОстаткиБУ = ОстаткиПоОбъектуВложений.ОстаткиБУ;
		
		ПерваяСтрока = Истина;
		Объект.КапитальныеВложения.Очистить();
		
		Объект.СуммаАмортизацииВложений = 0;
		Объект.СуммаОбесцененияВложений = 0;
		
		Для Каждого СтрокаОстатковБУ Из ОстаткиБУ Цикл
			
			Если ЗначениеЗаполнено(СтрокаОстатковБУ.СуммаАмортизации) Тогда
				Объект.СуммаАмортизацииВложений = 
					Макс(СтрокаОстатковБУ.СуммаАмортизации - РанееНачислено.СуммаАмортизации, 0);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаОстатковБУ.СуммаОбесценения) Тогда
				Объект.СуммаОбесцененияВложений = 
					Макс(СтрокаОстатковБУ.СуммаОбесценения - РанееНачислено.СуммаОбесценения, 0);
			КонецЕсли;
			
			Если ПерваяСтрока Тогда
				Если Не ЗначениеЗаполнено(Объект[ИмяПоляСчета]) Тогда
					Объект[ИмяПоляСчета] = СтрокаОстатковБУ.СчетВложений;
				КонецЕсли;
				ПерваяСтрока = Ложь;
			Иначе
				Если СтрокаОстатковБУ.СчетВложений <> Объект[ИмяПоляСчета] Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			СтрокаВложений = Объект.КапитальныеВложения.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаВложений, СтрокаОстатковБУ, "ЦМО, Договор, КПС, Количество, Сумма");
			
		КонецЦикла;
		
		Если ВидДокумента <> "ПринятиеКУчетуОбъектовИК" Тогда
			Если    ВидДокумента = "РешениеОПризнанииОбъектовОС"
				ИЛИ ВидДокумента = "РешениеОПризнанииОбъектовОСИК" Тогда
				Если Объект.ВидОперации <> Перечисления.ВидыОперацийПризнанияОС.Изготовление Тогда
					Объект.КоличествоВложений = Объект.КапитальныеВложения.Итог("Количество");
				КонецЕсли;
			Иначе
				Если Объект.ВидПоступления <> Перечисления.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуИзготовление Тогда
					Объект.Количество = Объект.КапитальныеВложения.Итог("Количество");
				КонецЕсли;
			КонецЕсли;
			
			Объект.СуммаВложений = Объект.КапитальныеВложения.Итог("Сумма");
		КонецЕсли;	
	КонецЕсли;	
	
	Если НЕ ЕстьНУ Тогда
		Возврат;
	КонецЕсли;	
		
	ОстаткиНУ                     = ОстаткиПоОбъектуВложений.ОстаткиНУ;
	Объект.СуммаВложенийНУ        = ОстаткиНУ.Итог("СуммаНУ");
	Объект.РасходыНеУчитываетсяНУ = ОстаткиНУ.Итог("СуммаНеУчитываетсяНУ");
	Объект.РасходыЕНВД            = ОстаткиНУ.Итог("СуммаЕНВД");
	
	ВедетсяУчетКапВложенийНУПоКПС = НалоговыйУчетПовтИсп.ВедетсяУчетКапВложенийНУПоКПС(Объект.Дата);
	ВедетсяУчетКапВложенийНУПоЦМО = НалоговыйУчетПовтИсп.ВедетсяУчетКапВложенийНУПоЦМО(Объект.Дата);
	Если ВедетсяУчетКапВложенийНУПоКПС ИЛИ ВедетсяУчетКапВложенийНУПоЦМО Тогда
		
		Для Каждого СтрокаОстатковНУ Из ОстаткиНУ Цикл
			
			Отбор = Новый Структура;
			Если ВедетсяУчетКапВложенийНУПоКПС Тогда
				Отбор.Вставить("КПС", СтрокаОстатковНУ.КПС);
			КонецЕсли;
			Если ВедетсяУчетКапВложенийНУПоЦМО Тогда
				Отбор.Вставить("ЦМО", СтрокаОстатковНУ.ЦМО);
			КонецЕсли;
			
			НайденныеСтроки = Объект.КапитальныеВложения.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() > 0 Тогда
				СтрокаВложенийНУ = НайденныеСтроки[0];
				СтрокаВложенийНУ.СуммаНУ = СтрокаВложенийНУ.СуммаНУ + СтрокаОстатковНУ.СуммаНУ;
				СтрокаВложенийНУ.СуммаНеУчитываетсяНУ = 
					СтрокаВложенийНУ.СуммаНеУчитываетсяНУ + СтрокаОстатковНУ.СуммаНеУчитываетсяНУ;
				СтрокаВложенийНУ.СуммаЕНВД = СтрокаВложенийНУ.СуммаЕНВД + СтрокаОстатковНУ.СуммаЕНВД;
			Иначе
				СтрокаВложенийНУ = Объект.КапитальныеВложения.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаВложенийНУ, СтрокаОстатковНУ, 
					"ЦМО,КПС,СуммаНУ,СуммаНеУчитываетсяНУ,СуммаЕНВД");
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры


// Заполняет срок полезного использования для ОС в строке документа
//
// Параметры:
//  ТекущаяСтрока - СтрокаТабличнойЧасти - строка, которую заполняем
//  ВидДокумента - Строка - Вид документа, как он задан в конфигурации
Процедура УстановитьСрокПолезногоИспользованияВСтрокеТЧ(ТекущаяСтрока, ВидДокумента = "") Экспорт
	
	Если Не ЗначениеЗаполнено(ТекущаяСтрока.ОсновноеСредство) Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьНУ = Истина;
	Если ВидДокумента = "ПринятиеКУчетуОбъектовИК" Тогда
		ЕстьНУ = Ложь;
	КонецЕсли;	
	
	СрокПолезногоИспользования = УправлениеОсновнымиСредствамиКлиентСервер.РасчетСрокаПолезногоИспользования(
		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущаяСтрока.ОсновноеСредство, "АмортизационнаяГруппа"));
	
	Если Не ЗначениеЗаполнено(СрокПолезногоИспользования) Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока.СрокПолезногоИспользования = СрокПолезногоИспользования;
	Если НЕ ЕстьНУ Тогда
		Возврат;
	КонецЕсли;	

	ТекущаяСтрока.СрокПолезногоИспользованияНУ = СрокПолезногоИспользования;
	ТекущаяСтрока.СрокПолезногоИспользованияУСН = СрокПолезногоИспользования;
	
КонецПроцедуры

#Область НаименованияПечатныхФорм

// Возвращает наименование печатной формы по коду формы (ОКУД)
//
// Параметры:
//  КодФормы - Строка - код формы по ОКУД
//
// Возвращаемое значение:
//  Строка - наименование формы
Функция НаименованиеПечатнойФормы(КодФормы) Экспорт
	Возврат БухгалтерскийУчет.НаименованиеПечатнойФормы(КодФормы);
КонецФункции	

#КонецОбласти

#Область РасчетУчетныхДанныхВДокументахОС
// Функции и процедуры механизма расчета учетных данных ОС и ИК при заполнении табличной части документов списания, 
// передачи или перемещения ОС, ИК вручную, т.е. выбором ОС из справочника, а также при заполнении таб. частей 
// учетными данными по кнопке "Рассчитать". Расчет учитывает резервы ОС и ИК.

// Возвращает пустую таблицу значений для целей заполнения документов по кнопке "Рассчитать" или при выборе объекта. 
//
// Возвращаемое значение:
//  ТаблицаЗначений:
//   *ОсновноеСредство - СправочникСсылка.ОсновныеСредства
//   *ИнвентарныйНомер - СправочникСсылка.ИнвентарныеНомераОС
Функция ПустаяТаблицаОС_ДляРасчетаУчетныхДанных() Экспорт
	ТаблицаОС = Новый ТаблицаЗначений();
	ТаблицаОС.Колонки.Добавить("ОсновноеСредство", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ТаблицаОС.Колонки.Добавить("ИнвентарныйНомер", Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	
	Возврат ТаблицаОС;
КонецФункции

// Возвращает структуру, которую следует заполнить для передачи в функцию получения учетных данных для заполнения 
// документов по кнопке "Рассчитать" или при выборе объекта. 
// Если по какому-то элементу отбора нет, то его не нужно заполнять 
//
// Возвращаемое значение:
//  Структура - структура параметров отбора и данных документа   
Функция ПараметрыДляРасчетаУчетныхДанных() Экспорт
	Параметры = Новый Структура;
	Параметры.Вставить("Дата", Дата(1, 1, 1)); // дата запроса данных остатков
	Параметры.Вставить("Организация", Справочники.Организации.ПустаяСсылка());
	Параметры.Вставить("Счета", Новый Массив); // массив счетов-групп, по которым нужно рассчитать данные
	Параметры.Вставить("ИФО", Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
	Параметры.Вставить("КФО", Перечисления.КВД.ПустаяСсылка());
	Параметры.Вставить("ЦМО", Справочники.ЦМО.ПустаяСсылка());
	Параметры.Вставить("Подразделение", Справочники.Подразделения.ПустаяСсылка());
	Параметры.Вставить("ТаблицаОС", ПустаяТаблицаОС_ДляРасчетаУчетныхДанных());
	
	Возврат Параметры;
КонецФункции

Функция ТекстЗапроса_ТаблицаУчетныхДанных()
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ТаблицаОС.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОС.ИнвентарныйНомер КАК ИнвентарныйНомер
	|ПОМЕСТИТЬ ТаблицаОС
	|ИЗ
	|	&ТаблицаОС КАК ТаблицаОС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Счета.Счет КАК Счет,
	|	МАКСИМУМ(Счета.УчетПоПодразделениям) КАК УчетПоПодразделениям,
	|	МАКСИМУМ(Счета.УчетПоКПС) КАК УчетПоКПС,
	|	МАКСИМУМ(Счета.УчетПоЦМО) КАК УчетПоЦМО,
	|	МАКСИМУМ(Счета.ВидДопАналитики) КАК ВидДопАналитики,
	|	МАКСИМУМ(Счета.ВидРаспоряжения) КАК ВидРаспоряжения
	|ПОМЕСТИТЬ ТабСчетов
	|ИЗ
	|	(ВЫБРАТЬ
	|		ЕПСБУВидыСубконто.Ссылка КАК Счет,
	|		ЕПСБУВидыСубконто.Ссылка.УчетПоПодразделениям
	|		И &УчетПоПодразделениям КАК УчетПоПодразделениям,
	|		ЕПСБУВидыСубконто.Ссылка.УчетПоКПС КАК УчетПоКПС,
	|		ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦМО) КАК УчетПоЦМО,
	|		ВЫБОР
	|			КОГДА ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Договоры)
	|				ТОГДА ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Договоры)
	|			КОГДА ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Контрагенты)
	|				ТОГДА ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Контрагенты)
	|			ИНАЧЕ NULL
	|		КОНЕЦ КАК ВидДопАналитики,
	|		ВЫБОР
	|			КОГДА ПОДСТРОКА(ЕПСБУВидыСубконто.Ссылка.Код, 1, 4) В (""101."", ""102."", ""103."", ""108."")
	|			ИЛИ ПОДСТРОКА(ЕПСБУВидыСубконто.Ссылка.Код, 1, 5) = ""111.6""
	|				ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)
	|			КОГДА ПОДСТРОКА(ЕПСБУВидыСубконто.Ссылка.Код, 1, 3) = ""21.""
	|				ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ОперативныйУчет)
	|			КОГДА ПОДСТРОКА(ЕПСБУВидыСубконто.Ссылка.Код, 1, 3) = ""02.""
	|				ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаХранении)
	|			КОГДА ПОДСТРОКА(ЕПСБУВидыСубконто.Ссылка.Код, 1, 3) = ""01.""
	|				ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ПолученоВПользование)
	|		КОНЕЦ КАК ВидРаспоряжения
	|	ИЗ
	|		ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|	ГДЕ
	|		ЕПСБУВидыСубконто.Ссылка В ИЕРАРХИИ (&СчетаУчета)) КАК Счета
	|СГРУППИРОВАТЬ ПО
	|	Счета.Счет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Стоимость.ОсновноеСредство КАК ОсновноеСредство,
	|	Стоимость.ОсновноеСредство.ГрупповойУчет КАК ГрупповойУчет,
	|	Стоимость.ОсновноеСредство.ВидНФА КАК ВидНФА,
	|	Стоимость.ОсновноеСредство.ТипНФА КАК ТипНФА,
	|	Стоимость.ОсновноеСредство.СтранаПроисхождения КАК СтранаПроисхождения,
	|	Стоимость.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	Стоимость.Договор КАК Договор,
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) КАК Контрагент,
	|	Стоимость.Подразделение КАК Подразделение,
	|	Стоимость.ЦМО КАК ЦМО,
	|	СУММА(Стоимость.КоличествоОстаток) КАК Количество,
	|	СУММА(Стоимость.СтоимостьОстаток) КАК Стоимость
	|ПОМЕСТИТЬ ОстаткиРН
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(&Дата1, Организация = &Организация
	|	И ОсновноеСредство В
	|		(ВЫБРАТЬ
	|			ТаблицаОС.ОсновноеСредство
	|		ИЗ
	|			ТаблицаОС)
	|	И ВидРаспоряжения В
	|		(ВЫБРАТЬ
	|			Таб.ВидРаспоряжения
	|		ИЗ
	|			ТабСчетов КАК Таб)) КАК Стоимость
	|СГРУППИРОВАТЬ ПО
	|	Стоимость.ИнвентарныйНомер,
	|	Стоимость.ОсновноеСредство,
	|	Стоимость.Договор,
	|	Стоимость.Подразделение,
	|	Стоимость.ЦМО,
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка),
	|	Стоимость.ОсновноеСредство.ГрупповойУчет,
	|	Стоимость.ОсновноеСредство.ВидНФА,
	|	Стоимость.ОсновноеСредство.ТипНФА,
	|	Стоимость.ОсновноеСредство.СтранаПроисхождения
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СтоимостьПоКонтрагентам.ОсновноеСредство,
	|	СтоимостьПоКонтрагентам.ОсновноеСредство.ГрупповойУчет,
	|	СтоимостьПоКонтрагентам.ОсновноеСредство.ВидНФА,
	|	СтоимостьПоКонтрагентам.ОсновноеСредство.ТипНФА,
	|	СтоимостьПоКонтрагентам.ОсновноеСредство.СтранаПроисхождения,
	|	СтоимостьПоКонтрагентам.ИнвентарныйНомер,
	|	СтоимостьПоКонтрагентам.Договор,
	|	СтоимостьПоКонтрагентам.Контрагент,
	|	СтоимостьПоКонтрагентам.Подразделение,
	|	СтоимостьПоКонтрагентам.ЦМО,
	|	СУММА(СтоимостьПоКонтрагентам.КоличествоОстаток),
	|	СУММА(СтоимостьПоКонтрагентам.СтоимостьОстаток)
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОСПоКонтрагентам.Остатки(&Дата1, Организация = &Организация
	|	И ОсновноеСредство В
	|		(ВЫБРАТЬ
	|			ТаблицаОС.ОсновноеСредство
	|		ИЗ
	|			ТаблицаОС)
	|	И ВидРаспоряжения В
	|		(ВЫБРАТЬ
	|			Таб.ВидРаспоряжения
	|		ИЗ
	|			ТабСчетов КАК Таб)) КАК СтоимостьПоКонтрагентам
	|СГРУППИРОВАТЬ ПО
	|	СтоимостьПоКонтрагентам.ИнвентарныйНомер,
	|	СтоимостьПоКонтрагентам.ОсновноеСредство,
	|	СтоимостьПоКонтрагентам.Договор,
	|	СтоимостьПоКонтрагентам.Контрагент,
	|	СтоимостьПоКонтрагентам.Подразделение,
	|	СтоимостьПоКонтрагентам.ЦМО,
	|	СтоимостьПоКонтрагентам.ОсновноеСредство.ГрупповойУчет,
	|	СтоимостьПоКонтрагентам.ОсновноеСредство.ВидНФА,
	|	СтоимостьПоКонтрагентам.ОсновноеСредство.ТипНФА,
	|	СтоимостьПоКонтрагентам.ОсновноеСредство.СтранаПроисхождения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	АмортизацияОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	АмортизацияОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СУММА(АмортизацияОбъектовОСОстатки.СуммаАмортизацииОстаток) КАК СуммаАмортизации,
	|	СУММА(АмортизацияОбъектовОСОстатки.СуммаОбесцененияОстаток) КАК СуммаОбесценения
	|ПОМЕСТИТЬ ТаблицаАмортизации
	|ИЗ
	|	РегистрНакопления.АмортизацияОбъектовОС.Остатки(&Дата1, Организация = &Организация
	|	И ОсновноеСредство В
	|		(ВЫБРАТЬ
	|			ТаблицаОС.ОсновноеСредство
	|		ИЗ
	|			ТаблицаОС)) КАК АмортизацияОбъектовОСОстатки
	|СГРУППИРОВАТЬ ПО
	|	АмортизацияОбъектовОСОстатки.ИнвентарныйНомер,
	|	АмортизацияОбъектовОСОстатки.ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОсновноеСредство,
	|	ЕСТЬNULL(ОстаткиРН.ИнвентарныйНомер, ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)) КАК ИнвентарныйНомер,
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|	ЕСТЬNULL(ТабСчетов.УчетПоКПС, ЛОЖЬ) КАК УчетПоКПС,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) КАК КПС,
	|	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК ЦМО,
	|	ЖурналПроводокЕПСБУОстатки.ИФО КАК ИФО,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК
	|		Подразделение,
	|	NULL КАК ДопАналитика,
	|	ЕСТЬNULL(ОстаткиРН.ГрупповойУчет, ЛОЖЬ) КАК ГрупповойУчет,
	|	ЕСТЬNULL(ОстаткиРН.ВидНФА, ЗНАЧЕНИЕ(Перечисление.ВидыНФА.ПустаяСсылка)) КАК ВидНФА,
	|	ЕСТЬNULL(ОстаткиРН.ТипНФА, ЗНАЧЕНИЕ(Перечисление.ТипыНФА.ПустаяСсылка)) КАК ТипНФА,
	|	ЕСТЬNULL(ОстаткиРН.СтранаПроисхождения, ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)) КАК СтранаПроисхождения,
	|	ЕСТЬNULL(ОстаткиРН.Количество, ЖурналПроводокЕПСБУОстатки.КоличествоОстаток) КАК Количество,
	|	ЕСТЬNULL(ОстаткиРН.Стоимость, ЖурналПроводокЕПСБУОстатки.СуммаОстаток) КАК Сумма
	|ПОМЕСТИТЬ ОстаткиБУ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&Дата1, Счет В
	|		(ВЫБРАТЬ
	|			ТабСчетов.Счет
	|		ИЗ
	|			ТабСчетов
	|		ГДЕ
	|			ТабСчетов.УчетПоЦМО
	|			И ТабСчетов.ВидДопАналитики ЕСТЬ NULL), &СубконтоОС_ЦМО, Организация = &Организация
	|	И Субконто1 В
	|		(ВЫБРАТЬ
	|			ТаблицаОС.ОсновноеСредство
	|		ИЗ
	|			ТаблицаОС)
	|	И (&НетОтбораПоИФО
	|	ИЛИ ИФО = &ИФО)
	|	И (&НетОтбораПоКФО
	|	ИЛИ КФО = &КФО)
	|	И (&НетОтбораПоЦМО
	|	ИЛИ Субконто2 = &ЦМО)) КАК ЖурналПроводокЕПСБУОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиРН КАК ОстаткиРН
	|		ПО ЖурналПроводокЕПСБУОстатки.Субконто1 = ОстаткиРН.ОсновноеСредство
	|		И ЖурналПроводокЕПСБУОстатки.Субконто2 = ОстаткиРН.ЦМО
	|		И ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Подразделение,
	|			ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) = ОстаткиРН.Подразделение
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТабСчетов КАК ТабСчетов
	|		ПО ЖурналПроводокЕПСБУОстатки.Счет = ТабСчетов.Счет
	|ГДЕ
	|	НЕ (ТабСчетов.УчетПоПодразделениям
	|	И &УчетПоПодразделениям)
	|	ИЛИ ЖурналПроводокЕПСБУОстатки.Подразделение = &Подразделение
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.Субконто1,
	|	ЕСТЬNULL(ОстаткиРН.ИнвентарныйНомер, ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)),
	|	ЖурналПроводокЕПСБУОстатки.Счет,
	|	ЕСТЬNULL(ТабСчетов.УчетПоКПС, ЛОЖЬ),
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)),
	|	ЖурналПроводокЕПСБУОстатки.Субконто2,
	|	ЖурналПроводокЕПСБУОстатки.ИФО,
	|	ЖурналПроводокЕПСБУОстатки.КФО,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)),
	|	ЖурналПроводокЕПСБУОстатки.Субконто3,
	|	ЕСТЬNULL(ОстаткиРН.ГрупповойУчет, ЛОЖЬ),
	|	ЕСТЬNULL(ОстаткиРН.ВидНФА, ЗНАЧЕНИЕ(Перечисление.ВидыНФА.ПустаяСсылка)),
	|	ЕСТЬNULL(ОстаткиРН.ТипНФА, ЗНАЧЕНИЕ(Перечисление.ТипыНФА.ПустаяСсылка)),
	|	ЕСТЬNULL(ОстаткиРН.СтранаПроисхождения, ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)),
	|	ЕСТЬNULL(ОстаткиРН.Количество, ЖурналПроводокЕПСБУОстатки.КоличествоОстаток),
	|	ЕСТЬNULL(ОстаткиРН.Стоимость, ЖурналПроводокЕПСБУОстатки.СуммаОстаток)
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&Дата1, Счет В
	|		(ВЫБРАТЬ
	|			ТабСчетов.Счет
	|		ИЗ
	|			ТабСчетов
	|		ГДЕ
	|			ТабСчетов.УчетПоЦМО
	|			И ТабСчетов.ВидДопАналитики = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Договоры)), &СубконтоОС_ЦМО_Договоры,
	|		Организация = &Организация
	|	И Субконто1 В
	|		(ВЫБРАТЬ
	|			ТаблицаОС.ОсновноеСредство
	|		ИЗ
	|			ТаблицаОС)
	|	И (&НетОтбораПоИФО
	|	ИЛИ ИФО = &ИФО)
	|	И (&НетОтбораПоКФО
	|	ИЛИ КФО = &КФО)
	|	И (&НетОтбораПоЦМО
	|	ИЛИ Субконто2 = &ЦМО)) КАК ЖурналПроводокЕПСБУОстатки
