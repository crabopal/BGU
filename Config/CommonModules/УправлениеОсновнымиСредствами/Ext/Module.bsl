// Общие процедуры и функции

Процедура ЗаполнитьОтчетИмущество_2020Кв4(ПараметрыОтчета, Контейнер)
	
	ТаблицаРасшифровки = Неопределено;
	
	НалоговыйОрган = РегламентированнаяОтчетность.ПолучитьПоКодамРегистрациюВИФНС(
		ПараметрыОтчета.Организация, ПараметрыОтчета.КодНалоговогоОргана, ПараметрыОтчета.КПП);
	ПараметрыОтчета.Вставить("НалоговыйОрган", НалоговыйОрган);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", ПараметрыОтчета.Организация);
	Запрос.УстановитьПараметр("ОтчетныйПериод", ПараметрыОтчета.мДатаКонцаПериодаОтчета);
	Запрос.УстановитьПараметр("НалоговыйОрган", ПараметрыОтчета.НалоговыйОрган);

	// Раздел 1

	Запрос.Текст = ТекстЗапросаАвансыИмущество();
	РезультатЗапроса = Запрос.Выполнить();
	
	ГруппыСтрокРаздела1 = Контейнер.Раздел1.Строки[0].ДанныеМногострочныхЧастей.П0000100.Строки;
  	ОчиститьРаздел(ГруппыСтрокРаздела1);

	ПерваяГруппаСтрок   = Истина;
	
	ВыборкаАвансыПоОКТМО = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаАвансыПоОКТМО.Следующий() Цикл
		ВыборкаАвансыПоКБК = ВыборкаАвансыПоОКТМО.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаАвансыПоКБК.Следующий() Цикл

			Если ПерваяГруппаСтрок Тогда
				ГруппаСтрокРаздела1 = ГруппыСтрокРаздела1[0];
			Иначе
				ДанныеГруппыСтрокРаздела1 = Новый Структура;
				Для Каждого Показатель Из ГруппаСтрокРаздела1.Данные Цикл
					ДанныеГруппыСтрокРаздела1.Вставить(Показатель.Ключ,
						ОбщегоНазначенияБГУКлиентСервер.ПустоеЗначениеТипа(ТипЗнч(Показатель.Значение)));
				КонецЦикла;
				ГруппаСтрокРаздела1 = ГруппыСтрокРаздела1.Добавить();
				ГруппаСтрокРаздела1.Данные = ДанныеГруппыСтрокРаздела1;
				ГруппаСтрокРаздела1.ДанныеМногострочныхЧастей = Новый Структура;
			КонецЕсли;

			ПерваяГруппаСтрок = Ложь;

			ГруппаСтрокРаздела1.Данные.П000010001003 = СокрЛП(ВыборкаАвансыПоКБК.КодПоОКТМО);
			ГруппаСтрокРаздела1.Данные.П000010002003 = СокрЛП(ВыборкаАвансыПоКБК.КБК);
			ГруппаСтрокРаздела1.Данные.П000010002303 = ВыборкаАвансыПоКБК.СуммаАвансовыхПлатежей1Кв;
			ГруппаСтрокРаздела1.Данные.П000010002503 = ВыборкаАвансыПоКБК.СуммаАвансовыхПлатежей2Кв;
			ГруппаСтрокРаздела1.Данные.П000010002703 = ВыборкаАвансыПоКБК.СуммаАвансовыхПлатежей3Кв;
			
			НомерГруппы = ГруппыСтрокРаздела1.Количество();
			ШаблонПоказателя = НСтр("ru = 'Раздел 1, код по ОКТМО %1, код строки %2'");
			НаименованиеПоказателя023 = СтрШаблон(ШаблонПоказателя, СокрЛП(ВыборкаАвансыПоКБК.КодПоОКТМО), "023");
			НаименованиеПоказателя025 = СтрШаблон(ШаблонПоказателя, СокрЛП(ВыборкаАвансыПоКБК.КодПоОКТМО), "025");
			НаименованиеПоказателя027 = СтрШаблон(ШаблонПоказателя, СокрЛП(ВыборкаАвансыПоКБК.КодПоОКТМО), "027");
			
			ДетальныеЗаписи = ВыборкаАвансыПоКБК.Выбрать();
			Пока ДетальныеЗаписи.Следующий() Цикл
				ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки,
					"Раздел1",
					"П000010002303_" + НомерГруппы,
					НаименованиеПоказателя023,
					ДетальныеЗаписи.ОсновноеСредствоНаименование,
					ДетальныеЗаписи.СуммаАвансовыхПлатежей1Кв,
					Неопределено,
					Ложь,
					Новый Структура("Ссылка", ДетальныеЗаписи.ОсновноеСредство));
				ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки,
					"Раздел1",
					"П000010002503_" + НомерГруппы,
					НаименованиеПоказателя025,
					ДетальныеЗаписи.ОсновноеСредствоНаименование,
					ДетальныеЗаписи.СуммаАвансовыхПлатежей2Кв,
					Неопределено,
					Ложь,
					Новый Структура("Ссылка", ДетальныеЗаписи.ОсновноеСредство));
				ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки,
					"Раздел1",
					"П000010002703_" + НомерГруппы,
					НаименованиеПоказателя027,
					ДетальныеЗаписи.ОсновноеСредствоНаименование,
					ДетальныеЗаписи.СуммаАвансовыхПлатежей3Кв,
					Неопределено,
					Ложь,
					Новый Структура("Ссылка", ДетальныеЗаписи.ОсновноеСредство));
			КонецЦикла;

		КонецЦикла;
	КонецЦикла; 
	
	// Раздел 2
	
	НалогНаИмуществоОбъединятьЛисты = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(
		ПараметрыОтчета.Организация, ПараметрыОтчета.мДатаКонцаПериодаОтчета).НалогНаИмуществоОбъединятьЛисты;
	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = ТекстЗапросаРасчетНалогаНаИмуществоПоДаннымРегистра();
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		ПараметрыРасчета = РасчетИмущественныхНалогов.ПараметрыРасчетаНалогаНаИмущество();
		ПараметрыРасчета.Организация = ПараметрыОтчета.Организация;
		ПараметрыРасчета.ОтчетныйПериод = ПараметрыОтчета.мДатаКонцаПериодаОтчета;
		ТаблицаРасчетаПоСреднегодовой = РасчетИмущественныхНалогов.ТаблицаРасчетаПоСреднегодовой(ПараметрыРасчета);
		Запрос.УстановитьПараметр("ТаблицаРасчетаПоСреднегодовой", ТаблицаРасчетаПоСреднегодовой);
		Запрос.Текст = ТекстЗапросаДобавитьРасчетНалогаПоДаннымРасчета();
		Запрос.Выполнить();
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапросаРаздел2Имущество();
	Выборка = Запрос.Выполнить().Выбрать();
	
	Раздел2 = Контейнер.Раздел2;
	ОчиститьРаздел(Раздел2);
	СтраницаРаздел2 = Раздел2.Строки[0].Данные;
	
	КодВидаИмущества = "";
	КодПоОКТМО = "";
	ДоляСтоимостиЧислитель = 0;
	ДоляСтоимостиЗнаменатель = 0;
	НалоговаяСтавка = 0;

	НомерСтраницы = 1;
	ПерваяСтраница = Истина;

	ИменаКолонокОстаточнаяСтоимость = РасчетИмущественныхНалогов.ИменаКолонокОстаточнаяСтоимость();
	ШаблонПоказателя = НСтр("ru = 'Раздел 2, страница %1, код строки %2, колонка %3'");
	ШаблонСлагаемого = НСтр("ru = '%1, инв. номер %2'");
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Группировка() = "КодОснованияЛьготы" Тогда // нижний уровень группировки перед детальными записями
			
			Если Не ПерваяСтраница Тогда
				
				// При включении соответствующей настройки данные в разделе 2 группируем по набору несуммовых показателей расчета.
				// Суммовые показатели при этом суммируются.
				// Если применяется не более 1 льготы данные умещаются на 1 листе раздела 2.
				// Варианты сложения:
				// Льгота не применяется + Освобождается от налогообложения 1 льгота по строке 160
				// Освобождается от налогообложения 1 льгота 160 + Снижение ставки 1 льгота 200
				// Освобождается от налогообложения 1 льгота 160 + Снижение суммы налога 1 льгота 230

				МожноОбъединитьЛистыРаздела2 = НалогНаИмуществоОбъединятьЛисты
					И КодВидаИмущества = Выборка.КодВидаИмущества
					И КодПоОКТМО = Выборка.КодПоОКТМО
					И ДоляСтоимостиЧислитель = Выборка.ДоляСтоимостиЧислитель
					И ДоляСтоимостиЗнаменатель = Выборка.ДоляСтоимостиЗнаменатель 
					И НалоговаяСтавка = Выборка.НалоговаяСтавка
					И Выборка.КоличествоЛьготОсвобождениеОтНалогообложения < 2
					И Выборка.КоличествоОснованийЛьготы160 < 2;
					
				ЭтоСнижениеСтавки = Выборка.ПорядокЛьготы = 2;
				ЭтоСнижениеСуммы = Выборка.ПорядокЛьготы = 3;

				Если МожноОбъединитьЛистыРаздела2 И ЭтоСнижениеСтавки Тогда
					
					МожноОбъединитьЛистыРаздела2 = Выборка.КоличествоОснованийЛьготы200 = 1
						И Не Выборка.ЕстьИмуществоБезЛьгот;
				
				КонецЕсли;	
					
				Если МожноОбъединитьЛистыРаздела2 И ЭтоСнижениеСуммы Тогда
					
					МожноОбъединитьЛистыРаздела2 = Выборка.КоличествоОснованийЛьготы230 = 1
						И Выборка.КоличествоОснованийЛьготы200 = 0
						И Не Выборка.ЕстьИмуществоБезЛьгот;					
					
				КонецЕсли;
				
				Если Не МожноОбъединитьЛистыРаздела2 Тогда
					
					// Создаем дополнительную страницу в декларации
					СтруктураНовойТаблицы = Новый Структура;
					Для Каждого Показатель Из СтраницаРаздел2 Цикл
						СтруктураНовойТаблицы.Вставить(Показатель.Ключ,
							ОбщегоНазначенияБГУКлиентСервер.ПустоеЗначениеТипа(ТипЗнч(Показатель.Значение)));
					КонецЦикла;

					НоваяСтраницаРаздела2 = Раздел2.Строки.Добавить();
					НоваяСтраницаРаздела2.Данные = СтруктураНовойТаблицы;
					НоваяСтраницаРаздела2.ДанныеМногострочныхЧастей = Новый Структура;

					НомерСтраницы = Раздел2.Строки.Количество();

				КонецЕсли;
				
			Иначе
				ПерваяСтраница = Ложь;
			КонецЕсли;
			
			СтраницаРаздел2 = Раздел2.Строки[Раздел2.Строки.Количество() - 1].Данные;
			
			КодВидаИмущества = Выборка.КодВидаИмущества;
			
			Если КодВидаИмущества = "01" Тогда
				КБК = "18210602020021000110";
			Иначе
				КБК = "18210602010021000110";
			КонецЕсли;
			
			СтраницаРаздел2.П000020000101 = КодВидаИмущества;
			СтраницаРаздел2.П000020001001 = Выборка.КодПоОКТМО;
			СтраницаРаздел2.П000020001100 = КБК;
			
			Если Выборка.ПорядокЛьготы = 1 Тогда
				СтраницаРаздел2.П000020016003_КодЛьготы = Выборка.КодНалоговойЛьготыОсвобождениеОтНалогообложения;
				СтраницаРаздел2.П000020016003_Основание = Выборка.КодОснованияЛьготы;
			ИначеЕсли Выборка.ПорядокЛьготы = 2 Тогда
				СтраницаРаздел2.П000020020003_КодЛьготы = "2012400";
				СтраницаРаздел2.П000020020003_Основание = Выборка.КодОснованияЛьготы;
			ИначеЕсли Выборка.ПорядокЛьготы = 3 Тогда
				СтраницаРаздел2.П000020023003_КодЛьготы = "2012500";
				СтраницаРаздел2.П000020023003_Основание = Выборка.КодОснованияЛьготы;
			КонецЕсли;
			
			СтраницаРаздел2.П000020021003 = Выборка.НалоговаяСтавка;
			
			Если КодВидаИмущества = "02" Тогда
				СтраницаРаздел2.П000020018003_Числ = ?(Выборка.ДоляСтоимостиЧислитель = 0, 1, Выборка.ДоляСтоимостиЧислитель);
				СтраницаРаздел2.П000020018003_Знам = ?(Выборка.ДоляСтоимостиЗнаменатель = 0, 1, Выборка.ДоляСтоимостиЗнаменатель);
			КонецЕсли;
			
			ОсвобождениеОтНалогообложения = Выборка.ПорядокЛьготы = 1;
				
			Для НомерПериода = 1 По 13 Цикл

				Префикс = "П0000200" + Формат(НомерПериода + 1, "ЧЦ=2; ЧВН=");
				Значение = Выборка[ИменаКолонокОстаточнаяСтоимость[НомерПериода - 1]];
				СтраницаРаздел2[Префикс + "003"] = Число(СтраницаРаздел2[Префикс + "003"]) + Значение;

				Если ОсвобождениеОтНалогообложения Тогда
					СтраницаРаздел2[Префикс + "004"] = Число(СтраницаРаздел2[Префикс + "004"]) + Значение;
				КонецЕсли;

			КонецЦикла;

			СтраницаРаздел2.П000020024003 = Число(СтраницаРаздел2.П000020024003) + Выборка.СуммаУменьшенияСуммыНалога;

			КодВидаИмущества = Выборка.КодВидаИмущества; 
			КодПоОКТМО = Выборка.КодПоОКТМО;
			ДоляСтоимостиЧислитель = Выборка.ДоляСтоимостиЧислитель;
			ДоляСтоимостиЗнаменатель = Выборка.ДоляСтоимостиЗнаменатель;
			НалоговаяСтавка = Выборка.НалоговаяСтавка;

		ИначеЕсли Выборка.ТипЗаписи() = ТипЗаписиЗапроса.ДетальнаяЗапись Тогда

			НаименованиеСлагаемого = СтрШаблон(ШаблонСлагаемого, Выборка.НаименованиеОС, СокрЛП(Выборка.ИнвНомерКод));
			ОсвобождениеОтНалогообложения = Выборка.ПорядокЛьготы = 1;
			
			Для НомерПериода = 1 По 13 Цикл

				Префикс = "П0000200" + Формат(НомерПериода + 1, "ЧЦ=2; ЧВН=");
				КодСтроки = Формат(10 + НомерПериода * 10, "ЧЦ=3; ЧВН=");
				НаименованиеПоказателя = СтрШаблон(ШаблонПоказателя, НомерСтраницы,	КодСтроки, "");
				Значение = Выборка[ИменаКолонокОстаточнаяСтоимость[НомерПериода - 1]];
				
				ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки,
					"Раздел2",
					Префикс + "003_" + Формат(НомерСтраницы, "ЧН=; ЧГ=;"),
					НаименованиеПоказателя + "3",
					НаименованиеСлагаемого,
					Значение,
					Неопределено,
					Истина,
					Новый Структура("Ссылка", Выборка.ОсновноеСредство));
					
				Если ОсвобождениеОтНалогообложения Тогда

					ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки,
						"Раздел2",
						Префикс + "004_" + Формат(НомерСтраницы, "ЧН=; ЧГ=;"),
						НаименованиеПоказателя + "4",
						НаименованиеСлагаемого,
						Значение,
						Неопределено,
						Истина,
						Новый Структура("Ссылка", Выборка.ОсновноеСредство));

				КонецЕсли;	
			КонецЦикла;
			
			ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки,
				"Раздел2",
				"П000020024003_" + Формат(НомерСтраницы, "ЧН=; ЧГ=;"),
				СтрШаблон(НСтр("ru = 'Раздел 2, страница %1, код строки 240'"), НомерСтраницы),
				НаименованиеСлагаемого,
				Выборка.СуммаУменьшенияСуммыНалога,
				Неопределено,
				Ложь,
				Новый Структура("Ссылка", Выборка.ОсновноеСредство));
			
		КонецЕсли;
	КонецЦикла;
	
	// Раздел 2.1

	Запрос.УстановитьПараметр("Организация", ПараметрыОтчета.Организация);
	Запрос.УстановитьПараметр("Период", ПараметрыОтчета.мДатаКонцаПериодаОтчета);
	Запрос.УстановитьПараметр("ПериодОстатки", ПараметрыОтчета.мДатаКонцаПериодаОтчета + 1);
	Запрос.Текст = ТекстЗапросаРаздел21Имущество();
	Выборка = Запрос.Выполнить().Выбрать();
	
	Раздел21 = Контейнер.Раздел21;
	СтраницаРаздел21 = Раздел21.Строки[0].Данные;
	
	ОчиститьРаздел(Раздел21);
	
	Раздел21.Строки[0].ДанныеМногострочныхЧастей.П00021М1.Строки.Очистить();
	СтраницаРаздел21Здание = НоваяСтрокаРаздел21Здание(Раздел21.Строки[0].ДанныеМногострочныхЧастей.П00021М1).Данные;
	
	НомерСтраницы = 1;
	
	Пока Выборка.Следующий() Цикл

		Если НомерСтраницы > 1 Тогда

			СтруктураНовойТаблицы = Новый Структура;
			Для Каждого Показатель Из СтраницаРаздел21 Цикл
				СтруктураНовойТаблицы.Вставить(Показатель.Ключ, ОбщегоНазначенияБГУКлиентСервер.ПустоеЗначениеТипа(
					ТипЗнч(Показатель.Значение)));
			КонецЦикла;

			ЧастиЗдания = Новый ДеревоЗначений;
			ЧастиЗдания.Колонки.Добавить("Данные");
			ЧастиЗдания.Колонки.Добавить("ДанныеМногострочныхЧастей");

			НоваяСтраницаРаздела21 = Раздел21.Строки.Добавить();
			НоваяСтраницаРаздела21.Данные = СтруктураНовойТаблицы;
			НоваяСтраницаРаздела21.ДанныеМногострочныхЧастей = Новый Структура("П00021М1", ЧастиЗдания);

			СтраницаРаздел21 = НоваяСтраницаРаздела21.Данные;
			СтраницаРаздел21Здание = НоваяСтрокаРаздел21Здание(
				НоваяСтраницаРаздела21.ДанныеМногострочныхЧастей.П00021М1).Данные;

		КонецЕсли;

		Если ЗначениеЗаполнено(Выборка.КадастровыйНомер) Тогда
			НомерОбъекта = Выборка.КадастровыйНомер;
			КодНомераОбъекта = "1";
		ИначеЕсли ЗначениеЗаполнено(Выборка.ИнвентарныйНомер) Тогда
			НомерОбъекта = Выборка.ИнвентарныйНомер;
			Если ЗначениеЗаполнено(Выборка.Адрес) Тогда
				КодНомераОбъекта = "3";
			Иначе
				КодНомераОбъекта = "4";
			КонецЕсли;
		Иначе
			НомерОбъекта = "";
			КодНомераОбъекта = "";
		КонецЕсли;

		Если Выборка.КодВидаИмущества = "01" Тогда
			КБК = "18210602020021000110";
		Иначе
			КБК = "18210602010021000110";
		КонецЕсли;
		
		// Заполнение строки 040 согласно комментарию к Письму ФНС России от 24.08.2017 N БС-4-21/16786@
		КодПоОКОФ = СокрЛП(Выборка.КодПоОКОФ);
		Если СтрДлина(КодПоОКОФ) = 10 И Сред(КодПоОКОФ, 3, 1) = " " Тогда
			КодПоОКОФ = СтрЗаменить(КодПоОКОФ, " ", "");
			КодПоОКОФ = Сред(КодПоОКОФ, 1, 3) + "." + Сред(КодПоОКОФ, 4, 2) + "." + Сред(КодПоОКОФ, 6, 2) + "." + Сред(
				КодПоОКОФ, 8, 2);
		КонецЕсли;

		СтраницаРаздел21.Вставить("П000210001000", Выборка.КодПоОКТМО);
		СтраницаРаздел21.Вставить("П000210001100", КБК);
		СтраницаРаздел21.Вставить("П000210001001", КодНомераОбъекта);
		СтраницаРаздел21.Вставить("П000210002001", НомерОбъекта);
		СтраницаРаздел21.Вставить("П000210004003", КодПоОКОФ);
		СтраницаРаздел21.Вставить("П000210005003", Выборка.ОстаточнаяСтоимостьНа3112);

		Если КодНомераОбъекта = "3" Тогда
			ЗаполнитьСтроку030(Раздел21, СтраницаРаздел21, СтраницаРаздел21Здание, Выборка.Адрес);
		КонецЕсли;

		НаименованиеСлагаемого = СтрШаблон(ШаблонСлагаемого, Выборка.НаименованиеОС, СокрЛП(Выборка.ИнвНомерКод));

		// Расшифровка в поле "Номер объекта"
		ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки,
			"Раздел21",
			"П000210002001_" + Формат(НомерСтраницы, "ЧН=; ЧГ=;"),
			СтрШаблон(НСтр("ru = 'Раздел 2.1, страница %1, код строки 020'"), НомерСтраницы),
			НаименованиеСлагаемого,
			Выборка.ОстаточнаяСтоимостьНа3112,
			Неопределено,
			Истина,
			Новый Структура("Ссылка", Выборка.ОсновноеСредство));

		// Расшифровка в поле "Остаточная стоимость"
		ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки,
			"Раздел21",
			"П000210005003_" + Формат(НомерСтраницы, "ЧН=; ЧГ=;"),
			СтрШаблон(НСтр("ru = 'Раздел 2.1, страница %1, код строки 050'"), НомерСтраницы),
			НаименованиеСлагаемого,
			Выборка.ОстаточнаяСтоимостьНа3112,
			Неопределено,
			Истина,
			Новый Структура("Ссылка", Выборка.ОсновноеСредство));

		НомерСтраницы = НомерСтраницы + 1;

	КонецЦикла;
	
	// Раздел 3
	
	ОчиститьРаздел(Контейнер.Раздел3);
	
	// Раздел 4
	
	ОчиститьРаздел(Контейнер.Раздел4);
	СтрокаРаздела4 = Контейнер.Раздел4.Строки[0].ДанныеМногострочныхЧастей.П00004М1.Строки[0].Данные;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.УстановитьПараметр("Организация", ПараметрыОтчета.Организация);
	Запрос.УстановитьПараметр("ОтчетныйПериод", ПараметрыОтчета.мДатаКонцаПериодаОтчета);
	
	Запрос.Текст = ТекстЗапросаРаздел4ОтборДвижимогоИмущества();
	Запрос.Выполнить();
	
	НачалоПериода = НачалоГода(ПараметрыОтчета.мДатаКонцаПериодаОтчета);
	
	Для Счетчик = 0 По 12 Цикл
		
		Запрос.УстановитьПараметр("Период", ДобавитьМесяц(НачалоПериода, Счетчик));
		Запрос.Текст = ТекстЗапросаОстаточнаяСтоимостьДвижимогоИмущества();

		//@skip-check query-in-loop
		Запрос.Выполнить();
		
	КонецЦикла;
	
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ВТОстаточнаяСтоимость.ОсновноеСредство КАК ОсновноеСредство,
		|	ОсновныеСредства.Наименование КАК НаименованиеОС,
		|	ВЫРАЗИТЬ(СУММА(ВТОстаточнаяСтоимость.СуммаОстаток) / 13 КАК ЧИСЛО(18, 2)) КАК СреднегодоваяСтоимость
		|ИЗ
		|	ВТОстаточнаяСтоимость КАК ВТОстаточнаяСтоимость
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОсновныеСредства КАК ОсновныеСредства
		|		ПО ВТОстаточнаяСтоимость.ОсновноеСредство = ОсновныеСредства.Ссылка
		|СГРУППИРОВАТЬ ПО
		|	ВТОстаточнаяСтоимость.ОсновноеСредство,
		|	ОсновныеСредства.Наименование
		|
		|УПОРЯДОЧИТЬ ПО
		|	НаименованиеОС
		|ИТОГИ
		|	СУММА(СреднегодоваяСтоимость)
		|ПО
		|	ОБЩИЕ";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда

		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		КодСубъектаРФ = ?(ЗначениеЗаполнено(Выборка.СреднегодоваяСтоимость),
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыОтчета.Организация, "СубъектРФ.КодДляНалогов"),
			"");

		СтрокаРаздела4.Вставить("П00004М100001", КодСубъектаРФ);
		СтрокаРаздела4.Вставить("П00004М100002", Выборка.СреднегодоваяСтоимость);
		
		ПредельноеКоличествоЗаписейРасшифровкиДвижимогоИмущества =
			ПредельноеКоличествоЗаписейРасшифровкиДвижимогоИмущества();
		
		ВывелиЗаписей = 0;
		СуммаОсталось = Выборка.СреднегодоваяСтоимость;
		
		Пока Выборка.Следующий() Цикл

			ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки,
				"Раздел4",
				"П00004М100002_1",
				НСтр("ru = 'Раздел 4, строка 1, колонка 2'"),
				Выборка.НаименованиеОС,
				Выборка.СреднегодоваяСтоимость,
				Неопределено,
				Истина,
				Новый Структура("Ссылка", Выборка.ОсновноеСредство));

			ВывелиЗаписей = ВывелиЗаписей + 1;
			СуммаОсталось = СуммаОсталось - Выборка.СреднегодоваяСтоимость;

			Если ВывелиЗаписей >= ПредельноеКоличествоЗаписейРасшифровкиДвижимогоИмущества Тогда
				
				ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки,
					"Раздел4",
					"П00004М100002_1",
					НСтр("ru = 'Раздел 4, строка 1, колонка 2'"),
					НСтр("ru = 'Другие объекты движимого имущества'"),
					СуммаОсталось,
					Неопределено,
					Ложь);
				
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// Сохранение результата
	
	ПоместитьВоВременноеХранилище(Контейнер, ПараметрыОтчета.АдресВоВременномХранилище);
	ПоместитьВоВременноеХранилище(ТаблицаРасшифровки, ПараметрыОтчета.АдресВременногоХранилищаРасшифровки);
	
КонецПроцедуры

