	|	ЕСТЬNULL(ПараметрыАмортизационнойПремииНалоговыйУчет.СубконтоРасходов3, НЕОПРЕДЕЛЕНО) КАК Субконто3РасходовПоАмортизационнойПремии,
	|	ЕСТЬNULL(ПараметрыАмортизационнойПремииНалоговыйУчет.Регистратор, НЕОПРЕДЕЛЕНО) КАК ДокументАмортизационнойПремии
	|ИЗ
	|	Справочник.ОсновныеСредства КАК ОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ АмортизацияОС КАК АмортизацияОС
	|		ПО ОсновныеСредства.Ссылка = АмортизацияОС.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ НачислениеАмортизацииОСБухгалтерскийУчет КАК НачислениеАмортизацииОСБухгалтерскийУчет
	|		ПО ОсновныеСредства.Ссылка = НачислениеАмортизацииОСБухгалтерскийУчет.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПараметрыАмортизацииОСБухгалтерскийУчет КАК ПараметрыАмортизацииОСБухгалтерскийУчет
	|		ПО ОсновныеСредства.Ссылка = ПараметрыАмортизацииОСБухгалтерскийУчет.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ НачислениеАмортизацииОСНалоговыйУчет КАК НачислениеАмортизацииОСНалоговыйУчет
	|		ПО ОсновныеСредства.Ссылка = НачислениеАмортизацииОСНалоговыйУчет.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПервоначальныеСведенияОСНалоговыйУчет КАК ПервоначальныеСведенияОСНалоговыйУчет
	|		ПО ОсновныеСредства.Ссылка = ПервоначальныеСведенияОСНалоговыйУчет.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПараметрыАмортизационнойПремииНалоговыйУчет КАК ПараметрыАмортизационнойПремииНалоговыйУчет
	|		ПО ОсновныеСредства.Ссылка = ПараметрыАмортизационнойПремииНалоговыйУчет.ОсновноеСредство
	|ГДЕ
	|	ОсновныеСредства.Ссылка В(&МассивОбъектовОС)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ АмортизацияОС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ПараметрыАмортизацииОСБухгалтерскийУчет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ НачислениеАмортизацииОСБухгалтерскийУчет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ПервоначальныеСведенияОСНалоговыйУчет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ НачислениеАмортизацииОСНалоговыйУчет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ПараметрыАмортизационнойПремииНалоговыйУчет";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = ПараметрыАмортизацииОС.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		СвойстваСчетаЗатрат = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Выборка.СчетУчетаЗатрат);
		НоваяСтрока.ВидСубконто1Затрат = СвойстваСчетаЗатрат.ВидСубконто1;
		НоваяСтрока.ВидСубконто2Затрат = СвойстваСчетаЗатрат.ВидСубконто2;
		НоваяСтрока.ВидСубконто3Затрат = СвойстваСчетаЗатрат.ВидСубконто3;
		
	КонецЦикла;
	
	Возврат ПараметрыАмортизацииОС;
	
КонецФункции

Функция ПолучитьСобытияОС(УсловияСобытий) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СобытияОС.Организация КАК Организация,
	|	СобытияОС.ОсновноеСредство КАК ОсновноеСредство,
	|	СобытияОС.ИнвНомер КАК ИнвентарныйНомер,
	|	СобытияОС.Событие,
	|	СобытияОС.ДатаСобытия,
	|	СобытияОС.Регистратор,
	|	СобытияОС.МоментВремени КАК МоментВремени
	|ИЗ
	|	РегистрСведений.СобытияОС КАК СобытияОС
	|ГДЕ
	|	&Условие
	|
	|УПОРЯДОЧИТЬ ПО
	|	Организация,
	|	ОсновноеСредство,
	|	ИнвентарныйНомер,
	|	МоментВремени";
	ТекстУсловие = "";
	НеПервоеУсловие = Ложь;
	Для каждого Условие Из УсловияСобытий Цикл
	
		Если НеПервоеУсловие Тогда
			ТекстУсловие = ТекстУсловие + Символы.ПС + " И ";
		Иначе
			НеПервоеУсловие = Истина;
		КонецЕсли;
		
		Если ВРЕГ(Условие.Ключ) = "ОРГАНИЗАЦИЯ" Тогда
		
			ТекстУсловие = ТекстУсловие + "СобытияОС.Организация = &Организация";
			Запрос.УстановитьПараметр("Организация", Условие.Значение);
			
		ИначеЕсли ВРЕГ(Условие.Ключ) = "ОСНОВНОЕСРЕДСТВО" Тогда
			
			ТекстУсловие = ТекстУсловие + "СобытияОС.ОсновноеСредство В(&ОсновноеСредство)";
			Запрос.УстановитьПараметр("ОсновноеСредство", Условие.Значение);
		
		ИначеЕсли ВРЕГ(Условие.Ключ) = "ИНВЕНТАРНЫЙНОМЕР" Тогда
			
			ТекстУсловие = ТекстУсловие + "СобытияОС.ИнвНомер В(&ИнвентарныйНомер)";
			Запрос.УстановитьПараметр("ИнвентарныйНомер", Условие.Значение);
		
		ИначеЕсли ВРЕГ(Условие.Ключ) = "СОБЫТИЕ" Тогда
			
			ТекстУсловие = ТекстУсловие + "СобытияОС.Событие В(&Событие)";
			Запрос.УстановитьПараметр("Событие", Условие.Значение);
		
		ИначеЕсли ВРЕГ(Условие.Ключ) = "ДАТАСОБЫТИЯ" Тогда
			
			ТекстУсловие = ТекстУсловие + "СобытияОС.ДатаСобытия <= &ДатаСобытия";
			Запрос.УстановитьПараметр("ДатаСобытия", Условие.Значение);
		
		ИначеЕсли ВРЕГ(Условие.Ключ) = "ПЕРИОД" Тогда
			
			ТекстУсловие = ТекстУсловие + "СобытияОС.Период <= &Период";
			Запрос.УстановитьПараметр("Период", Условие.Значение);
		
		ИначеЕсли ВРЕГ(Условие.Ключ) = "МОМЕНТВРЕМЕНИ" Тогда
			
			ТекстУсловие = ТекстУсловие + "СобытияОС.МоментВремени <= &МоментВремени";
			Запрос.УстановитьПараметр("МоментВремени", Условие.Значение);
		
		ИначеЕсли ВРЕГ(Условие.Ключ) = "РЕГИСТРАТОР" Тогда
			
			ТекстУсловие = ТекстУсловие + "СобытияОС.Регистратор <> &Регистратор";
			Запрос.УстановитьПараметр("Регистратор", Условие.Значение);
		
		КонецЕсли;
	
	КонецЦикла;
	
	Если НЕ НеПервоеУсловие Тогда
		ТекстУсловие = "ИСТИНА";
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Условие", ТекстУсловие);
	
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

// Процедура добавляет в массив имена реквизитов "СпособНачисленияАмортизации" и относящихся к счету учета затрат по амортизации,
// заполнение которых не нужно проверять при проведении.
// Используется при принятии к учету.
//
// Параметры:
//  СтоимостьНеПогашается			 - Булево - Если Истина, то все реквизиты не проверяются.
//  ПорядокПогашенияСтоимости		 - ПеречислениеСсылка.ПорядокПогашенияСтоимостиОС - порядок погашения стоимости ОС
//  СчетУчетаЗатрат					 - ПланСчетовСсылка - счет учета затрат
//  МассивНепроверяемыхРеквизитов	 - Массив - Массив имен реквизитов
//
Процедура ДобавитьНепроверяемыеРеквизитыСчетаЗатрат(СтоимостьНеПогашается, ПорядокПогашенияСтоимости, СчетУчетаЗатрат, МассивНепроверяемыхРеквизитов) Экспорт

	Если ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается ИЛИ СтоимостьНеПогашается Тогда
		МассивНепроверяемыхРеквизитов.Добавить("СпособНачисленияАмортизации");
		МассивНепроверяемыхРеквизитов.Добавить("СчетУчетаЗатрат");
		МассивНепроверяемыхРеквизитов.Добавить("КЭКЗатрат");
		МассивНепроверяемыхРеквизитов.Добавить("КПСЗатрат");
		МассивНепроверяемыхРеквизитов.Добавить("ПодразделениеЗатрат");
		МассивНепроверяемыхРеквизитов.Добавить("СубконтоЗатрат1");
		МассивНепроверяемыхРеквизитов.Добавить("СубконтоЗатрат2");
		МассивНепроверяемыхРеквизитов.Добавить("СубконтоЗатрат3");
	Иначе
		Если ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию Тогда
			МассивНепроверяемыхРеквизитов.Добавить("СпособНачисленияАмортизации");
		КонецЕсли;
		Если ЗначениеЗаполнено(СчетУчетаЗатрат) Тогда
			СвойстваСчетаЗатрат = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетУчетаЗатрат);
			Если Не ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
				МассивНепроверяемыхРеквизитов.Добавить("ПодразделениеЗатрат");
			ИначеЕсли НЕ СвойстваСчетаЗатрат.УчетПоПодразделениям Тогда
				МассивНепроверяемыхРеквизитов.Добавить("ПодразделениеЗатрат");
			КонецЕсли;
			КоличествоСубконто = СвойстваСчетаЗатрат.КоличествоСубконто;
			Для Счетчик = 1 По КоличествоСубконто Цикл
				Если СвойстваСчетаЗатрат["ВидСубконто" + Счетчик + "Обязательный"] <> Истина Тогда
					МассивНепроверяемыхРеквизитов.Добавить("СубконтоЗатрат"+Счетчик);
				КонецЕсли;
			КонецЦикла;
			Для Счетчик = (КоличествоСубконто + 1) по 3 Цикл 
				МассивНепроверяемыхРеквизитов.Добавить("СубконтоЗатрат"+Счетчик);
			КонецЦикла;
		Иначе
			МассивНепроверяемыхРеквизитов.Добавить("ПодразделениеЗатрат");
			Для Счетчик = 1 по 3 Цикл 
				МассивНепроверяемыхРеквизитов.Добавить("СубконтоЗатрат"+Счетчик);
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

// Функция перезаполняет переданную коллекцию формы подобранными основными средствами.
// По основным средствам присутствовавшим в коллекции изначально, данные колонок 
// дополняются исходными.
//
// Параметр:
//  КоллекцияОС - ДанныеФормыКоллекция, отображение табличной части с основными средствами
//  	в реквизит управляемой формы. Обязатлеьно должна присутствовать колонка ОсновноеСредство и
//  ИнвентарныйНомер.
//  
//  ВыбранноеЗначение - Структура, значение из обработчика ОбработкаВыбора полученное в результате
//  	подбора
//  ИмяОС - Строка - имя колонки с основным средством в табличной части, в которую производится подбор
//  КолонкиПоиска - Строка - список колонок через "," по которым будет произведен поиск в табличной части  
//..
//  Вовзвращаемое значение:
//    Массив - Массив новых строк коллекции.
//
Функция ОбработатьПодборОсновныхСредств(Знач КоллекцияОС, Знач ВыбранноеЗначение, ИмяОС = "ОсновноеСредство", КолонкиПоиска = "ОсновноеСредство") Экспорт
	
	ТаблицаОС = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресОСВХранилище);
	ТаблицаОС.Колонки.ОсновноеСредство.Имя = ИмяОС;
	ИсходныеДанные = КоллекцияОС.Выгрузить();
	ИсходныеДанные.Индексы.Добавить(КолонкиПоиска);
	
	ДобавленныеСтроки = Новый Массив;
	СтруктураПоиска = Новый Структура(КолонкиПоиска);

	КоллекцияОС.Очистить();
	Для каждого СтрокаТаблицыОС Из ТаблицаОС Цикл
		ЭлементКоллекции = КоллекцияОС.Добавить();
		ЗаполнитьЗначенияСвойств(СтруктураПоиска,СтрокаТаблицыОС);
		СтрокиИсходныхДанных = ИсходныеДанные.НайтиСтроки(СтруктураПоиска);
		Если СтрокиИсходныхДанных.Количество() > 0 Тогда
			ЗаполнитьЗначенияСвойств(ЭлементКоллекции, СтрокиИсходныхДанных[0]);
		Иначе
			ДобавленныеСтроки.Добавить(ЭлементКоллекции);
		КонецЕсли;
			
		ЗаполнитьЗначенияСвойств(ЭлементКоллекции, СтрокаТаблицыОС);
	КонецЦикла;
	
	Возврат ДобавленныеСтроки;
	
КонецФункции

// Очищает реквизиты объекта, относящиеся к комиссии в документе.
//
// Форма - ФормаКлиентскогоПриложения - форма документа, в котором очищаем комиссию
Процедура ОчиститьКомиссиюВДокументе(Форма) Экспорт
	ДокументОбъект = Форма.РеквизитФормыВЗначение("Объект");
	МетаданныеДока = ДокументОбъект.Метаданные();
	
	Реквизиты = Новый Массив;
	Реквизиты.Добавить("Комиссия");
	Реквизиты.Добавить("ДолжностьПредседателяКомиссии");
	Реквизиты.Добавить("ФамилияПредседателяКомиссии");
	Реквизиты.Добавить("ИмяПредседателяКомиссии");
	Реквизиты.Добавить("ОтчествоПредседателяКомиссии");
	Реквизиты.Добавить("НаименованиеПриказа");
	Реквизиты.Добавить("НомерПриказа");
	Реквизиты.Добавить("ДатаПриказа");
	Для каждого ТекРеквизит из Реквизиты Цикл
		Если МетаданныеДока.Реквизиты.Найти(ТекРеквизит) <> Неопределено Тогда
			ДокументОбъект[ТекРеквизит] = "";
		КонецЕсли;	
	КонецЦикла;	

	Если МетаданныеДока.ТабличныеЧасти.Найти("СоставКомиссии") <> Неопределено Тогда
		ДокументОбъект.СоставКомиссии.Очистить();
	КонецЕсли;	     
	Форма.ЗначениеВРеквизитФормы(ДокументОбъект, "Объект");
КонецПроцедуры	

// Вызывается из обработчика документа-объекта "Перед записью".
// 
// Параметры:
//  Объект - ДокументОбъект - документ, из которого вызывается процедура
//  РежимЗаписи - РежимЗаписиДокумента
//  Отказ - Булево - флаг отказа от записи
Процедура ДокументПередЗаписью(Объект, РежимЗаписи, Отказ) Экспорт
	Если ПолучитьФункциональнуюОпцию("РезервироватьОСПриВыбытии") Тогда
		РезервированиеНФА.ПередЗаписью(Объект, РежимЗаписи, Отказ);
	КонецЕсли;
КонецПроцедуры

#Область БухгалтерскиеОперации

// Поступление основных средств.

// Пустая таблица поступление основных средств по документу.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Пустая таблица поступление основных средств по документу:
// * ИмяСписка - Строка
// * СинонимСписка - Строка
// * НомерСтроки - Число
// * ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения - 
// * КФО - ПеречислениеСсылка.КВД - 
// * КПС - СправочникСсылка.КлассификационныеПризнакиСчетов - 
// * Подразделение - СправочникСсылка.Подразделения - 
// * СчетВложений - ПланСчетовСсылка.ЕПСБУ - 
// * ВнеоборотныйАктив - СправочникСсылка.ОсновныеСредства - 
// * ВидЗатрат - СправочникСсылка.ВидыЗатрат - 
// * СчетРасчетов - ПланСчетовСсылка.ЕПСБУ - 
// * Контрагент - СправочникСсылка.Контрагенты - 
// * Договор - СправочникСсылка.Договоры - 
// * Валюта - СправочникСсылка.Валюты - 
// * Количество - Число 
// * Сумма - Число
// * СтавкаНДС - ПеречислениеСсылка.СтавкиНДС - 
// * СуммаНДС - Число
// * НДСКРаспределению - Булево - 
// * ПринятьНДСКВычету - Булево - 
// * СПИОпределен - Булево - 
Функция ПустаяТаблицаПоступлениеОсновныхСредствПоДокументу() Экспорт
	
	ОписаниеТипаСуммы        = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества   = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	
	ТаблицаДокумента = Новый ТаблицаЗначений;
	// Идентификация строки.
	ТаблицаДокумента.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ТаблицаДокумента.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ТаблицаДокумента.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	// Общие разрезы учета.
	ТаблицаДокумента.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ТаблицаДокумента.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ТаблицаДокумента.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаДокумента.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	// Счет и аналитика учета вложений в НФА.
	ТаблицаДокумента.Колонки.Добавить("СчетВложений",      Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаДокумента.Колонки.Добавить("ВнеоборотныйАктив", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ТаблицаДокумента.Колонки.Добавить("ВидЗатрат",         Новый ОписаниеТипов("СправочникСсылка.ВидыЗатрат"));
	// Поставщик.
	ТаблицаДокумента.Колонки.Добавить("СчетРасчетов",  Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаДокумента.Колонки.Добавить("Контрагент",    Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТаблицаДокумента.Колонки.Добавить("Договор",       Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ТаблицаДокумента.Колонки.Добавить("Валюта",        Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	// Количество и сумма поступивших единиц.
	ТаблицаДокумента.Колонки.Добавить("Количество",    ОписаниеТипаКоличества);
	ТаблицаДокумента.Колонки.Добавить("Сумма",         ОписаниеТипаСуммы); // Сумма с НДС в валюте документа.
	ТаблицаДокумента.Колонки.Добавить("СтавкаНДС",     Новый ОписаниеТипов("ПеречислениеСсылка.СтавкиНДС"));
	ТаблицаДокумента.Колонки.Добавить("СуммаНДС",      ОписаниеТипаСуммы); // Сумма НДС в валюте документа.
	// Дополнительные колонки.
	ТаблицаДокумента.Колонки.Добавить("НДСКРаспределению", Новый ОписаниеТипов("Булево"));
	ТаблицаДокумента.Колонки.Добавить("ПринятьНДСКВычету", Новый ОписаниеТипов("Булево"));
	ТаблицаДокумента.Колонки.Добавить("СПИОпределен",      Новый ОписаниеТипов("Булево"));
	
	Возврат ТаблицаДокумента;
	
КонецФункции

// Подготавливает таблицу документа (в унифицированном формате) для учета поступления ОС, НМА, НПА.
// 
// Параметры:
//  Документ - ДокументОбъект, ДокументСсылка -
//  Параметры - Неопределено, Структура - Параметры
//  Отказ - Булево
// 
// Возвращаемое значение:
//  ТаблицаЗначений - см. ПустаяТаблицаПоступлениеОсновныхСредствПоДокументу 
Функция ПодготовитьТаблицуПоступлениеОсновныхСредствПоДокументу(Документ, Параметры = Неопределено, Отказ) Экспорт
	
	Если Параметры = Неопределено Тогда
		Параметры = Новый Структура;
	КонецЕсли;

	ТаблицаДокумента = ПустаяТаблицаПоступлениеОсновныхСредствПоДокументу();
	
	Запрос = Новый Запрос;
	
	МетаданныеДокумента = Документ.Метаданные();
	
	Если МетаданныеДокумента.Имя = "АктПриемкиТоваровРаботУслуг" Тогда
		
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "ТоварыРаботыУслуги",
			"НомерСтроки,ИФО,КФО,КПС,Подразделение,СчетРасчетов,Контрагент,Договор,ВалютаДокумента,
			|Номенклатура,КоличествоПринято,СуммаПринято,Всего,СтавкаНДС,СуммаНДС",
			Документ, Параметры);
		
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	""ТоварыРаботыУслуги"" КАК ИмяСписка,
		|	""Приемка товаров, работ, услуг"" КАК СинонимСписка,
		|	ТоварыРаботыУслуги.НомерСтроки КАК НомерСтроки,
		|	ТоварыРаботыУслуги.ИФО КАК ИФО,
		|	ТоварыРаботыУслуги.КФО КАК КФО,
		|	ТоварыРаботыУслуги.КПС КАК КПС,
		|	ТоварыРаботыУслуги.Подразделение КАК Подразделение,
		|	ТоварыРаботыУслуги.СчетРасчетов КАК СчетРасчетов,
		|	ВЫБОР
		|		КОГДА ТоварыРаботыУслуги.СчетРасчетов = &Счет30226
		|			ТОГДА &Счет1066I
		|		ИНАЧЕ &Счет10631
		|	КОНЕЦ КАК СчетВложений,
		|	ВЫРАЗИТЬ(ТоварыРаботыУслуги.Номенклатура КАК Справочник.ОсновныеСредства) КАК ВнеоборотныйАктив,
		|	ЗНАЧЕНИЕ(Справочник.ВидыЗатрат.ПустаяСсылка) КАК ВидЗатрат,
		|	ТоварыРаботыУслуги.Контрагент КАК Контрагент,
		|	ТоварыРаботыУслуги.Договор КАК Договор,
		|	ТоварыРаботыУслуги.ВалютаДокумента КАК Валюта,
		|	ТоварыРаботыУслуги.КоличествоПринято КАК Количество,
		|	ТоварыРаботыУслуги.СуммаПринято КАК Сумма,
		|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка) КАК СтавкаНДС,
		|	0 КАК СуммаНДС,
		|	ЛОЖЬ КАК НДСКРаспределению,
		|	ЛОЖЬ КАК ПринятьНДСКВычету
		|ИЗ
		|	ТаблицаТоварыРаботыУслуги КАК ТоварыРаботыУслуги
		|ГДЕ
		|	ТоварыРаботыУслуги.Номенклатура ССЫЛКА Справочник.ОсновныеСредства
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
		Запрос.УстановитьПараметр("Счет10631", БухгалтерскийУчет.СчетПоКоду("106.31", Документ.Дата, Документ.Организация));
		Запрос.УстановитьПараметр("Счет1066I", БухгалтерскийУчет.СчетПоКоду("106.6I", Документ.Дата, Документ.Организация));
		Запрос.УстановитьПараметр("Счет30226", БухгалтерскийУчет.СчетПоКоду("302.26", Документ.Дата, Документ.Организация));
		
	ИначеЕсли МетаданныеДокумента.Имя = "ПоступлениеОСВПути" Тогда
		
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "КапВложения",
			"НомерСтроки,ИФО,КФО,КПС,Подразделение,Контрагент,Договор,ВалютаДокумента,ПринятьНДСКВычету,
			|СчетУчета,ВнеоборотныйАктив,Количество,Сумма,Всего,СтавкаНДС,СуммаНДС,НДСКРаспределению",
			Документ, Параметры);
		
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	""КапВложения"" КАК ИмяСписка,
		|	""Капитальные вложения"" КАК СинонимСписка,
		|	КапВложения.НомерСтроки КАК НомерСтроки,
		|	КапВложения.ИФО КАК ИФО,
		|	КапВложения.КФО КАК КФО,
		|	КапВложения.КПС КАК КПС,
		|	КапВложения.Подразделение КАК Подразделение,
		|	КапВложения.СчетУчета КАК СчетВложений,
		|	КапВложения.ВнеоборотныйАктив КАК ВнеоборотныйАктив,
		|	ЗНАЧЕНИЕ(Справочник.ВидыЗатрат.ПустаяСсылка) КАК ВидЗатрат,
		|	КапВложения.Контрагент КАК Контрагент,
		|	КапВложения.Договор КАК Договор,
		|	КапВложения.ВалютаДокумента КАК Валюта,
		|	КапВложения.Количество КАК Количество,
		|	КапВложения.Всего КАК Сумма,
		|	КапВложения.СтавкаНДС КАК СтавкаНДС,
		|	КапВложения.СуммаНДС КАК СуммаНДС,
		|	КапВложения.НДСКРаспределению КАК НДСКРаспределению,
		|	КапВложения.ПринятьНДСКВычету КАК ПринятьНДСКВычету
		|ИЗ
		|	ТаблицаКапВложения КАК КапВложения
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
		
	ИначеЕсли МетаданныеДокумента.Имя = "ПоступлениеОСИК" Тогда
		
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "КапВложения",
			"НомерСтроки,ИФО,КФО,КПС,Подразделение,Контрагент,Договор,ВалютаДокумента,
			|СчетУчета,ВнеоборотныйАктив,ВидЗатрат,Количество,Сумма,Всего,СтавкаНДС,СуммаНДС,НДСКРаспределению",
			Документ, Параметры);
		
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	""КапВложения"" КАК ИмяСписка,
		|	""Капитальные вложения"" КАК СинонимСписка,
		|	КапВложения.НомерСтроки КАК НомерСтроки,
		|	КапВложения.ИФО КАК ИФО,
		|	КапВложения.КФО КАК КФО,
		|	КапВложения.КПС КАК КПС,
		|	КапВложения.Подразделение КАК Подразделение,
		|	КапВложения.СчетУчета КАК СчетВложений,
		|	КапВложения.ВнеоборотныйАктив КАК ВнеоборотныйАктив,
		|	КапВложения.ВидЗатрат КАК ВидЗатрат,
		|	КапВложения.Контрагент КАК Контрагент,
		|	КапВложения.Договор КАК Договор,
		|	КапВложения.ВалютаДокумента КАК Валюта,
		|	КапВложения.Количество КАК Количество,
		|	КапВложения.Всего КАК Сумма,
		|	КапВложения.СтавкаНДС КАК СтавкаНДС,
		|	КапВложения.СуммаНДС КАК СуммаНДС,
		|	КапВложения.НДСКРаспределению КАК НДСКРаспределению
		|ИЗ
		|	ТаблицаКапВложения КАК КапВложения
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";

	Иначе
		
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "КапВложения",
			"НомерСтроки,ИФО,КФО,КПС,Подразделение,Контрагент,Договор,ВалютаДокумента,СПИОпределен,ПринятьНДСКВычету,
			|СчетУчета,ВнеоборотныйАктив,ВидЗатрат,Количество,Сумма,Всего,СтавкаНДС,СуммаНДС,НДСКРаспределению",
			Документ, Параметры);
		
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	""КапВложения"" КАК ИмяСписка,
		|	""Капитальные вложения"" КАК СинонимСписка,
		|	КапВложения.НомерСтроки КАК НомерСтроки,
		|	КапВложения.ИФО КАК ИФО,
		|	КапВложения.КФО КАК КФО,
		|	КапВложения.КПС КАК КПС,
		|	КапВложения.Подразделение КАК Подразделение,
		|	КапВложения.СчетУчета КАК СчетВложений,
		|	КапВложения.ВнеоборотныйАктив КАК ВнеоборотныйАктив,
		|	КапВложения.ВидЗатрат КАК ВидЗатрат,
		|	КапВложения.Контрагент КАК Контрагент,
		|	КапВложения.Договор КАК Договор,
		|	КапВложения.ВалютаДокумента КАК Валюта,
		|	КапВложения.Количество КАК Количество,
		|	КапВложения.Всего КАК Сумма,
		|	КапВложения.СтавкаНДС КАК СтавкаНДС,
		|	КапВложения.СуммаНДС КАК СуммаНДС,
		|	КапВложения.НДСКРаспределению КАК НДСКРаспределению,
		|	КапВложения.ПринятьНДСКВычету КАК ПринятьНДСКВычету,
		|	КапВложения.СПИОпределен КАК СПИОпределен
		|ИЗ
		|	ТаблицаКапВложения КАК КапВложения
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
		
	КонецЕсли;
	
	ИспользоватьВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	// Счет расчетов.
	СчетРасчетов = УчетРасчетов.ОпределитьСчетРасчетовПоПараметрам(Параметры, "Поступление",
		Документ.Дата, Документ.Организация, Документ.ИФО);
	
	ПоступлениеОсновныхСредств = Запрос.Выполнить().Выгрузить();
	Для Каждого Строка Из ПоступлениеОсновныхСредств Цикл
		
		// Счет учета.
		Если НЕ ЗначениеЗаполнено(Строка.СчетВложений) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
				НСтр("ru = 'Счет учета'"), Строка.НомерСтроки, Строка.СинонимСписка);
			ПолеКолонки = "Объект." + Строка.ИмяСписка +
				"[" + Формат(Строка.НомерСтроки-1, "ЧН=0; ЧГ=") + "].СчетУчета";
			БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстСообщения, ПолеКолонки, Отказ);
		КонецЕсли;
		
		// Внеоборотный актив.
		Если НЕ ЗначениеЗаполнено(Строка.ВнеоборотныйАктив) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
				НСтр("ru = 'Внеоборотный актив'"), Строка.НомерСтроки, Строка.СинонимСписка);
			ПолеКолонки = "Объект." + Строка.ИмяСписка +
				"[" + Формат(Строка.НомерСтроки-1, "ЧН=0; ЧГ=") + "].ВнеоборотныйАктив";
			БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстСообщения, ПолеКолонки, Отказ);
		КонецЕсли;
		
		Если Отказ Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаДокумента.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
		Если Не ИспользоватьВалютныйУчет И Не ЗначениеЗаполнено(НоваяСтрока.Валюта) Тогда
			НоваяСтрока.Валюта = ВалютаРегламентированногоУчета;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(НоваяСтрока.СчетРасчетов) Тогда
			// Заполнен ранее.
		ИначеЕсли ЗначениеЗаполнено(СчетРасчетов) Тогда
			НоваяСтрока.СчетРасчетов = СчетРасчетов;
		ИначеЕсли МетаданныеДокумента.Имя = "ПоступлениеОСВПути" Тогда
			НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.СчетПоКоду("302.31", Документ.Дата, Документ.Организация);
		Иначе
			НоваяСтрока.СчетРасчетов = УчетРасчетов.СчетРасчетовПоПриобретениюВНА(Строка.СчетВложений,
				?(Параметры.Свойство("СчетРасчетов"), Параметры.СчетРасчетов, "302.00"), Документ.Дата, Документ.Организация);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаДокумента;
	
КонецФункции

// Структура таблицы источника данных "Поступление основных средств".
//
Функция ПустаяТаблицаПоступлениеОсновныхСредств() Экспорт

	ОписаниеТипаСуммы        = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества   = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	ОписаниеТиповВидСубконто = Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто");
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Идентификация строки.
	ПустаяТаблица.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	// Счет и аналитика учета вложений в НФА.
	ПустаяТаблица.Колонки.Добавить("СчетВложений",      Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("ВнеоборотныйАктив", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ПустаяТаблица.Колонки.Добавить("ВидЗатрат",         Новый ОписаниеТипов("СправочникСсылка.ВидыЗатрат"));
	// Поставщик.
	ПустаяТаблица.Колонки.Добавить("СчетРасчетов",  Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("Контрагент",    Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ПустаяТаблица.Колонки.Добавить("Договор",       Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ПустаяТаблица.Колонки.Добавить("Валюта",        Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	// Количество и сумма поступивших единиц.
	ПустаяТаблица.Колонки.Добавить("Количество",    ОписаниеТипаКоличества);
	ПустаяТаблица.Колонки.Добавить("СтавкаНДС",     Новый ОписаниеТипов("ПеречислениеСсылка.СтавкиНДС"));
	ПустаяТаблица.Колонки.Добавить("СуммаНДСВал",   ОписаниеТипаСуммы); // Сумма НДС в валюте документа.
	ПустаяТаблица.Колонки.Добавить("СуммаНДСРуб",   ОписаниеТипаСуммы); // Сумма НДС в рублях.
	ПустаяТаблица.Колонки.Добавить("СуммаВал",      ОписаниеТипаСуммы); // Сумма с НДС в валюте документа.
	ПустаяТаблица.Колонки.Добавить("СуммаРуб",      ОписаниеТипаСуммы); // Сумма с НДС в рублях.
	// Дополнительные колонки.
	ПустаяТаблица.Колонки.Добавить("НДСКРаспределению", Новый ОписаниеТипов("Булево"));
	ПустаяТаблица.Колонки.Добавить("ПринятьНДСКВычету", Новый ОписаниеТипов("Булево"));
	ПустаяТаблица.Колонки.Добавить("СПИОпределен",      Новый ОписаниеТипов("Булево"));
	
	Возврат ПустаяТаблица;

КонецФункции

// Формирует таблицу источника данных "Поступление основных средств".
//
Функция ТаблицаПоступлениеОсновныхСредств(ТаблицаДокумента, ТаблицаРасчетовСЗачетомАвансов=Неопределено, Реквизиты, Отказ) Экспорт
	
	ТаблицаПоступление = ПустаяТаблицаПоступлениеОсновныхСредств();
	Если ТаблицаДокумента.Количество() = 0 Тогда
		Возврат ТаблицаПоступление;
	КонецЕсли;
	
	УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Реквизиты.Организация, Реквизиты.Дата);
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	
	УчетРасчетов.РассчитатьСуммыРуб(ТаблицаДокумента, ТаблицаРасчетовСЗачетомАвансов, Реквизиты);
	
	Для Каждого СтрокаДокумента Из ТаблицаДокумента Цикл
		
		СтрокаПоступление = ТаблицаПоступление.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПоступление, СтрокаДокумента);
		
		СтрокаПоступление.СуммаВал    = СтрокаДокумента.Сумма;
		СтрокаПоступление.СуммаНДСВал = СтрокаДокумента.СуммаНДС;
		
	КонецЦикла;
	
	Возврат ТаблицаПоступление;
	
КонецФункции

