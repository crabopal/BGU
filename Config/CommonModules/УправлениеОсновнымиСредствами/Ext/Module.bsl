		ИмуществоКазны = ПараметрыОтчета.Свойство("ИмуществоКазны") И ПараметрыОтчета["ИмуществоКазны"] = Истина;
		
		Если ИмуществоКазны Тогда
			КодыСчетаУчета	= "108.00";
			КодыСчетаАм		= "104.50";
		Иначе
			КодыСчетаУчета	= "101.00,102.00";
			КодыСчетаАм		= "104.10,104.20,104.30,104.40";
		КонецЕсли;
		
		КодыСчетаКап = "106.13";
		
	Иначе
		
		ТекстУсловияСтроки(УсловияЯчеек, "001", "Показатели.ОКОФ <> """"");
		ТекстУсловияСтроки(УсловияЯчеек, "002", "ВЫРАЗИТЬ(Показатели.ОКОФ КАК СТРОКА(2)) В (""11"",""13"")");
		ТекстУсловияСтроки(УсловияЯчеек, "003", "ВЫРАЗИТЬ(Показатели.ОКОФ КАК СТРОКА(2)) = ""13""");
		ТекстУсловияСтроки(УсловияЯчеек, "004", "ВЫРАЗИТЬ(Показатели.ОКОФ КАК СТРОКА(2)) = ""12""");
		ТекстУсловияСтроки(УсловияЯчеек, "006", "ВЫРАЗИТЬ(Показатели.ОКОФ КАК СТРОКА(2)) = ""14""");
		ТекстУсловияСтроки(УсловияЯчеек, "007", "Показатели.ОКОФ В (&Коды007)");
		ТекстУсловияСтроки(УсловияЯчеек, "008", "Показатели.ОКОФ В (&Коды008)");
		ТекстУсловияСтроки(УсловияЯчеек, "108", "Показатели.ОКОФ В (&Коды108)");
		ТекстУсловияСтроки(УсловияЯчеек, "009", "ВЫРАЗИТЬ(Показатели.ОКОФ КАК СТРОКА(2)) = ""15""");
		ТекстУсловияСтроки(УсловияЯчеек, "010", "ВЫРАЗИТЬ(Показатели.ОКОФ КАК СТРОКА(2)) = ""17""");
		ТекстУсловияСтроки(УсловияЯчеек, "011", "ВЫРАЗИТЬ(Показатели.ОКОФ КАК СТРОКА(2)) = ""18""");
		
		ТекстУсловияСтроки(УсловияЯчеек, "012", "ВЫРАЗИТЬ(Показатели.ОКОФ КАК СТРОКА(2)) = ""16""");
		
		Если Год < 2016 Тогда
			ТекстУсловияСтроки(УсловияЯчеек, "112", "(ВЫРАЗИТЬ(Показатели.ОКОФ КАК СТРОКА(7)) В (""16 2929"",""16 3311"",""16 3612"", ""16 3697"")
													|	ИЛИ Показатели.ОКОФ В (""16 3696632"",""16 3696633"",""16 3696639""))");
		КонецЕсли;
		
		ТекстУсловияСтроки(УсловияЯчеек, "013", "ВЫРАЗИТЬ(Показатели.ОКОФ КАК СТРОКА(1)) = ""2""");
		ТекстУсловияСтроки(УсловияЯчеек, "113", "ВЫРАЗИТЬ(Показатели.ОКОФ КАК СТРОКА(2)) В (""24"",""25"")
												|	И Показатели.ОКОФ <> ""25 0003000""");
		ТекстУсловияСтроки(УсловияЯчеек, "213", "ВЫРАЗИТЬ(Показатели.ОКОФ КАК СТРОКА(2)) = ""21""");
		ТекстУсловияСтроки(УсловияЯчеек, "313", "ВЫРАЗИТЬ(Показатели.ОКОФ КАК Строка(8)) = ""22 72600""");
		ТекстУсловияСтроки(УсловияЯчеек, "413", "Показатели.ОКОФ = ""227240000""");
		ТекстУсловияСтроки(УсловияЯчеек, "513", "ВЫРАЗИТЬ(Показатели.ОКОФ КАК СТРОКА(2)) = ""23""");
		
		ТекстУсловияСтроки(УсловияЯчеек, "014", "ВЫРАЗИТЬ(Показатели.ОКОФ КАК СТРОКА(2)) = ""19""");
		ТекстУсловияСтроки(УсловияЯчеек, "114", "ВЫРАЗИТЬ(Показатели.ОКОФ КАК СТРОКА(8)) = ""19 00011""");
		
		Если Год >= 2017 Тогда
			
			Коды008 = "14 3020010,14 302019[0-7],14 302020[0-9],14 3020030,14 3020040,
						|14 3010010,14 3010211,14 3010213,14 3010215,14 301022[0-8],14 301023[0-5],14 301024[0-2],
						|14 3010251,14 301026[0-2],14 301027[0-2],14 301028[0-2],14 3010040,14 322211[0-3],14 322213[0-5]";
			
			Коды108 = "14 3221010,14 3222010,14 3222020,14 3222040,14 3230000";	
			Коды007 = Коды008 + "," + Коды108 + ",14 3322020,14 3322030,14 3322060";
			
			Коды108 = Коды108 + ",-14 322211[0-3],-14 322213[0-5]"; // коды, исключаемые из строки 08.1
			
		ИначеЕсли Год >= 2015 Тогда
			
			Коды008 = "14 3020010,14 3020020,14 3020030,14 3020040,
						|14 3010010,14 3010211,14 3010213,14 3010215,14 301022[0-8],14 301023[0-5],14 301024[0-2],
						|14 3010251,14 301026[0-2],14 301027[0-2],14 301028[0-2],14 3010040,14 322211[0-3],14 322213[0-5]";
			
			Коды108 = "14 3221010,14 3222010,14 3222020,14 3222040,14 3230000";	
			Коды007 = Коды008 + "," + Коды108 + ",14 3322020,14 3322030,14 3322060";	
			
		Иначе
			
			Коды008 = "14 3010000,14 3020000";
			Коды108 = "14 3221010";
			Коды007 = Коды008 + "," + Коды108 + ",14 3322020,14 3322030, 14 3230000";
			
		КонецЕсли;
		
		Запрос.УстановитьПараметр("Коды007", ПолучитьМассивКодовОКОФ(Коды007));
		Запрос.УстановитьПараметр("Коды008", ПолучитьМассивКодовОКОФ(Коды008));
		Запрос.УстановитьПараметр("Коды108", ПолучитьМассивКодовОКОФ(Коды108));
		
		ИмуществоКазны	= Ложь;
		КодыСчетаУчета	= "101.00,102.00";
		КодыСчетаАм		= "104.10,104.20,104.30,104.40";
		КодыСчетаКап	= "106.13";
		
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса + "; ВЫБРАТЬ " + УсловияЯчеек + " ИЗ Показатели КАК Показатели
					|СГРУППИРОВАТЬ ПО
					|	Показатели.ОсновноеСредство
					|УПОРЯДОЧИТЬ ПО
					|	ОсновноеСредство
					|ИТОГИ ПО
					|	ОБЩИЕ";
	
	Запрос.УстановитьПараметр("Организация"		, ПараметрыОтчета.Организация);
	Запрос.УстановитьПараметр("НачалоПериода"	, ПараметрыОтчета.мДатаНачалаПериодаОтчета);
	Запрос.УстановитьПараметр("КонецПериода"	, Новый Граница(ПараметрыОтчета.мДатаКонцаПериодаОтчета, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("КЭККатастрофа"	, Справочники.КОСГУ.НайтиПоКоду("273"));
	Запрос.УстановитьПараметр("Счет"			, БухгалтерскийУчет.СписокСчетов(КодыСчетаУчета));
	Запрос.УстановитьПараметр("СчетАм"			, БухгалтерскийУчет.СписокСчетов(КодыСчетаАм));
	Запрос.УстановитьПараметр("СчетКап"			, БухгалтерскийУчет.СписокСчетов(КодыСчетаКап));
	Запрос.УстановитьПараметр("Субконто"		, БухгалтерскийУчет.СписокСубконто("ОсновныеСредства"));
	Запрос.УстановитьПараметр("ИмуществоКазны"	, ИмуществоКазны);
	
	Результат = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСреднегодовуюСтоимостьФорма11К(ПараметрыОтчета)
	
	СпособыНачисленияАмортизации = Новый Массив;
	СпособыНачисленияАмортизации.Добавить(Перечисления.СпособНачисленияАмортизации.Линейный);
	СпособыНачисленияАмортизации.Добавить(Перечисления.СпособНачисленияАмортизации.УменьшаемогоОстатка);
	СпособыНачисленияАмортизации.Добавить(Перечисления.СпособНачисленияАмортизации.ПропорциональноОбъемуПродукции);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", ПараметрыОтчета.Организация);
	Запрос.УстановитьПараметр("КонецПериода", ПараметрыОтчета.мДатаКонцаПериодаОтчета+1);
	Запрос.УстановитьПараметр("СпособыНачисленияАмортизации", СпособыНачисленияАмортизации);
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПараметрыАмортизации.ОсновноеСредство КАК ОС
	|ИЗ
	|	РегистрСведений.ПараметрыАмортизацииОСБухгалтерскийУчет.СрезПоследних(&КонецПериода, Организация = &Организация) КАК ПараметрыАмортизации
	|ГДЕ
	|	ПараметрыАмортизации.ПорядокПогашенияСтоимости = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации)
	|	И ПараметрыАмортизации.СпособНачисленияАмортизации В(&СпособыНачисленияАмортизации)";
	
	ОСФонда = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ОС");
	
	Схема = Отчеты.РасчетСреднегодовойСтоимостиИмущества.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	
	Выражение = "ВЫБОР КОГДА Подразделение.ОбособленноеПодразделение ТОГДА Подразделение ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка) КОНЕЦ";
	ОбщийМодульСКД.ДобавитьВычисляемоеПолеКомпоновкиДанных(Схема, "ОбособленноеПодразделение", Выражение);
	
	ВычисляемоеПоле = Схема.ВычисляемыеПоля.Найти("СреднегодоваяСтоимость");
	ВычисляемоеПоле.Выражение =
	"ВЫБОР
	|	КОГДА Период = (ВЫБОР
	|						КОГДА &НачалоПериода > НачалоПериода(Организация.ДатаРегистрации, ""МЕСЯЦ"")
	|							ТОГДА &НачалоПериода
	|						ИНАЧЕ
	|							НачалоПериода(Организация.ДатаРегистрации, ""МЕСЯЦ"")
	|						КОНЕЦ)
	|		ИЛИ Период = &КонецПериода
	|	ТОГДА
	|		(СуммаБаланс - СуммаАмортизации)/2
	|	ИНАЧЕ
	|		СуммаБаланс - СуммаАмортизации КОНЕЦ";
	
	Ресурс = Схема.ПоляИтога.Найти("СреднегодоваяСтоимость");
	Ресурс.Выражение = "СУММА(СреднегодоваяСтоимость) / 12";
	
	СтрокаСхемы = ПоместитьВоВременноеХранилище(Схема);
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СтрокаСхемы));
	
	ПериодОтчета = ПараметрыОтчета.мДатаКонцаПериодаОтчета+1;
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроек, "ПериодОтчета", ПериодОтчета);
	
	СтруктураПодр = КомпоновщикНастроек.Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ОбщийМодульСКД.ДобавитьПолеГруппировкиКомпоновкиДанных(СтруктураПодр, "ОбособленноеПодразделение");
	СтруктураПодр.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	СтруктураПодр.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
	
	СтруктураОС = СтруктураПодр.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ОбщийМодульСКД.ДобавитьПолеГруппировкиКомпоновкиДанных(СтруктураОС, "ОсновноеСредство");
	СтруктураОС.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	СтруктураОС.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
	
	Выбор = КомпоновщикНастроек.Настройки.Выбор;
	ОбщийМодульСКД.ДобавитьВыбранноеПолеКомпоновкиДанных(Выбор, "ОбособленноеПодразделение");
	ОбщийМодульСКД.ДобавитьВыбранноеПолеКомпоновкиДанных(Выбор, "ОсновноеСредство");
	ОбщийМодульСКД.ДобавитьВыбранноеПолеКомпоновкиДанных(Выбор, "СреднегодоваяСтоимость");
	
	Отбор = КомпоновщикНастроек.Настройки.Отбор;
	ОбщийМодульСКД.ДобавитьЭлементОтбораКомпоновкиДанных(Отбор, "Организация",, ПараметрыОтчета.Организация); 
	ОбщийМодульСКД.ДобавитьЭлементОтбораКомпоновкиДанных(Отбор, "ОсновноеСредство", ВидСравненияКомпоновкиДанных.ВСписке, ОСФонда);
	
	ПолеПорядка = КомпоновщикНастроек.Настройки.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
	ПолеПорядка.Поле = Новый ПолеКомпоновкиДанных("ОбособленноеПодразделение");
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметрВывода(КомпоновщикНастроек, "ВертикальноеРасположениеОбщихИтогов", Ложь);
	
	НастройкиДляКомпоновкиМакета = КомпоновщикНастроек.ПолучитьНастройки();
	
	ОсновнойНаборДанных = Отчеты.РасчетСреднегодовойСтоимостиИмущества.ОсновнойНаборДанных(
		ПараметрыОтчета.мДатаНачалаПериодаОтчета, ПериодОтчета, НастройкиДляКомпоновкиМакета);
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	Результат = Новый ДеревоЗначений;
	
	Попытка
		МакетКомпоновки = КомпоновщикМакета.Выполнить(Схема, НастройкиДляКомпоновкиМакета,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
		ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
		ВнешниеНаборыДанных = Новый Структура("ОсновнойНаборДанных", ОсновнойНаборДанных);
		ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных,, Истина);
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
		ПроцессорВывода.УстановитьОбъект(Результат);
		
		ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		Пока ИнформацияОбОшибке.Причина <> Неопределено Цикл
			ИнформацияОбОшибке = ИнформацияОбОшибке.Причина;
		КонецЦикла;
		ТекстСообщения = НСтр("ru = 'Отчет не сформирован!'") + Символы.ПС + ИнформацияОбОшибке.Описание;
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Отказ = Истина;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Процедура ТекстУсловияСтроки(Приемник, НомерКолонки, Условие)
	
	Для Колонка = 3 По 11 Цикл
		ИмяЯчейки = "П0100" + НомерКолонки + Формат(Колонка, "ЧЦ=2; ЧН=; ЧВН=; ЧГ=");
		Приемник = Приемник + ?(Приемник = "", "", ", ") + "СУММА(ВЫБОР КОГДА " + Условие + " ТОГДА Показатели.Колонка" + Формат(Колонка, "ЧН=; ЧГ=") + " ИНАЧЕ 0 КОНЕЦ) КАК " + ИмяЯчейки;
	КонецЦикла;
	
КонецПроцедуры

Процедура ТекстУсловияСтроки2(Приемник, НомерКолонки, Условие)
	
	Для Колонка = 3 По 11 Цикл
		ИмяЯчейки = "П00" + НомерКолонки + Формат(Колонка, "ЧЦ=2; ЧВН=");
		Приемник = Приемник + ?(Приемник = "", "", ", ") + "СУММА(ВЫБОР КОГДА " + Условие + " ТОГДА Показатели.Колонка" + Формат(Колонка) + " ИНАЧЕ 0 КОНЕЦ) КАК " + ИмяЯчейки;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьМассивКодовОКОФ(СтрокаКодов)
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	СправочникОКОФ.Ссылка КАК ОКОФ
	               |ПОМЕСТИТЬ КодыОКОФ
	               |ИЗ
	               |	Справочник.ОбщероссийскийКлассификаторОсновныхФондов КАК СправочникОКОФ
	               |ГДЕ
	               |	&Условие1
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СправочникОКОФ.Ссылка КАК ОКОФ
	               |ПОМЕСТИТЬ КодыОКОФИскл
	               |ИЗ
	               |	Справочник.ОбщероссийскийКлассификаторОсновныхФондов КАК СправочникОКОФ
	               |ГДЕ
	               |	&Условие2
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СправочникОКОФ.Ссылка.Код КАК ОКОФ
	               |ИЗ
	               |	Справочник.ОбщероссийскийКлассификаторОсновныхФондов КАК СправочникОКОФ
	               |ГДЕ
	               |	СправочникОКОФ.Ссылка В ИЕРАРХИИ
	               |			(ВЫБРАТЬ
	               |				КодыОКОФ.ОКОФ
	               |			ИЗ
	               |				КодыОКОФ КАК КодыОКОФ)
	               |	И НЕ СправочникОКОФ.Ссылка В ИЕРАРХИИ
	               |				(ВЫБРАТЬ
	               |					КодыОКОФ.ОКОФ
	               |				ИЗ
	               |					КодыОКОФИскл КАК КодыОКОФ)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ОКОФ";
	
	МассивКодов = СтрРазделить(СтрЗаменить(СтрокаКодов, Символы.ПС, ""), ",", Ложь);
	
	МассивУсловий		= Новый Массив;
	МассивУсловийИскл	= Новый Массив;
	
	Для Сч = 0 По МассивКодов.ВГраница() Цикл
		Код = СокрЛ(МассивКодов[Сч]);
		Если Лев(Код, 1) = "-" Тогда
			Код = Сред(Код, 2);
			КудаДобавить = МассивУсловийИскл;
		Иначе
			КудаДобавить = МассивУсловий;
		КонецЕсли;		
		КудаДобавить.Добавить("СправочникОКОФ.Код ПОДОБНО """ + Код + "%""");
	КонецЦикла;
	
	Разделитель = Символы.ПС + Символы.Таб + " ИЛИ ";
	
	ТекстУсловия = СтрСоединить(МассивУсловий, Разделитель);	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Условие1", ?(ТекстУсловия = "", "ЛОЖЬ", ТекстУсловия));
	
	ТекстУсловия = СтрСоединить(МассивУсловийИскл, Разделитель);	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Условие2", ?(ТекстУсловия = "", "ЛОЖЬ", ТекстУсловия));
	
	Запрос = Новый Запрос(ТекстЗапроса);	
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ОКОФ");
	
	Возврат Результат;
	
КонецФункции

// Добавляет описание строки расшифровки в таблицу расшифровок.
// В случае, если таблица расшифровок не инициализирована, выполняется ее инициализация.
//
Процедура ДобавитьСтрокуРасшифровки(ТаблицаРасшифровок, ИмяРаздела = "", Знач ИмяПоказателя, НаименованиеПоказателя,
	НаименованиеСлагаемого = "", Сумма = "", НомерСтраницы = Неопределено, ДобавитьНулевую = Ложь,
	ДополнительныеПараметры = Неопределено) Экспорт
	
	Если ТаблицаРасшифровок = Неопределено Тогда
		ТаблицаРасшифровок = Новый ТаблицаЗначений;
		ТаблицаРасшифровок.Колонки.Добавить("ИмяПоказателя");
		ТаблицаРасшифровок.Колонки.Добавить("НаименованиеПоказателя");
		ТаблицаРасшифровок.Колонки.Добавить("ЗнакОперации");
		ТаблицаРасшифровок.Колонки.Добавить("НаименованиеСлагаемого");
		ТаблицаРасшифровок.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
		ТаблицаРасшифровок.Колонки.Добавить("ИмяРаздела");
		ТаблицаРасшифровок.Колонки.Добавить("ДополнительныеПараметры");
	КонецЕсли;
	
	Если Не ДобавитьНулевую И Не ЗначениеЗаполнено(Сумма) Тогда
		Возврат;
	КонецЕсли;
	
	Если НомерСтраницы <> Неопределено Тогда
		ИмяПоказателя = ИмяПоказателя + "_" + Формат(НомерСтраницы, "ЧН=; ЧГ=");
	КонецЕсли;
	
	Параметры = Новый Структура("НомерСтраницы", НомерСтраницы);
	
	НоваяСтрокаРасшифровки							= ТаблицаРасшифровок.Добавить();
	НоваяСтрокаРасшифровки.ИмяПоказателя			= ИмяПоказателя;
	НоваяСтрокаРасшифровки.НаименованиеПоказателя	= СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(
		НаименованиеПоказателя, Параметры);
	НоваяСтрокаРасшифровки.НаименованиеСлагаемого	= Строка(НаименованиеСлагаемого);
	НоваяСтрокаРасшифровки.Сумма					= Сумма;
	НоваяСтрокаРасшифровки.ИмяРаздела				= ИмяРаздела;
	НоваяСтрокаРасшифровки.ДополнительныеПараметры  = ДополнительныеПараметры;
	
КонецПроцедуры

