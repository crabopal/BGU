	|	ВТ_РазличныеЗаписи.ПроцентУменьшения КАК ПроцентУменьшения,
	|	ВТ_РазличныеЗаписи.СуммаУменьшения КАК СуммаУменьшения,
	|	ВЫБОР
	|		КОГДА ВТ_Разрез.КоличествоЛьгот = 1
	|			ТОГДА ВТ_Разрез.КоличествоМесяцев
	|		ИНАЧЕ ВТ_РазличныеЗаписи.КоличествоМесяцев
	|	КОНЕЦ КАК КоличествоМесяцевВладения,
	|	ВТ_РазличныеЗаписи.КоличествоМесяцевЛьготы КАК КоличествоМесяцевЛьготы,
	|	ЕСТЬNULL(ВТ_ДополнительныеРеквизиты.РегистрационныйЗнак, """") КАК РегистрационныйЗнак,
	|	ЕСТЬNULL(ВТ_ДополнительныеРеквизиты.Марка, """") КАК Марка,
	|	ЕСТЬNULL(ВТ_ДополнительныеРеквизиты.ИдентификационныйНомер, """") КАК ИдентификационныйНомер,
	|	ЕСТЬNULL(ВТ_ДополнительныеРеквизиты.ЭкологическийКласс, """") КАК ЭкологическийКласс,
	|	1 КАК ДоляВПравеОбщейСобственностиЧислитель,
	|	1 КАК ДоляВПравеОбщейСобственностиЗнаменатель,
	|	0 КАК ПовышающийКоэффициент
	|ИЗ
	|	ВТ_Разрез КАК ВТ_Разрез
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_РазличныеЗаписи КАК ВТ_РазличныеЗаписи
	|		ПО ВТ_Разрез.ОсновноеСредство = ВТ_РазличныеЗаписи.ОсновноеСредство
	|			И ВТ_Разрез.КодПоОКАТО = ВТ_РазличныеЗаписи.КодПоОКАТО
	|			И ВТ_Разрез.КодВидаТранспортногоСредства = ВТ_РазличныеЗаписи.КодВидаТранспортногоСредства
	|			И ВТ_Разрез.НалоговаяБаза = ВТ_РазличныеЗаписи.НалоговаяБаза
	|			И ВТ_Разрез.ЕдиницаИзмеренияНалоговойБазы = ВТ_РазличныеЗаписи.ЕдиницаИзмеренияНалоговойБазы
	|			И ВТ_Разрез.НалоговаяСтавка = ВТ_РазличныеЗаписи.НалоговаяСтавка
	|			И (ВТ_Разрез.КоличествоЛьгот <> 1
	|				ИЛИ ВТ_РазличныеЗаписи.НалоговаяЛьгота <> &ЛьготаНеПрименяется)
	|			И ВТ_Разрез.ОсновноеСредство = ВТ_РазличныеЗаписи.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДополнительныеРеквизиты КАК ВТ_ДополнительныеРеквизиты
	|		ПО ВТ_Разрез.ОсновноеСредство = ВТ_ДополнительныеРеквизиты.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СобытияОС.СрезПоследних(
	|				&Период12,
	|				Организация = &Организация
	|					И Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)) КАК СобытияОССрезПоследних
	|		ПО ВТ_Разрез.ОсновноеСредство = СобытияОССрезПоследних.ОсновноеСредство
	|
	|УПОРЯДОЧИТЬ ПО
	|	КодПоОКАТО,
	|	ОсновноеСредство";
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ПутьКРегистру = "(меню ""Учет и отчетность"" - ""Регистрация транспортных средств"")";
	
	Если Выборка.Количество() = 0 Тогда
		
		ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru='Отсутствуют данные о регистрации транспортных средств  на %1 для %2
		|%3'"), 
		ПредставлениеПериода(НачалоДня(ПараметрыОтчета.мДатаНачалаПериодаОтчета), КонецДня(ПараметрыОтчета.мДатаКонцаПериодаОтчета),"ФП = Истина")
		,ПараметрыОтчета.Организация, ПутьКРегистру));
		
		Возврат;
		
	КонецЕсли;
	
	
	ОчиститьРаздел(Контейнер.Раздел2);
	
	ПерваяСтраница = Истина;
		
	Пока Выборка.Следующий() Цикл
		
		СтраницаРаздел2 = ПоказателиРаздела(Контейнер.Раздел2, Не ПерваяСтраница);
		ПерваяСтраница = Ложь;
		
		СтраницаРаздел2.П000020002003 = Выборка.КодПоОКАТО;
		СтраницаРаздел2.П000020003003 = Выборка.КодВидаТранспортногоСредства;
		СтраницаРаздел2.П000020004003 = Выборка.ИдентификационныйНомер;
		СтраницаРаздел2.П000020005003 = Выборка.Марка;
		СтраницаРаздел2.П000020006003 = Выборка.РегистрационныйЗнак;
		СтраницаРаздел2.П000020007003 = Выборка.НалоговаяБаза;
		СтраницаРаздел2.П000020008003 = Выборка.ЕдиницаИзмеренияНалоговойБазы;
		СтраницаРаздел2.П000020009003 = Формат(Выборка.ЭкологическийКласс);
		СтраницаРаздел2.П000020010003 = Выборка.КоличествоПолныхЛет;
		СтраницаРаздел2.П000020011003 = Выборка.КоличествоМесяцевВладения;
		СтраницаРаздел2.П000020012003_Числ = Выборка.ДоляВПравеОбщейСобственностиЧислитель;
		СтраницаРаздел2.П000020012003_Знам = Выборка.ДоляВПравеОбщейСобственностиЗнаменатель;
		СтраницаРаздел2.П000020014003 = Выборка.НалоговаяСтавка;
		СтраницаРаздел2.П000020017003 = Выборка.КоличествоМесяцевЛьготы;
		
		СтраницаРаздел2.П000020019003_КодЛьготы = "";
		СтраницаРаздел2.П000020019003_Основание = "";
		СтраницаРаздел2.П000020020003 = 0;
		СтраницаРаздел2.П000020021003_КодЛьготы = "";
		СтраницаРаздел2.П000020021003_Основание = "";
		СтраницаРаздел2.П000020021003_Процент 	= 0;
		СтраницаРаздел2.П000020022003 = 0;
		СтраницаРаздел2.П000020023003_КодЛьготы = "";
		СтраницаРаздел2.П000020023003_Основание = "";
		СтраницаРаздел2.П000020023003_Ставка 	= 0;
		СтраницаРаздел2.П000020025003 = 0;
		
		НалоговаяЛьгота = Выборка.НалоговаяЛьгота;
		
		Если НалоговаяЛьгота = Перечисления.ВидыНалоговыхЛьготПоТранспортномуНалогу.УменьшениеСуммыНалогаВПроцентах Тогда 
			СтраницаРаздел2.П000020021003_КодЛьготы = Выборка.КодНалоговойЛьготы;
			СтраницаРаздел2.П000020021003_Основание = Выборка.РегиональныйКодЛьготы;
			Если Выборка.ПроцентУменьшения > 0 И Выборка.ПроцентУменьшения < 100 Тогда 
				СтраницаРаздел2.П000020021003_Процент = Выборка.ПроцентУменьшения;
			КонецЕсли;
		ИначеЕсли НалоговаяЛьгота = Перечисления.ВидыНалоговыхЛьготПоТранспортномуНалогу.УменьшениеСуммыНалогаНаСумму Тогда
			СуммаЛьготы = Выборка.СуммаУменьшения;
			СтраницаРаздел2.П000020019003 = 0;
			ТекстСообщения = НСтр("ru = 'Для основного средства ""%1"" (регистрационный знак ""%2"") установлена 
			|налоговая льгота в виде уменьшения суммы налога на %3 руб., которая не применяется с 2012 года.
			|Проверьте и при необходимости измените параметры расчета налога %4.'");
			
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, 
				Выборка.ОсновноеСредство, Выборка.РегистрационныйЗнак, СуммаЛьготы, ПутьКРегистру);
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Выборка.ОсновноеСредство);
		ИначеЕсли НалоговаяЛьгота = Перечисления.ВидыНалоговыхЛьготПоТранспортномуНалогу.ОсвобождениеОтНалогообложения Тогда 
			СтраницаРаздел2.П000020019003_КодЛьготы = Выборка.КодНалоговойЛьготы;
			СтраницаРаздел2.П000020019003_Основание = Выборка.РегиональныйКодЛьготы;
		ИначеЕсли НалоговаяЛьгота = Перечисления.ВидыНалоговыхЛьготПоТранспортномуНалогу.СнижениеНалоговойСтавки Тогда 
			СтраницаРаздел2.П000020023003_КодЛьготы = Выборка.КодНалоговойЛьготы;
			СтраницаРаздел2.П000020023003_Основание = Выборка.РегиональныйКодЛьготы;
			Если Выборка.ЛьготнаяСтавка < Выборка.НалоговаяСтавка Тогда 
				СтраницаРаздел2.П000020023003_Ставка = Выборка.ЛьготнаяСтавка;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьОтчетТранспортныйНалогФормаОтчета2016Кв1(ПараметрыОтчета, Контейнер)
	
	Организация			= ПараметрыОтчета.Организация;
	НалоговыйОрган		= РегламентированнаяОтчетность.ПолучитьПоКодамРегистрациюВИФНС(ПараметрыОтчета.Организация, ПараметрыОтчета.КодНалоговогоОргана, ПараметрыОтчета.КПП);
	ОтчетныйГод			= Год(ПараметрыОтчета.мДатаНачалаПериодаОтчета);
	МесяцНачало			= Месяц(ПараметрыОтчета.мДатаНачалаПериодаОтчета);
	МесяцКонец			= Месяц(ПараметрыОтчета.мДатаКонцаПериодаОтчета);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация"			, Организация);
	Запрос.УстановитьПараметр("НалоговыйОрган"		, НалоговыйОрган);
	Запрос.УстановитьПараметр("ОтчетныйГод"			, ОтчетныйГод);
	Запрос.УстановитьПараметр("ЛьготаНеПрименяется"	, Перечисления.ВидыНалоговыхЛьготПоТранспортномуНалогу.НеПрименяется);
	Запрос.УстановитьПараметр("КонецГода"			, ПараметрыОтчета.мДатаКонцаПериодаОтчета);

	ТекстПодЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА РегистрацияТранспортныхСредствСрезПоследних.КодПоОКАТО <> """"
	|			ТОГДА РегистрацияТранспортныхСредствСрезПоследних.КодПоОКАТО
	|		КОГДА РегистрацияТранспортныхСредствСрезПоследних.НалоговыйОрган <> ЗНАЧЕНИЕ(Справочник.РегистрацииВНалоговомОргане.ПустаяСсылка)
	|			ТОГДА РегистрацияТранспортныхСредствСрезПоследних.НалоговыйОрган.КодПоОКТМО
	|		ИНАЧЕ РегистрацияТранспортныхСредствСрезПоследних.Организация.КодОКТМО
	|	КОНЕЦ КАК КодПоОКАТО,
	|	РегистрацияТранспортныхСредствСрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	РегистрацияТранспортныхСредствСрезПоследних.КодВидаТранспортногоСредства КАК КодВидаТранспортногоСредства,
	|	РегистрацияТранспортныхСредствСрезПоследних.НалоговаяБаза КАК НалоговаяБаза,
	|	РегистрацияТранспортныхСредствСрезПоследних.ЕдиницаИзмеренияНалоговойБазы КАК ЕдиницаИзмеренияНалоговойБазы,
	|	РегистрацияТранспортныхСредствСрезПоследних.НалоговаяСтавка КАК НалоговаяСтавка,
	|	РегистрацияТранспортныхСредствСрезПоследних.НалоговаяЛьгота КАК НалоговаяЛьгота,
	|	РегистрацияТранспортныхСредствСрезПоследних.КодНалоговойЛьготы КАК КодНалоговойЛьготы,
	|	РегистрацияТранспортныхСредствСрезПоследних.РегиональныйКодЛьготы КАК РегиональныйКодЛьготы,
	|	РегистрацияТранспортныхСредствСрезПоследних.ЛьготнаяСтавка КАК ЛьготнаяСтавка,
	|	РегистрацияТранспортныхСредствСрезПоследних.ПроцентУменьшения КАК ПроцентУменьшения,
	|	РегистрацияТранспортныхСредствСрезПоследних.СуммаУменьшения КАК СуммаУменьшения,
	|	РегистрацияТранспортныхСредствСрезПоследних.НалоговаяСтавкаДифференцированная КАК НалоговаяСтавкаДифференцированная
	|ПОМЕСТИТЬ РегистрацияТранспортныхСредств
	|ИЗ
	|	РегистрСведений.РегистрацияТранспортныхСредств.СрезПоследних(&Период, Организация = &Организация) КАК РегистрацияТранспортныхСредствСрезПоследних
	|ГДЕ
	|	РегистрацияТранспортныхСредствСрезПоследних.ВидЗаписи = ЗНАЧЕНИЕ(Перечисление.ВидЗаписиОРегистрации.Регистрация)
	|	И ВЫБОР
	|			КОГДА РегистрацияТранспортныхСредствСрезПоследних.НалоговыйОрган = ЗНАЧЕНИЕ(Справочник.РегистрацииВНалоговомОргане.ПустаяСсылка)
	|				ТОГДА РегистрацияТранспортныхСредствСрезПоследних.Организация.РегистрацияВНалоговомОргане
	|			ИНАЧЕ РегистрацияТранспортныхСредствСрезПоследних.НалоговыйОрган
	|		КОНЕЦ = &НалоговыйОрган";
		
	ТекстыЗапроса = Новый Массив;
	
	Для НомерМесяца = МесяцНачало По МесяцКонец Цикл
		
		НомерМесяцаСтрокой = Строка(НомерМесяца);
		
		Если ТекстыЗапроса.Количество() > 0 Тогда
			ТекстЗапроса = СтрЗаменить(ТекстПодЗапроса, "РАЗРЕШЕННЫЕ", "");
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ПОМЕСТИТЬ РегистрацияТранспортныхСредств", "");
		Иначе
			ТекстЗапроса = ТекстПодЗапроса;
		КонецЕсли;	
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Период", "&Период" + НомерМесяцаСтрокой);	
		
		ТекстыЗапроса.Добавить(ТекстЗапроса);

		Запрос.УстановитьПараметр("Период" + НомерМесяцаСтрокой, Дата(ОтчетныйГод, НомерМесяца, 15, 23, 59, 59));
		
	КонецЦикла;
	
	Запрос.Текст = СтрСоединить(ТекстыЗапроса, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС) + ";" + Символы.ПС + 
	"ВЫБРАТЬ
	|	РегистрацияТранспортныхСредств.ОсновноеСредство КАК ОсновноеСредство,
	|	РегистрацияТранспортныхСредств.КодПоОКАТО КАК КодПоОКАТО,
	|	РегистрацияТранспортныхСредств.КодВидаТранспортногоСредства КАК КодВидаТранспортногоСредства,
	|	РегистрацияТранспортныхСредств.НалоговаяБаза КАК НалоговаяБаза,
	|	РегистрацияТранспортныхСредств.ЕдиницаИзмеренияНалоговойБазы КАК ЕдиницаИзмеренияНалоговойБазы,
	|	РегистрацияТранспортныхСредств.НалоговаяСтавка КАК НалоговаяСтавка,
	|	РегистрацияТранспортныхСредств.НалоговаяЛьгота КАК НалоговаяЛьгота,
	|	РегистрацияТранспортныхСредств.КодНалоговойЛьготы КАК КодНалоговойЛьготы,
	|	РегистрацияТранспортныхСредств.РегиональныйКодЛьготы КАК РегиональныйКодЛьготы,
	|	РегистрацияТранспортныхСредств.ЛьготнаяСтавка КАК ЛьготнаяСтавка,
	|	РегистрацияТранспортныхСредств.ПроцентУменьшения КАК ПроцентУменьшения,
	|	РегистрацияТранспортныхСредств.СуммаУменьшения КАК СуммаУменьшения,
	|	РегистрацияТранспортныхСредств.НалоговаяСтавкаДифференцированная КАК НалоговаяСтавкаДифференцированная,
	|	СУММА(1) КАК КоличествоМесяцев,
	|	СУММА(ВЫБОР
	|			КОГДА РегистрацияТранспортныхСредств.НалоговаяЛьгота = &ЛьготаНеПрименяется
	|				ТОГДА 0
	|			ИНАЧЕ 1
	|		КОНЕЦ) КАК КоличествоМесяцевЛьготы
	|ПОМЕСТИТЬ ВТ_РазличныеЗаписи
	|ИЗ
	|	РегистрацияТранспортныхСредств КАК РегистрацияТранспортныхСредств
	|
	|СГРУППИРОВАТЬ ПО
	|	РегистрацияТранспортныхСредств.ОсновноеСредство,
	|	РегистрацияТранспортныхСредств.КодПоОКАТО,
	|	РегистрацияТранспортныхСредств.КодВидаТранспортногоСредства,
	|	РегистрацияТранспортныхСредств.НалоговаяБаза,
	|	РегистрацияТранспортныхСредств.ЕдиницаИзмеренияНалоговойБазы,
	|	РегистрацияТранспортныхСредств.НалоговаяСтавка,
	|	РегистрацияТранспортныхСредств.НалоговаяЛьгота,
	|	РегистрацияТранспортныхСредств.КодНалоговойЛьготы,
	|	РегистрацияТранспортныхСредств.РегиональныйКодЛьготы,
	|	РегистрацияТранспортныхСредств.ЛьготнаяСтавка,
	|	РегистрацияТранспортныхСредств.ПроцентУменьшения,
	|	РегистрацияТранспортныхСредств.СуммаУменьшения,
	|	РегистрацияТранспортныхСредств.НалоговаяСтавкаДифференцированная
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_РазличныеЗаписи.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ_РазличныеЗаписи.КодПоОКАТО КАК КодПоОКАТО,
