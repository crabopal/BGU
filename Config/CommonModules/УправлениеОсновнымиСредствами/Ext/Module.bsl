		КонецЦикла;
		
		// Таблица 3
		
		РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "П000030101803", Ложь	, Ложь	);
		РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "П000030101903", Ложь	, Ложь	);
		РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "П000030102003", Истина, Истина);
		РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "П000030102103", Истина, Истина);
		РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "П000030102203", Истина, Истина);
		РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "П000030102303", Истина, Истина);
		РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "П000030102403", Истина, Истина);
		
		// Таблица 4
		
		РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "П000040100102", Истина, Истина);
		РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "П000040100103", Истина, Истина);
		
		Если Год2022 Тогда
			РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "П000040102502", Истина, Ложь);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьОтчетФорма11К(ИДРедакцииОтчета, ПараметрыОтчета, Контейнер, ТаблицаРасшифровки = Неопределено) Экспорт
	
	Год = Год(ПараметрыОтчета.мДатаКонцаПериодаОтчета);
	ГодНачалаЗаполненияПоПриказу675 = 2024; 
	
	Если ИДРедакцииОтчета = "ФормаОтчета2013Кв1" Тогда
		ЗаполнитьТитульныйЛистФормы11К(ПараметрыОтчета, Контейнер, ТаблицаРасшифровки);
	ИначеЕсли ИДРедакцииОтчета = "ФормаОтчета2015Кв1" Тогда
		ЗаполнитьТитульныйЛистФормы11К(ПараметрыОтчета, Контейнер, ТаблицаРасшифровки, 2015);
		ЗаполнитьПодразделенияФормы11К(ПараметрыОтчета, Контейнер, ТаблицаРасшифровки, 2015);
	ИначеЕсли ИДРедакцииОтчета = "ФормаОтчета2016Кв1" Тогда
		ЗаполнитьТитульныйЛистФормы11К(ПараметрыОтчета, Контейнер, ТаблицаРасшифровки, 2016);
		ЗаполнитьПодразделенияФормы11К(ПараметрыОтчета, Контейнер, ТаблицаРасшифровки, 2016);
	ИначеЕсли ИДРедакцииОтчета = "ФормаОтчета2017Кв1" Тогда
		ЗаполнитьТитульныйЛистФормы11К(ПараметрыОтчета, Контейнер, ТаблицаРасшифровки, 2017);
		ЗаполнитьПодразделенияФормы11К(ПараметрыОтчета, Контейнер, ТаблицаРасшифровки, 2017);
	ИначеЕсли ИДРедакцииОтчета = "ФормаОтчета2018Кв1" Тогда
		ЗаполнитьТитульныйЛистФормы11К(ПараметрыОтчета, Контейнер, ТаблицаРасшифровки, 2017);
		ЗаполнитьПодразделенияФормы11К(ПараметрыОтчета, Контейнер, ТаблицаРасшифровки, 2017);
	ИначеЕсли ИДРедакцииОтчета = "ФормаОтчета2019Кв1" Тогда
		ЗаполнитьТитульныйЛистФормы11К(ПараметрыОтчета, Контейнер, ТаблицаРасшифровки, 2018);
		ЗаполнитьПодразделенияФормы11К(ПараметрыОтчета, Контейнер, ТаблицаРасшифровки, 2018);
	ИначеЕсли ИДРедакцииОтчета = "ФормаОтчета2020Кв1" Тогда
		ЗаполнитьФормуОтчета11К(ПараметрыОтчета, Контейнер, ТаблицаРасшифровки);
	ИначеЕсли ИДРедакцииОтчета = "ФормаОтчета2021Кв1" Тогда
		ЗаполнитьФормуОтчета11К_2021(ПараметрыОтчета, Контейнер, ТаблицаРасшифровки, 2021);
	ИначеЕсли ИДРедакцииОтчета = "ФормаОтчета2022Кв1" Тогда
		ЗаполнитьФормуОтчета11К_2021(ПараметрыОтчета, Контейнер, ТаблицаРасшифровки, 2022);
	ИначеЕсли ИДРедакцииОтчета = "ФормаОтчета2023Кв1" Тогда
		ЗаполнитьФормуОтчета11К_2021(ПараметрыОтчета, Контейнер, ТаблицаРасшифровки, 2023);
	ИначеЕсли ИДРедакцииОтчета = "ФормаОтчета2024Кв1" И Год >= ГодНачалаЗаполненияПоПриказу675 Тогда
		ЗаполнитьФормуОтчета11К_2024(ПараметрыОтчета, Контейнер, ТаблицаРасшифровки, Год);
	ИначеЕсли ИДРедакцииОтчета = "ФормаОтчета2024Кв1" Тогда
		ЗаполнитьФормуОтчета11К_2021(ПараметрыОтчета, Контейнер, ТаблицаРасшифровки, 2024);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьТитульныйЛистФормы11К(ПараметрыОтчета, Контейнер, ТаблицаРасшифровки, Год = 0)

	ТабДок = ?(Год >= 2015, "ПолеТабличногоДокументаТитульный", "ПолеТабличногоДокументаФормаОтчета");
		
	ДанныеТаблицы = ПолучитьДанныеЗаполненияТаблицыФормы11К(ПараметрыОтчета, Год);
	
	Для Каждого Показатель Из ДанныеТаблицы.Колонки Цикл
		
		ИмяПоля = Показатель.Имя;
		Если ИмяПоля = "ОсновноеСредство" Тогда
			Продолжить;
		КонецЕсли;
		
		НаименованиеПоказателя = ПолучитьНаименованиеПоказателя(ИмяПоля);
		
		Для Каждого ОбщиеСуммы Из ДанныеТаблицы.Строки Цикл
			
			Делитель = ?(Год >=2016, 1, 1000);
			Значение = ОбщиеСуммы[ИмяПоля]/Делитель;
			Контейнер[ТабДок][ИмяПоля] = Значение;
			
			Для Каждого ПоОС Из ОбщиеСуммы.Строки Цикл
				Значение = ПоОС[ИмяПоля]/1000;
				ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки,, ИмяПоля, НаименованиеПоказателя, ПоОС.ОсновноеСредство.Наименование, Значение);
			КонецЦикла;
			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПодразделенияФормы11К(ПараметрыОтчета, Контейнер, ТаблицаРасшифровки, Год = Неопределено)
	
	ДанныеПодразделений = ПолучитьСреднегодовуюСтоимостьФорма11К(ПараметрыОтчета);
	
	ОчиститьРаздел(Контейнер.ТаблицаСтраницыПодразделения);
	НомерСтраницы = 0;
	
	Для Каждого ПоПодразделению Из ДанныеПодразделений.Строки Цикл
		
		НомерСтраницы = НомерСтраницы + 1;
		ПолеПодразделение = ПоказателиРаздела(Контейнер.ТаблицаСтраницыПодразделения, НомерСтраницы > 1);
		
		Если ЗначениеЗаполнено(ПоПодразделению.ОбособленноеПодразделение) Тогда // Обособленное подразделение
			
			Адрес = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ПоПодразделению.ОбособленноеПодразделение,
						Справочники.ВидыКонтактнойИнформации.ФактическийАдресПодразделенияОрганизаций);
						
			ПолеПодразделение.Вставить("ОргНазв",				ПоПодразделению.ОбособленноеПодразделение.НаименованиеПолное);
			ПолеПодразделение.Вставить("КодОКПО",				"");
			ПолеПодразделение.Вставить("ОргАдрес",				Адрес);
			ПолеПодразделение.Вставить("КодОКТМО",				ПоПодразделению.ОбособленноеПодразделение.РегистрацияВНалоговомОргане.КодПоОКТМО);
			ПолеПодразделение.Вставить("НомерПодраздеОения",	ПоПодразделению.ОбособленноеПодразделение.РегистрацияВНалоговомОргане.Код);
			ПолеПодразделение.Вставить("КодОКВЭД",				"");
			
		Иначе // Организация
			
			Адрес = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ПараметрыОтчета.Организация,
				Справочники.ВидыКонтактнойИнформации.ФактАдресОрганизации);
			
			ПолеПодразделение.Вставить("ОргНазв",				ПараметрыОтчета.Организация.НаименованиеПолное);
			ПолеПодразделение.Вставить("КодОКПО",				ПараметрыОтчета.Организация.КодОКПО);
			ПолеПодразделение.Вставить("ОргАдрес",				Адрес);
			ПолеПодразделение.Вставить("КодОКТМО",				ПараметрыОтчета.Организация.КодОКТМО);
			ПолеПодразделение.Вставить("НомерПодраздеОения",	ПараметрыОтчета.Организация.КодНалоговогоОргана);
			ПолеПодразделение.Вставить("КодОКВЭД",				ПараметрыОтчета.Организация.КодОКВЭД);
			
		КонецЕсли;
		
		ПолеПодразделение.Вставить("П0236", ПоПодразделению.СреднегодоваяСтоимость);
		
		// Расшифровка
		
		НаименованиеПоказателя = "Среднегодовая полная учетная стоимость, стр. " + НомерСтраницы;
		
		Для Каждого ПоОС Из ПоПодразделению.Строки Цикл
			ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки,, "П0236", НаименованиеПоказателя,ПоОС.ОсновноеСредство.Наименование, ПоОС.СреднегодоваяСтоимость, НомерСтраницы);	
		КонецЦикла;
		
	КонецЦикла;
	
	// Дозаполним титульный лист
	Если ДанныеПодразделений.Строки.Количество() > 0 Тогда
		Делитель = ?(Год >=2016, 1, 1000);
		ИмяПоля = ?(Год < 2018, "П010003500", "П010002900");
		Контейнер.ПолеТабличногоДокументаТитульный[ИмяПоля] = ДанныеПодразделений.Строки.Итог("СреднегодоваяСтоимость") / Делитель; // Среднегодовая полная учетная стоимость основных фондов
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьНаименованиеПоказателя(ИмяПоля)
	
	Если СтрНачинаетсяС(ИмяПоля, "П01") Тогда // Старый формат
		
		НомерСтроки		= Сред(ИмяПоля, 7, 2);
		НомерПодстроки	= Сред(ИмяПоля, 6, 1);
		НомерКолонки	= Строка(Число(Сред(ИмяПоля, 9, 2)));
		
	Иначе
		
		НомерСтроки		= Сред(ИмяПоля, 4, 2);
		НомерПодстроки	= Сред(ИмяПоля, 7, 1);
		НомерКолонки	= Строка(Число(Сред(ИмяПоля, 8, 2)));	
		
	КонецЕсли;

	НаименованиеПоказателя = "Строка № " + НомерСтроки + ?(НомерПодстроки = "0", "", "." + НомерПодстроки) + ", колонка " + НомерКолонки;
	
	Возврат НаименованиеПоказателя;
	
КонецФункции

Функция ПолучитьДанныеЗаполненияТаблицыФормы11К(ПараметрыОтчета, Год)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	СобытияОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	МИНИМУМ(СобытияОССрезПоследних.ДатаСобытия) КАК ДатаПринятияКУчету
	|ПОМЕСТИТЬ ВТ_События
	|ИЗ
	|	РегистрСведений.СобытияОС.СрезПоследних(
	|			&КонецПериода,
	|			Организация = &Организация
	|				И ОсновноеСредство.ИмуществоКазны = &ИмуществоКазны
	|				И Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)) КАК СобытияОССрезПоследних
	|ГДЕ
	|	СобытияОССрезПоследних.ДатаСобытия <> ДАТАВРЕМЯ(1, 1, 1)
	|
	|СГРУППИРОВАТЬ ПО
	|	СобытияОССрезПоследних.ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.ПервоначальнаяСтоимость КАК ПервоначальнаяСтоимость
	|ПОМЕСТИТЬ ВТ_ПервоначальныеСведения
	|ИЗ
	|	РегистрСведений.ПервоначальныеСведенияОСБухгалтерскийУчет.СрезПоследних(
	|			&КонецПериода,
	|			Организация = &Организация
	|				И ОсновноеСредство.ИмуществоКазны = &ИмуществоКазны) КАК ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_События.ОсновноеСредство КАК Ссылка
	|ПОМЕСТИТЬ ВТ_ОсФонда
	|ИЗ
	|	ВТ_События КАК ВТ_События
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПервоначальныеСведения КАК ВТ_ПервоначальныеСведения
	|		ПО ВТ_События.ОсновноеСредство = ВТ_ПервоначальныеСведения.ОсновноеСредство
	|ГДЕ
	|	ВЫБОР
	|			КОГДА ВТ_События.ДатаПринятияКУчету < ДАТАВРЕМЯ(2009, 1, 1)
	|				ТОГДА ВЫБОР
	|						КОГДА ВТ_ПервоначальныеСведения.ПервоначальнаяСтоимость < 10000
	|							ТОГДА ЛОЖЬ
	|						ИНАЧЕ ИСТИНА
	|					КОНЕЦ
	|			КОГДА ВТ_События.ДатаПринятияКУчету < ДАТАВРЕМЯ(2011, 1, 1)
	|				ТОГДА ВЫБОР
	|						КОГДА ВТ_ПервоначальныеСведения.ПервоначальнаяСтоимость < 20000
	|							ТОГДА ЛОЖЬ
	|						ИНАЧЕ ИСТИНА
	|					КОНЕЦ
	|			КОГДА ВТ_События.ДатаПринятияКУчету < ДАТАВРЕМЯ(2018, 1, 1)
	|				ТОГДА ВЫБОР
	|						КОГДА ВТ_ПервоначальныеСведения.ПервоначальнаяСтоимость < 40000
	|							ТОГДА ЛОЖЬ
	|						ИНАЧЕ ИСТИНА
	|					КОНЕЦ
	|			ИНАЧЕ ВЫБОР
	|					КОГДА ВТ_ПервоначальныеСведения.ПервоначальнаяСтоимость < 100000
	|						ТОГДА ЛОЖЬ
	|					ИНАЧЕ ИСТИНА
	|				КОНЕЦ
	|		КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕПСБУОбороты.Субконто1 КАК ОС,
	|	ЕПСБУОбороты.СуммаОборотДт КАК Сумма
