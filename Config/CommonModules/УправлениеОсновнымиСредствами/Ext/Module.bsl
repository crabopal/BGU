		СтраницаРаздел2.П000020010003			= Выборка.ЕдиницаИзмеренияНалоговойБазы;
		СтраницаРаздел2.П000020011003			= Формат(Выборка.ЭкологическийКласс);
		СтраницаРаздел2.П000020012003			= Выборка.КоличествоПолныхЛет;		
		СтраницаРаздел2.П000020013003			= Формат(Выборка.ГодВыпуска, "ЧГ=");
		СтраницаРаздел2.П000020014003			= Выборка.КоличествоМесяцевВладения;
		СтраницаРаздел2.П000020015003_Числ		= Выборка.ДоляВПравеОбщейСобственностиЧислитель;
		СтраницаРаздел2.П000020015003_Знам		= Выборка.ДоляВПравеОбщейСобственностиЗнаменатель;
		СтраницаРаздел2.П000020017003			= Выборка.НалоговаяСтавка;
		СтраницаРаздел2.П000020018003			= 0;
		СтраницаРаздел2.П000020020003			= Выборка.КоличествоМесяцевЛьготы;
			
		Если Выборка.НалоговаяЛьгота = Перечисления.ВидыНалоговыхЛьготПоТранспортномуНалогу.ОсвобождениеОтНалогообложения Тогда 
			СтраницаРаздел2.П000020022003_КодЛьготы = Выборка.КодНалоговойЛьготы;
			СтраницаРаздел2.П000020022003_Основание = Выборка.РегиональныйКодЛьготы;
		ИначеЕсли Выборка.НалоговаяЛьгота = Перечисления.ВидыНалоговыхЛьготПоТранспортномуНалогу.УменьшениеСуммыНалогаВПроцентах Тогда 
			СтраницаРаздел2.П000020024003_КодЛьготы	= Выборка.КодНалоговойЛьготы;
			СтраницаРаздел2.П000020024003_Основание	= Выборка.РегиональныйКодЛьготы;
			СтраницаРаздел2.П000020024003_Процент	= Макс(Мин(Выборка.ПроцентУменьшения, 100), 0);
		ИначеЕсли Выборка.НалоговаяЛьгота = Перечисления.ВидыНалоговыхЛьготПоТранспортномуНалогу.СнижениеНалоговойСтавки Тогда 
			СтраницаРаздел2.П000020026003_КодЛьготы	= Выборка.КодНалоговойЛьготы;
			СтраницаРаздел2.П000020026003_Основание	= Выборка.РегиональныйКодЛьготы;
			СтраницаРаздел2.П000020026003_Ставка	= Мин(Выборка.ЛьготнаяСтавка, Выборка.НалоговаяСтавка);
		ИначеЕсли Выборка.НалоговаяЛьгота = Перечисления.ВидыНалоговыхЛьготПоТранспортномуНалогу.УменьшениеСуммыНалогаНаСумму Тогда
			СтраницаРаздел2.П000020026003_КодЛьготы	= Выборка.КодНалоговойЛьготы;
			СтраницаРаздел2.П000020026003_Основание	= Выборка.РегиональныйКодЛьготы;			
			ТекстСообщения = НСтр("ru = 'Для основного средства ""%1"" (регистрационный знак ""%2"") установлена 
			|налоговая льгота в виде уменьшения суммы налога на %3 руб., которая не применяется с 2012 года.
			|Проверьте и при необходимости измените параметры расчета налога %4.'");			
