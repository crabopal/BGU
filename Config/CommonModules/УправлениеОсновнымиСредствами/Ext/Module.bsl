Функция ПериодСтроительства(Выборка, ПериодНачало)
	
	Если Не ЗначениеЗаполнено(Выборка.ДатаРегистрацииПравНаОбъектНедвижимости) 
		Или Не ЗначениеЗаполнено(Выборка.ДатаНачалаПроектирования) Тогда
		Возврат "";
	КонецЕсли;
	
	Если Выборка.ДатаРегистрацииЗемли >= Дата(2008,1,1) Тогда	  
		Если Выборка.ДатаРегистрацииПравНаОбъектНедвижимости > ПериодНачало Тогда
			Период = Выборка.ДатаРегистрацииЗемли;
		Иначе
			Возврат "";
		КонецЕсли;
	ИначеЕсли Выборка.ДатаРегистрацииПравНаОбъектНедвижимости = ПериодНачало Тогда
		Период = Выборка.ДатаНачалаПроектирования;
	Иначе
		Возврат "";
	КонецЕсли;
	
	ПериодПроектированияИСтроительства = РассчитатьМесяцыЭксплуатации(, Период, ПериодНачало) / 12;	
	Результат = ?(ПериодПроектированияИСтроительства > 3, "2", "1");
	
	Возврат Результат;
	
КонецФункции

