	|		ПО СписокОсновныхСредств.ОсновноеСредство = ОстатокВсего.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			Остатки.ОсновноеСредство КАК ОсновноеСредство,
	|			СУММА(Остатки.СуммаОстатокКт) КАК СуммаОстатокКт
	|		ИЗ
	|			Остатки КАК Остатки
	|		ГДЕ
	|			Остатки.Амортизация
	|		
	|		СГРУППИРОВАТЬ ПО
	|			Остатки.ОсновноеСредство) КАК АмортизиацияВсего
	|		ПО СписокОсновныхСредств.ОсновноеСредство = АмортизиацияВсего.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			Остатки.ОсновноеСредство КАК ОсновноеСредство,
	|			Остатки.ЦМО КАК ЦМО,
	|			СУММА(Остатки.СуммаОстатокДт) КАК СуммаОстатокДт,
	|			СУММА(Остатки.КоличествоОстатокДт) КАК КоличествоОстатокДт
	|		ИЗ
	|			Остатки КАК Остатки
	|		ГДЕ
	|			НЕ Остатки.Амортизация
	|		
	|		СГРУППИРОВАТЬ ПО
	|			Остатки.ОсновноеСредство,
	|			Остатки.ЦМО) КАК ОстатокПоМОЛ
	|		ПО СписокОсновныхСредств.ОсновноеСредство = ОстатокПоМОЛ.ОсновноеСредство
	|			И СписокОсновныхСредств.ЦМО = ОстатокПоМОЛ.ЦМО";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеМоментВремени",	УсловиеМоментВремени);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПодразделение", 	УсловиеПодразделение);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", 			УсловиеИФО);
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Процедура ПолучитьОстаткиОСпоТаблицеОстатков(ТаблицаОС, ОсновноеСредство, ИнвентарныйНомер, Количество, Сумма, Амортизация, Цена, МассивВыбранныхИнвНомеров=Неопределено) Экспорт
	КоличествоВТаблице = ТаблицаОС.Количество();
	Если КоличествоВТаблице = 0 Тогда
	//	Количество 	= 0;
		Сумма		= 0;
		Цена		= 0;
		Амортизация = 0;
		Возврат;
	КонецЕсли;
	
	ТекСтрокаОС = Неопределено;
	
	Если КоличествоВТаблице = 1 Тогда
		// если количество =1, то либо в таблице ОС без инв. номера, либо единственный Инв. номер
		ТекСтрокаОС = ТаблицаОС[0];
	Иначе
		ПараметрыОтбора = Новый Структура("ОсновноеСредство", ОсновноеСредство);
		Если ЗначениеЗаполнено(ИнвентарныйНомер) Тогда
			ПараметрыОтбора.Вставить("ИнвНомер", ИнвентарныйНомер);
		КонецЕсли;
		НайденыСтроки = ТаблицаОС.НайтиСтроки(ПараметрыОтбора);
		Если НайденыСтроки.Количество() = 0 Тогда
			Количество 	= 0;
			Сумма		= 0;
			Цена		= 0;
			Возврат;
		ИначеЕсли НайденыСтроки.Количество() = 1 Тогда
			ТекСтрокаОС = НайденыСтроки[0];
		Иначе
			// если найдены несколько строк, значит в таблице ОС с разными инв. номерами
			// если передан МассивВыбранныхИнвНомеров, то выберем следующий инв. номер
			// если не передан - то берем самый первый инв. номер
			
			Если МассивВыбранныхИнвНомеров = Неопределено Тогда
				ТекСтрокаОС = НайденыСтроки[0];
			Иначе
				Для каждого ТекНайденаСтрока Из НайденыСтроки Цикл
				
					Если МассивВыбранныхИнвНомеров.Найти(ТекНайденаСтрока.ИнвНомер) = Неопределено Тогда
						ТекСтрокаОС = ТекНайденаСтрока;
						Прервать;
					КонецЕсли;
				
				КонецЦикла; 
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ТекСтрокаОС = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИнвентарныйНомер 	= ТекСтрокаОС.ИнвНомер;
	Цена				= ТекСтрокаОС.ЦенаЕдиницы;
	Амортизация			= ТекСтрокаОС.АмортизацияТекОС;
	Если Количество = 0 Тогда
		Количество = 1;
	ИначеЕсли Количество > ТекСтрокаОС.КоличествоМОЛ Тогда
		Количество = ТекСтрокаОС.КоличествоМОЛ;
	КонецЕсли;
	
	Если Количество = ТекСтрокаОС.КоличествоМОЛ Тогда
		Сумма = ТекСтрокаОС.СуммаОстатокПоМОЛ;
	Иначе
		Сумма = Количество * Цена;
	КонецЕсли;
	
КонецПроцедуры

// Функция рассчитывает забалансовую стоимость для списка ОС.
// Параметры:
//	СписокОС - СправочникСсылка.ОсновныеСредства или Массив 
//	Период	- Дата - период рассчета
//	Организация - СправочникСсылка.Организации
//	КФО - ПеречислениеСсылка.КВД
//	КПС - СправочникСсылка.КлассификационныеПризнакиСчетов
//	ЦМО - СправочникСсылка.ЦМО
//	ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения
//	Подразделение - СправочникСсылка.Подразделения
//	СписокКонтрагентов
//
// Возвращаемое значение:
//	ТаблицаЗначений, содержащая колонки:
//		СчетУчета
//		КПСУчета
//		ОсновноеСредство
//		ЦМО
//		БалансоваяСтоимость
//		Количество
//		СчетАмортизации
//		СуммаАмортизации
//
Функция ОпределитьЗабСтоимостьСпискаОС(СписокОС, Период, Организация, КФО, КПС, ЦМО, ИФО=Неопределено, Подразделение = Неопределено) Экспорт
	
	Если ТипЗнч(СписокОС) <> Тип("Массив") Тогда
		МассивОС = Новый Массив;
		МассивОС.Добавить(СписокОС);
	Иначе
		МассивОС = СписокОС;
	КонецЕсли;
	
	ПризнакиУчета = БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("21");
	ИспользоватьУчетПоИФО 				= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ИспользоватьУчетПоПодразделениям 	= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
										И ПризнакиУчета.УчетПоПодразделениям;
	ИспользоватьУчетПоКПС				= ПризнакиУчета.УчетПоКПС;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ИспользоватьУчетПоИФО",				ИспользоватьУчетПоИФО);
	Запрос.УстановитьПараметр("ИспользоватьУчетПоКПС",				ИспользоватьУчетПоКПС);
	Запрос.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",	ИспользоватьУчетПоПодразделениям);
	Запрос.УстановитьПараметр("Период",								Период);
	Запрос.УстановитьПараметр("Граница",							Новый Граница(Период, ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("ИФО",								ИФО);
	Запрос.УстановитьПараметр("КФО",								КФО);
	Запрос.УстановитьПараметр("ПоВсемКФО",							КФО = Неопределено);
	Запрос.УстановитьПараметр("КПС",								КПС);
	Запрос.УстановитьПараметр("ПоВсемКПС",							КПС = Неопределено);
	Запрос.УстановитьПараметр("ЦМО",								ЦМО);
	Запрос.УстановитьПараметр("Организация",						Организация);
	Запрос.УстановитьПараметр("Подразделение",						Подразделение);
	Запрос.УстановитьПараметр("СписокОС",							СписокОС);
	Запрос.УстановитьПараметр("СчетУчета",							БухгалтерскийУчет.СписокСчетов("101.00"));
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УчетныеДанныеОС.Организация КАК Организация,
	|	УчетныеДанныеОС.ОсновноеСредство КАК ОсновноеСредство,
	|	УчетныеДанныеОС.СчетУчета КАК СчетУчета
	|ПОМЕСТИТЬ УчетныеДанные
	|ИЗ
	|	РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних(&Граница, Организация = &Организация) КАК УчетныеДанныеОС
	|ГДЕ
	|	УчетныеДанныеОС.СчетУчета В(&СчетУчета)
	|	И УчетныеДанныеОС.ОсновноеСредство В(&СписокОС)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Организация,
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОсновныеСредства.Ссылка КАК ОС,
	|	ЕСТЬNULL(УчетныеДанные.СчетУчета, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) КАК СчетУчета
	|ПОМЕСТИТЬ ОсновныеСредстваИСчета
	|ИЗ
	|	Справочник.ОсновныеСредства КАК ОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ УчетныеДанные КАК УчетныеДанные
	|		ПО ОсновныеСредства.Ссылка = УчетныеДанные.ОсновноеСредство
	|			И ОсновныеСредства.Организация = УчетныеДанные.Организация
	|ГДЕ
	|	ОсновныеСредства.Ссылка В(&СписокОС)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ОсновныеСредстваИСчета.СчетУчета КАК СчетУчета,
	|	СоответствиеСчетовОС.СчетАмортизации КАК СчетАмортизации,
	|	СоответствиеСчетовОС.ЗабалансовыйСчет КАК ЗабалансовыйСчет
	|ПОМЕСТИТЬ СчетаОС
	|ИЗ
	|	ОсновныеСредстваИСчета КАК ОсновныеСредстваИСчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеСчетовОС КАК СоответствиеСчетовОС
	|		ПО ОсновныеСредстваИСчета.СчетУчета = СоответствиеСчетовОС.СчетОС,
	|	Справочник.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредстваИСчета.ОС В(&СписокОС)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Т.Счет КАК Счет,
	|	Т.ОсновноеСредство КАК ОсновноеСредство,
	|	Т.ЦМО КАК ЦМО,
	|	Т.Сумма КАК Сумма,
	|	Т.СуммаТекОС КАК СуммаТекОС,
	|	Т.СуммаМОЛ КАК СуммаМОЛ,
	|	Т.Количество КАК Количество,
	|	Т.КоличествоМОЛ КАК КоличествоМОЛ,
	|	Т.ИФО КАК ИФО,
	|	Т.КПС КАК КПС,
	|	Т.Подразделение КАК Подразделение,
	|	Т.КФО КАК КФО,
	|	ВЫБОР
	|		КОГДА Т.Количество = 0
	|			ТОГДА 0
	|		ИНАЧЕ ВЫРАЗИТЬ(Т.Сумма / Т.Количество КАК ЧИСЛО(18, 2))
	|	КОНЕЦ КАК Цена
	|ИЗ
	|	(ВЫБРАТЬ
	|		ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|		ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОсновноеСредство,
	|		ЖурналПроводокЕПСБУОстатки.Субконто2 КАК ЦМО,
	|		СУММА(ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт) КАК Сумма,
	|		СУММА(ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт) КАК СуммаТекОС,
	|		СУММА(ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт) КАК СуммаМОЛ,
	|		СУММА(ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт) КАК Количество,
	|		СУММА(ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт) КАК КоличествоМОЛ,
	|		ВЫБОР
	|			КОГДА &ИспользоватьУчетПоИФО
	|				ТОГДА ЖурналПроводокЕПСБУОстатки.ИФО
	|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	|		КОНЕЦ КАК ИФО,
	|		ВЫБОР
	|			КОГДА &ИспользоватьУчетПоКПС
	|				ТОГДА ЖурналПроводокЕПСБУОстатки.КПС
	|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)
	|		КОНЕЦ КАК КПС,
	|		ВЫБОР
	|			КОГДА &ИспользоватьУчетПоПодразделениям
	|				ТОГДА ЖурналПроводокЕПСБУОстатки.Подразделение
	|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|		КОНЕЦ КАК Подразделение,
	|		ЖурналПроводокЕПСБУОстатки.КФО КАК КФО
	|	ИЗ
	|		РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|				&Период,
	|				Счет В
	|					(ВЫБРАТЬ
	|						СчетаОС.ЗабалансовыйСчет
	|					ИЗ
	|						СчетаОС),
	|				,
	|				Организация = &Организация
	|					И (&ИспользоватьУчетПоИФО = ЛОЖЬ
	|						ИЛИ ИФО = &ИФО)
	|					И (&ИспользоватьУчетПоПодразделениям = ЛОЖЬ
	|						ИЛИ Подразделение = &Подразделение)
	|					И (&ИспользоватьУчетПоКПС = ЛОЖЬ
	|						ИЛИ &ПоВсемКПС = ИСТИНА
	|						ИЛИ КПС = &КПС)
	|					И (КФО = &КФО
	|						ИЛИ &ПоВсемКФО = ИСТИНА)
	|					И Субконто1 В (&СписокОС)
	|					И Субконто2 = &ЦМО) КАК ЖурналПроводокЕПСБУОстатки
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ЖурналПроводокЕПСБУОстатки.Счет,
	|		ЖурналПроводокЕПСБУОстатки.Субконто1,
	|		ЖурналПроводокЕПСБУОстатки.Субконто2,
	|		ЖурналПроводокЕПСБУОстатки.КФО,
	|		ВЫБОР
	|			КОГДА &ИспользоватьУчетПоИФО
	|				ТОГДА ЖурналПроводокЕПСБУОстатки.ИФО
	|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	|		КОНЕЦ,
	|		ВЫБОР
	|			КОГДА &ИспользоватьУчетПоКПС
	|				ТОГДА ЖурналПроводокЕПСБУОстатки.КПС
	|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)
	|		КОНЕЦ,
	|		ВЫБОР
	|			КОГДА &ИспользоватьУчетПоПодразделениям
	|				ТОГДА ЖурналПроводокЕПСБУОстатки.Подразделение
	|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|		КОНЕЦ) КАК Т";
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// исп
Функция ОпределитьСтоимостьСпискаОСАренда(СписокОС, Период, Организация, КФО, КПС, ЦМО, ИФО = Неопределено, Подразделение = Неопределено, Контрагент = Неопределено) Экспорт
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	СписокСчетов 		= Новый Массив;
	СчетаАмортизации	= Новый Массив;
	
	Если Контрагент = Неопределено Тогда
		Контрагент = Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;
	
	Если ТипЗнч(СписокОС) <> Тип("Массив") Тогда
		ВрМассив = Новый Массив;
		ВрМассив.Добавить(СписокОС);
	Иначе
		ВрМассив = СписокОС;
	КонецЕсли;
	
	Если ВрМассив.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Для каждого ТекОС Из ВрМассив Цикл
		СписокСчетов.Добавить(УправлениеОсновнымиСредствами.СчетУчетаОС(ТекОС, Период));
	КонецЦикла;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	МАКСИМУМ(ЕПСБУ.УчетПоПодразделениям) КАК УчетПоПодразделениям,
				   |	Максимум(ЕПСБУ.УчетПоКПС) Как УчетПоКПС
	               |ИЗ
	               |	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	               |ГДЕ
	               |	ЕПСБУ.Ссылка В(&СписокСчетов)";
	Запрос.УстановитьПараметр("СписокСчетов", СписокСчетов);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		ЕстьУчетПоПодразделениям = Ложь;
		УчетПоКПС = Ложь;
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		ЕстьУчетПоПодразделениям = Выборка.УчетПоПодразделениям;
		УчетПоКПС = Выборка.УчетПоКПС;
	КонецЕсли;
	
	ВидыСубконто = Новый Массив;
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
	
	Запрос.УстановитьПараметр("Период", 							Период);
	Запрос.УстановитьПараметр("СписокСчетов", 						СписокСчетов);
	Запрос.УстановитьПараметр("ВидыСубконто", 						ВидыСубконто);
	Запрос.УстановитьПараметр("Счет104",							БухгалтерскийУчет.СписокСчетов("104.00"));
	Запрос.УстановитьПараметр("Организация", 						Организация);
	Запрос.УстановитьПараметр("КФО", 								КФО);
	Запрос.УстановитьПараметр("КПС", 								КПС);
	Запрос.УстановитьПараметр("ЦМО", 								ЦМО);
	Запрос.УстановитьПараметр("ИФО", 								ИФО);
	Запрос.УстановитьПараметр("Подразделение", 						Подразделение);
	Запрос.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",	ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") И ЕстьУчетПоПодразделениям);
	Запрос.УстановитьПараметр("ИспользоватьУчетПоИФО", 				ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Запрос.УстановитьПараметр("СписокОС", 							ВрМассив);
	Запрос.УстановитьПараметр("УчетПоКПС", 							УчетПоКПС);
	Запрос.УстановитьПараметр("Контрагент",							Контрагент);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвНомер,
	|	СтоимостьОбъектовОСОстатки.ЦМО КАК ЦМО,
	|	СтоимостьОбъектовОСОстатки.Подразделение КАК Подразделение,
	|	ВЫБОР
	|		КОГДА НЕ СобытияОССрезПоследних.Событие ЕСТЬ NULL
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ВведеноВЭкспл,
	|	ВЫБОР
	|		КОГДА СтоимостьОбъектовОСОстатки.ИнвентарныйНомер = ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК БезИнвНомера
	|ПОМЕСТИТЬ СписокОсновныхСредств
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)
	|				И ОсновноеСредство В (&СписокОС)) КАК СтоимостьОбъектовОСОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СобытияОС.СрезПоследних(
	|				&Период,
	|				Организация = &Организация
	|					И Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВводВЭксплуатацию)
	|					И ОсновноеСредство В (&СписокОС)) КАК СобытияОССрезПоследних
	|		ПО СтоимостьОбъектовОСОстатки.ОсновноеСредство = СобытияОССрезПоследних.ОсновноеСредство
	|			И СтоимостьОбъектовОСОстатки.ИнвентарныйНомер = СобытияОССрезПоследних.ИнвНомер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СписокОсновныхСредств.ОсновноеСредство КАК ОсновноеСредство,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СписокОсновныхСредств.ИнвНомер) КАК КоличествоВЭкспл
	|ПОМЕСТИТЬ КоличествоВведенныхВЭксплуатацию
	|ИЗ
	|	СписокОсновныхСредств КАК СписокОсновныхСредств
	|ГДЕ
	|	СписокОсновныхСредств.ВведеноВЭкспл
	|
	|СГРУППИРОВАТЬ ПО
	|	СписокОсновныхСредств.ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОсновноеСредство,
	|	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК ЦМО,
	|	ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Контрагент,
	|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
	|	ЖурналПроводокЕПСБУОстатки.ИФО КАК ИФО,
	|	ЖурналПроводокЕПСБУОстатки.Организация КАК Организация,
	|	ЖурналПроводокЕПСБУОстатки.Подразделение КАК Подразделение,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОстатки.Счет В (&Счет104)
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.СуммаОстатокКт
	|		ИНАЧЕ ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт
	|	КОНЕЦ КАК СуммаОстаток,
	|	ЛОЖЬ КАК Амортизация,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК Количество
	|ПОМЕСТИТЬ СтоимостьОсновныхСредств
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В (&СписокСчетов),
	|			&ВидыСубконто,
	|			Организация = &Организация
	|				И (КПС = &КПС
	|					ИЛИ НЕ &УчетПоКПС)
	|				И КФО = &КФО
	|				И Субконто1 В (&СписокОС)
	|				И (ИФО = &ИФО
	|					ИЛИ НЕ &ИспользоватьУчетПоИФО
	|					ИЛИ &ИФО = ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	|					ИЛИ &ИФО = НЕОПРЕДЕЛЕНО)
	|				И (Подразделение = &Подразделение
	|					ИЛИ НЕ &ИспользоватьУчетПоПодразделениям
	|					ИЛИ &Подразделение = НЕОПРЕДЕЛЕНО
	|					ИЛИ &Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))
	|				И (субконто3 = &Контрагент
	|					ИЛИ &Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))) КАК ЖурналПроводокЕПСБУОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтоимостьОсновныхСредств.Счет КАК Счет,
	|	СтоимостьОсновныхСредств.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьОсновныхСредств.КПС КАК КПС,
	|	СтоимостьОсновныхСредств.ИФО КАК ИФО,
	|	СтоимостьОсновныхСредств.Организация КАК Организация,
	|	СтоимостьОсновныхСредств.Подразделение КАК Подразделение,
	|	СтоимостьОсновныхСредств.КФО КАК КФО,
	|	СУММА(СтоимостьОсновныхСредств.СуммаОстаток) КАК СуммаОстаток,
	|	СУММА(СтоимостьОсновныхСредств.Количество) КАК Количество,
	|	СтоимостьОсновныхСредств.Контрагент КАК Контрагент
	|ПОМЕСТИТЬ СтоимостьОсновныхСредствПоМОЛ
	|ИЗ
	|	СтоимостьОсновныхСредств КАК СтоимостьОсновныхСредств
	|ГДЕ
	|	СтоимостьОсновныхСредств.ЦМО = &ЦМО
	|	И НЕ СтоимостьОсновныхСредств.Амортизация
	|
	|СГРУППИРОВАТЬ ПО
	|	СтоимостьОсновныхСредств.Счет,
	|	СтоимостьОсновныхСредств.ОсновноеСредство,
	|	СтоимостьОсновныхСредств.КПС,
	|	СтоимостьОсновныхСредств.ИФО,
	|	СтоимостьОсновныхСредств.Организация,
	|	СтоимостьОсновныхСредств.Подразделение,
	|	СтоимостьОсновныхСредств.КФО,
	|	СтоимостьОсновныхСредств.Контрагент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтоимостьОсновныхСредствБал.Счет КАК Счет,
	|	СтоимостьОсновныхСредствБал.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьОсновныхСредствБал.КПС КАК КПС,
	|	СтоимостьОсновныхСредствБал.ИФО КАК ИФО,
	|	СтоимостьОсновныхСредствБал.Организация КАК Организация,
	|	СтоимостьОсновныхСредствБал.Подразделение КАК Подразделение,
	|	СтоимостьОсновныхСредствБал.КФО КАК КФО,
	|	СУММА(СтоимостьОсновныхСредствБал.СуммаОстаток) КАК СуммаВсего,
	|	СУММА(СтоимостьОсновныхСредствБал.Количество) КАК КоличествоВсего,
	|	СтоимостьОсновныхСредствАморт.СуммаОстаток КАК АмортизацияВсего,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(СписокОсновныхСредств.ИнвНомер, ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
	|			ТОГДА СтоимостьОсновныхСредствПоМОЛ.СуммаОстаток
	|		ИНАЧЕ ВЫРАЗИТЬ(СтоимостьОсновныхСредствПоМОЛ.СуммаОстаток / СтоимостьОсновныхСредствПоМОЛ.Количество КАК ЧИСЛО(15, 2))
	|	КОНЕЦ КАК СуммаМОЛ,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(СписокОсновныхСредств.ИнвНомер, ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
	|			ТОГДА СтоимостьОсновныхСредствПоМОЛ.Количество
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК КоличествоМОЛ,
	|	СписокОсновныхСредств.ИнвНомер КАК ИнвНомер,
	|	СтоимостьОсновныхСредствПоМОЛ.СуммаОстаток / СтоимостьОсновныхСредствПоМОЛ.Количество КАК СуммаТекОС,
	|	ВЫБОР
	|		КОГДА СписокОсновныхСредств.ВведеноВЭкспл
	|				И НЕ КоличествоВведенныхВЭксплуатацию.КоличествоВЭкспл = 0
	|			ТОГДА СтоимостьОсновныхСредствАморт.СуммаОстаток / КоличествоВведенныхВЭксплуатацию.КоличествоВЭкспл
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК АмортизацияТекОС,
	|	СтоимостьОсновныхСредствБал.Контрагент КАК Контрагент
	|ИЗ
	|	СтоимостьОсновныхСредств КАК СтоимостьОсновныхСредствБал
	|		ЛЕВОЕ СОЕДИНЕНИЕ СтоимостьОсновныхСредств КАК СтоимостьОсновныхСредствАморт
	|		ПО СтоимостьОсновныхСредствБал.ОсновноеСредство = СтоимостьОсновныхСредствАморт.ОсновноеСредство
	|			И (СтоимостьОсновныхСредствАморт.Амортизация)
	|		ЛЕВОЕ СОЕДИНЕНИЕ СтоимостьОсновныхСредствПоМОЛ КАК СтоимостьОсновныхСредствПоМОЛ
	|		ПО СтоимостьОсновныхСредствБал.ОсновноеСредство = СтоимостьОсновныхСредствПоМОЛ.ОсновноеСредство
	|			И СтоимостьОсновныхСредствБал.Счет = СтоимостьОсновныхСредствПоМОЛ.Счет
	|		ЛЕВОЕ СОЕДИНЕНИЕ СписокОсновныхСредств КАК СписокОсновныхСредств
	|		ПО СтоимостьОсновныхСредствБал.ОсновноеСредство = СписокОсновныхСредств.ОсновноеСредство
	|			И (СписокОсновныхСредств.ЦМО = &ЦМО)
	|		ЛЕВОЕ СОЕДИНЕНИЕ КоличествоВведенныхВЭксплуатацию КАК КоличествоВведенныхВЭксплуатацию
	|		ПО СтоимостьОсновныхСредствБал.ОсновноеСредство = КоличествоВведенныхВЭксплуатацию.ОсновноеСредство
	|ГДЕ
	|	НЕ СтоимостьОсновныхСредствБал.Амортизация
	|
	|СГРУППИРОВАТЬ ПО
	|	СтоимостьОсновныхСредствБал.Счет,
	|	СтоимостьОсновныхСредствБал.ОсновноеСредство,
	|	СтоимостьОсновныхСредствБал.КПС,
	|	СтоимостьОсновныхСредствБал.ИФО,
	|	СтоимостьОсновныхСредствБал.Организация,
	|	СтоимостьОсновныхСредствБал.Подразделение,
	|	СтоимостьОсновныхСредствБал.КФО,
	|	СтоимостьОсновныхСредствАморт.СуммаОстаток,
	|	СтоимостьОсновныхСредствПоМОЛ.СуммаОстаток,
	|	СтоимостьОсновныхСредствПоМОЛ.Количество,
	|	СписокОсновныхСредств.ИнвНомер,
	|	ВЫБОР
	|		КОГДА СписокОсновныхСредств.ВведеноВЭкспл
	|				И НЕ КоличествоВведенныхВЭксплуатацию.КоличествоВЭкспл = 0
	|			ТОГДА СтоимостьОсновныхСредствАморт.СуммаОстаток / КоличествоВведенныхВЭксплуатацию.КоличествоВЭкспл
	|		ИНАЧЕ 0
	|	КОНЕЦ,
	|	СтоимостьОсновныхСредствБал.Контрагент";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// исп
Функция ОпределитьСтоимостьСпискаНФА(СписокНФА, Период, Организация, КФО, КПС, ИФО=Неопределено, Подразделение=Неопределено) Экспорт
	
	Параметры = ПустаяСтруктураПараметровПолученияОстатков();
	Параметры.Период = Период;
	Параметры.Организация = Организация;
	Параметры.КФО = КФО;
	Параметры.ИФО = ИФО;
	Параметры.Подразделение = Подразделение;
	Параметры.КФО = КФО;
	Параметры.УстанавливатьКПС = Истина;
	
	Если ТипЗнч(СписокНФА) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
		Параметры.ТаблицаОС.Добавить().ОсновноеСредство = СписокНФА;
	Иначе
		Для каждого ТекОС Из СписокНФА Цикл
		
			Параметры.ТаблицаОС.Добавить().ОсновноеСредство = ТекОС;
		
		КонецЦикла; 
	КонецЕсли;
	
	ТаблицаОстатков = ПолучитьОстаткиКапВложений(Параметры);
	
	ТаблицаРезультат = Новый ТаблицаЗначений;
	ТаблицаРезультат.Колонки.Добавить("Счет", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаРезультат.Колонки.Добавить("ОсновноеСредство", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ТаблицаРезультат.Колонки.Добавить("КПС", Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаРезультат.Колонки.Добавить("ИФО", Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ТаблицаРезультат.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ТаблицаРезультат.Колонки.Добавить("КФО", Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ТаблицаРезультат.Колонки.Добавить("СуммаВсего", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18,2)));
	ТаблицаРезультат.Колонки.Добавить("КоличествоВсего", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,3)));
	ТаблицаРезультат.Колонки.Добавить("СуммаТекОС", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18,2)));
	ТаблицаРезультат.Колонки.Добавить("СуммаМОЛ", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18,2)));
	ТаблицаРезультат.Колонки.Добавить("КоличествоМОЛ", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,3)));
	
	Для каждого СтрокаОстатка Из ТаблицаОстатков Цикл
	
		НоваяСтрока = ТаблицаРезультат.Добавить();
		НоваяСтрока.ОсновноеСредство = СтрокаОстатка.ОсновноеСредство;
		НоваяСтрока.СуммаВсего = СтрокаОстатка.БалансоваяСтоимость;
		НоваяСтрока.КоличествоВсего = СтрокаОстатка.КоличествоОстаток;
		НоваяСтрока.СуммаТекОС = СтрокаОстатка.БалансоваяСтоимостьМОЛ;
		НоваяСтрока.СуммаМОЛ = СтрокаОстатка.БалансоваяСтоимостьМОЛ;
		НоваяСтрока.КоличествоМОЛ = СтрокаОстатка.КоличествоОстатокМОЛ;
	
	КонецЦикла; 
	
	Возврат ТаблицаРезультат;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", 							Период);
	Запрос.УстановитьПараметр("Организация", 						Организация);
	Запрос.УстановитьПараметр("КФО", 								КФО);
	Запрос.УстановитьПараметр("КПС", 								КПС);
	Запрос.УстановитьПараметр("ИФО", 								ИФО);
	Запрос.УстановитьПараметр("ИспользоватьУчетПоИФО", 				ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Запрос.УстановитьПараметр("Подразделение",						Подразделение);					
	Запрос.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",	Ложь);	
	Запрос.УстановитьПараметр("СписокНФА",							СписокНФА);
	Запрос.УстановитьПараметр("Счет106", БухгалтерскийУчет.СписокСчетов("106.00"));
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда		
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИСТИНА КАК Поле1
		|ИЗ
		|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
		|ГДЕ
		|	ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства)
		|	И ЕПСБУВидыСубконто.Ссылка В(&Счет106)
		|	И ЕПСБУВидыСубконто.Ссылка.УчетПоПодразделениям";
		Запрос.УстановитьПараметр("ИспользоватьУчетПоПодразделениям", Не Запрос.Выполнить().Пустой());
	КонецЕсли;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОсновноеСредство,
	|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
	|	ЖурналПроводокЕПСБУОстатки.ИФО КАК ИФО,
	|	ЖурналПроводокЕПСБУОстатки.Подразделение КАК Подразделение,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт КАК СуммаВсего,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК КоличествоВсего,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт КАК СуммаТекОС,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт КАК СуммаМОЛ,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК КоличествоМОЛ,
	|	0 КАК АмортизацияВсего,
	|	0 КАК АмортизацияТекОС,
	|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвНомер
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В (&Счет106),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
	|			Организация = &Организация
	|				И КФО = &КФО
	|				И КПС = &КПС
	|				И (ИФО = &ИФО
	|					ИЛИ НЕ &ИспользоватьУчетПоИФО)
	|				И (Подразделение = &Подразделение
	|					ИЛИ НЕ &ИспользоватьУчетПоПодразделениям)
	|				И Субконто1 В (&СписокНФА)) КАК ЖурналПроводокЕПСБУОстатки";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// исп
Функция ОпределитьСтоимостьОбъектаОС(ОбъектОС, ПараметрыЗапроса, НаДату) Экспорт
	Перем Период, Организация, КПС, КФО, ИФО, Подразделение, ЦМО, Контрагент;
	
	ПараметрыЗапроса.Свойство("Организация", Организация);
	ПараметрыЗапроса.Свойство("КПС", КПС);
	ПараметрыЗапроса.Свойство("КФО", КФО);
	ПараметрыЗапроса.Свойство("ИФО", ИФО);
	ПараметрыЗапроса.Свойство("Подразделение", Подразделение);
	ПараметрыЗапроса.Свойство("ЦМО", ЦМО);
	
	СвойстваОбъектаОС = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОбъектОС, "ВидНФА");
	ВидНФА	 				= СвойстваОбъектаОС.ВидНФА;
	
	СчетУчета = УправлениеОсновнымиСредствами.СчетУчетаОС(ОбъектОС, НаДату);
	
	СвойстваСчетаУчета 		= БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетУчета);
	СчетУчетаЗабалансовый	= СвойстваСчетаУчета.Забалансовый;
	
	УчетПоКПС = СвойстваСчетаУчета.УчетПоКПС;
	УчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
							И СвойстваСчетаУчета.УчетПоПодразделениям;
	
	Если НЕ ПараметрыЗапроса.Свойство("Контрагент", Контрагент) Тогда
		Контрагент = Неопределено;
	КонецЕсли;
	
	Если НЕ ПараметрыЗапроса.Свойство("Период", Период) Тогда
		Период = ТекущаяДатаСеанса();
	КонецЕсли;
	ВидыСубконто = Новый Массив;
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
	Если Контрагент<>Неопределено Тогда
		ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
	КонецЕсли;
	
	Если БухгалтерскийУчет.СчетВИерархии(СчетУчета, "101.00") Тогда
		СчетУчетаОС = УправлениеОсновнымиСредствами.СчетУчетаОС(ОбъектОС, НаДату);
		СчетУчета = Новый Массив;
		СчетУчета.Добавить(СчетУчетаОС);
		СчетУчета.Добавить(УправлениеОсновнымиСредствамиПовтИсп.ЗабалансовыйСчетОС(СчетУчетаОС));
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период",                 Период);
	Запрос.УстановитьПараметр("СчетОС",                 СчетУчета);
	Запрос.УстановитьПараметр("ВидыСубконто",           ВидыСубконто);
	Запрос.УстановитьПараметр("Организация",            Организация);
	Запрос.УстановитьПараметр("КПС",                    КПС);
	Запрос.УстановитьПараметр("УчетПоКПС",              УчетПоКПС);
	Запрос.УстановитьПараметр("КФО",                    КФО);
	Запрос.УстановитьПараметр("ИФО",                    ИФО);
	Запрос.УстановитьПараметр("УчетПоИФО",              ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Запрос.УстановитьПараметр("Подразделение",          Подразделение);
	Запрос.УстановитьПараметр("УчетПоПодразделениям",	УчетПоПодразделениям);
	Запрос.УстановитьПараметр("ОбъектОС",               ОбъектОС);
	Запрос.УстановитьПараметр("ЦМО",                    ЦМО);
	Запрос.УстановитьПараметр("Контрагент",             Контрагент);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.Счет,
	|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОсновноеСредство,
	|	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК ЦМО,
	|	%1 Как Субконто3,
	|	ЖурналПроводокЕПСБУОстатки.Организация,
	|	ЖурналПроводокЕПСБУОстатки.КПС,
	|	ЖурналПроводокЕПСБУОстатки.ИФО,
	|	ЖурналПроводокЕПСБУОстатки.КФО,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт КАК Сумма,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК Количество
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В (&СчетОС),
	|			&ВидыСубконто,
	|			Организация = &Организация
	|				И (КПС = &КПС
	|					ИЛИ НЕ &УчетПоКПС)
	|				И КФО = &КФО
	|				И (ИФО = &ИФО
	|					ИЛИ НЕ &УчетПоИФО)
	|				И (Подразделение = &Подразделение
	|					ИЛИ НЕ &УчетПоПодразделениям)
	|				И Субконто1 = &ОбъектОС
	|				И Субконто2 = &ЦМО%2) КАК ЖурналПроводокЕПСБУОстатки";
	
	Если Контрагент = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "%1", "Неопределено");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "%2", "");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "%1", "ЖурналПроводокЕПСБУОстатки.Субконто3");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "%2", " И Субконто3 = &Контрагент");
		Запрос.УстановитьПараметр("Контрагент",             Контрагент);
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// исп
Функция ОстаткиИмуществаКазны(Параметры, ТаблицаОС = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	
	Если ТаблицаОС = Неопределено Тогда
		
		ОсновноеСредство = Неопределено;
		ИнвентарныйНомер = Неопределено;
		
		Параметры.Свойство("ОсновноеСредство", ОсновноеСредство);
		Параметры.Свойство("ИнвентарныйНомер", ИнвентарныйНомер);
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(&НомерСтроки КАК ЧИСЛО(5, 0)) КАК НомерСтроки,
		|	ВЫРАЗИТЬ(&ОсновноеСредство КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
		|	ВЫРАЗИТЬ(&ИнвентарныйНомер КАК Справочник.ИнвентарныеНомераОС) КАК ИнвентарныйНомер
		|ПОМЕСТИТЬ ТаблицаОС
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ОсновноеСредство,
		|	ИнвентарныйНомер
		|;
		|";
		Запрос.УстановитьПараметр("ОсновноеСредство",	ОсновноеСредство);
		Запрос.УстановитьПараметр("ИнвентарныйНомер",	ИнвентарныйНомер);
		Запрос.УстановитьПараметр("НомерСтроки",		1);
	Иначе
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОсновныеСредства.НомерСтроки,
		|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
		|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер
		|ПОМЕСТИТЬ ТаблицаОС
		|ИЗ
		|	&ОсновныеСредства КАК ОсновныеСредства
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ОсновноеСредство,
		|	ИнвентарныйНомер
		|;
		|";
		Запрос.УстановитьПараметр("ОсновныеСредства", ТаблицаОС);
	КонецЕсли;
	Запрос.Текст = Запрос.Текст + 
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство
	|ПОМЕСТИТЬ ВТ_ОстаткиБУ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В (&Счет108),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
	|			Организация = &Организация
	|				И КПС = &КПС
	|				И КФО = &КФО
	|				И ИФО = &ИФО
	|				И Подразделение = &Подразделение
	|				И Субконто1 В
	|					(ВЫБРАТЬ
	|						ТаблицаОС.ОсновноеСредство
	|					ИЗ
	|						ТаблицаОС КАК ТаблицаОС)) КАК ЖурналПроводокЕПСБУОстатки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтоимостьОбъектовОС.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьОбъектовОС.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СтоимостьОбъектовОС.СтоимостьОстаток КАК Сумма,
	|	СтоимостьОбъектовОС.КоличествоОстаток КАК Количество
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						ВТ.ОсновноеСредство
	|					ИЗ
	|						ВТ_ОстаткиБУ КАК ВТ)) КАК СтоимостьОбъектовОС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АмортизацияОбъектовОС.ОсновноеСредство КАК ОсновноеСредство,
	|	АмортизацияОбъектовОС.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	АмортизацияОбъектовОС.СуммаАмортизацииОстаток КАК СуммаАмортизации
	|ПОМЕСТИТЬ ВТ_Амортизация
	|ИЗ
	|	РегистрНакопления.АмортизацияОбъектовОС.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						ВТ.ОсновноеСредство
	|					ИЗ
	|						ВТ_ОстаткиБУ КАК ВТ)) КАК АмортизацияОбъектовОС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаОС.НомерСтроки КАК НомерСтроки,
	|	ТаблицаОС.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОС.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ВЫБОР
	|		КОГДА ТаблицаОС.ИнвентарныйНомер = ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
	|			ТОГДА ВЫБОР
	|					КОГДА ЕСТЬNULL(ВТ_Остатки.Количество, 0) = 0
	|						ТОГДА 0
	|					ИНАЧЕ ВЫРАЗИТЬ(ВТ_Остатки.Сумма / ВТ_Остатки.Количество КАК ЧИСЛО(18, 2))
	|				КОНЕЦ
	|		ИНАЧЕ ВТ_Остатки.Сумма
	|	КОНЕЦ КАК СтоимостьЕдиницы,
	|	ВЫБОР
	|		КОГДА ТаблицаОС.ИнвентарныйНомер = ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
	|			ТОГДА 0
	|		ИНАЧЕ ВТ_Амортизация.СуммаАмортизации
	|	КОНЕЦ КАК АмортизацияЕдиницы,
	|	ЕСТЬNULL(ВТ_Остатки.Количество, 0) КАК КоличествоВсего,
	|	ЕСТЬNULL(ВТ_Остатки.Сумма, 0) КАК СуммаВсего,
	|	ЕСТЬNULL(ВТ_Амортизация.СуммаАмортизации, 0) КАК АмортизацияВсего
	|ИЗ
	|	ТаблицаОС КАК ТаблицаОС
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Остатки КАК ВТ_Остатки
	|		ПО ТаблицаОС.ОсновноеСредство = ВТ_Остатки.ОсновноеСредство
	|			И ТаблицаОС.ИнвентарныйНомер = ВТ_Остатки.ИнвентарныйНомер
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Амортизация КАК ВТ_Амортизация
	|		ПО ТаблицаОС.ОсновноеСредство = ВТ_Амортизация.ОсновноеСредство
	|			И ТаблицаОС.ИнвентарныйНомер = ВТ_Амортизация.ИнвентарныйНомер
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Если Параметры.Свойство("КПС") Тогда
		Запрос.УстановитьПараметр("КПС", Параметры.КПС);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "КПС = &КПС", "ИСТИНА");
	КонецЕсли;
	
	Если УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетИКПоПодразделениям() Тогда
		Запрос.УстановитьПараметр("Подразделение", Параметры.Подразделение);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Подразделение = &Подразделение", "ИСТИНА");
	КонецЕсли;
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		Запрос.УстановитьПараметр("ИФО", Параметры.ИФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИФО = &ИФО", "ИСТИНА");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Период"		, Параметры.Период);
	Запрос.УстановитьПараметр("Организация"	, Параметры.Организация);
	Запрос.УстановитьПараметр("КФО"			, Параметры.КФО);
	Запрос.УстановитьПараметр("Счет108"		, БухгалтерскийУчет.СписокСчетов("108.00"));
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ПроверитьЗаполнениеТаблицыОС(ТаблицаОС, СтоимостьОС, ПервыйПредел, ВторойПредел, Период) Экспорт
	СтруктураЗапрашиваемыхСчетов = УправлениеОсновнымиСредствамиКлиентСервер.СтруктураЗапрашиваемыхСчетов();
	СтруктураЗапрашиваемыхСчетов.ЖилыеПомещения		= Истина;
	СтруктураЗапрашиваемыхСчетов.НежилыеПомещения	= Истина;
	СтруктураЗапрашиваемыхСчетов.Сооружения			= Истина;
	СчетаЗданий = УправлениеОсновнымиСредствамиПовтИсп.МассивСчетовОС(СтруктураЗапрашиваемыхСчетов);
	
	СтруктураЗапрашиваемыхСчетов = УправлениеОсновнымиСредствамиКлиентСервер.СтруктураЗапрашиваемыхСчетов();
	СтруктураЗапрашиваемыхСчетов.Аренда		= Истина;
	СтруктураЗапрашиваемыхСчетов.Хранение	= Истина;
	ЗабалансовыеСчета = УправлениеОсновнымиСредствамиПовтИсп.МассивСчетовОС(СтруктураЗапрашиваемыхСчетов);
	
	НетОшибки = Истина;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаОС", ТаблицаОС);
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(ТаблицаОС.ОсновноеСредство КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	               |	ТаблицаОС.ИнвентарныйНомер,
	               |	ТаблицаОС.СчетУчета,
	               |	ТаблицаОС.Количество,
	               |	ТаблицаОС.НомерСтроки
	               |ПОМЕСТИТЬ ТаблицаОС
	               |ИЗ
	               |	&ТаблицаОС КАК ТаблицаОС
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ТаблицаОС.ОсновноеСредство,
				   |	ТаблицаОС.ОсновноеСредство.ТипНФА КАК ТипНФА,
	               |	ТаблицаОС.ИнвентарныйНомер,
	               |	ТаблицаОС.СчетУчета,
	               |	ТаблицаОС.Количество,
	               |	ТаблицаОС.НомерСтроки,
	               |	ОсновныеСредства.ГрупповойУчет
	               |ИЗ
	               |	ТаблицаОС КАК ТаблицаОС
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОсновныеСредства КАК ОсновныеСредства
	               |		ПО ТаблицаОС.ОсновноеСредство = ОсновныеСредства.Ссылка";
				   
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если ЗабалансовыеСчета.Найти(Выборка.СчетУчета) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		КодОшибки = 0;
		Если СчетаЗданий.Найти(Выборка.СчетУчета) <> Неопределено Тогда
			// ошибка. для зданий не может быть группового учета
		    КодОшибки = ?(Выборка.ГрупповойУчет, 2, 0);
		ИначеЕсли Выборка.ТипНФА = Перечисления.ТипыНФА.БиблиотечныйФонд Тогда
			// для библ фонда <=40000 не надо задавать инв номер
			Если СтоимостьОС <= ПервыйПредел И ЗначениеЗаполнено(Выборка.ИнвентарныйНомер) Тогда
				КодОшибки = 3;
			КонецЕсли;	
		ИначеЕсли ЗначениеЗаполнено(Выборка.ИнвентарныйНомер) И Выборка.Количество>1 Тогда
			// ошибка. Количество ос с инв номером должно быть 1
			КодОшибки = 1;
		ИначеЕсли СтоимостьОС > ПервыйПредел И Не ЗначениеЗаполнено(Выборка.ИнвентарныйНомер) Тогда
			// ошибка. Для ОС дороже первого предела должен быть задан инв номер
			КодОшибки = 4;
		КонецЕсли;
		
		Если КодОшибки > 0 Тогда
			НетОшибки = Ложь;
			ВывестиОшибкуПроверкиТаблицыОС(Выборка, КодОшибки, ПервыйПредел);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат НетОшибки;
	
КонецФункции

Процедура ЗаполнитьОбъектИзТаблицыОстатков(ОстаткиОС, Объект, Параметры) Экспорт
	Перем ИмяПоляОбъекта;
	Перем ИмяПоляИнвНомера;

	Количество = 0;
	Если Параметры.Свойство("Количество", ИмяПоляОбъекта) Тогда
		Количество = Объект[ИмяПоляОбъекта];
	ИначеЕсли НЕ Параметры.Свойство("ИсходноеКоличество", Количество) Тогда
		Количество = 0;
	КонецЕсли;
	Если Параметры.Свойство("ИнвентарныйНомер", ИмяПоляИнвНомера) Тогда
		ИнвентарныйНомер = Объект[ИмяПоляИнвНомера];
	Иначе
		ИнвентарныйНомер = Справочники.ИнвентарныеНомераОС.ПустаяСсылка();
	КонецЕсли;
	
	Если Параметры.Свойство("УстанавливатьИнвентарныйНомер") И Параметры.УстанавливатьИнвентарныйНомер = Истина Тогда
		СтруктураПоиска = Новый Структура("ОсновноеСредство", Объект[Параметры.ОсновноеСредство]);
	Иначе
		СтруктураПоиска = Новый Структура("ОсновноеСредство, ИнвентарныйНомер", Объект[Параметры.ОсновноеСредство], ИнвентарныйНомер);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИнвентарныйНомер) И Количество = 0 Тогда
		Количество = 1;
	КонецЕсли;
	
	ЕстьКолонкаКФООстатков = ОстаткиОС.Колонки.Найти("КФООстатков") <> Неопределено;
	
	Цена             = 0;
	Сумма            = 0;
	СуммаАмортизации = 0;
	КПС              = Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка();
	КФО              = Перечисления.КВД.ПустаяСсылка();
	Счет             = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	СтрокиОстатков = ОстаткиОС.НайтиСтроки(СтруктураПоиска);
	Если СтрокиОстатков.Количество() > 0 Тогда
		СтрокаОстатков	= СтрокиОстатков[0];
		// Количества в остатках может не быть, например, если это библиотечный фонд, поэтому условие "ИЛИ"
		Если СтрокаОстатков.КоличествоОстатокМОЛ > 0 ИЛИ СтрокаОстатков.БалансоваяСтоимостьМОЛ > 0 Тогда
			Если Параметры.УстанавливатьИнвентарныйНомер = Истина Тогда
				Объект[ИмяПоляИнвНомера] = СтрокаОстатков.ИнвентарныйНомер;
				ИнвентарныйНомер = СтрокаОстатков.ИнвентарныйНомер;
			КонецЕсли;                                   
			Цена = ?(Количество = 0, СтрокаОстатков.БалансоваяСтоимостьМОЛ, СтрокаОстатков.СтоимостьЕдиницы);
			КПС  = СтрокаОстатков.КПСОстатков;
			Счет = СтрокаОстатков.Счет;
			Если ЕстьКолонкаКФООстатков Тогда
				КФО = СтрокаОстатков.КФООстатков;
			КонецЕсли;
			Если ЗначениеЗаполнено(ИнвентарныйНомер) Тогда
				Сумма            = Количество * Цена;
				СуммаАмортизации = Количество * СтрокаОстатков.Амортизация;
			Иначе
				Если Количество = СтрокаОстатков.КоличествоОстатокМОЛ ИЛИ Количество = 0 Тогда
					Сумма = СтрокаОстатков.БалансоваяСтоимостьМОЛ;
				Иначе
					Сумма = Количество * Цена;
				КонецЕсли;
				Если СтрокаОстатков.ЭтоБиблиотечныйФонд Тогда
					Если СтрокаОстатков.КоличествоОстаток <> 0
						И СтрокаОстатков.КоличествоОстаток <> Количество Тогда
						СуммаАмортизации = Количество * СтрокаОстатков.СуммаАмортизации / СтрокаОстатков.КоличествоОстаток;
					Иначе
						СуммаАмортизации = СтрокаОстатков.СуммаАмортизации;
					КонецЕсли;
					СуммаАмортизации = Мин(СуммаАмортизации, Сумма);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если Параметры.Свойство("Количество", ИмяПоляОбъекта) Тогда
		Объект[ИмяПоляОбъекта] = Количество;
	КонецЕсли;
	Если Параметры.Свойство("Цена", ИмяПоляОбъекта) Тогда
		Объект[ИмяПоляОбъекта] = Цена;
	КонецЕсли;
	Если Параметры.Свойство("Сумма", ИмяПоляОбъекта) Тогда
		Объект[ИмяПоляОбъекта] = Сумма;
	КонецЕсли;
	Если Параметры.Свойство("СуммаАмортизации", ИмяПоляОбъекта) Тогда
		Объект[ИмяПоляОбъекта] = СуммаАмортизации;
	КонецЕсли;
	Если Параметры.Свойство("КПС", ИмяПоляОбъекта) Тогда
		Объект[ИмяПоляОбъекта] = КПС;
	КонецЕсли;
	Если ЕстьКолонкаКФООстатков И Параметры.Свойство("КФО", ИмяПоляОбъекта) Тогда
		Объект[ИмяПоляОбъекта] = КФО;
	КонецЕсли;
	Если Параметры.Свойство("Счет", ИмяПоляОбъекта) Тогда
		Объект[ИмяПоляОбъекта] = Счет;
	КонецЕсли;
	Если Параметры.Свойство("СуммаОбесценения", ИмяПоляОбъекта) И СтрокаОстатков <> Неопределено Тогда
		Объект[ИмяПоляОбъекта] = СтрокаОстатков["СуммаОбесценения"];
	КонецЕсли;

КонецПроцедуры

// Функция переводит срок эксплуатации ОС из месяцев в годы
//
Функция МесяцВГод(СрокЭкспл) Экспорт 
	Если ЗначениеЗаполнено(СрокЭкспл) Тогда
		ГодЭкспл=Цел(СрокЭкспл/12);
		МесЭкспл=СрокЭкспл-ГодЭкспл*12;
		
		ПослГод= ГодЭкспл-Цел(ГодЭкспл/10)*10;
		ДваГода= ГодЭкспл-Цел(ГодЭкспл/100)*100;
		Если ГодЭкспл=0 Тогда
			СрокЭксплГод= "";
		ИначеЕсли (ДваГода>=11) И (ДваГода<= 14) Тогда
			СрокЭксплГод= ""+ГодЭкспл+" лет";
		ИначеЕсли ПослГод=1 Тогда
			СрокЭксплГод= ""+ГодЭкспл+" год";
		ИначеЕсли (ПослГод>=2) И (ПослГод <= 4) Тогда
			СрокЭксплГод= ""+ГодЭкспл+" года";
		Иначе
			СрокЭксплГод= ""+ГодЭкспл+" лет";
		КонецЕсли;
		СрокЭксплГод=СрокЭксплГод+?(МесЭкспл>0," "+МесЭкспл+" мес.",""); 
	Иначе
		СрокЭксплГод= "";
	КонецЕсли;
	
	Возврат СрокЭксплГод;
КонецФункции

// Функция рассчитывает срок полезного использования по амортизационной группе
//Первая группа (от 1 года до 2 лет включительно)
//Вторая группа (свыше 2 лет до 3 лет включительно)
//Третья группа (свыше 3 лет до 5 лет включительно)
//Четвертая группа (свыше 5 лет до 7 лет включительно)
//Пятая группа (свыше 7 лет до 10 лет включительно)
//Шестая группа (свыше 10 лет до 15 лет включительно)
//Седьмая группа (свыше 15 лет до 20 лет включительно)
//Восьмая группа (свыше 20 лет до 25 лет включительно)
//Девятая группа (свыше 25 лет до 30 лет включительно)
//Десятая группа (свыше 30 лет)
//Отдельная группа (п.1, ст.322 НК РФ) 
//
Функция РасчетСрокаПолезногоИспользования(АмортизационнаяГруппа)Экспорт
	Если НЕ ЗначениеЗаполнено(АмортизационнаяГруппа) Тогда
		СрокПолезногоИспользования= 0;
	Иначе
		Если АмортизационнаяГруппа= Перечисления.АмортизационныеГруппы.ПерваяГруппа Тогда
			ЧислоЛет=2;
		ИначеЕсли АмортизационнаяГруппа= Перечисления.АмортизационныеГруппы.ВтораяГруппа Тогда
			ЧислоЛет=3;
		ИначеЕсли АмортизационнаяГруппа= Перечисления.АмортизационныеГруппы.ТретьяГруппа Тогда
			ЧислоЛет=5;
		ИначеЕсли АмортизационнаяГруппа= Перечисления.АмортизационныеГруппы.ЧетвертаяГруппа Тогда
			ЧислоЛет=7;
		ИначеЕсли АмортизационнаяГруппа= Перечисления.АмортизационныеГруппы.ПятаяГруппа Тогда
			ЧислоЛет=10;
		ИначеЕсли АмортизационнаяГруппа= Перечисления.АмортизационныеГруппы.ШестаяГруппа Тогда
			ЧислоЛет=15;
		ИначеЕсли АмортизационнаяГруппа= Перечисления.АмортизационныеГруппы.СедьмаяГруппа Тогда
			ЧислоЛет=20;
		ИначеЕсли АмортизационнаяГруппа= Перечисления.АмортизационныеГруппы.ВосьмаяГруппа Тогда
			ЧислоЛет=25;
		ИначеЕсли АмортизационнаяГруппа= Перечисления.АмортизационныеГруппы.ДевятаяГруппа Тогда
			ЧислоЛет=30;
		Иначе
			ЧислоЛет=0;
		КонецЕсли;
		СрокПолезногоИспользования=ЧислоЛет*12;
	КонецЕсли;
	Возврат СрокПолезногоИспользования;

КонецФункции

// возвращает структуру содержащую сведения об основном средстве
// Параметры:
//	Дата - Дата получения сведений, если не заполнено, то используется текущая дата сеанса
//	ОсновноеСредство - справочникссылка.ОсновныеСредства,
//	ТребуемыеДанные - строка имен ключей разделенных ",". Если не задано то возвращаются все ключи
//
// Возвращаемое значение:
//	Сруктура
//
// Возможные ключи:
//			-- из справочника ОС --
//	Ссылка,
//	Предопределенный,
//	Родитель,
//	ЭтоГруппа,
//	Код,
//	Наименование,
//	Организация,
//	НаименованиеПолное,
//	СчетУчета,
//	КодПоОКОФ,
//	ВидНФА,
//	АмортизационнаяГруппа,
//	ГрупповойУчет,
//	НомерИнвКарт,
//	ВидУчета,
//	ВидИмущества,
//	Местонахождение,
//			-- из регистра АмортизацияОС --
//	СчетУчетаЗатрат,
//	КЭКЗатрат,
//	КПСЗатрат,
//	ПодразделениеЗатрат,
//	СубконтоЗатрат1,
//	СубконтоЗатрат2,
//	СубконтоЗатрат3,
//			-- из регистра НачислениеАмортизацииОС --
//	НачислятьАмортизацию,
//	ПорядокПогашенияСтоимости,
//	СпособНачисленияАмортизации,
//			-- из регистра РасчетАмортизацииОС --
//	СрокПолезногоИспользования,
//	СрокИспользованияДляВычисленияАмортизации,
//	КАК СтоимостьДляВычисленияАмортизации
Функция ПолучитьСведенияОбОС(Дата, ОсновноеСредство, ТребуемыеДанные="") Экспорт

	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОсновныеСредства.Ссылка КАК Ссылка,
	|	ОсновныеСредства.Предопределенный КАК Предопределенный,
	|	ОсновныеСредства.Родитель КАК Родитель,
	|	ОсновныеСредства.ЭтоГруппа КАК ЭтоГруппа,
	|	ОсновныеСредства.Код КАК Код,
	|	ОсновныеСредства.Наименование КАК Наименование,
	|	ОсновныеСредства.Организация КАК Организация,
	|	ОсновныеСредства.НаименованиеПолное КАК НаименованиеПолное,
	|	ЕСТЬNULL(УчетныеДанныеОбъектаОССрезПоследних.СчетУчета, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) КАК СчетУчета,
	|	ОсновныеСредства.КодОКОФ КАК КодОКОФ,
	|	ОсновныеСредства.ВидНФА КАК ВидНФА,
	|	ОсновныеСредства.АмортизационнаяГруппа КАК АмортизационнаяГруппа,
	|	ОсновныеСредства.ГрупповойУчет КАК ГрупповойУчет,
	|	НомераИнвентарныхКарточек.НомерИнвентарнойКарточки КАК НомерИнвКарт,
	|	ЕСТЬNULL(УчетныеДанныеОбъектаОССрезПоследних.ВидУчета, ЗНАЧЕНИЕ(Перечисление.ВидыУчетаНФА.ПустаяСсылка)) КАК ВидУчета,
	|	ЕСТЬNULL(УчетныеДанныеОбъектаОССрезПоследних.ВидИмущества, ЗНАЧЕНИЕ(Перечисление.ВидыИмущества.ПустаяСсылка)) КАК ВидИмущества,
	|	ОсновныеСредства.Местонахождение КАК Местонахождение,
	|	ЕСТЬNULL(АмортизацияОССрезПоследних.СчетУчетаЗатрат, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) КАК СчетУчетаЗатрат,
	|	ЕСТЬNULL(АмортизацияОССрезПоследних.КЭК, ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)) КАК КЭКЗатрат,
	|	ЕСТЬNULL(АмортизацияОССрезПоследних.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) КАК КПСЗатрат,
	|	ЕСТЬNULL(АмортизацияОССрезПоследних.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК ПодразделениеЗатрат,
	|	ЕСТЬNULL(АмортизацияОССрезПоследних.Субконто1, НЕОПРЕДЕЛЕНО) КАК СубконтоЗатрат1,
	|	ЕСТЬNULL(АмортизацияОССрезПоследних.Субконто2, НЕОПРЕДЕЛЕНО) КАК СубконтоЗатрат2,
	|	ЕСТЬNULL(АмортизацияОССрезПоследних.Субконто3, НЕОПРЕДЕЛЕНО) КАК СубконтоЗатрат3,
	|	ЕСТЬNULL(НачислениеАмортизацииОСБухгалтерскийУчетСрезПоследних.НачислятьАмортизацию, ИСТИНА) КАК НачислятьАмортизацию,
	|	ЕСТЬNULL(ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.ПорядокПогашенияСтоимости, ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.ПустаяСсылка)) КАК ПорядокПогашенияСтоимости,
	|	ЕСТЬNULL(ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.СпособНачисленияАмортизации, ЗНАЧЕНИЕ(Перечисление.СпособНачисленияАмортизации.ПустаяСсылка)) КАК СпособНачисленияАмортизации,
	|	ЕСТЬNULL(РасчетАмортизацииОССрезПоследних.СрокПолезногоИспользования, 0) КАК СрокПолезногоИспользования,
	|	ЕСТЬNULL(РасчетАмортизацииОССрезПоследних.СрокИспользованияДляВычисленияАмортизации, 0) КАК СрокИспользованияДляВычисленияАмортизации,
	|	ЕСТЬNULL(РасчетАмортизацииОССрезПоследних.СтоимостьДляВычисленияАмортизации, 0) КАК СтоимостьДляВычисленияАмортизации,
	|	ЕСТЬNULL(ПараметрыАмортизацииОСНалоговыйУчетСрезПоследних.СрокПолезногоИспользования, 0) КАК СрокПолезногоИспользованияНУ
	|ИЗ
	|	Справочник.ОсновныеСредства КАК ОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АмортизацияОС.СрезПоследних(&Период, ОсновноеСредство = &Ссылка) КАК АмортизацияОССрезПоследних
	|		ПО ОсновныеСредства.Ссылка = АмортизацияОССрезПоследних.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НачислениеАмортизацииОСБухгалтерскийУчет.СрезПоследних(&Период, ОсновноеСредство = &Ссылка) КАК НачислениеАмортизацииОСБухгалтерскийУчетСрезПоследних
	|		ПО ОсновныеСредства.Ссылка = НачислениеАмортизацииОСБухгалтерскийУчетСрезПоследних.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыАмортизацииОСБухгалтерскийУчет.СрезПоследних(&Период, ОсновноеСредство = &Ссылка) КАК ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних
	|		ПО ОсновныеСредства.Ссылка = ПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РасчетАмортизацииОС.СрезПоследних(&Период, ОсновноеСредство = &Ссылка) КАК РасчетАмортизацииОССрезПоследних
	|		ПО ОсновныеСредства.Ссылка = РасчетАмортизацииОССрезПоследних.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыАмортизацииОСНалоговыйУчет.СрезПоследних(&Период, ОсновноеСредство = &Ссылка) КАК ПараметрыАмортизацииОСНалоговыйУчетСрезПоследних
	|		ПО ОсновныеСредства.Ссылка = ПараметрыАмортизацииОСНалоговыйУчетСрезПоследних.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних(&Период, ОсновноеСредство = &Ссылка) КАК УчетныеДанныеОбъектаОССрезПоследних
	|		ПО ОсновныеСредства.Ссылка = УчетныеДанныеОбъектаОССрезПоследних.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НомераИнвентарныхКарточек.СрезПоследних(&Период, ОсновноеСредство = &Ссылка) КАК НомераИнвентарныхКарточек
	|		ПО ОсновныеСредства.Ссылка = НомераИнвентарныхКарточек.ОсновноеСредство
	|			И ОсновныеСредства.Организация = НомераИнвентарныхКарточек.Организация
	|ГДЕ
	|	ОсновныеСредства.Ссылка = &Ссылка";
	Построитель = Новый ПостроительЗапроса(ТекстЗапроса);
	Построитель.Параметры.Вставить("Период", ?(Дата = '00010101', ТекущаяДатаСеанса(), Дата));
	Построитель.Параметры.Вставить("Ссылка", ОсновноеСредство);
	
	СтруктураРезультат = Новый Структура;
	Построитель.ЗаполнитьНастройки();
	Если НЕ ПустаяСтрока(ТребуемыеДанные) Тогда
		ВыбранныеПоля = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТребуемыеДанные, ",");
		Построитель.ВыбранныеПоля.Очистить();
		//Построитель.ВыбранныеПоля.Добавить("Ссылка", "Ссылка");
		Для каждого ТекВыбранноеПоле Из ВыбранныеПоля Цикл
		
			Если Построитель.ДоступныеПоля.Найти(СокрЛП(ТекВыбранноеПоле)) <> Неопределено Тогда
				Построитель.ВыбранныеПоля.Добавить(СокрЛП(ТекВыбранноеПоле), СокрЛП(ТекВыбранноеПоле));
				СтруктураРезультат.Вставить(СокрЛП(ТекВыбранноеПоле));
			КонецЕсли;
		
		КонецЦикла; 
	КонецЕсли;
	
	Построитель.Выполнить();
	
	Если НЕ Построитель.Результат.Пустой() Тогда
		Если СтруктураРезультат.Количество() = 0 Тогда
			Выборка = Построитель.Результат.Выгрузить();
			СтруктураРезультат = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(Выборка[0]);
		Иначе
			Выборка = Построитель.Результат.Выбрать();
			Выборка.Следующий();
			ЗаполнитьЗначенияСвойств(СтруктураРезультат, Выборка);
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтруктураРезультат;

КонецФункции // ПолучитьСведенияОбОС()

Функция СформироватьОбластьКомиссия(ВыборкаШапка, ВыборкаКомиссия, ОбластьКомиссия, КоличествоСтрокКомиссии=3, СтрокаКомиссия = "", ВписыватьДолжности = Ложь) Экспорт
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	СтруктураОбластьКомиссия = Новый Структура("пСтатусЧленаКомиссии,пДолжностьЧленаКомиссии,пЧленКомиссии", "", "", "");
	ЧастиСтрокиКомиссии = Новый Массив;
	
	СтруктураОбластьКомиссия.пСтатусЧленаКомиссии	 = "Председатель комиссии";
	СтруктураОбластьКомиссия.пДолжностьЧленаКомиссии = ВыборкаШапка.ДолжностьПредседателяКомиссии;
	Если ЗначениеЗаполнено(ВыборкаШапка.ФамилияПредседателяКомиссии) Тогда
		ЧастиФИО = Новый Структура("Фамилия,Имя,Отчество", ВыборкаШапка.ФамилияПредседателяКомиссии,
			ВыборкаШапка.ИмяПредседателяКомиссии, ВыборкаШапка.ОтчествоПредседателяКомиссии);
		пЧленКомиссии = КорреспондентыКлиентСервер.ФИО(ЧастиФИО, Истина);		
		СтруктураОбластьКомиссия.пЧленКомиссии = пЧленКомиссии;
		Если ВписыватьДолжности И Не ПустаяСтрока(ВыборкаШапка.ДолжностьПредседателяКомиссии) Тогда
			СтрокаКомиссия = СокрЛП(ВыборкаШапка.ДолжностьПредседателяКомиссии)+ " " + пЧленКомиссии;
		Иначе
			СтрокаКомиссия = пЧленКомиссии;
		КонецЕсли;
		ЧастиСтрокиКомиссии.Добавить(СтрокаКомиссия);
	КонецЕсли;
	
	ОбластьКомиссия.Параметры.Заполнить(СтруктураОбластьКомиссия);
	ТабличныйДокумент.Вывести(ОбластьКомиссия);
	
	СтруктураОбластьКомиссия.пСтатусЧленаКомиссии = "Члены комиссии:";
	ВывелиСтрок = 1; // председатель комиссии это была первая выведеная строка
	Если ТипЗнч(ВыборкаКомиссия) = Тип("ВыборкаИзРезультатаЗапроса") Тогда
		Пока ВыборкаКомиссия.Следующий() Цикл
			ВывелиСтрок = ВывелиСтрок + 1;
			СтруктураОбластьКомиссия.пДолжностьЧленаКомиссии = ВыборкаКомиссия.ДолжностьЧленаКомиссии;
			ЧастиФИО = Новый Структура("Фамилия,Имя,Отчество", ВыборкаКомиссия.ФамилияЧленаКомиссии,
				ВыборкаКомиссия.ИмяЧленаКомиссии, ВыборкаКомиссия.ОтчествоЧленаКомиссии);
			пЧленКомиссии = КорреспондентыКлиентСервер.ФИО(ЧастиФИО, Истина);
			СтруктураОбластьКомиссия.пЧленКомиссии = пЧленКомиссии;
			
			ОбластьКомиссия.Параметры.Заполнить(СтруктураОбластьКомиссия);			
			ТабличныйДокумент.Вывести(ОбластьКомиссия);
			
			СтруктураОбластьКомиссия.пСтатусЧленаКомиссии = "";
			Если ВписыватьДолжности И НЕ ПустаяСтрока(ВыборкаКомиссия.ДолжностьЧленаКомиссии) Тогда
				СтрокаКомиссия = СокрЛП(ВыборкаКомиссия.ДолжностьЧленаКомиссии) + " " + пЧленКомиссии;
			Иначе
				СтрокаКомиссия = пЧленКомиссии;
			КонецЕсли;
			ЧастиСтрокиКомиссии.Добавить(СтрокаКомиссия);
		КонецЦикла;
	ИначеЕсли ТипЗнч(ВыборкаКомиссия) = Тип("ТаблицаЗначений") Тогда
		Для Каждого СтрокаКомиссии Из ВыборкаКомиссия Цикл
			ВывелиСтрок = ВывелиСтрок + 1;
			СтруктураОбластьКомиссия.пДолжностьЧленаКомиссии = СтрокаКомиссии.ДолжностьЧленаКомиссии;
			ЧастиФИО = Новый Структура("Фамилия,Имя,Отчество", СтрокаКомиссии.ФамилияЧленаКомиссии,
				СтрокаКомиссии.ИмяЧленаКомиссии, СтрокаКомиссии.ОтчествоЧленаКомиссии);
			пЧленКомиссии = КорреспондентыКлиентСервер.ФИО(ЧастиФИО, Истина);
			СтруктураОбластьКомиссия.пЧленКомиссии = пЧленКомиссии;
			
			ОбластьКомиссия.Параметры.Заполнить(СтруктураОбластьКомиссия);			
			ТабличныйДокумент.Вывести(ОбластьКомиссия);
			
			СтруктураОбластьКомиссия.пСтатусЧленаКомиссии = "";
			Если ВписыватьДолжности И НЕ ПустаяСтрока(СтрокаКомиссии.ДолжностьЧленаКомиссии) Тогда
				СтрокаКомиссия = СокрЛП(СтрокаКомиссии.ДолжностьЧленаКомиссии) + " " + пЧленКомиссии;
			Иначе
				СтрокаКомиссия = пЧленКомиссии;
			КонецЕсли;
			ЧастиСтрокиКомиссии.Добавить(СтрокаКомиссия);
		КонецЦикла;
	КонецЕсли;
	
	СтруктураОбластьКомиссия.пДолжностьЧленаКомиссии = "";
	СтруктураОбластьКомиссия.пЧленКомиссии = "";
	Для Счетчик = ВывелиСтрок По КоличествоСтрокКомиссии Цикл
		ОбластьКомиссия.Параметры.Заполнить(СтруктураОбластьКомиссия);
		ТабличныйДокумент.Вывести(ОбластьКомиссия);
		СтруктураОбластьКомиссия.пСтатусЧленаКомиссии = "";
	КонецЦикла;
	
	СтрокаКомиссия = СтрСоединить(ЧастиСтрокиКомиссии, ", ");

	Возврат ТабличныйДокумент;
	
КонецФункции

// Формирует массив объектов для реализации групповой печати карточек (инвентарных, капвложений).
// Используется в процедуре "Печать" менеджеров объектов
// 
// Параметры:
//  МассивОбъектов - Массив из ДокументСсылка - массив документов, для которых формируются печатный формы
//  ИмяПоляОбъекта - Строка - имя поля табличной части, в котором введены объекты 
//  ИмяТабЧасти - Строка - имя табличной части, в которой находятся объекты для печати 
// 
// Возвращаемое значение:
//  Массив из СправочникСсылка - массив объектов для печати (основные средства, карточки капвложений)
Функция ОбъектыДляГрупповойПечатиКарточек(
	МассивОбъектов, ИмяПоляОбъекта = "ОсновноеСредство", ИмяТабЧасти = "ОсновныеСредства") Экспорт
	
	Если МассивОбъектов.Количество() = 0 Тогда
		ПустойМассив = Новый Массив;
		Возврат ПустойМассив;
	КонецЕсли;	
	
	ИмяДокумента = МассивОбъектов[0].Метаданные().Имя;
	ВидОбъекта   = "Документ";
	Если Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(МассивОбъектов[0])) Тогда
		ВидОбъекта = "Справочник";
	КонецЕсли;	
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	&ПолеОбъекта КАК Объект
	|ИЗ
	|	&Источник КАК ТабЧасть
	|ГДЕ
	|	ТабЧасть.Ссылка В (&МассивОбъектов)
	|	И &ПолеОбъекта <> &ПустоеЗначениеТипа";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеОбъекта", "ТабЧасть." + ИмяПоляОбъекта);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Источник", ВидОбъекта + "." + ИмяДокумента + "." + ИмяТабЧасти);
	
	ПустоеЗначениеТипа = "Значение(Справочник.ОсновныеСредства.ПустаяСсылка)";
	Если ИмяПоляОбъекта = "КарточкаКапвложений" Тогда
		ПустоеЗначениеТипа = "Значение(Справочник.КарточкиКапвложений.ПустаяСсылка)";
	КонецЕсли;	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПустоеЗначениеТипа", ПустоеЗначениеТипа);
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Объект");
КонецФункции

// Проверяет ОС в табличной части на предмет приняты ли они к учету. Если хотя бы одно ОС
// принято к учету возвращает ИСТИНА и выводит соответствующие сообщения
//
// Параметры:
//  ДокументОбъект - ДокументОбъект - документ, из в котором проверяем
//  Отказ - Булево - флаг, который устанавливается, если есть ОС, уже принятое к учету
//
// Возвращаемое значение:
//  Булево - Истина, если хотя бы одно ОС уже принято к учету
Функция ЕстьОСПринятыеКУчету(ДокументОбъект, Отказ) Экспорт
	Результат = Ложь; 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", Новый Граница(?(ДокументОбъект.ЭтоНовый(), 
		КонецДня(ДокументОбъект.Дата), ДокументОбъект.МоментВремени()), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Организация", ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("ОС", ДокументОбъект.ОсновныеСредства.ВыгрузитьКолонку("ОсновноеСредство"));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СобытияОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	СобытияОССрезПоследних.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрСведений.СобытияОС.СрезПоследних(&Период, Организация = &Организация
	|	И ОсновноеСредство В (&ОС)
	|	И ИнвНомер <> ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
	|	И Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)) КАК СобытияОССрезПоследних
	|ГДЕ
	|	СобытияОССрезПоследних.ДатаСобытия <> ДАТАВРЕМЯ(1, 1, 1)";
	
	ПринятыеКУчетуОС = Запрос.Выполнить().Выгрузить();
	Шаблон = НСтр("ru='Основное средство ""%1"" уже принято к учету документом ""%2""'");
	
	Для Каждого ТекущаяСтрока Из ДокументОбъект.ОсновныеСредства Цикл	
		СтрокаОС = ПринятыеКУчетуОС.Найти(ТекущаяСтрока.ОсновноеСредство, "ОсновноеСредство");
		Если СтрокаОС <> Неопределено Тогда
			Результат = Истина;
			
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				Шаблон, СтрокаОС.ОсновноеСредство, СтрокаОС.Регистратор);
			ПолеОшибки = "Объект.ОсновныеСредства["+ (ТекущаяСтрока.НомерСтроки - 1) +"].ОсновноеСредство";
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,, ПолеОшибки,, Отказ);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции	

#КонецОбласти

#Область КонтрольПриСписанииОС

// Формирует пустую таблицу, определяющую данные, которые должна вернуть процедура, заполняющая таблицу по табличной 
// части документа для целей списания ОС
//
// Возвращаемое значение:
//  ТаблицаЗначений:
//   * НомерСтроки - Число
//   * Организация - СправочникСсылка.Организации
//   * ОсновноеСредство - СправочникСсылка.ОсновныеСредства
//   * ИнвентарныйНомер - СправочникСсылка.ИнвентарныеНомераОС
//   * ЦМО - СправочникСсылка.ЦМО
//   * ДопАналитика - Характеристика.ВидыСубконто
//   * КПС - СправочникСсылка.КлассификационныеПризнакиСчетов
//   * КФО - ПеречислениеСсылка.КВД
//   * СчетУчета - ПланСчетовСсылка.ЕПСБУ
//   * ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения
//   * Подразделение - СправочникСсылка.Подразделения
//   * ПередачаЧастейОбъектов - Булево - флаг, что передается не весь объект, а только часть
//   * Количество - Число
//   * Сумма - Число
//   * КоличествоОстаток - Число
//   * СуммаОстаток - Число
Функция ПустаяТаблицаСписанияОСпоДокументу() Экспорт
	ОписаниеТипаЧисло = Новый ОписаниеТипов("Число");
	ОписаниеТиповСубконто = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;

	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	Таблица.Колонки.Добавить("ОсновноеСредство", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	Таблица.Колонки.Добавить("ИнвентарныйНомер", Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	Таблица.Колонки.Добавить("ЦМО", Новый ОписаниеТипов("СправочникСсылка.ЦМО"));
	Таблица.Колонки.Добавить("ДопАналитика", ОписаниеТиповСубконто);
	Таблица.Колонки.Добавить("КПС", Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	Таблица.Колонки.Добавить("КФО", Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	Таблица.Колонки.Добавить("СчетУчета", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	Таблица.Колонки.Добавить("ИФО", Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	Таблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	Таблица.Колонки.Добавить("ПередачаЧастейОбъектов", Новый ОписаниеТипов("Булево"));

	Таблица.Колонки.Добавить("Количество", ОписаниеТипаЧисло);
	Таблица.Колонки.Добавить("Сумма", ОписаниеТипаЧисло);
	
	Возврат Таблица;
КонецФункции	

// Возвращает таблицу свойств счетов для целей правильного заполнения данных табличной части документа для
// контроля остатков (с учетом резервов), наличия обременений 
// 
// Параметры:
//  Счета - Массив из ПланСчетовСсылка.ЕПСБУ - счета, свойства которых нужно получить
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Свойства счетов для контроля списания ОС. Колонки:
//	  * Счет - ПланСчетовСсылка.ЕПСБУ 
//	  * УчетПоПодразделениям - Булево - если ли на счете учет по подразделениям
//	  * УчетПоКПС - Булево - если ли на счете учет по КПС
//	  * УчетПоЦМО - Булево - если ли на счете учет по ЦМО
//	  * ВидДопАналитики - ПланВидовХарактеристикСсылка.ВидыСубконто - вид дополнительного субконто. Если доп. субконто
//						нет, то в поле будет НЕОПРЕДЕЛЕНО
Функция СвойстваСчетовДляКонтроляСписанияОС(Счета) Экспорт
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕПСБУВидыСубконто.Ссылка КАК Счет,
	|	МАКСИМУМ(ЕПСБУВидыСубконто.Ссылка.УчетПоПодразделениям) КАК УчетПоПодразделениям,
	|	МАКСИМУМ(ЕПСБУВидыСубконто.Ссылка.УчетПоКПС) КАК УчетПоКПС,
	|	МАКСИМУМ(ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦМО)) КАК УчетПоЦМО,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Договоры)
	|			ТОГДА ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Договоры)
	|		КОГДА ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Контрагенты)
	|			ТОГДА ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Контрагенты)
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ) КАК ВидДопАналитики
	|ИЗ
	|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|ГДЕ
	|	ЕПСБУВидыСубконто.Ссылка В (&Счета)
	|СГРУППИРОВАТЬ ПО
	|	ЕПСБУВидыСубконто.Ссылка";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Счета", Счета);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции	

// Выполняет проверку наличия остатков ОС с учетом резервирования, наличие обременений.
// Если есть проблемы, выводит соответствующие сообщения пользователю
// 
// Параметры:
//  ТабДокумента - ТаблицаЗначений - таблица, сформированная документом списания по данным документа
//  ДокументОбъект - ДокументОбъект - документ, из котороговызывается функция
//  НуженКонтрольОбременений - Булево - Если ИСТИНА, то функция проверит наличие обременений на счетах 24, 25, 26, 27  
// 
// Возвращаемое значение:
//  Булево - флаг наличия проблем списания ОС
Функция ЕстьПроблемыСписания_ОстаткиРезервыОбременения(ТабДокумента, ДокументОбъект, НуженКонтрольОбременений = Ложь) Экспорт
	ЕстьПроблемы = Ложь;
	Если ДокументОбъект.Аннулирован Тогда
		Возврат ЕстьПроблемы;
	КонецЕсли;	
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОСДокумента.НомерСтроки КАК НомерСтроки,
	|	ОСДокумента.Организация КАК Организация,
	|	ОСДокумента.ОсновноеСредство КАК ОсновноеСредство,
	|	ОСДокумента.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ОСДокумента.ЦМО КАК ЦМО,
	|	ОСДокумента.ДопАналитика КАК ДопАналитика,
	|	ОСДокумента.КПС КАК КПС,
	|	ОСДокумента.КФО КАК КФО,
	|	ОСДокумента.СчетУчета КАК Счет,
	|	ОСДокумента.ИФО КАК ИФО,
	|	ОСДокумента.Подразделение КАК Подразделение,
	|	ОСДокумента.ПередачаЧастейОбъектов КАК ПередачаЧастейОбъектов,
	|	ОСДокумента.Количество КАК Количество,
	|	ОСДокумента.Сумма КАК Сумма
	|ПОМЕСТИТЬ НужноСписать1
	|ИЗ
	|	&ТаблицаДокумента КАК ОСДокумента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НужноСписать1.НомерСтроки КАК НомерСтроки,
	|	НужноСписать1.Организация КАК Организация,
	|	НужноСписать1.ОсновноеСредство КАК ОсновноеСредство,
	|	НужноСписать1.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	НужноСписать1.ЦМО КАК ЦМО,
	|	ВЫБОР
	|		КОГДА НужноСписать1.ДопАналитика = НЕОПРЕДЕЛЕНО
	|			ТОГДА NULL
	|		ИНАЧЕ НужноСписать1.ДопАналитика
	|	КОНЕЦ КАК ДопАналитика,
	|	НужноСписать1.КПС КАК КПС,
	|	НужноСписать1.КФО КАК КФО,
	|	НужноСписать1.Счет КАК Счет,
	|	НужноСписать1.ИФО КАК ИФО,
	|	НужноСписать1.Подразделение КАК Подразделение,
	|	НужноСписать1.ПередачаЧастейОбъектов КАК ПередачаЧастейОбъектов,
	|	НужноСписать1.Количество КАК Количество,
	|	НужноСписать1.Сумма КАК Сумма
	|ПОМЕСТИТЬ НужноСписать
	|ИЗ
	|	НужноСписать1 КАК НужноСписать1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Счета.Счет КАК Счет,
	|	МАКСИМУМ(Счета.УчетПоПодразделениям) КАК УчетПоПодразделениям,
	|	МАКСИМУМ(Счета.УчетПоКПС) КАК УчетПоКПС,
	|	МАКСИМУМ(Счета.УчетПоЦМО) КАК УчетПоЦМО,
	|	МАКСИМУМ(Счета.ВидДопАналитики) КАК ВидДопАналитики,
	|	МАКСИМУМ(Счета.ВидРаспоряжения) КАК ВидРаспоряжения
	|ПОМЕСТИТЬ ТабСчетов
	|ИЗ
	|	(ВЫБРАТЬ
	|		ЕПСБУВидыСубконто.Ссылка КАК Счет,
	|		ЕПСБУВидыСубконто.Ссылка.УчетПоПодразделениям
	|		И &УчетПоПодразделениям КАК УчетПоПодразделениям,
	|		ЕПСБУВидыСубконто.Ссылка.УчетПоКПС КАК УчетПоКПС,
	|		ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦМО) КАК УчетПоЦМО,
	|		ВЫБОР
	|			КОГДА ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Договоры)
	|				ТОГДА ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Договоры)
	|			КОГДА ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Контрагенты)
	|				ТОГДА ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Контрагенты)
	|			ИНАЧЕ NULL
	|		КОНЕЦ КАК ВидДопАналитики,
	|		ВЫБОР
	|			КОГДА ПОДСТРОКА(ЕПСБУВидыСубконто.Ссылка.Код, 1, 4) В (""101."", ""102."", ""103."", ""108."")
	|				ИЛИ ПОДСТРОКА(ЕПСБУВидыСубконто.Ссылка.Код, 1, 5) = ""111.6""
	|				ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)
	|			КОГДА ПОДСТРОКА(ЕПСБУВидыСубконто.Ссылка.Код, 1, 3) = ""21.""
	|				ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ОперативныйУчет)
	|			КОГДА ПОДСТРОКА(ЕПСБУВидыСубконто.Ссылка.Код, 1, 3) = ""02.""
	|				ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаХранении)
	|			КОГДА ПОДСТРОКА(ЕПСБУВидыСубконто.Ссылка.Код, 1, 3) = ""01.""
	|				ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ПолученоВПользование)
	|		КОНЕЦ КАК ВидРаспоряжения
	|	ИЗ
	|		ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|	ГДЕ
	|		ЕПСБУВидыСубконто.Ссылка В
	|			(ВЫБРАТЬ
	|				Таб.Счет
	|			ИЗ
	|				НужноСписать КАК Таб)) КАК Счета
	|СГРУППИРОВАТЬ ПО
	|	Счета.Счет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Стоимость.ОсновноеСредство КАК ОсновноеСредство,
	|	Стоимость.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	Стоимость.Договор КАК Договор,
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) КАК Контрагент,
	|	Стоимость.Подразделение КАК Подразделение,
	|	Стоимость.ЦМО КАК ЦМО,
	|	СУММА(Стоимость.КоличествоОстаток) КАК Количество,
	|	СУММА(Стоимость.СтоимостьОстаток) КАК Стоимость
	|ПОМЕСТИТЬ ОстаткиРН
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(&ДатаПроверки, Организация = &Организация
	|	И ОсновноеСредство В
	|		(ВЫБРАТЬ
	|			НужноСписать.ОсновноеСредство
	|		ИЗ
	|			НужноСписать)
	|	И ВидРаспоряжения В
	|		(ВЫБРАТЬ
	|			Таб.ВидРаспоряжения
	|		ИЗ
	|			ТабСчетов КАК Таб)) КАК Стоимость
	|СГРУППИРОВАТЬ ПО
	|	Стоимость.ИнвентарныйНомер,
	|	Стоимость.ОсновноеСредство,
	|	Стоимость.Договор,
	|	Стоимость.Подразделение,
	|	Стоимость.ЦМО,
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СтоимостьПоКонтрагентам.ОсновноеСредство,
	|	СтоимостьПоКонтрагентам.ИнвентарныйНомер,
	|	СтоимостьПоКонтрагентам.Договор,
	|	СтоимостьПоКонтрагентам.Контрагент,
	|	СтоимостьПоКонтрагентам.Подразделение,
	|	СтоимостьПоКонтрагентам.ЦМО,
	|	СУММА(СтоимостьПоКонтрагентам.КоличествоОстаток),
	|	СУММА(СтоимостьПоКонтрагентам.СтоимостьОстаток)
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОСПоКонтрагентам.Остатки(&ДатаПроверки, Организация = &Организация
	|	И ОсновноеСредство В
	|		(ВЫБРАТЬ
	|			НужноСписать.ОсновноеСредство
	|		ИЗ
	|			НужноСписать)
	|	И ВидРаспоряжения В
	|		(ВЫБРАТЬ
	|			Таб.ВидРаспоряжения
	|		ИЗ
	|			ТабСчетов КАК Таб)) КАК СтоимостьПоКонтрагентам
	|СГРУППИРОВАТЬ ПО
	|	СтоимостьПоКонтрагентам.ИнвентарныйНомер,
	|	СтоимостьПоКонтрагентам.ОсновноеСредство,
	|	СтоимостьПоКонтрагентам.Договор,
	|	СтоимостьПоКонтрагентам.Контрагент,
	|	СтоимостьПоКонтрагентам.Подразделение,
	|	СтоимостьПоКонтрагентам.ЦМО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОсновноеСредство,
	|	ЕСТЬNULL(ОстаткиРН.ИнвентарныйНомер, ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)) КАК ИнвентарныйНомер,
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) КАК КПС,
	|	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК ЦМО,
	|	ЖурналПроводокЕПСБУОстатки.ИФО КАК ИФО,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК
	|		Подразделение,
	|	NULL КАК ДопАналитика,
	|	ЕСТЬNULL(ОстаткиРН.Количество, ЖурналПроводокЕПСБУОстатки.КоличествоОстаток) КАК Количество,
	|	ЕСТЬNULL(ОстаткиРН.Стоимость, ЖурналПроводокЕПСБУОстатки.СуммаОстаток) КАК Сумма
	|ПОМЕСТИТЬ ОстаткиБУ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&ДатаПроверки, Счет В
	|		(ВЫБРАТЬ
	|			ТабСчетов.Счет
	|		ИЗ
	|			ТабСчетов
	|		ГДЕ
	|			ТабСчетов.УчетПоЦМО
	|			И ТабСчетов.ВидДопАналитики ЕСТЬ NULL), &СубконтоОС_ЦМО, Организация = &Организация
	|	И Субконто1 В
	|		(ВЫБРАТЬ
	|			НужноСписать.ОсновноеСредство
	|		ИЗ
	|			НужноСписать)) КАК ЖурналПроводокЕПСБУОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиРН КАК ОстаткиРН
	|		ПО ЖурналПроводокЕПСБУОстатки.Субконто1 = ОстаткиРН.ОсновноеСредство
	|		И ЖурналПроводокЕПСБУОстатки.Субконто2 = ОстаткиРН.ЦМО
	|		И ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Подразделение,
	|			ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) = ОстаткиРН.Подразделение
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОсновноеСредство,
	|	ЕСТЬNULL(ОстаткиРН.ИнвентарныйНомер, ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)) КАК ИнвентарныйНомер,
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) КАК КПС,
	|	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК ЦМО,
	|	ЖурналПроводокЕПСБУОстатки.ИФО КАК ИФО,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК
	|		Подразделение,
	|	ЖурналПроводокЕПСБУОстатки.Субконто3 КАК ДопАналитика,
	|	ЕСТЬNULL(ОстаткиРН.Количество, ЖурналПроводокЕПСБУОстатки.КоличествоОстаток) КАК Количество,
	|	ЕСТЬNULL(ОстаткиРН.Стоимость, ЖурналПроводокЕПСБУОстатки.СуммаОстаток) КАК Стоимость
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&ДатаПроверки, Счет В
	|		(ВЫБРАТЬ
	|			ТабСчетов.Счет
	|		ИЗ
	|			ТабСчетов
