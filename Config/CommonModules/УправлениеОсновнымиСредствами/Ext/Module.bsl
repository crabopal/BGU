					ИмяПоказателя = "П00" + Формат(НомСтроки, "ЧЦ=2; ЧВН=") + Формат(НомПодСтроки, "ЧЦ=2; ЧН=00; ЧВН=") + Формат(НомКолонки, "ЧЦ=2; ЧВН=");
