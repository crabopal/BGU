		|	ВТ_Показатели.НомерСтрокиОтчета КАК НомерСтрокиОтчета,
		|	ВТ_Показатели.НаименованиеОС КАК НаименованиеОС,
		|	ВТ_Показатели.ОсновноеСредство КАК ОсновноеСредство,
		|	ВТ_Показатели.Колонка03 КАК Колонка03,
		|	ВТ_Показатели.Колонка04 КАК Колонка04,
		|	ВТ_Показатели.Колонка05 КАК Колонка05,
		|	ВТ_Показатели.Колонка06 КАК Колонка06,
		|	ВТ_Показатели.Колонка07 КАК Колонка07,
		|	ВТ_Показатели.Колонка08 КАК Колонка08,
		|	ВТ_Показатели.Колонка09 КАК Колонка09,
		|	ВТ_Показатели.Колонка10 КАК Колонка10,
		|	ВТ_Показатели.Колонка11 КАК Колонка11,
		|	ВТ_Показатели.Колонка12 КАК Колонка12
		|ИЗ
		|	ВТ_Показатели КАК ВТ_Показатели
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПоказательСтроки,
		|	НаименованиеОС
		|ИТОГИ
		|	СУММА(Колонка03),
		|	СУММА(Колонка04),
		|	СУММА(Колонка05),
		|	СУММА(Колонка06),
		|	СУММА(Колонка07),
		|	СУММА(Колонка08),
		|	СУММА(Колонка09),
		|	СУММА(Колонка10),
		|	СУММА(Колонка11),
		|	СУММА(Колонка12)
		|ПО
		|	ПоказательСтроки";
	
	Если ПараметрыОтчета.Свойство("Подразделение") Тогда

		ПолеПодразделениеДт = "ЕстьNULL(ЕПСБУДвиженияССубконто.ПодразделениеДт, Значение(Справочник.Подразделения.ПустаяСсылка))";
		ПолеПодразделениеКт = "ЕстьNULL(ЕПСБУДвиженияССубконто.ПодразделениеКт, Значение(Справочник.Подразделения.ПустаяСсылка))";
				
		Если ПараметрыОтчета.ИсключитьДанныеОбособленныхПодразделений Тогда
			
			УсловиеПоПодразделениюДт_РегистрБухгалтерии =
				"НЕ ЕстьNULL(ПодразделениеДт, Значение(Справочник.Подразделения.ПустаяСсылка)) В (&Подразделение)";
				
			УсловиеПоПодразделениюКт_РегистрБухгалтерии =
				"НЕ ЕстьNULL(ПодразделениеКт, Значение(Справочник.Подразделения.ПустаяСсылка)) В (&Подразделение)";
				
			УсловиеПоПодразделению_РегистрБухгалтерии =
				"НЕ ЕстьNULL(Подразделение, Значение(Справочник.Подразделения.ПустаяСсылка)) В (&Подразделение)";
				
			УсловиеПоПодразделению_СтоимостьОбъектовОС = "НЕ СтоимостьОбъектовОС.Подразделение В (&Подразделение)";

			УсловиеПоПодразделениюКт_ОтборПеремещений = "ВТ_ДвиженияДт.ПодразделениеКт В (&Подразделение)";
			УсловиеПоПодразделениюДт_ОтборПеремещений = "ВТ_ДвиженияКт.ПодразделениеДт В (&Подразделение)";
			
		Иначе
					
			УсловиеПоПодразделениюДт_РегистрБухгалтерии = "ПодразделениеДт В (&Подразделение)";
			УсловиеПоПодразделениюКт_РегистрБухгалтерии = "ПодразделениеКт В (&Подразделение)";
			УсловиеПоПодразделению_РегистрБухгалтерии = "Подразделение В (&Подразделение)";
			УсловиеПоПодразделению_СтоимостьОбъектовОС = "СтоимостьОбъектовОС.Подразделение В (&Подразделение)";
			УсловиеПоПодразделениюКт_ОтборПеремещений = "НЕ ВТ_ДвиженияДт.ПодразделениеКт В (&Подразделение)";
			УсловиеПоПодразделениюДт_ОтборПеремещений = "НЕ ВТ_ДвиженияКт.ПодразделениеДт В (&Подразделение)";
					
		КонецЕсли;
		
	Иначе
		
		ПолеПодразделениеДт = "НЕОПРЕДЕЛЕНО";
		ПолеПодразделениеКт = "НЕОПРЕДЕЛЕНО";
		
		УсловиеПоПодразделениюДт_РегистрБухгалтерии = "ИСТИНА";
		УсловиеПоПодразделениюКт_РегистрБухгалтерии = "ИСТИНА";
		УсловиеПоПодразделению_РегистрБухгалтерии = "ИСТИНА";
		УсловиеПоПодразделению_СтоимостьОбъектовОС = "ИСТИНА";
		УсловиеПоПодразделениюКт_ОтборПеремещений = "ЛОЖЬ";
		УсловиеПоПодразделениюДт_ОтборПеремещений = "ЛОЖЬ";
		
	КонецЕсли;

	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеПодразделениеДт", ПолеПодразделениеДт);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеПодразделениеКт", ПолеПодразделениеКт);

	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоПодразделениюДт_РегистрБухгалтерии",
		УсловиеПоПодразделениюДт_РегистрБухгалтерии);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоПодразделениюКт_РегистрБухгалтерии",
		УсловиеПоПодразделениюКт_РегистрБухгалтерии);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоПодразделению_РегистрБухгалтерии",
		УсловиеПоПодразделению_РегистрБухгалтерии);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоПодразделению_СтоимостьОбъектовОС",
		УсловиеПоПодразделению_СтоимостьОбъектовОС);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоПодразделениюКт_ОтборПеремещений",
		УсловиеПоПодразделениюКт_ОтборПеремещений);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоПодразделениюДт_ОтборПеремещений",
		УсловиеПоПодразделениюДт_ОтборПеремещений);

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("Организация", ПараметрыОтчета.Организация);
	Запрос.УстановитьПараметр("НачалоПериода", ПараметрыОтчета.мДатаНачалаПериодаОтчета);
	Запрос.УстановитьПараметр("КонецПериода", ПараметрыОтчета.мДатаКонцаПериодаОтчета);
	Запрос.УстановитьПараметр("ГраницаПериода", Новый Граница(
		ПараметрыОтчета.мДатаКонцаПериодаОтчета, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ВтороеЯнваря", КонецДня(НачалоГода(ПараметрыОтчета.мДатаНачалаПериодаОтчета)) + 1);
	Запрос.УстановитьПараметр("ВидСубконтоОС", ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	Запрос.УстановитьПараметр("СчетаУчета", СчетаУчетаФормы11К(ПараметрыОтчета));
	Запрос.УстановитьПараметр("СчетаАмортизации", СчетаАмортизацииФормы11К(ПараметрыОтчета));
	Запрос.УстановитьПараметр("СчетаИсключения", СчетаИсключенияФормы11К());
	Запрос.УстановитьПараметр("СчетаУчетаЗатрат", СчетаУчетаЗатратФормы11К());
	Запрос.УстановитьПараметр("ИмуществоКазны", ПараметрыОтчета.ИмуществоКазны);
	Запрос.УстановитьПараметр("ТаблицаПоказателей", ТаблицаПоказателейСтрокФормы11К());
	
	Если ПараметрыОтчета.Свойство("Подразделение") Тогда
		Запрос.УстановитьПараметр("Подразделение", ПараметрыОтчета["Подразделение"]);
	КонецЕсли;
	
	Возврат Запрос.Выполнить();
	
КонецФункции

