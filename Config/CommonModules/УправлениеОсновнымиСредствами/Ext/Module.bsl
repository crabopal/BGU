	ПустаяТаблица.Колонки.Добавить("СубконтоЗатратПоАмортизации1",     ОписаниеТиповСубконто);
	ПустаяТаблица.Колонки.Добавить("СубконтоЗатратПоАмортизации2",     ОписаниеТиповСубконто);
	ПустаяТаблица.Колонки.Добавить("СубконтоЗатратПоАмортизации3",     ОписаниеТиповСубконто);
	ПустаяТаблица.Колонки.Добавить("СубконтоЗатратПоАмортизацииНУ",    ОписаниеТиповСубконто);
	// Суммы расходов на модернизацию.
	ПустаяТаблица.Колонки.Добавить("СуммаДемонтажа",                   ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаТранспортировки",             ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаМодернизации",                ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаМодернизацииНУ",              ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаМодернизацииНеУчитываетсяНУ", ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаМодернизацииЕНВД",            ОписаниеТипаСуммы);
	// Амортизационная премия (НУ).
	ПустаяТаблица.Колонки.Добавить("СчетУчетаЗатратПоАмортизационнойПремии", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("СубконтоПоАмортизационнойПремии1",       ОписаниеТиповСубконто);
	ПустаяТаблица.Колонки.Добавить("СубконтоПоАмортизационнойПремии2",       ОписаниеТиповСубконто);
	ПустаяТаблица.Колонки.Добавить("СубконтоПоАмортизационнойПремии3",       ОписаниеТиповСубконто);
	ПустаяТаблица.Колонки.Добавить("СуммаКапитальныхВложенийВключаемыхВРасходыНУ", ОписаниеТипаСуммы);
	
	Возврат ПустаяТаблица;

КонецФункции

// Формирует таблицу источника данных "Модернизация основных средств".
//
Функция ТаблицаМодернизацияОсновныхСредств(Реквизиты, Параметры, Отказ) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Если ТипЗнч(Реквизиты.Ссылка) = Тип("ДокументСсылка.РешениеОПризнанииОбъектовОС") Тогда
		Документы.РешениеОПризнанииОбъектовОС.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, Реквизиты.Ссылка, Параметры);
	ИначеЕсли ТипЗнч(Реквизиты.Ссылка) = Тип("ДокументСсылка.РешениеОПризнанииОбъектовОСИК") Тогда
		Документы.РешениеОПризнанииОбъектовОСИК.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, Реквизиты.Ссылка, Параметры);
	Иначе	
		Если ТипЗнч(Реквизиты.Ссылка) = Тип("ДокументСсылка.РеконструкцияИК") Тогда
			
			Параметры.Вставить("КПС", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Реквизиты.Ссылка, "КПСУчетаИК"));
			
			Параметры.Вставить("СчетУчетаЗатратПоАмортизационнойПремии"			, ПланыСчетов.ЕПСБУ.ПустаяСсылка());
			Параметры.Вставить("СубконтоПоАмортизационнойПремии1"				, ПланыВидовХарактеристик.ВидыСубконто.ПустаяСсылка());
			Параметры.Вставить("СубконтоПоАмортизационнойПремии2"				, ПланыВидовХарактеристик.ВидыСубконто.ПустаяСсылка());
			Параметры.Вставить("СубконтоПоАмортизационнойПремии3"				, ПланыВидовХарактеристик.ВидыСубконто.ПустаяСсылка());
			Параметры.Вставить("СуммаКапитальныхВложенийВключаемыхВРасходыНУ"	, 0);
			Параметры.Вставить("СуммаМодернизацииНУ"							, 0);
			Параметры.Вставить("СуммаМодернизацииНеУчитываетсяНУ"				, 0);
			Параметры.Вставить("СуммаМодернизацииЕНВД"							, 0);
			Параметры.Вставить("ИдентификаторСтроки"							, "");
			
		КонецЕсли;
		
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "ОсновныеСредства",
			"ВидОперации,ИФО,КФО,КПС,Подразделение,
			|СчетКредита,ВнеоборотныйАктив,ВидЗатрат,
			|НомерСтроки,ИдентификаторСтроки,ОсновноеСредство,ИнвентарныйНомер,СчетУчета,ЦМО,
			|СуммаДемонтажа,СуммаТранспортировки,СуммаМодернизации,
			|СуммаМодернизацииНУ,СуммаМодернизацииНеУчитываетсяНУ,СуммаМодернизацииЕНВД,
			|СуммаКапитальныхВложенийВключаемыхВРасходыНУ,СчетУчетаЗатратПоАмортизационнойПремии,
			|СубконтоПоАмортизационнойПремии1,СубконтоПоАмортизационнойПремии2,СубконтоПоАмортизационнойПремии3",
			Реквизиты.Ссылка, Параметры);
	КонецЕсли;		
	
	Запрос.Текст = Запрос.Текст +
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаОсновныеСредства.ОсновноеСредство
	|ИЗ
	|	ТаблицаОсновныеСредства КАК ТаблицаОсновныеСредства";
	
	МассивОС = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ОсновноеСредство");
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СобытияОС.ОсновноеСредство КАК ОсновноеСредство,
	|	СобытияОС.ИнвНомер КАК ИнвНомер,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА СобытияОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ЕстьПринятиеКУчету,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА СобытияОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВводВЭксплуатацию)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ЕстьВводВЭксплуатацию,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА СобытияОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Списание)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ЕстьСписание
	|ПОМЕСТИТЬ НаличиеСобытий
	|ИЗ
	|	РегистрСведений.СобытияОС.СрезПоследних(
	|			&МоментВремени,
	|			Организация = &Организация
	|				И ОсновноеСредство В (&МассивОС)) КАК СобытияОС
	|ГДЕ
	|	СобытияОС.ДатаСобытия <> ДАТАВРЕМЯ(1, 1, 1)
	|
	|СГРУППИРОВАТЬ ПО
	|	СобытияОС.ОсновноеСредство,
	|	СобытияОС.ИнвНомер
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство,
	|	ИнвНомер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПараметрыАмортизацииБУ.ОсновноеСредство КАК ОсновноеСредство,
	|	ПараметрыАмортизацииБУ.ПорядокПогашенияСтоимости КАК ПорядокПогашенияСтоимости,
	|	ПараметрыАмортизацииБУ.СпособНачисленияАмортизации КАК СпособНачисленияАмортизации
	|ПОМЕСТИТЬ РегистрСведенийПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних
	|ИЗ
	|	РегистрСведений.ПараметрыАмортизацииОСБухгалтерскийУчет.СрезПоследних(
	|			&МоментВремени,
	|			Организация = &Организация
	|				И ОсновноеСредство В (&МассивОС)) КАК ПараметрыАмортизацииБУ
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	АмортизацияОС.ОсновноеСредство КАК ОсновноеСредство,
	|	АмортизацияОС.СчетУчетаЗатрат КАК СчетУчетаЗатрат,
	|	АмортизацияОС.КПС КАК КПС,
	|	АмортизацияОС.КЭК КАК КЭК,
	|	АмортизацияОС.Подразделение КАК Подразделение,
	|	АмортизацияОС.Субконто1 КАК Субконто1,
	|	АмортизацияОС.Субконто2 КАК Субконто2,
	|	АмортизацияОС.Субконто3 КАК Субконто3,
	|	АмортизацияОС.СубконтоНУ КАК СубконтоНУ
	|ПОМЕСТИТЬ РегистрСведенийАмортизацияОССрезПоследних
	|ИЗ
	|	РегистрСведений.АмортизацияОС.СрезПоследних(
	|			&МоментВремени,
	|			Организация = &Организация
	|				И ОсновноеСредство В (&МассивОС)) КАК АмортизацияОС
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПервоначальныеСведенияНУ.ОсновноеСредство КАК ОсновноеСредство,
	|	ПервоначальныеСведенияНУ.ПорядокВключенияСтоимостиВСоставРасходов КАК ПорядокВключенияСтоимостиВСоставРасходов
	|ПОМЕСТИТЬ РегистрСведенийПервоначальныеСведенияОСНалоговыйУчетСрезПоследних
	|ИЗ
	|	РегистрСведений.ПервоначальныеСведенияОСНалоговыйУчет.СрезПоследних(
	|			&МоментВремени,
	|			Организация = &Организация
	|				И ОсновноеСредство В (&МассивОС)) КАК ПервоначальныеСведенияНУ
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПервоначальныеСведенияУСН.ОсновноеСредство КАК ОсновноеСредство,
	|	ПервоначальныеСведенияУСН.ПорядокВключенияСтоимостиВСоставРасходовУСН КАК ПорядокВключенияСтоимостиВСоставРасходовУСН
	|ПОМЕСТИТЬ РегистрСведенийПервоначальныеСведенияОСНалоговыйУчетУСНСрезПоследних
	|ИЗ
	|	РегистрСведений.ПервоначальныеСведенияОСНалоговыйУчетУСН.СрезПоследних(
	|			&МоментВремени,
	|			Организация = &Организация
	|				И ОсновноеСредство В (&МассивОС)) КАК ПервоначальныеСведенияУСН
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	""ОсновныеСредства"" КАК ИмяСписка,
	|	""Основные cредства, НМА"" КАК СинонимСписка,
	|	ТаблицаОсновныеСредства.НомерСтроки КАК НомерСтроки,
	|	ТаблицаОсновныеСредства.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ТаблицаОсновныеСредства.ИФО КАК ИФО,
	|	ТаблицаОсновныеСредства.КФО КАК КФО,
	|	ТаблицаОсновныеСредства.КПС КАК КПС,
	|	ТаблицаОсновныеСредства.Подразделение КАК Подразделение,
	|	ТаблицаОсновныеСредства.СчетКредита КАК СчетВложений,
	|	ТаблицаОсновныеСредства.ВнеоборотныйАктив КАК ВнеоборотныйАктив,
	|	ТаблицаОсновныеСредства.ВидЗатрат КАК ВидЗатрат,
	|	ТаблицаОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОсновныеСредства.ОсновноеСредство.ВидНФА КАК ВидНФА,
	|	ТаблицаОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТаблицаОсновныеСредства.СчетУчета КАК СчетУчета,
	|	ТаблицаОсновныеСредства.ЦМО КАК ЦМО,
	|	ТаблицаОсновныеСредства.СчетУчетаЗатратПоАмортизационнойПремии КАК СчетУчетаЗатратПоАмортизационнойПремии,
	|	ТаблицаОсновныеСредства.СубконтоПоАмортизационнойПремии1 КАК СубконтоПоАмортизационнойПремии1,
	|	ТаблицаОсновныеСредства.СубконтоПоАмортизационнойПремии2 КАК СубконтоПоАмортизационнойПремии2,
	|	ТаблицаОсновныеСредства.СубконтоПоАмортизационнойПремии3 КАК СубконтоПоАмортизационнойПремии3,
	|	ТаблицаОсновныеСредства.СуммаКапитальныхВложенийВключаемыхВРасходыНУ КАК СуммаКапитальныхВложенийВключаемыхВРасходыНУ,
	|	ТаблицаОсновныеСредства.СуммаДемонтажа КАК СуммаДемонтажа,
	|	ТаблицаОсновныеСредства.СуммаТранспортировки КАК СуммаТранспортировки,
	|	ТаблицаОсновныеСредства.СуммаМодернизации КАК СуммаМодернизации,
	|	ТаблицаОсновныеСредства.СуммаМодернизацииНУ КАК СуммаМодернизацииНУ,
	|	ТаблицаОсновныеСредства.СуммаМодернизацииНеУчитываетсяНУ КАК СуммаМодернизацииНеУчитываетсяНУ,
	|	ТаблицаОсновныеСредства.СуммаМодернизацииЕНВД КАК СуммаМодернизацииЕНВД,
	|	ВЫБОР
	|		КОГДА НаличиеСобытий.ОсновноеСредство ЕСТЬ NULL
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ПустаяСсылка)
	|		КОГДА НаличиеСобытий.ЕстьСписание
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОС.СнятоСУчета)
	|		КОГДА НаличиеСобытий.ЕстьВводВЭксплуатацию
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ВведеноВЭксплуатацию)
	|		КОГДА НаличиеСобытий.ЕстьПринятиеКУчету
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ПринятоКУчету)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ПустаяСсылка)
	|	КОНЕЦ КАК СостояниеОС,
	|	ПараметрыАмортизацииБУ.ПорядокПогашенияСтоимости КАК ПорядокПогашенияСтоимости,
	|	ПараметрыАмортизацииБУ.СпособНачисленияАмортизации КАК СпособНачисленияАмортизации,
	|	ПервоначальныеСведенияНУ.ПорядокВключенияСтоимостиВСоставРасходов КАК ПорядокВключенияСтоимостиВСоставРасходовНУ,
	|	ПервоначальныеСведенияУСН.ПорядокВключенияСтоимостиВСоставРасходовУСН КАК ПорядокВключенияСтоимостиВСоставРасходовУСН,
	|	АмортизацияОС.СчетУчетаЗатрат КАК СчетУчетаЗатратПоАмортизации,
	|	АмортизацияОС.КПС КАК КПСЗатратПоАмортизации,
	|	АмортизацияОС.КЭК КАК КЭКЗатратПоАмортизации,
	|	АмортизацияОС.Подразделение КАК ПодразделениеЗатратПоАмортизации,
	|	АмортизацияОС.Субконто1 КАК СубконтоЗатратПоАмортизации1,
	|	АмортизацияОС.Субконто2 КАК СубконтоЗатратПоАмортизации2,
	|	АмортизацияОС.Субконто3 КАК СубконтоЗатратПоАмортизации3,
	|	АмортизацияОС.СубконтоНУ КАК СубконтоЗатратПоАмортизацииНУ
	|ИЗ
	|	ТаблицаОсновныеСредства КАК ТаблицаОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ НаличиеСобытий КАК НаличиеСобытий
	|		ПО ТаблицаОсновныеСредства.ОсновноеСредство = НаличиеСобытий.ОсновноеСредство
	|			И ТаблицаОсновныеСредства.ИнвентарныйНомер = НаличиеСобытий.ИнвНомер
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведенийПараметрыАмортизацииОСБухгалтерскийУчетСрезПоследних КАК ПараметрыАмортизацииБУ
	|		ПО ТаблицаОсновныеСредства.ОсновноеСредство = ПараметрыАмортизацииБУ.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведенийАмортизацияОССрезПоследних КАК АмортизацияОС
	|		ПО ТаблицаОсновныеСредства.ОсновноеСредство = АмортизацияОС.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведенийПервоначальныеСведенияОСНалоговыйУчетСрезПоследних КАК ПервоначальныеСведенияНУ
	|		ПО ТаблицаОсновныеСредства.ОсновноеСредство = ПервоначальныеСведенияНУ.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведенийПервоначальныеСведенияОСНалоговыйУчетУСНСрезПоследних КАК ПервоначальныеСведенияУСН
	|		ПО ТаблицаОсновныеСредства.ОсновноеСредство = ПервоначальныеСведенияУСН.ОсновноеСредство
	|ГДЕ
	|	ТаблицаОсновныеСредства.ВидОперации <> ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРеконструкцияОС.КапРемонтОС)";
	
	Запрос.УстановитьПараметр("Ссылка"			, Реквизиты.Ссылка);
	Запрос.УстановитьПараметр("Организация"		, Реквизиты.Организация);
	Запрос.УстановитьПараметр("МассивОС"		,  МассивОС);
	Запрос.УстановитьПараметр("МоментВремени"	, Новый Граница(Реквизиты.Ссылка.МоментВремени(), ВидГраницы.Исключая));
	
	ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	Запрос.МенеджерВременныхТаблиц = Неопределено;
	
	ТаблицаМодернизация = ПустаяТаблицаМодернизацияОсновныхСредств();
	Для Каждого СтрокаТаблицы Из ТаблицаРезультат Цикл
		НоваяСтрока = ТаблицаМодернизация.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
	КонецЦикла;
	
	Возврат ТаблицаМодернизация;
	
КонецФункции

// Формирует таблицу источника данных "Перемещение НФА между счетами".
//
Функция ВнутреннееПеремещениеМеждуСчетамиНФА(РеквизитыДокумента = Неопределено) Экспорт
	
	Если РеквизитыДокумента = Неопределено Тогда
		
		ОписаниеТипаСчет		= Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ");
		ОписаниеТипаСубконто	= Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
		ОписаниеТипаСуммы		= Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
		ОписаниеТипаСуммыМ		= Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Любой));
		ОписаниеТипаКоличества	= Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
		
		ПустаяТаблица = Новый ТаблицаЗначений;
		
		ПустаяТаблица.Колонки.Добавить("Счет"						, ОписаниеТипаСчет);
		ПустаяТаблица.Колонки.Добавить("Субконто1"					, ОписаниеТипаСубконто);
		ПустаяТаблица.Колонки.Добавить("Субконто2"					, ОписаниеТипаСубконто);
		ПустаяТаблица.Колонки.Добавить("Субконто3"					, ОписаниеТипаСубконто);
		ПустаяТаблица.Колонки.Добавить("КПС"						, Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
		ПустаяТаблица.Колонки.Добавить("ИФО"						, Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
		ПустаяТаблица.Колонки.Добавить("Валюта"						, Новый ОписаниеТипов("СправочникСсылка.Валюты"));
		ПустаяТаблица.Колонки.Добавить("Подразделение"				, Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
		ПустаяТаблица.Колонки.Добавить("КФО"						, Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
		ПустаяТаблица.Колонки.Добавить("Сумма"						, ОписаниеТипаСуммы);
		ПустаяТаблица.Колонки.Добавить("ВалютнаяСумма"				, ОписаниеТипаСуммы);
		ПустаяТаблица.Колонки.Добавить("Количество"					, ОписаниеТипаКоличества);
		ПустаяТаблица.Колонки.Добавить("СуммаНеУчитываетсяНУ"		, ОписаниеТипаСуммыМ);
		ПустаяТаблица.Колонки.Добавить("СуммаЕНВД"					, ОписаниеТипаСуммыМ);
		ПустаяТаблица.Колонки.Добавить("СуммаНДС"					, ОписаниеТипаСуммыМ);
		ПустаяТаблица.Колонки.Добавить("Договор"					, Новый ОписаниеТипов("СправочникСсылка.Договоры"));
		ПустаяТаблица.Колонки.Добавить("СчетУчета"					, ОписаниеТипаСчет);
		ПустаяТаблица.Колонки.Добавить("СчетАмортизации"			, ОписаниеТипаСчет);
		ПустаяТаблица.Колонки.Добавить("СчетОбесценения"			, ОписаниеТипаСчет);
		ПустаяТаблица.Колонки.Добавить("ЗабалансовыйСчет"			, ОписаниеТипаСчет);
		ПустаяТаблица.Колонки.Добавить("СчетПередачиВАренду"		, ОписаниеТипаСчет);
		ПустаяТаблица.Колонки.Добавить("СчетПередачиВПользование"	, ОписаниеТипаСчет);
		ПустаяТаблица.Колонки.Добавить("РодительСчет"               , ОписаниеТипаСчет);
		ПустаяТаблица.Колонки.Добавить("РодительЗабалансовыйСчет"        , ОписаниеТипаСчет);
		ПустаяТаблица.Колонки.Добавить("РодительСчетПередачиВАренду"     , ОписаниеТипаСчет);
		ПустаяТаблица.Колонки.Добавить("РодительСчетПередачиВПользование", ОписаниеТипаСчет);
		
		Возврат ПустаяТаблица;
		
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ОсновныеСредства.НомерСтроки КАК НомерСтроки,
	|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ОсновныеСредства.СчетУчетаНовый КАК СчетУчета,
	|	ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка) КАК Договор,
	|	СоответствиеСчетовОС.СчетАмортизации КАК СчетАмортизации,
	|	СоответствиеСчетовОС.СчетОбесценения КАК СчетОбесценения,
	|	СоответствиеСчетовОС.ЗабалансовыйСчет КАК ЗабалансовыйСчет,
	|	СоответствиеСчетовОС.СчетПередачиВАренду КАК СчетПередачиВАренду,
	|	СоответствиеСчетовОС.СчетПередачиВПользование КАК СчетПередачиВПользование
	|ПОМЕСТИТЬ Данные
	|ИЗ
	|	Документ.НакладнаяНаВнутреннееПеремещениеОС2.ОсновныеСредства КАК ОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеСчетовОС КАК СоответствиеСчетовОС
	|		ПО ОсновныеСредства.СчетУчетаНовый = СоответствиеСчетовОС.СчетОС
	|ГДЕ
	|	ОсновныеСредства.Ссылка = &Ссылка
	|	И ОсновныеСредства.СчетУчетаНовый <> ОсновныеСредства.СчетУчета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Счет КАК Счет,
	|	Остатки.Субконто1 КАК Субконто1,
	|	Остатки.Субконто2 КАК Субконто2,
	|	Остатки.Субконто3 КАК Субконто3,
	|	Остатки.КПС КАК КПС,
	|	Остатки.ИФО КАК ИФО,
	|	Остатки.Валюта КАК Валюта,
	|	Остатки.Подразделение КАК Подразделение,
	|	Остатки.КФО КАК КФО,
	|	Остатки.СуммаОстаток КАК Сумма,
	|	Остатки.ВалютнаяСуммаОстаток КАК ВалютнаяСумма,
	|	Остатки.КоличествоОстаток КАК Количество,
	|	Остатки.СуммаНеУчитываетсяНУОстаток КАК СуммаНеУчитываетсяНУ,
	|	Остатки.СуммаЕНВДОстаток КАК СуммаЕНВД,
	|	Остатки.СуммаНДСОстаток КАК СуммаНДС
	|ПОМЕСТИТЬ Остатки
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В (&Счет),
	|			,
	|			Организация = &Организация
	|				И ИФО = &ИФО
	|				И (Субконто1 В
	|						(ВЫБРАТЬ
	|							ВТ.ОсновноеСредство
	|						ИЗ
	|							Данные КАК ВТ)
	|					ИЛИ Субконто2 В
	|						(ВЫБРАТЬ
	|							ВТ.ОсновноеСредство
	|						ИЗ
	|							Данные КАК ВТ))) КАК Остатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Счет КАК Счет,
	|	Остатки.Счет.Родитель КАК РодительСчет,
	|	Остатки.Субконто1 КАК Субконто1,
	|	Остатки.Субконто2 КАК Субконто2,
	|	Остатки.Субконто3 КАК Субконто3,
	|	Остатки.КПС КАК КПС,
	|	Остатки.ИФО КАК ИФО,
	|	Остатки.Валюта КАК Валюта,
	|	Остатки.Подразделение КАК Подразделение,
	|	Остатки.КФО КАК КФО,
	|	Остатки.Сумма КАК Сумма,
	|	Остатки.ВалютнаяСумма КАК ВалютнаяСумма,
	|	Остатки.Количество КАК Количество,
	|	Остатки.СуммаНеУчитываетсяНУ КАК СуммаНеУчитываетсяНУ,
	|	Остатки.СуммаЕНВД КАК СуммаЕНВД,
	|	Остатки.СуммаНДС КАК СуммаНДС,
	|	Данные.Договор КАК Договор,
	|	Данные.СчетУчета КАК СчетУчета,
	|	Данные.СчетАмортизации КАК СчетАмортизации,
	|	Данные.СчетОбесценения КАК СчетОбесценения,
	|	Данные.ЗабалансовыйСчет КАК ЗабалансовыйСчет,
	|	Данные.ЗабалансовыйСчет.Родитель КАК РодительЗабалансовыйСчет,
	|	Данные.СчетПередачиВАренду КАК СчетПередачиВАренду,
	|	Данные.СчетПередачиВАренду.Родитель КАК РодительСчетПередачиВАренду,
	|	Данные.СчетПередачиВПользование КАК СчетПередачиВПользование,
	|	Данные.СчетПередачиВПользование.Родитель КАК РодительСчетПередачиВПользование
	|ИЗ
	|	Данные КАК Данные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Остатки КАК Остатки
	|		ПО (Данные.ОсновноеСредство = Остатки.Субконто1
	|				ИЛИ Данные.ОсновноеСредство = Остатки.Субконто2)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Данные.НомерСтроки,
	|	Остатки.Счет.Порядок";
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИФО = &ИФО", "ИСТИНА");
	КонецЕсли;
	
	Если ТипЗнч(РеквизитыДокумента.Ссылка) = Тип("ДокументСсылка.ВнутреннееПеремещениеИК") Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "НакладнаяНаВнутреннееПеремещениеОС2", "ВнутреннееПеремещениеИК");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)", "ОсновныеСредства.Договор");
		СписокСчетов = БухгалтерскийУчет.СписокСчетов("108.00,104.50")
	Иначе
		СписокСчетов = БухгалтерскийУчет.СписокСчетов("101.00,102.00,103.00,104.00,111.60,114.00,21,25,26")
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка"		, РеквизитыДокумента.Ссылка);
	Запрос.УстановитьПараметр("Период"		, РеквизитыДокумента.Дата);
	Запрос.УстановитьПараметр("Организация"	, РеквизитыДокумента.Организация);
	Запрос.УстановитьПараметр("ИФО"			, РеквизитыДокумента.ИФО);
	Запрос.УстановитьПараметр("Счет"		, СписокСчетов);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции

// Прочее

Функция МожноПровестиПередачуОбъектовОС(ДокументСсылка) Экспорт
	
	Запрос = Новый Запрос;
	
	Если ТипЗнч(ДокументСсылка) = Тип("Структура") Тогда
		
		ЗначенияРеквизитов = ДокументСсылка;
		
		ТекстТаблицы =
		"ВЫБРАТЬ
		|	ТЧОсновныеСредства.НомерСтроки КАК НомерСтроки,
		|	ТЧОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
		|	ТЧОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	ТЧОсновныеСредства.Сумма КАК Сумма,
		|	ТЧОсновныеСредства.Количество КАК Количество
		|ПОМЕСТИТЬ Таблица
		|ИЗ
		|	&ТаблицаОС КАК ТЧОсновныеСредства
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ОсновноеСредство,
		|	ИнвентарныйНомер";
		
		Запрос.УстановитьПараметр("ТаблицаОС", ЗначенияРеквизитов.ТаблицаОС);
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПередачаОбъектовОС") Тогда
		
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Ссылка,Дата,Организация,ВидОперации");
		
		ТекстТаблицы =
		"ВЫБРАТЬ
		|	ТЧОсновныеСредства.НомерСтроки КАК НомерСтроки,
		|	ТЧОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
		|	ТЧОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	ТЧОсновныеСредства.Сумма КАК Сумма,
		|	ТЧОсновныеСредства.Количество КАК Количество
		|ПОМЕСТИТЬ Таблица
		|ИЗ
		|	Документ.ПередачаОбъектовОС.ОсновныеСредства КАК ТЧОсновныеСредства
		|ГДЕ
		|	ТЧОсновныеСредства.Ссылка = &Ссылка";
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПередачаОбъектовИК") Тогда
		
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Ссылка,Дата,Организация,ВидОперации");
		
		ТекстТаблицы =
		"ВЫБРАТЬ
		|	ТЧОсновныеСредства.НомерСтроки КАК НомерСтроки,
		|	ТЧОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
		|	ТЧОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	ТЧОсновныеСредства.Сумма КАК Сумма,
		|	ТЧОсновныеСредства.Количество КАК Количество
		|ПОМЕСТИТЬ Таблица
		|ИЗ
		|	Документ.ПередачаОбъектовИК.ОсновныеСредства КАК ТЧОсновныеСредства
		|ГДЕ
		|	ТЧОсновныеСредства.Ссылка = &Ссылка";
		
	Иначе
		
		ВызватьИсключение НСтр("ru='Функция МожноПровестиПередачуОбъектовОС не предназначена для данного вида документа'");
		
	КонецЕсли;
	
	Если ЗначенияРеквизитов.ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаОСОперУчетАренда
		Или ЗначенияРеквизитов.ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаОСОперУчетВУправление
		Или ЗначенияРеквизитов.ВидОперации = Перечисления.ВидыОперацийПередачиОС.ПередачаОСОперУчетВПользование Тогда
		ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.ОперативныйУчет;
	Иначе
		ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.НаБалансе;
	КонецЕсли;
	
	ВидРаспоряженияПередача = Новый Массив;
	ВидРаспоряженияПередача.Добавить(Перечисления.ВидыРаспоряженияОС.ПереданоВУправление);
	ВидРаспоряженияПередача.Добавить(Перечисления.ВидыРаспоряженияОС.ПереданоВАренду);
	ВидРаспоряженияПередача.Добавить(Перечисления.ВидыРаспоряженияОС.ПереданоВПользование);
	
	Запрос.УстановитьПараметр("Ссылка"					, ДокументСсылка);
	Запрос.УстановитьПараметр("Период"					, ЗначенияРеквизитов.Дата);
	Запрос.УстановитьПараметр("Организация"				, ЗначенияРеквизитов.Организация);
	Запрос.УстановитьПараметр("ВидРаспоряжения"			, ВидРаспоряжения);
	Запрос.УстановитьПараметр("ВидРаспоряженияПередача"	, ВидРаспоряженияПередача);
	
	Запрос.Текст = ТекстТаблицы + ";" + Символы.ПС +
	"ВЫБРАТЬ
	|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СтоимостьОбъектовОСОстатки.СтоимостьОстаток КАК Стоимость,
	|	СтоимостьОбъектовОСОстатки.КоличествоОстаток КАК Количество
	|ПОМЕСТИТЬ ОстаткиОбъектов
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И (ОсновноеСредство, ИнвентарныйНомер) В
	|					(ВЫБРАТЬ
	|						Таблица.ОсновноеСредство КАК ОсновноеСредство,
	|						Таблица.ИнвентарныйНомер КАК ИнвентарныйНомер
	|					ИЗ
	|						Таблица КАК Таблица)
	|				И ВидРаспоряжения = &ВидРаспоряжения) КАК СтоимостьОбъектовОСОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтоимостьОбъектовОСПоКонтрагентамОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьОбъектовОСПоКонтрагентамОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СтоимостьОбъектовОСПоКонтрагентамОстатки.СтоимостьОстаток КАК Стоимость,
	|	СтоимостьОбъектовОСПоКонтрагентамОстатки.КоличествоОстаток КАК Количество
	|ПОМЕСТИТЬ Переданные
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОСПоКонтрагентам.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И (ОсновноеСредство, ИнвентарныйНомер) В
	|					(ВЫБРАТЬ
	|						Таблица.ОсновноеСредство КАК ОсновноеСредство,
	|						Таблица.ИнвентарныйНомер КАК ИнвентарныйНомер
	|					ИЗ
	|						Таблица КАК Таблица)
	|				И ВидРаспоряжения В (&ВидРаспоряженияПередача)) КАК СтоимостьОбъектовОСПоКонтрагентамОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Таблица.НомерСтроки КАК НомерСтроки,
	|	Таблица.ОсновноеСредство КАК ОсновноеСредство,
	|	Таблица.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ВЫБОР
	|		КОГДА Таблица.Сумма <= ЕСТЬNULL(ОстаткиОбъектов.Стоимость, 0)
	|				И Таблица.Количество <= ЕСТЬNULL(ОстаткиОбъектов.Количество, 0)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЕстьОстаток,
	|	ВЫБОР
	|		КОГДА Таблица.Сумма <= ЕСТЬNULL(ОстаткиОбъектов.Стоимость, 0) - ЕСТЬNULL(Переданные.Стоимость, 0)
	|				И Таблица.Количество <= ЕСТЬNULL(ОстаткиОбъектов.Количество, 0) - ЕСТЬNULL(Переданные.Количество, 0)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЕстьДляПередачи
	|ИЗ
	|	Таблица КАК Таблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиОбъектов КАК ОстаткиОбъектов
	|		ПО Таблица.ОсновноеСредство = ОстаткиОбъектов.ОсновноеСредство
	|			И Таблица.ИнвентарныйНомер = ОстаткиОбъектов.ИнвентарныйНомер
	|		ЛЕВОЕ СОЕДИНЕНИЕ Переданные КАК Переданные
	|		ПО Таблица.ОсновноеСредство = Переданные.ОсновноеСредство
	|			И Таблица.ИнвентарныйНомер = Переданные.ИнвентарныйНомер";
	
	Таблица = Запрос.Выполнить().Выгрузить();
	
	Отказ = Ложь;
	
	Для Каждого ТекущаяСтрока Из Таблица Цикл
		
		Если Не ТекущаяСтрока.ЕстьОстаток Тогда
			ШаблонСтроки = НСтр("ru = 'По основному средству ""%1"", инв. №%2 недостаточно остатков в учете'");	
		ИначеЕсли Не ТекущаяСтрока.ЕстьДляПередачи Тогда
			ШаблонСтроки = НСтр("ru = 'По основному средству ""%1"", инв. №%2 недостаточно остатков для передачи'");	
		Иначе
			Продолжить;
		КонецЕсли;
		
		ТекстОшибки = СтрШаблон(ШаблонСтроки, ТекущаяСтрока.ОсновноеСредство, ТекущаяСтрока.ИнвентарныйНомер);
		ПолеОшибки = "Объект.ОсновныеСредства["+ (ТекущаяСтрока.НомерСтроки - 1) +"].ОсновноеСредство";
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЗначенияРеквизитов.Ссылка, ПолеОшибки,, Отказ);
		
	КонецЦикла;
	
	Возврат Не Отказ;
	
КонецФункции

Функция МожноПровестиВозвратОбъектовОС(ДокументСсылка) Экспорт
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовИК") Тогда
		
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка,
			"Дата,Организация,ВидПоступления,Контрагент");
		
		ТекстТаблицы =
		"ВЫБРАТЬ
		|	ПринятиеКУчетуОбъектовИКОсновныеСредства.НомерСтроки КАК НомерСтроки,
		|	ПринятиеКУчетуОбъектовИКОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
		|	ПринятиеКУчетуОбъектовИКОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	ПринятиеКУчетуОбъектовИКОсновныеСредства.Сумма КАК Сумма,
		|	ПринятиеКУчетуОбъектовИКОсновныеСредства.Количество КАК Количество
		|ПОМЕСТИТЬ Таблица
		|ИЗ
		|	Документ.ПринятиеКУчетуОбъектовИК.ОсновныеСредства КАК ПринятиеКУчетуОбъектовИКОсновныеСредства
		|ГДЕ
		|	ПринятиеКУчетуОбъектовИКОсновныеСредства.Ссылка = &Ссылка";
		
	Иначе
		
		ВызватьИсключение НСтр("ru='Функция МожноПровестиВозвратОбъектовОС не предназначена для данного вида документа'");
		
	КонецЕсли;
		
	Если ЗначенияРеквизитов.ВидПоступления = Перечисления.ВидыОперацийИК.ВозвратАренда Тогда
		ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.ПереданоВАренду;
		Шаблон = НСтр("ru = 'Основное средство ""%1"", инв. №%2 не передано в аренду'");
	ИначеЕсли ЗначенияРеквизитов.ВидПоступления = Перечисления.ВидыОперацийИК.ВозвратБезвозмездноеПользование Тогда
		ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.ПереданоВПользование;
		Шаблон = НСтр("ru = 'Основное средство ""%1"", инв. №%2 не передано в безвозмездное пользование'");
	ИначеЕсли ЗначенияРеквизитов.ВидПоступления = Перечисления.ВидыОперацийИК.ВозвратУправление Тогда
		ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.ПереданоВУправление;
		Шаблон = НСтр("ru = 'Основное средство ""%1"", инв. №%2 не передано в доверительное управление'");
	Иначе
		Возврат Истина;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка"			, ДокументСсылка);
	Запрос.УстановитьПараметр("Период"			, ЗначенияРеквизитов.Дата);
	Запрос.УстановитьПараметр("Организация"		, ЗначенияРеквизитов.Организация);
	Запрос.УстановитьПараметр("ВидРаспоряжения"	, ВидРаспоряжения);
	Запрос.Текст = ТекстТаблицы + ";" + Символы.ПС +
	"ВЫБРАТЬ
	|	Таблица.НомерСтроки КАК НомерСтроки,
	|	Таблица.ОсновноеСредство КАК ОсновноеСредство,
	|	Таблица.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	Таблица.Сумма КАК Сумма,
	|	Таблица.Количество КАК Количество,
	|	ЕСТЬNULL(Остатки.СтоимостьОстаток, 0) КАК СуммаОстаток,
	|	ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК КоличествоОстаток
	|ИЗ
	|	Таблица КАК Таблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.СтоимостьОбъектовОСПоКонтрагентам.Остатки(
	|				&Период,
	|				Организация = &Организация
	|					И ВидРаспоряжения = &ВидРаспоряжения
	|					И Контрагент = &Контрагент
	|					И (ОсновноеСредство, ИнвентарныйНомер) В
	|						(ВЫБРАТЬ
	|							ВТ.ОсновноеСредство,
	|							ВТ.ИнвентарныйНомер
	|						ИЗ
	|							Таблица КАК ВТ)) КАК Остатки
	|		ПО Таблица.ОсновноеСредство = Остатки.ОсновноеСредство
	|			И Таблица.ИнвентарныйНомер = Остатки.ИнвентарныйНомер";
	
	Если ЗначенияРеквизитов.Контрагент <> Неопределено Тогда
		Запрос.УстановитьПараметр("Контрагент", ЗначенияРеквизитов.Контрагент);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Контрагент = &Контрагент", "ИСТИНА");
	КонецЕсли;
	
	Остатки = Запрос.Выполнить().Выгрузить();
	
	Отказ = Ложь;
	
	Для Каждого ТекущаяСтрока Из Остатки Цикл
		
		Если ТекущаяСтрока.СуммаОстаток = 0 И ТекущаяСтрока.КоличествоОстаток = 0 Тогда
			ШаблонСтроки = Шаблон;
		ИначеЕсли ТекущаяСтрока.СуммаОстаток < ТекущаяСтрока.Сумма Или ТекущаяСтрока.КоличествоОстаток < ТекущаяСтрока.Количество Тогда
			ШаблонСтроки = НСтр("ru = 'По основному средству ""%1"", инв. №%2 недостаточно остатков'");
		Иначе
			Продолжить;
		КонецЕсли;
		
		ТекстОшибки = СтрШаблон(ШаблонСтроки, ТекущаяСтрока.ОсновноеСредство, ТекущаяСтрока.ИнвентарныйНомер);
		ПолеОшибки = "Объект.ОсновныеСредства["+ (ТекущаяСтрока.НомерСтроки - 1) +"].ОсновноеСредство";
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ДокументСсылка, ПолеОшибки,, Отказ);
		
	КонецЦикла;
	
	Возврат Не Отказ;
	
КонецФункции

#КонецОбласти

#Область ИнвентарныеНомераОС

// Процедура проверяет наличие одинаковых инвентарных номеров в табличной части документа,
// выставляет флаг отказа и выдает сообщение об ошибке.
//
Процедура ПроверитьДублиИнвентарныхНомеровВТабЧасти(Документ, ИмяТабЧасти = "ОсновныеСредства", Отказ = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТабЧастьОсновныеСредства", Документ[ИмяТабЧасти].Выгрузить());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОсновныеСредства.НомерСтроки КАК НомерСтроки,
	|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ВЫРАЗИТЬ(ОсновныеСредства.ИнвентарныйНомер КАК Справочник.ИнвентарныеНомераОС) КАК ИнвентарныйНомер
	|ПОМЕСТИТЬ ТабЧастьОсновныеСредства
	|ИЗ
	|	&ТабЧастьОсновныеСредства КАК ОсновныеСредства
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер
	|ПОМЕСТИТЬ Дубли
	|ИЗ
	|	ТабЧастьОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.ИнвентарныйНомер <> ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	ОсновныеСредства.ОсновноеСредство,
	|	ОсновныеСредства.ИнвентарныйНомер
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(ОсновныеСредства.НомерСтроки) > 1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Дубли.ОсновноеСредство КАК ОсновноеСредство,
	|	Дубли.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	Дубли.ИнвентарныйНомер.Код КАК ИнвентарныйНомерСтрока,
	|	ТабЧасть.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Дубли КАК Дубли
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТабЧастьОсновныеСредства КАК ТабЧасть
	|		ПО Дубли.ОсновноеСредство = ТабЧасть.ОсновноеСредство
	|			И Дубли.ИнвентарныйНомер = ТабЧасть.ИнвентарныйНомер
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|ИТОГИ
	|	МИНИМУМ(НомерСтроки)
	|ПО
	|	ОсновноеСредство,
	|	ИнвентарныйНомер";
	
	Если НЕ ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("ОсновноеСредство", Документ.Метаданные(), ИмяТабЧасти) Тогда
		// Реквизит "Основное средство" в шапке документа.
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"ОсновныеСредства.ОсновноеСредство", "ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)");
		КонецЕсли;
		
	ДеревоСтрок = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Для Каждого СтрокаОС Из ДеревоСтрок.Строки Цикл		
		Для Каждого Выборка Из СтрокаОС.Строки Цикл
			
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='В строках № %1 указан одинаковый инвентарный номер ""%2"".'"),
					СтрСоединить(Выборка.Строки.ВыгрузитьКолонку("НомерСтроки"), ","),
					СокрП(Выборка.ИнвентарныйНомерСтрока));
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,
				"Объект."+ИмяТабЧасти+"["+(Выборка.НомерСтроки - 1)+"].ИнвентарныйНомер",, Отказ);
			
		КонецЦикла;	
	КонецЦикла;
	
КонецПроцедуры

// Возвращает структуру, содержащую инвентарный номер, состояние и ЦМО для требуемого ОС.
// Для получения пустой структуры параметры можно использовать функцию УправлениеОсновнымиСредствами.СтруктураПараметровПолученияОстатков().
//
// Параметры:
//	Параметры - Структура - содержит необходимы для расчета данные:
//		* Организация - СправочникСсылка.Организации - организация для отбора. Необязательный.
//		* Период - МоментВремени, Дата - ограничение периода для расчета. Необязательный.
//		* ЦМО - СправочникСсылка.ЦМО - ЦМО для отбора. Необязательный.
//		* Ссылка - ДокументСсылка - документ, из которого производится вызов. Для отбрасывания движений этого документа при расчете. Необязательный.
//
// Возвращаемое значение:
//   Структура   - ключи структуры:
//		ИнвентарныйНомер	- Справочники.ИнвентарныеНомераОС.ПустаяСсылка()
//		ЦМО					- Справочники.ЦМО.ПустаяСсылка()
//		Состояние			- Перечисления.СостоянияОС.ПустаяСсылка()
//
// Пример:
//	ПараметрыПолученияОстатков = УправлениеОсновнымиСредствами.СтруктураПараметровПолученияОстатков(Объект, Объект.ДатаСписанияСБухУчета);
//	ЗаполнитьЗначенияСвойств(ПараметрыПолученияОстатков, Объект, "ОсновноеСредство, Организация, ЦМО");
//	ДанныеИнвентарногоНомера = УправлениеОсновнымиСредствами.ПолучитьДанныеИнвентарногоНомераОС(ПараметрыПолученияОстатков);
//	Объект.ИнвентарныйНомер = ДанныеИнвентарногоНомера.ИнвентарныйНомер;
//	Если Не ЗначениеЗаполнено(Объект.ЦМО) ТОгда
//		Объект.ЦМО = ДанныеИнвентарногоНомера.ЦМО;
//	КонецЕсли;
//
Функция ПолучитьДанныеИнвентарногоНомераОС(Параметры) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СтоимостьОбъектовОСОстатки.ЦМО КАК ЦМО,
	|	СтоимостьОбъектовОСОстатки.Подразделение КАК Подразделение
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(
	|			&Период,
	|			ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)
	|				И ОсновноеСредство = &ОсновноеСредство
	|				И Организация = &Организация) КАК СтоимостьОбъектовОСОстатки
	|ГДЕ
	|	СтоимостьОбъектовОСОстатки.ЦМО = &ЦМО";
	
	Запрос.УстановитьПараметр("ОсновноеСредство", Параметры["ОсновноеСредство"]);
	
	Если Параметры.Свойство("Период") Тогда
		Запрос.УстановитьПараметр("Период", Параметры["Период"]);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Период", "");
	КонецЕсли;
	
	Если Параметры.Свойство("Организация") Тогда
		Запрос.УстановитьПараметр("Организация", Параметры["Организация"]);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Организация = &Организация", "");
	КонецЕсли;
	
	Если Параметры.Свойство("ЦМО") Тогда
		Запрос.УстановитьПараметр("ЦМО", Параметры["ЦМО"]);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "СтоимостьОбъектовОСОстатки.ЦМО = &ЦМО", "ИСТИНА");
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("ИнвентарныйНомер"	, Справочники.ИнвентарныеНомераОС.ПустаяСсылка());
	Результат.Вставить("ЦМО"				, Справочники.ЦМО.ПустаяСсылка());
	Результат.Вставить("Подразделение"		, Справочники.Подразделения.ПустаяСсылка());
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() = 1 Тогда
		Выборка.Следующий();
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьИнвентарныйНомерНеВЭкплуатации(Знач ОсновноеСредство, Знач Организация, Знач Период, Знач ИспользованныеИнвНомера = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ИнвентарныеНомераОС.Ссылка
	               |ИЗ
	               |	Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	               |ГДЕ
	               |	ИнвентарныеНомераОС.Владелец = &Организация
	               |	И ИнвентарныеНомераОС.ОС = &ОсновноеСредство
	               |	И ИнвентарныеНомераОС.ПометкаУдаления = ЛОЖЬ
	               |	И НЕ ИСТИНА В
	               |				(ВЫБРАТЬ ПЕРВЫЕ 1
	               |					ИСТИНА
	               |				ИЗ
	               |					РегистрСведений.СобытияОС КАК СобытияОС
	               |				ГДЕ
	               |					НЕ &ЗаданМоментВремени
	               |					И СобытияОС.ОсновноеСредство = &ОсновноеСредство
	               |					И СобытияОС.Организация = &Организация
	               |					И СобытияОС.ИнвНомер = ИнвентарныеНомераОС.Ссылка
	               |					И СобытияОС.ДатаСобытия < &ДатаСобытия
	               |		
	               |				ОБЪЕДИНИТЬ ВСЕ
	               |		
	               |				ВЫБРАТЬ ПЕРВЫЕ 1
	               |					ИСТИНА
	               |				ИЗ
	               |					РегистрСведений.СобытияОС КАК СобытияОС
	               |				ГДЕ
	               |					&ЗаданМоментВремени
	               |					И СобытияОС.ОсновноеСредство = &ОсновноеСредство
	               |					И СобытияОС.Организация = &Организация
	               |					И СобытияОС.ИнвНомер = ИнвентарныеНомераОС.Ссылка
	               |					И СобытияОС.МоментВремени < &МоментВремени)";
	Если ТипЗнч(ИспользованныеИнвНомера) = Тип("Массив") ТОгда
		Запрос.Текст = Запрос.Текст + "				   
	               |	И НЕ ИнвентарныеНомераОС.Ссылка В (&ИспользованныеИнвНомера)";
		Запрос.УстановитьПараметр("ИспользованныеИнвНомера",	ИспользованныеИнвНомера);
	КонецЕсли;				   
	Запрос.Текст = Запрос.Текст + "
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ИнвентарныеНомераОС.Код";
	Если ТипЗнч(Период) = Тип("МоментВремени") Тогда
		Запрос.УстановитьПараметр("ДатаСобытия",		Период.Дата);
		Запрос.УстановитьПараметр("МоментВремени",		Период);
		Запрос.УстановитьПараметр("ЗаданМоментВремени", Истина);
	Иначе
		Запрос.УстановитьПараметр("ДатаСобытия",		Период);
		Запрос.УстановитьПараметр("МоментВремени", 		Новый МоментВремени(Период));
		Запрос.УстановитьПараметр("ЗаданМоментВремени", Ложь);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ОсновноеСредство", ОсновноеСредство);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Справочники.ИнвентарныеНомераОС.ПустаяСсылка();
	КонецЕсли;

КонецФункции

#КонецОбласти
 
