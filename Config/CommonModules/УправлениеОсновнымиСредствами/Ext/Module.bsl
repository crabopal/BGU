	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		
		ПутьКРегистру = "(меню ""Налоги / Земельный налог / Регистрация земельных участков"")";
		
		ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Отсутствуют данные о регистрации земельных участков на %1 для %2
