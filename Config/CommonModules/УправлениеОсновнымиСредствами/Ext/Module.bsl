		"106.11,106.13,106.КС,106.21,106.22,106.31,106.32,106.41,106.42,106.43"));
	Запрос.УстановитьПараметр("СчетаУчетаВПути",    БухгалтерскийУчет.СписокСчетов(
		"107.11,107.21,107.31,107.41"));
	Запрос.УстановитьПараметр("СтранаРоссия", Справочники.СтраныМира.Россия);
	
	ДанныеОбъектов = Запрос.Выполнить().Выгрузить();
	
	ДанныеОбъектов.Колонки.Добавить("СчетУчетаНУ",       Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ДанныеОбъектов.Колонки.Добавить("СчетАмортизацииНУ", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	Для Каждого СтрокаТаблицы Из ДанныеОбъектов Цикл
		Если СтрокаТаблицы.ВидНФА = Перечисления.ВидыНФА.ОС Тогда
			СтрокаТаблицы.СчетУчетаНУ       = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н01");
			СтрокаТаблицы.СчетАмортизацииНУ = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н02");
		ИначеЕсли СтрокаТаблицы.ВидНФА = Перечисления.ВидыНФА.НМА Тогда
			СтрокаТаблицы.СчетУчетаНУ       = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н04");
			СтрокаТаблицы.СчетАмортизацииНУ = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("Н05");
		КонецЕсли;
	КонецЦикла;
	
	Возврат ДанныеОбъектов;
	
КонецФункции

Функция СрокПолезногоИспользованияОС(ОсновноеСредство, Период = Неопределено) Экспорт
	
	Если ЗначениеЗаполнено(Период) Тогда
		ТипПериода = ТипЗнч(Период);
		Если ТипПериода = Тип("Дата") Тогда
			ГраницаСреза = Новый Граница(Период, ВидГраницы.Включая);
		Иначе
			ГраницаСреза = Новый Граница(Период.МоментВремени(), ВидГраницы.Исключая);
		КонецЕсли;
	Иначе
		ГраницаСреза = '00010101000000'; // Последнее актуальное значение регистра.
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", ГраницаСреза);
	Запрос.УстановитьПараметр("ОсновноеСредство", ОсновноеСредство);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РасчетАмортизацииОССрезПоследних.СрокПолезногоИспользования КАК СрокПолезногоИспользования
	|ИЗ
	|	РегистрСведений.РасчетАмортизацииОС.СрезПоследних(&Период, ОсновноеСредство = &ОсновноеСредство) КАК РасчетАмортизацииОССрезПоследних";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.СрокПолезногоИспользования;
	Иначе
		Результат = 0;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НакопленнаяАмортизацияОС(ОсновноеСредство, Период,
			ИФО = Неопределено,
			КФО = Неопределено,
			КПС = Неопределено,
			Подразделение = Неопределено,
			Договор = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период",           Период);
	Запрос.УстановитьПараметр("ОсновноеСредство", ОсновноеСредство);
	Запрос.УстановитьПараметр("СчетАмортизации",  БухгалтерскийУчет.СписокСчетов("104.00"));
	
	ВидыСубконто = Новый Массив;
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	Если ЗначениеЗаполнено(Договор) Тогда // 104.40 "Амортизация прав пользования активами".
		ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
	КонецЕсли;
	Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконто);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Амортизация.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	|	Амортизация.СуммаОстатокКт КАК НакопленнаяАмортизация
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В (&СчетАмортизации),
	|			&ВидыСубконто,
	|			Субконто1 = &ОсновноеСредство
	|				И &УсловиеИФО
	|				И &УсловиеКФО
	|				И &УсловиеКПС
	|				И &УсловиеПодразделение
	|				И &УсловиеДоговор) КАК Амортизация";
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	
	ВидНФА = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОсновноеСредство, "ВидНФА");
	Если ВидНФА = Перечисления.ВидыНФА.ПраваПользованияИмуществом Тогда
		ВедетсяУчетПоПодразделениям = УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетПравПользованияПоПодразделениям();
	Иначе
		ВедетсяУчетПоПодразделениям = УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетОСПоПодразделениям();
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО",
		?(ИспользоватьУчетПоИФО И ЗначениеЗаполнено(ИФО), "ИФО = &ИФО", "ИСТИНА"));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО",
		?(ЗначениеЗаполнено(КПС), "КФО = &КФО", "ИСТИНА"));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКПС",
		?(ЗначениеЗаполнено(КПС), "КПС = &КПС", "ИСТИНА"));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПодразделение",
		?(ВедетсяУчетПоПодразделениям И ЗначениеЗаполнено(Подразделение), "Подразделение = &Подразделение", "ИСТИНА"));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеДоговор",
		?(ЗначениеЗаполнено(Договор), "Субконто2 = &Договор", "ИСТИНА"));
	
	Запрос.УстановитьПараметр("ИФО",           ИФО);
	Запрос.УстановитьПараметр("КФО",           КФО);
	Запрос.УстановитьПараметр("КПС",           КПС);
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	Запрос.УстановитьПараметр("Договор",       Договор);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.НакопленнаяАмортизация;
	Иначе
		Результат = 0;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СуммаОбесцененияОС(ОсновноеСредство, Период,
			ИФО = Неопределено,
			КФО = Неопределено,
			КПС = Неопределено,
			Подразделение = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период"				, Период);
	Запрос.УстановитьПараметр("ОсновноеСредство"	, ОсновноеСредство);
	Запрос.УстановитьПараметр("СчетОбесценения"		, БухгалтерскийУчет.СписокСчетов("114.00"));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Обесценение.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	|	Обесценение.СуммаОстатокКт КАК СуммаОбесценения
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В (&СчетОбесценения),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
	|			Субконто1 = &ОсновноеСредство
	|				И &УсловиеИФО
	|				И &УсловиеКФО
	|				И &УсловиеКПС
	|				И &УсловиеПодразделение) КАК Обесценение";
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	
	ВидНФА = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОсновноеСредство, "ВидНФА");
	Если ВидНФА = Перечисления.ВидыНФА.ПраваПользованияИмуществом Тогда
		ВедетсяУчетПоПодразделениям = УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетПравПользованияПоПодразделениям();
	Иначе
		ВедетсяУчетПоПодразделениям = УправлениеОсновнымиСредствамиПовтИсп.ВедетсяУчетОСПоПодразделениям();
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО",
		?(ИспользоватьУчетПоИФО И ЗначениеЗаполнено(ИФО), "ИФО = &ИФО", "ИСТИНА"));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО",
		?(ЗначениеЗаполнено(КФО), "КФО = &КФО", "ИСТИНА"));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКПС",
		?(ЗначениеЗаполнено(КПС), "КПС = &КПС", "ИСТИНА"));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПодразделение",
		?(ВедетсяУчетПоПодразделениям И ЗначениеЗаполнено(Подразделение), "Подразделение = &Подразделение", "ИСТИНА"));
	
	Запрос.УстановитьПараметр("ИФО",           ИФО);
	Запрос.УстановитьПараметр("КФО",           КФО);
	Запрос.УстановитьПараметр("КПС",           КПС);
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.СуммаОбесценения;
	Иначе
		Результат = 0;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Процедуры и функции получения счетов учета ОС (НМА, НПА).

Функция СчетУчетаОС(ОсновноеСредство, Период = Неопределено) Экспорт
	
	ДанныеОбъектаОС = УправлениеОсновнымиСредствами.ДанныеОбъектаОС(ОсновноеСредство, Период);
	Возврат ДанныеОбъектаОС.СчетУчета;
	
КонецФункции

Функция СчетВложенийОС(ОсновноеСредство, Период = Неопределено) Экспорт
	
	ДанныеОбъектаОС = УправлениеОсновнымиСредствами.ДанныеОбъектаОС(ОсновноеСредство, Период);
	Возврат ДанныеОбъектаОС.СчетВложений;
	
КонецФункции

Функция СчетОСВПути(ОсновноеСредство, Период = Неопределено) Экспорт
	
	ДанныеОбъектаОС = УправлениеОсновнымиСредствами.ДанныеОбъектаОС(ОсновноеСредство, Период);
	Возврат ДанныеОбъектаОС.СчетВПути;
	
КонецФункции

Функция СчетОСНаХранении(ОсновноеСредство, Период = Неопределено) Экспорт
	
	ДанныеОбъектаОС = УправлениеОсновнымиСредствами.ДанныеОбъектаОС(ОсновноеСредство, Период);
	Возврат ДанныеОбъектаОС.СчетНаХранении;
	
КонецФункции

Функция ВсеСчетаУчетаОС(СчетУчетаОС) Экспорт
	
	СтруктураСчетов = Новый Структура;
	СтруктураСчетов.Вставить("СчетВПути"				, ПланыСчетов.ЕПСБУ.ПустаяСсылка());
	СтруктураСчетов.Вставить("СчетВложений"				, ПланыСчетов.ЕПСБУ.ПустаяСсылка());
	СтруктураСчетов.Вставить("СчетАмортизации"			, ПланыСчетов.ЕПСБУ.ПустаяСсылка());
	СтруктураСчетов.Вставить("СчетОбесценения"			, ПланыСчетов.ЕПСБУ.ПустаяСсылка());
	СтруктураСчетов.Вставить("ЗабалансовыйСчет"			, ПланыСчетов.ЕПСБУ.ПустаяСсылка());
	СтруктураСчетов.Вставить("СчетПередачиВУправление"	, ПланыСчетов.ЕПСБУ.ПустаяСсылка());
	СтруктураСчетов.Вставить("СчетПередачиВАренду"		, ПланыСчетов.ЕПСБУ.ПустаяСсылка());
	СтруктураСчетов.Вставить("СчетПередачиВПользование"	, ПланыСчетов.ЕПСБУ.ПустаяСсылка());
	
	Если Не ЗначениеЗаполнено(СчетУчетаОС) Тогда
		Возврат СтруктураСчетов;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СчетОС", СчетУчетаОС);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СоответствиеСчетовОС.СчетОС КАК СчетУчета,
	|	СоответствиеСчетовОС.СчетАмортизации КАК СчетАмортизации,
	|	СоответствиеСчетовОС.СчетОбесценения КАК СчетОбесценения,
	|	СоответствиеСчетовОС.ЗабалансовыйСчет КАК ЗабалансовыйСчет,
	|	СоответствиеСчетовОС.СчетПередачиВУправление КАК СчетПередачиВУправление,
	|	СоответствиеСчетовОС.СчетПередачиВАренду КАК СчетПередачиВАренду,
	|	СоответствиеСчетовОС.СчетПередачиВПользование КАК СчетПередачиВПользование
	|ИЗ
	|	РегистрСведений.СоответствиеСчетовОС КАК СоответствиеСчетовОС
	|ГДЕ
	|	(СоответствиеСчетовОС.СчетОС = &СчетОС
	|			ИЛИ СоответствиеСчетовОС.ЗабалансовыйСчет = &СчетОС)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(СтруктураСчетов, Выборка);
	КонецЕсли;
	
	СтруктураСчетов.СчетВПути		= СчетВПутиПоСчетуУчета(СчетУчетаОС);
	СтруктураСчетов.СчетВложений	= СчетВложенийПоСчетуУчета(СчетУчетаОС);
	
	Возврат СтруктураСчетов;
	
КонецФункции

Функция СчетВложенийПоСчетуУчета(СчетУчетаОС) Экспорт
	
	Если Не ЗначениеЗаполнено(СчетУчетаОС) Тогда
		Возврат ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	КонецЕсли;
	
	Если БухгалтерскийУчет.СчетВИерархии(СчетУчетаОС, "106.00") Тогда
		СчетВложений = СчетУчетаОС;
	ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СчетУчетаОС, "101.10") Тогда
		СчетВложений = БухгалтерскийУчет.СчетПоКоду("106.11");
	ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СчетУчетаОС, "101.20") Тогда
		СчетВложений = БухгалтерскийУчет.СчетПоКоду("106.21");
	ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СчетУчетаОС, "101.30") Тогда
		СчетВложений = БухгалтерскийУчет.СчетПоКоду("106.31");
	ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СчетУчетаОС, "101.40") Тогда
		СчетВложений = БухгалтерскийУчет.СчетПоКоду("106.41");
	ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СчетУчетаОС, "102.20") Тогда
		СчетВложений = БухгалтерскийУчет.СчетПоКоду("106.22");
	ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СчетУчетаОС, "102.30") Тогда
		СчетВложений = БухгалтерскийУчет.СчетПоКоду("106.32");
	ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СчетУчетаОС, "102.40") Тогда
		СчетВложений = БухгалтерскийУчет.СчетПоКоду("106.42");
	ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СчетУчетаОС, "103.00") Тогда
		СчетВложений = БухгалтерскийУчет.СчетПоКоду("106.13");
	Иначе
		СчетВложений = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	КонецЕсли;
	
	Возврат СчетВложений;
	
КонецФункции

Функция СчетВПутиПоСчетуУчета(СчетУчетаОС) Экспорт
	
	Если БухгалтерскийУчет.СчетВИерархии(СчетУчетаОС, "101.10") Тогда
		СчетВПути = БухгалтерскийУчет.СчетПоКоду("107.11");
	ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СчетУчетаОС, "101.20") Тогда
		СчетВПути = БухгалтерскийУчет.СчетПоКоду("107.21");
	ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СчетУчетаОС, "101.30") Тогда
		СчетВПути = БухгалтерскийУчет.СчетПоКоду("107.31");
	ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СчетУчетаОС, "101.40") Тогда
		СчетВПути = БухгалтерскийУчет.СчетПоКоду("107.41");
	Иначе
		СчетВПути = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	КонецЕсли;
	
	Возврат СчетВПути;
	
КонецФункции

// Печать формы ОС-1

Функция ДокументыДляПечатиАктОС1_ПринятиеКУчету(МассивОбъектов, ПечататьОС1, ПечататьОС1а, ПечататьОС1б) Экспорт

	МассивОбъектовОС1 = Новый Массив;
	МассивОбъектовОС1а = Новый Массив;
	МассивОбъектовОС1б = Новый Массив;
	
	ТипДокументовОС1	= ОписаниеТиповДокументовОС1("ОС1", "Приход");
	ТипДокументовОС1а	= ОписаниеТиповДокументовОС1("ОС1а", "Приход");
	ТипДокументовОС1б	= ОписаниеТиповДокументовОС1("ОС1б", "Приход");
	
	Для каждого ТекДокумент Из МассивОбъектов Цикл
	
		ТипЗнчДок = ТипЗнч(ТекДокумент);
		Если ТипДокументовОС1а.СодержитТип(ТипЗнчДок) И ПечататьОС1а Тогда
			МассивОбъектовОС1а.Добавить(ТекДокумент);
		ИначеЕсли ТипДокументовОС1.СодержитТип(ТипЗнчДок) И ПечататьОС1 Тогда
			МассивОбъектовОС1.Добавить(ТекДокумент);
		ИначеЕсли ТипДокументовОС1б.СодержитТип(ТипЗнчДок) И ПечататьОС1б Тогда
			МассивОбъектовОС1б.Добавить(ТекДокумент);
		КонецЕсли;
	
	КонецЦикла; 
	
	Запрос = Новый Запрос;	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПринятиеКУчетуЗдания.ОсновноеСредство КАК ОсновноеСредство,
	|	ПринятиеКУчетуЗдания.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	1 КАК ВидАкта
	|ПОМЕСТИТЬ СписокОС
	|ИЗ
	|	Документ.ПринятиеКУчетуЗдания КАК ПринятиеКУчетуЗдания
	|ГДЕ
	|	&ЕстьОС1а
	|	И ПринятиеКУчетуЗдания.Ссылка В(&МассивОбъектовОС1а)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПринятиеКУчетуОбъектаОС.ОсновноеСредство,
	|	ПринятиеКУчетуОбъектаОС.ИнвентарныйНомер,
	|	0
	|ИЗ
	|	Документ.ПринятиеКУчетуОбъектаОС КАК ПринятиеКУчетуОбъектаОС
	|ГДЕ
	|	&ЕстьОС1_
	|	И ПринятиеКУчетуОбъектаОС.Ссылка В(&МассивОбъектовОС1)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПринятиеКУчетуОСОсновныеСредства.ОсновноеСредство,
	|	ПринятиеКУчетуОСОсновныеСредства.ИнвентарныйНомер,
	|	2
	|ИЗ
	|	Документ.ПринятиеКУчетуОС.ОсновныеСредства КАК ПринятиеКУчетуОСОсновныеСредства
	|ГДЕ
	|	&ЕстьОС1б
	|	И ПринятиеКУчетуОСОсновныеСредства.Ссылка В(&МассивОбъектовОС1б)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПринятиеКУчетуЗдания.Ссылка КАК Ссылка,
	|	ПринятиеКУчетуЗдания.Номер КАК НомерАкта,
	|	ПринятиеКУчетуЗдания.Дата КАК пДата,
	|	ПринятиеКУчетуЗдания.Организация КАК Получатель,
	|	ПринятиеКУчетуЗдания.Организация.НаименованиеПолное КАК НаимПолучателя,
	|	ПринятиеКУчетуЗдания.Организация.КодОКПО КАК КодОКПОПолучателя,
	|	ПринятиеКУчетуЗдания.Подразделение КАК Подразделение,
	|	ПринятиеКУчетуЗдания.Подразделение.Наименование КАК ПодрПолучателя,
	|	ПОДСТРОКА(ПринятиеКУчетуЗдания.ОснованиеДляАкта, 1, 100) КАК ОснованиеДляАкта,
	|	ПринятиеКУчетуЗдания.НомерОснованияДляАкта КАК НомерОснованияДляАкта,
	|	ПринятиеКУчетуЗдания.ДатаОснованияДляАкта КАК ДатаОснованияДляАкта,
	|	ПринятиеКУчетуЗдания.Дата КАК ДатаПринятияКУчету,
	|	ПринятиеКУчетуЗдания.ПервоначальнаяСтоимость КАК НачСтоимость,
	|	ПРЕДСТАВЛЕНИЕ(ПринятиеКУчетуЗдания.СпособНачисленияАмортизации) КАК СпособАморт,
	|	ПринятиеКУчетуЗдания.Приложение КАК ТекстПриложения,
	|	ПринятиеКУчетуЗдания.ЦМО КАК ЦМО,
	|	ПринятиеКУчетуЗдания.ЦМО.Сотрудник КАК МОЛ,
	|	ПринятиеКУчетуЗдания.ЦМО.Сотрудник.Код КАК ТабНомМОЛ,
	|	ПринятиеКУчетуЗдания.ДолжностьПредседателяКомиссии КАК ДолжностьПредседателяКомиссии,
	|	ПринятиеКУчетуЗдания.ФамилияПредседателяКомиссии КАК ФамилияПредседателяКомиссии,
	|	ПринятиеКУчетуЗдания.ИмяПредседателяКомиссии КАК ИмяПредседателяКомиссии,
	|	ПринятиеКУчетуЗдания.ОтчествоПредседателяКомиссии КАК ОтчествоПредседателяКомиссии,
	|	ПринятиеКУчетуЗдания.РеквизитыЛицевогоСчета КАК РеквизитыЛицевогоСчета,
	|	ПринятиеКУчетуЗдания.РеквизитыЛицевогоСчета.Владелец КАК ЛицевойСчет,
	|	ПРЕДСТАВЛЕНИЕ(ПринятиеКУчетуЗдания.КПС) КАК КПС,
	|	ПРЕДСТАВЛЕНИЕ(ПринятиеКУчетуЗдания.КФО) КАК КФО,
	|	ПринятиеКУчетуЗдания.ОсновноеСредство.КодОКОФ.Код КАК пКодПоОКОФ,
	|	ВЫБОР
	|		КОГДА ПринятиеКУчетуЗдания.ОсновноеСредство.АмортизационнаяГруппа = ЗНАЧЕНИЕ(Перечисление.АмортизационныеГруппы.ПустаяСсылка)
	|			ТОГДА """"
	|		ИНАЧЕ ПринятиеКУчетуЗдания.ОсновноеСредство.АмортизационнаяГруппа.Порядок + 1
	|	КОНЕЦ КАК НомерАмортГруппы,
	|	ПринятиеКУчетуЗдания.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ПринятиеКУчетуЗдания.ИнвентарныйНомер.Код КАК ИнвНомер,
	|	ВЫБОР
	|		КОГДА ПринятиеКУчетуЗдания.ДатаВводаВЭксплуатацию = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА ПринятиеКУчетуЗдания.СрокПолезногоИспользования
	|		ИНАЧЕ ПринятиеКУчетуЗдания.ОставшийсяСрокПолезногоИспользования
	|	КОНЕЦ КАК СрокПолезнИспПриПост,
	|	ВЫБОР
	|		КОГДА ПринятиеКУчетуЗдания.ОсновноеСредство.НаименованиеПолное = """"
	|			ТОГДА ПринятиеКУчетуЗдания.ОсновноеСредство.Наименование
