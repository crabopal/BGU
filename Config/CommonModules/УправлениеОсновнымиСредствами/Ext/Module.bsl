Функция ПолучитьТаблицыАмортизацииТекущегоМесяца(ДокументСсылка, ЭтоИмуществоКазны = Ложь) Экспорт
	
	Если ДокументСсылка.Метаданные().ТабличныеЧасти.Найти("ОсновныеСредства") <> Неопределено Тогда
		ОсновныеСредства = ДокументСсылка.ОсновныеСредства.ВыгрузитьКолонку("ОсновноеСредство");
	Иначе
		ОсновныеСредства = Новый Массив;
		ОсновныеСредства.Добавить(ДокументСсылка.ОсновноеСредство);
	КонецЕсли;
	
	Отказ = Ложь;
	ТаблицыАмортизации = РасчетАмортизацииОСиНМА(ОсновныеСредства, ДокументСсылка, Отказ, Ложь, ЭтоИмуществоКазны);
	
	Возврат ТаблицыАмортизации;
	
КонецФункции

// Функция выполняет расчет амортизации для объектов ОС и НМА (в т.ч. для имущества казны) в БУ и НУ
// и возвращает таблицы для отражения сумм начисленной амортизации в учете.
// Используется как при ежемесячном (регламентном) начислении амортизации,
// так и при начислении амортизации при выбытии объектов ОС и НМА.
//
// Параметры:
//  ОсновныеСредства - ТаблицаЗначений - определяет состав объектов ОС и НМА, для которых нужно рассчитать амортизацию:
//  - при регламентном начислении амортизации - это таблица "Отбор" документов "НачислениеАмортизацииОС" и "НачислениеАмортизацииИК".
//  - при начислении амортизации при выбытии объектов ОС и НМА - это массив объектов ОС м НМА.
//  Реквизиты - ДокументСсылка, ДокументОбъект, Структура - реквизиты шапки документа, используемые для расчета амортизации:
//    "Ссылка", "Организация", "Дата", "КФО", "ИФО", "Подразделение".
//  Отказ - Булево - флаг ошибки при расчете амортизации.
//  ЭтоРегламентноеНачислениеАмортизации - Булево - признак ежемесячного (регламентного) начисления амортизации:
//  - "Истина" - ежемесячное (регламентное) начисление амортизации,
//  - "Ложь"   - начисление амортизации при выбытии объектов ОС и НМА.
//  ЭтоИмуществоКазны - Булево - признак начисления амортизации имущества казны:
//  - "Истина" - начисление амортизации по имуществу казны,
//  - "Ложь"   - начисление амортизации по обычным ОС и НМА.
//
// Возвращаемое значение:
//  Структура - содержит таблицы: "ТаблицаАмортизацияБУ", "ТаблицаАмортизацияНУ".
//
Функция РасчетАмортизацииОСиНМА(ОсновныеСредства, Данные, Отказ,
			ЭтоРегламентноеНачислениеАмортизации = Ложь, ЭтоИмуществоКазны = Ложь) Экспорт
			
	Реквизиты = Новый Структура("Организация, ИФО, КФО, Подразделение, Дата, ДатаСписанияСБухУчета, Ссылка");
	ЗаполнитьЗначенияСвойств(Реквизиты, Данные);
	
	// Определим дату проведения
	//Отбор = Новый Структура("Документ", Данные);
	Отбор = Новый Структура("Документ", Реквизиты.Ссылка);
	ВыборкаДатаПроведения = РегистрыСведений.ДатыПроведенияДокументов.Выбрать(Отбор);
	Если ВыборкаДатаПроведения.Следующий() И ЗначениеЗаполнено(ВыборкаДатаПроведения.ДатаПроведения) Тогда
		Реквизиты.Вставить("Дата", ВыборкаДатаПроведения.ДатаПроведения);
	ИначеЕсли ЗначениеЗаполнено(Реквизиты.ДатаСписанияСБухУчета) Тогда
		Реквизиты.Дата = Реквизиты.ДатаСписанияСБухУчета;
	КонецЕсли;
	
	// Функция возвращает структуру таблиц с данными о начисленной амортизации.
	ТаблицыАмортизации = Новый Структура;
	ТаблицыАмортизации.Вставить("ТаблицаНачисленияАмортизацииБУ", ПустаяТаблицаНачисленияАмортизацииБУ());
	ТаблицыАмортизации.Вставить("ТаблицаНачисленияАмортизацииНУ", ПустаяТаблицаНачисленияАмортизацииНУ());
	
	УчетнаяПолитика = Справочники.Организации.ПолучитьУчетнуюПолитику(Реквизиты.Организация, Реквизиты.Дата);
	
	МетодНачисленияАмортизацииНУ = УчетнаяПолитика.МетодНачисленияАмортизацииНУ;
	Если УчетнаяПолитика.ПлательщикНалогаНаПрибыль И Не ЗначениеЗаполнено(МетодНачисленияАмортизацииНУ) Тогда
		ШаблонСообщения = НСтр("ru = 'Не указан метод начисления амортизации (НУ) в учетной политике организации ""%1"".
                                |Укажите метод начисления амортизации.'");
		ТекстСообщения = СтрШаблон(ШаблонСообщения, Реквизиты.Организация);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Отказ = Истина;
		Возврат ТаблицыАмортизации;
	КонецЕсли;
	
	Если ЭтоИмуществоКазны И Не УчетнаяПолитика.НачислятьАмортизациюИмуществаКазны Тогда
		Возврат ТаблицыАмортизации;
	КонецЕсли;
	
	// Получим данные, необходимые для расчета амортизации БУ и НУ.
	ТаблицыДляРасчетаАмортизации = ПодготовитьТаблицыДляРасчетаАмортизацииОСиНМА(ОсновныеСредства,
		Реквизиты, ЭтоРегламентноеНачислениеАмортизации, ЭтоИмуществоКазны);
	
	// Бухгалтерский учет.
	Для Каждого СтрокаТаблицы Из ТаблицыДляРасчетаАмортизации.ТаблицаАмортизацияБУ Цикл
		
		Если СтрокаТаблицы.СпособНачисленияАмортизации = Перечисления.СпособНачисленияАмортизации.Линейный Тогда
			
			Если СтрокаТаблицы.СрокИспользованияДляВычисленияАмортизации = 0 Тогда
				
				СуммаАмортизации = 0;
				
			Иначе
				
				СуммаАмортизации = (СтрокаТаблицы.СтоимостьДляВычисленияАмортизации / СтрокаТаблицы.СрокИспользованияДляВычисленияАмортизации);
				
				СуммаАмортизации = Окр(СуммаАмортизации,2,1);
				
				СуммаОшибкиОкругления = 0.01 * СтрокаТаблицы.СрокПолезногоИспользования;
				Если СтрокаТаблицы.ОстаточнаяСтоимость - СуммаАмортизации <= СуммаОшибкиОкругления Тогда
					СуммаАмортизации = СтрокаТаблицы.ОстаточнаяСтоимость;
				КонецЕсли;
				
			КонецЕсли;
			
		ИначеЕсли СтрокаТаблицы.СпособНачисленияАмортизации = Перечисления.СпособНачисленияАмортизации.УменьшаемогоОстатка Тогда
			
			ПоследнийМесяц = ДобавитьМесяц(СтрокаТаблицы.ДатаПринятияКУчету, СтрокаТаблицы.СрокПолезногоИспользования);
			
			Если КонецМесяца(Реквизиты.Дата) >= КонецМесяца(ПоследнийМесяц) Тогда
				
				СуммаАмортизации = СтрокаТаблицы.ОстаточнаяСтоимость;
				
			ИначеЕсли СтрокаТаблицы.СрокИспользованияДляВычисленияАмортизации = 0 Тогда
				
				СуммаАмортизации = 0;
				
			Иначе
				
				Если Год(Реквизиты.Дата) > Год(СтрокаТаблицы.ПериодРасчета)  Тогда
					СтрокаТаблицы.СтоимостьДляВычисленияАмортизации = СтрокаТаблицы.ОстаточнаяСтоимостьНаНачалоГода;
				КонецЕсли;
				
				СуммаАмортизации = (СтрокаТаблицы.СтоимостьДляВычисленияАмортизации / СтрокаТаблицы.СрокИспользованияДляВычисленияАмортизации)
					* СтрокаТаблицы.КоэффициентУскорения;
				
				СуммаАмортизации = Мин(Окр(СуммаАмортизации,2,1), СтрокаТаблицы.ОстаточнаяСтоимость);
				
			КонецЕсли;
			
		ИначеЕсли СтрокаТаблицы.СпособНачисленияАмортизации = Перечисления.СпособНачисленияАмортизации.ПропорциональноОбъемуПродукции Тогда
			
			Если СтрокаТаблицы.ПредполагаемыйОбъемВыработки = 0 Тогда
				СуммаАмортизации = 0;
			Иначе
				СуммаАмортизации = СтрокаТаблицы.СтоимостьДляВычисленияАмортизации
					* СтрокаТаблицы.ОбъемВыработки / СтрокаТаблицы.ПредполагаемыйОбъемВыработки;
				СуммаАмортизации = Мин(Окр(СуммаАмортизации,2,1), СтрокаТаблицы.ОстаточнаяСтоимость);
			КонецЕсли;
			
		КонецЕсли;
		
		Если СуммаАмортизации > 0 Тогда
			НоваяСтрока = ТаблицыАмортизации.ТаблицаНачисленияАмортизацииБУ.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			НоваяСтрока.СуммаАмортизацииБУ = СуммаАмортизации;
		КонецЕсли;
		
	КонецЦикла;
	
	// Налоговый учет.
	Для Каждого СтрокаТаблицы Из ТаблицыДляРасчетаАмортизации.ТаблицаАмортизацияНУ Цикл
		
		Если Не (СтрокаТаблицы.СтоимостьНаНачалоПериода > 0
			Или СтрокаТаблицы.СтоимостьНеУчитываетсяНУНаНачалоПериода > 0
			Или СтрокаТаблицы.СтоимостьЕНВДНаНачалоПериода > 0) Тогда
			Продолжить; // начинаем начислять со следующего месяца после ввода в эксплуатацию
		КонецЕсли;
		
		Если Не (СтрокаТаблицы.СтоимостьНаНачалоПериода > СтрокаТаблицы.АмортизацияНаНачалоПериода
			Или СтрокаТаблицы.СтоимостьНеУчитываетсяНУНаНачалоПериода > СтрокаТаблицы.АмортизацияНеУчитываетсяНУНаНачалоПериода
			Или СтрокаТаблицы.СтоимостьЕНВДНаНачалоПериода > СтрокаТаблицы.АмортизацияЕНВДНаНачалоПериода) Тогда
			Продолжить; // амортизация начислена полностью
		КонецЕсли;
		
		Если НЕ СтрокаТаблицы.ГрупповойУчет Тогда		
			Если СтрокаТаблицы.АмортизацияОборот > 0
				Или СтрокаТаблицы.АмортизацияНеУчитываетсяНУОборот > 0
				Или СтрокаТаблицы.АмортизацияЕНВДОборот > 0 Тогда
				Продолжить; // амортизация в этом месяце уже начислялась
			КонецЕсли;
		КонецЕсли;
		
		Если СтрокаТаблицы.ТолькоЛинейныйМетодНУ Тогда
			МетодНачисленияАмортизации = Перечисления.МетодыНачисленияАмортизации.Линейный;
		Иначе
			МетодНачисленияАмортизации = МетодНачисленияАмортизацииНУ;
		КонецЕсли;
		
		Если МетодНачисленияАмортизации = Перечисления.МетодыНачисленияАмортизации.Линейный
			И Не ЗначениеЗаполнено(СтрокаТаблицы.СрокПолезногоИспользованияНУ) Тогда
			
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Срок использования равен нулю'"));
			Продолжить;
			
		ИначеЕсли МетодНачисленияАмортизации = Перечисления.МетодыНачисленияАмортизации.Нелинейный
			И Не ЗначениеЗаполнено(СтрокаТаблицы.АмортизационнаяГруппа) Тогда
			
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не указана амортизационная группа'"));
			Продолжить;
			
		КонецЕсли;
		
		СуммаАмортизацииНУ				= 0;
		СуммаАмортизацииНеУчитываетсяНУ	= 0;
		СуммаАмортизацииЕНВД			= 0;
		
		Если СтрокаТаблицы.ГрупповойУчет И СтрокаТаблицы.СтоимостьВыбыло > 0 Тогда
			СтоимостьДляВычисления = СтрокаТаблицы.СтоимостьНаНачалоПериода
				- СтрокаТаблицы.СтоимостьВыбыло // Учет выбытия инвентарных объектов из группы.
				- СтрокаТаблицы.СуммаКапитальныхВложенийВключаемыхВРасходы;
			СтоимостьНеУчитываетсяНУДляВычисления = СтрокаТаблицы.СтоимостьНеУчитываетсяНУНаНачалоПериода
				- СтрокаТаблицы.СтоимостьНеУчитываетсяНУВыбыло;
			СтоимостьЕНВДДляВычисления = СтрокаТаблицы.СтоимостьЕНВДНаНачалоПериода
				- СтрокаТаблицы.СтоимостьЕНВДВыбыло;
		Иначе
			СтоимостьДляВычисления = СтрокаТаблицы.СтоимостьНаНачалоПериода
				- СтрокаТаблицы.СуммаКапитальныхВложенийВключаемыхВРасходы;
			СтоимостьНеУчитываетсяНУДляВычисления = СтрокаТаблицы.СтоимостьНеУчитываетсяНУНаНачалоПериода;
			СтоимостьЕНВДДляВычисления = СтрокаТаблицы.СтоимостьЕНВДНаНачалоПериода;
		КонецЕсли;		
		
		СрокИспользованияДляВычисления = Макс(1, СтрокаТаблицы.СрокПолезногоИспользованияНУ);
		
		СпециальныйКоэффициент = ?(СтрокаТаблицы.СпециальныйКоэффициент = 0, 1, СтрокаТаблицы.СпециальныйКоэффициент);
		
		Если МетодНачисленияАмортизации = Перечисления.МетодыНачисленияАмортизации.Линейный Тогда
			
			СтоимостьДляВычисления = СтоимостьДляВычисления - СтрокаТаблицы.АмортизацияПриПереходеКЛинейномуМетоду;
			СрокИспользованияДляВычисления = СрокИспользованияДляВычисления - СтрокаТаблицы.ФактическийСрокПриПереходеКЛинейномуМетоду;
			
			СуммаАмортизацииНУ =
				СтоимостьДляВычисления                / СрокИспользованияДляВычисления * СпециальныйКоэффициент;
			СуммаАмортизацииНеУчитываетсяНУ =
				СтоимостьНеУчитываетсяНУДляВычисления / СрокИспользованияДляВычисления * СпециальныйКоэффициент;
			СуммаАмортизацииЕНВД =
				СтоимостьЕНВДДляВычисления            / СрокИспользованияДляВычисления * СпециальныйКоэффициент;
			
		ИначеЕсли МетодНачисленияАмортизации = Перечисления.МетодыНачисленияАмортизации.Нелинейный Тогда
			
			НормаАмортизации = ПолучитьНормуПоАмортизационнойГруппе(СтрокаТаблицы.АмортизационнаяГруппа);
			
			Если Не (НормаАмортизации = Неопределено) Тогда
				
				СтоимостьДляВычисления = СтоимостьДляВычисления - СтрокаТаблицы.АмортизацияНаНачалоПериода;
				
				СуммаАмортизацииНУ = СтоимостьДляВычисления
				* НормаАмортизации / 100
				* СпециальныйКоэффициент;
				
				СуммаАмортизацииНеУчитываетсяНУ = (СтоимостьНеУчитываетсяНУДляВычисления
					- СтрокаТаблицы.АмортизацияНеУчитываетсяНУНаНачалоПериода)
					* НормаАмортизации / 100
					* СпециальныйКоэффициент;
				
				СуммаАмортизацииЕНВД = (СтоимостьЕНВДДляВычисления - СтрокаТаблицы.АмортизацияЕНВДНаНачалоПериода)
					* НормаАмортизации / 100
					* СпециальныйКоэффициент;
				
			КонецЕсли;
			
		КонецЕсли;
		
		ВсегоОсталосьСписать = СтрокаТаблицы.СтоимостьНаНачалоПериода
			+ СтрокаТаблицы.СтоимостьНеУчитываетсяНУНаНачалоПериода
			+ СтрокаТаблицы.СтоимостьЕНВДНаНачалоПериода
			- (СтрокаТаблицы.АмортизацияНаНачалоПериода
				+ СтрокаТаблицы.АмортизацияНеУчитываетсяНУНаНачалоПериода
				+ СтрокаТаблицы.АмортизацияЕНВДНаНачалоПериода);
		
		// Амортизация (НУ)
		ВсегоОсталосьСписатьНУ = СтрокаТаблицы.СтоимостьНаНачалоПериода - СтрокаТаблицы.АмортизацияНаНачалоПериода;
		СуммаАмортизацииНУ     = Окр(Мин(ВсегоОсталосьСписать, ВсегоОсталосьСписатьНУ, СуммаАмортизацииНУ), 2);
		
		// Амортизация (не учитывается НУ)
		ВсегоОсталосьСписать			= ВсегоОсталосьСписать - СуммаАмортизацииНУ;
		СуммаАмортизацииНеУчитываетсяНУ	= Окр(Мин(ВсегоОсталосьСписать, СуммаАмортизацииНеУчитываетсяНУ), 2);
		
		// Амортизация (ЕНВД)
		ВсегоОсталосьСписать			= ВсегоОсталосьСписать - СуммаАмортизацииНеУчитываетсяНУ;
		СуммаАмортизацииЕНВД			= Окр(Мин(ВсегоОсталосьСписать, СуммаАмортизацииЕНВД), 2);
		
		Если СуммаАмортизацииНУ > 0 Или СуммаАмортизацииНеУчитываетсяНУ > 0 Или СуммаАмортизацииЕНВД > 0 Тогда
			
			// Определим счет затрат для целей НУ.
			СтрокаТаблицы.СчетЗатратНУ = НалоговыйУчетКлиентСервер.СчетРасходовНУ(
				СтрокаТаблицы.СчетЗатрат, СтрокаТаблицы.СубконтоЗатрат1, СтрокаТаблицы.СубконтоЗатрат2, СтрокаТаблицы.СубконтоЗатрат3,
				СтрокаТаблицы.КорСчетЗатрат, Реквизиты.Организация, СтрокаТаблицы.ИФО, СтрокаТаблицы.ПодразделениеЗатрат, Реквизиты.Дата);
			
			// Скорректируем рассчитанные суммы в случае начисления амортизации на ЕНВД или не учитываемые расходы.
			ЭтоНеУчитываемые  = Ложь;
			ЭтоЕНВД           = Ложь;
			
			СвойстваСчетаДт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаТаблицы.СчетЗатратНУ);
			
			Если БухгалтерскийУчет.СчетВИерархии(СтрокаТаблицы.СчетЗатратНУ, "Н08,Н15,Н20,Н25,Н26,Н44") Тогда
				
				ВидЗатрат = Неопределено;
				Для НомерСубконто = 1 По СвойстваСчетаДт.КоличествоСубконто Цикл
					Если СвойстваСчетаДт["ВидСубконто"+НомерСубконто]
						= ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.ВидыЗатрат") Тогда
						ВидЗатрат = СтрокаТаблицы["СубконтоЗатрат"+НомерСубконто];
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
				Если ЗначениеЗаполнено(ВидЗатрат) И ТипЗнч(ВидЗатрат) = Тип("СправочникСсылка.ВидыЗатрат") Тогда
					ЭтоЕНВД = (ВидЗатрат.ВидДеятельностиДляНалоговогоУчетаЗатрат
						= Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсобыйПорядокНалогообложения);
					ЭтоНеУчитываемые = (ВидЗатрат.ВидРасходовНУ
						= Перечисления.ВидыРасходовНУ.НеУчитываемыеВЦеляхНалогообложения);
				КонецЕсли;
				
			КонецЕсли;
			
			Если БухгалтерскийУчет.СчетВИерархии(СтрокаТаблицы.СчетЗатратНУ, "Н91.02") Тогда
				
				СтатьяПрочихРасходов = СтрокаТаблицы.СубконтоЗатратНУ;
				Если ЗначениеЗаполнено(СтатьяПрочихРасходов) 
					И ТипЗнч(СтатьяПрочихРасходов) = Тип("СправочникСсылка.ПрочиеДоходыИРасходы") Тогда
					Если ЗначениеЗаполнено(СтатьяПрочихРасходов)
						И ТипЗнч(СтатьяПрочихРасходов) = Тип("СправочникСсылка.ПрочиеДоходыИРасходы") Тогда
						ЭтоЕНВД = (СтатьяПрочихРасходов.ВидДеятельностиДляНалоговогоУчетаЗатрат
							= Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсобыйПорядокНалогообложения);
						ЭтоНеУчитываемые = (Не СтатьяПрочихРасходов.ПринятиеКналоговомуУчету);
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			
			Если ЭтоНеУчитываемые Или ЭтоЕНВД Тогда
				ОбщаяСуммаАмортизации           = СуммаАмортизацииНУ + СуммаАмортизацииНеУчитываетсяНУ
					+ СуммаАмортизацииЕНВД;
				СуммаАмортизацииНеУчитываетсяНУ = ?(ЭтоНеУчитываемые, ОбщаяСуммаАмортизации, 0);
				СуммаАмортизацииЕНВД            = ?(ЭтоЕНВД,          ОбщаяСуммаАмортизации, 0);
				СуммаАмортизацииНУ              = 0;
			КонецЕсли;
			
			// Добавим в таблицу начисленной амортизации (НУ).
			НоваяСтрока = ТаблицыАмортизации.ТаблицаНачисленияАмортизацииНУ.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			НоваяСтрока.Количество = ?(НоваяСтрока.ГрупповойУчет, СтрокаТаблицы.Количество, 1);
			НоваяСтрока.СуммаАмортизацииНУ              = СуммаАмортизацииНУ;
			НоваяСтрока.СуммаАмортизацииНеУчитываетсяНУ = СуммаАмортизацииНеУчитываетсяНУ;
			НоваяСтрока.СуммаАмортизацииЕНВД            = СуммаАмортизацииЕНВД;
			
			// Параметры расчета амортизации.
			НоваяСтрока.МетодНачисленияАмортизацииНУ        = МетодНачисленияАмортизации;
			НоваяСтрока.СтоимостьДляВычисленияАмортизацииНУ = СтоимостьДляВычисления;
			НоваяСтрока.СпециальныйКоэффициентНУ            = СпециальныйКоэффициент;
			Если МетодНачисленияАмортизации = Перечисления.МетодыНачисленияАмортизации.Линейный Тогда
				НоваяСтрока.СрокИспользованияДляВычисленияАмортизацииНУ = СрокИспользованияДляВычисления;
			ИначеЕсли МетодНачисленияАмортизации = Перечисления.МетодыНачисленияАмортизации.Нелинейный Тогда
				НоваяСтрока.НормаАмортизацииНУ = Число(НормаАмортизации);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицыАмортизации;
	
КонецФункции

// Проверяет корректность параметров амортизации объектов ОС и НМА при начислении амортизации.
//
Процедура ПроверитьПараметрыАмортизацииОбъектов(ДокументОбъект, Отказ) Экспорт
	
	Если ТипЗнч(ДокументОбъект) <> Тип("ДокументОбъект.НачислениеАмортизацииОС")
	   И ТипЗнч(ДокументОбъект) <> Тип("ДокументОбъект.НачислениеАмортизацииИК") Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыАмортизации = УправлениеОсновнымиСредствами.ПараметрыАмортизацииОбъектовОС(
		ДокументОбъект.ОсновныеСредства.ВыгрузитьКолонку("ОсновноеСредство"), ДокументОбъект.Ссылка);
	
	Для Каждого СтрокаДокумента Из ДокументОбъект.ОсновныеСредства Цикл
		
		ПараметрыОтбора = Новый Структура("ОсновноеСредство", СтрокаДокумента.ОсновноеСредство);
		НайденныеПараметрыАмортизации = ПараметрыАмортизации.НайтиСтроки(ПараметрыОтбора);
		Если НайденныеПараметрыАмортизации.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрыАмортизацииОбъекта = НайденныеПараметрыАмортизации[0];
		ПолеОсновноеСредство = "ОсновныеСредства[" + Формат(СтрокаДокумента.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].ОсновноеСредство";
		
		// Бухгалтерский учет.
		Если СтрокаДокумента.СуммаАмортизации <> 0 Тогда
			
			Если НЕ ЗначениеЗаполнено(ПараметрыАмортизацииОбъекта.ПорядокПогашенияСтоимости) Тогда
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru='Объект ""%1"" в строке %2 не принят к бухгалтерскому учету. Начисление амортизации невозможно.
						|
						|Проверьте документ принятия к учету и параметры начисления амортизации по объекту.'"),
						СтрокаДокумента.ОсновноеСредство,
						СтрокаДокумента.НомерСтроки);
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки,
					ДокументОбъект, ПолеОсновноеСредство, "Объект", Отказ);
				Продолжить;
			КонецЕсли;
			
			Если НЕ (ПараметрыАмортизацииОбъекта.ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации
					И (ПараметрыАмортизацииОбъекта.СпособНачисленияАмортизации = Перечисления.СпособНачисленияАмортизации.Линейный
						Или ПараметрыАмортизацииОбъекта.СпособНачисленияАмортизации = Перечисления.СпособНачисленияАмортизации.УменьшаемогоОстатка
						Или ПараметрыАмортизацииОбъекта.СпособНачисленияАмортизации = Перечисления.СпособНачисленияАмортизации.ПропорциональноОбъемуПродукции))
			ИЛИ НЕ ПараметрыАмортизацииОбъекта.НачислятьАмортизацию Тогда
				
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru='По объекту ""%1"" в строке %2 начисление амортизации в бухгалтерском учете не производится.
						|
						|Проверьте параметры начисления амортизации по объекту.'"),
						СтрокаДокумента.ОсновноеСредство,
						СтрокаДокумента.НомерСтроки);
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки,
					ДокументОбъект, ПолеОсновноеСредство, "Объект", Отказ);
				
			Иначе
				
				// Проверяем счет затрат по амортизации.
				Если НЕ ЗначениеЗаполнено(ПараметрыАмортизацииОбъекта.СчетУчетаЗатрат) Тогда
					
					ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'Для объекта ""%1"" в строке %2 не указан счет учета затрат по амортизации.
							|
							|Проверьте параметры начисления амортизации по объекту.'"),
							СтрокаДокумента.ОсновноеСредство,
							СтрокаДокумента.НомерСтроки);
					ОбщегоНазначения.СообщитьПользователю(ТекстОшибки,
						ДокументОбъект, ПолеОсновноеСредство, "Объект", Отказ);
					
				Иначе // Проверяем аналитику затрат по амортизации.
					
					СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ПараметрыАмортизацииОбъекта.СчетУчетаЗатрат);
					Для НомерСубконто = 1 По СвойстваСчета.КоличествоСубконто Цикл
						Если СвойстваСчета["ВидСубконто" + НомерСубконто + "Обязательный"]
						   И НЕ ЗначениеЗаполнено(ПараметрыАмортизацииОбъекта["Субконто"+НомерСубконто+"Затрат"])
						Тогда
							ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
								НСтр("ru = 'Для объекта ""%1"" в строке %2 не указана аналитика учета затрат по амортизации.
									|
									|Проверьте параметры начисления амортизации по объекту.'"),
									СтрокаДокумента.ОсновноеСредство,
									СтрокаДокумента.НомерСтроки);
							ОбщегоНазначения.СообщитьПользователю(ТекстОшибки,
								ДокументОбъект, ПолеОсновноеСредство, "Объект", Отказ);
							Прервать;
						КонецЕсли;
					КонецЦикла;
					
					Если НалоговыйУчетКлиентСервер.ЭтоПрочиеРасходы(ПараметрыАмортизацииОбъекта.СчетУчетаЗатрат)
					 И НЕ ЗначениеЗаполнено(ПараметрыАмортизацииОбъекта.СубконтоНУЗатрат)
					 И НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(ДокументОбъект.Организация, ДокументОбъект.Дата, СтрокаДокумента.КФО)
					 И (СтрокаДокумента.СуммаАмортизацииНУ <> 0
					ИЛИ СтрокаДокумента.СуммаАмортизацииНеУчитываетсяНУ <> 0
					ИЛИ СтрокаДокумента.СуммаАмортизацииЕНВД <> 0) Тогда
						ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
							НСтр("ru = 'Для объекта ""%1"" в строке %2 не указана статья прочих расходов (НУ).
								|
								|Проверьте параметры начисления амортизации по объекту.'"),
								СтрокаДокумента.ОсновноеСредство,
								СтрокаДокумента.НомерСтроки);
						ОбщегоНазначения.СообщитьПользователю(ТекстОшибки,
							ДокументОбъект, ПолеОсновноеСредство, "Объект", Отказ);
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		// Налоговый учет.
		ОтражатьВНалоговомУчете = НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(
			ДокументОбъект.Организация, ДокументОбъект.Дата, СтрокаДокумента.КФО);
		Если ОтражатьВНалоговомУчете Тогда
		
			Если СтрокаДокумента.СуммаАмортизацииНУ <> 0
			 ИЛИ СтрокаДокумента.СуммаАмортизацииНеУчитываетсяНУ <> 0
			 ИЛИ СтрокаДокумента.СуммаАмортизацииЕНВД <> 0 Тогда
				
				Если НЕ ЗначениеЗаполнено(ПараметрыАмортизацииОбъекта.ПорядокВключенияСтоимостиВСоставРасходовНУ) Тогда
					ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru='Объект ""%1"" в строке %2 не принят к налоговому учету. Начисление амортизации невозможно.
							|
							|Проверьте документ принятия к учету и параметры начисления амортизации по объекту.'"),
							СтрокаДокумента.ОсновноеСредство,
							СтрокаДокумента.НомерСтроки);
					ОбщегоНазначения.СообщитьПользователю(ТекстОшибки,
						ДокументОбъект, ПолеОсновноеСредство, "Объект", Отказ);
					Продолжить;
				КонецЕсли;
				
				Если ПараметрыАмортизацииОбъекта.ПорядокВключенияСтоимостиВСоставРасходовНУ <>
						Перечисления.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации
				ИЛИ НЕ ПараметрыАмортизацииОбъекта.НачислятьАмортизациюНУ Тогда
				
					ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru='По объекту ""%1"" в строке %2 начисление амортизации в налоговом учете не производится.
							|
							|Проверьте параметры начисления амортизации по объекту.'"),
							СтрокаДокумента.ОсновноеСредство,
							СтрокаДокумента.НомерСтроки);
					ОбщегоНазначения.СообщитьПользователю(ТекстОшибки,
						ДокументОбъект, ПолеОсновноеСредство, "Объект", Отказ);
					
				КонецЕсли;
				
			КонецЕсли;
			
			// Амортизационная премия.
			Если СтрокаДокумента.СуммаКапитальныхВложенийВключаемыхВРасходыНУ <> 0 Тогда
			
				// Проверяем документ амортизационной премии.
				Если НЕ ЗначениеЗаполнено(ПараметрыАмортизацииОбъекта.ДокументАмортизационнойПремии) Тогда
					
					ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru='По объекту ""%1"" в строке %2 амортизационная премия в состав расходов не включается.
							|
							|Проверьте параметры амортизационной премии в документе принятия к учету.'"),
							СтрокаДокумента.ОсновноеСредство,
							СтрокаДокумента.НомерСтроки);
					ОбщегоНазначения.СообщитьПользователю(ТекстОшибки,
						ДокументОбъект, ПолеОсновноеСредство, "Объект", Отказ);
					
				Иначе
					
					// Проверяем счет расходов по амортизационной премии.
					Если НЕ ЗначениеЗаполнено(ПараметрыАмортизацииОбъекта.СчетРасходовПоАмортизационнойПремии) Тогда
						
						ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
							НСтр("ru = 'В документе ""%1"" не заполнен счет учета расходов по амортизационной премии для объекта ""%2"".
								|
								|Заполните счет учета расходов по амортизационной премии в документе.'"),
								ПараметрыАмортизацииОбъекта.ДокументАмортизационнойПремии,
								СтрокаДокумента.ОсновноеСредство);
						ОбщегоНазначения.СообщитьПользователю(ТекстОшибки,
							ПараметрыАмортизацииОбъекта.ДокументАмортизационнойПремии,,, Отказ);
						
					Иначе // Проверяем аналитику амортизационной премии.
						
						СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(
							ПараметрыАмортизацииОбъекта.СчетРасходовПоАмортизационнойПремии);
						Для НомерСубконто = 1 По СвойстваСчета.КоличествоСубконто Цикл
							Если СвойстваСчета["ВидСубконто" + НомерСубконто + "Обязательный"]
							   И НЕ ЗначениеЗаполнено(ПараметрыАмортизацииОбъекта["Субконто"+НомерСубконто+"РасходовПоАмортизационнойПремии"])
							Тогда
								ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
									НСтр("ru = 'В документе ""%1"" не заполнена аналитика учета расходов по амортизационной премии для объекта ""%2"".
										|
										|Заполните аналитику учета расходов по амортизационной премии в документе.'"),
										ПараметрыАмортизацииОбъекта.ДокументАмортизационнойПремии,
										СтрокаДокумента.ОсновноеСредство);
								ОбщегоНазначения.СообщитьПользователю(ТекстОшибки,
									ПараметрыАмортизацииОбъекта.ДокументАмортизационнойПремии, , , Отказ);
								Прервать;
							КонецЕсли;
						КонецЦикла;
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область Прочее

Процедура УсловноеОФормлениеОСвСписке(УсловноеОформление, ИмяПоляОС, ИмяПоляИнв = "") Экспорт
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(Элемент.Поля, ИмяПоляОС);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(Элемент.Отбор,
		"Список.СписокОС", ВидСравненияКомпоновкиДанных.Равно, Истина);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", "<Список ОС>");
	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(,,,Истина));
	
	Если ИмяПоляИнв = "" Тогда
		Возврат;
	КонецЕсли;
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(Элемент.Поля, ИмяПоляИнв);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(Элемент.Отбор,
		"Список.СписокИнвНомеров", ВидСравненияКомпоновкиДанных.Равно, Истина);	
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", "<Список номеров>");
	Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(,,,Истина));
	
КонецПроцедуры

Процедура ПроверитьОчиститьКПСвТаблицеДокумента(Таблица, ВидСчета = "СчетУчета", НаДату = '00010101') Экспорт
	
	Если ВидСчета <> "" Тогда
		ТаблицаСчетов = ПолучитьСчетаУчетаОСпоТаблицеДокумента(Таблица, ВидСчета, НаДату);
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.КПС) Тогда
			
			Если ВидСчета = "" Тогда
				СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаТаблицы.СчетУчета);
				УчетПоКПС = СвойстваСчета.УчетПоКПС;
			Иначе
				СтрокаСчета = ТаблицаСчетов.Найти(СтрокаТаблицы.ОсновноеСредство, "ОсновноеСредство");
				Если СтрокаСчета = Неопределено Тогда
					УчетПоКПС = Ложь;
				Иначе
					УчетПоКПС = СтрокаСчета.УчетПоКПС;
				КонецЕсли;
			КонецЕсли;
			
			Если Не УчетПоКПС Тогда
				СтрокаТаблицы.КПС = Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка();
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла; 
	
КонецПроцедуры

Процедура ПроверитьЗаполнениеКПСвТЧ(Объект, ИмяТаблицы, ПредставлениеТаблицы, ВидСчета = "СчетУчета", Отказ) Экспорт

	ТекстСообщения = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(
		НСтр("ru = 'Не заполнена колонка ""КПС"" в строке %1 списка ""[ПредставлениеТаблицы]""'"),
		Новый Структура("ПредставлениеТаблицы", ПредставлениеТаблицы));
	
		Если ВидСчета <> "" Тогда
			ТаблицаСчетов = ПолучитьСчетаУчетаОСпоТаблицеДокумента(Объект[ИмяТаблицы], ВидСчета, Объект.Дата);
		КонецЕсли;

	Для Каждого СтрокаТаблицы Из Объект[ИмяТаблицы] Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.КПС) Тогда
			
			Если ВидСчета = "" Тогда
				СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаТаблицы.СчетУчета);
				УчетПоКПС = СвойстваСчета.УчетПоКПС;
			Иначе
				СтрокаСчета = ТаблицаСчетов.Найти(СтрокаТаблицы.ОсновноеСредство, "ОсновноеСредство");
				Если СтрокаСчета = Неопределено Тогда
					УчетПоКПС = Ложь;
				Иначе
					УчетПоКПС = СтрокаСчета.УчетПоКПС;
				КонецЕсли;
			КонецЕсли;
		
			Если УчетПоКПС = Истина Тогда
				
				ОбщегоНазначения.СообщитьПользователю(
					СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, СтрокаТаблицы.НомерСтроки),,
					"Объект." + ИмяТаблицы + "[" + (СтрокаТаблицы.НомерСтроки - 1) + "].КПС",, Отказ);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла; 
	
КонецПроцедуры

Процедура УстановитьУсловноеОформлениеПоляТаблицыКПС(Форма) Экспорт

	УсловноеОформление = Форма.УсловноеОформление.Элементы;
	ЦветТекста = Метаданные.ЭлементыСтиля.НедоступныеДанныеЦвет.Значение;
	
	Элемент = УсловноеОформление.Добавить();
	Элемент.Использование = Истина;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Элемент.Отбор, "Объект.ОсновныеСредства.УчетПоКПС", Ложь, ВидСравненияКомпоновкиДанных.Равно);
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста",			ЦветТекста);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст",					"<не используется>");
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр",		Истина);
	Элемент.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного",	Ложь);
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных("ОсновныеСредстваКПС");
	Поле.Использование = Истина;

КонецПроцедуры

Функция НоваяТаблицаОСИнвНомер(ОсновноеСредство = Неопределено, ИнвентарныйНомер = Неопределено) Экспорт

	ТаблицаЗначений = Новый ТаблицаЗначений;
	ТаблицаЗначений.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(5, 0, ДопустимыйЗнак.Неотрицательный)));
	ТаблицаЗначений.Колонки.Добавить("ОсновноеСредство", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ТаблицаЗначений.Колонки.Добавить("ИнвентарныйНомер", Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	
	Если ОсновноеСредство <> Неопределено Тогда
		НоваяСтрока = ТаблицаЗначений.Добавить();
		НоваяСтрока.НомерСтроки = 0;
		НоваяСтрока.ОсновноеСредство = ОсновноеСредство;
		НоваяСтрока.ИнвентарныйНомер = ИнвентарныйНомер;
	КонецЕсли;
	
	Возврат ТаблицаЗначений;

КонецФункции // НоваяТаблицаОСИнвНомер()

// Инициализирует структуру параметров для получения остатков.
//
// Ключ Ссылка заполняется ссылкой документа, в котором расчитываются остатки.
// Ключи ТаблицаОС, ОсновноеСредство, ИнвентарныйНомер используются для передачи ОС и инв. номера.
//	Если ОС много, то используется ТаблицаОС. Если ОС один, то ТаблицаОС не заполняется, а используются ОсновноеСредство И ИнвентарныйНомер.
//	ОсновноеСредство И ИнвентарныйНомер используются при расчете остатков только если ТаблицаОС.Количество() = 0
//
Функция ПустаяСтруктураПараметровПолученияОстатков() Экспорт
	
	ПустаяСтруктура = Новый Структура;
	ПустаяСтруктура.Вставить("Ссылка", 								Неопределено);
	ПустаяСтруктура.Вставить("Период", 								'00010101');
	ПустаяСтруктура.Вставить("Организация", 						Справочники.Организации.ПустаяСсылка());
	ПустаяСтруктура.Вставить("КПС", 								Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка());
	ПустаяСтруктура.Вставить("КФО", 								Перечисления.КВД.ПустаяСсылка());
	ПустаяСтруктура.Вставить("ЦМО", 								Справочники.ЦМО.ПустаяСсылка());
	ПустаяСтруктура.Вставить("ИспользоватьУчетПоИФО", 				ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	ПустаяСтруктура.Вставить("ИспользоватьУчетПоПодразделениям",	ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	ПустаяСтруктура.Вставить("ИФО", 								Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
	ПустаяСтруктура.Вставить("Подразделение", 						Справочники.Подразделения.ПустаяСсылка());
	ПустаяСтруктура.Вставить("ОсновноеСредство",					Справочники.ОсновныеСредства.ПустаяСсылка());
	ПустаяСтруктура.Вставить("ИнвентарныйНомер",					Справочники.ИнвентарныеНомераОС.ПустаяСсылка());
	ПустаяСтруктура.Вставить("ТаблицаОС", 							ПустаяТаблицаОСДляРасчетаОстатков());
	
	//////////////////////////////
	ПустаяСтруктура.Вставить("ИспользуемыйСчет",							"СчетУчета"); //"ЗабалансовыйСчет"
	ПустаяСтруктура.Вставить("ПолучатьАмортизацию",							ЛОЖЬ);
	ПустаяСтруктура.Вставить("УстанавливатьИнвентарныйНомер",				ЛОЖЬ);
	ПустаяСтруктура.Вставить("УстанавливатьКПС",							ЛОЖЬ);
	ПустаяСтруктура.Вставить("УстанавливатьКФО",							Неопределено);
	ПустаяСтруктура.Вставить("Контрагент",									Справочники.Контрагенты.ПустаяСсылка());
	ПустаяСтруктура.Вставить("ЕстьСубконтоКонтрагенты",						Ложь);
	ПустаяСтруктура.Вставить("ПолучатьАмортизациюБезБалансовойСтоимости",	Ложь); // позволяет получить амортизацию даже если нет остатков бал. стоимости
	ПустаяСтруктура.Вставить("ПолучатьОбесценение",							ЛОЖЬ);
	
	Возврат ПустаяСтруктура;
	
КонецФункции

// Возвращает пустую таблицу для получения остатков ОС, НМА, НПА и ИК. 
//
// Возвращаемое значение
//	 - ТаблицаЗначений с колонками:
//		-ОсновноеСредство - СправочникСсылка.ОсновныеСредства
//		-ИнвентарныйНомер - СправочникСсылка.ИнвентарныеНомераОС - если 
//			ПараметрыПолученияОстатков.УстанавливатьИнвентарныйНомер = ИСТИНА, то в колонке содержится инвентарный 
//			номер из остатков, если ПараметрыПолученияОстатков.УстанавливатьИнвентарныйНомер = ЛОЖЬ,
//			то в колонке содержится исходный инвентарный номер, для которого производился расчет
//		-Состояние - ПеречислениеСсылка.СостоянияОС - текущее состояние объекта ОС, 
//			заполняется только если ИнвентарныйНомер заполнен из остатаков или по нужному инв. номеру есть остатки
//		-КоличествоВсего - Число - количество принятых к учету объектов ОС 
//		-КоличествоВЭксплуатации - Число - количество введенных в эксплуатацию объектов ОС
//		-БалансоваяСтоимость - Число(18,2) - балансовая стоимость объектов ОС по всем ЦМО
//		-КоличествоОстаток - Число - количество объектов ОС по всем ЦМО
//		-БалансоваяСтоимостьМОЛ - Число(18,2) - балансовая стоимость объектов ОС по указанному ЦМО
//		-КоличествоОстатокМОЛ - Число - количество объектов ОС по указанному ЦМО
//		-СуммаАмортизации - Число(18,2) - сумма амортизации по всем объектам ОС. НЕ ЗАПОЛНЯЕТСЯ если 
//			ПараметрыПолученияОстатков.ПолучатьАмортизацию <> ИСТИНА
//		-СуммаОбесценения - Число(18,2) - сумма обесценения по всем объектам ОС. НЕ ЗАПОЛНЯЕТСЯ если 
//			ПараметрыПолученияОстатков.ПолучатьОбесценение <> ИСТИНА
//		-Амортизация - Число(18,2) - сумма амортизации текущего объекта ОС. Если амортизация линейная, 
//			то совпадает с СуммаАмортизации. Для 100%-й амортизации будет заполнена если объект введен в эксплуатацию.
//			НЕ ЗАПОЛНЯЕТСЯ если ПараметрыПолученияОстатков.ПолучатьАмортизацию <> ИСТИНА.
//		-СтоимостьЕдиницы - Число(18,2) - округленная стоимость текущего объекта ОС.
//		-СтоимостьЕдиницыНеокругленная - Число - неокругленная стоимость текущего объекта ОС, для списания копеек.
//		-ОсновноеСредствоНаименование - Строка(80) - наименование объекта ОС
//		-ОсновноеСредствоКод - Строка(18) - код объекта ОС
//		-ИнвентарныйНомерКод - Строка(30) - код инв. номера, без пробелов справа
//		-КоличествоВДокументе - Число
//		-ТребуетсяПроверка - Булево - может использоваться при последующей обработке таблицы
//		-КПСТаблицы - СправочникСсылка.КлассификационныеПризнакиСчетов - исходный КПС (если был заполнен)
//		-КПСОстатков - СправочникСсылка.КлассификационныеПризнакиСчетов - рассчитанный КПС остатков
//		-КФОТаблицы - ПеречислениеСсылка.КВД - исходный КФО (если был заполнен)
//		-КФООстатков - ПеречислениеСсылка.КВД - рассчитанный КФО остатков
//		-Счет - ПланСчетовСсылка.ЕПСБУ - рассчитанный счет остатков
//		-Договор - СправочникСсылка.Договоры - рассчитанный договор остатков
Функция ПустаяТаблицаОстатковОС() Экспорт
	ОписаниеТиповЧисло = Новый ОписаниеТипов("Число"); 
	ОписаниеТиповЧисло_18_2 = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТиповСтрока_18 = Новый ОписаниеТипов("Строка", 
		Новый КвалификаторыСтроки(Метаданные.Справочники.ОсновныеСредства.ДлинаКода, ДопустимаяДлина.Переменная));
	ОписаниеТиповСтрока_80 = Новый ОписаниеТипов("Строка", 
		Новый КвалификаторыСтроки(Метаданные.Справочники.ОсновныеСредства.ДлинаНаименования, ДопустимаяДлина.Переменная));
	ОписаниеТиповСтрока_30 = Новый ОписаниеТипов("Строка", 
		Новый КвалификаторыСтроки(Метаданные.Справочники.ИнвентарныеНомераОС.ДлинаКода, ДопустимаяДлина.Переменная));
		
	ТаблицаОстатков = Новый ТаблицаЗначений;
	ТаблицаОстатков.Колонки.Добавить("ОсновноеСредство", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ТаблицаОстатков.Колонки.Добавить("ИнвентарныйНомер", Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	ТаблицаОстатков.Колонки.Добавить("ЭтоБиблиотечныйФонд", Новый ОписаниеТипов("Булево"));
	ТаблицаОстатков.Колонки.Добавить("Состояние", Новый ОписаниеТипов("ПеречислениеСсылка.СостоянияОС"));
	ТаблицаОстатков.Колонки.Добавить("КоличествоВсего", ОписаниеТиповЧисло);
	ТаблицаОстатков.Колонки.Добавить("КоличествоВЭксплуатации", ОписаниеТиповЧисло);
	ТаблицаОстатков.Колонки.Добавить("БалансоваяСтоимость", ОписаниеТиповЧисло_18_2);
	ТаблицаОстатков.Колонки.Добавить("КоличествоОстаток", ОписаниеТиповЧисло);
	ТаблицаОстатков.Колонки.Добавить("БалансоваяСтоимостьМОЛ", ОписаниеТиповЧисло_18_2);
	ТаблицаОстатков.Колонки.Добавить("КоличествоОстатокМОЛ", ОписаниеТиповЧисло);
	ТаблицаОстатков.Колонки.Добавить("СуммаАмортизации", ОписаниеТиповЧисло_18_2);
	ТаблицаОстатков.Колонки.Добавить("Амортизация", ОписаниеТиповЧисло_18_2);
	ТаблицаОстатков.Колонки.Добавить("СтоимостьЕдиницы", ОписаниеТиповЧисло_18_2);
	ТаблицаОстатков.Колонки.Добавить("СтоимостьЕдиницыНеокругленная", ОписаниеТиповЧисло);
	ТаблицаОстатков.Колонки.Добавить("ОсновноеСредствоНаименование", ОписаниеТиповСтрока_80);
	ТаблицаОстатков.Колонки.Добавить("ОсновноеСредствоКод", ОписаниеТиповСтрока_18);
	ТаблицаОстатков.Колонки.Добавить("ИнвентарныйНомерКод", ОписаниеТиповСтрока_30);
	ТаблицаОстатков.Колонки.Добавить("КоличествоВДокументе", ОписаниеТиповЧисло);
	ТаблицаОстатков.Колонки.Добавить("ТребуетсяПроверка", Новый ОписаниеТипов("Булево"));
	ТаблицаОстатков.Колонки.Добавить("КПСТаблицы", Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаОстатков.Колонки.Добавить("КПСОстатков", Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаОстатков.Колонки.Добавить("КФОТаблицы", Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ТаблицаОстатков.Колонки.Добавить("КФООстатков", Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ТаблицаОстатков.Колонки.Добавить("Счет", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаОстатков.Колонки.Добавить("Договор", Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ТаблицаОстатков.Колонки.Добавить("СуммаОбесценения", ОписаниеТиповЧисло_18_2);
	
	Возврат ТаблицаОстатков;
КонецФункции	

// Возвращает таблицу остатков капвложений.
//
// Параметры:
//  ПараметрыПолученияОстатков - Структура - Для получения пустой структуры используется функция 
// 						 УправлениеОсновнымиСредствами.ПустаяСтруктураПараметровПолученияОстатков()
//
// Возвращаемое значение:
//	 ТаблицаЗначений - содержащая остатки. Состав колонок см. ПустаяТаблицаОстатковОС()
//
Функция ПолучитьОстаткиКапВложений(ПараметрыПолученияОстатков) Экспорт
	
	Если ПараметрыПолученияОстатков.ТаблицаОС.Количество() > 0 Тогда
		ТаблицаОС = ПараметрыПолученияОстатков.ТаблицаОС;
	Иначе
		ТаблицаОС = ПустаяТаблицаОСДляРасчетаОстатков();
		НоваяСтрока = ТаблицаОС.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ПараметрыПолученияОстатков, "ОсновноеСредство");
		НоваяСтрока.Количество = 1;
	КонецЕсли;
	
	МассивОС = ТаблицаОС.ВыгрузитьКолонку("ОсновноеСредство");
	
	Запрос = Новый Запрос;
	Если Не ЗначениеЗаполнено(ПараметрыПолученияОстатков.Ссылка) Тогда
		ПериодОстатков = Новый Граница(ПараметрыПолученияОстатков.Период, ВидГраницы.Включая);
	Иначе
		ПериодОстатков = Новый Граница(ПараметрыПолученияОстатков.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;
	Запрос.УстановитьПараметр("Период"					, ПериодОстатков);
	Запрос.УстановитьПараметр("Организация"				, ПараметрыПолученияОстатков.Организация);
	Запрос.УстановитьПараметр("КПС"						, ПараметрыПолученияОстатков.КПС);
	Запрос.УстановитьПараметр("ПоВсемКПС"				, Не ЗначениеЗаполнено(ПараметрыПолученияОстатков.КПС));
	Запрос.УстановитьПараметр("КФО"						, ПараметрыПолученияОстатков.КФО);
	Запрос.УстановитьПараметр("МассивОС"				, МассивОС);
	Запрос.УстановитьПараметр("ИФО"						, ПараметрыПолученияОстатков.ИФО);
	Запрос.УстановитьПараметр("ИспользоватьУчетПоИФО"	, ПараметрыПолученияОстатков.ИспользоватьУчетПоИФО);
	Запрос.УстановитьПараметр("Счет106"					, БухгалтерскийУчет.СписокСчетов("106.00"));
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОстатки.Субконто1 ССЫЛКА Справочник.ОсновныеСредства
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства)
	|		КОГДА ЖурналПроводокЕПСБУОстатки.Субконто2 ССЫЛКА Справочник.ОсновныеСредства
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.ОсновныеСредства)
	|		КОГДА ЖурналПроводокЕПСБУОстатки.Субконто3 ССЫЛКА Справочник.ОсновныеСредства
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Справочник.ОсновныеСредства)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)
	|	КОНЕЦ КАК ОсновноеСредство,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОстатки.Субконто1 ССЫЛКА Справочник.ЦМО
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ЦМО)
	|		КОГДА ЖурналПроводокЕПСБУОстатки.Субконто2 ССЫЛКА Справочник.ЦМО
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.ЦМО)
	|		КОГДА ЖурналПроводокЕПСБУОстатки.Субконто3 ССЫЛКА Справочник.ЦМО
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Справочник.ЦМО)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка)
	|	КОНЕЦ КАК ЦМО,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОстатки.Субконто1 ССЫЛКА Справочник.Договоры
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Договоры)
	|		КОГДА ЖурналПроводокЕПСБУОстатки.Субконто2 ССЫЛКА Справочник.Договоры
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.Договоры)
	|		КОГДА ЖурналПроводокЕПСБУОстатки.Субконто3 ССЫЛКА Справочник.Договоры
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Справочник.Договоры)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	|	КОНЕЦ КАК Договор,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУОстатки.Организация КАК Организация,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстаток КАК БалансоваяСтоимость,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстаток КАК КоличествоОстаток,
	|	ОсновныеСредства.Наименование КАК ОсновноеСредствоНаименование,
	|	ОсновныеСредства.Код КАК ОсновноеСредствоКод
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В (&Счет106),
	|			,
	|			Организация = &Организация
	|				И КФО = &КФО
	|				И (&ПоВсемКПС
	|					ИЛИ КПС = &КПС)
	|				И (НЕ &ИспользоватьУчетПоИФО
	|					ИЛИ ИФО = &ИФО)
	|				И Субконто1 В (&МассивОС)) КАК ЖурналПроводокЕПСБУОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОсновныеСредства КАК ОсновныеСредства
	|		ПО ЖурналПроводокЕПСБУОстатки.Субконто1 = ОсновныеСредства.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка) КАК ОсновноеСредство,
	|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвентарныйНомер,
	|	ЛОЖЬ КАК ЭтоБиблиотечныйФонд,
	|	NULL КАК Состояние,
	|	0 КАК КоличествоВсего,
	|	0 КАК КоличествоВЭксплуатации,
	|	0 КАК БалансоваяСтоимость,
	|	0 КАК КоличествоОстаток,
	|	0 КАК БалансоваяСтоимостьМОЛ,
	|	0 КАК КоличествоОстатокМОЛ,
	|	0 КАК СуммаАмортизации,
	|	0 КАК СуммаОбесценения,
	|	0 КАК Амортизация,
	|	0 КАК СтоимостьЕдиницы,
	|	0 КАК СтоимостьЕдиницыНеокругленная,
	|	ВЫРАЗИТЬ("""" КАК СТРОКА(80)) КАК ОсновноеСредствоНаименование,
	|	ВЫРАЗИТЬ("""" КАК СТРОКА(18)) КАК ОсновноеСредствоКод,
	|	ВЫРАЗИТЬ("""" КАК СТРОКА(30)) КАК ИнвентарныйНомерКод,
	|	0 КАК КоличествоВДокументе,
	|	ЛОЖЬ КАК ТребуетсяПроверка,
	|	ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка) КАК КПСТаблицы,
	|	ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка) КАК КПСОстатков,
	|	ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка) КАК КФООстатков,
	|	ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка) КАК Счет,
	|	ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка) КАК ЦМО,
	|	ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка) КАК Договор
	|ГДЕ
	|	ЛОЖЬ";
	
	Результат = Запрос.ВыполнитьПакет();
	
	ОстаткиБаланс = Результат[0].Выгрузить();
	ТаблицаОстатков = Результат[1].Выгрузить();
	
	Для Каждого ТекСтрокаОС Из ТаблицаОС Цикл
		
		СтрокаБалансоваяСтоимость = Неопределено;
		
		ОтборБаланс = Новый Структура("ОсновноеСредство", ТекСтрокаОС.ОсновноеСредство);
		Если НЕ ПараметрыПолученияОстатков.УстанавливатьКПС И ЗначениеЗаполнено(ТекСтрокаОС.КПС) Тогда
			ОтборБаланс.Вставить("КПС", ТекСтрокаОС.КПС);
		КонецЕсли;
		
		СтрокиБаланс = ОстаткиБаланс.НайтиСтроки(ОтборБаланс);
		Если СтрокиБаланс.Количество() > 0 Тогда
			
			СтрокаБалансоваяСтоимость = СтрокиБаланс[0];
			
			Если СтрокаБалансоваяСтоимость.БалансоваяСтоимость = 0 Тогда
				Продолжить;
			КонецЕсли;
		Иначе
			
			Продолжить;
			
		КонецЕсли;
		
		СтрокаОстатков = ТаблицаОстатков.Добавить();
		СтрокаОстатков.ОсновноеСредство = ТекСтрокаОС.ОсновноеСредство;
		СтрокаОстатков.ИнвентарныйНомер = Справочники.ИнвентарныеНомераОС.ПустаяСсылка();
		СтрокаОстатков.КПСТаблицы		= ТекСтрокаОС.КПС;
		СтрокаОстатков.КПСОстатков		= СтрокаБалансоваяСтоимость.КПС;
		СтрокаОстатков.Счет				= СтрокаБалансоваяСтоимость.Счет;
		
		СтрокаОстатков.КоличествоВсего = СтрокаБалансоваяСтоимость.КоличествоОстаток;
		СтрокаОстатков.КоличествоВЭксплуатации = СтрокаБалансоваяСтоимость.КоличествоОстаток;
		СтрокаОстатков.БалансоваяСтоимость = СтрокаБалансоваяСтоимость.БалансоваяСтоимость;
		СтрокаОстатков.КоличествоОстаток = СтрокаБалансоваяСтоимость.КоличествоОстаток;
		СтрокаОстатков.БалансоваяСтоимостьМОЛ = СтрокаБалансоваяСтоимость.БалансоваяСтоимость;
		СтрокаОстатков.КоличествоОстатокМОЛ = СтрокаБалансоваяСтоимость.КоличествоОстаток;
		СтрокаОстатков.СтоимостьЕдиницыНеокругленная = ?(СтрокаОстатков.КоличествоОстатокМОЛ = 0, 0, СтрокаОстатков.БалансоваяСтоимостьМОЛ / СтрокаОстатков.КоличествоОстатокМОЛ);
		СтрокаОстатков.СтоимостьЕдиницы = Окр(СтрокаОстатков.СтоимостьЕдиницыНеокругленная, 2);
		СтрокаОстатков.ОсновноеСредствоНаименование = СтрокаБалансоваяСтоимость.ОсновноеСредствоНаименование;
		СтрокаОстатков.ОсновноеСредствоКод = СтрокаБалансоваяСтоимость.ОсновноеСредствоКод;
		СтрокаОстатков.ИнвентарныйНомерКод = "";
		СтрокаОстатков.КоличествоВДокументе = ТекСтрокаОС.Количество;
		СтрокаОстатков.СуммаАмортизации = 0;
		СтрокаОстатков.Амортизация = 0;
		СтрокаОстатков.ЭтоБиблиотечныйФонд = Ложь;
		СтрокаОстатков.ЦМО = СтрокаБалансоваяСтоимость.ЦМО;
		СтрокаОстатков.Договор = СтрокаБалансоваяСтоимость.Договор;
		
	КонецЦикла;
	
	Возврат ТаблицаОстатков;
	
КонецФункции

// Возвращает таблицу остатков ОС, НМА, НПА и ИК. Для дальнейшего заполнения из полученной таблицы используется
// процедура УправлениеОсновнымиСредствами.ЗаполнитьОбъектИзТаблицыОстатков()
//
// Параметры:
//  ПараметрыПолученияОстатков - Структура - Для получения пустой структуры используется функция УправлениеОсновнымиСредствами.ПустаяСтруктураПараметровПолученияОстатков()
//
// Возвращаемое значение:
//	 ТаблицаЗначений - содержащая остатки. Состав колонок см. ПустаяТаблицаОстатковОС()
//
// Пример:
//	ПараметрыПолученияОстатков = УправлениеОсновнымиСредствами.СтруктураПараметровПолученияОстатков(Объект, Объект.ДатаСписанияСБухУчета);
//	ПараметрыПолученияОстатков.ПолучатьАмортизацию				= Истина;
//	ПараметрыПолученияОстатков.УстанавливатьИнвентарныйНомер	= Истина;
//	ПараметрыПолученияОстатков.УстанавливатьКПС					= Истина;
//	ТаблицаОстатков = УправлениеОсновнымиСредствами.ПолучитьОстатки(ПараметрыПолученияОстатков); 
//	
//	ПараметрыЗаполнения = Новый Структура;
//	ПараметрыЗаполнения.Вставить("ОсновноеСредство",				"ОсновноеСредство");
//	ПараметрыЗаполнения.Вставить("ИнвентарныйНомер",				"ИнвентарныйНомер");
//	ПараметрыЗаполнения.Вставить("Сумма",							"Сумма");
//	ПараметрыЗаполнения.Вставить("КПС",								"КПС");
//	ПараметрыЗаполнения.Вставить("СуммаАмортизации",				"СуммаАмортизации");
//	ПараметрыЗаполнения.Вставить("ИсходноеКоличество",				1);
//	ПараметрыЗаполнения.Вставить("УстанавливатьИнвентарныйНомер",	Истина);
//	ПараметрыЗаполнения.Вставить("УстанавливатьКПС",				Истина);
//		
//	УправлениеОсновнымиСредствами.ЗаполнитьОбъектИзТаблицыОстатков(ТаблицаОстатков, Объект, ПараметрыЗаполнения);
//
Функция ПолучитьОстатки(ПараметрыПолученияОстатков) Экспорт
	
	// результирующая таблица
	ТаблицаОстатков = ПустаяТаблицаОстатковОС();
	
	Если ПараметрыПолученияОстатков.ТаблицаОС.Количество() > 0 Тогда
		ТаблицаОС = ПараметрыПолученияОстатков.ТаблицаОС;
	Иначе
		ТаблицаОС = ПустаяТаблицаОСДляРасчетаОстатков();
		НоваяСтрока = ТаблицаОС.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ПараметрыПолученияОстатков, "ОсновноеСредство, ИнвентарныйНомер");
		НоваяСтрока.Количество = 1;
		Если НЕ ПараметрыПолученияОстатков.УстанавливатьКПС Тогда
			НоваяСтрока.КПС = ПараметрыПолученияОстатков.КПС;
		КонецЕсли;
		Если ПараметрыПолученияОстатков.УстанавливатьКФО = Ложь Тогда
			НоваяСтрока.КФО = ПараметрыПолученияОстатков.КФО;
		КонецЕсли;
	КонецЕсли;
	
	УчетПоКПСБаланс = Истина;
	УчетПоЦМОБаланс = Истина;
//	УчетПоДоговорамБаланс = Истина;
	
	СубконтоОС = Новый Массив;
	СубконтоОС.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	// заполнение периода запроса:
	Если НЕ ЗначениеЗаполнено(ПараметрыПолученияОстатков.Ссылка) Тогда
		// если документ не записан, то используется период и вид границы "включая"
		ПериодОстатков = Новый Граница(ПараметрыПолученияОстатков.Период, ВидГраницы.Включая);
	Иначе
		// если документ записан
		// если дата без времени в "период" отличается от даты без времени в "Ссылка.Дата", то используется период
		// это бывает если поле "Период" содержит дату списания с бух учета, отличную от даты документа
		Если НачалоДня(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыПолученияОстатков.Ссылка, "Дата")) <> НачалоДня(ПараметрыПолученияОстатков.Период) Тогда
			ПериодОстатков = Новый Граница(ПараметрыПолученияОстатков.Период, ВидГраницы.Исключая);
		Иначе
			ПериодОстатков = Новый Граница(ПараметрыПолученияОстатков.Ссылка.МоментВремени(), ВидГраницы.Исключая);
		КонецЕсли;
	КонецЕсли;
	Запрос.УстановитьПараметр("Период",			ПериодОстатков);
	Запрос.УстановитьПараметр("Организация",	ПараметрыПолученияОстатков.Организация);
	Запрос.УстановитьПараметр("КПС", 			ПараметрыПолученияОстатков.КПС);
	Запрос.УстановитьПараметр("КФО", 			ПараметрыПолученияОстатков.КФО);
	Запрос.УстановитьПараметр("ПоВсемКФО", 		НЕ ЗначениеЗаполнено(ПараметрыПолученияОстатков.КФО));
	Запрос.УстановитьПараметр("ЦМО",			ПараметрыПолученияОстатков.ЦМО);
	Запрос.УстановитьПараметр("СубконтоОС",		СубконтоОС);
	Запрос.УстановитьПараметр("ТаблицаОС",      ТаблицаОС);
	Запрос.УстановитьПараметр("ИФО",            ПараметрыПолученияОстатков.ИФО);
	Запрос.УстановитьПараметр("ИспользоватьУчетПоИФО",            ПараметрыПолученияОстатков.ИспользоватьУчетПоИФО);
	Запрос.УстановитьПараметр("Подразделение",                    ПараметрыПолученияОстатков.Подразделение);
	Запрос.УстановитьПараметр("ИспользоватьУчетПоПодразделениям", ПараметрыПолученияОстатков.ИспользоватьУчетПоПодразделениям);
	Запрос.УстановитьПараметр("СчетаУчетаДляИсключения",          БухгалтерскийУчет.СписокСчетов("106.00, 107.00"));
	Запрос.УстановитьПараметр("Счет22",                           БухгалтерскийУчет.СписокСчетов("22"));
	
	НачальныйИндексДанныхВЗапросе = 0;

	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ТаблицаОС.ОсновноеСредство КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство
	|ПОМЕСТИТЬ ТаблицаОС
	|ИЗ
	|	&ТаблицаОС КАК ТаблицаОС
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТаблицаОС.ОсновноеСредство КАК ОсновноеСредство
	|ПОМЕСТИТЬ ТаблицаИК
	|ИЗ
	|	ТаблицаОС КАК ТаблицаОС
	|ГДЕ
	|	ТаблицаОС.ОсновноеСредство.ИмуществоКазны
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УчетныеДанныеОбъектаОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	УчетныеДанныеОбъектаОССрезПоследних.СчетУчета КАК СчетУчета
	|ПОМЕСТИТЬ УчетныеДанныеОбъектаОССрезПоследних
	|ИЗ
	|	РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						ТаблицаОС.ОсновноеСредство
	|					ИЗ
	|						ТаблицаОС КАК ТаблицаОС)
	|				И НЕ СчетУчета.Забалансовый
	|				И НЕ СчетУчета В (&СчетаУчетаДляИсключения)) КАК УчетныеДанныеОбъектаОССрезПоследних
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство";

	НачальныйИндексДанныхВЗапросе = НачальныйИндексДанныхВЗапросе + 3;

	Если ПараметрыПолученияОстатков.ИспользуемыйСчет = "СчетУчета" Тогда
		Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() + "   
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаОС.ОсновноеСредство КАК ОС,
		|	МАКСИМУМ(ЕСТЬNULL(УчетныеДанныеОбъектаОССрезПоследних.СчетУчета, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка))) КАК СчетУчета
		|ПОМЕСТИТЬ ОсновныеСредстваИСчета
		|ИЗ
		|	ТаблицаОС КАК ТаблицаОС
		|		ЛЕВОЕ СОЕДИНЕНИЕ УчетныеДанныеОбъектаОССрезПоследних КАК УчетныеДанныеОбъектаОССрезПоследних
		|		ПО ТаблицаОС.ОсновноеСредство = УчетныеДанныеОбъектаОССрезПоследних.ОсновноеСредство
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаОС.ОсновноеСредство
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ОС";
		
		НачальныйИндексДанныхВЗапросе = НачальныйИндексДанныхВЗапросе + 1;
		
		Если ПараметрыПолученияОстатков.ПолучатьАмортизацию ИЛИ ПараметрыПолученияОстатков.ПолучатьОбесценение Тогда
			Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() + "   
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ОсновныеСредстваИСчета.СчетУчета КАК СчетУчета,
			|	ЕСТЬNULL(СоответствиеСчетовОС.СчетАмортизации, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) КАК СчетАмортизации,
			|	ЕСТЬNULL(СоответствиеСчетовОС.СчетОбесценения, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) КАК СчетОбесценения,
			|	ЕСТЬNULL(ОсновныеСредстваИСчета.СчетУчета.УчетПоПодразделениям, ЛОЖЬ) КАК УчетПоПодразделениямБаланс,
			|	ЕСТЬNULL(ОсновныеСредстваИСчета.СчетУчета.УчетПоКПС, ЛОЖЬ) КАК УчетПоКПСБаланс,
			|	НЕ ЕПСБУВидыСубконто.Ссылка ЕСТЬ NULL КАК УчетПоЦМОБаланс,
			|	НЕ ЕПСБУВидыСубконтоДоговор.Ссылка ЕСТЬ NULL КАК УчетПоДоговорамБаланс,
			|	ЕСТЬNULL(СоответствиеСчетовОС.СчетАмортизации.УчетПоПодразделениям, ЛОЖЬ) КАК УчетПоПодразделениямАморт,
			|	ЕСТЬNULL(СоответствиеСчетовОС.СчетОбесценения.УчетПоПодразделениям, ЛОЖЬ) КАК УчетПоПодразделениямОбесц
			|ПОМЕСТИТЬ ТаблицаСчетов
			|ИЗ
			|	ТаблицаОС КАК ТаблицаОС
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОсновныеСредстваИСчета КАК ОсновныеСредстваИСчета
			|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеСчетовОС КАК СоответствиеСчетовОС
			|			ПО ОсновныеСредстваИСчета.СчетУчета = СоответствиеСчетовОС.СчетОС
			|			ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
			|			ПО (ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦМО))
			|				И ОсновныеСредстваИСчета.СчетУчета = ЕПСБУВидыСубконто.Ссылка
			|			ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконтоДоговор
			|			ПО (ЕПСБУВидыСубконтоДоговор.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Договоры))
			|				И ОсновныеСредстваИСчета.СчетУчета = ЕПСБУВидыСубконтоДоговор.Ссылка
			|		ПО ТаблицаОС.ОсновноеСредство = ОсновныеСредстваИСчета.ОС
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	СчетУчета,
			|	СчетАмортизации";
			
			НачальныйИндексДанныхВЗапросе = НачальныйИндексДанныхВЗапросе + 1;
		Иначе
			Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() + " 
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ОсновныеСредстваИСчета.СчетУчета КАК СчетУчета,
			|	NULL КАК СчетАмортизации,
			|	NULL КАК СчетОбесценения,
			|	ЕСТЬNULL(ОсновныеСредстваИСчета.СчетУчета.УчетПоПодразделениям, ЛОЖЬ) КАК УчетПоПодразделениямБаланс,
			|	ЕСТЬNULL(ОсновныеСредстваИСчета.СчетУчета.УчетПоКПС, ЛОЖЬ) КАК УчетПоКПСБаланс,
			|	НЕ ЕПСБУВидыСубконто.Ссылка ЕСТЬ NULL КАК УчетПоЦМОБаланс,
			|	НЕ ЕПСБУВидыСубконтоДоговор.Ссылка ЕСТЬ NULL КАК УчетПоДоговорамБаланс,
			|	ЛОЖЬ КАК УчетПоПодразделениямАморт,
			|	ЛОЖЬ КАК УчетПоПодразделениямОбесц
			|ПОМЕСТИТЬ ТаблицаСчетов
			|ИЗ
			|	ТаблицаОС КАК ТаблицаОС
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОсновныеСредстваИСчета КАК ОсновныеСредстваИСчета
			|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеСчетовОС КАК СоответствиеСчетовОС
			|			ПО ОсновныеСредстваИСчета.СчетУчета = СоответствиеСчетовОС.СчетОС
			|			ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
			|			ПО (ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦМО))
			|				И ОсновныеСредстваИСчета.СчетУчета = ЕПСБУВидыСубконто.Ссылка
			|			ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконтоДоговор
			|			ПО (ЕПСБУВидыСубконтоДоговор.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Договоры))
			|				И ОсновныеСредстваИСчета.СчетУчета = ЕПСБУВидыСубконтоДоговор.Ссылка
			|		ПО ТаблицаОС.ОсновноеСредство = ОсновныеСредстваИСчета.ОС
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	СчетУчета";
		
			НачальныйИндексДанныхВЗапросе = НачальныйИндексДанныхВЗапросе + 1;
		КонецЕсли;
	ИначеЕсли ПараметрыПолученияОстатков.ИспользуемыйСчет = "ПолученныеПоЦС" Тогда
		Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() + "
		|ВЫБРАТЬ
		|	ЕПСБУ.Ссылка КАК СчетУчета,
		|	ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка) КАК СчетАмортизации,
		|	ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка) КАК СчетОбесценения,
		|	ЕПСБУ.УчетПоКПС КАК УчетПоКПСБаланс,
		|	ЕПСБУ.УчетПоПодразделениям КАК УчетПоПодразделениямБаланс,
		|	ИСТИНА КАК УчетПоЦМОБаланс,
		|	ЛОЖЬ КАК УчетПоДоговорамБаланс,
		|	ЛОЖЬ КАК УчетПоПодразделениямАморт,
		|	ЛОЖЬ КАК УчетПоПодразделениямОбесц
		|ПОМЕСТИТЬ ТаблицаСчетов
		|ИЗ
		|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|ГДЕ
		|	ЕПСБУ.Ссылка В(&Счет22)
		|	И ИСТИНА В
		|			(ВЫБРАТЬ ПЕРВЫЕ 1
		|				ИСТИНА КАК Поле1
		|			ИЗ
		|				ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
		|			ГДЕ
		|				ЕПСБУВидыСубконто.Ссылка = ЕПСБУ.Ссылка
		|				И ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства))";
	
		НачальныйИндексДанныхВЗапросе = НачальныйИндексДанныхВЗапросе + 1;
	Иначе
		Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() + "	
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ОсновныеСредства.Ссылка КАК ОС,
			|	УчетныеДанныеОбъектаОССрезПоследних.СчетУчета
			|ПОМЕСТИТЬ ОсновныеСредстваИСчета
			|ИЗ
			|	Справочник.ОсновныеСредства КАК ОсновныеСредства
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних(
			|				&Период,
			|				Организация = &Организация
			|					И ОсновноеСредство В
			|						(ВЫБРАТЬ
			|							ТаблицаОС.ОсновноеСредство
			|						ИЗ
			|							ТаблицаОС КАК ТаблицаОС)) КАК УчетныеДанныеОбъектаОССрезПоследних
			|		ПО (УчетныеДанныеОбъектаОССрезПоследних.ОсновноеСредство = ОсновныеСредства.Ссылка)
			|ГДЕ
			|	ОсновныеСредства.Ссылка В
			|			(ВЫБРАТЬ
			|				Таб.ОсновноеСредство
			|			ИЗ
			|				ТаблицаОС КАК Таб)
			|;
			|
			|/////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
			|	ЕСТЬNULL(СоответствиеСчетовОС." + ПараметрыПолученияОстатков.ИспользуемыйСчет + ", ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) КАК СчетУчета,
			|	ЕСТЬNULL(СоответствиеСчетовОС.СчетАмортизации, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) КАК СчетАмортизации,
			|	ЕСТЬNULL(СоответствиеСчетовОС.СчетОбесценения, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) КАК СчетОбесценения,
			|	ЕСТЬNULL(СоответствиеСчетовОС." + ПараметрыПолученияОстатков.ИспользуемыйСчет + ".УчетПоПодразделениям, ЛОЖЬ) КАК УчетПоПодразделениямБаланс,
			|	ЕСТЬNULL(СоответствиеСчетовОС." + ПараметрыПолученияОстатков.ИспользуемыйСчет + ".УчетПоКПС, ЛОЖЬ) КАК УчетПоКПСБаланс,
			|	ЛОЖЬ КАК УчетПоДоговорамБаланс,
			|	НЕ ЕПСБУВидыСубконто.Ссылка ЕСТЬ NULL КАК УчетПоЦМОБаланс,
			|	ЕСТЬNULL(СоответствиеСчетовОС.СчетАмортизации.УчетПоПодразделениям, ЛОЖЬ) КАК УчетПоПодразделениямАморт,
			|	ЕСТЬNULL(СоответствиеСчетовОС.СчетОбесценения.УчетПоПодразделениям, ЛОЖЬ) КАК УчетПоПодразделениямОбесц
			|ПОМЕСТИТЬ ТаблицаСчетов
			|ИЗ
			|	ТаблицаОС КАК ТаблицаОС
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОсновныеСредстваИСчета КАК ОсновныеСредстваИСчета
			|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеСчетовОС КАК СоответствиеСчетовОС
			|			ПО ОсновныеСредстваИСчета.СчетУчета = СоответствиеСчетовОС.СчетОС
			|			ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
			|			ПО (СоответствиеСчетовОС." + ПараметрыПолученияОстатков.ИспользуемыйСчет + " = ЕПСБУВидыСубконто.Ссылка)
			|				И (ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦМО))
			|		ПО ТаблицаОС.ОсновноеСредство = ОсновныеСредстваИСчета.ОС
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	СчетУчета,
			|	СчетАмортизации";
	
		НачальныйИндексДанныхВЗапросе = НачальныйИндексДанныхВЗапросе + 2;
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() + 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|	Выбор
	|		когда ЖурналПроводокЕПСБУОстатки.Субконто1 ССЫЛКА Справочник.ОсновныеСредства
	|			тогда ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства)
	|		когда ЖурналПроводокЕПСБУОстатки.Субконто2 ССЫЛКА Справочник.ОсновныеСредства
	|			тогда ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.ОсновныеСредства)
	|		когда ЖурналПроводокЕПСБУОстатки.Субконто3 ССЫЛКА Справочник.ОсновныеСредства
	|			тогда ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Справочник.ОсновныеСредства)
	|		иначе Значение(Справочник.ОсновныеСредства.ПустаяСсылка)
	|	конец КАК ОсновноеСредство,
	|	Выбор
	|		когда ЖурналПроводокЕПСБУОстатки.Субконто1 ССЫЛКА Справочник.ЦМО
	|			тогда ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ЦМО)
	|		когда ЖурналПроводокЕПСБУОстатки.Субконто2 ССЫЛКА Справочник.ЦМО
	|			тогда ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.ЦМО)
	|		когда ЖурналПроводокЕПСБУОстатки.Субконто3 ССЫЛКА Справочник.ЦМО
	|			тогда ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Справочник.ЦМО)
	|		иначе Значение(Справочник.ЦМО.ПустаяСсылка)
	|	конец КАК ЦМО,
	|	Выбор
	|		когда ЖурналПроводокЕПСБУОстатки.Субконто1 ССЫЛКА Справочник.Договоры
	|			тогда ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Договоры)
	|		когда ЖурналПроводокЕПСБУОстатки.Субконто2 ССЫЛКА Справочник.Договоры
	|			тогда ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.Договоры)
	|		когда ЖурналПроводокЕПСБУОстатки.Субконто3 ССЫЛКА Справочник.Договоры
	|			тогда ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Справочник.Договоры)
	|		иначе Значение(Справочник.Договоры.ПустаяСсылка)
	|	конец КАК Договор,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям
	|		И ТаблицаСчетов.УчетПоПодразделениямБаланс
