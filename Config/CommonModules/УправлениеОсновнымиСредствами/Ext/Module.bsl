	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	// Счета и аналитика учета основных средств.
	ПустаяТаблица.Колонки.Добавить("ОсновноеСредство",  Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ПустаяТаблица.Колонки.Добавить("ИнвентарныйНомер",  Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	ПустаяТаблица.Колонки.Добавить("ЦМО",               Новый ОписаниеТипов("СправочникСсылка.ЦМО"));
	ПустаяТаблица.Колонки.Добавить("СчетУчетаОС",       Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("КЭК",               Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ПустаяТаблица.Колонки.Добавить("СчетАмортизацииОС", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("КЭКАмортизации",    Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	// Дополнительные реквизиты.
	ПустаяТаблица.Колонки.Добавить("ПорядокПогашенияСтоимости",
		Новый ОписаниеТипов("ПеречислениеСсылка.ПорядокПогашенияСтоимостиОС")); // БУ
	ПустаяТаблица.Колонки.Добавить("ПорядокВключенияСтоимостиВСоставРасходовНУ",
		Новый ОписаниеТипов("ПеречислениеСсылка.ПорядокВключенияСтоимостиОСВСоставРасходовНУ")); // НУ
	ПустаяТаблица.Колонки.Добавить("ПорядокВключенияСтоимостиВСоставРасходовУСН",
		Новый ОписаниеТипов("ПеречислениеСсылка.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН")); // УСН
	ПустаяТаблица.Колонки.Добавить("СостояниеОС",             Новый ОписаниеТипов("ПеречислениеСсылка.СостоянияОС"));
	ПустаяТаблица.Колонки.Добавить("ДатаПринятияКУчету",      Новый ОписаниеТипов("Дата"));
	ПустаяТаблица.Колонки.Добавить("ДатаВводаВЭксплуатацию",  Новый ОписаниеТипов("Дата"));
	// Бухгалтерский учет.
	ПустаяТаблица.Колонки.Добавить("Количество",              ОписаниеТипаКоличества);
	ПустаяТаблица.Колонки.Добавить("Сумма",                   ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаАмортизации",        ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("ПервоначальнаяСтоимость", ОписаниеТипаСуммы);
	// Налоговый учет по налогу на прибыль.
	ПустаяТаблица.Колонки.Добавить("СуммаНУ",                         ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаНеУчитываетсяНУ",            ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаЕНВД",                       ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаАмортизацииНУ",              ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаАмортизацииНеУчитываетсяНУ", ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаАмортизацииЕНВД",            ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("ПервоначальнаяСтоимостьНУ",       ОписаниеТипаСуммы);
	
	Возврат ПустаяТаблица;

КонецФункции

// Формирует таблицу источника данных "Ввод остатков основных средств".
//
Функция ТаблицаВводОстатковОсновныхСредств(Документ, Реквизиты, Отказ) Экспорт
	
	ТаблицаВводОстатков = ПустаяТаблицаВводОстатковОсновныхСредств();
	Если Не ЗначениеЗаполнено(Документ) Тогда
		Возврат ТаблицаВводОстатков;
	КонецЕсли;
	
	МетаданныеДокумента = Документ.Метаданные();
	
	СчетУчета = ?(МетаданныеДокумента.Имя = "ВводНачальныхОстатковОС", Документ["СчетУчета"], Документ["Счет"]);
	КЭКСчетаУчета = КЭКСчетаПриВводеОстатков(Документ.Организация,
		Документ.ИФО, Документ.КФО, Документ.Дата, СчетУчета, "Дт");
	
	СчетАмортизации = УправлениеОсновнымиСредствамиПовтИсп.СчетАмортизацииОС(СчетУчета);
	КЭКАмортизации = КЭКСчетаПриВводеОстатков(Документ.Организация,
		Документ.ИФО, Документ.КФО, Документ.Дата, СчетАмортизации, "Кт");
	
	
	Запрос = Новый Запрос;
	
	Если МетаданныеДокумента.Имя = "ВводНачальныхОстатков" Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДетальноПоИнвНомерам.Ссылка,
		|	""ОС_Основная"" КАК ИмяСписка,
		|	""Основные средства"" КАК СинонимСписка,
		|	ДетальноПоИнвНомерам.НомерСтроки КАК НомерСтроки,
		|	ДетальноПоИнвНомерам.Ссылка.ИФО КАК ИФО,
		|	ДетальноПоИнвНомерам.Ссылка.КФО КАК КФО,
		|	ДетальноПоИнвНомерам.Ссылка.КПС КАК КПС,
		|	ДетальноПоИнвНомерам.Подразделение КАК Подразделение,
		|	ДетальноПоИнвНомерам.ОС КАК ОсновноеСредство,
		|	ДетальноПоИнвНомерам.ИнвНомерОС КАК ИнвентарныйНомер,
		|	ДетальноПоИнвНомерам.ЦМО КАК ЦМО,
		|	ДетальноПоИнвНомерам.Ссылка.Счет КАК СчетУчетаОС,
		|	ДетальноПоИнвНомерам.Ссылка.КЭК КАК КЭК,
		|	ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка) КАК СчетАмортизацииОС,
		|	ДетальноПоИнвНомерам.СостояниеОС КАК СостояниеОС,
		|	СводноПоОбъектам.ДатаПринятияКУчету КАК ДатаПринятияКУчету,
		|	ДетальноПоИнвНомерам.ДатаВводаВЭксплуатацию КАК ДатаВводаВЭксплуатацию,
		|	СводноПоОбъектам.ПорядокПогашенияСтоимости КАК ПорядокПогашенияСтоимости,
		|	СводноПоОбъектам.ПорядокВключенияСтоимостиВСоставРасходовНУ КАК ПорядокВключенияСтоимостиВСоставРасходовНУ,
		|	СводноПоОбъектам.ПорядокВключенияСтоимостиВСоставРасходовУСН КАК ПорядокВключенияСтоимостиВСоставРасходовУСН,
		|	ДетальноПоИнвНомерам.Количество КАК Количество,
		|	ДетальноПоИнвНомерам.Сумма КАК Сумма,
		|	ДетальноПоИнвНомерам.СуммаАмортизации КАК СуммаАмортизации,
		|	ДетальноПоИнвНомерам.ПервоначальнаяСтоимость КАК ПервоначальнаяСтоимость,
		|	СводноПоОбъектам.СуммаНУ КАК СуммаНУ,
		|	СводноПоОбъектам.СуммаНеУчитываетсяНУ КАК СуммаНеУчитываетсяНУ,
		|	СводноПоОбъектам.СуммаЕНВД КАК СуммаЕНВД,
		|	СводноПоОбъектам.СуммаАмортизацииНУ КАК СуммаАмортизацииНУ,
		|	СводноПоОбъектам.СуммаАмортизацииНеУчитываетсяНУ КАК СуммаАмортизацииНеУчитываетсяНУ,
		|	СводноПоОбъектам.СуммаАмортизацииЕНВД КАК СуммаАмортизацииЕНВД,
		|	СводноПоОбъектам.ПервоначальнаяСтоимостьНУ КАК ПервоначальнаяСтоимостьНУ
		|ИЗ
		|	Документ.ВводНачальныхОстатков.ОС_Основная КАК ДетальноПоИнвНомерам
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводНачальныхОстатков.ОС_Амортизация КАК СводноПоОбъектам
		|		ПО (ДетальноПоИнвНомерам.Ссылка = &Ссылка)
		|			И (СводноПоОбъектам.Ссылка = &Ссылка)
		|			И ДетальноПоИнвНомерам.ОС = СводноПоОбъектам.ОС
		|ГДЕ
		|	ДетальноПоИнвНомерам.Ссылка = &Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДетальноПоИнвНомерам.НомерСтроки";
		
	ИначеЕсли МетаданныеДокумента.Имя = "ВводНачальныхОстатковОС" Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СтоимостьИАмортизация.Ссылка,
		|	СтоимостьИАмортизация.ПорядокПогашенияСтоимости
		|ПОМЕСТИТЬ ПараметрыАмортизации
		|ИЗ
		|	Документ.ВводНачальныхОстатковОС.СтоимостьИАмортизация КАК СтоимостьИАмортизация
		|ГДЕ
		|	СтоимостьИАмортизация.Ссылка = &Ссылка
		|	И СтоимостьИАмортизация.Период <= &ДатаВводаОстатков
		|
		|УПОРЯДОЧИТЬ ПО
		|	СтоимостьИАмортизация.Период УБЫВ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДетальноПоИнвНомерам.Ссылка,
		|	""ИнвентарныеОбъекты"" КАК ИмяСписка,
		|	""Инвентарные объекты"" КАК СинонимСписка,
		|	ДетальноПоИнвНомерам.НомерСтроки КАК НомерСтроки,
		|	СводноПоОбъектам.ИФО КАК ИФО,
		|	СводноПоОбъектам.КФО КАК КФО,
		|	СводноПоОбъектам.КПС КАК КПС,
		|	ДетальноПоИнвНомерам.Подразделение КАК Подразделение,
		|	СводноПоОбъектам.ОсновноеСредство КАК ОсновноеСредство,
		|	ДетальноПоИнвНомерам.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	ДетальноПоИнвНомерам.ЦМО КАК ЦМО,
		|	СводноПоОбъектам.СчетУчета КАК СчетУчетаОС,
		|	&КЭКСчетаУчета КАК КЭК,
		|	ВЫБОР
		|		КОГДА СводноПоОбъектам.УчетныеДанныеПодробно
		|			ТОГДА ДетальноПоИнвНомерам.СчетАмортизации
		|		ИНАЧЕ ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
		|	КОНЕЦ КАК СчетАмортизацииОС,
		|	ДетальноПоИнвНомерам.СостояниеОС КАК СостояниеОС,
		|	СводноПоОбъектам.ДатаПринятияКУчету КАК ДатаПринятияКУчету,
		|	ДетальноПоИнвНомерам.ДатаВводаВЭксплуатацию КАК ДатаВводаВЭксплуатацию,
		|	ПараметрыАмортизации.ПорядокПогашенияСтоимости КАК ПорядокПогашенияСтоимости,
		|	СводноПоОбъектам.ПорядокВключенияСтоимостиВСоставРасходовНУ КАК ПорядокВключенияСтоимостиВСоставРасходовНУ,
		|	СводноПоОбъектам.ПорядокВключенияСтоимостиВСоставРасходовУСН КАК ПорядокВключенияСтоимостиВСоставРасходовУСН,
		|	ДетальноПоИнвНомерам.Количество КАК Количество,
		|	ДетальноПоИнвНомерам.Стоимость КАК Сумма,
		|	ДетальноПоИнвНомерам.СуммаАмортизации КАК СуммаАмортизации,
		|	СводноПоОбъектам.ПервоначальнаяСтоимость КАК ПервоначальнаяСтоимость,
		|	ДетальноПоИнвНомерам.СуммаНУ,
		|	ДетальноПоИнвНомерам.СуммаНеУчитываетсяНУ,
		|	ДетальноПоИнвНомерам.СуммаЕНВД,
		|	ДетальноПоИнвНомерам.СуммаАмортизацииНУ,
		|	ДетальноПоИнвНомерам.СуммаАмортизацииНеУчитываетсяНУ,
		|	ДетальноПоИнвНомерам.СуммаАмортизацииЕНВД,
		|	СводноПоОбъектам.ПервоначальнаяСтоимостьНУ
		|ИЗ
		|	Документ.ВводНачальныхОстатковОС.ИнвентарныеОбъекты КАК ДетальноПоИнвНомерам
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводНачальныхОстатковОС КАК СводноПоОбъектам
		|		ПО (ДетальноПоИнвНомерам.Ссылка = &Ссылка)
		|			И (СводноПоОбъектам.Ссылка = &Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПараметрыАмортизации КАК ПараметрыАмортизации
		|		ПО ДетальноПоИнвНомерам.Ссылка = ПараметрыАмортизации.Ссылка
		|ГДЕ
		|	ДетальноПоИнвНомерам.Ссылка = &Ссылка
		|	И ДетальноПоИнвНомерам.СостояниеОС <> ЗНАЧЕНИЕ(Перечисление.СостоянияОС.СнятоСУчета)
		|	И НЕ ДетальноПоИнвНомерам.НаСчете21
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДетальноПоИнвНомерам.НомерСтроки";
		Запрос.УстановитьПараметр("КЭКСчетаУчета", КЭКСчетаУчета);
		Запрос.УстановитьПараметр("ПустаяДата", '00010101');
		Запрос.УстановитьПараметр("ДатаВводаОстатков", КонецДня(Документ.Дата));
		
	Иначе
		Возврат ТаблицаВводОстатков;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Ссылка", Документ);
	
	ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	Для Каждого СтрокаТаблицы Из ТаблицаРезультат Цикл
		
		НоваяСтрока = ТаблицаВводОстатков.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		
		Если ЗначениеЗаполнено(НоваяСтрока.СчетАмортизацииОС) Тогда
			НоваяСтрока.КЭКАмортизации = КЭКСчетаПриВводеОстатков(Документ.Организация,
				Документ.ИФО, Документ.КФО, Документ.Дата, НоваяСтрока.СчетАмортизацииОС, "Кт");
		Иначе
			НоваяСтрока.СчетАмортизацииОС = СчетАмортизации;
			НоваяСтрока.КЭКАмортизации    = КЭКАмортизации;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаВводОстатков;
	
КонецФункции

// Вложения во внеоборотные активы.

// Подготавливает таблицу документа (в унифицированном формате) для учета вложений во внеоборотные активы.
//
Функция ПодготовитьТаблицуВложенияВоВнеоборотныеАктивыПоДокументу(Документ, Параметры = Неопределено) Экспорт
	
	ОписаниеТипаСуммы        = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества   = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	
	ТаблицаДокумента = Новый ТаблицаЗначений;
	// Идентификация строки.
	ТаблицаДокумента.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ТаблицаДокумента.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ТаблицаДокумента.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	// Общие разрезы учета.
	ТаблицаДокумента.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ТаблицаДокумента.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ТаблицаДокумента.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаДокумента.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	// Счет и аналитика учета вложений в НФА.
	ТаблицаДокумента.Колонки.Добавить("СчетВложений",        Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаДокумента.Колонки.Добавить("ВнеоборотныйАктив",   Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ТаблицаДокумента.Колонки.Добавить("ВидЗатрат",           Новый ОписаниеТипов("СправочникСсылка.ВидыЗатрат"));
	ТаблицаДокумента.Колонки.Добавить("ПодразделениеЗатрат", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	// Поставщик (при поступлении вложений от сторонних контрагентов).
	ТаблицаДокумента.Колонки.Добавить("СчетРасчетов",      Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаДокумента.Колонки.Добавить("Контрагент",        Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ТаблицаДокумента.Колонки.Добавить("Договор",           Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ТаблицаДокумента.Колонки.Добавить("Валюта",            Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	ТаблицаДокумента.Колонки.Добавить("НДСКРаспределению", Новый ОписаниеТипов("Булево"));
	ТаблицаДокумента.Колонки.Добавить("ПринятьНДСКВычету", Новый ОписаниеТипов("Булево"));
	// Состав вложений.
	ТаблицаДокумента.Колонки.Добавить("Номенклатура",  Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаДокумента.Колонки.Добавить("Содержание",    Новый ОписаниеТипов("Строка"));
	// Количество и сумма поступивших единиц.
	ТаблицаДокумента.Колонки.Добавить("Количество",    ОписаниеТипаКоличества);
	ТаблицаДокумента.Колонки.Добавить("Сумма",         ОписаниеТипаСуммы); // Сумма с НДС в валюте документа.
	ТаблицаДокумента.Колонки.Добавить("СтавкаНДС",     Новый ОписаниеТипов("ПеречислениеСсылка.СтавкиНДС"));
	ТаблицаДокумента.Колонки.Добавить("СуммаНДС",      ОписаниеТипаСуммы); // Сумма НДС в валюте документа.
	// Контроль исполнения договоров.
	ТаблицаДокумента.Колонки.Добавить("ОтразитьВГрафикеИсполненияДоговора",
		Новый ОписаниеТипов("ПеречислениеСсылка.СтатусыДокументовКонтрольИсполненияДоговоров"));
	
	Если Параметры = Неопределено Тогда
		Параметры = Новый Структура;
	КонецЕсли;
	Если НЕ Параметры.Свойство("ОтразитьВГрафикеИсполненияДоговора") Тогда
		// Если в документе, таб.части и типовой операции нет реквизита ОтразитьВГрафикеИсполненияДоговора,
		// по умолчанию будем отражать в графике исполнения договора.
		Параметры.Вставить("ОтразитьВГрафикеИсполненияДоговора",
			Перечисления.СтатусыДокументовКонтрольИсполненияДоговоров.ОтразитьСейчас);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	МетаданныеДокумента = Документ.Метаданные();
	
	ЕстьТабЧастьУслугиИРаботы = ОбщегоНазначенияБГУ.ЕстьТабЧастьДокумента("УслугиИРаботы", МетаданныеДокумента);
	
	Если ЕстьТабЧастьУслугиИРаботы Тогда // Услуги сторонних организаций
		
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "УслугиИРаботы",
			"НомерСтроки,ИФО,КФО,КПС,Подразделение,ПодразделениеЗатрат,Контрагент,Договор,ВалютаДокумента,
			|СчетВложений,ВнеоборотныйАктив,ВидЗатрат,КЭК,НДСКРаспределению,ПринятьНДСКВычету,
			|Номенклатура,Содержание,Количество,Сумма,Всего,СтавкаНДС,СуммаНДС,
			|ОтразитьВГрафикеИсполненияДоговора",
			Документ, Параметры);
		
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	""УслугиИРаботы"" КАК ИмяСписка,
		|	""Услуги и работы"" КАК СинонимСписка,
		|	УслугиИРаботы.НомерСтроки КАК НомерСтроки,
		|	УслугиИРаботы.ИФО КАК ИФО,
		|	УслугиИРаботы.КФО КАК КФО,
		|	УслугиИРаботы.КПС КАК КПС,
		|	УслугиИРаботы.Подразделение КАК Подразделение,
		|	УслугиИРаботы.ПодразделениеЗатрат КАК ПодразделениеЗатрат,
		|	УслугиИРаботы.СчетВложений КАК СчетВложений,
		|	УслугиИРаботы.ВнеоборотныйАктив КАК ВнеоборотныйАктив,
		|	УслугиИРаботы.ВидЗатрат КАК ВидЗатрат,
		|	УслугиИРаботы.КЭК КАК КЭК,
		|	УслугиИРаботы.Контрагент КАК Контрагент,
		|	УслугиИРаботы.Договор КАК Договор,
		|	УслугиИРаботы.ОтразитьВГрафикеИсполненияДоговора КАК ОтразитьВГрафикеИсполненияДоговора,
		|	УслугиИРаботы.ВалютаДокумента КАК Валюта,
		|	УслугиИРаботы.Номенклатура КАК Номенклатура,
		|	УслугиИРаботы.Содержание КАК Содержание,
		|	УслугиИРаботы.НДСКРаспределению КАК НДСКРаспределению,
		|	УслугиИРаботы.ПринятьНДСКВычету КАК ПринятьНДСКВычету,
		|	УслугиИРаботы.Количество КАК Количество,
		|	УслугиИРаботы.Всего КАК Сумма,
		|	УслугиИРаботы.СтавкаНДС КАК СтавкаНДС,
		|	УслугиИРаботы.СуммаНДС КАК СуммаНДС
		|ИЗ
		|	ТаблицаУслугиИРаботы КАК УслугиИРаботы
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
		
		ИспользоватьВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
		ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
		
		// Счет расчетов.
		СчетРасчетов = УчетРасчетов.ОпределитьСчетРасчетовПоПараметрам(Параметры, "Поступление",
			Документ.Дата, Документ.Организация, Документ.ИФО);
		// При поступлении нужно анализировать переданный групповой счет, чтобы понимать
		// это от поставщика или подотчетника
		СчетРасчетовИзПараметров = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры,
			"СчетРасчетов",
			ПланыСчетов.ЕПСБУ.ПустаяСсылка());
		ЭтоСчет208 = ЗначениеЗаполнено(СчетРасчетовИзПараметров)
			И БухгалтерскийУчет.СчетВИерархии(СчетРасчетовИзПараметров, "208.00")
			И БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетРасчетовИзПараметров).ЭлементГруппа;
		
		ВложенияВоВнеоборотныеАктивы = Запрос.Выполнить().Выгрузить();
		Для Каждого Строка Из ВложенияВоВнеоборотныеАктивы Цикл
			
			НоваяСтрока = ТаблицаДокумента.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			
			Если Не ИспользоватьВалютныйУчет И Не ЗначениеЗаполнено(НоваяСтрока.Валюта) Тогда
				НоваяСтрока.Валюта = ВалютаРегламентированногоУчета;
			КонецЕсли;
			
			Если Не ЭтоСчет208 И ЗначениеЗаполнено(СчетРасчетов) Тогда
				НоваяСтрока.СчетРасчетов = СчетРасчетов;
			Иначе
				НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
					Строка.КЭК,
					?(ЭтоСчет208, "208.00", "302.00"),,
					Документ.Дата, Документ.Организация, Строка.ИФО);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ТаблицаДокумента;
	
КонецФункции

Функция БазаРаспределенияРасходовНаСоставПартии(Партия, БазаРаспределения) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПоступлениеОСКапВложения.ВнеоборотныйАктив,
	|	ПоступлениеОСКапВложения.КПС,
	|	ПоступлениеОСКапВложения.КФО,
	|	ПоступлениеОС.Подразделение,
	|	СУММА(&БазаРаспределения) КАК БазаРаспределения,
	|	ПоступлениеОС.ЦМО,
	|	ВЫБОР
	|		КОГДА ПоступлениеОСКапВложения.СчетУчета В (&Счета106)
	|			ТОГДА ПоступлениеОСКапВложения.СчетУчета
	|		ИНАЧЕ ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
	|	КОНЕЦ КАК СчетВложений
	|ИЗ
	|	Документ.ПоступлениеОС.КапВложения КАК ПоступлениеОСКапВложения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПоступлениеОС КАК ПоступлениеОС
	|		ПО ПоступлениеОСКапВложения.Ссылка = ПоступлениеОС.Ссылка
	|ГДЕ
	|	ПоступлениеОС.Проведен
	|	И ПоступлениеОС.Ссылка = &Ссылка
	|СГРУППИРОВАТЬ ПО
	|	ПоступлениеОСКапВложения.ВнеоборотныйАктив,
	|	ПоступлениеОСКапВложения.КПС,
	|	ПоступлениеОСКапВложения.КФО,
	|	ПоступлениеОС.Подразделение,
	|	ПоступлениеОС.ЦМО,
	|	ВЫБОР
	|		КОГДА ПоступлениеОСКапВложения.СчетУчета В (&Счета106)
	|			ТОГДА ПоступлениеОСКапВложения.СчетУчета
	|		ИНАЧЕ ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
	|	КОНЕЦ";
	Запрос.УстановитьПараметр("Ссылка", Партия);
	Запрос.УстановитьПараметр("Счета106", БухгалтерскийУчет.СписокСчетов("106.00"));
	
	Если БазаРаспределения = Перечисления.БазыРаспределенияДополнительныхРасходов.Стоимость Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&БазаРаспределения", "ПоступлениеОСКапВложения.Всего");
	ИначеЕсли БазаРаспределения = Перечисления.БазыРаспределенияДополнительныхРасходов.Количество
		Или БазаРаспределения = Перечисления.БазыРаспределенияДополнительныхРасходов.КоличествоМест Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&БазаРаспределения", "ПоступлениеОСКапВложения.Количество");
	Иначе
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Не известная база распределения ""%1""'"), БазаРаспределения);
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить(); 
	
КонецФункции

// Структура таблицы источника данных "Вложения по внеоборотные активы".
//
Функция ПустаяТаблицаВложенияВоВнеоборотныеАктивы() Экспорт

	ОписаниеТипаСуммы        = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества   = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	ОписаниеТиповВидСубконто = Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто");
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Идентификация строки.
	ПустаяТаблица.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	// Счет и аналитика учета вложений в НФА.
	ПустаяТаблица.Колонки.Добавить("СчетВложений",        Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("ВнеоборотныйАктив",   Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ПустаяТаблица.Колонки.Добавить("ВидЗатрат",           Новый ОписаниеТипов("СправочникСсылка.ВидыЗатрат"));
	ПустаяТаблица.Колонки.Добавить("ПодразделениеЗатрат", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	// Поставщик (при поступлении вложений от сторонних контрагентов).
	ПустаяТаблица.Колонки.Добавить("СчетРасчетов",      Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("Контрагент",        Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ПустаяТаблица.Колонки.Добавить("Договор",           Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ПустаяТаблица.Колонки.Добавить("Валюта",            Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	ПустаяТаблица.Колонки.Добавить("НДСКРаспределению", Новый ОписаниеТипов("Булево"));
	ПустаяТаблица.Колонки.Добавить("ПринятьНДСКВычету", Новый ОписаниеТипов("Булево"));
	// Состав вложений.
	ПустаяТаблица.Колонки.Добавить("Номенклатура",  Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ПустаяТаблица.Колонки.Добавить("Содержание",    Новый ОписаниеТипов("Строка"));
	// Количество и сумма поступивших единиц.
	ПустаяТаблица.Колонки.Добавить("Количество",    ОписаниеТипаКоличества);
	ПустаяТаблица.Колонки.Добавить("СтавкаНДС",     Новый ОписаниеТипов("ПеречислениеСсылка.СтавкиНДС"));
	ПустаяТаблица.Колонки.Добавить("СуммаНДСВал",   ОписаниеТипаСуммы); // Сумма НДС в валюте документа.
	ПустаяТаблица.Колонки.Добавить("СуммаНДСРуб",   ОписаниеТипаСуммы); // Сумма НДС в рублях.
	ПустаяТаблица.Колонки.Добавить("СуммаВал",      ОписаниеТипаСуммы); // Сумма с НДС в валюте документа.
	ПустаяТаблица.Колонки.Добавить("СуммаРуб",      ОписаниеТипаСуммы); // Сумма с НДС в рублях.
	// Контроль исполнения договоров.
	ПустаяТаблица.Колонки.Добавить("ОтразитьВГрафикеИсполненияДоговора",
		Новый ОписаниеТипов("ПеречислениеСсылка.СтатусыДокументовКонтрольИсполненияДоговоров"));
	
	Возврат ПустаяТаблица;

КонецФункции

// Формирует таблицу источника данных "Вложения по внеоборотные активы".
//
Функция ТаблицаВложенияВоВнеоборотныеАктивы(ТаблицаДокумента, ТаблицаРасчетовСЗачетомАвансов=Неопределено, Реквизиты, Отказ) Экспорт
	
	ТаблицаПоступление = ПустаяТаблицаВложенияВоВнеоборотныеАктивы();
	Если ТаблицаДокумента.Количество() = 0 Тогда
		Возврат ТаблицаПоступление;
	КонецЕсли;
	
	УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Реквизиты.Организация, Реквизиты.Дата);
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	
	УчетРасчетов.РассчитатьСуммыРуб(ТаблицаДокумента, ТаблицаРасчетовСЗачетомАвансов, Реквизиты);
	
	Для Каждого СтрокаДокумента Из ТаблицаДокумента Цикл
		
		СтрокаПоступление = ТаблицаПоступление.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПоступление, СтрокаДокумента);
		
		СтрокаПоступление.СуммаВал    = СтрокаДокумента.Сумма;
		СтрокаПоступление.СуммаНДСВал = СтрокаДокумента.СуммаНДС;
		
	КонецЦикла;
	
	Возврат ТаблицаПоступление;
	
КонецФункции

// Реализация основных средств.

// Подготавливает таблицу документа (в унифицированном формате) для учета реализации ОС, НМА, НПА.
//
Функция ПодготовитьТаблицуРеализацияОсновныхСредствПоДокументу(Документ, Параметры = Неопределено) Экспорт
	
	ТаблицаДокумента = ПустаяТаблицаРеализацияОсновныхСредствПоДокументу();
	
	Если Параметры = Неопределено Тогда
		Параметры = Новый Структура;
	КонецЕсли;
	Если НЕ Параметры.Свойство("КЭКДоходов") Тогда
		Параметры.Вставить("КЭКДоходов", Справочники.КОСГУ.ПустаяСсылка());
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	МетаданныеДокумента = Документ.Метаданные();
	
	ЕстьТабЧастьОсновныеСредства = ОбщегоНазначенияБГУ.ЕстьТабЧастьДокумента("ОсновныеСредства", МетаданныеДокумента);
	
	Если ЕстьТабЧастьОсновныеСредства Тогда
		
		Если МетаданныеДокумента.Имя = "ПередачаОбъектовИК" Тогда
			Параметры.Вставить("ВалютаДокумента", Константы.ВалютаРегламентированногоУчета.Получить());
		КонецЕсли;
		
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "ОсновныеСредства",
			"НомерСтроки,ИФО,КФО,КПС,Подразделение,КЭКДоходов,Контрагент,Договор,ВалютаДокумента,
			|ОсновноеСредство,ИнвентарныйНомер,Количество,Сумма,Всего,СтавкаНДС,СуммаНДС",
			Документ, Параметры);
		
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	""ОсновныеСредства"" КАК ИмяСписка,
		|	""Основные cредства"" КАК СинонимСписка,
		|	ОсновныеСредства.НомерСтроки КАК НомерСтроки,
		|	ОсновныеСредства.ИФО КАК ИФО,
		|	ОсновныеСредства.КФО КАК КФО,
		|	ОсновныеСредства.КПС КАК КПС,
		|	ОсновныеСредства.Подразделение КАК Подразделение,
		|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
		|	ОсновныеСредства.ОсновноеСредство.ВидНФА КАК ВидНФА,
		|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	ОсновныеСредства.Контрагент КАК Контрагент,
		|	ОсновныеСредства.Договор КАК Договор,
		|	ОсновныеСредства.ВалютаДокумента КАК Валюта,
		|	ОсновныеСредства.Количество КАК Количество,
		|	ОсновныеСредства.Всего КАК Сумма,
		|	ОсновныеСредства.СтавкаНДС КАК СтавкаНДС,
		|	ОсновныеСредства.СуммаНДС КАК СуммаНДС
		|ИЗ
		|	ТаблицаОсновныеСредства КАК ОсновныеСредства
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
		
	Иначе
		
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Документ",
			"ИФО,КФО,КПС,Подразделение,КЭКДоходов,Контрагент,Договор,ВалютаДокумента,
			|ОсновноеСредство,ИнвентарныйНомер,Количество,Сумма,Всего,СтавкаНДС,СуммаНДС",
			Документ, Параметры);
		
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	ОсновныеСредства.ИФО КАК ИФО,
		|	ОсновныеСредства.КФО КАК КФО,
		|	ОсновныеСредства.КПС КАК КПС,
		|	ОсновныеСредства.Подразделение КАК Подразделение,
		|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
		|	ОсновныеСредства.ОсновноеСредство.ВидНФА КАК ВидНФА,
		|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	ОсновныеСредства.КЭКДоходов КАК КЭКДоходов,
		|	ОсновныеСредства.Контрагент КАК Контрагент,
		|	ОсновныеСредства.Договор КАК Договор,
		|	ОсновныеСредства.ВалютаДокумента КАК Валюта,
		|	1 КАК Количество,
		|	ОсновныеСредства.Всего КАК Сумма,
		|	ОсновныеСредства.СтавкаНДС КАК СтавкаНДС,
		|	ОсновныеСредства.СуммаНДС КАК СуммаНДС
		|ИЗ
		|	Документ КАК ОсновныеСредства";
		
	КонецЕсли;
	
	РеализацияОсновныхСредств = Запрос.Выполнить().Выгрузить();
	
	ИспользоватьВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	// Счет расчетов.
	СчетРасчетов = УчетРасчетов.ОпределитьСчетРасчетовПоПараметрам(Параметры, "Реализация",
		Документ.Дата, Документ.Организация, Документ.ИФО);
	
	// В документах реализации в таб.части указан КПС расходов.
	// Для расчетов должен использоваться КПС доходов (если указан).
	ИспользоватьКПСРасчетов = Параметры.Свойство("КПС") И ЗначениеЗаполнено(Параметры.КПС);
	
	Для Каждого Строка Из РеализацияОсновныхСредств Цикл
		
		НоваяСтрока = ТаблицаДокумента.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
		Если Не ИспользоватьВалютныйУчет И Не ЗначениеЗаполнено(НоваяСтрока.Валюта) Тогда
			НоваяСтрока.Валюта = ВалютаРегламентированногоУчета;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СчетРасчетов) Тогда
			НоваяСтрока.СчетРасчетов = СчетРасчетов;
		ИначеЕсли Строка.ВидНФА = Перечисления.ВидыНФА.НПА Тогда
			НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.СчетПоКоду("205.73", Документ.Дата, Документ.Организация);
		ИначеЕсли Строка.ВидНФА = Перечисления.ВидыНФА.НМА Тогда
			НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.СчетПоКоду("205.72", Документ.Дата, Документ.Организация);
		Иначе
			НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.СчетПоКоду("205.71", Документ.Дата, Документ.Организация);
		КонецЕсли;
		
		Если ИспользоватьКПСРасчетов Тогда
			НоваяСтрока.КПС = Параметры.КПС;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.КЭКДоходов) Тогда
			НоваяСтрока.КЭКДоходов = БухгалтерскийУчетПовтИсп.АналитическийКЭКпоСчету(НоваяСтрока.СчетРасчетов);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаДокумента;
	
КонецФункции

// Структура таблицы источника данных "Реализация основных средств".
//
Функция ПустаяТаблицаРеализацияОсновныхСредств() Экспорт

	ОписаниеТипаСуммы      = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Идентификация строки.
	ПустаяТаблица.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	// Реализуемый объект ОС, НМА, НПА.
	ПустаяТаблица.Колонки.Добавить("ОсновноеСредство", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ПустаяТаблица.Колонки.Добавить("ИнвентарныйНомер", Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	// Покупатель.
	ПустаяТаблица.Колонки.Добавить("СчетРасчетов",  Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("КЭКДоходов",    Новый ОписаниеТипов("СправочникСсылка.КОСГУ")); // 172.
	ПустаяТаблица.Колонки.Добавить("Контрагент",    Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ПустаяТаблица.Колонки.Добавить("Договор",       Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ПустаяТаблица.Колонки.Добавить("Валюта",        Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	// Количественные и суммовые характеристики.
	ПустаяТаблица.Колонки.Добавить("Количество",    ОписаниеТипаКоличества);
	ПустаяТаблица.Колонки.Добавить("СтавкаНДС",     Новый ОписаниеТипов("ПеречислениеСсылка.СтавкиНДС"));
	ПустаяТаблица.Колонки.Добавить("СуммаВал",      ОписаниеТипаСуммы); // Сумма с НДС в валюте документа.
	ПустаяТаблица.Колонки.Добавить("СуммаНДСВал",   ОписаниеТипаСуммы); // Сумма НДС в валюте документа.
	ПустаяТаблица.Колонки.Добавить("СуммаРуб",      ОписаниеТипаСуммы); // Сумма с НДС в рублях.
	ПустаяТаблица.Колонки.Добавить("СуммаНДСРуб",   ОписаниеТипаСуммы); // Сумма НДС в рублях.
	
	Возврат ПустаяТаблица;

КонецФункции

// Формирует таблицу источника данных "Реализация основных средств".
//
Функция ТаблицаРеализацияОсновныхСредств(ТаблицаДокумента, ТаблицаРасчетовСЗачетомАвансов=Неопределено, Реквизиты, Отказ) Экспорт
	
	ТаблицаРеализация = ПустаяТаблицаРеализацияОсновныхСредств();
	Если ТаблицаДокумента.Количество() = 0 Тогда
		Возврат ТаблицаРеализация;
	КонецЕсли;
	
	УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Реквизиты.Организация, Реквизиты.Дата);
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	
	УчетРасчетов.РассчитатьСуммыРуб(ТаблицаДокумента, ТаблицаРасчетовСЗачетомАвансов, Реквизиты);
	
	Для Каждого СтрокаДокумента Из ТаблицаДокумента Цикл
		
		СтрокаСписание = ТаблицаРеализация.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаСписание, СтрокаДокумента);
		
		СтрокаСписание.СуммаВал    = СтрокаДокумента.Сумма;
		СтрокаСписание.СуммаНДСВал = СтрокаДокумента.СуммаНДС;
		
	КонецЦикла;
	
	Возврат ТаблицаРеализация;
	
КонецФункции

