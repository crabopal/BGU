Процедура ЗаполнитьФормуОтчета11К(ПараметрыОтчета, Контейнер, ТаблицаРасшифровки)
	
	// Исправление ошибки отчета. В новом отчете передается Неопределено
	Если ПараметрыОтчета.ИмуществоКазны = Неопределено Тогда
		ПараметрыОтчета.ИмуществоКазны = Ложь;
	КонецЕсли;
	
	ОСФонда = ОсновныеФонды11К(ПараметрыОтчета);
	
	// Таблица 1
	
	ДанныеТаблицы = ДанныеЗаполненияТаблицыФормы11К(ПараметрыОтчета, ОСФонда);
	
	ПоляОтчета = Контейнер["ПолеТабличногоДокументаФормаОтчета"];
	
	Для Каждого Показатель Из ДанныеТаблицы.Колонки Цикл
		
		ИмяПоля = Показатель.Имя;
		Если ИмяПоля = "ОсновноеСредство" Или ИмяПоля = "НаименованиеОС" Тогда
			Продолжить;
		КонецЕсли;
		
		НаименованиеПоказателя = ПолучитьНаименованиеПоказателя3(ИмяПоля);
		
		Для Каждого ОбщиеСуммы Из ДанныеТаблицы.Строки Цикл
			
			Если ПоляОтчета.Свойство(ИмяПоля) Тогда
				
				ПоляОтчета[ИмяПоля] = ОбщиеСуммы[ИмяПоля];
				
				Для Каждого ПоОС Из ОбщиеСуммы.Строки Цикл
					Значение = ПоОС[ИмяПоля]/1000;
					ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки,, ИмяПоля, НаименованиеПоказателя, ПоОС.НаименованиеОС, Значение);
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	// Таблица 2
	
	Таблица2 = Контейнер["ПолеТабличногоДокументаФормаОтчета_ДанныеДопСтрок1"];
	Таблица2.Очистить();
	
	Строка1Таблицы2 = Таблица2.Добавить();
	Строка1Таблицы2["П000102000102"] = "16";
	
	Строка2Таблицы2 = Таблица2.Добавить();
	Строка2Таблицы2["П000102000102"] = "17";
	
	ЗначенияРеквизитовОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПараметрыОтчета.Организация, "КодОКВЭД2,НаименованиеОКВЭД2");
	Если ЗначениеЗаполнено(ЗначенияРеквизитовОрганизации.НаименованиеОКВЭД2) Тогда
		Строка1Таблицы2["П000102000101"] = ЗначенияРеквизитовОрганизации.НаименованиеОКВЭД2;
		Строка1Таблицы2["П000102000103"] = ЧистыйКодПоОКВЭД(ЗначенияРеквизитовОрганизации.КодОКВЭД2);
	КонецЕсли;
	
	СтрокиДанных = СтрРазделить("0200,0400,0600,0700,0800,1000,1200,1300,1400", ",", Ложь);
	Для Каждого Поле Из ПоляОтчета Цикл
		ИмяПоляТаблицы1 = Поле.Ключ;
		Если Лев(ИмяПоляТаблицы1, 4) = "П001" Тогда
			НомерКолонки = Число(Прав(ИмяПоляТаблицы1, 2));
			НомерСтроки = Сред(ИмяПоляТаблицы1, 5, 4);
			Если НомерКолонки >= 3 И НомерКолонки <= 12 И СтрокиДанных.Найти(НомерСтроки) <> Неопределено Тогда
				ИмяПолеТаблицы2 = "П0001020001" + Формат(НомерКолонки + 1, "ЧЦ=2; ЧН=00; ЧВН=");
				Строка1Таблицы2[ИмяПолеТаблицы2] = Строка1Таблицы2[ИмяПолеТаблицы2] + ПоляОтчета[ИмяПоляТаблицы1];
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// Таблица 3
	
	ПоляОтчета["П003180003"] = 0;
	ПоляОтчета["П003190003"] = 0;
	ПоляОтчета["П003200003"] = 0; // Заполняется ниже
	
	ДанныеВозраста = ДанныеСреднегоВозрастаФонда(ПараметрыОтчета, ОСФонда);
	
	Для Каждого Выборка Из ДанныеВозраста Цикл
		
		Если Выборка.Следующий() Тогда
			
			ПоляОтчета[Выборка.КодПоля] = Выборка.Возраст;
			
			// Расшифровка
			НаименованиеПоказателя = "Средний возраст имеющихся на конец года основных фондов, № строки " + Сред(Выборка.КодПоля, 5, 2);
			ВыборкаОС = Выборка.Выбрать();
			Пока ВыборкаОС.Следующий() Цикл
				ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки,, Выборка.КодПоля, НаименованиеПоказателя,
					ВыборкаОС.ОсновноеСредство.Наименование, ВыборкаОС.Возраст);
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Таблица 4
	
	Таблица4 = Контейнер["ПолеТабличногоДокументаФормаОтчета_ДанныеДопСтрок2"];
	Таблица4.Очистить();
	
	НомерСтраницы = 0;
	ОбщаяСумма = 0;
	
	ДанныеСреднегодовая = СреднегодоваяСтоимостьФорма11К(ПараметрыОтчета, ОСФонда);
	
	Для Каждого ПоПодразделению Из ДанныеСреднегодовая.Строки Цикл
		
		Если ПоПодразделению.ОбособленноеПодразделение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		КодОКПО = ?(ЗначениеЗаполнено(ПоПодразделению.ОбособленноеПодразделение),
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПоПодразделению.ОбособленноеПодразделение, "Наименование"),
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыОтчета.Организация, "КодОКПО"));
		
		СтрокаТаблицы4 = Таблица4.Добавить();		
		СтрокаТаблицы4["П000105000101"] = КодОКПО;
		СтрокаТаблицы4["П000105000102"] = ПоПодразделению.СреднегодоваяСтоимость;
		
		ОбщаяСумма = ОбщаяСумма + ПоПодразделению.СреднегодоваяСтоимость;
		
		// Расшифровка
		
		НомерСтраницы = НомерСтраницы + 1;
		НаименованиеПоказателя = "Среднегодовая полная учетная стоимость, стр. 25." + НомерСтраницы;
		НаименованиеСредняя = "Среднегодовая полная учетная стоимость, стр. 20";
		
		Для Каждого ПоОС Из ПоПодразделению.Строки Цикл
			Сумма = ПоОС.СреднегодоваяСтоимость / 1000;
			ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки,, "П000105000102", НаименованиеПоказателя,
				ПоОС.ОсновноеСредство.Наименование, Сумма, НомерСтраницы);
			ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки,, "П003200003", НаименованиеСредняя,
				ПоОС.ОсновноеСредство.Наименование, Сумма);
		КонецЦикла;
		
	КонецЦикла;
	
	ПоляОтчета["П003200003"] = ОбщаяСумма;
	
КонецПроцедуры

Процедура ЗаполнитьФормуОтчета11К_2021(ПараметрыОтчета, Контейнер, ТаблицаРасшифровки, Год)
	
	// Исправление ошибки отчета. В новом отчете передается Неопределено
	Если ПараметрыОтчета.ИмуществоКазны = Неопределено Тогда
		ПараметрыОтчета.ИмуществоКазны = Ложь;
	КонецЕсли;
	
	ОСФонда = ОсновныеФонды11К(ПараметрыОтчета, Год);
	
	Если ТипЗнч(ОСФонда) <> Тип("Массив") ИЛИ ОСФонда.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	
	
	Если Год >= 2023 Тогда
		Если ПараметрыОтчета.ИсключитьДанныеОбособленныхПодразделений Или ЗначениеЗаполнено(ПараметрыОтчета.ОбособленноеПодразделение) Тогда
			ПараметрыОтчета.Вставить("Подразделение", СписокОбособленныхПодразделений11К(ПараметрыОтчета));
		КонецЕсли;
	КонецЕсли;
	
	// Таблица 1
	
	ДанныеТаблицы = ДанныеЗаполненияТаблицыФормы11К(ПараметрыОтчета, ОСФонда, Год);
	
	// Соберем массив НФА, которые попадут в раздел 1. Этот массив дальше будет использоваться
	// в отборе НФА для заполнения разделов 3 и 4
	ОС_Раздела1 = Новый Массив;
	Для Каждого СтрокаОС Из ДанныеТаблицы.Строки[0].Строки Цикл
		СуммаПоОС = 0;
		Для Каждого Показатель Из ДанныеТаблицы.Колонки Цикл
			ИмяПоля = Показатель.Имя;
			Если ИмяПоля = "ОсновноеСредство" Или ИмяПоля = "НаименованиеОС" Тогда
				Продолжить;
			КонецЕсли;    
			
			СуммаПоОС = СуммаПоОС + СтрокаОС[ИмяПоля];
		КонецЦикла;	                                
		
		Если СуммаПоОС <> 0 Тогда
			ОС_Раздела1.Добавить(СтрокаОС.ОсновноеСредство);
		КонецЕсли;	
	КонецЦикла;
	
	ПоляОтчета = Контейнер["ПолеТабличногоДокументаФормаОтчета"];
	Для Каждого Показатель Из ДанныеТаблицы.Колонки Цикл
		
		ИмяПоля = Показатель.Имя;
		Если ИмяПоля = "ОсновноеСредство" Или ИмяПоля = "НаименованиеОС" Тогда
			Продолжить;
		КонецЕсли;
		
		НаименованиеПоказателя = ПолучитьНаименованиеПоказателя4(ИмяПоля);
		
		Для Каждого ОбщиеСуммы Из ДанныеТаблицы.Строки Цикл
			
			Если ПоляОтчета.Свойство(ИмяПоля) Тогда
				
				ПоляОтчета[ИмяПоля] = ОбщиеСуммы[ИмяПоля];
				
				Для Каждого ПоОС Из ОбщиеСуммы.Строки Цикл
					Значение = ПоОС[ИмяПоля]/1000;
					ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки,, ИмяПоля, НаименованиеПоказателя, ПоОС.НаименованиеОС, Значение);
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	// Таблица 2
	
	Таблица2 = Контейнер["ПолеТабличногоДокументаФормаОтчета_ДанныеДопСтрок1"];
	Таблица2.Очистить();
	
	СтрокаТаблицы2 = Таблица2.Добавить();
	СтрокаТаблицы2["П000020100102"] = "15";
	
	ЗначенияРеквизитовОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПараметрыОтчета.Организация, "КодОКВЭД2,НаименованиеОКВЭД2");
	Если ЗначениеЗаполнено(ЗначенияРеквизитовОрганизации.НаименованиеОКВЭД2) Тогда
		СтрокаТаблицы2["П000020100101"] = ЗначенияРеквизитовОрганизации.НаименованиеОКВЭД2;
		СтрокаТаблицы2["П000020100103"] = ЧистыйКодПоОКВЭД(ЗначенияРеквизитовОрганизации.КодОКВЭД2);
	КонецЕсли;
	
	СтрокиДанных = СтрРазделить("02,04,06,07,08,10,12,14,15,16,17,18,19", ",", Ложь);
	Для Каждого Поле Из ПоляОтчета Цикл
		ИмяПоляТаблицы1 = Поле.Ключ;
		Если Лев(ИмяПоляТаблицы1, 6) = "П00001" Тогда
			НомерКолонки = Число(Прав(ИмяПоляТаблицы1, 2));
			НомерСтроки = Сред(ИмяПоляТаблицы1, 10, 2);
			Если НомерКолонки >= 3 И НомерКолонки <= 12 И СтрокиДанных.Найти(НомерСтроки) <> Неопределено Тогда
				ИмяПолеТаблицы2 = "П0000201001" + Формат(НомерКолонки + 1, "ЧЦ=2; ЧВН=");
				СтрокаТаблицы2[ИмяПолеТаблицы2] = СтрокаТаблицы2[ИмяПолеТаблицы2] + Окр(ПоляОтчета[ИмяПоляТаблицы1], -3);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// Таблица 3
	
	ПоляОтчета["П000030101803"] = 0;
	ПоляОтчета["П000030101903"] = 0;
	ПоляОтчета["П000030102003"] = 0; // Заполняется ниже
	
	ДанныеВозраста = ДанныеСреднегоВозрастаФонда(ПараметрыОтчета, ОС_Раздела1, Год);
	Шаблон = "%1 (%2 руб., %3 лет)";
	
	Для Каждого Выборка Из ДанныеВозраста Цикл
		
		Если Выборка.Следующий() Тогда
			
			ОбщийВозраст = 0;
			
			// Расшифровка
			НаименованиеПоказателя = "Средний возраст имеющихся на конец года основных фондов, № строки " + Сред(Выборка.КодПоля, 10, 2);
			ВыборкаОС = Выборка.Выбрать();
			Пока ВыборкаОС.Следующий() Цикл
				
				// Возраст в запросе считается в днях, чтобы можно было получить ненулевой возраст объектов, 
				// у которых срок менее месяца. 
				Возраст_Год = Окр(ВыборкаОС.Возраст / 365, 3);
				СредневзвешенныйВозрастОС = Возраст_Год * ВыборкаОС.Стоимость / Выборка.Стоимость;
				Представление = СтрШаблон(Шаблон, ВыборкаОС.НаименованиеОС, ВыборкаОС.Стоимость, Возраст_Год);
				ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки,, Выборка.КодПоля, НаименованиеПоказателя,
					Представление, СредневзвешенныйВозрастОС);
				
				ОбщийВозраст = ОбщийВозраст + СредневзвешенныйВозрастОС;
				
			КонецЦикла;
			
			ОбщийВозраст = ?(ОбщийВозраст < 0.5 И ОбщийВозраст > 0, 1, ОбщийВозраст);
			ОбщийВозраст = Окр(ОбщийВозраст);
			ПоляОтчета[Выборка.КодПоля] = ОбщийВозраст;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Таблица 4
	
	Таблица4 = Контейнер["ПолеТабличногоДокументаФормаОтчета_ДанныеДопСтрок2"];
	Таблица4.Очистить();
	
	НомерСтраницы = 0;
	ОбщаяСумма = 0;
	
	ДанныеСреднегодовая = СреднегодоваяСтоимостьФорма11К(ПараметрыОтчета, ОС_Раздела1);
	
	КоличествоПодразделений = 0;
	
	Для Каждого ПоПодразделению Из ДанныеСреднегодовая.Строки Цикл
		
		Если ПараметрыОтчета.Свойство("Подразделение") Тогда
			Если ПараметрыОтчета.ИсключитьДанныеОбособленныхПодразделений Тогда
				Если ЗначениеЗаполнено(ПоПодразделению.ОбособленноеПодразделение) Тогда
					Продолжить;
				КонецЕсли;
			Иначе
				Если ПараметрыОтчета["Подразделение"].Найти(ПоПодразделению.ОбособленноеПодразделение) = Неопределено Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
		Иначе
			Если ПоПодразделению.ОбособленноеПодразделение = Неопределено Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		КоличествоПодразделений = КоличествоПодразделений + 1;
		
		КодОКПО = ?(ЗначениеЗаполнено(ПоПодразделению.ОбособленноеПодразделение),
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПоПодразделению.ОбособленноеПодразделение, "Наименование"),
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыОтчета.Организация, "КодОКПО"));
		
		СтрокаТаблицы4 = Таблица4.Добавить();
		СтрокаТаблицы4["П000040100103"] = КодОКПО;
		СтрокаТаблицы4["П000040100102"] = ПоПодразделению.СреднегодоваяСтоимость;
		
		ОбщаяСумма = ОбщаяСумма + ПоПодразделению.СреднегодоваяСтоимость;
		
		// Расшифровка
		
		НомерСтраницы = НомерСтраницы + 1;
		НаименованиеПоказателя = "Среднегодовая полная учетная стоимость, стр. 25." + НомерСтраницы;
		НаименованиеСредняя = "Среднегодовая полная учетная стоимость, стр. 20";
		
		Для Каждого ПоОС Из ПоПодразделению.Строки Цикл
			Сумма = ПоОС.СреднегодоваяСтоимость / 1000;
			ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки,, "П000040100102", НаименованиеПоказателя,
				ПоОС.ОсновноеСредство.Наименование, Сумма, НомерСтраницы);
			ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки,, "П000030102003", НаименованиеСредняя,
				ПоОС.ОсновноеСредство.Наименование, Сумма);
		КонецЦикла;
		
	КонецЦикла;
	
	ПоляОтчета["П000030102003"] = ОбщаяСумма;
	
	Если Год >= 2022 Тогда
		ПоляОтчета["П000040102502"] = КоличествоПодразделений;
	КонецЕсли;
	
	Если ПараметрыОтчета.Свойство("АдресВременногоХранилищаРасшифровки") Тогда
		ПараметрыОтчета.АдресВременногоХранилищаРасшифровки = ПоместитьВоВременноеХранилище(ТаблицаРасшифровки);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьФормуОтчета11К_2024(ПараметрыОтчета, Контейнер, ТаблицаРасшифровки, Год)
	
	Если ПараметрыОтчета.ИмуществоКазны = Неопределено Тогда
		ПараметрыОтчета.ИмуществоКазны = Ложь;
	КонецЕсли;
	
	Если ПараметрыОтчета.ИсключитьДанныеОбособленныхПодразделений Или ЗначениеЗаполнено(ПараметрыОтчета.ОбособленноеПодразделение) Тогда
		ПараметрыОтчета.Вставить("Подразделение", СписокОбособленныхПодразделений11К(ПараметрыОтчета));
	КонецЕсли;

	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ЕстьОсновныеФондыДляЗаполнения = ОсновныеФонды11К_2024(ПараметрыОтчета, МенеджерВременныхТаблиц);
	Если Не ЕстьОсновныеФондыДляЗаполнения Тогда
		Возврат;
	КонецЕсли;	
	
	ПоляОтчета = Контейнер["ПолеТабличногоДокументаФормаОтчета"];

	// Таблица 1
	
	ОчиститьПоказателиТаблицы1Формы11К(ПоляОтчета);
	
	ДанныеЗаполненияРаздела1 = ДанныеЗаполненияТаблицыФормы11К_2024(ПараметрыОтчета, МенеджерВременныхТаблиц);
	ОС_Раздела1 = Новый Массив;
	ОСДобавлено = Новый Соответствие;
	
	ПоказателиКолонок = Новый Массив;
	Для НомерКолонки = 3 По 12 Цикл
		ПоказателиКолонок.Добавить(Формат(НомерКолонки,  "ЧЦ=2; ЧВН="));
	КонецЦикла;
	
	ШаблонПоказателяСтрокаОпределена = НСтр("ru = 'Строка № %1, колонка %2'");
	ШаблонПоказателяСтрокаНеОпределена = НСтр("ru = 'Строка %1, колонка %2, возможно есть ошибки заполнения.
		|Не заполнен ОКОФ в справочнике ОС, НМА, НПА или ОКОФ не соответствует правилам заполнения формы'");
	
	ВыборкаПоказателей = ДанныеЗаполненияРаздела1.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоказателей.Следующий() Цикл
		ПоказательСтроки = ВыборкаПоказателей.ПоказательСтроки;
		Для Каждого ПоказательКолонки Из ПоказателиКолонок Цикл
			ИмяПоказателя = ПоказательСтроки + ПоказательКолонки;
			Если ПоляОтчета.Свойство(ИмяПоказателя) Тогда
				ПоляОтчета[ИмяПоказателя] = ВыборкаПоказателей["Колонка" + ПоказательКолонки];
			КонецЕсли;
		КонецЦикла;
		
		Если Лев(ПоказательСтроки, 6) = "П00001" Тогда
			ШаблонПоказателя = ШаблонПоказателяСтрокаОпределена;
			ПоказательРаздела1 = Истина;
		Иначе
			ШаблонПоказателя = ШаблонПоказателяСтрокаНеОпределена;
			ПоказательРаздела1 = Ложь;
		КонецЕсли;
		
		ВыборкаОС = ВыборкаПоказателей.Выбрать();
		Пока ВыборкаОС.Следующий() Цикл
			
			Для Каждого ПоказательКолонки Из ПоказателиКолонок Цикл
				
				ИмяПоказателя = ПоказательСтроки + ПоказательКолонки;
				НаименованиеПоказателя = СтрШаблон(ШаблонПоказателя,
					ВыборкаОС.НомерСтрокиОтчета,
					Число(ПоказательКолонки));
				
				Значение = ВыборкаОС["Колонка" + ПоказательКолонки] / 1000;
				ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки,
					"",
					ИмяПоказателя,
					НаименованиеПоказателя,
					ВыборкаОС.НаименованиеОС,
					Значение,
					Неопределено,
					Ложь,
					Новый Структура("Ссылка", ВыборкаОС.ОсновноеСредство));
				
				Если ПоказательРаздела1 И Значение <> 0 И ОСДобавлено[ВыборкаОС.ОсновноеСредство] = Неопределено Тогда
					ОС_Раздела1.Добавить(ВыборкаОС.ОсновноеСредство);
					ОСДобавлено.Вставить(ВыборкаОС.ОсновноеСредство, Истина);					
				КонецЕсли;
				
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	ОСДобавлено.Очистить();
	
	// Таблица 2
	
	Таблица2 = Контейнер["ПолеТабличногоДокументаФормаОтчета_ДанныеДопСтрок1"];
	Таблица2.Очистить();
	
	СтрокаТаблицы2 = Таблица2.Добавить();
	СтрокаТаблицы2["П000020100102"] = "15";
	
	ЗначенияРеквизитовОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПараметрыОтчета.Организация, "КодОКВЭД2,НаименованиеОКВЭД2");
	Если ЗначениеЗаполнено(ЗначенияРеквизитовОрганизации.НаименованиеОКВЭД2) Тогда
		СтрокаТаблицы2["П000020100101"] = ЗначенияРеквизитовОрганизации.НаименованиеОКВЭД2;
		СтрокаТаблицы2["П000020100103"] = ЧистыйКодПоОКВЭД(ЗначенияРеквизитовОрганизации.КодОКВЭД2);
	КонецЕсли;
	
	СтрокиДанных = СтрРазделить("02,04,06,07,08,10,12,14,15,16,17,18,19", ",", Ложь);
	Для Каждого Поле Из ПоляОтчета Цикл
		ИмяПоляТаблицы1 = Поле.Ключ;
		Если Лев(ИмяПоляТаблицы1, 6) = "П00001" Тогда
			НомерКолонки = Число(Прав(ИмяПоляТаблицы1, 2));
			НомерСтроки = Сред(ИмяПоляТаблицы1, 10, 2);
			Если НомерКолонки >= 3 И НомерКолонки <= 12 И СтрокиДанных.Найти(НомерСтроки) <> Неопределено Тогда
				ИмяПолеТаблицы2 = "П0000201001" + Формат(НомерКолонки + 1, "ЧЦ=2; ЧВН=");
				СтрокаТаблицы2[ИмяПолеТаблицы2] = СтрокаТаблицы2[ИмяПолеТаблицы2] + Окр(ПоляОтчета[ИмяПоляТаблицы1], -3);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// Таблица 3
	
	ПоляОтчета["П000030101803"] = 0;
	ПоляОтчета["П000030101903"] = 0;
	ПоляОтчета["П000030102003"] = 0;
	ПоляОтчета["П000030102103"] = 0;
	ПоляОтчета["П000030102203"] = 0;
	ПоляОтчета["П000030102303"] = 0;
	ПоляОтчета["П000030102403"] = 0;
	ПоляОтчета["П000030102503"] = 0;
	
	ДанныеСреднегоВозраста = ДанныеСреднегоВозрастаФонда_2024(ПараметрыОтчета, МенеджерВременныхТаблиц);
	ШаблонПоказателя = НСтр("ru = 'Средний возраст имеющихся на конец года основных фондов, № строки %1'");
	ШаблонСлагаемого = НСтр("ru = '%1, инв. номер %2 (%3 руб., %4 лет)'");
	ВыборкаПоказатели = ДанныеСреднегоВозраста.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоказатели.Следующий() Цикл
		
		Если Не ПоляОтчета.Свойство(ВыборкаПоказатели.ПоказательСтроки) Тогда
			Продолжить;
		КонецЕсли;
		
		НаименованиеПоказателя = СтрШаблон(ШаблонПоказателя, Сред(ВыборкаПоказатели.ПоказательСтроки, 10, 2));
		ОбщийВозраст = 0;
			
		ВыборкаОС = ВыборкаПоказатели.Выбрать();
		Пока ВыборкаОС.Следующий() Цикл
			
			Возраст_Год = Окр(ВыборкаОС.Возраст / 365, 3);
			СредневзвешенныйВозрастОС = Возраст_Год * ВыборкаОС.Стоимость / ВыборкаПоказатели.Стоимость;
			ОбщийВозраст = ОбщийВозраст + СредневзвешенныйВозрастОС;
			
			НаименованиеСлагаемого = СтрШаблон(ШаблонСлагаемого,
				ВыборкаОС.НаименованиеОС,
				СокрЛП(ВыборкаОС.ИнвентарныйНомерКод),
				ВыборкаОС.Стоимость,
				Возраст_Год);
			
			Ссылка = ?(ЗначениеЗаполнено(ВыборкаОС.ИнвентарныйНомер), ВыборкаОС.ИнвентарныйНомер,
				ВыборкаОС.ОсновноеСредство);	
				
			ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки,
				"",
				ВыборкаПоказатели.ПоказательСтроки,
				НаименованиеПоказателя,
				НаименованиеСлагаемого,
				СредневзвешенныйВозрастОС,
				Неопределено,
				Истина,
				Новый Структура("Ссылка", Ссылка));
			
		КонецЦикла;
		
		ОбщийВозраст = ?(ОбщийВозраст < 0.5, 1, Окр(ОбщийВозраст));
		ПоляОтчета[ВыборкаПоказатели.ПоказательСтроки] = ОбщийВозраст;
			
	КонецЦикла;
	
	// Таблица 4
	
	Таблица4 = Контейнер["ПолеТабличногоДокументаФормаОтчета_ДанныеДопСтрок2"];
	Таблица4.Очистить();
	
	ДанныеСреднегодовая = СреднегодоваяСтоимостьФорма11К(ПараметрыОтчета, ОС_Раздела1);
	
	КоличествоПодразделений = 0;
	НомерСтраницы = 0;
	ОбщаяСумма = 0;
	ОбщаяСуммаСтрок27 = 0;
	ШаблонПоказателяСтроки27 = НСтр("ru = 'Среднегодовая полная учетная стоимость, стр. 27.%1'");
	НаименованиеПоказателяСтроки20 = НСтр("ru = 'Среднегодовая полная учетная стоимость, стр. 20'");
	СтрокаДосчета = Неопределено;
	
	Для Каждого ПоПодразделению Из ДанныеСреднегодовая.Строки Цикл
		
		КоличествоПодразделений = КоличествоПодразделений + 1;
		
		КодОКПО = ?(ЗначениеЗаполнено(ПоПодразделению.ОбособленноеПодразделение),
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПоПодразделению.ОбособленноеПодразделение, "Наименование"),
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыОтчета.Организация, "КодОКПО"));
		
		СтрокаТаблицы4 = Таблица4.Добавить();
		СтрокаТаблицы4["П000040100103"] = КодОКПО;
		СтрокаТаблицы4["П000040100102"] = ПоПодразделению.СреднегодоваяСтоимость;
		
		ОбщаяСумма = ОбщаяСумма + ПоПодразделению.СреднегодоваяСтоимость;
		ОбщаяСуммаСтрок27 = ОбщаяСуммаСтрок27 + Окр(ПоПодразделению.СреднегодоваяСтоимость, -3);
		
		Если СтрокаДосчета = Неопределено
			Или СтрокаДосчета["П000040100102"] < СтрокаТаблицы4["П000040100102"] Тогда
				
			СтрокаДосчета = СтрокаТаблицы4;
			
		КонецЕсли;
				
		НомерСтраницы = НомерСтраницы + 1;
		НаименованиеПоказателяСтроки27 = СтрШаблон(ШаблонПоказателяСтроки27, НомерСтраницы);
		
		Для Каждого ПоОС Из ПоПодразделению.Строки Цикл
			Сумма = ПоОС.СреднегодоваяСтоимость / 1000;
			ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки,
				"",
				"П000040100102",
				НаименованиеПоказателяСтроки27,
				ПоОС.ОсновноеСредствоНаименование,
				Сумма,
				НомерСтраницы,
				Ложь,
				Новый Структура("Ссылка", ПоОС.ОсновноеСредство));
			ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки,
				"",
				"П000030102003",
				НаименованиеПоказателяСтроки20,				
				ПоОС.ОсновноеСредствоНаименование,
				Сумма,
				Неопределено,
				Ложь,
				Новый Структура("Ссылка", ПоОС.ОсновноеСредство));
		КонецЦикла;
		
	КонецЦикла;
	
	ОбщаяСумма = Окр(ОбщаяСумма, -3);
	ПоляОтчета["П000030102003"] = ОбщаяСумма;
	ПоляОтчета["П000040102502"] = КоличествоПодразделений;
	
	Если ОбщаяСумма <> ОбщаяСуммаСтрок27 Тогда
		
		СуммаДосчета = ОбщаяСумма - ОбщаяСуммаСтрок27;
		СтрокаДосчета["П000040100102"] = СтрокаДосчета["П000040100102"] + СуммаДосчета;
		НомерСтраницы = Таблица4.Индекс(СтрокаДосчета) + 1;
		НаименованиеПоказателяСтроки27 = СтрШаблон(ШаблонПоказателяСтроки27, НомерСтраницы);
		НаименованиеСлагаемого = НСтр(
			"ru = 'Накопленная погрешность округления. Досчет до суммарной величины строки 20'");
		ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки,
			"",
			"П000040100102",
			НаименованиеПоказателяСтроки27,
			НаименованиеСлагаемого,
			СуммаДосчета / 1000,
			НомерСтраницы,
			Ложь,
			Неопределено);			
			
	КонецЕсли;
	
	Если ПараметрыОтчета.Свойство("АдресВременногоХранилищаРасшифровки") Тогда
		ПараметрыОтчета.АдресВременногоХранилищаРасшифровки = ПоместитьВоВременноеХранилище(ТаблицаРасшифровки);
	КонецЕсли;
	
КонецПроцедуры

Функция ОсновныеФонды11К(ПараметрыОтчета, Год = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация"	, ПараметрыОтчета.Организация);
	Если Год = Неопределено ИЛИ Год < 2023 Тогда
		Запрос.УстановитьПараметр("КонецПериода", ПараметрыОтчета.мДатаКонцаПериодаОтчета);
		
		Если ПараметрыОтчета.ИмуществоКазны Тогда
			
			Запрос.Текст =
			"ВЫБРАТЬ
			|	СобытияОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
			|	МИНИМУМ(СобытияОССрезПоследних.ДатаСобытия) КАК ДатаПринятияКУчету
			|ПОМЕСТИТЬ ВТ_События
			|ИЗ
			|	РегистрСведений.СобытияОС.СрезПоследних(
			|			&КонецПериода,
			|			Организация = &Организация
			|				И ОсновноеСредство.ИмуществоКазны
			|				И Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)) КАК СобытияОССрезПоследних
			|ГДЕ
			|	СобытияОССрезПоследних.ДатаСобытия <> ДАТАВРЕМЯ(1, 1, 1)
			|
			|СГРУППИРОВАТЬ ПО
			|	СобытияОССрезПоследних.ОсновноеСредство
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
			|	ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.ПервоначальнаяСтоимость КАК ПервоначальнаяСтоимость
			|ПОМЕСТИТЬ ВТ_ПервоначальныеСведения
			|ИЗ
			|	РегистрСведений.ПервоначальныеСведенияОСБухгалтерскийУчет.СрезПоследних(
			|			&КонецПериода,
			|			Организация = &Организация
			|				И ОсновноеСредство.ИмуществоКазны) КАК ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТ_События.ОсновноеСредство КАК ОсновноеСредство
			|ИЗ
			|	ВТ_События КАК ВТ_События
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПервоначальныеСведения КАК ВТ_ПервоначальныеСведения
			|		ПО ВТ_События.ОсновноеСредство = ВТ_ПервоначальныеСведения.ОсновноеСредство
			|ГДЕ
			|	ВЫБОР
			|			КОГДА ВТ_События.ДатаПринятияКУчету < ДАТАВРЕМЯ(2009, 1, 1)
			|				ТОГДА ВЫБОР
			|						КОГДА ВТ_ПервоначальныеСведения.ПервоначальнаяСтоимость < 10000
			|							ТОГДА ЛОЖЬ
			|						ИНАЧЕ ИСТИНА
			|					КОНЕЦ
			|			КОГДА ВТ_События.ДатаПринятияКУчету < ДАТАВРЕМЯ(2011, 1, 1)
			|				ТОГДА ВЫБОР
			|						КОГДА ВТ_ПервоначальныеСведения.ПервоначальнаяСтоимость < 20000
			|							ТОГДА ЛОЖЬ
			|						ИНАЧЕ ИСТИНА
			|					КОНЕЦ
			|			КОГДА ВТ_События.ДатаПринятияКУчету < ДАТАВРЕМЯ(2018, 1, 1)
			|				ТОГДА ВЫБОР
			|						КОГДА ВТ_ПервоначальныеСведения.ПервоначальнаяСтоимость < 40000
			|							ТОГДА ЛОЖЬ
			|						ИНАЧЕ ИСТИНА
			|					КОНЕЦ
			|			ИНАЧЕ ВЫБОР
			|					КОГДА ВТ_ПервоначальныеСведения.ПервоначальнаяСтоимость < 100000
			|						ТОГДА ЛОЖЬ
			|					ИНАЧЕ ИСТИНА
			|				КОНЕЦ
			|		КОНЕЦ";
			
		Иначе
			
			Запрос.Текст =
			"ВЫБРАТЬ
			|	ПараметрыАмортизации.ОсновноеСредство КАК ОсновноеСредство
			|ИЗ
			|	РегистрСведений.ПараметрыАмортизацииОСБухгалтерскийУчет.СрезПоследних(
			|			&КонецПериода,
			|			Организация = &Организация
			|				И НЕ ОсновноеСредство.ИмуществоКазны) КАК ПараметрыАмортизации
			|ГДЕ
			|	ПараметрыАмортизации.ПорядокПогашенияСтоимости = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации)
			|	И ПараметрыАмортизации.СпособНачисленияАмортизации В(&СпособыНачисленияАмортизации)";
			
			СпособыНачисленияАмортизации = Новый Массив;
			СпособыНачисленияАмортизации.Добавить(Перечисления.СпособНачисленияАмортизации.Линейный);
			СпособыНачисленияАмортизации.Добавить(Перечисления.СпособНачисленияАмортизации.УменьшаемогоОстатка);
			СпособыНачисленияАмортизации.Добавить(Перечисления.СпособНачисленияАмортизации.ПропорциональноОбъемуПродукции);
			
			Запрос.УстановитьПараметр("СпособыНачисленияАмортизации", СпособыНачисленияАмортизации);
			
		КонецЕсли;
	Иначе // форма редакции >= 2023
		Запрос.УстановитьПараметр("КонецПериода", КонецДня(ПараметрыОтчета.мДатаКонцаПериодаОтчета));
		Запрос.УстановитьПараметр("КонецПериодаДляОстатков", КонецДня(ПараметрыОтчета.мДатаКонцаПериодаОтчета) + 1);
		Запрос.УстановитьПараметр("НачалоПериода", НачалоГода(ПараметрыОтчета.мДатаКонцаПериодаОтчета));
		Запрос.УстановитьПараметр("СубконтоОС", ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
		СтрокаСчетовУчета = ?(ПараметрыОтчета.ИмуществоКазны, "108.00", "101.00, 102.00, 111.60");
		СчетаУчетаОС = БухгалтерскийУчет.СписокСчетов(СтрокаСчетовУчета, ПараметрыОтчета.мДатаКонцаПериодаОтчета, Истина, ПараметрыОтчета.Организация);
		Запрос.УстановитьПараметр("СчетаУчетаОС", СчетаУчетаОС);
		Запрос.УстановитьПараметр("ПределСтоимостиОС", 100000);
		
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕПСБУОбороты.СубконтоДт1 КАК ОсновноеСредство
		|ПОМЕСТИТЬ ТабОС
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ОборотыДтКт(&НачалоПериода, &КонецПериода, Регистратор, СчетДт В ИЕРАРХИИ (&СчетаУчетаОС), &СубконтоОС, НЕ СчетКт В ИЕРАРХИИ (&СчетаУчетаОС), , Организация = &Организация) КАК ЕПСБУОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	ЕПСБУОбороты.СубконтоДт1
		|
		|ИМЕЮЩИЕ
		|	СУММА(ЕПСБУОбороты.СуммаОборот) >= &ПределСтоимостиОС
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЕПСБУОстаткиК.Субконто1
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&НачалоПериода, Счет В ИЕРАРХИИ (&СчетаУчетаОС), &СубконтоОС, Организация = &Организация) КАК ЕПСБУОстаткиК
		|
		|СГРУППИРОВАТЬ ПО
		|	ЕПСБУОстаткиК.Субконто1
		|
		|ИМЕЮЩИЕ
		|	СУММА(ЕПСБУОстаткиК.СуммаОстаток) >= &ПределСтоимостиОС
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЕПСБУОстаткиК.Субконто1
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&КонецПериодаДляОстатков, Счет В ИЕРАРХИИ (&СчетаУчетаОС), &СубконтоОС, Организация = &Организация) КАК ЕПСБУОстаткиК
		|
		|СГРУППИРОВАТЬ ПО
		|	ЕПСБУОстаткиК.Субконто1
		|
		|ИМЕЮЩИЕ
		|	СУММА(ЕПСБУОстаткиК.СуммаОстаток) >= &ПределСтоимостиОС
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТабОС.ОсновноеСредство КАК ОсновноеСредство
		|ИЗ
		|	ТабОС КАК ТабОС
		|
		|СГРУППИРОВАТЬ ПО
		|	ТабОС.ОсновноеСредство";

		Если ПараметрыОтчета.мДатаКонцаПериодаОтчета < Дата(2024, 1, 1) Тогда // Приказ Росстата от 05.12.2023 N 622
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, ">= &ПределСтоимостиОС", "> &ПределСтоимостиОС");		
		КонецЕсли;

		Запрос.Текст = ТекстЗапроса;
		
	КонецЕсли;	
	
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ОсновноеСредство");
	
	Возврат Результат;
	
КонецФункции

Функция ОсновныеФонды11К_2024(ПараметрыОтчета, МенеджерВременныхТаблиц)
	
	ПределСтоимостиОС = 100000;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Организация", ПараметрыОтчета.Организация);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоГода(ПараметрыОтчета.мДатаКонцаПериодаОтчета));
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(ПараметрыОтчета.мДатаКонцаПериодаОтчета));
	Запрос.УстановитьПараметр("ВидСубконтоОС", ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	Запрос.УстановитьПараметр("СчетаУчета", СчетаУчетаФормы11К(ПараметрыОтчета));
	Запрос.УстановитьПараметр("ПределСтоимостиОС", ПределСтоимостиОС);

	ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОС,
		|	ЕПСБУОстатки.Счет КАК Счет
		|ПОМЕСТИТЬ ВТ_ОСОтборПоЛимитуСтоимости
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&НачалоПериода, Счет В (&СчетаУчета), &ВидСубконтоОС,
		|		Организация = &Организация
		|	И &УсловиеПоПодразделению_РегистрБухгалтерии) КАК ЕПСБУОстатки
		|ГДЕ
		|	ЕПСБУОстатки.СуммаОстаток >= &ПределСтоимостиОС
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстаткиИОбороты.Субконто1 КАК Справочник.ОсновныеСредства),
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.Счет
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, Запись, Движения, Счет В
		|	(&СчетаУчета), &ВидСубконтоОС, Организация = &Организация
		|	И &УсловиеПоПодразделению_РегистрБухгалтерии) КАК ЖурналПроводокЕПСБУОстаткиИОбороты
		|ГДЕ
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.СуммаКонечныйОстаток >= &ПределСтоимостиОС
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОсновныеСредства.Ссылка КАК ОС,
		|	ВЫБОР
		|		КОГДА ОсновныеСредства.ТипНФА = ЗНАЧЕНИЕ(Перечисление.ТипыНФА.БиблиотечныйФонд)
		|			ТОГДА ""БФ""
		|		ИНАЧЕ ЕСТЬNULL(ВЫРАЗИТЬ(ОсновныеСредства.КодОКОФ.Код КАК СТРОКА(3)), """")
		|	КОНЕЦ КАК ПоказательОКОФ,
		|	ОсновныеСредства.Наименование КАК НаименованиеОС
		|ПОМЕСТИТЬ ВТ_ОС
		|ИЗ
		|	Справочник.ОсновныеСредства КАК ОсновныеСредства
		|ГДЕ
		|	ОсновныеСредства.Ссылка В
		|		(ВЫБРАТЬ
		|			ВТ_ОСОтборПоЛимитуСтоимости.ОС
		|		ИЗ
		|			ВТ_ОСОтборПоЛимитуСтоимости КАК ВТ_ОСОтборПоЛимитуСтоимости)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ОС
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ИСТИНА КАК ЕстьДанные
		|ИЗ
		|	ВТ_ОС КАК ВТ_ОС";

	Если ПараметрыОтчета.Свойство("Подразделение") Тогда
		
		Запрос.УстановитьПараметр("Подразделение", ПараметрыОтчета["Подразделение"]);
		
		УсловиеПоПодразделению_РегистрБухгалтерии = ?(
			ПараметрыОтчета.ИсключитьДанныеОбособленныхПодразделений,
			"НЕ ЕстьNULL(Подразделение, Значение(Справочник.Подразделения.ПустаяСсылка)) В (&Подразделение)",
			"Подразделение В (&Подразделение)");
		
	Иначе
		УсловиеПоПодразделению_РегистрБухгалтерии = "ИСТИНА";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоПодразделению_РегистрБухгалтерии", УсловиеПоПодразделению_РегистрБухгалтерии);
	Запрос.Текст = ТекстЗапроса;
	РезультатЗапроса = Запрос.Выполнить();
	Возврат Не РезультатЗапроса.Пустой();
	
КонецФункции

Функция ДанныеЗаполненияТаблицыФормы11К(ПараметрыОтчета, ОСФонда, Год = 2020)
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕПСБУДвиженияССубконто.СчетДт КАК СчетДт,
	|	ЕПСБУДвиженияССубконто.СчетКт КАК СчетКт,
	|	ВЫБОР
	|		КОГДА ЕПСБУДвиженияССубконто.ВидСубконтоДт1 = &ВидСубконтоОС
	|			ТОГДА ЕПСБУДвиженияССубконто.СубконтоДт1
	|		КОГДА ЕПСБУДвиженияССубконто.ВидСубконтоДт2 = &ВидСубконтоОС
	|			ТОГДА ЕПСБУДвиженияССубконто.СубконтоДт2
	|		КОГДА ЕПСБУДвиженияССубконто.ВидСубконтоДт3 = &ВидСубконтоОС
	|			ТОГДА ЕПСБУДвиженияССубконто.СубконтоДт3
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ОСДт,
	|	ВЫБОР
	|		КОГДА ЕПСБУДвиженияССубконто.ВидСубконтоКт1 = &ВидСубконтоОС
	|			ТОГДА ЕПСБУДвиженияССубконто.СубконтоКт1
	|		КОГДА ЕПСБУДвиженияССубконто.ВидСубконтоКт2 = &ВидСубконтоОС
	|			ТОГДА ЕПСБУДвиженияССубконто.СубконтоКт2
	|		КОГДА ЕПСБУДвиженияССубконто.ВидСубконтоКт3 = &ВидСубконтоОС
	|			ТОГДА ЕПСБУДвиженияССубконто.СубконтоКт3
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ОСКт,
	|	ЕПСБУДвиженияССубконто.ХарактеристикаДвиженияДт КАК ХарактеристикаДвиженияДт,
	|	ЕПСБУДвиженияССубконто.ХарактеристикаДвиженияКт КАК ХарактеристикаДвиженияКт,
	|	ЕПСБУДвиженияССубконто.Сумма КАК Сумма
	|ПОМЕСТИТЬ Стоимость_Движения_ДтКт
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			Организация = &Организация
	|				И Активность
	|				И (СчетДт В (&СчетУчета)
	|						И ПодразделениеДт В (&Подразделение)
	|					ИЛИ СчетКт В (&СчетУчета)
	|						И ПодразделениеКт В (&Подразделение)),
	|			,
	|			) КАК ЕПСБУДвиженияССубконто
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ВТ.ОСДт КАК Справочник.ОсновныеСредства) КАК ОС,
	|	ВТ.Сумма КАК Сумма,
	|	ВТ.ХарактеристикаДвиженияДт КАК ХарактеристикаДвижения,
	|	ВТ.ХарактеристикаДвиженияКт КАК ХарактеристикаДвиженияКор
	|ПОМЕСТИТЬ Стоимость_Движения_Дт
	|ИЗ
	|	Стоимость_Движения_ДтКт КАК ВТ
	|ГДЕ
	|	ВТ.СчетДт В(&СчетУчета)
	|	И НЕ ВТ.СчетКт В (&СчетУчета)
	|	И НЕ ВТ.СчетКт В (&СчетКорИскл)
	|	И ВТ.ОСДт В(&ОСФонда)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
