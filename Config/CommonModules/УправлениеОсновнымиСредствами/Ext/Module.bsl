	|ПО
	|	КодПоОКАТО";
	
	ВыборкаОКАТО = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока Раздел2.Количество()>1 Цикл
		Раздел2.Удалить(1);
	КонецЦикла;
	
	Если ВыборкаОКАТО.Количество() = 0 Тогда
		
		ПутьКРегистру = "(меню ""Учет и отчетность"" - ""Регистрация транспортных средств"")";
  
		ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
