		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОстаткиРНпоКонтрагентам КАК ОстаткиРН
		|		ПО ОстаткиБУ.Субконто1 = ОстаткиРН.ОсновноеСредство
		|		И ОстаткиБУ.Субконто2 = ОстаткиРН.Контрагент
		|		И (ПОДСТРОКА(ОстаткиБУ.Счет.Код, 1, 2) = ""25""
		|		И ОстаткиРН.ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ПереданоВАренду)
		|		ИЛИ ПОДСТРОКА(ОстаткиБУ.Счет.Код, 1, 2) = ""26""
		|		И ОстаткиРН.ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ПереданоВПользование)
		|		ИЛИ ПОДСТРОКА(ОстаткиБУ.Счет.Код, 1, 2) = ""24""
		|		И ОстаткиРН.ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ПереданоВУправление)
		|		ИЛИ ПОДСТРОКА(ОстаткиБУ.Счет.Код, 1, 2) = ""27""
		|		И ОстаткиРН.ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ПереданоВЛичноеПользование))
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиБУ.Субконто1,
		|	ОстаткиРН.ИнвентарныйНомер,
		|	ОстаткиБУ.Субконто2,
		|	ОстаткиБУ.Счет.Код,
		|	ОстаткиБУ.КФО,
		|	ОстаткиБУ.ИФО,
		|	ОстаткиРН.ЦМО";
	КонецЕсли;	
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ТаблицаДокумента", ТабДокумента);
	Запрос.УстановитьПараметр("Организация", ДокументОбъект.Организация);
	ДатаПроверки = ДокументОбъект.Дата;
	ТекДата = Новый Граница(КонецДня(ДатаПроверки), ВидГраницы.Включая);
	Если ЗначениеЗаполнено(ДокументОбъект.Ссылка) Тогда
		ТекДата = Новый Граница(ДокументОбъект.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;	
	Запрос.УстановитьПараметр("ДатаПроверки", ТекДата);

	Запрос.УстановитьПараметр("УчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));

	СчетаОбременения = БухгалтерскийУчет.СписокСчетов("24, 25, 26, 27.01", ДатаПроверки, Ложь, ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("СчетаОбременения", СчетаОбременения);
	
	СубконтоОС = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства");
	СубконтоДоговоры = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.Договоры");
	СубконтоКонтрагенты = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.Контрагенты");
	СубконтоЦМО = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.ЦМО");
	
	Субконто = Новый Массив;
	Субконто.Добавить(СубконтоОС);
	Субконто.Добавить(СубконтоЦМО);
	Запрос.УстановитьПараметр("СубконтоОС_ЦМО", Субконто);
	
	Субконто = Новый Массив;
	Субконто.Добавить(СубконтоОС);
	Запрос.УстановитьПараметр("СубконтоОС", Субконто);
	
	Субконто = Новый Массив;
	Субконто.Добавить(СубконтоОС);
	Субконто.Добавить(СубконтоЦМО);
	Субконто.Добавить(СубконтоДоговоры);
	Запрос.УстановитьПараметр("СубконтоОС_ЦМО_Договоры", Субконто);
	
	Субконто = Новый Массив;
	Субконто.Добавить(СубконтоОС);
	Субконто.Добавить(СубконтоЦМО);
	Субконто.Добавить(СубконтоКонтрагенты);
	Запрос.УстановитьПараметр("СубконтоОС_ЦМО_Контрагенты", Субконто);
	
	Субконто = Новый Массив;
	Субконто.Добавить(СубконтоОС);
	Субконто.Добавить(СубконтоКонтрагенты);
	Запрос.УстановитьПараметр("СубконтоОС_Контрагенты", Субконто);
	
	Субконто = Новый Массив;
	Субконто.Добавить(СубконтоОС);
	Субконто.Добавить(СубконтоДоговоры);
	Запрос.УстановитьПараметр("СубконтоОС_Договоры", Субконто);
	
	ВидыРаспоряжения = Новый Массив;
	ВидыРаспоряжения.Добавить(ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.ПереданоВАренду"));	 
	ВидыРаспоряжения.Добавить(ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.ПереданоВПользование"));	 
	ВидыРаспоряжения.Добавить(ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.ПереданоВУправление"));	 
	ВидыРаспоряжения.Добавить(ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.ПереданоВЛичноеПользование"));	 
	Запрос.УстановитьПараметр("ВидыРаспоряженияОбременения", ВидыРаспоряжения);

	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ТабДокумента = РезультатЗапроса[7].Выгрузить();
	ТабОбременений = Неопределено;
	Если НуженКонтрольОбременений Тогда
		ТабОбременений = РезультатЗапроса[9].Выгрузить();
	КонецЕсли;	
	
	ТабДокумента.Колонки.Добавить("ТекстОшибки", Новый ОписаниеТипов("Строка"));
	
	СтруктураПоискаОбременений = Новый Структура();
	СтруктураПоискаОбременений.Вставить("ОсновноеСредство");
	СтруктураПоискаОбременений.Вставить("ИнвентарныйНомер");
	СтруктураПоискаОбременений.Вставить("КФО");
	СтруктураПоискаОбременений.Вставить("ИФО");
	СтруктураПоискаОбременений.Вставить("ЦМО");
	
	Для каждого СтрокаТЧ из ТабДокумента Цикл
		ТекстОбъекта = ?(ЗначениеЗаполнено(СтрокаТЧ.ИнвентарныйНомер),
			СтрШаблон(НСтр("ru = '%1 (%2)'"), СтрокаТЧ.ОсновноеСредство, СтрокаТЧ.ИнвентарныйНомер),
			СтрШаблон(НСтр("ru = '%1'"), СтрокаТЧ.ОсновноеСредство));
		
		ТекстОшибки = "";	
		Если СтрокаТЧ.КоличествоОстаток < СтрокаТЧ.Количество ИЛИ СтрокаТЧ.СуммаОстаток < СтрокаТЧ.Сумма Тогда
			Если СтрокаТЧ.НомерСтроки = 0 Тогда
				// Если в документе нет табличной части, то НомерСтроки = 0
				Текст1 = НСтр("ru = 'По объекту ""%1"" не хватает остатков.'");
				Текст1 = СтрШаблон(Текст1, ТекстОбъекта);
			Иначе	
				Текст1 = НСтр("ru = 'В строке %1 по объекту ""%2"" не хватает остатков.'");
				Текст1 = СтрШаблон(Текст1, СтрокаТЧ.НомерСтроки, ТекстОбъекта);
			КонецЕсли;		
			
			ТекстОшибки = Текст1 + " " + 
				НСтр("ru = ' Доступно (шт. / руб.): %1 / %2, Всего: %3 / %4, В резерве: %5 / %6'");
			ТекстОшибки = СтрШаблон(
				ТекстОшибки, 
				СтрокаТЧ.КоличествоОстаток,
				СтрокаТЧ.СуммаОстаток,
				СтрокаТЧ.КоличествоОстаток + СтрокаТЧ.КоличествоРезерв, 
				СтрокаТЧ.СуммаОстаток + СтрокаТЧ.СуммаРезерв, 
				СтрокаТЧ.КоличествоРезерв,
				СтрокаТЧ.СуммаРезерв);
			ЕстьПроблемы = Истина;
		ИначеЕсли ТабОбременений <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(СтруктураПоискаОбременений, СтрокаТЧ);
			СтрокиОбременений = ТабОбременений.НайтиСтроки(СтруктураПоискаОбременений);
			Если СтрокиОбременений.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
					
			// По объекту есть обременения
			КоличествоВОбремененииВсего = 0;
			СуммаВОбремененииВсего = 0;
			Для каждого СтрокаОбременения из СтрокиОбременений Цикл
				КоличествоВОбремененииВсего = КоличествоВОбремененииВсего + СтрокаОбременения.Количество;
				СуммаВОбремененииВсего = СуммаВОбремененииВсего + СтрокаОбременения.Сумма;
			КонецЦикла;	
			
			Если СтрокаТЧ.КоличествоОстаток - КоличествоВОбремененииВсего - СтрокаТЧ.Количество >= 0 
				И СтрокаТЧ.СуммаОстаток - СуммаВОбремененииВсего - СтрокаТЧ.Сумма >= 0 Тогда
				Продолжить;
			КонецЕсли;	
			
			ТекстЧастино = ?(КоличествоВОбремененииВсего = 0, НСтр("ru = 'частично находится'"), "");
			
			ТекстОшибкиПоСтроке = "";
			Для каждого СтрокаОбременения из СтрокиОбременений Цикл
				ТекстОбременения = "";
				ГруппаОбременения = Лев(СтрокаОбременения.СчетОбременения, 2);
				Если ГруппаОбременения = "24" Тогда
					ТекстОбременения = НСтр("ru = 'в доверительном управлении'");
				ИначеЕсли ГруппаОбременения = "25" Тогда
					ТекстОбременения = НСтр("ru = 'в аренде'");
				ИначеЕсли ГруппаОбременения = "26" Тогда
					ТекстОбременения = НСтр("ru = 'в безвозмездном пользовании'");
				ИначеЕсли ГруппаОбременения = "27" Тогда
					ТекстОбременения = НСтр("ru = 'в личном пользовании'");
				КонецЕсли;	
	
				Если СтрокаТЧ.НомерСтроки = 0 Тогда
					ТекстОшибкиПоСтроке = НСтр("ru = 'Объект ""%1"" %2 %3 у контрагента: ""%4"".'");
					ТекстОшибкиПоСтроке = СтрШаблон(ТекстОшибкиПоСтроке, 
						ТекстОбъекта, ТекстЧастино, ТекстОбременения, СтрокаОбременения.Контрагент);
				Иначе	
					ТекстОшибкиПоСтроке = НСтр("ru = 'В строке: %1, объект ""%2"" %3 %4 у контрагента: ""%5"".'");
					ТекстОшибкиПоСтроке = СтрШаблон(ТекстОшибкиПоСтроке, 
						СтрокаТЧ.НомерСтроки, ТекстОбъекта, ТекстЧастино, ТекстОбременения, СтрокаОбременения.Контрагент);
				КонецЕсли;	
				ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибки), Символы.ПС, "") + ТекстОшибкиПоСтроке;						
				ЕстьПроблемы = Истина;
			КонецЦикла;		
		КонецЕсли;	

		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			СтрокаТЧ.ТекстОшибки = ТекстОшибки;
			ОбщегоНазначения.СообщитьПользователю(
				СтрокаТЧ.ТекстОшибки, ДокументОбъект.Ссылка, "ОсновныеСредства", "Объект");
		КонецЕсли;	 
	КонецЦикла;	
	
	Возврат ЕстьПроблемы;
КонецФункции	

Функция ЕстьПроблемыСписания_НаличиеРезерваПоОбъекту(ТабДокумента, ДокументОбъект) Экспорт
	ЕстьПроблемы = Ложь;
	Если ДокументОбъект.Аннулирован Тогда
		Возврат ЕстьПроблемы;
	КонецЕсли;	
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ТаблицаОС.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОС.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ ТаблицаОС
	|ИЗ
	|	&ТаблицаДокумента КАК ТаблицаОС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РезервОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	СУММА(РезервОСОстатки.КоличествоОстаток) КАК Количество
	|ПОМЕСТИТЬ Резерв
	|ИЗ
	|	РегистрНакопления.РезервОС.Остатки(&ДатаПроверки, Организация = &Организация
	|	И ОсновноеСредство В
	|		(ВЫБРАТЬ
	|			ТаблицаОС.ОсновноеСредство
	|		ИЗ
	|			ТаблицаОС)) КАК РезервОСОстатки
	|СГРУППИРОВАТЬ ПО
	|	РезервОСОстатки.ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаОС.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОС.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	ТаблицаОС КАК ТаблицаОС
	|		ЛЕВОЕ СОЕДИНЕНИЕ Резерв КАК Резерв
	|		ПО ТаблицаОС.ОсновноеСредство = Резерв.ОсновноеСредство
	|ГДЕ
	|	НЕ Резерв.ОсновноеСредство ЕСТЬ NULL";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ТаблицаДокумента", ТабДокумента);
	Запрос.УстановитьПараметр("Организация", ДокументОбъект.Организация);
	ДатаПроверки = ДокументОбъект.Дата;
	ТекДата = Новый Граница(КонецДня(ДатаПроверки), ВидГраницы.Включая);
	Если ЗначениеЗаполнено(ДокументОбъект.Ссылка) Тогда
		ТекДата = Новый Граница(ДокументОбъект.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;	
	Запрос.УстановитьПараметр("ДатаПроверки", ТекДата);
	ТаблицаДокумента = Запрос.Выполнить().Выгрузить();

	ТаблицаДокумента.Колонки.Добавить("ТекстОшибки", Новый ОписаниеТипов("Строка"));
	
	Для каждого ТекСтрока из ТаблицаДокумента Цикл
		ТекстОшибки = НСтр(
			"ru = 'В строке %1, по объекту ""%2"" есть резерв. Переместить объект на другой счет нельзя'");
		ТекстОшибки = СтрШаблон(ТекстОшибки, ТекСтрока.НомерСтроки, ТекСтрока.ОсновноеСредство);
		ТекСтрока.ТекстОшибки = ТекстОшибки;
	
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ДокументОбъект.Ссылка, "ОсновныеСредства", "Объект");
		КонецЕсли;	 
		ЕстьПроблемы = Истина;
	КонецЦикла;	
	
	Возврат(ЕстьПроблемы);
КонецФункции	

// Проверяет есть ли объекты с обременением (остатки на счетах 24, 25, 26, 27).
// Если есть то выводит сообщение об ошибке.
//
// Параметры:
//  ТаблицаДокумента - ТаблицаЗначений - Является, как входящей, так и исходящей.
//  	На входе передается таблица значений с колонками:
//   * НомерСтроки - Число - номер строки в документе
//   * ОсновноеСредство - СправочникСсылка.ОсновныеСредства - объект проверки
//   * ИнвентарныйНомер - СправочникСсылка.ИнвентарныеНомераОС - инвентарный номер объекта проверки, если есть
//   * Количество - Число - на входе, это количество объектов проверки. На выходе, свободное количество, которое 
//		останется на счете, если списать переданный объект. Если количество отрицательное, то значит списывают 
//   	больше, чем можно с учетом обременения. Количество вычисляется по формуле 
//   	КоличествоВОстатке - КоличествоСОбременением - КоличествоКотороеСписывают
//   	
//   	На выходе к перечисленным колонкам добавляются колоноки:
//   * Контрагент - СправочникСсылка.Контрагенты - контрагент, у которого находятся объекты
//   * СчетОбременения - Строка - код счета обременения
//   * ЕстьОбременение - Булево - Истина - есть обременение по строке, Ложь - нет
//   * КоличествоВОбременении - Число - количество объектов, находящихся в обременении
//   * ТекстОшибки - Строка - Если ЕстьОБременение истина, то содержит текст ошибки, которую нужно показать пользователю 
//  ДатаПроверки - Дата - дата проверки
//  СсылкаДокумента - ДокументСсылка - ссылка на документ, из которого вызвана проверка (ссылка может быть пустой), 
//   	тогда данные будут получаться на дату документа. Иначе, на момент времени документа (не включая документ).
//  Организация - СправочникСсылка.Организации - организация
//
// Возвращаемое значение:
//  Булево - Истина - есть объекты с обременением, Ложь - нет
Функция ЕстьОбъектыСОбременением(ТаблицаДокумента, ДатаПроверки, СсылкаДокумента, Организация) Экспорт
	Если ТаблицаДокумента.Колонки.Найти("ПередачаЧастейОбъектов") = Неопределено Тогда
		ТаблицаДокумента.Колонки.Добавить("ПередачаЧастейОбъектов", Новый ОписаниеТипов("Булево"));
		ТаблицаДокумента.ЗаполнитьЗначения(Ложь, "ПередачаЧастейОбъектов");
	КонецЕсли;	
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОСДокумента.НомерСтроки КАК НомерСтроки,
	|	ОСДокумента.ОсновноеСредство КАК ОсновноеСредство,
	|	ОСДокумента.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ОСДокумента.Счет КАК Счет,
	|	ОСДокумента.ПередачаЧастейОбъектов КАК ПередачаЧастейОбъектов,
	|	ОСДокумента.Количество КАК Количество
	|ПОМЕСТИТЬ НужноСписать
	|ИЗ
	|	&ТаблицаДокумента КАК ОСДокумента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОстаткиСтоимости.ОсновноеСредство КАК ОсновноеСредство,
	|	ОстаткиСтоимости.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СУММА(ОстаткиСтоимости.КоличествоОстаток) КАК Количество
	|ПОМЕСТИТЬ ОстаткиРН
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(&ДатаПроверки, Организация = &Организация
	|	И ОсновноеСредство В
	|		(ВЫБРАТЬ
	|			НужноСписать.ОсновноеСредство
	|		ИЗ
	|			НужноСписать)
	|	И ВидРаспоряжения В (&ВидыРаспоряженияУчета)) КАК ОстаткиСтоимости
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиСтоимости.ИнвентарныйНомер,
	|	ОстаткиСтоимости.ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОстаткиБУ.Субконто1 КАК ОсновноеСредство,
	|	ОстаткиРН.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СУММА(ОстаткиРН.Количество) КАК Количество
	|ПОМЕСТИТЬ ОстаткиУчет
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&ДатаПроверки, Счет В
	|		(ВЫБРАТЬ
	|			НужноСписать.Счет
	|		ИЗ
	|			НужноСписать КАК НужноСписать), &СубконтоОсновныеСредства, Организация = &Организация
	|	И Субконто1 В
	|		(ВЫБРАТЬ
	|			НужноСписать.ОсновноеСредство
	|		ИЗ
	|			НужноСписать)) КАК ОстаткиБУ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОстаткиРН КАК ОстаткиРН
	|		ПО ОстаткиБУ.Субконто1 = ОстаткиРН.ОсновноеСредство
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиБУ.Субконто1,
	|	ОстаткиРН.ИнвентарныйНомер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОстаткиСтоимостипоКонтрагентам.ОсновноеСредство КАК ОсновноеСредство,
	|	ОстаткиСтоимостипоКонтрагентам.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ОстаткиСтоимостипоКонтрагентам.Контрагент КАК Контрагент,
	|	ОстаткиСтоимостипоКонтрагентам.ВидРаспоряжения КАК ВидРаспоряжения,
	|	СУММА(ОстаткиСтоимостипоКонтрагентам.КоличествоОстаток) КАК Количество,
	|	СУММА(ОстаткиСтоимостипоКонтрагентам.СтоимостьОстаток) КАК Сумма
	|ПОМЕСТИТЬ ОстаткиРНпоКонтрагентам
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОСПоКонтрагентам.Остатки(&ДатаПроверки, Организация = &Организация
	|	И ОсновноеСредство В
	|		(ВЫБРАТЬ
	|			НужноСписать.ОсновноеСредство
	|		ИЗ
	|			НужноСписать)
	|	И ВидРаспоряжения В (&ВидыРаспоряженияОбременения)) КАК ОстаткиСтоимостипоКонтрагентам
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиСтоимостипоКонтрагентам.ИнвентарныйНомер,
	|	ОстаткиСтоимостипоКонтрагентам.ОсновноеСредство,
	|	ОстаткиСтоимостипоКонтрагентам.Контрагент,
	|	ОстаткиСтоимостипоКонтрагентам.ВидРаспоряжения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОстаткиБУ.Субконто1 КАК ОсновноеСредство,
	|	ОстаткиРН.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ОстаткиБУ.Субконто2 КАК Контрагент,
	|	ОстаткиБУ.Счет.Код КАК СчетОбременения,
	|	СУММА(ОстаткиРН.Количество) КАК Количество,
	|	СУММА(ОстаткиРН.Сумма) КАК Сумма
	|ПОМЕСТИТЬ ОстаткиОбременения
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&ДатаПроверки, Счет В ИЕРАРХИИ (&СчетаОбременения),
	|		&СубконтоОсновныеСредстваКонтрагенты, Организация = &Организация
	|	И Субконто1 В
	|		(ВЫБРАТЬ
	|			НужноСписать.ОсновноеСредство
	|		ИЗ
	|			НужноСписать)) КАК ОстаткиБУ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОстаткиРНпоКонтрагентам КАК ОстаткиРН
	|		ПО ОстаткиБУ.Субконто1 = ОстаткиРН.ОсновноеСредство
	|		И ОстаткиБУ.Субконто2 = ОстаткиРН.Контрагент
	|		И (ПОДСТРОКА(ОстаткиБУ.Счет.Код, 1, 2) = ""25""
	|		И ОстаткиРН.ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ПереданоВАренду)
	|		ИЛИ ПОДСТРОКА(ОстаткиБУ.Счет.Код, 1, 2) = ""26""
	|		И ОстаткиРН.ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ПереданоВПользование)
	|		ИЛИ ПОДСТРОКА(ОстаткиБУ.Счет.Код, 1, 2) = ""24""
	|		И ОстаткиРН.ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ПереданоВУправление)
	|		ИЛИ ПОДСТРОКА(ОстаткиБУ.Счет.Код, 1, 2) = ""27""
	|		И ОстаткиРН.ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ПереданоВЛичноеПользование))
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиБУ.Субконто1,
	|	ОстаткиРН.ИнвентарныйНомер,
	|	ОстаткиБУ.Субконто2,
	|	ОстаткиБУ.Счет.Код
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НужноСписать.НомерСтроки КАК НомерСтроки,
	|	НужноСписать.ОсновноеСредство КАК ОсновноеСредство,
	|	НужноСписать.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ЕСТЬNULL(ОстаткиОбременения.Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) КАК Контрагент,
	|	ЕСТЬNULL(ОстаткиОбременения.СчетОбременения, """") КАК СчетОбременения,
	|	ВЫБОР
	|		КОГДА ОстаткиОбременения.ОсновноеСредство ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьОбременение,
	|	ЕСТЬNULL(ОстаткиОбременения.Количество, 0) КАК КоличествоВОбременении,
	|	ЕСТЬNULL(ОстаткиУчет.Количество, 0) - ЕСТЬNULL(ОстаткиОбременения.Количество, 0) - НужноСписать.Количество КАК
	|		Количество
	|ИЗ
	|	НужноСписать КАК НужноСписать
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиУчет КАК ОстаткиУчет
	|		ПО НужноСписать.ОсновноеСредство = ОстаткиУчет.ОсновноеСредство
	|		И НужноСписать.ИнвентарныйНомер = ОстаткиУчет.ИнвентарныйНомер
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиОбременения КАК ОстаткиОбременения
	|		ПО НужноСписать.ОсновноеСредство = ОстаткиОбременения.ОсновноеСредство
	|		И НужноСписать.ИнвентарныйНомер = ОстаткиОбременения.ИнвентарныйНомер
	|ГДЕ
	|	ЕСТЬNULL(ОстаткиУчет.Количество, 0) - ЕСТЬNULL(ОстаткиОбременения.Количество, 0) - НужноСписать.Количество < 0
	|	ИЛИ (НужноСписать.ПередачаЧастейОбъектов
	|	И ЕСТЬNULL(ОстаткиУчет.Количество, 0) - ЕСТЬNULL(ОстаткиОбременения.Количество, 0) = 0
	|	ИЛИ НЕ НужноСписать.ПередачаЧастейОбъектов
	|	И НужноСписать.ИнвентарныйНомер <> ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка))
	|	И ВЫБОР
	|		КОГДА ОстаткиОбременения.ОсновноеСредство ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ТаблицаДокумента", ТаблицаДокумента);
	Запрос.УстановитьПараметр("Организация", Организация);
	ТекДата = Новый Граница(КонецДня(ДатаПроверки), ВидГраницы.Включая);
	Если ЗначениеЗаполнено(СсылкаДокумента) Тогда
		ТекДата = Новый Граница(СсылкаДокумента.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;	
	Запрос.УстановитьПараметр("ДатаПроверки", ТекДата);

	СчетаОбременения = БухгалтерскийУчет.СписокСчетов("24, 25, 26, 27.01", ДатаПроверки, Ложь, Организация);
	Запрос.УстановитьПараметр("СчетаОбременения", СчетаОбременения);
	
	СубконтоОсновныеСредства = Новый Массив;
	СубконтоОсновныеСредства.Добавить(ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства"));
	Запрос.УстановитьПараметр("СубконтоОсновныеСредства", СубконтоОсновныеСредства);
	
	СубконтоОсновныеСредстваКонтрагенты = Новый Массив;
	СубконтоОсновныеСредстваКонтрагенты.Добавить(
		ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства"));
	СубконтоОсновныеСредстваКонтрагенты.Добавить(
		ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.Контрагенты"));
	Запрос.УстановитьПараметр("СубконтоОсновныеСредстваКонтрагенты", СубконтоОсновныеСредстваКонтрагенты);
	
	ВидыРаспоряженияОбременения = Новый Массив;
	ВидыРаспоряженияОбременения.Добавить(ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.ПереданоВАренду"));	 
	ВидыРаспоряженияОбременения.Добавить(ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.ПереданоВПользование"));	 
	ВидыРаспоряженияОбременения.Добавить(ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.ПереданоВУправление"));	 
	ВидыРаспоряженияОбременения.Добавить(ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.ПереданоВЛичноеПользование"));	 
	Запрос.УстановитьПараметр("ВидыРаспоряженияОбременения", ВидыРаспоряженияОбременения);

	ВидыРаспоряженияУчета = Новый Массив;
	ВидыРаспоряженияУчета.Добавить(ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.НаБалансе"));	 
	ВидыРаспоряженияУчета.Добавить(ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.ОперативныйУчет"));	 
	Запрос.УстановитьПараметр("ВидыРаспоряженияУчета", ВидыРаспоряженияУчета);
	
	ТаблицаДокумента = Запрос.Выполнить().Выгрузить();
	ТаблицаДокумента.Колонки.Добавить("ТекстОшибки", Новый ОписаниеТипов("Строка"));
	Для каждого ТекСтрока из ТаблицаДокумента Цикл
		ТекстОбъекта = ?(ЗначениеЗаполнено(ТекСтрока.ИнвентарныйНомер),
			СтрШаблон(НСтр("ru = '%1 (%2)'"), ТекСтрока.ОсновноеСредство, ТекСтрока.ИнвентарныйНомер),
			СтрШаблон(НСтр("ru = '%1'"), ТекСтрока.ОсновноеСредство));
			
		Если ТекСтрока.ЕстьОбременение Тогда
			ТекстЧастино = ?(ТекСтрока.КоличествоВОбременении = 0, НСтр("ru = 'частично находится'"), "");
			
			ТекстОбременения = "";
			ГруппаОбременения = Лев(ТекСтрока.СчетОбременения, 2);
			Если ГруппаОбременения = "24" Тогда
				ТекстОбременения = НСтр("ru = 'в доверительном управлении'");
			ИначеЕсли ГруппаОбременения = "25" Тогда
				ТекстОбременения = НСтр("ru = 'в аренде'");
			ИначеЕсли ГруппаОбременения = "26" Тогда
				ТекстОбременения = НСтр("ru = 'в безвозмездном пользовании'");
			ИначеЕсли ГруппаОбременения = "27" Тогда
				ТекстОбременения = НСтр("ru = 'в личном пользовании'");
			КонецЕсли;	

			ТекстОшибки = НСтр("ru = 'В строке: %1, объект ""%2"" %3 %4 у контрагента: ""%5"".'");
			ТекстОшибки = СтрШаблон(ТекстОшибки, 
				ТекСтрока.НомерСтроки, ТекстОбъекта, ТекстЧастино, ТекстОбременения, ТекСтрока.Контрагент);
		Иначе	
			ТекстОшибки = НСтр("ru = 'В строке: %1 по объекту ""%2"" недостаточно остатков.'");
			ТекстОшибки = СтрШаблон(ТекстОшибки, ТекСтрока.НомерСтроки, ТекстОбъекта);
		КонецЕсли;
		ТекСтрока.ТекстОшибки = ТекстОшибки; 
	КонецЦикла;	
	
	Возврат(ТаблицаДокумента.Количество() > 0);
КонецФункции

// Заполняет колонку "ДопАналитика" в таблице списания основных средств, которая формируется в механизмах контроля
// остатков функцией УправлениеОсновнымиСредствами.ПустаяТаблицаСписанияОСпоДокументу()
//
// Параметры:
//   ТабСчетов - ТаблицаЗначений - таблица бухгалтерских счетов из документа с из свойствами. Структура таблицы
//   		см. УправлениеОсновнымиСредствами.СвойстваСчетовДляКонтроляСписанияОС()
//   ТабДокумента - ТаблицаЗначений - таблица, созданная из табличной части документа. 
//   		В этой таблице и заполняется колонка
//   		Структура таблицы см. УправлениеОсновнымиСредствами.ПустаяТаблицаСписанияОСпоДокументу()
//   Объект - ДокументОбъект - документ-объект из которого вызывается функция
Процедура ЗаполнитьДопАналитикуВТаблицеСписанияОС(ТабСчетов, ТабДокумента, Объект) Экспорт
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ТабСчетов.Счет КАК Счет,
	|	ТабСчетов.ВидДопАналитики КАК ВидДопАналитики
	|ПОМЕСТИТЬ ТабСчетов1
	|ИЗ
	|	&ТабСчетов КАК ТабСчетов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабСчетов.Счет КАК Счет,
	|	ТабСчетов.ВидДопАналитики КАК ВидДопАналитики
	|ПОМЕСТИТЬ ТабСчетов
	|ИЗ
	|	ТабСчетов1 КАК ТабСчетов
	|ГДЕ
	|	ТабСчетов.ВидДопАналитики <> НЕОПРЕДЕЛЕНО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаДока.ДопАналитика КАК ДопАналитика,
	|	ТаблицаДока.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТаблицаДока.ИФО КАК ИФО,
	|	ТаблицаДока.Количество КАК Количество,
	|	ТаблицаДока.КПС КАК КПС,
	|	ТаблицаДока.КФО КАК КФО,
	|	ТаблицаДока.НомерСтроки КАК НомерСтроки,
	|	ТаблицаДока.Организация КАК Организация,
	|	ТаблицаДока.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаДока.ПередачаЧастейОбъектов КАК ПередачаЧастейОбъектов,
	|	ТаблицаДока.Подразделение КАК Подразделение,
	|	ТаблицаДока.Сумма КАК Сумма,
	|	ТаблицаДока.СчетУчета КАК СчетУчета,
	|	ТаблицаДока.ЦМО КАК ЦМО
	|ПОМЕСТИТЬ ТабДока
	|ИЗ
	|	&ТаблицаДока КАК ТаблицаДока
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	|	МАКСИМУМ(ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) КАК Контрагент,
	|	МАКСИМУМ(ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто2 КАК Справочник.Договоры)) КАК Договор
	|ПОМЕСТИТЬ ОстаткиБУ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&Дата1, Счет В
	|		(ВЫБРАТЬ
	|			Таб.Счет
	|		ИЗ
	|			ТабСчетов КАК Таб), &СубконтоОСДоговоры, Организация = &Организация
	|	И Субконто1 В
	|		(ВЫБРАТЬ
	|			Таб.ОсновноеСредство
	|		ИЗ
	|			ТабДока КАК Таб)) КАК ЕПСБУОстатки
	|СГРУППИРОВАТЬ ПО
	|	ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства),
	|	МАКСИМУМ(ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто2 КАК Справочник.Контрагенты)),
	|	МАКСИМУМ(ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка))
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&Дата1, Счет В
	|		(ВЫБРАТЬ
	|			Таб.Счет
	|		ИЗ
	|			ТабСчетов КАК Таб), &СубконтоОСКонтрагенты, Организация = &Организация
	|	И Субконто1 В
	|		(ВЫБРАТЬ
	|			Таб.ОсновноеСредство
	|		ИЗ
	|			ТабДока КАК Таб)) КАК ЕПСБУОстатки
	|СГРУППИРОВАТЬ ПО
	|	ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ТабДока.ДопАналитика <> НЕОПРЕДЕЛЕНО И НЕ ТабДока.ДопАналитика ЕСТЬ NULL
	|			ТОГДА ТабДока.ДопАналитика
	|		КОГДА ЕСТЬNULL(ТабСчетов.ВидДопАналитики, НЕОПРЕДЕЛЕНО) = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Договоры)
	|		И ЕСТЬNULL(ОстаткиБУ.Договор,
	|			ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	|			ТОГДА ОстаткиБУ.Договор
	|		КОГДА ЕСТЬNULL(ТабСчетов.ВидДопАналитики, НЕОПРЕДЕЛЕНО) = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Контрагенты)
	|		И ЕСТЬNULL(ОстаткиБУ.Контрагент,
	|			ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА ОстаткиБУ.Контрагент
	|		ИНАЧЕ ТабДока.ДопАналитика
	|	КОНЕЦ КАК ДопАналитика,
	|	ТабДока.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТабДока.ИФО КАК ИФО,
	|	ТабДока.Количество КАК Количество,
	|	ТабДока.КПС КАК КПС,
	|	ТабДока.КФО КАК КФО,
	|	ТабДока.НомерСтроки КАК НомерСтроки,
	|	ТабДока.Организация КАК Организация,
	|	ТабДока.ОсновноеСредство КАК ОсновноеСредство,
	|	ТабДока.ПередачаЧастейОбъектов КАК ПередачаЧастейОбъектов,
	|	ТабДока.Подразделение КАК Подразделение,
	|	ТабДока.Сумма КАК Сумма,
	|	ТабДока.СчетУчета КАК СчетУчета,
	|	ТабДока.ЦМО КАК ЦМО
	|ИЗ
	|	ТабДока КАК ТабДока
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТабСчетов1 КАК ТабСчетов
	|		ПО ТабДока.СчетУчета = ТабСчетов.Счет
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиБУ КАК ОстаткиБУ
	|		ПО ТабДока.ОсновноеСредство = ОстаткиБУ.ОсновноеСредство";

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ТабСчетов", ТабСчетов);
	Запрос.УстановитьПараметр("ТаблицаДока", ТабДокумента);
	Запрос.УстановитьПараметр("Дата1", Новый Граница(Объект.Дата, ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Организация", Объект.Организация);

	СубконтоОС = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства");
	СубконтоДоговоры = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.Договоры");
	СубконтоКонтрагенты = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.Контрагенты");
	
	Субконто = Новый Массив;
	Субконто.Добавить(СубконтоОС);
	Субконто.Добавить(СубконтоДоговоры);
	Запрос.УстановитьПараметр("СубконтоОСДоговоры", Субконто);
	
	Субконто = Новый Массив;
	Субконто.Добавить(СубконтоОС);
	Субконто.Добавить(СубконтоКонтрагенты);
	Запрос.УстановитьПараметр("СубконтоОСКонтрагенты", Субконто);
	
	ТабДокумента = Запрос.Выполнить().Выгрузить();
	
КонецПроцедуры	
	
