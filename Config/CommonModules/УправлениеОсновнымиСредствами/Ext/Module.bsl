	|	ЕСТЬNULL(ОстатокВсего.КоличествоОстатокДт, 0) КАК КоличествоВсего,
	|	ЕСТЬNULL(АмортизиацияВсего.СуммаОстатокКт, 0) КАК АмортизацияОС,
	|	ЕСТЬNULL(ОстатокПоМОЛ.СуммаОстатокДт, 0) КАК СуммаОстатокПоМОЛ,
	|	ВЫБОР
	|		КОГДА СписокОсновныхСредств.БезИнвНомера
	|			ТОГДА ЕСТЬNULL(ОстатокПоМОЛ.КоличествоОстатокДт, 0)
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК КоличествоМОЛ,
	|	ВЫБОР
	|		КОГДА ОстатокПоМОЛ.КоличествоОстатокДт = 0
	|			ТОГДА ОстатокПоМОЛ.СуммаОстатокДт
	|		ИНАЧЕ ЕСТЬNULL(ОстатокПоМОЛ.СуммаОстатокДт / ОстатокПоМОЛ.КоличествоОстатокДт, 0)
	|	КОНЕЦ КАК СуммаТекОС,
	|	ВЫБОР
	|		КОГДА АмортизиацияВсего.СуммаОстатокКт <> 0
	|			ТОГДА ВЫБОР
	|					КОГДА СписокОсновныхСредств.БезИнвНомера
	|						ТОГДА ВЫБОР
	|								КОГДА ОстатокВсего.СуммаОстатокДт <> 0
	|									ТОГДА ВЫРАЗИТЬ(ОстатокПоМОЛ.СуммаОстатокДт * АмортизиацияВсего.СуммаОстатокКт / ОстатокВсего.СуммаОстатокДт КАК ЧИСЛО(18, 2))
	|								ИНАЧЕ ЕСТЬNULL(АмортизиацияВсего.СуммаОстатокКт, 0)
