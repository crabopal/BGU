Процедура ОчиститьРаздел(Раздел)
	
	СтрокиРаздела = ?(ТипЗнч(Раздел) = Тип("ДеревоЗначений"), Раздел.Строки, Раздел);
	
	Если СтрокиРаздела.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Пока СтрокиРаздела.Количество() > 1 Цикл
		СтрокиРаздела.Удалить(1);
	КонецЦикла;
	
	Показатели = СтрокиРаздела[0].Данные;
	Если ТипЗнч(Показатели) = Тип("СписокЗначений") Тогда
		Показатели = Показатели[0].Значение;
	КонецЕсли;
	
	Для Каждого Показатель Из Показатели Цикл
		Показатели[Показатель.Ключ] = ОбщегоНазначенияБГУКлиентСервер.ПустоеЗначениеТипа(ТипЗнч(Показатель.Значение));
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСтроку030(Раздел21, СтраницаРаздел21, СтраницаРаздел21Здание, Адрес)
	
	ДополнительныеПараметрыАдреса = Новый Структура;
	ДополнительныеПараметрыАдреса.Вставить("ВерсияАдреса", 3);

	АдресФИАС = РегламентированнаяОтчетность.АдресВФорматеФИАС(Адрес, ДополнительныеПараметрыАдреса);
	
	СоответствиеПоказателей = СоответствиеПоказателейСтраницыРеквизитамАдреса();
	
	Для Каждого СтрокаПоля Из СоответствиеПоказателей Цикл
		Если ТипЗнч(СтрокаПоля.Значение) = Тип("Строка") Тогда
			СтраницаРаздел21.Вставить(СтрокаПоля.Ключ, АдресФИАС[СтрокаПоля.Значение]);
		КонецЕсли;
	КонецЦикла;
	
	ПервоеЗдание = Истина;
	Для Каждого Здание Из АдресФИАС.Здания Цикл

		Если Не ПервоеЗдание Тогда
			СтраницаРаздел21Здание = 
				НоваяСтрокаРаздел21Здание(Раздел21.Строки[Раздел21.Строки.Количество()-1].ДанныеМногострочныхЧастей.П00021М1).Данные;
		Иначе
			ПервоеЗдание = Ложь;
		КонецЕсли;
		
		СтраницаРаздел21Здание.П00021М103013 = Здание.ЗданиеТип;
		СтраницаРаздел21Здание.П00021М103014 = Здание.ЗданиеНомер;
		
	КонецЦикла;
	
КонецПроцедуры

