//   * ГрупповойУчет - Булево - вид учета из карточки ОС, групповой или индивидуальный
//   * ВидНФА - ПеречислениеСсылка.ВидыНФА - вид НФА из карточки ОС
//   * ТипНФА - ПеречислениеСсылка.ТипыНФА - тип НФА из карточки ОС
//   * СтранаПроисхождения - СправочникСсылка.СтраныМира - страна происхождения из карточки ОС
//   * ИнвентарныйНомер - СправочникСсылка.ИнвентарныеНомераОС
//   * СчетУчета - ПланСчетовСсылка.ЕПСБУ
//   * УчетПоКПС - Булево - состояние флага "Учет по КПС" из карточки счета
//   * ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения
//   * КФО - ПеречислениеСсылка.КВД
//   * КПС - СправочникСсылка.КлассификационныеПризнакиСчетов
//   * ЦМО - СправочникСсылка.ЦМО
//   * Подразделение - СправочникСсылка.Подразделения
//   * ДопАналитика - СправочникСсылка.Контрагенты, СправочникСсылка.Договоры - дополнительное субконто, если есть 
//   * Контрагент - СправочникСсылка.Контрагенты - Если значение ДопАналитика - Договор или Контрагент, 
//   				возвращает Контрагента 
//   * Договор - СправочникСсылка.Договоры - Если значение ДопАналитика - Договор, возвращает Договор 
//   * Количество - Число - количество, доступное для списания (с учетом резерва ОС)
//   * Сумма - Число - сумма, доступная для списания (с учетом резерва ОС)
//   * КоличествоРезерв - Число - количество в резерве
//   * СуммаРезерв - Число - сумма в резерве
//   * Цена - Число - стоимоть единицы, округленная до 2 знаков
//   * ЦенаНеокругленная - Число - стоимоть единицы неокругленная
Функция ТаблицаУчетныхДанных(Параметры) Экспорт
	Запрос = Новый Запрос(ТекстЗапроса_ТаблицаУчетныхДанных());
	Запрос.УстановитьПараметр("Организация", Параметры.Организация);
	Запрос.УстановитьПараметр("ТаблицаОС", Параметры.ТаблицаОС);
	Запрос.УстановитьПараметр("Дата1", Параметры.Дата);
	Запрос.УстановитьПараметр("СчетаУчета", Параметры.Счета);
	Запрос.УстановитьПараметр("УчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Запрос.УстановитьПараметр("Подразделение", Параметры.Подразделение); 

	Запрос.УстановитьПараметр("НетОтбораПоИФО", 
		НЕ (ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") И ЗначениеЗаполнено(Параметры.ИФО)));
	Запрос.УстановитьПараметр("ИФО", Параметры.ИФО);
	 
	Запрос.УстановитьПараметр("НетОтбораПоКФО", НЕ ЗначениеЗаполнено(Параметры.КФО));
	Запрос.УстановитьПараметр("КФО", Параметры.КФО); 

	Запрос.УстановитьПараметр("НетОтбораПоЦМО", НЕ ЗначениеЗаполнено(Параметры.ЦМО));
	Запрос.УстановитьПараметр("ЦМО", Параметры.ЦМО); 

	СубконтоОС = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства");
	СубконтоДоговоры = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.Договоры");
	СубконтоКонтрагенты = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.Контрагенты");
	СубконтоЦМО = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.ЦМО");
	
	Субконто = Новый Массив;
	Субконто.Добавить(СубконтоОС);
	Субконто.Добавить(СубконтоЦМО);
	Запрос.УстановитьПараметр("СубконтоОС_ЦМО", Субконто);
	
	Субконто = Новый Массив;
	Субконто.Добавить(СубконтоОС);
	Запрос.УстановитьПараметр("СубконтоОС", Субконто);
	
	Субконто = Новый Массив;
	Субконто.Добавить(СубконтоОС);
	Субконто.Добавить(СубконтоЦМО);
	Субконто.Добавить(СубконтоДоговоры);
	Запрос.УстановитьПараметр("СубконтоОС_ЦМО_Договоры", Субконто);
	
	Субконто = Новый Массив;
	Субконто.Добавить(СубконтоОС);
	Субконто.Добавить(СубконтоЦМО);
	Субконто.Добавить(СубконтоКонтрагенты);
	Запрос.УстановитьПараметр("СубконтоОС_ЦМО_Контрагенты", Субконто);
	
	Субконто = Новый Массив;
	Субконто.Добавить(СубконтоОС);
	Субконто.Добавить(СубконтоКонтрагенты);
	Запрос.УстановитьПараметр("СубконтоОС_Контрагенты", Субконто);
	
	Субконто = Новый Массив;
	Субконто.Добавить(СубконтоОС);
	Субконто.Добавить(СубконтоДоговоры);
	Запрос.УстановитьПараметр("СубконтоОС_Договоры", Субконто);
	
	Возврат(Запрос.Выполнить().Выгрузить());
КонецФункции	

#КонецОбласти	

#КонецОбласти

#Область ОбработчикиПодписок

// Обработчик подписки "ЗаполнитьОсновноеСредствоДокумента" на событие ПриЗаписи.
// записывает основное средство в регистр, если оно единственное в табличной части документа.
//
// Параметры:
//  Источник - ДокументОбъект - владелец присоединенного файла.
//  Отказ    - Булево - параметр, передаваемый в подписку на событие ПриЗаписи.
// 
Процедура ЗаполнитьОсновноеСредствоДокумента(Источник, Отказ) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ТипДокумента	= ТипЗнч(Источник);
	ИмяТаблицы		= "ОсновныеСредства";
	ИмяПоляОС		= "ОсновноеСредство";
	ИмяПоляИнв		= "ИнвентарныйНомер";
	
	ОСвШапке = Ложь;
	
	Если ТипДокумента = Тип("ДокументОбъект.ПереносВложенийВНФА") Тогда
		ИмяТаблицы	= "КапитальныеВложения";
		ИмяПоляОС	= "ВнеоборотныйАктив";
		ИмяПоляИнв	= "";
	ИначеЕсли ТипДокумента = Тип("ДокументОбъект.ИнвентаризацияОС") Тогда
		ИмяТаблицы	= "Инвентаризация";
	ИначеЕсли ТипДокумента = Тип("ДокументОбъект.ПринятиеКУчетуПравПользованияОС")
		Или ТипДокумента = Тип("ДокументОбъект.ВнутреннееПеремещениеОбъектовПравПользованияОС") Тогда
		ИмяПоляИнв	= "";
	ИначеЕсли ТипДокумента = Тип("ДокументОбъект.НачислениеАмортизацииПравПользованияОС")
		Или ТипДокумента = Тип("ДокументОбъект.ПрекращениеПравПользованияОС") Тогда
		ИмяТаблицы	= "ПраваПользования";
		ИмяПоляИнв	= "";
	ИначеЕсли ТипДокумента = Тип("ДокументОбъект.ПоступлениеОС")
		Или ТипДокумента = Тип("ДокументОбъект.ПоступлениеОСИК")
		Или ТипДокумента = Тип("ДокументОбъект.ПоступлениеОСВПути") Тогда
		ИмяТаблицы	= "КапВложения";
		ИмяПоляОС	= "ВнеоборотныйАктив";
		ИмяПоляИнв	= "";
	ИначеЕсли ТипДокумента = Тип("ДокументОбъект.ИзменениеПараметровАмортизации") Тогда
		ИмяПоляИнв	= "";
	ИначеЕсли ТипДокумента = Тип("ДокументОбъект.РегистрацияСпособаРаспределенияНалогаПоИсточникамФинансирования") Тогда
		ИмяПоляИнв	= "";
	ИначеЕсли ТипДокумента = Тип("ДокументОбъект.ИнвентаризационнаяОписьНФА") Тогда
		ИмяТаблицы	= "Раздел21";
		ИмяПоляОС	= "НФА";
	ИначеЕсли ТипДокумента = Тип("ДокументОбъект.ПереводОбъектовОСизГрупповогоУчетаНаИндивидуальный") Тогда
		ОСвШапке = Истина;
		ИмяТаблицы	= "ИнвентарныеНомера";
		ИмяПоляОС = "ОсновноеСредствоГрупповое";
		ИмяПоляИнв	= "ИнвентарныйНомерВГруппе";
	КонецЕсли;
		
	Если ОСвШапке Тогда
		КоличествоОС = 1;
	Иначе		
		ТаблицаОС = Источник[ИмяТаблицы].Выгрузить(, ИмяПоляОС);
		ТаблицаОС.Свернуть(ИмяПоляОС);
		КоличествоОС = ТаблицаОС.Количество();
	КонецЕсли;	
	
	ИнвентарныйНомер = Справочники.ИнвентарныеНомераОС.ПустаяСсылка();
	
	Если КоличествоОС = 0 Тогда
		ОсновноеСредство = Справочники.ОсновныеСредства.ПустаяСсылка();
	ИначеЕсли КоличествоОС = 1 Тогда
		Если ОСвШапке Тогда
			ОсновноеСредство = Источник[ИмяПоляОС];
		Иначе	
			ОсновноеСредство = ТаблицаОС[0][ИмяПоляОС];
		КонецЕсли;
			
		Если ЗначениеЗаполнено(ИмяПоляИнв) Тогда
			ТаблицаИнв = Источник[ИмяТаблицы].Выгрузить(, ИмяПоляИнв);
			ТаблицаИнв.Свернуть(ИмяПоляИнв);
			Если ТаблицаИнв.Количество() = 1 Тогда
				ИнвентарныйНомер = ТаблицаИнв[0][ИмяПоляИнв];
			КонецЕсли;
		КонецЕсли;
	Иначе
		ОсновноеСредство = Неопределено;
	КонецЕсли;
	
	Запись = РегистрыСведений.ОсновноеСредствоДокумента.СоздатьМенеджерЗаписи();
	Запись.Документ = Источник.Ссылка;
	
	Если ОсновноеСредство = Неопределено Тогда
		Запись.Прочитать();
		Если Запись.Выбран() Тогда
			Запись.Удалить();
		КонецЕсли;
	Иначе
		Запись.ОсновноеСредство = ОсновноеСредство;
		Запись.ИнвентарныйНомер = ИнвентарныйНомер;
		Запись.Записать();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти 

#Область ЗаполнениеРегламентированнойОтчетности

Функция НалоговыйОрганПоКоду(Код, Организация)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Код", Код);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РегистрацииВНалоговомОргане.Ссылка КАК НалоговыйОрган
	|ИЗ
	|	Справочник.РегистрацииВНалоговомОргане КАК РегистрацииВНалоговомОргане
	|ГДЕ
	|	РегистрацииВНалоговомОргане.Владелец = &Организация
	|	И РегистрацииВНалоговомОргане.Код = &Код
	|	И НЕ РегистрацииВНалоговомОргане.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Справочник.РегистрацииВНалоговомОргане.ПустаяСсылка)
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.Ссылка = &Организация
	|	И Организации.КодНалоговогоОргана = &Код
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Справочник.РегистрацииВНалоговомОргане.ПустаяСсылка)
	|ГДЕ
	|	&Код = """"";
	
	Результат = Запрос.Выполнить().Выгрузить();
	Возврат Результат.ВыгрузитьКолонку("НалоговыйОрган");
	
КонецФункции

Функция ПоказателиРаздела(Раздел, ДобавитьСтраницу = Ложь)
	
	НовыйФормат = (ТипЗнч(Раздел) = Тип("ДеревоЗначений"));
	Если Не НовыйФормат Тогда
		ВСтруктуре = (ТипЗнч(Раздел[0].Данные) = Тип("Структура"));
	КонецЕсли;
	
	Показатели = ?(НовыйФормат, Раздел.Строки[0].Данные, ?(ВСтруктуре, Раздел[0].Данные, Раздел[0].Данные[0].Значение));
	
	Если ДобавитьСтраницу Тогда
		
		ПоказателиНовойСтраницы = Новый Структура;
		
		Для Каждого Показатель Из Показатели Цикл
			ПоказателиНовойСтраницы.Вставить(Показатель.Ключ, ОбщегоНазначенияБГУКлиентСервер.ПустоеЗначениеТипа(ТипЗнч(Показатель.Значение)));
		КонецЦикла;
		
		Если НовыйФормат Тогда
			НоваяСтраница = Раздел.Строки.Добавить();
			НоваяСтраница.Данные = ПоказателиНовойСтраницы;
			НоваяСтраница.ДанныеМногострочныхЧастей = Новый Структура;
		ИначеЕсли ВСтруктуре Тогда
			НоваяСтраница = Раздел.Добавить();
			НоваяСтраница.Данные = ПоказателиНовойСтраницы;
			НоваяСтраница.АвтоматическоеПредставление = Истина;
		Иначе
			НоваяСтраница = Раздел.Добавить();
			НоваяСтраница.Данные = Новый СписокЗначений;
			НоваяСтраница.Данные.Добавить(ПоказателиНовойСтраницы);
		КонецЕсли;
		
		Показатели = ПоказателиНовойСтраницы;
		
	КонецЕсли;
	
	Возврат Показатели;
	
КонецФункции

#Область ЗаполнениеДекларацииПоНалогуНаИмущество

Процедура ПолучитьСведенияОПоказателяхОтчетаИмущество(ИДРедакцииОтчета, ПоказателиОтчета) Экспорт
	
	Если ИДРедакцииОтчета = "ФормаОтчета2020Кв4_1" Тогда
		ПолучитьСведенияОПоказателяхОтчетаИмуществоФормаОтчета2019Кв4(ПоказателиОтчета, Истина);
	ИначеЕсли ИДРедакцииОтчета = "ФормаОтчета2021Кв4" Тогда
		ПолучитьСведенияОПоказателяхОтчетаИмуществоФормаОтчета2019Кв4(ПоказателиОтчета, Истина);
	ИначеЕсли ИДРедакцииОтчета = "ФормаОтчета2022Кв1" Тогда
		ПолучитьСведенияОПоказателяхОтчетаИмуществоФормаОтчета2019Кв4(ПоказателиОтчета, Истина);
	ИначеЕсли ИДРедакцииОтчета = "ФормаОтчета2022Кв4" Тогда
		ПолучитьСведенияОПоказателяхОтчетаИмуществоФормаОтчета2022Кв4(ПоказателиОтчета);
	ИначеЕсли ИДРедакцииОтчета = "ФормаОтчета2024Кв4" Тогда
		ПолучитьСведенияОПоказателяхОтчетаИмуществоФормаОтчета2022Кв4(ПоказателиОтчета);
	ИначеЕсли ИДРедакцииОтчета = "ФормаОтчета2025Кв4" Тогда
		ПолучитьСведенияОПоказателяхОтчетаИмуществоФормаОтчета2022Кв4(ПоказателиОтчета);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьРегламентированныйОтчетИмущество(ИДРедакцииОтчета, ПараметрыОтчета, Контейнер) Экспорт
	
	Если ИДРедакцииОтчета = "ФормаОтчета2020Кв4_1" Тогда
		ЗаполнитьОтчетИмущество_2020Кв4(ПараметрыОтчета, Контейнер);
	ИначеЕсли ИДРедакцииОтчета = "ФормаОтчета2021Кв4" Тогда
		ЗаполнитьОтчетИмущество_2020Кв4(ПараметрыОтчета, Контейнер);
	ИначеЕсли ИДРедакцииОтчета = "ФормаОтчета2022Кв1" Тогда
		ЗаполнитьОтчетИмущество_2020Кв4(ПараметрыОтчета, Контейнер);
	ИначеЕсли ИДРедакцииОтчета = "ФормаОтчета2022Кв4" Тогда
		ЗаполнитьОтчетИмущество_2020Кв4(ПараметрыОтчета, Контейнер);
	ИначеЕсли ИДРедакцииОтчета = "ФормаОтчета2024Кв4" Тогда
		ЗаполнитьОтчетИмущество_2020Кв4(ПараметрыОтчета, Контейнер);
	ИначеЕсли ИДРедакцииОтчета = "ФормаОтчета2025Кв4" Тогда
		ЗаполнитьОтчетИмущество_2020Кв4(ПараметрыОтчета, Контейнер);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПолучитьСведенияОПоказателяхОтчетаИмуществоФормаОтчета2019Кв4(ПоказателиОтчета, ЕстьРаздел4 = Ложь)
	
	// Раздел 2
	
	РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "П000020000101", Истина, Ложь); // Код вида имущества (код строки 001)
	РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "П000020001001", Истина, Ложь); // Код по ОКТМО (код строки 010)
	РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, "П000020001100", Истина, Ложь); // Код бюджетной классификации
	
	Для Сч = 2 По 14 Цикл
		Для Сч2 = 3 По 4 Цикл
			ИмяПоказателя = "П0000200" + Формат(Сч, "ЧЦ=2; ЧВН=") + "00" + Сч2;
			РегламентированнаяОтчетность.ВставитьПоказательВСтруктуру(ПоказателиОтчета, ИмяПоказателя, Истина, Истина); // код строки 020 - 140
		КонецЦикла;
