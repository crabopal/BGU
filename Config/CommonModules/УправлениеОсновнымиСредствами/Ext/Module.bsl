Функция ПолучитьСчетаУчетаОСпоТаблицеДокумента(Таблица, ВидСчета = "СчетУчета", Период)

	МассивСсылок = Таблица.Выгрузить().ВыгрузитьКолонку("ОсновноеСредство");
	Запрос = Новый Запрос;
	Если ВидСчета = "СчетУчета" Тогда
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОсновныеСредства.Ссылка,
		|	ЕСТЬNULL(УчетныеДанныеОбъектаОССрезПоследних.СчетУчета, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) КАК СчетУчета
		|ПОМЕСТИТЬ ОсновныеСредства
		|ИЗ
		|	Справочник.ОсновныеСредства КАК ОсновныеСредства
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних(&Период, ОсновноеСредство В (&МассивСсылок)) КАК УчетныеДанныеОбъектаОССрезПоследних
		|		ПО (УчетныеДанныеОбъектаОССрезПоследних.ОсновноеСредство = ОсновныеСредства.Ссылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЕПСБУ.Ссылка КАК Счет,
		|	ЕПСБУ.УчетПоКПС,
		|	ОсновныеСредства.Ссылка КАК ОсновноеСредство
		|ИЗ
		|	ОсновныеСредства КАК ОсновныеСредства
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|		ПО ОсновныеСредства.СчетУчета = ЕПСБУ.Ссылка"
	Иначе
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОсновныеСредства.Ссылка,
		|	ЕСТЬNULL(УчетныеДанныеОбъектаОССрезПоследних.СчетУчета, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) КАК СчетУчета
		|ПОМЕСТИТЬ ОсновныеСредства
		|ИЗ
		|	Справочник.ОсновныеСредства КАК ОсновныеСредства
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних(&Период, ОсновноеСредство В (&МассивСсылок)) КАК УчетныеДанныеОбъектаОССрезПоследних
		|		ПО (УчетныеДанныеОбъектаОССрезПоследних.ОсновноеСредство = ОсновныеСредства.Ссылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ЕПСБУ.Ссылка КАК Счет,
		|	ЕПСБУ.УчетПоКПС КАК УчетПоКПС,
		|	ОсновныеСредства.Ссылка КАК ОсновноеСредство
		|ИЗ
		|	ОсновныеСредства КАК ОсновныеСредства
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеСчетовОС КАК СоответствиеСчетовОС
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|			ПО СоответствиеСчетовОС.ЗабалансовыйСчет = ЕПСБУ.Ссылка
		|		ПО ОсновныеСредства.СчетУчета = СоответствиеСчетовОС.СчетОС"
	КонецЕсли;
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("МассивСсылок", МассивСсылок);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции // ПолучитьСчетаУчетаОСпоТаблицеДокумента()

// Инициализирует таблицу значений для передачи ОС для расчета остатков
//
Функция ПустаяТаблицаОСДляРасчетаОстатков()
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	ПустаяТаблица.Колонки.Добавить("ОсновноеСредство"	, Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ПустаяТаблица.Колонки.Добавить("ИнвентарныйНомер"	, Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	ПустаяТаблица.Колонки.Добавить("КПС"				, Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("КФО"				, Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("Количество"			, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,3)));
	ПустаяТаблица.Колонки.Добавить("Цена"				, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18,2)));
	ПустаяТаблица.Колонки.Добавить("Сумма"				, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18,2)));
	
	Возврат ПустаяТаблица;
	
КонецФункции

Процедура ПолучитьРеквизитыОсновногоСредства(ТекущаяСтрока, ДополнительныеРеквизиты)
	Если ДополнительныеРеквизиты = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекущаяСтрока.ОсновноеСредство, ДополнительныеРеквизиты);
	ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ЗначенияРеквизитов);
КонецПроцедуры

Процедура ВывестиОшибкуПроверкиТаблицыОС(Выборка, КодОшибки, ПервыйПредел)
	ТекстОшибки = "";
	ИмяПоля = "";
	Если КодОшибки = 1 Тогда
		ТекстОшибки = НСтр("ru='Для объектов с заданными инвентарным номером количество должно быть 1.'");
		ИмяПоля = "Количество";
	ИначеЕсли КодОшибки = 2 Тогда
		ТекстОшибки = НСтр("ru='Для зданий не должен быть установлен признак группового учета'");
		ИмяПоля = "ОсновноеСредство";
	ИначеЕсли КодОшибки = 3 Тогда
		ТекстОшибки = НСтр("ru='Для библиотечного фонда не должен указываться инвентарный номер'");
		ИмяПоля = "ИнвентарныйНомер";
	ИначеЕсли КодОшибки = 4 Тогда
		ТекстОшибки = НСтр("ru='Для объектов стоимостью более " + Формат(ПервыйПредел, "ЧГ=") + " необходимо указать инвентарный номер'");
		ИмяПоля = "ИнвентарныйНомер";
	КонецЕсли;
	Если ТекстОшибки<>"" Тогда
		Если Выборка.НомерСтроки = 0 Тогда
			ТекстИмяПоля = "Объект."+ИмяПоля;
		Иначе
			ТекстИмяПоля = "ОсновныеСредства["+(Выборка.НомерСтроки-1)+"]."+ИмяПоля;
		КонецЕсли;
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки,,ИмяПоля);
	КонецЕсли;
КонецПроцедуры

// Получает суммы амортизации и обесценения для объектов вложений ОС
//
// Параметры:
//  ПараметрыОстатков - Структура - параметры для получения данных
//  	Ключи структуры:
//    * Дата - Дата - Дата документа
//    * Организация - СправочникСсылка.Организации
//    * Подразделение - СправочникСсылка.Подразделения   
//    * ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения
//    * КФО - ПеречислениеСсылка.КВД
//    * ОбъектВложений - СправочникСсылка.ОсновныеСредства
//    * СчетВложений - ПланСчетовСсылка.ЕПСБУ - счет вложений
//    * ПериодОстатков - Дата - дата получения остатков
//
//	Возвращаемое значение:
//   Структура:
//     * СуммаАмортизации - Число
//     * СуммаОбесценения - Число
Функция ОтраженныеСуммыПогашенияСтоимости(ПараметрыОстатков)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период"				, ПараметрыОстатков.Дата);
	Запрос.УстановитьПараметр("Организация"			, ПараметрыОстатков.Организация);
	Запрос.УстановитьПараметр("ОсновноеСредство"	, ПараметрыОстатков.ОбъектВложений);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	АмортизацияОбъектовОСОстатки.СуммаАмортизацииОстаток КАК СуммаАмортизации,
	|	АмортизацияОбъектовОСОстатки.СуммаОбесцененияОстаток КАК СуммаОбесценения
	|ИЗ
	|	РегистрНакопления.АмортизацияОбъектовОС.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство = &ОсновноеСредство) КАК АмортизацияОбъектовОСОстатки";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Новый Структура("СуммаАмортизации,СуммаОбесценения", 0, 0);
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

#КонецОбласти

#КонецОбласти

#Область УстаревшиеПроцедурыИФункции

// Устарела. Подготавливает таблицу документа (в унифицированном формате) для учета реализации ОС, НМА, НПА.
//
Функция ПодготовитьТаблицуРеализацияИмуществаКазныПоДокументу(Документ, Параметры = Неопределено) Экспорт
	
	ТаблицаДокумента = ПустаяТаблицаРеализацияОсновныхСредствПоДокументу();
	
	Если Параметры = Неопределено Тогда
		Параметры = Новый Структура;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	МетаданныеДокумента = Документ.Метаданные();
		
		Параметры.Вставить("ВалютаДокумента", Константы.ВалютаРегламентированногоУчета.Получить());
		
		
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "ОсновныеСредства",
			"НомерСтроки,ИФО,КФО,КПС,Подразделение,Контрагент,Договор,ВалютаДокумента,
			|ОсновноеСредство,ИнвентарныйНомер,Количество,Сумма,Всего,СтавкаНДС,СуммаНДС",
			Документ, Параметры);
		
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	""ОсновныеСредства"" КАК ИмяСписка,
		|	""Основные cредства"" КАК СинонимСписка,
		|	ОсновныеСредства.НомерСтроки КАК НомерСтроки,
		|	ОсновныеСредства.ИФО КАК ИФО,
		|	ОсновныеСредства.КФО КАК КФО,
		|	ОсновныеСредства.КПС КАК КПС,
		|	ОсновныеСредства.Подразделение КАК Подразделение,
		|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
		|	ОсновныеСредства.ОсновноеСредство.ВидНФА КАК ВидНФА,
		|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	ОсновныеСредства.Контрагент КАК Контрагент,
		|	ОсновныеСредства.Договор КАК Договор,
		|	ОсновныеСредства.ВалютаДокумента КАК Валюта,
		|	ОсновныеСредства.Количество КАК Количество,
		|	ОсновныеСредства.Всего КАК Сумма,
		|	ОсновныеСредства.СтавкаНДС КАК СтавкаНДС,
		|	ОсновныеСредства.СуммаНДС КАК СуммаНДС
		|ИЗ
		|	ТаблицаОсновныеСредства КАК ОсновныеСредства
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
	
	РеализацияОсновныхСредств = Запрос.Выполнить().Выгрузить();
	
	// Счет расчетов.
	СчетРасчетов = УчетРасчетов.ОпределитьСчетРасчетовПоПараметрам(Параметры, "Реализация",
		Документ.Дата, Документ.Организация, Документ.ИФО);
	
	// В документах реализации в таб.части указан КПС расходов.
	// Для расчетов должен использоваться КПС доходов (если указан).
	ИспользоватьКПСРасчетов = Параметры.Свойство("КПС") И ЗначениеЗаполнено(Параметры.КПС);
	
	Для Каждого Строка Из РеализацияОсновныхСредств Цикл
		
		НоваяСтрока = ТаблицаДокумента.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
		Если ЗначениеЗаполнено(СчетРасчетов) Тогда
			НоваяСтрока.СчетРасчетов = СчетРасчетов;
		ИначеЕсли Строка.ВидНФА = Перечисления.ВидыНФА.НПА Тогда
			НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.СчетПоКоду("205.73", Документ.Дата, Документ.Организация);
		ИначеЕсли Строка.ВидНФА = Перечисления.ВидыНФА.НМА Тогда
			НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.СчетПоКоду("205.72", Документ.Дата, Документ.Организация);
		Иначе
			НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.СчетПоКоду("205.71", Документ.Дата, Документ.Организация);
		КонецЕсли;
		
		Если ИспользоватьКПСРасчетов Тогда
			НоваяСтрока.КПС = Параметры.КПС;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаДокумента;
	
КонецФункции

// Оставлена для совместимости с ранним программным интерфейсом и типовыми операциями.
//
Функция ПолучитьСчетаУчетаОС(ОсновноеСредство, Период = Неопределено) Экспорт
	
	СчетУчетаОС = УправлениеОсновнымиСредствами.СчетУчетаОС(ОсновноеСредство, Период);
	Возврат УправлениеОсновнымиСредствами.ВсеСчетаУчетаОС(СчетУчетаОС);
	
КонецФункции

Функция ЗначенияОбязательныхРеквизитовОС(ОсновноеСредство, Период) Экспорт

	Если ЗначениеЗаполнено(ОсновноеСредство) Тогда
		СтруктураДанныхОС = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОсновноеСредство, "ВидНФА,КодОКОФ,АмортизационнаяГруппа,ГрупповойУчет");
		СчетУчета = УправлениеОсновнымиСредствами.СчетУчетаОС(ОсновноеСредство, Период);
		СтруктураДанныхОС.Вставить("СчетУчета",СчетУчета);
		Возврат СтруктураДанныхОС;
	Иначе
		Возврат Новый Структура("ВидНФА,СчетУчета,КодОКОФ,АмортизационнаяГруппа,ГрупповойУчет");
	КонецЕсли;

КонецФункции

Процедура ПолучитьДанныеОС(Объект, Параметры) Экспорт
    Перем СчетУчета;
	
	Если ЗначениеЗаполнено(Параметры.ДанныеОбъекта) Тогда
		ТребуемыеДанные = "";
		Для каждого КлючИЗначение Из Параметры.ДанныеОбъекта Цикл
			ТребуемыеДанные = ТребуемыеДанные + "," + КлючИЗначение.Ключ;
		КонецЦикла; 
		Данные = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Параметры.ОсновноеСредство, Сред(ТребуемыеДанные, 2));
		Для каждого КлючИЗначение Из Параметры.ДанныеОбъекта Цикл
			Данные.Свойство(КлючИЗначение.Ключ, Объект[КлючИЗначение.Значение]);
		КонецЦикла; 
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьДанныеОбъектовОС(Объекты, ИменаКолонок, КолонкаСчета = Неопределено) Экспорт

	МассивИменКолонок = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ИменаКолонок);
	Если ЗначениеЗаполнено(КолонкаСчета) Тогда
		ТекстЗапроса = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ОсновныеСредства.Ссылка";
		Для каждого ИмяКолонки Из МассивИменКолонок Цикл
				Если СокрЛ(ИмяКолонки) = "СчетУчета" Тогда
					ТекстЗапроса = ТекстЗапроса + ",
					|	УчетныеДанныеОбъектаОССрезПоследних." + СокрЛ(ИмяКолонки);
				ИначеЕсли Лев(СокрЛ(ИмяКолонки), 10) = "СчетУчета." Тогда
					
				Иначе	
					ТекстЗапроса = ТекстЗапроса + ",
					|	ОсновныеСредства." + СокрЛ(ИмяКолонки);
				Конецесли;
		КонецЦикла; 
		ТекстЗапроса = ТекстЗапроса + "
				|ПОМЕСТИТЬ ОС
				|ИЗ
				|	Справочник.ОсновныеСредства КАК ОсновныеСредства
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних КАК УчетныеДанныеОбъектаОССрезПоследних
				|		ПО (УчетныеДанныеОбъектаОССрезПоследних.ОсновноеСредство = ОсновныеСредства.Ссылка)
				|ГДЕ
				|	ОсновныеСредства.Ссылка В(&МассивОбъектов)
				|;";
		ТекстЗапроса = ТекстЗапроса + "
				|ВЫБРАТЬ
				|	ОС.Ссылка";
		Для каждого ИмяКолонки Из МассивИменКолонок Цикл
			Если Лев(СокрЛ(ИмяКолонки), 10) = "СчетУчета." Тогда
				ТекстЗапроса = ТекстЗапроса + ",
				|	СоответствиеСчетовОС." + КолонкаСчета + "." + Сред(СокрЛ(ИмяКолонки), 11) + " Как " + Сред(СокрЛ(ИмяКолонки), 11);
			ИначеЕсли СокрЛ(ИмяКолонки) = "СчетУчета" Тогда
				ТекстЗапроса = ТекстЗапроса + ",
				|	СоответствиеСчетовОС." + КолонкаСчета + " Как СчетУчета";
			Иначе
				ТекстЗапроса = ТекстЗапроса + ",
				|	ОС." + СокрЛ(ИмяКолонки);
			КонецЕсли;
		КонецЦикла;
		
		ТекстЗапроса = ТекстЗапроса + "
				|ИЗ
				|	ОС КАК ОС
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеСчетовОС КАК СоответствиеСчетовОС
				|		ПО (ОС.СчетУчета = СоответствиеСчетовОС.СчетОС)";
	Иначе
		ТекстЗапроса = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	ОсновныеСредства.Ссылка";
		Для каждого ИмяКолонки Из МассивИменКолонок Цикл
		
			Если Лев(СокрЛ(ИмяКолонки), 10) = "СчетУчета." Тогда
				ТекстЗапроса = ТекстЗапроса + ",
				|	УчетныеДанныеОбъектаОССрезПоследних.СчетУчета." + Сред(СокрЛ(ИмяКолонки), 11) + " Как " + Сред(СокрЛ(ИмяКолонки), 11);
			Иначе
				Если СокрЛ(ИмяКолонки) = "СчетУчета" Тогда
					ТекстЗапроса = ТекстЗапроса + ",
					|	УчетныеДанныеОбъектаОССрезПоследних." + СокрЛ(ИмяКолонки);
				Иначе	
					ТекстЗапроса = ТекстЗапроса + ",
					|	ОсновныеСредства." + СокрЛ(ИмяКолонки);
				Конецесли;
			КонецЕсли;
		
		КонецЦикла; 
		ТекстЗапроса = ТекстЗапроса + "
				|ИЗ
				|	Справочник.ОсновныеСредства КАК ОсновныеСредства
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних КАК УчетныеДанныеОбъектаОССрезПоследних
				|		ПО (УчетныеДанныеОбъектаОССрезПоследних.ОсновноеСредство = ОсновныеСредства.Ссылка)
				|ГДЕ
				|	ОсновныеСредства.Ссылка В(&МассивОбъектов)";
	КонецЕсли;
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("МассивОбъектов", Объекты);
	
	ИменаКолонок = "";
	Для каждого ИмяКолонки Из МассивИменКолонок Цикл
		Если Найти(ИмяКолонки, ".") > 0 Тогда
			ИменаКолонок = ИменаКолонок + "," + Сред(ИмяКолонки, Найти(ИмяКолонки, ".") + 1);
		Иначе
			ИменаКолонок = ИменаКолонок + "," + ИмяКолонки;
		КонецЕсли;
	КонецЦикла;
	ИменаКолонок = Сред(ИменаКолонок, 2);
    Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Процедура УстановитьДинамическиеКолонкиВТаблицеОсновныхСредствДокумента(Объект, ИменаКолонок, КолонкаСчета = "") Экспорт
	
	МассивОбъектов = Объект.ОсновныеСредства.Выгрузить().ВыгрузитьКолонку("ОсновноеСредство");
	ДанныеОбъектов = ПолучитьДанныеОбъектовОС(МассивОбъектов, ИменаКолонок, КолонкаСчета);
	
	Для каждого ТекСтр Из Объект.ОсновныеСредства Цикл
		
		ТекОбъект = ДанныеОбъектов.НайтиСтроки(Новый Структура("Ссылка", ТекСтр.ОсновноеСредство));
		Если ТекОбъект.Количество() > 0 Тогда
			ЗаполнитьЗначенияСвойств(ТекСтр, ТекОбъект[0], ИменаКолонок);
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

