Процедура ЗаполнитьОтборБаланса(ЭлементФормы_Баланс, СписокБалансов) Экспорт
	ЭлементФормы_Баланс.СписокВыбора = СписокБалансов;
КонецПроцедуры	

Процедура УстановитьЗначениеВСпискеБалансов(ЭлементФормы_Баланс, БалансОтбор, УчитыватьБаланс) Экспорт
	Если НЕ ЗначениеЗаполнено(БалансОтбор) И НЕ УчитыватьБаланс Тогда
		ЭлементФормы_Баланс.Значение = ЭлементФормы_Баланс.СписокВыбора[0].Значение;
	ИначеЕсли НЕ ЗначениеЗаполнено(БалансОтбор) И УчитыватьБаланс Тогда
		ЭлементФормы_Баланс.Значение = ЭлементФормы_Баланс.СписокВыбора[1].Значение;
	Иначе	
		ЭлементФормы_Баланс.Значение = ЭлементФормы_Баланс.СписокВыбора.НайтиПоЗначению(БалансОтбор).Значение;
	КонецЕсли;	
КонецПроцедуры	

Процедура УстановитьБалансПоЗначениюСписка(ЭлементФормы_Баланс, БалансОтбор, УчитыватьБаланс) Экспорт
	Если ЭлементФормы_Баланс.Значение = Неопределено Тогда
		БалансОтбор = "";
		УчитыватьБаланс = Ложь;
	Иначе
		БалансОтбор = ЭлементФормы_Баланс.Значение;
		УчитыватьБаланс = Истина;
	КонецЕсли;	
КонецПроцедуры	

