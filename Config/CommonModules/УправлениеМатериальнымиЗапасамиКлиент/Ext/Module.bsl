Процедура ОткрытьПодборМатериалов(Форма, Объект, ДополнительныйПараметр = Неопределено, ПараметрыОтбора = Неопределено, ПараметрыТчИсточника = Неопределено) Экспорт

	Параметры = УправлениеМатериальнымиЗапасамиКлиентСервер.ПараметрыОткрытияФормыПодбора();
	
	ДатаРасчетов = ?(НачалоДня(Объект.Дата) = НачалоДня(ОбщегоНазначенияКлиент.ДатаСеанса()) И Объект.Ссылка.Пустая(), Неопределено, Объект.Дата);
	Параметры.ДатаРасчетов = ДатаРасчетов;
	Если Объект.Свойство("ИФО") Тогда
		Параметры.ИФО = Объект.ИФО;
	КонецЕсли;
	Параметры.Организация = Объект.Организация;
	Параметры.ДокументСсылка = Объект.Ссылка;   
	
	Если ТипЗнч(ПараметрыОтбора) = Тип("Структура") Тогда 
		Для Каждого КлючИЗначение Из ПараметрыОтбора Цикл
			Параметры.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
	Иначе
		Форма.ДополнитьСтруктуруПодбора(Параметры, ДополнительныйПараметр);
	КонецЕсли;
	
	Если НЕ Параметры.Свойство("Заголовок") Тогда
		ПредставлениеТаблицы = ?(Параметры.Свойство("ПредставлениеТаблицы"), Параметры.ПредставлениеТаблицы, Параметры.ИмяТаблицы);
		ЗаголовокПодбора = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Подбор номенклатуры в %1 (%2)'"), Объект.Ссылка, ПредставлениеТаблицы);
		Параметры.Вставить("Заголовок",		ЗаголовокПодбора);	
	КонецЕсли;
	
	Если ЭтоПодборУстаревшегоСчета106(Объект, Параметры) Тогда
		ИмяФормыПодбора = "Обработка.ПодборНоменклатуры.Форма.ФормаПодбораСтарая";
	Иначе
		ИмяФормыПодбора = "Обработка.ПодборНоменклатуры.Форма.ФормаПодбора";
	КонецЕсли;
	
	Если ПараметрыТчИсточника <> Неопределено Тогда
		Параметры.Вставить("ПараметрыТчИсточника",ПараметрыТчИсточника);
	КонецЕсли;
	
	ОценкаПроизводительностиКлиент.ЗамерВремени("ОткрытиеФормыПодборНоменклатуры");
	ОткрытьФорму(ИмяФормыПодбора, Параметры, Форма, Форма.УникальныйИдентификатор);

КонецПроцедуры

Процедура ОткрытьПодборМатериаловРасширенный(Форма, Объект, ДополнительныйПараметр = Неопределено, ПараметрыОтбора = Неопределено, ПараметрыТчИсточника = Неопределено) Экспорт

	Параметры = Новый Структура;
	
	ДатаРасчетов 	 = ?(НачалоДня(Объект.Дата) = НачалоДня(ТекущаяДата()), Неопределено, Объект.Дата);
	Параметры.Вставить("ДатаРасчетов",	ДатаРасчетов);
	Если Объект.Свойство("ИФО") Тогда
		Параметры.Вставить("ИФО",		Объект.ИФО);
	КонецЕсли;
	Параметры.Вставить("Организация",	Объект.Организация);
	Параметры.Вставить("ДокументСсылка",Объект.Ссылка);
	Параметры.Вставить("РасширенныйПодборНоменклатуры",	Истина);
	Если Объект.Свойство("МОЛ") Тогда
		Параметры.Вставить("СотрудникОтбора",	Объект.МОЛ);
	Иначе	
		Параметры.Вставить("СотрудникОтбора",	Неопределено);
	КонецЕсли;
	
	Если ТипЗнч(ПараметрыОтбора) = Тип("Структура") Тогда 
		Для Каждого КлючИЗначение Из ПараметрыОтбора Цикл
			Параметры.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
	Иначе
		Форма.ДополнитьСтруктуруПодбора(Параметры, ДополнительныйПараметр);
	КонецЕсли;
	
	Если НЕ Параметры.Свойство("Заголовок") Тогда
		ПредставлениеТаблицы = ?(Параметры.Свойство("ПредставлениеТаблицы"), Параметры.ПредставлениеТаблицы, Параметры.ИмяТаблицы);
		ЗаголовокПодбора = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Подбор номенклатуры в %1 (%2)'"), Объект.Ссылка, ПредставлениеТаблицы);
		Параметры.Вставить("Заголовок",		ЗаголовокПодбора);	
	КонецЕсли;
	
	Если ПараметрыТчИсточника <> Неопределено Тогда
		Параметры.Вставить("ПараметрыТчИсточника",ПараметрыТчИсточника);
	КонецЕсли;
	
	ОценкаПроизводительностиКлиент.ЗамерВремени("ОткрытиеФормыПодборНоменклатуры");
	ОткрытьФорму("Обработка.ПодборНоменклатуры.Форма.ФормаПодбора", Параметры, Форма, Форма.УникальныйИдентификатор);

КонецПроцедуры

// Проверяет, что источник выбора - это форма подбора номенклатуры
//
// Параметры:
//  ИсточникВыбора	 - Произвольный - параметр ИсточникВыбора обработчика "ОбработкаВыбора"
// 
// Возвращаемое значение:
// Булево - 
//
Функция ОбработкаВыбораИзПодбораМЗ(ИсточникВыбора) Экспорт
	Возврат ИсточникВыбора.ИмяФормы = "Обработка.ПодборНоменклатуры.Форма.ФормаПодбора";
КонецФункции

Процедура УстановитьСчетУчетПоНоменклатуреВСтрокеМатериалов(ТекущиеДанные, Объект, СчетУчета) Экспорт
	
	Если ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) Тогда
		Если СчетУчета = Неопределено ИЛИ СчетУчета = БухгалтерскийУчетКлиентСервер.СчетПоКоду("105.00", Неопределено) Тогда
			ТекущиеДанные.СчетУчета = УправлениеМатериальнымиЗапасамиВызовСервера.СчетУчетаНоменклатуры(ТекущиеДанные.Номенклатура);
		Иначе
			ТекущиеДанные.СчетУчета = СчетУчета;
		КонецЕсли;
	Иначе
		ТекущиеДанные.СчетУчета = Неопределено;
	КонецЕсли;

КонецПроцедуры

Процедура ПриИзмененииНастройкиИспользованияКФО(Параметры) Экспорт
	
	Форма = Параметры.Форма;
	Объект = Форма.Объект;
	
	Если Объект.КФОВТабличнойЧасти Тогда
		Если ЗначениеЗаполнено(Объект.КФО) Тогда
			ВыполнитьОбработкуОповещения(Параметры.ОбработчикЗаполненияКФО);
			Объект.КФО = ПредопределенноеЗначение("Перечисление.КВД.ПустаяСсылка");
		КонецЕсли;
	Иначе
		ВыполнитьОбработкуОповещения(Параметры.ОбработчикПроверкиКФО);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьКФОШапкиПриИзмененииНастройкиИспользования(Форма, МассивКФО) Экспорт
	
	Если МассивКФО.Количество() = 1 Тогда
		Форма.Объект.КФО = МассивКФО[0];
	КонецЕсли

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция МаскаПорядковогоНомера(Знач ДлинаНомера)
	
	Если ДлинаНомера = 0 Тогда
		ДлинаНомера = ОбщегоНазначенияБГУКлиентСервер.МаксимальнаяДлинаНомераБСО();
	Иначе
		ДлинаНомера = Мин(ДлинаНомера, ОбщегоНазначенияБГУКлиентСервер.МаксимальнаяДлинаНомераБСО());	
	КонецЕсли;
	
	Маска = "";
	Для к = 1 по ДлинаНомера Цикл
		Маска = Маска + "9";
	КонецЦикла;	
	
	Возврат Маска;
	
КонецФункции

Функция ЭтоПодборУстаревшегоСчета106(Объект, Параметры)
	
	ЭтоПодборСчета106 = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "ЭтоПодборСчета106", Ложь);
	
	Возврат ЭтоПодборСчета106 И Объект.Дата < '20210101';
	
КонецФункции

Функция ОграничениеВыбораСчетовИзДокумента(Форма, Элемент, СчетУчета, ТипНоменклатуры = Неопределено)

	ОграниченияСписокСчетов = Новый СписокЗначений;
	
	Если ИспользоватьРеквизитВсеСчета105(Форма, СчетУчета) Тогда
		Если ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.БиологическиеАктивы")
			И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "ВсеСчета113") Тогда
			Возврат Форма.ВсеСчета113;
		Иначе
			Возврат Форма.ВсеСчета105;
		КонецЕсли;
	ИначеЕсли ИспользоватьРеквизитВсеСчета106(Форма, СчетУчета) Тогда
		Возврат Форма.ВсеСчета106;
	Иначе
		ОграниченияСписокСчетов = ОграничениеВыбораСчетовИзЭлемента(Форма, Элемент);
		Если ОграниченияСписокСчетов.Количество() > 0 Тогда
			Возврат ОграниченияСписокСчетов;
		Иначе
			Возврат СчетУчета;
		КонецЕсли;
	КонецЕсли;

КонецФункции

Функция ИспользоватьРеквизитВсеСчета105(Форма, СчетУчета)
	СчетИзФормы = ОбщегоНазначенияБГУКлиентСервер.СвойствоЛокальногоКэшаФормы(Форма, "Счет105", "105.00");
	Возврат ИспользоватьРеквизитСписокСчетов(Форма, "ВсеСчета105", СчетУчета, СчетИзФормы);
КонецФункции

Функция ИспользоватьРеквизитВсеСчета106(Форма, СчетУчета)
	СчетИзФормы = ОбщегоНазначенияБГУКлиентСервер.СвойствоЛокальногоКэшаФормы(Форма, "Счет106", "106.00");
	Возврат ИспользоватьРеквизитСписокСчетов(Форма, "ВсеСчета106", СчетУчета, СчетИзФормы);
КонецФункции

Функция ИспользоватьРеквизитСписокСчетов(Форма, ИмяРеквизита, СчетУчета, Знач ТребуемыйСчет)
	Если НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, ИмяРеквизита)
		ИЛИ Форма[ИмяРеквизита].Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(ТребуемыйСчет) = Тип("Строка") Тогда
		ТребуемыйСчет = БухгалтерскийУчетВызовСервера.СчетПоКоду(ТребуемыйСчет);
	КонецЕсли;
	
	Возврат СчетУчета = Неопределено ИЛИ СчетУчета = ТребуемыйСчет; 
КонецФункции

Функция ОграничениеВыбораСчетовИзЭлемента(Форма, Элемент)
	ПараметрыВыбора = Неопределено;
	Если СтрЗаканчиваетсяНа(Элемент.Имя, "СчетУчета") Тогда
		ПараметрыВыбора = Элемент.ПараметрыВыбора;
	Иначе
		Таблица = ОбщегоНазначенияБГУКлиентСервер.РодительскийЭлементЗаданногоТипа(Элемент, Тип("ТаблицаФормы"));
		Если Таблица <> Неопределено Тогда
			ЭлементСчет = Форма.Элементы.Найти(Таблица.Имя + "СчетУчета");
			Если ЭлементСчет <> Неопределено Тогда
				ПараметрыВыбора = ЭлементСчет.ПараметрыВыбора;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ПараметрыВыбора = Неопределено Тогда
		Возврат Новый СписокЗначений;
	КонецЕсли;
	
	ОграниченияСписокСчетов = Новый СписокЗначений;
	Для каждого ПараметрВыбора Из ПараметрыВыбора Цикл
	
		Если ПараметрВыбора.Имя = "ОграниченияСписокСчетов" Тогда
			ОграниченияСписокСчетов.ЗагрузитьЗначения(Новый Массив(ПараметрВыбора.Значение));
		КонецЕсли;
	
	КонецЦикла;

	Возврат ОграниченияСписокСчетов;
	
КонецФункции

#КонецОбласти
