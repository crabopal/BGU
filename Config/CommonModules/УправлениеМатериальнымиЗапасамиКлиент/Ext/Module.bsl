#Область СлужебныйПрограммныйИнтерфейс

//Вызывается при выборе номенклатуры в табличную часть. Процедура проверяет, если вводится
// не первая строка в табличную часть, то окрывает форму выбора номенклатуры с установленным
// начальным значением выбора. Начальное значение выбора берется из предыдущей строки.
// Такое поведение программы, позволяет открывать справочник "Номенклатура" в той же группе, в которой
// был произведен предыдущий выбор.
//
// Параметры:
// ТабПоле - ТаблицаФормы - табличное поле, которое содержит табличную часть
// Элемент - ПолеВвода - поле ввода, в которое производится выбор. Это будет владелец, открываемой формы
// СтандартнаяОбработка - Булево - параментр обработчика "НачалоВыбора", из которого производится вызов процедуры
Процедура ВыборНоменклатурыИзТабличнойЧастиДокументов(ТабПоле, Элемент, СтандартнаяОбработка) Экспорт
	Если ТипЗнч(Элемент.Значение) <> Тип("СправочникСсылка.Номенклатура") Тогда
		Возврат;
	КонецЕсли;	
	
	ТекущиеДанные = ТабПоле.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	ИндексСтроки = ТабПоле.Значение.Индекс(ТекущиеДанные);
	Если ИндексСтроки = 0 Тогда
		Возврат;
	ИначеЕсли ТабПоле.ТекущаяКолонка = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	СтандартнаяОбработка = Ложь;
	ФормаВыбора = Элемент.Значение.ПолучитьФормуВыбора(, Элемент);
	
	НачальноеЗначениеВыбора = ?(ЗначениеЗаполнено(Элемент.Значение), Элемент.Значение, ТабПоле.Значение[ИндексСтроки-1][ТабПоле.ТекущаяКолонка.Имя]);
	ФормаВыбора.НачальноеЗначениеВыбора = НачальноеЗначениеВыбора;
	
	ФормаВыбора.Открыть();
КонецПроцедуры

Процедура УстановитьКомиссиюВДокументМЗ(КомиссияСсылка, Объект, Форма, НомерПриказа=Неопределено, ДатаПриказа = Неопределено) Экспорт
    Объект.СоставКомиссии.Очистить();
	Объект.ДолжностьПредседательКомиссии	= "";	
	Объект.ФамилияПредседательКомиссии	    = "";
	Объект.ИмяПредседательКомиссии	        = "";
	Объект.ОтчествоПредседательКомиссии	    = "";
	НомерПриказа						= "";
	ДатаПриказа						= Дата('00010101');
	
	ТекущаяКомиссия = ОбщегоНазначенияБГУВызовСервера.ПолучитьДанныеКомиссии(КомиссияСсылка, Объект.Дата);
	НомерПриказа	= ТекущаяКомиссия.НомерПриказа;
	ДатаПриказа		= ТекущаяКомиссия.ДатаПриказа;
	ДанныеКомиссии	= ТекущаяКомиссия.ДанныеКомиссии;
	Для каждого ТекСтрокаКомиссии Из ДанныеКомиссии Цикл
		
		Если ТекСтрокаКомиссии.Председатель Тогда
			Объект.ДолжностьПредседательКомиссии	= ТекСтрокаКомиссии.ДолжностьЧленаКомиссии;	
			Объект.ФамилияПредседательКомиссии	    = ТекСтрокаКомиссии.ФамилияЧленаКомиссии;
			Объект.ИмяПредседательКомиссии	        = ТекСтрокаКомиссии.ИмяЧленаКомиссии;
			Объект.ОтчествоПредседательКомиссии	    = ТекСтрокаКомиссии.ОтчествоЧленаКомиссии;
		Иначе
			ЗаполнитьЗначенияСвойств(Объект.СоставКомиссии.Добавить(), ТекСтрокаКомиссии);
		КонецЕсли;			
	
	КонецЦикла; 
    Форма.Модифицированность = Истина;
КонецПроцедуры

// Используется в событии ОбработкаВыбора реквизита шапки "Счет учета". Задается вопрос об очистке таблицы "Материалы".
// В зависимости от ответа либо будет отмена выбора, либо изменение значения.
// ВНИМАНИЕ!!! Событие ПриИзменении в любом случае не произойдет. Если требуется выполнить действие при изменении, то его следует
// передать как объект "ОписаниеОповещение" в параметр "ДействиеПриИзменении".
//
// Параметры:
//	ВыбранноеЗначение - Произвольный - выбранное значение (пробрасывается из вызывающего обработчика),
//	СтандартнаяОбработка - Булево - флаг стандартной обработки (пробрасывается из вызывающего обработчика),
//	Форма - ФормаКлиентскогоПриложения - форма, из которой вызывается процедура,
//	ДействиеПриИзменении - ОписаниеОповещения - после выбора значения будет выполнена обработка оповещения.
//
Процедура НачатьОбработкуВыбораСчетаУчета(ВыбранноеЗначение, СтандартнаяОбработка, Форма, ДействиеПриИзменении = Неопределено) Экспорт

	СтандартнаяОбработка = Ложь;
	Объект = Форма.Объект;
	
	Если ВыбранноеЗначение <> Объект.СчетУчета И Объект.Материалы.Количество() > 0 Тогда
		
		ТекстВопроса = НСтр("ru = 'При изменении счета учета будет очищена таблица ""Материалы"".
								|Изменить счет учета?'");
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Изменить счет учета и очистить таблицу ""Материалы""'"));
		Кнопки.Добавить(КодВозвратаДиалога.Нет, НСтр("ru = 'Не изменять счет учета'"));
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Форма", Форма);
		ДополнительныеПараметры.Вставить("ВыбранноеЗначение", ВыбранноеЗначение);
		ДополнительныеПараметры.Вставить("ДействиеПриИзменении", ДействиеПриИзменении);
		
		Оповещение = Новый ОписаниеОповещения("ОбработкаВыбораСчетаУчетаЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, Кнопки, 20,КодВозвратаДиалога.Нет);
		
		Возврат;
		
	КонецЕсли;
	
	Объект.СчетУчета = ВыбранноеЗначение;
	Форма.Модифицированность = Истина;
	
	Если ДействиеПриИзменении <> Неопределено Тогда
		ВыполнитьОбработкуОповещения(ДействиеПриИзменении);
	КонецЕсли;

КонецПроцедуры

// Завершающая процедура асинхронной процедуры НачатьОбработкуВыбораСчетаУчета
// 
// Параметры:
//  РезультатВопроса - КодВозвратаДиалога
//  ДополнительныеПараметры - Структура:
//  * Форма - ФормаКлиентскогоПриложения
//  * ВыбранноеЗначение - ПланСчетовСсылка.ЕПСБУ
//  * ДействиеПриИзменении - ОписаниеОповещения
Процедура ОбработкаВыбораСчетаУчетаЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Форма = ДополнительныеПараметры.Форма;
	Объект = Форма.Объект;
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Объект.СчетУчета = ДополнительныеПараметры.ВыбранноеЗначение;
	Объект.Материалы.Очистить();
	Форма.Модифицированность = Истина;
	
	Если ДополнительныеПараметры.ДействиеПриИзменении <> Неопределено Тогда
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ДействиеПриИзменении);
	КонецЕсли;

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ПОДСИСТЕМЫ УЧЕТА БСО	
//

// Открывает форму подбора БСО. Параметр "Отбор" инициализируется функцией ПолучитьСтруктуруПараметровПодбораБСО
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  АдресВХранилище - Строка
//  Отбор - Структура:
//  * СчетУчета - ПланСчетовСсылка.ЕПСБУ
Процедура ОткрытьПодборБСО(Форма, АдресВХранилище, Отбор) Экспорт
	
	Если ТипЗнч(Отбор) = Тип("Структура") Тогда
		Если Отбор.Свойство("ИФО") И НЕ ОбщегоНазначенияБГУВызовСервераПовтИсп.ЗначениеФункциональнойОпции("ИспользоватьУчетПоИФО") Тогда
			Отбор.Удалить("ИФО");
		КонецЕсли;
	КонецЕсли;
	Объект = Форма.Объект;
	
	ПараметрыФормы = Новый Структура("Отбор, ДатаОстатков, АдресВХранилище", Отбор, ?(Объект.Ссылка.Пустая(), КонецДня(Объект.Дата), Объект.Дата), АдресВХранилище);
	ПараметрыФормы.Вставить("Организация", Объект.Организация);
	Если ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ВнутреннееПеремещениеБСО") Тогда
		ПараметрыФормы.Вставить("ЦМО", Объект.ЦМООтправитель);
		ПараметрыФормы.Вставить("Подразделение", Объект.ПодразделениеОтправитель);
	Иначе
		ПараметрыФормы.Вставить("ЦМО", Объект.ЦМО);
		ПараметрыФормы.Вставить("Подразделение", Объект.Подразделение);
	КонецЕсли;		
	ПараметрыФормы.Вставить("ИФО", Объект.ИФО);
	ПараметрыФормы.Вставить("КФО", Объект.КФО);
	ПараметрыФормы.Вставить("СчетУчета", Отбор.СчетУчета);
    ОткрытьФорму("Справочник.БСО.Форма.ФормаПодбора", ПараметрыФормы, Форма);
КонецПроцедуры

// Возвращает структуру для заполнения параметров для передачи в форму подбора БСО в процедуре ОткрытьПодборБСО
// 
// Возвращаемое значение:
//  Структура - Получить структуру параметров подбора БСО:
// * ТолькоИмеющиеОстатки - Булево - 
// * Организация
// * ЦМО 
// * КФО 
// * ИФО 
// * СчетУчета 
Функция ПолучитьСтруктуруПараметровПодбораБСО() Экспорт

	ОтборПодбора = Новый Структура("ТолькоИмеющиеОстатки, Организация, ЦМО, КФО, ИФО, СчетУчета", Истина);
	Возврат ОтборПодбора;

КонецФункции // ПолучитьСтруктуруПараметровПодбораБСО()

Процедура ОбработатьВыборБСО(ВыбранноеЗначение, ТекущиеДанные, ВыборБСООбработан) Экспорт

	Если ТипЗнч(ВыбранноеЗначение) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные.ДлинаНомера = ВыбранноеЗначение.ДлинаНомера;
	ВыбранноеЗначение = ВыбранноеЗначение.Ссылка;
	ВыборБСООбработан = Истина;

КонецПроцедуры

Процедура УстановитьМаскуПолейПорядковогоНомера(ДлинаНомера, НомерНачальный, НомерКонечный) Экспорт

	Маска = МаскаПорядковогоНомера(ДлинаНомера);
	НомерНачальный.Маска = Маска;
	НомерКонечный.Маска = Маска;

КонецПроцедуры

Процедура ОтформатироватьВведенныйНомерБСО(ТекущиеДанные, ИмяПоля, ЗаполнитьКоличество=Ложь, ИмяТабличнойЧасти = "СоставБСО") Экспорт
	
	Номер = ТекущиеДанные[ИмяПоля];
	Если НЕ ЗначениеЗаполнено(Номер) Тогда
		Возврат;
	КонецЕсли;
	Если ТекущиеДанные.ДлинаНомера <> 0 Тогда
		ДлинаНомера = ТекущиеДанные.ДлинаНомера;
	Иначе
		ДлинаНомера = ОбщегоНазначенияБГУКлиентСервер.МаксимальнаяДлинаНомераБСО();
	КонецЕсли;
	
	НомерСтрокой = УправлениеМатериальнымиЗапасамиКлиентСервер.НомерБСОСтрокой(Номер, ДлинаНомера);
	ДлинаЧисла   = СтрДлина(НомерСтрокой);
	
	#Если ВебКлиент Тогда
	Если ДлинаЧисла > ДлинаНомера Тогда
		Попытка		
			НомерСтроки	= ТекущиеДанные.НомерСтроки;
		 	ОбщегоНазначенияКлиент.СообщитьПользователю(
		 		НСтр("ru='Длина введенного порядкового номера больше, чем допустимая 
					|для выбранного БСО'"),,
					"Объект." + ИмяТабличнойЧасти + "[" + НомерСтроки + "]." + ИмяПоля);
		Исключение
	 		ОбщегоНазначенияКлиент.СообщитьПользователю(
	 			НСтр("ru='Длина введенного порядкового номера больше, чем допустимая 
					|для выбранного БСО'"),,"ИмяПоля");
		КонецПопытки;
		Возврат;																
	КонецЕсли; 
	#КонецЕсли
	
	ТекущиеДанные[ИмяПоля] = НомерСтрокой;
	
	Если ЗаполнитьКоличество Тогда
		ЗаполнитьКоличествоВТЧПоНомерамБСО(ТекущиеДанные);
	КонецЕсли;
КонецПроцедуры

// Рассчитывает и заполняет реквизит "Количество" табличной части документов
// по учету БСО
//
// Параметры:
// СтрокаТЧ - СтрокаТабличнойЧасти
Процедура ЗаполнитьКоличествоВТЧПоНомерамБСО(СтрокаТЧ) Экспорт
	Если ЗначениеЗаполнено(СтрокаТЧ.НомерНачальный) И ЗначениеЗаполнено(СтрокаТЧ.НомерКонечный) Тогда
		ТипЧисло = Новый ОписаниеТипов("Число");
		НомерНЧисло = ТипЧисло.ПривестиЗначение(СтрокаТЧ.НомерНачальный);
		НомерКЧисло = ТипЧисло.ПривестиЗначение(СтрокаТЧ.НомерКонечный);
		СтрокаТЧ.Количество = НомерКЧисло - НомерНЧисло + 1;
	ИначеЕсли НЕ ЗначениеЗаполнено(СтрокаТЧ.НомерНачальный) И НЕ ЗначениеЗаполнено(СтрокаТЧ.НомерКонечный) Тогда
		СтрокаТЧ.Количество = 0;
	Иначе	
		СтрокаТЧ.Количество = 1;
	КонецЕсли;	
КонецПроцедуры	
 
// Рассчитывает и заполняет реквизит "НомерКонечный" табличной части документов
// по учету БСО
// 
// Параметры:
// СтрокаТЧ - СтрокаТабличнойЧасти
Процедура ЗаполнитьНомерКонечныйПоНомеруНачальномуИКоличеству(СтрокаТЧ) Экспорт
	ДлинаНомера = ?(СтрокаТЧ.ДлинаНомера = 0, ОбщегоНазначенияБГУКлиентСервер.МаксимальнаяДлинаНомераБСО(), СтрокаТЧ.ДлинаНомера);
	УстановитьНомерКонечныйПоНомеруНачальномуИКоличеству(СтрокаТЧ.НомерНачальный, СтрокаТЧ.НомерКонечный, СтрокаТЧ.Количество, ДлинаНомера);
КонецПроцедуры	

// Рассчитывает и заполняет реквизит "НомерКонечный" табличной части документов
// по учету БСО
// 
// Параметры:
//  НомерНачальный - Строка - Строковое значение начального номера бланка 
//  НомерКонечный - Строка - Строковое значение конечного номера бланка
//  Количество - Число - Количество бланков
//  ДлинаНомера - Число - Длина номера
Процедура УстановитьНомерКонечныйПоНомеруНачальномуИКоличеству(НомерНачальный, НомерКонечный, Количество, ДлинаНомера) Экспорт
	Если НомерНачальный = "" Тогда
		Возврат;
	КонецЕсли;
	Если Количество <= 1 Тогда
		НомерКонечный = "";
	Иначе	
		НомерНЧисло   = Число(НомерНачальный);
		НомерКЧисло   = НомерНЧисло + Количество - 1;
		НомерКСтрокой = СформироватьСтроковыйНомерБСО(НомерКЧисло, ДлинаНомера);
		НомерКонечный = НомерКСтрокой;
	КонецЕсли;	
КонецПроцедуры	
 
// Преобразует номер БСО из числового в строковый, дополняя его нулями до длины номера,
// заданного в карточке БСО.
// 
// Параметры:
//  НомерЧислом - Число - Числовой номер БСО
//  ДлинаНомера - Число - Длина номера БСО
// 
// Возвращаемое значение:
//  Строка - Строковый номер БСО
Функция СформироватьСтроковыйНомерБСО(НомерЧислом, ДлинаНомера) Экспорт 
	НомерСтрокой = Формат(НомерЧислом, "ЧГ=0");
	ДлинаЧисла   = СтрДлина(НомерСтрокой);
	КоличествоСимволов = ДлинаНомера - ДлинаЧисла;
	Для к = 1 по КоличествоСимволов Цикл 
		НомерСтрокой = "0" + НомерСтрокой;
	КонецЦикла;	
	
	Возврат НомерСтрокой;
КонецФункции	

// Производит проверку таблицы БСО на правильность заполнения номеров БСО.
// 
// Параметры:
//  ТабБСО - ДанныеФормыКоллекция:
//  * НомерСтроки - Число
//  * НомерНачальный - Строка
//  * НомерКонечный - Строка
//  Отказ - Булево - Флаг проверки. Если Истина, то есть ошибки
//  ТекстСообщения - Строка - Текст, который вернет процедура, если обнаружит ошибки
Процедура ПроверитьПравильностьЗаполненияНомеров(ТабБСО, Отказ, ТекстСообщения = "") Экспорт
	Для каждого СтрокаБСО из ТабБСО Цикл
		Если СокрЛП(СтрокаБСО.НомерНачальный) = "" Тогда
			ТекстСообщения = "В строке """ + СтрокаБСО.НомерСтроки + """ номер начальный не заполнен";
			Отказ = Истина;
			Прервать;
		ИначеЕсли СокрЛП(СтрокаБСО.НомерКонечный) = "" Тогда
			Продолжить;
		КонецЕсли;	
		
		НомерНачальныйЧисло = Число(СтрокаБСО.НомерНачальный);
		НомерКонечныйЧисло  = Число(СтрокаБСО.НомерКонечный);
		Если НомерНачальныйЧисло > НомерКонечныйЧисло Тогда
			ТекстСообщения = "В строке """ + СтрокаБСО.НомерСтроки + """ номер начальный меньше номера конечного";
			Отказ = Истина;
			Прервать;
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры	

