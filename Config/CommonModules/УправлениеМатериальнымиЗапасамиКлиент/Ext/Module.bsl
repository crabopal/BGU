Процедура НачалоВыбораПолногоСчетаМатериалаВТаблицеДокумента(Форма, СчетУчета, Элемент, ДанныеВыбора,
	СтандартнаяОбработка) Экспорт
	
	Таблица = ОбщегоНазначенияБГУКлиентСервер.РодительскийЭлементЗаданногоТипа(Элемент, Тип("ТаблицаФормы"));
	Если Таблица = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект = Форма.Объект;
	ТекущиеДанные = Таблица.ТекущиеДанные;
	
	ТипНоменклатуры = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ТекущиеДанные, "ТипНоменклатуры");
	РеквизитыКПСиКФО = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТекущиеДанные, "КПС")
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТекущиеДанные, "КФО");
		
	Если РеквизитыКПСиКФО Тогда
		УчетПоКПС = НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТекущиеДанные, "УчетПоКПС")
			ИЛИ ТекущиеДанные.УчетПоКПС = Истина;
	КонецЕсли;
	
	Если РеквизитыКПСиКФО И УчетПоКПС Тогда
	
		ТекущийСчет = Новый Структура("Счет, КПС, КФО");
		ТекущийСчет.Счет = ТекущиеДанные.СчетУчета;
		ТекущийСчет.КПС  = ТекущиеДанные.КПС;
		ТекущийСчет.КФО  = ТекущиеДанные.КФО;
		
		ОграниченияСчетов = ОграничениеВыбораСчетовИзДокумента(Форма, Элемент, СчетУчета, ТипНоменклатуры);
		ОграниченияКПС = Новый Массив;
		ОграниченияКПС.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.АУИБУ"));
		ОграниченияКПС.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ"));
		ОграниченияКПС.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.Произвольный"));
		
		БухгалтерскийУчетКлиент.ОткрытьФормуВыбораРабочегоСчета(Элемент, СтандартнаяОбработка, ТекущийСчет,
			Объект.Организация, Объект.ИФО, ОграниченияСчетов, ТекущиеДанные.КФО, ОграниченияКПС, Объект.Дата);
		
	Иначе
		
		Таблица = ОбщегоНазначенияБГУКлиентСервер.РодительскийЭлементЗаданногоТипа(Элемент, Тип("ТаблицаФормы"));
		ИмяЭлемента = Элемент.Имя;
		Если СтрНачинаетсяС(ИмяЭлемента, Таблица.Имя) Тогда
			ИмяЭлемента = Сред(ИмяЭлемента, СтрДлина(Таблица.Имя) + 1);
		КонецЕсли;
		
		Если ИмяЭлемента = "СчетУчета" Тогда
			НачалоВыбораСчетаМатериалаВТаблицеДокумента(Форма, СчетУчета, Элемент, ДанныеВыбора, СтандартнаяОбработка, Объект.Дата);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаВыбораСчетаМатериалаВТаблицеДокумента(Форма, Элемент, ВыбранноеЗначение,
	СтандартнаяОбработка, ИмяРеквизитаКЭК = "", ДтКт = "") Экспорт
	
	Перем КОСГУДт, КОСГУКт;
	
	Если ТипЗнч(ВыбранноеЗначение) <> Тип("Структура") Тогда
		// Стандартная обработка
		Возврат;
	КонецЕсли;
	
	Таблица = ОбщегоНазначенияБГУКлиентСервер.РодительскийЭлементЗаданногоТипа(Элемент, Тип("ТаблицаФормы"));
	Если Таблица = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекущиеДанные = Таблица.ТекущиеДанные;
	
	// Получить из структуры КПС, КФО и Счет и заполнить их в колонки строки
	ДанныеСтроки = Новый Структура("КПС, КФО, СчетУчета");
	
	ВыбранныеДанные = ОбщегоНазначенияКлиент.СкопироватьРекурсивно(ВыбранноеЗначение);
	БухгалтерскийУчетКлиент.ОбработатьВыборРабочегоСчета(ВыбранныеДанные,
		ДанныеСтроки.КПС, ДанныеСтроки.КФО, КОСГУДт, КОСГУКт);
	ДанныеСтроки.СчетУчета = ВыбранныеДанные;
	
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, ДанныеСтроки);
	
	Если ЗначениеЗаполнено(ИмяРеквизитаКЭК) И ЗначениеЗаполнено(ДтКт) Тогда
		ТекущиеДанные[ИмяРеквизитаКЭК] = ?(ДтКт = "Дт", КОСГУДт, КОСГУКт);
	КонецЕсли;
	
	// Определить имя элемента для установки параметра ВыбранноеЗначение
	ИмяЭлемента = Элемент.Имя;
	Если СтрНачинаетсяС(ИмяЭлемента, Таблица.Имя) Тогда
		ИмяЭлемента = Сред(ИмяЭлемента, СтрДлина(Таблица.Имя) + 1);
	КонецЕсли;
	Если ИмяЭлемента = "СчетУчета" Тогда
		ВыбранноеЗначение.Свойство("Счет", ВыбранноеЗначение);
	Иначе
		ВыбранноеЗначение.Свойство(ИмяЭлемента, ВыбранноеЗначение);
		УправлениеМатериальнымиЗапасамиКлиентСервер.УстановитьДанныеДинамическихКолонокТекущейСтрокиМатериалов(
			Форма.Объект, ТекущиеДанные);
	КонецЕсли;
	
КонецПроцедуры

// Открывает форму выбора счета. Используется в документах учета Материальных запасов и Биологических активов
//
// Параметры:
//  Форма				 - ФормаКлиентскогоПриложения - 
//  СчетУчета			 - ПланСчетовСсылка.ЕПСБУ - счет, выбранный в документе
//  Элемент				 - ПолеФормы - поле формы, в которое выбирается счет
//  ДанныеВыбора		 - Неопределено - Стандартный параметр обреботчика "НачалоВыбора"
//  СтандартнаяОбработка - Булево - Стандартный параметр обреботчика "НачалоВыбора"
//  НаДату				 - Дата - Дата отбора счетов
//  ТипНоменклатуры		 - ПеречислениеСсылка.ТипыНоменклатуры - тип номенклатуры, используется при выборе счетов БА
//
Процедура НачалоВыбораСчетаМатериалаВТаблицеДокумента(Форма, СчетУчета, Элемент, ДанныеВыбора,
	СтандартнаяОбработка, НаДату = '00010101', Знач ТипНоменклатуры = Неопределено) Экспорт

	Таблица = ОбщегоНазначенияБГУКлиентСервер.РодительскийЭлементЗаданногоТипа(Элемент, Тип("ТаблицаФормы"));
	Если Таблица = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекущиеДанные = Таблица.ТекущиеДанные;
	Параметры = Новый Структура;
	Если ТекущиеДанные <> Неопределено Тогда
		Параметры.Вставить("ТекущаяСтрока", ТекущиеДанные.СчетУчета);
		Если ТипНоменклатуры = Неопределено Тогда
			ТипНоменклатуры = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ТекущиеДанные, "ТипНоменклатуры");
		КонецЕсли;
	КонецЕсли;
	
	ОграниченияСчетов = ОграничениеВыбораСчетовИзДокумента(Форма, Элемент, СчетУчета, ТипНоменклатуры);
	Если ТипЗнч(ОграниченияСчетов) = Тип("СписокЗначений") Тогда
		Параметры.Вставить("ОграниченияСписокСчетов", ОграниченияСчетов);
		Параметры.Вставить("ВидСравненияВСписке", Истина);
	Иначе
		Параметры.Вставить("ОграниченияСчета", ОграниченияСчетов);
	КонецЕсли;
	Параметры.Вставить("НаДату", НаДату);
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "Объект")
			И ТипЗнч(Форма.Объект) = Тип("ДанныеФормыСтруктура") Тогда
		Организация = Неопределено;
		Форма.Объект.Свойство("Организация", Организация);
		Если ЗначениеЗаполнено(Организация) Тогда
			Параметры.Вставить("Организация", Организация);
		КонецЕсли;
		Если Не ЗначениеЗаполнено(НаДату) Тогда
			Дата = Неопределено;
			Форма.Объект.Свойство("Дата", Дата);
			Если ЗначениеЗаполнено(Дата) Тогда
				Параметры.Вставить("НаДату", Дата);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	ОткрытьФорму("ПланСчетов.ЕПСБУ.ФормаВыбора", Параметры, Элемент);
	СтандартнаяОбработка = Ложь;

КонецПроцедуры

Процедура АвтоПодборСчетаМатериалаВТаблицеДокумента(Форма, СчетУчета, Элемент, Текст, ДанныеВыбора, Ожидание, СтандартнаяОбработка) Экспорт

	Если ПустаяСтрока(Текст) Тогда
		Возврат;
	КонецЕсли;

	Таблица = ОбщегоНазначенияБГУКлиентСервер.РодительскийЭлементЗаданногоТипа(Элемент, Тип("ТаблицаФормы"));
	Если Таблица = Неопределено Тогда
