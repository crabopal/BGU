// ПРОЦЕДУРЫ И ФУНКЦИИ ПОДСИСТЕМЫ УЧЕТА ПИТАНИЯ
//

// Возвращает наименование дня недели по номеру дня недели
// 
// Параметры:
//  НомерДня - Число
// 
// Возвращаемое значение:
//  Строка - Сформировать надпись дня
Функция СформироватьНадписьДня(НомерДня) Экспорт
	НадписьДня = "";
	Если НомерДня = 1 Тогда
		НадписьДня = "Понедельник";
	ИначеЕсли НомерДня = 2 Тогда
		НадписьДня = "Вторник";
	ИначеЕсли НомерДня = 3 Тогда
		НадписьДня = "Среда";
	ИначеЕсли НомерДня = 4 Тогда
		НадписьДня = "Четверг";
	ИначеЕсли НомерДня = 5 Тогда
		НадписьДня = "Пятница";
	ИначеЕсли НомерДня = 6 Тогда
		НадписьДня = "Суббота";
	ИначеЕсли НомерДня = 7 Тогда
		НадписьДня = "Воскресенье";
	КонецЕсли;	
	
	Возврат(НадписьДня);
КонецФункции

