// ПРОЦЕДУРЫ ОБНОВЛЕНИЯ
// Перивичное заполнение

Процедура Первичное_ЗаполнитьПредопределенныеЭлементыАналитикаОтчетов() Экспорт
	
	Объект = ПланыВидовХарактеристик.АналитикаОтчетов.КорреспондентПоВнутриведомственнымРасчетам.ПолучитьОбъект();
	Объект.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.Контрагенты");
	Объект.ПубличныйИдентификатор = "urn:entities-1c-ru:budget/intraadm-corr";
	Объект.Код = "КВнР";
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();
	
КонецПроцедуры

Процедура Первичное_СоздатьНачальныеОтчетныеПериоды() Экспорт
	
	ЗаполняемыеПериоды = Новый Массив;
	
	мПериодичность = БюджетнаяОтчетностьСервер.ПолучитьМенеджерПериодичность();
	
	ЗаполняемыеПериоды.Добавить(мПериодичность.Полугодие);
	ЗаполняемыеПериоды.Добавить(мПериодичность.Квартал);
	ЗаполняемыеПериоды.Добавить(мПериодичность.Месяц);
	ЗаполняемыеПериоды.Добавить(мПериодичность.ДевятьМесяцев);
	
	Справочники.Периоды.ЗагрузитьЭлементы(Год(ТекущаяДатаСеанса()), 3, ЗаполняемыеПериоды);
	
КонецПроцедуры	

