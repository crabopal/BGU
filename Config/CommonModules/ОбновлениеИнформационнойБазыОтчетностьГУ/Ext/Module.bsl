Процедура Обновление_1_0_9_6() Экспорт
	
	//Установка основной учетной записи обмена со Сводом отчетов	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьОбменСоСводомОтчетов") Тогда
		
		Если НЕ ЗначениеЗаполнено(Константы.ОсновнаяУчетнаяЗаписьОбменаСоСводомОтчетов.Получить()) Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	УчетныеЗаписиОбменаСводаОтчетов.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.УчетныеЗаписиОбменаСводаОтчетов КАК УчетныеЗаписиОбменаСводаОтчетов
				|ГДЕ
				|	УчетныеЗаписиОбменаСводаОтчетов.ПометкаУдаления = ЛОЖЬ";
			
			РезультатЗапроса = Запрос.Выполнить();
					
			ВыборкаУчЗап = РезультатЗапроса.Выбрать();
			
			Если ВыборкаУчЗап.Количество() = 1 Тогда
				ВыборкаУчЗап.Следующий(); 
			
				Константы.ОсновнаяУчетнаяЗаписьОбменаСоСводомОтчетов.Установить(ВыборкаУчЗап.Ссылка);	
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

