Процедура Обновление_1_0_5_19_ЗаполнениеОсновныхПечатныхБланков() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УниверсальныйРегламентированныйОтчет.Ссылка,
	|	УниверсальныйРегламентированныйОтчет.ОсновнойПечатныйБланк,
	|	УниверсальныйРегламентированныйОтчет.ВидОтчета,
	|	УниверсальныйРегламентированныйОтчет.Организация,
	|	УниверсальныйРегламентированныйОтчет.ПериодОтчета
	|ИЗ
	|	Документ.УниверсальныйРегламентированныйОтчет КАК УниверсальныйРегламентированныйОтчет
	|ГДЕ
	|	(УниверсальныйРегламентированныйОтчет.ОсновнойПечатныйБланк = ЗНАЧЕНИЕ(Справочник.ПроизвольныеБланкиФорм.ПустаяСсылка)
	|			ИЛИ УниверсальныйРегламентированныйОтчет.ОсновнойПечатныйБланк = НЕОПРЕДЕЛЕНО
	|				И УниверсальныйРегламентированныйОтчет.ПометкаУдаления = ЛОЖЬ
	|				И УниверсальныйРегламентированныйОтчет.ВидОтчета В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						ПроизвольныеБланкиФорм.Владелец
	|					ИЗ
	|						Справочник.ПроизвольныеБланкиФорм КАК ПроизвольныеБланкиФорм))";
	КандидатыНаПроверку = Запрос.Выполнить().Выгрузить();
	Для Каждого ПроверяемыйКандидат из КандидатыНаПроверку Цикл
		
		НастройкиОтчета = БюджетнаяОтчетность.ПолучитьНастройкиОтчета(ПроверяемыйКандидат.ВидОтчета, ПроверяемыйКандидат.ПериодОтчета, ПроверяемыйКандидат.Организация);
		Если НастройкиОтчета = Неопределено Тогда 
			Продолжить;
		КонецЕсли;	
		
		Если не ЗначениеЗаполнено(НастройкиОтчета.БланкДляПечати) Тогда 
			Продолжить;
		КонецЕсли;
		
		Объект = ПроверяемыйКандидат.Ссылка.ПолучитьОбъект();
		Объект.ОсновнойПечатныйБланк = НастройкиОтчета.БланкДляПечати;
		ОбновлениеИнформационнойБазы.ЗаписатьДанные(Объект);
		
	КонецЦикла;
	
	
КонецПроцедуры	


