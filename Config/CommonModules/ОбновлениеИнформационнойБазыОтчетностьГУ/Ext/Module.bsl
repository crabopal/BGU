////////////////////////////////////////////////////////////////////////////////
// 1.0.5.13

Процедура Обновление_1_0_5_13_ПоменятьТипАналитикиСубъект() Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	АналитикаОтчетов.Ссылка
	|ИЗ
	|	ПланВидовХарактеристик.АналитикаОтчетов КАК АналитикаОтчетов
	|ГДЕ
	|	АналитикаОтчетов.Код = ""СУБЪЕКТ""
	|	И АналитикаОтчетов.ПубличныйИдентификатор = ""urn:entities-1c-ru:budget/region-code/subject""";
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда 
		Возврат;
	КонецЕсли;
	
	Аналитика = Результат.Выгрузить()[0].Ссылка;
		
	Если Не Аналитика.ТипЗначения.СодержитТип(Тип("СправочникСсылка.Субконто")) или Аналитика.ТипЗначения.Типы().Количество() <> 1 Тогда
		Возврат;  
	КонецЕсли;	
	
	НачатьТранзакцию();
	
	АналитикаОбъект = Аналитика.ПолучитьОбъект();
	АналитикаОбъект.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.СубъектыРФ");
	ОбновлениеИнформационнойБазы.ЗаписатьДанные(АналитикаОбъект);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидАналитики",Аналитика);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	АналитикаПоказателей.ЭкземплярОтчета,
	|	АналитикаПоказателей.ГруппаРаскрытия,
	|	АналитикаПоказателей.ВидАналитики,
	|	АналитикаПоказателей.Индекс,
	|	АналитикаПоказателей.Значение,
	|	АналитикаПоказателей.ЗаписьАктивна,
	|	ВЫРАЗИТЬ(АналитикаПоказателей.Значение КАК Справочник.Субконто).Код КАК КодЗначения,
	|	ВЫРАЗИТЬ(АналитикаПоказателей.Значение КАК Справочник.Субконто).Наименование КАК НаименованиеЗначения
	|ПОМЕСТИТЬ ЗначенияДляОбновления
	|ИЗ
	|	РегистрСведений.АналитикаПоказателей КАК АналитикаПоказателей
	|ГДЕ
	|	АналитикаПоказателей.ВидАналитики = &ВидАналитики
	|	И АналитикаПоказателей.Значение ССЫЛКА Справочник.Субконто
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗначенияДляОбновления.ЭкземплярОтчета,
	|	ЗначенияДляОбновления.ГруппаРаскрытия,
	|	ЗначенияДляОбновления.ВидАналитики,
	|	ЗначенияДляОбновления.Индекс,
	|	ЗначенияДляОбновления.Значение,
	|	ЗначенияДляОбновления.ЗаписьАктивна
	|ИЗ
	|	ЗначенияДляОбновления КАК ЗначенияДляОбновления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СубъектыРФ.Ссылка,
	|	ЗначенияДляОбновления.Значение
	|ИЗ
	|	Справочник.СубъектыРФ КАК СубъектыРФ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ЗначенияДляОбновления КАК ЗначенияДляОбновления
	|		ПО СубъектыРФ.Код = ЗначенияДляОбновления.КодЗначения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СубъектыРФ.Ссылка,
	|	ЗначенияДляОбновления.Значение
	|ИЗ
	|	Справочник.СубъектыРФ КАК СубъектыРФ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ЗначенияДляОбновления КАК ЗначенияДляОбновления
	|		ПО СубъектыРФ.Наименование = ЗначенияДляОбновления.НаименованиеЗначения";
	ДанныеПакета = Запрос.ВыполнитьПакет();
	
	ДанныеДляОбновления = ДанныеПакета[1].Выгрузить();
	ВариантыПоКоду = ДанныеПакета[2].Выгрузить();
	ВариантыПоНаименованию = ДанныеПакета[3].Выгрузить();
	
	Для Каждого СтрокаДляОбновления из ДанныеДляОбновления Цикл 
		Если Не ЗначениеЗаполнено(СтрокаДляОбновления.Значение) Тогда 
			Продолжить;
		КонецЕсли;	
		
		НовоеЗначение = Неопределено;
		
		Если НовоеЗначение = Неопределено Тогда 
			НайденаяСтрока = ВариантыПоКоду.Найти(СтрокаДляОбновления.Значение,"Значение");
			Если НайденаяСтрока<> Неопределено Тогда 
				НовоеЗначение =  НайденаяСтрока.Ссылка;
			КонецЕсли;	
		КонецЕсли;
		Если НовоеЗначение = Неопределено Тогда 
			НайденаяСтрока = ВариантыПоНаименованию.Найти(СтрокаДляОбновления.Значение,"Значение");
			Если НайденаяСтрока<> Неопределено Тогда 
				НовоеЗначение =  НайденаяСтрока.Ссылка;
			КонецЕсли;
		КонецЕсли;
		
		
		Если НовоеЗначение <> Неопределено Тогда 
			
			НаборЗаписей = РегистрыСведений.АналитикаПоказателей.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ЭкземплярОтчета.Установить(СтрокаДляОбновления.ЭкземплярОтчета);
			НаборЗаписей.Отбор.ГруппаРаскрытия.Установить(СтрокаДляОбновления.ГруппаРаскрытия);
			НаборЗаписей.Отбор.ВидАналитики.Установить(СтрокаДляОбновления.ВидАналитики);
			НаборЗаписей.Отбор.Индекс.Установить(СтрокаДляОбновления.Индекс);
			
			НоваяЗапись = НаборЗаписей.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяЗапись,СтрокаДляОбновления);
			НоваяЗапись.Значение = НовоеЗначение;
			ОбновлениеИнформационнойБазы.ЗаписатьДанные(НаборЗаписей);
			
			
		КонецЕсли;
		
	КонецЦикла;	
	
	ЗафиксироватьТранзакцию();
	
КонецПроцедуры	

