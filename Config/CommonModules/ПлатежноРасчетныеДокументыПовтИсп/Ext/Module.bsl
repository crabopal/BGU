#Область ПрограммныйИнтерфейс

Функция ПолучитьСвойстваЛицевогоСчета(ЛицевойСчет, Дата = Неопределено, СоставДанных = Неопределено) Экспорт
	Возврат Справочники.ЛицевыеСчета.ПолучитьСвойстваЛицевогоСчета(ЛицевойСчет, Дата, СоставДанных);
КонецФункции	

// Возвращает массив, содержащий ссылки на элементы справочника Казначейства
// или Банки для заданного лицевого счета
//
// Параметры:
//	ЛицевойСчет (СправочникСсылка.ЛицевыеСчета)
//
Функция ПолучитьКазначействаЛицевогоСчета(ЛицевойСчет) Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ЛицевойСчет);
	Запрос.Текст = "
    |ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РеквизитыЛицевыхСчетов.КассовыйОрган.Ссылка КАК ОФК
	|ИЗ
	|	Справочник.РеквизитыЛицевыхСчетов КАК РеквизитыЛицевыхСчетов
	|ГДЕ
	|	РеквизитыЛицевыхСчетов.Владелец.Ссылка = &Ссылка
	|";
		
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ОФК");
	
КонецФункции	

// Возвращает массив, содержащий ссылки на элементы справочника Лицевые счета для выбранной Организации
//
// Параметры:
//	Организация (СправочникСсылка.Организации)
//
Функция ПолучитьЛицевыеСчетаОрганизации(Организация) Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Организация);
	Запрос.Текст = "
    |ВЫБРАТЬ 
	|	ЛицевыеСчета.Ссылка КАК ЛС
	|ИЗ
	|	Справочник.ЛицевыеСчета КАК ЛицевыеСчета
	|ГДЕ
	|	ЛицевыеСчета.Владелец.Ссылка = &Ссылка
	|";
		
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ЛС");
	
КонецФункции	

// Возвращает массив, содержащий ссылки на кассовые органы (казначейства или банки),
// в которых организации открыты счета
Функция ПолучитьКассовыеОрганыОрганизации(Организация) Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	 |	РеквизитыЛицевыхСчетов.КассовыйОрган КАК КассовыйОрган
	 |ИЗ
	 |	(ВЫБРАТЬ
	 |		ЛицевыеСчета.Ссылка КАК Ссылка
	 |	ИЗ
	 |		Справочник.ЛицевыеСчета КАК ЛицевыеСчета
	 |	ГДЕ
	 |		ЛицевыеСчета.Владелец = &Владелец) КАК ВложенныйЗапрос
	 |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РеквизитыЛицевыхСчетов КАК РеквизитыЛицевыхСчетов
	 |		ПО (РеквизитыЛицевыхСчетов.Владелец = ВложенныйЗапрос.Ссылка)
	 |ГДЕ
	 |	НЕ РеквизитыЛицевыхСчетов.КассовыйОрган = ЗНАЧЕНИЕ(Справочник.Банки.ПустаяСсылка)
	 |	И НЕ РеквизитыЛицевыхСчетов.КассовыйОрган = ЗНАЧЕНИЕ(Справочник.Казначейства.ПустаяСсылка)");
	 
	 Запрос.УстановитьПараметр("Владелец", Организация);
	 
	 Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("КассовыйОрган");
	
КонецФункции	


// Возвращает массив налоговых реквизитов документа
//	ЗаявкаНаКассовыйРасход
//	ЗаявкаНаКассовыйРасходСокращенная
Функция ПолучитьСписокНалоговыхРеквизитов() экспорт
	Результат = Новый Массив;
	Результат.Добавить("СтатусСоставителя");					
	Результат.Добавить("КодБКНалога");					
	Результат.Добавить("КодОКАТО");			
	Результат.Добавить("ПоказательОснования");				
	Результат.Добавить("ПоказательПериода");				
	Результат.Добавить("ПоказательНомера");				
	Результат.Добавить("ПоказательДаты");			
	Результат.Добавить("ПоказательТипа");
	возврат  Результат;
КонецФункции	

Функция ДопустимыеКФО(ИсточникСредств = Неопределено, ЛицевойСчет) экспорт
	
	Если ИсточникСредств = Неопределено Тогда
		ИсточникСредств = ПредопределенноеЗначение("Справочник.ИсточникиСредств.ПустаяСсылка");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РазделыЛицевыхСчетовДопустимыеКФО.КФО КАК КФО
	|ИЗ
	|	Справочник.РазделыЛицевыхСчетов.ДопустимыеКФО КАК РазделыЛицевыхСчетовДопустимыеКФО
	|ГДЕ
	|	(РазделыЛицевыхСчетовДопустимыеКФО.Ссылка.ИсточникСредств = &ИсточникСредств
	|			ИЛИ &ИсточникСредств = ЗНАЧЕНИЕ(Справочник.ИсточникиСредств.ПустаяСсылка))
	|	И РазделыЛицевыхСчетовДопустимыеКФО.Ссылка.Владелец = &ЛицевойСчет
	|
	|УПОРЯДОЧИТЬ ПО
	|	РазделыЛицевыхСчетовДопустимыеКФО.КФО.Порядок";
	
	Запрос.УстановитьПараметр("ИсточникСредств",ИсточникСредств);
	Запрос.УстановитьПараметр("ЛицевойСчет",ЛицевойСчет);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("КФО");
	
КонецФункции

Функция ДопустимыеИсточникиСредств(ЛицевойСчет,КФО = Неопределено) экспорт
	
	Если КФО = Неопределено Тогда
		КФО = ПредопределенноеЗначение("Перечисление.КВД.ПустаяСсылка");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РазделыЛицевыхСчетовДопустимыеКФО.Ссылка.ИсточникСредств КАК ИС
	|ИЗ
	|	Справочник.РазделыЛицевыхСчетов.ДопустимыеКФО КАК РазделыЛицевыхСчетовДопустимыеКФО
	|ГДЕ
	|	РазделыЛицевыхСчетовДопустимыеКФО.Ссылка.Владелец = &ЛС
	|   И НЕ РазделыЛицевыхСчетовДопустимыеКФО.Ссылка.ПометкаУдаления 
	|	И (РазделыЛицевыхСчетовДопустимыеКФО.КФО = &КФО
	|			ИЛИ &КФО = ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка))";
	
	Запрос.УстановитьПараметр("ЛС",ЛицевойСчет);
	Запрос.УстановитьПараметр("КФО",КФО);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ИС");
	
КонецФункции

//  Возвращает Казначейство и ЛицевойСчет по Реквизиту лицевого счета
//	Входящие параметры:	РеквизитЛС - справочник РеквизитыЛицевыхСчетов
//	Исходящие параметры: Структура
Функция ПолучитьЛицевойСчетОрганКазначейства(РеквизитЛС) экспорт
	Возврат Новый Структура("Лицевойсчет,Казначейство",РеквизитЛС.Владелец,РеквизитЛС.КассовыйОрган)
КонецФункции

//     Процедура возвращает должность сотрудника 
//   Входящие параметры:  Сотрудник - ссылка справочника сотрудники
//						  ПечататьДолжность - булево
//						  Дата - дата, дана на которую нужно получить должность
//   
Функция ПолучитьДолжностьСотрудника(Сотрудник, ПечататьДолжность, Дата) Экспорт
	Если ЗначениеЗаполнено(Сотрудник) и ПечататьДолжность ТОгда
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект,Период,Должность", Сотрудник,Дата);	
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника);
		Должность = ДанныеСотрудника.Должность;
	Иначе
		Должность = "";
	КонецЕсли;
	Возврат Должность;
КонецФункции

