//			Процедуры работы справвояника "Шаблоны "Назначения платежа"
//  
Функция ПолучитьОбслуживаемыеОбъектыМетаданных() Экспорт
	
	Результат = Новый Массив;
	Результат.Добавить(Метаданные.Документы.ПлатежноеПоручение);
	Результат.Добавить(Метаданные.Документы.ЗаявкаНаКассовыйРасход);
	Результат.Добавить(Метаданные.Документы.ЗаявкаНаКассовыйРасходСокращенная);
	Результат.Добавить(Метаданные.Документы.ИнкассовоеПоручение);
	Результат.Добавить(Метаданные.Документы.ПлатежноеТребование);
	Результат.Добавить(Метаданные.Документы.Аккредитив);
	Результат.Добавить(Метаданные.Документы.ОбъявлениеНаВзносНаличными);
	Результат.Добавить(Метаданные.Документы.СводнаяЗаявкаНаКассовыйРасход);

	Возврат Результат;
	
КонецФункции

