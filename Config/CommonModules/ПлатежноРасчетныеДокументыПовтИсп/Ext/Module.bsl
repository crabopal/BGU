Функция ПолучитьСписокТиповЗаявок() экспорт
	СписокТипов = Новый СписокЗначений();
	СписокТипов.Добавить(Тип("ДокументСсылка.ЗаявкаНаВозврат"));
	СписокТипов.Добавить(Тип("ДокументСсылка.ЗаявкаНаКассовыйРасход"));
	СписокТипов.Добавить(Тип("ДокументСсылка.ЗаявкаНаКассовыйРасходСокращенная"));
	СписокТипов.Добавить(Тип("ДокументСсылка.ЗаявкаНаНаличные"));
	СписокТипов.Добавить(Тип("ДокументСсылка.ЗапросНаАннулированиеЗаявки"));
	СписокТипов.Добавить(Тип("ДокументСсылка.ПлатежноеПоручение"));
	Возврат СписокТипов;
КонецФункции	

Функция ПолучитьСписокТиповПоступлений() экспорт
	СписокТипов = Новый СписокЗначений();
	СписокТипов.Добавить(Тип("ДокументСсылка.КассовоеПоступление"));
	Возврат СписокТипов;
КонецФункции	

//Устарела. Не используется. Следует использовать УчетНДСКлиентСервер.ЗначениеСтавкиНДС.
// В модуле УчетНДС есть ссылка на НСИ пока вынесу сюда
// Функция возвращает курс ставку НДС
//
// Параметры:
//  Валюта - СправочникСсылка.Валюты, валюта, по которой необходимо получить курс
//  ДатаКурса - Дата, календарная дата, на которую необходимо получить курс валюты
//
// Возвращаемое значение:
//	Курс переданной валюты на переданную дату, 1 в случае отсутствия значения.
//
Функция ПолучитьСтавкуНДС(СтавкаНДС) Экспорт

	Если СтавкаНДС = Перечисления.СтавкиНДС.НДС20 ИЛИ СтавкаНДС = Перечисления.СтавкиНДС.НДС20_120 Тогда
		Возврат 20;

	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС10 ИЛИ СтавкаНДС = Перечисления.СтавкиНДС.НДС10_110 Тогда
		Возврат 10;

	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС18 ИЛИ СтавкаНДС = Перечисления.СтавкиНДС.НДС18_118 Тогда
		Возврат 18;

	КонецЕсли;

	Возврат 0;

КонецФункции // ПолучитьСтавкуНДС()

