// ЗАПОЛНЕНИЕ НАЛОГОВЫХ РЕКВИЗИТОВ
//

Функция ОснованиеПлатежаДляНалогов() Экспорт
	
	ОснованиеПлатежаНалоги = Новый СписокЗначений;
	
	ОснованиеПлатежаНалоги.Добавить(Перечисления.ОснованияПлатежа.ТП);  // "ТП" - платежи текущего года;
	ОснованиеПлатежаНалоги.Добавить(Перечисления.ОснованияПлатежа.ЗД);  // "ЗД" - добровольное погашение задолженности по истекшим налоговым периодам при отсутствии требования об уплате налогов (сборов) от налогового органа;
    ОснованиеПлатежаНалоги.Добавить(Перечисления.ОснованияПлатежа.ТР);  // "ТР" - погашение задолженности по требованию налогового органа об уплате налогов (сборов);
	ОснованиеПлатежаНалоги.Добавить(Перечисления.ОснованияПлатежа.РС);  // "РС" - погашение рассроченной задолженности;
    ОснованиеПлатежаНалоги.Добавить(Перечисления.ОснованияПлатежа.ОТ);  // "ОТ" - погашение отсроченной задолженности;
	ОснованиеПлатежаНалоги.Добавить(Перечисления.ОснованияПлатежа.РТ);  // "РТ" - погашение реструктурируемой задолженности;
    ОснованиеПлатежаНалоги.Добавить(Перечисления.ОснованияПлатежа.ВУ);  // "ВУ" - погашение отсроченной задолженности в связи с введением внешнего управления;
    ОснованиеПлатежаНалоги.Добавить(Перечисления.ОснованияПлатежа.ПР);  // "ПР" - погашение задолженности, приостановленной к взысканию;
    ОснованиеПлатежаНалоги.Добавить(Перечисления.ОснованияПлатежа.АП);  // "АП" - погашение задолженности по акту проверки;
    ОснованиеПлатежаНалоги.Добавить(Перечисления.ОснованияПлатежа.АР);  // "АР" - погашение задолженности по исполнительному документу.

	Возврат ОснованиеПлатежаНалоги;
	
КонецФункции	

Функция ОснованиеПлатежаДляТаможни() Экспорт
	
	ОснованиеПлатежаТаможня = Новый СписокЗначений;
	
	ОснованиеПлатежаТаможня.Добавить(Перечисления.ОснованияПлатежа.ДЕ);  // "ДЕ" - таможенная декларация;
    ОснованиеПлатежаТаможня.Добавить(Перечисления.ОснованияПлатежа.ПО);  // "ПО" - таможенный приходный ордер;
	ОснованиеПлатежаТаможня.Добавить(Перечисления.ОснованияПлатежа.КВ);  // "КВ" - постановление-квитанция (при уплате штрафа);
    ОснованиеПлатежаТаможня.Добавить(Перечисления.ОснованияПлатежа.КТ);  // "КТ" - форма корректировки таможенной стоимости и таможенных платежей;
    ОснованиеПлатежаТаможня.Добавить(Перечисления.ОснованияПлатежа.ИД);  // "ИД" - исполнительный документ;
    ОснованиеПлатежаТаможня.Добавить(Перечисления.ОснованияПлатежа.ИП);  // "ИП" - инкассовое поручение;
    ОснованиеПлатежаТаможня.Добавить(Перечисления.ОснованияПлатежа.ТУ);  // "ТУ" - требование об уплате таможенных платежей;
    ОснованиеПлатежаТаможня.Добавить(Перечисления.ОснованияПлатежа.БД);  // "БД" - документы бухгалтерских служб таможенных органов;
    ОснованиеПлатежаТаможня.Добавить(Перечисления.ОснованияПлатежа.ИН);  // "ИН" - документ инкассации;
    ОснованиеПлатежаТаможня.Добавить(Перечисления.ОснованияПлатежа.КП);  // "КП" - соглашение о взаимодействии при уплате крупными плательщиками суммарных платежей в централизованном порядке.
	
	Возврат ОснованиеПлатежаТаможня;
	
КонецФункции

///////////////////////////////////////////////////////////////////
//		ДАННЫЕ ПО СОТРУДНИКУ ДЛЯ ЗАПОЛНЕНИЯ ДОКУМЕНТОВ
//
Функция ПолучитьДанныеСотрудника(Сотрудник,Дата) экспорт
	
	РеквизитыСотрудника = Новый Структура("Фамилия,Имя,Отчество,ВидДокумента,Серия,Номер,ДатаВыдачи,КемВыдан,КодПодразделения,Должность,ПолучитьОтКого,ВыдатьКому");
	
	Если ТипЗнч(Сотрудник) <> Тип("СправочникСсылка.Сотрудники") тогда
		Возврат РеквизитыСотрудника;
	КонецЕсли;	
	
	Если не ЗначениеЗаполнено(Дата) тогда
		Дата = ТекущаяДата();
	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ФИО.Фамилия КАК Фамилия,
	               |	ФИО.Имя КАК Имя,
	               |	ФИО.Отчество КАК Отчество,
	               |	ДокументыФизЛиц.ВидДокумента КАК ВидДокумента,
	               |	ДокументыФизЛиц.Серия КАК Серия,
	               |	ДокументыФизЛиц.Номер КАК Номер,
	               |	ДокументыФизЛиц.ДатаВыдачи КАК ДатаВыдачи,
	               |	ДокументыФизЛиц.КемВыдан КАК КемВыдан,
	               |	ДокументыФизЛиц.КодПодразделения КАК КодПодразделения,
	               |	ДанныеСотрудников.Должность КАК Должность,
	               |	Сотрудники.Контрагент.НаименованиеРП КАК ПолучитьОтКого,
	               |	Сотрудники.Контрагент.НаименованиеДП КАК ВыдатьКому
	               |ИЗ
	               |	Справочник.Сотрудники КАК Сотрудники
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизическихЛиц.СрезПоследних(&Дата, ) КАК ФИО
	               |		ПО Сотрудники.Контрагент.ЮридическоеФизическоеЛицо = ФИО.ФизическоеЛицо
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеСотрудников.СрезПоследних(&Дата, ) КАК ДанныеСотрудников
	               |		ПО Сотрудники.Ссылка = ДанныеСотрудников.Сотрудник
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыФизическихЛиц.СрезПоследних(&Дата, ВидДокумента = ЗНАЧЕНИЕ(Справочник.ВидыДокументовФизическихЛиц.ПаспортРФ)) КАК ДокументыФизЛиц
	               |		ПО Сотрудники.Контрагент.ЮридическоеФизическоеЛицо = ДокументыФизЛиц.Физлицо
	               |ГДЕ
	               |	Сотрудники.Ссылка = &Ссылка";
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка",Сотрудник);
	Запрос.УстановитьПараметр("Дата",Дата);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Для каждого КлючЗначение из РеквизитыСотрудника Цикл
		ТекРеквизит = КлючЗначение.Ключ;
		РеквизитыСотрудника.Вставить(ТекРеквизит, Выборка[ТекРеквизит]);
	КонецЦикла;	
	
	Возврат РеквизитыСотрудника;
	
КонецФункции	

функция ПолучитьУчетнуюПолитикуОрганизации(Организация,Дата = неопределено) экспорт
	
	УчетнаяПолитика = Справочники.Организации.ПолучитьУчетнуюПолитику(Организация,Дата);
		
	Для каждого Ресурс из Метаданные.РегистрыСведений.УчетнаяПолитикаОрганизаций.Ресурсы цикл
		Если Ресурс.Тип.СодержитТип(Тип("Булево")) тогда 
			Значение = Неопределено;
			УчетнаяПолитика.Свойство(Ресурс.Имя,Значение);
			УчетнаяПолитика.Вставить(Ресурс.Имя,?(Значение = Неопределено,Ложь,Значение));
		КонецЕсли;	
	КонецЦикла;	
		
	УчетнаяПолитика.Вставить("РБСКакПБС", 		УчетнаяПолитика.ПолномочияРБС);
	УчетнаяПолитика.Вставить("АИФКакГАИФ", 		УчетнаяПолитика.ПолномочияГАИВФ ИЛИ УчетнаяПолитика.ПолномочияГАИВнФ);
		
	ДополнительныеРеквизиты	= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Организация, "Распорядитель,КодПоППП");
	
	Для каждого КлючЗначение из ДополнительныеРеквизиты Цикл
		УчетнаяПолитика.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;	
	
	Возврат УчетнаяПолитика; 
	
КонецФункции	

// Формирует список ссылок на объекты из строки кодов, разделенных запятыми
//
// Параметры:
//	ВидОбъекта (Строка). Строка типа объекта для запроса. Например, "Справочник.КБК"
//	СтрокаОбъектов (Строка). Строка кодов объектов, разделенных запятыми
//
// Возвращает массив ссылок на объекты
Функция СформироватьСписокСсылокПоКодуОбъекта(ВидОбъекта, СтрокаОбъектов, ВключатьПодчиненные = Ложь) Экспорт
	ВыбранныеЗначения = Новый СписокЗначений;
	ВыбранныеЗначения.ЗагрузитьЗначения(ПлатежноРасчетныеДокументы.СформироватьСписокСсылокПоКодуОбъекта(ВидОбъекта, СтрокаОбъектов, ВключатьПодчиненные));
	Возврат ВыбранныеЗначения;
КонецФункции


#КонецОбласти
	

