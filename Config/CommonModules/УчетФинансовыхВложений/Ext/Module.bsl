#Область ПрограммныйИнтерфейс

Функция ПустаяТаблицаВложенийВФинансовыеАктивы() Экспорт

	ОписаниеТиповСубконто = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Идентификация строки
	ПустаяТаблица.Колонки.Добавить("ИмяСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	
	// Общие разрезы учета
	ПустаяТаблица.Колонки.Добавить("ИФО", Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО", Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС", Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	
	// Счет и аналитика финансовых вложений
	ПустаяТаблица.Колонки.Добавить("ОбъектФинансовыхВложений", Новый ОписаниеТипов("СправочникСсылка.ОбъектыФинансовыхВложений"));
	ПустаяТаблица.Колонки.Добавить("СчетУчета", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	
	// Поставщик
	ПустаяТаблица.Колонки.Добавить("СчетРасчетов", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ПустаяТаблица.Колонки.Добавить("Договор", Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ПустаяТаблица.Колонки.Добавить("Валюта", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	
	// Количество и стоимость услуг, работ
	ПустаяТаблица.Колонки.Добавить("Количество", ОписаниеТипаКоличества);
	ПустаяТаблица.Колонки.Добавить("СуммаВал", ОписаниеТипаСуммы); // Сумма с НДС в валюте документа
	ПустаяТаблица.Колонки.Добавить("СуммаРуб", ОписаниеТипаСуммы); // Сумма с НДС в рублях
	
	// Контроль исполнения договоров
	ПустаяТаблица.Колонки.Добавить("ОтразитьВГрафикеИсполненияДоговора",
		Новый ОписаниеТипов("ПеречислениеСсылка.СтатусыДокументовКонтрольИсполненияДоговоров"));
	
	Возврат ПустаяТаблица;

КонецФункции

Функция ТаблицаВложенийВФинансовыеАктивыПоДокументу(Документ, Параметры = Неопределено) Экспорт
	
	Если Параметры = Неопределено Тогда
		Параметры = Новый Структура;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "ВложенияВФинансовыеАктивы",
		"НомерСтроки,ИФО,Подразделение,Контрагент,Договор,ВалютаДокумента,
		|ОбъектФинансовыхВложений,СчетУчета,Количество,Сумма,КПС,КФО",
		Документ, Параметры);
	
	Запрос.Текст = Запрос.Текст +
	"ВЫБРАТЬ
	|	""ВложенияВФинансовыеАктивы"" КАК ИмяСписка,
	|	""ВложенияВФинансовыеАктивы"" КАК СинонимСписка,
	|	ВложенияВФинансовыеАктивы.НомерСтроки КАК НомерСтроки,
	|	ВложенияВФинансовыеАктивы.ИФО КАК ИФО,
	|	ВложенияВФинансовыеАктивы.КФО КАК КФО,
	|	ВложенияВФинансовыеАктивы.КПС КАК КПС,
	|	ВложенияВФинансовыеАктивы.Подразделение КАК Подразделение,
	|	ВложенияВФинансовыеАктивы.Контрагент КАК Контрагент,
	|	ВложенияВФинансовыеАктивы.Договор КАК Договор,
	|	ВложенияВФинансовыеАктивы.ОбъектФинансовыхВложений КАК ОбъектФинансовыхВложений,
	|	ВложенияВФинансовыеАктивы.СчетУчета КАК СчетУчета,
	|	ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка) КАК СчетРасчетов,
	|	ВложенияВФинансовыеАктивы.ВалютаДокумента КАК Валюта,
	|	ВложенияВФинансовыеАктивы.Сумма КАК Сумма,
	|	ВложенияВФинансовыеАктивы.Количество КАК Количество
	|ИЗ
	|	ТаблицаВложенияВФинансовыеАктивы КАК ВложенияВФинансовыеАктивы
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	ТаблицаВложенияВФинансовыеАктивы = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаТаблицы Из ТаблицаВложенияВФинансовыеАктивы Цикл
		СтрокаТаблицы.СчетРасчетов = СчетРасчетовПоСчетуУчетаВложенийВФинансовыеАктивы(
			СтрокаТаблицы.СчетУчета, Документ.Дата, Документ.Организация);
	КонецЦикла;
	
	Возврат ТаблицаВложенияВФинансовыеАктивы;
	
КонецФункции

// Формирует таблицу источника данных "ТаблицаВложенийВФинансовыеАктивы".
//
Функция ТаблицаВложенийВФинансовыеАктивы(ТаблицаДокумента, ТаблицаРасчетовСЗачетомАвансов = Неопределено,
	Знач Реквизиты = Неопределено, Отказ = Ложь) Экспорт
	
	ТаблицаПоступление = ПустаяТаблицаВложенийВФинансовыеАктивы();
	Если ТаблицаДокумента.Количество() = 0 Тогда
		Возврат ТаблицаПоступление;
	КонецЕсли;
	
	Если Реквизиты = Неопределено Тогда
		Реквизиты = Новый Структура;
	КонецЕсли;
	
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	
	УчетРасчетов.РассчитатьСуммыРуб(ТаблицаДокумента, ТаблицаРасчетовСЗачетомАвансов, Реквизиты);
	
	Для Каждого СтрокаДокумента Из ТаблицаДокумента Цикл
		
		СтрокаПоступление = ТаблицаПоступление.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПоступление, СтрокаДокумента);
		
		СтрокаПоступление.СуммаВал = СтрокаДокумента.Сумма;
		
	КонецЦикла;
	
	Возврат ТаблицаПоступление;
	
КонецФункции

