	ПустаяТаблица.Колонки.Добавить("СтавкаНДС",     Новый ОписаниеТипов("ПеречислениеСсылка.СтавкиНДС"));
	ПустаяТаблица.Колонки.Добавить("СуммаВал",      ОписаниеТипаСуммы); // Сумма с НДС в валюте документа.
	ПустаяТаблица.Колонки.Добавить("СуммаНДСВал",   ОписаниеТипаСуммы); // Сумма НДС в валюте документа.
	ПустаяТаблица.Колонки.Добавить("СуммаРуб",      ОписаниеТипаСуммы); // Сумма с НДС в рублях.
	ПустаяТаблица.Колонки.Добавить("СуммаНДСРуб",   ОписаниеТипаСуммы); // Сумма НДС в рублях.
	
	Возврат ПустаяТаблица;

КонецФункции

// Формирует таблицу источника данных "Реализация основных средств".
//
Функция ТаблицаРеализацияФинансовыхАктивов(ТаблицаДокумента, ТаблицаРасчетовСЗачетомАвансов=Неопределено, Реквизиты, Отказ) Экспорт
	
	ТаблицаРеализация = ПустаяТаблицаРеализацияФинансовыхАктивов();
	Если ТаблицаДокумента.Количество() = 0 Тогда
		Возврат ТаблицаРеализация;
	КонецЕсли;
	
	УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Реквизиты.Организация, Реквизиты.Дата);
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	
	УчетРасчетов.РассчитатьСуммыРуб(ТаблицаДокумента, ТаблицаРасчетовСЗачетомАвансов, Реквизиты);
	
	Для Каждого СтрокаДокумента Из ТаблицаДокумента Цикл
		
		СтрокаСписание = ТаблицаРеализация.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаСписание, СтрокаДокумента);
		
		СтрокаСписание.СуммаВал    = СтрокаДокумента.Сумма;
		СтрокаСписание.СуммаНДСВал = СтрокаДокумента.СуммаНДС;
		
	КонецЦикла;
	
	Возврат ТаблицаРеализация;
	
КонецФункции

// Выкуп ценных бумаг
Функция ПустаяТаблицаДляВыкупаЦенныхБумаг() Экспорт
	
	ОписаниеТиповСубконто = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Идентификация строки
	ПустаяТаблица.Колонки.Добавить("ИмяСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	
	// Общие разрезы учета
	ПустаяТаблица.Колонки.Добавить("КФО", Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС", Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("КЭК", Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	
	// Расчеты
	ПустаяТаблица.Колонки.Добавить("СчетРасчетов", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ПустаяТаблица.Колонки.Добавить("Договор", Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	
	// Стоимость выкупа и списание отклонения от номинала в разрезе цены размещения и отклонения цены размещения от номинала
	ПустаяТаблица.Колонки.Добавить("СуммаВыкупаРазмещение", ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаВыкупаОтклонение", ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаОтклоненияРазмещение", ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаОтклоненияОтклонение", ОписаниеТипаСуммы);
	
	// Дополнительные колонки.
	ПустаяТаблица.Колонки.Добавить("ИсточникСредств", Новый ОписаниеТипов("СправочникСсылка.ИсточникиСредств"));
	ПустаяТаблица.Колонки.Добавить("ДопКлассификация", Новый ОписаниеТипов("СправочникСсылка.ДополнительнаяБюджетнаяКлассификация"));
	ПустаяТаблица.Колонки.Добавить("КодМероприятия", Новый ОписаниеТипов("СправочникСсылка.Мероприятия"));
	ПустаяТаблица.Колонки.Добавить("КодЦели", Новый ОписаниеТипов("СправочникСсылка.ВидыЦелевыхСредств"));
	ПустаяТаблица.Колонки.Добавить("СтрокаНазначениеПлатежа", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(210));
	ПустаяТаблица.Колонки.Добавить("Примечание", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(254));
	
	Возврат ПустаяТаблица;
	
КонецФункции

// Формирует таблицу источника данных "Таблица для выкупа ценных бумаг".
//
Функция ТаблицаДляВыкупаЦенныхБумаг(Реквизиты, Параметры, Отказ) Экспорт
	
	ТаблицаРезультат = ПустаяТаблицаДляВыкупаЦенныхБумаг();
	
	Запрос = Новый Запрос;
	
	Если ТипЗнч(Реквизиты.Ссылка) = Тип("ДокументСсылка.КассовоеВыбытие") Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	""РасшифровкаПлатежа"" КАК ИмяСписка,
		|	""РасшифровкаПлатежа"" КАК СинонимСписка,
		|	КассовоеВыбытиеРасшифровкаПлатежа.НомерСтроки КАК НомерСтроки,
		|	КассовоеВыбытиеРасшифровкаПлатежа.Ссылка.Договор КАК Договор,
		|	КассовоеВыбытиеРасшифровкаПлатежа.ИсточникСредств КАК ИсточникСредств,
		|	КассовоеВыбытиеРасшифровкаПлатежа.КБКНазначениеПлатежа КАК КПС,
		|	КассовоеВыбытиеРасшифровкаПлатежа.КОСГУНазначениеПлатежа КАК КЭК,
		|	КассовоеВыбытиеРасшифровкаПлатежа.СуммаВал КАК СуммаВал,
		|	КассовоеВыбытиеРасшифровкаПлатежа.Сумма КАК Сумма,
		|	КассовоеВыбытиеРасшифровкаПлатежа.КодЦели КАК КодЦели,
		|	КассовоеВыбытиеРасшифровкаПлатежа.КодМероприятия КАК КодМероприятия,
		|	КассовоеВыбытиеРасшифровкаПлатежа.ДопКлассификация КАК ДопКлассификация,
		|	"""" КАК СтрокаНазначениеПлатежа,
		|	КассовоеВыбытиеРасшифровкаПлатежа.Примечание КАК Примечание,
		|	КассовоеВыбытиеРасшифровкаПлатежа.КФО КАК КФО
		|ПОМЕСТИТЬ ТабЧасть
		|ИЗ
		|	Документ.КассовоеВыбытие.РасшифровкаПлатежа КАК КассовоеВыбытиеРасшифровкаПлатежа
		|ГДЕ
		|	КассовоеВыбытиеРасшифровкаПлатежа.Ссылка = &Ссылка"
	ИначеЕсли ТипЗнч(Реквизиты.Ссылка) = Тип("ДокументСсылка.ЗаявкаНаКассовыйРасход") Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	""РасшифровкаПлатежа"" КАК ИмяСписка,
		|	""РасшифровкаПлатежа"" КАК СинонимСписка,
		|	ЗаявкаНаКассовыйРасходРасшифровкаПлатежа.НомерСтроки КАК НомерСтроки,
		|	ЗаявкаНаКассовыйРасходРасшифровкаПлатежа.Ссылка.Договор КАК Договор,
		|	ЗаявкаНаКассовыйРасходРасшифровкаПлатежа.ИсточникСредств КАК ИсточникСредств,
		|	ЗаявкаНаКассовыйРасходРасшифровкаПлатежа.КБКНазначениеПлатежа КАК КПС,
		|	ЗаявкаНаКассовыйРасходРасшифровкаПлатежа.КОСГУНазначениеПлатежа КАК КЭК,
		|	ЗаявкаНаКассовыйРасходРасшифровкаПлатежа.СуммаВал КАК СуммаВал,
		|	ЗаявкаНаКассовыйРасходРасшифровкаПлатежа.Сумма КАК Сумма,
		|	ЗаявкаНаКассовыйРасходРасшифровкаПлатежа.КодЦели КАК КодЦели,
		|	ЗаявкаНаКассовыйРасходРасшифровкаПлатежа.КодМероприятия КАК КодМероприятия,
		|	ЗаявкаНаКассовыйРасходРасшифровкаПлатежа.ДопКлассификация КАК ДопКлассификация,
		|	ЗаявкаНаКассовыйРасходРасшифровкаПлатежа.СтрокаНазначениеПлатежа КАК СтрокаНазначениеПлатежа,
		|	ЗаявкаНаКассовыйРасходРасшифровкаПлатежа.Примечание КАК Примечание,
		|	ЗаявкаНаКассовыйРасходРасшифровкаПлатежа.КФО КАК КФО
		|ПОМЕСТИТЬ ТабЧасть
		|ИЗ
		|	Документ.ЗаявкаНаКассовыйРасход.РасшифровкаПлатежа КАК ЗаявкаНаКассовыйРасходРасшифровкаПлатежа
		|ГДЕ
		|	ЗаявкаНаКассовыйРасходРасшифровкаПлатежа.Ссылка = &Ссылка"
	ИначеЕсли ТипЗнч(Реквизиты.Ссылка) = Тип("ДокументСсылка.ЗаявкаНаКассовыйРасходСокращенная") Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	"""" КАК ИмяСписка,
		|	"""" КАК СинонимСписка,
		|	0 КАК НомерСтроки,
		|	ЗаявкаНаКассовыйРасходСокращенная.Договор КАК Договор,
		|	ЗаявкаНаКассовыйРасходСокращенная.ИсточникСредств КАК ИсточникСредств,
		|	ЗаявкаНаКассовыйРасходСокращенная.КБКНазначениеПлатежа КАК КПС,
		|	ЗаявкаНаКассовыйРасходСокращенная.КОСГУНазначениеПлатежа КАК КЭК,
		|	ЗаявкаНаКассовыйРасходСокращенная.СуммаДокумента КАК СуммаВал,
		|	ЗаявкаНаКассовыйРасходСокращенная.СуммаДокумента КАК Сумма,
		|	ЗаявкаНаКассовыйРасходСокращенная.КодЦели КАК КодЦели,
		|	ЗаявкаНаКассовыйРасходСокращенная.КодМероприятия КАК КодМероприятия,
		|	ЗаявкаНаКассовыйРасходСокращенная.ДопКлассификация КАК ДопКлассификация,
		|	"""" КАК СтрокаНазначениеПлатежа,
		|	"""" КАК Примечание,
		|	ЗаявкаНаКассовыйРасходСокращенная.КФО КАК КФО
		|ПОМЕСТИТЬ ТабЧасть
		|ИЗ
		|	Документ.ЗаявкаНаКассовыйРасходСокращенная КАК ЗаявкаНаКассовыйРасходСокращенная
		|ГДЕ
		|	ЗаявкаНаКассовыйРасходСокращенная.Ссылка = &Ссылка";
	ИначеЕсли ТипЗнч(Реквизиты.Ссылка) = Тип("ДокументСсылка.ПлатежноеПоручение") Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	""РасшифровкаПлатежа"" КАК ИмяСписка,
		|	""РасшифровкаПлатежа"" КАК СинонимСписка,
		|	ПлатежноеПоручениеРасшифровкаПлатежа.НомерСтроки КАК НомерСтроки,
		|	ПлатежноеПоручениеРасшифровкаПлатежа.Ссылка.Договор КАК Договор,
		|	ПлатежноеПоручениеРасшифровкаПлатежа.ИсточникСредств КАК ИсточникСредств,
		|	ПлатежноеПоручениеРасшифровкаПлатежа.КБКНазначениеПлатежа КАК КПС,
		|	ПлатежноеПоручениеРасшифровкаПлатежа.КОСГУНазначениеПлатежа КАК КЭК,
		|	ПлатежноеПоручениеРасшифровкаПлатежа.Сумма КАК СуммаВал,
		|	ПлатежноеПоручениеРасшифровкаПлатежа.Сумма КАК Сумма,
		|	ПлатежноеПоручениеРасшифровкаПлатежа.КодЦели КАК КодЦели,
		|	ПлатежноеПоручениеРасшифровкаПлатежа.КодМероприятия КАК КодМероприятия,
		|	ПлатежноеПоручениеРасшифровкаПлатежа.ДопКлассификация КАК ДопКлассификация,
		|	"""" КАК СтрокаНазначениеПлатежа,
		|	"""" КАК Примечание,
		|	ПлатежноеПоручениеРасшифровкаПлатежа.КФО КАК КФО
		|ПОМЕСТИТЬ ТабЧасть
		|ИЗ
		|	Документ.ПлатежноеПоручение.РасшифровкаПлатежа КАК ПлатежноеПоручениеРасшифровкаПлатежа
		|ГДЕ
		|	ПлатежноеПоручениеРасшифровкаПлатежа.Ссылка = &Ссылка";
	Иначе
		ВызватьИсключение НСтр("ru='Для данного типа документа не предусмотрено заполнение источника данных'")
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + "
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////";
	
	Запрос.Текст = Запрос.Текст + "
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.Договоры) КАК Договор,
	|	СУММА(ВЫБОР
	|			КОГДА ЖурналПроводокЕПСБУОстатки.Субконто3 = ЗНАЧЕНИЕ(Перечисление.ВидыРасчетовПоЗаймам.СтоимостьРазмещенияЦБ)
	|				ТОГДА ВЫБОР
	|						КОГДА &ИспользоватьВалютныйУчет
	|								И ЖурналПроводокЕПСБУОстатки.Счет.Валютный
	|							ТОГДА ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаОстатокКт
	|						ИНАЧЕ ЖурналПроводокЕПСБУОстатки.СуммаОстатокКт
	|					КОНЕЦ
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СуммаРазмещения,
	|	СУММА(ВЫБОР
	|			КОГДА ЖурналПроводокЕПСБУОстатки.Субконто3 = ЗНАЧЕНИЕ(Перечисление.ВидыРасчетовПоЗаймам.ОтклонениеОтНоминала)
	|				ТОГДА ВЫБОР
	|						КОГДА &ИспользоватьВалютныйУчет
	|								И ЖурналПроводокЕПСБУОстатки.Счет.Валютный
	|							ТОГДА ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаОстатокКт
	|						ИНАЧЕ ЖурналПроводокЕПСБУОстатки.СуммаОстатокКт
	|					КОНЕЦ
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СуммаОтклонения
	|ПОМЕСТИТЬ Остатки
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&ПериодОстатков,
	|			Счет = &СчетРасчетов,
	|			,
	|			Субконто2 В
	|				(ВЫБРАТЬ
	|					Т.Договор
	|				ИЗ
	|					ТабЧасть КАК Т)) КАК ЖурналПроводокЕПСБУОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ЖурналПроводокЕПСБУОстатки.Субконто2
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабЧасть.ИмяСписка КАК ИмяСписка,
	|	ТабЧасть.СинонимСписка КАК СинонимСписка,
	|	ТабЧасть.НомерСтроки КАК НомерСтроки,
	|	ТабЧасть.Договор КАК Договор,
	|	Договоры.Наименование КАК НаименованиеДоговора,
	|	ЕСТЬNULL(Договоры.НоминальнаяСтоимость, 0) КАК НоминальнаяСтоимость,
	|	ТабЧасть.ИсточникСредств КАК ИсточникСредств,
	|	ТабЧасть.КПС КАК КПС,
	|	ТабЧасть.КЭК КАК КЭК,
	|	ТабЧасть.СуммаВал КАК СуммаВал,
	|	ТабЧасть.Сумма КАК Сумма,
	|	ТабЧасть.КодЦели КАК КодЦели,
	|	ТабЧасть.КодМероприятия КАК КодМероприятия,
	|	ТабЧасть.ДопКлассификация КАК ДопКлассификация,
	|	ТабЧасть.СтрокаНазначениеПлатежа КАК СтрокаНазначениеПлатежа,
	|	ТабЧасть.Примечание КАК Примечание,
	|	ТабЧасть.КФО КАК КФО,
	|	ЕСТЬNULL(Остатки.СуммаРазмещения, 0) КАК СуммаРазмещения,
	|	ЕСТЬNULL(Остатки.СуммаОтклонения, 0) КАК СуммаОтклонения
	|ИЗ
	|	ТабЧасть КАК ТабЧасть
	|		ЛЕВОЕ СОЕДИНЕНИЕ Остатки КАК Остатки
	|		ПО ТабЧасть.Договор = Остатки.Договор
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Договоры КАК Договоры
	|		ПО ТабЧасть.Договор = Договоры.Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Реквизиты.Ссылка);
	Запрос.УстановитьПараметр("СчетРасчетов", Параметры.СчетРасчетов);
	Запрос.УстановитьПараметр("ПериодОстатков", УчетРасчетов.ПериодПолученияОстатков(Реквизиты.Ссылка));
	Запрос.УстановитьПараметр("ИспользоватьВалютныйУчет", ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() > 1 Тогда
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='При выкупе ценных бумаг допустимо заполнять только одну строку табличной части. Проведение невозможно!'"),
			Выборка.НаименованиеДоговора);
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Реквизиты.Ссылка,,, Отказ);
		Возврат ТаблицаРезультат;
	КонецЕсли;
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = ТаблицаРезультат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		СуммаОстатка = Выборка.СуммаРазмещения + Выборка.СуммаОтклонения;
		
		Если Выборка.НоминальнаяСтоимость = 0 Тогда
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='Для ценной бумаги по договору ""%1"" не указана номинальная стоимость. Проведение невозможно!'"),
				Выборка.НаименованиеДоговора);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Реквизиты.Ссылка,,, Отказ);
			Возврат ТаблицаРезультат;
		ИначеЕсли СуммаОстатка = 0 Тогда
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='На счете ""%1"" нет остатков по договору ""%2"".
				|Возможно ценная бумага еще не размещена или уже вся выкуплена. Проведение невозможно!'"),
				Параметры.СчетРасчетов,
				Выборка.НаименованиеДоговора);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Реквизиты.Ссылка,,, Отказ);
			Возврат ТаблицаРезультат;
		КонецЕсли;
		
		// Определим количество ЦБ в остатке
		КоличествоВсего = СуммаОстатка / Выборка.НоминальнаяСтоимость;
		
		Если КоличествоВсего < Параметры.Количество Тогда
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='На счете ""%1"" имеется %2 ценных бумаг по договору ""%3"", а выкупается %4. Проведение невозможно!'"),
				Параметры.СчетРасчетов,
				КоличествоВсего,
				Выборка.НаименованиеДоговора,
				Параметры.Количество);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Реквизиты.Ссылка,,, Отказ);
			Возврат ТаблицаРезультат;
		КонецЕсли;
		
		// Рассчитаем номинальную стоимость выкупаемых ЦБ
		НомСтоимость = Параметры.Количество * Выборка.НоминальнаяСтоимость;
		
		// Рассчитаем долю суммы отклонения в остатке
		ДоляОтклонения = Окр(Выборка.СуммаОтклонения / СуммаОстатка, 6);
		
		// Распределим суммы выплаты за ЦБ 
		НоваяСтрока.СуммаВыкупаОтклонение = Окр(Выборка.СуммаВал * ДоляОтклонения, 2);
		НоваяСтрока.СуммаВыкупаРазмещение = Выборка.СуммаВал - НоваяСтрока.СуммаВыкупаОтклонение;
		
		// Распределим суммы отклонения суммы выплаты за ЦБ от номинала
		Если КоличествоВсего = Параметры.Количество Тогда
			НоваяСтрока.СуммаОтклоненияОтклонение = Выборка.СуммаОтклонения - НоваяСтрока.СуммаВыкупаОтклонение;
			НоваяСтрока.СуммаОтклоненияРазмещение = Выборка.СуммаРазмещения - НоваяСтрока.СуммаВыкупаРазмещение;
		Иначе
			НоваяСтрока.СуммаОтклоненияОтклонение = Окр((НомСтоимость - Выборка.СуммаВал) * ДоляОтклонения, 2);
			НоваяСтрока.СуммаОтклоненияРазмещение = НомСтоимость - Выборка.СуммаВал - НоваяСтрока.СуммаОтклоненияОтклонение;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаРезультат;
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция СчетУчетаОбъектаФинансовыхВложений(СвойстваОбъекта, Счет = "204", Дата = Неопределено, Организация = Неопределено) Экспорт
	
	Если СвойстваОбъекта.ВидВложения = ПредопределенноеЗначение("Перечисление.ВидыФинансовыхВложений.ЦенныеБумаги") Тогда
		Если СвойстваОбъекта.ВидЦеннойБумаги = ПредопределенноеЗначение("Перечисление.ВидыЦенныхБумаг.Облигация") Тогда
			СубСчет = "21";
		ИначеЕсли СвойстваОбъекта.ВидЦеннойБумаги = ПредопределенноеЗначение("Перечисление.ВидыЦенныхБумаг.Вексель") Тогда
			СубСчет = "22";
		Иначе
			СубСчет = "23";
		КонецЕсли;
	ИначеЕсли СвойстваОбъекта.ВидВложения = ПредопределенноеЗначение("Перечисление.ВидыФинансовыхВложений.УчастиеВКапитале") Тогда
		Если СвойстваОбъекта.ФормаУчастияВКапитале = ПредопределенноеЗначение("Перечисление.ФормыУчастияВКапитале.Акции") Тогда
			СубСчет = "31";
		Иначе
			СубСчет = "34";
		КонецЕсли;
	Иначе
		СубСчет = "53";
	КонецЕсли;
	
	Возврат БухгалтерскийУчет.СчетПоКоду(Счет + "." + СубСчет, Дата, Организация);
	
КонецФункции

Функция СчетРасчетовПоСчетуУчетаВложенийВФинансовыеАктивы(СчетВложений, Дата, Организация) Экспорт
	
	СчетРасчетов = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	
	Если Не ЗначениеЗаполнено(СчетВложений) Тогда
		Возврат СчетРасчетов;
	КонецЕсли;
	
	Если БухгалтерскийУчет.СчетВИерархии(СчетВложений, "215.20") Тогда
		СчетРасчетов = БухгалтерскийУчет.СчетПоКоду("302.72", Дата, Организация);
	ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СчетВложений, "215.30") Тогда
		СчетРасчетов = БухгалтерскийУчет.СчетПоКоду("302.73", Дата, Организация);
	Иначе
		СчетРасчетов = БухгалтерскийУчет.СчетПоКоду("302.75", Дата, Организация);
	КонецЕсли;
	
	Возврат СчетРасчетов;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#КонецОбласти
