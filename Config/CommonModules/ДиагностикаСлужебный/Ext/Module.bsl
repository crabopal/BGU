
Функция СоздатьСтруктуруОшибки()
	
	Возврат Новый Структура("Описание, Код, ИмяМодуля, ИсходнаяСтрока, НомерСтроки, Объект, Причина");
	
КонецФункции

// Функция формирует код ошибки из сообщений об ошибках, генерируемых
// платформой.
//
// Параметры:
//  ИнформацияОбОшибке - ИнформацияОбОшибке - результат вызова функции
//                 ИнформацияОбОшибке().
//
// Возвращаемое значение:
//  Строка. Сгенерированное локальное имя ошибки.
//
Функция СгенерироватьКодОшибки(ИнформацияОбОшибке)
	
	Если ИнформацияОбОшибке.Причина <> Неопределено Тогда
		Описание = ИнформацияОбОшибке.Причина.Описание;
	Иначе
		Описание = ИнформацияОбОшибке.Описание;
	КонецЕсли;
	
	ВидОшибки = "XC"; // exception - исключительная ситуация
	
	Если Найти(Описание, " XDTO") <> 0 Тогда
		КодСоздателя = "XD"; // XDTO
	ИначеЕсли Найти(Описание, " XML") <> 0 Тогда
		КодСоздателя = "ML"; // XML
	ИначеЕсли Найти(Описание, "параметр номер") <> 0 Тогда
		КодСоздателя = "CT"; // contract - система проверки входных и выходных данных (контракты)
		ВидОшибки = "SE";    // static error - ошибка в коде конфигурации
	ИначеЕсли Найти(Описание, "Поле объекта не обнаружено") <> 0 Или Найти(Описание, "Метод объекта не обнаружен") <> 0 Тогда
		КодСоздателя = "EE"; // execution environment - среда исполнения
		ВидОшибки = "SE";    // static error - ошибка в коде конфигурации
	ИначеЕсли Найти(Описание, "Значение не является значением объектного типа") <> 0 Тогда
		КодСоздателя = "EE";
		ВидОшибки = "RE";    // run-time error - ошибка времени исполнения
	ИначеЕсли Найти(Описание, "Операция не выполнена!") <> 0 Тогда
		КодСоздателя = "EH"; // event-handler, обработчик события
		ВидОшибки = "RT"; 	 // rollback transaction. Ошибка вызвана отказом в процедуре "ПриЗаписи"
	Иначе
		КодСоздателя = "V8";
	КонецЕсли;
	
	Возврат КодСоздателя
	     + ВидОшибки
	     + "0000"; // код ошибки - неизвестен
	
КонецФункции
