Функция ЗначенияДополнительныхРеквизитовИзФормы(Форма) Экспорт
	
	ДопРеквизиты = Новый Структура;
	
	Для каждого ТекРеквизит Из Форма["БухгалтерскиеОперации_ДобавленныеРеквизитыОперации"] Цикл
		
		Если Не ТекРеквизит.НеПовторять
			И ЗначениеЗаполнено(ТекРеквизит.ИмяДляФормулы)
			И НЕ ЗначениеЗаполнено(ТекРеквизит.ИмяТаблицы)
			И НЕ ТекРеквизит.ЭтоГруппа Тогда
			
			ДопРеквизиты.Вставить(ТекРеквизит.ИмяДляФормулы, Форма[ТекРеквизит.ИмяРеквизита]);
				
		КонецЕсли;
		
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ДопРеквизиты, КурсИКратностьИзФормы(Форма));
	ДопРеквизиты.Вставить("ИсправлениеОшибки", ВариантИсправленияОшибкиИзФормы(Форма));
	
	Возврат ДопРеквизиты;
	
КонецФункции

Функция КурсИКратностьИзФормы(Форма) Экспорт
	
	Результат = Новый Структура;
	Курс = БухгалтерскиеОперацииКлиентСервер.ЗначениеДополнительногоРеквизитаИзФормы(
			Форма,
			"Курс");
	Кратность = БухгалтерскиеОперацииКлиентСервер.ЗначениеДополнительногоРеквизитаИзФормы(
			Форма,
			"Кратность");
	Если Курс <> Неопределено Тогда
		Результат.Вставить("Курс", Курс);
	КонецЕсли;
	Если Кратность <> Неопределено Тогда
		Результат.Вставить("Кратность", Кратность);
	КонецЕсли;
	
	Возврат Результат; 
	
КонецФункции

Функция ВариантИсправленияОшибкиИзФормы(Форма) Экспорт
	
	ИсправлениеОшибок = ЗначениеДополнительногоРеквизитаИзФормы(Форма, ИмяРеквизитаФлажокИсправлениеОшибокПрошлыхЛет()) = Истина;
	Если ИсправлениеОшибок Тогда
		Возврат ЗначениеДополнительногоРеквизитаИзФормы(Форма, ИмяРеквизитаПереключательИсправлениеОшибокПрошлыхЛет());
	Иначе
		Возврат ПредопределенноеЗначение("Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.НеОшибка");
	КонецЕсли;
	
КонецФункции

// Проверять заполнение дополнительных реквизитов.
// 
// Параметры:
//  Объект - ДокументОбъект
//         - ДанныеФормыСтруктура:
//            * Резервировать - Булево
// 
// Возвращаемое значение:
//  Булево - Проверять заполнение дополнительных реквизитов
Функция ПроверятьЗаполнениеДополнительныхРеквизитов(Объект) Экспорт
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "Резервировать")
			И Объект.Резервировать Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
	
КонецФункции

// Функция проверяет заполнение обязательных реквизитов операции.
// Если элемент недоступен, то его заполнение не проверяется.
//
// Параметры:
//	Форма - ФормаКлиентскогоПриложения, ДанныеФормыСтруктура - форма.
//	СообщатьОбОшибках - Булево
//
// Возвращаемое значение:
//	Булево - Истина - все реквизиты заполнены, Ложь - есть не заполненные.
//
Функция ОбязательныеРеквизитыЗаполнены(Форма, СообщатьОбОшибках = Истина) Экспорт
	Перем СписокОшибок;
	
	РеквизитыЗаполнены = Истина;
	Для каждого ТекРеквизит Из Форма["БухгалтерскиеОперации_ДобавленныеРеквизитыОперации"] Цикл
	
		Если ТекРеквизит.Обязательный И ТекРеквизит.ВидимостьПоФО И ТекРеквизит.Видимость Тогда
			
			Если Не ЗначениеЗаполнено(ТекРеквизит.ИмяТаблицы) Тогда
				Если Не ЗначениеЗаполнено(Форма[ТекРеквизит.ИмяРеквизита]) Тогда
					
					ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(,,ТекРеквизит.Заголовок);
					ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(СписокОшибок, ТекРеквизит.ИмяРеквизита,
						ТекстОшибки, Неопределено);
					РеквизитыЗаполнены = Ложь;
					
				КонецЕсли;
			Иначе
				
				Если ТекРеквизит.ПредопределеннаяТЧ Тогда
					ТаблицаОбъекта = Форма.Объект[ТекРеквизит.ИмяТаблицы];
					ПолеОшибки = "Объект." + ТекРеквизит.ИмяТаблицы + "[%1]." + ТекРеквизит.ИмяРеквизита;
				Иначе
					ТаблицаОбъекта = Форма[ТекРеквизит.ИмяРеквизитаТаблицы];
					ПолеОшибки = ТекРеквизит.ИмяРеквизитаТаблицы + "[%1]." + ТекРеквизит.ИмяРеквизита;
				КонецЕсли;
				
				НомерСтроки = 0;
				Для каждого СтрокаТаблицы Из ТаблицаОбъекта Цикл
					НомерСтроки = НомерСтроки + 1;
				
					Если Не ЗначениеЗаполнено(СтрокаТаблицы[ТекРеквизит.ИмяРеквизита]) Тогда
						
						ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",,
							ТекРеквизит.Заголовок, НомерСтроки, ТекРеквизит.ЗаголовокТаблицы);
						ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(СписокОшибок, ПолеОшибки, ТекстОшибки,
							ТекРеквизит.ИмяТаблицы, (НомерСтроки - 1), ТекстОшибки, (НомерСтроки - 1));
						РеквизитыЗаполнены = Ложь;
						
					КонецЕсли;
				
				КонецЦикла;
				
			КонецЕсли;
		КонецЕсли;
	
	КонецЦикла;
	
	Если ЭтоИсправлениеОшибокПрошлыхЛет(Форма) Тогда
	
		ПорядокИсправления = Форма[ИмяРеквизитаПереключательИсправлениеОшибокПрошлыхЛет()];
		Если ПорядокИсправления <> ПредопределенноеЗначение("Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода")
			И ПорядокИсправления <> ПредопределенноеЗначение("Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода") Тогда
			
			ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(,,
							НСтр("ru = 'Порядок исправления ошибок прошлых лет'"));
			ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(СписокОшибок,
				ИмяРеквизитаПереключательИсправлениеОшибокПрошлыхЛет(),
				ТекстОшибки, Неопределено);
			РеквизитыЗаполнены = Ложь;
				
		КонецЕсли;
		
		Если ТребуетсяЗаполнениеВыявителяОшибок(Форма) Тогда
			Выявитель = Форма[ИмяРеквизитаПереключательВыявительОшибкиПрошлыхЛет()];
			Если Не ЗначениеЗаполнено(Выявитель) Тогда
				
				ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(,,
								НСтр("ru = 'Выявитель ошибки'"));
				ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(СписокОшибок,
					ИмяРеквизитаПереключательВыявительОшибкиПрошлыхЛет(),
					ТекстОшибки, Неопределено);
				РеквизитыЗаполнены = Ложь;
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Если СписокОшибок <> Неопределено И СообщатьОбОшибках Тогда
	
		ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(СписокОшибок);
	
	КонецЕсли;
	
	Возврат РеквизитыЗаполнены;
	
КонецФункции

// Функция возвращает номер символа-окончания слова, в которое входит символ с номером НачНомер.
// Словом здесь считается набор символов состоящий из букв латиницы и кирилицы, цифр и символа подчеркивание.
//
// Параметры:
//  Текст  - строка - Исходый текст
//  НачНомер  - Число - номер начального символа
//
// Возвращаемое значение:
//   Число   - номер символа окончания слова
//
Функция НомерСимволаОкончанияСлова(Текст, НачНомер=1) Экспорт

	Для Счетчик = 1 по СтрДлина(Текст) цикл
		
		Если НЕ РазрешенныйСимволСлова(КодСимвола(Текст, Счетчик)) Тогда
			Возврат Счетчик - 1;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Счетчик;

КонецФункции // НомерСимволаОкончанияСлова()

// Проверяет по коду символа относится ли он к буквам кирилицы, латиницы, цифрам или является подчеркиванием
//
// Параметры:
//  КодСимвола  - Число - Проверяемый код символа
//
// Возвращаемое значение:
//   Булево - Истина - это разрешенный символ имени переменной, Ложь - недопустимый символ
//
Функция РазрешенныйСимволСлова(КодСимвола) Экспорт

	Если (КодСимвола 	>= 1040	И КодСимвола <= 1103)  	// кирилица
		ИЛИ (КодСимвола >= 65 	И КодСимвола <= 90) 	// латиница
		ИЛИ (КодСимвола >= 97 	И КодСимвола <= 122) 	// латиница
		ИЛИ (КодСимвола >= 48 	И КодСимвола <= 57)		// цифры
		ИЛИ КодСимвола 	=  95 Тогда						// подчеркивание
			  
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;

КонецФункции // РазрешенныйСимволСлова()

Процедура УдалитьЗапрещенныеСимволыИзИмени(Имя) Экспорт

	ДлинаИмени = СтрДлина(Имя);
	
	Если ДлинаИмени = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Результат = "";
	Для ИндексБуквы = 1 По ДлинаИмени Цикл
		
		Буква = Сред(Имя, ИндексБуквы, 1);
		Если ЭтоЦифра(Буква) ИЛИ ЭтоБуква(Буква) Тогда
			Результат = Результат + Буква;
		Иначе
			Результат = Результат + "_";
		КонецЕсли;
	
	КонецЦикла;
	
	ПерваяБуква = Сред(Результат, 1, 1);
	Если (НЕ ЭтоБуква(ПерваяБуква))
		И ПерваяБуква <> "_" Тогда
		
		Имя = "_"+Результат;
		
	Иначе
		
		Имя = Результат;	
		
	КонецЕсли;

КонецПроцедуры // УдалитьЗапрещенныеСимволыИзИмени()

Функция ЭтоКорректныйИдентификаторОбъекта(Имя) Экспорт
	Длина = СтрДлина(Имя);
	
	Если Длина = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПервыйСимвол = Лев(Имя, 1);
	Если НЕ (ЭтоБуква(ПервыйСимвол) ИЛИ ПервыйСимвол = "_") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для ИндексБуквы = 2 По Длина Цикл
		Буква = Сред(Имя, ИндексБуквы, 1);
		Если НЕ (Буква = "_" ИЛИ ЭтоЦифра(Буква) ИЛИ ЭтоБуква(Буква)) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
КонецФункции

Функция ИмяГруппыДляВыводаТиповойОперацииНаФорму() Экспорт

	Возврат "ТиповаяОперацияДокумента";

КонецФункции // ИмяГруппыДляВыводаТиповойОперацииНаФорму()

Процедура ОбновитьКурсВалютыВФормеДокумента(Форма, Объект, ИзмениласьДата = Ложь, ИзмениласьВалюта = Ложь) Экспорт

	Если Форма.КэшПараметров.Служебные.ОбновлятьКурсВалютыАвтоматически Тогда
		
		ИзмениласьДата   = (НачалоДня(Форма.КэшПараметров.Дата) <> НачалоДня(Объект.Дата));
		ИзмениласьВалюта = (Форма.КэшПараметров.ВалютаДокумента <> Объект.ВалютаДокумента);
		
		Если ИзмениласьВалюта ИЛИ 
			(ИзмениласьДата И Объект.ВалютаДокумента <> Форма.КэшПараметров.ВалютаРегламентированногоУчета) Тогда
			
			КурсКратность = БухгалтерскиеОперацииВызовСервера.ПолучитьКурсВалюты(Объект.ВалютаДокумента, Объект.Дата);
			Форма[ИмяРеквизитаФормыПоИмениДляФормулы(Форма, "Курс")] = КурсКратность.Курс;
			Форма[ИмяРеквизитаФормыПоИмениДляФормулы(Форма, "Кратность")] = КурсКратность.Кратность;
			
			Форма.КэшПараметров.ВалютаДокумента = Объект.ВалютаДокумента; // Запомнили новое значение.
			
			#Если Клиент Тогда
			БухгалтерскиеОперацииКлиент.ПоказатьОповещениеПриИзмененииКурсаВалюты(ИзмениласьДата, ИзмениласьВалюта);
			#КонецЕсли
			
		Иначе
			ИзмениласьДата   = Ложь;
			ИзмениласьВалюта = Ложь;
		КонецЕсли;
		
		Форма.КэшПараметров.Служебные.ИзмениласьДатаДляКонтроляКурса   = ИзмениласьДата;
		Форма.КэшПараметров.Служебные.ИзмениласьВалютаДляКонтроляКурса = ИзмениласьВалюта;
		
	КонецЕсли;

КонецПроцедуры

// Получает значение дополнительного реквизита типовой операции из формы документа по имени для формулы.
// Если проводки формируются отдельно, в документе не выбрана типовая операция или у нее нет такого
// дополнительного реквизита, то возвращается Неопределено
//
// Параметры:
//  Форма			 - ФормаКлиентскогоПриложения - Форма документа.
//  ИмяДляФормулы	 - Строка - ИмяДляФормулы дополнительного реквизита типовой операции.
// 
// Возвращаемое значение:
// Неопределено, ЛюбаяСсылка - значение указанного дополнительного реквизита.
//
Функция ЗначениеДополнительногоРеквизитаИзФормы(Форма, ИмяДляФормулы) Экспорт

	СтрокаТаблицы = СтрокаРеквизитаПоИмениДляФормулы(Форма, ИмяДляФормулы, "");
	Возврат ?(СтрокаТаблицы <> Неопределено, Форма[СтрокаТаблицы.ИмяРеквизита], Неопределено);

КонецФункции

// Возвращает ИмяДляФормулы реквизита типовой операции, значение которого содержится в указанном элементе формы.
// Если указанный элемент формы не относится к типовой операции, то возвращается пустая строка.
//
// Параметры:
//  Форма	 - ФормаКлиентскогоПриложения - форма документа.
//  Элемент	 - ПолеФормы - элемент формы, для которого требуется получить ИмяДляФормулы.
// 
// Возвращаемое значение:
//  Строка - ИмяДляФормулы дополнительного реквизита операции или пустая строка.
//
Функция ИмяДляФормулыЭлементаФормыДополнительногоРеквизита(Форма, Элемент) Экспорт

	СтрокаТаблицы = СтрокаРеквизитаПоИмениЭлемента(Форма, Элемент.Имя);
	Возврат ?(СтрокаТаблицы <> Неопределено, СтрокаТаблицы.ИмяДляФормулы, "");

КонецФункции

// Возвращает "Имя" реквизита формы, значение которого содержится в указанном элементе формы.
// Если указанный элемент формы не относится к типовой операции, то возвращается пустая строка.
//
// Параметры:
//  Форма	 - ФормаКлиентскогоПриложения - форма документа.
//  Элемент	 - ПолеФормы - элемент формы, для которого требуется получить ИмяДляФормулы.
// 
// Возвращаемое значение:
//  Строка - значение свойства "Имя" реквизита формы или пустая строка.
//
Функция ИмяРеквизитаЭлементаФормыДополнительногоРеквизита(Форма, Элемент) Экспорт

	СтрокаТаблицы = СтрокаРеквизитаПоИмениЭлемента(Форма, Элемент.Имя);
	Возврат ?(СтрокаТаблицы <> Неопределено, СтрокаТаблицы.ИмяРеквизита, "");

КонецФункции

Функция ИмяЭлементаФормыДополнительногоРеквизита(Форма, ИмяРеквизита) Экспорт

	Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма,
		"БухгалтерскиеОперации_ДобавленныеРеквизитыОперации") Тогда
		
		Возврат "";
	КонецЕсли;
	
	РеквизитыФормы = Форма["БухгалтерскиеОперации_ДобавленныеРеквизитыОперации"].НайтиСтроки(
		Новый Структура("ИмяРеквизита", ИмяРеквизита));
	Если РеквизитыФормы.Количество() = 1 Тогда
		Возврат РеквизитыФормы[0].ИмяЭлемента;
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

Функция ИмяЭлементаФормыПоИмениДляФормулы(Форма, ИмяДляФормулы) Экспорт

	СтрокаТаблицы = СтрокаРеквизитаПоИмениДляФормулы(Форма, ИмяДляФормулы, "");
	Возврат ?(СтрокаТаблицы <> Неопределено, СтрокаТаблицы.ИмяЭлемента, "");
	
КонецФункции

// Устанавливает значение реквизита формы, связанного с дополнительным реквизитом типовой операции.
// Возвращает Истина, если реквизит формы найден, Ложь - если реквизита формы нет или проводки формируются
// отдельно.
//
// Параметры:
//  Форма			 - ФормаКлиентскогоПриложения - форма документа.
//  ИмяДляФормулы	 - Строка - ИмяДляФормулы дополнительного реквизита типовой операции.
//  Значение		 - Произвольный - устанавливаемое значение.
// 
// Возвращаемое значение:
//  Булево - Истина - значение установлено, Ложь - реквизит формы не найден.
//
Функция УстановитьЗначениеДополнительногоРеквизитаИзФормы(Форма, ИмяДляФормулы, Значение) Экспорт

	Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма,
		"БухгалтерскиеОперации_ДобавленныеРеквизитыОперации") Тогда
		
		Возврат Ложь;
	КонецЕсли;
	
	СтрокиДопРеквизита = Форма.БухгалтерскиеОперации_ДобавленныеРеквизитыОперации.НайтиСтроки(
		Новый Структура("ИмяДляФормулы", ВРег(ИмяДляФормулы)));
	
	Если СтрокиДопРеквизита.Количество() = 1 Тогда
		Форма[СтрокиДопРеквизита[0].ИмяРеквизита] = Значение;
		Форма.Модифицированность = Истина;
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;

КонецФункции

