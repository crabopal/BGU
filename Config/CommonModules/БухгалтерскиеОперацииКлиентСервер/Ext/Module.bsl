Процедура УстановитьСвойстваЗависимыхЭлементов(Форма, Объект, ИмяРеквизитаФормы) Экспорт
	
	ИзменяемыеЭлементы = ПолучитьСписокЗависимыхЭлементовФормы(
		Форма["БухгалтерскиеОперации_СписокЗависимыхЭлементов"],
		ИмяРеквизитаФормы);
		
	Если ИзменяемыеЭлементы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураИменЭлементов = Новый Структура;
	Для каждого ТекЭлемент Из ИзменяемыеЭлементы Цикл
		СтруктураИменЭлементов.Вставить("Субконто" + ТекЭлемент.НомерСубконто, ТекЭлемент.ИмяЭлемента);
	КонецЦикла;

	Если СтрНачинаетсяС(ИмяРеквизитаФормы, "Объект.") Тогда
		Счет = Объект[СтрРазделить(ИмяРеквизитаФормы, ".")[1]];
	Иначе
		Счет = Форма[ИмяРеквизитаФормы];
	КонецЕсли;

	Если ЗначениеЗаполнено(Счет) Тогда
		СвойстваСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(Счет);
		КоличествоСубконто = СвойстваСчета.КоличествоСубконто;
	Иначе
		КоличествоСубконто = 0;
	КонецЕсли;
	
	Для Счетчик = 1 По БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьМаксКоличествоСубконто() Цикл
		ИмяЭлемента = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураИменЭлементов, "Субконто" + Счетчик, "");
		
		СтрокаРеквизита = СтрокаРеквизитаПоИмениЭлемента(Форма, ИмяЭлемента);
		Если СтрокаРеквизита = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если Счетчик <= КоличествоСубконто Тогда
			СтрокаРеквизита.Видимость    = Истина;
			СтрокаРеквизита.Заголовок    = СвойстваСчета["ВидСубконто" + Счетчик + "Наименование"];
		Иначе
			СтрокаРеквизита.Видимость    = Ложь;
			СтрокаРеквизита.Заголовок    = "";
		КонецЕсли;
		
	КонецЦикла;
	
	#Если ВебКлиент Тогда
	ОчиститьЗначенияНевидимыхЗависимыхЭлементовФормы(Форма, ИзменяемыеЭлементы);
	#КонецЕсли
	
КонецПроцедуры

Процедура ОбновитьВидимостьОбязательныхЭлементов(Форма) Экспорт

	ИмяРеквизитаТиповаяОперация = ИмяРеквизитыФормыТиповаяОперацияФактическое(Форма);
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, ИмяРеквизитаТиповаяОперация) Тогда
		ТиповаяОперация = Форма[ИмяРеквизитаТиповаяОперация];
	ИначеЕсли ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "Объект")
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма.Объект, ИмяРеквизитаТиповаяОперация) Тогда
		ТиповаяОперация = Форма.Объект[ИмяРеквизитаТиповаяОперация];
	Иначе
		Возврат;
	КонецЕсли;

	ТиповаяОперацияЗаполнена = ЗначениеЗаполнено(ТиповаяОперация);

	// Кнопка "Предварительный просмотр операции"
	УстановитьСвойствоВОписаниеПоИмениЭлемента(Форма,
		ПрефиксЭлементовОперации() + "ОткрытьОперацию",
		"Видимость",
		ТиповаяОперацияЗаполнена И ВидимостьКомандыПредварительногоПросмотраОперации(Форма));
	
	УстановитьСвойствоВОписаниеПоИмениДляФормулы(Форма,
		"Курс",
		"Видимость",
		ТиповаяОперацияЗаполнена);
	УстановитьСвойствоВОписаниеПоИмениДляФормулы(Форма,
		"Кратность",
		"Видимость",
		ТиповаяОперацияЗаполнена);
	УстановитьСвойствоВОписаниеПоИмениРеквизита(Форма,
		ИмяКомандыФормыОбновитьКурсВалюты(),
		"Видимость",
		ТиповаяОперацияЗаполнена);
	 	
	// "Исправление ошибок"
	ИсправлениеОшибок = ЗначениеРеквизитаФормыПоИмениДляФормулы(Форма,
		ИмяРеквизитаФлажокИсправлениеОшибокПрошлыхЛет(),
		Ложь);
	ВидимостьВыявителя = ТребуетсяЗаполнениеВыявителяОшибок(Форма);
	УстановитьСвойствоВОписаниеПоИмениДляФормулы(Форма,
		ИмяРеквизитаФлажокИсправлениеОшибокПрошлыхЛет(),
		"Видимость",
		ТиповаяОперацияЗаполнена);
	УстановитьСвойствоВОписаниеПоИмениДляФормулы(Форма,
		ИмяРеквизитаПереключательИсправлениеОшибокПрошлыхЛет(),
		"Видимость",
		ТиповаяОперацияЗаполнена И ИсправлениеОшибок);
	УстановитьСвойствоВОписаниеПоИмениДляФормулы(Форма,
		ИмяРеквизитаПереключательВыявительОшибкиПрошлыхЛет(),
		"Видимость",
		ТиповаяОперацияЗаполнена И ИсправлениеОшибок И ВидимостьВыявителя);
	ВидимостьПричиныОшибки = ТребуетсяЗаполнениеПричиныОшибки(Форма);
	УстановитьСвойствоВОписаниеПоИмениДляФормулы(Форма,
		ИмяРеквизитаПереключательПричинаОшибкиПрошлыхЛет(),
		"Видимость",
		ТиповаяОперацияЗаполнена И ИсправлениеОшибок И ВидимостьПричиныОшибки);
	
КонецПроцедуры

Процедура УстановитьЗначениеПоУмолчаниюИсправленияОшибок(Форма) Экспорт
	
	РеквизитИсправлениеОшибок = ИмяРеквизитаФормыПоИмениДляФормулы(Форма,
		ИмяРеквизитаФлажокИсправлениеОшибокПрошлыхЛет());
	
	Если Не ЗначениеЗаполнено(РеквизитИсправлениеОшибок) ИЛИ Не Форма[РеквизитИсправлениеОшибок] Тогда
		Возврат;
	КонецЕсли;
	
	ДопустимыеЗначения = Новый Массив;
	ДопустимыеЗначения.Добавить(ПредопределенноеЗначение("Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода"));
	ДопустимыеЗначения.Добавить(ПредопределенноеЗначение("Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода"));
	
	РеквизитПорядокИсправления = ИмяРеквизитаФормыПоИмениДляФормулы(Форма,
		ИмяРеквизитаПереключательИсправлениеОшибокПрошлыхЛет());
	
	Если ДопустимыеЗначения.Найти(Форма[РеквизитПорядокИсправления]) = Неопределено Тогда
			
		Форма[РеквизитПорядокИсправления]
			= ПредопределенноеЗначение("Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода");
		
	КонецЕсли;
				
	РеквизитВыявительОшибок = ИмяРеквизитаФормыПоИмениДляФормулы(Форма,
		ИмяРеквизитаПереключательВыявительОшибкиПрошлыхЛет());
		
	Если Не ЗначениеЗаполнено(Форма[РеквизитВыявительОшибок]) Тогда
		
		Форма[РеквизитВыявительОшибок]
			= ПредопределенноеЗначение("Перечисление.ВыявительОшибокПрошлыхЛет.Самостоятельно");
		
	КонецЕсли;
	
КонецПроцедуры

