Функция ИмяРеквизитыФормыТиповаяОперацияФактическое(Форма) Экспорт

	НайденыСтроки = Форма["БухгалтерскиеОперации_ДобавленныеРеквизитыОперации"]
		.НайтиСтроки(Новый Структура("ИмяДляФормулы", "ТиповаяОперация"));
	
	Если НайденыСтроки.Количество() = 0 Тогда
		Возврат ИмяРеквизитаФормыТиповаяОперация();
	Иначе
		Возврат НайденыСтроки[0].ИмяРеквизита;
	КонецЕсли;

КонецФункции

Функция ШаблонИмениРеквизитаФормы() Экспорт
	Возврат "БухгалтерскиеОперации_%1_%2";
КОнецФункции

// Функция возвращает массив структур с именами элементов формы, которые зависят от изменения данного реквизита
// и номерами субконто от которых зависит реквизит.
// 
// Параметры:
//  СписокЗависимыхЭлементов - СписокЗначений из Строка - Список зависимых элементов
//  ИмяРеквизитаФормы - Строка - Имя реквизита формы
// 
// Возвращаемое значение:
//  Массив из Структура:
//   * ИмяРеквизита - Строка
//   * НомерСубконто - Число
//   * ИмяЭлемента - Строка
//
Функция ПолучитьСписокЗависимыхЭлементовФормы(СписокЗависимыхЭлементов, ИмяРеквизитаФормы) Экспорт

	ИзменяемыеЭлементы = Новый Массив;
	Для каждого ТекЗначениеСписка Из СписокЗависимыхЭлементов Цикл
	
		Если ТекЗначениеСписка.Значение.ВедущийРеквизит = ИмяРеквизитаФормы Тогда
			
			ИзменяемыеЭлементы.Добавить(Новый Структура("ИмяРеквизита, НомерСубконто, ИмяЭлемента",
				ТекЗначениеСписка.Значение.ЗависимыйРеквизит,
				ТекЗначениеСписка.Значение.ПорядокРеквизита,
				ТекЗначениеСписка.Значение.ЗависимыйЭлемент));
			
		КонецЕсли;
	
	КонецЦикла;

	Возврат ИзменяемыеЭлементы;
	
КонецФункции // ПолучитьСписокЗависимыхЭлементов()

// Возвращает префикс "ТиповыеОперации_"
// 
// Возвращаемое значение:
//  Строка - Префикс элементов операции
Функция ПрефиксЭлементовОперации() Экспорт

	Возврат "ТиповыеОперации_";

КонецФункции // ПрефиксЭлементовОперации()

