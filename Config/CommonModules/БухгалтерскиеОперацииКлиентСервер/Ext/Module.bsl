Функция ДатаДокументаИзФормы(Форма)
	ДатаДокумента = Неопределено;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "Объект")
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма.Объект, "Дата") Тогда
			
		ДатаДокумента = Форма.Объект.Дата;
		
		#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
		Если Не ЗначениеЗаполнено(ДатаДокумента) Тогда
			ДатаДокумента = ОбщегоНазначения.ТекущаяДатаПользователя();
		КонецЕсли;
		#КонецЕсли
	КонецЕсли;
	Возврат ДатаДокумента;
КонецФункции

Функция ТребуетсяЗаполнениеВыявителяОшибок(Форма)
	
	ДатаНачалаИспользованияВыявителя = '2021.01.01';
	ДатаДокумента = ДатаДокументаИзФормы(Форма);
	
	Если ДатаДокумента <> Неопределено И ДатаДокумента < ДатаНачалаИспользованияВыявителя Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ТребуетсяЗаполнениеПричиныОшибки(Форма)
	
	Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма,
		ИмяРеквизитаПереключательВыявительОшибкиПрошлыхЛет()) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ДатаНачалаИспользованияВыявителя = '2023.01.01';
	ДатаДокумента = ДатаДокументаИзФормы(Форма);
	
	Если ДатаДокумента <> Неопределено И ДатаДокумента < ДатаНачалаИспользованияВыявителя Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Выявитель = Форма[ИмяРеквизитаПереключательВыявительОшибкиПрошлыхЛет()];
	
	Возврат Выявитель = ПредопределенноеЗначение("Перечисление.ВыявительОшибокПрошлыхЛет.Самостоятельно");
	
КонецФункции

Функция ЭтоИсправлениеОшибокПрошлыхЛет(Форма)
	
	ТипБулево = Новый ОписаниеТипов("Булево");
	ИмяРеквизита = ИмяРеквизитаФлажокИсправлениеОшибокПрошлыхЛет(); 
	Возврат ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, ИмяРеквизита)
		И ТипБулево.ПривестиЗначение(Форма[ИмяРеквизита]);
		
КонецФункции

Процедура ОчиститьЗначенияНевидимыхЗависимыхЭлементовФормы(Форма, ИзменяемыеЭлементы)
	
	Для Каждого Элемент Из ИзменяемыеЭлементы Цикл
		ОписаниеРеквизита = СтрокаРеквизитаПоИмениЭлемента(Форма, Элемент.ИмяЭлемента);
		Если ОписаниеРеквизита <> Неопределено И НЕ ОписаниеРеквизита.Видимость Тогда
			Форма[Элемент.ИмяРеквизита] = Неопределено;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьСвойствоВОписаниеПоИмениЭлемента(Форма, ИмяЭлемента, ИмяСвойства, ЗначениеСвойства)
	ОписаниеЭлемента = СтрокаРеквизитаПоИмениЭлемента(Форма, ИмяЭлемента);	
	Если ОписаниеЭлемента <> Неопределено Тогда
		ОписаниеЭлемента[ИмяСвойства] = ЗначениеСвойства;
	КонецЕсли;
КонецПроцедуры

Процедура УстановитьСвойствоВОписаниеПоИмениРеквизита(Форма, ИмяРеквизита, ИмяСвойства, ЗначениеСвойства)
	ОписаниеЭлемента = СтрокаРеквизитаПоИмениРеквизита(Форма, ИмяРеквизита);	
	Если ОписаниеЭлемента <> Неопределено Тогда
		ОписаниеЭлемента[ИмяСвойства] = ЗначениеСвойства;
	КонецЕсли;
КонецПроцедуры

Процедура УстановитьСвойствоВОписаниеПоИмениДляФормулы(Форма, ИмяДляФормулы, ИмяСвойства, ЗначениеСвойства)
	ОписаниеЭлемента = СтрокаРеквизитаПоИмениДляФормулы(Форма, ИмяДляФормулы);	
	Если ОписаниеЭлемента <> Неопределено Тогда
		ОписаниеЭлемента[ИмяСвойства] = ЗначениеСвойства;
	КонецЕсли;
КонецПроцедуры

Функция ЗначениеРеквизитаФормыПоИмениДляФормулы(Форма, ИмяДляФормулы, ЗначениеПоУмолчанию = "")
	СтрокаОписания = СтрокаРеквизитаПоИмениДляФормулы(Форма, ИмяДляФормулы);
	Если СтрокаОписания = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	Иначе
		Возврат Форма[СтрокаОписания.ИмяРеквизита];
	КонецЕсли;
КонецФункции

Функция ВидимостьКомандыПредварительногоПросмотраОперации(Форма)
	Возврат НЕ ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Форма.Объект, "Проведен", Истина);
КонецФункции

Процедура УстановитьСвойстваЗависимыхРеквизитовФормы(Форма)

	ВедущиеЭлементы = Новый Массив;

	Для каждого ОписаниеЗависимости Из Форма["БухгалтерскиеОперации_СписокЗависимыхЭлементов"] Цикл

		Если ВедущиеЭлементы.Найти(ОписаниеЗависимости.Значение.ВедущийРеквизит) = Неопределено Тогда
			
			ОписаниеРеквизита = СтрокаРеквизитаПоИмениРеквизита(
				Форма,
				ОписаниеЗависимости.Значение.ВедущийРеквизит);
			Если ОписаниеРеквизита = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			УстановитьСвойстваЗависимыхЭлементов(Форма, Форма.Объект, ОписаниеРеквизита.ИмяРеквизита);
			
			ВедущиеЭлементы.Добавить(ОписаниеЗависимости.Значение.ВедущийРеквизит);

		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Функция СтрокаРеквизитаПоИмениДляФормулы(Форма, ИмяДляФормулы, ИмяТабличнойЧасти = "") Экспорт

	Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма,
		"БухгалтерскиеОперации_ДобавленныеРеквизитыОперации") Тогда
		
		Возврат Неопределено;
	КонецЕсли;

	// В таблице ИмяДляФормулы приводится к верхнему регистру, кроме
	// реквизитов табличной части
	Отбор = Новый Структура("ИмяТаблицы, ИмяДляФормулы", ИмяТабличнойЧасти,
		?(ИмяТабличнойЧасти = "", ВРЕГ(ИмяДляФормулы), ИмяДляФормулы));
	
	СтрокиТаблицыРеквизитов = Форма["БухгалтерскиеОперации_ДобавленныеРеквизитыОперации"].НайтиСтроки(Отбор);
	
	Если СтрокиТаблицыРеквизитов.Количество() = 0 Тогда
		// Поиск без изменения регистра
		Отбор = Новый Структура("ИмяТаблицы, ИмяДляФормулы", ИмяТабличнойЧасти, ИмяДляФормулы);
		СтрокиТаблицыРеквизитов = Форма["БухгалтерскиеОперации_ДобавленныеРеквизитыОперации"].НайтиСтроки(Отбор);
	КонецЕсли;
	
	Если СтрокиТаблицыРеквизитов.Количество() > 0 Тогда
		Возврат СтрокиТаблицыРеквизитов[0];
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

Функция СтрокаРеквизитаПоИмениЭлемента(Форма, ИмяЭлемента) Экспорт

	Если НЕ ЗначениеЗаполнено(ИмяЭлемента)
		ИЛИ Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма,
		"БухгалтерскиеОперации_ДобавленныеРеквизитыОперации") Тогда
		
		Возврат Неопределено;
	КонецЕсли;
	
	РеквизитыФормы = Форма["БухгалтерскиеОперации_ДобавленныеРеквизитыОперации"].НайтиСтроки(
		Новый Структура("ИмяЭлемента", ИмяЭлемента));
	Если РеквизитыФормы.Количество() > 0 Тогда
		Возврат РеквизитыФормы[0];
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

Функция СтрокаРеквизитаПоИмениРеквизита(Форма, ИмяРеквизита) Экспорт

	Если НЕ ЗначениеЗаполнено(ИмяРеквизита)
		ИЛИ Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма,
		"БухгалтерскиеОперации_ДобавленныеРеквизитыОперации") Тогда
		
		Возврат Неопределено;
	КонецЕсли;
	
	РеквизитыФормы = Форма["БухгалтерскиеОперации_ДобавленныеРеквизитыОперации"].НайтиСтроки(
		Новый Структура("ИмяРеквизита", ИмяРеквизита));
	Если РеквизитыФормы.Количество() > 0 Тогда
		Возврат РеквизитыФормы[0];
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции


Функция ЭтоБуква(Буква)
	Возврат Найти("еоатинркулмДСвПдОсКцчыгзпбТНИьБФхВяРАЗЭйУЕГМЦжщЙШЩЫЛЯЧЬХЪЖЮЁёшъфэю"
		+ "QWERTYUIOPASDFGHJKLZXCVBNMqwertyuiopasdfghjklzxcvbnm", Буква) > 0;
КонецФункции

Функция ЭтоЦифра(Буква)

	Возврат Найти("1234567890", Буква)>0;

КонецФункции

