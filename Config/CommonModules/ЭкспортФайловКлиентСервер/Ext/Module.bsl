#Область ПрограммныйИнтерфейс

// Функция - Получить соединение с интернет
//
// Параметры:
//  Настройка	 - СправочникСсылка.КС_ДопНастройкиОбмена - настройка обмена, в которой указаны настройки подключения
//				 - Структура - содержит настройки подключения;
//	                           обязательные поля: Протокол, Сервер;
//							   необязательные поля: Порт, Логин, Пароль, Таймаут, ПассивноеСоединение.
//  АдресРесурса - Строка - возвращает строку адреса ресурса на сервере, по которому расположен ресурс
// Возвращаемое значение:
// Соединение - в зависимости от протокола HTTPСоединение, FTPСоединение или Неопределено
//
Функция ПолучитьСоединениеСИнтернет(Настройка, АдресРесурса = Неопределено) Экспорт
	
#Если Не ВебКлиент Тогда
		
	Если ТипЗнч(Настройка) = Тип("СправочникСсылка.НастройкиОбменаБанкиКС") Тогда			
		Значения = ЭкспортФайлов.ПараметрыНастройкиОбменаБанкиКС(Настройка);	
	Иначе		
		Значения = Настройка;	
	КонецЕсли;
	
	Сервер					= Значения.Сервер;
	
	Протокол				= НРег(Значения.Протокол);
	Защищеное				= (Прав(Протокол, 1) = "s");
		
	Порт					= ЗначениеКлючаНастройки(Значения, "Порт"); 
	Пользователь			= ЗначениеКлючаНастройки(Значения, "Логин");
	Пароль					= ЗначениеКлючаНастройки(Значения, "Пароль");
	Таймаут					= ЗначениеКлючаНастройки(Значения, "Таймаут");			
	ЗащищенноеСоединение	= ?(Защищеное, Новый ЗащищенноеСоединениеOpenSSL, Неопределено);
	ПассивноеСоединение		= ЗначениеКлючаНастройки(Значения, "ПассивноеСоединение");
	
	АдресРесурса			= ЗначениеКлючаНастройки(Значения, "ПутьНаСервере");
	
	#Если Клиент Тогда		
		Прокси 				= ПолучитьПроксиНаКлиенте(Протокол);//если обмен на клиенте, то и прокси нужно получать на клиенте		
	#Иначе
		Прокси              = ЭкспортФайлов.ПолучитьПрокси(Протокол);//если обмен на сервере, то и прокси получим на сервере, функцией БСП
	#КонецЕсли
			
	Если Протокол = "http" Или Протокол = "https" Тогда		
		Соединение = Новый HTTPСоединение(Сервер, Порт, Пользователь, Пароль, Прокси, Таймаут, ЗащищенноеСоединение);
	ИначеЕсли Протокол = "ftp" Или Протокол = "ftps" Тогда	
		Соединение = Новый FTPСоединение(Сервер, Порт, Пользователь, Пароль, Прокси, ПассивноеСоединение, Таймаут, ЗащищенноеСоединение);
	Иначе
		Соединение = Неопределено;
	КонецЕсли;
	
	Возврат Соединение;
	
#Иначе
	ВызватьИсключение НСтр("ru = 'Недопустимый вызов метода в веб-клиенте.'");
#КонецЕсли

КонецФункции

Функция ПолучитьПроксиНаКлиенте(URLИлиПротокол)
	
	ДопустимыеПротоколы = Новый Соответствие();
	ДопустимыеПротоколы.Вставить("HTTP",  Истина);
	ДопустимыеПротоколы.Вставить("HTTPS", Истина);
	ДопустимыеПротоколы.Вставить("FTP",   Истина);
	ДопустимыеПротоколы.Вставить("FTPS",  Истина);
	
	Если СтрНайти(URLИлиПротокол, "://") > 0 Тогда
		СтруктураURL = ОбщегоНазначенияКлиентСервер.СтруктураURI(URLИлиПротокол);
		Протокол = ?(ПустаяСтрока(СтруктураURL.Схема), "http", СтруктураURL.Схема);
	Иначе
		Протокол = НРег(URLИлиПротокол);
	КонецЕсли;
	
	Если ДопустимыеПротоколы[ВРег(Протокол)] = Неопределено Тогда
		Протокол = "HTTP";
	КонецЕсли;
	
	НастройкаПроксиСервера = ЭкспортФайлов.ПолучитьНастройкиПроксиНаКлиенте();
	
	Если НастройкаПроксиСервера = Неопределено Тогда
		// Системные установки прокси-сервера.
		Возврат Неопределено;
	КонецЕсли;
	
	ИспользоватьПрокси = НастройкаПроксиСервера.Получить("ИспользоватьПрокси");
	Если Не ИспользоватьПрокси Тогда
		// Не использовать прокси-сервер.
		Возврат Новый ИнтернетПрокси(Ложь);
	КонецЕсли;
	
	ИспользоватьСистемныеНастройки = НастройкаПроксиСервера.Получить("ИспользоватьСистемныеНастройки");
	Если ИспользоватьСистемныеНастройки Тогда
		// Системные настройки прокси-сервера.
		Возврат Новый ИнтернетПрокси(Истина);
	КонецЕсли;
	
	// Настройки прокси-сервера, заданные вручную.
	Прокси = Новый ИнтернетПрокси;
	
	// Определение адреса и порта прокси-сервера.
	ДополнительныеНастройки = НастройкаПроксиСервера.Получить("ДополнительныеНастройкиПрокси");
	ПроксиПоПротоколу = Неопределено;
	Если ТипЗнч(ДополнительныеНастройки) = Тип("Соответствие") Тогда
		ПроксиПоПротоколу = ДополнительныеНастройки.Получить(Протокол);
	КонецЕсли;
	
	ИспользоватьАутентификациюОС = НастройкаПроксиСервера.Получить("ИспользоватьАутентификациюОС");
	ИспользоватьАутентификациюОС = ?(ИспользоватьАутентификациюОС = Истина, Истина, Ложь);
	
	Если ТипЗнч(ПроксиПоПротоколу) = Тип("Структура") Тогда
		Прокси.Установить(Протокол, ПроксиПоПротоколу.Адрес, ПроксиПоПротоколу.Порт,
			НастройкаПроксиСервера["Пользователь"], НастройкаПроксиСервера["Пароль"], ИспользоватьАутентификациюОС);
	Иначе
		Прокси.Установить(Протокол, НастройкаПроксиСервера["Сервер"], НастройкаПроксиСервера["Порт"], 
			НастройкаПроксиСервера["Пользователь"], НастройкаПроксиСервера["Пароль"], ИспользоватьАутентификациюОС);
	КонецЕсли;
	
	Прокси.НеИспользоватьПроксиДляЛокальныхАдресов = НастройкаПроксиСервера["НеИспользоватьПроксиДляЛокальныхАдресов"];
	
	АдресаИсключений = НастройкаПроксиСервера.Получить("НеИспользоватьПроксиДляАдресов");
	Если ТипЗнч(АдресаИсключений) = Тип("Массив") Тогда
		Для каждого АдресИсключения Из АдресаИсключений Цикл
			Прокси.НеИспользоватьПроксиДляАдресов.Добавить(АдресИсключения);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Прокси;
КонецФункции

Функция ВОтветеЕстьДанные(СообщениеОтвет,ИдентификаторСообщенияДляПодтверждения) Экспорт
		
	ИскомыйУзел = "Envelope";
		
	Инд = 1;
	ЧитаемыйОтвет = СообщениеОтвет;
	ПозицияНачала = СтрНайти(СообщениеОтвет,"<");
	ПозицияОкончания = СтрНайти(СообщениеОтвет,">");
	
	Пока ПозицияНачала <> 0 И ПозицияОкончания<>0 Цикл
		
		ЧитаемыйБлок = Сред(СообщениеОтвет,ПозицияНачала,ПозицияОкончания-ПозицияНачала+1);
		Если СтрНайти(ЧитаемыйБлок,ИскомыйУзел)>0 Тогда
			ЧитаемыйОтвет = Сред(СообщениеОтвет,ПозицияНачала,СтрНайти(СообщениеОтвет,ИскомыйУзел+">")-ПозицияНачала+СтрДлина(ИскомыйУзел+">"));
			Прервать;
		Иначе
			Инд = Инд + 1;
		КонецЕсли;
		
		ПозицияНачала = СтрНайти(СообщениеОтвет,"<",,,Инд);
		ПозицияОкончания = СтрНайти(СообщениеОтвет,">",,,Инд);
		
	КонецЦикла;
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ЧитаемыйОтвет);//СтрТЧ.СообщениеОтвет);
	
	ПостроительDOM = Новый ПостроительDOM;
	Попытка
		ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
	Исключение
		//ДобавитьОшибку(СтрТЧ.ТаблицаОшибок, "Не удалось разобрать ответ", "");
		Возврат Ложь;
	КонецПопытки;
	
	//Ошибки СМЭВ:
	ОбъектСхемы = ДокументDOM.ПолучитьЭлементыПоИмени("Fault");
	//не удалось отправить сообщение
	Если ОбъектСхемы.Количество()>0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОбъектСхемы = ДокументDOM.ПолучитьЭлементыПоИмени("SenderProvidedResponseData");
	//если есть узел SenderProvidedResponseData или SenderProvidedRequestData, значит есть ответ
	Если ОбъектСхемы.Количество()=0 Тогда
		ОбъектСхемы = ДокументDOM.ПолучитьЭлементыПоИмени("SenderProvidedRequestData");
		Если ОбъектСхемы.Количество()=0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	ИдентификаторСообщенияДляПодтверждения = "";
	СписокЭлементов = ОбъектСхемы.Элемент(0).ПолучитьЭлементыПоИмени("MessageID");
	Если СписокЭлементов.Количество() Тогда
		ИдентификаторСообщенияДляПодтверждения = СписокЭлементов[0].ТекстовоеСодержимое;
	КонецЕсли;
	
	Возврат Истина;
		
КонецФункции

Процедура ДобавитьОшибку(ТаблицаОшибок, ТекстОшибки, ПолеФайла = "") Экспорт
	
	Ошибка = ТаблицаОшибок.Добавить();
	Ошибка.ПолеФайла = ПолеФайла;
	Ошибка.Ошибка = ТекстОшибки;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗначениеКлючаНастройки(Настройка, Ключ)
	
	Значение = Неопределено;
	
	Если Настройка.Свойство(Ключ, Значение) И Не ЗначениеЗаполнено(Значение) Тогда
		Значение = Неопределено;
	КонецЕсли;
	
	Возврат Значение;	
	
КонецФункции	

#КонецОбласти
