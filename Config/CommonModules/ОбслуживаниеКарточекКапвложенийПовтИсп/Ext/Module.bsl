#Область ПрограммныйИнтерфейс

// Формирует массив счетов капвложений, для целей учета данных для заполнения
// карточек капвложений. Это счета 106.хх с субконто "Основные средства"
//
// Возвращаемое значение:
//	Массив - массив ссылок на счета капвложений
Функция СчетаКапвложенийДляКарточкиКапвложений() Экспорт
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕПСБУВидыСубконто.Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|ГДЕ
	|	ПОДСТРОКА(ЕПСБУВидыСубконто.Ссылка.Код, 1, 3) = ""106""
	|	И ЕПСБУВидыСубконто.ВидСубконто В (&ВидСубконто)
	|	И НЕ ЕПСБУВидыСубконто.Ссылка.ЭлементГруппа
	|СГРУППИРОВАТЬ ПО
	|	ЕПСБУВидыСубконто.Ссылка";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	МассивВидовСубконто = Новый Массив;
	МассивВидовСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	Запрос.УстановитьПараметр("ВидСубконто", МассивВидовСубконто);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
КонецФункции	

#КонецОбласти