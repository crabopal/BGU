// ПРОГРАММНЫЙ ИНТЕРФЕЙС

Процедура ИнициализироватьАвтозаполнение(ОтчетОбъект,ФормаОтчета) Экспорт 

	ПравилоЗаполнения = РегистрыСведений.ОсновныеПравилаЗаполнения.ПолучитьОсновноеПравило(ОтчетОбъект.ВидОтчета);
	ФормаОтчета.ПравилоЗаполнения = ПравилоЗаполнения;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПравилаЗаполнения.Ссылка,
		|	ПравилаЗаполнения.Наименование,
		|	ВЫБОР
		|		КОГДА ПравилаЗаполнения.Ссылка = &Ссылка
		|			ТОГДА 1
		|		ИНАЧЕ 2
		|	КОНЕЦ КАК ПолеПорядка,
		|	ПравилаЗаполнения.Код КАК Код
		|ИЗ
		|	Справочник.ПравилаЗаполнения КАК ПравилаЗаполнения
		|ГДЕ
		|	ПравилаЗаполнения.Владелец = &Владелец
		|	И ПравилаЗаполнения.НеИспользуется = ЛОЖЬ
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПолеПорядка,
		|	Код";
	
	Запрос.УстановитьПараметр("Владелец", ОтчетОбъект.ВидОтчета);
	Запрос.УстановитьПараметр("Ссылка", ПравилоЗаполнения);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	НесколькоПравил = Ложь;
	Если Выборка.Количество()>1 Тогда
		НесколькоПравил = Истина;
	КонецЕсли;
	
	Инд = 0;
	ОбработкаЗаполнения = Обработки.ОбработкаДанныхОтчетности.Создать();
	
	РасшифровкаПоказателей = Ложь;
	Пока Выборка.Следующий() Цикл
		
		НовСтр = ФормаОтчета.ТаблицаПравилЗаполнения.Добавить();
		НовСтр.Правило = Выборка.Ссылка;
		НовСтр.ИмяКоманды = "Правило"+Инд+"__";
		
		Если НесколькоПравил Тогда
						
			ЭлементГруппаКоманд = ФормаОтчета.Элементы.Добавить(НовСтр.ИмяКоманды,Тип("ГруппаФормы"),ФормаОтчета.Элементы.ПодменюЗаполнить);
			ЭлементГруппаКоманд.Заголовок = Выборка.Наименование;
			ЭлементГруппаКоманд.Вид = ВидГруппыФормы.Подменю;
			ОбработкаЗаполнения.ЗарегистрироватьКомандыОтчетнойФормы(ФормаОтчета, Выборка.Ссылка,ЭлементГруппаКоманд);
			
			Если Выборка.ПолеПорядка = 1 Тогда
				ЭлементГруппаКоманд.Картинка = БиблиотекаКартинок.ЗолотойШар;
			КонецЕсли;
			
		Иначе
			НовСтр.ИмяКоманды = "";
			ФормаОтчета.ПравилоЗаполнения = Выборка.Ссылка;
			ОбработкаЗаполнения.ЗарегистрироватьКомандыОтчетнойФормы(ФормаОтчета, Выборка.Ссылка);
		КонецЕсли;
		
		Если НЕ РасшифровкаПоказателей Тогда
			СписокОбластейЗаполнения = Справочники.ПравилаЗаполнения.ПолучитьСписокОбластей(Выборка.Ссылка,,Истина);
			Если СписокОбластейЗаполнения.Количество() > 0 Тогда		
				РасшифровкаПоказателей = Истина;
			КонецЕсли;
			
		КонецЕсли;
		Инд = Инд+1;
	КонецЦикла;
	
	Если Инд>0 Тогда
		НоваяКоманда = ФормаОтчета.Команды.Добавить("ВсеПравила");
		НоваяКоманда.Действие = "Подключаемый_ВсеПравила";
		НоваяКоманда.Заголовок = "Все правила заполнения";
	
		НовыйЭлемент = ФормаОтчета.Элементы.Добавить("ВсеПравила", Тип("КнопкаФормы"), ФормаОтчета.Элементы.ПодменюЗаполнить);
		НовыйЭлемент.ИмяКоманды = "ВсеПравила";
	КонецЕсли;
	
	ФормаОтчета.РасшифровкаПоказателей = РасшифровкаПоказателей;
	
КонецПроцедуры // ИнициализироватьАвтозаполнение()

Процедура ВосстановитьДанныеРасшифровки(ОтчетОбъект,ФормаОтчета) Экспорт 
		
	ВнутренниеДанныеРасчетов = ОтчетОбъект.ПолучитьДанныеРасчетов();
	
	Если ОтчетОбъект.мКопирование <> Истина Тогда
		//настройки для заполнения по правилу заполнения с настройкой восстанавливаем только если не копируется документ
		ФормаОтчета.АдресСохраненныхНастроек = ПоместитьВоВременноеХранилище(ВнутренниеДанныеРасчетов, ФормаОтчета.УникальныйИдентификатор);
	КонецЕсли;

	Значение = Неопределено;
	Если ТипЗнч(ВнутренниеДанныеРасчетов) = Тип("Структура") 
		И ВнутренниеДанныеРасчетов.Свойство("ТаблицаРасшифровки", Значение) 
		И ТипЗнч(Значение) = Тип("ТаблицаЗначений") Тогда		
		ФормаОтчета.АдресТаблицыРасшифровки = ПоместитьВоВременноеХранилище(Значение, ФормаОтчета.УникальныйИдентификатор);
	КонецЕсли;
	
КонецПроцедуры // ВосстановитьДанныеРасшифровки()

////////////////////////////////////////////////////////////////////////////////
// МЕХАНИЗМ ЗАПОЛНЕНИЯ В ФОНОВОМ ЗАДАНИИ

Функция ВыполнитьФоновоеЗаполнение(Знач ПараметрыВыполения) Экспорт
	
	ОтчетОбъект = ПолучитьОбъектОтчета(ПараметрыВыполения.ФормаОтчета);
	
	//Получаем структуру, содержащую все данные документ объект (для заполнения в фоновом задании по структуре).
	СтруктураОтчетОбъект = ПреобразоватьДокументОбъектВСтруктуру(ОтчетОбъект);
	ПараметрыВыполения.ФормаОтчета.Объект = СтруктураОтчетОбъект;
	
	Если ЭтоАдресВременногоХранилища(ПараметрыВыполения.АдресПараметров) Тогда
		ПараметрыВыполения.ПараметрыМетода = ПолучитьИзВременногоХранилища(ПараметрыВыполения.АдресПараметров);
	КонецЕсли;	
	
	НаименованиеФоновогоЗадания = НСтр("ru = 'Заполнение регламентированного отчета'");
	Результат = ДлительныеОперации.ЗапуститьВыполнениеВФоне(
		ПараметрыВыполения.УникальныйИдентификатор, 
		"Обработки.ОбработкаДанныхОтчетности.ЗаполнитьОтчетВФоне", 
		ПараметрыВыполения, 
		НаименованиеФоновогоЗадания);
		
	Возврат Результат;
	
КонецФункции

Функция ПреобразоватьДокументОбъектВСтруктуру(ОтчетОбъект)
	
	СтруктураПоОтчетОбъект = Новый Структура;
	
	// Реквизиты документа, требуются все реквизиты для формирования параметров отчета.
	СтруктураПоОтчетОбъект.Вставить("ВидОтчета");
	СтруктураПоОтчетОбъект.Вставить("Организация");
	СтруктураПоОтчетОбъект.Вставить("ПериодОтчета");
	СтруктураПоОтчетОбъект.Вставить("ЕдиницаИзмерения");
	СтруктураПоОтчетОбъект.Вставить("Состояние");
	СтруктураПоОтчетОбъект.Вставить("УровеньТочности");
	СтруктураПоОтчетОбъект.Вставить("ДатаИзменения");
	СтруктураПоОтчетОбъект.Вставить("ПравилоОбработки");
	СтруктураПоОтчетОбъект.Вставить("ПравилоПроверки");
	СтруктураПоОтчетОбъект.Вставить("Редакция");
	СтруктураПоОтчетОбъект.Вставить("ШаблонОтчета");
	СтруктураПоОтчетОбъект.Вставить("ОписаниеАналитики");
	СтруктураПоОтчетОбъект.Вставить("ИФО");
	СтруктураПоОтчетОбъект.Вставить("ОсновнойПечатныйБланк");
	
	// Стандартные реквизиты документа.
	СтруктураПоОтчетОбъект.Вставить("Ссылка");
	СтруктураПоОтчетОбъект.Вставить("Дата");
	СтруктураПоОтчетОбъект.Вставить("Номер");
	
	// Экспортные переменные документа, которые используются при заполнении отчета.
	СтруктураПоОтчетОбъект.Вставить("мПоказатели");
	СтруктураПоОтчетОбъект.Вставить("мДополнительныеРеквизиты");
	СтруктураПоОтчетОбъект.Вставить("Показатели");
	СтруктураПоОтчетОбъект.Вставить("Параметры");
	СтруктураПоОтчетОбъект.Вставить("ДополнительныеРеквизиты");
	СтруктураПоОтчетОбъект.Вставить("мПоказателиРаскрытия");
	СтруктураПоОтчетОбъект.Вставить("ПустоеЗначениеПоТипу");
	СтруктураПоОтчетОбъект.Вставить("СписокСообщений");						// Список сообщений, отображаемых в web-клиенте.
	СтруктураПоОтчетОбъект.Вставить("ЛогСообщений");						// Расширенный лог сообщений для экспортируемых функций.
	СтруктураПоОтчетОбъект.Вставить("мПоказателиДляОбработки");             // Правила расчета показателей
	СтруктураПоОтчетОбъект.Вставить("мТабРасшифровкиПоказателей");          // Таблица содержит значения показателей отчетов, на основании которых формировался результирующий отчет.
	СтруктураПоОтчетОбъект.Вставить("мПоказателиСтар");						// Копия мПоказатели, сделанная перед предыдущей записью документа.
	СтруктураПоОтчетОбъект.Вставить("ТихийРежим");
	СтруктураПоОтчетОбъект.Вставить("РежимДиалога");                        // Флаг проведения из формы
	СтруктураПоОтчетОбъект.Вставить("ДанныеПараметрикиАктуальны");			// Булево, свидетельствует о том, что данные для расчета по параметрической настройке соответствуют текущему правилу обработки.
	СтруктураПоОтчетОбъект.Вставить("ИзмененныеПоказатели");                // Структура, копирующая структуру Показатели, булевы значения элементов определяют, отличается ли значение показателя в мПоказатели и макете или нет (Истина - отличается, Ложь - нет).
	СтруктураПоОтчетОбъект.Вставить("ПоказателиДоПересчета");               // Структура, содержащая значения показателей до пересчета
	СтруктураПоОтчетОбъект.Вставить("мЧислоДопАналитик");                   // Максимальное число аналитик данного отчета
	СтруктураПоОтчетОбъект.Вставить("мНастройкиБланка");                    // Настройка свойств ячеек
	СтруктураПоОтчетОбъект.Вставить("ТабОбластиРаскрытия");                 // Данные раскрытия в теле отчета
	СтруктураПоОтчетОбъект.Вставить("мДеревоПересчета");                    // Дерево значений, определяющее пути пересчета показателей при ручном изменении какого - то.
	СтруктураПоОтчетОбъект.Вставить("мВнутренниеДанныеРасчетов");
	СтруктураПоОтчетОбъект.Вставить("мВнутренниеДанныеРасчетовИзменены");
	
	// Локальные переменные документа, используются в процедурах заполнения.
	СтруктураПоОтчетОбъект.Вставить("КэшНастроекГруппРаскрытия");          // Таблица значений - параметры групп раскрытия
	
	ЗаполнитьЗначенияСвойств(СтруктураПоОтчетОбъект,ОтчетОбъект);
	
	// Табличная часть документа.
	ТаблицаПараметрыОтчета = ОтчетОбъект.ПараметрыОтчета.Выгрузить();
	СтруктураПоОтчетОбъект.Вставить("ПараметрыОтчета",ТаблицаПараметрыОтчета);
	
	Возврат СтруктураПоОтчетОбъект;
	
КонецФункции

Функция ВыполнитьДействиеКомандыВнутр(ФормаОтчета, Знач ИмяМетода, Знач ИндексМетода, Знач ПараметрыМетода, ТекстСообщения, СтруктураОповещения) Экспорт 
	
	Если ПараметрыМетода = Неопределено И НЕ ПустаяСтрока(ИмяМетода) И ИндексМетода <> Неопределено Тогда
		
		ПараметрыМетода = Справочники.ПравилаЗаполнения.ПолучитьПараметрыМетода(ФормаОтчета.ПравилоЗаполнения, ИмяМетода, ИндексМетода);
		
	КонецЕсли;
	
	Значение = Неопределено;
	Если ТипЗнч(ПараметрыМетода) = Тип("Структура") И ПараметрыМетода.Свойство("ПравилоЗаполнения", Значение)
				И ТипЗнч(Значение) = Тип("СправочникСсылка.ПравилаЗаполнения") И ЗначениеЗаполнено(Значение) Тогда
		
		ТекущееПравилоЗаполнения = Значение;
		
	Иначе
		
		ТекущееПравилоЗаполнения = ФормаОтчета.ПравилоЗаполнения;
		
	КонецЕсли;
	
	ОбработкаЗаполнения = Обработки.ОбработкаДанныхОтчетности.Создать();
	
	ДанныеЗаполнения = Новый Структура;
	
	Если ОбработкаЗаполнения.ВыполнитьОбработкуДанных(ФормаОтчета.Объект, "ОтчетОбъект", ИмяМетода, ПараметрыМетода, ТекущееПравилоЗаполнения,
				Неопределено, ТекстСообщения, СтруктураОповещения, Истина) Тогда
				
		ДанныеЗаполнения.Вставить("ОтчетЗаполнен", Истина);
		ДанныеЗаполнения.Вставить("СтруктураОтчетОбъект", ФормаОтчета);
	Иначе
		ДанныеЗаполнения.Вставить("ОтчетЗаполнен", Ложь);
	КонецЕсли;
	
	ДанныеЗаполнения.Вставить("ТекстСообщения", ТекстСообщения);
	ДанныеЗаполнения.Вставить("СтруктураОповещения", СтруктураОповещения);
	ДанныеЗаполнения.Вставить("ИмяМетода", ИмяМетода);
	
	Возврат ДанныеЗаполнения;
	
КонецФункции

функция ПолучитьОбъектОтчета(ФормаОтчета)
	
		ОтчетОбъект 	 = ДанныеФормыВЗначение(ФормаОтчета.Объект,Тип("ДокументОбъект.УниверсальныйРегламентированныйОтчет"));
		СтруктураСвойств = ПолучитьИзВременногоХранилища(ФормаОтчета.АдресОбъектаОтчет);
		ОтчетОбъект.ЗагрузитьВнутренниеСвойства(СтруктураСвойств);
		
		ОтчетОбъект.БланкОтчета = ОтчетОбъект.ШаблонОтчета;
		ОтчетОбъект.СформироватьСтруктуруИзмененныхПоказателей();
	
	Возврат ОтчетОбъект;
КонецФункции


Процедура ПоместитьОбъектОтчета(ОтчетОбъект,ФормаОтчета)
	
	ЗначениеВДанныеФормы(ОтчетОбъект,ФормаОтчета.Объект);
	
	СтруктураТаблиц = ОтчетОбъект.ПолучитьВнутренниеСвойства();
	Если ФормаОтчета.АдресОбъектаОтчет = Неопределено Тогда
		АдресХранилища = ПоместитьВоВременноеХранилище(СтруктураТаблиц);
	Иначе
		АдресХранилища = ПоместитьВоВременноеХранилище(СтруктураТаблиц,ФормаОтчета.АдресОбъектаОтчет);
	КонецЕсли;

	ОтчетОбъект = Неопределено;

КонецПроцедуры	

// расшифровка автозаполнения

// Формирование адреса документа, выводимого, как результат расшифровки
//
Функция ВыполнитьРасшифровкуАвтозаполнения(ФормаОтчета, АдресТаблицыПоказателей) Экспорт 
 
	//СинхронизироватьКонтекстСервер(Ложь, Ложь);
	ОтчетОбъект = ПолучитьОбъектОтчета(ФормаОтчета);

	ТаблицаПоказателей = ПолучитьИзВременногоХранилища(АдресТаблицыПоказателей);
	
	
	Если ТаблицаПоказателей.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПараметрыОтображенияРасшифровки = Новый ТабличныйДокумент;
	
	МассивРезультатовРасшифровки = Новый СписокЗначений;
	
	Для каждого СтрВыделенногоПоказателя Из ТаблицаПоказателей Цикл
		
		Если ЗначениеЗаполнено(СтрВыделенногоПоказателя.ДанныеПоказателя) = Ложь Тогда
			
			Продолжить;
		
		ИначеЕсли СтрВыделенногоПоказателя.ДанныеПоказателя.СпособОбработки = Перечисления.СпособыОбработкиПоказателейОтчетов.Вычисление Тогда
			
			РезультатРасшифровки = ПодготовитьРасшифровкуВычисляемогоПоказателя(ФормаОтчета, ОтчетОбъект, СтрВыделенногоПоказателя);
			
		Иначе
			
			РезультатРасшифровки = ВызватьОбработчикРасшифровкиЗаполнения(ФормаОтчета, СтрВыделенногоПоказателя);
			
		КонецЕсли;
		
		Если РезультатРасшифровки <> Неопределено Тогда
			
			МассивРезультатовРасшифровки.Добавить(РезультатРасшифровки, СтрВыделенногоПоказателя.КодПоказателя);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ПараметрыОтображенияРасшифровки = ВывестиРезультатРасшифровки(МассивРезультатовРасшифровки, СтрВыделенногоПоказателя);
	
	ПоместитьОбъектОтчета(ОтчетОбъект, ФормаОтчета);
	
	Если ПараметрыОтображенияРасшифровки <> Неопределено Тогда
		Возврат ПоместитьВоВременноеХранилище(ПараметрыОтображенияРасшифровки);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции // ВыполнитьРасшифровкуАвтозаполнения()

Функция ПодготовитьРасшифровкуВычисляемогоПоказателя(ФормаОтчета, ОтчетОбъект, Знач СтрВыделенногоПоказателя)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПравилаОбработкиПроцедурыОбработкиПоказателей.Процедура
	|ИЗ
	|	Справочник.ПравилаОбработки.ПроцедурыОбработкиПоказателей КАК ПравилаОбработкиПроцедурыОбработкиПоказателей
	|ГДЕ
	|	ПравилаОбработкиПроцедурыОбработкиПоказателей.Ссылка = &ПравилоОбработки
	|	И ПравилаОбработкиПроцедурыОбработкиПоказателей.Показатель = &Показатель
	|	И НЕ ПравилаОбработкиПроцедурыОбработкиПоказателей.Процедура ПОДОБНО """"";
	
	Запрос.УстановитьПараметр("ПравилоОбработки",ОтчетОбъект.ПравилоОбработки);
	Запрос.УстановитьПараметр("Показатель"		,СтрВыделенногоПоказателя.Показатель);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Если ЗначениеЗаполнено(СтрВыделенногоПоказателя.ДанныеПоказателя.ГруппаРаскрытия) Тогда
			// Если у вычисляемого показателя нет формулы и он раскрываемый,
			// то, возможно, он фактически заполняемый (в раскрытии) и его можно расшифровать.
			Возврат ВызватьОбработчикРасшифровкиЗаполнения(ФормаОтчета, СтрВыделенногоПоказателя);
		КонецЕсли;
	КонецЕсли;
	
	ТаблицаРасшифровки = Документы.УниверсальныйРегламентированныйОтчет.СоздатьТаблицуДанныхРасшифровки();
	ТаблицаРасшифровки.Колонки.Удалить("ОпцииРасшифровки");
	
	ПараметрыРасшифровки = Новый Структура;
	ПараметрыРасшифровки.Вставить("ТаблицаРасшифровки",ТаблицаРасшифровки);
	ПараметрыРасшифровки.Вставить("Процедура"		  ,Выборка.Процедура);
	
	СписокОперандов = БюджетнаяОтчетность.РазобратьОперанды(Выборка.Процедура);
	
	Для Каждого ОперандФормулы Из СписокОперандов Цикл
		
		СтрПоказатель = ОтчетОбъект.мПоказатели.Найти(ОперандФормулы.Значение,"Код");
		Если Не СтрПоказатель = Неопределено Тогда
			Стр 			 = ТаблицаРасшифровки.Добавить();
			Стр.Наименование = СтрПоказатель.Наименование;
			
			Если ЗначениеЗаполнено(СтрВыделенногоПоказателя.ИнформацияОРаскрытии) Тогда
				
				СтрокаРаскрытия = СтрВыделенногоПоказателя.СтрокаТаблицыРаскрытия;
				Если СтрокаРаскрытия.Владелец().Колонки.Найти(СтрПоказатель.Код) <> Неопределено Тогда
					Стр.Значение = СтрокаРаскрытия[СтрПоказатель.Код];
				Иначе
					Стр.Значение = СтрПоказатель.Значение;
				КонецЕсли;
				
			Иначе
				Стр.Значение = СтрПоказатель.Значение;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ПараметрыРасшифровки;

КонецФункции // ПодготовитьРасшифровкуВычисляемогоПоказателя()

Функция ВывестиРезультатРасшифровки(Знач МассивРезультатовРасшифровки, Знач СтрПоказателя)

	Если МассивРезультатовРасшифровки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДокументРасшифровки         = Новый ТабличныйДокумент;
	ДанныеРасшифровкиВДокументе = Новый Соответствие;
	
	ОчереднойНомер = Неопределено;
	Для каждого ЭлементСписка Из МассивРезультатовРасшифровки Цикл
		
		РезультатРасшифровки = ЭлементСписка.Значение;
		
		Макет = Документы.УниверсальныйРегламентированныйОтчет.ПолучитьМакет("МакетРасшифровки");
		
		ЗаголовокАвтозаполнения = Макет.ПолучитьОбласть("ЗаголовокАвтозаполнения");
		ЗаголовокАвтозаполнения.Параметры.КодПоказателя = ЭлементСписка.Представление;
		
		ДокументРасшифровки.Вывести(ЗаголовокАвтозаполнения);
		
		Макеты = Новый Структура;
		Макеты.Вставить("ОбластьШапкаТаблицы" ,Макет.ПолучитьОбласть("ШапкаАвтозаполнения"));
		Макеты.Вставить("ОбластьСтрокаТаблицы",Макет.ПолучитьОбласть("СтрокаАвтозаполнения"));
		Макеты.Вставить("ОбластьИтог"		  ,Макет.ПолучитьОбласть("ОбластьИтогАвтозаполнения"));
		
		Если ТипЗнч(РезультатРасшифровки) = Тип("ТаблицаЗначений") Тогда
			
			ВывестиТаблицуРезультатаРасшифровки(ДокументРасшифровки,
												ДанныеРасшифровкиВДокументе,
												РезультатРасшифровки,
												Макеты,
												,
												ОчереднойНомер);
			
		ИначеЕсли ТипЗнч(РезультатРасшифровки) = Тип("Структура") Тогда // Это расшифровка вычисляемого показателя.
			
			Если РезультатРасшифровки.Свойство("Процедура") Тогда
				
				ОбластьФормула = Макет.ПолучитьОбласть("ОбластьФормула");
				ОбластьФормула.Параметры.НаименованиеПоказателя = СтрПоказателя.ДанныеПоказателя.Наименование;
				ОбластьФормула.Параметры.ТекстФормулы           = РезультатРасшифровки.Процедура;
				
				ДокументРасшифровки.Вывести(ОбластьФормула);
				ВывестиТаблицуРезультатаРасшифровки(ДокументРасшифровки,
													ДанныеРасшифровкиВДокументе,
													РезультатРасшифровки.ТаблицаРасшифровки,
													Макеты,
													СтрПоказателя.ДанныеПоказателя.Значение,
													ОчереднойНомер);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Новый Структура("ТабличныйДокумент,ДанныеРасшифровки", ДокументРасшифровки, ДанныеРасшифровкиВДокументе);
	
КонецФункции

Процедура ВывестиТаблицуРезультатаРасшифровки(Знач ТабДокумент, Знач ИдентификаторыРасшифровки, Знач ТаблицаРасшифровки, Знач Макеты, Знач Итог = Неопределено, ОчереднойНомер = Неопределено)
 
	ТабДокумент.Вывести(Макеты.ОбластьШапкаТаблицы);
	
	ЕстьРасшифровка = ТаблицаРасшифровки.Колонки.Найти("ОпцииРасшифровки") <> Неопределено;
	
	Для Каждого Стр Из ТаблицаРасшифровки Цикл
		
		Макеты.ОбластьСтрокаТаблицы.Параметры.Заполнить(Стр);
		
		Если ЕстьРасшифровка Тогда
			
			ОчереднойНомер = ?(ОчереднойНомер = Неопределено, 0, ОчереднойНомер + 1);
			
			ИдентификаторыРасшифровки.Вставить(ОчереднойНомер,Стр.ОпцииРасшифровки);
			Макеты.ОбластьСтрокаТаблицы.Параметры.ОпцииРасшифровки = ОчереднойНомер;
			
		КонецЕсли;
		
		ТабДокумент.Вывести(Макеты.ОбластьСтрокаТаблицы);
		
	КонецЦикла;
	
	Макеты.ОбластьИтог.Параметры.Итог = ?(Итог = Неопределено,ТаблицаРасшифровки.Итог("Значение"),Итог);
	ТабДокумент.Вывести(Макеты.ОбластьИтог);
	
КонецПроцедуры

Функция ВызватьОбработчикРасшифровкиЗаполнения(ФормаОтчета, Знач СтрВыделенногоПоказателя)
	
	Если ЭтоАдресВременногоХранилища(ФормаОтчета.АдресТаблицыРасшифровки) Тогда //И ЗаданоПравилоЗаполнения(ФормаОтчета) Тогда
		
		ТаблицаРасшифровки = ПолучитьИзВременногоХранилища(ФормаОтчета.АдресТаблицыРасшифровки);
		
		ТаблицаДанныхРасшифровки = Документы.УниверсальныйРегламентированныйОтчет.СоздатьТаблицуДанныхРасшифровки();
		
		ПараметрыПоиска = Новый Структура;
		ПараметрыПоиска.Вставить("КодПоказателя", СтрВыделенногоПоказателя.КодПоказателя);
		
		ЗначениеПоказателя = СтрВыделенногоПоказателя.ДанныеПоказателя.Значение;
		
		Если ТипЗнч(СтрВыделенногоПоказателя.СтрокаТаблицыРаскрытия) = Тип("СтрокаТаблицыЗначений") Тогда
			
			РодительскаяТаблица = СтрВыделенногоПоказателя.СтрокаТаблицыРаскрытия.Владелец();
			Для каждого Колонка Из РодительскаяТаблица.Колонки Цикл
				
				Если Лев(Колонка.Имя, 9) = "Аналитика" Тогда
					
					ПараметрыПоиска.Вставить(Колонка.Имя, СтрВыделенногоПоказателя.СтрокаТаблицыРаскрытия[Колонка.Имя]);
					
				КонецЕсли;
				
			КонецЦикла;
			
			ЗначениеПоказателя = СтрВыделенногоПоказателя.СтрокаТаблицыРаскрытия[СтрВыделенногоПоказателя.КодПоказателя];
			
		КонецЕсли;
		
		Если ТаблицаРасшифровки.Количество() > 0 Тогда
			
			НайденныеСтроки = ТаблицаРасшифровки.НайтиСтроки(ПараметрыПоиска);
			
			КолонкаОбластьЗаполнения = ТаблицаРасшифровки.Колонки.Найти("ОбластьЗаполнения");
			Если ТипЗнч(КолонкаОбластьЗаполнения) = Тип("КолонкаТаблицыЗначений") Тогда
				ЕстьОбластьЗаполнения = Истина;
			Иначе
				ЕстьОбластьЗаполнения = Ложь;
			КонецЕсли;
			
			Для каждого СтрокаТаблица Из НайденныеСтроки Цикл
				
				НоваяСтрока = ТаблицаДанныхРасшифровки.Добавить();
				
				НоваяСтрока.Наименование = СтрокаТаблица.Наименование;
				НоваяСтрока.Значение = СтрокаТаблица.Значение;
				НоваяСтрока.ОпцииРасшифровки = СтрокаТаблица.ОпцииРасшифровки;
				Если ЕстьОбластьЗаполнения Тогда
					НоваяСтрока.ОбластьЗаполнения = СтрокаТаблица.ОбластьЗаполнения;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;	
		
		Возврат ТаблицаДанныхРасшифровки;
		
	ИначеЕсли НЕ ЗаданоПравилоЗаполнения(ФормаОтчета) Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
КонецФункции // ВызватьОбработчикРасшифровкиЗаполнения()

Функция ЗаданоПравилоЗаполнения(ФормаОтчета)
	
	Если ТипЗнч(ФормаОтчета.ПравилоЗаполнения) = Тип("СправочникСсылка.ПравилаЗаполнения") И ЗначениеЗаполнено(ФормаОтчета.ПравилоЗаполнения) Тогда
		
		Возврат Истина;
		
	Иначе
		
		Возврат Ложь;
		
	КонецЕсли;
	
КонецФункции
