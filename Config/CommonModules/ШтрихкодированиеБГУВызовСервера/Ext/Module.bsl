
#Область ПрограммныйИнтерфейс

Функция ПолучитьНоменклатуруПоШтрихкоду(ПараметрыОбработки) Экспорт
	
	РезультатПоиска = Новый Структура;
	РезультатПоиска.Вставить("НоменклатураПоШтрихкоду", Новый Массив);
	РезультатПоиска.Вставить("Количество", 0);
	РезультатПоиска.Вставить("ДанныеМаркировки", Новый Структура);
	РезультатПоиска.Вставить("ДанныеРазбораМаркировки", Новый Структура);
	РезультатПоиска.Вставить("ЭтоАкцизнаяМарка", Ложь);
	РезультатПоиска.Вставить("ШтрихкодПоискаТовара", "");
	РезультатПоиска.Вставить("КодМарки", "");
	РезультатПоиска.Вставить("ТипМаркировкиНоменклатуры", Неопределено);
	
	Если ПараметрыОбработки.Штрихкоды = Неопределено Тогда
		Возврат РезультатПоиска;
	КонецЕсли;
			
	Штрихкод = СокрЛП(ПараметрыОбработки.Штрихкоды.Штрихкод);
	
	РезультатРазбораШтрихкода = МенеджерОборудованияМаркировка.РазобратьШтриховойКодТовара(Штрихкод);
	РезультатПоиска.ДанныеМаркировки = РезультатРазбораШтрихкода;
	
	ДанныеДляРазбора = ОбменИСМПБГУ.НовыеДанныеДляРазбораКодаМаркировки();
	ДанныеДляРазбора.Штрихкод = Штрихкод;
	ДанныеДляРазбора.РезультатРазбораШтрихкода = РезультатРазбораШтрихкода;
	
	РезультатРазбораМаркировки = ОбменИСМПБГУ.РазобратьКодМаркировки(ДанныеДляРазбора);
	РезультатПоиска.ДанныеРазбораМаркировки = РезультатРазбораМаркировки;
	
	Если РезультатРазбораШтрихкода.Разобран Тогда
		РезультатПоиска.ШтрихкодПоискаТовара = Штрихкод;
		
		Если РезультатРазбораШтрихкода.ТипИдентификатораТовара = Перечисления.ТипыИдентификаторовТовараККТ.КодТовараВФорматеDataMatrixGS1 Тогда
			РезультатПоиска.ШтрихкодПоискаТовара = РезультатРазбораШтрихкода.EAN;
			РезультатПоиска.ЭтоАкцизнаяМарка = Истина;
		КонецЕсли;
		
		Если РезультатПоиска.ЭтоАкцизнаяМарка Тогда
			РезультатПоиска.КодМарки = Штрихкод;
		КонецЕсли;
		
		НайденныеТовары = НайтиНоменклатуруПоШтрихкоду(РезультатПоиска.ШтрихкодПоискаТовара);
		
		Если НайденныеТовары.Количество() > 0 Тогда
			Для Каждого НайденныйТовар Из НайденныеТовары Цикл
				РезультатПоиска.НоменклатураПоШтрихкоду.Добавить(НайденныйТовар.НоменклатураСсылка);
			КонецЦикла;
		КонецЕсли;
	Иначе
		НайденныеТовары = НайтиНоменклатуруПоШтрихкоду(Штрихкод);
		
		Если НайденныеТовары.Количество() > 0 Тогда
			Для Каждого НайденныйТовар Из НайденныеТовары Цикл
				РезультатПоиска.НоменклатураПоШтрихкоду.Добавить(НайденныйТовар.НоменклатураСсылка);
			КонецЦикла;
		КонецЕсли;
		
		РезультатПоиска.ШтрихкодПоискаТовара = Штрихкод;
	КонецЕсли;
	
	Если РезультатПоиска.НоменклатураПоШтрихкоду.Количество() > 0 Тогда
		ТипМаркировкиОпределен = Ложь;
		МаксимальныйИндекс = РезультатПоиска.НоменклатураПоШтрихкоду.Количество() - 1;
		Для Индекс = 0 По МаксимальныйИндекс Цикл
			ОбрабатываемаяНоменклатура = РезультатПоиска.НоменклатураПоШтрихкоду[Индекс];
			Если Индекс = 0 Тогда
				ТипМаркировки = ОбрабатываемаяНоменклатура.ВидМаркируемойПродукции;
				ТипМаркировкиОпределен = Истина;
			ИначеЕсли ТипМаркировки <> ОбрабатываемаяНоменклатура.ВидМаркируемойПродукции Тогда
				ТипМаркировкиОпределен = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ТипМаркировкиОпределен Тогда
			РезультатПоиска.ТипМаркировкиНоменклатуры = ТипМаркировки;
		КонецЕсли;
	КонецЕсли;
	
	Возврат РезультатПоиска;
	
КонецФункции

Функция НайтиНоменклатуруПоШтрихкоду(Штрихкод)

	ТекстЗапроса = "ВЫБРАТЬ
	               |	Прейскурант.Номенклатура.Ссылка КАК НоменклатураСсылка
	               |ИЗ
	               |	Справочник.Прейскурант КАК Прейскурант
	               |ГДЕ
	               |	Прейскурант.Штрихкод = &Штрихкод";
	Запрос = Новый Запрос(ТекстЗапроса);              
	Запрос.УстановитьПараметр("Штрихкод", Штрихкод);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Возврат РезультатЗапроса;
	
КонецФункции	
	
	
#КонецОбласти
