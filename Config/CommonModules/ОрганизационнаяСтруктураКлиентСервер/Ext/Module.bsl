#Область ПрограммныйИнтерфейс

// Возвращает структуру, содержащую данные ответственного лица.
//
// Параметры:
//	ВидОтветственногоЛица -  ПеречислениеСсылка.ОтветственныеЛицаОрганизаций, Строка - 
//                           вид ответственного лица, информация по котрому запрашивается.
//  Организация - СправочникСсылка.Организации
//  НаДату - дата - дата, на котроую требуется получить данные, если не указана используется
//                  текущая дата сеанса.
//  Подразделение - СправочникСсылка.Подразделения
//  
// Возвращаемое значение:
//  Структура:
//	 * ОтветственноеЛицоСсылка - СправочникСсылка.Сотрудники
//	 * ОтветственноеЛицоКонтрагент - СправочникСсылка.Контрагенты
//	 * ОтветственноеЛицоФИО - Строка
//	 * ИсполняемаяФункцияСсылка - ПеречислениеСсылка.ОтветственныеЛицаОрганизаций
//   * ИсполняемаяФункцияПредставление - Строка
//	 * ДолжностьСсылка - СправочникСсылка.Должности
//	 * ДолжностьПредставление - Строка
//   * ПодразделениеСсылка - СправочникСсылка.Подразделения
//	 * Звание - Строка
//
Функция ОтветственноеЛицоОрганизации(ВидОтветственногоЛица, Организация, Знач НаДату = Неопределено, Подразделение = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(НаДату) Тогда
		#Если Клиент Тогда
		НаДату = ТекущаяДата();
		#Иначе
		НаДату = ТекущаяДатаСеанса();
		#КонецЕсли
	КонецЕсли;
	
	ОтветственныеЛица = ОрганизационнаяСтруктураВызовСервераПовтИсп.ОтветственныеЛицаОрганизацииСоответствием(Организация, НачалоДня(НаДату), Подразделение);
	
	ОтветственноеЛицо = ОтветственныеЛица.Получить(ВидОтветственногоЛица);
	
	Если ОтветственноеЛицо = Неопределено Тогда
		Возврат ОрганизационнаяСтруктураВызовСервераПовтИсп.ОтветственноеЛицоПустаяСтруктура();
	Иначе
		Возврат ОтветственноеЛицо;
	КонецЕсли;
	
	Возврат ОрганизационнаяСтруктураВызовСервераПовтИсп.ОтветственноеЛицоОрганизации(Организация, ВидОтветственногоЛица, НачалоДня(НаДату));
	
КонецФункции	

Функция ОтветственноеЛицоОрганизацииСсылка(ВидОтветственногоЛица, Организация, Знач НаДату = Неопределено, Подразделение = Неопределено) Экспорт
	
	Возврат ОтветственноеЛицоОрганизации(ВидОтветственногоЛица, Организация, НаДату, Подразделение).ОтветственноеЛицоСсылка; 
	
КонецФункции	

Функция ПредставлениеОтветственногоЛицаКонтрагента(Фамилия, Имя, Отчество, Должность, ДатаДолжности) Экспорт   
	
	Представление = СокрЛП(Фамилия);
	
	Если ЗначениеЗаполнено(Имя) Тогда
		Представление =	Представление + " " + Лев(Имя, 1) + ".";
		Если ЗначениеЗаполнено(Отчество) Тогда
			Представление =	Представление + " " + Лев(Отчество, 1) + "."; 
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Должность) Тогда
		Представление =	Представление + ", " + СокрЛП(Должность);
		Если ЗначениеЗаполнено(ДатаДолжности) Тогда
			Представление =	Представление + " с " + Формат(ДатаДолжности, "ДФ=dd.MM.yyyy"); 
		КонецЕсли;
	КонецЕсли; 
	
	Возврат Представление;
	
КонецФункции

#КонецОбласти


