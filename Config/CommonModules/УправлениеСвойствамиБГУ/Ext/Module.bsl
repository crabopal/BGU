Процедура ЗагрузитьЭлементыДопСведенийКонтрагентов() Экспорт
	
	НаборКонтрагенты = УправлениеСвойствами.НаборСвойствПоИмени("Справочник_Контрагенты");
	ОбъектНабор = НаборКонтрагенты.ПолучитьОбъект();
	
	ТекРеквизит = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.КодСтатусаГосподдержки;
	ЗаполнитьРеквизитыДопРеквизиты(ТекРеквизит);
	Если ОбъектНабор.ДополнительныеРеквизиты.Найти(ТекРеквизит, "Свойство") = Неопределено Тогда
		НовыйНабор =  ОбъектНабор.ДополнительныеРеквизиты.Добавить();
		НовыйНабор.Свойство = ТекРеквизит;
		НовыйНабор.ИмяПредопределенногоНабора = "Справочник_Контрагенты";
	КонецЕсли;
	
	ТекРеквизит = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.КодПоОКОПФ;
	ЗаполнитьРеквизитыДопРеквизиты(ТекРеквизит);
	Если ОбъектНабор.ДополнительныеРеквизиты.Найти(ТекРеквизит, "Свойство") = Неопределено Тогда
		НовыйНабор =  ОбъектНабор.ДополнительныеРеквизиты.Добавить();
		НовыйНабор.Свойство = ТекРеквизит;
		НовыйНабор.ИмяПредопределенногоНабора = "Справочник_Контрагенты";
	КонецЕсли;
    
	ТекРеквизит = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.СубъектФедерации;
	ЗаполнитьРеквизитыДопРеквизиты(ТекРеквизит);
	Если ОбъектНабор.ДополнительныеРеквизиты.Найти(ТекРеквизит, "Свойство") = Неопределено Тогда
		НовыйНабор =  ОбъектНабор.ДополнительныеРеквизиты.Добавить();
		НовыйНабор.Свойство = ТекРеквизит;
		НовыйНабор.ИмяПредопределенногоНабора = "Справочник_Контрагенты";
	КонецЕсли;
	
	ТекРеквизит = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.СтранаМестонахождения;
	ЗаполнитьРеквизитыДопРеквизиты(ТекРеквизит);
	Если ОбъектНабор.ДополнительныеРеквизиты.Найти(ТекРеквизит, "Свойство") = Неопределено Тогда
		НовыйНабор =  ОбъектНабор.ДополнительныеРеквизиты.Добавить();
		НовыйНабор.Свойство = ТекРеквизит;
		НовыйНабор.ИмяПредопределенногоНабора = "Справочник_Контрагенты";
	КонецЕсли;
	
	Если ОбъектНабор.Модифицированность() Тогда
		ОбъектНабор.Записать();
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗагрузитьЭлементыДопРеквизитовОрганизаций() Экспорт
	
	НаборОрганизации = УправлениеСвойствами.НаборСвойствПоИмени("Справочник_Организации");
	ОбъектНабор = НаборОрганизации.ПолучитьОбъект();
	
	ТекРеквизит      = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.УИС;
	ЗаполнитьРеквизитыДопРеквизиты(ТекРеквизит);
	
	Если ОбъектНабор.ДополнительныеРеквизиты.Найти(ТекРеквизит, "Свойство") = Неопределено Тогда
		ОбъектНабор.ДополнительныеРеквизиты.Добавить().Свойство = ТекРеквизит;
	КонецЕсли;
	
	Если ОбъектНабор.Модифицированность() Тогда
		ОбъектНабор.Записать();
	КонецЕсли;	
		
КонецПроцедуры 

Процедура ЗагрузитьЭлементыДопСведенийДоговоров() Экспорт
	
	ТаблицаДопСведений = Новый ТаблицаЗначений;
	ТаблицаДопСведений.Колонки.Добавить("Свойство", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения"));
	ТаблицаДопСведений.Колонки.Добавить("Набор", 	Новый ОписаниеТипов("СправочникСсылка.НаборыДополнительныхРеквизитовИСведений")); 
	
	ДобавитьВТаблицуДопСведений(ТаблицаДопСведений,	ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.ОкончаниеДоговора,		"Справочник_Договоры_Общие");
	ДобавитьВТаблицуДопСведений(ТаблицаДопСведений,	ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.ДоговорПросрочен,		"Справочник_Договоры_Общие");
	ДобавитьВТаблицуДопСведений(ТаблицаДопСведений,	ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.КрупнаяСделка,			"Справочник_Договоры_Общие");

	Для каждого ТекДопСведение Из ТаблицаДопСведений Цикл
		
    	ЗаполнитьРеквизитыДопРеквизиты(ТекДопСведение.Свойство);
		
		Объект = ТекДопСведение.Набор.ПолучитьОбъект();
		
		Если Объект.ДополнительныеРеквизиты.Найти(ТекДопСведение.Свойство, "Свойство") = Неопределено Тогда
			НовСтр = Объект.ДополнительныеРеквизиты.Добавить();
			НовСтр.Свойство = ТекДопСведение.Свойство;
		КонецЕсли;
		
		Если Объект.Модифицированность() Тогда
			Объект.Записать();
		КонецЕсли;

	КонецЦикла;	
	
КонецПроцедуры	

Процедура ЗаполнитьРеквизитыДопРеквизиты(ДопРеквизит)
	
	ДопРеквизитОбъект = ДопРеквизит.ПолучитьОбъект();
	
	Если ДопРеквизитОбъект.ЭтоДополнительноеСведение Тогда
		ДопРеквизитОбъект.ЭтоДополнительноеСведение = Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДопРеквизитОбъект.Заголовок) Тогда
		ДопРеквизитОбъект.Заголовок = ДопРеквизитОбъект.Наименование;
	КонецЕсли;
	
	Если ДопРеквизитОбъект.Модифицированность() Тогда
		ДопРеквизитОбъект.Записать();
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьВТаблицуДопСведений(ТаблицаДопСведений, Свойство, Набор)

	НовСтр = ТаблицаДопСведений.Добавить();
	НовСтр.Свойство = Свойство;
	НовСтр.Набор	= УправлениеСвойствами.НаборСвойствПоИмени(Набор);

КонецПроцедуры
 
