Процедура ПолучитьНаборыСвойствДляДоговора(Договор, ТипСсылки, НаборыСвойств)
	
	Если ТипЗнч(Договор) = ТипСсылки Тогда
		Объект = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, "ВидДоговора");
	Иначе
		Объект = Договор;
	КонецЕсли;
	
	Набор = НаборыСвойств.Добавить();
	Набор.Набор = УправлениеСвойствами.НаборСвойствПоИмени("Справочник_Договоры_Общие");
	Набор.Заголовок = НСтр("ru = 'Общие свойства'");
	Набор.ОтображатьЗаголовок = Ложь;
	
	Если Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем Тогда
		Набор = НаборыСвойств.Добавить();
		Набор.Набор = УправлениеСвойствами.НаборСвойствПоИмени("Справочник_Договоры_СПокупателем");
		Набор.Заголовок = НСтр("ru = 'С покупателем'");
		
	ИначеЕсли Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком Тогда
		Набор = НаборыСвойств.Добавить();
		Набор.Набор = УправлениеСвойствами.НаборСвойствПоИмени("Справочник_Договоры_СПоставщиком");
		Набор.Заголовок = НСтр("ru = 'С поставщиком'");
		
	ИначеЕсли Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ИноеОбязательство Тогда
		Набор = НаборыСвойств.Добавить();
		Набор.Набор = УправлениеСвойствами.НаборСвойствПоИмени("Справочник_Договоры_ИноеОбязательство");
		Набор.Заголовок = НСтр("ru = 'Иное обязательство'");
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПолучитьНаборыСвойствДляРегистрацииОбязательствИСведенийПоДоговорам(РегистрацияОбязательства, ТипСсылки, НаборыСвойств)
	
	Если ТипЗнч(РегистрацияОбязательства) = ТипСсылки Тогда
		Объект = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РегистрацияОбязательства, "ВидОбязательства");
	Иначе
		Объект = РегистрацияОбязательства;
	КонецЕсли;
	
	Набор = НаборыСвойств.Добавить();
	Набор.Набор = УправлениеСвойствами.НаборСвойствПоИмени("Документ_РегистрацияОбязательствИСведенийПоДоговорам_Общие");
	Набор.Заголовок = НСтр("ru = 'Общие свойства'");
	Набор.ОтображатьЗаголовок = Ложь;
	
	Если Объект.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ПринятоеОбязательствоУчетПредмета 
		ИЛИ Объект.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ЗаявкаНаИзменениеОбязательстваУчетПредмета
		ИЛИ Объект.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ЗаявкаНаПеререгистрациюОбязательстваУчетПредмета Тогда
		
		Набор = НаборыСвойств.Добавить();
		Набор.Набор = УправлениеСвойствами.НаборСвойствПоИмени("Документ_РегистрацияОбязательствИСведенийПоДоговорам_ПринятоеОбязательствоУчетПредмета");
		Набор.Заголовок = НСтр("ru = 'Обязательства (с учетом предмета)'");
		
	ИначеЕсли Объект.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ПринятоеОбязательство 
		ИЛИ Объект.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ЗаявкаНаИзменениеОбязательства
		ИЛИ Объект.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ЗаявкаНаПеререгистрациюОбязательства Тогда
		
		Набор = НаборыСвойств.Добавить();
		Набор.Набор = УправлениеСвойствами.НаборСвойствПоИмени("Документ_РегистрацияОбязательствИСведенийПоДоговорам_ПринятоеОбязательство");
		Набор.Заголовок = НСтр("ru = 'Обязательства'");
		
	КонецЕсли;
	
КонецПроцедуры

