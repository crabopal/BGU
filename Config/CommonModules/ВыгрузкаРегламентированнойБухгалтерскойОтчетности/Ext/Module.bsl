////////////////////////////////////////////////////////////////////////////////
// Основными настройками выгрузки.

Функция ПолучитьСтруктуруОсновныхНастроекВыгрузки() Экспорт
	Результат = Новый Структура;
	
	Результат.Вставить("ФорматВыгрузки");
	Результат.Вставить("СпособВыгрузки");
	
	Возврат Результат;
	
КонецФункции	

Процедура СохранитьОсновныеНастройкиВыгрузки(ИмяПользователя,Настройки) Экспорт 
	
	ШаблонОписанияФормата = НСтр("ru = 'Основные настройки выгрузки отчетности пользователя:""%1"".'");
	
	ОписаниеНастроек = Новый ОписаниеНастроек;
	ОписаниеНастроек.КлючОбъекта = "ОсновныеНастройкиВыгрузкиОтчетности";
	ОписаниеНастроек.КлючНастроек = "";
	ОписаниеНастроек.Пользователь = ИмяПользователя;
	ОписаниеНастроек.Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонОписанияФормата,ИмяПользователя);
	
	ОбщегоНазначения.ХранилищеНастроекДанныхФормСохранить(
	ОписаниеНастроек.КлючОбъекта,
	ОписаниеНастроек.КлючНастроек,
	Настройки,
	ОписаниеНастроек,
	ОписаниеНастроек.Пользователь);

	
КонецПроцедуры	

Функция ЗагрузитьОсновныеНастройкиВыгрузки(ИмяПользователя) Экспорт
	
	Результат = ПолучитьСтруктуруОсновныхНастроекВыгрузки();
	
	ПолученныеНастройки = ОбщегоНазначения.ХранилищеНастроекДанныхФормЗагрузить("ОсновныеНастройкиВыгрузкиОтчетности",
	"",
	Результат,
	,
	ИмяПользователя);
	
	ЗаполнитьЗначенияСвойств(Результат,ПолученныеНастройки);
	
	Возврат Результат;

	
КонецФункции	

// Основными настройками выгрузки.
////////////////////////////////////////////////////////////////////////////////
// Настройки способа выгрузки

Функция ПолучитьСтруктуруНастроекСпособаВыгрузки(Транспорт) Экспорт 
	
	СтруктуруНастроек = Новый Структура;
	
	ИмяТранспорта = ПолучитьПолноеИмяПредопределенногоЗначения(Транспорт);
	
	Если ИмяТранспорта = "Перечисление.СпособыВыгрузкиФайлов.Каталог" Тогда 
		СтруктуруНастроек.Вставить("ПутьВыгрузки","");
		
	ИначеЕсли ИмяТранспорта = "Перечисление.СпособыВыгрузкиФайлов.FTP" Тогда 
		СтруктуруНастроек.Вставить("НастройкаЭкспорта",Справочники.НастройкиЭкспортаФайловОтчетности.ПустаяСсылка());
		
	ИначеЕсли ИмяТранспорта = "Перечисление.СпособыВыгрузкиФайлов.ЭлектроннаяПочта" Тогда
		СтруктуруНастроек.Вставить("НастройкаЭкспорта",Справочники.НастройкиЭкспортаФайловОтчетности.ПустаяСсылка());
		
	ИначеЕсли ИмяТранспорта = "Перечисление.СпособыВыгрузкиФайлов.ОбменСФНС" Тогда
		
		
	КонецЕсли;	
		
	Возврат СтруктуруНастроек;	
КонецФункции	

Процедура СохранитьНастройкиСпособаВыгрузки(ИмяПользователя,ФорматВыгрузки,Транспорт,НастройкиФормата) Экспорт 
	
	ШаблонОписанияФормата = НСтр("ru = 'Настройка способа доставки отчетов для формата:""%1"" и транспорта:""%2"".'");
	
	ОписаниеНастроек = Новый ОписаниеНастроек;
	ОписаниеНастроек.КлючОбъекта = "НастройкиСпособовОтправкиОтчетности";
	ОписаниеНастроек.КлючНастроек = СформироватьКлючНастроекСпособаВыгрузки(ФорматВыгрузки,Транспорт);
	ОписаниеНастроек.Пользователь = ИмяПользователя;
	ОписаниеНастроек.Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонОписанияФормата,Строка(ФорматВыгрузки),Строка(Транспорт));
	
	ОбщегоНазначения.ХранилищеНастроекДанныхФормСохранить(
	ОписаниеНастроек.КлючОбъекта,
	ОписаниеНастроек.КлючНастроек,
	НастройкиФормата,
	ОписаниеНастроек,
	ОписаниеНастроек.Пользователь);
	
	
КонецПроцедуры	

Функция ЗагрузитьНастройкиСпособаВыгрузки(ИмяПользователя,ФорматВыгрузки,Транспорт) Экспорт 
	Результат = ПолучитьСтруктуруНастроекСпособаВыгрузки(Транспорт);
	
	ПолученныеНастройки = ОбщегоНазначения.ХранилищеНастроекДанныхФормЗагрузить("НастройкиСпособовОтправкиОтчетности",
	СформироватьКлючНастроекСпособаВыгрузки(ФорматВыгрузки,Транспорт),
	Результат,
	,
	ИмяПользователя);
	
	ЗаполнитьЗначенияСвойств(Результат,ПолученныеНастройки);
	
	Возврат Результат;
КонецФункции

Функция СформироватьКлючНастроекСпособаВыгрузки(ФорматВыгрузки,Транспорт)
	
	Возврат Строка(ФорматВыгрузки.УникальныйИдентификатор())+"/"+ПолучитьПолноеИмяПредопределенногоЗначения(Транспорт);	
	
КонецФункции

// Настройки способа выгрузки
////////////////////////////////////////////////////////////////////////////////
// Дополнительные настройки формата.

Функция СформироватьТаблицуДополнительныхНастроек() Экспорт 
	
	ОписаниеХранилища = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная)); 
	
	Результат = Новый ТаблицаЗначений;                         

	Результат.Колонки.Добавить("Имя"				,Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(255)));
	Результат.Колонки.Добавить("ГруппаПолей"		,Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(255)));
	Результат.Колонки.Добавить("Заголовок"			,Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(255)));	
	Результат.Колонки.Добавить("Описание"			,Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная)));
	Результат.Колонки.Добавить("ВыбиратьИзСписка"	,Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("ПредставлениеЗначения",Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная)));
	Результат.Колонки.Добавить("ЗапоминатьЗначение",Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("ПроверкаЗаполнения",Новый ОписаниеТипов("Булево"));
	
	Результат.Колонки.Добавить("ТипЗначенияХранилище",	ОписаниеХранилища);
	Результат.Колонки.Добавить("СписокВыбораХранилище",	ОписаниеХранилища);
	Результат.Колонки.Добавить("ЗначениеПоУмолчаниюХранилище",ОписаниеХранилища);
	Результат.Колонки.Добавить("СохраненноеЗначениеХранилище",ОписаниеХранилища);
	Результат.Колонки.Добавить("ЗначениеХранилище",		ОписаниеХранилища);
	
	Результат.Колонки.Добавить("ТипЗначения"		,Новый ОписаниеТипов("ОписаниеТипов"));
	Результат.Колонки.Добавить("СписокВыбора"		,Новый ОписаниеТипов("СписокЗначений"));
	Результат.Колонки.Добавить("ЗначениеПоУмолчанию");
	Результат.Колонки.Добавить("СохраненноеЗначение");
	Результат.Колонки.Добавить("Значение");
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьТаблицуДополнительныхНастроек(ФорматВыгрузки, ТаблицаДопНастроек) Экспорт 
	
	Если Не ЗначениеЗаполнено(ФорматВыгрузки) Тогда 
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ФорматВыгрузки",ФорматВыгрузки);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ФорматыВыгрузкиБухгалтерскойОтчетностиДополнительныеНастройкиФормата.Имя КАК Имя,
	|	ФорматыВыгрузкиБухгалтерскойОтчетностиДополнительныеНастройкиФормата.ГруппаПолей КАК ГруппаПолей,
	|	ФорматыВыгрузкиБухгалтерскойОтчетностиДополнительныеНастройкиФормата.Заголовок КАК Заголовок,
	|	ФорматыВыгрузкиБухгалтерскойОтчетностиДополнительныеНастройкиФормата.Описание КАК Описание,
	|	ФорматыВыгрузкиБухгалтерскойОтчетностиДополнительныеНастройкиФормата.ТипЗначенияХранилище КАК ТипЗначенияХранилище,
	|	ФорматыВыгрузкиБухгалтерскойОтчетностиДополнительныеНастройкиФормата.ВыбиратьИзСписка КАК ВыбиратьИзСписка,
	|	ФорматыВыгрузкиБухгалтерскойОтчетностиДополнительныеНастройкиФормата.СписокВыбораХранилище КАК СписокВыбораХранилище,
	|	ФорматыВыгрузкиБухгалтерскойОтчетностиДополнительныеНастройкиФормата.ЗначениеПоУмолчаниюХранилище КАК ЗначениеПоУмолчаниюХранилище,
	|	ЕСТЬNULL(ЗначенияДополнительныхНастроекФорматовОбмена.ЗначениеХранилище, """") КАК СохраненноеЗначениеХранилище,
	|	"""" КАК ЗначениеХранилище,
	|	ФорматыВыгрузкиБухгалтерскойОтчетностиДополнительныеНастройкиФормата.ЗапоминатьЗначение КАК ЗапоминатьЗначение,
	|	ФорматыВыгрузкиБухгалтерскойОтчетностиДополнительныеНастройкиФормата.ПроверкаЗаполнения КАК ПроверкаЗаполнения
	|ИЗ
	|	Справочник.ФорматыВыгрузкиБухгалтерскойОтчетности.ДополнительныеНастройкиФормата КАК ФорматыВыгрузкиБухгалтерскойОтчетностиДополнительныеНастройкиФормата
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхНастроекФорматовОбмена КАК ЗначенияДополнительныхНастроекФорматовОбмена
	|		ПО ФорматыВыгрузкиБухгалтерскойОтчетностиДополнительныеНастройкиФормата.Ссылка = ЗначенияДополнительныхНастроекФорматовОбмена.ФорматВыгрузки
	|			И ФорматыВыгрузкиБухгалтерскойОтчетностиДополнительныеНастройкиФормата.Имя = ЗначенияДополнительныхНастроекФорматовОбмена.Имя
	|ГДЕ
	|	ФорматыВыгрузкиБухгалтерскойОтчетностиДополнительныеНастройкиФормата.Ссылка = &ФорматВыгрузки";
	
	ДанныеДляСозданияТаблицы = Запрос.Выполнить().Выгрузить();
	
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ДанныеДляСозданияТаблицы, ТаблицаДопНастроек);
	
	ПрочитатьЗначенияИзХранилища(ТаблицаДопНастроек);
	
	Для Каждого СтрокаДопНастроек Из ТаблицаДопНастроек Цикл
		
		Если ЗначениеЗаполнено(СтрокаДопНастроек.СохраненноеЗначение) 
			И СтрокаДопНастроек.ТипЗначения.СодержитТип(ТипЗнч(СтрокаДопНастроек.СохраненноеЗначение)) 
			И ?(СтрокаДопНастроек.ВыбиратьИзСписка,СтрокаДопНастроек.СписокВыбора.НайтиПоЗначению(СтрокаДопНастроек.СохраненноеЗначение) <> Неопределено,Истина) Тогда 
			
			СтрокаДопНастроек.Значение = СтрокаДопНастроек.СохраненноеЗначение;
			
		ИначеЕсли ЗначениеЗаполнено(СтрокаДопНастроек.ЗначениеПоУмолчанию) 
			И СтрокаДопНастроек.ТипЗначения.СодержитТип(ТипЗнч(СтрокаДопНастроек.ЗначениеПоУмолчанию)) Тогда  
			
			СтрокаДопНастроек.Значение = СтрокаДопНастроек.ЗначениеПоУмолчанию;
			
		Иначе 
			СтрокаДопНастроек.Значение = СтрокаДопНастроек.ТипЗначения.ПривестиЗначение();
			
		КонецЕсли;
		
		СтрокаДопНастроек.ЗначениеХранилище = БюджетнаяОтчетностьКлиентСервер.ЗаписатьЗначениеВXML(СтрокаДопНастроек.Значение);
		СтрокаДопНастроек.ПредставлениеЗначения = ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиентСервер.ПолучитьПредставлениеЗначения(СтрокаДопНастроек);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаписатьЗначенияТаблицыДополнительныхНастроекВРегистр(ФорматВыгрузки, ТаблицаНастроек) Экспорт 
	
	Если Не ЗначениеЗаполнено(ФорматВыгрузки) Тогда 
		Возврат;
	КонецЕсли;	
	
	НаборЗаписей = РегистрыСведений.ЗначенияДополнительныхНастроекФорматовОбмена.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ФорматВыгрузки.Установить(ФорматВыгрузки);
	
	ТаблицаДляЗаписи = НаборЗаписей.ВыгрузитьКолонки();
	Для Каждого СтрокаТаблицыНастроек Из ТаблицаНастроек Цикл
		
		Если СтрокаТаблицыНастроек.ЗапоминатьЗначение = Ложь Тогда 
			Продолжить;
		КонецЕсли;	
		
		РедактируемаяСтрока = ТаблицаДляЗаписи.Добавить();
		РедактируемаяСтрока.ФорматВыгрузки = ФорматВыгрузки;
		РедактируемаяСтрока.Имя = СтрокаТаблицыНастроек.Имя;
		РедактируемаяСтрока.ЗначениеХранилище = СтрокаТаблицыНастроек.ЗначениеХранилище;
		РедактируемаяСтрока.ПредставлениеЗначения = СтрокаТаблицыНастроек.ПредставлениеЗначения;
		
	КонецЦикла;
	
	
	НаборЗаписей.Загрузить(ТаблицаДляЗаписи);
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры

Процедура ПроверитьЗаполнениеДопНастроек(ТаблицаНастроек, Отказ) Экспорт 
	
	Счетчик = 0;
	Для Каждого СтрокаТаблицыНастроек Из ТаблицаНастроек Цикл
		Счетчик = Счетчик + 1; 
		Если СтрокаТаблицыНастроек.ПроверкаЗаполнения = Ложь Тогда 
			Продолжить;
		КонецЕсли;	
		
		Значение = БюджетнаяОтчетностьКлиентСервер.ПрочитатьЗначениеИзXML(СтрокаТаблицыНастроек.ЗначениеХранилище);
		Если ЗначениеЗаполнено(Значение) Тогда 
			Продолжить;
		КонецЕсли;
		
		Отказ = Истина;
		
		Шаблон = НСтр(
		"ru = 'Не заполнена дополнительная настройка ""%1"".'");
		Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, СтрокаТаблицыНастроек.Заголовок);
		ОбщегоНазначения.СообщитьПользователю(Сообщение,,
		ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ДополнительныеНастройкиФормата",Счетчик,"Значение"));
		
	КонецЦикла;
	
КонецПроцедуры	



Процедура ПрочитатьЗначенияИзХранилища(ТаблицаДопНастроек) Экспорт 
	
	Для Каждого СтрокаДопНастроек из ТаблицаДопНастроек Цикл 
		
		ИсходныеДанныеСтроки = Новый Структура("ТипЗначенияХранилище,СписокВыбораХранилище,ЗначениеПоУмолчаниюХранилище,СохраненноеЗначениеХранилище,ЗначениеХранилище");
		ИтоговыеДанныеСтроки = Новый Структура("ТипЗначения,СписокВыбора,ЗначениеПоУмолчанию,СохраненноеЗначение,Значение");
		
		ЗаполнитьЗначенияСвойств(ИсходныеДанныеСтроки, СтрокаДопНастроек);
		
		ИтоговыеДанныеСтроки.ТипЗначения = БюджетнаяОтчетностьКлиентСервер.ПрочитатьЗначениеИзXML(ИсходныеДанныеСтроки.ТипЗначенияХранилище);
		ИтоговыеДанныеСтроки.СписокВыбора = БюджетнаяОтчетностьКлиентСервер.ПрочитатьЗначениеИзXML(ИсходныеДанныеСтроки.СписокВыбораХранилище);
		ИтоговыеДанныеСтроки.ЗначениеПоУмолчанию = БюджетнаяОтчетностьКлиентСервер.ПрочитатьЗначениеИзXML(ИсходныеДанныеСтроки.ЗначениеПоУмолчаниюХранилище);
		ИтоговыеДанныеСтроки.СохраненноеЗначение = БюджетнаяОтчетностьКлиентСервер.ПрочитатьЗначениеИзXML(ИсходныеДанныеСтроки.СохраненноеЗначениеХранилище);
		ИтоговыеДанныеСтроки.Значение = БюджетнаяОтчетностьКлиентСервер.ПрочитатьЗначениеИзXML(ИсходныеДанныеСтроки.ЗначениеХранилище);	
		
		ЗаполнитьЗначенияСвойств(СтрокаДопНастроек, ИтоговыеДанныеСтроки);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПоместитьЗначенияВХранилища(ТаблицаДопНастроек) Экспорт
			
	Для Каждого СтрокаДопНастроек из ТаблицаДопНастроек Цикл 
		
		ИсходныеДанныеСтроки = Новый Структура("ТипЗначения,СписокВыбора,ЗначениеПоУмолчанию,СохраненноеЗначение,Значение");
		ИтоговыеДанныеСтроки =  Новый Структура("ТипЗначенияХранилище,СписокВыбораХранилище,ЗначениеПоУмолчаниюХранилище,СохраненноеЗначениеХранилище,ЗначениеХранилище");
		
		ЗаполнитьЗначенияСвойств(ИсходныеДанныеСтроки, СтрокаДопНастроек);
		
		ИтоговыеДанныеСтроки.ТипЗначенияХранилище = БюджетнаяОтчетностьКлиентСервер.ЗаписатьЗначениеВXML(ИсходныеДанныеСтроки.ТипЗначения); 
		ИтоговыеДанныеСтроки.СписокВыбораХранилище = БюджетнаяОтчетностьКлиентСервер.ЗаписатьЗначениеВXML(ИсходныеДанныеСтроки.СписокВыбора); 
		ИтоговыеДанныеСтроки.ЗначениеПоУмолчаниюХранилище = БюджетнаяОтчетностьКлиентСервер.ЗаписатьЗначениеВXML(ИсходныеДанныеСтроки.ЗначениеПоУмолчанию); 
		ИтоговыеДанныеСтроки.СохраненноеЗначениеХранилище = БюджетнаяОтчетностьКлиентСервер.ЗаписатьЗначениеВXML(ИсходныеДанныеСтроки.СохраненноеЗначение);
		ИтоговыеДанныеСтроки.ЗначениеХранилище = БюджетнаяОтчетностьКлиентСервер.ЗаписатьЗначениеВXML(ИсходныеДанныеСтроки.Значение);
		
		ЗаполнитьЗначенияСвойств(СтрокаДопНастроек, ИтоговыеДанныеСтроки);
		
	КонецЦикла;
	
КонецПроцедуры

