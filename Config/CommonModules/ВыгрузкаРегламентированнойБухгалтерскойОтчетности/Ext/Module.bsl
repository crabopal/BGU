// ФНС

Процедура ВыгрузкаВФНССервер(ДанныеОтправки)
	ДанныеВыгрузки = ДанныеОтправки.ДанныеВыгрузкиВФНС;
	Если ДанныеВыгрузки.ИспользоватьВыгрузку = Ложь Тогда 
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаПакета Из ДанныеВыгрузки.МассивПакетов Цикл 
		НачатьТранзакцию();
		Попытка
			
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("Документ.ПакетВыгрузкиОтчетности");
			ЭлементБлокировки.УстановитьЗначение("Ссылка",СтрокаПакета);
			Блокировка.Заблокировать();
			
			ДанныеГрупп = ПолучитьДанныеГрупп(СтрокаПакета);
			
			// нужно создавать документы
			Если ЗначениеЗаполнено(ДанныеГрупп.НайтиСтроки(Новый Структура("СуществующийДокумент",Документы.ЭлектронныйДокументБухгалтерскийОтчет.ПустаяСсылка()))) Тогда
				РезультатСохранения = РаспаковатьДанныеПакетов(ДанныеВыгрузки.МассивПакетов,ДанныеОтправки);
			КонецЕсли;
			
			Для Каждого СтрокаДанныхГрупп Из ДанныеГрупп Цикл 
				
				Если СтрокаДанныхГрупп.СуществующийДокумент.Пустая() Тогда 
					
					ФайлТекущейГруппы = РезультатСохранения.НайтиСтроки(Новый Структура("Пакет,Группа",СтрокаДанныхГрупп.Пакет,СтрокаДанныхГрупп.Группа));
					
					Если Не ЗначениеЗаполнено(ФайлТекущейГруппы) Тогда 
						Шаблон = НСтр("ru = 'Нет файлов для группы %1.'");
						Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон,СтрокаДанныхГрупп.Группа);
						ВызватьИсключение Сообщение;
					КонецЕсли;
					
					Если ФайлТекущейГруппы.Количество() > 1 Тогда 
						Шаблон = НСтр("ru = 'Для группы %1 сформировано более одного файла.'");
						Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон,СтрокаДанныхГрупп.Группа);
						ВызватьИсключение Сообщение;
					КонецЕсли;
					
					
					СтруктураЗаполнения = Новый Структура;
					СтруктураЗаполнения.Вставить("СпособЗаполнения","ЗаполнениеПоПакету");
					СтруктураЗаполнения.Вставить("Пакет",СтрокаДанныхГрупп.Пакет);
					СтруктураЗаполнения.Вставить("Группа",СтрокаДанныхГрупп.Группа);
					СтруктураЗаполнения.Вставить("ПолноеИмяФайла",ФайлТекущейГруппы[0].ПолноеИмя);
					СтруктураЗаполнения.Вставить("ДвоичныеДанные",Новый ДвоичныеДанные(ФайлТекущейГруппы[0].ПолноеИмя));
					
					НовыйДокумент = Документы.ЭлектронныйДокументБухгалтерскийОтчет.СоздатьДокумент();
					НовыйДокумент.Заполнить(СтруктураЗаполнения);
					НовыйДокумент.Записать();
					ДанныеВыгрузки.МассивДокументов.Добавить(НовыйДокумент.Ссылка);
					
				Иначе 
					
					ДанныеВыгрузки.МассивДокументов.Добавить(СтрокаДанныхГрупп.СуществующийДокумент);
					
				КонецЕсли;
			КонецЦикла;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			ОтменитьТранзакцию();
			
			Шаблон = НСтр("ru = 'Не удалось сформировать документы ""Бухгалтерский отчет (электронный документ)"" для пакета ""%1"".
			|%2'");
			Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон,СтрокаПакета,ОписаниеОшибки());
			ОбщегоНазначения.СообщитьПользователю(Сообщение);
			
			ДанныеОтправки.ПропущенныеПакеты.Добавить(СтрокаПакета);
			
		КонецПопытки;
		
	КонецЦикла;	
		
	
КонецПроцедуры	

Функция ПолучитьДанныеГрупп(Пакет)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Пакет",Пакет);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПакетВыгрузкиОтчетностиОтчетыПакета.Ссылка КАК Пакет,
	|	ПакетВыгрузкиОтчетностиОтчетыПакета.Группа КАК Группа,
	|	ЕСТЬNULL(ЭлектронныйДокументБухгалтерскийОтчет.Ссылка, ЗНАЧЕНИЕ(Документ.ЭлектронныйДокументБухгалтерскийОтчет.ПустаяСсылка)) КАК СуществующийДокумент
	|ИЗ
	|	Документ.ПакетВыгрузкиОтчетности.ОтчетыПакета КАК ПакетВыгрузкиОтчетностиОтчетыПакета
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭлектронныйДокументБухгалтерскийОтчет КАК ЭлектронныйДокументБухгалтерскийОтчет
	|		ПО ПакетВыгрузкиОтчетностиОтчетыПакета.Ссылка = ЭлектронныйДокументБухгалтерскийОтчет.Пакет
	|			И ПакетВыгрузкиОтчетностиОтчетыПакета.Группа = ЭлектронныйДокументБухгалтерскийОтчет.Группа
	|ГДЕ
	|	ПакетВыгрузкиОтчетностиОтчетыПакета.Ссылка = &Пакет";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции	

