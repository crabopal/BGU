// Email 

Процедура ВыгрузкаЧерезEmailСервер(ДанныеОтправки)
	
	ДанныеВыгрузки = ДанныеОтправки.ДанныеВыгрузкиЧерезEmail;
	Если ДанныеВыгрузки.ИспользоватьВыгрузку = Ложь Тогда 
		Возврат;
	КонецЕсли;
	
	ХранилищеСоединений = Новый Соответствие;
	
	ЗаполнитьДанныеПакетов(ДанныеВыгрузки);
	
	РезультатСохранения = РаспаковатьДанныеПакетов(ДанныеВыгрузки.МассивПакетов,ДанныеОтправки);
	Для Каждого ДанныеПакета Из ДанныеВыгрузки.ДанныеПакетов Цикл
		ПараметрыПисьма = Новый Структура;
		
		ПараметрыПисьма.Вставить("Кому",ОбщегоНазначенияКлиентСервер.РазобратьСтрокуСПочтовымиАдресами(ДанныеПакета.Получатели));
		
		ШаблонТемы = НСтр("ru = 'Отчетность: %1'");
		ШаблонСообщения = НСтр("ru = 'Отчетность  на %1
		|%2'");
		ПараметрыПисьма.Вставить("Тема", СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонТемы, ДанныеПакета.Организация));
		ПараметрыПисьма.Вставить("Тело", СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, Формат(КонецДня(ДанныеПакета.Период.ДатаОкончания)+1,"ДФ=dd.MM.yyyy"), ДанныеПакета.Организация));
		
		ФайлыТекущегоПакета = РезультатСохранения.НайтиСтроки(Новый Структура("Пакет",ДанныеПакета.Пакет));
		ПараметрыПисьма.Вставить("Вложения",Новый Соответствие);
		Для Каждого СтрокаФайла Из ФайлыТекущегоПакета Цикл 	
			ПараметрыПисьма.Вложения.Вставить(СтрокаФайла.ОтносительноеИмя, Новый ДвоичныеДанные(СтрокаФайла.ПолноеИмя)); 
		КонецЦикла;
		
		Попытка
			Соединение = ПолучитьСоединениеСПочтовымСервером(ДанныеПакета.УчетнаяЗаписьЭлектроннойПочты, ХранилищеСоединений);
			ВыгрузкаРегламентированнойБухгалтерскойОтчетностиСерверПереопределяемый.ОтправитьСообщение(ДанныеПакета.УчетнаяЗаписьЭлектроннойПочты, ПараметрыПисьма, Соединение);
			
		Исключение
			
			Шаблон = НСтр("ru = 'Не удалось отправить через Email пакет""%1"".
			|%2'");
			Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон,ДанныеПакета.Пакет,ОписаниеОшибки());   
			ОбщегоНазначения.СообщитьПользователю(Сообщение);
			
			ДанныеОтправки.ПропущенныеПакеты.Добавить(ДанныеПакета.Пакет);
			
			Продолжить;
		КонецПопытки;
		
		Шаблон = НСтр("ru = '%1 (""%2"" ""%3"") успешно отправлен через Email.'");
		Пояснение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон,ДанныеПакета.Пакет, ДанныеПакета.Организация, ДанныеПакета.Период);   
		
		СтруктураОповещения = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ДанныеОтправки.ШаблонСтрокиОповещенияПользователя);
		СтруктураОповещения.Текст = НСтр("ru = 'Пакет успешно отправлен через Email.'");
		СтруктураОповещения.Пояснение = Пояснение;
		СтруктураОповещения.НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(ДанныеПакета.Пакет);
		СтруктураОповещения.Картинка = БиблиотекаКартинок.Успешно32;
		
		ДанныеОтправки.ОповещенияПользователя.Добавить(СтруктураОповещения);
		
		ДанныеОтправки.ОтправленныеПакеты.Добавить(ДанныеПакета.Пакет);
		
	КонецЦикла;	
	
КонецПроцедуры

Функция ПолучитьСоединениеСПочтовымСервером(УчетнаяЗапись,ХранилищеСоединений)
	
	НайденнаяСтрока = ХранилищеСоединений.Получить(УчетнаяЗапись);
	Если НайденнаяСтрока = Неопределено Тогда 
		
		Профиль = ВыгрузкаРегламентированнойБухгалтерскойОтчетностиСерверПереопределяемый.СформироватьИнтернетПрофиль(УчетнаяЗапись);
		Соединение = Новый ИнтернетПочта;
		Соединение.Подключиться(Профиль);
		
		ХранилищеСоединений.Вставить(УчетнаяЗапись,Соединение);
		
		Возврат Соединение;
		
	Иначе 
		
		Возврат НайденнаяСтрока;
		
	КонецЕсли;
	
	
КонецФункции	

