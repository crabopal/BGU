Функция СоздатьИЗаполнитьОбъектОбработки(СтруктураДанных)
	
	НовыйЭкземплярОбработки = Новый (Тип(СтруктураДанных.ИмяТипаОбработки));
	ЗаполнитьЗначенияСвойств(НовыйЭкземплярОбработки,СтруктураДанных.Обработка,"ПутьВыгрузки,СпособВыгрузки");
	
	ИменаТаблиц = СтрРазделить("ОтчетыДляВыгрузки,Зависимости,ЭлектронныеЦифровыеПодписи,ДополнительныеНастройкиФормата,ПрисоединенныеФайлыДляВыгрузки",",");
	Для Каждого ТекТаблица Из ИменаТаблиц Цикл
		НовыйЭкземплярОбработки[ТекТаблица].Загрузить(СтруктураДанных.Обработка[ТекТаблица].Выгрузить());	
	КонецЦикла;	
	
	Возврат НовыйЭкземплярОбработки;
	
КонецФункции

Процедура ПеренестиДанныеВДанныеФормы(СтруктураДанных,ОбъектОбработки)
	
	ЗаполнитьЗначенияСвойств(СтруктураДанных.Обработка,ОбъектОбработки,"ПутьВыгрузки,СпособВыгрузки");
	
	ИменаТаблиц = СтрРазделить("ОтчетыДляВыгрузки,Зависимости,ЭлектронныеЦифровыеПодписи,ДополнительныеНастройкиФормата,ПрисоединенныеФайлыДляВыгрузки",",");
	Для Каждого ТекТаблица Из ИменаТаблиц Цикл
		СтруктураДанных.Обработка[ТекТаблица].Загрузить(ОбъектОбработки[ТекТаблица].Выгрузить());	
	КонецЦикла;	
		
КонецПроцедуры


Процедура ЗаполнитьЗависимости(СтруктураДанных) Экспорт 
	Если СтруктураДанных.Отказ Тогда 
		Возврат;
	КонецЕсли;
	
	Если СтруктураДанных.Свойство("ИмяТипаОбработки")
		И СтруктураДанных.ИмяТипаОбработки <>"ОбработкаОбъект.ВыгрузкаОтчетностиОрганизаций" Тогда
		//считаем, что это внешнаяя обработка
		
		ОбъектОбработки = СоздатьИЗаполнитьОбъектОбработки(СтруктураДанных);
		ОбъектОбработки.ЗаполнитьТаблицуЗависимостей(СтруктураДанных);
		ПеренестиДанныеВДанныеФормы(СтруктураДанных,ОбъектОбработки);
		
	Иначе
		
		ОбъектОбработки = ДанныеФормыВЗначение(СтруктураДанных.Обработка ,Тип("ОбработкаОбъект.ВыгрузкаОтчетностиОрганизаций"));
		ОбъектОбработки.ЗаполнитьТаблицуЗависимостей(СтруктураДанных);
		ЗначениеВДанныеФормы(ОбъектОбработки, СтруктураДанных.Обработка);
		
	КонецЕсли;
	
КонецПроцедуры	


Процедура СформироватьПакеты(СтруктураДанных) Экспорт 
	
	Если СтруктураДанных.Свойство("ИмяТипаОбработки")
		И СтруктураДанных.ИмяТипаОбработки <>"ОбработкаОбъект.ВыгрузкаОтчетностиОрганизаций" Тогда
		//считаем, что это внешнаяя обработка
		
		ОбъектОбработки = СоздатьИЗаполнитьОбъектОбработки(СтруктураДанных);
		ОбъектОбработки.СформироватьПакеты(СтруктураДанных);
		ПеренестиДанныеВДанныеФормы(СтруктураДанных,ОбъектОбработки);
		
	Иначе
		
		ОбъектОбработки = ДанныеФормыВЗначение(СтруктураДанных.Обработка ,Тип("ОбработкаОбъект.ВыгрузкаОтчетностиОрганизаций"));
		ОбъектОбработки.СформироватьПакеты(СтруктураДанных);
		ЗначениеВДанныеФормы(ОбъектОбработки, СтруктураДанных.Обработка);
		
	КонецЕсли;
		
КонецПроцедуры


Процедура ЗаполнитьОписаниеФайловДляФормированияПодписей(СтруктураДанных,СтруктураДанныхПодписей) Экспорт
	
	Если СтруктураДанных.Свойство("ИмяТипаОбработки")
		И СтруктураДанных.ИмяТипаОбработки <>"ОбработкаОбъект.ВыгрузкаОтчетностиОрганизаций" Тогда
		//считаем, что это внешнаяя обработка
		
		ОбъектОбработки = СоздатьИЗаполнитьОбъектОбработки(СтруктураДанных);
		ОбъектОбработки.ЗаполнитьОписаниеФайловДляФормированияПодписей(СтруктураДанных,СтруктураДанныхПодписей);
		ПеренестиДанныеВДанныеФормы(СтруктураДанных,ОбъектОбработки);
		
	Иначе
		
		ОбъектОбработки = ДанныеФормыВЗначение(СтруктураДанных.Обработка ,Тип("ОбработкаОбъект.ВыгрузкаОтчетностиОрганизаций"));
		ОбъектОбработки.ЗаполнитьОписаниеФайловДляФормированияПодписей(СтруктураДанных,СтруктураДанныхПодписей);
		ЗначениеВДанныеФормы(ОбъектОбработки, СтруктураДанных.Обработка);
		
	КонецЕсли;
		
КонецПроцедуры

Процедура ДобавитьНовыеПодписиВПакет(СтруктураДанных,СтруктураДанныхПодписей) Экспорт
	
	Если СтруктураДанных.Свойство("ИмяТипаОбработки")
		И СтруктураДанных.ИмяТипаОбработки <>"ОбработкаОбъект.ВыгрузкаОтчетностиОрганизаций" Тогда
		//считаем, что это внешнаяя обработка
		
		ОбъектОбработки = СоздатьИЗаполнитьОбъектОбработки(СтруктураДанных);
		ОбъектОбработки.ДобавитьНовыеПодписиВПакет(СтруктураДанных,СтруктураДанныхПодписей);
		ПеренестиДанныеВДанныеФормы(СтруктураДанных,ОбъектОбработки);
		
	Иначе
		
		ОбъектОбработки = ДанныеФормыВЗначение(СтруктураДанных.Обработка ,Тип("ОбработкаОбъект.ВыгрузкаОтчетностиОрганизаций"));
		ОбъектОбработки.ДобавитьНовыеПодписиВПакет(СтруктураДанных,СтруктураДанныхПодписей);
		ЗначениеВДанныеФормы(ОбъектОбработки, СтруктураДанных.Обработка);
		
	КонецЕсли;
		
КонецПроцедуры


