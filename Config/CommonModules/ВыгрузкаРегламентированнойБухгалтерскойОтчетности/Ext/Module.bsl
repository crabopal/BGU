Процедура ВыполнитьВыгрузкуДанныхНаСервере(ДанныеОтправки) Экспорт 
	
	ПроверитьПакеты(ДанныеОтправки);
	РаспределитьПакетыПоТипуОтправки(ДанныеОтправки);
	ВыгрузкаВКаталогСервер(ДанныеОтправки);
	ВыгрузкаНаФТПСервер(ДанныеОтправки);
	ВыгрузкаЧерезEmailСервер(ДанныеОтправки);
	ВыгрузкаВФНССервер(ДанныеОтправки);
	
	УдалитьВременныеФайлы(ДанныеОтправки);
КонецПроцедуры

Процедура ПроверитьПакеты(ДанныеОтправки)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Пакеты",ДанныеОтправки.ПакетыДляОтправки);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПакетВыгрузкиОтчетности.Ссылка,
	|	""ПометкаНаУдаление"" КАК ТипОшибки,
	|	ПакетВыгрузкиОтчетности.Дата КАК Дата
	|ПОМЕСТИТЬ ПакетыКоторыеНельзяОтправить
	|ИЗ
	|	Документ.ПакетВыгрузкиОтчетности КАК ПакетВыгрузкиОтчетности
	|ГДЕ
	|	ПакетВыгрузкиОтчетности.Ссылка В(&Пакеты)
	|	И ПакетВыгрузкиОтчетности.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПакетВыгрузкиОтчетности.Ссылка КАК Пакеты
	|ИЗ
	|	Документ.ПакетВыгрузкиОтчетности КАК ПакетВыгрузкиОтчетности
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПакетыКоторыеНельзяОтправить КАК ПакетыКоторыеНельзяОтправить
	|		ПО (ПакетыКоторыеНельзяОтправить.Ссылка = ПакетВыгрузкиОтчетности.Ссылка)
	|ГДЕ
	|	ПакетВыгрузкиОтчетности.Ссылка В(&Пакеты)
	|	И ПакетыКоторыеНельзяОтправить.Ссылка ЕСТЬ NULL ";	
	
	ДанныеОтправки.ПакетыДляОтправки = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Пакеты");
	
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПакетыКоторыеНельзяОтправить.Ссылка КАК Пакет,
	|	ПакетыКоторыеНельзяОтправить.ТипОшибки КАК ТипОшибки
	|ИЗ
	|	ПакетыКоторыеНельзяОтправить КАК ПакетыКоторыеНельзяОтправить
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПакетыКоторыеНельзяОтправить.Дата";
	
	ТаблицаОшибок = Запрос.Выполнить().Выгрузить();
	Для Каждого СтрокаТаблицыОшибок Из ТаблицаОшибок Цикл 
		Сообщение = "";
		Если СтрокаТаблицыОшибок.ТипОшибки = "ПометкаНаУдаление" Тогда 
			
			Шаблон = НСтр("ru = '""%1"" помечен на удаление. Отправка невозможна.'");
			Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, СтрокаТаблицыОшибок.Пакет);
			
		Иначе 
			Сообщение = "Неизвестный тип ошибки.";
		КонецЕсли;
		
		ОбщегоНазначения.СообщитьПользователю(Сообщение);
	КонецЦикла;	
	
КонецПроцедуры	

Процедура РаспределитьПакетыПоТипуОтправки(ДанныеОтправки)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Пакеты",ДанныеОтправки.ПакетыДляОтправки);
	
	ИспользоватьКаталог = ВыгрузкаРегламентированнойБухгалтерскойОтчетностиПовтИсп.ТранспортИспользуется("Перечисление.СпособыВыгрузкиФайлов.Каталог");  
	Запрос.УстановитьПараметр("ИспользоватьКаталог",ИспользоватьКаталог);
	Запрос.УстановитьПараметр("Каталог",?(ИспользоватьКаталог,ПредопределенноеЗначение("Перечисление.СпособыВыгрузкиФайлов.Каталог"),Неопределено));
	
	ИспользоватьФТП = ВыгрузкаРегламентированнойБухгалтерскойОтчетностиПовтИсп.ТранспортИспользуется("Перечисление.СпособыВыгрузкиФайлов.FTP");  
	Запрос.УстановитьПараметр("ИспользоватьFTP",ИспользоватьФТП);
	Запрос.УстановитьПараметр("FTP",?(ИспользоватьФТП,ПредопределенноеЗначение("Перечисление.СпособыВыгрузкиФайлов.FTP"),Неопределено));
	
	ИспользоватьФНС = ВыгрузкаРегламентированнойБухгалтерскойОтчетностиПовтИсп.ТранспортИспользуется("Перечисление.СпособыВыгрузкиФайлов.ОбменСФНС");  
	Запрос.УстановитьПараметр("ИспользоватьОбменСФНС",ИспользоватьФНС);
	Запрос.УстановитьПараметр("ОбменСФНС",?(ИспользоватьФНС,ПредопределенноеЗначение("Перечисление.СпособыВыгрузкиФайлов.ОбменСФНС"),Неопределено));
	
	ИспользоватьEmail = ВыгрузкаРегламентированнойБухгалтерскойОтчетностиПовтИсп.ТранспортИспользуется("Перечисление.СпособыВыгрузкиФайлов.ЭлектроннаяПочта");  
	Запрос.УстановитьПараметр("ИспользоватьEmail",ИспользоватьEmail);
	Запрос.УстановитьПараметр("Email",?(ИспользоватьEmail,ПредопределенноеЗначение("Перечисление.СпособыВыгрузкиФайлов.ЭлектроннаяПочта"),Неопределено));
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПакетВыгрузкиОтчетности.Ссылка КАК Пакет,
	|	""ДанныеВыгрузкиВКаталог"" КАК ВеткаДанных
	|ИЗ
	|	Документ.ПакетВыгрузкиОтчетности КАК ПакетВыгрузкиОтчетности
	|ГДЕ
	|	ПакетВыгрузкиОтчетности.Ссылка В(&Пакеты)
	|	И &ИспользоватьКаталог
	|	И ПакетВыгрузкиОтчетности.СпособВыгрузки = &Каталог
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПакетВыгрузкиОтчетности.Ссылка,
	|	""ДанныеВыгрузкиНаФТП""
	|ИЗ
	|	Документ.ПакетВыгрузкиОтчетности КАК ПакетВыгрузкиОтчетности
	|ГДЕ
	|	ПакетВыгрузкиОтчетности.Ссылка В(&Пакеты)
	|	И &ИспользоватьFTP
	|	И ПакетВыгрузкиОтчетности.СпособВыгрузки = &FTP
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПакетВыгрузкиОтчетности.Ссылка,
	|	""ДанныеВыгрузкиВФНС""
	|ИЗ
	|	Документ.ПакетВыгрузкиОтчетности КАК ПакетВыгрузкиОтчетности
	|ГДЕ
	|	ПакетВыгрузкиОтчетности.Ссылка В(&Пакеты)
	|	И &ИспользоватьОбменСФНС
	|	И ПакетВыгрузкиОтчетности.СпособВыгрузки = &ОбменСФНС
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПакетВыгрузкиОтчетности.Ссылка,
	|	""ДанныеВыгрузкиЧерезEmail""
	|ИЗ
	|	Документ.ПакетВыгрузкиОтчетности КАК ПакетВыгрузкиОтчетности
	|ГДЕ
	|	ПакетВыгрузкиОтчетности.Ссылка В(&Пакеты)
	|	И &ИспользоватьEmail
	|	И ПакетВыгрузкиОтчетности.СпособВыгрузки = &Email";
	
	ТаблицаПакетов = Запрос.Выполнить().Выгрузить();
	Для Каждого СтрокаТаблицы Из ТаблицаПакетов Цикл 
		ТекущаяВетка = ДанныеОтправки[СтрокаТаблицы.ВеткаДанных];
		ТекущаяВетка.ИспользоватьВыгрузку = Истина;
		ТекущаяВетка.МассивПакетов.Добавить(СтрокаТаблицы.Пакет);
		
	КонецЦикла;
	
КонецПроцедуры	

Процедура ЗаполнитьДанныеПакетов(ДанныеВыгрузки)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Пакеты",ДанныеВыгрузки.МассивПакетов);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПакетВыгрузкиОтчетности.Ссылка КАК Пакет,
	|	ПакетВыгрузкиОтчетности.Организация КАК Организация,
	|	ПакетВыгрузкиОтчетности.Период КАК Период,
	|	ПакетВыгрузкиОтчетности.ПутьВыгрузки КАК Путь,
	|	ПакетВыгрузкиОтчетности.НастройкаЭкспорта.FTPСервер КАК FTPСервер,
	|	ПакетВыгрузкиОтчетности.НастройкаЭкспорта.FTPПорт КАК FTPПорт,
	|	ПакетВыгрузкиОтчетности.НастройкаЭкспорта.FTPПуть КАК FTPПуть,
	|	ПакетВыгрузкиОтчетности.НастройкаЭкспорта.FTPПользователь КАК FTPПользователь,
	|	ПакетВыгрузкиОтчетности.НастройкаЭкспорта.FTPПароль КАК FTPПароль,
	|	ПакетВыгрузкиОтчетности.НастройкаЭкспорта.УчетнаяЗаписьЭлектроннойПочты КАК УчетнаяЗаписьЭлектроннойПочты,
	|	ПакетВыгрузкиОтчетности.НастройкаЭкспорта.Получатели КАК Получатели
	|ИЗ
	|	Документ.ПакетВыгрузкиОтчетности КАК ПакетВыгрузкиОтчетности
	|ГДЕ
	|	ПакетВыгрузкиОтчетности.Ссылка В(&Пакеты)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПакетВыгрузкиОтчетности.Дата";
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаРезультата Из РезультатЗапроса Цикл 
		
		СтруктураДанных = Новый Структура(ДанныеВыгрузки.ОписаниеСтруктураДанныхПакетов);
		ЗаполнитьЗначенияСвойств(СтруктураДанных,СтрокаРезультата);
		
		ДанныеВыгрузки.ДанныеПакетов.Добавить(СтруктураДанных);
		
		
	КонецЦикла;
	
КонецПроцедуры	

Функция РаспаковатьДанныеПакетов(Пакеты,ДанныеОтправки)
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Пакет");
	Результат.Колонки.Добавить("Группа");
	Результат.Колонки.Добавить("ПолноеИмя");
	Результат.Колонки.Добавить("ОтносительноеИмя");
	Результат.Колонки.Добавить("ОтносительныйПуть");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Пакеты",Пакеты);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПакетВыгрузкиОтчетностиФайлыОтчетов.Ссылка КАК Пакет,
	|	ПакетВыгрузкиОтчетностиФайлыОтчетов.Группа КАК Группа,
	|	ПакетВыгрузкиОтчетностиФайлыОтчетов.ДанныеФайлов КАК ДанныеФайлов
	|ИЗ
	|	Документ.ПакетВыгрузкиОтчетности.ФайлыОтчетов КАК ПакетВыгрузкиОтчетностиФайлыОтчетов
	|ГДЕ
	|	ПакетВыгрузкиОтчетностиФайлыОтчетов.Ссылка В(&Пакеты)";
	
	ДанныеДляСохранения = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаДанных Из ДанныеДляСохранения Цикл
		
		ИмяВременногоZipФала = ПолучитьИмяВременногоФайла("ZIP");
		ИмяВременногоКаталога = Лев(ИмяВременногоZipФала,СтрДлина(ИмяВременногоZipФала)- 4) + ПолучитьРазделительПути();
		
		ДанныеОтправки.ВременныеФайлы.Добавить(ИмяВременногоZipФала);
		ДанныеОтправки.ВременныеФайлы.Добавить(ИмяВременногоКаталога);
		
		
		ДвоичныеДанныеАрхива = СтрокаДанных.ДанныеФайлов.Получить();
		ДвоичныеДанныеАрхива.Записать(ИмяВременногоZipФала);
		
		ЧтениеФайла = Новый ЧтениеZipФайла(ИмяВременногоZipФала);
		Для Каждого ЭлементВАрхиве Из ЧтениеФайла.Элементы Цикл 
			
			ЧтениеФайла.Извлечь(ЭлементВАрхиве,ИмяВременногоКаталога);
			
			ПолноеИмя = ОбщегоНазначенияКлиентСервер.ПолучитьПолноеИмяФайла(ИмяВременногоКаталога, ЭлементВАрхиве.ПолноеИмя);
			
			ДанныеОтправки.ВременныеФайлы.Добавить(ПолноеИмя);
			
			НоваяСтрокаРезультата = Результат.Добавить();
			НоваяСтрокаРезультата.Пакет = СтрокаДанных.Пакет;
			НоваяСтрокаРезультата.Группа = СтрокаДанных.Группа;
			НоваяСтрокаРезультата.ПолноеИмя = ПолноеИмя;
			НоваяСтрокаРезультата.ОтносительноеИмя = ЭлементВАрхиве.ПолноеИмя;
			НоваяСтрокаРезультата.ОтносительныйПуть = ЭлементВАрхиве.Путь;

			
		КонецЦикла;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции	

Процедура УдалитьВременныеФайлы(ДанныеОтправки)
	
	Для Каждого ПутьВременногоФайла Из ДанныеОтправки.ВременныеФайлы Цикл 
		
		УдалитьФайлы(ПутьВременногоФайла);
		
	КонецЦикла;
	
КонецПроцедуры	

