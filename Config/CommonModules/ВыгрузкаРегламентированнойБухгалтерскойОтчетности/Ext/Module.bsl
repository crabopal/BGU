// Каталог

Процедура ВыгрузкаВКаталогСервер(ДанныеОтправки)
	ДанныеВыгрузки = ДанныеОтправки.ДанныеВыгрузкиВКаталог;
	Если ДанныеВыгрузки.ИспользоватьВыгрузку = Ложь Тогда 
		Возврат;
	КонецЕсли;	
	
	ЗаполнитьДанныеПакетов(ДанныеВыгрузки);
	
	РезультатСохранения = РаспаковатьДанныеПакетов(ДанныеВыгрузки.МассивПакетов,ДанныеОтправки);
	Для Каждого ДанныеПакета Из ДанныеВыгрузки.ДанныеПакетов Цикл
		
		ФайлыТекущегоПакета = РезультатСохранения.НайтиСтроки(Новый Структура("Пакет",ДанныеПакета.Пакет));
		
		МассивПолучаемыхФайлов = Новый Массив;
		
		Для Каждого СтрокаФайла Из ФайлыТекущегоПакета Цикл 
			
			НовоеОписание = Новый ОписаниеПередаваемогоФайла;
			НовоеОписание.Имя = СтрокаФайла.ОтносительноеИмя;
			НовоеОписание.Хранение = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(СтрокаФайла.ПолноеИмя),Новый УникальныйИдентификатор);
			
			ДанныеОтправки.ВременныеДанныеВХранилище.Добавить(НовоеОписание.Хранение);
			
			МассивПолучаемыхФайлов.Добавить(НовоеОписание);
		КонецЦикла;
		
		ДанныеПакета.ПолучаемыеФайлы = МассивПолучаемыхФайлов; 
		
	КонецЦикла;
	
	
КонецПроцедуры

// Каталог
////////////////////////////////////////////////////////////////////////////////
// FTP

Процедура ВыгрузкаНаФТПСервер(ДанныеОтправки)
	ДанныеВыгрузки = ДанныеОтправки.ДанныеВыгрузкиНаФТП;
	Если ДанныеВыгрузки.ИспользоватьВыгрузку = Ложь Тогда 
		Возврат;
	КонецЕсли;
	
	ХранилищеСоединений = Новый Соответствие;
	
	ЗаполнитьДанныеПакетов(ДанныеВыгрузки); 
	
	РезультатСохранения = РаспаковатьДанныеПакетов(ДанныеВыгрузки.МассивПакетов,ДанныеОтправки);
	
	Для Каждого ДанныеПакета Из ДанныеВыгрузки.ДанныеПакетов Цикл 
		
		ФайлыТекущегоПакета = РезультатСохранения.НайтиСтроки(Новый Структура("Пакет",ДанныеПакета.Пакет));
		
		Если Не ЗначениеЗаполнено(ФайлыТекущегоПакета) Тогда 
			
			Шаблон = НСтр("ru = 'Нет файлов по пакету ""%1 (""%2"" ""%3"")"".'");
			Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон,ДанныеПакета.Пакет, ДанныеПакета.Организация, ДанныеПакета.Период);
			ОбщегоНазначения.СообщитьПользователю(Сообщение);
			
			ДанныеОтправки.ПропущенныеПакеты.Добавить(ДанныеПакета.Пакет);
			
			Продолжить;
			
		КонецЕсли;	
		
		Попытка
			СоединениеFTP = ПолучитьСоединениеFTP(ДанныеВыгрузки, ДанныеПакета.FTPСервер, ДанныеПакета.FTPПорт, ДанныеПакета.FTPПользователь, ДанныеПакета.FTPПароль, ХранилищеСоединений);
			ПодготовитьКаталог(СоединениеFTP,ДанныеПакета.FTPПуть);
			СоединениеFTP.УстановитьТекущийКаталог(ДанныеПакета.FTPПуть);
			
			Для Каждого СтрокаФайла Из ФайлыТекущегоПакета Цикл 
				
				ПутьНаСервере = СтрЗаменить(СтрокаФайла.ОтносительныйПуть,"\","/"); 
				ПодготовитьКаталог(СоединениеFTP,ПутьНасервере,Истина);
				
				ИмяНаСервере = СтрЗаменить(СтрокаФайла.ОтносительноеИмя,"\","/");
				
				НайденныеФайлы = СоединениеFTP.НайтиФайлы(ИмяНаСервере);
				Если ЗначениеЗаполнено(НайденныеФайлы) Тогда 
					СоединениеFTP.Удалить(ИмяНаСервере);
				КонецЕсли;	
				
				СоединениеFTP.Записать(СтрокаФайла.ПолноеИмя,ИмяНаСервере);
				
			КонецЦикла;	
			
		Исключение
			Шаблон = НСтр("ru = 'Не удалось выгрузить на FTP пакет""%1"".
                           |%2'");
			Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон,ДанныеПакета.Пакет,ОписаниеОшибки());   
			ОбщегоНазначения.СообщитьПользователю(Сообщение);
			
			ДанныеОтправки.ПропущенныеПакеты.Добавить(ДанныеПакета.Пакет);
			
			Продолжить;
		КонецПопытки;
		
		Шаблон = НСтр("ru = '%1 (""%2"" ""%3"") успешно выгружен на FTP.'");
		Пояснение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон,ДанныеПакета.Пакет, ДанныеПакета.Организация, ДанныеПакета.Период);   
		
		СтруктураОповещения = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ДанныеОтправки.ШаблонСтрокиОповещенияПользователя);
		СтруктураОповещения.Текст = НСтр("ru = 'Пакет успешно выгружен на FTP.'");
		СтруктураОповещения.Пояснение = Пояснение;
		СтруктураОповещения.НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(ДанныеПакета.Пакет);
		СтруктураОповещения.Картинка = БиблиотекаКартинок.Успешно32;
		
		ДанныеОтправки.ОповещенияПользователя.Добавить(СтруктураОповещения);
		
		ДанныеОтправки.ОтправленныеПакеты.Добавить(ДанныеПакета.Пакет);
		
	КонецЦикла;
	
	
КонецПроцедуры

Функция ПолучитьСоединениеFTP(ДанныеВыгрузки, FTPСервер, FTPПорт, FTPПользователь, FTPПароль, ХранилищеСоединений)
	СтрокаПоиска = FTPСервер+FTPПорт+FTPПользователь+FTPПароль; 
	
	НайденнаяСтрока = ХранилищеСоединений.Получить(СтрокаПоиска);
	Если НайденнаяСтрока = Неопределено Тогда 
		
		Попытка
			
			Прокси = ПолучениеФайловИзИнтернета.ПолучитьПрокси("ftp");
			
			СоединениеFTP =  Новый FTPСоединение(FTPСервер,
				?(ЗначениеЗаполнено(FTPПорт),FTPПорт,Неопределено),
				?(ЗначениеЗаполнено(FTPПользователь),FTPПользователь,Неопределено),
				?(ЗначениеЗаполнено(FTPПароль),FTPПароль,Неопределено),
				Прокси);
			
		Исключение
			Шаблон = НСтр("ru = 'Не удалось соединится с FTP.
			|%2'");
			Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон,ОписаниеОшибки());
			ВызватьИсключение Сообщение;
		КонецПопытки;	
		
		ХранилищеСоединений.Вставить(СтрокаПоиска,СоединениеFTP);
		
	Иначе 
		
		СоединениеFTP = НайденнаяСтрока;
		
	КонецЕсли;
	
	Возврат СоединениеFTP;
	
КонецФункции	

Процедура ПодготовитьКаталог(СоединениеFTP, Путь, УдалятьМешающиеФайлы= Ложь, ТекущийПуть = "/")
	Если Путь = "/" Тогда 
		Возврат;	// корень точно есть
	КонецЕсли;	
	
	Если Путь = ТекущийПуть Тогда 
		Возврат;
	КонецЕсли;
	
	ПодстрокиПолногоПути = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Путь,"/",Истина);
	ПодстрокиТекущегоПути = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекущийПуть,"/",Истина);
		
	
	ПроверяемыйПуть = "";
	Для н = 0 По ПодстрокиТекущегоПути.Количество() Цикл  
		ПроверяемыйПуть = ПроверяемыйПуть + "/" + ПодстрокиПолногоПути[н];
	КонецЦикла;
	
	
	НайденныеФайлы = СоединениеFTP.НайтиФайлы(ПроверяемыйПуть);
	Если ЗначениеЗаполнено(НайденныеФайлы) Тогда
		
		НайденныйФайл = НайденныеФайлы[0]; 
		Если НайденныйФайл.ЭтоКаталог() Тогда 
			ПодготовитьКаталог(СоединениеFTP, Путь, УдалятьМешающиеФайлы, ПроверяемыйПуть);
			
		Иначе 
			Если УдалятьМешающиеФайлы Тогда 
				СоединениеFTP.Удалить(ПроверяемыйПуть);
				СоединениеFTP.СоздатьКаталог(Путь);
				Возврат;
				
			Иначе 	
				Шаблон =НСтр("ru = 'Нельзя создать путь ""%1"".
				|Конфликт с существующим файлом ""%2"".'"); 
				ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон,Путь,ПроверяемыйПуть);
				
			КонецЕсли;
		КонецЕсли;

	Иначе 
		СоединениеFTP.СоздатьКаталог(Путь);
		Возврат; 
		
	КонецЕсли;
	
КонецПроцедуры	

// FTP
