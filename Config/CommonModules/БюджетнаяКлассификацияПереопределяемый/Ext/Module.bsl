Процедура ОбработкаПолученияДанныхВыбораТипаКонтрагента(ДанныеВыбора, Параметры, СтандартнаяОбработка) Экспорт
	
	Если Параметры.Отбор.Свойство("ВидКонтрагента") Тогда
		
		МассивКодов = Новый Массив;
		МассивКодов.Добавить("0");
		
		Если  Параметры.Отбор.ВидКонтрагента = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ФизЛицо") Тогда
			МассивКодов.Добавить("6");
			МассивКодов.Добавить("7");
		ИначеЕсли Параметры.Отбор.ВидКонтрагента = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ЮрЛицо") Тогда
			МассивКодов.Добавить("1");
			МассивКодов.Добавить("2");
			МассивКодов.Добавить("3");
			МассивКодов.Добавить("4");
			МассивКодов.Добавить("5");
			МассивКодов.Добавить("6");
			МассивКодов.Добавить("8");
			МассивКодов.Добавить("9"); 
		Иначе
			МассивКодов.Добавить("1");
			МассивКодов.Добавить("2");
			МассивКодов.Добавить("3");
			МассивКодов.Добавить("4");
			МассивКодов.Добавить("5");
			МассивКодов.Добавить("6");
			МассивКодов.Добавить("7");
			МассивКодов.Добавить("8");
			МассивКодов.Добавить("9");
		КонецЕсли;
		
		Параметры.Отбор.Вставить("Код", Новый ФиксированныйМассив(МассивКодов));
		
	КонецЕсли;
		
КонецПроцедуры

