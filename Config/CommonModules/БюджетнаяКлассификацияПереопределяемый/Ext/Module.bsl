// Обработчик получения данных выбора перечисления КВД
//
// Параметры соответствуют параметрам процедуры ОбработкаПолученияДанныхВыбора()
// менеджера перечисления
//
Процедура ПриОбработкеПолученияДанныхВыбораКВД(ДанныеВыбора, Параметры, СтандартнаяОбработка) Экспорт
	БухгалтерскийУчет.ПриОбработкеПолученияДанныхВыбораКВД(ДанныеВыбора, Параметры, СтандартнаяОбработка);
КонецПроцедуры	

// Обработчик получения данных выбора справочника КОСГУ (КЭК)
//
// Параметры соответствуют параметрам процедуры ОбработкаПолученияДанныхВыбора()
// менеджера перечисления
//
Процедура ПриОбработкеПолученияДанныхВыбораКОСГУ(ДанныеВыбора, Параметры, СтандартнаяОбработка) Экспорт
	
	Если Параметры.Свойство("ДополнительныйОтбор") Тогда
		ОтборКЭК = БухгалтерскийУчет.ОграниченияКЭК(Параметры);
		Если ОтборКЭК.Количество() > 0 Тогда
			Параметры.ДополнительныйОтбор = ОтборКЭК;
			Если НЕ Параметры.Свойство("ПредустановленныйОтбор")
				ИЛИ НЕ ЗначениеЗаполнено(Параметры.ПредустановленныйОтбор) Тогда
				ДанныеВыбора = Новый СписокЗначений;
				ДанныеВыбора.ЗагрузитьЗначения(Параметры.ДополнительныйОтбор);
				ДанныеВыбора.СортироватьПоЗначению();
				Параметры.Отбор.Вставить("Ссылка", ОтборКЭК);
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	БухгалтерскиеОперацииСервер.ПриОбработкеПолученияДанныхВыбораКОСГУ(ДанныеВыбора, Параметры, СтандартнаяОбработка);
	
КонецПроцедуры

