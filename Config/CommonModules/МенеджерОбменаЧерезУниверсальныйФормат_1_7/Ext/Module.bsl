Процедура ВыгрузитьОстатки(КомпонентыОбмена) Экспорт
	ДатаВводаОстатков	= НачалоДня(КомпонентыОбмена.ПараметрыКонвертации.ДатаНачалаВыгрузкиДокументов)-1;
	МассивЦМО			= КомпонентыОбмена.ПараметрыКонвертации.МассивЦМО;
	ТипЦены				= КомпонентыОбмена.ПараметрыКонвертации.ТипЦены;
	
	МассивВыборки = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаВводаОстатков",	Новый Граница(ДатаВводаОстатков, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ТипЦены",			ТипЦены);
	Запрос.Текст = "ВЫБРАТЬ
	               |	Прейскурант.Ссылка КАК Номенклатура,
	               |	ТоварыВТорговыхТочкахОстатки.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	ТоварыВТорговыхТочкахОстатки.КоличествоОстаток КАК Количество,
	               |	ЦеныНоменклатурыСрезПоследних.Цена КАК Цена,
	               |	ТоварыВТорговыхТочкахОстатки.КоличествоОстаток * ЦеныНоменклатурыСрезПоследних.Цена КАК Сумма,
	               |	ТоварыВТорговыхТочкахОстатки.Организация КАК Организация
	               |ИЗ
	               |	РегистрНакопления.ТоварыВТорговыхТочках.Остатки(%ПараметрыВТ%) КАК ТоварыВТорговыхТочкахОстатки
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Прейскурант КАК Прейскурант
	               |		ПО ТоварыВТорговыхТочкахОстатки.Номенклатура = Прейскурант.Номенклатура
	               |			И ТоварыВТорговыхТочкахОстатки.Организация = Прейскурант.Организация
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(&ДатаВводаОстатков, ТипЦен = &ТипЦены) КАК ЦеныНоменклатурыСрезПоследних
	               |		ПО ТоварыВТорговыхТочкахОстатки.Организация = ЦеныНоменклатурыСрезПоследних.Организация
	               |			И ТоварыВТорговыхТочкахОстатки.Номенклатура = ЦеныНоменклатурыСрезПоследних.Номенклатура
	               |ГДЕ
	               |	НЕ Прейскурант.СнятаСПродажи";
	
	Если ЗначениеЗаполнено(МассивЦМО) Тогда
		Запрос.УстановитьПараметр("МассивЦМО", МассивЦМО);
		ПараметрыВТ = "&ДатаВводаОстатков, ЦМО В (&МассивЦМО)";
	Иначе
		ПараметрыВТ = "&ДатаВводаОстатков";
	КонецЕсли;
		
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "%ПараметрыВТ%", ПараметрыВТ);
		
	ТЗ_Товары = Запрос.Выполнить().Выгрузить();
	
	Если ТЗ_Товары.Количество() > 0 Тогда
		
		Организация = ТЗ_Товары[0].Организация;	
		Контрагент = Новый Структура("Наименование, ИНН, КПП, ЮридическоеФизическоеЛицо", Организация.Наименование, Организация.ИНН, Организация.КПП, "ЮридическоеЛицо");
		
		ДанныеИБ = Новый Структура("Дата, Номер, Организация, Контрагент, Сумма, Товары");
		ДанныеИБ.Дата			= ДатаВводаОстатков;
		ДанныеИБ.Номер			= Формат(1, "ЧГ=");
		ДанныеИБ.Организация	= Организация;
		ДанныеИБ.Контрагент		= Контрагент;
		ДанныеИБ.Сумма			= ТЗ_Товары.Итог("Сумма");
		ДанныеИБ.Товары			= ТЗ_Товары;
		
		
		ДанныеИБ.Вставить("ДополнительныеСвойства", Новый Структура);
		
		ПравилоОбработки = КомпонентыОбмена.ПравилаОбработкиДанных.Добавить();
		ПравилоОбработки.Имя = "Документ_ОстаткиТоварыВТорговыхТочках_Отправка";
		ПравилоОбработки.ОчисткаДанных = Ложь;
		ПравилоОбработки.ИспользуемыеПКО.Добавить("Документ_ОстаткиТоварыВТорговыхТочках_Отправка");
			
		ОбменДаннымиXDTOСервер.ВыгрузкаОбъектаВыборки(КомпонентыОбмена, ДанныеИБ, ПравилоОбработки);
	КонецЕсли;
КонецПроцедуры
Функция ДанныеКоллекцииВВидеСтруктуры(Источник, ПравилаЗаполнения)
	Результат = Новый Структура;
	
	Для Каждого ПравилоЗаполнения Из ПравилаЗаполнения Цикл
	
		СтруктураДляПереносаЗначения = Новый Структура(ПравилоЗаполнения.Ключ, Неопределено);
		ЗаполнитьЗначенияСвойств(СтруктураДляПереносаЗначения, Источник);
		
		Значение = СтруктураДляПереносаЗначения[ПравилоЗаполнения.Ключ];
		Если Значение <> Неопределено Тогда
			Результат.Вставить(ПравилоЗаполнения.Значение, Значение);
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат Результат
КонецФункции
Процедура ЗаполнитьСвойстваШапкиОбъекта(КонвертацияСвойств, ПолученныеДанные, ДанныеИБ, МассивИсключений = Неопределено)
	Для Каждого СвойствоОбъекта Из КонвертацияСвойств Цикл
		СвойствоИБ = СвойствоОбъекта.СвойствоКонфигурации;
		Если СокрЛП(СвойствоИБ) = "" Тогда
			Продолжить;
		КонецЕсли;
		Если МассивИсключений <> Неопределено И МассивИсключений.Найти(СвойствоИБ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ДанныеИБ[СвойствоИБ] = ПолученныеДанные[СвойствоИБ];
	КонецЦикла;
КонецПроцедуры
Процедура ЗаполнитьТабличнуюЧастьОбъектаНачальнымиДанными(ТабличнаяЧастьОбъектаПослеОбработки, ТабличнаяЧастьОбъектаДоОбработки, КлючевыеПоля = "", КолонкиДляВключения = "", КолонкиДляИсключения = "")
	ОбменДаннымиXDTOСервер.ЗаполнитьТабличнуюЧастьОбъектаНачальнымиДанными(
		ТабличнаяЧастьОбъектаПослеОбработки, 
		ТабличнаяЧастьОбъектаДоОбработки,
		КлючевыеПоля, 
		КолонкиДляВключения, 
		КолонкиДляИсключения);
КонецПроцедуры
Процедура ОтложеннаяОбработка_ЧекККМ(Объект, ПараметрыКонвертации, ОбъектМодифицирован)
	ВсегоОплачено = Объект.Оплата[0].Сумма;
	ВсегоКомиссияБанка = Объект.Оплата[0].СуммаКомиссии;
	ПроцентБанка = Объект.Оплата[0].ПроцентКомиссии; 
	Для каждого ТекТоварУслуга Из Объект.ТоварыРаботыУслуги Цикл
		Если ВсегоОплачено = 0 Тогда 
			Прервать;
		КонецЕсли;
		
		НоваяСтрока = Объект.РасшифровкаОплаты.Добавить();
		НоваяСтрока.КлючСвязиОплаты = 1;
		НоваяСтрока.СтатьяАналитикиОплаты = ТекТоварУслуга.Номенклатура.ОсновнаяСтатьяАналитикиОплаты;
		
		ПолноеПогашение = Истина;
		Если ВсегоОплачено < ТекТоварУслуга.Всего Тогда
			ПолноеПогашение = Ложь;
		КонецЕсли;	
		
		НоваяСтрока.Сумма = ?(ПолноеПогашение, ТекТоварУслуга.Всего, ВсегоОплачено);
		Если ВсегоКомиссияБанка > 0 Тогда
			НоваяСтрока.СуммаКомиссии = Окр(НоваяСтрока.Сумма * ПроцентБанка / 100, 2);	
			
			Если НЕ ПолноеПогашение Тогда
				НоваяСтрока.СуммаКомиссии = ВсегоКомиссияБанка;
			КонецЕсли;	
			
			ВсегоКомиссияБанка = ВсегоКомиссияБанка - НоваяСтрока.СуммаКомиссии;
		Конецесли;	
		
		ВсегоОплачено = ВсегоОплачено - НоваяСтрока.Сумма;
	КонецЦикла;
КонецПроцедуры

