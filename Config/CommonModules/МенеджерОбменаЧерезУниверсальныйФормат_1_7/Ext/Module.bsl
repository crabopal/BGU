Процедура ПКО_Документ_ОтчетОРозничныхПродажах_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	СписокСтатьиАО = Новый СписокЗначений;
	
	Для Каждого СтрокаТЧ ИЗ ПолученныеДанные.ПродажиТовары Цикл
		ПараметрыРасчета = Новый Структура;
		ПараметрыРасчета.Вставить("СуммаВключаетНДС", ДанныеXDTO.СуммаВключаетНДС);
		ПараметрыРасчета.Вставить("РассчитыватьЦену", Истина);
		УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(СтрокаТЧ, "СУММАНДС", ПараметрыРасчета);
		СтрокаТЧ.ЭтоРозничныйПокупатель = Истина;
		
		ОсновнаяСтатьяАналитикиОплаты = СтрокаТЧ.Номенклатура.ОсновнаяСтатьяАналитикиОплаты;
		Если СписокСтатьиАО.НайтиПоЗначению(ОсновнаяСтатьяАналитикиОплаты) = Неопределено Тогда
			СписокСтатьиАО.Добавить(ОсновнаяСтатьяАналитикиОплаты);	
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаТЧ ИЗ ПолученныеДанные.ПродажиРаботыУслуги Цикл
		ПараметрыРасчета = Новый Структура;
		ПараметрыРасчета.Вставить("СуммаВключаетНДС", ДанныеXDTO.СуммаВключаетНДС);
		ПараметрыРасчета.Вставить("РассчитыватьЦену", Истина);
		УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(СтрокаТЧ, "СУММАНДС", ПараметрыРасчета);
		СтрокаТЧ.ЭтоРозничныйПокупатель = Истина;
		
		ОсновнаяСтатьяАналитикиОплаты = СтрокаТЧ.Номенклатура.ОсновнаяСтатьяАналитикиОплаты;
		Если СписокСтатьиАО.НайтиПоЗначению(ОсновнаяСтатьяАналитикиОплаты) = Неопределено Тогда
			СписокСтатьиАО.Добавить(ОсновнаяСтатьяАналитикиОплаты);	
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаТЧ ИЗ ПолученныеДанные.ВозвратТовары Цикл
		ПараметрыРасчета = Новый Структура;
		ПараметрыРасчета.Вставить("СуммаВключаетНДС", ДанныеXDTO.СуммаВключаетНДС);
		ПараметрыРасчета.Вставить("РассчитыватьЦену", Истина);
		УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(СтрокаТЧ, "СУММАНДС", ПараметрыРасчета);
		СтрокаТЧ.ЭтоРозничныйПокупатель = Истина;
		
		ОсновнаяСтатьяАналитикиОплаты = СтрокаТЧ.Номенклатура.ОсновнаяСтатьяАналитикиОплаты;
		Если СписокСтатьиАО.НайтиПоЗначению(ОсновнаяСтатьяАналитикиОплаты) = Неопределено Тогда
			СписокСтатьиАО.Добавить(ОсновнаяСтатьяАналитикиОплаты);	
		КонецЕсли;
	КонецЦикла;
	
	Если СписокСтатьиАО.Количество() = 1 Тогда
		КомпонентыОбмена.ПараметрыКонвертации.СтатьяАналитикиОплаты = СписокСтатьиАО[0].Значение;
	КонецЕсли;
	
	
	ПолученныеДанные.Комментарий = "Загружен из 1С:Касса\" + ПолученныеДанные.Комментарий;
КонецПроцедуры

Процедура ПКО_Документ_ОтчетОРозничныхПродажах_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	КассыККМ = КомпонентыОбмена.УзелКорреспондента.КассыККМ;
	КассаККМ = Справочники.ФискальныеРегистраторы.ПустаяСсылка();
	ПараметрыДоговораЭквайринга = Справочники.ПараметрыДоговораЭквайринга.ПустаяСсылка();
	ПроцентКомиссии = 0;
	ВидПлатежнойКарты = Справочники.ВидыПлатежныхКарт.ПустаяСсылка();
		
	Если ЗначениеЗаполнено(ПолученныеДанные.Организация) Тогда
		Для Каждого СтрокаКассыККМ Из КассыККМ Цикл
			Если СтрокаКассыККМ.КассаККМ.Организация = ПолученныеДанные.Организация Тогда
				КассаККМ = СтрокаКассыККМ.КассаККМ;
				ПараметрыДоговораЭквайринга = СтрокаКассыККМ.ПараметрыДоговораЭквайринга;
				Прервать;
			КонецЕсли;
		КонецЦикла; 
	КонецЕсли;
	
	Отбор = Новый Структура("ОсновнойВид", Истина);
	СтрокиТарифы = ПараметрыДоговораЭквайринга.ТарифыЗаРасчетноеОбслуживание.НайтиСтроки(Отбор);
	
	СтатьяАналитикиОплаты = КомпонентыОбмена.ПараметрыКонвертации.СтатьяАналитикиОплаты;
	
	ПолученныеДанные.ОплатаПлатежнымиКартами.Свернуть("ВидОперации", "Сумма"); 
	
	Для Каждого СтрокаТЧ ИЗ ПолученныеДанные.ОплатаПлатежнымиКартами Цикл
	
		Если СтрокиТарифы.Количество() > 0 Тогда 
			СтрокаТЧ.ВидПлатежнойКарты		= СтрокиТарифы[0].ВидПлатежнойКарты;
			ПроцентКомиссии = СтрокиТарифы[0].ПроцентТорговойУступки; 
		КонецЕсли;
	
		СтрокаТЧ.ВидОперации 					= Перечисления.ВидыОперацийЧекККМ.Продажа;
		СтрокаТЧ.СтатьяАналитикиОплаты          = СтатьяАналитикиОплаты;
		СтрокаТЧ.СистемаНалогообложенияЧекаККМ	= КассаККМ.СистемаНалогообложенияЧекаККМ;
		СтрокаТЧ.ПараметрыДоговораЭквайринга	= ПараметрыДоговораЭквайринга;
		СтрокаТЧ.ВидПлатежнойКарты				= ВидПлатежнойКарты;
		СтрокаТЧ.ПроцентКомиссии				= ПроцентКомиссии;
		СтрокаТЧ.СуммаКомиссии					= СтрокаТЧ.Сумма*ПроцентКомиссии/100;
		СтрокаТЧ.Контрагент						= КассаККМ.КонтрагентДляРозничныхПродаж;
		СтрокаТЧ.Договор						= КассаККМ.ДоговорДляРозничныхПродаж;
		
		Если ПараметрыДоговораЭквайринга.Терминалы.Количество() > 0 Тогда
			СтрокаТЧ.ЭквайринговыйТерминал = ПараметрыДоговораЭквайринга.Терминалы[0].ЭквайринговыйТерминал;
		КонецЕсли;
		
		СтрокаТЧ.ЭтоРозничныйПокупатель			= Истина;
		
	КонецЦикла;
	
	ИтогПродажиТовары			= ПолученныеДанные.ПродажиТовары.Итог("Сумма");
	ИтогПродажиРаботыУслуги		= ПолученныеДанные.ПродажиРаботыУслуги.Итог("Сумма");
	ИтогОплатаПлатежнымиКартами	= ПолученныеДанные.ОплатаПлатежнымиКартами.Итог("Сумма");
	
	СуммаОплатаНаличными = ИтогПродажиТовары + ИтогПродажиРаботыУслуги - ИтогОплатаПлатежнымиКартами; 
	
	Если ДанныеИБ = Неопределено Тогда
		НоваяСтрока = ПолученныеДанные.ОплатаНаличными.Добавить();
	Иначе
		ДанныеИБ.ОплатаНаличными.Очистить();
		НоваяСтрока = ДанныеИБ.ОплатаНаличными.Добавить();
	КонецЕсли;
	НоваяСтрока.ВидОперации 					= Перечисления.ВидыОперацийЧекККМ.Продажа;
	НоваяСтрока.СтатьяАналитикиОплаты 			= СтатьяАналитикиОплаты;
	НоваяСтрока.СистемаНалогообложенияЧекаККМ	= КассаККМ.СистемаНалогообложенияЧекаККМ;
	НоваяСтрока.Сумма                           = СуммаОплатаНаличными;
	НоваяСтрока.Контрагент						= КассаККМ.КонтрагентДляРозничныхПродаж;
	НоваяСтрока.Договор							= КассаККМ.ДоговорДляРозничныхПродаж;
	НоваяСтрока.ЭтоРозничныйПокупатель 			= Истина;
	
	ПолученныеДанные.КассаККМ = КассаККМ;
	ПолученныеДанные.СуммаДокумента = СуммаОплатаНаличными;
	ПолученныеДанные.СуммаПродажНаличнымиРозничнымПокупателям = СуммаОплатаНаличными;
КонецПроцедуры
#КонецОбласти
#Область Документ_ЧекККМ_Получение
Процедура ДобавитьПКО_Документ_ЧекККМ_Получение(ПравилаКонвертации)

	ПравилоКонвертации = ОбменДаннымиXDTOСервер.ИнициализироватьПравилоКонвертацииОбъекта(ПравилаКонвертации);
	ПравилоКонвертации.ИмяПКО                       = "Документ_ЧекККМ_Получение";
	ПравилоКонвертации.ОбъектДанных                 = Метаданные.Документы.ЧекККМ;
	ПравилоКонвертации.ОбъектФормата                = "Документ.ЧекККМ";
	ПравилоКонвертации.ПриКонвертацииДанныхXDTO     = "ПКО_Документ_ЧекККМ_Получение_ПриКонвертацииДанныхXDTO";
	ПравилоКонвертации.ПередЗаписьюПолученныхДанных = "ПКО_Документ_ЧекККМ_Получение_ПередЗаписьюПолученныхДанных";
	ПравилоКонвертации.ПослеЗагрузкиВсехДанных      = "ОтложеннаяОбработка_ЧекККМ";
	ПравилоКонвертации.ВариантИдентификации         = "СначалаПоУникальномуИдентификаторуПотомПоПолямПоиска";
	
	СвойстваШапки = ПравилоКонвертации.Свойства;
	ДобавитьПКС(СвойстваШапки, "Дата",           "Дата");
	ДобавитьПКС(СвойстваШапки, "КассаККМ",       "КассаККМ", , "Справочник_КассыККМ");
	ДобавитьПКС(СвойстваШапки, "НомерСменыККМ",  "НомерКассовойСмены");
	ДобавитьПКС(СвойстваШапки, "НомерЧекаККМ",   "НомерЧекаФР");
	ДобавитьПКС(СвойстваШапки, "СуммаДокумента", "Сумма");
	ДобавитьПКС(СвойстваШапки, "ФормаОплаты",    "", 1);
	
	СвойстваТЧ = ДобавитьПКТЧ(ПравилоКонвертации, "ТоварыРаботыУслуги", "");
	ДобавитьПКС(СвойстваТЧ, "Количество",   "", 1);
	ДобавитьПКС(СвойстваТЧ, "Номенклатура", "", 1,"Справочник_ПрейскурантНоменклатура_Получение");
	ДобавитьПКС(СвойстваТЧ, "Содержание",   "", 1);
	ДобавитьПКС(СвойстваТЧ, "СтавкаНДС",    "", 1,"Перечисление_СтавкиНДС");
	ДобавитьПКС(СвойстваТЧ, "Сумма",        "", 1);
	ДобавитьПКС(СвойстваТЧ, "СуммаНДС",     "", 1);
	ДобавитьПКС(СвойстваТЧ, "Цена",         "", 1);

	ПравилоКонвертации.ПоляПоиска.Добавить("КассаККМ,НомерСменыККМ,НомерЧекаККМ");
КонецПроцедуры

Процедура ПКО_Документ_ЧекККМ_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	МассивСтрокТовары = Новый Массив;
	ОплатаПлатежнойКартой = 0;
	
	ПравилаЗаполнения = Новый Соответствие;
	ПравилаЗаполнения.Вставить("Номенклатура", "Номенклатура");
	ПравилаЗаполнения.Вставить("Количество", "Количество");
	ПравилаЗаполнения.Вставить("Цена", "Цена");
	ПравилаЗаполнения.Вставить("Сумма", "Сумма");
	ПравилаЗаполнения.Вставить("СтавкаНДС", "СтавкаНДС");
	ПравилаЗаполнения.Вставить("СуммаНДС", "СуммаНДС");
	ПравилаЗаполнения.Вставить("Содержание", "Содержание");
	
	Если ДанныеXDTO.Свойство("Услуги") Тогда
		Для Каждого СтрокаТЧ Из ДанныеXDTO.Услуги Цикл
			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(СтрокаТЧ, ПравилаЗаполнения);
			МассивСтрокТовары.Добавить(СтруктураДанныхСтроки);
		КонецЦикла;
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("ТоварыПродажа") Тогда
		Для Каждого СтрокаТЧ Из ДанныеXDTO.ТоварыПродажа Цикл
			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(СтрокаТЧ, ПравилаЗаполнения);
			МассивСтрокТовары.Добавить(СтруктураДанныхСтроки);	
		КонецЦикла;
	КонецЕсли;
	
	ПолученныеДанные.ФормаОплаты = 0;
	Если ДанныеXDTO.Свойство("ОплатаПлатежнымиКартами") Тогда
		ОплатаПлатежнойКартой = ДанныеXDTO.ОплатаПлатежнымиКартами.Итог("СуммаОплаты");
		ПолученныеДанные.ФормаОплаты = 1; 
	ИначеЕсли ДанныеXDTO.Свойство("ОплатыККМ") Тогда 
		Для Каждого ТекСтрокаОплатыККМ Из ДанныеXDTO.ОплатыККМ Цикл
			Если ТекСтрокаОплатыККМ.ТипОплаты.Значение = "Электронно" Тогда 
				ПолученныеДанные.ФормаОплаты = 1;
				ОплатаПлатежнойКартой = ТекСтрокаОплатыККМ.Сумма;
				Прервать;
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;
			
	ПолученныеДанные.ДополнительныеСвойства.Вставить("ТоварыРаботыУслуги", МассивСтрокТовары);
	ПолученныеДанные.ДополнительныеСвойства.Вставить("ОплатаПлатежнойКартой", ОплатаПлатежнойКартой);
КонецПроцедуры

Процедура ПКО_Документ_ЧекККМ_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	КассыККМ = КомпонентыОбмена.УзелКорреспондента.КассыККМ; 
	ПроцентКомиссии = 0;
	ВидПлатежнойКарты = Справочники.ВидыПлатежныхКарт.ПустаяСсылка();
	
	ИскомаяСтрока = КассыККМ.Найти(ПолученныеДанные.КассаККМ, "КассаККМ"); 
	ПараметрыДоговораЭквайринга = ?(ИскомаяСтрока <> Неопределено,ИскомаяСтрока.ПараметрыДоговораЭквайринга,Справочники.ПараметрыДоговораЭквайринга.ПустаяСсылка()); 
	
	Если ЗначениеЗаполнено(ПолученныеДанные.КассаККМ) Тогда
		ПолученныеДанные.Организация						= ПолученныеДанные.КассаККМ.Организация;
		ПолученныеДанные.Контрагент							= ПолученныеДанные.КассаККМ.КонтрагентДляРозничныхПродаж;
		ПолученныеДанные.ПараметрыДоговораПлатежногоАгента	= ПараметрыДоговораЭквайринга;
		ПолученныеДанные.СистемаНалогообложенияЧекаККМ		= ПолученныеДанные.КассаККМ.СистемаНалогообложенияЧекаККМ;
		ПолученныеДанные.СуммаВключаетНДС					= ПолученныеДанные.КассаККМ.СуммаВключаетНДС;
		ПолученныеДанные.ТипЦены							= ПолученныеДанные.КассаККМ.ТипЦены;
	КонецЕсли;
	
	ПолученныеДанные.Проведен                           = Истина;
	ПолученныеДанные.Комментарий						= "Загружен из " + КомпонентыОбмена.УзелКорреспондента.Наименование + "\";
	ПолученныеДанные.ПризнакСпособаРасчетаЧекаККМ       = Перечисления.ПризнакиСпособаРасчета.ПередачаСПолнойОплатой;
	ПолученныеДанные.СтатусЧекаККМ						= Перечисления.СтатусыЧековККМ.Пробитый;
	ПолученныеДанные.ТипРасчета							= Перечисления.ТипыРасчетаДенежнымиСредствами.ПриходДенежныхСредств;
	ПолученныеДанные.ЭтоРозничныйПокупатель				= Истина;
	
	Для Каждого СтрокаТЧ ИЗ ПолученныеДанные.ТоварыРаботыУслуги Цикл
		СтрокаТЧ.КлючСвязи = 1;
		СтрокаТЧ.ЦенаБезСкидок = СтрокаТЧ.Цена;
		ПараметрыРасчета = Новый Структура;
		ПараметрыРасчета.Вставить("СуммаВключаетНДС", ПолученныеДанные.КассаККМ.СуммаВключаетНДС);
		ПараметрыРасчета.Вставить("РассчитыватьЦену", Ложь);
		УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(СтрокаТЧ, "СУММАНДС", ПараметрыРасчета);
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ПолученныеДанные.ДополнительныеСвойства.ОплатаПлатежнойКартой) ИЛИ ПолученныеДанные.ФормаОплаты = 1 Тогда
		
		Отбор = Новый Структура("ОсновнойВид", Истина);
		СтрокиТарифы = ПараметрыДоговораЭквайринга.ТарифыЗаРасчетноеОбслуживание.НайтиСтроки(Отбор);
		Если СтрокиТарифы.Количество() > 0 Тогда 
			ВидПлатежнойКарты = СтрокиТарифы[0].ВидПлатежнойКарты;
			ПроцентКомиссии = СтрокиТарифы[0].ПроцентТорговойУступки; 
		КонецЕсли;	
	
		Если ПараметрыДоговораЭквайринга.Терминалы.Количество() > 0 Тогда
			ЭквайринговыйТерминал = ПараметрыДоговораЭквайринга.Терминалы[0].ЭквайринговыйТерминал;
		КонецЕсли;
		
		Оплата = ПолученныеДанные.Оплата.Добавить();	
		Оплата.ТипОплаты					= Перечисления.ТипыОплатЧекаККМ.ПлатежнаяКарта;
		Оплата.ЭквайринговыйТерминал		= ЭквайринговыйТерминал;
		Оплата.Сумма						= ПолученныеДанные.СуммаДокумента;
		Оплата.ПроцентКомиссии				= ПроцентКомиссии;
		Оплата.СуммаКомиссии				= ПолученныеДанные.СуммаДокумента * ПроцентКомиссии / 100;
		Оплата.ДанныеПереданыВБанк			= Истина;
		Оплата.ПараметрыДоговораЭквайринга	= ПараметрыДоговораЭквайринга;
		Оплата.ВидПлатежнойКарты			= ВидПлатежнойКарты;
		Оплата.КлючСвязиОплаты				= 1;
	Иначе
		Оплата = ПолученныеДанные.Оплата.Добавить();	
		Оплата.ТипОплаты					= Перечисления.ТипыОплатЧекаККМ.Наличные;
		Оплата.Сумма						= ПолученныеДанные.СуммаДокумента;
		Оплата.ДанныеПереданыВБанк			= Ложь;
		Оплата.КлючСвязиОплаты				= 1;
	КонецЕсли;
	
	Если ДанныеИБ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Заменяем свойства, которые получили из XDTO
	ЗаполнитьСвойстваШапкиОбъекта(КонвертацияСвойств, ПолученныеДанные, ДанныеИБ);
	
	//ТоварыРаботыУслуги
	ДанныеИБ.ТоварыРаботыУслуги.Загрузить(ПолученныеДанные.ТоварыРаботыУслуги.Выгрузить());
	
	//Оплата
	ДанныеИБ.Оплата.Загрузить(ПолученныеДанные.Оплата.Выгрузить());
КонецПроцедуры
#КонецОбласти
#Область Документ_ЧекККМНаВозврат_Получение
Процедура ДобавитьПКО_Документ_ЧекККМНаВозврат_Получение(ПравилаКонвертации)

	ПравилоКонвертации = ОбменДаннымиXDTOСервер.ИнициализироватьПравилоКонвертацииОбъекта(ПравилаКонвертации);
	ПравилоКонвертации.ИмяПКО                       = "Документ_ЧекККМНаВозврат_Получение";
	ПравилоКонвертации.ОбъектДанных                 = Метаданные.Документы.ЧекККМНаВозврат;
	ПравилоКонвертации.ОбъектФормата                = "Документ.ЧекККМ";
	ПравилоКонвертации.ПриКонвертацииДанныхXDTO     = "ПКО_Документ_ЧекККМНаВозврат_Получение_ПриКонвертацииДанныхXDTO";
	ПравилоКонвертации.ПередЗаписьюПолученныхДанных = "ПКО_Документ_ЧекККМНаВозврат_Получение_ПередЗаписьюПолученныхДанных";
	ПравилоКонвертации.ПослеЗагрузкиВсехДанных      = "ОтложеннаяОбработка_ЧекККМ";
	ПравилоКонвертации.ВариантИдентификации         = "СначалаПоУникальномуИдентификаторуПотомПоПолямПоиска";
	
	СвойстваШапки = ПравилоКонвертации.Свойства;
	ДобавитьПКС(СвойстваШапки, "Дата",           "Дата");
	ДобавитьПКС(СвойстваШапки, "КассаККМ",       "КассаККМ", , "Справочник_КассыККМ");
	ДобавитьПКС(СвойстваШапки, "НомерСменыККМ",  "НомерКассовойСмены");
	ДобавитьПКС(СвойстваШапки, "НомерЧекаККМ",   "НомерЧекаФР");
	ДобавитьПКС(СвойстваШапки, "СуммаДокумента", "Сумма");
	ДобавитьПКС(СвойстваШапки, "ФормаОплаты",    "", 1);
	
	СвойстваТЧ = ДобавитьПКТЧ(ПравилоКонвертации, "ТоварыРаботыУслуги", "");
	ДобавитьПКС(СвойстваТЧ, "Количество",   "", 1);
	ДобавитьПКС(СвойстваТЧ, "Номенклатура", "", 1,"Справочник_ПрейскурантНоменклатура_Получение");
	ДобавитьПКС(СвойстваТЧ, "Содержание",   "", 1);
	ДобавитьПКС(СвойстваТЧ, "СтавкаНДС",    "", 1,"Перечисление_СтавкиНДС");
	ДобавитьПКС(СвойстваТЧ, "Сумма",        "", 1);
	ДобавитьПКС(СвойстваТЧ, "СуммаНДС",     "", 1);
	ДобавитьПКС(СвойстваТЧ, "Цена",         "", 1);

	ПравилоКонвертации.ПоляПоиска.Добавить("Дата,КассаККМ,НомерСменыККМ,НомерЧекаККМ");
КонецПроцедуры

Процедура ПКО_Документ_ЧекККМНаВозврат_Получение_ПриКонвертацииДанныхXDTO(ДанныеXDTO, ПолученныеДанные, КомпонентыОбмена)
	МассивСтрокТовары = Новый Массив;
	ОплатаПлатежнойКартой = 0;
	
	ПравилаЗаполнения = Новый Соответствие;
	ПравилаЗаполнения.Вставить("Номенклатура", "Номенклатура");
	ПравилаЗаполнения.Вставить("Количество", "Количество");
	ПравилаЗаполнения.Вставить("Цена", "Цена");
	ПравилаЗаполнения.Вставить("Сумма", "Сумма");
	ПравилаЗаполнения.Вставить("СтавкаНДС", "СтавкаНДС");
	ПравилаЗаполнения.Вставить("СуммаНДС", "СуммаНДС");
	ПравилаЗаполнения.Вставить("Содержание", "Содержание");
	
	Если ДанныеXDTO.Свойство("ТоварыВозвратПродажи") Тогда
		Для Каждого СтрокаТЧ Из ДанныеXDTO.ТоварыВозвратПродажи Цикл
			СтруктураДанныхСтроки = ДанныеКоллекцииВВидеСтруктуры(СтрокаТЧ, ПравилаЗаполнения);
			МассивСтрокТовары.Добавить(СтруктураДанныхСтроки);	
		КонецЦикла;
	КонецЕсли;
	
	ПолученныеДанные.ФормаОплаты = 0;
	Если ДанныеXDTO.Свойство("ОплатаПлатежнымиКартами") Тогда
		ОплатаПлатежнойКартой = ДанныеXDTO.ОплатаПлатежнымиКартами.Итог("СуммаОплаты");
		ПолученныеДанные.ФормаОплаты = 1; 
	ИначеЕсли ДанныеXDTO.Свойство("ОплатыККМ") Тогда 
		Для Каждого ТекСтрокаОплатыККМ Из ДанныеXDTO.ОплатыККМ Цикл
			Если ТекСтрокаОплатыККМ.ТипОплаты.Значение = "Электронно" Тогда 
				ПолученныеДанные.ФормаОплаты = 1;
				ОплатаПлатежнойКартой = ТекСтрокаОплатыККМ.Сумма;
				Прервать;
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;
			
	ПолученныеДанные.ДополнительныеСвойства.Вставить("ТоварыРаботыУслуги", МассивСтрокТовары);
	ПолученныеДанные.ДополнительныеСвойства.Вставить("ОплатаПлатежнойКартой", ОплатаПлатежнойКартой);
КонецПроцедуры

Процедура ПКО_Документ_ЧекККМНаВозврат_Получение_ПередЗаписьюПолученныхДанных(ПолученныеДанные, ДанныеИБ, КонвертацияСвойств, КомпонентыОбмена)
	КассыККМ = КомпонентыОбмена.УзелКорреспондента.КассыККМ; 
	ПроцентКомиссии = 0;
	ВидПлатежнойКарты = Справочники.ВидыПлатежныхКарт.ПустаяСсылка();
	
	ИскомаяСтрока = КассыККМ.Найти(ПолученныеДанные.КассаККМ, "КассаККМ"); 
	ПараметрыДоговораЭквайринга = ?(ИскомаяСтрока <> Неопределено,ИскомаяСтрока.ПараметрыДоговораЭквайринга,Справочники.ПараметрыДоговораЭквайринга.ПустаяСсылка()); 
	
	Если ЗначениеЗаполнено(ПолученныеДанные.КассаККМ) Тогда
		ПолученныеДанные.Организация						= ПолученныеДанные.КассаККМ.Организация;
		ПолученныеДанные.Контрагент							= ПолученныеДанные.КассаККМ.КонтрагентДляРозничныхПродаж;
		ПолученныеДанные.ПараметрыДоговораПлатежногоАгента	= ПараметрыДоговораЭквайринга;
		ПолученныеДанные.СистемаНалогообложенияЧекаККМ		= ПолученныеДанные.КассаККМ.СистемаНалогообложенияЧекаККМ;
		ПолученныеДанные.СуммаВключаетНДС					= ПолученныеДанные.КассаККМ.СуммаВключаетНДС;
		ПолученныеДанные.ТипЦены							= ПолученныеДанные.КассаККМ.ТипЦены;
	КонецЕсли;
	
	ПолученныеДанные.Проведен                           = Истина;
	ПолученныеДанные.Комментарий						= "Загружен из " + КомпонентыОбмена.УзелКорреспондента.Наименование + "\";
	ПолученныеДанные.ПризнакСпособаРасчетаЧекаККМ       = Перечисления.ПризнакиСпособаРасчета.ПередачаСПолнойОплатой;
	ПолученныеДанные.СтатусЧекаККМ						= Перечисления.СтатусыЧековККМ.Пробитый;
	ПолученныеДанные.ТипРасчета							= Перечисления.ТипыРасчетаДенежнымиСредствами.ВозвратДенежныхСредств;
	ПолученныеДанные.ЭтоРозничныйПокупатель				= Истина;
	
	Для Каждого СтрокаТЧ ИЗ ПолученныеДанные.ТоварыРаботыУслуги Цикл
		СтрокаТЧ.КлючСвязи = 1;
		СтрокаТЧ.ЦенаБезСкидок = СтрокаТЧ.Цена;
		ПараметрыРасчета = Новый Структура;
		ПараметрыРасчета.Вставить("СуммаВключаетНДС", ПолученныеДанные.КассаККМ.СуммаВключаетНДС);
		ПараметрыРасчета.Вставить("РассчитыватьЦену", Ложь);
		УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(СтрокаТЧ, "СУММАНДС", ПараметрыРасчета);
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ПолученныеДанные.ДополнительныеСвойства.ОплатаПлатежнойКартой) Тогда
		Отбор = Новый Структура("ОсновнойВид", Истина);
		СтрокиТарифы = ПараметрыДоговораЭквайринга.ТарифыЗаРасчетноеОбслуживание.НайтиСтроки(Отбор);
		Если СтрокиТарифы.Количество() > 0 Тогда 
			ВидПлатежнойКарты = СтрокиТарифы[0].ВидПлатежнойКарты;
			ПроцентКомиссии = СтрокиТарифы[0].ПроцентТорговойУступки; 
		КонецЕсли;	
	
		Если ПараметрыДоговораЭквайринга.Терминалы.Количество() > 0 Тогда
			ЭквайринговыйТерминал = ПараметрыДоговораЭквайринга.Терминалы[0].ЭквайринговыйТерминал;
		КонецЕсли;
		
		Оплата = ПолученныеДанные.Оплата.Добавить();	
		Оплата.ТипОплаты					= Перечисления.ТипыОплатЧекаККМ.ПлатежнаяКарта;
		Оплата.ЭквайринговыйТерминал		= ЭквайринговыйТерминал;
		Оплата.Сумма						= ПолученныеДанные.СуммаДокумента;
		Оплата.ПроцентКомиссии				= ПроцентКомиссии;
		Оплата.СуммаКомиссии				= -(ПолученныеДанные.СуммаДокумента * ПроцентКомиссии / 100);
		Оплата.ДанныеПереданыВБанк			= Истина;
		Оплата.ПараметрыДоговораЭквайринга	= ПараметрыДоговораЭквайринга;
		Оплата.ВидПлатежнойКарты			= ВидПлатежнойКарты;
		Оплата.КлючСвязиОплаты				= 1;
	Иначе
		Оплата = ПолученныеДанные.Оплата.Добавить();	
		Оплата.ТипОплаты					= Перечисления.ТипыОплатЧекаККМ.Наличные;
		Оплата.Сумма						= ПолученныеДанные.СуммаДокумента;
		Оплата.ДанныеПереданыВБанк			= Ложь;
		Оплата.КлючСвязиОплаты				= 1;
	КонецЕсли;
	
	
	Если ДанныеИБ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Заменяем свойства, которые получили из XDTO
	ЗаполнитьСвойстваШапкиОбъекта(КонвертацияСвойств, ПолученныеДанные, ДанныеИБ);
	
	//ТоварыРаботыУслуги
	ДанныеИБ.ТоварыРаботыУслуги.Загрузить(ПолученныеДанные.ТоварыРаботыУслуги.Выгрузить());
	
	//Оплата
	ДанныеИБ.Оплата.Загрузить(ПолученныеДанные.Оплата.Выгрузить());
КонецПроцедуры
#КонецОбласти
