Процедура ПКО_Справочник_ПрейскурантНоменклатура_Отправка_ПриОтправкеДанных(ДанныеИБ, ДанныеXDTO, КомпонентыОбмена, СтекВыгрузки)
	ОтправлятьГруппыПрейскурант = КомпонентыОбмена.ПараметрыКонвертации.ОтправлятьГруппыПрейскурант;
	
	Если СтекВыгрузки.Количество() > 1 Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ДанныеИБ.ЭтоГруппа Тогда
		Если ЗначениеЗаполнено(ДанныеИБ.Номенклатура.НаименованиеДляЧекаККМ) Тогда
			ДанныеXDTO.КлючевыеСвойства.Наименование = ДанныеИБ.Номенклатура.НаименованиеДляЧекаККМ;
		КонецЕсли;
		Если РозничныеПродажиБГУ.ТипНоменклатуры(ДанныеИБ.Номенклатура) = 3 Тогда
			ДанныеXDTO.Вставить("ТипНоменклатуры",	"Товар");
		Иначе
			ДанныеXDTO.Вставить("ТипНоменклатуры",	"Услуга");
		КонецЕсли;
		ДанныеXDTO.Вставить("ЕдиницаИзмерения",			ДанныеИБ.Номенклатура.ЕдиницаИзмерения);
		ДанныеXDTO.Вставить("СтавкаНДС",				ДанныеИБ.Номенклатура.СтавкаНДС);
	
		Если ОтправлятьГруппыПрейскурант Тогда 
			ДанныеXDTO.Вставить("Группа", ДанныеИБ.Родитель);
		КонецЕсли; 
	Иначе	
		ДанныеXDTO.Вставить("ТипНоменклатуры", "");
		ДанныеXDTO.Вставить("НаименованиеПолное", "");
	КонецЕсли;
КонецПроцедуры
