Процедура ПОД_Документ_ЧекККМ_ПриОбработке(ДанныеXDTO, ИспользованиеПКО, КомпонентыОбмена)
	ЗагрузитьОбъект = Истина;
	ИспользованиеПКО.Документ_ЧекККМ_Получение = Ложь;
	ИспользованиеПКО.Документ_ЧекККМНаВозврат_Получение = Ложь;
	
	Если ДанныеXDTO.Свойство("Отменен") Тогда
		Если ДанныеXDTO.Отменен Или КомпонентыОбмена.УзелКорреспондента.ВыгружатьЧекиКакОтчетОРозничныхПродажах Тогда
			ЗагрузитьОбъект = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("ТоварыПродажа") Или ДанныеXDTO.Свойство("Услуги") Тогда
		ИспользованиеПКО.Документ_ЧекККМ_Получение = ЗагрузитьОбъект;
	КонецЕсли;
	
	Если ДанныеXDTO.Свойство("ТоварыВозвратПродажи") Тогда
		ИспользованиеПКО.Документ_ЧекККМНаВозврат_Получение = ЗагрузитьОбъект;
	КонецЕсли;
КонецПроцедуры
