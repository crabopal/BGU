// Модуль предназначен для описания функций, возращающих дополнительные источники данных.
// Модуль обязательно должен содержать в неизменном виде процедуру ОбъявленияВсехФункцийМодуля и функцию ВыполнитьФункциюПолученияИсточникаДанных.
// Так же для удобства добавлены функции и процедуры:
//	ДобавитьЗаголовокОписанияФункции - добавляет новое описание функции в массив описаний,
//	ДобавитьПолеРезультатаФункции - добавляет структру описания поля результата функции в массив полей,
//	ДобавитьОписаниеПараметраФункции - добавляет структуру описания параметра функции в массив параметров,
//	ДобавитьКолонкиРезультатаПоОписанию - добавляет колонки в таблицу значений из массива описания полей,
//	ДобавитьТипыДокументовВОбъявлениеФункции - добавляет допустимые типы документов для функции
//
//	МЕТОДИКА РАБОТЫ ДОПОЛНИТЕЛЬНЫХ ИСТОЧНИКОВ ДАННЫХ - ФУНКЦИЙ
//
//	Дополнительный источник данных - это таблица значений, которая может использоваться в качестве источника данных при формировании проводок операции.
//	Заполнение таблицы дополнительного истчника данных происходит в последний момент перед формированием проводок.
//
//	Объявление функции заполнения источника данных производится в процедуре ОбъявленияВсехФункцийМодуля. После этого функция может быть выбрана для заполнения источника данных
//	в режиме "Предприятие".
//	Указанная функция должна быть описана в этом модуле. Функция не должна быть экспортной. Вызов функции производится через промежуточную функцию 
//	"ВыполнитьФункциюПолученияИсточникаДанных" автоматически. Внутри функции доступны данные документа (включая дополнительные реквизиты и дополнительные колонки и табличные части).
//	Так же в функцию могут быть переданы параметры, что позволяет использовать функцию без привязки к контексту конкретной типовой операции.
//
// Каждая функция может возвращать: требуемые параметры, колонки источника данных, сам источник данных (таблица значений).
// Варианты вызова функции взаимоисключающие. Вызываются автоматически.
// Параметры функций:
//	ВариантВызова - Строка	- "ПолучитьПоля" - функция вызвана для получения массива полей. Для добавления полей в массив используется функция "ДобавитьПолеРезультатаФункции".
//							- "ПолучитьПараметры" - функция вызвана для получения массива параметров. Для добавления параметров в массив используется функция "ДобавитьОписаниеПараметраФункции".
//							- "Выполнить" - функция вызвана для выполнения основного алгоритма.
//						Если вариант вызова "ПолучитьПоля" или "ПолучитьПараметры", то остальные параметры функции не заполняются и все содержат Неопределено
//	ИсточникиДанных - Структура - содержит данные объекта в виде структуры, содержащей в каждом ключе таблицу значений.
//								Данные шапки документа содержатся в ключе "Документ", данные табличных частей содержатся в ключах,
//								совпадающих с именем табличной части
//	ТиповаяОперация - СправочникСсылка.ТиповыеОперации - типовая операция, по которой формируются проводки
//	Параметры - Структура - содержит параметры функции: ключ - имя параметра, значение - значение параметра.
//						Состав параметров определяется из массива, который возвращается при вызове, где ВариантВызова = "ПолучитьПараметры"
//
// Возвращаемое значение:
//	ТаблицаЗначений - состав колонок должен совпадать с возращаемыми при вызове, где ВариантВызова = "ПолучитьПоля", т.к. эти поля могут использоваться в настройках
//
// Для использования функции ее нужно добавить в массив ВсеФункцииМодуля в функции ОписаниеФункцийМодуля.
// Для добавления используется функция ДобавитьЗаголовокОписанияФункции, которая возращает структуру описания текущей функции. В структуре уже заполнены имя функции, поля и параметры.
// Остается заполнить Заголовок и Описание и ТипыДокументов, если нужно.
//
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

//обязательные процедуры и функции модуля

// Дополняет массив ВсеФункцииМодуля объявлениями функций заполнения дополнительных источников данных из текущего модуля
//
// Параметры:
//	ВсеФункцииМодуля - Массив
//
Процедура ОбъявленияВсехФункцийМодуля(ВсеФункцииМодуля) Экспорт 

	//ФункцияМодуля = ДобавитьЗаголовокОписанияФункции(ВсеФункцииМодуля, "ТестоваяФункцияСПараметром");
	//ФункцияМодуля.Заголовок	= "Тестовая функция с параметром";
	//ФункцияМодуля.Описание	= НСтр("ru = 'Возвращает произвольную таблицу проводок. Параметром должна быть организация'");
	
КонецПроцедуры

Функция ВыполнитьФункциюПолученияИсточникаДанных(ИмяФункции, ИсточникиДанных, ТиповаяОперация, Параметры) Экспорт

	ПроверитьИмяФункции(ИмяФункции);
	Возврат Вычислить(ИмяФункции + "(""Выполнить"", ИсточникиДанных, ТиповаяОперация, Параметры)");

КонецФункции // ВыполнитьФункциюПолученияИсточникаДанных()

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроцедурыИФункцииДляФункционированияМеханизма_НеДляИзменения

Процедура ПроверитьИмяФункции(ИмяФункции)
	ИмяФункцииВРег = ВРег(ИмяФункции);
	ВсеИсточники = Новый Массив;
	ОбъявленияВсехФункцийМодуля(ВсеИсточники);
	Для Каждого ФункцияИсточника Из ВсеИсточники Цикл
		Если ИмяФункцииВРег = ВРег(ФункцияИсточника.Имя) Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение СтрШаблон(НСтр("ru = 'В источник данных в модуле БухгалтерскиеОперацииИсточникиДанныхПереопределяемый передано имя несуществующей функции
		|%1'"), ИмяФункции);
КонецПроцедуры

Функция ДобавитьЗаголовокОписанияФункции(ВсеФункцииМодуля, ИмяФункции)
	
	Если СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(ИмяФункции).Количество() > 1 Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'В общем модуле БухгалтерскиеОперацииИсточникиДанныхПереопределяемый нельзя вызывать функции заполнения источников данных из других модулей.
			|Имя ошибочной функции: %1'"), ИмяФункции);
	КонецЕсли;
	
	Попытка
		СтруктураПроверки = Новый Структура(ИмяФункции);
	Исключение
		ВызватьИсключение СтрШаблон(НСтр("ru = 'В общем модуле БухгалтерскиеОперацииИсточникиДанныхПереопределяемый указана ошибочная функция.
			|Имя ошибочной функции: %1'"), ИмяФункции);
	КонецПопытки;
	
	НоваяФункция = Новый Структура("Имя, Заголовок, Описание, Поля, Параметры", ИмяФункции, "", "", Новый Массив, Новый Массив);
	
	НоваяФункция = Новый Структура;
	НоваяФункция.Вставить("Имя",			ИмяФункции);
	НоваяФункция.Вставить("Заголовок",		"");
	НоваяФункция.Вставить("Описание",		"");
	НоваяФункция.Вставить("ТипыДокументов", Новый Массив);
	
	Поля = Вычислить("" + ИмяФункции + "(""ПолучитьПоля"", Неопределено, Неопределено, Неопределено)");
	Если ТипЗнч(Поля) <> Тип("Массив") Тогда
		Поля = Новый Массив;
	КонецЕсли;
	НоваяФункция.Вставить("Поля", Поля);
	
	Параметры = Вычислить("" + ИмяФункции + "(""ПолучитьПараметры"", Неопределено, Неопределено, Неопределено)");
	Если ТипЗнч(Параметры) <> Тип("Массив") Тогда
		Параметры = Новый Массив;
	КонецЕсли;
	НоваяФункция.Вставить("Параметры", Параметры);
	НоваяФункция.Вставить("ЗависитОтФункций", "");
	
	ВсеФункцииМодуля.Добавить(НоваяФункция);
	Возврат ВсеФункцииМодуля[ВсеФункцииМодуля.ВГраница()];
	
КонецФункции // ДобавитьЗаголовокОписанияФункции()

Процедура ДобавитьПолеРезультатаФункции(Поля, ИмяПоля, Тип)

	Поля.Добавить(Новый Структура("Имя, Тип", ИмяПоля, Тип));

КонецПроцедуры

Процедура ДобавитьОписаниеПараметраФункции(Параметры, ИмяПараметра, Тип)

	Параметры.Добавить(Новый Структура("Имя, Тип", ИмяПараметра, Тип));

КонецПроцедуры

Процедура ДобавитьКолонкиРезультатаПоОписанию(ТаблицаРезультат, ПоляФункции)

	Для каждого ПолеРезультата Из ПоляФункции Цикл
	
		ТаблицаРезультат.Колонки.Добавить(ПолеРезультата.Имя, ПолеРезультата.Тип);
	
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьТипыДокументовВОбъявлениеФункции(ФункцияМодуля, ИменаДокументовСтрокой)

	ИменаДокументов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(ИменаДокументовСтрокой);
	Для каждого ИмяДокумента Из ИменаДокументов Цикл
	
		ФункцияМодуля.ТипыДокументов.Добавить(Тип("ДокументСсылка." + ИмяДокумента));										
	
	КонецЦикла; 

КонецПроцедуры

#КонецОбласти

#Область ПроцедурыИФункцииДляРеализацииЛогикиПользователя_ДляИзменения

// Функция, показывающая основные приемы работы с дополнительными источниками данных для типовых операций.
// Для использования необходимо в процедуре ОбъявленияВсехФункцийМодуля вставить объявление функции:
//
//	ФункцияМодуля = ДобавитьЗаголовокОписанияФункции(ВсеФункцииМодуля, "ТестоваяФункцияСПараметром");
//	ФункцияМодуля.Заголовок	= "Тестовая функция с параметром";
//	ФункцияМодуля.Описание	= НСтр("ru = 'Возвращает произвольную таблицу проводок. Параметром должна быть организация'");
//
Функция ТестоваяФункцияСПараметром(ВариантВызова, ИсточникиДанных, ТиповаяОперация, Параметры)

	Если ВариантВызова = "ПолучитьПараметры" Тогда
		ПараметрыФункции = Новый Массив;
		
		ДобавитьОписаниеПараметраФункции(ПараметрыФункции, "Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
		
		Возврат ПараметрыФункции;
	КонецЕсли;
	
		ПоляФункции = Новый Массив;
		
		Для каждого ТекПоле Из Метаданные.РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.Измерения Цикл
			
			Если ТекПоле.Балансовый Тогда
				ДобавитьПолеРезультатаФункции(ПоляФункции, ТекПоле.Имя, ТекПоле.Тип);	
			Иначе
				ДобавитьПолеРезультатаФункции(ПоляФункции, ТекПоле.Имя + "Дт", ТекПоле.Тип);	
				ДобавитьПолеРезультатаФункции(ПоляФункции, ТекПоле.Имя + "Кт", ТекПоле.Тип);
			КонецЕсли;
		
		КонецЦикла; 
		
		Для каждого ТекПоле Из Метаданные.РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.Ресурсы Цикл
			
			Если ТекПоле.Балансовый Тогда
				ДобавитьПолеРезультатаФункции(ПоляФункции, ТекПоле.Имя, ТекПоле.Тип);	
			Иначе
				ДобавитьПолеРезультатаФункции(ПоляФункции, ТекПоле.Имя + "Дт", ТекПоле.Тип);	
				ДобавитьПолеРезультатаФункции(ПоляФункции, ТекПоле.Имя + "Кт", ТекПоле.Тип);
			КонецЕсли;
		
		КонецЦикла; 
		
		Для каждого ТекПоле Из Метаданные.РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.Реквизиты Цикл
			
			ДобавитьПолеРезультатаФункции(ПоляФункции, ТекПоле.Имя, ТекПоле.Тип);	
		
		КонецЦикла;
		
	ДобавитьПолеРезультатаФункции(ПоляФункции, "СчетДт", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));	
	ДобавитьПолеРезультатаФункции(ПоляФункции, "СубконтоДт1", Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип);	
	ДобавитьПолеРезультатаФункции(ПоляФункции, "СубконтоДт2", Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип);	
	ДобавитьПолеРезультатаФункции(ПоляФункции, "СубконтоДт3", Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип);	
	ДобавитьПолеРезультатаФункции(ПоляФункции, "СчетКт", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));	
	ДобавитьПолеРезультатаФункции(ПоляФункции, "СубконтоКт1", Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип);	
	ДобавитьПолеРезультатаФункции(ПоляФункции, "СубконтоКт2", Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип);	
	ДобавитьПолеРезультатаФункции(ПоляФункции, "СубконтоКт3", Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип);	
	ДобавитьПолеРезультатаФункции(ПоляФункции, "Регистратор", Документы.ТипВсеСсылки());	
		
	
	Если ВариантВызова = "ПолучитьПоля" Тогда
		Возврат ПоляФункции;
	КонецЕсли;
	
	Если ВариантВызова <> "Выполнить" Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаРезультат = Новый ТаблицаЗначений;
	Для каждого ПолеРезультата Из ПоляФункции Цикл
	
		ТаблицаРезультат.Колонки.Добавить(ПолеРезультата.Имя, ПолеРезультата.Тип);
	
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
				   |	*
				   |ИЗ
				   |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(, , Организация = &Организация, , 5) КАК ЖурналПроводокЕПСБУДвиженияССубконто";
	Запрос.УстановитьПараметр("Организация", Параметры.Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ЗаполнитьЗначенияСвойств(ТаблицаРезультат.Добавить(), Выборка);
		
	КонецЦикла;
	
	Возврат ТаблицаРезультат;
	
КонецФункции // ТестоваяФункцияСПараметром()

#КонецОбласти

#КонецОбласти

#КонецЕсли
