
#Область ПрограммныйИнтерфейс

Процедура ОткрытьФормуИзмененияСтатусаДокумента(Форма, РеквизитСтатуса = "УстановленныеРеквизитыИсполнения") Экспорт
	
	ПараметрыФормы = Новый Структура("ПлатежноРасчетныйДокумент, РеквизитыРегистрации, БлокироватьВладельца, ДатаПлатежноРасчетногоДокумента", 
	Форма.Объект.Ссылка, Форма[РеквизитСтатуса], Истина, Форма.Объект.Дата);
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма.Объект, "Договор") Тогда
		ПараметрыФормы.Вставить("Договор", Форма.Объект.Договор);
	КонецЕсли;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма.Объект, "ВалютаДокумента") Тогда
		ПараметрыФормы.Вставить("ВалютаДокумента", Форма.Объект.ВалютаДокумента);
	КонецЕсли;
	
	ОткрытьФорму("ОбщаяФорма.УстановкаСтатусаПлатежноРасчетногоДокумента", ПараметрыФормы, Форма);
	
КонецПроцедуры

Процедура ОбработатьОповещения(Форма, ИмяСобытия, Параметр, Источник, РеквизитСостояния = "УстановленныйСтатусДокумента", РеквизитСтатуса = "УстановленныеРеквизитыИсполнения", РеквизитФлагЗаписи = "УстановленныйСтатусЗаписать") Экспорт
	
	Если ИмяСобытия = "ИзмененСтатус_ПлатежноРасчетныйДокумент" И Форма.Объект.Ссылка = Источник Тогда
		
		УстановленныйСтатусДокумента  = Строка(Параметр.Статус);
		
		Если ЗначениеЗаполнено(Параметр.ДатаПроведения) Тогда
			УстановленныйСтатусДокумента  =	УстановленныйСтатусДокумента + " " + Параметр.ДатаПроведения;
		ИначеЕсли ЗначениеЗаполнено(Параметр.ДатаРегистрации) Тогда
			УстановленныйСтатусДокумента  =	УстановленныйСтатусДокумента + " " + Параметр.ДатаРегистрации;
		КонецЕсли;	
		
		Форма[РеквизитСостояния] 	= УстановленныйСтатусДокумента;
		
		Форма[РеквизитСтатуса] 		= Параметр;
		
		Форма[РеквизитФлагЗаписи]	= Параметр.Свойство("ЗаписатьВДокументе");
		
	КонецЕсли;
	
КонецПроцедуры	

#КонецОбласти