
#Область ПрограммныйИнтерфейс

// См. МодульСбораДанныхПовтИсп.ПолучитьКодРПБСОбластиДанных()
Функция ПолучитьКодРПБСОбластиДанных() Экспорт
	Возврат МодульСбораДанныхПовтИсп.ПолучитьКодРПБСОбластиДанных();
КонецФункции

// Определяет объекты конфигурации, в модулях менеджеров которых размещена процедура ДобавитьКомандыПечати,
// формирующая список команд печати, предоставляемых этим объектом.
// Синтаксис процедуры ДобавитьКомандыПечати см. в документации к подсистеме.
//
// Параметры:
//  СписокОбъектов - Массив - менеджеры объектов с процедурой ДобавитьКомандыПечати.
//
Процедура ПриОпределенииОбъектовСКомандамиПечати(СписокОбъектов) Экспорт
	
	СписокОбъектов.Добавить(Документы.ПакетыДанныхДляМСД);
	
КонецПроцедуры

// Получает сведения о наступивших сроках предоставления данных в МСД ПУиО.
// 
// Возвращаемое значение:
//  Массив - Массив структур с необходимыми сведениями для оповещения пользователя
//
Функция УведомлениеПользователя() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СведенияОСрокахПредоставленияДанныхМСД.ПериодДанных КАК ПериодДанных,
	|	ПериодыМСД.ДатаНачала КАК ДатаНачала,
	|	ПериодыМСД.ДатаОкончания КАК ДатаОкончания,
	|	ПериодыМСД.Периодичность КАК Периодичность
	|ПОМЕСТИТЬ ВТ_СрокСутки
	|ИЗ
	|	РегистрСведений.СведенияОСрокахПредоставленияДанныхМСД КАК СведенияОСрокахПредоставленияДанныхМСД
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПериодыМСД КАК ПериодыМСД
	|		ПО СведенияОСрокахПредоставленияДанныхМСД.ПериодДанных = ПериодыМСД.Ссылка
	|ГДЕ
	|	&ТекущаяДата МЕЖДУ ДОБАВИТЬКДАТЕ(КОНЕЦПЕРИОДА(СведенияОСрокахПредоставленияДанныхМСД.Срок, ДЕНЬ), ЧАС, &Сдвиг) И ДОБАВИТЬКДАТЕ(КОНЕЦПЕРИОДА(СведенияОСрокахПредоставленияДанныхМСД.Срок, ДЕНЬ), ЧАС, &Сдвиг + 24)
	|	И ГОД(СведенияОСрокахПредоставленияДанныхМСД.Срок) = ГОД(&ТекущаяДата)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_СрокСутки.ПериодДанных КАК ПериодДанных,
	|	ПакетыДанныхДляМСД.Ссылка КАК Ссылка,
	|	ВТ_СрокСутки.ДатаОкончания КАК ДатаОкончания,
	|	ВТ_СрокСутки.Периодичность КАК Периодичность
	|ПОМЕСТИТЬ ВТ_Пакеты
	|ИЗ
	|	ВТ_СрокСутки КАК ВТ_СрокСутки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПакетыДанныхДляМСД КАК ПакетыДанныхДляМСД
	|		ПО ВТ_СрокСутки.ДатаНачала = ПакетыДанныхДляМСД.НачалоПериода
	|			И НАЧАЛОПЕРИОДА(ВТ_СрокСутки.ДатаОкончания, ДЕНЬ) = НАЧАЛОПЕРИОДА(ПакетыДанныхДляМСД.ОкончаниеПериода, ДЕНЬ)
	|			И (ВЫБОР
	|				КОГДА ВТ_СрокСутки.Периодичность = ЗНАЧЕНИЕ(Перечисление.ПериодичностьМСД.Месяц)
	|					ТОГДА ПакетыДанныхДляМСД.ВидПередаваемыхДанных
	|				ИНАЧЕ ИСТИНА
	|			КОНЕЦ)
	|			И (НЕ ПакетыДанныхДляМСД.ПометкаУдаления)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПакетыДанныхМСД.ИмяПакета КАК ИмяПакета,
	|	ПакетыДанныхМСД.Пакет КАК Пакет,
	|	МАКСИМУМ(ПакетыДанныхМСД.ДатаФормирования) КАК ДатаФормирования
	|ПОМЕСТИТЬ ВТ_ПакетыСрез
	|ИЗ
	|	ВТ_Пакеты КАК ВТ_Пакеты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПакетыДанныхМСД КАК ПакетыДанныхМСД
	|		ПО ВТ_Пакеты.Ссылка = ПакетыДанныхМСД.Пакет
	|
	|СГРУППИРОВАТЬ ПО
	|	ПакетыДанныхМСД.ИмяПакета,
	|	ПакетыДанныхМСД.Пакет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПакетыДанныхМСД.Пакет КАК Пакет,
	|	ПакетыДанныхМСД.ИдентификаторПакета КАК ИдентификаторПакета,
	|	МАКСИМУМ(ПакетыДанныхМСД.ДатаСтатуса) КАК ДатаСтатуса
	|ПОМЕСТИТЬ ВТ_СтатусПакетаСрез
	|ИЗ
	|	ВТ_ПакетыСрез КАК ВТ_ПакетыСрез
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПакетыДанныхМСД КАК ПакетыДанныхМСД
	|		ПО ВТ_ПакетыСрез.Пакет = ПакетыДанныхМСД.Пакет
	|			И ВТ_ПакетыСрез.ИмяПакета = ПакетыДанныхМСД.ИмяПакета
	|			И ВТ_ПакетыСрез.ДатаФормирования = ПакетыДанныхМСД.ДатаФормирования
	|
	|СГРУППИРОВАТЬ ПО
	|	ПакетыДанныхМСД.Пакет,
	|	ПакетыДанныхМСД.ИдентификаторПакета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПакетыДанныхМСД.Пакет КАК Пакет,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПакетыДанныхМСД.ИдентификаторПакета) КАК КоличествоПакетов,
	|	СУММА(ВЫБОР
	|			КОГДА ПакетыДанныхМСД.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПакетовМСД.ПринятСБлокирующимиОшибками)
	|					ИЛИ ПакетыДанныхМСД.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПакетовМСД.ОшибкаОбработки)
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоПакетовНеПринят
	|ПОМЕСТИТЬ ВТ_ПакетСтатус
	|ИЗ
	|	ВТ_СтатусПакетаСрез КАК ВТ_СтатусПакетаСрез
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПакетыДанныхМСД КАК ПакетыДанныхМСД
	|		ПО ВТ_СтатусПакетаСрез.Пакет = ПакетыДанныхМСД.Пакет
	|			И ВТ_СтатусПакетаСрез.ИдентификаторПакета = ПакетыДанныхМСД.ИдентификаторПакета
	|			И ВТ_СтатусПакетаСрез.ДатаСтатуса = ПакетыДанныхМСД.ДатаСтатуса
	|
	|СГРУППИРОВАТЬ ПО
	|	ПакетыДанныхМСД.Пакет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Пакеты.ПериодДанных КАК ПериодДанных,
	|	ЕСТЬNULL(ВТ_ПакетСтатус.КоличествоПакетов, 0) КАК КоличествоПакетов,
	|	ЕСТЬNULL(ВТ_ПакетСтатус.КоличествоПакетовНеПринят, 0) КАК КоличествоПакетовНеПринят,
	|	ВТ_Пакеты.Периодичность = ЗНАЧЕНИЕ(Перечисление.ПериодичностьМСД.Месяц) КАК ЭтоОтчетныйПериод
	|ИЗ
	|	ВТ_Пакеты КАК ВТ_Пакеты
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПакетСтатус КАК ВТ_ПакетСтатус
	|		ПО ВТ_Пакеты.Ссылка = ВТ_ПакетСтатус.Пакет
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_Пакеты.ДатаОкончания";
	
	Сдвиг = Константы.СдвигАвтоформированияДанныхДляМСД.Получить();
	Запрос.УстановитьПараметр("Сдвиг", Сдвиг);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса()); 
	
	Выборка = Запрос.Выполнить().Выбрать();
	МассивРезультат = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		Если Выборка.КоличествоПакетов = 0 Тогда 
			СтруктураПериод = Новый Структура;
			СтруктураПериод.Вставить("ПериодДанных", Выборка.ПериодДанных);
			СтруктураПериод.Вставить("Результат", 
			СтрШаблон(НСтр("ru='Наступил срок предоставления %1 данных в МСД ПУиО. Пакет для предоставления данных еще не сформирован. Необходимо сформировать и отправить пакет.'"), 
			?(Выборка.ЭтоОтчетныйПериод, "отчетных", "оперативных")));
			СтруктураПериод.Вставить("ИдентификаторСтроки", "1_" + Выборка.ПериодДанных);
			МассивРезультат.Добавить(СтруктураПериод);	
		ИначеЕсли Выборка.КоличествоПакетовНеПринят > 0 Тогда
			СтруктураПериод = Новый Структура;
			СтруктураПериод.Вставить("ПериодДанных", Выборка.ПериодДанных);
			СтруктураПериод.Вставить("Результат", 
			СтрШаблон(НСтр("ru='Наступил срок предоставления %1 данных в МСД ПУиО. Пакет с данными не был принят. Необходимо повторить отправку пакета.'"), 
			?(Выборка.ЭтоОтчетныйПериод, "отчетных", "оперативных")));
			СтруктураПериод.Вставить("ИдентификаторСтроки", "2_" + Выборка.ПериодДанных);
			МассивРезультат.Добавить(СтруктураПериод);	
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат МассивРезультат;
	
КонецФункции

// Получить пространство имен для формата пакета поставщиков данных
// 
// Возвращаемое значение:
//  Строка - Пространство имен XML
//
Функция ПространствоИмен() Экспорт
	Возврат "MSD_DATA_FHD_1_0_1";
КонецФункции

Функция ПолучитьТекстЗапросаТаксономии() Экспорт
	
	Возврат "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СведенияОСрокахПредоставленияДанныхМСД.ПериодДанных КАК ПериодДанных,
		|	ЕСТЬNULL(ПакетыДанныхДляМСД.Ссылка, ЗНАЧЕНИЕ(Документ.ПакетыДанныхДляМСД.ПустаяСсылка)) КАК Ссылка,
		|	ПериодыМСД.ДатаНачала КАК ДатаНачала,
		|	ПериодыМСД.ДатаОкончания КАК ДатаОкончания,
		|	ПериодыМСД.Периодичность КАК Периодичность,
		|	ПериодыМСД.Представление КАК ПредставлениеПериода,
		|	КОНЕЦПЕРИОДА(СведенияОСрокахПредоставленияДанныхМСД.Срок, ДЕНЬ) КАК Срок,
		|	ПакетыДанныхДляМСД.ПервичнаяВыгрузка КАК ПервичнаяВыгрузка
		|ПОМЕСТИТЬ ВТ_ВсеПериоды
		|ИЗ
		|	РегистрСведений.СведенияОСрокахПредоставленияДанныхМСД КАК СведенияОСрокахПредоставленияДанныхМСД
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПериодыМСД КАК ПериодыМСД
		|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПакетыДанныхДляМСД КАК ПакетыДанныхДляМСД
		|			ПО (ПериодыМСД.ДатаНачала МЕЖДУ ПакетыДанныхДляМСД.НачалоПериода И ПакетыДанныхДляМСД.ОкончаниеПериода)
		|				И (ПериодыМСД.ДатаОкончания МЕЖДУ ПакетыДанныхДляМСД.НачалоПериода И ПакетыДанныхДляМСД.ОкончаниеПериода)
		|				И (НЕ ПакетыДанныхДляМСД.ПометкаУдаления)
		|				И (ПакетыДанныхДляМСД.Организация = &Организация)
		|				И (ВЫБОР
		|					КОГДА ПериодыМСД.Периодичность = ЗНАЧЕНИЕ(Перечисление.ПериодичностьМСД.Месяц)
		|						ТОГДА ПакетыДанныхДляМСД.ВидПередаваемыхДанных
		|					ИНАЧЕ ИСТИНА
		|				КОНЕЦ)
		|		ПО (СведенияОСрокахПредоставленияДанныхМСД.ПериодДанных = ПериодыМСД.Ссылка)
		|ГДЕ
		|	ДОБАВИТЬКДАТЕ(КОНЕЦПЕРИОДА(СведенияОСрокахПредоставленияДанныхМСД.Срок, ДЕНЬ), ЧАС, &Сдвиг) <= &ТекущаяДата
		|	И ГОД(СведенияОСрокахПредоставленияДанныхМСД.Срок) = ГОД(&ТекущаяДата)
		|	И СведенияОСрокахПредоставленияДанныхМСД.Организация = &Организация
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ВсеПериоды.ПериодДанных КАК ПериодДанных,
		|	ВТ_ВсеПериоды.ДатаНачала КАК ДатаНачала,
		|	ВТ_ВсеПериоды.ДатаОкончания КАК ДатаОкончания,
		|	ВТ_ВсеПериоды.Периодичность КАК Периодичность,
		|	ВТ_ВсеПериоды.ПредставлениеПериода КАК ПредставлениеПериода,
		|	ВЫБОР
		|		КОГДА ВТ_ВсеПериоды.Периодичность = ЗНАЧЕНИЕ(Перечисление.ПериодичностьМСД.Месяц)
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ПриоритетПериодичность,
		|	МЕСЯЦ(ВТ_ВсеПериоды.ДатаОкончания) КАК Месяц,
		|	ВТ_ВсеПериоды.Ссылка КАК Ссылка,
		|	ВТ_ВсеПериоды.Срок КАК Срок,
		|	ВТ_ВсеПериоды.ПервичнаяВыгрузка КАК ПервичнаяВыгрузка
		|ПОМЕСТИТЬ ВТ_ОтчетныеПериоды
		|ИЗ
		|	ВТ_ВсеПериоды КАК ВТ_ВсеПериоды
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МАКСИМУМ(ВТ_ОтчетныеПериоды.ДатаОкончания) КАК ДатаОкончания,
		|	МАКСИМУМ(ВТ_ОтчетныеПериоды.ПриоритетПериодичность) КАК ПриоритетПериодичность,
		|	ВТ_ОтчетныеПериоды.Месяц КАК Месяц
		|ПОМЕСТИТЬ ВТ_ОтчетныеПериодыГруппировка
		|ИЗ
		|	ВТ_ОтчетныеПериоды КАК ВТ_ОтчетныеПериоды
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ОтчетныеПериоды.Месяц
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ОтчетныеПериоды.ПериодДанных КАК ПериодДанных,
		|	ВТ_ОтчетныеПериоды.ДатаНачала КАК ДатаНачала,
		|	ВТ_ОтчетныеПериоды.ДатаОкончания КАК ДатаОкончания,
		|	ВТ_ОтчетныеПериоды.Периодичность КАК Периодичность,
		|	ВТ_ОтчетныеПериоды.ПредставлениеПериода КАК ПредставлениеПериода,
		|	ВТ_ОтчетныеПериоды.Ссылка КАК Ссылка,
		|	ВТ_ОтчетныеПериоды.Срок КАК Срок,
		|	ВТ_ОтчетныеПериоды.ПервичнаяВыгрузка КАК ПервичнаяВыгрузка,
		|	ВТ_ОтчетныеПериоды.Месяц КАК Месяц
		|ПОМЕСТИТЬ ВТ_ОтчетныеПериодыИтог
		|ИЗ
		|	ВТ_ОтчетныеПериоды КАК ВТ_ОтчетныеПериоды
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ОтчетныеПериодыГруппировка КАК ВТ_ОтчетныеПериодыГруппировка
		|		ПО (ВТ_ОтчетныеПериодыГруппировка.Месяц = ВТ_ОтчетныеПериоды.Месяц)
		|			И (ВТ_ОтчетныеПериодыГруппировка.ПриоритетПериодичность = ВТ_ОтчетныеПериоды.ПриоритетПериодичность)
		|			И ВТ_ОтчетныеПериоды.ДатаОкончания = ВТ_ОтчетныеПериодыГруппировка.ДатаОкончания
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	МАКСИМУМ(ПакетыДанныхМСД.ДатаФормирования) КАК ДатаФормирования,
		|	ВТ_ОтчетныеПериодыИтог.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТ_ПоследнийПакет
		|ИЗ
		|	ВТ_ОтчетныеПериодыИтог КАК ВТ_ОтчетныеПериодыИтог
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПакетыДанныхМСД КАК ПакетыДанныхМСД
		|		ПО ВТ_ОтчетныеПериодыИтог.Ссылка = ПакетыДанныхМСД.Пакет
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ОтчетныеПериодыИтог.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВТ_ПоследнийПакет.Ссылка КАК Ссылка,
		|	ВТ_ПоследнийПакет.ДатаФормирования КАК ДатаФормирования,
		|	МАКСИМУМ(ПакетыДанныхМСД.Период) КАК Период
		|ПОМЕСТИТЬ ВТ_ПоследнийПакетСрез
		|ИЗ
		|	ВТ_ПоследнийПакет КАК ВТ_ПоследнийПакет
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПакетыДанныхМСД КАК ПакетыДанныхМСД
		|		ПО ВТ_ПоследнийПакет.Ссылка = ПакетыДанныхМСД.Пакет
		|			И ВТ_ПоследнийПакет.ДатаФормирования = ПакетыДанныхМСД.ДатаФормирования
		|ГДЕ
		|	(ПакетыДанныхМСД.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПакетовМСД.Принят)
		|			ИЛИ ПакетыДанныхМСД.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПакетовМСД.ПринятСПредупреждениями)
		|			ИЛИ ПакетыДанныхМСД.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПакетовМСД.ПринятДанныеОтсутствуют)
		|			ИЛИ ПакетыДанныхМСД.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПакетовМСД.Сформирован))
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ПоследнийПакет.Ссылка,
		|	ВТ_ПоследнийПакет.ДатаФормирования
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВТ_ПоследнийПакетСрез.Ссылка КАК Ссылка,
		|	ПакетыДанныхМСД.Статус КАК Статус
		|ПОМЕСТИТЬ ВТ_СтатусПакета
		|ИЗ
		|	ВТ_ПоследнийПакетСрез КАК ВТ_ПоследнийПакетСрез
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПакетыДанныхМСД КАК ПакетыДанныхМСД
		|		ПО ВТ_ПоследнийПакетСрез.Ссылка = ПакетыДанныхМСД.Пакет
		|			И (ВТ_ПоследнийПакетСрез.ДатаФормирования = ВТ_ПоследнийПакетСрез.ДатаФормирования)
		|			И ВТ_ПоследнийПакетСрез.Период = ПакетыДанныхМСД.Период
		|ГДЕ
		|	(ПакетыДанныхМСД.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПакетовМСД.Принят)
		|			ИЛИ ПакетыДанныхМСД.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПакетовМСД.ПринятСПредупреждениями)
		|			ИЛИ ПакетыДанныхМСД.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПакетовМСД.ПринятДанныеОтсутствуют)
		|			ИЛИ ПакетыДанныхМСД.Период < ДОБАВИТЬКДАТЕ(&ТекущаяДата, ЧАС, -3))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ 
		|	ВТ_ОтчетныеПериодыИтог.Срок КАК Срок,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ_ОтчетныеПериодыИтог.ПериодДанных) КАК КоличествоПериод,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ_СтатусПакета.Ссылка) КАК КоличествоЗагружен,
		|	ВТ_ОтчетныеПериодыИтог.Периодичность КАК Периодичность,
		|	МИНИМУМ(ВТ_ОтчетныеПериодыИтог.Месяц) КАК Месяц
		|ПОМЕСТИТЬ ВТ_КоличествоСтатусов
		|ИЗ
		|	ВТ_ОтчетныеПериодыИтог КАК ВТ_ОтчетныеПериодыИтог
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СтатусПакета КАК ВТ_СтатусПакета
		|		ПО ВТ_ОтчетныеПериодыИтог.Ссылка = ВТ_СтатусПакета.Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ОтчетныеПериодыИтог.Срок,
		|	ВТ_ОтчетныеПериодыИтог.Периодичность
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ОтчетныеПериодыИтог.ПериодДанных КАК ПериодДанных,
		|	ВТ_ОтчетныеПериодыИтог.ДатаНачала КАК ДатаНачала,
		|	ВТ_ОтчетныеПериодыИтог.ДатаОкончания КАК ДатаОкончания,
		|	ВТ_ОтчетныеПериодыИтог.Периодичность КАК Периодичность,
		|	ВТ_ОтчетныеПериодыИтог.ПредставлениеПериода КАК ПредставлениеПериода,
		|	ВТ_КоличествоСтатусов.КоличествоПериод КАК КоличествоПериод,
		|	ВТ_КоличествоСтатусов.КоличествоЗагружен КАК КоличествоЗагружен,
		|	ВТ_ОтчетныеПериодыИтог.Ссылка КАК Ссылка,
		|	ВТ_ОтчетныеПериодыИтог.ПервичнаяВыгрузка КАК ПервичнаяВыгрузка,
		|	ВТ_ОтчетныеПериодыИтог.Месяц = ВТ_КоличествоСтатусов.Месяц КАК ПервыйВГруппе
		|ПОМЕСТИТЬ ВТ_СоединениеКоличество
		|ИЗ
		|	ВТ_ОтчетныеПериодыИтог КАК ВТ_ОтчетныеПериодыИтог
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КоличествоСтатусов КАК ВТ_КоличествоСтатусов
		|		ПО ВТ_ОтчетныеПериодыИтог.Срок = ВТ_КоличествоСтатусов.Срок
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_СоединениеКоличество.ПериодДанных КАК ПериодДанных,
		|	ВТ_СоединениеКоличество.ДатаНачала КАК ДатаНачала,
		|	ВТ_СоединениеКоличество.ДатаОкончания КАК ДатаОкончания,
		|	ВТ_СоединениеКоличество.Периодичность КАК Периодичность,
		|	ВТ_СоединениеКоличество.Периодичность КАК ПериодичностьСсылка,
		|	ВТ_СоединениеКоличество.ПредставлениеПериода КАК ПредставлениеПериода
		|ИЗ
		|	ВТ_СоединениеКоличество КАК ВТ_СоединениеКоличество
		|ГДЕ
		|	(ВТ_СоединениеКоличество.КоличествоПериод - 1 = ВТ_СоединениеКоличество.КоличествоЗагружен
		|			ИЛИ ВЫБОР
		|				КОГДА ВТ_СоединениеКоличество.КоличествоПериод = 1
		|						ИЛИ ВТ_СоединениеКоличество.ПервыйВГруппе
		|					ТОГДА ВТ_СоединениеКоличество.КоличествоЗагружен = 0
		|			КОНЕЦ)
		|	И (ВТ_СоединениеКоличество.Ссылка = ЗНАЧЕНИЕ(Документ.ПакетыДанныхДляМСД.ПустаяСсылка)
		|			ИЛИ ВТ_СоединениеКоличество.ПервичнаяВыгрузка)";
	
КонецФункции 

Функция ПолучитьТекстЗапросаТаксономииПоОтчетномуПериоду() Экспорт
	
	Возврат "ВЫБРАТЬ
	|	ПериодыМСД.ДатаНачала КАК ДатаНачала,
	|	ПериодыМСД.ДатаОкончания КАК ДатаОкончания,
	|	ПериодыМСД.Периодичность КАК Периодичность,
	|	ПериодыМСД.Периодичность КАК ПериодичностьСсылка,
	|	ПериодыМСД.Ссылка КАК ПериодДанных,
	|	ПериодыМСД.Представление КАК ПредставлениеПериода
	|ИЗ
	|	Справочник.ПериодыМСД КАК ПериодыМСД
	|ГДЕ
	|	ПериодыМСД.Ссылка = &Период
	|УПОРЯДОЧИТЬ ПО
	|	ДатаОкончания";
	
КонецФункции

Функция ПолучитьФайлыПакета(Организация, Пакет = Неопределено, ПолучитьРезультатЗапроса = Ложь) Экспорт
	
	УсловияПакета = ЗначениеЗаполнено(Пакет);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	СтрШаблон("ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПакетыДанныхМСД.Пакет КАК Пакет,
	|	МАКСИМУМ(ПакетыДанныхМСД.ДатаФормирования) КАК ДатаФормирования
	|ПОМЕСТИТЬ ВТ_ПакетыФормирование
	|ИЗ
	|	РегистрСведений.ПакетыДанныхМСД КАК ПакетыДанныхМСД,
	|	Константа.ПодписыватьОперативныеДанныеДляМСД КАК ПодписыватьОперативныеДанныеДляМСД,
	|	Константа.ПодписыватьОтчетныеДанныеДляМСД КАК ПодписыватьОтчетныеДанныеДляМСД
	|ГДЕ
	|	ПакетыДанныхМСД.Организация = &Организация
	|   %1
	|
	|СГРУППИРОВАТЬ ПО
	|	ПакетыДанныхМСД.Пакет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПакетыДанныхМСД.Пакет КАК Пакет,
	|	МАКСИМУМ(ПакетыДанныхМСД.ДатаФормирования) КАК ДатаФормирования,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ПакетыДанныхМСД.ВидПередаваемыхДанных
	|				ТОГДА ВЫБОР
	|						КОГДА ПакетыДанныхДляМСД.ОкончаниеПериода >= ДАТАВРЕМЯ(2026, 1, 1)
	|							ТОГДА НЕ ПодписыватьОтчетныеДанныеДляМСД.Значение
	|						ИНАЧЕ ЛОЖЬ
	|					КОНЕЦ
	|			ИНАЧЕ ВЫБОР
	|					КОГДА ПакетыДанныхДляМСД.ОкончаниеПериода >= ДАТАВРЕМЯ(2026, 1, 1)
	|						ТОГДА НЕ ПодписыватьОперативныеДанныеДляМСД.Значение
	|					ИНАЧЕ ИСТИНА
	|				КОНЕЦ
	|		КОНЕЦ) КАК УсловиеПодписания,
	|	МАКСИМУМ(ПакетыДанныхДляМСД.ОкончаниеПериода >= ДАТАВРЕМЯ(2026, 1, 1)) КАК НовыйПорядок, 
	|	МАКСИМУМ(ПодписыватьОтчетныеДанныеДляМСД.Значение) КАК ПодписыватьОтчетныеДанныеДляМСД,
	|	МАКСИМУМ(ПодписыватьОперативныеДанныеДляМСД.Значение) КАК ПодписыватьОперативныеДанныеДляМСД,
	|	МАКСИМУМ(ПакетыДанныхМСД.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПакетовМСД.Подписан1Подписью)) КАК Подписан
	|ПОМЕСТИТЬ ВТ_ПакетыФормированиеИтог
	|ИЗ
	|	РегистрСведений.ПакетыДанныхМСД КАК ПакетыДанныхМСД
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПакетыФормирование КАК ВТ_ПакетыФормирование
	|		ПО ПакетыДанныхМСД.Пакет = ВТ_ПакетыФормирование.Пакет
	|			И (ВТ_ПакетыФормирование.ДатаФормирования = ПакетыДанныхМСД.ДатаФормирования)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПакетыДанныхДляМСД КАК ПакетыДанныхДляМСД
	|		ПО ПакетыДанныхМСД.Пакет = ПакетыДанныхДляМСД.Ссылка,
	|	Константа.ПодписыватьОперативныеДанныеДляМСД КАК ПодписыватьОперативныеДанныеДляМСД,
	|	Константа.ПодписыватьОтчетныеДанныеДляМСД КАК ПодписыватьОтчетныеДанныеДляМСД
	|
	|СГРУППИРОВАТЬ ПО
	|	ПакетыДанныхМСД.Пакет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПакетыДанныхМСДСрезПоследних.Период КАК Период,
	|	ПакетыДанныхМСДСрезПоследних.Пакет КАК Пакет,
	|	ПакетыДанныхМСДСрезПоследних.Организация КАК Организация,
	|	ПакетыДанныхМСДСрезПоследних.ИдентификаторПакета КАК ИдентификаторПакета,
	|	ПакетыДанныхМСДСрезПоследних.ДатаФормирования КАК ДатаФормирования,
	|	ПакетыДанныхМСДСрезПоследних.ИмяПакета КАК ИмяПакета,
	|	ПакетыДанныхМСДСрезПоследних.ВидПередаваемыхДанных КАК ВидПередаваемыхДанных,
	|	ПакетыДанныхМСДСрезПоследних.ПериодСтрокой КАК ПериодСтрокой,
	|	ПакетыДанныхМСДСрезПоследних.КонтрольнаяСумма КАК КонтрольнаяСумма,
	|	ПакетыДанныхМСДСрезПоследних.СпособПередачи КАК СпособПередачи,
	|	ПакетыДанныхМСДСрезПоследних.Статус КАК Статус,
	|	ПакетыДанныхМСДСрезПоследних.ДатаСтатуса КАК ДатаСтатуса,
	|	ПакетыДанныхМСДСрезПоследних.ПолноеИмяФайла КАК ПолноеИмяФайла,
	|	ПакетыДанныхМСДСрезПоследних.ОписаниеОшибки КАК ОписаниеОшибки,
	|	ПакетыДанныхМСДСрезПоследних.ИдентификаторСообщения КАК ИдентификаторСообщения
	|ПОМЕСТИТЬ ВТ_ПакетыСрез
	|ИЗ
	|	РегистрСведений.ПакетыДанныхМСД.СрезПоследних(, %2) КАК ПакетыДанныхМСДСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВТ_ПакетыСрез.Пакет КАК Пакет, 
	|	ВТ_ПакетыСрез.Организация КАК Организация,
	|	ВТ_ПакетыСрез.ИдентификаторПакета КАК ИдентификаторПакета,
	|	ВТ_ПакетыСрез.ДатаФормирования КАК ДатаФормирования,
	|	ВТ_ПакетыСрез.ИмяПакета КАК ИмяПакета,
	|	ВТ_ПакетыСрез.ВидПередаваемыхДанных КАК ВидПередаваемыхДанных,
	|	ВТ_ПакетыСрез.ПериодСтрокой КАК ПериодСтрокой,
	|	ВТ_ПакетыФормирование.Подписан КАК Подписан,
	|	ВТ_ПакетыСрез.КонтрольнаяСумма КАК КонтрольнаяСумма,
	|	ВТ_ПакетыСрез.СпособПередачи КАК СпособПередачи,
	|	ВТ_ПакетыСрез.Статус КАК Статус,
	|	ВТ_ПакетыСрез.ДатаСтатуса КАК ДатаСтатуса,
	|	ВТ_ПакетыСрез.ПолноеИмяФайла КАК ПолноеИмяФайла,
	|	ВТ_ПакетыСрез.ОписаниеОшибки КАК ОписаниеОшибки,
	|	ВТ_ПакетыСрез.ИдентификаторСообщения КАК ИдентификаторСообщения,
	|	ВТ_ПакетыФормирование.УсловиеПодписания КАК УсловиеПодписания,
	|	ВТ_ПакетыФормирование.НовыйПорядок КАК НовыйПорядок,
	|	ВТ_ПакетыФормирование.ПодписыватьОтчетныеДанныеДляМСД КАК ПодписыватьОтчетныеДанныеДляМСД, 
	|	ВТ_ПакетыФормирование.ПодписыватьОперативныеДанныеДляМСД КАК ПодписыватьОперативныеДанныеДляМСД,
	|	ПакетыДанныхДляМСДПрисоединенныеФайлы.ДатаСоздания КАК ДатаСоздания,
	|	ПакетыДанныхДляМСДПрисоединенныеФайлы.Ссылка КАК Ссылка
	|ИЗ
	|	ВТ_ПакетыФормированиеИтог КАК ВТ_ПакетыФормирование
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПакетыСрез КАК ВТ_ПакетыСрез
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПакетыДанныхДляМСДПрисоединенныеФайлы КАК ПакетыДанныхДляМСДПрисоединенныеФайлы
	|			ПО (ВТ_ПакетыСрез.Пакет = ПакетыДанныхДляМСДПрисоединенныеФайлы.ВладелецФайла
	|					И ВТ_ПакетыСрез.ИмяПакета = ПакетыДанныхДляМСДПрисоединенныеФайлы.Наименование
	|					И НЕ ПакетыДанныхДляМСДПрисоединенныеФайлы.ПометкаУдаления)
	|		ПО ВТ_ПакетыФормирование.Пакет = ВТ_ПакетыСрез.Пакет
	|			И ВТ_ПакетыФормирование.ДатаФормирования = ВТ_ПакетыСрез.ДатаФормирования
	|			%3
	|	
	|%4
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаФормирования УБЫВ, 
	|	ДатаСтатуса УБЫВ,
	|	ДатаСоздания УБЫВ", 
	?(УсловияПакета, "И ПакетыДанныхМСД.Пакет = &Пакет", ""), 
	?(УсловияПакета, "Пакет = &Пакет", ""),  
	?(УсловияПакета, "", "И ВТ_ПакетыФормирование.УсловиеПодписания"),
	?(УсловияПакета, "", "ГДЕ
	|	ВТ_ПакетыСрез.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПакетовМСД.Сформирован)")); 
	
	Запрос.УстановитьПараметр("Пакет", Пакет);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат ?(ПолучитьРезультатЗапроса, РезультатЗапроса, РезультатЗапроса.Выбрать());
	
КонецФункции

Функция ИспользуютсяИнтеграцииЭБ() Экспорт
	
	ИспользуютсяИнтеграцииЭБ = Ложь;
	МодульСбораДанныхПереопределяемый.ОпределитьВозможностьИспользованияИнтеграцийЭБ(ИспользуютсяИнтеграцииЭБ);
	ИспользуютсяИнтеграцииЭБ = ИспользуютсяИнтеграцииЭБ И Константы.ОсновнойСпособПередачиДанныхВМСД.Получить() = Перечисления.СпособыПередачиДанныхВМСД.СервисИнтеграции;
	Возврат ИспользуютсяИнтеграцииЭБ; 
	
КонецФункции

Процедура ИнициализацияЕСМВ() Экспорт 
	
	Если ОбщегоНазначения.ПодсистемаСуществует("СервисыИнтеграцииМВУПУиОЭБ") Тогда
		Константы.ОсновнойСпособПередачиДанныхВМСД.Установить(Перечисления.СпособыПередачиДанныхВМСД.СервисИнтеграции);
	Иначе
		Константы.ОсновнойСпособПередачиДанныхВМСД.Установить(Перечисления.СпособыПередачиДанныхВМСД.Файл);
		Константы.ПодписыватьОтчетныеДанныеДляМСД.Установить(Истина);
	КонецЕсли;
	
	Константы.СторонаЗапросовОтправкиПакетовЕСМВСМЭВ.Установить(Перечисления.СтороныВыполненияЗапросовЕСМВСМЭВ.Клиент);
	Константы.СторонаЗапросовСроковТаксономииЕСМВСМЭВ.Установить(Перечисления.СтороныВыполненияЗапросовЕСМВСМЭВ.Клиент);	
	
	ИнициализацияКодИСОрганизацийМСД();	
	ИнициализацияДанныеПодключенияЕСМВСМЭВ();
	ИнициализацияДанныеВидовСведенийЕСМВСМЭВ();
	
КонецПроцедуры  

Процедура ИнициализацияКонстантПодписания() Экспорт 
	
	Константы.ПодписыватьОтчетныеДанныеДляМСД.Установить(Истина);
	Константы.ПодписыватьОперативныеДанныеДляМСД.Установить(Истина);
	Константы.АвтоматическаяОтправкаПакетовДанныхМСД.Установить(Ложь);
		
КонецПроцедуры 
	
Процедура ИнициализацияКодИСОрганизацийМСД() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Организации.Ссылка КАК Ссылка,
	|	КодИСОрганизацийМСД.Организация КАК Организация
	|ПОМЕСТИТЬ ВТ_КодИС
	|ИЗ
	|	Справочник.Организации КАК Организации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Бюджеты КАК Бюджеты
	|		ПО Организации.Бюджет = Бюджеты.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КодИСОрганизацийМСД КАК КодИСОрганизацийМСД
	|		ПО (КодИСОрганизацийМСД.Организация = Организации.Ссылка)
	|ГДЕ
	|	НЕ Организации.ПометкаУдаления
	|	И НЕ Организации.УчетПереданныхПолномочий
	|	И Бюджеты.Код = &Код
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_КодИС.Ссылка КАК Ссылка
	|ИЗ
	|	ВТ_КодИС КАК ВТ_КодИС
	|ГДЕ
	|	ВТ_КодИС.Организация ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("Код", "00000001");
	
	ВыборкаОрганизаций = Запрос.Выполнить().Выбрать();
	Пока ВыборкаОрганизаций.Следующий() Цикл
		ДобавитьЗаписьКодИСОрганизацийМСД(ВыборкаОрганизаций.Ссылка);	
	КонецЦикла;
	
КонецПроцедуры 

Процедура ДобавитьЗаписьКодИСОрганизацийМСД(Организация) Экспорт
	НоваяЗапись = РегистрыСведений.КодИСОрганизацийМСД.СоздатьМенеджерЗаписи();
	НоваяЗапись.Организация = Организация;
	НоваяЗапись.Записать();	
КонецПроцедуры	

Процедура ИнициализацияДанныеПодключенияЕСМВСМЭВ() Экспорт 
	
	НаборЗаписейДанныеПодключенияЕСМВСМЭВ = РегистрыСведений.ДанныеПодключенияЕСМВСМЭВ.СоздатьНаборЗаписей();
	
	ЗаписьДанныеПодключения = НаборЗаписейДанныеПодключенияЕСМВСМЭВ.Добавить();
	ЗаписьДанныеПодключения.СпособПередачи = Перечисления.СпособыПередачиДанныхВМСД.ВнешнийПОИБ;
	ЗаписьДанныеПодключения.АдресСервера = "gateway.roskazna.ru";
	ЗаписьДанныеПодключения.ДействиеПередачи = Перечисления.ДействияПередачиЕСМВСМЭВ.Отправка; 
	ЗаписьДанныеПодключения.SOAPДействие = "sendMessage";
	ЗаписьДанныеПодключения.ТочкаСервиса = "/GuaranteedDeliveryService/SendMessagePOIBService";
	
	ЗаписьДанныеПодключения = НаборЗаписейДанныеПодключенияЕСМВСМЭВ.Добавить();
	ЗаписьДанныеПодключения.СпособПередачи = Перечисления.СпособыПередачиДанныхВМСД.ВнешнийПОИБ;
	ЗаписьДанныеПодключения.АдресСервера = "gateway.roskazna.ru";
	ЗаписьДанныеПодключения.ДействиеПередачи = Перечисления.ДействияПередачиЕСМВСМЭВ.Получение; 
	ЗаписьДанныеПодключения.SOAPДействие = "getMessages";
	ЗаписьДанныеПодключения.ТочкаСервиса = "/PullMessageDeliveryServices/PullPOIBService";
	
	ЗаписьДанныеПодключения = НаборЗаписейДанныеПодключенияЕСМВСМЭВ.Добавить();
	ЗаписьДанныеПодключения.СпособПередачи = Перечисления.СпособыПередачиДанныхВМСД.ВнешнийПОИБ;
	ЗаписьДанныеПодключения.АдресСервера = "gateway.roskazna.ru";
	ЗаписьДанныеПодключения.ДействиеПередачи = Перечисления.ДействияПередачиЕСМВСМЭВ.Подтверждение; 
	ЗаписьДанныеПодключения.SOAPДействие = "ackMessages";
	ЗаписьДанныеПодключения.ТочкаСервиса = "/PullMessageDeliveryServices/PullPOIBService";  

	НаборЗаписейДанныеПодключенияЕСМВСМЭВ.Записать();
	
КонецПроцедуры	
	
Процедура ИнициализацияДанныеВидовСведенийЕСМВСМЭВ() Экспорт 
	
	ТабДок = РегистрыСведений.ДанныеВидовСведенийЕСМВСМЭВ.ПолучитьМакет("ПФ_MXL_НачальноеЗаполнение");	
	ВысотаТабличногоДокумента = ТабДок.ВысотаТаблицы;	
	НаборЗаписейДанныеВидовСведенийЕСМВСМЭВ = РегистрыСведений.ДанныеВидовСведенийЕСМВСМЭВ.СоздатьНаборЗаписей();
	
	Для Строка = 2 По ВысотаТабличногоДокумента Цикл
		ЗаписьНабора = НаборЗаписейДанныеВидовСведенийЕСМВСМЭВ.Добавить();		
		ЗаписьНабора.СпособПередачи = Перечисления.СпособыПередачиДанныхВМСД.ВнешнийПОИБ;
		
		ВидСведений = ПолучитьСодержаниеЯчейки(ТабДок, Строка, 1);
		Если ВидСведений = "Пакет передаваемых данных" Тогда
			ЗаписьНабора.ВидСведений = Перечисления.ВидыСведенийЕСМВСМЭВ.ПакетПередаваемыхДанных;
		ИначеЕсли ВидСведений = "Сроки предоставления" Тогда
			ЗаписьНабора.ВидСведений = Перечисления.ВидыСведенийЕСМВСМЭВ.СрокиПредоставления;
		ИначеЕсли ВидСведений = "Таксономия" Тогда
			ЗаписьНабора.ВидСведений = Перечисления.ВидыСведенийЕСМВСМЭВ.Таксономия;
		ИначеЕсли ВидСведений = "Протокол" Тогда
			ЗаписьНабора.ВидСведений = Перечисления.ВидыСведенийЕСМВСМЭВ.Протокол;
		ИначеЕсли ВидСведений = "Статус пакета" Тогда
			ЗаписьНабора.ВидСведений = Перечисления.ВидыСведенийЕСМВСМЭВ.СтатусПакета;
		КонецЕсли;
		
		ЗаписьНабора.ДействиеПередачи = Перечисления.ДействияПередачиЕСМВСМЭВ[ПолучитьСодержаниеЯчейки(ТабДок, Строка, 2)];
		
		СодержаниеСообщений = ПолучитьСодержаниеЯчейки(ТабДок, Строка, 3);
		Если СодержаниеСообщений = "Данные" Тогда
			ЗаписьНабора.СодержаниеСообщений = Перечисления.СодержанияСообщенийЕСМВСМЭВ.Данные;
		ИначеЕсли СодержаниеСообщений = "Прикладная квитанция" Тогда
			ЗаписьНабора.СодержаниеСообщений = Перечисления.СодержанияСообщенийЕСМВСМЭВ.ПрикладнаяКвитанция;
		ИначеЕсли СодержаниеСообщений = "Транспортная квитанция" Тогда  
			ЗаписьНабора.СодержаниеСообщений = Перечисления.СодержанияСообщенийЕСМВСМЭВ.ТранспортнаяКвитанция;
		КонецЕсли;
		
		ЗаписьНабора.КодВидаСведений = ПолучитьСодержаниеЯчейки(ТабДок, Строка, 4);
		ЗаписьНабора.МнемоникаОтправителя = ПолучитьСодержаниеЯчейки(ТабДок, Строка, 5);
		ЗаписьНабора.МнемоникаПолучателя = ПолучитьСодержаниеЯчейки(ТабДок, Строка, 6);
		ЗаписьНабора.ТипДокумента = ПолучитьСодержаниеЯчейки(ТабДок, Строка, 7);
		
	КонецЦикла;
	
	НаборЗаписейДанныеВидовСведенийЕСМВСМЭВ.Записать();

КонецПроцедуры	

Процедура ИнициализацияОрганизацииМСДПриЗаписи(Источник, Отказ) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		ИсточникСсылка = Источник.Ссылка;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КодИСОрганизацийМСД.Организация КАК Организация
		|ИЗ
		|	РегистрСведений.КодИСОрганизацийМСД КАК КодИСОрганизацийМСД
		|ГДЕ
		|	КодИСОрганизацийМСД.Организация = &Организация";
		
		Запрос.УстановитьПараметр("Организация", ИсточникСсылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда
			ДобавитьЗаписьКодИСОрганизацийМСД(ИсточникСсылка);	
		КонецЕсли;
		
	Исключение
		ЗаписьЖурналаРегистрации("МСД.ИнициализацияОрганизацииМСДПриЗаписи", УровеньЖурналаРегистрации.Ошибка,,, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Функция ПолучитьСтатусПоКоду(КодСтатуса) Экспорт 
	
	КодСтатусаЧисло = Число(КодСтатуса);
	Если КодСтатусаЧисло = 0 Тогда
		Возврат Перечисления.СтатусыПакетовМСД.ВОчереди;
	ИначеЕсли КодСтатусаЧисло = 1 Тогда
		Возврат Перечисления.СтатусыПакетовМСД.Принят; 
	ИначеЕсли КодСтатусаЧисло = 2 Тогда
		Возврат Перечисления.СтатусыПакетовМСД.Загружается;
	ИначеЕсли КодСтатусаЧисло = 3 Тогда
		Возврат Перечисления.СтатусыПакетовМСД.ПринятСПредупреждениями;
	ИначеЕсли КодСтатусаЧисло = 4 Тогда
		Возврат Перечисления.СтатусыПакетовМСД.ПринятДанныеОтсутствуют;
	ИначеЕсли КодСтатусаЧисло = 5 Тогда
		Возврат Перечисления.СтатусыПакетовМСД.ОшибкаЗагрузки; 
	ИначеЕсли КодСтатусаЧисло = 6 Тогда
		Возврат Перечисления.СтатусыПакетовМСД.ОшибкаОбработки;  
	ИначеЕсли КодСтатусаЧисло = 7 Тогда
		Возврат Перечисления.СтатусыПакетовМСД.ПринятСБлокирующимиОшибками; 
	ИначеЕсли КодСтатусаЧисло = 8 Тогда
		Возврат Перечисления.СтатусыПакетовМСД.ОжиданиеРешенияПоЗаявкеНСИ;
	ИначеЕсли КодСтатусаЧисло = 9 Тогда
		Возврат Перечисления.СтатусыПакетовМСД.Отклонен;
	ИначеЕсли КодСтатусаЧисло = 10 Тогда
		Возврат Перечисления.СтатусыПакетовМСД.ТребуетсяПерепредоставить;
	КонецЕсли;
			
КонецФункции	

Функция ПолучитьТекущийСтатусПакета(Пакет) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПакетыДанныхМСДСрезПоследних.Пакет КАК Пакет,
		|	МАКСИМУМ(ПакетыДанныхМСДСрезПоследних.Период) КАК Период
		|ПОМЕСТИТЬ ВТСрез
		|ИЗ
		|	РегистрСведений.ПакетыДанныхМСД.СрезПоследних(, Пакет = &Пакет) КАК ПакетыДанныхМСДСрезПоследних
		|
		|СГРУППИРОВАТЬ ПО
		|	ПакетыДанныхМСДСрезПоследних.Пакет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПакетыДанныхМСД.Статус КАК Статус
		|ИЗ
		|	РегистрСведений.ПакетыДанныхМСД КАК ПакетыДанныхМСД
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТСрез КАК ВТСрез
		|		ПО ПакетыДанныхМСД.Период = ВТСрез.Период
		|			И ПакетыДанныхМСД.Пакет = ВТСрез.Пакет";
	
	Запрос.УстановитьПараметр("Пакет", Пакет);	
	РезультатЗапроса = Запрос.Выполнить();	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Статус;
	Иначе
		Возврат "Не сформирован";
	КонецЕсли;
		
КонецФункции

Процедура ЗакрытиеПериодаСинхронизацияСМСД(ПараметрыЗакрытиеПериода) Экспорт
	
	Если НЕ Константы.СинхронизироватьДатуЗапретаСМСД.Получить() Тогда
		Возврат;
	КонецЕсли;
	
	//Функционал временно недоступен
	Возврат;

	Если ПараметрыЗакрытиеПериода.Статус = Перечисления.СтатусыПакетовМСД.Принят
		ИЛИ ПараметрыЗакрытиеПериода.Статус = Перечисления.СтатусыПакетовМСД.ПринятСПредупреждениями Тогда 
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ПериодыМСД.ЗакрыватьПериод КАК ЗакрыватьПериод
			|ИЗ
			|	Справочник.ПериодыМСД КАК ПериодыМСД
			|ГДЕ
			|	НАЧАЛОПЕРИОДА(ПериодыМСД.ДатаНачала, ДЕНЬ) = &ДатаНачала
			|	И КОНЕЦПЕРИОДА(ПериодыМСД.ДатаОкончания, ДЕНЬ) = &ДатаОкончания
			|	И ПериодыМСД.Периодичность В (&Периодичность)
			|	И НЕ ПериодыМСД.ПометкаУдаления";
		
		Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ПараметрыЗакрытиеПериода.НачалоПериода));
		Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ПараметрыЗакрытиеПериода.ОкончаниеПериода)); 
		МассивПериодичность = Новый Массив;
		Если ПараметрыЗакрытиеПериода.ВидПередаваемыхДанных Тогда 
			МассивПериодичность.Добавить(Перечисления.ПериодичностьМСД.Месяц);
		Иначе
		    МассивПериодичность.Добавить(Перечисления.ПериодичностьМСД.ПроизвольныйПериод);
			МассивПериодичность.Добавить(Перечисления.ПериодичностьМСД.Декада);
		КонецЕсли;
		Запрос.УстановитьПараметр("Периодичность", МассивПериодичность);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			Если ВыборкаДетальныеЗаписи.ЗакрыватьПериод Тогда			
				УстановитьДатуЗапрета(ПараметрыЗакрытиеПериода);
			КонецЕсли;	
		КонецЕсли;
		
	КонецЕсли;
	
		
КонецПроцедуры

Функция ПолучитьПараметрыЗакрытияПериода() Экспорт

	ПараметрыЗакрытиеПериода = Новый Структура();
	ПараметрыЗакрытиеПериода.Вставить("ВидПередаваемыхДанных",   Ложь);
	ПараметрыЗакрытиеПериода.Вставить("НачалоПериода", 		     Дата(1,1,1));
	ПараметрыЗакрытиеПериода.Вставить("ОкончаниеПериода",        Дата(1,1,1));
	ПараметрыЗакрытиеПериода.Вставить("Статус", 			     Перечисления.СтатусыПакетовМСД.ПустаяСсылка());
	ПараметрыЗакрытиеПериода.Вставить("Организация", 			 Справочники.Организации.ПустаяСсылка());
	Возврат ПараметрыЗакрытиеПериода;
		
КонецФункции	
	
Функция ПолучитьСодержаниеЯчейки(ТабличныйДокумент, Строка, Колонка)	
	Если Колонка = 0 Тогда
		Возврат "";
	КонецЕсли;	
	Содержание = ТабличныйДокумент.Область("R" + Формат(Строка,"ЧГ=") + "C" + Формат(Колонка,"ЧГ=")).Текст;	
	Возврат СокрЛП(Содержание);
КонецФункции

Функция ПолучитьПараметрыПакета(Пакет) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПакетыДанныхМСД.Пакет КАК Пакет,
		|	МАКСИМУМ(ПакетыДанныхМСД.ДатаФормирования) КАК ДатаФормирования,
		|	ПакетыДанныхМСД.Статус КАК Статус
		|ПОМЕСТИТЬ ВТСформированСрез
		|ИЗ
		|	РегистрСведений.ПакетыДанныхМСД КАК ПакетыДанныхМСД
		|ГДЕ
		|	ПакетыДанныхМСД.Пакет = &Пакет
		|	И ПакетыДанныхМСД.Статус = &СтатусСформирован
		|
		|СГРУППИРОВАТЬ ПО
		|	ПакетыДанныхМСД.Пакет,
		|	ПакетыДанныхМСД.Статус
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПакетыДанныхМСД.Пакет КАК Пакет,
		|	МАКСИМУМ(ПакетыДанныхМСД.Период) КАК Период,
		|	ПакетыДанныхМСД.Статус КАК Статус,
		|	NULL КАК ДатаФормирования
		|ИЗ
		|	РегистрСведений.ПакетыДанныхМСД КАК ПакетыДанныхМСД
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТСформированСрез КАК ВТСформированСрез
		|		ПО ПакетыДанныхМСД.Пакет = ВТСформированСрез.Пакет
		|			И ПакетыДанныхМСД.Период <= ВТСформированСрез.ДатаФормирования
		|ГДЕ
		|	ПакетыДанныхМСД.Статус = &СтатусФормирование
		|
		|СГРУППИРОВАТЬ ПО
		|	ПакетыДанныхМСД.Пакет,
		|	ПакетыДанныхМСД.Статус
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПакетыДанныхМСД.Пакет,
		|	ПакетыДанныхМСД.Период,
		|	ПакетыДанныхМСД.Статус,
		|	ПакетыДанныхМСД.ДатаФормирования
		|ИЗ
		|	РегистрСведений.ПакетыДанныхМСД КАК ПакетыДанныхМСД
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТСформированСрез КАК ВТСформированСрез
		|		ПО ПакетыДанныхМСД.ДатаФормирования = ВТСформированСрез.ДатаФормирования
		|			И ПакетыДанныхМСД.Пакет = ВТСформированСрез.Пакет
		|			И ПакетыДанныхМСД.Статус = ВТСформированСрез.Статус
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПакетыДанныхМСД.Пакет,
		|	МАКСИМУМ(ПакетыДанныхМСД.Период),
		|	ПакетыДанныхМСД.Статус,
		|	NULL
		|ИЗ
		|	РегистрСведений.ПакетыДанныхМСД КАК ПакетыДанныхМСД
		|ГДЕ
		|	ПакетыДанныхМСД.Пакет = &Пакет
		|	И ПакетыДанныхМСД.Статус = &СтатусПодписан
		|
		|СГРУППИРОВАТЬ ПО
		|	ПакетыДанныхМСД.Пакет,
		|	ПакетыДанныхМСД.Статус";
	
	Запрос.УстановитьПараметр("Пакет", Пакет);
	Запрос.УстановитьПараметр("СтатусСформирован", Перечисления.СтатусыПакетовМСД.Сформирован);
	Запрос.УстановитьПараметр("СтатусФормирование", Перечисления.СтатусыПакетовМСД.Формирование);
	Запрос.УстановитьПараметр("СтатусПодписан", Перечисления.СтатусыПакетовМСД.Подписан1Подписью);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ПараметрыПакета = Новый Структура;
	ПараметрыПакета.Вставить("ДатаВремяНачалаФормированияИССИ", Дата(1,1,1));
	ПараметрыПакета.Вставить("ДатаВремяЗавершенияФормированияИССИ", Дата(1,1,1));
	ПараметрыПакета.Вставить("ДатаВремяПодписанияИССИ", Дата(1,1,1));
	ПараметрыПакета.Вставить("ДатаВремяОтправкиИССИ", УниверсальноеВремя(ТекущаяДатаСеанса()));
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ВыборкаДетальныеЗаписи.Статус = Перечисления.СтатусыПакетовМСД.Формирование Тогда
			ПараметрыПакета.ДатаВремяНачалаФормированияИССИ = ВыборкаДетальныеЗаписи.Период;
		ИначеЕсли ВыборкаДетальныеЗаписи.Статус = Перечисления.СтатусыПакетовМСД.Сформирован Тогда
			ПараметрыПакета.ДатаВремяЗавершенияФормированияИССИ = ВыборкаДетальныеЗаписи.ДатаФормирования;
		ИначеЕсли ВыборкаДетальныеЗаписи.Статус = Перечисления.СтатусыПакетовМСД.Подписан1Подписью Тогда
			ПараметрыПакета.ДатаВремяПодписанияИССИ = ВыборкаДетальныеЗаписи.Период;		
		КонецЕсли;	
	КонецЦикла;
	Возврат ПараметрыПакета;
	
КонецФункции

#Область Таксономия  

// Загружает таксономию из файла, переданного через сервис интеграции.
//
// Параметры:
//  СтруктураПараметров - Структура - содержит свойства:
//  	* Данные  - 	Base64Строка - Двоичные данные файла 
//
Процедура ЗагрузитьТаксономиюСервисИнтеграции(СтруктураПараметров, Организация = Неопределено) Экспорт 
	
	Если Не ПустаяСтрока(СтруктураПараметров.Данные) Тогда
		
		ДД = Base64Значение(СтруктураПараметров.Данные);
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xml");   
		ДД.Записать(ИмяВременногоФайла); 
		
		МодульСбораДанных.ВыполнитьЗагрузкуДанныхТаксономии(ИмяВременногоФайла, Организация);
		
		Попытка
			УдалитьФайлы(ИмяВременногоФайла);
		Исключение
			ЗаписьЖурналаРегистрации(НСтр("ru = 'ЗагрузкаДанныхТаксономии'", ОбщегоНазначения.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Ошибка,,,ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

// Загружает таксономию из файла.
//
// Параметры:
//  СтруктураПараметров - Структура - содержит свойства:
//  	* Данные	 - 	Base64Строка - Двоичные данные файла
//
Процедура ЗагрузитьТаксономию(СтруктураПараметров) Экспорт
	
	РазделительПути = ПолучитьРазделительПути();
	
	Если Не ПустаяСтрока(СтруктураПараметров.Данные) Тогда
		ДД = Base64Значение(СтруктураПараметров.Данные);
		ИмяВременногоФайлаZIP = ПолучитьИмяВременногоФайла("zip");   
		ДД.Записать(ИмяВременногоФайлаZIP);
		
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
		Файл = Новый Файл(ИмяВременногоФайла);
		КаталогСхемы = СтрЗаменить(ИмяВременногоФайла, Файл.Имя, "") + XMLСтрока(Новый УникальныйИдентификатор) + РазделительПути; 
		СоздатьКаталог(КаталогСхемы); 
		
		ИмяФайлаАналитик = "";
		
		ФайлZIP = Новый ЧтениеZipФайла(ИмяВременногоФайлаZIP);  
		Для Каждого Элемент Из ФайлZIP.Элементы Цикл
			
			ФайлZIP.Извлечь(Элемент, КаталогСхемы, РежимВосстановленияПутейФайловZIP.Восстанавливать);
			Если Не СтрНайти(Элемент.ПолноеИмя, "MSD_DataTransferRules_") = 0 Тогда 
				ИмяФайлаАналитик = КаталогСхемы + РазделительПути + Элемент.ПолноеИмя;				
			КонецЕсли;	
		КонецЦикла;    		
		
		ФайлZIP.Закрыть();
		УдалитьФайлы(ИмяВременногоФайлаZIP); 
		
		Если Не ПустаяСтрока(ИмяФайлаАналитик) Тогда
			ВыполнитьЗагрузкуДанныхТаксономии(ИмяФайлаАналитик, ?(СтруктураПараметров.Свойство("Организация"), СтруктураПараметров.Организация, Неопределено));
		КонецЕсли;
		УдалитьФайлы(КаталогСхемы);                                                                  
	КонецЕсли;                                                              
	
КонецПроцедуры	

// Получает сведения об актуальности таксономии.
//
// Параметры:
//  Параметры - Структура - содержит свойства:
//  	* ДатаОкончания	 - 	Дата - Дата окончания периода 
//  	* ДополнительныеДанные	 - 	Строка - Версия таксономии
// 
// Возвращаемое значение:
//  Структура - Структура с параметрами необходимыми для вывода информации пользователю
//
Функция ПолучитьСведенияОСверкеТаксономии(Параметры) Экспорт
	
	Запрос = Новый Запрос; 	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СтатусыВерсийЕФСрезПоследних.Период КАК Период,
	|	СтатусыВерсийЕФСрезПоследних.Версия КАК Версия,
	|	СтатусыВерсийЕФСрезПоследних.ДатаУтверждения КАК ДатаУтверждения
	|ПОМЕСТИТЬ ВТ_СтатусыСрез
	|ИЗ
	|	РегистрСведений.СтатусыВерсийЕФ.СрезПоследних(&ДатаОкончания, ) КАК СтатусыВерсийЕФСрезПоследних
	|ГДЕ
	|	СтатусыВерсийЕФСрезПоследних.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыВерсийЕФ.Утвержден)
	|	И СтатусыВерсийЕФСрезПоследних.Период < &ДатаОкончания
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ВТ_СтатусыСрез.Период) КАК Период
	|ПОМЕСТИТЬ ВТ_СопоставлениеПериод
	|ИЗ
	|	ВТ_СтатусыСрез КАК ВТ_СтатусыСрез
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ВТ_СтатусыСрез.Версия, """") КАК Версия
	|ПОМЕСТИТЬ ВТ_АктуальнаяВерсия
	|ИЗ
	|	ВТ_СопоставлениеПериод КАК ВТ_СопоставлениеПериод
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СтатусыСрез КАК ВТ_СтатусыСрез
	|		ПО ВТ_СопоставлениеПериод.Период = ВТ_СтатусыСрез.Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	МАКСИМУМ(ЗапросыНаСверкуДанныхМСД.Период) КАК Период,
	|	ЗапросыНаСверкуДанныхМСД.ДополнительныеДанные КАК ДополнительныеДанные
	|ПОМЕСТИТЬ ВТ_СтатусВерсииСрез
	|ИЗ
	|	РегистрСведений.ЗапросыНаСверкуДанныхМСД КАК ЗапросыНаСверкуДанныхМСД
	|ГДЕ
	|	ЗапросыНаСверкуДанныхМСД.ТипСообщения = ЗНАЧЕНИЕ(Перечисление.ТипыСообщенийМСД.Таксономия)
	|	И НЕ ЗапросыНаСверкуДанныхМСД.ДополнительныеДанные = """"
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗапросыНаСверкуДанныхМСД.ДополнительныеДанные
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗапросыНаСверкуДанныхМСД.Период КАК Период,
	|	ЗапросыНаСверкуДанныхМСД.Статус КАК Статус,
	|	ЗапросыНаСверкуДанныхМСД.ДополнительныеДанные КАК ДополнительныеДанные
	|ПОМЕСТИТЬ ВТ_СтатусВерсии
	|ИЗ
	|	ВТ_СтатусВерсииСрез КАК ВТ_СтатусВерсииСрез
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗапросыНаСверкуДанныхМСД КАК ЗапросыНаСверкуДанныхМСД
	|		ПО ВТ_СтатусВерсииСрез.Период = ЗапросыНаСверкуДанныхМСД.Период
	|			И ВТ_СтатусВерсииСрез.ДополнительныеДанные = ЗапросыНаСверкуДанныхМСД.ДополнительныеДанные
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	МАКСИМУМ(ЗапросыДанныхМСД.ДатаЗапроса) КАК ДатаЗапроса
	|ПОМЕСТИТЬ ВТ_ЗапросСрез
	|ИЗ
	|	РегистрСведений.ЗапросыДанныхМСД КАК ЗапросыДанныхМСД
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_АктуальнаяВерсия КАК ВТ_АктуальнаяВерсия
	|		ПО (ЗапросыДанныхМСД.ТипСообщения = ЗНАЧЕНИЕ(Перечисление.ТипыСообщенийМСД.Таксономия))
	|			И (ЗапросыДанныхМСД.ДополнительныеДанные = ВТ_АктуальнаяВерсия.Версия
	|				ИЛИ ЗапросыДанныхМСД.ДополнительныеДанные = """")
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ЗапросыДанныхМСД.ДатаЗапроса КАК ДатаЗапроса,
	|	ЗапросыДанныхМСД.Статус КАК СтатусЗапроса,
	|	ВТ_СтатусВерсии.Период КАК Период,
	|	ВТ_СтатусВерсии.Статус КАК Статус,
	|	ВТ_СтатусВерсии.ДополнительныеДанные = &ДополнительныеДанные КАК Актуально
	|ИЗ
	|	ВТ_СтатусВерсии КАК ВТ_СтатусВерсии,
	|	ВТ_ЗапросСрез КАК ВТ_ЗапросСрез
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗапросыДанныхМСД КАК ЗапросыДанныхМСД
	|		ПО (ВТ_ЗапросСрез.ДатаЗапроса = ЗапросыДанныхМСД.ДатаЗапроса)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период УБЫВ";	
	
	Запрос.УстановитьПараметр("ДатаОкончания", НачалоДня(Параметры.ДатаОкончания));
	Запрос.УстановитьПараметр("ДополнительныеДанные", Параметры.ДополнительныеДанные); 
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	РезультатСтруктура = Неопределено;
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
		Если НЕ ВыборкаДетальныеЗаписи.Статус = Перечисления.СтатусыСверкиМСД.ОшибкаСверки Тогда
			
			Загружен = (ВыборкаДетальныеЗаписи.СтатусЗапроса = Перечисления.СтатусыПакетовМСД.Принят);
			
			Если ВыборкаДетальныеЗаписи.Статус = Перечисления.СтатусыСверкиМСД.Совпадает И Загружен Тогда
				Текст = СтрШаблон("Дата актуализации таксономии: %1", МестноеВремя(ВыборкаДетальныеЗаписи.Период));
			Иначе
				Текст = СтрШаблон("Дата актуализации таксономии: %1", МестноеВремя(ВыборкаДетальныеЗаписи.ДатаЗапроса));
				
				Если ВыборкаДетальныеЗаписи.СтатусЗапроса = Перечисления.СтатусыПакетовМСД.Отправлен Тогда
					Таймаут = Константы.ТаймаутПовторнойОтправкиЗапросовВМСД.Получить(); 
					ДатаЗапросаПовторный = ВыборкаДетальныеЗаписи.ДатаЗапроса + Таймаут * 60;
					Если УниверсальноеВремя(ТекущаяДатаСеанса()) < ДатаЗапросаПовторный Тогда
						Текст = СтрШаблон("Дата актуализации таксономии: %1. 
						|Повторная отправка запроса на обновление возможна: %2.", МестноеВремя(ВыборкаДетальныеЗаписи.ДатаЗапроса), МестноеВремя(ДатаЗапросаПовторный));
					КонецЕсли;	
				КонецЕсли;
				
			КонецЕсли;	
			
			РезультатСтруктура = Новый Структура;												
			РезультатСтруктура.Вставить("АктуальностьНадпись", Текст); 
			РезультатСтруктура.Вставить("ЦветНадписи", Новый Цвет());
			РезультатСтруктура.Вставить("Статус", ВыборкаДетальныеЗаписи.Статус); 
			РезультатСтруктура.Вставить("ДатаСверкиТаксономии", МестноеВремя(ВыборкаДетальныеЗаписи.Период));
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат РезультатСтруктура;
	
КонецФункции

// Производит сверку таксономии с базой МСД ПУиО.
//
// Параметры:
//  ИмяСобытия - Строка - Имя события для записи в журнал регистрации
//  ДополнительныеПараметры - Структура - содержит свойства:
//  	* ТекущаяДата	 - 	Дата 
//  	* РезультатНадпись	 - 	Структура - Структура с параметрами необходимыми для вывода информации пользователю
//  ОтправитьСообщение - Булево - Признак того, что необходим запрос данных из базы МСД ПУиО
// 
// Возвращаемое значение:
//  Структура - Структура с параметрами необходимыми для вывода информации пользователю
//
Функция ПодготовитьДанныеДляФормирования(ИмяСобытия, ДополнительныеПараметры, ОтправитьСообщение = Ложь) Экспорт
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация,,, НСтр("ru='Начало подготовки данных для сверки Таксономии'"));
	
	ТипСообщения = Перечисления.ТипыСообщенийМСД.Таксономия;
	ПараметрыЗапроса = Новый Структура("Период, ТипСообщения", ДополнительныеПараметры.ТекущаяДатаСеанса, ТипСообщения);
	
	СтруктураРезультат = Новый Структура();
	СтруктураРезультат.Вставить("ПродолжитьВыполнение", Ложь);
	СтруктураРезультат.Вставить("ТаблицаДляПреобразования", Неопределено);
	СтруктураРезультат.Вставить("ПервичнаяВыгрузкаВыполнена", Неопределено);
	СтруктураРезультат.Вставить("ПервичнаяВыгрузкаСсылка", Неопределено);
	СтруктураРезультат.Вставить("ПервичнаяВыгрузкаДатаОкончания", Неопределено);
	
	Сдвиг = Константы.СдвигАвтоформированияДанныхДляМСД.Получить();
	
	Если НЕ ДополнительныеПараметры.Свойство("РезультатНадпись") Тогда
		РезультатНадпись = Новый Структура;
		РезультатНадпись.Вставить("АктуальностьНадпись", ""); 
		РезультатНадпись.Вставить("ЦветНадписи", Новый Цвет());
		РезультатНадпись.Вставить("Актуально", Ложь);	
		ДополнительныеПараметры.Вставить("РезультатНадпись", РезультатНадпись);
	КонецЕсли;
		
	ДополнительныеПараметры.Вставить("ТипСообщения", ТипСообщения);
	
	ЦветНадписиОшибка = ЦветаСтиля.ЦветОсобогоТекста;
	НадписьОшибка = СтрШаблон(НСтр("ru='Актуальность не проверена, подробности см. в журнале регистрации'"));
	
	Запрос = Новый Запрос;	
	ОтчетныйПериод = ?(ДополнительныеПараметры.Свойство("ОтчетныйПериод"), ДополнительныеПараметры.ОтчетныйПериод, Неопределено);
	Если ЗначениеЗаполнено(ОтчетныйПериод) Тогда
		Запрос.Текст = ПолучитьТекстЗапросаТаксономииПоОтчетномуПериоду();
		Запрос.УстановитьПараметр("Период", ОтчетныйПериод);
	Иначе	
		Запрос.Текст = ПолучитьТекстЗапросаТаксономии();
		Запрос.УстановитьПараметр("Сдвиг", Сдвиг);
		Запрос.УстановитьПараметр("ТекущаяДата", ДополнительныеПараметры.ТекущаяДатаСеанса);
	КонецЕсли;
	Запрос.УстановитьПараметр("Организация", ДополнительныеПараметры.Организация);
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация,,, НСтр("ru='Запрос сроков предоставления - начало'"));
	
	РезультатЗапроса = Запрос.ВыполнитьПакетСПромежуточнымиДанными();
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация,,, НСтр("ru='Запрос сроков предоставления - конец'"));
	
	ТаблицаДляПреобразования = РезультатЗапроса[РезультатЗапроса.Количество()-1].Выгрузить();
	
	Если ТаблицаДляПреобразования.Количество() = 0 Тогда
		ДополнительныеПараметры["РезультатНадпись"].Вставить("АктуальностьНадпись", НадписьОшибка);
		ДополнительныеПараметры["РезультатНадпись"].Вставить("ЦветНадписи", ЦветНадписиОшибка);
		Возврат СтруктураРезультат;	
	КонецЕсли; 
	
	ТаблицаДляПреобразования.Колонки.Добавить("ВерсияДатаНачала", Новый ОписаниеТипов("Дата")); 
	ТаблицаДляПреобразования.Колонки.Добавить("Версия", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(50))); 
	ТаблицаДляПреобразования.Колонки.Добавить("ВерсияДатаУтверждения", Новый ОписаниеТипов("Дата"));

	Для каждого СтрокаТаблицаДляПреобразования Из ТаблицаДляПреобразования Цикл
		ВерсияТаксономии = ОбщегоНазначенияМСД.ТекущаяВерсияТаксономии(СтрокаТаблицаДляПреобразования.ДатаОкончания, ДополнительныеПараметры.Организация);		
		Если НЕ ВерсияТаксономии = Неопределено Тогда
			СтрокаТаблицаДляПреобразования.Версия = ВерсияТаксономии.Версия;
			СтрокаТаблицаДляПреобразования.ВерсияДатаНачала = ВерсияТаксономии.Период;
			СтрокаТаблицаДляПреобразования.ВерсияДатаУтверждения = ВерсияТаксономии.ДатаУтверждения;
		КонецЕсли;
	КонецЦикла;	
	
	СтруктураРезультат.Вставить("ТаблицаДляПреобразования", ТаблицаДляПреобразования);
	
	#Область СверкаТаксономии
	
	ТаблицаРезультат = ТаблицаДляПреобразования.Скопировать(,
									"ВерсияДатаНачала,Версия,ВерсияДатаУтверждения,ДатаНачала,ДатаОкончания,Периодичность,ПредставлениеПериода");
	
	// Не помещается в массив т.к. будет запись в XML, а не в JSON
	ДополнительныеПараметры.Вставить("ТаблицаРезультат", ТаблицаРезультат);
	
	Отказ = Ложь;
	ПродолжитьВыполнение = Истина;
	ИспользуютсяИнтеграцииЭБ = ИспользуютсяИнтеграцииЭБ();
	
	Если ДополнительныеПараметры.СверитьТаксономию Тогда
		// Блокировка отправки запроса при наличии не обработанного запроса при условии: За сегодня уже есть запрос или количество не обработанных запросов >= 3
		ОтменитьСверку = Ложь; 	
		КонтрольОтправкиЗапросовСверки(ДополнительныеПараметры.Организация, Перечисления.ТипыСообщенийМСД.Таксономия, ДополнительныеПараметры.ТекущаяДатаСеанса, ОтменитьСверку);
		
		Если ОтменитьСверку Тогда
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Предупреждение,,, НСтр("ru='Запрос сверки данных Таксономии отменен, превышено количество запросов'"));
			ПродолжитьВыполнение = Ложь;
		Иначе
			
			Если ИспользуютсяИнтеграцииЭБ Тогда
				ПараметрыСверки = Новый Структура;
				ПараметрыСверки.Вставить("ТипСообщения", ТипСообщения);
				ПараметрыСверки.Вставить("ОтправитьСообщение", ОтправитьСообщение);
				ПараметрыСверки.Вставить("ИмяСобытия", ИмяСобытия); 
				ПараметрыСверки.Вставить("ДополнительныеПараметры", ДополнительныеПараметры); 
				ПараметрыСверки.Вставить("ПараметрыЗапроса", ПараметрыЗапроса); 
				ПараметрыСверки.Вставить("Отказ", Отказ); 
				ПараметрыСверки.Вставить("ПродолжитьВыполнение", ПродолжитьВыполнение);
				
				МодульИнтеграцииЭБ = ОбщегоНазначения.ОбщийМодуль("ИнтеграцииЭБ");
				МодульИнтеграцииЭБ.СверитьТаксономию(ПараметрыСверки);
				ДополнительныеПараметры = ПараметрыСверки.ДополнительныеПараметры;
				ПродолжитьВыполнение = ПараметрыСверки.ПродолжитьВыполнение;
			Иначе 
				Если ИнтеграцииЕСМВСМЭВ.ОтправлятьЗапросыНаКлиенте() Тогда 
					ИнтеграцииЕСМВСМЭВ.ЗафиксироватьЗаданиеКлиент(ДополнительныеПараметры.Организация, "Таксономия");					
				Иначе
					ИнтеграцииЕСМВСМЭВ.ОтправитьЗапросНаСверку(ДополнительныеПараметры.Организация, "Таксономия");
				КонецЕсли;
				ПродолжитьВыполнение = Ложь; 
			КонецЕсли;
			
			ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация,,, НСтр("ru='Запрос сверки данных Таксономии отправлен'"));
			
		КонецЕсли;
		
	КонецЕсли;
	
	СтруктураРезультат.Вставить("ПродолжитьВыполнение", ПродолжитьВыполнение);
	
	#КонецОбласти
	
	Возврат СтруктураРезультат;
	
КонецФункции

// Читает файл с таксономией и записывает данные в регистры.
//
// Параметры:
//  ИмяФайлаАналитик - Строка
//
Процедура ВыполнитьЗагрузкуДанныхТаксономии(ИмяФайлаАналитик, Организация = Неопределено) Экспорт
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ИмяФайлаАналитик);
	ОбъектBody = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);        
	
	ОбъектVersionDescription = ОбъектBody.VersionDescription;
	
	Версия = ОбъектVersionDescription.Version; 
	
	Если ЗначениеЗаполнено(Организация) Тогда
		ТекущаяОрганизация = Организация;
	Иначе
		ТекущаяОрганизация = ПараметрыСеанса.ТекущаяОрганизация;
	КонецЕсли;
	
	НаборСтатусыВерсийЕФ = РегистрыСведений.СтатусыВерсийЕФ.СоздатьНаборЗаписей();
	НаборСтатусыВерсийЕФ.Отбор.Организация.Установить(ТекущаяОрганизация);
	НаборСтатусыВерсийЕФ.Отбор.Версия.Установить(Версия);
	
	ЗаписьСтатусыВерсийЕФ = НаборСтатусыВерсийЕФ.Добавить();
	ЗаписьСтатусыВерсийЕФ.Период = XMLЗначение(Тип("Дата"), ОбъектVersionDescription.DateStart);
	ЗаписьСтатусыВерсийЕФ.Версия = Версия;
	ЗаписьСтатусыВерсийЕФ.Организация = ТекущаяОрганизация;
	ЗаписьСтатусыВерсийЕФ.Статус = XMLЗначение(Тип("ПеречислениеСсылка.СтатусыВерсийЕФ"), ОбъектVersionDescription.Status);
	ЗаписьСтатусыВерсийЕФ.ДатаУтверждения 	= XMLЗначение(Тип("Дата"), ОбъектVersionDescription.DateApproval);
	ЗаписьСтатусыВерсийЕФ.ДатаОкончания 	= XMLЗначение(Тип("Дата"), ОбъектVersionDescription.DateEnd);
	
	НаборСтатусыВерсийЕФ.Записать(Истина);
	
	НаборАналитикПоСчетам = РегистрыСведений.НастройкиВыгрузкиАналитикМСД.СоздатьНаборЗаписей();
	НаборАналитикПоСчетам.Отбор.Версия.Установить(Версия);
	НаборАналитикПоСчетам.Отбор.Организация.Установить(ТекущаяОрганизация); 
	МассивСчетов = Новый Массив;
	
	Для Каждого текData Из ОбъектBody.DataAnalytics Цикл   
		
		Если НЕ МассивСчетов.Найти(текData.Account) = Неопределено Тогда
			 ЗаписьЖурналаРегистрации(НСтр("ru = 'СервисИнтеграцииМСД.Основной_ПриемСообщенийОтЕСМВ_ВоВнешнююИБ'", ОбщегоНазначения.КодОсновногоЯзыка()),
			  УровеньЖурналаРегистрации.Предупреждение, , ,
			  СтрШаблон(НСтр("ru = 'Дубль счета %1 - строка настроек счета не записана в НастройкиВыгрузкиАналитикМСД'"), текData.Account));	
		Иначе
			
			МассивСчетов.Добавить(текData.Account);
			
			новСтрока = НаборАналитикПоСчетам.Добавить();
			новСтрока.Версия	= Версия; 
			новСтрока.Организация = ТекущаяОрганизация;
			новСтрока.Счет 		= текData.Account; 
			
			новСтрока.Валютный = XMLЗначение(Тип("Булево"), текData.Currency);
			новСтрока.УчетПоКПС = XMLЗначение(Тип("Булево"), текData.CBC);
			новСтрока.УчетПоКЭК = XMLЗначение(Тип("Булево"), текData.CEQ);
			
			новСтрока.Аналитика1 = ?(ТипЗнч(текData.Analytics_1) = Тип("Строка"), текData.Analytics_1, "");
			новСтрока.Аналитика2 = ?(ТипЗнч(текData.Analytics_2) = Тип("Строка"), текData.Analytics_2, "");
			новСтрока.Аналитика3 = ?(ТипЗнч(текData.Analytics_3) = Тип("Строка"), текData.Analytics_3, "");
			новСтрока.Аналитика4 = ?(ТипЗнч(текData.Analytics_4) = Тип("Строка"), текData.Analytics_4, "");
			новСтрока.Аналитика5 = ?(ТипЗнч(текData.Analytics_5) = Тип("Строка"), текData.Analytics_5, "");
			новСтрока.Аналитика6 = ?(ТипЗнч(текData.Analytics_6) = Тип("Строка"), текData.Analytics_6, "");		
			
			новСтрока.ОбязательноВОстатках1 = текData.EmptyValuesInBalance1;	
			новСтрока.ОбязательноВОстатках2 = текData.EmptyValuesInBalance2;	
			новСтрока.ОбязательноВОстатках3 = текData.EmptyValuesInBalance3;	
			новСтрока.ОбязательноВОстатках4 = текData.EmptyValuesInBalance4;	
			новСтрока.ОбязательноВОстатках5 = текData.EmptyValuesInBalance5;	
			новСтрока.ОбязательноВОстатках6 = текData.EmptyValuesInBalance6;	
			
			новСтрока.ОбязательноВОборотах1 = текData.EmptyValuesInTransactions1;	
			новСтрока.ОбязательноВОборотах2 = текData.EmptyValuesInTransactions2;	
			новСтрока.ОбязательноВОборотах3 = текData.EmptyValuesInTransactions3;	
			новСтрока.ОбязательноВОборотах4 = текData.EmptyValuesInTransactions4;	
			новСтрока.ОбязательноВОборотах5 = текData.EmptyValuesInTransactions5;	
			новСтрока.ОбязательноВОборотах6 = текData.EmptyValuesInTransactions6;	
			
			новСтрока.ВОстатках1 = текData.InBalance1;	
			новСтрока.ВОстатках2 = текData.InBalance2;	
			новСтрока.ВОстатках3 = текData.InBalance3;	
			новСтрока.ВОстатках4 = текData.InBalance4;	
			новСтрока.ВОстатках5 = текData.InBalance5;	
			новСтрока.ВОстатках6 = текData.InBalance6;	
			
			новСтрока.ВОборотах1 = текData.InTransactions1;	
			новСтрока.ВОборотах2 = текData.InTransactions2;	
			новСтрока.ВОборотах3 = текData.InTransactions3;	
			новСтрока.ВОборотах4 = текData.InTransactions4;	
			новСтрока.ВОборотах5 = текData.InTransactions5;	
			новСтрока.ВОборотах6 = текData.InTransactions6;	
		
		КонецЕсли;
		
	КонецЦикла;
	НаборАналитикПоСчетам.Записать(Истина);
	
	
	НаборРеквизитовАналитик = РегистрыСведений.НастройкиРеквизитовАналитикМСД.СоздатьНаборЗаписей();
	НаборРеквизитовАналитик.Отбор.Версия.Установить(Версия); 
	НаборРеквизитовАналитик.Отбор.Организация.Установить(ТекущаяОрганизация);
	
	Для Каждого текData Из ОбъектBody.DataProps Цикл   
		
		новСтрока = НаборРеквизитовАналитик.Добавить();
		
		новСтрока.Версия			= Версия;
		новСтрока.Организация		= ТекущаяОрганизация;
		новСтрока.Аналитика 		= текData.Analytics;
		новСтрока.Реквизит 			= текData.Property;
		новСтрока.Используется		= текData.Used;
		новСтрока.Обязательный		= текData.Required;
		
	КонецЦикла;   
	
	НаборРеквизитовАналитик.Записать(Истина);
	
	НаборКонтрольныеСоотношенияМСД = РегистрыСведений.КонтрольныеСоотношенияТаксономииМСД.СоздатьНаборЗаписей();
	НаборКонтрольныеСоотношенияМСД.Отбор.Организация.Установить(ТекущаяОрганизация);
	НаборКонтрольныеСоотношенияМСД.Отбор.Версия.Установить(Версия);
	
	Если НЕ ОбъектBody.Свойства().Получить("ControlRatio") = Неопределено Тогда
		ControlRatio = ПроверитьСформироватьСписокXDTO(ОбъектBody.ControlRatio);
		КСТаблица = Новый ТаблицаЗначений;
		КСТаблица.Колонки.Добавить("ИдентификаторПоддержки", Новый ОписаниеТипов("УникальныйИдентификатор"));
		КСТаблица.Колонки.Добавить("Код", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(9)));
		КСТаблица.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(150)));
		КСТаблица.Колонки.Добавить("Описание", Новый ОписаниеТипов("Строка"));
		КСТаблица.Колонки.Добавить("ВидКонтрольногоСоотношения", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(150)));
		КСТаблица.Колонки.Добавить("ВидКонтроляФЛК", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(20)));
		КСТаблица.Колонки.Добавить("УсловияКС", Новый ОписаниеТипов("Строка"));
		КСТаблица.Колонки.Добавить("ОперативныеДанные", Новый ОписаниеТипов("Булево"));
		КСТаблица.Колонки.Добавить("ОтчетныеДанные", Новый ОписаниеТипов("Булево")); 
		КСТаблица.Колонки.Добавить("ДополнительноеОперативныеДанные", Новый ОписаниеТипов("Булево"));
		КСТаблица.Колонки.Добавить("ДополнительноеОтчетныеДанные", Новый ОписаниеТипов("Булево"));
		КСТаблица.Колонки.Добавить("Детализация", Новый ОписаниеТипов("Строка"));
		
		КСОперандыТаблица = Новый ТаблицаЗначений;
		КСОперандыТаблица.Колонки.Добавить("ИдентификаторПоддержкиКС", Новый ОписаниеТипов("УникальныйИдентификатор"));
		КСОперандыТаблица.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(150))); 
		КСОперандыТаблица.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(150)));
		КСОперандыТаблица.Колонки.Добавить("Показатель", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(20)));
		КСОперандыТаблица.Колонки.Добавить("УсловияОперанда", Новый ОписаниеТипов("Строка"));    
		КСОперандыТаблица.Колонки.Добавить("ВидОперанда", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(50))); 
		КСОперандыТаблица.Колонки.Добавить("ВидПоказателя", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(10)));
		КСОперандыТаблица.Колонки.Добавить("ПериодОперанда", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(25)));
		КСОперандыТаблица.Колонки.Добавить("ИдентификаторПоддержки", Новый ОписаниеТипов("УникальныйИдентификатор"));
		
		КСАналитикиТаблица = Новый ТаблицаЗначений;
		КСАналитикиТаблица.Колонки.Добавить("ИдентификаторПоддержкиКС", Новый ОписаниеТипов("УникальныйИдентификатор"));
		КСАналитикиТаблица.Колонки.Добавить("Аналитика", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(150))); 
		
		КСКонтролиАналитик = Новый ТаблицаЗначений;
		КСКонтролиАналитик.Колонки.Добавить("ИдентификаторПоддержкиКС", Новый ОписаниеТипов("УникальныйИдентификатор"));
		КСКонтролиАналитик.Колонки.Добавить("Отключено", Новый ОписаниеТипов("Булево"));
		КСКонтролиАналитик.Колонки.Добавить("Аналитика", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(150)));
		КСКонтролиАналитик.Колонки.Добавить("ВидСравнения", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(25)));
		КСКонтролиАналитик.Колонки.Добавить("ЗначениеСравнения", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(1000)));
		
		АналитикиПоУмолчаниюТаблица = СоздатьТаблицуПредставлений();
						
		Для Каждого текData Из ControlRatio Цикл
			НовСтр = КСТаблица.Добавить(); 
			ИдентификаторПоддержки = Новый УникальныйИдентификатор(текData.GUID); 
			НовСтр.ИдентификаторПоддержки = ИдентификаторПоддержки;
			НовСтр.Код = текData.Code;
			НовСтр.Наименование = текData.Name;
			НовСтр.Описание = ?(ТипЗнч(текData.Description) = Тип("Строка"), текData.Description, "");
			НовСтр.ВидКонтрольногоСоотношения = текData.ControlType;
			
			УсловияСтрока = ЗаполнитьУсловияПоОтбору(АналитикиПоУмолчаниюТаблица, текData);
			Если УсловияСтрока = "" Тогда
				УсловияСтрока = "Без условий";
			КонецЕсли;
			НовСтр.УсловияКС = УсловияСтрока;
			
			НовСтр.ОперативныеДанные = XMLЗначение(Тип("Булево"), текData.CheckOperationalData);
			НовСтр.ОтчетныеДанные = XMLЗначение(Тип("Булево"), текData.CheckReportData);
			НовСтр.ДополнительноеОперативныеДанные = XMLЗначение(Тип("Булево"), текData.AdditionalOperationalData); 
			НовСтр.ДополнительноеОтчетныеДанные = XMLЗначение(Тип("Булево"), текData.AdditionalReportData);
			
			Если НовСтр.ВидКонтрольногоСоотношения = "ФЛК" Тогда
				
				Если НЕ текData.FormatControl.Свойства().Получить("FormatControlType") = Неопределено Тогда 
					НовСтр.ВидКонтроляФЛК = текData.FormatControl.FormatControlType; 
				КонецЕсли;	
				
				Если НЕ текData.FormatControl.Свойства().Получить("AnalyticsTypes") = Неопределено Тогда 
					Если НЕ текData.FormatControl.AnalyticsTypes.Свойства().Получить("Analytic") = Неопределено Тогда
						СписокAnalytic = ПроверитьСформироватьСписокXDTO(текData.FormatControl.AnalyticsTypes.Analytic);
						ЗаполнитьАналитики(КСАналитикиТаблица, АналитикиПоУмолчаниюТаблица, СписокAnalytic, ИдентификаторПоддержки);
					КонецЕсли;
				КонецЕсли;
				
				Если НЕ текData.FormatControl.FormatControls.Свойства().Получить("Control") = Неопределено Тогда 
					СписокControl = ПроверитьСформироватьСписокXDTO(текData.FormatControl.FormatControls.Control);
					Для каждого СтрокаControl Из СписокControl Цикл
						Отключено = XMLЗначение(Тип("Булево"), СтрокаControl.Disabled);
						СписокAnalitycsContol = ПроверитьСформироватьСписокXDTO(СтрокаControl.AnalitycsContol);
						Для каждого СтрокаAnalitycsContol Из СписокAnalitycsContol Цикл 
							НовСтрКонтролиАналитик = КСКонтролиАналитик.Добавить();
							НовСтрКонтролиАналитик.ИдентификаторПоддержкиКС = ИдентификаторПоддержки;
							НовСтрКонтролиАналитик.Аналитика = СтрокаAnalitycsContol.Analytic;
							НовСтрКонтролиАналитик.ВидСравнения = СтрокаAnalitycsContol.ComparisonType;
							ЗначениеСравнения = "";
							Если НЕ СтрокаAnalitycsContol.Свойства().Получить("Value") = Неопределено Тогда
								СписокAnalitycsContolValue = ПроверитьСформироватьСписокXDTO(СтрокаAnalitycsContol.Value);
								Для каждого AnalitycsContolValue Из СписокAnalitycsContolValue Цикл
									ЗначениеСравнения = ?(ЗначениеСравнения = "", ЗначениеСравнения, ЗначениеСравнения + ", ") + AnalitycsContolValue; 	
								КонецЦикла	
							КонецЕсли;	
							НовСтрКонтролиАналитик.ЗначениеСравнения = ЗначениеСравнения;
							НовСтрКонтролиАналитик.Отключено = Макс(Отключено, СтрокаAnalitycsContol.ComparisonType = "-");
						КонецЦикла;
					КонецЦикла;
				КонецЕсли;

			Иначе
				
				Если НЕ текData.DataControl.Operands.Свойства().Получить("Operand") = Неопределено Тогда
					СписокOperand = ПроверитьСформироватьСписокXDTO(текData.DataControl.Operands.Operand);
					Для каждого СтрокаOperand Из СписокOperand Цикл
						НовСтрОперанд = КСОперандыТаблица.Добавить();
						НовСтрОперанд.ИдентификаторПоддержкиКС = ИдентификаторПоддержки;
						НовСтрОперанд.Идентификатор = СтрокаOperand.FormulaID;
						НовСтрОперанд.Наименование = СтрокаOperand.Name;
						НовСтрОперанд.Показатель = СтрокаOperand.DataField;

						УсловияСтрока = ЗаполнитьУсловияПоОтбору(АналитикиПоУмолчаниюТаблица, СтрокаOperand);					
						Если УсловияСтрока = "" Тогда
							УсловияСтрока = "Отсутствуют";
						КонецЕсли;
						НовСтрОперанд.УсловияОперанда = УсловияСтрока;

						НовСтрОперанд.ВидОперанда = СтрокаOperand.Type;
						НовСтрОперанд.ВидПоказателя = СтрокаOperand.DataType;
						Если НовСтр.ВидКонтрольногоСоотношения = "Междокументное" Тогда
							НовСтрОперанд.ПериодОперанда = СтрокаOperand.Period;
						КонецЕсли;					 
						НовСтрОперанд.ИдентификаторПоддержки = Новый УникальныйИдентификатор(СтрокаOperand.GUID);
					КонецЦикла;
				КонецЕсли;
				
				Если НЕ текData.DataControl.Свойства().Получить("AnalyticsTypes") = Неопределено Тогда
					Если НЕ текData.DataControl.AnalyticsTypes.Свойства().Получить("Analytic") = Неопределено Тогда
						СписокAnalytic = ПроверитьСформироватьСписокXDTO(текData.DataControl.AnalyticsTypes.Analytic);
						ЗаполнитьАналитики(КСАналитикиТаблица, АналитикиПоУмолчаниюТаблица, СписокAnalytic, ИдентификаторПоддержки);
						Детализация = "";
						СтрокиАналитика = КСАналитикиТаблица.НайтиСтроки(Новый Структура("ИдентификаторПоддержкиКС", ИдентификаторПоддержки));
						Для каждого СтрАналитика Из СтрокиАналитика Цикл
							Детализация = ?(Детализация = "", Детализация, Детализация + ", ") + СтрАналитика.Аналитика;	
						КонецЦикла;	
						НовСтр.Детализация = Детализация;
					КонецЕсли;
				КонецЕсли;

			КонецЕсли;	
		КонецЦикла;	
			
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ТаблицаИД.ИдентификаторПоддержки КАК ИдентификаторПоддержки,
			|	ТаблицаИД.Код КАК Код,
			|	ТаблицаИД.Наименование КАК Наименование,
			|	ТаблицаИД.Описание КАК Описание,
			|	ТаблицаИД.ВидКонтрольногоСоотношения КАК ВидКонтрольногоСоотношения,
			|	ТаблицаИД.ВидКонтроляФЛК КАК ВидКонтроляФЛК,
			|	ТаблицаИД.УсловияКС КАК УсловияКС,
			|	ТаблицаИД.ОперативныеДанные КАК ОперативныеДанные,
			|	ТаблицаИД.ОтчетныеДанные КАК ОтчетныеДанные,
			|	ТаблицаИД.ДополнительноеОперативныеДанные КАК ДополнительноеОперативныеДанные,
			|	ТаблицаИД.ДополнительноеОтчетныеДанные КАК ДополнительноеОтчетныеДанные,
			|	ТаблицаИД.Детализация КАК Детализация
			|ПОМЕСТИТЬ ВТ_ИД
			|ИЗ
			|	&ТаблицаИД КАК ТаблицаИД
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВТ_ИД.ИдентификаторПоддержки КАК ИдентификаторПоддержки,
			|	ВТ_ИД.Код КАК Номер,
			|	ВТ_ИД.Наименование КАК Наименование,
			|	ЕСТЬNULL(КонтрольныеСоотношенияМСД.Ссылка, ЗНАЧЕНИЕ(Справочник.КонтрольныеСоотношенияМСД.ПустаяСсылка)) КАК СсылкаКС,
			|	ВТ_ИД.Описание КАК Описание,
			|	ВТ_ИД.ВидКонтрольногоСоотношения КАК ВидКонтрольногоСоотношения,
			|	ВТ_ИД.ВидКонтроляФЛК КАК ВидКонтроляФЛК,
			|	ВТ_ИД.УсловияКС КАК УсловияКС,
			|	ВТ_ИД.ОперативныеДанные КАК ОперативныеДанные,
			|	ВТ_ИД.ОтчетныеДанные КАК ОтчетныеДанные,
			|	ВТ_ИД.ДополнительноеОперативныеДанные КАК ДополнительноеОперативныеДанные,
			|	ВТ_ИД.ДополнительноеОтчетныеДанные КАК ДополнительноеОтчетныеДанные,
			|	ВТ_ИД.Детализация КАК Детализация
			|ИЗ
			|	ВТ_ИД КАК ВТ_ИД
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КонтрольныеСоотношенияМСД КАК КонтрольныеСоотношенияМСД
			|		ПО (КонтрольныеСоотношенияМСД.ИдентификаторПоддержки = ВТ_ИД.ИдентификаторПоддержки)";
		
		Запрос.УстановитьПараметр("ТаблицаИД", КСТаблица);
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.СсылкаКС) Тогда
				ОбъектКС = ВыборкаДетальныеЗаписи.СсылкаКС.ПолучитьОбъект();	
			Иначе
				ОбъектКС = Справочники.КонтрольныеСоотношенияМСД.СоздатьЭлемент(); 
				ОбъектКС.УстановитьНовыйКод(); 
			КонецЕсли;	
			
			ЗаполнитьЗначенияСвойств(ОбъектКС, ВыборкаДетальныеЗаписи);
			
			Если ОбъектКС.ВидКонтрольногоСоотношения = "ФЛК" Тогда
				ОбъектКС.Аналитики.Очистить();
				АналитикиТек = КСАналитикиТаблица.НайтиСтроки(Новый Структура("ИдентификаторПоддержкиКС", ОбъектКС.ИдентификаторПоддержки));
				Для каждого СтрокаАналитикиТек Из АналитикиТек Цикл
					НовСтрАналитика = ОбъектКС.Аналитики.Добавить();
					ЗаполнитьЗначенияСвойств(НовСтрАналитика, СтрокаАналитикиТек);	
				КонецЦикла;	
				
				ОбъектКС.КонтролиАналитик.Очистить();
				КонтролиАналитикТек = КСКонтролиАналитик.НайтиСтроки(Новый Структура("ИдентификаторПоддержкиКС", ОбъектКС.ИдентификаторПоддержки));
				Для каждого СтрокаКонтролиАналитикТек Из КонтролиАналитикТек Цикл
					НовСтрКонтролиАналитик = ОбъектКС.КонтролиАналитик.Добавить();
					ЗаполнитьЗначенияСвойств(НовСтрКонтролиАналитик, СтрокаКонтролиАналитикТек);	
				КонецЦикла;
			Иначе
				
				ОбъектКС.Операнды.Очистить();
				КСОперандыТаблицаТек = КСОперандыТаблица.НайтиСтроки(Новый Структура("ИдентификаторПоддержкиКС", ОбъектКС.ИдентификаторПоддержки));
				Для каждого СтрокаКСОперандыТаблицаТек Из КСОперандыТаблицаТек Цикл
					НовСтрКСОперанды = ОбъектКС.Операнды.Добавить();
					ЗаполнитьЗначенияСвойств(НовСтрКСОперанды, СтрокаКСОперандыТаблицаТек);	
				КонецЦикла;

			КонецЕсли;
			
			ОбъектКС.ОбменДанными.Загрузка = Истина;
			ОбъектКС.Записать();
			
			новСтрока = НаборКонтрольныеСоотношенияМСД.Добавить();
			новСтрока.Версия = Версия;
			новСтрока.Организация = ТекущаяОрганизация;
			новСтрока.КонтрольноеСоотношение = ОбъектКС.Ссылка;
			
		КонецЦикла;  		
	КонецЕсли;

	НаборКонтрольныеСоотношенияМСД.Записать(Истина); 
	
	НаборАналитикиМСД = РегистрыСведений.АналитикиМСД.СоздатьНаборЗаписей();
	НаборРеквизитыАналитикМСД = РегистрыСведений.РеквизитыАналитикМСД.СоздатьНаборЗаписей(); 
	
	Если НЕ ОбъектBody.Свойства().Получить("AnalyticsList") = Неопределено Тогда
		AnalyticsList = ПроверитьСформироватьСписокXDTO(ОбъектBody.AnalyticsList); 		
		Для Каждого ТекAnalyticsList Из AnalyticsList Цикл
			
			НовСтрокаАналитика = НаборАналитикиМСД.Добавить();
			НовСтрокаАналитика.ИмяАналитики	= ТекAnalyticsList.Name; 
			НовСтрокаАналитика.Представление = ТекAnalyticsList.Representation;
			
			Если НЕ ТекAnalyticsList.Свойства().Получить("Props") = Неопределено Тогда
				Props = ПроверитьСформироватьСписокXDTO(ТекAnalyticsList.Props); 		
				Для Каждого текProps Из Props Цикл
					НовСтрокаРеквизит = НаборРеквизитыАналитикМСД.Добавить();
					НовСтрокаРеквизит.ИмяАналитики	= ТекAnalyticsList.Name; 
					НовСтрокаРеквизит.ИмяРеквизита	= текProps.Name; 
					Если НЕ текProps.Свойства().Получить("Representation") = Неопределено Тогда 
						НовСтрокаРеквизит.Представление = текProps.Representation;
					КонецЕсли;
				КонецЦикла;	
			КонецЕсли;
		КонецЦикла;		
	КонецЕсли;
	
	НаборАналитикиМСД.Записать(Истина);
	НаборРеквизитыАналитикМСД.Записать(Истина);
	
КонецПроцедуры

Функция ПолучитьВыборкуОрганизаций() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Организации.Ссылка КАК Ссылка,
	|	Организации.Представление КАК Представление
	|ИЗ
	|	Справочник.Организации КАК Организации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Бюджеты КАК Бюджеты
	|		ПО Организации.Бюджет = Бюджеты.Ссылка
	|ГДЕ
	|	НЕ Организации.ПометкаУдаления
	|	И НЕ Организации.УчетПереданныхПолномочий
	|	И Бюджеты.Код = &Код";
	
	Запрос.УстановитьПараметр("Код", "00000001");
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Выбрать();
	
КонецФункции

Функция ЗаполнитьУсловияПоОтбору(ТаблицаПредставлений, ОтборXDTO)
	
	МодульСтроковыеФункцииКлиентСервер = ОбщегоНазначения.ОбщийМодуль("СтроковыеФункцииКлиентСервер");
	УсловияСтрока = "";
	Если НЕ ОтборXDTO.Свойства().Получить("Filter") = Неопределено Тогда 
		СписокItem = ПроверитьСформироватьСписокXDTO(ОтборXDTO.Filter.Item);
		Для каждого СтрокаItem Из СписокItem Цикл
			Аналитика = НайтиПредставлениеАналитики(ТаблицаПредставлений, СтрокаItem.Path);
	    	УсловияСтрока = ?(УсловияСтрока = "", УсловияСтрока, УсловияСтрока + " И ") +
							Аналитика + " " + ВидСравненияКомпоновкиДанных[СтрокаItem.ComparisonType];
			Если НЕ СтрокаItem.Свойства().Получить("Value") = Неопределено Тогда 
				ПравоеЗначениеСтрока = "";
				СписокПравоеЗначение = ПроверитьСформироватьСписокXDTO(СтрокаItem.Value);
				ПравоеЗначениеКоличество = 0;
				Для каждого ПравоеЗначение Из СписокПравоеЗначение Цикл
					Если Аналитика = "Дата" И МодульСтроковыеФункцииКлиентСервер.ТолькоЛатиницаВСтроке(ПравоеЗначение) Тогда
						ПравоеЗначение = СериализаторXDTO.XMLЗначение(Тип("ВариантСтандартнойДатыНачала"), ПравоеЗначение);
					КонецЕсли;	
					ПравоеЗначениеСтрока = ?(ПравоеЗначениеСтрока = "", ПравоеЗначениеСтрока, ПравоеЗначениеСтрока + ", ") + ПравоеЗначение;	
					ПравоеЗначениеКоличество = ПравоеЗначениеКоличество + 1;
				КонецЦикла;
			    УсловияСтрока  = УсловияСтрока + ?(ПравоеЗначениеКоличество > 1, " (", " ") + ПравоеЗначениеСтрока + ?(ПравоеЗначениеКоличество > 1, ")", ""); 
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат УсловияСтрока;
	
КонецФункции	

Функция ЗаполнитьАналитики(КСАналитикиТаблица, ТаблицаПредставлений, СписокAnalytic, ИдентификаторПоддержки)
	
	Для каждого СтрокаAnalytic Из СписокAnalytic Цикл
		НовСтрАналитика = КСАналитикиТаблица.Добавить();
		НовСтрАналитика.ИдентификаторПоддержкиКС = ИдентификаторПоддержки;
		НовСтрАналитика.Аналитика = НайтиПредставлениеАналитики(ТаблицаПредставлений, СтрокаAnalytic);
	КонецЦикла;	
	
КонецФункции

Функция СоздатьТаблицуПредставлений()
	
	ТаблицаПредставлений = Новый ТаблицаЗначений;
	ТаблицаПредставлений.Колонки.Добавить("Аналитика", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(500)));
	ТаблицаПредставлений.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(500)));
	
	ТабДок = Справочники.КонтрольныеСоотношенияМСД.ПолучитьМакет("АналитикиПоУмолчанию");	
	ВысотаТабличногоДокумента = ТабДок.ВысотаТаблицы;
	
	Для Строка = 2 По ВысотаТабличногоДокумента Цикл
		НоваяСтр = ТаблицаПредставлений.Добавить();
		НоваяСтр.Аналитика = ПолучитьСодержаниеЯчейки(ТабДок, Строка, 1);
		НоваяСтр.Представление = ПолучитьСодержаниеЯчейки(ТабДок, Строка, 2);
	КонецЦикла;
	
	Возврат ТаблицаПредставлений;
	
КонецФункции

Функция НайтиПредставлениеАналитики(ТаблицаПредставлений, Значение)
	
	МассивЗначений = СтрРазделить(Значение, ".");
	МассивПредставлений = Новый Массив;	
	Для каждого СтрЗначение Из МассивЗначений Цикл
		НайденныеСтроки = ТаблицаПредставлений.НайтиСтроки(Новый Структура("Аналитика", СокрЛП(СтрЗначение)));
		Если НайденныеСтроки.Количество() Тогда
			МассивПредставлений.Добавить(НайденныеСтроки[0].Представление);
		Иначе
			МассивПредставлений.Добавить(СокрЛП(СтрЗначение));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(МассивПредставлений, ".");
	
КонецФункции	
	
#КонецОбласти 

#Область СрокиПредоставления

// Загружает сроки предоставления данных из файла.
//
// Параметры:
//  СтруктураПараметров - Структура - содержит свойства:
//  	* Данные	 - 	Base64Строка - Двоичные данные файла 
//
Процедура ЗагрузитьСрокиПредоставленияДанных(СтруктураПараметров) Экспорт
	
	ДД = Base64Значение(СтруктураПараметров.Данные);
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xml");   
	ДД.Записать(ИмяВременногоФайла);
	
	ВыполнитьЗагрузкуСроковПредоставленияДанных(ИмяВременногоФайла, ?(СтруктураПараметров.Свойство("Организация"), СтруктураПараметров.Организация, Неопределено));
	
	УдалитьФайлы(ИмяВременногоФайла);                                                                  
	
КонецПроцедуры

// Получает сведения об актуальности сроков предоставления данных.
//
// Параметры:
//  Параметры - Структура - содержит свойства:
//  	* ДополнительныеДанные	 - 	Строка - Год сверки сроков
// 
// Возвращаемое значение:
//  Структура - Структура с параметрами необходимыми для вывода информации пользователю
//
Функция ПолучитьСведенияОСверкеСроков(Параметры) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗапросыНаСверкуДанныхМСДСрезПоследних.Период КАК Период,
	|	ЗапросыНаСверкуДанныхМСДСрезПоследних.Статус КАК Статус,
	|	ЗапросыНаСверкуДанныхМСДСрезПоследних.ДополнительныеДанные КАК ДополнительныеДанные
	|ПОМЕСТИТЬ ВТ_СверкаСрез
	|ИЗ
	|	РегистрСведений.ЗапросыНаСверкуДанныхМСД.СрезПоследних(
	|			,
	|			ТипСообщения = ЗНАЧЕНИЕ(Перечисление.ТипыСообщенийМСД.СрокиПредоставления)
	|				И ДополнительныеДанные = &ДополнительныеДанные) КАК ЗапросыНаСверкуДанныхМСДСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	МАКСИМУМ(ЗапросыДанныхМСД.ДатаЗапроса) КАК ДатаЗапроса,
	|	ЗапросыДанныхМСД.ДополнительныеДанные КАК ДополнительныеДанные
	|ПОМЕСТИТЬ ВТ_ЗапросСрез
	|ИЗ
	|	РегистрСведений.ЗапросыДанныхМСД КАК ЗапросыДанныхМСД
	|ГДЕ
	|	ЗапросыДанныхМСД.ТипСообщения = ЗНАЧЕНИЕ(Перечисление.ТипыСообщенийМСД.СрокиПредоставления)
	|	И ЗапросыДанныхМСД.ДополнительныеДанные = &ДополнительныеДанные
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗапросыДанныхМСД.ДополнительныеДанные
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_СверкаСрез.Период КАК Период,
	|	ВТ_СверкаСрез.Статус КАК Статус,
	|	ЕСТЬNULL(ЗапросыДанныхМСД.ДатаЗапроса, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаЗапроса,
	|	ЕСТЬNULL(ЗапросыДанныхМСД.Статус, """") КАК СтатусЗапроса
	|ИЗ
	|	ВТ_СверкаСрез КАК ВТ_СверкаСрез
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ЗапросСрез КАК ВТ_ЗапросСрез
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗапросыДанныхМСД КАК ЗапросыДанныхМСД
	|			ПО ВТ_ЗапросСрез.ДатаЗапроса = ЗапросыДанныхМСД.ДатаЗапроса
	|				И ВТ_ЗапросСрез.ДополнительныеДанные = ЗапросыДанныхМСД.ДополнительныеДанные
	|		ПО ВТ_СверкаСрез.ДополнительныеДанные = ВТ_ЗапросСрез.ДополнительныеДанные";
	
	Запрос.УстановитьПараметр("ДополнительныеДанные", Строка(Параметры.ДополнительныеДанные));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
		Если НЕ ВыборкаДетальныеЗаписи.Статус = Перечисления.СтатусыСверкиМСД.ОшибкаСверки Тогда
			
			Текст = СтрШаблон("Дата актуализации сроков: %1", МестноеВремя(ВыборкаДетальныеЗаписи.Период));			
			
			Если ВыборкаДетальныеЗаписи.СтатусЗапроса = Перечисления.СтатусыПакетовМСД.Отправлен Тогда
				Таймаут = Константы.ТаймаутПовторнойОтправкиЗапросовВМСД.Получить(); 
				ДатаЗапросаПовторный = ВыборкаДетальныеЗаписи.ДатаЗапроса + Таймаут * 60;
				Если УниверсальноеВремя(ТекущаяДатаСеанса()) < ДатаЗапросаПовторный Тогда
					Текст = СтрШаблон("Дата актуализации сроков: %1 
					|Повторная отправка запроса на обновление возможна: %2", МестноеВремя(ВыборкаДетальныеЗаписи.Период), МестноеВремя(ДатаЗапросаПовторный));
				КонецЕсли;	
			КонецЕсли;	
			
			РезультатСтруктура = Новый Структура;												
			РезультатСтруктура.Вставить("АктуальностьНадпись", Текст); 
			РезультатСтруктура.Вставить("ЦветНадписи", Новый Цвет());
			РезультатСтруктура.Вставить("Статус", ВыборкаДетальныеЗаписи.Статус);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат РезультатСтруктура;
	
КонецФункции	

// Рассчитывает хеш-сумму сроков предоставления данных для сверки.
//
// Параметры:
//  ТекущаяДата	 - 	Дата
// 
// Возвращаемое значение:
//  Base64Строка - Рассчитанная хеш-сумма обернута в Base64
//
Функция ПолучитьХешСрокиПредоставления(ТекущаяДата, Организация = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", ?(ЗначениеЗаполнено(Организация), Организация, ПараметрыСеанса.ТекущаяОрганизация));
	Запрос.УстановитьПараметр("НачалоГода", НачалоГода(ТекущаяДата));
	Запрос.УстановитьПараметр("КонецГода", НачалоДня(КонецГода(ТекущаяДата))); 
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПериодыМСД.Наименование КАК Наименование,
	|	ПериодыМСД.ДатаНачала КАК ДатаНачала,
	|	ПериодыМСД.ДатаОкончания КАК ДатаОкончания,
	|	ЕСТЬNULL(ПериодыМСД.Родитель.Наименование, """") КАК РодительНаименование
	|ИЗ
	|	Справочник.ПериодыМСД КАК ПериодыМСД
	|ГДЕ
	|	ПериодыМСД.ДатаНачала >= &НачалоГода
	|	И ПериодыМСД.ДатаОкончания <= &КонецГода
	|	И НЕ ПериодыМСД.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаНачала,
	|	ДатаОкончания
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПериодыМСД.Наименование КАК Наименование,
	|	ПериодыМСД.ДатаНачала КАК ДатаНачала,
	|	ПериодыМСД.ДатаОкончания КАК ДатаОкончания,
	|	СведенияОСрокахПредоставленияДанныхМСД.Срок КАК Срок
	|ИЗ
	|	РегистрСведений.СведенияОСрокахПредоставленияДанныхМСД КАК СведенияОСрокахПредоставленияДанныхМСД
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПериодыМСД КАК ПериодыМСД
	|		ПО СведенияОСрокахПредоставленияДанныхМСД.ПериодДанных = ПериодыМСД.Ссылка
	|ГДЕ
	|	СведенияОСрокахПредоставленияДанныхМСД.Организация = &Организация
	|	И ПериодыМСД.ДатаНачала >= &НачалоГода
	|	И ПериодыМСД.ДатаОкончания <= &КонецГода
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаНачала,
	|	ДатаОкончания";
	
	Пакет = Запрос.ВыполнитьПакет();
	
	ДанныеПериодов = Пакет[0].Выбрать();   
	ДанныеСроков = Пакет[1].Выбрать();  
	
	Хеш = Новый ХешированиеДанных(ХешФункция.SHA1);	
	СтрокиХеш = Новый Массив;
		
	Пока ДанныеПериодов.Следующий() Цикл
		СтрокиХеш.Добавить(ДанныеПериодов.Наименование + Формат(ДанныеПериодов.ДатаНачала, "ДФ=гггг-ММ-дд") 
		+ Формат(ДанныеПериодов.ДатаОкончания, "ДФ=гггг-ММ-дд") + ДанныеПериодов.РодительНаименование); 	
	КонецЦикла;
	
	Пока ДанныеСроков.Следующий() Цикл
		СтрокиХеш.Добавить(ДанныеСроков.Наименование + Формат(ДанныеСроков.ДатаНачала, "ДФ=гггг-ММ-дд") 
		+ Формат(ДанныеСроков.ДатаОкончания, "ДФ=гггг-ММ-дд") + Формат(ДанныеСроков.Срок, "ДФ=гггг-ММ-дд"));
	КонецЦикла;
	
	СтрокаКРасчетуХеш = СтрСоединить(СтрокиХеш);
	Хеш.Добавить(СтрокаКРасчетуХеш);
	
	Возврат Base64Строка(Хеш.ХешСумма);
	
КонецФункции

#КонецОбласти 

#Область ПротоколЗагрузки

// Загружает протокол из файла.
//
// Параметры:
//  СтруктураПараметров - Структура - содержит свойства:
//  	* Данные	 - 	Base64Строка - Двоичные данные файла 
//
Процедура ЗагрузитьПротокол(СтруктураПараметров) Экспорт
	
	ИмяСобытия = НСтр("ru='ЗагрузкаПротоколаИзМСД'", ОбщегоНазначения.КодОсновногоЯзыка());
	
	Если Не ПустаяСтрока(СтруктураПараметров.Данные) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ПакетыДанныхДляМСДПрисоединенныеФайлы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ПакетыДанныхДляМСДПрисоединенныеФайлы КАК ПакетыДанныхДляМСДПрисоединенныеФайлы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПакетыДанныхМСД КАК ПакетыДанныхМСД
		|		ПО ПакетыДанныхДляМСДПрисоединенныеФайлы.ВладелецФайла = ПакетыДанныхМСД.Пакет
		|ГДЕ
		|	ПакетыДанныхМСД.ИдентификаторПакета = &ИдентификаторПакета
		|	И ПакетыДанныхДляМСДПрисоединенныеФайлы.Наименование = ""Протокол_"" + ПакетыДанныхМСД.ИмяПакета
		|	И НЕ ПакетыДанныхДляМСДПрисоединенныеФайлы.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПакетыДанныхМСД.Пакет КАК Пакет,
		|	ПакетыДанныхМСД.Организация КАК Организация,
		|	ПакетыДанныхМСД.ИмяПакета КАК ИмяПакета,
		|	ПакетыДанныхМСД.ИдентификаторПакета КАК ИдентификаторПакета,
		|	ПакетыДанныхМСД.ДатаФормирования КАК ДатаФормирования,
		|	ПакетыДанныхМСД.ВидПередаваемыхДанных КАК ВидПередаваемыхДанных,
		|	ПакетыДанныхМСД.ПериодСтрокой КАК ПериодСтрокой,
		|	ПакетыДанныхМСД.КонтрольнаяСумма КАК КонтрольнаяСумма,
		|	ПакетыДанныхМСД.СпособПередачи КАК СпособПередачи,
		|	ПакетыДанныхМСД.ПолноеИмяФайла КАК ПолноеИмяФайла,
		|	ПакетыДанныхДляМСД.НачалоПериода КАК НачалоПериода,
	    |	ПакетыДанныхДляМСД.ОкончаниеПериода КАК ОкончаниеПериода,
		|	ПакетыДанныхМСД.ИдентификаторСообщения КАК ИдентификаторСообщения
		|ИЗ
		|	РегистрСведений.ПакетыДанныхМСД КАК ПакетыДанныхМСД
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПакетыДанныхДляМСД КАК ПакетыДанныхДляМСД
	    |		ПО ПакетыДанныхМСД.Пакет = ПакетыДанныхДляМСД.Ссылка
		|ГДЕ
		|	ПакетыДанныхМСД.ИдентификаторПакета = &ИдентификаторПакета
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПакетыДанныхМСД.Период УБЫВ";
		
		Запрос.УстановитьПараметр("ИдентификаторПакета", СтруктураПараметров.ИдентификаторПакета);
		
		РезультатЗапроса = Запрос.ВыполнитьПакет();
		
		ВыборкаУдалить = РезультатЗапроса[0].Выбрать();
		
		МодульРаботаСФайлами = ОбщегоНазначения.ОбщийМодуль("РаботаСФайлами");
		
		Пока ВыборкаУдалить.Следующий() Цикл
			ОбъектФайл = ВыборкаУдалить.Ссылка.ПолучитьОбъект();
			Попытка
				ОбъектФайл.Заблокировать();
			Исключение
				ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,, 
				ОбъектФайл, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				Продолжить;
			КонецПопытки;
			МодульРаботаСФайлами.ВыполнитьДействияПередУдалениемПрисоединенногоФайла(ОбъектФайл, Ложь);
			ОбъектФайл.ПометкаУдаления = Истина;
			ОбъектФайл.Записать();
		КонецЦикла;
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса[1].Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			МодульПользователи = ОбщегоНазначения.ОбщийМодуль("Пользователи");
			
			ДД = Base64Значение(СтруктураПараметров.Данные);
			
			ПараметрыФайла = МодульРаботаСФайлами.ПараметрыДобавленияФайла();
			ПараметрыФайла.Автор = МодульПользователи.АвторизованныйПользователь();
			ПараметрыФайла.ВладелецФайлов = ВыборкаДетальныеЗаписи.Пакет;
			ПараметрыФайла.ИмяБезРасширения = "Протокол_" + ВыборкаДетальныеЗаписи.ИмяПакета;
			
			АдресРезультата = ПоместитьВоВременноеХранилище(ДД);
			ПараметрыФайла.РасширениеБезТочки = "xml";
			
			МодульРаботаСФайлами.ДобавитьФайл(ПараметрыФайла, АдресРезультата);
			УдалитьИзВременногоХранилища(АдресРезультата); 
			
			ИмяФайла = ПолучитьИмяВременногоФайла("xml");
			Если ДД <> Неопределено Тогда
				ДД.Записать(ИмяФайла);
			КонецЕсли;    
			
			Попытка 
				Чтение = Новый ЧтениеXML;
				Чтение.ОткрытьФайл(ИмяФайла); 
				ОбъектBody = ФабрикаXDTO.ПрочитатьXML(Чтение, ФабрикаXDTO.Тип("MSD_DATA_FHD/VerificationProtocol_1_0_1", "Body"));
			Исключение
				Чтение.Закрыть();
				Попытка  			
					Чтение = Новый ЧтениеXML;
					Чтение.ОткрытьФайл(ИмяФайла);
					ОбъектBody = ФабрикаXDTO.ПрочитатьXML(Чтение, ФабрикаXDTO.Тип("MSD_DATA_FHD/VerificationProtocol", "Body"));	
				Исключение
					Чтение.Закрыть();
					УдалитьФайлы(ИмяФайла);
					ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,,,ОписаниеОшибки());
					Возврат; 	
				КонецПопытки;
			КонецПопытки; 
			
			Чтение.Закрыть();
			УдалитьФайлы(ИмяФайла);
			
			Если НЕ ОбъектBody.Header = Неопределено И НЕ ОбъектBody.Header.Status = Неопределено Тогда
				СтатусЧисло = ОбъектBody.Header.Status;	
				Статус = ПолучитьСтатусПоКоду(СтатусЧисло);
				ЗаписатьСтатусПротокола(ВыборкаДетальныеЗаписи, Статус);
				
				ПараметрыЗакрытиеПериода = ПолучитьПараметрыЗакрытияПериода();
				ЗаполнитьЗначенияСвойств(ПараметрыЗакрытиеПериода, ВыборкаДетальныеЗаписи);
				ПараметрыЗакрытиеПериода.Статус = Статус;
				
				ЗакрытиеПериодаСинхронизацияСМСД(ПараметрыЗакрытиеПериода);
			КонецЕсли;
			
		Иначе
			
			ВызватьИсключение(СтрШаблон(НСтр("ru='Загрузка протокола не выполнена, т.к. не найден отправленный пакет с идентификатором: %1'"), СтруктураПараметров.ИдентификаторПакета));
			
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

// Проверяет и формирует список XDTO
//
// Параметры:
//  СписокXDTO - СписокXDTO 
// 
// Возвращаемое значение:
//  СписокXDTO, Массив
//
Функция ПроверитьСформироватьСписокXDTO(СписокXDTO) Экспорт
	
	Результат = Новый Массив;
	Если ТипЗнч(СписокXDTO) = Тип("СписокXDTO") Тогда
		Результат = СписокXDTO;
	Иначе
		Результат.Добавить(СписокXDTO);		 
	КонецЕсли;
	Возврат Результат;
	
КонецФункции	

Функция ПолучитьИмяПеречисления(ПеречислениеСсылка) Экспорт 
	Если Не ЗначениеЗаполнено(ПеречислениеСсылка) Тогда
		Возврат "";
	КонецЕсли;
	ИмяМетаданных = ПеречислениеСсылка.Метаданные().Имя;
	НазваниеМенеджера = "ПеречислениеМенеджер." + ИмяМетаданных;    
	Менеджер = Новый (НазваниеМенеджера); 
	Имя = ПеречислениеСсылка.Метаданные().ЗначенияПеречисления[Менеджер.Индекс(ПеречислениеСсылка)].Имя;
	Возврат Имя;  
КонецФункции

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("ЗагрузитьСрокиПредоставленияДанных", Истина);
	Методы.Вставить("ЗагрузитьТаксономию", Истина);
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс 

// См. ОчередьЗаданийПереопределяемый.ПриОпределенииПсевдонимовОбработчиков.
Процедура ПриОпределенииПсевдонимовОбработчиков(СоответствиеИменПсевдонимам) Экспорт
	
	СоответствиеИменПсевдонимам.Вставить("ОбработчикиРегламентныхЗаданийМСД.ФормированиеДанных");
	
КонецПроцедуры 

// Определяет возможность отправки запроса с учетом установленных параметров в константе.
//
// Параметры:
//  ТипСообщения - ПеречислениеСсылка.ТипыСообщенийМСД
//	ДополнительныеДанные - Строка - Год или Версия таксономии в зависимости от типа сообщения 
//
Функция КонтрольОтправкиЗапросов(ТипСообщения, ДополнительныеДанные) Экспорт
	
	Условие = ?(ЗначениеЗаполнено(ДополнительныеДанные), "И ЗапросыДанныхМСД.ДополнительныеДанные = &ДополнительныеДанные", "");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	СтрШаблон("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ЗапросыДанныхМСД.ДатаЗапроса КАК ДатаЗапроса,
	|	ЗапросыДанныхМСД.Статус КАК Статус
	|ИЗ
	|	РегистрСведений.ЗапросыДанныхМСД КАК ЗапросыДанныхМСД
	|ГДЕ
	|	ЗапросыДанныхМСД.ТипСообщения = &ТипСообщения
	|	%1
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаЗапроса УБЫВ", Условие);
	
	Запрос.УстановитьПараметр("ДополнительныеДанные", Строка(ДополнительныеДанные));
	Запрос.УстановитьПараметр("ТипСообщения", ТипСообщения);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Результат = Новый Структура("ДатаЗапроса, ДатаЗапросаПовторный, ОтправитьСообщение", Дата(1,1,1), Дата(1,1,1), Истина);
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда 
		Если ВыборкаДетальныеЗаписи.Статус = Перечисления.СтатусыПакетовМСД.Отправлен Тогда
			Таймаут = Константы.ТаймаутПовторнойОтправкиЗапросовВМСД.Получить(); 
			ДатаЗапросаПовторный = ВыборкаДетальныеЗаписи.ДатаЗапроса + Таймаут * 60;
			Если УниверсальноеВремя(ТекущаяДатаСеанса()) < ДатаЗапросаПовторный Тогда
				Результат.ОтправитьСообщение = Ложь;
				Результат.ДатаЗапроса = ВыборкаДетальныеЗаписи.ДатаЗапроса;
				Результат.ДатаЗапросаПовторный = ДатаЗапросаПовторный;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура КонтрольОтправкиЗапросовСверки(Организация, ТипСообщения, ТекущаяДатаСеанса, ОтменитьЗапрос) Экспорт
	
	Если ТекущаяДатаСеанса = Неопределено Тогда
		ТекущаяДатаСеанса = УниверсальноеВремя(ТекущаяДатаСеанса());			
	КонецЕсли;
	
	ЗапросСозданныеРаннееЗапросы = Новый Запрос;
	ЗапросСозданныеРаннееЗапросы.Текст =  "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	 |	МАКСИМУМ(ЗапросыДанныхМСД.Период) КАК Период
	 |ИЗ
	 |	РегистрСведений.ЗапросыДанныхМСД КАК ЗапросыДанныхМСД
	 |ГДЕ
	 |	ЗапросыДанныхМСД.Организация = &Организация
	 |	И ЗапросыДанныхМСД.ТипСообщения = &ТипСообщения
	 |	И ЗапросыДанныхМСД.Период >= &ТекущийДень
	 |;
	 |
	 |////////////////////////////////////////////////////////////////////////////////
	 |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	 |	ЗапросыДанныхМСД.Период КАК Период
	 |ИЗ
	 |	РегистрСведений.ЗапросыДанныхМСД КАК ЗапросыДанныхМСД
	 |ГДЕ
	 |	ЗапросыДанныхМСД.Организация = &Организация
	 |	И ЗапросыДанныхМСД.ТипСообщения = ЗНАЧЕНИЕ(Перечисление.ТипыСообщенийМСД.Таксономия)
	 |	И ЗапросыДанныхМСД.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПакетовМСД.Отправлен)
	 |	И ЗапросыДанныхМСД.Период >= &ТекущийДень
	 |
	 |УПОРЯДОЧИТЬ ПО
	 |	Период УБЫВ";
		
	ЗапросСозданныеРаннееЗапросы.УстановитьПараметр("Организация", Организация);
	ЗапросСозданныеРаннееЗапросы.УстановитьПараметр("ТекущийДень", НачалоДня(ТекущаяДатаСеанса));
	ЗапросСозданныеРаннееЗапросы.УстановитьПараметр("ТипСообщения", ТипСообщения);
	
	ПакетыСозданныеРаннееЗапросы = ЗапросСозданныеРаннееЗапросы.ВыполнитьПакет();   
	
	ДатаОтправки = Дата(1,1,1); 		
	РезультатДатаОтправки =  ПакетыСозданныеРаннееЗапросы[ПакетыСозданныеРаннееЗапросы.Количество()-2].Выгрузить();

	Для каждого СтрокаДатаОтправки Из РезультатДатаОтправки Цикл  
		Если ЗначениеЗаполнено(СтрокаДатаОтправки.Период) Тогда
			ДатаОтправки = СтрокаДатаОтправки.Период;
		КонецЕсли;
	КонецЦикла;
		
	РезультатЗапросаСозданныеРаннееЗапросы =  ПакетыСозданныеРаннееЗапросы[ПакетыСозданныеРаннееЗапросы.Количество()-1];
	ТипСообщенияСтрока = ?(ТипСообщения = Перечисления.ТипыСообщенийМСД.Таксономия, "таксономии", "сроков предоставления данных");
	
	Если Не РезультатЗапросаСозданныеРаннееЗапросы.Пустой() Тогда   					
		ВыборкаСозданныеРаннееЗапросы = РезультатЗапросаСозданныеРаннееЗапросы.Выбрать();
		Если ВыборкаСозданныеРаннееЗапросы.Количество() >= 3 Тогда
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон(НСтр("ru='Отправка запроса сверки %1 более трех раз в течение дня недоступна. Для повторной отправки необходимо получить подтверждение получения предыдущего запроса от МСД ПУиО ГИИС ЭБ.'"), ТипСообщенияСтрока));
			ОтменитьЗапрос = Истина;				
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ОтменитьЗапрос И ЗначениеЗаполнено(ДатаОтправки) Тогда
		ПериодПлюс15Минут = ДатаОтправки + 900;
		Если ТекущаяДатаСеанса < ПериодПлюс15Минут Тогда 
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон(НСтр("ru='Повторная отправка запроса сверки %1 возможна не ранее %2.'"), ТипСообщенияСтрока, МестноеВремя(ПериодПлюс15Минут)));
			ОтменитьЗапрос = Истина;					
		КонецЕсли;		
	КонецЕсли;	

КонецПроцедуры	

Процедура КонтрольОтправкиПакета(Пакет, ТекущаяДатаСеанса, ОтменитьВыгрузку) Экспорт
	
	Если ТекущаяДатаСеанса = Неопределено Тогда
		ТекущаяДатаСеанса = УниверсальноеВремя(ТекущаяДатаСеанса());			
	КонецЕсли;
	
	// Блокировка отправки пакета при наличии при условии: За сегодня уже есть пакет в статусе Отправлен или количество не обработанных пакетов >= 3	
	ЗапросСозданныеРаннееЗапросы = Новый Запрос;
	ЗапросСозданныеРаннееЗапросы.Текст =  "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	 |	ПакетыДанныхМСД.Пакет КАК Пакет,
	 |	МАКСИМУМ(ПакетыДанныхМСД.Период) КАК Период,
	 |	ПакетыДанныхМСД.ИдентификаторСообщения КАК ИдентификаторСообщения
	 |ПОМЕСТИТЬ ВТ_ПакетыФормированиеИтог
	 |ИЗ
	 |	РегистрСведений.ПакетыДанныхМСД КАК ПакетыДанныхМСД
	 |ГДЕ
	 |	ПакетыДанныхМСД.Пакет = &Пакет
	 |	И ПакетыДанныхМСД.Период >= &ТекущийДень
	 |
	 |СГРУППИРОВАТЬ ПО
	 |	ПакетыДанныхМСД.Пакет,
	 |	ПакетыДанныхМСД.ИдентификаторСообщения
	 |;
	 |
	 |////////////////////////////////////////////////////////////////////////////////
	 |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	 |	МАКСИМУМ(ПакетыДанныхМСД.Период) КАК Период
	 |ИЗ
	 |	РегистрСведений.ПакетыДанныхМСД КАК ПакетыДанныхМСД
	 |ГДЕ
	 |	ПакетыДанныхМСД.Пакет = &Пакет
	 |	И ПакетыДанныхМСД.Период >= &ТекущийДень
	 |	И ПакетыДанныхМСД.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПакетовМСД.Отправлен)
	 |;
	 |
	 |////////////////////////////////////////////////////////////////////////////////
	 |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	 |	ПакетыДанныхМСД.Период КАК Период
	 |ИЗ
	 |	ВТ_ПакетыФормированиеИтог КАК ВТ_ПакетыФормирование
	 |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПакетыДанныхМСД КАК ПакетыДанныхМСД
	 |		ПО ВТ_ПакетыФормирование.Период = ПакетыДанныхМСД.Период
	 |			И ВТ_ПакетыФормирование.Пакет = ПакетыДанныхМСД.Пакет
	 |			И ВТ_ПакетыФормирование.ИдентификаторСообщения = ПакетыДанныхМСД.ИдентификаторСообщения
	 |ГДЕ
	 |	ПакетыДанныхМСД.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыПакетовМСД.Отправлен)
	 |
	 |УПОРЯДОЧИТЬ ПО
	 |	Период УБЫВ";
	
	ЗапросСозданныеРаннееЗапросы.УстановитьПараметр("Пакет", Пакет);
	ЗапросСозданныеРаннееЗапросы.УстановитьПараметр("ТекущийДень", НачалоДня(ТекущаяДатаСеанса));
	
	ПакетыСозданныеРаннееЗапросы = ЗапросСозданныеРаннееЗапросы.ВыполнитьПакет();   
	
	ДатаОтправки = Дата(1,1,1); 
	РезультатДатаОтправки =  ПакетыСозданныеРаннееЗапросы[ПакетыСозданныеРаннееЗапросы.Количество()-2].Выгрузить();
	
	Для каждого СтрокаДатаОтправки Из РезультатДатаОтправки Цикл  
		Если ЗначениеЗаполнено(СтрокаДатаОтправки.Период) Тогда
			ДатаОтправки = СтрокаДатаОтправки.Период;
		КонецЕсли;
	КонецЦикла;
		
	РезультатЗапросаСозданныеРаннееЗапросы =  ПакетыСозданныеРаннееЗапросы[ПакетыСозданныеРаннееЗапросы.Количество()-1];
		
	Если Не РезультатЗапросаСозданныеРаннееЗапросы.Пустой() Тогда				
		ВыборкаСозданныеРаннееЗапросы = РезультатЗапросаСозданныеРаннееЗапросы.Выбрать();
		Если ВыборкаСозданныеРаннееЗапросы.Количество() >= 3 Тогда
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Отправка пакета более трех раз в течение дня недоступна. Для повторной отправки необходимо получить подтверждение получения пакета от МСД ПУиО ГИИС ЭБ.'"));
			ОтменитьВыгрузку = Истина;						
		КонецЕсли;		
	КонецЕсли;
	
	Если НЕ ОтменитьВыгрузку И ЗначениеЗаполнено(ДатаОтправки) Тогда
		ПериодПлюс15Минут = ДатаОтправки + 900;
		Если ТекущаяДатаСеанса < ПериодПлюс15Минут Тогда 
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон(НСтр("ru='Повторная отправка пакета возможна не ранее %1.'"), МестноеВремя(ПериодПлюс15Минут)));
			ОтменитьВыгрузку = Истина;					
		КонецЕсли;			
	КонецЕсли;

КонецПроцедуры	

#КонецОбласти

#Область СлужебныеПроцедурыИФункции	

Процедура ВыполнитьЗагрузкуСроковПредоставленияДанных(ИмяВременногоФайла, Организация = Неопределено)
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ИмяВременногоФайла);
	ОбъектBody = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);   
	
	Периоды = ОбъектBody.Свойства().Получить("Periods");
	
	Если Периоды <> Неопределено Тогда
		
		ТаблицаПериоды = СоздатьТаблицуПериоды(ОбъектBody.Periods);
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ТаблицаПериоды", ТаблицаПериоды); 
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаПериоды.Наименование КАК Наименование,
		|	ТаблицаПериоды.ДатаНачала КАК ДатаНачала,
		|	ТаблицаПериоды.ДатаОкончания КАК ДатаОкончания,
		|	ТаблицаПериоды.Периодичность КАК Периодичность,
		|	ТаблицаПериоды.Произвольный КАК Произвольный,
		|	ТаблицаПериоды.ЗакрыватьПериод КАК ЗакрыватьПериод,
		|	ТаблицаПериоды.РодительНаименование КАК РодительНаименование,
		|	ТаблицаПериоды.РодительДатаНачала КАК РодительДатаНачала,
		|	ТаблицаПериоды.РодительДатаОкончания КАК РодительДатаОкончания,
		|	ТаблицаПериоды.РодительПериодичность КАК РодительПериодичность,
		|	ТаблицаПериоды.РодительЗакрыватьПериод КАК РодительЗакрыватьПериод
		|ПОМЕСТИТЬ ВТ_ТаблицаПериоды
		|ИЗ
		|	&ТаблицаПериоды КАК ТаблицаПериоды
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МИНИМУМ(ВТ_ТаблицаПериоды.ДатаНачала) КАК ДатаНачала,
		|	МАКСИМУМ(ВТ_ТаблицаПериоды.ДатаОкончания) КАК ДатаОкончания
		|ПОМЕСТИТЬ ВТ_ПериодыОчистки
		|ИЗ
		|	ВТ_ТаблицаПериоды КАК ВТ_ТаблицаПериоды
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СведенияОСрокахПредоставленияДанныхМСД.ПериодДанных КАК ПериодСсылка
		|ИЗ
		|	РегистрСведений.СведенияОСрокахПредоставленияДанныхМСД КАК СведенияОСрокахПредоставленияДанныхМСД
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПериодыМСД КАК ПериодыМСД
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПериодыОчистки КАК ВТ_ПериодыОчистки
		|			ПО (ПериодыМСД.ДатаНачала МЕЖДУ ВТ_ПериодыОчистки.ДатаНачала И ВТ_ПериодыОчистки.ДатаОкончания
		|					ИЛИ ПериодыМСД.ДатаОкончания МЕЖДУ ВТ_ПериодыОчистки.ДатаНачала И ВТ_ПериодыОчистки.ДатаОкончания)
		|		ПО СведенияОСрокахПредоставленияДанныхМСД.ПериодДанных = ПериодыМСД.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_ТаблицаПериодыРодитель.РодительНаименование КАК Наименование,
		|	ВТ_ТаблицаПериодыРодитель.РодительДатаНачала КАК ДатаНачала,
		|	ВТ_ТаблицаПериодыРодитель.РодительДатаОкончания КАК ДатаОкончания,
		|	ВТ_ТаблицаПериодыРодитель.РодительПериодичность КАК Периодичность,
		|	ВТ_ТаблицаПериодыРодитель.РодительЗакрыватьПериод КАК ЗакрыватьПериод,
		|	ЕСТЬNULL(ПериодыМСД.Ссылка, ЗНАЧЕНИЕ(Справочник.ПериодыМСД.ПустаяСсылка)) КАК ПериодСсылка,
		|	ВЫБОР
		|		КОГДА ВТ_ТаблицаПериодыРодитель.РодительПериодичность = ЗНАЧЕНИЕ(Перечисление.ПериодичностьМСД.Год)
		|			ТОГДА 0
		|		КОГДА ВТ_ТаблицаПериодыРодитель.РодительПериодичность = ЗНАЧЕНИЕ(Перечисление.ПериодичностьМСД.ДевятьМесяцев)
		|			ТОГДА 1
		|		КОГДА ВТ_ТаблицаПериодыРодитель.РодительПериодичность = ЗНАЧЕНИЕ(Перечисление.ПериодичностьМСД.Полугодие)
		|			ТОГДА 2
		|		КОГДА ВТ_ТаблицаПериодыРодитель.РодительПериодичность = ЗНАЧЕНИЕ(Перечисление.ПериодичностьМСД.Квартал)
		|			ТОГДА 3
		|		КОГДА ВТ_ТаблицаПериодыРодитель.РодительПериодичность = ЗНАЧЕНИЕ(Перечисление.ПериодичностьМСД.Месяц)
		|			ТОГДА 4
		|		КОГДА ВТ_ТаблицаПериодыРодитель.РодительПериодичность = ЗНАЧЕНИЕ(Перечисление.ПериодичностьМСД.Декада)
		|			ТОГДА 5
		|		КОГДА ВТ_ТаблицаПериодыРодитель.РодительПериодичность = ЗНАЧЕНИЕ(Перечисление.ПериодичностьМСД.Неделя)
		|			ТОГДА 6
		|		КОГДА ВТ_ТаблицаПериодыРодитель.РодительПериодичность = ЗНАЧЕНИЕ(Перечисление.ПериодичностьМСД.День)
		|			ТОГДА 7
		|		КОГДА ВТ_ТаблицаПериодыРодитель.РодительПериодичность = ЗНАЧЕНИЕ(Перечисление.ПериодичностьМСД.ПроизвольныйПериод)
		|			ТОГДА 8
		|	КОНЕЦ КАК Порядок,
		|	ВТ_ТаблицаПериоды.РодительНаименование КАК РодительНаименование,
		|	ВТ_ТаблицаПериоды.РодительДатаНачала КАК РодительДатаНачала,
		|	ВТ_ТаблицаПериоды.РодительДатаОкончания КАК РодительДатаОкончания,
		|	ВТ_ТаблицаПериоды.РодительПериодичность КАК РодительПериодичность,
		|	ЕСТЬNULL(ВТ_ТаблицаПериодыРодитель.РодительДатаНачала = ЕСТЬNULL(ПериодыМСД.ДатаНачала, ДАТАВРЕМЯ(1, 1, 1))
		|			И ВТ_ТаблицаПериодыРодитель.РодительДатаОкончания = ЕСТЬNULL(ПериодыМСД.ДатаОкончания, ДАТАВРЕМЯ(1, 1, 1))
		|			И ВТ_ТаблицаПериодыРодитель.РодительПериодичность = ЕСТЬNULL(ПериодыМСД.Периодичность, ЗНАЧЕНИЕ(Перечисление.ПериодичностьМСД.ПустаяСсылка))
		|			И ВТ_ТаблицаПериодыРодитель.РодительЗакрыватьПериод = ЕСТЬNULL(ПериодыМСД.ЗакрыватьПериод, ЛОЖЬ), ЛОЖЬ) КАК Совпадает
		|ИЗ
		|	ВТ_ТаблицаПериоды КАК ВТ_ТаблицаПериодыРодитель
		|		ПОЛНОЕ СОЕДИНЕНИЕ Справочник.ПериодыМСД КАК ПериодыМСД
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПериодыОчистки КАК ВТ_ПериодыОчистки
		|			ПО (ПериодыМСД.ДатаНачала МЕЖДУ ВТ_ПериодыОчистки.ДатаНачала И ВТ_ПериодыОчистки.ДатаОкончания
		|					ИЛИ ПериодыМСД.ДатаОкончания МЕЖДУ ВТ_ПериодыОчистки.ДатаНачала И ВТ_ПериодыОчистки.ДатаОкончания)
		|		ПО ВТ_ТаблицаПериодыРодитель.РодительНаименование = ПериодыМСД.Наименование
		|			И (НЕ ПериодыМСД.ПометкаУдаления)
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ТаблицаПериоды КАК ВТ_ТаблицаПериоды
		|		ПО ВТ_ТаблицаПериодыРодитель.РодительНаименование = ВТ_ТаблицаПериоды.Наименование
		|			И ВТ_ТаблицаПериодыРодитель.РодительДатаНачала = ВТ_ТаблицаПериоды.ДатаНачала
		|			И ВТ_ТаблицаПериодыРодитель.РодительДатаОкончания = ВТ_ТаблицаПериоды.ДатаОкончания
		|			И ВТ_ТаблицаПериодыРодитель.РодительПериодичность = ВТ_ТаблицаПериоды.Периодичность
		|			И ВТ_ТаблицаПериодыРодитель.РодительЗакрыватьПериод = ВТ_ТаблицаПериоды.ЗакрыватьПериод
		|
		|УПОРЯДОЧИТЬ ПО
		|	Порядок
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_ТаблицаПериоды.Наименование КАК Наименование,
		|	ВТ_ТаблицаПериоды.ДатаНачала КАК ДатаНачала,
		|	ВТ_ТаблицаПериоды.ДатаОкончания КАК ДатаОкончания,
		|	ВТ_ТаблицаПериоды.Периодичность КАК Периодичность,
		|	ВТ_ТаблицаПериоды.Произвольный КАК Произвольный,
		|	ВТ_ТаблицаПериоды.ЗакрыватьПериод КАК ЗакрыватьПериод,
		|	ВТ_ТаблицаПериоды.РодительНаименование КАК РодительНаименование,
		|	ВТ_ТаблицаПериоды.РодительДатаНачала КАК РодительДатаНачала,
		|	ВТ_ТаблицаПериоды.РодительДатаОкончания КАК РодительДатаОкончания,
		|	ВТ_ТаблицаПериоды.РодительПериодичность КАК РодительПериодичность,
		|	ЕСТЬNULL(ПериодыМСД.Ссылка, ЗНАЧЕНИЕ(Справочник.ПериодыМСД.ПустаяСсылка)) КАК ПериодСсылка,
		|	ЕСТЬNULL(ВТ_ТаблицаПериоды.ДатаНачала = ЕСТЬNULL(ПериодыМСД.ДатаНачала, ДАТАВРЕМЯ(1, 1, 1))
		|			И ВТ_ТаблицаПериоды.ДатаОкончания = ЕСТЬNULL(ПериодыМСД.ДатаОкончания, ДАТАВРЕМЯ(1, 1, 1))
		|			И ВТ_ТаблицаПериоды.Периодичность = ЕСТЬNULL(ПериодыМСД.Периодичность, ЗНАЧЕНИЕ(Перечисление.ПериодичностьМСД.ПустаяСсылка))
		|			И ВТ_ТаблицаПериоды.Произвольный = ЕСТЬNULL(ПериодыМСД.Произвольный, ЛОЖЬ)
		|			И ВТ_ТаблицаПериоды.ЗакрыватьПериод = ЕСТЬNULL(ПериодыМСД.ЗакрыватьПериод, ЛОЖЬ), ЛОЖЬ) КАК Совпадает
		|ИЗ
		|	ВТ_ТаблицаПериоды КАК ВТ_ТаблицаПериоды
		|		ПОЛНОЕ СОЕДИНЕНИЕ Справочник.ПериодыМСД КАК ПериодыМСД
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ПериодыОчистки КАК ВТ_ПериодыОчистки
		|			ПО (ПериодыМСД.ДатаНачала МЕЖДУ ВТ_ПериодыОчистки.ДатаНачала И ВТ_ПериодыОчистки.ДатаОкончания
		|					ИЛИ ПериодыМСД.ДатаОкончания МЕЖДУ ВТ_ПериодыОчистки.ДатаНачала И ВТ_ПериодыОчистки.ДатаОкончания)
		|		ПО ВТ_ТаблицаПериоды.Наименование = ПериодыМСД.Наименование
		|			И (НЕ ПериодыМСД.ПометкаУдаления)
		|ГДЕ
		|	НЕ (ВТ_ТаблицаПериоды.Наименование, ВТ_ТаблицаПериоды.ДатаНачала, ВТ_ТаблицаПериоды.ДатаОкончания, ВТ_ТаблицаПериоды.Периодичность) В
		|				(ВЫБРАТЬ
		|					ВТ_ТаблицаПериоды.РодительНаименование КАК РодительНаименование,
		|					ВТ_ТаблицаПериоды.РодительДатаНачала КАК РодительДатаНачала,
		|					ВТ_ТаблицаПериоды.РодительДатаОкончания КАК РодительДатаОкончания,
		|					ВТ_ТаблицаПериоды.РодительПериодичность КАК РодительПериодичность
		|				ИЗ
		|					ВТ_ТаблицаПериоды КАК ВТ_ТаблицаПериоды)";
		
		РезультатЗапроса = Запрос.ВыполнитьПакет();
		
		ОчиститьВыборка = РезультатЗапроса[РезультатЗапроса.Количество()-3].Выгрузить();
		РодительВыборка = РезультатЗапроса[РезультатЗапроса.Количество()-2].Выгрузить();
		ПериодВыборка = РезультатЗапроса[РезультатЗапроса.Количество()-1].Выгрузить();
		
		СоздатьОбновитьПериод(РодительВыборка, РодительВыборка);			
		СоздатьОбновитьПериод(ПериодВыборка, РодительВыборка);
		
		Если ЗначениеЗаполнено(Организация) Тогда
			ТекущаяОрганизация = Организация;
		Иначе
			ТекущаяОрганизация = ПараметрыСеанса.ТекущаяОрганизация;
		КонецЕсли;	
		
		ОчиститьНаборЗаписей(ОчиститьВыборка, ТекущаяОрганизация); 	
		
		СведенияСрок = ОбъектBody.Свойства().Получить("SvedSrok");
		Если СведенияСрок <> Неопределено Тогда
			МассивСтрок = Новый Массив;
			Если ТипЗнч(ОбъектBody.SvedSrok) = Тип("СписокXDTO") Тогда
				МассивСтрок = ОбъектBody.SvedSrok;
			Иначе
				МассивСтрок.Добавить(ОбъектBody.SvedSrok);	
			КонецЕсли;	
			Для каждого текСрок Из МассивСтрок Цикл 
				
				ПериодПоиск = РодительВыборка.НайтиСтроки(Новый Структура("Наименование", текСрок.PeriodName));
				Если ПериодПоиск.Количество() = 0 Тогда
					ПериодПоиск = ПериодВыборка.НайтиСтроки(Новый Структура("Наименование", текСрок.PeriodName));
					Если ПериодПоиск.Количество() = 0 Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли;	
				
				Запись = РегистрыСведений.СведенияОСрокахПредоставленияДанныхМСД.СоздатьМенеджерЗаписи();
				Запись.Организация = ТекущаяОрганизация;
				Запись.ПериодДанных = ПериодПоиск[0].ПериодСсылка;
				Запись.Срок = XMLЗначение(Тип("Дата"), текСрок.Srok);
				Запись.Записать(Истина);  
				
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СоздатьОбновитьПериод(Выборка, РодительВыборка)
	
	ОтборСоздание = Новый Структура("Совпадает", Ложь);	
	СтрокиСоздание = Выборка.НайтиСтроки(ОтборСоздание);
	
	Для каждого ПериодСтрока Из СтрокиСоздание Цикл
				
		ИзменитьОбъект = Истина;
		УдалитьОбъект = Ложь;
		Если НЕ ЗначениеЗаполнено(ПериодСтрока.Наименование) Тогда 
			УдалитьОбъект = Истина;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПериодСтрока.ПериодСсылка) Тогда
			ПериодОбъект = ПериодСтрока.ПериодСсылка.ПолучитьОбъект();
			Попытка
				ПериодОбъект.Заблокировать();
			Исключение
				ИзменитьОбъект = Ложь;
				ЗаписьЖурналаРегистрации(НСтр("ru='СозданиеИзменениеПериодовМСД'", ОбщегоНазначения.КодОсновногоЯзыка()),
				УровеньЖурналаРегистрации.Ошибка,, ПериодОбъект, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		Иначе	
			ПериодОбъект = Справочники.ПериодыМСД.СоздатьЭлемент();
		КонецЕсли; 
		
		Если ИзменитьОбъект Тогда
			Если УдалитьОбъект Тогда
				ПериодОбъект.ПометкаУдаления = Истина;
				ПериодОбъект.Записать();	
			Иначе
				ЗаполнитьЗначенияСвойств(ПериодОбъект, ПериодСтрока);		
				ЗаполнитьПериодРодитель(ПериодОбъект, ПериодСтрока, РодительВыборка);		
				ПериодОбъект.Записать();
			КонецЕсли;
		КонецЕсли;	
		
		Если НЕ ЗначениеЗаполнено(ПериодСтрока.ПериодСсылка) Тогда
			ПериодСтрока.ПериодСсылка = ПериодОбъект.Ссылка;
		КонецЕсли; 
		
	КонецЦикла;	
	
КонецПроцедуры

Процедура ЗаполнитьПериодРодитель(ПериодОбъект, ПериодСтрока, РодительВыборка)
	
	Если ЗначениеЗаполнено(ПериодСтрока.РодительНаименование) Тогда
		
		ОтборРодитель = Новый Структура;
		ОтборРодитель.Вставить("Наименование", ПериодСтрока.РодительНаименование);
		ОтборРодитель.Вставить("ДатаНачала", ПериодСтрока.РодительДатаНачала);
		ОтборРодитель.Вставить("ДатаОкончания", ПериодСтрока.РодительДатаОкончания);
		ОтборРодитель.Вставить("Периодичность", ПериодСтрока.РодительПериодичность);
		
		РодительНайден = РодительВыборка.НайтиСтроки(ОтборРодитель); 
		Если РодительНайден.Количество() > 0 Тогда
			ПериодОбъект.Родитель = РодительНайден[0].ПериодСсылка;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры 

Функция СоздатьТаблицуПериоды(PERIODS)
	
	ТаблицаПериоды = Новый ТаблицаЗначений;
	ТаблицаПериоды.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(50))); 
	ТаблицаПериоды.Колонки.Добавить("ДатаНачала", Новый ОписаниеТипов("Дата"));
	ТаблицаПериоды.Колонки.Добавить("ДатаОкончания", Новый ОписаниеТипов("Дата"));
	ТаблицаПериоды.Колонки.Добавить("Периодичность", Новый ОписаниеТипов("ПеречислениеСсылка.ПериодичностьМСД"));
	ТаблицаПериоды.Колонки.Добавить("Произвольный", Новый ОписаниеТипов("Булево"));
	ТаблицаПериоды.Колонки.Добавить("ЗакрыватьПериод", Новый ОписаниеТипов("Булево"));
	ТаблицаПериоды.Колонки.Добавить("РодительНаименование", Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(50)));
	ТаблицаПериоды.Колонки.Добавить("РодительДатаНачала", Новый ОписаниеТипов("Дата"));
	ТаблицаПериоды.Колонки.Добавить("РодительДатаОкончания", Новый ОписаниеТипов("Дата"));
	ТаблицаПериоды.Колонки.Добавить("РодительПериодичность", Новый ОписаниеТипов("ПеречислениеСсылка.ПериодичностьМСД"));
	ТаблицаПериоды.Колонки.Добавить("РодительЗакрыватьПериод", Новый ОписаниеТипов("Булево"));
	
	Для каждого текПериод Из PERIODS Цикл
		СтрокаТаблицы = ТаблицаПериоды.Добавить();
		СтрокаТаблицы.Наименование = текПериод.Name; 
		СтрокаТаблицы.ДатаНачала = XMLЗначение(Тип("Дата"), текПериод.StartDate);
		СтрокаТаблицы.ДатаОкончания = XMLЗначение(Тип("Дата"), текПериод.EndDate);	
		СтрокаТаблицы.Периодичность = XMLЗначение(Тип("ПеречислениеСсылка.ПериодичностьМСД"), текПериод.Frequency);  
		СтрокаТаблицы.Произвольный = XMLЗначение(Тип("Булево"), текПериод.OperationalData);
		Если текПериод.Свойства().Получить("ClosePeriod") = Неопределено Тогда
			СтрокаТаблицы.ЗакрыватьПериод = Ложь;			
		Иначе
		    СтрокаТаблицы.ЗакрыватьПериод = Булево(Число(текПериод.ClosePeriod));
		КонецЕсли;
		РодительНаименование = ?(ТипЗнч(текПериод.ParentName) <> Тип("Строка"), "", текПериод.ParentName);
		Если ЗначениеЗаполнено(РодительНаименование) Тогда
			СтрокаТаблицы.РодительНаименование = РодительНаименование;
			СтрокаТаблицы.РодительДатаНачала = XMLЗначение(Тип("Дата"), текПериод.ParentStartDate);
			СтрокаТаблицы.РодительДатаОкончания = XMLЗначение(Тип("Дата"), текПериод.ParentEndDate);
			СтрокаТаблицы.РодительПериодичность = XMLЗначение(Тип("ПеречислениеСсылка.ПериодичностьМСД"), текПериод.ParentFrequency);
			Если текПериод.Свойства().Получить("ParentClosePeriod") = Неопределено Тогда
				СтрокаТаблицы.РодительЗакрыватьПериод = Ложь;			
			Иначе
			    СтрокаТаблицы.РодительЗакрыватьПериод = Булево(Число(текПериод.ParentClosePeriod));
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;	
	
	Возврат ТаблицаПериоды;
	
КонецФункции  	

Процедура ОчиститьНаборЗаписей(Выборка, ТекущаяОрганизация)
	Для каждого СтрокаПериод Из Выборка Цикл
		Если ЗначениеЗаполнено(СтрокаПериод.ПериодСсылка) Тогда
			Набор = РегистрыСведений.СведенияОСрокахПредоставленияДанныхМСД.СоздатьНаборЗаписей();
			Набор.Отбор.Организация.Установить(ТекущаяОрганизация);
			Набор.Отбор.ПериодДанных.Установить(СтрокаПериод.ПериодСсылка);
			Набор.Записать();	
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры

Процедура ЗаписатьСтатусПротокола(Выборка, Статус)
	
	ТекущаяДата = УниверсальноеВремя(ТекущаяДатаСеанса());
	Запись = РегистрыСведений.ПакетыДанныхМСД.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(Запись, Выборка);
	Запись.Период = ТекущаяДата;
	Запись.Статус = Статус;	
	Запись.ДатаСтатуса = ТекущаяДата;
	Запись.Записать(Истина);
	
КонецПроцедуры	  

Процедура УстановитьДатуЗапрета(ПараметрыЗакрытиеПериода)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДатыЗапретаИзменения.Раздел КАК Раздел,
		|	ДатыЗапретаИзменения.Объект КАК Объект,
		|	ДатыЗапретаИзменения.Пользователь КАК Пользователь,
		|	ДатыЗапретаИзменения.ДатаЗапрета КАК ДатаЗапрета,
		|	ДатыЗапретаИзменения.ОписаниеДатыЗапрета КАК ОписаниеДатыЗапрета,
		|	ДатыЗапретаИзменения.Комментарий КАК Комментарий
		|ИЗ
		|	РегистрСведений.ДатыЗапретаИзменения КАК ДатыЗапретаИзменения";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Раздел) Тогда
			Если ВыборкаДетальныеЗаписи.Раздел = ПланыВидовХарактеристик.РазделыДатЗапретаИзменения.НайтиПоНаименованию("Бухгалтерский учет") 
				ИЛИ ВыборкаДетальныеЗаписи.Раздел = ПланыВидовХарактеристик.РазделыДатЗапретаИзменения.НайтиПоНаименованию("Платное обучение") Тогда						
				ПроверитьВыполнениеУсловийИЗаписать(ПараметрыЗакрытиеПериода, ВыборкаДетальныеЗаписи);									
			КонецЕсли;						
		Иначе
			ПроверитьВыполнениеУсловийИЗаписать(ПараметрыЗакрытиеПериода, ВыборкаДетальныеЗаписи);
		КонецЕсли;							
	КонецЦикла;

КонецПроцедуры

Процедура ПроверитьВыполнениеУсловийИЗаписать(ПараметрыЗакрытиеПериода, ВыборкаДетальныеЗаписи)
	
	ДобавитьЗапись = Ложь;	
	Если ВыборкаДетальныеЗаписи.Раздел = ВыборкаДетальныеЗаписи.Объект Тогда 
		ДобавитьЗапись = Истина;	
	Иначе
		Если ВыборкаДетальныеЗаписи.Объект = ПараметрыЗакрытиеПериода.Организация Тогда
			ДобавитьЗапись = Истина;	
		КонецЕсли;	
	КонецЕсли;
	
	Если ДобавитьЗапись Тогда
		НоваяЗапись = РегистрыСведений.ДатыЗапретаИзменения.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(НоваяЗапись, ВыборкаДетальныеЗаписи);
		НоваяЗапись.ДатаЗапрета = ПараметрыЗакрытиеПериода.ОкончаниеПериода;
		НоваяЗапись.Записать();	
	КонецЕсли;	
	
КонецПроцедуры

Функция ПолучитьДатуОкончанияДоговора(СвойстваДоговоров, Договор, СчетРасчетов, ОкончаниеДоговора) Экспорт
	
    МассивСвойств = СвойстваДоговоров.НайтиСтроки(Новый Структура("Договор", Договор));
    Если МассивСвойств.Количество() Тогда
	    СвойстваДоговора = МассивСвойств[0];
	    ОкончаниеДоговора = СвойстваДоговора.ОкончаниеДоговора;
	    Если ОкончаниеДоговора = Неопределено ИЛИ ОкончаниеДоговора = Дата(1, 1, 1) Тогда
	        ОкончаниеДоговора = Дата(2999,12,31);
		КонецЕсли;
	КонецЕсли; 
	
КонецФункции

#КонецОбласти
