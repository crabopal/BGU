// Новый описание первичных документов.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Новый описание первичных документов:
// * Идентификатор - Строка - 
// * ВидПервичногоДокумента - Строка - 
// * Наименование - Строка - 
Функция НовыйОписаниеПервичныхДокументов()
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Идентификатор",
		Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100, ДопустимаяДлина.Переменная)));
	Результат.Колонки.Добавить("ВидПервичногоДокумента",
		Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(100, ДопустимаяДлина.Переменная)));
	Результат.Колонки.Добавить("Наименование",
		Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(150, ДопустимаяДлина.Переменная)));
	Возврат Результат;
КонецФункции

// Пустая строка параметра печатных форм.
// 
// Возвращаемое значение:
//  Структура - Пустая строка параметра печатных форм:
// * Представление - Строка -
// * ВидПервичногоДокумента - СправочникСсылка.ПервичныеДокументы
// * УсловияВидимости - Массив из Строка
Функция ПустаяСтрокаПараметраПечатныхФорм()
	Результат = Новый Структура;
	Результат.Вставить("Представление", "");
	Результат.Вставить("ВидПервичногоДокумента", ПредопределенноеЗначение("Справочник.ПервичныеДокументы.ПустаяСсылка"));
	Результат.Вставить("УсловияВидимости", Новый Массив);
	Возврат Результат;
КонецФункции

