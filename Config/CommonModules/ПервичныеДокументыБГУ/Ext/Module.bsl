
#Область ПрограммныйИнтерфейс

// Параметры заполнения первичных документов.
// 
// Возвращаемое значение:
//  Структура - Параметры заполнения первичных документов:
// * ДобавлятьДокументКонтрагента - Булево - 
// * УсловиеВидимостиДокументаКонтрагента - Неопределено 
// * ДобавлятьАктПриемкиТоваровРаботУслуг - Булево - 
// * УсловиеВидимостиАктаПриемкиТоваровРаботУслуг - Неопределено
Функция ПараметрыЗаполненияПервичныхДокументов() Экспорт
	Параметры = Новый Структура;
	Параметры.Вставить("ДобавлятьДокументКонтрагента", Ложь);
	Параметры.Вставить("УсловиеВидимостиДокументаКонтрагента", Неопределено);
	Параметры.Вставить("ДобавлятьАктПриемкиТоваровРаботУслуг", Ложь);
	Параметры.Вставить("УсловиеВидимостиАктаПриемкиТоваровРаботУслуг", Неопределено);
	Возврат Параметры;
КонецФункции

// Заполняет список выбора реквизита "ПервичныйДокумент" 
// и данные печатных форм для первичных документов в реквизит формы "ПераметрыПечатныхФорм".
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  ДобавлятьДокументКонтрагента - Булево - Добавлять первичный документ "Документ контрагента"
//  							 - см. ПараметрыЗаполненияПервичныхДокументов
//  УсловиеВидимостиДокументаКонтрагента - Массив из Строка, Неопределено - Условие видимости документа контрагента
//  СписокОбъектов - Массив из ОбъектМетаданных - коллекция объектов метаданных, команды печати которых необходимо использовать при составлении
//                            списка команд печати для указанной формы.
Процедура ПриСозданииНаСервере(Форма, ДобавлятьДокументКонтрагента = Ложь, 
	УсловиеВидимостиДокументаКонтрагента = Неопределено, СписокОбъектов = Неопределено) Экспорт
	
	Если ТипЗнч(ДобавлятьДокументКонтрагента) = Тип("Структура") Тогда
		ЗначениеДобавлятьДокументКонтрагента = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
			ДобавлятьДокументКонтрагента, "ДобавлятьДокументКонтрагента", Ложь); // Булево
		ЗначениеУсловиеВидимостиДокументаКонтрагента = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
			ДобавлятьДокументКонтрагента, "УсловиеВидимостиДокументаКонтрагента");
		ЗначениеДобавлятьАктПриемкиТоваровРаботУслуг = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
			ДобавлятьДокументКонтрагента, "ДобавлятьАктПриемкиТоваровРаботУслуг", Ложь); // Булево
		ЗначениеУсловиеВидимостиАктаПриемкиТоваровРаботУслуг = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
			ДобавлятьДокументКонтрагента, "УсловиеВидимостиАктаПриемкиТоваровРаботУслуг");
	Иначе
		ЗначениеДобавлятьДокументКонтрагента = ДобавлятьДокументКонтрагента;
		ЗначениеУсловиеВидимостиДокументаКонтрагента = УсловиеВидимостиДокументаКонтрагента;
		ЗначениеДобавлятьАктПриемкиТоваровРаботУслуг = Ложь;
		ЗначениеУсловиеВидимостиАктаПриемкиТоваровРаботУслуг = Неопределено;
	КонецЕсли;
	
	ТаблицаКоманд = УправлениеПечатью.КомандыПечатиФормы(Форма, СписокОбъектов);
	ПечатныеФормы = Новый Структура;
	
	Для Каждого Строка Из ТаблицаКоманд Цикл
		ВидПервичногоДокумента = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Строка.ДополнительныеПараметры, "ВидПервичногоДокумента");
		Если Не ЗначениеЗаполнено(ВидПервичногоДокумента) Тогда
			Продолжить;
		КонецЕсли;
		ПечатнаяФорма = ПустаяСтрокаПараметраПечатныхФорм();
		ПечатнаяФорма.ВидПервичногоДокумента = НайтиПоИдентификатору(Строка.Идентификатор);
		ПечатнаяФорма.Представление = Строка.Представление;
		ПечатнаяФорма.УсловияВидимости = Строка.УсловияВидимости;
		УстановитьОсобоеУсловиеВидимостиКоманды(Строка.Идентификатор, ПечатнаяФорма);
		
		ПечатныеФормы.Вставить(Строка.Идентификатор, ПечатнаяФорма);
	КонецЦикла;
	
	Если ЗначениеДобавлятьДокументКонтрагента Тогда
		Если ЗначениеУсловиеВидимостиДокументаКонтрагента = Неопределено Тогда
			ЗначениеУсловиеВидимостиДокументаКонтрагента = Новый Массив;
		КонецЕсли;
		
		ПечатнаяФорма = ПустаяСтрокаПараметраПечатныхФорм();
		ПечатнаяФорма.ВидПервичногоДокумента = ПервичныйДокументДокументКонтрагента();
		ПечатнаяФорма.Представление = НСтр("ru = 'Документ контрагента'");
		ПечатнаяФорма.УсловияВидимости = УсловиеВидимостиДокументаКонтрагента;
		ПечатныеФормы.Вставить("ДокументКонтрагента", ПечатнаяФорма);
	КонецЕсли;
	
	Если ЗначениеДобавлятьАктПриемкиТоваровРаботУслуг Тогда
		Если ЗначениеУсловиеВидимостиАктаПриемкиТоваровРаботУслуг = Неопределено Тогда
			ЗначениеУсловиеВидимостиАктаПриемкиТоваровРаботУслуг = Новый Массив;
		КонецЕсли;
		ПечатнаяФорма = ПустаяСтрокаПараметраПечатныхФорм();
		ПечатнаяФорма.ВидПервичногоДокумента = ПервичныйДокументАктПриемкиТРУ();
		ПечатнаяФорма.Представление = НСтр("ru = 'Акт приемки товаров, работ, услуг (ф. 0510452)'");
		ПечатнаяФорма.УсловияВидимости = ЗначениеУсловиеВидимостиАктаПриемкиТоваровРаботУслуг;
		ПечатныеФормы.Вставить("ДокументАктПриемкиТоваровРаботУслуг", ПечатнаяФорма);
	КонецЕсли;
	
	Форма.ПараметрыПечатныхФорм = ПечатныеФормы;
	ПервичныеДокументыБГУКлиентСервер.ОбновитьВидыПервичныхДокументов(Форма);
КонецПроцедуры

// Представление первичного документа.
// 
// Параметры:
//  ПервичныйДокумент - СправочникСсылка.ПервичныеДокументы
// 
// Возвращаемое значение:
//  Строка
Функция ВидПервичногоДокумента(ПервичныйДокумент) Экспорт
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПервичныйДокумент, "ВидПервичногоДокумента");
КонецФункции

// Добавляет условие видимости команды печати по выбранному в документе Первичному документу.
// ИдентификаторПечатнойФормы следует передавать явно, если это дополнительная команда печати,
// которая доступна в дополнение к печатной форме первичного документа.
// Например, чтобы ограничить устаревшие печатные формы, которые не должны быть доступны, когда выбран первичный документ.
// Но которые сами не включаются в список первичных документов.
// 
// Если РазрешитьСДокументомКонтрагента=Истина, будет добавлено условие на первичный документ "Документ контрагента".
// 
// Параметры:
//  КомандаПечати - СтрокаТаблицыЗначений: см. УправлениеПечатью.СоздатьКоллекциюКомандПечати
//  ИдентификаторПечатнойФормы - Строка - если не передана, то берется из КомандыПечати.
//  РазрешитьСДокументомКонтрагента - Булево - Форма используется если выбрано значение "ДокументКонтрагента"
Процедура ДобавитьУсловиеКомандыПечати(КомандаПечати, ИдентификаторПечатнойФормы = "", РазрешитьСДокументомКонтрагента = Ложь) Экспорт
	
	Если Не ЗначениеЗаполнено(ИдентификаторПечатнойФормы) Тогда
		ПервичныйДокумент = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
			КомандаПечати.ДополнительныеПараметры, "ВидПервичногоДокумента", "");
	Иначе	
		ПервичныйДокумент = НайтиПоИдентификатору(ИдентификаторПечатнойФормы);
	КонецЕсли;

	Условия = Новый СписокЗначений;
	Условия.Добавить(Справочники.ПервичныеДокументы.ПустаяСсылка());
	Если РазрешитьСДокументомКонтрагента Тогда
		Условия.Добавить(Справочники.ПервичныеДокументы.ПустаяСсылка());
	КонецЕсли;
	Если ЗначениеЗаполнено(ПервичныйДокумент) Тогда
		Условия.Добавить(ПервичныйДокумент);
	КонецЕсли;
	
	УправлениеПечатью.ДобавитьУсловиеВидимостиКоманды(КомандаПечати,
		"ПервичныйДокумент",
		Условия,
		ВидСравнения.ВСписке);
	
КонецПроцедуры

// Установить вид первичного документа команды печати.
// 
// Параметры:
//  КомандаПечати - СтрокаТаблицыЗначений: см. УправлениеПечатью.СоздатьКоллекциюКомандПечати
//  ДобавитьУсловие - Булево - добавить условие видимости команды
//  РазрешитьСДокументомКонтрагента - Булево - Форма используется если выбрано значение "ДокументКонтрагента"
Процедура УстановитьСвойстваКомандыПечати(КомандаПечати, ДобавитьУсловие = Истина, РазрешитьСДокументомКонтрагента = Ложь) Экспорт
	
	ВидПервичногоДокумента = НайтиПоИдентификатору(КомандаПечати.Идентификатор);
	Если ЗначениеЗаполнено(ВидПервичногоДокумента) Тогда
		КомандаПечати.ДополнительныеПараметры.Вставить("ВидПервичногоДокумента", ВидПервичногоДокумента);
	КонецЕсли;
	Если ДобавитьУсловие Тогда
		ДобавитьУсловиеКомандыПечати(КомандаПечати, "", РазрешитьСДокументомКонтрагента);
	КонецЕсли;
	
КонецПроцедуры

// Возвращает первичный документ по идентификатору.
// 
// Параметры:
//  Идентификатор - Строка - Идентификатор
// 
// Возвращаемое значение:
//  СправочникСсылка.ПервичныеДокументы - Найти по идентификатору
Функция НайтиПоИдентификатору(Идентификатор) Экспорт
	Если Не ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат Справочники.ПервичныеДокументы.ПустаяСсылка();
	КонецЕсли;
	ПервичныйДокумент = Справочники.ПервичныеДокументы.НайтиПоИдентификатору(Идентификатор, Ложь);
	Если Не ЗначениеЗаполнено(ПервичныйДокумент) Тогда
		ПервичныйДокумент = Справочники.ПервичныеДокументы.СоздатьЭлементПоИдентификатору(Идентификатор);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ПервичныйДокумент) Тогда
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Поиск первичного документа'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Предупреждение,
			Метаданные.Справочники.ПервичныеДокументы,
			,
			СтрШаблон(НСтр("ru = 'Не найден первичный документ по идентификатору: %1'"), Идентификатор));
	КонецЕсли;
	Возврат ПервичныйДокумент;
КонецФункции

// Описания первичных документов.
// В описания добавляются первичные документы из модуля ПервичныеДокументыБГУПереопределяемый.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Описания первичных документов:
// * Идентификатор - Строка - 
// * ВидПервичногоДокумента - Строка - 
// * Наименование - Строка - 
Функция ОписанияПервичныхДокументов() Экспорт
	
	ПервичныеДокументы = НовыйОписаниеПервичныхДокументов();
	ДобавитьПоставляемыеОписанияПервичныхДокументов(ПервичныеДокументы);
	ПервичныеДокументыБГУПереопределяемый.ДобавитьПоставляемыеОписанияПервичныхДокументов(ПервичныеДокументы);
	Возврат ПервичныеДокументы;
	
КонецФункции

// Первичный документ - "Документ контрагента".
// 
// Возвращаемое значение:
//  СправочникСсылка.ПервичныеДокументы - Первичный документ документ контрагента
Функция ПервичныйДокументДокументКонтрагента() Экспорт
	Возврат НайтиПоИдентификатору(СлужебныйИдентификаторДокументКонтагента());
КонецФункции

// Идентификатор для поиска первичного документа "Документ контагента".
// 
// Возвращаемое значение:
//  Строка - Служебный идентификатор документ контагента
Функция СлужебныйИдентификаторДокументКонтагента() Экспорт
	Возврат "ДокументКонтрагента_Служебный";
КонецФункции

// Первичный документ - "Акт приемки товаров, работ, услуг".
// 
// Возвращаемое значение:
//  СправочникСсылка.ПервичныеДокументы - Первичный документ Акт приемки товаров, работ, услуг
Функция ПервичныйДокументАктПриемкиТРУ() Экспорт
	Возврат НайтиПоИдентификатору(СлужебныйИдентификаторАктПриемкиТРУ());
КонецФункции

// Идентификатор для поиска первичного документа "Акт приемки товаров, работ, услуг".
// 
// Возвращаемое значение:
//  Строка - Служебный идентификатор Акт приемки товаров, работ, услуг
Функция СлужебныйИдентификаторАктПриемкиТРУ() Экспорт
	Возврат "АктПриемкиТРУ_Служебный";
КонецФункции

// Добавить описание первичного документа в таблицу первичных документов
// 
// Параметры:
//  ПервичныеДокументы - см. НовыйОписаниеПервичныхДокументов 
//  Идентификатор - Строка - Идентификатор
//  ВидПервичногоДокумента - Строка - Вид первичного документа
//  Наименование - Строка - Наименование
Процедура ДобавитьОписаниеПервичногоДокумента(ПервичныеДокументы, Идентификатор, ВидПервичногоДокумента, Наименование) Экспорт
	НоваяСтрока = ПервичныеДокументы.Добавить();
	НоваяСтрока.Идентификатор = Идентификатор;
	НоваяСтрока.ВидПервичногоДокумента = ВидПервичногоДокумента;
	НоваяСтрока.Наименование = Наименование;
КонецПроцедуры

// Команды печати первичных документов формы.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма
//  Объекты - Неопределено, Массив из ОбъектМетаданных - Объекты
// 
// Возвращаемое значение:
//  см. УправлениеПечатью.КомандыПечатиФормы  
Функция КомандыПечатиПервичныхДокументовФормы(Форма, Объекты = Неопределено) Экспорт
	ТаблицаКоманд = УправлениеПечатью.КомандыПечатиФормы(Форма, Объекты);
	ТолькоПервичныеДокументы = Новый Массив;
	Для Каждого Строка Из ТаблицаКоманд Цикл
		Если Строка.ДополнительныеПараметры.Свойство("ВидПервичногоДокумента")
				И ЗначениеЗаполнено(Строка.ДополнительныеПараметры.ВидПервичногоДокумента) Тогда
			ТолькоПервичныеДокументы.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;
	Возврат ТаблицаКоманд.Скопировать(ТолькоПервичныеДокументы);
КонецФункции

#Область ПолучениеПредставленийПервичныхДокументов

// Формирует представления первичных документов по идентификаторам
//
// Параметры:
//  Идентификатор - Строка - идентификатор печатной формы первичного документа. Например, "АктПриемаПередачи0510448"
//  			  - Массив из Строка - массив идентификаторов печатных форм 
//
// Возвращаемое значение:
//  - Структура - ключем является идентификатор печатной формы, значением является структура, содержащая два элемента:
//                "ПредставлениеФормы", "ПредставлениеКомандыПечати"
Функция ПредставленияПервичныхДокументов(Идентификатор) Экспорт
	ТекстЗапроса = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПервичныеДокументы.Идентификатор,
	|	ПервичныеДокументы.Наименование КАК ПредставлениеКомандыПечати,
	|	ПервичныеДокументы.ВидПервичногоДокумента КАК ПредставлениеФормы
	|ИЗ
	|	Справочник.ПервичныеДокументы КАК ПервичныеДокументы
	|ГДЕ
	|	ПервичныеДокументы.Идентификатор В (&Идентификаторы)";

	Идентификаторы = Идентификатор;
	Если ТипЗнч(Идентификатор) = Тип("Строка") Тогда
		Идентификаторы = Новый Массив;
		Идентификаторы.Добавить(Идентификатор);
	КонецЕсли;	
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Идентификаторы", Идентификаторы);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Новый Структура;
	Для каждого ТекИдентификатор из Идентификаторы Цикл
		Результат.Вставить(ТекИдентификатор, Новый Структура("ПредставлениеФормы, ПредставлениеКомандыПечати"));
		Если Выборка.НайтиСледующий(ТекИдентификатор, "Идентификатор") Тогда
			ЗаполнитьЗначенияСвойств(Результат[ТекИдентификатор], Выборка);
		Иначе	
			ЗаполнитьЗначенияСвойств(
				Результат[ТекИдентификатор], ПредставленияПервичногоДокументаПоУмолчанию(ТекИдентификатор));
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат Результат;
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПредставленияПервичногоДокументаПоУмолчанию(Идентификатор)
	Результат = Новый Структура("ПредставлениеФормы, ПредставлениеКомандыПечати");
	Если Идентификатор = "Форма0510466" Тогда
		Результат.ПредставлениеФормы = НСтр("ru='Инвентаризационная опись по объектам НФА'");
		Результат.ПредставлениеКомандыПечати = НСтр("ru='Инвентаризационная опись по объектам НФА (ф. 0510466)'");
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

// Устанавливает условия видимости команд, которые не могут быть заданы обычным способом
//
// Параметры:
//  Идентификатор	 - Строка - 
//  ПечатнаяФорма	 - см. ПустаяСтрокаПараметраПечатныхФорм
//
Процедура УстановитьОсобоеУсловиеВидимостиКоманды(Идентификатор, ПечатнаяФорма)
	Если Идентификатор = "АктПриемаПередачи0510448" Тогда
		// Акт приема передачи в приходных документах должен быть виден
		// при любом значении реквизита "НФАПереданыЭлектроннымАктом".
		// При этом соответствующая команда печати должна учитывать значение флага.
		// Поэтому в команде печати условие по реквизиту "НФАПереданыЭлектроннымАктом" есть,
		// а в условиях видимости первичного документа условие удаляется.
		Если ТипЗнч(ПечатнаяФорма.УсловияВидимости) = Тип("Массив") Тогда
			Для Индекс = 0 По ПечатнаяФорма.УсловияВидимости.ВГраница() Цикл
				Если ПечатнаяФорма.УсловияВидимости[Индекс].Реквизит = "НФАПереданыЭлектроннымАктом" Тогда
					ПечатнаяФорма.УсловияВидимости.Удалить(Индекс);
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

