Процедура ДобавитьАдресAPIВЗапрос(АдресЗапроса, ВерсияAPI)
	
	АдресAPI = "";
	
	Если ВерсияAPI = 3 Тогда
		АдресAPI = АдресAPIВерсия3();
	ИначеЕсли ВерсияAPI = 4 Тогда
		АдресAPI = АдресAPIВерсия4();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(АдресAPI) Тогда
		АдресЗапроса = СтрШаблон("%1/%2", АдресAPI, АдресЗапроса);
	КонецЕсли;
	
КонецПроцедуры

Функция ДобавитьКоллекциюВПараметрыЗапроса(ОбрабатываемыеПараметры, ИмяПараметра, КоллекцияПараметров)
	
	Если ТипЗнч(КоллекцияПараметров) = Тип("Массив") Тогда
		
		Если КоллекцияПараметров.Количество() > 0 Тогда
			
			ИмяПараметраССуффиксом = СтрШаблон("%1=", ИмяПараметра);
			ПолноеИмяПоследующихПараметров = СтрШаблон("&%1", ИмяПараметраССуффиксом);
			Если ЗначениеЗаполнено(ОбрабатываемыеПараметры) Тогда
				ПолноеИмяПервогоПараметра = ПолноеИмяПоследующихПараметров;
			Иначе
				ПолноеИмяПервогоПараметра = СтрШаблон("?%1", ИмяПараметраССуффиксом);
			КонецЕсли;
			
			НовыеПараметры = СтрСоединить(КоллекцияПараметров, ПолноеИмяПоследующихПараметров);
			
			ОбрабатываемыеПараметры = СтрШаблон("%1%2%3", ОбрабатываемыеПараметры, ПолноеИмяПервогоПараметра, НовыеПараметры);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции

