Функция СтрокаВСкобках(ИсходнаяСтрока)
	
	РезультатОбработки = "";
	
	Если ЗначениеЗаполнено(ИсходнаяСтрока) Тогда
		
		ЧастиРезультата = Новый Массив;
		
		ЧастиРезультата.Добавить("(");
		ЧастиРезультата.Добавить(ИсходнаяСтрока);
		ЧастиРезультата.Добавить(")");
		
		РезультатОбработки = СтрСоединить(ЧастиРезультата);
		
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции
 
