#Область Запросы

Функция ПолучитьДанныеИзСервиса(АдресЗапроса, КлючСессии, ПараметрыОтправкиHTTPЗапросов, ЗаголовокHTTP = Неопределено)
	
	РезультатОтправкиЗапроса = НовыйРезультатОтправкиЗапроса();
	
	ОжидатьВозможностьВыполнитьЗапрос(ПараметрыОтправкиHTTPЗапросов);
	
	СформироватьЗаголовокЗапросаПоУмолчанию(ЗаголовокHTTP, КлючСессии, Истина);
	
	HTTPЗапрос  = Новый HTTPЗапрос(АдресЗапроса, ЗаголовокHTTP);
	HTTPОтвет   = Неопределено;
	ТекстОшибки = "";
	
	Если ПараметрыОтправкиHTTPЗапросов.ИспользоватьЗащищенноеСоединение Тогда
		ИнтернетПрокси = ПолучениеФайловИзИнтернета.ПолучитьПрокси("HTTPS");
		ЗащищенноеСоединение = ОбменИСМПБГУКлиентСерверПовтИсп.ЗащищенноеСоединение();
	Иначе
		ИнтернетПрокси = ПолучениеФайловИзИнтернета.ПолучитьПрокси("HTTP");
		ЗащищенноеСоединение = Неопределено;
	КонецЕсли;
	
	Попытка
		
		Соединение = Новый HTTPСоединение(
			ПараметрыОтправкиHTTPЗапросов.Адрес,
			ПараметрыОтправкиHTTPЗапросов.Порт,,,
			ИнтернетПрокси,
			ПараметрыОтправкиHTTPЗапросов.Таймаут,
			ЗащищенноеСоединение);
		
		HTTPОтвет = Соединение.Получить(HTTPЗапрос);
		
	Исключение
		
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		
		ЗаписьЖурналаРегистрации(
			ПараметрыОтправкиHTTPЗапросов.ПредставлениеСервиса,
			УровеньЖурналаРегистрации.Предупреждение,,,
			СтрШаблон(
				НСтр("ru = 'Ошибка при выполнении запроса GET %1 в %2 %3:%4'"),
				АдресЗапроса,
				ПараметрыОтправкиHTTPЗапросов.ПредставлениеСервиса,
				ПараметрыОтправкиHTTPЗапросов.Адрес,
				ПараметрыОтправкиHTTPЗапросов.Порт)
			+ Символы.ПС
			+ ТекстОшибки);
		
	КонецПопытки;
	
	ПараметрыОтправкиHTTPЗапросов.ДатаПоследнегоЗапроса = ТекущаяДатаСеанса();
	
	РезультатОтправкиЗапроса.ПараметрыОтправкиHTTPЗапросов = ПараметрыОтправкиHTTPЗапросов;
	РезультатОтправкиЗапроса.HTTPМетод                     = "GET";
	РезультатОтправкиЗапроса.HTTPЗапрос                    = HTTPЗапрос;
	РезультатОтправкиЗапроса.HTTPОтвет                     = HTTPОтвет;
	РезультатОтправкиЗапроса.ТекстОшибки                   = ТекстОшибки;
	
	Возврат РезультатОтправкиЗапроса;
	
КонецФункции  

Функция ОтправитьДанныеВСервис(АдресЗапроса, ТелоЗапроса, КлючСессии, HTTPМетод, ПараметрыОтправкиHTTPЗапросов, ЗаголовокHTTP = Неопределено)
	
	РезультатОтправкиЗапроса = НовыйРезультатОтправкиЗапроса();
	
	ОжидатьВозможностьВыполнитьЗапрос(ПараметрыОтправкиHTTPЗапросов);
	
	ЭтоДвоичныеДанные = ТипЗнч(ТелоЗапроса) = Тип("ДвоичныеДанные");
	ЭтоФайл           = ТипЗнч(ТелоЗапроса) = Тип("Файл");
	
	Если ТелоЗапроса <> Неопределено И ТипЗнч(ТелоЗапроса) = Тип("Строка") Тогда
		ТелоЗапросаJSON = ТелоЗапроса;
	ИначеЕсли ТелоЗапроса <> Неопределено И Не ЭтоДвоичныеДанные И Не ЭтоФайл Тогда
		ТелоЗапросаJSON = ОбъектВТекстJSON(ТелоЗапроса, Истина);
	КонецЕсли;
	
	СформироватьЗаголовокЗапросаПоУмолчанию(ЗаголовокHTTP, КлючСессии, Ложь);
	
	HTTPЗапрос = Новый HTTPЗапрос(АдресЗапроса, ЗаголовокHTTP);
	Если ТелоЗапроса <> Неопределено Тогда
		Если ЭтоДвоичныеДанные Тогда
			HTTPЗапрос.УстановитьТелоИзДвоичныхДанных(ТелоЗапроса);
		ИначеЕсли ЭтоФайл Тогда
			HTTPЗапрос.УстановитьИмяФайлаТела(ТелоЗапроса.ПолноеИмя);
		Иначе
			HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапросаJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		КонецЕсли;
	КонецЕсли;
	HTTPОтвет   = Неопределено;
	ТекстОшибки = "";
	
	Если ПараметрыОтправкиHTTPЗапросов.ИспользоватьЗащищенноеСоединение Тогда
		ИнтернетПрокси = ПолучениеФайловИзИнтернета.ПолучитьПрокси("HTTPS");
		ЗащищенноеСоединение = ОбменИСМПБГУКлиентСерверПовтИсп.ЗащищенноеСоединение();
	Иначе
		ИнтернетПрокси = ПолучениеФайловИзИнтернета.ПолучитьПрокси("HTTP");
		ЗащищенноеСоединение = Неопределено;
	КонецЕсли;
	
	Попытка
		
		Соединение = Новый HTTPСоединение(
			ПараметрыОтправкиHTTPЗапросов.Адрес,
			ПараметрыОтправкиHTTPЗапросов.Порт,,,
			ИнтернетПрокси,
			ПараметрыОтправкиHTTPЗапросов.Таймаут,
			ЗащищенноеСоединение);
		
		Если HTTPМетод = "POST" Тогда
			HTTPОтвет = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
		Иначе
			HTTPОтвет = Соединение.ВызватьHTTPМетод(HTTPМетод, HTTPЗапрос);
		КонецЕсли;
		
	Исключение
		
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		
		ЗаписьЖурналаРегистрации(
			ПараметрыОтправкиHTTPЗапросов.ПредставлениеСервиса,
			УровеньЖурналаРегистрации.Предупреждение,,,
			СтрШаблон(
				НСтр("ru = 'Ошибка при выполнении запроса %1 %2 в %3 %4:%5'"),
				HTTPМетод,
				АдресЗапроса,
				ПараметрыОтправкиHTTPЗапросов.ПредставлениеСервиса,
				ПараметрыОтправкиHTTPЗапросов.Адрес,
				ПараметрыОтправкиHTTPЗапросов.Порт)
			+ Символы.ПС
			+ ТекстОшибки);
		
	КонецПопытки;
	
	ПараметрыОтправкиHTTPЗапросов.ДатаПоследнегоЗапроса = ТекущаяДатаСеанса();
	
	РезультатОтправкиЗапроса.ПараметрыОтправкиHTTPЗапросов = ПараметрыОтправкиHTTPЗапросов;
	РезультатОтправкиЗапроса.HTTPМетод                     = HTTPМетод;
	РезультатОтправкиЗапроса.HTTPЗапрос                    = HTTPЗапрос;
	РезультатОтправкиЗапроса.HTTPОтвет                     = HTTPОтвет;
	РезультатОтправкиЗапроса.ТекстОшибки                   = ТекстОшибки;
	
	Возврат РезультатОтправкиЗапроса;
	
КонецФункции

Функция НовыйРезультатОтправкиЗапроса()
	
	РезультатОтправки = Новый Структура;
	
	РезультатОтправки.Вставить("ПараметрыОтправкиHTTPЗапросов", Новый Структура);
	РезультатОтправки.Вставить("HTTPМетод",                     "");
	РезультатОтправки.Вставить("HTTPЗапрос",                    Неопределено);
	РезультатОтправки.Вставить("HTTPОтвет",                     Неопределено);
	РезультатОтправки.Вставить("ТекстОшибки",                   "");
	
	Возврат РезультатОтправки;
	
КонецФункции

Процедура СформироватьЗаголовокЗапросаПоУмолчанию(ЗаголовокHTTP, КлючСессии, БезКэша)
	
	Если НЕ ЗначениеЗаполнено(ЗаголовокHTTP) Тогда
		ЗаголовокHTTP = Новый Соответствие;
		ЗаголовокHTTP.Вставить("Content-Type",   "application/json; charset=utf-8");
		ЗаголовокHTTP.Вставить("Accept-Charset", "utf-8");
		Если БезКэша Тогда
			ЗаголовокHTTP.Вставить("Cache-Control", "no-cache");
		КонецЕсли;
		Если КлючСессии <> Неопределено Тогда
			ЗаголовокHTTP.Вставить("Authorization", СтрШаблон("Bearer %1", КлючСессии));
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ОбработатьРезультатОтправкиHTTPЗапросаКакJSON(РезультатОтправкиЗапроса)
	
	РезультатОбработки = НовыйРезультатОбработкиОтправленногоЗапроса();
	
	Если ТипЗнч(РезультатОтправкиЗапроса) = Тип("Структура") Тогда
		
		Если РезультатОтправкиЗапроса.HTTPОтвет <> Неопределено Тогда
			РезультатОбработки.КодСостояния = РезультатОтправкиЗапроса.HTTPОтвет.КодСостояния;
			РезультатОбработки.ТекстВходящегоСообщения = РезультатОтправкиЗапроса.HTTPОтвет.ПолучитьТелоКакСтроку();
		КонецЕсли;
		
		РезультатОбработки.ЗапросОтправлен = ЗначениеЗаполнено(РезультатОбработки.КодСостояния);
		
		РезультатОбработки.ОтветПолучен = ЗначениеЗаполнено(РезультатОбработки.ТекстВходящегоСообщения);
		
		Если ЗначениеЗаполнено(РезультатОбработки.ТекстВходящегоСообщения) Тогда
			РезультатРазбора = ТекстJSONВОбъект(РезультатОбработки.ТекстВходящегоСообщения, Ложь);
			Если НЕ ЗначениеЗаполнено(РезультатРазбора) Тогда
				РезультатРазбора = ТекстJSONВОбъект(РезультатОбработки.ТекстВходящегоСообщения, Истина);
			КонецЕсли;
			РезультатОбработки.ОтветОбъект = РезультатРазбора;
		КонецЕсли;
		
		РезультатОбработки.ДополнительныеПараметры = РезультатОтправкиЗапроса;
		
		РезультатОбработки.ТекстОшибки = ПредставлениеОшибокПоРезультатуОбработкиЗапроса(РезультатОбработки);
		
	КонецЕсли;
	
	Возврат РезультатОбработки;
	
КонецФункции

Функция НовыйРезультатОбработкиОтправленногоЗапроса()
	
	РезультатОбработки = Новый Структура;
	
	РезультатОбработки.Вставить("ЗапросОтправлен",             Ложь);
	РезультатОбработки.Вставить("ОтветПолучен",                Ложь);
	РезультатОбработки.Вставить("КодСостояния",                0);
	РезультатОбработки.Вставить("ТекстОшибки",                 "");
	РезультатОбработки.Вставить("ОтветОбъект",                 Неопределено);
	РезультатОбработки.Вставить("ТекстВходящегоСообщения",     "");
	РезультатОбработки.Вставить("ДополнительныеПараметры",     Новый Структура);
	
	Возврат РезультатОбработки;
	
КонецФункции

Процедура ПрочитатьОтветИзСервиса(ДанныеОтвета, КлючОтвета, ЗначениеОтвета)
	
	Если ТипЗнч(ДанныеОтвета) = Тип("Структура") И ДанныеОтвета.Свойство(КлючОтвета) Тогда
		ЗначениеОтвета = ДанныеОтвета[КлючОтвета];
	ИначеЕсли ТипЗнч(ДанныеОтвета) = Тип("Соответствие") И ДанныеОтвета.Получить(КлючОтвета) <> Неопределено Тогда
		ЗначениеОтвета = ДанныеОтвета[КлючОтвета];
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьПараметрыВЗапрос(АдресЗапроса, ПараметрыЗапроса)
	
	АдресЗапроса = СтрШаблон("%1%2", АдресЗапроса, ПараметрыЗапроса);
	
КонецПроцедуры

#КонецОбласти

#Область Ожидание

Процедура ОжидатьВозможностьВыполнитьЗапрос(НастройкаПодключения)
	
	ВремяОжиданияСледующегоЗапроса = ВремяОжиданияСледующегоЗапроса(НастройкаПодключения);
	Если ВремяОжиданияСледующегоЗапроса > 0 Тогда
		Если ВремяОжиданияСледующегоЗапроса > НастройкаПодключения.Таймаут Тогда
			ТекстОшибки = СтрШаблон(НСтр("ru = 'Задержка выполнения запроса %1 с. превышает таймаут %2 с.'"),
				ВремяОжиданияСледующегоЗапроса,
				НастройкаПодключения.Таймаут);
			ВызватьИсключение ТекстОшибки;
		Иначе
			Ожидать(ВремяОжиданияСледующегоЗапроса, НастройкаПодключения);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ВремяОжиданияСледующегоЗапроса(НастройкаПодключения)
	
	ВремяОжидания = 0;
	
	Если НастройкаПодключения.Свойство("ДатаПоследнегоЗапроса")
			И НастройкаПодключения.Свойство("ИнтервалМеждуЗапросами") Тогда
		
		ДатаПоследнегоЗапроса = НастройкаПодключения.ДатаПоследнегоЗапроса;
		ИнтервалМеждуЗапросами = НастройкаПодключения.ИнтервалМеждуЗапросами;
		
		РазрешеннаяДатаСледующегоЗапроса = ДатаПоследнегоЗапроса + ИнтервалМеждуЗапросами;
		Если РазрешеннаяДатаСледующегоЗапроса > ТекущаяДатаСеанса() Тогда
			ВремяОжидания = РазрешеннаяДатаСледующегоЗапроса - ТекущаяДатаСеанса();
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ВремяОжидания;
	
КонецФункции

Процедура Ожидать(ВремяОжидания, ПараметрыОбмена)
	
	Если ВремяОжидания <= 0 Тогда
		Возврат;
	КонецЕсли;
	
	ФоновоеЗадание = Неопределено;
	Если ПараметрыОбмена.ФоновоеЗадание = Неопределено Тогда
		
		ТекущийСеансИнформационнойБазы = ПолучитьТекущийСеансИнформационнойБазы();
		ФоновоеЗадание = ТекущийСеансИнформационнойБазы.ПолучитьФоновоеЗадание();
		
		Если ФоновоеЗадание = Неопределено Тогда
			Если ОбщегоНазначения.РазделениеВключено()
				И ОбщегоНазначения.ПодсистемаСуществует("ТехнологияСервиса.БазоваяФункциональность") Тогда
				МодульОбщегоНазначенияБТС = ОбщегоНазначения.ОбщийМодуль("ОбщегоНазначенияБТС");
				МодульОбщегоНазначенияБТС.Пауза(ВремяОжидания);
				Возврат;
			КонецЕсли;
		Иначе
			ПараметрыОбмена.ФоновоеЗадание = ФоновоеЗадание;
		КонецЕсли;
		
	Иначе
		ФоновоеЗадание = ПараметрыОбмена.ФоновоеЗадание;
	КонецЕсли;
	
	Если ФоновоеЗадание <> Неопределено Тогда
		Попытка
			ФоновоеЗадание.ОжидатьЗавершенияВыполнения(ВремяОжидания);
			Возврат;
		Исключение
			ВремяОжидания = 0;
		КонецПопытки;
	КонецЕсли;
	
	Если ВремяОжидания = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ОбщегоНазначения.ЭтоWindowsСервер() Тогда
		
		ЛокальныйАдрес = "127.0.0.0";
		
		НастройкиПрокси = Новый ИнтернетПрокси(Ложь);
		НастройкиПрокси.НеИспользоватьПроксиДляЛокальныхАдресов = Истина;
		НастройкиПрокси.НеИспользоватьПроксиДляАдресов.Добавить(ЛокальныйАдрес);
		
		Попытка
			ЛокальноеСоединение = Новый HTTPСоединение(ЛокальныйАдрес,,,, НастройкиПрокси, ВремяОжидания);
			ЛокальноеСоединение.Получить(Новый HTTPЗапрос);
		Исключение
			ВремяОжидания = 0;
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти 

#Область Ошибки

Функция ПредставлениеОшибокПоРезультатуОбработкиЗапроса(РезультатОбработки)
	
	ПредставлениеОшибок = "";
	
	ТекстыОшибок = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(РезультатОбработки.ТекстВходящегоСообщения) Тогда
		Если НЕ ЗначениеЗаполнено(РезультатОбработки.КодСостояния) Тогда
			ТекстыОшибок.Добавить(НСтр("ru = 'HTTP-запрос не отправлен.'"));
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РезультатОбработки.ДополнительныеПараметры.ТекстОшибки) Тогда
		ТекстыОшибок.Добавить(РезультатОбработки.ДополнительныеПараметры.ТекстОшибки);
	КонецЕсли;
	
	ОшибкиРазобраны = Истина;
	
	ДанныеРазбора = РезультатОбработки.ОтветОбъект;
	
	ОбщиеОшибки = Неопределено;
	ПрочитатьОтветИзСервиса(ДанныеРазбора, "globalErrors", ОбщиеОшибки);
	
	Если ТипЗнч(ОбщиеОшибки) = Тип("Массив") Тогда
		
		Для Каждого ДанныеОшибки Из ОбщиеОшибки Цикл
			Если ТипЗнч(ДанныеОшибки) = Тип("Строка") Тогда
				ТекстыОшибок.Добавить(ДанныеОшибки);
			Иначе
				ОшибкиРазобраны = Ложь;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Если НЕ ОшибкиРазобраны Тогда
		ТекстыОшибок.Добавить(РезультатОбработки.ТекстВходящегоСообщения);
	КонецЕсли;
	
	ОсновнаяОшибка = "";
	ПрочитатьОтветИзСервиса(ДанныеРазбора, "error_message", ОсновнаяОшибка);
	Если ЗначениеЗаполнено(ОсновнаяОшибка) Тогда
		ТекстыОшибок.Добавить(ОсновнаяОшибка);
	КонецЕсли;
	
	ПредставлениеОшибок = СтрСоединить(ТекстыОшибок, Символы.ПС);
	ПредставлениеОшибок = УдалитьНедопустимыеСимволыИзСтроки(ПредставлениеОшибок);
	
	Возврат ПредставлениеОшибок;
	
КонецФункции

Функция ТекстОшибкиПоДаннымЗапроса(АдресЗапроса, РезультатОбработкиЗапроса)
	
	ТекстОшибки =  СтрШаблон(НСтр("ru='При выполнении запроса %1 возникла ошибка.'"), АдресЗапроса);
	
	Если ЗначениеЗаполнено(РезультатОбработкиЗапроса.КодСостояния) Тогда
		ТекстОшибки = ТекстОшибки + Символы.ПС
			+ СтрШаблон(НСтр("ru='Код состояния HTTP: %1.'"), РезультатОбработкиЗапроса.КодСостояния);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РезультатОбработкиЗапроса.ТекстОшибки) Тогда
		ТекстОшибки = ТекстОшибки + Символы.ПС + РезультатОбработкиЗапроса.ТекстОшибки;
	КонецЕсли;
	
	Если ЭтоВременнаяОшибка(РезультатОбработкиЗапроса) Тогда
		ТекстОшибки = ТекстОшибки + Символы.ПС
			+ НСтр("ru='Попробуйте еще раз или выполните действие через личный кабинет.'");
	КонецЕсли;
	
	Возврат ТекстОшибки;
	
КонецФункции

Функция ЭтоВременнаяОшибка(РезультатОбработкиЗапроса)
	
	ОшибкаВременная = Ложь;
	
	Если СтрНайти(РезультатОбработкиЗапроса.ТекстОшибки, НСтр("ru = 'Превышено время ожидания'")) Тогда
		ОшибкаВременная = Истина;
	КонецЕсли;
	
	Если РезультатОбработкиЗапроса.КодСостояния = 500 ИЛИ РезультатОбработкиЗапроса.КодСостояния = 503 Тогда
		ОшибкаВременная = Истина;
	КонецЕсли;
	
	Возврат ОшибкаВременная;
	
КонецФункции

Функция УдалитьНедопустимыеСимволыИзСтроки(Знач ДанныеСтроки)
	
	Пока Истина Цикл
		
		ПозицияНедопустимогоСимвола = НайтиНедопустимыеСимволыXML(ДанныеСтроки);
		Если ПозицияНедопустимогоСимвола = 0 Тогда
			Прервать;
		КонецЕсли;
		ДанныеСтроки = Лев(ДанныеСтроки, ПозицияНедопустимогоСимвола - 1)
			+ Сред(ДанныеСтроки, ПозицияНедопустимогоСимвола + 1);
		
	КонецЦикла;
	
	Возврат ДанныеСтроки;
	
КонецФункции

#КонецОбласти

#Область JWT

Функция РасшифроватьТокенJWT(Токен)
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("РезультатРасшифровки", Неопределено);
	ВозвращаемоеЗначение.Вставить("ТекстОшибки", "");
	
	ЭлементыТокена = СтрРазделить(Токен, ".");
	Если ЭлементыТокена.Count() <> 3 Тогда
		ВозвращаемоеЗначение.ТекстОшибки = НСтр("ru = 'Токен не соответствует формату JWT'");
	Иначе
		
		ЭлементТокенаДанные = ЭлементыТокена[1];
		
		Данные = ТекстJSONВОбъект(
			ПолучитьСтрокуИзДвоичныхДанных(
				ДвоичныеДанныеЭлементаТокенаJWT(ЭлементТокенаДанные)));
		
		ВозвращаемоеЗначение.РезультатРасшифровки = Данные;
		
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

Функция ДвоичныеДанныеЭлементаТокенаJWT(Знач Значение)
	
	Значение = СтрЗаменить(Значение, "-", "+");
	Значение = СтрЗаменить(Значение, "_", "/");
	
	Остаток = СтрДлина(Значение) % 4;
	
	Если Остаток = 1 Тогда
		Возврат Неопределено;
	ИначеЕсли Остаток = 2 Тогда
		Значение = Значение + "==";
	ИначеЕсли Остаток = 3 Тогда
		Значение = Значение + "=";
	КонецЕсли;
	
	Возврат Base64Значение(Значение);
	
КонецФункции

#КонецОбласти  

#Область КонтрольОстатковКодовМаркировки

Функция ОстаткиКодовМаркировки(ПараметрыЗапроса) Экспорт 
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	КодыИСМПБГУОстатки.Номенклатура КАК Номенклатура,
	               |	КодыИСМПБГУОстатки.КодИСМП КАК КодИСМП,
	               |	СУММА(КодыИСМПБГУОстатки.КоличествоОстаток) КАК Остаток
	               |ИЗ
	               |	РегистрНакопления.КодыИСМПБГУ.Остатки(
	               |			&ДатаОстатков,
	               |			Организация = &Организация
	               |				И КодИСМП В (&КодыИСМП)) КАК КодыИСМПБГУОстатки
	               |ГДЕ
	               |	КодыИСМПБГУОстатки.Номенклатура В(&Номенклатура)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	КодыИСМПБГУОстатки.Номенклатура,
	               |	КодыИСМПБГУОстатки.КодИСМП"; 
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДатаОстатков", ПараметрыЗапроса.ДатаОстатков);
	Запрос.УстановитьПараметр("Организация"	, ПараметрыЗапроса.Организация);
	Запрос.УстановитьПараметр("КодыИСМП"	, ПараметрыЗапроса.КодыИСМП);
	Запрос.УстановитьПараметр("Номенклатура", ПараметрыЗапроса.Номенклатура);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Возврат РезультатЗапроса;
	
КонецФункции	

Процедура ПроверитьОстаткиКодовИСМП(ДокументСсылка, ТаблицаДвиженийОстаткиКодовИСМП) Экспорт 
	
	Если ТаблицаДвиженийОстаткиКодовИСМП.Количество()>0 Тогда 
	ПараметрыЗапроса = Новый Структура;
	ПараметрыЗапроса.Вставить("ДатаОстатков", ТаблицаДвиженийОстаткиКодовИСМП[0].Период);
	ПараметрыЗапроса.Вставить("Организация"	, ТаблицаДвиженийОстаткиКодовИСМП[0].Организация);
	ПараметрыЗапроса.Вставить("КодыИСМП"	, ТаблицаДвиженийОстаткиКодовИСМП.ВыгрузитьКолонку("КодИСМП"));
	ПараметрыЗапроса.Вставить("Номенклатура", ТаблицаДвиженийОстаткиКодовИСМП.ВыгрузитьКолонку("Номенклатура")); 
	ОстаткиКодовИСМП = ОстаткиКодовМаркировки(ПараметрыЗапроса); 
	Для Каждого СтрокаТаблицы Из ТаблицаДвиженийОстаткиКодовИСМП Цикл 
		Отбор = Новый Структура;
		Отбор.Вставить("Номенклатура"	, СтрокаТаблицы.Номенклатура);
		Отбор.Вставить("КодИСМП"		, СтрокаТаблицы.КодИСМП);
		НайденныеСтроки = ОстаткиКодовИСМП.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() > 0  И НайденныеСтроки[0].Остаток < СтрокаТаблицы.Количество Тогда 
			ТекстОшибки 		= НСтр("ru='В строке %2 списка ""Товары"" по номенклатуре ""%1"" превышен остаток кодов ИСМП на %3 '"); 
			ПревышениеОстатка 	= СтрокаТаблицы.Количество - НайденныеСтроки[0].Остаток;
			ТекстОшибки 		= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, СтрокаТаблицы.Номенклатура, СтрокаТаблицы.НомерСтроки, ПревышениеОстатка);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		ИначеЕсли НайденныеСтроки.Количество() = 0 Тогда 
			ТекстОшибки 		= НСтр("ru='В строке %2 списка ""Товары"" по номенклатуре ""%1"" превышен остаток кодов ИСМП на %3 '"); 
			ПревышениеОстатка 	= СтрокаТаблицы.Количество;
			ТекстОшибки 		= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, СтрокаТаблицы.Номенклатура, СтрокаТаблицы.НомерСтроки, ПревышениеОстатка);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		КонецЕсли;	
	КонецЦикла;	  
	КонецЕсли;
	
КонецПроцедуры	

Функция ВедетсяКонтрольОстатковКодовИСМП(Организация) Экспорт 
	
	ЕстьОбменИСМП = Константы.ИспользоватьОбменИСМПБГУ.Получить();
	Если ЕстьОбменИСМП Тогда 
		НаборНастроек = РегистрыСведений.НастройкиПодключенияИСМПБГУ.СоздатьНаборЗаписей();
		НаборНастроек.Отбор.Организация.Установить(Организация);
		НаборНастроек.Прочитать();
		
		Если НаборНастроек.Количество() > 0 Тогда
			НастройкаПодключения = НаборНастроек[0];
			КонтрольОстатковКодовИСМП = НастройкаПодключения.КонтрольОстатковКодовИСМП;
			Если КонтрольОстатковКодовИСМП Тогда 
				Возврат Истина;
			Иначе
				Возврат Ложь;
			КонецЕсли;
		Иначе 
			Возврат Ложь;
		КонецЕсли;	
	Иначе
		Возврат Ложь
	КонецЕсли;	
	
КонецФункции	

