#Область Маркировка

Функция РазобратьКодМаркировки(ИсходныеДанные) Экспорт
	
	ФормируемыйРезультат = НовыйРезультатРазбораКодаМаркировки();
	
	ДанныеДляРазбора = ДанныеДляРазбораКодаМаркировки(ИсходныеДанные);
	
	РезультатРазбораКодаМолочнойПродукции = РазобратьКодМаркировкиМолочнойПродукции(ДанныеДляРазбора);
	
	Если РезультатРазбораКодаМолочнойПродукции.ЭтоМолочнаяПродукция Тогда
		
		ФормируемыйРезультат.ЭтоМолочнаяПродукция = РезультатРазбораКодаМолочнойПродукции.ЭтоМолочнаяПродукция;
		ФормируемыйРезультат.Вес = РезультатРазбораКодаМолочнойПродукции.Вес;
		
	КонецЕсли;
	
	ПараметрыНормализации = НовыеПараметрыНормализацииКодаМаркировки();
	ПараметрыНормализации.ВзятьИдентификаторыВСкобки = Ложь;
	
	ФормируемыйРезультат.НормализованныйКодМаркировки = НормализоватьКодМаркировки(ДанныеДляРазбора, ПараметрыНормализации);
	
	Возврат ФормируемыйРезультат;
	
КонецФункции 

Функция НовыйРезультатРазбораКодаМаркировки()
	
	РезультатРазбораКодаМаркировки = Новый Структура;
	
	РезультатРазбораКодаМаркировки.Вставить("ЭтоПродукцияИзМеха", Ложь);
	РезультатРазбораКодаМаркировки.Вставить("ЭтоМолочнаяПродукция", Ложь);
	РезультатРазбораКодаМаркировки.Вставить("ЭтоТабачнаяПродукция", Ложь);
	РезультатРазбораКодаМаркировки.Вставить("Вес", 0);
	РезультатРазбораКодаМаркировки.Вставить("КоличествоВУпаковке", 0);
	РезультатРазбораКодаМаркировки.Вставить("МаксимальнаяРозничнаяЦена", 0);
	РезультатРазбораКодаМаркировки.Вставить("НормализованныйКодМаркировки", "");
	
	Возврат РезультатРазбораКодаМаркировки;
	
КонецФункции

Функция НовыйРезультатРазбораКодаМаркировкиМолочнойПродукции()
	
	РезультатРазбораКодаМаркировки = Новый Структура;
	
	РезультатРазбораКодаМаркировки.Вставить("ЭтоМолочнаяПродукция", Ложь);
	РезультатРазбораКодаМаркировки.Вставить("Вес", 0);
	
	Возврат РезультатРазбораКодаМаркировки;
	
КонецФункции

Функция НовыеПараметрыНормализацииКодаМаркировки() Экспорт
	
	ПараметрыНормализации = Новый Структура;
	
	ПараметрыНормализации.Вставить("ВключатьИдентификаторы",     Истина);
	ПараметрыНормализации.Вставить("ВзятьИдентификаторыВСкобки", Истина);
	ПараметрыНормализации.Вставить("ВключатьСрокГодности",       Истина);
	ПараметрыНормализации.Вставить("МаксимальнаяРозничнаяЦена",  0);
	
	Возврат ПараметрыНормализации;
	
КонецФункции

Функция ДанныеДляРазбораКодаМаркировки(ИсходныеДанные)
	
	ДанныеДляРазбора = НовыеДанныеДляРазбораКодаМаркировки();
	
	Если ТипЗнч(ИсходныеДанные) = Тип("Строка") Тогда
		ДанныеДляРазбора.Штрихкод = ИсходныеДанные;
		ДанныеДляРазбора.РезультатРазбораШтрихкода = МенеджерОборудованияМаркировка.РазобратьШтриховойКодТовара(ИсходныеДанные)
	Иначе
		ЗаполнитьЗначенияСвойств(ДанныеДляРазбора, ИсходныеДанные);
	КонецЕсли;
	
	Возврат ДанныеДляРазбора;
	
КонецФункции

Функция НовыеДанныеДляРазбораКодаМаркировки() Экспорт
	
	ДанныеДляРазбора = Новый Структура;
	
	ДанныеДляРазбора.Вставить("Штрихкод", "");
	ДанныеДляРазбора.Вставить("РезультатРазбораШтрихкода", Новый Структура);
	
	Возврат ДанныеДляРазбора;
	
КонецФункции

Функция РазобратьКодМаркировкиМолочнойПродукции(ИсходныеДанные) Экспорт
	
	ФормируемыйРезультат = НовыйРезультатРазбораКодаМаркировкиМолочнойПродукции();
	
	ДанныеДляРазбора = ДанныеДляРазбораКодаМаркировки(ИсходныеДанные);
	
	КодМаркировки = ДанныеДляРазбора.Штрихкод;
	РезультатРазбораБПО = ДанныеДляРазбора.РезультатРазбораШтрихкода;
	
	Если РезультатРазбораБПО.Разобран Тогда
		
		РезультатРазбораПоИдентификаторам = РазобратьКодМаркировкиМолочнойПродукцииПоИдентификаторам(ДанныеДляРазбора);
		
		ФормируемыйРезультат.ЭтоМолочнаяПродукция = РезультатРазбораПоИдентификаторам.ЭтоМолочнаяПродукция;
		ФормируемыйРезультат.Вес = РезультатРазбораПоИдентификаторам.Вес;
		
	ИначеЕсли Не СтрНачинаетсяС(СокрЛП(КодМаркировки), "(") Тогда
		
		ДлинаКодаМаркировки = СтрДлина(КодМаркировки);
		
		Если ДлинаКодаМаркировки = 24 Или ДлинаКодаМаркировки = 30
				Или ДлинаКодаМаркировки = 34 Или ДлинаКодаМаркировки = 40 Тогда
			
			РезультатРазбораБезСкобок = РазобратьКодМаркировкиМолочнойПродукцииБезСкобок(ДанныеДляРазбора);
			
			ФормируемыйРезультат.ЭтоМолочнаяПродукция = РезультатРазбораБезСкобок.ЭтоМолочнаяПродукция;
			ФормируемыйРезультат.Вес = РезультатРазбораБезСкобок.Вес;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ФормируемыйРезультат;
	
КонецФункции

Функция РазобратьКодМаркировкиМолочнойПродукцииПоИдентификаторам(ДанныеДляРазбора)
	
	ФормируемыйРезультат = НовыйРезультатРазбораКодаМаркировкиМолочнойПродукции();
	
	РезультатРазбораБПО = ДанныеДляРазбора.РезультатРазбораШтрихкода;
	
	ЧисловойАлфавит = ЧисловойАлфавит();
	АлфавитКодаМаркировки = АлфавитКодаМаркировки();
	
	Если РезультатРазбораБПО.Разобран Тогда
		
		// Обязательный элемент кода маркировки молочной продукции.
		Идентификатор01 = РезультатРазбораБПО.ДанныеШтрихкода["01"];
		Если Идентификатор01 <> Неопределено
			И СтрДлина(Идентификатор01.Значение) = 14
			И ЭтоСловоПоАлфавиту(Идентификатор01.Значение, ЧисловойАлфавит) Тогда // GTIN
			
			// Обязательный элемент кода маркировки молочной продукции.
			Идентификатор21 = РезультатРазбораБПО.ДанныеШтрихкода["21"];
			Если Идентификатор21 <> Неопределено
					И СтрДлина(Идентификатор21.Значение) = 6
					И ЭтоСловоПоАлфавиту(Идентификатор21.Значение, АлфавитКодаМаркировки) Тогда // Серийный номер
				
				// Необязательный элемент кода маркировки молочной продукции.
				Идентификатор93 = РезультатРазбораБПО.ДанныеШтрихкода["93"];
				Если Идентификатор93 = Неопределено
					Или (СтрДлина(Идентификатор93.Значение) = 4
					И ЭтоСловоПоАлфавиту(Идентификатор93.Значение, АлфавитКодаМаркировки)) Тогда // Код проверки
					
					ФормируемыйРезультат.ЭтоМолочнаяПродукция = Истина;
					
					// Необязательный элемент кода маркировки молочной продукции.
					Идентификатор310 = РезультатРазбораБПО.ДанныеШтрихкода["310"];
					Если Идентификатор310 <> Неопределено
							И СтрДлина(Идентификатор310.Значение) = 7
							И ЭтоСловоПоАлфавиту(Идентификатор310.Значение, АлфавитКодаМаркировки) Тогда // Вес
						
						Если Сред(Идентификатор310.Значение, 4, 1) = "." Тогда
							ЦелаяЧастьВесаСтрокой = Лев(Идентификатор310.Значение, 3);
							ДробнаяЧастьВесаСтрокой = Прав(Идентификатор310.Значение, 3);
							Если ЭтоСловоПоАлфавиту(ЦелаяЧастьВесаСтрокой, ЧисловойАлфавит)
									И ЭтоСловоПоАлфавиту(ДробнаяЧастьВесаСтрокой, ЧисловойАлфавит) Тогда
								
								Вес = Число(Идентификатор310.Значение);
								ФормируемыйРезультат.Вес = Вес;
								
							КонецЕсли;
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ФормируемыйРезультат;
	
КонецФункции

Функция РазобратьКодМаркировкиМолочнойПродукцииБезСкобок(ДанныеДляРазбора)
	
	ФормируемыйРезультат = НовыйРезультатРазбораКодаМаркировкиМолочнойПродукции();
	
	КодМаркировки = ДанныеДляРазбора.Штрихкод;
	
	ДлинаКодаМаркировки = СтрДлина(КодМаркировки);
	
	ЧисловойАлфавит = ЧисловойАлфавит();
	АлфавитКодаМаркировки = АлфавитКодаМаркировки();
	
	ИдентификаторПрименения = Сред(КодМаркировки, 1, 2);
	Если ИдентификаторПрименения = "01" Тогда
		
		// "01" + 14 знаков GTIN
		ЗначениеGTIN = Сред(КодМаркировки, 3, 14);
		Если ЭтоСловоПоАлфавиту(ЗначениеGTIN, ЧисловойАлфавит) Тогда
			
			ИдентификаторПрименения = Сред(КодМаркировки, 17, 2);
			Если ИдентификаторПрименения = "21" Тогда
				
				// "21" + 6 знаков Серийный номер
				ЗначениеСерийныйНомер = Сред(КодМаркировки, 19, 6);
				Если ЭтоСловоПоАлфавиту(ЗначениеСерийныйНомер, АлфавитКодаМаркировки) Тогда
					
					Если ДлинаКодаМаркировки = 24 Тогда
						
						ФормируемыйРезультат.ЭтоМолочнаяПродукция = Истина;
						
					ИначеЕсли ДлинаКодаМаркировки = 30 Или ДлинаКодаМаркировки = 40 Тогда
						
						ИдентификаторПрименения = Сред(КодМаркировки, 25, 2);
						Если ИдентификаторПрименения = "93" Тогда
							
							// "93" + 4 знака код проверки
							ЗначениеКодПроверки = Сред(КодМаркировки, 27, 4);
							Если ЭтоСловоПоАлфавиту(ЗначениеКодПроверки, АлфавитКодаМаркировки) Тогда
								
								Если ДлинаКодаМаркировки = 30 Тогда
									
									ФормируемыйРезультат.ЭтоМолочнаяПродукция = Истина;
									
								ИначеЕсли ДлинаКодаМаркировки = 40 Тогда
									
									ИдентификаторПрименения = Сред(КодМаркировки, 31, 4);
									Если ИдентификаторПрименения = "3103" Тогда
										
										// "3103" + 6 знаков вес
										ЗначениеВес = Сред(КодМаркировки, 35, 6);
										Если ЭтоСловоПоАлфавиту(ЗначениеВес, ЧисловойАлфавит) Тогда
											
											Вес = Число(ЗначениеВес) / 1000;
											
											ФормируемыйРезультат.ЭтоМолочнаяПродукция = Истина;
											ФормируемыйРезультат.Вес = Вес;
											
										КонецЕсли;
										
									КонецЕсли;
									
								КонецЕсли;
								
							КонецЕсли;
							
						КонецЕсли;
						
					ИначеЕсли ДлинаКодаМаркировки = 34 Тогда
						
						ИдентификаторПрименения = Сред(КодМаркировки, 25, 4);
						Если ИдентификаторПрименения = "3103" Тогда
							
							// "3103" + 6 знаков вес
							ЗначениеВес = Сред(КодМаркировки, 29, 6);
							Если ЭтоСловоПоАлфавиту(ЗначениеВес, ЧисловойАлфавит) Тогда
								
								Вес = Число(ЗначениеВес) / 1000;
								
								ФормируемыйРезультат.ЭтоМолочнаяПродукция = Истина;
								ФормируемыйРезультат.Вес = Вес;
								
							КонецЕсли;
							
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ФормируемыйРезультат;
	
КонецФункции

Функция НормализоватьКодМаркировки(ИсходныеДанные, ПараметрыНормализации = Неопределено) Экспорт
	
	НормализованныйКод = "";
	
	ДанныеДляРазбора = ДанныеДляРазбораКодаМаркировки(ИсходныеДанные);
	
	РезультатРазбораБПО = ДанныеДляРазбора.РезультатРазбораШтрихкода;
	
	Если НЕ РезультатРазбораБПО.Разобран ИЛИ ЗначениеЗаполнено(РезультатРазбораБПО.ОписаниеОшибки) Тогда
		
		НормализованныйКод = ДанныеДляРазбора.Штрихкод;
		
	Иначе
		
		Если ПараметрыНормализации = Неопределено Тогда
			ПараметрыНормализации = НовыеПараметрыНормализацииКодаМаркировки();
		КонецЕсли;
		
		ССЦЦ = "";
		ГТИН = "";
		СерийныйНомер = "";
		СрокГодности = "";
		СрокГодностиСкоропортящейсяПродукции = "";
		МаксимальнаяРозничнаяЦена = "";
		
		ИдентификаторССЦЦ = ИдентификаторССЦЦ();
		ДанныеССЦЦ = РезультатРазбораБПО.ДанныеШтрихкода.Получить(ИдентификаторССЦЦ);
		Если ТипЗнч(ДанныеССЦЦ) = Тип("Структура") Тогда
			ССЦЦКодаМаркировки = "";
			ДанныеССЦЦ.Свойство("Значение", ССЦЦКодаМаркировки);
			Если ЗначениеЗаполнено(ССЦЦКодаМаркировки) Тогда
				ССЦЦ = ССЦЦКодаМаркировки;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(РезультатРазбораБПО.GTIN) Тогда
			ГТИН = Строка(РезультатРазбораБПО.GTIN);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(РезультатРазбораБПО.СерийныйНомер) Тогда
			СерийныйНомер = Строка(РезультатРазбораБПО.СерийныйНомер);
		КонецЕсли;
		
		Если ПараметрыНормализации.ВключатьСрокГодности Тогда
			
			Если ТипЗнч(РезультатРазбораБПО.ДанныеШтрихкода) = Тип("Соответствие") Тогда
				
				ИдентификаторСрокаГодности = ИдентификаторСрокаГодности();
				ДанныеСрокаГодности = РезультатРазбораБПО.ДанныеШтрихкода.Получить(ИдентификаторСрокаГодности);
				Если ТипЗнч(ДанныеСрокаГодности) = Тип("Структура") Тогда
					СрокГодностиКодаМаркировки = "";
					ДанныеСрокаГодности.Свойство("Значение", СрокГодностиКодаМаркировки);
					Если ЗначениеЗаполнено(СрокГодностиКодаМаркировки) Тогда
						СрокГодности = СрокГодностиКодаМаркировки;
					КонецЕсли;
				КонецЕсли;
				
				ИдентификаторСрокаГодности = ИдентификаторСрокаГодностиСкоропортящейсяПродукции();
				ДанныеСрокаГодности = РезультатРазбораБПО.ДанныеШтрихкода.Получить(ИдентификаторСрокаГодности);
				Если ТипЗнч(ДанныеСрокаГодности) = Тип("Структура") Тогда
					СрокГодностиКодаМаркировки = "";
					ДанныеСрокаГодности.Свойство("Значение", СрокГодностиКодаМаркировки);
					Если ЗначениеЗаполнено(СрокГодностиКодаМаркировки) Тогда
						СрокГодностиСкоропортящейсяПродукции = СрокГодностиКодаМаркировки;
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПараметрыНормализации.МаксимальнаяРозничнаяЦена) Тогда
			МаксимальнаяРозничнаяЦена = Строка(ПараметрыНормализации.МаксимальнаяРозничнаяЦена);
		КонецЕсли;
		
		ЧастиКодаМаркировки = Новый Массив;
		
		Если ЗначениеЗаполнено(ССЦЦ) Тогда
			
			Если ПараметрыНормализации.ВключатьИдентификаторы Тогда
				ИдентификаторССЦЦ = ИдентификаторССЦЦ();
				Если ПараметрыНормализации.ВзятьИдентификаторыВСкобки Тогда
					ИдентификаторССЦЦ = СтрокаВСкобках(ИдентификаторССЦЦ);
				КонецЕсли;
				ЧастиКодаМаркировки.Добавить(ИдентификаторССЦЦ);
			КонецЕсли;
			
			ЧастиКодаМаркировки.Добавить(ССЦЦ);
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ГТИН) Тогда
			
			Если ПараметрыНормализации.ВключатьИдентификаторы Тогда
				ИдентификаторГТИН = ИдентификаторГТИН();
				Если ПараметрыНормализации.ВзятьИдентификаторыВСкобки Тогда
					ИдентификаторГТИН = СтрокаВСкобках(ИдентификаторГТИН);
				КонецЕсли;
				ЧастиКодаМаркировки.Добавить(ИдентификаторГТИН);
			КонецЕсли;
			
			ЧастиКодаМаркировки.Добавить(ГТИН);
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СерийныйНомер) Тогда
			
			Если ПараметрыНормализации.ВключатьИдентификаторы Тогда
				ИдентификаторСерийногоНомера = ИдентификаторСерийногоНомера();
				Если ПараметрыНормализации.ВзятьИдентификаторыВСкобки Тогда
					ИдентификаторСерийногоНомера = СтрокаВСкобках(ИдентификаторСерийногоНомера);
				КонецЕсли;
				ЧастиКодаМаркировки.Добавить(ИдентификаторСерийногоНомера);
			КонецЕсли;
			
			ЧастиКодаМаркировки.Добавить(СерийныйНомер);
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СрокГодности) Тогда
			
			Если ПараметрыНормализации.ВключатьИдентификаторы Тогда
				ИдентификаторСрокаГодности = ИдентификаторСрокаГодности();
				Если ПараметрыНормализации.ВзятьИдентификаторыВСкобки Тогда
					ИдентификаторСрокаГодности = СтрокаВСкобках(ИдентификаторСрокаГодности);
				КонецЕсли;
				ЧастиКодаМаркировки.Добавить(ИдентификаторСрокаГодности);
			КонецЕсли;
			
			ЧастиКодаМаркировки.Добавить(СрокГодности);
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СрокГодностиСкоропортящейсяПродукции) Тогда
			
			Если ПараметрыНормализации.ВключатьИдентификаторы Тогда
				ИдентификаторСрокаГодности = ИдентификаторСрокаГодностиСкоропортящейсяПродукции();
				Если ПараметрыНормализации.ВзятьИдентификаторыВСкобки Тогда
					ИдентификаторСрокаГодности = СтрокаВСкобках(ИдентификаторСрокаГодности);
				КонецЕсли;
				ЧастиКодаМаркировки.Добавить(ИдентификаторСрокаГодности);
			КонецЕсли;
			
			ЧастиКодаМаркировки.Добавить(СрокГодностиСкоропортящейсяПродукции);
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(МаксимальнаяРозничнаяЦена) Тогда
			
			Если ПараметрыНормализации.ВключатьИдентификаторы Тогда
				ИдентификаторМРЦ = ИдентификаторМРЦ();
				Если ПараметрыНормализации.ВзятьИдентификаторыВСкобки Тогда
					ИдентификаторМРЦ = СтрокаВСкобках(ИдентификаторМРЦ);
				КонецЕсли;
				ЧастиКодаМаркировки.Добавить(ИдентификаторМРЦ);
			КонецЕсли;
			
			ЧастиКодаМаркировки.Добавить(МаксимальнаяРозничнаяЦена);
			
		КонецЕсли;
		
		Если ЧастиКодаМаркировки.Количество() > 0 Тогда
			НормализованныйКод = СтрСоединить(ЧастиКодаМаркировки);
		Иначе
			НормализованныйКод = ДанныеДляРазбора.Штрихкод;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат НормализованныйКод;
	
КонецФункции

