Функция НовыеПараметрыЗапросаКлючаСессии(Организация)
	
	ПараметрыЗапросаКлюча = Новый Структура;
	
	АдресЗапросаПараметровАвторизации = АдресЗапросаПараметровАвторизации();
	АдресЗапросаКлючаСессии = АдресЗапросаКлючаСессии();
	
	ПараметрыЗапросаКлюча.Вставить("Организация",                       Организация);
	
	ПараметрыЗапросаКлюча.Вставить("Адрес",                             "");
	ПараметрыЗапросаКлюча.Вставить("Порт",                              0);
	ПараметрыЗапросаКлюча.Вставить("Таймаут",                           0);
	ПараметрыЗапросаКлюча.Вставить("ИспользоватьЗащищенноеСоединение",  Ложь);
	
	ПараметрыЗапросаКлюча.Вставить("ДатаПоследнегоЗапроса",             '00010101');
	ПараметрыЗапросаКлюча.Вставить("ПредставлениеСервиса",              НСтр("ru = 'ИСМП'"));
	
	ПараметрыЗапросаКлюча.Вставить("АдресЗапросаПараметровАвторизации", АдресЗапросаПараметровАвторизации);
	ПараметрыЗапросаКлюча.Вставить("АдресЗапросаКлючаСессии",           АдресЗапросаКлючаСессии);
	
	Возврат ПараметрыЗапросаКлюча;
	
КонецФункции

Функция ПроверитьОбновитьКлючСессии(ПараметрыЗапросаКлюча, Знач СрокДействия = Неопределено, ОбновлятьКлючСессииНаСервере = Истина)
	
	КлючСессии = ТекущийКлючСессии(ПараметрыЗапросаКлюча, СрокДействия);
	
	ТребуетсяОбновлениеКлючаСессии = (КлючСессии = Неопределено);
	
	Если ТребуетсяОбновлениеКлючаСессии И ОбновлятьКлючСессииНаСервере Тогда
		ОбновлениеКлючаУспешно = ОбновитьКлючСессииНаСервере(ПараметрыЗапросаКлюча);
		Если ОбновлениеКлючаУспешно Тогда
			КлючСессии = ТекущийКлючСессии(ПараметрыЗапросаКлюча);
		КонецЕсли;
	КонецЕсли;
	
	Возврат КлючСессии;
	
КонецФункции

Функция ТекущийКлючСессии(ПараметрыЗапросаКлюча, Знач СрокДействия = Неопределено)
	
	КлючСессии = Неопределено;
	
	ПараметрыКлючаСессии = НовыеПараметрыКлючаСессии();
	
	УстановитьПривилегированныйРежим(Истина);
	НаборКлючей = РегистрыСведений.КлючиСессийИСМПБГУ.СоздатьНаборЗаписей();
	НаборКлючей.Отбор.Организация.Установить(ПараметрыЗапросаКлюча.Организация);
	НаборКлючей.Прочитать();
	Если НаборКлючей.Количество() > 0 Тогда
		СохраненныеДанныеКлюча = НаборКлючей[0];
		ЗаполнитьЗначенияСвойств(ПараметрыКлючаСессии, СохраненныеДанныеКлюча);
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
	
	Если ЗначениеЗаполнено(ПараметрыКлючаСессии.КлючСессии) И ЗначениеЗаполнено(ПараметрыКлючаСессии.СрокДействия) Тогда
		
		Если СрокДействия = Неопределено Тогда
			Таймаут      = ПараметрыЗапросаКлюча.Таймаут;
			СрокДействия = ТекущаяДатаСеанса() + Таймаут;
		КонецЕсли;
		
		Если ПараметрыКлючаСессии.СрокДействия > СрокДействия Тогда
			КлючСессии = ПараметрыКлючаСессии.КлючСессии;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат КлючСессии;
	
КонецФункции

Функция НовыеПараметрыКлючаСессии()
	
	ПараметрыКлючаСессии = Новый Структура;
	
	ПараметрыКлючаСессии.Вставить("КлючСессии",  "");
	ПараметрыКлючаСессии.Вставить("СрокДействия", '00010101');
	
	Возврат ПараметрыКлючаСессии;
	
КонецФункции

Функция ОбновитьКлючСессииНаСервере(ПараметрыЗапроса)
	
	СертификатыДляПодписанияНаСервере = СертификатыДляПодписанияНаСервере();
	Если СертификатыДляПодписанияНаСервере = Неопределено
			Или СертификатыДляПодписанияНаСервере.Сертификаты.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	РезультатЗапроса = ПараметрыАвторизацииИзСервиса(ПараметрыЗапроса);
	Если РезультатЗапроса.ПараметрыАвторизации = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ПараметрыЗапроса.Организация = Неопределено Тогда
		СтрокаСертификата = СертификатыДляПодписанияНаСервере.Сертификаты[0];
	Иначе
		СтрокаСертификата = СертификатыДляПодписанияНаСервере.Сертификаты.Найти(ПараметрыЗапроса.Организация, "Организация");
	КонецЕсли;
	
	Если СтрокаСертификата <> Неопределено Тогда
		
		// Для авторизации требуется прикрепленная подпись
		ПараметрыCMS = ЭлектроннаяПодпись.ПараметрыCMS();
		ПараметрыCMS.Открепленная = Ложь;
		
		МенеджерКриптографии = СертификатыДляПодписанияНаСервере.МенеджерКриптографии;
		
		МенеджерКриптографии.ПарольДоступаКЗакрытомуКлючу = СтрокаСертификата.Пароль;
		
		РезультатПодписания = Подписать(
			РезультатЗапроса.ПараметрыАвторизации.Данные,
			ПараметрыCMS,
			СтрокаСертификата.СертификатКриптографии,
			МенеджерКриптографии);
		
	КонецЕсли;
	
	Если СтрокаСертификата = Неопределено
			Или Не РезультатПодписания.Успех Тогда
		
		Возврат Ложь;
		
	Иначе
		
		Возврат ЗапроситьУстановитьКлючСессии(
			ПараметрыЗапроса,
			РезультатЗапроса.ПараметрыАвторизации,
			РезультатПодписания.Подпись).КлючСессииУстановлен;
		
	КонецЕсли;
	
КонецФункции

Функция ПараметрыАвторизацииИзСервиса(ПараметрыЗапроса)
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("ПараметрыАвторизации", Неопределено);
	ВозвращаемоеЗначение.Вставить("ТекстОшибки",          "");
	
	РезультатОтправкиЗапроса = ПолучитьДанныеИзСервиса(
		ПараметрыЗапроса.АдресЗапросаПараметровАвторизации, Неопределено, ПараметрыЗапроса);
	
	РезультатОбработкиЗапроса = ОбработатьРезультатОтправкиHTTPЗапросаКакJSON(РезультатОтправкиЗапроса);
	
	Если ОбменИСМПБГУКлиентСервер.ЗапросВыполненУспешно(РезультатОбработкиЗапроса) Тогда
		
		ДанныеОтвета = РезультатОбработкиЗапроса.ОтветОбъект;
		
		ПараметрыАвторизации = НовыеПараметрыАвторизации();
		
		ПрочитатьОтветИзСервиса(ДанныеОтвета, "uuid", ПараметрыАвторизации.Идентификатор);
		ПрочитатьОтветИзСервиса(ДанныеОтвета, "data", ПараметрыАвторизации.Данные);
		
		ВозвращаемоеЗначение.ПараметрыАвторизации = ПараметрыАвторизации;
		
	Иначе
		
		ВозвращаемоеЗначение.ТекстОшибки = ТекстОшибкиПоДаннымЗапроса(
			ПараметрыЗапроса.АдресЗапросаПараметровАвторизации,
			РезультатОбработкиЗапроса);
		
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

Функция НовыеПараметрыАвторизации()
	
	ПараметрыАвторизации = Новый Структура;
	
	ПараметрыАвторизации.Вставить("Идентификатор", "");
	ПараметрыАвторизации.Вставить("Данные",        "");
	
	Возврат ПараметрыАвторизации;
	
КонецФункции

Процедура УстановитьКлючСессии(ПараметрыЗапроса, ПараметрыКлючаСессии)
	
	УстановитьПривилегированныйРежим(Истина);
	
	НаборКлючей = РегистрыСведений.КлючиСессийИСМПБГУ.СоздатьНаборЗаписей();
	НаборКлючей.Отбор.Организация.Установить(ПараметрыЗапроса.Организация);
	НаборКлючей.Очистить();
	
	НоваяЗапись = НаборКлючей.Добавить();
	НоваяЗапись.Организация = ПараметрыЗапроса.Организация;
	ЗаполнитьЗначенияСвойств(НоваяЗапись, ПараметрыКлючаСессии);
	
	НаборКлючей.Записать(Истина);
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

