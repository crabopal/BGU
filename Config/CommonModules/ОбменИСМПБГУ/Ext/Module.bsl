Функция СтрокаBase64(ИсходныеДанные)
	
	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(ИсходныеДанные);
	Результат = ОбменИСМПБГУКлиентСервер.ДвоичныеДанныеBase64(ДвоичныеДанные);
	
	Возврат Результат;
	
КонецФункции

Функция ДатаUTC(Знач Дата, ЧасовойПояс = Неопределено, ТолькоДата = Ложь) Экспорт
	
	Если ЧасовойПояс <> Неопределено Тогда
		Дата = УниверсальноеВремя(Дата, ЧасовойПояс);
	КонецЕсли;
	
	Если ТолькоДата Тогда
		Результат = Формат(Дата, "ДФ=yyyy-MM-dd");
	Иначе
		Результат = Формат(Дата, "ДФ=yyyy-MM-ddTЧЧ:мм:сс") + ".000Z";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДатаИзСтрокиUNIX(Значение, Делитель = 1000, ПриводитьКМестномуВремени = Истина)
	
	Значение = '19700101' + Цел(Значение / Делитель);
	
	Если ПриводитьКМестномуВремени Тогда
		Возврат МестноеВремя(Значение);
	Иначе
		Возврат Значение;
	КонецЕсли;
	
КонецФункции

