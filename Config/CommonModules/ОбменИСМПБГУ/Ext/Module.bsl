Функция СохраненнаяНастройкаПодключенияИСМП(Организация)
	
	СохраненнаяНастройкаПодключения = Новый Структура;
	СохраненнаяНастройкаПодключения.Вставить("АдресСервера", "");
	СохраненнаяНастройкаПодключения.Вставить("Таймаут", 0);
	
	НаборНастроекИСМП = РегистрыСведений.НастройкиПодключенияИСМПБГУ.СоздатьНаборЗаписей();
	НаборНастроекИСМП.Отбор.Организация.Установить(Организация);
	НаборНастроекИСМП.Прочитать();
	
	Если НаборНастроекИСМП.Количество() > 0 Тогда
		НастройкаПодключения = НаборНастроекИСМП[0];
		СохраненнаяНастройкаПодключения.АдресСервера = НастройкаПодключения.Адрес;
		СохраненнаяНастройкаПодключения.Таймаут = НастройкаПодключения.Таймаут;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СохраненнаяНастройкаПодключения.АдресСервера) Тогда
		ТекстОшибки = НСтр("ru = 'Не указан адрес сервера ИСМП'");
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Возврат СохраненнаяНастройкаПодключения;
	
КонецФункции

Процедура ЗаполнитьНастройкуПодключенияИСМП(НастройкаПодключения, СохраненнаяНастройка, ДоменСервера = "")
	
	Если ЗначениеЗаполнено(ДоменСервера) Тогда
		ПолныйАдрес = СтрШаблон("%1.%2", ДоменСервера, СохраненнаяНастройка.АдресСервера);
	Иначе
		ПолныйАдрес = СохраненнаяНастройка.АдресСервера;
	КонецЕсли;
	
	НастройкаПодключения.Адрес = ПолныйАдрес;
	НастройкаПодключения.Порт = 443;
	НастройкаПодключения.Таймаут = ?(СохраненнаяНастройка.Таймаут > 0, СохраненнаяНастройка.Таймаут, 60);
	НастройкаПодключения.ИспользоватьЗащищенноеСоединение = Истина;
	
КонецПроцедуры

Функция НоваяНастройкаПодключенияИСМП() Экспорт
	
	НастройкаПодключения = Новый Структура;
	
	НастройкаПодключения.Вставить("Адрес",                            "");
	НастройкаПодключения.Вставить("Порт",                             0);
	НастройкаПодключения.Вставить("Таймаут",                          0);
	НастройкаПодключения.Вставить("ИспользоватьЗащищенноеСоединение", Ложь);
	НастройкаПодключения.Вставить("ДатаПоследнегоЗапроса",           '00010101');
	НастройкаПодключения.Вставить("ИнтервалМеждуЗапросами",           1);
	НастройкаПодключения.Вставить("ПредставлениеСервиса",             НСтр("ru = 'ИСМП'"));
	НастройкаПодключения.Вставить("ФоновоеЗадание",                   Неопределено);
	
	Возврат НастройкаПодключения;
	
КонецФункции

Функция ОперацияСервисаВыполненаУспешно(НаименованиеОперации, РезультатОбработкиЗапроса)
	
	ОперацияВыполненаУспешно = Ложь;
	
	Если НаименованиеОперации = ОбменИСМПБГУКлиентСервер.НаименованиеОперацииВыводИзОборотаКодовМаркировки() Тогда
		ОперацияВыполненаУспешно = ОбменИСМПБГУКлиентСервер.ДокументСозданУспешно(РезультатОбработкиЗапроса);
	ИначеЕсли НаименованиеОперации = ОбменИСМПБГУКлиентСервер.НаименованиеОперацииСодержимоеДокумента() Тогда
		ОперацияВыполненаУспешно = ОбменИСМПБГУКлиентСервер.ЗапросВыполненУспешно(РезультатОбработкиЗапроса);
	Иначе
		ОбработатьНеизвестнуюОперацию();	
	КонецЕсли;
	
	Возврат ОперацияВыполненаУспешно;
	
КонецФункции

Функция ИдентификаторДокументаПоЗапросуСозданияДокумента(РезультатОбработкиЗапроса)
	
	ИдентификаторДокумента = "";
	
	ДанныеОтвета = РезультатОбработкиЗапроса.ТекстВходящегоСообщения;
	
	Если ТипЗнч(ДанныеОтвета) = Тип("Строка") И ЗначениеЗаполнено(ДанныеОтвета) Тогда
		
		ИдентификаторДокумента = ДанныеОтвета;
		
	КонецЕсли;
	
	Возврат ИдентификаторДокумента;
	
КонецФункции

Функция ГТИНПоЕАН(ЕАН, ПроверятьДлину = Истина) Экспорт
	
	ГТИН = "";
	
	ДлинаЕАН = СтрДлина(ЕАН);
	
	Если Не ПроверятьДлину Или ДлинаЕАН = 14 Или ДлинаЕАН = 13 Или ДлинаЕАН = 12 Или ДлинаЕАН = 8 Тогда
		ГТИН = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(ЕАН, 14)
	КонецЕсли;
	
	Возврат ГТИН;
	
КонецФункции

Процедура ОбработатьНеизвестнуюОперацию()
	
	ТекстОшибки = НСтр("ru = 'Неизвестная операция сервиса'");
	ВызватьИсключение ТекстОшибки;
	
КонецПроцедуры

Функция СодержимоеДокументаПоЗапросуСодержимого(РезультатОбработкиЗапроса)
	
	СодержимоеДокумента = НовоеСодержимоеДокумента();
	
	ДанныеОтвета = РезультатОбработкиЗапроса.ОтветОбъект;
	
	Если ТипЗнч(ДанныеОтвета) = Тип("Массив") И ДанныеОтвета.Количество() > 0 Тогда
		
		ДанныеОтветаПоДокументу = ДанныеОтвета[0];
		
		СостояниеСервиса = "";
		ПрочитатьОтветИзСервиса(ДанныеОтветаПоДокументу, "status", СостояниеСервиса);
		СодержимоеДокумента.Статус = СостояниеДокументаПоСостояниюСервиса(СостояниеСервиса);
		
		ОшибкиИзСервиса = Неопределено;
		ПрочитатьОтветИзСервиса(ДанныеОтветаПоДокументу, "errors", ОшибкиИзСервиса);
		Если ТипЗнч(ОшибкиИзСервиса) = Тип("Массив") Тогда
			СодержимоеДокумента.ТекстОшибки = СтрСоединить(ОшибкиИзСервиса, Символы.ПС);
			СодержимоеДокумента.ТекстОшибки = УдалитьНедопустимыеСимволыИзСтроки(СодержимоеДокумента.ТекстОшибки);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СодержимоеДокумента;
	
КонецФункции

