Функция ЭтоСловоПоАлфавиту(Слово, Алфавит) Экспорт
	
	СловоСоответствует = Истина;
	
	ДлинаСлова = СтрДлина(Слово);
	
	НомерПроверяемогоСимвола = 1;
	
	Пока НомерПроверяемогоСимвола < ДлинаСлова Цикл
		
		ПроверяемыйСимвол = Сред(Слово, НомерПроверяемогоСимвола, 1);
		
		Если СтрНайти(Алфавит, ПроверяемыйСимвол) = 0 Тогда
			СловоСоответствует = Ложь;
			Прервать;
		КонецЕсли;
		
		НомерПроверяемогоСимвола = НомерПроверяемогоСимвола + 1;
		
	КонецЦикла;
	
	Возврат СловоСоответствует;
	
КонецФункции

