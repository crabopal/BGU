
#Область ПрограммныйИнтерфейс

Функция ЗапроситьУстановитьКлючСессии(ПараметрыЗапроса, ПараметрыАвторизации, Подпись) Экспорт
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("КлючСессииУстановлен", Ложь);
	ВозвращаемоеЗначение.Вставить("ТекстОшибки",          "");
	
	СвойстваПодписи = Новый Структура("Подпись", Подпись);
	
	ПараметрыЗапросаПоОрганизации = Новый Структура;
	ПараметрыЗапросаПоОрганизации.Вставить("ПараметрыЗапроса",     ПараметрыЗапроса);
	ПараметрыЗапросаПоОрганизации.Вставить("ПараметрыАвторизации", ПараметрыАвторизации);
	ПараметрыЗапросаПоОрганизации.Вставить("СвойстваПодписи",      СвойстваПодписи);
	
	РезультатЗапросаКлючаСессии = КлючСессииИзСервиса(ПараметрыЗапросаПоОрганизации);
	Если РезультатЗапросаКлючаСессии.ПараметрыКлючаСессии <> Неопределено Тогда
		
		УстановитьКлючСессии(
			ПараметрыЗапросаПоОрганизации.ПараметрыЗапроса,
			РезультатЗапросаКлючаСессии.ПараметрыКлючаСессии);
		
		ВозвращаемоеЗначение.КлючСессииУстановлен = Истина;
		
		Возврат ВозвращаемоеЗначение;
		
	Иначе
		
		ВозвращаемоеЗначение.КлючСессииУстановлен = Ложь;
		ВозвращаемоеЗначение.ТекстОшибки          = РезультатЗапросаКлючаСессии.ТекстОшибки;
		
		Возврат ВозвращаемоеЗначение;
		
	КонецЕсли;
	
КонецФункции

Функция КлючСессииИзСервиса(ПараметрыЗапросаПоОрганизации)
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("ПараметрыКлючаСессии", Неопределено);
	ВозвращаемоеЗначение.Вставить("ТекстОшибки",          "");
	
	ТелоЗапроса = Новый Структура;
	ТелоЗапроса.Вставить("uuid", ПараметрыЗапросаПоОрганизации.ПараметрыАвторизации.Идентификатор);
	ТелоЗапроса.Вставить("data", ОбменИСМПБГУКлиентСервер.ДвоичныеДанныеBase64(
		ПодписьИзСвойствПодписи(ПараметрыЗапросаПоОрганизации.СвойстваПодписи)));
	
	РезультатОтправкиЗапроса = ОтправитьДанныеВСервис(
		ПараметрыЗапросаПоОрганизации.ПараметрыЗапроса.АдресЗапросаКлючаСессии, ТелоЗапроса, Неопределено, "POST",
		ПараметрыЗапросаПоОрганизации.ПараметрыЗапроса);
	
	РезультатОбработкиЗапроса = ОбработатьРезультатОтправкиHTTPЗапросаКакJSON(РезультатОтправкиЗапроса);
	
	Если ОбменИСМПБГУКлиентСервер.ЗапросВыполненУспешно(РезультатОбработкиЗапроса) Тогда
		
		ДанныеОтвета = РезультатОбработкиЗапроса.ОтветОбъект;
		
		Токен = "";
		ПрочитатьОтветИзСервиса(ДанныеОтвета, "token", Токен);
		
		СрокДействия = ТекущаяДатаСеанса() + 900; // 15 минут
		РезультатРазбораТокена = РасшифроватьТокенJWT(Токен);
		РезультатРасшифровки = РезультатРазбораТокена.РезультатРасшифровки;
		Если РезультатРасшифровки <> Неопределено Тогда
			Если РезультатРасшифровки.Свойство("exp") Тогда
				СрокДействия = ДатаИзСтрокиUNIX(РезультатРасшифровки.exp, 1);
			КонецЕсли;
		КонецЕсли;
		
		ПараметрыКлючаСессии = НовыеПараметрыКлючаСессии();
		
		ПараметрыКлючаСессии.КлючСессии   = Токен;
		ПараметрыКлючаСессии.СрокДействия = СрокДействия;
		
		ВозвращаемоеЗначение.ПараметрыКлючаСессии = ПараметрыКлючаСессии;
		
	Иначе
		
		ВозвращаемоеЗначение.ТекстОшибки = ТекстОшибкиПоДаннымЗапроса(
			ПараметрыЗапросаПоОрганизации.ПараметрыЗапроса.АдресЗапросаКлючаСессии,
			РезультатОбработкиЗапроса);
		
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

Процедура ВыполнитьОперациюСервиса(ПараметрыОперации, РезультатОперации) Экспорт
	
	НаименованиеОперации = ПараметрыОперации.НаименованиеОперации;
	ИсходныеДанные = ПараметрыОперации.ИсходныеДанные;
	Организация = ПараметрыОперации.Организация;
	РезультатПодписания = НовыйРезультатПодписания();
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Организация = ОбщегоНазначенияБГУ.ОсновнаяОрганизация();
	КонецЕсли;
	
	Если НаименованиеОперации = ОбменИСМПБГУКлиентСервер.НаименованиеОперацииВыводИзОборотаКодовМаркировки() Тогда
		
		ПодготовитьДокументВыводИзОборотаКодовМаркировки(ИсходныеДанные, Организация, РезультатПодписания);
		
		Если Не РезультатПодписания.ПодписаниеУспешно Тогда
			
			РезультатОперации.ТребуетсяПодписание = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ПараметрыЗапросаКлюча = НовыеПараметрыЗапросаКлючаСессии(Организация);
	СохраненнаяНастройка = СохраненнаяНастройкаПодключенияИСМП(Организация);
	ЗаполнитьНастройкуПодключенияИСМП(ПараметрыЗапросаКлюча, СохраненнаяНастройка);
	КлючСессии = ПроверитьОбновитьКлючСессии(ПараметрыЗапросаКлюча);
	
	Если Не ЗначениеЗаполнено(КлючСессии) Тогда
		
		РезультатОперации.ТребуетсяОбновлениеКлючаСессии = Истина;
		
	ИначеЕсли Не РезультатОперации.ТребуетсяПодписание Тогда
		
		НастройкаПодключения = НоваяНастройкаПодключенияИСМП();
		ЗаполнитьНастройкуПодключенияИСМП(НастройкаПодключения, СохраненнаяНастройка);
		
		Если НаименованиеОперации = ОбменИСМПБГУКлиентСервер.НаименованиеОперацииВыводИзОборотаКодовМаркировки() Тогда
			
			ПараметрыЗапросаСервиса = ПараметрыЗапросаВыводаИзОборотаКодовМаркировки(ИсходныеДанные.ТоварнаяГруппа);
			
			АдресЗапроса = АдресЗапросаВыводаИзОборотаКодовМаркировки(ПараметрыЗапросаСервиса);
			
			РезультатЗапроса = ОтправитьДанныеВСервис(АдресЗапроса, РезультатПодписания.ПодготовленныйДокумент,
			КлючСессии, "POST", НастройкаПодключения);
			
			РезультатОперации.ОперацияВыполнялась = Истина;
			
		ИначеЕсли НаименованиеОперации = ОбменИСМПБГУКлиентСервер.НаименованиеОперацииСодержимоеДокумента() Тогда
			
			АдресЗапроса = АдресЗапросаСодержимогоДокумента(ИсходныеДанные);
			
			РезультатЗапроса = ПолучитьДанныеИзСервиса(АдресЗапроса, КлючСессии, НастройкаПодключения);
			
			РезультатОперации.ОперацияВыполнялась = Истина;
			
		Иначе
			
			ОбработатьНеизвестнуюОперацию();
			
		КонецЕсли;
		
		Если РезультатОперации.ОперацияВыполнялась Тогда
			
			РезультатОбработкиЗапроса = ОбработатьРезультатОтправкиHTTPЗапросаКакJSON(РезультатЗапроса);
			
			ЗаполнитьЗначенияСвойств(РезультатОперации, РезультатОбработкиЗапроса);
			
			Если ОперацияСервисаВыполненаУспешно(НаименованиеОперации, РезультатОбработкиЗапроса) Тогда
				
				РезультатОперации.ОперацияВыполненаУспешно = Истина;
				
				Если НаименованиеОперации = ОбменИСМПБГУКлиентСервер.НаименованиеОперацииВыводИзОборотаКодовМаркировки() Тогда
					
					РезультатОперации.РазобранныйОтвет
					= ИдентификаторДокументаПоЗапросуСозданияДокумента(РезультатОбработкиЗапроса);
					
				ИначеЕсли НаименованиеОперации = ОбменИСМПБГУКлиентСервер.НаименованиеОперацииСодержимоеДокумента() Тогда
					
					РезультатОперации.РазобранныйОтвет
					= СодержимоеДокументаПоЗапросуСодержимого(РезультатОбработкиЗапроса);
					
				Иначе
					
					ОбработатьНеизвестнуюОперацию();
					
				КонецЕсли;
				
			Иначе
				
				РезультатОперации.ОперацияВыполненаСВременнойОшибкой = ЭтоВременнаяОшибка(РезультатОбработкиЗапроса);
				
				Если РезультатОбработкиЗапроса.КодСостояния = 401 Тогда
					РезультатОперации.ТребуетсяОбновлениеКлючаСессии = Истина;
				Иначе
					РезультатОперации.ТекстСообщения = ТекстОшибкиПоДаннымЗапроса(АдресЗапроса, РезультатОбработкиЗапроса);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если РезультатОперации.ТребуетсяОбновлениеКлючаСессии Или РезультатОперации.ТребуетсяПодписание Тогда
		
		Сертификаты = СертификатыПользователяПоОрганизации(Организация);
		
		Если Сертификаты.Количество() = 0 Тогда
			
			РезультатОперации.ТекстСообщения = ТекстСообщенияНетСертификатов();
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если РезультатОперации.ТребуетсяОбновлениеКлючаСессии И Сертификаты.Количество() > 0 Тогда
		
		РезультатЗапросаПараметровАвторизации = ПараметрыАвторизацииИзСервиса(ПараметрыЗапросаКлюча);
		
		Если ЗначениеЗаполнено(РезультатЗапросаПараметровАвторизации.ТекстОшибки) Тогда
			
			РезультатОперации.ТекстСообщения = РезультатЗапросаПараметровАвторизации.ТекстОшибки;
			
		Иначе
			
			ПараметрыОбновленияКлюча = НовыеПараметрыОбновленияКлючаСессии();
			
			ПараметрыОбновленияКлюча.ПараметрыЗапросаКлючаСессии = ПараметрыЗапросаКлюча;
			ПараметрыОбновленияКлюча.ПараметрыАвторизации = РезультатЗапросаПараметровАвторизации.ПараметрыАвторизации;
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ПараметрыОбновленияКлюча.Сертификаты, Сертификаты);
			
			РезультатОперации.ПараметрыОбновленияКлючаСессии = ПараметрыОбновленияКлюча;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если РезультатОперации.ТребуетсяПодписание И Сертификаты.Количество() > 0 Тогда
		
		ПараметрыПодписания = НовыеПараметрыПодписания();
		
		ПараметрыПодписания.ДанныеНаПодпись = РезультатПодписания.ДанныеНаПодпись;
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ПараметрыПодписания.Сертификаты, Сертификаты);
		
		РезультатОперации.ПараметрыПодписания = ПараметрыПодписания;
		
	КонецЕсли;
	
КонецПроцедуры  

Функция СостояниеДокументаПоСостояниюСервиса(Знач ЗначениеСервиса, ПредставленияСервиса = Неопределено) Экспорт
	
	ЗначениеПользователя = Перечисления.СтатусыДокументовИСМПБГУ.ПустаяСсылка();
	
	Если ЗначениеЗаполнено(ЗначениеСервиса) Тогда
		
		Если ПредставленияСервиса = Неопределено Тогда
			ПредставленияСервиса = ОбменИСМПБГУКлиентСерверПовтИсп.ПредставленияСостоянийДокументаСервиса();
		КонецЕсли;
		
		ЗначениеСервиса = ВРег(ЗначениеСервиса);
		
		ПредставленияСервиса.Свойство(ЗначениеСервиса, ЗначениеПользователя);
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЗначениеПользователя) Тогда
		ЗначениеПользователя = НеизвестноеСостояниеДокумента();
	КонецЕсли;
	
	Возврат ЗначениеПользователя;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Общее

Функция НовыйРезультатПодписания()
	
	РезультатПодписания = Новый Структура;
	РезультатПодписания.Вставить("ДанныеНаПодпись",        "");
	РезультатПодписания.Вставить("ПодготовленныйДокумент", "");
	РезультатПодписания.Вставить("ПодписаниеУспешно",      Ложь);
	
	Возврат РезультатПодписания;
	
КонецФункции

Функция НовоеСодержимоеДокумента()
	
	СодержимоеДокумента = Новый Структура;
	
	СодержимоеДокумента.Вставить("Статус", НеизвестноеСостояниеДокумента());
	СодержимоеДокумента.Вставить("ТекстОшибки", "");
	
	Возврат СодержимоеДокумента;
	
КонецФункции  

Функция НеизвестноеСостояниеДокумента()
	
	Возврат Перечисления.СтатусыДокументовИСМПБГУ.Неизвестно;
	
КонецФункции

#КонецОбласти

#Область ДанныеДляСервиса

Процедура ПодготовитьДокументВыводИзОборотаКодовМаркировки(ИсходныеДанные, Организация, РезультатПодписания)
	
	ДанныеДокумента = Новый Структура;
	
	ТипДокумента = "MANUAL";
	Если ИсходныеДанные.ЭтоОСУ Тогда
		КодТипаДокумента = "LK_GTIN_RECEIPT";
	Иначе
		КодТипаДокумента = "LK_RECEIPT";
	КонецЕсли;
	ДанныеВыводаИзОборотаBase64 = "";
	ПодписанныеДанныеВыводаИзОборотаBase64 = "";
	
	Если ЗначениеЗаполнено(ИсходныеДанные.ТелоДокумента) И ЗначениеЗаполнено(ИсходныеДанные.ПодписьДокумента) Тогда
		
		ДанныеВыводаИзОборотаBase64 = СтрокаBase64(ИсходныеДанные.ТелоДокумента);
		ПодписанныеДанныеВыводаИзОборотаBase64 = ИсходныеДанные.ПодписьДокумента;
		
		РезультатПодписания.ДанныеНаПодпись = ИсходныеДанные.ТелоДокумента;
		РезультатПодписания.ПодписаниеУспешно = Истина;
		
	Иначе
		
		ДанныеВыводаИзОборотаJSON = ДанныеВыводаИзОборотаJSON(ИсходныеДанные);
		ДанныеВыводаИзОборотаBase64 = СтрокаBase64(ДанныеВыводаИзОборотаJSON);
		
		РезультатПодписания.ДанныеНаПодпись = ДанныеВыводаИзОборотаJSON;
		
		РезультатРаботыСПодписью = ПодписатьОткрепленнойПодписью(Организация, РезультатПодписания.ДанныеНаПодпись);
		
		Если РезультатРаботыСПодписью.Успех Тогда
			
			ПодписанныеДанные = РезультатРаботыСПодписью.Подпись;
			ПодписанныеДанныеВыводаИзОборотаBase64 = ОбменИСМПБГУКлиентСервер.ДвоичныеДанныеBase64(ПодписанныеДанные);
			
			РезультатПодписания.ПодписаниеУспешно = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ДанныеДокумента.Вставить("document_format",  ТипДокумента);
	ДанныеДокумента.Вставить("product_document", ДанныеВыводаИзОборотаBase64);
	ДанныеДокумента.Вставить("signature",        ПодписанныеДанныеВыводаИзОборотаBase64);
	ДанныеДокумента.Вставить("type",             КодТипаДокумента);
	
	РезультатПодписания.ПодготовленныйДокумент = ДанныеДокумента;
	
КонецПроцедуры

Функция ПричинаВыводаСервисаПоПричинеВывода(Знач ЗначениеПользователя, ПредставленияСервиса = Неопределено) Экспорт 
	
	ЗначениеСервиса = "";
	
	Если ЗначениеЗаполнено(ЗначениеПользователя) Тогда
		
		Если ПредставленияСервиса = Неопределено Тогда
			ПредставленияСервиса = ОбменИСМПБГУКлиентСерверПовтИсп.ПредставленияПричинВыводаИзОборотаСервиса();
		КонецЕсли;
		
		Для Каждого ЭлементСтруктуры Из ПредставленияСервиса Цикл
			
			Если ЭлементСтруктуры.Значение = ЗначениеПользователя Тогда
				ЗначениеСервиса = ЭлементСтруктуры.Ключ;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ЗначениеСервиса;
	
КонецФункции

Функция ДанныеВыводаИзОборотаJSON(ИсходныеДанные)
	
	ДанныеВыводаИзОборота = Новый Структура;
	
	ДанныеКодовМаркировки = Новый Массив;
	
	НормализованныеКоды = Новый Массив;
	СоответствиеКодов = Новый Соответствие;
	СоответствиеЦен = Новый Соответствие;
	
	Если Не ИсходныеДанные.ЭтоОСУ Тогда
		Если ИсходныеДанные.ЭтоФасовка Тогда
			СформироватьНормализованныеКодыМаркировки(ИсходныеДанные.КодыМаркировки, НормализованныеКоды, СоответствиеКодов, СоответствиеЦен);
		Иначе
			СформироватьНормализованныеКодыМаркировки(ИсходныеДанные.КодыМаркировки, НормализованныеКоды, СоответствиеКодов);
		КонецЕсли;
	КонецЕсли;
	
	Если Не ИсходныеДанные.ЭтоОСУ Тогда
		
		Для Каждого НормализованныйКод Из НормализованныеКоды Цикл
			
			ДанныеКодаМаркировки = Новый Структура;
			ДанныеКодаМаркировки.Вставить("cis", НормализованныйКод);
			
			Если ИсходныеДанные.ЭтоФасовка Тогда
				ЦеныНормализованногоКода = СоответствиеЦен[НормализованныйКод];
				Если ТипЗнч(ЦеныНормализованногоКода) = Тип("Массив")
					И ЦеныНормализованногоКода.Количество() > 0 Тогда
					ЦенаНормализованногоКода = ЦеныНормализованногоКода[0];
					ЦенаВФорматеСервиса = ЦенаНормализованногоКода * 100; // Указывается в копейках с учетом НДС
					ДанныеКодаМаркировки.Вставить("product_cost", ЦенаВФорматеСервиса);
				КонецЕсли;
			КонецЕсли;
			
			ДанныеКодовМаркировки.Добавить(ДанныеКодаМаркировки);
			
		КонецЦикла;
		
	Иначе
		
		Для Каждого ИсходныеДанныеТовара Из ИсходныеДанные.Товары Цикл
			
			ШтрихкодВФорматеГТИН14 = ГТИНПоЕАН(ИсходныеДанныеТовара.Штрихкод, Ложь); 
			ВесВГраммах = Окр(1000 * ИсходныеДанныеТовара.Вес);
			
			ДанныеТовара = Новый Структура;
			ДанныеТовара.Вставить("gtin", ШтрихкодВФорматеГТИН14);
			ДанныеТовара.Вставить("gtin_quantity", ИсходныеДанныеТовара.Количество);
			Если ВесВГраммах > 0 Тогда
				ДанныеТовара.Вставить("gtin_weight", ВесВГраммах);
			КонецЕсли;
			
			ДанныеКодовМаркировки.Добавить(ДанныеТовара);
			
		КонецЦикла;
		
	КонецЕсли;
	
	ДатаВФорматеСервиса = ДатаUTC(ИсходныеДанные.ДатаДокумента,, Истина);
	ПричинаВыводаСервиса = ПричинаВыводаСервисаПоПричинеВывода(ИсходныеДанные.Причина);
	ТипДокументаВыводаИзОборотаСервиса = "OTHER";
	НаименованиеДокументаВыводаИзОборотаСервиса = НСтр("ru = 'Вывод марок из оборота'");
	
	ДанныеВыводаИзОборота.Вставить("inn",                          ИсходныеДанные.ИННОрганизации);
	ДанныеВыводаИзОборота.Вставить("buyer_inn",                    ИсходныеДанные.ИННПокупателя);
	ДанныеВыводаИзОборота.Вставить("kpp",                          ИсходныеДанные.КППТорговойТочки);
	ДанныеВыводаИзОборота.Вставить("fias_id",                      ИсходныеДанные.ИдентификаторФИАС);
	ДанныеВыводаИзОборота.Вставить("action",                       ПричинаВыводаСервиса);
	ДанныеВыводаИзОборота.Вставить("action_date",                  ДатаВФорматеСервиса);
	ДанныеВыводаИзОборота.Вставить("document_type",                ТипДокументаВыводаИзОборотаСервиса);
	ДанныеВыводаИзОборота.Вставить("document_number",              ИсходныеДанные.НомерДокумента);
	ДанныеВыводаИзОборота.Вставить("document_date",                ДатаВФорматеСервиса);
	ДанныеВыводаИзОборота.Вставить("primary_document_custom_name", НаименованиеДокументаВыводаИзОборотаСервиса);
	ДанныеВыводаИзОборота.Вставить("products",                     ДанныеКодовМаркировки);
	
	ДанныеВыводаИзОборотаJSON = ОбъектВТекстJSON(ДанныеВыводаИзОборота, Истина);
	
	Возврат ДанныеВыводаИзОборотаJSON;
	
КонецФункции 

Процедура СформироватьНормализованныеКодыМаркировки(ИсходныеДанные, НормализованныеКоды, СоответствиеКодов = Неопределено, СоответствиеЦен = Неопределено)
	
	Для Каждого ОбрабатываемыйЭлемент Из ИсходныеДанные Цикл
		
		ИсходныйШтрихкод = ОбрабатываемыйЭлемент.Штрихкод;
		Если ЗначениеЗаполнено(ИсходныйШтрихкод) Тогда
			
			РезультатРазбора = РазобратьКодМаркировки(ИсходныйШтрихкод);
			
			НормализованныйКодМаркировки = РезультатРазбора.НормализованныйКодМаркировки;
			Если ЗначениеЗаполнено(НормализованныйКодМаркировки) Тогда
				
				Если НормализованныеКоды.Найти(НормализованныйКодМаркировки) = Неопределено Тогда
					НормализованныеКоды.Добавить(НормализованныйКодМаркировки);
					Если ТипЗнч(СоответствиеКодов) = Тип("Соответствие") Тогда
						СоответствиеКодов.Вставить(НормализованныйКодМаркировки, Новый Массив);
					КонецЕсли;
					Если ТипЗнч(СоответствиеЦен) = Тип("Соответствие") Тогда
						СоответствиеЦен.Вставить(НормализованныйКодМаркировки, Новый Массив);
					КонецЕсли;
				КонецЕсли;
				
				Если ТипЗнч(СоответствиеКодов) = Тип("Соответствие") Тогда
					СоответствиеКодов[НормализованныйКодМаркировки].Добавить(ИсходныйШтрихкод);
				КонецЕсли;
				Если ТипЗнч(СоответствиеЦен) = Тип("Соответствие") Тогда
					СоответствиеЦен[НормализованныйКодМаркировки].Добавить(ОбрабатываемыйЭлемент.Цена);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПараметрыЗапросаВыводаИзОборотаКодовМаркировки(ТоварнаяГруппа)
	
	ПараметрыЗапросаСервиса = "";
	
	ИмяПараметра = ИмяПараметраТоварнаяГруппа();
	ЗначениеПараметра = ЗначениеПараметраТоварнаяГруппа(ТоварнаяГруппа);
	ЗначениеПараметраВМассиве = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ЗначениеПараметра);
	ДобавитьКоллекциюВПараметрыЗапроса(ПараметрыЗапросаСервиса, ИмяПараметра, ЗначениеПараметраВМассиве);
	
	Возврат ПараметрыЗапросаСервиса;
	
КонецФункции

Функция ИмяПараметраТоварнаяГруппа()
	
	Возврат "pg";
	
КонецФункции

Функция ЗначениеПараметраТоварнаяГруппа(ТоварнаяГруппа)
	
	ЗначениеПараметра = НРег(ТоварнаяГруппаСервисаПоТоварнойГруппе(ТоварнаяГруппа));
	
	Возврат ЗначениеПараметра;
	
КонецФункции

Функция ТоварнаяГруппаСервисаПоТоварнойГруппе(Знач ЗначениеПользователя, ПредставленияСервисаИСМП = Неопределено)
	
	ЗначениеСервиса = "";
	
	Если ЗначениеЗаполнено(ЗначениеПользователя) Тогда
		
		Если ПредставленияСервисаИСМП = Неопределено Тогда
			ПредставленияСервисаИСМП = ОбменИСМПБГУКлиентСерверПовтИсп.ПредставленияТоварныхГруппСервиса();
		КонецЕсли;
		
		Для Каждого ЭлементСтруктуры Из ПредставленияСервисаИСМП Цикл
			
			Если ЭлементСтруктуры.Значение = ЗначениеПользователя Тогда
				ЗначениеСервиса = ЭлементСтруктуры.Ключ;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЗначениеСервиса = "" Тогда 
		Если ЗначениеПользователя = ПредопределенноеЗначение("Перечисление.ВидыМаркированнойПродукцииБПО.СоковаяПродукция") Тогда
			ЗначениеСервиса = "SOFTDRINKS";
		ИначеЕсли ЗначениеПользователя = ПредопределенноеЗначение("Перечисление.ВидыМаркированнойПродукцииБПО.МедицинскиеИзделия") Тогда
			ЗначениеСервиса = "WHEELCHAIRS";
		ИначеЕсли ЗначениеПользователя = ПредопределенноеЗначение("Перечисление.ВидыМаркированнойПродукцииБПО.КреслаКоляски") Тогда
			ЗначениеСервиса = "WHEELCHAIRS";
		ИначеЕсли ЗначениеПользователя = ПредопределенноеЗначение("Перечисление.ТипыМаркировкиККТ.ОбувныеТовары") Тогда
			ЗначениеСервиса = "SHOES";	
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат ЗначениеСервиса;
	
КонецФункции

#КонецОбласти   

#Область Подписание

Функция ПодписатьОткрепленнойПодписью(Организация, ДанныеНаПодпись)
	
	ВозвращаемоеЗначение = НовыйРезультатРаботыСЭлектроннойПодписью();
	
	СертификатыДляПодписанияНаСервере = СертификатыДляПодписанияНаСервере();
	Если СертификатыДляПодписанияНаСервере <> Неопределено
			И СертификатыДляПодписанияНаСервере.Сертификаты.Количество() > 0 Тогда
		
		Если Организация = Неопределено Тогда
			СтрокаСертификата = СертификатыДляПодписанияНаСервере.Сертификаты[0];
		Иначе
			СтрокаСертификата = СертификатыДляПодписанияНаСервере.Сертификаты.Найти(Организация, "Организация");
		КонецЕсли;
		
		Если СтрокаСертификата <> Неопределено Тогда
			
			// Для подписания документов требуется открепленная подпись
			ПараметрыCMS = ЭлектроннаяПодпись.ПараметрыCMS();
			ПараметрыCMS.Открепленная = Истина;
			
			МенеджерКриптографии = СертификатыДляПодписанияНаСервере.МенеджерКриптографии;
			
			МенеджерКриптографии.ПарольДоступаКЗакрытомуКлючу = СтрокаСертификата.Пароль;
			
			ВозвращаемоеЗначение = Подписать(
				ДанныеНаПодпись,
				ПараметрыCMS,
				СтрокаСертификата.СертификатКриптографии,
				МенеджерКриптографии);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

Функция Подписать(ДанныеДляПодписания, ПараметрыCMS, СертификатКриптографии, МенеджерКриптографии)
	
	ВозвращаемоеЗначение = НовыйРезультатРаботыСЭлектроннойПодписью();
	
	Попытка
		
		Подпись = ЭлектроннаяПодписьСлужебный.ПодписатьCMS(
			ДанныеДляПодписания,
			ПараметрыCMS,
			СертификатКриптографии,
			МенеджерКриптографии);
		
		ВозвращаемоеЗначение.Успех   = Истина;
		ВозвращаемоеЗначение.Подпись = Подпись;
		
	Исключение
		
		ВозвращаемоеЗначение.Успех       = Ложь;
		ВозвращаемоеЗначение.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		
	КонецПопытки;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

Функция НовыйРезультатРаботыСЭлектроннойПодписью()
	
	РезультатРаботыСПодписью = Новый Структура;
	
	РезультатРаботыСПодписью.Вставить("Успех", Ложь);
	РезультатРаботыСПодписью.Вставить("Подпись", "");
	РезультатРаботыСПодписью.Вставить("ТекстОшибки", "");
	
	Возврат РезультатРаботыСПодписью;
	
КонецФункции

Функция СертификатыДляПодписанияНаСервере()
	
	СертификатыДляПодписанияНаСервере = Неопределено;
	
	ЕстьПравоЧтения = ПравоДоступа("Чтение", Метаданные.Справочники.СертификатыКлючейЭлектроннойПодписиИШифрования);
	
	Если ЕстьПравоЧтения Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	НастройкиПодключенияИСМПБГУ.Организация          КАК Организация,
		|	НастройкиПодключенияИСМПБГУ.Сертификат           КАК Сертификат,
		|	НастройкиПодключенияИСМПБГУ.Сертификат.Отпечаток КАК Отпечаток
		|ИЗ
		|	РегистрСведений.НастройкиПодключенияИСМПБГУ КАК НастройкиПодключенияИСМПБГУ
		|ГДЕ
		|	НастройкиПодключенияИСМПБГУ.Сертификат <> ЗНАЧЕНИЕ(Справочник.СертификатыКлючейЭлектроннойПодписиИШифрования.ПустаяСсылка)
		|";
		
		РезультатЗапросаСертификатов = Запрос.Выполнить();
		
		Если Не РезультатЗапросаСертификатов.Пустой() Тогда
			
			ДанныеСертификатов = РезультатЗапросаСертификатов.Выгрузить();
			
			СертификатыОрганизацийДляОбменаНаСервере = Новый ТаблицаЗначений;
			СертификатыОрганизацийДляОбменаНаСервере.Колонки.Добавить("Организация");
			СертификатыОрганизацийДляОбменаНаСервере.Колонки.Добавить("Сертификат");
			СертификатыОрганизацийДляОбменаНаСервере.Колонки.Добавить("Отпечаток");
			СертификатыОрганизацийДляОбменаНаСервере.Колонки.Добавить("СертификатКриптографии");
			СертификатыОрганизацийДляОбменаНаСервере.Колонки.Добавить("Пароль");
			
			Для Каждого ДанныеСертификата Из ДанныеСертификатов Цикл
				
				Пароль = ПарольКСертификату(ДанныеСертификата.Сертификат);
				
				СертификатКриптографии = ЭлектроннаяПодписьСлужебный.ПолучитьСертификатПоОтпечатку(ДанныеСертификата.Отпечаток, Ложь, Ложь);
				Если СертификатКриптографии = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				СтрокаТЧ = СертификатыОрганизацийДляОбменаНаСервере.Добавить();
				СтрокаТЧ.Организация            = ДанныеСертификата.Организация;
				СтрокаТЧ.Сертификат             = ДанныеСертификата.Сертификат;
				СтрокаТЧ.Отпечаток              = ДанныеСертификата.Отпечаток;
				СтрокаТЧ.СертификатКриптографии = СертификатКриптографии;
				Если Пароль <> Неопределено Тогда
					СтрокаТЧ.Пароль = Пароль;
				Иначе
					СтрокаТЧ.Пароль = "";
				КонецЕсли;
				
			КонецЦикла;
			
			МенеджерКриптографии = ЭлектроннаяПодпись.МенеджерКриптографии("Подписание", Ложь);
			
			СертификатыДляПодписанияНаСервере = Новый Структура;
			СертификатыДляПодписанияНаСервере.Вставить("Сертификаты",          СертификатыОрганизацийДляОбменаНаСервере);
			СертификатыДляПодписанияНаСервере.Вставить("МенеджерКриптографии", МенеджерКриптографии);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СертификатыДляПодписанияНаСервере;
	
КонецФункции

Функция ПарольКСертификату(Сертификат)
	
	СохраненныйПароль = Неопределено;
	
	Если ЗначениеЗаполнено(Сертификат)
			И ПравоДоступа("Редактирование", Метаданные.Справочники.СертификатыКлючейЭлектроннойПодписиИШифрования) Тогда
		
		ДанныеВсехПаролей = Неопределено;
		
		УстановитьПривилегированныйРежим(Истина);
		ДанныеВсехПаролей = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Сертификат, "ПаролиСертификатов");
		УстановитьПривилегированныйРежим(Ложь);
		
		Если ТипЗнч(ДанныеВсехПаролей) = Тип("Соответствие") Тогда
			ПустойПользователь = Справочники.Пользователи.ПустаяСсылка();
			СохраненныйПароль = ДанныеВсехПаролей.Получить(ПустойПользователь);
			Если Не ЗначениеЗаполнено(СохраненныйПароль) Тогда
				ТекущийПользователь = Пользователи.ТекущийПользователь();
				СохраненныйПароль = ДанныеВсехПаролей.Получить(ТекущийПользователь);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СохраненныйПароль;
	
КонецФункции

Функция ПодписьИзСвойствПодписи(ВходящиеДанные)
	
	Если ТипЗнч(ВходящиеДанные) = Тип("Строка") Тогда
		СвойстваПодписи = ПолучитьИзВременногоХранилища(ВходящиеДанные);
	Иначе
		СвойстваПодписи = ВходящиеДанные;
	КонецЕсли;
	
	Если ТипЗнч(СвойстваПодписи) = Тип("Структура") Тогда
		Подпись = СвойстваПодписи.Подпись;
	Иначе
		Подпись = "";
	КонецЕсли;
	
	Возврат Подпись;
	
КонецФункции

Функция СертификатыПользователяПоОрганизации(Организация)
	
	Сертификаты = Новый Массив;
	
	ЕстьПравоЧтения = ПравоДоступа("Чтение", Метаданные.Справочники.СертификатыКлючейЭлектроннойПодписиИШифрования);
	
	Если ЕстьПравоЧтения Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Сертификаты.Ссылка КАК Сертификат
		|ИЗ
		|	Справочник.СертификатыКлючейЭлектроннойПодписиИШифрования КАК Сертификаты
		|ГДЕ
		|	НЕ Сертификаты.ПометкаУдаления
		|	И
		|	Сертификаты.Организация = &Организация
		|	И
		|	Сертификаты.ДействителенДо > &ТекущаяДата
		|	И
		|	(
		|		Сертификаты.Пользователь = &Пользователь
		|		ИЛИ
		|		Сертификаты.Пользователь = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
		|	)
		|";
		
		Запрос.УстановитьПараметр("Организация",  Организация);
		Запрос.УстановитьПараметр("ТекущаяДата",  ТекущаяДатаСеанса());
		Запрос.УстановитьПараметр("Пользователь", Пользователи.ТекущийПользователь());
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Сертификаты.Добавить(Выборка.Сертификат);
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Сертификаты;
	
КонецФункции

