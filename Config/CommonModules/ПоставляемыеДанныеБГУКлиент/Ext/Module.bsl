
#Область СлужебныеПроцедурыИФункции

Процедура ОткрытьФормуЗагрузкиПоставляемыхДанных(Стр, ФормаВладелец) Экспорт
	
	ИмяФормы = "";
	
	Если Стр.ВидДанных = "БюджКлассификация"
		ИЛИ Стр.ВидДанных = "Classifiers" Тогда
		
		ПараметрОткрытия = Стр;
		ИмяФормы = "Обработка.ПомощникОбновленияБюджетнойКлассификации.Форма";
		
	ИначеЕсли Стр.ВидДанных = "КомплектОтчГосУчр" Тогда
		
		ПараметрОткрытия = Стр;
		ИмяФормы = "Обработка.ИмпортКейса.Форма";
		
	ИначеЕсли Стр.ВидДанных = "ФорматБанкиКазна" Тогда	
		
		ПараметрОткрытия = Стр;
		ИмяФормы = "Обработка.ПомощникЗагрузкиФорматовОбменаБанкиКС.Форма.ФормаПомощникаЗагрузки";
		
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ИмяФормы) Тогда
	
		ОткрытьФорму(ИмяФормы, ПараметрОткрытия, ФормаВладелец);
		
	КонецЕсли;	
	
		
КонецПроцедуры	

#КонецОбласти

