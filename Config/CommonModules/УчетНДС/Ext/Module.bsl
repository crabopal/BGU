	|	ВЫРАЗИТЬ(&Контрагент КАК Справочник.Контрагенты)								КАК Контрагент,
	|	ВЫРАЗИТЬ(&Грузоотправитель КАК Справочник.Контрагенты)							КАК Грузоотправитель,
	|	ВЫРАЗИТЬ(&Грузополучатель КАК Справочник.Контрагенты)							КАК Грузополучатель,
	|	ВЫРАЗИТЬ(&ПричинаНалогообложения КАК Перечисление.ПричиныНалогообложенияНДС)	КАК ПричинаНалогообложения
