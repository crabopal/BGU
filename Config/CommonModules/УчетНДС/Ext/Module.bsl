Процедура ЗаполнитьОтчетНДСФормаОтчета2015Кв1(ПараметрыОтчета, Контейнер) Экспорт
	
	Перем ТаблицаРасшифровки;
	
	// Отбор по организации
	СписокОрганизаций = Новый СписокЗначений();
	СписокОрганизаций.Добавить(ПараметрыОтчета["Организация"]);
	ЭтоОбособленноеПодразделение = ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
		ПараметрыОтчета["Организация"], "ГоловнаяОрганизация"));
	Если НЕ ЭтоОбособленноеПодразделение Тогда
		Для Каждого ЭлементСписка Из ПараметрыОтчета["ГруппаОрганизаций"] Цикл
			ВсяОрганизация = Справочники.Организации.ВсяОрганизация(ЭлементСписка.Значение);
			Для Каждого Организация Из ВсяОрганизация Цикл
				СписокОрганизаций.Добавить(Организация);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	ПараметрыОтчета.Вставить("СписокОрганизаций", СписокОрганизаций);
	
	УчетнаяПолитика = Справочники.Организации.ПолучитьУчетнуюПолитику(
		ПараметрыОтчета["Организация"],
		ПараметрыОтчета["мДатаКонцаПериодаОтчета"]);
		
	СледуетЗаполнитьРаздел3 = НЕ (
		УчетнаяПолитика["СистемаНалогообложения"] = Перечисления.СистемыНалогообложения.Упрощенная
		ИЛИ УчетнаяПолитика["НДСПрименяетсяОсвобождениеОтУплаты"]);
	
	ЗаполнитьРаздел1_2015Кв1(Контейнер, ТаблицаРасшифровки, ПараметрыОтчета);
	ЗаполнитьРаздел2_2015Кв1(Контейнер, ТаблицаРасшифровки, ПараметрыОтчета);
	
	Если СледуетЗаполнитьРаздел3 Тогда
		ЗаполнитьРаздел3_2015Кв1(Контейнер, ТаблицаРасшифровки, ПараметрыОтчета);
	КонецЕсли;
	
	// СегментацияДанныхДекларации
	РегламентированнаяОтчетность.УдалитьДополнительныеФайлыДекларацииНДС(ПараметрыОтчета["Декларация"]);
	
	ЗаполнитьРаздел8_2015Кв1(Контейнер, ТаблицаРасшифровки, ПараметрыОтчета);
	ЗаполнитьРазделы9и12_2015Кв1(Контейнер, ТаблицаРасшифровки, ПараметрыОтчета);
	
	ПоместитьВоВременноеХранилище(Контейнер,			ПараметрыОтчета.АдресВоВременномХранилище);
    ПоместитьВоВременноеХранилище(ТаблицаРасшифровки,	ПараметрыОтчета.АдресВременногоХранилищаРасшифровки);
	
КонецПроцедуры

Процедура ЗаполнитьРаздел1_2015Кв1(Контейнер, ТаблицаРасшифровки, ПараметрыОтчета)
	
	Раздел1 = Контейнер.Раздел1;
	
	КодОКТМО = ПолучитьКодОКТМО(ПараметрыОтчета);
	Раздел1.П000100001003 = КодОКТМО;
	
КонецПроцедуры

Процедура ЗаполнитьРаздел2_2015Кв1(Контейнер, ТаблицаРасшифровки, ПараметрыОтчета)
	
	// Получаем данные:
	РезультатДерево = Новый ДеревоЗначений();
	ВывестиРезультатВыполненияСКД_2015Кв1(РезультатДерево, "Раздел 2", ПараметрыОтчета);
	
	// Подготавливаем контейнер:
	Раздел2 = Контейнер.Раздел2;
	СтраницаРаздел2 = Раздел2[0].Данные;
	Для Каждого Показатель Из СтраницаРаздел2 Цикл
		СтраницаРаздел2[Показатель.Ключ] = ОбщегоНазначенияБГУ.ПустоеЗначениеТипа(ТипЗнч(Показатель.Значение));
	КонецЦикла;
	Пока Раздел2.Количество()>1 Цикл
		Раздел2.Удалить(1);
	КонецЦикла;
	КодОКТМО = ПолучитьКодОКТМО(ПараметрыОтчета);
	
	// Заполняем контейнер
 	ПерваяСтраница = Истина;
	НомерСтраницы = 0;
	Для Каждого СтрокаКонтрагент Из РезультатДерево.Строки Цикл
		Для Каждого СтрокаКодОперации Из СтрокаКонтрагент.Строки Цикл
			НомерСтраницы = НомерСтраницы + 1;
			Для Каждого ДетальнаяСтрока Из СтрокаКодОперации.Строки Цикл
				Если ПерваяСтраница Тогда
					ПерваяСтраница = Ложь;
				Иначе
					// Создаем дополнительную страницу в декларации
					СтруктураНовойТаблицы = Новый Структура();
					Для Каждого Показатель Из СтраницаРаздел2 Цикл
						СтруктураНовойТаблицы.Вставить(Показатель.Ключ, ОбщегоНазначенияБГУ.ПустоеЗначениеТипа(ТипЗнч(Показатель.Значение)));
					КонецЦикла;
					НоваяСтрока = Раздел2.Добавить();
					НоваяСтрока.Данные = СтруктураНовойТаблицы;
				КонецЕсли;
				
				СтраницаРаздел2 = Раздел2[Раздел2.Количество()-1].Данные;
				ЗаполнитьЗначенияСвойств(СтраницаРаздел2, ДетальнаяСтрока);
				СтраницаРаздел2.П000200005003 = КодОКТМО;
				
				// Избавляемся от значений Null
				СтруктураРаздела = СтраницаРаздел2;
				Для Каждого Показатель Из СтруктураРаздела Цикл
					Если Показатель.Значение = Null Тогда
						СтруктураРаздела[Показатель.Ключ] = 0;
					КонецЕсли;
				КонецЦикла;
				
				// Расшифровка
				
				// Строка 060
				ДополнительныйОтбор = Новый Структура();
				ДополнительныйОтбор.Вставить("Контрагент",	ДетальнаяСтрока["Контрагент"]);
				ДополнительныйОтбор.Вставить("КодОперации",	ДетальнаяСтрока["КодОперации"]);
				ДобавитьСтрокуРасшифровки_2015Кв1(ТаблицаРасшифровки,
					"П000200006003" + "_" + НомерСтраницы,
					"Строка 060 (раздел 2, страница " + НомерСтраницы + ") ""Сумма налога, исчисленная к уплате в бюджет""",
