		|		КОГДА &ИсключитьДвиженияПоАннулированию
		|			И (ДополнительныеЛистыКнигиПродаж.СуммаБезНДС < 0
		|			ИЛИ ДополнительныеЛистыКнигиПродаж.СуммаНДС < 0) ТОГДА
		|			ЛОЖЬ
		|		ИНАЧЕ
		|			ИСТИНА
		|	КОНЕЦ
		|;");
		
	ОбщийТекстЗапрос = "";
	ПорядокРегистров = Новый Массив();
	Для Каждого ИмяРегистра Из МассивИменРегистров Цикл
		Если ТекстыЗапросов.Свойство(ИмяРегистра, ТекстЗапроса) Тогда
			ПорядокРегистров.Добавить(ИмяРегистра);
			ОбщийТекстЗапрос = ОбщийТекстЗапрос + ТекстЗапроса;
		КонецЕсли;
	КонецЦикла;
	
	Если ПорядокРегистров.Количество() > 0 Тогда
		ЗапросДвижения = Новый Запрос();
		ЗапросДвижения.УстановитьПараметр("Регистратор",						ДокументСсылка);
		ЗапросДвижения.УстановитьПараметр("ЗаполнитьВалютныеСуммы",				ЗаполнитьВалютныеСуммы);
		ЗапросДвижения.УстановитьПараметр("ИсключитьДвиженияПоАннулированию",	ИсключитьДвиженияПоАннулированию);
		ЗапросДвижения.Текст = ОбщийТекстЗапрос;
		РезультатыЗапроса = ЗапросДвижения.ВыполнитьПакет();
		инд = 0;
		Для Каждого ИмяРегистра Из ПорядокРегистров Цикл
			Результат.Вставить(ИмяРегистра, РезультатыЗапроса[инд].Выгрузить());
			инд = инд + 1;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьПлатежноРасчетныеДокументы(ДокументОбъект, ОснованиеСсылка) Экспорт
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("СчетФактура", ОснованиеСсылка);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Табличная часть ПлатежноРасчетныеДокументы указанного документа
	|//
	|ВЫБРАТЬ
	|	ДатаДокумента,
	|	НомерДокумента
	|ИЗ
	|	Документ.СчетФактураВыданный.ПлатежноРасчетныеДокументы
	|ГДЕ
	|	Ссылка В(&СчетФактура)
	|	
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ДатаДокумента,
	|	НомерДокумента
	|ИЗ
	|	Документ.ИсправительныйСчетФактураВыданный.ПлатежноРасчетныеДокументы
	|ГДЕ
	|	Ссылка В(&СчетФактура)
	|	
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ДатаДокумента,
	|	НомерДокумента
	|ИЗ
	|	Документ.КорректировочныйСчетФактураВыданный.ПлатежноРасчетныеДокументы
	|ГДЕ
	|	Ссылка В(&СчетФактура)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ДатаДокумента,
	|	НомерДокумента
	|ИЗ
	|	Документ.СчетФактураПолученный.ПлатежноРасчетныеДокументы
	|ГДЕ
	|	Ссылка В(&СчетФактура)
	|	
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ДатаДокумента,
	|	НомерДокумента
	|ИЗ
	|	Документ.ИсправительныйСчетФактураПолученный.ПлатежноРасчетныеДокументы
	|ГДЕ
	|	Ссылка В(&СчетФактура)
	|	
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ДатаДокумента,
	|	НомерДокумента
	|ИЗ
	|	Документ.КорректировочныйСчетФактураПолученный.ПлатежноРасчетныеДокументы
	|ГДЕ
	|	Ссылка В(&СчетФактура)";
	
	Таблица = ЗапросПоиск.Выполнить().Выгрузить();
	
	ДокументОбъект.ПлатежноРасчетныеДокументы.Очистить();
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		НоваяСтрока = ДокументОбъект.ПлатежноРасчетныеДокументы.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьТиповуюОперациюПриВводеНаОсновании(ФормаДокумента, НоваяТиповаяОперация) Экспорт
	
	Если ЗначениеЗаполнено(НоваяТиповаяОперация.Ссылка) Тогда
		ФормаДокумента["БухгалтерскиеОперации_ТиповаяОперация"] = НоваяТиповаяОперация.Ссылка;
		
		БухгалтерскиеОперацииСервер.ПриИзмененииТиповойОперации(ФормаДокумента.Элементы["ТиповыеОперации_БухгалтерскиеОперации_ТиповаяОперация"]);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьПредустановленныйОтборСИсключениемСсылки(ПараметрыФормы, ИсключаемаяСсылка) Экспорт
	
	Если Не ЗначениеЗаполнено(ИсключаемаяСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	СписокСсылок = Новый Массив();
	СписокСсылок.Добавить(ИсключаемаяСсылка);
	
	НастройкиКомпоновки = Новый НастройкиКомпоновкиДанных();
	
	НовыйЭлемент = НастройкиКомпоновки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	НовыйЭлемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка");
	НовыйЭлемент.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке;
	НовыйЭлемент.ПравоеЗначение = Новый ФиксированныйМассив(СписокСсылок);
	
	ПредустановленныйОтбор = ОбщегоНазначения.ЗначениеВСтрокуXML(НастройкиКомпоновки);
	
	ПараметрыФормы.Вставить("ПредустановленныйОтбор", ПредустановленныйОтбор);
	
КонецПроцедуры

#КонецОбласти

#Область АвтозаполнениеСчетовИкпс

Функция ПолучитьСтруктуруШапкиДокументаДляАвтозаполнения() Экспорт
	
	Возврат Новый Структура("
		|Организация,
		|ИФО,
		|КФО,
		|Дата,
		|ПричинаНалогообложения");
	
КонецФункции

// Заполняет колонку КПС и/или КЭК в указанной таблице согласно рабочему плану счетов.
//
// Параметры:
//	ЗаполняемаяТаблица	- ТаблицаЗначений, ТабличнаяЧасть	- может иметь колонки
//							Организация,Дата,ИФО,КФО,Счет,КПС,КЭК.
//							Если какие-то из колонок отсутствуют, то необходимо в ПараметрахЗаполнения
//							передать соответствующее значение, которое будет использоваться для всех строк
//							в этих колонках.
//							Например, если Организация или Дата находятся в шапке документа,
//							и в заполняемой табличной части нет таких колонок.
//	ОписаниеТаблицы		- Структура	- имена колонок таблицы.
//							Используется, если имена колонок отличаются от значений по умолчанию.
//							<Ключ>						<Значение по умолчанию, если не указано>
//							- ИмяКолонкиОрганизация		"Организация"
//							- ИмяКолонкиДата			"Дата"
//							- ИмяКолонкиИФО				"ИФО"
//							- ИмяКолонкиКФО				"КФО"
//							- ИмяКолонкиСчет			"Счет"
//							- ИмяКолонкиКПС				"КПС"
//							- ИмяКолонкиКЭК				"КЭК"
//
//	ПараметрыЗаполнения	- Структура	- влияет на заполнение колонок КПС, КЭК.
//							<Ключ>
//							- ЗаполнитьКолонкуКЭК		- Булево	- по умолчанию Ложь
//							- ЗаполнитьКолонкуКПС		- Булево	- по умолчанию Ложь
//							- ЗаполнитьТолькоПустыеПоля	- Булево	- по умолчанию Ложь
//							- ВидыПоказателяКПС			- Массив,СписокЗначений,ПеречислениеСсылка.ВидыКБК -
//															опциональный дополнительный отбор
//															при выборе КПС из рабочих счетов
//							- СторонаПроводки			- Строка	- "Дт" или "Кт"
//							- ВыбратьОдинКПСПриНаличииНескольких	- Булево	- по умолчанию Ложь
//															выбирает случайным образом один КПС, если
//															на проверяемую дату имеется несколько рабочих счетов.
//
//						 Значения, тиражируемые во все строки заполняемой таблицы.
//						Если элемент не передан, то такая колонка берется из заполняемой таблицы
//						(т.е. такая колонка должна существовать в заполняемой таблице)
//							- Организация
//							- Дата
//							- ИФО
//							- КФО
//							- Счет
//
// Пример использования:
//	ОписаниеТаблицы = Новый Структура();
//	ОписаниеТаблицы.Вставить("ИмяКолонкиСчет",		"СчетНачислениеДт");
//	ОписаниеТаблицы.Вставить("ИмяКолонкиКЭК",		"КЭКНачислениеДт");
//	ПараметрыЗаполнения = Новый Структура();
//	ПараметрыЗаполнения.Вставить("СторонаПроводки",		"Дт");
//	ПараметрыЗаполнения.Вставить("Организация",			ДокументОбъект["Организация"]);
//	ПараметрыЗаполнения.Вставить("Дата",				ДокументОбъект["Дата"]);
//	ПараметрыЗаполнения.Вставить("КФО",					ДокументОбъект["КФО"]);
//	ПараметрыЗаполнения.Вставить("ИФО",					ДокументОбъект["ИФО"]);
//	ПараметрыЗаполнения.Вставить("ЗаполнитьКолонкуКЭК",	Истина);
//	УчетНДС.ЗаполнитьТаблицуПоРабочемуПлануСчетов(ТЧСоставНФА, ОписаниеТаблицы, ПараметрыЗаполнения);
Процедура ЗаполнитьТаблицуПоРабочемуПлануСчетов(ЗаполняемаяТаблица, ОписаниеТаблицы, ПараметрыЗаполнения) Экспорт
	
	// Параметры заполнения
	Перем	СторонаПроводки,
			ИспользоватьВидыПоказателяКПС,
			ВидыПоказателяКПС,
			ЗаполнитьКолонкуКЭК,
			ЗаполнитьКолонкуКПС,
			ЗаполнитьТолькоПустыеПоля,
			ВыбратьОдинКПСПриНаличииНескольких,
			Организация,
			Дата,
			ИФО,
			КФО,
			Счет,
			ТиражироватьЗначениеОрганизация,
			ТиражироватьЗначениеДата,
			ТиражироватьЗначениеИФО,
			ТиражироватьЗначениеКФО,
			ТиражироватьЗначениеСчет;
			
	// Описание таблицы
	Перем	ИмяКолонкиОрганизация,
			ИмяКолонкиДата,
			ИмяКолонкиИФО,
			ИмяКолонкиКФО,
			ИмяКолонкиСчет,
			ИмяКолонкиКПС,
			ИмяКолонкиКЭК;
			
	Перем	ЗаполнятьТаблицуПострочно;
	
	ЗаполнятьТаблицуПострочно = (ТипЗнч(ЗаполняемаяТаблица) = Тип("ДанныеФормыКоллекция"));
	
	Если ЗаполнятьТаблицуПострочно Тогда
		ТЗ = ЗаполняемаяТаблица.Выгрузить();
	Иначе
		ТЗ = ЗаполняемаяТаблица;
	КонецЕсли;
	
	// Гарантируем наличие колонки НомерСтроки
	Если ТЗ.Колонки.Найти("НомерСтроки") = Неопределено Тогда
		КЧ = Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Неотрицательный);
		ТЗ.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число",,,КЧ));
		НомерСтроки = 0;
		Для Каждого СтрокаТЗ Из ТЗ Цикл
			НомерСтроки = НомерСтроки + 1;
			СтрокаТЗ["НомерСтроки"] = НомерСтроки;
		КонецЦикла;
	КонецЕсли;
	
	// Параметры заполнения
	ПараметрыЗаполнения.Свойство("ЗаполнитьКолонкуКЭК",	ЗаполнитьКолонкуКЭК);
	Если НЕ ЗаполнитьКолонкуКЭК = Истина Тогда
		ЗаполнитьКолонкуКЭК = Ложь;
	КонецЕсли;
	ПараметрыЗаполнения.Свойство("ЗаполнитьКолонкуКПС",	ЗаполнитьКолонкуКПС);
	Если НЕ ЗаполнитьКолонкуКПС = Истина Тогда
		ЗаполнитьКолонкуКПС = Ложь;
	КонецЕсли;
	Если НЕ ЗаполнитьКолонкуКЭК И НЕ ЗаполнитьКолонкуКПС Тогда
		// Выходим:
		Возврат;
	КонецЕсли;
	ПараметрыЗаполнения.Свойство("ЗаполнитьТолькоПустыеПоля",	ЗаполнитьТолькоПустыеПоля);
	Если НЕ ЗаполнитьТолькоПустыеПоля = Истина Тогда
		ЗаполнитьТолькоПустыеПоля = Ложь;
	КонецЕсли;
	ПараметрыЗаполнения.Свойство("ВыбратьОдинКПСПриНаличииНескольких",	ВыбратьОдинКПСПриНаличииНескольких);
	Если НЕ ВыбратьОдинКПСПриНаличииНескольких = Истина Тогда
		ВыбратьОдинКПСПриНаличииНескольких = Ложь;
	КонецЕсли;
	ПараметрыЗаполнения.Свойство("ВидыПоказателяКПС",	ВидыПоказателяКПС);
	Если ТипЗнч(ВидыПоказателяКПС) = Тип("Массив")
		ИЛИ ТипЗнч(ВидыПоказателяКПС) = Тип("СписокЗначений")
		ИЛИ ТипЗнч(ВидыПоказателяКПС) = Тип("ПеречислениеСсылка.ВидыКБК") Тогда
		ИспользоватьВидыПоказателяКПС	= Истина;
	Иначе
		ВидыПоказателяКПС				= Неопределено;
		ИспользоватьВидыПоказателяКПС	= Ложь;
	КонецЕсли;
	ПараметрыЗаполнения.Свойство("СторонаПроводки",			СторонаПроводки);
	Если НЕ СторонаПроводки = "Дт" Тогда
		СторонаПроводки = "Кт";
	КонецЕсли;
	ТиражироватьЗначениеОрганизация	= ПараметрыЗаполнения.Свойство("Организация",	Организация);
	ТиражироватьЗначениеДата		= ПараметрыЗаполнения.Свойство("Дата",			Дата);
	ТиражироватьЗначениеИФО			= ПараметрыЗаполнения.Свойство("ИФО",			ИФО);
	ТиражироватьЗначениеКФО			= ПараметрыЗаполнения.Свойство("КФО",			КФО);
	ТиражироватьЗначениеСчет		= ПараметрыЗаполнения.Свойство("Счет",			Счет);
	
	// Описание таблицы
	Если НЕ ОписаниеТаблицы.Свойство("ИмяКолонкиОрганизация",	ИмяКолонкиОрганизация) Тогда
		ИмяКолонкиОрганизация = "Организация";
	КонецЕсли;
	Если НЕ ОписаниеТаблицы.Свойство("ИмяКолонкиДата",			ИмяКолонкиДата) Тогда
		ИмяКолонкиДата = "Дата";
	КонецЕсли;
	Если НЕ ОписаниеТаблицы.Свойство("ИмяКолонкиИФО",			ИмяКолонкиИФО) Тогда
		ИмяКолонкиИФО = "ИФО";
	КонецЕсли;
	Если НЕ ОписаниеТаблицы.Свойство("ИмяКолонкиКФО",			ИмяКолонкиКФО) Тогда
		ИмяКолонкиКФО = "КФО";
	КонецЕсли;
	Если НЕ ОписаниеТаблицы.Свойство("ИмяКолонкиСчет",			ИмяКолонкиСчет) Тогда
		ИмяКолонкиСчет = "Счет";
	КонецЕсли;
	Если НЕ ОписаниеТаблицы.Свойство("ИмяКолонкиКПС",			ИмяКолонкиКПС) Тогда
		ИмяКолонкиКПС = "КПС";
	КонецЕсли;
	Если НЕ ОписаниеТаблицы.Свойство("ИмяКолонкиКЭК",			ИмяКолонкиКЭК) Тогда
		ИмяКолонкиКЭК = "КЭК";
	КонецЕсли;
	
	КЭК000 = БухгалтерскийУчетПовтИсп.КЭК0();
	
	ВидыКПСБюджетные = Новый Массив();
	ВидыКПСБюджетные.Добавить(Перечисления.ВидыКБК.гКБК);
	ВидыКПСБюджетные.Добавить(Перечисления.ВидыКБК.КДБ);
	ВидыКПСБюджетные.Добавить(Перечисления.ВидыКБК.КИФ);
	ВидыКПСБюджетные.Добавить(Перечисления.ВидыКБК.КРБ);
	
	ВидыКПСПроизвольные = Новый Массив();
	ВидыКПСПроизвольные.Добавить(Перечисления.ВидыКБК.Произвольный);
	
	ВидыКПСауБУ = Новый Массив();
	ВидыКПСауБУ.Добавить(Перечисления.ВидыКБК.АУИБУ);
	
	// Выполняем запрос
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ЗаполнитьТолькоПустыеПоля",			ЗаполнитьТолькоПустыеПоля);
	ЗапросЗаполнение.УстановитьПараметр("ВыбратьОдинКПСПриНаличииНескольких",	ВыбратьОдинКПСПриНаличииНескольких);
	ЗапросЗаполнение.УстановитьПараметр("ИспользоватьУчетПоИФО",				ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	ЗапросЗаполнение.УстановитьПараметр("СторонаПроводки",						СторонаПроводки);
	ЗапросЗаполнение.УстановитьПараметр("КЭК000",								КЭК000);
	ЗапросЗаполнение.УстановитьПараметр("ИспользоватьВидыПоказателяКПС",		ИспользоватьВидыПоказателяКПС);
	ЗапросЗаполнение.УстановитьПараметр("ВидыПоказателяКПС",					ВидыПоказателяКПС);
	
	ЗапросЗаполнение.УстановитьПараметр("ВидыКПСБюджетные",						ВидыКПСБюджетные);
	ЗапросЗаполнение.УстановитьПараметр("ВидыКПСПроизвольные",					ВидыКПСПроизвольные);
	ЗапросЗаполнение.УстановитьПараметр("ВидыКПСауБУ",							ВидыКПСауБУ);
	
	ЗапросЗаполнение.УстановитьПараметр("ТЗ",									ТЗ);
	ЗапросЗаполнение.УстановитьПараметр("Организация",							Организация);
	ЗапросЗаполнение.УстановитьПараметр("Дата",									Дата);
	ЗапросЗаполнение.УстановитьПараметр("ИФО",									ИФО);
	ЗапросЗаполнение.УстановитьПараметр("КФО",									КФО);
	ЗапросЗаполнение.УстановитьПараметр("Счет",									Счет);
	ЗапросЗаполнение.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Исходная таблица
	|//
	|ВЫБРАТЬ
	|	ТЗ.НомерСтроки	КАК НомерСтроки,
	|	" + ?(ЗаполнитьКолонкуКЭК,			"ТЗ." + ИмяКолонкиКЭК + "	КАК КЭК,", "") +	"
	|	" + ?(ЗаполнитьКолонкуКПС,			"ТЗ." + ИмяКолонкиКПС + "	КАК КПС,", "") +	"
	|	" + ?(ТиражироватьЗначениеОрганизация,	"&Организация",	"ТЗ." + ИмяКолонкиОрганизация) +"	КАК Организация,
	|	" + ?(ТиражироватьЗначениеДата,			"&Дата",		"ТЗ." + ИмяКолонкиДата) +		"	КАК Дата,
	|	" + ?(ТиражироватьЗначениеИФО,			"&ИФО",			"ТЗ." + ИмяКолонкиИФО) +		"	КАК ИФО,
	|	" + ?(ТиражироватьЗначениеКФО,			"&КФО",			"ТЗ." + ИмяКолонкиКФО) +		"	КАК КФО,
	|	" + ?(ТиражироватьЗначениеСчет,			"&Счет",		"ТЗ." + ИмяКолонкиСчет) +		"	КАК Счет
	|ПОМЕСТИТЬ
	|	ИсходнаяТаблица
	|ИЗ
	|	&ТЗ	КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. (Подготовка) Даты начала применения учетной политики
	|//
	|ВЫБРАТЬ
	|	ИсходнаяТаблица.Организация					КАК Организация,
	|	ИсходнаяТаблица.Дата						КАК Дата,
	|	МАКСИМУМ(УчетнаяПолитикаОрганизаций.Период)	КАК Период
	|ПОМЕСТИТЬ
	|	ДатыНачалаПримененияУчетнойПолитики
	|ИЗ
	|	ИсходнаяТаблица
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	РегистрСведений.УчетнаяПолитикаОрганизаций	КАК УчетнаяПолитикаОрганизаций
	|		ПО	ИсходнаяТаблица.Дата >= УчетнаяПолитикаОрганизаций.Период
	|		И	ИсходнаяТаблица.Организация = УчетнаяПолитикаОрганизаций.Организация
	|СГРУППИРОВАТЬ ПО
	|	ИсходнаяТаблица.Организация,
	|	ИсходнаяТаблица.Дата
	|ИНДЕКСИРОВАТЬ ПО
	|	Организация,
	|	Дата,
	|	Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. (Подготовка) Исходная таблица, дополненная
	|//		служебной колонкой используемых структур РПС
	|//
	|ВЫБРАТЬ
	|	// Колонки иходной таблицы:
	|	ИсходнаяТаблица.*,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоИФО ТОГДА
	|			ИсходнаяТаблица.ИФО
	|		ИНАЧЕ
	|			НЕОПРЕДЕЛЕНО
	|	КОНЕЦ	КАК ИФО,
	|	
	|	// Рассчитываемые колонки:
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоИФО ТОГДА
	|			ЕСТЬNULL(НастройкиИспользованияРПС.СтруктураРПС, УчетнаяПолитикаОрганизаций.СтруктураРПС)
	|		ИНАЧЕ
	|			УчетнаяПолитикаОрганизаций.СтруктураРПС
	|	КОНЕЦ	КАК СтруктураРПС
	|ПОМЕСТИТЬ
	|	ИсходнаяТаблицаСтруктураРПС
	|ИЗ
	|	ИсходнаяТаблица
	|	ЛЕВОЕ СОЕДИНЕНИЕ	ДатыНачалаПримененияУчетнойПолитики
	|		ПО	ИсходнаяТаблица.Организация = ДатыНачалаПримененияУчетнойПолитики.Организация
	|		И	ИсходнаяТаблица.Дата = ДатыНачалаПримененияУчетнойПолитики.Дата
	|	ЛЕВОЕ СОЕДИНЕНИЕ	РегистрСведений.УчетнаяПолитикаОрганизаций	КАК УчетнаяПолитикаОрганизаций
	|		ПО	ДатыНачалаПримененияУчетнойПолитики.Организация = УчетнаяПолитикаОрганизаций.Организация
	|		И	ДатыНачалаПримененияУчетнойПолитики.Период = УчетнаяПолитикаОрганизаций.Период
	|	ЛЕВОЕ СОЕДИНЕНИЕ	РегистрСведений.НастройкиИспользованияРПС	КАК НастройкиИспользованияРПС
	|		ПО	ИсходнаяТаблица.Организация = НастройкиИспользованияРПС.Организация
	|		И ВЫБОР
	|			КОГДА &ИспользоватьУчетПоИФО ТОГДА
	|				ИсходнаяТаблица.ИФО = НастройкиИспользованияРПС.ИФО
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|ИНДЕКСИРОВАТЬ ПО
	|	ИсходнаяТаблица.КФО,
	|	СтруктураРПС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. (Подготовка) Исходная таблица, дополненная
	|//		всеми необходимыми служебными колонками (типы КПС и КЭК)
	|//
	|ВЫБРАТЬ 
	|	// Рассчитываемые колонки:"

	+ ?(ЗаполнитьКолонкуКЭК, "
	|	ВЫБОР
	|		КОГДА ИсходнаяТаблицаСтруктураРПС.КЭК = ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка) И НЕ НастройкиСтруктурРПС.ТипКЭК ЕСТЬ NULL ТОГДА
	|			// Пустое поле - заполняем всегда
	|			ИСТИНА
	|		КОГДА &ЗаполнитьТолькоПустыеПоля ТОГДА
	|			// Заполненное поле - заполняем по указанию
	|			ЛОЖЬ
	|		ИНАЧЕ
	|			// Заполненное поле - заполняем по указанию
	|			ИСТИНА
	|	КОНЕЦ						КАК УстановитьЗначениеКЭК,
	|	НастройкиСтруктурРПС.ТипКЭК	КАК ТипКЭКПоУчетнойПолитике,",
	"")

	+ ?(ЗаполнитьКолонкуКПС, "
	|	ВЫБОР
	|		КОГДА ИсходнаяТаблицаСтруктураРПС.КПС = ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка) И НЕ НастройкиСтруктурРПС.ТипКПС ЕСТЬ NULL ТОГДА
	|			// Пустое поле - заполняем всегда
	|			ИСТИНА
	|		КОГДА &ЗаполнитьТолькоПустыеПоля ТОГДА
	|			// Заполненное поле - заполняем по указанию
	|			ЛОЖЬ
	|		ИНАЧЕ
	|			// Заполненное поле - заполняем по указанию
	|			ИСТИНА
	|	КОНЕЦ						КАК УстановитьЗначениеКПС,
	|	НастройкиСтруктурРПС.ТипКПС	КАК ТипКПСПоУчетнойПолитике,",
	"")

	+ "
	|	
	|	// Колонки иходной таблицы:
	|	ИсходнаяТаблицаСтруктураРПС.*
	|	
	|ПОМЕСТИТЬ
	|	ИсходнаяТаблицаРасширенная
	|ИЗ
	|	ИсходнаяТаблицаСтруктураРПС
	|	ЛЕВОЕ СОЕДИНЕНИЕ	РегистрСведений.НастройкиСтруктурРПС	КАК НастройкиСтруктурРПС
	|		ПО	ИсходнаяТаблицаСтруктураРПС.СтруктураРПС = НастройкиСтруктурРПС.СтруктураРПС
	|		И	ИсходнаяТаблицаСтруктураРПС.КФО = НастройкиСтруктурРПС.КФО
	|ИНДЕКСИРОВАТЬ ПО
	|	ИсходнаяТаблицаСтруктураРПС.Дата,
	|	ИсходнаяТаблицаСтруктураРПС.Организация,
	|	ИсходнаяТаблицаСтруктураРПС.ИФО,
	|	ИсходнаяТаблицаСтруктураРПС.КФО,
	|	ИсходнаяТаблицаСтруктураРПС.Счет
	|;
	|"

	+ ?(ЗаполнитьКолонкуКПС, "
	|////////////////////////////////////////////////////////////////////////////////
	|// [4]. (Подготовка) Все действующие рабочие счета.
	|//		Возможно наличие нескольких рабочих счетов, в том числе на одну дату.
	|//
	|ВЫБРАТЬ 
	|	ИсходнаяТаблицаРасширенная.Дата							КАК Дата,
	|	ИсходнаяТаблицаРасширенная.Организация					КАК Организация,
	|	ИсходнаяТаблицаРасширенная.ИФО							КАК ИФО,
	|	ИсходнаяТаблицаРасширенная.КФО							КАК КФО,
	|	ИсходнаяТаблицаРасширенная.Счет							КАК Счет,
	|	РабочиеСчета.Период										КАК Период,
	|	РабочиеСчета.КПС										КАК КПС
	|ПОМЕСТИТЬ
	|	ВсеДействующиеРабочиеСчета
	|ИЗ
	|	ИсходнаяТаблицаРасширенная
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	РегистрСведений.РабочиеСчета	КАК РабочиеСчета
	|		ПО	ИсходнаяТаблицаРасширенная.Дата >= РабочиеСчета.Период
	|		И	ИсходнаяТаблицаРасширенная.Организация = РабочиеСчета.Организация
	|		И ВЫБОР
	|			КОГДА &ИспользоватьУчетПоИФО ТОГДА
	|				ИсходнаяТаблицаРасширенная.ИФО = РабочиеСчета.ИФО
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И	ИсходнаяТаблицаРасширенная.КФО = РабочиеСчета.КФО
	|		И	ИсходнаяТаблицаРасширенная.Счет = РабочиеСчета.Счет
	|		И	РабочиеСчета.Актуален
	|		И ВЫБОР
	|			КОГДА &ИспользоватьВидыПоказателяКПС ТОГДА
	|				РабочиеСчета.КПС.ВидПоказателя В(&ВидыПоказателяКПС)
	|			
	|			КОГДА ИсходнаяТаблицаРасширенная.ТипКПСПоУчетнойПолитике = ЗНАЧЕНИЕ(Перечисление.ТипыАналитическихПризнаков.БюджетнаяКлассификация) ТОГДА
	|				РабочиеСчета.КПС.ВидПоказателя В (&ВидыКПСБюджетные)
	|				
	|			КОГДА ИсходнаяТаблицаРасширенная.ТипКПСПоУчетнойПолитике = ЗНАЧЕНИЕ(Перечисление.ТипыАналитическихПризнаков.ПроизвольнаяКлассификация) ТОГДА
	|			    РабочиеСчета.КПС.ВидПоказателя В(&ВидыКПСПроизвольные)
	|			    
	|			КОГДА ИсходнаяТаблицаРасширенная.ТипКПСПоУчетнойПолитике = ЗНАЧЕНИЕ(Перечисление.ТипыАналитическихПризнаков.КлассификацияАУБУ) ТОГДА
	|			    РабочиеСчета.КПС.ВидПоказателя В(&ВидыКПСауБУ)
	|			    
	|			ИНАЧЕ
	|				ЛОЖЬ
	|		КОНЕЦ
	|ИНДЕКСИРОВАТЬ ПО
	|	Дата,
	|	Организация,
	|	ИФО,
	|	КФО,
	|	Счет,
	|	Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [5]. (Подготовка) Количество действующих рабочих счетов
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ 
	|	Дата						КАК Дата,
	|	Организация					КАК Организация,
	|	ИФО							КАК ИФО,
	|	КФО							КАК КФО,
	|	Счет						КАК Счет,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ КПС)	КАК КоличествоКПС
	|ПОМЕСТИТЬ
	|	КоличествоДействующихРабочийСчетов
	|ИЗ
	|	ВсеДействующиеРабочиеСчета
	|СГРУППИРОВАТЬ ПО
	|	Дата,
	|	Организация,
	|	ИФО,
	|	КФО,
	|	Счет
	|ИНДЕКСИРОВАТЬ ПО
	|	Дата,
	|	Организация,
	|	ИФО,
	|	КФО,
	|	Счет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [6]. Применяемые рабочие счета
	|//		Гарантированно не более одного рабочего счета для каждой строки	исходной таблицы
	|//		Выбираем самый поздний действующий КПС
	|//
	|ВЫБРАТЬ
	|	ВсеДействующиеРабочиеСчета.Период			КАК Период,
	|	ВсеДействующиеРабочиеСчета.Дата				КАК Дата,
	|	ВсеДействующиеРабочиеСчета.Организация		КАК Организация,
	|	ВсеДействующиеРабочиеСчета.ИФО				КАК ИФО,
	|	ВсеДействующиеРабочиеСчета.КФО				КАК КФО,
	|	ВсеДействующиеРабочиеСчета.Счет				КАК Счет,
	|	МАКСИМУМ(ВсеДействующиеРабочиеСчета.КПС)	КАК КПС
	|ПОМЕСТИТЬ
	|	ПрименяемыеРабочиеСчета
	|ИЗ
	|	ВсеДействующиеРабочиеСчета
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ (
	|			ВЫБРАТЬ
	|				// 5 полей связи, плюс Период
	|				Дата				КАК Дата,
	|				Организация			КАК Организация,
	|				ИФО					КАК ИФО,
	|				КФО					КАК КФО,
	|				Счет				КАК Счет,
	|				МАКСИМУМ(Период)	КАК Период
	|			ИЗ
	|				ВсеДействующиеРабочиеСчета	КАК Т1
	|			СГРУППИРОВАТЬ ПО
	|				Дата,
	|				Организация,
	|				ИФО,
	|				КФО,
	|				Счет
	|			) КАК МаксимальныйПериод
	|		ПО	ВсеДействующиеРабочиеСчета.Период		= МаксимальныйПериод.Период
	|		И	ВсеДействующиеРабочиеСчета.Дата			= МаксимальныйПериод.Дата
	|		И	ВсеДействующиеРабочиеСчета.Организация	= МаксимальныйПериод.Организация
	|		И	ВсеДействующиеРабочиеСчета.ИФО			= МаксимальныйПериод.ИФО
	|		И	ВсеДействующиеРабочиеСчета.КФО			= МаксимальныйПериод.КФО
	|		И	ВсеДействующиеРабочиеСчета.Счет			= МаксимальныйПериод.Счет
	|СГРУППИРОВАТЬ ПО
	|	ВсеДействующиеРабочиеСчета.Период,
	|	ВсеДействующиеРабочиеСчета.Дата,
	|	ВсеДействующиеРабочиеСчета.Организация,
	|	ВсеДействующиеРабочиеСчета.ИФО,
	|	ВсеДействующиеРабочиеСчета.КФО,
	|	ВсеДействующиеРабочиеСчета.Счет
	|ИНДЕКСИРОВАТЬ ПО
	|	Дата,
	|	Организация,
	|	ИФО,
	|	КФО,
	|	Счет
	|;",
	"")

	+ "
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [7]. Искомые колонки КЭК и КПС для дальнейшей загрузки в исходную таблицу
	|//		(Финальная таблица)
	|ВЫБРАТЬ"

	+ ?(ЗаполнитьКолонкуКЭК, "
	|	ВЫБОР
	|		КОГДА ИсходнаяТаблицаРасширенная.УстановитьЗначениеКЭК ТОГДА
	|			ВЫБОР
	|				КОГДА ИсходнаяТаблицаРасширенная.ТипКЭКПоУчетнойПолитике = ЗНАЧЕНИЕ(Перечисление.ТипыАналитическихПризнаков.ПроизвольнаяКлассификация)
	|					ИЛИ ИсходнаяТаблицаРасширенная.ТипКЭКПоУчетнойПолитике = ЗНАЧЕНИЕ(Перечисление.ТипыАналитическихПризнаков.КлассификацияАУБУ)
	|					ТОГДА
	|					&КЭК000
	|				КОГДА &СторонаПроводки = ""Дт"" ТОГДА
	|					ВЫРАЗИТЬ(ИсходнаяТаблицаРасширенная.Счет	КАК ПланСчетов.ЕПСБУ).КОСГУДт
	|				КОГДА &СторонаПроводки = ""Кт"" ТОГДА
	|					ВЫРАЗИТЬ(ИсходнаяТаблицаРасширенная.Счет	КАК ПланСчетов.ЕПСБУ).КОСГУКт
	|				ИНАЧЕ
	|					ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)
	|			КОНЕЦ
	|		ИНАЧЕ
	|			ИсходнаяТаблицаРасширенная.КЭК
	|	КОНЕЦ																		КАК КЭК,",
	"")

	+ ?(ЗаполнитьКолонкуКПС, "
	|	ВЫБОР
	|		КОГДА ИсходнаяТаблицаРасширенная.УстановитьЗначениеКПС
	|			И	(КоличествоДействующихРабочийСчетов.КоличествоКПС = 1
	|				ИЛИ (КоличествоДействующихРабочийСчетов.КоличествоКПС > 1 И &ВыбратьОдинКПСПриНаличииНескольких)) ТОГДА
	|			ПрименяемыеРабочиеСчета.КПС
	|		ИНАЧЕ
	|			ИсходнаяТаблицаРасширенная.КПС
	|	КОНЕЦ																		КАК КПС,",
	"")

	+ "
	|	ЛОЖЬ																		КАК ПолеЗаглушка
	|ИЗ
	|	ИсходнаяТаблицаРасширенная"

	+ ?(ЗаполнитьКолонкуКПС, "
	|	ЛЕВОЕ СОЕДИНЕНИЕ	КоличествоДействующихРабочийСчетов
	|		ПО	ИсходнаяТаблицаРасширенная.Дата = КоличествоДействующихРабочийСчетов.Дата
	|		И	ИсходнаяТаблицаРасширенная.Организация = КоличествоДействующихРабочийСчетов.Организация
	|		И	ИсходнаяТаблицаРасширенная.ИФО = КоличествоДействующихРабочийСчетов.ИФО
	|		И	ИсходнаяТаблицаРасширенная.КФО = КоличествоДействующихРабочийСчетов.КФО
	|		И	ИсходнаяТаблицаРасширенная.Счет = КоличествоДействующихРабочийСчетов.Счет
	|	ЛЕВОЕ СОЕДИНЕНИЕ	ПрименяемыеРабочиеСчета
	|		ПО	ИсходнаяТаблицаРасширенная.Дата = ПрименяемыеРабочиеСчета.Дата
	|		И	ИсходнаяТаблицаРасширенная.Организация = ПрименяемыеРабочиеСчета.Организация
	|		И	ИсходнаяТаблицаРасширенная.ИФО = ПрименяемыеРабочиеСчета.ИФО
	|		И	ИсходнаяТаблицаРасширенная.КФО = ПрименяемыеРабочиеСчета.КФО
	|		И	ИсходнаяТаблицаРасширенная.Счет = ПрименяемыеРабочиеСчета.Счет",
	"")

	+ "
	|УПОРЯДОЧИТЬ ПО
	|	ИсходнаяТаблицаРасширенная.НомерСтроки
	|;";
	
	ТЗРезультат = ЗапросЗаполнение.Выполнить().Выгрузить();
	
	Если ЗаполнятьТаблицуПострочно Тогда
		КоличествоСтрок = ТЗРезультат.Количество();
		Для сч = 1 По КоличествоСтрок Цикл
			Если ЗаполнитьКолонкуКЭК Тогда
				ЗаполняемаяТаблица[сч - 1][ИмяКолонкиКЭК] = ТЗРезультат[сч - 1]["КЭК"];
			КонецЕсли;
			Если ЗаполнитьКолонкуКПС Тогда
				ЗаполняемаяТаблица[сч - 1][ИмяКолонкиКПС] = ТЗРезультат[сч - 1]["КПС"];
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		Если ЗаполнитьКолонкуКЭК Тогда
			КолонкаКЭК = ТЗРезультат.ВыгрузитьКолонку("КЭК");
			ЗаполняемаяТаблица.ЗагрузитьКолонку(КолонкаКЭК, ИмяКолонкиКЭК);
		КонецЕсли;
		Если ЗаполнитьКолонкуКПС Тогда
			КолонкаКПС = ТЗРезультат.ВыгрузитьКолонку("КПС");
			ЗаполняемаяТаблица.ЗагрузитьКолонку(КолонкаКПС, ИмяКолонкиКПС);
		КонецЕсли;
		
	КонецЕсли;
	
	//---
	// Детализация КЭК в зависимости от вида контрагента (209н с 2019 г.)
	//---
	
	// Эти значения будем использовать как общие для всей таблицы
	
	Если НЕ ТиражироватьЗначениеОрганизация Тогда
		Организация = ЗаполняемаяТаблица[0][ИмяКолонкиОрганизация];
	КонецЕсли;
	
	Если НЕ ТиражироватьЗначениеДата Тогда
		Дата = ЗаполняемаяТаблица[0][ИмяКолонкиДата];
	КонецЕсли;
	
	Если НЕ ТиражироватьЗначениеИФО Тогда
		ИФО = ЗаполняемаяТаблица[0][ИмяКолонкиИФО];
	КонецЕсли;
	
	ДетализироватьКЭК209н = ЗаполнитьКолонкуКЭК
		И БухгалтерскиеОперации.ПрименяетсяПриказ209н(Дата, Организация)
		И ПараметрыЗаполнения.Свойство("Контрагент");
		
	Если ДетализироватьКЭК209н Тогда
		
		ВидСубконтоКонтрагенты = ПланыВидовХарактеристик.ВидыСубконто.Контрагенты;
		
		Для Каждого СтрокаТаблицы Из ЗаполняемаяТаблица Цикл
			
			СчетСсылка = ?(ТиражироватьЗначениеСчет, Счет, СтрокаТаблицы[ИмяКолонкиСчет]);
			
			Если БухгалтерскийУчетПовтИсп.ЕстьСубконтоСчета(СчетСсылка, ВидСубконтоКонтрагенты) Тогда
				
				СтрокаТаблицы[ИмяКолонкиКЭК] = БухгалтерскиеОперации.КЭКПроводкиСВыборомДтКт(
					Организация,
					ИФО,
					?(ТиражироватьЗначениеКФО, КФО, СтрокаТаблицы[ИмяКолонкиКФО]),
					Дата,
					СчетСсылка,
					ПараметрыЗаполнения.Контрагент,
					,
					,
					ПараметрыЗаполнения.СторонаПроводки);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ИдентификаторГосконтракта

Функция ПолучитьИдентификаторГосконтракта(Договор) Экспорт
	
	СписокДоговоров = Новый Массив();
	СписокДоговоров.Добавить(Договор);
	
	ТаблицаДоговоров = ПолучитьИдентификаторыГосконтрактов(СписокДоговоров);
	
	Если ТаблицаДоговоров.Количество() = 1 Тогда
		ИдентификаторГосконтракта = ТаблицаДоговоров[0].ИдентификаторГосконтракта;
	Иначе
		ИдентификаторГосконтракта = "";
	КонецЕсли;
	
	Возврат ИдентификаторГосконтракта;
	
КонецФункции

Функция ПолучитьИдентификаторыГосконтрактов(СписокДоговоров) Экспорт
	
	ТаблицаДоговоров = ПолучитьТаблицуДоговоров(СписокДоговоров);
	
	// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	Если ЭлектронноеАктированиеЕИС.ИспользоватьЭлектронноеАктированиеВЕИС() Тогда
		ЗаполнитьИзСправочникаГосударственныеКонтракты(ТаблицаДоговоров, СписокДоговоров);
	КонецЕсли;
	// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьКонтрактыПоГособоронзаказу") Тогда
		Возврат ТаблицаДоговоров;
	КонецЕсли;
	
	ЗаполнитьИзСправочникаДоговорыПоГОЗ(ТаблицаДоговоров, СписокДоговоров);
	
	Возврат ТаблицаДоговоров;
	
КонецФункции

#КонецОбласти

#Область СписокПостановленийДляКнигПокупокПродаж

// Для книг покупок и продаж
Процедура ЗаполнитьСписокПостановленийИзменяющихЗаполнениеКниг(ЗаполняемыйСписок, РедакцияПостановления, ОбозначениеКниги) Экспорт
	
	ТаблицаПостановлений = ПолучитьТаблицуПостановленийИзменяющихЗаполнениеКниги(ОбозначениеКниги);
	
	ЗаполняемыйСписок.Очистить();
	
	ЗаполняемыйСписок.ЗагрузитьЗначения(ТаблицаПостановлений.ВыгрузитьКолонку("Представление"));
	
	РедакцияПостановления = ПолучитьПостановлениеПоУмолчаниюДляЗаполненияКниги(ОбозначениеКниги);
	
КонецПроцедуры

// По умолчанию выбирается самое свежее Постановление
Функция ПолучитьПостановлениеПоУмолчаниюДляЗаполненияКниги(ОбозначениеКниги, НаДату = Неопределено) Экспорт
	
	Перем СтрокаПостановления;
	
	ТаблицаПостановлений = ПолучитьТаблицуПостановленийИзменяющихЗаполнениеКниги(ОбозначениеКниги);
	
	Если НаДату = Неопределено Тогда
		СтрокаПостановления = ТаблицаПостановлений[0];
	Иначе
		Для Каждого СтрокаПостановления Из ТаблицаПостановлений Цикл
			Если СтрокаПостановления.ДатаНачалаПрименения <= НаДату Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат СтрокаПостановления.Представление;
	
КонецФункции

#КонецОбласти

#Область Печать

Процедура ПроверитьНаличиеМакетаПечати(ИдентификаторПостановления, ОбщаяТаблицаПостановлений)
	
	Если ИдентификаторПостановления = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Поиск = Новый Структура("Идентификатор", ИдентификаторПостановления);
	
	МассивСтрок = ОбщаяТаблицаПостановлений.НайтиСтроки(Поиск);
	
	Если МассивСтрок.Количество() = 0 Тогда
		
		ТекстШаблон = НСтр("ru='Не удалось определить печатную форму счета-фактуры для редакции ""%1"" постановления'");
		
		ТекстСообщения = СтрШаблон(ТекстШаблон, ИдентификаторПостановления);
		
		ВызватьИсключение ТекстСообщения;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьПрименяемыйМакетПечати(Знач ИдентификаторПостановления, ОбщаяТаблицаПостановлений, Знач ВыборкаШапка, Знач ДанныеДокументов, ПрименяемыйИдентификаторПостановления)
	
	Перем ПризнакиСчетовФактур;
	
	Если ИдентификаторПостановления = Неопределено Тогда
		СтрокаПостановления = ПолучитьСтрокуПостановленияПрименяемойПечатнойФормыСчетаФактуры(ВыборкаШапка.Дата, ОбщаяТаблицаПостановлений);
	Иначе
		Поиск = Новый Структура("Идентификатор", ИдентификаторПостановления);
		
		МассивСтрок = ОбщаяТаблицаПостановлений.НайтиСтроки(Поиск);
		
		СтрокаПостановления = МассивСтрок[0];
	КонецЕсли;
	
	ПрименяемыйИдентификаторПостановления = СтрокаПостановления["Идентификатор"];
	
	Макет = СтрокаПостановления.Макеты[0];
	
	Если СтрокаПостановления.Макеты.Количество() = 2 Тогда
		// Макет определяется признаками документа
		
		ДанныеДокументов.Свойство("ПризнакиСчетовФактур", ПризнакиСчетовФактур);
		
		ПризнакиСчетаФактуры = ПолучитьПризнакиСчетаФактуры(ВыборкаШапка.ДокСсылка, ПризнакиСчетовФактур);
		
		Если ПризнакиСчетаФактуры <> Неопределено И НЕ ПризнакиСчетаФактуры["ЕстьПрослеживаемыйТовар"] Тогда
			Макет = СтрокаПостановления.Макеты[1];
		КонецЕсли;
	КонецЕсли;
	
	Возврат Макет;
	
КонецФункции


Функция ПечатьСчетаФактуры(ДанныеДокументов, СтруктураПараметровОбработчика, ИдентификаторПостановления, ЭтоУПД = Ложь) Экспорт
	
	Перем	ПрименяемыйИдентификаторПостановления,
			СписокОбъектовДляОпределенияАдресов;
	
	ОбщаяТаблицаПостановлений = ПолучитьОбщуюТаблицуПостановленийИзменяющихПечатнуюФормуСчетаФактуры();
	
	ПроверитьНаличиеМакетаПечати(ИдентификаторПостановления, ОбщаяТаблицаПостановлений);
	
	ОбъектыПечати = СтруктураПараметровОбработчика["ОбъектыПечати"];
	
	// Возвращаемый документ
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.ИмяПараметровПечати = "СчетФактура_ПараметрыПечати";
	
	// Данные документов для распечатки
	ВыборкаШапка							= ДанныеДокументов["ВыборкаШапка"];
	ОбщаяТаблицаСоставНФА					= ДанныеДокументов["ОбщаяТаблицаСоставНФА"];
	ВыборкаДокПлатежноРасчетныеДокументы	= ДанныеДокументов["ВыборкаДокПлатежноРасчетныеДокументы"];
	ВыборкаДокПокупатели	= ДанныеДокументов["ВыборкаПокупатели"];
	
	// Определим адреса сторон с помощью подсистемы "Контактная информация"
	Если ДанныеДокументов.Свойство("СписокОбъектовДляОпределенияАдресов", СписокОбъектовДляОпределенияАдресов)
		И СписокОбъектовДляОпределенияАдресов.Количество() > 0 Тогда
		
		ОбщаяКонтактнаяИнформация = ПолучитьОбщуюКонтактнуюИнформациюПродавцаПокупателяГрузоотправителяГрузополучателя(СписокОбъектовДляОпределенияАдресов);
		
	Иначе
		ОбщаяКонтактнаяИнформация = Неопределено;
	КонецЕсли;
	
	// Выборки по документам:
	ПервыйДокумент = Истина;
	Пока ВыборкаШапка.Следующий() Цикл
		
		Если ВыборкаШапка.ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.СчетФактураНаАвансОтКомитента
			ИЛИ ВыборкаШапка.ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.СчетФактураНаРеализациюОтКомитента Тогда
			Продолжить;
		КонецЕсли;
		
		Макет = ПолучитьПрименяемыйМакетПечати(
			ИдентификаторПостановления,
			ОбщаяТаблицаПостановлений,
			ВыборкаШапка,
			ДанныеДокументов,
			ПрименяемыйИдентификаторПостановления);
		
		ДобавитьПризнакиПрименяемогоПостановления(ДанныеДокументов, ПрименяемыйИдентификаторПостановления);
		
		// Используемые области макета.
		ОбластьМакетаШапка				= Макет.ПолучитьОбласть("Шапка");
		ОбластьМакетаЗаголовокТаблицы	= Макет.ПолучитьОбласть("ЗаголовокТаблицы");
		ОбластьМакетаСтрока				= Макет.ПолучитьОбласть("Строка");
		ОбластьМакетаИтого				= Макет.ПолучитьОбласть("Итого");
		ОбластьМакетаПодвал				= Макет.ПолучитьОбласть("Подвал");
		
		// Продвигаемся в остальных выборках до текущего документа:
		ПоискТекущегоДокумента = Новый Структура("ДокСсылка", ВыборкаШапка["ДокСсылка"]);
		ВыборкаДокПлатежноРасчетныеДокументы.Сбросить();
		ЕстьВыборкаДокПлатежноРасчетныеДокументы	= ВыборкаДокПлатежноРасчетныеДокументы.НайтиСледующий(ПоискТекущегоДокумента);
		
		Поиск = Новый Структура("Ссылка", ВыборкаШапка.ДокСсылка);
		ТаблицаСоставНФА = ОбщаяТаблицаСоставНФА.Скопировать(Поиск);
		
		Если НЕ ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент		= Ложь;
		НомерСтрокиНачало	= ТабДокумент.ВысотаТаблицы + 1;
		
		Если ТипЗнч(ВыборкаШапка.ДокСсылка) = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
			// Не предусмотрена корректная печать полученных счетов-фактур.
			// В документах не хранится достаточно информации для корректной печати.
			Попытка
				ОбластьКомментарийПолученныйСФ = Макет.ПолучитьОбласть("КомментарийПолученныйСФ");
				ТабДокумент.Вывести(ОбластьКомментарийПолученныйСФ);
			Исключение
			КонецПопытки;
		КонецЕсли;
		
		//---
		// Шапка
		//---
		ВыборкаПлатежноРасчетныеДокументы = ВыборкаДокПлатежноРасчетныеДокументы.Выбрать();
		
		ПечатьСчетаФактуры_ЗаполнитьШапку(ВыборкаШапка, ТаблицаСоставНФА, ВыборкаПлатежноРасчетныеДокументы, ОбластьМакетаШапка, ОбщаяКонтактнаяИнформация, ДанныеДокументов, ЭтоУПД, ВыборкаДокПокупатели);
		
		ТабДокумент.Вывести(ОбластьМакетаШапка);
		
		//---
		// Таблица
		//---
		ТабДокумент.Вывести(ОбластьМакетаЗаголовокТаблицы);
		ШапкаДокумента = Новый Структура("ПричинаНалогообложения", ВыборкаШапка["ПричинаНалогообложения"]);
		Для Каждого СтрокаТаблицыНФА Из ТаблицаСоставНФА Цикл
			Если ДанныеДокументов.ПризнакиПрименяемогоПостановления.ПредусмотреныПоказателиПрослеживаемости Тогда
				ПечатьСчетаФактуры_ВывестиСтрокуТаблицы_534(СтрокаТаблицыНФА, ШапкаДокумента, ТабДокумент, ОбластьМакетаСтрока, ДанныеДокументов, ПрименяемыйИдентификаторПостановления);
			Иначе
				Если ПрименяемыйИдентификаторПостановления = "981" Тогда
					ПечатьСчетаФактуры_ЗаполнитьСтрокуТаблицы_981(СтрокаТаблицыНФА, ШапкаДокумента, ОбластьМакетаСтрока);
				Иначе
					ПечатьСчетаФактуры_ЗаполнитьСтрокуТаблицы(СтрокаТаблицыНФА, ШапкаДокумента, ОбластьМакетаСтрока);
				КонецЕсли;
				
				ТабДокумент.Вывести(ОбластьМакетаСтрока);
			КонецЕсли;
		КонецЦикла;	
		
		Если ДанныеДокументов.Свойство("КонтекстПечати") Тогда
			ДанныеДокументов.Удалить("КонтекстПечати");
		КонецЕсли;
		
		//---
		// Итого
		//---
		ЗначенияИтого = Новый Структура("ИтогоСтоимость, ИтогоСуммаНДС, ИтогоВсего",
			ТаблицаСоставНФА.Итог("Стоимость"),
			ТаблицаСоставНФА.Итог("СуммаНДС"),
			ТаблицаСоставНФА.Итог("Всего"));
		ПечатьСчетаФактуры_ЗаполнитьИтогоТаблицы(ВыборкаШапка, ЗначенияИтого, ОбластьМакетаИтого);
		ТабДокумент.Вывести(ОбластьМакетаИтого);
		
		//---	
		// Подвал
		//---
		ЗначенияПараметров = Новый Структура();
		
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ВыборкаШапка, "Руководитель") Тогда
			Руководитель = ВыборкаШапка["Руководитель"];
			
			Если ТипЗнч(Руководитель) = Тип("Строка") Тогда
				ФИОРуководителя = Руководитель;
			Иначе
				ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество",
					Руководитель,
					ВыборкаШапка["Дата"]);
				Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
				ФИОРуководителя = КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина);
			КонецЕсли;
			
			ЗначенияПараметров.Вставить("ФИОРуководителя", ФИОРуководителя);
		КонецЕсли;
		
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ВыборкаШапка, "ГлавныйБухгалтер") Тогда
			ГлавныйБухгалтер = ВыборкаШапка["ГлавныйБухгалтер"];
			
			Если ТипЗнч(ГлавныйБухгалтер) = Тип("Строка") Тогда
				ФИОГлавногоБухгалтера = ГлавныйБухгалтер;
			Иначе
				ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество",
					ГлавныйБухгалтер,
					ВыборкаШапка["Дата"]);
				Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
				ФИОГлавногоБухгалтера = КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина);
			КонецЕсли;
			
			ЗначенияПараметров.Вставить("ФИОГлавногоБухгалтера", ФИОГлавногоБухгалтера);
		КонецЕсли;
		
		ОбластьМакетаПодвал.Параметры.Заполнить(ЗначенияПараметров);
		
		ТабДокумент.Вывести(ОбластьМакетаПодвал);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(
			ТабДокумент, 
			НомерСтрокиНачало,
			ОбъектыПечати,
			ВыборкаШапка.ДокСсылка);
	КонецЦикла;												   
	
	Возврат ТабДокумент;
	
КонецФункции		

Процедура ДобавитьПризнакиПрименяемогоПостановления(ДанныеДокументов, ИдентификаторПостановления)
	
	ПризнакиПрименяемогоПостановления = Новый Структура();
	
	ПризнакиПрименяемогоПостановления.Вставить("ПредусмотреныПоказателиПрослеживаемости",
		(ИдентификаторПостановления = "26"
		Или ИдентификаторПостановления = "2026"
		Или ИдентификаторПостановления = "1096"
		Или ИдентификаторПостановления = "2023Кв4Прослеж"
		Или ИдентификаторПостановления = "534"));
	
	ПризнакиПрименяемогоПостановления.Вставить("ПредусмотренПоказательСтоимостиПрослеживаемогоТовара",
		(ИдентификаторПостановления = "26"
		Или ИдентификаторПостановления = "2026"
		Или ИдентификаторПостановления = "1096"
		Или ИдентификаторПостановления = "2023Кв4Прослеж"));
		
	ДанныеДокументов.Вставить("ПризнакиПрименяемогоПостановления", ПризнакиПрименяемогоПостановления);
	
//("ПостановлениемПредусмотренПоказательСчетаФактурыНаАванс",
//		ПараметрыОтчета.РедакцияПостановления = "№ 26 от 23.01.2026");
//	
//	ПараметрыОтчета.Вставить("Постановлением

КонецПроцедуры

Процедура ПечатьСчетаФактуры_ЗаполнитьШапку(ВыборкаШапка, ТаблицаСоставНФА, ВыборкаПлатежноРасчетныеДокументы, ОбластьМакетаШапка, ОбщаяКонтактнаяИнформация, ДанныеДокументов, ЭтоУПД, ВыборкаДокПокупатели)
	
	Перем ПризнакиСчетовФактур;
	
	// Подготовка
	ПричинаНалогообложения = ВыборкаШапка["ПричинаНалогообложения"];
	ЭтоАванс			=  УчетНДСПовтИсп.Аванс(ПричинаНалогообложения);
	ЭтоНалоговыйАгентП2 = (ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.ПокупкаУНерезидентаНалоговыйАгент);
	ЭтоНалоговыйАгентП3 = (ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.ПокупкаНалоговыйАгент);
	ЭтоНалоговыйАгент	= УчетНДСПовтИсп.НалоговыйАгент(ПричинаНалогообложения);
	СчетФактураКомитентаНаРеализацию = (ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.СчетФактураКомитентаНаРеализацию);
	СчетФактураКомиссионераНаПокупку = (ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.СчетФактураКомиссионераНаПокупку
		ИЛИ ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.СчетФактураКомиссионераНаАванс);
	
	ДанныеДокументов.Свойство("ПризнакиСчетовФактур", ПризнакиСчетовФактур);
	
	ПризнакиСчетаФактуры = ПолучитьПризнакиСчетаФактуры(ВыборкаШапка.ДокСсылка, ПризнакиСчетовФактур);
	
	Если ПризнакиСчетаФактуры <> Неопределено Тогда
		ТолькоРаботыИУслуги = ПризнакиСчетаФактуры["ТолькоРаботыУслугиПраваПользования"];
	Иначе
		ТолькоРаботыИУслуги = Ложь;
	КонецЕсли;
	
	СимволПрочерка = "---";
	
	СтороныСделки = ОпределитьПродавцаПокупателяГрузоотправителяГрузополучателя(ВыборкаШапка, ОбщаяКонтактнаяИнформация);
	
	Если СчетФактураКомитентаНаРеализацию И ТипЗнч(ВыборкаШапка.ДокСсылка) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда 
		ПараметрыДляСводногоСчетаФактуры = ПолучитьПараметрыСводногоСчетаФактурыКомиссияПоПродаже(ВыборкаШапка.ДокСсылка, ВыборкаДокПокупатели, ОбщаяКонтактнаяИнформация)
	КонецЕсли;
	
	Если СчетФактураКомиссионераНаПокупку И ТипЗнч(ВыборкаШапка.ДокСсылка) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		ПараметрыДляСводногоСчетаФактуры = ПолучитьПараметрыСводногоСчетаФактурыКомиссияПоЗакупке(ВыборкаШапка.ДокСсылка, ВыборкаДокПокупатели, ОбщаяКонтактнаяИнформация)
	КонецЕсли;
	
	ДетальнаяЗапись = Новый Структура("
		|Номер,
		|НомерКСФ,
		|ИмяДокумента,
		|ИмяИсправляемогоДокумента,
		|ВидОбособленногоПодразделения,
		|НДСИндексПодразделения");
	
	ЗаполнитьЗначенияСвойств(ДетальнаяЗапись, ВыборкаШапка);
	
	Если ТипЗнч(ВыборкаШапка.ДокСсылка) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		
		ДетальнаяЗапись.Вставить("ИмяДокумента",				"СчетФактураВыданный");
		ДетальнаяЗапись.Вставить("ИмяИсправляемогоДокумента",	"");
		
	ИначеЕсли ТипЗнч(ВыборкаШапка.ДокСсылка) = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный") Тогда
		
		ДетальнаяЗапись.Вставить("ИмяДокумента",				"ИсправительныйСчетФактураВыданный");
		ДетальнаяЗапись.Вставить("ИмяИсправляемогоДокумента",	"СчетФактураВыданный");
		
	КонецЕсли;
	
	НомерСФ = ОпределитьНомерСФДляВыводаВРегистрыУчета(ДетальнаяЗапись);
	
	НомерДокумента = НомерСФ["Номер"];
	
	ЗначенияПараметров = Новый Структура();
	
	// 1
	ЗначенияПараметров.Вставить("Номер", НомерДокумента);
	ЗначенияПараметров.Вставить("Дата", ВыборкаШапка["Дата"]);
	
	// 1а
	Если ТипЗнч(ВыборкаШапка.ДокСсылка) = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный") Тогда
		ЗначенияПараметров.Вставить("НомерИсправления", ВыборкаШапка["НомерИсправления"]);
		ЗначенияПараметров.Вставить("ДатаИсправления",	ВыборкаШапка["ДатаИсправления"]);
	Иначе
		ЗначенияПараметров.Вставить("НомерИсправления", СимволПрочерка);
		ЗначенияПараметров.Вставить("ДатаИсправления",	СимволПрочерка);
	КонецЕсли;
	
	// 2
	Если СчетФактураКомиссионераНаПокупку И ТипЗнч(ВыборкаШапка.ДокСсылка) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		ЗначенияПараметров.Вставить("Продавец", ПараметрыДляСводногоСчетаФактуры["ПредставлениеПродавца"]);
	Иначе
		ЗначенияПараметров.Вставить("Продавец", СтороныСделки["Продавец"]["Наименование"])
	КонецЕсли;
	
	// 2а
	Если СчетФактураКомиссионераНаПокупку И ТипЗнч(ВыборкаШапка.ДокСсылка) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		ЗначенияПараметров.Вставить("АдресПродавца", ПараметрыДляСводногоСчетаФактуры["АдресПродавца"]);
	Иначе
		ЗначенияПараметров.Вставить("АдресПродавца", СтороныСделки["Продавец"]["Адрес"].Представление);
	КонецЕсли;
	
	// 2б
	Если ЭтоНалоговыйАгентП2 Тогда
		ПродавецИНН = СимволПрочерка;
		ПродавецКПП = СимволПрочерка;
		ПродавецИННКПП = СимволПрочерка;
	ИначеЕсли СчетФактураКомиссионераНаПокупку И ТипЗнч(ВыборкаШапка.ДокСсылка) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		ПродавецИНН = СтороныСделки["Продавец"]["ИНН"];
		ПродавецКПП = СтороныСделки["Продавец"]["КПП"];
		ПродавецИННКПП = ПараметрыДляСводногоСчетаФактуры["ИННКПППродавца"];
	Иначе
		ПродавецИНН = СтороныСделки["Продавец"]["ИНН"];
		ПродавецКПП = СтороныСделки["Продавец"]["КПП"];
		ПродавецИННКПП = Строка(СтороныСделки["Продавец"]["ИНН"]) + " / " + Строка(СтороныСделки["Продавец"]["КПП"]);
	КонецЕсли;
	ЗначенияПараметров.Вставить("ИННПродавца", ПродавецИНН);
	ЗначенияПараметров.Вставить("КПППродавца", ПродавецКПП);
	ЗначенияПараметров.Вставить("ИННКПППродавца", ПродавецИННКПП);

	// 3
	Если ТолькоРаботыИУслуги ИЛИ ЭтоНалоговыйАгент ИЛИ ЭтоАванс Тогда
		Грузоотправитель = СимволПрочерка;
	ИначеЕсли СчетФактураКомиссионераНаПокупку И ТипЗнч(ВыборкаШапка.ДокСсылка) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		Грузоотправитель = ПараметрыДляСводногоСчетаФактуры["Грузоотправитель"];
	ИначеЕсли СчетФактураКомиссионераНаПокупку И ТипЗнч(ВыборкаШапка.ДокСсылка) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		Грузополучатель = СтороныСделки["Продавец"]["Наименование"] + "," + СтороныСделки["Продавец"]["Адрес"].Представление;
	Иначе
		Если СтороныСделки["Грузоотправитель"]["СовпадаетСПродавцом"] Тогда
			Грузоотправитель = НСтр("ru='он же'");
		Иначе
			Грузоотправитель = СтороныСделки["Грузоотправитель"]["Наименование"]
				+ ", " + СтороныСделки["Грузоотправитель"]["Адрес"].Представление;
		КонецЕсли;
	КонецЕсли;
	ЗначенияПараметров.Вставить("Грузоотправитель", Грузоотправитель);
	
	// 4
	Если ТолькоРаботыИУслуги ИЛИ ЭтоНалоговыйАгент ИЛИ ЭтоАванс Тогда
		Грузополучатель = СимволПрочерка;
	ИначеЕсли СчетФактураКомитентаНаРеализацию И ТипЗнч(ВыборкаШапка.ДокСсылка) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		Грузополучатель = ПараметрыДляСводногоСчетаФактуры["Грузополучатель"];
	ИначеЕсли СчетФактураКомиссионераНаПокупку И ТипЗнч(ВыборкаШапка.ДокСсылка) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		Грузополучатель = СтороныСделки["Продавец"]["Наименование"] + "," + СтороныСделки["Продавец"]["Адрес"].Представление;
	Иначе
		Грузополучатель = СтороныСделки["Грузополучатель"]["Наименование"]
				+ ", " + СтороныСделки["Грузополучатель"]["Адрес"].Представление;
	КонецЕсли;
	ЗначенияПараметров.Вставить("Грузополучатель", Грузополучатель);
	
	// 5
	ПредставлениеПРД = "№%1 от %2";
	РазделительПРД = ", ";
	Если ВыборкаПлатежноРасчетныеДокументы.Количество() = 0 Тогда
		ПлатежноРасчетныйДокумент = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ПредставлениеПРД,
			"", "");
	Иначе	
		ПлатежноРасчетныйДокумент = "";
		ЭтоПервыйЭлемент = Истина;
		Пока ВыборкаПлатежноРасчетныеДокументы.Следующий() Цикл
			ПлатежноРасчетныйДокумент = ПлатежноРасчетныйДокумент
				+ ?(ЭтоПервыйЭлемент, "", РазделительПРД)
				+ СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ПредставлениеПРД,
					ВыборкаПлатежноРасчетныеДокументы["НомерДокумента"],
					Формат(ВыборкаПлатежноРасчетныеДокументы["ДатаДокумента"], "ДЛФ=Д"));
			ЭтоПервыйЭлемент = Ложь;
		КонецЦикла;	
	КонецЕсли;
	ЗначенияПараметров.Вставить("ПлатежноРасчетныйДокумент", ПлатежноРасчетныйДокумент);
	
	// 5а
	ДокументыОбОтгрузке = ПолучитьСведенияДокументыОбОтгрузкеПечать(ВыборкаШапка, ТаблицаСоставНФА, ДанныеДокументов, НомерДокумента, ЭтоУПД);
	ЗначенияПараметров.Вставить("ДокументыОбОтгрузке", ДокументыОбОтгрузке);
	
	// 5б
	ЗначенияПараметров.Вставить("СчетаФактурыНаАванс", ПолучитьСведенияСчетаФактурыНаАвансПечать(ВыборкаШапка, ДанныеДокументов));
	
	// 6
	Если СчетФактураКомитентаНаРеализацию И ТипЗнч(ВыборкаШапка.ДокСсылка) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		ЗначенияПараметров.Вставить("Покупатель", ПараметрыДляСводногоСчетаФактуры["ПредставлениеПокупателя"]);
	Иначе
		ЗначенияПараметров.Вставить("Покупатель", СтороныСделки["Покупатель"]["Наименование"]);
	КонецЕсли;;
		
	// 6а
	Если СчетФактураКомитентаНаРеализацию И ТипЗнч(ВыборкаШапка.ДокСсылка) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		ЗначенияПараметров.Вставить("АдресПокупателя", ПараметрыДляСводногоСчетаФактуры["АдресПокупателя"]);
	Иначе
		ЗначенияПараметров.Вставить("АдресПокупателя", СтороныСделки["Покупатель"]["Адрес"].Представление);
	КонецЕсли;
	
	// 6б
	Если СчетФактураКомитентаНаРеализацию И ТипЗнч(ВыборкаШапка.ДокСсылка) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		
		ПокупательИННКПП = ПараметрыДляСводногоСчетаФактуры["ИННКПППокупателя"];
		ЗначенияПараметров.Вставить("ИННКПППокупателя", ПокупательИННКПП);
		
	Иначе
		
