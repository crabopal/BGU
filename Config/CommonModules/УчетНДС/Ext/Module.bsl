	ИнициализироватьРеквизитыСуммДокументов_2_0_39(Параметры);
	
КонецПроцедуры
Процедура ИнициализироватьРеквизитыСуммДокументов_2_0_39(ПараметрыОтложенногоОбработчика = Неопределено)
	
	Перем	ЭтоОтложенноеВыполнение,
			ЭтоПервоеОтложенноеВыполнение,
			
			// Статистика обработки
			СчетчикДокументовОК,
			СчетчикДокументовОшибка,
			СчетчикДокументовТекущегоВидаОК,
			СчетчикДокументовТекущегоВидаОшибка;
	
	// Настройки массовой обработки документов (каждого вида)
	КоличествоДокументовОбрабатываемыхМонопольноСтрока			= "100";
	КоличествоДокументовОбрабатываемыхВИтерацииОтложенноСтрока	= "100";
	
	// Тексты сообщений для вывода в журнал регистрации
	ОбозначениеОбработки				= "#ЗаполнениеИтоговыхСумм";
	ИмяСобытия							= НСтр("ru='Данные. Изменение'");
	ШаблонДокументОшибка				= НСтр("ru='[ОбозначениеОбработки] - Ошибка при обработке документа [ДокументСсылка] ([ОписаниеОшибки]) [РежимЗапуска]'");
	ШаблонДокументыКоличествоУспехов	= НСтр("ru='[ОбозначениеОбработки] - Успешно обработано [Количество] документов [СинонимДокумента] [РежимЗапуска]'");
	ШаблонДокументыКоличествоОшибок		= НСтр("ru='[ОбозначениеОбработки] - Возникло [Количество] ошибок при обработке документов [СинонимДокумента] [РежимЗапуска]'");
	ШаблонДокументыОтсутствуютДанные	= НСтр("ru='[ОбозначениеОбработки] - Документов [СинонимДокумента], подлежащих обработке, не обнаружено [РежимЗапуска]'");
	ШаблонОбщийОшибкаБлокировки			= НСтр("ru='[ОбозначениеОбработки] - Не удалось заблокировать документы для модификации ([ОписаниеОшибки]) [РежимЗапуска]'");
	ШаблонОбщийОтсутствуютДанные		= НСтр("ru='[ОбозначениеОбработки] - Документов, подлежащих обработке, не обнаружено [РежимЗапуска]'");
	ШаблонОбщийКоличествоНеобработанных	= НСтр("ru='[ОбозначениеОбработки] - Осталось [Количество] необработанных документов [РежимЗапуска]'");
	
	// Используемые вставляемые значения
	//	[ДокументСсылка]
	//	[Количество]
	//	[ОбозначениеОбработки]
	//	[ОписаниеОшибки]
	//	[РежимЗапуска]
	//	[СинонимДокумента]
	
	// Статистика обработки
	СчетчикДокументовОК					= 0;
	СчетчикДокументовОшибка				= 0;
	СчетчикДокументовТекущегоВидаОК		= 0;
	СчетчикДокументовТекущегоВидаОшибка	= 0;
	
	ЭтоОтложенноеВыполнение = (ТипЗнч(ПараметрыОтложенногоОбработчика) = Тип("Структура"));
	
	ЭтоПервоеОтложенноеВыполнение = (ЭтоОтложенноеВыполнение И ПараметрыОтложенногоОбработчика.Количество() = 0);
	
	Если ЭтоОтложенноеВыполнение Тогда
		// Свойства от БСП
		Если НЕ ПараметрыОтложенногоОбработчика.Свойство("ПрогрессВыполнения") Тогда
			ПараметрыОтложенногоОбработчика.Вставить("ПрогрессВыполнения", Новый Структура());
			ПараметрыОтложенногоОбработчика["ПрогрессВыполнения"].Вставить("ВсегоОбъектов",			0);
			ПараметрыОтложенногоОбработчика["ПрогрессВыполнения"].Вставить("ОбработаноОбъектов",	0);
		КонецЕсли;
		
		// Свойства этого обработчика
		Если НЕ ПараметрыОтложенногоОбработчика.Свойство("НомерЗапуска") Тогда
			ПараметрыОтложенногоОбработчика.Вставить("НомерЗапуска", 1);
		Иначе
			ПараметрыОтложенногоОбработчика["НомерЗапуска"] = ПараметрыОтложенногоОбработчика["НомерЗапуска"] + 1;
		КонецЕсли;
		Если НЕ ПараметрыОтложенногоОбработчика.Свойство("УспешноОбработанныеДокументы") Тогда
			ПараметрыОтложенногоОбработчика.Вставить("УспешноОбработанныеДокументы", Новый Массив());
		КонецЕсли;
		
		РежимЗапускаСтрока = "(отложенный запуск, "
			+ Строка(ПараметрыОтложенногоОбработчика["НомерЗапуска"]) + ")";
		
		ТекстПервыеN		= КоличествоДокументовОбрабатываемыхВИтерацииОтложенноСтрока;
		ТекстУпорядочить	= "";
	Иначе
		РежимЗапускаСтрока = "(монопольный запуск)";
		
		ТекстПервыеN		= КоличествоДокументовОбрабатываемыхМонопольноСтрока;
		ТекстУпорядочить	= "
			|УПОРЯДОЧИТЬ ПО
			|	Ссылка.Дата УБЫВ";
	КонецЕсли;
	
	ЗапросЗаполнение = Новый Запрос();
	ЗапросЗаполнение.УстановитьПараметр("ВалютаРубль", Константы.ВалютаРегламентированногоУчета.Получить());
	ЗапросЗаполнение.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Документы счетов-фактур, потенциально с незаполненными реквизитами сумм
	|//		(т.к. были созданы из ввода начальных остатков)
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СчетФактура	КАК Ссылка
	|ПОМЕСТИТЬ
	|	СчетаФактурыИзВводаОстатков
	|ИЗ
	|	Документ.ВводНачальныхОстатков.НДС
	|ГДЕ
	|	Ссылка.РазделУчета = ЗНАЧЕНИЕ(Перечисление.РазделыУчетаДляВводаОстатков.НДС)
	|	И	НЕ СчетФактура.Проведен
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Все счета-фактуры выданные, требующие обработки
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка			КАК Ссылка,
	|	Ссылка.Дата		КАК Дата,
	|	СУММА(Всего)	КАК СуммаДокумента,
	|	СУММА(СуммаНДС)	КАК СуммаНДС
	|ПОМЕСТИТЬ
	|	ВсеСчетаФактурыВыданные
	|ИЗ
	|	Документ.СчетФактураВыданный.СоставНФА
	|ГДЕ
	|	Ссылка В (ВЫБРАТЬ Ссылка ИЗ СчетаФактурыИзВводаОстатков)
	|	// Первая часть признака необработанного документа:
	|	И	Ссылка.СуммаДокумента = 0
	|	И	Ссылка.СуммаНДС = 0
	|СГРУППИРОВАТЬ ПО
	|	Ссылка
	|ИМЕЮЩИЕ
	|	// Вторая часть признака необработанного документа:
	|	НЕ (СУММА(Всего) = 0 И СУММА(СуммаНДС) = 0)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Счета-фактуры выданные, требующие обработки
	|//		при очередном запуске обработчика обновления
	|//		(Финальная таблица для дальнейшей обработки)
	|//
	|ВЫБРАТЬ ПЕРВЫЕ " + ТекстПервыеN + "
	|	Ссылка			КАК Ссылка,
	|	СуммаДокумента	КАК СуммаДокумента,
	|	СуммаНДС		КАК СуммаНДС
	|ИЗ
	|	ВсеСчетаФактурыВыданные
	|" + ТекстУпорядочить + "
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Счета-фактуры полученные, требующие обработки
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка			КАК Ссылка,
	|	Ссылка.Дата		КАК Дата,
	|	СУММА(Всего)	КАК СуммаДокумента,
	|	СУММА(СуммаНДС)	КАК СуммаНДС
	|ПОМЕСТИТЬ
	|	ВсеСчетаФактурыПолученные
	|ИЗ
	|	Документ.СчетФактураПолученный.СоставНФА
	|ГДЕ
	|	Ссылка В (ВЫБРАТЬ Ссылка ИЗ СчетаФактурыИзВводаОстатков)
	|	// Первая часть признака необработанного документа:
	|	И	Ссылка.СуммаДокумента = 0
	|	И	Ссылка.СуммаНДС = 0
	|СГРУППИРОВАТЬ ПО
	|	Ссылка
	|ИМЕЮЩИЕ
	|	// Вторая часть признака необработанного документа:
	|	НЕ (СУММА(Всего) = 0 И СУММА(СуммаНДС) = 0)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [4]. Счета-фактуры полученные, требующие обработки
	|//		при очередном запуске обработчика обновления
	|//		(Финальная таблица для дальнейшей обработки)
	|//
	|ВЫБРАТЬ ПЕРВЫЕ " + ТекстПервыеN + "
	|	Ссылка			КАК Ссылка,
	|	СуммаДокумента	КАК СуммаДокумента,
	|	СуммаНДС		КАК СуммаНДС
	|ИЗ
	|	ВсеСчетаФактурыПолученные
	|" + ТекстУпорядочить + "
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [5]. Все документы ГТДИмпорт, подлежащие обработке
	|//		Пересчитываем по курсу уже итоговые суммы после суммирования всех разделов
	|//		по каждой используемой валюте, а не детальные суммы по каждому разделу отдельно.
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка								КАК Ссылка,
	|	Ссылка.Дата							КАК Дата,
	|	
	|	// Для таможенной стоимости в документе указывается одна валюта - 
	|	// - ""Валюта оценки таможенной стоимости"" = ВалютаТаможеннойСтоимости
	|	// Всегда указывается только валютная сумма, рублевая сумма не указывается
	|	ВЫБОР
	|		КОГДА Ссылка.ВалютаТаможеннойСтоимости = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) ТОГДА
	|			&ВалютаРубль
	|		ИНАЧЕ
	|			Ссылка.ВалютаТаможеннойСтоимости
	|	КОНЕЦ								КАК ВалютаТаможеннойСтоимости,
	|	ВЫБОР
	|		КОГДА Ссылка.ВалютаТаможеннойСтоимости = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) ТОГДА
	|			1
	|		ИНАЧЕ
	|			Ссылка.КурсВалютыТаможеннойСтоимости
	|	КОНЕЦ								КАК КурсВалютыТаможеннойСтоимости,
	|	ВЫБОР
	|		КОГДА Ссылка.ВалютаТаможеннойСтоимости = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) ТОГДА
	|			1
	|		ИНАЧЕ
	|			Ссылка.КратностьВалютыТаможеннойСтоимости
	|	КОНЕЦ								КАК КратностьВалютыТаможеннойСтоимости,
	|	СУММА(ТаможеннаяСтоимость)			КАК ТаможеннаяСтоимость,
	|	
	|	// Для пошлины и НДС в документе указывается другая валюта - 
	|	// - ""Валюта таможенных платежей"" = ВалютаДокумента
	|	// Может быть указана как рублевая, так и валютная сумма
	|	ВЫБОР
	|		КОГДА Ссылка.ВалютаДокумента = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) ТОГДА
	|			&ВалютаРубль
	|		ИНАЧЕ
	|			Ссылка.ВалютаДокумента
	|	КОНЕЦ								КАК ВалютаПошлины,
	|	ВЫБОР
	|		КОГДА Ссылка.ВалютаДокумента = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) ТОГДА
	|			1
	|		ИНАЧЕ
	|			Ссылка.Курс
	|	КОНЕЦ								КАК КурсВалютыПошлины,
	|	ВЫБОР
	|		КОГДА Ссылка.ВалютаДокумента = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) ТОГДА
	|			1
	|		ИНАЧЕ
	|			Ссылка.Кратность
	|	КОНЕЦ								КАК КратностьВалютыПошлины,
	|	СУММА(ВЫБОР
	|		КОГДА ПошлинаВВалюте ТОГДА
	|			СуммаПошлины
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ)								КАК СуммаПошлиныВалютная,
	|	СУММА(ВЫБОР
	|		КОГДА ПошлинаВВалюте ТОГДА
	|			0
	|		ИНАЧЕ
	|			СуммаПошлины
	|	КОНЕЦ)								КАК СуммаПошлиныРублевая,
	|	ВЫБОР
	|		КОГДА Ссылка.ВалютаДокумента = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) ТОГДА
	|			&ВалютаРубль
	|		ИНАЧЕ
	|			Ссылка.ВалютаДокумента
	|	КОНЕЦ								КАК ВалютаНДС,
	|	ВЫБОР
	|		КОГДА Ссылка.ВалютаДокумента = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) ТОГДА
	|			1
	|		ИНАЧЕ
	|			Ссылка.Курс
	|	КОНЕЦ								КАК КурсВалютыНДС,
	|	ВЫБОР
	|		КОГДА Ссылка.ВалютаДокумента = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) ТОГДА
	|			1
	|		ИНАЧЕ
	|			Ссылка.Кратность
	|	КОНЕЦ								КАК КратностьВалютыНДС,
	|	СУММА(ВЫБОР
	|		КОГДА НДСВВалюте ТОГДА
	|			СуммаНДС
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ)								КАК СуммаНДСВалютная,
	|	СУММА(ВЫБОР
	|		КОГДА НДСВВалюте ТОГДА
	|			0
	|		ИНАЧЕ
	|			СуммаНДС
	|	КОНЕЦ)								КАК СуммаНДСРублевая
	|ПОМЕСТИТЬ
	|	ВсеГТДИмпорт
	|ИЗ
	|	Документ.ГТДИмпорт.Разделы
	|ГДЕ
	|	// Первая часть признака необработанного документа:
	|	Ссылка.ТаможеннаяСтоимость = 0
	|СГРУППИРОВАТЬ ПО
	|	Ссылка
	|ИМЕЮЩИЕ
	|	// Вторая часть признака необработанного документа:
	|	НЕ СУММА(ТаможеннаяСтоимость) = 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [6]. Документы ГТДИмпорт, подлежащие обработке
	|//		при очередном запуске обработчика обновления
	|//		(Финальная таблица для дальнейшей обработки)
	|//
	|ВЫБРАТЬ ПЕРВЫЕ " + ТекстПервыеN + "
	|	Ссылка										КАК Ссылка,
	|	ТаможеннаяСтоимость							КАК ТаможеннаяСтоимость,
	|	ВЫРАЗИТЬ(
	|		// Валютная сумма пошлины
	|		ВЫБОР
	|			КОГДА ВалютаПошлины = ВалютаТаможеннойСтоимости ТОГДА
	|				СуммаПошлиныВалютная
	|			КОГДА КратностьВалютыПошлины = 0 ИЛИ КурсВалютыТаможеннойСтоимости = 0 ТОГДА
	|				0
	|			ИНАЧЕ
	|				// Пересчитываем по кросс-курсу
	|				(СуммаПошлиныВалютная * КурсВалютыПошлины / КратностьВалютыПошлины) * (КратностьВалютыТаможеннойСтоимости / КурсВалютыТаможеннойСтоимости)
	|		КОНЕЦ
	|		+
	|		// Рублевая сумма пошлины
	|		ВЫБОР
	|			КОГДА КурсВалютыТаможеннойСтоимости = 0 ТОГДА
	|				0
	|			ИНАЧЕ
	|				// Пересчитываем по обычному курсу
	|				СуммаПошлиныРублевая * (КратностьВалютыТаможеннойСтоимости / КурсВалютыТаможеннойСтоимости)
	|		КОНЕЦ	КАК ЧИСЛО(18,2))				КАК СуммаПошлиныВВалютеТаможеннойСтоимости,
	|	
	|	ВЫРАЗИТЬ(
	|		// Валютная сумма НДС
	|		ВЫБОР
	|			КОГДА ВалютаНДС = ВалютаТаможеннойСтоимости ТОГДА
	|				СуммаНДСВалютная
	|			КОГДА КратностьВалютыНДС = 0 ИЛИ КурсВалютыТаможеннойСтоимости = 0 ТОГДА
	|				0
	|			ИНАЧЕ
	|				// Пересчитываем по кросс-курсу
	|				(СуммаНДСВалютная * КурсВалютыНДС / КратностьВалютыНДС) * (КратностьВалютыТаможеннойСтоимости / КурсВалютыТаможеннойСтоимости)
	|		КОНЕЦ
	|		+
	|		// Рублевая сумма НДС
	|		ВЫБОР
	|			КОГДА КурсВалютыТаможеннойСтоимости = 0 ТОГДА
	|				0
	|			ИНАЧЕ
	|				// Пересчитываем по обычному курсу
	|				СуммаНДСРублевая * (КратностьВалютыТаможеннойСтоимости / КурсВалютыТаможеннойСтоимости)
	|		КОНЕЦ	КАК ЧИСЛО(18,2))				КАК СуммаНДСВВалютеТаможеннойСтоимости,
	|	
	|	ВЫРАЗИТЬ(
	|		// Валютная сумма НДС
	|		ВЫБОР
	|			КОГДА КратностьВалютыНДС = 0 ТОГДА
	|				0
	|			ИНАЧЕ
	|				СуммаНДСВалютная * КурсВалютыНДС / КратностьВалютыНДС
	|		КОНЕЦ
	|		+
	|		// Рублевая сумма НДС
	|		СуммаНДСРублевая	КАК ЧИСЛО(18,2))	КАК СуммаНДСРублевая
	|ИЗ
	|	ВсеГТДИмпорт
	|" + ТекстУпорядочить + "
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [7]. Общее количество документов, подлежащих обработке
	|//		(Финальная таблица)
	|//
	|ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(КоличествоДокументов), 0)	КАК КоличествоДокументов
	|ИЗ
	|	(ВЫБРАТЬ
	|		КОЛИЧЕСТВО(*)	КАК КоличествоДокументов
	|	ИЗ
	|		ВсеСчетаФактурыВыданные
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		КОЛИЧЕСТВО(*)	КАК КоличествоДокументов
	|	ИЗ
	|		ВсеСчетаФактурыПолученные
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		КОЛИЧЕСТВО(*)	КАК КоличествоДокументов
	|	ИЗ
	|		ВсеГТДИмпорт
	|	)	КАК ВсегоДокументов
	|;";
	
	Результаты = ЗапросЗаполнение.ВыполнитьПакет();
	
	// [7]. Общее количество документов, подлежащих обработке
	Выборка = Результаты[7].Выбрать();
	КоличествоДокументов = 0;
	Пока Выборка.Следующий() Цикл
		КоличествоДокументов = Выборка["КоличествоДокументов"];
		Прервать;
	КонецЦикла;
	
	Если КоличествоДокументов = 0 Тогда
		// Отсутствуют объекты для обработки
		
		Если ЭтоОтложенноеВыполнение Тогда
			// Свойства от БСП
			ПараметрыОтложенногоОбработчика.Вставить("ОбработкаЗавершена", Истина);
		КонецЕсли;
		
		// Сообщение "Документов, подлежащих обработке, не обнаружено"
		ВставляемыеЗначения = Новый Структура();
		ВставляемыеЗначения.Вставить("ОбозначениеОбработки",	ОбозначениеОбработки);
		ВставляемыеЗначения.Вставить("РежимЗапуска",			РежимЗапускаСтрока);
		Комментарий = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонОбщийОтсутствуютДанные, ВставляемыеЗначения);
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,								// имя события
			УровеньЖурналаРегистрации.Информация,	// уровень
			,										// объект метаданных
			,										// данные
			Комментарий);							// комментарий
		
		// Выходим
		Возврат;
	КонецЕсли;
	
	Если ЭтоПервоеОтложенноеВыполнение Тогда
		ПараметрыОтложенногоОбработчика["ПрогрессВыполнения"]["ВсегоОбъектов"] = КоличествоДокументов;
	КонецЕсли;
	
	// Обрабатываемые виды документов
	НастройкиОбработки = Новый ТаблицаЗначений();
	НастройкиОбработки.Колонки.Добавить("ИмяДокумента",		Новый ОписаниеТипов("Строка"));
	НастройкиОбработки.Колонки.Добавить("СинонимДокумента",	Новый ОписаниеТипов("Строка"));
	НастройкиОбработки.Колонки.Добавить("РезультатЗапроса",	Новый ОписаниеТипов("РезультатЗапроса"));
	
	НоваяСтрока = НастройкиОбработки.Добавить();
	НоваяСтрока["ИмяДокумента"]		= "СчетФактураВыданный";
	НоваяСтрока["СинонимДокумента"]	= НСтр("ru='Счет-фактура выданный'");
	НоваяСтрока["РезультатЗапроса"]	= Результаты[2];
	
	НоваяСтрока = НастройкиОбработки.Добавить();
	НоваяСтрока["ИмяДокумента"]		= "СчетФактураПолученный";
	НоваяСтрока["СинонимДокумента"]	= НСтр("ru='Счет-фактура полученный'");
	НоваяСтрока["РезультатЗапроса"]	= Результаты[4];
	
	НоваяСтрока = НастройкиОбработки.Добавить();
	НоваяСтрока["ИмяДокумента"]		= "ГТДИмпорт";
	НоваяСтрока["СинонимДокумента"]	= НСтр("ru='Таможенная декларация по импорту'");
	НоваяСтрока["РезультатЗапроса"]	= Результаты[6];
	
	// Блокировка данных (только при отложенной обработке)
	Если ЭтоОтложенноеВыполнение Тогда
		НачатьТранзакцию();
		
		Блокировка = Новый БлокировкаДанных;
		
		Для Каждого СтрокаНастроек Из НастройкиОбработки Цикл
			Если СтрокаНастроек["РезультатЗапроса"].Пустой() Тогда
				Продолжить;
			КонецЕсли;
			
			ЭлементБлокировки					= Блокировка.Добавить("Документ." + СтрокаНастроек["ИмяДокумента"]);
			ЭлементБлокировки.Режим				= РежимБлокировкиДанных.Исключительный;
			ЭлементБлокировки.ИсточникДанных	= СтрокаНастроек["РезультатЗапроса"];
			ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Ссылка", "Ссылка");
		КонецЦикла;
		
		Попытка
			Блокировка.Заблокировать();
		Исключение
			// Не удалось заблокировать необходимые документы
			ОтменитьТранзакцию();
			
			// Сообщение "Ошибка блокировки"
			ВставляемыеЗначения = Новый Структура();
			ВставляемыеЗначения.Вставить("ОбозначениеОбработки",	ОбозначениеОбработки);
			ВставляемыеЗначения.Вставить("РежимЗапуска",			РежимЗапускаСтрока);
			ВставляемыеЗначения.Вставить("ОписаниеОшибки",			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Комментарий = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонОбщийОшибкаБлокировки, ВставляемыеЗначения);
			ЗаписьЖурналаРегистрации(
				ИмяСобытия,							// имя события
				УровеньЖурналаРегистрации.Ошибка,	// уровень
				,									// объект метаданных
				,									// данные
				Комментарий);						// комментарий
				
			// Сообщение "Осталось N необработанных документов"
			Количество = ПараметрыОтложенногоОбработчика["ПрогрессВыполнения"]["ВсегоОбъектов"]
				- ПараметрыОтложенногоОбработчика["ПрогрессВыполнения"]["ОбработаноОбъектов"];
			ВставляемыеЗначения = Новый Структура();
			ВставляемыеЗначения.Вставить("ОбозначениеОбработки",	ОбозначениеОбработки);
			ВставляемыеЗначения.Вставить("РежимЗапуска",			РежимЗапускаСтрока);
			ВставляемыеЗначения.Вставить("Количество",				Количество);
			Комментарий = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонОбщийКоличествоНеобработанных, ВставляемыеЗначения);
			ЗаписьЖурналаРегистрации(
				ИмяСобытия,								// имя события
				УровеньЖурналаРегистрации.Информация,	// уровень
				,										// объект метаданных
				,										// данные
				Комментарий);							// комментарий
				
			// Выходим
			ВызватьИсключение;
		КонецПопытки;
	КонецЕсли;
	
	// Собственно заполнение реквизитов
	Для Каждого СтрокаНастроек Из НастройкиОбработки Цикл
		// Статистика обработки
		СчетчикДокументовТекущегоВидаОК		= 0;
		СчетчикДокументовТекущегоВидаОшибка	= 0;
		
		Если СтрокаНастроек["РезультатЗапроса"].Пустой() Тогда
			// Сообщение "Документов вида V, подлежащих обработке, не обнаружено"
			ВставляемыеЗначения = Новый Структура();
			ВставляемыеЗначения.Вставить("ОбозначениеОбработки",	ОбозначениеОбработки);
			ВставляемыеЗначения.Вставить("РежимЗапуска",			РежимЗапускаСтрока);
			ВставляемыеЗначения.Вставить("СинонимДокумента",		СтрокаНастроек["СинонимДокумента"]);
			Комментарий = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонДокументыОтсутствуютДанные, ВставляемыеЗначения);
			ЗаписьЖурналаРегистрации(
				ИмяСобытия,								// имя события
				УровеньЖурналаРегистрации.Информация,	// уровень
				,										// объект метаданных
				,										// данные
				Комментарий);							// комментарий
			
			Продолжить;
		КонецЕсли;
		
		ВыборкаДокумент = СтрокаНастроек["РезультатЗапроса"].Выбрать();
		
		Пока ВыборкаДокумент.Следующий() Цикл
			Попытка
				ДокументОбъект = ВыборкаДокумент["Ссылка"].ПолучитьОбъект();
				Если ДокументОбъект = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				ЗаполнитьЗначенияСвойств(ДокументОбъект, ВыборкаДокумент,, "Ссылка");
				
				ОбновлениеИнформационнойБазы.ЗаписатьДанные(ДокументОбъект);
				
				// Статистика обработки
				СчетчикДокументовОК				= СчетчикДокументовОК + 1;
				СчетчикДокументовТекущегоВидаОК	= СчетчикДокументовТекущегоВидаОК + 1;
				
				Если ЭтоОтложенноеВыполнение Тогда
					ПараметрыОтложенногоОбработчика["УспешноОбработанныеДокументы"].Добавить(ВыборкаДокумент["Ссылка"]);
					ПараметрыОтложенногоОбработчика["ПрогрессВыполнения"]["ОбработаноОбъектов"] =
						ПараметрыОтложенногоОбработчика["ПрогрессВыполнения"]["ОбработаноОбъектов"] + 1;
				КонецЕсли;
				
			Исключение
				ОписаниеОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				
				// Статистика обработки
				СчетчикДокументовОшибка				= СчетчикДокументовОшибка + 1;
				СчетчикДокументовТекущегоВидаОшибка	= СчетчикДокументовТекущегоВидаОшибка + 1;
				
				// Сообщение "Ошибка при обработке документа D"
				ВставляемыеЗначения = Новый Структура();
				ВставляемыеЗначения.Вставить("ОбозначениеОбработки",	ОбозначениеОбработки);
				ВставляемыеЗначения.Вставить("РежимЗапуска",			РежимЗапускаСтрока);
				ВставляемыеЗначения.Вставить("ДокументСсылка",			ВыборкаДокумент["Ссылка"]);
				ВставляемыеЗначения.Вставить("СинонимДокумента",		СтрокаНастроек["СинонимДокумента"]);
				ВставляемыеЗначения.Вставить("ОписаниеОшибки",			ОписаниеОшибки);
				Комментарий = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонДокументОшибка, ВставляемыеЗначения);
				ЗаписьЖурналаРегистрации(
					ИмяСобытия,							// имя события
					УровеньЖурналаРегистрации.Ошибка,	// уровень
					,									// объект метаданных
					,									// данные
					Комментарий);						// комментарий
					
				Если ЭтоОтложенноеВыполнение Тогда
					ОтменитьТранзакцию();
					
					// Сообщение "Осталось N необработанных документов"
					Количество = ПараметрыОтложенногоОбработчика["ПрогрессВыполнения"]["ВсегоОбъектов"]
						- ПараметрыОтложенногоОбработчика["ПрогрессВыполнения"]["ОбработаноОбъектов"];
					ВставляемыеЗначения = Новый Структура();
					ВставляемыеЗначения.Вставить("ОбозначениеОбработки",	ОбозначениеОбработки);
					ВставляемыеЗначения.Вставить("РежимЗапуска",			РежимЗапускаСтрока);
					ВставляемыеЗначения.Вставить("Количество",				Количество);
					Комментарий = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонОбщийКоличествоНеобработанных, ВставляемыеЗначения);
					ЗаписьЖурналаРегистрации(
						ИмяСобытия,								// имя события
						УровеньЖурналаРегистрации.Информация,	// уровень
						,										// объект метаданных
						,										// данные
						Комментарий);							// комментарий
					
					// Выходим
					ВызватьИсключение;
				КонецЕсли;
			КонецПопытки;
		КонецЦикла;
		
		// Итоговые сообщения в журнале регистрации по каждому виду документов
		
		Если СчетчикДокументовТекущегоВидаОК > 0 Тогда
			// Сообщение "Количество успешно обработанных документов вида V: N"
			ВставляемыеЗначения = Новый Структура();
			ВставляемыеЗначения.Вставить("ОбозначениеОбработки",	ОбозначениеОбработки);
			ВставляемыеЗначения.Вставить("РежимЗапуска",			РежимЗапускаСтрока);
			ВставляемыеЗначения.Вставить("СинонимДокумента",		СтрокаНастроек["СинонимДокумента"]);
			ВставляемыеЗначения.Вставить("Количество",				Строка(СчетчикДокументовТекущегоВидаОК));
			Комментарий = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонДокументыКоличествоУспехов, ВставляемыеЗначения);
			ЗаписьЖурналаРегистрации(
				ИмяСобытия,								// имя события
				УровеньЖурналаРегистрации.Информация,	// уровень
				,										// объект метаданных
				,										// данные
				Комментарий);							// комментарий
		КонецЕсли;
		
		Если СчетчикДокументовТекущегоВидаОшибка > 0 Тогда
			// Сообщение "Количество необработанных документов вида V: N"
			ВставляемыеЗначения = Новый Структура();
			ВставляемыеЗначения.Вставить("ОбозначениеОбработки",	ОбозначениеОбработки);
			ВставляемыеЗначения.Вставить("РежимЗапуска",			РежимЗапускаСтрока);
			ВставляемыеЗначения.Вставить("СинонимДокумента",		СтрокаНастроек["СинонимДокумента"]);
			ВставляемыеЗначения.Вставить("Количество",				Строка(СчетчикДокументовТекущегоВидаОшибка));
			ВставляемыеЗначения.Вставить("ОписаниеОшибки",			ОписаниеОшибки);
			Комментарий = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонДокументыКоличествоОшибок, ВставляемыеЗначения);
			ЗаписьЖурналаРегистрации(
				ИмяСобытия,								// имя события
				УровеньЖурналаРегистрации.Информация,	// уровень
				,										// объект метаданных
				,										// данные
				Комментарий);							// комментарий
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЭтоОтложенноеВыполнение Тогда
		ЗафиксироватьТранзакцию();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Устаревшие

// Устарела
//
// Параметры
//	Параметры	- Структура	- исходные данные для расчета, дожны содержать поля:
//		* ПричинаНалогообложения			- ПеречислениеСсылка.ПричиныНалогообложенияНДС	-
//		* ЭтоОбособленноеПодразделение		- Булево	-
//		* ИмяДокумента						- Строка	-
//		* ИмяИсправляемогоДокумента			- Строка	-
//		* Номер								- Строка	- необработанный номер документа, из базы;
//		* ОрганизацияИндексПодразделения	- Число		- цифровой индекс подразделения;
//
// Возвращаемое значение:
//	Структура	- содержит поля:
//		* Продавец			- Строка	- одна из строк Контрагент|Организация|ГоловнаяОрганизация;
//		* Покупатель		- Строка	- одна из строк Контрагент|Организация|ГоловнаяОрганизация;
//		* НомерДокумента	- Строка	- обработанный номер документа.
Функция ОпределитьПродавцаПокупателяИНомерДокумента(Знач Параметры, ЭтоСчетФактураВыданный = Неопределено) Экспорт
	
	// Возвращаемое значение:
	Результат = Новый Структура("Продавец, Покупатель, НомерДокумента");
	
	ПричинаНалогообложения			= Параметры["ПричинаНалогообложения"];
	ЭтоОбособленноеПодразделение	= Параметры["ЭтоОбособленноеПодразделение"];
	НомерДокумента					= Параметры["Номер"];
	ОрганизацияИндексПодразделения	= Параметры["ОрганизацияИндексПодразделения"];
	Если ЭтоСчетФактураВыданный = Неопределено Тогда
		ИмяДокумента				= Параметры["ИмяДокумента"];
		ИмяИсправляемогоДокумента	= Параметры["ИмяИсправляемогоДокумента"];
	Иначе
		ИмяДокумента				= ?(ЭтоСчетФактураВыданный, "СчетФактураВыданный", "СчетФактураПолученный");
		ИмяИсправляемогоДокумента	= "";
	КонецЕсли;
	
	ЭтоВыданныйНамиДокумент =  (ИмяДокумента				= "СчетФактураВыданный" ИЛИ
								ИмяИсправляемогоДокумента	= "СчетФактураВыданный" ИЛИ
								ИмяДокумента				= "КорректировочныйСчетФактураВыданный" ИЛИ
								ИмяИсправляемогоДокумента	= "КорректировочныйСчетФактураВыданный");
	
	ИспользоватьГоловнуюОрганизациюВместоОрганизации = (ЭтоОбособленноеПодразделение = Истина)
		И ЭтоВыданныйНамиДокумент;
		
	ЭтоНалоговыйАгентП2илиП3 = (ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.ПокупкаУНерезидентаНалоговыйАгент
							ИЛИ	ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.ПокупкаНалоговыйАгент);
	ЭтоСМРХозСпособом = (ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.СМРХозяйственнымСпособом);
	
	// Номер документа:
	Если ЭтоВыданныйНамиДокумент Тогда
		Если ЗначениеЗаполнено(ИмяИсправляемогоДокумента) Тогда
			ИмяДокумента = ИмяИсправляемогоДокумента;
		КонецЕсли;
		
		НомерДокумента = РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоИмениДокумента(
			ИмяДокумента, НомерДокумента);
		
		Если ИспользоватьГоловнуюОрганизациюВместоОрганизации Тогда
			НомерДокумента = ПолучитьНомерДокументаСУчетомЦифровогоИндексаПодразделения(НомерДокумента, ОрганизацияИндексПодразделения);
		КонецЕсли;
	КонецЕсли;
				
	// Продавец и покупатель:
	Если ИспользоватьГоловнуюОрганизациюВместоОрганизации Тогда
		Организация = "ГоловнаяОрганизация";
	Иначе
		Организация = "Организация";
	КонецЕсли;
	Если ЭтоНалоговыйАгентП2илиП3 Тогда
		// Продавец - тот, за кого налоговый агент исполняет обязанность по уплате налога.
		Продавец	= "Контрагент";
		Покупатель	= Организация;
	ИначеЕсли ЭтоСМРХозСпособом Тогда
		Продавец	= Организация;
		Покупатель	= Организация;
		
	ИначеЕсли ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.АвансПолученныйЛом
		ИЛИ ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.РеализацияЛом Тогда
			Продавец	= Организация;
			Покупатель	= "Контрагент";
			
	Иначе
		Если ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.АвансВыданный Тогда
			Продавец	= "Контрагент";
			Покупатель	= Организация;
		ИначеЕсли УчетНДСПовтИсп.Начисление(ПричинаНалогообложения) Тогда
			Продавец	= Организация;
			Покупатель	= "Контрагент";
		Иначе
			Продавец	= "Контрагент";
			Покупатель	= Организация;
