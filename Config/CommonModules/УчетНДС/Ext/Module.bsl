		ПараметрыОтчета);
	ДобавитьСтрокуРасшифровки_2019Кв1(ТаблицаРасшифровки,
		"П000300002005",
		"Строка 020 (раздел 3) ""Реализация (передача для собственных нужд) товаров (работ, услуг), передача имущественных, всего (10%), сумма НДС""",
		"", "Строка 020 (сумма налога)", Раздел3.П000300002005,
		"Раздел3",
