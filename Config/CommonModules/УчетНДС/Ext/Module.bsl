Процедура СегментацияДанныхДекларации_ЗаписатьТекущийСегмент(ОбозначениеРаздела, ЗаполняемыйТабличныйДокумент, ИспользуемыйМакет, ПараметрыОтчета, ДанныеДляДекларации, ЗакончиласьТаблица) Экспорт
	
	ОписаниеРаздела = СегментацияДанныхДекларации_ПолучитьОписаниеРаздела(ОбозначениеРаздела);
	
	ИмяРаздела					= ОписаниеРаздела["ИмяВРегламентированнойОтчетности"];
	ТаблицаРаздела				= ДанныеДляДекларации[ОписаниеРаздела["ИмяТаблицыДанных"]];
	СегментацияДанныхРаздела	= ПараметрыОтчета["СегментацияДанныхДекларации"][ИмяРаздела];
	
	Если ТаблицаРаздела.Количество() > 0 Тогда
		// Выводим заголовок сегмента
		СегментацияДанныхДекларации_ДобавитьЗаголовокСегмента(
			ОписаниеРаздела,
			ЗаполняемыйТабличныйДокумент,
			ИспользуемыйМакет,
			СегментацияДанныхРаздела);
		
		// Сохраняем текущий сегмент
		РегламентированнаяОтчетность.ЗаписатьСегментДанныхРазделаДекларацииНДС(
			ПараметрыОтчета.СсылкаНаДекларацию,
			ИмяРаздела,
			СегментацияДанныхРаздела["ТекущийСегмент"].ПерваяСтрокаТабличногоДокумента,
			ТаблицаРаздела);
		РегламентированнаяОтчетность.ЗаписатьСегментТабличногоДокументаРазделаДекларацииНДС(
			ПараметрыОтчета.СсылкаНаДекларацию,
			ИмяРаздела,
			СегментацияДанныхРаздела["ТекущийСегмент"].ПерваяСтрокаТабличногоДокумента,
			ЗаполняемыйТабличныйДокумент);
		
		// Инициализируем новый сегмент
		ТаблицаРаздела.Очистить();
		ЗаполняемыйТабличныйДокумент.Очистить();
		СегментацияДанныхДекларации_НастроитьСтатистикуДляНовогоСегмента(ЗакончиласьТаблица, СегментацияДанныхРаздела);
	КонецЕсли;
	
КонецПроцедуры

Процедура СегментацияДанныхДекларации_ДобавитьЗаголовокСегмента(ОписаниеРаздела, ЗаполняемыйТабличныйДокумент, ИспользуемыйМакет, СегментацияДанныхРаздела)
	
	НаименованиеРаздела				= ОписаниеРаздела["НаименованиеДляВыводаВТабДок"];
	ИмяОбластиШапкаТаблицыМакета	= ОписаниеРаздела["ИмяОбластиШапкаТаблицыМакета"];
	
	ТабДокументЗаголовокСегмента = Новый ТабличныйДокумент();
	
	// Выводим статистику сегмента
	ТекущийСегмент = СегментацияДанныхРаздела["ТекущийСегмент"];
	ОбластьЗаголовокСегмента = ИспользуемыйМакет.ПолучитьОбласть("ЗаголовокСегмента");
	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("НаименованиеРаздела",	НаименованиеРаздела);
	ЗначенияПараметров.Вставить("НомерСегмента",		ТекущийСегмент.НомерСегмента);
	ЗначенияПараметров.Вставить("ПерваяСтрока",			ТекущийСегмент.ПерваяСтрокаТаблицыДанныхРаздела);
	ЗначенияПараметров.Вставить("ПоследняяСтрока",		ТекущийСегмент.ПоследняяСтрокаТаблицыДанныхРаздела);
	ОбластьЗаголовокСегмента.Параметры.Заполнить(ЗначенияПараметров);
	ТабДокументЗаголовокСегмента.Вывести(ОбластьЗаголовокСегмента);
	
	// Выводим обозначение граф таблицы
	// Считаем, что графы находятся в последней строке области заголовка
	Если ТекущийСегмент.ВывестиОбозначениеГрафТаблицы Тогда
		ОбластьЗаголовокТаблицы = ИспользуемыйМакет.ПолучитьОбласть(ИмяОбластиШапкаТаблицыМакета);
		ВысотаЗаголовкаТаблицы = ОбластьЗаголовокТаблицы.ВысотаТаблицы;
		ОбластьПоследняяСтрокаШапкиТаблицы = ОбластьЗаголовокТаблицы.ПолучитьОбласть(ВысотаЗаголовкаТаблицы,,ВысотаЗаголовкаТаблицы);
		ТабДокументЗаголовокСегмента.Вывести(ОбластьПоследняяСтрокаШапкиТаблицы);
	КонецЕсли;
	
	// Выводим заголовок сегмента
	ВысотаЗаголовкаСегмента = ТабДокументЗаголовокСегмента.ВысотаТаблицы;
	ЗаполняемыйТабличныйДокумент.ВставитьОбласть(ТабДокументЗаголовокСегмента.Область(1,,ВысотаЗаголовкаСегмента), ЗаполняемыйТабличныйДокумент.Область(1,,ВысотаЗаголовкаСегмента), ТипСмещенияТабличногоДокумента.ПоВертикали);
	
КонецПроцедуры

Процедура СегментацияДанныхДекларации_НастроитьСтатистикуПередВыводомТаблицы(ОбозначениеРаздела, ТабДокумент, ОбщееКоличествоСтрокТаблицыДанных, ПараметрыОтчета) Экспорт
	
	// Подготовка
	ОписаниеРаздела				= СегментацияДанныхДекларации_ПолучитьОписаниеРаздела(ОбозначениеРаздела);
	ИмяРаздела					= ОписаниеРаздела["ИмяВРегламентированнойОтчетности"];
	СегментацияДанныхРаздела	= ПараметрыОтчета["СегментацияДанныхДекларации"][ИмяРаздела];
	
	// Статистика
	СегментацияДанныхРаздела.ОбщееКоличествоСтрокТаблицы						= ОбщееКоличествоСтрокТаблицыДанных;
	СегментацияДанныхРаздела.ТекущийСегмент.ПоследняяСтрокаТабличногоДокумента	= СегментацияДанныхРаздела.ТекущийСегмент.ПоследняяСтрокаТабличногоДокумента
		+ ТабДокумент.ВысотаТаблицы - 1;
	СегментацияДанныхРаздела.ТекущийСегмент.КоличествоСтрокТабличногоДокумента	= СегментацияДанныхРаздела.ТекущийСегмент.КоличествоСтрокТабличногоДокумента
		+ ТабДокумент.ВысотаТаблицы - 1;
		
КонецПроцедуры

Процедура СегментацияДанныхДекларации_НастроитьСтатистикуПослеДобавленияСтрокиТаблицы(СегментацияДанныхРаздела, ПараметрыОтчета) Экспорт
	
	// Подготовка
	ТекущийСегмент = СегментацияДанныхРаздела["ТекущийСегмент"];
	
	// Статистика
	ТекущийСегмент.ПоследняяСтрокаТабличногоДокумента	= ТекущийСегмент.ПоследняяСтрокаТабличногоДокумента		+ 1;
	ТекущийСегмент.ПоследняяСтрокаТаблицыДанныхРаздела	= ТекущийСегмент.ПоследняяСтрокаТаблицыДанныхРаздела	+ 1;
	ТекущийСегмент.КоличествоСтрокТабличногоДокумента	= ТекущийСегмент.КоличествоСтрокТабличногоДокумента		+ 1;
	ТекущийСегмент.КоличествоСтрокТаблицыДанныхРаздела	= ТекущийСегмент.КоличествоСтрокТаблицыДанныхРаздела	+ 1;
	СегментацияДанныхРаздела["КоличествоСтрокТаблицы"]	= СегментацияДанныхРаздела["КоличествоСтрокТаблицы"]	+ 1;
	
КонецПроцедуры

Процедура СегментацияДанныхДекларации_НастроитьСтатистикуДляНовогоСегмента(ЗакончиласьТаблица, СегментацияДанныхРаздела)
	
	// Подготовка
	ПредыдущиеСегменты	= СегментацияДанныхРаздела["ПредыдущиеСегменты"];
	ТекущийСегмент		= СегментацияДанныхРаздела["ТекущийСегмент"];
	
	// Статистика
	ПредыдущиеСегменты.КоличествоСтрокТабличногоДокумента = ПредыдущиеСегменты.КоличествоСтрокТабличногоДокумента
		+ ТекущийСегмент.КоличествоСтрокТабличногоДокумента;
	ПредыдущиеСегменты.КоличествоСтрокТаблицыДанныхРаздела = ПредыдущиеСегменты.КоличествоСтрокТаблицыДанныхРаздела
		+ ТекущийСегмент.КоличествоСтрокТаблицыДанныхРаздела;
	ТекущийСегмент.ПерваяСтрокаТабличногоДокумента		= ТекущийСегмент.ПоследняяСтрокаТабличногоДокумента		+ 1;
	ТекущийСегмент.ПерваяСтрокаТаблицыДанныхРаздела		= ТекущийСегмент.ПоследняяСтрокаТаблицыДанныхРаздела	+ 1;
	ТекущийСегмент.КоличествоСтрокТабличногоДокумента	= 0;
	ТекущийСегмент.КоличествоСтрокТаблицыДанныхРаздела	= 0;
	ТекущийСегмент.НомерСегмента						= ТекущийСегмент.НомерСегмента + 1;
	ТекущийСегмент.ВывестиОбозначениеГрафТаблицы		= НЕ ЗакончиласьТаблица;
	
	Если ЗакончиласьТаблица Тогда
		СегментацияДанныхРаздела["КоличествоСтрокТаблицы"] = 0;
	КонецЕсли;
	
КонецПроцедуры

Функция СегментацияДанныхДекларации_СегментДостигПредельногоРазмера(СегментацияДанныхРаздела, ПараметрыОтчета) Экспорт
	
	Возврат СегментацияДанныхРаздела.ТекущийСегмент.КоличествоСтрокТаблицыДанныхРаздела >= СегментацияДанныхРаздела.ПредельноеКоличествоЗаписейВРазделеДекларацииПоНДС;
	
КонецФункции

Функция СегментацияДанныхДекларации_ЭтоПоследняяСтрокаТаблицы(СегментацияДанныхРаздела, ПараметрыОтчета) Экспорт
	
	Возврат СегментацияДанныхРаздела.КоличествоСтрокТаблицы >= СегментацияДанныхРаздела.ОбщееКоличествоСтрокТаблицы;
	
КонецФункции

#КонецОбласти
