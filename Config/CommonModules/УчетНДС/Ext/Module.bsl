	Результат.Колонки.Добавить("КоличествоТовараУвеличение",		Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(26,11)));
	Результат.Колонки.Добавить("КоличествоТовараУменьшение",		Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(26,11)));
	
