// Определяет причину налогообложения НДС по документу, являющимся объектом налогообложения
//
// Параметры:
//	ДокументСсылка	- ДокументСсылка	- объект налогообложения.
//
// Возврат:
//	Значение перечисления ПричиныНалогообложенияНДС.
Функция ПолучитьПричинуНалогообложения(ДокументСсылка) Экспорт
	
	ТипЗначения	= ТипЗнч(ДокументСсылка);
	Результат	= Перечисления.ПричиныНалогообложенияНДС.ПустаяСсылка();
	
	Если ТипЗначения = Тип("ДокументСсылка.АвансовыйОтчет") Тогда
		Результат = Перечисления.ПричиныНалогообложенияНДС.Покупка;
		
	ИначеЕсли ТипЗначения = Тип("ДокументСсылка.АктОбОказанииУслуг")
		ИЛИ   ТипЗначения = Тип("ДокументСсылка.СдачаЭтапаРабот") Тогда
		РеализацияПоСтавке0 = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "РеализацияПоСтавке0");
		Если РеализацияПоСтавке0 Тогда
			Результат = Перечисления.ПричиныНалогообложенияНДС.Реализация0;
		Иначе
			Результат = Перечисления.ПричиныНалогообложенияНДС.Реализация;
		КонецЕсли;
		
	ИначеЕсли ТипЗначения = Тип("ДокументСсылка.ВводНачальныхОстатков") Тогда
		Результат = Перечисления.ПричиныНалогообложенияНДС.ПустаяСсылка();
		
	ИначеЕсли ТипЗначения = Тип("ДокументСсылка.КассовоеПоступление")
		ИЛИ   ТипЗначения = Тип("ДокументСсылка.ОперацияБух")
		ИЛИ   ТипЗначения = Тип("ДокументСсылка.ПриходныйКассовыйОрдер") Тогда
		Результат = Перечисления.ПричиныНалогообложенияНДС.АвансПолученный;
		
	ИначеЕсли ТипЗначения = Тип("ДокументСсылка.НакладнаяНаОтпускМ15")
		ИЛИ   ТипЗначения = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12")
		ИЛИ   ТипЗначения = Тип("ДокументСсылка.НачислениеДоходов")
		ИЛИ   ТипЗначения = Тип("ДокументСсылка.ПередачаГруппОбъектовОС")
		ИЛИ   ТипЗначения = Тип("ДокументСсылка.ПередачаЗдания")
		ИЛИ   ТипЗначения = Тип("ДокументСсылка.ПередачаОбъектаОС") Тогда
		Результат = Перечисления.ПричиныНалогообложенияНДС.Реализация;
		
	ИначеЕсли ТипЗначения = Тип("ДокументСсылка.ПоступлениеУслугРабот") Тогда
		Договор = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "Договор");
		ТипДоговораНДС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор, "ТипДоговораНДС");
		Если ТипДоговораНДС = Перечисления.ТипыДоговоровДляНДС.АгентскийДоговор Тогда
			Результат = Перечисления.ПричиныНалогообложенияНДС.ПокупкаНалоговыйАгент;
		ИначеЕсли ТипДоговораНДС = Перечисления.ТипыДоговоровДляНДС.АгентскийДоговорНерезидент Тогда
			Результат = Перечисления.ПричиныНалогообложенияНДС.ПокупкаУНерезидентаНалоговыйАгент;
		Иначе
			ЗапросСумма = Новый Запрос();
			ЗапросСумма.УстановитьПараметр("ДокументСсылка",	ДокументСсылка);
			ЗапросСумма.УстановитьПараметр("Счет106КС",			БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("106.КС"));
			ЗапросСумма.Текст = "
			|ВЫБРАТЬ
			|	СУММА(ЕПСБУДвижения.Сумма)	КАК Сумма
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
			|		,
			|		,
			|		Регистратор = &ДокументСсылка
			|		И	СчетДт В ИЕРАРХИИ(&Счет106КС)
			|		И	СубконтоДт3 = ЗНАЧЕНИЕ(Перечисление.СпособыСтроительства.Подрядный),
			|		,
			|	)	КАК ЕПСБУДвижения
			|;";
			Выборка = ЗапросСумма.Выполнить().Выбрать();
			Выборка.Следующий();
			Если ЗначениеЗаполнено(Выборка["Сумма"]) Тогда
				Результат = Перечисления.ПричиныНалогообложенияНДС.Покупка;
			Иначе
				Результат = Перечисления.ПричиныНалогообложенияНДС.СМРПодряднымСпособом;
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ТипЗначения = Тип("ДокументСсылка.ПоступлениеМЗ")
		ИЛИ   ТипЗначения = Тип("ДокументСсылка.ПоступлениеМЗВПути")
		ИЛИ   ТипЗначения = Тип("ДокументСсылка.ПоступлениеОС")
		ИЛИ   ТипЗначения = Тип("ДокументСсылка.ПоступлениеОСВПути") Тогда
		Договор = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "Договор");
		ТипДоговораНДС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор, "ТипДоговораНДС");
		Если ТипДоговораНДС = Перечисления.ТипыДоговоровДляНДС.АгентскийДоговор Тогда
			Результат = Перечисления.ПричиныНалогообложенияНДС.ПокупкаНалоговыйАгент;
		Иначе
			Результат = Перечисления.ПричиныНалогообложенияНДС.Покупка;
		КонецЕсли;
		
	ИначеЕсли ТипЗначения = Тип("ДокументСсылка.ЗаявкаНаКассовыйРасход")
		ИЛИ   ТипЗначения = Тип("ДокументСсылка.ЗаявкаНаКассовыйРасходСокращенная")
		ИЛИ   ТипЗначения = Тип("ДокументСсылка.ПлатежноеПоручение")
		ИЛИ   ТипЗначения = Тип("ДокументСсылка.РасходныйКассовыйОрдер")
		ИЛИ   ТипЗначения = Тип("ДокументСсылка.КассовоеВыбытие") Тогда
		Результат = Перечисления.ПричиныНалогообложенияНДС.АвансВыданный;
		
	ИначеЕсли ТипЗначения = Тип("ДокументСсылка.СчетФактураПолученный")
		ИЛИ   ТипЗначения = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		Результат = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "ПричинаНалогообложения");
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции	

Функция ПолучитьКодВидаОперации(ОсновныеПараметры, ДополнительныеПараметры = Неопределено) Экспорт
	
	ЗначенияПараметров = Новый Структура("
		|ВидЗаполняемогоДокумента,
		|ИмяТабличнойЧасти,
		|Дата,
		|ПричинаНалогообложения,
		|Действие,
		|ДокументОснование,
		|Контрагент,
		|Договор,
		|ТипДоговораНДС,
		|ДатаПервичногоДокумента,
		|ВидЦенности");
		
	ЗаполнитьЗначенияСвойств(ЗначенияПараметров, ОсновныеПараметры);
	
	Если НЕ ДополнительныеПараметры = Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ЗначенияПараметров, ДополнительныеПараметры);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ЗначенияПараметров["Дата"])
				ИЛИ НачалоДня(ЗначенияПараметров["Дата"]) >= '20160701' Тогда
		КодВидаОперации = ПолучитьКодВидаОперации_После20160701(ЗначенияПараметров);
	Иначе
		КодВидаОперации = ПолучитьКодВидаОперации_До20160701(ЗначенияПараметров);
	КонецЕсли;
	
	// Если не получилось явно определить значение, то берем из документа-основания
	Если НЕ ЗначениеЗаполнено(КодВидаОперации) Тогда
		ДокументОснование = ЗначенияПараметров["ДокументОснование"];
		
		Если ЗначениеЗаполнено(ДокументОснование) Тогда
			Если ОбщегоНазначения.ЕстьРеквизитОбъекта("КодВидаОперации", ДокументОснование.Метаданные()) Тогда
				КодВидаОперации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснование, "КодВидаОперации");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат КодВидаОперации;
	
КонецФункции

// Определяет вид КБК для счета 210.01 в зависимости от причины налогообложения
//
// Параметры
//	ПричинаНО						- ПеречислениеСсылка.ПричиныНалогообложенияНДС	-
//	ДобавитьЗначениеПроизвольный	- Булево	-
//
// Возвращаемое значение
//	Перечисления.ВидыКБК	- если ДобавитьЗначениеПроизвольный=Ложь;
//	Фиксированный массив	- если ДобавитьЗначениеПроизвольный=Истина.
//		* Перечисления.ВидыКБК	- каждый элемент массива.
Функция ВидКБКСчета21001(ПричинаНО, ДобавитьЗначениеПроизвольный = Ложь) Экспорт
	
	Перем Результат; // Возвращаемое значение
	
	Если ПричинаНО = Перечисления.ПричиныНалогообложенияНДС.АвансПолученный Тогда
		ВидКБК = Перечисления.ВидыКБК.КДБ;
	Иначе
		ВидКБК = Перечисления.ВидыКБК.КРБ;
	КонецЕсли;
	
	Если ДобавитьЗначениеПроизвольный = Истина Тогда
		Результат = Новый Массив();
		Результат.Добавить(ВидКБК);
		Результат.Добавить(Перечисления.ВидыКБК.Произвольный);
		Результат.Добавить(Перечисления.ВидыКБК.АУИБУ);
	Иначе
		Результат = ВидКБК;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Определяет вид КБК для счета 303.04 в зависимости от причины налогообложения
//
// Параметры
//	ПричинаНО						- ПеречислениеСсылка.ПричиныНалогообложенияНДС	-
//	ДобавитьЗначениеПроизвольный	- Булево	-
//
// Возвращаемое значение
//	Перечисления.ВидыКБК	- если ДобавитьЗначениеПроизвольный=Ложь;
//	Фиксированный массив	- если ДобавитьЗначениеПроизвольный=Истина.
//		* Перечисления.ВидыКБК	- каждый элемент массива.
Функция ВидКБКСчета30304(ПричинаНО, ДобавитьЗначениеПроизвольный = Ложь) Экспорт
	
	Перем Результат; // Возвращаемое значение
	
	Если ПричинаНО = Перечисления.ПричиныНалогообложенияНДС.ПокупкаНалоговыйАгент Тогда
		ВидКБК = Перечисления.ВидыКБК.КРБ;
	Иначе
		ВидКБК = Перечисления.ВидыКБК.КДБ;
	КонецЕсли;
	
	Если ДобавитьЗначениеПроизвольный = Истина Тогда
		Результат = Новый Массив();
		Результат.Добавить(ВидКБК);
		Результат.Добавить(Перечисления.ВидыКБК.Произвольный);
		Результат.Добавить(Перечисления.ВидыКБК.АУИБУ);
	Иначе
		Результат = ВидКБК;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьПервоначальныйСчетФактуруВыданный(ИсправляемыйДокументСсылка) Экспорт
	
	Если Не ЗначениеЗаполнено(ИсправляемыйДокументСсылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(ИсправляемыйДокументСсылка) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		Возврат ИсправляемыйДокументСсылка;
	КонецЕсли;
	
	Если ТипЗнч(ИсправляемыйДокументСсылка) = Тип("ДокументСсылка.КорректировочныйСчетФактураВыданный") Тогда
		СледующийДокументСсылка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ИсправляемыйДокументСсылка, "ИсправляемыйДокумент");
		
		Возврат ПолучитьПервоначальныйСчетФактуруВыданный(СледующийДокументСсылка);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Функция производит поиск счета-фактуры (полученного или выданного), у которого в качестве документа-основания указана
// переданная ссылка.
//
// Параметры:
//  ДокументСсылка  - ссылка на документ, для которого надо найти подчиненный документ,
//  ОтборПоСчетамФактурам - строка, вид документа, по умолчанию Неопределено
//  Отбор 			- структура с именами и значениями реквизитов СФ для дополнительного отбора
//	
// Возвращаемое значение:
//  Если нашли, то возвращаем ссылку, не нашли - Неопределено
//
Функция НайтиПодчиненныйСчетФактуру(Знач ДокументСсылка, ОтборПоСчетамФактурам = Неопределено, Отбор = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТекстШаблон = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка
	|ИЗ
	|	(ВЫБРАТЬ
	|		Ссылка,
	|		ПометкаУдаления,
	|		Проведен,
	|		Дата
	|	ИЗ
	|		Документ.СчетФактураВыданный
	|	ГДЕ
	|		ДокументОснование В(&ДокументСсылка)
	|		И [УсловиеСчетФактураВыданный]
	|		
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		Ссылка,
	|		ПометкаУдаления,
	|		Проведен,
	|		Дата
	|	ИЗ
	|		Документ.КорректировочныйСчетФактураВыданный
	|	ГДЕ
	|		ДокументКорректировки В(&ДокументСсылка)
	|		И [УсловиеКорректировочныйСчетФактураВыданный]
	|		
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		Ссылка,
	|		ПометкаУдаления,
	|		Проведен,
	|		Дата
	|	ИЗ
	|		Документ.ИсправительныйСчетФактураВыданный
	|	ГДЕ
	|		ДокументКорректировки В(&ДокументСсылка)
	|		И [УсловиеИсправительныйСчетФактураВыданный]
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ РАЗЛИЧНЫЕ
	|		Ссылка,
	|		Ссылка.ПометкаУдаления,
	|		Ссылка.Проведен,
	|		Ссылка.Дата
	|	ИЗ
	|		Документ.СчетФактураПолученный.ДокументыОснования
	|	ГДЕ
	|		ДокументОснование В(&ДокументСсылка)
	|		И [УсловиеСчетФактураПолученный]
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ РАЗЛИЧНЫЕ
	|		Ссылка,
	|		Ссылка.ПометкаУдаления,
	|		Ссылка.Проведен,
	|		Ссылка.Дата
	|	ИЗ
	|		Документ.КорректировочныйСчетФактураПолученный
	|	ГДЕ
	|		ДокументКорректировки В(&ДокументСсылка)
	|		И [УсловиеКорректировочныйСчетФактураПолученный]
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ РАЗЛИЧНЫЕ
	|		Ссылка,
	|		Ссылка.ПометкаУдаления,
	|		Ссылка.Проведен,
	|		Ссылка.Дата
	|	ИЗ
	|		Документ.ИсправительныйСчетФактураПолученный
	|	ГДЕ
	|		ДокументКорректировки В(&ДокументСсылка)
	|		И [УсловиеИсправительныйСчетФактураПолученный]
	|	) КАК ВТ
	|УПОРЯДОЧИТЬ ПО
	|	ПометкаУдаления,
	|	Проведен УБЫВ,
	|	Дата";
	
	Условия = Новый Структура();
	
	Условия.Вставить("СчетФактураВыданный",					"Истина");
	Условия.Вставить("КорректировочныйСчетФактураВыданный",	"Истина");
	Условия.Вставить("ИсправительныйСчетФактураВыданный",	"Истина");
	
	Условия.Вставить("СчетФактураПолученный",					"Истина");
	Условия.Вставить("КорректировочныйСчетФактураПолученный",	"Истина");
	Условия.Вставить("ИсправительныйСчетФактураПолученный",		"Истина");
	
	ЗапросПоиск = Новый Запрос();
	
	Если ТипЗнч(Отбор) = Тип("Структура") Тогда
		
		Для Каждого Элемент Из Условия Цикл
			ИмяДокумента = Элемент.Ключ;
			
			Условия[ИмяДокумента] = ПолучитьТекстУсловияОтбора(Отбор, ИмяДокумента, ЗапросПоиск);
		КонецЦикла;
		
	КонецЕсли;
	
	Если Не ОтборПоСчетамФактурам = Неопределено Тогда
		
		МассивВидовДокументов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ОтборПоСчетамФактурам, ",");
		
		Для Каждого Документ ИЗ МассивВидовДокументов Цикл
			
			Для каждого Элемент Из Условия Цикл
				
				Если Документ <> Элемент.Ключ Тогда
					Условия.Вставить(Элемент.Ключ, "Ложь");
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Для Каждого Элемент Из Условия Цикл
		ИмяДокумента = Элемент.Ключ;
		
		ТекстШаблон = СтрЗаменить(ТекстШаблон, "[Условие" + ИмяДокумента + "]", Элемент.Значение);
	КонецЦикла;
	
	ЗапросПоиск.УстановитьПараметр("ДокументСсылка", ДокументСсылка);
	ЗапросПоиск.Текст = ТекстШаблон;
	
	Выборка = ЗапросПоиск.Выполнить().Выбрать();
	
	НайденныйДокумент = Неопределено;
	
	Если Выборка.Следующий() Тогда
		НайденныйДокумент = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат НайденныйДокумент;
	
КонецФункции

