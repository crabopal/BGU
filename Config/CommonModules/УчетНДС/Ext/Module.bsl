Функция ПолучитьЗначенияДляАвтозаполнения(ШапкаДокумента) Экспорт
	
	// Возвращаемое значение:
	Результат = Новый Структура("
		// Счета:
		|КэшНДС_Счет21001БезРаспределения,
		|КэшНДС_Счет21001КРаспределению,
		|КэшНДС_Счет30304,
		// КПС:
		|КэшНДС_КПС21001БезРаспределения,
		|КэшНДС_КПС21001КРаспределению,
		|КэшНДС_КПС30304,
		|МассивВидовПоказателяКПС21001,
		|МассивВидовПоказателяКПС30304");
		
	ПричинаНалогообложения	= ШапкаДокумента["ПричинаНалогообложения"];
	Организация				= ШапкаДокумента["Организация"];
	ИФО						= ШапкаДокумента["ИФО"];
	КФО						= ШапкаДокумента["КФО"];
	Дата					= ШапкаДокумента["Дата"];
	
	КэшНДС_Счет21001БезРаспределения	= БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("210.Р1");
	КэшНДС_Счет21001КРаспределению		= БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("210.Н1");
	КэшНДС_Счет30304					= БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("303.04");
	
	Результат["КэшНДС_Счет21001БезРаспределения"]	= КэшНДС_Счет21001БезРаспределения;
	Результат["КэшНДС_Счет21001КРаспределению"]		= КэшНДС_Счет21001КРаспределению;
	Результат["КэшНДС_Счет30304"]					= КэшНДС_Счет30304;
	
	// Отключено:
	//// Используется бюджетная классификация?
	//ВидыКПС = БухгалтерскийУчетПовтИсп.ВидыКПСПоУчетнойПолитике(
	//	ШапкаДокумента["Организация"],
	//	ШапкаДокумента["ИФО"],
	//	ШапкаДокумента["КФО"],
	//	ШапкаДокумента["Дата"]);
	//Попытка
	//	ИспользоватьБюджетнуюКлассификацию = НЕ (ВидыКПС.Количество() = 1
	//		И ВидыКПС[0] = Перечисления.ВидыКБК.Произвольный);
	//Исключение
	//	ИспользоватьБюджетнуюКлассификацию = Ложь;
	//КонецПопытки;
	
	// Допустимые виды КПС в полях:
	МассивВидовПоказателяКПС21001 = УчетНДС.ВидКБКСчета21001(ПричинаНалогообложения, Истина);
	МассивВидовПоказателяКПС30304 = УчетНДС.ВидКБКСчета30304(ПричинаНалогообложения, Истина);
	
	// Значения КПС по умолчанию:
	ДопустимыеВиды21001 = Новый Структура(); // для передачи в модуль с повт.исп.
	ДопустимыеВиды30304 = Новый Структура(); // для передачи в модуль с повт.исп.
	сч = 1;
	Для Каждого Элем Из МассивВидовПоказателяКПС21001 Цикл
		ДопустимыеВиды21001.Вставить("а" + сч, Элем);
		сч = сч + 1;
	КонецЦикла;
	сч = 1;
	Для Каждого Элем Из МассивВидовПоказателяКПС30304 Цикл
		ДопустимыеВиды30304.Вставить("а" + сч, Элем);
		сч = сч + 1;
	КонецЦикла;
	КэшНДС_КПС21001БезРаспределения	= БухгалтерскиеОперацииПовтИсп.КПССчета(Организация, ИФО, КФО, Дата,
		КэшНДС_Счет21001БезРаспределения, ДопустимыеВиды21001);
	КэшНДС_КПС21001КРаспределению	= БухгалтерскиеОперацииПовтИсп.КПССчета(Организация, ИФО, КФО, Дата,
		КэшНДС_Счет21001КРаспределению, ДопустимыеВиды21001);
	КэшНДС_КПС30304					= БухгалтерскиеОперацииПовтИсп.КПССчета(Организация, ИФО, КФО, Дата,
		КэшНДС_Счет30304, ДопустимыеВиды30304);
	
	Результат["КэшНДС_КПС21001БезРаспределения"]	= КэшНДС_КПС21001БезРаспределения;
	Результат["КэшНДС_КПС21001КРаспределению"]		= КэшНДС_КПС21001КРаспределению;
	Результат["КэшНДС_КПС30304"]					= КэшНДС_КПС30304;
	Результат["МассивВидовПоказателяКПС21001"]		= МассивВидовПоказателяКПС21001;
	Результат["МассивВидовПоказателяКПС30304"]		= МассивВидовПоказателяКПС30304;
	
	Возврат Результат;
	
КонецФункции

Процедура УстановитьУсловноеОформлениеВКнигеПокупокИлиКнигеПродаж(Форма) Экспорт
	
