	ПолеДляОформления.Поле = Новый ПолеКомпоновкиДанных("ДеревоСформированныхЛистовНаименование");
	
	//
	// 2.
	Представление = "Дерево сформированных листов - отметка наименования строки с пустым листом";
	//
	ЭлементУО = УОЭлементы.Добавить();
	ЭлементУО.Представление = Представление;
	// Оформление:
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НепринятаяВерсия);
	// Условие:
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ДеревоСформированныхЛистов.ЭтоПустойЛист");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Истина;
	// Оформляемые поля:
	ПолеДляОформления = ЭлементУО.Поля.Элементы.Добавить();
	ПолеДляОформления.Поле = Новый ПолеКомпоновкиДанных("ДеревоСформированныхЛистовНаименование");
	
КонецПроцедуры

Процедура УстановитьУсловноеОформлениеПолейНДСКРаспределению(УсловноеОформление, ИмяТабЧасти) Экспорт
	
	// ТекстНДСКРаспределению
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, ИмяТабЧасти + "ТекстНДСКРаспределению");
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ПринятьНДСКВычету", ВидСравненияКомпоновкиДанных.Равно, Истина);
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = ' Распределяется'")); 
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина); 
	
	// Отображение реквизитов НДСКРаспределению
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, ИмяТабЧасти + "ТекстНДСКРаспределению");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, ИмяТабЧасти + "НДСКРаспределению");
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ПринятьНДСКВычету", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Отображать", Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Доступность", Ложь);
	
КонецПроцедуры

Процедура ТолькоПросмотр_ПоДаннымУчета_Инициализация(Форма, НастройкиТаблиц) Экспорт
	
	// Создаем реквизит формы для хранения переданных настроек таблиц:
	ИмяРеквизита_ТолькоПросмотр_ПоДаннымУчета_НастройкиТаблиц = "ТолькоПросмотр_ПоДаннымУчета_НастройкиТаблиц";
	ДобавляемыеРеквизиты = Новый Массив();
	НовыйРеквизитФормы = Новый РеквизитФормы(ИмяРеквизита_ТолькоПросмотр_ПоДаннымУчета_НастройкиТаблиц, Новый ОписаниеТипов());
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизитФормы);
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	Элементы = Форма.Элементы;
	
	Для Каждого НастройкиОднойТаблицы Из НастройкиТаблиц Цикл
		ИмяТаблицы				= НастройкиОднойТаблицы.Ключ;
		ИмяФлажкаПоДаннымУчета	= НастройкиОднойТаблицы.Значение["ИмяФлажкаПоДаннымУчета"];
		ИменаЭлементов			= НастройкиОднойТаблицы.Значение["ИменаЭлементов"];
		
		// Входная проверка:
		Если ТипЗнч(ИменаЭлементов) = Тип("Строка") Тогда
			ИменаЭлементов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(ИменаЭлементов);
		ИначеЕсли ТипЗнч(ИменаЭлементов) = Тип("Структура") Тогда
			ВремМассив = Новый Массив();
			Для Каждого Элем Из ИменаЭлементов Цикл
				ВремМассив.Добавить(Элем.Ключ);
			КонецЦикла;
			ИменаЭлементов = ВремМассив;
		ИначеЕсли НЕ ТипЗнч(ИменаЭлементов) = Тип("Массив") Тогда
			// Недопустимый тип значения.
			Продолжить;
		КонецЕсли;
		НастройкиОднойТаблицы.Значение.Вставить("ИменаЭлементов", ИменаЭлементов);
		
		// Определим путь к данным флажка "По данным учета":
		ПутьКДаннымОдногоИзЭлементов = Элементы[ИменаЭлементов[0]].ПутьКДанным;
		ИскомаяПодстрока = ИмяТаблицы + ".";
		инд = Найти(ПутьКДаннымОдногоИзЭлементов, ИскомаяПодстрока);
		Если инд = 0 Тогда
			Продолжить;
		КонецЕсли;
		ПутьКФлажкуПоДаннымУчета = Лев(ПутьКДаннымОдногоИзЭлементов, инд + СтрДлина(ИскомаяПодстрока) - 1) + ИмяФлажкаПоДаннымУчета;
		
		// 1. Картинка строк
		Элементы[ИмяТаблицы].ПутьКДаннымКартинкиСтроки = ПутьКФлажкуПоДаннымУчета;
		Элементы[ИмяТаблицы].КартинкаСтрок = БиблиотекаКартинок.ЗанятьФайл;
		
		// 2. Условное оформление блокируемых колонок
		УО = Форма.УсловноеОформление;
		УОЭлементы = УО.Элементы;
		Представление = "Таблица """ + ИмяТаблицы + """ - отметка строк, полученных по данным учета";
		ЭлементУО = УОЭлементы.Добавить();
		ЭлементУО.Представление = Представление;
		// Оформление:
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветНедоступноеПоле);
		// Условие:
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПутьКФлажкуПоДаннымУчета);
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Условие.ПравоеЗначение = Истина;
		// Оформляемые поля:
		Для Каждого ИмяЭлемента Из ИменаЭлементов Цикл
			ПолеДляОформления = ЭлементУО.Поля.Элементы.Добавить();
			ПолеДляОформления.Поле = Новый ПолеКомпоновкиДанных(ИмяЭлемента);
		КонецЦикла;
		
		// 3. Обработчики событий всей таблицы
		Попытка
			Элементы[ИмяТаблицы].УстановитьДействие("ПриНачалеРедактирования",		"Подключаемый_ТолькоПросмотр_ПоДаннымУчета_Таблица_ПриНачалеРедактирования");
			Элементы[ИмяТаблицы].УстановитьДействие("ПриОкончанииРедактирования",	"Подключаемый_ТолькоПросмотр_ПоДаннымУчета_Таблица_ПриОкончанииРедактирования");
		Исключение
		КонецПопытки;
		
		// 4. Обработчики событий блокируемых колонок таблицы
		Для Каждого ИмяЭлемента Из ИменаЭлементов Цикл
			Попытка
				Элементы[ИмяЭлемента].УстановитьДействие("НачалоВыбора",		"Подключаемый_ТолькоПросмотр_ПоДаннымУчета_Поле_НачалоВыбора");
				Элементы[ИмяЭлемента].УстановитьДействие("Очистка",				"Подключаемый_ТолькоПросмотр_ПоДаннымУчета_Поле_Очистка");
			Исключение
			КонецПопытки;
		КонецЦикла;
		
	КонецЦикла;
	
	Форма[ИмяРеквизита_ТолькоПросмотр_ПоДаннымУчета_НастройкиТаблиц] = Новый ФиксированнаяСтруктура(НастройкиТаблиц);
	
КонецПроцедуры

Процедура НастроитьТаблицу_ОформитьСтрокиЗаписьДопЛиста(Объект, Форма, ИмяТаблицы) Экспорт
	
	Элементы = Форма.Элементы;
	ПутьКФлажку = "Объект." + ИмяТаблицы + ".ЗаписьДопЛиста";
	
	УО = Форма.УсловноеОформление;
	УОЭлементы = УО.Элементы;
	Представление = "Таблица """ + ИмяТаблицы + """ - отметка строк, где запись доп.листа не используется";
	ЭлементУО = УОЭлементы.Добавить();
	ЭлементУО.Представление = Представление;
	// Оформление:
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста",	ЦветаСтиля.ЦветНедоступноеПоле);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст",		НСтр("ru='<не используется>'"));
	// Условие:
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПутьКФлажку);
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Ложь;
	// Оформляемые поля:
	ИмяЭлемента = ИмяТаблицы + "КорректируемыйПериод";
	ПолеДляОформления = ЭлементУО.Поля.Элементы.Добавить();
	ПолеДляОформления.Поле = Новый ПолеКомпоновкиДанных(ИмяЭлемента);
	
КонецПроцедуры

Процедура ИнициализироватьНастройкиЭлементовКолонок(Форма, Знач КоллекцияСкрываемых) Экспорт
	
	ВремСоответствие = Новый Соответствие();
	
	ОбщийСписок = Новый Массив();
	
	Для Каждого Элемент Из КоллекцияСкрываемых Цикл
		
		Для Каждого ИмяЭлемента Из Элемент.Значение Цикл
			
			Если ОбщийСписок.Найти(ИмяЭлемента) = Неопределено Тогда
				
				ОбщийСписок.Добавить(ИмяЭлемента);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	НастройкиЭлементовКолонок = Новый Структура();
	НастройкиЭлементовКолонок.Вставить("КоллекцияСкрываемых",	КоллекцияСкрываемых);
	НастройкиЭлементовКолонок.Вставить("ОбщийСписок",			ОбщийСписок);
	
	Форма["НастройкиЭлементовКолонок"] = Новый ФиксированнаяСтруктура(НастройкиЭлементовКолонок);
	
КонецПроцедуры

Процедура НастроитьФорму_ВидимостьКолонок(Форма, Знач ЖелаемаяВидимость = Неопределено) Экспорт
	
	Перем	СкрываемыеЭлементы,
			НоваяВидимость;
	
	// Сначала показываем все колонки (из общего списка)
	// Затем скрываем для указанной причины налогообложения
	
	Если ЖелаемаяВидимость = Неопределено Тогда
		
		ЖелаемаяВидимость = Новый Структура();
		
	КонецЕсли;
	
	НастройкиЭлементовКолонок = Форма["НастройкиЭлементовКолонок"];
	
	КоллекцияСкрываемых = НастройкиЭлементовКолонок["КоллекцияСкрываемых"];
	
	ПричинаНалогообложения = Форма.Объект["ПричинаНалогообложения"];
	
	Для Каждого ИмяЭлемента Из НастройкиЭлементовКолонок["ОбщийСписок"] Цикл
		
		Если НЕ ЖелаемаяВидимость.Свойство(ИмяЭлемента, НоваяВидимость) Тогда
			НоваяВидимость = Истина;
		КонецЕсли;
		
		Форма.Элементы[ИмяЭлемента].Видимость = НоваяВидимость;
		
	КонецЦикла;
	
	СкрываемыеЭлементы = КоллекцияСкрываемых.Получить(ПричинаНалогообложения);
	
	Если СкрываемыеЭлементы = Неопределено Тогда
		
		СкрываемыеЭлементы = КоллекцияСкрываемых.Получить(Перечисления.ПричиныНалогообложенияНДС.ПустаяСсылка());
		
	КонецЕсли;
	
	Для Каждого ИмяЭлемента Из СкрываемыеЭлементы Цикл
		
		Форма.Элементы[ИмяЭлемента].Видимость = Ложь;
		
	КонецЦикла;
	
	ЗаполняющаяСтруктура = Новый Структура("ЭтоАванс", УчетНДСПовтИсп.Аванс(ПричинаНалогообложения));
	
	ЗаполнитьЗначенияСвойств(Форма, ЗаполняющаяСтруктура);
	
КонецПроцедуры

Процедура ЗаполнитьТекстПроСчетФактуру(Форма, ПараметрОбработкиОповещения = Неопределено, ИсточникОбработкиОповещения = Неопределено, ОтборПоСчетамФактурам = Неопределено) Экспорт
	
	ИменаРеквизитовФормы = Новый Структура();
	ИменаРеквизитовФормы.Вставить("СчетФактураСсылка",	"СчетФактура");
	ИменаРеквизитовФормы.Вставить("СчетФактураНадпись",	"НадписьСчетФактура");
	
	СчетФактураСсылка = Форма[ИменаРеквизитовФормы.СчетФактураСсылка];
	
	Если ЗначениеЗаполнено(СчетФактураСсылка) И ЗначениеЗаполнено(ИсточникОбработкиОповещения)
		И СчетФактураСсылка <> ИсточникОбработкиОповещения Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СчетФактураСсылка) Тогда
		СчетФактураСсылка = УчетНДС.НайтиПодчиненныйСчетФактуру(Форма["Объект"].Ссылка, ОтборПоСчетамФактурам);
		
		Форма[ИменаРеквизитовФормы.СчетФактураСсылка] = СчетФактураСсылка;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СчетФактураСсылка) Тогда
		Если ТипЗнч(СчетФактураСсылка) = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СчетФактураСсылка, "НомерПервичногоДокумента,ДатаПервичногоДокумента");
			Номер	= ЗначенияРеквизитов["НомерПервичногоДокумента"];
			Дата	= ЗначенияРеквизитов["ДатаПервичногоДокумента"];
			
		Иначе
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СчетФактураСсылка, "Номер,Дата");
			Номер	= ЗначенияРеквизитов["Номер"];
			Дата	= ЗначенияРеквизитов["Дата"];
		КонецЕсли;
		ТекстНомер	= ?(НЕ ПустаяСтрока(Номер), Номер, "...");
		ТекстДата	= ?(ЗначениеЗаполнено(Дата), Формат(Дата, "ДЛФ=D"), "...");
		ТекстНадписи = СтрШаблон(НСтр("ru='№ %1 от %2 г.'"), ТекстНомер, ТекстДата);
	Иначе
		ТекстНадписи = НСтр("ru='Ввести счет-фактуру'");
	КонецЕсли;
	
	Форма[ИменаРеквизитовФормы.СчетФактураНадпись] = ТекстНадписи;
	
КонецПроцедуры	

Процедура ДобавитьУсловноеОформлениеОтметкиНезаполненнойКолонкиПриНаличииСуммыНалога(Форма, ИмяКолонки, ДобавитьУсловиеНДСКВычету = Ложь) Экспорт
	
	ЭлементУО = Форма.УсловноеОформление.Элементы.Добавить();
	
	ЭлементУО.Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru='Отметка незаполненной колонки %1 при наличии суммы налога'"),
		ИмяКолонки);
	
	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.СоставНФА." + ИмяКолонки);
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	Условие.ПравоеЗначение = Неопределено;
	
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.СоставНФА.СуммаНДС");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	Условие.ПравоеЗначение = Неопределено;
	
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.СоставНФА.КомиссионнаяТорговля");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Ложь;
	
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ПричинаНалогообложения");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
	Условие.ПравоеЗначение = Перечисления.ПричиныНалогообложенияНДС.СчетФактураКомиссионераНаПокупку;
	
	Если ДобавитьУсловиеНДСКВычету Тогда
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.СоставНФА.НДСКВычету");
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Условие.ПравоеЗначение = Истина;
	КонецЕсли;
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Истина);
	
	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("СоставНФА" + ИмяКолонки);
	
КонецПроцедуры

Процедура ПередЗаписьюДокументаНайтиПодчиненныйСФ(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
 	Если Источник.ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	
	Если РежимЗаписи = РежимЗаписиДокумента.Запись Тогда
		Возврат;
	КонецЕсли;
	
	ДокументОснование = Источник.Ссылка;
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ДокументОснование", ДокументОснование);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Счета-фактуры, введенные на основании указанного документа
	|//
	|ВЫБРАТЬ
	|	Ссылка	КАК Ссылка
	|ИЗ
	|	Документ.СчетФактураВыданный
	|ГДЕ
	|	ДокументОснование = &ДокументОснование
	|	И Проведен = ИСТИНА
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ссылка	КАК Ссылка
	|ИЗ
	|	Документ.СчетФактураПолученный.ДокументыОснования
	|ГДЕ
	|	ДокументОснование = &ДокументОснование
	|	И Ссылка.Проведен = ИСТИНА
	|;";
	
	УстановитьПривилегированныйРежим(Истина);
	
	Выборка = ЗапросПоиск.Выполнить().Выбрать();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	КоличествоСчетовФактур = Выборка.Количество();
	
	Если КоличествоСчетовФактур = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Категории для русского языка:
	//	Ноль	(-);
	//	Один	(1 шт);
	//	Два		(-);
	//	Немного	(2 шт);
	//	Много	(5 шт);
	//	Другое	(-)
	
	// Надпись "уже введено Х счетов-фактур"
	НадписьОбнаружено = СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(
		НСтр("ru=';введен счет-фактура;;введены %1 счета-фактуры;введены %1 счетов-фактур;'"),
		КоличествоСчетовФактур);
	
	// Надпись "счета-фактуры следует переоформить"
	НадписьПереоформить = СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(
		НСтр("ru=';счет-фактуру;;счета-фактуры;счета-фактуры;'"),
		КоличествоСчетовФактур);
	
	ТекстСообщения = СтрШаблон(
		НСтр("ru='На основании документа ""%1"" уже %2. Если изменения документа повлекли изменения учета НДС, то %3 следует переоформить.'"),
		ДокументОснование,
		НадписьОбнаружено,
		НадписьПереоформить);
	
	ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	
КонецПроцедуры

// Для отчетов
Функция ПолучитьПредставленияПричинНалогообложения(ТаблицаПредставленияПричинНалогообложения, ВыводитьПредставленияПричинНалогообложения) Экспорт
	
	Результат = Новый Соответствие();
	
	Если ВыводитьПредставленияПричинНалогообложения Тогда
		Для Каждого СтрокаТаблицы Из ТаблицаПредставленияПричинНалогообложения Цикл
			Результат.Вставить(СтрокаТаблицы["ПричинаНалогообложения"], СтрокаТаблицы["Представление"]);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
Процедура ЗаполнитьПредставленияПричинНалогообложения(ЗаполняемаяТаблица) Экспорт
	
	ЗаполняемаяТаблица.Очистить();
	
	НоваяСтрока = ЗаполняемаяТаблица.Добавить();
	НоваяСтрока["ПричинаНалогообложения"]	= Перечисления.ПричиныНалогообложенияНДС.АвансВыданный;
	НоваяСтрока["Представление"]			= НСтр("ru='(аванс выданный)'");
	
	НоваяСтрока = ЗаполняемаяТаблица.Добавить();
	НоваяСтрока["ПричинаНалогообложения"]	= Перечисления.ПричиныНалогообложенияНДС.АвансПолученный;
	НоваяСтрока["Представление"]			= НСтр("ru='(аванс полученный)'");
	
КонецПроцедуры

#КонецОбласти

#Область ИнструкцииУчета

// f(Дата, ПричинаНалогообложения, КФО)
Функция ПрименяемаяИнструкция_СтруктураСвойств(Объект, ИмяРеквизитаКонтрольнаяДата = "Дата", ИдентификаторИнструкции = Неопределено) Экспорт
	
	СтруктураСвойств = Новый Структура("
		|Идентификатор,
		|ДатаНачалаПрименения,
		|Начисление,
		|НачислениеСразу,
		|НачислениеВБудущем,
		|Вычет,
		|ВычетСразу,
		|ВычетВБудущем,
		|РаспределениеВозможно,
		|Аванс,
		|ШкурыЛом,
		|НалоговыйАгент,
		|СчетРасчетовИспользуется,
		|КодВидаТовараИспользуется,
		|СчетНачислениеДт,
		|СчетНачислениеДтЕдинственный,
		|КЭКНачислениеДт,
		|СчетВычетКт,
		|СчетВычетКтЕдинственный,
		|СчетВычетКтКРаспределениюПоУмолчанию,
		|СчетВычетКтБезРаспределенияПоУмолчанию,
		|ВидыПоказателяКПСНачислениеДт,
		|ВидыПоказателяКПСВычетКт,
		|ВидыПоказателяКПС30304,
		|КомиссионнаяРеализация,
		|КомиссионнаяЗакупка,
		|КомиссионнаяЗакупкаКомиссионер,
		|Счет30304");
		
	// Свойства объекта, определяющие саму инструкцию
	КонтрольнаяДата			= Объект[ИмяРеквизитаКонтрольнаяДата];
	
	// Свойства объекта, определяющие применяемые свойства инструкции
	ИспользуемыеСвойства = Новый Структура("ПричинаНалогообложения, КФО, Действие");
	ЗаполнитьЗначенияСвойств(ИспользуемыеСвойства, Объект);
	ПричинаНалогообложения	= ИспользуемыеСвойства["ПричинаНалогообложения"];
	КФО						= ИспользуемыеСвойства["КФО"];
	Действие				= ИспользуемыеСвойства["Действие"];
	
	// Определяем саму инструкцию
	Если ИдентификаторИнструкции = Неопределено Тогда
		СтрокаИнструкции = УчетНДСКлиентСервер.ИнструкцииУчета_ОпределитьСтрокуОбщейТаблицы(КонтрольнаяДата);
	Иначе
		СтрокаИнструкции = УчетНДСКлиентСерверПовтИсп.ИнструкцииУчета_ПолучитьСтрокуОбщейТаблицы(ИдентификаторИнструкции);
		Если СтрокаИнструкции = Неопределено Тогда
			СтрокаИнструкции = УчетНДСКлиентСервер.ИнструкцииУчета_ОпределитьСтрокуОбщейТаблицы(КонтрольнаяДата);
		КонецЕсли;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(СтруктураСвойств, СтрокаИнструкции, "Идентификатор,ДатаНачалаПрименения");
	
	Начисление					= УчетНДСПовтИсп.Начисление(ПричинаНалогообложения);
	НачислениеСразу				= УчетНДСПовтИсп.НачислениеСразу(ПричинаНалогообложения);
	НачислениеВБудущем			= УчетНДСПовтИсп.НачислениеВБудущем(ПричинаНалогообложения);
	Вычет						= УчетНДСПовтИсп.Вычет(ПричинаНалогообложения);
	ВычетСразу					= УчетНДСПовтИсп.ВычетСразу(ПричинаНалогообложения);
	ВычетВБудущем				= УчетНДСПовтИсп.ВычетВБудущем(ПричинаНалогообложения);
	РаспределениеВозможно		= УчетНДСПовтИсп.РаспределениеВозможно(ПричинаНалогообложения);
	Аванс						= УчетНДСПовтИсп.Аванс(ПричинаНалогообложения);
	ШкурыЛом					= УчетНДСПовтИсп.ШкурыЛом(ПричинаНалогообложения);
	НалоговыйАгент				= УчетНДСПовтИсп.НалоговыйАгент(ПричинаНалогообложения);
	СчетРасчетовИспользуется	= УчетНДСПовтИсп.СчетРасчетовИспользуется(ПричинаНалогообложения);
	КодВидаТовараИспользуется	= УчетНДСПовтИсп.КодВидаТовараИспользуется(ПричинаНалогообложения);
	Восстановление				= (Действие = Перечисления.ВариантыРегистрацииСтрокиКнигиПродаж.Восстановление);
	КомиссионнаяРеализация		= ЭтоКомиссионнаяРеализация(ПричинаНалогообложения);
	КомиссионнаяЗакупка			= ЭтоКомиссионнаяЗакупка(ПричинаНалогообложения);
	КомиссионнаяЗакупкаКомиссионер = ЭтоКомиссионнаяЗакупкаКомиссионер(ПричинаНалогообложения);
	
	СтруктураСвойств.Начисление					= Начисление;
	СтруктураСвойств.НачислениеСразу			= НачислениеСразу;
	СтруктураСвойств.НачислениеВБудущем			= НачислениеВБудущем;
	СтруктураСвойств.Вычет						= Вычет;
	СтруктураСвойств.ВычетСразу					= ВычетСразу;
	СтруктураСвойств.ВычетВБудущем				= ВычетВБудущем;
	СтруктураСвойств.РаспределениеВозможно		= РаспределениеВозможно;
	СтруктураСвойств.Аванс						= Аванс;
	СтруктураСвойств.ШкурыЛом					= ШкурыЛом;
	СтруктураСвойств.НалоговыйАгент				= НалоговыйАгент;
	СтруктураСвойств.СчетРасчетовИспользуется	= СчетРасчетовИспользуется;
	СтруктураСвойств.КодВидаТовараИспользуется	= КодВидаТовараИспользуется;
	СтруктураСвойств.КомиссионнаяРеализация		= КомиссионнаяРеализация;
	СтруктураСвойств.КомиссионнаяЗакупка		= КомиссионнаяЗакупка;
	СтруктураСвойств.КомиссионнаяЗакупкаКомиссионер = КомиссионнаяЗакупкаКомиссионер;
	
	// Начисление (пока состав свойств одинаков для всех инструкций)
	Если Начисление Тогда
		КЭКНачислениеДт = Неопределено;
		
		Если НалоговыйАгент Тогда
			ПараметрыУчета = СтрокаИнструкции["Начисление"]["НалоговыйАгент"];
			
		ИначеЕсли ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.АвансПолученный Тогда
			ПараметрыУчета = СтрокаИнструкции["Начисление"]["АвансПолученный"];
			
		ИначеЕсли ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.СчетФактураКомитентаНаАванс Тогда
			ПараметрыУчета = СтрокаИнструкции["Начисление"]["АвансПолученный"];
			
		ИначеЕсли СтрокаИнструкции["Идентификатор"] = "209н" И ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.АвансВыданный Тогда
			ПараметрыУчета = СтрокаИнструкции["Начисление"]["АвансВыданный"];
			
		ИначеЕсли ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.СМРХозяйственнымСпособом Тогда
			ПараметрыУчета = СтрокаИнструкции["Начисление"]["СМРХозяйственнымСпособом"];
			
		ИначеЕсли СтрокаИнструкции["Идентификатор"] = "209н" И ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.СчетФактураНаАвансОтКомиссионера Тогда
			ПараметрыУчета = СтрокаИнструкции["Начисление"]["АвансВыданный"];
			
		ИначеЕсли КФО = Перечисления.КВД.Бюджет Тогда
			ПараметрыУчета = СтрокаИнструкции["Начисление"]["ПрочееБюджет"];
			
			ПараметрыУчета.Свойство("КЭКНачислениеДт", КЭКНачислениеДт);
		Иначе
			ПараметрыУчета = СтрокаИнструкции["Начисление"]["Прочее"];
		КонецЕсли;
		
		СтруктураСвойств.СчетНачислениеДт				= ПараметрыУчета["СчетНачислениеДт"];
		СтруктураСвойств.СчетНачислениеДтЕдинственный	= ПараметрыУчета["СчетНачислениеДтЕдинственный"];
		СтруктураСвойств.ВидыПоказателяКПСНачислениеДт	= ПараметрыУчета["ВидыПоказателяКПСНачислениеДт"];
		СтруктураСвойств.КЭКНачислениеДт				= КЭКНачислениеДт;
	КонецЕсли;
	
	// Вычет (пока состав свойств одинаков для всех инструкций)
	Если Вычет Тогда
		Если ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.АвансПолученный Тогда
			ПараметрыУчета = СтрокаИнструкции["Вычет"]["АвансПолученный"];
			
		ИначеЕсли ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.СчетФактураКомитентаНаАванс Тогда
			ПараметрыУчета = СтрокаИнструкции["Вычет"]["АвансПолученный"];
			
		ИначеЕсли СтрокаИнструкции["Идентификатор"] = "209н" И ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.АвансВыданный 
			ИЛИ СтрокаИнструкции["Идентификатор"] = "209н" И ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.СчетФактураНаАвансОтКомиссионера Тогда
			ПараметрыУчета = СтрокаИнструкции["Вычет"]["АвансВыданный"];
			
		Иначе
			ПараметрыУчета = СтрокаИнструкции["Вычет"]["Прочее"];
		КонецЕсли;
		СчетВычетКт								= ПараметрыУчета["СчетВычетКт"];
		СчетВычетКтЕдинственный					= ПараметрыУчета["СчетВычетКтЕдинственный"];
		СчетВычетКтКРаспределениюПоУмолчанию	= ПараметрыУчета["СчетВычетКтКРаспределениюПоУмолчанию"];
		СчетВычетКтБезРаспределенияПоУмолчанию	= ПараметрыУчета["СчетВычетКтБезРаспределенияПоУмолчанию"];
		ВидыПоказателяКПСВычетКт				= ПараметрыУчета["ВидыПоказателяКПСВычетКт"];
		
		Если НЕ РаспределениеВозможно Тогда
			СчетВычетКт								= СчетВычетКтБезРаспределенияПоУмолчанию;
			СчетВычетКтКРаспределениюПоУмолчанию	= СчетВычетКтБезРаспределенияПоУмолчанию;
			СчетВычетКтЕдинственный = Истина;
		КонецЕсли;
		
		СтруктураСвойств.СчетВычетКт							= СчетВычетКт;
		СтруктураСвойств.СчетВычетКтЕдинственный				= СчетВычетКтЕдинственный;
		СтруктураСвойств.СчетВычетКтКРаспределениюПоУмолчанию	= СчетВычетКтКРаспределениюПоУмолчанию;
		СтруктураСвойств.СчетВычетКтБезРаспределенияПоУмолчанию	= СчетВычетКтБезРаспределенияПоУмолчанию;
		СтруктураСвойств.ВидыПоказателяКПСВычетКт				= ВидыПоказателяКПСВычетКт;
	КонецЕсли;
	
	// Восстановление (пока состав свойств одинаков для всех инструкций)
	Если Восстановление Тогда
		// Проводка по восстановлению - зеркальная к проводке принятия к вычету
		// Параметры начисления такие же, как для вычета
		СтруктураСвойств.СчетНачислениеДт				= ПараметрыУчета["СчетВычетКтБезРаспределенияПоУмолчанию"];
		СтруктураСвойств.СчетНачислениеДтЕдинственный	= ПараметрыУчета["СчетВычетКтЕдинственный"];
		СтруктураСвойств.ВидыПоказателяКПСНачислениеДт	= ПараметрыУчета["ВидыПоказателяКПСВычетКт"];
	КонецЕсли;
	
	// Расчеты по налогу (пока состав свойств одинаков для всех инструкций)
	ПараметрыУчета = СтрокаИнструкции["РасчетыПоНалогу"];
	СтруктураСвойств.Счет30304 = ПараметрыУчета["Счет"];
	СтруктураСвойств.ВидыПоказателяКПС30304 = ?(НалоговыйАгент,
		ПараметрыУчета["ВидыПоказателяКПС_НалоговыйАгент"],
		ПараметрыУчета["ВидыПоказателяКПС_Прочее"]);
	
	Возврат СтруктураСвойств;
	
КонецФункции

Функция ИнструкцииУчета_ПолучитьСтрокуОбщейТаблицы(Идентификатор) Экспорт
	
	ОбщаяТаблицаНастроек = УчетНДСПовтИсп.ИнструкцииУчета_ПолучитьОбщуюТаблицуНастроек();
	
	СуществующиеИдентификаторы = ОбщаяТаблицаНастроек.ВыгрузитьКолонку("Идентификатор");
	
	ИндексСтроки = СуществующиеИдентификаторы.Найти(Идентификатор);
	
	Если ИндексСтроки = Неопределено Тогда
		Результат = Неопределено;
	Иначе
		Результат = Новый Структура(УчетНДСПовтИсп.ИнструкцииУчета_ПолучитьПустуюСтруктуруСтроки());
		ЗаполнитьЗначенияСвойств(Результат, ОбщаяТаблицаНастроек[ИндексСтроки]);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИнструкцииУчета_ПолучитьСписокИдентификаторов() Экспорт
	
	ОбщаяТаблицаНастроек = УчетНДСПовтИсп.ИнструкцииУчета_ПолучитьОбщуюТаблицуНастроек();
	
	Результат = Новый СписокЗначений();
	
	Для Каждого СтрокаТаблицы Из ОбщаяТаблицаНастроек Цикл
		Результат.Добавить(СтрокаТаблицы["Идентификатор"], СтрокаТаблицы["Представление"]);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ИнструкцииУчета_ПолучитьСписокДатНачалаПрименения() Экспорт
	
	ОбщаяТаблицаНастроек = УчетНДСПовтИсп.ИнструкцииУчета_ПолучитьОбщуюТаблицуНастроек();
	
	Результат = Новый СписокЗначений();
	
	Для Каждого СтрокаТаблицы Из ОбщаяТаблицаНастроек Цикл
		Результат.Добавить(СтрокаТаблицы["ДатаНачалаПрименения"], СтрокаТаблицы["Идентификатор"]);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция АвтоСчетНачислениеДтДляКСФ(Дата, ПричинаНалогообложения, КФО) Экспорт
	
	Перем Параметр;
	
	СтрокаИнструкции = УчетНДСКлиентСервер.ИнструкцииУчета_ОпределитьСтрокуОбщейТаблицы(Дата);
	
	Если ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.АвансПолученный Тогда
		
		ДоплатаНалога = КлассифицироватьДоплатуНалога2Процента();
		
		Если ДоплатаНалога = "Аванс" Тогда
			
			Возврат СтрокаИнструкции["Начисление"]["АвансПолученный"]["СчетНачислениеДт"];
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если КФО = Перечисления.КВД.Бюджет Тогда
		
		Возврат СтрокаИнструкции["Начисление"]["ПрочееБюджет"]["СчетНачислениеДт"];
		
	Иначе
		
		СтрокаИнструкции["Начисление"]["Прочее"].Свойство("СчетНачислениеДтПоУмолчанию", Параметр);
		
		Возврат Параметр;
		
	КонецЕсли;
	
КонецФункции

// Возвращает одну из строк "Прочее", "Аванс"
Функция КлассифицироватьДоплатуНалога2Процента() Экспорт
	
	Возврат "Прочее"; // "Аванс"
	
КонецФункции

#КонецОбласти

#Область СтороныСделки

Функция ОпределитьАдресПродавцаПокупателя(Объект, ОбщаяКонтактнаяИнформация, ОбъектЯвляетсяФизЛицом) Экспорт
	
	Если Объект = Неопределено Тогда
		ВидАдреса = Неопределено
		
	ИначеЕсли ОбъектЯвляетсяФизЛицом Тогда
		ВидАдреса = Справочники.ВидыКонтактнойИнформации.АдресПоПропискеФизическиеЛица;
		
	Иначе
		Если ТипЗнч(Объект) = Тип("СправочникСсылка.Организации") Тогда
			ВидАдреса = Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации;
			
		Иначе
			ВидАдреса = Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ОпределитьАдрес(Объект, ОбщаяКонтактнаяИнформация, ВидАдреса);
	
КонецФункции

Функция ОпределитьАдресГрузоотправителяГрузополучателя(Объект, ОбщаяКонтактнаяИнформация, ОбъектЯвляетсяФизЛицом, ЮридическийАдресПоУмолчанию) Экспорт
	
	// Сначала пробуем определить фактический адрес
	
	Если Объект = Неопределено Тогда
		ВидАдреса = Неопределено
		
	ИначеЕсли ОбъектЯвляетсяФизЛицом Тогда
		ВидАдреса = Справочники.ВидыКонтактнойИнформации.АдресМестаПроживанияФизическиеЛица;
		
	Иначе
		Если ТипЗнч(Объект) = Тип("СправочникСсылка.Организации") Тогда
			ВидАдреса = Справочники.ВидыКонтактнойИнформации.ФактАдресОрганизации;
			
		ИначеЕсли ТипЗнч(Объект) = Тип("СправочникСсылка.Подразделения") Тогда
			ВидАдреса = Справочники.ВидыКонтактнойИнформации.ФактическийАдресПодразделенияОрганизаций;
			
		Иначе
			ВидАдреса = Справочники.ВидыКонтактнойИнформации.ФактическийАдресКонтрагенты;
		КонецЕсли;
	КонецЕсли;
	
	Адрес = ОпределитьАдрес(Объект, ОбщаяКонтактнаяИнформация, ВидАдреса);
	
	Если ЗначениеЗаполнено(Адрес.Представление) Тогда
		Возврат Адрес;
	КонецЕсли;
	
	// Если фактический адрес не указан, то пробуем определить юридический адрес
	
	Если Объект = Неопределено Тогда
		ВидАдреса = Неопределено
		
	ИначеЕсли ОбъектЯвляетсяФизЛицом Тогда
		ВидАдреса = Справочники.ВидыКонтактнойИнформации.АдресПоПропискеФизическиеЛица;
		
	Иначе
		Если ТипЗнч(Объект) = Тип("СправочникСсылка.Организации") Тогда
			ВидАдреса = Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации;
			
		ИначеЕсли ТипЗнч(Объект) = Тип("СправочникСсылка.Подразделения") Тогда
			Возврат ЮридическийАдресПоУмолчанию;
			
		Иначе
			ВидАдреса = Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ОпределитьАдрес(Объект, ОбщаяКонтактнаяИнформация, ВидАдреса);	
	
КонецФункции

Функция ОпределитьПродавца(ШапкаДокументаРасширенная, ОбщаяКонтактнаяИнформация = Неопределено, ДополнитьСведениямиДляЭДО = Ложь) Экспорт
	
	Возврат ОпределитьСторонуСделки("Продавец", ШапкаДокументаРасширенная, ОбщаяКонтактнаяИнформация, ДополнитьСведениямиДляЭДО);
	
КонецФункции

Функция ОпределитьПокупателя(ШапкаДокументаРасширенная, ОбщаяКонтактнаяИнформация = Неопределено, ДополнитьСведениямиДляЭДО = Ложь) Экспорт
	
	СторонаСделки = ОпределитьСторонуСделки("Покупатель", ШапкаДокументаРасширенная, ОбщаяКонтактнаяИнформация, ДополнитьСведениямиДляЭДО);
	
	Возврат СторонаСделки;
	
КонецФункции

Функция ОпределитьПродавцаПокупателя(ШапкаДокументаРасширенная, ОбщаяКонтактнаяИнформация = Неопределено, ДополнитьСведениямиДляЭДО = Ложь) Экспорт
	
	СтруктураПродавца = ОпределитьПродавца(ШапкаДокументаРасширенная, ОбщаяКонтактнаяИнформация, ДополнитьСведениямиДляЭДО);
	
	СтруктураПокупателя = ОпределитьПокупателя(ШапкаДокументаРасширенная, ОбщаяКонтактнаяИнформация, ДополнитьСведениямиДляЭДО);
	
	СтороныСделки = Новый Структура();
	
	СтороныСделки.Вставить("Продавец",		СтруктураПродавца["Продавец"]);
	СтороныСделки.Вставить("Покупатель",	СтруктураПокупателя["Покупатель"]);
	
	Если ОбщаяКонтактнаяИнформация <> Неопределено Тогда
		СтороныСделки.Вставить("ГрузоотправительПоУмолчанию",	СтруктураПродавца["ГрузоотправительПоУмолчанию"]);
		СтороныСделки.Вставить("ГрузополучательПоУмолчанию",	СтруктураПокупателя["ГрузополучательПоУмолчанию"]);
	КонецЕсли;
	
	Возврат СтороныСделки;
	
КонецФункции

Функция ОпределитьПродавцаПокупателяГрузоотправителяГрузополучателя(ШапкаДокументаРасширенная, ОбщаяКонтактнаяИнформация, ДополнитьСведениямиДляЭДО = Ложь) Экспорт
	
	ПродавецПокупатель = ОпределитьПродавцаПокупателя(
		ШапкаДокументаРасширенная,
		ОбщаяКонтактнаяИнформация,
		ДополнитьСведениямиДляЭДО);
	
	ГрузоотправительГрузополучатель = ОпределитьГрузоотправителяГрузополучателя(
		ШапкаДокументаРасширенная,
		ПродавецПокупатель,
		ОбщаяКонтактнаяИнформация,
		ДополнитьСведениямиДляЭДО);
		
	СтороныСделки = Новый Структура();
	СтороныСделки.Вставить("Продавец",			ПродавецПокупатель["Продавец"]);
	СтороныСделки.Вставить("Покупатель",		ПродавецПокупатель["Покупатель"]);
	СтороныСделки.Вставить("Грузоотправитель",	ГрузоотправительГрузополучатель["Грузоотправитель"]);
	СтороныСделки.Вставить("Грузополучатель",	ГрузоотправительГрузополучатель["Грузополучатель"]);
	
	Возврат СтороныСделки;
	
КонецФункции

Функция ОпределитьНомерСФДляВыводаВРегистрыУчета(ДетальнаяЗапись) Экспорт
	
	НомерСФ = Новый Структура("Номер,НомерКСФ");
	
	ИмяДокумента = ДетальнаяЗапись["ИмяДокумента"];
	
	НеобходимоОбработатьНомер = (ИмяДокумента = "СчетФактураВыданный"
								ИЛИ ИмяДокумента = "КорректировочныйСчетФактураВыданный"
								ИЛИ ИмяДокумента = "ИсправительныйСчетФактураВыданный");
	
	Если НеобходимоОбработатьНомер Тогда
		
		Если ЗначениеЗаполнено(ДетальнаяЗапись["ИмяИсправляемогоДокумента"]) Тогда
			ИмяДокумента = ДетальнаяЗапись["ИмяИсправляемогоДокумента"];
		КонецЕсли;
		
		Если ИмяДокумента = "СчетФактураВыданный" Тогда
			
			Номер = ОчиститьНомерОтПрефиксовИДобавитьИндексОП(ДетальнаяЗапись, ИмяДокумента);
			
			НомерСФ.Вставить("Номер", Номер);
			
			НомерСФ.Вставить("НомерКСФ", "");
			
		ИначеЕсли ИмяДокумента = "КорректировочныйСчетФактураВыданный" Тогда
			
			Номер = ОчиститьНомерОтПрефиксовИДобавитьИндексОП(ДетальнаяЗапись, "СчетФактураВыданный");
			
			НомерСФ.Вставить("Номер", Номер);
			
			НомерКСФ = ОчиститьНомерОтПрефиксовИДобавитьИндексОП(ДетальнаяЗапись, ИмяДокумента, "НомерКСФ");
			
			НомерСФ.Вставить("НомерКСФ", НомерКСФ);
			
		КонецЕсли;
		
	Иначе
		
		ЗаполнитьЗначенияСвойств(НомерСФ, ДетальнаяЗапись);
		
	КонецЕсли;
	
	Возврат НомерСФ;
	
КонецФункции

Функция ОпределитьПоОбъектуНомерСФДляВыводаВРегистрыУчета(ДокументОбъект) Экспорт
	
	ДетальнаяЗапись = РасширитьШапкуДокументаДляОпределенияНомераСФДляВыводаВРегистрыУчета(ДокументОбъект);
	
	Возврат ОпределитьНомерСФДляВыводаВРегистрыУчета(ДетальнаяЗапись);
	
КонецФункции

Функция ОпределитьПоСсылкеНомерСФДляВыводаВРегистрыУчета(ДокументСсылка, ДатыДокументов = Неопределено) Экспорт
	
	// Предполагается вызов только для составленных нами документов счетов-фактур выданных.
	
	ШапкаДокумента = ПолучитьШапкуДокументаДляОпределенияНомераСФДляВыводаВРегистрыУчета(ДокументСсылка);
	
	ДетальнаяЗапись = РасширитьШапкуДокументаДляОпределенияНомераСФДляВыводаВРегистрыУчета(ШапкаДокумента, ДатыДокументов);
	
	НомерСФ = ОпределитьНомерСФДляВыводаВРегистрыУчета(ДетальнаяЗапись);
	
	Возврат НомерСФ;
	
КонецФункции

Функция ОпределитьПоСсылкеПродавцаПокупателяГрузоотправителяГрузополучателя(СчетФактураСсылка) Экспорт
	
	// Используется только для выставленных учреждением документов.
	// Для полученных документов не используется.
	
	Перем ИменаРеквизитов;
	
	ПустоеЗначение = Неопределено;
	
	Если НЕ ЗначениеЗаполнено(СчетФактураСсылка) Тогда
		Возврат ПустоеЗначение;
	КонецЕсли;
	
	ДобавитьПричинуНалогообложения = Ложь;
	
	Если ТипЗнч(СчетФактураСсылка) = Тип("ДокументСсылка.СчетФактураВыданный")
		ИЛИ ТипЗнч(СчетФактураСсылка) = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный") Тогда
		ИменаРеквизитов = "Дата,Контрагент,Организация,Подразделение,ПричинаНалогообложения,Грузоотправитель,Грузополучатель";
		
	ИначеЕсли ТипЗнч(СчетФактураСсылка) = Тип("ДокументСсылка.КорректировочныйСчетФактураВыданный") Тогда
		ИменаРеквизитов = "Дата,Контрагент,Организация,Подразделение,ПричинаНалогообложения,НомерПервичногоДокумента";
		
	ИначеЕсли ТипЗнч(СчетФактураСсылка) = Тип("ДокументСсылка.АктОбОказанииУслуг") Тогда
		ИменаРеквизитов = "Дата,Контрагент,Организация,Подразделение,РеализацияПоСтавке0";
		
		ДобавитьПричинуНалогообложения = Истина;
	
	ИначеЕсли ТипЗнч(СчетФактураСсылка) = Тип("ДокументСсылка.ОтчетКомитенту") Тогда
		ИменаРеквизитов = "Дата,Контрагент,Организация,Подразделение";
		
		ДобавитьПричинуНалогообложения = Истина;
		
	ИначеЕсли ТипЗнч(СчетФактураСсылка) = Тип("ДокументСсылка.НакладнаяНаОтпускМ15")
		Или ТипЗнч(СчетФактураСсылка) = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12") Тогда
		ИменаРеквизитов = Новый Структура("Дата,Контрагент,Организация,Подразделение,РеализацияПоСтавке0,Грузоотправитель,Грузополучатель");
		ИменаРеквизитов.Вставить("ТипДоговораНДС", "Договор.ТипДоговораНДС");
		
		ДобавитьПричинуНалогообложения = Истина;
		
	ИначеЕсли ТипЗнч(СчетФактураСсылка) = Тип("ДокументСсылка.ПередачаОбъектовИК")
		Или ТипЗнч(СчетФактураСсылка) = Тип("ДокументСсылка.ПередачаОбъектовОС") Тогда
		ИменаРеквизитов = Новый Структура("Дата,Контрагент,Организация,Подразделение,Грузоотправитель,Грузополучатель");
		
		ДобавитьПричинуНалогообложения = Истина;
		
	ИначеЕсли ТипЗнч(СчетФактураСсылка) = Тип("ДокументСсылка.ЭлектронныйПередаточныйДокументУслугиРаботы") Тогда
		ИменаРеквизитов = Новый Структура("Дата,Контрагент,Организация");
		ИменаРеквизитов.Вставить("Подразделение", "ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)");
		
		ДобавитьПричинуНалогообложения = Истина;
		
	ИначеЕсли ТипЗнч(СчетФактураСсылка) = Тип("ДокументСсылка.ПоступлениеУслугРабот") Тогда
		ИменаРеквизитов = Новый Структура("Дата,Контрагент,Организация,Подразделение");
		ИменаРеквизитов.Вставить("ТипДоговораНДС", "Договор.ТипДоговораНДС");
		
		ДобавитьПричинуНалогообложения = Истина;
	
	ИначеЕсли ТипЗнч(СчетФактураСсылка) = Тип("ДокументСсылка.ПоступлениеОСИК") Тогда
		ИменаРеквизитов = "Дата,Контрагент,Организация,Подразделение";
		
		ДобавитьПричинуНалогообложения = Истина;
		
	Иначе
		Возврат ПустоеЗначение;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	ШапкаДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СчетФактураСсылка, ИменаРеквизитов);
	УстановитьПривилегированныйРежим(Ложь);
	
	Если ДобавитьПричинуНалогообложения Тогда
		ДобавитьПричинуНалогообложенияДокументаРеализации(ШапкаДокумента, СчетФактураСсылка);
	КонецЕсли;
	
	Данные = УчетНДС.РасширитьШапкуДокументаДляОпределенияПродавцаПокупателяГрузоотправителяГрузополучателя(ШапкаДокумента);
	
	ОбщаяКонтактнаяИнформация = УчетНДС.ПолучитьОбщуюКонтактнуюИнформациюПродавцаПокупателяГрузоотправителяГрузополучателя(
		Данные["СписокОбъектовДляОпределенияАдресов"]);
		
	ДополнитьСведениямиДляЭДО = Истина;
	
	СтороныСделки = УчетНДС.ОпределитьПродавцаПокупателяГрузоотправителяГрузополучателя(
		Данные["ШапкаДокументаРасширенная"],
		ОбщаяКонтактнаяИнформация,
		ДополнитьСведениямиДляЭДО);
		
	Возврат СтороныСделки;
	
КонецФункции

Функция ЗаполненыОбязательныеРеквизитыДляОпределенияСторонСделки(ШапкаДокумента) Экспорт
	
	Если ЗначениеЗаполнено(ШапкаДокумента.Дата)
		И ЗначениеЗаполнено(ШапкаДокумента.Контрагент)
		И ЗначениеЗаполнено(ШапкаДокумента.Организация)
		И ЗначениеЗаполнено(ШапкаДокумента.ПричинаНалогообложения) Тогда
		
		Возврат Истина;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция РасширитьШапкуДокументаДляОпределенияПродавцаПокупателяГрузоотправителяГрузополучателя(ШапкаДокумента) Экспорт
	
	Перем Грузоотправитель, Грузополучатель;
	
	// Используются запросы, аналогичные запросам книги покупок и книги продаж
	
	ПустаяДата = '00010101';
	
	ПустойКонтрагент = Справочники.Контрагенты.ПустаяСсылка();
	
	Если НЕ ШапкаДокумента.Свойство("Грузоотправитель", Грузоотправитель) Тогда
		Грузоотправитель = ПустойКонтрагент; // для корректной работы следующего запроса
	КонецЕсли;
	
	Если НЕ ШапкаДокумента.Свойство("Грузополучатель", Грузополучатель) Тогда
		Грузополучатель = ПустойКонтрагент; // для корректной работы следующего запроса
	КонецЕсли;
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("Дата",								ШапкаДокумента.Дата);
	ЗапросПоиск.УстановитьПараметр("Организация",						ШапкаДокумента.Организация);
	ЗапросПоиск.УстановитьПараметр("Подразделение",						ШапкаДокумента.Подразделение);
	ЗапросПоиск.УстановитьПараметр("Контрагент",						ШапкаДокумента.Контрагент);
	ЗапросПоиск.УстановитьПараметр("ПричинаНалогообложения",			ШапкаДокумента.ПричинаНалогообложения);
	ЗапросПоиск.УстановитьПараметр("Грузоотправитель",					Грузоотправитель);
	ЗапросПоиск.УстановитьПараметр("Грузополучатель",					Грузополучатель);
	ЗапросПоиск.УстановитьПараметр("ПустаяДата",						ПустаяДата);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",	ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
