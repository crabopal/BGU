	Результат.Вставить("СписокОбъектовДляОпределенияАдресов", РезультатыЗапроса[6].Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьОбщуюКонтактнуюИнформациюПродавцаПокупателяГрузоотправителяГрузополучателя(СписокОбъектовДляОпределенияАдресов) Экспорт
	
	// Определим адреса сторон с помощью подсистемы "Контактная информация"
	
	Если СписокОбъектовДляОпределенияАдресов.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТипыКИ = Новый Массив();
	ТипыКИ.Добавить(Перечисления.ТипыКонтактнойИнформации.Адрес);
	
	// Адрес Продавца / Покупателя
	ВидыКИ = ПолучитьВидыКонтактнойИнформацииПродавцаПокупателя();
	
	// Адрес Грузоотправителя / Грузополучателя
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВидыКИ, ПолучитьВидыКонтактнойИнформацииГрузоотправителяГрузополучателя());
	
	// Для каждого объекта может быть произвольное количество строк в этой таблице (в том числе 0 строк)
	ОбщаяКонтактнаяИнформация = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъектов(
		СписокОбъектовДляОпределенияАдресов,
		ТипыКИ,
		ВидыКИ);
		
	Возврат ОбщаяКонтактнаяИнформация;
	
КонецФункции

#КонецОбласти

#Область ДокументыОбОтгрузке

// Формирует текст надписи "Документы об отгрузке" для формы документа счета-фактуры.
//
// Параметры:
//	ТаблицаДокументыОбОтгрузке	- ТаблицаЗначений	- таблица документов об отгрузке, состав колонок см. функцию НовыйТаблицаДокументыОбОтгрузке()
//	МаксимальнаяДлина			- Число	- максимальная длина возвращаемой строки. При превышении длины строки она обрезается справа.
//
// Возвращаемое значение:
//	Строка	- текст для вывода на форму документа.
Функция ПолучитьНадписьДокументыОбОтгрузке(ТаблицаДокументыОбОтгрузке, НаДату, МаксимальнаяДлина = 150) Экспорт
	
	Если ТаблицаДокументыОбОтгрузке.Количество() = 0 Тогда
		Возврат НСтр("ru='<Авто>'");
	Иначе
		Строка5а = ПолучитьПредставлениеСтроки5а(ТаблицаДокументыОбОтгрузке, НаДату);
		
		Если СтрДлина(Строка5а) > МаксимальнаяДлина Тогда
			Многоточие = "...";
			
			Строка5а = Лев(Строка5а, МаксимальнаяДлина - СтрДлина(Многоточие)) + Многоточие;
		КонецЕсли;
		
		Возврат Строка5а;
	КонецЕсли;
	
КонецФункции

// Формирует текст для строки 5а печатной формы счета-фактуры и визуализации ЭД.
//
// Параметры:
//	ТаблицаДокументыОбОтгрузке	- ТаблицаЗначений	- таблица документов об отгрузке, состав колонок см. функцию НовыйТаблицаДокументыОбОтгрузке()
//
// Возвращаемое значение:
//	Строка	- текст для вывода в печатную форму и визуализацию ЭД.
Функция ПолучитьПредставлениеСтроки5а(ТаблицаДокументыОбОтгрузке, НаДату) Экспорт
	
	СимволПрочерка = "--";
	
	ЭтоПостановление1096 = (НаДату >= '20241001');
	
	Если ЭтоПостановление1096 Тогда
		Шаблон = НСтр("ru='%1, №%2 от %3 г.'");
	Иначе
		Шаблон = НСтр("ru='№ п/п %1 №%2 от %3 г.'");
	КонецЕсли;
	
	МассивСтрок = Новый Массив();
	
	Для Каждого СтрокаТаблицы Из ТаблицаДокументыОбОтгрузке Цикл
		НомерДокумента = ?(ЗначениеЗаполнено(СтрокаТаблицы.НомерДокумента), СтрокаТаблицы.НомерДокумента, СимволПрочерка);
		ДатаДокумента = ?(ЗначениеЗаполнено(СтрокаТаблицы.ДатаДокумента), Формат(СтрокаТаблицы.ДатаДокумента, "ДФ=dd.MM.yyyy"), СимволПрочерка);
		
		Если ЭтоПостановление1096 Тогда
			МассивСтрок.Добавить(СтрШаблон(Шаблон,
				СтрокаТаблицы.НаименованиеДокумента,
				НомерДокумента,
				ДатаДокумента));
		Иначе
			МассивСтрок.Добавить(СтрШаблон(Шаблон,
				СтрокаТаблицы.НомераСтрок,
				НомерДокумента,
				ДатаДокумента));
		КонецЕсли;
	КонецЦикла;
	
	Если МассивСтрок.Количество() = 0 Тогда
		МассивСтрок.Добавить(СтрШаблон(Шаблон, СимволПрочерка, СимволПрочерка, СимволПрочерка));
	КонецЕсли;
	
	Возврат СтрСоединить(МассивСтрок, ";");
	
КонецФункции

// Выделяет непрерывные диапазоны натуральных чисел из переданного массива.
//
// Параметры:
//	МассивЗначений	- Массив	- упорядоченный список натуральных чисел.
//								Упорядочивание является обязательным.
//								Например, 1,2,3,4,5,9
//
// Возвращаемое значение:
//	Строка	- представление выделенных диапазонов.
//			Для приведенного выше примера это будет строка "1-5,9".
//			Форматирование диапазона значений регулируется в функции ФорматироватьДиапазонЧисловыхЗначений.
Функция ВыделитьДиапазоныЧисловыхЗначений(МассивЗначений) Экспорт
	
	Перем НачальноеЗначение, ТекущееЗначение, ПредыдущееЗначение;
	
	Если МассивЗначений.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	ПредставленияДиапазонов = Новый Массив();
	
	Для Индекс = 0 По МассивЗначений.ВГраница() Цикл
		
		ТекущееЗначение = МассивЗначений[Индекс];
		
		Если Индекс = 0 Тогда
			НачальноеЗначение = ТекущееЗначение;
			Продолжить;
		КонецЕсли;
		
		ПредыдущееЗначение = МассивЗначений[Индекс-1];
		
		Если ТекущееЗначение <> ПредыдущееЗначение + 1 Тогда
			ПредставленияДиапазонов.Добавить(ФорматироватьДиапазонЧисловыхЗначений(НачальноеЗначение, ПредыдущееЗначение));
			
			НачальноеЗначение = ТекущееЗначение;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ПредыдущееЗначение = Неопределено Тогда
		ПредставленияДиапазонов.Добавить(ФорматироватьДиапазонЧисловыхЗначений(ТекущееЗначение, ТекущееЗначение));
	ИначеЕсли ТекущееЗначение = ПредыдущееЗначение + 1 Тогда
		ПредставленияДиапазонов.Добавить(ФорматироватьДиапазонЧисловыхЗначений(НачальноеЗначение, ТекущееЗначение));
	Иначе
		ПредставленияДиапазонов.Добавить(ФорматироватьДиапазонЧисловыхЗначений(ТекущееЗначение, ТекущееЗначение));
	КонецЕсли;
	
	Возврат СтрСоединить(ПредставленияДиапазонов, ",");
	
КонецФункции

Функция ФорматироватьДиапазонЧисловыхЗначений(НачальноеЗначение, КонечноеЗначение, ДваСмежныхЗначенияРазделятьЗапятой = Ложь) Экспорт
	
	Если КонечноеЗначение = 0 Тогда
		Возврат "";
	ИначеЕсли НачальноеЗначение = КонечноеЗначение Тогда
		Возврат Формат(НачальноеЗначение, "ЧГ=");
	Иначе
		Шаблон = "%1-%2";
		
		Если КонечноеЗначение = НачальноеЗначение + 1 И ДваСмежныхЗначенияРазделятьЗапятой Тогда
			Шаблон = "%1,%2";
		КонецЕсли;
		
		Возврат СтрШаблон(Шаблон, Формат(НачальноеЗначение, "ЧГ="), Формат(КонечноеЗначение, "ЧГ="));
	КонецЕсли;
	
КонецФункции

Функция НовыйТаблицаДокументыОбОтгрузке() Экспорт
	
	ТипСтрока = Новый ОписаниеТипов("Строка");
	
	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("НомераСтрок",				ТипСтрока);
	Таблица.Колонки.Добавить("НаименованиеДокумента",	ТипСтрока);
	Таблица.Колонки.Добавить("НомерДокумента",			ТипСтрока);
	Таблица.Колонки.Добавить("ДатаДокумента",			ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	
	Возврат Таблица;
	
КонецФункции

#КонецОбласти

#Область ЦепочкиДокументовСчетовФактур

// Ошибки диагностируются только в цепочке документов от проверяемого к началу цепочки.
Процедура ПроверитьЦепочкуДокументовСчетовФактур(Знач ДокументОбъект, Отказ = Неопределено) Экспорт
	
	ДанныеЦепочки = ПрочитатьЦепочкуДокументовВСторонуНачала(ДокументОбъект);
	
	ДанныеОшибкиЦиклическиеСсылки = ПолучитьДанныеОшибкиЦиклическиеСсылки(ДанныеЦепочки.СписокОшибок);
	
	Если ДанныеОшибкиЦиклическиеСсылки <> Неопределено Тогда
		ТекстСправочно = ?(Отказ = Неопределено, НСтр("ru='Справочно: '"), "");
		
		ТекстСообщения = СтрШаблон("%1%2", ТекстСправочно, ДанныеОшибкиЦиклическиеСсылки.ТекстСообщения);
		
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка,,, Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДиагностироватьЦепочкуДокументовСчетовФактур(ФормаДокумента) Экспорт
	
	РезультатыДиагностики = НовыйРезультатыДиагностикиЦепочкиДокументовНаФормеДокумента();
	
	// Цепочка документов в сторону начала.
	ДанныеЦепочки = ПрочитатьЦепочкуДокументовВСторонуНачала(ФормаДокумента.Объект);
	
	ДанныеОшибкиЦиклическиеСсылки = ПолучитьДанныеОшибкиЦиклическиеСсылки(ДанныеЦепочки.СписокОшибок);
	
	ОбнаруженыЦиклическиеСсылки = ДанныеОшибкиЦиклическиеСсылки <> Неопределено;
	
	РезультатыДиагностики.ОбнаруженыЦиклическиеСсылки = ОбнаруженыЦиклическиеСсылки;
	
	// Последующие документы.
	ТаблицаПоследующихДокументов = ПрочитатьПоследующиеДокументы(ФормаДокумента.Объект);
	
	ОбнаруженыПоследующиеДокументы = (ТаблицаПоследующихДокументов.Количество() > 0);
	
	РезультатыДиагностики.ОбнаруженыПоследующиеДокументы = ОбнаруженыПоследующиеДокументы;
	
	ФормаДокумента.РезультатыДиагностикиЦепочкиДокументов = Новый ФиксированнаяСтруктура(РезультатыДиагностики);
	
	ОбновитьИндикаторыЦепочкиДокументовНаФормеДокумента(ФормаДокумента, ДанныеЦепочки, ТаблицаПоследующихДокументов);
	
КонецПроцедуры

Процедура ПроверитьНаличиеПозицийНФАВДокументеОсновании(Знач ДокументОбъектКСФ, Отказ = Неопределено) Экспорт
	
	Если ТипЗнч(ДокументОбъектКСФ.Ссылка) <> Тип("ДокументСсылка.КорректировочныйСчетФактураВыданный")
		И ТипЗнч(ДокументОбъектКСФ.Ссылка) <> Тип("ДокументСсылка.КорректировочныйСчетФактураПолученный") Тогда
		Возврат;
	КонецЕсли;
	
	ОснованиеСсылка = ДокументОбъектКСФ.ДокументОснование;
	
	Если Не ЗначениеЗаполнено(ОснованиеСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ОснованиеСсылка) <> Тип("ДокументСсылка.СчетФактураВыданный")
		И ТипЗнч(ОснованиеСсылка) <> Тип("ДокументСсылка.СчетФактураПолученный")
		И ТипЗнч(ОснованиеСсылка) <> Тип("ДокументСсылка.КорректировочныйСчетФактураВыданный")
		И ТипЗнч(ОснованиеСсылка) <> Тип("ДокументСсылка.КорректировочныйСчетФактураПолученный")
		И ТипЗнч(ОснованиеСсылка) <> Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный")
		И ТипЗнч(ОснованиеСсылка) <> Тип("ДокументСсылка.ИсправительныйСчетФактураПолученный") Тогда
		Возврат;
	КонецЕсли;
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("Ссылка", ОснованиеСсылка);
	ЗапросПоиск.Текст = СтрШаблон("
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	НФА КАК НФА
		|ИЗ
		|	%1.СоставНФА КАК ТЧСоставНФА
		|ГДЕ
		|	Ссылка = &Ссылка",
		ОбщегоНазначения.ИмяТаблицыПоСсылке(ОснованиеСсылка));
	
	УстановитьПривилегированныйРежим(Истина);
	СписокНФАОснования = ЗапросПоиск.Выполнить().Выгрузить().ВыгрузитьКолонку("НФА");
	УстановитьПривилегированныйРежим(Ложь);
	
	Для Каждого СтрокаТаблицы Из ДокументОбъектКСФ.СоставНФА Цикл
		НФА = СтрокаТаблицы.НФА;
		
		Если Не ЗначениеЗаполнено(НФА) Тогда
			Продолжить;
		КонецЕсли;
		
		Если СписокНФАОснования.Найти(НФА) = Неопределено Тогда
			УточняющийТекст = СтрШаблон(
				НСтр("ru='В списке товаров, работ, услуг документа-основания отсутствует позиция ""%1""'"),
				Строка(НФА));
				
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
				"НФА", СтрокаТаблицы.НомерСтроки, НСтр("ru='Товары, работы, услуги'"), УточняющийТекст);
				
			ТекстСправочно = ?(Отказ = Неопределено, НСтр("ru='Справочно: '"), "");
			
			ТекстСообщения = СтрШаблон("%1%2", ТекстСправочно, ТекстСообщения);
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъектКСФ.Ссылка,
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СоставНФА", СтрокаТаблицы.НомерСтроки, "НФА"),
				"Объект", Отказ);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ДокументыСчетовФактурНаАвансСтрока5б

// Таблица счетов-фактур на аванс, по которым успешно диагностируется зачет аванса по указанной аналитике.
// Используется для автоматического заполнения табличной части СчетаФактурыНаАванс документов
// отгрузочных счетов-фактур (строка 5б).
//
// Параметры:
//	Отбор - Структура - отбор для поиска документов, см. функцию НовыйОтборОстаткиВходящийНДСАвансыПолученные().
//
// Возвращаемое значение:
//	ТаблицаЗначений - см. функцию НовыйТаблицаДокументовСчетаФактурыНаАванс()
Функция ПолучитьТаблицуДокументовСчетовФактурНаАванс(Отбор, ДобавитьКолонкиАналитики = Ложь) Экспорт
	
	ИменаКолонокАналитикиСтрокой = ПолучитьИменаКолонокАналитикиСтрокойТаблицаСчетаФактурыНаАванс();
	
	СчетаФактурыНаАванс = НайтиСчетаФактурыНаАвансПоКоторымВозможенЗачет(Отбор, ДобавитьКолонкиАналитики);
	
	ТаблицаДокументов = НовыйТаблицаДокументовСчетаФактурыНаАванс(ДобавитьКолонкиАналитики);
	
	Если СчетаФактурыНаАванс.Количество() = 0 Тогда
		Возврат ТаблицаДокументов;
	КонецЕсли;
	
	МассивДокументов = СчетаФактурыНаАванс.ВыгрузитьКолонку("СчетФактура");
	
	ПричиныНалогообложения = Новый Массив();
	ПричиныНалогообложения.Добавить(Перечисления.ПричиныНалогообложенияНДС.АвансПолученный);
	
	ПоследниеИсправительныеСФ = НайтиПоследниеИсправительныеСчетаФактуры(МассивДокументов, ПричиныНалогообложения);
	
	Для Каждого СтрокаСФНаАванс Из СчетаФактурыНаАванс Цикл
		ДокументСсылка = СтрокаСФНаАванс.СчетФактура;
		
		НоваяСтрока = ТаблицаДокументов.Добавить();
		
		ПоследнийИсправительныйСФ = ПоследниеИсправительныеСФ.Найти(ДокументСсылка, "ИсправляемыйДокумент");
		
		Если ПоследнийИсправительныйСФ <> Неопределено Тогда
			НоваяСтрока.СчетФактура = ПоследнийИсправительныйСФ.Ссылка;
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ПоследнийИсправительныйСФ, "НомерИсправления,ДатаИсправления");
			
			ИсправляемыйДокумент = ПоследнийИсправительныйСФ.ИсправляемыйДокумент;
			
			ДатыДокументов = Новый Структура();
			
			СтруктураНомера = УчетНДС.ОпределитьПоСсылкеНомерСФДляВыводаВРегистрыУчета(ИсправляемыйДокумент, ДатыДокументов);
			
			НоваяСтрока.Дата = ДатыДокументов.Дата;
			НоваяСтрока.Номер = СтруктураНомера.Номер;
			
			Если ДобавитьКолонкиАналитики Тогда
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСФНаАванс, ИменаКолонокАналитикиСтрокой);
			КонецЕсли;
			
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока.СчетФактура = ДокументСсылка;
		
		ДатыДокументов = Новый Структура();
		
		СтруктураНомера = УчетНДС.ОпределитьПоСсылкеНомерСФДляВыводаВРегистрыУчета(ДокументСсылка, ДатыДокументов);
		
		НоваяСтрока.Дата = ДатыДокументов.Дата;
		НоваяСтрока.Номер = СтруктураНомера.Номер;
		
		Если ДобавитьКолонкиАналитики Тогда
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСФНаАванс, ИменаКолонокАналитикиСтрокой);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТаблицаДокументов;
	
КонецФункции

// Отбор для передачи в функцию ПрочитатьОстаткиВходящийНДСАвансыПолученные().
//
// Возвращаемое значение:
//	Структура - структура отбора.
Функция НовыйОтборОстаткиВходящийНДСАвансыПолученные() Экспорт
	
	Отбор = Новый Структура();
	Отбор.Вставить("НаДату", '00010101');
	Отбор.Вставить("Организация", Справочники.Организации.ПустаяСсылка());
	Отбор.Вставить("СписокКонтрагентов", Новый Массив());
	Отбор.Вставить("СписокДоговоров", Новый Массив());
	Отбор.Вставить("СписокКФО", Новый Массив());
	Отбор.Вставить("СписокДокументовЗачетаАванса", Новый Массив());
	Отбор.Вставить("СписокСчетовРасчетов", Новый Массив());
	Отбор.Вставить("СписокКПССчетРасчетов", Новый Массив());
	Отбор.Вставить("СписокСчетовФактурНаАванс", Новый Массив());
	
	Возврат Отбор;
	
КонецФункции

// Удаляет пустые значения из списков отбора полного счета (КФО, КПС, Счет).
//
// Параметры:
//	Отбор - Структура - отбор для поиска остатков авансов полученных.
//		См. НовыйОтборОстаткиВходящийНДСАвансыПолученные()
Процедура УдалитьПустыеЗначенияИзОтбораОстатковВходящийНДСАвансыПолученные(Отбор) Экспорт
	
	ИменаСвойств = СтрРазделить("СписокКФО,СписокСчетовРасчетов,СписокКПССчетРасчетов", ", ", Ложь);
	
	Для Каждого ИмяСвойства Из ИменаСвойств Цикл
		СписокЗначений = Отбор[ИмяСвойства];
		
		КоличествоЗначений = СписокЗначений.Количество();
		
		Для Счетчик = 1 По КоличествоЗначений Цикл
			Индекс = КоличествоЗначений - Счетчик;
			
			Если Не ЗначениеЗаполнено(СписокЗначений[Индекс]) Тогда
				СписокЗначений.Удалить(Индекс);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

// Данные, сохраняемые в хранилище для передачи в общую форму ДокументыСчетовФактурНаАванс.
//
// Параметры:
//	СчетаФактурыНаАванс - ТаблицаЗначений - содержимое одноименной табличной части документа.
//		Выводится на экран при открытии общей формы.
//	Отбор - Структура - отбор для поиска счетов-фактур на аванс. Используется для автоматического поиска
//		счетов-фактур по команде общей формы. См. функцию НовыйОтборОстаткиВходящийНДСАвансыПолученные()
//
// Возвращаемое значение:
//	Структура - данные для передачи в общую форму.
Функция НовыйДанныеДляОбщейФормыДокументыСчетовФактурНаАванс() Экспорт
	
	Данные = Новый Структура();
	Данные.Вставить("СчетаФактурыНаАванс");
	Данные.Вставить("Отбор");
	
	Возврат Данные;
	
КонецФункции

// Формирует текст надписи "Счета-фактуры на аванс" для формы документа счета-фактуры (строка 5б).
//
// Параметры:
//	ТаблицаСчетаФактурыНаАванс - ТаблицаЗначений - таблица документов счетов-фактур на аванс.
//	МаксимальнаяДлина - Число - максимальная длина возвращаемой строки. При превышении длины строки она обрезается справа.
//
// Возвращаемое значение:
//	Строка - текст для вывода на форму документа.
Функция ПолучитьНадписьСчетаФактурыНаАванс(ТаблицаСчетаФактурыНаАванс, МаксимальнаяДлина = 150) Экспорт
	
	Если ТаблицаСчетаФактурыНаАванс.Количество() = 0 Тогда
		Возврат НСтр("ru='<не заполнено>'");
	Иначе
		Строка5б = ПолучитьПредставлениеСтроки5б(ТаблицаСчетаФактурыНаАванс);
		
		Если СтрДлина(Строка5б) > МаксимальнаяДлина Тогда
			Многоточие = "...";
			
			Строка5б = Лев(Строка5б, МаксимальнаяДлина - СтрДлина(Многоточие)) + Многоточие;
		КонецЕсли;
		
		Возврат Строка5б;
	КонецЕсли;
	
КонецФункции

// Формирует текст для строки 5б печатной формы счета-фактуры и визуализации ЭД.
//
// Параметры:
//	ТаблицаСчетаФактурыНаАванс - ТаблицаЗначений - таблица счетов-фактур на аванс.
//
// Возвращаемое значение:
//	Строка - текст для вывода в печатную форму и визуализацию ЭД.
Функция ПолучитьПредставлениеСтроки5б(ТаблицаСчетаФактурыНаАванс) Экспорт
	
	СимволПрочерка = "--";
	
	Шаблон = НСтр("ru='№%1 от %2 г., исправление №%3 от %4 г.'");
	
	МассивСтрок = Новый Массив();
	
	Для Каждого СтрокаТаблицы Из ТаблицаСчетаФактурыНаАванс Цикл
		Номер = ?(ЗначениеЗаполнено(СтрокаТаблицы.Номер), СтрокаТаблицы.Номер, СимволПрочерка);
		Дата = ?(ЗначениеЗаполнено(СтрокаТаблицы.Дата), Формат(СтрокаТаблицы.Дата, "ДФ=dd.MM.yyyy"), СимволПрочерка);
		
		НомерИсправления = ?(ЗначениеЗаполнено(СтрокаТаблицы.НомерИсправления),
			СтрокаТаблицы.НомерИсправления,
			СимволПрочерка);
			
		ДатаИсправления = ?(ЗначениеЗаполнено(СтрокаТаблицы.ДатаИсправления),
			Формат(СтрокаТаблицы.ДатаИсправления, "ДФ=dd.MM.yyyy"),
			СимволПрочерка);
			
		МассивСтрок.Добавить(СтрШаблон(Шаблон, Номер, Дата, НомерИсправления, ДатаИсправления));
	КонецЦикла;
	
	Если МассивСтрок.Количество() = 0 Тогда
		МассивСтрок.Добавить(СтрШаблон(Шаблон, СимволПрочерка, СимволПрочерка, СимволПрочерка, СимволПрочерка));
	КонецЕсли;
	
	Возврат СтрСоединить(МассивСтрок, ";");
	
КонецФункции

// Формирует текст для графы 11а книги продаж. В графу 11а выводится строка 5б сч.-ф.
//
// Параметры:
//	ТаблицаСчетаФактурыНаАванс - ТаблицаЗначений - таблица счетов-фактур на аванс.
//
// Возвращаемое значение:
//	Строка - текст для вывода в печатную форму и визуализацию ЭД.
Функция ПолучитьПредставлениеГрафы11аКнигиПродаж(ТаблицаСчетаФактурыНаАванс) Экспорт
	
	// В графу 11а книги продаж не выводим номер и дату исправления.
	// А в строке 5б сч.-ф. указывается номер и дата исправления.
	
	Если ТаблицаСчетаФактурыНаАванс.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	СимволПрочерка = "--";
	
	ШаблонБезИсправления = НСтр("ru='№%1 от %2 г.'");
	
	МассивСтрок = Новый Массив();
	
	Для Каждого СтрокаТаблицы Из ТаблицаСчетаФактурыНаАванс Цикл
		Номер = ?(ЗначениеЗаполнено(СтрокаТаблицы.Номер), СтрокаТаблицы.Номер, СимволПрочерка);
		Дата = ?(ЗначениеЗаполнено(СтрокаТаблицы.Дата), Формат(СтрокаТаблицы.Дата, "ДФ=dd.MM.yyyy"), СимволПрочерка);
		
		МассивСтрок.Добавить(СтрШаблон(ШаблонБезИсправления, Номер, Дата));
	КонецЦикла;
	
	Возврат СтрСоединить(МассивСтрок, ";");
	
КонецФункции

#КонецОбласти

#Область ДокументыСчетовФактурНаОтгрузкуГрафа7аКнигиПокупок

// Пустая таблица документов, заполняемая далее в функции ПолучитьТаблицуДокументовСчетовФактурНаОтгрузку().
Функция НовыйТаблицаДокументовСчетаФактурыНаОтгрузку() Экспорт
	
	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("ИдентификаторСтроки",	ОбщегоНазначения.ОписаниеТипаСтрока(36));
	Таблица.Колонки.Добавить("СчетФактура",			Новый ОписаниеТипов("ДокументСсылка.СчетФактураВыданный"));
	Таблица.Колонки.Добавить("Дата",				ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	Таблица.Колонки.Добавить("Номер",				Метаданные.ОпределяемыеТипы.НомерПервичногоДокумента.Тип);
	
	Возврат Таблица;
	
КонецФункции

// Данные, сохраняемые в хранилище для передачи в общую форму ДокументыСчетовФактурНаОтгрузку.
Функция НовыйДанныеДляОбщейФормыДокументыСчетовФактурНаОтгрузку() Экспорт
	
	Данные = Новый Структура();
