		|	СчетФактура.Дата		 											            КАК Период,
		|	Значение(Перечисление.ЧастиЖурналаУчетаСчетовФактур.ВыставленныеСчетаФактуры) 	КАК ЧастьЖурнала,
		|	СчетФактура.ДатаВыставления														КАК ДатаВыставленияПолучения,
		|   ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(СчетФактура.ИсправляемыйДокумент) = ТИП(Документ.СчетФактураВыданный) ТОГДА
		|			СчетФактура.ИсправляемыйДокумент.Номер
		|		КОГДА ТИПЗНАЧЕНИЯ(СчетФактура.ИсправляемыйДокумент) = ТИП(Документ.КорректировочныйСчетФактураВыданный) ТОГДА
		|			СчетФактура.ИсправляемыйДокумент.НомерПервичногоДокумента
		|		ИНАЧЕ NULL	
		|	КОНЕЦ                                                                              КАК НомерСчетаФактуры,
		|   ВЫБОР
		|		КОГДА ТИПЗНАЧЕНИЯ(СчетФактура.ИсправляемыйДокумент) = ТИП(Документ.СчетФактураВыданный) ТОГДА
		|			СчетФактура.ИсправляемыйДокумент.Дата
		|		КОГДА ТИПЗНАЧЕНИЯ(СчетФактура.ИсправляемыйДокумент) = ТИП(Документ.КорректировочныйСчетФактураВыданный) ТОГДА
		|			СчетФактура.ИсправляемыйДокумент.ДатаПервичногоДокумента
		|		ИНАЧЕ NULL	
		|	КОНЕЦ                                                                              КАК ДатаСчетаФактуры,
		|	СчетФактура.НомерИсправления													 КАК НомерИсправления,
		|	СчетФактура.ДатаИсправления														 КАК ДатаИсправления,
		|	ВЫБОР
		|		КОГДА ВложенныйЗапрос.СуммаНДСУвеличение + ВложенныйЗапрос.СуммаНДСУменьшение + 
		|			ВложенныйЗапрос.ВсегоУменьшение + ВложенныйЗапрос.СуммаПоСчетуФактуреРазницаУвеличение  = 0 ТОГДА
		|			ВложенныйЗапрос.СуммаПоСчетуФактуре
		|		ИНАЧЕ 0	
		|	КОНЕЦ 																			   КАК СуммаПоСчетуФактуре,
		|	ВЫБОР
		|		КОГДА ВложенныйЗапрос.СуммаНДСУвеличение + ВложенныйЗапрос.СуммаНДСУменьшение + 
		|			ВложенныйЗапрос.ВсегоУменьшение + ВложенныйЗапрос.СуммаПоСчетуФактуреРазницаУвеличение  = 0 ТОГДА
		|			ВложенныйЗапрос.СуммаНДС
		|		ИНАЧЕ 0	
		|	КОНЕЦ 																				КАК СуммаНДС,
		|	ВложенныйЗапрос.ВсегоУменьшение								КАК	СуммаПоСчетуФактуреРазницаУменьшение,
		|	ВложенныйЗапрос.СуммаПоСчетуФактуреРазницаУвеличение								КАК	СуммаПоСчетуФактуреРазницаУвеличение,
		|	ВложенныйЗапрос.СуммаНДСУменьшение		               	                        КАК СуммаНДСРазницаУменьшение,
		|	ВложенныйЗапрос.СуммаНДСУвеличение          		         	                    КАК СуммаНДСРазницаУвеличение
		|ИЗ
		|	Документ.ИсправительныйСчетФактураВыданный КАК СчетФактура
		|		ПОЛНОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ИсправительныйСчетФактураВыданныйСоставНФА.Ссылка КАК Ссылка,
		|			СУММА(ИсправительныйСчетФактураВыданныйСоставНФА.СуммаНДСУменьшение) 	КАК СуммаНДСУменьшение,
		|			СУММА(ИсправительныйСчетФактураВыданныйСоставНФА.СуммаНДСУвеличение) 		КАК СуммаНДСУвеличение,
		|			СУММА(ИсправительныйСчетФактураВыданныйСоставНФА.ВсегоУменьшение)	КАК ВсегоУменьшение,
		|			СУММА(ИсправительныйСчетФактураВыданныйСоставНФА.ВсегоУвеличение) 		КАК СуммаПоСчетуФактуреРазницаУвеличение,
		|			СУММА(ИсправительныйСчетФактураВыданныйСоставНФА.Всего)						КАК СуммаПоСчетуФактуре,
		|			СУММА(ИсправительныйСчетФактураВыданныйСоставНФА.СуммаНДС) 					КАК СуммаНДС
		|		ИЗ
		|			Документ.ИсправительныйСчетФактураВыданный.СоставНФА КАК ИсправительныйСчетФактураВыданныйСоставНФА
		|		ГДЕ ИсправительныйСчетФактураВыданныйСоставНФА.Ссылка = &Ссылка
		|		СГРУППИРОВАТЬ ПО
		|			ИсправительныйСчетФактураВыданныйСоставНФА.Ссылка) КАК ВложенныйЗапрос
		|		ПО СчетФактура.Ссылка = ВложенныйЗапрос.Ссылка
		|";
		
	КонецЕсли;				   
	ТекстЗапроса = ТекстЗапроса + "
		|ГДЕ
		|	СчетФактура.Ссылка = &Ссылка";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	Запрос.УстановитьПараметр("ДатаРегистрацииВЖурнале", 
		УчетНДСВызовСервера.ДатаФормированияДвиженияВРегистреНДС(ДокументСсылка));
	
	Запись = Запрос.Выполнить().Выгрузить();
	Если Запись.Количество() = 0 тогда
		Возврат;
	КонецЕсли;	
	Если Не СводныйСФ Тогда
		Движение = Движения.ЖурналУчетаСчетовФактур.Добавить();
		ЗаполнитьЗначенияСвойств(Движение, Запись[0]);
	Иначе
		Для каждого НоваяСтрока Из Запись Цикл
			Движение = Движения.ЖурналУчетаСчетовФактур.Добавить();
			ЗаполнитьЗначенияСвойств(Движение, НоваяСтрока);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры	

// Ожидаемые колонки: НомерСтроки, НФА, ДокументОснование, СуммаНДС, Всего, НДСКВычету
Процедура ЗаполнитьСчетРасчетов(Таблица) Экспорт
	
	// Замечания по заполнению счета расчетов
	// --------------------------------------
	// 1. Существует 2 источника данных для заполнение счета расчетов:
	//		- Проводки документа-основания по регистру бухгалтерии (счет расчетов указывается по кредиту)
	//		- Табличная часть документа-основания (счет расчетов указывается явно, либо посредством КЭК)
	// 2. Выбор источника данных для заполнения счета расчетов
	//	  однозначно определяется типом документа-основания;
	//
	// Вообще не требуется заполнение счета расчетов
	// (т.к. счет расчетов уже содержится в реквизите счета-фактуры),
	// если документ-основание:
	//	- РасходныйКассовыйОрдер
	//	- ПлатежноеПоручение
	//	- КассовоеВыбытие
	//	- ЗаявкаНаКассовыйРасход
	//	- ЗаявкаНаКассовыйРасходСокращенная
	//
	// Требуется заполнение из проводок документов-оснований (алгоритм 1):
	//	- ПоступлениеМЗ
	//	- ПоступлениеМЗВПути
	//	- ПоступлениеОС
	//	- АвансовыйОтчет
	//
	// Требуется заполнение из проводок документов-оснований (алгоритм 2):
	//	- НачислениеАмортизацииПравПользованияОС
	//
	// Требуется заполнение из табличной части документов-оснований:
	//	- ПоступлениеУслугРабот
	//
	// Способ заполнения
	// -----------------
	// 1. Расширить табличную часть счета-фактуры дополнительными колонками,
	//	  в том числе, колонкой счета расчетов;
	// 2. Для каждой строки дозаполнить счет расчетов, исходя из указанного в ней документа-основания:
	//		- либо не заполнять вообще
	//		- либо заполнить из проводок основания
	//		- либо заполнить из табличной части основания
	
	Если Таблица.Колонки.Найти("СчетРасчетов") = Неопределено Тогда
		Таблица.Колонки.Добавить("СчетРасчетов", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	КонецЕсли;
	
	Если Таблица.Колонки.Найти("КПССчетРасчетов") = Неопределено Тогда
		Таблица.Колонки.Добавить("КПССчетРасчетов", Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	КонецЕсли;
	
	СпособыОпределенияСчетаРасчетов = ПолучитьСпособыОпределенияСчетаРасчетов(Таблица);
	
	Для Каждого СпособОпределения Из СпособыОпределенияСчетаРасчетов Цикл
		
		Ид = СпособОпределения["Ид"];
		
		Если Ид = "Из проводок, алгоритм 1" Тогда
			
			ТаблицаСчетовРасчетов = ПолучитьСчетаРасчетовИзПроводокДокументовОснований_Алгоритм1(Таблица, СпособОпределения);
			
		ИначеЕсли Ид = "Из проводок, алгоритм 2" Тогда
			
			ТаблицаСчетовРасчетов = ПолучитьСчетаРасчетовИзПроводокДокументовОснований_Алгоритм2(Таблица, СпособОпределения);
			
		ИначеЕсли Ид = "Из табличной части ПоступлениеУслугРабот" Тогда
			
			ТаблицаСчетовРасчетов = ПолучитьСчетаРасчетовИзТабличнойЧасти_ПоступлениеУслугРабот(Таблица, СпособОпределения);
			
		Иначе
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьСчетРасчетовВУказанныхСтроках(Таблица, ТаблицаСчетовРасчетов);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьКЭК189иКПС(Таблица, ПараметрыЗаполнения) Экспорт
	
	// Заполняем КЭК и КПС 189 только в случае:
	//  - Применяется 209н (с 2019 г.)
	//  - Есть соответствующая настройка учетной политики
	//  - Для тех строк таблицы, где указан счет 401.10
	
	Дата		= ПараметрыЗаполнения["Дата"];
	Организация	= ПараметрыЗаполнения["Организация"];
	
	Если НЕ БухгалтерскийУчет.ПрименяетсяПриказ209н(Дата, Организация) Тогда
		Возврат;
	КонецЕсли;
	
	УчетнаяПолитикаОрганизации = БухгалтерскийУчетПовтИсп.УчетнаяПолитикаОрганизации(Организация, Дата);
	
	Если НЕ УчетнаяПолитикаОрганизации["НДСНачислятьПоКОСГУ189ПоВнебюджету"] Тогда
		Возврат;
	КонецЕсли;
	
	ВсеСчета40100 = БухгалтерскийУчет.СписокСчетов("401.00", Дата,, Организация);
	
	ИсключаемыеСчета40120 = БухгалтерскийУчет.СписокСчетов("401.20", Дата,, Организация);
	
	КЭК189 = БухгалтерскиеОперации.КЭКПоКоду("189");
	
	КПС = УчетнаяПолитикаОрганизации["НДСКБКдляКОСГУ189"];
	
	УстановитьКПС = ЗначениеЗаполнено(КПС);
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		
		Счет = СтрокаТаблицы[ПараметрыЗаполнения["ИмяКолонкиСчет"]];
		
		Если ВсеСчета40100.Найти(Счет) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ИсключаемыеСчета40120.Найти(Счет) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТаблицы[ПараметрыЗаполнения["ИмяКолонкиКЭК"]] = КЭК189;
		
		Если УстановитьКПС Тогда
			СтрокаТаблицы[ПараметрыЗаполнения["ИмяКолонкиКПС"]] = КПС;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Заменяет имена колонок
//
// Параметры:
//	Таблица			- ТаблицаЗначений	- в этой таблице необходимо переименовать колонки;
//	Переименование	- Структура			- коллекция пар строк, что на что менять:
//						Ключ - имя колонки ДО переименования
//						Значение - имя ПОСЛЕ переименования;
//	Направление		- Строка			- направление замены имен.
//						Значение "вперед" (из ДО в ПОСЛЕ) или "назад" (из ПОСЛЕ в ДО).
Процедура ПереименоватьКолонки(Таблица, Переименование, Направление) Экспорт
	
	// Направление обхода колонок определяется направлением замены имен.
	// Если направление "вперед", то обходим в прямом порядке.
	// Если направление "назад", то обходим в обратном порядке.
	// Это позволяет переименовать колонку, если колонка с таким именем уже существует.
	// В этом случае сначала указывается переименование такой существующей колонки во временную,
	// а затем указывается желаемое переименование.
	// При этом обратное переименование колонок выполнится корректно, т.к. порядок обхода имен будет обратным.
	
	ПереименоватьВперед = (НРег(Направление) = "вперед");
	
	ПереименоватьНазад = (НРег(Направление) = "назад");
	
	ИменаДо = Новый Массив();
	
	Для Каждого Элемент Из Переименование Цикл
		
		ИмяДо = Элемент.Ключ;
		
		Если ПереименоватьВперед Тогда
			
			ИменаДо.Добавить(ИмяДо);
			
		ИначеЕсли ПереименоватьНазад Тогда
			
			ИменаДо.Вставить(0, ИмяДо);
			
		Иначе
			
			Продолжить;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого ИмяДо Из ИменаДо Цикл
		
		ИмяПосле = Переименование[ИмяДо];
		
		Если ПереименоватьВперед Тогда
			
			ТекущееИмя = ИмяДо;
			
			НовоеИмя = ИмяПосле;
			
		ИначеЕсли ПереименоватьНазад Тогда
			
			ТекущееИмя = ИмяПосле;
			
			НовоеИмя = ИмяДо;
			
		Иначе
			
			Продолжить;
			
		КонецЕсли;
		
		Колонка = Таблица.Колонки.Найти(ТекущееИмя);
		
		Колонка.Имя = НовоеИмя;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСуммыУвеличенияУменьшения(ТабличнаяЧасть, ИменаПолей) Экспорт
	
	Для Каждого СтрокаТаблицы Из ТабличнаяЧасть Цикл
		
		Для Каждого ИмяПоля Из ИменаПолей Цикл
			
			Разница = СтрокаТаблицы[ИмяПоля + "ДоКорректировки"] - СтрокаТаблицы[ИмяПоля];
			
			Если Разница >= 0 Тогда
				
				Увеличение = 0;
				
				Уменьшение = Разница;
				
			Иначе	
				
				Увеличение = -Разница;
				
				Уменьшение = 0;
				
			КонецЕсли;
			
			СтрокаТаблицы[ИмяПоля + "Увеличение"] = Увеличение;
			
			СтрокаТаблицы[ИмяПоля + "Уменьшение"] = Уменьшение;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры	

Процедура ЗаполнитьКолонкиДопЛиста(ЗаполняемаяТаблица, МассивСчетовФактур) Экспорт
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивСчетовФактур", МассивСчетовФактур);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Счета-фактуры, для которых следует дозаполнить колонки доп.листа
	|//
	|ВЫБРАТЬ
	|	Ссылка					КАК СчетФактура,
	|	РегистрацияВДопЛисте	КАК ЗаписьДопЛиста,
	|	КорректируемыйПериод	КАК КорректируемыйПериод
	|ИЗ
	|	Документ.СчетФактураВыданный
	|ГДЕ
	|	Ссылка В(&МассивСчетовФактур)
	|	И	(РегистрацияВДопЛисте ИЛИ КорректируемыйПериод > ДАТАВРЕМЯ(1,1,1))
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Ссылка					КАК СчетФактура,
	|	РегистрацияВДопЛисте	КАК ЗаписьДопЛиста,
	|	КорректируемыйПериод	КАК КорректируемыйПериод
	|ИЗ
	|	Документ.СчетФактураПолученный
	|ГДЕ
	|	Ссылка В(&МассивСчетовФактур)
	|	И	(РегистрацияВДопЛисте ИЛИ КорректируемыйПериод > ДАТАВРЕМЯ(1,1,1))
	|;";
	
	Выборка = ЗапросПоиск.Выполнить().Выбрать();
	
	Поиск = Новый Структура("СчетФактура");
	
	Пока Выборка.Следующий() Цикл
		
		ЗаполнитьЗначенияСвойств(Поиск, Выборка);
		
		МассивСтрок = ЗаполняемаяТаблица.НайтиСтроки(Поиск);
		
		Для Каждого СтрокаТаблицы ИЗ МассивСтрок Цикл
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Выборка);
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

// Данная процедура нужна т.к. операции к документам пишут разные люди и в разные дни недели.
// В силу этого имена реквизитов типовой операции могут отличаться от подразумеваемых (используемых далее).
Процедура ЗаполнитьЗначенияСвойствТиповойОперации(ЗаполняемаяТиповаяОперация, ТиповаяОперацияПользователя, СинонимыРеквизитов = Неопределено) Экспорт
	
	Перем	ЗначениеРеквизита,
			Курс,
			Кратность,
			ИспользуемыеСинонимыРеквизитов,
			Синонимы;
	
	// Входная проверка:
	Если НЕ ТипЗнч(ЗаполняемаяТиповаяОперация) = Тип("Структура") ИЛИ
		 НЕ ТипЗнч(ТиповаяОперацияПользователя) = Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	ИспользуемыеСинонимыРеквизитов = Новый Структура();
	Если СинонимыРеквизитов = Неопределено Тогда
		ИспользуемыеСинонимыРеквизитов.Вставить("КЭК40100",	СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(
			"КЭК,КЭК401,КЭК_401,КЭК40110,КЭК_40110,КЭК_401_10,КЭК40120,КЭК_40120,КЭК_401_20," +
			"КОСГУ,КОСГУ401,КОСГУ_401,КОСГУ40110,КОСГУ_40110,КОСГУ_401_10,КОСГУ40120,КОСГУ_40120,КОСГУ_401_20"));
	ИначеЕсли ТипЗнч(СинонимыРеквизитов) = Тип("Структура") Тогда
		Для Каждого Синоним Из СинонимыРеквизитов Цикл
			ИмяРеквизита	= Синоним.Ключ;
			ИменаСинонимов	= Синоним.Значение;
			Если ТипЗнч(ИменаСинонимов) = Тип("Массив") Тогда
				ИспользуемыеСинонимыРеквизитов.Вставить(ИмяРеквизита, ИменаСинонимов);
			ИначеЕсли ТипЗнч(ИменаСинонимов) = Тип("Строка") Тогда
				ИспользуемыеСинонимыРеквизитов.Вставить(ИмяРеквизита, СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ИменаСинонимов));
			КонецЕсли;
		КонецЦикла;
	Иначе
		Возврат;
	КонецЕсли;
	
	// Заполняем совпадающие по именам реквизиты:
	ЗаполнитьЗначенияСвойств(ЗаполняемаяТиповаяОперация, ТиповаяОперацияПользователя);
	
	// Гарантируем наличие заполненных свойств Курс и Кратность:
	ИнициализироватьКурс		= Ложь;
	ИнициализироватьКратность	= Ложь;
	Если ЗаполняемаяТиповаяОперация.Свойство("Курс", Курс) Тогда
		Если НЕ ЗначениеЗаполнено(Курс) Тогда
			ИнициализироватьКурс = Истина;
		КонецЕсли;
	Иначе
		ИнициализироватьКурс = Истина;
	КонецЕсли;
	Если ЗаполняемаяТиповаяОперация.Свойство("Кратность", Кратность) Тогда
		Если НЕ ЗначениеЗаполнено(Кратность) Тогда
			ИнициализироватьКратность = Истина;
		КонецЕсли;
	Иначе
		ИнициализироватьКратность = Истина;
	КонецЕсли;
	Если ИнициализироватьКурс Тогда
		ЗаполняемаяТиповаяОперация.Вставить("Курс", 1);
	КонецЕсли;
	Если ИнициализироватьКратность Тогда
		ЗаполняемаяТиповаяОперация.Вставить("Кратность", 1);
	КонецЕсли;
	
	Для Каждого ЗаполняемыйРеквизит Из ЗаполняемаяТиповаяОперация Цикл
		ИмяЗаполняемогоРеквизита = ЗаполняемыйРеквизит.Ключ;
		Если ИспользуемыеСинонимыРеквизитов.Свойство(ИмяЗаполняемогоРеквизита, Синонимы) Тогда
			Если НЕ ТипЗнч(Синонимы) = Тип("Массив") Тогда
				Продолжить;
			КонецЕсли;
			// Есть синонимы у реквизита.
			Для Каждого Синоним Из Синонимы Цикл
				Если ТиповаяОперацияПользователя.Свойство(Синоним, ЗначениеРеквизита) Тогда
					ЗаполняемаяТиповаяОперация[ИмяЗаполняемогоРеквизита] = ЗначениеРеквизита;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Заполняет список выбора указанного элемента "Причина налогообложения".
// Если ТекущееЗначение не является допустимым, то заполняется ВозвратНекорректноеЗначение.
Процедура ЗаполнитьСписокВыбораЭлементаПричинаНалогообложения(Элемент, ЭтоСчетФактураВыданный, ТекущееЗначение=Неопределено, ВозвратНекорректноеЗначение=Неопределено) Экспорт
	
	ПрефиксПредставленияНекорректногоЗначения = "(*) ";
	
	// Входная проверка:
	Если НЕ ЭтоСчетФактураВыданный = Истина Тогда
		ЭтоСчетФактураВыданный = Ложь;
	КонецЕсли;
	
	// Настраиваем список выбора:
	Если ЭтоСчетФактураВыданный Тогда
		КорректныеЗначения = УчетНДСПовтИсп.ПолучитьПричиныНалогообложенияДляСчетаФактурыВыданного();
	Иначе
		КорректныеЗначения = УчетНДСПовтИсп.ПолучитьПричиныНалогообложенияДляСчетаФактурыПолученного();
	КонецЕсли;
	СписокВыбора = Элемент.СписокВыбора;
	СписокВыбора.ЗагрузитьЗначения(КорректныеЗначения);
	УдалитьЗначечнияНедоступныеПоФункциональнымОпциям(СписокВыбора);
	ВозвратНекорректноеЗначение = Неопределено;
	Если ЗначениеЗаполнено(ТекущееЗначение) Тогда
		Если КорректныеЗначения.Найти(ТекущееЗначение) = Неопределено Тогда
			ВозвратНекорректноеЗначение = ТекущееЗначение;
			СписокВыбора.Добавить(ВозвратНекорректноеЗначение, ПрефиксПредставленияНекорректногоЗначения + Строка(ВозвратНекорректноеЗначение));
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьТаблицуПроводок(ДокументРегистратор, Счет = Неопределено, СторонаПроводки = Неопределено) Экспорт
	
	Если Счет = Неопределено Тогда
		УсловиеСчетаСтрока = "ИСТИНА";
		ВыборВалютыСтрока = "
		|	ЕСТЬNULL(ВалютаДт, ЕСТЬNULL(ВалютаКт, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)))	КАК Валюта,
		|	ЕСТЬNULL(ВалютнаяСуммаДт, ЕСТЬNULL(ВалютнаяСуммаКт, 0))								КАК ВалютнаяСумма";
	Иначе
		Если СторонаПроводки = Неопределено Тогда
			СторонаПроводки = "";
			ВыборВалютыСтрока = "
			|	ЕСТЬNULL(ВалютаДт, ЕСТЬNULL(ВалютаКт, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)))	КАК Валюта,
			|	ЕСТЬNULL(ВалютнаяСуммаДт, ЕСТЬNULL(ВалютнаяСуммаКт, 0))								КАК ВалютнаяСумма";
		Иначе
			ДругаяСторонаПроводки = ?(ВРег(СторонаПроводки) = "ДТ",
				"Кт",
				"Дт");
			ВыборВалютыСтрока = "
			|	ЕСТЬNULL(Валюта" + СторонаПроводки + ", ЕСТЬNULL(Валюта" + ДругаяСторонаПроводки + ", ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)))	КАК Валюта,
			|	ЕСТЬNULL(ВалютнаяСумма" + СторонаПроводки + ", ЕСТЬNULL(ВалютнаяСумма" + ДругаяСторонаПроводки + ", 0))								КАК ВалютнаяСумма";
		КонецЕсли;
		УсловиеСчетаСтрока = "Счет" + СторонаПроводки + " В ИЕРАРХИИ(&Счет)";
	КонецЕсли;
	
	ЗапросПроводки = Новый Запрос();
	ЗапросПроводки.УстановитьПараметр("Регистратор",	ДокументРегистратор);
	ЗапросПроводки.УстановитьПараметр("Счет",			Счет);
	ЗапросПроводки.Текст = "
	|ВЫБРАТЬ
	|	*," + ВыборВалютыСтрока + ",
	|	СчетДт.КОСГУДт	КАК СчетДтКОСГУДт,
	|	СчетДт.КОСГУКт	КАК СчетДтКОСГУКт,
	|	СчетКт.КОСГУДт	КАК СчетКтКОСГУДт,
	|	СчетКт.КОСГУКт	КАК СчетКтКОСГУКт,
	|	ВЫБОР
	|		КОГДА СчетДт.КОСГУДт ЕСТЬ NULL ИЛИ СчетДт.КОСГУКт ЕСТЬ NULL ТОГДА
	|			ЛОЖЬ
	|		КОГДА СчетДт.КОСГУДт = ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка) И СчетДт.КОСГУКт = ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка) ТОГДА
	|			ЛОЖЬ
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ	КАК СчетДтКОСГУОборотный,
	|	ВЫБОР
	|		КОГДА СчетКт.КОСГУДт ЕСТЬ NULL ИЛИ СчетКт.КОСГУКт ЕСТЬ NULL ТОГДА
	|			ЛОЖЬ
	|		КОГДА СчетКт.КОСГУДт = ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка) И СчетКт.КОСГУКт = ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка) ТОГДА
	|			ЛОЖЬ
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ	КАК СчетКтКОСГУОборотный
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|		,
	|		,
	|		" + УсловиеСчетаСтрока + "
	|		И	Регистратор = &Регистратор
	|	)	КАК ДвиженияДокументаОснования
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки
	|;";
	
	Возврат ЗапросПроводки.Выполнить().Выгрузить();
	
КонецФункции

Процедура СкопироватьКолонкиТаблицы(ТаблицаПриемник, ТаблицаИсточник, СоответствиеИменКолонок, СоздатьОтсутствующиеКолонки = Истина, ТолькоПустойПриемник = Ложь) Экспорт
	
	Для Каждого СоответствиеИменКолонки Из СоответствиеИменКолонок Цикл
		ИмяКолонкиПриемник = СоответствиеИменКолонки.Ключ;
		ИмяКолонкиИсточник = СоответствиеИменКолонки.Значение;
		Если НЕ ЗначениеЗаполнено(ИмяКолонкиИсточник) Тогда
			ИмяКолонкиИсточник = ИмяКолонкиПриемник;
		КонецЕсли;
		
		КолонкаПриемникСуществует = НЕ (ТаблицаПриемник.Колонки.Найти(ИмяКолонкиПриемник) = Неопределено);
		КолонкаИсточникСуществует = НЕ (ТаблицаИсточник.Колонки.Найти(ИмяКолонкиИсточник) = Неопределено);
		
		ДобавитьКолонку = НЕ КолонкаПриемникСуществует И СоздатьОтсутствующиеКолонки = Истина И КолонкаИсточникСуществует;
		Если ДобавитьКолонку Тогда
			КолонкаИсточник = ТаблицаИсточник.Колонки.Найти(ИмяКолонкиИсточник);
			
			ТаблицаПриемник.Колонки.Добавить(ИмяКолонкиПриемник, КолонкаИсточник.ТипЗначения);
			КолонкаПриемникСуществует = Истина;
		КонецЕсли;
		
		Если КолонкаПриемникСуществует Тогда
			МассивИсточник = ТаблицаИсточник.ВыгрузитьКолонку(ИмяКолонкиИсточник);
			
			Если ТолькоПустойПриемник = Истина Тогда
				// Устанавливаем только пустые значения в колонке приемника
				Для инд = 0 По ТаблицаПриемник.Количество() - 1 Цикл
					СтрокаТаблицы = ТаблицаПриемник[инд];
					Если НЕ ЗначениеЗаполнено(СтрокаТаблицы[ИмяКолонкиПриемник]) Тогда
						СтрокаТаблицы[ИмяКолонкиПриемник] = МассивИсточник[инд];
					КонецЕсли;
				КонецЦикла;
			Иначе
				// Загружаем колонку целиком,
				// независимо от заполненности значений в колонке приемника
				ТаблицаПриемник.ЗагрузитьКолонку(МассивИсточник, ИмяКолонкиПриемник);
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПосчитатьИтогиПоМассиву(ТекМассив, СуммаБезНДС, СуммаНДС) Экспорт
	СуммаБезНДС = 0; 
	СуммаНДС    = 0;
	Для каждого ТекЭлемент из ТекМассив Цикл
		СуммаБезНДС = СуммаБезНДС + ТекЭлемент.СуммаБезНДС; 
		СуммаНДС    = СуммаНДС + ТекЭлемент.СуммаНДС;
	КонецЦикла;	
КонецПроцедуры	

Процедура СвернутьОдноименныеКолонкиДерева(Дерево) Экспорт
	
	ИменаДублейКолонок = ОпределитьОдноименныеКолонкиДерева(Дерево);
	
	Если ИменаДублейКолонок["ОдноименныеКолонки"].Количество() > 0 Тогда
		ЗаполнитьКолонкиВСтрокахДерева(Дерево, ИменаДублейКолонок);
		
		КолонкиДерева = Дерево.Колонки;
		ОдноименныеКолонки = ИменаДублейКолонок["ОдноименныеКолонки"];
		Для Каждого КолонкиКУдалению Из ОдноименныеКолонки Цикл
			ИменаКолонок = КолонкиКУдалению.Значение;
			Для Каждого ИмяКолонки Из ИменаКолонок Цикл
				КолонкаКУдалению = Дерево.Колонки[ИмяКолонки];
				КолонкиДерева.Удалить(КолонкаКУдалению);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Функция ТрансформироватьТаблицуСКолонкамиНДС_ИзИндивидуальных_ВОбщие(Таблица) Экспорт
	
	ТипСтавкиНДС	= Новый ОписаниеТипов("ПеречислениеСсылка.СтавкиНДС");
	ТипЧисло		= Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2));
	СтавкаНДС0		= Перечисления.СтавкиНДС.НДС0;
	СтавкаБезНДС	= Перечисления.СтавкиНДС.БезНДС;
	
	// Новая возвращаемая таблица:
	ТабРезультат = Таблица.СкопироватьКолонки();
	
	// Удаляем неиспользуемые колонки:
	ИсключаемыеКолонки = Новый Массив();
	// Индивидуальные колонки НДС:
	ИсключаемыеКолонки.Добавить("Сумма22");
	ИсключаемыеКолонки.Добавить("СтавкаНДС22");
	ИсключаемыеКолонки.Добавить("СуммаНДС22");
	ИсключаемыеКолонки.Добавить("Сумма18");
	ИсключаемыеКолонки.Добавить("СтавкаНДС18");
	ИсключаемыеКолонки.Добавить("СуммаНДС18");
	ИсключаемыеКолонки.Добавить("Сумма10");
	ИсключаемыеКолонки.Добавить("СтавкаНДС10");
	ИсключаемыеКолонки.Добавить("СуммаНДС10");
	ИсключаемыеКолонки.Добавить("Сумма7");
	ИсключаемыеКолонки.Добавить("СтавкаНДС7");
	ИсключаемыеКолонки.Добавить("СуммаНДС7");
	ИсключаемыеКолонки.Добавить("Сумма5");
	ИсключаемыеКолонки.Добавить("СтавкаНДС5");
	ИсключаемыеКолонки.Добавить("СуммаНДС5");
	
	ИсключаемыеКолонки.Добавить("Сумма0");
	ИсключаемыеКолонки.Добавить("СуммаБН");
	
	ИсключаемыеКолонки.Добавить("Сумма22Валютная");
	ИсключаемыеКолонки.Добавить("СуммаНДС22Валютная");
	ИсключаемыеКолонки.Добавить("Сумма18Валютная");
	ИсключаемыеКолонки.Добавить("СуммаНДС18Валютная");
	ИсключаемыеКолонки.Добавить("Сумма10Валютная");
	ИсключаемыеКолонки.Добавить("СуммаНДС10Валютная");
	ИсключаемыеКолонки.Добавить("Сумма7Валютная");
	ИсключаемыеКолонки.Добавить("СуммаНДС7Валютная");
	ИсключаемыеКолонки.Добавить("Сумма5Валютная");
	ИсключаемыеКолонки.Добавить("СуммаНДС5Валютная");
	ИсключаемыеКолонки.Добавить("Сумма0Валютная");
	ИсключаемыеКолонки.Добавить("СуммаБНВалютная");
	
	// Служебные колонки:
	ИсключаемыеКолонки.Добавить("НомерСтроки");
	Для Каждого ИмяКолонки Из ИсключаемыеКолонки Цикл
		Если НЕ ТабРезультат.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
			ТабРезультат.Колонки.Удалить(ИмяКолонки);
		КонецЕсли;
	КонецЦикла;
	
	// Все колонки, кроме колонок НДС:
	ИменаКолонокДляПоиска = ПолучитьИменаКолонок(ТабРезультат);
	Поиск = Новый Структура();
	Для Каждого ИмяКолонки Из ИменаКолонокДляПоиска Цикл
		Поиск.Вставить(ИмяКолонки, Неопределено);
	КонецЦикла;
	
	// Добавляем общие колонки НДС:
	Если НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТабРезультат.Колонки, "СуммаНДС") Тогда
		ТабРезультат.Колонки.Добавить("СуммаНДС", ТипЧисло);
	КонецЕсли;
	Если НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТабРезультат.Колонки, "СтавкаНДС") Тогда
		ТабРезультат.Колонки.Добавить("СтавкаНДС", ТипСтавкиНДС);
	КонецЕсли;
	Если НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТабРезультат.Колонки, "СуммаБезНДС") Тогда
		ТабРезультат.Колонки.Добавить("СуммаБезНДС", ТипЧисло);
	КонецЕсли;
	Если НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТабРезультат.Колонки, "Всего") Тогда
		ТабРезультат.Колонки.Добавить("Всего", ТипЧисло);
	КонецЕсли;
	Если НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТабРезультат.Колонки, "СуммаНДСВалютная") Тогда
		ТабРезультат.Колонки.Добавить("СуммаНДСВалютная", ТипЧисло);
	КонецЕсли;
	Если НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТабРезультат.Колонки, "СуммаБезНДСВалютная") Тогда
		ТабРезультат.Колонки.Добавить("СуммаБезНДСВалютная", ТипЧисло);
	КонецЕсли;
	Если НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТабРезультат.Колонки, "ВсегоВалютная") Тогда
		ТабРезультат.Колонки.Добавить("ВсегоВалютная", ТипЧисло);
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Если СтрокаТаблицы["Сумма22"] <> 0 ИЛИ СтрокаТаблицы["СуммаНДС22"] <> 0 Тогда
			ТаблицаСОбщимиКолонкамиНДС_УвеличитьСуммыВСтроке(СтрокаТаблицы, ТабРезультат, Поиск, "22");
		КонецЕсли;
		
		Если СтрокаТаблицы["Сумма18"] <> 0 ИЛИ СтрокаТаблицы["СуммаНДС18"] <> 0 Тогда
			ТаблицаСОбщимиКолонкамиНДС_УвеличитьСуммыВСтроке(СтрокаТаблицы, ТабРезультат, Поиск, "18");
		КонецЕсли;
		
		Если СтрокаТаблицы["Сумма10"] <> 0 ИЛИ СтрокаТаблицы["СуммаНДС10"] <> 0 Тогда
			ТаблицаСОбщимиКолонкамиНДС_УвеличитьСуммыВСтроке(СтрокаТаблицы, ТабРезультат, Поиск, "10");
		КонецЕсли;
		
		Если СтрокаТаблицы["Сумма7"] <> 0 ИЛИ СтрокаТаблицы["СуммаНДС7"] <> 0 Тогда
			ТаблицаСОбщимиКолонкамиНДС_УвеличитьСуммыВСтроке(СтрокаТаблицы, ТабРезультат, Поиск, "7");
		КонецЕсли;
		
		Если СтрокаТаблицы["Сумма5"] <> 0 ИЛИ СтрокаТаблицы["СуммаНДС5"] <> 0 Тогда
			ТаблицаСОбщимиКолонкамиНДС_УвеличитьСуммыВСтроке(СтрокаТаблицы, ТабРезультат, Поиск, "5");
		КонецЕсли;
		
		Если СтрокаТаблицы["Сумма0"] <> 0 Тогда
			ТаблицаСОбщимиКолонкамиНДС_УвеличитьСуммыВСтроке(СтрокаТаблицы, ТабРезультат, Поиск, "0");
		КонецЕсли;
		
		Если СтрокаТаблицы["СуммаБН"] <> 0 Тогда
			ТаблицаСОбщимиКолонкамиНДС_УвеличитьСуммыВСтроке(СтрокаТаблицы, ТабРезультат, Поиск, "БН");
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТабРезультат;
	
КонецФункции

Функция ТрансформироватьТаблицуСКолонкамиНДС_ИзОбщих_ВИндивидуальные(Таблица) Экспорт
	
	// Подготовка:
	СоответствиеСтавкаОбозначениеКолонки = Новый Соответствие();
	СоответствиеСтавкаОбозначениеКолонки.Вставить(Перечисления.СтавкиНДС.НДС22,		"22");
	СоответствиеСтавкаОбозначениеКолонки.Вставить(Перечисления.СтавкиНДС.НДС22_122,	"22");
	СоответствиеСтавкаОбозначениеКолонки.Вставить(Перечисления.СтавкиНДС.НДС18,		"18");
	СоответствиеСтавкаОбозначениеКолонки.Вставить(Перечисления.СтавкиНДС.НДС18_118,	"18");
	СоответствиеСтавкаОбозначениеКолонки.Вставить(Перечисления.СтавкиНДС.НДС20,		"18");
	СоответствиеСтавкаОбозначениеКолонки.Вставить(Перечисления.СтавкиНДС.НДС20_120,	"18");
	СоответствиеСтавкаОбозначениеКолонки.Вставить(Перечисления.СтавкиНДС.НДС10,		"10");
	СоответствиеСтавкаОбозначениеКолонки.Вставить(Перечисления.СтавкиНДС.НДС10_110,	"10");
	СоответствиеСтавкаОбозначениеКолонки.Вставить(Перечисления.СтавкиНДС.НДС7,		"7");
	СоответствиеСтавкаОбозначениеКолонки.Вставить(Перечисления.СтавкиНДС.НДС7_107,	"7");
	СоответствиеСтавкаОбозначениеКолонки.Вставить(Перечисления.СтавкиНДС.НДС5,		"5");
	СоответствиеСтавкаОбозначениеКолонки.Вставить(Перечисления.СтавкиНДС.НДС5_105,	"5");
	СоответствиеСтавкаОбозначениеКолонки.Вставить(Перечисления.СтавкиНДС.НДС0,		"0");
	СоответствиеСтавкаОбозначениеКолонки.Вставить(Перечисления.СтавкиНДС.БезНДС,	"БН");
	
	СоответствиеСтавкаИмяКолонки = Новый Соответствие();
	СоответствиеСтавкаИмяКолонки.Вставить(Перечисления.СтавкиНДС.НДС22,		"СтавкаНДС22");
	СоответствиеСтавкаИмяКолонки.Вставить(Перечисления.СтавкиНДС.НДС22_122,	"СтавкаНДС22");
	СоответствиеСтавкаИмяКолонки.Вставить(Перечисления.СтавкиНДС.НДС18,		"СтавкаНДС18");
	СоответствиеСтавкаИмяКолонки.Вставить(Перечисления.СтавкиНДС.НДС18_118,	"СтавкаНДС18");
	СоответствиеСтавкаИмяКолонки.Вставить(Перечисления.СтавкиНДС.НДС20,		"СтавкаНДС18");
	СоответствиеСтавкаИмяКолонки.Вставить(Перечисления.СтавкиНДС.НДС20_120,	"СтавкаНДС18");
	СоответствиеСтавкаИмяКолонки.Вставить(Перечисления.СтавкиНДС.НДС10,		"СтавкаНДС10");
	СоответствиеСтавкаИмяКолонки.Вставить(Перечисления.СтавкиНДС.НДС10_110,	"СтавкаНДС10");
	СоответствиеСтавкаИмяКолонки.Вставить(Перечисления.СтавкиНДС.НДС7,		"СтавкаНДС7");
	СоответствиеСтавкаИмяКолонки.Вставить(Перечисления.СтавкиНДС.НДС7_107,	"СтавкаНДС7");
	СоответствиеСтавкаИмяКолонки.Вставить(Перечисления.СтавкиНДС.НДС5,		"СтавкаНДС5");
	СоответствиеСтавкаИмяКолонки.Вставить(Перечисления.СтавкиНДС.НДС5_105,	"СтавкаНДС5");
	
	ТипСтавкиНДС	= Новый ОписаниеТипов("ПеречислениеСсылка.СтавкиНДС");
	ТипЧисло		= Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2));
	
	// Возвращаемая таблица с индивидуальными колонками содержит колонки:
	// 1) колонки аналитики исходной таблицы с общими колонками (они же колонки для поиска)
	// 2) колонки индивидуальных ставок и сумм
	
	// 1) Добавляем колонки аналитики исходной таблицы с общими колонками (они же колонки для поиска)
	ТабРезультат = Таблица.СкопироватьКолонки();
	ИсключаемыеКолонкиИсходнойТаблицы = Новый Массив();
	ИсключаемыеКолонкиИсходнойТаблицы.Добавить("НомерСтроки");
	ИсключаемыеКолонкиИсходнойТаблицы.Добавить("СтавкаНДС");
	ИсключаемыеКолонкиИсходнойТаблицы.Добавить("СуммаНДС");
	ИсключаемыеКолонкиИсходнойТаблицы.Добавить("СуммаНДСВалютная");
	ИсключаемыеКолонкиИсходнойТаблицы.Добавить("СуммаБезНДС");
	ИсключаемыеКолонкиИсходнойТаблицы.Добавить("СуммаБезНДСВалютная");
	ИсключаемыеКолонкиИсходнойТаблицы.Добавить("Всего");
	ИсключаемыеКолонкиИсходнойТаблицы.Добавить("ВсегоВалютная");
	Для Каждого ИмяКолонки Из ИсключаемыеКолонкиИсходнойТаблицы Цикл
		КолонкаПрисутствует = (ТабРезультат.Колонки.Найти(ИмяКолонки) <> Неопределено);
		
		Если КолонкаПрисутствует Тогда
			ТабРезультат.Колонки.Удалить(ИмяКолонки);
		КонецЕсли;
	КонецЦикла;
	
	// Структура для поиска (по колонкам аналитики)
	Поиск = Новый Структура();
	ИменаКолонокАналитики = ПолучитьИменаКолонок(ТабРезультат);
	Для Каждого ИмяКолонки Из ИменаКолонокАналитики Цикл
		Поиск.Вставить(ИмяКолонки, Неопределено);
	КонецЦикла;
	
	// 2) Добавляем индивидуальные колонки НДС
	ТабРезультат.Колонки.Добавить("Сумма22",			ТипЧисло);
	ТабРезультат.Колонки.Добавить("СтавкаНДС22",		ТипСтавкиНДС);
	ТабРезультат.Колонки.Добавить("СуммаНДС22",			ТипЧисло);
	ТабРезультат.Колонки.Добавить("Сумма18",			ТипЧисло);
	ТабРезультат.Колонки.Добавить("СтавкаНДС18",		ТипСтавкиНДС);
	ТабРезультат.Колонки.Добавить("СуммаНДС18",			ТипЧисло);
	ТабРезультат.Колонки.Добавить("Сумма10",			ТипЧисло);
	ТабРезультат.Колонки.Добавить("СтавкаНДС10",		ТипСтавкиНДС);
	ТабРезультат.Колонки.Добавить("СуммаНДС10",			ТипЧисло);
	ТабРезультат.Колонки.Добавить("Сумма7",				ТипЧисло);
	ТабРезультат.Колонки.Добавить("СтавкаНДС7",			ТипСтавкиНДС);
	ТабРезультат.Колонки.Добавить("СуммаНДС7",			ТипЧисло);
	ТабРезультат.Колонки.Добавить("Сумма5",				ТипЧисло);
	ТабРезультат.Колонки.Добавить("СтавкаНДС5",			ТипСтавкиНДС);
	ТабРезультат.Колонки.Добавить("СуммаНДС5",			ТипЧисло);
	ТабРезультат.Колонки.Добавить("Сумма0",				ТипЧисло);
	ТабРезультат.Колонки.Добавить("СуммаБН",			ТипЧисло);
	ТабРезультат.Колонки.Добавить("Всего",				ТипЧисло);
	
	ТабРезультат.Колонки.Добавить("Сумма22Валютная",	ТипЧисло);
	ТабРезультат.Колонки.Добавить("СуммаНДС22Валютная",	ТипЧисло);
	ТабРезультат.Колонки.Добавить("Сумма18Валютная",	ТипЧисло);
	ТабРезультат.Колонки.Добавить("СуммаНДС18Валютная",	ТипЧисло);
	ТабРезультат.Колонки.Добавить("Сумма10Валютная",	ТипЧисло);
	ТабРезультат.Колонки.Добавить("СуммаНДС10Валютная",	ТипЧисло);
	ТабРезультат.Колонки.Добавить("Сумма7Валютная",		ТипЧисло);
	ТабРезультат.Колонки.Добавить("СуммаНДС7Валютная",	ТипЧисло);
	ТабРезультат.Колонки.Добавить("Сумма5Валютная",		ТипЧисло);
	ТабРезультат.Колонки.Добавить("СуммаНДС5Валютная",	ТипЧисло);
	ТабРезультат.Колонки.Добавить("Сумма0Валютная",		ТипЧисло);
	ТабРезультат.Колонки.Добавить("СуммаБНВалютная",	ТипЧисло);
	ТабРезультат.Колонки.Добавить("ВсегоВалютная",		ТипЧисло);
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		СтавкаНДС							= СтрокаТаблицы["СтавкаНДС"];
		ИмяИндивидуальнойКолонкиНДС			= СоответствиеСтавкаИмяКолонки.Получить(СтавкаНДС);
		ОбозначениеИндивидуальнойКолонкиНДС	= СоответствиеСтавкаОбозначениеКолонки.Получить(СтавкаНДС);
		
		// Нужно ли добавить новую строку для текущей аналитики?
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаТаблицы);
		МассивДобавленныхСтрок = ТабРезультат.НайтиСтроки(Поиск);
		НоваяСтрока = Неопределено;
		Если ИмяИндивидуальнойКолонкиНДС = Неопределено Тогда
			// Ставка, для которой не заведено отдельной колонки (0% или БезНДС).
			Если МассивДобавленныхСтрок.Количество() > 0 Тогда
				НоваяСтрока = МассивДобавленныхСтрок[0];
			КонецЕсли;
		Иначе
			// Ставка, для которой заведена отдельная колонка.
			Для Каждого ДобавленнаяСтрока Из МассивДобавленныхСтрок Цикл
				СтрокаПодходит = (ДобавленнаяСтрока[ИмяИндивидуальнойКолонкиНДС] = СтавкаНДС)
					ИЛИ (НЕ ЗначениеЗаполнено(ДобавленнаяСтрока[ИмяИндивидуальнойКолонкиНДС]));
				Если СтрокаПодходит Тогда
					НоваяСтрока = ДобавленнаяСтрока;
					НоваяСтрока[ИмяИндивидуальнойКолонкиНДС] = СтавкаНДС;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		// Добавляем новую строку:
		Если НоваяСтрока = Неопределено Тогда
			НоваяСтрока = ТабРезультат.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		КонецЕсли;
		
		ТаблицаСИндивидуальнымиКолонкамиНДС_УвеличитьСуммыВСтроке(СтрокаТаблицы, НоваяСтрока, ОбозначениеИндивидуальнойКолонкиНДС);
		
	КонецЦикла;
	
	Возврат ТабРезультат;
	
КонецФункции

// Устанавливает желаемый знак каждому числу
//
// Параметры
//	СтруктураЧисел	- Структура	- числа для обработки;
//	Знак			- Строка	- обозначение устанавливаемого знака ("+" или "-")
Процедура УстановитьЗнакЧисел(СтруктураЧисел, Знак) Экспорт
	
	Для Каждого Элемент Из СтруктураЧисел Цикл
		
		ЗнакЧисла = ?(Элемент.Значение >= 0, "+", "-");
		
		Если ЗнакЧисла = Знак Тогда
			Продолжить;
		КонецЕсли;
		
		СтруктураЧисел[Элемент.Ключ] = -Элемент.Значение;
		
	КонецЦикла;
	
КонецПроцедуры

// Ожидаемые колонки: НФА
Процедура ЗаполнитьВидЦенности(Таблица, ПричинаНалогообложения) Экспорт
	
	Если Таблица.Колонки.Найти("НФА") = Неопределено Тогда
		ТекстСообщения = НСтр("ru='Не удалось заполнить ВидЦенности в таблице СоставНФА: отсутствует колонка НФА'");
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;
	
	Если Таблица.Колонки.Найти("ВидЦенности") = Неопределено Тогда
		Таблица.Колонки.Добавить("ВидЦенности", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыЦенностейНДС"));
	КонецЕсли;
	
	ЭтоАванс = УчетНДСПовтИсп.Аванс(ПричинаНалогообложения);
	
	// Если аванс, то устанавливаем одинаковое значение во всей таблице
	
	Если ЭтоАванс Тогда
		
		Таблица.ЗаполнитьЗначения(Перечисления.ВидыЦенностейНДС.Аванс, "ВидЦенности");
		
		Возврат;
		
	КонецЕсли;
	
	// Если не аванс, то нужное значение определяется свойствами НФА
	
	ЗапросСвойств = Новый Запрос();
	ЗапросСвойств.УстановитьПараметр("СписокНФА", Таблица.ВыгрузитьКолонку("НФА"));
	ЗапросСвойств.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Свойства основных средств
	|//
	|ВЫБРАТЬ
	|	Ссылка,
	|	ВидНФА
	|ИЗ
	|	Справочник.ОсновныеСредства
	|ГДЕ
	|	Ссылка В(&СписокНФА)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Свойства номенклатуры
	|//
	|ВЫБРАТЬ
	|	Ссылка,
	|	ТипНоменклатуры
	|ИЗ
	|	Справочник.Номенклатура
	|ГДЕ
	|	Ссылка В(&СписокНФА)
	|;";
	
	РезультатыЗапроса = ЗапросСвойств.ВыполнитьПакет();
	
	// [0]. Свойства основных средств
	СвойстваОС = РезультатыЗапроса[0].Выгрузить();
	
	// [1]. Свойства номенклатуры
	СвойстваНоменклатуры = РезультатыЗапроса[1].Выгрузить();
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		
		НФА = СтрокаТаблицы["НФА"];
		
		Если ТипЗнч(НФА) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
			
			Свойства = СвойстваОС.Найти(НФА, "Ссылка");
			
			Если Свойства = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если Свойства["ВидНФА"] = Перечисления.ВидыНФА.ПраваПользованияИмуществом Тогда
				
				ВидЦенности = Перечисления.ВидыЦенностейНДС.Услуги;
				
			Иначе
				
				ВидЦенности = Перечисления.ВидыЦенностейНДС.ОС;
				
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(НФА) = Тип("СправочникСсылка.Номенклатура") Тогда
			
			Свойства = СвойстваНоменклатуры.Найти(НФА, "Ссылка");
			
			Если Свойства = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если Свойства["ТипНоменклатуры"] = Перечисления.ТипыНоменклатуры.Работа
				ИЛИ Свойства["ТипНоменклатуры"] = Перечисления.ТипыНоменклатуры.Услуга
				ИЛИ Свойства["ТипНоменклатуры"] = Перечисления.ТипыНоменклатуры.Госуслуга
				ИЛИ Свойства["ТипНоменклатуры"] = Перечисления.ТипыНоменклатуры.УслугиАренды Тогда
				
				ВидЦенности = Перечисления.ВидыЦенностейНДС.Услуги;
				
			Иначе
				
				ВидЦенности = Перечисления.ВидыЦенностейНДС.Материалы;
				
			КонецЕсли;
			
		Иначе
			
			ВидЦенности = Перечисления.ВидыЦенностейНДС.Прочее;
			
		КонецЕсли;
		
		СтрокаТаблицы["ВидЦенности"] = ВидЦенности;
		
	КонецЦикла;
	
КонецПроцедуры

// Ожидаемые колонки: ВидЦенности
Функция ПолучитьОбщийВидЦенности(ТаблицаСоставНФА) Экспорт
	
	Если ТаблицаСоставНФА.Колонки.Найти("ВидЦенности") = Неопределено Тогда
		ТекстСообщения = НСтр("ru='Не удалось определить общий ВидЦенности для таблицы СоставНФА: отсутствует колонка ВидЦенности'");
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;
	
	ЗначениеПоУмолчанию = Неопределено;
	
	КоличествоСтрок = ТаблицаСоставНФА.Количество();
	
	Если КоличествоСтрок = 0 Тогда
		
		Возврат ЗначениеПоУмолчанию;
		
	Иначе
		
		ПервоеЗначение = ТаблицаСоставНФА[0]["ВидЦенности"];
		
		Если КоличествоСтрок = 1 Тогда
			
			Возврат ПервоеЗначение;
			
		КонецЕсли;
		
		Для НомерСтроки = 2 По КоличествоСтрок Цикл
			
			ВидЦенности = ТаблицаСоставНФА[НомерСтроки - 1]["ВидЦенности"];
			
			Если ВидЦенности <> ПервоеЗначение Тогда
				
				Возврат ЗначениеПоУмолчанию;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Возврат ПервоеЗначение;
		
	КонецЕсли;
	
КонецФункции

// Признаки счетов-фактур, определяемые содержимым колонки НФА табличных частей:
//	 1) "ТолькоРаботыУслугиПраваПользования" - во всех строках табличной части позиции являются работой или услугой или правом пользования.
//		Логика аналогична УчетНДС.ЗаполнитьВидЦенности()
//
//	 2) "ЕстьПрослеживаемыйТовар" - хотя бы в одной строке табличной части указан прослеживаемый товар
//
// Параметры:
//	МассивСчетовФактур	- массив ссылок
//							ДокументСсылка.СчетФактураВыданный
//							ДокументСсылка.ИсправительныйСчетФактураВыданный
//							ДокументСсылка.КорректировочныйСчетФактураВыданный
//
// Возвращаемое значение:
//	Таблица значений	- с колонками Ссылка, ТолькоРаботыУслугиПраваПользования, ЕстьПрослеживаемыйТовар
Функция ПолучитьПризнакиСчетовФактур(МассивСчетовФактур) Экспорт
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивСсылок",						МассивСчетовФактур);
	ЗапросПоиск.УстановитьПараметр("ВестиУчетПрослеживаемыхТоваров",	ПолучитьФункциональнуюОпцию("ВестиУчетПрослеживаемыхТоваров"));
	ЗапросПоиск.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА ВТ.НФА ССЫЛКА Справочник.ОсновныеСредства И НЕ ВТ.НФА = ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)
	|			ТОГДА ВЫРАЗИТЬ(ВТ.НФА КАК Справочник.ОсновныеСредства).ВидНФА = ЗНАЧЕНИЕ(Перечисление.ВидыНФА.ПраваПользованияИмуществом)
	|		КОГДА ВТ.НФА ССЫЛКА Справочник.Номенклатура И НЕ ВТ.НФА = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА ВЫРАЗИТЬ(ВТ.НФА КАК Справочник.Номенклатура).ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Работа)
	|					ИЛИ ВЫРАЗИТЬ(ВТ.НФА КАК Справочник.Номенклатура).ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Услуга)
	|					ИЛИ ВЫРАЗИТЬ(ВТ.НФА КАК Справочник.Номенклатура).ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Госуслуга)
	|					ИЛИ ВЫРАЗИТЬ(ВТ.НФА КАК Справочник.Номенклатура).ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.УслугиАренды)
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоРаботаУслугаПравоПользования,
	|	ВЫБОР
	|		КОГДА &ВестиУчетПрослеживаемыхТоваров
	|			ТОГДА ВЫБОР
	|					КОГДА ВТ.НФА ССЫЛКА Справочник.Номенклатура И НЕ ВТ.НФА = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|						ТОГДА ЕСТЬNULL(НоменклатураИсторияПрослеживаемости.ПрослеживаемыйТовар, ВЫРАЗИТЬ(ВТ.НФА КАК Справочник.Номенклатура).ПрослеживаемыйТовар)
	|								ИЛИ ЕСТЬNULL(НоменклатураИсторияПрослеживаемости.КомплектСПрослеживаемымиТоварами, ВЫРАЗИТЬ(ВТ.НФА КАК Справочник.Номенклатура).КомплектСПрослеживаемымиТоварами)
	|					КОГДА ВТ.НФА ССЫЛКА Справочник.ОсновныеСредства И НЕ ВТ.НФА = ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)
	|						ТОГДА ЕСТЬNULL(ОСИсторияПрослеживаемости.ПрослеживаемыйТовар, ВЫРАЗИТЬ(ВТ.НФА КАК Справочник.ОсновныеСредства).ПрослеживаемыйТовар)
	|					ИНАЧЕ ЛОЖЬ
	|				КОНЕЦ
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоПрослеживаемыйТовар
	|ПОМЕСТИТЬ ПризнакиСтрок
	|ИЗ
	|	(ВЫБРАТЬ
	|		СчетФактураВыданныйСоставНФА.Ссылка КАК Ссылка,
	|		СчетФактураВыданныйСоставНФА.НФА КАК НФА,
	|		СчетФактураВыданныйСоставНФА.Ссылка.Дата КАК Дата
	|	ИЗ
	|		Документ.СчетФактураВыданный.СоставНФА КАК СчетФактураВыданныйСоставНФА
	|	ГДЕ
	|		СчетФактураВыданныйСоставНФА.Ссылка В(&МассивСсылок)
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ИсправительныйСчетФактураВыданныйСоставНФА.Ссылка,
	|		ИсправительныйСчетФактураВыданныйСоставНФА.НФА,
	|		ИсправительныйСчетФактураВыданныйСоставНФА.Ссылка.Дата
	|	ИЗ
	|		Документ.ИсправительныйСчетФактураВыданный.СоставНФА КАК ИсправительныйСчетФактураВыданныйСоставНФА
	|	ГДЕ
	|		ИсправительныйСчетФактураВыданныйСоставНФА.Ссылка В(&МассивСсылок)
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		КорректировочныйСчетФактураВыданныйСоставНФА.Ссылка,
	|		КорректировочныйСчетФактураВыданныйСоставНФА.НФА,
	|		КорректировочныйСчетФактураВыданныйСоставНФА.Ссылка.Дата
	|	ИЗ
	|		Документ.КорректировочныйСчетФактураВыданный.СоставНФА КАК КорректировочныйСчетФактураВыданныйСоставНФА
	|	ГДЕ
	|		КорректировочныйСчетФактураВыданныйСоставНФА.Ссылка В(&МассивСсылок)) КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура.ИсторияПрослеживаемости КАК НоменклатураИсторияПрослеживаемости
	|		ПО ВТ.НФА = НоменклатураИсторияПрослеживаемости.Ссылка
	|			И (НоменклатураИсторияПрослеживаемости.ДатаИзменения > ВТ.Дата)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОсновныеСредства.ИсторияПрослеживаемости КАК ОСИсторияПрослеживаемости
	|		ПО ВТ.НФА = ОСИсторияПрослеживаемости.Ссылка
	|			И (ОСИсторияПрослеживаемости.ДатаИзменения > ВТ.Дата)
	|ГДЕ
	|	ВЫБОР
	|			КОГДА ВТ.НФА ССЫЛКА Справочник.Номенклатура
	|				ТОГДА НоменклатураИсторияПрослеживаемости.Ссылка ЕСТЬ NULL
	|						ИЛИ НоменклатураИсторияПрослеживаемости.Ссылка В
	|							(ВЫБРАТЬ ПЕРВЫЕ 1
	|								Т.Ссылка
	|							ИЗ
	|								Справочник.Номенклатура.ИсторияПрослеживаемости КАК Т
	|							ГДЕ
	|								Т.ДатаИзменения > ВТ.Дата
	|								И Т.Ссылка = ВТ.НФА
	|							УПОРЯДОЧИТЬ ПО
	|								Т.ДатаИзменения)
	|			КОГДА ВТ.НФА ССЫЛКА Справочник.ОсновныеСредства
	|				ТОГДА ОСИсторияПрослеживаемости.Ссылка ЕСТЬ NULL
	|						ИЛИ ОСИсторияПрослеживаемости.Ссылка В
	|							(ВЫБРАТЬ ПЕРВЫЕ 1
	|								Т.Ссылка
	|							ИЗ
	|								Справочник.ОсновныеСредства.ИсторияПрослеживаемости КАК Т
	|							ГДЕ
	|								Т.ДатаИзменения > ВТ.Дата
	|								И Т.Ссылка = ВТ.НФА
	|							УПОРЯДОЧИТЬ ПО
	|								Т.ДатаИзменения)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПризнакиСтрок.Ссылка КАК Ссылка,
	|	МИНИМУМ(ПризнакиСтрок.ЭтоРаботаУслугаПравоПользования) КАК ТолькоРаботыУслугиПраваПользования,
	|	МАКСИМУМ(ПризнакиСтрок.ЭтоПрослеживаемыйТовар) КАК ЕстьПрослеживаемыйТовар
	|ИЗ
	|	ПризнакиСтрок КАК ПризнакиСтрок
	|
	|СГРУППИРОВАТЬ ПО
	|	ПризнакиСтрок.Ссылка";
	
	ТаблицаПризнаков = ЗапросПоиск.Выполнить().Выгрузить();
	
	ТаблицаПризнаков.Индексы.Добавить("Ссылка");
	
	Поиск = Новый Структура("Ссылка");
	
	СписокДокументов = ПрочитатьПризнакиПрослеживаемостиОС(МассивСчетовФактур);
	
	Для Каждого ДокументСсылка Из СписокДокументов Цикл
		Поиск.Ссылка = ДокументСсылка;
		
		МассивСтрок = ТаблицаПризнаков.НайтиСтроки(Поиск);
		
		Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
			СтрокаТаблицы.ЕстьПрослеживаемыйТовар = Истина;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ТаблицаПризнаков;
	
КонецФункции

// Ожидаемые колонки: ВидЦенности, СтавкаНДС, ОбъектНалогообложения
Процедура ЗаполнитьАналитикуЗатрат(Таблица) Экспорт
	
	Если Таблица.Колонки.Найти("ПроцентНДСкВычету") = Неопределено Тогда
		Таблица.Колонки.Добавить("ПроцентНДСкВычету", Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(6,2,ДопустимыйЗнак.Неотрицательный)));
	КонецЕсли;
	
	Если Таблица.Колонки.Найти("СчетДт") = Неопределено Тогда
		Таблица.Колонки.Добавить("СчетДт", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	КонецЕсли;
	
	Если Таблица.Колонки.Найти("КЭКСчетаДебета") = Неопределено Тогда
		Таблица.Колонки.Добавить("КЭКСчетаДебета", Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	КонецЕсли;
	
	Если Таблица.Колонки.Найти("КПССчетаДебета") = Неопределено Тогда
		Таблица.Колонки.Добавить("КПССчетаДебета", Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	КонецЕсли;
	
	Если Таблица.Колонки.Найти("СубконтоДт1") = Неопределено Тогда
		Таблица.Колонки.Добавить("СубконтоДт1");
	КонецЕсли;
	
	Если Таблица.Колонки.Найти("СубконтоДт2") = Неопределено Тогда
		Таблица.Колонки.Добавить("СубконтоДт2");
	КонецЕсли;
	
	Если Таблица.Колонки.Найти("СубконтоДт3") = Неопределено Тогда
		Таблица.Колонки.Добавить("СубконтоДт3");
	КонецЕсли;
	
	ОбъектыНалогообложения = Таблица.ВыгрузитьКолонку("ОбъектНалогообложения");
	
	ТаблицаАналитикиЗатрат = Документы.РаспределениеВходящегоНДС.ПолучитьТаблицуАналитикиЗатратИзДокументов(ОбъектыНалогообложения);
	
	Поиск = Новый Структура("
		|ОбъектНалогообложения,
		|ВидЦенности,
		|СтавкаНДС");
	
	ПриОтсутствииРаспределения = Новый Структура();
	ПриОтсутствииРаспределения.Вставить("ПроцентНДСкВычету", 100);
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаТаблицы);
		
		МассивСтрок = ТаблицаАналитикиЗатрат.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() = 0 Тогда
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ПриОтсутствииРаспределения);
			
			Продолжить;
		КонецЕсли;
		
		СтрокаАналитики = МассивСтрок[0];
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтрокаАналитики);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьВМассив(ИсходныйМассив, ДобавляемыйМассив) Экспорт
	
	Для Каждого ТекЗначение Из ДобавляемыйМассив Цикл
		
		Если ЗначениеЗаполнено(ТекЗначение) Тогда
			Если ИсходныйМассив.Найти(ТекЗначение) = Неопределено Тогда
				ИсходныйМассив.Добавить(ТекЗначение);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьВТаблицу(ИсходнаяТаблица, ДобавляемаяТаблица, ЗаменитьСчетФактуру = Ложь, ДополнительныеЗначения = Неопределено) Экспорт
	
	Для Каждого СтрокаТаблицы Из ДобавляемаяТаблица Цикл
		НоваяСтрока = ИсходнаяТаблица.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		
		Если ЗаменитьСчетФактуру = Истина Тогда
			ЭтоИсправлениеИлиКорректировка = ЗначениеЗаполнено(СтрокаТаблицы["ДокументКорректировки"]);
			
			Если ЭтоИсправлениеИлиКорректировка Тогда
				НоваяСтрока["СчетФактура"] = СтрокаТаблицы["ДокументКорректировки"];
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ ДополнительныеЗначения = Неопределено Тогда
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ДополнительныеЗначения);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСтроку5аДляЭДО(СтруктураДанныхЭДО) Экспорт
	
	Шапка = СтруктураДанныхЭДО["Шапка"][0];
	
	Если ТипЗнч(Шапка.Ссылка) = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный") Тогда
		Дата = Шапка.ДатаСчетаФактуры;
		ДокументРеализации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Шапка.ДокументОснование, "ДокументОснование");
	Иначе
		Дата = Шапка.Дата;
		ДокументРеализации = Шапка.ДокументОснование;
	КонецЕсли;
	
	ВыборкаШапка = Новый Структура();
	ВыборкаШапка.Вставить("Дата", Дата);
	ВыборкаШапка.Вставить("ДокументРеализации", ДокументРеализации);
	
	СтруктураДанныхЭДО.Вставить("Строка5а",
		ПечатьСчетаФактуры_ПолучитьПредставлениеДокументОбОтгрузке(
			ВыборкаШапка,
			СтруктураДанныхЭДО["ТабЧастьНФА"].Количество(),
			УчетНДСПовтИсп.Аванс(Шапка.ПричинаНалогообложения),
			СтруктураДанныхЭДО["НомерДокумента"].Номер));
	
КонецПроцедуры

// Вызывается из СКД книг покупок, продаж
Процедура ДобавитьКолонкуТаблицаПоказателиПрослеживаемости(Дерево) Экспорт
	
	Дерево.Колонки.Добавить("ТаблицаПоказателиПрослеживаемости", Новый ОписаниеТипов("ТаблицаЗначений,Null"));
	
КонецПроцедуры

// Вызывается из СКД книг покупок, продаж
Функция СократитьТаблицуПоказателиПрослеживаемости(Таблица) Экспорт
	
	// Если есть пустая строка, то, благодаря упорядочиванию
	// вычисляемого поля ТаблицаПоказателиПрослеживаемости,
	// она расположена самой первой	
	
	Если Таблица[0].ДокументОперации = Null Тогда
		Если Таблица.Количество() = 1 Тогда
			Возврат Null;
		Иначе
			Таблица.Удалить(0);
			Возврат Таблица;
		КонецЕсли;
	Иначе
		Возврат Таблица;
	КонецЕсли;
	
КонецФункции

