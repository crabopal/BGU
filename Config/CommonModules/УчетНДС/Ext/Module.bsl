Процедура ЗаполнитьОтчетНДСФормаОтчета2009Кв4(ПараметрыОтчета, Контейнер) Экспорт
	
	Перем ТаблицаРасшифровки;
	
	СписокОрганизаций = Новый СписокЗначений();
	СписокОрганизаций.ЗагрузитьЗначения(ПараметрыОтчета["ГруппаОрганизаций"].ВыгрузитьЗначения());
	СписокОрганизаций.Добавить(ПараметрыОтчета["Организация"]);
	ПараметрыОтчета.Вставить("СписокОрганизаций", СписокОрганизаций);
	
	// Новый вариант:
	ЗаполнитьРаздел1(Контейнер, ТаблицаРасшифровки, ПараметрыОтчета);
	ЗаполнитьРаздел2(Контейнер, ТаблицаРасшифровки, ПараметрыОтчета);
	ЗаполнитьРаздел3(Контейнер, ТаблицаРасшифровки, ПараметрыОтчета);
	
	// Сохраняем таблицу расшифровки:
	ПараметрыОтчета.АдресВременногоХранилищаРасшифровки = ПоместитьВоВременноеХранилище(ТаблицаРасшифровки, ПараметрыОтчета.УникальныйИдентификаторФормы);
	
КонецПроцедуры

Процедура ЗаполнитьРаздел1(Контейнер, ТаблицаРасшифровки, ПараметрыОтчета)
	
	Раздел1 = Контейнер.Раздел1;
	
	КодОКТМО = ПолучитьКодОКТМО(ПараметрыОтчета);
	Раздел1.П000100001003 = КодОКТМО;
	
КонецПроцедуры

Процедура ЗаполнитьРаздел2(Контейнер, ТаблицаРасшифровки, ПараметрыОтчета)
	
	// Получаем данные:
	РезультатДерево = Новый ДеревоЗначений();
	ВывестиРезультатВыполненияСКД(РезультатДерево, "Раздел 2", ПараметрыОтчета);
	
	// Подготавливаем контейнер:
	Раздел2 = Контейнер.Раздел2;
	СтраницаРаздел2 = Раздел2[0].Данные[0].Значение;
	Для Каждого Показатель Из СтраницаРаздел2 Цикл
		СтраницаРаздел2[Показатель.Ключ] = ОбщегоНазначенияБГУ.ПустоеЗначениеТипа(ТипЗнч(Показатель.Значение));
	КонецЦикла;
	Пока Раздел2.Количество()>1 Цикл
		Раздел2.Удалить(1);
	КонецЦикла;
	КодОКТМО = ПолучитьКодОКТМО(ПараметрыОтчета);
	
	// Заполняем контейнер:
	ПерваяСтраница = Истина;
	НомерСтраницы = 0;
	Для Каждого СтрокаКонтрагент Из РезультатДерево.Строки Цикл
		Для Каждого СтрокаКодОперации Из СтрокаКонтрагент.Строки Цикл
			НомерСтраницы = НомерСтраницы + 1;
			Для Каждого ДетальнаяСтрока Из СтрокаКодОперации.Строки Цикл
				Если ПерваяСтраница Тогда
					ПерваяСтраница = Ложь;
				Иначе
					// Создаем дополнительную страницу в декларации:
					СтруктураНовойТаблицы = Новый Структура();
					Для Каждого Показатель Из СтраницаРаздел2 Цикл
						СтруктураНовойТаблицы.Вставить(Показатель.Ключ, ОбщегоНазначенияБГУ.ПустоеЗначениеТипа(ТипЗнч(Показатель.Значение)));
					КонецЦикла;
					
					Раздел2.Добавить().Данные = Новый СписокЗначений();
					Раздел2[Раздел2.Количество()-1].Данные.Добавить(СтруктураНовойТаблицы); 
				КонецЕсли;
				
				СтраницаРаздел2 = Раздел2[Раздел2.Количество()-1].Данные[0].Значение;	
				ЗаполнитьЗначенияСвойств(СтраницаРаздел2, ДетальнаяСтрока);
				СтраницаРаздел2.П000200005003 = КодОКТМО;
				
				// Избавляемся от значений Null:
				СтруктураРаздела = СтраницаРаздел2;
				Для Каждого Показатель Из СтруктураРаздела Цикл
					Если Показатель.Значение = Null Тогда
						СтруктураРаздела[Показатель.Ключ] = 0;
					КонецЕсли;	
				КонецЦикла;
				
				// Расшифровка
				
				// Строка 060
				ДополнительныйОтбор = Новый Структура();
				ДополнительныйОтбор.Вставить("Контрагент",	ДетальнаяСтрока["Контрагент"]);
				ДополнительныйОтбор.Вставить("КодОперации",	ДетальнаяСтрока["КодОперации"]);
				ДобавитьСтрокуРасшифровки(ТаблицаРасшифровки,
					"П000200006003" + "_" + НомерСтраницы,
					"Строка 060 (раздел 2, страница " + НомерСтраницы + ") ""Сумма налога, исчисленная к уплате в бюджет""",
					"", "Строка 060", СтраницаРаздел2.П000200006003,
					"Раздел2",
					"Раздел 2 (расшифровка П000200006003)",	// КлючВарианта
					ПараметрыОтчета,
					ДополнительныйОтбор);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

