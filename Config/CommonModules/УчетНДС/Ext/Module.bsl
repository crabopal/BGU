Процедура ЗаполнитьРаздел7_2021Кв3(Контейнер, ТаблицаРасшифровки, ПараметрыОтчета)
	
	// Получаем данные
	Результат = Новый ДеревоЗначений();
	ВывестиРезультатВыполненияСКД_2019Кв1(Результат, "Раздел 7", ПараметрыОтчета);
	
	КоличествоСтрок = Результат.Строки.Количество();
	
	Если КоличествоСтрок > 0 Тогда
		ОчиститьРаздел7(Контейнер);
		
		НомерСтроки = 0;
		
		Для Каждого СтрокаКодОперации Из Результат.Строки Цикл
			Для Каждого СтрокаДетальная Из СтрокаКодОперации.Строки Цикл
				НомерСтроки = НомерСтроки + 1;
				
				ЗаполнитьСтрокуРаздел7(Контейнер, НомерСтроки, СтрокаДетальная, ТаблицаРасшифровки, ПараметрыОтчета);
			КонецЦикла;
		КонецЦикла;
		
	Иначе
		ИнициализироватьРаздел7(Контейнер);
	КонецЕсли;
	
КонецПроцедуры

Процедура ИнициализироватьРаздел7(Контейнер)
	
	КодОперацииПоУмолчанию = "       ";
	
	Контейнер.Раздел7.Вставить("П000700000101_1", КодОперацииПоУмолчанию); // КодОперации
	Контейнер.Раздел7.Вставить("П000700000102_1", 0); // СтоимостьРеализации
	Контейнер.Раздел7.Вставить("П000700000103_1", 0); // СтоимостьПриобретения
	Контейнер.Раздел7.Вставить("П000700000104_1", 0); // НДС
	
	Контейнер.Раздел7.Вставить("П000700001001", 0); // СуммаАванса
	
	Контейнер.Раздел7_ДанныеДопСтрок.Очистить();
	
	НоваяСтрока = Контейнер.Раздел7_ДанныеДопСтрок.Добавить();
	НоваяСтрока.П000700000101 = КодОперацииПоУмолчанию;
	
КонецПроцедуры

Процедура ОчиститьРаздел7(Контейнер)
	
	УдаляемыеЭлементы = Новый Массив();
	
	Для Каждого Элемент Из Контейнер.Раздел7 Цикл
		УдаляемыеЭлементы.Добавить(Элемент.Ключ);
	КонецЦикла;
	
	Для Каждого ИмяЭлемента Из УдаляемыеЭлементы Цикл
		Контейнер.Раздел7.Удалить(ИмяЭлемента);
	КонецЦикла;
	
	Контейнер.Раздел7_ДанныеДопСтрок.Очистить();
	
КонецПроцедуры

Процедура ЗаполнитьСтрокуРаздел7(Контейнер, НомерСтроки, ДанныеЗаполнения, ТаблицаРасшифровки, ПараметрыОтчета)
	
	СтрокаКодОперации           = "П000700000101";
	СтрокаСтоимостьРеализации   = "П000700000102";
	СтрокаСтоимостьПриобретения = "П000700000103";
	СтрокаНДС                   = "П000700000104";
	
	НомерСтрокиБезГруппировки = "_" + Формат(НомерСтроки, "ЧГ=0");
	
	СтрокаРаздел7 = Контейнер.Раздел7_ДанныеДопСтрок.Добавить();
	СтрокаРаздел7[СтрокаКодОперации]			= ДанныеЗаполнения["Р7_" + СтрокаКодОперации];
	СтрокаРаздел7[СтрокаСтоимостьРеализации]	= ДанныеЗаполнения["Р7_" + СтрокаСтоимостьРеализации];
	СтрокаРаздел7[СтрокаСтоимостьПриобретения]	= ДанныеЗаполнения["Р7_" + СтрокаСтоимостьПриобретения];
	СтрокаРаздел7[СтрокаНДС]					= ДанныеЗаполнения["Р7_" + СтрокаНДС];
	
	ДопОтбор = Новый Структура();
	ДопОтбор.Вставить("Р7_П000700000101", ДанныеЗаполнения["Р7_" + СтрокаКодОперации]);
		
	// Графа 2
	ДобавитьСтрокуРасшифровки_2019Кв1(ТаблицаРасшифровки,
		"П000700000102" + НомерСтрокиБезГруппировки,
		"Графа 2 (раздел 7) ""Стоимость реализованных (переданных) товаров (работ, услуг), без налога в рублях""",
		"", "Графа 2 (сумма реализации)", ДанныеЗаполнения["Р7_" + СтрокаСтоимостьРеализации],
		"Раздел7",
		"Раздел 7 (расшифровка П000700000102)",
		ПараметрыОтчета,
		ДопОтбор);
	
	// Графа 3
	ДобавитьСтрокуРасшифровки_2019Кв1(ТаблицаРасшифровки,
		"П000700000103" + НомерСтрокиБезГруппировки,
		"Графа 3 (раздел 7) ""Стоимость приобретенных товаров (работ, услуг), не облагаемых налогом, в рублях""",
		"", "Графа 3 (сумма приобретения)", ДанныеЗаполнения["Р7_" + СтрокаСтоимостьПриобретения],
		"Раздел7",
		"Раздел 7 (расшифровка П000700000103)",
		ПараметрыОтчета,
		ДопОтбор);
	
	// Графа 4
	ДобавитьСтрокуРасшифровки_2019Кв1(ТаблицаРасшифровки,
		"П000700000104" + НомерСтрокиБезГруппировки,
		"Графа 4 (раздел 7) ""Сумма налога по приобретенным товарам (работам, услугам), не подлежащая вычету, в рублях""",
		"", "Графа 4 (сумма налога)", ДанныеЗаполнения["Р7_" + СтрокаНДС],
		"Раздел7",
		"Раздел 7 (расшифровка П000700000104)",
		ПараметрыОтчета,
		ДопОтбор);
	
	ИмяКлюча = СтрокаКодОперации + НомерСтрокиБезГруппировки;
	Контейнер.Раздел7.Вставить(ИмяКлюча, ДанныеЗаполнения["Р7_" + СтрокаКодОперации]);
	
	ИмяКлюча = СтрокаСтоимостьРеализации + НомерСтрокиБезГруппировки;
	Контейнер.Раздел7.Вставить(ИмяКлюча, ДанныеЗаполнения["Р7_" + СтрокаСтоимостьРеализации]);
	
	ИмяКлюча = СтрокаСтоимостьПриобретения + НомерСтрокиБезГруппировки;
	Контейнер.Раздел7.Вставить(ИмяКлюча, ДанныеЗаполнения["Р7_" + СтрокаСтоимостьПриобретения]);
	
	ИмяКлюча = СтрокаНДС + НомерСтрокиБезГруппировки;
	Контейнер.Раздел7.Вставить(ИмяКлюча, ДанныеЗаполнения["Р7_" + СтрокаНДС]);
	
КонецПроцедуры

Процедура ЗаполнитьРаздел8_2021Кв3(Контейнер, ТаблицаРасшифровки, ПараметрыОтчета)
	
	// Подготовка
	ФормироватьОсновнойРаздел		= Истина;
	ФормироватьДопЛисты				= НЕ (ПараметрыОтчета["ВидДокумента"] = 0);
	ВыводитьТолькоДопЛисты			= Ложь;
	
	// Отбор по организации
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных();
	НовыйЭлемент = КомпоновщикНастроек.Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	НовыйЭлемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Организация");
	НовыйЭлемент.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
