	ДанныеОшибки.Вставить("Ссылка1");
	ДанныеОшибки.Вставить("Ссылка2");
	ДанныеОшибки.Вставить("ТекстСообщения", "");
	ДанныеОшибки.Вставить("ТекстПодсказки", "");
	
