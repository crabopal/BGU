	ТекстыЗапросов.Вставить("ВходящийНДСКРаспределению", "
		|////////////////////////////////////////////////////////////////////////////////
		|// Регистр накопления ВходящийНДСКРаспределению
		|//
		|ВЫБРАТЬ
		|	// Выбираем все поля, кроме поля Сторно
