#Область ПрограммныйИнтерфейс

#Область ПроверкаЗаполнения

Процедура ПроверитьДопустимостьВычетаНалогаПоСчетуФактуре(Знач ДокументОбъект, Знач ИмяРеквизитаНаДату, Отказ) Экспорт
	
	Организация = ДокументОбъект.Организация;
	НаДату = ДокументОбъект[ИмяРеквизитаНаДату];
	
	Если Не ЗначениеЗаполнено(Организация) Или Не ЗначениеЗаполнено(НаДату) Тогда
		Возврат;
	КонецЕсли;
	
	НастройкиУчетаНДС = УчетНДС.ПолучитьНастройкиУчетаНДСУчреждения(Организация, НаДату);
	
	УчетнаяПолитика = НастройкиУчетаНДС.УчетнаяПолитика;
	
	Если НастройкиУчетаНДС.РазрешенВычетНалога Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из ДокументОбъект.СоставНФА Цикл
		Если Не СтрокаТаблицы.НДСКВычету Тогда
			Продолжить;
		КонецЕсли;
		
		Отказ = Истина;
		
		ТекстШаблон = НСтр("ru='Не допускается вычет налога. %1'");
		
		Если УчетнаяПолитика.НДСПрименяетсяОсвобождениеОтУплаты Тогда
			Пояснение = НСтр("ru='Учреждение применяет освобождение от уплаты НДС (см. учетную политику учреждения).'");
			
		ИначеЕсли УчетнаяПолитика.ПрименяетсяУСН Тогда
			Пояснение = СтрШаблон(
				НСтр("ru='Учреждение применяет УСН и выбрало ставку НДС %1 (см. учетную политику учреждения).'"),
				НастройкиУчетаНДС.СтавкаНДСПоУмолчаниюПриУСН);
		Иначе
			Пояснение = "";
		КонецЕсли;
		
		ТекстСообщения = СтрШаблон(ТекстШаблон, Пояснение);
		
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
			ДокументОбъект.Ссылка,
			"Объект." + ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СоставНФА", СтрокаТаблицы.НомерСтроки, "НДСКВычету"));
		
		Возврат;
	КонецЦикла;
	
КонецПроцедуры

// Предназначено для проверки корректировочных счетов-фактур.
Процедура ПроверитьНеизменностьСтавокНалога(ДокументОбъект, Отказ) Экспорт
	
	Для Каждого СтрокаТаблицы Из ДокументОбъект.СоставНФА Цикл
		Если СтрокаТаблицы.СтавкаНДС = СтрокаТаблицы.СтавкаНДСДоИзменения Тогда
			Продолжить;
		КонецЕсли;
		
		НомерСтроки = СтрокаТаблицы.НомерСтроки;
		
		ИндексСтрокиТекст = ИнвентаризацияСервер.ФорматироватьИндексСтрокиТаблицыДляВыводаСообщения(НомерСтроки - 1);
		
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Колонка",
			"Корректность",
			НСтр("ru='Ставка НДС'"),
			НомерСтроки,
			НСтр("ru='Товары, работы, услуги'"),
			НСтр("ru='Законодательством не предусмотрено изменение ставки.'"));
		
		ОбщегоНазначения.СообщитьПользователю(
			ТекстСообщения,
			ДокументОбъект.Ссылка,
			"Объект.СоставНФА[" + ИндексСтрокиТекст + "].СтавкаНДС",
			,
			Отказ);
	КонецЦикла;
	
КонецПроцедуры

// Ставка должна быть заполнена, если заполнено хотя бы одно поле суммы
Процедура ПроверитьЗаполненностьСтавокВИндивидуальныхКолонках(Знач ПроверяемаяТаблица, Знач ИмяТаблицы, Знач ЗаполнитьВалютныеСуммы, ЕстьОшибкиЗаполнения) Экспорт
	
	// Для показателей ставок 20% и 18% предусмотрены одни и те же колонки табличной части с наименованием "18".
	ОбозначенияСтавок = СтрРазделить("18,10,7,5", ",", Ложь);
	
	ИндивидуальныеКолонки = Новый Массив();
	
	Для Каждого ОбозначениеСтавки Из ОбозначенияСтавок Цикл
		ПоляСумм = Новый Массив();
		ПоляСумм.Добавить(СтрШаблон("Сумма%1", ОбозначениеСтавки));
		ПоляСумм.Добавить(СтрШаблон("СуммаНДС%1", ОбозначениеСтавки));
		Если ЗаполнитьВалютныеСуммы Тогда
			ПоляСумм.Добавить(СтрШаблон("Сумма%1Валютная", ОбозначениеСтавки));
			ПоляСумм.Добавить(СтрШаблон("СуммаНДС%1Валютная", ОбозначениеСтавки));
		КонецЕсли;
		
		ОписаниеИндивидуальныхКолонок = Новый Структура();
		ОписаниеИндивидуальныхКолонок.Вставить("ПолеСтавки",	СтрШаблон("СтавкаНДС%1", ОбозначениеСтавки));
		ОписаниеИндивидуальныхКолонок.Вставить("ПоляСумм",		ПоляСумм);
		ИндивидуальныеКолонки.Добавить(ОписаниеИндивидуальныхКолонок);
	КонецЦикла;
	
	НомерСтроки = 0;
	
	Для Каждого СтрокаТаблицы Из ПроверяемаяТаблица Цикл
		НомерСтроки = НомерСтроки + 1;
		Для Каждого ОписаниеИндивидуальныхКолонок Из ИндивидуальныеКолонки Цикл
			ПолеСтавки = ОписаниеИндивидуальныхКолонок["ПолеСтавки"];
			
			ЕстьЗаполненнаяСумма = Ложь;
			Для Каждого ПолеСуммы Из ОписаниеИндивидуальныхКолонок["ПоляСумм"] Цикл
				Если ЗначениеЗаполнено(СтрокаТаблицы[ПолеСуммы]) Тогда
					ЕстьЗаполненнаяСумма = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если ЕстьЗаполненнаяСумма И НЕ ЗначениеЗаполнено(СтрокаТаблицы[ПолеСтавки]) Тогда
				ЕстьОшибкиЗаполнения = Истина;
				
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru='Не заполнено поле ""%1"" (таблица ""%2"", строка %3)'"),
					ПолеСтавки,
					ИмяТаблицы,
					НомерСтроки);
					
				ИндексСтрокиТекст = Формат(НомерСтроки - 1, "ЧГ=0");
				
				ОбщегоНазначения.СообщитьПользователю(
					ТекстСообщения,
					, //ОбъектСсылка,
					"Объект." + ИмяТаблицы + "[" + ИндексСтрокиТекст + "]." + ПолеСтавки);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Функция НайтиДублиСтрок(ПроверяемаяТаблица, КоллекцияИменКолонок) Экспорт
	
	Перем	СтруктураИменКолонок;
	
	ТипНомерСтроки = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(7, 0));
	
	// Возвращаемое значение:
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("НомерСтроки",		ТипНомерСтроки);
	Результат.Колонки.Добавить("НомераСтрокДублей",	Новый ОписаниеТипов("Массив"));
	
	// Входная проверка.
	// Приводим параметры к ожидаемому типу:
	Если ТипЗнч(КоллекцияИменКолонок) = Тип("Структура") Тогда
		СтруктураИменКолонок = КоллекцияИменКолонок;
	ИначеЕсли ТипЗнч(КоллекцияИменКолонок) = Тип("Массив") Тогда
		СтруктураИменКолонок = Новый Структура();
		Для Каждого Элем Из КоллекцияИменКолонок Цикл
			СтруктураИменКолонок.Вставить(Элем);
		КонецЦикла;
	ИначеЕсли ТипЗнч(КоллекцияИменКолонок) = Тип("Строка") Тогда
		СтруктураИменКолонок = Новый Структура(КоллекцияИменКолонок);
	КонецЕсли;
	
	НомерСтроки = 0;
	ТаблицаНомераСтрокДублей = Новый ТаблицаЗначений;
	ТаблицаНомераСтрокДублей.Колонки.Добавить("НомерСтроки", ТипНомерСтроки);
	Для Каждого СтрокаТаблицы Из ПроверяемаяТаблица Цикл
		НомерСтроки = НомерСтроки + 1;
		
		ЗаполнитьЗначенияСвойств(СтруктураИменКолонок, СтрокаТаблицы);
		МассивСтрокДублей = ПроверяемаяТаблица.НайтиСтроки(СтруктураИменКолонок);
		Если МассивСтрокДублей.Количество() > 1 Тогда
			ТаблицаНомераСтрокДублей.Очистить();
			Для Каждого СтрокаДубль Из МассивСтрокДублей Цикл
				НоваяСтрокаДубль = ТаблицаНомераСтрокДублей.Добавить();
				НоваяСтрокаДубль["НомерСтроки"] = ПроверяемаяТаблица.Индекс(СтрокаДубль) + 1;
			КонецЦикла;
			ТаблицаНомераСтрокДублей.Сортировать("НомерСтроки");
			
			// Запоминаем номера строк обнаруженных дублей:
			НоваяСтрока = Результат.Добавить();
			НоваяСтрока["НомерСтроки"]			= НомерСтроки;
			НоваяСтрока["НомераСтрокДублей"]	= ТаблицаНомераСтрокДублей.ВыгрузитьКолонку("НомерСтроки");
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ВывестиСообщенияОДубляхСтрок(ТаблицаДублиСтрок, ПараметрыВывода) Экспорт
	
	Перем	ТаблицаИмя,
			ТаблицаПредставление,
			ОбъектСсылка,
			ШаблонСтроки,
			ИмяПоляДляВыводаСообщений;
	
	ПараметрыВывода.Свойство("ТаблицаИмя",					ТаблицаИмя);
	ПараметрыВывода.Свойство("ТаблицаПредставление",		ТаблицаПредставление);
	ПараметрыВывода.Свойство("ОбъектСсылка",				ОбъектСсылка);
	ПараметрыВывода.Свойство("ШаблонСтроки",				ШаблонСтроки);
	ПараметрыВывода.Свойство("ИмяПоляДляВыводаСообщений",	ИмяПоляДляВыводаСообщений);
	
	Если НЕ ЗначениеЗаполнено(ИмяПоляДляВыводаСообщений) Тогда
		ИмяПоляДляВыводаСообщений = "НомерСтроки";
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ШаблонСтроки) Тогда
		Если ЗначениеЗаполнено(ТаблицаПредставление) Тогда
			ШаблонСтроки = НСтр("ru='Обнаружены дубли строк (таблица ""[ТаблицаПредставление]"", строки [НомераСтрок])'");
		Иначе
			ШаблонСтроки = НСтр("ru='Обнаружены дубли строк (строки [НомераСтрок])'");
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОбъектСсылка) Тогда
		ПолеТаблицы = "Объект." + ТаблицаИмя;
	Иначе
		ПолеТаблицы = ТаблицаИмя;
	КонецЕсли;
	
	ВставляемыеЗначения = Новый Структура();
	ВставляемыеЗначения.Вставить("ТаблицаПредставление", ТаблицаПредставление);
	Для Каждого СтрокаТаблицы Из ТаблицаДублиСтрок Цикл
		НомерСтроки			= СтрокаТаблицы["НомерСтроки"];
		НомераСтрокДублей	= СтрокаТаблицы["НомераСтрокДублей"];
		Если НомерСтроки = НомераСтрокДублей[0] Тогда
			Продолжить; // не выводим сообщение для самой первой строки дубля
		КонецЕсли;
		
		ВставляемыеЗначения.Вставить("НомераСтрок", СтрСоединить(НомераСтрокДублей, ", "));
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонСтроки, ВставляемыеЗначения);
		
		ИндексСтрокиТекст = Формат(НомерСтроки - 1, "ЧГ=0");
		
		ОбщегоНазначения.СообщитьПользователю(
			ТекстСообщения,
			ОбъектСсылка,
			ПолеТаблицы + "[" + ИндексСтрокиТекст + "]." + ИмяПоляДляВыводаСообщений);
	КонецЦикла;
	
КонецПроцедуры

Процедура ВывестиСообщенияОПревышенииОстатков(ТаблицаПревышения, ПараметрыВывода) Экспорт
	
	Перем	ТаблицаИмя,
			ТаблицаПредставление,
			ОбъектСсылка,
			ЗаменаКолонок;
	
	ПараметрыВывода.Свойство("ТаблицаИмя",				ТаблицаИмя);
	ПараметрыВывода.Свойство("ТаблицаПредставление",	ТаблицаПредставление);
	ПараметрыВывода.Свойство("ОбъектСсылка",			ОбъектСсылка);
	ПараметрыВывода.Свойство("ЗаменаКолонок",			ЗаменаКолонок);
	
	ТекстШаблон = НСтр("ru='Превышен остаток %1 (таблица ""%2"" строка %3)'");
	
	Для Каждого СтрокаПревышение Из ТаблицаПревышения Цикл
		ИндексСтроки	= СтрокаПревышение["НомерСтроки"] - 1;
		Превышения		= СтрокаПревышение["Превышения"];
		
		// Имя поля для вывода сообщения:
		ИмяПоляДляВыводаСообщений = Превышения[0]["ИмяКолонки"];
		Если ЗначениеЗаполнено(ЗаменаКолонок) Тогда
			Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЗаменаКолонок, ИмяПоляДляВыводаСообщений) Тогда
				ЗаменаИмени = ЗаменаКолонок[ИмяПоляДляВыводаСообщений];
				Если ЗначениеЗаполнено(ЗаменаИмени) Тогда
					ИмяПоляДляВыводаСообщений = ЗаменаИмени;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		ОписаниеПревышения = "";
		ТекстПоказательШаблон = "%1 на %2";
		Для Каждого ДетальнаяСтрока Из Превышения Цикл
			ТекстПоказатель = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстПоказательШаблон,
				ДетальнаяСтрока["ИмяКолонки"],
				Формат(ДетальнаяСтрока["Превышение"], "ЧДЦ=2"));
			ОписаниеПревышения = ОписаниеПревышения
				+ ?(ОписаниеПревышения = "", "", "; ")
				+ ТекстПоказатель;
		КонецЦикла;
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстШаблон,
			ОписаниеПревышения,
			ТаблицаПредставление,
			ИндексСтроки + 1);
			
		ИндексСтрокиТекст = Формат(ИндексСтроки, "ЧГ=0");
		
		ОбщегоНазначения.СообщитьПользователю(
			ТекстСообщения,
			ОбъектСсылка,
			"Объект." + ТаблицаИмя + "[" + ИндексСтрокиТекст + "]." + ИмяПоляДляВыводаСообщений);
	КонецЦикла;
		
КонецПроцедуры

Процедура ВывестиСообщенияОПревышенииОстатков_ТаблицаСИндивидуальнымиКолонкамиНДС(ТаблицаПревышенияСОбщимиКолонкамиНДС, ПроверяемаяТаблицаСОбщимиКолонкамиНДС, ПроверяемаяТаблицаСИндивидуальнымиКолонкамиНДС, КоллекцияИменКолонокСвязи, ПараметрыВывода) Экспорт
	
	Перем	ТаблицаИмя,
			ТаблицаПредставление,
			ОбъектСсылка,
			ЗаменаКолонок;
	
	ПараметрыВывода.Свойство("ТаблицаИмя",				ТаблицаИмя);
	ПараметрыВывода.Свойство("ТаблицаПредставление",	ТаблицаПредставление);
	ПараметрыВывода.Свойство("ОбъектСсылка",			ОбъектСсылка);
	ПараметрыВывода.Свойство("ЗаменаКолонок",			ЗаменаКолонок);
	
	СоответствиеИменКолонок = Новый Соответствие(); // для перевода Общие колонки --> Индивидуальные
	// Без НДС:
	ВремСоответствие = Новый Соответствие();
	ВремСоответствие.Вставить("СуммаБезНДС",			"СуммаБН");
	ВремСоответствие.Вставить("СуммаБезНДСВалютная",	"СуммаБНВалютная");
	СоответствиеИменКолонок.Вставить(Перечисления.СтавкиНДС.БезНДС,		ВремСоответствие);
	// 0%:
	ВремСоответствие = Новый Соответствие();
	ВремСоответствие.Вставить("СуммаБезНДС",			"Сумма0");
	ВремСоответствие.Вставить("СуммаБезНДСВалютная",	"Сумма0Валютная");
	СоответствиеИменКолонок.Вставить(Перечисления.СтавкиНДС.НДС0,		ВремСоответствие);
	// 5%, 5/105:
	ВремСоответствие = Новый Соответствие();
	ВремСоответствие.Вставить("СуммаБезНДС",			"Сумма5");
	ВремСоответствие.Вставить("СуммаНДС",				"СуммаНДС5");
	ВремСоответствие.Вставить("СуммаБезНДСВалютная",	"Сумма5Валютная");
	ВремСоответствие.Вставить("СуммаНДСВалютная",		"СуммаНДС5Валютная");
	СоответствиеИменКолонок.Вставить(Перечисления.СтавкиНДС.НДС5,		ВремСоответствие);
	СоответствиеИменКолонок.Вставить(Перечисления.СтавкиНДС.НДС5_105,	ВремСоответствие);
	// 7%, 7/107:
	ВремСоответствие = Новый Соответствие();
	ВремСоответствие.Вставить("СуммаБезНДС",			"Сумма7");
	ВремСоответствие.Вставить("СуммаНДС",				"СуммаНДС7");
	ВремСоответствие.Вставить("СуммаБезНДСВалютная",	"Сумма7Валютная");
	ВремСоответствие.Вставить("СуммаНДСВалютная",		"СуммаНДС7Валютная");
	СоответствиеИменКолонок.Вставить(Перечисления.СтавкиНДС.НДС7,		ВремСоответствие);
	СоответствиеИменКолонок.Вставить(Перечисления.СтавкиНДС.НДС7_107,	ВремСоответствие);
	// 10%, 10/110:
	ВремСоответствие = Новый Соответствие();
	ВремСоответствие.Вставить("СуммаБезНДС",			"Сумма10");
	ВремСоответствие.Вставить("СуммаНДС",				"СуммаНДС10");
	ВремСоответствие.Вставить("СуммаБезНДСВалютная",	"Сумма10Валютная");
	ВремСоответствие.Вставить("СуммаНДСВалютная",		"СуммаНДС10Валютная");
	СоответствиеИменКолонок.Вставить(Перечисления.СтавкиНДС.НДС10,		ВремСоответствие);
	СоответствиеИменКолонок.Вставить(Перечисления.СтавкиНДС.НДС10_110,	ВремСоответствие);
	// 18%, 18/118, 20%, 20/120:
	ВремСоответствие = Новый Соответствие();
	ВремСоответствие.Вставить("СуммаБезНДС",			"Сумма18");
	ВремСоответствие.Вставить("СуммаНДС",				"СуммаНДС18");
	ВремСоответствие.Вставить("СуммаБезНДСВалютная",	"Сумма18Валютная");
	ВремСоответствие.Вставить("СуммаНДСВалютная",		"СуммаНДС18Валютная");
	СоответствиеИменКолонок.Вставить(Перечисления.СтавкиНДС.НДС18,		ВремСоответствие);
	СоответствиеИменКолонок.Вставить(Перечисления.СтавкиНДС.НДС18_118,	ВремСоответствие);
	СоответствиеИменКолонок.Вставить(Перечисления.СтавкиНДС.НДС20,		ВремСоответствие);
	СоответствиеИменКолонок.Вставить(Перечисления.СтавкиНДС.НДС20_120,	ВремСоответствие);
	
	// 22%, 22/122:
	ВремСоответствие = Новый Соответствие();
	ВремСоответствие.Вставить("СуммаБезНДС",			"Сумма22");
	ВремСоответствие.Вставить("СуммаНДС",				"СуммаНДС22");
	ВремСоответствие.Вставить("СуммаБезНДСВалютная",	"Сумма22Валютная");
	ВремСоответствие.Вставить("СуммаНДСВалютная",		"СуммаНДС22Валютная");
	СоответствиеИменКолонок.Вставить(Перечисления.СтавкиНДС.НДС22,		ВремСоответствие);
	СоответствиеИменКолонок.Вставить(Перечисления.СтавкиНДС.НДС22_122,	ВремСоответствие);
	
	// Выводим сообщения:	
	ШаблонТекстСообщения = НСтр("ru='Превышен остаток %1 (таблица ""%2"" строка %3)'");
	КоллекцияИменКолонокСвязи.Удалить("СтавкаНДС"); // убираем, эта колонка отсутствует в ПроверяемаяТаблицаСИндивидуальнымиКолонкамиНДС
	Для Каждого СтрокаПревышение Из ТаблицаПревышенияСОбщимиКолонкамиНДС Цикл
		// Определим соответствующую строку в таблице "Покупка"
		// (с индивидуальными колонками НДС):
		СтрокаТаблицыОбщиеКолонкиНДС = ПроверяемаяТаблицаСОбщимиКолонкамиНДС[СтрокаПревышение["НомерСтроки"] - 1];
		ЗаполнитьЗначенияСвойств(КоллекцияИменКолонокСвязи, СтрокаТаблицыОбщиеКолонкиНДС);
		МассивСтрок = ПроверяемаяТаблицаСИндивидуальнымиКолонкамиНДС.НайтиСтроки(КоллекцияИменКолонокСвязи);
		Если МассивСтрок.Количество() = 0 Тогда
			// Невозможный случай, но все же.
			ИндексСтроки = 0;
		Иначе
			ИндексСтроки = ПроверяемаяТаблицаСИндивидуальнымиКолонкамиНДС.Индекс(МассивСтрок[0]);
		КонецЕсли;
		
		ОписаниеПревышения = "";
		ШаблонТекстаПоказатель = "%1 на %2";
		Превышения = СтрокаПревышение["Превышения"];
		ИмяПоляДляВыводаСообщений = СоответствиеИменКолонок.Получить(
			СтрокаТаблицыОбщиеКолонкиНДС["СтавкаНДС"]).Получить(Превышения[0]["ИмяКолонки"]);
		Если НЕ ЗначениеЗаполнено(ИмяПоляДляВыводаСообщений) Тогда
			ИмяПоляДляВыводаСообщений = "Всего";
		КонецЕсли;
		Для Каждого ДетальнаяСтрока Из Превышения Цикл
			ТекстПоказатель = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонТекстаПоказатель,
				ДетальнаяСтрока["ИмяКолонки"],
				Формат(ДетальнаяСтрока["Превышение"], "ЧДЦ=2"));
			ОписаниеПревышения = ОписаниеПревышения
				+ ?(ОписаниеПревышения = "", "", "; ")
				+ ТекстПоказатель;
		КонецЦикла;
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонТекстСообщения,
			ОписаниеПревышения,
			ТаблицаПредставление,
			ИндексСтроки + 1);
			
		ИндексСтрокиТекст = Формат(ИндексСтроки, "ЧГ=0");
		
		ОбщегоНазначения.СообщитьПользователю(
			ТекстСообщения,
			ОбъектСсылка,
			"Объект." + ТаблицаИмя + "[" + ИндексСтрокиТекст + "]." + ИмяПоляДляВыводаСообщений);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОпределениеПризнаков

// Определяет признак того, что исходный счет-фактура является корректировочным.
// Исходный счет-фактура указывается в корректировочных и исправительных счетах-фактурах в реквизите ИсправляемыйДокумент.
// Если исходный счет-фактура известен заранее, его можно передать в параметре ИсправляемыйДокумент, в этом случае
// первый параметр ДокументСсылка игнорируется как второстепенный.
// Если исходный счет-фактура неизвестен, то он будет определен по указанной ссылке проверяемого счета-фактуры.
//
// Параметры:
//	ДокументСсылка - Ссылка - ссылка на проверяемый счет-фактуру (выданный/полученный, обычный/корректировочный/исправительный).
//		Определяет документ в цепочке счетов-фактур, начиная с которого будет выполнен поиск исходного счета-фактуры
//		в сторону корня дерева.
//		Необязательный параметр. Если не указан, то применяется параметр ИсправляемыйДокумент, который становится обязательным.
//
//	ИсправляемыйДокумент - Ссылка - ссылка на исходный счет-фактуру (выданный/полученный, обычный/корректировочный).
//		Параметр указывается, если такой исходный счет-фактура известен заранее.
//		Например, уже определен реквизит ИсправляемыйДокумент у корректировочного или исправительного счета-фактуры.
//		Указание этого параметра позволяет ускорить выполнение этой функции, поскольку не потребуется
//		чтения реквизита ИсправляемыйДокумент у проверяемого счета-фактуры.
//		Необязательный параметр. Если не указан, то применяется параметр ДокументСсылка, который становится обязательным.
//
// Возвращаемоее значение:
//	Булево - признак того, что исходный счет-фактура является корректировочным.
//	При указании пустых параметров невозможно определить исходный счет-фактуру, поэтому выполняется защитный возврат Ложь.
Функция ЭтоКорректировка(ДокументСсылка = Неопределено, ИсправляемыйДокумент = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(ДокументСсылка) И Не ЗначениеЗаполнено(ИсправляемыйДокумент) Тогда
		Возврат Ложь; // Защитный возврат при отсутствии обоих параметров.
	КонецЕсли;
	
	Если ИсправляемыйДокумент <> Неопределено Тогда
		Возврат ЭтоКорректировкаПоИсправляемомуДокументу(ИсправляемыйДокумент);
	КонецЕсли;
	
	ТипСсылки = ТипЗнч(ДокументСсылка);
	
	Если ТипСсылки = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный")
		Или ТипСсылки = Тип("ДокументСсылка.ИсправительныйСчетФактураПолученный") Тогда
		
		ИсправляемыйДокумент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "ИсправляемыйДокумент");
		
		Возврат ЭтоКорректировкаПоИсправляемомуДокументу(ИсправляемыйДокумент);
		
	ИначеЕсли ТипСсылки = Тип("ДокументСсылка.КорректировочныйСчетФактураВыданный")
		Или ТипСсылки = Тип("ДокументСсылка.КорректировочныйСчетФактураПолученный") Тогда
		
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ЭтоРеализацияШкурЛома(Параметр) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Параметр) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(Параметр) = Тип("СправочникСсылка.Договоры") Тогда
		
		ТипДоговораНДС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметр, "ТипДоговораНДС");
		
		Возврат (ТипДоговораНДС = Перечисления.ТипыДоговоровДляНДС.РеализацияЛомаШкур);
		
	ИначеЕсли ТипЗнч(Параметр) = Тип("ПеречислениеСсылка.ПричиныНалогообложенияНДС") Тогда
		
		Возврат УчетНДСПовтИсп.ШкурыЛом(Параметр);
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ПолучитьВидСчетаФактурыПоДоговору(ДоговорСсылка) Экспорт
	
	Перем ТипДоговораНДС;
	
	Если ЗначениеЗаполнено(ДоговорСсылка) Тогда
		ТипДоговораНДС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДоговорСсылка, "ТипДоговораНДС");
	КонецЕсли;
	
	Если	ТипДоговораНДС = Перечисления.ТипыДоговоровДляНДС.АгентскийДоговор ИЛИ
			ТипДоговораНДС = Перечисления.ТипыДоговоровДляНДС.АгентскийДоговорНерезидент ТОГДА
		Результат = "СчетФактураВыданный";
		
	Иначе
		Результат = "СчетФактураПолученный";
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возврат:
//	Структура с полями:
//	* ДатаНачала						- Дата
//	* ДатаОкончания						- Дата
//	* НалоговыйПериод					- Перечисления.Периодичность
//	* ПериодПредставление				- Строка
//	* ПериодПредставлениеСокращенное	- Строка
//	* ПериодПредставлениеДиапазон		- Строка
Функция ПолучитьСвойстваНалоговогоПериода(Организация, Дата) Экспорт
	
	Результат = Новый Структура();
	
	Если ЗначениеЗаполнено(Дата) Тогда
		УчетнаяПолитика = Справочники.Организации.ПолучитьУчетнуюПолитику(Организация, Дата);
		
		НалоговыйПериод = УчетнаяПолитика.НДСНалоговыйПериод;
		Если НалоговыйПериод = Перечисления.Периодичность.Месяц Тогда
			ДатаНачала		= НачалоМесяца(Дата);
			ДатаОкончания 	= КонецМесяца(Дата);
			ПериодПредставлениеСокращенное = Формат(Дата, "ДФ=МММ") + " " + Формат(Дата, "ДФ=гггг");
		Иначе	
			ДатаНачала		= НачалоКвартала(Дата);
			ДатаОкончания	= КонецКвартала(Дата);
			ПериодПредставлениеСокращенное = Формат(Дата, "ДФ=к") + " кв " + Формат(Дата, "ДФ=гггг");
		КонецЕсли;
		
		ПериодПредставление = ПредставлениеПериода(ДатаНачала, ДатаОкончания, "ФП");
		
		ТекстШаблона = НСтр("ru='%1 - %2'");
		ПериодПредставлениеДиапазон = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстШаблона,
			Формат(ДатаНачала,		"ДФ=""дд.ММ"""),
			Формат(ДатаОкончания,	"ДФ=""дд.ММ"""));
	Иначе
		ДатаНачала						= Дата;
		ДатаОкончания					= Дата;
		НалоговыйПериод					= Неопределено;
		ПериодПредставление				= НСтр("ru='<дата не заполнена>'");
		ПериодПредставлениеСокращенное	= "";
		ПериодПредставлениеДиапазон		= "";
	КонецЕсли;
	
	Результат.Вставить("ДатаНачала",						ДатаНачала);
	Результат.Вставить("ДатаОкончания",						ДатаОкончания);
	Результат.Вставить("НалоговыйПериод",					НалоговыйПериод);
	Результат.Вставить("ПериодПредставление",				ПериодПредставление);
	Результат.Вставить("ПериодПредставлениеСокращенное",	ПериодПредставлениеСокращенное);
	Результат.Вставить("ПериодПредставлениеДиапазон",		ПериодПредставлениеДиапазон);
	
	Возврат Результат;
	
КонецФункции

Функция КонтрагентНеПлательщикНДС(Контрагент) Экспорт
	
	Если ТипЗнч(Контрагент) = Тип("Структура") Тогда
		ДанныеКонтра = Контрагент;
	Иначе
		ДанныеКонтра = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Контрагент, "ВидКонтрагента, ОсобенностьНалогообложенияНДС");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеКонтра.ОсобенностьНалогообложенияНДС) Тогда
		Плательщик = (ДанныеКонтра.ОсобенностьНалогообложенияНДС = Перечисления.ОсобенностиНалогообложенияНДС.НалогоплательщикНДС);
	Иначе
		Плательщик = (ДанныеКонтра.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо);
	КонецЕсли;
	
	Возврат НЕ Плательщик;
	
КонецФункции	

Функция ПолучитьДатуНачалаПрименения64н(Знач Организация) Экспорт
	
	Перем ДатаНачалаПрименения;
	
	ЗначениеПоУмолчанию = '20190101';
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.Текст = 
		"ВЫБРАТЬ
		|	ДатыПереходаНаПрименениеРедакцийПС.ДатаНачалаПрименения КАК ДатаНачалаПрименения
		|ИЗ
		|	РегистрСведений.ДатыПереходаНаПрименениеРедакцийПС КАК ДатыПереходаНаПрименениеРедакцийПС
		|ГДЕ
		|	ДатыПереходаНаПрименениеРедакцийПС.Организация = &Организация
		|	И ДатыПереходаНаПрименениеРедакцийПС.РедакцияПС = &РедакцияПС";
	
	ЗапросПоиск.УстановитьПараметр("Организация",	Организация);
	ЗапросПоиск.УстановитьПараметр("РедакцияПС",	Перечисления.РедакцииПланаСчетов.Приказ64н2018);
	
	Выборка = ЗапросПоиск.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ДатаНачалаПрименения = Выборка.ДатаНачалаПрименения;
	КонецЦикла;
	
	Если НЕ ЗначениеЗаполнено(ДатаНачалаПрименения) Тогда
		ДатаНачалаПрименения = ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Возврат ДатаНачалаПрименения;
	
КонецФункции

Функция ПолучитьДатуОкончанияИгнорированияДокументовРасчетов(Знач Организация) Экспорт
	
	// Возвращает наибольшую из дат:
	//  - переход на 64н
	//  - перенос данных из БГУ1
	
	ДатаПерехода64н = УчетНДС.ПолучитьДатуНачалаПрименения64н(Организация);
	
	ДатаПереносаБГУ1 = '00010101';
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("Организация", Организация);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ
	|	ДатаВводаНачальныхОстатков	КАК Дата
	|ИЗ
	|	РегистрСведений.ДатыВводаНачальныхОстатков
	|ГДЕ
	|	Организация = &Организация
	|;";
	
	УстановитьПривилегированныйРежим(Истина);
	
	Выборка = ЗапросПоиск.Выполнить().Выбрать();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Если Выборка.Следующий() Тогда
		
		// Игнорируется документ при условии ДатаДокумента < ДатаИгнорирования.
		
		// Добавляем одни сутки для того, чтобы документы расчетов, перенесенные вводом остатков,
		// и изначально созданные в день переноса из БГУ1, подпадали под игнорирование.
		
		КоличествоСекундВСутках = 24*60*60;
		
		ДатаПереносаБГУ1 = Выборка.Дата + КоличествоСекундВСутках;
		
	КонецЕсли;
	
	Возврат Макс(ДатаПерехода64н, ДатаПереносаБГУ1);
	
КонецФункции

Функция СледуетНачислитьНДССразу(СтруктураПараметров) Экспорт
	
	ПричинаНалогообложения	= СтруктураПараметров["ПричинаНалогообложения"];
	СуммаНДС				= СтруктураПараметров["СуммаНДС"];
	
	Возврат (УчетНДСПовтИсп.НачислениеСразу(ПричинаНалогообложения) И НЕ СуммаНДС = 0);
	
КонецФункции

Функция СледуетНачислитьНДССразуНалогоплательщик(СтруктураПараметров) Экспорт
	
	ПричинаНалогообложения	= СтруктураПараметров["ПричинаНалогообложения"];
	
	Если УчетНДСПовтИсп.НалоговыйАгент(ПричинаНалогообложения) Тогда
		Результат = Ложь;
	Иначе
		Результат = УчетНДС.СледуетНачислитьНДССразу(СтруктураПараметров);
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

Функция СледуетНачислитьНДССразуНалоговыйАгент(СтруктураПараметров) Экспорт
	
	ПричинаНалогообложения	= СтруктураПараметров["ПричинаНалогообложения"];
	
	Если УчетНДСПовтИсп.НалоговыйАгент(ПричинаНалогообложения) Тогда
		Результат = УчетНДС.СледуетНачислитьНДССразу(СтруктураПараметров);
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

