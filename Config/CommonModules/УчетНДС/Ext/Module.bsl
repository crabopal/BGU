// ОбозначенияРазделов	- Строка	- одно или несколько(через запятую) значений "8", "8.1", "9", "9.1", "12"
Процедура СегментацияДанныхДекларации_ИнициализироватьПараметры(ПараметрыОтчета, ОбозначенияРазделов) Экспорт
	
	Перем	СегментацияДанныхДекларации,	// Возвращаемое значение
			ПредельноеКоличествоЗаписейВРазделеДекларацииПоНДС;
	
	Если НЕ ПараметрыОтчета.Свойство("СегментацияДанныхДекларации", СегментацияДанныхДекларации) Тогда
		СегментацияДанныхДекларации = Новый Структура();
	КонецЕсли;
	
	ПараметрыОтчета.Свойство("ПредельноеКоличествоЗаписейВРазделеДекларацииПоНДС", ПредельноеКоличествоЗаписейВРазделеДекларацииПоНДС);
	Если НЕ (ТипЗнч(ПредельноеКоличествоЗаписейВРазделеДекларацииПоНДС) = Тип("Число")
			И ЗначениеЗаполнено(ПредельноеКоличествоЗаписейВРазделеДекларацииПоНДС)) Тогда
		ПредельноеКоличествоЗаписейВРазделеДекларацииПоНДС = Константы.ПредельноеКоличествоЗаписейВРазделеДекларацииПоНДС.Получить();
		Если НЕ ЗначениеЗаполнено(ПредельноеКоличествоЗаписейВРазделеДекларацииПоНДС) Тогда
			ПредельноеКоличествоЗаписейВРазделеДекларацииПоНДС = 50000; // значение по умолчанию
		КонецЕсли;
	КонецЕсли;
	
	МассивОбозначений = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(ОбозначенияРазделов, ", 	");
	Для Каждого ОбозначениеРаздела Из МассивОбозначений Цикл
		ТекущийСегмент = Новый Структура();
		ТекущийСегмент.Вставить("НомерСегмента",						1);
		ТекущийСегмент.Вставить("ПерваяСтрокаТабличногоДокумента",		1);
		ТекущийСегмент.Вставить("ПоследняяСтрокаТабличногоДокумента",	0);
		ТекущийСегмент.Вставить("ПерваяСтрокаТаблицыДанныхРаздела",		1);
		ТекущийСегмент.Вставить("ПоследняяСтрокаТаблицыДанныхРаздела",	0);
		ТекущийСегмент.Вставить("КоличествоСтрокТабличногоДокумента",	0);
		ТекущийСегмент.Вставить("КоличествоСтрокТаблицыДанныхРаздела",	0);
		ТекущийСегмент.Вставить("КоличествоСтрокТаблицы",				0);
		ТекущийСегмент.Вставить("ВывестиОбозначениеГрафТаблицы",		Ложь);
		
		ПредыдущиеСегменты = Новый Структура();
		ПредыдущиеСегменты.Вставить("КоличествоСтрокТабличногоДокумента",	0);
		ПредыдущиеСегменты.Вставить("КоличествоСтрокТаблицыДанныхРаздела",	0);
		
		СегментацияДанныхРаздела = Новый Структура();
		СегментацияДанныхРаздела.Вставить("ТекущийСегмент",										ТекущийСегмент);
		СегментацияДанныхРаздела.Вставить("ПредыдущиеСегменты",									ПредыдущиеСегменты);
		СегментацияДанныхРаздела.Вставить("КоличествоСтрокТаблицы",								0);
		СегментацияДанныхРаздела.Вставить("ОбщееКоличествоСтрокТаблицы",						0);
		СегментацияДанныхРаздела.Вставить("ПредельноеКоличествоЗаписейВРазделеДекларацииПоНДС",	ПредельноеКоличествоЗаписейВРазделеДекларацииПоНДС);
		
		ОписаниеРаздела = СегментацияДанныхДекларации_ПолучитьОписаниеРаздела(ОбозначениеРаздела);
		
		СегментацияДанныхДекларации.Вставить(ОписаниеРаздела["ИмяВРегламентированнойОтчетности"], СегментацияДанныхРаздела);
	КонецЦикла;
	
	ПараметрыОтчета.Вставить("СегментацияДанныхДекларации", СегментацияДанныхДекларации);
	
КонецПроцедуры

Функция СегментацияДанныхДекларации_ПолучитьОписаниеРаздела(ОбозначениеРаздела) Экспорт
	
	ОписаниеРаздела = Новый Структура();
	
	Если ОбозначениеРаздела = "8" Тогда
		ОписаниеРаздела.Вставить("ИмяВРегламентированнойОтчетности",	"Раздел8");
		ОписаниеРаздела.Вставить("ИмяТаблицыДанных",					"ТаблицаРаздел8");
		ОписаниеРаздела.Вставить("НаименованиеДляВыводаВТабДок",		НСтр("ru='Раздел 8'"));
		ОписаниеРаздела.Вставить("ИмяОбластиШапкаТаблицыМакета",		"Заголовок");
		
	ИначеЕсли ОбозначениеРаздела = "8.1" Тогда
		ОписаниеРаздела.Вставить("ИмяВРегламентированнойОтчетности",	"Раздел8_Прил1");
		ОписаниеРаздела.Вставить("ИмяТаблицыДанных",					"ТаблицаРаздел81");
		ОписаниеРаздела.Вставить("НаименованиеДляВыводаВТабДок",		НСтр("ru='Приложение 1 к разделу 8'"));
		ОписаниеРаздела.Вставить("ИмяОбластиШапкаТаблицыМакета",		"ЗаголовокДопЛист");
		
	ИначеЕсли ОбозначениеРаздела = "9" Тогда
		ОписаниеРаздела.Вставить("ИмяВРегламентированнойОтчетности",	"Раздел9");
		ОписаниеРаздела.Вставить("ИмяТаблицыДанных",					"ТаблицаРаздел9");
		ОписаниеРаздела.Вставить("НаименованиеДляВыводаВТабДок",		НСтр("ru='Раздел 9'"));
		ОписаниеРаздела.Вставить("ИмяОбластиШапкаТаблицыМакета",		"Заголовок");
		
	ИначеЕсли ОбозначениеРаздела = "9.1" Тогда
		ОписаниеРаздела.Вставить("ИмяВРегламентированнойОтчетности",	"Раздел9_Прил1");
		ОписаниеРаздела.Вставить("ИмяТаблицыДанных",					"ТаблицаРаздел91");
		ОписаниеРаздела.Вставить("НаименованиеДляВыводаВТабДок",		НСтр("ru='Приложение 1 к разделу 9'"));
		ОписаниеРаздела.Вставить("ИмяОбластиШапкаТаблицыМакета",		"ЗаголовокДопЛист");
		
	ИначеЕсли ОбозначениеРаздела = "10" Тогда
		ОписаниеРаздела.Вставить("ИмяВРегламентированнойОтчетности",	"Раздел10");
		ОписаниеРаздела.Вставить("ИмяТаблицыДанных",					"ТаблицаРаздел10");
		ОписаниеРаздела.Вставить("НаименованиеДляВыводаВТабДок",		НСтр("ru='Раздел 10'"));
		ОписаниеРаздела.Вставить("ИмяОбластиШапкаТаблицыМакета",		"Заголовок");
		
	ИначеЕсли ОбозначениеРаздела = "11" Тогда
		ОписаниеРаздела.Вставить("ИмяВРегламентированнойОтчетности",	"Раздел11");
		ОписаниеРаздела.Вставить("ИмяТаблицыДанных",					"ТаблицаРаздел11");
		ОписаниеРаздела.Вставить("НаименованиеДляВыводаВТабДок",		НСтр("ru='Раздел 11'"));
		ОписаниеРаздела.Вставить("ИмяОбластиШапкаТаблицыМакета",		"Заголовок");
		
	ИначеЕсли ОбозначениеРаздела = "12" Тогда
		ОписаниеРаздела.Вставить("ИмяВРегламентированнойОтчетности",	"Раздел12");
		ОписаниеРаздела.Вставить("ИмяТаблицыДанных",					"ТаблицаРаздел12");
		ОписаниеРаздела.Вставить("НаименованиеДляВыводаВТабДок",		НСтр("ru='Раздел 12'"));
