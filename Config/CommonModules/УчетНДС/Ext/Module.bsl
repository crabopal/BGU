Функция АвтоустановкаСубконто_ПолучитьМассивСтруктурНастроек_РегистрацияСтрокиКнигиПродаж() Экспорт
	
	МассивСтруктурНастроек = Новый Массив();
	
	// 1. СчетНачислениеДт
	Идентификатор = 1;
	ЗначенияАвтоустановки = Новый Соответствие();
	// Настройки, аналогичные настройкам из метода
	// АвтоустановкаСубконто_ПолучитьТаблицуПараметрыАвтоустановки_РегистрацияСтрокиКнигиПродаж_ВызовНеИзФормы
	//								Вид субконто			Имя элемента или фиксированное значение
	ЗначенияАвтоустановки.Вставить("Контрагенты",			"Контрагент");
	ЗначенияАвтоустановки.Вставить("Договоры",				"Договор");
	ЗначенияАвтоустановки.Вставить("ВидыНалоговИПлатежей",	Справочники.ВидыНалоговИПлатежей.НДС);
	ЗначенияАвтоустановки.Вставить("СФПолученные",			"ДокументОснование");
	ЗависимыеЭлементыАвтоустановки = Новый Структура();
	//										Имя ведущего элемента	Имена зависимых элементов
	ЗависимыеЭлементыАвтоустановки.Вставить("Контрагент",			"Договор");
	СтруктураНастроек = Новый Структура();
	СтруктураНастроек.Вставить("Идентификатор",							Идентификатор);
	СтруктураНастроек.Вставить("Счет",									"СуммыНДССчетНачислениеДт");
	СтруктураНастроек.Вставить("Субконто1",								"СуммыНДССубконто1НачислениеДт");
	СтруктураНастроек.Вставить("Субконто2",								"СуммыНДССубконто2НачислениеДт");
	СтруктураНастроек.Вставить("Субконто3",								"СуммыНДССубконто3НачислениеДт");
	СтруктураНастроек.Вставить("ЗначенияАвтоустановки",					ЗначенияАвтоустановки);
	СтруктураНастроек.Вставить("ЗависимыеЭлементыАвтоустановки",		ЗависимыеЭлементыАвтоустановки);
	СтруктураНастроек.Вставить("ОтмечатьНаличиеВидовСубконтоСтрока",	"СФПолученные");
	МассивСтруктурНастроек.Добавить(СтруктураНастроек);
	
	Возврат МассивСтруктурНастроек;
	
КонецФункции

Функция АвтоустановкаСубконто_ПолучитьТаблицуПараметрыАвтоустановки_СчетФактураВыданный_ВызовНеИзФормы(Объект, ОбслуживаемыеИдентификаторы, ЭтоИнициализацияНовыхКолонокСчетов = Ложь, СчетФактураСсылка = Неопределено) Экспорт
	
	Перем	МассивОбслуживаемыеИдентификаторы,
			ЗаполнитьСубконтоСчетНачислениеДт,
			ЗаполнитьСубконтоСчетВычетКт;
	
	ТаблицаПараметрыАвтоустановки = УчетНДС.АвтоустановкаСубконто_ПолучитьПустуюТаблицуПараметровАвтоустановки_ДляВызоваНеИзФормы();
	
	// Входная проверка
	Если ТипЗнч(ОбслуживаемыеИдентификаторы) = Тип("Массив") Тогда
		МассивОбслуживаемыеИдентификаторы = ОбслуживаемыеИдентификаторы;
	ИначеЕсли ТипЗнч(ОбслуживаемыеИдентификаторы) = Тип("Строка") Тогда
		МассивОбслуживаемыеИдентификаторы = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(ОбслуживаемыеИдентификаторы);
	Иначе
		// Выходим
		Возврат ТаблицаПараметрыАвтоустановки;
	КонецЕсли;
	ЗаполнитьСубконтоСчетНачислениеДт	= НЕ (МассивОбслуживаемыеИдентификаторы.Найти(1) = Неопределено);
	ЗаполнитьСубконтоСчетВычетКт		= НЕ (МассивОбслуживаемыеИдентификаторы.Найти(2) = Неопределено);
	
	ЗначенияАвтоустановки = Новый Соответствие();
	
	// Настройки, аналогичные настройкам из метода
	// АвтоустановкаСубконто_ПолучитьМассивСтруктурНастроек_СчетФактураВыданный
	Если ЭтоИнициализацияНовыхКолонокСчетов = Истина Тогда
		ЗначенияАвтоустановки.Вставить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты,			Объект["Контрагент"]);
		ЗначенияАвтоустановки.Вставить(ПланыВидовХарактеристик.ВидыСубконто.Договоры,				Объект["Договор"]);
		ЗначенияАвтоустановки.Вставить(ПланыВидовХарактеристик.ВидыСубконто.ВидыНалоговИПлатежей,	Справочники.ВидыНалоговИПлатежей.НДС);
	КонецЕсли;
	
	Если ЗаполнитьСубконтоСчетНачислениеДт Тогда
		ЗначениеАвтоустановкиСФПолученные = УчетНДС.СубконтоСФПолученные_ОпределитьЗначениеДляАвтоустановки(Объект, СчетФактураСсылка);
		ЗначенияАвтоустановки.Вставить(ПланыВидовХарактеристик.ВидыСубконто.СФПолученные, ЗначениеАвтоустановкиСФПолученные);
		
		ИменаРеквизитовСчетИСубконто = Новый Структура();
		ИменаРеквизитовСчетИСубконто.Вставить("Счет",		"СчетНачислениеДт");
		ИменаРеквизитовСчетИСубконто.Вставить("Субконто1",	"Субконто1НачислениеДт");
		ИменаРеквизитовСчетИСубконто.Вставить("Субконто2",	"Субконто2НачислениеДт");
		ИменаРеквизитовСчетИСубконто.Вставить("Субконто3",	"Субконто3НачислениеДт");
		
		НоваяСтрока = ТаблицаПараметрыАвтоустановки.Добавить();
		НоваяСтрока["ЗаполняемаяТаблица"]				= Объект["СоставНФА"];
		НоваяСтрока["ИменаРеквизитовСчетИСубконто"]		= ИменаРеквизитовСчетИСубконто;
		НоваяСтрока["СчетЭтоРеквизитТаблицы"]			= Истина;
		НоваяСтрока["ЗначенияАвтоустановки"]			= ЗначенияАвтоустановки;
	КонецЕсли;
	
	// Реквизиты удалены
	//Если ЗаполнитьСубконтоСчетВычетКт Тогда
	//	ИменаРеквизитовСчетИСубконто = Новый Структура();
	//	ИменаРеквизитовСчетИСубконто.Вставить("Счет",		"СчетВычетКт");
	//	ИменаРеквизитовСчетИСубконто.Вставить("Субконто1",	"Субконто1ВычетКт");
	//	ИменаРеквизитовСчетИСубконто.Вставить("Субконто2",	"Субконто2ВычетКт");
	//	ИменаРеквизитовСчетИСубконто.Вставить("Субконто3",	"Субконто3ВычетКт");
	//	
	//	НоваяСтрока = ТаблицаПараметрыАвтоустановки.Добавить();
	//	НоваяСтрока["ЗаполняемаяТаблица"]			= Объект["СоставНФА"];
	//	НоваяСтрока["ИменаРеквизитовСчетИСубконто"]	= ИменаРеквизитовСчетИСубконто;
	//	НоваяСтрока["СчетЭтоРеквизитТаблицы"]		= Истина;
	//	НоваяСтрока["ЗначенияАвтоустановки"]		= ЗначенияАвтоустановки;
	//КонецЕсли;
	
	Возврат ТаблицаПараметрыАвтоустановки;
	
КонецФункции

Функция АвтоустановкаСубконто_ПолучитьТаблицуПараметрыАвтоустановки_РегистрацияСтрокиКнигиПродаж_ВызовНеИзФормы(Объект, ОбслуживаемыеИдентификаторы, ЭтоИнициализацияНовыхКолонокСчетов = Ложь, СчетФактураСсылка = Неопределено) Экспорт
	
	Перем	МассивОбслуживаемыеИдентификаторы,
			ЗаполнитьСубконтоСчетНачислениеДт,
			ЗаполнитьСубконтоСчетВычетКт;
	
	ТаблицаПараметрыАвтоустановки = УчетНДС.АвтоустановкаСубконто_ПолучитьПустуюТаблицуПараметровАвтоустановки_ДляВызоваНеИзФормы();
	
	// Входная проверка
	Если ТипЗнч(ОбслуживаемыеИдентификаторы) = Тип("Массив") Тогда
		МассивОбслуживаемыеИдентификаторы = ОбслуживаемыеИдентификаторы;
	ИначеЕсли ТипЗнч(ОбслуживаемыеИдентификаторы) = Тип("Строка") Тогда
		МассивОбслуживаемыеИдентификаторы = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(ОбслуживаемыеИдентификаторы);
	Иначе
		// Выходим
		Возврат ТаблицаПараметрыАвтоустановки;
	КонецЕсли;
	ЗаполнитьСубконтоСчетНачислениеДт	= НЕ (МассивОбслуживаемыеИдентификаторы.Найти(1) = Неопределено);
	
	ЗначенияАвтоустановки = Новый Соответствие();
	
	// Настройки, аналогичные настройкам из метода
	// АвтоустановкаСубконто_ПолучитьМассивСтруктурНастроек_РегистрацияСтрокиКнигиПродаж
	Если ЭтоИнициализацияНовыхКолонокСчетов = Истина Тогда
		ЗначенияАвтоустановки.Вставить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты,			Объект["Контрагент"]);
		ЗначенияАвтоустановки.Вставить(ПланыВидовХарактеристик.ВидыСубконто.Договоры,				Объект["Договор"]);
		ЗначенияАвтоустановки.Вставить(ПланыВидовХарактеристик.ВидыСубконто.ВидыНалоговИПлатежей,	Справочники.ВидыНалоговИПлатежей.НДС);
		ЗначенияАвтоустановки.Вставить(ПланыВидовХарактеристик.ВидыСубконто.СФПолученные, 			Объект["ДокументОснование"]);
	КонецЕсли;
	
	Если ЗаполнитьСубконтоСчетНачислениеДт Тогда
		ИменаРеквизитовСчетИСубконто = Новый Структура();
		ИменаРеквизитовСчетИСубконто.Вставить("Счет",		"СчетНачислениеДт");
		ИменаРеквизитовСчетИСубконто.Вставить("Субконто1",	"Субконто1НачислениеДт");
		ИменаРеквизитовСчетИСубконто.Вставить("Субконто2",	"Субконто2НачислениеДт");
		ИменаРеквизитовСчетИСубконто.Вставить("Субконто3",	"Субконто3НачислениеДт");
		
		НоваяСтрока = ТаблицаПараметрыАвтоустановки.Добавить();
		НоваяСтрока["ЗаполняемаяТаблица"]				= Объект["СуммыНДС"];
		НоваяСтрока["ИменаРеквизитовСчетИСубконто"]		= ИменаРеквизитовСчетИСубконто;
		НоваяСтрока["СчетЭтоРеквизитТаблицы"]			= Истина;
		НоваяСтрока["ЗначенияАвтоустановки"]			= ЗначенияАвтоустановки;
	КонецЕсли;
	
	Возврат ТаблицаПараметрыАвтоустановки;
	
КонецФункции

Процедура АвтоустановкаСубконто_ЗаполнитьСлужебныеКолонкиРедактируемыхТаблиц(Форма) Экспорт
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "АвтоустановкаСубконто_ОтмечатьЗначенияСовпадающиеСАвтоустановкой") Тогда
		ОтмечатьЗначенияСовпадающиеСАвтоустановкой = Форма["АвтоустановкаСубконто_ОтмечатьЗначенияСовпадающиеСАвтоустановкой"];
	Иначе
		ОтмечатьЗначенияСовпадающиеСАвтоустановкой = Ложь;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "АвтоустановкаСубконто_ОтмечатьНезаполненныеСубконто") Тогда
		ОтмечатьНезаполненныеСубконто = Форма["АвтоустановкаСубконто_ОтмечатьНезаполненныеСубконто"];
	Иначе
		ОтмечатьНезаполненныеСубконто = Ложь;
	КонецЕсли;
	
	ИспользоватьУОЭлементовСубконто = (ОтмечатьЗначенияСовпадающиеСАвтоустановкой = Истина ИЛИ ОтмечатьНезаполненныеСубконто = Истина);
	
	ОбщаяТаблицаНастроек = Форма["АвтоустановкаСубконто_ОбщаяТаблицаНастроек"];
	
	Если ИспользоватьУОЭлементовСубконто Тогда
		// Рассчитываем флаг отметки значений субконто
		// или
		// Определяем количество субконто для счетов:
		Поиск = Новый Структура("ЭтоЭлементСчет", Истина);
		МассивСтрок = ОбщаяТаблицаНастроек.НайтиСтроки(Поиск);
		Для Каждого СтрокаОбщейТаблицы Из МассивСтрок Цикл
			АвтоустановкаСубконто_ОбработатьТаблицуИлиТекущуюСтроку(Форма, СтрокаОбщейТаблицы["ИмяЭлемента"],
				,		// ТекущаяСтрока
				Ложь);	// ВыполнитьАвтоустановкуЗначений
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

