Процедура ПечатьСчетаФактуры_ЗаполнитьСтрокуТаблицы(СтрокаТЧ, ШапкаДокумента, ОбластьМакетаСтрока)
	
	ПараметрыСтроки = ОбластьМакетаСтрока.Параметры;
	ПараметрыСтроки.Заполнить(СтрокаТЧ);
	
	СимволПрочерка	= "---";
	ПричинаНалогообложения = ШапкаДокумента["ПричинаНалогообложения"];
	ЭтоАванс	=  (ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.АвансПолученный
				ИЛИ ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.АвансВыданный);
	ЭтоСтранаРФ = (СтрокаТЧ["СтранаПроисхожденияКод"] = "643");
	
	ЗначенияПараметров = Новый Структура();
	
	// 2, 2а
	Если НЕ ЗначениеЗаполнено(СтрокаТЧ["ЕдиницаИзмерения"]) Тогда
		ЗначенияПараметров.Вставить("ЕдиницаИзмеренияКод",			СимволПрочерка);
		ЗначенияПараметров.Вставить("ЕдиницаИзмеренияПредставление",СимволПрочерка);
	КонецЕсли;
	
	// 3
	Если НЕ ЗначениеЗаполнено(СтрокаТЧ["Количество"]) Тогда
		ЗначенияПараметров.Вставить("Количество",				СимволПрочерка);
	КонецЕсли;
	
	// 4
	Если НЕ ЗначениеЗаполнено(СтрокаТЧ["Цена"]) Тогда
		ЗначенияПараметров.Вставить("Цена",						СимволПрочерка);
	КонецЕсли;
	
	// 6
	Если НЕ ЗначениеЗаполнено(СтрокаТЧ["Акциз"]) Тогда
		ЗначенияПараметров.Вставить("Акциз",					"без акциза");
	КонецЕсли;
	
	// 7
	Если СтрокаТЧ["СуммаНДС"] = 0 И НЕ СтрокаТЧ["СтавкаНДС"] = Перечисления.СтавкиНДС.НДС0 Тогда
		ЗначенияПараметров.Вставить("СуммаНДС",					"без НДС");
	КонецЕсли;
	
	Если ЭтоСтранаРФ Тогда
		// В графах 10-11 ставятся прочерки.
		ЗначенияПараметров.Вставить("СтранаПроисхожденияКод",	СимволПрочерка);
		ЗначенияПараметров.Вставить("ПредставлениеСтраны",		СимволПрочерка);
		ЗначенияПараметров.Вставить("ПредставлениеГТД",			СимволПрочерка);
	КонецЕсли;
	
	// 10-11
	Если НЕ ЗначениеЗаполнено(СтрокаТЧ["СтранаПроисхожденияКод"]) Тогда
		ЗначенияПараметров.Вставить("СтранаПроисхожденияКод",	СимволПрочерка);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(СтрокаТЧ["ПредставлениеСтраны"]) Тогда
		ЗначенияПараметров.Вставить("ПредставлениеСтраны",		СимволПрочерка);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(СтрокаТЧ["ПредставлениеГТД"]) Тогда
		ЗначенияПараметров.Вставить("ПредставлениеГТД",			СимволПрочерка);
	КонецЕсли;
	
	Если ЭтоАванс Тогда
		// В графах 2-6, 10-11 ставятся прочерки.
		ЗначенияПараметров.Вставить("ЕдиницаИзмеренияКод",			СимволПрочерка);
		ЗначенияПараметров.Вставить("ЕдиницаИзмеренияПредставление",СимволПрочерка);
		ЗначенияПараметров.Вставить("Количество",					СимволПрочерка);
		ЗначенияПараметров.Вставить("Цена",							СимволПрочерка);
		ЗначенияПараметров.Вставить("Стоимость",					СимволПрочерка);
		ЗначенияПараметров.Вставить("Акциз",						СимволПрочерка);
		ЗначенияПараметров.Вставить("СтранаПроисхожденияКод",		СимволПрочерка);
		ЗначенияПараметров.Вставить("ПредставлениеСтраны",			СимволПрочерка);
		ЗначенияПараметров.Вставить("ПредставлениеГТД",				СимволПрочерка);
	КонецЕсли;
	
	ПараметрыСтроки.Заполнить(ЗначенияПараметров);
	
КонецПроцедуры	

Процедура ПечатьСчетаФактуры_ЗаполнитьИтогоТаблицы(ВыборкаШапка, ЗначенияИтого, ОбластьМакетаИтого)
	
	ПараметрыОбласти = ОбластьМакетаИтого.Параметры;
	ПараметрыОбласти.Заполнить(ЗначенияИтого);
	
	ПричинаНалогообложения = ВыборкаШапка["ПричинаНалогообложения"];
	
	ЭтоАванс	= УчетНДСПовтИсп.Аванс(ПричинаНалогообложения);
	ЭтоШкурыЛом	= УчетНДСПовтИсп.ШкурыЛом(ПричинаНалогообложения);
	
	СимволПрочерка = "---";					
	
	ЗначенияПараметров = Новый Структура();
	
	Если ЭтоАванс И НЕ ЭтоШкурыЛом Тогда
		// В итогах графы 5 ставятся прочерки
		
		ЗначенияПараметров.Вставить("ИтогоСтоимость", СимволПрочерка);
	
	ИначеЕсли ЭтоШкурыЛом Тогда
		// В итогах граф 8, 9 ставятся прочерки
		
		ЗначенияПараметров.Вставить("ИтогоСуммаНДС",	СимволПрочерка);
		ЗначенияПараметров.Вставить("ИтогоВсего",		СимволПрочерка);
	КонецЕсли;
	
	ПараметрыОбласти.Заполнить(ЗначенияПараметров);
	
КонецПроцедуры	

Функция ПечатьСчетаФактуры_ПолучитьПредставлениеДокументОбОтгрузке(ВыборкаШапка, КоличествоСтрокТабличнойЧасти, ЭтоАванс, НомерСчетаФактуры)
	
	НомерДокумента = "---";
	
	ДатаДокумента = "---";
	
	Если ЭтоАванс Тогда
		// Ничего не меняем
		
	ИначеЕсли ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ВыборкаШапка, "ДокументРеализации") Тогда
		
		ДокументРеализации = ВыборкаШапка.ДокументРеализации;
		
		Если ЗначениеЗаполнено(ДокументРеализации) Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументРеализации, "Номер,Дата");
			
			НомерДокумента = РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(ДокументРеализации, ЗначенияРеквизитов.Номер);
			
			ДатаДокумента = Формат(ЗначенияРеквизитов.Дата, "ДФ=dd.MM.yyyy");
		Иначе
			НомерДокумента = НомерСчетаФактуры;
			
			ДатаДокумента = Формат(ВыборкаШапка.Дата, "ДФ=dd.MM.yyyy");
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СтрШаблон("№ п/п 1-%1 №%2 от %3",
		Формат(КоличествоСтрокТабличнойЧасти, "ЧГ="),
		НомерДокумента,
		ДатаДокумента);
		
КонецФункции


Функция ПечатьКорректировочногоСчетаФактуры(ДанныеДокументов, СтруктураПараметровОбработчика, ИдентификаторПостановления) Экспорт
	
	Перем ПрименяемыйИдентификаторПостановления;
	
	ОбщаяТаблицаПостановлений = ПолучитьОбщуюТаблицуПостановленийИзменяющихПечатнуюФормуКорректировочногоСчетаФактуры();
	
	ПроверитьНаличиеМакетаПечати(ИдентификаторПостановления, ОбщаяТаблицаПостановлений);
	
	ОбъектыПечати = СтруктураПараметровОбработчика["ОбъектыПечати"];
	
	// Возвращаемый документ:
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.ИмяПараметровПечати = "КорректировочныйСчетФактура_ПараметрыПечати";
	
	// Данные документов для распечатки:
	ВыборкаШапка		= ДанныеДокументов["ВыборкаШапка"];
	ВыборкаДокСоставНФА	= ДанныеДокументов["ВыборкаДокСоставНФА"];
	
	// Выборки по документам:
	ПервыйДокумент = Истина;
	Пока ВыборкаШапка.Следующий() Цикл
		
		Макет = ПолучитьПрименяемыйМакетПечати(
			ИдентификаторПостановления,
			ОбщаяТаблицаПостановлений,
			ВыборкаШапка,
			ДанныеДокументов,
			ПрименяемыйИдентификаторПостановления);
		
		ДобавитьПризнакиПрименяемогоПостановления(ДанныеДокументов, ПрименяемыйИдентификаторПостановления);
		
		ОбластиМакета = ПолучитьОбластиМакетаПечатиКорректировочногоСчетаФактуры(Макет, ДанныеДокументов.ПризнакиПрименяемогоПостановления);
		
		// Продвигаемся в остальных выборках до текущего документа:
		ПоискТекущегоДокумента = Новый Структура("ДокСсылка", ВыборкаШапка["ДокСсылка"]);
		ВыборкаДокСоставНФА.Сбросить();
		ЕстьВыборкаДокСоставНФА = ВыборкаДокСоставНФА.НайтиСледующий(ПоискТекущегоДокумента);
		
		Если НЕ ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент		= Ложь;
		НомерСтрокиНачало	= ТабДокумент.ВысотаТаблицы + 1;
		
		//---
		// Шапка
		//---
		Если ДанныеДокументов.ПризнакиПрименяемогоПостановления.ПредусмотреныПоказателиПрослеживаемости Тогда
			ПечатьКорректировочногоСчетаФактуры_ЗаполнитьШапку_534(ВыборкаШапка, ОбластиМакета.Шапка);
		Иначе
			ПечатьКорректировочногоСчетаФактуры_ЗаполнитьШапку(ВыборкаШапка, ОбластиМакета.Шапка);
		КонецЕсли;
		ТабДокумент.Вывести(ОбластиМакета.Шапка);
		
		//---
		// Таблица
		//---
		ТабДокумент.Вывести(ОбластиМакета.ЗаголовокТаблицы);
		ШапкаДокумента = Новый Структура("ПричинаНалогообложения", ВыборкаШапка["ПричинаНалогообложения"]);
		ВыборкаСоставНФА = ВыборкаДокСоставНФА.Выбрать();
		Пока ВыборкаСоставНФА.Следующий() Цикл
			
			Если ДанныеДокументов.ПризнакиПрименяемогоПостановления.ПредусмотреныПоказателиПрослеживаемости Тогда
				ПечатьКорректировочногоСчетаФактуры_ВывестиСтрокуТаблицы_534(ВыборкаСоставНФА, ШапкаДокумента, ТабДокумент,
					ОбластиМакета, ДанныеДокументов, ПрименяемыйИдентификаторПостановления);
			ИначеЕсли ПрименяемыйИдентификаторПостановления = "981" Тогда
				ПечатьКорректировочногоСчетаФактуры_ЗаполнитьСтрокуТаблицы_981(ВыборкаСоставНФА, ШапкаДокумента, ОбластиМакета.Строка);
				ТабДокумент.Вывести(ОбластиМакета.Строка);
			Иначе
				ПечатьКорректировочногоСчетаФактуры_ЗаполнитьСтрокуТаблицы(ВыборкаСоставНФА, ШапкаДокумента, ОбластиМакета.Строка);
				ТабДокумент.Вывести(ОбластиМакета.Строка);
			КонецЕсли;
			
		КонецЦикла;	
		
		Если ДанныеДокументов.Свойство("КонтекстПечати") Тогда
			ДанныеДокументов.Удалить("КонтекстПечати");
		КонецЕсли;
		
		//---
		// Итого
		//---
		ЗначенияИтого = Новый Структура("
			|СуммаУвеличение,
			|СуммаУменьшение,
			|СуммаНДСУвеличение,
			|СуммаНДСУменьшение,
			|ВсегоУвеличение,
			|ВсегоУменьшение");
		ЗаполнитьЗначенияСвойств(ЗначенияИтого, ВыборкаДокСоставНФА);
		ПечатьКорректировочногоСчетаФактуры_ЗаполнитьИтогоТаблицы(ВыборкаШапка, ЗначенияИтого, ОбластиМакета.Итого, ПрименяемыйИдентификаторПостановления, ДанныеДокументов, ПрименяемыйИдентификаторПостановления);
		ТабДокумент.Вывести(ОбластиМакета.Итого);
		
		//---	
		// Подвал
		//---
		ЗначенияПараметров = Новый Структура("
			|ФИОРуководителя,
			|ФИОГлавногоБухгалтера");
		ЗаполнитьЗначенияСвойств(ЗначенияПараметров, ВыборкаШапка);
		ОбластиМакета.Подвал.Параметры.Заполнить(ЗначенияПараметров);
		ТабДокумент.Вывести(ОбластиМакета.Подвал);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(
			ТабДокумент, 
			НомерСтрокиНачало,
			ОбъектыПечати,
			ВыборкаШапка.ДокСсылка);
	КонецЦикла;												   
	
	Возврат ТабДокумент;
	
КонецФункции		

Функция ПолучитьОбластиМакетаПечатиКорректировочногоСчетаФактуры(Макет, ПризнакиПрименяемогоПостановления)
	
	ОбластиМакета = Новый Структура();
	
	ОбластиМакета.Вставить("Шапка",				Макет.ПолучитьОбласть("Шапка"));
	ОбластиМакета.Вставить("ЗаголовокТаблицы",	Макет.ПолучитьОбласть("ЗаголовокТаблицы"));
	ОбластиМакета.Вставить("Итого",				Макет.ПолучитьОбласть("Итого"));
	ОбластиМакета.Вставить("Подвал",			Макет.ПолучитьОбласть("Подвал"));
	
	Если ПризнакиПрименяемогоПостановления.ПредусмотреныПоказателиПрослеживаемости Тогда
		ОбластиМакета.Вставить("СтрокаДо",			Макет.ПолучитьОбласть("СтрокаДо"));
		ОбластиМакета.Вставить("СтрокаПосле",		Макет.ПолучитьОбласть("СтрокаПосле"));
		ОбластиМакета.Вставить("СтрокаУвеличение",	Макет.ПолучитьОбласть("СтрокаУвеличение"));
		ОбластиМакета.Вставить("СтрокаУменьшение",	Макет.ПолучитьОбласть("СтрокаУменьшение"));
	Иначе
		ОбластиМакета.Вставить("Строка",			Макет.ПолучитьОбласть("Строка"));
	КонецЕсли;
	
	Возврат ОбластиМакета;
	
КонецФункции

Процедура ПечатьКорректировочногоСчетаФактуры_ЗаполнитьШапку(ВыборкаШапка, ОбластьМакетаШапка)
	
	// Предполагается печать только выданных документов
	
	ДетальнаяЗапись = Новый Структура("
		|ИмяДокумента,
		|ИмяИсправляемогоДокумента,
		|ВидОбособленногоПодразделения,
		|НДСИндексПодразделения");
	
	ЗаполнитьЗначенияСвойств(ДетальнаяЗапись, ВыборкаШапка);
	
	ДетальнаяЗапись.Вставить("Номер",		ВыборкаШапка.НомерСчетаФактуры);
	ДетальнаяЗапись.Вставить("НомерКСФ",	ВыборкаШапка.Номер);
	
	НомерСФ = ОпределитьНомерСФДляВыводаВРегистрыУчета(ДетальнаяЗапись);
	
	СимволПрочерка = "---";
	
	ОбластьМакетаШапка.Параметры.Заполнить(ВыборкаШапка);
	
	ЗначенияПараметров = Новый Структура();
	
	// 1
	ЗначенияПараметров.Вставить("Номер", НомерСФ["НомерКСФ"]);
	
	// 1а
	Если ВыборкаШапка["ИмяДокумента"] = "ИсправительныйСчетФактураВыданный" Тогда
		НомерИсправления = ВыборкаШапка["НомерИсправления"];
		ДатаИсправления = ВыборкаШапка["ДатаИсправления"];
	Иначе
		НомерИсправления = СимволПрочерка;
		ДатаИсправления = СимволПрочерка;
	КонецЕсли;
	ЗначенияПараметров.Вставить("НомерИсправления", НомерИсправления);
	ЗначенияПараметров.Вставить("ДатаИсправления",	ДатаИсправления);
	
	// 1б
	ЗначенияПараметров.Вставить("НомерСчетаФактуры", НомерСФ["Номер"]);
	
	НомерИсправленияСчетаФактуры = ВыборкаШапка["НомерИсправленияСчетаФактуры"];
	ДатаИсправленияСчетаФактуры = ВыборкаШапка["ДатаИсправленияСчетаФактуры"];
	Если НЕ ЗначениеЗаполнено(НомерИсправленияСчетаФактуры) Тогда
		НомерИсправленияСчетаФактуры = СимволПрочерка;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ДатаИсправленияСчетаФактуры) Тогда
		ДатаИсправленияСчетаФактуры = СимволПрочерка;
	КонецЕсли;
	ЗначенияПараметров.Вставить("НомерИсправленияСчетаФактуры", НомерИсправленияСчетаФактуры);
	ЗначенияПараметров.Вставить("ДатаИсправленияСчетаФактуры", ДатаИсправленияСчетаФактуры);
	
	ОбластьМакетаШапка.Параметры.Заполнить(ЗначенияПараметров);
	
КонецПроцедуры

Процедура ПечатьКорректировочногоСчетаФактуры_ЗаполнитьШапку_534(ВыборкаШапка, ОбластьМакетаШапка)
	
	// Предполагается печать только выданных документов
	
	ДетальнаяЗапись = Новый Структура("
		|ИмяДокумента,
		|ИмяИсправляемогоДокумента,
		|ВидОбособленногоПодразделения,
		|НДСИндексПодразделения");
	
	ЗаполнитьЗначенияСвойств(ДетальнаяЗапись, ВыборкаШапка);
	
	ДетальнаяЗапись.Вставить("Номер",		ВыборкаШапка.НомерСчетаФактуры);
	ДетальнаяЗапись.Вставить("НомерКСФ",	ВыборкаШапка.Номер);
	
	НомерСФ = ОпределитьНомерСФДляВыводаВРегистрыУчета(ДетальнаяЗапись);
	
	СимволПрочерка = "---";
	
	ОбластьМакетаШапка.Параметры.Заполнить(ВыборкаШапка);
	
	ЗначенияПараметров = Новый Структура();
	
	// 1
	ЗначенияПараметров.Вставить("Номер", НомерСФ["НомерКСФ"]);
	ЗначенияПараметров.Вставить("Дата", Формат(ВыборкаШапка.Дата, "ДФ='dd MMMM yyyy ""г.""'"));
	
	// 1а
	Если ВыборкаШапка["ИмяДокумента"] = "ИсправительныйСчетФактураВыданный" Тогда
		НомерИсправления = ВыборкаШапка["НомерИсправления"];
		ДатаИсправления = ВыборкаШапка["ДатаИсправления"];
	Иначе
		НомерИсправления = СимволПрочерка;
		ДатаИсправления = СимволПрочерка;
	КонецЕсли;
	ЗначенияПараметров.Вставить("НомерИсправленияКорректировочного", НомерИсправления);
	ЗначенияПараметров.Вставить("ДатаИсправленияКорректировочного",	Формат(ДатаИсправления, "ДФ='dd MMMM yyyy ""г.""'"));
	
	// 1б
	ЗначенияПараметров.Вставить("НомерСчетаФактуры", НомерСФ["Номер"]);
	
	НомерИсправленияСчетаФактуры = ВыборкаШапка["НомерИсправленияСчетаФактуры"];
	ДатаИсправленияСчетаФактуры = ВыборкаШапка["ДатаИсправленияСчетаФактуры"];
	Если НЕ ЗначениеЗаполнено(НомерИсправленияСчетаФактуры) Тогда
		НомерИсправленияСчетаФактуры = СимволПрочерка;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ДатаИсправленияСчетаФактуры) Тогда
		ДатаИсправленияСчетаФактурыСтрокой = СимволПрочерка;
	Иначе
		ДатаИсправленияСчетаФактурыСтрокой = Формат(ДатаИсправленияСчетаФактуры, "ДФ='dd MMMM yyyy ""г.""'");
	КонецЕсли;
	
	// 1б
	ЗначенияПараметров.Вставить("РеквизитыОснований", СтрШаблон(НСтр("ru='№%1 от %2 с учетом исправления № %3 от %4'"),
		НомерСФ["Номер"],
		Формат(ВыборкаШапка.ДатаСчетаФактуры, "ДФ='dd MMMM yyyy ""г.""'"),
		НомерИсправленияСчетаФактуры,
		ДатаИсправленияСчетаФактурыСтрокой));
	
	ОбластьМакетаШапка.Параметры.Заполнить(ЗначенияПараметров);
	
КонецПроцедуры

Процедура ПечатьКорректировочногоСчетаФактуры_ВывестиСтрокуТаблицы_534(СтрокаТЧ, ШапкаДокумента, ТабДокумент,
		ОбластиМакета, ДанныеДокументов, ПрименяемыйИдентификаторПостановления)
	
	Перем ПоказателиПрослеживаемости, КонтекстПечати;
	
	ОбластьМакетаСтрокаДо			= ОбластиМакета.СтрокаДо;
	ОбластьМакетаСтрокаПосле		= ОбластиМакета.СтрокаПосле;
	ОбластьМакетаСтрокаУвеличение	= ОбластиМакета.СтрокаУвеличение;
	ОбластьМакетаСтрокаУменьшение	= ОбластиМакета.СтрокаУменьшение;
	
	ПараметрыМакетаА = ОбластьМакетаСтрокаДо.Параметры;
	ПараметрыМакетаБ = ОбластьМакетаСтрокаПосле.Параметры;
	ПараметрыМакетаВ = ОбластьМакетаСтрокаУвеличение.Параметры;
	ПараметрыМакетаГ = ОбластьМакетаСтрокаУменьшение.Параметры;
	
	ПараметрыМакетаА.Заполнить(СтрокаТЧ);
	ПараметрыМакетаБ.Заполнить(СтрокаТЧ);
	ПараметрыМакетаВ.Заполнить(СтрокаТЧ);
	ПараметрыМакетаГ.Заполнить(СтрокаТЧ);
	
	ЗначенияПараметровА = Новый Структура("СтрокаДо",			"А (до изменения)");
	ЗначенияПараметровБ = Новый Структура("СтрокаПосле",		"Б (после изменения)");
	ЗначенияПараметровВ = Новый Структура("СтрокаУвеличение",	"В (увеличение)");
	ЗначенияПараметровГ = Новый Структура("СтрокаУменьшение",	"Г (уменьшение)");
	
	ЗначенияПараметровА.Вставить("АкцизДоИзменения",	СтрокаТЧ.АкцизДоИзменения);
	ЗначенияПараметровБ.Вставить("АкцизПослеИзменения",	СтрокаТЧ.АкцизПослеИзменения);
	ЗначенияПараметровВ.Вставить("АкцизУвеличение",		СтрокаТЧ.АкцизУвеличение);
	ЗначенияПараметровГ.Вставить("АкцизУменьшение",		СтрокаТЧ.АкцизУменьшение);
	
	ЗначенияПараметровА.Вставить("СтранаПроисхожденияКодДо",	СтрокаТЧ.СтранаПроисхожденияКод);
	ЗначенияПараметровБ.Вставить("СтранаПроисхожденияКодПосле",	СтрокаТЧ.СтранаПроисхожденияКод);
	ЗначенияПараметровА.Вставить("ПредставлениеСтраныДо",		СтрокаТЧ.ПредставлениеСтраны);
	ЗначенияПараметровБ.Вставить("ПредставлениеСтраныПосле",	СтрокаТЧ.ПредставлениеСтраны);
	
	ПричинаНалогообложения = ШапкаДокумента["ПричинаНалогообложения"];
	
	ЭтоАванс	= УчетНДСПовтИсп.Аванс(ПричинаНалогообложения);
	ЭтоШкурыЛом	= УчетНДСПовтИсп.ШкурыЛом(ПричинаНалогообложения);
	
	СимволПрочерка	= "---";
	
	ТекстСтавкиНДСИсчисляетсяНалоговымАгентом = УчетНДСКлиентСервер.ТекстСтавкиНДСИсчисляетсяНалоговымАгентом();
	
	// 1 Номер записи в счете-фактуре
	НомерСтроки = СтрокаТЧ.НомерСтроки;
	Если ДанныеДокументов.Свойство("НомераСтрокСчетовФактур") Тогда
		Поиск = Новый Структура("Ссылка,НомерСтроки", СтрокаТЧ.ДокСсылка, СтрокаТЧ.НомерСтроки);
		МассивСтрок = ДанныеДокументов.НомераСтрокСчетовФактур.ДополненныеТабличныеЧастиКСФ.НайтиСтроки(Поиск);
		Если МассивСтрок.Количество() > 0 Тогда
			НомерСтроки = Формат(МассивСтрок[0].НомерСтрокиСФ, "ЧГ=");
		КонецЕсли;
	КонецЕсли;
	ЗначенияПараметровА.Вставить("НомерСтроки", НомерСтроки);
	
	// 1б
	Если НЕ ЗначениеЗаполнено(СтрокаТЧ["КодВидаТовара"]) Тогда
		ЗначенияПараметровА.Вставить("КодВидаТовара", СимволПрочерка);
		ЗначенияПараметровБ.Вставить("КодВидаТовара", СимволПрочерка);
		ЗначенияПараметровВ.Вставить("КодВидаТовара", СимволПрочерка);
		ЗначенияПараметровГ.Вставить("КодВидаТовара", СимволПрочерка);
	КонецЕсли;
	
	// графы 5, 8, 9 для строк В, Г - прочерки для одной (незаполненной) из этих двух строк
	Если СтрокаТЧ["СуммаУвеличение"] = 0 Тогда
		ЗначенияПараметровВ.Вставить("СуммаУвеличение",		СимволПрочерка);
	КонецЕсли;
	
	Если СтрокаТЧ["ВсегоУвеличение"] = 0 Тогда
		ЗначенияПараметровВ.Вставить("ВсегоУвеличение",		СимволПрочерка);
	КонецЕсли;
	
	Если СтрокаТЧ["СуммаНДСУвеличение"] = 0 Тогда
		ЗначенияПараметровВ.Вставить("СуммаНДСУвеличение",	СимволПрочерка);
	КонецЕсли;
	
	Если СтрокаТЧ["СуммаУменьшение"] = 0 Тогда
		ЗначенияПараметровГ.Вставить("СуммаУменьшение",		СимволПрочерка);
	КонецЕсли;

	Если СтрокаТЧ["СуммаНДСУменьшение"] = 0 Тогда
		ЗначенияПараметровГ.Вставить("СуммаНДСУменьшение",	СимволПрочерка);
	КонецЕсли;
	
	Если СтрокаТЧ["ВсегоУменьшение"] = 0 Тогда
		ЗначенияПараметровГ.Вставить("ВсегоУменьшение",		СимволПрочерка);
	КонецЕсли;
	
	Если ЭтоАванс И НЕ ЭтоШкурыЛом Тогда
		// Аванс
		
		// графы 1б, 2, 2а, 3, 4 - прочерки
		
		ЗначенияПараметровА.Вставить("ЕдиницаИзмеренияКодДоИзменения",				СимволПрочерка);
		ЗначенияПараметровБ.Вставить("ЕдиницаИзмеренияКодПослеИзменения",			СимволПрочерка);
		
		ЗначенияПараметровА.Вставить("ЕдиницаИзмеренияПредставлениеДоИзменения",	СимволПрочерка);
		ЗначенияПараметровБ.Вставить("ЕдиницаИзмеренияПредставлениеПослеИзменения",	СимволПрочерка);
		
		ЗначенияПараметровА.Вставить("КоличествоДоИзменения", 						СимволПрочерка);
		ЗначенияПараметровБ.Вставить("КоличествоПослеИзменения", 					СимволПрочерка);
		
		ЗначенияПараметровА.Вставить("ЦенаДоИзменения", 							СимволПрочерка);
		ЗначенияПараметровБ.Вставить("ЦенаПослеИзменения",		 					СимволПрочерка);
		
		// графа 5 - число "0"
		ЗначенияПараметровА.Вставить("СуммаДоИзменения",	"0");
		ЗначенияПараметровБ.Вставить("СуммаПослеИзменения",	"0");
		
		Если СтрокаТЧ["СуммаНДСУвеличение"] > 0 Тогда
			ЗначенияПараметровВ.Вставить("СуммаУвеличение",	"0");
			ЗначенияПараметровВ.Вставить("АкцизУвеличение",	СимволПрочерка);
			
			ЗначенияПараметровГ.Вставить("СуммаУменьшение",		"");
			ЗначенияПараметровГ.Вставить("СуммаНДСУменьшение",	"");
			ЗначенияПараметровГ.Вставить("ВсегоУменьшение",		"");
			ЗначенияПараметровГ.Вставить("АкцизУменьшение",		"");
			
		ИначеЕсли СтрокаТЧ["СуммаНДСУменьшение"] > 0 Тогда
			ЗначенияПараметровВ.Вставить("СуммаУвеличение",	"");
			ЗначенияПараметровВ.Вставить("АкцизУвеличение",	"");
			
			ЗначенияПараметровГ.Вставить("СуммаУменьшение",		"0");
			ЗначенияПараметровГ.Вставить("СуммаНДСУменьшение",	"0");
			ЗначенияПараметровГ.Вставить("ВсегоУменьшение",		"0");
			ЗначенияПараметровГ.Вставить("АкцизУменьшение",		СимволПрочерка);
		КонецЕсли;
		
	ИначеЕсли ЭтоАванс И ЭтоШкурыЛом Тогда
		
		// графа 1а - пустая ячейка
		ЗначенияПараметровА.Вставить("КодВидаТовара",				"");
		ЗначенияПараметровБ.Вставить("КодВидаТовара",				"");
		ЗначенияПараметровВ.Вставить("КодВидаТовара",				"");
		ЗначенияПараметровГ.Вставить("КодВидаТовара",				"");
		
		// графы 1б, 2, 2а, 3, 4 - прочерки
		ЗначенияПараметровА.Вставить("ЕдиницаИзмеренияКодДоИзменения",				СимволПрочерка);
		ЗначенияПараметровБ.Вставить("ЕдиницаИзмеренияКодПослеИзменения",			СимволПрочерка);
		
		ЗначенияПараметровА.Вставить("ЕдиницаИзмеренияПредставлениеДоИзменения",	СимволПрочерка);
		ЗначенияПараметровБ.Вставить("ЕдиницаИзмеренияПредставлениеПослеИзменения",	СимволПрочерка);
		
		ЗначенияПараметровА.Вставить("КоличествоДоИзменения", 						СимволПрочерка);
		ЗначенияПараметровБ.Вставить("КоличествоПослеИзменения", 					СимволПрочерка);
		
		ЗначенияПараметровА.Вставить("ЦенаДоИзменения", 							СимволПрочерка);
		ЗначенияПараметровБ.Вставить("ЦенаПослеИзменения",		 					СимволПрочерка);
		
		// графа 6 - пустая ячейка
		ЗначенияПараметровВ.Вставить("АкцизУвеличение",				"");
		ЗначенияПараметровГ.Вставить("АкцизУменьшение",				"");
		
		// графа 7 - специальный текст
		ЗначенияПараметровА.Вставить("СтавкаНДСДоИзменения",		ТекстСтавкиНДСИсчисляетсяНалоговымАгентом);
		ЗначенияПараметровБ.Вставить("СтавкаНДСПослеИзменения",		ТекстСтавкиНДСИсчисляетсяНалоговымАгентом);
		
	ИначеЕсли ЭтоШкурыЛом Тогда
		// ШкурыЛом
		
		// графа 1а - пустая ячейка
		ЗначенияПараметровА.Вставить("КодВидаТовара",				"");
		ЗначенияПараметровБ.Вставить("КодВидаТовара",				"");
		ЗначенияПараметровВ.Вставить("КодВидаТовара",				"");
		ЗначенияПараметровГ.Вставить("КодВидаТовара",				"");
		
		// графа 7 - специальный текст
		ЗначенияПараметровА.Вставить("СтавкаНДСДоИзменения",		ТекстСтавкиНДСИсчисляетсяНалоговымАгентом);
		ЗначенияПараметровБ.Вставить("СтавкаНДСПослеИзменения",		ТекстСтавкиНДСИсчисляетсяНалоговымАгентом);
		
		// графы 8, 9 для строк А, Б - прочерки
		// графы 5, 6, 8, 9 для строк В, Г - пустые строки вместо привычных прочерков для при незаполненной ячейке
		ЗначенияПараметровА.Вставить("СуммаНДСДоИзменения",			СимволПрочерка);
		ЗначенияПараметровА.Вставить("ВсегоДоИзменения",			СимволПрочерка);
		ЗначенияПараметровБ.Вставить("СуммаНДСПослеИзменения",		СимволПрочерка);
		ЗначенияПараметровБ.Вставить("ВсегоПослеИзменения",			СимволПрочерка);
		
		// графа 6 - пустая ячейка
		ЗначенияПараметровВ.Вставить("АкцизУвеличение",			"");
		ЗначенияПараметровГ.Вставить("АкцизУменьшение",			"");
		
		Если СтрокаТЧ["СуммаУвеличение"] > 0 Тогда
			ЗначенияПараметровА.Вставить("СуммаУвеличение",		СтрокаТЧ["СуммаУвеличение"]);
			ЗначенияПараметровБ.Вставить("СуммаУменьшение",		"");
			
			ЗначенияПараметровВ.Вставить("СуммаНДСУвеличение",	СимволПрочерка);
			ЗначенияПараметровВ.Вставить("ВсегоУвеличение",		СимволПрочерка);
			ЗначенияПараметровГ.Вставить("СуммаНДСУменьшение",	"");
			ЗначенияПараметровГ.Вставить("ВсегоУменьшение",		"");
			
		ИначеЕсли СтрокаТЧ["СуммаУменьшение"] > 0 Тогда
			ЗначенияПараметровВ.Вставить("СуммаУвеличение",		"");
			ЗначенияПараметровГ.Вставить("СуммаУменьшение",		СтрокаТЧ["СуммаУменьшение"]);
			
			ЗначенияПараметровВ.Вставить("СуммаНДСУвеличение",	"");
			ЗначенияПараметровВ.Вставить("ВсегоУвеличение",		"");
			ЗначенияПараметровГ.Вставить("СуммаНДСУменьшение",	СимволПрочерка);
			ЗначенияПараметровГ.Вставить("ВсегоУменьшение",		СимволПрочерка);
		КонецЕсли;
		
	КонецЕсли;
	
	ОбластьМакетаСтрокаДо.Параметры.Заполнить(ЗначенияПараметровА);
	ОбластьМакетаСтрокаПосле.Параметры.Заполнить(ЗначенияПараметровБ);
	ОбластьМакетаСтрокаУвеличение.Параметры.Заполнить(ЗначенияПараметровВ);
	ОбластьМакетаСтрокаУменьшение.Параметры.Заполнить(ЗначенияПараметровГ);
	
	// Прослеживаемость
	ПараметрыВывода = Новый Структура();
	ПараметрыВывода.Вставить("ПараметрыМакетаА",				ПараметрыМакетаА);
	ПараметрыВывода.Вставить("ПараметрыМакетаБ",				ПараметрыМакетаБ);
	ПараметрыВывода.Вставить("ПараметрыМакетаВ",				ПараметрыМакетаВ);
	ПараметрыВывода.Вставить("ПараметрыМакетаГ",				ПараметрыМакетаГ);
	ПараметрыВывода.Вставить("ОбластьМакетаСтрокаДо",			ОбластьМакетаСтрокаДо);
	ПараметрыВывода.Вставить("ОбластьМакетаСтрокаПосле",		ОбластьМакетаСтрокаПосле);
	ПараметрыВывода.Вставить("ОбластьМакетаСтрокаУвеличение",	ОбластьМакетаСтрокаУвеличение);
	ПараметрыВывода.Вставить("ОбластьМакетаСтрокаУменьшение",	ОбластьМакетаСтрокаУменьшение);
	
	ПечатьКорректировочногоСчетаФактуры_ВывестиСведенияПрослеживаемостиВСтрокеТаблицы(СтрокаТЧ, ШапкаДокумента, ТабДокумент,
		ДанныеДокументов, ПрименяемыйИдентификаторПостановления, КонтекстПечати, ПараметрыВывода);
	// Конец Прослеживаемость
	
КонецПроцедуры

Процедура ПечатьКорректировочногоСчетаФактуры_ЗаполнитьСтрокуТаблицы_981(СтрокаТЧ, ШапкаДокумента, ОбластьМакетаСтрока)
	
	ОбластьМакетаСтрока.Параметры.Заполнить(СтрокаТЧ);
	
	ПричинаНалогообложения = ШапкаДокумента["ПричинаНалогообложения"];
	
	ЭтоАванс	= УчетНДСПовтИсп.Аванс(ПричинаНалогообложения);
	ЭтоШкурыЛом	= УчетНДСПовтИсп.ШкурыЛом(ПричинаНалогообложения);
	
	СимволПрочерка	= "---";
	
	ТекстСтавкиНДСИсчисляетсяНалоговымАгентом = УчетНДСКлиентСервер.ТекстСтавкиНДСИсчисляетсяНалоговымАгентом();
	
	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("АкцизДоИзменения",		"без акциза");
	ЗначенияПараметров.Вставить("АкцизПослеИзменения",	"без акциза");
	ЗначенияПараметров.Вставить("АкцизУвеличение",		"без акциза");
	ЗначенияПараметров.Вставить("АкцизУменьшение",		"без акциза");
	
	// 1б
	Если НЕ ЗначениеЗаполнено(СтрокаТЧ["КодВидаТовара"]) Тогда
		ЗначенияПараметров.Вставить("КодВидаТовара", СимволПрочерка);
	КонецЕсли;
	
	// графы 5, 6, 8, 9 для строк В, Г - прочерки для одной (незаполненной) из этих двух строк
	Если СтрокаТЧ["СуммаНДСУвеличение"] = 0 Тогда
		ЗначенияПараметров.Вставить("СуммаУвеличение",		СимволПрочерка);
		ЗначенияПараметров.Вставить("СуммаНДСУвеличение",	СимволПрочерка);
		ЗначенияПараметров.Вставить("ВсегоУвеличение",		СимволПрочерка);
		ЗначенияПараметров.Вставить("АкцизУвеличение",		СимволПрочерка);
		
	ИначеЕсли СтрокаТЧ["СуммаНДСУменьшение"] = 0 Тогда
		ЗначенияПараметров.Вставить("СуммаУменьшение",		СимволПрочерка);
		ЗначенияПараметров.Вставить("СуммаНДСУменьшение",	СимволПрочерка);
		ЗначенияПараметров.Вставить("ВсегоУменьшение",		СимволПрочерка);
		ЗначенияПараметров.Вставить("АкцизУменьшение",		СимволПрочерка);
	КонецЕсли;
	
	Если ЭтоАванс И НЕ ЭтоШкурыЛом Тогда
		// Аванс
		
		// графы 1б, 2, 2а, 3, 4 - прочерки
		
		ЗначенияПараметров.Вставить("ЕдиницаИзмеренияКодДоИзменения",				СимволПрочерка);
		ЗначенияПараметров.Вставить("ЕдиницаИзмеренияКодПослеИзменения",			СимволПрочерка);
		ЗначенияПараметров.Вставить("ЕдиницаИзмеренияПредставлениеДоИзменения",		СимволПрочерка);
		ЗначенияПараметров.Вставить("ЕдиницаИзмеренияПредставлениеПослеИзменения",	СимволПрочерка);
		ЗначенияПараметров.Вставить("КоличествоДоИзменения", 						СимволПрочерка);
		ЗначенияПараметров.Вставить("КоличествоПослеИзменения", 					СимволПрочерка);
		ЗначенияПараметров.Вставить("ЦенаДоИзменения", 								СимволПрочерка);
		ЗначенияПараметров.Вставить("ЦенаПослеИзменения",		 					СимволПрочерка);
		
		// графа 5 - число "0"
		ЗначенияПараметров.Вставить("СуммаДоИзменения",		"0");
		ЗначенияПараметров.Вставить("СуммаПослеИзменения",	"0");
		
		Если СтрокаТЧ["СуммаНДСУвеличение"] > 0 Тогда
			ЗначенияПараметров.Вставить("СуммаУвеличение",	"0");
			ЗначенияПараметров.Вставить("АкцизУвеличение",			СимволПрочерка);
			
			ЗначенияПараметров.Вставить("СуммаУменьшение",	"");
			ЗначенияПараметров.Вставить("СуммаНДСУменьшение",	"");
			ЗначенияПараметров.Вставить("ВсегоУменьшение",	"");
			ЗначенияПараметров.Вставить("АкцизУменьшение",			"");
			
		ИначеЕсли СтрокаТЧ["СуммаНДСУменьшение"] > 0 Тогда
			ЗначенияПараметров.Вставить("СуммаУвеличение",	"");
			ЗначенияПараметров.Вставить("АкцизУвеличение",			"");
			
			ЗначенияПараметров.Вставить("СуммаУменьшение",	"0");
			ЗначенияПараметров.Вставить("СуммаНДСУменьшение",	"0");
			ЗначенияПараметров.Вставить("ВсегоУменьшение",	"0");
			ЗначенияПараметров.Вставить("АкцизУменьшение",			СимволПрочерка);
		КонецЕсли;
		
	ИначеЕсли ЭтоАванс И ЭтоШкурыЛом Тогда
		
		// графа 1а - пустая ячейка
		ЗначенияПараметров.Вставить("КодВидаТовара",				"");
		
		// графы 1б, 2, 2а, 3, 4 - прочерки
		ЗначенияПараметров.Вставить("ЕдиницаИзмеренияКодДоИзменения",				СимволПрочерка);
		ЗначенияПараметров.Вставить("ЕдиницаИзмеренияКодПослеИзменения",			СимволПрочерка);
		ЗначенияПараметров.Вставить("ЕдиницаИзмеренияПредставлениеДоИзменения",		СимволПрочерка);
		ЗначенияПараметров.Вставить("ЕдиницаИзмеренияПредставлениеПослеИзменения",	СимволПрочерка);
		ЗначенияПараметров.Вставить("КоличествоДоИзменения", 						СимволПрочерка);
		ЗначенияПараметров.Вставить("КоличествоПослеИзменения", 					СимволПрочерка);
		ЗначенияПараметров.Вставить("ЦенаДоИзменения", 								СимволПрочерка);
		ЗначенияПараметров.Вставить("ЦенаПослеИзменения",		 					СимволПрочерка);
		
		// графа 6 - пустая ячейка
		ЗначенияПараметров.Вставить("АкцизУвеличение",				"");
		ЗначенияПараметров.Вставить("АкцизУменьшение",				"");
		
		// графа 7 - специальный текст
		ЗначенияПараметров.Вставить("СтавкаНДСДоИзменения",			ТекстСтавкиНДСИсчисляетсяНалоговымАгентом);
		ЗначенияПараметров.Вставить("СтавкаНДСПослеИзменения",		ТекстСтавкиНДСИсчисляетсяНалоговымАгентом);
		
	ИначеЕсли ЭтоШкурыЛом Тогда
		// ШкурыЛом
		
		// графа 1а - пустая ячейка
		ЗначенияПараметров.Вставить("КодВидаТовара",				"");
		
		// графа 7 - специальный текст
		ЗначенияПараметров.Вставить("СтавкаНДСДоИзменения",			ТекстСтавкиНДСИсчисляетсяНалоговымАгентом);
		ЗначенияПараметров.Вставить("СтавкаНДСПослеИзменения",		ТекстСтавкиНДСИсчисляетсяНалоговымАгентом);
		
		// графы 8, 9 для строк А, Б - прочерки
		// графы 5, 6, 8, 9 для строк В, Г - пустые строки вместо привычных прочерков для при незаполненной ячейке
		ЗначенияПараметров.Вставить("СуммаНДСДоИзменения",			СимволПрочерка);
		ЗначенияПараметров.Вставить("СтоимостьСНДСДоИзменения",		СимволПрочерка);
		ЗначенияПараметров.Вставить("СуммаНДСПослеИзменения",		СимволПрочерка);
		ЗначенияПараметров.Вставить("СтоимостьСНДСПослеИзменения",	СимволПрочерка);
		
		// графа 6 - пустая ячейка
		ЗначенияПараметров.Вставить("АкцизУвеличение",				"");
		ЗначенияПараметров.Вставить("АкцизУменьшение",				"");
		
		Если СтрокаТЧ["СуммаУвеличение"] > 0 Тогда
			ЗначенияПараметров.Вставить("СуммаУвеличение",	СтрокаТЧ["СуммаУвеличение"]);
			ЗначенияПараметров.Вставить("СуммаУменьшение",	"");
			
			ЗначенияПараметров.Вставить("СуммаНДСУвеличение",		СимволПрочерка);
			ЗначенияПараметров.Вставить("ВсегоУвеличение",		СимволПрочерка);
			ЗначенияПараметров.Вставить("СуммаНДСУменьшение",	"");
			ЗначенияПараметров.Вставить("ВсегоУменьшение",	"");
			
		ИначеЕсли СтрокаТЧ["СуммаУменьшение"] > 0 Тогда
			ЗначенияПараметров.Вставить("СуммаУвеличение",	"");
			ЗначенияПараметров.Вставить("СуммаУменьшение",	СтрокаТЧ["СуммаУменьшение"]);
			
			ЗначенияПараметров.Вставить("СуммаНДСУвеличение",		"");
			ЗначенияПараметров.Вставить("ВсегоУвеличение",		"");
			ЗначенияПараметров.Вставить("СуммаНДСУменьшение",	СимволПрочерка);
			ЗначенияПараметров.Вставить("ВсегоУменьшение",	СимволПрочерка);
		КонецЕсли;
		
	КонецЕсли;
	
	ОбластьМакетаСтрока.Параметры.Заполнить(ЗначенияПараметров);
	
КонецПроцедуры

Процедура ПечатьКорректировочногоСчетаФактуры_ЗаполнитьСтрокуТаблицы(СтрокаТЧ, ШапкаДокумента, ОбластьМакетаСтрока)
	
	ОбластьМакетаСтрока.Параметры.Заполнить(СтрокаТЧ);
	
КонецПроцедуры

Процедура ПечатьКорректировочногоСчетаФактуры_ЗаполнитьИтогоТаблицы(ВыборкаШапка, ЗначенияИтого, ОбластьМакетаИтого, Идентификатор, ДанныеДокументов, ПрименяемыйИдентификаторПостановления)
	
	ПараметрыОбласти = ОбластьМакетаИтого.Параметры;
	ПараметрыОбласти.Заполнить(ЗначенияИтого);
	
	ПричинаНалогообложения = ВыборкаШапка["ПричинаНалогообложения"];
	
	ЭтоАванс	= УчетНДСПовтИсп.Аванс(ПричинаНалогообложения);
	ЭтоШкурыЛом	= УчетНДСПовтИсп.ШкурыЛом(ПричинаНалогообложения);
	
	СимволПрочерка	= "---";
	
	ЗначенияПараметров = Новый Структура();
	
	// графы 5, 8, 9 - прочерки для нулевых значений
	
	Если ЗначенияИтого["СуммаНДСУвеличение"] = 0 Тогда
		ЗначенияПараметров.Вставить("СуммаНДСУвеличение", СимволПрочерка);
	КонецЕсли;
	
	Если ЗначенияИтого["СуммаУвеличение"] = 0 Тогда
		ЗначенияПараметров.Вставить("СуммаУвеличение", СимволПрочерка);
	КонецЕсли;
		
	Если ЗначенияИтого["ВсегоУвеличение"] = 0 Тогда
		ЗначенияПараметров.Вставить("ВсегоУвеличение", СимволПрочерка);
	КонецЕсли;
	
	Если ЗначенияИтого["СуммаНДСУменьшение"] = 0 Тогда
		ЗначенияПараметров.Вставить("СуммаНДСУменьшение", СимволПрочерка);
	КонецЕсли;
	
	Если ЗначенияИтого["СуммаУменьшение"] = 0 Тогда
		ЗначенияПараметров.Вставить("СуммаУменьшение", СимволПрочерка);
	КонецЕсли;
	
	Если ЗначенияИтого["ВсегоУменьшение"] = 0 Тогда
		ЗначенияПараметров.Вставить("ВсегоУменьшение", СимволПрочерка);
	КонецЕсли;
	
	Если ЭтоАванс И НЕ ЭтоШкурыЛом Тогда
		// Аванс
		
		// графа 5 - число "0" при наличии суммы налога
		
		Если ЗначенияИтого["СуммаНДСУвеличение"] > 0 Тогда
			ЗначенияПараметров.Вставить("СуммаУвеличение", "0");
		КонецЕсли;
		
		Если ЗначенияИтого["СуммаНДСУменьшение"] > 0 Тогда
			ЗначенияПараметров.Вставить("СуммаУменьшение", "0");
		КонецЕсли;
		
	ИначеЕсли ЭтоШкурыЛом Тогда
		// ШкурыЛом
		
		// графы 8, 9 - всегда прочерки
		
		ЗначенияПараметров.Вставить("СуммаНДСУвеличение",	СимволПрочерка);
		ЗначенияПараметров.Вставить("СуммаНДСУменьшение",	СимволПрочерка);
		ЗначенияПараметров.Вставить("ВсегоУвеличение",		СимволПрочерка);
		ЗначенияПараметров.Вставить("ВсегоУменьшение",		СимволПрочерка);
	КонецЕсли;
	
	ОбластьМакетаИтого.Параметры.Заполнить(ЗначенияПараметров);
	
	Если Идентификатор <> "534"
		И Идентификатор <> "2023Кв4Прослеж"
		И Идентификатор <> "1096" Тогда
		Возврат;
	КонецЕсли;
	
	// Прослеживаемость
	Если Не ДанныеДокументов.Свойство("КонтекстПечати") Тогда
		Возврат;
	КонецЕсли;
	
	Итоги = ДанныеДокументов.КонтекстПечати.Итоги;
	
	ЗначенияПараметров.Вставить("КоличествоПрослежУвеличениеВсего", Итоги.КоличествоПрослеж.Увеличение);
	ЗначенияПараметров.Вставить("КоличествоПрослежУменьшениеВсего", Итоги.КоличествоПрослеж.Уменьшение);
	
	Если ПрименяемыйИдентификаторПостановления = "2023Кв4Прослеж"
		Или ПрименяемыйИдентификаторПостановления = "1096" Тогда
		ЗначенияПараметров.Вставить("СтоимПрослежУвеличениеВсего", Итоги.СтоимПрослеж.Увеличение);
		ЗначенияПараметров.Вставить("СтоимПрослежУменьшениеВсего", Итоги.СтоимПрослеж.Уменьшение);
	КонецЕсли;
	
	ОбластьМакетаИтого.Параметры.Заполнить(ЗначенияПараметров);
	
	Итоги.КоличествоПрослеж.Увеличение = 0;
	Итоги.КоличествоПрослеж.Уменьшение = 0;
	
	Если ПрименяемыйИдентификаторПостановления = "2023Кв4Прослеж"
		Или ПрименяемыйИдентификаторПостановления = "1096" Тогда
		Итоги.СтоимПрослеж.Увеличение = 0;
		Итоги.СтоимПрослеж.Уменьшение = 0;
	КонецЕсли;
	// Конец Прослеживамость		
	
КонецПроцедуры

Процедура ПечатьКорректировочногоСчетаФактуры_ВывестиСведенияПрослеживаемостиВСтрокеТаблицы(Знач СтрокаТЧ, Знач ШапкаДокумента, ТабДокумент,
	ДанныеДокументов, Знач ПрименяемыйИдентификаторПостановления, КонтекстПечати, ПараметрыВывода, ВыводитьПустыеПодстроки = Ложь)
	
	Перем ПоказателиПрослеживаемости;
	
	СимволПрочерка = "--";
	
	ПараметрыМакетаА				= ПараметрыВывода.ПараметрыМакетаА;
	ПараметрыМакетаБ				= ПараметрыВывода.ПараметрыМакетаБ;
	ПараметрыМакетаВ				= ПараметрыВывода.ПараметрыМакетаВ;
	ПараметрыМакетаГ				= ПараметрыВывода.ПараметрыМакетаГ;
	ОбластьМакетаСтрокаДо			= ПараметрыВывода.ОбластьМакетаСтрокаДо;
	ОбластьМакетаСтрокаПосле		= ПараметрыВывода.ОбластьМакетаСтрокаПосле;
	ОбластьМакетаСтрокаУвеличение	= ПараметрыВывода.ОбластьМакетаСтрокаУвеличение;
	ОбластьМакетаСтрокаУменьшение	= ПараметрыВывода.ОбластьМакетаСтрокаУменьшение;
	
	ДанныеДокументов.Свойство("ПоказателиПрослеживаемости", ПоказателиПрослеживаемости);
	
	Если ПоказателиПрослеживаемости = Неопределено Или ТипЗнч(ПоказателиПрослеживаемости) <> Тип("ТаблицаЗначений") Тогда
		ТабДокумент.Вывести(ОбластьМакетаСтрокаДо);
		ТабДокумент.Вывести(ОбластьМакетаСтрокаПосле);
		ТабДокумент.Вывести(ОбластьМакетаСтрокаУвеличение);
		ТабДокумент.Вывести(ОбластьМакетаСтрокаУменьшение);
		
		Возврат;
	КонецЕсли;
	
	Если НЕ ДанныеДокументов.Свойство("КонтекстПечати", КонтекстПечати) Тогда
		КонтекстПечати = Новый Структура();
		
		КонтекстПечати.Вставить("ВремТабДокА",	Новый ТабличныйДокумент());
		КонтекстПечати.Вставить("ВремТабДокБ",	Новый ТабличныйДокумент());
		КонтекстПечати.Вставить("ВремТабДокВ",	Новый ТабличныйДокумент());
		КонтекстПечати.Вставить("ВремТабДокГ",	Новый ТабличныйДокумент());
		КонтекстПечати.Вставить("Поиск",		Новый Структура("Ссылка, НомерСтроки"));
		
		Итоги = Новый Структура();
		Итоги.Вставить("КоличествоПрослеж", Новый Структура("Увеличение,Уменьшение", 0, 0));
		
		Если ПрименяемыйИдентификаторПостановления = "2023Кв4Прослеж"
			Или ПрименяемыйИдентификаторПостановления = "1096" Тогда
			Итоги.Вставить("СтоимПрослеж", Новый Структура("Увеличение,Уменьшение", 0, 0));
		КонецЕсли;
		
		КонтекстПечати.Вставить("Итоги", Итоги);
		
		ИменаПараметровПрослеживаемости = Новый Структура();
		ИменаПараметровПрослеживаемости.Вставить("До",
			"ПредставлениеГТДДо,
			|ЕдиницаИзмеренияПрослежКодДо,
			|ЕдиницаИзмеренияПрослежДо,
			|КоличествоПрослежДо");
		
		ИменаПараметровПрослеживаемости.Вставить("После",
			"ПредставлениеГТДПосле,
			|ЕдиницаИзмеренияПрослежКодПосле,
			|ЕдиницаИзмеренияПрослежПосле,
			|КоличествоПрослежПосле");
				
		ИменаПараметровПрослеживаемости.Вставить("Изменение",
			"КоличествоПрослежУвеличение,
			|КоличествоПрослежУменьшение");
		
		Если ПрименяемыйИдентификаторПостановления = "2023Кв4Прослеж"
			Или ПрименяемыйИдентификаторПостановления = "1096" Тогда
			ИменаПараметровПрослеживаемости.До			= ИменаПараметровПрослеживаемости.До + ",СтоимПрослежДо";
			ИменаПараметровПрослеживаемости.После		= ИменаПараметровПрослеживаемости.После + ",СтоимПрослежПосле";
			ИменаПараметровПрослеживаемости.Изменение	= ИменаПараметровПрослеживаемости.Изменение + ",СтоимПрослежУвеличение,СтоимПрослежУменьшение,ПредставлениеГТДУвеличение,ПредставлениеГТДУменьшение";
		КонецЕсли;
		
		КонтекстПечати.Вставить("ИменаПараметровПрослеживаемости", ИменаПараметровПрослеживаемости);
		КонтекстПечати.Вставить("ОчищающаяСтруктураПрослеживаемости", Новый Структура(
			ИменаПараметровПрослеживаемости.До + ","
			+ ИменаПараметровПрослеживаемости.После + ","
			+ ИменаПараметровПрослеживаемости.Изменение));
		
		ДанныеДокументов.Вставить("КонтекстПечати", КонтекстПечати);
	КонецЕсли;
	
	ВремТабДокА	= КонтекстПечати.ВремТабДокА;
	ВремТабДокБ	= КонтекстПечати.ВремТабДокБ;
	ВремТабДокВ	= КонтекстПечати.ВремТабДокВ;
	ВремТабДокГ	= КонтекстПечати.ВремТабДокГ;
	Поиск		= КонтекстПечати.Поиск;
	Итоги		= КонтекстПечати.Итоги;
	ОчищающаяСтруктураПрослеживаемости = КонтекстПечати.ОчищающаяСтруктураПрослеживаемости;
	
	Поиск.Вставить("Ссылка", СтрокаТЧ.ДокСсылка);
	Поиск.Вставить("НомерСтроки", СтрокаТЧ.НомерСтроки);
	
	МассивСтрок = ПоказателиПрослеживаемости.НайтиСтроки(Поиск);
	
	КоличествоСтрокПрослеживаемости = МассивСтрок.Количество();
	
	Если КоличествоСтрокПрослеживаемости = 0 Тогда
		ТабДокумент.Вывести(ОбластьМакетаСтрокаДо);
		ТабДокумент.Вывести(ОбластьМакетаСтрокаПосле);
		ТабДокумент.Вывести(ОбластьМакетаСтрокаУвеличение);
		ТабДокумент.Вывести(ОбластьМакетаСтрокаУменьшение);
		
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		ЗаполнитьЗначенияСвойств(ПараметрыМакетаА, СтрокаТаблицы, КонтекстПечати.ИменаПараметровПрослеживаемости.До);

		ЗаполнитьЗначенияСвойств(ПараметрыМакетаБ, СтрокаТаблицы, КонтекстПечати.ИменаПараметровПрослеживаемости.После);
		
		КоличествоПрослежУвеличение = 0;
		КоличествоПрослежУменьшение = 0;
		
		Если СтрокаТаблицы["КоличествоПрослежДо"] > СтрокаТаблицы["КоличествоПрослежПосле"] Тогда
			КоличествоПрослежУменьшение = СтрокаТаблицы["КоличествоПрослежДо"] - СтрокаТаблицы["КоличествоПрослежПосле"];
		Иначе
			КоличествоПрослежУвеличение = СтрокаТаблицы["КоличествоПрослежПосле"] - СтрокаТаблицы["КоличествоПрослежДо"];
		КонецЕсли;
		
		Итоги.КоличествоПрослеж.Увеличение = Итоги.КоличествоПрослеж.Увеличение + КоличествоПрослежУвеличение;
		Итоги.КоличествоПрослеж.Уменьшение = Итоги.КоличествоПрослеж.Уменьшение + КоличествоПрослежУменьшение;

		ПараметрыМакетаВ["КоличествоПрослежУвеличение"] = КоличествоПрослежУвеличение;
		ПараметрыМакетаГ["КоличествоПрослежУменьшение"] = КоличествоПрослежУменьшение;
		
		СтоимПрослежУвеличение = 0;
		СтоимПрослежУменьшение = 0;
		
		Если ПрименяемыйИдентификаторПостановления = "2023Кв4Прослеж"
			Или ПрименяемыйИдентификаторПостановления = "1096" Тогда
			Если СтрокаТаблицы["СтоимПрослежДо"] > СтрокаТаблицы["СтоимПрослежПосле"] Тогда
				СтоимПрослежУменьшение = СтрокаТаблицы["СтоимПрослежДо"] - СтрокаТаблицы["СтоимПрослежПосле"];
			Иначе
				СтоимПрослежУвеличение = СтрокаТаблицы["СтоимПрослежПосле"] - СтрокаТаблицы["СтоимПрослежДо"];
			КонецЕсли;
			
			Итоги.СтоимПрослеж.Увеличение = Итоги.СтоимПрослеж.Увеличение + СтоимПрослежУвеличение;
			Итоги.СтоимПрослеж.Уменьшение = Итоги.СтоимПрослеж.Уменьшение + СтоимПрослежУменьшение;
			
			ПараметрыМакетаВ["СтоимПрослежУвеличение"] = СтоимПрослежУвеличение;
			ПараметрыМакетаГ["СтоимПрослежУменьшение"] = СтоимПрослежУменьшение;
			
			Если КоличествоПрослежУвеличение > 0 Или СтоимПрослежУвеличение > 0 Тогда
				ПредставлениеГТДУвеличение = ?(Не ПустаяСтрока(СтрокаТаблицы.ПредставлениеГТДДо), СтрокаТаблицы.ПредставлениеГТДДо, СтрокаТаблицы.ПредставлениеГТДПосле);
			Иначе
				ПредставлениеГТДУвеличение = СимволПрочерка;
			КонецЕсли;
			ПараметрыМакетаВ.ПредставлениеГТДУвеличение	= СокрЛП(ПредставлениеГТДУвеличение);
			
			Если КоличествоПрослежУменьшение > 0 Или СтоимПрослежУменьшение > 0 Тогда
				ПредставлениеГТДУменьшение = ?(Не ПустаяСтрока(СтрокаТаблицы.ПредставлениеГТДДо), СтрокаТаблицы.ПредставлениеГТДДо, СтрокаТаблицы.ПредставлениеГТДПосле);
			Иначе
				ПредставлениеГТДУменьшение = СимволПрочерка;
			КонецЕсли;
			ПараметрыМакетаГ.ПредставлениеГТДУменьшение	= СокрЛП(ПредставлениеГТДУменьшение);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПараметрыМакетаА["ПредставлениеГТДДо"]) Тогда
			ПараметрыМакетаА["ПредставлениеГТДДо"] = СокрЛП(ПараметрыМакетаА["ПредставлениеГТДДо"]);
		КонецЕсли;
			
		Если ЗначениеЗаполнено(ПараметрыМакетаБ["ПредставлениеГТДПосле"]) Тогда
			ПараметрыМакетаБ["ПредставлениеГТДПосле"] = СокрЛП(ПараметрыМакетаБ["ПредставлениеГТДПосле"]);
		КонецЕсли;
		
		Если СтрокаТаблицы.КоличествоПрослежДо <> 0 Или СтрокаТаблицы.СтоимПрослежДо <> 0 Или ВыводитьПустыеПодстроки Тогда
			ВремТабДокА.Вывести(ОбластьМакетаСтрокаДо);
		КонецЕсли;
		
		Если СтрокаТаблицы.КоличествоПрослежПосле <> 0 Или СтрокаТаблицы.СтоимПрослежПосле <> 0 Или ВыводитьПустыеПодстроки Тогда
			ВремТабДокБ.Вывести(ОбластьМакетаСтрокаПосле);
		КонецЕсли;
			
		Если КоличествоПрослежУвеличение <> 0 Или СтоимПрослежУвеличение <> 0 Или ВыводитьПустыеПодстроки Тогда
			ВремТабДокВ.Вывести(ОбластьМакетаСтрокаУвеличение);
		КонецЕсли;
			
		Если КоличествоПрослежУменьшение <> 0 Или СтоимПрослежУменьшение <> 0 Или ВыводитьПустыеПодстроки Тогда
			ВремТабДокГ.Вывести(ОбластьМакетаСтрокаУменьшение);
		КонецЕсли;
	КонецЦикла;
	
	Если ВремТабДокА.ВысотаТаблицы > 1 Тогда
		ОбъединитьЯчейкиПоВысоте(ВремТабДокА, 2, 16);
	ИначеЕсли ВремТабДокА.ВысотаТаблицы = 0 Тогда
		ОчищающаяСтруктура = Новый Структура();
		ОчищающаяСтруктура.Вставить("ПредставлениеГТДДо",			СимволПрочерка);
		ОчищающаяСтруктура.Вставить("ЕдиницаИзмеренияПрослежКодДо",	СимволПрочерка);
		ОчищающаяСтруктура.Вставить("ЕдиницаИзмеренияПрослежДо",	СимволПрочерка);
		ОчищающаяСтруктура.Вставить("КоличествоПрослежДо",			0);
		ОчищающаяСтруктура.Вставить("СтоимПрослежДо",				0);
		
		ЗаполнитьЗначенияСвойств(ПараметрыМакетаА, ОчищающаяСтруктура);
		
		ВремТабДокА.Вывести(ОбластьМакетаСтрокаДо);
	КонецЕсли;
	
	Если ВремТабДокБ.ВысотаТаблицы > 1 Тогда
		ОбъединитьЯчейкиПоВысоте(ВремТабДокБ, 2, 16);
	ИначеЕсли ВремТабДокБ.ВысотаТаблицы = 0 Тогда
		ОчищающаяСтруктура = Новый Структура();
		ОчищающаяСтруктура.Вставить("ПредставлениеГТДПосле",			СимволПрочерка);
		ОчищающаяСтруктура.Вставить("ЕдиницаИзмеренияПрослежКодПосле",	СимволПрочерка);
		ОчищающаяСтруктура.Вставить("ЕдиницаИзмеренияПрослежПосле",		СимволПрочерка);
		ОчищающаяСтруктура.Вставить("КоличествоПрослежПосле",			0);
		ОчищающаяСтруктура.Вставить("СтоимПрослежПосле",				0);
		
		ЗаполнитьЗначенияСвойств(ПараметрыМакетаБ, ОчищающаяСтруктура);
		
		ВремТабДокБ.Вывести(ОбластьМакетаСтрокаПосле);
	КонецЕсли;
	
	Если ВремТабДокВ.ВысотаТаблицы > 1 Тогда
		ОбъединитьЯчейкиПоВысоте(ВремТабДокВ, 2, 16);
	ИначеЕсли ВремТабДокВ.ВысотаТаблицы = 0 Тогда
		ОчищающаяСтруктура = Новый Структура();
		ОчищающаяСтруктура.Вставить("ПредставлениеГТДУвеличение",	СимволПрочерка);
		ОчищающаяСтруктура.Вставить("КоличествоПрослежУвеличение",	0);
		ОчищающаяСтруктура.Вставить("СтоимПрослежУвеличение",		0);
		
		ЗаполнитьЗначенияСвойств(ПараметрыМакетаВ, ОчищающаяСтруктура);
		
		ВремТабДокВ.Вывести(ОбластьМакетаСтрокаУвеличение);
	КонецЕсли;
	
	Если ВремТабДокГ.ВысотаТаблицы > 1 Тогда
		ОбъединитьЯчейкиПоВысоте(ВремТабДокГ, 2, 16);
	ИначеЕсли ВремТабДокГ.ВысотаТаблицы = 0 Тогда
		ОчищающаяСтруктура = Новый Структура();
		ОчищающаяСтруктура.Вставить("ПредставлениеГТДУменьшение",	СимволПрочерка);
		ОчищающаяСтруктура.Вставить("КоличествоПрослежУменьшение",	0);
		ОчищающаяСтруктура.Вставить("СтоимПрослежУменьшение",		0);
		
		ЗаполнитьЗначенияСвойств(ПараметрыМакетаГ, ОчищающаяСтруктура);
		
		ВремТабДокГ.Вывести(ОбластьМакетаСтрокаУменьшение);
	КонецЕсли;
	
	ТабДокумент.Вывести(ВремТабДокА);
	ТабДокумент.Вывести(ВремТабДокБ);
	ТабДокумент.Вывести(ВремТабДокВ);
	ТабДокумент.Вывести(ВремТабДокГ);
	
	ЗаполнитьЗначенияСвойств(ПараметрыМакетаА, ОчищающаяСтруктураПрослеживаемости);
	ЗаполнитьЗначенияСвойств(ПараметрыМакетаБ, ОчищающаяСтруктураПрослеживаемости);
	ЗаполнитьЗначенияСвойств(ПараметрыМакетаВ, ОчищающаяСтруктураПрослеживаемости);
	ЗаполнитьЗначенияСвойств(ПараметрыМакетаГ, ОчищающаяСтруктураПрослеживаемости);
	
	ВремТабДокА.Очистить();
	ВремТабДокБ.Очистить();
	ВремТабДокВ.Очистить();
	ВремТабДокГ.Очистить();
	
КонецПроцедуры

Процедура ОбъединитьЯчейкиПоВысоте(ТабДокумент, ПерваяКолонка, ПоследняяКолонка) Экспорт
	
	НомерПоследнейСтроки = ТабДокумент.ВысотаТаблицы;
	
	Для НомерКолонки = ПерваяКолонка По ПоследняяКолонка Цикл
		Область = ТабДокумент.Область(1, НомерКолонки, НомерПоследнейСтроки, НомерКолонки);
		
		Область.Объединить();
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область АвтоустановкаСубконто

Процедура АвтоустановкаСубконто_Инициализация(Форма, ПереданныйМассивНастроек, ОтмечатьЗначенияСовпадающиеСАвтоустановкой = Истина, ОтмечатьНезаполненныеСубконто = Истина) Экспорт
	
	Перем	МассивНастроек,
			МассивИдентификаторов,
			Идентификатор,
			ИмяЭлементаСчет,
			ИмяЭлементаСубконто1,
			ИмяЭлементаСубконто2,
			ИмяЭлементаСубконто3,
			ЗначенияАвтоустановки,
			ЗначенияАвтоустановкиВТаблице,
			ЗависимыеЭлементыАвтоустановки,
			МассивОтмечатьНаличиеВидовСубконто,
			ОтмечатьНаличиеВидовСубконтоСтрока;
	
	// Микро входная проверка:
	Если ТипЗнч(ПереданныйМассивНастроек) = Тип("Структура") Тогда
		МассивНастроек = Новый Массив();
		МассивНастроек.Добавить(ПереданныйМассивНастроек);
	ИначеЕсли ТипЗнч(ПереданныйМассивНастроек) = Тип("Массив") Тогда
		МассивНастроек = ПереданныйМассивНастроек;
	Иначе
		// Выходим:
		Возврат;
	КонецЕсли;
	
	МассивИдентификаторов = Новый Массив();
	ИспользоватьУОЭлементовСубконто = (ОтмечатьЗначенияСовпадающиеСАвтоустановкой = Истина ИЛИ ОтмечатьНезаполненныеСубконто = Истина);
	
	ТипСтрока	= Новый ОписаниеТипов("Строка");
	ТипБулево	= Новый ОписаниеТипов("Булево");
	ТипЧисло	= Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(1, 0, ДопустимыйЗнак.Неотрицательный));
	ТипТЗ		= Новый ОписаниеТипов("ТаблицаЗначений");
	ТипСтруктура	= Новый ОписаниеТипов("Структура");
	
	// ОБЩИЕ НАСТРОЙКИ
	// (элементы "счет" и элементы "значение автоустановки")
	ОбщаяТаблицаНастроек = Новый ТаблицаЗначений();
	// Для элементов обоих видов:
	ОбщаяТаблицаНастроек.Колонки.Добавить("Идентификатор",							ТипЧисло);
	ОбщаяТаблицаНастроек.Колонки.Добавить("ИмяЭлемента",							ТипСтрока);
	ОбщаяТаблицаНастроек.Колонки.Добавить("ЭтоЭлементСчет",							ТипБулево);
	ОбщаяТаблицаНастроек.Колонки.Добавить("ЭтоЭлементЗначениеАвтоустановки",		ТипБулево);
	ОбщаяТаблицаНастроек.Колонки.Добавить("ИмяРеквизитаТаблица",					ТипСтрока);
	ОбщаяТаблицаНастроек.Колонки.Добавить("ИмяЭлементаТаблица",						ТипСтрока);
	ОбщаяТаблицаНастроек.Колонки.Добавить("ВременнаяКолонка",						ТипСтруктура); // будет удалена после инициализации
	// Только для элементов "счет":
	ОбщаяТаблицаНастроек.Колонки.Добавить("ТаблицаНастроекСчетИСубконто",			ТипТЗ);
	ОбщаяТаблицаНастроек.Колонки.Добавить("ТаблицаНастроекЗначенияАвтоустановки",	ТипТЗ);
	ОбщаяТаблицаНастроек.Колонки.Добавить("ИмяЭлементаОбрабатываемаяТаблица",		ТипСтрока);
	ОбщаяТаблицаНастроек.Колонки.Добавить("ЗависимыеЭлементыАвтоустановки",				Новый ОписаниеТипов()); // будет Структура
	ОбщаяТаблицаНастроек.Колонки.Добавить("МассивОтмечатьНаличиеВидовСубконтоСтрока",	Новый ОписаниеТипов()); // будет Массив
	ОбщаяТаблицаНастроек.Колонки.Добавить("МассивОтмечатьНаличиеВидовСубконто",			Новый ОписаниеТипов()); // будет Массив
	// Только для элементов "значение автоустановки":
	ОбщаяТаблицаНастроек.Колонки.Добавить("ИменаЭлементовСчет",							Новый ОписаниеТипов()); // будет Массив
	
	// НАСТРОЙКИ ЭЛЕМЕНТОВ СУБКОНТО
	ТаблицаЭлементыСубконто = Новый ТаблицаЗначений();
	ТаблицаЭлементыСубконто.Колонки.Добавить("Идентификатор",			ТипЧисло);
	ТаблицаЭлементыСубконто.Колонки.Добавить("ИмяЭлемента",				ТипСтрока);
	ТаблицаЭлементыСубконто.Колонки.Добавить("ИмяРеквизитаОтметить",	ТипСтрока);
	ТаблицаЭлементыСубконто.Колонки.Добавить("ИмяЭлементаТаблица",		ТипСтрока);
	ТаблицаЭлементыСубконто.Колонки.Добавить("ИмяЭлементаСчет",			ТипСтрока);
	
	// Служебная, для дальнейшего создания служебных колонок в редактируемых таблицах:
	ТаблицаОтмечатьНаличиеВидовСубконто = Новый ТаблицаЗначений();
	ТаблицаОтмечатьНаличиеВидовСубконто.Колонки.Добавить("ИмяРеквизитаНомерСубконто",	ТипСтрока);
	ТаблицаОтмечатьНаличиеВидовСубконто.Колонки.Добавить("ПолноеИмяРеквизитаТаблица",	ТипСтрока);
	
	// Колонки с типами для дальнейшего создания реквизитов формы:
	КолонкиДляТаблицыНастроекСчетИСубконто			= Новый Структура();
	КолонкиДляТаблицыНастроекЗначенияАвтоустановки	= Новый Структура();
	
	ТекстОшибкаИнициализацииМеханизма = НСтр("ru='Ошибка при инициализации механизма ""Автоустановка субконто""'");
	
	// Входная проверка и заполнение общей таблицы настроек:
	Для Каждого СтруктураНастроек Из МассивНастроек Цикл
		
		Если ТипЗнч(СтруктураНастроек) <> Тип("Структура") Тогда
			ВызватьИсключение НСтр("ru='Ошибка при инициализации механизма ""Автоустановка субконто"".
				|Настройки механизма должны передаваться с виде структуры или массива структур.'");
		КонецЕсли;
		
		// Обязательный элемент "Счет"
		АвтоустановкаСубконто_ПроверитьОбязательныйПараметр(СтруктураНастроек, "Счет", ИмяЭлементаСчет, Форма);
		
		// Обязательные элементы "Субконто"
		АвтоустановкаСубконто_ПроверитьОбязательныйПараметр(СтруктураНастроек, "Субконто1", ИмяЭлементаСубконто1, Форма);
		АвтоустановкаСубконто_ПроверитьОбязательныйПараметр(СтруктураНастроек, "Субконто2", ИмяЭлементаСубконто2, Форма);
		АвтоустановкаСубконто_ПроверитьОбязательныйПараметр(СтруктураНастроек, "Субконто3", ИмяЭлементаСубконто3, Форма);
		
		// Здесь проверено, что элементы формы для счета и субконто существуют.
		
		Если НЕ СтруктураНастроек.Свойство("Идентификатор", Идентификатор) Тогда
			Идентификатор = 0;
		КонецЕсли;
		Если МассивИдентификаторов.Найти(Идентификатор) = Неопределено Тогда
			МассивИдентификаторов.Добавить(Идентификатор);
		КонецЕсли;
		
		Если СтруктураНастроек.Свойство("ЗависимыеЭлементыАвтоустановки", ЗависимыеЭлементыАвтоустановки) Тогда
			// Преобразовываем в массив для дальнейшего удобства использования.
			ВремСтруктура = Новый Структура();
			Для Каждого ЗависимыйЭлемент Из ЗависимыеЭлементыАвтоустановки Цикл
				ВремСтруктура.Вставить(
					ЗависимыйЭлемент.Ключ,
					СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(ЗависимыйЭлемент.Значение));
			КонецЦикла;
			ЗависимыеЭлементыАвтоустановки = ВремСтруктура;
		Иначе
			ЗависимыеЭлементыАвтоустановки = Новый Структура();
		КонецЕсли;
		
		Если СтруктураНастроек.Свойство("ОтмечатьНаличиеВидовСубконтоСтрока", ОтмечатьНаличиеВидовСубконтоСтрока) Тогда
			// Преобразовываем в массив для дальнейшего удобства использования.
			МассивОтмечатьНаличиеВидовСубконтоСтрока	= СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(ОтмечатьНаличиеВидовСубконтоСтрока);
			МассивОтмечатьНаличиеВидовСубконто			= Новый Массив();
			Для Каждого ВидСубконтоСтрока Из МассивОтмечатьНаличиеВидовСубконтоСтрока Цикл
				МассивОтмечатьНаличиеВидовСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто[ВидСубконтоСтрока]);
			КонецЦикла;
		Иначе
			МассивОтмечатьНаличиеВидовСубконтоСтрока	= Новый Массив();
			МассивОтмечатьНаличиеВидовСубконто			= Новый Массив();
		КонецЕсли;
		
		МассивИменЭлементов = Новый Массив();
		МассивИменЭлементов.Добавить(ИмяЭлементаСчет);
		МассивИменЭлементов.Добавить(ИмяЭлементаСубконто1);
		МассивИменЭлементов.Добавить(ИмяЭлементаСубконто2);
		МассивИменЭлементов.Добавить(ИмяЭлементаСубконто3);
		ТаблицаНастроекСчетИСубконто = АвтоустановкаСубконто_ИнициализироватьТаблицуНастроек(Форма, МассивИменЭлементов);
		
		// Опциональные элементы или значения для автоустановки:
		ТаблицаНастроекЗначенияАвтоустановки = Неопределено;
		Если СтруктураНастроек.Свойство("ЗначенияАвтоустановки", ЗначенияАвтоустановки) Тогда
			Если ТипЗнч(ЗначенияАвтоустановки) = Тип("Соответствие") Тогда
				ТаблицаНастроекЗначенияАвтоустановки = АвтоустановкаСубконто_ИнициализироватьТаблицуНастроек(Форма, , ЗначенияАвтоустановки);
			КонецЕсли;
		КонецЕсли;
		
		НоваяСтрокаОбщейТаблицы = ОбщаяТаблицаНастроек.Добавить();
		НоваяСтрокаОбщейТаблицы["Идентификатор"]						= Идентификатор;
		НоваяСтрокаОбщейТаблицы["ИмяЭлемента"]							= ИмяЭлементаСчет;
		НоваяСтрокаОбщейТаблицы["ЭтоЭлементСчет"]						= Истина;
		НоваяСтрокаОбщейТаблицы["ИмяЭлементаОбрабатываемаяТаблица"]		= ТаблицаНастроекСчетИСубконто[1]["ИмяЭлементаТаблица"];
		НоваяСтрокаОбщейТаблицы["ТаблицаНастроекСчетИСубконто"]			= ТаблицаНастроекСчетИСубконто;
		НоваяСтрокаОбщейТаблицы["ТаблицаНастроекЗначенияАвтоустановки"]	= ТаблицаНастроекЗначенияАвтоустановки;
		НоваяСтрокаОбщейТаблицы["ИменаЭлементовСчет"]					= Новый ФиксированныйМассив(Новый Массив());
		НоваяСтрокаОбщейТаблицы["ЗависимыеЭлементыАвтоустановки"]		= ЗависимыеЭлементыАвтоустановки;
		НоваяСтрокаОбщейТаблицы["МассивОтмечатьНаличиеВидовСубконтоСтрока"]	= МассивОтмечатьНаличиеВидовСубконтоСтрока;
		НоваяСтрокаОбщейТаблицы["МассивОтмечатьНаличиеВидовСубконто"]			= МассивОтмечатьНаличиеВидовСубконто;
		
		// Запоминаем сведения во временной колонке для дальнейшего использования
		ДопУсловиеОтметкиНезаполненныхСубконто = Неопределено;
		Если СтруктураНастроек.Свойство("ДопУсловиеОтметкиНезаполненныхСубконто", ДопУсловиеОтметкиНезаполненныхСубконто) Тогда
			НоваяСтрокаОбщейТаблицы["ВременнаяКолонка"].Вставить("ДопУсловиеОтметкиНезаполненныхСубконто", ДопУсловиеОтметкиНезаполненныхСубконто);
		КонецЕсли;
		
		АвтоустановкаСубконто_ОбновитьСоставКолонокТаблицы(КолонкиДляТаблицыНастроекСчетИСубконто,			ТаблицаНастроекСчетИСубконто);
		АвтоустановкаСубконто_ОбновитьСоставКолонокТаблицы(КолонкиДляТаблицыНастроекЗначенияАвтоустановки,	ТаблицаНастроекЗначенияАвтоустановки);
		
		// Элемент субконто 1:
		НоваяСтрока = ТаблицаЭлементыСубконто.Добавить();
		НоваяСтрока["Идентификатор"]		= Идентификатор;
		НоваяСтрока["ИмяЭлемента"]			= ИмяЭлементаСубконто1;
		НоваяСтрока["ИмяЭлементаТаблица"]	= ТаблицаНастроекСчетИСубконто[1]["ИмяЭлементаТаблица"];
		НоваяСтрока["ИмяЭлементаСчет"]		= ИмяЭлементаСчет;
		// Элемент субконто 2:
		НоваяСтрока = ТаблицаЭлементыСубконто.Добавить();
		НоваяСтрока["Идентификатор"]		= Идентификатор;
		НоваяСтрока["ИмяЭлемента"]			= ИмяЭлементаСубконто2;
		НоваяСтрока["ИмяЭлементаТаблица"]	= ТаблицаНастроекСчетИСубконто[2]["ИмяЭлементаТаблица"];
		НоваяСтрока["ИмяЭлементаСчет"]		= ИмяЭлементаСчет;
		// Элемент субконто 3:
		НоваяСтрока = ТаблицаЭлементыСубконто.Добавить();
		НоваяСтрока["Идентификатор"]		= Идентификатор;
		НоваяСтрока["ИмяЭлемента"]			= ИмяЭлементаСубконто3;
		НоваяСтрока["ИмяЭлементаТаблица"]	= ТаблицаНастроекСчетИСубконто[3]["ИмяЭлементаТаблица"];
		НоваяСтрока["ИмяЭлементаСчет"]		= ИмяЭлементаСчет;
		
		ИмяРеквизитаСчет = ТаблицаНастроекСчетИСубконто[0]["ИмяРеквизита"];
		СтрокаНастроекСубконто1 = ТаблицаНастроекСчетИСубконто[1];
		Для Каждого ВидСубконтоСтрока Из МассивОтмечатьНаличиеВидовСубконтоСтрока Цикл
			НоваяСтрока = ТаблицаОтмечатьНаличиеВидовСубконто.Добавить();
			НоваяСтрока["ИмяРеквизитаНомерСубконто"]	= "АвтоустановкаСубконто_" + ИмяРеквизитаСчет + "_НомерСубконтоВида_" + ВидСубконтоСтрока;
			НоваяСтрока["ПолноеИмяРеквизитаТаблица"]	= ?(СтрокаНастроекСубконто1["ЭтоРеквизитОбъекта"],
				"Объект.", "")
				+ СтрокаНастроекСубконто1["ИмяРеквизитаТаблица"];
		КонецЦикла;
		
	КонецЦикла;
	
	// (подготовка) Условное оформление полей субконто в таблицах
	Если ИспользоватьУОЭлементовСубконто Тогда
		ТаблицаУОСубконто = Новый ТаблицаЗначений();
		ТаблицаУОСубконто.Колонки.Добавить("ИмяРеквизитаСчет",						ТипСтрока);
		ТаблицаУОСубконто.Колонки.Добавить("ИмяРеквизитаТаблица",					ТипСтрока);
		ТаблицаУОСубконто.Колонки.Добавить("ИмяРеквизитаОтметить",					ТипСтрока);
		ТаблицаУОСубконто.Колонки.Добавить("ПолноеИмяРеквизитаСчет",				ТипСтрока);
		ТаблицаУОСубконто.Колонки.Добавить("ПолноеИмяРеквизитаТаблица",				ТипСтрока);
		ТаблицаУОСубконто.Колонки.Добавить("ПолноеИмяРеквизитаОтметить",			ТипСтрока);
		ТаблицаУОСубконто.Колонки.Добавить("ИмяЭлементаСубконто",					ТипСтрока);
		ТаблицаУОСубконто.Колонки.Добавить("ПолноеИмяРеквизитаСубконто",			ТипСтрока);
		ТаблицаУОСубконто.Колонки.Добавить("ИмяРеквизитаКоличествоСубконто",		ТипСтрока);
		ТаблицаУОСубконто.Колонки.Добавить("ПолноеИмяРеквизитаКоличествоСубконто",	ТипСтрока);
		ТаблицаУОСубконто.Колонки.Добавить("ДопУсловиеОтметкиНезаполненныхСубконто", Новый ОписаниеТипов()); // будет Структура
	КонецЕсли;
	
	// Добавляем сведения об элементах значений автоустановки в Общую таблицу.
	// Для каждого элемента значения автоустановки определяем массив элементов счетов,
	// которым соответствует это значение автоустановки.
	ТаблицаЭлементовАвтоустановки = Новый ТаблицаЗначений();
	ТаблицаЭлементовАвтоустановки.Колонки.Добавить("Идентификатор",						ТипЧисло);
	ТаблицаЭлементовАвтоустановки.Колонки.Добавить("ИмяЭлементаСчет",					ТипСтрока);
	ТаблицаЭлементовАвтоустановки.Колонки.Добавить("ИмяЭлементаЗначениеАвтоустановки",	ТипСтрока);
	ТаблицаЭлементовАвтоустановки.Колонки.Добавить("ИмяРеквизитаТаблица",				ТипСтрока);
	ТаблицаЭлементовАвтоустановки.Колонки.Добавить("ИмяЭлементаТаблица",				ТипСтрока);
	ТаблицаЭлементыАвтоустановкиВТаблице = Новый ТаблицаЗначений();
	ТаблицаЭлементыАвтоустановкиВТаблице.Колонки.Добавить("ВидСубконто",					Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто"));
	ТаблицаЭлементыАвтоустановкиВТаблице.Колонки.Добавить("ОписаниеТиповВидаСубконто",		Новый ОписаниеТипов("ОписаниеТипов"));
	ТаблицаЭлементыАвтоустановкиВТаблице.Колонки.Добавить("ИмяЭлемента",					ТипСтрока);
	ТаблицаЭлементыАвтоустановкиВТаблице.Колонки.Добавить("ИмяРеквизита",					ТипСтрока);
	ТаблицаЭлементыАвтоустановкиВТаблице.Колонки.Добавить("ИмяРеквизитаНомерСубконто",		ТипСтрока);
	ТаблицаЭлементыАвтоустановкиВТаблице.Колонки.Добавить("ИмяРеквизитаСубконто1",			ТипСтрока);
	ТаблицаЭлементыАвтоустановкиВТаблице.Колонки.Добавить("ИмяРеквизитаСубконто2",			ТипСтрока);
	ТаблицаЭлементыАвтоустановкиВТаблице.Колонки.Добавить("ИмяРеквизитаСубконто3",			ТипСтрока);
	ТаблицаЭлементыАвтоустановкиВТаблице.Колонки.Добавить("ИмяРеквизитаОтметитьСубконто1",	ТипСтрока);
	ТаблицаЭлементыАвтоустановкиВТаблице.Колонки.Добавить("ИмяРеквизитаОтметитьСубконто2",	ТипСтрока);
	ТаблицаЭлементыАвтоустановкиВТаблице.Колонки.Добавить("ИмяРеквизитаОтметитьСубконто3",	ТипСтрока);
	Поиск = Новый Структура("ЭтоЭлементСчет", Истина);
	МассивСтрок = ОбщаяТаблицаНастроек.НайтиСтроки(Поиск);
	Для Каждого СтрокаОбщейТаблицы Из МассивСтрок Цикл
		// Дозаполняем колонки для строки элемента-счета:
		ИменаРеквизитовЭлемента = АвтоустановкаСубконто_ПолучитьИменаРеквизитовЭлемента(Форма, СтрокаОбщейТаблицы["ИмяЭлемента"]);
		ЗаполнитьЗначенияСвойств(СтрокаОбщейТаблицы, ИменаРеквизитовЭлемента, "ИмяРеквизитаТаблица,ИмяЭлементаТаблица");
		
		// Выбираем только значения, кот. задаются элементами формы:
		Поиск = Новый Структура("Значение", Неопределено);
		МассивСтрокЭлементыАвтоустановки = СтрокаОбщейТаблицы["ТаблицаНастроекЗначенияАвтоустановки"].НайтиСтроки(Поиск);
		Для Каждого СтрокаЭлементАвтоустановки Из МассивСтрокЭлементыАвтоустановки Цикл
			ИмяЭлементаЗначениеАвтоустановки = СтрокаЭлементАвтоустановки["ИмяЭлемента"];
			
			НоваяСтрока = ТаблицаЭлементовАвтоустановки.Добавить();
			НоваяСтрока["Идентификатор"]					= СтрокаОбщейТаблицы["Идентификатор"];
			НоваяСтрока["ИмяЭлементаСчет"]					= СтрокаОбщейТаблицы["ИмяЭлемента"];
			НоваяСтрока["ИмяЭлементаЗначениеАвтоустановки"]	= ИмяЭлементаЗначениеАвтоустановки;
			НоваяСтрока["ИмяРеквизитаТаблица"]				= СтрокаЭлементАвтоустановки["ИмяРеквизитаТаблица"];
			НоваяСтрока["ИмяЭлементаТаблица"]				= СтрокаОбщейТаблицы["ИмяЭлементаТаблица"];
			
			Если СтрокаЭлементАвтоустановки["ЭтоРеквизитТаблицы"] Тогда
				ВидСубконто = СтрокаЭлементАвтоустановки["ВидСубконто"];
				ВидСубконтоИндекс = СтрокаОбщейТаблицы["МассивОтмечатьНаличиеВидовСубконто"].Найти(ВидСубконто);
				Если ВидСубконтоИндекс = Неопределено Тогда
					СтрокаОбщейТаблицы["МассивОтмечатьНаличиеВидовСубконто"].Добавить(ВидСубконто);
					ВидСубконтоСтрока = "Номенклатура";
					СтрокаОбщейТаблицы["МассивОтмечатьНаличиеВидовСубконтоСтрока"].Добавить(ВидСубконтоСтрока);
				Иначе
					ВидСубконтоСтрока = СтрокаОбщейТаблицы["МассивОтмечатьНаличиеВидовСубконтоСтрока"][ВидСубконтоИндекс];
				КонецЕсли;
				ИмяРеквизитаСчет			= СтрокаОбщейТаблицы["ТаблицаНастроекСчетИСубконто"][0]["ИмяРеквизита"];
				ИмяРеквизитаНомерСубконто	= "АвтоустановкаСубконто_" + ИмяРеквизитаСчет + "_НомерСубконтоВида_" + ВидСубконтоСтрока;
				
				ИмяРеквизитаСубконто1 = СтрокаОбщейТаблицы["ТаблицаНастроекСчетИСубконто"][1]["ИмяРеквизита"];
				ИмяРеквизитаСубконто2 = СтрокаОбщейТаблицы["ТаблицаНастроекСчетИСубконто"][2]["ИмяРеквизита"];
				ИмяРеквизитаСубконто3 = СтрокаОбщейТаблицы["ТаблицаНастроекСчетИСубконто"][3]["ИмяРеквизита"];
				НоваяСтрока = ТаблицаЭлементыАвтоустановкиВТаблице.Добавить();
				НоваяСтрока["ВидСубконто"]						= ВидСубконто;
				НоваяСтрока["ОписаниеТиповВидаСубконто"]		= ВидСубконто.ТипЗначения;
				НоваяСтрока["ИмяЭлемента"]						= ИмяЭлементаЗначениеАвтоустановки;
				НоваяСтрока["ИмяРеквизита"]						= СтрокаЭлементАвтоустановки["ИмяРеквизита"];
				НоваяСтрока["ИмяРеквизитаНомерСубконто"]		= ИмяРеквизитаНомерСубконто;
				НоваяСтрока["ИмяРеквизитаСубконто1"]			= ИмяРеквизитаСубконто1;
				НоваяСтрока["ИмяРеквизитаСубконто2"]			= ИмяРеквизитаСубконто2;
				НоваяСтрока["ИмяРеквизитаСубконто3"]			= ИмяРеквизитаСубконто3;
				НоваяСтрока["ИмяРеквизитаОтметитьСубконто1"]	= "АвтоустановкаСубконто_Отметить" + ИмяРеквизитаСубконто1;
