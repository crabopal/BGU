	|	И ГрузополучательЮридическоеФизическоеЛицо <> НЕОПРЕДЕЛЕНО
	|;";
	
	РезультатыЗапроса = ЗапросПоиск.ВыполнитьПакет();
	
	Результат = Новый Структура();
	
	// [5]. Расширенная шапка документа
	Результат.Вставить("ШапкаДокументаРасширенная", РезультатыЗапроса[5].Выгрузить()[0]);
	
