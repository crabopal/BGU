Процедура ЗаполнитьКолонкуКодВидаТовара(ДокументОбъект) Экспорт
	
	МассивНоменклатуры = Новый Массив();
	
	Для Каждого СтрокаТаблицы Из ДокументОбъект["СоставНФА"] Цикл
		НФА = СтрокаТаблицы["НФА"];
		
		Если ТипЗнч(НФА) = Тип("СправочникСсылка.Номенклатура") Тогда
			МассивНоменклатуры.Добавить(НФА);
		КонецЕсли;
	КонецЦикла;
	
	Если МассивНоменклатуры.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	КодыТНВЭД = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(МассивНоменклатуры, "КодТНВЭД");
	
	Для Каждого СтрокаТаблицы Из ДокументОбъект["СоставНФА"] Цикл
		НФА = СтрокаТаблицы["НФА"];
		
		Если ТипЗнч(НФА) = Тип("СправочникСсылка.Номенклатура") Тогда
			КодВидаТовара = КодыТНВЭД.Получить(НФА);
		Иначе
			КодВидаТовара = "";
		КонецЕсли;
		
		СтрокаТаблицы["КодВидаТовара"] = КодВидаТовара;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьРеквизитКодыВидовТоваров(ДокументОбъект) Экспорт
	
	СимволРазделитель = ";";
	
	КодыВидовТоваров = "";
	
	Для Каждого СтрокаТаблицы Из ДокументОбъект["СоставНФА"] Цикл
		КодВидаТовара = СтрокаТаблицы["КодВидаТовара"];
		
		Если НЕ ЗначениеЗаполнено(КодВидаТовара) Тогда
			Продолжить;
		КонецЕсли;
		
		КодыВидовТоваров = КодыВидовТоваров
			+ ?(ЗначениеЗаполнено(КодыВидовТоваров), СимволРазделитель, "")
			+ КодВидаТовара;
	КонецЦикла;
	
	ДокументОбъект["КодыВидовТоваров"] = КодыВидовТоваров;
	
КонецПроцедуры

// Параметр для РазбитьПоДатамЗачетаАвансаПолученного() и РазбитьПоДатамЗачетаАвансаВыданного().
Функция НовыйПараметрыПоискаЗачетаАванса() Экспорт
	
	ПараметрыПоиска = Новый Структура();
	// Будут искаться обороты зачета аванса до конца дня указанной даты.
	ПараметрыПоиска.Вставить("Дата", '00010101');
	// По этой организации будет отбор, для нее будет определена дата перехода на приказ 64н
	// и соотвественно дата начала применения документов расчетов.
	ПараметрыПоиска.Вставить("Организация", Справочники.Организации.ПустаяСсылка());
	// Будут исключены движения этого документа-регистратора при поиске уже заявленных вычетов сумм налога.
	ПараметрыПоиска.Вставить("Ссылка", Неопределено);
	
	Возврат ПараметрыПоиска;
	
КонецФункции

Функция РазбитьПоДатамЗачетаАвансаПолученного(Знач ТаблицаАвансов, Знач ПараметрыПоиска, Знач АвансыКомиссионера = Ложь,
		Знач СписокДокументовЗачетаАванса = Неопределено, СчетаФактурыНаОтгрузку = Неопределено) Экспорт
	
	ЭтоПолученныеАвансы = Истина;
	
	Возврат РазбитьПоДатамЗачетаИВозвратаАванса(
		ТаблицаАвансов,
		ПараметрыПоиска.Дата,
		ПараметрыПоиска.Организация,
		ПараметрыПоиска.Ссылка,
		ЭтоПолученныеАвансы,
		АвансыКомиссионера,
		СписокДокументовЗачетаАванса,
		СчетаФактурыНаОтгрузку);
	
КонецФункции

Функция РазбитьПоДатамЗачетаАвансаВыданного(ТаблицаАвансов, ДокументОбъект) Экспорт
	
	ТаблицаАвансов.Колонки.Добавить("ДокументРасчетов");
	
	ЭтоПолученныеАвансы = Ложь;
	
	Возврат РазбитьПоДатамЗачетаИВозвратаАванса(
		ТаблицаАвансов,
		ДокументОбъект.Дата,
		ДокументОбъект.Организация,
		ДокументОбъект.Ссылка,
		ЭтоПолученныеАвансы);
		
КонецФункции

Процедура РассчитатьКолонкуСуммаБезНДС(ТаблицаАвансов) Экспорт
	
	Для Каждого СтрокаТаблицы Из ТаблицаАвансов Цикл
		СтрокаТаблицы["СуммаБезНДС"]			= СтрокаТаблицы["Всего"] - СтрокаТаблицы["СуммаНДС"];
		СтрокаТаблицы["СуммаБезНДСВалютная"]	= СтрокаТаблицы["ВсегоВалютная"] - СтрокаТаблицы["СуммаНДСВалютная"];
	КонецЦикла;
	
КонецПроцедуры

Процедура АннулироватьОстаткиВходящегоНДС(СчетФактура, НовыйПериод, Движения) Экспорт
	
	// Для аннулирования используем остатки по счету-фактуре.
	// Дополнительно в этих движениях изменяем:
	//	Период		- устанавливаем новое значение (текущая дата)
	//	ВидДвижения	- Расход
	
	Остатки = УчетНДС.ПолучитьОстаткиПоСчетуФактуре(
		СчетФактура,
		"ВходящийНДС, ВходящийНДСКРаспределению",
		НовыйПериод);
	
	ИзменяемыеСвойства = Новый Структура();
	ИзменяемыеСвойства.Вставить("Период",		НовыйПериод);
	ИзменяемыеСвойства.Вставить("ВидДвижения",	ВидДвиженияНакопления.Расход);
	
	Для Каждого ЭлементДвижений Из Остатки Цикл
		ИмяРегистраНакопления	= ЭлементДвижений.Ключ;
		ТаблицаДвижений			= ЭлементДвижений.Значение;
		
		Для Каждого СтрокаТаблицы Из ТаблицаДвижений Цикл
			ДвижениеСторно = Движения[ИмяРегистраНакопления].Добавить();
			
			ЗаполнитьЗначенияСвойств(ДвижениеСторно, СтрокаТаблицы);
			
			ЗаполнитьЗначенияСвойств(ДвижениеСторно, ИзменяемыеСвойства);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Функция СформироватьЭлектронныеДокументы(ВыгружаемыеДокументы, УникальныйИдентификатор = Неопределено) Экспорт
	
	Возврат Новый Соответствие();
	
