	// Строка 020
	ДобавитьСтрокуРасшифровки_2019Кв1(ТаблицаРасшифровки,
		"П000300002003",
		"Строка 020 (раздел 3) ""Реализация (передача для собственных нужд) товаров (работ, услуг), передача имущественных, всего (10%), налоговая база""",
		"", "Строка 020 (налоговая база)", Раздел3.П000300002003,
