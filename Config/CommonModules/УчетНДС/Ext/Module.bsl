	// НАСТРАИВАЕМ ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ
	
	Попытка
		// Форма в целом:
		ИмяСобытия		= "ПослеЗаписиНаСервере";
