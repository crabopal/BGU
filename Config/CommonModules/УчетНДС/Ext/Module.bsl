		КонецЦикла;
	Исключение
	КонецПопытки;
	
	// УСЛОВНОЕ ОФОРМЛЕНИЕ
	Если ОтмечатьЗначенияСовпадающиеСАвтоустановкой Тогда
		Для Каждого СтрокаТаблицы Из ТаблицаУОСубконто Цикл
			НовыйЭлементУО = Форма.УсловноеОформление.Элементы.Добавить();
			НовыйЭлементУО.Представление = "Механизм автоустановки субконто - колонка """
				+ СтрокаТаблицы["ИмяЭлементаСубконто"] + " в таблице """
				+ СтрокаТаблицы["ИмяРеквизитаТаблица"] + """ - отметка значения";
			// Условие:
			Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(СтрокаТаблицы["ПолноеИмяРеквизитаОтметить"]);
			Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
			Условие.ПравоеЗначение = Истина;
			// Оформление:
			НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветНедоступноеПоле);
			// Оформляемые поля:
			ОформляемоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
			ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(СтрокаТаблицы["ИмяЭлементаСубконто"]);
		КонецЦикла;
	КонецЕсли;
	Если ОтмечатьНезаполненныеСубконто = Истина Тогда
		Поиск = Новый Структура("ПолноеИмяРеквизитаТаблица,ИмяРеквизитаСчет");
		Для Каждого СтрокаТаблицы Из ТаблицаУОСубконто_ОтмечатьНезаполненныеСубконто Цикл
			ЗаполнитьЗначенияСвойств(Поиск, СтрокаТаблицы);
			МассивСтрокЭлементовСубконто = ТаблицаУОСубконто.НайтиСтроки(Поиск);
			НомерСубконто = 0;
			Для Каждого СтрокаУОСубконто Из МассивСтрокЭлементовСубконто Цикл
				НомерСубконто = НомерСубконто + 1;
				
				НовыйЭлементУО = Форма.УсловноеОформление.Элементы.Добавить();
				НовыйЭлементУО.Представление = "Механизм автоустановки субконто - таблица """ + СтрокаУОСубконто["ПолноеИмяРеквизитаТаблица"]
					+ """ - отметка незаполненного субконто " + Строка(НомерСубконто);
				// Условие:
				// ЗначениеЗаполнено(Счет) И НЕ ЗначениеЗаполнено(Субконто) И НомерСубконто<=КоличествоСубконто
				//	И <ДопУсловиеОтметкиНезаполненныхСубконто>
				Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(СтрокаУОСубконто["ПолноеИмяРеквизитаСчет"]);
				Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
				Условие.ПравоеЗначение = Истина;
				
				Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(СтрокаУОСубконто["ПолноеИмяРеквизитаСубконто"]);
				Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
				Условие.ПравоеЗначение = Истина;
				
				Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(СтрокаУОСубконто["ПолноеИмяРеквизитаКоличествоСубконто"]);
				Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно;
				Условие.ПравоеЗначение = НомерСубконто;
				
				ДопУсловиеОтметкиНезаполненныхСубконто = СтрокаУОСубконто["ДопУсловиеОтметкиНезаполненныхСубконто"];
				
				Если ДопУсловиеОтметкиНезаполненныхСубконто <> Неопределено Тогда
					Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
					Условие.ЛевоеЗначение	= ДопУсловиеОтметкиНезаполненныхСубконто["ЛевоеЗначение"];
					Условие.ВидСравнения	= ДопУсловиеОтметкиНезаполненныхСубконто["ВидСравнения"];
					Условие.ПравоеЗначение	= ДопУсловиеОтметкиНезаполненныхСубконто["ПравоеЗначение"];
				КонецЕсли;
				
				// Оформление:
				НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста",	ЦветаСтиля.ЦветНедоступноеПоле);
				НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст",		"<...>");
				// Оформляемые поля:
				ОформляемоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
				ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(СтрокаУОСубконто["ИмяЭлементаСубконто"]);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	// ЗАГРУЖАЕМ ЗНАЧЕНИЯ В РЕКВИЗИТЫ ФОРМЫ
	
	// Массив обслуживаемых идентификаторов:
	Форма["АвтоустановкаСубконто_МассивОбслуживаемыхИдентификаторов"] = Новый ФиксированныйМассив(МассивИдентификаторов);
	
	// Общая таблица настроек:
	Форма[ИмяРеквизитаФормыОбщаяТаблицаНастроек].Загрузить(ОбщаяТаблицаНастроек);
	Для ИндексСтроки = 0 По ОбщаяТаблицаНастроек.Количество() - 1 Цикл
		Форма[ИмяРеквизитаФормыОбщаяТаблицаНастроек][ИндексСтроки]["ТаблицаНастроекСчетИСубконто"].Загрузить(
			ОбщаяТаблицаНастроек[ИндексСтроки]["ТаблицаНастроекСчетИСубконто"]);
		Форма[ИмяРеквизитаФормыОбщаяТаблицаНастроек][ИндексСтроки]["ТаблицаНастроекЗначенияАвтоустановки"].Загрузить(
			ОбщаяТаблицаНастроек[ИндексСтроки]["ТаблицаНастроекЗначенияАвтоустановки"]);
	КонецЦикла;
	
	Форма[ИмяРеквизитаФормыТаблицаЭлементыСубконто].Загрузить(ТаблицаЭлементыСубконто);
	
	Если ОтмечатьЗначенияСовпадающиеСАвтоустановкой Тогда
		Форма["АвтоустановкаСубконто_ОтмечатьЗначенияСовпадающиеСАвтоустановкой"] = Истина;
	КонецЕсли;
	
	Если ОтмечатьНезаполненныеСубконто Тогда
		Форма["АвтоустановкаСубконто_ОтмечатьНезаполненныеСубконто"] = Истина;
	КонецЕсли;
	
	Форма[ИмяРеквизитаФормыТаблицаЭлементыАвтоустановкиВТаблице].Загрузить(ТаблицаЭлементыАвтоустановкиВТаблице);
	
	// Заполняем служебные колонки в редактируемых таблицах:
	АвтоустановкаСубконто_ЗаполнитьСлужебныеКолонкиРедактируемыхТаблиц(Форма);
	
КонецПроцедуры

Процедура АвтоустановкаСубконто_ПослеЗаписиНаСервере(Форма) Экспорт
	
	АвтоустановкаСубконто_ЗаполнитьСлужебныеКолонкиРедактируемыхТаблиц(Форма);
	
КонецПроцедуры

Процедура АвтоустановкаСубконто_ПриИзмененииСчета(Форма, ИмяЭлемента, СтруктураТекущаяСтрока) Экспорт
	
	АвтоустановкаСубконто_ОбработатьТаблицуИлиТекущуюСтроку(Форма, ИмяЭлемента,
		СтруктураТекущаяСтрока["ТекущаяСтрока"],	// ТекущаяСтрока
		Истина);									// ВыполнитьАвтоустановкуЗначений
	
