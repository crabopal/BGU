Процедура ВывестиРезультатВыполненияСКД_2019Кв1(ВозвратРезультат, ИмяВариантаНастроек, ПараметрыОтчета)
	
    // Настраиваем схему КД:
	НастройкиСКД = ПолучитьНастройкиСКД_2019Кв1(ПараметрыОтчета, ИмяВариантаНастроек);
	ИспользуемаяСхемаКомпоновкиДанных	= НастройкиСКД["ИспользуемаяСхемаКомпоновкиДанных"];
	НовыйКомпоновщикНастроек			= НастройкиСКД["НовыйКомпоновщикНастроек"];
	
	// Выполняем схему:
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(
		ИспользуемаяСхемаКомпоновкиДанных,				// 1
		НовыйКомпоновщикНастроек.ПолучитьНастройки(),	// 2
		,												// 3
		,												// 4
		Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));// 5
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных();
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , , Истина);
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений();
	ПроцессорВывода.УстановитьОбъект(ВозвратРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
	
	// Убираем служебные префиксы в именах колонок:
	ВозможныеПрефиксы = Новый Массив();
	ВозможныеПрефиксы.Добавить("Р2_");
	ВозможныеПрефиксы.Добавить("Р3_");
	ВозможныеПрефиксы.Добавить("Р3ч2_");
	Для Каждого Колонка Из ВозвратРезультат.Колонки Цикл
		ИмяКолонки = Колонка.Имя;
		Индекс_ = Найти(ИмяКолонки, "_");
		Если Индекс_ > 0 Тогда
			ПереименоватьКолонку = НЕ (ВозможныеПрефиксы.Найти(Лев(ИмяКолонки, Индекс_)) = Неопределено);
			Если ПереименоватьКолонку Тогда
				Колонка.Имя = Сред(ИмяКолонки, Индекс_ + 1);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьПараметры_2019Кв1(КомпоновщикНастроекИлиОтбор, ПараметрыОтчета, ЭтоРасшифровка)
	
	// Подготовка:
	СписокОрганизаций						= ПараметрыОтчета["СписокОрганизаций"];
	НачалоПериода							= ПараметрыОтчета["ДатаНачалаРасширенногоПериодаОтчета"];
	КонецПериода							= ПараметрыОтчета["мДатаКонцаПериодаОтчета"];
	СУчетомКорректировок					= НЕ (ПараметрыОтчета["ВидДокумента"] = 0);
	КонецПериодаУчитываемыхКорректировок	= ПараметрыОтчета["ДатаПодписи"];
	Если ЗначениеЗаполнено(КонецПериодаУчитываемыхКорректировок) Тогда
		КонецПериодаУчитываемыхКорректировок= КонецДня(КонецПериодаУчитываемыхКорректировок);
	КонецЕсли;
	
	// Устанавливаем либо параметры схемы, либо ключи структуры:
	Если ЭтоРасшифровка Тогда
		КомпоновщикНастроекИлиОтбор.Вставить("СписокОрганизаций",						СписокОрганизаций);
		КомпоновщикНастроекИлиОтбор.Вставить("НачалоПериода",							НачалоПериода);
		КомпоновщикНастроекИлиОтбор.Вставить("КонецПериода",							КонецПериода);
		КомпоновщикНастроекИлиОтбор.Вставить("КонецПериодаУчитываемыхКорректировок",	КонецПериодаУчитываемыхКорректировок);
		КомпоновщикНастроекИлиОтбор.Вставить("СУчетомКорректировок",					СУчетомКорректировок);
	Иначе
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроекИлиОтбор, "СписокОрганизаций",						СписокОрганизаций);
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроекИлиОтбор, "НачалоПериода",							НачалоПериода);
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроекИлиОтбор, "КонецПериода",							КонецПериода);
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроекИлиОтбор, "КонецПериодаУчитываемыхКорректировок",	КонецПериодаУчитываемыхКорректировок);
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(КомпоновщикНастроекИлиОтбор, "СУчетомКорректировок",					СУчетомКорректировок);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьСтрокуРасшифровки_2019Кв1(ТаблицаРасшифровок, ИмяПоказателя, НаименованиеПоказателя, ЗнакОперации, НаименованиеСлагаемого, Сумма, ИмяРаздела, КлючВарианта, ПараметрыОтчета, СтруктураДополнительныйОтбор = Неопределено)
	
	// Подготовка:
	Если СтруктураДополнительныйОтбор = Неопределено Тогда
		Отбор = Новый Структура();
	Иначе
		Отбор = СтруктураДополнительныйОтбор;
	КонецЕсли;
	УстановитьПараметры_2019Кв1(Отбор, ПараметрыОтчета, Истина); // ЭтоРасшифровка
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("КлючВарианта",				КлючВарианта);
	ПараметрыФормы.Вставить("Отбор",					Отбор);
	ПараметрыФормы.Вставить("СформироватьПриОткрытии",	Истина);
	
	ПользовательскиеНастройки = Новый ПользовательскиеНастройкиКомпоновкиДанных();
	ПользовательскиеНастройки.ДополнительныеСвойства.Вставить("Заголовок", НаименованиеСлагаемого);
	//НовыйПараметрВывода = ПользовательскиеНастройки.Элементы.Добавить(Тип("ЗначениеПараметраНастроекКомпоновкиДанных"));
	//НовыйПараметрВывода.ИдентификаторПользовательскойНастройки	= "Заголовок";
	//НовыйПараметрВывода.Параметр								= Новый ПараметрКомпоновкиДанных("Заголовок");
	//НовыйПараметрВывода.Значение								= НаименованиеСлагаемого;
	//НовыйПараметрВывода.Использование							= Истина;
	ПараметрыФормы.Вставить("ПользовательскиеНастройки", ПользовательскиеНастройки);
	
	Отчет = Новый Структура();
	Отчет.Вставить("ИмяОтчета",			"Отчет.РасшифровкаДекларацииНДС2019Кв1.ФормаОбъекта");
	Отчет.Вставить("ПараметрыФормы",	ПараметрыФормы);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("Отчет",	Отчет);
	
	Если ТаблицаРасшифровок = Неопределено Тогда
		ТаблицаРасшифровок = Новый ТаблицаЗначений;
		ТаблицаРасшифровок.Колонки.Добавить("ИмяПоказателя");
		ТаблицаРасшифровок.Колонки.Добавить("НаименованиеПоказателя");
		ТаблицаРасшифровок.Колонки.Добавить("ЗнакОперации");
		ТаблицаРасшифровок.Колонки.Добавить("НаименованиеСлагаемого");
		ТаблицаРасшифровок.Колонки.Добавить("Сумма");
		ТаблицаРасшифровок.Колонки.Добавить("ИмяРаздела");
		ТаблицаРасшифровок.Колонки.Добавить("ДополнительныеПараметры");
	КонецЕсли;
	
	НоваяСтрокаРасшифровки = ТаблицаРасшифровок.Добавить();
	НоваяСтрокаРасшифровки.ИмяПоказателя           = ИмяПоказателя;
	НоваяСтрокаРасшифровки.НаименованиеПоказателя  = НаименованиеПоказателя;
	НоваяСтрокаРасшифровки.ЗнакОперации            = ЗнакОперации;
	НоваяСтрокаРасшифровки.НаименованиеСлагаемого  = НаименованиеСлагаемого;
	НоваяСтрокаРасшифровки.Сумма                   = Сумма;
	НоваяСтрокаРасшифровки.ИмяРаздела              = ИмяРаздела;
	НоваяСтрокаРасшифровки.ДополнительныеПараметры = ДополнительныеПараметры;
	
КонецПроцедуры

Функция ПолучитьНастройкиСКД_2019Кв1(ПараметрыОтчета, ИмяВариантаНастроек)
	
	Результат = Новый Структура("
		|ИспользуемаяСхемаКомпоновкиДанных,
		|НовыйКомпоновщикНастроек");
	
	// Возвращаемые объекты:
	ИспользуемаяСхемаКомпоновкиДанных	= Отчеты.РасшифровкаДекларацииНДС2019Кв1.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");
	НовыйКомпоновщикНастроек			= Новый КомпоновщикНастроекКомпоновкиДанных();
	НовыйКомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(ИспользуемаяСхемаКомпоновкиДанных));
	НовыйКомпоновщикНастроек.ЗагрузитьНастройки(ИспользуемаяСхемаКомпоновкиДанных.ВариантыНастроек[ИмяВариантаНастроек].Настройки);
	
	// Настраиваем схему:
	УстановитьПараметры_2019Кв1(НовыйКомпоновщикНастроек, ПараметрыОтчета, Ложь); // ЭтоРасшифровка
	
	Результат["ИспользуемаяСхемаКомпоновкиДанных"]	= ИспользуемаяСхемаКомпоновкиДанных;
	Результат["НовыйКомпоновщикНастроек"]			= НовыйКомпоновщикНастроек;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСтрокуРасшифровкиДляПоказателя2019Кв1(Знач ИДИменПоказателей, Знач ПараметрыОтчета) Экспорт
	
	Результат = Неопределено;
	
	ТаблицаРасшифровки = ПолучитьИзВременногоХранилища(ПараметрыОтчета["АдресВременногоХранилищаРасшифровки"]);
	
	Если ТипЗнч(ТаблицаРасшифровки) = Тип("ТаблицаЗначений") Тогда
		ИмяПоказателя = ИДИменПоказателей[0];
		
		НомерТекущейСтраницы = 0;
		ПараметрыОтчета.Свойство("НомерТекущейСтраницы", НомерТекущейСтраницы);
		Если ЗначениеЗаполнено(НомерТекущейСтраницы) Тогда
			ИмяПоказателя = ИмяПоказателя + "_" + НомерТекущейСтраницы;
		КонецЕсли;
		
		СтрокаРасшифровки = ТаблицаРасшифровки.Найти(ИмяПоказателя, "ИмяПоказателя");
		Если НЕ СтрокаРасшифровки = Неопределено Тогда
			Результат = Новый Структура("ИмяПоказателя,
				|НаименованиеПоказателя,
				|ЗнакОперации,
				|НаименованиеСлагаемого,
				|Сумма,
				|ИмяРаздела,
				|ДополнительныеПараметры");
			ЗаполнитьЗначенияСвойств(Результат, СтрокаРасшифровки);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// 2021Кв3
Процедура ПолучитьСведенияОПоказателяхОтчетаНДСФормаОтчета2021Кв3(ПоказателиОтчета) Экспорт
	
	ПолучитьСведенияОПоказателяхОтчетаНДСФормаОтчета2019Кв1(ПоказателиОтчета);
	
КонецПроцедуры

Процедура ЗаполнитьОтчетНДСФормаОтчета2021Кв3(ПараметрыОтчета, Контейнер) Экспорт
	
	Перем ТаблицаРасшифровки;
	
	// Отбор по организации
	СписокОрганизаций = Новый СписокЗначений();
	СписокОрганизаций.Добавить(ПараметрыОтчета["Организация"]);
	ЭтоОбособленноеПодразделение = ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
		ПараметрыОтчета["Организация"], "ГоловнаяОрганизация"));
	Если НЕ ЭтоОбособленноеПодразделение Тогда
		Для Каждого ЭлементСписка Из ПараметрыОтчета["ГруппаОрганизаций"] Цикл
			ВсяОрганизация = Справочники.Организации.ВсяОрганизация(ЭлементСписка.Значение);
			Для Каждого Организация Из ВсяОрганизация Цикл
				СписокОрганизаций.Добавить(Организация);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	ПараметрыОтчета.Вставить("СписокОрганизаций", СписокОрганизаций);
	
	УчетнаяПолитика = Справочники.Организации.ПолучитьУчетнуюПолитику(
		ПараметрыОтчета["Организация"],
		ПараметрыОтчета["мДатаКонцаПериодаОтчета"]);
		
	СледуетЗаполнитьРаздел3 = УчетнаяПолитика["СистемаНалогообложения"] <> Перечисления.СистемыНалогообложения.Упрощенная;
	
	ЗаполнитьРаздел1_2021Кв3(Контейнер, ТаблицаРасшифровки, ПараметрыОтчета);
	ЗаполнитьРаздел2_2021Кв3(Контейнер, ТаблицаРасшифровки, ПараметрыОтчета);
	
	Если СледуетЗаполнитьРаздел3 Тогда
		ЗаполнитьРаздел3_2021Кв3(Контейнер, ТаблицаРасшифровки, ПараметрыОтчета);
	КонецЕсли;
	
	ЗаполнитьРаздел7_2021Кв3(Контейнер, ТаблицаРасшифровки, ПараметрыОтчета);
	
	// СегментацияДанныхДекларации
	РегламентированнаяОтчетность.УдалитьДополнительныеФайлыДекларацииНДС(ПараметрыОтчета["Декларация"]);
	
	ЗаполнитьРаздел8_2021Кв3(Контейнер, ТаблицаРасшифровки, ПараметрыОтчета);
	ЗаполнитьРазделы9и12_2021Кв3(Контейнер, ТаблицаРасшифровки, ПараметрыОтчета);
	
	ПоместитьВоВременноеХранилище(Контейнер,			ПараметрыОтчета.АдресВоВременномХранилище);
    ПоместитьВоВременноеХранилище(ТаблицаРасшифровки,	ПараметрыОтчета.АдресВременногоХранилищаРасшифровки);
	
КонецПроцедуры

Процедура ЗаполнитьРаздел1_2021Кв3(Контейнер, ТаблицаРасшифровки, ПараметрыОтчета)
	
	Раздел1 = Контейнер.Раздел1;
	
	КодОКТМО = ПолучитьКодОКТМО(ПараметрыОтчета);
	Раздел1.П000100001003 = КодОКТМО;
	
КонецПроцедуры

Процедура ЗаполнитьРаздел2_2021Кв3(Контейнер, ТаблицаРасшифровки, ПараметрыОтчета)
	
	Раздел2 = Контейнер.Раздел2;
	
	// Получаем данные
	РезультатДерево = Новый ДеревоЗначений();
	ВывестиРезультатВыполненияСКД_2021Кв3(РезультатДерево, "Раздел 2", ПараметрыОтчета);
	
	КодОКТМО = ПолучитьКодОКТМО(ПараметрыОтчета);
	
	ПерваяСтраницаРаздел2 = Раздел2[0].Данные;
	
	ПустаяСтраницаРаздел2 = Новый ФиксированнаяСтруктура(ПерваяСтраницаРаздел2);
	
	// Подготавливаем контейнер
	Пока Раздел2.Количество()>1 Цикл
		Раздел2.Удалить(1);
	КонецЦикла;
	
	НомерСтраницы = 0;
	
	Для Каждого СтрокаКонтрагент Из РезультатДерево.Строки Цикл
		
		Для Каждого СтрокаКодОперации Из СтрокаКонтрагент.Строки Цикл
			
			НомерСтраницы = НомерСтраницы + 1;
			
			Если НомерСтраницы = 1 Тогда
				СтраницаРаздел2 = ПерваяСтраницаРаздел2;
				
			Иначе
				// Добавляем новую страницу раздела
				
				СтраницаРаздел2 = Новый Структура(ПустаяСтраницаРаздел2);
				
				НоваяСтрока = Раздел2.Добавить();
				НоваяСтрока.Данные = СтраницаРаздел2;
			КонецЕсли;
			
			Для Каждого ДетальнаяСтрока Из СтрокаКодОперации.Строки Цикл
				
				ЗаполнитьЗначенияСвойств(СтраницаРаздел2, ДетальнаяСтрока);
				
				СтраницаРаздел2.П000200005003 = КодОКТМО;
				
				// Расшифровка
				
				// Строка 060
				ДополнительныйОтбор = Новый Структура();
				ДополнительныйОтбор.Вставить("Контрагент",	ДетальнаяСтрока["Контрагент"]);
				ДополнительныйОтбор.Вставить("КодОперации",	ДетальнаяСтрока["КодОперации"]);
				ДобавитьСтрокуРасшифровки_2019Кв1(ТаблицаРасшифровки,
					"П000200006003" + "_" + НомерСтраницы,
					"Строка 060 (раздел 2, страница " + НомерСтраницы + ") ""Сумма налога, подлежащая уплате в бюджет""",
					"", "Строка 060 (сумма налога)", СтраницаРаздел2.П000200006003,
					"Раздел2",
					"Раздел 2 (расшифровка П000200006003)",	// КлючВарианта
					ПараметрыОтчета,
					ДополнительныйОтбор);
					
				// Строка 080
				ДополнительныйОтбор = Новый Структура();
				ДополнительныйОтбор.Вставить("Контрагент",	ДетальнаяСтрока["Контрагент"]);
				ДополнительныйОтбор.Вставить("КодОперации",	ДетальнаяСтрока["КодОперации"]);
				ДобавитьСтрокуРасшифровки_2019Кв1(ТаблицаРасшифровки,
					"П000200008003" + "_" + НомерСтраницы,
					"Строка 080 (раздел 2, страница " + НомерСтраницы + ") ""Сумма налога, исчисленная при отгрузке товаров""",
					"", "Строка 080 (сумма налога)", СтраницаРаздел2.П000200008003,
					"Раздел2",
					"Раздел 2 (расшифровка П000200008003)",	// КлючВарианта
					ПараметрыОтчета,
					ДополнительныйОтбор);
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьРаздел3_2021Кв3(Контейнер, ТаблицаРасшифровки, ПараметрыОтчета)
	
