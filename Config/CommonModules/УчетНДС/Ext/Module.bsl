Функция ПолучитьПустуюСтруктураАдресаСтороныСделки()
	
	Возврат Новый Структура("Представление,JsonИлиXML,ВидКонтактнойИнформации", "", "", Справочники.ВидыКонтактнойИнформации.ПустаяСсылка());
	
КонецФункции

Функция ОпределитьАдрес(Объект, ОбщаяКонтактнаяИнформация, ВидАдреса)
	
	//	"Представление"	- строка текста человекочитаемая
	//	"JsonИлиXML"	- строка текста в формате json или XML структурированная
	
	Результат = ПолучитьПустуюСтруктураАдресаСтороныСделки();
	
	Если ОбщаяКонтактнаяИнформация = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Поиск = Новый Структура();
	Поиск.Вставить("Объект", Объект);
	Поиск.Вставить("Вид", ВидАдреса);

	МассивСтрок = ОбщаяКонтактнаяИнформация.НайтиСтроки(Поиск);
	
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	АдресJsonИлиXML = МассивСтрок[0]["Значение"];
	
	Если НЕ (ЗначениеЗаполнено(АдресJsonИлиXML) И УправлениеКонтактнойИнформациейКлиентСервер.ЭтоКонтактнаяИнформацияВJSON(АдресJsonИлиXML)) Тогда
		АдресJsonИлиXML = МассивСтрок[0]["ЗначенияПолей"];
	КонецЕсли;
	
	Результат["JsonИлиXML"] = АдресJsonИлиXML;
	
	Результат["Представление"] = МассивСтрок[0]["Представление"];
	Результат.ВидКонтактнойИнформации = ВидАдреса;
	
	// Вариант Б
	//ВидКИ = Новый Структура("ФорматАдреса", "ФИАС");
	//Результат["Представление"] = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформации(АдресJsonИлиXML, ВидКИ);
	
	Возврат Результат;
	
КонецФункции

Функция ОпределитьГрузоотправителяГрузополучателя(ШапкаДокументаРасширенная, ПродавецПокупатель, ОбщаяКонтактнаяИнформация, ДополнитьСведениямиДляЭДО = Ложь)
	
	//
	// Грузоотправитель
	//
	Если ЗначениеЗаполнено(ШапкаДокументаРасширенная["Грузоотправитель"]) Тогда
		// Грузоотправителем является третья сторона
		
		ОбъектДляОпределенияАдресаГрузоотправителя = ШапкаДокументаРасширенная["ГрузоотправительЮридическоеФизическоеЛицо"];
		
		НаименованиеГрузоотправителя = ШапкаДокументаРасширенная["ГрузоотправительПредставление"];
		
		ГрузоотправительЯвляетсяФизЛицом = ШапкаДокументаРасширенная["ГрузоотправительЯвляетсяФизЛицом"];
		
		ГрузоотправительСсылка = ШапкаДокументаРасширенная["Грузоотправитель"];
	Иначе
		// Грузоотправителем является продавец
		
		Если ПродавецПокупатель.Свойство("ГрузоотправительПоУмолчанию") Тогда
			ОбъектДляОпределенияАдресаГрузоотправителя = ПродавецПокупатель["ГрузоотправительПоУмолчанию"]["ОбъектДляОпределенияАдреса"];
			
			НаименованиеГрузоотправителя = ПродавецПокупатель["ГрузоотправительПоУмолчанию"]["Наименование"];
			
			ГрузоотправительЯвляетсяФизЛицом = ПродавецПокупатель["Продавец"]["ЯвляетсяФизЛицом"];
			
			ГрузоотправительСсылка = ПродавецПокупатель["ГрузоотправительПоУмолчанию"]["Ссылка"];
		Иначе
			ОбъектДляОпределенияАдресаГрузоотправителя = Неопределено;
			
			НаименованиеГрузоотправителя = "";
			
			ГрузоотправительЯвляетсяФизЛицом = Ложь;
			
			ГрузоотправительСсылка = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	ФактическийАдресГрузоотправителя = ОпределитьАдресГрузоотправителяГрузополучателя(
		ОбъектДляОпределенияАдресаГрузоотправителя,
		ОбщаяКонтактнаяИнформация,
		ГрузоотправительЯвляетсяФизЛицом,
		ПродавецПокупатель["Продавец"]["Адрес"]);
		
	ГрузоотправительСовпадаетСПродавцом = (НаименованиеГрузоотправителя = ПродавецПокупатель["Продавец"]["Наименование"]
									И ФактическийАдресГрузоотправителя.Представление = ПродавецПокупатель["Продавец"]["Адрес"].Представление);
	
	Грузоотправитель = Новый Структура();
	Грузоотправитель.Вставить("Наименование",			НаименованиеГрузоотправителя);
	Грузоотправитель.Вставить("ЯвляетсяФизЛицом",		ГрузоотправительЯвляетсяФизЛицом);
	Грузоотправитель.Вставить("СовпадаетСПродавцом",	ГрузоотправительСовпадаетСПродавцом);
	Грузоотправитель.Вставить("Адрес",					ФактическийАдресГрузоотправителя);
	Грузоотправитель.Вставить("Ссылка",					ГрузоотправительСсылка);
	
	//
	// Грузополучатель
	//
	Если ЗначениеЗаполнено(ШапкаДокументаРасширенная["Грузополучатель"]) Тогда
		// Грузополучателем является третья сторона
		
		ОбъектДляОпределенияАдресаГрузополучателя = ШапкаДокументаРасширенная["ГрузополучательЮридическоеФизическоеЛицо"];
		
		НаименованиеГрузополучателя = ШапкаДокументаРасширенная["ГрузополучательПредставление"];
		
		ГрузополучательЯвляетсяФизЛицом = ШапкаДокументаРасширенная["ГрузополучательЯвляетсяФизЛицом"];
		
		ГрузополучательСсылка = ШапкаДокументаРасширенная["Грузополучатель"];
	Иначе
		// Грузополучателем является покупатель
		
		Если ПродавецПокупатель.Свойство("ГрузополучательПоУмолчанию") Тогда
			ОбъектДляОпределенияАдресаГрузополучателя = ПродавецПокупатель["ГрузополучательПоУмолчанию"]["ОбъектДляОпределенияАдреса"];
			
			НаименованиеГрузополучателя = ПродавецПокупатель["ГрузополучательПоУмолчанию"]["Наименование"];
			
			ГрузополучательЯвляетсяФизЛицом = ПродавецПокупатель["Покупатель"]["ЯвляетсяФизЛицом"];
			
			ГрузополучательСсылка = ПродавецПокупатель["ГрузополучательПоУмолчанию"]["Ссылка"];
		Иначе
			ОбъектДляОпределенияАдресаГрузополучателя = Неопределено;
			
			НаименованиеГрузополучателя = "";
			
			ГрузополучательЯвляетсяФизЛицом = Ложь;
			
			ГрузополучательСсылка = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	ФактическийАдресГрузополучателя = ОпределитьАдресГрузоотправителяГрузополучателя(
		ОбъектДляОпределенияАдресаГрузополучателя,
		ОбщаяКонтактнаяИнформация,
		ГрузополучательЯвляетсяФизЛицом,
		ПродавецПокупатель["Покупатель"]["Адрес"]);
		
	ГрузополучательСовпадаетСПокупателем = (НаименованиеГрузополучателя = ПродавецПокупатель["Покупатель"]["Наименование"]
									И ФактическийАдресГрузополучателя.Представление = ПродавецПокупатель["Покупатель"]["Адрес"].Представление);
									
	Грузополучатель = Новый Структура();
	Грузополучатель.Вставить("Наименование",			НаименованиеГрузополучателя);
	Грузополучатель.Вставить("ЯвляетсяФизЛицом",		ГрузополучательЯвляетсяФизЛицом);
	Грузополучатель.Вставить("СовпадаетСПокупателем",	ГрузополучательСовпадаетСПокупателем);
	Грузополучатель.Вставить("Адрес",					ФактическийАдресГрузополучателя);
	Грузополучатель.Вставить("Ссылка",					ГрузополучательСсылка);
	
	СтороныСделки = Новый Структура();
	СтороныСделки.Вставить("Грузоотправитель",	Грузоотправитель);
	СтороныСделки.Вставить("Грузополучатель",	Грузополучатель);
	
	Если ДополнитьСведениямиДляЭДО Тогда
		
		// Грузоотправитель
		ДополнительныеСведения = ПолучитьДополнительныеСведенияДляЭДОГрузоотправительГрузополучатель(
			ОбъектДляОпределенияАдресаГрузоотправителя,
			ШапкаДокументаРасширенная);
			
		Для Каждого Элемент Из ДополнительныеСведения Цикл
			СтороныСделки["Грузоотправитель"].Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЦикла;
		
		// Грузополучатель
		ДополнительныеСведения = ПолучитьДополнительныеСведенияДляЭДОГрузоотправительГрузополучатель(
			ОбъектДляОпределенияАдресаГрузополучателя,
			ШапкаДокументаРасширенная);
		
		Для Каждого Элемент Из ДополнительныеСведения Цикл
			СтороныСделки["Грузополучатель"].Вставить(Элемент.Ключ, Элемент.Значение);
		КонецЦикла;
	КонецЕсли;
	
	Возврат СтороныСделки;
	
КонецФункции

// ОбозначениеСтороны = ["Продавец"|"Покупатель"]
Функция ОпределитьСторонуСделки(ОбозначениеСтороны, ШапкаДокументаРасширенная, ОбщаяКонтактнаяИнформация, ДополнитьСведениямиДляЭДО)
	
	Если ОбщаяКонтактнаяИнформация = Неопределено Тогда
		// Режим: заполнение книг, журналов
		
		ОпределитьГрузоотправителяГрузополучателя	= Ложь;
		ОпределитьКППКонтрагентовНаДату				= Ложь; // КПП контрагентов уже возвратил запрос
		ОпределитьАдреса							= Ложь; // Адреса сторон не требуются
		
	Иначе
		// Режим: печать счетов-фактур
		
		ОпределитьГрузоотправителяГрузополучателя	= Истина;
		ОпределитьКППКонтрагентовНаДату				= Истина; // КПП контрагентов еще предстоит определить
		ОпределитьАдреса							= Истина; // Адреса сторон необходимо определить
	КонецЕсли;
	
	ПродавецПокупатель = УчетНДСПовтИсп.ПродавецПокупатель(ШапкаДокументаРасширенная["ПричинаНалогообложения"]);
	
	Если ПродавецПокупатель[ОбозначениеСтороны] = "Организация" Тогда
		
		Если ШапкаДокументаРасширенная["ВидОбособленногоПодразделения"] = 1 Тогда
			// Выделенное на отдельный баланс
			
			Наименование	= ШапкаДокументаРасширенная["ГоловнаяОрганизацияПредставление"];
			ИНН				= ШапкаДокументаРасширенная["ГоловнаяОрганизацияИНН"];
			КПП				= ШапкаДокументаРасширенная["ОрганизацияКПП"]; // Используется КПП ОП, а не головной организации
			ЯвляетсяОП		= Истина;
			Ссылка			= ШапкаДокументаРасширенная["ГоловнаяОрганизация"];
			
			Если ОпределитьГрузоотправителяГрузополучателя Тогда
				СсылкаГрузоПоУмолчанию = ШапкаДокументаРасширенная["Организация"];
			КонецЕсли;
			
			Если ОпределитьАдреса Тогда
				ОбъектДляОпределенияАдреса = ШапкаДокументаРасширенная["ГоловнаяОрганизация"];
				
				ОбъектДляОпределенияАдресаГрузоПоУмолчанию = ШапкаДокументаРасширенная["Организация"];
			КонецЕсли;
			НаименованиеГрузоПоУмолчанию = ШапкаДокументаРасширенная["ОрганизацияПредставление"];
			
		ИначеЕсли ШапкаДокументаРасширенная["ВидОбособленногоПодразделения"] = 2 Тогда
			// Не выделенное на отдельный баланс
			
			Наименование	= ШапкаДокументаРасширенная["ОрганизацияПредставление"];
			ИНН				= ШапкаДокументаРасширенная["ОрганизацияИНН"];
			КПП				= ШапкаДокументаРасширенная["ПодразделениеКПП"]; // Используется КПП ОП, а не головной организации
			ЯвляетсяОП		= Истина;
			Ссылка			= ШапкаДокументаРасширенная["Организация"];
			
			Если ОпределитьГрузоотправителяГрузополучателя Тогда
				СсылкаГрузоПоУмолчанию = ШапкаДокументаРасширенная["Подразделение"];
			КонецЕсли;
			
			Если ОпределитьАдреса Тогда
				ОбъектДляОпределенияАдреса = ШапкаДокументаРасширенная["Организация"];
				
				ОбъектДляОпределенияАдресаГрузоПоУмолчанию = ШапкаДокументаРасширенная["Подразделение"];
			КонецЕсли;
			
			НаименованиеГрузоПоУмолчанию = ШапкаДокументаРасширенная["ПодразделениеПредставление"];
			
		Иначе
			// Не является обособленным подразделением
			
			Наименование	= ШапкаДокументаРасширенная["ОрганизацияПредставление"];
			ИНН				= ШапкаДокументаРасширенная["ОрганизацияИНН"];
			КПП				= ШапкаДокументаРасширенная["ОрганизацияКПП"];
			ЯвляетсяОП		= Ложь;
			Ссылка			= ШапкаДокументаРасширенная["Организация"];
			
			Если ОпределитьГрузоотправителяГрузополучателя Тогда
				СсылкаГрузоПоУмолчанию = ШапкаДокументаРасширенная["Организация"];
			КонецЕсли;
			
			Если ОпределитьАдреса Тогда
				ОбъектДляОпределенияАдреса = ШапкаДокументаРасширенная["Организация"];
				
				ОбъектДляОпределенияАдресаГрузоПоУмолчанию = ШапкаДокументаРасширенная["Организация"];
			КонецЕсли;
			
			НаименованиеГрузоПоУмолчанию = ШапкаДокументаРасширенная["ОрганизацияПредставление"];
		КонецЕсли;
		
		ЯвляетсяФизЛицом = Ложь;
		
	ИначеЕсли ПродавецПокупатель[ОбозначениеСтороны] = "Контрагент" Тогда
		
		Если ШапкаДокументаРасширенная["КонтрагентЯвляетсяОбособленнымПодразделением"] Тогда
			// Является обособленным подразделением (не важно какого именно типа)
			
			Наименование	= ШапкаДокументаРасширенная["КонтрагентГоловнаяОрганизацияПредставление"];
			ИНН				= ШапкаДокументаРасширенная["КонтрагентГоловнаяОрганизацияИНН"];
			ЯвляетсяОП		= Истина;
			Ссылка			= ШапкаДокументаРасширенная["КонтрагентГоловнаяОрганизация"];
			
			Если ОпределитьГрузоотправителяГрузополучателя Тогда
				СсылкаГрузоПоУмолчанию = ШапкаДокументаРасширенная["Контрагент"];
			КонецЕсли;
			
			Если ОпределитьАдреса Тогда
				ОбъектДляОпределенияАдреса = ШапкаДокументаРасширенная["КонтрагентГоловнаяОрганизацияЮридическоеФизическоеЛицо"];
			КонецЕсли;
			
		Иначе
			// Не является обособленным подразделением
			
			Наименование	= ШапкаДокументаРасширенная["КонтрагентПредставление"];
			ИНН				= ШапкаДокументаРасширенная["КонтрагентИНН"];
			ЯвляетсяОП		= Ложь;
			Ссылка			= ШапкаДокументаРасширенная["Контрагент"];
			
			Если ОпределитьГрузоотправителяГрузополучателя Тогда
				СсылкаГрузоПоУмолчанию = ШапкаДокументаРасширенная["Контрагент"];
			КонецЕсли;
			
			Если ОпределитьАдреса Тогда
				ОбъектДляОпределенияАдреса = ШапкаДокументаРасширенная["КонтрагентЮридическоеФизическоеЛицо"];
			КонецЕсли;
		КонецЕсли;
		
		// Для контрагентов КПП всегда определяется именно для указанного элемента справочника
		Если ОпределитьКППКонтрагентовНаДату Тогда
			КПП = Справочники.Контрагенты.ПолучитьКПП(
				ШапкаДокументаРасширенная["Контрагент"],
				ШапкаДокументаРасширенная["Дата"]);
		Иначе
			Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ШапкаДокументаРасширенная, "КонтрагентКПП") Тогда
				КПП = ШапкаДокументаРасширенная["КонтрагентКПП"];
			Иначе
				КПП = "";
			КонецЕсли;
		КонецЕсли;
		
		ЯвляетсяФизЛицом = ШапкаДокументаРасширенная["КонтрагентЯвляетсяФизЛицом"];
		
		ОбъектДляОпределенияАдресаГрузоПоУмолчанию	= ШапкаДокументаРасширенная["КонтрагентЮридическоеФизическоеЛицо"];
		НаименованиеГрузоПоУмолчанию				= ШапкаДокументаРасширенная["КонтрагентПредставление"];
		
	КонецЕсли;
	
	СторонаСделки = Новый Структура();
	СторонаСделки.Вставить("Наименование",		Наименование);
	СторонаСделки.Вставить("ИНН",				ИНН);
	СторонаСделки.Вставить("КПП",				КПП);
	СторонаСделки.Вставить("ЯвляетсяОП",		ЯвляетсяОП);
	СторонаСделки.Вставить("ЯвляетсяФизЛицом",	ЯвляетсяФизЛицом);
	СторонаСделки.Вставить("Ссылка",			Ссылка);
	
	Если ОпределитьАдреса Тогда
		ЮридическийАдрес = ОпределитьАдресПродавцаПокупателя(
			ОбъектДляОпределенияАдреса,
			ОбщаяКонтактнаяИнформация,
			ЯвляетсяФизЛицом);
	Иначе
		ЮридическийАдрес = ПолучитьПустуюСтруктураАдресаСтороныСделки();
	КонецЕсли;
	
	СторонаСделки.Вставить("Адрес",				ЮридическийАдрес);
	
	СтороныСделки = Новый Структура();
	
	СтороныСделки.Вставить(ОбозначениеСтороны,	СторонаСделки);
	
	Если ОпределитьГрузоотправителяГрузополучателя Тогда
		// Значения по умолчанию для дальнейшего определения грузоотправителя/грузополучателя
		СторонаГрузоПоУмолчанию = Новый Структура();
		СторонаГрузоПоУмолчанию.Вставить("ОбъектДляОпределенияАдреса",	ОбъектДляОпределенияАдресаГрузоПоУмолчанию);
		СторонаГрузоПоУмолчанию.Вставить("Наименование",				НаименованиеГрузоПоУмолчанию);
		СторонаГрузоПоУмолчанию.Вставить("Ссылка",						СсылкаГрузоПоУмолчанию);
		
		ОбозначениеСтороныГрузо = ?(ОбозначениеСтороны = "Продавец", "ГрузоотправительПоУмолчанию", "ГрузополучательПоУмолчанию");
		
		СтороныСделки.Вставить(ОбозначениеСтороныГрузо,	СторонаГрузоПоУмолчанию);
	КонецЕсли;
	
	Возврат СтороныСделки;
	
КонецФункции

Функция ОчиститьНомерОтПрефиксовИДобавитьИндексОП(ШапкаДокументаРасширенная, ИмяДокумента, ИмяРеквизитаНомер = "Номер")
	
	// Предполагается вызов только для составленных нами документов
	
	НомерДляПечати = РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоИмениДокумента(
		ИмяДокумента,
		ШапкаДокументаРасширенная[ИмяРеквизитаНомер]);
		
	Если ШапкаДокументаРасширенная["ВидОбособленногоПодразделения"] > 0 Тогда
		НомерДляПечати = СокрП(НомерДляПечати) + "/" + Строка(ШапкаДокументаРасширенная["НДСИндексПодразделения"]);
	КонецЕсли;
	
	Возврат НомерДляПечати;
	
КонецФункции

Функция ПолучитьВидОбособленногоПодразделения(Организация, Подразделение)
	
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		// Не является обособленным подразделением
		Возврат 0;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Подразделение) И ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
		ОбособленноеПодразделение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Подразделение, "ОбособленноеПодразделение");
		
		Если ОбособленноеПодразделение Тогда
			// Не выделенное на отдельный баланс
			Возврат 2;
		КонецЕсли;
	КонецЕсли;
	
	ГоловнаяОрганизация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ГоловнаяОрганизация");
	
	Если ЗначениеЗаполнено(ГоловнаяОрганизация) Тогда
		// Выделенное на отдельный баланс
		Возврат 1;
	КонецЕсли;
	
	// Не является обособленным подразделением
	Возврат 0;
	
КонецФункции


Функция НовыйШапкаДокументаДляОпределенияНомераСФДляВыводаВРегистрыУчета()
	
	ШапкаДокумента = Новый Структура();
	ШапкаДокумента.Вставить("Ссылка");
	ШапкаДокумента.Вставить("Дата", '00010101');
	ШапкаДокумента.Вставить("Номер", "");
	ШапкаДокумента.Вставить("Организация", Справочники.Организации.ПустаяСсылка());
	ШапкаДокумента.Вставить("Подразделение", Справочники.Подразделения.ПустаяСсылка());
	ШапкаДокумента.Вставить("ИсправляемыйДокумент");
	ШапкаДокумента.Вставить("НомерПервичногоДокумента", "");
	ШапкаДокумента.Вставить("ДатаПервичногоДокумента", '00010101');
	
	Возврат ШапкаДокумента;
	
КонецФункции

Функция ПолучитьШапкуДокументаДляОпределенияНомераСФДляВыводаВРегистрыУчета(ДокументСсылка)
	
	ШапкаДокумента = НовыйШапкаДокументаДляОпределенияНомераСФДляВыводаВРегистрыУчета();
	
	ШапкаДокумента.Ссылка = ДокументСсылка;
	
	ИменаРеквизитов = СтрРазделить("Дата,Организация,Подразделение", ", ", Ложь);
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		ИменаРеквизитов.Добавить("Дата");
		ИменаРеквизитов.Добавить("Номер");
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный") Тогда
		ИменаРеквизитов.Добавить("ИсправляемыйДокумент");
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.КорректировочныйСчетФактураВыданный") Тогда
		ИменаРеквизитов.Добавить("НомерПервичногоДокумента");
		ИменаРеквизитов.Добавить("ДатаПервичногоДокумента");
	КонецЕсли;
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, СтрСоединить(ИменаРеквизитов, ","));
	
	ЗаполнитьЗначенияСвойств(ШапкаДокумента, ЗначенияРеквизитов);

	Возврат ШапкаДокумента;
	
КонецФункции

Функция РасширитьШапкуДокументаДляОпределенияНомераСФДляВыводаВРегистрыУчета(Знач ДокументОбъект, ДатыДокументов = Неопределено)
	
	// Предполагается вызов только для составленных нами документов
	
	// Все поля, вычисляемые здесь, определяются аналогично запросам книг покупок, продаж
	// (см. временную таблицу [2]. Сведения об используемых документах)
	
	ЗаполнитьДатыДокументов = (ДатыДокументов <> Неопределено);
	Если ЗаполнитьДатыДокументов Тогда
		ДатыДокументов.Вставить("Дата", '00010101');
		ДатыДокументов.Вставить("ДатаКСФ", '00010101');
	КонецЕсли;
	
	Если ТипЗнч(ДокументОбъект.Ссылка) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		
		Номер = ДокументОбъект.Номер;
		НомерКСФ = "";
		ИмяДокумента = "СчетФактураВыданный";
		ИмяИсправляемогоДокумента = "";
		
		Если ЗаполнитьДатыДокументов Тогда
			ДатыДокументов.Дата = ДокументОбъект.Дата;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДокументОбъект.Ссылка) = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный") Тогда
		
		ИмяДокумента = "ИсправительныйСчетФактураВыданный";
		
		ИсправляемыйДокумент = ДокументОбъект.ИсправляемыйДокумент;
		
		Если ЗначениеЗаполнено(ИсправляемыйДокумент) Тогда
			
			Если ТипЗнч(ИсправляемыйДокумент) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
				
				ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ИсправляемыйДокумент, "Дата,Номер");
				
				Номер = ЗначенияРеквизитов.Номер;
				НомерКСФ = "";
				ИмяИсправляемогоДокумента = "СчетФактураВыданный";
				
				Если ЗаполнитьДатыДокументов Тогда
					ДатыДокументов.Дата = ЗначенияРеквизитов.Дата;
				КонецЕсли;
				
			ИначеЕсли ТипЗнч(ИсправляемыйДокумент) = Тип("ДокументСсылка.КорректировочныйСчетФактураВыданный") Тогда
				
				ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ИсправляемыйДокумент,
					"Дата,Номер,ДатаПервичногоДокумента,НомерПервичногоДокумента");
				
				Номер = ЗначенияРеквизитов.НомерПервичногоДокумента;
				НомерКСФ = ЗначенияРеквизитов.Номер;
				ИмяИсправляемогоДокумента = "КорректировочныйСчетФактураВыданный";
				
				Если ЗаполнитьДатыДокументов Тогда
					ДатыДокументов.Дата = ДокументОбъект.ДатаПервичногоДокумента;
					ДатыДокументов.ДатаКСФ = ДокументОбъект.Дата;
				КонецЕсли;
				
			Иначе
				
				Номер = "";
				НомерКСФ = "";
				ИмяИсправляемогоДокумента = "";
				
			КонецЕсли;
			
		Иначе
			
			Номер = "";
			ИмяИсправляемогоДокумента = "";
			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДокументОбъект.Ссылка) = Тип("ДокументСсылка.КорректировочныйСчетФактураВыданный") Тогда
		
		Номер = ДокументОбъект.НомерПервичногоДокумента;
		НомерКСФ = ДокументОбъект.Номер;
		ИмяДокумента = "КорректировочныйСчетФактураВыданный";
		ИмяИсправляемогоДокумента = "";
		
		Если ЗаполнитьДатыДокументов Тогда
			ДатыДокументов.Дата = ДокументОбъект.ДатаПервичногоДокумента;
			ДатыДокументов.ДатаКСФ = ДокументОбъект.Дата;
		КонецЕсли;
		
	КонецЕсли;
	
	ВидОбособленногоПодразделения = ПолучитьВидОбособленногоПодразделения(
		ДокументОбъект.Организация,
		ДокументОбъект.Подразделение);
	
	Если ВидОбособленногоПодразделения = 2 Тогда
		// Не выделенное на отдельный баланс
		
		НДСИндексПодразделения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОбъект.Подразделение, "ЦифровойИндекс");
		
	ИначеЕсли ВидОбособленногоПодразделения = 1 Тогда
		// Выделенное на отдельный баланс
		
		УчетнаяПолитика = БухгалтерскийУчетПовтИсп.УчетнаяПолитикаОрганизации(
			ДокументОбъект.Организация,
			ДокументОбъект.Дата);
			
		НДСИндексПодразделения = УчетнаяПолитика["НДСИндексПодразделения"];
		
	Иначе
		
		НДСИндексПодразделения = 0;
		
	КонецЕсли;
	
	ДетальнаяЗапись = Новый Структура();
	ДетальнаяЗапись.Вставить("Номер",							Номер);
	ДетальнаяЗапись.Вставить("НомерКСФ",						НомерКСФ);
	ДетальнаяЗапись.Вставить("ИмяДокумента",					ИмяДокумента);
	ДетальнаяЗапись.Вставить("ИмяИсправляемогоДокумента",		ИмяИсправляемогоДокумента);
	ДетальнаяЗапись.Вставить("ВидОбособленногоПодразделения",	ВидОбособленногоПодразделения);
	ДетальнаяЗапись.Вставить("НДСИндексПодразделения",			НДСИндексПодразделения);
	
	Возврат ДетальнаяЗапись;
	
КонецФункции

Функция ПолучитьДополнительныеСведенияДляЭДОГрузоотправительГрузополучатель(ОбъектСсылка, ШапкаДокументаРасширенная)
	
	Если ТипЗнч(ОбъектСсылка) = Тип("СправочникСсылка.Организации") Тогда
		
		МассивПоказателей = Новый Массив();
		МассивПоказателей.Добавить("ИННЮЛ");
		МассивПоказателей.Добавить("КППЮЛ");
		
		ВремСтруктура = РегламентированнаяОтчетностьБГУ.ПолучитьСведенияОбОрганизации(
			ОбъектСсылка,
			ШапкаДокументаРасширенная["Дата"],
			МассивПоказателей);
			
		ДополнительныеСведения = Новый Структура();
		ДополнительныеСведения.Вставить("ИНН", ВремСтруктура.ИННЮЛ);
		ДополнительныеСведения.Вставить("КПП", ВремСтруктура.КППЮЛ);
		
	ИначеЕсли ТипЗнч(ОбъектСсылка) = Тип("СправочникСсылка.Подразделения") Тогда
		
		МассивПоказателей = Новый Массив();
		МассивПоказателей.Добавить("ИННЮЛ");
		
		ВремСтруктура = РегламентированнаяОтчетностьБГУ.ПолучитьСведенияОбОрганизации(
			ШапкаДокументаРасширенная["Организация"],
			ШапкаДокументаРасширенная["Дата"],
			МассивПоказателей);
		
		ДополнительныеСведения = Новый Структура();
		ДополнительныеСведения.Вставить("ИНН", ВремСтруктура.ИННЮЛ);
		ДополнительныеСведения.Вставить("КПП", ШапкаДокументаРасширенная["ПодразделениеКПП"]);
		
	ИначеЕсли ТипЗнч(ОбъектСсылка) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
		
		МассивПоказателей = Новый Массив();
		МассивПоказателей.Добавить("ИНН");
		МассивПоказателей.Добавить("Фамилия");
		МассивПоказателей.Добавить("Имя");
		МассивПоказателей.Добавить("Отчество");
		
		ДополнительныеСведения = РегламентированнаяОтчетностьБГУ.ПолучитьСведенияОФизЛице(
			ОбъектСсылка,
			МассивПоказателей,
			ШапкаДокументаРасширенная["Дата"]);
			
	ИначеЕсли ТипЗнч(ОбъектСсылка) = Тип("СправочникСсылка.ЮридическиеЛица") Тогда
		
		ДополнительныеСведения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОбъектСсылка, "ИНН,КПП");
			
	Иначе
		
		ДополнительныеСведения = Новый Структура();
		
	КонецЕсли;
	
	Возврат ДополнительныеСведения;
	
КонецФункции

Функция ПолучитьВидыКонтактнойИнформацииПродавцаПокупателя()
	
	// Адрес Продавца / Покупателя
	//	ИП		- адрес прописки
	//	Юр.лицо	- юр. адрес (головной орг.)
	
	ВидыКИ = Новый Массив();
	ВидыКИ.Добавить(Справочники.ВидыКонтактнойИнформации.АдресПоПропискеФизическиеЛица);
	ВидыКИ.Добавить(Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);
	ВидыКИ.Добавить(Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты);
	
	Возврат ВидыКИ;
	
КонецФункции

Функция ПолучитьВидыКонтактнойИнформацииГрузоотправителяГрузополучателя()
	
	// Адрес Грузоотправителя / Грузополучателя
	//	ИП		- адрес проживания (если не заполнен - адрес прописки)
	//	Юр.лицо	- факт.адрес (если не заполнен - юр.адрес)
	
	ВидыКИ = Новый Массив();
	ВидыКИ.Добавить(Справочники.ВидыКонтактнойИнформации.АдресМестаПроживанияФизическиеЛица);
	ВидыКИ.Добавить(Справочники.ВидыКонтактнойИнформации.ФактАдресОрганизации);
	ВидыКИ.Добавить(Справочники.ВидыКонтактнойИнформации.ФактическийАдресКонтрагенты);
	ВидыКИ.Добавить(Справочники.ВидыКонтактнойИнформации.ФактическийАдресПодразделенияОрганизаций);
	
	Возврат ВидыКИ;
	
