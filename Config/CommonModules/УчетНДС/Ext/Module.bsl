			ТипДоговораНДС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор, "ТипДоговораНДС");
		КонецЕсли;
		
		ДоговорАгентский = (ТипДоговораНДС = Перечисления.ТипыДоговоровДляНДС.АгентскийДоговор
						ИЛИ ТипДоговораНДС = Перечисления.ТипыДоговоровДляНДС.АгентскийДоговорНерезидент);
		
		Возврат ?(ДоговорАгентский, "06", "02");
		
		
	ИначеЕсли ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.Покупка
		ИЛИ ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.Реализация Тогда
		
		Если ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.Реализация Тогда
			Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
				Возврат "";
			КонецЕсли;
			
			Если КонтрагентНеПлательщикНДС(Контрагент) Тогда
				Возврат "26";
			КонецЕсли;
		КонецЕсли;
		
		Если ТипДоговораНДС = Неопределено Тогда
			ТипДоговораНДС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Договор, "ТипДоговораНДС");
		КонецЕсли;
		
		Если ТипДоговораНДС = Перечисления.ТипыДоговоровДляНДС.ПриобретениеЭлектронныхУслугУНерезидентаПлательщика Тогда
			Возврат "45";
		КонецЕсли;
		// При использовании функционала комиссионных продаж определим какие ценности были реализованы и проверим случай "смешанной" реализации (код 15).
		Если ПолучитьФункциональнуюОпцию("ВестиУчетПоРеализацииТоваровУслугКомитентов") Тогда
			Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.НакладнаяНаОтпускМ15") Тогда
				ДанныеДокументаОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, "Дата, Организация");
				СчетаУчетаКомиссионногоТовара =  БухгалтерскийУчет.СчетПоКоду("02.33",ДанныеДокументаОснования.Дата, ДанныеДокументаОснования.Организация);
				
				Запрос = Новый Запрос;
				Запрос.УстановитьПараметр("ДокументыОснования", ДокументОснование);
				Запрос.УстановитьПараметр("СчетаУчетаКомиссионногоТовара", СчетаУчетаКомиссионногоТовара);
				Запрос.Текст = 
				"ВЫБРАТЬ
				|	ЕСТЬNULL(СУММА(ВЫБОР
				|				КОГДА НакладнаяНаОтпускМ15.СчетУчета В (&СчетаУчетаКомиссионногоТовара)
				|					ТОГДА 1
				|				ИНАЧЕ 0
				|			КОНЕЦ), 0) КАК ЕстьКомиссионныеТовары,
				|	ЕСТЬNULL(СУММА(ВЫБОР
				|				КОГДА НЕ НакладнаяНаОтпускМ15.СчетУчета В (&СчетаУчетаКомиссионногоТовара)
				|					ТОГДА 1
				|				ИНАЧЕ 0
				|			КОНЕЦ), 0) КАК ЕстьСобственныеТовары
				|ИЗ
				|	Документ.НакладнаяНаОтпускМ15.Материалы КАК НакладнаяНаОтпускМ15
				|ГДЕ
				|	НакладнаяНаОтпускМ15.Ссылка = &ДокументыОснования";
					
				Результат = Запрос.Выполнить();
				Если НЕ Результат.Пустой() Тогда
					Выборка = Результат.Выбрать();
					Если Выборка.Следующий() Тогда
						Если Выборка.ЕстьСобственныеТовары > 0
							И Выборка.ЕстьКомиссионныеТовары > 0 Тогда
							Возврат "15";
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.АктОбОказанииУслуг") Тогда
				ДанныеДокументаОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, "Дата, Организация");
				
				Запрос = Новый Запрос;
				Запрос.УстановитьПараметр("ДокументыОснования", ДокументОснование);
				Запрос.Текст = 
				"ВЫБРАТЬ
				|	ЕСТЬNULL(СУММА(ВЫБОР
				|			КОГДА АктОбОказанииУслуг.КомиссионнаяТорговля
				|				ТОГДА 1
				|			ИНАЧЕ 0
				|		КОНЕЦ), 0) КАК ЕстьКомиссионныеУслуги,
				|	ЕСТЬNULL(СУММА(ВЫБОР
				|			КОГДА НЕ АктОбОказанииУслуг.КомиссионнаяТорговля
				|				ТОГДА 1
				|			ИНАЧЕ 0
				|		КОНЕЦ), 0) КАК ЕстьСобственныеУслуги
				|ИЗ
				|	Документ.АктОбОказанииУслуг.УслугиОказанные КАК АктОбОказанииУслуг
				|ГДЕ
				|	АктОбОказанииУслуг.Ссылка = &ДокументыОснования";
				Результат = Запрос.Выполнить();
				Если НЕ Результат.Пустой() Тогда
					Выборка = Результат.Выбрать();
					Если Выборка.Следующий() Тогда
						Если Выборка.ЕстьСобственныеУслуги > 0
							И Выборка.ЕстьКомиссионныеУслуги > 0 Тогда
							Возврат "15";
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12") Тогда
				ДанныеДокументаОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, "Дата, Организация");
				СчетаУчетаКомиссионногоТовара =  БухгалтерскийУчет.СчетПоКоду("02.33",ДанныеДокументаОснования.Дата, ДанныеДокументаОснования.Организация);
				
				Запрос = Новый Запрос;
				Запрос.УстановитьПараметр("ДокументыОснования", ДокументОснование);
				Запрос.УстановитьПараметр("СчетаУчетаКомиссионногоТовара", СчетаУчетаКомиссионногоТовара);
				Запрос.Текст = 
				"ВЫБРАТЬ
				|	ЕСТЬNULL(СУММА(ВЫБОР
				|				КОГДА НакладнаяНаРеализациюТорг12Номенклатура.СчетУчета В (&СчетаУчетаКомиссионногоТовара)
				|					ТОГДА 1
				|				ИНАЧЕ 0
				|			КОНЕЦ), 0) КАК ЕстьКомиссионныеТовары,
				|	ЕСТЬNULL(СУММА(ВЫБОР
				|				КОГДА НЕ НакладнаяНаРеализациюТорг12Номенклатура.СчетУчета В (&СчетаУчетаКомиссионногоТовара)
				|					ТОГДА 1
				|				ИНАЧЕ 0
				|			КОНЕЦ), 0) КАК ЕстьСобственныеТовары
				|ИЗ
				|	Документ.НакладнаяНаРеализациюТорг12.Номенклатура КАК НакладнаяНаРеализациюТорг12Номенклатура
				|ГДЕ
				|	НакладнаяНаРеализациюТорг12Номенклатура.Ссылка = &ДокументыОснования";
					
				Результат = Запрос.Выполнить();
				Если НЕ Результат.Пустой() Тогда
					Выборка = Результат.Выбрать();
					Если Выборка.Следующий() Тогда
						Если Выборка.ЕстьСобственныеТовары > 0
							И Выборка.ЕстьКомиссионныеТовары > 0 Тогда
							Возврат "15";
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Возврат "01";
		
	ИначеЕсли	ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.ПокупкаНалоговыйАгент
			ИЛИ	ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.ПокупкаУНерезидентаНалоговыйАгент Тогда
		Возврат "06";
		
	ИначеЕсли ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.ВозвратПоставщику
		ИЛИ ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.СМРХозяйственнымСпособом
		ИЛИ ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.ВнутреннееПотребление
		ИЛИ ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.ВозвратОтПокупателя Тогда
		Возврат "01";
		
		
	ИначеЕсли	ВидЗаполняемогоДокумента = "СчетФактураВыданный"
		   ИЛИ	ВидЗаполняемогоДокумента = "СчетФактураПолученный" Тогда
		Возврат "01";
		
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция НайтиПоследниеИсправительныеСчетаФактуры(СписокДокументов, ПричиныНалогообложения)
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("СписокДокументов", СписокДокументов);
	ЗапросПоиск.УстановитьПараметр("ПричиныНалогообложения", ПричиныНалогообложения);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Все документы исправительных счетов-фактур.
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка					КАК Ссылка,
	|	ИсправляемыйДокумент	КАК ИсправляемыйДокумент,
	|	НомерИсправления		КАК НомерИсправления,
	|	ДатаИсправления			КАК ДатаИсправления
	|ПОМЕСТИТЬ
	|	ВсеДокументы
	|ИЗ
	|	Документ.ИсправительныйСчетФактураВыданный
	|ГДЕ
	|	Проведен
	|	И ИсправляемыйДокумент В(&СписокДокументов)
	|	И ПричинаНалогообложения В(&ПричиныНалогообложения)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Максимальные номера исправлений.
	|//
	|ВЫБРАТЬ
	|	ИсправляемыйДокумент		КАК ИсправляемыйДокумент,
	|	МАКСИМУМ(НомерИсправления)	КАК НомерИсправления
	|ПОМЕСТИТЬ
	|	МаксимальныеНомераИсправлений
	|ИЗ
	|	ВсеДокументы
	|СГРУППИРОВАТЬ ПО
	|	ИсправляемыйДокумент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Искомые документы исправительных счетов-фактур.
	|//
	|ВЫБРАТЬ
	|	ВсеДокументы.ИсправляемыйДокумент	КАК ИсправляемыйДокумент,
	|	ВсеДокументы.НомерИсправления		КАК НомерИсправления,
	|	ВсеДокументы.ДатаИсправления		КАК ДатаИсправления,
	|	МАКСИМУМ(ВсеДокументы.Ссылка)		КАК Ссылка
	|ИЗ
	|	ВсеДокументы
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ МаксимальныеНомераИсправлений
	|		ПО ВсеДокументы.ИсправляемыйДокумент = МаксимальныеНомераИсправлений.ИсправляемыйДокумент
	|		И ВсеДокументы.НомерИсправления = МаксимальныеНомераИсправлений.НомерИсправления
	|СГРУППИРОВАТЬ ПО
	|	ВсеДокументы.ИсправляемыйДокумент,
	|	ВсеДокументы.НомерИсправления,
	|	ВсеДокументы.ДатаИсправления";
		
	Возврат ЗапросПоиск.Выполнить().Выгрузить();
	
КонецФункции

Функция ПрочитатьПризнакиПрослеживаемостиОС(МассивСчетовФактур)
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивСсылок", МассивСчетовФактур);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Даты документов и основные средства из счетов-фактур
	|//
	|ВЫБРАТЬ
	|	Ссылка						КАК Ссылка,
	|	Ссылка.Организация			КАК Организация,
	|	Ссылка.ДокументОснование	КАК ДокументРеализации,
	|	НФА							КАК ОС
	|ИЗ
	|	Документ.СчетФактураВыданный.СоставНФА
	|ГДЕ
	|	Ссылка В(&МассивСсылок)
	|	И НФА ССЫЛКА Справочник.ОсновныеСредства
	|	
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Ссылка							КАК Ссылка,
	|	Ссылка.Организация				КАК Организация,
	|	Ссылка.ДокументКорректировки	КАК ДокументРеализации,
	|	НФА								КАК ОС
	|ИЗ
	|	Документ.ИсправительныйСчетФактураВыданный.СоставНФА
	|ГДЕ
	|	Ссылка В(&МассивСсылок)
	|	И НФА ССЫЛКА Справочник.ОсновныеСредства
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Ссылка							КАК Ссылка,
	|	Ссылка.Организация				КАК Организация,
	|	Ссылка.ДокументКорректировки	КАК ДокументРеализации,
	|	НФА								КАК ОС
	|ИЗ
	|	Документ.КорректировочныйСчетФактураВыданный.СоставНФА
	|ГДЕ
	|	Ссылка В(&МассивСсылок)	
	|	И НФА ССЫЛКА Справочник.ОсновныеСредства";	
	
	УстановитьПривилегированныйРежим(Истина);
	ТаблицаОбщийСписокОС = ЗапросПоиск.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	ТаблицаОбщийСписокОС.Индексы.Добавить("Ссылка");
	
	Поиск = Новый Структура("Ссылка");
	
	ТекстШаблон = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	&СчетФактура%1			КАК Ссылка,
	|	&ДокументРеализации%1	КАК ДокументРеализации,
	|	ОсновноеСредство		КАК ОсновноеСредство
	|ИЗ
	|	РегистрНакопления.ПрослеживаемыеОС.Остатки(
	|		&Период%1,
	|		Организация = &Организация%1
	|		И ОсновноеСредство В (&ОсновныеСредства%1)
	|		И (Комплектующее ССЫЛКА Справочник.ОсновныеСредства
	|			И НЕ Комплектующее = ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)
	|			ИЛИ Комплектующее ССЫЛКА Справочник.Номенклатура
	|			И НЕ Комплектующее = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка))) КАК ПрослеживаемыеОСОстатки
	|";
	
	ТекстОбъединить = "
	|ОБЪЕДИНИТЬ ВСЕ
	|";
	
	Текст = "";
	
	ЗапросПоиск = Новый Запрос();
	
	Счетчик = 0;
	
	Для Каждого ДокументСсылка Из МассивСчетовФактур Цикл
		Поиск.Ссылка = ДокументСсылка;
		
		ТаблицаДокумента = ТаблицаОбщийСписокОС.Скопировать(Поиск);
		
		Если ТаблицаДокумента.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ШапкаДокумента = ТаблицаДокумента[0];
		
		Если Не ЗначениеЗаполнено(ШапкаДокумента.ДокументРеализации) Тогда
			Продолжить;
		КонецЕсли;
		
		СписокОС = ТаблицаДокумента.ВыгрузитьКолонку("ОС");
		
		Счетчик = Счетчик + 1;
		
		СчетчикПредставление = Формат(Счетчик, "ЧГ=0");
		
		ЗапросПоиск.УстановитьПараметр("СчетФактура" + СчетчикПредставление,		ШапкаДокумента.Ссылка);
		ЗапросПоиск.УстановитьПараметр("ДокументРеализации" + СчетчикПредставление,	ШапкаДокумента.ДокументРеализации);
		ЗапросПоиск.УстановитьПараметр("Период" + СчетчикПредставление,				Новый Граница(ШапкаДокумента.ДокументРеализации.МоментВремени(), ВидГраницы.Исключая));
		ЗапросПоиск.УстановитьПараметр("Организация" + СчетчикПредставление,		ШапкаДокумента.Организация);
		ЗапросПоиск.УстановитьПараметр("ОсновныеСредства" + СчетчикПредставление,	СписокОС);
		
		Текст = Текст + ?(Счетчик = 1, "", ТекстОбъединить) + СтрШаблон(ТекстШаблон, СчетчикПредставление);
	КонецЦикла;
	
	Если Счетчик = 0 Тогда
		Возврат Новый Массив();
	КонецЕсли;
	
	ЗапросПоиск.Текст = Текст;
	
	УстановитьПривилегированныйРежим(Истина);
	ТаблицаПрослеживаемыеОС = ЗапросПоиск.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	ТаблицаПрослеживаемыеОС.Индексы.Добавить("Ссылка");
	
	ТаблицаПрослеживаемыеОС.Свернуть("Ссылка");
	
	Возврат ТаблицаПрослеживаемыеОС.ВыгрузитьКолонку("Ссылка");
	
КонецФункции

Функция ПолучитьПризнакиСчетаФактуры(ДокументСсылка, ПризнакиСчетовФактур)
	
	Если ПризнакиСчетовФактур = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Поиск = Новый Структура("Ссылка", ДокументСсылка);
	
	МассивСтрок = ПризнакиСчетовФактур.НайтиСтроки(Поиск);
	
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат МассивСтрок[0];
	
КонецФункции

Функция ЭтоКорректировкаПоИсправляемомуДокументу(ИсправляемыйДокумент)
	
	ТипСсылки = ТипЗнч(ИсправляемыйДокумент);
	
	Возврат ТипСсылки = Тип("ДокументСсылка.КорректировочныйСчетФактураВыданный")
		Или ТипСсылки = Тип("ДокументСсылка.КорректировочныйСчетФактураПолученный");
	
КонецФункции

Процедура УдалитьЗначечнияНедоступныеПоФункциональнымОпциям(СписокВыбора)
	
	РеализацияКомиссионныхТоваровСПозицииКомиссионера = ПолучитьФункциональнуюОпцию("ВестиУчетПоРеализацииТоваровУслугКомитентов");
	РеализацияКомиссионныхТоваровСПозицииКомитента = ПолучитьФункциональнуюОпцию("ВестиУчетПоРеализацииТоваровУслугЧерезКомиссионеров");
	ЗакупкаКомиссионныхТоваровСПозицииКомитентов = ПолучитьФункциональнуюОпцию("ВестиУчетПоЗакупкеТоваровУслугЧерезКомиссионеров");
	ЗакупкаКомиссионныхТоваровСПозицииКомиссионера = ПолучитьФункциональнуюОпцию("ВестиУчетПоЗакупкеТоваровУслугДляКомитентов");
	
	МаксимальныйИндекс = СписокВыбора.Количество() - 1;
	Для Индекс = 0 По МаксимальныйИндекс Цикл
		ИндексСтроки = МаксимальныйИндекс - Индекс;
		ТекущаяСтрока = СписокВыбора[ИндексСтроки];
		
		Если ТекущаяСтрока.Значение = Перечисления.ПричиныНалогообложенияНДС.АвансПолученныйКомиссионером 
			ИЛИ ТекущаяСтрока.Значение = Перечисления.ПричиныНалогообложенияНДС.СчетФактураНаАвансОтКомитента
			ИЛИ ТекущаяСтрока.Значение = Перечисления.ПричиныНалогообложенияНДС.СчетФактураНаРеализациюОтКомитента Тогда
			Если НЕ РеализацияКомиссионныхТоваровСПозицииКомиссионера Тогда
				СписокВыбора.Удалить(ИндексСтроки);
			КонецЕсли;
		ИначеЕсли ТекущаяСтрока.Значение = Перечисления.ПричиныНалогообложенияНДС.СчетФактураКомитентаНаРеализацию
			ИЛИ ТекущаяСтрока.Значение = Перечисления.ПричиныНалогообложенияНДС.СчетФактураКомитентаНаАванс Тогда
			Если НЕ РеализацияКомиссионныхТоваровСПозицииКомитента Тогда
				СписокВыбора.Удалить(ИндексСтроки);
			КонецЕсли;
		ИначеЕсли ТекущаяСтрока.Значение = Перечисления.ПричиныНалогообложенияНДС.СчетФактураНаПокупкуОтКомиссионера
			ИЛИ ТекущаяСтрока.Значение = Перечисления.ПричиныНалогообложенияНДС.СчетФактураНаАвансОтКомиссионера Тогда
			Если НЕ ЗакупкаКомиссионныхТоваровСПозицииКомитентов Тогда
				СписокВыбора.Удалить(ИндексСтроки);
			КонецЕсли;
		ИначеЕсли ТекущаяСтрока.Значение = Перечисления.ПричиныНалогообложенияНДС.СчетФактураКомиссионераНаПокупку
			ИЛИ ТекущаяСтрока.Значение = Перечисления.ПричиныНалогообложенияНДС.АвансВыданныйКомиссионером 
			ИЛИ ТекущаяСтрока.Значение = Перечисления.ПричиныНалогообложенияНДС.СчетФактураКомиссионераНаАванс Тогда
			Если НЕ ЗакупкаКомиссионныхТоваровСПозицииКомиссионера Тогда
				СписокВыбора.Удалить(ИндексСтроки);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область РасчетИОбработка

Функция ОпределитьОдноименныеКолонкиДерева(Дерево)
	
	// Возвращаемое значение:
	Результат = Новый Структура("ОдноименныеКолонки, ЗаполняемыеКолонки");
	
	ОдноименныеКолонки = Новый Соответствие();
	ЗаполняемыеКолонки = Новый Соответствие();
	
	ИсходныеКолонки = Дерево.Колонки;
	
	// Определяем одноименные колонки (по заголовку)
	// и одну из них - заполняемую:
	Для Каждого Колонка Из ИсходныеКолонки Цикл
		ИмяКолонки			= Колонка.Имя;
		ЗаголовокКолонки	= Колонка.Заголовок;
		Если ПустаяСтрока(ИмяКолонки) Тогда
			Продолжить;
		КонецЕсли;
		
		МассивИмен = ОдноименныеКолонки.Получить(ЗаголовокКолонки);
		Если МассивИмен = Неопределено Тогда
			МассивИмен = Новый Массив();
		КонецЕсли;
		
		Если МассивИмен.Количество() >= 1 Тогда
			ПоследнееДобавленноеИмяКолонки = МассивИмен[МассивИмен.Количество() - 1];
		Иначе
			ПоследнееДобавленноеИмяКолонки = "";
		КонецЕсли;
		
		Если ИмяКолонки < ПоследнееДобавленноеИмяКолонки ИЛИ ПоследнееДобавленноеИмяКолонки = "" Тогда
			ЗаполняемыеКолонки.Вставить(ЗаголовокКолонки, ИмяКолонки);
		КонецЕсли;
		Если МассивИмен.Найти(ИмяКолонки) = Неопределено Тогда
			МассивИмен.Добавить(ИмяКолонки);
		КонецЕсли;
		ОдноименныеКолонки.Вставить(ЗаголовокКолонки, МассивИмен);
	КонецЦикла;
	Для Каждого Колонка Из ОдноименныеКолонки Цикл
		ЗаголовокКолонки = Колонка.Ключ;
		Если Колонка.Значение.Количество() <= 1 Тогда
			ОдноименныеКолонки.Удалить(ЗаголовокКолонки);
			ЗаполняемыеКолонки.Удалить(ЗаголовокКолонки);
		Иначе
			ИмяЗаполняемойКолонки = ЗаполняемыеКолонки.Получить(ЗаголовокКолонки);
			МассивИмен = ОдноименныеКолонки.Получить(ЗаголовокКолонки);
			МассивИмен.Удалить(МассивИмен.Найти(ИмяЗаполняемойКолонки));
		КонецЕсли;
	КонецЦикла;
	
	Результат["ОдноименныеКолонки"] = ОдноименныеКолонки;
	Результат["ЗаполняемыеКолонки"] = ЗаполняемыеКолонки;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьКолонкиВСтрокахДерева(СтрокаРодитель, ИменаДублейКолонок)
	
	ОдноименныеКолонки = ИменаДублейКолонок["ОдноименныеКолонки"];
	ЗаполняемыеКолонки = ИменаДублейКолонок["ЗаполняемыеКолонки"];
	
	Для Каждого ТекущаяСтрока Из СтрокаРодитель.Строки Цикл
		Если ТекущаяСтрока.Строки.Количество() > 0 Тогда
			ЗаполнитьКолонкиВСтрокахДерева(ТекущаяСтрока, ИменаДублейКолонок);
		КонецЕсли;
		
		Для Каждого Колонка Из ЗаполняемыеКолонки Цикл
			ИмяЗаполняемойКолонки = Колонка.Значение;
			Если НЕ ЗначениеЗаполнено(ТекущаяСтрока[ИмяЗаполняемойКолонки]) Тогда
				ИменаКолонок = ОдноименныеКолонки.Получить(Колонка.Ключ);
				Для Каждого ИмяКолонки Из ИменаКолонок Цикл
					Если ЗначениеЗаполнено(ТекущаяСтрока[ИмяКолонки]) Тогда
						ТекущаяСтрока[ИмяЗаполняемойКолонки] = ТекущаяСтрока[ИмяКолонки];
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Функция ПрименитьОтборПоСчетуФактуре(ИмяРегистра, СчетФактура)
	
	Если Не ЗначениеЗаполнено(СчетФактура) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Метаданные.РегистрыНакопления[ИмяРегистра].Измерения.СчетФактура.Тип.СодержитТип(ТипЗнч(СчетФактура));
	
КонецФункции

Процедура ДобавитьПричинуНалогообложенияДокументаРеализации(ШапкаДокумента, ДокументСсылка)
	
	// Применяется для заполнения УПД статуса 2.
	
	ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.Реализация;
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.АктОбОказанииУслуг") Тогда
		
		Если ШапкаДокумента.РеализацияПоСтавке0 Тогда
			ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.Реализация0;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.НакладнаяНаОтпускМ15")
		Или ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12") Тогда
		
		Если ШапкаДокумента.ТипДоговораНДС = Перечисления.ТипыДоговоровДляНДС.РеализацияЛомаШкур Тогда
			ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.РеализацияЛом;
		ИначеЕсли ШапкаДокумента.РеализацияПоСтавке0 Тогда
			ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.Реализация0;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПоступлениеУслугРабот") Тогда
		
		Если ШапкаДокумента.ТипДоговораНДС = Перечисления.ТипыДоговоровДляНДС.АгентскийДоговор Тогда
			ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.ПокупкаНалоговыйАгент;
		ИначеЕсли ШапкаДокумента.ТипДоговораНДС = Перечисления.ТипыДоговоровДляНДС.АгентскийДоговорНерезидент Тогда
			ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.ПокупкаУНерезидентаНалоговыйАгент;
		Иначе
			ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.ПустаяСсылка();
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПоступлениеОСИК") Тогда
		ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.ПокупкаНалоговыйАгент;
	КонецЕсли;
	
	ШапкаДокумента.Вставить("ПричинаНалогообложения", ПричинаНалогообложения);
	
КонецПроцедуры

Процедура ТаблицаСОбщимиКолонкамиНДС_УвеличитьСуммыВСтроке(СтрокаИсходнойТаблицы, ТаблицаРезультат, СтруктураПоиск, ОбозначениеИндивидуальнойКолонкиНДС)
	
	Если ОбозначениеИндивидуальнойКолонкиНДС = "22" Тогда
		СтавкаНДС			= СтрокаИсходнойТаблицы["СтавкаНДС22"];
		СуммаБезНДС			= СтрокаИсходнойТаблицы["Сумма22"];
		СуммаНДС			= СтрокаИсходнойТаблицы["СуммаНДС22"];
		СуммаБезНДСВалютная	= СтрокаИсходнойТаблицы["Сумма22Валютная"];
		СуммаНДСВалютная	= СтрокаИсходнойТаблицы["СуммаНДС22Валютная"];
		
	ИначеЕсли ОбозначениеИндивидуальнойКолонкиНДС = "18" Тогда
		СтавкаНДС			= СтрокаИсходнойТаблицы["СтавкаНДС18"];
		СуммаБезНДС			= СтрокаИсходнойТаблицы["Сумма18"];
		СуммаНДС			= СтрокаИсходнойТаблицы["СуммаНДС18"];
		СуммаБезНДСВалютная	= СтрокаИсходнойТаблицы["Сумма18Валютная"];
		СуммаНДСВалютная	= СтрокаИсходнойТаблицы["СуммаНДС18Валютная"];
		
	ИначеЕсли ОбозначениеИндивидуальнойКолонкиНДС = "10" Тогда
		СтавкаНДС			= СтрокаИсходнойТаблицы["СтавкаНДС10"];
		СуммаБезНДС			= СтрокаИсходнойТаблицы["Сумма10"];
		СуммаНДС			= СтрокаИсходнойТаблицы["СуммаНДС10"];
		СуммаБезНДСВалютная	= СтрокаИсходнойТаблицы["Сумма10Валютная"];
		СуммаНДСВалютная	= СтрокаИсходнойТаблицы["СуммаНДС10Валютная"];
		
	ИначеЕсли ОбозначениеИндивидуальнойКолонкиНДС = "7" Тогда
		СтавкаНДС			= СтрокаИсходнойТаблицы["СтавкаНДС7"];
		СуммаБезНДС			= СтрокаИсходнойТаблицы["Сумма7"];
		СуммаНДС			= СтрокаИсходнойТаблицы["СуммаНДС7"];
		СуммаБезНДСВалютная	= СтрокаИсходнойТаблицы["Сумма7Валютная"];
		СуммаНДСВалютная	= СтрокаИсходнойТаблицы["СуммаНДС7Валютная"];
		
	ИначеЕсли ОбозначениеИндивидуальнойКолонкиНДС = "5" Тогда
		СтавкаНДС			= СтрокаИсходнойТаблицы["СтавкаНДС5"];
		СуммаБезНДС			= СтрокаИсходнойТаблицы["Сумма5"];
		СуммаНДС			= СтрокаИсходнойТаблицы["СуммаНДС5"];
		СуммаБезНДСВалютная	= СтрокаИсходнойТаблицы["Сумма5Валютная"];
		СуммаНДСВалютная	= СтрокаИсходнойТаблицы["СуммаНДС5Валютная"];
		
	ИначеЕсли ОбозначениеИндивидуальнойКолонкиНДС = "0" Тогда
		СтавкаНДС			= Перечисления.СтавкиНДС.НДС0;
		СуммаБезНДС			= СтрокаИсходнойТаблицы["Сумма0"];
		СуммаНДС			= 0;
		СуммаБезНДСВалютная	= СтрокаИсходнойТаблицы["Сумма0Валютная"];
		СуммаНДСВалютная	= 0;
		
	ИначеЕсли ОбозначениеИндивидуальнойКолонкиНДС = "БН" Тогда
		СтавкаНДС			= Перечисления.СтавкиНДС.БезНДС;
		СуммаБезНДС			= СтрокаИсходнойТаблицы["СуммаБН"];
		СуммаНДС			= 0;
		СуммаБезНДСВалютная	= СтрокаИсходнойТаблицы["СуммаБНВалютная"];
		СуммаНДСВалютная	= 0;
	КонецЕсли;
	
	// Нужно ли добавить новую строку для текущей аналитики?
	ЗаполнитьЗначенияСвойств(СтруктураПоиск, СтрокаИсходнойТаблицы);
	СтруктураПоиск.Вставить("СтавкаНДС", СтавкаНДС);
	МассивДобавленныхСтрок = ТаблицаРезультат.НайтиСтроки(СтруктураПоиск);
	Если МассивДобавленныхСтрок.Количество() > 0 Тогда
		НоваяСтрока = МассивДобавленныхСтрок[0];
	Иначе
		НоваяСтрока = ТаблицаРезультат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИсходнойТаблицы);
		НоваяСтрока["СтавкаНДС"]			= СтавкаНДС;
		НоваяСтрока["СуммаБезНДС"]			= 0;
		НоваяСтрока["СуммаНДС"]				= 0;
		НоваяСтрока["Всего"]				= 0;
		НоваяСтрока["СуммаБезНДСВалютная"]	= 0;
		НоваяСтрока["СуммаНДСВалютная"]		= 0;
		НоваяСтрока["ВсегоВалютная"]		= 0;
	КонецЕсли;
	
	НоваяСтрока["СуммаБезНДС"]			= НоваяСтрока["СуммаБезНДС"]			+ СуммаБезНДС;
	НоваяСтрока["СуммаНДС"]				= НоваяСтрока["СуммаНДС"]				+ СуммаНДС;
	НоваяСтрока["Всего"]				= НоваяСтрока["Всего"]					+ (СуммаБезНДС + СуммаНДС);
	НоваяСтрока["СуммаБезНДСВалютная"]	= НоваяСтрока["СуммаБезНДСВалютная"]	+ СуммаБезНДСВалютная;
	НоваяСтрока["СуммаНДСВалютная"]		= НоваяСтрока["СуммаНДСВалютная"]		+ СуммаНДСВалютная;
	НоваяСтрока["ВсегоВалютная"]		= НоваяСтрока["ВсегоВалютная"]			+ (СуммаБезНДСВалютная + СуммаНДСВалютная);
	
КонецПроцедуры	

Процедура ТаблицаСИндивидуальнымиКолонкамиНДС_УвеличитьСуммыВСтроке(СтрокаИсходнойТаблицы, СтрокаНовойТаблицы, ОбозначениеИндивидуальнойКолонкиНДС)
	
	Если ОбозначениеИндивидуальнойКолонкиНДС = "22" Тогда
		СтрокаНовойТаблицы["СтавкаНДС22"]	= СтрокаИсходнойТаблицы["СтавкаНДС"];
		СтрокаНовойТаблицы["Сумма22"]		= СтрокаНовойТаблицы["Сумма22"]		+ СтрокаИсходнойТаблицы["СуммаБезНДС"];
		СтрокаНовойТаблицы["СуммаНДС22"]	= СтрокаНовойТаблицы["СуммаНДС22"]	+ СтрокаИсходнойТаблицы["СуммаНДС"];
		СтрокаНовойТаблицы["Сумма22Валютная"]		= СтрокаНовойТаблицы["Сумма22Валютная"]		+ СтрокаИсходнойТаблицы["СуммаБезНДСВалютная"];
		СтрокаНовойТаблицы["СуммаНДС22Валютная"]	= СтрокаНовойТаблицы["СуммаНДС22Валютная"]	+ СтрокаИсходнойТаблицы["СуммаНДСВалютная"];
		
	ИначеЕсли ОбозначениеИндивидуальнойКолонкиНДС = "18" Тогда
		СтрокаНовойТаблицы["СтавкаНДС18"]	= СтрокаИсходнойТаблицы["СтавкаНДС"];
		СтрокаНовойТаблицы["Сумма18"]		= СтрокаНовойТаблицы["Сумма18"]		+ СтрокаИсходнойТаблицы["СуммаБезНДС"];
		СтрокаНовойТаблицы["СуммаНДС18"]	= СтрокаНовойТаблицы["СуммаНДС18"]	+ СтрокаИсходнойТаблицы["СуммаНДС"];
		СтрокаНовойТаблицы["Сумма18Валютная"]		= СтрокаНовойТаблицы["Сумма18Валютная"]		+ СтрокаИсходнойТаблицы["СуммаБезНДСВалютная"];
		СтрокаНовойТаблицы["СуммаНДС18Валютная"]	= СтрокаНовойТаблицы["СуммаНДС18Валютная"]	+ СтрокаИсходнойТаблицы["СуммаНДСВалютная"];
		
	ИначеЕсли ОбозначениеИндивидуальнойКолонкиНДС = "10" Тогда
		СтрокаНовойТаблицы["СтавкаНДС10"]	= СтрокаИсходнойТаблицы["СтавкаНДС"];
		СтрокаНовойТаблицы["Сумма10"]		= СтрокаНовойТаблицы["Сумма10"]		+ СтрокаИсходнойТаблицы["СуммаБезНДС"];
		СтрокаНовойТаблицы["СуммаНДС10"]	= СтрокаНовойТаблицы["СуммаНДС10"]	+ СтрокаИсходнойТаблицы["СуммаНДС"];
		СтрокаНовойТаблицы["Сумма10Валютная"]		= СтрокаНовойТаблицы["Сумма10Валютная"]		+ СтрокаИсходнойТаблицы["СуммаБезНДСВалютная"];
		СтрокаНовойТаблицы["СуммаНДС10Валютная"]	= СтрокаНовойТаблицы["СуммаНДС10Валютная"]	+ СтрокаИсходнойТаблицы["СуммаНДСВалютная"];
		
	ИначеЕсли ОбозначениеИндивидуальнойКолонкиНДС = "7" Тогда
		СтрокаНовойТаблицы["СтавкаНДС7"]		= СтрокаИсходнойТаблицы["СтавкаНДС"];
		СтрокаНовойТаблицы["Сумма7"]			= СтрокаНовойТаблицы["Сумма7"]				+ СтрокаИсходнойТаблицы["СуммаБезНДС"];
		СтрокаНовойТаблицы["СуммаНДС7"]			= СтрокаНовойТаблицы["СуммаНДС7"]			+ СтрокаИсходнойТаблицы["СуммаНДС"];
		СтрокаНовойТаблицы["Сумма7Валютная"]	= СтрокаНовойТаблицы["Сумма7Валютная"]		+ СтрокаИсходнойТаблицы["СуммаБезНДСВалютная"];
		СтрокаНовойТаблицы["СуммаНДС7Валютная"]	= СтрокаНовойТаблицы["СуммаНДС7Валютная"]	+ СтрокаИсходнойТаблицы["СуммаНДСВалютная"];
		
	ИначеЕсли ОбозначениеИндивидуальнойКолонкиНДС = "5" Тогда
		СтрокаНовойТаблицы["СтавкаНДС5"]		= СтрокаИсходнойТаблицы["СтавкаНДС"];
		СтрокаНовойТаблицы["Сумма5"]			= СтрокаНовойТаблицы["Сумма5"]				+ СтрокаИсходнойТаблицы["СуммаБезНДС"];
		СтрокаНовойТаблицы["СуммаНДС5"]			= СтрокаНовойТаблицы["СуммаНДС5"]			+ СтрокаИсходнойТаблицы["СуммаНДС"];
		СтрокаНовойТаблицы["Сумма5Валютная"]	= СтрокаНовойТаблицы["Сумма5Валютная"]		+ СтрокаИсходнойТаблицы["СуммаБезНДСВалютная"];
		СтрокаНовойТаблицы["СуммаНДС5Валютная"]	= СтрокаНовойТаблицы["СуммаНДС5Валютная"]	+ СтрокаИсходнойТаблицы["СуммаНДСВалютная"];
		
	ИначеЕсли ОбозначениеИндивидуальнойКолонкиНДС = "0" Тогда
		СтрокаНовойТаблицы["Сумма0"]		= СтрокаНовойТаблицы["Сумма0"]		+ СтрокаИсходнойТаблицы["СуммаБезНДС"];
		СтрокаНовойТаблицы["Сумма0Валютная"]		= СтрокаНовойТаблицы["Сумма0Валютная"]		+ СтрокаИсходнойТаблицы["СуммаБезНДСВалютная"];
		
	ИначеЕсли ОбозначениеИндивидуальнойКолонкиНДС = "БН" Тогда
		СтрокаНовойТаблицы["СуммаБН"]		= СтрокаНовойТаблицы["СуммаБН"]		+ СтрокаИсходнойТаблицы["СуммаБезНДС"];
		СтрокаНовойТаблицы["СуммаБНВалютная"]		= СтрокаНовойТаблицы["СуммаБНВалютная"]		+ СтрокаИсходнойТаблицы["СуммаБезНДСВалютная"];
		
	КонецЕсли;
	
	СтрокаНовойТаблицы["Всего"] = СтрокаНовойТаблицы["Сумма22"] + СтрокаНовойТаблицы["СуммаНДС22"]
		+ СтрокаНовойТаблицы["Сумма18"] + СтрокаНовойТаблицы["СуммаНДС18"]
		+ СтрокаНовойТаблицы["Сумма10"] + СтрокаНовойТаблицы["СуммаНДС10"]
		+ СтрокаНовойТаблицы["Сумма7"] + СтрокаНовойТаблицы["СуммаНДС7"]
		+ СтрокаНовойТаблицы["Сумма5"] + СтрокаНовойТаблицы["СуммаНДС5"]
		+ СтрокаНовойТаблицы["Сумма0"] + СтрокаНовойТаблицы["СуммаБН"];
		
	СтрокаНовойТаблицы["ВсегоВалютная"] = СтрокаНовойТаблицы["Сумма22Валютная"] + СтрокаНовойТаблицы["СуммаНДС22Валютная"]
		+ СтрокаНовойТаблицы["Сумма18Валютная"] + СтрокаНовойТаблицы["СуммаНДС18Валютная"]
		+ СтрокаНовойТаблицы["Сумма10Валютная"] + СтрокаНовойТаблицы["СуммаНДС10Валютная"]
		+ СтрокаНовойТаблицы["Сумма7Валютная"] + СтрокаНовойТаблицы["СуммаНДС7Валютная"]
		+ СтрокаНовойТаблицы["Сумма5Валютная"] + СтрокаНовойТаблицы["СуммаНДС5Валютная"]
		+ СтрокаНовойТаблицы["Сумма0Валютная"] + СтрокаНовойТаблицы["СуммаБНВалютная"];
	
КонецПроцедуры

Функция ПолучитьИменаКолонок(Таблица)
	
	Результат = Новый Массив();
	
	Для Каждого Колонка Из Таблица.Колонки Цикл
		Результат.Добавить(Колонка.Имя);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьТекстУсловияОтбора(Отбор, ВидДокумента, Запрос)
	
	Перем ПоляОтбора;
	
	Если НЕ Отбор.Свойство(ВидДокумента, ПоляОтбора) Тогда
		Возврат "Истина";
	КонецЕсли;
	
	ТекстУсловияОтбора = "";
	
	Для Каждого Элемент Из ПоляОтбора Цикл
		
		ТекстУсловияОтбора = ТекстУсловияОтбора
			+ ?(ТекстУсловияОтбора = "", "", "
				|	И ")
			+ Элемент.Ключ + " = ";
		
		Если ТипЗнч(Элемент.Значение) = Тип("Строка") тогда
			ТекстУсловияОтбора = ТекстУсловияОтбора + Элемент.Значение;
		Иначе
			ИмяПараметра = ВидДокумента + "_" + СтрЗаменить(Элемент.Ключ, ".", "_");
			
			ТекстУсловияОтбора = ТекстУсловияОтбора + "&" + ИмяПараметра;
			
			Запрос.УстановитьПараметр(ИмяПараметра, Элемент.Значение);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТекстУсловияОтбора;
	
КонецФункции

#КонецОбласти

#Область ЗачетАванса

Функция РазбитьПоДатамЗачетаИВозвратаАванса(Знач ТаблицаОстаткиАвансов, Знач Дата, Знач Организация, Знач ДокументСсылка, Знач ЭтоПолученныеАвансы,
		Знач АвансыКомиссионера = Ложь, Знач СписокДокументовЗачетаАванса = Неопределено, СчетаФактурыНаОтгрузку = Неопределено)
	
	Перем ТаблицаВозвратов, ТаблицаЗачетаАвансовПоРегистраторам;
	
	Если ТаблицаОстаткиАвансов.Количество() = 0 Тогда
		Возврат Новый ТаблицаЗначений();
	КонецЕсли;
	
	Параметры = ПолучитьПараметрыАнализаАвансов(ТаблицаОстаткиАвансов, Дата, Организация, ДокументСсылка, ЭтоПолученныеАвансы, АвансыКомиссионера, СписокДокументовЗачетаАванса);
	
	// Зачеты
	ТаблицаЗачетов = ПолучитьТаблицуЗачетаАвансов(Параметры, ТаблицаЗачетаАвансовПоРегистраторам);
	
	// Возвраты
	Если ЭтоПолученныеАвансы Тогда
		ДобавитьТаблицуВозвратаАвансовПолученных(ТаблицаЗачетов, Параметры);
	КонецЕсли;
	
	// Уже учтенные суммы
	ТаблицаУчтенных = ПолучитьТаблицуУжеУчтенныхСуммАвансов(Параметры);
	
	МассивИменКолонокСвязи = Новый Массив();
	МассивИменКолонокСвязи.Добавить("Контрагент");
	МассивИменКолонокСвязи.Добавить("Договор");
	МассивИменКолонокСвязи.Добавить("СчетРасчетов");
	МассивИменКолонокСвязи.Добавить("КПССчетРасчетов");
	МассивИменКолонокСвязи.Добавить("ДокументРасчетов");
	
	МассивИменКолонокПоказателей = Новый Массив();
	МассивИменКолонокПоказателей.Добавить("ВсегоВалютная");
	МассивИменКолонокПоказателей.Добавить("Всего");
	
	ОчиститьДокументРасчетовВТаблице(ТаблицаОстаткиАвансов, ТаблицаЗачетов, МассивИменКолонокСвязи);
	ОчиститьДокументРасчетовВТаблице(ТаблицаУчтенных, ТаблицаЗачетов, МассивИменКолонокСвязи);
	
	//
	// 1. Вычитаем уже учтенные суммы
	//
	
	РезультатыСравнения = ОбщегоНазначенияБГУ.СравнитьПоказателиТаблиц(
		ТаблицаЗачетов,
		ТаблицаУчтенных,
		МассивИменКолонокСвязи,
		МассивИменКолонокПоказателей,
		"ОстаткиВТаблице1,ОстаткиВТаблице2",
		"ПредопределенноеУсловие№1");
		// СтрокаТаблицы1.ДатаЗачета <= СтрокаТаблицы2.Период;
		
	ТаблицаЗачетовОстаток	= РезультатыСравнения["ОстаткиВТаблице1"];
	ТаблицаУчтенныхОстаток	= РезультатыСравнения["ОстаткиВТаблице2"];
	
	//
	// 2. Разбиваем каждую сумму остатка аванса на даты зачетов/возвратов
	//
	
	РезультатыСравнения = ОбщегоНазначенияБГУ.СравнитьПоказателиТаблиц(
		ТаблицаОстаткиАвансов,
		ТаблицаЗачетовОстаток,
		МассивИменКолонокСвязи,
		МассивИменКолонокПоказателей,
		"СписанияВОбеихТаблицахВРазмереСоответствия,ОстаткиВТаблице1",
		"ПредопределенноеУсловие№2/" + Параметры.КолонкаДатыОперации);
		// "СтрокаТаблицы1." + Параметры.КолонкаДатыОперации + " <= КонецДня(СтрокаТаблицы2.ДатаЗачета)"
		
	ТаблицаВычеты						= РезультатыСравнения["СписанияВОбеихТаблицахВРазмереСоответствия"];
	ТаблицаОстаткиАвансовПослеЗачета	= РезультатыСравнения["ОстаткиВТаблице1"];
	
	//
	// 3. Заполняем суммы НДС
	//
	ЗаполнитьСуммыНДС(ТаблицаВычеты);
	
	Если ЭтоПолученныеАвансы И СчетаФактурыНаОтгрузку <> Неопределено Тогда
		ЗаполнитьСчетаФактурыНаОтгрузкуКЗаявленнымВычетам(СчетаФактурыНаОтгрузку,
			ТаблицаВычеты, ТаблицаЗачетаАвансовПоРегистраторам, МассивИменКолонокСвязи);
	КонецЕсли;
	
	Возврат ТаблицаВычеты;
	
КонецФункции

Процедура ДобавитьТаблицуВозвратаАвансовПолученных(ТаблицаЗачетов, Параметры)
	
	ТаблицаЗачетов.Колонки.Добавить("ВозвратАвансаПолученного", Новый ОписаниеТипов("Булево"));
	
	ТаблицаВозвратов = ПолучитьТаблицуВозвратаАвансовПолученных(Параметры);
	
	Для Каждого СтрокаТаблицы Из ТаблицаВозвратов Цикл
		НоваяСтрока = ТаблицаЗачетов.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		
		НоваяСтрока["ВозвратАвансаПолученного"] = Истина;
		НоваяСтрока["ДатаЗачета"] = СтрокаТаблицы["ДатаВозврата"];
	КонецЦикла;
	
	ТаблицаЗачетов.Сортировать("ДатаЗачета");
	
КонецПроцедуры

Функция ПолучитьПараметрыАнализаАвансов(ТаблицаАвансов, Дата, Организация, ДокументСсылка, ЭтоПолученныеАвансы, АвансыКомиссионера = Ложь, СписокДокументовЗачетаАванса = Неопределено)
	
	МассивКФО = Новый Массив();
	МассивКФО.Добавить(Перечисления.КВД.Внебюджет); // КФО=2
	
	Если ЭтоПолученныеАвансы Тогда
		// Авансы полученные
		
		КолонкаДатыОперации 		= "ДатаДокументаОснования";
		РеквизитОборотов		    = "СуммаОборотДт";
		РеквизитОборотовВалютный	= "ВалютнаяСуммаОборотДт";
		ИмяРегистраНДС				= "ВходящийНДС";
		
		МассивКФО.Добавить(Перечисления.КВД.Бюджет);
	Иначе
		// Авансы выданные
		
		КолонкаДатыОперации 		= "ДатаРеализации";
		РеквизитОборотов			= "СуммаОборотКт";
		РеквизитОборотовВалютный	= "ВалютнаяСуммаОборотКт";
		ИмяРегистраНДС				= "ИсходящийНДС";
	КонецЕсли;
	
	// Границы периода анализа авансов
	
	ВремТаблица = ТаблицаАвансов.Скопировать(,КолонкаДатыОперации);
	ВремТаблица.Сортировать(КолонкаДатыОперации + " Возр");
	
	ДатаНачала = ВремТаблица.Получить(0)[КолонкаДатыОперации];
	
	Если НЕ ЗначениеЗаполнено(ДатаНачала) Тогда
		ДатаНачала = Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(Дата) = Тип("МоментВремени") Тогда
		Дата = Дата.Дата;
	КонецЕсли;
	
	ДатаОкончания = ?(ЗначениеЗаполнено(Дата),
		Новый Граница(КонецДня(Дата), ВидГраницы.Включая),
		Неопределено);
		
	Если ЗначениеЗаполнено(Дата) Тогда
		Если Дата < ДатаНачала И АвансыКомиссионера = Истина Тогда
			ДатаНачала = НачалоДня(Дата);
		КонецЕсли;
	КонецЕсли;
	
	// Аналитика из остатков авансов
	
	ИмяКолонки = "Контрагент";
	ВремТаблица = ТаблицаАвансов.Скопировать(, ИмяКолонки);
	ВремТаблица.Свернуть(ИмяКолонки);
	МассивКонтрагентов = ВремТаблица.ВыгрузитьКолонку(ИмяКолонки);
	
	ИмяКолонки = "Договор";
	ВремТаблица = ТаблицаАвансов.Скопировать(, ИмяКолонки);
	ВремТаблица.Свернуть(ИмяКолонки);
	МассивДоговоров = ВремТаблица.ВыгрузитьКолонку(ИмяКолонки);
	
	ИмяКолонки = "СчетРасчетов";
	ВремТаблица = ТаблицаАвансов.Скопировать(, ИмяКолонки);
	ВремТаблица.Свернуть(ИмяКолонки);
	МассивСчетРасчетов = ВремТаблица.ВыгрузитьКолонку(ИмяКолонки);
	
	ИмяКолонки = "КПССчетРасчетов";
	ВремТаблица = ТаблицаАвансов.Скопировать(, ИмяКолонки);
	ВремТаблица.Свернуть(ИмяКолонки);
	МассивКПС = ВремТаблица.ВыгрузитьКолонку(ИмяКолонки);
	
	ВидыСубконто = Новый Массив();
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
	
	ИсключаемыеТипыРегистратора_Зачеты = Новый Массив();
	ИсключаемыеТипыРегистратора_Зачеты.Добавить(Тип("ДокументСсылка.ПереносОстатков64нРасчеты"));
	
	ИсключаемыеТипыРегистратора_Учтенные = Новый Массив();
	ИсключаемыеТипыРегистратора_Учтенные.Добавить(Тип("ДокументСсылка.КорректировкаРегистров"));
	ИсключаемыеТипыРегистратора_Учтенные.Добавить(Тип("ДокументСсылка.ПереносОстатков64нРасчеты"));
	
	Параметры = Новый Структура();
	
	Параметры.Вставить("ДокументСсылка",					ДокументСсылка);
	Параметры.Вставить("Организация",						Организация);
	Параметры.Вставить("ДатаНачала",						ДатаНачала);
	Параметры.Вставить("ДатаОкончания",						ДатаОкончания);
	Параметры.Вставить("МассивКонтрагентов",				МассивКонтрагентов);
	Параметры.Вставить("МассивДоговоров",					МассивДоговоров);
	Параметры.Вставить("МассивСчетРасчетов",				МассивСчетРасчетов);
	Параметры.Вставить("МассивКПС",							МассивКПС);
	Параметры.Вставить("МассивКФО",							МассивКФО);
	
	Параметры.Вставить("ИмяРегистраНДС",					ИмяРегистраНДС);
	Параметры.Вставить("РеквизитОборотов",					РеквизитОборотов);
	Параметры.Вставить("РеквизитОборотовВалютный",			РеквизитОборотовВалютный);
	Параметры.Вставить("КолонкаДатыОперации",				КолонкаДатыОперации);
	
	Параметры.Вставить("ВидыСубконто",						ВидыСубконто);
	Параметры.Вставить("ЗаполнитьВалютныеСуммы",			УчетНДС.СледуетЗаполнитьВалютныеСуммы());
	Параметры.Вставить("ИспользоватьУчетПоПодразделениям",	ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Параметры.Вставить("ЭтоПолученныеАвансы",				ЭтоПолученныеАвансы);
	
	Параметры.Вставить("ИсключаемыеТипыРегистратора_Зачеты",	ИсключаемыеТипыРегистратора_Зачеты);
	Параметры.Вставить("ИсключаемыеТипыРегистратора_Учтенные",	ИсключаемыеТипыРегистратора_Учтенные);
	
	ДатаПерехода64н = УчетНДС.ПолучитьДатуНачалаПрименения64н(Организация);
	
	Параметры.Вставить("ДатаПерехода64н",					ДатаПерехода64н);
	
	Параметры.Вставить("ДатаОкончанияИгнорированияДокументовРасчетов", ПолучитьДатуОкончанияИгнорированияДокументовРасчетов(Организация));
	
	Если ЭтоПолученныеАвансы Тогда
		// Авансы полученные
		
		СтруктураСчетовАвансов = УчетНДС.ПолучитьТаблицуСчетовАвансовПолученных();
		
		НаДату = Неопределено;
		Параметры.Вставить("СчетАП",						БухгалтерскийУчет.СчетПоКоду("АП", НаДату));
		
		Параметры.Вставить("СчетАК",						БухгалтерскийУчет.СчетПоКоду("АК", НаДату));
		
		// Для возврата авансов полученных
		Параметры.Вставить("СчетаДенежныхСредств",			БухгалтерскийУчет.СписокСчетов("201.10,201.20,201.30",,Истина));
		
		
		АнализироватьСчета205хА = ?(ЗначениеЗаполнено(ДатаНачала),
			ДатаНачала <= ДатаПерехода64н,
			Истина);
		
		Параметры.Вставить("АнализироватьСчета205хА",		АнализироватьСчета205хА);
		
		СчетаРасчетов = КлассифицироватьСчетаРасчетовАвансаПолученного(МассивСчетРасчетов, СтруктураСчетовАвансов);
		
		Параметры.Вставить("МассивСчетРасчетовТолько205хА",		СчетаРасчетов["Только205хА"]);
		Параметры.Вставить("МассивСчетРасчетовКроме205хА",		СчетаРасчетов["Кроме205хА"]);
		
		СтруктураСчетовАвансов.Вставить("СчетаРасчетовДляПоискаКЭК", БухгалтерскийУчет.СписокСчетов("205.00", Дата));
		
	Иначе
		// Авансы выданные
		
		Параметры.Вставить("МассивСчетРасчетовКроме205хА",	Новый Массив()); // требуется для ПолучитьТаблицуУжеУчтенныхСуммАвансов
		
		СтруктураСчетовАвансов = УчетНДС.ПолучитьТаблицуСчетовАвансовВыданных();
		
		Параметры.Вставить("СтруктураСчетовАвансов",		СтруктураСчетовАвансов);
		
	КонецЕсли;
	
	Параметры.Вставить("СтруктураСчетовАвансов",			СтруктураСчетовАвансов);
	
	// Заменять устаревшие счета 205.хА в зачетах и возвратах авансов полученных
	// необходимо в том случае, если документ ФЗКПокупок заполняется после перехода на 64н,
	// т.е. если остатки были перенесены на новые счета.
	//
	// Если переход на 64н еще не выполнялся, то заменять счета в зачетах и возвратах не нужно.
	
	ШаблонЗаменыСчетов = ПолучитьШаблонЗаменыСчетов64н(СтруктураСчетовАвансов["МассивСчетов"]);
	
	Если ЗначениеЗаполнено(Дата) Тогда
		ПроверяемаяДатаДокумента = Дата;
	Иначе
		ПроверяемаяДатаДокумента = ТекущаяДатаСеанса();
	КонецЕсли;
	
	ТребуетсяЗаменитьУстаревшиеСчета = ЭтоПолученныеАвансы И (ПроверяемаяДатаДокумента >= ДатаПерехода64н);
		
	Если НЕ ТребуетсяЗаменитьУстаревшиеСчета Тогда
		ШаблонЗаменыСчетов.Очистить();
	КонецЕсли;
	
	Параметры.Вставить("ШаблонЗаменыСчетов",				ШаблонЗаменыСчетов);
	
	Параметры.Вставить("АвансыКомиссионера",				АвансыКомиссионера);
	
	Если ТипЗнч(СписокДокументовЗачетаАванса) <> Тип("Массив") Тогда
		СписокДокументовЗачетаАванса = Новый Массив();
	КонецЕсли;
	Параметры.Вставить("СписокДокументовЗачетаАванса",		СписокДокументовЗачетаАванса);
	
	Возврат Параметры;
	
КонецФункции

Функция ПолучитьШаблонЗаменыСчетов64н(СчетаИсточники)
	
	// Берем типовой шаблон замены устаревших счетов 205.00
	// из документа ПереносОстатков64нРасчеты
	//
	// Оставляем в шаблоне лишь правила замены указанных счетов
	
	ТаблицаШаблон = Документы.ПереносОстатков64нРасчеты.ШаблонЗаменыСчетовиКОСГУ();
	
	ИменаКолонок = "КФО,СчетИсточник,СчетПриемник";
	
	ТаблицаШаблон = ТаблицаШаблон.Скопировать(, ИменаКолонок);
	
	КоличествоСтрок = ТаблицаШаблон.Количество();
	
	Для НомерСтроки = 1 По КоличествоСтрок Цикл
		
		ИндексСтроки = КоличествоСтрок - НомерСтроки;
		
		СтрокаТаблицы = ТаблицаШаблон[ИндексСтроки];
		
		УказанПодходящийСчет = (СчетаИсточники.Найти(СтрокаТаблицы["СчетИсточник"]) <> Неопределено);
		
		Если НЕ УказанПодходящийСчет Тогда
			ТаблицаШаблон.Удалить(ИндексСтроки);
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаШаблон.Свернуть(ИменаКолонок);
	
	ТаблицаШаблон.Колонки["СчетИсточник"].Имя = "СчетРасчетов";
	
	Возврат ТаблицаШаблон;
	
КонецФункции

Функция КлассифицироватьСчетаРасчетовАвансаПолученного(МассивСчетРасчетов, СтруктураСчетовАвансов)
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивСчетРасчетов",	МассивСчетРасчетов);
	ЗапросПоиск.УстановитьПараметр("Счета205хА",			СтруктураСчетовАвансов["МассивСчетов"]);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Только счета 205.хА
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ссылка	КАК Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ
	|ГДЕ
	|	Ссылка В(&МассивСчетРасчетов)
	|	И	Ссылка В(&Счета205хА)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Кроме счетов 205.хА
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ссылка	КАК Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ
	|ГДЕ
	|	Ссылка В(&МассивСчетРасчетов)
	|	И	НЕ Ссылка В(&Счета205хА)
	|;";
	
	РезультатыПоиска = ЗапросПоиск.ВыполнитьПакет();
	
	СчетаРасчетов = Новый Структура();
	
	// [0]. Только счета 205.хА
	СчетаРасчетов.Вставить("Только205хА", РезультатыПоиска[0].Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
	// [1]. Кроме счетов 205.хА
	СчетаРасчетов.Вставить("Кроме205хА", РезультатыПоиска[1].Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
	Возврат СчетаРасчетов;
	
КонецФункции

Процедура ЗаполнитьСуммыНДС(ТаблицаАвансов)
	
	ИменаКолонокСвязи = "Контрагент,Договор,СчетРасчетов,КПССчетРасчетов,ДокументРасчетов,ИндексСтроки1";
	
	ТаблицаНакопленныеСуммы = ТаблицаАвансов.СкопироватьКолонки(ИменаКолонокСвязи);
	
	ТипЧисло = Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,2));
	
	ТаблицаНакопленныеСуммы.Колонки.Добавить("СуммаНДС",			ТипЧисло);
	ТаблицаНакопленныеСуммы.Колонки.Добавить("СуммаНДСВалютная",	ТипЧисло);
	
	Поиск = Новый Структура(ИменаКолонокСвязи);
	
	МножителиВсехСтавок = ПолучитьМножителиВсехСтавок();
	
	КоличествоСтрок = ТаблицаАвансов.Количество();
	
	Для НомерСтроки = 1 По КоличествоСтрок Цикл
		СтрокаТаблицы = ТаблицаАвансов[НомерСтроки - 1];
		
		ПредыдущаяСтрокаТаблицы = ?(НомерСтроки = 1, Неопределено, ТаблицаАвансов[НомерСтроки - 2]);
		
		ЭтоНовыйАванс = ?(ПредыдущаяСтрокаТаблицы = Неопределено,
			Истина,
			ПредыдущаяСтрокаТаблицы["ИндексСтроки1"] <> СтрокаТаблицы["ИндексСтроки1"]);
			
		Если ЭтоНовыйАванс Тогда
			
			ЗаполнитьЗначенияСвойств(Поиск, СтрокаТаблицы);
			
			МассивСтрок = ТаблицаНакопленныеСуммы.НайтиСтроки(Поиск);
			
			Если МассивСтрок.Количество() = 0 Тогда
				НакопленныеСуммы = ТаблицаНакопленныеСуммы.Добавить();
				
				ЗаполнитьЗначенияСвойств(НакопленныеСуммы, СтрокаТаблицы, ИменаКолонокСвязи);
			Иначе
				НакопленныеСуммы = МассивСтрок[0];
			КонецЕсли;
			
		КонецЕсли;
		
		ИспользуютсяВалютныеСуммы = (СтрокаТаблицы["ВсегоВалютная"] <> 0);
		
		Если НЕ ИспользуютсяВалютныеСуммы Тогда
			СтрокаТаблицы["ВсегоВалютная"]			= 0;
			СтрокаТаблицы["СуммаНДСВалютная"]		= 0;
			СтрокаТаблицы["СуммаБезНДСВалютная"]	= 0;
		КонецЕсли;
		
		Если ИспользуютсяВалютныеСуммы Тогда
			ЭтоПоследняяСтрокаОстаткаАванса = СтрокаТаблицы["ВсегоВалютная_СписаноПолностьюВТаблице1"];
		Иначе
			ЭтоПоследняяСтрокаОстаткаАванса = СтрокаТаблицы["Всего_СписаноПолностьюВТаблице1"];
		КонецЕсли;
		
		Если ЭтоПоследняяСтрокаОстаткаАванса Тогда
			// В этой строке суммы пересчитываем как
			// <ОбщаяСумма> - <ПоказателиПредыдущихСтрок>
			
			СуммаНДС			= СтрокаТаблицы["СуммаНДС"]			- НакопленныеСуммы["СуммаНДС"];
			СуммаНДСВалютная	= СтрокаТаблицы["СуммаНДСВалютная"]	- НакопленныеСуммы["СуммаНДСВалютная"];
			
		Иначе
			// В этой строке суммы пересчитываем как
			// <База> * <Множитель>
			
			Множитель = МножителиВсехСтавок.Получить(СтрокаТаблицы.СтавкаНДС);
			
			СуммаНДСВалютная = Окр(СтрокаТаблицы["ВсегоВалютная"] * Множитель, 2);
			
			Если ИспользуютсяВалютныеСуммы Тогда
				
				ПрименяемыйКурс	= СтрокаТаблицы["Всего"] / СтрокаТаблицы["ВсегоВалютная"];
				
				СуммаНДС = Окр(СуммаНДСВалютная * ПрименяемыйКурс, 2);
				
			Иначе
				
				СуммаНДС = Окр(СтрокаТаблицы["Всего"] * Множитель, 2);
				
			КонецЕсли;
			
		КонецЕсли;
		
		СтрокаТаблицы["СуммаНДС"]				= СуммаНДС;
		СтрокаТаблицы["СуммаНДСВалютная"]		= СуммаНДСВалютная;
		
		СтрокаТаблицы["СуммаБезНДС"]			= СтрокаТаблицы["Всего"]			- СуммаНДС;
		СтрокаТаблицы["СуммаБезНДСВалютная"]	= СтрокаТаблицы["ВсегоВалютная"]	- СуммаНДСВалютная;
		
		НакопленныеСуммы["СуммаНДС"]			= НакопленныеСуммы["СуммаНДС"]			+ СуммаНДС;
		НакопленныеСуммы["СуммаНДСВалютная"]	= НакопленныеСуммы["СуммаНДСВалютная"]	+ СуммаНДСВалютная;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьМножителиВсехСтавок()
	
	// Множители получаем как для расчетных ставок.
	
	МножителиВсехСтавок = Новый Соответствие();
	
	Для Каждого Ставка Из Перечисления.СтавкиНДС Цикл
		МножителиВсехСтавок.Вставить(Ставка, УчетНДСКлиентСервер.ПолучитьМножительСтавки(Ставка, Истина));
	КонецЦикла;
	
	Ставка = Перечисления.СтавкиНДС.ПустаяСсылка();
	
	МножителиВсехСтавок.Вставить(Ставка, УчетНДСКлиентСервер.ПолучитьМножительСтавки(Ставка, Истина));
	
	Возврат МножителиВсехСтавок;
	
КонецФункции

Функция ПолучитьТаблицуЗачетаАвансов(Знач Параметры, ТаблицаЗачетаАвансовПоРегистраторам)
	
	Если Параметры["ЭтоПолученныеАвансы"] Тогда
		// Авансы полученные
		
		Если Параметры["АвансыКомиссионера"] Тогда
			ТаблицаЗачетаАвансов = ПолучитьТаблицуЗачетаАвансовПолученных_АК(Параметры);
		Иначе
			ТаблицаЗачетаАвансов = ПолучитьТаблицуЗачетаАвансовПолученных_АП(Параметры, ТаблицаЗачетаАвансовПоРегистраторам);
		КонецЕсли;
		
		Если Параметры["АнализироватьСчета205хА"] Тогда
			
			ТаблицаЗачетаАвансов205хА = ПолучитьТаблицуЗачетаАвансов_205хА_206(Параметры);
			
			Для Каждого СтрокаТаблицы Из ТаблицаЗачетаАвансов205хА Цикл
				
				НоваяСтрока = ТаблицаЗачетаАвансов.Добавить();
				
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
				
			КонецЦикла;
			
			ТаблицаЗачетаАвансов.Сортировать("ДатаЗачета");
			
		КонецЕсли;
		
	Иначе
		// Авансы выданные
		
		ТаблицаЗачетаАвансов = ПолучитьТаблицуЗачетаАвансов_205хА_206(Параметры);
		
	КонецЕсли;
	
	ОтсутствуетКолонкаДокументРасчетов = (ТаблицаЗачетаАвансов.Колонки.Найти("ДокументРасчетов") = Неопределено);
	
	Если ОтсутствуетКолонкаДокументРасчетов Тогда
		
		ТаблицаЗачетаАвансов.Колонки.Добавить("ДокументРасчетов");
		
	КонецЕсли;
	
	Возврат ТаблицаЗачетаАвансов;
	
КонецФункции

Функция ПолучитьТаблицуЗачетаАвансов_205хА_206(Параметры)
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ДатаНачала",						Параметры.ДатаНачала);
	ЗапросПоиск.УстановитьПараметр("ДатаОкончания",						Параметры.ДатаОкончания);
	ЗапросПоиск.УстановитьПараметр("Организация",						Параметры.Организация);
	ЗапросПоиск.УстановитьПараметр("ДокументСсылка",					Параметры.ДокументСсылка);
	ЗапросПоиск.УстановитьПараметр("МассивДоговоров",					Параметры.МассивДоговоров);
	ЗапросПоиск.УстановитьПараметр("МассивКонтрагентов",				Параметры.МассивКонтрагентов);
	ЗапросПоиск.УстановитьПараметр("МассивКФО",							Параметры.МассивКФО);
	ЗапросПоиск.УстановитьПараметр("МассивКПС",							Параметры.МассивКПС);
	ЗапросПоиск.УстановитьПараметр("ЗаполнитьВалютныеСуммы",			Параметры.ЗаполнитьВалютныеСуммы);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",	Параметры.ИспользоватьУчетПоПодразделениям);
	ЗапросПоиск.УстановитьПараметр("ВидыСубконто",						Параметры.ВидыСубконто);
	ЗапросПоиск.УстановитьПараметр("ТаблицаСчетаАвансов",				Параметры.СтруктураСчетовАвансов["ТаблицаСчетов"]);
	ЗапросПоиск.УстановитьПараметр("МассивСчетовАванса",				Параметры.СтруктураСчетовАвансов["МассивСчетов"]);
	
	ЗапросПоиск.УстановитьПараметр("ИсключаемыеТипыРегистратора",		Параметры.ИсключаемыеТипыРегистратора_Зачеты);
	ЗапросПоиск.УстановитьПараметр("ШаблонЗаменыСчетов",				Параметры.ШаблонЗаменыСчетов);
	ТекстШаблон = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Шаблон замены счетов (некоторая часть макета из ПереносОстатков64нРасчеты)
	|//
	|ВЫБРАТЬ
	|	ТЗ.КФО				КАК КФО,
	|	ТЗ.СчетРасчетов		КАК СчетРасчетов,
	|	ТЗ.СчетПриемник		КАК СчетПриемник
	|ПОМЕСТИТЬ
	|	ШаблонЗаменыСчетов
	|ИЗ
	|	&ШаблонЗаменыСчетов	КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Соответствие счетов (авансы - расчеты)
	|//
	|ВЫБРАТЬ
	|	ТЗ.СчетАванса,
	|	ТЗ.СчетРасчетов
	|ПОМЕСТИТЬ
	|	ТаблицаСчетаАвансов
	|ИЗ
	|	&ТаблицаСчетаАвансов	КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Зачеты авансов, по дням
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕПСБУОбороты.Период												КАК ДатаЗачета,
	|	ЕПСБУОбороты.Субконто1											КАК Контрагент,
	|	ЕПСБУОбороты.Субконто2											КАК Договор,
	|	ЕПСБУОбороты.КФО												КАК КФО,
	|	
	|	ЕСТЬNULL(ШаблонЗаменыСчетов.СчетПриемник, ЕПСБУОбороты.Счет)	КАК СчетРасчетов,
	|	ЕПСБУОбороты.КПС												КАК КПССчетРасчетов,
	|	СУММА(ЕПСБУОбороты.[РеквизитОборотов])								КАК Всего,
	|	СУММА(ВЫБОР
	|		КОГДА &ЗаполнитьВалютныеСуммы ТОГДА
	|			ЕПСБУОбороты.[РеквизитОборотовВалютный]
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ)															КАК ВсегоВалютная
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|		&ДатаНачала,							// 1
	|		&ДатаОкончания,							// 2
	|		Регистратор,							// 3
	|		Счет В (&МассивСчетовАванса),			// 4
	|		&ВидыСубконто,							// 5
	|		Организация = &Организация				// 6
	|		И	Субконто1 В (&МассивКонтрагентов)
	|		И	Субконто2 В (&МассивДоговоров)
	|		И	КПС В (&МассивКПС)
	|		И	КФО В (&МассивКФО),
	|		, 										// 7
	|		&ВидыСубконто							// 8
	|	)	КАК ЕПСБУОбороты
	|	ЛЕВОЕ СОЕДИНЕНИЕ	ШаблонЗаменыСчетов
	|		ПО	ЕПСБУОбороты.Счет = ШаблонЗаменыСчетов.СчетРасчетов
	|		И	(ЕПСБУОбороты.КФО = ШаблонЗаменыСчетов.КФО
	|			ИЛИ ШаблонЗаменыСчетов.КФО = ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка))
	|ГДЕ
	|	[РеквизитОборотов] > 0
	|	И КорСчет В(
	|		ВЫБРАТЬ
	|			СчетРасчетов
	|		ИЗ
	|			ТаблицаСчетаАвансов
	|		ГДЕ
	|			СчетАванса = ЕПСБУОбороты.Счет
	|	)
	|	И КПС = КПСКор
	|	И ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям
	|			И НЕ (Подразделение ЕСТЬ NULL И ПодразделениеКор ЕСТЬ NULL) ТОГДА
	|			Подразделение = ПодразделениеКор
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ
	|	И Субконто1 = КорСубконто1
	|	И Субконто2 = КорСубконто2
	|	И НЕ ТИПЗНАЧЕНИЯ(Регистратор) В (&ИсключаемыеТипыРегистратора)
	|СГРУППИРОВАТЬ ПО
	|	ЕПСБУОбороты.Период,
	|	ЕПСБУОбороты.Субконто1,
	|	ЕПСБУОбороты.Субконто2,
	|	ЕПСБУОбороты.КФО,
	|	ЕСТЬNULL(ШаблонЗаменыСчетов.СчетПриемник, ЕПСБУОбороты.Счет),
	|	ЕПСБУОбороты.КПС
	|УПОРЯДОЧИТЬ ПО
	|	ДатаЗачета
	|;";
	
	ВставляемыеЗначения = Новый Структура();
	ВставляемыеЗначения.Вставить("РеквизитОборотов",			Параметры.РеквизитОборотов);
	ВставляемыеЗначения.Вставить("РеквизитОборотовВалютный",	Параметры.РеквизитОборотовВалютный);
	
	ЗапросПоиск.Текст = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ТекстШаблон, ВставляемыеЗначения);
	
	Возврат ЗапросПоиск.Выполнить().Выгрузить();
	
КонецФункции

Функция ПолучитьТаблицуЗачетаАвансовПолученных_АП(Знач Параметры, ТаблицаЗачетаАвансовПоРегистраторам)
	
	ЗапросАвансы = Новый Запрос();
	ЗапросАвансы.УстановитьПараметр("ДатаНачала",				Параметры.ДатаНачала);
	ЗапросАвансы.УстановитьПараметр("ДатаОкончания",			Параметры.ДатаОкончания);
	ЗапросАвансы.УстановитьПараметр("Организация",				Параметры.Организация);
	ЗапросАвансы.УстановитьПараметр("ДокументСсылка",			Параметры.ДокументСсылка);
	ЗапросАвансы.УстановитьПараметр("МассивДоговоров",			Параметры.МассивДоговоров);
	ЗапросАвансы.УстановитьПараметр("МассивКонтрагентов",		Параметры.МассивКонтрагентов);
	ЗапросАвансы.УстановитьПараметр("МассивКФО",				Параметры.МассивКФО);
	ЗапросАвансы.УстановитьПараметр("МассивКПС",				Параметры.МассивКПС);
	ЗапросАвансы.УстановитьПараметр("ЗаполнитьВалютныеСуммы",	Параметры.ЗаполнитьВалютныеСуммы);
	ЗапросАвансы.УстановитьПараметр("СчетАП",					Параметры.СчетАП);
	
	ЗапросАвансы.УстановитьПараметр("ИсключаемыеТипыРегистратора", Параметры.ИсключаемыеТипыРегистратора_Зачеты);
	
	ЗапросАвансы.УстановитьПараметр("СчетаРасчетовДляПоискаКЭК",Параметры.СтруктураСчетовАвансов.СчетаРасчетовДляПоискаКЭК);
	
	ИспользоватьОтборПоСпискуДокументовЗачетаАванса = (Параметры.СписокДокументовЗачетаАванса.Количество() > 0);
	ЗапросАвансы.УстановитьПараметр("ИспользоватьОтборПоСпискуДокументовЗачетаАванса", ИспользоватьОтборПоСпискуДокументовЗачетаАванса);
	ЗапросАвансы.УстановитьПараметр("СписокДокументовЗачетаАванса", Параметры.СписокДокументовЗачетаАванса);
	
	ЗапросАвансы.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Зачеты авансов по дням по регистраторам. Вместо счета выбран КЭК.
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Регистратор																	КАК Регистратор,
	|	НАЧАЛОПЕРИОДА(Период, ДЕНЬ)													КАК ДатаЗачета,
	|	ВЫРАЗИТЬ(СубконтоДт1 КАК Справочник.Контрагенты)							КАК Контрагент,
	|	ВЫРАЗИТЬ(СубконтоДт2 КАК Справочник.Договоры)								КАК Договор,
	|	ЕСТЬNULL(СубконтоДт3, НЕОПРЕДЕЛЕНО)											КАК ДокументРасчетов,
	|	КЭКДт																		КАК КЭК,
	|	КПСДт																		КАК КПССчетРасчетов,
	|	ЕСТЬNULL(ПодразделениеДт, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))	КАК Подразделение,
	|	СУММА(Сумма)																КАК Всего,
	|	СУММА(ВЫБОР
	|		КОГДА &ЗаполнитьВалютныеСуммы ТОГДА
	|			ЕСТЬNULL(ВалютнаяСуммаДт, 0)
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ)																		КАК ВсегоВалютная
	|ПОМЕСТИТЬ
	|	ЗачетыАвансовАППоРегистраторам
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|		&ДатаНачала,		// 1
	|		&ДатаОкончания,		// 2
	|		СчетДт = &СчетАП	// 3
	|		И	Сумма > 0
	|		И	ХарактеристикаДвиженияДт <> ЗНАЧЕНИЕ(Перечисление.СобытияНДС.ВозвратАвансаПолученного)
	|		И	Организация = &Организация
	|		И	СубконтоДт1 В (&МассивКонтрагентов)
	|		И	СубконтоДт2 В (&МассивДоговоров)
	|		И	КПСДт В (&МассивКПС)
	|		И	КФО В (&МассивКФО)
	|		И	НЕ ТИПЗНАЧЕНИЯ(Регистратор) В(&ИсключаемыеТипыРегистратора)
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоСпискуДокументовЗачетаАванса ТОГДА
	|				Регистратор В(&СписокДокументовЗачетаАванса)
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|	)	КАК ДвиженияССубконто
	|СГРУППИРОВАТЬ ПО
	|	Регистратор,
	|	НАЧАЛОПЕРИОДА(Период, ДЕНЬ),
	|	ВЫРАЗИТЬ(СубконтоДт1 КАК Справочник.Контрагенты),
	|	ВЫРАЗИТЬ(СубконтоДт2 КАК Справочник.Договоры),
	|	ЕСТЬNULL(СубконтоДт3, НЕОПРЕДЕЛЕНО),
	|	КЭКДт,
	|	КПСДт,
	|	ЕСТЬNULL(ПодразделениеДт, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Все счета расчетов, соответствующие обнаруженным КЭК (счет АП)
	|//		
	|ВЫБРАТЬ
	|	ДатыСобытийАП.Дата												КАК Период,
	|	ДатыСобытийАП.КЭК												КАК КЭК,
	|	СоответствияАналитическихСчетовКЭК.Счет							КАК Счет,
	|	СоответствияАналитическихСчетовКЭК.Счет.ДатаНачалаДействия		КАК ДатаНачалаДействия
	|ПОМЕСТИТЬ
	|	ВсеСчетаРасчетовАП
	|ИЗ
	|	РегистрСведений.СоответствияАналитическихСчетовКЭК	КАК СоответствияАналитическихСчетовКЭК
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|			(ВЫБРАТЬ
	|				КЭК			КАК КЭК,
	|				ДатаЗачета	КАК Дата
	|			ИЗ
	|				ЗачетыАвансовАППоРегистраторам
	|			ГДЕ
	|				КЭК <> ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)
	|			)	КАК	ДатыСобытийАП
	|		ПО	СоответствияАналитическихСчетовКЭК.КЭК = ДатыСобытийАП.КЭК
	|		И	СоответствияАналитическихСчетовКЭК.Счет.ДатаНачалаДействия <= ДатыСобытийАП.Дата
	|		И	(СоответствияАналитическихСчетовКЭК.Счет.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ ДатыСобытийАП.Дата <= СоответствияАналитическихСчетовКЭК.Счет.ДатаОкончанияДействия)
	|		И	СоответствияАналитическихСчетовКЭК.Счет В(&СчетаРасчетовДляПоискаКЭК)
	|ИНДЕКСИРОВАТЬ ПО
	|	КЭК,
	|	ДатаНачалаДействия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Выбираемые даты счетов расчетов (счет АП)
	|//		
	|ВЫБРАТЬ
	|	Период							КАК Период,
	|	КЭК								КАК КЭК,
	|	МАКСИМУМ(ДатаНачалаДействия)	КАК ДатаНачалаДействия
	|ПОМЕСТИТЬ
	|	ВыбираемыеДатыСчетовРасчетовАП
	|ИЗ
	|	ВсеСчетаРасчетовАП
	|СГРУППИРОВАТЬ ПО
	|	Период,
	|	КЭК
	|ИНДЕКСИРОВАТЬ ПО
	|	КЭК,
	|	ДатаНачалаДействия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Выбираемые счета расчетов, соответствующие обнаруженным КЭК (счет АП)
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВсеСчетаРасчетовАП.Период			КАК Период,
	|	ВсеСчетаРасчетовАП.КЭК				КАК КЭК,
	|	МАКСИМУМ(ВсеСчетаРасчетовАП.Счет)	КАК Счет
	|ПОМЕСТИТЬ
	|	СчетаРасчетовАП
	|ИЗ
	|	ВсеСчетаРасчетовАП
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	ВыбираемыеДатыСчетовРасчетовАП
	|		ПО	ВсеСчетаРасчетовАП.КЭК = ВыбираемыеДатыСчетовРасчетовАП.КЭК
	|		И	ВсеСчетаРасчетовАП.ДатаНачалаДействия = ВыбираемыеДатыСчетовРасчетовАП.ДатаНачалаДействия
	|СГРУППИРОВАТЬ ПО
	|	ВсеСчетаРасчетовАП.Период,
	|	ВсеСчетаРасчетовАП.КЭК
	|ИНДЕКСИРОВАТЬ ПО
	|	КЭК,
	|	Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [4]. Зачеты авансов по дням по регистраторам. КЭК заменен на счет расчетов, действующий на дату зачета
	|//
	|ВЫБРАТЬ
	|	ЗачетыАвансовАППоРегистраторам.Регистратор								КАК Регистратор,
	|	ЗачетыАвансовАППоРегистраторам.ДатаЗачета								КАК ДатаЗачета,
	|	ЗачетыАвансовАППоРегистраторам.Контрагент								КАК Контрагент,
	|	ЗачетыАвансовАППоРегистраторам.Договор									КАК Договор,
	|	ЗачетыАвансовАППоРегистраторам.ДокументРасчетов							КАК ДокументРасчетов,
	|	ЕСТЬNULL(СчетаРасчетовАП.Счет, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка))	КАК СчетРасчетов,
	|	ЗачетыАвансовАППоРегистраторам.КПССчетРасчетов							КАК КПССчетРасчетов,
	|	ВЫБОР
	|		КОГДА СчетаРасчетовАП.Счет ЕСТЬ NULL ТОГДА
	|			ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|		КОГДА СчетаРасчетовАП.Счет.УчетПоПодразделениям ТОГДА
	|			Подразделение
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ																	КАК Подразделение,
	|	ЗачетыАвансовАППоРегистраторам.Всего									КАК Всего,
	|	ЗачетыАвансовАППоРегистраторам.ВсегоВалютная							КАК ВсегоВалютная
	|ИЗ
	|	ЗачетыАвансовАППоРегистраторам
	|	ЛЕВОЕ СОЕДИНЕНИЕ	СчетаРасчетовАП
	|		ПО	ЗачетыАвансовАППоРегистраторам.КЭК = СчетаРасчетовАП.КЭК
	|		И	ЗачетыАвансовАППоРегистраторам.ДатаЗачета = СчетаРасчетовАП.Период
	|УПОРЯДОЧИТЬ ПО
	|	ДатаЗачета";
	
	// Все колонки, кроме Регистратор.
	КолонкиГруппировок = "ДатаЗачета,Контрагент,Договор,ДокументРасчетов,СчетРасчетов,КПССчетРасчетов,Подразделение";
	КолонкиСуммирования = "Всего,ВсегоВалютная";
	
	ТаблицаЗачетаАвансовПоРегистраторам = ЗапросАвансы.Выполнить().Выгрузить();
	
	ТаблицаЗачетаАвансовБезРегистраторов = ТаблицаЗачетаАвансовПоРегистраторам.Скопировать(, КолонкиГруппировок + "," + КолонкиСуммирования);
	ТаблицаЗачетаАвансовБезРегистраторов.Свернуть(КолонкиГруппировок, КолонкиСуммирования);
	ТаблицаЗачетаАвансовБезРегистраторов.Сортировать("ДатаЗачета");
	
	Возврат ТаблицаЗачетаАвансовБезРегистраторов;
	
КонецФункции

Функция ПолучитьТаблицуУжеУчтенныхСуммАвансов(Параметры)
	
	Если Параметры.ЭтоПолученныеАвансы И Параметры.АнализироватьСчета205хА Тогда
		// Необходимо расширить отбор по счетам, добавить в него все счета 205.хА
		
		МассивСчетРасчетов = Новый Массив();
		
		Для Каждого Счет Из Параметры.МассивСчетРасчетов Цикл
			МассивСчетРасчетов.Добавить(Счет);
		КонецЦикла;
		
		Для Каждого Счет Из Параметры.СтруктураСчетовАвансов.МассивСчетов Цикл
			МассивСчетРасчетов.Добавить(Счет);
		КонецЦикла;
	Иначе
		// Не требуется расширять отбор по счетам
		
		МассивСчетРасчетов = Параметры.МассивСчетРасчетов;
	КонецЕсли;
	
	ЗапросПоиск = Новый Запрос();
	
	ЗапросПоиск.УстановитьПараметр("ДатаНачала",				Параметры.ДатаНачала);
	ЗапросПоиск.УстановитьПараметр("ДатаОкончания",				Параметры.ДатаОкончания);
	ЗапросПоиск.УстановитьПараметр("Организация",				Параметры.Организация);
	ЗапросПоиск.УстановитьПараметр("ДокументСсылка",			Параметры.ДокументСсылка);
	ЗапросПоиск.УстановитьПараметр("МассивДоговоров",			Параметры.МассивДоговоров);
	ЗапросПоиск.УстановитьПараметр("МассивКонтрагентов",		Параметры.МассивКонтрагентов);
	ЗапросПоиск.УстановитьПараметр("МассивСчетРасчетов",		МассивСчетРасчетов);
	ЗапросПоиск.УстановитьПараметр("МассивКФО",					Параметры.МассивКФО);
	ЗапросПоиск.УстановитьПараметр("МассивКПС",					Параметры.МассивКПС);
	ЗапросПоиск.УстановитьПараметр("ЗаполнитьВалютныеСуммы",	Параметры.ЗаполнитьВалютныеСуммы);
	ЗапросПоиск.УстановитьПараметр("ЭтоПолученныеАвансы",		Параметры.ЭтоПолученныеАвансы);
	
	ЗапросПоиск.УстановитьПараметр("ДатаОкончанияИгнорированияДокументовРасчетов", Параметры.ДатаОкончанияИгнорированияДокументовРасчетов);
	
	ЗапросПоиск.УстановитьПараметр("ПустаяДата",				'00010101');
	ЗапросПоиск.УстановитьПараметр("Счета205хА",				Параметры.СтруктураСчетовАвансов.МассивСчетов);
	
	ЗапросПоиск.УстановитьПараметр("ИсключаемыеТипыРегистратора", Параметры.ИсключаемыеТипыРегистратора_Учтенные);
	ЗапросПоиск.УстановитьПараметр("ШаблонЗаменыСчетов",		Параметры.ШаблонЗаменыСчетов);
	
	ТекстШаблон = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Шаблон замены счетов (некоторая часть макета из ПереносОстатков64нРасчеты)
	|//
	|ВЫБРАТЬ
	|	ТЗ.КФО				КАК КФО,
	|	ТЗ.СчетРасчетов		КАК СчетРасчетов,
	|	ТЗ.СчетПриемник		КАК СчетПриемник
	|ПОМЕСТИТЬ
	|	ШаблонЗаменыСчетов
	|ИЗ
	|	&ШаблонЗаменыСчетов	КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Уже учтенные суммы с авансов
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Период										КАК Период,
	|	Контрагент									КАК Контрагент,
	|	Договор										КАК Договор,
	|	СчетРасчетов								КАК СчетРасчетов,
	|	КПССчетРасчетов								КАК КПССчетРасчетов,
	|	ДокументРасчетов							КАК ДокументРасчетов,
	|	ВозможноПотребуетсяОчисткаДокументаРасчетов	КАК ВозможноПотребуетсяОчисткаДокументаРасчетов,
	|	СУММА(Всего)								КАК Всего,
	|	СУММА(ВсегоВалютная)						КАК ВсегоВалютная
	|ИЗ
	|	(ВЫБРАТЬ
	|		НАЧАЛОПЕРИОДА(Период, ДЕНЬ)							КАК Период,
	|		СчетФактура.Контрагент								КАК Контрагент,
	|		СчетФактура.Договор									КАК Договор,
	|		РНОбороты.КФО										КАК КФО,
	|		ВЫБОР
	|			КОГДА &ЭтоПолученныеАвансы И РНОбороты.СчетРасчетов В(&Счета205хА) ТОГДА
	|				ЕСТЬNULL(ШаблонЗаменыСчетов.СчетПриемник, РНОбороты.СчетРасчетов)
	|			ИНАЧЕ
	|				РНОбороты.СчетРасчетов
	|		КОНЕЦ												КАК СчетРасчетов,
	|		КПССчетРасчетов										КАК КПССчетРасчетов,
	|		ВЫБОР
	|			КОГДА &ЭтоПолученныеАвансы И РНОбороты.СчетРасчетов В(&Счета205хА) ТОГДА
	|				НЕОПРЕДЕЛЕНО
	|			КОГДА &ЭтоПолученныеАвансы ТОГДА
	|				РНОбороты.ОбъектНалогообложения
	|			ИНАЧЕ
	|				НЕОПРЕДЕЛЕНО
	|		КОНЕЦ												КАК ДокументРасчетов,
	|		(&ЭтоПолученныеАвансы И ЕСТЬNULL(РНОбороты.ОбъектНалогообложения.Дата, &ПустаяДата) <
	|			&ДатаОкончанияИгнорированияДокументовРасчетов)	КАК ВозможноПотребуетсяОчисткаДокументаРасчетов,
	|		СуммаБезНДСРасход + СуммаНДСРасход					КАК Всего,
	|		ВЫБОР
	|			КОГДА &ЗаполнитьВалютныеСуммы ТОГДА
	|				СуммаБезНДСВалютнаяРасход + СуммаНДСВалютнаяРасход
	|			ИНАЧЕ
	|				0
	|		КОНЕЦ												КАК ВсегоВалютная
	|	ИЗ
	|		РегистрНакопления.ВходящийНДС.Обороты(
	|			&ДатаНачала,				// 1
	|			&ДатаОкончания,				// 2
	|			Регистратор,				// 3
	|			Организация = &Организация	// 4
	|			И	СчетФактура.Контрагент В (&МассивКонтрагентов)
	|			И	СчетФактура.Договор В (&МассивДоговоров)
	|			И	СчетРасчетов В (&МассивСчетРасчетов)
	|			И	КПССчетРасчетов В (&МассивКПС)
	|			И	КФО В (&МассивКФО)
	|		)	КАК РНОбороты
	|		ЛЕВОЕ СОЕДИНЕНИЕ	ШаблонЗаменыСчетов
	|			ПО	РНОбороты.СчетРасчетов = ШаблонЗаменыСчетов.СчетРасчетов
	|			И	(РНОбороты.КФО = ШаблонЗаменыСчетов.КФО
	|				ИЛИ ШаблонЗаменыСчетов.КФО = ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка))
	|	ГДЕ	
	|		// Исключаем возможные движения самого документа:
	|		НЕ Регистратор = &ДокументСсылка
	|		И НЕ ТИПЗНАЧЕНИЯ(Регистратор) В(&ИсключаемыеТипыРегистратора)
	|	)	КАК Обороты
	|СГРУППИРОВАТЬ ПО
	|	Период,
	|	Контрагент,
	|	Договор,
	|	СчетРасчетов,
	|	КПССчетРасчетов,
	|	ДокументРасчетов,
	|	ВозможноПотребуетсяОчисткаДокументаРасчетов
	|УПОРЯДОЧИТЬ ПО
	|	Период
	|;";
	
	ЗапросПоиск.Текст = СтрЗаменить(ТекстШаблон, "ВходящийНДС", Параметры.ИмяРегистраНДС);
	
	Возврат ЗапросПоиск.Выполнить().Выгрузить();
	
КонецФункции

Процедура ОчиститьДокументРасчетовВТаблице(Таблица, ТаблицаЗачетов, МассивИменКолонокСвязи)
	
	Таблица.Колонки.Добавить("ОставитьДокументРасчетов", Новый ОписаниеТипов("Булево"));
	
	Поиск = Новый Структура(СтрСоединить(МассивИменКолонокСвязи, ","));
	
	Поиск.Вставить("ВозможноПотребуетсяОчисткаДокументаРасчетов", Истина);
	Поиск.Вставить("ОставитьДокументРасчетов", Ложь);
	
	Для Каждого СтрокаЗачета Из ТаблицаЗачетов Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаЗачета["ДокументРасчетов"]) Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаЗачета);
		
		МассивСтрок = Таблица.НайтиСтроки(Поиск);
		
		Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
			// Есть строки с такой аналитикой документа расчетов.
			// Документ расчетов оставляем, очищать не требуется.
			СтрокаТаблицы["ОставитьДокументРасчетов"] = Истина;
		КонецЦикла;
		
	КонецЦикла;
	
	Поиск = Новый Структура();
	Поиск.Вставить("ВозможноПотребуетсяОчисткаДокументаРасчетов", Истина);
	Поиск.Вставить("ОставитьДокументРасчетов", Ложь);
	
	МассивСтрок = Таблица.НайтиСтроки(Поиск);
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		СтрокаТаблицы["ДокументРасчетов"] = Неопределено;
	КонецЦикла;
	
	// Удаляем служебные колонки
	
	Таблица.Колонки.Удалить("ОставитьДокументРасчетов");
	Таблица.Колонки.Удалить("ВозможноПотребуетсяОчисткаДокументаРасчетов");
	
КонецПроцедуры


Процедура ЗаполнитьСчетаФактурыНаОтгрузкуКЗаявленнымВычетам(СчетаФактурыНаОтгрузку,
		ТаблицаВычеты, ТаблицаЗачетаАвансовПоРегистраторам, МассивИменКолонокСвязи)
	
	УдалитьЗачетыПоАналитикеОтсутствующейВТаблицеВычетов(ТаблицаВычеты, ТаблицаЗачетаАвансовПоРегистраторам, МассивИменКолонокСвязи);
	
	СписокРегистраторов = ПолучитьРегистраторовЗаявленныхВычетов(ТаблицаЗачетаАвансовПоРегистраторам);
	
	Если СписокРегистраторов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СчетаФактурыРегистраторов = ПрочитатьСчетаФактурыНаОтгрузкуНаОснованииРегистраторов(СписокРегистраторов);
	
	ЗаполнитьСчетаФактурыНаОтгрузку(СчетаФактурыНаОтгрузку, СчетаФактурыРегистраторов, ТаблицаВычеты,
		ТаблицаЗачетаАвансовПоРегистраторам, МассивИменКолонокСвязи);
	
КонецПроцедуры

Процедура УдалитьЗачетыПоАналитикеОтсутствующейВТаблицеВычетов(ТаблицаВычеты, ТаблицаЗачетаАвансовПоРегистраторам, МассивИменКолонокСвязи)
	
	ИмяВременнойКолонки = "АналитикаПрисутствует";
	
	ТаблицаЗачетаАвансовПоРегистраторам.Колонки.Добавить(ИмяВременнойКолонки, Новый ОписаниеТипов("Булево"));
	
	ИменаКолонокСтрокой = СтрСоединить(МассивИменКолонокСвязи, ",");
	
	ТаблицаЗачетаАвансовПоРегистраторам.Индексы.Добавить(ИменаКолонокСтрокой);
	
	Поиск = Новый Структура(ИменаКолонокСтрокой);
	
	Для Каждого СтрокаТаблицыВычета Из ТаблицаВычеты Цикл
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаТаблицыВычета);
		
		МассивСтрок = ТаблицаЗачетаАвансовПоРегистраторам.НайтиСтроки(Поиск);
		
		Для Каждого СтрокаТаблицыЗачетаПоРегистраторам Из МассивСтрок Цикл
			СтрокаТаблицыЗачетаПоРегистраторам[ИмяВременнойКолонки] = Истина;
		КонецЦикла;
	КонецЦикла;
	
	Поиск = Новый Структура(ИмяВременнойКолонки, Ложь);
	
	МассивСтрок = ТаблицаЗачетаАвансовПоРегистраторам.НайтиСтроки(Поиск);
	
	Для Каждого СтрокаТаблицыЗачетаПоРегистраторам Из МассивСтрок Цикл
		ТаблицаЗачетаАвансовПоРегистраторам.Удалить(СтрокаТаблицыЗачетаПоРегистраторам);
	КонецЦикла;
	
	ТаблицаЗачетаАвансовПоРегистраторам.Колонки.Удалить(ИмяВременнойКолонки);
	
КонецПроцедуры

Функция ПолучитьРегистраторовЗаявленныхВычетов(ТаблицаЗачетаАвансовПоРегистраторам)
	
	ВремТаблица = ТаблицаЗачетаАвансовПоРегистраторам.Скопировать(, "Регистратор");
	ВремТаблица.Свернуть("Регистратор");
	
	Возврат ВремТаблица.ВыгрузитьКолонку("Регистратор");
	
КонецФункции

Функция ПрочитатьСчетаФактурыНаОтгрузкуНаОснованииРегистраторов(СписокРегистраторов)
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("СписокРегистраторов", СписокРегистраторов);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ДокументОснование	КАК ДокументОтгрузки,
	|	Ссылка				КАК Ссылка,
	|	Дата				КАК Дата,
	|	Номер				КАК Номер,
	|	Контрагент			КАК Контрагент,
	|	Договор				КАК Договор,
	|	КФО					КАК КФО
	|ИЗ
	|	Документ.СчетФактураВыданный
	|ГДЕ
	|	ДокументОснование В(&СписокРегистраторов)
	|	И Проведен
	|УПОРЯДОЧИТЬ ПО
	|	Дата";
	
	Возврат ЗапросПоиск.Выполнить().Выгрузить();
	
КонецФункции

Процедура ЗаполнитьСчетаФактурыНаОтгрузку(СчетаФактурыНаОтгрузку, СчетаФактурыРегистраторов, ТаблицаВычеты,
		ТаблицаЗачетаАвансовПоРегистраторам, МассивИменКолонокСвязи)
	
	Перем ПоискИдентификатора;
	
	ТаблицаВычеты.Колонки.Добавить("ИдентификаторСтроки", ОбщегоНазначения.ОписаниеТипаСтрока(36));
	
	СчетаФактурыРегистраторов.Индексы.Добавить("ДокументОтгрузки");
	
	ИменаКолонокСтрокой = СтрСоединить(МассивИменКолонокСвязи, ",");
	
	ПоискАналитики = Новый Структура(ИменаКолонокСтрокой);
	
	ИменаКолонокАналитикиСФ = "Контрагент,Договор,КФО";
	ПоискСФ = Новый Структура("ДокументОтгрузки," + ИменаКолонокАналитикиСФ);
	
	ТаблицаИдентификаторов = НовыйТаблицаОбработанныхИдентификаторовСтрок(МассивИменКолонокСвязи, ТаблицаВычеты, ПоискИдентификатора);
	
	Для Каждого СтрокаТаблицыВычетов Из ТаблицаВычеты Цикл
		ДатаЗачета = СтрокаТаблицыВычетов.ДатаЗачета;
		ДатаСФНаАванс = СтрокаТаблицыВычетов.ДатаСчетаФактуры;
		
		ЗаполнитьЗначенияСвойств(ПоискАналитики, СтрокаТаблицыВычетов);
		ЗаполнитьЗначенияСвойств(ПоискИдентификатора, СтрокаТаблицыВычетов);
		
		МассивСтрокЗачета = ТаблицаЗачетаАвансовПоРегистраторам.НайтиСтроки(ПоискАналитики);
		
		Для Каждого СтрокаТаблицыЗачетаПоРегистраторам Из МассивСтрокЗачета Цикл
			Если СтрокаТаблицыЗачетаПоРегистраторам.ДатаЗачета <> ДатаЗачета Тогда
				Продолжить;
			КонецЕсли;
			
			ПоискСФ.ДокументОтгрузки = СтрокаТаблицыЗачетаПоРегистраторам.Регистратор;
			ЗаполнитьЗначенияСвойств(ПоискСФ, СтрокаТаблицыВычетов, ИменаКолонокАналитикиСФ);
			МассивСтрокСФ = СчетаФактурыРегистраторов.НайтиСтроки(ПоискСФ);
			
			Для Каждого СтрокаТаблицыСФНаОтгрузку Из МассивСтрокСФ Цикл
				ДатаСФНаОтгрузку = СтрокаТаблицыСФНаОтгрузку.Дата;
				
				Если ДатаСФНаАванс > ДатаСФНаОтгрузку Тогда
					Продолжить;
				КонецЕсли;
				
				СчетФактураНаОтгрузку = СтрокаТаблицыСФНаОтгрузку.Ссылка;
				
				ПоискИдентификатора.СФНаАванс = СтрокаТаблицыВычетов.СчетФактура;
				
				МассивСтрокИдентификаторов = ТаблицаИдентификаторов.НайтиСтроки(ПоискИдентификатора);
				
				Если МассивСтрокИдентификаторов.Количество() = 0 Тогда
					ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор());
					
					НоваяСтрокаИдентификатора = ТаблицаИдентификаторов.Добавить();
					
					ЗаполнитьЗначенияСвойств(НоваяСтрокаИдентификатора, ПоискИдентификатора);
					НоваяСтрокаИдентификатора.ИдентификаторСтроки = ИдентификаторСтроки;
				Иначе
					ИдентификаторСтроки = МассивСтрокИдентификаторов[0].ИдентификаторСтроки;
				КонецЕсли;
				
				СтрокаТаблицыВычетов.ИдентификаторСтроки = ИдентификаторСтроки;
				
				СтруктураНомера = УчетНДС.ОпределитьПоОбъектуНомерСФДляВыводаВРегистрыУчета(СчетФактураНаОтгрузку);
				
				НоваяСтрокаСФНаОтгрузку = СчетаФактурыНаОтгрузку.Добавить();
				НоваяСтрокаСФНаОтгрузку.ИдентификаторСтроки = ИдентификаторСтроки;
				НоваяСтрокаСФНаОтгрузку.СчетФактура = СчетФактураНаОтгрузку;
				НоваяСтрокаСФНаОтгрузку.Дата = СтрокаТаблицыСФНаОтгрузку.Дата;
				НоваяСтрокаСФНаОтгрузку.Номер = СтруктураНомера.Номер;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	// Избавляемся от возможных дублей.
	СчетаФактурыНаОтгрузку.Свернуть("ИдентификаторСтроки,СчетФактура,Дата,Номер");
	СчетаФактурыНаОтгрузку.Сортировать("Дата,СчетФактура");
	
КонецПроцедуры

Функция НовыйТаблицаОбработанныхИдентификаторовСтрок(Знач МассивИменКолонокСвязи, Знач ТаблицаВычеты, ПоискИдентификатора)
	
	ТаблицаИдентификаторов = Новый ТаблицаЗначений();
	ТаблицаИдентификаторов.Колонки.Добавить("ИдентификаторСтроки",	ОбщегоНазначения.ОписаниеТипаСтрока(36));
	ТаблицаИдентификаторов.Колонки.Добавить("СФНаАванс",			Новый ОписаниеТипов("ДокументСсылка.СчетФактураВыданный"));
	
	КопируемыеКолонки = ОбщегоНазначенияКлиентСервер.СкопироватьМассив(МассивИменКолонокСвязи);
	КопируемыеКолонки.Добавить("ДатаЗачета");
	
	Для Каждого ИмяКолонки Из КопируемыеКолонки Цикл
		ТаблицаИдентификаторов.Колонки.Добавить(ИмяКолонки, ТаблицаВычеты.Колонки[ИмяКолонки].ТипЗначения);
	КонецЦикла;
	
	// Все колонки, кроме ИдентификаторСтроки.
	ПоискИдентификатора = Новый Структура("СФНаАванс," + СтрСоединить(КопируемыеКолонки, ","));
	
	Возврат ТаблицаИдентификаторов;
	
КонецФункции

// Возврат аванса полученного

Функция ПолучитьТаблицуВозвратаАвансовПолученных(Параметры)
	
	Если Параметры["АвансыКомиссионера"] Тогда
		ТаблицаВозвратаАвансов = ПолучитьТаблицуВозвратаАвансовПолученных_АК(Параметры);
	Иначе
		ТаблицаВозвратаАвансов = ПолучитьТаблицуВозвратаАвансовПолученных_АП(Параметры);
	КонецЕсли;
	
	Если Параметры["АнализироватьСчета205хА"] Тогда
		
		ТаблицаВозвратаАвансов205хА = ПолучитьТаблицуВозвратаАвансовПолученных_205хА(Параметры);
		
		Для Каждого СтрокаТаблицы Из ТаблицаВозвратаАвансов205хА Цикл
			
			НоваяСтрока = ТаблицаВозвратаАвансов.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			
		КонецЦикла;
		
		ТаблицаВозвратаАвансов.Сортировать("ДатаВозврата");
		
	КонецЕсли;
		
	Возврат ТаблицаВозвратаАвансов;
	
КонецФункции

Функция ПолучитьТаблицуВозвратаАвансовПолученных_205хА(Параметры)
	
	ЗапросВозвратАвансов = Новый Запрос();
	ЗапросВозвратАвансов.УстановитьПараметр("Организация",						Параметры.Организация);
	ЗапросВозвратАвансов.УстановитьПараметр("ДатаНачала",						Параметры.ДатаНачала);
	ЗапросВозвратАвансов.УстановитьПараметр("ДатаОкончания",					Параметры.ДатаОкончания);
	ЗапросВозвратАвансов.УстановитьПараметр("МассивКонтрагентов",				Параметры.МассивКонтрагентов);
	ЗапросВозвратАвансов.УстановитьПараметр("МассивДоговоров",					Параметры.МассивДоговоров);
	ЗапросВозвратАвансов.УстановитьПараметр("СчетаАвансовПолученных",			Параметры.СтруктураСчетовАвансов["МассивСчетов"]);
	ЗапросВозвратАвансов.УстановитьПараметр("СчетаДенежныхСредств",				Параметры.СчетаДенежныхСредств);
	ЗапросВозвратАвансов.УстановитьПараметр("МассивКПС",						Параметры.МассивКПС);
	ЗапросВозвратАвансов.УстановитьПараметр("МассивКФО",						Параметры.МассивКФО);
	ЗапросВозвратАвансов.УстановитьПараметр("ЗаполнитьВалютныеСуммы",			Параметры.ЗаполнитьВалютныеСуммы);
	ЗапросВозвратАвансов.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",	Параметры.ИспользоватьУчетПоПодразделениям);
	ЗапросВозвратАвансов.УстановитьПараметр("ВидыСубконто",						Параметры.ВидыСубконто);
	ЗапросВозвратАвансов.УстановитьПараметр("ШаблонЗаменыСчетов",				Параметры.ШаблонЗаменыСчетов);
	ЗапросВозвратАвансов.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Шаблон замены счетов (некоторая часть макета из ПереносОстатков64нРасчеты)
	|//
	|ВЫБРАТЬ
	|	ТЗ.КФО				КАК КФО,
	|	ТЗ.СчетРасчетов		КАК СчетРасчетов,
	|	ТЗ.СчетПриемник		КАК СчетПриемник
	|ПОМЕСТИТЬ
	|	ШаблонЗаменыСчетов
	|ИЗ
	|	&ШаблонЗаменыСчетов	КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Возвраты авансов полученных, по дням
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕПСБУОбороты.Субконто1											КАК Контрагент,
	|	ЕПСБУОбороты.Субконто2											КАК Договор,
	|	ЕПСБУОбороты.КФО												КАК КФО,
	|	ЕСТЬNULL(ШаблонЗаменыСчетов.СчетПриемник, ЕПСБУОбороты.Счет)	КАК СчетРасчетов,
	|	ЕПСБУОбороты.КПС												КАК КПССчетРасчетов,
	|	ЕПСБУОбороты.Период												КАК ДатаВозврата,
	|	НЕОПРЕДЕЛЕНО													КАК ДокументРасчетов,
	|	СУММА(ЕПСБУОбороты.СуммаОборотДт)								КАК Всего,
	|	СУММА(ВЫБОР
	|		КОГДА &ЗаполнитьВалютныеСуммы ТОГДА
	|			ЕПСБУОбороты.ВалютнаяСуммаОборотДт
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ)															КАК ВсегоВалютная
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|		&ДатаНачала,								// 1
	|		&ДатаОкончания,								// 2
	|		День,										// 3
	|		Счет В (&СчетаАвансовПолученных),			// 4
	|		&ВидыСубконто,								// 5
	|		Организация = &Организация					// 6
	|		И	Субконто1 В (&МассивКонтрагентов)
	|		И	Субконто2 В (&МассивДоговоров)
	|		И	КПС В (&МассивКПС)
	|		И	КФО В (&МассивКФО),
	|		КорСчет В ИЕРАРХИИ(&СчетаДенежныхСредств)	// 7
	|	)	КАК ЕПСБУОбороты
	|	ЛЕВОЕ СОЕДИНЕНИЕ	ШаблонЗаменыСчетов
	|		ПО	ЕПСБУОбороты.Счет = ШаблонЗаменыСчетов.СчетРасчетов
	|		И	(ЕПСБУОбороты.КФО = ШаблонЗаменыСчетов.КФО
	|			ИЛИ ШаблонЗаменыСчетов.КФО = ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка))
	|ГДЕ
	|	СуммаОборотДт > 0
	|	И ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям
	|			И НЕ (Подразделение ЕСТЬ NULL И ПодразделениеКор ЕСТЬ NULL) ТОГДА
	|			Подразделение = ПодразделениеКор
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ
	|СГРУППИРОВАТЬ ПО
	|	ЕПСБУОбороты.Субконто1,
	|	ЕПСБУОбороты.Субконто2,
	|	ЕПСБУОбороты.КФО,
	|	ЕСТЬNULL(ШаблонЗаменыСчетов.СчетПриемник, ЕПСБУОбороты.Счет),
	|	ЕПСБУОбороты.КПС,
	|	ЕПСБУОбороты.Период,
	|	НЕОПРЕДЕЛЕНО
	|УПОРЯДОЧИТЬ ПО
	|	ДатаВозврата
	|;";
	
	Возврат ЗапросВозвратАвансов.Выполнить().Выгрузить();
	
КонецФункции

Функция ПолучитьТаблицуВозвратаАвансовПолученных_АП(Параметры)
	
	ЗапросВозвратАвансов = Новый Запрос();
	ЗапросВозвратАвансов.УстановитьПараметр("Организация",						Параметры.Организация);
	ЗапросВозвратАвансов.УстановитьПараметр("ДатаНачала",						Параметры.ДатаНачала);
	ЗапросВозвратАвансов.УстановитьПараметр("ДатаОкончания",					Параметры.ДатаОкончания);
	ЗапросВозвратАвансов.УстановитьПараметр("МассивКонтрагентов",				Параметры.МассивКонтрагентов);
	ЗапросВозвратАвансов.УстановитьПараметр("МассивДоговоров",					Параметры.МассивДоговоров);
	ЗапросВозвратАвансов.УстановитьПараметр("МассивКПС",						Параметры.МассивКПС);
	ЗапросВозвратАвансов.УстановитьПараметр("МассивКФО",						Параметры.МассивКФО);
	ЗапросВозвратАвансов.УстановитьПараметр("ЗаполнитьВалютныеСуммы",			Параметры.ЗаполнитьВалютныеСуммы);
	ЗапросВозвратАвансов.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",	Параметры.ИспользоватьУчетПоПодразделениям);
	ЗапросВозвратАвансов.УстановитьПараметр("СчетАП",							Параметры.СчетАП);
	ЗапросВозвратАвансов.УстановитьПараметр("СчетаРасчетовДляПоискаКЭК",		Параметры.СтруктураСчетовАвансов.СчетаРасчетовДляПоискаКЭК);
	ЗапросВозвратАвансов.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Возвраты авансов по дням. Вместо счета выбран КЭК
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НАЧАЛОПЕРИОДА(Период, ДЕНЬ)													КАК ДатаВозврата,
	|	ВЫРАЗИТЬ(СубконтоДт1 КАК Справочник.Контрагенты)							КАК Контрагент,
	|	ВЫРАЗИТЬ(СубконтоДт2 КАК Справочник.Договоры)								КАК Договор,
	|	ЕСТЬNULL(СубконтоДт3, НЕОПРЕДЕЛЕНО)											КАК ДокументРасчетов,
	|	КЭКДт																		КАК КЭК,
	|	КПСДт																		КАК КПССчетРасчетов,
	|	ЕСТЬNULL(ПодразделениеДт, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))	КАК Подразделение,
	|	СУММА(Сумма)																КАК Всего,
	|	СУММА(ВЫБОР
	|		КОГДА &ЗаполнитьВалютныеСуммы ТОГДА
	|			ВалютнаяСуммаДт
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ)																		КАК ВсегоВалютная
	|ПОМЕСТИТЬ
	|	ВозвратыАвансовАП
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|		&ДатаНачала,		// 1
	|		&ДатаОкончания,		// 2
	|		СчетДт = &СчетАП	// 3
	|		И	Сумма > 0
	|		И	ХарактеристикаДвиженияДт = ЗНАЧЕНИЕ(Перечисление.СобытияНДС.ВозвратАвансаПолученного)
	|		И	Организация = &Организация
	|		И	СубконтоДт1 В (&МассивКонтрагентов)
	|		И	СубконтоДт2 В (&МассивДоговоров)
	|		И	КПСДт В (&МассивКПС)
	|		И	КФО В (&МассивКФО))	КАК ДвиженияССубконто
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(Период, ДЕНЬ),
	|	ВЫРАЗИТЬ(СубконтоДт1 КАК Справочник.Контрагенты),
	|	ВЫРАЗИТЬ(СубконтоДт2 КАК Справочник.Договоры),
	|	ЕСТЬNULL(СубконтоДт3, НЕОПРЕДЕЛЕНО),
	|	КЭКДт,
	|	КПСДт,
	|	ЕСТЬNULL(ПодразделениеДт, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))
	|ИНДЕКСИРОВАТЬ ПО
	|	КЭК,
	|	ДатаВозврата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Все счета расчетов, соответствующие обнаруженным КЭК (счет АП)
	|//		
	|ВЫБРАТЬ
	|	ДатыСобытийАП.Дата												КАК Период,
	|	ДатыСобытийАП.КЭК												КАК КЭК,
	|	СоответствияАналитическихСчетовКЭК.Счет							КАК Счет,
	|	СоответствияАналитическихСчетовКЭК.Счет.ДатаНачалаДействия		КАК ДатаНачалаДействия
	|ПОМЕСТИТЬ
	|	ВсеСчетаРасчетовАП
	|ИЗ
	|	РегистрСведений.СоответствияАналитическихСчетовКЭК	КАК СоответствияАналитическихСчетовКЭК
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|			(ВЫБРАТЬ
	|				КЭК				КАК КЭК,
	|				ДатаВозврата	КАК Дата
	|			ИЗ
	|				ВозвратыАвансовАП
	|			ГДЕ
	|				КЭК <> ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)
	|			)	КАК	ДатыСобытийАП
	|		ПО	СоответствияАналитическихСчетовКЭК.КЭК = ДатыСобытийАП.КЭК
	|		И	СоответствияАналитическихСчетовКЭК.Счет.ДатаНачалаДействия <= ДатыСобытийАП.Дата
	|		И	(СоответствияАналитическихСчетовКЭК.Счет.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ ДатыСобытийАП.Дата <= СоответствияАналитическихСчетовКЭК.Счет.ДатаОкончанияДействия)
	|		И	СоответствияАналитическихСчетовКЭК.Счет В(&СчетаРасчетовДляПоискаКЭК)
	|ИНДЕКСИРОВАТЬ ПО
	|	КЭК,
	|	ДатаНачалаДействия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Выбираемые даты счетов расчетов (счет АП)
	|//		
	|ВЫБРАТЬ
	|	Период							КАК Период,
	|	КЭК								КАК КЭК,
	|	МАКСИМУМ(ДатаНачалаДействия)	КАК ДатаНачалаДействия
	|ПОМЕСТИТЬ
	|	ВыбираемыеДатыСчетовРасчетовАП
	|ИЗ
	|	ВсеСчетаРасчетовАП
	|СГРУППИРОВАТЬ ПО
	|	Период,
	|	КЭК
	|ИНДЕКСИРОВАТЬ ПО
	|	КЭК,
	|	ДатаНачалаДействия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Выбираемые счета расчетов, соответствующие обнаруженным КЭК (счет АП)
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВсеСчетаРасчетовАП.Период			КАК Период,
	|	ВсеСчетаРасчетовАП.КЭК				КАК КЭК,
	|	МАКСИМУМ(ВсеСчетаРасчетовАП.Счет)	КАК Счет
	|ПОМЕСТИТЬ
	|	СчетаРасчетовАП
	|ИЗ
	|	ВсеСчетаРасчетовАП
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	ВыбираемыеДатыСчетовРасчетовАП
	|		ПО	ВсеСчетаРасчетовАП.КЭК = ВыбираемыеДатыСчетовРасчетовАП.КЭК
	|		И	ВсеСчетаРасчетовАП.ДатаНачалаДействия = ВыбираемыеДатыСчетовРасчетовАП.ДатаНачалаДействия
	|СГРУППИРОВАТЬ ПО
	|	ВсеСчетаРасчетовАП.Период,
	|	ВсеСчетаРасчетовАП.КЭК
	|ИНДЕКСИРОВАТЬ ПО
	|	КЭК,
	|	Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [4]. Возвраты авансов по дням. КЭК заменен на счет расчетов, действующий на дату возврата
	|//
	|ВЫБРАТЬ
	|	ВозвратыАвансовАП.ДатаВозврата											КАК ДатаВозврата,
	|	ВозвратыАвансовАП.Контрагент											КАК Контрагент,
	|	ВозвратыАвансовАП.Договор												КАК Договор,
	|	ВозвратыАвансовАП.ДокументРасчетов										КАК ДокументРасчетов,
	|	ЕСТЬNULL(СчетаРасчетовАП.Счет, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка))	КАК СчетРасчетов,
	|	ВозвратыАвансовАП.КПССчетРасчетов										КАК КПССчетРасчетов,
	|	ВЫБОР
	|		КОГДА СчетаРасчетовАП.Счет ЕСТЬ NULL ТОГДА
	|			ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|		КОГДА СчетаРасчетовАП.Счет.УчетПоПодразделениям ТОГДА
	|			Подразделение
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ																	КАК Подразделение,
	|	ВозвратыАвансовАП.Всего													КАК Всего,
	|	ВозвратыАвансовАП.ВсегоВалютная											КАК ВсегоВалютная
	|ИЗ
	|	ВозвратыАвансовАП
	|	ЛЕВОЕ СОЕДИНЕНИЕ	СчетаРасчетовАП
	|		ПО	ВозвратыАвансовАП.КЭК = СчетаРасчетовАП.КЭК
	|		И	ВозвратыАвансовАП.ДатаВозврата = СчетаРасчетовАП.Период
	|УПОРЯДОЧИТЬ ПО
	|	ДатаВозврата
	|;";
	
	Возврат ЗапросВозвратАвансов.Выполнить().Выгрузить();
	
КонецФункции

#КонецОбласти

#Область СчетРасчетов

Функция ПолучитьСпособыОпределенияСчетаРасчетов(Таблица)
	
	НастройкиСпособов = ПолучитьНастройкиСпособовОпределенияСчетаРасчетов();
	
	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипМассив = Новый ОписаниеТипов("Массив");
	
	СпособыОпределения = Новый ТаблицаЗначений();
	СпособыОпределения.Колонки.Добавить("Ид",					ТипСтрока);
	СпособыОпределения.Колонки.Добавить("ДокументыОснования",	ТипМассив);
	СпособыОпределения.Колонки.Добавить("НомераСтрок",			ТипМассив);
	
	Поиск = Новый Структура("Ид");
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		
		Если НЕ СтрокаТаблицы["НДСКВычету"] Тогда
			Продолжить;
		КонецЕсли;
		
		ДокументОснование = СтрокаТаблицы["ДокументОснование"];
		
		ТипОснования = ТипЗнч(ДокументОснование);
		
		Для Каждого НастройкаСпособа Из НастройкиСпособов Цикл
			
			ТипДокументаОбслуживается = (НастройкаСпособа["ТипыДокументов"].Найти(ТипОснования) <> Неопределено);
			
			Если ТипДокументаОбслуживается Тогда
				
				ЗаполнитьЗначенияСвойств(Поиск, НастройкаСпособа);
				
				МассивСтрок = СпособыОпределения.НайтиСтроки(Поиск);
				
				Если МассивСтрок.Количество() = 0 Тогда
					СпособОпределения = СпособыОпределения.Добавить();
					
					СпособОпределения["Ид"]					= НастройкаСпособа["Ид"];
					СпособОпределения["ДокументыОснования"]	= Новый Массив();
					СпособОпределения["НомераСтрок"]		= Новый Массив();
				Иначе
					СпособОпределения = МассивСтрок[0];
				КонецЕсли;
				
				СпособОпределения["ДокументыОснования"].Добавить(ДокументОснование);
				СпособОпределения["НомераСтрок"].Добавить(СтрокаТаблицы["НомерСтроки"]);
				
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат СпособыОпределения;
	
КонецФункции

Функция ПолучитьНастройкиСпособовОпределенияСчетаРасчетов()
	
	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипМассив = Новый ОписаниеТипов("Массив");
	
	НастройкиСпособов = Новый ТаблицаЗначений();
	НастройкиСпособов.Колонки.Добавить("Ид",				ТипСтрока);
	НастройкиСпособов.Колонки.Добавить("ТипыДокументов",	ТипМассив);
	
	//
	// Из проводок, алгоритм 1
	//
	ТипыДокументов = Новый Массив();
	
	ТипыДокументов.Добавить(Тип("ДокументСсылка.ПоступлениеМЗ"));
	ТипыДокументов.Добавить(Тип("ДокументСсылка.ПоступлениеМЗВПути"));
	ТипыДокументов.Добавить(Тип("ДокументСсылка.ПоступлениеОС"));
	ТипыДокументов.Добавить(Тип("ДокументСсылка.АвансовыйОтчет"));
	
	НоваяСтрока = НастройкиСпособов.Добавить();
	НоваяСтрока["Ид"]				= "Из проводок, алгоритм 1";
	НоваяСтрока["ТипыДокументов"]	= ТипыДокументов;
	
	//
	// Из проводок, алгоритм 2
	//
	ТипыДокументов = Новый Массив();
	
	ТипыДокументов.Добавить(Тип("ДокументСсылка.НачислениеАмортизацииПравПользованияОС"));
	
	НоваяСтрока = НастройкиСпособов.Добавить();
	НоваяСтрока["Ид"]				= "Из проводок, алгоритм 2";
	НоваяСтрока["ТипыДокументов"]	= ТипыДокументов;
	
	//
	// Из табличной части документа ПоступлениеУслугРабот
	//
	ТипыДокументов = Новый Массив();
	
	ТипыДокументов.Добавить(Тип("ДокументСсылка.ПоступлениеУслугРабот"));
	
	НоваяСтрока = НастройкиСпособов.Добавить();
	НоваяСтрока["Ид"]				= "Из табличной части ПоступлениеУслугРабот";
	НоваяСтрока["ТипыДокументов"]	= ТипыДокументов;
	
	
	Возврат НастройкиСпособов;
	
КонецФункции

// Ожидаемые колонки: НомерСтроки, НФА, ДокументОснование
Функция ПолучитьСчетаРасчетовИзПроводокДокументовОснований_Алгоритм1(ТЗСоставНФА, СпособОпределенияСчетаРасчетов)
	
	// Анализируемые проводки:
	//	Дт Любой				-	Кт Любой бухгалтерский
	//	НФА	или Неопределено		   ~~~~~~~~~~~~~~~~~~~ --> СчетРасчетов
	//
	// Сопоставление по полям табличной части:	НФА
	
	ДокументыОснования	= СпособОпределенияСчетаРасчетов["ДокументыОснования"];
	НомераСтрок			= СпособОпределенияСчетаРасчетов["НомераСтрок"];
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ТЗСоставНФА",			ТЗСоставНФА);
	ЗапросПоиск.УстановитьПараметр("ДокументыОснования",	ДокументыОснования);
	ЗапросПоиск.УстановитьПараметр("НомераСтрок",			НомераСтрок);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Исходная табличная часть
	|//
	|ВЫБРАТЬ
	|	ТЗ.НомерСтроки			КАК НомерСтроки,
	|	ТЗ.НФА					КАК НФА,
	|	ТЗ.ДокументОснование	КАК ДокументОснование
	|ПОМЕСТИТЬ
	|	ИсходнаяТабличнаяЧасть
	|ИЗ
	|	&ТЗСоставНФА	КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Табличная часть в ожидаемом формате
	|//
	|ВЫБРАТЬ
	|	НомерСтроки			КАК НомерСтроки,
	|	ДокументОснование	КАК ДокументОснование,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(НФА) = ТИП(Строка) ТОГДА
	|			НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ
	|			НФА
	|	КОНЕЦ				КАК НФА
	|ПОМЕСТИТЬ
	|	СоставНФА
	|ИЗ
	|	ИсходнаяТабличнаяЧасть
	|ГДЕ
	|	НомерСтроки В(&НомераСтрок)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Счета расчетов из проводок документов-оснований.
	|//		Возможны дубли строк по колонке НФА.
	|//
	|ВЫБРАТЬ
	|	Регистратор				КАК ДокументОснование,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(СубконтоДт1) = ТИП(Справочник.ОсновныеСредства) ТОГДА
	|			СубконтоДт1
	|		КОГДА ТИПЗНАЧЕНИЯ(СубконтоДт2) = ТИП(Справочник.ОсновныеСредства) ТОГДА
	|			СубконтоДт2
	|		КОГДА ТИПЗНАЧЕНИЯ(СубконтоДт3) = ТИП(Справочник.ОсновныеСредства) ТОГДА
	|			СубконтоДт3
	|		КОГДА ТИПЗНАЧЕНИЯ(СубконтоДт1) = ТИП(Справочник.Номенклатура) ТОГДА
	|			СубконтоДт1
	|		КОГДА ТИПЗНАЧЕНИЯ(СубконтоДт2) = ТИП(Справочник.Номенклатура) ТОГДА
	|			СубконтоДт2
	|		КОГДА ТИПЗНАЧЕНИЯ(СубконтоДт3) = ТИП(Справочник.Номенклатура) ТОГДА
	|			СубконтоДт3
	|		ИНАЧЕ
	|			НЕОПРЕДЕЛЕНО
	|	КОНЕЦ					КАК НФА,
	|	СчетКт					КАК СчетРасчетов,
	|	КПСКт					КАК КПССчетРасчетов,
	|	МИНИМУМ(НомерСтроки)	КАК Ид
	|ПОМЕСТИТЬ
	|	СчетаРасчетовПодготовка
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|		,
	|		,
	|		СчетКт.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Бухгалтерский)
	|		И Регистратор В(&ДокументыОснования)
	|	)
	|СГРУППИРОВАТЬ ПО
	|	Регистратор,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(СубконтоДт1) = ТИП(Справочник.ОсновныеСредства) ТОГДА
	|			СубконтоДт1
	|		КОГДА ТИПЗНАЧЕНИЯ(СубконтоДт2) = ТИП(Справочник.ОсновныеСредства) ТОГДА
	|			СубконтоДт2
	|		КОГДА ТИПЗНАЧЕНИЯ(СубконтоДт3) = ТИП(Справочник.ОсновныеСредства) ТОГДА
	|			СубконтоДт3
	|		КОГДА ТИПЗНАЧЕНИЯ(СубконтоДт1) = ТИП(Справочник.Номенклатура) ТОГДА
	|			СубконтоДт1
	|		КОГДА ТИПЗНАЧЕНИЯ(СубконтоДт2) = ТИП(Справочник.Номенклатура) ТОГДА
	|			СубконтоДт2
	|		КОГДА ТИПЗНАЧЕНИЯ(СубконтоДт3) = ТИП(Справочник.Номенклатура) ТОГДА
	|			СубконтоДт3
	|		ИНАЧЕ
	|			НЕОПРЕДЕЛЕНО
	|	КОНЕЦ,
	|	СчетКт,
	|	КПСКт
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Идентификаторы выбираемых строк проводок.
	|//		Используется для исключения дублей строк по колонке НФА.
	|//
	|ВЫБРАТЬ
	|	ДокументОснование	КАК ДокументОснование,
	|	НФА					КАК НФА,
	|	МИНИМУМ(Ид)			КАК Ид
	|ПОМЕСТИТЬ
	|	ИдВыбираемыхСтрок
	|ИЗ
	|	СчетаРасчетовПодготовка
	|СГРУППИРОВАТЬ ПО
	|	ДокументОснование,
	|	НФА
	|ИНДЕКСИРОВАТЬ ПО
	|	ДокументОснование,
	|	НФА,
	|	Ид
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [4]. Счета расчетов из проводок документов-оснований.
	|//		Исключены дубли строк по колонкам ДокументОснование, НФА.
	|//
	|ВЫБРАТЬ
	|	СчетаРасчетовПодготовка.ДокументОснование	КАК ДокументОснование,
	|	СчетаРасчетовПодготовка.НФА					КАК НФА,
	|	СчетаРасчетовПодготовка.СчетРасчетов		КАК СчетРасчетов,
	|	СчетаРасчетовПодготовка.КПССчетРасчетов		КАК КПССчетРасчетов
	|ПОМЕСТИТЬ
	|	СчетаРасчетов
	|ИЗ
	|	СчетаРасчетовПодготовка
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	ИдВыбираемыхСтрок
	|		ПО	СчетаРасчетовПодготовка.ДокументОснование	= ИдВыбираемыхСтрок.ДокументОснование
	|		И	СчетаРасчетовПодготовка.НФА					= ИдВыбираемыхСтрок.НФА
	|		И	СчетаРасчетовПодготовка.Ид					= ИдВыбираемыхСтрок.Ид
	|ИНДЕКСИРОВАТЬ ПО
	|	СчетаРасчетовПодготовка.ДокументОснование,
	|	СчетаРасчетовПодготовка.НФА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [5]. Счета расчетов для указанных номеров строк табличной части счета-фактуры
	|//		(Финальная таблица)
	|//
	|ВЫБРАТЬ
	|	СоставНФА.НомерСтроки			КАК НомерСтроки,
	|	СчетаРасчетов.СчетРасчетов		КАК СчетРасчетов,
	|	СчетаРасчетов.КПССчетРасчетов	КАК КПССчетРасчетов
	|ИЗ
	|	СоставНФА
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	СчетаРасчетов
	|		ПО	СоставНФА.ДокументОснование	= СчетаРасчетов.ДокументОснование
	|		И	СоставНФА.НФА				= СчетаРасчетов.НФА
	|УПОРЯДОЧИТЬ ПО
	|	СоставНФА.НомерСтроки
	|;";
	
	Возврат ЗапросПоиск.Выполнить().Выгрузить();
	
КонецФункции

// Ожидаемые колонки: НомерСтроки, НФА, ДокументОснование, СуммаНДС
Функция ПолучитьСчетаРасчетовИзПроводокДокументовОснований_Алгоритм2(ТЗСоставНФА, СпособОпределенияСчетаРасчетов)
	
	// Анализируемые проводки:
	//	Дт 210.10					- 	Кт 104.00
	//	НФА	или ОС.ПустаяСсылка			   ~~~~~~ --> СчетРасчетов
	//	Сумма
	//
	// Сопоставление по полям табличной части:	НФА, СуммаНДС
	
	ДокументыОснования	= СпособОпределенияСчетаРасчетов["ДокументыОснования"];
	НомераСтрок			= СпособОпределенияСчетаРасчетов["НомераСтрок"];
	
	НаДату = Неопределено;
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ТЗСоставНФА",			ТЗСоставНФА);
	ЗапросПоиск.УстановитьПараметр("ДокументыОснования",	ДокументыОснования);
	ЗапросПоиск.УстановитьПараметр("НомераСтрок",			НомераСтрок);
	ЗапросПоиск.УстановитьПараметр("Счет10400",				БухгалтерскийУчет.СчетПоКоду("104.00", НаДату));
	ЗапросПоиск.УстановитьПараметр("Счет21010",				БухгалтерскийУчет.СчетПоКоду("210.10", НаДату));
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Исходная табличная часть
	|//
	|ВЫБРАТЬ
	|	ТЗ.НомерСтроки			КАК НомерСтроки,
	|	ТЗ.НФА					КАК НФА,
	|	ТЗ.ДокументОснование	КАК ДокументОснование,
	|	ТЗ.СуммаНДС				КАК СуммаНДС
	|ПОМЕСТИТЬ
	|	ИсходнаяТабличнаяЧасть
	|ИЗ
	|	&ТЗСоставНФА	КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Табличная часть в ожидаемом формате
	|//
	|ВЫБРАТЬ
	|	НомерСтроки			КАК НомерСтроки,
	|	НФА					КАК НФА,
	|	ДокументОснование	КАК ДокументОснование,
	|	СуммаНДС			КАК СуммаНДС
	|ПОМЕСТИТЬ
	|	СоставНФА
	|ИЗ
	|	ИсходнаяТабличнаяЧасть
	|ГДЕ
	|	НомерСтроки В(&НомераСтрок)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Счета расчетов из проводок документов-оснований
	|//		Возможны дубли строк по колонкам ДокументОснование + НФА + СуммаНДС
	|//
	|ВЫБРАТЬ
	|	Регистратор				КАК ДокументОснование,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(СубконтоКт1) = ТИП(Справочник.ОсновныеСредства) ТОГДА
	|			СубконтоКт1
	|		КОГДА ТИПЗНАЧЕНИЯ(СубконтоКт2) = ТИП(Справочник.ОсновныеСредства) ТОГДА
	|			СубконтоКт2
	|		КОГДА ТИПЗНАЧЕНИЯ(СубконтоКт3) = ТИП(Справочник.ОсновныеСредства) ТОГДА
	|			СубконтоКт3
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)
	|	КОНЕЦ					КАК НФА,
	|	СчетКт					КАК СчетРасчетов,
	|	КПСКт					КАК КПССчетРасчетов,
	|	Сумма					КАК СуммаНДС,
	|	МИНИМУМ(НомерСтроки)	КАК Ид
	|ПОМЕСТИТЬ
	|	СчетаРасчетовПодготовка
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|		,
	|		,
	|		СчетДт В ИЕРАРХИИ(&Счет21010)
	|		И СчетКт В ИЕРАРХИИ(&Счет10400)
	|		И Регистратор В(&ДокументыОснования)
	|	)
	|ГДЕ
	|	ТИПЗНАЧЕНИЯ(СубконтоКт1) = ТИП(Справочник.ОсновныеСредства)
	|	ИЛИ ТИПЗНАЧЕНИЯ(СубконтоКт2) = ТИП(Справочник.ОсновныеСредства)
	|	ИЛИ ТИПЗНАЧЕНИЯ(СубконтоКт3) = ТИП(Справочник.ОсновныеСредства)
	|СГРУППИРОВАТЬ ПО
	|	Регистратор,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(СубконтоКт1) = ТИП(Справочник.ОсновныеСредства) ТОГДА
	|			СубконтоКт1
	|		КОГДА ТИПЗНАЧЕНИЯ(СубконтоКт2) = ТИП(Справочник.ОсновныеСредства) ТОГДА
	|			СубконтоКт2
	|		КОГДА ТИПЗНАЧЕНИЯ(СубконтоКт3) = ТИП(Справочник.ОсновныеСредства) ТОГДА
	|			СубконтоКт3
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)
	|	КОНЕЦ,
	|	СчетКт,
	|	КПСКт,
	|	Сумма
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Идентификаторы выбираемых строк проводок
	|//		Используется для исключения дублей строк по колонкам ДокументОснование + НФА + СуммаНДС
	|//
	|ВЫБРАТЬ
	|	ДокументОснование	КАК ДокументОснование,
	|	НФА					КАК НФА,
	|	СуммаНДС			КАК СуммаНДС,
	|	МИНИМУМ(Ид)			КАК Ид
	|ПОМЕСТИТЬ
	|	ИдВыбираемыхСтрок
	|ИЗ
	|	СчетаРасчетовПодготовка
	|СГРУППИРОВАТЬ ПО
	|	ДокументОснование,
	|	НФА,
	|	СуммаНДС
	|ИНДЕКСИРОВАТЬ ПО
	|	ДокументОснование,
	|	НФА,
	|	СуммаНДС,
	|	Ид
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [4]. Счета расчетов из проводок документов-оснований.
	|//		Исключены дубли строк по колонкам ДокументОснование + НФА + СуммаНДС
	|//
	|ВЫБРАТЬ
	|	СчетаРасчетовПодготовка.ДокументОснование	КАК ДокументОснование,
	|	СчетаРасчетовПодготовка.НФА					КАК НФА,
	|	СчетаРасчетовПодготовка.СуммаНДС			КАК СуммаНДС,
	|	СчетаРасчетовПодготовка.СчетРасчетов		КАК СчетРасчетов,
	|	СчетаРасчетовПодготовка.КПССчетРасчетов		КАК КПССчетРасчетов
	|ПОМЕСТИТЬ
	|	СчетаРасчетов
	|ИЗ
	|	СчетаРасчетовПодготовка
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	ИдВыбираемыхСтрок
	|		ПО	СчетаРасчетовПодготовка.ДокументОснование	= ИдВыбираемыхСтрок.ДокументОснование
	|		И	СчетаРасчетовПодготовка.НФА					= ИдВыбираемыхСтрок.НФА
	|		И	СчетаРасчетовПодготовка.СуммаНДС			= ИдВыбираемыхСтрок.СуммаНДС
	|		И	СчетаРасчетовПодготовка.Ид					= ИдВыбираемыхСтрок.Ид
	|ИНДЕКСИРОВАТЬ ПО
	|	СчетаРасчетовПодготовка.ДокументОснование,
	|	СчетаРасчетовПодготовка.НФА,
	|	СчетаРасчетовПодготовка.СуммаНДС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [5]. Счета расчетов для указанных номеров строк табличной части счета-фактуры
	|//		(Финальная таблица)
	|//
	|ВЫБРАТЬ
	|	СоставНФА.НомерСтроки			КАК НомерСтроки,
	|	СчетаРасчетов.СчетРасчетов		КАК СчетРасчетов,
	|	СчетаРасчетов.КПССчетРасчетов	КАК КПССчетРасчетов
	|ИЗ
	|	СоставНФА
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	СчетаРасчетов
	|		ПО	СоставНФА.ДокументОснование	= СчетаРасчетов.ДокументОснование
	|		И	СоставНФА.НФА				= СчетаРасчетов.НФА
	|		И	СоставНФА.СуммаНДС			= СчетаРасчетов.СуммаНДС
	|УПОРЯДОЧИТЬ ПО
	|	СоставНФА.НомерСтроки
	|;";
	
	Возврат ЗапросПоиск.Выполнить().Выгрузить();
	
КонецФункции

// Ожидаемые колонки: НомерСтроки, НФА, ДокументОснование, Всего
Функция ПолучитьСчетаРасчетовИзТабличнойЧасти_ПоступлениеУслугРабот(ТЗСоставНФА, СпособОпределенияСчетаРасчетов)
	
	// Анализируемые строки табличной части:
	//	Номенклатура или Содержание
	//	Всего
	//	КЭК			   
	//	~~~ --> СчетРасчетов
	//
	// Сопоставление по полям табличной части:	НФА, Всего
	
	ДокументыОснования	= СпособОпределенияСчетаРасчетов["ДокументыОснования"];
	
	НомераСтрок			= СпособОпределенияСчетаРасчетов["НомераСтрок"];
	
	НаДату = Неопределено;
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ТЗСоставНФА",	ТЗСоставНФА);
	ЗапросПоиск.УстановитьПараметр("НомераСтрок",	НомераСтрок);
	ЗапросПоиск.УстановитьПараметр("Счет30200",		БухгалтерскийУчет.СчетПоКоду("302.00", НаДату));
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Исходная табличная часть
	|//
	|ВЫБРАТЬ
	|	ТЗ.НомерСтроки			КАК НомерСтроки,
	|	ТЗ.НФА					КАК НФА,
	|	ТЗ.ДокументОснование	КАК ДокументОснование,
	|	ТЗ.Всего				КАК Всего
	|ПОМЕСТИТЬ
	|	ИсходнаяТабличнаяЧасть
	|ИЗ
	|	&ТЗСоставНФА	КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Табличная часть в ожидаемом формате
	|//
	|ВЫБРАТЬ
	|	НомерСтроки			КАК НомерСтроки,
	|	НФА					КАК НФА,
	|	ДокументОснование	КАК ДокументОснование,
	|	Всего				КАК СуммаДляСвязи
	|ПОМЕСТИТЬ
	|	СоставНФА
	|ИЗ
	|	ИсходнаяТабличнаяЧасть
	|ГДЕ
	|	НомерСтроки В(&НомераСтрок)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. КЭК расчетов из табличных частей документов-оснований.
	|//		Возможны дубли строк по колонке СуммаДляСвязи.
	|//
	|ВЫБРАТЬ
	|	Ссылка			КАК ДокументОснование,
	|	Ссылка.Дата		КАК ДатаДокументаОснования,
	|	ВЫБОР
	|		КОГДА Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка) ТОГДА
	|			Номенклатура
	|		ИНАЧЕ
	|			ВЫРАЗИТЬ(Содержание КАК СТРОКА(50))
	|	КОНЕЦ			КАК НФА,	
	|	КЭК				КАК КЭК,
	|	КПС				КАК КПС,
	|	НомерСтроки		КАК Ид,
	|	Всего			КАК СуммаДляСвязи
	|ПОМЕСТИТЬ
	|	КЭКРасчетовПодготовка
	|ИЗ
	|	Документ.ПоступлениеУслугРабот.УслугиИРаботы
	|ГДЕ
	|	(Ссылка,
	|	ВЫБОР
	|		КОГДА Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка) ТОГДА
	|			Номенклатура
	|		ИНАЧЕ
	|			ВЫРАЗИТЬ(Содержание КАК СТРОКА(50))
	|	КОНЕЦ,
	|	Всего) В (ВЫБРАТЬ ДокументОснование, НФА, СуммаДляСвязи ИЗ СоставНФА)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Идентификаторы выбираемых строк оснований.
	|//		Используется для исключения дублей строк по колонке СуммаДляСвязи.
	|//
	|ВЫБРАТЬ
	|	ДокументОснование		КАК ДокументОснование,
	|	ДатаДокументаОснования	КАК ДатаДокументаОснования,
	|	НФА						КАК НФА,
	|	СуммаДляСвязи			КАК СуммаДляСвязи,
	|	МИНИМУМ(Ид)				КАК Ид
	|ПОМЕСТИТЬ
	|	ИдВыбираемыхСтрокОснований
	|ИЗ
	|	КЭКРасчетовПодготовка
	|СГРУППИРОВАТЬ ПО
	|	ДокументОснование,
	|	ДатаДокументаОснования,
	|	НФА,
	|	СуммаДляСвязи
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [4]. КЭК расчетов из табличных частей документов-оснований.
	|//		Исключены дубли строк по колонкам ДокументОснование, НФА, СуммаДляСвязи.
	|//
	|ВЫБРАТЬ
	|	КЭКРасчетовПодготовка.ДокументОснование			КАК ДокументОснование,
	|	КЭКРасчетовПодготовка.ДатаДокументаОснования	КАК ДатаДокументаОснования,
	|	КЭКРасчетовПодготовка.НФА						КАК НФА,
	|	КЭКРасчетовПодготовка.СуммаДляСвязи				КАК СуммаДляСвязи,
	|	КЭКРасчетовПодготовка.КЭК						КАК КЭК,
	|	КЭКРасчетовПодготовка.КПС						КАК КПС
	|ПОМЕСТИТЬ
	|	КЭКРасчетов
	|ИЗ
	|	КЭКРасчетовПодготовка
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	ИдВыбираемыхСтрокОснований
	|		ПО	КЭКРасчетовПодготовка.ДокументОснование	= ИдВыбираемыхСтрокОснований.ДокументОснование
	|		И	КЭКРасчетовПодготовка.НФА				= ИдВыбираемыхСтрокОснований.НФА
	|		И	КЭКРасчетовПодготовка.Ид				= ИдВыбираемыхСтрокОснований.Ид
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [5]. Все счета расчетов, соответствующие обнаруженным КЭК (счет АП)
	|//		
	|ВЫБРАТЬ
	|	ДатыСобытийАП.Дата												КАК Период,
	|	ДатыСобытийАП.КЭК												КАК КЭК,
	|	СоответствияАналитическихСчетовКЭК.Счет							КАК Счет,
	|	СоответствияАналитическихСчетовКЭК.Счет.ДатаНачалаДействия		КАК ДатаНачалаДействия
	|ПОМЕСТИТЬ
	|	ВсеСчетаРасчетовАП
	|ИЗ
	|	РегистрСведений.СоответствияАналитическихСчетовКЭК	КАК СоответствияАналитическихСчетовКЭК
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|			(ВЫБРАТЬ
	|				КЭК						КАК КЭК,
	|				ДатаДокументаОснования	КАК Дата
	|			ИЗ
	|				КЭКРасчетов
	|			ГДЕ
	|				КЭК <> ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)
	|			)	КАК	ДатыСобытийАП
	|		ПО	СоответствияАналитическихСчетовКЭК.Счет В ИЕРАРХИИ(&Счет30200)
	|		И	СоответствияАналитическихСчетовКЭК.КЭК = ДатыСобытийАП.КЭК
	|		И	СоответствияАналитическихСчетовКЭК.Счет.ДатаНачалаДействия <= ДатыСобытийАП.Дата
	|		И	(СоответствияАналитическихСчетовКЭК.Счет.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ ДатыСобытийАП.Дата <= СоответствияАналитическихСчетовКЭК.Счет.ДатаОкончанияДействия)
	|ИНДЕКСИРОВАТЬ ПО
	|	КЭК,
	|	ДатаНачалаДействия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [6]. Выбираемые даты счетов расчетов (счет АП)
	|//		
	|ВЫБРАТЬ
	|	Период							КАК Период,
	|	КЭК								КАК КЭК,
	|	МАКСИМУМ(ДатаНачалаДействия)	КАК ДатаНачалаДействия
	|ПОМЕСТИТЬ
	|	ВыбираемыеДатыСчетовРасчетовАП
	|ИЗ
	|	ВсеСчетаРасчетовАП
	|СГРУППИРОВАТЬ ПО
	|	Период,
	|	КЭК
	|ИНДЕКСИРОВАТЬ ПО
	|	КЭК,
	|	ДатаНачалаДействия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [7]. Выбираемые счета расчетов, соответствующие обнаруженным КЭК (счет АП)
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВсеСчетаРасчетовАП.Период			КАК Период,
	|	ВсеСчетаРасчетовАП.КЭК				КАК КЭК,
	|	МАКСИМУМ(ВсеСчетаРасчетовАП.Счет)	КАК Счет
	|ПОМЕСТИТЬ
	|	СчетаРасчетовАП
	|ИЗ
	|	ВсеСчетаРасчетовАП
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	ВыбираемыеДатыСчетовРасчетовАП
	|		ПО	ВсеСчетаРасчетовАП.КЭК = ВыбираемыеДатыСчетовРасчетовАП.КЭК
	|		И	ВсеСчетаРасчетовАП.ДатаНачалаДействия = ВыбираемыеДатыСчетовРасчетовАП.ДатаНачалаДействия
	|СГРУППИРОВАТЬ ПО
	|	ВсеСчетаРасчетовАП.Период,
	|	ВсеСчетаРасчетовАП.КЭК
	|ИНДЕКСИРОВАТЬ ПО
	|	КЭК,
	|	Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [8]. Счета расчетов для указанных номеров строк проводимого счета-фактуры
	|//		(Финальная таблица)
	|//
	|ВЫБРАТЬ
	|	СоставНФА.НомерСтроки	КАК НомерСтроки,
	|	СчетаРасчетовАП.Счет	КАК СчетРасчетов,
	|	КЭКРасчетов.КПС			КАК КПССчетРасчетов
	|ИЗ
	|	СоставНФА
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	КЭКРасчетов
	|		ПО	СоставНФА.ДокументОснование	= КЭКРасчетов.ДокументОснование
	|		И	СоставНФА.НФА				= КЭКРасчетов.НФА
	|		И	СоставНФА.СуммаДляСвязи		= КЭКРасчетов.СуммаДляСвязи
	|	ЛЕВОЕ СОЕДИНЕНИЕ	СчетаРасчетовАП
	|		ПО	КЭКРасчетов.КЭК	= СчетаРасчетовАП.КЭК
	|		И	КЭКРасчетов.ДатаДокументаОснования	= СчетаРасчетовАП.Период
	|;";
	
	Возврат ЗапросПоиск.Выполнить().Выгрузить();
	
КонецФункции

Процедура ЗаполнитьСчетРасчетовВУказанныхСтроках(ТабличнаяЧастьСоставНФА, ТаблицаСчетовРасчетов)
	
	Для Каждого СтрокаТаблицы Из ТаблицаСчетовРасчетов Цикл
		
		СтрокаТЧ = ТабличнаяЧастьСоставНФА.Найти(СтрокаТаблицы["НомерСтроки"], "НомерСтроки");
		
		Если СтрокаТЧ = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаТаблицы, "СчетРасчетов, КПССчетРасчетов");
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область АвтоустановкаСубконто

Функция АвтоустановкаСубконто_ИнициализироватьТаблицуНастроек(Форма, МассивИменЭлементов = Неопределено, ЗначенияАвтоустановки = Неопределено)
	
	ЗаполнитьКолонкиЭлементовФормы			= (ТипЗнч(МассивИменЭлементов) = Тип("Массив"));
	ЗаполнитьКолонкиЗначенийАвтоустановки	= (ТипЗнч(ЗначенияАвтоустановки) = Тип("Соответствие"));
	
	Если НЕ ЗаполнитьКолонкиЭлементовФормы И НЕ ЗаполнитьКолонкиЗначенийАвтоустановки Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаНастроек = Новый ТаблицаЗначений();
	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипБулево = Новый ОписаниеТипов("Булево");
	ТаблицаНастроек.Колонки.Добавить("ИмяЭлемента",			ТипСтрока);
	ТаблицаНастроек.Колонки.Добавить("ИмяРеквизита",		ТипСтрока);
	ТаблицаНастроек.Колонки.Добавить("ЭтоРеквизитОбъекта",	ТипБулево);
	ТаблицаНастроек.Колонки.Добавить("ЭтоРеквизитТаблицы",	ТипБулево);
	ТаблицаНастроек.Колонки.Добавить("ИмяРеквизитаТаблица",	ТипСтрока);
	ТаблицаНастроек.Колонки.Добавить("ИмяЭлементаТаблица",	ТипСтрока);
	
	Если ЗаполнитьКолонкиЭлементовФормы Тогда
		Для Каждого ИмяЭлемента Из МассивИменЭлементов Цикл
			АвтоустановкаСубконто_ДобавитьСтрокуЭлементаФормыВТаблицуНастроек(Форма, ТаблицаНастроек, ИмяЭлемента);
		КонецЦикла;
	КонецЕсли;
	
	Если ЗаполнитьКолонкиЗначенийАвтоустановки Тогда
		ТаблицаНастроек.Колонки.Добавить("ВидСубконто",			Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто"));
		ТаблицаНастроек.Колонки.Добавить("Значение",			Новый ОписаниеТипов());
		
		МассивИменЭлементов = Новый Массив();
		КонкретныеЗначенияДляАвтоустановки = Новый Соответствие();
		Для Каждого Элем Из ЗначенияАвтоустановки Цикл
			Если ТипЗнч(Элем.Значение) = Тип("Строка") Тогда
				// Указан элемент формы
				ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто[Элем.Ключ];
				НоваяСтрока = АвтоустановкаСубконто_ДобавитьСтрокуЭлементаФормыВТаблицуНастроек(Форма, ТаблицаНастроек, Элем.Значение);
				Если НЕ НоваяСтрока = Неопределено Тогда
					НоваяСтрока["ВидСубконто"]	= ВидСубконто;
					НоваяСтрока["Значение"]		= Неопределено;
				КонецЕсли;
			Иначе
				// Указано конкретное значение для автоустановки
				ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто[Элем.Ключ];
				НоваяСтрока = ТаблицаНастроек.Добавить();
				НоваяСтрока["ВидСубконто"]	= ВидСубконто;
				НоваяСтрока["Значение"]		= Элем.Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат ТаблицаНастроек;
	
КонецФункции

Функция АвтоустановкаСубконто_ДобавитьСтрокуЭлементаФормыВТаблицуНастроек(Форма, ТаблицаНастроек, ИмяЭлементаФормы)
	
	ИменаРеквизитовЭлемента = АвтоустановкаСубконто_ПолучитьИменаРеквизитовЭлемента(Форма, ИмяЭлементаФормы);
	
	НоваяСтрока = ТаблицаНастроек.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ИменаРеквизитовЭлемента);
	НоваяСтрока["ИмяЭлемента"] = ИмяЭлементаФормы;
	
	Результат = НоваяСтрока;
	
	Возврат Результат;
	
КонецФункции

Функция АвтоустановкаСубконто_ПолучитьИменаРеквизитовЭлемента(Форма, ИмяЭлементаФормы)
	
	ПутьКДанным = Форма.Элементы[ИмяЭлементаФормы]["ПутьКДанным"];
	МеткаОбъект			= "Объект.";
	ДлинаМеткиОбъект	= СтрДлина(МеткаОбъект);
	ЭтоРеквизитОбъекта = (Лев(ПутьКДанным, ДлинаМеткиОбъект) = МеткаОбъект);
	Если ЭтоРеквизитОбъекта Тогда
		ОстатокПути = Сред(ПутьКДанным, ДлинаМеткиОбъект + 1);
	Иначе
		// Это реквизит формы.
		ОстатокПути = ПутьКДанным;
	КонецЕсли;
	инд = Найти(ОстатокПути, ".");
	Если инд > 0 Тогда
		ЭтоРеквизитТаблицы	= Истина;
		ИмяРеквизита		= Сред(ОстатокПути, инд + 1);
		ИмяРеквизитаТаблица	= Лев(ОстатокПути, инд - 1);
		
		ПроверяемыйЭлемент = Форма.Элементы[ИмяЭлементаФормы];
		Пока Истина Цикл
			ПроверяемыйЭлемент = ПроверяемыйЭлемент.Родитель;
			Если ТипЗнч(ПроверяемыйЭлемент) = Тип("ТаблицаФормы") Тогда
				ИмяЭлементаТаблица = ПроверяемыйЭлемент.Имя;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	Иначе
		ЭтоРеквизитТаблицы	= Ложь;
		ИмяРеквизита		= ОстатокПути;
		ИмяРеквизитаТаблица	= "";
		ИмяЭлементаТаблица	= "";
	КонецЕсли;
	
	Результат = Новый Структура();
	Результат.Вставить("ЭтоРеквизитОбъекта",	ЭтоРеквизитОбъекта);
	Результат.Вставить("ЭтоРеквизитТаблицы",	ЭтоРеквизитТаблицы);
	Результат.Вставить("ИмяРеквизита",			ИмяРеквизита);
	Результат.Вставить("ИмяРеквизитаТаблица",	ИмяРеквизитаТаблица);
	Результат.Вставить("ИмяЭлементаТаблица",	ИмяЭлементаТаблица);
	
	Возврат Результат;
	
КонецФункции

Процедура АвтоустановкаСубконто_ПодключитьОбработчик(Форма, ИмяЭлемента = Неопределено, ИмяСобытия, ИмяОбработчика)
	
	Перем	НастраиваемыйОбъект;
	
	Если ИмяЭлемента = Неопределено Тогда
		НастраиваемыйОбъект = Форма;
	Иначе
		НастраиваемыйОбъект = Форма.Элементы[ИмяЭлемента];
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НастраиваемыйОбъект.ПолучитьДействие(ИмяСобытия)) Тогда
		НастраиваемыйОбъект.УстановитьДействие(ИмяСобытия, ИмяОбработчика);
	КонецЕсли;
	
КонецПроцедуры

Функция АвтоустановкаСубконто_ПолучитьТаблицуПланАвтоустановки(Форма, Знач ИмяЭлемента, ТекущаяСтрока = Неопределено, ПолучитьВсеЗначенияАвтоустановки = Ложь)
	
	Перем	ИменаЭлементовСчет,
			ИмяЭлементаЗначениеАвтоустановки;
	
	ТипМассив = Новый ОписаниеТипов("Массив");
	
	ТаблицаПланАвтоустановки = Новый ТаблицаЗначений();
	ТаблицаПланАвтоустановки.Колонки.Добавить("ИмяРеквизитаТаблица",						Новый ОписаниеТипов("Строка"));
	ТаблицаПланАвтоустановки.Колонки.Добавить("ЭтоРеквизитОбъекта",							Новый ОписаниеТипов("Булево"));
	ТаблицаПланАвтоустановки.Колонки.Добавить("ОбработатьТаблицуЦеликом",					Новый ОписаниеТипов("Булево"));
	ТаблицаПланАвтоустановки.Колонки.Добавить("СтруктураВходныхПараметров",					Новый ОписаниеТипов("Структура"));
	ТаблицаПланАвтоустановки.Колонки.Добавить("ТаблицаНастроекСчетИСубконто",				Новый ОписаниеТипов("ТаблицаЗначений"));
	ТаблицаПланАвтоустановки.Колонки.Добавить("МассивОтмечатьНаличиеВидовСубконтоСтрока",	ТипМассив);
	ТаблицаПланАвтоустановки.Колонки.Добавить("МассивОтмечатьНаличиеВидовСубконто",			ТипМассив);

	ИменаЭлементовСчет = Новый Массив();
	
	ОбщаяТаблицаНастроек = Форма["АвтоустановкаСубконто_ОбщаяТаблицаНастроек"];
	Поиск = Новый Структура("ИмяЭлемента", ИмяЭлемента);
	МассивСтрок = ОбщаяТаблицаНастроек.НайтиСтроки(Поиск);
	Если МассивСтрок.Количество() > 0 Тогда
		СтрокаОбщихНастроек	= МассивСтрок[0];
		Если СтрокаОбщихНастроек["ЭтоЭлементЗначениеАвтоустановки"] Тогда
			// Изменено значение автоустановки.
			Если ПолучитьВсеЗначенияАвтоустановки = Ложь Тогда
				ИмяЭлементаЗначениеАвтоустановки = ИмяЭлемента;
			КонецЕсли;
			// Может быть установлена связь с несколькими элементами-счетами.
			Для Каждого ИмяЭлементаСчет Из СтрокаОбщихНастроек["ИменаЭлементовСчет"] Цикл
				ИменаЭлементовСчет.Добавить(ИмяЭлементаСчет);
			КонецЦикла;
		Иначе
			// Изменено значение счета.
			// Связь со значениями автоустановки - единственная.
			ИменаЭлементовСчет.Добавить(ИмяЭлемента);
		КонецЕсли;
		ОбработатьТаблицуЦеликом = НЕ (ЗначениеЗаполнено(СтрокаОбщихНастроек["ИмяРеквизитаТаблица"]))
			ИЛИ ТекущаяСтрока = Неопределено;
	КонецЕсли;
	
	Для Каждого ИмяЭлемента Из ИменаЭлементовСчет Цикл
		Поиск = Новый Структура("ИмяЭлемента, ЭтоЭлементСчет", ИмяЭлемента, Истина);
		СтрокаОбщихНастроек = ОбщаяТаблицаНастроек.НайтиСтроки(Поиск)[0];
		Идентификатор		= СтрокаОбщихНастроек["Идентификатор"];
		ОбслуживатьЭтотЭлемент = НЕ (Форма["АвтоустановкаСубконто_МассивОбслуживаемыхИдентификаторов"].Найти(Идентификатор) = Неопределено);
		Если ОбслуживатьЭтотЭлемент Тогда
			Поиск = Новый Структура("ИмяЭлемента", ИмяЭлемента);
			МассивСтрок = СтрокаОбщихНастроек["ТаблицаНастроекСчетИСубконто"].НайтиСтроки(Поиск);
			Если МассивСтрок.Количество() > 0 Тогда
				СтрокаЭлементаСчет		= МассивСтрок[0];
				СтрокаЭлементаСубконто1	= СтрокаОбщихНастроек["ТаблицаНастроекСчетИСубконто"][1];
				ИмяРеквизитаТаблица		= СтрокаЭлементаСубконто1["ИмяРеквизитаТаблица"];
				ЭтоРеквизитОбъекта		= СтрокаЭлементаСубконто1["ЭтоРеквизитОбъекта"];
				
				СтруктураВходныхПараметров = Новый Структура();
				СтруктураВходныхПараметров.Вставить("Счет",						АвтоустановкаСубконто_ПолучитьЗначениеСчета(Форма, СтрокаЭлементаСчет, ТекущаяСтрока));
				ЗначенияАвтоустановкиСтруктура = АвтоустановкаСубконто_ПолучитьЗначенияАвтоустановки(Форма, СтрокаОбщихНастроек, ТекущаяСтрока, ИмяЭлементаЗначениеАвтоустановки);
				СтруктураВходныхПараметров.Вставить("ЗначенияАвтоустановки",			ЗначенияАвтоустановкиСтруктура["ЗначенияАвтоустановки"]);
				СтруктураВходныхПараметров.Вставить("ЗначенияАвтоустановкиВТаблице",	ЗначенияАвтоустановкиСтруктура["ЗначенияАвтоустановкиВТаблице"]);
				
				НоваяСтрока = ТаблицаПланАвтоустановки.Добавить();
				НоваяСтрока["ИмяРеквизитаТаблица"]						= ИмяРеквизитаТаблица;
				НоваяСтрока["ЭтоРеквизитОбъекта"]						= ЭтоРеквизитОбъекта;
				НоваяСтрока["ОбработатьТаблицуЦеликом"]					= ОбработатьТаблицуЦеликом;
				НоваяСтрока["СтруктураВходныхПараметров"]				= СтруктураВходныхПараметров;
				НоваяСтрока["ТаблицаНастроекСчетИСубконто"]				= СтрокаОбщихНастроек["ТаблицаНастроекСчетИСубконто"].Выгрузить();
				НоваяСтрока["МассивОтмечатьНаличиеВидовСубконтоСтрока"]	= СтрокаОбщихНастроек["МассивОтмечатьНаличиеВидовСубконтоСтрока"];
				НоваяСтрока["МассивОтмечатьНаличиеВидовСубконто"]		= СтрокаОбщихНастроек["МассивОтмечатьНаличиеВидовСубконто"];
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТаблицаПланАвтоустановки;
	
КонецФункции

Функция АвтоустановкаСубконто_ПолучитьЗначениеСчета(Форма, СтрокаНастроек, ТекущаяСтрока = Неопределено)
	
	Возврат УчетНДСКлиентСервер.АвтоустановкаСубконто_ВычислитьЗначениеРеквизита(Форма, СтрокаНастроек, ТекущаяСтрока);
	
КонецФункции

Функция АвтоустановкаСубконто_ПолучитьЗначенияАвтоустановки(Форма, СтрокаОбщихНастроек, ТекущаяСтрока = Неопределено, ИмяЭлементаЗначениеАвтоустановки = Неопределено)
	
	Перем	ЗависимыеЭлементыАвтоустановки,
			ИзмененВедущийЭлементАвтоустановки;
	
	ЗначенияАвтоустановки			= Новый Соответствие();
	ЗначенияАвтоустановкиВТаблице	= Новый Соответствие();
			
	Результат = Новый Структура();
	
	Если ЗначениеЗаполнено(ИмяЭлементаЗначениеАвтоустановки) Тогда
		ИзмененВедущийЭлементАвтоустановки = СтрокаОбщихНастроек["ЗависимыеЭлементыАвтоустановки"].Свойство(ИмяЭлементаЗначениеАвтоустановки, ЗависимыеЭлементыАвтоустановки);
	Иначе
		ИзмененВедущийЭлементАвтоустановки = Ложь;
	КонецЕсли;
	
	ТаблицаНастроекЗначенияАвтоустановки = СтрокаОбщихНастроек["ТаблицаНастроекЗначенияАвтоустановки"];
	
	Для Каждого СтрокаТаблицы Из ТаблицаНастроекЗначенияАвтоустановки Цикл
		ИмяЭлементаАвтоустановки = СтрокаТаблицы["ИмяЭлемента"];
		
		Если ЗначениеЗаполнено(ИмяЭлементаЗначениеАвтоустановки) Тогда
			ИзмененУказанныйЭлементАвтоустановки = (ИмяЭлементаАвтоустановки = ИмяЭлементаЗначениеАвтоустановки);
			
			Если ИзмененВедущийЭлементАвтоустановки Тогда
				ИспользоватьЗависимыйЭлементАвтоустановки = НЕ (ЗависимыеЭлементыАвтоустановки.Найти(ИмяЭлементаАвтоустановки) = Неопределено);
			Иначе
				ИспользоватьЗависимыйЭлементАвтоустановки = Ложь;
			КонецЕсли;
			
			Если НЕ (ИзмененУказанныйЭлементАвтоустановки ИЛИ ИспользоватьЗависимыйЭлементАвтоустановки) Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		ВычислитьЗначение = (СтрокаТаблицы["Значение"] = Неопределено);
		Если ВычислитьЗначение Тогда
			ЗначениеАвтоустановки = УчетНДСКлиентСервер.АвтоустановкаСубконто_ВычислитьЗначениеРеквизита(Форма, СтрокаТаблицы, ТекущаяСтрока);
		Иначе
			ЗначениеАвтоустановки = СтрокаТаблицы["Значение"];
		КонецЕсли;
		
		Если СтрокаТаблицы["ЭтоРеквизитТаблицы"] Тогда
			ЗначенияАвтоустановкиВТаблице.Вставить(СтрокаТаблицы["ВидСубконто"], СтрокаТаблицы["ИмяРеквизита"]);
		Иначе
			ЗначенияАвтоустановки.Вставить(СтрокаТаблицы["ВидСубконто"], ЗначениеАвтоустановки);
		КонецЕсли;
	КонецЦикла;
	
	Результат.Вставить("ЗначенияАвтоустановки",			ЗначенияАвтоустановки);
	Результат.Вставить("ЗначенияАвтоустановкиВТаблице",	ЗначенияАвтоустановкиВТаблице);
	
	Возврат Результат;
	
КонецФункции

Процедура АвтоустановкаСубконто_ОбновитьСоставКолонокТаблицы(СоставКолонок, ТаблицаЗначений)
	
	Для Каждого Колонка Из ТаблицаЗначений.Колонки Цикл
		ИмяКолонки = Колонка.Имя;
		КолонкаУжеДобавлена = СоставКолонок.Свойство(ИмяКолонки);
		Если НЕ КолонкаУжеДобавлена Тогда
			СоставКолонок.Вставить(ИмяКолонки, Колонка.ТипЗначения.Типы());
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура АвтоустановкаСубконто_ОбработатьТаблицуИлиТекущуюСтроку(Форма, ИмяЭлемента, ТекущаяСтрока = Неопределено, ВыполнитьАвтоустановкуЗначений)
	
	// Автоматическое определение входных параметров (счета и значений автоустановки):
	ТаблицаПланАвтоустановки = АвтоустановкаСубконто_ПолучитьТаблицуПланАвтоустановки(Форма, ИмяЭлемента, ТекущаяСтрока);
	
	// Ручное переопределение значений входных параметров (счета и значений автоустановки):
	Попытка
		Форма.Переопределяемый_АвтоустановкаСубконто_ПередАвтоустановкойСубконто_Сервер(ТаблицаПланАвтоустановки);
	Исключение
	КонецПопытки;
	ТаблицаРабочая = ТаблицаПланАвтоустановки;
	
	Для Каждого СтрокаРабочейТаблицы Из ТаблицаРабочая Цикл
		ТаблицаНастроекСчетИСубконто	= СтрокаРабочейТаблицы["ТаблицаНастроекСчетИСубконто"];
		СтруктураВходныхПараметров		= СтрокаРабочейТаблицы["СтруктураВходныхПараметров"];
		
		// Таблица для заполнения определяется расположением элемента Субконто1:
		СтрокаЭлементаСубконто1 = ТаблицаНастроекСчетИСубконто[1];
		ИмяРеквизитаТаблица		= СтрокаЭлементаСубконто1["ИмяРеквизитаТаблица"];
		ЭтоРеквизитОбъекта		= СтрокаЭлементаСубконто1["ЭтоРеквизитОбъекта"];
		ЗаполняемаяТаблица		= ?(ЭтоРеквизитОбъекта,
			Форма.Объект[ИмяРеквизитаТаблица],
			Форма[ИмяРеквизитаТаблица]);
			
		Если СтрокаРабочейТаблицы["ОбработатьТаблицуЦеликом"] Тогда
			ИменаРеквизитовСчетИСубконто = Новый Структура();
			ИменаРеквизитовСчетИСубконто.Вставить("Счет",		ТаблицаНастроекСчетИСубконто[0]["ИмяРеквизита"]);
			ИменаРеквизитовСчетИСубконто.Вставить("Субконто1",	ТаблицаНастроекСчетИСубконто[1]["ИмяРеквизита"]);
			ИменаРеквизитовСчетИСубконто.Вставить("Субконто2",	ТаблицаНастроекСчетИСубконто[2]["ИмяРеквизита"]);
			ИменаРеквизитовСчетИСубконто.Вставить("Субконто3",	ТаблицаНастроекСчетИСубконто[3]["ИмяРеквизита"]);
			СчетЭтоРеквизитТаблицы = ЗначениеЗаполнено(ТаблицаНастроекСчетИСубконто[0]["ИмяРеквизитаТаблица"]);
			
			ПараметрыАвтоустановки = Новый Структура();
			ПараметрыАвтоустановки.Вставить("Форма",								Форма);
			ПараметрыАвтоустановки.Вставить("ЗаполняемаяТаблица",					ЗаполняемаяТаблица);
			ПараметрыАвтоустановки.Вставить("Счет",									СтруктураВходныхПараметров["Счет"]);
			ПараметрыАвтоустановки.Вставить("СчетЭтоРеквизитТаблицы",				СчетЭтоРеквизитТаблицы);
			ПараметрыАвтоустановки.Вставить("ИменаРеквизитовСчетИСубконто",			ИменаРеквизитовСчетИСубконто);
			ПараметрыАвтоустановки.Вставить("ЗначенияАвтоустановки",				СтруктураВходныхПараметров["ЗначенияАвтоустановки"]);
			ПараметрыАвтоустановки.Вставить("ЗначенияАвтоустановкиВТаблице",		СтруктураВходныхПараметров["ЗначенияАвтоустановкиВТаблице"]);
			ПараметрыАвтоустановки.Вставить("ТаблицаНастроекСчетИСубконто",			ТаблицаНастроекСчетИСубконто);
			ПараметрыАвтоустановки.Вставить("ТаблицаЭлементыАвтоустановкиВТаблице",	Форма["АвтоустановкаСубконто_ТаблицаЭлементыАвтоустановкиВТаблице"]);
			
			ОпцииЗаполнения = Новый Структура();
			ОпцииЗаполнения.Вставить("МассивОтмечатьНаличиеВидовСубконто",			СтрокаРабочейТаблицы["МассивОтмечатьНаличиеВидовСубконто"]);
			ОпцииЗаполнения.Вставить("МассивОтмечатьНаличиеВидовСубконтоСтрока",	СтрокаРабочейТаблицы["МассивОтмечатьНаличиеВидовСубконтоСтрока"]);
			ОпцииЗаполнения.Вставить("ВыполнитьАвтоустановкуЗначений",				ВыполнитьАвтоустановкуЗначений);
			ОпцииЗаполнения.Вставить("ВыполнитьАвтоустановкуТолькоПустыхЗначений",	Ложь);
			
			АвтоустановкаСубконто_ЗаполнитьТаблицу(ПараметрыАвтоустановки, ОпцииЗаполнения);
		Иначе
			АвтоустановкаСубконто_ЗаполнитьТекущуюСтрокуТаблицы(Форма,
				ИмяРеквизитаТаблица,
				ЭтоРеквизитОбъекта,
				ТекущаяСтрока,
				СтрокаРабочейТаблицы["ТаблицаНастроекСчетИСубконто"],
				СтрокаРабочейТаблицы["СтруктураВходныхПараметров"],
				СтрокаРабочейТаблицы["МассивОтмечатьНаличиеВидовСубконтоСтрока"],
				СтрокаРабочейТаблицы["МассивОтмечатьНаличиеВидовСубконто"],
				ВыполнитьАвтоустановкуЗначений,
				Ложь);	// ВыполнитьАвтоустановкуТолькоПустыхЗначений
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура АвтоустановкаСубконто_ЗаполнитьТаблицу(ПараметрыАвтоустановки, ОпцииЗаполнения, ВызовИзФормы = Истина)
	
	// Параметры автоустановки:
	Перем	Форма,
			ЗаполняемаяТаблица,
			СчетЭтоРеквизитТаблицы,
			ИменаРеквизитовСчетИСубконто,
			ЗначенияАвтоустановки,
			ЗначенияАвтоустановкиВТаблице,
			Счет,
			ТаблицаНастроекСчетИСубконто,
			ТаблицаЭлементыАвтоустановкиВТаблице;
			
	// Опции заполнения:
	Перем	ОтмечатьНезаполненныеСубконто,
			ОтмечатьЗначенияСовпадающиеСАвтоустановкой,
			МассивОтмечатьНаличиеВидовСубконто,
			МассивОтмечатьНаличиеВидовСубконтоСтрока,
			ВыполнитьАвтоустановкуЗначений,
			ВыполнитьАвтоустановкуТолькоПустыхЗначений;
			
	// Параметры автоустановки:
	ПараметрыАвтоустановки.Свойство("Форма",									Форма);
	ПараметрыАвтоустановки.Свойство("ЗаполняемаяТаблица",						ЗаполняемаяТаблица);
	ПараметрыАвтоустановки.Свойство("Счет",										Счет);
	ПараметрыАвтоустановки.Свойство("СчетЭтоРеквизитТаблицы",					СчетЭтоРеквизитТаблицы);
	ПараметрыАвтоустановки.Свойство("ИменаРеквизитовСчетИСубконто",				ИменаРеквизитовСчетИСубконто);
	Если НЕ ПараметрыАвтоустановки.Свойство("ЗначенияАвтоустановки",			ЗначенияАвтоустановки) Тогда
		ЗначенияАвтоустановки = Новый Соответствие();
	КонецЕсли;
	Если НЕ ПараметрыАвтоустановки.Свойство("ЗначенияАвтоустановкиВТаблице",	ЗначенияАвтоустановкиВТаблице) Тогда
		ЗначенияАвтоустановкиВТаблице = Новый Соответствие();
	КонецЕсли;
	ПараметрыАвтоустановки.Свойство("ТаблицаНастроекСчетИСубконто",				ТаблицаНастроекСчетИСубконто);
	ИмяРеквизитаСчет = ИменаРеквизитовСчетИСубконто["Счет"];
	ПараметрыАвтоустановки.Свойство("ТаблицаЭлементыАвтоустановкиВТаблице",		ТаблицаЭлементыАвтоустановкиВТаблице);
	
	
	// Опции заполнения:
	Если НЕ ОпцииЗаполнения.Свойство("ОтмечатьЗначенияСовпадающиеСАвтоустановкой", ОтмечатьЗначенияСовпадающиеСАвтоустановкой) Тогда
		Если ВызовИзФормы И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "АвтоустановкаСубконто_ОтмечатьЗначенияСовпадающиеСАвтоустановкой") Тогда
			ОтмечатьЗначенияСовпадающиеСАвтоустановкой = Форма["АвтоустановкаСубконто_ОтмечатьЗначенияСовпадающиеСАвтоустановкой"];
		Иначе
			ОтмечатьЗначенияСовпадающиеСАвтоустановкой = Ложь;
		КонецЕсли;
	КонецЕсли;
	Если НЕ ОпцииЗаполнения.Свойство("ОтмечатьНезаполненныеСубконто", ОтмечатьНезаполненныеСубконто) Тогда
		Если ВызовИзФормы И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "АвтоустановкаСубконто_ОтмечатьНезаполненныеСубконто") Тогда
			ОтмечатьНезаполненныеСубконто = Форма["АвтоустановкаСубконто_ОтмечатьНезаполненныеСубконто"];
		Иначе
			ОтмечатьНезаполненныеСубконто = Ложь;
		КонецЕсли;
	КонецЕсли;
	ИспользуемыеВидыСубконтоАвтоустановка = Новый Массив();
	Для Каждого Элем Из ЗначенияАвтоустановки Цикл
		ИспользуемыеВидыСубконтоАвтоустановка.Добавить(Элем.Ключ);
	КонецЦикла;
	Для Каждого Элем Из ЗначенияАвтоустановкиВТаблице Цикл
		ИспользуемыеВидыСубконтоАвтоустановка.Добавить(Элем.Ключ);
	КонецЦикла;
	СоответствиеОтмечатьНаличиеВидовСубконтоСтрока = Новый Соответствие();
	ОтмечатьНаличиеВидовСубконто = ОпцииЗаполнения.Свойство("МассивОтмечатьНаличиеВидовСубконто", МассивОтмечатьНаличиеВидовСубконто)
		И ОпцииЗаполнения.Свойство("МассивОтмечатьНаличиеВидовСубконтоСтрока", МассивОтмечатьНаличиеВидовСубконтоСтрока);
	Если ОтмечатьНаличиеВидовСубконто Тогда
		Для сч = 0 По МассивОтмечатьНаличиеВидовСубконто.Количество() - 1 Цикл
			СоответствиеОтмечатьНаличиеВидовСубконтоСтрока.Вставить(
				МассивОтмечатьНаличиеВидовСубконто[сч],
				МассивОтмечатьНаличиеВидовСубконтоСтрока[сч]);
		КонецЦикла;
	КонецЕсли;
	ОпцииЗаполнения.Свойство("ВыполнитьАвтоустановкуЗначений",				ВыполнитьАвтоустановкуЗначений);
	ОпцииЗаполнения.Свойство("ВыполнитьАвтоустановкуТолькоПустыхЗначений",	ВыполнитьАвтоустановкуТолькоПустыхЗначений);
	
	
	Если СчетЭтоРеквизитТаблицы Тогда
		Если ТипЗнч(ЗаполняемаяТаблица) = Тип("ТаблицаЗначений") Тогда
			ИспользуемыеСчета = ЗаполняемаяТаблица.Скопировать(, ИмяРеквизитаСчет);
		Иначе
			ИспользуемыеСчета = ЗаполняемаяТаблица.Выгрузить(, ИмяРеквизитаСчет);
		КонецЕсли;
	Иначе
		ИспользуемыеСчета = Новый Массив();
		ИспользуемыеСчета.Добавить(Счет);
	КонецЕсли;
	
	ЗапросНомераСубконто = Новый Запрос();
	ЗапросНомераСубконто.УстановитьПараметр("ИспользуемыеСчета",						ИспользуемыеСчета);
	ЗапросНомераСубконто.УстановитьПараметр("ИспользуемыеВидыСубконтоАвтоустановка",	ИспользуемыеВидыСубконтоАвтоустановка);
	ЗапросНомераСубконто.УстановитьПараметр("ИспользуемыеВидыСубконтоОтметкаНаличия",	МассивОтмечатьНаличиеВидовСубконто);
	ЗапросНомераСубконто.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Используемые счета и их виды субконто
	|//
	|ВЫБРАТЬ
	|	Ссылка.Ссылка	КАК Счет,
	|	ВидСубконто		КАК ВидСубконто,
	|	НомерСтроки		КАК НомерСубконто
	|ПОМЕСТИТЬ
	|	ТаблицаИспользуемыеСчета
	|ИЗ
	|	ПланСчетов.ЕПСБУ.ВидыСубконто
	|ГДЕ
	|	Ссылка.Ссылка В (&ИспользуемыеСчета)
	|ИНДЕКСИРОВАТЬ ПО
	|	Счет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Количество субконто у используемых счетов
	|//
	|ВЫБРАТЬ
	|	Счет					КАК Счет,
	|	КОЛИЧЕСТВО(ВидСубконто)	КАК КоличествоСубконто
	|ПОМЕСТИТЬ
	|	ТаблицаКоличествоСубконто
	|ИЗ
	|	ТаблицаИспользуемыеСчета
	|СГРУППИРОВАТЬ ПО
	|	Счет
	|ИНДЕКСИРОВАТЬ ПО
	|	Счет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Используемые счета и их виды субконто
	|//		(Финальная таблица)
	|ВЫБРАТЬ
	|	ТаблицаИспользуемыеСчета.Счет					КАК Счет,
	|	ТаблицаИспользуемыеСчета.ВидСубконто			КАК ВидСубконто,
	|	ТаблицаИспользуемыеСчета.НомерСубконто			КАК НомерСубконто,
	|	ТаблицаКоличествоСубконто.КоличествоСубконто	КАК КоличествоСубконто,
	|	ВЫБОР
	|		КОГДА ТаблицаИспользуемыеСчета.ВидСубконто В (&ИспользуемыеВидыСубконтоАвтоустановка) ТОГДА
	|			ИСТИНА
	|		ИНАЧЕ
	|			ЛОЖЬ
	|	КОНЕЦ											КАК ЭтоИспользуемыйВидСубконтоАвтоустановка,
	|		ВЫБОР
	|		КОГДА ТаблицаИспользуемыеСчета.ВидСубконто В (&ИспользуемыеВидыСубконтоОтметкаНаличия) ТОГДА
	|			ИСТИНА
	|		ИНАЧЕ
	|			ЛОЖЬ
	|	КОНЕЦ											КАК ЭтоИспользуемыйВидСубконтоОтметкаНаличия
	|ИЗ
	|	ТаблицаИспользуемыеСчета
	|	ЛЕВОЕ СОЕДИНЕНИЕ	ТаблицаКоличествоСубконто
	|		ПО	ТаблицаИспользуемыеСчета.Счет = ТаблицаКоличествоСубконто.Счет
	|;";
	
	ТаблицаНомераСубконто = ЗапросНомераСубконто.Выполнить().Выгрузить();
	
	Для Каждого СтрокаЗаполняемойТаблицы Из ЗаполняемаяТаблица Цикл
		Если СчетЭтоРеквизитТаблицы Тогда
			Счет = СтрокаЗаполняемойТаблицы[ИмяРеквизитаСчет];
		КонецЕсли;
		
		
		Если ЗначениеЗаполнено(Счет) Тогда
			Поиск = Новый Структура("Счет", Счет);
			МассивСтрокТаблицыНомерСубконто = ТаблицаНомераСубконто.НайтиСтроки(Поиск);
			Для Каждого СтрокаТаблицыНомерСубконто Из МассивСтрокТаблицыНомерСубконто Цикл
				НомерСубконто			= СтрокаТаблицыНомерСубконто["НомерСубконто"];
				ВидСубконто				= СтрокаТаблицыНомерСубконто["ВидСубконто"];
				КоличествоСубконто		= СтрокаТаблицыНомерСубконто["КоличествоСубконто"];
				
				Если СтрокаТаблицыНомерСубконто["ЭтоИспользуемыйВидСубконтоАвтоустановка"] Тогда
					ИмяРеквизитаСубконто	= ИменаРеквизитовСчетИСубконто["Субконто" + Строка(НомерСубконто)];
					
					ИмяРеквизитаЗначениеАвтоустановки = ЗначенияАвтоустановкиВТаблице.Получить(ВидСубконто);
					ЗначениеАвтоустановкиЗаданоВТекущейСтрокеТаблицы = НЕ (ИмяРеквизитаЗначениеАвтоустановки = Неопределено);
					Если ЗначениеАвтоустановкиЗаданоВТекущейСтрокеТаблицы Тогда
						ЗначениеАвтоустановки = СтрокаЗаполняемойТаблицы[ИмяРеквизитаЗначениеАвтоустановки];
					Иначе
						ЗначениеАвтоустановки = ЗначенияАвтоустановки.Получить(ВидСубконто);
					КонецЕсли;
					
					// Устанавливаем значение:
					УстановитьЗначение = (ВыполнитьАвтоустановкуЗначений = Истина) И НЕ (ЗначениеАвтоустановки = Неопределено);
					Если ВыполнитьАвтоустановкуТолькоПустыхЗначений = Истина Тогда
						УстановитьЗначение = УстановитьЗначение И НЕ ЗначениеЗаполнено(СтрокаЗаполняемойТаблицы[ИмяРеквизитаСубконто]);
					КонецЕсли;
					Если УстановитьЗначение Тогда
						СтрокаЗаполняемойТаблицы[ИмяРеквизитаСубконто] = ЗначениеАвтоустановки;
					КонецЕсли;
					
					// Обновляем флаги "Отметить":
					Если ОтмечатьЗначенияСовпадающиеСАвтоустановкой Тогда
						Поиск = Новый Структура("ИмяЭлемента", ТаблицаНастроекСчетИСубконто[НомерСубконто]["ИмяЭлемента"]);
						МассивСтрок = Форма["АвтоустановкаСубконто_ТаблицаЭлементыСубконто"].НайтиСтроки(Поиск);
						Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
							ИмяРеквизитаОтметка = СтрокаТаблицы["ИмяРеквизитаОтметить"];
							
							СтрокаЗаполняемойТаблицы[ИмяРеквизитаОтметка] = (СтрокаЗаполняемойТаблицы[ИмяРеквизитаСубконто] = ЗначениеАвтоустановки);
						КонецЦикла;
					КонецЕсли;
				КонецЕсли;
				
				// Обновляем номера субконто отмечаемых видов:
				Если СтрокаТаблицыНомерСубконто["ЭтоИспользуемыйВидСубконтоОтметкаНаличия"] Тогда
					ВидСубконтоСтрока = СоответствиеОтмечатьНаличиеВидовСубконтоСтрока.Получить(СтрокаТаблицыНомерСубконто["ВидСубконто"]);
					Если НЕ ВидСубконтоСтрока = Неопределено Тогда
						ИмяРеквизитаНомерСубконто = "АвтоустановкаСубконто_" + ИмяРеквизитаСчет + "_НомерСубконтоВида_" + ВидСубконтоСтрока;
						СтрокаЗаполняемойТаблицы[ИмяРеквизитаНомерСубконто] = НомерСубконто;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
		Иначе
			КоличествоСубконто = 0;
			Если ВызовИзФормы Тогда
				Для Каждого ВидСубконтоСтрока Из ОпцииЗаполнения["МассивОтмечатьНаличиеВидовСубконтоСтрока"] Цикл
					ИмяРеквизитаНомерСубконто = "АвтоустановкаСубконто_" + ИмяРеквизитаСчет + "_НомерСубконтоВида_" + ВидСубконтоСтрока;
					СтрокаЗаполняемойТаблицы[ИмяРеквизитаНомерСубконто] = 0;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
		// Обновляем количество субконто:
		Если ОтмечатьНезаполненныеСубконто Тогда
			ИмяРеквизитаКоличествоСубконто = "АвтоустановкаСубконто_" + ИмяРеквизитаСчет + "_КоличествоСубконто";
			СтрокаЗаполняемойТаблицы[ИмяРеквизитаКоличествоСубконто] = КоличествоСубконто;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура АвтоустановкаСубконто_ЗаполнитьТекущуюСтрокуТаблицы(Форма, ИмяРеквизитаТаблица, ЭтоРеквизитОбъекта, ТекущаяСтрока, ТаблицаНастроекСчетИСубконто, СтруктураВходныхПараметров, МассивОтмечатьНаличиеВидовСубконтоСтрока, МассивОтмечатьНаличиеВидовСубконто, ВыполнитьАвтоустановкуЗначений, ВыполнитьАвтоустановкуТолькоПустыхЗначений = Ложь)
	
	// Предполагается, что таблица ТаблицаНастроекСчетИСубконто состоит из 4 строк:
	//	[0] Описание элемента Счет
	//	[1] Описание элемента Субконто1
	//	[2] Описание элемента Субконто2
	//	[3] Описание элемента Субконто3
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "АвтоустановкаСубконто_ОтмечатьЗначенияСовпадающиеСАвтоустановкой") Тогда
		ОтмечатьЗначенияСовпадающиеСАвтоустановкой = Форма["АвтоустановкаСубконто_ОтмечатьЗначенияСовпадающиеСАвтоустановкой"];
	Иначе
		ОтмечатьЗначенияСовпадающиеСАвтоустановкой = Ложь;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "АвтоустановкаСубконто_ОтмечатьНезаполненныеСубконто") Тогда
		ОтмечатьНезаполненныеСубконто = Форма["АвтоустановкаСубконто_ОтмечатьНезаполненныеСубконто"];
	Иначе
		ОтмечатьНезаполненныеСубконто = Ложь;
	КонецЕсли;
	
	ИмяРеквизитаСчет = ТаблицаНастроекСчетИСубконто[0]["ИмяРеквизита"];
	
	СтрокаЗаполняемойТаблицы = ?(ЭтоРеквизитОбъекта,
		Форма.Объект[ИмяРеквизитаТаблица].НайтиПоИдентификатору(ТекущаяСтрока),
		Форма[ИмяРеквизитаТаблица].НайтиПоИдентификатору(ТекущаяСтрока));
		
	// Обновляем номера субконто отмечаемых видов (очищаем):
	Для Каждого ВидСубконтоСтрока Из МассивОтмечатьНаличиеВидовСубконтоСтрока Цикл
		ИмяРеквизитаНомерСубконто = "АвтоустановкаСубконто_" + ИмяРеквизитаСчет + "_НомерСубконтоВида_" + ВидСубконтоСтрока;
		СтрокаЗаполняемойТаблицы[ИмяРеквизитаНомерСубконто] = 0;
	КонецЦикла;
	
	Счет = СтруктураВходныхПараметров["Счет"];
	
	Если ЗначениеЗаполнено(Счет) Тогда
		ТаблицаВидыСубконто = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтруктураВходныхПараметров["Счет"], "ВидыСубконто");
		ВидыСубконто = ТаблицаВидыСубконто.Выгрузить().ВыгрузитьКолонку("ВидСубконто");
		КоличествоСубконто = ВидыСубконто.Количество();
			
		Для НомерСубконто = 1 По ВидыСубконто.Количество() Цикл
			СтрокаТаблицыНастроек	= ТаблицаНастроекСчетИСубконто[НомерСубконто];
			ИмяРеквизитаСубконто	= ТаблицаНастроекСчетИСубконто[НомерСубконто]["ИмяРеквизита"];
			ВидСубконто				= ВидыСубконто[НомерСубконто - 1];
			
			ИмяРеквизитаЗначениеАвтоустановки = СтруктураВходныхПараметров["ЗначенияАвтоустановкиВТаблице"].Получить(ВидСубконто);
			ЗначениеАвтоустановкиЗаданоВТекущейСтрокеТаблицы = НЕ (ИмяРеквизитаЗначениеАвтоустановки = Неопределено);
			Если ЗначениеАвтоустановкиЗаданоВТекущейСтрокеТаблицы Тогда
				ЗначениеАвтоустановки = СтрокаЗаполняемойТаблицы[ИмяРеквизитаЗначениеАвтоустановки];
			Иначе
				ЗначениеАвтоустановки = СтруктураВходныхПараметров["ЗначенияАвтоустановки"].Получить(ВидСубконто);
			КонецЕсли;
			
			// Устанавливаем значение:
			УстановитьЗначение = (ВыполнитьАвтоустановкуЗначений = Истина) И НЕ (ЗначениеАвтоустановки = Неопределено);
			Если ВыполнитьАвтоустановкуТолькоПустыхЗначений = Истина Тогда
				УстановитьЗначение = УстановитьЗначение И НЕ ЗначениеЗаполнено(СтрокаЗаполняемойТаблицы[ИмяРеквизитаСубконто]);
			КонецЕсли;
			Если УстановитьЗначение Тогда
					СтрокаЗаполняемойТаблицы[ИмяРеквизитаСубконто] = ЗначениеАвтоустановки;
			КонецЕсли;
			
			// Обновляем флаги "Отметить":
			Если ОтмечатьЗначенияСовпадающиеСАвтоустановкой Тогда
				Поиск = Новый Структура("ИмяЭлемента", СтрокаТаблицыНастроек["ИмяЭлемента"]);
				МассивСтрок = Форма["АвтоустановкаСубконто_ТаблицаЭлементыСубконто"].НайтиСтроки(Поиск);
				Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
					ИмяРеквизитаОтметка = СтрокаТаблицы["ИмяРеквизитаОтметить"];
					
					СтрокаЗаполняемойТаблицы[ИмяРеквизитаОтметка] = (СтрокаЗаполняемойТаблицы[ИмяРеквизитаСубконто] = ЗначениеАвтоустановки);
				КонецЦикла;
			КонецЕсли;
			
			// Обновляем номера субконто отмечаемых видов (устанавливаем):
			ВремИндекс = МассивОтмечатьНаличиеВидовСубконто.Найти(ВидСубконто);
			ЭтоИспользуемыйВидСубконтоОтметкаНаличия = (НЕ ВремИндекс = Неопределено);
			Если ЭтоИспользуемыйВидСубконтоОтметкаНаличия Тогда
				ВидСубконтоСтрока = МассивОтмечатьНаличиеВидовСубконтоСтрока[ВремИндекс];
				ИмяРеквизитаНомерСубконто = "АвтоустановкаСубконто_" + ИмяРеквизитаСчет + "_НомерСубконтоВида_" + ВидСубконтоСтрока;
				СтрокаЗаполняемойТаблицы[ИмяРеквизитаНомерСубконто] = НомерСубконто;
			КонецЕсли;
			
		КонецЦикла;
	Иначе
		КоличествоСубконто = 0;
		СтрокаЗаполняемойТаблицы[ТаблицаНастроекСчетИСубконто[1]["ИмяРеквизита"]] = Неопределено;
		СтрокаЗаполняемойТаблицы[ТаблицаНастроекСчетИСубконто[2]["ИмяРеквизита"]] = Неопределено;
		СтрокаЗаполняемойТаблицы[ТаблицаНастроекСчетИСубконто[3]["ИмяРеквизита"]] = Неопределено;
		
		// Обновляем флаги "Отметить":
		Если ОтмечатьЗначенияСовпадающиеСАвтоустановкой Тогда
			ИмяЭлементаСчет = ТаблицаНастроекСчетИСубконто[0]["ИмяЭлемента"];
			Поиск = Новый Структура("ИмяЭлементаСчет", ИмяЭлементаСчет);
			МассивСтрок = Форма["АвтоустановкаСубконто_ТаблицаЭлементыСубконто"].НайтиСтроки(Поиск);
			Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
				ИмяРеквизитаОтметка = СтрокаТаблицы["ИмяРеквизитаОтметить"];
				
				СтрокаЗаполняемойТаблицы[ИмяРеквизитаОтметка] = Ложь;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	// Обновляем количество субконто:
	Если ОтмечатьНезаполненныеСубконто Тогда
		ИмяРеквизитаКоличествоСубконто = "АвтоустановкаСубконто_" + ИмяРеквизитаСчет + "_КоличествоСубконто";
		СтрокаЗаполняемойТаблицы[ИмяРеквизитаКоличествоСубконто] = КоличествоСубконто;
	КонецЕсли;
	
КонецПроцедуры

Процедура АвтоустановкаСубконто_ПроверитьОбязательныйПараметр(СтруктураНастроек, ИмяПараметра, ЗначениеПараметра, Форма)
	
	ТекстОшибкаИнициализацииМеханизма = НСтр("ru='Ошибка при инициализации механизма ""Автоустановка субконто""'");
	
	СтруктураНастроек.Свойство(ИмяПараметра, ЗначениеПараметра);
	
	Если НЕ ЗначениеЗаполнено(ЗначениеПараметра) Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru='%1.
				|В настройках механизма не задан обязательный параметр ""%2"".'"),
			ТекстОшибкаИнициализацииМеханизма,
			ИмяПараметра);
			
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;
	
	Если НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма.Элементы, ЗначениеПараметра) Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru='%1.
				|На форме документа не найден элемент ""%2""'"),
			ТекстОшибкаИнициализацииМеханизма,
			ЗначениеПараметра);
			
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;
	
КонецПроцедуры

// Пытаемся использовать значение ДокументОснование, а если не получается, то Ссылка.
Функция СубконтоСФПолученные_ОпределитьЗначениеДляАвтоустановки(ДокументОбъект, ДокументОбъектСсылка = Неопределено) Экспорт
	
	Перем	ИспользованДокументОснование,
			Результат;
	
	ДокументОснованиеСсылка = ДокументОбъект["ДокументОснование"];
	Если ЗначениеЗаполнено(ДокументОснованиеСсылка) Тогда
		ПриведенноеЗначение = ПланыВидовХарактеристик.ВидыСубконто.СФПолученные.ТипЗначения.ПривестиЗначение(ДокументОснованиеСсылка);
		Если ЗначениеЗаполнено(ПриведенноеЗначение) Тогда
			Результат = ПриведенноеЗначение;
			ИспользованДокументОснование = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ИспользованДокументОснование = Истина Тогда
		Результат = ДокументОбъектСсылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СписокПостановленийДляКнигПокупокПродаж

Функция ПолучитьТаблицуПостановленийИзменяющихЗаполнениеКниги(ОбозначениеКниги)
	
	ОбщаяТаблица = ПолучитьОбщуюТаблицуПостановленийИзменяющихРегламентированныеРегистры();
	
	Поиск = Новый Структура();
	
	Поиск.Вставить(ОбозначениеКниги, Истина);
	
	МассивСтрок = ОбщаяТаблица.НайтиСтроки(Поиск);
	
	ТаблицаПостановлений = ОбщаяТаблица.Скопировать(МассивСтрок, "Представление,ДатаНачалаПрименения");
	
	Возврат ТаблицаПостановлений;
	
КонецФункции

