		|
		|Если такие новые позиции присутствуют, то Корректировочный счет-фактуру ввести нельзя.
		|Вместо этого необходимо ввести Исправительный счет-фактуру.'");
	
	// [2]. Наличие строк табличной части Материалы, препятствующих созданию КСФПолученный
	ВремТаблица = РезультатыЗапроса[2].Выгрузить();
	
	Если ВремТаблица.Количество() > 0 Тогда
		ТекстСообщения = СтрШаблон(ТекстШаблон, НСтр("ru='Материалы'"), ВремТаблица[0].НомерСтроки);
		Возврат Ложь;
	КонецЕсли;
	
	// [3]. Наличие строк табличной части ВозвратнаяТара, препятствующих созданию КСФПолученный
	ВремТаблица = РезультатыЗапроса[3].Выгрузить();
	
	Если ВремТаблица.Количество() > 0 Тогда
		ТекстСообщения = СтрШаблон(ТекстШаблон, НСтр("ru='Возвратная тара'"), ВремТаблица[0].НомерСтроки);
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ДопустимВводИСФНаОснованииПоступления(ДокументПоступления, ТекстСообщения) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ДокументПоступления) Тогда
		Возврат Истина;
	КонецЕсли;
	
	ЭтоКорректировка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументПоступления, "ЭтоКорректировка");
	
	Если НЕ ЭтоКорректировка Тогда
		ТекстСообщения = НСтр("ru='Документ-основание не является корректировкой поступления'");
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция НайтиПредыдущийСчетФактуруПоступления(ДокументПоступления) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ДокументПоступления) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(ДокументПоступления) <> Тип("ДокументСсылка.ПоступлениеМЗ") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	РеквизитыПоступления = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументПоступления, "ЭтоКорректировка,НомерКорректировки,ДокументОснование");
	
	Если НЕ РеквизитыПоступления.ЭтоКорректировка Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ОснованиеПоступления = РеквизитыПоступления.ДокументОснование;
	
	Если НЕ ЗначениеЗаполнено(ОснованиеПоступления) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	РеквизитыОснованияПоступления = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОснованиеПоступления, "ЭтоКорректировка");
	
	Если РеквизитыОснованияПоступления.ЭтоКорректировка Тогда
		Текст = "
		|ВЫБРАТЬ
		|	Ссылка,
		|	Дата,
		|	Номер,
		|	Проведен
		|ИЗ
		|	(ВЫБРАТЬ
		|		Ссылка,
		|		Дата,
		|		Номер,
		|		Проведен
		|	ИЗ
		|		Документ.КорректировочныйСчетФактураПолученный
		|	ГДЕ
		|		НЕ ПометкаУдаления
		|		И ДокументКорректировки В(&ДокументПоступления)
		|
		|	ОБЪЕДИНИТЬ ВСЕ
		|
		|	ВЫБРАТЬ
		|		Ссылка,
		|		Дата,
		|		Номер,
		|		Проведен
		|	ИЗ
		|		Документ.ИсправительныйСчетФактураПолученный
		|	ГДЕ
		|		НЕ ПометкаУдаления
		|		И ДокументКорректировки В(&ДокументПоступления)
		|	) КАК ВТ
		|УПОРЯДОЧИТЬ ПО
		|	Проведен УБЫВ,
		|	Дата УБЫВ";
		
	Иначе
		Текст = "
		|ВЫБРАТЬ
		|	Ссылка,
		|	Ссылка.Дата,
		|	Ссылка.Номер,
		|	Ссылка.Проведен
		|ИЗ
		|	Документ.СчетФактураПолученный.ДокументыОснования КАК ДокументыОснования
		|ГДЕ
		|	НЕ Ссылка.ПометкаУдаления
		|	И ДокументОснование В(&ДокументПоступления)
		|УПОРЯДОЧИТЬ ПО
		|	Ссылка.Проведен УБЫВ,
		|	Ссылка.Дата УБЫВ";
	КонецЕсли;
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ДокументПоступления", ОснованиеПоступления);
	ЗапросПоиск.Текст = Текст;
	
	ВремТаблица = ЗапросПоиск.Выполнить().Выгрузить();
	
	Если ВремТаблица.Количество() > 0 Тогда
		Возврат ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ВремТаблица[0]);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции


Функция ДокументКорректировкиОбязателенКЗаполнению(ДокументОбъект, ИмяТабличнойЧастиНФА = "СоставНФА", ИмяКолонкиНФА = "НФА") Экспорт
	
	Если НЕ ПолучитьФункциональнуюОпцию("ВестиУчетПрослеживаемыхТоваров") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	МассивПроверки = Новый Массив();
	
	Для Каждого СтрокаТаблицы Из ДокументОбъект[ИмяТабличнойЧастиНФА] Цикл
		Если ТипЗнч(СтрокаТаблицы[ИмяКолонкиНФА]) = Тип("СправочникСсылка.Номенклатура") И ЗначениеЗаполнено(СтрокаТаблицы[ИмяКолонкиНФА]) Тогда
			МассивПроверки.Добавить(СтрокаТаблицы[ИмяКолонкиНФА]);
		КонецЕсли;
	КонецЦикла;
	
	Если МассивПроверки.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЗначенияРеквизита = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(МассивПроверки, "ПрослеживаемыйТовар");
	
	Для Каждого Элемент Из ЗначенияРеквизита Цикл
		Если Элемент.Значение = Истина Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции


Функция СледуетЗаполнитьВалютныеСуммы() Экспорт
	
	Возврат ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	
КонецФункции


Функция ПолучитьСтавкуНДСПоУмолчаниюПриУСН(УчетнаяПолитика, НаДату) Экспорт
	
	ПрименяетсяУСН = УчетнаяПолитика.ПрименяетсяУСНДоходы Или УчетнаяПолитика.ПрименяетсяУСНДоходыМинусРасходы;
	
	Если Не ПрименяетсяУСН Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтавкаНалогообложенияПриУСН = УчетнаяПолитика.СтавкаНалогообложенияПриУСН;
	
	Если УчетнаяПолитика.НДСПрименяетсяОсвобождениеОтУплаты
		Или Не ЗначениеЗаполнено(СтавкаНалогообложенияПриУСН)
		Или СтавкаНалогообложенияПриУСН = Перечисления.ВидыСтавокНДС.БезНДС Тогда
		Возврат Перечисления.СтавкиНДС.БезНДС;
	КонецЕсли;
	
	Если СтавкаНалогообложенияПриУСН = Перечисления.ВидыСтавокНДС.ПониженнаяУСН Тогда
		Возврат Перечисления.СтавкиНДС.НДС5;
		
	ИначеЕсли СтавкаНалогообложенияПриУСН = Перечисления.ВидыСтавокНДС.ОбщаяУСН Тогда
		Возврат Перечисления.СтавкиНДС.НДС7;
		
	ИначеЕсли СтавкаНалогообложенияПриУСН = Перечисления.ВидыСтавокНДС.Общая Тогда
		Возврат УчетНДСКлиентСервер.ПолучитьОсновнуюСтавку(НаДату);
	КонецЕсли;
	
	Возврат Перечисления.СтавкиНДС.БезНДС;
	
КонецФункции

Функция ПолучитьНастройкиУчетаНДСУчреждения(Организация, НаДату) Экспорт
	
	НастройкиУчетаНДС = Новый Структура("
		|УчетнаяПолитика,
		|СтавкаНДСПоУмолчаниюПриУСН,
		|РазрешенВычетНалога");
	
	НастройкиУчетаНДС.УчетнаяПолитика = Новый Структура("
		|ПрименяетсяУСН,
		|СтавкаНалогообложенияПриУСН,
		|НДСПрименяетсяОсвобождениеОтУплаты");
	
	ВсяУчетнаяПолитика = Справочники.Организации.ПолучитьУчетнуюПолитику(Организация, НаДату);
	
	ЗаполнитьЗначенияСвойств(НастройкиУчетаНДС.УчетнаяПолитика, ВсяУчетнаяПолитика);
	
	НастройкиУчетаНДС.СтавкаНДСПоУмолчаниюПриУСН = ПолучитьСтавкуНДСПоУмолчаниюПриУСН(ВсяУчетнаяПолитика, НаДату);
	
	РазрешенВычетНалога = Истина;
	
	Если ВсяУчетнаяПолитика.НДСПрименяетсяОсвобождениеОтУплаты Тогда
		РазрешенВычетНалога = Ложь;
		
	ИначеЕсли ВсяУчетнаяПолитика.ПрименяетсяУСН Тогда
		РазрешенВычетНалога = (ВсяУчетнаяПолитика.СтавкаНалогообложенияПриУСН = Перечисления.ВидыСтавокНДС.Общая);
	КонецЕсли;
	
	НастройкиУчетаНДС.РазрешенВычетНалога = РазрешенВычетНалога;
	
	Возврат НастройкиУчетаНДС;
	
КонецФункции

Функция ЭтоКомиссионнаяРеализация(ПричинаНалогообложения) Экспорт
	
	Возврат (ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.АвансПолученныйКомиссионером
		ИЛИ ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.СчетФактураНаАвансОтКомитента 
		ИЛИ ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.СчетФактураНаРеализациюОтКомитента);
	
КонецФункции

Функция ЭтоКомиссионнаяЗакупкаКомиссионер(ПричинаНалогообложения) Экспорт
	
	Возврат ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.СчетФактураКомиссионераНаПокупку
		ИЛИ ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.АвансВыданныйКомиссионером
		ИЛИ ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.СчетФактураКомиссионераНаАванс;
	
КонецФункции

Функция ЭтоКомиссионнаяЗакупка(ПричинаНалогообложения) Экспорт
	
	Возврат (ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.СчетФактураНаПокупкуОтКомиссионера
		ИЛИ ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.СчетФактураНаАвансОтКомиссионера);
	
КонецФункции

Функция ПолучитьСтавкуНДСДляАвансаПоУмолчанию(Организация, НаДату) Экспорт
	
	СтавкаНДС = Неопределено;
	
	НастройкиУчетаНДС = УчетНДС.ПолучитьНастройкиУчетаНДСУчреждения(Организация, НаДату);
	
	Если НастройкиУчетаНДС.УчетнаяПолитика.НДСПрименяетсяОсвобождениеОтУплаты Тогда
		СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
		
	ИначеЕсли НастройкиУчетаНДС.УчетнаяПолитика.ПрименяетсяУСН Тогда
		СтавкаНДС = НастройкиУчетаНДС.СтавкаНДСПоУмолчаниюПриУСН;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтавкаНДС) Тогда
		СтавкаНДС = УчетНДСКлиентСервер.ПолучитьОсновнуюСтавку(НаДату);
	КонецЕсли;
	
	СтавкаНДС = УчетНДСКлиентСервер.ПолучитьРасчетнуюСтавку(СтавкаНДС);
	
	Возврат СтавкаНДС;
	
КонецФункции

#КонецОбласти

#Область Настройки

Функция ПолучитьПричиныНалогообложенияВводОстатковНДС(ЭтоВходящийНДС) Экспорт
	
	Если ЭтоВходящийНДС Тогда
		
		ДопустимыеЗначения = УчетНДСПовтИсп.ПолучитьПричиныНалогообложенияВычетВБудущем();
		
		МассивВычетСразу = УчетНДСПовтИсп.ПолучитьПричиныНалогообложенияВычетСразу();
		
		МассивРаспределениеВозможно = УчетНДСПовтИсп.ПолучитьПричиныНалогообложенияРаспределениеВозможно();
		
		Для Каждого Причина Из МассивВычетСразу Цикл
			
			РаспределениеВозможно = (МассивРаспределениеВозможно.Найти(Причина) <> Неопределено);
			
			Если РаспределениеВозможно Тогда
				
				ДопустимыеЗначения.Добавить(Причина);
				
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		
		ДопустимыеЗначения = УчетНДСПовтИсп.ПолучитьПричиныНалогообложенияНачислениеВБудущем();
		
	КонецЕсли;
	
	Возврат ДопустимыеЗначения;
	
КонецФункции

Функция ПолучитьПустуюТаблицуСведенияОПрослеживаемостиУПД() Экспорт
	
	Результат = Новый ТаблицаЗначений();
	Результат.Колонки.Добавить("НомерСтроки",					Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(20,0,ДопустимыйЗнак.Неотрицательный)));
	Результат.Колонки.Добавить("НомерТовара",					Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(29)));
	Результат.Колонки.Добавить("ЕдиницаИзмеренияКод",			Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(4)));
	Результат.Колонки.Добавить("ЕдиницаИзмеренияНаименование",	Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(255)));
	Результат.Колонки.Добавить("Количество",					Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(26,11)));
	Результат.Колонки.Добавить("КоличествоУчетное",				Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(15,3)));
	Результат.Колонки.Добавить("СтоимостьБезНДС",				Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(18,2)));
	
	Возврат Результат;
	
КонецФункции

