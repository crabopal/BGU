		|	ВходящийНДСКРаспределениюОстатки.КПССчетРасчетов		КАК КПССчетРасчетов,
		|	ВходящийНДСКРаспределениюОстатки.СчетКредита			КАК СчетКредита,
		|	ВходящийНДСКРаспределениюОстатки.ОбъектНалогообложения	КАК ОбъектНалогообложения,
		|	ВходящийНДСКРаспределениюОстатки.СтавкаНДС				КАК СтавкаНДС,
		|	ВходящийНДСКРаспределениюОстатки.ДокументКорректировки	КАК ДокументКорректировки,
		|	ВходящийНДСКРаспределениюОстатки.МестоРегистрации		КАК МестоРегистрации,
		|	ВходящийНДСКРаспределениюОстатки.СуммаБезНДСОстаток		КАК СуммаБезНДС,
		|	ВходящийНДСКРаспределениюОстатки.СуммаНДСОстаток		КАК СуммаНДС,
		|	ВЫБОР
		|		КОГДА &ЗаполнитьВалютныеСуммы ТОГДА
		|			ВходящийНДСКРаспределениюОстатки.СуммаБезНДСВалютнаяОстаток
		|		ИНАЧЕ
		|			0
		|	КОНЕЦ													КАК СуммаБезНДСВалютная,
		|	ВЫБОР
		|		КОГДА &ЗаполнитьВалютныеСуммы ТОГДА
		|			ВходящийНДСКРаспределениюОстатки.СуммаНДСВалютнаяОстаток
		|		ИНАЧЕ
		|			0
		|	КОНЕЦ													КАК СуммаНДСВалютная
		|ИЗ
		|	РегистрНакопления.ВходящийНДСКРаспределению.Остатки(
		|		&ДатаОстатков,
		|		СчетФактура В(&СчетФактура)
		|	) КАК ВходящийНДСКРаспределениюОстатки
		|;");
	
	ТекстыЗапросов.Вставить("ИсходящийНДС", "
		|////////////////////////////////////////////////////////////////////////////////
		|// Регистр накопления ИсходящийНДС
		|//
		|ВЫБРАТЬ
		|	// Выбираем все поля, кроме поля Сторно
		|	ИсходящийНДСОстатки.Организация				КАК Организация,
		|	ИсходящийНДСОстатки.СчетФактура				КАК СчетФактура,
		|	ИсходящийНДСОстатки.ПричинаНалогообложения	КАК ПричинаНалогообложения,
		|	ИсходящийНДСОстатки.КФО						КАК КФО,
		|	ИсходящийНДСОстатки.ОбъектНалогообложения	КАК ОбъектНалогообложения,
		|	ИсходящийНДСОстатки.СчетРасчетов			КАК СчетРасчетов,
		|	ИсходящийНДСОстатки.КПССчетРасчетов			КАК КПССчетРасчетов,
		|	ИсходящийНДСОстатки.СчетДебета				КАК СчетДебета,
		|	ИсходящийНДСОстатки.СтавкаНДС				КАК СтавкаНДС,
		|	ИсходящийНДСОстатки.КОСГУСчетДебета			КАК КОСГУСчетДебета,
		|	ИсходящийНДСОстатки.ДокументКорректировки	КАК ДокументКорректировки,
		|	ИсходящийНДСОстатки.МестоРегистрации		КАК МестоРегистрации,
		|	ИсходящийНДСОстатки.СуммаБезНДСОстаток		КАК СуммаБезНДС,
		|	ИсходящийНДСОстатки.СуммаНДСОстаток			КАК СуммаНДС,
		|	ВЫБОР
		|		КОГДА &ЗаполнитьВалютныеСуммы ТОГДА
		|			ИсходящийНДСОстатки.СуммаБезНДСВалютнаяОстаток
		|		ИНАЧЕ
		|			0
		|	КОНЕЦ										КАК СуммаБезНДСВалютная,
		|	ВЫБОР
		|		КОГДА &ЗаполнитьВалютныеСуммы ТОГДА
		|			ИсходящийНДСОстатки.СуммаНДСВалютнаяОстаток
		|		ИНАЧЕ
		|			0
		|	КОНЕЦ										КАК СуммаНДСВалютная
		|ИЗ
		|	РегистрНакопления.ИсходящийНДС.Остатки(
		|		&ДатаОстатков,
		|		СчетФактура В(&СчетФактура)
		|	) КАК ИсходящийНДСОстатки
		|;");
	
	ПорядокРегистров = Новый Массив();
	ТекстЗапроса = "";
	
	Для Каждого ИмяРегистра Из МассивИменРегистров Цикл
		Если ТекстыЗапросов.Свойство(ИмяРегистра, ТекстПодзапроса) Тогда
			ПорядокРегистров.Добавить(ИмяРегистра);
			
			ТекстЗапроса = ТекстЗапроса + ТекстПодзапроса;
		КонецЕсли;
	КонецЦикла;
	
	Если ПорядокРегистров.Количество() = 0 Тогда
		Возврат Новый Структура();
	КонецЕсли;
	
	// Из остатков исключаем записи движений указанного документа
	Если ЗначениеЗаполнено(ДокументСсылкаИсключитьОстатки) Тогда
		ДатаПоискаОстатков = Новый МоментВремени(ДатаОстатков, ДокументСсылкаИсключитьОстатки);
	Иначе
		ДатаПоискаОстатков = Новый МоментВремени(ДатаОстатков);
	КонецЕсли;
	
	ЗапросДвижения = Новый Запрос();
	ЗапросДвижения.УстановитьПараметр("ДатаОстатков",			ДатаПоискаОстатков);
	ЗапросДвижения.УстановитьПараметр("СчетФактура",			СчетФактура);
	ЗапросДвижения.УстановитьПараметр("ЗаполнитьВалютныеСуммы",	ЗаполнитьВалютныеСуммы);
	ЗапросДвижения.Текст = ТекстЗапроса;
	
	РезультатыЗапроса = ЗапросДвижения.ВыполнитьПакет();
	
	ОстаткиПоСчетуФактуре = Новый Структура();
	
	инд = 0;
	
	Для Каждого ИмяРегистра Из ПорядокРегистров Цикл
		ОстаткиПоСчетуФактуре.Вставить(ИмяРегистра, РезультатыЗапроса[инд].Выгрузить());
		
		инд = инд + 1;
	КонецЦикла;
	
	Возврат ОстаткиПоСчетуФактуре;
	
КонецФункции

Процедура УдалитьСтрокиСНулевымиСуммами(Таблица) Экспорт
	
	КоличествоСтрок = Таблица.Количество();
	
	Для Счетчик = 1 По КоличествоСтрок Цикл
		ИндексСтроки = КоличествоСтрок - Счетчик;
		
		СтрокаТаблицы = Таблица[ИндексСтроки];
		
		ЭтоСтрокаСНулевымиСуммами = (
			СтрокаТаблицы["СуммаБезНДС"] = 0
			И СтрокаТаблицы["СуммаНДС"] = 0
			И СтрокаТаблицы["СуммаБезНДСВалютная"] = 0
			И СтрокаТаблицы["СуммаНДСВалютная"] = 0);
			
		Если ЭтоСтрокаСНулевымиСуммами Тогда
			Таблица.Удалить(ИндексСтроки);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// 205.хА, возвращает структуру с ключами "МассивСчетов", "ТаблицаСчетов".
Функция ПолучитьТаблицуСчетовАвансовПолученных() Экспорт
	
	ЗапросСчета = Новый Запрос();
	ЗапросСчета.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Счета авансов полученных
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка		КАК Ссылка,
	|	Родитель	КАК Родитель
	|ПОМЕСТИТЬ
	|	СчетаАвансовПолученных
	|ИЗ
	|	ПланСчетов.ЕПСБУ
	|ГДЕ
	|	Код ПОДОБНО(""205.%А"")
	|	ИЛИ Код ПОДОБНО(""209.%А"")
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Счета из групп, для которых определены счета аванса полученного
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка		КАК Ссылка,
	|	Родитель	КАК Родитель
	|ПОМЕСТИТЬ
	|	СчетаИзГрупп
	|ИЗ
	|	ПланСчетов.ЕПСБУ
	|ГДЕ
	|	Родитель В (
	|		ВЫБРАТЬ
	|			Родитель
	|		ИЗ
	|			СчетаАвансовПолученных
	|	)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Таблица соответствия счетов авансов полученных и счетов расчетов
	|//
	|ВЫБРАТЬ
	|	СчетаАвансовПолученных.Ссылка	КАК СчетАванса,
	|	СчетаИзГрупп.Ссылка				КАК СчетРасчетов
	|ИЗ
	|	СчетаАвансовПолученных
	|	ЛЕВОЕ СОЕДИНЕНИЕ	СчетаИзГрупп
	|		ПО	СчетаАвансовПолученных.Родитель = СчетаИзГрупп.Родитель
	|		И НЕ СчетаАвансовПолученных.Ссылка = СчетаИзГрупп.Ссылка
	|ГДЕ
	|	НЕ СчетаИзГрупп.Ссылка ЕСТЬ NULL
	|	И СчетаИзГрупп.Ссылка.ДатаНачалаДействия = ДАТАВРЕМЯ(1,1,1)
	|;";
	
	ТаблицаСчетов = ЗапросСчета.Выполнить().Выгрузить();
	
	ВремТаблица = ТаблицаСчетов.Скопировать();
	ВремТаблица.Свернуть("СчетАванса");
	
	Результат = Новый Структура();
	Результат.Вставить("МассивСчетов", 	ВремТаблица.ВыгрузитьКолонку("СчетАванса"));
	Результат.Вставить("ТаблицаСчетов",	ТаблицаСчетов);
	
	Возврат Результат;
	
КонецФункции

// Возвращает структуру с ключами "МассивСчетов", "ТаблицаСчетов".
