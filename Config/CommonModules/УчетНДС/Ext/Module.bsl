// Устанавливает свойство НаДату по минимальной дате из даты зачета или момента времени документа.
//
// Параметры:
//	Отбор - Структура - отбор для поиска остатков авансов полученных.
//		См. НовыйОтборОстаткиВходящийНДСАвансыПолученные()
//	ДатаЗачета - Дата без времени - дата зачета аванса.
//	ДатаРегистратора - Дата со временем - дата документа-регистратора.
//	Регистратор - ДокументСсылка - документ-регистратор.
Процедура УстановитьДатуОтбораОстатковВходящийНДСАвансыПолученныеДляТаблицыСФНаОтгрузку(Отбор,
		ДатаЗачета, ДатаРегистратора, Регистратор = Неопределено) Экспорт
	
	РегистраторУказан = ЗначениеЗаполнено(Регистратор);
	
	УстановитьПоМоментуВремениРегистратора = Ложь;
	
	Если ЗначениеЗаполнено(ДатаЗачета) И ЗначениеЗаполнено(ДатаРегистратора) Тогда
		Если ДатаРегистратора <= КонецДня(ДатаЗачета) И РегистраторУказан Тогда
			УстановитьПоМоментуВремениРегистратора = Истина;
		Иначе
			НаДату = КонецДня(ДатаЗачета);
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(ДатаЗачета) Тогда
		НаДату = КонецДня(ДатаЗачета);
		
	ИначеЕсли ЗначениеЗаполнено(ДатаРегистратора) И РегистраторУказан Тогда
		УстановитьПоМоментуВремениРегистратора = Истина;
		
	Иначе
		НаДату = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Если УстановитьПоМоментуВремениРегистратора Тогда
		НаДату = Регистратор.МоментВремени();
	КонецЕсли;
	
	Отбор.НаДату = НаДату;
	
КонецПроцедуры

// По остаткам авансов полученных из регистра ВходящийНДС определяет зачеты аванса
//
// Параметры:
//	Отбор - Структура - отбор для поиска остатков авансов полученных и зачетов.
//		См. НовыйОтборОстаткиВходящийНДСАвансыПолученные()
//	ИсключитьРегистратор - ДокументСсылка - документ, движения которого нужно исключить из анализа.
Функция ПолучитьТаблицуДокументовСчетовФактурНаОтгрузку(Отбор, ИсключитьРегистратор = Неопределено) Экспорт
	
	ТаблицаОстатков = ПрочитатьОстаткиВходящийНДСАвансыПолученные(Отбор);
	
	ПараметрыПоиска = НовыйПараметрыПоискаЗачетаАванса();
	ПараметрыПоиска.Дата		= Отбор.НаДату;
	ПараметрыПоиска.Организация	= Отбор.Организация;
	ПараметрыПоиска.Ссылка		= ИсключитьРегистратор;
	
	МассивДокументов = Новый Массив();
	
	СчетаФактурыНаОтгрузку = УчетНДС.НовыйТаблицаДокументовСчетаФактурыНаОтгрузку();
	
	ТаблицаЗачтенныеАвансы = УчетНДС.РазбитьПоДатамЗачетаАвансаПолученного(ТаблицаОстатков, ПараметрыПоиска,,, СчетаФактурыНаОтгрузку);
	
	Возврат СчетаФактурыНаОтгрузку;
	
КонецФункции

// Формирует текст представления списка счетов-фактур на отгрузку для вывода на форму документа.
//
// Параметры:
//	ТаблицаСчетаФактурыНаОтгрузку - ТаблицаЗначений - таблица документов счетов-фактур на отгрузку.
//		См. функцию НовыйТаблицаДокументовСчетаФактурыНаОтгрузку().
//	МаксимальнаяДлина - Число - максимальная длина возвращаемой строки. При превышении длины строки она обрезается справа.
//
// Возвращаемое значение:
//	Строка - текст для вывода на форму документа.
Функция ПолучитьНадписьСчетаФактурыНаОтгрузку(ТаблицаСчетаФактурыНаОтгрузку, МаксимальнаяДлина = 150, ПоказатьКоличествоДокументов = Ложь) Экспорт
	
	КоличествоСтрок = ТаблицаСчетаФактурыНаОтгрузку.Количество();
	
	Если КоличествоСтрок = 0 Тогда
		Возврат НСтр("ru='<отсутствуют>'");
	Иначе
		Если ПоказатьКоличествоДокументов И КоличествоСтрок > 1 Тогда
			ПредставлениеКоличествоДокументов = СтрШаблон(
				НСтр("ru='(%1) '"),
				Формат(КоличествоСтрок, "ЧГ=0"));
		Иначе
			ПредставлениеКоличествоДокументов = "";
		КонецЕсли;
		
		Графа7а = ПредставлениеКоличествоДокументов
			+ ПолучитьПредставлениеГрафы7аКнигиПокупок(ТаблицаСчетаФактурыНаОтгрузку);
		
		Если СтрДлина(Графа7а) > МаксимальнаяДлина Тогда
			Многоточие = "...";
			
			Графа7а = Лев(Графа7а, МаксимальнаяДлина - СтрДлина(Многоточие)) + Многоточие;
		КонецЕсли;
		
		Возврат Графа7а;
	КонецЕсли;
	
КонецФункции

// Формирует текст для графы 7а "счета-фактуры на отгрузку" книги покупок.
//
// Параметры:
//	ТаблицаСчетаФактурыНаОтгрузку - ТаблицаЗначений - таблица счетов-фактур на отгрузку.
//
// Возвращаемое значение:
//	Строка - текст для вывода в печатную форму.
Функция ПолучитьПредставлениеГрафы7аКнигиПокупок(ТаблицаСчетаФактурыНаОтгрузку) Экспорт
	
	СимволПрочерка = "--";
	
	Шаблон = НСтр("ru='№%1 от %2 г.'");
	
	МассивСтрок = Новый Массив();
	
	Для Каждого СтрокаТаблицы Из ТаблицаСчетаФактурыНаОтгрузку Цикл
		Номер = ?(ЗначениеЗаполнено(СтрокаТаблицы.Номер), СтрокаТаблицы.Номер, СимволПрочерка);
		Дата = ?(ЗначениеЗаполнено(СтрокаТаблицы.Дата), Формат(СтрокаТаблицы.Дата, "ДФ=dd.MM.yyyy"), СимволПрочерка);
		
		МассивСтрок.Добавить(СтрШаблон(Шаблон, Номер, Дата));
	КонецЦикла;
	
	Возврат СтрСоединить(МассивСтрок, ";");
	
КонецФункции

