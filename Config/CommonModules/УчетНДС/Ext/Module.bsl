#Область ДокументыОстатковНДС

Функция ДокументыОстатковНДС_СообщитьЕслиИспользуетсяДляВводаОстатков(ДокументОбъект) Экспорт
	
	Если ДокументОбъект["ВводНачальныхОстатков"] Тогда
		
		ТекстСообщения = СтрШаблон(
			НСтр("ru='Отключена возможность проведения документа %1. Этот документ используется во вводе начальных остатков НДС.'"),
			ДокументОбъект.Ссылка);
		
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка);
		
		Возврат Истина;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Процедура ДокументыОстатковНДС_НастроитьФормуСервер(Форма) Экспорт
	
	ЭтоВводНачальныхОстатков = Форма.Объект.ВводНачальныхОстатков;
	
	Если ЭтоВводНачальныхОстатков Тогда
		
		ДокументыОстатковНДС_НастроитьИнформационныйЗаголовок(Форма);
		
	КонецЕсли;
	
	УчетНДСКлиентСервер.ДокументыОстатковНДС_УстановитьВидимостьИнформационногоЗаголовка(Форма, ЭтоВводНачальныхОстатков);
	
КонецПроцедуры

Процедура ДокументыОстатковНДС_НастроитьИнформационныйЗаголовок(Форма)
	
	ИменаЭлементов = УчетНДСКлиентСервер.ДокументыОстатковНДС_ИменаЭлементовИнформационногоЗаголовка();
	
	ИнформационныйЗаголовокБылНастроенРанее = (Форма.Элементы.Найти(ИменаЭлементов["Картинка"]) <> Неопределено);
	
	Если ИнформационныйЗаголовокБылНастроенРанее Тогда
		Возврат;
	КонецЕсли;
	
	ГруппаЭлементов = Форма.Элементы[ИменаЭлементов["ГруппаЭлементов"]];
	
	ГруппаЭлементов.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	ГруппаЭлементов.РастягиватьПоГоризонтали = Истина;
	ГруппаЭлементов.ЦветФона = ЦветаСтиля.ФонУправляющегоПоля;
	ГруппаЭлементов.Подсказка = "";
	ГруппаЭлементов.ОтображатьЗаголовок = Ложь;
	
	// Скрываем все служебные надписи
	Для Каждого Элемент Из ГруппаЭлементов.ПодчиненныеЭлементы Цикл
		Элемент.Видимость = Ложь;
	КонецЦикла;
	
	// Картинка
	НовыйЭлемент = Форма.Элементы.Добавить(ИменаЭлементов["Картинка"], Тип("ДекорацияФормы"), ГруппаЭлементов);
	НовыйЭлемент.Вид = ВидДекорацииФормы.Картинка;
	НовыйЭлемент.Картинка = БиблиотекаКартинок.Информация;
	
	// Надпись
	НовыйЭлемент = Форма.Элементы.Добавить(ИменаЭлементов["Надпись"], Тип("ДекорацияФормы"), ГруппаЭлементов);
	НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
	НовыйЭлемент.Заголовок = НСтр("ru='Отключена возможность проведения документа. Этот документ используется во вводе начальных остатков НДС.'");
	НовыйЭлемент.АвтоМаксимальнаяШирина = Ложь;
	
	// Кнопка "Показать"
	НовыйЭлемент = Форма.Элементы.Добавить(ИменаЭлементов["КнопкаПоказать"], Тип("ДекорацияФормы"), ГруппаЭлементов);
	НовыйЭлемент.Вид = ВидДекорацииФормы.Надпись;
	НовыйЭлемент.Заголовок = НСтр("ru='Показать'");
	НовыйЭлемент.Гиперссылка = Истина;
	НовыйЭлемент.УстановитьДействие("Нажатие", "ДокументыОстатковНДС_НажатиеКнопкиПоказать");
	НовыйЭлемент.Подсказка = НСтр("ru='Документы ввода начальных остатков НДС'");
	
	// Команда ручного сброса флажка ВводНачальныхОстатков
	НоваяКоманда = Форма.Команды.Добавить(ИменаЭлементов["КомандаСбросить"]);
	НоваяКоманда.Действие = "ДокументыОстатковНДС_ПодтвердитьСбросФлажка";
	НоваяКоманда.Заголовок = НСтр("ru='Сбросить признак ""Ввод начальных остатков""'");
	
	НовыйЭлемент = Форма.Элементы.Добавить(ИменаЭлементов["КнопкаСбросить"], Тип("КнопкаФормы"), Форма.КоманднаяПанель);
	НовыйЭлемент.ИмяКоманды = ИменаЭлементов["КомандаСбросить"];
	НовыйЭлемент.ТолькоВоВсехДействиях = Истина;
	
КонецПроцедуры

Функция ДокументыОстатковНДС_СписокДокументовДляОбработчикаОбновленияВводНачальныхОстатков(ВидДокумента) Экспорт
	
	// Обработчик обновления
	// Документы остатков НДС (8 видов)
	// Установка признака ВводНачальныхОстатков и отмена проведения
	
	ТекстШаблон = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	СчетФактура КАК Ссылка
	|ИЗ
	|	Документ.ВводНачальныхОстатков.НДС
	|ГДЕ
	|	Ссылка.Проведен
	|	И ТИПЗНАЧЕНИЯ(СчетФактура) = ТИП(Документ.[ВидДокумента])
	|	И СчетФактура <> ЗНАЧЕНИЕ(Документ.[ВидДокумента].ПустаяСсылка)
	|	И НЕ ВЫРАЗИТЬ(СчетФактура КАК Документ.[ВидДокумента]).ВводНачальныхОстатков
	|	И НЕ ВЫРАЗИТЬ(СчетФактура КАК Документ.[ВидДокумента]).ПометкаУдаления
	|;";
	
	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("ВидДокумента", ВидДокумента);
	
	ТекстЗапроса = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ТекстШаблон, ЗначенияПараметров);
	
	ЗапросПоиск = Новый Запрос(ТекстЗапроса);
	
	Возврат ЗапросПоиск.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

Процедура ДокументыОстатковНДС_ДобавитьВСписокДокументыДляОбработчикаОбновленияВводНачальныхОстатков(СписокДокументов, ВидДокумента) Экспорт
	
	// Обработчик обновления
	// Документы остатков НДС (8 видов)
	// Установка признака ВводНачальныхОстатков
	
	СписокДляОбработчика = ДокументыОстатковНДС_СписокДокументовДляОбработчикаОбновленияВводНачальныхОстатков(ВидДокумента);
	
	Для Каждого Ссылка Из СписокДляОбработчика Цикл
		
		УжеЕстьВСписке = (СписокДокументов.Найти(Ссылка) <> Неопределено);
		
		Если УжеЕстьВСписке Тогда
			Продолжить;
		КонецЕсли;
		
		СписокДокументов.Добавить(Ссылка);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ИдентификаторГосконтракта

Функция ПолучитьТаблицуДоговоров(СписокДоговоров)
	
	ТаблицаДоговоров = Новый ТаблицаЗначений();
	ТаблицаДоговоров.Колонки.Добавить("Договор",					Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ТаблицаДоговоров.Колонки.Добавить("ИдентификаторГосконтракта",	Новый ОписаниеТипов("Строка"));
	
	Поиск = Новый Структура();
	
	Для Каждого Договор Из СписокДоговоров Цикл
		Если Не ЗначениеЗаполнено(Договор) Тогда
			Продолжить;
		КонецЕсли;
		
		Поиск.Вставить("Договор", Договор);
		
		МассивСтрок = ТаблицаДоговоров.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаДоговоров.Добавить();
		НоваяСтрока.Договор = Договор;
	КонецЦикла;
	
	Возврат ТаблицаДоговоров;
	
КонецФункции

Процедура ЗаполнитьИзСправочникаГосударственныеКонтракты(ТаблицаДоговоров, СписокДоговоров)
	
	// Ссылка на государственный контракт опрелеляется аналогично ЭлектронноеАктированиеЕИС.ГосударственныйКонтрактДоговора
	// Только здесь параметром является список договоров, а не один договор

	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	ВладелецКонтракта	КАК Договор,
	|	НомерИГК			КАК ИдентификаторГосконтракта
	|ИЗ
	|	&ИмяСправочникаГосударственныеКонтракты
	|ГДЕ
	|	ВладелецКонтракта В(&СписокДоговоров)
	|	И НЕ ВладелецКонтракта = ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)";
	
	ИмяСправочникаГосударственныеКонтракты = "Справочник." + ЭлектронноеАктированиеЕИС.ИмяСправочникаГосударственныеКонтракты();
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИмяСправочникаГосударственныеКонтракты", ИмяСправочникаГосударственныеКонтракты);
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("СписокДоговоров", СписокДоговоров);
	ЗапросПоиск.Текст = ТекстЗапроса;
	
	УстановитьПривилегированныйРежим(Истина);
	ТаблицаКонтрактов = ЗапросПоиск.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	// Удалим возможные строки дублей по договору
	
	ТаблицаКонтрактовСвернутая = ТаблицаКонтрактов.Скопировать(,"Договор");
	ТаблицаКонтрактовСвернутая.Свернуть("Договор");
	
	Поиск = Новый Структура();
	
	Для Каждого СтрокаСвернутая Из ТаблицаКонтрактовСвернутая Цикл
		Поиск.Вставить("Договор", СтрокаСвернутая.Договор);
		
		МассивСтрок = ТаблицаКонтрактов.НайтиСтроки(Поиск);
		
		СтрокаТаблицыКонтрактов = МассивСтрок[0];
		
		МассивСтрок = ТаблицаДоговоров.НайтиСтроки(Поиск);
		
		СтрокаТаблицыДоговоров = МассивСтрок[0];
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицыДоговоров, СтрокаТаблицыКонтрактов, "ИдентификаторГосконтракта");
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьИзСправочникаДоговорыПоГОЗ(ТаблицаДоговоров, СписокДоговоров)
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("СписокДоговоров", СписокДоговоров);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ
	|	Ссылка												КАК Договор,
	|	ЕСТЬNULL(ГосударственныйКонтрактПоГОЗ.Код, """")	КАК ИдентификаторГосконтракта
	|ИЗ
	|	Справочник.Договоры
	|ГДЕ
	|	Ссылка В(&СписокДоговоров)
	|	И КонтрактСУчастникомГОЗ";
	
	УстановитьПривилегированныйРежим(Истина);
	ТаблицаДоговоровГОЗ = ЗапросПоиск.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Поиск = Новый Структура();
	
	Для Каждого СтрокаТаблицыГОЗ Из ТаблицаДоговоровГОЗ Цикл
		Поиск.Вставить("Договор", СтрокаТаблицыГОЗ.Договор);
		
		МассивСтрок = ТаблицаДоговоров.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТаблицыДоговоров = МассивСтрок[0];
		
		Если ЗначениеЗаполнено(СтрокаТаблицыДоговоров.ИдентификаторГосконтракта) Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицыДоговоров, СтрокаТаблицыГОЗ, "ИдентификаторГосконтракта");
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ПосредническиеУслуги

Функция ПолучитьПараметрыСводногоСчетаФактурыКомиссияПоПродаже(ДокументСсылка, ВыборкаДокПокупатели, ОбщаяКонтактнаяИнформация)
	
	Поиск = Новый Структура("Ссылка", ДокументСсылка);
	
	МассивСтрокВыборкаПокупателей = ВыборкаДокПокупатели.НайтиСтроки(Поиск);
	
	ПараметрыДляСводногоСФПоКомиссии = Новый Структура;
	
	ПредставлениеПокупателя  = "";
	АдресПокупателя 		 = "";
	Грузополучатель 		 = "";
	ИННКПППокупателя 		 = "";
	СчетаФактурыКомиссионера = "";
	
	Для Каждого СтрокаТЧ Из МассивСтрокВыборкаПокупателей Цикл
		
		ПредставлениеПокупателя = ?(ПустаяСтрока(ПредставлениеПокупателя), "", ПредставлениеПокупателя + ";") + СтрокаТЧ.ПокупательСФПредставление;
		АдресПокупателя = ?(ПустаяСтрока(АдресПокупателя), "", АдресПокупателя + ";") + ОпределитьАдресПродавцаПокупателя(СтрокаТЧ["ПокупательСФ"], ОбщаяКонтактнаяИнформация, Ложь).Представление;
		
		АдресГрузоплучателя = ОпределитьАдресПродавцаПокупателя(СтрокаТЧ["Грузополучатель"], ОбщаяКонтактнаяИнформация, Ложь).Представление;
		
		ПредставлениеГрузополучателя = СтрокаТЧ.ГрузополучательПредставление + "," + АдресГрузоплучателя;
		
		Грузополучатель = ?(ПустаяСтрока(Грузополучатель), "", Грузополучатель + ";") + ПредставлениеГрузополучателя;
		
		ПокупательКПП = Справочники.Контрагенты.ПолучитьКПП(СтрокаТЧ["ПокупательСФ"], СтрокаТЧ["ДатаСФ"]);
		
		ИННКПППокупателя = 	?(ПустаяСтрока(ИННКПППокупателя), "", ИННКПППокупателя + ";") + 
			СтрокаТЧ.ПокупательИНН + ?(ПустаяСтрока(ПокупательКПП), "", "/" + ПокупательКПП);
				
		СведениеСчетаФактуры = ?(ПустаяСтрока(СтрокаТЧ.НомерСФ), "",
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '№ %1 от %2'"),
			СтрокаТЧ.НомерСФ, Формат(СтрокаТЧ.ДатаСФ, "ДФ=dd.MM.yyyy")));
				
		СчетаФактурыКомиссионера = ?(ПустаяСтрока(СчетаФактурыКомиссионера), "", СчетаФактурыКомиссионера + ",")
			+ СведениеСчетаФактуры;
			
	КонецЦикла;
		
	ПараметрыДляСводногоСФПоКомиссии.Вставить("ПредставлениеПокупателя",	ПредставлениеПокупателя);	
	ПараметрыДляСводногоСФПоКомиссии.Вставить("АдресПокупателя", 			АдресПокупателя);	
	ПараметрыДляСводногоСФПоКомиссии.Вставить("Грузополучатель", 			Грузополучатель);	
	ПараметрыДляСводногоСФПоКомиссии.Вставить("ИННКПППокупателя", 			ИННКПППокупателя);
	ПараметрыДляСводногоСФПоКомиссии.Вставить("СчетаФактурыКомиссионера",   СчетаФактурыКомиссионера);
	
	Возврат ПараметрыДляСводногоСФПоКомиссии;
	
КонецФункции

Функция ПолучитьПараметрыСводногоСчетаФактурыКомиссияПоЗакупке(ДокументСсылка, ВыборкаДокПокупатели, ОбщаяКонтактнаяИнформация)
	
	Поиск = Новый Структура("Ссылка", ДокументСсылка);
	
	МассивСтрокВыборкаПродавцов = ВыборкаДокПокупатели.НайтиСтроки(Поиск);
	
	ПараметрыДляСводногоСФПоКомиссии = Новый Структура;
	
	ПредставлениеПродавца  = "";
	АдресПродавца 		 = "";
	Грузоотправитель 		 = "";
	ИННКПППродавца 		 = "";
	СчетаФактурыПродавцов = "";
	
	Для Каждого СтрокаТЧ Из МассивСтрокВыборкаПродавцов Цикл
		
		ПредставлениеПродавца = ?(ПустаяСтрока(ПредставлениеПродавца), "", ПредставлениеПродавца + ";") + СтрокаТЧ.ПокупательСФПредставление;
		АдресПродавца = ?(ПустаяСтрока(АдресПродавца), "", АдресПродавца + ";") + ОпределитьАдресПродавцаПокупателя(СтрокаТЧ["ПокупательСФ"], ОбщаяКонтактнаяИнформация, Ложь).Представление;
		
		АдресГрузоотправителя = ОпределитьАдресПродавцаПокупателя(СтрокаТЧ["Грузополучатель"], ОбщаяКонтактнаяИнформация, Ложь).Представление;
		
		ПредставлениеГрузоотправителя = СтрокаТЧ.ГрузополучательПредставление + "," + АдресГрузоотправителя;
		
		Если СтрокаТЧ.Грузополучатель = СтрокаТЧ.ПокупательСФ Тогда
			Грузоотправитель = ?(ПустаяСтрока(Грузоотправитель), "", Грузоотправитель + ";") + НСтр("ru='он же'");
		Иначе
			Грузоотправитель = ?(ПустаяСтрока(Грузоотправитель), "", Грузоотправитель + ";") + ПредставлениеГрузоотправителя;
		КонецЕсли;
		
		ПродавецКПП = Справочники.Контрагенты.ПолучитьКПП(СтрокаТЧ["ПокупательСФ"], СтрокаТЧ["ДатаСФ"]);
		
		ИННКПППродавца = 	?(ПустаяСтрока(ИННКПППродавца), "", ИННКПППродавца + ";") + 
			СтрокаТЧ.ПокупательИНН + ?(ПустаяСтрока(ПродавецКПП), "", "/" + ПродавецКПП);
				
		СведениеСчетаФактуры = ?(ПустаяСтрока(СтрокаТЧ.НомерСФ), "",
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '№ %1 от %2'"),
			СтрокаТЧ.НомерСФ, Формат(СтрокаТЧ.ДатаСФ, "ДФ=dd.MM.yyyy")));
				
		СчетаФактурыПродавцов = ?(ПустаяСтрока(СчетаФактурыПродавцов), "", СчетаФактурыПродавцов + ",")
			+ СведениеСчетаФактуры;
			
	КонецЦикла;
	
	ПараметрыДляСводногоСФПоКомиссии.Вставить("ПредставлениеПродавца",	ПредставлениеПродавца);
	ПараметрыДляСводногоСФПоКомиссии.Вставить("АдресПродавца", 			АдресПродавца);
	ПараметрыДляСводногоСФПоКомиссии.Вставить("Грузоотправитель", 		Грузоотправитель);
	ПараметрыДляСводногоСФПоКомиссии.Вставить("ИННКПППродавца", 		ИННКПППродавца);
	ПараметрыДляСводногоСФПоКомиссии.Вставить("СчетаФактурыПродавцов",	СчетаФактурыПродавцов);
	
	Возврат ПараметрыДляСводногоСФПоКомиссии;
	
КонецФункции

Функция ПолучитьТаблицуВозвратаАвансовПолученных_АК(Параметры)
	
	ЗапросВозвратАвансов = Новый Запрос();
	ЗапросВозвратАвансов.УстановитьПараметр("Организация",						Параметры.Организация);
	ЗапросВозвратАвансов.УстановитьПараметр("ДатаНачала",						Параметры.ДатаНачала);
	ЗапросВозвратАвансов.УстановитьПараметр("ДатаОкончания",					Параметры.ДатаОкончания);
	ЗапросВозвратАвансов.УстановитьПараметр("МассивКонтрагентов",				Параметры.МассивКонтрагентов);
	ЗапросВозвратАвансов.УстановитьПараметр("МассивДоговоров",					Параметры.МассивДоговоров);
	ЗапросВозвратАвансов.УстановитьПараметр("МассивКПС",						Параметры.МассивКПС);
	ЗапросВозвратАвансов.УстановитьПараметр("МассивКФО",						Параметры.МассивКФО);
	ЗапросВозвратАвансов.УстановитьПараметр("ЗаполнитьВалютныеСуммы",			Параметры.ЗаполнитьВалютныеСуммы);
	ЗапросВозвратАвансов.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",	Параметры.ИспользоватьУчетПоПодразделениям);
	ЗапросВозвратАвансов.УстановитьПараметр("СчетАК",							Параметры.СчетАК);
	ЗапросВозвратАвансов.УстановитьПараметр("СчетаРасчетовДляПоискаКЭК",		Параметры.СтруктураСчетовАвансов.СчетаРасчетовДляПоискаКЭК);
	ЗапросВозвратАвансов.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Возвраты авансов по дням. Вместо счета выбран КЭК
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НАЧАЛОПЕРИОДА(Период, ДЕНЬ)													КАК ДатаВозврата,
	|	ВЫРАЗИТЬ(СубконтоДт1 КАК Справочник.Контрагенты)							КАК Контрагент,
	|	ВЫРАЗИТЬ(СубконтоДт2 КАК Справочник.Договоры)								КАК Договор,
	|	ЕСТЬNULL(СубконтоДт3, НЕОПРЕДЕЛЕНО)											КАК ДокументРасчетов,
	|	КЭКДт																		КАК КЭК,
	|	КПСДт																		КАК КПССчетРасчетов,
	|	ЕСТЬNULL(ПодразделениеДт, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))	КАК Подразделение,
	|	СУММА(Сумма)																КАК Всего,
	|	СУММА(ВЫБОР
	|		КОГДА &ЗаполнитьВалютныеСуммы ТОГДА
	|			ВалютнаяСуммаДт
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ)																		КАК ВсегоВалютная
	|ПОМЕСТИТЬ
	|	ВозвратыАвансовАК
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|		&ДатаНачала,		// 1
	|		&ДатаОкончания,		// 2
	|		СчетДт = &СчетАК	// 3
	|		И	Сумма > 0
	|		И	ХарактеристикаДвиженияДт = ЗНАЧЕНИЕ(Перечисление.СобытияНДС.ВозвратАвансаПолученного)
	|		И	Организация = &Организация
	|		И	СубконтоДт1 В (&МассивКонтрагентов)
	|		И	СубконтоДт2 В (&МассивДоговоров)
	|		И	КПСДт В (&МассивКПС)
	|		И	КФО В (&МассивКФО))	КАК ДвиженияССубконто
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(Период, ДЕНЬ),
	|	ВЫРАЗИТЬ(СубконтоДт1 КАК Справочник.Контрагенты),
	|	ВЫРАЗИТЬ(СубконтоДт2 КАК Справочник.Договоры),
	|	ЕСТЬNULL(СубконтоДт3, НЕОПРЕДЕЛЕНО),
	|	КЭКДт,
	|	КПСДт,
	|	ЕСТЬNULL(ПодразделениеДт, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))
	|ИНДЕКСИРОВАТЬ ПО
	|	КЭК,
	|	ДатаВозврата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Все счета расчетов, соответствующие обнаруженным КЭК (счет АК)
	|//		
	|ВЫБРАТЬ
	|	ДатыСобытийАК.Дата												КАК Период,
	|	ДатыСобытийАК.КЭК												КАК КЭК,
	|	&СчетАК															КАК Счет,
	|	СоответствияАналитическихСчетовКЭК.Счет.ДатаНачалаДействия		КАК ДатаНачалаДействия
	|ПОМЕСТИТЬ
	|	ВсеСчетаРасчетовАК
	|ИЗ
	|	РегистрСведений.СоответствияАналитическихСчетовКЭК	КАК СоответствияАналитическихСчетовКЭК
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|			(ВЫБРАТЬ
	|				КЭК				КАК КЭК,
	|				ДатаВозврата	КАК Дата
	|			ИЗ
	|				ВозвратыАвансовАК
	|			ГДЕ
	|				КЭК <> ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)
	|			)	КАК	ДатыСобытийАК
	|		ПО	СоответствияАналитическихСчетовКЭК.КЭК = ДатыСобытийАК.КЭК
	|		И	СоответствияАналитическихСчетовКЭК.Счет.ДатаНачалаДействия <= ДатыСобытийАК.Дата
	|		И	(СоответствияАналитическихСчетовКЭК.Счет.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ ДатыСобытийАК.Дата <= СоответствияАналитическихСчетовКЭК.Счет.ДатаОкончанияДействия)
	|		И	СоответствияАналитическихСчетовКЭК.Счет В(&СчетаРасчетовДляПоискаКЭК)
	|ИНДЕКСИРОВАТЬ ПО
	|	КЭК,
	|	ДатаНачалаДействия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Выбираемые даты счетов расчетов (счет АК)
	|//		
	|ВЫБРАТЬ
	|	Период							КАК Период,
	|	КЭК								КАК КЭК,
	|	МАКСИМУМ(ДатаНачалаДействия)	КАК ДатаНачалаДействия
	|ПОМЕСТИТЬ
	|	ВыбираемыеДатыСчетовРасчетовАК
	|ИЗ
	|	ВсеСчетаРасчетовАК
	|СГРУППИРОВАТЬ ПО
	|	Период,
	|	КЭК
	|ИНДЕКСИРОВАТЬ ПО
	|	КЭК,
	|	ДатаНачалаДействия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Выбираемые счета расчетов, соответствующие обнаруженным КЭК (счет АК)
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВсеСчетаРасчетовАК.Период			КАК Период,
	|	ВсеСчетаРасчетовАК.КЭК				КАК КЭК,
	|	МАКСИМУМ(ВсеСчетаРасчетовАК.Счет)	КАК Счет
	|ПОМЕСТИТЬ
	|	СчетаРасчетовАК
	|ИЗ
	|	ВсеСчетаРасчетовАК
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	ВыбираемыеДатыСчетовРасчетовАК
	|		ПО	ВсеСчетаРасчетовАК.КЭК = ВыбираемыеДатыСчетовРасчетовАК.КЭК
	|		И	ВсеСчетаРасчетовАК.ДатаНачалаДействия = ВыбираемыеДатыСчетовРасчетовАК.ДатаНачалаДействия
	|СГРУППИРОВАТЬ ПО
	|	ВсеСчетаРасчетовАК.Период,
	|	ВсеСчетаРасчетовАК.КЭК
	|ИНДЕКСИРОВАТЬ ПО
	|	КЭК,
	|	Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [4]. Возвраты авансов по дням. КЭК заменен на счет расчетов, действующий на дату возврата
	|//
	|ВЫБРАТЬ
	|	ВозвратыАвансовАК.ДатаВозврата											КАК ДатаВозврата,
	|	ВозвратыАвансовАК.Контрагент											КАК Контрагент,
	|	ВозвратыАвансовАК.Договор												КАК Договор,
	|	ВозвратыАвансовАК.ДокументРасчетов										КАК ДокументРасчетов,
	|	ЕСТЬNULL(СчетаРасчетовАК.Счет, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка))	КАК СчетРасчетов,
	|	ВозвратыАвансовАК.КПССчетРасчетов										КАК КПССчетРасчетов,
	|	ВЫБОР
	|		КОГДА СчетаРасчетовАК.Счет ЕСТЬ NULL ТОГДА
	|			ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|		КОГДА СчетаРасчетовАК.Счет.УчетПоПодразделениям ТОГДА
	|			Подразделение
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ																	КАК Подразделение,
	|	ВозвратыАвансовАК.Всего													КАК Всего,
	|	ВозвратыАвансовАК.ВсегоВалютная											КАК ВсегоВалютная
	|ИЗ
	|	ВозвратыАвансовАК
	|	ЛЕВОЕ СОЕДИНЕНИЕ	СчетаРасчетовАК
	|		ПО	ВозвратыАвансовАК.КЭК = СчетаРасчетовАК.КЭК
	|		И	ВозвратыАвансовАК.ДатаВозврата = СчетаРасчетовАК.Период
	|УПОРЯДОЧИТЬ ПО
	|	ДатаВозврата
	|;";
	
	Возврат ЗапросВозвратАвансов.Выполнить().Выгрузить();
	
КонецФункции

Функция ПолучитьТаблицуЗачетаАвансовПолученных_АК(Параметры)
	
	ЗапросАвансы = Новый Запрос();
	ЗапросАвансы.УстановитьПараметр("ДатаНачала",				Параметры.ДатаНачала);
	ЗапросАвансы.УстановитьПараметр("ДатаОкончания",			Параметры.ДатаОкончания);
	ЗапросАвансы.УстановитьПараметр("Организация",				Параметры.Организация);
	ЗапросАвансы.УстановитьПараметр("ДокументСсылка",			Параметры.ДокументСсылка);
	ЗапросАвансы.УстановитьПараметр("МассивДоговоров",			Параметры.МассивДоговоров);
	ЗапросАвансы.УстановитьПараметр("МассивКонтрагентов",		Параметры.МассивКонтрагентов);
	ЗапросАвансы.УстановитьПараметр("МассивКФО",				Параметры.МассивКФО);
	ЗапросАвансы.УстановитьПараметр("МассивКПС",				Параметры.МассивКПС);
	ЗапросАвансы.УстановитьПараметр("ЗаполнитьВалютныеСуммы",	Параметры.ЗаполнитьВалютныеСуммы);
	ЗапросАвансы.УстановитьПараметр("СчетАК",					Параметры.СчетАК);
	
	ЗапросАвансы.УстановитьПараметр("ИсключаемыеТипыРегистратора", Параметры.ИсключаемыеТипыРегистратора_Зачеты);
	
	ЗапросАвансы.УстановитьПараметр("СчетаРасчетовДляПоискаКЭК",Параметры.СтруктураСчетовАвансов.СчетаРасчетовДляПоискаКЭК);
	
	ЗапросАвансы.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Зачеты авансов по дням. Вместо счета выбран КЭК
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НАЧАЛОПЕРИОДА(Период, ДЕНЬ)													КАК ДатаЗачета,
	|	ВЫРАЗИТЬ(СубконтоДт1 КАК Справочник.Контрагенты)							КАК Контрагент,
	|	ВЫРАЗИТЬ(СубконтоДт2 КАК Справочник.Договоры)								КАК Договор,
	|	ЕСТЬNULL(СубконтоДт3, НЕОПРЕДЕЛЕНО)											КАК ДокументРасчетов,
	|	КЭКДт																		КАК КЭК,
	|	КПСДт																		КАК КПССчетРасчетов,
	|	ЕСТЬNULL(ПодразделениеДт, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))	КАК Подразделение,
	|	СУММА(Сумма)																КАК Всего,
	|	СУММА(ВЫБОР
	|		КОГДА &ЗаполнитьВалютныеСуммы ТОГДА
	|			ВалютнаяСуммаДт
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ)																		КАК ВсегоВалютная
	|ПОМЕСТИТЬ
	|	ЗачетыАвансовАК
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|		&ДатаНачала,		// 1
	|		&ДатаОкончания,		// 2
	|		СчетДт = &СчетАК	// 3
	|		И	Сумма > 0
	|		И	ХарактеристикаДвиженияДт <> ЗНАЧЕНИЕ(Перечисление.СобытияНДС.ВозвратАвансаПолученного)
	|		И	Организация = &Организация
	|		И	СубконтоДт1 В (&МассивКонтрагентов)
	|		И	СубконтоДт2 В (&МассивДоговоров)
	|		И	КПСДт В (&МассивКПС)
	|		И	КФО В (&МассивКФО)
	|		И	НЕ ТИПЗНАЧЕНИЯ(Регистратор) В(&ИсключаемыеТипыРегистратора)
	|	)	КАК ДвиженияССубконто
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(Период, ДЕНЬ),
	|	ВЫРАЗИТЬ(СубконтоДт1 КАК Справочник.Контрагенты),
	|	ВЫРАЗИТЬ(СубконтоДт2 КАК Справочник.Договоры),
	|	ЕСТЬNULL(СубконтоДт3, НЕОПРЕДЕЛЕНО),
	|	КЭКДт,
	|	КПСДт,
	|	ЕСТЬNULL(ПодразделениеДт, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))
	|ИНДЕКСИРОВАТЬ ПО
	|	КЭК,
	|	ДатаЗачета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Все счета расчетов, соответствующие обнаруженным КЭК (счет АК)
	|//		
	|ВЫБРАТЬ
	|	ДатыСобытийАК.Дата												КАК Период,
	|	ДатыСобытийАК.КЭК												КАК КЭК,
	|	&СчетАК															КАК Счет,
	|	СоответствияАналитическихСчетовКЭК.Счет.ДатаНачалаДействия		КАК ДатаНачалаДействия
	|ПОМЕСТИТЬ
	|	ВсеСчетаРасчетовАК
	|ИЗ
	|	РегистрСведений.СоответствияАналитическихСчетовКЭК	КАК СоответствияАналитическихСчетовКЭК
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
	|			(ВЫБРАТЬ
	|				КЭК			КАК КЭК,
	|				ДатаЗачета	КАК Дата
	|			ИЗ
	|				ЗачетыАвансовАК
	|			ГДЕ
	|				КЭК <> ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)
	|			)	КАК	ДатыСобытийАК
	|		ПО	СоответствияАналитическихСчетовКЭК.КЭК = ДатыСобытийАК.КЭК
	|		И	СоответствияАналитическихСчетовКЭК.Счет.ДатаНачалаДействия <= ДатыСобытийАК.Дата
	|		И	(СоответствияАналитическихСчетовКЭК.Счет.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ ДатыСобытийАК.Дата <= СоответствияАналитическихСчетовКЭК.Счет.ДатаОкончанияДействия)
	|		И	СоответствияАналитическихСчетовКЭК.Счет В(&СчетаРасчетовДляПоискаКЭК)
	|ИНДЕКСИРОВАТЬ ПО
	|	КЭК,
	|	ДатаНачалаДействия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Выбираемые даты счетов расчетов (счет АП)
	|//		
	|ВЫБРАТЬ
	|	Период							КАК Период,
	|	КЭК								КАК КЭК,
	|	МАКСИМУМ(ДатаНачалаДействия)	КАК ДатаНачалаДействия
	|ПОМЕСТИТЬ
	|	ВыбираемыеДатыСчетовРасчетовАК
	|ИЗ
	|	ВсеСчетаРасчетовАК
	|СГРУППИРОВАТЬ ПО
	|	Период,
	|	КЭК
	|ИНДЕКСИРОВАТЬ ПО
	|	КЭК,
	|	ДатаНачалаДействия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Выбираемые счета расчетов, соответствующие обнаруженным КЭК (счет АП)
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВсеСчетаРасчетовАК.Период			КАК Период,
	|	ВсеСчетаРасчетовАК.КЭК				КАК КЭК,
	|	МАКСИМУМ(ВсеСчетаРасчетовАК.Счет)	КАК Счет
	|ПОМЕСТИТЬ
	|	СчетаРасчетовАК
	|ИЗ
	|	ВсеСчетаРасчетовАК
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	ВыбираемыеДатыСчетовРасчетовАК
	|		ПО	ВсеСчетаРасчетовАК.КЭК = ВыбираемыеДатыСчетовРасчетовАК.КЭК
	|		И	ВсеСчетаРасчетовАК.ДатаНачалаДействия = ВыбираемыеДатыСчетовРасчетовАК.ДатаНачалаДействия
	|СГРУППИРОВАТЬ ПО
	|	ВсеСчетаРасчетовАК.Период,
	|	ВсеСчетаРасчетовАК.КЭК
	|ИНДЕКСИРОВАТЬ ПО
	|	КЭК,
	|	Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [4]. Зачеты авансов по дням. КЭК заменен на счет расчетов, действующий на дату зачета
	|//
	|ВЫБРАТЬ
	|	ЗачетыАвансовАК.ДатаЗачета												КАК ДатаЗачета,
	|	ЗачетыАвансовАК.Контрагент												КАК Контрагент,
	|	ЗачетыАвансовАК.Договор													КАК Договор,
	|	ЗачетыАвансовАК.ДокументРасчетов										КАК ДокументРасчетов,
	|	ЕСТЬNULL(СчетаРасчетовАК.Счет, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка))	КАК СчетРасчетов,
	|	ЗачетыАвансовАК.КПССчетРасчетов											КАК КПССчетРасчетов,
	|	ВЫБОР
	|		КОГДА СчетаРасчетовАК.Счет ЕСТЬ NULL ТОГДА
	|			ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|		КОГДА СчетаРасчетовАК.Счет.УчетПоПодразделениям ТОГДА
	|			Подразделение
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ																	КАК Подразделение,
	|	ЗачетыАвансовАК.Всего													КАК Всего,
	|	ЗачетыАвансовАК.ВсегоВалютная											КАК ВсегоВалютная
	|ИЗ
	|	ЗачетыАвансовАК
	|	ЛЕВОЕ СОЕДИНЕНИЕ	СчетаРасчетовАК
	|		ПО	ЗачетыАвансовАК.КЭК = СчетаРасчетовАК.КЭК
	|		И	ЗачетыАвансовАК.ДатаЗачета = СчетаРасчетовАК.Период
	|УПОРЯДОЧИТЬ ПО
	|	ДатаЗачета
	|;";
	
	Возврат ЗапросАвансы.Выполнить().Выгрузить();
	
КонецФункции

#КонецОбласти

#Область ДокументыОбОтгрузке

Функция ПолучитьСведенияДокументыОбОтгрузкеПечать(Шапка, ТаблицаСоставНФА, Данные, СтруктураНомераСчетаФактуры, ЭтоУПД)
	
	Ссылка = Шапка.ДокСсылка;
	
	Поиск = Новый Структура("Ссылка", Ссылка);
	ТаблицаДокументыОбОтгрузке = Данные.ОбщаяТаблицаДокументыОбОтгрузке.Скопировать(Поиск);
	
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		Таблица = Документы.СчетФактураВыданный.ПолучитьПрименяемуюТаблицуДокументыОбОтгрузке(Шапка, ТаблицаСоставНФА, ТаблицаДокументыОбОтгрузке, СтруктураНомераСчетаФактуры, ЭтоУПД);
		
	ИначеЕсли ТипЗнч(Ссылка) = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный") Тогда
		Таблица = Документы.ИсправительныйСчетФактураВыданный.ПолучитьПрименяемуюТаблицуДокументыОбОтгрузке(Шапка, ТаблицаСоставНФА, ТаблицаДокументыОбОтгрузке, СтруктураНомераСчетаФактуры, ЭтоУПД);
		
	Иначе
		Возврат "";
	КонецЕсли;
	
	Возврат ПолучитьПредставлениеСтроки5а(Таблица, Шапка.Дата);
	
КонецФункции

#КонецОбласти

#Область ЦепочкиДокументовСчетовФактур

Процедура ОбновитьИндикаторыЦепочкиДокументовНаФормеДокумента(ФормаДокумента, ДанныеЦепочки, ТаблицаПоследующихДокументов)
	
	// Индикатор "Циклические ссылки"
	Если ФормаДокумента.Элементы.Найти("ГруппаЦиклическиеСсылки") <> Неопределено Тогда
		ДанныеОшибкиЦиклическиеСсылки = ПолучитьДанныеОшибкиЦиклическиеСсылки(ДанныеЦепочки.СписокОшибок);
		
		ОбнаруженыЦиклическиеСсылки = ДанныеОшибкиЦиклическиеСсылки <> Неопределено;
		
		Если ОбнаруженыЦиклическиеСсылки Тогда
			ТекстПодсказки = ДанныеОшибкиЦиклическиеСсылки.ТекстПодсказки;
		Иначе
			ТекстПодсказки = "";
		КонецЕсли;
		
		ФормаДокумента.Элементы.ГруппаЦиклическиеСсылки.Видимость = ОбнаруженыЦиклическиеСсылки;
		ФормаДокумента.Элементы.НадписьЦиклическиеСсылки.РасширеннаяПодсказка.Заголовок = ТекстПодсказки;
	КонецЕсли;
	
	// Индикатор "Последующие документы"
	Если ФормаДокумента.Элементы.Найти("ГруппаПоследующиеДокументы") <> Неопределено Тогда
		ОбнаруженыПоследующиеДокументы = (ТаблицаПоследующихДокументов.Количество() > 0);
		
		Тексты = СоставитьНадписиОПоследующихДокументах(ТаблицаПоследующихДокументов);
		
		ФормаДокумента.Элементы.ГруппаПоследующиеДокументы.Видимость = ОбнаруженыПоследующиеДокументы;
		ФормаДокумента.Элементы.НадписьПоследующиеДокументы.Заголовок = Тексты.ТекстНадписи;
		ФормаДокумента.Элементы.НадписьПоследующиеДокументы.РасширеннаяПодсказка.Заголовок = Тексты.ТекстПодсказки;
	КонецЕсли;
	
КонецПроцедуры

Функция НовыйРезультатыДиагностикиЦепочкиДокументовНаФормеДокумента()
	
	РезультатыДиагностики = Новый Структура();
	РезультатыДиагностики.Вставить("ОбнаруженыПоследующиеДокументы", Ложь);
	РезультатыДиагностики.Вставить("ОбнаруженыЦиклическиеСсылки", Ложь);
	
	Возврат РезультатыДиагностики;
	
КонецФункции

Функция ПрочитатьЦепочкуДокументовВСторонуНачала(ДокументОбъект, ЧитатьПомеченныеНаУдаление = Ложь)
	
	СведенияЦепочкиДокументов = Новый Структура();
	СведенияЦепочкиДокументов.Вставить("ТаблицаДокументов", НовыйТаблицаДокументовЦепочки());
	СведенияЦепочкиДокументов.Вставить("СписокОшибок", Новый Массив());
	
	НастройкиЧитаемыхРеквизитов = НовыйНастройкиЧитаемыхРеквизитовДокументовЦепочки();
	
	ТекущийДокумент = ДокументОбъект;
	
	НоваяСтрока = СведенияЦепочкиДокументов.ТаблицаДокументов.Добавить();
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущийДокумент);
	
	ТипСсылки = ТипЗнч(ТекущийДокумент.Ссылка);
	
	ЭтоИСФ = (ТипСсылки = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный")
		Или ТипСсылки = Тип("ДокументСсылка.ИсправительныйСчетФактураПолученный"));
	
	ЭтоКСФ = (ТипСсылки = Тип("ДокументСсылка.КорректировочныйСчетФактураВыданный")
		Или ТипСсылки = Тип("ДокументСсылка.КорректировочныйСчетФактураПолученный"));
	
	Если Не ЭтоИСФ И Не ЭтоКСФ Тогда
		Возврат СведенияЦепочкиДокументов;
	КонецЕсли;
	
	ОснованиеСсылка = ТекущийДокумент.ДокументОснование;
	
	ПоискДокумента = Новый Структура("Ссылка");
	
	// Идем в сторону начала цепочки (корня дерева).
	Пока ЗначениеЗаполнено(ОснованиеСсылка) Цикл
		ПоискДокумента.Ссылка = ОснованиеСсылка;
		
		МассивСтрок = СведенияЦепочкиДокументов.ТаблицаДокументов.НайтиСтроки(ПоискДокумента);
		
		Если МассивСтрок.Количество() > 0 Тогда
			Ссылка1 = ТекущийДокумент.Ссылка;
			Ссылка2 = ОснованиеСсылка;
			
			Если Ссылка1 = Ссылка2 Тогда
				ТекстСообщения = СтрШаблон(
					НСтр("ru='Документ %1 указан как собственный документ-основание, и таким образом образует циклические ссылки в цепочке документов счетов-фактур.'"),
					Ссылка1);
				
				ТекстПодсказки = СтроковыеФункции.ФорматированнаяСтрока(
					НСтр("ru='Документ <a href=""%1"">%2</a>
					|указан как собственный документ-основание, и таким образом образует циклические ссылки в цепочке документов счетов-фактур.'"),
					ПолучитьНавигационнуюСсылку(Ссылка1), Строка(Ссылка1));
			Иначе
				ТекстСообщения = СтрШаблон(
					НСтр("ru='Документ %1 ссылается на документ %2, и таким образом образует циклические ссылки в цепочке документов счетов-фактур.'"),
					Ссылка1,
					Ссылка2);
				
				ТекстПодсказки = СтроковыеФункции.ФорматированнаяСтрока(
					НСтр("ru='Документ <a href=""%1"">%2</a>
					|ссылается на документ <a href=""%3"">%4</a>
					|и таким образом образует циклические ссылки в цепочке документов счетов-фактур.'"),
					ПолучитьНавигационнуюСсылку(Ссылка1), Строка(Ссылка1),
					ПолучитьНавигационнуюСсылку(Ссылка2), Строка(Ссылка2));
			КонецЕсли;
			
			ДанныеОшибки = НовыйДанныеОшибкиЦиклическиеСсылки();
			
			ДанныеОшибки.Ссылка1 = Ссылка1;
			ДанныеОшибки.Ссылка2 = Ссылка2;
			ДанныеОшибки.ТекстСообщения = ТекстСообщения;
			ДанныеОшибки.ТекстПодсказки = ТекстПодсказки;
			
			ВидОшибки = НовыйВидОшибкиЦепочкиДокументов();
			
			ВидОшибки.Обозначение = ОбозначениеВидаОшибкиЦиклическиеСсылки();
			ВидОшибки.Представление = НСтр("ru='Циклические ссылки'");
			ВидОшибки.Данные = ДанныеОшибки;
			
			СведенияЦепочкиДокументов.СписокОшибок.Добавить(ВидОшибки);
			
			Прервать;
		КонецЕсли;
		
		ТипОснования = ТипЗнч(ОснованиеСсылка);
		
		ЭтоИСФ = (ТипОснования = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный")
			Или ТипОснования = Тип("ДокументСсылка.ИсправительныйСчетФактураПолученный"));
			
		ЭтоКСФ = (ТипОснования = Тип("ДокументСсылка.КорректировочныйСчетФактураВыданный")
			Или ТипОснования = Тип("ДокументСсылка.КорректировочныйСчетФактураПолученный"));
			
		Если ЭтоИСФ Тогда
			ЧитаемыеРеквизиты = НастройкиЧитаемыхРеквизитов.ИСФ;
			
		ИначеЕсли ЭтоКСФ Тогда
			ЧитаемыеРеквизиты = НастройкиЧитаемыхРеквизитов.КСФ;
			
		Иначе
			ЧитаемыеРеквизиты = НастройкиЧитаемыхРеквизитов.СФ;
		КонецЕсли;
		
		ТекущийДокумент = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОснованиеСсылка, ЧитаемыеРеквизиты);
		
		Если Не ЧитатьПомеченныеНаУдаление И ТекущийДокумент.ПометкаУдаления Тогда
			Прервать;
		КонецЕсли;
		
		НоваяСтрока = СведенияЦепочкиДокументов.ТаблицаДокументов.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущийДокумент);
		
		Если Не ЭтоИСФ И Не ЭтоКСФ Тогда
			Прервать;
		КонецЕсли;
		
		ОснованиеСсылка = ТекущийДокумент.ДокументОснование;
	КонецЦикла;
	
	Возврат СведенияЦепочкиДокументов;
	
КонецФункции

Функция ПрочитатьПоследующиеДокументы(ДокументОбъект, ЧитатьПомеченныеНаУдаление = Ложь)
	
	ТаблицаДокументов = НовыйТаблицаДокументовЦепочки();
	
	Если Не ЗначениеЗаполнено(ДокументОбъект.Ссылка) Тогда
		Возврат ТаблицаДокументов;
	КонецЕсли;
	
	НастройкиЧитаемыхРеквизитов = НовыйНастройкиЧитаемыхРеквизитовДокументовЦепочки();
	
	ТекстШаблон = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	%1
	|ИЗ
	|	Документ.%2
	|ГДЕ
	|	ДокументОснование В(&СписокОснований)
	|	И %3";
	
	ИменаДокументов = СтрРазделить("ИсправительныйСчетФактураВыданный,ИсправительныйСчетФактураПолученный,"
		+ "КорректировочныйСчетФактураВыданный,КорректировочныйСчетФактураПолученный", ", ", Ложь);
		
	Тексты = Новый Массив();
	
	Если ЧитатьПомеченныеНаУдаление Тогда
		Условие = "ИСТИНА";
	Иначе
		Условие = "НЕ ПометкаУдаления";
	КонецЕсли;
	
	Для Каждого ИмяДокумента Из ИменаДокументов Цикл
		ЭтоИСФ = (ИмяДокумента = "ИсправительныйСчетФактураВыданный"
			Или ИмяДокумента = "ИсправительныйСчетФактураПолученный");
			
		ЭтоКСФ = (ИмяДокумента = "КорректировочныйСчетФактураВыданный"
			Или ИмяДокумента = "КорректировочныйСчетФактураПолученный");
			
		Если ЭтоИСФ Тогда
			ЧитаемыеРеквизиты = НастройкиЧитаемыхРеквизитов.ИСФ;
			
		ИначеЕсли ЭтоКСФ Тогда
			ЧитаемыеРеквизиты = НастройкиЧитаемыхРеквизитов.КСФ;
		Иначе
			Продолжить;
		КонецЕсли;
		
		Тексты.Добавить(СтрШаблон(ТекстШаблон, ЧитаемыеРеквизиты, ИмяДокумента, Условие));
	КонецЦикла;
	
	Текст = СтрСоединить(Тексты, ОбщегоНазначения.РазделительПакетаЗапросов());
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("СписокОснований", ДокументОбъект.Ссылка);
	ЗапросПоиск.Текст = Текст;
	
	РезультатыЗапроса = ЗапросПоиск.ВыполнитьПакет();
	
	Индекс = 0;
	
	Для Каждого ИмяДокумента Из ИменаДокументов Цикл
		Выборка = РезультатыЗапроса[Индекс].Выбрать();
		
		Пока Выборка.Следующий() Цикл
			НоваяСтрока = ТаблицаДокументов.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		КонецЦикла;
		
		Индекс = Индекс + 1;
	КонецЦикла;
	
	ТаблицаДокументов.Сортировать("Дата ВОЗР");
	
	Возврат ТаблицаДокументов;
	
КонецФункции

Функция СоставитьНадписиОПоследующихДокументах(ТаблицаДокументов)
	
	КоличествоИСФ = 0;
	КоличествоКСФ = 0;
	
	ПереводСтроки = "
		|";
	
	МассивСтрок = Новый Массив();
	
	Для Каждого СтрокаТаблицы Из ТаблицаДокументов Цикл
		Ссылка = СтрокаТаблицы.Ссылка;
		ТипДокумента = ТипЗнч(Ссылка);
		
		Если (ТипДокумента = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный")
			Или ТипДокумента = Тип("ДокументСсылка.ИсправительныйСчетФактураПолученный")) Тогда
			КоличествоИСФ = КоличествоИСФ + 1;
		КонецЕсли;
		
		Если (ТипДокумента = Тип("ДокументСсылка.КорректировочныйСчетФактураВыданный")
			Или ТипДокумента = Тип("ДокументСсылка.КорректировочныйСчетФактураПолученный")) Тогда
			КоличествоКСФ = КоличествоКСФ + 1;
		КонецЕсли;
		
		ЭтоПоследнийДокумент = (ТаблицаДокументов.Индекс(СтрокаТаблицы) = ТаблицаДокументов.Количество() - 1);
		
		ТекстСтроки = Строка(Ссылка) + ?(ЭтоПоследнийДокумент, "", ПереводСтроки);
		
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока(ТекстСтроки,,,, ПолучитьНавигационнуюСсылку(Ссылка)));
	КонецЦикла;
	
	Если КоличествоИСФ = 0 И КоличествоКСФ = 0 Тогда
		ТекстНадписи = НСтр("ru='Отсутствуют последующие корректировки и исправления'");
		
		ПерваяСтрокаСообщения = ТекстНадписи;
		
	ИначеЕсли КоличествоИСФ > 0 И КоличествоКСФ > 0 Тогда
		ТекстНадписи = НСтр("ru='Обнаружены последующие корректировки и исправления'");
		
		ПерваяСтрокаСообщения = НСтр("ru='Обнаружены последующие корректировки и исправления:'");
		
	ИначеЕсли КоличествоИСФ > 0 Тогда
		Если КоличествоИСФ = 1 Тогда
			ТекстНадписи = НСтр("ru='Обнаружено последующее исправление'");
			
			ПерваяСтрокаСообщения = НСтр("ru='Обнаружено последующее исправление:'");
		Иначе // >1
			ТекстНадписи = НСтр("ru='Обнаружены последующие исправления'");
			
			ПерваяСтрокаСообщения = НСтр("ru='Обнаружены последующие исправления:'");
		КонецЕсли;
		
	ИначеЕсли КоличествоКСФ > 0 Тогда
		Если КоличествоКСФ = 1 Тогда
			ТекстНадписи = НСтр("ru='Обнаружена последующая корректировка'");
			
			ПерваяСтрокаСообщения = НСтр("ru='Обнаружена последующая корректировка:'");
		Иначе // >1
			ТекстНадписи = НСтр("ru='Обнаружены последующие корректировки'");
			
			ПерваяСтрокаСообщения = НСтр("ru='Обнаружены последующие корректировки:'");
		КонецЕсли;
		
	КонецЕсли;
	
	МассивСтрок.Вставить(0, ПерваяСтрокаСообщения + ПереводСтроки);
	
	// Не применяется СтроковыеФункции.ФорматированнаяСтрока(),
	// т.к. потенциально количество документов превышает количество параметров этой функции (5 параметров).
	ТекстПодсказки = Новый ФорматированнаяСтрока(МассивСтрок);
	
	Надписи = Новый Структура();
	Надписи.Вставить("ТекстНадписи", ТекстНадписи);
	Надписи.Вставить("ТекстПодсказки", ТекстПодсказки);
	
	Возврат Надписи;
	
КонецФункции

Функция НовыйТаблицаДокументовЦепочки()
	
	ТипБулево = Новый ОписаниеТипов("Булево");
	
	ТаблицаДокументов = Новый ТаблицаЗначений();
	ТаблицаДокументов.Колонки.Добавить("Ссылка");
	ТаблицаДокументов.Колонки.Добавить("ДокументОснование");
	ТаблицаДокументов.Колонки.Добавить("ИсправляемыйДокумент");
	ТаблицаДокументов.Колонки.Добавить("Проведен", Новый ОписаниеТипов("Булево"));
	ТаблицаДокументов.Колонки.Добавить("ПометкаУдаления", Новый ОписаниеТипов("Булево"));
	ТаблицаДокументов.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка"));
	ТаблицаДокументов.Колонки.Добавить("Дата", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.ДатаВремя));
	ТаблицаДокументов.Колонки.Добавить("НомерИсправления", ОбщегоНазначения.ОписаниеТипаЧисло(2,0,ДопустимыйЗнак.Любой));
	ТаблицаДокументов.Колонки.Добавить("ДатаИсправления", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	
	Возврат ТаблицаДокументов;
	
КонецФункции

Функция НовыйНастройкиЧитаемыхРеквизитовДокументовЦепочки()
	
	ОбщиеЧитаемыеРеквизиты = "Ссылка,Номер,Дата,Проведен,ПометкаУдаления";
	
	Настройки = Новый Структура();
	Настройки.Вставить("ИСФ", ОбщиеЧитаемыеРеквизиты + ",ДокументОснование,ИсправляемыйДокумент,НомерИсправления,ДатаИсправления");
	Настройки.Вставить("КСФ", ОбщиеЧитаемыеРеквизиты + ",ДокументОснование,ИсправляемыйДокумент");
	Настройки.Вставить("СФ", ОбщиеЧитаемыеРеквизиты);
	
	Возврат Настройки;
	
КонецФункции

Функция НовыйВидОшибкиЦепочкиДокументов()
	
	Описание = Новый Структура();
	Описание.Вставить("Обозначение", "");
	Описание.Вставить("Представление", "");
	Описание.Вставить("Данные");
	
	Возврат Описание;
	
КонецФункции

