		|		ИНАЧЕ
		|			0
		|	КОНЕЦ										КАК СуммаНДСВалютная
		|ИЗ
		|	РегистрНакопления.ИсходящийНДС.Остатки(
		|		&ДатаОстатков,
		|		ОбъектНалогообложения В(&ОбъектНалогообложения)
		|		И ВЫБОР
		|			КОГДА &ПрименитьОтборПоСчетуФактуреИсходящийНДС ТОГДА
		|				СчетФактура В(&СчетФактура)
		|			ИНАЧЕ
		|				ИСТИНА
		|		КОНЕЦ
		|	) КАК ИсходящийНДСОстатки
		|;");
	
	ПорядокРегистров = Новый Массив();
	ТекстЗапроса = "";
	
	Для Каждого ИмяРегистра Из МассивИменРегистров Цикл
		Если ТекстыЗапросов.Свойство(ИмяРегистра, ТекстПодзапроса) Тогда
			ПорядокРегистров.Добавить(ИмяРегистра);
			
			ТекстЗапроса = ТекстЗапроса + ТекстПодзапроса;
		КонецЕсли;
	КонецЦикла;
	
	Если ПорядокРегистров.Количество() = 0 Тогда
		Возврат Новый Структура();
	КонецЕсли;
	
	// Из остатков исключаем записи движений указанного документа
	ДатаОстатков = Новый МоментВремени(ДатаДокумента, ДокументСсылкаИсключитьДвижения);
	
	ЗапросДвижения = Новый Запрос();
	ЗапросДвижения.УстановитьПараметр("ДатаОстатков",			ДатаОстатков);
	ЗапросДвижения.УстановитьПараметр("ОбъектНалогообложения",	ОбъектНалогообложения);
	ЗапросДвижения.УстановитьПараметр("ЗаполнитьВалютныеСуммы",	ЗаполнитьВалютныеСуммы);
	ЗапросДвижения.УстановитьПараметр("ПрименитьОтборПоСчетуФактуреВходящийНДС",				ПрименитьОтборПоСчетуФактуре("ВходящийНДС", СчетФактура));
	ЗапросДвижения.УстановитьПараметр("ПрименитьОтборПоСчетуФактуреВходящийНДСКРаспределению",	ПрименитьОтборПоСчетуФактуре("ВходящийНДСКРаспределению", СчетФактура));
	ЗапросДвижения.УстановитьПараметр("ПрименитьОтборПоСчетуФактуреИсходящийНДС",				ПрименитьОтборПоСчетуФактуре("ИсходящийНДС", СчетФактура));
	ЗапросДвижения.УстановитьПараметр("СчетФактура",											СчетФактура);
	
	ЗапросДвижения.Текст = ТекстЗапроса;
	
	РезультатыЗапроса = ЗапросДвижения.ВыполнитьПакет();
	
	ОстаткиПоОбъектуНалогообложения = Новый Структура();
	
	инд = 0;
	
	Для Каждого ИмяРегистра Из ПорядокРегистров Цикл
		ОстаткиПоОбъектуНалогообложения.Вставить(ИмяРегистра, РезультатыЗапроса[инд].Выгрузить());
		
		инд = инд + 1;
	КонецЦикла;
	
	Возврат ОстаткиПоОбъектуНалогообложения;
	
КонецФункции

