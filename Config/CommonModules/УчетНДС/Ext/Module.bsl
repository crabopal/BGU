Функция НайтиПредыдущийСчетФактуруРеализации(ДокументРеализации) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ДокументРеализации) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(ДокументРеализации) <> Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12")
		И ТипЗнч(ДокументРеализации) <> Тип("ДокументСсылка.НакладнаяНаОтпускМ15") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	РеквизитыРеализации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументРеализации, "ЭтоКорректировка,НомерКорректировки,ДокументОснование");
	
	Если НЕ РеквизитыРеализации.ЭтоКорректировка Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ОснованиеРеализации = РеквизитыРеализации.ДокументОснование;
	
	Если НЕ ЗначениеЗаполнено(ОснованиеРеализации) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	РеквизитыОснованияРеализации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОснованиеРеализации, "ЭтоКорректировка");
	
	Если РеквизитыОснованияРеализации.ЭтоКорректировка Тогда
		Текст = "
		|ВЫБРАТЬ
		|	Ссылка,
		|	Дата,
		|	Номер,
		|	Проведен
		|ИЗ
		|	(ВЫБРАТЬ
		|		Ссылка,
		|		Дата,
		|		Номер,
		|		Проведен
		|	ИЗ
		|		Документ.КорректировочныйСчетФактураВыданный
		|	ГДЕ
		|		НЕ ПометкаУдаления
		|		И ДокументКорректировки В(&ДокументРеализации)
		|
		|	ОБЪЕДИНИТЬ ВСЕ
		|
		|	ВЫБРАТЬ
		|		Ссылка,
		|		Дата,
		|		Номер,
		|		Проведен
		|	ИЗ
		|		Документ.ИсправительныйСчетФактураВыданный
		|	ГДЕ
		|		НЕ ПометкаУдаления
		|		И ДокументКорректировки В(&ДокументРеализации)
		|	) КАК ВТ
		|УПОРЯДОЧИТЬ ПО
		|	Проведен УБЫВ,
		|	Дата УБЫВ";

	Иначе
		Текст = "
		|ВЫБРАТЬ
		|	Ссылка,
		|	Дата,
		|	Номер,
		|	Проведен
		|ИЗ
		|	Документ.СчетФактураВыданный
		|ГДЕ
		|	НЕ ПометкаУдаления
		|	И ДокументОснование В(&ДокументРеализации)
		|УПОРЯДОЧИТЬ ПО
		|	Проведен УБЫВ,
		|	Дата УБЫВ";
	КонецЕсли;
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ДокументРеализации", ОснованиеРеализации);
	ЗапросПоиск.Текст = Текст;
	
	ВремТаблица = ЗапросПоиск.Выполнить().Выгрузить();
	
	Если ВремТаблица.Количество() > 0 Тогда
		Возврат ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ВремТаблица[0]);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции


