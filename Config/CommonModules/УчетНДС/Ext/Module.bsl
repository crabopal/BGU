КонецФункции

Функция ПолучитьДанныеОшибкиЦиклическиеСсылки(СписокОшибок)
	
	ОбозначениеВидаОшибки = ОбозначениеВидаОшибкиЦиклическиеСсылки();
	
	Для Каждого Элемент Из СписокОшибок Цикл
		Если Элемент.Обозначение = ОбозначениеВидаОшибки Тогда
			Возврат Элемент.Данные;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти

#Область ДокументыСчетовФактурНаАвансСтрока5б

Функция НайтиСчетаФактурыНаАвансПоКоторымВозможенЗачет(Отбор, ДобавитьКолонкиАналитики)
	
	Перем ИменаКолонокАналитикиСтрокой;
	
	СчетаФактурыНаАванс = Новый ТаблицаЗначений();
	СчетаФактурыНаАванс.Колонки.Добавить("СчетФактура", Новый ОписаниеТипов("ДокументСсылка.СчетФактураВыданный"));
	
	Если ДобавитьКолонкиАналитики Тогда
		ДобавитьКолонкиАналитикиВТаблицуСчетаФактурыНаАванс(СчетаФактурыНаАванс);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Отбор.НаДату) Тогда
		Отбор.НаДату = ТекущаяДатаСеанса();
	КонецЕсли;
	
	ТаблицаОстатков = ПрочитатьОстаткиВходящийНДСАвансыПолученные(Отбор);
	
	ПараметрыПоиска = НовыйПараметрыПоискаЗачетаАванса();
	ПараметрыПоиска.Дата		= Отбор.НаДату;
	ПараметрыПоиска.Организация	= Отбор.Организация;
	ПараметрыПоиска.Ссылка		= Неопределено;
	
	ТаблицаЗачтенныеАвансы = УчетНДС.РазбитьПоДатамЗачетаАвансаПолученного(ТаблицаОстатков, ПараметрыПоиска,, Отбор.СписокДокументовЗачетаАванса);
	
	Если ТаблицаЗачтенныеАвансы.Количество() = 0 Тогда
		Возврат СчетаФактурыНаАванс;
	КонецЕсли;
	
	КолонкиСвертки = "СчетФактура";
	
	Если ДобавитьКолонкиАналитики Тогда
		ИменаКолонокАналитикиСтрокой = ПолучитьИменаКолонокАналитикиСтрокойТаблицаСчетаФактурыНаАванс();
		
		КолонкиСвертки = КолонкиСвертки + "," + ИменаКолонокАналитикиСтрокой;
	КонецЕсли;
	
	ВремТаблица = ТаблицаЗачтенныеАвансы.Скопировать(, КолонкиСвертки);
	ВремТаблица.Свернуть(КолонкиСвертки);
	
	Для Каждого СтрокаВремТаблицы Из ВремТаблица Цикл
		СчетФактура = СтрокаВремТаблицы.СчетФактура;
		
		Если ТипЗнч(СчетФактура) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
			НоваяСтрока = СчетаФактурыНаАванс.Добавить();
			НоваяСтрока.СчетФактура = СчетФактура;
			
			Если ДобавитьКолонкиАналитики Тогда
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаВремТаблицы, ИменаКолонокАналитикиСтрокой);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат СчетаФактурыНаАванс;
	
КонецФункции

Функция ПрочитатьОстаткиВходящийНДСАвансыПолученные(Отбор)
	
	УдалитьПустыеЗначенияИзОтбораОстатковВходящийНДСАвансыПолученные(Отбор);
	
	ДатаОкончанияИгнорированияДокументовРасчетов = УчетНДС.ПолучитьДатуОкончанияИгнорированияДокументовРасчетов(Отбор.Организация);
	
	СтруктураСчетовАвансов = УчетНДС.ПолучитьТаблицуСчетовАвансовПолученных();
	
	Счета205хА = СтруктураСчетовАвансов.МассивСчетов;
	
	ВидЦенности = Перечисления.ВидыЦенностейНДС.Аванс;
	
	ПричиныНалогообложения = Новый Массив();
	ПричиныНалогообложения.Добавить(Перечисления.ПричиныНалогообложенияНДС.АвансПолученный);
	
	ИспользоватьОтборПоКФО = (Отбор.СписокКФО.Количество() > 0);
	ИспользоватьОтборПоДоговору = (Отбор.СписокДоговоров.Количество() > 0);
	ИспользоватьОтборПоСчетамРасчетов = (Отбор.СписокСчетовРасчетов.Количество() > 0);
	ИспользоватьОтборПоКПССчетРасчетов = (Отбор.СписокКПССчетРасчетов.Количество() > 0);
	ИспользоватьОтборПоСчетамФактурамНаАванс = (Отбор.СписокСчетовФактурНаАванс.Количество() > 0);
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("НаДату",						Отбор.НаДату);
	ЗапросПоиск.УстановитьПараметр("ПустаяДата",					'00010101');
	ЗапросПоиск.УстановитьПараметр("ДатаОкончанияИгнорированияДокументовРасчетов", ДатаОкончанияИгнорированияДокументовРасчетов);
	ЗапросПоиск.УстановитьПараметр("Счета205хА",					Счета205хА);
	ЗапросПоиск.УстановитьПараметр("Организация",					Отбор.Организация);
	ЗапросПоиск.УстановитьПараметр("ВидЦенности",					ВидЦенности);
	ЗапросПоиск.УстановитьПараметр("ПричиныНалогообложения",		ПричиныНалогообложения);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборПоКФО",		ИспользоватьОтборПоКФО);
	ЗапросПоиск.УстановитьПараметр("СписокКФО",						Отбор.СписокКФО);
	ЗапросПоиск.УстановитьПараметр("СписокКонтрагентов",			Отбор.СписокКонтрагентов);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборПоДоговору",	ИспользоватьОтборПоДоговору);
	ЗапросПоиск.УстановитьПараметр("СписокДоговоров",				Отбор.СписокДоговоров);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборПоСчетамРасчетов",			ИспользоватьОтборПоСчетамРасчетов);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборПоКПССчетРасчетов",		ИспользоватьОтборПоКПССчетРасчетов);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборПоСчетамФактурамНаАванс",	ИспользоватьОтборПоСчетамФактурамНаАванс);
	ЗапросПоиск.УстановитьПараметр("СписокСчетовРасчетов",						Отбор.СписокСчетовРасчетов);
	ЗапросПоиск.УстановитьПараметр("СписокКПССчетРасчетов",						Отбор.СписокКПССчетРасчетов);
	ЗапросПоиск.УстановитьПараметр("СписокСчетовФактурНаАванс",					Отбор.СписокСчетовФактурНаАванс);
	
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СчетФактура												КАК СчетФактура,
	|	ПричинаНалогообложения									КАК ПричинаНалогообложения,
	|	КФО														КАК КФО,
	|	СчетРасчетов											КАК СчетРасчетов,
	|	КПССчетРасчетов											КАК КПССчетРасчетов,
	|	ОбъектНалогообложения									КАК ОбъектНалогообложения,
	|	СтавкаНДС												КАК СтавкаНДС,
	|	СуммаБезНДСОстаток										КАК СуммаБезНДС,
	|	СуммаНДСОстаток											КАК СуммаНДС,
	|	СуммаБезНДСОстаток + СуммаНДСОстаток					КАК Всего,
	|	СуммаБезНДСВалютнаяОстаток								КАК СуммаБезНДСВалютная,
	|	СуммаНДСВалютнаяОстаток									КАК СуммаНДСВалютная,
	|	СуммаБезНДСВалютнаяОстаток + СуммаНДСВалютнаяОстаток	КАК ВсегоВалютная,
	|	
	|	// Дополнительные поля для алгоритма поиска зачета аванса.
	|	ЕСТЬNULL(СчетФактура.Дата, &ПустаяДата)					КАК ДатаСчетаФактуры,
	|	ЕСТЬNULL(СчетФактура.Контрагент,
	|		ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))		КАК Контрагент,
	|	ЕСТЬNULL(СчетФактура.Договор,
	|		ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка))			КАК Договор,
	|	ЕСТЬNULL(ОбъектНалогообложения.Дата,
	|		ЕСТЬNULL(СчетФактура.Дата, &ПустаяДата))			КАК ДатаДокументаОснования,
	|	ВЫБОР
	|		КОГДА СчетРасчетов В(&Счета205хА) ТОГДА
	|			НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ
	|			ОбъектНалогообложения
	|	КОНЕЦ													КАК ДокументРасчетов,
	|	(ЕСТЬNULL(ОбъектНалогообложения.Дата, &ПустаяДата) <
	|		&ДатаОкончанияИгнорированияДокументовРасчетов)		КАК ВозможноПотребуетсяОчисткаДокументаРасчетов
	|ИЗ
	|	РегистрНакопления.ВходящийНДС.Остатки(
	|		&НаДату,
	|		Организация = &Организация
	|		И ВидЦенности = &ВидЦенности
	|		И ПричинаНалогообложения В(&ПричиныНалогообложения)
	|		И ЕСТЬNULL(СчетФактура.Контрагент,
	|			ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) В (&СписокКонтрагентов)
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоКФО ТОГДА
	|				КФО В(&СписокКФО)
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоДоговору ТОГДА
	|				ЕСТЬNULL(СчетФактура.Договор, ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)) В (&СписокДоговоров)
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоСчетамРасчетов ТОГДА
	|				СчетРасчетов В(&СписокСчетовРасчетов)
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоКПССчетРасчетов ТОГДА
	|				КПССчетРасчетов В(&СписокКПССчетРасчетов)
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоСчетамФактурамНаАванс ТОГДА
	|				СчетФактура В(&СписокСчетовФактурНаАванс)
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ)";
	
	Возврат ЗапросПоиск.Выполнить().Выгрузить();
	
КонецФункции

