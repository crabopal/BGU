Процедура ЗаполнитьРаздел8_2015Кв1(Контейнер, ТаблицаРасшифровки, ПараметрыОтчета)
	
	// Подготовка
	ФормироватьОсновнойРаздел		= Истина;
	ФормироватьДопЛисты				= НЕ (ПараметрыОтчета["ВидДокумента"] = 0);
	ВыводитьТолькоДопЛисты			= Ложь;
	
	// Отбор по организации
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных();
	НовыйЭлемент = КомпоновщикНастроек.Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	НовыйЭлемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Организация");
	НовыйЭлемент.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
	НовыйЭлемент.ПравоеЗначение = ПараметрыОтчета["СписокОрганизаций"];
	
	ПараметрыНовогоОтчета = Новый Структура();
	ПараметрыНовогоОтчета.Вставить("Организация",									ПараметрыОтчета["Организация"]);
	ПараметрыНовогоОтчета.Вставить("НачалоПериода",									ПараметрыОтчета["мДатаНачалаПериодаОтчета"]);
	ПараметрыНовогоОтчета.Вставить("КонецПериода",									ПараметрыОтчета["мДатаКонцаПериодаОтчета"]);
	ПараметрыНовогоОтчета.Вставить("ФормироватьДопЛисты",							ФормироватьДопЛисты);
	ПараметрыНовогоОтчета.Вставить("ДополнительныеЛистыЗаТекущийПериод",			Истина);
	ПараметрыНовогоОтчета.Вставить("ГруппироватьПоКонтрагентам",					Ложь);
	ПараметрыНовогоОтчета.Вставить("ВыводитьТолькоДопЛисты",						ВыводитьТолькоДопЛисты);
	ПараметрыНовогоОтчета.Вставить("КомпоновщикНастроек",							КомпоновщикНастроек);
	ПараметрыНовогоОтчета.Вставить("ПредставленияПричинНалогообложения",			Новый СписокЗначений());
	ПараметрыНовогоОтчета.Вставить("ВыводитьПредставленияПричинНалогообложения",	Ложь);
	ПараметрыНовогоОтчета.Вставить("УникальныйИдентификаторФормы",					ПараметрыОтчета["УникальныйИдентификаторФормы"]);
	ПараметрыНовогоОтчета.Вставить("ВыводитьОтбор",									Ложь);
	ПараметрыНовогоОтчета.Вставить("Колонтитулы_НаименованиеОтчета",				НСтр("ru='Книга покупок'"));
	ПараметрыНовогоОтчета.Вставить("Колонтитулы_ТекущийПользователь",				Строка(ПользователиКлиентСервер.АвторизованныйПользователь()));
	ПараметрыНовогоОтчета.Вставить("ЗаполнитьДанныеДляДекларации",					Истина);
	
	ПараметрыНовогоОтчета.Вставить("СсылкаНаДекларацию",							ПараметрыОтчета["Декларация"]);
	ПараметрыНовогоОтчета.Вставить("ДатаПодписиДекларации",							ПараметрыОтчета["ДатаПодписи"]);
	
	ПараметрыНовогоОтчета.Вставить("ПравилаЗаполнения",								"2015Кв1");
	
	Адрес = Неопределено;
	Отчеты.КнигаПокупок735.СформироватьОтчет(ПараметрыНовогоОтчета, Адрес);
	
КонецПроцедуры

