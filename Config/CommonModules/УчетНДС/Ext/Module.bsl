Процедура АвтоустановкаСубконто_ВыполнитьАвтоустановкуЗначений(Форма, ИмяЭлементаТаблица, ИмяЭлементаСчет = Неопределено) Экспорт
	
	// Получим список элементов "счет", связанных с указанной таблицей:
	Если ИмяЭлементаСчет = Неопределено Тогда
		// Имя элемента не указано.
		// Считаем, что необходимо обработать все элементы.
		Поиск = Новый Структура("ИмяЭлементаТаблица", ИмяЭлементаТаблица);
	Иначе
		// Имя элемента указано.
		// Считаем, что нужно обработать только этот элемент.
		Поиск = Новый Структура("ИмяЭлементаТаблица, ИмяЭлементаСчет", ИмяЭлементаТаблица, ИмяЭлементаСчет);
	КонецЕсли;
	
	ТаблицаЭлементыСубконто = Форма["АвтоустановкаСубконто_ТаблицаЭлементыСубконто"];
	ВремТаблица = ТаблицаЭлементыСубконто.Выгрузить(ТаблицаЭлементыСубконто.НайтиСтроки(Поиск), "ИмяЭлементаСчет");
	ВремТаблица.Свернуть("ИмяЭлементаСчет");
	МассивИмен = ВремТаблица.ВыгрузитьКолонку("ИмяЭлементаСчет");
	
	Для Каждого ИмяЭлементаСчет Из МассивИмен Цикл
		АвтоустановкаСубконто_ОбработатьТаблицуИлиТекущуюСтроку(Форма, ИмяЭлементаСчет,
			,			// ТекущаяСтрока
			Истина);	// ВыполнитьАвтоустановкуЗначений
	КонецЦикла;
	
КонецПроцедуры

Процедура АвтоустановкаСубконто_ВыполнитьАвтоустановкуЗначений_ВызовНеИзФормы(ДокументОбъект, ТаблицаПараметровАвтоустановкиДляВызоваНеИзФормы, ВыполнитьАвтоустановкуТолькоПустыхЗначений) Экспорт
	
	Для Каждого СтрокаТаблицы Из ТаблицаПараметровАвтоустановкиДляВызоваНеИзФормы Цикл
		ПараметрыАвтоустановки = Новый Структура();
		ПараметрыАвтоустановки.Вставить("ЗаполняемаяТаблица",					СтрокаТаблицы["ЗаполняемаяТаблица"]);
		ПараметрыАвтоустановки.Вставить("СчетЭтоРеквизитТаблицы",				СтрокаТаблицы["СчетЭтоРеквизитТаблицы"]);
		ПараметрыАвтоустановки.Вставить("ИменаРеквизитовСчетИСубконто",			СтрокаТаблицы["ИменаРеквизитовСчетИСубконто"]);
		ПараметрыАвтоустановки.Вставить("ЗначенияАвтоустановки",				СтрокаТаблицы["ЗначенияАвтоустановки"]);
		ПараметрыАвтоустановки.Вставить("ЗначенияАвтоустановкиВТаблице",		СтрокаТаблицы["ЗначенияАвтоустановкиВТаблице"]);
		
		ОпцииЗаполнения = Новый Структура();
		ОпцииЗаполнения.Вставить("ВыполнитьАвтоустановкуЗначений",				Истина);
		ОпцииЗаполнения.Вставить("ВыполнитьАвтоустановкуТолькоПустыхЗначений",	ВыполнитьАвтоустановкуТолькоПустыхЗначений);
		
		АвтоустановкаСубконто_ЗаполнитьТаблицу(ПараметрыАвтоустановки, ОпцииЗаполнения, Ложь);
	КонецЦикла;
	
КонецПроцедуры

Процедура АвтоустановкаСубконто_УстановитьОбслуживаемыеИдентификаторы(Форма, Идентификаторы) Экспорт
	
	ОбслуживаемыеИдентификаторы = Новый Массив();
	
	Если ТипЗнч(Идентификаторы) = Тип("Строка") Тогда
		ВремМассив = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(Идентификаторы);
		Для Каждого ИдентификаторСтрока Из ВремМассив Цикл
			ОбслуживаемыеИдентификаторы.Добавить(Число(ИдентификаторСтрока));
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(Идентификаторы) = Тип("Массив") Тогда
		ОбслуживаемыеИдентификаторы = Идентификаторы;
	КонецЕсли;
	
	Форма["АвтоустановкаСубконто_МассивОбслуживаемыхИдентификаторов"] = Новый ФиксированныйМассив(ОбслуживаемыеИдентификаторы);
	
КонецПроцедуры
	
Функция АвтоустановкаСубконто_ПолучитьПустуюТаблицуПараметровАвтоустановки_ДляВызоваНеИзФормы() Экспорт
	
	ПараметрыАвтоустановки = Новый ТаблицаЗначений();
	ПараметрыАвтоустановки.Колонки.Добавить("ЗаполняемаяТаблица",				Новый ОписаниеТипов());
	ПараметрыАвтоустановки.Колонки.Добавить("СчетЭтоРеквизитТаблицы",			Новый ОписаниеТипов("Булево"));
	ПараметрыАвтоустановки.Колонки.Добавить("ИменаРеквизитовСчетИСубконто",		Новый ОписаниеТипов("Структура"));
	ПараметрыАвтоустановки.Колонки.Добавить("ЗначенияАвтоустановки",			Новый ОписаниеТипов("Соответствие"));
	ПараметрыАвтоустановки.Колонки.Добавить("ЗначенияАвтоустановкиВТаблице",	Новый ОписаниеТипов("Соответствие"));
	
	Возврат ПараметрыАвтоустановки;
	
КонецФункции

