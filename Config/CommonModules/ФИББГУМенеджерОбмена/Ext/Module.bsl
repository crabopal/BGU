// Процедура выполняет заполнение проводок.
//
// Параметры :
//	Объект - ДокументОбъект.ОперацияБух - заполняемый документ.
//	Проводки - информация о проводках.
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализированные в рамках 
//								   выполнения сеанса обмена.
//
Процедура ЗаполнитьПроводки(Знач Объект, Знач Проводки, Знач КомпонентыОбмена)
	Перем ЕПСБУ, Общие, Запись, Новая, Стр, Номер, Начало, НаДату, Знч, Узел;
	Перем ПКО_КОСГУ, ПКО_Валюта, Действие, Тип;
	
	Узел = КомпонентыОбмена.УзелКорреспондента;
	Объект.СуммаДокумента = 0;
	ЕПСБУ = Объект.Движения.ЖурналПроводокЕПСБУ;
	ЕПСБУ.Очистить();
	ОбменДаннымиСервер.УстановитьОбменДаннымиЗагрузка(ЕПСБУ, Истина, Ложь, Узел);
	ЕПСБУ.ДополнительныеСвойства.Вставить("ПропуститьЗаписьВерсииОбъекта");
	ЕПСБУ.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов");
	ЕПСБУ.Записывать = Истина;
	// Если нет проводок, то ничего не нужно делать.	
	Если (Проводки = Неопределено) Тогда
		Возврат;
	КонецЕсли;
	// Заполнение проводок.
	НаДату = НачалоДня(Объект.Дата);
	ПКО_КОСГУ = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_КОСГУ_Получение");
	ПКО_Валюта = Неопределено;
	Действие = ДействиеПоУмолчанию();
	Знч = ПустаяСтрока(Объект.Комментарий);
	Знч = Знч И (Не КомпонентыОбмена.ПараметрыКонвертации.ПроверятьПолученныеПроводки);
	// Заполнение общих реквизитов.
	Общие = Новый Структура;
	Общие.Вставить("Активность", Знч);
	Общие.Вставить("Организация", Объект.Организация);
	Общие.Вставить("ИФО", Объект.ИФО);
	Общие.Вставить("Период", Объект.Дата);
	Общие.Вставить("УточнениеПериода", БухгалтерскийУчет.ЗначениеУточненияПериода(Объект.ВидМежотчетногоПериода));
	Общие.Вставить("ВидМежотчетногоПериода", Объект.ВидМежотчетногоПериода);
	Номер = 0;
	Для Каждого Запись Из Проводки Цикл
		Начало = Ложь;
		Номер = Номер + 1;
		Новая = ЕПСБУ.Добавить();
		// Заполнение общих реквизитов.
		ЗаполнитьЗначенияСвойств(Новая, Общие);
		// Сумма.
		Новая.Сумма = Запись.Сумма;
		Объект.СуммаДокумента = Объект.СуммаДокумента + Новая.Сумма;
		// КФО.
		Новая.КФО = КФО(Запись.КФО);
		Если (Новая.КФО.Пустая() И (Не ПустаяСтрока(Запись.КФО))) Тогда
			Стр = СтрШаблон(НСтр("ru = 'По коду ""%1"" не найден КФО'"), Запись.КФО);
			Если НетТекстаВКомментарии(Объект, Стр) Тогда
				ДобавитьКомментарий(Объект, ТекстСНомеромСтроки(Номер, Начало) + Стр);
			КонецЕсли;	
		КонецЕсли;
		// Журнал.
		Новая.ЖурналОпераций = НайтиЖурналОпераций(Запись.НомерЖурнала);
		Если (Новая.ЖурналОпераций.Пустая() И (Не ПустаяСтрока(Запись.НомерЖурнала))) Тогда
			Стр = СтрШаблон(НСтр("ru = 'По номеру ""%1"" не найден журнал'"), Запись.НомерЖурнала);
			Если НетТекстаВКомментарии(Объект, Стр) Тогда
				ДобавитьКомментарий(Объект, ТекстСНомеромСтроки(Номер, Начало) + Стр);
			КонецЕсли;	
		КонецЕсли;
		// Поиск счета (дт).
		Стр = Запись.СчетДт;
		Если ((Стр <> Неопределено) И Стр.Свойство("Код", Знч)) Тогда
			Новая.СчетДт = НайтиСчет(Знч, НаДату, Объект.Организация);
			Если (Новая.СчетДт.Пустая() И (Не ПустаяСтрока(Знч))) Тогда
				Стр = СтрШаблон(НСтр("ru = 'По коду ""%1"" не найден счет'"), Знч);
				Если НетТекстаВКомментарии(Объект, Стр) Тогда
					ДобавитьКомментарий(Объект, ТекстСНомеромСтроки(Номер, Начало) + Стр + " " + НСтр("ru = '(дт)'"));
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		// Поиск счета (кт).
		Стр = Запись.СчетКт;
		Если ((Стр <> Неопределено) И Стр.Свойство("Код", Знч)) Тогда
			Новая.СчетКт = НайтиСчет(Знч, НаДату, Объект.Организация);
			Если (Новая.СчетКт.Пустая() И (Не ПустаяСтрока(Знч))) Тогда
				Стр = СтрШаблон(НСтр("ru = 'По коду ""%1"" не найден счет'"), Знч);
				Если НетТекстаВКомментарии(Объект, Стр) Тогда
					ДобавитьКомментарий(Объект, ТекстСНомеромСтроки(Номер, Начало) + Стр + " " + НСтр("ru = '(кт)'"));
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
		// Заполнение - дебет.
		Если (Не Новая.СчетДт.Пустая()) Тогда
			// Заполнение КБК.
			Стр = НайтиКПС(Запись.КПСДт, НаДату, Новая.КФО, КомпонентыОбмена);
			Если (ТипЗнч(Стр) <> Тип("Строка")) Тогда
				Новая.КПСДт = Стр;
			ИначеЕсли НетТекстаВКомментарии(Объект, Стр) Тогда
				ДобавитьКомментарий(Объект, ТекстСНомеромСтроки(Номер, Начало) + Стр + " " + НСтр("ru = '(дт)'"));
			КонецЕсли;
			// КОСГУ.
			Если (Запись.КЭКДт <> Неопределено) Тогда
				Знч = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(КомпонентыОбмена,
																		   Запись.КЭКДт,
																		   ПКО_КОСГУ,
																		   Действие);
				Тип = ТипЗнч(Знч);
				Если (Тип = Тип("СправочникОбъект.КОСГУ")) Тогда
					Знч = Знч.Ссылка;
				ИначеЕсли (Тип <> Тип("СправочникСсылка.КОСГУ")) Тогда
					Знч = Справочники.КОСГУ.ПустаяСсылка();
				КонецЕсли;
				Если Знч.Пустая() Тогда
					Новая.КЭКДт = КЭК("000");
				Иначе	
					Новая.КЭКДт = Знч.Ссылка;
				КонецЕсли;	
			Иначе
				Новая.КЭКДт = КЭК("000");
			КонецЕсли;
			// Заполнение валюты и суммы в валюте.
			Если Новая.СчетДт.Валютный Тогда
				Если (Запись.ВалютаДт <> Неопределено) Тогда
					Если (ПКО_Валюта = Неопределено) Тогда
						ПКО_Валюта = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_Валюта_Получение");
					КонецЕсли;	
					Знч = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(КомпонентыОбмена,
																			   Запись.ВалютаДт,
																			   ПКО_Валюта,
																			   Действие);
					Тип = ТипЗнч(Знч);
					Если (Тип = Тип("СправочникОбъект.Валюты")) Тогда
						Знч = Знч.Ссылка;
					ИначеЕсли (Тип <> Тип("СправочникСсылка.Валюты")) Тогда
						Знч = Справочники.Валюты.ПустаяСсылка();
					КонецЕсли;
					Новая.ВалютаДт = Знч;
				Иначе
					Новая.ВалютаДт = Справочники.Валюты.ПустаяСсылка();
				КонецЕсли;
				Новая.ВалютнаяСуммаДт = Запись.СуммаВВалютеДт;
			КонецЕсли;
			// Заполнение субконто.
			Стр = ЗаполнитьСубконто(Запись, Новая, "Дт", КомпонентыОбмена);
			Если ((Не ПустаяСтрока(Стр)) И НетТекстаВКомментарии(Объект, Стр)) Тогда
				ДобавитьКомментарий(Объект, ТекстСНомеромСтроки(Номер, Начало) + Стр + " " + НСтр("ru = '(дт)'"));
			КонецЕсли;
		КонецЕсли;
		// Заполнение - кредит.
		Если (Не Новая.СчетКт.Пустая()) Тогда
			// Заполнение КБК.
			Стр = НайтиКПС(Запись.КПСКт, НаДату, Новая.КФО, КомпонентыОбмена);
			Если (ТипЗнч(Стр) <> Тип("Строка")) Тогда
				Новая.КПСКт = Стр;
			ИначеЕсли НетТекстаВКомментарии(Объект, Стр) Тогда
				ДобавитьКомментарий(Объект, ТекстСНомеромСтроки(Номер, Начало) + Стр + " " + НСтр("ru = '(кт)'"));
			КонецЕсли;
			// КОСГУ.
			Если (Запись.КЭККт <> Неопределено) Тогда
				Знч = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(КомпонентыОбмена,
																		   Запись.КЭККт,
																		   ПКО_КОСГУ,
																		   Действие);
				Тип = ТипЗнч(Знч);
				Если (Тип = Тип("СправочникОбъект.КОСГУ")) Тогда
					Знч = Знч.Ссылка;
				ИначеЕсли (Тип <> Тип("СправочникСсылка.КОСГУ")) Тогда
					Знч = Справочники.КОСГУ.ПустаяСсылка();
				КонецЕсли;
				Если Знч.Пустая() Тогда
					Новая.КЭККт = КЭК("000");
				Иначе
					Новая.КЭККт = Знч.Ссылка;
				КонецЕсли;	
			Иначе	
				Новая.КЭККт = КЭК("000");
			КонецЕсли;
			// Заполнение валюты и суммы в валюте.
			Если Новая.СчетКт.Валютный Тогда
				Если (Запись.ВалютаКт <> Неопределено) Тогда
					Если (ПКО_Валюта = Неопределено) Тогда
						ПКО_Валюта = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_Валюта_Получение");
					КонецЕсли;	
					Знч = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(КомпонентыОбмена,
																			   Запись.ВалютаКт,
																			   ПКО_Валюта,
																			   Действие);
					Тип = ТипЗнч(Знч);
					Если (Тип = Тип("СправочникОбъект.Валюты")) Тогда
						Знч = Знч.Ссылка;
					ИначеЕсли (Тип <> Тип("СправочникСсылка.Валюты")) Тогда
						Знч = Справочники.Валюты.ПустаяСсылка();
					КонецЕсли;
					Новая.ВалютаКт = Знч;
				Иначе
					Новая.ВалютаКт = Справочники.Валюты.ПустаяСсылка();
				КонецЕсли;
				Новая.ВалютнаяСуммаКт = Запись.СуммаВВалютеКт;
			КонецЕсли;
			// Заполнение субконто.
			Стр = ЗаполнитьСубконто(Запись, Новая, "Кт", КомпонентыОбмена);
			Если ((Не ПустаяСтрока(Стр)) И НетТекстаВКомментарии(Объект, Стр)) Тогда
				ДобавитьКомментарий(Объект, ТекстСНомеромСтроки(Номер, Начало) + Стр + " " + НСтр("ru = '(кт)'"));
			КонецЕсли;
		КонецЕсли;
		// Заполнение реквизитов.
		Новая.ВидПервичногоДокумента = Запись.ВидДокумента;
		Новая.НомерПервичногоДокумента = Запись.НомерДокумента;
		Новая.ДатаПервичногоДокумента = Запись.ДатаДокумента;
		Новая.Содержание = Запись.Содержание;
	КонецЦикла;
	// Если были ошибки, то записи не активны.	
	Если (Общие.Активность И (Не ПустаяСтрока(Объект.Комментарий))) Тогда
		ЕПСБУ.УстановитьАктивность(Ложь);
	КонецЕсли;

КонецПроцедуры

// Обработчик записывает данные из пакета XDTO в бухгалтерскую операцию.
// 
// Параметры :
//	ДанныеИБ - ДокументОбъект.ОперацияБух - объект информационной базы.
//	ПолученныеДанные - ДокументОбъект.ОперацияБух - новый объект информационной базы.
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализированные в рамках 
//								   выполнения сеанса обмена.
//	Пропустить - Булево - пропустить объект.
//
Процедура ПКО_Документ_БухгалтерскаяСправка_Получение_ПередЗаписьюПолученныхДанных(Знач ДанныеИБ,
																				   Знач ПолученныеДанные,
																			   	   Знач КомпонентыОбмена,
																				   Пропустить)
	Перем Проводки, Узел, Стр;
	
	УстановитьОтключениеБезопасногоРежима(Истина);
	УстановитьПривилегированныйРежим(Истина);
	// Получение данных о бухгалтерских проводках.
	Данные = ПолученныеДанные.ДополнительныеСвойства;
	Если (Не Данные.Свойство("Проводки", Проводки)) Тогда
		Проводки = Неопределено;
	КонецЕсли;
	Данные.Удалить("Проводки");
	// Заполнение проводок.
	Если (ДанныеИБ = Неопределено) Тогда
		ПолученныеДанные.УстановитьНовыйНомер();
		ЗаполнитьПроводки(ПолученныеДанные, Проводки, КомпонентыОбмена);
	ИначеЕсли (ДанныеИБ.ИДИсточника = ИзмененУИ()) Тогда
		Узел = КомпонентыОбмена.УзелКорреспондента;
		ЗарегистрироватьОбъект(ДанныеИБ, Узел);
		Пропустить = Истина;
		Если ПолученныеДанные.ДополнительныеСвойства.Свойство("ИдентификаторXDTO", Стр) Тогда
			Если (Не ОбъектУчаствовалВОбмене(ДанныеИБ.Ссылка, Узел)) Тогда
				ДобавитьИдентификаторXDTO(ДанныеИБ.Ссылка, Узел, Стр);
			КонецЕсли;
		КонецЕсли;	
		Возврат;
	Иначе	
		ЗаполнитьЗначенияСвойств(ДанныеИБ, ПолученныеДанные,, "Номер");
		ЗаполнитьПроводки(ДанныеИБ, Проводки, КомпонентыОбмена);
	КонецЕсли;

КонецПроцедуры

// Обработчик выполняет поиск бухгалтерской операции.
//
// Параметры :
//	ДанныеИБ - ДокументСсылка.ОперацияБух - найденный объект информационной базы.
//	ПолученныеДанные - Документбъект.ОперацияБух - новый объект информационной базы.
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализированные в рамках 
//								   выполнения сеанса обмена.
//
Процедура ПКО_Документ_БухгалтерскаяСправка_Получение_АлгоритмПоиска(ДанныеИБ,
																	 Знач ПолученныеДанные,
																	 Знач КомпонентыОбмена)
	Перем Текст, Отбор, Таб;															
																
	Если (ДанныеИБ <> Неопределено) Тогда
		Возврат;															
	ИначеЕсли ПолученныеДанные.ДополнительныеСвойства.Свойство("ИдентификаторXDTO", Текст) Тогда
		ДанныеИБ = СсылкаПоИдентификатору(Текст, "Документ.ОперацияБух", КомпонентыОбмена.УзелКорреспондента);
		Если (ДанныеИБ <> Неопределено) Тогда
			Возврат;															
		КонецЕсли;	
	КонецЕсли;
	Отбор = Новый Структура;
	Отбор.Вставить("Организация", ПолученныеДанные.Организация);
	Отбор.Вставить("ИФО", ПолученныеДанные.ИФО);
	Отбор.Вставить("Дата", НачалоДня(ПолученныеДанные.Дата));
	Отбор.Вставить("НомерИсточника", ПолученныеДанные.НомерИсточника);
	Отбор.Вставить("Основание", Лев(ПолученныеДанные.Основание, 255));
	Отбор.Вставить("Узел", КомпонентыОбмена.УзелКорреспондента);
	Отбор.Вставить("ИУИ", ИзмененУИ());
	Отбор.Вставить("ПУИ", ПолученУИ());
	Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
			|	Док.Ссылка КАК Ссылка
			|ИЗ	Документ.ОперацияБух КАК Док
			|ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов КАК ПИ
			|ПО (ПИ.Ссылка = Док.Ссылка) И (ПИ.УзелИнформационнойБазы = &Узел)
			|ГДЕ (Док.Организация = &Организация) И (ПИ.Ссылка ЕСТЬ NULL)
			|  И (Док.НомерИсточника = &НомерИсточника)
			|  И (НАЧАЛОПЕРИОДА(Док.Дата, ДЕНЬ) = &Дата)
			|  И ((Док.ИДИсточника = &ИУИ) ИЛИ (Док.ИДИсточника = &ПУИ))
			|  И ((Док.ИФО = &ИФО) ИЛИ (&ИФО = ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)))
			|  И (ВЫРАЗИТЬ(Док.Основание КАК СТРОКА(255)) = &Основание)
			|УПОРЯДОЧИТЬ ПО Док.ПометкаУдаления, (Док.ИФО <> &ИФО)";
	Таб = ПолучитьДанные(Текст, Отбор);
	Если (Таб.Количество() <> 0) Тогда
		ДанныеИБ = Таб[0].Ссылка;
	КонецЕсли;	

КонецПроцедуры

// Обработчик для дополнительной обработки после загрузки данных в бухгалтерские операции.
// 
// Параметры :
//	Объект - ДокументОбъект.ОперацияБух - объект информационной базы.
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализированные в рамках 
//								   выполнения сеанса обмена.
//	ОбъектМодифицирован - Булево - модифицированность объекта.
//
Процедура ПКО_Документ_БухгалтерскаяСправка_Получение_ПослеЗагрузкиВсехДанных(Знач Объект,
																			  Знач КомпонентыОбмена,
																			  ОбъектМодифицирован)
	Перем ЕПСБУ, Текст, Сообщение, Сообщения, Узел, Запись;

	ОбъектМодифицирован = Ложь;
	Узел = КомпонентыОбмена.УзелКорреспондента;
	Если (Не ПустаяСтрока(Объект.Комментарий)) Тогда
		Текст = НСтр("ru = 'Не удалось полностью обработать данные из пакета для документа ""%1""!'");
		Текст = СтрШаблон(Текст, СокрЛП(Объект.Ссылка));
		Текст = Текст + Символы.ПС + НСтр("ru = 'см. текст ошибки в комментарии этого документа:'");
		Текст = Текст + Символы.ПС + Объект.Комментарий;
		ВызватьИсключение Текст;
	ИначеЕсли (Не КомпонентыОбмена.ПараметрыКонвертации.ПроверятьПолученныеПроводки) Тогда
		ЗарегистрироватьОбъект(Объект, Узел);
		Возврат;
	КонецЕсли;
	ЕПСБУ = Объект.Движения.ЖурналПроводокЕПСБУ;
	Если (ЕПСБУ.Количество() = 0) Тогда
		ЕПСБУ.Прочитать();
	КонецЕсли;
	Для Каждого Запись Из ЕПСБУ Цикл
		Запись.Активность = Истина;
	КонецЦикла;	
	ЕПСБУ.ДополнительныеСвойства.Вставить("ПропуститьЗаписьВерсииОбъекта");
	ЕПСБУ.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов");
	Попытка
		ОбменДаннымиСервер.УстановитьОбменДаннымиЗагрузка(Объект, Ложь, Ложь, Узел);
		Объект.ДополнительныеСвойства.Вставить("ПропуститьЗаписьВерсииОбъекта");
		Объект.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов");
		Объект.ДополнительныеСвойства.Вставить("ФИБОбменБГУ");
		Сообщения = ПолучитьСообщенияПользователю(Истина);
		Объект.Записать();
		Для Каждого Сообщение Из Сообщения Цикл
			Сообщение.Сообщить();
		КонецЦикла;
	Исключение
		Текст = Новый Массив;
		Текст.Добавить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Сообщения = ПолучитьСообщенияПользователю(Истина);
		Для Каждого Сообщение Из Сообщения Цикл
			Текст.Добавить(Сообщение.Текст);
		КонецЦикла;
		ВызватьИсключение СтрСоединить(Текст, Символы.ПС);
	КонецПопытки;
	ЗарегистрироватьОбъект(Объект, Узел);

КонецПроцедуры

#КонецОбласти

#Область Документ_БюджетныеДанные

// Процедура добавляет обработчики для конвертации данных в бюджетные данные при получении.
//
// Параметры :
//  ПравилаОбработкиДанных - таблица значений, в которую добавляются правила. 
//
Процедура ДобавитьПКО_Документ_БюджетныеДанные_Получение(Знач ПравилаКонвертации)
	Перем ПравилоКонвертации, КонвертацияТабличнойЧасти, НоваяСтрока;

	ПравилоКонвертации = ОбменДаннымиXDTOСервер.ИнициализироватьПравилоКонвертацииОбъекта(ПравилаКонвертации);
	ПравилоКонвертации.ИмяПКО = "Документ_БюджетныеДанные_Получение";
	ПравилоКонвертации.ОбъектДанных = Метаданные.Документы.БюджетныеДанные;
	ПравилоКонвертации.ОбъектФормата = "Документ.БюджетныеДанные";
	ПравилоКонвертации.ПравилоДляГруппыСправочника = Ложь;
	ПравилоКонвертации.ПриКонвертацииДанныхXDTO = "ПКО_Документ_БюджетныеДанные_Получение_ПриКонвертацииДанныхXDTO";
	ПравилоКонвертации.ПередЗаписьюПолученныхДанных = "ПКО_Документ_БюджетныеДанные_Получение_ПередЗаписьюПолученныхДанных";
	ПравилоКонвертации.АлгоритмПоиска = "ПКО_Документ_БюджетныеДанные_Получение_АлгоритмПоиска";
	ПравилоКонвертации.ПослеЗагрузкиВсехДанных = "ПКО_Документ_БюджетныеДанные_Получение_ПослеЗагрузкиВсехДанных";
	ПравилоКонвертации.ВариантИдентификации = "СначалаПоУникальномуИдентификаторуПотомПоПолямПоиска";

	НоваяСтрока = ПравилоКонвертации.Свойства.Добавить();
	НоваяСтрока.СвойствоКонфигурации = "Дата";
	НоваяСтрока.СвойствоФормата = "ДатаДокумента";

	НоваяСтрока = ПравилоКонвертации.Свойства.Добавить();
	НоваяСтрока.СвойствоКонфигурации = "Организация";
	НоваяСтрока.СвойствоФормата = "Организация";
	НоваяСтрока.ПравилоКонвертацииСвойства = "Справочник_Организация_Получение";

	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		НоваяСтрока = ПравилоКонвертации.Свойства.Добавить();
		НоваяСтрока.СвойствоКонфигурации = "ИФО";
		НоваяСтрока.СвойствоФормата = "ИФО";
		НоваяСтрока.ПравилоКонвертацииСвойства = "Справочник_ИФО_Получение";
	КонецЕсли;	
	
	НоваяСтрока = ПравилоКонвертации.Свойства.Добавить();
	НоваяСтрока.СвойствоКонфигурации = "ЛицевойСчет";
	НоваяСтрока.СвойствоФормата = "ЛицевойСчет";
	НоваяСтрока.ПравилоКонвертацииСвойства = "Справочник_ЛицевойСчет_Получение";
	
	НоваяСтрока = ПравилоКонвертации.Свойства.Добавить();
	НоваяСтрока.СвойствоКонфигурации = "РазделЛицевогоСчета";
	НоваяСтрока.СвойствоФормата = "";
	НоваяСтрока.ИспользуетсяАлгоритмКонвертации = Истина;
	
	НоваяСтрока = ПравилоКонвертации.Свойства.Добавить();
	НоваяСтрока.СвойствоКонфигурации = "ВидДанных";
	НоваяСтрока.СвойствоФормата = "";
	НоваяСтрока.ИспользуетсяАлгоритмКонвертации = Истина;
	
	НоваяСтрока = ПравилоКонвертации.Свойства.Добавить();
	НоваяСтрока.СвойствоКонфигурации = "НомерПервичногоДокумента";
	НоваяСтрока.СвойствоФормата = "НомерПервичногоДокумента";
	
	НоваяСтрока = ПравилоКонвертации.Свойства.Добавить();
	НоваяСтрока.СвойствоКонфигурации = "ДатаПервичногоДокумента";
	НоваяСтрока.СвойствоФормата = "ДатаПервичногоДокумента";
	
	НоваяСтрока = ПравилоКонвертации.Свойства.Добавить();
	НоваяСтрока.СвойствоКонфигурации = "ВидПервичногоДокумента";
	НоваяСтрока.СвойствоФормата = "ВидПервичногоДокумента";
	
	НоваяСтрока = ПравилоКонвертации.Свойства.Добавить();
	НоваяСтрока.СвойствоКонфигурации = "ДатаВведенияВДействиеАссигнований";
	НоваяСтрока.СвойствоФормата = "ДатаВведенияВДействиеАссигнований";
	
	НоваяСтрока = ПравилоКонвертации.Свойства.Добавить();
	НоваяСтрока.СвойствоКонфигурации = "ДатаВведенияВДействиеЛБО";
	НоваяСтрока.СвойствоФормата = "ДатаВведенияВДействиеЛБО";
	
