// Обработчик сохраняет данные из пакета XDTO в договор.
//
// Параметры :
//	ДанныеXDTO - Структура - с данными объекта XDTO.
//	ПолученныеДанные - СправочникОбъект.Договоры - новый объект информационной базы.
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализированные в рамках 
//								   выполнения сеанса обмена.
//
Процедура ПКО_Справочник_Договор_Получение_ПриКонвертацииДанныхXDTO(Знач ДанныеXDTO,
																	Знач ПолученныеДанные,
																	Знач КомпонентыОбмена)
	Перем ВД, Знч;
	
	// Конкурсные процедуры.
	Знч = ДанныеXDTO.Свойство("ЗаключаетсяПоРезультатамКонкурсныхПроцедур", Знч) И (Знч = Истина);
	ПолученныеДанные.ЗаключаетсяПоРезультатамКонкурсныхПроцедур = Знч;
	// Вид договора.
	ВД = НРег(СокрЛП(КлючевойРеквизит(ДанныеXDTO, "ВидДоговора")));
	Если ПустаяСтрока(ВД) Тогда
		ВД = НРег(СокрЛП(ПолученныеДанные.ВидОбязательства));
	КонецЕсли;	
	Если (ВД = "контракт") Тогда
		ПолученныеДанные.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком;
		Если ПолученныеДанные.ЗаключаетсяПоРезультатамКонкурсныхПроцедур Тогда
			ПолученныеДанные.ПризнакЗавершенияКонкурсныхПроцедур = Истина;
			ПолученныеДанные.РезультатЗавершенияКонкурсныхПроцедур = 1;
		Иначе
			ПолученныеДанные.ПризнакЗавершенияКонкурсныхПроцедур = Ложь;
			ПолученныеДанные.РезультатЗавершенияКонкурсныхПроцедур = 0;
		КонецЕсли;	
	ИначеЕсли (ВД = "проект контракта") Тогда
		ПолученныеДанные.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком;
		ПолученныеДанные.ЗаключаетсяПоРезультатамКонкурсныхПроцедур = Истина;
		ПолученныеДанные.ПризнакЗавершенияКонкурсныхПроцедур = Истина;
		ПолученныеДанные.РезультатЗавершенияКонкурсныхПроцедур = 1;
	ИначеЕсли (ВД = "договор") Тогда
		ПолученныеДанные.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком;
		Знч = ДанныеXDTO.Свойство("ЗаключаетсяПоРезультатамКонкурсныхПроцедур", Знч) И (Знч = Истина);
		Если ПолученныеДанные.ЗаключаетсяПоРезультатамКонкурсныхПроцедур Тогда
			ПолученныеДанные.ПризнакЗавершенияКонкурсныхПроцедур = Истина;
			ПолученныеДанные.РезультатЗавершенияКонкурсныхПроцедур = 1;
		Иначе
			ПолученныеДанные.ПризнакЗавершенияКонкурсныхПроцедур = Ложь;
			ПолученныеДанные.РезультатЗавершенияКонкурсныхПроцедур = 0;
		КонецЕсли;	
	ИначеЕсли (ВД = "соглашение") Тогда
		ПолученныеДанные.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ИноеОбязательство;
		ПолученныеДанные.ЗаключаетсяПоРезультатамКонкурсныхПроцедур = Ложь;
		ПолученныеДанные.ПризнакЗавершенияКонкурсныхПроцедур = Ложь;
		ПолученныеДанные.РезультатЗавершенияКонкурсныхПроцедур = 0;
	ИначеЕсли (ВД = "нормативный правовой акт") Тогда
		ПолученныеДанные.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ИноеОбязательство;
		ПолученныеДанные.ЗаключаетсяПоРезультатамКонкурсныхПроцедур = Ложь;
		ПолученныеДанные.ПризнакЗавершенияКонкурсныхПроцедур = Ложь;
		ПолученныеДанные.РезультатЗавершенияКонкурсныхПроцедур = 0;
	ИначеЕсли (ВД = "исполнительный документ") Тогда
		ПолученныеДанные.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ИноеОбязательство;
		ПолученныеДанные.ЗаключаетсяПоРезультатамКонкурсныхПроцедур = Ложь;
		ПолученныеДанные.ПризнакЗавершенияКонкурсныхПроцедур = Ложь;
		ПолученныеДанные.РезультатЗавершенияКонкурсныхПроцедур = 0;
	ИначеЕсли (ВД = "решение налогового органа") Тогда
		ПолученныеДанные.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ИноеОбязательство;
		ПолученныеДанные.ЗаключаетсяПоРезультатамКонкурсныхПроцедур = Ложь;
		ПолученныеДанные.ПризнакЗавершенияКонкурсныхПроцедур = Ложь;
		ПолученныеДанные.РезультатЗавершенияКонкурсныхПроцедур = 0;
	ИначеЕсли (ВД = "извещение об осуществлении закупки") Тогда
		ПолученныеДанные.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком;
		ПолученныеДанные.ЗаключаетсяПоРезультатамКонкурсныхПроцедур = Истина;
		ПолученныеДанные.ПризнакЗавершенияКонкурсныхПроцедур = Ложь;
		ПолученныеДанные.РезультатЗавершенияКонкурсныхПроцедур = 0;
	ИначеЕсли (ВД = "приглашение принять участие в определении поставщика (подрядчика, исполнителя)") Тогда
		ПолученныеДанные.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком;
		ПолученныеДанные.ЗаключаетсяПоРезультатамКонкурсныхПроцедур = Истина;
		ПолученныеДанные.ПризнакЗавершенияКонкурсныхПроцедур = Ложь;
		ПолученныеДанные.РезультатЗавершенияКонкурсныхПроцедур = 0;
	Иначе
		ПолученныеДанные.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ИноеОбязательство;
		Если ПолученныеДанные.ЗаключаетсяПоРезультатамКонкурсныхПроцедур Тогда
			ПолученныеДанные.ПризнакЗавершенияКонкурсныхПроцедур = Истина;
			ПолученныеДанные.РезультатЗавершенияКонкурсныхПроцедур = 1;
		Иначе
			ПолученныеДанные.ПризнакЗавершенияКонкурсныхПроцедур = Ложь;
			ПолученныеДанные.РезультатЗавершенияКонкурсныхПроцедур = 0;
		КонецЕсли;	
	КонецЕсли;
	// Наименование договора.
	ПолученныеДанные.Наименование = СокрЛП(КлючевойРеквизит(ДанныеXDTO, "ВидДоговора")) + " " + НСтр("ru = '№'") 
									+ СокрЛП(КлючевойРеквизит(ДанныеXDTO, "НомерДоговора")) + " " + НСтр("ru = 'от'")
									+ " " + Формат(КлючевойРеквизит(ДанныеXDTO, "ДатаДоговора"), "ДФ=dd.MM.yyyy");
	// Учетный номер.
	Знч = СокрЛП(КлючевойРеквизит(ДанныеXDTO, "НомерОбязательства"));
	Если (Не ПустаяСтрока(Знч)) Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("УчетныйНомер", Знч);
	КонецЕсли;	
	
КонецПроцедуры

// Обработчик записывает данные из пакета XDTO в договор.
// 
// Параметры :
//	ДанныеИБ - СправочникОбъект.Договоры - объект информационной базы.
//	ПолученныеДанные - СправочникОбъект.Договоры - новый объект информационной базы.
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализированные в рамках 
//								   выполнения сеанса обмена.
//
Процедура ПКО_Справочник_Договор_Получение_ПередЗаписьюПолученныхДанных(Знач ДанныеИБ,
																		Знач ПолученныеДанные,
																		Знач КомпонентыОбмена)
	Перем Флаг, УчетныйНомер, Ссылка;

	УстановитьОтключениеБезопасногоРежима(Истина);
	УстановитьПривилегированныйРежим(Истина);
	Если ПолученныеДанные.ДополнительныеСвойства.Свойство("УчетныйНомер", УчетныйНомер) Тогда
		УчетныйНомер = СокрЛП(УчетныйНомер);
	Иначе	
		УчетныйНомер = "";
	КонецЕсли;
	Если (ДанныеИБ = Неопределено) Тогда
		ПолученныеДанные.УстановитьНовыйКод();
		Если (Не ПустаяСтрока(УчетныйНомер)) Тогда
			Ссылка = ПолученныеДанные.Ссылка;
			Если Ссылка.Пустая() Тогда
				Ссылка = ПолученныеДанные.ПолучитьСсылкуНового();
				Если Ссылка.Пустая() Тогда
					Ссылка = Справочники.Договоры.ПолучитьСсылку();
					ПолученныеДанные.УстановитьСсылкуНового(Ссылка);
				КонецЕсли;
			КонецЕсли;
			ДобавитьУчетныйНомер(УчетныйНомер, Ссылка);
		КонецЕсли;	
	Иначе
		Флаг = (ПолученныеДанные.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ИноеОбязательство);
		Флаг = Флаг И (Не ДанныеИБ.ВидДоговора.Пустая());
		Если Флаг Тогда
			ПолученныеДанные.ВидДоговора = ДанныеИБ.ВидДоговора;
			ПолученныеДанные.ЗаключаетсяПоРезультатамКонкурсныхПроцедур = ДанныеИБ.ЗаключаетсяПоРезультатамКонкурсныхПроцедур;
			ПолученныеДанные.ПризнакЗавершенияКонкурсныхПроцедур = ДанныеИБ.ПризнакЗавершенияКонкурсныхПроцедур;
			ПолученныеДанные.РезультатЗавершенияКонкурсныхПроцедур = ДанныеИБ.РезультатЗавершенияКонкурсныхПроцедур;
		КонецЕсли;
		ДобавитьУчетныйНомер(УчетныйНомер, ДанныеИБ.Ссылка);
	КонецЕсли;	

КонецПроцедуры

#КонецОбласти

