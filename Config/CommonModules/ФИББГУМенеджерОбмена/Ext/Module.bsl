// Функция возвращает код элемента справочника.
//
// Параметры:
//  Ссылка - СправочникСсылка.
//
// Возвращаемое значение :
//	Строка.
//
Функция ПолучитьКод(Знач Ссылка)
	
	Если (Не ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Ссылка))) Тогда
		Возврат "";
	ИначеЕсли Ссылка.Пустая() Тогда
		Возврат "";
	Иначе
		Возврат ФИББГУМенеджерОбменаПовтИсп.ПолучитьКод(Ссылка);
	КонецЕсли;	

КонецФункции

// Функция выполняет замену фиксированных структур на структуры и возвращает в результате.
//
// Параметры :
//	Значение - ФиксированнаяСтруктура.
//
// Возвращаемое значение :
//	Структура.
//
Функция ЗаменитьФиксированныеСтруктурыНаСтруктуры(Знач Значение)
	Перем Имена, Рез;
	
	Рез = Новый Структура(Значение);
	Имена = Новый Массив;
	Для Каждого Элем Из Рез Цикл
		Если (ТипЗнч(Элем.Значение) = Тип("ФиксированнаяСтруктура")) Тогда
			Имена.Добавить(Элем.Ключ);
		КонецЕсли;	
	КонецЦикла;
	Для Каждого Элем Из Имена Цикл
		Рез[Элем] = ЗаменитьФиксированныеСтруктурыНаСтруктуры(Рез[Элем]);
	КонецЦикла;
	Возврат Рез;
	
КонецФункции	
	
// Функция возвращает реквизиты КПС.
//
// Параметры:
//  Ссылка - СправочникСсылка.КлассификационныеПризнакиСчетов - классификационный признак счета.
//	ЭтоБМО - Булево - это обмен с БМО.
//
// Возвращаемое значение :
//	Структура, Неопределено.
//
Функция ПолучитьРеквизитыКПС(Знач Ссылка, Знач ЭтоБМО)
	Перем Рез;
	
	Если ЭтоБМО Тогда
		Рез = ФИББГУМенеджерОбменаПовтИсп.ПолучитьРеквизитыКПС(Ссылка, Ложь);
		Если (Рез = Неопределено) Тогда
			Возврат Рез;
		КонецЕсли;
		Рез = Новый Структура(Рез);
	Иначе
		Рез = ФИББГУМенеджерОбменаПовтИсп.ПолучитьРеквизитыКПС(Ссылка, Истина);
		Если (Рез = Неопределено) Тогда
			Возврат Рез;
		КонецЕсли;	
		Рез = ЗаменитьФиксированныеСтруктурыНаСтруктуры(Рез);
	КонецЕсли;
	Если ПустаяСтрока(Рез.Тип) Тогда
		Рез.Удалить("Тип");
	КонецЕсли;
	Возврат Рез;

КонецФункции

// Функция возвращает реквизиты справочника с кодом.
//
// Параметры:
//  Ссылка - СправочникСсылка.
//
// Возвращаемое значение :
//	Структура, Неопределено.
//
Функция ПолучитьРеквизитыКода(Знач Ссылка)
	Перем Код, Рез;
	
	Код = ПолучитьКод(Ссылка);
	Если ПустаяСтрока(Код) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Рез = Новый Структура;
	Рез.Вставить("Ссылка", Ссылка);	
	Рез.Вставить("Код", Код);
	Возврат Рез;
	
КонецФункции	

// Функция возвращает реквизиты учреждения.
//
// Параметры:
//  Ссылка - СправочникСсылка.Организации - учреждение.
//
// Возвращаемое значение :
//	Структура, Неопределено.
//
Функция ПолучитьРеквизитыОрганизации(Знач Ссылка)
	Перем Реквизиты, Рез, Стр;

	Реквизиты = ФИББГУМенеджерОбменаПовтИсп.ПолучитьРеквизитыКонтрагента(Ссылка);
	Если (Реквизиты = Неопределено) Тогда
		Возврат Неопределено;
	ИначеЕсли ПустаяСтрока(Реквизиты.Код) Тогда
		Возврат Неопределено;
	КонецЕсли;	
	Рез = Новый Структура;
	Рез.Вставить("Ссылка", Ссылка);
	Рез.Вставить("Код", Реквизиты.Код);
	Если (Не ПустаяСтрока(Реквизиты.ИНН)) Тогда
		Рез.Вставить("ИНН", Реквизиты.ИНН);
		Если (Не ПустаяСтрока(Реквизиты.КПП)) Тогда
			Рез.Вставить("КПП", Реквизиты.КПП);
		КонецЕсли;	
	КонецЕсли;
	Если (Не ПустаяСтрока(Реквизиты.КодБюджета)) Тогда
		Стр = Новый Структура;
		Стр.Вставить("Ссылка", Реквизиты.Бюджет);
		Стр.Вставить("Код", Реквизиты.КодБюджета);
		Рез.Вставить("Бюджет", Стр);
	КонецЕсли;
	Возврат Рез;
	
КонецФункции	

// Функция возвращает реквизиты договора.
//
// Параметры:
//  Ссылка - СправочникСсылка.Договоры - договор.
//
// Возвращаемое значение :
//	Структура, Неопределено.
//
Функция ПолучитьРеквизитыДоговора(Знач Ссылка)
	Перем Рез, Знч;

	Если (ТипЗнч(Ссылка) <> Тип("СправочникСсылка.Договоры")) Тогда
		Возврат Неопределено;
	ИначеЕсли Ссылка.Пустая() Тогда
		Возврат Неопределено;
	КонецЕсли;	
	Рез = ФИББГУМенеджерОбменаПовтИсп.ПолучитьРеквизитыДоговора(Ссылка);
	Если (Рез = Неопределено) Тогда
		Возврат Неопределено;
	КонецЕсли;	
	Рез = Новый Структура(Рез);
	Рез.Вставить("Ссылка", Ссылка);
	Знч = ПолучитьРеквизитыОрганизации(Рез.Организация);
	Если (Знч <> Неопределено) Тогда
		Рез.Вставить("Организация", Знч);
	КонецЕсли;
	Возврат Рез;
	
КонецФункции	

// Функция возвращает реквизиты контрагента.
//
// Параметры:
//  Ссылка - СправочникСсылка.Контрагенты - контрагент.
//
// Возвращаемое значение :
//	Структура, Неопределено.
//
Функция ПолучитьРеквизитыКонтрагента(Знач Ссылка)
	Перем Знч, Рез;

	Если (ТипЗнч(Ссылка) = Тип("СправочникСсылка.Договоры")) Тогда
		Если Ссылка.Пустая() Тогда
			Возврат Неопределено;
		КонецЕсли;	
		Знч = ФИББГУМенеджерОбменаПовтИсп.ПолучитьРеквизитыКонтрагента(Ссылка);
	ИначеЕсли (ТипЗнч(Ссылка) = Тип("СправочникСсылка.Контрагенты")) Тогда
		Если Ссылка.Пустая() Тогда
			Возврат Неопределено;
		КонецЕсли;	
		Знч = ФИББГУМенеджерОбменаПовтИсп.ПолучитьРеквизитыКонтрагента(Ссылка);
	Иначе
		Возврат Неопределено;
	КонецЕсли;	
	Если (Знч = Неопределено) Тогда
		Возврат Неопределено;
	ИначеЕсли ПустаяСтрока(Знч.ИНН) Тогда
		Возврат Неопределено;
	КонецЕсли;	
	Рез = Новый Структура;
	Рез.Вставить("Ссылка", Знч.Контрагент);
	Рез.Вставить("ИНН", Знч.ИНН);
	Если (Не ПустаяСтрока(Знч.КПП)) Тогда
		Рез.Вставить("КПП", Знч.КПП);
	КонецЕсли;
	Если (Не ПустаяСтрока(Знч.Код)) Тогда
		Рез.Вставить("КодУчреждения", Знч.Код);
	КонецЕсли;
	Возврат Рез;
	
КонецФункции	

// Функция возвращает реквизиты контрагента.
//
// Параметры:
//  Ссылка - СправочникСсылка.Контрагенты - контрагент.
//
// Возвращаемое значение :
//	Структура, Неопределено.
//
Функция ПолучитьРеквизитыЛицевогоСчета(Знач Ссылка)
	Перем Код, Владелец, Рез;

	Если (ТипЗнч(Ссылка) <> Тип("СправочникСсылка.ЛицевыеСчета")) Тогда
		Возврат Неопределено;
	ИначеЕсли Ссылка.Пустая() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Код = ФИББГУМенеджерОбменаПовтИсп.ПолучитьКод(Ссылка);
	Если ПустаяСтрока(Код) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Владелец = ФИББГУМенеджерОбменаПовтИсп.ПолучитьВладельца(Ссылка);
	Владелец = ПолучитьРеквизитыОрганизации(Владелец);
	Если (Владелец = Неопределено) Тогда
		Возврат Неопределено;
	КонецЕсли;	
	Рез = Новый Структура;
	Рез.Вставить("Ссылка", Ссылка);
	Рез.Вставить("Владелец", Владелец);
	Рез.Вставить("Код", СокрЛП(Лев(СокрЛП(Код), 20)));
	Возврат Рез;
	
КонецФункции	

// Функция проверяет наличие реквизитов в структуре.
// 
// Параметры :
//	Реквизиты - Структура.
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализированные в рамках 
//								   выполнения сеанса обмена.
//
// Возвращаемое значение :
//	Булево.
//
Функция ПустыеРеквизиты(Знач Реквизиты, Знач КомпонентыОбмена)
	Перем Элем, Рез, Удалить, Длины, Знч;
	
	Рез = Истина;
	Удалить = Новый Массив;
	Для Каждого Элем Из Реквизиты Цикл
		Если ПустаяСтрока(Элем.Значение) Тогда
			Удалить.Добавить(Элем.Ключ);
		Иначе
			Рез = Ложь;
		КонецЕсли;
	КонецЦикла;
	Если (Не Рез) Тогда
		Для Каждого Элем Из Удалить Цикл
			Реквизиты.Удалить(Элем);
		КонецЦикла;
		Длины = КомпонентыОбмена.ПараметрыКонвертации.ОграниченияДлиныПлатежныхРеквизитов;
		Если (Длины = Неопределено) Тогда
			Длины = Новый Структура;
			Длины.Вставить("Плательщик", 160);
			Длины.Вставить("ПлательщикИНН", 12);
			Длины.Вставить("ПлательщикКПП", 9);
			Длины.Вставить("ПлательщикРС", 20);
			Длины.Вставить("ПлательщикБИК", 9);
			Длины.Вставить("ПлательщикБанк", 160);
			Длины.Вставить("ПлательщикКоррсчет", 20);
			Длины.Вставить("Получатель", 160);
			Длины.Вставить("ПолучательИНН", 12);
			Длины.Вставить("ПолучательКПП", 9);
			Длины.Вставить("ПолучательРС", 20);
			Длины.Вставить("ПолучательБИК", 9);
			Длины.Вставить("ПолучательБанк", 160);
			Длины.Вставить("ПолучательКоррсчет", 20);
			Длины.Вставить("НазначениеПлатежа", 210);
			Длины.Вставить("УИН", 25);
			Длины.Вставить("ПНСтатусСоставителя", 2);
			Длины.Вставить("ПНКодБК", 20);
			Длины.Вставить("ПНПоказательОснования", 2);
			Длины.Вставить("ПНПоказательПериода", 10);
			Длины.Вставить("ПНПоказательТипа", 2);
			Длины.Вставить("ПНПоказательНомера", 18);
			Длины.Вставить("ПНПоказательДаты", 10);
			КомпонентыОбмена.ПараметрыКонвертации.ОграниченияДлиныПлатежныхРеквизитов = Длины;
		КонецЕсли;	
		Для Каждого Элем Из Длины Цикл
			Если Реквизиты.Свойство(Элем.Ключ, Знч) Тогда
				Если (СтрДлина(Знч) > Элем.Значение) Тогда
					Знч = Лев(СокрЛП(Знч), Элем.Значение);
					Реквизиты.Вставить(Элем.Ключ, Знч);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Рез;

КонецФункции

