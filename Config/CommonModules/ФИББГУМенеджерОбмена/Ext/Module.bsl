// Обработчик сохраняет данные из пакета XDTO в кассовое поступление.
//
// Параметры :
//	ДанныеXDTO - Структура - с данными объекта XDTO.
//	ПолученныеДанные - ДокументОбъект.КассовоеПоступление - новый объект информационной базы.
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализированные в рамках 
//								   выполнения сеанса обмена.
//
Процедура ПКО_Документ_КассовоеПоступление_Получение_ПриКонвертацииДанныхXDTO(Знач ДанныеXDTO,
																		  	  Знач ПолученныеДанные,
																		 	  Знач КомпонентыОбмена)
	Перем Объект, РасшифровкаПлатежа, Знч;

	Объект = ПолученныеДанные;
	Объект.Ответственный = Пользователи.ТекущийПользователь();
	Объект.ИДИсточника = ПолученУИ();
	// Лицевой счет контрагента.
	Если ДанныеXDTO.Свойство("ЛицевойСчетКонтрагента", Знч) Тогда
		Знч = СокрЛП(Знч);
	Иначе
		Знч = "";
	КонецЕсли;	
	Если ПустаяСтрока(Знч) Тогда
		Объект.СчетКонтрагента = НайтиСчетКонтрагента(Объект.Контрагент);
	Иначе	
		Объект.СчетКонтрагента = НайтиСчетКонтрагента(Объект.Контрагент, Знч, Перечисления.ТипыЛицевыхСчетов.Казначейский);
	КонецЕсли;	
	// Передача идентификатора в обработчик перед записью.
	Знч = ИдентификаторXDTO(ДанныеXDTO);
	Если (Не ПустаяСтрока(Знч)) Тогда
		Объект.ДополнительныеСвойства.Вставить("ИдентификаторXDTO", Знч);
	КонецЕсли;	
	// Передача расшифровки в обработчик перед записью.
	Если (ДанныеXDTO.Свойство("РасшифровкаПлатежа", РасшифровкаПлатежа) И (РасшифровкаПлатежа <> Неопределено)) Тогда
		Объект.ДополнительныеСвойства.Вставить("Содержание", РасшифровкаПлатежа);
	КонецЕсли;		
																		  
КонецПроцедуры

// Обработчик выполняет поиск кассового поступления.
//
// Параметры :
//	ДанныеИБ - ДокументСсылка.КассовоеПоступление - найденный объект информационной базы.
//	ПолученныеДанные - Документбъект.КассовоеПоступление - новый объект информационной базы.
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализированные в рамках 
//								   выполнения сеанса обмена.
//
Процедура ПКО_Документ_КассовоеПоступление_Получение_АлгоритмПоиска(ДанныеИБ,
																	Знач ПолученныеДанные,
																	Знач КомпонентыОбмена)
	Перем Текст, Отбор, Таб;															
																
	Если (ДанныеИБ <> Неопределено) Тогда
		Возврат;															
	ИначеЕсли ПолученныеДанные.ДополнительныеСвойства.Свойство("ИдентификаторXDTO", Текст) Тогда
		ДанныеИБ = СсылкаПоИдентификатору(Текст, "Документ.КассовоеПоступление", КомпонентыОбмена.УзелКорреспондента);
		Если (ДанныеИБ <> Неопределено) Тогда
			Возврат;															
		КонецЕсли;	
	КонецЕсли;
	Отбор = Новый Структура;
	Отбор.Вставить("Организация", ПолученныеДанные.Организация);
	Отбор.Вставить("ИФО", ПолученныеДанные.ИФО);
	Отбор.Вставить("Дата", НачалоДня(ПолученныеДанные.Дата));
	Отбор.Вставить("ВидПервичногоДокумента", ПолученныеДанные.ВидПервичногоДокумента);
	Отбор.Вставить("НомерПервичногоДокумента", ПолученныеДанные.НомерПервичногоДокумента);
	Отбор.Вставить("ДатаПервичногоДокумента", НачалоДня(ПолученныеДанные.ДатаПервичногоДокумента));
	Отбор.Вставить("Узел", КомпонентыОбмена.УзелКорреспондента);
	Отбор.Вставить("ИУИ", ИзмененУИ());
	Отбор.Вставить("ПУИ", ПолученУИ());
	Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
			|	Док.Ссылка КАК Ссылка
			|ИЗ	Документ.КассовоеПоступление КАК Док
			|ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов КАК ПИ
			|ПО (ПИ.Ссылка = Док.Ссылка) И (ПИ.УзелИнформационнойБазы = &Узел)
			|ГДЕ (Док.Организация = &Организация) И (ПИ.Ссылка ЕСТЬ NULL)
			|  И (Док.ВидПервичногоДокумента = &ВидПервичногоДокумента)
			|  И (Док.НомерПервичногоДокумента = &НомерПервичногоДокумента)
			|  И (НАЧАЛОПЕРИОДА(Док.ДатаПервичногоДокумента, ДЕНЬ) = &ДатаПервичногоДокумента)
			|  И (НАЧАЛОПЕРИОДА(Док.Дата, ДЕНЬ) = &Дата)
			|  И ((Док.ИДИсточника = &ИУИ) ИЛИ (Док.ИДИсточника = &ПУИ))
			|  И ((Док.ИФО = &ИФО) ИЛИ (&ИФО = ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)))
			|УПОРЯДОЧИТЬ ПО Док.ПометкаУдаления, (Док.ИФО <> &ИФО)";
	Таб = ПолучитьДанные(Текст, Отбор);
	Если (Таб.Количество() <> 0) Тогда
		ДанныеИБ = Таб[0].Ссылка;
	КонецЕсли;	

КонецПроцедуры

// Обработчик записывает данные из пакета XDTO в кассовое поступление.
// 
// Параметры :
//	ДанныеИБ - ДокументОбъект.КассовоеПоступление - объект информационной базы.
//	ПолученныеДанные - ДокументОбъект.КассовоеПоступление - новый объект информационной базы.
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализированные в рамках 
//								   выполнения сеанса обмена.
//	Пропустить - Булево - пропустить объект.
//
Процедура ПКО_Документ_КассовоеПоступление_Получение_ПередЗаписьюПолученныхДанных(Знач ДанныеИБ,
																				  Знач ПолученныеДанные,
																				  Знач КомпонентыОбмена,
																				  Пропустить)
	Перем Объект, Запись, Новая, Сч, Колво, РасшифровкаПлатежа, Стр, Начало, Узел;

	Если (ДанныеИБ = Неопределено) Тогда
		ПолученныеДанные.УстановитьНовыйНомер();
	ИначеЕсли (ДанныеИБ.ИДИсточника = ИзмененУИ()) Тогда
		Узел = КомпонентыОбмена.УзелКорреспондента;
		ЗарегистрироватьОбъект(ДанныеИБ, Узел);
		Пропустить = Истина;
		Если ПолученныеДанные.ДополнительныеСвойства.Свойство("ИдентификаторXDTO", Стр) Тогда
			Если (Не ОбъектУчаствовалВОбмене(ДанныеИБ.Ссылка, Узел)) Тогда
				ДобавитьИдентификаторXDTO(ДанныеИБ.Ссылка, Узел, Стр);
			КонецЕсли;
		КонецЕсли;	
		Возврат;
	КонецЕсли;
	// Заполнение расшифровки нужно выполнять перед записью, т.к. при конвертации объекты ее не созданы в базе данных.	
	Объект = ПолученныеДанные;
	Если (Объект.ДополнительныеСвойства.Свойство("Содержание", РасшифровкаПлатежа) И (РасшифровкаПлатежа <> Неопределено)) Тогда
		Колво = РасшифровкаПлатежа.Количество() - 1;
		Для Сч=0 По Колво Цикл
			Начало = Ложь;
			Запись = РасшифровкаПлатежа[Сч];
			Новая = Объект.РасшифровкаПлатежа[Сч];
			// КФО.
			Новая.КФО = КФО(Запись.КФО);
			Если (Новая.КФО.Пустая() И (Не ПустаяСтрока(Запись.КФО))) Тогда
				Стр = СтрШаблон(НСтр("ru = 'По коду ""%1"" не найден КФО'"), Запись.КФО);
				Если НетТекстаВКомментарии(Объект, Стр) Тогда
					ДобавитьКомментарий(Объект, ТекстСНомеромСтроки(Сч + 1, Начало) + Стр);
				КонецЕсли;	
			КонецЕсли;
			// Заполнение КБК.
			Стр = НайтиКПС(Запись.КБКНазначениеПлатежа, Объект.Дата, Новая.КФО, КомпонентыОбмена);
			Если (ТипЗнч(Стр) <> Тип("Строка")) Тогда
				Новая.КБКНазначениеПлатежа = Стр;
			ИначеЕсли НетТекстаВКомментарии(Объект, Стр) Тогда
				ДобавитьКомментарий(Объект, ТекстСНомеромСтроки(Сч + 1, Начало) + Стр);
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;		
	Если (ДанныеИБ <> Неопределено) Тогда
		ЗаполнитьЗначенияСвойств(ДанныеИБ, Объект,, "Номер");
		ДанныеИБ.РасшифровкаПлатежа.Очистить();
		Для Каждого Запись Из Объект.РасшифровкаПлатежа Цикл
			ЗаполнитьЗначенияСвойств(ДанныеИБ.РасшифровкаПлатежа.Добавить(), Запись); 
		КонецЦикла;	
	КонецЕсли;	
																			  
КонецПроцедуры

// Обработчик для дополнительной обработки после загрузки данных в кассовое поступление.
// 
// Параметры :
//	Объект - ДокументОбъект.КассовоеПоступление - объект информационной базы.
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализированные в рамках 
//								   выполнения сеанса обмена.
//	ОбъектМодифицирован - Булево - модифицированность объекта.
//
Процедура ПКО_Документ_КассовоеПоступление_Получение_ПослеЗагрузкиВсехДанных(Знач Объект,
																			 Знач КомпонентыОбмена,
																			 ОбъектМодифицирован)
	Перем Узел;

	ОбъектМодифицирован = Ложь;
	Узел = КомпонентыОбмена.УзелКорреспондента;
	ЗарегистрироватьОбъект(Объект, Узел);

КонецПроцедуры

