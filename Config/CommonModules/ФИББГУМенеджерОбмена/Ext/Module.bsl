	НоваяСтрока.СвойствоФормата = "НаименованиеМеждународное";

	НоваяСтрока = ПравилоКонвертации.Свойства.Добавить();
	НоваяСтрока.СвойствоКонфигурации = "НаименованиеПолное";
	НоваяСтрока.СвойствоФормата = "НаименованиеПолное";

	НоваяСтрока = ПравилоКонвертации.Свойства.Добавить();
	НоваяСтрока.СвойствоКонфигурации = "НациональноеСокращение";
	НоваяСтрока.СвойствоФормата = "НациональноеСокращение";

	ПравилоКонвертации.ПоляПоиска.Добавить("Код");
	ПравилоКонвертации.ПоляПоиска.Добавить("Наименование");

КонецПроцедуры

#КонецОбласти

#Область Справочник_Контрагент

// Процедура добавляет обработчики для конвертации данных в контрагента при получении.
//
// Параметры :
//  ПравилаОбработкиДанных - таблица значений, в которую добавляются правила. 
//
Процедура ДобавитьПКО_Справочник_Контрагент_Получение(Знач ПравилаКонвертации)
	Перем ПравилоКонвертации, НоваяСтрока;

	ПравилоКонвертации = ОбменДаннымиXDTOСервер.ИнициализироватьПравилоКонвертацииОбъекта(ПравилаКонвертации);
	ПравилоКонвертации.ИмяПКО = "Справочник_Контрагент_Получение";
	ПравилоКонвертации.ОбъектДанных = Метаданные.Справочники.Контрагенты;
	ПравилоКонвертации.ОбъектФормата = "Справочник.Контрагенты";
	ПравилоКонвертации.ПравилоДляГруппыСправочника = Ложь;
	ПравилоКонвертации.ПриКонвертацииДанныхXDTO = "ПКО_Справочник_Контрагент_Получение_ПриКонвертацииДанныхXDTO";
	ПравилоКонвертации.ПередЗаписьюПолученныхДанных = "ПКО_Справочник_Контрагент_Получение_ПередЗаписьюПолученныхДанных";
	ПравилоКонвертации.ВариантИдентификации = "СначалаПоУникальномуИдентификаторуПотомПоПолямПоиска";

	НоваяСтрока = ПравилоКонвертации.Свойства.Добавить();
	НоваяСтрока.СвойствоКонфигурации = "ИНН";
	НоваяСтрока.СвойствоФормата = "ИНН";

	НоваяСтрока = ПравилоКонвертации.Свойства.Добавить();
	НоваяСтрока.СвойствоКонфигурации = "КПП";
	НоваяСтрока.СвойствоФормата = "КПП";
	
	НоваяСтрока = ПравилоКонвертации.Свойства.Добавить();
	НоваяСтрока.СвойствоКонфигурации = "Наименование";
	НоваяСтрока.СвойствоФормата = "Наименование";

	НоваяСтрока = ПравилоКонвертации.Свойства.Добавить();
	НоваяСтрока.СвойствоКонфигурации = "НаименованиеСокращенное";
	НоваяСтрока.СвойствоФормата = "Наименование";

	НоваяСтрока = ПравилоКонвертации.Свойства.Добавить();
	НоваяСтрока.СвойствоКонфигурации = "ВидКонтрагента";
	НоваяСтрока.СвойствоФормата = "";
	НоваяСтрока.ИспользуетсяАлгоритмКонвертации = Истина;

	НоваяСтрока = ПравилоКонвертации.Свойства.Добавить();
	НоваяСтрока.СвойствоКонфигурации = "ТипКонтрагента";
	НоваяСтрока.СвойствоФормата = "";
	НоваяСтрока.ИспользуетсяАлгоритмКонвертации = Истина;

	ПравилоКонвертации.ПоляПоиска.Добавить("ИНН,КПП");
	ПравилоКонвертации.ПоляПоиска.Добавить("ИНН");

КонецПроцедуры

// Обработчик сохраняет данные из пакета XDTO в контрагента.
//
// Параметры :
//	ДанныеXDTO - Структура - с данными объекта XDTO.
//	ПолученныеДанные - СправочникОбъект.Контрагенты - новый объект информационной базы.
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализированные в рамках 
//								   выполнения сеанса обмена.
//
Процедура ПКО_Справочник_Контрагент_Получение_ПриКонвертацииДанныхXDTO(Знач ДанныеXDTO,
																	   Знач ПолученныеДанные,
																	   Знач КомпонентыОбмена)
	Перем Знч, Бюджет;
	
	// Передача кода УБП для создания подчиненных элементов справочников.
	Знч = СокрЛП(КлючевойРеквизит(ДанныеXDTO, "КодУчреждения"));
	Если (Не ПустаяСтрока(Знч)) Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("КодУчреждения", Знч);
	КонецЕсли;
	// Заполнение вида контрагента.
	Если (ДанныеXDTO.Свойство("ЮрЛицо", Знч) И (Знч = "0")) Тогда
		ПолученныеДанные.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо;
	Иначе
		ПолученныеДанные.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо;
	КонецЕсли;
	// Заполнение типа контрагента.
	Если (ДанныеXDTO.Свойство("ТипКонтрагента", Знч) И (Не ПустаяСтрока(Знч))) Тогда
		ПолученныеДанные.ТипКонтрагента = ФИББГУМенеджерОбменаПовтИсп.НайтиТипКонтрагента(Знч);
	КонецЕсли;
	// Передача полного наименования для создания подчиненных элементов справочников.
	Если (ДанныеXDTO.Свойство("НаименованиеПолное", Знч) И (Не ПустаяСтрока(Знч))) Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("НаименованиеПолное", Знч);
	КонецЕсли;
	// Передача ОГРН для создания подчиненных элементов справочников.
	Если (ДанныеXDTO.Свойство("ОГРН", Знч) И (Не ПустаяСтрока(Знч))) Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("ОГРН", Знч);
	КонецЕсли;
	// Передача КодОКПО для создания подчиненных элементов справочников.
	Если (ДанныеXDTO.Свойство("КодОКПО", Знч) И (Не ПустаяСтрока(Знч))) Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("КодОКПО", Знч);
	КонецЕсли;
	// Передача фамилии для заполнения подчиненных структур.
	Если (ДанныеXDTO.Свойство("Фамилия", Знч) И (Не ПустаяСтрока(Знч))) Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("Фамилия", Знч);
	КонецЕсли;
	// Передача имени для заполнения подчиненных структур.
	Если (ДанныеXDTO.Свойство("Имя", Знч) И (Не ПустаяСтрока(Знч))) Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("Имя", Знч);
	КонецЕсли;
	// Передача отчества для заполнения подчиненных структур.
	Если (ДанныеXDTO.Свойство("Отчество", Знч) И (Не ПустаяСтрока(Знч))) Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("Отчество", Знч);
	КонецЕсли;
	// Передача СНИЛС для создания подчиненных элементов справочников.
	Если (ДанныеXDTO.Свойство("СНИЛС", Знч) И (Не ПустаяСтрока(Знч))) Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("СНИЛС", Знч);
	КонецЕсли;
	// Передача бюджета для создания подчиненных элементов справочников.
	Если (ДанныеXDTO.Свойство("Бюджет", Бюджет) И (ТипЗнч(Бюджет) = Тип("Структура"))) Тогда
		Если Бюджет.Свойство("Код", Знч) Тогда
			ПолученныеДанные.ДополнительныеСвойства.Вставить("Бюджет", Знч);
		КонецЕсли;	
	КонецЕсли;

КонецПроцедуры

// Обработчик записывает данные из пакета XDTO в контрагента.
// 
// Параметры :
//	ДанныеИБ - СправочникОбъект.Контрагенты - объект информационной базы.
//	ПолученныеДанные - СправочникОбъект.Контрагенты - новый объект информационной базы.
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализированные в рамках 
//								   выполнения сеанса обмена.
//
Процедура ПКО_Справочник_Контрагент_Получение_ПередЗаписьюПолученныхДанных(Знач ДанныеИБ,
																		   Знач ПолученныеДанные,
																		   Знач КомпонентыОбмена)
	Перем Объект, Знч, Флаг, Рег, Запись;

	УстановитьОтключениеБезопасногоРежима(Истина);
	УстановитьПривилегированныйРежим(Истина);
	// Если объект был в базе, то оставляем некоторые свойства без изменений.
	Если (ДанныеИБ <> Неопределено) Тогда
		ДанныеИБ.ПометкаУдаления = ПолученныеДанные.ПометкаУдаления;
		ПолученныеДанные.ЮридическоеФизическоеЛицо = ДанныеИБ.ЮридическоеФизическоеЛицо;
		ДанныеИБ.ВидКонтрагента = ПолученныеДанные.ВидКонтрагента;
		Если ПолученныеДанные.ТипКонтрагента.Пустая() Тогда
			ПолученныеДанные.ТипКонтрагента = ДанныеИБ.ТипКонтрагента;
		Иначе
			ДанныеИБ.ТипКонтрагента = ПолученныеДанные.ТипКонтрагента;
		КонецЕсли;
	КонецЕсли;
	// Создание подчиненных элементов справочников.	
	Если (ПолученныеДанные.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо) Тогда
		Если (ТипЗнч(ПолученныеДанные.ЮридическоеФизическоеЛицо) <> Тип("СправочникСсылка.ФизическиеЛица")) Тогда
			ПолученныеДанные.ЮридическоеФизическоеЛицо = Неопределено;
		КонецЕсли;
		Если ЗначениеЗаполнено(ПолученныеДанные.ЮридическоеФизическоеЛицо) Тогда
			Объект = ПолученныеДанные.ЮридическоеФизическоеЛицо.ПолучитьОбъект();
		Иначе
			Объект = Неопределено;
		КонецЕсли;
		Если (Объект = Неопределено) Тогда
			Объект = Справочники.ФизическиеЛица.СоздатьЭлемент();
			Объект.Наименование = ПолученныеДанные.Наименование;
			Объект.ИНН = ПолученныеДанные.ИНН;
			Объект.КПП = ПолученныеДанные.КПП;
			Если ПолученныеДанные.ДополнительныеСвойства.Свойство("КодОКПО", Знч) Тогда
				Объект.КодОКПО = Знч;
			КонецЕсли;	
			Если ПолученныеДанные.ДополнительныеСвойства.Свойство("СНИЛС", Знч) Тогда
				Объект.СтраховойНомерПФР = Знч;
			КонецЕсли;	
			Объект.СтранаРегистрации = ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.СтраныМира.Россия");
			Объект.УстановитьНовыйКод();
			Объект.ОбменДанными.Загрузка = Истина;
			Объект.Записать();
			ПолученныеДанные.ЮридическоеФизическоеЛицо = Объект.Ссылка;
		Иначе
			Флаг = Ложь;
			Если (ПолученныеДанные.Наименование <> Объект.Наименование) Тогда
				Объект.Наименование = ПолученныеДанные.Наименование;
				Флаг = Истина;
			КонецЕсли;
			Если (ПолученныеДанные.ИНН <> Объект.ИНН) Тогда
				Объект.ИНН = ПолученныеДанные.ИНН;
				Флаг = Истина;
			КонецЕсли;
			Если (ПолученныеДанные.КПП <> Объект.КПП) Тогда
				Объект.КПП = ПолученныеДанные.КПП;
				Флаг = Истина;
			КонецЕсли;
			Если ПолученныеДанные.ДополнительныеСвойства.Свойство("КодОКПО", Знч) Тогда
				Если (Знч <> Объект.КодОКПО) Тогда
					Объект.КодОКПО = Знч;
					Флаг = Истина;
				КонецЕсли;
			КонецЕсли;
			Если ПолученныеДанные.ДополнительныеСвойства.Свойство("СНИЛС", Знч) Тогда
				Если (Знч <> Объект.СтраховойНомерПФР) Тогда
					Объект.СтраховойНомерПФР = Знч;
					Флаг = Истина;
				КонецЕсли;
			КонецЕсли;
			Если Флаг Тогда
				Объект.ОбменДанными.Загрузка = Истина;
				Объект.Записать();
			КонецЕсли;
		КонецЕсли;
		// ФИО.           
		Знч = ПолученныеДанные.ДополнительныеСвойства;
		Флаг = Знч.Свойство("Фамилия") Или Знч.Свойство("Имя") Или Знч.Свойство("Отчество");
		Если Флаг Тогда
			Рег = РегистрыСведений.ФИОФизическихЛиц.СоздатьНаборЗаписей();
			Рег.Отбор.ФизическоеЛицо.Установить(Объект.Ссылка);
			Запись = Рег.Добавить();
			ЗаполнитьЗначенияСвойств(Запись, Знч);
			Запись.ФизическоеЛицо = Объект.Ссылка;
			Запись.Период = ТекущаяДатаСеанса();
			Рег.ОбменДанными.Загрузка = Истина;
			Рег.Записать(Истина);
		КонецЕсли;	
	Иначе
		Если (ТипЗнч(ПолученныеДанные.ЮридическоеФизическоеЛицо) <> Тип("СправочникСсылка.ЮридическиеЛица")) Тогда
			ПолученныеДанные.ЮридическоеФизическоеЛицо = Неопределено;
		КонецЕсли;
		Если ЗначениеЗаполнено(ПолученныеДанные.ЮридическоеФизическоеЛицо) Тогда
			Объект = ПолученныеДанные.ЮридическоеФизическоеЛицо.ПолучитьОбъект();
		Иначе
			Объект = Неопределено;
		КонецЕсли;
		Если (Объект = Неопределено) Тогда
			Объект = Справочники.ЮридическиеЛица.СоздатьЭлемент();
			Объект.Наименование = ПолученныеДанные.Наименование;
			Объект.НаименованиеПолное = ПолученныеДанные.Наименование;
			Объект.ИНН = ПолученныеДанные.ИНН;
			Объект.КПП = ПолученныеДанные.КПП;
			Если ПолученныеДанные.ДополнительныеСвойства.Свойство("НаименованиеПолное", Знч) Тогда
				Объект.НаименованиеПолное = Знч;
			КонецЕсли;
			Если ПолученныеДанные.ДополнительныеСвойства.Свойство("КодУчреждения", Знч) Тогда
				Объект.КодПоРПБС = Знч;
				Если (Не ПустаяСтрока(Знч)) Тогда
					Знч = "";
					ПолученныеДанные.ДополнительныеСвойства.Свойство("Бюджет", Знч);
					Объект.Бюджет = ФИББГУМенеджерОбменаПовтИсп.НайтиБюджет(Знч);
				КонецЕсли;	
			КонецЕсли;
			Если ПолученныеДанные.ДополнительныеСвойства.Свойство("ОГРН", Знч) Тогда
				Объект.ОГРН = Знч;
			КонецЕсли;	
			Если ПолученныеДанные.ДополнительныеСвойства.Свойство("КодОКПО", Знч) Тогда
				Объект.КодОКПО = Знч;
			КонецЕсли;	
			Объект.СтранаРегистрации = ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.СтраныМира.Россия");
			Объект.УстановитьНовыйКод();
			Объект.ОбменДанными.Загрузка = Истина;
			Объект.Записать();
			ПолученныеДанные.ЮридическоеФизическоеЛицо = Объект.Ссылка;
		Иначе
			Флаг = Ложь;
			Если (ПолученныеДанные.Наименование <> Объект.Наименование) Тогда
				Объект.Наименование = ПолученныеДанные.Наименование;
				Флаг = Истина;
			КонецЕсли;
			Если (ПолученныеДанные.ИНН <> Объект.ИНН) Тогда
				Объект.ИНН = ПолученныеДанные.ИНН;
				Флаг = Истина;
			КонецЕсли;
			Если (ПолученныеДанные.КПП <> Объект.КПП) Тогда
				Объект.КПП = ПолученныеДанные.КПП;
				Флаг = Истина;
			КонецЕсли;
			Если ПолученныеДанные.ДополнительныеСвойства.Свойство("НаименованиеПолное", Знч) Тогда
				Если (Знч <> Объект.НаименованиеПолное) Тогда
					Объект.НаименованиеПолное = Знч;
					Флаг = Истина;
				КонецЕсли;
			КонецЕсли;
			Если ПолученныеДанные.ДополнительныеСвойства.Свойство("КодУчреждения", Знч) Тогда
				Если (Знч <> Объект.КодПоРПБС) Тогда
					Объект.КодПоРПБС = Знч;
					Флаг = Истина;
				КонецЕсли;
			КонецЕсли;
			Если ((Не ПустаяСтрока(Объект.КодПоРПБС)) И ПолученныеДанные.ДополнительныеСвойства.Свойство("Бюджет", Знч)) Тогда
				Знч = ФИББГУМенеджерОбменаПовтИсп.НайтиБюджет(Знч);
				Если (Знч <> Объект.Бюджет) Тогда
					Объект.Бюджет = Знч;
					Флаг = Истина;
				КонецЕсли;
			КонецЕсли;
			Если ПолученныеДанные.ДополнительныеСвойства.Свойство("ОГРН", Знч) Тогда
				Если (Знч <> Объект.ОГРН) Тогда
					Объект.ОГРН = Знч;
					Флаг = Истина;
				КонецЕсли;
			КонецЕсли;
			Если ПолученныеДанные.ДополнительныеСвойства.Свойство("КодОКПО", Знч) Тогда
				Если (Знч <> Объект.КодОКПО) Тогда
					Объект.КодОКПО = Знч;
					Флаг = Истина;
				КонецЕсли;
