// Обработчик записывает данные из пакета XDTO в направление расходов.
// 
// Параметры :
//	ДанныеИБ - СправочникОбъект.ПрограммыЦелевыхСтатейКРБ - объект информационной базы.
//	ПолученныеДанные - СправочникОбъект.ПрограммыЦелевыхСтатейКРБ - новый объект информационной базы.
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализированные в рамках 
//								   выполнения сеанса обмена.
//
Процедура ПКО_Справочник_ПрограммаЦелевойСтатьиКРБ_Получение_ПередЗаписьюПолученныхДанных(Знач ДанныеИБ,
																						  Знач ПолученныеДанные,
																						  Знач КомпонентыОбмена)

	// Заполнение свойств объекта ИБ, если он есть в базе.
	Если (ДанныеИБ <> Неопределено) Тогда
		ДанныеИБ.ПометкаУдаления = ПолученныеДанные.ПометкаУдаления;
		Если ПолученныеДанные.Бюджет.Пустая() Тогда
			ПолученныеДанные.Бюджет = ДанныеИБ.Бюджет;
		КонецЕсли;	 
	КонецЕсли;

КонецПроцедуры

// Обработчик выполняет поиск направления расходов.
//
// Параметры :
//	ДанныеИБ - СправочникСсылка.ПрограммыЦелевыхСтатейКРБ - найденный объект информационной базы.
//	ПолученныеДанные - СправочникОбъект.ПрограммыЦелевыхСтатейКРБ - новый объект информационной базы.
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализированные в рамках 
//								   выполнения сеанса обмена.
//
Процедура ПКО_Справочник_ПрограммаЦелевойСтатьиКРБ_Получение_АлгоритмПоиска(ДанныеИБ,
																			Знач ПолученныеДанные,
																			Знач КомпонентыОбмена)
	Перем Текст, Отбор, Таб, Запись;															
																
	Если (ДанныеИБ <> Неопределено) Тогда
		Возврат;															
	ИначеЕсли ПолученныеДанные.ДополнительныеСвойства.Свойство("ИдентификаторXDTO", Текст) Тогда
		ДанныеИБ = СсылкаПоИдентификатору(Текст, "Справочник.ПрограммыЦелевыхСтатейКРБ", КомпонентыОбмена.УзелКорреспондента);
		Если (ДанныеИБ <> Неопределено) Тогда
			Возврат;															
		КонецЕсли;	
	КонецЕсли;
	Отбор = Новый Структура;
	Отбор.Вставить("Код", ПолученныеДанные.Код);
	Отбор.Вставить("ЦелеваяСтатья", ПолученныеДанные.ЦелеваяСтатья);
	Отбор.Вставить("Бюджет", ПолученныеДанные.Бюджет);
	Отбор.Вставить("ДатаНачалаДействия", ПолученныеДанные.ДатаНачалаДействия);
	Отбор.Вставить("ДатаОкончанияДействия", ПолученныеДанные.ДатаОкончанияДействия);
	Отбор.Вставить("Узел", КомпонентыОбмена.УзелКорреспондента);
	Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
			|	Спр.Ссылка КАК Ссылка,
			|	Спр.Бюджет КАК Бюджет
			|ИЗ	Справочник.ПрограммыЦелевыхСтатейКРБ КАК Спр
			|ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов КАК ПИ
			|ПО (ПИ.Ссылка = Спр.Ссылка) И (ПИ.УзелИнформационнойБазы = &Узел)
			|ГДЕ (Спр.ЦелеваяСтатья = &ЦелеваяСтатья) И (Спр.Код = &Код) И (НЕ Спр.ПометкаУдаления)
			|  И ((Спр.Бюджет = &Бюджет) ИЛИ (&Бюджет = ЗНАЧЕНИЕ(Справочник.Бюджеты.ПустаяСсылка)))
			|  И (Спр.ДатаНачалаДействия = &ДатаНачалаДействия)
			|  И (Спр.ДатаОкончанияДействия = &ДатаОкончанияДействия)
			|УПОРЯДОЧИТЬ ПО (ПИ.Ссылка ЕСТЬ NULL) УБЫВ";
	Таб = ПолучитьДанные(Текст, Отбор);
	Если (Таб.Количество() <> 0) Тогда
		Запись = Таб[0];
		ДанныеИБ = Запись.Ссылка;
		ПолученныеДанные.Бюджет = Запись.Бюджет;
		Возврат;
	КонецЕсли;	
	Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
			|	Спр.Ссылка КАК Ссылка,
			|	Спр.Бюджет КАК Бюджет
			|ИЗ	Справочник.ПрограммыЦелевыхСтатейКРБ КАК Спр
			|ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов КАК ПИ
			|ПО (ПИ.Ссылка = Спр.Ссылка) И (ПИ.УзелИнформационнойБазы = &Узел)
			|ГДЕ (Спр.ЦелеваяСтатья = &ЦелеваяСтатья) И (Спр.Код = &Код) И (НЕ Спр.ПометкаУдаления) И (ПИ.Ссылка ЕСТЬ NULL)
			|  И ((Спр.Бюджет = &Бюджет) ИЛИ (&Бюджет = ЗНАЧЕНИЕ(Справочник.Бюджеты.ПустаяСсылка)))
			|  И (((Спр.ДатаНачалаДействия <= &ДатаНачалаДействия) И (&ДатаНачалаДействия <= Спр.ДатаОкончанияДействия))
			|ИЛИ  ((Спр.ДатаНачалаДействия <= &ДатаОкончанияДействия) И (&ДатаОкончанияДействия <= Спр.ДатаОкончанияДействия)))
			|УПОРЯДОЧИТЬ ПО
			|(&ДатаОкончанияДействия = Спр.ДатаОкончанияДействия) УБЫВ,
			|(Спр.ДатаНачалаДействия = &ДатаНачалаДействия) УБЫВ,
			|((Спр.ДатаНачалаДействия <= &ДатаОкончанияДействия) И (&ДатаОкончанияДействия <= Спр.ДатаОкончанияДействия)) УБЫВ,
			|((Спр.ДатаНачалаДействия <= &ДатаНачалаДействия) И (&ДатаНачалаДействия <= Спр.ДатаОкончанияДействия)) УБЫВ";
	Таб = ПолучитьДанные(Текст, Отбор);
	Если (Таб.Количество() <> 0) Тогда
		Запись = Таб[0];
		ДанныеИБ = Запись.Ссылка;
		ПолученныеДанные.Бюджет = Запись.Бюджет;
	КонецЕсли;	

КонецПроцедуры

