//								   выполнения сеанса обмена.
//
Процедура ПКО_Справочник_ПрограммаЦелевойСтатьиКРБ_Получение_ПриКонвертацииДанныхXDTO(Знач ДанныеXDTO,
																					  Знач ПолученныеДанные,
																					  Знач КомпонентыОбмена)
	Перем Знч;
																					  
	Если ЗначениеЗаполнено(ПолученныеДанные.ОкончаниеДействия) Тогда
		ПолученныеДанные.ДатаОкончанияДействия = ПолученныеДанные.ОкончаниеДействия;
	Иначе
		ПолученныеДанные.ДатаОкончанияДействия = ДатаГоризонта();
	КонецЕсли;
	// Передача идентификатора в обработчик поиска.
	Знч = ИдентификаторXDTO(ДанныеXDTO);
	Если (Не ПустаяСтрока(Знч)) Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("ИдентификаторXDTO", Знч);
	КонецЕсли;
	Знч = ПолучитьКод(ПолученныеДанные.ЦелеваяСтатья);
