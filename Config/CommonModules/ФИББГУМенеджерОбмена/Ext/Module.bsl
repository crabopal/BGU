// Функция возвращает регистратора из отбора набора записей.
//
// Параметры :
//	Набор - набор записей.
//
// Возвращаемое значение :
//	Неопределено, ДокументСсылка.
// 
Функция Регистратор(Знач Набор)
	Перем Элем, Имя;

	Имя = ВРег("Регистратор");
	Для Каждого Элем Из Набор.Отбор Цикл
		Если (Не Элем.Использование) Тогда
			Продолжить;
		ИначеЕсли (ВРег(Элем.Имя) <> Имя) Тогда
			Продолжить;
		Иначе
			Возврат Элем.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Функция для получения данных без ограничений по RLS.
//
// Параметры :
//  Текст - Строка - текст запросы.
//  Параметры - Структура - параметры запроса.
//
// Возвращаемое значение :
//  ТаблицаЗначений.
//
Функция ПолучитьДанные(Знач Текст, Знач Параметры = Неопределено) Экспорт
	Перем Запрос, Элем, Результат;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос(Текст);
	Если (Параметры <> Неопределено) Тогда
		Для Каждого Элем Из Параметры Цикл
			Запрос.УстановитьПараметр(Элем.Ключ, Элем.Значение);
		КонецЦикла;
	КонецЕсли;	
	Результат = Запрос.Выполнить();
	Возврат Результат.Выгрузить(ОбходРезультатаЗапроса.Прямой);
	
КонецФункции

