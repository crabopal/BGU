// Функция определяет используется ли счет в учете финансовым органом.
//
// Параметры :
//	Код - Строка - код счета.
//
// Возвращаемое значение :
//	Булево.
//
Функция СчетДляФО(Знач Код)
	Перем Знч, Номер;
	
	Номер = СокрЛП(Код);
	// Служебные и забалансовые счета ФО. 
	Если (Номер = "19") Тогда
		Возврат Истина;
	ИначеЕсли (Номер = "00") Тогда
		Возврат Истина;
	ИначеЕсли (Номер = "000") Тогда
		Возврат Истина;
	ИначеЕсли (Номер = "000.00") Тогда
		Возврат Истина;
	КонецЕсли;
	// Счета ФО. 
	Знч = Лев(Номер, 4);
	Если (Знч = "202.") Тогда
		Возврат Истина;
	ИначеЕсли (Знч = "203.") Тогда
		Возврат Истина;
	ИначеЕсли (Знч = "211.") Тогда
		Возврат Истина;
	ИначеЕсли (Знч = "212.") Тогда
		Возврат Истина;
	ИначеЕсли (Знч = "306.") Тогда
		Возврат Истина;
	ИначеЕсли (Знч = "307.") Тогда
		Возврат Истина;
	ИначеЕсли (Знч = "308.") Тогда
		Возврат Истина;
	ИначеЕсли (Знч = "309.") Тогда
		Возврат Истина;
	ИначеЕсли (Знч = "402.") Тогда
		Возврат Истина;
	ИначеЕсли (Знч = "501.") Тогда
		Возврат (Сред(Номер, 6, 1) = "9");
	ИначеЕсли (Знч = "503.") Тогда
		Возврат (Сред(Номер, 6, 1) = "9");
	Иначе
		Возврат Ложь;
	КонецЕсли;

КонецФункции

// Функция возвращает значение ключевого реквизита.
//
// Параметры :
//	ДанныеXDTO - Структура - с данными объекта XDTO.
//	Имя - Строка - имя реквизита.
//
// Возвращаемое значение :
//	Произвольный.
//
Функция КлючевойРеквизит(Знач ДанныеXDTO, Знач Имя)
	Перем КС, Рез;
	
	Если (Не ДанныеXDTO.Свойство("КлючевыеСвойства", КС)) Тогда
		КС = ДанныеXDTO;
	ИначеЕсли (ТипЗнч(КС) <> Тип("Структура")) Тогда
		КС = ДанныеXDTO;
	КонецЕсли;	
	Если КС.Свойство(Имя, Рез) Тогда
		Возврат Рез;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

// Функция возвращает ключевые свойства данных выгрузки.
//
// Параметры :
//	ДанныеXDTO - Структура - с данными объекта XDTO.
//
// Возвращаемое значение :
//	Структура.
//
Функция КлючевыеСвойства(Знач ДанныеXDTO)
	Перем КС;
	
	Если (Не ДанныеXDTO.Свойство("КлючевыеСвойства", КС)) Тогда
		КС = Новый Структура;
		ДанныеXDTO.Вставить("КлючевыеСвойства", КС);
	КонецЕсли;
	Возврат КС;
	
КонецФункции	

// Функция возвращает строку с внешним идентификатором объекта.
//
// Параметры :
//	ДанныеXDTO - Структура - с данными объекта XDTO.
//
// Возвращаемое значение :
//	Строка.
//
Функция ИдентификаторXDTO(Знач ДанныеXDTO)
	Перем Ссылка, Рез;
	
	Ссылка = КлючевойРеквизит(ДанныеXDTO, "Ссылка");
	Если (ТипЗнч(Ссылка) <> Тип("Структура")) Тогда
		Возврат "";
	ИначеЕсли (Не Ссылка.Свойство("Значение", Рез)) Тогда
		Возврат "";
	Иначе
		Возврат СокрЛП(Рез);
	КонецЕсли;
	
КонецФункции	

// Функция определяет, что объект участвовал в обмене с узлом.
//
// Параметры :
//	Ссылка - ДокументСсылка, ПланВидовХарактеристикСсылка, СправочникСсылка.
//	Узел - ПланОбменаСсылка.
//
// Возвращаемое значение :
//	Булево.
// 
Функция ОбъектУчаствовалВОбмене(Знач Ссылка, Знач Узел = Неопределено)
	Перем Текст, Отбор, Таб;
	
	Если (Не ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Ссылка))) Тогда
		Возврат Ложь;
	ИначеЕсли Ссылка.Пустая() Тогда
		Возврат Ложь;
	КонецЕсли;
	Отбор = Новый Структура;
	Отбор.Вставить("Ссылка", Ссылка);
	Текст = Новый Массив;
	Текст.Добавить("ВЫБРАТЬ ПЕРВЫЕ 1");
	Текст.Добавить("Рег.Ссылка КАК Ссылка");
	Текст.Добавить("ИЗ РегистрСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов КАК Рег");
	Текст.Добавить("ГДЕ (Рег.Ссылка = &Ссылка)");
	Если (Узел <> Неопределено) Тогда
		Отбор.Вставить("Узел", Узел);
		Текст.Добавить("И (Рег.УзелИнформационнойБазы = &Узел)");
	КонецЕсли;
	Таб = ПолучитьДанные(СтрСоединить(Текст, Символы.ПС), Отбор);
	Возврат (Таб.Количество() > 0);

КонецФункции

// Функция определяет, что объект участвовал в обмене с узлом и был выгружен из текущей базы данных.
//
// Параметры :
//	Ссылка - ДокументСсылка, ПланВидовХарактеристикСсылка, СправочникСсылка.
//	Узел - ПланОбменаСсылка.
//
// Возвращаемое значение :
//	Булево.
// 
Функция ОбъектИзЭтойБазыДанных(Знач Ссылка, Знач Узел)
	Перем Стр;
	
	Стр = РегистрыСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов.ПубличныйИдентификаторПоСсылкеОбъекта(Узел, Ссылка, "");
	Возврат (СокрЛП(Ссылка.УникальныйИдентификатор()) = Стр);
	
КонецФункции

// Функция возвращает ссылку пл идентификатору.
//
// Параметры :
//	Идентификатор - Строка - идентификатор объекта конфигурации.
//	Вид - Строка - вид объекта конфигурации.
//	УзелИнформационнойБазы - ПланОбменаСсылка.ФИБОбменБГУ - узел плана обмена.
//
// Возвращаемое значение :
//	Сссылка на объект или неопределено.
// 
Функция СсылкаПоИдентификатору(Знач Идентификатор, Знач Вид, Знач УзелИнформационнойБазы)
	Перем Текст, Отбор, Таб;
	
	Отбор = Новый Структура;
	Отбор.Вставить("Идентификатор", Идентификатор);
	Отбор.Вставить("Узел", УзелИнформационнойБазы);
	Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
			|	Рег.Ссылка КАК Ссылка
			|ИЗ РегистрСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов КАК Рег
			|ГДЕ (Рег.УзелИнформационнойБазы = &Узел)
			|  И (Рег.Идентификатор = &Идентификатор)
			|  И (Рег.Ссылка ССЫЛКА " + Вид + ")";
	Таб = ПолучитьДанные(Текст, Отбор);
	Если (Таб.Количество() = 0) Тогда
		Возврат Неопределено;
	Иначе	
		Возврат Таб[0].Ссылка;
	КонецЕсли;

КонецФункции

// Процедура добавляет идентификатор объекта в публичные идентификаторы.
//
// Параметры :
//	Ссылка - ДокументСсылка, ПланВидовХарактеристикСсылка, СправочникСсылка.
//	Узел - ПланОбменаСсылка.ФИБОбменБГУ.
//	Идентификатор - Строка.
//
Процедура ДобавитьИдентификаторXDTO(Знач Ссылка, Знач Узел, Знач Идентификатор)
	Перем Набор, Отбор, Запись;
	
	Если (Не ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Ссылка))) Тогда
		Возврат;
	ИначеЕсли Ссылка.Пустая() Тогда
		Возврат;
	ИначеЕсли (ТипЗнч(Узел) <> Тип("ПланОбменаСсылка.ФИБОбменБГУ")) Тогда
		Возврат;
	ИначеЕсли Узел.Пустая() Тогда
		Возврат;
	ИначеЕсли ПустаяСтрока(Идентификатор) Тогда
		Возврат;
	КонецЕсли;
	Набор = РегистрыСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов.СоздатьНаборЗаписей();
	Отбор = Набор.Отбор;
	Отбор.Идентификатор.Установить(Идентификатор);
	Отбор.Ссылка.Установить(Ссылка);
	Отбор.УзелИнформационнойБазы.Установить(Узел);
	Запись = Набор.Добавить();
	Запись.Идентификатор = Идентификатор;
	Запись.Ссылка = Ссылка;
	Запись.УзелИнформационнойБазы = Узел;
	Набор.Записать(Истина);

КонецПроцедуры

// Процедура при необходимости регистрирует загруженный документ.
//
// Параметры :
//	Объект - ДокументОбъект - загруженный документ.
//	Узел - ПланОбменаСсылка.ФИБОбменБГУ - узел плана обмена.
//
Процедура ЗарегистрироватьОбъект(Знач Объект, Знач Узел)
	
	Если ((ТипЗнч(Узел) = Тип("ПланОбменаСсылка.ФИБОбменБГУ")) И (Не Узел.Пустая())) Тогда
		Если ЭтоОбъектИзБМО(Объект.ИДИсточника) Тогда
			ПланыОбмена.ЗарегистрироватьИзменения(Узел, Объект.Ссылка);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Процедура удаляет регистрацию выгружаемых данных из узла плана обмена.
//
// Параметры :
//	Данные - выгружаемые данные.
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализированные в рамках 
//								   выполнения сеанса обмена.
//
Процедура УдалитьРегистрацию(Знач Данные, Знач КомпонентыОбмена)
	Перем Узел;
	
	Узел = КомпонентыОбмена.УзелКорреспондента;
	Если ((ТипЗнч(Узел) = Тип("ПланОбменаСсылка.ФИБОбменБГУ")) И (Не Узел.Пустая())) Тогда
		ПланыОбмена.УдалитьРегистрациюИзменений(Узел, Данные);
	КонецЕсли;	

КонецПроцедуры

// Регистрация за период изменений в бухгалтерском регистре.
//
// Параметры :
// 	Узел - ПланОбменаСсылка.ФИБОбменБГУ - узел плана обмена, в который требуется выгрузить данные.
//  Начало - Дата - начало периода регистрации.
//  Конец - Дата, Неопределено - конец периода регистрации (все до этой даты, т.е. <, если не заполнено,
//								 то без ограничений сверху).
//	Организации - Массив - ограничение по организациям.
//  Счета - Массив, Неопределено - ограничение по счетам. 
//  ВыгружатьДанныеПоЗабалансовымСчетам - Булево - выгружать данные по забалансовым счетам.
//
Процедура РегистрацияИзмененийВБухгалтерскомРегистре(Знач Узел,
													 Знач Начало,
													 Знач Конец,
													 Знач Организации,
													 Знач Счета,
													 Знач ВыгружатьДанныеПоЗабалансовымСчетам)
	Перем Отбор, Текст, Таб, Запись, Набор, Элем, СтандартнаяОбработка;	
	
	СтандартнаяОбработка = Истина;
	ФИББГУМенеджерОбменаПереопределяемый.РегистрацияИзмененийВБухгалтерскомРегистре(Узел,
																					Начало,
																					Конец,
																					Организации,
																					Счета,
																					ВыгружатьДанныеПоЗабалансовымСчетам,
																					СтандартнаяОбработка);
	Если (Не СтандартнаяОбработка) Тогда
		Возврат;
	КонецЕсли;																					
	Отбор = Новый Структура;
	Отбор.Вставить("Организации", Организации);
	Отбор.Вставить("Начало", НачалоДня(Начало));
	Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	        |	ЕПСБУ.Регистратор КАК Ссылка,
			|	Док.ИДИсточника КАК ИДИсточника
	        |ИЗ	РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ЕПСБУ
			|ЛЕВОЕ СОЕДИНЕНИЕ Документ.ОперацияБух КАК Док
			|ПО (Док.Ссылка = ЕПСБУ.Регистратор)
			|ГДЕ (ЕПСБУ.Активность И (ЕПСБУ.Организация В (&Организации)))
			|  И (&Начало <= ЕПСБУ.Период)";
	// Ограничение по дате.
	Если ЗначениеЗаполнено(Конец) Тогда
		Текст = Текст + " И (ЕПСБУ.Период < &Конец)";
		Отбор.Вставить("Конец", НачалоДня(Конец));
	КонецЕсли;
	// Ограничение по счетам.
	Если (Счета <> Неопределено) Тогда
		Текст = Текст + " И ((ЕПСБУ.СчетДт В (&Счета)) ИЛИ (ЕПСБУ.СчетКт В (&Счета)))";
		Отбор.Вставить("Счета", Счета);
	КонецЕсли;
	Если (ВыгружатьДанныеПоЗабалансовымСчетам <> Истина) Тогда
		Текст = Текст + " И ((НЕ ЕПСБУ.СчетДт.Забалансовый) ИЛИ (НЕ ЕПСБУ.СчетКт.Забалансовый))";
	КонецЕсли;
	Таб = ПолучитьДанные(Текст, Отбор);
	Набор = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей();
	Элем = Набор.Отбор.Регистратор;
	Для Каждого Запись Из Таб Цикл
		Если (Не ЭтоОбъектИзБМО(Запись.ИДИсточника)) Тогда
			Элем.Установить(Запись.Ссылка);
			ПланыОбмена.ЗарегистрироватьИзменения(Узел, Набор);
		КонецЕсли;	
	КонецЦикла;

КонецПроцедуры

// Функция определяет была ли начата регистрация данных бухгалтерского регистра для узла плана обмена.
//
// Параметры :
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализированные в рамках 
//								   выполнения сеанса обмена.
//
// Возвращаемое значение :
//	Булево.
//
Функция РегистрацияНачата(Знач КомпонентыОбмена) 
	Перем Узел;

	Узел = КомпонентыОбмена.УзелКорреспондента;
	Если ((ТипЗнч(Узел) = Тип("ПланОбменаСсылка.ФИБОбменБГУ")) И (Не Узел.Пустая())) Тогда
		Возврат ФИББГУМенеджерОбменаПовтИсп.РегистрацияНачата(Узел);
	Иначе
		Возврат Истина;
	КонецЕсли;

КонецФункции	
	
#КонецОбласти

// Служебные процедуры и функции для заполнения данных при загрузке.
#Область СлужебныеПроцедурыИФункцииЗаполненияДанныхЗагрузки

// Процедура выполняет добавление текста к комментарию объекта.
// 
// Параметры :
//	Объект - ДокументОбъект.ОперацияБух - объект информационной базы.
//	Текст - Строка - текст для добавления к комментарию.
//
Процедура ДобавитьКомментарий(Знач Объект, Знач Текст)

	Если ПустаяСтрока(Объект.Комментарий) Тогда
		Объект.Комментарий = Текст;
	Иначе
		Объект.Комментарий = Объект.Комментарий + "; " + Текст;
	КонецЕсли;

КонецПроцедуры

// Функция проверяет что текста нет в комментарии.
// 
// Параметры :
//	Объект - ДокументОбъект.ОперацияБух - объект информационной базы.
//	Текст - Строка - искомый текст.
//
// Возвращаемое значение :
//	Булево.
//
Функция НетТекстаВКомментарии(Знач Объект, Знач Текст)

	Если ПустаяСтрока(Текст) Тогда
		Возврат Ложь;
	Иначе
		Возврат (СтрНайти(Объект.Комментарий, Текст) = 0);
	КонецЕсли;

КонецФункции

// Функция возвращает начало строки для сообщения о проблемах в проводке.
//
// Параметры :
//	Номер - Число - номер строки.
//	Начало - Булево - начало строки уже сформировано.
//
// Возвращаемое значение :
//	Строка.
//
Функция ТекстСНомеромСтроки(Знач Номер, Начало)

	Если Начало Тогда
		Возврат "";
	КонецЕсли;
	Начало = Истина;
	Возврат СтрШаблон(НСтр("ru = 'В строке %1:'"), Формат(Номер, "ЧДЦ=0; ЧГ="));

КонецФункции

// Функция возвращает КФО по коду.
//
// Параметры :
//	Код - Строка - код вида финансового обеспечения.
//
// Возвращаемое значение :
//	ПеречислениеСсылка.КВД.
//
Функция КФО(Знач Код)
	Перем Элем;
	
	Если ПустаяСтрока(Код) Тогда
		Возврат Перечисления.КВД.ПустаяСсылка();
	КонецЕсли;
	Для Каждого Элем Из Перечисления.КВД Цикл
		Если (СокрЛП(Элем) = Код) Тогда
			Возврат Элем;
		КонецЕсли;
	КонецЦикла;
	Возврат Перечисления.КВД.ПустаяСсылка();

КонецФункции

// Процедура устанавливает минимальную возможную дату начала действия для объекта.
//
// Параметры :
//	Объект - СправочникОбъект.
//	ДопОтбор - Неопределено, Структура - значения дополнительного отбора.
// 
Процедура УстановитьМинимальнуюДатуНачалаДействия(Знач Объект, Знач ДопОтбор = Неопределено)
	Перем МД, Текст, Отбор, Таб, Дата, Элем;
	
	МД = Объект.Метаданные();
	Отбор = Новый Структура;
	Отбор.Вставить("Код", Объект.Код);
	Отбор.Вставить("Дата", НачалоДня(Объект.ДатаНачалаДействия));
	Текст = Новый Массив;
	Текст.Добавить("ВЫБРАТЬ");
	Текст.Добавить("МАКСИМУМ(Спр.ДатаОкончанияДействия) КАК ДатаНачалаДействия");
	Текст.Добавить("ИЗ Справочник." + МД.Имя + " КАК Спр");
	Текст.Добавить("ГДЕ (Спр.Код = &Код) И (Спр.ДатаОкончанияДействия < &Дата)");
	Если (Не Объект.Ссылка.Пустая()) Тогда
		Текст.Добавить("И (Спр.Ссылка <> &Ссылка)");
		Отбор.Вставить("Ссылка", Объект.Ссылка);
	КонецЕсли;	
	Если (МД.Реквизиты.Найти("Бюджет") <> Неопределено) Тогда
		Текст.Добавить("И (Спр.Бюджет = &Бюджет)");
		Отбор.Вставить("Бюджет", Объект.Бюджет);
	КонецЕсли;
	Если (ДопОтбор <> Неопределено) Тогда
		Для Каждого Элем Из ДопОтбор Цикл
			Текст.Добавить("И (Спр." + Элем.Ключ + " = &" + Элем.Ключ + ")");
			Отбор.Вставить(Элем.Ключ, Элем.Значение);
		КонецЦикла;
	КонецЕсли;
	Таб = ПолучитьДанные(СтрСоединить(Текст, Символы.ПС), Отбор);
	Если (Таб.Количество() = 0) Тогда
		Объект.ДатаНачалаДействия = ДатаНачала();
		Возврат;
	КонецЕсли;
	Дата = Таб[0].ДатаНачалаДействия;
	Если ((ТипЗнч(Дата) = Тип("Дата")) И ЗначениеЗаполнено(Дата)) Тогда
		Объект.ДатаНачалаДействия = Мин(Объект.ДатаНачалаДействия, КонецДня(Дата) + 1);
		Объект.ДатаНачалаДействия = Макс(ДатаНачала(), Объект.ДатаНачалаДействия);
	Иначе
		Объект.ДатаНачалаДействия = ДатаНачала();
	КонецЕсли;

КонецПроцедуры

// Процедура устанавливает максимальную возможную дату окончания действия для объекта.
//
// Параметры :
//	Объект - СправочникОбъект.
//	ДопОтбор - Неопределено, Структура - значения дополнительного отбора.
//
Процедура УстановитьМаксимальнуюДатуОкончанияДействия(Знач Объект, Знач ДопОтбор = Неопределено)
	Перем МД, Текст, Отбор, Таб, Дата, Элем;
	
	МД = Объект.Метаданные();
	Отбор = Новый Структура;
	Отбор.Вставить("Код", Объект.Код);
	Отбор.Вставить("Дата", КонецДня(Объект.ДатаОкончанияДействия));
	Текст = Новый Массив;
	Текст.Добавить("ВЫБРАТЬ");
	Текст.Добавить("МИНИМУМ(Спр.ДатаНачалаДействия) КАК ДатаОкончанияДействия");
	Текст.Добавить("ИЗ Справочник." + МД.Имя + " КАК Спр");
	Текст.Добавить("ГДЕ (Спр.Код = &Код) И (&Дата < Спр.ДатаНачалаДействия)");
	Если (Не Объект.Ссылка.Пустая()) Тогда
		Текст.Добавить("И (Спр.Ссылка <> &Ссылка)");
		Отбор.Вставить("Ссылка", Объект.Ссылка);
	КонецЕсли;
	Если (МД.Реквизиты.Найти("Бюджет") <> Неопределено) Тогда
		Текст.Добавить("И (Спр.Бюджет = &Бюджет)");
		Отбор.Вставить("Бюджет", Объект.Бюджет);
	КонецЕсли;
	Если (ДопОтбор <> Неопределено) Тогда
		Для Каждого Элем Из ДопОтбор Цикл
			Текст.Добавить("И (Спр." + Элем.Ключ + " = &" + Элем.Ключ + ")");
			Отбор.Вставить(Элем.Ключ, Элем.Значение);
		КонецЦикла;
	КонецЕсли;
	Таб = ПолучитьДанные(СтрСоединить(Текст, Символы.ПС), Отбор);
	Если (Таб.Количество() = 0) Тогда
		Объект.ДатаОкончанияДействия = ДатаГоризонта();
		Объект.ОкончаниеДействия = Неопределено;
		Возврат;
	КонецЕсли;
	Дата = Таб[0].ДатаОкончанияДействия;
	Если ((ТипЗнч(Дата) = Тип("Дата")) И ЗначениеЗаполнено(Дата)) Тогда
		Объект.ДатаОкончанияДействия = Макс(Объект.ДатаОкончанияДействия, НачалоДня(НачалоДня(Дата) - 1));
		Объект.ОкончаниеДействия = Объект.ДатаОкончанияДействия;
	Иначе
		Объект.ДатаОкончанияДействия = ДатаГоризонта();
		Объект.ОкончаниеДействия = Неопределено;
	КонецЕсли;

КонецПроцедуры

// Функция находит раздел,подраздел по коду.
//
// Параметры :
//	Код - Строка - код раздела,подраздела.
//
// Возвращаемое значение :
//	СправочникСсылка.РазделыПодразделыКРБ.
//
Функция РазделПодраздел(Знач Код)
	
	Если (ТипЗнч(Код) <> Тип("Строка")) Тогда
		Возврат Справочники.РазделыПодразделыКРБ.ПустаяСсылка();
	ИначеЕсли ПустаяСтрока(Код) Тогда
		Возврат Справочники.РазделыПодразделыКРБ.ПустаяСсылка();
	ИначеЕсли (Лев(Код, 4) = "0000") Тогда
		Возврат Справочники.РазделыПодразделыКРБ.ПустаяСсылка();
	Иначе
		Возврат ФИББГУМенеджерОбменаПовтИсп.РазделПодраздел(Лев(Код, 4));
	КонецЕсли;

КонецФункции

// Функция находит группу КИФ по коду.
//
// Параметры :
//	Код - Строка - код КИФ.
//
// Возвращаемое значение :
//	СправочникСсылка.ГруппыПодгруппыКИФ.
//
Функция ГруппаКИФ(Знач Код)

	Если (ТипЗнч(Код) <> Тип("Строка")) Тогда
		Возврат Справочники.ГруппыПодгруппыКИФ.ПустаяСсылка();
	ИначеЕсли ПустаяСтрока(Код) Тогда
		Возврат Справочники.ГруппыПодгруппыКИФ.ПустаяСсылка();
	Иначе
		Возврат ФИББГУМенеджерОбменаПовтИсп.ГруппаКИФ(Лев(Код, 4));
	КонецЕсли;

КонецФункции

// Функция находит аналитический код КПС по коду.
//
// Параметры :
//	Код - Строка - аналитический код КПС.
//
// Возвращаемое значение :
//	СправочникСсылка.АналитическиеКодыКПС.
//
Функция АналитическийКодКПС(Знач Код)
	Перем Текст, Таб, Отбор;
	
	Если (ТипЗнч(Код) <> Тип("Строка")) Тогда
		Возврат Справочники.АналитическиеКодыКПС.ПустаяСсылка();
	ИначеЕсли ПустаяСтрока(Код) Тогда
		Возврат Справочники.АналитическиеКодыКПС.ПустаяСсылка();
	ИначеЕсли (Лев(Код, 10) = "0000000000") Тогда
		Возврат Справочники.АналитическиеКодыКПС.ПустаяСсылка();
	Иначе	
		Возврат ФИББГУМенеджерОбменаПовтИсп.АналитическийКодКПС(Лев(Код, 10));
	КонецЕсли;

КонецФункции

// Функция определяет вид КБК по коду типа.
//
// Параметры :
//	Тип - Строка - код типа БК.
//
// Возвращаемое значение :
//	ПеречислениеСсылка.ВидыКБК.
//
Функция ВидКБК(Знач Тип)
	
	Если (Тип = "10") Тогда
		Возврат Перечисления.ВидыКБК.КРБ;
	ИначеЕсли (Тип = "20") Тогда
		Возврат Перечисления.ВидыКБК.КДБ;
	ИначеЕсли (Тип = "31") Тогда
		Возврат Перечисления.ВидыКБК.КИФ;
	ИначеЕсли (Тип = "32") Тогда
		Возврат Перечисления.ВидыКБК.КИФ;
	Иначе	
		Возврат Перечисления.ВидыКБК.ПустаяСсылка();
	КонецЕсли;

КонецФункции

// Функция находит КПС по реквизитам из файла.
//
// Параметры :
//	рКПС - Структура - реквизиты КБК.
//	НаДату - Дата - дата действия КПС.
//	КФО - ПеречислениеСсылка.КВД - код вида финансового обеспечения.
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализированные в рамках 
//								   выполнения сеанса обмена.
//
// Возвращаемое значение :
//	СправочникСсылка.КлассификационныеПризнакиСчетов, Строка.
//
Функция НайтиКПС(Знач рКПС, Знач НаДату, Знач КФО, Знач КомпонентыОбмена)
	Перем Тип, Текст, Отбор, ВидКБК, Таб, КПС;
	Перем ПКО, Действие, Знч, Флаг, Объект;
	
	Если (рКПС = Неопределено) Тогда
		Возврат Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка();
	ИначеЕсли (Не рКПС.Свойство("Код", КПС)) Тогда
		Возврат Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка();
	ИначеЕсли ПустаяСтрока(КПС) Тогда
		Возврат Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка();
	ИначеЕсли (СтрДлина(КПС) <> 17) Тогда
		Возврат СтрШаблон(НСтр("ru = 'Длина кода КПС ""%1"" должна быть равна 17 символам'"), КПС);
	ИначеЕсли (Не рКПС.Свойство("Тип", Тип)) Тогда
		Тип = "";
	КонецЕсли;
	УстановитьОтключениеБезопасногоРежима(Истина);
	Отбор = Новый Структура;
	Отбор.Вставить("Код", КПС);
	Отбор.Вставить("НаДату", НаДату);
	Текст = Новый Массив;
	Текст.Добавить("ВЫБРАТЬ ПЕРВЫЕ 1");
	Текст.Добавить("Спр.Ссылка КАК Ссылка");
	Текст.Добавить("ИЗ Справочник.КлассификационныеПризнакиСчетов КАК Спр");
	Текст.Добавить("ГДЕ (Спр.Код = &Код)");
	Текст.Добавить("И (НЕ Спр.ЭтоГруппа)");
	Текст.Добавить("И (Спр.ДатаНачалаДействия <= &НаДату)");
	Текст.Добавить("И (&НаДату <= Спр.ДатаОкончанияДействия)");
	ВидКБК = ВидКБК(Тип);
	Если (КФО = Перечисления.КВД.Бюджет) Тогда
		Если ВидКБК.Пустая() Тогда
			Отбор.Вставить("ВидыКБК", Новый Массив);
			Отбор.ВидыКБК.Добавить(Перечисления.ВидыКБК.КРБ);
			Отбор.ВидыКБК.Добавить(Перечисления.ВидыКБК.КДБ);
			Отбор.ВидыКБК.Добавить(Перечисления.ВидыКБК.КИФ);
			Текст.Добавить("И (Спр.ВидПоказателя В (&ВидыКБК))");
		Иначе
			Отбор.Вставить("ВидКБК", ВидКБК);
			Текст.Добавить("И (Спр.ВидПоказателя = &ВидКБК)");
		КонецЕсли;
	ИначеЕсли (Не ВидКБК.Пустая()) Тогда
		Отбор.Вставить("ВидКБК", ВидКБК);
		Текст.Добавить("И ((Спр.ВидПоказателя = &ВидКБК) ИЛИ (Спр.УточнениеПоказателя = &ВидКБК))");
	КонецЕсли;
	Текст.Добавить("УПОРЯДОЧИТЬ ПО Спр.ПометкаУдаления, Спр.ВидПоказателя, Спр.УточнениеПоказателя");
	Таб = ПолучитьДанные(СтрСоединить(Текст, Символы.ПС), Отбор);
	Если (Таб.Количество() > 0) Тогда
		Возврат Таб[0].Ссылка;
	КонецЕсли;
	УстановитьОтключениеБезопасногоРежима(Истина);
	УстановитьПривилегированныйРежим(Истина);
	// Если не определен тип КБК, то возвращаем ошибку.	
	Флаг = КФО.Пустая();
	Флаг = Флаг Или (НаДату < ДатаНачала());
	Флаг = Флаг Или ((КФО = Перечисления.КВД.Бюджет) И ВидКБК.Пустая());
	Если Флаг Тогда
		Возврат СтрШаблон(НСтр("ru = 'По коду ""%1"" не найден КПС'"), КПС);
	КонецЕсли;
	Действие = ДействиеПоУмолчанию();
	// Создание нового КПС.
	Объект = Справочники.КлассификационныеПризнакиСчетов.СоздатьЭлемент();
	Объект.Код = КПС;
	// Заполнение вида КБК.
	Если (КФО = Перечисления.КВД.Бюджет) Тогда
		Объект.ВидПоказателя = ВидКБК;
		Объект.УточнениеПоказателя = Перечисления.ВидыКБК.ПустаяСсылка();
	ИначеЕсли ВидКБК.Пустая() Тогда
		Объект.ВидПоказателя = Перечисления.ВидыКБК.Произвольный;
		Объект.УточнениеПоказателя = Перечисления.ВидыКБК.ПустаяСсылка();
	Иначе
		Объект.ВидПоказателя = Перечисления.ВидыКБК.АУИБУ;
		Объект.УточнениеПоказателя = ВидКБК;
	КонецЕсли;
	// Заполнение периода действия.
	Объект.ДатаНачалаДействия = НачалоДня(НаДату);
	Объект.ДатаОкончанияДействия = КонецДня(НаДату);
	Отбор = Новый Структура;
	Отбор.Вставить("ЭтоГруппа", Ложь);
	Отбор.Вставить("ВидПоказателя", Объект.ВидПоказателя);
	Отбор.Вставить("УточнениеПоказателя", Объект.УточнениеПоказателя);
	УстановитьМинимальнуюДатуНачалаДействия(Объект, Отбор);
	УстановитьМаксимальнуюДатуОкончанияДействия(Объект, Отбор);
	// Заполнение бюджетной классификации.
	Если (Объект.ВидПоказателя = Перечисления.ВидыКБК.КРБ) Тогда
		Если (рКПС.Свойство("РазделПодразделКРБ", Отбор) И (Отбор <> Неопределено)) Тогда
