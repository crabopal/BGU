	ПравилоКонвертации.ИмяПКО = "РС_БГУ_НС_Мероприятие_Отправка";
	ПравилоКонвертации.ОбъектДанных = Метаданные.Справочники.Мероприятия;
	ПравилоКонвертации.ОбъектФормата = "РегистрСведений.БГУИнформацияОбОбъектах";
	ПравилоКонвертации.ПравилоДляГруппыСправочника = Ложь;
	ПравилоКонвертации.ПриОтправкеДанных = "ПКО_РегистрСведений_БГУИнформацияОбОбъектах_Отправка_ПриОтправкеДанных";
	ПравилоКонвертации.ВариантИдентификации = "ПоПолямПоиска";
	
КонецПроцедуры

// Обработчик конвертирует данные с информацией об объектах в пакет XDTO.
// 
// Параметры :
//	ДанныеИБ - ДокументОбъект, РегистрБухгалтерииНаборЗаписей.ЖурналПроводокЕПСБУ - обрабатываемый объект информационной базы.
//	ДанныеXDTO - Структура - с данными объекта XDTO.
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализированные в рамках 
//								   выполнения сеанса обмена.
//	СтекВыгрузки - Массив - содержит ссылки на выгружаемые объекты с учетом вложенности.
//	Пропустить - Булево - отмена выгрузки.
//
Процедура ПКО_РегистрСведений_БГУИнформацияОбОбъектах_Отправка_ПриОтправкеДанных(Знач ДанныеИБ,
																				 Знач ДанныеXDTO,
																				 Знач КомпонентыОбмена,
																				 Знач СтекВыгрузки,
																				 Пропустить)
	Перем Ссылка, Стр, Тип;
																				 
	УстановитьОтключениеБезопасногоРежима(Истина);
	УстановитьПривилегированныйРежим(Истина);
	Если (ТипЗнч(ДанныеИБ) = Тип("РегистрБухгалтерииНаборЗаписей.ЖурналПроводокЕПСБУ")) Тогда
		Ссылка = Регистратор(ДанныеИБ);
		Если (Ссылка = Неопределено) Тогда
			Пропустить = Истина;
			Возврат;
		ИначеЕсли (Не ОбщегоНазначения.СсылкаСуществует(Ссылка)) Тогда
			Пропустить = Истина;
			Возврат;
		КонецЕсли;
		Пропустить = (ТипЗнч(Ссылка) = Тип("ДокументСсылка.ОперацияБух"));
		Если Пропустить Тогда
			Пропустить = ЭтоОбъектИзБМО(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "ИДИсточника"));
			Если Пропустить Тогда
				УдалитьРегистрацию(ДанныеИБ, КомпонентыОбмена);
				Возврат;
			КонецЕсли;	
		КонецЕсли;	
		ДанныеXDTO.Вставить("ОбъектКонфигурации", Ссылка.УникальныйИдентификатор());
	Иначе	
		Ссылка = ДанныеИБ.Ссылка;
		Тип = ТипЗнч(Ссылка);
		// Проверка что объект из текущей базы.
		Если (Тип = Тип("СправочникСсылка.ВидыЦелевыхСредств")) Тогда
			Пропустить = (Не ОбъектИзЭтойБазыДанных(Ссылка, КомпонентыОбмена.УзелКорреспондента));
			Стр = "ВЦС";
		ИначеЕсли (Тип = Тип("СправочникСсылка.Договоры")) Тогда
			Пропустить = (Не ОбъектИзЭтойБазыДанных(Ссылка, КомпонентыОбмена.УзелКорреспондента));
			Стр = "Д";
		ИначеЕсли (Тип = Тип("СправочникСсылка.Контрагенты")) Тогда
			Если (ТипЗнч(ДанныеИБ.ЮридическоеФизическоеЛицо) <> Тип("СправочникСсылка.ЮридическиеЛица")) Тогда
				Пропустить = Истина;
			ИначеЕсли ДанныеИБ.ЮридическоеФизическоеЛицо.Пустая() Тогда
				Пропустить = Истина;
			Иначе	
				Стр = Новый Структура;
				Стр.Вставить("КодПоРПБС");
				Стр = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеИБ.ЮридическоеФизическоеЛицо, Стр);
				Если ПустаяСтрока(Стр.КодПоРПБС) Тогда
					Пропустить = Истина;
				Иначе	
					Пропустить = (Не ОбъектИзЭтойБазыДанных(Ссылка, КомпонентыОбмена.УзелКорреспондента));
				КонецЕсли;	
			КонецЕсли;	
			Стр = "К";
		ИначеЕсли (Тип = Тип("СправочникСсылка.КОСГУ")) Тогда
			Пропустить = (Не ОбъектИзЭтойБазыДанных(Ссылка, КомпонентыОбмена.УзелКорреспондента));
			Стр = "КОСГУ";
		ИначеЕсли (Тип = Тип("СправочникСсылка.ЛицевыеСчета")) Тогда
			Пропустить = (Не ОбъектИзЭтойБазыДанных(Ссылка, КомпонентыОбмена.УзелКорреспондента));
			Стр = "ЛС";
		ИначеЕсли (Тип = Тип("СправочникСсылка.Мероприятия")) Тогда
			Пропустить = (Не ОбъектИзЭтойБазыДанных(Ссылка, КомпонентыОбмена.УзелКорреспондента));
			Стр = "М";
		Иначе
			Пропустить = Ложь;
			Стр = ВидСубконтоСтр(Тип);
		КонецЕсли;
		Если Пропустить Тогда
			УдалитьРегистрацию(Ссылка, КомпонентыОбмена);
			Возврат;
		КонецЕсли;	
		Если ПустаяСтрока(Стр) Тогда
			// Проверяем, что объект пришел из БМО.
			Пропустить = (Не ЭтоОбъектИзБМО(ДанныеИБ.ИДИсточника));
			Если Пропустить Тогда
				УдалитьРегистрацию(Ссылка, КомпонентыОбмена);
				Возврат;
			КонецЕсли;
			// Объект должен был участвовать в обмене.
			Пропустить = (Не ОбъектУчаствовалВОбмене(Ссылка, КомпонентыОбмена.УзелКорреспондента));
			Если Пропустить Тогда
				УдалитьРегистрацию(Ссылка, КомпонентыОбмена);
				Возврат;
			КонецЕсли;
			Если (ДанныеИБ.ИДИсточника = ИзмененУИ()) Тогда
				ДанныеXDTO.Вставить("Изменен", Истина);
			КонецЕсли;
		КонецЕсли;	
		ДанныеXDTO.Вставить("ОбъектКонфигурации", Ссылка);
	КонецЕсли;
	// Навигационная ссылка документа.
	ДанныеXDTO.Вставить("НавигационнаяСсылкаОбъекта", ПолучитьНавигационнуюСсылку(Ссылка));

КонецПроцедуры

#КонецОбласти

