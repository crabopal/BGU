	ПравилоКонвертации.ОбъектФормата = "Справочник.ИсточникиФинансовогоОбеспечения";
	ПравилоКонвертации.ПравилоДляГруппыСправочника = Ложь;
	ПравилоКонвертации.ПередЗаписьюПолученныхДанных = "ПКО_Справочник_ИФО_Получение_ПередЗаписьюПолученныхДанных";
	ПравилоКонвертации.ВариантИдентификации = "СначалаПоУникальномуИдентификаторуПотомПоПолямПоиска";

	НоваяСтрока = ПравилоКонвертации.Свойства.Добавить();
	НоваяСтрока.СвойствоКонфигурации = "КодГлавыБК";
	НоваяСтрока.СвойствоФормата = "КодГлавыБК";
	НоваяСтрока.ПравилоКонвертацииСвойства = "Справочник_ГлаваПоБюджетнойКлассификации_Получение";

	НоваяСтрока = ПравилоКонвертации.Свойства.Добавить();
	НоваяСтрока.СвойствоКонфигурации = "Бюджет";
	НоваяСтрока.СвойствоФормата = "Бюджет";
	НоваяСтрока.ПравилоКонвертацииСвойства = "Справочник_Бюджет_Получение";
	
	НоваяСтрока = ПравилоКонвертации.Свойства.Добавить();
	НоваяСтрока.СвойствоКонфигурации = "Наименование";
	НоваяСтрока.СвойствоФормата = "Наименование";

	ПравилоКонвертации.ПоляПоиска.Добавить("КодГлавыБК,Бюджет");
	ПравилоКонвертации.ПоляПоиска.Добавить("КодГлавыБК");

КонецПроцедуры

// Обработчик записывает данные из пакета XDTO в ИФО.
// 
// Параметры :
//	ДанныеИБ - СправочникОбъект.ИсточникиФинансовогоОбеспечения - объект информационной базы.
//	ПолученныеДанные - СправочникОбъект.ИсточникиФинансовогоОбеспечения - новый объект информационной базы.
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализированные в рамках 
//								   выполнения сеанса обмена.
//
Процедура ПКО_Справочник_ИФО_Получение_ПередЗаписьюПолученныхДанных(Знач ДанныеИБ,
																	Знач ПолученныеДанные,
																	Знач КомпонентыОбмена)
	Перем Стр;

	Стр = НСтр("ru = 'Наименование будет заполнено при следующей синхронизации данных (можно изменить вручную)'");
	Если (ДанныеИБ = Неопределено) Тогда
		Если ПустаяСтрока(ПолученныеДанные.Наименование) Тогда
			ПолученныеДанные.Наименование = Стр;
		КонецЕсли;	
		ПолученныеДанные.ИспользоватьРеквизитыИФО = Истина;
	Иначе									
		Если ПустаяСтрока(ПолученныеДанные.Наименование) Тогда
			ПолученныеДанные.Наименование = ДанныеИБ.Наименование;
		ИначеЕсли ((ДанныеИБ.Наименование <> Стр) И (Не ПустаяСтрока(ДанныеИБ.Наименование))) Тогда																						   
			ПолученныеДанные.Наименование = ДанныеИБ.Наименование;
		КонецЕсли;
		ПолученныеДанные.ИспользоватьРеквизитыИФО = ДанныеИБ.ИспользоватьРеквизитыИФО;
		Если (Не ДанныеИБ.Бюджет.Пустая()) Тогда
			ПолученныеДанные.Бюджет = ДанныеИБ.Бюджет;
		КонецЕсли;	
	КонецЕсли;

КонецПроцедуры

