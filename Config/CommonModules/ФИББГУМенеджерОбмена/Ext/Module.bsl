//								   выполнения сеанса обмена.
//
Процедура ПКО_Справочник_СтатьяКИФ_Получение_ПриКонвертацииДанныхXDTO(Знач ДанныеXDTO,
																	  Знач ПолученныеДанные,
																	  Знач КомпонентыОбмена)
	Перем Код, Знч;
	
	// Наименование (полный код).
	Код = ДанныеXDTO.КлючевыеСвойства.Владелец.Код;
	Код = Код + ПолученныеДанные.Код;
	ПолученныеДанные.Наименование = Код + "0000";
	// Владелец (старый формат).
	Если ПолученныеДанные.Владелец.Пустая() Тогда
		ПолученныеДанные.Владелец = ГруппаКИФ(Код);
	КонецЕсли;	
	Если ЗначениеЗаполнено(ПолученныеДанные.ОкончаниеДействия) Тогда
		ПолученныеДанные.ДатаОкончанияДействия = ПолученныеДанные.ОкончаниеДействия;
	Иначе
		ПолученныеДанные.ДатаОкончанияДействия = ДатаГоризонта();
	КонецЕсли;
	// Передача идентификатора в обработчик поиска.
	Знч = ИдентификаторXDTO(ДанныеXDTO);
	Если (Не ПустаяСтрока(Знч)) Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("ИдентификаторXDTO", Знч);
	КонецЕсли;	

КонецПроцедуры

// Обработчик записывает данные из пакета XDTO в статью КИФ.
// 
// Параметры :
