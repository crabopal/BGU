// Обработчик сохраняет данные из пакета XDTO в бюджетные данные.
//
// Параметры :
//	ДанныеXDTO - Структура - с данными объекта XDTO.
//	ПолученныеДанные - ДокументОбъект.БюджетныеДанные - новый объект информационной базы.
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализированные в рамках 
//								   выполнения сеанса обмена.
//
Процедура ПКО_Документ_БюджетныеДанные_Получение_ПриКонвертацииДанныхXDTO(Знач ДанныеXDTO,
																		  Знач ПолученныеДанные,
																		  Знач КомпонентыОбмена)
	Перем Объект, Таб, Знч, Код, Коды;

	УстановитьОтключениеБезопасногоРежима(Истина);
	УстановитьПривилегированныйРежим(Истина);
	Объект = ПолученныеДанные;
	Объект.Ответственный = Пользователи.ТекущийПользователь();
	Объект.ИДИсточника = ПолученУИ();
	Если ДанныеXDTO.Свойство("ВидДанных", Знч) Тогда
		Объект.ВидДанных = ВидКБК(Знч);
	КонецЕсли;
	Объект.РазделЛицевогоСчета = НайтиРазделЛицевогоСчета(Объект.ЛицевойСчет, Перечисления.КВД.Бюджет);
	Если (ДанныеXDTO.Свойство("ОчереднойПериод", Знч) И (Знч = Истина)) Тогда
		Объект.ОчереднойПериод = 1;
	Иначе
		Объект.ОчереднойПериод = 0;
	КонецЕсли;
	Объект.СпециальныеУказания.Очистить();
	Если ДанныеXDTO.Свойство("КодСпецУказаний", Знч) Тогда
		Коды = СтрРазделить(Знч, ",", Ложь);
		Для Каждого Код Из Коды Цикл
			Знч = Справочники.СпецУказанияПоБюджетнымДанным.НайтиПоКоду(Код);
			Если ЗначениеЗаполнено(Знч) Тогда
				Объект.СпециальныеУказания.Добавить().СпециальноеУказание = Знч;
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;
	// Передача идентификатора в обработчик перед записью.
	Знч = ИдентификаторXDTO(ДанныеXDTO);
	Если (Не ПустаяСтрока(Знч)) Тогда
		Объект.ДополнительныеСвойства.Вставить("ИдентификаторXDTO", Знч);
	КонецЕсли;	
	// Передача табличных частей в обработчик перед записью.
	Если (ДанныеXDTO.Свойство("Ассигнования", Таб) И (Таб <> Неопределено)) Тогда
		Объект.ДополнительныеСвойства.Вставить("тБА", Таб);
	КонецЕсли;		
	Если (ДанныеXDTO.Свойство("ЛБО", Таб) И (Таб <> Неопределено)) Тогда
		Объект.ДополнительныеСвойства.Вставить("тЛБО", Таб);
	КонецЕсли;		
	Если (ДанныеXDTO.Свойство("ПОФ", Таб) И (Таб <> Неопределено)) Тогда
		Объект.ДополнительныеСвойства.Вставить("тПОФ", Таб);
	КонецЕсли;		
																		  
КонецПроцедуры

// Обработчик выполняет поиск бюджетных данных.
//
// Параметры :
//	ДанныеИБ - ДокументСсылка.БюджетныеДанные - найденный объект информационной базы.
//	ПолученныеДанные - Документбъект.БюджетныеДанные - новый объект информационной базы.
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализированные в рамках 
//								   выполнения сеанса обмена.
//
Процедура ПКО_Документ_БюджетныеДанные_Получение_АлгоритмПоиска(ДанныеИБ,
																Знач ПолученныеДанные,
																Знач КомпонентыОбмена)
	Перем Текст, Отбор, Таб;															
																
	Если (ДанныеИБ <> Неопределено) Тогда
		Возврат;															
	ИначеЕсли ПолученныеДанные.ДополнительныеСвойства.Свойство("ИдентификаторXDTO", Текст) Тогда
		ДанныеИБ = СсылкаПоИдентификатору(Текст, "Документ.БюджетныеДанные", КомпонентыОбмена.УзелКорреспондента);
		Если (ДанныеИБ <> Неопределено) Тогда
			Возврат;															
		КонецЕсли;	
	КонецЕсли;
	Отбор = Новый Структура;
	Отбор.Вставить("Организация", ПолученныеДанные.Организация);
	Отбор.Вставить("ИФО", ПолученныеДанные.ИФО);
	Отбор.Вставить("Дата", НачалоДня(ПолученныеДанные.Дата));
	Отбор.Вставить("ВидПервичногоДокумента", ПолученныеДанные.ВидПервичногоДокумента);
	Отбор.Вставить("НомерПервичногоДокумента", ПолученныеДанные.НомерПервичногоДокумента);
	Отбор.Вставить("ДатаПервичногоДокумента", НачалоДня(ПолученныеДанные.ДатаПервичногоДокумента));
	Отбор.Вставить("ОчереднойПериод", ПолученныеДанные.ОчереднойПериод);
	Отбор.Вставить("Узел", КомпонентыОбмена.УзелКорреспондента);
	Отбор.Вставить("ИУИ", ИзмененУИ());
	Отбор.Вставить("ПУИ", ПолученУИ());
	Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
			|	Док.Ссылка КАК Ссылка
			|ИЗ	Документ.БюджетныеДанные КАК Док
			|ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов КАК ПИ
			|ПО (ПИ.Ссылка = Док.Ссылка) И (ПИ.УзелИнформационнойБазы = &Узел)
			|ГДЕ (Док.Организация = &Организация) И (ПИ.Ссылка ЕСТЬ NULL)
			|  И (Док.ОчереднойПериод = &ОчереднойПериод)
			|  И (Док.ВидПервичногоДокумента = &ВидПервичногоДокумента)
			|  И (Док.НомерПервичногоДокумента = &НомерПервичногоДокумента)
			|  И (НАЧАЛОПЕРИОДА(Док.ДатаПервичногоДокумента, ДЕНЬ) = &ДатаПервичногоДокумента)
			|  И (НАЧАЛОПЕРИОДА(Док.Дата, ДЕНЬ) = &Дата)
			|  И ((Док.ИДИсточника = &ИУИ) ИЛИ (Док.ИДИсточника = &ПУИ))
			|  И ((Док.ИФО = &ИФО) ИЛИ (&ИФО = ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)))
			|УПОРЯДОЧИТЬ ПО Док.ПометкаУдаления, (Док.ИФО <> &ИФО)";
	Таб = ПолучитьДанные(Текст, Отбор);
	Если (Таб.Количество() <> 0) Тогда
		ДанныеИБ = Таб[0].Ссылка;
	КонецЕсли;	

КонецПроцедуры

// Обработчик записывает данные из пакета XDTO в бюджетные данные.
// 
// Параметры :
//	ДанныеИБ - ДокументОбъект.БюджетныеДанные - объект информационной базы.
//	ПолученныеДанные - ДокументОбъект.БюджетныеДанные - новый объект информационной базы.
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализированные в рамках 
//								   выполнения сеанса обмена.
//	Пропустить - Булево - пропустить объект.
//
Процедура ПКО_Документ_БюджетныеДанные_Получение_ПередЗаписьюПолученныхДанных(Знач ДанныеИБ,
																			  Знач ПолученныеДанные,
																			  Знач КомпонентыОбмена,
																			  Пропустить)
	Перем Объект, Запись, Новая, Сч, Колво, Таб, Стр, Начало, Узел;
																			  
	Если (ДанныеИБ = Неопределено) Тогда
		ПолученныеДанные.УстановитьНовыйНомер();
	ИначеЕсли (ДанныеИБ.ИДИсточника = ИзмененУИ()) Тогда
		Узел = КомпонентыОбмена.УзелКорреспондента;
		ЗарегистрироватьОбъект(ДанныеИБ, Узел);
		Пропустить = Истина;
		Если ПолученныеДанные.ДополнительныеСвойства.Свойство("ИдентификаторXDTO", Стр) Тогда
			Если (Не ОбъектУчаствовалВОбмене(ДанныеИБ.Ссылка, Узел)) Тогда
				ДобавитьИдентификаторXDTO(ДанныеИБ.Ссылка, Узел, Стр);
			КонецЕсли;
		КонецЕсли;	
		Возврат;
	КонецЕсли;
	// Заполнение расшифровки нужно выполнять перед записью, т.к. при конвертации объекты ее не созданы в базе данных.	
	Объект = ПолученныеДанные;
	Если (Объект.ДополнительныеСвойства.Свойство("тБА", Таб) И (Таб <> Неопределено)) Тогда
		Колво = Таб.Количество() - 1;
		Для Сч=0 По Колво Цикл
			Начало = Ложь;
			Запись = Таб[Сч];
			Новая = Объект.Ассигнования[Сч];
			// Заполнение КБК.
			Стр = НайтиКПС(Запись.КПС, Объект.ДатаВведенияВДействиеАссигнований, Перечисления.КВД.Бюджет, КомпонентыОбмена);
			Если (ТипЗнч(Стр) <> Тип("Строка")) Тогда
				Новая.КПС = Стр;
			ИначеЕсли НетТекстаВКомментарии(Объект, Стр) Тогда
				ДобавитьКомментарий(Объект, ТекстСНомеромСтроки(Сч + 1, Начало) + Стр);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;		
	Если (Объект.ДополнительныеСвойства.Свойство("тЛБО", Таб) И (Таб <> Неопределено)) Тогда
		Колво = Таб.Количество() - 1;
		Для Сч=0 По Колво Цикл
			Начало = Ложь;
			Запись = Таб[Сч];
			Новая = Объект.ЛБО[Сч];
			// Заполнение КБК.
			Стр = НайтиКПС(Запись.КПС, Объект.ДатаВведенияВДействиеЛБО, Перечисления.КВД.Бюджет, КомпонентыОбмена);
			Если (ТипЗнч(Стр) <> Тип("Строка")) Тогда
				Новая.КПС = Стр;
			ИначеЕсли НетТекстаВКомментарии(Объект, Стр) Тогда
				ДобавитьКомментарий(Объект, ТекстСНомеромСтроки(Сч + 1, Начало) + Стр);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;		
	Если (Объект.ДополнительныеСвойства.Свойство("тПОФ", Таб) И (Таб <> Неопределено)) Тогда
		Колво = Таб.Количество() - 1;
		Для Сч=0 По Колво Цикл
			Начало = Ложь;
			Запись = Таб[Сч];
			Новая = Объект.ПОФ[Сч];
			// Заполнение КБК.
			Стр = НайтиКПС(Запись.КПС, Объект.ДатаВведенияВДействиеПОФ, Перечисления.КВД.Бюджет, КомпонентыОбмена);
			Если (ТипЗнч(Стр) <> Тип("Строка")) Тогда
				Новая.КПС = Стр;
			ИначеЕсли НетТекстаВКомментарии(Объект, Стр) Тогда
				ДобавитьКомментарий(Объект, ТекстСНомеромСтроки(Сч + 1, Начало) + Стр);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;		
	Если (ДанныеИБ <> Неопределено) Тогда
		ЗаполнитьЗначенияСвойств(ДанныеИБ, Объект,, "Номер");
		ДанныеИБ.Ассигнования.Очистить();
		Для Каждого Запись Из Объект.Ассигнования Цикл
			ЗаполнитьЗначенияСвойств(ДанныеИБ.Ассигнования.Добавить(), Запись); 
		КонецЦикла;	
		ДанныеИБ.ЛБО.Очистить();
		Для Каждого Запись Из Объект.ЛБО Цикл
			ЗаполнитьЗначенияСвойств(ДанныеИБ.ЛБО.Добавить(), Запись); 
		КонецЦикла;	
		ДанныеИБ.ПОФ.Очистить();
		Для Каждого Запись Из Объект.ПОФ Цикл
			ЗаполнитьЗначенияСвойств(ДанныеИБ.ПОФ.Добавить(), Запись); 
		КонецЦикла;	
		ДанныеИБ.СпециальныеУказания.Очистить();
		Для Каждого Запись Из Объект.СпециальныеУказания Цикл
			ЗаполнитьЗначенияСвойств(ДанныеИБ.СпециальныеУказания.Добавить(), Запись); 
		КонецЦикла;	
	КонецЕсли;	
	
КонецПроцедуры

// Обработчик для дополнительной обработки после загрузки данных в бюджетные данные.
// 
// Параметры :
//	Объект - ДокументОбъект.БюджетныеДанные - объект информационной базы.
