	ПравилоКонвертации.ПравилоДляГруппыСправочника = Ложь;
	ПравилоКонвертации.ПриКонвертацииДанныхXDTO = "ПКО_ПланОбмена_ФИБОбменБГУ_Получение_ПриКонвертацииДанныхXDTO";
	ПравилоКонвертации.ПередЗаписьюПолученныхДанных = "ПКО_ПланОбмена_ФИБОбменБГУ_Получение_ПередЗаписьюПолученныхДанных";
	ПравилоКонвертации.ВариантИдентификации = "ПоПолямПоиска";

	НоваяСтрока = ПравилоКонвертации.Свойства.Добавить();
	НоваяСтрока.СвойствоКонфигурации = "Узел";
	НоваяСтрока.СвойствоФормата = "";
	НоваяСтрока.ИспользуетсяАлгоритмКонвертации = Истина;

	ПравилоКонвертации.ПоляПоиска.Добавить("Узел");

КонецПроцедуры

// Процедура перерегистрирует справочники выгруженные при обмене из узла.
//
// Параметры :
//	Узел - ПланОбменаСсылка.
//
Процедура ЗарегистрироватьСправочникиБМО(Знач Узел)
	Перем Отбор, Текст, Знч, Значения;

	// Дополнительная классификация.
	Отбор = Новый Структура;
	Отбор.Вставить("Узел", Узел);
	// Коды целей.
	Текст = "ВЫБРАТЬ
	        |	ПИСО.Ссылка КАК Ссылка,
	        |	ПИСО.Идентификатор КАК Идентификатор
	        |ИЗ	РегистрСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов КАК ПИСО
			|ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыЦелевыхСредств КАК Спр
			|ПО (Спр.Ссылка = ПИСО.Ссылка)
	        |ГДЕ (ПИСО.УзелИнформационнойБазы = &Узел)";
	Значения = ПолучитьДанные(Текст, Отбор);
	Для Каждого Знч Из Значения Цикл
		Если (СокрЛП(Знч.Ссылка.УникальныйИдентификатор()) = Знч.Идентификатор) Тогда
			ПланыОбмена.ЗарегистрироватьИзменения(Узел, Знч.Ссылка);
		КонецЕсли;	
	КонецЦикла;	
	// Мероприятия.
	Текст = "ВЫБРАТЬ
	        |	ПИСО.Ссылка КАК Ссылка,
	        |	ПИСО.Идентификатор КАК Идентификатор
	        |ИЗ	РегистрСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов КАК ПИСО
			|ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Мероприятия КАК Спр
			|ПО (Спр.Ссылка = ПИСО.Ссылка)
	        |ГДЕ (ПИСО.УзелИнформационнойБазы = &Узел)";
	Значения = ПолучитьДанные(Текст, Отбор);
	Для Каждого Знч Из Значения Цикл
		Если (СокрЛП(Знч.Ссылка.УникальныйИдентификатор()) = Знч.Идентификатор) Тогда
			ПланыОбмена.ЗарегистрироватьИзменения(Узел, Знч.Ссылка);
		КонецЕсли;	
	КонецЦикла;	
	// КОСГУ.
	Текст = "ВЫБРАТЬ
	        |	ПИСО.Ссылка КАК Ссылка,
	        |	ПИСО.Идентификатор КАК Идентификатор
	        |ИЗ	РегистрСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов КАК ПИСО
			|ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КОСГУ КАК Спр
			|ПО (Спр.Ссылка = ПИСО.Ссылка)
	        |ГДЕ (ПИСО.УзелИнформационнойБазы = &Узел)";
	Значения = ПолучитьДанные(Текст, Отбор);
	Для Каждого Знч Из Значения Цикл
		Если (СокрЛП(Знч.Ссылка.УникальныйИдентификатор()) = Знч.Идентификатор) Тогда
			ПланыОбмена.ЗарегистрироватьИзменения(Узел, Знч.Ссылка);
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры	

// Процедура перерегистрирует справочники выгруженные при обмене из узла.
//
// Параметры :
//	Узел - ПланОбменаСсылка.
//
Процедура ЗарегистрироватьСсылкиБМО(Знач Узел)
	Перем Отбор, Текст, Знч, Значения;
	
	Отбор = Новый Структура;
	Отбор.Вставить("Узел", Узел);
	// Лицевые счета.
	Текст = "ВЫБРАТЬ
	        |	ПИСО.Ссылка КАК Ссылка,
	        |	ПИСО.Идентификатор КАК Идентификатор
	        |ИЗ	РегистрСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов КАК ПИСО
			|ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЛицевыеСчета КАК Спр
			|ПО (Спр.Ссылка = ПИСО.Ссылка)
	        |ГДЕ (ПИСО.УзелИнформационнойБазы = &Узел)";
	Значения = ПолучитьДанные(Текст, Отбор);
	Для Каждого Знч Из Значения Цикл
		Если (СокрЛП(Знч.Ссылка.УникальныйИдентификатор()) = Знч.Идентификатор) Тогда
			ПланыОбмена.ЗарегистрироватьИзменения(Узел, Знч.Ссылка);
		КонецЕсли;	
	КонецЦикла;	
	// Договоры.
	Текст = "ВЫБРАТЬ
	        |	ПИСО.Ссылка КАК Ссылка,
	        |	ПИСО.Идентификатор КАК Идентификатор
	        |ИЗ	РегистрСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов КАК ПИСО
			|ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Договоры КАК Спр
			|ПО (Спр.Ссылка = ПИСО.Ссылка)
	        |ГДЕ (ПИСО.УзелИнформационнойБазы = &Узел)";
	Значения = ПолучитьДанные(Текст, Отбор);
	Для Каждого Знч Из Значения Цикл
		Если (СокрЛП(Знч.Ссылка.УникальныйИдентификатор()) = Знч.Идентификатор) Тогда
			ПланыОбмена.ЗарегистрироватьИзменения(Узел, Знч.Ссылка);
		КонецЕсли;	
	КонецЦикла;	
	// Учреждения из контрагентов.
	Текст = "ВЫБРАТЬ
	        |	ПИСО.Ссылка КАК Ссылка,
	        |	ПИСО.Идентификатор КАК Идентификатор,
			|	СпрЮЛ.КодПоРПБС КАК КодПоРПБС
	        |ИЗ	РегистрСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов КАК ПИСО
			|ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК СпрК
			|ПО (СпрК.Ссылка = ПИСО.Ссылка)
			|ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЮридическиеЛица КАК СпрЮЛ
			|ПО (СпрЮЛ.Ссылка = СпрК.ЮридическоеФизическоеЛицо)
	        |ГДЕ (ПИСО.УзелИнформационнойБазы = &Узел) И (СпрЮЛ.КодПоРПБС <> """")";
	Значения = ПолучитьДанные(Текст, Отбор);
	Для Каждого Знч Из Значения Цикл                                                 
		Если (Не ПустаяСтрока(Знч.КодПоРПБС)) Тогда
			Если (СокрЛП(Знч.Ссылка.УникальныйИдентификатор()) = Знч.Идентификатор) Тогда
				ПланыОбмена.ЗарегистрироватьИзменения(Узел, Знч.Ссылка);
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;	

КонецПроцедуры				

// Обработчик сохраняет данные из пакета XDTO в настройки узла обмена.
//
// Параметры :
//	ДанныеXDTO - Структура - с данными объекта XDTO.
//	ПолученныеДанные - РегистрСведенийНаборЗаписей.ФИБОбменБГУРегистрацияЖурналПроводокЕПСБУ - новый объект информационной базы.
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализированные в рамках 
//								   выполнения сеанса обмена.
//
Процедура ПКО_ПланОбмена_ФИБОбменБГУ_Получение_ПриКонвертацииДанныхXDTO(Знач ДанныеXDTO,
																	    Знач ПолученныеДанные,
																	    Знач КомпонентыОбмена)
	Перем Узел, Объект, Запись, Значения, Новая;
	Перем ТекЗначения, Знч, Элем, Текст, Отбор;
	Перем ПКО, бПКО, Действие;
	
	// Получаем узел плана обмена.
	Узел = КомпонентыОбмена.УзелКорреспондента;
	Если (Не ЗначениеЗаполнено(Узел)) Тогда
		Возврат;
	КонецЕсли;
	ПолученныеДанные.Отбор.Узел.Установить(Узел);
	// Получение объекта.
	УстановитьОтключениеБезопасногоРежима(Истина);
	УстановитьПривилегированныйРежим(Истина);
	Объект = Узел.ПолучитьОбъект();
	Если (Объект = Неопределено) Тогда
		Возврат;
	КонецЕсли;
	// Сохраняем значения настроек до загрузки изменений.
	ТекЗначения = Новый Структура;
	ТекЗначения.Вставить("ВерсияКорреспондента", Объект.ВерсияКорреспондента);
	ТекЗначения.Вставить("ЭтоБМО", Объект.ЭтоБМО);
	ТекЗначения.Вставить("ДатаНачалаВыгрузкиЕПСБУ", Объект.ДатаНачалаВыгрузкиЕПСБУ);
	ТекЗначения.Вставить("ВыгружатьДанныеПоЗабалансовымСчетам", Объект.ВыгружатьДанныеПоЗабалансовымСчетам);
	ТекЗначения.Вставить("ИспользоватьОтборПоСчетам", Объект.ИспользоватьОтборПоСчетам);
	ТекЗначения.Вставить("Организации", Объект.Организации.ВыгрузитьКолонку("Организация"));
	ТекЗначения.Вставить("Счета", Объект.Счета.ВыгрузитьКолонку("Счет"));
	ТекЗначения.Вставить("РежимВыгрузкиРасш", Объект.РежимВыгрузкиРасш);
	ТекЗначения.Вставить("РежимВыгрузкиСправочниковБМО", Объект.РежимВыгрузкиСправочниковБМО);
	ТекЗначения.Вставить("РежимВыгрузкиСсылокБМО", Объект.РежимВыгрузкиСсылокБМО);
	ТекЗначения.Вставить("РежимВыгрузкиСостоянийБД", Объект.РежимВыгрузкиСостоянийБД);
	ТекЗначения.Вставить("РежимВыгрузкиСостоянийРР", Объект.РежимВыгрузкиСостоянийРР);
	ТекЗначения.Вставить("РежимВыгрузкиСостоянийБВО", Объект.РежимВыгрузкиСостоянийБВО);
	ТекЗначения.Вставить("РежимВыгрузкиСостоянийКВ", Объект.РежимВыгрузкиСостоянийКВ);
	ТекЗначения.Вставить("РежимВыгрузкиСостоянийКП", Объект.РежимВыгрузкиСостоянийКП);
	ТекЗначения.Вставить("РежимВыгрузкиСостоянийБС", Объект.РежимВыгрузкиСостоянийБС);
	// Версия БМО.
	Если ДанныеXDTO.Свойство("Версия", Знч) Тогда
		Если (Объект.ВерсияКорреспондента <> Знч) Тогда
			Объект.ДатаОбновленияВерсииКорреспондента = ТекущаяДатаСеанса();
		КонецЕсли;	
		Объект.ВерсияКорреспондента = Знч;
	КонецЕсли;	
	// Дата начала выгрузки бухгалтерских справок.
	Если ДанныеXDTO.Свойство("ДатаНачалаВыгрузкиБС", Знч) Тогда
		Объект.ДатаНачалаВыгрузкиЕПСБУ = Макс(ДатаНачала(), Знч);
	Иначе
		Объект.ДатаНачалаВыгрузкиЕПСБУ = ДатаНачала();
	КонецЕсли;	
	// Ограничения на возможный период выгрузки данных о бухгалтерских справках.
	Если ДанныеXDTO.Свойство("МинимальныйПериодРегистрацииВМесяцахБС", Знч) Тогда
		Объект.МинимальныйПериодРегистрацииВМесяцахЕПСБУ = Знч;
	КонецЕсли;	
	Если ДанныеXDTO.Свойство("МаксимальныйПериодРегистрацииВМесяцахБС", Знч) Тогда
		Объект.МаксимальныйПериодРегистрацииВМесяцахЕПСБУ = Знч;
	КонецЕсли;	
	// Выгружать бухгалтерские справки по забалансовым счетам.
	Если (ДанныеXDTO.Свойство("ЗабалансовыеСчета", Знч) И (Знч = Истина)) Тогда
		Объект.ВыгружатьДанныеПоЗабалансовымСчетам = Истина;
	Иначе
		Объект.ВыгружатьДанныеПоЗабалансовымСчетам = Ложь;
	КонецЕсли;
	// Отбор по организациям.
	Если ДанныеXDTO.Свойство("Организации", Значения) Тогда
		Действие = ДействиеПоУмолчанию();
		// Правило для получения бюджета.
		бПКО = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_Бюджет_Получение");
		Знч = Новый Структура;
		Знч.Вставить("ПравилоКонвертации", бПКО);
		Знч.Вставить("УдалятьСозданныеПоКлючевымСвойствам", Истина);
		бПКО = Знч;
		// Правило для получения организации.
		ПКО = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_Организация_Получение");
		Знч = Новый Структура;
		Знч.Вставить("ПравилоКонвертации", ПКО);
		Знч.Вставить("УдалятьСозданныеПоКлючевымСвойствам", Истина);
		ПКО = Знч;
		// Загрузка списка организаций.
		Объект.Организации.Очистить();
		Для Каждого Запись Из Значения Цикл
			Элем = Запись.Организация;
			Если (Элем = Неопределено) Тогда
				Продолжить;
			КонецЕсли;
			// Нужно для удаления бюджета, если его не было в базе данных.
			Знч = Неопределено;
			Если (Элем.Свойство("Бюджет", Знч) И (Знч <> Неопределено)) Тогда
				ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(КомпонентыОбмена, Знч, бПКО, Действие);
			КонецЕсли;
			// Поиск организации.
			Знч = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(КомпонентыОбмена, Элем, ПКО, Действие);
			Если ((ТипЗнч(Знч) = Тип("СправочникСсылка.Организации")) И (Не Знч.Пустая())) Тогда
				Новая = Объект.Организации.Добавить();
				Новая.Организация = Знч;
			Иначе
				Текст = Новый Массив;
				Если Элем.Свойство("Код", Знч) Тогда
					Текст.Добавить(НСтр("ru = 'код:'") + " " + СокрЛП(Знч));
				КонецЕсли;	
				Если Элем.Свойство("ИНН", Знч) Тогда
					Текст.Добавить(НСтр("ru = 'ИНН:'") + " " + СокрЛП(Знч));
				КонецЕсли;
				Если Элем.Свойство("КПП", Знч) Тогда
					Текст.Добавить(НСтр("ru = 'КПП:'") + " " + СокрЛП(Знч));
				КонецЕсли;
				Текст = НСтр("ru = 'Отсутствует организация с реквизитами'") + " " + СтрСоединить(Текст, "; ") + ".";
				Знч = Перечисления.ТипыПроблемОбменаДанными.ОшибкаВыполненияКодаОбработчиковПриПолученииДанных; 
				РегистрыСведений.РезультатыОбменаДанными.ЗарегистрироватьОшибкуПроверкиОбъекта(Узел, Узел, Текст, Знч);
			КонецЕсли;	
		КонецЦикла;
	Иначе
		Объект.Организации.Очистить();
	КонецЕсли;	
	// Отбор по счетам.
	Если ДанныеXDTO.Свойство("Счета", Значения) Тогда
		Объект.ИспользоватьОтборПоСчетам = Истина;
		Текст = "ВЫБРАТЬ
		        |	ЕПСБУ.Ссылка КАК Ссылка
		        |ИЗ	ПланСчетов.ЕПСБУ КАК ЕПСБУ
		        |ГДЕ (НЕ ЕПСБУ.ПометкаУдаления)
		        |  И (ЕПСБУ.Код ПОДОБНО &Код + ""%"")";
		Отбор = Новый Структура;
		Отбор.Вставить("Код", "");
		Объект.Счета.Очистить();
		Для Каждого Запись Из Значения Цикл
			Элем = Запись.Счет;
			Если (Элем = Неопределено) Тогда
				Продолжить;
			ИначеЕсли (Не Элем.Свойство("Код", Знч)) Тогда
				Продолжить;
			ИначеЕсли ПустаяСтрока(Знч) Тогда
				Продолжить;
			КонецЕсли;
			Отбор.Код = СокрЛП(Знч);
			Знч = ПолучитьДанные(Текст, Отбор);
			Для Каждого Элем Из Знч Цикл
				Новая = Объект.Счета.Добавить();
				Новая.Счет = Элем.Ссылка;
			КонецЦикла;	
		КонецЦикла;	
	Иначе
		Объект.ИспользоватьОтборПоСчетам = Ложь;
		Объект.Счета.Очистить();
	КонецЕсли;
	// Выгружать внешние объекты.
	Если (ДанныеXDTO.Свойство("ВнешниеОбъекты", Знч) И (Знч = Истина)) Тогда
		Объект.РежимВыгрузкиРасш = Перечисления.РежимыВыгрузкиОбъектовОбмена.ВыгружатьПриНеобходимости;
	Иначе
		Объект.РежимВыгрузкиРасш = Перечисления.РежимыВыгрузкиОбъектовОбмена.НеВыгружать;
	КонецЕсли;
	// Выгружать навигационные ссылки на элементы справочников.
	Если (ДанныеXDTO.Свойство("ИнформацияОбЭлементах", Знч) И (Знч = Истина)) Тогда
		Объект.РежимВыгрузкиСправочниковБМО = Перечисления.РежимыВыгрузкиОбъектовОбмена.ВыгружатьПриНеобходимости;
		Объект.РежимВыгрузкиСсылокБМО = Перечисления.РежимыВыгрузкиОбъектовОбмена.ВыгружатьПриНеобходимости;
	Иначе
		Объект.РежимВыгрузкиСправочниковБМО = Перечисления.РежимыВыгрузкиОбъектовОбмена.НеВыгружать;
		Объект.РежимВыгрузкиСсылокБМО = Перечисления.РежимыВыгрузкиОбъектовОбмена.НеВыгружать;
	КонецЕсли;
	// Выгружать состояния объектов.
	Если (Не ДанныеXDTO.Свойство("ИнформацияОСостоянияхБД", Знч)) Тогда
		Объект.РежимВыгрузкиСостоянийБД = Перечисления.РежимыВыгрузкиОбъектовОбмена.ВыгружатьВсегда;
	ИначеЕсли (Знч = Истина) Тогда
		Объект.РежимВыгрузкиСостоянийБД = Перечисления.РежимыВыгрузкиОбъектовОбмена.ВыгружатьВсегда;
	Иначе
		Объект.РежимВыгрузкиСостоянийБД = Перечисления.РежимыВыгрузкиОбъектовОбмена.НеВыгружать;
	КонецЕсли;
	Если (Не ДанныеXDTO.Свойство("ИнформацияОСостоянияхРР", Знч)) Тогда
		Объект.РежимВыгрузкиСостоянийРР = Перечисления.РежимыВыгрузкиОбъектовОбмена.ВыгружатьВсегда;
	ИначеЕсли (Знч = Истина) Тогда
		Объект.РежимВыгрузкиСостоянийРР = Перечисления.РежимыВыгрузкиОбъектовОбмена.ВыгружатьВсегда;
	Иначе
		Объект.РежимВыгрузкиСостоянийРР = Перечисления.РежимыВыгрузкиОбъектовОбмена.НеВыгружать;
	КонецЕсли;
	Если (Не ДанныеXDTO.Свойство("ИнформацияОСостоянияхБВО", Знч)) Тогда
		Объект.РежимВыгрузкиСостоянийБВО = Перечисления.РежимыВыгрузкиОбъектовОбмена.ВыгружатьВсегда;
	ИначеЕсли (Знч = Истина) Тогда
		Объект.РежимВыгрузкиСостоянийБВО = Перечисления.РежимыВыгрузкиОбъектовОбмена.ВыгружатьВсегда;
	Иначе
		Объект.РежимВыгрузкиСостоянийБВО = Перечисления.РежимыВыгрузкиОбъектовОбмена.НеВыгружать;
	КонецЕсли;
	Если (Не ДанныеXDTO.Свойство("ИнформацияОСостоянияхКВ", Знч)) Тогда
		Объект.РежимВыгрузкиСостоянийКВ = Перечисления.РежимыВыгрузкиОбъектовОбмена.ВыгружатьВсегда;
	ИначеЕсли (Знч = Истина) Тогда
		Объект.РежимВыгрузкиСостоянийКВ = Перечисления.РежимыВыгрузкиОбъектовОбмена.ВыгружатьВсегда;
	Иначе
		Объект.РежимВыгрузкиСостоянийКВ = Перечисления.РежимыВыгрузкиОбъектовОбмена.НеВыгружать;
	КонецЕсли;
	Если (Не ДанныеXDTO.Свойство("ИнформацияОСостоянияхКП", Знч)) Тогда
		Объект.РежимВыгрузкиСостоянийКП = Перечисления.РежимыВыгрузкиОбъектовОбмена.ВыгружатьВсегда;
	ИначеЕсли (Знч = Истина) Тогда
		Объект.РежимВыгрузкиСостоянийКП = Перечисления.РежимыВыгрузкиОбъектовОбмена.ВыгружатьВсегда;
	Иначе
		Объект.РежимВыгрузкиСостоянийКП = Перечисления.РежимыВыгрузкиОбъектовОбмена.НеВыгружать;
	КонецЕсли;
	Если (Не ДанныеXDTO.Свойство("ИнформацияОСостоянияхБС", Знч)) Тогда
		Объект.РежимВыгрузкиСостоянийБС = Перечисления.РежимыВыгрузкиОбъектовОбмена.ВыгружатьВсегда;
	ИначеЕсли (Знч = Истина) Тогда
		Объект.РежимВыгрузкиСостоянийБС = Перечисления.РежимыВыгрузкиОбъектовОбмена.ВыгружатьВсегда;
	Иначе
		Объект.РежимВыгрузкиСостоянийБС = Перечисления.РежимыВыгрузкиОбъектовОбмена.НеВыгружать;
	КонецЕсли;
	// Если изменений нет, то не нужно изменять настройки.
	Если (Не ТекЗначения.ЭтоБМО) Тогда
		Объект.ЭтоБМО = Истина;
		Знч = Ложь;
	ИначеЕсли (ТекЗначения.ДатаНачалаВыгрузкиЕПСБУ <> Объект.ДатаНачалаВыгрузкиЕПСБУ) Тогда
		Знч = Ложь;
	ИначеЕсли (ТекЗначения.ВыгружатьДанныеПоЗабалансовымСчетам <> Объект.ВыгружатьДанныеПоЗабалансовымСчетам) Тогда
		Знч = Ложь;
	ИначеЕсли (ТекЗначения.ИспользоватьОтборПоСчетам <> Объект.ИспользоватьОтборПоСчетам) Тогда
		Знч = Ложь;
	ИначеЕсли (ТекЗначения.РежимВыгрузкиРасш <> Объект.РежимВыгрузкиРасш) Тогда
		Знч = Ложь;
	ИначеЕсли (ТекЗначения.Организации.Количество() <> Объект.Организации.Количество()) Тогда
		Знч = Ложь;
	ИначеЕсли (ТекЗначения.Счета.Количество() <> Объект.Счета.Количество()) Тогда
		Знч = Ложь;
	Иначе
		Знч = Истина;
		Для Каждого Запись Из Объект.Организации Цикл
			Если (ТекЗначения.Организации.Найти(Запись.Организация) = Неопределено) Тогда
				Знч = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;	
		Если Знч Тогда
			Для Каждого Запись Из Объект.Счета Цикл
				Если (ТекЗначения.Счета.Найти(Запись.Счет) = Неопределено) Тогда
					Знч = Ложь;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	// Если нет изменений, то нет смысла сохранять изменения.
	Если Знч Тогда
		Знч = (ТекЗначения.РежимВыгрузкиСправочниковБМО <> Объект.РежимВыгрузкиСправочниковБМО);
		Знч = Знч Или (ТекЗначения.РежимВыгрузкиСсылокБМО <> Объект.РежимВыгрузкиСсылокБМО);
		Знч = Знч Или (ТекЗначения.РежимВыгрузкиСостоянийБД <> Объект.РежимВыгрузкиСостоянийБД);
		Знч = Знч Или (ТекЗначения.РежимВыгрузкиСостоянийРР <> Объект.РежимВыгрузкиСостоянийРР);
		Знч = Знч Или (ТекЗначения.РежимВыгрузкиСостоянийБВО <> Объект.РежимВыгрузкиСостоянийБВО);
		Знч = Знч Или (ТекЗначения.РежимВыгрузкиСостоянийКВ <> Объект.РежимВыгрузкиСостоянийКВ);
		Знч = Знч Или (ТекЗначения.РежимВыгрузкиСостоянийКП <> Объект.РежимВыгрузкиСостоянийКП);
		Знч = Знч Или (ТекЗначения.РежимВыгрузкиСостоянийБС <> Объект.РежимВыгрузкиСостоянийБС);
		Если Знч Тогда
			// При изменении переключателей нужно сбросить кеш.
			Объект.ОбменДанными.Загрузка = Истина;
			Объект.Записать();                        
			КомпонентыОбмена.УзелКорреспондентаОбъект = Объект;
			// Обновление кэшируемых данных, зависящих от значений реквизитов данного узла обмена.
			ОбменДаннымиВызовСервера.СброситьКэшМеханизмаРегистрацииОбъектов();
			ОбновитьПовторноИспользуемыеЗначения();
			// Регистрация элементов.                       
			Если (Объект.РежимВыгрузкиСправочниковБМО = Перечисления.РежимыВыгрузкиОбъектовОбмена.ВыгружатьПриНеобходимости) Тогда
				ЗарегистрироватьСправочникиБМО(Узел);
			КонецЕсли;	
			Если (Объект.РежимВыгрузкиСсылокБМО = Перечисления.РежимыВыгрузкиОбъектовОбмена.ВыгружатьПриНеобходимости) Тогда
				ЗарегистрироватьСсылкиБМО(Узел);
			КонецЕсли;	
		ИначеЕсли (ТекЗначения.ВерсияКорреспондента <> Объект.ВерсияКорреспондента) Тогда
			// При изменении версии корреспондента просто сохраняем версию без регистрации для отправки данных.
			Объект.ОбменДанными.Загрузка = Истина;
			Объект.Записать();                        
			КомпонентыОбмена.УзелКорреспондентаОбъект = Объект;
		КонецЕсли;	
		Возврат;
	КонецЕсли;
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();                        
	КомпонентыОбмена.УзелКорреспондентаОбъект = Объект;
	// Обновление кэшируемых данных, зависящих от значений реквизитов данного узла обмена.
	ОбменДаннымиВызовСервера.СброситьКэшМеханизмаРегистрацииОбъектов();
	ОбновитьПовторноИспользуемыеЗначения();
	// Регистрация бухгалтерских справок.
	Значения = РегистрыСведений.ФИБОбменБГУРегистрацияЖурналПроводокЕПСБУ.СоздатьНаборЗаписей();
	Значения.Отбор.Узел.Установить(Узел);
	Значения.Записать(Истина);
	// Регистрация для выгрузки адреса текущей базы данных.
	Значения = РегистрыСведений.ФИБОбменБГУРегистрацияЖурналПроводокЕПСБУ.СоздатьНаборЗаписей();
	Значения.Отбор.Узел.Установить(Узел);
	ПланыОбмена.ЗарегистрироватьИзменения(Узел, Значения);
	// Регистрация для выгрузки плана счетов ЕПСБУ с настройками субконто (внешних объектов).
