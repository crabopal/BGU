// Обработчик конвертирует данные из договора в пакет XDTO.
// 
// Параметры :
//	ДанныеИБ - СправочникОбъект.Договора - обрабатываемый объект информационной базы.
//	ДанныеXDTO - Структура - с данными объекта XDTO.
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализированные в рамках 
//								   выполнения сеанса обмена.
//	СтекВыгрузки - Массив - содержит ссылки на выгружаемые объекты с учетом вложенности.
//	Пропустить - Булево - отмена выгрузки.
//
Процедура ПКО_Справочник_Договор_Отправка_ПриОтправкеДанных(Знач ДанныеИБ,
															Знач ДанныеXDTO,
															Знач КомпонентыОбмена,
															Знач СтекВыгрузки,
															Пропустить)
	Перем КС, Набор, Запись;

	УстановитьОтключениеБезопасногоРежима(Истина);
	УстановитьПривилегированныйРежим(Истина);
	Набор = РегистрыСведений.УчетныеНомераОбязательств.СоздатьНаборЗаписей();
	Набор.Отбор.Обязательство.Установить(ДанныеИБ.Ссылка);
	Набор.Прочитать();
	Если (Набор.Количество() > 0) Тогда
		Запись = Набор[0];
		Если (Не ПустаяСтрока(Запись.УчетныйНомерОбязательства)) Тогда
			КС = КлючевыеСвойства(ДанныеXDTO);
			КС.Вставить("НомерОбязательства", СокрЛП(Запись.УчетныйНомерОбязательства));
		КонецЕсли;	
	КонецЕсли;
	ФИББГУМенеджерОбменаПереопределяемый.Отправка_ПослеЗаполненияДанныхДоговора(ДанныеИБ, 
																				ДанныеXDTO, 
																				КомпонентыОбмена, 
																				СтекВыгрузки, 
																				Пропустить);
															
КонецПроцедуры
															
