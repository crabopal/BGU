//
Процедура ПКО_Документ_РасходноеРасписание_Получение_ПередЗаписьюПолученныхДанных(Знач ДанныеИБ,
																				  Знач ПолученныеДанные,
																				  Знач КомпонентыОбмена,
																				  Пропустить)
	Перем Объект, Запись, Новая, Сч, Колво, Таб, Стр, Начало, Узел;
																			  
	Если (ДанныеИБ = Неопределено) Тогда
		Если ПустаяСтрока(ПолученныеДанные.Номер) Тогда
			ПолученныеДанные.УстановитьНовыйНомер();
		КонецЕсли;	
	ИначеЕсли (ДанныеИБ.ИДИсточника = ИзмененУИ()) Тогда
		Узел = КомпонентыОбмена.УзелКорреспондента;
		ЗарегистрироватьОбъект(ДанныеИБ, Узел);
		Пропустить = Истина;
		Если ПолученныеДанные.ДополнительныеСвойства.Свойство("ИдентификаторXDTO", Стр) Тогда
			Если (Не ОбъектУчаствовалВОбмене(ДанныеИБ.Ссылка, Узел)) Тогда
				ДобавитьИдентификаторXDTO(ДанныеИБ.Ссылка, Узел, Стр);
			КонецЕсли;
		КонецЕсли;	
		Возврат;
	КонецЕсли;
	// Заполнение расшифровки нужно выполнять перед записью, т.к. при конвертации объекты ее не созданы в базе данных.	
	Объект = ПолученныеДанные;
	Если (ПустаяСтрока(Объект.Номер) И (ДанныеИБ <> Неопределено)) Тогда
		Объект.Номер = ДанныеИБ.Номер;
	КонецЕсли;	
	Если (Объект.ДополнительныеСвойства.Свойство("тБА", Таб) И (Таб <> Неопределено)) Тогда
		Колво = Таб.Количество() - 1;
		Для Сч=0 По Колво Цикл
			Начало = Ложь;
			Запись = Таб[Сч];
			Новая = Объект.Ассигнования[Сч];
			// Заполнение КБК.
			Стр = НайтиКПС(Запись.КПС, Объект.ДатаВведенияВДействиеАссигнований, Перечисления.КВД.Бюджет, КомпонентыОбмена);
			Если (ТипЗнч(Стр) <> Тип("Строка")) Тогда
				Новая.КПС = Стр;
			ИначеЕсли НетТекстаВКомментарии(Объект, Стр) Тогда
				ДобавитьКомментарий(Объект, ТекстСНомеромСтроки(Сч + 1, Начало) + Стр);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;		
	Если (Объект.ДополнительныеСвойства.Свойство("тЛБО", Таб) И (Таб <> Неопределено)) Тогда
		Колво = Таб.Количество() - 1;
		Для Сч=0 По Колво Цикл
			Начало = Ложь;
			Запись = Таб[Сч];
			Новая = Объект.ЛБО[Сч];
			// Заполнение КБК.
			Стр = НайтиКПС(Запись.КПС, Объект.ДатаВведенияВДействиеЛБО, Перечисления.КВД.Бюджет, КомпонентыОбмена);
			Если (ТипЗнч(Стр) <> Тип("Строка")) Тогда
				Новая.КПС = Стр;
			ИначеЕсли НетТекстаВКомментарии(Объект, Стр) Тогда
				ДобавитьКомментарий(Объект, ТекстСНомеромСтроки(Сч + 1, Начало) + Стр);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;		
	Если (Объект.ДополнительныеСвойства.Свойство("тПОФ", Таб) И (Таб <> Неопределено)) Тогда
		Колво = Таб.Количество() - 1;
		Для Сч=0 По Колво Цикл
			Начало = Ложь;
			Запись = Таб[Сч];
			Новая = Объект.ПОФ[Сч];
			// Заполнение КБК.
			Стр = НайтиКПС(Запись.КПС, Объект.ДатаВведенияВДействиеПОФ, Перечисления.КВД.Бюджет, КомпонентыОбмена);
			Если (ТипЗнч(Стр) <> Тип("Строка")) Тогда
				Новая.КПС = Стр;
			ИначеЕсли НетТекстаВКомментарии(Объект, Стр) Тогда
				ДобавитьКомментарий(Объект, ТекстСНомеромСтроки(Сч + 1, Начало) + Стр);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;		
	Если (ДанныеИБ <> Неопределено) Тогда
		ЗаполнитьЗначенияСвойств(ДанныеИБ, Объект,, "Номер");
		ДанныеИБ.Ассигнования.Очистить();
		Для Каждого Запись Из Объект.Ассигнования Цикл
			ЗаполнитьЗначенияСвойств(ДанныеИБ.Ассигнования.Добавить(), Запись); 
		КонецЦикла;	
		ДанныеИБ.ЛБО.Очистить();
		Для Каждого Запись Из Объект.ЛБО Цикл
			ЗаполнитьЗначенияСвойств(ДанныеИБ.ЛБО.Добавить(), Запись); 
		КонецЦикла;	
		ДанныеИБ.ПОФ.Очистить();
		Для Каждого Запись Из Объект.ПОФ Цикл
			ЗаполнитьЗначенияСвойств(ДанныеИБ.ПОФ.Добавить(), Запись); 
		КонецЦикла;	
		ДанныеИБ.СпециальныеУказания.Очистить();
		Для Каждого Запись Из Объект.СпециальныеУказания Цикл
			ЗаполнитьЗначенияСвойств(ДанныеИБ.СпециальныеУказания.Добавить(), Запись); 
		КонецЦикла;	
	КонецЕсли;	
	
КонецПроцедуры

