																Знач КомпонентыОбмена,
																Знач СтекВыгрузки,
																Пропустить)
	Перем КС;

	// Заполнение свойств.
	КС = КлючевыеСвойства(ДанныеXDTO);
	// Код УБП.
	Если (Не ПустаяСтрока(ДанныеИБ.КодПоРПБС)) Тогда
