// Обработчик сохраняет данные из пакета XDTO в подвид доходов.
//
// Параметры :
//	ДанныеXDTO - Структура - с данными объекта XDTO.
//	ПолученныеДанные - СправочникОбъект.ГруппыПодвидовКДБ - новый объект информационной базы.
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализированные в рамках 
//								   выполнения сеанса обмена.
//
Процедура ПКО_Справочник_ГруппаПодвидаКДБ_Получение_ПриКонвертацииДанныхXDTO(Знач ДанныеXDTO,
																			 Знач ПолученныеДанные,
																			 Знач КомпонентыОбмена)
	Перем Код;

	// Полный код складывается из кода вида доходов и кода подвида доходов.
	Если ПолученныеДанные.ВидДохода.Пустая() Тогда
		Код = "0000000000";
	Иначе	
		Код = ПолучитьКод(ПолученныеДанные.ВидДохода);
	КонецЕсли;	
	Код = Код + ПолученныеДанные.Код;
	Код = Код + "000";
	ПолученныеДанные.Наименование = Код;

КонецПроцедуры

// Обработчик записывает данные из пакета XDTO в подвид доходов.
// 
// Параметры :
//	ДанныеИБ - СправочникОбъект.ГруппыПодвидовКДБ - объект информационной базы.
//	ПолученныеДанные - СправочникОбъект.ГруппыПодвидовКДБ - новый объект информационной базы.
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализированные в рамках 
//								   выполнения сеанса обмена.
//
Процедура ПКО_Справочник_ГруппаПодвидаКДБ_Получение_ПередЗаписьюПолученныхДанных(Знач ДанныеИБ,
																				 Знач ПолученныеДанные,
																				 Знач КомпонентыОбмена)

	// Заполнение свойств объекта ИБ, если он есть в базе.
	Если (ДанныеИБ <> Неопределено) Тогда
		ДанныеИБ.ПометкаУдаления = ПолученныеДанные.ПометкаУдаления;
		Если ПолученныеДанные.Бюджет.Пустая() Тогда
			ПолученныеДанные.Бюджет = ДанныеИБ.Бюджет;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Обработчик выполняет поиск подвида доходов.
//
// Параметры :
//	ДанныеИБ - СправочникСсылка.ГруппыПодвидовКДБ - найденный объект информационной базы.
//	ПолученныеДанные - СправочникОбъект.ГруппыПодвидовКДБ - новый объект информационной базы.
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализированные в рамках 
//								   выполнения сеанса обмена.
//
Процедура ПКО_Справочник_ГруппаПодвидаКДБ_Получение_АлгоритмПоиска(ДанныеИБ,
																   Знач ПолученныеДанные,
																   Знач КомпонентыОбмена)
	Перем Текст, Отбор, Таб, Запись;															
																
	Если (ДанныеИБ <> Неопределено) Тогда
		Возврат;															
	КонецЕсли;
	Отбор = Новый Структура;
	Отбор.Вставить("Код", ПолученныеДанные.Код);
	Отбор.Вставить("ВидДохода", ПолученныеДанные.ВидДохода);
	Отбор.Вставить("Бюджет", ПолученныеДанные.Бюджет);
	Отбор.Вставить("Узел", КомпонентыОбмена.УзелКорреспондента);
	Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
			|	Спр.Ссылка КАК Ссылка,
			|	Спр.Бюджет КАК Бюджет
			|ИЗ	Справочник.ГруппыПодвидовКДБ КАК Спр
			|ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов КАК ПИ
			|ПО (ПИ.Ссылка = Спр.Ссылка) И (ПИ.УзелИнформационнойБазы = &Узел)
			|ГДЕ (Спр.ВидДохода = &ВидДохода) И (Спр.Код = &Код) И (ПИ.Ссылка ЕСТЬ NULL)
			|  И ((Спр.Бюджет = &Бюджет) ИЛИ (&Бюджет = ЗНАЧЕНИЕ(Справочник.Бюджеты.ПустаяСсылка)))
			|УПОРЯДОЧИТЬ ПО Спр.ПометкаУдаления";
	Таб = ПолучитьДанные(Текст, Отбор);
	Если (Таб.Количество() <> 0) Тогда
		Запись = Таб[0];
		ДанныеИБ = Запись.Ссылка;
		ПолученныеДанные.Бюджет = Запись.Бюджет;
	КонецЕсли;

КонецПроцедуры

