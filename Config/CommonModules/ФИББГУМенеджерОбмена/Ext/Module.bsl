// Процедура удаляет колонку из таблицы значений.
//
// Параметры :
//	Таб - ТаблицаЗначений.
//	Имя - Строка - имя колонки.
//
Процедура УдалитьКолонку(Знач Таб, Знач Имя) 
	Перем Колонки;
	
	Колонки = Таб.Колонки;
	Если (Колонки.Найти(Имя) <> Неопределено) Тогда
		Колонки.Удалить(Имя);
	КонецЕсли;

КонецПроцедуры

// Процедура удаляет колонку из таблиц значений.
//
// Параметры :
//	Таб1 - ТаблицаЗначений.
//	Таб2 - ТаблицаЗначений.
//	Имя - Строка - имя колонки.
//
Процедура УдалитьКолонкуИзТаблиц(Знач Таб1, Знач Таб2, Знач Имя) 
	
	УдалитьКолонку(Таб1, Имя);
	УдалитьКолонку(Таб2, Имя);

КонецПроцедуры

// Функция проверяет есть ли изменения в операции.
//
// Параметры :
// 	Источник - ДокументОбъект.ОперацияБух - записываемый объект.
//
// Возвращаемое значение :
//	Булево.
//
Функция ЕстьИзмененияОперацияБух(Знач Источник)
	Перем иТаб, Таб, иЗапись, Запись, Знч, иЗнч, Сч, Колво;
	
	УстановитьОтключениеБезопасногоРежима(Истина);
	УстановитьПривилегированныйРежим(Истина);
	
	Если Источник.ЭтоНовый() Тогда
		Возврат Истина;
	ИначеЕсли Источник.ОбменДанными.Загрузка Тогда
		Возврат Истина;
	ИначеЕсли Источник.ДополнительныеСвойства.Свойство("ОтключитьМеханизмРегистрацииОбъектов") Тогда
		Возврат Истина;
	КонецЕсли;

	Реквизиты = Новый Структура;
	Реквизиты.Вставить("ПометкаУдаления");
	Реквизиты.Вставить("Дата");
	Реквизиты.Вставить("Организация");
	Реквизиты.Вставить("ИФО");
	Реквизиты.Вставить("Основание");
	Реквизиты.Вставить("ИДИсточника");
	Реквизиты.Вставить("ВидМежотчетногоПериода");
	Реквизиты.Вставить("НомерИсточника");
	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник.Ссылка, Реквизиты);
	Для Каждого Запись Из Реквизиты Цикл
		Знч = Запись.Значение;
		иЗнч = Источник[Запись.Ключ];
		Если (Знч <> иЗнч) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	иТаб = Источник.Движения.ЖурналПроводокЕПСБУ.Выгрузить();
	Запись = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей();
	Запись.Отбор.Регистратор.Установить(Источник.Ссылка);
	Запись.Прочитать();
	Таб = Запись.Выгрузить();
	Запись = Неопределено;
	Колво = Таб.Количество();
	Если (Колво <> иТаб.Количество()) Тогда
		Возврат Истина;
	КонецЕсли;
//	УдалитьКолонкуИзТаблиц(Таб, иТаб, "Активность");
	УдалитьКолонкуИзТаблиц(Таб, иТаб, "Регистратор");
	УдалитьКолонкуИзТаблиц(Таб, иТаб, "НомерСтроки");
	УдалитьКолонкуИзТаблиц(Таб, иТаб, "Период");
	УдалитьКолонкуИзТаблиц(Таб, иТаб, "УточнениеПериода");
	УдалитьКолонкуИзТаблиц(Таб, иТаб, "МоментВремени");
	УдалитьКолонкуИзТаблиц(Таб, иТаб, "Организация");
	УдалитьКолонкуИзТаблиц(Таб, иТаб, "ИФО");
	УдалитьКолонкуИзТаблиц(Таб, иТаб, "ВидМежотчетногоПериода");
	УдалитьКолонкуИзТаблиц(Таб, иТаб, "СуммаНеУчитываетсяНУ");
	УдалитьКолонкуИзТаблиц(Таб, иТаб, "СуммаЕНВД");
	УдалитьКолонкуИзТаблиц(Таб, иТаб, "СуммаНДС");
	УдалитьКолонкуИзТаблиц(Таб, иТаб, "ПодразделениеДт");
	УдалитьКолонкуИзТаблиц(Таб, иТаб, "ПодразделениеКт");
	УдалитьКолонкуИзТаблиц(Таб, иТаб, "КоличествоДт");
	УдалитьКолонкуИзТаблиц(Таб, иТаб, "КоличествоКт");
	УдалитьКолонкуИзТаблиц(Таб, иТаб, "ВидСубконтоДт1");
	УдалитьКолонкуИзТаблиц(Таб, иТаб, "ВидСубконтоКт1");
	УдалитьКолонкуИзТаблиц(Таб, иТаб, "ВидСубконтоДт2");
	УдалитьКолонкуИзТаблиц(Таб, иТаб, "ВидСубконтоКт2");
	УдалитьКолонкуИзТаблиц(Таб, иТаб, "ВидСубконтоДт3");
	УдалитьКолонкуИзТаблиц(Таб, иТаб, "ВидСубконтоКт3");
	Для Сч=0 По Колво-1 Цикл
		Запись = Таб[Сч];
		иЗапись = иТаб[Сч];
		Для Каждого Набор Из Таб.Колонки Цикл
			Знч = Запись[Набор.Имя];
			иЗнч = иЗапись[Набор.Имя];
			Если ((Знч <> иЗнч) И (ЗначениеЗаполнено(Знч) Или ЗначениеЗаполнено(иЗнч))) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

#КонецОбласти

