КонецПроцедуры

// Обработчик сохраняет данные из пакета XDTO в сведения об обязательствах.
//
// Параметры :
//	ДанныеXDTO - Структура - с данными объекта XDTO.
//	ПолученныеДанные - ДокументОбъект.РегистрацияОбязательствИСведенийПоДоговорам - новый объект информационной базы.
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализированные в рамках 
//								   выполнения сеанса обмена.
//
Процедура ПКО_Документ_РегистрацияОбязательств_Получение_ПриКонвертацииДанныхXDTO(Знач ДанныеXDTO,
																				  Знач ПолученныеДанные,
																				  Знач КомпонентыОбмена)
	Перем Объект, Таб, Знч, УчетПредмета, ПринятоеОбязательство, ДД, ВД;

	УстановитьОтключениеБезопасногоРежима(Истина);
	УстановитьПривилегированныйРежим(Истина);
	Объект = ПолученныеДанные;
	Объект.Ответственный = Пользователи.ТекущийПользователь();
	Объект.ИДИсточника = ПолученУИ();
	// Вид обязательства.
	УчетПредмета = ДанныеXDTO.Свойство("УчетПредмета", Знч) И (Знч = Истина);
	ПринятоеОбязательство = ДанныеXDTO.Свойство("ПринятоеОбязательство", Знч) И (Знч = Истина);
	Если ПолученныеДанные.Договор.Пустая() Тогда
		Если (Не ПринятоеОбязательство) Тогда
			Знч = Перечисления.ВидыПринятыхОбязательств.ПринимаемоеОбязательство;
		ИначеЕсли УчетПредмета Тогда
			Знч = Перечисления.ВидыПринятыхОбязательств.ПринятоеОбязательствоУчетПредмета;
		Иначе	
			Знч = Перечисления.ВидыПринятыхОбязательств.ПринятоеОбязательство;
		КонецЕсли;	
	Иначе	
		ДД = РаботаСОбязательствами.ПолучитьДейстующийДокументОбязательствоУчетПредмета(ПолученныеДанные.Договор);
		Если ЗначениеЗаполнено(ДД.ДействующийДокумент) Тогда
			Объект.ДополнительныеСвойства.Вставить("ДейстующийДокумент", ДД);
			Если (Год(ПолученныеДанные.Дата) = Год(ДД.ДействующийДокументДата)) Тогда
				Если (Не ПринятоеОбязательство) Тогда
					Знч = Перечисления.ВидыПринятыхОбязательств.ПринимаемоеОбязательствоИзменения;
				ИначеЕсли УчетПредмета Тогда
					ВД = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДД.ДействующийДокумент, "ВидОбязательства");
					Если (ВД = Перечисления.ВидыПринятыхОбязательств.ПринимаемоеОбязательство)
					 Или (ВД = Перечисления.ВидыПринятыхОбязательств.ПринимаемоеОбязательствоИзменения)
					 Или (ВД = Перечисления.ВидыПринятыхОбязательств.ПринимаемоеОбязательствоПеререгистрация) Тогда
						Знч = Перечисления.ВидыПринятыхОбязательств.ПринятоеОбязательствоКонкурсныеПроцедуры;
					Иначе	
						Знч = Перечисления.ВидыПринятыхОбязательств.ЗаявкаНаИзменениеОбязательстваУчетПредмета;
					КонецЕсли;	
				Иначе
					Знч = Перечисления.ВидыПринятыхОбязательств.ЗаявкаНаИзменениеОбязательства;
				КонецЕсли;	
			ИначеЕсли (Не ПринятоеОбязательство) Тогда
				Знч = Перечисления.ВидыПринятыхОбязательств.ПринимаемоеОбязательствоПеререгистрация;
			ИначеЕсли УчетПредмета Тогда
				Знч = Перечисления.ВидыПринятыхОбязательств.ЗаявкаНаПеререгистрациюОбязательстваУчетПредмета;
			Иначе
				Знч = Перечисления.ВидыПринятыхОбязательств.ЗаявкаНаПеререгистрациюОбязательства;
			КонецЕсли;	
		ИначеЕсли (Не ПринятоеОбязательство) Тогда
			Знч = Перечисления.ВидыПринятыхОбязательств.ПринимаемоеОбязательство;
		ИначеЕсли УчетПредмета Тогда
			Знч = Перечисления.ВидыПринятыхОбязательств.ПринятоеОбязательствоУчетПредмета;
		Иначе
			Знч = Перечисления.ВидыПринятыхОбязательств.ПринятоеОбязательство;
		КонецЕсли;	
	КонецЕсли;	
	Объект.ВидОбязательства = Знч;
	// Лицевой счет контрагента.
	Если ДанныеXDTO.Свойство("ЛицевойСчетКонтрагента", Знч) Тогда
		Знч = СокрЛП(Знч);
	Иначе
		Знч = "";
	КонецЕсли;	
	Если ПустаяСтрока(Знч) Тогда
		Объект.СчетКонтрагента = НайтиСчетКонтрагента(Объект.Контрагент);
	Иначе	
		Объект.СчетКонтрагента = НайтиСчетКонтрагента(Объект.Контрагент, Знч, Перечисления.ТипыЛицевыхСчетов.Казначейский);
	КонецЕсли;	
	// Передача идентификатора в обработчик перед записью.
	Знч = ИдентификаторXDTO(ДанныеXDTO);
	Если (Не ПустаяСтрока(Знч)) Тогда
		Объект.ДополнительныеСвойства.Вставить("ИдентификаторXDTO", Знч);
	КонецЕсли;	
	// Передача табличных частей в обработчик перед записью.
	Если (ДанныеXDTO.Свойство("РасшифровкаОбязательстваБюджет", Таб) И (Таб <> Неопределено)) Тогда
		Объект.ДополнительныеСвойства.Вставить("тРасшифровкаОбязательстваБюджет", Таб);
	КонецЕсли;		
	Если (ДанныеXDTO.Свойство("РасшифровкаОбязательстваВнебюджет", Таб) И (Таб <> Неопределено)) Тогда
		Объект.ДополнительныеСвойства.Вставить("тРасшифровкаОбязательстваВнебюджет", Таб);
	КонецЕсли;		
	// Учетный номер.
	Знч = "";
	Если (ДанныеXDTO.Свойство("НомерОбязательства", Знч) И (Не ПустаяСтрока(Знч))) Тогда
		Объект.ДополнительныеСвойства.Вставить("УчетныйНомер", Знч);
	КонецЕсли;	
																		  
КонецПроцедуры

// Обработчик выполняет поиск сведений об обязательствах.
//
// Параметры :
//	ДанныеИБ - ДокументСсылка.РегистрацияОбязательствИСведенийПоДоговорам - найденный объект информационной базы.
//	ПолученныеДанные - Документбъект.РегистрацияОбязательствИСведенийПоДоговорам - новый объект информационной базы.
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализированные в рамках 
//								   выполнения сеанса обмена.
//
Процедура ПКО_Документ_РегистрацияОбязательств_Получение_АлгоритмПоиска(ДанныеИБ,
																		Знач ПолученныеДанные,
																		Знач КомпонентыОбмена)
	Перем Текст, Отбор, Таб;															
																
	Если (ДанныеИБ <> Неопределено) Тогда
		Возврат;															
	ИначеЕсли ПолученныеДанные.ДополнительныеСвойства.Свойство("ИдентификаторXDTO", Текст) Тогда
		ДанныеИБ = СсылкаПоИдентификатору(Текст, "Документ.РегистрацияОбязательствИСведенийПоДоговорам", КомпонентыОбмена.УзелКорреспондента);
		Если (ДанныеИБ <> Неопределено) Тогда
			Возврат;															
		КонецЕсли;	
	КонецЕсли;
	Отбор = Новый Структура;
	Отбор.Вставить("Организация", ПолученныеДанные.Организация);
	Отбор.Вставить("Дата", НачалоДня(ПолученныеДанные.Дата));
	Отбор.Вставить("НомерИсточника", ПолученныеДанные.НомерИсточника);
	Отбор.Вставить("Договор", ПолученныеДанные.Договор);
	Отбор.Вставить("Узел", КомпонентыОбмена.УзелКорреспондента);
	Отбор.Вставить("ИУИ", ИзмененУИ());
	Отбор.Вставить("ПУИ", ПолученУИ());
	Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
			|	Док.Ссылка КАК Ссылка
			|ИЗ	Документ.РегистрацияОбязательствИСведенийПоДоговорам КАК Док
			|ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов КАК ПИ
			|ПО (ПИ.Ссылка = Док.Ссылка) И (ПИ.УзелИнформационнойБазы = &Узел)
			|ГДЕ (Док.Организация = &Организация) И (ПИ.Ссылка ЕСТЬ NULL)
			|  И (Док.Договор = &Договор)
			|  И (Док.НомерИсточника = &НомерИсточника)
			|  И (НАЧАЛОПЕРИОДА(Док.Дата, ДЕНЬ) = &Дата)
			|  И ((Док.ИДИсточника = &ИУИ) ИЛИ (Док.ИДИсточника = &ПУИ))
			|УПОРЯДОЧИТЬ ПО Док.ПометкаУдаления";
	Таб = ПолучитьДанные(Текст, Отбор);
	Если (Таб.Количество() <> 0) Тогда
		ДанныеИБ = Таб[0].Ссылка;
	КонецЕсли;	

КонецПроцедуры

// Заполнение признака запрета изменения.
//
// Параметры :
//  Объект - ДокументОбъект.РегистрацияОбязательствИСведенийПоДоговорам - объект информационной базы.
//	ИмяТаблицы - Строка - имя табличной части.
//
Процедура ЗаполнитьЗапретИзменения(Знач Объект, Знач ИмяТаблицы)
	Перем ДД, Текст, Таб, рТаб, Отбор, Запись, рЗапись, Строки, Сч, Индекс, Колво, Флаг;
	
	Если (Не Объект.ДополнительныеСвойства.Свойство("ДейстующийДокумент", ДД)) Тогда
		Возврат;
	ИначеЕсли (ТипЗнч(ДД) <> Тип("Структура")) Тогда
		Возврат;
	ИначеЕсли (Не ЗначениеЗаполнено(ДД.ДействующийДокумент)) Тогда
		Возврат;
	КонецЕсли;
	Отбор = Новый Структура;
	Отбор.Вставить("Ссылка", ДД.ДействующийДокумент);
	Текст = "ВЫБРАТЬ
	        |	Таб.ДопКлассификация КАК ДопКлассификация,
	        |	Таб.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	        |	Таб.КодМероприятия КАК КодМероприятия,
	        |	Таб.КодЦели КАК КодЦели,
	        |	Таб.КПС КАК КПС,
	        |	Таб.КФО КАК КФО,
	        |	Таб.КЭК КАК КЭК,
	        |	Таб.Номенклатура КАК Номенклатура,
	        |	Таб.ОбъектФАИП КАК ОбъектФАИП,
	        |	Таб.ОКП КАК ОКП,
	        |	Таб.ПериодПлана КАК ПериодПлана,
	        |	Таб.РазделЛицевогоСчета КАК РазделЛицевогоСчета,
	        |	Таб.Подразделение КАК Подразделение
	        |ИЗ Документ.РегистрацияОбязательствИСведенийПоДоговорам." + ИмяТаблицы + " КАК Таб
			|ГДЕ (Таб.Ссылка = &Ссылка)
			|УПОРЯДОЧИТЬ ПО Таб.НомерСтроки";
	Таб = ПолучитьДанные(Текст, Отбор);
	Колво = Таб.Количество();
	Если (Колво = 0) Тогда
		Возврат;
	КонецЕсли;
	// Строки табличной части.
	Таб.Колонки.Добавить("СТЧ");
	// Таблица объекта с данными.
	рТаб = Объект[ИмяТаблицы];
	// Очистка незаполненной номенклатуры в документе.
	Для Каждого Запись Из рТаб Цикл
		Если (Не ЗначениеЗаполнено(Запись.Номенклатура)) Тогда
			Запись.Номенклатура = Неопределено;
		КонецЕсли;	
	КонецЦикла;	
	// Очистка незаполненной номенклатуры в текущих значениях.
	Для Каждого Запись Из Таб Цикл
		Если (Не ЗначениеЗаполнено(Запись.Номенклатура)) Тогда
			Запись.Номенклатура = Неопределено;
		КонецЕсли;	
	КонецЦикла;	
	// Поиск строк по всем измерениям.
	Отбор = Новый Структура;
	Отбор.Вставить("ЕдиницаИзмерения");
	Отбор.Вставить("КодМероприятия");
	Отбор.Вставить("КодЦели");
	Отбор.Вставить("КПС");
	Отбор.Вставить("КФО");
	Отбор.Вставить("КЭК");
	Отбор.Вставить("Номенклатура");
	Отбор.Вставить("ОКП");
	Отбор.Вставить("ПериодПлана");
	Отбор.Вставить("РазделЛицевогоСчета");
	Отбор.Вставить("ЗапретИзменения", Ложь);
	Флаг = Ложь;
	Для Каждого Запись Из Таб Цикл
		ЗаполнитьЗначенияСвойств(Отбор, Запись);
		Строки = рТаб.НайтиСтроки(Отбор);
		Для Каждого рЗапись Из Строки Цикл
			ЗаполнитьЗначенияСвойств(рЗапись, Запись);
			рЗапись.ЗапретИзменения = Истина;
			Запись.СТЧ = рЗапись;
			Прервать;
		КонецЦикла;
		Флаг = Флаг Или (Запись.СТЧ = Неопределено);
	КонецЦикла;	
	// Поиск строк по бюджетной и дополнительной классификации с учетом возможного уточнения.
	Если Флаг Тогда
		Отбор.Удалить("ЕдиницаИзмерения");
		Отбор.Удалить("КФО");
		Отбор.Удалить("Номенклатура");
		Отбор.Удалить("ОКП");
		Отбор.Удалить("РазделЛицевогоСчета");
		Флаг = Ложь;
		Для Каждого Запись Из Таб Цикл
			Если (Запись.СТЧ <> Неопределено) Тогда
				Продолжить;
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(Отбор, Запись);
			Строки = рТаб.НайтиСтроки(Отбор);
			Для Каждого рЗапись Из Строки Цикл
				Если ((Не рЗапись.ЕдиницаИзмерения.Пустая()) И (рЗапись.ЕдиницаИзмерения <> Запись.ЕдиницаИзмерения)) Тогда
					Продолжить;
				ИначеЕсли ((Не рЗапись.КФО.Пустая()) И (рЗапись.КФО <> Запись.КФО)) Тогда
					Продолжить;
				ИначеЕсли ((ТипЗнч(рЗапись.Номенклатура) = ТипЗнч(Запись.Номенклатура)) И (рЗапись.Номенклатура <> Запись.Номенклатура)) Тогда
					Продолжить;
				ИначеЕсли ((Не ПустаяСтрока(рЗапись.ОКП)) И (рЗапись.ОКП <> Запись.ОКП)) Тогда
					Продолжить;
				ИначеЕсли ((Не рЗапись.РазделЛицевогоСчета.Пустая()) И (рЗапись.РазделЛицевогоСчета <> Запись.РазделЛицевогоСчета)) Тогда
					Продолжить;
				КонецЕсли;	
				ЗаполнитьЗначенияСвойств(рЗапись, Запись);
				рЗапись.ЗапретИзменения = Истина;
				Запись.СТЧ = рЗапись;
				Прервать;
			КонецЦикла;	
			Флаг = Флаг Или (Запись.СТЧ = Неопределено);
		КонецЦикла;	
		// Поиск строк по КПС с учетом возможного уточнения.
		Если Флаг Тогда
			Отбор.Удалить("КодМероприятия");
			Отбор.Удалить("КодЦели");
			Отбор.Удалить("КЭК");
			Для Каждого Запись Из Таб Цикл
				Если (Запись.СТЧ <> Неопределено) Тогда
					Продолжить;
				КонецЕсли;
				ЗаполнитьЗначенияСвойств(Отбор, Запись);
				Строки = рТаб.НайтиСтроки(Отбор);
				Для Каждого рЗапись Из Строки Цикл
					Если ((Не рЗапись.ЕдиницаИзмерения.Пустая()) И (рЗапись.ЕдиницаИзмерения <> Запись.ЕдиницаИзмерения)) Тогда
						Продолжить;
					ИначеЕсли ((Не рЗапись.КФО.Пустая()) И (рЗапись.КФО <> Запись.КФО)) Тогда
						Продолжить;
					ИначеЕсли ((ТипЗнч(рЗапись.Номенклатура) = ТипЗнч(Запись.Номенклатура)) И (рЗапись.Номенклатура <> Запись.Номенклатура)) Тогда
						Продолжить;
					ИначеЕсли ((Не ПустаяСтрока(рЗапись.ОКП)) И (рЗапись.ОКП <> Запись.ОКП)) Тогда
						Продолжить;
					ИначеЕсли ((Не рЗапись.РазделЛицевогоСчета.Пустая()) И (рЗапись.РазделЛицевогоСчета <> Запись.РазделЛицевогоСчета)) Тогда
						Продолжить;
					ИначеЕсли ((Не рЗапись.КодМероприятия.Пустая()) И (рЗапись.КодМероприятия <> Запись.КодМероприятия)) Тогда
						Продолжить;
					ИначеЕсли ((Не рЗапись.КодЦели.Пустая()) И (рЗапись.КодЦели <> Запись.КодЦели)) Тогда
						Продолжить;
					ИначеЕсли ((Не рЗапись.КЭК.Пустая()) И (рЗапись.КЭК <> Запись.КЭК)) Тогда
						Продолжить;
					КонецЕсли;
					ЗаполнитьЗначенияСвойств(рЗапись, Запись);
					рЗапись.ЗапретИзменения = Истина;
					Запись.СТЧ = рЗапись;
					Прервать;
				КонецЦикла;	
			КонецЦикла;
		КонецЕсли;	
	КонецЕсли;	
	// Добавление ранее существующих строк.
	Для Сч=1 По Колво Цикл
		Индекс = Колво - Сч;
		Запись = Таб[Индекс];
		Если (Запись.СТЧ = Неопределено) Тогда
			рЗапись = рТаб.Вставить(0);
			ЗаполнитьЗначенияСвойств(рЗапись, Запись);
			рЗапись.ЗапретИзменения = Истина;
		Иначе
			Индекс = рТаб.Индекс(Запись.СТЧ);
			Если (Индекс > 0) Тогда
				рТаб.Сдвинуть(Запись.СТЧ, -Индекс);
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры

// Обработчик записывает данные из пакета XDTO в сведения об обязательствах.
// 
// Параметры :
//	ДанныеИБ - ДокументОбъект.РегистрацияОбязательствИСведенийПоДоговорам - объект информационной базы.
//	ПолученныеДанные - ДокументОбъект.РегистрацияОбязательствИСведенийПоДоговорам - новый объект информационной базы.
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализированные в рамках 
//								   выполнения сеанса обмена.
//	Пропустить - Булево - пропустить объект.
//
Процедура ПКО_Документ_РегистрацияОбязательств_Получение_ПередЗаписьюПолученныхДанных(Знач ДанныеИБ,
																					  Знач ПолученныеДанные,
																					  Знач КомпонентыОбмена,
																					  Пропустить)
	Перем Объект, Запись, Новая, Сч, Колво, Таб, Стр, Начало, Узел, УчетныйНомер;
	
	УстановитьОтключениеБезопасногоРежима(Истина);
	УстановитьПривилегированныйРежим(Истина);
	Объект = ПолученныеДанные;
	Если Объект.ДополнительныеСвойства.Свойство("УчетныйНомер", УчетныйНомер) Тогда
		УчетныйНомер = СокрЛП(УчетныйНомер);
	Иначе	
		УчетныйНомер = "";
	КонецЕсли;
	Если (ДанныеИБ = Неопределено) Тогда
		Объект.УстановитьНовыйНомер();
		Объект.ВалютаДокумента = Справочники.Валюты.НайтиПоКоду("643");
		Объект.Курс = 1;
		Объект.Кратность = 1;
	ИначеЕсли (ДанныеИБ.ИДИсточника = ИзмененУИ()) Тогда
		Узел = КомпонентыОбмена.УзелКорреспондента;
		ЗарегистрироватьОбъект(ДанныеИБ, Узел);
		Пропустить = Истина;
		Если Объект.ДополнительныеСвойства.Свойство("ИдентификаторXDTO", Стр) Тогда
			Если (Не ОбъектУчаствовалВОбмене(ДанныеИБ.Ссылка, Узел)) Тогда
				ДобавитьИдентификаторXDTO(ДанныеИБ.Ссылка, Узел, Стр);
			КонецЕсли;
		КонецЕсли;
		ДобавитьУчетныйНомер(УчетныйНомер, Объект.Договор);
		Возврат;
	ИначеЕсли ПолученныеДанные.Договор.Пустая() Тогда
		ПолученныеДанные.Договор = ДанныеИБ.Договор;
	КонецЕсли;
	// Заполнение расшифровки нужно выполнять перед записью, т.к. при конвертации объекты ее не созданы в базе данных.	
	Если (Объект.ДополнительныеСвойства.Свойство("тРасшифровкаОбязательстваБюджет", Таб) И (Таб <> Неопределено)) Тогда
		Колво = Таб.Количество() - 1;
		Для Сч=0 По Колво Цикл
			Начало = Ложь;
			Запись = Таб[Сч];
			Новая = Объект.РасшифровкаОбязательстваБюджет[Сч];
			// КФО.
			Новая.КФО = КФО(Запись.КФО);
			Если (Новая.КФО.Пустая() И (Не ПустаяСтрока(Запись.КФО))) Тогда
				Стр = СтрШаблон(НСтр("ru = 'По коду ""%1"" не найден КФО'"), Запись.КФО);
				Если НетТекстаВКомментарии(Объект, Стр) Тогда
					ДобавитьКомментарий(Объект, ТекстСНомеромСтроки(Сч + 1, Начало) + Стр);
				КонецЕсли;	
			КонецЕсли;
			// Заполнение КБК.
			Стр = НайтиКПС(Запись.КПС, Объект.Дата, Новая.КФО, КомпонентыОбмена);
			Если (ТипЗнч(Стр) <> Тип("Строка")) Тогда
				Новая.КПС = Стр;
			ИначеЕсли НетТекстаВКомментарии(Объект, Стр) Тогда
				ДобавитьКомментарий(Объект, ТекстСНомеромСтроки(Сч + 1, Начало) + Стр);
			КонецЕсли;
			// Заполнение раздела лицевого счета.
			Новая.РазделЛицевогоСчета = НайтиРазделЛицевогоСчета(Объект.ЛицевойСчет, Новая.КФО);
			// Заполнение периода плана.
			Новая.ПериодПлана = ПериодПлана(Запись.ПериодПлана);
		КонецЦикла;
	КонецЕсли;		
	Если (Объект.ДополнительныеСвойства.Свойство("тРасшифровкаОбязательстваВнебюджет", Таб) И (Таб <> Неопределено)) Тогда
		Колво = Таб.Количество() - 1;
		Для Сч=0 По Колво Цикл
			Начало = Ложь;
			Запись = Таб[Сч];
			Новая = Объект.РасшифровкаОбязательстваВнебюджет[Сч];
			// КФО.
			Новая.КФО = КФО(Запись.КФО);
			Если (Новая.КФО.Пустая() И (Не ПустаяСтрока(Запись.КФО))) Тогда
				Стр = СтрШаблон(НСтр("ru = 'По коду ""%1"" не найден КФО'"), Запись.КФО);
				Если НетТекстаВКомментарии(Объект, Стр) Тогда
					ДобавитьКомментарий(Объект, ТекстСНомеромСтроки(Сч + 1, Начало) + Стр);
				КонецЕсли;	
			КонецЕсли;
			// Заполнение КБК.
			Стр = НайтиКПС(Запись.КПС, Объект.Дата, Новая.КФО, КомпонентыОбмена);
			Если (ТипЗнч(Стр) <> Тип("Строка")) Тогда
				Новая.КПС = Стр;
			ИначеЕсли НетТекстаВКомментарии(Объект, Стр) Тогда
				ДобавитьКомментарий(Объект, ТекстСНомеромСтроки(Сч + 1, Начало) + Стр);
			КонецЕсли;
			// Заполнение раздела лицевого счета.
			Новая.РазделЛицевогоСчета = НайтиРазделЛицевогоСчета(Объект.ЛицевойСчет, Новая.КФО);
			// Заполнение периода плана.
			Новая.ПериодПлана = ПериодПлана(Запись.ПериодПлана);
		КонецЦикла;
	КонецЕсли;
	ЗаполнитьЗапретИзменения(Объект, "РасшифровкаОбязательстваБюджет");
	ЗаполнитьЗапретИзменения(Объект, "РасшифровкаОбязательстваВнебюджет");
	Если (ДанныеИБ = Неопределено) Тогда
		ДобавитьУчетныйНомер(УчетныйНомер, Объект.Договор);
	Иначе	
		ЗаполнитьЗначенияСвойств(ДанныеИБ, Объект,, "Номер");
		ДанныеИБ.РасшифровкаОбязательстваБюджет.Очистить();
		Для Каждого Запись Из Объект.РасшифровкаОбязательстваБюджет Цикл
			ЗаполнитьЗначенияСвойств(ДанныеИБ.РасшифровкаОбязательстваБюджет.Добавить(), Запись); 
		КонецЦикла;	
		ДанныеИБ.РасшифровкаОбязательстваВнебюджет.Очистить();
		Для Каждого Запись Из Объект.РасшифровкаОбязательстваВнебюджет Цикл
			ЗаполнитьЗначенияСвойств(ДанныеИБ.РасшифровкаОбязательстваВнебюджет.Добавить(), Запись); 
		КонецЦикла;
		ДобавитьУчетныйНомер(УчетныйНомер, ДанныеИБ.Договор);
	КонецЕсли;	
	
КонецПроцедуры

// Обработчик для дополнительной обработки после загрузки данных в сведения об обязательствах.
// 
// Параметры :
//	Объект - ДокументОбъект.РегистрацияОбязательствИСведенийПоДоговорам - объект информационной базы.
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализированные в рамках 
//								   выполнения сеанса обмена.
//	ОбъектМодифицирован - Булево - модифицированность объекта.
//
Процедура ПКО_Документ_РегистрацияОбязательств_Получение_ПослеЗагрузкиВсехДанных(Знач Объект,
																				 Знач КомпонентыОбмена,
																				 ОбъектМодифицирован)
	Перем Узел;

	ОбъектМодифицирован = Ложь;
	Узел = КомпонентыОбмена.УзелКорреспондента;
	ЗарегистрироватьОбъект(Объект, Узел);

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецОбласти

#Область ПКПД

// Заполняет таблицу правил конвертации предопределенных данных.
//
// Параметры:
//  НаправлениеОбмена - строка ("Отправка" либо "Получение").
//  ПравилаКонвертации - таблица значений, в которую будут добавлены правила. 
//
Процедура ЗаполнитьПравилаКонвертацииПредопределенныхДанных(Знач НаправлениеОбмена, Знач ПравилаКонвертации) Экспорт

	УстановитьОтключениеБезопасногоРежима(Истина);
	УстановитьПривилегированныйРежим(Истина);
	ФИББГУМенеджерОбменаПереопределяемый.ЗаполнитьПравилаКонвертацииПредопределенныхДанных(НаправлениеОбмена, ПравилаКонвертации);
	
КонецПроцедуры

#КонецОбласти

#Область Параметры

// Заполняет параметры конвертации.
//
// Параметры:
//  ПараметрыКонвертации - Структура, в которую добавляются параметры конвертации.
//
Процедура ЗаполнитьПараметрыКонвертации(Знач ПараметрыКонвертации) Экспорт

	УстановитьОтключениеБезопасногоРежима(Истина);
	УстановитьПривилегированныйРежим(Истина);
	ПараметрыКонвертации.Вставить("ПроверятьПолученныеПроводки", Ложь);
	ПараметрыКонвертации.Вставить("ОграниченияДлиныПлатежныхРеквизитов", Неопределено); 
	ФИББГУМенеджерОбменаПереопределяемый.ЗаполнитьПараметрыКонвертации(ПараметрыКонвертации);
	
КонецПроцедуры

#КонецОбласти

#Область ОбщегоНазначения

// Процедура-обертка, выполняет запуск указанной в параметрах процедуры модуля менеджера обмена через формат.
//
// Параметры:
//  ИмяПроцедуры - Строка.
//  СтруктураПараметров - Структура, содержащая передаваемые параметры.
//
Процедура ВыполнитьПроцедуруМодуляМенеджера(Знач ИмяПроцедуры, Знач Параметры) Экспорт
	Перем Имя, Пропустить, ОбъектМодифицирован, Ссылка;

	УстановитьОтключениеБезопасногоРежима(Истина);
	УстановитьПривилегированныйРежим(Истина);
	Если СтрНачинаетсяС(ИмяПроцедуры, "ПКО_Документ_") Тогда
		Имя = Сред(ИмяПроцедуры, 14);
		Если СтрЗаканчиваетсяНа(Имя, "_Отправка_ПриОтправкеДанных") Тогда
			Имя = Лев(Имя, СтрДлина(Имя) - 27);
			Если (Имя = "БухгалтерскаяСправка") Тогда
				Пропустить = Ложь;
				ПКО_Документ_БухгалтерскаяСправка_Отправка_ПриОтправкеДанных(Параметры.ДанныеИБ,
																			 Параметры.ДанныеXDTO,
																			 Параметры.КомпонентыОбмена,
																			 Параметры.СтекВыгрузки,
																			 Пропустить);
				Если Пропустить Тогда
					Параметры.ДанныеXDTO = Неопределено;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли СтрЗаканчиваетсяНа(Имя, "_Получение_ПриКонвертацииДанныхXDTO") Тогда
			Имя = Лев(Имя, СтрДлина(Имя) - 35);
			Если (Имя = "БухгалтерскаяСправка") Тогда
				ПКО_Документ_БухгалтерскаяСправка_Получение_ПриКонвертацииДанныхXDTO(Параметры.ДанныеXDTO,
																					 Параметры.ПолученныеДанные,
																					 Параметры.КомпонентыОбмена);
			ИначеЕсли (Имя = "БюджетныеДанные") Тогда
				ПКО_Документ_БюджетныеДанные_Получение_ПриКонвертацииДанныхXDTO(Параметры.ДанныеXDTO,
																				Параметры.ПолученныеДанные,
																				Параметры.КомпонентыОбмена);
			ИначеЕсли (Имя = "КассовоеВыбытие") Тогда
				ПКО_Документ_КассовоеВыбытие_Получение_ПриКонвертацииДанныхXDTO(Параметры.ДанныеXDTO,
																				Параметры.ПолученныеДанные,
																				Параметры.КомпонентыОбмена);
			ИначеЕсли (Имя = "КассовоеПоступление") Тогда
				ПКО_Документ_КассовоеПоступление_Получение_ПриКонвертацииДанныхXDTO(Параметры.ДанныеXDTO,
																					Параметры.ПолученныеДанные,
																					Параметры.КомпонентыОбмена);
