	НоваяСтрока = КонвертацияТабличнойЧасти.Свойства.Добавить();
	НоваяСтрока.СвойствоКонфигурации = "КПС";
	НоваяСтрока.СвойствоФормата = "";
	НоваяСтрока.ИспользуетсяАлгоритмКонвертации = Истина;
	
	НоваяСтрока = КонвертацияТабличнойЧасти.Свойства.Добавить();
	НоваяСтрока.СвойствоКонфигурации = "КЭК";
	НоваяСтрока.СвойствоФормата = "КЭК";
	НоваяСтрока.ПравилоКонвертацииСвойства = "Справочник_КОСГУ_Получение";
	
	НоваяСтрока = КонвертацияТабличнойЧасти.Свойства.Добавить();
	НоваяСтрока.СвойствоКонфигурации = "КодЦели";
	НоваяСтрока.СвойствоФормата = "КодЦели";
	НоваяСтрока.ПравилоКонвертацииСвойства = "Справочник_ВидЦелевыхСредств_Получение";
	
	НоваяСтрока = КонвертацияТабличнойЧасти.Свойства.Добавить();
	НоваяСтрока.СвойствоКонфигурации = "КодМероприятия";
	НоваяСтрока.СвойствоФормата = "КодМероприятия";
	НоваяСтрока.ПравилоКонвертацииСвойства = "Справочник_Мероприятие_Получение";
	
	НоваяСтрока = КонвертацияТабличнойЧасти.Свойства.Добавить();
	НоваяСтрока.СвойствоКонфигурации = "КФО";
	НоваяСтрока.СвойствоФормата = "";
	НоваяСтрока.ИспользуетсяАлгоритмКонвертации = Истина;
	
