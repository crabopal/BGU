// Обработчик конвертирует данные из контрагента в пакет XDTO.
// 
// Параметры :
//	ДанныеИБ - СправочникОбъект.Контрагенты - обрабатываемый объект информационной базы.
//	ДанныеXDTO - Структура - с данными объекта XDTO.
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализированные в рамках 
//								   выполнения сеанса обмена.
//	СтекВыгрузки - Массив - содержит ссылки на выгружаемые объекты с учетом вложенности.
//	Пропустить - Булево - отмена выгрузки.
//
Процедура ПКО_Справочник_Контрагент_Отправка_ПриОтправкеДанных(Знач ДанныеИБ,
															   Знач ДанныеXDTO,
															   Знач КомпонентыОбмена,
															   Знач СтекВыгрузки,
															   Пропустить)
	Перем Знч, КС;

	УстановитьОтключениеБезопасногоРежима(Истина);
	УстановитьПривилегированныйРежим(Истина);
	// Наименование.
	Если ПустаяСтрока(ДанныеИБ.НаименованиеСокращенное) Тогда
		ДанныеXDTO.Вставить("Наименование", ДанныеИБ.Наименование);
	Иначе
		ДанныеXDTO.Вставить("Наименование", ДанныеИБ.НаименованиеСокращенное);
	КонецЕсли;
	// Юр.лицо.
	Если (ДанныеИБ.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо) Тогда
		ДанныеXDTO.Вставить("ЮрЛицо", "0");
	Иначе
		ДанныеXDTO.Вставить("ЮрЛицо", "1");
	КонецЕсли;
	// Тип контрагента.
	Знч = ПолучитьКод(ДанныеИБ.ТипКонтрагента);
	Если (Не ПустаяСтрока(Знч)) Тогда
		ДанныеXDTO.Вставить("ТипКонтрагента", Знч);
	КонецЕсли;
	// Кодовые реквизиты.
	Знч = ТипЗнч(ДанныеИБ.ЮридическоеФизическоеЛицо);
	Если (Знч = Тип("СправочникСсылка.ФизическиеЛица")) Тогда
		// Получение реквизитов физ.лица.
		Знч = Новый Структура;
		Знч.Вставить("НаименованиеПолное", "Наименование");
		Знч.Вставить("КодОКПО", "КодОКПО");
		Знч.Вставить("СНИЛС", "СтраховойНомерПФР");
		Знч = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеИБ.ЮридическоеФизическоеЛицо, Знч);
		// Полное наименование.
		Если ПустаяСтрока(Знч.НаименованиеПолное) Тогда
			ДанныеXDTO.Вставить("НаименованиеПолное", ДанныеXDTO.Наименование);
		Иначе
			ДанныеXDTO.Вставить("НаименованиеПолное", Знч.НаименованиеПолное);
		КонецЕсли;
		// ОКПО.
		Если (Не ПустаяСтрока(Знч.КодОКПО)) Тогда
			ДанныеXDTO.Вставить("КодОКПО", СокрЛП(Лев(СокрЛП(Знч.КодОКПО), 10)));
		КонецЕсли;
		// СНИЛС.
		Если (Не ПустаяСтрока(Знч.СНИЛС)) Тогда
			ДанныеXDTO.Вставить("СНИЛС", СокрЛП(Знч.СНИЛС));
		КонецЕсли;
		// ФИО.
		Знч = Новый Структура;
		Знч.Вставить("ФизическоеЛицо", ДанныеИБ.ЮридическоеФизическоеЛицо);
		Знч = РегистрыСведений.ФИОФизическихЛиц.СрезПоследних(, Знч);
		Если (Знч.Количество() > 0) Тогда
			КС = Знч[0];
			ДанныеXDTO.Вставить("Фамилия", СокрЛП(КС.Фамилия));
			ДанныеXDTO.Вставить("Имя", СокрЛП(КС.Имя));
			ДанныеXDTO.Вставить("Отчество", СокрЛП(КС.Отчество));
		КонецЕсли;	
	ИначеЕсли (Знч = Тип("СправочникСсылка.ЮридическиеЛица")) Тогда
		// Получение реквизитов юр.лица.
		Знч = Новый Структура;
		Знч.Вставить("Бюджет", "Бюджет");
		Знч.Вставить("КодБюджета", "Бюджет.Код");
		Знч.Вставить("Код", "КодПоРПБС");
		Знч.Вставить("НаименованиеПолное", "НаименованиеПолное");
		Знч.Вставить("ОГРН", "ОГРН");
		Знч.Вставить("КодОКПО", "КодОКПО");
		Знч = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеИБ.ЮридическоеФизическоеЛицо, Знч);
		// Заполнение свойств.
		КС = КлючевыеСвойства(ДанныеXDTO);
		// Код УБП.
		Если (Не ПустаяСтрока(Знч.Код)) Тогда
			КС.Вставить("КодУчреждения", СокрЛП(Лев(СокрЛП(Знч.Код), 8)));
		КонецЕсли;
		// Полное наименование.
		Если ПустаяСтрока(Знч.НаименованиеПолное) Тогда
			ДанныеXDTO.Вставить("НаименованиеПолное", ДанныеXDTO.Наименование);
		Иначе
			ДанныеXDTO.Вставить("НаименованиеПолное", Знч.НаименованиеПолное);
		КонецЕсли;
		// ОГРН.
		Если (Не ПустаяСтрока(Знч.ОГРН)) Тогда
			ДанныеXDTO.Вставить("ОГРН", СокрЛП(Лев(СокрЛП(Знч.ОГРН), 13)));
		КонецЕсли;
		// ОКПО.
		Если (Не ПустаяСтрока(Знч.КодОКПО)) Тогда
			ДанныеXDTO.Вставить("КодОКПО", СокрЛП(Лев(СокрЛП(Знч.КодОКПО), 10)));
		КонецЕсли;
		// Бюджет.
		Если (Не ПустаяСтрока(Знч.КодБюджета)) Тогда
			ДанныеXDTO.Вставить("Бюджет", Новый Структура("Ссылка,Код", Знч.Бюджет, Знч.КодБюджета));
		КонецЕсли;	
	КонецЕсли;
	ФИББГУМенеджерОбменаПереопределяемый.Отправка_ПослеЗаполненияДанныхКонтрагента(ДанныеИБ,
																				   ДанныеXDTO,
																				   КомпонентыОбмена,
																				   СтекВыгрузки,
																				   Пропустить);

КонецПроцедуры

