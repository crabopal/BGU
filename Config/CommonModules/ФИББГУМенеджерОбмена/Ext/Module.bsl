КонецПроцедуры

// Функция возвращает значение межотчетного периода по значению уточнения.
//
// Возвращаемое значение :
//	ПеречислениеСсылка.ВидыМежотчетногоПериода.
//
Функция ВидМежотчетногоПериода(Знач УточнениеПериода)
	Перем Элем, Вес, ТекВес, Рез;
	
	Рез = Перечисления.ВидыМежотчетногоПериода.ПустаяСсылка();
	Если (ТипЗнч(УточнениеПериода) <> Тип("Число")) Тогда
		Возврат Рез;
	ИначеЕсли (УточнениеПериода <= 0) Тогда	
		Возврат Рез;
	КонецЕсли;
	ТекВес = -1;
	Для Каждого Элем Из Перечисления.ВидыМежотчетногоПериода Цикл
		Вес = БухгалтерскийУчет.ЗначениеУточненияПериода(Элем);
		Если (Вес <= УточнениеПериода) И (ТекВес < Вес) Тогда
			ТекВес = Вес;
			Рез = Элем;
		КонецЕсли;
	КонецЦикла;
	Возврат Рез;

КонецФункции

// Обработчик сохраняет данные из пакета XDTO в соответствие.
//
// Параметры :
//	ДанныеXDTO - Структура - с данными объекта XDTO.
//	ПолученныеДанные - ДокументОбъект.ОперацияБух - новый объект информационной базы.
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализированные в рамках 
//								   выполнения сеанса обмена.
//
Процедура ПКО_Документ_БухгалтерскаяСправка_Получение_ПриКонвертацииДанныхXDTO(Знач ДанныеXDTO,
																			   Знач ПолученныеДанные,
																			   Знач КомпонентыОбмена)
	Перем Знч;

	ПолученныеДанные.Ответственный = Пользователи.ТекущийПользователь();
	ПолученныеДанные.ИДИсточника = ПолученУИ();
	ПолученныеДанные.ИспользоватьТиповыеОперации = Ложь;
	Если (КонецГода(ПолученныеДанные.Дата) <> ПолученныеДанные.Дата) Тогда
		Знч = 0;
	ИначеЕсли (Не ДанныеXDTO.Свойство("УточнениеПериода", Знч)) Тогда
		Знч = 0;
	КонецЕсли;
	ПолученныеДанные.ВидМежотчетногоПериода = ВидМежотчетногоПериода(Знч);
	// Передача идентификатора в обработчик перед записью.
	Знч = ИдентификаторXDTO(ДанныеXDTO);
	Если (Не ПустаяСтрока(Знч)) Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("ИдентификаторXDTO", Знч);
	КонецЕсли;	
	// Передача проводок в обработчик перед записью.
	Если (ДанныеXDTO.Свойство("Проводки", Знч) И (Знч <> Неопределено)) Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("Проводки", Знч);
	КонецЕсли;

КонецПроцедуры

// Функция выполняет поиск журнала операций по номеру.
//
// Параметры :
//  Код - Строка - номер журнала.
//
// Возвращаемое значение :
//  СправочникСсылка.Журналы.
//
Функция НайтиЖурналОпераций(Знач Код)
	Перем Текст, Таб, Отбор;
	
	Если (ТипЗнч(Код) <> Тип("Строка")) Тогда
		Возврат Справочники.Журналы.ПустаяСсылка();
	ИначеЕсли ПустаяСтрока(Код) Тогда
		Возврат Справочники.Журналы.ПустаяСсылка();
	КонецЕсли;
	Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	        |	Спр.Ссылка КАК Ссылка
	        |ИЗ	Справочник.Журналы КАК Спр
	        |ГДЕ (Спр.Код = &Код) И (НЕ Спр.ЭтоГруппа)
			|УПОРЯДОЧИТЬ ПО Спр.ПометкаУдаления";
	Отбор = Новый Структура;
	Отбор.Вставить("Код", Код);
	Таб = ПолучитьДанные(Текст, Отбор);
	Если (Таб.Количество() = 0) Тогда
		Возврат Справочники.Журналы.ПустаяСсылка();
	Иначе
		Возврат Таб[0].Ссылка;
	КонецЕсли;

КонецФункции

// Функция находит бухгалтерский счет по коду.
//
// Параметры :
//	Код - Строка - код счета.
//	НаДату - Дата - дата действия счета.
//	Организация - СправочникСсылка.Организации - учреждение.
//
// Возвращаемое значение :
//	ПланСчетовСсылка.ЕПСБУ.
//
Функция НайтиСчет(Знач Код, Знач НаДату, Знач Организация)
	Перем Рез;

	Если ПустаяСтрока(Код) Тогда
		Возврат ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	КонецЕсли;

	Рез = БухгалтерскийУчет.СчетПоКоду(Код, НаДату, Организация);

	Если (ТипЗнч(Рез) = Тип("ПланСчетовСсылка.ЕПСБУ")) Тогда
		Возврат Рез;
	Иначе
		Возврат ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	КонецЕсли;

КонецФункции

// Процедура выполняет заполнение субконто по корреспонденции счета.
//
// Параметры :
//	ЗаписьXDTO - Структура - с данными объекта XDTO.
//	Запись - РегистрБухгалтерииЗапись - обрабатываемая запись информационной базы.
//	КтДт - Строка - субконто по дебету/кредиту.
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализированные в рамках 
//								   выполнения сеанса обмена.
// 
Функция ЗаполнитьСубконто(Знач ЗаписьXDTO, Знач Запись, Знач КтДт, Знач КомпонентыОбмена)
	Перем Субконто, СубконтоКтДт, ВидыСубконто, Счет;
	Перем Обработано, Знч, Вид, Стр;
	Перем Действие, ПКО, Тип;
	
	Обработано = Новый Структура;
	Счет = Запись["Счет" + КтДт];
	СубконтоКтДт = Запись["Субконто" + КтДт];
	ВидыСубконто = ПланыВидовХарактеристик.ВидыСубконто;
	Действие = ДействиеПоУмолчанию();
	Для Каждого Субконто Из Счет.ВидыСубконто Цикл
		Вид = Субконто.ВидСубконто;
		Если (ВидыСубконто.Контрагенты = Вид) Тогда
			Обработано.Вставить("Контрагент", Истина);
			Стр = ЗаписьXDTO["Контрагент" + КтДт];
			Если (Стр = Неопределено) Тогда
				Знч = Справочники.Контрагенты.ПустаяСсылка();
			Иначе	
				ПКО = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_Контрагент_Получение");
				Знч = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(КомпонентыОбмена, Стр, ПКО, Действие);
				Тип = ТипЗнч(Знч);
				Если (Тип = Тип("СправочникОбъект.Контрагенты")) Тогда
					Знч = Знч.Ссылка;
				ИначеЕсли (Тип <> Тип("СправочникСсылка.Контрагенты")) Тогда
					Знч = Справочники.Контрагенты.ПустаяСсылка();
				КонецЕсли;	
			КонецЕсли;	
			СубконтоКтДт[Вид] = Знч;
		ИначеЕсли (ВидыСубконто.Договоры = Вид) Тогда
			Обработано.Вставить("Договор", Истина);
			Стр = ЗаписьXDTO["Договор" + КтДт];
			Если (Стр = Неопределено) Тогда
				Стр = ЗаписьXDTO["Контрагент" + КтДт];
				Если (Стр = Неопределено) Тогда
					Знч = Справочники.Контрагенты.ПустаяСсылка();
				Иначе	
					ПКО = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_Контрагент_Получение");
					Знч = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(КомпонентыОбмена, Стр, ПКО, Действие);
					Тип = ТипЗнч(Знч);
					Если (Тип = Тип("СправочникОбъект.Контрагенты")) Тогда
						Знч = Знч.Ссылка;
					ИначеЕсли (Тип <> Тип("СправочникСсылка.Контрагенты")) Тогда
						Знч = Справочники.Контрагенты.ПустаяСсылка();
					КонецЕсли;	
				КонецЕсли;	
				Знч = ПустойДоговор(Запись.Организация, Знч);
			Иначе	
				ПКО = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_Договор_Получение");
				Знч = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(КомпонентыОбмена, Стр, ПКО, Действие);
				Тип = ТипЗнч(Знч);
				Если (Тип = Тип("СправочникОбъект.Договоры")) Тогда
					Знч = Знч.Ссылка;
				ИначеЕсли (Тип <> Тип("СправочникСсылка.Договоры")) Тогда
					Знч = Справочники.Договоры.ПустаяСсылка();
				КонецЕсли;	
			КонецЕсли;	
			СубконтоКтДт[Вид] = Знч;
		ИначеЕсли ((ВидыСубконто.ЛицевыеСчета = Вид) Или (ВидыСубконто.РазделыЛицевыхСчетов = Вид)) Тогда
			Обработано.Вставить("ЛС", Истина);
			Стр = ЗаписьXDTO["ЛицевойСчет" + КтДт];
			Если (Стр = Неопределено) Тогда
				Если (ВидыСубконто.РазделыЛицевыхСчетов = Вид) Тогда
					Знч = Справочники.РазделыЛицевыхСчетов.ПустаяСсылка();
				Иначе
					Знч = Справочники.ЛицевыеСчета.ПустаяСсылка();
				КонецЕсли;	
			Иначе
				ПКО = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_ЛицевойСчет_Получение");
				Знч = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(КомпонентыОбмена, Стр, ПКО, Действие);
				Тип = ТипЗнч(Знч);
				Если (Тип = Тип("СправочникОбъект.ЛицевыеСчета")) Тогда
					Знч = Знч.Ссылка;
				ИначеЕсли (Тип <> Тип("СправочникСсылка.ЛицевыеСчета")) Тогда
					Знч = Справочники.ЛицевыеСчета.ПустаяСсылка();
				КонецЕсли;	
				Если (ВидыСубконто.РазделыЛицевыхСчетов = Вид) Тогда
					Если Знч.Пустая() Тогда
						Знч = Справочники.РазделыЛицевыхСчетов.ПустаяСсылка();
					Иначе
						Знч = НайтиРазделЛицевогоСчета(Знч, Запись.КФО);
						Если (Знч.Пустая() И Стр.Свойство("Код")) Тогда
							Возврат СтрШаблон(НСтр("ru = 'Для л/c ""%1"" не найден раздел'"), Стр.Код);
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;	
			СубконтоКтДт[Вид] = Знч;
		ИначеЕсли (ВидыСубконто.ВидыЦелевыхСредств = Вид) Тогда
			Обработано.Вставить("ВидЦелевых", Истина);
			Стр = ЗаписьXDTO["ВидЦелевых" + КтДт];
			Если (Стр = Неопределено) Тогда
				Знч = Справочники.ВидыЦелевыхСредств.ПустаяСсылка();
			Иначе	
