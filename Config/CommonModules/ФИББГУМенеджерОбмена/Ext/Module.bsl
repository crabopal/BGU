		 
#Область Константы

// Функция возвращает уникальный идентификатор с признаком изменения объекта из БМО.
//
// Возвращаемое значение :
//	УникальныйИдентификатор.
//
Функция ИзмененУИ() Экспорт
	
	Возврат Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000008");
	
КонецФункции

// Функция возвращает уникальный идентификатор с признаком получения объекта из БМО.
//
// Возвращаемое значение :
//	УникальныйИдентификатор.
//
Функция ПолученУИ() Экспорт
	
	Возврат Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000009");
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

// Процедура-обработчик события "ПередЗаписью" справочников для механизма регистрации объектов на узлах.
//
// Параметры:
//  Источник - СправочникОбъект, ПланВидовХарактеристикОбъект, ПланСчетовОбъект - источник события.
//  Отказ - Булево - флаг отказа от выполнения обработчика.
//
Процедура ФИБОбменБГУПередЗаписью(Источник, Отказ) Экспорт
	Перем Флаг, Тип;

	Тип = ТипЗнч(Источник);
	Флаг = (Тип = Тип("ПланСчетовОбъект.ЕПСБУ"));
	Если (Флаг И СчетДляФО(Источник.Код)) Тогда
		Возврат;                                                                                                                  
	ИначеЕсли Источник.ОбменДанными.Загрузка Тогда
		Флаг = (Тип = Тип("СправочникОбъект.ГлавыПоБюджетнойКлассификации"));
		Флаг = Флаг Или (Тип = Тип("СправочникОбъект.ВидыДоходовКДБ"));
		Флаг = Флаг Или (Тип = Тип("СправочникОбъект.СтатьиКИФ"));
		Флаг = Флаг Или (Тип = Тип("СправочникОбъект.ЦелевыеСтатьиКРБ"));
		Флаг = Флаг Или (Тип = Тип("СправочникОбъект.ПрограммыЦелевыхСтатейКРБ"));
		Флаг = Флаг Или (Тип = Тип("СправочникОбъект.ВидыРасходовКРБ"));
		Если (Флаг И (Не ЗначениеЗаполнено(Источник.ОкончаниеДействия))) Тогда
			Если Источник.ДополнительныеСвойства.Свойство("ПолучениеЭлементаДанных") Тогда
				Источник.ДатаОкончанияДействия = ДатаГоризонта();
			ИначеЕсли (ТипЗнч(Источник.ОбменДанными.Отправитель) = Тип("ПланОбменаСсылка.ФИБОбменБГУ")) Тогда	
				Источник.ДатаОкончанияДействия = ДатаГоризонта();
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
	ОбменДаннымиСобытия.МеханизмРегистрацииОбъектовПередЗаписью("ФИБОбменБГУ", Источник, Отказ);

КонецПроцедуры

// Процедура-обработчик события "ПередЗаписью" регистров для механизма регистрации объектов на узлах.
//
// Параметры:
//  Источник       - НаборЗаписейРегистра - источник события.
//  Отказ          - Булево - флаг отказа от выполнения обработчика.
//  Замещение      - Булево - признак замещения существующего набора записей.
// 
Процедура ФИБОбменБГУПередЗаписьюРегистра(Источник, Отказ, Замещение) Экспорт
	Перем Флаг, Ссылка, УИ, Тип;

	Флаг = (ТипЗнч(Источник) = Тип("РегистрБухгалтерииНаборЗаписей.ЖурналПроводокЕПСБУ"));
	Если Флаг Тогда
		Ссылка = Регистратор(Источник);
		Тип = ТипЗнч(Ссылка);
		Флаг = (Тип = Тип("ДокументСсылка.ОперацияБух"));
		Флаг = Флаг Или (Тип = Тип("ДокументСсылка.БюджетныеДанные"));
		Флаг = Флаг Или (Тип = Тип("ДокументСсылка.КассовоеВыбытие"));
		Флаг = Флаг Или (Тип = Тип("ДокументСсылка.КассовоеПоступление"));
		Флаг = Флаг Или (Тип = Тип("ДокументСсылка.РасходноеРасписание"));
		Флаг = Флаг Или (Тип = Тип("ДокументСсылка.РегистрацияОбязательствИСведенийПоДоговорам"));
		Если Флаг Тогда
			УстановитьОтключениеБезопасногоРежима(Истина);
			УстановитьПривилегированныйРежим(Истина);
			УИ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "ИДИсточника");
			Если ЭтоОбъектИзБМО(УИ) Тогда
				Возврат;
			КонецЕсли;
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
	КонецЕсли;
	ОбменДаннымиСобытия.МеханизмРегистрацииОбъектовПередЗаписьюРегистра("ФИБОбменБГУ",
																		Источник,
																		Отказ,
																		Замещение);

КонецПроцедуры

// Процедура-обработчик события "ПередЗаписью" документов для механизма регистрации объектов на узлах.
//
// Параметры:
//  Источник - ДокументОбъект - источник события.
//  Отказ - Булево - флаг отказа от выполнения обработчика.
//  РежимЗаписи - РежимЗаписиДокумента - режим записи документа.
//  РежимПроведения - РежимПроведенияДокумента - режим проведения документа.
//
Процедура ФИБОбменБГУПередЗаписьюДокумента(Источник, Отказ, РежимЗаписи, РежимПроведения) Экспорт
	Перем Флаг, Тип, фОБ;

	Тип = ТипЗнч(Источник);
	фОБ = (Тип = Тип("ДокументОбъект.ОперацияБух"));
	Флаг = фОБ Или (Тип = Тип("ДокументОбъект.БюджетныеДанные"));
	Флаг = Флаг Или (Тип = Тип("ДокументОбъект.КассовоеВыбытие"));
	Флаг = Флаг Или (Тип = Тип("ДокументОбъект.КассовоеПоступление"));
	Флаг = Флаг Или (Тип = Тип("ДокументОбъект.РасходноеРасписание"));
	Флаг = Флаг Или (Тип = Тип("ДокументОбъект.РегистрацияОбязательствИСведенийПоДоговорам"));
	Если (Флаг И (Не ЭтоОбъектИзБМО(Источник.ИДИсточника))) Тогда
		Возврат;
	ИначеЕсли (Флаг И (Не Источник.ОбменДанными.Загрузка)) Тогда
		Если (Не Источник.ДополнительныеСвойства.Свойство("ФИБОбменБГУ")) Тогда
			Если (Источник.ИДИсточника <> ПолученУИ()) Тогда
				Источник.ИДИсточника = ИзмененУИ();
			ИначеЕсли ((Не фОБ) Или ЕстьИзмененияОперацияБух(Источник)) Тогда
				Источник.ИДИсточника = ИзмененУИ();
			КонецЕсли;	
			Если (Не ОбъектУчаствовалВОбмене(Источник.Ссылка)) Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
		Источник.Движения.ЖурналПроводокЕПСБУ.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов");
	ИначеЕсли ((Тип = Тип("ПланСчетовОбъект.ЕПСБУ")) И СчетДляФО(Источник.Код)) Тогда
		Возврат;
	КонецЕсли;
	ОбменДаннымиСобытия.МеханизмРегистрацииОбъектовПередЗаписьюДокумента("ФИБОбменБГУ",
																		 Источник,
																		 Отказ,
																		 РежимЗаписи,
																		 РежимПроведения);
	Если (Флаг И (Не Источник.ОбменДанными.Загрузка)) Тогда
		Источник.Движения.ЖурналПроводокЕПСБУ.ДополнительныеСвойства.Удалить("ОтключитьМеханизмРегистрацииОбъектов");
	КонецЕсли;

КонецПроцедуры

// Процедура-обработчик события "ПередУдалением" ссылочных типов данных для механизма регистрации объектов на узлах.
//
// Параметры:
//  Источник - СправочникОбъект, ДокументОбъект, ПланВидовХарактеристикОбъект, ПланСчетовОбъект - источник события.
//  Отказ - Булево - флаг отказа от выполнения обработчика.
//
Процедура ФИБОбменБГУПередУдалением(Источник, Отказ) Экспорт
	Перем Флаг;

	Тип = ТипЗнч(Источник);
	Флаг = (Тип = Тип("ДокументОбъект.ОперацияБух"));
	Флаг = Флаг Или (Тип = Тип("ДокументОбъект.БюджетныеДанные"));
	Флаг = Флаг Или (Тип = Тип("ДокументОбъект.КассовоеВыбытие"));
	Флаг = Флаг Или (Тип = Тип("ДокументОбъект.КассовоеПоступление"));
	Флаг = Флаг Или (Тип = Тип("ДокументОбъект.РасходноеРасписание"));
	Флаг = Флаг Или (Тип = Тип("ДокументОбъект.РегистрацияОбязательствИСведенийПоДоговорам"));
	Если (Флаг И (Не ЭтоОбъектИзБМО(Источник.ИДИсточника))) Тогда
		Возврат;
	ИначеЕсли Флаг Тогда
		Источник.Движения.ЖурналПроводокЕПСБУ.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов");
		Источник.ИДИсточника = ИзмененУИ();
	ИначеЕсли ((Тип = Тип("ПланСчетовОбъект.ЕПСБУ")) И СчетДляФО(Источник.Код)) Тогда
		Возврат;
	КонецЕсли;
	ОбменДаннымиСобытия.МеханизмРегистрацииОбъектовПередУдалением("ФИБОбменБГУ", Источник, Отказ);
	Если Флаг Тогда
		Источник.Движения.ЖурналПроводокЕПСБУ.ДополнительныеСвойства.Удалить("ОтключитьМеханизмРегистрацииОбъектов");
	КонецЕсли;

КонецПроцедуры

// Обработчик регистрации изменений для начальной выгрузки данных.
//
// Параметры:
// 	Получатель - ПланОбменаСсылка.ФИБОбменБГУ - узел плана обмена, в который требуется выгрузить данные.
//	СтандартнаяОбработка - Булево - В данный параметр передается признак выполнения стандартной (системной) обработки
//                                 события.
//	Отбор - Массив - регистрируемые объекты метаданных.
//
Процедура РегистрацияИзмененийНачальнойВыгрузкиДанных(Знач Получатель, СтандартнаяОбработка, Знач Отбор) Экспорт
	Перем Стр, Значения, Текст, Знч, МД, Элем, Таб;
	
	УстановитьОтключениеБезопасногоРежима(Истина);
	УстановитьПривилегированныйРежим(Истина);
	СтандартнаяОбработка = Истина;
	ФИББГУМенеджерОбменаПереопределяемый.РегистрацияИзмененийНачальнойВыгрузкиДанных(Получатель, СтандартнаяОбработка, Отбор);
	Если (Не СтандартнаяОбработка) Тогда
		Возврат;
	ИначеЕсли (ТипЗнч(Получатель) <> Тип("ПланОбменаСсылка.ФИБОбменБГУ")) Тогда
		Возврат;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
	// Получаем настройки отбора данных.
	Стр = "РежимВыгрузкиБК,РежимВыгрузкиСправочников,РежимВыгрузкиСведений,РежимВыгрузкиСостояний";
	Стр = Стр + ",БылаВыполненаРегистрацияИзмененийНачальнойВыгрузкиДанных";
	Значения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Получатель, Стр);
	// Регистрация для выгрузки адреса хоста.
	Знч = (Значения.РежимВыгрузкиСостояний = Перечисления.РежимыВыгрузкиОбъектовОбмена.ВыгружатьПоУсловию);
	Если (Знч И (ТипЗнч(Отбор) = Тип("Массив"))) Тогда
		МД = Метаданные.РегистрыСведений.ФИБОбменБГУРегистрацияЖурналПроводокЕПСБУ;
		Знч = (Отбор.Найти(МД) <> Неопределено);
	КонецЕсли;
	Если Знч Тогда
		МД = РегистрыСведений.ФИБОбменБГУРегистрацияЖурналПроводокЕПСБУ.СоздатьНаборЗаписей();
		МД.Отбор.Корреспондент.Установить(Получатель);
		ПланыОбмена.ЗарегистрироватьИзменения(Получатель, МД);
	КонецЕсли;
	// ДОПОЛНИТЕЛЬНАЯ КЛАССИФИКАЦИЯ.
	// Регистрация изменений элементов бюджета.
	Знч = (Значения.РежимВыгрузкиСправочников = Перечисления.РежимыВыгрузкиОбъектовОбмена.ВыгружатьПоУсловию);
	Если (Знч И (ТипЗнч(Отбор) = Тип("Массив"))) Тогда
		МД = Метаданные.Справочники.ЭлементыБюджета;
		Знч = (Отбор.Найти(МД) <> Неопределено);
	КонецЕсли;
	Если Знч Тогда
		Текст = "ВЫБРАТЬ
		        |	Спр.Ссылка КАК Ссылка
		        |ИЗ	Справочник.ЭлементыБюджета КАК Спр
				|ГДЕ (НЕ Спр.ПометкаУдаления)
				|УПОРЯДОЧИТЬ ПО Спр.Код";
		Таб = ПолучитьДанные(Текст);
		Для Каждого Стр Из Таб Цикл
			ПланыОбмена.ЗарегистрироватьИзменения(Получатель, Стр.Ссылка);
		КонецЦикла;
	КонецЕсли;
	// Регистрация изменений бюджетов.
	Знч = (Значения.РежимВыгрузкиСправочников = Перечисления.РежимыВыгрузкиОбъектовОбмена.ВыгружатьПоУсловию);
	Если (Знч И (ТипЗнч(Отбор) = Тип("Массив"))) Тогда
		МД = Метаданные.Справочники.Бюджеты;
		Знч = (Отбор.Найти(МД) <> Неопределено);
	КонецЕсли;
	Если Знч Тогда
		Текст = "ВЫБРАТЬ
		        |	Спр.Ссылка КАК Ссылка
		        |ИЗ	Справочник.Бюджеты КАК Спр
				|ГДЕ (НЕ Спр.ПометкаУдаления)
				|УПОРЯДОЧИТЬ ПО Спр.Код";
		Таб = ПолучитьДанные(Текст);
		Для Каждого Стр Из Таб Цикл
			ПланыОбмена.ЗарегистрироватьИзменения(Получатель, Стр.Ссылка);
		КонецЦикла;
	КонецЕсли;
	// Регистрация изменений КОСГУ.
	Знч = (Значения.РежимВыгрузкиСправочников = Перечисления.РежимыВыгрузкиОбъектовОбмена.ВыгружатьПоУсловию);
	Если (Знч И (ТипЗнч(Отбор) = Тип("Массив"))) Тогда
		МД = Метаданные.Справочники.КОСГУ;
		Знч = (Отбор.Найти(МД) <> Неопределено);
	КонецЕсли;
	Если Знч Тогда
		Текст = "ВЫБРАТЬ
		        |	Спр.Ссылка КАК Ссылка
		        |ИЗ	Справочник.КОСГУ КАК Спр
				|ГДЕ (НЕ Спр.ПометкаУдаления)
				|УПОРЯДОЧИТЬ ПО Спр.Код";
		Таб = ПолучитьДанные(Текст);
		Для Каждого Стр Из Таб Цикл
			ПланыОбмена.ЗарегистрироватьИзменения(Получатель, Стр.Ссылка);
		КонецЦикла;
	КонецЕсли;
	// Регистрация изменений видов целевых средств.
	Знч = (Значения.РежимВыгрузкиСправочников = Перечисления.РежимыВыгрузкиОбъектовОбмена.ВыгружатьПоУсловию);
	Если (Знч И (ТипЗнч(Отбор) = Тип("Массив"))) Тогда
		МД = Метаданные.Справочники.ВидыЦелевыхСредств;
		Знч = (Отбор.Найти(МД) <> Неопределено);
	КонецЕсли;
	Если Знч Тогда
		Текст = "ВЫБРАТЬ
		        |	Спр.Ссылка КАК Ссылка
		        |ИЗ	Справочник.ВидыЦелевыхСредств КАК Спр
				|ГДЕ (НЕ Спр.ПометкаУдаления)
				|УПОРЯДОЧИТЬ ПО Спр.Код";
		Таб = ПолучитьДанные(Текст);
		Для Каждого Стр Из Таб Цикл
			ПланыОбмена.ЗарегистрироватьИзменения(Получатель, Стр.Ссылка);
		КонецЦикла;
	КонецЕсли;
	// Регистрация изменений мероприятий.
	Знч = (Значения.РежимВыгрузкиСправочников = Перечисления.РежимыВыгрузкиОбъектовОбмена.ВыгружатьПоУсловию);
	Если (Знч И (ТипЗнч(Отбор) = Тип("Массив"))) Тогда
		МД = Метаданные.Справочники.Мероприятия;
		Знч = (Отбор.Найти(МД) <> Неопределено);
	КонецЕсли;
	Если Знч Тогда
		Текст = "ВЫБРАТЬ
		        |	Спр.Ссылка КАК Ссылка
		        |ИЗ	Справочник.Мероприятия КАК Спр
				|ГДЕ (НЕ Спр.ПометкаУдаления)
				|УПОРЯДОЧИТЬ ПО Спр.Код";
		Таб = ПолучитьДанные(Текст);
		Для Каждого Стр Из Таб Цикл
			ПланыОбмена.ЗарегистрироватьИзменения(Получатель, Стр.Ссылка);
		КонецЦикла;
	КонецЕсли;
	// БЮДЖЕТНАЯ КЛАССИФИКАЦИЯ.
	// Регистрация изменений глав по бюджетной классификации.
	Знч = (Значения.РежимВыгрузкиБК = Перечисления.РежимыВыгрузкиОбъектовОбмена.ВыгружатьПоУсловию);
	Если (Знч И (ТипЗнч(Отбор) = Тип("Массив"))) Тогда
		МД = Метаданные.Справочники.ГлавыПоБюджетнойКлассификации;
		Знч = (Отбор.Найти(МД) <> Неопределено);
	КонецЕсли;
	Если Знч Тогда
		Текст = "ВЫБРАТЬ
		        |	Спр.Ссылка КАК Ссылка
		        |ИЗ	Справочник.ГлавыПоБюджетнойКлассификации КАК Спр
