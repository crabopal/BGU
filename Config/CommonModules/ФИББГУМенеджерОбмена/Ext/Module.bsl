//
// Параметры :
//	ДанныеXDTO - Структура - с данными объекта XDTO.
//	ПолученныеДанные - СправочникОбъект.ВидыДоходовКДБ - новый объект информационной базы.
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализированные в рамках 
//								   выполнения сеанса обмена.
//
Процедура ПКО_Справочник_ВидДоходовКДБ_Получение_ПриКонвертацииДанныхXDTO(Знач ДанныеXDTO,
																		  Знач ПолученныеДанные,
																		  Знач КомпонентыОбмена)
	Перем Код, Знч;

	Если ЗначениеЗаполнено(ПолученныеДанные.ОкончаниеДействия) Тогда
		ПолученныеДанные.ДатаОкончанияДействия = ПолученныеДанные.ОкончаниеДействия;
	Иначе
		ПолученныеДанные.ДатаОкончанияДействия = ДатаГоризонта();
	КонецЕсли;
	// Передача идентификатора в обработчик поиска.
	Знч = ИдентификаторXDTO(ДанныеXDTO);
	Если (Не ПустаяСтрока(Знч)) Тогда
		ПолученныеДанные.ДополнительныеСвойства.Вставить("ИдентификаторXDTO", Знч);
	КонецЕсли;	
	Код = ПолученныеДанные.Код;
	ПолученныеДанные.Наименование = Код + "0000000";
	ПолученныеДанные.Группа = Лев(Код, 1);
	ПолученныеДанные.Подгруппа = Сред(Код, 2, 2);
	ПолученныеДанные.Статья = Сред(Код, 4, 2);
	ПолученныеДанные.Подстатья = Сред(Код, 6, 3);

КонецПроцедуры

