// Обработчик конвертирует данные с адресом хоста в пакет XDTO.
// 
// Параметры :
//	ДанныеИБ - РегистрСведенийНаборЗаписей.ФИБОбменБГУРегистрацияЖурналПроводокЕПСБУ - обрабатываемый объект информационной базы.
//	ДанныеXDTO - Структура - с данными объекта XDTO.
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализированные в рамках 
//								   выполнения сеанса обмена.
//	СтекВыгрузки - Массив - содержит ссылки на выгружаемые объекты с учетом вложенности.
//	Пропустить - Булево - отмена выгрузки.
//
Процедура ПКО_РегистрСведений_БГУАдресаХостов_Отправка_ПриОтправкеДанных(Знач ДанныеИБ,
																		 Знач ДанныеXDTO,
																		 Знач КомпонентыОбмена,
																		 Знач СтекВыгрузки,
																		 Пропустить)
	Перем Стр, Знч, Парам;
	
	УстановитьОтключениеБезопасногоРежима(Истина);
	УстановитьПривилегированныйРежим(Истина);
	Стр = СокрЛП(Константы.АдресПубликацииИнформационнойБазыВИнтернете.Получить());
	Если (Не ПустаяСтрока(Стр)) Тогда
		ДанныеXDTO.Вставить("АдресХоста", Стр);
		Возврат;
	КонецЕсли;
	Стр = СокрЛП(Константы.АдресПубликацииИнформационнойБазыВЛокальнойСети.Получить());
	Если (Не ПустаяСтрока(Стр)) Тогда
		ДанныеXDTO.Вставить("АдресХоста", Стр);
		Возврат;
	КонецЕсли;
	Стр = ПолучитьНавигационнуюСсылкуИнформационнойБазы();
	Если (Не ПустаяСтрока(Стр)) Тогда
		ДанныеXDTO.Вставить("АдресХоста", Стр);
		Возврат;
	КонецЕсли;
	Парам = СтроковыеФункцииКлиентСервер.ПараметрыИзСтроки(СтрокаСоединенияИнформационнойБазы());
	Если (Парам.Свойство("file", Стр) И (Не ПустаяСтрока(Стр))) Тогда
		Стр = СтрЗаменить(Стр, "\", "/");
		Стр = СтрЗаменить(Стр, ":/", "/");
		Стр = СтрЗаменить(Стр, "//", "/");
		Стр = "e1c://filev/" + Стр;
		ДанныеXDTO.Вставить("АдресХоста", Стр);
		Возврат;
	КонецЕсли;
	Если (Парам.Свойство("Srvr", Стр) И (Не ПустаяСтрока(Стр))) Тогда
		Стр = "e1c://server/" + Стр;
		Если (Парам.Свойство("Ref", Знч) И (Не ПустаяСтрока(Знч))) Тогда
			Стр = Стр + "/" + Знч;
		КонецЕсли;
		ДанныеXDTO.Вставить("АдресХоста", Стр);
		Возврат;
	КонецЕсли;
	Пропустить = Истина;

КонецПроцедуры

