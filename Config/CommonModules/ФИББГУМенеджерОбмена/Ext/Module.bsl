#Область ПланСчетов_ЕПСБУ

// Процедура добавляет обработчики для конвертации данных плана счетов при отправке.
//
// Параметры :
//  ПравилаОбработкиДанных - таблица значений, в которую добавляются правила. 
//
Процедура ДобавитьПКО_ПланСчетов_ЕПСБУ_Отправка(Знач ПравилаКонвертации)
	Перем ПравилоКонвертации, НоваяСтрока;

	ПравилоКонвертации = ОбменДаннымиXDTOСервер.ИнициализироватьПравилоКонвертацииОбъекта(ПравилаКонвертации);
	ПравилоКонвертации.ИмяПКО = "ПланСчетов_ЕПСБУ_Отправка";
	ПравилоКонвертации.ОбъектДанных = Метаданные.ПланыСчетов.ЕПСБУ;
	ПравилоКонвертации.ОбъектФормата = "ПланСчетов.ЕПСБУ";
	ПравилоКонвертации.ПравилоДляГруппыСправочника = Ложь;
	ПравилоКонвертации.ПриОтправкеДанных = "ПКО_ПланСчетов_ЕПСБУ_Отправка_ПриОтправкеДанных";
	ПравилоКонвертации.ВариантИдентификации = "ПоПолямПоиска";

	НоваяСтрока = ПравилоКонвертации.Свойства.Добавить();
	НоваяСтрока.СвойствоКонфигурации = "";
	НоваяСтрока.СвойствоФормата = "Код";
	НоваяСтрока.ИспользуетсяАлгоритмКонвертации = Истина;

	НоваяСтрока = ПравилоКонвертации.Свойства.Добавить();
	НоваяСтрока.СвойствоКонфигурации = "Наименование";
	НоваяСтрока.СвойствоФормата = "Наименование";

	НоваяСтрока = ПравилоКонвертации.Свойства.Добавить();
	НоваяСтрока.СвойствоКонфигурации = "Забалансовый";
	НоваяСтрока.СвойствоФормата = "Забалансовый";
	
	НоваяСтрока = ПравилоКонвертации.Свойства.Добавить();
	НоваяСтрока.СвойствоКонфигурации = "Валютный";
	НоваяСтрока.СвойствоФормата = "Валютный";
	
КонецПроцедуры

// Обработчик конвертирует данные из плана счетов в пакет XDTO.
// 
// Параметры :
//	ДанныеИБ - ПланСчетовОбъект - обрабатываемый объект информационной базы.
//	ДанныеXDTO - Структура - с данными объекта XDTO.
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализированные в рамках 
//								   выполнения сеанса обмена.
//	СтекВыгрузки - Массив - содержит ссылки на выгружаемые объекты с учетом вложенности.
//	Пропустить - Булево - отмена выгрузки.
//
Процедура ПКО_ПланСчетов_ЕПСБУ_Отправка_ПриОтправкеДанных(Знач ДанныеИБ,
														  Знач ДанныеXDTO,
														  Знач КомпонентыОбмена,
														  Знач СтекВыгрузки,
														  Пропустить)
	Перем ВидыСубконто, Субконто, Вид, КС, Код, ВС, Тип, Типы, Стр;

	УстановитьОтключениеБезопасногоРежима(Истина);
	УстановитьПривилегированныйРежим(Истина);
	Пропустить = ДанныеИБ.ПометкаУдаления;
	Если Пропустить Тогда
		УдалитьРегистрацию(ДанныеИБ.Ссылка, КомпонентыОбмена);
		Возврат;
	КонецЕсли;
	Пропустить = ДанныеИБ.ЗапретитьИспользоватьВПроводках;
	Если Пропустить Тогда
		УдалитьРегистрацию(ДанныеИБ.Ссылка, КомпонентыОбмена);
		Возврат;
	КонецЕсли;
	Пропустить = ДанныеИБ.ЭлементГруппа;
	Если Пропустить Тогда
		УдалитьРегистрацию(ДанныеИБ.Ссылка, КомпонентыОбмена);
		Возврат;
	КонецЕсли;
	Пропустить = ЗначениеЗаполнено(ДанныеИБ.ДатаОкончанияДействия);
	Если Пропустить Тогда
		УдалитьРегистрацию(ДанныеИБ.Ссылка, КомпонентыОбмена);
		Возврат;
	КонецЕсли;
	Код = Лев(СокрЛП(ДанныеИБ.Код), 6);
	Пропустить = СчетДляФО(Код);
	Если Пропустить Тогда
		УдалитьРегистрацию(ДанныеИБ.Ссылка, КомпонентыОбмена);
		Возврат;
	КонецЕсли;
	Если (Не ДанныеИБ.Забалансовый) Тогда
		ДанныеXDTO.Вставить("КЭК", (ДанныеИБ.КОСГУДт <> ДанныеИБ.КОСГУКт));
	ИначеЕсли ДанныеИБ.УчетПоКЭК Тогда
		ДанныеXDTO.Вставить("КЭК", Ложь);
	КонецЕсли;
	Если (КомпонентыОбмена.УзелКорреспондентаОбъект.РежимВыгрузкиРасш = Перечисления.РежимыВыгрузкиОбъектовОбмена.ВыгружатьПриНеобходимости) Тогда
		ВС = Новый Массив;
	Иначе
		ВС = Неопределено;
	КонецЕсли;
	ВидыСубконто = ПланыВидовХарактеристик.ВидыСубконто;
	Для Каждого Субконто Из ДанныеИБ.ВидыСубконто Цикл
		Вид = Субконто.ВидСубконто;
		Если (ВидыСубконто.ЛицевыеСчета = Вид) Тогда
			ДанныеXDTO.Вставить("ЛицевойСчет", Субконто.ТолькоОбороты);
		ИначеЕсли (ВидыСубконто.РазделыЛицевыхСчетов = Вид) Тогда
			ДанныеXDTO.Вставить("ЛицевойСчет", Субконто.ТолькоОбороты);
		ИначеЕсли (ВидыСубконто.Договоры = Вид) Тогда
			ДанныеXDTO.Вставить("Договор", Субконто.ТолькоОбороты);
		ИначеЕсли (ВидыСубконто.Контрагенты = Вид) Тогда
			ДанныеXDTO.Вставить("Контрагент", Субконто.ТолькоОбороты);
		ИначеЕсли (ВидыСубконто.ВидыЦелевыхСредств = Вид) Тогда
			ДанныеXDTO.Вставить("ВидЦелевых", Субконто.ТолькоОбороты);
		ИначеЕсли (ВидыСубконто.Мероприятия = Вид) Тогда
			ДанныеXDTO.Вставить("Мероприятие", Субконто.ТолькоОбороты);
		ИначеЕсли (ВидыСубконто.Номенклатура = Вид) Тогда
			ДанныеXDTO.Вставить("Номенклатура", Субконто.ТолькоОбороты);
		ИначеЕсли (ВС <> Неопределено) Тогда
			Типы = Вид.ТипЗначения.Типы();
			Для Каждого Тип Из Типы Цикл
				Стр = ВидСубконтоСтр(Тип);
				Если ПустаяСтрока(Стр) Тогда
					Продолжить;
				КонецЕсли;
				КС = Новый Структура;
				КС.Вставить("Вид", Стр);
				КС.Вставить("Наименование", СокрЛП(Вид.Наименование));
				КС.Вставить("ТолькоОбороты", Субконто.ТолькоОбороты);
				ВС.Добавить(КС);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	КС = КлючевыеСвойства(ДанныеXDTO);
	КС.Вставить("Код", Код);
	Если ((ВС <> Неопределено) И (ВС.Количество() > 0)) Тогда
		ДанныеXDTO.Вставить("ВидыСубконто", ВС);
	КонецЕсли;	

КонецПроцедуры

