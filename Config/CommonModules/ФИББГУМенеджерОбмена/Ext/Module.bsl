//  ПравилаОбработкиДанных - таблица значений, в которую добавляются правила. 
//
Процедура ЗаполнитьПравилаОбработкиДанных(Знач НаправлениеОбмена, Знач ПравилаОбработкиДанных) Экспорт
	Перем Колонки, Имя;
	
	УстановитьОтключениеБезопасногоРежима(Истина);
	УстановитьПривилегированныйРежим(Истина);
	Если (НаправлениеОбмена = "Отправка") Тогда
		Колонки = ПравилаОбработкиДанных.Колонки;
		Имя = "ОчисткаДанных";
		Если (Колонки.Найти(Имя) = Неопределено) Тогда
	    	Колонки.Добавить(Имя, Новый ОписаниеТипов("Булево"));
