// Процедура выполняет заполнение корреспонденции счета по значению одного субконто.
//
// Параметры :
//	ЭлемXDTO - Структура - с данными объекта XDTO.
//	Субконто - значение субконто.
//	КтДт - Строка - субконто по дебету/кредиту.
// 
Процедура ЗаполнитьОдноСубконто(Знач ЭлемXDTO, Знач Субконто, Знач КтДт)
	Перем Знч;

	// Заполнение по реквизиту.
	Знч = ТипЗнч(Субконто);
	Если (Знч = Тип("СправочникСсылка.Контрагенты")) Тогда
		Знч = ПолучитьРеквизитыКонтрагента(Субконто);
		Если (Знч <> Неопределено) Тогда
			ЭлемXDTO.Вставить("Контрагент" + КтДт, Знч);
		КонецЕсли;
	ИначеЕсли (Знч = Тип("СправочникСсылка.Договоры")) Тогда
		Знч = ПолучитьРеквизитыДоговора(Субконто);
		Если (Знч <> Неопределено) Тогда
			ЭлемXDTO.Вставить("Договор" + КтДт, Знч);
		КонецЕсли;	
		Знч = ПолучитьРеквизитыКонтрагента(Субконто);
		Если (Знч <> Неопределено) Тогда
			ЭлемXDTO.Вставить("Контрагент" + КтДт, Знч);
		КонецЕсли;
	ИначеЕсли (Знч = Тип("СправочникСсылка.РазделыЛицевыхСчетов")) Тогда
		Если (Не Субконто.Пустая()) Тогда
			Знч = ФИББГУМенеджерОбменаПовтИсп.ПолучитьВладельца(Субконто);
			Знч = ПолучитьРеквизитыЛицевогоСчета(Знч);
			Если (Знч <> Неопределено) Тогда
				ЭлемXDTO.Вставить("ЛицевойСчет" + КтДт, Знч);
			КонецЕсли;
		КонецЕсли;	
	ИначеЕсли (Знч = Тип("СправочникСсылка.ЛицевыеСчета")) Тогда
		Знч = ПолучитьРеквизитыЛицевогоСчета(Субконто);
		Если (Знч <> Неопределено) Тогда
			ЭлемXDTO.Вставить("ЛицевойСчет" + КтДт, Знч);
		КонецЕсли;
	ИначеЕсли (Знч = Тип("СправочникСсылка.ВидыЦелевыхСредств")) Тогда
		Знч = ПолучитьРеквизитыКода(Субконто);
		Если (Знч <> Неопределено) Тогда
			ЭлемXDTO.Вставить("ВидЦелевых" + КтДт, Знч);
		КонецЕсли;
	ИначеЕсли (Знч = Тип("СправочникСсылка.Мероприятия")) Тогда
		Знч = ПолучитьРеквизитыКода(Субконто);
		Если (Знч <> Неопределено) Тогда
			ЭлемXDTO.Вставить("Мероприятие" + КтДт, Знч);
		КонецЕсли;
	ИначеЕсли (Знч = Тип("СправочникСсылка.Номенклатура")) Тогда
		Знч = ФИББГУМенеджерОбменаПовтИсп.ПолучитьРеквизитыНоменклатуры(Субконто);
		Если (Знч <> Неопределено) Тогда
			Знч = Новый Структура(Знч);
			Знч.Вставить("Ссылка", Субконто);
			ЭлемXDTO.Вставить("Номенклатура" + КтДт, Знч);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры	
	
// Процедура выполняет заполнение корреспонденции счета по субконто.
//
// Параметры :
//	ЭлемXDTO - Структура - с данными объекта XDTO.
//	Запись - РегистрБухгалтерииЗапись - обрабатываемая запись информационной базы.
//	КтДт - Строка - субконто по дебету/кредиту.
//	ВО - Массив - заполнить субконто (внешние объекты).
// 
Процедура ЗаполнитьПоСубконто(Знач ЭлемXDTO, Знач Запись, Знач КтДт, Знач ВО)
	Перем Субконто, СубконтоКтДт, Знч, Вид, КС, РЛС;
	
	УстановитьОтключениеБезопасногоРежима(Истина);
	УстановитьПривилегированныйРежим(Истина);
	Если (КтДт = "Дт") Тогда
		Субконто = Запись.ХарактеристикаДвиженияДт;
		СубконтоКтДт = Запись.СубконтоДт;
	Иначе
		Субконто = Запись.ХарактеристикаДвиженияКт;
		СубконтоКтДт = Запись.СубконтоКт;
	КонецЕсли;                       
	ФИББГУМенеджерОбменаПереопределяемый.Отправка_ПередЗаполнениемПоСубконто(ЭлемXDTO, Запись, КтДт, Субконто, СубконтоКтДт);
	Если (Субконто <> Неопределено) Тогда
		ЗаполнитьОдноСубконто(ЭлемXDTO, Субконто, КтДт);
	КонецЕсли;	
	Если (СубконтоКтДт <> Неопределено) Тогда
		Если (ВО = Неопределено) Тогда
			Для Каждого Субконто Из СубконтоКтДт Цикл
				ЗаполнитьОдноСубконто(ЭлемXDTO, Субконто.Значение, КтДт);
			КонецЦикла;
		Иначе	
			РЛС = ПланыВидовХарактеристик.ВидыСубконто.РазделыЛицевыхСчетов;
			Для Каждого Субконто Из СубконтоКтДт Цикл
				Знч = Субконто.Значение;
				ЗаполнитьОдноСубконто(ЭлемXDTO, Знч, КтДт);
				Если (Субконто.Ключ = РЛС) Тогда
					Продолжить;
				КонецЕсли;	
				Вид = ВидСубконтоСтр(ТипЗнч(Знч));
				Если ПустаяСтрока(Вид) Тогда
					Продолжить;
				ИначеЕсли Знч.Пустая() Тогда
					Продолжить;
				КонецЕсли;
				ЭлемXDTO.Вставить("КлючСтроки", Запись.НомерСтроки);
				КС = Новый Структура;
				КС.Вставить("Ссылка", Знч);
				Знч = Новый Структура;
				Знч.Вставить("КлючевыеСвойства", КС);
				Знч.Вставить("Вид", Вид);
				Знч.Вставить("Ключ", Запись.НомерСтроки);
				ВО.Добавить(Знч);
			КонецЦикла;
		КонецЕсли;	
	КонецЕсли;	
	ФИББГУМенеджерОбменаПереопределяемый.Отправка_ПослеЗаполненияПоСубконто(ЭлемXDTO, Запись, КтДт);

КонецПроцедуры

// Процедура записывает в файл обмена информацию об удалении объекта.
//
// Параметры :
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализированные в рамках 
//								   выполнения сеанса обмена.
//	ИмяТипа - Строка - имя типа объекта.
//	Ссылка - ДокументСсылка - ссылка на удаляемый объект.
//
Процедура ЗаписатьУдалениеОбъектаXDTO(Знач КомпонентыОбмена, Знач ИмяТипа, Знач Ссылка)
	Перем тоУдалениеОбъекта, тоЛюбаяСсылка, сЛюбаяСсылка, тоСсылкаНаОбъект;
	Перем Объект, сОбъект, тоОбъект, ОбъектУО, Элем;

	тоУдалениеОбъекта  = ФабрикаXDTO.Тип(КомпонентыОбмена.XMLСхема, "УдалениеОбъекта");
	Если (тоУдалениеОбъекта = Неопределено) Тогда
		Возврат;
	КонецЕсли;	
	сЛюбаяСсылка = тоУдалениеОбъекта.Свойства[0];
	тоЛюбаяСсылка = сЛюбаяСсылка.Тип;
	тоСсылкаНаОбъект = тоЛюбаяСсылка.Свойства[0].Тип;
	тоОбъект = Неопределено;
	сОбъект = Неопределено;
	Для Каждого Элем Из тоСсылкаНаОбъект.Свойства Цикл
		Если (Элем.Имя = ИмяТипа) Тогда
			сОбъект = Элем;
			тоОбъект = Элем.Тип;
			Прервать;
		КонецЕсли;	
	КонецЦикла;
	Если (тоОбъект = Неопределено) Тогда
		Возврат;
	КонецЕсли;	
	Элем = ФабрикаXDTO.Создать(тоОбъект, СокрЛП(Ссылка.УникальныйИдентификатор()));
	Объект = ФабрикаXDTO.Создать(тоЛюбаяСсылка);
	Объект.СсылкаНаОбъект = ФабрикаXDTO.Создать(тоСсылкаНаОбъект);
	Объект.СсылкаНаОбъект.Установить(сОбъект, Элем);
	ОбъектУО = ФабрикаXDTO.Создать(тоУдалениеОбъекта);
	ОбъектУО.СсылкаНаОбъект = ФабрикаXDTO.Создать(тоЛюбаяСсылка);
	ОбъектУО.Установить(сЛюбаяСсылка, Объект);
	ФабрикаXDTO.ЗаписатьXML(КомпонентыОбмена.ФайлОбмена, ОбъектУО);

КонецПроцедуры

// Обработчик конвертирует данные из бухгалтерского регистра в пакет XDTO.
// 
// Параметры :
//	ДанныеИБ - РегистрБухгалтерииНаборЗаписей - обрабатываемый объект информационной базы.
//	ДанныеXDTO - Структура - с данными объекта XDTO.
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализированные в рамках 
//								   выполнения сеанса обмена.
//	СтекВыгрузки - Массив - содержит ссылки на выгружаемые объекты с учетом вложенности.
//	Пропустить - Булево - отмена выгрузки.
//
Процедура ПКО_Документ_БухгалтерскаяСправка_Отправка_ПриОтправкеДанных(Знач ДанныеИБ,
																	   Знач ДанныеXDTO,
																	   Знач КомпонентыОбмена,
																	   Знач СтекВыгрузки,
																	   Пропустить)
	Перем Проводки, Запись, Элем, Знч, Таб, Стр, ЭтоБМО;
	Перем Регистратор, МД, ДатаДок, ВОДт, ВОКт;
	Перем Организация, ИФО, УточнениеПериода;

	УстановитьОтключениеБезопасногоРежима(Истина);
	УстановитьПривилегированныйРежим(Истина);
	// Если начальная регистрация не начата, то нет смысла выгружать (изменения зарегистрируются при начальной регистрации).
	Если (Не РегистрацияНачата(КомпонентыОбмена)) Тогда
		Пропустить = Истина;
		Возврат;
	КонецЕсли;	
	// Получение регистратора.
	Регистратор = Регистратор(ДанныеИБ);
	Если (Регистратор = Неопределено) Тогда
		Пропустить = Истина;
		Возврат;
	ИначеЕсли (Не ОбщегоНазначения.СсылкаСуществует(Регистратор)) Тогда
		ЗаписатьУдалениеОбъектаXDTO(КомпонентыОбмена, "БухгалтерскаяСправкаСсылка", Регистратор);
		Пропустить = Истина;
		Возврат;
	КонецЕсли;
	МД = Регистратор.Метаданные();
	ДанныеXDTO.КлючевыеСвойства.Вставить("Ссылка", Регистратор.УникальныйИдентификатор());
	Таб = ДанныеИБ;
	Знч = Новый Структура;
	Знч.Вставить("Представление");
	Для Каждого Элем Из МД.СтандартныеРеквизиты Цикл
		Если (Элем.Имя = "Номер") Тогда
			Знч.Вставить(Элем.Имя);
		ИначеЕсли (Элем.Имя = "Дата") Тогда
			Знч.Вставить(Элем.Имя);
		КонецЕсли;
	КонецЦикла;
	Если (МД.Реквизиты.Найти("Организация") <> Неопределено) Тогда
		Знч.Вставить("Организация");
	КонецЕсли;
	Если (МД.Реквизиты.Найти("ИФО") <> Неопределено) Тогда
		Знч.Вставить("ИФО");
	КонецЕсли;
	Если (МД.Реквизиты.Найти("ВидМежотчетногоПериода") <> Неопределено) Тогда
		Знч.Вставить("ВидМежотчетногоПериода");
	КонецЕсли;
	Элем = ТипЗнч(Регистратор);
	Стр = (Элем = Тип("ДокументСсылка.ОперацияБух"));
	Стр = Стр Или (Элем = Тип("ДокументСсылка.БюджетныеДанные"));
	Стр = Стр Или (Элем = Тип("ДокументСсылка.КассовоеВыбытие"));
	Стр = Стр Или (Элем = Тип("ДокументСсылка.КассовоеПоступление"));
	Стр = Стр Или (Элем = Тип("ДокументСсылка.РасходноеРасписание"));
	Стр = Стр Или (Элем = Тип("ДокументСсылка.РегистрацияОбязательствИСведенийПоДоговорам"));
	Если (Стр И (МД.Реквизиты.Найти("ИДИсточника") <> Неопределено)) Тогда
		Знч.Вставить("ИДИсточника");
	КонецЕсли;
	Знч = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Регистратор, Знч);
	Если (Знч.Свойство("ИДИсточника") И ЭтоОбъектИзБМО(Знч.ИДИсточника)) Тогда
		Пропустить = Истина;
		УдалитьРегистрацию(ДанныеИБ, КомпонентыОбмена);
		Возврат;
	ИначеЕсли (ДанныеИБ.Количество() = 0) Тогда
		ЗаписатьУдалениеОбъектаXDTO(КомпонентыОбмена, "БухгалтерскаяСправкаСсылка", Регистратор);
		Пропустить = Истина;
		Возврат;
	КонецЕсли;
	// Представление документа.
	Если (Знч.Свойство("Представление") И (Не ПустаяСтрока(Знч.Представление))) Тогда
		ДанныеXDTO.Вставить("ПредставлениеДокумента", Лев(СокрЛП(Знч.Представление), 255));
	Иначе
		ДанныеXDTO.Вставить("ПредставлениеДокумента", "-");
	КонецЕсли;
	// Номер документа.
	Если (Знч.Свойство("Номер") И (Не ПустаяСтрока(Знч.Номер))) Тогда
		ДанныеXDTO.Вставить("НомерДокумента", СокрЛП(Знч.Номер));
	КонецЕсли;
	// Дата документа.
	Если (Знч.Свойство("Дата") И ЗначениеЗаполнено(Знч.Дата)) Тогда
		ДатаДок = Знч.Дата;
		ДанныеXDTO.Вставить("ДатаДокумента", ДатаДок);
	Иначе
		ДатаДок = Неопределено;
	КонецЕсли;
	// Организация.
	Если Знч.Свойство("Организация") Тогда
		Организация = Знч.Организация;
		Если (ТипЗнч(Организация) <> Тип("СправочникСсылка.Организации")) Тогда
			Организация = Неопределено;
		ИначеЕсли Организация.Пустая() Тогда	
			Организация = Неопределено;
		КонецЕсли;	
	Иначе
		Организация = Неопределено;
	КонецЕсли;
	// Код главы (источник финансового обеспечения).
	Если Знч.Свойство("ИФО") Тогда
		ИФО = Знч.ИФО;
		Если (ТипЗнч(ИФО) <> Тип("СправочникСсылка.ИсточникиФинансовогоОбеспечения")) Тогда
			ИФО = Неопределено;
		ИначеЕсли ИФО.Пустая() Тогда	
			ИФО = Неопределено;
		КонецЕсли;	
	Иначе	
		ИФО = Неопределено;
	КонецЕсли;
	// Межотчетный период.
	Если (ДатаДок = Неопределено) Тогда
		УточнениеПериода = Null;
	ИначеЕсли Знч.Свойство("ВидМежотчетногоПериода") Тогда
		УточнениеПериода = БухгалтерскийУчет.ЗначениеУточненияПериода(Знч.ВидМежотчетногоПериода);
	Иначе
		УточнениеПериода = Неопределено;
	КонецЕсли;
	ЭтоБМО = (КомпонентыОбмена.УзелКорреспондентаОбъект.ЭтоБМО = Истина);
	// Заполнение общих реквизитов по проводкам.
	Для Каждого Запись Из Таб Цикл
		Знч = Истина;
		// Учреждение.
		Если (Запись.Организация = Организация) Тогда
			Знч = Ложь;
		ИначеЕсли (Организация = Неопределено) Тогда
			Знч = Ложь;
			Организация = Запись.Организация;
		Иначе
			Организация = Null;
		КонецЕсли;
		// Код главы.
		Если (Запись.ИФО = ИФО) Тогда
			Знч = Ложь;
		ИначеЕсли (ИФО = Неопределено) Тогда
			Знч = Ложь;
			ИФО = Запись.ИФО;
		Иначе
			ИФО = Null;
		КонецЕсли;
		// Межотчетный период.
		Если (Запись.Период <> ДатаДок) Тогда
			УточнениеПериода = Null;
		ИначеЕсли (Запись.УточнениеПериода = УточнениеПериода) Тогда
			Знч = Ложь;
		ИначеЕсли (УточнениеПериода = Неопределено) Тогда
			Знч = Ложь;
			УточнениеПериода = Запись.УточнениеПериода;
		Иначе
			УточнениеПериода = Null;
		КонецЕсли;
		Если Знч Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	// Организкция.
	Если ((Организация <> Неопределено) И (Организация <> Null)) Тогда
		Знч = ПолучитьРеквизитыОрганизации(Организация);
		Если (Знч <> Неопределено) Тогда
			ДанныеXDTO.Вставить("Организация", Знч);
		КонецЕсли;
	КонецЕсли;
	// ИФО.
	Если ((ИФО <> Неопределено) И (ИФО <> Null)) Тогда
		Знч = ФИББГУМенеджерОбменаПовтИсп.ПолучитьППП(ИФО);
		Если (Знч = "000") Тогда
			Знч = ФИББГУМенеджерОбменаПовтИсп.ПолучитьППП(Организация);
		КонецЕсли;
		Если (Знч <> "000") Тогда
			ДанныеXDTO.Вставить("ИФО", Новый Структура("КодГлавыБК", Новый Структура("Код", Знч)));
		КонецЕсли;
	КонецЕсли;
	// Межотчетный период.
	Если ((УточнениеПериода <> Неопределено)
	   И  (УточнениеПериода <> Null)
	   И  (УточнениеПериода <> 0)) Тогда
		ДанныеXDTO.Вставить("УточнениеПериода", УточнениеПериода);
	КонецЕсли;
	// Определение необходимости выгрузки внешних объектов.
	Знч = (ЭтоБМО И (КомпонентыОбмена.УзелКорреспондентаОбъект.РежимВыгрузкиРасш = Перечисления.РежимыВыгрузкиОбъектовОбмена.ВыгружатьПриНеобходимости));
	Если Знч Тогда
		ВОДт = Новый Массив;
		ВОКт = Новый Массив;
	Иначе
		ВОДт = Неопределено;
		ВОКт = Неопределено;
	КонецЕсли;	
	Проводки = Новый Массив;
	Для Каждого Запись Из Таб Цикл
		Элем = Новый Структура;
		// Суммы.
		Если (Запись.Сумма <> 0) Тогда
			Элем.Вставить("Сумма", Запись.Сумма);
		КонецЕсли;
		Если ЗначениеЗаполнено(Запись.ВалютнаяСуммаДт) Тогда
			Элем.Вставить("СуммаВВалютеДт", Запись.ВалютнаяСуммаДт);
		КонецЕсли;
		Если ЗначениеЗаполнено(Запись.ВалютнаяСуммаКт) Тогда
			Элем.Вставить("СуммаВВалютеКт", Запись.ВалютнаяСуммаКт);
		КонецЕсли;
		Если (Элем.Количество() = 0) Тогда
			Продолжить;
		КонецЕсли;
		// Период.
		Знч = Запись.Период;
		Если (Знч <> ДатаДок) Тогда
			Элем.Вставить("Период", Знч);
		КонецЕсли;
		// Уточнение периода.
		Знч = Запись.УточнениеПериода;
		Если ((Знч <> 0) И (Знч <> УточнениеПериода)) Тогда
			Элем.Вставить("УточнениеПериода", Знч);
		КонецЕсли;
		// Балансовые измерения.
		// Номер журнала.
		Знч = ПолучитьКод(Запись.ЖурналОпераций);
		Если (Не ПустаяСтрока(Знч)) Тогда
			Элем.Вставить("НомерЖурнала", Знч);
		КонецЕсли;
		// КФО.
		Знч = ФИББГУМенеджерОбменаПовтИсп.ПолучитьКодКФО(Запись.КФО);
		Если (Не ПустаяСтрока(Знч)) Тогда
			Элем.Вставить("КФО", Знч);
		КонецЕсли;
		// Реквизиты.
		Знч = СокрЛП(Запись.Содержание);
		Если (Не ПустаяСтрока(Знч)) Тогда
			Элем.Вставить("Содержание", Знч);
		КонецЕсли;
		// Вид документа.
		Знч = СокрЛП(Запись.ВидПервичногоДокумента);
		Если (Не ПустаяСтрока(Знч)) Тогда
			Элем.Вставить("ВидДокумента", Знч);
		КонецЕсли;
		// Номер документа.
		Знч = СокрЛП(Запись.НомерПервичногоДокумента);
		Если (Не ПустаяСтрока(Знч)) Тогда
			Элем.Вставить("НомерДокумента", СокрЛП(Прав(Знч, 50)));
		КонецЕсли;
		// Дата документа.
		Знч = Запись.ДатаПервичногоДокумента;
		Если ЗначениеЗаполнено(Знч) Тогда
			Элем.Вставить("ДатаДокумента", Знч);
		КонецЕсли;
		// Корреспонденция по дебету.
		Знч = Лев(СокрЛП(Запись.СчетДт), 6);
		Если (Не ПустаяСтрока(Знч)) Тогда
			Элем.Вставить("СчетДт", Новый Структура("Код", Знч));
		КонецЕсли;
		// КПС.
		Знч = ПолучитьРеквизитыКПС(Запись.КПСДт, ЭтоБМО);
		Если (Знч <> Неопределено) Тогда
			Элем.Вставить("КПСДт", Знч);
		КонецЕсли;
		// КОСГУ.
		Знч = ПолучитьРеквизитыКода(Запись.КЭКДт);
		Если (Знч <> Неопределено) Тогда
			Элем.Вставить("КЭКДт", Знч);
		КонецЕсли;
		// Валюта.
		Если ЗначениеЗаполнено(Запись.ВалютаДт) Тогда
			Знч = ФИББГУМенеджерОбменаПовтИсп.ПолучитьРеквизитыВалюты(Запись.ВалютаДт);
			Если (Знч <> Неопределено) Тогда
				Знч = Новый Структура(Знч);
				Знч.Вставить("Ссылка", Запись.ВалютаДт);
				Элем.Вставить("ВалютаДт", Знч);
			КонецЕсли;
		КонецЕсли;
		// Заполнение корреспонденции счета по субконто.
		ЗаполнитьПоСубконто(Элем, Запись, "Дт", ВОДт);
		// Корреспонденция по кредиту.
		Знч = Лев(СокрЛП(Запись.СчетКт), 6);
		Если (Не ПустаяСтрока(Знч)) Тогда
			Элем.Вставить("СчетКт", Новый Структура("Код", Знч));
		КонецЕсли;
		// КБК.
		Знч = ПолучитьРеквизитыКПС(Запись.КПСКт, ЭтоБМО);
		Если (Знч <> Неопределено) Тогда
			Элем.Вставить("КПСКт", Знч);
		КонецЕсли;
		// КОСГУ.
		Знч = ПолучитьРеквизитыКода(Запись.КЭККт);
		Если (Знч <> Неопределено) Тогда
			Элем.Вставить("КЭККт", Знч);
		КонецЕсли;
		// Валюта.
		Если ЗначениеЗаполнено(Запись.ВалютаКт) Тогда
			Знч = ФИББГУМенеджерОбменаПовтИсп.ПолучитьРеквизитыВалюты(Запись.ВалютаКт);
			Если (Знч <> Неопределено) Тогда
				Знч = Новый Структура(Знч);
				Знч.Вставить("Ссылка", Запись.ВалютаКт);
				Элем.Вставить("ВалютаКт", Знч);
			КонецЕсли;
		КонецЕсли;
		// Заполнение корреспонденции счета по субконто.
		ЗаполнитьПоСубконто(Элем, Запись, "Кт", ВОКт);
		// Добавление строки.
		Проводки.Добавить(Элем);
	КонецЦикла;
	// Если нет ни одной проводки, то документ надо удалить.
	Если (Проводки.Количество() = 0) Тогда
		ЗаписатьУдалениеОбъектаXDTO(КомпонентыОбмена, "БухгалтерскаяСправкаСсылка", Регистратор);
		Пропустить = Истина;
		Возврат;
	КонецЕсли;	
	// Добавление реквизитов с проводками.
	ДанныеXDTO.Вставить("Проводки", Проводки);
	// При обмене БМО нужны реквизиты платежки и внешние объекты.	
	Если ЭтоБМО Тогда
		// Внешние объекты (дебет).
		Если ((ВОДт <> Неопределено) И (ВОДт.Количество() <> 0)) Тогда
			ДанныеXDTO.Вставить("СубконтоДт", ВОДт);
		КонецЕсли;	
		// Внешние объекты (кредит).
		Если ((ВОКт <> Неопределено) И (ВОКт.Количество() <> 0)) Тогда
			ДанныеXDTO.Вставить("СубконтоКт", ВОКт);
		КонецЕсли;	
		// Добавление реквизитов платежных документов.
		ДобавитьРеквизитыПлатежныхДокументов(ДанныеXDTO, Регистратор, КомпонентыОбмена);
	КонецЕсли;
	// Заполнение дополнительных реквизитов.
	ФИББГУМенеджерОбменаПереопределяемый.Отправка_ПослеЗаполненияБухгалтерскойСправки(Регистратор,
																					  ДанныеИБ,
																					  ДанныеXDTO,
																					  КомпонентыОбмена,
																					  СтекВыгрузки,
																					  Пропустить);

КонецПроцедуры

