			ИначеЕсли (Тип <> Тип("СправочникСсылка.РазделыПодразделыКРБ")) Тогда
				Знч = Справочники.РазделыПодразделыКРБ.ПустаяСсылка();
			КонецЕсли;
			Объект.РазделПодразделКРБ = Знч;
		Иначе
			// Старый формат.
			Объект.РазделПодразделКРБ = РазделПодраздел(Лев(КПС, 4));
		КонецЕсли;	
		Объект.АналитическийКодКПС = АналитическийКодКПС(Сред(КПС, 5, 10));
		Если (Объект.УточнениеПоказателя = Перечисления.ВидыКБК.КРБ) Тогда
			Если (рКПС.Свойство("ВидРасходаКРБ", Отбор) И (Отбор <> Неопределено)) Тогда
				ПКО = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_ВидРасходовКРБ_Получение");
				Знч = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(КомпонентыОбмена, Отбор, ПКО, Действие);
				Тип = ТипЗнч(Знч);
				Если (Тип = Тип("СправочникОбъект.ВидыРасходовКРБ")) Тогда
					Знч = Знч.Ссылка;
				ИначеЕсли (Тип <> Тип("СправочникСсылка.ВидыРасходовКРБ")) Тогда
					Знч = Справочники.ВидыРасходовКРБ.ПустаяСсылка();
				КонецЕсли;
				Объект.ВидРасходаКРБ = Знч;
				Если (Не Знч.Пустая()) Тогда
					Отбор = Новый Структура;
					Отбор.Вставить("Наименование", "НаименованиеПолное");
					Отбор.Вставить("ДНД", "ДатаНачалаДействия");
					Отбор.Вставить("ДОД", "ДатаОкончанияДействия");
					Отбор = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Знч, Отбор);
					ЗаполнитьЗначенияСвойств(Объект, Отбор); 
					Объект.ДатаНачалаДействия = Макс(Объект.ДатаНачалаДействия, Отбор.ДНД);
					Объект.ДатаОкончанияДействия = Мин(Объект.ДатаОкончанияДействия, Отбор.ДОД);
				КонецЕсли;	
			КонецЕсли;	
		ИначеЕсли (Объект.УточнениеПоказателя = Перечисления.ВидыКБК.КДБ) Тогда
			Если (рКПС.Свойство("АналитическаяГруппаКДБ", Отбор) И (Отбор <> Неопределено)) Тогда
				ПКО = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_КОСГУ_Получение");
				Знч = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(КомпонентыОбмена, Отбор, ПКО, Действие);
				Тип = ТипЗнч(Знч);
				Если (Тип = Тип("СправочникОбъект.КОСГУ")) Тогда
					Знч = Знч.Ссылка;
				ИначеЕсли (Тип <> Тип("СправочникСсылка.КОСГУ")) Тогда
					Знч = Справочники.КОСГУ.ПустаяСсылка();
				КонецЕсли;
				Объект.АналитическаяГруппаКДБ = Знч;
			КонецЕсли;
		Иначе
			Если (рКПС.Свойство("АналитическаяГруппаКИФ", Отбор) И (Отбор <> Неопределено)) Тогда
				ПКО = ОбменДаннымиXDTOСервер.ПКОПоИмени(КомпонентыОбмена, "Справочник_КОСГУ_Получение");
				Знч = ОбменДаннымиXDTOСервер.СтруктураОбъектаXDTOВДанныеИБ(КомпонентыОбмена, Отбор, ПКО, Действие);
				Тип = ТипЗнч(Знч);
				Если (Тип = Тип("СправочникОбъект.КОСГУ")) Тогда
					Знч = Знч.Ссылка;
				ИначеЕсли (Тип <> Тип("СправочникСсылка.КОСГУ")) Тогда
					Знч = Справочники.КОСГУ.ПустаяСсылка();
				КонецЕсли;
				Объект.АналитическаяГруппаКИФ = Знч;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	// Заполнение наименования КПС по наименованию из простых кодов БК.
	Если ПустаяСтрока(Объект.Наименование) Тогда
		Знч = Объект.ГруппаПодгруппаКИФ;
		Если Знч.Пустая() Тогда
			Знч = Объект.АналитическаяГруппаКДБ;
			Если Знч.Пустая() Тогда
				Знч = Объект.АналитическаяГруппаКИФ;
				Если Знч.Пустая() Тогда
					Знч = Объект.РазделПодразделКРБ;
					Если Знч.Пустая() Тогда
						Знч = Объект.АналитическийКодКПС;
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	
		Если Знч.Пустая() Тогда
			Объект.Наименование = СтрШаблон(НСтр("ru = 'КПС ""%1"" создан при синхронизации данных с БМО'"), КПС);
		Иначе	
			Объект.Наименование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Знч, "НаименованиеПолное");
		КонецЕсли;	
	КонецЕсли;
	Если (Объект.ДатаОкончанияДействия = ДатаГоризонта()) Тогда
		Объект.ОкончаниеДействия = Неопределено;
	Иначе
		Объект.ОкончаниеДействия = Объект.ДатаОкончанияДействия;
	КонецЕсли;	
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

// Функция находит КЭК по коду.
//
// Параметры :
//	Код - Строка - код КЭК.
//
// Возвращаемое значение :
//	СправочникСсылка.КОСГУ.
//
Функция КЭК(Знач Код)
	Перем Текст, Таб, Отбор;
	
	Если (ТипЗнч(Код) <> Тип("Строка")) Тогда
		Возврат Справочники.КОСГУ.ПустаяСсылка();
	ИначеЕсли ПустаяСтрока(Код) Тогда
		Возврат Справочники.КОСГУ.ПустаяСсылка();
	КонецЕсли;
	Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	        |	Спр.Ссылка КАК Ссылка
	        |ИЗ	Справочник.КОСГУ КАК Спр
	        |ГДЕ (Спр.Код = &Код)
			|УПОРЯДОЧИТЬ ПО Спр.ПометкаУдаления";
	Отбор = Новый Структура;
	Отбор.Вставить("Код", Лев(Код, 3));
	Таб = ПолучитьДанные(Текст, Отбор);
	Если (Таб.Количество() > 0) Тогда
		Возврат Таб[0].Ссылка;
	КонецЕсли;
	УстановитьОтключениеБезопасногоРежима(Истина);
	УстановитьПривилегированныйРежим(Истина);
	Объект = Справочники.КОСГУ.СоздатьЭлемент();
	Объект.Код = Код;
	Объект.НаименованиеПолное = СтрШаблон(НСтр("ru = 'КЭК ""%1"" создан синхронизации данных с БМО'"), Код);
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

// Функция возвращает пустой договор.
//
// Параметры :
//	Организация - СправочникСсылка.Организации - учреждение.
//	Контрагент - СправочникСсылка.Контрагенты - контрагент.
//
// Возвращаемое значение :
//	СправочникСсылка.Договоры.
//
Функция ПустойДоговор(Знач Организация, Знач Контрагент)
	Перем Текст, Таб;

	Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	        |	Спр.Ссылка КАК Ссылка
	        |ИЗ	Справочник.Договоры КАК Спр
	        |ГДЕ (Спр.Код = ""00000000000"")
			|УПОРЯДОЧИТЬ ПО Спр.ПометкаУдаления, Спр.ВАрхиве";
	Таб = ПолучитьДанные(Текст);
	Если (Таб.Количество() > 0) Тогда
		Возврат Таб[0].Ссылка;
	КонецЕсли;
	УстановитьОтключениеБезопасногоРежима(Истина);
	УстановитьПривилегированныйРежим(Истина);
	Таб = Справочники.Договоры.СоздатьЭлемент();
	Таб.ЭлементГруппа = Ложь;
	Таб.ВАрхиве = Истина;
	Таб.Организация = Организация;
	Таб.Код = "00000000000";
	Таб.Наименование = НСтр("ru = 'Не заполнен (создан при обмене с БМО)'");
	Таб.Контрагент = Контрагент;
	Таб.ОбменДанными.Загрузка = Истина;
	Таб.Записать();
	Возврат Таб.Ссылка;

КонецФункции

// Функция ищет раздел лицевого счета.
//
// Параметры :
//	ЛС - СправочникСсылка.ЛицевыеСчета - лицевой счет.
//	КФО - ПеречислениеСсылка.КВД - код вида финансового обеспечения.
//
// Возвращаемое значение :
//	СправочникСсылка.РазделыЛицевыхСчетов.
//
Функция НайтиРазделЛицевогоСчета(Знач ЛС, Знач КФО)
	Перем Текст, Таб, Отбор;
	
	Если ЛС.Пустая() Тогда
		Возврат Справочники.РазделыЛицевыхСчетов.ПустаяСсылка();
	ИначеЕсли КФО.Пустая() Тогда
		Возврат Справочники.РазделыЛицевыхСчетов.ПустаяСсылка();
	КонецЕсли;
	Отбор = Новый Структура;
	Отбор.Вставить("ЛС", ЛС);
	Отбор.Вставить("КФО", КФО);
	Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	        |	Спр.Ссылка КАК Ссылка
	        |ИЗ Справочник.РазделыЛицевыхСчетов КАК Спр
			|ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.РазделыЛицевыхСчетов.ДопустимыеКФО КАК СпрКФО
			|ПО (Спр.Ссылка = СпрКФО.Ссылка) 
	        |ГДЕ (Спр.Владелец = &ЛС) И (СпрКФО.КФО = &КФО)
			|УПОРЯДОЧИТЬ ПО Спр.ПометкаУдаления";
	Таб = ПолучитьДанные(Текст, Отбор);
	Если (Таб.Количество() > 0) Тогда
		Возврат Таб[0].Ссылка;
	ИначеЕсли (КФО <> Перечисления.КВД.Бюджет) Тогда
		Возврат Справочники.РазделыЛицевыхСчетов.ПустаяСсылка();
	КонецЕсли;
	УстановитьОтключениеБезопасногоРежима(Истина);
	УстановитьПривилегированныйРежим(Истина);
	Таб = Справочники.РазделыЛицевыхСчетов.СоздатьЭлемент();
	Таб.Владелец = ЛС;
	Таб.ИсточникСредств = ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.ИсточникиСредств.СредстваБюджета");
	Таб.Код = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Таб.ИсточникСредств, "Код");
	Таб.ДопустимыеКФО.Добавить().КФО = КФО;
	Таб.Наименование = "(" + Таб.Код + ") " + ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Таб.Владелец, "Наименование"); 
	Таб.ОбменДанными.Загрузка = Истина;
	Таб.Записать();
	Возврат Таб.Ссылка;

КонецФункции

// Функция возвращает период по реквизитам из файла.
//
// Параметры :
//	рПериод - Структура - реквизиты периода.
//
// Возвращаемое значение :
//	СправочникСсылка.Периоды.
//
Функция ПериодПлана(Знач рПериод)
	Перем ДатаНачала, ДатаОкончания;
	
	Если (рПериод = Неопределено) Тогда
		Возврат Справочники.Периоды.ПустаяСсылка();
	ИначеЕсли (Не рПериод.Свойство("ДатаНачала", ДатаНачала)) Тогда
		Возврат Справочники.Периоды.ПустаяСсылка();
	ИначеЕсли (ТипЗнч(ДатаНачала) <> Тип("Дата")) Тогда
		Возврат Справочники.Периоды.ПустаяСсылка();
	ИначеЕсли (Не рПериод.Свойство("ДатаОкончания", ДатаОкончания)) Тогда
		Возврат Справочники.Периоды.ПустаяСсылка();
	ИначеЕсли (ТипЗнч(ДатаОкончания) <> Тип("Дата")) Тогда
		Возврат Справочники.Периоды.ПустаяСсылка();
	Иначе
		Возврат ФИББГУМенеджерОбменаПовтИсп.ПериодПлана(НачалоДня(ДатаНачала), НачалоДня(ДатаОкончания));
	КонецЕсли;	
	
КонецФункции

// Функция ищет счет контрагента.
//
// Параметры :
//	Контрагент - СправочникСсылка.Контрагенты - контрагент.
//	Номер - Строка - номер счета контрагента.
//	ТипЛицевогоСчета - Неопределено, ПеречислениеСсылка.ТипыЛицевыхСчетов - тип лицевого счета. 
//
// Возвращаемое значение :
//	СправочникСсылка.БанковскиеИКазначейскиеСчета.
//
Функция НайтиСчетКонтрагента(Знач Контрагент, Знач Номер = "", Знач ТипЛицевогоСчета = Неопределено)
	Перем Текст, Таб, Отбор;
	
	Если Контрагент.Пустая() Тогда
		Возврат Справочники.БанковскиеИКазначейскиеСчета.ПустаяСсылка();
	КонецЕсли;
	Отбор = Новый Структура;
	Отбор.Вставить("Контрагент", Контрагент);
	Если ПустаяСтрока(Номер) Тогда
		Текст = "ВЫБРАТЬ ПЕРВЫЕ 2
				|	Спр.Ссылка КАК Ссылка
				|ИЗ Справочник.БанковскиеИКазначейскиеСчета КАК Спр
				|ГДЕ (Спр.Владелец = &Контрагент)
				|  И (НЕ Спр.ПометкаУдаления)";
	Иначе	
		Отбор.Вставить("Код", Номер);
		Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
				|	Спр.Ссылка КАК Ссылка
				|ИЗ Справочник.БанковскиеИКазначейскиеСчета КАК Спр
				|ГДЕ (Спр.Владелец = &Контрагент) И (Спр.Код = &Код)
				|  И (НЕ Спр.ПометкаУдаления)";
	КонецЕсли;
	Если (ТипЛицевогоСчета <> Неопределено) Тогда
		Отбор.Вставить("ТипЛицевогоСчета", ТипЛицевогоСчета);
		Текст = Текст + "
				|  И (Спр.ТипЛицевогоСчета = &ТипЛицевогоСчета)";
	КонецЕсли;	
	Таб = ПолучитьДанные(Текст, Отбор);
	Если (Таб.Количество() = 1) Тогда
		Возврат Таб[0].Ссылка;
	Иначе
		Возврат Справочники.БанковскиеИКазначейскиеСчета.ПустаяСсылка();
	КонецЕсли;

КонецФункции

// Процедура добавляет учетный номер обязательства.
//
// Параметры :
//	УчетныйНомер - Строка - учетный номер обязательства.
//	Договор - СправочникСсылка.Договоры - договор.
//
Процедура ДобавитьУчетныйНомер(Знач УчетныйНомер, Знач Договор)
	Перем Набор, Запись;
	
	Если ПустаяСтрока(УчетныйНомер) Тогда	
		Возврат;
	ИначеЕсли Договор.Пустая() Тогда
		Возврат;
	КонецЕсли;
	// Запись номер обязательства в базу.
	Набор = РегистрыСведений.УчетныеНомераОбязательств.СоздатьНаборЗаписей();
	Набор.Отбор.Обязательство.Установить(Договор);
	Запись = Набор.Добавить();
	Запись.Обязательство = Договор;
	Запись.УчетныйНомерОбязательства = УчетныйНомер;
	Набор.Записать(Истина);
	
КонецПроцедуры

// Функция возвращает идентификатор вида субконто.
//
// Параметры :
//	Тип - тип ссылки на внешний объект.
//
// Возвращаемое значение :
//	Строка.
//
Функция ВидСубконтоСтр(Знач Тип)
	
	Если (Тип = Тип("СправочникСсылка.БСО")) Тогда
		Возврат "БСО";
	ИначеЕсли (Тип = Тип("СправочникСсылка.ВидыДенежныхДокументов")) Тогда
		Возврат "ВДД";
	ИначеЕсли (Тип = Тип("СправочникСсылка.ВидыЗатрат")) Тогда
		Возврат "ВЗ";
	ИначеЕсли (Тип = Тип("СправочникСсылка.ВидыНалоговИПлатежей")) Тогда
		Возврат "ВНИП";
	ИначеЕсли (Тип = Тип("СправочникСсылка.ВидыОбязательств")) Тогда
		Возврат "ВО";
	ИначеЕсли (Тип = Тип("СправочникСсылка.ВидыУдержаний")) Тогда
		Возврат "ВУ";
	ИначеЕсли (Тип = Тип("СправочникСсылка.ДенежныеДокументы")) Тогда
		Возврат "ДД";
	ИначеЕсли (Тип = Тип("СправочникСсылка.НалогиИПлатежиОрганизации")) Тогда
		Возврат "НИПО";
	ИначеЕсли (Тип = Тип("СправочникСсылка.ОбъектыФинансовыхВложений")) Тогда
		Возврат "ОФВ";
	ИначеЕсли (Тип = Тип("СправочникСсылка.ОсновныеСредства")) Тогда
		Возврат "ОО";
	ИначеЕсли (Тип = Тип("СправочникСсылка.ПричиныОшибокПрошлыхЛет")) Тогда
		Возврат "ПОПЛ";
	ИначеЕсли (Тип = Тип("СправочникСсылка.РазделыЛицевыхСчетов")) Тогда
		Возврат "РЛС";
	ИначеЕсли (Тип = Тип("СправочникСсылка.РасходыБудущихПериодов")) Тогда
		Возврат "РБП";
	ИначеЕсли (Тип = Тип("СправочникСсылка.Резервы")) Тогда
		Возврат "РЕЗ";
	ИначеЕсли (Тип = Тип("СправочникСсылка.ЦМО")) Тогда
		Возврат "ЦМО";
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

#КонецОбласти

#Область ПроцедурыКонвертации

// Возвращает версию формата менеджера обмена.
//
// Возвращаемое значение:
//  Строка - номер версии.
//
Функция ВерсияФорматаМенеджераОбмена() Экспорт

    Возврат "2";

КонецФункции

// Вызывается перед выполнением синхронизации данных.
//
// Параметры:
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализируемые
//								   в рамках выполнения сеанса обмена.
//
Процедура ПередКонвертацией(Знач КомпонентыОбмена) Экспорт
	Перем ЭтоОтправка, Узел, Стр, Текст, Таб, Набор;

	УстановитьОтключениеБезопасногоРежима(Истина);
	УстановитьПривилегированныйРежим(Истина);
	Узел = КомпонентыОбмена.УзелКорреспондента;
	Если (Не ЗначениеЗаполнено(Узел)) Тогда
		КомпонентыОбмена.XMLСхема = СтрЗаменить(КомпонентыОбмена.XMLСхема, "EnterpriseData", "StateAccounting");
		Возврат;
	КонецЕсли;	
	ЭтоОтправка = (КомпонентыОбмена.НаправлениеОбмена = "Отправка");
	Если ЭтоОтправка Тогда
		Стр = "БылаВыполненаРегистрацияИзмененийНачальнойВыгрузкиДанных";
		Если (ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Узел, Стр) <> Истина) Тогда
			РегистрацияИзмененийНачальнойВыгрузкиДанных(Узел, Истина, Неопределено);
		КонецЕсли;
	Иначе	
		Стр = "ПроверятьПолученныеДокументы";
		Парам = КомпонентыОбмена.ПараметрыКонвертации;
		Парам.ПроверятьПолученныеПроводки = (ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Узел, Стр) = Истина);
		// Удаление лишних ссылок.
		Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		        |	Рег.Ссылка КАК Ссылка
		        |ИЗ РегистрСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов КАК Рег
		        |ГДЕ (Рег.УзелИнформационнойБазы = &Узел)
		        |  И (Рег.Ссылка ССЫЛКА Справочник.Журналы)
				|
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|ВЫБРАТЬ РАЗЛИЧНЫЕ
		        |	Рег.Ссылка КАК Ссылка
		        |ИЗ РегистрСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов КАК Рег
		        |ГДЕ (Рег.УзелИнформационнойБазы = &Узел)
				|  И (Рег.Ссылка = Неопределено)";
		Стр = Новый Структура;
		Стр.Вставить("Узел", Узел);
		Таб = ПолучитьДанные(Текст, Стр);
		Если (Таб.Количество() <> 0) Тогда
			Набор = РегистрыСведений.ПубличныеИдентификаторыСинхронизируемыхОбъектов.СоздатьНаборЗаписей();
			Набор.Отбор.УзелИнформационнойБазы.Установить(Узел);
			Набор.ОбменДанными.Загрузка = Истина;
			Для Каждого Стр Из Таб Цикл
				Набор.Отбор.Ссылка.Установить(Стр.Ссылка);
				Набор.Записать(Истина);
			КонецЦикла;
		КонецЕсли;	
	КонецЕсли;
	ФИББГУМенеджерОбменаПереопределяемый.ПередКонвертацией(КомпонентыОбмена);

КонецПроцедуры

// Вызывается после выполнения синхронизации данных.
//
// Параметры:
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализированные
//								   в рамках выполнения сеанса обмена.
//
Процедура ПослеКонвертации(Знач КомпонентыОбмена) Экспорт
	Перем ЭтоОтправка, Флаг, Узел, Набор, Запись, ДГ, Знч;
	Перем Начало, Конец, Организации, Счета, Стр, ПШ;

	УстановитьОтключениеБезопасногоРежима(Истина);
	УстановитьПривилегированныйРежим(Истина);
	ЭтоОтправка = (КомпонентыОбмена.НаправлениеОбмена = "Отправка");
	Если (Не ЭтоОтправка) Тогда
		// Получаем настройки отбора данных.
		Стр = "Ссылка,РежимВыгрузкиЕПСБУ,ДатаНачалаВыгрузкиЕПСБУ,Организации,НомерОтправленного";
		Стр = Стр + ",Счета,ИспользоватьОтборПоСчетам,ВыгружатьДанныеПоЗабалансовымСчетам";
		Стр = Стр + ",ПериодРегистрацииВМесяцахЕПСБУ,НомерПринятого,ЭтоБМО";
		Узел = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(КомпонентыОбмена.УзелКорреспондента, Стр);
		Организации = Узел.Организации.Выгрузить().ВыгрузитьКолонку("Организация");
		Узел.Удалить("Организации");
		Счета = Узел.Счета.Выгрузить().ВыгрузитьКолонку("Счет");
		Узел.Удалить("Счета");
		Набор = РегистрыСведений.ФИБОбменБГУРегистрацияЖурналПроводокЕПСБУ.СоздатьНаборЗаписей();
		Набор.Отбор.Узел.Установить(Узел.Ссылка);
		Набор.Прочитать();
		Флаг = (Узел.РежимВыгрузкиЕПСБУ = Перечисления.РежимыВыгрузкиОбъектовОбмена.ВыгружатьПоУсловию);
		Флаг = Флаг И (Организации.Количество() > 0);
		Если Флаг Тогда
			Если (Набор.Количество() = 1) Тогда
				Запись = Набор[0];
				ПШ = Ложь;
			Иначе             
				Набор.Очистить();
				Запись = Набор.Добавить();
				Запись.Узел = Узел.Ссылка;
				Запись.НомерПакета = 2;
				Запись.ДатаРегистрации = Узел.ДатаНачалаВыгрузкиЕПСБУ;
				ФИББГУМенеджерОбменаПереопределяемый.ИнициализироватьДатуРегистрации(Запись);
				ПШ = Истина;
			КонецЕсли;                                          
			ДГ = ДатаГоризонта();
			Флаг = (Узел.ЭтоБМО = Истина);
			Флаг = Флаг Или ((ТипЗнч(Узел.НомерПринятого) = Тип("Число") И (2 <= Узел.НомерПринятого)));
			Флаг = Флаг И (Запись.ДатаРегистрации < ДГ);
			Флаг = Флаг И (Макс(2, Запись.НомерПакета) <= КомпонентыОбмена.НомерСообщенияПолученногоКорреспондентом);
			Если Флаг Тогда
				Запись.НомерПакета = 1 + Узел.НомерОтправленного; 
				Начало = Запись.ДатаРегистрации;
				Конец = Начало;
				Знч = Мин(Макс(1, Узел.ПериодРегистрацииВМесяцахЕПСБУ), 96); 
				ФИББГУМенеджерОбменаПереопределяемый.УвеличитьДатуРегистрации(Конец, ПШ, Знч);
				Если (ТекущаяДатаСеанса() < Конец) Тогда
					Конец = Неопределено;
					Запись.ДатаРегистрации = ДГ;
				Иначе
					Запись.ДатаРегистрации = Конец;
				КонецЕсли;
				Если (Не Узел.ИспользоватьОтборПоСчетам) Тогда
					Счета = Неопределено;
				КонецЕсли;
				Флаг = Узел.ВыгружатьДанныеПоЗабалансовымСчетам;
				РегистрацияИзмененийВБухгалтерскомРегистре(Узел.Ссылка,
														   Начало,
														   Конец,
														   Организации,
														   Счета,
														   Флаг);
				Набор.Записать(Истина);
			ИначеЕсли (Запись.НомерПакета < 2) Тогда
				Набор.Очистить();
				Набор.Записать(Истина);
			КонецЕсли;	
		ИначеЕсли (Набор.Количество() > 0) Тогда
			Набор.Очистить();
			Набор.Записать(Истина);
		КонецЕсли;	
	КонецЕсли;	
	ФИББГУМенеджерОбменаПереопределяемый.ПослеКонвертации(КомпонентыОбмена);
	
КонецПроцедуры
                                      
// Вызывается перед выполнением отложенного заполнения.
//
// Параметры:
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализированные
//								   в рамках выполнения сеанса обмена.
//
Процедура ПередОтложеннымЗаполнением(Знач КомпонентыОбмена) Экспорт

	УстановитьОтключениеБезопасногоРежима(Истина);
	УстановитьПривилегированныйРежим(Истина);
	ФИББГУМенеджерОбменаПереопределяемый.ПередОтложеннымЗаполнением(КомпонентыОбмена);
	
КонецПроцедуры

// Процедура-обработчик события менеджера обмена перед обработкой удаления объекта (пришла информация об удалении объекта в другой базе данных).
//
// Параметры:
//	КомпонентыОбмена - Структура - параметры и правила обмена, инициализированные
//								   в рамках выполнения сеанса обмена.
//  Объект - объект, удаленный в другой базе данных.
//
Процедура ПередОбработкойУдаляемогоОбъекта(Знач КомпонентыОбмена, Объект) Экспорт
	Перем Тип, Флаг;

	Тип = ТипЗнч(Объект);
	Флаг = (Тип = Тип("ДокументОбъект.ОперацияБух"));
	Флаг = Флаг Или (Тип = Тип("ДокументОбъект.БюджетныеДанные"));
	Флаг = Флаг Или (Тип = Тип("ДокументОбъект.КассовоеВыбытие"));
	Флаг = Флаг Или (Тип = Тип("ДокументОбъект.КассовоеПоступление"));
	Флаг = Флаг Или (Тип = Тип("ДокументОбъект.РасходноеРасписание"));
	Флаг = Флаг Или (Тип = Тип("ДокументОбъект.РегистрацияОбязательствИСведенийПоДоговорам"));
	Если (Флаг И (Объект.ИДИсточника = ИзмененУИ())) Тогда
		Объект = Неопределено;
	КонецЕсли;	
	
КонецПроцедуры	

#КонецОбласти

