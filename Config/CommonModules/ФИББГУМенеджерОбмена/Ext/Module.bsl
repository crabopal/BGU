// Функция определяет создан ли объект при обмене с БМО.
// 
// Параметры :
//	УИ - УникальныйИдентификатор.
//
// Возвращаемое значение :
//	Булево.
//
Функция ЭтоОбъектИзБМО(Знач УИ)

	Если (УИ = ПолученУИ()) Тогда
		Возврат Истина;
	ИначеЕсли (УИ = ИзмененУИ()) Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;

