// Функция возвращает аналогичный период года, смещенного относительно текущего года на Смещение.
//
// Параметры:
//	ИсходныйПериод - СправочникСсылка.Периоды, исходный период, по которому выполняется поиск;
//	Смещение - число, смещение относительно исходного периода. Знак определяет направление смещения.
//
// Результат:
//	СправочникСсылка.Периоды - период, смещенный от исходного на Смещение.
//
Функция АналогичныйПериод(Знач ИсходныйПериод = Неопределено, Смещение = 0) Экспорт
	
	Если ИсходныйПериод.Периодичность = Перечисления.Периодичность.Декада Тогда
		
		// анализируем
		ГодДатыНачала						= Год(ИсходныйПериод.ДатаНачала);
		МесяцДатыНачала						= Месяц(ИсходныйПериод.ДатаНачала);
		ДеньДатыНачала						= День(ИсходныйПериод.ДатаНачала);
		ДекадаДатыНачала					= Цел((ДеньДатыНачала - 1) / 10) + 1;
		ДекадаДатыНачала					= ?(ДекадаДатыНачала = 4, 3, ДекадаДатыНачала);
		НомерДекадыНЭ						= ГодДатыНачала * 36 + (МесяцДатыНачала - 1) * 3 + (ДекадаДатыНачала - 1);
		
		// изменяем
		НомерДекадыНЭ						= НомерДекадыНЭ + Смещение;
		
		// синтезируем
		ГодДатыНачалаОтнПериода				= Цел((НомерДекадыНЭ)/ 36);
		ДекадаВГоду							= НомерДекадыНЭ % 36;
		МесяцВГодуДатыНачалаОтнПериода		= Цел(ДекадаВГоду / 3) + 1;
		ДекадаВМесяце						= ДекадаВГоду % 3;
		ДеньВМесяцеДатыНачалаОтнПериода		= ДекадаВМесяце * 10 + 1;
		
		ДатаНачалаОтносительногоПериода		= Дата(ГодДатыНачалаОтнПериода+Смещение, МесяцВГодуДатыНачалаОтнПериода, ДеньВМесяцеДатыНачалаОтнПериода);
		
	Иначе
		ДатаНачалаОтносительногоПериода		= ДобавитьМесяц(ИсходныйПериод.ДатаНачала, 12 * Смещение);
	КонецЕсли;
	
	ВозвращаемоеЗначение = Справочники.Периоды.ПустаяСсылка();
	
	ДатаНачалаОтносительногоПериода = НачалоДня(ДатаНачалаОтносительногоПериода);
	
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	|	Периоды.Ссылка КАК Период
	|ИЗ
	|	Справочник.Периоды КАК Периоды
	|ГДЕ
	|	Периоды.ДатаНачала = &ДатаНачала
	|	И Периоды.Периодичность = &Периодичность");
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачалаОтносительногоПериода);
	Запрос.УстановитьПараметр("Периодичность", ИсходныйПериод.Периодичность);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Если Выборка.Следующий() Тогда
		ВозвращаемоеЗначение = Выборка.Период;
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// Функция возвращает период, смещенный относительно заданного на Смещение.
//
// Параметры:
//	ИсходныйПериод - СправочникСсылка.Периоды, исходный период, по которому выполняется поиск;
//	Смещение - число, смещение относительно исходного периода. Знак определяет направление смещения.
//
// Результат:
//	СправочникСсылка.Периоды - период, смещенный от исходного на Смещение.
//
Функция ОтносительныйПериод(Знач ИсходныйПериод = Неопределено, Смещение = 0) Экспорт
	
	ВозвращаемоеЗначение = Справочники.Периоды.ПустаяСсылка();
	
	Если ИсходныйПериод.Периодичность		= Перечисления.Периодичность.Год 
		ИЛИ ИсходныйПериод.Периодичность      = Перечисления.Периодичность.ДевятьМесяцев Тогда
		ДатаНачалаОтносительногоПериода		= ДобавитьМесяц(ИсходныйПериод.ДатаНачала, 12 * Смещение);
	ИначеЕсли ИсходныйПериод.Периодичность = Перечисления.Периодичность.Полугодие Тогда
		ДатаНачалаОтносительногоПериода		= ДобавитьМесяц(ИсходныйПериод.ДатаНачала, 6 * Смещение);
	ИначеЕсли ИсходныйПериод.Периодичность = Перечисления.Периодичность.Квартал Тогда
		ДатаНачалаОтносительногоПериода		= ДобавитьМесяц(ИсходныйПериод.ДатаНачала, 3 * Смещение);
	ИначеЕсли ИсходныйПериод.Периодичность = Перечисления.Периодичность.Месяц Тогда
		ДатаНачалаОтносительногоПериода		= ДобавитьМесяц(ИсходныйПериод.ДатаНачала, Смещение);
	ИначеЕсли ИсходныйПериод.Периодичность = Перечисления.Периодичность.Декада Тогда
		
		// анализируем
		ГодДатыНачала						= Год(ИсходныйПериод.ДатаНачала);
		МесяцДатыНачала						= Месяц(ИсходныйПериод.ДатаНачала);
		ДеньДатыНачала						= День(ИсходныйПериод.ДатаНачала);
		ДекадаДатыНачала					= Цел((ДеньДатыНачала - 1) / 10) + 1;
		ДекадаДатыНачала					= ?(ДекадаДатыНачала = 4, 3, ДекадаДатыНачала);
		НомерДекадыНЭ						= ГодДатыНачала * 36 + (МесяцДатыНачала - 1) * 3 + (ДекадаДатыНачала - 1);
		
		// изменяем
		НомерДекадыНЭ						= НомерДекадыНЭ + Смещение;
		
		// синтезируем
		ГодДатыНачалаОтнПериода				= Цел((НомерДекадыНЭ)/ 36);
		ДекадаВГоду							= НомерДекадыНЭ % 36;
		МесяцВГодуДатыНачалаОтнПериода		= Цел(ДекадаВГоду / 3) + 1;
		ДекадаВМесяце						= ДекадаВГоду % 3;
		ДеньВМесяцеДатыНачалаОтнПериода		= ДекадаВМесяце * 10 + 1;
		
		ДатаНачалаОтносительногоПериода		= Дата(ГодДатыНачалаОтнПериода, МесяцВГодуДатыНачалаОтнПериода, ДеньВМесяцеДатыНачалаОтнПериода);
		
	ИначеЕсли ИсходныйПериод.Периодичность = Перечисления.Периодичность.День Тогда
		ОдинДень							= НачалоДня(Дата(2000, 1, 2)) - НачалоДня(Дата(2000, 1, 1));
		ДатаНачалаОтносительногоПериода		= ИсходныйПериод.ДатаНачала + ОдинДень * Смещение;
	Иначе
		Возврат ВозвращаемоеЗначение;
	КонецЕсли;
	ДатаНачалаОтносительногоПериода = НачалоДня(ДатаНачалаОтносительногоПериода);
	
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	|	Периоды.Ссылка КАК Период
	|ИЗ
	|	Справочник.Периоды КАК Периоды
	|ГДЕ
	|	Периоды.ДатаНачала = &ДатаНачала
	|	И Периоды.Периодичность = &Периодичность");
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачалаОтносительногоПериода);
	Запрос.УстановитьПараметр("Периодичность", ИсходныйПериод.Периодичность);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Если Выборка.Следующий() Тогда
		ВозвращаемоеЗначение = Выборка.Период;
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// Функция возвращает период с периодичностью год, смещенный относительно текущего года на Смещение.
//
// Параметры:
//	локПериодОтчета - исходный период;
//	Смещение - число, смещение относительно исходного периода. Знак определяет направление смещения.
//
// Результат:
//	СправочникСсылка.Периоды - период с периодичностью год, смещенный от исходного на Смещение.
//
Функция ГодСоСдвигом(Знач ИсходныйПериод = Неопределено, Смещение = 0) Экспорт
	
	ВозвращаемоеЗначение = Справочники.Периоды.ПустаяСсылка();
	ДатаОкончанияОтносительногоПериода = НачалоДня(НачалоГода(ИсходныйПериод.ДатаНачала)-1);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Периоды.Ссылка КАК Период
		|ИЗ
		|	Справочник.Периоды КАК Периоды
		|ГДЕ
		|	Периоды.ДатаОкончания = &ДатаОкончания
		|	И Периоды.Периодичность = &Периодичность";

	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончанияОтносительногоПериода);
	Запрос.УстановитьПараметр("Периодичность", БюджетнаяОтчетностьКлиентСерверПовтИсп.ПолучитьПеречислениеПериодичность("Год", Ложь));
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Если Выборка.Следующий() Тогда
		ВозвращаемоеЗначение = Выборка.Период;
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// Функция возвращает период с периодичностью месяц, смещенный относительно даты окончания исходного периода на Смещение.
//
// Параметры:
//	локПериодОтчета - исходный период;
//	Смещение - число, смещение относительно исходного периода. Знак определяет направление смещения.
//
// Результат:
//	СправочникСсылка.Периоды - период с периодичностью месяц, смещенный от исходного на Смещение.
//
Функция ПоследнийМесяцПериодаОтчетаСоСдвигом(Знач ИсходныйПериод = Неопределено, Смещение = 0) Экспорт
		
	ДатаНачалаОтносительногоПериода = ДобавитьМесяц(НачалоМесяца(ИсходныйПериод.ДатаОкончания),Смещение);
	
	ВозвращаемоеЗначение = Справочники.Периоды.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Периоды.Ссылка КАК Период
		|ИЗ
		|	Справочник.Периоды КАК Периоды
		|ГДЕ
		|	Периоды.ДатаНачала = &ДатаНачала
		|	И Периоды.Периодичность = &Периодичность";

	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачалаОтносительногоПериода);
	Запрос.УстановитьПараметр("Периодичность", Перечисления.Периодичность.Месяц);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Если Выборка.Следующий() Тогда
		ВозвращаемоеЗначение = Выборка.Период;
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции


Функция ПолучитьСоответствиеОтборовОперандов() Экспорт
	СоответствиеОтборов = Новый Соответствие;	
	СоответствиеОтборов.Вставить(Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение,ВидСравнения.Равно);
	СоответствиеОтборов.Вставить(Перечисления.СпособыВычисленияПараметровОперандов.НеФиксированноеЗначение,ВидСравнения.НеРавно);
	СоответствиеОтборов.Вставить(Перечисления.СпособыВычисленияПараметровОперандов.ЗначениеПоИерархии,ВидСравнения.ВИерархии);
	СоответствиеОтборов.Вставить(Перечисления.СпособыВычисленияПараметровОперандов.НеЗначениеПоИерархии,ВидСравнения.НеВИерархии);
	СоответствиеОтборов.Вставить(Перечисления.СпособыВычисленияПараметровОперандов.СписокФиксированныхЗначений,ВидСравнения.ВСписке);
	СоответствиеОтборов.Вставить(Перечисления.СпособыВычисленияПараметровОперандов.НеСписокФиксированныхЗначений,ВидСравнения.НеВСписке);
	СоответствиеОтборов.Вставить(Перечисления.СпособыВычисленияПараметровОперандов.ВСпискеПоИерархии,ВидСравнения.ВСпискеПоИерархии);
	СоответствиеОтборов.Вставить(Перечисления.СпособыВычисленияПараметровОперандов.НеВСпискеПоИерархии,ВидСравнения.НеВСпискеПоИерархии);
	
	Возврат СоответствиеОтборов;
КонецФункции

