// Задает флаги поддержки различных функциональных особенностей в конфигурациях-потребителях
//
// Возвращаемое значение:
//   - Структура с набором предопределенных свойств.
//
Функция ИспользуемыеПодсистемыБюджетнойОтчетности() Экспорт 
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ПравилаЗаполнения",ОбщегоНазначения.ПодсистемаСуществует("УчетГосУчрежденийПодсистемы.РегламентированнаяБухОтчетность.ЗаполнениеРегламентированнойБухгалтерскойОтчетности"));  
	СтруктураПараметров.Вставить("ПользовательскиеПроцедуры",Истина); //код в правилах заполнения
	СтруктураПараметров.Вставить("ПодключаемыеАлгоритмы",Ложь); //внешние обработки
	СтруктураПараметров.Вставить("МежформенныеПравилаОбработки",Ложь);
	СтруктураПараметров.Вставить("МакетыОтображения",ОбщегоНазначения.ПодсистемаСуществует("УчетГосУчрежденийПодсистемы.РегламентированнаяБухОтчетность.МакетыОтображения"));
	СтруктураПараметров.Вставить("РегистрацияВерсийОтчетов",ОбщегоНазначения.ПодсистемаСуществует("УчетГосУчрежденийПодсистемы.РегламентированнаяБухОтчетность.РегистрацияВерсийКомплектовОтчетности"));
	
	БюджетнаяОтчетностьСерверПереопределяемый.ИспользуемыеПодсистемыБюджетнойОтчетности(СтруктураПараметров);
	
	Возврат СтруктураПараметров;
	
КонецФункции

Функция ПолучитьВладельцаСубконтоДляАналитики(ВидАналитики) Экспорт 
	
	Если ТипЗнч(ВидАналитики) = Тип("ПланВидовХарактеристикСсылка.АналитикаОтчетов") Тогда
		
		РеквизитыОбъекта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВидАналитики,"ТипЗначения,СписокЗначений");
		Если ОбщегоНазначения.ОписаниеТипаСостоитИзТипа(РеквизитыОбъекта.ТипЗначения, Тип("СправочникСсылка.Субконто"))
			И ЗначениеЗаполнено(РеквизитыОбъекта.СписокЗначений) Тогда 
		
			Возврат РеквизитыОбъекта.СписокЗначений;
			
		КонецЕсли;
		
	КонецЕсли; 
		
	Возврат ВидАналитики;	
	
КонецФункции

