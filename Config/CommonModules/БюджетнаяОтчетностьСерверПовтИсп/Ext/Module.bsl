// Получение информации о структуре отчета


// Возвращает полный перечень аналитических измерений, присутствующих в отчете
//
// Параметры
//  ВидОтчета	 - Вид отчета
//
// Возвращаемое значение:
//   ТаблицаЗначений: ВидАналитики,ЭтоДопРеквизит,КодВидаАналитики,ГруппаРаскрытия,ИмяОбъектаАналитики.
//
Функция ПереченьАналитическихИзмеренийВидаОтчета(ВидОтчета) Экспорт

	ПереченьИзмерений = Новый ТаблицаЗначений;
	ПереченьИзмерений.Колонки.Добавить("ВидАналитики");
	ПереченьИзмерений.Колонки.Добавить("ТипЗначения");
	ПереченьИзмерений.Колонки.Добавить("Наименование");
	ПереченьИзмерений.Колонки.Добавить("ИмяОбъектаАналитики");
	ПереченьИзмерений.Колонки.Добавить("КодВидаАналитики");
	ПереченьИзмерений.Колонки.Добавить("ЭтоДопРеквизит");
	ПереченьИзмерений.Колонки.Добавить("ГруппаРаскрытия");
	ПереченьИзмерений.Колонки.Добавить("КодГруппыРаскрытия");
	ПереченьИзмерений.Колонки.Добавить("ИмяТипаДанных");
	ПереченьИзмерений.Колонки.Добавить("ПорядковыйНомер");
	ПереченьИзмерений.Колонки.Добавить("ВидКлассификатораБК");
	
	Запрос 		 = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДополнительныеРеквизитыОтчетов.Код КАК ИмяОбъектаАналитики,
	|	ДополнительныеРеквизитыОтчетов.ВидАналитики,
	|	ДополнительныеРеквизитыОтчетов.ВидАналитики.Наименование КАК Наименование,
	|	ДополнительныеРеквизитыОтчетов.ВидАналитики.Код КАК КодВидаАналитики,
	|	ИСТИНА КАК ЭтоДопРеквизит,
	|	NULL КАК ГруппаРаскрытия,
	|	NULL КАК КодГруппыРаскрытия,
	|	ДополнительныеРеквизитыОтчетов.ВидАналитики.ТипЗначения КАК ТипЗначения,
	|	ДополнительныеРеквизитыОтчетов.ПорядковыйНомер КАК ПорядковыйНомер,
	|	ДополнительныеРеквизитыОтчетов.ВидАналитики.ВидКлассификатораБК КАК ВидКлассификатораБК
	|ИЗ
	|	Справочник.ДополнительныеРеквизитыОтчетов КАК ДополнительныеРеквизитыОтчетов
	|ГДЕ
	|	ДополнительныеРеквизитыОтчетов.Владелец = &ВидОтчета
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ГруппыРаскрытияАналитика.НомерСтроки,
	|	ГруппыРаскрытияАналитика.ВидАналитики,
	|	ГруппыРаскрытияАналитика.ВидАналитики.Наименование,
	|	ГруппыРаскрытияАналитика.ВидАналитики.Код,
	|	ЛОЖЬ,
	|	ГруппыРаскрытияАналитика.Ссылка,
	|	ГруппыРаскрытияАналитика.Ссылка.Код,
	|	ГруппыРаскрытияАналитика.ВидАналитики.ТипЗначения,
	|	ГруппыРаскрытияАналитика.НомерСтроки,
	|	ГруппыРаскрытияАналитика.ВидАналитики.ВидКлассификатораБК
	|ИЗ
	|	Справочник.ГруппыРаскрытия.Аналитика КАК ГруппыРаскрытияАналитика
	|ГДЕ
	|	ГруппыРаскрытияАналитика.Ссылка.Владелец = &ВидОтчета";
	
	Запрос.УстановитьПараметр("ВидОтчета",ВидОтчета);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СтрПеречня = ПереченьИзмерений.Добавить();
		ЗаполнитьЗначенияСвойств(СтрПеречня,Выборка);
		
		Если НЕ ЗначениеЗаполнено(Выборка.ВидКлассификатораБК) Тогда
			ТипЗначения = Выборка.ТипЗначения.Типы()[0];
			ИмяТипа 	= Метаданные.НайтиПоТипу(ТипЗначения).ПолноеИмя();
		Иначе
			ИмяТипа 	= "Справочник." + ОбщегоНазначения.ИмяЗначенияПеречисления(Выборка.ВидКлассификатораБК);
		КонецЕсли;
		
		СтрПеречня.ИмяТипаДанных	= ИмяТипа;
		СтрПеречня.КодВидаАналитики = СокрП(СтрПеречня.КодВидаАналитики);
		СтрПеречня.ТипЗначения		= Выборка.ТипЗначения;
		СтрПеречня.ПорядковыйНомер  = Выборка.ПорядковыйНомер;
		СтрПеречня.ВидКлассификатораБК		= Выборка.ВидКлассификатораБК;
		
		Если Выборка.ЭтоДопРеквизит Тогда
			СтрПеречня.ИмяОбъектаАналитики = СокрП(СтрПеречня.ИмяОбъектаАналитики);
		Иначе
			СтрПеречня.ИмяОбъектаАналитики = "Аналитика" + Выборка.ИмяОбъектаАналитики;
			СтрПеречня.КодГруппыРаскрытия  = СокрП(СтрПеречня.КодГруппыРаскрытия);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ПереченьИзмерений;

КонецФункции // ПереченьАналитическихИзмеренийВидаОтчета()

// Возвращает перечень аналитик, определенных для групп раскрытия.
//
Функция ПереченьАналитикПоГруппамРаскрытия(ВидОтчета) Экспорт

	СтруктураОтбора = Новый Структура("ЭтоДопРеквизит",Ложь);
	ПолныйПеречень  = БюджетнаяОтчетностьСерверПовтИсп.ПереченьАналитическихИзмеренийВидаОтчета(ВидОтчета);
	
	Результат = ПолныйПеречень.Скопировать(СтруктураОтбора);
	Результат.Колонки.Удалить("ЭтоДопРеквизит");
	Результат.Сортировать("ГруппаРаскрытия,ПорядковыйНомер");
	
	Возврат Результат;

КонецФункции // ПереченьАналитикПоГруппамРаскрытия()

// Возвращает перечень аналитик для доп. реквизитов отчета
//
Функция ПереченьАналитикУровняОтчета(ВидОтчета) Экспорт

	СтруктураОтбора = Новый Структура("ЭтоДопРеквизит",Истина);
	ПолныйПеречень  = БюджетнаяОтчетностьСерверПовтИсп.ПереченьАналитическихИзмеренийВидаОтчета(ВидОтчета);
	
	Результат = ПолныйПеречень.Скопировать(СтруктураОтбора);
	Результат.Колонки.Удалить("ЭтоДопРеквизит");
	Результат.Колонки.Удалить("ГруппаРаскрытия");
	Результат.Колонки.Удалить("КодГруппыРаскрытия");
	Результат.Сортировать("ПорядковыйНомер");
	
	Возврат Результат;

КонецФункции // ПереченьАналитикиУровняОтчета()

// Таблица значений аналитики указанной группы раскрытия.
//
Функция КоллекцияАналитикГруппыРаскрытия(ГруппаРаскрытия) Экспорт

	ВидОтчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ГруппаРаскрытия,"Владелец");
	
	АналитикаГруппыРаскрытия = БюджетнаяОтчетностьСерверПовтИсп.ПереченьАналитикПоГруппамРаскрытия(ВидОтчета);
	АналитикаГруппыРаскрытия = АналитикаГруппыРаскрытия.Скопировать(Новый Структура("ГруппаРаскрытия",ГруппаРаскрытия));
	АналитикаГруппыРаскрытия.Сортировать("ПорядковыйНомер");
	
	Возврат АналитикаГруппыРаскрытия;

КонецФункции // КоллекцияАналитикГруппыРаскрытия()

// Функция возвращает полное описание вида отчета
//
Функция ПредставлениеВидаОтчета(ВидОтчета) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА ВидыОтчетов.ПолноеНаименование = """"
	|			ТОГДА ВидыОтчетов.Наименование
	|		ИНАЧЕ ВидыОтчетов.ПолноеНаименование
	|	КОНЕЦ КАК Название,
	|	ВидыОтчетов.КодФормыПоКлассификатору КАК КодПоКлассификатору
	|ИЗ
	|	Справочник.ВидыОтчетов КАК ВидыОтчетов
	|ГДЕ
	|	ВидыОтчетов.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка",ВидОтчета);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Название + ?(ЗначениеЗаполнено(Выборка.КодПоКлассификатору)," ("+Выборка.КодПоКлассификатору+")", "");
	Иначе
		Возврат Строка(ВидОтчета); // Для неправильных параметров
	КонецЕсли;

КонецФункции // ПредставлениеВидаОтчета()

// Кэшируемое получение реальных путей в ИБ по отношению к прикладным полям в бланках
//
Функция ПолучитьПутьКДаннымДляПоляАналитики(Знач ТипЗначения, Знач ИмяПоля) Экспорт

	Перем Результат;
	
	СоответствиеПолей = СоответствиеПолейАналитики();
	
	СтрокиТипа = СоответствиеПолей.НайтиСтроки(Новый Структура("ТипЗначения,ИмяРеквизита", ТипЗначения, ИмяПоля));
	Если СтрокиТипа.Количество() Тогда
		
		Результат = СтрокиТипа[0];
		
	Иначе
		// Для типа не заявлено специализированных путей.
		
		МетаданныеТипа = Метаданные.НайтиПоПолномуИмени(ТипЗначения);
		
		Если Метаданные.Справочники.Содержит(МетаданныеТипа)
			 или Метаданные.ПланыСчетов.Содержит(МетаданныеТипа) Тогда
			 
			Если МетаданныеТипа.Реквизиты.Найти(ИмяПоля) <> Неопределено
				 или ОбщегоНазначения.ЭтоСтандартныйРеквизит(МетаданныеТипа.СтандартныеРеквизиты, ИмяПоля) Тогда
				Результат = ИмяПоля; // Есть реквизит с таким именем
			Иначе
				Результат = Неопределено; // Такого поля нет, его нельзя запросить из ИБ.
			КонецЕсли;
			 
		ИначеЕсли Метаданные.Перечисления.Найти(МетаданныеТипа.Имя) <> Неопределено Тогда
			Результат = ИмяПоля; // Перечисления обрабатываются особым образом
		КонецЕсли;
		
	КонецЕсли;

	Ответ = Новый Структура("ПутьКДанным,ЭтоВыражение");
	
	Если ТипЗнч(Результат) = Тип("СтрокаТаблицыЗначений") Тогда
		ЗаполнитьЗначенияСвойств(Ответ, Результат);
	ИначеЕсли Не Результат = Неопределено Тогда
		Ответ.ПутьКДанным  = Результат;
		Ответ.ЭтоВыражение = Ложь;
	Иначе
		Ответ = Неопределено;
	КонецЕсли;
	
	Возврат Ответ;
	
КонецФункции // ПолучитьПутьКДаннымДляПоляАналитики()

Функция ПолучитьКлассификациюДоходов(Знач ДатаДействия) Экспорт
	
	Перем ДеревоКлассификатораДоходов;
	
	//Получаем дерево классификатора доходов для анализа БК по нему
	ДеревоКлассификатораДоходов = Новый ДеревоЗначений;
	ДеревоКлассификатораДоходов.Колонки.Добавить("Ссылка");
	ДеревоКлассификатораДоходов.Колонки.Добавить("Код");
	ДеревоКлассификатораДоходов.Колонки.Добавить("КодВД");
	ДеревоКлассификатораДоходов.Колонки.Добавить("КодКЭК");
	ДеревоКлассификатораДоходов.Колонки.Добавить("Наименование");
	ДеревоКлассификатораДоходов.Колонки.Добавить("ИндексКартинки");
	ДеревоКлассификатораДоходов.Колонки.Добавить("СсылкаКОСГУ");
	ДеревоКлассификатораДоходов.Колонки.Добавить("Уровень");
	
	Справочники.ВидыДоходовКДБ.ЗаполнитьДеревоКлассификатораДоходов(ДеревоКлассификатораДоходов,ДатаДействия);
		
	Строка10 = БюджетнаяОтчетность.ПолучитьОписаниеТиповСтроки(10);
	Строка3 =  БюджетнаяОтчетность.ПолучитьОписаниеТиповСтроки(3);
	ТаблицаДоходов = Новый ТаблицаЗначений;
	ТаблицаДоходов.Колонки.Добавить("КодВД", Строка10);
	ТаблицаДоходов.Колонки.Добавить("КодКЭК", Строка3);
	ТаблицаДоходов.Колонки.Добавить("ЕстьДетальные", Новый ОписаниеТипов("Булево"));
	
	ПеренестиДеревоВТаблицу(ДеревоКлассификатораДоходов, ТаблицаДоходов);
	
	//бывают коды доходов, сотоящие только из ан.групп, они используются в 110 форме, например, 0000000000 0000 190
	ТаблицаАнГрупп = ТаблицаДоходов.Скопировать(,"КодКЭК");
	ТаблицаАнГрупп.Свернуть("КодКЭК");
	ПустойКодВД = "0000000000";
	Для Каждого СтрТаб Из ТаблицаАнГрупп Цикл
		НовСтр = ТаблицаДоходов.Добавить();
		НовСтр.КодВД = ПустойКодВД;
		НовСтр.КодКЭК = СтрТаб.КодКЭК;
		НовСтр.ЕстьДетальные = Ложь;
	КонецЦикла;
	
	ТаблицаДоходов.Индексы.Добавить("КодВД,КодКЭК");
	
	Возврат ТаблицаДоходов;
	
КонецФункции

Процедура ПеренестиДеревоВТаблицу(Дерево, Таблица)
	Для Каждого СтрокаДерева Из Дерево.Строки Цикл
		НовСтр = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр,СтрокаДерева);

		НовСтр.ЕстьДетальные = СтрокаДерева.Строки.Количество()>0;	
		
		ПеренестиДеревоВТаблицу(СтрокаДерева, Таблица);
	КонецЦикла;
КонецПроцедуры

