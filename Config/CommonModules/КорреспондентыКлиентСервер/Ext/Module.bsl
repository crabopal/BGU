Функция СведенияОГражданствеЗаполнены(Форма, СообщенияПроверки = "") Экспорт
	
	РезультатПроверки = Истина;
	
	Если НЕ Форма.ГражданствоФизическихЛицЛицоБезГражданства И НЕ ЗначениеЗаполнено(Форма.ГражданствоФизическихЛиц.Страна) Тогда
		СообщенияПроверки = НСтр("ru = 'Не указана страна гражданства'");
		РезультатПроверки = Ложь;
	КонецЕсли; 
	
	Возврат РезультатПроверки;
	
КонецФункции

Функция ПлатежныеРеквизитыКорреспондентаСтрокой(СтруктураРеквизитов, ПредставленияРеквизитов = Неопределено, ТекстПустого = "<...>") Экспорт
	
	Если ПредставленияРеквизитов = Неопределено Тогда
		ПредставленияРеквизитов = Новый Структура("ИНН, КПП, Корреспондент, СчетНомер, Банк, БИК, КоррСчет", "КонтрагентИНН", "КонтрагентКПП", "КонтрагентНаименование", "КонтрагентБанковскийСчет", "КонтрагентНаименованиеБанка", "КонтрагентБИКБанка", "КонтрагентКорСчетБанка");
	КонецЕсли;
	
	Результат = "";
	
	Если СтруктураРеквизитов.Свойство(ПредставленияРеквизитов.Корреспондент) И ЗначениеЗаполнено(СтруктураРеквизитов[ПредставленияРеквизитов.Корреспондент])Тогда
		Результат = Результат + СтруктураРеквизитов[ПредставленияРеквизитов.Корреспондент];
	КонецЕсли;	

	Если СтруктураРеквизитов.Свойство(ПредставленияРеквизитов.ИНН) И ЗначениеЗаполнено(СтруктураРеквизитов[ПредставленияРеквизитов.ИНН]) Тогда
		Результат = Результат + ", ИНН " + СтруктураРеквизитов[ПредставленияРеквизитов.ИНН];
	КонецЕсли;	
	
	Если СтруктураРеквизитов.Свойство(ПредставленияРеквизитов.КПП) И ЗначениеЗаполнено(СтруктураРеквизитов[ПредставленияРеквизитов.КПП]) Тогда
		Результат = Результат + ", КПП " + СтруктураРеквизитов[ПредставленияРеквизитов.КПП];
	КонецЕсли;
	
	Если СтруктураРеквизитов.Свойство(ПредставленияРеквизитов.СчетНомер) И ЗначениеЗаполнено(СтруктураРеквизитов[ПредставленияРеквизитов.СчетНомер]) Тогда
		Результат = Результат + ", счет " + СтруктураРеквизитов[ПредставленияРеквизитов.СчетНомер];
	КонецЕсли;
	
	 Если СтруктураРеквизитов.Свойство(ПредставленияРеквизитов.Банк) И ЗначениеЗаполнено(СтруктураРеквизитов[ПредставленияРеквизитов.Банк]) Тогда
		Результат = Результат + " в " + СтруктураРеквизитов[ПредставленияРеквизитов.Банк];
	КонецЕсли;

	Если СтруктураРеквизитов.Свойство(ПредставленияРеквизитов.БИК) И ЗначениеЗаполнено(СтруктураРеквизитов[ПредставленияРеквизитов.БИК]) Тогда
		Результат = Результат + " БИК " + СтруктураРеквизитов[ПредставленияРеквизитов.БИК];
	КонецЕсли;
	
    Если СтруктураРеквизитов.Свойство(ПредставленияРеквизитов.КоррСчет) И ЗначениеЗаполнено(СтруктураРеквизитов[ПредставленияРеквизитов.КоррСчет]) Тогда
		Результат = Результат + " к/сч. " + СтруктураРеквизитов[ПредставленияРеквизитов.КоррСчет];
	КонецЕсли;
	
	Возврат ?(ЗначениеЗаполнено(Результат), Результат, ТекстПустого);

КонецФункции	

// Функция определяет пол физлица по его отчеству
// Параметр:
// 		ОтчествоРаботника - отчество работника
//
Функция ОпределитьПолПоОтчеству(ОтчествоРаботника) Экспорт
	
	Если Прав(НРЕГ(ОтчествоРаботника), 2) = "ич" Тогда
		Возврат ПредопределенноеЗначение("Перечисление.ПолФизическогоЛица.Мужской");
	ИначеЕсли Прав(НРЕГ(ОтчествоРаботника), 2) = "на" Тогда
		Возврат ПредопределенноеЗначение("Перечисление.ПолФизическогоЛица.Женский");
	ИначеЕсли Прав(НРЕГ(ОтчествоРаботника), 4) = "кызы" 
		ИЛИ Прав(НРЕГ(ОтчествоРаботника), 4) = "гызы" Тогда
		Возврат ПредопределенноеЗначение("Перечисление.ПолФизическогоЛица.Женский");
	ИначеЕсли Прав(НРЕГ(ОтчествоРаботника), 4) = "оглы" 
		ИЛИ Прав(НРЕГ(ОтчествоРаботника), 3) = "улы" 
		ИЛИ Прав(НРЕГ(ОтчествоРаботника), 4) = "уулу" Тогда
		Возврат ПредопределенноеЗначение("Перечисление.ПолФизическогоЛица.Мужской");
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции // ОпределитьПолПоОтчеству()

// Приводит ФИО переданного субъекта к виду "Фамилия Имя Отчество" ("Фамилия И. О.") или "Имя Отчество Фамилия" ("И. О. Фамилия")
// См. также Корреспонденты.ФИОПоОбъекту 
//
// Параметры:
//  Объект			 -  Структура, Строка, СтрокаТаблицыЗначений, СтрокаДереваЗначений, ВыборкаИзРезультатаЗапроса и т.п. - объект,
//						для которого определяется ФИО. Если это структура и Префикс не задан, то
//						она должна содержать ключи Фамилия, Имя, Отчество
//  ИОПередФамилией	 - Булево - Определяет место вывода Имени и Отчества. Если Истина, то "И. О. Фамилия",
//						иначе "Фамилия И. О."
//  Префикс			 - Строка - если префикс задан Фамилия, Имя, Отчество получаются из объекта по имени имени поля
//						с учетом префикса
//  ИОИнициалами	 - Булево - Если Истина, то Имя и Отчество выводятся сокращенно, в виде инициалов "И. О."
// Возвращаемое значение:
//   Приведенное ФИО
//
Функция ФИО(Знач Объект, ИОПередФамилией = Ложь, Знач Префикс = "", ИОИнициалами = Истина, РазделятьПробелом = Ложь) Экспорт
	
	Если Не ЗначениеЗаполнено(Объект) Тогда
		Возврат "";
	КонецЕсли;
	
	Если ТипЗнч(Объект) = Тип("Строка") Тогда
		
		ЧастиФИО = СтрРазделить(Объект, " ", Ложь);
		
		Фамилия		= ?(ЧастиФИО.Количество() > 0, ЧастиФИО[0], "");
		Имя			= ?(ЧастиФИО.Количество() > 1, ЧастиФИО[1], "");
		Отчество	= ?(ЧастиФИО.Количество() > 2, ЧастиФИО[2], "");
		
	Иначе
		
		Если ТипЗнч(Префикс) <> Тип("Строка") Тогда
			Префикс = "";
		КонецЕсли;
		
		Фамилия		= Объект[Префикс + "Фамилия"];
		Имя			= Объект[Префикс + "Имя"];
		Отчество	= Объект[Префикс + "Отчество"];
		
	КонецЕсли;
	
	ЧастиФИО = Новый Массив;
	
	Если ЗначениеЗаполнено(Имя) Тогда
		ЧастиФИО.Добавить(?(ИОИнициалами, ВРег(Лев(Имя,1))+".", Имя));
	КонецЕсли;
	Если ЗначениеЗаполнено(Отчество) Тогда
		ЧастиФИО.Добавить(?(ИОИнициалами, ВРег(Лев(Отчество,1))+".", Отчество));
	КонецЕсли;
	Если ЗначениеЗаполнено(Фамилия) Тогда
		Если ИОПередФамилией Тогда
			ЧастиФИО.Добавить(Фамилия);
		Иначе
			ЧастиФИО.Вставить(0, Фамилия);
		КонецЕсли;
	КонецЕсли;
	
	Если РазделятьПробелом Тогда
		Результат = СтрСоединить(ЧастиФИО, " ");
	Иначе
		Результат = СтрСоединить(ЧастиФИО, Символы.НПП);
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

Функция ЭтоИНН(СтрокаИНН) Экспорт
	
	Возврат ЗначениеЗаполнено(СтрокаИНН)
		И (СтрДлина(СтрокаИНН) = 10 ИЛИ СтрДлина(СтрокаИНН) = 12)
		И СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(СтрокаИНН);
		
КонецФункции

