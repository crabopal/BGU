
#Область СлужебныйПрограммныйИнтерфейс

Функция ПараметрыОтбораСчетаРасчетов(Объект = Неопределено, Знач КЭК = Неопределено, Знач ДопустимыеСчета = Неопределено, Знач ВыбранныйСчет = Неопределено) Экспорт
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Организация",     ПредопределенноеЗначение("Справочник.Организации.ПустаяСсылка"));
	ПараметрыОтбора.Вставить("ИФО",             ПредопределенноеЗначение("Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка"));
	ПараметрыОтбора.Вставить("НаДату",          Дата("00010101"));
	ПараметрыОтбора.Вставить("КЭК",             ПредопределенноеЗначение("Справочник.КОСГУ.ПустаяСсылка"));
	ПараметрыОтбора.Вставить("ДопустимыеСчета", ПредопределенноеЗначение("ПланСчетов.ЕПСБУ.ПустаяСсылка"));
	ПараметрыОтбора.Вставить("ВыбранныйСчет",   ПредопределенноеЗначение("ПланСчетов.ЕПСБУ.ПустаяСсылка"));
	
	Если Объект <> Неопределено Тогда
		ПараметрыОтбора.Организация = Объект.Организация;
		ПараметрыОтбора.ИФО         = Объект.ИФО;
		ПараметрыОтбора.НаДату      = Объект.Дата;
	КонецЕсли;
	Если ЗначениеЗаполнено(КЭК) Тогда
		ПараметрыОтбора.КЭК = КЭК;
	КонецЕсли;
	Если ЗначениеЗаполнено(ДопустимыеСчета) Тогда
		Если СтрНайти(Строка(ДопустимыеСчета), "205.00")
		 ИЛИ СтрНайти(Строка(ДопустимыеСчета), "209.00") Тогда
			// В расчетно-платежных документах кор.счета 205.00 и 209.00 в шапке объединены.
			ПараметрыОтбора.ДопустимыеСчета = "205.00,209.00";
		Иначе
			ПараметрыОтбора.ДопустимыеСчета = ДопустимыеСчета;
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеЗаполнено(ВыбранныйСчет) Тогда
		ПараметрыОтбора.ВыбранныйСчет = ВыбранныйСчет;
	КонецЕсли;
	
	Возврат ПараметрыОтбора;
	
КонецФункции

Процедура РасшифровкаПлатежаСчетРасчетовНачалоВыбора(ПараметрыОтбора, Элемент, ДанныеВыбора, СтандартнаяОбработка) Экспорт
	
	ОграниченияСчетаПоКЭК = Новый Структура;
	ОграниченияСчетаПоКЭК.Вставить("КЭК", ПараметрыОтбора.КЭК);
	ОграниченияСчетаПоКЭК.Вставить("ДопустимыеСчета", ПараметрыОтбора.ДопустимыеСчета);
	
	Параметры = Новый Структура;
	Параметры.Вставить("Организация",   ПараметрыОтбора.Организация);
	Параметры.Вставить("ИФО",           ПараметрыОтбора.ИФО);
	Параметры.Вставить("НаДату",        ПараметрыОтбора.НаДату);
	Параметры.Вставить("ТекущаяСтрока", ПараметрыОтбора.ВыбранныйСчет);
	Параметры.Вставить("ОграниченияСчетаПоКЭК", ОграниченияСчетаПоКЭК);
	Параметры.Вставить("ВыбиратьЗапрещенныеВПроводках", Ложь);
	
	ОткрытьФорму("ПланСчетов.ЕПСБУ.ФормаВыбора", Параметры, Элемент);
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

Процедура РасшифровкаПлатежаСчетРасчетовАвтоПодбор(ПараметрыОтбора, Элемент, Текст, ДанныеВыбора, Ожидание, СтандартнаяОбработка) Экспорт
	
	Если ПустаяСтрока(Текст) Тогда
		Возврат;
	КонецЕсли;
	
	ОграниченияСчетаПоКЭК = Новый Структура;
	ОграниченияСчетаПоКЭК.Вставить("КЭК", ПараметрыОтбора.КЭК);
	ОграниченияСчетаПоКЭК.Вставить("ДопустимыеСчета", ПараметрыОтбора.ДопустимыеСчета);
	
	Параметры = Новый Структура("СтрокаПоиска", Текст);
	Параметры.Вставить("Организация", ПараметрыОтбора.Организация);
	Параметры.Вставить("ИФО", ПараметрыОтбора.ИФО);
	Параметры.Вставить("НаДату", ПараметрыОтбора.НаДату);
	Параметры.Вставить("Отбор", Новый Структура("ЭлементГруппа", Ложь));
	Параметры.Вставить("ОграниченияСчетаПоКЭК", ОграниченияСчетаПоКЭК);
	
	ДанныеВыбора = ПолучитьДанныеВыбора(Тип("ПланСчетовСсылка.ЕПСБУ"), Параметры);
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

