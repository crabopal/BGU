Процедура ЗаполнитьТаблицуОтметокИСписокСотрудников(Данные)
	
	ТаблицаОбъекты = Данные.ДанныеРешения.ТаблицаОбъекты;
	
	ДополнительныеПараметры = Данные.ДополнительныеПараметры;
	
	ТаблицаНастроек = ДополнительныеПараметры.ТаблицаНастроекПоТипуОписи;
	
	СтрокаТаблицыНастроек = ТаблицаНастроек[0];
	
	РасположениеРеквизитов = ПолучитьОписаниеРасположенияРеквизитовОписи(СтрокаТаблицыНастроек);
	
	ДопустимостьОбъединенияСчетов = ОпределитьДопустимостьОбъединенияСчетовДляОписи(РасположениеРеквизитов);
	ДопустимостьОбъединенияМестИнвентаризации = ОпределитьДопустимостьОбъединенияМестИнвентаризацииДляОписи(РасположениеРеквизитов);
	
	ГруппыСтрок = ДополнительныеПараметры.ГруппыСтрок;
	
	ДополнитьТаблицуПризнакамиСчетов(ТаблицаОбъекты, ГруппыСтрок);
	
	ТаблицаОтметок = ПолучитьПустуюТаблицуОтметок();
	
	ОбщийСписокСотрудников = Новый Массив();
	
	ДополнительныеПараметры.Вставить("ТаблицаОтметок",					ТаблицаОтметок);
	ДополнительныеПараметры.Вставить("ОбщийСписокСотрудников",			ОбщийСписокСотрудников);
	ДополнительныеПараметры.Вставить("ОписаниеРеквизитаМОЛ",			Неопределено);
	ДополнительныеПараметры.Вставить("ДопустимостьОбъединенияСчетов",	ДопустимостьОбъединенияСчетов);
	ДополнительныеПараметры.Вставить("ДопустимостьОбъединенияМестИнвентаризации", ДопустимостьОбъединенияМестИнвентаризации);
	
	Если ГруппыСтрок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Для таблицы отметок заранее формируется лишь одна группа строк и далее выбирается лишь одна подгруппа
	ГруппаСтрок = ГруппыСтрок[0];
	
	// Настройки реквизита МОЛ должны быть одинаковыми у всех настроек одного типа описи
	ПерваяСтрокаГруппы = ТаблицаОбъекты[ГруппаСтрок.ПодгруппыСтрок[0].НомераСтрок[0] - 1];
	ПерваяСтрокаТаблицыНастроек = ТаблицаНастроек[ПерваяСтрокаГруппы.НомераСтрокНастроек[0] - 1];
	ОписаниеРеквизитаМОЛ = ДиагностироватьОписаниеРеквизитаОписи(ПерваяСтрокаТаблицыНастроек.ИмяРеквизитаМОЛ);
	
	// Для каждой подгруппы создаем отдельную строку таблицы отметок
	
	МассивыЗначений = Новый Структура();
	МассивыЗначений.Вставить("КодСтрокиПредставление",	Новый Массив());
	МассивыЗначений.Вставить("СчетПредставление",		Новый Массив());
	МассивыЗначений.Вставить("СотрудникПредставление",	Новый Массив());
	МассивыЗначений.Вставить("СотрудникСсылка",			Новый Массив());
	
	МассивыЗначений.Вставить("МестоИнвентаризацииПредставление", Новый Массив());
	
	ПредставленияОбъединенныхПолей = Новый Структура("
		|КодСтрокиПредставление,
		|СчетПредставление,
		|СотрудникПредставление,
		|МестоИнвентаризацииПредставление");
	
	НомерСтроки = 0;
	
	Для Каждого Подгруппа Из ГруппаСтрок.ПодгруппыСтрок Цикл
		НомерСтроки = НомерСтроки + 1;
		
		НомераСтрок = Подгруппа.НомераСтрок;
		
		ПерваяСтрокаПодгруппы = ТаблицаОбъекты[НомераСтрок[0] - 1];
		
		ЗаполнитьПредставленияОбъединенныхПолей(ПредставленияОбъединенныхПолей, ТаблицаОбъекты, Подгруппа, МассивыЗначений, ОписаниеРеквизитаМОЛ);
		
		ПризнакиМасштабаИнвентаризации = ОпределитьПризнакиМасштабаИнвентаризации(ТаблицаОбъекты, Подгруппа);
		
		НоваяСтрока = ТаблицаОтметок.Добавить();
		НоваяСтрока.НомерСтроки = НомерСтроки;
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Подгруппа.ПоляГруппировок, "ДатаИнвентаризации,ДатаНачала,ДатаОкончания");
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ПредставленияОбъединенныхПолей);
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ПризнакиМасштабаИнвентаризации);
		
		ПерваяСтрокаПодгруппы = ТаблицаОбъекты[НомераСтрок[0] - 1];
		
		НоваяСтрока.КомиссияПредставление = ИнвентаризацияКлиентСервер.ПолучитьПредставлениеПолногоНомераКомиссии(
			ПерваяСтрокаПодгруппы.НомерКомиссии,
			ПерваяСтрокаПодгруппы.НомерРабочейКомиссии,
			Истина);
		
		НоваяСтрока.НомераСтрок = НомераСтрок;
		
		Для Каждого Сотрудник Из МассивыЗначений.СотрудникСсылка Цикл
			Если ЗначениеЗаполнено(Сотрудник) И ОбщийСписокСотрудников.Найти(Сотрудник) = Неопределено Тогда
				ОбщийСписокСотрудников.Добавить(Сотрудник);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ДополнительныеПараметры.ТаблицаОтметок			= ТаблицаОтметок;
	ДополнительныеПараметры.ОбщийСписокСотрудников	= ОбщийСписокСотрудников;
	ДополнительныеПараметры.ОписаниеРеквизитаМОЛ	= ОписаниеРеквизитаМОЛ;
	
КонецПроцедуры

Функция ОпределитьПризнакиМасштабаИнвентаризации(ТаблицаОбъекты, Подгруппа)
	
	ПризнакСплошнойИнвентаризации = Ложь;
	ПризнакВыборочнойИнвентаризации = Ложь;
	ПризнакИнойИнвентаризации = Ложь;
	ПримечаниеПредставление = "";
	
	Представления = Новый Массив();
	
	Для Каждого НомерСтроки Из Подгруппа.НомераСтрок Цикл
		СтрокаТаблицыОбъекты = ТаблицаОбъекты[НомерСтроки - 1];
		
		Примечание = НРег(СокрЛП(СтрокаТаблицыОбъекты.Примечание));
		
		Если Не ЗначениеЗаполнено(Примечание) Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрНайти(Примечание, НСтр("ru='сплошная'")) <> 0 Тогда
			ПризнакСплошнойИнвентаризации = Истина;
			
		ИначеЕсли СтрНайти(Примечание, НСтр("ru='выборочная'")) <> 0 Тогда
			ПризнакВыборочнойИнвентаризации = Истина;
			
		Иначе
			ПризнакИнойИнвентаризации = Истина;
		КонецЕсли;
		
		Представления.Добавить(СтрокаТаблицыОбъекты.Примечание);
	КонецЦикла;
	
	Результат = Новый Структура();
	Результат.Вставить("ПризнакСплошнойИнвентаризации",		ПризнакСплошнойИнвентаризации);
	Результат.Вставить("ПризнакВыборочнойИнвентаризации",	ПризнакВыборочнойИнвентаризации);
	Результат.Вставить("ПризнакИнойИнвентаризации", 		ПризнакИнойИнвентаризации);
	Результат.Вставить("ПримечаниеПредставление",			СтрСоединить(Представления, ", "));
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьПредставленияОбъединенныхПолей(ПредставленияОбъединенныхПолей, ТаблицаОбъекты, Подгруппа, МассивыЗначений, ОписаниеРеквизитаМОЛ)
	
	Для Каждого Элемент Из МассивыЗначений Цикл
		Элемент.Значение.Очистить();
	КонецЦикла;
	
	Для Каждого НомерСтроки Из Подгруппа.НомераСтрок Цикл
		СтрокаТаблицыОбъекты = ТаблицаОбъекты[НомерСтроки - 1];
		
		СтрокаТаблицыНастроек = ТаблицаОбъекты[НомерСтроки - 1];
		
		КодСтрокиПредставление = Формат(НомерСтроки, "ЧЦ=3;ЧВН=;ЧГ=");
		
		ДобавитьЕслиПредставлениеУникальное(МассивыЗначений.КодСтрокиПредставление, КодСтрокиПредставление);
	
		СчетПредставление = ПолучитьПредставлениеСчетаДляРешения(СтрокаТаблицыОбъекты).КодСчета;
		
		ДобавитьЕслиПредставлениеУникальное(МассивыЗначений.СчетПредставление, СчетПредставление);
		
		Если Не ОписаниеРеквизитаМОЛ.Отсутствует Тогда
			СотрудникПредставление = Строка(СтрокаТаблицыОбъекты.Сотрудник);
			
			ДобавитьЕслиПредставлениеУникальное(МассивыЗначений.СотрудникПредставление, СотрудникПредставление);
			
			СотрудникСсылка = СтрокаТаблицыОбъекты.Сотрудник;
			
			ДобавитьЕслиПредставлениеУникальное(МассивыЗначений.СотрудникСсылка, СотрудникСсылка);
		КонецЕсли;
		
		ДобавитьЕслиПредставлениеУникальное(МассивыЗначений.МестоИнвентаризацииПредставление, Строка(СтрокаТаблицыОбъекты.МестоИнвентаризации));
	КонецЦикла;
	
	ПредставленияОбъединенныхПолей.КодСтрокиПредставление	= СтрСоединить(МассивыЗначений.КодСтрокиПредставление, ", ");
	ПредставленияОбъединенныхПолей.СчетПредставление		= СтрСоединить(МассивыЗначений.СчетПредставление, ", ");
	ПредставленияОбъединенныхПолей.СотрудникПредставление	= СтрСоединить(МассивыЗначений.СотрудникПредставление, ", ");
	
	ПредставленияОбъединенныхПолей.МестоИнвентаризацииПредставление = ИнвентаризацияКлиентСервер.СократитьСтроку(СтрСоединить(МассивыЗначений.МестоИнвентаризацииПредставление, ", "), 200);
	
КонецПроцедуры

Процедура ДобавитьЕслиПредставлениеУникальное(МассивПриемник, Представление)
	
	Если ЗначениеЗаполнено(Представление) И МассивПриемник.Найти(Представление) = Неопределено Тогда
		МассивПриемник.Добавить(Представление);
	КонецЕсли;
	
КонецПроцедуры

Функция ОпределитьДопустимостьОбъединенияСчетовДляОписи(РасположениеРеквизитов)
	
	Возврат РасположениеРеквизитов.Счет.РасположенВТабличнойЧасти
		Или РасположениеРеквизитов.КФО.РасположенВТабличнойЧасти;
	
КонецФункции

Функция ОпределитьДопустимостьОбъединенияМестИнвентаризацииДляОписи(РасположениеРеквизитов)
	
	Возврат РасположениеРеквизитов.МестоИнвентаризации.РасположенВТабличнойЧасти;
	
КонецФункции

