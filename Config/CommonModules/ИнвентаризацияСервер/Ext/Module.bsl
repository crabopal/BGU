Функция ПолучитьВсеЦМОСотрудникаДляОтбора(МОЛ, Организация = Неопределено) Экспорт
	
	МассивМОЛДляОтбора = Новый Массив();
	
	Если НЕ ЗначениеЗаполнено(МОЛ) Тогда
		Возврат МассивМОЛДляОтбора;
	КонецЕсли;
	
	МассивМОЛДляОтбора.Добавить(МОЛ);
	
	Если ТипЗнч(МОЛ) = Тип("СправочникСсылка.Сотрудники") Тогда
		// Если указан сотрудник, то выбираем также ВСЕ ЦМО этого сотрудника
		
		ЗапросПоиск = Новый Запрос();
		ЗапросПоиск.УстановитьПараметр("Сотрудник", МОЛ);
		
		Если Организация = Неопределено Тогда
			ОтборПоОрганизации = "Истина";
		Иначе
			ОтборПоОрганизации = "Владелец = &Организация";
			ЗапросПоиск.УстановитьПараметр("Организация", Организация);
		КонецЕсли;
		
		ТекстЗапроса = "
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Ссылка
		|ИЗ
		|	Справочник.ЦМО
		|ГДЕ
		|	Сотрудник = &Сотрудник
		|	И &ОтборПоОрганизации";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОтборПоОрганизации", ОтборПоОрганизации);
		
		ЗапросПоиск.Текст = ТекстЗапроса;
		
		Выборка = ЗапросПоиск.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			МассивМОЛДляОтбора.Добавить(Выборка.Ссылка);
		КонецЦикла;
	КонецЕсли;
	
	Возврат МассивМОЛДляОтбора;
	
КонецФункции

Процедура ДополнитьДеревоЗначений(ДеревоПриемник, ДеревоИсточник) Экспорт
	
	Для Каждого СтрокаИсточника Из ДеревоИсточник.Строки Цикл
		
		НоваяСтрокаПриемника = ДеревоПриемник.Строки.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрокаПриемника, СтрокаИсточника);
		
		Если СтрокаИсточника.Строки.Количество() > 0 Тогда
			
			ДополнитьДеревоЗначений(НоваяСтрокаПриемника, СтрокаИсточника);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьКолонкуНомерСтроки(Таблица, РазрядностьЧисла = 6) Экспорт
	
	Таблица.Колонки.Добавить("НомерСтроки", ОбщегоНазначения.ОписаниеТипаЧисло(РазрядностьЧисла, 0, ДопустимыйЗнак.Неотрицательный));
	
	НомерСтроки = 0;
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		
		НомерСтроки = НомерСтроки + 1;
		
		СтрокаТаблицы.НомерСтроки = НомерСтроки;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ОпределитьКоординатыСтрокиДереваЗначений(Дерево, СтрокаДерева) Экспорт
	
	Координаты = Новый Массив();
	
	ИндексыРодителей = Новый Массив();
	
	ТекущийРодитель = СтрокаДерева.Родитель;
	
	Если ТекущийРодитель = Неопределено Тогда
		ИндексСтрокиДерева = Дерево.Строки.Индекс(СтрокаДерева);
	Иначе
		ИндексСтрокиДерева = ТекущийРодитель.Строки.Индекс(СтрокаДерева);
	КонецЕсли;
	
	// Самый последний элемент массива - индекс детальной строки
	Координаты.Добавить(ИндексСтрокиДерева);
	
	Пока ТекущийРодитель <> Неопределено Цикл
		ВерхнийРодитель = ТекущийРодитель.Родитель;
		
		Если ВерхнийРодитель = Неопределено Тогда
			ИндексТекущегоРодителя = Дерево.Строки.Индекс(ТекущийРодитель);
		Иначе
			ИндексТекущегоРодителя = ВерхнийРодитель.Строки.Индекс(ТекущийРодитель);
		КонецЕсли;
		
		// Все остальные элементы массива, кроме самого последнего, - индексы родительских строк-группировок
		Координаты.Вставить(0, ИндексТекущегоРодителя);
		
		ТекущийРодитель = ВерхнийРодитель;
	КонецЦикла;
	
	Возврат Координаты;
	
КонецФункции

Функция ПолучитьИдентификаторСтрокиДереваПоКоординатам(РеквизитФормыДерево, Координаты) Экспорт
	
	КоличествоКоординат = Координаты.Количество();
	
	ТекущийРодитель = РеквизитФормыДерево;
	
	Для Счетчик = 1 По КоличествоКоординат Цикл
		Координата = Координаты[Счетчик - 1];
		
		ЭтоПоследняяКоордината = (Счетчик = КоличествоКоординат);
		
		Если ЭтоПоследняяКоордината Тогда
			СтрокаПоказателя = ТекущийРодитель.ПолучитьЭлементы()[Координата];
			
			Возврат СтрокаПоказателя.ПолучитьИдентификатор();
		Иначе
			ТекущийРодитель = ТекущийРодитель.ПолучитьЭлементы()[Координата];
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

// Возвращаемое значение:
//	Настройки для указанного вида документов	- Структура с ключами:
//		
//		ИмяТабличнойЧасти					- Строка
// 	
//		ИменаКолонокЧисловыхПоказателей		- Строка
//
//		ИмяРеквизитаСчетВШапке				- Строка
//
//		УстанавливатьСчетВТабличнойЧасти	- Булево
//		(при изменении варианта формирования описи)
//
//		ОтдельныйЭлементДляТабличнойЧасти	- Строка
//
//		НеиспользуемыеРеквизиты				- Соответствие Число<->Структура
//		(отдельно для каждого значения ВариантФормированияОписи)
//
//			- РеквизитыШапки			- Массив строк
//
//			- РеквизитыТабличнойЧасти	- Массив строк
//
//			- ЭлементыФормы				- Массив строк
//
Функция ПолучитьНастройкиФормы0504087(ВидДокумента)
	
	Если ВидДокумента = "ИнвентаризацияМЗ" ИЛИ ВидДокумента = Тип("ДокументСсылка.ИнвентаризацияМЗ") Тогда
		Возврат ПолучитьНастройкиФормы0504087_ИнвентаризацияМЗ();
		
	ИначеЕсли ВидДокумента = "ИнвентаризацияОС" ИЛИ ВидДокумента = Тип("ДокументСсылка.ИнвентаризацияОС") Тогда
		Возврат ПолучитьНастройкиФормы0504087_ИнвентаризацияОС();
		
	ИначеЕсли ВидДокумента = "ИнвентаризацияИК" ИЛИ ВидДокумента = Тип("ДокументСсылка.ИнвентаризацияИК") Тогда
		Возврат ПолучитьНастройкиФормы0504087_ИнвентаризацияИК();
		
	КонецЕсли;
	
КонецФункции

Функция ПолучитьНастройкиФормы0504087_ИнвентаризацияМЗ()
	
	//						Показатель				Имя реквизита табличной части
	ИменаКолонок = Новый Структура();
	ИменаКолонок.Вставить("КоличествоФакт",			"КоличествоФакт");
	ИменаКолонок.Вставить("КоличествоУчет",			"КоличествоУчет");
