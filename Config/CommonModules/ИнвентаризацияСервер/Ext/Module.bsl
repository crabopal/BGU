	|	ИзмененияРешений.ИзменениеРешенияПроведен			КАК ИзменениеРешенияПроведен,
	|	
	|	ИзмененияРешений.НомерИзменения						КАК НомерИзменения,
	|	ИзмененияРешений.Аннулирующее						КАК Аннулирующее,
	|	ИзмененияРешений.ПредыдущееИзменениеРешения			КАК ПредыдущееИзменениеРешения,
	|	
	|	ИзмененияРешений.Дата								КАК Дата,
	|	ИзмененияРешений.Номер								КАК Номер
	|ИЗ
	|	СвязьДокументРешение
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИзмененияРешений
	|		ПО	СвязьДокументРешение.Решение = ИзмененияРешений.Решение
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Изменения решения без Решения
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка КАК Документ
	|ИЗ
	|	Документ.ИзменениеРешенияОПроведенииИнвентаризации
	|ГДЕ
	|	Ссылка В (&СписокДокументов)
	|	И Решение = ЗНАЧЕНИЕ(Документ.РешениеОПроведенииИнвентаризации.ПустаяСсылка)
	|;";
	
	Если ПолучитьТабличныеЧастиКомиссии Тогда
		ЗапросПоиск.Текст = ЗапросПоиск.Текст + "	
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Комиссии.Ссылка			КАК Документ,
		|	Комиссии.НомерСтроки	КАК НомерСтроки,
		|	Комиссии.Комиссия		КАК Комиссия,
		|	ЗНАЧЕНИЕ(Перечисление.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.ПустаяСсылка)	КАК ТипИзменения,
		|	ЛОЖЬ					КАК Модифицированность
		|ИЗ
		|	Документ.РешениеОПроведенииИнвентаризации.Комиссии КАК Комиссии
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
		|		(ВЫБРАТЬ
		|			Документ КАК Ссылка
		|		ИЗ
		|			СвязьДокументРешение
		|		ГДЕ
		|			Документ ССЫЛКА Документ.РешениеОПроведенииИнвентаризации
		|			И НЕ Документ В (&ИсключаемыеДокументы)
		|
		|		ОБЪЕДИНИТЬ
		|
		|		ВЫБРАТЬ
		|			Решение КАК Ссылка
		|		ИЗ
		|			СвязьДокументРешение
		|		ГДЕ
		|			НЕ Решение В (&ИсключаемыеДокументы)
		|		) КАК ДокументыРешений
		|		ПО Комиссии.Ссылка = ДокументыРешений.Ссылка
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ИзмененияРешений.ИзменениеРешения	КАК Документ,
		|	Комиссии.НомерСтроки				КАК НомерСтроки,
		|	Комиссии.Комиссия					КАК Комиссия,
		|	ТипИзменения						КАК ТипИзменения,
		|	Модифицированность					КАК Модифицированность
		|ИЗ
		|	ИзмененияРешений
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИзменениеРешенияОПроведенииИнвентаризации.Комиссии КАК Комиссии
		|		ПО	ИзмененияРешений.ИзменениеРешения = Комиссии.Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	Документ,
		|	НомерСтроки
		|;";
	КонецЕсли;
	
	РезультатыЗапроса = ЗапросПоиск.ВыполнитьПакет();
	
	Результат = Новый Структура();
	
	// [2]. Все документы найденных цепочек
	Результат.Вставить("СРешением", РезультатыЗапроса[2].Выгрузить());
	
	// [3]. Изменения решения без Решения
	Результат.Вставить("БезРешения", РезультатыЗапроса[3].Выгрузить().ВыгрузитьКолонку("Документ"));
	
	Если ПолучитьТабличныеЧастиКомиссии	Тогда
		// [4]. Табличные части Комиссии
		ТаблицаКомиссии = РезультатыЗапроса[4].Выгрузить();
	КонецЕсли;
	
	Если ПолучитьТабличныеЧастиКомиссии	Тогда
		Результат.Вставить("ТаблицаКомиссии", ТаблицаКомиссии);
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

Функция ПолучитьСсылкуРешения(ДокументОбъект)
	
	ДокументСсылка = ДокументОбъект.Ссылка;
	
	ЭтоДокументИзмененияРешения = ИнвентаризацияКлиентСервер.ЭтоДокументИзмененияРешения(ДокументСсылка);
	
	Если ЭтоДокументИзмененияРешения Тогда
		Возврат ДокументОбъект.Решение;
	Иначе
		Возврат ДокументСсылка;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьОкружающиеДокументыЦепочки(ДокументОбъект, ДеревоДокументов)
	
	Перем СтрокаРешения, СтрокаПредыдущегоДокумента, СтрокаПоследующегоДокумента, СтрокаПоследнегоДокумента, СтрокаАннулирующегоДокумента;
	
	ДокументСсылка = ДокументОбъект.Ссылка;
	
	ЭтоДокументИзмененияРешения = ИнвентаризацияКлиентСервер.ЭтоДокументИзмененияРешения(ДокументСсылка);
	
	Если ЭтоДокументИзмененияРешения Тогда
		СсылкаОпределенияРешения = ДокументОбъект.Решение;
		
		СтрокаПредыдущегоДокумента = ПолучитьСтрокуДокументаВДереве(ДокументОбъект.ПредыдущееИзменениеРешения, ДеревоДокументов);
	Иначе
		СсылкаОпределенияРешения = ДокументСсылка;
	КонецЕсли;
	
	СтрокаРешения = ПолучитьСтрокуДокументаВДереве(СсылкаОпределенияРешения, ДеревоДокументов);
	
	Если СтрокаРешения <> Неопределено Тогда
		СтрокаАннулирующегоДокумента = ПолучитьСтрокуАннулирующегоДокумента(СтрокаРешения);
	КонецЕсли;
	
	СтрокаТекущегоДокумента = ПолучитьСтрокуДокументаВДереве(ДокументСсылка, ДеревоДокументов);
	
	Если ЗначениеЗаполнено(ДокументСсылка) Тогда
		СтрокаПоследующегоДокумента = ПолучитьСтрокуПоследующегоДокументаВДереве(ДокументСсылка, ДеревоДокументов);
		
		СтрокаПоследнегоДокумента = ПолучитьСтрокуПоследнегоДокументаВДереве(СтрокаТекущегоДокумента);
	КонецЕсли;
	
	ОкружающиеДокументыЦепочки = Новый Структура();
	ОкружающиеДокументыЦепочки.Вставить("Первый",		ПолучитьОписаниеОкружающегоДокумента(СтрокаРешения));
	ОкружающиеДокументыЦепочки.Вставить("Предыдущий",	ПолучитьОписаниеОкружающегоДокумента(СтрокаПредыдущегоДокумента));
	ОкружающиеДокументыЦепочки.Вставить("Следующий",	ПолучитьОписаниеОкружающегоДокумента(СтрокаПоследующегоДокумента));
	ОкружающиеДокументыЦепочки.Вставить("Последний",	ПолучитьОписаниеОкружающегоДокумента(СтрокаПоследнегоДокумента));
	ОкружающиеДокументыЦепочки.Вставить("Аннулирующий", ПолучитьОписаниеОкружающегоДокумента(СтрокаАннулирующегоДокумента));
	
	Возврат ОкружающиеДокументыЦепочки;
	
КонецФункции

Функция ПолучитьОписаниеОкружающегоДокумента(СтрокаДокумента)
	
	ОписаниеДокумента = Новый Структура();
	ОписаниеДокумента.Вставить("ДокументСсылка",	Неопределено);
	ОписаниеДокумента.Вставить("Представление",		НСтр("ru='(отсутствует)'"));
	ОписаниеДокумента.Вставить("НомерИзменения",	0);
	ОписаниеДокумента.Вставить("Номер",				"");
	ОписаниеДокумента.Вставить("Дата",				'00010101');
	
	Если СтрокаДокумента = Неопределено Тогда
		Возврат ОписаниеДокумента;
	КонецЕсли;
	
	ДокументСсылка	= СтрокаДокумента.Документ;
	Дата			= СтрокаДокумента.Дата;
	Номер			= СтрокаДокумента.Номер;
	
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат ОписаниеДокумента;
	КонецЕсли;
	
	ПредставлениеШаблон = НСтр("ru='№%1 от %2'");
	
	Если ЗначениеЗаполнено(Номер) Тогда
		НомерПредставление = СокрЛП(ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка, Номер));
	Иначе
		НомерПредставление = НСтр("ru='—'");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Дата) Тогда
		ДатаПредставление = Формат(Дата, "ДФ=""дд.ММ.гггг""");
	Иначе
		ДатаПредставление = НСтр("ru='—'");
	КонецЕсли;
	
	Представление = СтрШаблон(ПредставлениеШаблон, НомерПредставление, ДатаПредставление);
	
	ОписаниеДокумента.ДокументСсылка	= ДокументСсылка;
	ОписаниеДокумента.Представление		= Представление;
	ОписаниеДокумента.НомерИзменения	= СтрокаДокумента.НомерИзменения;
	ОписаниеДокумента.Номер				= Номер;
	ОписаниеДокумента.Дата				= Дата;
	
	Возврат ОписаниеДокумента;
	
КонецФункции

#КонецОбласти

#Область ДиагностикаОшибокЦепочки

Функция ДиагностироватьОшибкиДереваДокументов(РезультатыПоиска, ГруппироватьПоРешению)
	
	ПроверятьОшибки3 = Ложь;
	ПроверятьОшибки910 = Истина;
	
	ДеревоДокументов	= РезультатыПоиска.ДеревоДокументов;
	ВнеДереваДокументов	= РезультатыПоиска.ВнеДереваДокументов;
	
	КодыОшибок = КодыОшибокДереваДокументов();
	
	ТаблицаСписокОшибок = ПустаяТаблицаСписокОшибокДереваДокументов();
	
	// Порядок проверки определяет порядок вывода ошибок в табличный документ
	// и выбран из эстетических соображений
	
	ДиагностироватьОшибки1(ДеревоДокументов, ТаблицаСписокОшибок, КодыОшибок, ГруппироватьПоРешению);
	ДиагностироватьОшибки4(ДеревоДокументов, ТаблицаСписокОшибок, КодыОшибок, ГруппироватьПоРешению);
	ДиагностироватьОшибки5(ДеревоДокументов, ТаблицаСписокОшибок, КодыОшибок, ГруппироватьПоРешению);
	ДиагностироватьОшибки2(ДеревоДокументов, ТаблицаСписокОшибок, КодыОшибок, ГруппироватьПоРешению);
	Если ПроверятьОшибки3 Тогда
		ДиагностироватьОшибки3(ДеревоДокументов, ТаблицаСписокОшибок, КодыОшибок, ГруппироватьПоРешению);
	КонецЕсли;
	
	Если ПроверятьОшибки910 Тогда
		СсылкиВсехДокументовДерева = ПолучитьСсылкиВсехДокументовДерева(ДеревоДокументов);
		
		ДобавитьКоличествоСтрокТабличныхЧастей(ДеревоДокументов, СсылкиВсехДокументовДерева);
		
		ДиагностироватьОшибки9(ДеревоДокументов, ТаблицаСписокОшибок, КодыОшибок, ГруппироватьПоРешению, СсылкиВсехДокументовДерева);
		ДиагностироватьОшибки10(ДеревоДокументов, ТаблицаСписокОшибок, КодыОшибок, ГруппироватьПоРешению, СсылкиВсехДокументовДерева);
	КонецЕсли;
	
	ДиагностироватьОшибки8(ДеревоДокументов, ВнеДереваДокументов, ТаблицаСписокОшибок, КодыОшибок, ГруппироватьПоРешению);
	
	Возврат ТаблицаСписокОшибок;
	
КонецФункции

Процедура ДиагностироватьОшибки1(ДеревоДокументов, ТаблицаСписокОшибок, КодыОшибок, ГруппироватьПоРешению)
	
	// Код ошибки 1
	// Не заполнен реквизит "Номер изменения"
	
	КодОшибки = 1;
	
	ОписаниеОшибки = КодыОшибок.Получить(КодОшибки);
	
	Расшифровка = Новый Соответствие();
	
	Поиск = Новый Структура();
	Поиск.Вставить("НомерИзменения", 0);
	
	Для Каждого СтрокаРешения Из ДеревоДокументов.Строки Цикл
		
		МассивСсылок = Новый Массив();
		
		МассивСтрок = СтрокаРешения.Строки.НайтиСтроки(Поиск, Истина);
		
		Если МассивСсылок.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого СтрокаДерева Из МассивСтрок Цикл
			МассивСсылок.Добавить(СтрокаДерева.Документ);
		КонецЦикла;
		
		Расшифровка.Вставить(СтрокаРешения.Документ, МассивСсылок);
		
	КонецЦикла;
	
	Если Расшифровка.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ГруппироватьПоРешению Тогда
		УдалитьГруппировкуРасшифровкиПоРешению(Расшифровка);
	КонецЕсли;
	
	НоваяСтрока = ТаблицаСписокОшибок.Добавить();
	НоваяСтрока.КодОшибки = КодОшибки;
	НоваяСтрока.Наименование = ОписаниеОшибки.Наименование;
	НоваяСтрока.Расшифровка = Расшифровка;
	
КонецПроцедуры

Процедура ДиагностироватьОшибки2(ДеревоДокументов, ТаблицаСписокОшибок, КодыОшибок, ГруппироватьПоРешению)
	
	// Код ошибки 2
	// Различные значения фактического уровня документа в дереве и реквизита "Номер изменения"
	
	КодОшибки = 2;
	
	ОписаниеОшибки = КодыОшибок.Получить(КодОшибки);
	
	Расшифровка = Новый Соответствие();
	
	ПустаяТаблицаРасшифровки = ОписаниеОшибки.Расшифровка;
	
	Поиск = Новый Структура();
	
	Для Каждого СтрокаРешения Из ДеревоДокументов.Строки Цикл
		
		ТаблицаРасшифровки = ПустаяТаблицаРасшифровки.СкопироватьКолонки();
		
		Для Уровень = 1 По СтрокаРешения.МаксимальныйУровень Цикл
			
			Поиск.Вставить("Уровень", Уровень);
			
			МассивСтрок = СтрокаРешения.Строки.НайтиСтроки(Поиск, Истина);
			
			Для Каждого СтрокаДерева Из МассивСтрок Цикл
				
				Если СтрокаДерева.Уровень = СтрокаДерева.НомерИзменения Тогда
					Продолжить;
				КонецЕсли;
				
				НоваяСтрока = ТаблицаРасшифровки.Добавить();
				НоваяСтрока.Ссылка			= СтрокаДерева.Документ;
				НоваяСтрока.Уровень			= Уровень;
				НоваяСтрока.НомерИзменения	= СтрокаДерева.НомерИзменения;
				
			КонецЦикла;
			
		КонецЦикла;
		
		Если ТаблицаРасшифровки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Расшифровка.Вставить(СтрокаРешения.Документ, ТаблицаРасшифровки);
		
	КонецЦикла;
	
	Если Расшифровка.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ГруппироватьПоРешению Тогда
		УдалитьГруппировкуРасшифровкиПоРешению(Расшифровка);
	КонецЕсли;
	
	НоваяСтрока = ТаблицаСписокОшибок.Добавить();
	НоваяСтрока.КодОшибки = КодОшибки;
	НоваяСтрока.Наименование = ОписаниеОшибки.Наименование;
	НоваяСтрока.Расшифровка = Расшифровка;
	
КонецПроцедуры

Процедура ДиагностироватьОшибки3(ДеревоДокументов, ТаблицаСписокОшибок, КодыОшибок, ГруппироватьПоРешению)
	
	// Код ошибки 3
	// Несколько документов с одинаковым фактическим порядковым номером изменений	
	
	КодОшибки = 3;
	
	ДиагностироватьОшибки34Служебная(ДеревоДокументов, ТаблицаСписокОшибок, КодыОшибок, КодОшибки, ГруппироватьПоРешению);
	
КонецПроцедуры

Процедура ДиагностироватьОшибки4(ДеревоДокументов, ТаблицаСписокОшибок, КодыОшибок, ГруппироватьПоРешению)
	
	// Код ошибки 4
	// Несколько документов с одинаковым значением реквизита "Номер изменения"
	
	КодОшибки = 4;
	
	ДиагностироватьОшибки34Служебная(ДеревоДокументов, ТаблицаСписокОшибок, КодыОшибок, КодОшибки, ГруппироватьПоРешению);
	
КонецПроцедуры

Процедура ДиагностироватьОшибки34Служебная(ДеревоДокументов, ТаблицаСписокОшибок, КодыОшибок, КодОшибки, ГруппироватьПоРешению)
	
	Если КодОшибки = 3 Тогда
		ИмяПоля = "Уровень";
	ИначеЕсли КодОшибки = 4 Тогда
		ИмяПоля = "НомерИзменения";
	Иначе
		Возврат;
	КонецЕсли;
	
	ОписаниеОшибки = КодыОшибок.Получить(КодОшибки);
	
	Расшифровка = Новый Соответствие();
	
	ПустаяТаблицаРасшифровки = ОписаниеОшибки.Расшифровка;
	
	ПоискРасшифровки = Новый Структура("Количество", 1);
	
	Для Каждого СтрокаРешения Из ДеревоДокументов.Строки Цикл
		
		ТаблицаРасшифровки = ПустаяТаблицаРасшифровки.СкопироватьКолонки();
		
		НайтиСтрокиСОдинаковымиЗначениямиПоля(СтрокаРешения, ТаблицаРасшифровки, ИмяПоля);
		
		МассивСтрокРасшифровки = ТаблицаРасшифровки.НайтиСтроки(ПоискРасшифровки);
		
		Для Каждого СтрокаРасшифровки Из МассивСтрокРасшифровки Цикл
			ТаблицаРасшифровки.Удалить(СтрокаРасшифровки);
		КонецЦикла;
		
		Если ТаблицаРасшифровки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Расшифровка.Вставить(СтрокаРешения.Документ, ТаблицаРасшифровки);
		
	КонецЦикла;
	
	Если Расшифровка.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ГруппироватьПоРешению Тогда
		УдалитьГруппировкуРасшифровкиПоРешению(Расшифровка);
	КонецЕсли;
	
	НоваяСтрока = ТаблицаСписокОшибок.Добавить();
	НоваяСтрока.КодОшибки = КодОшибки;
	НоваяСтрока.Наименование = ОписаниеОшибки.Наименование;
	НоваяСтрока.Расшифровка = Расшифровка;
	
КонецПроцедуры

Процедура ДиагностироватьОшибки5(ДеревоДокументов, ТаблицаСписокОшибок, КодыОшибок, ГруппироватьПоРешению)
	
	// Код ошибки 5
	// Выполнено изменение после аннулирования
	
	КодОшибки = 5;
	
	ОписаниеОшибки = КодыОшибок.Получить(КодОшибки);
	
	Расшифровка = Новый Соответствие();
	
	Поиск = Новый Структура("Аннулирующее", Истина);
	
	МассивСтрок = ДеревоДокументов.Строки.НайтиСтроки(Поиск, Истина);
	
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат;
	ИначеЕсли МассивСтрок.Количество() = 1 И МассивСтрок[0].ЭтоКонечныйДокумент Тогда
		Возврат;
	КонецЕсли;
	
	// Соберем все документы, являющиеся дочерними для аннулирующих Изменений
	
	Для Каждого СтрокаДерева Из МассивСтрок Цикл
		СтрокаРешения = ПолучитьСтрокуПервоначальногоДокумента(СтрокаДерева.Документ, ДеревоДокументов);
		
		РешениеСсылка = СтрокаРешения.Документ;
		
		МассивСсылок = Расшифровка.Получить(РешениеСсылка);
		
		Если МассивСсылок = Неопределено Тогда
			МассивСсылок = Новый Массив();
		КонецЕсли;
		
		ДобавитьСсылкиДочернихДокументов(СтрокаДерева, МассивСсылок);
		
		Если МассивСсылок.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Расшифровка.Вставить(РешениеСсылка, МассивСсылок);
	КонецЦикла;
	
	Если Расшифровка.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ГруппироватьПоРешению Тогда
		УдалитьГруппировкуРасшифровкиПоРешению(Расшифровка);
	КонецЕсли;
	
	НоваяСтрока = ТаблицаСписокОшибок.Добавить();
	НоваяСтрока.КодОшибки = КодОшибки;
	НоваяСтрока.Наименование = ОписаниеОшибки.Наименование;
	НоваяСтрока.Расшифровка = Расшифровка;
	
КонецПроцедуры

Процедура ДиагностироватьОшибки8(ДеревоДокументов, ВнеДереваДокументов, ТаблицаСписокОшибок, КодыОшибок, ГруппироватьПоРешению)
	
	// Код ошибки 8
	// Обнаружены документы с некорректно заполненными реквизитами связи, которые не позволяют включить эти документы в дерево документов
	
	КодОшибки = 8;
	
	ОписаниеОшибки = КодыОшибок.Получить(КодОшибки);
	
	Если ВнеДереваДокументов.Количество() = 0 Тогда
