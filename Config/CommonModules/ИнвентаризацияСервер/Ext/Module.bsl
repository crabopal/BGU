	КонецЕсли;
	
	Расшифровка = Новый Соответствие();

	Для Каждого СтрокаТаблицы Из ВнеДереваДокументов Цикл
		РешениеСсылка = СтрокаТаблицы.Решение;
		
		МассивСсылок = Расшифровка.Получить(РешениеСсылка);
		
		Если МассивСсылок = Неопределено Тогда
			МассивСсылок = Новый Массив();
		КонецЕсли;
		
		МассивСсылок.Добавить(СтрокаТаблицы.ИзменениеРешения);
		
		Расшифровка.Вставить(РешениеСсылка, МассивСсылок);
	КонецЦикла;
	
	Если НЕ ГруппироватьПоРешению Тогда
		УдалитьГруппировкуРасшифровкиПоРешению(Расшифровка);
	КонецЕсли;
	
	НоваяСтрока = ТаблицаСписокОшибок.Добавить();
	НоваяСтрока.КодОшибки = КодОшибки;
	НоваяСтрока.Наименование = ОписаниеОшибки.Наименование;
	НоваяСтрока.Расшифровка = Расшифровка;
	
КонецПроцедуры

Процедура ДиагностироватьОшибки9(ДеревоДокументов, ТаблицаСписокОшибок, КодыОшибок, ГруппироватьПоРешению, СсылкиВсехДокументовДерева)
	
	// Код ошибки 9
	// Количество строк табличной части "Объекты инвентаризации" меньше минимального допустимого
	
	КодОшибки = 9;
	
	ДиагностироватьОшибки910Служебная(ДеревоДокументов, ТаблицаСписокОшибок, КодыОшибок, КодОшибки, ГруппироватьПоРешению, СсылкиВсехДокументовДерева)
	
КонецПроцедуры

Процедура ДиагностироватьОшибки10(ДеревоДокументов, ТаблицаСписокОшибок, КодыОшибок, ГруппироватьПоРешению, СсылкиВсехДокументовДерева)
	
	// Код ошибки 10
	// Количество строк табличной части "Инвентаризационные комиссии" меньше минимального допустимого
	
	КодОшибки = 10;
	
	ДиагностироватьОшибки910Служебная(ДеревоДокументов, ТаблицаСписокОшибок, КодыОшибок, КодОшибки, ГруппироватьПоРешению, СсылкиВсехДокументовДерева)
	
КонецПроцедуры

Процедура ДиагностироватьОшибки910Служебная(ДеревоДокументов, ТаблицаСписокОшибок, КодыОшибок, КодОшибки, ГруппироватьПоРешению, СсылкиВсехДокументовДерева)
	
	Если КодОшибки = 9 Тогда
		ИмяПоля = "КоличествоСтрокТЧОбъекты";
		
	ИначеЕсли КодОшибки = 10 Тогда
		ИмяПоля = "КоличествоСтрокТЧКомиссии";
		
	Иначе
		Возврат;
	КонецЕсли;
	
	ИменаПолей = "КоличествоСтрокТЧОбъекты,КоличествоСтрокТЧКомиссии";
	
	ОписаниеОшибки = КодыОшибок.Получить(КодОшибки);
	
	Расшифровка = Новый Соответствие();
	
	ПустаяТаблицаРасшифровки = ОписаниеОшибки.Расшифровка;
	
	Поиск = Новый Структура();
	
	Для Каждого ДокументСсылка Из СсылкиВсехДокументовДерева Цикл
		СтрокаРешения = ПолучитьСтрокуПервоначальногоДокумента(ДокументСсылка, ДеревоДокументов);
		
		РешениеСсылка = СтрокаРешения.Документ;
		
		ТаблицаРасшифровки = Расшифровка.Получить(РешениеСсылка);
		
		Если ТаблицаРасшифровки = Неопределено Тогда
			ТаблицаРасшифровки = ПустаяТаблицаРасшифровки.СкопироватьКолонки();
		КонецЕсли;
		
		СтрокаДокумента = ПолучитьСтрокуДокументаВДереве(ДокументСсылка, ДеревоДокументов);
		
		Если СтрокаДокумента = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		МаксимальныеЗначенияПолей = ПолучитьМаксимальныеЗначенияПолейВВосходящейЦепочке(СтрокаДокумента, ИмяПоля);
		
		КоличествоСтрокФактическое			= СтрокаДокумента[ИмяПоля];
		КоличествоСтрокМинимальноДопустимое	= МаксимальныеЗначенияПолей[ИмяПоля];
		
		Если КоличествоСтрокФактическое >= КоличествоСтрокМинимальноДопустимое Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаРасшифровки.Добавить();
		НоваяСтрока.Ссылка								= ДокументСсылка;
		НоваяСтрока.КоличествоСтрокФактическое			= КоличествоСтрокФактическое;
		НоваяСтрока.КоличествоСтрокМинимальноДопустимое	= КоличествоСтрокМинимальноДопустимое;
		
		Расшифровка.Вставить(РешениеСсылка, ТаблицаРасшифровки);
	КонецЦикла;
	
	Если Расшифровка.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ГруппироватьПоРешению Тогда
		УдалитьГруппировкуРасшифровкиПоРешению(Расшифровка);
	КонецЕсли;
	
	НоваяСтрока = ТаблицаСписокОшибок.Добавить();
	НоваяСтрока.КодОшибки = КодОшибки;
	НоваяСтрока.Наименование = ОписаниеОшибки.Наименование;
	НоваяСтрока.Расшифровка = Расшифровка;
	
КонецПроцедуры

Процедура НайтиСтрокиСОдинаковымиЗначениямиПоля(СтрокаДерева, ТаблицаРасшифровки, ИмяПоля)
	
	ЗначениеПоля = СтрокаДерева[ИмяПоля];
	
	// Нулевые значения неинформативны в данной проверке, поэтому пропускаются
	Если ЗначениеПоля > 0 Тогда
		Поиск = Новый Структура(ИмяПоля, ЗначениеПоля);
		
		МассивСтрок = ТаблицаРасшифровки.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() = 0 Тогда
			СтрокаРасшифровки = ТаблицаРасшифровки.Добавить();
			СтрокаРасшифровки[ИмяПоля] = ЗначениеПоля;
		Иначе
			СтрокаРасшифровки = МассивСтрок[0];
		КонецЕсли;
		
		СтрокаРасшифровки.МассивСсылок.Добавить(СтрокаДерева.Документ);
		СтрокаРасшифровки.Количество = СтрокаРасшифровки.Количество + 1;
	КонецЕсли;
	
	Для Каждого ДочерняяСтрока Из СтрокаДерева.Строки Цикл
		НайтиСтрокиСОдинаковымиЗначениямиПоля(ДочерняяСтрока, ТаблицаРасшифровки, ИмяПоля);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьСсылкиДочернихДокументов(СтрокаДерева, МассивСсылок)
	
	Если СтрокаДерева.ЭтоКонечныйДокумент Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ДочерняяСтрока Из СтрокаДерева.Строки Цикл
		Документ = ДочерняяСтрока.Документ;
		
		Если МассивСсылок.Найти(Документ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		МассивСсылок.Добавить(Документ);
		
		ДобавитьСсылкиДочернихДокументов(ДочерняяСтрока, МассивСсылок);
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьГруппировкуРасшифровкиПоРешению(Расшифровка)
	
	Перем НоваяКоллекция;
	
	Для Каждого Элемент Из Расшифровка Цикл
		
		Значение = Элемент.Значение;
		
		Если ТипЗнч(Значение) = Тип("Массив") Тогда
			Если НоваяКоллекция = Неопределено Тогда
				НоваяКоллекция = Новый Массив();
			КонецЕсли;
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(НоваяКоллекция, Значение);
			
		ИначеЕсли ТипЗнч(Значение) = Тип("ТаблицаЗначений") Тогда
			Если НоваяКоллекция = Неопределено Тогда
				НоваяКоллекция = Значение.СкопироватьКолонки();
			КонецЕсли;
			ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(Значение, НоваяКоллекция);
			
		Иначе
			Продолжить;
		КонецЕсли;
		
	КонецЦикла;
	
	Расшифровка = НоваяКоллекция;
	
КонецПроцедуры

Процедура ДобавитьКоличествоСтрокТабличныхЧастей(ДеревоДокументов, СсылкиВсехДокументовДерева)
	
	ТипКоличествоСтрок = ОбщегоНазначения.ОписаниеТипаЧисло(5,0,ДопустимыйЗнак.Неотрицательный);
	
	ДеревоДокументов.Колонки.Добавить("КоличествоСтрокТЧОбъекты",	ТипКоличествоСтрок);
	ДеревоДокументов.Колонки.Добавить("КоличествоСтрокТЧКомиссии",	ТипКоличествоСтрок);
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивСсылок", СсылкиВсехДокументовДерева);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Количество строк в табличных частях документов
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Документ							КАК Документ,
	|	СУММА(КоличествоСтрокТЧОбъекты)		КАК КоличествоСтрокТЧОбъекты,
	|	СУММА(КоличествоСтрокТЧКомиссии)	КАК КоличествоСтрокТЧКомиссии
	|ИЗ
	|	(ВЫБРАТЬ
	|		Док.Ссылка									КАК Документ,
	|		ЕСТЬNULL(КОЛИЧЕСТВО(ТЧОбъекты.Ссылка), 0)	КАК КоличествоСтрокТЧОбъекты,
	|		0											КАК КоличествоСтрокТЧКомиссии
	|	ИЗ
	|		Документ.РешениеОПроведенииИнвентаризации КАК Док
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РешениеОПроведенииИнвентаризации.Объекты КАК ТЧОбъекты
	|			ПО	Док.Ссылка = ТЧОбъекты.Ссылка
	|	ГДЕ
	|		Док.Ссылка В(&МассивСсылок)
	|	СГРУППИРОВАТЬ ПО
	|		Док.Ссылка
	|		
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		Док.Ссылка									КАК Документ,
	|		0											КАК КоличествоСтрокТЧОбъекты,
	|		ЕСТЬNULL(КОЛИЧЕСТВО(ТЧКомиссии.Ссылка), 0)	КАК КоличествоСтрокТЧКомиссии
	|	ИЗ
	|		Документ.РешениеОПроведенииИнвентаризации КАК Док
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РешениеОПроведенииИнвентаризации.Комиссии КАК ТЧКомиссии
	|			ПО	Док.Ссылка = ТЧКомиссии.Ссылка
	|	ГДЕ
	|		Док.Ссылка В(&МассивСсылок)
	|	СГРУППИРОВАТЬ ПО
	|		Док.Ссылка
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		Док.Ссылка									КАК Документ,
	|		ЕСТЬNULL(КОЛИЧЕСТВО(ТЧОбъекты.Ссылка), 0)	КАК КоличествоСтрокТЧОбъекты,
	|		0											КАК КоличествоСтрокТЧКомиссии
	|	ИЗ
	|		Документ.ИзменениеРешенияОПроведенииИнвентаризации КАК Док
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИзменениеРешенияОПроведенииИнвентаризации.Объекты КАК ТЧОбъекты
	|			ПО	Док.Ссылка = ТЧОбъекты.Ссылка
	|	ГДЕ
	|		Док.Ссылка В(&МассивСсылок)
	|	СГРУППИРОВАТЬ ПО
	|		Док.Ссылка
	|			
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		Док.Ссылка									КАК Документ,
	|		0											КАК КоличествоСтрокТЧОбъекты,
	|		ЕСТЬNULL(КОЛИЧЕСТВО(ТЧКомиссии.Ссылка), 0)	КАК КоличествоСтрокТЧКомиссии
	|	ИЗ
	|		Документ.ИзменениеРешенияОПроведенииИнвентаризации КАК Док
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ИзменениеРешенияОПроведенииИнвентаризации.Комиссии КАК ТЧКомиссии
	|			ПО	Док.Ссылка = ТЧКомиссии.Ссылка
	|	ГДЕ
	|		Док.Ссылка В(&МассивСсылок)
	|	СГРУППИРОВАТЬ ПО
	|		Док.Ссылка
	|	) КАК ВТ
	|СГРУППИРОВАТЬ ПО
	|	Документ";
	
	ТаблицаСведенияДокументов = ЗапросПоиск.Выполнить().Выгрузить();
	
	Поиск = Новый Структура();
	
	Для Каждого ДокументСсылка Из СсылкиВсехДокументовДерева Цикл
		Поиск.Вставить("Документ", ДокументСсылка);
		
		МассивСтрокСведений = ТаблицаСведенияДокументов.НайтиСтроки(Поиск);
		
		Если МассивСтрокСведений.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СведенияДокумента = МассивСтрокСведений[0];
		
		СтрокаДокумента = ПолучитьСтрокуДокументаВДереве(ДокументСсылка, ДеревоДокументов);
		
		Если СтрокаДокумента = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СтрокаДокумента, СведенияДокумента, "КоличествоСтрокТЧОбъекты,КоличествоСтрокТЧКомиссии");
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьМаксимальныеЗначенияПолейВВосходящейЦепочке(СтрокаДерева, ИменаПолей)
	
	МассивИменПолей = СтрРазделить(ИменаПолей, ", ", Ложь);
	
	Результат = Новый Структура();
	
	Для Каждого ИмяПоля Из МассивИменПолей Цикл
		Результат.Вставить(ИмяПоля, 0);
	КонецЦикла;
	
	Поиск = Новый Структура();
	
	СтрокаРодителя = СтрокаДерева.Родитель;
	
	Пока СтрокаРодителя <> Неопределено Цикл
		Для Каждого ИмяПоля Из МассивИменПолей Цикл
			ЗначениеПоля = СтрокаРодителя[ИмяПоля];
			
			Если Результат[ИмяПоля] < ЗначениеПоля Тогда
				Результат[ИмяПоля] = ЗначениеПоля;
			КонецЕсли;
		КонецЦикла;
		
		СтрокаРодителя = СтрокаРодителя.Родитель;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСсылкиВсехДокументовДерева(ДеревоДокументов)
	
	МассивСсылок = Новый Массив();
	
	Для Каждого СтрокаРешения Из ДеревоДокументов.Строки Цикл
		МассивСсылок.Добавить(СтрокаРешения.Документ);
		
		ДобавитьСсылкиДочернихДокументов(СтрокаРешения, МассивСсылок);
	КонецЦикла;
	
	Возврат МассивСсылок;
	
КонецФункции

#КонецОбласти

#Область ТабДокОписаниеОшибок

Процедура ВывестиТаблицуОшибок(Коллекция, ТабДокумент, Области, КодОшибки)
	
	Перем ПоляОшибкаДубли;
	
	ОшибкаПростойСписокДокументов = (
		КодОшибки = 1
		ИЛИ КодОшибки = 5
		ИЛИ КодОшибки = 6
		ИЛИ КодОшибки = 7
		ИЛИ КодОшибки = 8);
	
	ОшибкаРазличныеУровни = (КодОшибки = 2);
	
	ОшибкаДубли = (
		КодОшибки = 3
		ИЛИ КодОшибки = 4);
		
	Если ОшибкаДубли Тогда
		ПоляОшибкаДубли = Новый Соответствие();
		ПоляОшибкаДубли.Вставить(3, Новый Структура("Имя,Представление", "Уровень", НСтр("ru='Фактический уровень'")));
		ПоляОшибкаДубли.Вставить(4, Новый Структура("Имя,Представление", "НомерИзменения", НСтр("ru='Номер изменения'")));
	КонецЕсли;
	
	Ошибка910 = (
		КодОшибки = 9
		ИЛИ КодОшибки = 10);
	
	//
	// Шапка таблицы
	//
	Если ОшибкаПростойСписокДокументов Тогда
		ОбластьШапка = Области.ШапкаПростойСписокДокументов;
		
	ИначеЕсли ОшибкаРазличныеУровни Тогда
		ОбластьШапка = Области.ШапкаРазличныеУровни;
		
	ИначеЕсли ОшибкаДубли Тогда
		ОбластьШапка = Области.ШапкаДублиДокументов;
		
		ОписаниеПоля = ПоляОшибкаДубли.Получить(КодОшибки);
		
		ПредставлениеПоля = ОписаниеПоля.Представление;
		
		ЗначенияПараметров = Новый Структура("ПредставлениеПоля", ПредставлениеПоля);
		
		ОбластьШапка.Параметры.Заполнить(ЗначенияПараметров);
		
	ИначеЕсли Ошибка910 Тогда
		ОбластьШапка = Области.ШапкаОшибки910;
		
	Иначе
		Возврат;
	КонецЕсли;
	
	ТабДокумент.Вывести(ОбластьШапка);
	
	//
	// Строки таблицы
	//
	НПП = 0;
	
	ЗначенияПараметров = Новый Структура();
	
	Для Каждого Элемент Из Коллекция Цикл
		
		НПП = НПП + 1;
		
		ЗначенияПараметров.Вставить("НПП", НПП);
		
		Если ОшибкаПростойСписокДокументов Тогда
			ОбластьСтрока = Области.СтрокаПростойСписокДокументов;
			
			ЗначенияПараметров.Вставить("Ссылка", Элемент);
			
			ОбластьСтрока.Параметры.Заполнить(ЗначенияПараметров);
			
		ИначеЕсли ОшибкаРазличныеУровни Тогда
			ОбластьСтрока = Области.СтрокаРазличныеУровни;
			
			ЗначенияПараметров.Вставить("Ссылка", Элемент.Ссылка);
			ЗначенияПараметров.Вставить("Уровень", Элемент.Уровень);
			ЗначенияПараметров.Вставить("НомерИзменения", Элемент.НомерИзменения);
			
			ОбластьСтрока.Параметры.Заполнить(ЗначенияПараметров);
			
		ИначеЕсли ОшибкаДубли Тогда
			ОбластьСтрока = Области.СтрокаДублиДокументов;
			
			ОписаниеПоля = ПоляОшибкаДубли.Получить(КодОшибки);
			
			ИмяПоля = ОписаниеПоля.Имя;
			
			ЗначенияПараметров.Вставить("ЗначениеПоля", Элемент[ИмяПоля]);
			ЗначенияПараметров.Вставить("КоличествоДокументов", Элемент.Количество);
			
			ОбластьСтрока.Параметры.Заполнить(ЗначенияПараметров);
			
		ИначеЕсли Ошибка910 Тогда
			ОбластьСтрока = Области.СтрокаОшибки910;
			
			ЗначенияПараметров.Вставить("Ссылка",	Элемент.Ссылка);
			ЗначенияПараметров.Вставить("Факт",		Элемент.КоличествоСтрокФактическое);
			ЗначенияПараметров.Вставить("Минимум",	Элемент.КоличествоСтрокМинимальноДопустимое);
			
			ОбластьСтрока.Параметры.Заполнить(ЗначенияПараметров);
		КонецЕсли;
		
		ТабДокумент.Вывести(ОбластьСтрока);
		
		Если ОшибкаДубли Тогда
			ТабДокумент.НачатьГруппуСтрок(, Ложь);
			
			ВывестиТаблицуОшибок(Элемент.МассивСсылок, ТабДокумент, Области, 1);
			
			ТабДокумент.ЗакончитьГруппуСтрок();
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область НастройкаФорм

Функция ПолучитьКоличествоСтрокПредыдущихДокументов(ДокументОбъект)
	
	Перем РешениеСсылка, ИзменениеРешенияСсылка;
	
	Если ТипЗнч(ДокументОбъект.Ссылка) = Тип("ДокументСсылка.РешениеОПроведенииИнвентаризации") Тогда
		РешениеСсылка = ДокументОбъект.Ссылка;
		
	ИначеЕсли ТипЗнч(ДокументОбъект.Ссылка) = Тип("ДокументСсылка.ИзменениеРешенияОПроведенииИнвентаризации") Тогда
		РешениеСсылка = ДокументОбъект.Решение;
		ИзменениеРешенияСсылка = ДокументОбъект.ПредыдущееИзменениеРешения;
		
	КонецЕсли;
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("РешениеСсылка",				РешениеСсылка);
	ЗапросПоиск.УстановитьПараметр("ИзменениеРешенияСсылка",	ИзменениеРешенияСсылка);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Количество строк табличной части Объекты документа Решения
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(КОЛИЧЕСТВО(*), 0)	КАК КоличествоСтрок
	|ИЗ
	|	Документ.РешениеОПроведенииИнвентаризации.Объекты
	|ГДЕ
	|	Ссылка = &РешениеСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Количество строк табличной части Объекты документа Изменение решения
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(КОЛИЧЕСТВО(*), 0)	КАК КоличествоСтрок
	|ИЗ
	|	Документ.ИзменениеРешенияОПроведенииИнвентаризации.Объекты
	|ГДЕ
	|	Ссылка = &ИзменениеРешенияСсылка
	|;";
	
	РезультатыЗапроса = ЗапросПоиск.ВыполнитьПакет();
	
	Таблица0 = РезультатыЗапроса[0].Выгрузить();
	Таблица1 = РезультатыЗапроса[1].Выгрузить();
	
	Результат = Новый Структура();
	Результат.Вставить("Решение", Таблица0[0].КоличествоСтрок);
	Результат.Вставить("ИзменениеРешения", Таблица1[0].КоличествоСтрок);
	
	Возврат Результат;
	
КонецФункции

Процедура ДобавитьРеквизитыКолонокТаблицыНастроекЗаполненияОписейПоРешению(Форма, ИмяТаблицыФормы, ТаблицаНастроек)
	
	ТаблицаФормы = Форма[ИмяТаблицыФормы];
	
	Если ТаблицаФормы.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьРеквизитыКолонокТаблицыФормы(Форма, ИмяТаблицыФормы, ТаблицаНастроек);
	
	ТаблицаКодовСчетов = ТаблицаНастроек[0].ТаблицаКодовСчетов;
	
	ДобавитьРеквизитыКолонокТаблицыФормы(Форма, ИмяТаблицыФормы + ".ТаблицаКодовСчетов", ТаблицаКодовСчетов);
	
КонецПроцедуры

Процедура ДобавитьРеквизитыКолонокТаблицыФормы(Форма, ИмяРеквизитаТаблицыФормы, ТаблицаОбразец)
	
	НеподдерживаемыеТипы = Новый Массив();
	НеподдерживаемыеТипы.Добавить(Тип("Тип"));
	НеподдерживаемыеТипы.Добавить(Тип("Массив"));
	НеподдерживаемыеТипы.Добавить(Тип("Структура"));
	НеподдерживаемыеТипы.Добавить(Тип("Соответствие"));
	НеподдерживаемыеТипы.Добавить(Тип("ФиксированныйМассив"));
	НеподдерживаемыеТипы.Добавить(Тип("ФиксированнаяСтруктура"));
	НеподдерживаемыеТипы.Добавить(Тип("ФиксированноеСоответствие"));
	
	ДобавляемыеРеквизиты = Новый Массив();
	
	ВычитаемыеТипы = Новый Массив();
	
	Для Каждого Колонка Из ТаблицаОбразец.Колонки Цикл
		ВычитаемыеТипы.Очистить();
		
		Для Каждого ТекущийТип Из Колонка.ТипЗначения.Типы() Цикл
			Если НеподдерживаемыеТипы.Найти(ТекущийТип) <> Неопределено Тогда
				ВычитаемыеТипы.Добавить(ТекущийТип);
			КонецЕсли;
		КонецЦикла;
		
		ОписаниеТиповРеквизита = Новый ОписаниеТипов(Колонка.ТипЗначения,, ВычитаемыеТипы);
		
		НовыйРеквизитФормы = Новый РеквизитФормы(
			Колонка.Имя,
			ОписаниеТиповРеквизита,
			ИмяРеквизитаТаблицыФормы);
			
		ДобавляемыеРеквизиты.Добавить(НовыйРеквизитФормы);
	КонецЦикла;
	
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
КонецПроцедуры

#КонецОбласти

#Область ДеревоРабочихКомиссийДокумента

Функция ЭтоДокументИзмененияРешения(ДокументОбъект)
	
	Возврат (ТипЗнч(ДокументОбъект.Ссылка) = Тип("ДокументСсылка.ИзменениеРешенияОПроведенииИнвентаризации"));
	
КонецФункции

Процедура ЗаполнитьПредставленияКомиссийТабличнойЧасти(Форма, ТаблицаПредставлений)
	
	ДокументОбъект = Форма.Объект;
	
	ТабличнаяЧастьКомиссии = ДокументОбъект.Комиссии;
	
	ЭтоДокументИзмененияРешения = ЭтоДокументИзмененияРешения(ДокументОбъект);
	
	Поиск = Новый Структура();
	
	Для Каждого СтрокаТаблицы Из ДокументОбъект.Комиссии Цикл
		
		// Актуальная комиссия
		
		Поиск.Вставить("Комиссия", СтрокаТаблицы.Комиссия);
		
		МассивСтрок = ТаблицаПредставлений.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() > 0 Тогда
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, МассивСтрок[0], "ПредставлениеРабочихКомиссий,ПредставлениеАктов");
		КонецЕсли;
		
		// Комиссия ДоИзменения
		
		Если ЭтоДокументИзмененияРешения Тогда
			Поиск.Вставить("Комиссия", СтрокаТаблицы.КомиссияДоИзменения);
			
			МассивСтрок = ТаблицаПредставлений.НайтиСтроки(Поиск);
			
			Если МассивСтрок.Количество() > 0 Тогда
				СтрокаПредставлений = МассивСтрок[0];
				
				ЗначенияПараметров = Новый Структура();
				ЗначенияПараметров.Вставить("ПредставлениеРабочихКомиссийДоИзменения",	СтрокаПредставлений.ПредставлениеРабочихКомиссий);
				ЗначенияПараметров.Вставить("ПредставлениеАктовДоИзменения",			СтрокаПредставлений.ПредставлениеАктов);
				
				ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ЗначенияПараметров);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьТабличныеДокументыПодразделовРаздела2(Форма)
	
	Перем ПредыдущийДокумент;
	
	ТабличныеДокументы = Новый Массив();
	
	ДокументОбъект = Форма.Объект;
	
	Если ИнвентаризацияКлиентСервер.ЭтоДокументИзмененияРешения(ДокументОбъект.Ссылка) Тогда
		ПредыдущийДокумент = ?(ЗначениеЗаполнено(ДокументОбъект.ПредыдущееИзменениеРешения),
			ДокументОбъект.ПредыдущееИзменениеРешения,
			ДокументОбъект.Решение);
	КонецЕсли;

	СписокДокументов = Новый Массив();
	
	Если ЗначениеЗаполнено(ПредыдущийДокумент) Тогда
		СписокДокументов.Добавить(ПредыдущийДокумент);
	КонецЕсли;
	
	ДанныеВосходящихЦепочек = ПолучитьДанныеВосходящихЦепочек(СписокДокументов, ДокументОбъект);
	
	ДеревоДокументов = ДанныеВосходящихЦепочек.ДеревоДокументов;
	
	СтрокаДокумента = ПолучитьСтрокуПоследнегоДокументаВосходящейЦепочки(ДеревоДокументов);
	
	ТаблицаПодразделовРаздела2 = СтрокаДокумента["ТаблицаПодразделовРаздела2"];
	
	Для Каждого СтрокаПодраздела Из ТаблицаПодразделовРаздела2 Цикл
		ТабличныеДокументы.Добавить(СтрокаПодраздела.ТабличныйДокумент);
	КонецЦикла;
	
	Возврат ТабличныеДокументы;
	
КонецФункции

Функция ПолучитьПрименяемыеСоставыПодразделовРаздела2(ДокументОбъект)
	
	// Применяется для проверки вхождения или невхождения сотрудника в состав комиссии Решения (Изменения решения).
	
	Перем ПредыдущийДокумент;
	
	ПрименяемыеСоставыПодразделов = Новый ТаблицаЗначений();
	ПрименяемыеСоставыПодразделов.Колонки.Добавить("НомерКомиссии",			ОбщегоНазначения.ОписаниеТипаЧисло(6,0,ДопустимыйЗнак.Неотрицательный));
	ПрименяемыеСоставыПодразделов.Колонки.Добавить("НомерРабочейКомиссии",	ОбщегоНазначения.ОписаниеТипаЧисло(6,0,ДопустимыйЗнак.Неотрицательный));
	ПрименяемыеСоставыПодразделов.Колонки.Добавить("Сотрудник",				Новый ОписаниеТипов("СправочникСсылка.Сотрудники"));
	
	Если ИнвентаризацияКлиентСервер.ЭтоДокументИзмененияРешения(ДокументОбъект.Ссылка) Тогда
		ПредыдущийДокумент = ?(ЗначениеЗаполнено(ДокументОбъект.ПредыдущееИзменениеРешения),
			ДокументОбъект.ПредыдущееИзменениеРешения,
			ДокументОбъект.Решение);
	КонецЕсли;

	СписокДокументов = Новый Массив();
	
	Если ЗначениеЗаполнено(ПредыдущийДокумент) Тогда
		СписокДокументов.Добавить(ПредыдущийДокумент);
	КонецЕсли;
	
	ДанныеВосходящихЦепочек = ПолучитьДанныеВосходящихЦепочек(СписокДокументов, ДокументОбъект);
	
	ДеревоДокументов = ДанныеВосходящихЦепочек.ДеревоДокументов;
	
	СтрокаДокумента = ПолучитьСтрокуПоследнегоДокументаВосходящейЦепочки(ДеревоДокументов);
	
	ТаблицаПодразделовРаздела2 = СтрокаДокумента["ТаблицаПодразделовРаздела2"];
	
	НомерКомиссии = 0;
	
	Для Каждого СтрокаПодраздела Из ТаблицаПодразделовРаздела2 Цикл
		НомерКомиссии = НомерКомиссии + 1;
		
		НоваяСтрока = ПрименяемыеСоставыПодразделов.Добавить();
		НоваяСтрока.НомерКомиссии = НомерКомиссии;
		
		Для Каждого СтрокаСравненияСостава Из СтрокаПодраздела.ТаблицаСравненияСоставаКомиссий Цикл
			Если СтрокаСравненияСостава.ТипИзменения = Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Отмена Тогда
				Продолжить;
			КонецЕсли;
			
			Если СтрокаСравненияСостава.НомерСтроки > 1 Тогда
				НоваяСтрока = ПрименяемыеСоставыПодразделов.Добавить();
				НоваяСтрока.НомерКомиссии = НомерКомиссии;
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСравненияСостава, "Сотрудник,НомерРабочейКомиссии");
		КонецЦикла;
	КонецЦикла;
	
	Возврат ПрименяемыеСоставыПодразделов;
	
КонецФункции

Процедура НастроитьТабличныеДокументыНаФорме(Форма, ТабличныеДокументы, ИмяЭлементаСтраниц)
	
	КоличествоНаФорме = Форма.КоличествоТабличныхДокументов;
	
	Количество = ТабличныеДокументы.Количество();
	
	Если Количество > КоличествоНаФорме Тогда
		ДобавитьТабличныеДокументыНаФорму(Форма, ТабличныеДокументы, ИмяЭлементаСтраниц);
		
	ИначеЕсли Количество < КоличествоНаФорме Тогда
		УдалитьТабличныеДокументыНаФорме(Форма, ТабличныеДокументы, ИмяЭлементаСтраниц);
		
	КонецЕсли;
	
	ЗаполнитьТабличныеДокументыНаФорме(Форма, ТабличныеДокументы);
	
	Форма.КоличествоТабличныхДокументов = Количество;
	
КонецПроцедуры

Процедура ДобавитьТабличныеДокументыНаФорму(Форма, ТабличныеДокументы, ИмяЭлементаСтраниц)
	
	ЭлементСтраниц = Форма.Элементы[ИмяЭлементаСтраниц];
	
	КоличествоНаФорме = Форма.КоличествоТабличныхДокументов;
	
	Количество = ТабличныеДокументы.Количество();
	
	ДобавляемыеРеквизиты = Новый Массив();
	
	// РЕКВИЗИТЫ ФОРМЫ
	
	Для Номер = КоличествоНаФорме + 1 По Количество Цикл
		
		ИмяРеквизита = ПолучитьИмяРеквизитаТабличныйДокументПодраздела(Номер);
		
		НовыйРеквизитФормы = Новый РеквизитФормы(
			ИмяРеквизита,
			Новый ОписаниеТипов("ТабличныйДокумент"));
			
		ДобавляемыеРеквизиты.Добавить(НовыйРеквизитФормы);
		
	КонецЦикла;
	
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	// ЭЛЕМЕНТЫ ФОРМЫ
	
	Для Номер = КоличествоНаФорме + 1 По Количество Цикл
		
		// Страница
		
		ИмяЭлемента = ПолучитьИмяЭлементаСтраницаТабличногоДокументаПодраздела(Номер);
		
		ЭлементСтраницы = Форма.Элементы.Добавить(ИмяЭлемента, Тип("ГруппаФормы"), ЭлементСтраниц);
		ЭлементСтраницы.Вид = ВидГруппыФормы.Страница;
		
		// Табличный документ
		
		ИмяРеквизита = ПолучитьИмяРеквизитаТабличныйДокументПодраздела(Номер);
		
		ЭлементДокумента = Форма.Элементы.Добавить(ИмяРеквизита, Тип("ПолеФормы"), ЭлементСтраницы);
		ЭлементДокумента.Вид = ВидПоляФормы.ПолеТабличногоДокумента;
		ЭлементДокумента.ПутьКДанным = ИмяРеквизита;
		ЭлементДокумента.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьТабличныеДокументыНаФорме(Форма, ТабличныеДокументы, ИмяЭлементаСтраниц)
	
	КоличествоНаФорме = Форма.КоличествоТабличныхДокументов;
	
	Количество = ТабличныеДокументы.Количество();
	
	УдаляемыеРеквизиты = Новый Массив();
	
	// РЕКВИЗИТЫ ФОРМЫ
	
	Для Номер = Количество + 1 По КоличествоНаФорме Цикл
		
		ИмяРеквизита = ПолучитьИмяРеквизитаТабличныйДокументПодраздела(Номер);
		
		УдаляемыеРеквизиты.Добавить(ИмяРеквизита);
		
	КонецЦикла;
	
	Форма.ИзменитьРеквизиты(, УдаляемыеРеквизиты);
	
	// ЭЛЕМЕНТЫ ФОРМЫ
	
	Для Номер = Количество + 1 По КоличествоНаФорме Цикл
		
		// Табличный документ
		
		ИмяЭлемента = ПолучитьИмяРеквизитаТабличныйДокументПодраздела(Номер);
		
		Форма.Элементы.Удалить(Форма.Элементы[ИмяЭлемента]);
		
		// Страница
		
		ИмяЭлемента = ПолучитьИмяЭлементаСтраницаТабличногоДокументаПодраздела(Номер);
		
		Форма.Элементы.Удалить(Форма.Элементы[ИмяЭлемента]);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьИмяРеквизитаТабличныйДокументПодраздела(Номер)
	
	Возврат СтрШаблон("ТабличныйДокументПодраздела%1", Формат(Номер, "ЧГ=0"));
	
КонецФункции

Функция ПолучитьИмяЭлементаСтраницаТабличногоДокументаПодраздела(Номер)
	
	Возврат СтрШаблон("СтраницаТабличныйДокументПодраздела%1", Формат(Номер, "ЧГ=0"));
	
КонецФункции

Процедура ЗаполнитьТабличныеДокументыНаФорме(Форма, ТабличныеДокументы)
	
	Количество = ТабличныеДокументы.Количество();
	
	Номер = 0;
	
	Для Каждого ТабДок Из ТабличныеДокументы Цикл
		
		Номер = Номер + 1;
		
		ИмяРеквизита = ПолучитьИмяРеквизитаТабличныйДокументПодраздела(Номер);
		
		РеквизитТабДок = Форма[ИмяРеквизита];
		
		РеквизитТабДок.Очистить();
		РеквизитТабДок.Вывести(ТабДок);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьПустоеДеревоКомиссийДляФормыДокумента()
	
	ТипЧисло	= Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(4,0,ДопустимыйЗнак.Неотрицательный));
	ТипСтрока	= Новый ОписаниеТипов("Строка");
	ТипСписок	= Новый ОписаниеТипов("СписокЗначений");
	ТипБулево	= Новый ОписаниеТипов("Булево");
	
	Дерево = Новый ДеревоЗначений();
	
	Дерево.Колонки.Добавить("ЧетныйНомерКомиссии",			ТипБулево);
	
	Дерево.Колонки.Добавить("НомерКомиссии",				ТипЧисло);
	Дерево.Колонки.Добавить("НомерКомиссииСтрокой",			ТипСтрока);
	Дерево.Колонки.Добавить("Комиссия",						Новый ОписаниеТипов("СправочникСсылка.ПостоянноДействующиеКомиссии"));
	
	Дерево.Колонки.Добавить("АктыОСоставеКомиссии",			ТипСписок);
	Дерево.Колонки.Добавить("ПредставлениеАктов",			ТипСтрока);
	
	Дерево.Колонки.Добавить("ЭтоРабочаяКомиссия",			ТипБулево);
	Дерево.Колонки.Добавить("ПредставлениеРабочихКомиссий",	ТипСтрока);
	Дерево.Колонки.Добавить("НомерРабочейКомиссии",			ТипЧисло);
	Дерево.Колонки.Добавить("НомерРабочейКомиссииСтрокой",	ТипСтрока);
	Дерево.Колонки.Добавить("НомераРабочихКомиссий",		ТипСписок);
	
	Возврат Дерево;
	
КонецФункции

Функция ПолучитьПустуюТаблицуПредставленийКомиссийДляФормыДокумента()
	
	ТипСтрока = Новый ОписаниеТипов("Строка");
	
	ТаблицаПредставлений = Новый ТаблицаЗначений();
	ТаблицаПредставлений.Колонки.Добавить("Комиссия",						Новый ОписаниеТипов("СправочникСсылка.ПостоянноДействующиеКомиссии"));
	ТаблицаПредставлений.Колонки.Добавить("ПредставлениеРабочихКомиссий",	ТипСтрока);
	ТаблицаПредставлений.Колонки.Добавить("ПредставлениеАктов",				ТипСтрока);
	
	Возврат ТаблицаПредставлений;
	
КонецФункции

Функция ПрочитатьСведенияКомиссийДляФормыДокумента(ДокументОбъект)
	
	ЭтоДокументИзмененияРешения = ЭтоДокументИзмененияРешения(ДокументОбъект);
	
	ТабличнаяЧастьКомиссии = ДокументОбъект.Комиссии;
	
	МассивСсылок = ТабличнаяЧастьКомиссии.Выгрузить(,"Комиссия").ВыгрузитьКолонку("Комиссия");
	
	Если ЭтоДокументИзмененияРешения Тогда
		ВремМассив = ТабличнаяЧастьКомиссии.Выгрузить(,"КомиссияДоИзменения").ВыгрузитьКолонку("КомиссияДоИзменения");
		
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивСсылок, ВремМассив, Истина);
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УдалитьВсеВхожденияЗначенияИзМассива(МассивСсылок, Справочники.ПостоянноДействующиеКомиссии.ПустаяСсылка());
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивСсылок", МассивСсылок);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Реквизиты первичных документов, определяющих состав комиссии
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка				КАК Ссылка,
	|	НаименованиеПриказа	КАК Наименование,
	|	НомерПриказа		КАК Номер,
	|	ДатаПриказа			КАК Дата
	|ИЗ
	|	Справочник.ПостоянноДействующиеКомиссии
	|ГДЕ
	|	Ссылка В(&МассивСсылок)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Рабочие комиссии
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Ссылка					КАК Ссылка,
	|	НомерРабочейКомиссии	КАК НомерРабочейКомиссии
	|ИЗ
	|	Справочник.ПостоянноДействующиеКомиссии.СоставКомиссии
	|ГДЕ
	|	Ссылка В(&МассивСсылок)
	|	И НомерРабочейКомиссии <> 0
	|;";
	
	РезультатыЗапроса = ЗапросПоиск.ВыполнитьПакет();
	
	Результат = Новый Структура();
	
	// [0]. Реквизиты первичных документов, определяющих состав комиссии
	Результат.Вставить("ПервичныеДокументы", РезультатыЗапроса[0].Выгрузить());
	
	// [1]. Рабочие комиссии
	Результат.Вставить("РабочиеКомиссии", РезультатыЗапроса[1].Выгрузить());
	
	Результат.Вставить("МассивСсылок", МассивСсылок);
	
	Возврат Результат;
	
КонецФункции

Процедура УдалитьОтмененныеКомиссии(Дерево, ТабличнаяЧастьКомиссии)
	
	ТипИзмененияОтмена = Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Отмена;
	
	ОставляемыеКомиссии = Новый Массив();
	
	Для Каждого СтрокаТаблицы Из ТабличнаяЧастьКомиссии Цикл
		
		Если СтрокаТаблицы.ТипИзменения = ТипИзмененияОтмена Тогда
			Продолжить;
		КонецЕсли;
		
		Комиссия = СтрокаТаблицы.Комиссия;
		
		Если ЗначениеЗаполнено(Комиссия) Тогда
			ОставляемыеКомиссии.Добавить(Комиссия);
		КонецЕсли;
		
	КонецЦикла;
	
	УдаляемыеСтроки = Новый Массив();
	
	Для Каждого СтрокаДерева Из Дерево.Строки Цикл
		
		ОставитьКомиссию = (ОставляемыеКомиссии.Найти(СтрокаДерева.Комиссия) <> Неопределено);
		
		Если ОставитьКомиссию Тогда
			Продолжить;
		КонецЕсли;
		
		УдаляемыеСтроки.Добавить(СтрокаДерева);
		
	КонецЦикла;
	
	Для Каждого СтрокаДерева Из УдаляемыеСтроки Цикл
		Дерево.Строки.Удалить(СтрокаДерева);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьКолонкуНомерКомиссии(Дерево, ТабличнаяЧастьКомиссии, ЭтоДокументИзмененияРешения)
	
	// Номер комиссии определяется как номер строки табличной части Комиссии
	// Отмененные строки игнорируются
	
	ТипИзмененияОтмена = Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Отмена;
	
	Для Каждого СтрокаДерева Из Дерево.Строки Цикл
		
		Поиск = Новый Структура("Комиссия", СтрокаДерева.Комиссия);
		
		МассивСтрок = ТабличнаяЧастьКомиссии.НайтиСтроки(Поиск);
		
		НомерКомиссии = 0;
		
		Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
			Если ЭтоДокументИзмененияРешения И СтрокаТаблицы.ТипИзменения = ТипИзмененияОтмена Тогда
				Продолжить;
			КонецЕсли;
			
			НомерКомиссии = СтрокаТаблицы["НомерСтроки"];
		КонецЦикла;
		
		СтрокаДерева["НомерКомиссии"]			= НомерКомиссии;
		СтрокаДерева["НомерКомиссииСтрокой"]	= ИнвентаризацияКлиентСервер.ФорматироватьНомерКомиссии(НомерКомиссии);
		
		Для Каждого СтрокаРабочейКомиссии Из СтрокаДерева.Строки Цикл
			ЗаполнитьЗначенияСвойств(СтрокаРабочейКомиссии, СтрокаДерева, "НомерКомиссии,НомерКомиссииСтрокой");
		КонецЦикла;
		
	КонецЦикла;
	
	Дерево.Строки.Сортировать("НомерКомиссии Возр");
	
КонецПроцедуры

Процедура ДобавитьСведенияКомиссииВДерево(Дерево, ТаблицаПредставлений, Комиссия, ИсходныеСведенияКомиссий, ТабличнаяЧастьКомиссии)
	
	ТаблицаПервичныеДокументы	= ИсходныеСведенияКомиссий.ПервичныеДокументы;
	ТаблицаРабочиеКомиссии		= ИсходныеСведенияКомиссий.РабочиеКомиссии;
	
	ОписаниеАкта = Новый Структура("Наименование,Номер,Дата");
	
	Поиск = Новый Структура("Ссылка", Комиссия);
	
	// Комиссия
	
	НоваяСтрокаКомиссия = Дерево.Строки.Добавить();
	
	НоваяСтрокаКомиссия["Комиссия"] = Комиссия;
	
	НоваяСтрокаКомиссия["НомераРабочихКомиссий"] = Новый СписокЗначений();
	
	// Акты, определяющие состав комиссии
	
	АктыОСоставеКомиссии = Новый СписокЗначений();
	
	
	МассивСтрок = ТаблицаПервичныеДокументы.НайтиСтроки(Поиск);
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		ЗаполнитьЗначенияСвойств(ОписаниеАкта, СтрокаТаблицы);
		
		АктыОСоставеКомиссии.Добавить(ОписаниеАкта);
	КонецЦикла;
	
	НоваяСтрокаКомиссия["АктыОСоставеКомиссии"]	= АктыОСоставеКомиссии;
	НоваяСтрокаКомиссия["ПредставлениеАктов"]	= ПолучитьПредставлениеАктовОПроведенииИнвентаризацииДляФормыДокумента(АктыОСоставеКомиссии);
	
	// Рабочие комиссии
	
	НомераРабочихКомиссий = Новый СписокЗначений();
	
	МассивСтрок = ТаблицаРабочиеКомиссии.НайтиСтроки(Поиск);
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		НомерРабочейКомиссии = СтрокаТаблицы.НомерРабочейКомиссии;
		
		НоваяСтрокаРабочаяКомиссия = НоваяСтрокаКомиссия.Строки.Добавить();
		
		НоваяСтрокаРабочаяКомиссия["ЭтоРабочаяКомиссия"]			= Истина;
		
		ЗаполнитьЗначенияСвойств(НоваяСтрокаРабочаяКомиссия, НоваяСтрокаКомиссия, "Комиссия");
		
		НоваяСтрокаРабочаяКомиссия["НомерРабочейКомиссии"]			= НомерРабочейКомиссии;
		НоваяСтрокаРабочаяКомиссия["НомерРабочейКомиссииСтрокой"]	= ИнвентаризацияКлиентСервер.ФорматироватьНомерРабочейКомиссии(НомерРабочейКомиссии);
		
		НоваяСтрокаКомиссия["НомераРабочихКомиссий"].Добавить(НомерРабочейКомиссии);
	КонецЦикла;
	
	НоваяСтрокаКомиссия["ПредставлениеРабочихКомиссий"] = ПолучитьПредставлениеРабочихКомиссийДляФормыДокумента(НоваяСтрокаКомиссия["НомераРабочихКомиссий"]);
	
	НоваяСтрокаКомиссия["НомерРабочейКомиссииСтрокой"] = ПредставлениеРабочихКомиссийДляФормыВыбораКомиссии();
	
	// Представления комиссии
	
	НоваяСтрока = ТаблицаПредставлений.Добавить();
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, НоваяСтрокаКомиссия);
	
КонецПроцедуры

Процедура ЗаполнитьКолонкуЧетныйНомерКомиссии(Дерево)
	
	НомерСтроки = 0;
	
	Для Каждого СтрокаДерева Из Дерево.Строки Цикл
		НомерСтроки = НомерСтроки + 1;
		
		ЧетныйНомерКомиссии = (НомерСтроки % 2 = 0);
		
		СтрокаДерева["ЧетныйНомерКомиссии"] = ЧетныйНомерКомиссии;
		
		Для Каждого СтрокаПоддерева Из СтрокаДерева.Строки Цикл
			СтрокаПоддерева["ЧетныйНомерКомиссии"] = ЧетныйНомерКомиссии;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьПредставлениеАктовОПроведенииИнвентаризацииДляФормыДокумента(АктыОСоставеКомиссии, МаксимальнаяДлинаПредставления = 150, ВыводитьКоличество = Истина)
	
	ШаблонКоличества = "(%1) ";
	
	ШаблонОписания = НСтр("ru='%1 №%2 от %3'");
	
	СимволРазделитель = "; ";
	
	КоличествоАктов = АктыОСоставеКомиссии.Количество();
	
	Если КоличествоАктов = 0 Тогда
		Возврат ПредставлениеОтсутствующихАктовОПроведенииИнвентаризации();
	КонецЕсли;
	
	МассивПредставлений = Новый Массив();
	
	Для Каждого Элемент Из АктыОСоставеКомиссии Цикл
		
		ОписаниеАкта = Элемент.Значение;
		
		МассивПредставлений.Добавить(СтрШаблон(ШаблонОписания,
			ОписаниеАкта.Наименование,
			ОписаниеАкта.Номер,
			Формат(ОписаниеАкта.Дата, "ДФ=""дд.ММ.гггг""")));
			
	КонецЦикла;
	
	Представление = ?(КоличествоАктов > 1 И ВыводитьКоличество, СтрШаблон(ШаблонКоличества, Формат(КоличествоАктов, "ЧГ=")), "")
		+ СтрСоединить(МассивПредставлений, СимволРазделитель);
	
	Представление = ИнвентаризацияКлиентСервер.СократитьСтроку(Представление, МаксимальнаяДлинаПредставления);
	
	Возврат Представление;
	
КонецФункции

Функция ПолучитьПредставлениеРабочихКомиссийДляФормыДокумента(РабочиеКомиссии, МаксимальнаяДлинаПредставления = 50, ВыводитьКоличество = Истина)
	
	ШаблонКоличества = "(%1) ";
	
	СимволРазделитель = "; ";
	
	КоличествоРабочихКомиссий = РабочиеКомиссии.Количество();
	
	Если КоличествоРабочихКомиссий = 0 Тогда
		Возврат ПредставлениеОтсутствующихРабочихКомиссий();
	КонецЕсли;
	
	МассивПредставлений = Новый Массив();
	
	Для Каждого Элемент Из РабочиеКомиссии Цикл
		
		НомерРабочейКомиссии = Элемент.Значение;
		
		МассивПредставлений.Добавить(ИнвентаризацияКлиентСервер.ФорматироватьНомерРабочейКомиссии(НомерРабочейКомиссии));
			
	КонецЦикла;
	
	Представление = ?(КоличествоРабочихКомиссий > 1 И ВыводитьКоличество, СтрШаблон(ШаблонКоличества, Формат(КоличествоРабочихКомиссий, "ЧГ=")), "")
		+ СтрСоединить(МассивПредставлений, СимволРазделитель);
	
	Представление = ИнвентаризацияКлиентСервер.СократитьСтроку(Представление, МаксимальнаяДлинаПредставления);
	
	Возврат Представление;
	
КонецФункции

#КонецОбласти

#Область ПечатьРаздел2

Функция ПолучитьСоответствиеПоказателейИГрафРаздела2()
	
	Результат = Новый Структура();
	
	ИмяПоказателя = "Временная";
	Результат.Вставить(ИмяПоказателя, Новый Массив());
	Результат[ИмяПоказателя].Добавить(2);
	
	ИмяПоказателя = "СтатусЧленаКомиссии";
	Результат.Вставить(ИмяПоказателя, Новый Массив());
	Результат[ИмяПоказателя].Добавить(3);
	
	ИмяПоказателя = "Сотрудник";
	Результат.Вставить(ИмяПоказателя, Новый Массив());
	Результат[ИмяПоказателя].Добавить(4);
	Результат[ИмяПоказателя].Добавить(5);
	
	ИмяПоказателя = "ФИО";
	Результат.Вставить(ИмяПоказателя, Новый Массив());
	Результат[ИмяПоказателя].Добавить(4);
	
	ИмяПоказателя = "Должность";
	Результат.Вставить(ИмяПоказателя, Новый Массив());
	Результат[ИмяПоказателя].Добавить(5);
	
	ИмяПоказателя = "НомерРабочейКомиссии";
	Результат.Вставить(ИмяПоказателя, Новый Массив());
	Результат[ИмяПоказателя].Добавить(6);
	
	Возврат Результат;
	
КонецФункции

Функция СформироватьТабличныйДокументИзмененияСоставаКомиссии(ТаблицаСравненияСоставаКомиссий, Аннулирующее, ДополнительныеПараметры)
	
	ВыводитьПризнакМодифицированностиСтроки = ДополнительныеПараметры.ВыводитьПризнакМодифицированностиСтроки;
	
	ТипИзмененияОтмена = ДополнительныеПараметры.ТипИзменения.Отмена;
	
	ПечататьТолькоМодифицированные = ДополнительныеПараметры.ПечататьТолькоМодифицированные И НЕ ВыводитьПризнакМодифицированностиСтроки;
	
	Если ДополнительныеПараметры.ИспользоватьМакетИзмененияРешения Тогда
		Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ИзменениеРешенияОПроведенииИнвентаризации.ПФ_MXL_Ф0510447");
		
		ОбластиМакета = Новый Структура();
		ОбластиМакета.Вставить("Раздел2ШапкаТаблицы",	Макет.ПолучитьОбласть("Раздел2ШапкаТаблицы"));
		
		Если ДополнительныеПараметры.ФорматПечати = "61н" Тогда
			ОбластиМакета.Вставить("Раздел2СтрокаТаблицы",							Макет.ПолучитьОбласть("Раздел2СтрокаТаблицы"));
			ОбластиМакета.Вставить("Раздел2СтрокаТаблицыОтмена",					Макет.ПолучитьОбласть("Раздел2СтрокаТаблицыОтмена"));
			ОбластиМакета.Вставить("Раздел2СтрокаТаблицыКорректировкаДоИзменения",	Макет.ПолучитьОбласть("Раздел2СтрокаТаблицыКорректировкаДоИзменения"));
			ОбластиМакета.Вставить("Раздел2СтрокаТаблицыКорректировкаАктуальный",	Макет.ПолучитьОбласть("Раздел2СтрокаТаблицыКорректировкаАктуальный"));
			
		ИначеЕсли ДополнительныеПараметры.ФорматПечати = "157н" Тогда
			ОбластиМакета.Вставить("Раздел2СтрокаТаблицыПриказ157нПустая",						Макет.ПолучитьОбласть("Раздел2СтрокаТаблицыПриказ157нПустая"));
			ОбластиМакета.Вставить("Раздел2СтрокаТаблицыПриказ157нДополнение",					Макет.ПолучитьОбласть("Раздел2СтрокаТаблицыПриказ157нДополнение"));
			ОбластиМакета.Вставить("Раздел2СтрокаТаблицыПриказ157нОтмена",						Макет.ПолучитьОбласть("Раздел2СтрокаТаблицыПриказ157нОтмена"));
			ОбластиМакета.Вставить("Раздел2СтрокаТаблицыПриказ157нКорректировкаДоИзменения",	Макет.ПолучитьОбласть("Раздел2СтрокаТаблицыПриказ157нКорректировкаДоИзменения"));
			ОбластиМакета.Вставить("Раздел2СтрокаТаблицыПриказ157нКорректировкаАктуальный",		Макет.ПолучитьОбласть("Раздел2СтрокаТаблицыПриказ157нКорректировкаАктуальный"));
		КонецЕсли;
	Иначе
		Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.РешениеОПроведенииИнвентаризации.ПФ_MXL_Ф0510439");
		
		ОбластиМакета = Новый Структура();
		ОбластиМакета.Вставить("Раздел2ШапкаТаблицы",	Макет.ПолучитьОбласть("Раздел2ШапкаТаблицы"));
		ОбластиМакета.Вставить("Раздел2СтрокаТаблицы",	Макет.ПолучитьОбласть("Раздел2СтрокаТаблицы"));
	КонецЕсли;
	
	ТабДок = Новый ТабличныйДокумент();
	
	ТабДок.Вывести(ОбластиМакета.Раздел2ШапкаТаблицы);
	
	Для Каждого СтрокаТаблицы Из ТаблицаСравненияСоставаКомиссий Цикл
		
		ТипИзменения		= СтрокаТаблицы.ТипИзменения;
		Модифицированность	= СтрокаТаблицы.Модифицированность;
		
		ВывестиСтроку = Истина;
		
		Если Аннулирующее Тогда
			ВывестиСтроку = (ТипИзменения <> ТипИзмененияОтмена);
			
		ИначеЕсли ПечататьТолькоМодифицированные Тогда
			// Разрешаем вывод строки с пустым типом изменения, если он был сброшен
			ВывестиСтроку = Модифицированность;
		КонецЕсли;
		
		Если НЕ ВывестиСтроку Тогда
			Продолжить;
		КонецЕсли;
		
		Если ДополнительныеПараметры.ИспользоватьМакетИзмененияРешения Тогда
			
			Если ДополнительныеПараметры.ФорматПечати = "61н" Тогда
				ВывестиСтрокуРаздел2(СтрокаТаблицы, ТабДок, ОбластиМакета, ВыводитьПризнакМодифицированностиСтроки, ДополнительныеПараметры)
				
			ИначеЕсли ДополнительныеПараметры.ФорматПечати = "157н" Тогда
				ВывестиСтрокуРаздел2Приказ157н(СтрокаТаблицы, ТабДок, ОбластиМакета, ВыводитьПризнакМодифицированностиСтроки, ДополнительныеПараметры)
			КонецЕсли;
			
		Иначе
			ВывестиСтрокуРаздел2_Решение(СтрокаТаблицы, Аннулирующее, ТабДок, ОбластиМакета, ДополнительныеПараметры);
		КонецЕсли;
		
	КонецЦикла;
	
	Если ДополнительныеПараметры.ИспользоватьМакетИзмененияРешения И Не ВыводитьПризнакМодифицированностиСтроки Тогда
		// Удаляем первую колонку с признаком модифицированности строки
		
		ОбластьБезПервойКолонки = ТабДок.ПолучитьОбласть(1, 2, ТабДок.ВысотаТаблицы, ТабДок.ШиринаТаблицы);
		
		ВремТабДок = Новый ТабличныйДокумент();
		ВремТабДок.Вывести(ОбластьБезПервойКолонки);
		
		ТабДок = ВремТабДок;
	КонецЕсли;
	
	Возврат ТабДок;
	
КонецФункции

Процедура ВывестиСтрокуРаздел2(СтрокаТаблицы, ТабДок, ОбластиМакета, ВыводитьПризнакМодифицированностиСтроки, ДополнительныеПараметры)
	
	ТипИзменения		= СтрокаТаблицы.ТипИзменения;
	Модифицированность	= СтрокаТаблицы.Модифицированность;
	
	ЭтоКорректировка	= (ТипИзменения = ДополнительныеПараметры.ТипИзменения.Корректировка);
	ЭтоОтмена			= (ТипИзменения = ДополнительныеПараметры.ТипИзменения.Отмена);
	
	ОбластьСтрока							= ОбластиМакета["Раздел2СтрокаТаблицы"];
	ОбластьСтрокаОтмена						= ОбластиМакета["Раздел2СтрокаТаблицыОтмена"];
	ОбластьСтрокаКорректировкаДоИзменения	= ОбластиМакета["Раздел2СтрокаТаблицыКорректировкаДоИзменения"];
	ОбластьСтрокаКорректировкаАктуальный	= ОбластиМакета["Раздел2СтрокаТаблицыКорректировкаАктуальный"];
	
	// ЗАПОЛНЯЕМ ПАРАМЕТРЫ
	
	ЗначенияПараметров = Новый Структура();
	
	ЗначенияПараметров.Вставить("Актуальный", Новый Структура());
	
	Если ЭтоКорректировка Тогда
		ЗначенияПараметров.Вставить("ДоИзменения", Новый Структура());
	КонецЕсли;
	
	ДобавитьПараметрыСтрокиРаздела2(ЗначенияПараметров, СтрокаТаблицы, ДополнительныеПараметры);
	
	// ВЫВОДИМ ОБЛАСТЬ
	
	// Опциональная строка
	Если ЭтоКорректировка Тогда
		Область = ОбластьСтрокаКорректировкаДоИзменения;
		
		Область.Параметры.Заполнить(ЗначенияПараметров);
		Область.Параметры.Заполнить(ЗначенияПараметров.ДоИзменения);
		
		ТабДок.Вывести(Область);
	КонецЕсли;
	
	// Обязательная строка
	Если ЭтоОтмена Тогда
		Область = ОбластьСтрокаОтмена;
	ИначеЕсли ЭтоКорректировка Тогда
		Область = ОбластьСтрокаКорректировкаАктуальный;
	Иначе
		Область = ОбластьСтрока;
	КонецЕсли;
	
	Область.Параметры.Заполнить(ЗначенияПараметров);
	Область.Параметры.Заполнить(ЗначенияПараметров.Актуальный);
	
	Если ЭтоКорректировка Тогда
		ЗавершитьВыводСтрокиКорректировкиРаздел2(СтрокаТаблицы, ТабДок, Область, ДополнительныеПараметры);
	Иначе
		ТабДок.Вывести(Область);
	КонецЕсли;
	
	Если ВыводитьПризнакМодифицированностиСтроки Тогда
		ВставитьКартинкуМодифицированностиСтрокиРаздела2(СтрокаТаблицы.Модифицированность, ЭтоКорректировка, ТабДок);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВставитьКартинкуМодифицированностиСтрокиРаздела2(Модифицированность, ЭтоКорректировка, ТабДок)
	
	НомерСтрокиКон = ТабДок.ВысотаТаблицы;
	НомерСтрокиНач = НомерСтрокиКон;
	
	Если ЭтоКорректировка Тогда
		НомерСтрокиНач = НомерСтрокиКон - 1;
	КонецЕсли;
	
	ОбластьЯчейка = ТабДок.Область(НомерСтрокиНач, 1, НомерСтрокиКон, 1);
	
	Если Модифицированность Тогда
		ОбластьЯчейка.Картинка						= БиблиотекаКартинок.УровеньДоступаРедактирование;
		ОбластьЯчейка.ВертикальноеПоложениеКартинки	= ВертикальноеПоложение.Центр;
		ОбластьЯчейка.РазмерКартинки				= РазмерКартинки.РеальныйРазмер
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗавершитьВыводСтрокиКорректировкиРаздел2(СтрокаТаблицы, ТабДок, ОбластьСтрокаАктуальная, ДополнительныеПараметры)
	
	КоличествоГрафРаздела2 = 7;
	
	ШиринаКолонокМодифицированностьСтроки = 1;
	
	ТабДок.Вывести(ОбластьСтрокаАктуальная);
	
	// Выводим строку повторно (лишняя строка) для сохранения правых и нижних границ
	// при последующем удалении и объединении областей 
	ТабДок.Вывести(ОбластьСтрокаАктуальная);
	
	НомерЛишнейСтроки = ТабДок.ВысотаТаблицы;
	
	// Ячейка с картинкой модифицированности
	ОбъединитьЯчейкиСтрокиРаздела2ПоВысоте(ТабДок, 1);
	
	НомераГрафПоказателиРазличные = ОпределитьНомераГрафРаздела2ПоказателиРазличные(СтрокаТаблицы, ДополнительныеПараметры);
	
	Для НомерГрафы = 1 По КоличествоГрафРаздела2 Цикл
		ПоказателиРазличные = (НомераГрафПоказателиРазличные.Найти(НомерГрафы) <> Неопределено);
		
		НомерКолонки = НомерГрафы + ШиринаКолонокМодифицированностьСтроки;
		
		Если ПоказателиРазличные Тогда
			Если ДополнительныеПараметры.ВыводитьПризнакМодифицированностиСтроки Тогда
				ВыделитьЦветомЯчейкиРазличныхПоказателей(ТабДок, НомерКолонки);
			КонецЕсли;
			
			Продолжить;
		КонецЕсли;
		
		ОбъединитьЯчейкиСтрокиРаздела2ПоВысоте(ТабДок, НомерКолонки);
	КонецЦикла;
	
	ОбластьЛишняяСтрока	= ТабДок.Область(НомерЛишнейСтроки,, НомерЛишнейСтроки);
	
	ТабДок.УдалитьОбласть(ОбластьЛишняяСтрока, ТипСмещенияТабличногоДокумента.ПоВертикали);
	
КонецПроцедуры

Процедура ОбъединитьЯчейкиСтрокиРаздела2ПоВысоте(ТабДок, НомерКолонки)
	
	НомерСтрокиАктуальный	= ТабДок.ВысотаТаблицы - 1;
	НомерСтрокиДоИзменения	= НомерСтрокиАктуальный - 1;
	
	ОбластьЯчейкаСтрокиДоИзменения = ТабДок.Область(НомерСтрокиДоИзменения, НомерКолонки, НомерСтрокиДоИзменения, НомерКолонки);
	
	ОбластьЯчейкиДвухСтрок = ТабДок.Область(НомерСтрокиДоИзменения, НомерКолонки, НомерСтрокиАктуальный, НомерКолонки);
	
	ТабДок.УдалитьОбласть(ОбластьЯчейкаСтрокиДоИзменения, ТипСмещенияТабличногоДокумента.ПоВертикали);
	
	ОбластьЯчейкиДвухСтрок.Объединить();
	
КонецПроцедуры

Процедура ВыделитьЦветомЯчейкиРазличныхПоказателей(ТабДок, НомерКолонки)
	
	НомерСтрокиАктуальный	= ТабДок.ВысотаТаблицы - 1;
	НомерСтрокиДоИзменения	= НомерСтрокиАктуальный - 1;
	
	ОбластьЯчейкиДвухСтрок = ТабДок.Область(НомерСтрокиДоИзменения, НомерКолонки, НомерСтрокиАктуальный, НомерКолонки);
	
	ОбластьЯчейкиДвухСтрок.ЦветТекста = WebЦвета.Синий;
	
КонецПроцедуры

Функция ОпределитьНомераГрафРаздела2ПоказателиРазличные(СтрокаТаблицы, ДополнительныеПараметры)
	
	НомераГраф = Новый Массив();
	
	СоответствиеГраф = ДополнительныеПараметры.СоответствиеПоказателейИГрафРаздела2;
	
	ИменаПоказателей = ДополнительныеПараметры.НастройкиТаблицы.Показатели.ДопустимаКорректировка;
	
	ПостфиксАктуальный	= ДополнительныеПараметры.НастройкиТаблицы.ПостфиксыИменКолонокПоказателей.Актуальный;
	ПостфиксДоИзменения	= ДополнительныеПараметры.НастройкиТаблицы.ПостфиксыИменКолонокПоказателей.ДоИзменения;
	
	Для Каждого ИмяПоказателя Из ИменаПоказателей Цикл
		
		Если СтрокаТаблицы[ИмяПоказателя + ПостфиксАктуальный] = СтрокаТаблицы[ИмяПоказателя + ПостфиксДоИзменения] Тогда
			Продолжить;
		КонецЕсли;
		
		НастройкаГраф = СоответствиеГраф[ИмяПоказателя];
		
		Для Каждого НомерГрафы Из НастройкаГраф Цикл
			Если НомераГраф.Найти(НомерГрафы) = Неопределено Тогда
				НомераГраф.Добавить(НомерГрафы);
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат НомераГраф;
	
КонецФункции

Процедура ДобавитьПараметрыСтрокиРаздела2(ЗначенияПараметров, СтрокаТаблицы, ДополнительныеПараметры);
	
	ЗначенияПараметров.Вставить("КодСтроки", СтрокаТаблицы.НомерСтроки);
	
	Если ДополнительныеПараметры.Аннулирующее Тогда
		ТипИзменения = ДополнительныеПараметры.ТипИзменения.Аннулирование;
	Иначе
		ТипИзменения = СтрокаТаблицы.ТипИзменения;
	КонецЕсли;
	
	ЗначенияПараметров.Вставить("ТипИзменения", ТипИзменения);
	
	ИменаПоказателей = ДополнительныеПараметры.НастройкиТаблицы.Показатели.ДопустимаКорректировка;
	
	ПостфиксАктуальный	= ДополнительныеПараметры.НастройкиТаблицы.ПостфиксыИменКолонокПоказателей.Актуальный;
	ПостфиксДоИзменения	= ДополнительныеПараметры.НастройкиТаблицы.ПостфиксыИменКолонокПоказателей.ДоИзменения;
	
	ЭтоКорректировка = (СтрокаТаблицы["ТипИзменения" + ПостфиксАктуальный] = ДополнительныеПараметры.ТипИзменения.Корректировка);
	
	Для Каждого ИмяПоказателя Из ИменаПоказателей Цикл
		ЗначенияПараметров.Актуальный.Вставить(ИмяПоказателя, СтрокаТаблицы[ИмяПоказателя + ПостфиксАктуальный]);
		
		Если ЭтоКорректировка Тогда
			ЗначенияПараметров.ДоИзменения.Вставить(ИмяПоказателя, СтрокаТаблицы[ИмяПоказателя + ПостфиксДоИзменения]);
		КонецЕсли;
	КонецЦикла;
	
	ЗначенияПараметров.Актуальный.Вставить("ВидКомиссии",			ПолучитьПредставлениеВидКомиссии(СтрокаТаблицы, ПостфиксАктуальный));
	ЗначенияПараметров.Актуальный.Вставить("Статус",				ПолучитьПредставлениеСтатусЧленаКомиссии(СтрокаТаблицы, ПостфиксАктуальный));
	ЗначенияПараметров.Актуальный.Вставить("НомерРабочейКомиссии",	ПолучитьПредставлениеНомерРабочейКомиссии(СтрокаТаблицы, ПостфиксАктуальный));
		
	Если ЭтоКорректировка Тогда
		ЗначенияПараметров.ДоИзменения.Вставить("ВидКомиссии",			ПолучитьПредставлениеВидКомиссии(СтрокаТаблицы, ПостфиксДоИзменения));
		ЗначенияПараметров.ДоИзменения.Вставить("Статус",				ПолучитьПредставлениеСтатусЧленаКомиссии(СтрокаТаблицы, ПостфиксДоИзменения));
		ЗначенияПараметров.ДоИзменения.Вставить("НомерРабочейКомиссии",	ПолучитьПредставлениеНомерРабочейКомиссии(СтрокаТаблицы, ПостфиксДоИзменения));
	КонецЕсли;
	
КонецПроцедуры

Процедура ПреобразоватьТаблицыСравненияСоставаКомиссийВАктуальныеНаДату(СтрокаДерева)
	
	Поиск = Новый Структура();
	
	Для Каждого СтрокаТаблицыПодразделаРаздела2 Из СтрокаДерева.ТаблицаПодразделовРаздела2 Цикл
		ТаблицаСравненияСоставаКомиссий = СтрокаТаблицыПодразделаРаздела2.ТаблицаСравненияСоставаКомиссий;
		
		Поиск.Вставить("ТипИзменения", Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Отмена);
		
		МассивУдалить = ТаблицаСравненияСоставаКомиссий.НайтиСтроки(Поиск);
		
		Для Каждого СтрокаУдалить Из МассивУдалить Цикл
			ТаблицаСравненияСоставаКомиссий.Удалить(СтрокаУдалить);
		КонецЦикла;
		
		ТаблицаСравненияСоставаКомиссий.ЗаполнитьЗначения(Истина, "Модифицированность");
		ТаблицаСравненияСоставаКомиссий.ЗаполнитьЗначения(Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.ПустаяСсылка(), "ТипИзменения");
		
		СтрокаТаблицыПодразделаРаздела2["ЕстьМодифицированныеСтроки"] = ТаблицаСравненияСоставаКомиссий.Итог("Модифицированность");
	КонецЦикла;
	
	Для Каждого ДочерняяСтрокаДерева Из СтрокаДерева.Строки Цикл
		ПреобразоватьТаблицыСравненияСоставаКомиссийВАктуальныеНаДату(ДочерняяСтрокаДерева);
	КонецЦикла;
	
КонецПроцедуры

Процедура ВывестиСтрокуРаздел2_Решение(СтрокаТаблицы, Аннулирующее, ТабДок, ОбластиМакета, ДополнительныеПараметры)
	
	ОбластьСтрока = ОбластиМакета["Раздел2СтрокаТаблицы"];
	
	// ЗАПОЛНЯЕМ ПАРАМЕТРЫ
	
	ЗначенияПараметров = Новый Структура();
	
	Если Аннулирующее Тогда
		ЗначенияПараметров.Вставить("КодСтроки", СтрокаТаблицы.НомерСтроки);

		ОбластьСтрока.Параметры.Заполнить(ЗначенияПараметров);

	Иначе
		ЗначенияПараметров.Вставить("Актуальный", Новый Структура());
		
		ДобавитьПараметрыСтрокиРаздела2(ЗначенияПараметров, СтрокаТаблицы, ДополнительныеПараметры);
		
		ОбластьСтрока.Параметры.Заполнить(ЗначенияПараметров);
		ОбластьСтрока.Параметры.Заполнить(ЗначенияПараметров.Актуальный);
	КонецЕсли;
	
	// ВЫВОДИМ ОБЛАСТЬ
	
	ТабДок.Вывести(ОбластьСтрока);
	
КонецПроцедуры

#Область Приказ157н

Процедура ВывестиСтрокуРаздел2Приказ157н(СтрокаТаблицы, ТабДок, ОбластиМакета, ВыводитьПризнакМодифицированностиСтроки, ДополнительныеПараметры)
	
	ТипИзменения		= СтрокаТаблицы.ТипИзменения;
	Модифицированность	= СтрокаТаблицы.Модифицированность;
	
	ЭтоКорректировка	= (ТипИзменения = ДополнительныеПараметры.ТипИзменения.Корректировка);
	ЭтоОтмена			= (ТипИзменения = ДополнительныеПараметры.ТипИзменения.Отмена);
	ЭтоДополнение		= (ТипИзменения = ДополнительныеПараметры.ТипИзменения.Дополнение);
	ЭтоПустой			= (ТипИзменения = ДополнительныеПараметры.ТипИзменения.Пустой);
	
	ОбластьСтрокаПустая						= ОбластиМакета["Раздел2СтрокаТаблицыПриказ157нПустая"];
	ОбластьСтрокаДополнение					= ОбластиМакета["Раздел2СтрокаТаблицыПриказ157нДополнение"];
	ОбластьСтрокаОтмена						= ОбластиМакета["Раздел2СтрокаТаблицыПриказ157нОтмена"];
	ОбластьСтрокаКорректировкаДоИзменения	= ОбластиМакета["Раздел2СтрокаТаблицыПриказ157нКорректировкаДоИзменения"];
	ОбластьСтрокаКорректировкаАктуальный	= ОбластиМакета["Раздел2СтрокаТаблицыПриказ157нКорректировкаАктуальный"];
	
	// ЗАПОЛНЯЕМ ПАРАМЕТРЫ
	
	ЗначенияПараметров = Новый Структура();
	
	ЗначенияПараметров.Вставить("Актуальный", Новый Структура());
	
	Если ЭтоКорректировка Тогда
		ЗначенияПараметров.Вставить("ДоИзменения", Новый Структура());
	КонецЕсли;
	
	ДобавитьПараметрыСтрокиРаздела2(ЗначенияПараметров, СтрокаТаблицы, ДополнительныеПараметры);
	
	// ВЫВОДИМ ОБЛАСТЬ
	
	// Первая строка
	
	Если ЭтоДополнение Тогда
		Область = ОбластьСтрокаПустая;
		
		Область.Параметры.Заполнить(ЗначенияПараметров);
		
	ИначеЕсли ЭтоОтмена Тогда
		Область = ОбластьСтрокаОтмена;
		
		Область.Параметры.Заполнить(ЗначенияПараметров);
		Область.Параметры.Заполнить(ЗначенияПараметров.Актуальный);
		
	ИначеЕсли ЭтоКорректировка Тогда
		Область = ОбластьСтрокаКорректировкаДоИзменения;
		
		Область.Параметры.Заполнить(ЗначенияПараметров);
		Область.Параметры.Заполнить(ЗначенияПараметров.ДоИзменения);
		
	ИначеЕсли ЭтоПустой Тогда
		Область = ОбластьСтрокаДополнение;
		
		Область.Параметры.Заполнить(ЗначенияПараметров);
		Область.Параметры.Заполнить(ЗначенияПараметров.Актуальный);
	КонецЕсли;
	
	ТабДок.Вывести(Область);
	
	// Вторая строка
	Если ЭтоДополнение Тогда
		Область = ОбластьСтрокаДополнение;
		
		Область.Параметры.Заполнить(ЗначенияПараметров);
		Область.Параметры.Заполнить(ЗначенияПараметров.Актуальный);
		
	ИначеЕсли ЭтоОтмена Тогда
		Область = ОбластьСтрокаПустая;
		
		Область.Параметры.Заполнить(ЗначенияПараметров);
		
	ИначеЕсли ЭтоКорректировка Тогда
		Область = ОбластьСтрокаКорректировкаАктуальный;
		
		Область.Параметры.Заполнить(ЗначенияПараметров);
		Область.Параметры.Заполнить(ЗначенияПараметров.Актуальный);
	КонецЕсли;
	
	Если Не ЭтоПустой Тогда
		ТабДок.Вывести(Область);
	КонецЕсли;
	
	Если ЭтоКорректировка Тогда
		ВыделитьИзмененныеЗначенияКорректировкиРаздел2Приказ157н(СтрокаТаблицы, ТабДок, ДополнительныеПараметры);
	КонецЕсли;
	
	Если ВыводитьПризнакМодифицированностиСтроки Тогда
		ВставитьКартинкуМодифицированностиСтрокиРаздела2Приказ157н(СтрокаТаблицы.Модифицированность, ЭтоКорректировка, ТабДок);
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыделитьИзмененныеЗначенияКорректировкиРаздел2Приказ157н(СтрокаТаблицы, ТабДок, ДополнительныеПараметры)
	
	КоличествоГрафРаздела2 = 7;
	
	ШиринаКолонокМодифицированностьСтроки = 1;
	
	НомераГрафПоказателиРазличные = ОпределитьНомераГрафРаздела2ПоказателиРазличные(СтрокаТаблицы, ДополнительныеПараметры);
	
	НомерПоследнейСтроки = ТабДок.ВысотаТаблицы;
	
	Для НомерГрафы = 1 По КоличествоГрафРаздела2 Цикл
		ПоказателиРазличные = (НомераГрафПоказателиРазличные.Найти(НомерГрафы) <> Неопределено);
		
		Если Не ПоказателиРазличные Тогда
			Продолжить;
		КонецЕсли;
		
		НомерКолонки = НомерГрафы + ШиринаКолонокМодифицированностьСтроки;
			
		ОбластьЯчейка = ТабДок.Область(НомерПоследнейСтроки, НомерКолонки, НомерПоследнейСтроки, НомерКолонки);
		
		ЗаполнитьЗначенияСвойств(ОбластьЯчейка, ДополнительныеПараметры.ОформлениеИзмененныхЗначенийКорректировкиПриказ157н.Раздел2);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьНастройкиОформленияИзмененныхЗначенийКорректировкиПриказ157н(ДополнительныеПараметры) Экспорт
	
	ДополнительныеПараметры.Вставить("ОформлениеИзмененныхЗначенийКорректировкиПриказ157н", Новый Структура());
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ИзменениеРешенияОПроведенииИнвентаризации.ПФ_MXL_Ф0510447");
	
	// Раздел 1
	ОбластьЯчейкаНастроек = Макет.ПолучитьОбласть("Раздел1ОформлениеКорректировкаИзмененноеЗначениеПриказ157н").Область(1,1,1,1);
	
	Оформление = Новый Структура();
	Оформление.Вставить("ЦветТекста",	ОбластьЯчейкаНастроек.ЦветТекста);
	Оформление.Вставить("Шрифт",		ОбластьЯчейкаНастроек.Шрифт);
	
	ДополнительныеПараметры.ОформлениеИзмененныхЗначенийКорректировкиПриказ157н.Вставить("Раздел1", Оформление);
	
	// Раздел 2
	ОбластьЯчейкаНастроек = Макет.ПолучитьОбласть("Раздел2ОформлениеКорректировкаИзмененноеЗначениеПриказ157н").Область(1,1,1,1);
	
	Оформление = Новый Структура();
	Оформление.Вставить("ЦветТекста",	ОбластьЯчейкаНастроек.ЦветТекста);
	Оформление.Вставить("Шрифт",		ОбластьЯчейкаНастроек.Шрифт);
	
	ДополнительныеПараметры.ОформлениеИзмененныхЗначенийКорректировкиПриказ157н.Вставить("Раздел2", Оформление);
	
КонецПроцедуры

Процедура ВставитьКартинкуМодифицированностиСтрокиРаздела2Приказ157н(Модифицированность, ЭтоКорректировка, ТабДок)
	
	НомерПоследнейСтроки = ТабДок.ВысотаТаблицы;
	
	ОбластьЯчейка = ТабДок.Область(НомерПоследнейСтроки, 1, НомерПоследнейСтроки, 1);
	
	Если Модифицированность Тогда
		ОбластьЯчейка.Картинка						= БиблиотекаКартинок.УровеньДоступаРедактирование;
		ОбластьЯчейка.ВертикальноеПоложениеКартинки	= ВертикальноеПоложение.Центр;
		ОбластьЯчейка.РазмерКартинки				= РазмерКартинки.РеальныйРазмер
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеКолонкиТаблицыОбъекты

Процедура СкопироватьКолонкуВТабличнуюЧастьРешения(ТабличнаяЧасть, ТаблицаОбъекты, ИменаКолонок)
	
	НомерСтроки = 0;
	
	Для Каждого СтрокаТабличнойЧасти Из ТабличнаяЧасть Цикл
		НомерСтроки = НомерСтроки + 1;
		
		СтрокаТаблицыОбъекты = ТаблицаОбъекты[НомерСтроки - 1];
		
		ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтрокаТаблицыОбъекты, ИменаКолонок);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьКолонкуКодФормыВТаблицеОбъекты(ТаблицаОбъектыСопоставленная, Знач ТаблицаНастроек, Знач ДатаРешения,
		Знач ПризнакиДокументовРешений = Неопределено)
	
	Если Не ЗначениеЗаполнено(ДатаРешения) Тогда
		ДатаРешения = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Если ТаблицаОбъектыСопоставленная.Колонки.Найти("КодФормы") = Неопределено Тогда
		ТаблицаОбъектыСопоставленная.Колонки.Добавить("КодФормы", Новый ОписаниеТипов("Строка"));
	КонецЕсли;
	
	Если ТаблицаОбъектыСопоставленная.Колонки.Найти("МассивКодовФорм") = Неопределено Тогда
		ТаблицаОбъектыСопоставленная.Колонки.Добавить("МассивКодовФорм", Новый ОписаниеТипов("ФиксированныйМассив"));
	КонецЕсли;
	
	Для Каждого СтрокаТаблицыОбъекты Из ТаблицаОбъектыСопоставленная Цикл
		НаДату = ?(ПризнакиДокументовРешений <> Неопределено,
			ПризнакиДокументовРешений.Получить(СтрокаТаблицыОбъекты.Решение).Дата,
			ДатаРешения);
		
		КодФормы = ОпределитьКодФормы(СтрокаТаблицыОбъекты, ТаблицаНастроек, НаДату);
		
		СтрокаТаблицыОбъекты.КодФормы = КодФормы.Представление;
		СтрокаТаблицыОбъекты.МассивКодовФорм = Новый ФиксированныйМассив(КодФормы.МассивКодов);
	КонецЦикла;
	
КонецПроцедуры

Функция ОпределитьКодФормы(СтрокаТаблицыОбъекты, ТаблицаНастроек, ДатаРешения, УчитыватьПериодПрименения = Истина)
	
	// Здесь ДатаРешения заполнена всегда. Любо значением из документа, либо текущей датой сеанса.
	
	МассивКодов = Новый Массив();
	
	Для Каждого НомерСтрокиТаблицыНастроек Из СтрокаТаблицыОбъекты.НомераСтрокНастроек Цикл
		СтрокаТаблицыНастроек = ТаблицаНастроек[НомерСтрокиТаблицыНастроек - 1];
		
		КодФормы = СтрокаТаблицыНастроек.КодФормы;
		
		Если МассивКодов.Найти(КодФормы) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		// Период применения описи включает указанные для него границы.
		ДатаНачалаПрименения			= СтрокаТаблицыНастроек.ДатаНачалаПрименения;
		ДатаОкончанияПримененияВключая	= СтрокаТаблицыНастроек.ДатаОкончанияПримененияВключая;
		
		Если УчитыватьПериодПрименения Тогда
			Если ЗначениеЗаполнено(ДатаНачалаПрименения) И ЗначениеЗаполнено(ДатаОкончанияПримененияВключая)
				И (ДатаРешения < ДатаНачалаПрименения Или ДатаРешения > ДатаОкончанияПримененияВключая) Тогда
				Продолжить;
				
			ИначеЕсли ЗначениеЗаполнено(ДатаНачалаПрименения) И ДатаРешения < ДатаНачалаПрименения Тогда
				Продолжить;
				
			ИначеЕсли ЗначениеЗаполнено(ДатаОкончанияПримененияВключая) И ДатаРешения > ДатаОкончанияПримененияВключая Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		МассивКодов.Добавить(КодФормы);
	КонецЦикла;
	
	Результат = Новый Структура();
	Результат.Вставить("МассивКодов",	МассивКодов);
	Результат.Вставить("Представление",	СтрСоединить(МассивКодов, ", "));
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьКолонкуЕстьРеквизитМОЛВТаблицеОбъекты(ТаблицаОбъектыСопоставленная, ТаблицаНастроек)
	
	Если ТаблицаОбъектыСопоставленная.Колонки.Найти("ОдинаковоеНаличиеРеквизитаМОЛ") = Неопределено Тогда
		ТаблицаОбъектыСопоставленная.Колонки.Добавить("ОдинаковоеНаличиеРеквизитаМОЛ", Новый ОписаниеТипов("Булево"));
	КонецЕсли;
	
	Если ТаблицаОбъектыСопоставленная.Колонки.Найти("ЕстьРеквизитМОЛ") = Неопределено Тогда
		ТаблицаОбъектыСопоставленная.Колонки.Добавить("ЕстьРеквизитМОЛ", Новый ОписаниеТипов("Булево"));
	КонецЕсли;

	Для Каждого СтрокаТаблицыОбъекты Из ТаблицаОбъектыСопоставленная Цикл
		
		ЕстьРеквизитМОЛ = Ложь;
		
		РазличныеЗначения = Новый Соответствие();
		
		Для Каждого НомерСтрокиТаблицыНастроек Из СтрокаТаблицыОбъекты.НомераСтрокНастроек Цикл
			
			СтрокаТаблицыНастроек = ТаблицаНастроек[НомерСтрокиТаблицыНастроек - 1];
			
			ТекущееЗначение = ЗначениеЗаполнено(СтрокаТаблицыНастроек.ИмяРеквизитаМОЛ);
			
			РазличныеЗначения.Вставить(ТекущееЗначение);
			
			Если ТекущееЗначение Тогда
				ЕстьРеквизитМОЛ = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
		СтрокаТаблицыОбъекты.ОдинаковоеНаличиеРеквизитаМОЛ	= (РазличныеЗначения.Количество() = 1);
		СтрокаТаблицыОбъекты.ЕстьРеквизитМОЛ				= ЕстьРеквизитМОЛ;
		
	КонецЦикла;
	
	УбратьОбязательностьУказанияМОЛДляЕдинственнойОписи0504087(ТаблицаОбъектыСопоставленная);
	
КонецПроцедуры

Процедура УбратьОбязательностьУказанияМОЛДляЕдинственнойОписи0504087(ТаблицаОбъектыСопоставленная)
	
	// Обрабатываются строки, где указана только одна опись 0504087 а опись 0510466 не указана.
	
	Поиск = Новый Структура();
	Поиск.Вставить("КодФормы",						"0504087");
	Поиск.Вставить("ЕстьРеквизитМОЛ",				Истина);
	Поиск.Вставить("ОдинаковоеНаличиеРеквизитаМОЛ",	Истина);
	
	МассивСтрок = ТаблицаОбъектыСопоставленная.НайтиСтроки(Поиск);
	
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СписокСчетов = БухгалтерскийУчет.СписокСчетов("24,25,26,27");
	
	Для Каждого СтрокаТаблицыОбъекты Из МассивСтрок Цикл
		СтрокаТаблицыОбъекты.ЕстьРеквизитМОЛ = Ложь;
		СтрокаТаблицыОбъекты.ОдинаковоеНаличиеРеквизитаМОЛ = Ложь;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьСлужебныеКолонкиТаблицыОбъекты(Таблица)
	
	ТипБулево = Новый ОписаниеТипов("Булево");
	
	Таблица.Колонки.Добавить("КодФормы",						Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ЕстьРеквизитМОЛ",					ТипБулево);
	Таблица.Колонки.Добавить("ОдинаковоеНаличиеРеквизитаМОЛ",	ТипБулево);
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеОписей

Процедура ПроверитьВозможностьЗаполненияОписиПоРешению(Знач РешениеСсылка, РезультатПроверки, ВызыватьИсключение = Истина)
	
	Перем ТекстСообщения;
	
	РезультатПроверки = ИнвентаризацияСервер.ПостроитьДеревоДокументовДляВводаНаОсновании(РешениеСсылка, Неопределено);
	
	Если РезультатПроверки.Дерево.ТаблицаОшибок.Количество() > 0 Тогда	
		ТекстСообщения = НСтр("ru='Обнаружены ошибки построения цепочки документов для выбранного Решения.'");
		
	ИначеЕсли РезультатПроверки.Дерево.Аннулирующее = Истина Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru='Выбранное Решение аннулировано документом
				|%1.'"),
			РезультатПроверки.Дерево.АннулирующееИзменениеСсылка);
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ТекстСообщения) И ВызыватьИсключение Тогда
		ТекстСообщения = СтрШаблон("%1
				|%2",
			ТекстСообщения,
			НСтр("ru='Заполнение описей на основании таких Решений
				|не предусмотрено.'"));
		
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;
	
КонецПроцедуры	

Функция ПрочитатьДанныеДляВыбораИзРешения(ОписьСсылка, ОснованиеСсылка, ВызыватьИсключение = Истина)
	
	Перем Организация;
	
	Если ЗначениеЗаполнено(ОснованиеСсылка) Тогда
		Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОснованиеСсылка, "Организация");
		
		Если Не ЗначениеЗаполнено(Организация) Тогда
			Организация = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	ТаблицаНастроекВсеОписи = ПолучитьТаблицуНастроекЗаполненияОписейПоРешению(,, Организация);
	
	ТипОписи = ТипЗнч(ОписьСсылка);
	
	ТаблицаНастроекПоТипуОписи = ТаблицаНастроекВсеОписи.Скопировать(Новый Структура("ТипОписи", ТипОписи));
	
	ДанныеРешения = Документы.ИзменениеРешенияОПроведенииИнвентаризации.ПолучитьДанныеДляЗаполненияНаОсновании(ОснованиеСсылка, Неопределено, ВызыватьИсключение);
	
	Если ДанныеДляЗаполненияНаОснованииУспешноПолучены(ДанныеРешения) Тогда
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ОписьСсылка",					ОписьСсылка);
		ДополнительныеПараметры.Вставить("ТаблицаНастроекВсеОписи",		ТаблицаНастроекВсеОписи);
		ДополнительныеПараметры.Вставить("ТаблицаНастроекПоТипуОписи",	ТаблицаНастроекПоТипуОписи);
		
		ТаблицаОбъекты = ДанныеРешения.ТаблицаОбъекты;
		ТаблицаНастроек = ТаблицаНастроекПоТипуОписи;
		
		СопоставитьТаблицыОбъектовИНастроек(ТаблицаОбъекты, ТаблицаНастроек, ТипОписи);
		
		ЗаполнитьКолонкуИмяДокументаТаблицыОбъекты(ТаблицаОбъекты, ТаблицаНастроек, ТипОписи);
		
		ДобавитьСведенияКомиссийДляЗаполненияОписи(ДанныеРешения, ТаблицаНастроек, ДополнительныеПараметры);
	Иначе
		ДанныеРешения = Неопределено;
		ДополнительныеПараметры = Неопределено;
	КонецЕсли;
	
	Данные = Новый Структура();
	Данные.Вставить("ДанныеРешения", ДанныеРешения);
	Данные.Вставить("ДополнительныеПараметры", ДополнительныеПараметры);
	
	Возврат Данные;
	
КонецФункции

Процедура ДобавитьСведенияКомиссийДляЗаполненияОписи(Знач ДанныеРешения, Знач ТаблицаНастроек, ДополнительныеПараметры)
	
	ОпределитьКомиссииДляПолученияСведений(ДанныеРешения, ТаблицаНастроек, ДополнительныеПараметры);
	
	МассивыКомиссий = ДополнительныеПараметры.МассивыКомиссий;
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("Комиссии", МассивыКомиссий.ВсеСопоставленные);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Состав комиссий
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка					КАК Ссылка,
	|	Сотрудник				КАК Сотрудник,
	|	СтатусЧленаКомиссии		КАК СтатусЧленаКомиссии,
	|	НомерРабочейКомиссии	КАК НомерРабочейКомиссии,
	|	(СтатусЧленаКомиссии = ЗНАЧЕНИЕ(Перечисление.СтатусыЧленовКомиссии.Председатель))						КАК Председатель,
	|	(СтатусЧленаКомиссии = ЗНАЧЕНИЕ(Перечисление.СтатусыЧленовКомиссии.УполномоченноеПредседателемЛицо))	КАК УполномоченноеЛицо
	|ИЗ
	|	Справочник.ПостоянноДействующиеКомиссии.СоставКомиссии
	|ГДЕ
	|	Ссылка В(&Комиссии)
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Приказы по составу комиссий
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка				КАК Ссылка,
	|	НаименованиеПриказа	КАК НаименованиеПриказа,
	|	НомерПриказа		КАК НомерПриказа,
	|	ДатаПриказа			КАК ДатаПриказа
	|ИЗ
	|	Справочник.ПостоянноДействующиеКомиссии
	|ГДЕ
	|	Ссылка В(&Комиссии)
	|;";
	
	РезультатыЗапроса = ЗапросПоиск.ВыполнитьПакет();
	
	СведенияКомиссий = Новый Структура();
	
	// [0]. Состав комиссий
	СведенияКомиссий.Вставить("ТаблицаСоставыКомиссий", РезультатыЗапроса[0].Выгрузить());
	
	// [1]. Приказы по составу комиссий
	СведенияКомиссий.Вставить("ТаблицаПриказыКомиссий", РезультатыЗапроса[1].Выгрузить());
	
	ДополнительныеПараметры.Вставить("СведенияКомиссий", СведенияКомиссий);
	
	ДобавитьДатуОпределенияСведенийСотрудников(ДанныеРешения, ДополнительныеПараметры);
	
	Если МассивыКомиссий.НеобходимыДолжностьФИОСтрокой.Количество() > 0 Тогда
		ЗаполнитьКолонкиДолжностьФИО(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДополнитьТаблицуПризнакамиСчетов(ТаблицаОбъекты, ГруппыСтрок)
	
	// Для дальнейшей работы процедуры ПолучитьПредставлениеСчетаДляРешения, признаки заполняются так же, как при печати
	
	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипБулево = Новый ОписаниеТипов("Булево");
	
	Если ТаблицаОбъекты.Колонки.Найти("КФОНаименование") = Неопределено Тогда
		ТаблицаОбъекты.Колонки.Добавить("КФОНаименование",	ТипСтрока);
		ТаблицаОбъекты.Колонки.Добавить("СчетКод",			ТипСтрока);
		ТаблицаОбъекты.Колонки.Добавить("СчетНаименование",	ТипСтрока);
		ТаблицаОбъекты.Колонки.Добавить("СчетУчетПоКЭК",	ТипБулево);
		ТаблицаОбъекты.Колонки.Добавить("СчетЗабалансовый",	ТипБулево);
	КонецЕсли;
	
	МассивСчетов = Новый Массив();
	
	Для Каждого ГруппаСтрок Из ГруппыСтрок Цикл
		
		Для Каждого Подгруппа Из ГруппаСтрок.ПодгруппыСтрок Цикл
			НомераСтрок = Подгруппа.НомераСтрок;
			
			Для Каждого НомерСтроки Из НомераСтрок Цикл
				СтрокаТаблицыОбъекты = ТаблицаОбъекты[НомерСтроки - 1];
				
				МассивСчетов.Добавить(СтрокаТаблицыОбъекты.Счет);
			КонецЦикла;
		КонецЦикла;
		
	КонецЦикла;
	
	СвойстваСчетов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МассивСчетов, "Код,Наименование,Забалансовый,УчетПоКЭК");
	
	Для Каждого ГруппаСтрок Из ГруппыСтрок Цикл
		
		Для Каждого Подгруппа Из ГруппаСтрок.ПодгруппыСтрок Цикл
			НомераСтрок = Подгруппа.НомераСтрок;
			
			Для Каждого НомерСтроки Из НомераСтрок Цикл
				СтрокаТаблицыОбъекты = ТаблицаОбъекты[НомерСтроки - 1];
				
				СвойстваСчета = СвойстваСчетов.Получить(СтрокаТаблицыОбъекты.Счет);
				
				СтрокаТаблицыОбъекты.КФОНаименование	= Строка(СтрокаТаблицыОбъекты.КФО);
				СтрокаТаблицыОбъекты.СчетКод			= СвойстваСчета.Код;
				СтрокаТаблицыОбъекты.СчетНаименование	= СвойстваСчета.Наименование;
				СтрокаТаблицыОбъекты.СчетУчетПоКЭК		= СвойстваСчета.УчетПоКЭК;
				СтрокаТаблицыОбъекты.СчетЗабалансовый	= СвойстваСчета.Забалансовый;
			КонецЦикла;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОпределитьКомиссииДляПолученияСведений(Знач ДанныеРешения, Знач ТаблицаНастроек, ДополнительныеПараметры)
	
	// Берем только комиссии, указанные в сопоставленных строках
	
	ТаблицаОбъекты			= ДанныеРешения.ТаблицаОбъекты;
	ТаблицаКомиссии			= ДанныеРешения.ТаблицаКомиссии;
	
	МассивыКомиссий = Новый Структура();
	МассивыКомиссий.Вставить("ВсеСопоставленные", Новый Массив());
	МассивыКомиссий.Вставить("НеобходимыДолжностьФИОСтрокой", Новый Массив());
	
	Для Каждого СтрокаТаблицыОбъекты Из ТаблицаОбъекты Цикл
		НомерКомиссии = СтрокаТаблицыОбъекты.НомерКомиссии;
		
		Если Не ЗначениеЗаполнено(НомерКомиссии) Тогда
			Продолжить;
		КонецЕсли;
		
		Комиссия = ТаблицаКомиссии[НомерКомиссии - 1].Комиссия;
		
		Если Не ЗначениеЗаполнено(Комиссия) Тогда
			Продолжить;
		КонецЕсли;
		
		Если МассивыКомиссий.ВсеСопоставленные.Найти(Комиссия) = Неопределено Тогда
			МассивыКомиссий.ВсеСопоставленные.Добавить(Комиссия);
		КонецЕсли;
		
		Для Каждого НомерСтрокиНастроек Из СтрокаТаблицыОбъекты.НомераСтрокНастроек Цикл
			СтрокаТаблицыНастроек = ТаблицаНастроек[НомерСтрокиНастроек - 1];
			
			Если СтрокаТаблицыНастроек.КомиссияУказываетсяСсылкой Тогда
				Продолжить;
			КонецЕсли;
			
			Если МассивыКомиссий.НеобходимыДолжностьФИОСтрокой.Найти(Комиссия) = Неопределено Тогда
				МассивыКомиссий.НеобходимыДолжностьФИОСтрокой.Добавить(Комиссия);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ДополнительныеПараметры.Вставить("МассивыКомиссий", МассивыКомиссий);
	
КонецПроцедуры

Процедура ДобавитьДатуОпределенияСведенийСотрудников(ДанныеРешения, ДополнительныеПараметры)
	
	Шапка = ДанныеРешения.Шапка;
	
	МассивСсылок = Новый Массив();
	МассивСсылок.Добавить(Шапка.ПредыдущееИзменениеРешения);
	МассивСсылок.Добавить(Шапка.Решение);
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ПустаяДата",	'00010101');
	ЗапросПоиск.УстановитьПараметр("МассивСсылок",	МассивСсылок);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(МАКСИМУМ(Дата), &ПустаяДата) КАК МаксимальнаяДата
	|ИЗ
	|	(ВЫБРАТЬ
	|		Дата КАК Дата
	|	ИЗ
	|		Документ.РешениеОПроведенииИнвентаризации
	|	ГДЕ
	|		Ссылка В(&МассивСсылок)
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		Дата КАК Дата
	|	ИЗ
	|		Документ.ИзменениеРешенияОПроведенииИнвентаризации
	|	ГДЕ
	|		Ссылка В(&МассивСсылок)
	|	) КАК ВТ";
	
	Выборка = ЗапросПоиск.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ДополнительныеПараметры.Вставить("ДатаОпределенияСведенийСотрудников", Выборка.МаксимальнаяДата);
		
		Прервать;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьКолонкиДолжностьФИО(ДополнительныеПараметры)
	
	МассивКомиссий						= ДополнительныеПараметры.МассивыКомиссий.НеобходимыДолжностьФИОСтрокой;
	ТаблицаСоставыКомиссий				= ДополнительныеПараметры.СведенияКомиссий.ТаблицаСоставыКомиссий;
	ДатаОпределенияСведенийСотрудников	= ДополнительныеПараметры.ДатаОпределенияСведенийСотрудников;
	
	ИменаКолонок = ПолучитьИменаКолонокСоставаКомиссииДолжностьФИО();
	
	ТипСтрока = Новый ОписаниеТипов("Строка");
	
	ТаблицаСоставыКомиссий.Колонки.Добавить(ИменаКолонок.Должность,	ТипСтрока);
	ТаблицаСоставыКомиссий.Колонки.Добавить(ИменаКолонок.Фамилия,	ТипСтрока);
	ТаблицаСоставыКомиссий.Колонки.Добавить(ИменаКолонок.Имя,		ТипСтрока);
	ТаблицаСоставыКомиссий.Колонки.Добавить(ИменаКолонок.Отчество,	ТипСтрока);
	
	Сотрудники = Новый Массив();
	
	Поиск = Новый Структура();
	
	Для Каждого Комиссия Из МассивКомиссий Цикл
		Поиск.Вставить("Ссылка", Комиссия);
		
		МассивСтрок = ТаблицаСоставыКомиссий.НайтиСтроки(Поиск);
		
		Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
			Сотрудник = СтрокаТаблицы.Сотрудник;
			
			Если Сотрудники.Найти(Сотрудник) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Сотрудники.Добавить(Сотрудник);
		КонецЦикла;
	КонецЦикла;
	
	ТребуемыеДанные = "ДолжностьНаименование,Фамилия,Имя,Отчество";
	
	ДанныеСотрудников = Справочники.Сотрудники.ПолучитьДанныеСотрудников(Сотрудники, ТребуемыеДанные, ДатаОпределенияСведенийСотрудников);
	
	Поиск = Новый Структура();
	
	Для Каждого СтрокаТаблицы Из ТаблицаСоставыКомиссий Цикл
		Поиск.Вставить("Ссылка", СтрокаТаблицы.Сотрудник);
		
		МассивСтрок = ДанныеСотрудников.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеСотрудника = МассивСтрок[0];
		
		СтрокаТаблицы[ИменаКолонок.Должность]	= ДанныеСотрудника.ДолжностьНаименование;
		СтрокаТаблицы[ИменаКолонок.Фамилия]		= ДанныеСотрудника.Фамилия;
		СтрокаТаблицы[ИменаКолонок.Имя]			= ДанныеСотрудника.Имя;
		СтрокаТаблицы[ИменаКолонок.Отчество]	= ДанныеСотрудника.Отчество;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьИменаКолонокСоставаКомиссииДолжностьФИО()
	
	ИменаКолонок = Новый Структура();
	
	ИменаКолонок.Вставить("Должность",	"ДолжностьЧленаКомиссии");
	ИменаКолонок.Вставить("Фамилия",	"ФамилияЧленаКомиссии");
	ИменаКолонок.Вставить("Имя",		"ИмяЧленаКомиссии");
	ИменаКолонок.Вставить("Отчество",	"ОтчествоЧленаКомиссии");
	
	Возврат ИменаКолонок;
	
КонецФункции	

Процедура ОпределитьКомиссиюДляПодгруппыСтрок(Данные, Подгруппа)
	
	// Комиссию берем из первой строки подгруппы строк
	
	ТаблицаОбъекты	= Данные.ДанныеРешения.ТаблицаОбъекты;
	ТаблицаКомиссии	= Данные.ДанныеРешения.ТаблицаКомиссии;
	
	ДополнительныеПараметры = Данные.ДополнительныеПараметры;
	
	СтрокаТаблицыОбъекты = ТаблицаОбъекты[Подгруппа.НомераСтрок[0] - 1];
	
	СтрокаТаблицыКомиссии = ТаблицаКомиссии[СтрокаТаблицыОбъекты.НомерКомиссии - 1];
	
	ОтбиратьРабочиеКомиссии = Ложь;
	НомераРабочихКомиссий = Новый Массив();
	
	Если ЗначениеЗаполнено(СтрокаТаблицыОбъекты.НомерРабочейКомиссии) Тогда
		ОтбиратьРабочиеКомиссии = Истина;
		НомераРабочихКомиссий.Добавить(СтрокаТаблицыОбъекты.НомерРабочейКомиссии);
	КонецЕсли;
	
	КомиссияДляПодгруппыСтрок = Новый Структура();
	КомиссияДляПодгруппыСтрок.Вставить("КомиссияСсылка",			СтрокаТаблицыКомиссии.Комиссия);
	КомиссияДляПодгруппыСтрок.Вставить("НомерКомиссии",				СтрокаТаблицыОбъекты.НомерКомиссии);
	КомиссияДляПодгруппыСтрок.Вставить("ОтбиратьРабочиеКомиссии",	ОтбиратьРабочиеКомиссии);
	КомиссияДляПодгруппыСтрок.Вставить("НомераРабочихКомиссий",		НомераРабочихКомиссий);
	
	ДополнительныеПараметры.Вставить("КомиссияДляПодгруппыСтрок", КомиссияДляПодгруппыСтрок);
	
КонецПроцедуры

Процедура ЗаполнитьШапкуОписиПоРешению(ОбъектОписи, Данные, Подгруппа)
	
	ДанныеРешения			= Данные.ДанныеРешения;
	ДополнительныеПараметры	= Данные.ДополнительныеПараметры;
	
	ТаблицаОбъекты							= ДанныеРешения.ТаблицаОбъекты;
	ТаблицаАктыОПроведенииИнвентаризации	= ДанныеРешения.ТаблицаАктыОПроведенииИнвентаризации;
	
	НастройкиОписи = Подгруппа.НастройкиОписи;
	
	Шапка = Новый Структура();
	
	// Реквизиты, присутствующие независимо от заполненности раздела 1
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		Шапка.Вставить("ИФО", ДанныеРешения.Шапка.ИФО);
	КонецЕсли;
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
		Шапка.Вставить("Подразделение", ДанныеРешения.Шапка.Подразделение);
	КонецЕсли;
	
	// Основание проведения инвентаризации
	
	ОснованиеПроведенияИнвентаризации = ДанныеРешения.Шапка.ОснованиеПроведенияИнвентаризации;
	
	Шапка.Вставить("ОснованиеПроведенияИнвентаризации", ОснованиеПроведенияИнвентаризации);
	
	Если ЗначениеЗаполнено(ОснованиеПроведенияИнвентаризации) Тогда
		НаименованиеПолное = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОснованиеПроведенияИнвентаризации, "НаименованиеПолное");
		
		Шапка.Вставить("ПричинаИнвентаризации", НаименованиеПолное);
	КонецЕсли;
	
	// Комиссия (ссылка)
	
	КомиссияСсылка = ДополнительныеПараметры.КомиссияДляПодгруппыСтрок.КомиссияСсылка;
	
	Если НастройкиОписи.КомиссияУказываетсяСсылкой Тогда
		Шапка.Вставить("Комиссия",		КомиссияСсылка);
		Шапка.Вставить("НомерКомиссии",	ДополнительныеПараметры.КомиссияДляПодгруппыСтрок.НомерКомиссии);
		
		НомерРабочейКомиссии = 0;
		
		НомераРабочихКомиссий = ДополнительныеПараметры.КомиссияДляПодгруппыСтрок.НомераРабочихКомиссий;
		
		Если НомераРабочихКомиссий.Количество() > 0 Тогда
			НомерРабочейКомиссии = НомераРабочихКомиссий[0];
		КонецЕсли;
		
		Шапка.Вставить("НомерРабочейКомиссии", НомерРабочейКомиссии);
	КонецЕсли;
	
	// Приказ о проведении инвентаризации
	
	РешениеСсылка = Данные.ДанныеРешения.Шапка.Решение;
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РешениеСсылка, "Номер,Дата");
	
	Шапка.Вставить("ДатаПриказаИнвентаризации",		ЗначенияРеквизитов.Дата);
	Шапка.Вставить("НомерПриказаИнвентаризации",	РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоИмениДокумента(РешениеСсылка.Метаданные().Имя, ЗначенияРеквизитов.Номер));
	
	Если Подгруппа.НомераСтрок.Количество() = 0 Тогда
		ЗаполнитьЗначенияСвойств(ОбъектОписи, Шапка);
		
		Возврат;
	КонецЕсли;
	
	// Реквизиты из первой строки раздела 1
	
	ПерваяСтрокаРешения = ТаблицаОбъекты[Подгруппа.НомераСтрок[0] - 1];
	
	// КФО
	
	Шапка.Вставить("КФО", ПерваяСтрокаРешения.КФО);
	
	// Даты
	
	Шапка.Вставить("ДатаИнвентаризации", ПерваяСтрокаРешения.ДатаИнвентаризации);
	Шапка.Вставить("ДатаНачала",		 ПерваяСтрокаРешения.ДатаНачала);
	Шапка.Вставить("ДатаОкончания",		 ПерваяСтрокаРешения.ДатаОкончания);
	
	// Сотрудник
	
	ИмяРеквизитаМОЛ = НастройкиОписи.ИмяРеквизитаМОЛ;
	
	Если ЗначениеЗаполнено(ИмяРеквизитаМОЛ) Тогда
		Сотрудник = ПерваяСтрокаРешения.Сотрудник;
		
		ЗаменитьСотрудникаНаЦМОИлиКонтрагентаДляОписи52н(Сотрудник, Подгруппа);
		
		Шапка.Вставить(ИмяРеквизитаМОЛ, Сотрудник);
	КонецЕсли;
	
	// Счет
	
	ОписаниеРеквизита = ДиагностироватьОписаниеРеквизитаОписи(НастройкиОписи.ИмяРеквизитаСчет);
	
	Если ОписаниеРеквизита.РасположенВШапке Тогда
		Счет = Подгруппа.ПоляГруппировок.Счет;
		
		Шапка.Вставить(ОписаниеРеквизита.ИмяПоля, Счет);
	КонецЕсли;
	
	// Акты о составе комиссии
	
	Если ЗначениеЗаполнено(КомиссияСсылка) Тогда
		ТаблицаПриказыКомиссий = ДополнительныеПараметры.СведенияКомиссий.ТаблицаПриказыКомиссий;
		
		Поиск = Новый Структура("Ссылка", КомиссияСсылка);
		
		МассивСтрок = ТаблицаПриказыКомиссий.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() > 0 Тогда
			ПриказКомиссии = МассивСтрок[0];
			
			Шапка.Вставить("ДатаПриказаКомиссии",	ПриказКомиссии.ДатаПриказа);
			Шапка.Вставить("НомерПриказаКомиссии",	ПриказКомиссии.НомерПриказа);
		КонецЕсли;
	КонецЕсли;
	
	// Председатель комиссии
	
	Если Не НастройкиОписи.КомиссияУказываетсяСсылкой Тогда
		ТаблицаСоставыКомиссий = ДополнительныеПараметры.СведенияКомиссий.ТаблицаСоставыКомиссий;
		
		Поиск = Новый Структура();
		Поиск.Вставить("Ссылка", КомиссияСсылка);
		Поиск.Вставить("Председатель", Истина);
		
		МассивСтрок = ТаблицаСоставыКомиссий.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() > 0 Тогда
			Сотрудник = МассивСтрок[0].Сотрудник;
			
			Поиск = Новый Структура("Ссылка", Сотрудник);
			
			Если МассивСтрок.Количество() > 0 Тогда
				СтрокаТаблицы = МассивСтрок[0];
				
				ИменаКолонок = ПолучитьИменаКолонокСоставаКомиссииДолжностьФИО();
				
				Шапка.Вставить("ДолжностьПредседателяКомиссии", СтрокаТаблицы[ИменаКолонок.Должность]);
				Шапка.Вставить("ФамилияПредседателяКомиссии",	СтрокаТаблицы[ИменаКолонок.Фамилия]);
				Шапка.Вставить("ИмяПредседателяКомиссии",		СтрокаТаблицы[ИменаКолонок.Имя]);
				Шапка.Вставить("ОтчествоПредседателяКомиссии",	СтрокаТаблицы[ИменаКолонок.Отчество]);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// Место проведения инвентаризации
	
	ИмяРеквизитаПоУмолчанию = "МестоИнвентаризации";
	
	ОписаниеРеквизита = ДиагностироватьОписаниеРеквизитаОписи(НастройкиОписи.ИмяРеквизитаМестоИнвентаризации, ИмяРеквизитаПоУмолчанию);
	
	Если ОписаниеРеквизита.РасположенВШапке Тогда
		Шапка.Вставить(ИмяРеквизитаПоУмолчанию, ПерваяСтрокаРешения.МестоИнвентаризации);
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ОбъектОписи, Шапка);
	
КонецПроцедуры

Процедура ЗаполнитьСоставКомиссииОписиПоРешению(ОбъектОписи, Данные, Подгруппа)
	
	ДанныеРешения			= Данные.ДанныеРешения;
	ДополнительныеПараметры	= Данные.ДополнительныеПараметры;
	
	ТаблицаСоставыКомиссий = ДополнительныеПараметры.СведенияКомиссий.ТаблицаСоставыКомиссий;
	
	НастройкиОписи = Подгруппа.НастройкиОписи;
	
	КомиссияСсылка			= ДополнительныеПараметры.КомиссияДляПодгруппыСтрок.КомиссияСсылка;
	НомераРабочихКомиссий	= ДополнительныеПараметры.КомиссияДляПодгруппыСтрок.НомераРабочихКомиссий;
	ОтбиратьРабочиеКомиссии	= ДополнительныеПараметры.КомиссияДляПодгруппыСтрок.ОтбиратьРабочиеКомиссии;
	
	Поиск = Новый Структура("Ссылка", КомиссияСсылка);
	
	МассивСтрок = ТаблицаСоставыКомиссий.НайтиСтроки(Поиск);
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ОбъектОписи, "СоставКомиссии") Тогда
		ТабличныеЧастиСоставаКомиссии = Новый Массив();
		ТабличныеЧастиСоставаКомиссии.Добавить("СоставКомиссии");
	Иначе
		СтрокаНастроек = ПолучитьСтрокуТаблицыНастроекОписей61нПоОписи(ОбъектОписи.Ссылка);
		
		ТабличныеЧастиСоставаКомиссии = СтрокаНастроек.ТабличныеЧастиСоставаКомиссии;
	КонецЕсли;
	
	Для Каждого ИмяТЧ Из ТабличныеЧастиСоставаКомиссии Цикл
		ТабЧасть = ОбъектОписи[ИмяТЧ];
		
		ТабЧасть.Очистить();
		
		Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
			Если СтрокаТаблицы.Председатель И Не НастройкиОписи.КомиссияУказываетсяСсылкой Тогда
				// Не указываем председателя в общем составе комиссии,
				// для него предусмотрены отдельные реквизиты в документе описи
				Продолжить;
			КонецЕсли;
			
			Если ОтбиратьРабочиеКомиссии И НомераРабочихКомиссий.Найти(СтрокаТаблицы.НомерРабочейКомиссии) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ТабЧасть.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьОтборСчетовОписиПоРешению(ОбъектОписи, Данные, Подгруппа)
	
	Если Подгруппа.НомераСтрок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеРешения			= Данные.ДанныеРешения;
	ДополнительныеПараметры	= Данные.ДополнительныеПараметры;
	
	ТаблицаОбъекты = ДанныеРешения.ТаблицаОбъекты;
	
	НастройкиОписи = Подгруппа.НастройкиОписи;
	
	ОписаниеРеквизитаСчет = ДиагностироватьОписаниеРеквизитаОписи(НастройкиОписи.ИмяРеквизитаСчет);
	
	Если Не ОписаниеРеквизитаСчет.РасположенВТабличнойЧасти Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеРеквизитаКФО = ДиагностироватьОписаниеРеквизитаОписи(НастройкиОписи.ИмяРеквизитаКФО);
	
	// Счет (в табличной части настроек заполнения описи)
	
	ТаблицаСчетов = ТаблицаОбъекты.СкопироватьКолонки("Счет,КФО");
	
	Для Каждого НомерСтроки Из Подгруппа.НомераСтрок Цикл
		СтрокаТаблицыОбъекты = ТаблицаОбъекты[НомерСтроки - 1];
		
		НоваяСтрока = ТаблицаСчетов.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицыОбъекты);
	КонецЦикла;
	
	ТаблицаСчетов.Свернуть("Счет,КФО");
	
	ИмяКолонкиПризнакИспользования = ОписаниеРеквизитаСчет.ИмяКолонкиПризнакИспользования;
	
	ИспользуетсяКолонкаПризнак = ЗначениеЗаполнено(ИмяКолонкиПризнакИспользования);
	
	ТабЧасть = ОбъектОписи[ОписаниеРеквизитаСчет.ИмяТабличнойЧасти];
	
	ТабЧасть.Очистить();
	
	Для Каждого СтрокаТаблицы Из ТаблицаСчетов Цикл
		НоваяСтрока = ТабЧасть.Добавить();
		
		НоваяСтрока[ОписаниеРеквизитаСчет.ИмяКолонки] = СтрокаТаблицы.Счет;
		
		Если ИспользуетсяКолонкаПризнак Тогда
			НоваяСтрока[ИмяКолонкиПризнакИспользования] = Истина;
		КонецЕсли;
		
		Если ОписаниеРеквизитаКФО.РасположенВТабличнойЧасти Тогда
			НоваяСтрока[ОписаниеРеквизитаКФО.ИмяКолонки] = СтрокаТаблицы.КФО;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСписокМестИнвентаризацииОписиПоРешению(ОбъектОписи, Данные, Подгруппа)
	
	Если Подгруппа.НомераСтрок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеРешения			= Данные.ДанныеРешения;
	ДополнительныеПараметры	= Данные.ДополнительныеПараметры;
	
	ТаблицаОбъекты = ДанныеРешения.ТаблицаОбъекты;
	
	НастройкиОписи = Подгруппа.НастройкиОписи;
	
	ОписаниеРеквизита = ДиагностироватьОписаниеРеквизитаОписи(НастройкиОписи.ИмяРеквизитаМестоИнвентаризации);
	
	Если Не ОписаниеРеквизита.РасположенВТабличнойЧасти Тогда
		Возврат;
	КонецЕсли;
	
	// Список мест инвентаризации (в табличной части настроек заполнения описи)
	
	ТаблицаМестИнвентаризации = ТаблицаОбъекты.СкопироватьКолонки("МестоИнвентаризации");
	
	Для Каждого НомерСтроки Из Подгруппа.НомераСтрок Цикл
		СтрокаТаблицыОбъекты = ТаблицаОбъекты[НомерСтроки - 1];
		
		НоваяСтрока = ТаблицаМестИнвентаризации.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицыОбъекты);
	КонецЦикла;
	
