	Возврат ТабДокумент;
	
КонецФункции

Процедура Печать0504087_194н_ОбработатьНастройкиВывода(НастройкиВывода = Неопределено)
	
	Перем ЗначениеПараметра;
	
	Если НастройкиВывода = Неопределено Тогда
		НастройкиВывода = Новый Структура();
	КонецЕсли;
	
	ИмяПараметра = "КоличествоЗнаковПослеЗапятойДляКоличества";
	ЗначениеПоУмолчанию = 3;
	Если НЕ НастройкиВывода.Свойство(ИмяПараметра, ЗначениеПараметра) Тогда
		НастройкиВывода.Вставить(ИмяПараметра, ЗначениеПоУмолчанию);
	КонецЕсли;
	
КонецПроцедуры

Функция Печать0504087_194н_ПолучитьПолныйНомерСчета(ВыборкаШапка, Выборка);
	
	Если ВыборкаШапка["ВариантФормированияОписи"] = 1 Тогда
		// 1. Опись с 2018 г. Счет в таблице (26 знаков)
		
		Если ЗначениеЗаполнено(Выборка["КПС"]) Тогда
			КПС = Выборка["КПС"] + ".";
			
			КЭК = ".000";
		Иначе
			КПС = "";
			
			КЭК = "";
		КонецЕсли;
		
		Возврат КПС + Выборка["КФО"] + "." + Выборка["Счет"] + КЭК;
		
	Иначе
		// 2. Опись с 2018 г. Счет в таблице (5 знаков)
		// 3. Опись с 2018 г. Счет в таблице (5 знаков). Одна строка - один объект
		
		Возврат Выборка["Счет"];
		
	КонецЕсли;
	
КонецФункции

Процедура Печать0504087_194н_ФорматироватьГрафыКоличества(ЗначенияПараметров, Выборка, КоличествоЗнаковПослеЗапятойДляКоличества)
	
	// Повторяем формат для ячеек показателей количества из макета, но с уточнением точности
	ФорматнаяСтрока = СтрШаблон(НСтр("ru='ЧЦ=15; ЧДЦ=%1; ЧН=—'"), КоличествоЗнаковПослеЗапятойДляКоличества);
	
	ЗначенияПараметров.Вставить("КоличествоБ",	Формат(Выборка["КоличествоБ"], ФорматнаяСтрока));
	ЗначенияПараметров.Вставить("КоличествоФ",	Формат(Выборка["КоличествоФ"], ФорматнаяСтрока));
	ЗначенияПараметров.Вставить("КоличествоН",	Формат(Выборка["КоличествоН"], ФорматнаяСтрока));
	ЗначенияПараметров.Вставить("КоличествоИ",	Формат(Выборка["КоличествоИ"], ФорматнаяСтрока));
	ЗначенияПараметров.Вставить("КоличествоНА",	Формат(Выборка["КоличествоНА"], ФорматнаяСтрока));
	
КонецПроцедуры

Процедура Печать0504087_194н_ИнициализироватьИтоги(Итоги)
	
	Итоги = Новый Структура();
	
	Итоги.Вставить("СуммаБ",	0);
	Итоги.Вставить("СуммаФ",	0);
	Итоги.Вставить("СуммаН",	0);
	Итоги.Вставить("СуммаИ",	0);
	Итоги.Вставить("СуммаНА",	0);
	
	Итоги.Вставить("КоличествоБ",	0);
	Итоги.Вставить("КоличествоФ",	0);
	Итоги.Вставить("КоличествоН",	0);
	Итоги.Вставить("КоличествоИ",	0);
	Итоги.Вставить("КоличествоНА",	0);
	
КонецПроцедуры

Процедура Печать0504087_194н_ЗаполнитьИтоги(ОбластьИтогоЧислами, ОбластьИтогоПрописью, Итоги, ДополнительныеПараметры)
	
	//
	// Итоги числами
	//
	
	Если ОбластьИтогоЧислами <> Неопределено Тогда
		
		ЗначенияПараметров = Новый Структура();
		
		Если ДополнительныеПараметры.КоличествоЗнаковПослеЗапятойДляКоличества <> 3 Тогда
			// Отличается от значения по умолчанию
			
			Печать0504087_194н_ФорматироватьГрафыКоличества(
				ЗначенияПараметров,
				Итоги,
				ДополнительныеПараметры.КоличествоЗнаковПослеЗапятойДляКоличества);
				
		КонецЕсли;
		
		Если НЕ ДополнительныеПараметры.ВыводитьФактическоеНаличие Тогда
			
			// Исключаем вывод символа прочерка "-" в показателях фактического наличия
			// путем указания пустой строки
			
			ЗначенияПараметров.Вставить("КоличествоФ", "");
			ЗначенияПараметров.Вставить("СуммаФ", "");
			
		КонецЕсли;
		
		ОбластьИтогоЧислами.Параметры.Заполнить(Итоги);
		
		ОбластьИтогоЧислами.Параметры.Заполнить(ЗначенияПараметров);
		
		Если НЕ ДополнительныеПараметры.ВыводитьФактическоеНаличие Тогда
			
			ОбластьИтогоЧислами.Параметры.Заполнить(ДополнительныеПараметры.ОчищающаяСтруктураФактическогоНаличия);
			
		КонецЕсли;
		
	КонецЕсли;
	
	//
	// Итоги прописью
	//
	
	Если ОбластьИтогоПрописью <> Неопределено Тогда
		
		КоличествоПорядковыхНомеровПрописью = ЧислоПрописью(Итоги.КоличествоПорядковыхНомеров,, ",,,,,,,,0");
		
		Если ДополнительныеПараметры.ВыводитьФактическоеНаличие Тогда
			
			Если ДополнительныеПараметры.КоличествоЗнаковПослеЗапятойДляКоличества = 0 Тогда
				
				ПараметрыПредметаИсчисления = ",,,,,,,,0";
				
			Иначе
				
				ПараметрыПредметаИсчисления = "целая,целых,целых,ж,тысячная,тысячные,тысячных,ж," + ДополнительныеПараметры.КоличествоЗнаковПослеЗапятойДляКоличества;
				
			КонецЕсли;
			
			КоличествоЕдиницПрописью = ЧислоПрописью(Итоги["КоличествоФ"],, ПараметрыПредметаИсчисления);
			
			СуммаПрописью = ЧислоПрописью(Итоги["СуммаФ"],, "рубль,рубля,рублей,м,копейка,копейки,копеек,ж,2");
			
		Иначе
			
			КоличествоЕдиницПрописью = "";
			
			СуммаПрописью = "";
			
		КонецЕсли;
										
		ЗначенияПараметров = Новый Структура();
		ЗначенияПараметров.Вставить("КоличествоНомеровПрописью",	КоличествоПорядковыхНомеровПрописью);
		ЗначенияПараметров.Вставить("КоличествоЕдиницПрописью",		КоличествоЕдиницПрописью);
		ЗначенияПараметров.Вставить("СуммаПрописью",				СуммаПрописью);
		
		ОбластьИтогоПрописью.Параметры.Заполнить(ЗначенияПараметров);
		
	КонецЕсли;
	
КонецПроцедуры

#Область ОбработчикиСобытийПечатиТаблицы_0504087_194н

Процедура РассчитатьИтогиПоТаблице_0504087(Итоги, Выборка, СтатистикаВывода, ДополнительныеПараметры) Экспорт
	
	Печать0504087_194н_ИнициализироватьИтоги(Итоги);
	
	ЗаполнитьЗначенияСвойств(Итоги, Выборка);
	
	Итоги.Вставить("КоличествоПорядковыхНомеров", СтатистикаВывода.КоличествоСтрок);
	
КонецПроцедуры

Процедура ЗаполнитьОбластьСтрокаТаблицы_0504087(ОбластьСтрокаТаблицы, Выборка, СтатистикаВывода, ДополнительныеПараметры) Экспорт
	
	ЗначенияПараметров = Новый Структура();
	
	ЗначенияПараметров.Вставить("Счет",
		Печать0504087_194н_ПолучитьПолныйНомерСчета(
			ДополнительныеПараметры.ВыборкаШапка,
			Выборка));
	
	Если ДополнительныеПараметры.ЭтоИнвентаризация11140 Тогда
		
		ЗначенияПараметров.Вставить("НаименованиеНФА", Выборка.НаименованиеНФА + " - " + Выборка.ДоговорНаименование);
		
	КонецЕсли;
	
	Если ДополнительныеПараметры.КоличествоЗнаковПослеЗапятойДляКоличества <> 3 Тогда
		// Отличается от значения по умолчанию
		
		Печать0504087_194н_ФорматироватьГрафыКоличества(
			ЗначенияПараметров,
			Выборка,
			ДополнительныеПараметры.КоличествоЗнаковПослеЗапятойДляКоличества);
			
	КонецЕсли;
	
	ЗначенияПараметров.Вставить("НаименованиеНФА",	ПолучитьНаименованиеНФА(Выборка, ДополнительныеПараметры));
	ЗначенияПараметров.Вставить("КодНФА",			ПолучитьКодНФА(Выборка, ДополнительныеПараметры));
	
	ОбластьСтрокаТаблицы.Параметры.Заполнить(Выборка);
	
	Если ДополнительныеПараметры.ВыводитьФактическоеНаличие Тогда
		Если Не ЗначениеЗаполнено(Выборка.Примечание) Тогда
			ЗначенияПараметров.Вставить("Примечание", НСтр("ru='—'"));
		КонецЕсли;
	КонецЕсли;
	
	ОбластьСтрокаТаблицы.Параметры.Заполнить(ЗначенияПараметров);
	
	Если НЕ ДополнительныеПараметры.ВыводитьФактическоеНаличие Тогда
		
		ОбластьСтрокаТаблицы.Параметры.Заполнить(ДополнительныеПараметры.ОчищающаяСтруктураФактическогоНаличия);
		
	КонецЕсли;
	
КонецПроцедуры

