	НоваяСтрока.ТипДокумента = Тип("ДокументСсылка.УдалитьИнвентаризационнаяОписьРасчетовПоПоступлениям");
	НоваяСтрока.НаименованиеОписи = НСтр("ru='Инвентаризационная опись расчетов по поступлениям'");
	НоваяСтрока.СодержаниеРасписки = НСтр("ru='К началу проведения инвентаризации все поступления денежных средств подтверждены банковскими выписками, и выписками из лицевых счетов.'");
	НоваяСтрока.ИмяРеквизитаСотрудникДляРасписки = "ОтветственныйИсполнительБухгалтерскойСлужбы";
	НоваяСтрока.НаименованиеПодписиДляРасписки = НСтр("ru='Ответственное лицо'");
	
	ЗаполнитьСведенияИзМетаданныхДокументовОписей61н(ТаблицаНастроек);
	
	Возврат ТаблицаНастроек;
	
КонецФункции

Функция ПолучитьИменаДокументовОписей61н(Знач ТаблицаНастроек, Знач ОтборМассивОписей = Неопределено) Экспорт
	
	Перем ТипыОписей;
	
	Если ТипЗнч(ОтборМассивОписей) = Тип("Массив") Тогда
		ВремТаблица = Новый ТаблицаЗначений();
		ВремТаблица.Колонки.Добавить("ТипОписи");
		
		Для Каждого ОписьСсылка Из ОтборМассивОписей Цикл
			НоваяСтрока = ВремТаблица.Добавить();
			НоваяСтрока.ТипОписи = ТипЗнч(ОписьСсылка);
		КонецЦикла;
		
		ВремТаблица.Свернуть("ТипОписи");
		
		ТипыОписей = ВремТаблица.ВыгрузитьКолонку("ТипОписи");
	КонецЕсли;
	
	ИменаДокументов = Новый Массив();
	
	Для Каждого СтрокаТаблицы Из ТаблицаНастроек Цикл
		Если ТипыОписей <> Неопределено И ТипыОписей.Найти(СтрокаТаблицы.ТипДокумента) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяДокумента = СтрокаТаблицы.ИмяДокумента;
		
		Если ЗначениеЗаполнено(ИмяДокумента) Тогда
			ИменаДокументов.Добавить(ИмяДокумента);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ИменаДокументов;
	
КонецФункции

Функция ПолучитьСтрокуТаблицыНастроекОписей61нПоОписи(ОписьСсылка, ТаблицаНастроек = Неопределено) Экспорт
	
	Если ТаблицаНастроек = Неопределено Тогда
		ТаблицаНастроек = ИнвентаризацияСервер.ПолучитьТаблицуНастроекОписей61н();
	КонецЕсли;
	
	Поиск = Новый Структура("ТипДокумента", ТипЗнч(ОписьСсылка));
	
	МассивСтрок = ТаблицаНастроек.НайтиСтроки(Поиск);
	
	Если МассивСтрок.Количество() = 0 Тогда
		ВремТаблица = ТаблицаНастроек.СкопироватьКолонки();
		
		СтрокаТаблицы = ВремТаблица.Добавить();
	Иначе
		СтрокаТаблицы = МассивСтрок[0];
	КонецЕсли;
	
	Возврат ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(СтрокаТаблицы);
	
КонецФункции

Функция ПолучитьСтрокуТаблицыНастроекОписей61нПоКодуФормыОписи(КодФормыОписи, ТаблицаНастроек = Неопределено) Экспорт
	
	Если ТаблицаНастроек = Неопределено Тогда
		ТаблицаНастроек = ИнвентаризацияСервер.ПолучитьТаблицуНастроекОписей61н();
	КонецЕсли;
	
	Поиск = Новый Структура("КодФормы", КодФормыОписи);
	
	МассивСтрок = ТаблицаНастроек.НайтиСтроки(Поиск);
	
	Если МассивСтрок.Количество() = 0 Тогда
		ВремТаблица = ТаблицаНастроек.СкопироватьКолонки();
		
		НоваяСтрока = ВремТаблица.Добавить();
		
		Возврат НоваяСтрока;
	КонецЕсли;
	
	Возврат ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(МассивСтрок[0]);
	
КонецФункции

Функция ПолучитьОграничениеРазмераДокументаОписи(ОписьСсылка, Организация) Экспорт
	
	Если Не ЗначениеЗаполнено(ОписьСсылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЗначенияПоУмолчанию = ПолучитьТаблицуНастроекОграниченияРазмераДокументовИнвентаризации();
	
	Поиск = Новый Структура("ТипОписи", ТипЗнч(ОписьСсылка));
	
	МассивСтрок = ЗначенияПоУмолчанию.НайтиСтроки(Поиск);
	
	Если МассивСтрок.Количество() = 0 Тогда
		// Для такой описи не предусмотрено ограничение на размер документа (серии документов).
		Возврат Неопределено;
	КонецЕсли;
	
	КоличествоПоУмолчанию = МассивСтрок[0].КоличествоСтрок;
	
	Возврат КоличествоПоУмолчанию;
	
КонецФункции

#КонецОбласти

#Область НастройкаФормДокументов

Процедура ДобавитьУсловноеОформлениеСоставКомиссииПричинаОтсутствия(ФормаДокумента, ИмяТаблицыСоставКомиссии = "СоставКомиссии") Экспорт
	
	УсловноеОформление = ФормаДокумента.УсловноеОформление;
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = СтрШаблон(НСтр("ru='Сброс отметки незаполненного колонки %1.ПричинаОтсутствия'"), ИмяТаблицыСоставКомиссии);
	
	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(СтрШаблон("Объект.%1.Отсутствует", ИмяТаблицыСоставКомиссии));
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Ложь;
	
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(СтрШаблон("Объект.%1.ПричинаОтсутствия", ИмяТаблицыСоставКомиссии));
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	
	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(СтрШаблон("%1ПричинаОтсутствия", ИмяТаблицыСоставКомиссии));
	
