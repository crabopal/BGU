#Область ТекстыЗапросов

Процедура ДобавитьИндексыТаблиц(НомераТаблиц, Подзапросы, ПрефиксИмениТаблиц = "") Экспорт
	
	Для Каждого Элемент Из Подзапросы Цикл
		ИмяТаблицы = Элемент.Ключ;
		ИндексТаблицы = Элемент.Значение;
		
		ИндексПодзапроса = НомераТаблиц.ПоследнийДобавленныйИндекс + 1 + ИндексТаблицы;
		
		НомераТаблиц.Вставить(ПрефиксИмениТаблиц + ИмяТаблицы, ИндексПодзапроса);
	КонецЦикла;
	
	НомераТаблиц.ПоследнийДобавленныйИндекс = ИндексПодзапроса;
	
КонецПроцедуры

Процедура УпорядочитьИндексыПодзапросов(ТекстЗапроса) Экспорт
	
	МаксимальнаяДлинаИндекса = 3; // в символах строки
	
	НачалоПоиска = "// [";
	ОкончаниеПоиска = "].";
	
	ДлинаНачалаПоиска = СтрДлина(НачалоПоиска);
	ДлинаОкончанияПоиска = СтрДлина(ОкончаниеПоиска);
	
	ТекущийИндекс = 0;
	
	Пока Истина Цикл
		ПозицияНачалаПоиска = СтрНайти(ТекстЗапроса, НачалоПоиска,,, ТекущийИндекс + 1);
		
		Если ПозицияНачалаПоиска = 0 Тогда
			// Завершились искомые символы
			Прервать;
		КонецЕсли;
		
		ПозицияОкончанияПоиска = СтрНайти(ТекстЗапроса, ОкончаниеПоиска,, ПозицияНачалаПоиска);
		
		Если ПозицияОкончанияПоиска = 0 Тогда
			// Ошибка форматирования исходной строки
			Прервать;
		КонецЕсли;
		
		ПозицияНачалаИндекса = ПозицияНачалаПоиска + ДлинаНачалаПоиска;
		ПозицияОкончанияИндекса = ПозицияОкончанияПоиска - 1;
		
		ДлинаИндекса = ПозицияОкончанияИндекса - ПозицияНачалаИндекса + 1;
		
		Если ДлинаИндекса > МаксимальнаяДлинаИндекса Тогда
			// Ошибка форматирования исходной строки
			Прервать;
		КонецЕсли;
		
		ТекстИндекса = Сред(ТекстЗапроса, ПозицияНачалаИндекса, ДлинаИндекса);
		
		Если Не ОбщегоНазначенияКлиентСервер.ЭтоЧисло(ТекстИндекса) Тогда
			// Ошибка форматирования исходной строки
			Прервать;
		КонецЕсли;
		
		ТекстЗапроса = Лев(ТекстЗапроса, ПозицияНачалаИндекса - 1) + Формат(ТекущийИндекс, "ЧГ=;ЧН=") + Сред(ТекстЗапроса, ПозицияОкончанияИндекса + 1);
		
		ТекущийИндекс = ТекущийИндекс + 1;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбновлениеТабличныхЧастейИтоговБезСортировки

// Сохраняет состав и порядок строк табличной части, обновляя значения числовых показателей в существующих строках.
// Считается, что табличная часть уже свернута по указанным колонкам группировки.
// Если в табличной части состав строк отличается от свернутой таблицы (нет строк по аналитике колонок группировки,
// или есть строки по некоторым иным аналитикам колонок группировки), то табличная часть просто заполняется свернутой таблицей.
Процедура ОбновитьТабличнуюЧастьИтоговБезСортировки(ТабличнаяЧасть, СвернутаяТаблица, КолонкиГруппировки, КолонкиСуммирования) Экспорт
	
	Поиск = Новый Структура(КолонкиГруппировки);
	
	НайденныеИндексыСтрокТЧ = Новый Соответствие();
	
	РазличныйСоставСтрок = Ложь;
	
	Для Каждого СтрокаСвернутойТаблицы Из СвернутаяТаблица Цикл
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаСвернутойТаблицы);
		
		МассивСтрок = ТабличнаяЧасть.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() = 0 Или МассивСтрок.Количество() > 1 Тогда
			РазличныйСоставСтрок = Истина;
			Прервать;
			
		ИначеЕсли МассивСтрок.Количество() = 1 Тогда
			СтрокаТЧ = МассивСтрок[0];
			
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, СтрокаСвернутойТаблицы);
			
			НайденныеИндексыСтрокТЧ.Вставить(ТабличнаяЧасть.Индекс(СтрокаТЧ), Истина);
		КонецЕсли;
	КонецЦикла;
	
	Если НайденныеИндексыСтрокТЧ.Количество() <> ТабличнаяЧасть.Количество() Тогда
		РазличныйСоставСтрок = Истина;
	КонецЕсли;
	
	Если РазличныйСоставСтрок Тогда
		ТабличнаяЧасть.Загрузить(СвернутаяТаблица);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

