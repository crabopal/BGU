	ТабЧасть = ОбъектОписи[ОписаниеРеквизита.ИмяТабличнойЧасти];
	
	ТабЧасть.Очистить();
	
	Для Каждого СтрокаТаблицы Из ТаблицаМестИнвентаризации Цикл
		НоваяСтрока = ТабЧасть.Добавить();
		
		НоваяСтрока[ОписаниеРеквизита.ИмяКолонки] = СтрокаТаблицы.МестоИнвентаризации;
