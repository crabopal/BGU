	ИнвентаризацияСервер.ДобавитьОписаниеБлокаСтрок(БлокиСтрок, , ДлиныСтрок.ЗаключениеДлинаСтроки2, "ПодвалЗаключениеСтрока2");
	
	МинимальноеКоличествоСтрок = 3;
	
