	//
	// 1. Нулевая строка при отсутствии выявленных отклонений по описи в целом
	//
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = СтрШаблон(НСтр("ru='Нулевая строка при отсутствии выявленных отклонений по описи в целом (%1)'"), ИмяТабличнойЧасти);
	
	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
