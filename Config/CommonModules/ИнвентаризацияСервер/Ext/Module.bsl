#Область ЗаполнениеДокументовОписей

Функция ПрочитатьСведенияКомиссийДляГрупповогоФормированияОписей(РешениеСсылка, ПризнакиРешения)
	
	ДокументСсылка = ?(ЗначениеЗаполнено(ПризнакиРешения.ПоследнееИзменение),
		ПризнакиРешения.ПоследнееИзменение,
		РешениеСсылка);
		
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ДокументСсылка", ДокументСсылка);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Список комиссий документа (подготовка).
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НомерСтроки		КАК НомерСтроки,
	|	Комиссия		КАК Комиссия
	|ПОМЕСТИТЬ
	|	СписокКомиссийДокумента
	|ИЗ
	|	Документ.РешениеОПроведенииИнвентаризации.Комиссии
	|ГДЕ
	|	Ссылка = &ДокументСсылка
	|	
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	НомерСтроки		КАК НомерСтроки,
	|	Комиссия		КАК Комиссия
	|ИЗ
	|	Документ.ИзменениеРешенияОПроведенииИнвентаризации.Комиссии
	|ГДЕ
	|	Ссылка = &ДокументСсылка
	|	И НЕ ТипИзменения = ЗНАЧЕНИЕ(Перечисление.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Отмена)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Список комиссий документа.
	|//
	|ВЫБРАТЬ
	|	НомерСтроки		КАК НомерСтроки,
	|	Комиссия		КАК Комиссия
	|ИЗ
	|	СписокКомиссийДокумента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Составы комиссий.
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СписокКомиссийДокумента.Комиссия			КАК Комиссия,
	|	ТЧСоставКомиссии.Сотрудник					КАК Сотрудник,
	|	ТЧСоставКомиссии.НомерРабочейКомиссии		КАК НомерРабочейКомиссии,
	|	ТЧСоставКомиссии.СтатусЧленаКомиссии		КАК СтатусЧленаКомиссии,
	|	ТЧСоставКомиссии.ОтветственныйИсполнитель	КАК ОтветственныйИсполнитель
	|ИЗ
	|	Справочник.ПостоянноДействующиеКомиссии КАК СправочникКомиссии
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПостоянноДействующиеКомиссии.СоставКомиссии КАК ТЧСоставКомиссии
	|		ПО СправочникКомиссии.Ссылка = ТЧСоставКомиссии.Ссылка
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ СписокКомиссийДокумента
	|		ПО СправочникКомиссии.Ссылка = СписокКомиссийДокумента.Комиссия";
	
	РезультатыЗапроса = ЗапросПоиск.ВыполнитьПакет();
	
	// [1]. Список комиссий документа.
	СписокКомиссий = РезультатыЗапроса[1].Выгрузить();
	
	// [2]. Составы комиссий.
	СоставыКомиссий = РезультатыЗапроса[2].Выгрузить();
	
	СведенияКомиссий = Новый Структура();
	СведенияКомиссий.Вставить("СписокКомиссий", СписокКомиссий);
	СведенияКомиссий.Вставить("СоставыКомиссий", СоставыКомиссий);
	
	Возврат СведенияКомиссий;
	
КонецФункции

Функция ПолучитьОбщееКоличествоДокументовДляГрупповогоФормированияОписей(ВсеИндексыСтрок)
	
	ОбщееКоличествоДокументов = 0;
	
	Для Каждого Элемент Из ВсеИндексыСтрок Цикл
		МассивыИндексовСтрок = Элемент.Значение;
		
		ОбщееКоличествоДокументов = ОбщееКоличествоДокументов + МассивыИндексовСтрок.Количество();
	КонецЦикла;
	
	Возврат ОбщееКоличествоДокументов;
	
КонецФункции

Функция НовыйСчетчикДокументовДляГрупповогоФормированияОписей()
	
	СчетчикДокументов = Новый Структура();
	
	СчетчикДокументов.Вставить("Счетчик", 0);
	СчетчикДокументов.Вставить("Количество", 0);
	СчетчикДокументов.Вставить("Успех", 0);
	СчетчикДокументов.Вставить("Ошибка", 0);
	
	Возврат СчетчикДокументов;
	
КонецФункции

Функция ПолучитьОбщиеРеквизитыШапкиДляГрупповогоФормированияОписей(РешениеСсылка)
	
	ИменаРеквизитов = "Организация";
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
		ИменаРеквизитов = ИменаРеквизитов + ",Подразделение";
	КонецЕсли;
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		ИменаРеквизитов = ИменаРеквизитов + ",ИФО";
	КонецЕсли;
	
	ОбщиеРеквизитыШапки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РешениеСсылка, ИменаРеквизитов);
	
	ОбщиеРеквизитыШапки.Вставить("РешениеОПроведенииИнвентаризации", РешениеСсылка);
	
	Возврат ОбщиеРеквизитыШапки;
	
КонецФункции

Функция ПолучитьТекстСообщенияРезультатаФормированияУспехаДляГрупповогоФормированияОписей(ОбщийСчетчикДокументов, СчетчикиДокументовПоКодамФорм)
	
	МассивТекстов = Новый Массив();
	
	Если ОбщийСчетчикДокументов.Успех > 0 Тогда
		ТекстОбщееКоличество = СтрШаблон(НСтр("ru='Успешно %1'"),
			СтрокаСЧислом(";сформирован %1 документ;;сформировано %1 документа;сформировано %1 документов;сформировано %1 документов", // 0, 1, 2, немного, 5, другое
				ОбщийСчетчикДокументов.Успех,
				ВидЧисловогоЗначения.Количественное));
		
		СчетчикиДокументов = ПолучитьСчетчикиДокументовУспехаОшибкиДляГрупповогоФормированияОписей(СчетчикиДокументовПоКодамФорм, "Успех");
		
		ТекстПоКодамФорм = ПолучитьТекстСообщенияКоличествоДокументовПоКодамФорм(СчетчикиДокументов);
		
		ТекстСообщения = СтрШаблон("%1
			|из них:
			|%2",
			ТекстОбщееКоличество,
			ТекстПоКодамФорм);
			
		МассивТекстов.Добавить(ТекстСообщения);
	КонецЕсли;
	
	Если ОбщийСчетчикДокументов.Ошибка > 0 Тогда
		ТекстОбщееКоличество = СтрШаблон(НСтр("ru='Не удалось сформировать %1'"),
			СтрокаСЧислом(";%1 документ;;%1 документа;%1 документов;%1 документов", // 0, 1, 2, немного, 5, другое
				ОбщийСчетчикДокументов.Ошибка,
				ВидЧисловогоЗначения.Количественное));
		
		СчетчикиДокументов = ПолучитьСчетчикиДокументовУспехаОшибкиДляГрупповогоФормированияОписей(СчетчикиДокументовПоКодамФорм, "Ошибка");
		
		ТекстПоКодамФорм = ПолучитьТекстСообщенияКоличествоДокументовПоКодамФорм(СчетчикиДокументов);
		
		ТекстСообщения = СтрШаблон("%1
			|из них:
			|%2
			|Подробности см. в журнале регистрации",
			ТекстОбщееКоличество,
			ТекстПоКодамФорм);
			
		МассивТекстов.Добавить(ТекстСообщения);
	КонецЕсли;
	
	Возврат СтрСоединить(МассивТекстов, Символы.ПС + Символы.ПС);
	
КонецФункции

Функция ПолучитьСчетчикиДокументовУспехаОшибкиДляГрупповогоФормированияОписей(СчетчикиДокументовПоКодамФорм, ПолеСчетчика)
	
	СчетчикиДокументов = Новый Соответствие();
	
	Для Каждого Элемент Из СчетчикиДокументовПоКодамФорм Цикл
		КодФормы = Элемент.Ключ;
		СчетчикДокументовКодаФормы = Элемент.Значение;
		
		ЗначениеСчетчика = СчетчикДокументовКодаФормы[ПолеСчетчика];
		
		Если ЗначениеСчетчика > 0 Тогда
			СчетчикиДокументов.Вставить(КодФормы, ЗначениеСчетчика);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СчетчикиДокументов;
	
КонецФункции

Процедура ЗаполнитьНовыйДокументОписиДляГрупповогоФормированияОписей(Данные,
		ДатаДокументов, ПараметрыФормирования, ОбщийСчетчикДокументов, СчетчикДокументовКодаФормы)
	
	Данные.ДокументОбъект.Дата = ДатаДокументов;
	
	ЗаполнитьШапкуОписиДляГрупповогоФормированияОписей(Данные);
	
	ЗаполнитьТабличныеЧастиОписиДляГрупповогоФормированияОписей(Данные);
	
	ЗаполнитьСоставКомиссииОписиДляГрупповогоФормированияОписей(Данные);
	
	ЗаполнитьОтветственногоИсполнителяКомиссииДляГрупповогоФормированияОписей(Данные);
	
	ЗавершитьЗаполнениеОписиДляГрупповогоФормированияОписей(Данные);
	
	УстановитьКомментарийДокументаДляГрупповогоФормированияОписей(Данные, ДатаДокументов, ПараметрыФормирования,
		ОбщийСчетчикДокументов, СчетчикДокументовКодаФормы);
	
КонецПроцедуры

Процедура ЗаполнитьШапкуОписиДляГрупповогоФормированияОписей(Данные)
	
	ДокументОбъект 					= Данные.ДокументОбъект;
	ПерваяСтрокаТаблицыРешения		= Данные.ПерваяСтрокаТаблицыРешения;
	РасположениеРеквизитов			= Данные.РасположениеРеквизитов;
	ОбщиеРеквизитыШапки				= Данные.ОбщиеРеквизитыШапки;
	СведенияКомиссий				= Данные.СведенияКомиссий;
	
	ЗаполнитьЗначенияСвойств(ДокументОбъект, ОбщиеРеквизитыШапки);
	
	ЗаполнитьЗначенияСвойств(ДокументОбъект, ПерваяСтрокаТаблицыРешения, "ДатаНачала,ДатаОкончания,ДатаИнвентаризации");
	
	// Сотрудник.
	РасположениеРеквизита = РасположениеРеквизитов.Сотрудник;
	Если РасположениеРеквизита.РасположенВШапке Тогда
		ДокументОбъект[РасположениеРеквизита.ИмяПоля] = ПерваяСтрокаТаблицыРешения.Сотрудник;
	КонецЕсли;
	
	// Счет.
	РасположениеРеквизита = РасположениеРеквизитов.Счет;
	Если РасположениеРеквизита.РасположенВШапке Тогда
		ДокументОбъект[РасположениеРеквизита.ИмяПоля] = ПерваяСтрокаТаблицыРешения.Счет;
	КонецЕсли;
	
	// КФО.
	РасположениеРеквизита = РасположениеРеквизитов.КФО;
	Если РасположениеРеквизита.РасположенВШапке Тогда
		ДокументОбъект[РасположениеРеквизита.ИмяПоля] = ПерваяСтрокаТаблицыРешения.КФО;
	КонецЕсли;
	
	// МестоИнвентаризации.
	РасположениеРеквизита = РасположениеРеквизитов.МестоИнвентаризации;
	Если РасположениеРеквизита.РасположенВШапке Тогда
		ДокументОбъект[РасположениеРеквизита.ИмяПоля] = ПерваяСтрокаТаблицыРешения.МестоИнвентаризации;
	КонецЕсли;
	
	// Комиссия ссылка.
	ЗаполнитьЗначенияСвойств(ДокументОбъект, ПерваяСтрокаТаблицыРешения, "НомерКомиссии,НомерРабочейКомиссии");
	
	НомерКомиссии = ПерваяСтрокаТаблицыРешения.НомерКомиссии;
	
	Поиск = Новый Структура("НомерСтроки", НомерКомиссии);
	
	МассивСтрок = СведенияКомиссий.СписокКомиссий.НайтиСтроки(Поиск);
	
	Если МассивСтрок.Количество() > 0 Тогда
		ДокументОбъект.Комиссия = МассивСтрок[0].Комиссия;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьТабличныеЧастиОписиДляГрупповогоФормированияОписей(Данные)
	
	Перем ТаблицаСписокСчетов, ТаблицаМестаИнвентаризации;
	
	ДокументОбъект 					= Данные.ДокументОбъект;
	ИндексыСтрок					= Данные.ИндексыСтрок;
	ОтмеченныеСтрокиТаблицыРешения	= Данные.ОтмеченныеСтрокиТаблицыРешения;
	ПерваяСтрокаТаблицыРешения		= Данные.ПерваяСтрокаТаблицыРешения;
	РасположениеРеквизитов			= Данные.РасположениеРеквизитов;
	ОбщиеРеквизитыШапки				= Данные.ОбщиеРеквизитыШапки;
	
	Если Не РасположениеРеквизитов.Счет.РасположенВТабличнойЧасти
		И Не РасположениеРеквизитов.МестоИнвентаризации.РасположенВТабличнойЧасти Тогда
		Возврат;
	КонецЕсли;
	
	Если РасположениеРеквизитов.Счет.РасположенВТабличнойЧасти Тогда
		ТаблицаСписокСчетов = Новый ТаблицаЗначений();
		ТаблицаСписокСчетов.Колонки.Добавить("КФО", Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
		ТаблицаСписокСчетов.Колонки.Добавить("Счет", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	КонецЕсли;
	
	Если РасположениеРеквизитов.МестоИнвентаризации.РасположенВТабличнойЧасти Тогда
		ТаблицаМестаИнвентаризации = Новый ТаблицаЗначений();
		ТаблицаМестаИнвентаризации.Колонки.Добавить("МестоИнвентаризации", Новый ОписаниеТипов(Метаданные.ОпределяемыеТипы.МестоИнвентаризацииНФА.Тип));
	КонецЕсли;
	
	Для Каждого ИндексСтроки Из ИндексыСтрок Цикл
		СтрокаТаблицыРешения = ОтмеченныеСтрокиТаблицыРешения[ИндексСтроки];
		
		Если РасположениеРеквизитов.Счет.РасположенВТабличнойЧасти Тогда
			НоваяСтрока = ТаблицаСписокСчетов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицыРешения, "КФО,Счет");
		КонецЕсли;
		
		Если РасположениеРеквизитов.МестоИнвентаризации.РасположенВТабличнойЧасти Тогда
			НоваяСтрока = ТаблицаМестаИнвентаризации.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицыРешения, "МестоИнвентаризации");
		КонецЕсли;
	КонецЦикла;
	
	Если РасположениеРеквизитов.Счет.РасположенВТабличнойЧасти Тогда
		ТаблицаСписокСчетов.Свернуть("КФО,Счет");
		
		ДокументОбъект.СписокСчетов.Загрузить(ТаблицаСписокСчетов);
	КонецЕсли;
	
	Если РасположениеРеквизитов.МестоИнвентаризации.РасположенВТабличнойЧасти Тогда
		ТаблицаМестаИнвентаризации.Свернуть("МестоИнвентаризации");
		
		ДокументОбъект.МестаИнвентаризации.Загрузить(ТаблицаМестаИнвентаризации);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСоставКомиссииОписиДляГрупповогоФормированияОписей(Данные)
	
	ДокументОбъект 					= Данные.ДокументОбъект;
	ОтмеченныеСтрокиТаблицыРешения	= Данные.ОтмеченныеСтрокиТаблицыРешения;
	ПерваяСтрокаТаблицыРешения		= Данные.ПерваяСтрокаТаблицыРешения;
	РасположениеРеквизитов			= Данные.РасположениеРеквизитов;
	СведенияКомиссий				= Данные.СведенияКомиссий;
	
	ИменаТЧСоставКомиссии = Новый Массив();
	
	ТипДокумента = ТипЗнч(ДокументОбъект.Ссылка);
	
	Если ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьБСО")
		Или ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьНаличныхСредств")
		Или ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьНФА")
		Или ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьЦенныхБумаг") Тогда
		
		ИменаТЧСоставКомиссии.Добавить("СоставКомиссииРаздел2");
		ИменаТЧСоставКомиссии.Добавить("СоставКомиссииРаздел4");
	Иначе
		ИменаТЧСоставКомиссии.Добавить("СоставКомиссии");
	КонецЕсли;
	
	НомерКомиссии			= ПерваяСтрокаТаблицыРешения.НомерКомиссии;
	НомерРабочейКомиссии	= ПерваяСтрокаТаблицыРешения.НомерРабочейКомиссии;
	
	Поиск = Новый Структура("Комиссия", ДокументОбъект.Комиссия);
	
	Если ЗначениеЗаполнено(НомерРабочейКомиссии) Тогда
		Поиск.Вставить("НомерРабочейКомиссии", НомерРабочейКомиссии);
	КонецЕсли;
	
	МассивСтрок = СведенияКомиссий.СоставыКомиссий.НайтиСтроки(Поиск);
	
	Для Каждого ИмяТЧСоставКомиссии Из ИменаТЧСоставКомиссии Цикл
		ДокументОбъект[ИмяТЧСоставКомиссии].Очистить();
		
		Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
			НоваяСтрока = ДокументОбъект[ИмяТЧСоставКомиссии].Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы, "Сотрудник");
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьОтветственногоИсполнителяКомиссииДляГрупповогоФормированияОписей(Данные)
	
	ИмяРеквизитаОтветственныйИсполнительКомиссии = "ОтветственныйИсполнитель";
	
	ДокументОбъект 					= Данные.ДокументОбъект;
	ПерваяСтрокаТаблицыРешения		= Данные.ПерваяСтрокаТаблицыРешения;
	СведенияКомиссий				= Данные.СведенияКомиссий;
	
	НомерКомиссии			= ПерваяСтрокаТаблицыРешения.НомерКомиссии;
	НомерРабочейКомиссии	= ПерваяСтрокаТаблицыРешения.НомерРабочейКомиссии;
	
	Поиск = Новый Структура("Комиссия,ОтветственныйИсполнитель", ДокументОбъект.Комиссия, Истина);
	
	Если ЗначениеЗаполнено(НомерРабочейКомиссии) Тогда
		Поиск.Вставить("НомерРабочейКомиссии", НомерРабочейКомиссии);
	КонецЕсли;
	
	МассивСтрок = СведенияКомиссий.СоставыКомиссий.НайтиСтроки(Поиск);
	
	Если МассивСтрок.Количество() > 0 Тогда
		ПерваяСтрока = МассивСтрок[0];
		
		ДокументОбъект[ИмяРеквизитаОтветственныйИсполнительКомиссии] = ПерваяСтрока.Сотрудник;
	КонецЕсли;
	
КонецПроцедуры

// См. аналог ЗавершитьЗаполнениеОписиПоРешению()
Процедура ЗавершитьЗаполнениеОписиДляГрупповогоФормированияОписей(Данные)
	
	ТипДокумента = ТипЗнч(Данные.ДокументОбъект.Ссылка);
	
	Если ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьБСО") Тогда
		ЗавершитьЗаполнениеОписиДляГрупповогоФормированияОписей_ИнвентаризационнаяОписьБСО(Данные);
	
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьНФА") Тогда
		ЗавершитьЗаполнениеОписиДляГрупповогоФормированияОписей_ИнвентаризационнаяОписьНФА(Данные);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьКредитовИЗаймов") Тогда
		ЗавершитьЗаполнениеОписиДляГрупповогоФормированияОписей_ИнвентаризационнаяОписьКредитовИЗаймов(Данные);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗавершитьЗаполнениеОписиДляГрупповогоФормированияОписей_ИнвентаризационнаяОписьБСО(Данные)
	
	ДокументОбъект = Данные.ДокументОбъект;
	
	ВидДокумента = Перечисления.ВидыДокументовСтрогойОтчетности.ПустаяСсылка();
	
	Если ЗначениеЗаполнено(ДокументОбъект.Счет) Тогда
		КодСчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОбъект.Счет, "Код");
		
		Если КодСчета = "201.35" Тогда
			ВидДокумента = Перечисления.ВидыДокументовСтрогойОтчетности.ДенежныеДокументы;
		Иначе
			ВидДокумента = Перечисления.ВидыДокументовСтрогойОтчетности.БСО;
		КонецЕсли;
	КонецЕсли;
	
	ДокументОбъект.ВидДокумента = ВидДокумента;
	
КонецПроцедуры

Процедура ЗавершитьЗаполнениеОписиДляГрупповогоФормированияОписей_ИнвентаризационнаяОписьНФА(Данные)
	
	ДокументОбъект					= Данные.ДокументОбъект;
	ИндексыСтрок					= Данные.ИндексыСтрок;
	ОтмеченныеСтрокиТаблицыРешения	= Данные.ОтмеченныеСтрокиТаблицыРешения;
	
	ТекстВыборочная = НСтр("ru='выборочная'");
	
	ПризнакВыборочнойИнвентаризации = Истина;
	
	Для Каждого ИндексСтроки Из ИндексыСтрок Цикл
		СтрокаТаблицыРешения = ОтмеченныеСтрокиТаблицыРешения[ИндексСтроки];
		
		Если СтрНайти(СтрокаТаблицыРешения.Примечание, ТекстВыборочная) = 0 Тогда
			ПризнакВыборочнойИнвентаризации = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ДокументОбъект.ЭтоВыборочнаяИнвентаризация = ПризнакВыборочнойИнвентаризации;
	
КонецПроцедуры

Процедура ЗавершитьЗаполнениеОписиДляГрупповогоФормированияОписей_ИнвентаризационнаяОписьКредитовИЗаймов(Данные)
	
	ДокументОбъект = Данные.ДокументОбъект;
	
	СтруктураФормы = Новый Структура();
	СтруктураФормы.Вставить("Объект", ДокументОбъект);
	
	СписокВыбора = Документы.ИнвентаризационнаяОписьКредитовИЗаймов.ПолучитьСписокВыбораНаименованияЗадолженности(СтруктураФормы);
	
	Если СписокВыбора.Количество() = 1 Тогда
		ДокументОбъект.НаименованиеЗадолженности = СписокВыбора.Получить(0).Значение;
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьКомментарийДокументаДляГрупповогоФормированияОписей(Данные, ДатаДокументов, ПараметрыФормирования,
		ОбщийСчетчикДокументов, СчетчикДокументовКодаФормы)
	
	Если Не ПараметрыФормирования.УстанавливатьКомментарий Тогда
		Возврат;
	КонецЕсли;
	
	ДокументОбъект = Данные.ДокументОбъект;
	
	ШаблонКомментария = ПараметрыФормирования.ШаблонКомментария;
	
	ФорматЧисла = "ЧГ=0;ЧН=0";
	
	Комментарий = СтрЗаменить(ШаблонКомментария, "[ДатаВремя]", Строка(ДатаДокументов));
	
	Комментарий = СтрЗаменить(Комментарий, "[ОбщийСчетчикДокументов]",
		Формат(ОбщийСчетчикДокументов.Счетчик, ФорматЧисла));
		
	Комментарий = СтрЗаменить(Комментарий, "[ОбщееКоличествоДокументов]",
		Формат(ОбщийСчетчикДокументов.Количество, ФорматЧисла));
		
	Комментарий = СтрЗаменить(Комментарий, "[СчетчикДокументовКодаФормы]",
		Формат(СчетчикДокументовКодаФормы.Счетчик, ФорматЧисла));
		
	Комментарий = СтрЗаменить(Комментарий, "[КоличествоДокументовКодаФормы]",
		Формат(СчетчикДокументовКодаФормы.Количество, ФорматЧисла));
	
	ДокументОбъект.Комментарий = Комментарий;
	
КонецПроцедуры

