Функция Печать0504087_194н_ПолучитьОчищающуюСтруктуруФактическогоНаличия(Макет)
	
	// Исключаем вывод символа прочерка "-" в показателях фактического наличия
	// путем указания пустой строки
	
	Попытка
		ОбластьНомераГраф = Макет.ПолучитьОбласть("НомераГраф");
		
		Текст = ОбластьНомераГраф.Область(1, 1, 1, 1).Текст;
	Исключение
		// Значение по умолчанию
		Текст = "5, 6, 7, 8, 9, 13, 14, 15, 16, 17, 18";
	КонецПопытки;
	
	//						Графа	Имя параметра
	ИменаПараметров = Новый Соответствие();
	ИменаПараметров.Вставить("1",	"Ном");
	ИменаПараметров.Вставить("2",	"НаименованиеНФА");
	ИменаПараметров.Вставить("3",	"КодНФА");
	ИменаПараметров.Вставить("4",	"ЕдиницаИзмерения");
	ИменаПараметров.Вставить("5",	"Цена");
	ИменаПараметров.Вставить("6",	"КоличествоФ");
	ИменаПараметров.Вставить("7",	"СуммаФ");
	ИменаПараметров.Вставить("8",	"СтатусОбъекта");
	ИменаПараметров.Вставить("9",	"ЦелеваяФункция");
	ИменаПараметров.Вставить("10",	"Счет");
	ИменаПараметров.Вставить("11",	"КоличествоБ");
	ИменаПараметров.Вставить("12",	"СуммаБ");
	ИменаПараметров.Вставить("13",	"КоличествоН");
	ИменаПараметров.Вставить("14",	"СуммаН");
	ИменаПараметров.Вставить("15",	"КоличествоИ");
	ИменаПараметров.Вставить("16",	"СуммаИ");
	ИменаПараметров.Вставить("17",	"КоличествоНА");
	ИменаПараметров.Вставить("18",	"СуммаНА");
	ИменаПараметров.Вставить("19",	"Примечание");
	
	НомераГраф = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(Текст);
	
	ОчищающаяСтруктура = Новый Структура();
	
	Для Каждого НомерГрафы Из НомераГраф Цикл
		ИмяПараметра = ИменаПараметров.Получить(НомерГрафы);
		
		Если ИмяПараметра = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ОчищающаяСтруктура.Вставить(ИмяПараметра, "");
	КонецЦикла;
	
	Возврат ОчищающаяСтруктура;
	
КонецФункции

Процедура Печать0504087_194н_ВывестиПодвал(ТабДокумент, Макет, Выборки, ДополнительныеПараметры)
	
	Области = Новый Структура();
	Области.Вставить("ПодвалТекстПроверено",	Макет.ПолучитьОбласть("ПодвалТекстПроверено"));
	Области.Вставить("ПодвалПричиныСтрока1",	Макет.ПолучитьОбласть("ПодвалПричиныСтрока1"));
	Области.Вставить("ПодвалПричиныСтрока2",	Макет.ПолучитьОбласть("ПодвалПричиныСтрока2"));
	Области.Вставить("ПодвалМОЛ",				Макет.ПолучитьОбласть("ПодвалМОЛ"));
	Области.Вставить("ПодвалЗаключениеСтрока1",	Макет.ПолучитьОбласть("ПодвалЗаключениеСтрока1"));
	Области.Вставить("ПодвалЗаключениеСтрока2",	Макет.ПолучитьОбласть("ПодвалЗаключениеСтрока2"));
	Области.Вставить("Комиссия",				Макет.ПолучитьОбласть("Комиссия"));
	Области.Вставить("ДатаПодписиКомиссии",		Макет.ПолучитьОбласть("ДатаПодписиКомиссии"));
	
	ДлиныСтрок = Печать0504087_194н_ПолучитьДлиныСтрокПодвала(Макет);
	
	//
	// Количество выведенных строк таблицы
	//
	
	ЗначенияПараметров = Новый Структура();
	
	Если ДополнительныеПараметры.КоличествоСтрокВыборки > 0 Тогда
		ЗначенияПараметров.Вставить("НомерСтрокиНачальный", 1);
		ЗначенияПараметров.Вставить("НомерСтрокиКонечный", ДополнительныеПараметры.КоличествоСтрокВыборки);
	Иначе
		ЗначенияПараметров.Вставить("НомерСтрокиНачальный", НСтр("ru='—'"));
		ЗначенияПараметров.Вставить("НомерСтрокиКонечный", НСтр("ru='—'"));
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(Области.ПодвалТекстПроверено.Параметры, ЗначенияПараметров);
	
	ТабДокумент.Вывести(Области.ПодвалТекстПроверено);
	
	//
	// Объяснение причин расхождений
	//
	
	ОбластьОбъясненияПричинРасхождений = Печать0504087_194н_ВывестиОбъяснениеПричинРасхождений(
		Выборки,
		ДлиныСтрок,
		Макет);
		
	ТабДокумент.Вывести(ОбластьОбъясненияПричинРасхождений);
	
	//
	// Подпись МОЛ
	//
	
	Области.ПодвалМОЛ.Параметры.Заполнить(ДополнительныеПараметры.ОписаниеМОЛ);
	Области.ПодвалМОЛ.Параметры.Заполнить(ДополнительныеПараметры.КомпонентыДатыДляПодписи);
	
	Если НЕ ТабДокумент.ПроверитьВывод(Области.ПодвалМОЛ) Тогда
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЕсли;
	
	ТабДокумент.Вывести(Области.ПодвалМОЛ);
	
	//
	// Заключение комиссии
	//
	
	ОбластьЗаключениеКомиссии = Печать0504087_194н_ВывестиЗаключениеКомиссии(
		Выборки,
		ДлиныСтрок,
		Макет);
	
	ТабДокумент.Вывести(ОбластьЗаключениеКомиссии);
	
	//
	// Инвентаризационная комиссия
	//
	
	ОбластьВсяКомиссия = УправлениеОсновнымиСредствами.СформироватьОбластьКомиссия(
		Выборки.Шапка,
		Выборки.ДокументКомиссия.Выбрать(),
		Области.Комиссия,
		3);
		
	ИнвентаризацияСервер.ВывестиСКонтролемРазбивкиНаСтраницы(ТабДокумент, ОбластьВсяКомиссия, 3, 3);
	
	КомпонентыДатыДляПодписи = ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи(Выборки["Шапка"]["ДатаПодписиКомиссии"]);
	
	Области.ДатаПодписиКомиссии.Параметры.Заполнить(КомпонентыДатыДляПодписи);
	
	ТабДокумент.Вывести(Области.ДатаПодписиКомиссии);
	
КонецПроцедуры

Функция Печать0504087_194н_ВывестиОбъяснениеПричинРасхождений(Выборки, ДлиныСтрок, Макет)
	
	Текст = Выборки.Шапка.ОбъяснениеПричинРасхождений;
	
	БлокиСтрок = Неопределено;
	
	// Блок 1
	ИнвентаризацияСервер.ДобавитьОписаниеБлокаСтрок(БлокиСтрок, 1, ДлиныСтрок.ПричиныДлинаСтроки1, "ПодвалПричиныСтрока1");
	
	// Блок 2
	ИнвентаризацияСервер.ДобавитьОписаниеБлокаСтрок(БлокиСтрок, , ДлиныСтрок.ПричиныДлинаСтроки2, "ПодвалПричиныСтрока2");
	
	МинимальноеКоличествоСтрок = 3;
	
	Возврат ИнвентаризацияСервер.РазбитьТекстНаБлокиСтрокИВывестиВТабличныйДокумент(Текст, БлокиСтрок, Макет, МинимальноеКоличествоСтрок);
	
КонецФункции

