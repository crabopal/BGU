Функция Печать0504087_194н_ПолучитьДлиныСтрокПодвала(Макет)
	
	ПараметрыРазбиенияТекста = Новый Структура();
	
	ПараметрыРазбиенияТекста.Вставить("ПричиныДлинаСтроки1", ПолучитьПоложительноеЦелоеЧислоИзЯчейкиМакета(Макет, "ПодвалПричиныДлинаСтроки1", 160, 1000));
	ПараметрыРазбиенияТекста.Вставить("ПричиныДлинаСтроки2", ПолучитьПоложительноеЦелоеЧислоИзЯчейкиМакета(Макет, "ПодвалПричиныДлинаСтроки2", 200, 1000));
	
	ПараметрыРазбиенияТекста.Вставить("ЗаключениеДлинаСтроки1", ПолучитьПоложительноеЦелоеЧислоИзЯчейкиМакета(Макет, "ПодвалЗаключениеДлинаСтроки1", 160, 1000));
	ПараметрыРазбиенияТекста.Вставить("ЗаключениеДлинаСтроки2", ПолучитьПоложительноеЦелоеЧислоИзЯчейкиМакета(Макет, "ПодвалЗаключениеДлинаСтроки2", 200, 1000));
	
	Возврат ПараметрыРазбиенияТекста;
	
КонецФункции

#КонецОбласти

Функция ПолучитьПоложительноеЦелоеЧислоИзЯчейкиМакета(Макет, ИмяЯчейки, ЗначениеПоУмолчанию, МаксимальноеЗначение)
	
	Значение = ПолучитьЦелоеЧислоИзЯчейкиМакета(Макет, ИмяЯчейки, ЗначениеПоУмолчанию);
	
	Если Значение < 0 ИЛИ Значение > МаксимальноеЗначение Тогда
		
		Значение = ЗначениеПоУмолчанию;
		
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

Функция ПолучитьЦелоеЧислоИзЯчейкиМакета(Макет, ИмяЯчейки, ЗначениеПоУмолчанию)
	
	Попытка
		
		ОбластьЯчейка = Макет.ПолучитьОбласть(ИмяЯчейки);
		
		Текст = СокрЛП(ОбластьЯчейка.Область(1, 1, 1, 1).Текст);
		
	Исключение
		
		Возврат ЗначениеПоУмолчанию;
		
	КонецПопытки;
	
	Текст = НРег(СокрЛП(Текст));
	
	Текст = СтрЗаменить(Текст, " ", "");
	
	Текст = СтрЗаменить(Текст, Символы.НПП, "");
	
	Попытка
		
		Результат = Число(Текст);
		
	Исключение
		
		Возврат ЗначениеПоУмолчанию;
		
	КонецПопытки;
	
	Возврат Цел(Результат);
	
КонецФункции

Функция ОпределитьСотрудникаПоКонтрагенту(Контрагент, Организация)
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("Контрагент", Контрагент);
	ЗапросПоиск.УстановитьПараметр("Организация", Организация);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Ссылка
	|ИЗ
	|	Справочник.Сотрудники
	|ГДЕ
	|	НЕ ПометкаУдаления
	|	И Контрагент = &Контрагент
	|	И Владелец = &Организация";
	
	Выборка = ЗапросПоиск.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура ЗаменитьСотрудникаНаЦМОИлиКонтрагентаДляОписи52н(Сотрудник, Знач Подгруппа)
	
	СотрудникЗаменен = Ложь;
	
	ЗаменитьСотрудникаНаКонтрагентаДляОписи52н(Сотрудник, Подгруппа, СотрудникЗаменен);
	
	Если СотрудникЗаменен Тогда
		Возврат;
	КонецЕсли;
	
	ЗаменитьСотрудникаНаЦМОДляОписи52н(Сотрудник, Подгруппа, СотрудникЗаменен);
	
КонецПроцедуры

Процедура ЗаменитьСотрудникаНаКонтрагентаДляОписи52н(Сотрудник, Знач Подгруппа, СотрудникЗаменен)
	
	ТипОписи = Подгруппа.НастройкиОписи.ТипОписи;
	
	Если ТипОписи <> Тип("ДокументСсылка.ИнвентаризацияМЗ")
		И ТипОписи <> Тип("ДокументСсылка.ИнвентаризацияОС") Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Сотрудник) = Тип("СправочникСсылка.Контрагенты") Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Сотрудник) Тогда
		Возврат;
	КонецЕсли;
	
	Счет = Подгруппа.ПоляГруппировок.Счет;
	
	Если Не ЗначениеЗаполнено(Счет) Тогда
		Возврат;
	КонецЕсли;
	
	СписокСчетов = БухгалтерскийУчет.СписокСчетов("24,25,26,27");
	
	Если СписокСчетов.Найти(Счет) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Сотрудник, "Контрагент");
	
	Сотрудник = Контрагент;
	
	СотрудникЗаменен = Истина;
	
КонецПроцедуры

Процедура ЗаменитьСотрудникаНаЦМОДляОписи52н(Сотрудник, Знач Подгруппа, СотрудникЗаменен)
	
	Перем МестоИнвентаризации;
	
	ТипОписи = Подгруппа.НастройкиОписи.ТипОписи;
	
	Если ТипОписи <> Тип("ДокументСсылка.ИнвентаризацияИК")
		И ТипОписи <> Тип("ДокументСсылка.ИнвентаризацияМЗ")
		И ТипОписи <> Тип("ДокументСсылка.ИнвентаризацияОС")
		И ТипОписи <> Тип("ДокументСсылка.ИнвентаризацияКассы") Тогда
		Возврат;
	КонецЕсли;
	
	Подгруппа.ПоляГруппировок.Свойство("МестоИнвентаризации", МестоИнвентаризации);
	
	Если Не ЗначениеЗаполнено(МестоИнвентаризации) Или ТипЗнч(МестоИнвентаризации) <> Тип("СправочникСсылка.МестаХранения") Тогда
		Возврат;
	КонецЕсли;
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("Сотрудник", Сотрудник);
	ЗапросПоиск.УстановитьПараметр("МестоХранения", МестоИнвентаризации);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Ссылка
	|ИЗ
	|	Справочник.ЦМО
	|ГДЕ
	|	Сотрудник = &Сотрудник
	|	И МестоХранения = &МестоХранения
	|	И НЕ ПометкаУдаления";
	
	Выборка = ЗапросПоиск.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Сотрудник = Выборка.Ссылка;
		
		СотрудникЗаменен = Истина;
		
		Возврат;
	КонецЦикла;
	
КонецПроцедуры

#Область ЦепочкиИзмененийРешения

#Область СоставлениеДерева

Процедура ДобавитьПоследнийДокументЦепочкиИзФормы(ДеревоДокументов, ОбщаяТаблицаКомиссий, ДокументОбъект)
	
	Если ДеревоДокументов.Строки.Количество() > 0 Тогда
		СтрокаРодителя = ПолучитьСтрокуПоследнегоДокументаВосходящейЦепочки(ДеревоДокументов);
	Иначе
		СтрокаРодителя = ДеревоДокументов;
	КонецЕсли;
	
	СтрокаДокумента = СтрокаРодителя.Строки.Добавить();
	
	СтрокаДокумента.Документ = Неопределено;
	
	ЗаполнитьЗначенияСвойств(СтрокаДокумента, ДокументОбъект);
	
	// Табличная часть Комиссии
	
	МассивТипов = Новый Массив();
	МассивТипов.Добавить(Тип("ДокументСсылка.ИзменениеРешенияОПроведенииИнвентаризации"));
	МассивТипов.Добавить(Тип("ДокументСсылка.РешениеОПроведенииИнвентаризации"));
	
	ТаблицаКомиссии = ДокументОбъект.Комиссии.Выгрузить();
	ТаблицаКомиссии.Колонки.Добавить("Документ", Новый ОписаниеТипов(МассивТипов));
	
	СтрокаДокумента["ТаблицаКомиссии"] = ТаблицаКомиссии;
	
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ТаблицаКомиссии, ОбщаяТаблицаКомиссий);
	
КонецПроцедуры

Функция ПолучитьДополнительныеПараметрыДляРасчетаПодразделовРаздела2(МассивКомиссий, ДокументОбъект, ПечатьРешениеСУчетомИзменений)
	
	ВыводитьПризнакМодифицированностиСтроки = Ложь;
	
	ПечататьТолькоМодифицированные = ИнвентаризацияКлиентСервер.ПечататьТолькоМодифицированныеСтрокиИзмененияРешения();
	
	ИспользоватьМакетИзмененияРешения = Истина;
	
	Если ДокументОбъект <> Неопределено Тогда
		// Вызов из формы документа
		
		ВыводитьПризнакМодифицированностиСтроки = Истина;
		
		ЭтоДокументИзмененияРешения = ИнвентаризацияКлиентСервер.ЭтоДокументИзмененияРешения(ДокументОбъект.Ссылка);
		
		Если Не ЭтоДокументИзмененияРешения Тогда
			ПечататьТолькоМодифицированные = Ложь;
		КонецЕсли;
		
		ИспользоватьМакетИзмененияРешения = ЭтоДокументИзмененияРешения;
	КонецЕсли;
	
	Если ИспользоватьМакетИзмененияРешения И ПечатьРешениеСУчетомИзменений Тогда
		ИспользоватьМакетИзмененияРешения = Ложь;
	КонецЕсли;
	
	// Кэш для дальнейшего использования
	ТипИзменения = Новый Структура();
	ТипИзменения.Вставить("Аннулирование",	Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Аннулирование);
	ТипИзменения.Вставить("Отмена",			Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Отмена);
	ТипИзменения.Вставить("Корректировка",	Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Корректировка);
	ТипИзменения.Вставить("Дополнение",		Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Дополнение);
	ТипИзменения.Вставить("Пустой",			Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.ПустаяСсылка());
	
	ДанныеКомиссий = ПолучитьДанныеКомиссийДляПечатиРешения(МассивКомиссий);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("НастройкиТаблицы",						ПолучитьНастройкиТаблицыСравненияСоставаКомиссий());
	ДополнительныеПараметры.Вставить("ДанныеКомиссий",							ДанныеКомиссий);
	ДополнительныеПараметры.Вставить("КорректироватьДобавленныеСтрокиРешения",	ИнвентаризацияКлиентСервер.КорректироватьДобавленныеСтрокиРешения());
	ДополнительныеПараметры.Вставить("СоответствиеПоказателейИГрафРаздела2", 	ПолучитьСоответствиеПоказателейИГрафРаздела2());
	
	ДополнительныеПараметры.Вставить("ТипИзменения",							ТипИзменения);
	ДополнительныеПараметры.Вставить("ПечататьТолькоМодифицированные",			ПечататьТолькоМодифицированные);
	ДополнительныеПараметры.Вставить("ВыводитьПризнакМодифицированностиСтроки",	ВыводитьПризнакМодифицированностиСтроки);
	
	ДополнительныеПараметры.Вставить("ИспользоватьМакетИзмененияРешения",		ИспользоватьМакетИзмененияРешения);
	
	Возврат ДополнительныеПараметры;
	
КонецФункции

Процедура ЗаполнитьТабличныеДокументыПодразделовРаздела2(ДеревоДокументов, Знач СписокДокументов, ДокументОбъект, ДополнительныеПараметры)
	
	Если ДокументОбъект <> Неопределено Тогда
		СписокДокументов.Добавить(Неопределено);
	КонецЕсли;
	
	Поиск = Новый Структура();
	
	Для Каждого ДокументСсылка Из СписокДокументов Цикл
		
		Поиск.Вставить("Документ", ДокументСсылка);
		
		МассивСтрок = ДеревоДокументов.Строки.НайтиСтроки(Поиск, Истина);
		
		Для Каждого СтрокаДокумента Из МассивСтрок Цикл
			
			ДополнительныеПараметры.Вставить("Аннулирующее", СтрокаДокумента.Аннулирующее);
			
			Для Каждого СтрокаПодраздела Из СтрокаДокумента["ТаблицаПодразделовРаздела2"] Цикл
				
				СтрокаПодраздела["ТабличныйДокумент"] = СформироватьТабличныйДокументИзмененияСоставаКомиссии(
					СтрокаПодраздела["ТаблицаСравненияСоставаКомиссий"],
					СтрокаДокумента.Аннулирующее,
					ДополнительныеПараметры);
					
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьТаблицыСравненияСоставаКомиссийВоВсемДереве(ДеревоДокументов, МассивКомиссий, ДополнительныеПараметры)
	
	Для Каждого СтрокаРешения Из ДеревоДокументов.Строки Цикл
		
		СтрокаРешения["ТаблицаПодразделовРаздела2"] = ПолучитьПустуюТаблицуПодразделовРаздела2();
		
		ТаблицаКомиссии = СтрокаРешения["ТаблицаКомиссии"];
		
		Для Каждого СтрокаТаблицы Из ТаблицаКомиссии Цикл
			
			НоваяСтрокаПодраздела = СтрокаРешения["ТаблицаПодразделовРаздела2"].Добавить();
			
			ТаблицаСравнения = ИнициализироватьТаблицуСравненияСоставовДвухКомиссий(
				СтрокаТаблицы.Комиссия,
				СтрокаРешения.Дата,
				ДополнительныеПараметры);
				
			НоваяСтрокаПодраздела["КомиссияЗаголовка"]					= СтрокаТаблицы.Комиссия;
			НоваяСтрокаПодраздела["ТаблицаСравненияСоставаКомиссий"]	= ТаблицаСравнения;
			
		КонецЦикла;
		
		ЗаполнитьТаблицыСравненияСоставаКомиссийВДочернихСтроках(СтрокаРешения, ДополнительныеПараметры);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьТаблицыСравненияСоставаКомиссийВДочернихСтроках(СтрокаРодителя, ДополнительныеПараметры)
	
	МаксимальноеКоличествоКомиссийРодителя = СтрокаРодителя.ТаблицаКомиссии.Количество();
	
	Для Каждого СтрокаДокумента Из СтрокаРодителя.Строки Цикл
		
		СтрокаДокумента["ТаблицаПодразделовРаздела2"] = ПолучитьПустуюТаблицуПодразделовРаздела2();
		
		ТаблицаКомиссии					= СтрокаДокумента["ТаблицаКомиссии"];
		МаксимальноеКоличествоКомиссий	= СтрокаДокумента["МаксимальноеКоличествоКомиссий"];
		
		КоличествоКомиссийДокумента = ТаблицаКомиссии.Количество();
		
	    // Подразделы
		Для НомерСтроки = 1 По МаксимальноеКоличествоКомиссий Цикл
			
			ИндексСтроки = НомерСтроки - 1;
			
			НоваяСтрокаПодраздела = СтрокаДокумента["ТаблицаПодразделовРаздела2"].Добавить();
			
			Если НомерСтроки <= МаксимальноеКоличествоКомиссийРодителя Тогда
				СтрокаПодразделаРодителя = СтрокаРодителя["ТаблицаПодразделовРаздела2"][ИндексСтроки];
			КонецЕсли;
			
			Если НомерСтроки > КоличествоКомиссийДокумента Тогда
				// Ошибка №10 построения цепочки
				
				КомиссияДокумента = Неопределено;
				
				НоваяСтрокаПодраздела["КомиссияЗаголовка"] = КомиссияДокумента;
				
				ТаблицаСравнения = ИнициализироватьТаблицуСравненияСоставовДвухКомиссий(
					КомиссияДокумента,
					СтрокаДокумента.Дата,
					ДополнительныеПараметры,
					Истина);
					
				НоваяСтрокаПодраздела["ТаблицаСравненияСоставаКомиссий"]	= ТаблицаСравнения;
				НоваяСтрокаПодраздела["ЕстьМодифицированныеСтроки"]			= ТаблицаСравнения.Итог("Модифицированность");
				
				Продолжить;
			КонецЕсли;
			
			Если НомерСтроки > МаксимальноеКоличествоКомиссийРодителя Тогда
				// Новая строка (подраздел), добавленная в текущем документе Изменения решения.
				
				СтрокаТаблицыКомиссии = ТаблицаКомиссии[ИндексСтроки];
				
				КомиссияДокумента = СтрокаТаблицыКомиссии.Комиссия;
				
				НоваяСтрокаПодраздела["КомиссияЗаголовка"] = КомиссияДокумента;
				
				ТаблицаСравнения = ИнициализироватьТаблицуСравненияСоставовДвухКомиссий(
					КомиссияДокумента,
					СтрокаДокумента.Дата,
					ДополнительныеПараметры,
					Истина);
					
				НоваяСтрокаПодраздела["ТаблицаСравненияСоставаКомиссий"]	= ТаблицаСравнения;
				НоваяСтрокаПодраздела["ЕстьМодифицированныеСтроки"]			= ТаблицаСравнения.Итог("Модифицированность");
			Иначе
				// Строка (подраздел) существовала и ранее
				
				СтрокаТаблицыКомиссии = ТаблицаКомиссии[ИндексСтроки];
				
				КомиссияДокумента = СтрокаТаблицыКомиссии.Комиссия;
				
				НоваяСтрокаПодраздела["КомиссияЗаголовка"] = КомиссияДокумента;
				
				ТаблицаСравнения = СтрокаПодразделаРодителя["ТаблицаСравненияСоставаКомиссий"].Скопировать();
				
				Если НЕ СтрокаТаблицыКомиссии.Модифицированность Тогда
					ТаблицаСравнения.ЗаполнитьЗначения(Ложь, "Модифицированность");
					
					НоваяСтрокаПодраздела["ТаблицаСравненияСоставаКомиссий"] = ТаблицаСравнения;
					
					Продолжить;
				КонецЕсли;
				
				ТипИзменения = СтрокаТаблицыКомиссии.ТипИзменения;
				
				Если ТипИзменения = ДополнительныеПараметры.ТипИзменения.Отмена Тогда
					
					СтрокаДерева = ПолучитьСтрокуДокументаПоявленияПодраздела(СтрокаДокумента, НомерСтроки);
					
					СтрокаПодраздела = СтрокаДерева["ТаблицаПодразделовРаздела2"][ИндексСтроки];
					
					ТаблицаСравнения = СтрокаПодраздела["ТаблицаСравненияСоставаКомиссий"].Скопировать();
					
					ОтменитьВсехЧленовКомиссии(ТаблицаСравнения, ДополнительныеПараметры);
					
					НоваяСтрокаПодраздела["ЕстьМодифицированныеСтроки"] = Истина;
					
				ИначеЕсли ТипИзменения = ДополнительныеПараметры.ТипИзменения.Пустой
					ИЛИ ТипИзменения = ДополнительныеПараметры.ТипИзменения.Дополнение Тогда
					
					СтрокаДерева = ПолучитьСтрокуДокументаПоявленияПодраздела(СтрокаДокумента, НомерСтроки);
					
					СтрокаПодраздела = СтрокаДерева["ТаблицаПодразделовРаздела2"][ИндексСтроки];
					
					ТаблицаСравнения = СтрокаПодраздела["ТаблицаСравненияСоставаКомиссий"].Скопировать();
					
					НоваяСтрокаПодраздела["ЕстьМодифицированныеСтроки"] = Истина;
					
				ИначеЕсли ТипИзменения = ДополнительныеПараметры.ТипИзменения.Корректировка Тогда
					
					ДобавитьСравнениеСоставаКомиссии(ТаблицаСравнения,
						КомиссияДокумента,
						СтрокаДокумента.Дата,
						ДополнительныеПараметры);
						
					НоваяСтрокаПодраздела["ЕстьМодифицированныеСтроки"] = ТаблицаСравнения.Итог("Модифицированность");
					
				КонецЕсли;
				
				НоваяСтрокаПодраздела["ТаблицаСравненияСоставаКомиссий"] = ТаблицаСравнения;
				
			КонецЕсли;
			
		КонецЦикла;
		
		ЗаполнитьТаблицыСравненияСоставаКомиссийВДочернихСтроках(СтрокаДокумента, ДополнительныеПараметры)
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьСтрокуДокументаПоявленияПодраздела(СтрокаДокумента, НомерПодраздела)
	
	СтрокаДерева = СтрокаДокумента;
	
	Пока СтрокаДерева.Родитель <> Неопределено Цикл
		
		СтрокаРодитель = СтрокаДерева.Родитель;
		
		КоличествоПодразделовРодителя = СтрокаРодитель["ТаблицаПодразделовРаздела2"].Количество();
		
		Если НомерПодраздела > КоличествоПодразделовРодителя Тогда
			Возврат СтрокаДерева;
		КонецЕсли;
		
		СтрокаДерева = СтрокаРодитель;
		
	КонецЦикла;
	
	Возврат СтрокаДерева;
	
КонецФункции

Процедура ОтменитьВсехЧленовКомиссии(ТаблицаСравнения, ДополнительныеПараметры)
	
	ТипИзмененияОтмена = ДополнительныеПараметры.ТипИзменения.Отмена;
	
	Для Каждого СтрокаТаблицы Из ТаблицаСравнения Цикл
		СтрокаТаблицы.ТипИзменения = ТипИзмененияОтмена;
		
		СтрокаТаблицы.Модифицированность = Истина;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьКолонкуМаксимальноеКоличествоКомиссийВоВсемДереве(ДеревоДокументов)
	
	// Количество подразделов может только увеличиваться или оставаться неизменным.
	// Уменьшаться не может.
	
	Для Каждого СтрокаРешения Из ДеревоДокументов.Строки Цикл
		МаксимальноеКоличествоКомиссий = СтрокаРешения.ТаблицаКомиссии.Количество();
		
		СтрокаРешения["МаксимальноеКоличествоКомиссий"] = МаксимальноеКоличествоКомиссий;
		
		ЗаполнитьКолонкуМаксимальноеКоличествоКомиссийВДочернихСтроках(СтрокаРешения, МаксимальноеКоличествоКомиссий);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьКолонкуМаксимальноеКоличествоКомиссийВДочернихСтроках(СтрокаРодителя, МаксимальноеКоличествоКомиссий)
	
	Для Каждого СтрокаДокумента Из СтрокаРодителя.Строки Цикл
		КоличествоКомиссий = СтрокаДокумента.ТаблицаКомиссии.Количество();
		
		Если МаксимальноеКоличествоКомиссий < КоличествоКомиссий Тогда
			МаксимальноеКоличествоКомиссий = КоличествоКомиссий;
		КонецЕсли;
		
		СтрокаДокумента["МаксимальноеКоличествоКомиссий"] = МаксимальноеКоличествоКомиссий;
		
		ЗаполнитьКолонкуМаксимальноеКоличествоКомиссийВДочернихСтроках(СтрокаДокумента, МаксимальноеКоличествоКомиссий);
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьНисходящиеЦепочки(РезультатыПоиска, СписокДокументов, ТаблицыДокументов)
	
	ДеревоДокументов		= РезультатыПоиска.ДеревоДокументов;
	ОбщаяТаблицаКомиссий	= ТаблицыДокументов.ТаблицаКомиссии;
	
	ИмяКолонкиСтрокаОбнаружена = "СтрокаОбнаружена";
	
	ДеревоДокументов.Колонки.Добавить(ИмяКолонкиСтрокаОбнаружена, Новый ОписаниеТипов("Булево"));
	
	Поиск = Новый Структура();
	
	МассивУдаляемыхСтрок = Новый Массив();
	
	Для Каждого Документ Из СписокДокументов Цикл
		Поиск.Вставить("Документ", Документ);
		
		МассивСтрок = ДеревоДокументов.Строки.НайтиСтроки(Поиск, Истина);
		
		Для Каждого СтрокаДокумента Из МассивСтрок Цикл
			СтрокаДокумента[ИмяКолонкиСтрокаОбнаружена] = Истина;
			
			СтрокаРодитель = СтрокаДокумента.Родитель;
			
			Пока СтрокаРодитель <> Неопределено Цикл
				Если СтрокаРодитель[ИмяКолонкиСтрокаОбнаружена] Тогда
					Прервать
				КонецЕсли;
				
				СтрокаРодитель[ИмяКолонкиСтрокаОбнаружена] = Истина;
				
				СтрокаРодитель = СтрокаРодитель.Родитель;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	Поиск = Новый Структура(ИмяКолонкиСтрокаОбнаружена, Ложь);
	
	// Удаляем по одной строке
	Пока Истина Цикл
		МассивСтрок = ДеревоДокументов.Строки.НайтиСтроки(Поиск, Истина);
		
		Если МассивСтрок.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		
		СтрокаДокумента = МассивСтрок[0];
		
		СтрокаРодитель = СтрокаДокумента.Родитель;
		
		Если СтрокаРодитель = Неопределено Тогда
			СтрокиРодителя = ДеревоДокументов.Строки;
		Иначе
			СтрокиРодителя = СтрокаРодитель.Строки;
		КонецЕсли;
		
		СтрокиРодителя.Удалить(СтрокаДокумента);
	КонецЦикла;
	
	ДеревоДокументов.Колонки.Удалить(ДеревоДокументов.Колонки[ИмяКолонкиСтрокаОбнаружена]);
	
КонецПроцедуры

Процедура ДобавитьВДеревоТабличныеЧастиДокументов(ДеревоДокументов, ОбщаяТаблицаКомиссий)
	
	// Из таблицы удаляются строки документов, отсутствующих в дереве
	
	ТипНомерСтроки = ОбщегоНазначения.ОписаниеТипаЧисло(6,0,ДопустимыйЗнак.Неотрицательный);
	ТипКомиссия = Новый ОписаниеТипов("СправочникСсылка.ПостоянноДействующиеКомиссии");
	
	ВремТаблица = ОбщаяТаблицаКомиссий.Скопировать(, "Документ");
	ВремТаблица.Свернуть("Документ");
	МассивДокументов = ВремТаблица.ВыгрузитьКолонку("Документ");
	
	Поиск = Новый Структура();
	
	Для Каждого Документ Из МассивДокументов Цикл
		Поиск.Вставить("Документ", Документ);
		
		МассивСтрокДерева = ДеревоДокументов.Строки.НайтиСтроки(Поиск, Истина);
		
		Если МассивСтрокДерева.Количество() = 0 Тогда
			МассивСтрокТаблицы = ОбщаяТаблицаКомиссий.НайтиСтроки(Поиск);
			
			Для Каждого СтрокаТаблицы Из МассивСтрокТаблицы Цикл
				ОбщаяТаблицаКомиссий.Удалить(СтрокаТаблицы);
			КонецЦикла;
		Иначе
			ТаблицаКомиссии = ОбщаяТаблицаКомиссий.Скопировать(Поиск);
			ТаблицаКомиссии.Колонки.Удалить(ТаблицаКомиссии.Колонки.Документ);
			
			Для Каждого СтрокаДерева Из МассивСтрокДерева Цикл
				СтрокаДерева["ТаблицаКомиссии"] = ТаблицаКомиссии;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьПустуюТаблицуПодразделовРаздела2()
	
	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("КомиссияЗаголовка",				Новый ОписаниеТипов("СправочникСсылка.ПостоянноДействующиеКомиссии"));
	Таблица.Колонки.Добавить("ПодразделОтменен",				Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("ТаблицаСравненияСоставаКомиссий",	Новый ОписаниеТипов("ТаблицаЗначений"));
	Таблица.Колонки.Добавить("ТабличныйДокумент",				Новый ОписаниеТипов("ТабличныйДокумент"));
	Таблица.Колонки.Добавить("ЕстьМодифицированныеСтроки",		Новый ОписаниеТипов("Булево"));
	
	Возврат Таблица;
	
КонецФункции

Функция ПолучитьНастройкиТаблицыСравненияСоставаКомиссий()
	
	Показатели = Новый Структура();
	
	// 6 шт
	ИменаПоказателей = Новый Массив();
	ИменаПоказателей.Добавить("Временная");
	ИменаПоказателей.Добавить("СтатусЧленаКомиссии");
	ИменаПоказателей.Добавить("Сотрудник");
	ИменаПоказателей.Добавить("ФИО");
	ИменаПоказателей.Добавить("Должность");
	ИменаПоказателей.Добавить("НомерРабочейКомиссии");
	
	Показатели.Вставить("ДопустимаКорректировка", Новый ФиксированныйМассив(ИменаПоказателей));
	
	ПостфиксИмениАктуальный = "";
	ПостфиксИмениДоИзменения = "ДоИзменения";
	ПостфиксИмениПредыдущий = "Предыдущий";
	
	ПостфиксыИменКолонокПоказателей = Новый Структура();
	ПостфиксыИменКолонокПоказателей.Вставить("Актуальный", ПостфиксИмениАктуальный);
	ПостфиксыИменКолонокПоказателей.Вставить("ДоИзменения", ПостфиксИмениДоИзменения);
	ПостфиксыИменКолонокПоказателей.Вставить("Предыдущий", ПостфиксИмениПредыдущий);
	
	ТипБулево = Новый ОписаниеТипов("Булево");
	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипЦелоеЧисло = ОбщегоНазначения.ОписаниеТипаЧисло(6,0,ДопустимыйЗнак.Неотрицательный);
	ТипСотрудник = Новый ОписаниеТипов("СправочникСсылка.Сотрудники");
	ТипСтатусЧленаКомиссии = Новый ОписаниеТипов("ПеречислениеСсылка.СтатусыЧленовКомиссии");
	ТипТипИзменения = Новый ОписаниеТипов("ПеречислениеСсылка.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации");
	
	Таблица = Новый ТаблицаЗначений();
	
	Таблица.Колонки.Добавить("НомерСтроки",					ТипЦелоеЧисло);
	Таблица.Колонки.Добавить("Модифицированность",			ТипБулево);
	Таблица.Колонки.Добавить("ТипИзменения",				ТипТипИзменения);
	Таблица.Колонки.Добавить("ЭтоСтрокаИсходногоРешения",	ТипБулево);
	Таблица.Колонки.Добавить("ЭтоДобавленнаяСтрока",		ТипБулево);
	
	Таблица.Колонки.Добавить("Временная" + ПостфиксИмениАктуальный,				ТипБулево);
	Таблица.Колонки.Добавить("Временная" + ПостфиксИмениДоИзменения,			ТипБулево);
	Таблица.Колонки.Добавить("Временная" + ПостфиксИмениПредыдущий,				ТипБулево);
	
	Таблица.Колонки.Добавить("СтатусЧленаКомиссии" + ПостфиксИмениАктуальный,	ТипСтатусЧленаКомиссии);
	Таблица.Колонки.Добавить("СтатусЧленаКомиссии" + ПостфиксИмениДоИзменения,	ТипСтатусЧленаКомиссии);
	Таблица.Колонки.Добавить("СтатусЧленаКомиссии" + ПостфиксИмениПредыдущий,	ТипСтатусЧленаКомиссии);
	
	Таблица.Колонки.Добавить("Сотрудник" + ПостфиксИмениАктуальный,				ТипСотрудник);
	Таблица.Колонки.Добавить("Сотрудник" + ПостфиксИмениДоИзменения,			ТипСотрудник);
	Таблица.Колонки.Добавить("Сотрудник" + ПостфиксИмениПредыдущий,				ТипСотрудник);
	
	Таблица.Колонки.Добавить("ФИО" + ПостфиксИмениАктуальный,					ТипСтрока);
	Таблица.Колонки.Добавить("ФИО" + ПостфиксИмениДоИзменения,					ТипСтрока);
	Таблица.Колонки.Добавить("ФИО" + ПостфиксИмениПредыдущий,					ТипСтрока);
	
	Таблица.Колонки.Добавить("Должность" + ПостфиксИмениАктуальный,				ТипСтрока);
	Таблица.Колонки.Добавить("Должность" + ПостфиксИмениДоИзменения,			ТипСтрока);
	Таблица.Колонки.Добавить("Должность" + ПостфиксИмениПредыдущий,				ТипСтрока);
	
	Таблица.Колонки.Добавить("НомерРабочейКомиссии" + ПостфиксИмениАктуальный,	ТипЦелоеЧисло);
	Таблица.Колонки.Добавить("НомерРабочейКомиссии" + ПостфиксИмениДоИзменения,	ТипЦелоеЧисло);
	Таблица.Колонки.Добавить("НомерРабочейКомиссии" + ПостфиксИмениПредыдущий,	ТипЦелоеЧисло);
	
	Настройки = Новый Структура();
	Настройки.Вставить("Таблица",							Таблица);
	Настройки.Вставить("Показатели",						Показатели);
	Настройки.Вставить("ПостфиксыИменКолонокПоказателей",	ПостфиксыИменКолонокПоказателей);
	
	Возврат Настройки;
	
КонецФункции

Функция ИнициализироватьТаблицуСравненияСоставовДвухКомиссий(Комиссия, Дата, ДополнительныеПараметры, НовыйПодраздел = Ложь)
	
	НастройкиТаблицы	= ДополнительныеПараметры.НастройкиТаблицы;
	ДанныеКомиссий		= ДополнительныеПараметры.ДанныеКомиссий;
	
	Показатели					= НастройкиТаблицы.Показатели;
	ПостфиксИмениАктуальный		= НастройкиТаблицы.ПостфиксыИменКолонокПоказателей.Актуальный;
	ПостфиксИмениДоИзменения	= НастройкиТаблицы.ПостфиксыИменКолонокПоказателей.ДоИзменения;
	ПостфиксИмениПредыдущий		= НастройкиТаблицы.ПостфиксыИменКолонокПоказателей.Предыдущий;
	Таблица						= НастройкиТаблицы.Таблица.СкопироватьКолонки();
	
	ПоискКомиссия = Новый Структура("Ссылка", Комиссия);
	
	МассивСтрокШапкиКомиссии = ДанныеКомиссий.Шапки.НайтиСтроки(ПоискКомиссия);
	
	Если МассивСтрокШапкиКомиссии.Количество() = 0 Тогда
		Возврат Таблица;
	КонецЕсли;
	
	СтрокаШапкиКомиссии = МассивСтрокШапкиКомиссии[0];
	
	МассивСтрокСоставаКомиссии = ДанныеКомиссий.СоставыКомиссий.НайтиСтроки(ПоискКомиссия);
	
	КоличествоСтрок = МассивСтрокСоставаКомиссии.Количество();
	
	// ФИО и должности сотрудников на даты
	
	ТребуемыеДанные = "НаименованиеПолное,ДолжностьНаименование";
	
	ПолучитьДолжность = Истина;
	
	ВремТаблица = ДанныеКомиссий.СоставыКомиссий.Скопировать(МассивСтрокСоставаКомиссии, "Сотрудник");
	ВремТаблица.Свернуть("Сотрудник");
	МассивСотрудников = ВремТаблица.ВыгрузитьКолонку("Сотрудник");
	ТаблицаДанныхСотрудников = Справочники.Сотрудники.ПолучитьДанныеСотрудников(МассивСотрудников, ТребуемыеДанные, Дата);
	
	ЗначенияПараметров = Новый Структура();
	
	Для НомерСтроки = 1 По КоличествоСтрок Цикл
		
		ЗначенияПараметров.Вставить("НомерСтроки", НомерСтроки);
		
		СтрокаКомиссии = МассивСтрокСоставаКомиссии[НомерСтроки - 1];
		
		ДанныеСотрудника = Документы.ИзменениеРешенияОПроведенииИнвентаризации.ПолучитьДанныеСотрудника(
			ТаблицаДанныхСотрудников,
			СтрокаКомиссии.Сотрудник,
			ПолучитьДолжность);
			
		// Показатели ДоИзменения
		ДобавитьПоказателиСтрокиИзмененияСоставаКомиссии(
			ЗначенияПараметров,
			СтрокаШапкиКомиссии,
			СтрокаКомиссии,
			ДанныеСотрудника,
			ПостфиксИмениДоИзменения);
			
		// Показатели Предыдущие
		ДобавитьПоказателиСтрокиИзмененияСоставаКомиссии(
			ЗначенияПараметров,
			СтрокаШапкиКомиссии,
			СтрокаКомиссии,
			ДанныеСотрудника,
			ПостфиксИмениПредыдущий);
			
		// Показатели Актуальные
		ДобавитьПоказателиСтрокиИзмененияСоставаКомиссии(
			ЗначенияПараметров,
			СтрокаШапкиКомиссии,
			СтрокаКомиссии,
			ДанныеСотрудника,
			ПостфиксИмениАктуальный);
		
		ТипИзменения = ?(НовыйПодраздел,
			ДополнительныеПараметры.ТипИзменения.Дополнение,
			ДополнительныеПараметры.ТипИзменения.Пустой);
		
		ЗначенияПараметров.Вставить("ТипИзменения",					ТипИзменения);
		ЗначенияПараметров.Вставить("Модифицированность",			НовыйПодраздел);
		ЗначенияПараметров.Вставить("ЭтоСтрокаИсходногоРешения",	Истина);
		
		НоваяСтрока = Таблица.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЗначенияПараметров);
		
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

Процедура ДобавитьСравнениеСоставаКомиссии(ТаблицаСравнения, Комиссия, Дата, ДополнительныеПараметры)
	
	НастройкиТаблицы						= ДополнительныеПараметры.НастройкиТаблицы;
	ДанныеКомиссий							= ДополнительныеПараметры.ДанныеКомиссий;
	КорректироватьДобавленныеСтрокиРешения	= ДополнительныеПараметры.КорректироватьДобавленныеСтрокиРешения;
	
	Показатели					= НастройкиТаблицы.Показатели;
	ПостфиксИмениАктуальный		= НастройкиТаблицы.ПостфиксыИменКолонокПоказателей.Актуальный;
	ПостфиксИмениДоИзменения	= НастройкиТаблицы.ПостфиксыИменКолонокПоказателей.ДоИзменения;
	ПостфиксИмениПредыдущий		= НастройкиТаблицы.ПостфиксыИменКолонокПоказателей.Предыдущий;
	Таблица						= НастройкиТаблицы.Таблица.СкопироватьКолонки();
	
	ТипИзмененияОтмена			= ДополнительныеПараметры.ТипИзменения.Отмена;
	ТипИзмененияКорректировка	= ДополнительныеПараметры.ТипИзменения.Корректировка;
	ТипИзмененияДополнение		= ДополнительныеПараметры.ТипИзменения.Дополнение;
	ТипИзмененияПустой			= ДополнительныеПараметры.ТипИзменения.Пустой;
	
	ПоискКомиссия = Новый Структура("Ссылка", Комиссия);
	
	МассивСтрокШапкиКомиссии = ДанныеКомиссий.Шапки.НайтиСтроки(ПоискКомиссия);
	
	Если МассивСтрокШапкиКомиссии.Количество() = 0 Тогда
		ТаблицаСравнения.Очистить();
		Возврат;
	КонецЕсли;
	
	Если ДанныеКомиссий.СоставыКомиссий.Колонки.Найти("СтрокаОбработана") = Неопределено Тогда
		ДанныеКомиссий.СоставыКомиссий.Колонки.Добавить("СтрокаОбработана", Новый ОписаниеТипов("Булево"));
	КонецЕсли;
	
	ДанныеКомиссий.СоставыКомиссий.ЗаполнитьЗначения(Ложь, "СтрокаОбработана");
	
	СтрокаШапкиКомиссии = МассивСтрокШапкиКомиссии[0];
	
	// ФИО и должности сотрудников на даты
	ТребуемыеДанные = "НаименованиеПолное,ДолжностьНаименование";
	ПолучитьДолжность = Истина;
	
	ВремТаблица = ДанныеКомиссий.СоставыКомиссий.Скопировать(ПоискКомиссия, "Сотрудник");
	ВремТаблица.Свернуть("Сотрудник");
	МассивСотрудников = ВремТаблица.ВыгрузитьКолонку("Сотрудник");
	ТаблицаДанныхСотрудников = Справочники.Сотрудники.ПолучитьДанныеСотрудников(МассивСотрудников, ТребуемыеДанные, Дата);
	
	ПоискСотрудникаВКомиссии = Новый Структура("Ссылка,Сотрудник,СтрокаОбработана",
		Комиссия, Неопределено, Ложь);
	
	Для Каждого СтрокаТаблицыСравнения Из ТаблицаСравнения Цикл
		ЗначенияПараметров = Новый Структура();
		
		Модифицированность = Ложь;
		
		ПоискСотрудникаВКомиссии.Сотрудник = СтрокаТаблицыСравнения.Сотрудник;
		
		МассивСтрокСоставаКомиссии = ДанныеКомиссий.СоставыКомиссий.НайтиСтроки(ПоискСотрудникаВКомиссии);
		
		Если МассивСтрокСоставаКомиссии.Количество() = 0 Тогда
			// В комиссии не нашлось такого сотрудника.
			ТипИзменения = СтрокаТаблицыСравнения.ТипИзменения;
			
			Если ТипИзменения <> ТипИзмененияОтмена Тогда
				ТипИзменения = ТипИзмененияОтмена;
				
				Модифицированность = Истина;
			КонецЕсли;
			
			ЗначенияПараметров.Вставить("ТипИзменения", ТипИзменения);
			ЗначенияПараметров.Вставить("Модифицированность", Модифицированность);
			
			ЗаполнитьЗначенияСвойств(СтрокаТаблицыСравнения, ЗначенияПараметров);
		Иначе
			СтрокаСоставаКомиссии = МассивСтрокСоставаКомиссии[0];
			
			СтрокаСоставаКомиссии.СтрокаОбработана = Истина;
			
			ДанныеСотрудника = Документы.ИзменениеРешенияОПроведенииИнвентаризации.ПолучитьДанныеСотрудника(
				ТаблицаДанныхСотрудников,
				СтрокаСоставаКомиссии.Сотрудник,
				ПолучитьДолжность);
			
			ЗаполнитьНаОснованииКолонкиПредыдущий(ЗначенияПараметров, СтрокаТаблицыСравнения, НастройкиТаблицы);
			
			// Показатели Актуальные
			ДобавитьПоказателиСтрокиИзмененияСоставаКомиссии(
				ЗначенияПараметров,
				СтрокаШапкиКомиссии,
				СтрокаСоставаКомиссии,
				ДанныеСотрудника,
				ПостфиксИмениАктуальный);
			
			Модифицированность = ОпределитьМодифицированность(
				ЗначенияПараметров,
				Показатели.ДопустимаКорректировка,
				ПостфиксИмениАктуальный,
				ПостфиксИмениПредыдущий);
			
			ТипИзменения				= СтрокаТаблицыСравнения.ТипИзменения;
			ЭтоСтрокаИсходногоРешения	= СтрокаТаблицыСравнения.ЭтоСтрокаИсходногоРешения;
			ЭтоДобавленнаяСтрока		= СтрокаТаблицыСравнения.ЭтоДобавленнаяСтрока;
			
			СовпадаютПоказатели = СовпадаютПоказателиАктуальныеИДоИзменения(ЗначенияПараметров, СтрокаТаблицыСравнения, НастройкиТаблицы);
			
			Если ТипИзменения = ТипИзмененияПустой Тогда
				
				Если Модифицированность Тогда
					ТипИзменения = ТипИзмененияКорректировка;
				КонецЕсли;
				
			ИначеЕсли ТипИзменения = ТипИзмененияКорректировка Тогда
				
				Если ЭтоСтрокаИсходногоРешения И СовпадаютПоказатели Тогда
					ТипИзменения = ТипИзмененияПустой;
					
				ИначеЕсли ЭтоДобавленнаяСтрока И СовпадаютПоказатели Тогда
					ТипИзменения = ТипИзмененияДополнение;
					
				КонецЕсли;
				
			ИначеЕсли ТипИзменения = ТипИзмененияОтмена Тогда
				
				ТипИзменения = ТипИзмененияКорректировка;
				
				Если ЭтоСтрокаИсходногоРешения И СовпадаютПоказатели Тогда
					ТипИзменения = ТипИзмененияПустой;
					Модифицированность = Истина;
					
				ИначеЕсли ЭтоДобавленнаяСтрока И НЕ КорректироватьДобавленныеСтрокиРешения Тогда
					ТипИзменения = ТипИзмененияДополнение;
					
				КонецЕсли;
				
			ИначеЕсли ТипИзменения = ТипИзмененияДополнение Тогда
				
				Если Модифицированность И КорректироватьДобавленныеСтрокиРешения Тогда
					ТипИзменения = ТипИзмененияКорректировка;
				КонецЕсли;
			КонецЕсли;
			
			ЗначенияПараметров.Вставить("ТипИзменения", ТипИзменения);
			ЗначенияПараметров.Вставить("Модифицированность", Модифицированность);
			
			ЗаполнитьЗначенияСвойств(СтрокаТаблицыСравнения, ЗначенияПараметров);
		КонецЕсли;
	КонецЦикла;
	
	// Строки состава комиссии, оставшиеся необработанными - это новые строки (Дополнение)
	Поиск = Новый Структура("Ссылка,СтрокаОбработана", Комиссия, Ложь);
	
	МассивСтрокСоставаКомиссии = ДанныеКомиссий.СоставыКомиссий.НайтиСтроки(Поиск);
	
	НомерСтроки = ТаблицаСравнения.Количество();
	
	Для Каждого СтрокаСоставаКомиссии Из МассивСтрокСоставаКомиссии Цикл
		НомерСтроки = НомерСтроки + 1;
		
		СтрокаСоставаКомиссии.СтрокаОбработана = Истина;
		
		ДанныеСотрудника = Документы.ИзменениеРешенияОПроведенииИнвентаризации.ПолучитьДанныеСотрудника(
			ТаблицаДанныхСотрудников,
			СтрокаСоставаКомиссии.Сотрудник,
			ПолучитьДолжность);
			
		СтрокаТаблицыСравнения = ТаблицаСравнения.Добавить();
			
		СтрокаТаблицыСравнения.НомерСтроки = НомерСтроки;
		СтрокаТаблицыСравнения.ЭтоДобавленнаяСтрока = Истина;
		
		// Показатели Актуальные
		ДобавитьПоказателиСтрокиИзмененияСоставаКомиссии(
			ЗначенияПараметров,
			СтрокаШапкиКомиссии,
			СтрокаСоставаКомиссии,
			ДанныеСотрудника,
			ПостфиксИмениАктуальный);
			
		// Показатели ДоИзменения
		ДобавитьПоказателиСтрокиИзмененияСоставаКомиссии(
			ЗначенияПараметров,
			СтрокаШапкиКомиссии,
			СтрокаСоставаКомиссии,
			ДанныеСотрудника,
			ПостфиксИмениДоИзменения);
			
		ЗначенияПараметров.Вставить("ТипИзменения", ТипИзмененияДополнение);
		ЗначенияПараметров.Вставить("Модифицированность", Истина);
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицыСравнения, ЗначенияПараметров);
	КонецЦикла;
	
КонецПроцедуры

Функция ОпределитьМодифицированность(Данные, ИменаПоказателей, ПостфиксИмениАктуальный, ПостфиксИмениПредыдущий)
	
	Для Каждого Показатель Из ИменаПоказателей Цикл
		
		Если Данные[Показатель + ПостфиксИмениАктуальный] <> Данные[Показатель + ПостфиксИмениПредыдущий] Тогда
			
			Возврат Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Процедура ДобавитьПоказателиСтрокиИзмененияСоставаКомиссии(ЗначенияПараметров, СтрокаШапкиКомиссии, СтрокаКомиссии, ДанныеСотрудника, ПостфиксИмени)
	
	ЗначенияПараметров.Вставить("Временная" + ПостфиксИмени,			СтрокаШапкиКомиссии.Временная);
	ЗначенияПараметров.Вставить("Сотрудник" + ПостфиксИмени,			СтрокаКомиссии.Сотрудник);
	ЗначенияПараметров.Вставить("ФИО" + ПостфиксИмени,					ДанныеСотрудника.ФИО);
	ЗначенияПараметров.Вставить("Должность" + ПостфиксИмени,			ДанныеСотрудника.Должность);
	ЗначенияПараметров.Вставить("СтатусЧленаКомиссии" + ПостфиксИмени,	СтрокаКомиссии.СтатусЧленаКомиссии);
	ЗначенияПараметров.Вставить("НомерРабочейКомиссии" + ПостфиксИмени,	СтрокаКомиссии.НомерРабочейКомиссии);
	
КонецПроцедуры

Процедура ЗаполнитьНаОснованииКолонкиПредыдущий(ЗначенияПараметров, СтрокаТаблицыСравненияСоставовКомиссий, НастройкиТаблицы)
	
	ИменаПоказателей = НастройкиТаблицы.Показатели.ДопустимаКорректировка;
	
	ПостфиксАктуальный	= НастройкиТаблицы.ПостфиксыИменКолонокПоказателей.Актуальный;
	ПостфиксПредыдущий	= НастройкиТаблицы.ПостфиксыИменКолонокПоказателей.Предыдущий;
	
	Для Каждого ИмяПоказателя Из ИменаПоказателей Цикл
		
		ЗначенияПараметров.Вставить(
			ИмяПоказателя + ПостфиксПредыдущий,
			СтрокаТаблицыСравненияСоставовКомиссий[ИмяПоказателя + ПостфиксАктуальный]);
		
	КонецЦикла;
	
КонецПроцедуры

Функция СовпадаютПоказателиАктуальныеИДоИзменения(ЗначенияПараметров, СтрокаТаблицыСравненияСоставовКомиссий, НастройкиТаблицы)
	
	ИменаПоказателей = НастройкиТаблицы.Показатели.ДопустимаКорректировка;
	
	ПостфиксАктуальный	= НастройкиТаблицы.ПостфиксыИменКолонокПоказателей.Актуальный;
	ПостфиксДоИзменения	= НастройкиТаблицы.ПостфиксыИменКолонокПоказателей.ДоИзменения;
	
	Совпадают = Истина;
	
	Для Каждого ИмяПоказателя Из ИменаПоказателей Цикл
		
		Совпадают = (ЗначенияПараметров[ИмяПоказателя + ПостфиксАктуальный] =
			СтрокаТаблицыСравненияСоставовКомиссий[ИмяПоказателя + ПостфиксДоИзменения]);
			
		Если НЕ Совпадают Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Совпадают;
	
КонецФункции

