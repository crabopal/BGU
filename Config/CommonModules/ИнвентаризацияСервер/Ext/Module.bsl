Процедура ЗавершитьЗаполнениеОписиПоРешению(ОбъектОписи, Данные, Подгруппа, НомерСтрокиТаблицыОтметок = Неопределено)
	
	ТипОписи = Подгруппа.НастройкиОписи.ТипОписи;
	
	Если ТипОписи = Тип("ДокументСсылка.ИнвентаризацияМЗ") Тогда
		СчетГруппа = Документы.ИнвентаризацияМЗ.ОпределитьГруппуСчетовПоСчету(
			ОбъектОписи.Счет,
			ОбъектОписи.ДатаИнвентаризации,
			ОбъектОписи.Организация);
		
		ОбъектОписи.СчетГруппа = СчетГруппа;
		
	ИначеЕсли ТипОписи = Тип("ДокументСсылка.ИнвентаризацияКассы") Тогда
		Счет03 = БухгалтерскийУчет.СчетПоКоду("03", ОбъектОписи.ДатаИнвентаризации);
		
		Счета03 = БухгалтерскийУчет.СписокСчетов("03", ОбъектОписи.ДатаИнвентаризации);
		
		ОчиститьСчет = (Счета03.Найти(ОбъектОписи.СчетУчетаБСО) = Неопределено) Или ОбъектОписи.СчетУчетаБСО = Счет03;
		
		Если ОчиститьСчет Тогда
			ОбъектОписи.СчетУчетаБСО = Неопределено;
		КонецЕсли;
		
	ИначеЕсли ТипОписи = Тип("ДокументСсылка.ИнвентаризационнаяОписьНФА") Тогда
		СтрокаТаблицыОтметок = Данные.ДополнительныеПараметры.ТаблицаОтметок[НомерСтрокиТаблицыОтметок - 1];
		
		ОбъектОписи.ЭтоВыборочнаяИнвентаризация =
			СтрокаТаблицыОтметок.ПризнакВыборочнойИнвентаризации
			И Не СтрокаТаблицыОтметок.ПризнакСплошнойИнвентаризации
			И Не СтрокаТаблицыОтметок.ПризнакИнойИнвентаризации;
	КонецЕсли;
	
КонецПроцедуры

