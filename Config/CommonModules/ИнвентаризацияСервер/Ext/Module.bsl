Функция НовыйПараметрыПоискаДанныхДляГрупповогоФормированияОписей() Экспорт
	
	ПараметрыПоиска = Новый Структура();
	ПараметрыПоиска.Вставить("Организация", Неопределено);
	ПараметрыПоиска.Вставить("ДатаРешения", Неопределено);
	ПараметрыПоиска.Вставить("ИскатьОписиПоПриказу52н", Истина);
	ПараметрыПоиска.Вставить("ОтборМассивКодовФорм", Новый Массив());
	
	Возврат ПараметрыПоиска;
	
КонецФункции

// Параметры:
//	РешениеСсылка - ДокументСсылка.РешениеОПроведенииИнвентаризации
//	ПараметрыПоиска - Структура - см. НовыйПараметрыПоискаДанныхДляГрупповогоФормированияОписей()
Функция ПолучитьДанныеДляГрупповогоФормированияОписей(РешениеСсылка, ПараметрыПоиска) Экспорт
	
	Организация				= ПараметрыПоиска.Организация;
	ДатаРешения				= ПараметрыПоиска.ДатаРешения;
	ИскатьОписиПоПриказу52н	= ПараметрыПоиска.ИскатьОписиПоПриказу52н;
	
	Если Не ЗначениеЗаполнено(Организация) Или Не ЗначениеЗаполнено(ДатаРешения) Тогда
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РешениеСсылка, "Дата,Организация");
		
		Если Не ЗначениеЗаполнено(Организация) Тогда
			Организация = ЗначенияРеквизитов.Организация;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ДатаРешения) Тогда
			ДатаРешения = ЗначенияРеквизитов.Дата;
		КонецЕсли;
	КонецЕсли;
	
	СписокРешений = Новый Массив();
	СписокРешений.Добавить(РешениеСсылка);
	
	ТаблицаНастроек = ПолучитьТаблицуНастроекЗаполненияОписейПоРешению(, Истина, Организация);
	
	ТаблицыДокументов = НайтиДокументыСоставляющиеЦепочки(СписокРешений, Неопределено);
	
	ПоследниеДокументыДеревьев = НайтиПоследниеДокументыДеревьев(ТаблицыДокументов);
	
	ПризнакиДокументовРешений = ПолучитьПризнакиДокументовРешений(СписокРешений, ТаблицыДокументов, ПоследниеДокументыДеревьев);
	
	ТаблицаОбъекты = ПрочитатьТаблицуОбъектыПоследнихДокументовДеревьев(ПоследниеДокументыДеревьев);
	
	СопоставитьТаблицыОбъектовИНастроек(ТаблицаОбъекты, ТаблицаНастроек);
	
	ЗаполнитьКолонкуКодФормыВТаблицеОбъекты(ТаблицаОбъекты, ТаблицаНастроек, ДатаРешения, ПризнакиДокументовРешений);
	
	ПрименитьОтборТаблицыОбъектыДляГрупповогоФормированияОписей(ТаблицаОбъекты, ПараметрыПоиска);
	
	РазличныеКодыФорм = Неопределено;
	
	ДополнитьТаблицуОбъектыКолонкамиКодовФормДляБыстрогоПоиска(ТаблицаОбъекты, РазличныеКодыФорм);
	
	ТаблицыОписей = ПрочитатьТаблицыОписейДляГрупповогоФормированияОписей(СписокРешений, ПараметрыПоиска, РазличныеКодыФорм);
	
	РасположенияРеквизитовОписей = ПолучитьРасположенияРеквизитовОписей(ТаблицыОписей, ТаблицаНастроек);
	
	НастройкиИменПолейРешения = ПолучитьНастройкиИменПолейРешенияДляСопоставленияСШапкамиОписей(РасположенияРеквизитовОписей, ТаблицаНастроек);
	
	СопоставитьОписиСТаблицейОбъекты(СписокРешений, ТаблицаОбъекты, ТаблицыОписей, ТаблицаНастроек, РасположенияРеквизитовОписей,
		НастройкиИменПолейРешения);
	
	ПризнакиРешения = ПризнакиДокументовРешений.Получить(РешениеСсылка);
	
	Данные = Новый Структура();
	Данные.Вставить("ТаблицаОбъекты", ТаблицаОбъекты);
	Данные.Вставить("ТаблицыОписей", ТаблицыОписей);
	Данные.Вставить("ТаблицаНастроек", ТаблицаНастроек);
	Данные.Вставить("ПризнакиРешения", ПризнакиРешения);
	Данные.Вставить("РасположенияРеквизитовОписей", РасположенияРеквизитовОписей);
	Данные.Вставить("РазличныеКодыФорм", РазличныеКодыФорм);
	Данные.Вставить("ДатаРешения", ДатаРешения);
	
	Возврат Данные;
	
КонецФункции

#КонецОбласти

#Область ЗаполнениеДокументовОписей

Функция НовыйРезультатРасчетаИндексовСтрокТаблицыРешенияДляГрупповогоФормированияОписей() Экспорт
	
	РезультатРасчета = Новый Структура();
	РезультатРасчета.Вставить("ПараметрыРасчета");
	РезультатРасчета.Вставить("СвойстваКодовФормСозданиеПредусмотрено");
	РезультатРасчета.Вставить("ВсеИндексыСтрок");
	РезультатРасчета.Вставить("МассивКодовФормКСозданию");
	
	Возврат РезультатРасчета;
	
КонецФункции

Функция НовыйПараметрыФормированияДокументовОписейДляГрупповогоФормированияОписей() Экспорт
	
	ПараметрыФормирования = Новый Структура();
	ПараметрыФормирования.Вставить("УстанавливатьКомментарий", Ложь);
	ПараметрыФормирования.Вставить("ШаблонКомментария", "");
	
	Возврат ПараметрыФормирования;
	
КонецФункции

// Параметры:
//	РезультатРасчета - Структура - см. НовыйРезультатРасчетаИндексовСтрокТаблицыРешенияДляГрупповогоФормированияОписей()
//	ПризнакиРешения - Структура - см. НовыйПризнакиДокументаРешения()
//	ПараметрыФормирования - Структура - см. НовыйПараметрыФормированияДокументовОписейДляГрупповогоФормированияОписей()
Функция СформироватьДокументыОписейДляГрупповогоФормированияОписей(РезультатРасчета, ПризнакиРешения, ПараметрыФормирования) Экспорт
	
	СвойстваКодовФормСозданиеПредусмотрено	= РезультатРасчета.СвойстваКодовФормСозданиеПредусмотрено;
	ВсеИндексыСтрок							= РезультатРасчета.ВсеИндексыСтрок;
	РешениеСсылка							= РезультатРасчета.ПараметрыРасчета.РешениеСсылка;
	ОтмеченныеСтрокиТаблицыРешения			= РезультатРасчета.ПараметрыРасчета.ОтмеченныеСтрокиТаблицыРешения;
	
	СписокРешений = Новый Массив();
	СписокРешений.Добавить(РешениеСсылка);
	
	СведенияКомиссий = ПрочитатьСведенияКомиссийДляГрупповогоФормированияОписей(РешениеСсылка, ПризнакиРешения);
	
	ТекстОшибкиКраткий = "";
	
	СчетчикиДокументовПоКодамФорм = Новый Соответствие();
	
	ОбщийСчетчикДокументов = НовыйСчетчикДокументовДляГрупповогоФормированияОписей();
	ОбщийСчетчикДокументов.Количество = ПолучитьОбщееКоличествоДокументовДляГрупповогоФормированияОписей(ВсеИндексыСтрок);
	
	ДатаДокументов = ТекущаяДатаСеанса();
	
	// Цикл по кодам форм.
	Для Каждого Элемент Из ВсеИндексыСтрок Цикл
		КодФормы = Элемент.Ключ;
		МассивыИндексовСтрок = Элемент.Значение;
		
		СвойстваКодаФормы = СвойстваКодовФормСозданиеПредусмотрено.Получить(КодФормы);
		
		ИмяДокумента			= СвойстваКодаФормы.ИмяДокумента;
		РасположениеРеквизитов	= СвойстваКодаФормы.РасположениеРеквизитов;
		
		СчетчикДокументовКодаФормы = НовыйСчетчикДокументовДляГрупповогоФормированияОписей();
		СчетчикДокументовКодаФормы.Количество = МассивыИндексовСтрок.Количество();
		
		// Цикл по документам текущего кода формы.
		Для Каждого ИндексыСтрок Из МассивыИндексовСтрок Цикл
			ОбщийСчетчикДокументов.Счетчик = ОбщийСчетчикДокументов.Счетчик + 1;
			СчетчикДокументовКодаФормы.Счетчик = СчетчикДокументовКодаФормы.Счетчик + 1;
			
			ПерваяСтрокаТаблицыРешения = ОтмеченныеСтрокиТаблицыРешения[ИндексыСтрок[0]];
			
			ДокументОбъект = Документы[ИмяДокумента].СоздатьДокумент();
			
			ДокументОбъект.Заполнить(Неопределено); // Для заполнения реквизитов по умолчанию.
			
			Данные = Новый Структура();
			Данные.Вставить("ДокументОбъект",					ДокументОбъект);
			Данные.Вставить("ИндексыСтрок",						ИндексыСтрок);
			Данные.Вставить("ОтмеченныеСтрокиТаблицыРешения",	ОтмеченныеСтрокиТаблицыРешения);
			Данные.Вставить("ПерваяСтрокаТаблицыРешения",		ПерваяСтрокаТаблицыРешения);
			Данные.Вставить("РасположениеРеквизитов",			РасположениеРеквизитов);
			Данные.Вставить("ОбщиеРеквизитыШапки",				ПолучитьОбщиеРеквизитыШапкиДляГрупповогоФормированияОписей(РешениеСсылка));
			Данные.Вставить("СведенияКомиссий",					СведенияКомиссий);
			
			ЗаполнитьНовыйДокументОписиДляГрупповогоФормированияОписей(Данные,
				ДатаДокументов, ПараметрыФормирования, ОбщийСчетчикДокументов, СчетчикДокументовКодаФормы);
				
			Попытка
				ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
				
				ОбщийСчетчикДокументов.Успех = ОбщийСчетчикДокументов.Успех + 1;
				СчетчикДокументовКодаФормы.Успех = СчетчикДокументовКодаФормы.Успех + 1;
			Исключение
				ОбщийСчетчикДокументов.Ошибка = ОбщийСчетчикДокументов.Ошибка + 1;
				СчетчикДокументовКодаФормы.Ошибка = СчетчикДокументовКодаФормы.Ошибка + 1;
				
				ИнформацияОбОшибке = ИнформацияОбОшибке();
				ТекстОшибки = СтрШаблон(НСтр("ru='Не удалось создать документ %1 по причине: '"), ИмяДокумента);
				ТекстОшибкиПолный = ТекстОшибки + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
				
				ОбъектМетаданных = ?(ДокументОбъект <> Неопределено, ДокументОбъект.Метаданные(), Неопределено);
				
				ЗаписьЖурналаРегистрации("Данные.Изменение",
					УровеньЖурналаРегистрации.Ошибка,
					ОбъектМетаданных,
					Неопределено,
					ТекстОшибкиПолный);
			КонецПопытки;
		КонецЦикла;
		
		СчетчикиДокументовПоКодамФорм.Вставить(КодФормы, СчетчикДокументовКодаФормы);
	КонецЦикла;
	
	ТекстСообщения = ПолучитьТекстСообщенияРезультатаФормированияУспехаДляГрупповогоФормированияОписей(
		ОбщийСчетчикДокументов, СчетчикиДокументовПоКодамФорм);
	
	РезультатФормирования = Новый Структура();
	РезультатФормирования.Вставить("ОбщийСчетчикДокументов", ОбщийСчетчикДокументов);
	РезультатФормирования.Вставить("СчетчикиДокументовПоКодамФорм", СчетчикиДокументовПоКодамФорм);
	РезультатФормирования.Вставить("ТекстСообщения", ТекстСообщения);
	
	Возврат РезультатФормирования;
	
КонецФункции

// СчетчикиДокументов - Соответствие - Ключ=код формы (Строка), Значение=количество документов (Число).
Функция ПолучитьТекстСообщенияКоличествоДокументовПоКодамФорм(СчетчикиДокументов) Экспорт
	
	Шаблон = НСтр("ru='%1 - %2'");
	
	ВремСписок = Новый СписокЗначений();
	
	Для Каждого Элемент Из СчетчикиДокументов Цикл
		КодФормы = Элемент.Ключ;
		КоличествоДокументов = Элемент.Значение;
		
		ТекстКоличествоДокументов = СтрокаСЧислом(";%1 документ;;%1 документа;%1 документов;%1 документов", // 0, 1, 2, немного, 5, другое
		    КоличествоДокументов,
		    ВидЧисловогоЗначения.Количественное);
		
		ВремСписок.Добавить(КодФормы, СтрШаблон(Шаблон, КодФормы, ТекстКоличествоДокументов));
	КонецЦикла;
	
	ВремСписок.СортироватьПоЗначению();
	
	МассивТекстов = Новый Массив();
	
	Для Каждого Элемент Из ВремСписок Цикл
		МассивТекстов.Добавить(Элемент.Представление);
	КонецЦикла;
	
	Возврат СтрСоединить(МассивТекстов, Символы.ПС);
	
КонецФункции

#КонецОбласти

