Функция ПолучитьПустуюТаблицуНастроекЗаполненияОписейПоРешению()
	
	ТипСтрока			= Новый ОписаниеТипов("Строка");
	ТипБулево			= Новый ОписаниеТипов("Булево");
	ТипТаблицаЗначений	= Новый ОписаниеТипов("ТаблицаЗначений");
	ТипДата				= ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата);
	
	ТаблицаНастроек = Новый ТаблицаЗначений();
	
	ТаблицаНастроек.Колонки.Добавить("КодФормы",					ТипСтрока);
	ТаблицаНастроек.Колонки.Добавить("ТипОписи",					Новый ОписаниеТипов("Тип"));
	ТаблицаНастроек.Колонки.Добавить("ИмяРеквизитаМОЛ",				ТипСтрока);
	ТаблицаНастроек.Колонки.Добавить("ИмяРеквизитаСчет",			ТипСтрока);
	ТаблицаНастроек.Колонки.Добавить("ИмяРеквизитаКФО",				ТипСтрока);
	ТаблицаНастроек.Колонки.Добавить("ИмяРеквизитаМестоИнвентаризации",				ТипСтрока);
	ТаблицаНастроек.Колонки.Добавить("ТаблицаКодовСчетов",			ТипТаблицаЗначений); // см. ПолучитьПустуюТаблицуКодовСчетов()
	ТаблицаНастроек.Колонки.Добавить("КомиссияУказываетсяСсылкой",	ТипБулево);
	ТаблицаНастроек.Колонки.Добавить("ИмяДокумента",				ТипСтрока); // заполняется автоматически, соответствует ТипуОписи
	ТаблицаНастроек.Колонки.Добавить("СинонимДокумента",			ТипСтрока); // заполняется автоматически, соответствует ТипуОписи
	ТаблицаНастроек.Колонки.Добавить("Приказ52н",					ТипБулево);
	ТаблицаНастроек.Колонки.Добавить("Приказ61н",					ТипБулево);
	ТаблицаНастроек.Колонки.Добавить("ОграниченияПримененияСчетов",	ТипСтрока);
	ТаблицаНастроек.Колонки.Добавить("ДатаНачалаПрименения",		ТипДата); // включая дату
	ТаблицаНастроек.Колонки.Добавить("ДатаОкончанияПримененияВключая",ТипДата); // включая дату
	
	Возврат ТаблицаНастроек;
	
КонецФункции

Функция НовыйОграниченияПримененияСчетов()
	
	ОграниченияПримененияСчетов = Новый Структура();
	ОграниченияПримененияСчетов.Вставить("ТолькоОдинДетальныйСчет", "ТолькоОдинДетальныйСчет");
	
	Возврат ОграниченияПримененияСчетов;
	
КонецФункции

Функция ПолучитьПустуюТаблицуКодовСчетов()
	
	ТипСтрока	= Новый ОписаниеТипов("Строка");
	ТипДата		= ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата);
	
	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("КодыСчетовСтрокой",		ТипСтрока); // коды перечисляются через запятую, допустимы символы пробела
	Таблица.Колонки.Добавить("ДатаНачалаДействия",		ТипДата); // включая дату
	Таблица.Колонки.Добавить("ДатаОкончанияДействия",	ТипДата); // включая дату
	Таблица.Колонки.Добавить("ИсключаемыеКодыСчетов",	ТипСтрока); // коды перечисляются через запятую, допустимы символы пробела
	Таблица.Колонки.Добавить("ИсключатьВИерархии",		Новый ОписаниеТипов("Булево"));
	
	Возврат Таблица;
	
КонецФункции

Функция ПолучитьТаблицуКодовСчетов(КодыСчетовСтрокой, ДатаНачалаДействия = Неопределено, ДатаОкончанияДействия = Неопределено, ИсключаемыеКодыСчетов = "", ИсключатьВИерархии = Ложь)
	
	Таблица = ПолучитьПустуюТаблицуКодовСчетов();
	
	ДобавитьКодыСчетов(Таблица, КодыСчетовСтрокой, ДатаНачалаДействия, ДатаОкончанияДействия, ИсключаемыеКодыСчетов, ИсключатьВИерархии);
	
	Возврат Таблица;
	
КонецФункции

Процедура ДобавитьКодыСчетов(Таблица, КодыСчетовСтрокой, ДатаНачалаДействия = Неопределено, ДатаОкончанияДействия = Неопределено, ИсключаемыеКодыСчетов = "", ИсключатьВИерархии = Ложь)
	
	НоваяСтрока = Таблица.Добавить();
	
	НоваяСтрока.КодыСчетовСтрокой		= КодыСчетовСтрокой;
	НоваяСтрока.ДатаНачалаДействия		= ДатаНачалаДействия;
	НоваяСтрока.ДатаОкончанияДействия	= ДатаОкончанияДействия;
	НоваяСтрока.ИсключаемыеКодыСчетов	= ИсключаемыеКодыСчетов;
	НоваяСтрока.ИсключатьВИерархии		= ИсключатьВИерархии;
	
КонецПроцедуры

Функция НеобходимоДобавитьНастройкиОписи(ТипОписи, ОтборТипОписи)
	
	Если ОтборТипОписи = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат (ТипОписи = ОтборТипОписи);
	
КонецФункции

Процедура ЗаполнитьКолонкуИмяДокументаТаблицыНастроек(ТаблицаНастроекЗаполненияОписейПоРешению)
	
	Для Каждого СтрокаТаблицы Из ТаблицаНастроекЗаполненияОписейПоРешению Цикл
		МетаданныеДокумента = Метаданные.НайтиПоТипу(СтрокаТаблицы.ТипОписи);
		
		СтрокаТаблицы.ИмяДокумента		= МетаданныеДокумента.Имя;
		СтрокаТаблицы.СинонимДокумента	= МетаданныеДокумента.Синоним;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьКорректностьТаблицыНастроек(ТаблицаНастроек)
	
	СовпадающиеПоля = Новый Массив();
	СовпадающиеПоля.Добавить("ИмяРеквизитаКФО");
	СовпадающиеПоля.Добавить("ИмяРеквизитаМОЛ");
	СовпадающиеПоля.Добавить("КомиссияУказываетсяСсылкой");
	
	ТекстШаблон = НСтр("ru='Некорректно заполнена Таблица настроек для заполнения описей по Решению.
		|Для документа ""%1"" предусмотрено несколько настроек, в которых опция ""%2"" имеет различные значения.
		|Опция ""%2"" должна иметь одинаковое значение во всех настройках одного документа.'");
	
	СвернутаяТаблицаНастроек = ТаблицаНастроек.Скопировать();
	СвернутаяТаблицаНастроек.Свернуть("ТипОписи");
	
	Поиск = Новый Структура();
	
	Для Каждого СтрокаСвернутойТаблицыНастроек Из СвернутаяТаблицаНастроек Цикл
		Поиск.Вставить("ТипОписи", СтрокаСвернутойТаблицыНастроек.ТипОписи);
		
		МассивСтрок = ТаблицаНастроек.НайтиСтроки(Поиск);
		
		Для Счетчик = 2 По МассивСтрок.Количество() Цикл
			ТекущаяСтрокаТаблицыНастроек = МассивСтрок[Счетчик - 1];
			
			ПредыдущаяСтрокаТаблицыНастроек = МассивСтрок[Счетчик - 2];
			
			Для Каждого ИмяПоля Из СовпадающиеПоля Цикл
				Если ТекущаяСтрокаТаблицыНастроек[ИмяПоля] = ПредыдущаяСтрокаТаблицыНастроек[ИмяПоля] Тогда
					Продолжить;
				КонецЕсли;
				
				ТекстСообщения = СтрШаблон(ТекстШаблон, ТекущаяСтрокаТаблицыНастроек.СинонимДокумента, ИмяПоля);
				
				ВызватьИсключение ТекстСообщения;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область РасчетПоНастройкам

Процедура ПодготовитьСчетаВТаблицеОбъектов(ТаблицаОбъектов)
	
	Если ТаблицаОбъектов.Колонки.Найти("СсылкиРодителейСчета") <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоРодителейСчетов = ПолучитьКоличествоРодителейСчетовДляПоиска();
	
	ВремТаблица = ТаблицаОбъектов.Скопировать(,"Счет");
	ВремТаблица.Свернуть("Счет");
	МассивСчетов = ВремТаблица.ВыгрузитьКолонку("Счет");
	
	РодителиСчетов = ПолучитьРодителейСчетов(МассивСчетов, КоличествоРодителейСчетов);
	
	ТаблицаОбъектов.Колонки.Добавить("СсылкиРодителейСчета", Новый ОписаниеТипов("Массив"));
	
	Поиск = Новый Структура();
	
	Для Каждого СтрокаТаблицы Из ТаблицаОбъектов Цикл
		
		Счет = СтрокаТаблицы.Счет;
		
		Если Не ЗначениеЗаполнено(Счет) Тогда
			Продолжить;
		КонецЕсли;
		
		Поиск.Вставить("Ссылка", Счет);
		
		МассивСтрок = РодителиСчетов.НайтиСтроки(Поиск);
		
		СвойстваСчета = МассивСтрок[0];
		
		МассивСсылок = Новый Массив();
		
		Для УровеньРодителя = 1 По КоличествоРодителейСчетов Цикл
			
			УровеньРодителяСтрокой = Формат(УровеньРодителя, "ЧГ=0");
			
			ИмяПоляСсылка = "Родитель" + УровеньРодителяСтрокой + "Ссылка";
			
			Ссылка = СвойстваСчета[ИмяПоляСсылка];
			
			Если Не ЗначениеЗаполнено(Ссылка) Тогда
				Продолжить;
			КонецЕсли;
			
			МассивСсылок.Добавить(Ссылка);
			
		КонецЦикла;
		
		СтрокаТаблицы["СсылкиРодителейСчета"] = МассивСсылок;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПодготовитьСчетаВТаблицеНастроек(ТаблицаНастроек, ТипОписи = Неопределено)
	
	Перем НомерСтрокиНастроек, НомерСтрокиКодов;
	
	// По кодам счетов определяем ссылки и родителей счетов
	
	Если ТипЗнч(ТаблицаНастроек) <> Тип("ТаблицаЗначений") Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипОписи = Неопределено Тогда
		КоллекцияСтрокНастроек = ТаблицаНастроек;
	Иначе
		Поиск = Новый Структура("ТипОписи", ТипОписи);
		
		КоллекцияСтрокНастроек = ТаблицаНастроек.НайтиСтроки(Поиск);
	КонецЕсли;
	
	ДобавитьКолонкиДляСсылокСчетовВТаблицыКодовСчетов(КоллекцияСтрокНастроек);
	
	ЗапросПоискСсылокСчетов = Новый Запрос();
	
	ОграниченияПримененияСчетов = НовыйОграниченияПримененияСчетов();
	
	ПодготовитьПоискСсылокСчетовИСсылокРодителейСчетов(ЗапросПоискСсылокСчетов, КоллекцияСтрокНастроек, ОграниченияПримененияСчетов);
	
	ПодготовитьМенеджерВременныхТаблицСчетовВИерархии(ЗапросПоискСсылокСчетов, КоллекцияСтрокНастроек, ОграниченияПримененияСчетов);
	
	УказаныИсключаемыеКоды = ВКоллекцииУказаныИсключаемыеКодыСчетов(КоллекцияСтрокНастроек);
	
	Если УказаныИсключаемыеКоды Тогда
		ЗапросПоискСсылокСчетов.Текст = ЗапросПоискСсылокСчетов.Текст + ОбщегоНазначения.РазделительПакетаЗапросов();
		
		ПодготовитьПоискСсылокИсключаемыхСчетов(ЗапросПоискСсылокСчетов, КоллекцияСтрокНастроек);
		
		РезультатыЗапроса = ЗапросПоискСсылокСчетов.ВыполнитьПакет();
		
		ТаблицаСчетов = РезультатыЗапроса[0].Выгрузить();
		ТаблицаИсключаемыхСчетов = РезультатыЗапроса[1].Выгрузить();
	Иначе
		ТаблицаСчетов = ЗапросПоискСсылокСчетов.Выполнить().Выгрузить();
		ТаблицаИсключаемыхСчетов = Неопределено;
	КонецЕсли;
	
	ВремТаблица = ТаблицаСчетов.Скопировать(,"Ссылка");
	ВремТаблица.Свернуть("Ссылка");
	МассивСчетов = ВремТаблица.ВыгрузитьКолонку("Ссылка");
	
	КоличествоРодителейСчетов = ПолучитьКоличествоРодителейСчетовДляПоиска();
	
	РодителиСчетов = ПолучитьРодителейСчетов(МассивСчетов, КоличествоРодителейСчетов);
	
	Поиск = Новый Структура();
	
	Для Каждого СтрокаТаблицыСчетов Из ТаблицаСчетов Цикл
		ПолучитьНомераСтрок(СтрокаТаблицыСчетов.ИдСтроки, НомерСтрокиНастроек, НомерСтрокиКодов);
		
		СтрокаТаблицыНастроек = КоллекцияСтрокНастроек[НомерСтрокиНастроек - 1];
		
		СтрокаТаблицыКодовСчетов = СтрокаТаблицыНастроек.ТаблицаКодовСчетов[НомерСтрокиКодов - 1];
		
		// Счет
		
		Счет = СтрокаТаблицыСчетов.Ссылка;
		
		Если СтрокаТаблицыКодовСчетов.СсылкиСчетов.Найти(Счет) = Неопределено Тогда
			СтрокаТаблицыКодовСчетов["СсылкиСчетов"].Добавить(Счет);
		КонецЕсли;
		
		// Родители счета
		
		Если СтрокаТаблицыНастроек.ОграниченияПримененияСчетов = ОграниченияПримененияСчетов.ТолькоОдинДетальныйСчет Тогда
			// Родителей счетов не определяем, они не нужны для сопоставления с таблицей объектов.
			Продолжить;
		КонецЕсли;
		
		Поиск.Вставить("Ссылка", Счет);
		
		МассивСтрок = РодителиСчетов.НайтиСтроки(Поиск);
		
		СвойстваСчета = МассивСтрок[0];
		
		Для УровеньРодителя = 1 По КоличествоРодителейСчетов Цикл
			
			УровеньРодителяСтрокой = Формат(УровеньРодителя, "ЧГ=0");
			
			ИмяПоляСсылка = "Родитель" + УровеньРодителяСтрокой + "Ссылка";
			
			Ссылка = СвойстваСчета[ИмяПоляСсылка];
			
			Если Не ЗначениеЗаполнено(Ссылка) Тогда
				Продолжить;
			КонецЕсли;
			
			Если СтрокаТаблицыКодовСчетов.СсылкиРодителейСчетов.Найти(Ссылка) = Неопределено Тогда
				СтрокаТаблицыКодовСчетов["СсылкиРодителейСчетов"].Добавить(Ссылка);
			КонецЕсли;
			
		КонецЦикла;
	КонецЦикла;
	
	// Исключаемые счета
	Если ТаблицаИсключаемыхСчетов <> Неопределено Тогда
		ЗаполнитьСсылкиИсключаемыхСчетов(КоллекцияСтрокНастроек, ТаблицаИсключаемыхСчетов);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьКолонкиДляСсылокСчетовВТаблицыКодовСчетов(КоллекцияСтрокНастроек)
	
	ТипМассив = Новый ОписаниеТипов("Массив");
	
	Для Каждого СтрокаТаблицыНастроек Из КоллекцияСтрокНастроек Цикл
		ТаблицаКодовСчетов = СтрокаТаблицыНастроек.ТаблицаКодовСчетов;
		
		Если ТаблицаКодовСчетов.Колонки.Найти("СсылкиСчетов") = Неопределено Тогда
			ТаблицаКодовСчетов.Колонки.Добавить("СсылкиСчетов", ТипМассив);
		КонецЕсли;
		
		Если ТаблицаКодовСчетов.Колонки.Найти("СсылкиРодителейСчетов") = Неопределено Тогда
			ТаблицаКодовСчетов.Колонки.Добавить("СсылкиРодителейСчетов", ТипМассив);
		КонецЕсли;
		
		Если ТаблицаКодовСчетов.Колонки.Найти("СсылкиИсключаемыхСчетов") = Неопределено Тогда
			ТаблицаКодовСчетов.Колонки.Добавить("СсылкиИсключаемыхСчетов", ТипМассив);
		КонецЕсли;
		
		Для Каждого СтрокаТаблицыКодов Из ТаблицаКодовСчетов Цикл
			СтрокаТаблицыКодов.СсылкиСчетов				= Новый Массив();
			СтрокаТаблицыКодов.СсылкиРодителейСчетов	= Новый Массив();
			СтрокаТаблицыКодов.СсылкиИсключаемыхСчетов	= Новый Массив();
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПодготовитьПоискСсылокСчетовИСсылокРодителейСчетов(ЗапросПоискСсылокСчетов, КоллекцияСтрокНастроек, Знач ОграниченияПримененияСчетов)
	
	НомерСтрокиНастроек = 0;
	
	Для Каждого СтрокаТаблицыНастроек Из КоллекцияСтрокНастроек Цикл
		НомерСтрокиНастроек = НомерСтрокиНастроек + 1;
		
		ДобавитьПоискСсылокСчетов(ЗапросПоискСсылокСчетов, СтрокаТаблицыНастроек, НомерСтрокиНастроек, ОграниченияПримененияСчетов, НомерСтрокиНастроек = 1);
	КонецЦикла;
	
КонецПроцедуры

Функция ВКоллекцииУказаныИсключаемыеКодыСчетов(КоллекцияСтрокНастроек)
	
	Для Каждого СтрокаТаблицыНастроек Из КоллекцияСтрокНастроек Цикл
		Если ВТаблицеКодовСчетовУказаныИсключаемыеКодыСчетов(СтрокаТаблицыНастроек.ТаблицаКодовСчетов) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ВТаблицеКодовСчетовУказаныИсключаемыеКодыСчетов(ТаблицаКодовСчетов)
	
	Для Каждого СтрокаТаблицыКодов Из ТаблицаКодовСчетов Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицыКодов.ИсключаемыеКодыСчетов) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Процедура ПодготовитьПоискСсылокИсключаемыхСчетов(ЗапросПоискСсылокСчетов, КоллекцияСтрокНастроек)
	
	НомерСтрокиНастроек = 0;
	
	ЭтоПервыйЭлементНастроек = Истина;
	
	Для Каждого СтрокаТаблицыНастроек Из КоллекцияСтрокНастроек Цикл
		НомерСтрокиНастроек = НомерСтрокиНастроек + 1;
		
		ТаблицаКодовСчетов = СтрокаТаблицыНастроек.ТаблицаКодовСчетов;
		
		Если ВТаблицеКодовСчетовУказаныИсключаемыеКодыСчетов(ТаблицаКодовСчетов) Тогда
			ДобавитьПоискСсылокИсключаемыхСчетов(ЗапросПоискСсылокСчетов, СтрокаТаблицыНастроек, НомерСтрокиНастроек, ЭтоПервыйЭлементНастроек);
			
			ЭтоПервыйЭлементНастроек = Ложь;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСсылкиИсключаемыхСчетов(КоллекцияСтрокНастроек, ТаблицаИсключаемыхСчетов)
	
	Перем НомерСтрокиНастроек, НомерСтрокиКодов;
	
	Для Каждого СтрокаТаблицыСчетов Из ТаблицаИсключаемыхСчетов Цикл
		ПолучитьНомераСтрок(СтрокаТаблицыСчетов.ИдСтроки, НомерСтрокиНастроек, НомерСтрокиКодов);
		
		СтрокаТаблицыНастроек = КоллекцияСтрокНастроек[НомерСтрокиНастроек - 1];
		
		СтрокаТаблицыКодовСчетов = СтрокаТаблицыНастроек.ТаблицаКодовСчетов[НомерСтрокиКодов - 1];
		
		СтрокаТаблицыКодовСчетов.СсылкиИсключаемыхСчетов.Добавить(СтрокаТаблицыСчетов.Ссылка);
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьРодителейСчетов(МассивСчетов, КоличествоРодителейСчетов) Экспорт
	
	ТекстРодителей = "";
	
	Для УровеньРодителя = 1 По КоличествоРодителейСчетов Цикл
		
		УровеньРодителяСтрокой = Формат(УровеньРодителя, "ЧГ=0");
		
		ПолеРодителя = "";
		
		Для Счетчик = 1 По УровеньРодителя Цикл
			ПолеРодителя = ПолеРодителя + ?(Счетчик = 1, "", ".") + "Родитель";
		КонецЦикла;
		
		ТекстРодителя = ?(УровеньРодителя = 1, "", ",") + "
			|	" + ПолеРодителя + "		КАК Родитель" + УровеньРодителяСтрокой + "Ссылка,
			|	" + ПолеРодителя + ".Код	КАК Родитель" + УровеньРодителяСтрокой + "Код";
		
		ТекстРодителей = ТекстРодителей + ТекстРодителя;
		
	КонецЦикла;
	
	ТекстЗапроса = СтрЗаменить("
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Ссылка	КАК Ссылка,
		|	Код		КАК Код,
		|	&ТекстРодителей
		|ИЗ
		|	ПланСчетов.ЕПСБУ
		|ГДЕ
		|	Ссылка В (&МассивСчетов)",
		"&ТекстРодителей",
		ТекстРодителей);
	
	ЗапросПоиск = Новый Запрос(ТекстЗапроса);
	ЗапросПоиск.УстановитьПараметр("МассивСчетов", МассивСчетов);
	
	Возврат ЗапросПоиск.Выполнить().Выгрузить();
	
КонецФункции

Процедура ДобавитьПоискСсылокСчетов(ЗапросПоискСсылокСчетов, СтрокаТаблицыНастроек, НомерСтрокиНастроек, ОграниченияПримененияСчетов, ЭтоПервыйЭлементНастроек)
	
	ТаблицаКодовСчетов = СтрокаТаблицыНастроек.ТаблицаКодовСчетов;
	
	ТекстШаблонЛюбыеСчета = "
	|ВЫБРАТЬ
	|	""%1""	КАК ИдСтроки,
	|	Ссылка	КАК Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ
	|ГДЕ
	|	Код В(&КодыСчетов%1)
	|	И ВЫБОР
	|		КОГДА &ИспользоватьОтборПоДатеНачалаДействия%1 ТОГДА
	|			ДатаНачалаДействия = &ДатаНачалаДействия%1
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ
	|	И ВЫБОР
	|		КОГДА &ИспользоватьОтборПоДатеОкончанияДействия%1 ТОГДА
	|			ДатаОкончанияДействия = &ДатаОкончанияДействия%1
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ";
	
	ТекстШаблонТолькоДетальныеСчета = "
	|ВЫБРАТЬ
	|	""%1""	КАК ИдСтроки,
	|	Ссылка	КАК Ссылка
	|ИЗ	
	|	СчетаВИерархии%1
	|ГДЕ
	|	НЕ Ссылка В(ВЫБРАТЬ Родитель ИЗ СчетаВИерархии%1)";	
	
	НомерСтрокиКодов = 0;
	
	Тексты = Новый Массив();
	
	Для Каждого СтрокаТаблицыКодовСчетов Из ТаблицаКодовСчетов Цикл
		НомерСтрокиКодов = НомерСтрокиКодов + 1;
		
		ИдСтроки = ПолучитьИдСтроки(НомерСтрокиНастроек, НомерСтрокиКодов);
		
		КодыСчетов = СтрРазделить(СтрокаТаблицыКодовСчетов.КодыСчетовСтрокой, ", ", Ложь);
		
		ЗапросПоискСсылокСчетов.УстановитьПараметр("КодыСчетов" + ИдСтроки,									КодыСчетов);
		ЗапросПоискСсылокСчетов.УстановитьПараметр("ДатаНачалаДействия" + ИдСтроки,							СтрокаТаблицыКодовСчетов.ДатаНачалаДействия);
		ЗапросПоискСсылокСчетов.УстановитьПараметр("ДатаОкончанияДействия" + ИдСтроки,						СтрокаТаблицыКодовСчетов.ДатаОкончанияДействия);
		ЗапросПоискСсылокСчетов.УстановитьПараметр("ИспользоватьОтборПоДатеНачалаДействия" + ИдСтроки,		ЗначениеЗаполнено(СтрокаТаблицыКодовСчетов.ДатаНачалаДействия));
		ЗапросПоискСсылокСчетов.УстановитьПараметр("ИспользоватьОтборПоДатеОкончанияДействия" + ИдСтроки,	ЗначениеЗаполнено(СтрокаТаблицыКодовСчетов.ДатаОкончанияДействия));
		
		Если СтрокаТаблицыНастроек.ОграниченияПримененияСчетов = ОграниченияПримененияСчетов.ТолькоОдинДетальныйСчет Тогда
			ТекстШаблон = ТекстШаблонТолькоДетальныеСчета;
		Иначе
			ТекстШаблон = ТекстШаблонЛюбыеСчета;
		КонецЕсли;
		
		Тексты.Добавить(СтрШаблон(ТекстШаблон, ИдСтроки));
	КонецЦикла;
	
	Если Не ЭтоПервыйЭлементНастроек Тогда
		ЗапросПоискСсылокСчетов.Текст = ЗапросПоискСсылокСчетов.Текст + ОбщегоНазначения.ТекстОбъединитьВсе();
	КонецЕсли;
	
	ЗапросПоискСсылокСчетов.Текст = ЗапросПоискСсылокСчетов.Текст + СтрСоединить(Тексты, ОбщегоНазначения.ТекстОбъединитьВсе());
	
КонецПроцедуры

Процедура ДобавитьПоискСсылокИсключаемыхСчетов(ЗапросПоискСсылокСчетов, СтрокаТаблицыНастроек, НомерСтрокиНастроек, ЭтоПервыйЭлементНастроек)
	
	ТаблицаКодовСчетов = СтрокаТаблицыНастроек.ТаблицаКодовСчетов;
	
	ТекстШаблонБезИерархии = "
	|ВЫБРАТЬ
	|	""%1""	КАК ИдСтроки,
	|	Ссылка	КАК Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ
	|ГДЕ
	|	Код В(&ИсключаемыеКодыСчетов%1)
	|	И ВЫБОР
	|		КОГДА &ИспользоватьОтборПоДатеНачалаДействия%1 ТОГДА
	|			ДатаНачалаДействия = &ДатаНачалаДействия%1
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ
	|	И ВЫБОР
	|		КОГДА &ИспользоватьОтборПоДатеОкончанияДействия%1 ТОГДА
	|			ДатаОкончанияДействия = &ДатаОкончанияДействия%1
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ";
	
	ТекстШаблонВИерархии = "
	|ВЫБРАТЬ
	|	""%1""	КАК ИдСтроки,
	|	Ссылка	КАК Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ
	|ГДЕ
	|	Ссылка В ИЕРАРХИИ(
	|		ВЫБРАТЬ
	|			Ссылка
	|		ИЗ
	|			ПланСчетов.ЕПСБУ
	|		ГДЕ
	|			Код В(&ИсключаемыеКодыСчетов%1))
	|	И ВЫБОР
	|		КОГДА &ИспользоватьОтборПоДатеНачалаДействия%1 ТОГДА
	|			ДатаНачалаДействия = &ДатаНачалаДействия%1
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ
	|	И ВЫБОР
	|		КОГДА &ИспользоватьОтборПоДатеОкончанияДействия%1 ТОГДА
	|			ДатаОкончанияДействия = &ДатаОкончанияДействия%1
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ";
	
	Тексты = Новый Массив();
	
	НомерСтрокиКодов = 0;
	
	Для Каждого СтрокаТаблицыКодовСчетов Из ТаблицаКодовСчетов Цикл
		НомерСтрокиКодов = НомерСтрокиКодов + 1;
		
		ИдСтроки = ПолучитьИдСтроки(НомерСтрокиНастроек, НомерСтрокиКодов);
		
		ИсключаемыеКодыСчетов = СтрРазделить(СтрокаТаблицыКодовСчетов.ИсключаемыеКодыСчетов, ", ", Ложь);
		
		ЗапросПоискСсылокСчетов.УстановитьПараметр("ИсключаемыеКодыСчетов" + ИдСтроки,						ИсключаемыеКодыСчетов);
		ЗапросПоискСсылокСчетов.УстановитьПараметр("ДатаНачалаДействия" + ИдСтроки,							СтрокаТаблицыКодовСчетов.ДатаНачалаДействия);
		ЗапросПоискСсылокСчетов.УстановитьПараметр("ДатаОкончанияДействия" + ИдСтроки,						СтрокаТаблицыКодовСчетов.ДатаОкончанияДействия);
		ЗапросПоискСсылокСчетов.УстановитьПараметр("ИспользоватьОтборПоДатеНачалаДействия" + ИдСтроки,		ЗначениеЗаполнено(СтрокаТаблицыКодовСчетов.ДатаНачалаДействия));
		ЗапросПоискСсылокСчетов.УстановитьПараметр("ИспользоватьОтборПоДатеОкончанияДействия" + ИдСтроки,	ЗначениеЗаполнено(СтрокаТаблицыКодовСчетов.ДатаОкончанияДействия));
		
		Если СтрокаТаблицыКодовСчетов.ИсключатьВИерархии Тогда
			ТекстШаблон = ТекстШаблонВИерархии;
		Иначе
			ТекстШаблон = ТекстШаблонБезИерархии;
		КонецЕсли;
		
		Тексты.Добавить(СтрШаблон(ТекстШаблон, ИдСтроки));
	КонецЦикла;
	
	Если Не ЭтоПервыйЭлементНастроек Тогда
		ЗапросПоискСсылокСчетов.Текст = ЗапросПоискСсылокСчетов.Текст + ОбщегоНазначения.ТекстОбъединитьВсе();
	КонецЕсли;
	
	ЗапросПоискСсылокСчетов.Текст = ЗапросПоискСсылокСчетов.Текст + СтрСоединить(Тексты, ОбщегоНазначения.ТекстОбъединитьВсе());
	
КонецПроцедуры

Процедура ПодготовитьМенеджерВременныхТаблицСчетовВИерархии(ЗапросПоискСсылокСчетов, КоллекцияСтрокНастроек, ОграниченияПримененияСчетов)
	
	ТекстШаблон = "
	|ВЫБРАТЬ
	|	Ссылка														КАК Ссылка,
	|	Код															КАК Код,
	|	ЕСТЬNULL(Родитель, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка))	КАК Родитель,
	|	ЗапретитьИспользоватьВПроводках								КАК ЗапретитьИспользоватьВПроводках
	|ПОМЕСТИТЬ
	|	СчетаВИерархии%1
	|ИЗ
	|	ПланСчетов.ЕПСБУ
	|ГДЕ
	|	Ссылка В ИЕРАРХИИ(
	|		ВЫБРАТЬ
	|			Ссылка
	|		ИЗ
	|			ПланСчетов.ЕПСБУ
	|		ГДЕ
	|			Код В (&КодыСчетов%1))
	|	И ВЫБОР
	|		КОГДА &ИспользоватьОтборПоДатеНачалаДействия%1 ТОГДА
	|			ДатаНачалаДействия = &ДатаНачалаДействия%1
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ
	|	И ВЫБОР
	|		КОГДА &ИспользоватьОтборПоДатеОкончанияДействия%1 ТОГДА
	|			ДатаОкончанияДействия = &ДатаОкончанияДействия%1
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ";
	
	МассивТекстов = Новый Массив();
	
	НомерСтрокиНастроек = 0;
	
	ВремЗапрос = Новый Запрос();
	
	Для Каждого СтрокаТаблицыНастроек Из КоллекцияСтрокНастроек Цикл
		НомерСтрокиНастроек = НомерСтрокиНастроек + 1;
		
		Если СтрокаТаблицыНастроек.ОграниченияПримененияСчетов <> ОграниченияПримененияСчетов.ТолькоОдинДетальныйСчет Тогда
			Продолжить;
		КонецЕсли;
		
		ТаблицаКодовСчетов = СтрокаТаблицыНастроек.ТаблицаКодовСчетов;
		
		НомерСтрокиКодов = 0;
		
		Для Каждого СтрокаТаблицыКодовСчетов Из ТаблицаКодовСчетов Цикл
			НомерСтрокиКодов = НомерСтрокиКодов + 1;
			
			ИдСтроки = ПолучитьИдСтроки(НомерСтрокиНастроек, НомерСтрокиКодов);
			
			КодыСчетов = СтрРазделить(СтрокаТаблицыКодовСчетов.КодыСчетовСтрокой, ", ", Ложь);
			
			// Настройка, аналогичная основному запросу по счетам.
			ВремЗапрос.УстановитьПараметр("КодыСчетов" + ИдСтроки,									КодыСчетов);
			ВремЗапрос.УстановитьПараметр("ДатаНачалаДействия" + ИдСтроки,							СтрокаТаблицыКодовСчетов.ДатаНачалаДействия);
			ВремЗапрос.УстановитьПараметр("ДатаОкончанияДействия" + ИдСтроки,						СтрокаТаблицыКодовСчетов.ДатаОкончанияДействия);
			ВремЗапрос.УстановитьПараметр("ИспользоватьОтборПоДатеНачалаДействия" + ИдСтроки,		ЗначениеЗаполнено(СтрокаТаблицыКодовСчетов.ДатаНачалаДействия));
			ВремЗапрос.УстановитьПараметр("ИспользоватьОтборПоДатеОкончанияДействия" + ИдСтроки,	ЗначениеЗаполнено(СтрокаТаблицыКодовСчетов.ДатаОкончанияДействия));
			
			МассивТекстов.Добавить(СтрШаблон(ТекстШаблон, ИдСтроки));
		КонецЦикла;
	КонецЦикла;
	
	Если МассивТекстов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ВремЗапрос.Текст = СтрСоединить(МассивТекстов, "
		|;");
	
	МенеджерВТ = Новый МенеджерВременныхТаблиц();
	
	ВремЗапрос.МенеджерВременныхТаблиц = МенеджерВТ;
	
	ВремЗапрос.Выполнить();
	
	ЗапросПоискСсылокСчетов.МенеджерВременныхТаблиц = МенеджерВТ;
	
КонецПроцедуры

Процедура СопоставитьТаблицыОбъектовИНастроек(ТаблицаОбъекты, ТаблицаНастроек, Знач ТипОписи = Неопределено)
	
	ЕстьКолонкаТипИзменения = (ТаблицаОбъекты.Колонки.Найти("ТипИзменения") <> Неопределено);
	
	ТипИзмененияОтмена = Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Отмена;
	
	ПодготовитьСчетаВТаблицеОбъектов(ТаблицаОбъекты);
	
	ПодготовитьСчетаВТаблицеНастроек(ТаблицаНастроек, ТипОписи);
	
	ОтбиратьСчетаПоДатеИнвентаризации = Истина;
	
	Если ТаблицаОбъекты.Колонки.Найти("СопоставленныеСтрокиНастроек") = Неопределено Тогда
		ТаблицаОбъекты.Колонки.Добавить("СопоставленныеСтрокиНастроек", Новый ОписаниеТипов("ТаблицаЗначений"));
	КонецЕсли;
	
	Для Каждого СтрокаТаблицыОбъектов Из ТаблицаОбъекты Цикл
		
		СтрокаТаблицыОбъектов.СопоставленныеСтрокиНастроек = ПолучитьПустуюТаблицуСопоставленныхСтрокНастроек();
		
		Если ЕстьКолонкаТипИзменения И СтрокаТаблицыОбъектов.ТипИзменения = ТипИзмененияОтмена Тогда
			Продолжить;
		КонецЕсли;
		
		НомерСтрокиТаблицыНастроек = 0;
		
		Для Каждого СтрокаТаблицыНастроек Из ТаблицаНастроек Цикл
			
			НомерСтрокиТаблицыНастроек = НомерСтрокиТаблицыНастроек + 1;
			
			Если ТипОписи <> Неопределено Тогда
				Если СтрокаТаблицыНастроек.ТипОписи <> ТипОписи Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			ТаблицаКодовСчетов = СтрокаТаблицыНастроек.ТаблицаКодовСчетов;
			
			НомерСтрокиТаблицыКодовСчетов = 0;
			
			Для Каждого СтрокаТаблицыКодов Из ТаблицаКодовСчетов Цикл
				
				НомерСтрокиТаблицыКодовСчетов = НомерСтрокиТаблицыКодовСчетов + 1;
				
				Если ОтбиратьСчетаПоДатеИнвентаризации Тогда
					УсловиеНачало = Истина;
					УсловиеОкончание = Истина;
					
					Если ЗначениеЗаполнено(СтрокаТаблицыКодов.ДатаНачалаДействия) Тогда
						УсловиеНачало = (СтрокаТаблицыОбъектов.ДатаИнвентаризации >= СтрокаТаблицыКодов.ДатаНачалаДействия);
					КонецЕсли;
					
					Если ЗначениеЗаполнено(СтрокаТаблицыКодов.ДатаОкончанияДействия) Тогда
						УсловиеОкончание = (СтрокаТаблицыОбъектов.ДатаИнвентаризации <= СтрокаТаблицыКодов.ДатаОкончанияДействия);
					КонецЕсли;
					
					Если Не УсловиеНачало Или Не УсловиеОкончание Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли;
				
				СчетСопоставления = Неопределено;
				ЭтоРодительВТаблицеОбъектов = Ложь;
				ЭтоРодительВТаблицеНастроек = Ложь;
				
				Если СтрокаТаблицыКодов.СсылкиИсключаемыхСчетов.Найти(СтрокаТаблицыОбъектов.Счет) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				Если СтрокаТаблицыКодов.СсылкиСчетов.Найти(СтрокаТаблицыОбъектов.Счет) <> Неопределено Тогда
					СчетСопоставления = СтрокаТаблицыОбъектов.Счет;
					
				ИначеЕсли СтрокаТаблицыКодов.СсылкиРодителейСчетов.Найти(СтрокаТаблицыОбъектов.Счет) <> Неопределено Тогда
					СчетСопоставления = СтрокаТаблицыОбъектов.Счет;
					ЭтоРодительВТаблицеНастроек = Истина;
					
				ИначеЕсли ЕстьОдинаковыеСчета(СтрокаТаблицыКодов.СсылкиСчетов, СтрокаТаблицыОбъектов.СсылкиРодителейСчета, СчетСопоставления) Тогда
					ЭтоРодительВТаблицеОбъектов = Истина;
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(СчетСопоставления) Тогда
					Продолжить;
				КонецЕсли;
				
				НоваяСтрока = СтрокаТаблицыОбъектов.СопоставленныеСтрокиНастроек.Добавить();
				
				НоваяСтрока.НомерСтрокиТаблицыНастроек		= НомерСтрокиТаблицыНастроек;
				НоваяСтрока.НомерСтрокиТаблицыКодовСчетов	= НомерСтрокиТаблицыКодовСчетов;
				НоваяСтрока.СчетСопоставления				= СчетСопоставления;
				НоваяСтрока.ЭтоРодительВТаблицеОбъектов		= ЭтоРодительВТаблицеОбъектов;
				НоваяСтрока.ЭтоРодительВТаблицеНастроек		= ЭтоРодительВТаблицеНастроек;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ЗаполнитьКоличествоСопоставленныхНастроек(ТаблицаОбъекты);
	
КонецПроцедуры

Процедура ЗаполнитьКоличествоСопоставленныхНастроек(ТаблицаОбъектов)
	
	Если ТаблицаОбъектов.Колонки.Найти("НомераСтрокНастроек") = Неопределено Тогда
		ТаблицаОбъектов.Колонки.Добавить("НомераСтрокНастроек",	Новый ОписаниеТипов("Массив"));
	КонецЕсли;
	
	Если ТаблицаОбъектов.Колонки.Найти("КоличествоНастроек") = Неопределено Тогда
		ТаблицаОбъектов.Колонки.Добавить("КоличествоНастроек",	ОбщегоНазначения.ОписаниеТипаЧисло(3,0,ДопустимыйЗнак.Неотрицательный));
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из ТаблицаОбъектов Цикл
		ВремТаблица = СтрокаТаблицы.СопоставленныеСтрокиНастроек.Скопировать(, "НомерСтрокиТаблицыНастроек");
		ВремТаблица.Свернуть("НомерСтрокиТаблицыНастроек");
		
		НомераСтрокНастроек	= ВремТаблица.ВыгрузитьКолонку("НомерСтрокиТаблицыНастроек");
		КоличествоНастроек	= НомераСтрокНастроек.Количество();
		
		СтрокаТаблицы.НомераСтрокНастроек	= НомераСтрокНастроек;
		СтрокаТаблицы.КоличествоНастроек	= КоличествоНастроек;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьКоличествоРодителейСчетовДляПоиска()
	
	Возврат 4;
	
КонецФункции

Функция ПолучитьПустуюТаблицуСопоставленныхСтрокНастроек()
	
	ТипЧисло	= ОбщегоНазначения.ОписаниеТипаЧисло(3,0,ДопустимыйЗнак.Неотрицательный);
	ТипСчет		= Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ");
	ТипБулево	= Новый ОписаниеТипов("Булево");
	
	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("НомерСтрокиТаблицыНастроек",		ТипЧисло);
	Таблица.Колонки.Добавить("НомерСтрокиТаблицыКодовСчетов",	ТипЧисло);
	Таблица.Колонки.Добавить("СчетСопоставления",				ТипСчет);
	Таблица.Колонки.Добавить("ЭтоРодительВТаблицеОбъектов",		ТипБулево);
	Таблица.Колонки.Добавить("ЭтоРодительВТаблицеНастроек",		ТипБулево);
	
	Возврат Таблица;
	
КонецФункции

Функция ЕстьОдинаковыеСчета(Знач Массив1, Знач Массив2, ОдинаковыйСчет)
	
	Для Каждого Элемент1 Из Массив1 Цикл
		
		Если Массив2.Найти(Элемент1) <> Неопределено Тогда
			ОдинаковыйСчет = Элемент1;
			
			Возврат Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ПолучитьИдСтроки(НомерСтрокиНастроек, НомерСтрокиКодов)
	
	Возврат СтрШаблон("%1_%2",
		Формат(НомерСтрокиНастроек, "ЧГ=0"),
		Формат(НомерСтрокиКодов, "ЧГ=0"));
	
КонецФункции

Процедура ПолучитьНомераСтрок(Знач ИдСтроки, НомерСтрокиНастроек, НомерСтрокиКодов)
	
	МассивСтрок = СтрРазделить(ИдСтроки, "_");
	
	НомерСтрокиНастроек = Число(МассивСтрок[0]);
	
	НомерСтрокиКодов = Число(МассивСтрок[1]);
	
КонецПроцедуры

#КонецОбласти

#Область РазбиениеРаздела1НаГруппыСтрок

Процедура РазбитьТаблицуОбъектыНаГруппыСтрок(ТаблицаОбъекты, ТаблицаНастроек, ТипОписи, ДополнительныеПараметры, НастройкиОбъединенияСтрок)
	
	ДополнительныеПараметры.Вставить("ОбязательныеКолонкиГруппировок", ПолучитьОбязательныеКолонкиГруппировокТаблицыОбъекты());
	
	РаздробленнаяТаблицаОбъекты = РаздробитьСтрокиИЗаполнитьКолонкуИмяДокументаТаблицыОбъекты(ТаблицаОбъекты, ТаблицаНастроек);
	
	ГруппыСтрокПоТипуОписи = РазбитьТаблицуНаГруппыСтрок(РаздробленнаяТаблицаОбъекты, "ИмяДокумента");
	
	ГруппыСтрок = Новый Массив();
	
	Для Каждого ГруппаСтрок Из ГруппыСтрокПоТипуОписи Цикл
		
		ИмяДокумента = ГруппаСтрок.ПоляГруппировок.ИмяДокумента;
		
		Если ЗначениеЗаполнено(ИмяДокумента) Тогда
			КолонкиГруппировок = ОпределитьКолонкиГруппировокТаблицыОбъекты(ГруппаСтрок, ТаблицаОбъекты, ТаблицаНастроек, ДополнительныеПараметры, НастройкиОбъединенияСтрок);
			
			ПодгруппыСтрок = РазбитьНаПодгруппы(ГруппаСтрок, КолонкиГруппировок, ТаблицаОбъекты, ТаблицаНастроек, ДополнительныеПараметры);
			
		Иначе
			Если ТипОписи <> Неопределено Тогда
				// При указанном типе описи необходима группировка лишь по такому типу описи,
				// группировка по несопоставленным типам описей не требуется.
				Продолжить;
			КонецЕсли;
			
			ОписаниеПодгруппыСтрок = ПолучитьПустоеОписаниеГруппыСтрок();
			ОписаниеПодгруппыСтрок.ПоляГруппировок = Новый ФиксированнаяСтруктура();
			ОписаниеПодгруппыСтрок.НомераСтрок = ГруппаСтрок.НомераСтрок;
			
			ПодгруппыСтрок = Новый Массив();
			ПодгруппыСтрок.Добавить(ОписаниеПодгруппыСтрок);
		КонецЕсли;
		
		УпорядочитьПодгруппыСтрок(ПодгруппыСтрок);
		
		ОписаниеГруппыСтрок = Новый Структура();
		ОписаниеГруппыСтрок.Вставить("ИмяДокумента",	ИмяДокумента);
		ОписаниеГруппыСтрок.Вставить("ПодгруппыСтрок",	ПодгруппыСтрок);
		
		ГруппыСтрок.Добавить(ОписаниеГруппыСтрок);
		
	КонецЦикла;
	
	ДополнительныеПараметры.Вставить("ГруппыСтрок", ГруппыСтрок);
	
	ДополнительныеПараметры.Удалить("ПотенциальноОбщиеСтроки");
	
КонецПроцедуры

Функция РаздробитьСтрокиИЗаполнитьКолонкуИмяДокументаТаблицыОбъекты(ТаблицаОбъекты, ТаблицаНастроек)
	
	РаздробленнаяТаблицаОбъекты = ТаблицаОбъекты.СкопироватьКолонки();
	
	Если РаздробленнаяТаблицаОбъекты.Колонки.Найти("ИмяДокумента") = Неопределено Тогда
		РаздробленнаяТаблицаОбъекты.Колонки.Добавить("ИмяДокумента", Новый ОписаниеТипов("Строка"));
	КонецЕсли;
	
	ДобавленныеТипОписи = Новый Массив();
	
	Для Каждого СтрокаТаблицыОбъекты Из ТаблицаОбъекты Цикл
		НоваяСтрока = РаздробленнаяТаблицаОбъекты.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицыОбъекты, , "ИмяДокумента");
		
		ДобавленныеТипОписи.Очистить();
		
		Для Каждого НомерСтрокиНастроек Из СтрокаТаблицыОбъекты.НомераСтрокНастроек Цикл
			СтрокаТаблицыНастроек = ТаблицаНастроек[НомерСтрокиНастроек - 1];
			
			ТипОписи = СтрокаТаблицыНастроек.ТипОписи;
			
			Если ДобавленныеТипОписи.Найти(ТипОписи) = Неопределено Тогда
				ДобавленныеТипОписи.Добавить(ТипОписи);
				
				Если ДобавленныеТипОписи.Количество() > 1 Тогда
					НоваяСтрока = РаздробленнаяТаблицаОбъекты.Добавить();
					
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицыОбъекты, , "ИмяДокумента");
				КонецЕсли;
				
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицыНастроек, "ИмяДокумента");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат РаздробленнаяТаблицаОбъекты;
	
КонецФункции

Функция ПолучитьОбязательныеКолонкиГруппировокТаблицыОбъекты()
	
	КолонкиГруппировок = Новый Массив();
	
	КолонкиГруппировок.Добавить("ДатаИнвентаризации");
	КолонкиГруппировок.Добавить("ДатаНачала");
	КолонкиГруппировок.Добавить("ДатаОкончания");
	КолонкиГруппировок.Добавить("НомерКомиссии");
	КолонкиГруппировок.Добавить("НомерРабочейКомиссии");
	//КолонкиГруппировок.Добавить("МестоИнвентаризации");
	
	Возврат Новый ФиксированныйМассив(КолонкиГруппировок);
	
КонецФункции

Функция ОпределитьКолонкиГруппировокТаблицыОбъекты(ГруппаСтрокПоТипуОписи, ТаблицаОбъекты, ТаблицаНастроек, ДополнительныеПараметры, НастройкиОбъединенияСтрок)
	
	ОбязательныеКолонкиГруппировок = ДополнительныеПараметры.ОбязательныеКолонкиГруппировок;
	
	НомераСтрок = ГруппаСтрокПоТипуОписи.НомераСтрок;
	
	ПотенциальноОбщиеСтроки = Новый Массив();
	
	НеобходимостьГруппировки = Новый Структура();
	НеобходимостьГруппировки.Вставить("Счет", Ложь);
	НеобходимостьГруппировки.Вставить("КФО", Ложь);
	НеобходимостьГруппировки.Вставить("Сотрудник", Ложь);
	НеобходимостьГруппировки.Вставить("МестоИнвентаризации", Ложь);
	
	Для Каждого НомерСтроки Из НомераСтрок Цикл
		СтрокаТаблицыОбъекты = ТаблицаОбъекты[НомерСтроки - 1];
		
		СтрокаТаблицыНастроек = ТаблицаНастроек[СтрокаТаблицыОбъекты.СопоставленныеСтрокиНастроек[0].НомерСтрокиТаблицыНастроек - 1];
		
		РасположениеРеквизитов = ПолучитьОписаниеРасположенияРеквизитовОписи(СтрокаТаблицыНастроек);
		
		ДопустимостьОбъединенияСчетов = ОпределитьДопустимостьОбъединенияСчетовДляОписи(РасположениеРеквизитов);
		
		ДопустимостьОбъединенияМестИнвентаризации = ОпределитьДопустимостьОбъединенияМестИнвентаризацииДляОписи(РасположениеРеквизитов);
		
		Если РасположениеРеквизитов.Счет.РасположенВШапке Тогда
			НеобходимостьГруппировки.Счет = Истина;
			
		ИначеЕсли РасположениеРеквизитов.Счет.Отсутствует Тогда
			ПотенциальноОбщиеСтроки.Добавить(НомерСтроки);
		
		ИначеЕсли ДопустимостьОбъединенияСчетов И Не НастройкиОбъединенияСтрок.ПоСчетам Тогда
			НеобходимостьГруппировки.Счет = Истина;
		КонецЕсли;
		
		Если РасположениеРеквизитов.КФО.РасположенВШапке Тогда
			НеобходимостьГруппировки.КФО = Истина;
			
		ИначеЕсли ДопустимостьОбъединенияСчетов И Не НастройкиОбъединенияСтрок.ПоСчетам Тогда
			НеобходимостьГруппировки.КФО = Истина;
		КонецЕсли;
		
		Если РасположениеРеквизитов.Сотрудник.РасположенВШапке Тогда
			НеобходимостьГруппировки.Сотрудник = Истина;
		КонецЕсли;
		
		Если РасположениеРеквизитов.МестоИнвентаризации.РасположенВШапке Тогда
			НеобходимостьГруппировки.МестоИнвентаризации = Истина;
			
		ИначеЕсли ДопустимостьОбъединенияМестИнвентаризации И Не НастройкиОбъединенияСтрок.ПоМестамИнвентаризации Тогда
			НеобходимостьГруппировки.МестоИнвентаризации = Истина;
		КонецЕсли;
	КонецЦикла;
	
	КолонкиГруппировок = Новый Массив(ОбязательныеКолонкиГруппировок);
	
	Если НеобходимостьГруппировки.Счет Тогда
		КолонкиГруппировок.Добавить("Счет");
	КонецЕсли;
	
	Если НеобходимостьГруппировки.КФО Тогда
		КолонкиГруппировок.Добавить("КФО");
	КонецЕсли;
	
	Если НеобходимостьГруппировки.Сотрудник Тогда
		КолонкиГруппировок.Добавить("Сотрудник");
	КонецЕсли;
	
	Если НеобходимостьГруппировки.МестоИнвентаризации Тогда
		КолонкиГруппировок.Добавить("МестоИнвентаризации");
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("ПотенциальноОбщиеСтроки", ПотенциальноОбщиеСтроки);
	
	Возврат КолонкиГруппировок;
	
КонецФункции

Функция ДиагностироватьОписаниеРеквизитаОписи(Знач СтрокаОписания, ЗначениеПоУмолчанию = Неопределено)
	
	Отсутствует						= Ложь;
	РасположенВШапке				= Ложь;
	ИмяПоля							= "";
	РасположенВТабличнойЧасти		= Ложь;
	ИмяТабличнойЧасти				= "";
	ИмяКолонки						= "";
	ИмяКолонкиПризнакИспользования	= "";
	
	Если Не ЗначениеЗаполнено(СтрокаОписания) И ЗначениеПоУмолчанию <> Неопределено Тогда
		СтрокаОписания = ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаОписания) Тогда
		МассивСтрок = СтрРазделить(СтрокаОписания, ".", Ложь);
		
		Если МассивСтрок.Количество() = 1 Тогда
			// Реквизит указывается в шапке документа
			
			РасположенВШапке = Истина;
			ИмяПоля = СтрокаОписания;
			
		ИначеЕсли МассивСтрок.Количество() = 2 Тогда
			// Реквизит указывается в табличной части документа
			
			РасположенВТабличнойЧасти = Истина;
			ИмяТабличнойЧасти = МассивСтрок[0];
			ИмяКолонки = МассивСтрок[1];
			
			МассивСтрок = СтрРазделить(ИмяКолонки, "#");
			
			Если МассивСтрок.Количество() = 2 Тогда
				// Применяется дополнительная колонка типа Булево для признака использования реквизита
				
				ИмяКолонки = МассивСтрок[0];
				ИмяКолонкиПризнакИспользования = МассивСтрок[1];
			КонецЕсли;
			
		КонецЕсли;
	Иначе
		Отсутствует = Истина;
	КонецЕсли;
	
	Результат = Новый Структура();
	Результат.Вставить("Отсутствует",						Отсутствует);
	Результат.Вставить("РасположенВШапке",					РасположенВШапке);
	Результат.Вставить("ИмяПоля",							ИмяПоля);
	Результат.Вставить("РасположенВТабличнойЧасти",			РасположенВТабличнойЧасти);
	Результат.Вставить("ИмяТабличнойЧасти",					ИмяТабличнойЧасти);
	Результат.Вставить("ИмяКолонки",						ИмяКолонки);
	Результат.Вставить("ИмяКолонкиПризнакИспользования",	ИмяКолонкиПризнакИспользования);
	
	Возврат Результат;
	
КонецФункции

Функция РазбитьНаПодгруппы(ГруппаСтрокПоТипуОписи, КолонкиГруппировок, ТаблицаОбъекты, ТаблицаНастроек, ДополнительныеПараметры)
	
	ПотенциальноОбщиеСтроки = ДополнительныеПараметры.ПотенциальноОбщиеСтроки;
	
	Таблица = ТаблицаОбъекты.СкопироватьКолонки();
	
	НомераСтрок = ГруппаСтрокПоТипуОписи.НомераСтрок;
	
	Для Каждого НомерСтроки Из НомераСтрок Цикл
		НоваяСтрока = Таблица.Добавить();
		
		СтрокаТаблицыОбъекты = ТаблицаОбъекты[НомерСтроки - 1];
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицыОбъекты);
	КонецЦикла;
	
	ГруппыСтрок = РазбитьТаблицуНаГруппыСтрок(Таблица, СтрСоединить(КолонкиГруппировок, ","));
	
	ПодгруппыСтрок = Новый Массив();
	
	Для Каждого ГруппаСтрок Из ГруппыСтрок Цикл
		
		НомераСтрок = Новый Массив();
		
		Для Каждого НомерСтроки Из ГруппаСтрок.НомераСтрок Цикл
			Если ПотенциальноОбщиеСтроки.Найти(НомерСтроки) = Неопределено Тогда
				НомераСтрок.Добавить(НомерСтроки);
			КонецЕсли;
		КонецЦикла;
		
		Если НомераСтрок.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ОписаниеПодгруппыСтрок = ПолучитьПустоеОписаниеГруппыСтрок();
		ОписаниеПодгруппыСтрок.ПоляГруппировок	= Новый ФиксированнаяСтруктура(ГруппаСтрок.ПоляГруппировок);
		ОписаниеПодгруппыСтрок.НомераСтрок		= НомераСтрок;
		ОписаниеПодгруппыСтрок.НастройкиОписи	= ПолучитьНастройкиОписиДляГруппыСтрок(НомераСтрок, ТаблицаОбъекты, ТаблицаНастроек);
		
		ПодгруппыСтрок.Добавить(ОписаниеПодгруппыСтрок);
	КонецЦикла;
	
	ДобавитьПотенциальноОбщиеСтроки(ПодгруппыСтрок, КолонкиГруппировок, ТаблицаОбъекты, ТаблицаНастроек, ДополнительныеПараметры);
	
	Возврат ПодгруппыСтрок;
	
КонецФункции

Функция ПолучитьНастройкиОписиДляГруппыСтрок(НомераСтрок, ТаблицаОбъекты, ТаблицаНастроек)
	
	// Настройки берем из самой первой строки группы
	
	СтрокаТаблицыОбъекты = ТаблицаОбъекты[НомераСтрок[0] - 1];
	
	СтрокаТаблицыНастроек = ТаблицаНастроек[СтрокаТаблицыОбъекты.НомераСтрокНастроек[0] - 1];
	
	НастройкиОписи = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(СтрокаТаблицыНастроек);
	
	НастройкиОписи.Удалить("ТаблицаКодовСчетов"); // тип этого свойства не может быть передан на форму, и свойство более не требуется
	
	Возврат Новый ФиксированнаяСтруктура(НастройкиОписи);
	
КонецФункции

Функция ПолучитьПустоеОписаниеГруппыСтрок()
	
	ОписаниеПодгруппыСтрок = Новый Структура("ПоляГруппировок,НомераСтрок,НастройкиОписи");
	
	Возврат ОписаниеПодгруппыСтрок;
	
КонецФункции

Процедура ДобавитьПотенциальноОбщиеСтроки(ПодгруппыСтрок, КолонкиГруппировок, ТаблицаОбъекты, ТаблицаНастроек, ДополнительныеПараметры)
	
	ПотенциальноОбщиеСтроки = ДополнительныеПараметры.ПотенциальноОбщиеСтроки;
	
	Отбор = Новый Структура();
	
	Для Каждого НомерСтроки Из ПотенциальноОбщиеСтроки Цикл
		СтрокаТаблицыОбъекты = ТаблицаОбъекты[НомерСтроки - 1];
		
		СтрокаТаблицыНастроек = ТаблицаНастроек[СтрокаТаблицыОбъекты.СопоставленныеСтрокиНастроек[0].НомерСтрокиТаблицыНастроек - 1];
		
		РасположениеРеквизитов = ПолучитьОписаниеРасположенияРеквизитовОписи(СтрокаТаблицыНастроек);
		
		Отбор.Очистить();
		
		Если РасположениеРеквизитов.КФО.РасположенВШапке Тогда
			Отбор.Вставить("КФО", СтрокаТаблицыОбъекты.КФО);
		КонецЕсли;
		
		Если РасположениеРеквизитов.Сотрудник.РасположенВШапке Тогда
			Отбор.Вставить("Сотрудник", СтрокаТаблицыОбъекты.Сотрудник);
		КонецЕсли;
		
		ДополнитьПодгруппыСтрокПоОтбору(СтрокаТаблицыОбъекты, ПодгруппыСтрок, Отбор, КолонкиГруппировок, ТаблицаОбъекты, ТаблицаНастроек);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДополнитьПодгруппыСтрокПоОтбору(СтрокаТаблицыОбъекты, ПодгруппыСтрок, Отбор, КолонкиГруппировок, ТаблицаОбъекты, ТаблицаНастроек)
	
	СтрокаДобавленаВПодгруппу = Ложь;
	
	Для Каждого Подгруппа Из ПодгруппыСтрок Цикл
		ПерваяСтрокаПодгруппы = ТаблицаОбъекты[Подгруппа.НомераСтрок[0] - 1];
		
		ДобавитьВПодгруппу = Истина;
		
		Для Каждого ИмяПоля Из КолонкиГруппировок Цикл
			Если ИмяПоля = "Счет" Тогда
				Продолжить;
			КонецЕсли;
			
			Если СтрокаТаблицыОбъекты[ИмяПоля] <> ПерваяСтрокаПодгруппы[ИмяПоля] Тогда
				ДобавитьВПодгруппу = Ложь;
				
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого Элемент Из Отбор Цикл
			ИмяПоляОтбора		= Элемент.Ключ;
			ЗначениеПоляОтбора	= Элемент.Значение;
			
			Если СтрокаТаблицыОбъекты[ИмяПоляОтбора] <> ПерваяСтрокаПодгруппы[ИмяПоляОтбора] Тогда
				ДобавитьВПодгруппу = Ложь;
				
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ДобавитьВПодгруппу Тогда
			Подгруппа.НомераСтрок.Добавить(СтрокаТаблицыОбъекты.НомерСтроки);
			
			СтрокаДобавленаВПодгруппу = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если Не СтрокаДобавленаВПодгруппу Тогда
		НомераСтрок = Новый Массив();
		НомераСтрок.Добавить(СтрокаТаблицыОбъекты.НомерСтроки);
		
		ПоляГруппировок = Новый Структура(СтрСоединить(КолонкиГруппировок, ","));
		ЗаполнитьЗначенияСвойств(ПоляГруппировок, СтрокаТаблицыОбъекты);
		
		ОписаниеПодгруппыСтрок = ПолучитьПустоеОписаниеГруппыСтрок();
		ОписаниеПодгруппыСтрок.ПоляГруппировок	= Новый ФиксированнаяСтруктура(ПоляГруппировок);
		ОписаниеПодгруппыСтрок.НомераСтрок		= НомераСтрок;
		ОписаниеПодгруппыСтрок.НастройкиОписи	= ПолучитьНастройкиОписиДляГруппыСтрок(НомераСтрок, ТаблицаОбъекты, ТаблицаНастроек);
		
		ПодгруппыСтрок.Добавить(ОписаниеПодгруппыСтрок);
	КонецЕсли;
	
КонецПроцедуры

Процедура УпорядочитьПодгруппыСтрок(ПодгруппыСтрок)
	
	ТипЧисло = ОбщегоНазначения.ОписаниеТипаЧисло(6,0,ДопустимыйЗнак.Неотрицательный);
	
	ТаблицаНомеров = Новый ТаблицаЗначений();
	ТаблицаНомеров.Колонки.Добавить("ПоляГруппировок",		Новый ОписаниеТипов("ФиксированнаяСтруктура"));
	ТаблицаНомеров.Колонки.Добавить("НомераСтрок",			Новый ОписаниеТипов("Массив"));
	ТаблицаНомеров.Колонки.Добавить("НомерПервойСтроки",	ТипЧисло);
	ТаблицаНомеров.Колонки.Добавить("НомерПоследнейСтроки",	ТипЧисло);
	ТаблицаНомеров.Колонки.Добавить("НастройкиОписи",		Новый ОписаниеТипов("ФиксированнаяСтруктура"));
	
	ВремСписок = Новый СписокЗначений();
	
	Для Каждого Подгруппа Из ПодгруппыСтрок Цикл
		
		ВремСписок.ЗагрузитьЗначения(Подгруппа.НомераСтрок);
		
		ВремСписок.СортироватьПоЗначению();
		
		НомераСтрок = ВремСписок.ВыгрузитьЗначения();
		
		НоваяСтрока = ТаблицаНомеров.Добавить();
		НоваяСтрока.ПоляГруппировок			= Подгруппа.ПоляГруппировок;
		НоваяСтрока.НомераСтрок				= НомераСтрок;
		НоваяСтрока.НомерПервойСтроки		= НомераСтрок[0];
		НоваяСтрока.НомерПоследнейСтроки	= НомераСтрок[НомераСтрок.ВГраница()];
		НоваяСтрока.НастройкиОписи			= Подгруппа.НастройкиОписи;
		
	КонецЦикла;
	
	ТаблицаНомеров.Сортировать("НомерПервойСтроки,НомерПоследнейСтроки");
	
	ПодгруппыСтрок = Новый Массив();
	
	Для Каждого СтрокаТаблицы Из ТаблицаНомеров Цикл
		ОписаниеПодгруппыСтрок = ПолучитьПустоеОписаниеГруппыСтрок();
		ОписаниеПодгруппыСтрок.ПоляГруппировок	= СтрокаТаблицы.ПоляГруппировок;
		ОписаниеПодгруппыСтрок.НомераСтрок		= СтрокаТаблицы.НомераСтрок;
		ОписаниеПодгруппыСтрок.НастройкиОписи	= СтрокаТаблицы.НастройкиОписи;
		
		ПодгруппыСтрок.Добавить(ОписаниеПодгруппыСтрок);
	КонецЦикла;
	
КонецПроцедуры

Функция РазбитьТаблицуНаГруппыСтрок(Таблица, КолонкиГруппировок)
	
	ЕстьКолонкаТипИзменения = (Таблица.Колонки.Найти("ТипИзменения") <> Неопределено);
	
	ТипИзмененияОтмена = Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Отмена;
	
	ГруппыСтрок = Новый Массив();
	
	ТаблицаСвернутая = Таблица.Скопировать();
	ТаблицаСвернутая.Свернуть(КолонкиГруппировок);
	
	Поиск = Новый Структура(КолонкиГруппировок);
	
	Для Каждого СтрокаСвернутойТаблицы Из ТаблицаСвернутая Цикл
		
		ПоляГруппировок = Новый Структура(КолонкиГруппировок);
		
		ЗаполнитьЗначенияСвойств(ПоляГруппировок, СтрокаСвернутойТаблицы);
		
		НомераСтрок = Новый Массив();
		
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаСвернутойТаблицы);
		
		МассивСтрок = Таблица.НайтиСтроки(Поиск);
		
		Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
			Если ЕстьКолонкаТипИзменения И СтрокаТаблицы.ТипИзменения = ТипИзмененияОтмена Тогда
				Продолжить;
			КонецЕсли;
			
			НомераСтрок.Добавить(СтрокаТаблицы.НомерСтроки);
		КонецЦикла;
		
		ОписаниеГруппыСтрок = ПолучитьПустоеОписаниеГруппыСтрок();
		ОписаниеГруппыСтрок.ПоляГруппировок = ПоляГруппировок;
		ОписаниеГруппыСтрок.НомераСтрок = НомераСтрок;
		
		ГруппыСтрок.Добавить(Новый ФиксированнаяСтруктура(ОписаниеГруппыСтрок));
	КонецЦикла;
	
	Возврат ГруппыСтрок;
	
КонецФункции

Процедура ЗаполнитьКолонкуИмяДокументаТаблицыОбъекты(ТаблицаОбъекты, Знач ТаблицаНастроек, Знач ТипОписи)
	
	ЕстьКолонкаТипИзменения = (ТаблицаОбъекты.Колонки.Найти("ТипИзменения") <> Неопределено);
	
	ТипИзмененияОтмена = Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Отмена;
	
	Если ТаблицаОбъекты.Колонки.Найти("ИмяДокумента") = Неопределено Тогда
		ТаблицаОбъекты.Колонки.Добавить("ИмяДокумента", Новый ОписаниеТипов("Строка"));
	КонецЕсли;
	
	МетаданныеДокумента = Метаданные.НайтиПоТипу(ТипОписи);
	
	ИмяДокумента = МетаданныеДокумента.Имя;
	
	Для Каждого СтрокаТаблицыОбъекты Из ТаблицаОбъекты Цикл
		Если ЕстьКолонкаТипИзменения И СтрокаТаблицыОбъекты.ТипИзменения = ТипИзмененияОтмена Тогда
			Продолжить;
		КонецЕсли;
		
		ТипОписиСопоставлен = Ложь;
		
		Для Каждого НомерСтрокиНастроек Из СтрокаТаблицыОбъекты.НомераСтрокНастроек Цикл
			СтрокаТаблицыНастроек = ТаблицаНастроек[НомерСтрокиНастроек - 1];
			
			Если СтрокаТаблицыНастроек.ТипОписи = ТипОписи Тогда
				ТипОписиСопоставлен = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ТипОписиСопоставлен Тогда
			СтрокаТаблицыОбъекты.ИмяДокумента = ИмяДокумента;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры


Процедура НайтиДокументыОписей(Данные)
	
	УчитываемыеПриказы = Новый Массив();
	УчитываемыеПриказы.Добавить("Приказ52н");
	УчитываемыеПриказы.Добавить("Приказ61н");
	
	Если Не Данные.Свойство("ПоискОписей") Тогда
		ОпределитьТипыОписейДляВыбораИзРешения(Данные, УчитываемыеПриказы);
		
		ПрочитатьДокументыОписейДляВыбораИзРешения(Данные);
	КонецЕсли;
	
	СопоставитьСДокументамиОписейДляВыбораИзРешения(Данные);
	
	ЗаполнитьПредставлениеДокументовОписейДляВыбораИзРешения(Данные);
	
КонецПроцедуры

Процедура ОпределитьТипыОписейДляВыбораИзРешения(Данные, УчитываемыеПриказы)
	
	ТаблицаОбъекты			= Данные.ДанныеРешения.ТаблицаОбъекты;
	ТаблицаОтметок			= Данные.ДополнительныеПараметры.ТаблицаОтметок;
	ТаблицаНастроекВсеОписи	= Данные.ДополнительныеПараметры.ТаблицаНастроекВсеОписи;
	
	ПодходящаяЧастьТаблицыОбъекты = СкопироватьНайденныеСтрокиТаблицыОбъекты(ТаблицаОбъекты, ТаблицаОтметок);
	
	// Сопоставление будем выполнять по полной таблице настроек,
	// могут быть оформлены описи других кодов форм, будем их искать тоже.
	СопоставитьТаблицыОбъектовИНастроек(ПодходящаяЧастьТаблицыОбъекты, ТаблицаНастроекВсеОписи);
	
	ТипыОписей = Новый Массив();
	
	Для Каждого СтрокаТаблицыОбъекты Из ПодходящаяЧастьТаблицыОбъекты Цикл
		Для Каждого СтрокаНастроек Из СтрокаТаблицыОбъекты.СопоставленныеСтрокиНастроек Цикл
			СтрокаНастроек = ТаблицаНастроекВсеОписи[СтрокаНастроек.НомерСтрокиТаблицыНастроек	- 1];
			
			ТипОписи = СтрокаНастроек.ТипОписи;
			
			УчитыватьДокумент = Ложь;
			
			Для Каждого НомерПриказа Из УчитываемыеПриказы Цикл
				Если СтрокаНастроек[НомерПриказа] Тогда
					УчитыватьДокумент = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если Не УчитыватьДокумент Тогда
				Продолжить;
			КонецЕсли;
			
			Если ТипыОписей.Найти(ТипОписи) = Неопределено Тогда
				ТипыОписей.Добавить(ТипОписи);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ПоискОписей = Новый Структура();
	ПоискОписей.Вставить("ТипыОписей", ТипыОписей);
	ПоискОписей.Вставить("ПодходящаяЧастьТаблицыОбъекты", ПодходящаяЧастьТаблицыОбъекты);
	
	Данные.Вставить("ПоискОписей", ПоискОписей);
	
КонецПроцедуры

Процедура ПрочитатьДокументыОписейДляВыбораИзРешения(Данные)
	
	РешениеСсылка	= Данные.ДанныеРешения.Шапка.Решение;
	ТипыОписей		= Данные.ПоискОписей.ТипыОписей;
	
	ТаблицыОписей = Новый Соответствие();
	
	Данные.ПоискОписей.Вставить("ТаблицыОписей", ТаблицыОписей);
	
	Если ТипыОписей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Тексты = Новый Массив();
	
	ИндексыЗапросов = Новый Соответствие();
	
	Для Каждого ТипОписи Из ТипыОписей Цикл
		// Приказ 52н
		
		Если ТипОписи = Тип("ДокументСсылка.ИнвентаризацияЦенныхБумаг") Тогда // 0504081
			Текст = ТекстЗапроса_ПоискОписейДляВыбораИзРешения_ИнвентаризацияЦенныхБумаг()
		
		ИначеЕсли ТипОписи = Тип("ДокументСсылка.ИнвентаризацияОстатковНаСчетах") Тогда // 0504082
			Текст = ТекстЗапроса_ПоискОписейДляВыбораИзРешения_ИнвентаризацияОстатковНаСчетах();
		
		ИначеЕсли ТипОписи = Тип("ДокументСсылка.ИнвентаризацияКредитовИЗаймов") Тогда // 0504083
			Текст = ТекстЗапроса_ПоискОписейДляВыбораИзРешения_ИнвентаризацияКредитовИЗаймов();
		
		ИначеЕсли ТипОписи = Тип("ДокументСсылка.ИнвентаризацияГосдолгаВЦенныхБумагах") Тогда // 0504084
			Текст = ТекстЗапроса_ПоискОписейДляВыбораИзРешения_ИнвентаризацияГосдолгаВЦенныхБумагах();
			
		ИначеЕсли ТипОписи = Тип("ДокументСсылка.ИнвентаризацияГосдолгаПоКредитамИГарантиям") Тогда // 0504085
			Текст = ТекстЗапроса_ПоискОписейДляВыбораИзРешения_ИнвентаризацияГосдолгаПоКредитамИГарантиям();
			
		ИначеЕсли ТипОписи = Тип("ДокументСсылка.ИнвентаризацияКассы") Тогда // 0504086, 0504088
			Текст = ТекстЗапроса_ПоискОписейДляВыбораИзРешения_ИнвентаризацияКассы();
			
		ИначеЕсли ТипОписи = Тип("ДокументСсылка.ИнвентаризацияИК") Тогда // 0504087
			Текст = ТекстЗапроса_ПоискОписейДляВыбораИзРешения_ИнвентаризацияИК();
			
		ИначеЕсли ТипОписи = Тип("ДокументСсылка.ИнвентаризацияМЗ") Тогда // 0504087
			Текст = ТекстЗапроса_ПоискОписейДляВыбораИзРешения_ИнвентаризацияМЗ();
			
		ИначеЕсли ТипОписи = Тип("ДокументСсылка.ИнвентаризацияОС") Тогда // 0504087
			Текст = ТекстЗапроса_ПоискОписейДляВыбораИзРешения_ИнвентаризацияОС();
			
		ИначеЕсли ТипОписи = Тип("ДокументСсылка.ИнвентаризацияРасчетовСКонтрагентами") Тогда // 0504089
			Текст = ТекстЗапроса_ПоискОписейДляВыбораИзРешения_ИнвентаризацияРасчетовСКонтрагентами();
			
		ИначеЕсли ТипОписи = Тип("ДокументСсылка.ИнвентаризацияРасчетовПоПоступлениям") Тогда // 0504091
			Текст = ТекстЗапроса_ПоискОписейДляВыбораИзРешения_ИнвентаризацияРасчетовПоПоступлениям();
			
		// Приказ 61н
		
		ИначеЕсли ТипОписи = Тип("ДокументСсылка.АктОРезультатахИнвентаризацииНаличныхДС") Тогда // 0510836
			Текст = ТекстЗапроса_ПоискОписейДляВыбораИзРешения_АктОРезультатахИнвентаризацииНаличныхДС();
		
		ИначеЕсли ТипОписи = Тип("ДокументСсылка.ИнвентаризационнаяОписьОстатковНаСчетах") Тогда // 0510464
			Текст = ТекстЗапроса_ПоискОписейДляВыбораИзРешения_ИнвентаризационнаяОписьОстатковНаСчетах();
			
		ИначеЕсли ТипОписи = Тип("ДокументСсылка.ИнвентаризационнаяОписьБСО") Тогда // 0510465
			Текст = ТекстЗапроса_ПоискОписейДляВыбораИзРешения_ИнвентаризационнаяОписьБСО();
			
		ИначеЕсли ТипОписи = Тип("ДокументСсылка.ИнвентаризационнаяОписьНФА") Тогда // 0510466
			Текст = ТекстЗапроса_ПоискОписейДляВыбораИзРешения_ИнвентаризационнаяОписьНФА();
			
		ИначеЕсли ТипОписи = Тип("ДокументСсылка.ИнвентаризационнаяОписьНаличныхСредств") Тогда // 0510467
			Текст = ТекстЗапроса_ПоискОписейДляВыбораИзРешения_ИнвентаризационнаяОписьНаличныхСредств();
			
		ИначеЕсли ТипОписи = Тип("ДокументСсылка.ИнвентаризационнаяОписьРасчетовПоПоступлениям") Тогда // 0510468
			Текст = ТекстЗапроса_ПоискОписейДляВыбораИзРешения_ИнвентаризационнаяОписьРасчетовПоПоступлениям();
			
		ИначеЕсли ТипОписи = Тип("ДокументСсылка.ИнвентаризационнаяОписьРасчетовСКонтрагентами") Тогда // 0510469
			Текст = ТекстЗапроса_ПоискОписейДляВыбораИзРешения_ИнвентаризационнаяОписьРасчетовСКонтрагентами();
			
		ИначеЕсли ТипОписи = Тип("ДокументСсылка.ИнвентаризационнаяОписьЦенныхБумаг") Тогда // 0510470
			Текст = ТекстЗапроса_ПоискОписейДляВыбораИзРешения_ИнвентаризационнаяОписьЦенныхБумаг();
			
		ИначеЕсли ТипОписи = Тип("ДокументСсылка.ИнвентаризационнаяОписьКредитовИЗаймов") Тогда // 0510471
			Текст = ТекстЗапроса_ПоискОписейДляВыбораИзРешения_ИнвентаризационнаяОписьКредитовИЗаймов();
			
		ИначеЕсли ТипОписи = Тип("ДокументСсылка.ИнвентаризационнаяОписьГосДолгаВЦенныхБумагах") Тогда // 0510472
			Текст = ТекстЗапроса_ПоискОписейДляВыбораИзРешения_ИнвентаризационнаяОписьГосДолгаВЦенныхБумагах();
			
		ИначеЕсли ТипОписи = Тип("ДокументСсылка.ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам") Тогда // 0510473
			Текст = ТекстЗапроса_ПоискОписейДляВыбораИзРешения_ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам();
			
		ИначеЕсли ТипОписи = Тип("ДокументСсылка.ИнвентаризационнаяОписьГосДолгаПоПредоставленнымГарантиям") Тогда // 0510474
			Текст = ТекстЗапроса_ПоискОписейДляВыбораИзРешения_ИнвентаризационнаяОписьГосДолгаПоПредоставленнымГарантиям();
			
		ИначеЕсли ТипОписи = Тип("ДокументСсылка.УдалитьИнвентаризационнаяОписьРасчетовПоПоступлениям") Тогда // 0510468
			Текст = ТекстЗапроса_ПоискОписейДляВыбораИзРешения_УдалитьИнвентаризационнаяОписьРасчетовПоПоступлениям();
		Иначе
			Продолжить;
		КонецЕсли;
		
		ИндексыЗапросов.Вставить(ТипОписи, ИндексыЗапросов.Количество());
		
		Тексты.Добавить(Текст);
	КонецЦикла;
	
	Если ИндексыЗапросов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("РешениеОПроведенииИнвентаризации", РешениеСсылка);
	ЗапросПоиск.Текст = СтрСоединить(Тексты, ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета());
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатыЗапроса = ЗапросПоиск.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	
	Для Каждого ТипОписи Из ТипыОписей Цикл
		ИндексЗапроса = ИндексыЗапросов.Получить(ТипОписи);
		
		Если ИндексЗапроса = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ТаблицыОписей.Вставить(ТипОписи, РезультатыЗапроса[ИндексЗапроса].Выгрузить());
	КонецЦикла;
	
	Данные.ПоискОписей.ТаблицыОписей = ТаблицыОписей;
	
КонецПроцедуры

Процедура СопоставитьСДокументамиОписейДляВыбораИзРешения(Данные)
	
	ПодходящаяЧастьТаблицыОбъекты	= Данные.ПоискОписей.ПодходящаяЧастьТаблицыОбъекты;
	ТаблицыОписей					= Данные.ПоискОписей.ТаблицыОписей;
	ТаблицаОтметок					= Данные.ДополнительныеПараметры.ТаблицаОтметок;
	ТаблицаНастроекВсеОписи			= Данные.ДополнительныеПараметры.ТаблицаНастроекВсеОписи;
	
	ПоискНомерСтроки = Новый Структура("НомерСтроки");
	
	Для Каждого СтрокаТаблицыОтметок Из ТаблицаОтметок Цикл
		ДокументыОписей = ПолучитьПустуюТаблицуДокументыОписей();
		
		Для Каждого НомерСтроки Из СтрокаТаблицыОтметок.НомераСтрок Цикл
			ПоискНомерСтроки.НомерСтроки = НомерСтроки;
			
			МассивСтрок = ПодходящаяЧастьТаблицыОбъекты.НайтиСтроки(ПоискНомерСтроки);
			
			Для Каждого СтрокаТаблицыОбъекты Из МассивСтрок Цикл
				Для Каждого Элемент Из СтрокаТаблицыОбъекты.СопоставленныеСтрокиНастроек Цикл
					СтрокаТаблицыНастроек = ТаблицаНастроекВсеОписи[Элемент.НомерСтрокиТаблицыНастроек - 1];
					
					СопоставитьДокументыОписейДляВыбораИзРешения(СтрокаТаблицыОбъекты, ТаблицыОписей, СтрокаТаблицыНастроек, ДокументыОписей);
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
		
		ДокументыОписей.Сортировать("Дата,Номер");
		
		СтрокаТаблицыОтметок.ДокументыОписей = ДокументыОписей;
	КонецЦикла;
	
КонецПроцедуры

Процедура СопоставитьДокументыОписейДляВыбораИзРешения(СтрокаТаблицыОбъекты, ТаблицыОписей, СтрокаТаблицыНастроек, ДокументыОписей)
	
	ТипОписи = СтрокаТаблицыНастроек.ТипОписи;
	
	ТаблицаОписей = ТаблицыОписей.Получить(ТипОписи);
	
	Если ТаблицаОписей = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РасположениеРеквизитов = ПолучитьОписаниеРасположенияРеквизитовОписи(СтрокаТаблицыНастроек);
	
	// Эти поля имеют одинаковые наименования в таблице объектов и в таблице описей.
	Поиск = Новый Структура("
		|ДатаНачала,
		|ДатаОкончания,
		|ДатаИнвентаризации");
	
	Если ТаблицаОписей.Колонки.Найти("НомерКомиссии") <> Неопределено Тогда
		Поиск.Вставить("НомерКомиссии");
	КонецЕсли;
	
	Если ТаблицаОписей.Колонки.Найти("НомерРабочейКомиссии") <> Неопределено Тогда
		Поиск.Вставить("НомерРабочейКомиссии");
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Поиск, СтрокаТаблицыОбъекты);
	
	Если РасположениеРеквизитов.КФО.РасположенВШапке Тогда
		Поиск.Вставить(РасположениеРеквизитов.КФО.ИмяПоля, СтрокаТаблицыОбъекты.КФО);
	КонецЕсли;
	
	Если РасположениеРеквизитов.Счет.РасположенВШапке Тогда
		Поиск.Вставить(РасположениеРеквизитов.Счет.ИмяПоля, СтрокаТаблицыОбъекты.Счет);
	КонецЕсли;
	
	Если РасположениеРеквизитов.Сотрудник.РасположенВШапке Тогда
		Поиск.Вставить(РасположениеРеквизитов.Сотрудник.ИмяПоля, СтрокаТаблицыОбъекты.Сотрудник);
	КонецЕсли;
	
	Если РасположениеРеквизитов.МестоИнвентаризации.РасположенВШапке Тогда
		Поиск.Вставить(РасположениеРеквизитов.МестоИнвентаризации.ИмяПоля, СтрокаТаблицыОбъекты.МестоИнвентаризации);
	КонецЕсли;
	
	// В документе ИнвентаризацияКассы счет в шапке описи используется нестандартным образом.
	// Счет применяется только для БСО, и может быть указан лишь счет 03 или его субсчета.
	// Если счет не указан, то он считается равным 03.
	// Поэтому из структуры поиска поле Счет исключается, и сопоставление выполняется вручную.
	Если ТипОписи = Тип("ДокументСсылка.ИнвентаризацияКассы") И РасположениеРеквизитов.Счет.РасположенВШапке Тогда
		Поиск.Удалить(РасположениеРеквизитов.Счет.ИмяПоля);
	КонецЕсли;
	
	МассивСтрок = ТаблицаОписей.НайтиСтроки(Поиск);
	
	ПоискОписи = Новый Структура("Ссылка");
	
	Для Каждого СтрокаТаблицыОписей Из МассивСтрок Цикл
		// Ручное сопоставление по счету для документа ИнвентаризацияКассы.
		// Счет применяется только для БСО, и может быть указан лишь счет 03 или его субсчета.
		Если ТипОписи = Тип("ДокументСсылка.ИнвентаризацияКассы") И РасположениеРеквизитов.Счет.РасположенВШапке Тогда
			Если ЗначениеЗаполнено(СтрокаТаблицыОписей.СчетУчетаБСО) И СтрокаТаблицыОписей.СчетУчетаБСО <> СтрокаТаблицыОбъекты.Счет
				Или Не ЗначениеЗаполнено(СтрокаТаблицыОписей.СчетУчетаБСО) И СтрокаТаблицыОбъекты.СчетКод <> "03" Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Если РасположениеРеквизитов.КФО.РасположенВТабличнойЧасти Или РасположениеРеквизитов.Счет.РасположенВТабличнойЧасти Тогда
			Если Не КФОиСчетВТабличнойЧастиСопоставленыДляВыбораИзРешения(СтрокаТаблицыОбъекты, СтрокаТаблицыОписей, РасположениеРеквизитов) Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Если РасположениеРеквизитов.МестоИнвентаризации.РасположенВТабличнойЧасти Тогда
			Если Не МестаИнвентаризацииСопоставленыДляВыбораИзРешения(СтрокаТаблицыОбъекты, СтрокаТаблицыОписей, РасположениеРеквизитов) Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		ПоискОписи.Ссылка = СтрокаТаблицыОписей.Ссылка;
		
		МассивСтрок = ДокументыОписей.НайтиСтроки(ПоискОписи);
		
		Если МассивСтрок.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ДокументыОписей.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицыОписей);
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицыНастроек, "КодФормы");
	КонецЦикла;
	
КонецПроцедуры

Функция КФОиСчетВТабличнойЧастиСопоставленыДляВыбораИзРешения(СтрокаТаблицыОбъекты, СтрокаТаблицыОписей, РасположениеРеквизитов)
	
	ТаблицаСписокСчетов = СтрокаТаблицыОписей[РасположениеРеквизитов.Счет.ИмяТабличнойЧасти];
	
	Поиск = Новый Структура();
	
	Если РасположениеРеквизитов.КФО.РасположенВТабличнойЧасти Тогда
		Поиск.Вставить(РасположениеРеквизитов.КФО.ИмяКолонки, СтрокаТаблицыОбъекты.КФО);
	КонецЕсли;
	
	Если РасположениеРеквизитов.Счет.РасположенВТабличнойЧасти Тогда
		Поиск.Вставить(РасположениеРеквизитов.Счет.ИмяКолонки, СтрокаТаблицыОбъекты.Счет);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РасположениеРеквизитов.Счет.ИмяКолонкиПризнакИспользования) Тогда
		Поиск.Вставить(РасположениеРеквизитов.Счет.ИмяКолонкиПризнакИспользования, Истина);
	КонецЕсли;
	
	МассивСтрок = ТаблицаСписокСчетов.НайтиСтроки(Поиск);
	
	Возврат (МассивСтрок.Количество() > 0);
	
КонецФункции

Функция МестаИнвентаризацииСопоставленыДляВыбораИзРешения(СтрокаТаблицыОбъекты, СтрокаТаблицыОписей, РасположениеРеквизитов)
	
	ТаблицаМестаИнвентаризации = СтрокаТаблицыОписей[РасположениеРеквизитов.МестоИнвентаризации.ИмяТабличнойЧасти];
	
	Поиск = Новый Структура(РасположениеРеквизитов.МестоИнвентаризации.ИмяКолонки, СтрокаТаблицыОбъекты.МестоИнвентаризации);
	
	МассивСтрок = ТаблицаМестаИнвентаризации.НайтиСтроки(Поиск);
	
	Возврат (МассивСтрок.Количество() > 0);
	
КонецФункции

Процедура ЗаполнитьПредставлениеДокументовОписейДляВыбораИзРешения(Данные)
	
	ТаблицаОтметок	= Данные.ДополнительныеПараметры.ТаблицаОтметок;
	ОписьСсылка		= Данные.ДополнительныеПараметры.ОписьСсылка;
	
	ШаблонПредставлениеДокумента = НСтр("ru='%1 от %2'");
	
	ШаблонПредставлениеСпискаДокументов = НСтр("ru='(%1) %2'");
	
	ТекстСоединитель = ", ";
	
	КартинкаДокументНеПроведен = БиблиотекаКартинок.Документ;
	КартинкаДокументПроведен = БиблиотекаКартинок.Провести;
	
	Для Каждого СтрокаТаблицыОтметок Из ТаблицаОтметок Цикл
		
		Тексты = Новый Массив();
		
		СписокДокументовОписей = Новый СписокЗначений();
		
		ЕстьПроведенный = Ложь;
		
		Для Каждого ОписаниеДокументаОписи Из СтрокаТаблицыОтметок.ДокументыОписей Цикл
			КодФормы = ОписаниеДокументаОписи.КодФормы;
			
			Если ОписаниеДокументаОписи.Проведен Тогда
				ЕстьПроведенный = Истина;
			КонецЕсли;
			
			Если ОписаниеДокументаОписи.Ссылка = ОписьСсылка Тогда 
				ПредставлениеДокумента = НСтр("ru='<Эта опись>'");
				
				КартинкаДокумента = Неопределено;
			Иначе
				ПредставлениеНомер = РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
					ОписаниеДокументаОписи.Ссылка,
					ОписаниеДокументаОписи.Номер);
				
				ПредставлениеДата = Формат(ОписаниеДокументаОписи.Дата, "ДФ=""дд.ММ.гггг""");
				
				ПредставлениеДокумента = СтрШаблон(ШаблонПредставлениеДокумента, ПредставлениеНомер, ПредставлениеДата);
				
				КартинкаДокумента = ?(ОписаниеДокументаОписи.Проведен, КартинкаДокументПроведен, КартинкаДокументНеПроведен);
			КонецЕсли;
			
			Тексты.Добавить(ПредставлениеДокумента);
			
			СписокДокументовОписей.Добавить(ОписаниеДокументаОписи.Ссылка, ПредставлениеДокумента,, КартинкаДокумента);
		КонецЦикла;
		
		Представление = СтрСоединить(Тексты, ТекстСоединитель);
		
		Если Тексты.Количество() > 1 Тогда
			Представление = СтрШаблон(ШаблонПредставлениеСпискаДокументов, Тексты.Количество(), Представление);
		КонецЕсли;
		
		ИнвентаризацияКлиентСервер.СократитьСтроку(Представление, 100);
		
		СтрокаТаблицыОтметок.ПредставлениеДокументовОписей = Представление;
		СтрокаТаблицыОтметок.СписокДокументовОписей = СписокДокументовОписей;
		СтрокаТаблицыОтметок.ЕстьПроведенный = ЕстьПроведенный;
	КонецЦикла;
	
КонецПроцедуры

Функция СкопироватьНайденныеСтрокиТаблицыОбъекты(ТаблицаОбъекты, ТаблицаОтметок)
	
	КопияТаблицыОбъекты = ТаблицаОбъекты.СкопироватьКолонки();
	
	Для Каждого СтрокаТаблицы Из ТаблицаОтметок Цикл
		Для Каждого НомерСтроки Из СтрокаТаблицы.НомераСтрок Цикл
			СтрокаТаблицыОбъекты = ТаблицаОбъекты[НомерСтроки - 1];
			
			НоваяСтрока = КопияТаблицыОбъекты.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаТаблицыОбъекты);
		КонецЦикла;
	КонецЦикла;
	
	Возврат КопияТаблицыОбъекты;
	
КонецФункции

