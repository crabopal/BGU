Функция ПолучитьНачалоПримененияПриказа144н()
	
	Возврат '20240701'; // Дата начала применения приказа Минфина от 13.09.2023 N 144н.
	
КонецФункции

Процедура ПроверитьДатыИнвентаризации_ОдинНаборДанных(НаборДанных, ДокументСсылка, Шаблоны, Отказ, ИмяТаблицы = Неопределено, ПредставлениеТаблицы = Неопределено, НомерСтроки = Неопределено)
	
	ДатаНачала			= НаборДанных.ДатаНачала;
	ДатаОкончания		= НаборДанных.ДатаОкончания;
	ДатаИнвентаризации	= '00010101';
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(НаборДанных, "ДатаИнвентаризации") Тогда
		ДатаИнвентаризации	= НаборДанных.ДатаИнвентаризации;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДатаНачала) И Не ЗначениеЗаполнено(ДатаОкончания) Тогда
		Возврат;
	КонецЕсли;
	
	Если ДатаНачала > ДатаОкончания Тогда
		Отказ = Истина;
		
		ПроверитьДатыИнвентаризации_СообщитьПользователю("ДатаОкончания", ДокументСсылка, Шаблоны, ИмяТаблицы, ПредставлениеТаблицы, НомерСтроки);
		
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДатаИнвентаризации) Тогда
		Возврат;
	КонецЕсли;
	
	НачалоПримененияПриказа144н = ПолучитьНачалоПримененияПриказа144н();
	
	Если ДатаИнвентаризации < НачалоПримененияПриказа144н И ДатаИнвентаризации > ДатаОкончания Тогда
		Отказ = Истина;
		
		ПроверитьДатыИнвентаризации_СообщитьПользователю("ДатаИнвентаризации", ДокументСсылка, Шаблоны, ИмяТаблицы, ПредставлениеТаблицы, НомерСтроки);
		
		Возврат;
	КонецЕсли;
	
	Если ДатаИнвентаризации >= НачалоПримененияПриказа144н И ДатаНачала < ДатаИнвентаризации Тогда
		// Приказ Минфина от 13.09.2023 N 144н, пункт 12
		// Дата начала проведения инвентаризации не должна предшествовать дате, на которую проводится инвентаризация.
		Отказ = Истина;
		
		ПроверитьДатыИнвентаризации_СообщитьПользователю("ДатаНачала", ДокументСсылка, Шаблоны, ИмяТаблицы, ПредставлениеТаблицы, НомерСтроки);
		
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьДатыИнвентаризации_СообщитьПользователю(ИмяПоля, ДокументСсылка, Шаблоны, ИмяТаблицы = Неопределено, ПредставлениеТаблицы = Неопределено, НомерСтроки = Неопределено)
	
	Если ИмяТаблицы = Неопределено Тогда
		
		// Выводим сообщение к полю шапки документа
		
		ИмяПоляДляВыводаСообщения = "Объект." + ИмяПоля;
		
		ТекстСообщения = СтрШаблон(Шаблоны[ИмяПоля], "");
		
	Иначе
		
		// Выводим сообщение к строке табличной части документа
		
		НомерСтрокиТекст = Строка(НомерСтроки);
		
		ИндексСтрокиТекст = ФорматироватьИндексСтрокиТаблицыДляВыводаСообщения(НомерСтроки - 1);
		
		ИмяПоляДляВыводаСообщения = "Объект." + ИмяТаблицы + "[" + ИндексСтрокиТекст + "]." + ИмяПоля;
		
		ТекстНомерСтрокиТабличнойЧасти = СтрШаблон(Шаблоны["НомерСтрокиТабличнойЧасти"], ПредставлениеТаблицы, НомерСтрокиТекст);
		
		ТекстСообщения = СтрШаблон(Шаблоны[ИмяПоля], ТекстНомерСтрокиТабличнойЧасти);
		
	КонецЕсли;
	
	ОбщегоНазначения.СообщитьПользователю(
		ТекстСообщения,
		ДокументСсылка,
		ИмяПоляДляВыводаСообщения);
	
КонецПроцедуры

#Область Печать_0504087_194н

Функция Печать0504087_194н(ВыборкиДляПечати, ВыводитьФактическоеНаличие, ПараметрыБСП, Знач НастройкиВывода = Неопределено)
	
	// Используемый макет
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_ИнвентаризационнаяОписьНФА_0504087_194н");
	
	// Настройки из макета печатной формы
	ОчищающаяСтруктураФактическогоНаличия	= Печать0504087_194н_ПолучитьОчищающуюСтруктуруФактическогоНаличия(Макет);
	ВыводитьИтогиПоСтранице					= ОбщегоНазначенияБГУ.ПолучитьНастройкуБулевоИзМакета(Макет, "ВыводитьИтогиПоСтранице");
	Графа3_ВыводитьКодОС					= ОбщегоНазначенияБГУ.ПолучитьНастройкуБулевоИзМакета(Макет, "Графа3_ВыводитьКодОС", Ложь);
	Графа3_ВыводитьКодМЗ					= ОбщегоНазначенияБГУ.ПолучитьНастройкуБулевоИзМакета(Макет, "Графа3_ВыводитьКодМЗ", Истина);
	Графа2_ВыводитьСубконто3				= ОбщегоНазначенияБГУ.ПолучитьНастройкуБулевоИзМакета(Макет, "Графа2_ВыводитьСубконто3", Истина);
	
	// Возвращаемый табличный документ
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.КлючПараметровПечати = "ПечатьФормы0504087_194н";
	
	// Данные для печати
	ВыборкаШапка				= ВыборкиДляПечати["Шапка"];
	ВыборкаДокументКомиссия		= ВыборкиДляПечати["ДокументКомиссия"];
