#Область АнализОборотовВОписяхРасчетов

Функция ПолучитьТаблицуОборотовСНачалаГода(ТаблицаОстатковОписи, ПараметрыПоискаОборотов, НаличиеКолонок, ДляОписи52н = Ложь)
	
	// Величина оборотов не определяется, необходим лишь факт наличия оборотов.
	
	СписокСчетов		= ПолучитьМассивУникальныхЗначенийКолонкиТаблицы(ТаблицаОстатковОписи, "Счет");
	СписокКФО			= ПолучитьМассивУникальныхЗначенийКолонкиТаблицы(ТаблицаОстатковОписи, "КФО");
	СписокКонтрагентов	= ПолучитьМассивУникальныхЗначенийКолонкиТаблицы(ТаблицаОстатковОписи, "Контрагент");
	
	Если НаличиеКолонок.Договор Тогда
		СписокДоговоров = ПолучитьМассивУникальныхЗначенийКолонкиТаблицы(ТаблицаОстатковОписи, "Договор");
	Иначе
		СписокДоговоров = Неопределено;
	КонецЕсли;
	
	Если НаличиеКолонок.ИФО Тогда
		СписокИФО = ПолучитьМассивУникальныхЗначенийКолонкиТаблицы(ТаблицаОстатковОписи, "ИФО");
	Иначе
		СписокИФО = Неопределено;
	КонецЕсли;
	
	Если НаличиеКолонок.Подразделение Тогда
		СписокПодразделений = ПолучитьМассивУникальныхЗначенийКолонкиТаблицы(ТаблицаОстатковОписи, "Подразделение");
	Иначе
		СписокПодразделений = Неопределено;
	КонецЕсли;
	
	ИспользоватьОтборПоИФО = ПараметрыПоискаОборотов.ИспользоватьУчетПоИФО И НаличиеКолонок.ИФО;
	
	ИспользоватьОтборПоПодразделениям = ПараметрыПоискаОборотов.ИспользоватьУчетПоПодразделениям И НаличиеКолонок.Подразделение;
	
	Если ДляОписи52н Тогда
		КонецПериода = ИнвентаризацияКлиентСервер.ПолучитьДатуОпределенияОстатков52н(ПараметрыПоискаОборотов.ДатаИнвентаризации);
	Иначе
		КонецПериода = ИнвентаризацияКлиентСервер.ПолучитьДатуОпределенияОстатков(ПараметрыПоискаОборотов.ДатаИнвентаризации);
	КонецЕсли;
	
	ЗапросОбороты = Новый Запрос();
	ЗапросОбороты.УстановитьПараметр("НачалоПериода",						НачалоГода(ПараметрыПоискаОборотов.ДатаИнвентаризации));
	ЗапросОбороты.УстановитьПараметр("КонецПериода",						КонецПериода);
	ЗапросОбороты.УстановитьПараметр("Организация",							ПараметрыПоискаОборотов.Организация);
	ЗапросОбороты.УстановитьПараметр("ИспользоватьОтборПоИФО",				ИспользоватьОтборПоИФО);
	ЗапросОбороты.УстановитьПараметр("СписокИФО",							СписокИФО);
	ЗапросОбороты.УстановитьПараметр("ИспользоватьОтборПоПодразделениям",	ИспользоватьОтборПоПодразделениям);
	ЗапросОбороты.УстановитьПараметр("СписокПодразделений",					СписокПодразделений);
	ЗапросОбороты.УстановитьПараметр("СписокСчетов",						СписокСчетов);
	ЗапросОбороты.УстановитьПараметр("СписокКФО",							СписокКФО);
	ЗапросОбороты.УстановитьПараметр("СписокКонтрагентов",					СписокКонтрагентов);
	ЗапросОбороты.УстановитьПараметр("СписокДоговоров",						СписокДоговоров);
	ЗапросОбороты.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Счет													КАК Счет,
	|	КФО														КАК КФО,
	|	КПС														КАК КПС,
	|	ЕСТЬNULL(ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка))	КАК ИФО,
	|	ЕСТЬNULL(Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))			КАК Подразделение,
	|	ВЫБОР
	|		КОГДА Субконто1 ССЫЛКА Справочник.Контрагенты ТОГДА
	|			Субконто1
	|		КОГДА Субконто2 ССЫЛКА Справочник.Контрагенты ТОГДА
	|			Субконто2
	|		КОГДА Субконто3 ССЫЛКА Справочник.Контрагенты ТОГДА
	|			Субконто3
	|		
	|		КОГДА Субконто1 ССЫЛКА Справочник.Договоры ТОГДА
	|			ЕСТЬNULL(ВЫРАЗИТЬ(Субконто1 КАК Справочник.Договоры).Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
	|		КОГДА Субконто2 ССЫЛКА Справочник.Договоры ТОГДА
	|			ЕСТЬNULL(ВЫРАЗИТЬ(Субконто2 КАК Справочник.Договоры).Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
	|		КОГДА Субконто3 ССЫЛКА Справочник.Договоры ТОГДА
	|			ЕСТЬNULL(ВЫРАЗИТЬ(Субконто3 КАК Справочник.Договоры).Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
	|		
	|		ИНАЧЕ
	|			Счет.Наименование
	|	КОНЕЦ													КАК Контрагент,
	|	ВЫБОР
	|		КОГДА Субконто1 ССЫЛКА Справочник.Договоры ТОГДА
	|			Субконто1
	|		КОГДА Субконто2 ССЫЛКА Справочник.Договоры ТОГДА
	|			Субконто2
	|		КОГДА Субконто3 ССЫЛКА Справочник.Договоры ТОГДА
	|			Субконто3
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	|	КОНЕЦ													КАК Договор
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|		&НачалоПериода,
	|		&КонецПериода,
	|		,
	|		Счет В(&СписокСчетов),
	|		,
	|		Организация = &Организация
	|		И КФО В(&СписокКФО)
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоИФО ТОГДА
	|				ИФО В(&СписокИФО)
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоПодразделениям ТОГДА
	|				Подразделение В(&СписокПодразделений)
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА Субконто1 ССЫЛКА Справочник.Договоры ТОГДА
	|				Субконто1 В (&СписокДоговоров)
	|			КОГДА Субконто2 ССЫЛКА Справочник.Договоры ТОГДА
	|				Субконто2 В (&СписокДоговоров)
	|			КОГДА Субконто3 ССЫЛКА Справочник.Договоры ТОГДА
	|				Субконто3 В (&СписокДоговоров)
	|				
	|			КОГДА Субконто1 ССЫЛКА Справочник.Контрагенты ТОГДА
	|				Субконто1 В (&СписокКонтрагентов)
	|			КОГДА Субконто2 ССЫЛКА Справочник.Контрагенты ТОГДА
	|				Субконто2 В (&СписокКонтрагентов)
	|			КОГДА Субконто3 ССЫЛКА Справочник.Контрагенты ТОГДА
	|				Субконто3 В (&СписокКонтрагентов)
	|				
	|			ИНАЧЕ
	|				ЛОЖЬ
	|		КОНЕЦ)";
	
	ТаблицаОборотов = ЗапросОбороты.Выполнить().Выгрузить();
	
	ТаблицаОборотов.Индексы.Добавить(ПолучитьИменаПолейПоискОборотовЗадолженности(НаличиеКолонок));
	
	Возврат ТаблицаОборотов;
	
КонецФункции

Функция ОпределитьНаличиеКолонокТаблицыОстатковЗадолженности(ТаблицаОстатковЗадолженности)
	
	НаличиеКолонок = Новый Структура();
	НаличиеКолонок.Вставить("ИФО",				Ложь);
	НаличиеКолонок.Вставить("Подразделение",	Ложь);
	НаличиеКолонок.Вставить("Договор",			Ложь);
	
	Для Каждого Элемент Из НаличиеКолонок Цикл
		ИмяКолонки = Элемент.Ключ;
		
		Если ТаблицаОстатковЗадолженности.Колонки.Найти(ИмяКолонки) <> Неопределено Тогда
			НаличиеКолонок[ИмяКолонки] = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат НаличиеКолонок;
	
КонецФункции

Функция ПолучитьИменаПолейПоискОборотовЗадолженности(НаличиеКолонок)
	
	ИменаПолей = "Счет,КФО,КПС,Контрагент";
	
	ОпциональныеПоля = СтрРазделить("Договор,ИФО,Подразделение", ", ", Ложь);
	
	Для Каждого ИмяПоля Из ОпциональныеПоля Цикл
		Если НаличиеКолонок[ИмяПоля] Тогда
			ИменаПолей = ИменаПолей + "," + ИмяПоля;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ИменаПолей;
	
КонецФункции

Функция ПолучитьМассивУникальныхЗначенийКолонкиТаблицы(Таблица, ИмяКолонки)
	
	ВремТаблица = Таблица.Скопировать(, ИмяКолонки);
	ВремТаблица.Свернуть(ИмяКолонки);
	
	Возврат ВремТаблица.ВыгрузитьКолонку(ИмяКолонки);
	
КонецФункции

