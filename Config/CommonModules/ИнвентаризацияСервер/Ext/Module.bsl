	ПараметрыВыводаТаблицы.ИменаПроцедур.РассчитатьИтогиПоТаблице			= "ИнвентаризацияСервер.РассчитатьИтогиПоТаблице_0504087";
	ПараметрыВыводаТаблицы.ИменаПроцедур.ЗаполнитьОбластиИтоговПоТаблице	= "ИнвентаризацияСервер.ЗаполнитьОбластиИтоговПоТаблице_0504087";
	
	ПараметрыВыводаТаблицы.ТабличныйДокумент = ТабДокумент;
	
	ПараметрыВыводаТаблицы.ДополнительныеПараметры.Вставить("ВыборкаШапка", ВыборкаШапка);
	ПараметрыВыводаТаблицы.ДополнительныеПараметры.Вставить("ВыводитьФактическоеНаличие", ВыводитьФактическоеНаличие);
	ПараметрыВыводаТаблицы.ДополнительныеПараметры.Вставить("ОчищающаяСтруктураФактическогоНаличия", ОчищающаяСтруктураФактическогоНаличия);
	ПараметрыВыводаТаблицы.ДополнительныеПараметры.Вставить("Графа3_ВыводитьКодОС", Графа3_ВыводитьКодОС);
	ПараметрыВыводаТаблицы.ДополнительныеПараметры.Вставить("Графа3_ВыводитьКодМЗ", Графа3_ВыводитьКодМЗ);
	ПараметрыВыводаТаблицы.ДополнительныеПараметры.Вставить("Графа2_ВыводитьСубконто3", Графа2_ВыводитьСубконто3);
	
	ПараметрыВыводаТаблицы.НастройкиВывода.ДозаполнитьПустымиСтроками	= НЕ ВыводитьФактическоеНаличие;
	ПараметрыВыводаТаблицы.НастройкиВывода.ВыводитьИтогиПоСтранице		= ВыводитьИтогиПоСтранице;
	
	ПервыйДокумент = Истина;
	
	Пока ВыборкаШапка.Следующий() Цикл
		
		// Продвигаемся в остальных выборках до текущего документа
		ПоискТекущегоДокумента = Новый Структура("ДокументСсылка", ВыборкаШапка["ДокументСсылка"]);
		
		ВыборкаДокументКомиссия.Сбросить();
		ВыборкаДокументКомиссия.НайтиСледующий(ПоискТекущегоДокумента);
		
		ВыборкаДокументТаблицаНФА.Сбросить();
		ВыборкаДокументТаблицаНФА.НайтиСледующий(ПоискТекущегоДокумента);
		
		ВремВыборка = ВыборкаДокументТаблицаНФА.Выбрать();
		КоличествоСтрокВыборки = ВремВыборка.Количество();
		
		ВыборкаДокументТаблицаНФА.Сбросить();
		ВыборкаДокументТаблицаНФА.НайтиСледующий(ПоискТекущегоДокумента);
		
		ОбластьТитул = Макет.ПолучитьОбласть("Титул");
		
		Если НЕ ПервыйДокумент Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		
		ВремСтруктура = Новый Структура("ЭтоИнвентаризация11140");
		ЗаполнитьЗначенияСвойств(ВремСтруктура, ВыборкаШапка);
		ЭтоИнвентаризация11140 = (ВремСтруктура["ЭтоИнвентаризация11140"] = Истина);
		
		// Количество знаков после запятой для полей Количество, указанное в текущем документе.
		// Значение из документа имеет преимущество перед значением из параметров вывода.
		ВремСтруктура = Новый Структура("КоличествоЗнаковПослеЗапятойДляКоличества");
		ЗаполнитьЗначенияСвойств(ВремСтруктура, ВыборкаШапка);
		ЗначениеИзДокумента = ВремСтруктура["КоличествоЗнаковПослеЗапятойДляКоличества"];
		
		Если ЗначениеИзДокумента <> Неопределено Тогда
			КоличествоЗнаковПослеЗапятойДляКоличества = ЗначениеИзДокумента;
		Иначе
			КоличествоЗнаковПослеЗапятойДляКоличества = НастройкиВывода["КоличествоЗнаковПослеЗапятойДляКоличества"];
		КонецЕсли;
		
		//---
		// Титул
		//---
		СтруктураПараметров = Новый Структура();
		СтруктураПараметров.Вставить("ДатаОписи", Формат(ВыборкаШапка["ДатаИнвентаризации"], "ДФ=""dd ММММ yyyy 'г.'"""));
		СтруктураПараметров.Вставить("Дата", ВыборкаШапка["ДатаИнвентаризации"]);
