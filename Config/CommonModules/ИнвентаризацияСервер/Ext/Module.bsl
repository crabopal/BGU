Функция КомиссииСовпадают(Данные, СтрокаКомиссии, НастройкиСравнения)
	
	// Применяются следующие правила при сравнении составов комиссий.
	// Комиссии считаются совпадающими, если каждый член комиссии в описи есть в номинальном составе комиссии.
	// Если в описи указан сотрудник, отсутствующий в номинальном составе, то комиссии считаются различными.
	// Для совпадения комиссий допустимо в описи указывать меньше сотрудников, чем в номинальном составе.
	
	ЗначенияРеквизитов			= Данные.ДанныеОписи.ЗначенияРеквизитов;
	СведенияКомиссийИзРешения	= Данные.СведенияКомиссийИзРешения;
	
	Комиссия = СтрокаКомиссии.КомиссияСсылка;
	
	// Приказы о комиссии
	
	ПоискКомиссии = Новый Структура();
	ПоискКомиссии.Вставить("Ссылка", Комиссия);
	
	Если НастройкиСравнения.СравнитьПриказыОКомиссии Тогда
		ПриказКомиссии = СведенияКомиссийИзРешения.ТаблицаПриказыКомиссий.НайтиСтроки(ПоискКомиссии)[0];
		
		Если ЗначенияРеквизитов.НомерПриказаКомиссии <> ПриказКомиссии.НомерПриказа
			Или ЗначенияРеквизитов.ДатаПриказаКомиссии <> ПриказКомиссии.ДатаПриказа Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	// Председатели
	
	ТаблицаСоставКомиссии = СведенияКомиссийИзРешения.ТаблицаСоставыКомиссий.Скопировать(ПоискКомиссии);
	
	Если НастройкиСравнения.СравнитьПредседателей Тогда
		Поиск = Новый Структура();
		Поиск.Вставить("Ссылка",					Комиссия);
		Поиск.Вставить("Председатель",				Истина);
		Поиск.Вставить("ДолжностьЧленаКомиссии",	ЗначенияРеквизитов.ДолжностьПредседателяКомиссии);
		Поиск.Вставить("ФамилияЧленаКомиссии",		ЗначенияРеквизитов.ФамилияПредседателяКомиссии);
		Поиск.Вставить("ИмяЧленаКомиссии",			ЗначенияРеквизитов.ИмяПредседателяКомиссии);
		Поиск.Вставить("ОтчествоЧленаКомиссии",		ЗначенияРеквизитов.ОтчествоПредседателяКомиссии);
		
		МассивСтрок = ТаблицаСоставКомиссии.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	// Составы комиссий
	
	Если НастройкиСравнения.СравнитьСоставыКомиссий Тогда
		Поиск = Новый Структура("
			|ДолжностьЧленаКомиссии,
			|ФамилияЧленаКомиссии,
			|ИмяЧленаКомиссии,
			|ОтчествоЧленаКомиссии");
		
		Поиск.Вставить("Ссылка", Комиссия);
		
		Если ЗначениеЗаполнено(СтрокаКомиссии.НомерРабочейКомиссии) Тогда
			Поиск.Вставить("НомерРабочейКомиссии", СтрокаКомиссии.НомерРабочейКомиссии);
		КонецЕсли;
		
		Для Каждого СтрокаТаблицы Из ЗначенияРеквизитов.СоставКомиссии Цикл
			ЗаполнитьЗначенияСвойств(Поиск, СтрокаТаблицы, "ДолжностьЧленаКомиссии,ФамилияЧленаКомиссии,ИмяЧленаКомиссии,ОтчествоЧленаКомиссии");
			
			МассивСтрок = ТаблицаСоставКомиссии.НайтиСтроки(Поиск);
			
			КоличествоСтрок = МассивСтрок.Количество();
			
			Если КоличествоСтрок = 0 Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ПрочитатьКомиссииНазначенныеРешениемДляОписи52н(Знач ОписьСсылка, Знач РешениеСсылка, ТаблицаКомиссий)
	
	Данные = ПрочитатьДанныеДляВыбораИзРешения(ОписьСсылка, РешениеСсылка, Ложь);
	
	Если Данные.ДанныеРешения = Неопределено Тогда
		СведенияКомиссийИзРешения = Неопределено;
		
		Возврат Неопределено;
	КонецЕсли;
	
	СведенияКомиссийИзРешения = Данные.ДополнительныеПараметры.СведенияКомиссий;
	
	РазбитьТаблицуОбъектыНаГруппыСтрок(
		Данные.ДанныеРешения.ТаблицаОбъекты,
		Данные.ДополнительныеПараметры.ТаблицаНастроекПоТипуОписи,
		ТипЗнч(ОписьСсылка),
		Данные.ДополнительныеПараметры,
		ПолучитьПустыеНастройкиОбъединенияСтрокДляВыбораИзРешения());
		
	ДанныеОписи = ПрочитатьДанныеОписи52нДляСопоставленияСРешениемОПроведенииИнвентаризации(ОписьСсылка);
	
	Для Каждого ГруппаСтрок Из Данные.ДополнительныеПараметры.ГруппыСтрок Цикл
		Для Каждого Подгруппа Из ГруппаСтрок.ПодгруппыСтрок Цикл
			Если Не Опись52нСоответствуетПодгруппеСтрокРешения(ДанныеОписи, Подгруппа) Тогда
				Продолжить;
			КонецЕсли;
			
			ОпределитьКомиссиюДляПодгруппыСтрок(Данные, Подгруппа);
			
			КомиссияДляПодгруппыСтрок = Данные.ДополнительныеПараметры.КомиссияДляПодгруппыСтрок;
			
			КомиссияСсылка = КомиссияДляПодгруппыСтрок.КомиссияСсылка;
			
			НомерРабочейКомиссии = ?(КомиссияДляПодгруппыСтрок.ОтбиратьРабочиеКомиссии,
				КомиссияДляПодгруппыСтрок.НомераРабочихКомиссий[0],
				0);
			
			НоваяСтрока = ТаблицаКомиссий.Добавить();
			
			НоваяСтрока.КомиссияСсылка			= КомиссияСсылка;
			НоваяСтрока.НомерКомиссии			= КомиссияДляПодгруппыСтрок.НомерКомиссии;
			НоваяСтрока.НомерРабочейКомиссии	= НомерРабочейКомиссии;
			НоваяСтрока.СоставКомиссии			= ПолучитьСоставКомиссии(Данные, КомиссияСсылка, НомерРабочейКомиссии);
		КонецЦикла;
	КонецЦикла;
	
	Результат = Новый Структура();
	Результат.Вставить("ТаблицаКомиссий",			ТаблицаКомиссий);
	Результат.Вставить("СведенияКомиссийИзРешения",	СведенияКомиссийИзРешения);
	Результат.Вставить("ДанныеОписи",				ДанныеОписи);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьПустуюТаблицуКомиссийНазначенныхРешениемДляОписи52н()
	
	ТаблицаКомиссий = Новый ТаблицаЗначений();
	ТаблицаКомиссий.Колонки.Добавить("КомиссияСсылка",			Новый ОписаниеТипов("СправочникСсылка.ПостоянноДействующиеКомиссии"));
	ТаблицаКомиссий.Колонки.Добавить("НомерКомиссии",			ОбщегоНазначения.ОписаниеТипаЧисло(4,0,ДопустимыйЗнак.Неотрицательный));
	ТаблицаКомиссий.Колонки.Добавить("НомерРабочейКомиссии",	ОбщегоНазначения.ОписаниеТипаЧисло(2,0,ДопустимыйЗнак.Неотрицательный));
	ТаблицаКомиссий.Колонки.Добавить("СоставКомиссии",			Новый ОписаниеТипов("ТаблицаЗначений"));
	
	Возврат ТаблицаКомиссий;
	
КонецФункции

Функция Опись52нСоответствуетПодгруппеСтрокРешения(ДанныеОписи, ПодгруппаСтрок)
	
	ПоляГруппировок = ПодгруппаСтрок.ПоляГруппировок;
	
	Если ДанныеОписи.ЗначенияРеквизитов.ДатаИнвентаризации <> ПоляГруппировок.ДатаИнвентаризации
		Или ДанныеОписи.ЗначенияРеквизитов.ДатаНачала <> ПоляГруппировок.ДатаНачала
		Или ДанныеОписи.ЗначенияРеквизитов.ДатаОкончания <> ПоляГруппировок.ДатаОкончания Тогда
		
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ЗначениеПоляГруппировкиЕстьВОписи52н(ДанныеОписи, ПоляГруппировок, "КФО")
		Или Не ЗначениеПоляГруппировкиЕстьВОписи52н(ДанныеОписи, ПоляГруппировок, "МестоИнвентаризации")
		Или Не ЗначениеПоляГруппировкиЕстьВОписи52н(ДанныеОписи, ПоляГруппировок, "Сотрудник")
		Или Не ЗначениеПоляГруппировкиЕстьВОписи52н(ДанныеОписи, ПоляГруппировок, "Счет") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ЗначениеПоляГруппировкиЕстьВОписи52н(ДанныеОписи, ПоляГруппировок, ИмяПоляГруппировок)
	
	РасположениеРеквизита = ДанныеОписи.РасположениеРеквизитов[ИмяПоляГруппировок];
	
	Если РасположениеРеквизита.Отсутствует Или Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ПоляГруппировок, ИмяПоляГруппировок) Тогда
		Возврат Истина;
	КонецЕсли;
	
	ЗначениеПоляГруппировок = ПоляГруппировок[ИмяПоляГруппировок];
	
	Если РасположениеРеквизита.РасположенВШапке Тогда
		ЗначениеРеквизитаОписи = ДанныеОписи.ЗначенияРеквизитов[РасположениеРеквизита.ИмяПоля];
		
		Если ДанныеОписи.СтрокаТаблицыНастроек.ТипОписи = Тип("ДокументСсылка.ИнвентаризацияКассы")
			И ИмяПоляГруппировок = "Счет"
			И Не ЗначениеЗаполнено(ЗначениеРеквизитаОписи) Тогда
			// Исключение. Пустой счет в описи кассы.
			Возврат Истина;
		КонецЕсли;
		
		Если ЗначениеРеквизитаОписи <> ЗначениеПоляГруппировок Тогда
			Возврат Ложь;
		КонецЕсли;
		
	ИначеЕсли РасположениеРеквизита.РасположенВТаблице Тогда
		Таблица = ДанныеОписи.ЗначенияРеквизитов[РасположениеРеквизита.ИмяТаблицы];
		
		Поиск = Новый Структура(РасположениеРеквизита.ИмяКолонки, ЗначениеПоляГруппировок);
		
		Если ЗначениеЗаполнено(РасположениеРеквизита.ИмяКолонкиПризнакИспользования) Тогда
			Поиск.Вставить(РасположениеРеквизита.ИмяКолонкиПризнакИспользования, Истина);
		КонецЕсли;
		
		МассивСтрок = Таблица.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьСоставКомиссии(Данные, КомиссияСсылка, НомерРабочейКомиссии)
	
	ТаблицаСоставыКомиссий = Данные.ДополнительныеПараметры.СведенияКомиссий.ТаблицаСоставыКомиссий;
	
	ТаблицаСоставКомиссии = ТаблицаСоставыКомиссий.СкопироватьКолонки();
	
	ПоискКомиссии = Новый Структура("Ссылка", КомиссияСсылка);
	
	МассивСтрок = ТаблицаСоставыКомиссий.НайтиСтроки(ПоискКомиссии);
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		Если ЗначениеЗаполнено(НомерРабочейКомиссии) И СтрокаТаблицы.НомерРабочейКомиссии <> НомерРабочейКомиссии Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаСоставКомиссии.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
	КонецЦикла;
	
	Возврат ТаблицаСоставКомиссии;
	
КонецФункции

Функция ПрочитатьДанныеОписи52нДляСопоставленияСРешениемОПроведенииИнвентаризации(Опись52н)
	
	ТаблицаНастроек = ИнвентаризацияСервер.ПолучитьТаблицуНастроекЗаполненияОписейПоРешению(ТипЗнч(Опись52н), Истина);
	
	СтрокаТаблицыНастроек = ТаблицаНастроек[0];
	
	РасположениеРеквизитов = ПолучитьОписаниеРасположенияРеквизитовОписи(СтрокаТаблицыНастроек);
	
	РеквизитыОписи = Новый Массив();
	
	// КФО
	
	Если РасположениеРеквизитов.КФО.РасположенВШапке Тогда
		РеквизитыОписи.Добавить(РасположениеРеквизитов.КФО.ИмяПоля);
		
	ИначеЕсли РасположениеРеквизитов.КФО.РасположенВТабличнойЧасти Тогда
		ИмяТабличнойЧасти = РасположениеРеквизитов.КФО.ИмяТабличнойЧасти;
		Если РеквизитыОписи.Найти(ИмяТабличнойЧасти) = Неопределено Тогда
			РеквизитыОписи.Добавить(ИмяТабличнойЧасти);
		КонецЕсли;
	КонецЕсли;
	
	// Даты
	
	РеквизитыОписи.Добавить("ДатаИнвентаризации");
	РеквизитыОписи.Добавить("ДатаНачала");
	РеквизитыОписи.Добавить("ДатаОкончания");
	
	// Сотрудник
	
	Если РасположениеРеквизитов.Сотрудник.РасположенВШапке Тогда
		РеквизитыОписи.Добавить(РасположениеРеквизитов.Сотрудник.ИмяПоля);
		
	ИначеЕсли РасположениеРеквизитов.Сотрудник.РасположенВТабличнойЧасти Тогда
		ИмяТабличнойЧасти = РасположениеРеквизитов.Сотрудник.ИмяТабличнойЧасти;
		Если РеквизитыОписи.Найти(ИмяТабличнойЧасти) = Неопределено Тогда
			РеквизитыОписи.Добавить(ИмяТабличнойЧасти);
		КонецЕсли;
	КонецЕсли;
	
	// Счет
	
	Если РасположениеРеквизитов.Счет.РасположенВШапке Тогда
		РеквизитыОписи.Добавить(РасположениеРеквизитов.Счет.ИмяПоля);
		
	ИначеЕсли РасположениеРеквизитов.Счет.РасположенВТабличнойЧасти Тогда
		ИмяТабличнойЧасти = РасположениеРеквизитов.Счет.ИмяТабличнойЧасти;
		Если РеквизитыОписи.Найти(ИмяТабличнойЧасти) = Неопределено Тогда
			РеквизитыОписи.Добавить(ИмяТабличнойЧасти);
		КонецЕсли;
	КонецЕсли;
	
	// Комиссия
	
	РеквизитыОписи.Добавить("НомерПриказаКомиссии");
	РеквизитыОписи.Добавить("ДатаПриказаКомиссии");
	
	// Состав комиссии
	
	РеквизитыОписи.Добавить("ДолжностьПредседателяКомиссии");
	РеквизитыОписи.Добавить("ФамилияПредседателяКомиссии");
	РеквизитыОписи.Добавить("ИмяПредседателяКомиссии");
	РеквизитыОписи.Добавить("ОтчествоПредседателяКомиссии");
	
	РеквизитыОписи.Добавить("СоставКомиссии");
	
	// Место проведения инвентаризации
	
	Если РасположениеРеквизитов.МестоИнвентаризации.РасположенВШапке Тогда
		РеквизитыОписи.Добавить(РасположениеРеквизитов.МестоИнвентаризации.ИмяПоля);
		
	ИначеЕсли РасположениеРеквизитов.МестоИнвентаризации.РасположенВТабличнойЧасти Тогда
		ИмяТабличнойЧасти = РасположениеРеквизитов.МестоИнвентаризации.ИмяТабличнойЧасти;
		Если РеквизитыОписи.Найти(ИмяТабличнойЧасти) = Неопределено Тогда
			РеквизитыОписи.Добавить(ИмяТабличнойЧасти);
		КонецЕсли;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Опись52н, СтрСоединить(РеквизитыОписи,","));
	УстановитьПривилегированныйРежим(Ложь);
	
	СоставКомиссии = ЗначенияРеквизитов.СоставКомиссии.Выгрузить();
	СоставКомиссии.Колонки.Удалить("Ссылка");
	
	ЗначенияРеквизитов.СоставКомиссии = СоставКомиссии;
	
	ДанныеОписи = Новый Структура();
	ДанныеОписи.Вставить("СтрокаТаблицыНастроек",	ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(СтрокаТаблицыНастроек));
	ДанныеОписи.Вставить("РасположениеРеквизитов",	РасположениеРеквизитов);
	ДанныеОписи.Вставить("ЗначенияРеквизитов",		ЗначенияРеквизитов);
	
	Возврат ДанныеОписи;
	
КонецФункции

#КонецОбласти

#Область Форматирование

Функция ПредставлениеРабочихКомиссийДляФормыВыбораКомиссии()
	
	Возврат ИнвентаризацияКлиентСервер.ФорматироватьНомерРабочейКомиссии(0);
	
КонецФункции

Функция ПредставлениеОтсутствующихАктовОПроведенииИнвентаризации()
	
	Возврат НСтр("ru='отсутствуют'");
	
КонецФункции

Функция ПредставлениеОтсутствующихРабочихКомиссий()
	
	Возврат НСтр("ru='отсутствуют'");
	
КонецФункции

Функция ПолучитьПредставлениеСчетаДляРешенияСлужебный(СтрокаТаблицы, ВыбратьЗначенияДоИзменения = Ложь)
	
	ТекстДоИзменения = "ДоИзменения";
	
	ИмяПоляКФОНаименование	= СтрШаблон("КФО%1Наименование", ?(ВыбратьЗначенияДоИзменения, ТекстДоИзменения, ""));
	ИмяПоляСчетКод			= СтрШаблон("Счет%1Код", ?(ВыбратьЗначенияДоИзменения, ТекстДоИзменения, ""));
	ИмяПоляСчетНаименование	= СтрШаблон("Счет%1Наименование", ?(ВыбратьЗначенияДоИзменения, ТекстДоИзменения, ""));
	ИмяПоляСчетЗабалансовый	= СтрШаблон("Счет%1Забалансовый", ?(ВыбратьЗначенияДоИзменения, ТекстДоИзменения, ""));
	
	СимволРазделитель = " ";
	
	КФО = "0";
	Счет = "000" + СимволРазделитель + "00";
	КЭК = "000";
	
	Если ЗначениеЗаполнено(СтрокаТаблицы[ИмяПоляКФОНаименование]) Тогда
		КФО = СтрокаТаблицы[ИмяПоляКФОНаименование];
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаТаблицы[ИмяПоляСчетКод]) Тогда
		Счет = СтрЗаменить(СтрокаТаблицы[ИмяПоляСчетКод], ".", СимволРазделитель);
	КонецЕсли;
	
	Если СтрокаТаблицы[ИмяПоляСчетЗабалансовый] Тогда
		// Забалансовые счета печатаем в формате ХХ. Без КФО и КЭК.
		КЭК = "";
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы[ИмяПоляКФОНаименование]) Тогда
			КФО = "";
		КонецЕсли;
	КонецЕсли;
	
	Результат = Новый Структура();
	
	Результат.Вставить("КодСчета",
		?(ЗначениеЗаполнено(КФО), КФО + СимволРазделитель, "")
		+ Счет
		+ ?(ЗначениеЗаполнено(КЭК), СимволРазделитель + КЭК, ""));
		
	Результат.Вставить("Наименование", СтрокаТаблицы[ИмяПоляСчетНаименование]);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьПредставлениеВидКомиссии(СтрокаТаблицы, ПостфиксИмени)
	
	Временная = СтрокаТаблицы["Временная" + ПостфиксИмени];
	
	Возврат ?(Временная, НСтр("ru='временная'"), НСтр("ru='постоянно действующая'"));
	
КонецФункции

Функция ПолучитьПредставлениеСтатусЧленаКомиссии(СтрокаТаблицы, ПостфиксИмени = "") Экспорт
	
	СтатусЧленаКомиссии = СтрокаТаблицы["СтатусЧленаКомиссии" + ПостфиксИмени];
	
	Если Не ЗначениеЗаполнено(СтатусЧленаКомиссии) Тогда
		СтатусЧленаКомиссии = Перечисления.СтатусыЧленовКомиссии.ЧленКомиссии;
	КонецЕсли;
	
	Возврат НРег(СтатусЧленаКомиссии);
	
КонецФункции

Функция ПолучитьПредставлениеНомерРабочейКомиссии(СтрокаТаблицы, ПостфиксИмени)
	
	НомерРабочейКомиссии = СтрокаТаблицы["НомерРабочейКомиссии" + ПостфиксИмени];
	
	Возврат ИнвентаризацияКлиентСервер.ФорматироватьНомерРабочейКомиссии(НомерРабочейКомиссии);
	
КонецФункции

#КонецОбласти

#Область ПроверкаДопустимостиПометкиУдаления

Функция ПолучитьКоличествоПоследующихДокументовЦепочки(РешениеСсылка, ПроверяемыйДокументСсылка, НомерИзмененияПроверяемогоДокумента)
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("Решение",								РешениеСсылка);
	ЗапросПоиск.УстановитьПараметр("ПроверяемыйДокумент",					ПроверяемыйДокументСсылка);
	ЗапросПоиск.УстановитьПараметр("НомерИзмененияПроверяемогоДокумента",	НомерИзмененияПроверяемогоДокумента);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК КоличествоДокументов
	|ИЗ
	|	Документ.ИзменениеРешенияОПроведенииИнвентаризации
	|ГДЕ
	|	Решение = &Решение
	|	И Ссылка <> &ПроверяемыйДокумент
	|	И НомерИзменения > &НомерИзмененияПроверяемогоДокумента
	|	И НЕ ПометкаУдаления";
	
	УстановитьПривилегированныйРежим(Истина);
	Таблица = ЗапросПоиск.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Результат = 0;
	
	Если Таблица.Количество() > 0 Тогда
		Результат = Таблица[0].КоличествоДокументов;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область ЛистыОзнакомленияСогласования

Функция СоставитьОбщуюТаблицуСотрудников(Данные)
	
	ТаблицаСотрудников = ПолучитьПустуюТаблицуСотрудниковДляЛистаОзнакомления();
	
	Для Каждого Элемент Из Данные Цикл
		Таблица = Элемент.Значение;
		
		ДобавитьВТаблицуСотрудников(ТаблицаСотрудников, Таблица);
	КонецЦикла;
	
	Возврат ТаблицаСотрудников;
	
КонецФункции

Процедура ДобавитьВТаблицуСотрудников(ТаблицаПриемник, ТаблицаИсточник)
	
	ЕстьКолонкаМодифицированность = (ТаблицаИсточник.Колонки.Найти("Модифицированность") <> Неопределено);
	
	Поиск = Новый Структура();
	
	Для Каждого СтрокаТаблицыИсточник Из ТаблицаИсточник Цикл
		Сотрудник = СтрокаТаблицыИсточник.Сотрудник;
		
		Если Не ЗначениеЗаполнено(Сотрудник) Тогда
			Продолжить;
		КонецЕсли;
		
		Поиск.Вставить("Сотрудник", Сотрудник);
		
		МассивСтрок = ТаблицаПриемник.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() = 0 Тогда
			НоваяСтрока = ТаблицаПриемник.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицыИсточник);
			
		ИначеЕсли ЕстьКолонкаМодифицированность И СтрокаТаблицыИсточник.Модифицированность Тогда
			СтрокаТаблицыПриемник = МассивСтрок[0];
			СтрокаТаблицыПриемник.Модифицированность = Истина;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура СортироватьПоНаименованиюСотрудника(ТаблицаСотрудников)
	
	МассивСсылок = ТаблицаСотрудников.ВыгрузитьКолонку("Сотрудник");
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивСсылок", МассивСсылок);
	ЗапросПоиск.Текст = "ВЫБРАТЬ
	                    |	ВТ.Ссылка КАК Сотрудник,
	                    |	ВТ.Наименование КАК Наименование
	                    |ИЗ
	                    |	(ВЫБРАТЬ
	                    |		Сотрудники.Ссылка КАК Ссылка,
	                    |		Сотрудники.Наименование КАК Наименование
	                    |	ИЗ
	                    |		Справочник.Сотрудники КАК Сотрудники
	                    |	ГДЕ
	                    |		Сотрудники.Ссылка В(&МассивСсылок)
	                    |	
	                    |	ОБЪЕДИНИТЬ ВСЕ
	                    |	
	                    |	ВЫБРАТЬ
	                    |		Контрагенты.Ссылка,
	                    |		Контрагенты.Наименование
	                    |	ИЗ
	                    |		Справочник.Контрагенты КАК Контрагенты
	                    |	ГДЕ
	                    |		Контрагенты.Ссылка В(&МассивСсылок)) КАК ВТ
	                    |
	                    |УПОРЯДОЧИТЬ ПО
	                    |	Наименование";
	
	ТаблицаНаименований = ЗапросПоиск.Выполнить().Выгрузить();
	ТаблицаНаименований.Индексы.Добавить("Сотрудник");
	
	ТаблицаСотрудников.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка"));
	
	Поиск = Новый Структура();
	
	Для Каждого СтрокаТаблицы Из ТаблицаСотрудников Цикл
		Поиск.Вставить("Сотрудник", СтрокаТаблицы.Сотрудник);
		
		МассивСтрок = ТаблицаНаименований.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТаблицы.Наименование = МассивСтрок[0].Наименование;
	КонецЦикла;
	
	КолонкиСортировки = "Наименование Возр";
	
	Если ТаблицаСотрудников.Колонки.Найти("ДокументСсылка") <> Неопределено Тогда
		КолонкиСортировки = "ДокументСсылка," + КолонкиСортировки;
	КонецЕсли;
	
	ТаблицаСотрудников.Сортировать(КолонкиСортировки);
	
	ТаблицаСотрудников.Колонки.Удалить(ТаблицаСотрудников.Колонки.Найти("Наименование"));
	
КонецПроцедуры

Функция РазбитьНаСотрудниковИКонтрагентов(СписокСсылок)
	
	ТипСотрудники = Тип("СправочникСсылка.Сотрудники");
	ТипКонтрагенты = Тип("СправочникСсылка.Контрагенты");
	
	СписокСотрудников = Новый Массив();
	СписокКонтрагентов = Новый Массив();
	
	Для Каждого Ссылка Из СписокСсылок Цикл
		Если ТипЗнч(Ссылка) = ТипСотрудники Тогда
			СписокСотрудников.Добавить(Ссылка);
			
		ИначеЕсли ТипЗнч(Ссылка) = ТипКонтрагенты Тогда
			СписокКонтрагентов.Добавить(Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	Результат = Новый Структура();
	Результат.Вставить("СписокСотрудников", СписокСотрудников);
	Результат.Вставить("СписокКонтрагентов", СписокКонтрагентов);
	
	Возврат Результат;
	
КонецФункции
	
Процедура ДобавитьСведенияКонтрагентов(ПорцияСведений, СписокКонтрагентов, НаДату)
	
	// Расширяем тип значения колонки Ссылка путем переноса в новую временную колонку
	ИмяВременнойКолонки = "НоваяКолонкаСсылка";
	СодержимоеКолонкиСсылка = ПорцияСведений.ВыгрузитьКолонку("Ссылка");
	ПорцияСведений.Колонки.Добавить(ИмяВременнойКолонки, Новый ОписаниеТипов(Метаданные.ОпределяемыеТипы.СотрудникДляОзнакомления.Тип));
	ПорцияСведений.ЗагрузитьКолонку(СодержимоеКолонкиСсылка, ИмяВременнойКолонки);
	ПорцияСведений.Колонки.Удалить(ПорцияСведений.Колонки.Найти("Ссылка"));
	ПорцияСведений.Колонки.Найти(ИмяВременнойКолонки).Имя = "Ссылка";
	
	ТаблицаФИОКонтрагентов = ПолучитьФИОКонтрагентов(СписокКонтрагентов, НаДату);
	
	Для Каждого СтрокаТаблицы Из ТаблицаФИОКонтрагентов Цикл
		НаименованиеПолное = СтрокаТаблицы.Фамилия + " " + СтрокаТаблицы.Имя + " " + СтрокаТаблицы.Отчество;
		
		Если ПустаяСтрока(НаименованиеПолное) Тогда
			НаименованиеПолное = "";
		КонецЕсли;
		
		НоваяСтрока = ПорцияСведений.Добавить();
		НоваяСтрока.Ссылка				= СтрокаТаблицы.КонтрагентСсылка;
		НоваяСтрока.НаименованиеПолное	= СтрокаТаблицы.КонтрагентНаименованиеПолное;
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы, "Фамилия,Имя,Отчество");
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьФИОКонтрагентов(СписокКонтрагентов, НаДату)
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("СписокКонтрагентов",	СписокКонтрагентов);
	ЗапросПоиск.УстановитьПараметр("НаДату",				НаДату);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ
	|	Контрагенты.Ссылка										КАК КонтрагентСсылка,
	|	Контрагенты.Наименование								КАК КонтрагентНаименованиеПолное,
	|	ЕСТЬNULL(ФИОФизическихЛицСрезПоследних.Фамилия, """")	КАК Фамилия,
	|	ЕСТЬNULL(ФИОФизическихЛицСрезПоследних.Имя, """")		КАК Имя,
	|	ЕСТЬNULL(ФИОФизическихЛицСрезПоследних.Отчество, """")	КАК Отчество
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФизическиеЛица
	|		ПО Контрагенты.ЮридическоеФизическоеЛицо = ФизическиеЛица.Ссылка
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизическихЛиц.СрезПоследних(&НаДату) КАК ФИОФизическихЛицСрезПоследних
	|		ПО ФизическиеЛица.Ссылка = ФИОФизическихЛицСрезПоследних.ФизическоеЛицо
	|ГДЕ
	|	Контрагенты.Ссылка В(&СписокКонтрагентов)";
	
	Возврат ЗапросПоиск.Выполнить().Выгрузить();
	
КонецФункции

#КонецОбласти

Процедура ОчиститьПервыеКолонкиРанееВыведеннойОбласти(ТабДок, Область, КоличествоКолонок = 2)
	
	ВысотаРанееВыведеннойОбласти = Область.ВысотаТаблицы;
	
	ВысотаДокумента = ТабДок.ВысотаТаблицы;
	
	ОчищаемаяОбласть = ТабДок.Область(
		ВысотаДокумента - ВысотаРанееВыведеннойОбласти + 1,
		1,
		ВысотаДокумента,
		КоличествоКолонок);
		
	ОчищаемаяОбласть.Очистить();
	
КонецПроцедуры

Функция ПолучитьАналогичныеДокументы(ДокументОбъект, МетаданныеДокумента, ПроверяемыеРеквизитыШапки, ЗначениеПроведен, ЗначениеПометкаУдаления)
	
	Если ТипЗнч(ПроверяемыеРеквизитыШапки) = Тип("Строка") Тогда
		МассивИмен = СтрРазделить(ПроверяемыеРеквизитыШапки, ", ", Ложь);
	Иначе
		МассивИмен = ПроверяемыеРеквизитыШапки;
	КонецЕсли;
	
	КоличествоРеквизитов = МассивИмен.Количество();
	
	Если КоличествоРеквизитов = 0 Тогда
		ТекстСообщения = НСтр("ru='Функция ПолучитьАналогичныеДокументы, некорректно заполнен параметр ПроверяемыеРеквизитыШапки. Ожидается строка или массив строк с именами реквизитов шапки документа'");
		
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;
	
	ТекстДокумент = "Документ." + МетаданныеДокумента.Имя;
	
	Если ЗначениеПроведен = Неопределено Тогда
		// Отбор не применяем
		ТекстУсловиеПроведен = "ИСТИНА";
	Иначе
		// Применяем отбор
		ТекстУсловиеПроведен = "Проведен = " + Формат(ЗначениеПроведен, "БЛ=ЛОЖЬ; БИ=ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеПометкаУдаления = Неопределено Тогда
		// Отбор не применяем
		ТекстУсловиеПометкаУдаления = "ИСТИНА";
	Иначе
		// Применяем отбор
		ТекстУсловиеПометкаУдаления = "ПометкаУдаления = " + Формат(ЗначениеПометкаУдаления, "БЛ=ЛОЖЬ; БИ=ИСТИНА");
	КонецЕсли;
	
	ЗначенияРеквизитовШапки = Новый Структура(ПроверяемыеРеквизитыШапки);
	ЗаполнитьЗначенияСвойств(ЗначенияРеквизитовШапки, ДокументОбъект);
	
	ЗапросПоиск = Новый Запрос();
	
	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	Ссылка,
	|	Номер,
	|	Дата,
	|	&ПроверяемыеРеквизитыШапки
	|ИЗ
	|	&Документ
	|ГДЕ
	|	&УсловиеПроведен
	|	И &УсловиеПометкаУдаления
	|	И &УсловиеПроверяемыеРеквизитыШапки
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Номер";
	
	ТекстПроверяемыеРеквизитыШапки = "";
	ТекстУсловиеПроверяемыеРеквизитыШапки = "";
	
	Счетчик = 0;
	
	Для Каждого ИмяРеквизита Из МассивИмен Цикл
		Счетчик = Счетчик + 1;
		
		ЭтоПоследнийРеквизит = (Счетчик = КоличествоРеквизитов);
		
		ЗапросПоиск.УстановитьПараметр(ИмяРеквизита, ЗначенияРеквизитовШапки[ИмяРеквизита]);
		
		ТекстПроверяемыеРеквизитыШапки = ТекстПроверяемыеРеквизитыШапки
			+ ?(ТекстПроверяемыеРеквизитыШапки = "", "", "
			|	") + ИмяРеквизита + ?(ЭтоПоследнийРеквизит, "", ",");
		
		ТекстУсловиеПроверяемыеРеквизитыШапки = ТекстУсловиеПроверяемыеРеквизитыШапки
			+ ?(ТекстУсловиеПроверяемыеРеквизитыШапки = "", "", "
			|	И ") + ИмяРеквизита + " = &" + ИмяРеквизита;
	КонецЦикла;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПроверяемыеРеквизитыШапки", ТекстПроверяемыеРеквизитыШапки);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&Документ", ТекстДокумент);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПроведен", ТекстУсловиеПроведен);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПометкаУдаления", ТекстУсловиеПометкаУдаления);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПроверяемыеРеквизитыШапки", ТекстУсловиеПроверяемыеРеквизитыШапки);
	
	ЗапросПоиск.Текст = ТекстЗапроса;
	
	Возврат ЗапросПоиск.Выполнить().Выгрузить();
	
КонецФункции

Процедура ИсключитьУказанныйДокумент(ДокументСсылка, Таблица)
	
	Поиск = Новый Структура("Ссылка", ДокументСсылка);
	
	МассивСтрок = Таблица.НайтиСтроки(Поиск);
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		Таблица.Удалить(СтрокаТаблицы);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьРезультатПроверки(РезультатПроверки, Таблица, МетаданныеДокумента)
	
	МассивНомеров = Новый Массив();
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		НомерДокумента = РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоИмениДокумента(МетаданныеДокумента.Имя, СтрокаТаблицы.Номер);
		
		МассивНомеров.Добавить(СтрШаблон(НСтр("ru='%1 от %2'"), НомерДокумента, СтрокаТаблицы.Дата));
	КонецЦикла;
	
	Если МассивНомеров.Количество() = 0 Тогда
		ПредставлениеСпискаДокументов = "";
		
		ТекстСообщения = "";
	Иначе
		ПредставлениеСпискаДокументов = ОбщегоНазначенияБГУКлиентСервер.ВывестиНомераСтрокВТекстСообщения("%1", МассивНомеров, 100, "%1");
		
		Если МассивНомеров.Количество() = 1 Тогда
			ШаблонСообщения = НСтр("ru='Обнаружен аналогичный документ %1: %2'");
		Иначе
			ШаблонСообщения = НСтр("ru='Обнаружены аналогичные документы %1: %2'");
		КонецЕсли;
		
		ТекстСообщения = СтрШаблон(ШаблонСообщения, МетаданныеДокумента.Синоним, ПредставлениеСпискаДокументов);
	КонецЕсли;
	
	РезультатПроверки.Существуют					= (МассивНомеров.Количество() > 0);
	РезультатПроверки.СписокДокументов				= Таблица;
	РезультатПроверки.ПредставлениеСпискаДокументов	= ПредставлениеСпискаДокументов;
	РезультатПроверки.ТекстСообщения				= ТекстСообщения;
	
КонецПроцедуры

#Область ПечатьТаблицыСРазбивкойНаСтраницы

Функция ПолучитьНастройкиВыводаТаблицыПоУмолчанию()
	
	НастройкиВывода = Новый Структура();
	
	НастройкиВывода.Вставить("ПовторятьШапку",				Истина); // повторять на каждой странице
	НастройкиВывода.Вставить("ВыводитьИтогиПоСтранице",		Истина);
	НастройкиВывода.Вставить("ВыводитьИтогиПоТаблице",		Истина);
	НастройкиВывода.Вставить("ДозаполнитьПустымиСтроками",	Ложь); // последнюю страницу
	
	Возврат НастройкиВывода;
	
КонецФункции

Процедура ПроверитьПараметрыВыводаТаблицы(Параметры)
	
	//
	// Наличие табличного документа
	//
	
	Если Параметры.ТабличныйДокумент = Неопределено Тогда
		
		ВызватьИсключение НСтр("ru = 'Не задан ТабличныйДокумент в ВывестиТаблицуСРазбивкойНаСтраницы'");
		
	КонецЕсли;
	
	//
	// Наличие выборок
	//
	
	Если НЕ ЗначениеЗаполнено(Параметры.Выборки.ДетальныеЗаписи) Тогда
		
		ВызватьИсключение НСтр("ru = 'Не задана выборка ДетальныеЗаписи в ВывестиТаблицуСРазбивкойНаСтраницы'");
		
	КонецЕсли;
	
	Если Параметры.НастройкиВывода.ВыводитьИтогиПоТаблице И НЕ ЗначениеЗаполнено(Параметры.Выборки.ИтогиТаблицы) Тогда
		
		ВызватьИсключение НСтр("ru = 'Не задана выборка ИтогиТаблицы при установленной настройке ВыводитьИтогиПоТаблице в ВывестиТаблицуСРазбивкойНаСтраницы'");
		
	КонецЕсли;
	
	//
	// Наличие областей макета
	//
	
	Если Параметры.Области.ШапкаТаблицы = Неопределено Тогда
		
		ВызватьИсключение НСтр("ru = 'Не задана область макета ШапкаТаблицы в ВывестиТаблицуСРазбивкойНаСтраницы'");
		
	КонецЕсли;
	
	Если Параметры.Области.СтрокаТаблицы = Неопределено Тогда
		
		ВызватьИсключение НСтр("ru = 'Не задана область макета СтрокаТаблицы в ВывестиТаблицуСРазбивкойНаСтраницы'");
		
	КонецЕсли;
	
	Если Параметры.НастройкиВывода.ВыводитьИтогиПоСтранице
		И Параметры.Области.ИтогиПоСтраницеЧислами = Неопределено
		И Параметры.Области.ИтогиПоСтраницеПрописью = Неопределено Тогда
		
		ВызватьИсключение НСтр("ru = 'Не заданы области макета ИтогиПоСтраницеЧислами и ИтогиПоСтраницеПрописью при установленной настройке ВыводитьИтогиПоСтранице в ВывестиТаблицуСРазбивкойНаСтраницы'");
		
	КонецЕсли;
	
	Если Параметры.НастройкиВывода.ВыводитьИтогиПоТаблице
		И Параметры.Области.ИтогиПоТаблицеЧислами = Неопределено
		И Параметры.Области.ИтогиПоТаблицеПрописью = Неопределено Тогда
		
		ВызватьИсключение НСтр("ru = 'Не заданы области макета ИтогиПоТаблицеЧислами и ИтогиПоТаблицеПрописью при установленной настройке ВыводитьИтогиПоТаблице в ВывестиТаблицуСРазбивкойНаСтраницы'");
		
	КонецЕсли;
	
	Если Параметры.НастройкиВывода.ДозаполнитьПустымиСтроками
		И Параметры.Области.ПустаяСтрока = Неопределено Тогда
		
		ВызватьИсключение НСтр("ru = 'Не задана область макета ПустаяСтрока при установленной настройке ДозаполнитьПустымиСтроками в ВывестиТаблицуСРазбивкойНаСтраницы'");
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьНастройкиПроверкиВывода(Параметры)
	
	ПроверятьВыводИтогиПоСтраницеЧислами = (Параметры.НастройкиВывода.ВыводитьИтогиПоСтранице И Параметры.Области.ИтогиПоСтраницеЧислами <> Неопределено);
	
	ПроверятьВыводИтогиПоСтраницеПрописью = (Параметры.НастройкиВывода.ВыводитьИтогиПоСтранице И Параметры.Области.ИтогиПоСтраницеПрописью <> Неопределено);
	
	ПроверятьВыводИтогиПоТаблицеЧислами = (Параметры.НастройкиВывода.ВыводитьИтогиПоТаблице И Параметры.Области.ИтогиПоТаблицеЧислами <> Неопределено);
	
	ПроверятьВыводИтогиПоТаблицеПрописью = (Параметры.НастройкиВывода.ВыводитьИтогиПоТаблице И Параметры.Области.ИтогиПоТаблицеПрописью <> Неопределено);
	
	ВыводитьЗаголовок = (Параметры.Области.Заголовок <> Неопределено);
	
	// В таблице ноль строк
	//
	// В проверку включаются области:
	//	- заголовок						опционально
	//	- шапка таблицы					обязательно
	//	- итого по таблице числами		опционально
	//	- итого по таблице прописью		опционально
	
	НольСтрокТаблицы = Новый Структура();
	НольСтрокТаблицы.Вставить("МассивОбластей",				Новый Массив());
	НольСтрокТаблицы.Вставить("ИндексыЗаполняемыхОбластей",	Новый Структура());
	
	Если ВыводитьЗаголовок Тогда
		ДобавитьОбластьВНабор(НольСтрокТаблицы, Параметры, "Заголовок");
	КонецЕсли;
	
	ДобавитьОбластьВНабор(НольСтрокТаблицы, Параметры, "ШапкаТаблицы");
	
	Если ПроверятьВыводИтогиПоТаблицеЧислами Тогда
		ДобавитьОбластьВНабор(НольСтрокТаблицы, Параметры, "ИтогиПоТаблицеЧислами", Истина);
	КонецЕсли;
	
	Если ПроверятьВыводИтогиПоТаблицеПрописью Тогда
		ДобавитьОбластьВНабор(НольСтрокТаблицы, Параметры, "ИтогиПоТаблицеПрописью", Истина);
	КонецЕсли;
	
	// В таблице одна строка
	//
	// В проверку включаются области:
	//	- заголовок						опционально
	//	- шапка таблицы					обязательно
	//	- строка таблицы				обязательно
	//	- итого по таблице числами		опционально
	//	- итого по таблице прописью		опционально
	
	ОднаСтрокаТаблицы = Новый Структура();
	ОднаСтрокаТаблицы.Вставить("МассивОбластей",				Новый Массив());
	ОднаСтрокаТаблицы.Вставить("ИндексыЗаполняемыхОбластей",	Новый Структура());
	
	Если ВыводитьЗаголовок Тогда
		ДобавитьОбластьВНабор(ОднаСтрокаТаблицы, Параметры, "Заголовок");
	КонецЕсли;
	
	ДобавитьОбластьВНабор(ОднаСтрокаТаблицы, Параметры, "ШапкаТаблицы");
	
	ДобавитьОбластьВНабор(ОднаСтрокаТаблицы, Параметры, "СтрокаТаблицы");
	
	Если ПроверятьВыводИтогиПоТаблицеЧислами Тогда
		ДобавитьОбластьВНабор(ОднаСтрокаТаблицы, Параметры, "ИтогиПоТаблицеЧислами", Истина);
	КонецЕсли;
	
	Если ПроверятьВыводИтогиПоТаблицеПрописью Тогда
		ДобавитьОбластьВНабор(ОднаСтрокаТаблицы, Параметры, "ИтогиПоТаблицеПрописью", Истина);
	КонецЕсли;
	
	
	////НесколькоСтрокТаблицыОчереднаяСтрока
	////НесколькоСтрокТаблицыПоследняяСтрока
	
	// В таблице две и более строк
	//
	// Первая строка
	//
	// В проверку включаются области:
	//	- заголовок						опционально
	//	- шапка таблицы					обязательно
	//	- строка таблицы				обязательно
	//	- итого по странице числами		опционально
	//	- итого по странице прописью	опционально
	
	НесколькоСтрокТаблицыПерваяСтрока = Новый Структура();
	НесколькоСтрокТаблицыПерваяСтрока.Вставить("МассивОбластей",				Новый Массив());
	НесколькоСтрокТаблицыПерваяСтрока.Вставить("ИндексыЗаполняемыхОбластей",	Новый Структура());
	
	Если ВыводитьЗаголовок Тогда
		ДобавитьОбластьВНабор(НесколькоСтрокТаблицыПерваяСтрока, Параметры, "Заголовок");
	КонецЕсли;
	
	ДобавитьОбластьВНабор(НесколькоСтрокТаблицыПерваяСтрока, Параметры, "ШапкаТаблицы");
	
	ДобавитьОбластьВНабор(НесколькоСтрокТаблицыПерваяСтрока, Параметры, "СтрокаТаблицы");
	
	Если ПроверятьВыводИтогиПоСтраницеЧислами Тогда
		ДобавитьОбластьВНабор(НесколькоСтрокТаблицыПерваяСтрока, Параметры, "ИтогиПоСтраницеЧислами", Истина);
	КонецЕсли;
	
	Если ПроверятьВыводИтогиПоСтраницеПрописью Тогда
		ДобавитьОбластьВНабор(НесколькоСтрокТаблицыПерваяСтрока, Параметры, "ИтогиПоСтраницеПрописью", Истина);
	КонецЕсли;

	// В таблице две и более строк
	//
	// Очередная строка (промежуточная)
	//
	// В проверку включаются области:
	//	- строка таблицы				обязательно
	//	- итого по странице числами		опционально
	//	- итого по странице прописью	опционально
	
	НесколькоСтрокТаблицыОчереднаяСтрока = Новый Структура();
	НесколькоСтрокТаблицыОчереднаяСтрока.Вставить("МассивОбластей",				Новый Массив());
	НесколькоСтрокТаблицыОчереднаяСтрока.Вставить("ИндексыЗаполняемыхОбластей",	Новый Структура());
	
	ДобавитьОбластьВНабор(НесколькоСтрокТаблицыОчереднаяСтрока, Параметры, "СтрокаТаблицы");
	
	Если ПроверятьВыводИтогиПоСтраницеЧислами Тогда
		ДобавитьОбластьВНабор(НесколькоСтрокТаблицыОчереднаяСтрока, Параметры, "ИтогиПоСтраницеЧислами", Истина);
	КонецЕсли;
	
	Если ПроверятьВыводИтогиПоСтраницеПрописью Тогда
		ДобавитьОбластьВНабор(НесколькоСтрокТаблицыОчереднаяСтрока, Параметры, "ИтогиПоСтраницеПрописью", Истина);
	КонецЕсли;
	
	// В таблице две и более строк
	//
	// Последняя строка
	//
	// В проверку включаются области:
	//	- строка таблицы				обязательно
	//	- итого по странице числами		опционально
	//	- итого по странице прописью	опционально
	//	- итого по таблице числами		опционально
	//	- итого по таблице прописью		опционально
	
	НесколькоСтрокТаблицыПоследняяСтрока = Новый Структура();
	НесколькоСтрокТаблицыПоследняяСтрока.Вставить("МассивОбластей",				Новый Массив());
	НесколькоСтрокТаблицыПоследняяСтрока.Вставить("ИндексыЗаполняемыхОбластей",	Новый Структура());
	
	ДобавитьОбластьВНабор(НесколькоСтрокТаблицыПоследняяСтрока, Параметры, "СтрокаТаблицы");
	
	Если ПроверятьВыводИтогиПоСтраницеЧислами Тогда
		ДобавитьОбластьВНабор(НесколькоСтрокТаблицыПоследняяСтрока, Параметры, "ИтогиПоСтраницеЧислами", Истина);
	КонецЕсли;
	
	Если ПроверятьВыводИтогиПоСтраницеПрописью Тогда
		ДобавитьОбластьВНабор(НесколькоСтрокТаблицыПоследняяСтрока, Параметры, "ИтогиПоСтраницеПрописью", Истина);
	КонецЕсли;
	
	Если ПроверятьВыводИтогиПоТаблицеЧислами Тогда
		ДобавитьОбластьВНабор(НесколькоСтрокТаблицыПоследняяСтрока, Параметры, "ИтогиПоТаблицеЧислами", Истина);
	КонецЕсли;
	
	Если ПроверятьВыводИтогиПоТаблицеПрописью Тогда
		ДобавитьОбластьВНабор(НесколькоСтрокТаблицыПоследняяСтрока, Параметры, "ИтогиПоТаблицеПрописью", Истина);
	КонецЕсли;
	
	ПроверкаВывода = Новый Структура();
	ПроверкаВывода.Вставить("НольСтрокТаблицы",						НольСтрокТаблицы);
	ПроверкаВывода.Вставить("ОднаСтрокаТаблицы",					ОднаСтрокаТаблицы);
	ПроверкаВывода.Вставить("НесколькоСтрокТаблицыПерваяСтрока",	НесколькоСтрокТаблицыПерваяСтрока);
	ПроверкаВывода.Вставить("НесколькоСтрокТаблицыОчереднаяСтрока",	НесколькоСтрокТаблицыОчереднаяСтрока);
	ПроверкаВывода.Вставить("НесколькоСтрокТаблицыПоследняяСтрока",	НесколькоСтрокТаблицыПоследняяСтрока);
	
	Возврат ПроверкаВывода;
	
КонецФункции

Процедура ДобавитьОбластьВНабор(НаборОбластей, Параметры, ИмяОбласти, ОбластьЗаполняемая = Ложь)
	
	НаборОбластей.МассивОбластей.Добавить(Параметры.Области[ИмяОбласти]);
	
	Если ОбластьЗаполняемая Тогда
		
		Индекс = НаборОбластей.МассивОбластей.Количество() - 1;
		
		НаборОбластей.ИндексыЗаполняемыхОбластей.Вставить(ИмяОбласти, Индекс);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ИнициализироватьИтоги(Параметры)
	
	ИменаПолей = Новый Массив();
	
	Итоги = Новый Структура();
	
	ТипЧисло = Тип("Число");
	
	ВыборкаИтогов = Параметры.Выборки.ИтогиТаблицы;
	
	ИтогиРассчитаны = (ВыборкаИтогов.ТипЗаписи() = ТипЗаписиЗапроса.ИтогПоГруппировке);
	
	Для Каждого Колонка Из ВыборкаИтогов.Владелец().Колонки Цикл
		ИмяПоля = Колонка.Имя;
		
		Если ИтогиРассчитаны И ТипЗнч(ВыборкаИтогов[ИмяПоля]) <> ТипЧисло Тогда
			Продолжить;
			
		ИначеЕсли Не ИтогиРассчитаны И Не Колонка.ТипЗначения.СодержитТип(ТипЧисло) Тогда
			Продолжить;
		КонецЕсли;
		
		ИменаПолей.Добавить(ИмяПоля);
		
		Итоги.Вставить(ИмяПоля, 0);
	КонецЦикла;
	
	Параметры.Служебные.Вставить("ПустыеИтоги", Новый Структура());
	
	Параметры.Служебные.ПустыеИтоги.Вставить("Структура", Новый ФиксированнаяСтруктура(Итоги));
	Параметры.Служебные.ПустыеИтоги.Вставить("ИменаПолей", Новый ФиксированныйМассив(ИменаПолей));
	
	Параметры.Итоги.ПоСтранице = Новый Структура(Параметры.Служебные.ПустыеИтоги.Структура);
	
	Параметры.Итоги.ПоТаблице = Новый Структура(Параметры.Служебные.ПустыеИтоги.Структура);
	
	ЗаполнитьЗначенияСвойств(Параметры.Итоги.ПоТаблице, Параметры.Выборки.ИтогиТаблицы);
	
КонецПроцедуры

Процедура УвеличитьИтогиПоСтранице(Параметры)
	
	Для Каждого ИмяПоля Из Параметры.Служебные.ПустыеИтоги.ИменаПолей Цикл
		Параметры.Итоги.ПоСтранице[ИмяПоля] = Параметры.Итоги.ПоСтранице[ИмяПоля] + Параметры.Выборки.ДетальныеЗаписи[ИмяПоля];
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьПустыеИтоги()
	
	Возврат Новый Структура("
		|ПоСтранице,
		|ПоТаблице");
	
КонецФункции

Функция ПолучитьПустуюСтатистикуВывода()
	
	СтатистикаВывода = Новый Структура();
	СтатистикаВывода.Вставить("НомерСтроки",					0);
	СтатистикаВывода.Вставить("КоличествоСтрок",				0);
	СтатистикаВывода.Вставить("ВыведеноСтрокВсего",				0);
	СтатистикаВывода.Вставить("ВыведеноСтрокНаТекущейСтранице",	0);
	СтатистикаВывода.Вставить("ВыведеноСтраниц",				0);
	СтатистикаВывода.Вставить("ПрименяетсяОдностраничныйДокумент", Ложь);
	
	Возврат СтатистикаВывода;
	
КонецФункции

Функция ПолучитьПустуюСлужебнуюСтруктуру()
	
	Возврат Новый Структура();
	
КонецФункции

Процедура ВывестиНачалоТаблицы(ТабДокумент, Параметры);
	
	// ЗАГОЛОВОК
	
	ВывестиЗаголовок = (Параметры.Области.Заголовок <> Неопределено);
	
	Если ВывестиЗаголовок Тогда
		ТабДокумент.Вывести(Параметры.Области.Заголовок);
	КонецЕсли;
	
	// ШАПКА ТАБЛИЦЫ
	
	ТабДокумент.Вывести(Параметры.Области.ШапкаТаблицы);
	
КонецПроцедуры

Процедура ЗавершитьТекущуюСтраницу(ТабДокумент, Параметры, ВывестиИтогиПоСтраницеЧислами, ВывестиИтогиПоСтраницеПрописью)

	Если Параметры.СтатистикаВывода.ВыведеноСтрокНаТекущейСтранице > 0 Тогда
		
		// ИТОГИ ПО СТРАНИЦЕ
		
		Если ВывестиИтогиПоСтраницеЧислами Тогда
			
			ТабДокумент.Вывести(Параметры.Области.ИтогиПоСтраницеЧислами);
			
		КонецЕсли;
		
		Если ВывестиИтогиПоСтраницеПрописью Тогда
			
			ТабДокумент.Вывести(Параметры.Области.ИтогиПоСтраницеПрописью);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Параметры.СтатистикаВывода.ПрименяетсяОдностраничныйДокумент Тогда
		
		Параметры.ТабличныйДокумент.Вывести(ТабДокумент);
		
	КонецЕсли;
	
	Параметры.ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	
	Параметры.СтатистикаВывода.ВыведеноСтраниц = Параметры.СтатистикаВывода.ВыведеноСтраниц + 1;
	
КонецПроцедуры

Процедура НачатьНовуюСтраницу(ТабДокумент, Параметры, ВывестиИтогиПоСтраницеЧислами)

	ТабДокумент = Параметры.Служебные.ОдностраничныйДокумент;
	
	ТабДокумент.Очистить();
	
	Параметры.СтатистикаВывода.ПрименяетсяОдностраничныйДокумент = Истина;
	
	Параметры.СтатистикаВывода.ВыведеноСтрокНаТекущейСтранице = 0;
	
	Если ВывестиИтогиПоСтраницеЧислами Тогда
		Параметры.Итоги.ПоСтранице = Новый Структура(Параметры.Служебные.ПустыеИтоги.Структура);
	КонецЕсли;
	
КонецПроцедуры

Функция ВыбратьПроверкуВывода(ПроверкаВывода, Параметры)
	
	Если Параметры.СтатистикаВывода.КоличествоСтрок > 2 Тогда
		
		Если Параметры.СтатистикаВывода.НомерСтроки = 1 Тогда
			Возврат ПроверкаВывода.НесколькоСтрокТаблицыПерваяСтрока;
		ИначеЕсли Параметры.СтатистикаВывода.НомерСтроки < Параметры.СтатистикаВывода.КоличествоСтрок Тогда
			Возврат ПроверкаВывода.НесколькоСтрокТаблицыОчереднаяСтрока;
		Иначе
			Возврат ПроверкаВывода.НесколькоСтрокТаблицыПоследняяСтрока;
		КонецЕсли;
		
	ИначеЕсли Параметры.СтатистикаВывода.КоличествоСтрок = 2 Тогда
		
		Если Параметры.СтатистикаВывода.НомерСтроки = 1 Тогда
			Возврат ПроверкаВывода.НесколькоСтрокТаблицыПерваяСтрока;
		Иначе
			Возврат ПроверкаВывода.НесколькоСтрокТаблицыПоследняяСтрока;
		КонецЕсли;
		
	ИначеЕсли Параметры.СтатистикаВывода.КоличествоСтрок = 1 Тогда
		
		Возврат ПроверкаВывода.ОднаСтрокаТаблицы;
		
	ИначеЕсли Параметры.СтатистикаВывода.КоличествоСтрок = 0 Тогда
		
		Возврат ПроверкаВывода.НольСтрокТаблицы;
		
	КонецЕсли;
	
КонецФункции

Процедура ОбновитьЗаполняемыеОбластиПроверкиВывода(Параметры, ПроверкаВывода)
	
	Для Каждого Элемент Из ПроверкаВывода.ИндексыЗаполняемыхОбластей Цикл
		
		ОбозначениеОбласти = Элемент.Ключ;
		
		Индекс = Элемент.Значение;
		
		ПроверкаВывода.МассивОбластей[Индекс] = Параметры.Области[ОбозначениеОбласти];
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ВыводСКонтролемРазбивкиНаСтраницы

Функция РазбитьТабДокНаБлокиСтрокПоВысоте(ТабДок, ВысотаПервогоБлокаСтрокИсточника, ВысотаВторогоИПоследующихБлоковСтрокИсточника)
	
	Перем НомерПоследнейСтроки;
	
	Высота1 = ВысотаПервогоБлокаСтрокИсточника;
	
	Высота2 = ВысотаВторогоИПоследующихБлоковСтрокИсточника;
	
	УказанаВысота2 = (ТипЗнч(Высота2) = Тип("Число") И Высота2 > 1);
	
	МассивБлоков = Новый Массив();
	
	ТекущийБлок = 0;
	
	Пока Истина Цикл
		
		ТекущийБлок = ТекущийБлок + 1;
		
		Если ТекущийБлок = 1 Тогда
			// Первый блок заданной высоты
			
			ВысотаБлока = Высота1;
			
			НомерПервойСтроки = 1;
			
		ИначеЕсли УказанаВысота2 Тогда
			// Очередной блок заданной высоты
			
			ВысотаБлока = Высота2;
			
			НомерПервойСтроки = НомерПоследнейСтроки + 1;
			
		Иначе
			// Один большой блок произвольной высоты до конца документа
			
			ВысотаБлока = (ТабДок.ВысотаТаблицы - НомерПоследнейСтроки);
			
			НомерПервойСтроки = НомерПоследнейСтроки + 1;
			
		КонецЕсли;
		
		Если НомерПервойСтроки > ТабДок.ВысотаТаблицы Тогда
			Прервать;
		КонецЕсли;
		
		НомерПоследнейСтроки = НомерПервойСтроки + ВысотаБлока - 1;
		
		Если НомерПоследнейСтроки > ТабДок.ВысотаТаблицы Тогда
			НомерПоследнейСтроки = ТабДок.ВысотаТаблицы;
		КонецЕсли;
		
		ОписаниеБлокаСтрок = Новый Структура();
		ОписаниеБлокаСтрок.Вставить("НомерПервойСтроки",	НомерПервойСтроки);
		ОписаниеБлокаСтрок.Вставить("НомерПоследнейСтроки",	НомерПоследнейСтроки);
		
		МассивБлоков.Добавить(ОписаниеБлокаСтрок);
		
	КонецЦикла;
	
	Возврат МассивБлоков;
	
КонецФункции

Процедура ПроверитьВысотыБлоковСтрок(ВысотаПервогоБлокаСтрокИсточника, ВысотаВторогоИПоследующихБлоковСтрокИсточника)
	
	// Корректными считаются такие значения параметров:
	//	- обязательный параметр "ВысотаПервогоБлокаСтрокИсточника", значение Число > 1
	//	- опциональный параметр "ВысотаВторогоИПоследующихБлоковСтрокИсточника", значение Число > 1
	
	Высота1 = ВысотаПервогоБлокаСтрокИсточника;
	
	Высота2 = ВысотаВторогоИПоследующихБлоковСтрокИсточника;
	
	ТекстШаблон = НСтр("ru='%1 (вызов процедуры ""ВывестиСКонтролемРазбивкиНаСтраницы"")'");
	
	УказанаВысота1 = (ТипЗнч(Высота1) = Тип("Число") И Высота1 > 1);
	
	УказанаВысота2 = (ТипЗнч(Высота2) = Тип("Число") И Высота2 > 1);
	
	Если Высота1 = Неопределено Тогда
		
		ВызватьИсключение СтрШаблон(ТекстШаблон, НСтр("ru='Отсутствует обязательный параметр ""ВысотаПервогоБлокаСтрокИсточника"". Ожидается значение Число > 1.'"));
		
	КонецЕсли;
	
	Если НЕ УказанаВысота1  Тогда
		
		ВызватьИсключение СтрШаблон(ТекстШаблон, НСтр("ru='В параметре ""ВысотаПервогоБлокаСтрокИсточника"" передано недопустимое значение. Ожидается значение Число > 1.'"));
		
	КонецЕсли;
	
	Если Высота2 <> Неопределено И НЕ УказанаВысота2 Тогда
		
		ВызватьИсключение СтрШаблон(ТекстШаблон, НСтр("ru='В параметре ""ВысотаВторогоИПоследующихБлоковСтрокИсточника"" передано недопустимое значение. Ожидается значение Число > 1.'"));
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область РазбиениеТекстаНаБлокиСтрок

Процедура ПроверитьКорректностьОписанийБлоковСтрок(БлокиСтрок)
	
	МаксимальноеКоличествоСтрокГлобальная = 1000;
	
	МинимальнаяДлинаСтрокиГлобальная = 5;
	МаксимальнаяДлинаСтрокиГлобальная = 1000;
	
	ТекстЗаголовкаСообщений = НСтр("ru='Ошибка при разбиении текста на блоки строк.
		|'");
	
	КоличествоБлоков = БлокиСтрок.Количество();
	
	Если КоличествоБлоков = 0 Тогда
		
		ТекстСообщения = ТекстЗаголовкаСообщений + НСтр("ru='Не заданы описания блоков строк.'");
		
		ВызватьИсключение ТекстСообщения;
		
	КонецЕсли;
	
	Для НомерБлока = 1 По КоличествоБлоков Цикл
		
		Описание = БлокиСтрок[НомерБлока - 1];
		
		МаксимальноеКоличествоСтрок	= Описание["МаксимальноеКоличествоСтрок"];
		МаксимальнаяДлинаСтроки		= Описание["МаксимальнаяДлинаСтроки"];
		
		Если ЗначениеЗаполнено(МаксимальнаяДлинаСтроки) Тогда
			
			Если МаксимальнаяДлинаСтроки < МинимальнаяДлинаСтрокиГлобальная ИЛИ МаксимальнаяДлинаСтроки > МаксимальнаяДлинаСтрокиГлобальная Тогда
			
				ТекстШаблон = НСтр("ru='Некорректное описание блока строк (номер блока %1 по порядку).
					|
					|Указано недопустимое значение %2 параметра ""МаксимальнаяДлинаСтроки"".
					|Это количество символов текста, выводимое в очередной строке блока строк.
					|Обязательный параметр.
					|Ожидается целое число от %3 до %4.'");
				
				ТекстСообщения = ТекстЗаголовкаСообщений
					+ СтрШаблон(ТекстШаблон, НомерБлока, МаксимальнаяДлинаСтроки, МинимальнаяДлинаСтрокиГлобальная, МаксимальнаяДлинаСтрокиГлобальная);
				
				ВызватьИсключение ТекстСообщения;
				
			КонецЕсли;
			
		Иначе
			
			ТекстШаблон = НСтр("ru='Некорректное описание блока строк (номер блока %1 по порядку).
				|
				|Не заполнен параметр ""МаксимальнаяДлинаСтроки"".
				|Это количество символов текста, выводимое в очередной строке блока строк.
				|Обязательный параметр.
				|Ожидается целое число от %2 до %3.'");
			
			ТекстСообщения = ТекстЗаголовкаСообщений
				+ СтрШаблон(ТекстШаблон, НомерБлока, МинимальнаяДлинаСтрокиГлобальная, МаксимальнаяДлинаСтрокиГлобальная);
			
			ВызватьИсключение ТекстСообщения;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(МаксимальноеКоличествоСтрок) Тогда
			
			Если МаксимальноеКоличествоСтрок < 1 ИЛИ МаксимальноеКоличествоСтрок > МаксимальноеКоличествоСтрокГлобальная Тогда
				
				ТекстШаблон = НСтр("ru='Некорректное описание блока строк (номер блока %1 по порядку).
					|
					|Указано недопустимое значение параметра %2 ""МаксимальноеКоличествоСтрок"".
					|Это количество строк текста, выводимое в соответствуюшем блоке строк.
					|Опциональный параметр.
					|Если задано значение, то это должно быть целое число от 1 до %3.
					|Если значение не задано, то блок считается условно бесконечным (максимум %3 строк)'");
				
				ТекстСообщения = ТекстЗаголовкаСообщений
					+ СтрШаблон(ТекстШаблон, НомерБлока, МаксимальноеКоличествоСтрок, МаксимальнаяДлинаСтрокиГлобальная);
				
				ВызватьИсключение ТекстСообщения;
				
			КонецЕсли;
			
		Иначе
			
			Если НомерБлока < КоличествоБлоков Тогда
				
				ТекстШаблон = НСтр("ru='Некорректное описание блока строк (номер блока %1 по порядку).
					|
					|Указано недопустимое значение (%2) параметра ""МаксимальноеКоличествоСтрок"".
					|Такое значение допустимо указывать только для последнего по порядку блока,
					|а блок %1 не является последним.'");
				
				ТекстСообщения = ТекстЗаголовкаСообщений + СтрШаблон(ТекстШаблон, НомерБлока, МаксимальноеКоличествоСтрокГлобальная);
				
				ВызватьИсключение ТекстСообщения;
				
			КонецЕсли;
			
			Описание["МаксимальноеКоличествоСтрок"] = МаксимальноеКоличествоСтрокГлобальная;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьКорректностьПараметровОбработки(ПараметрыОбработки)
	
	Если ТипЗнч(ПараметрыОбработки) <> Тип("Структура") Тогда
		ПараметрыОбработки = Новый Структура();
	КонецЕсли;
	
	ИмяПараметра		= "МинимизироватьРазрывыСтрок";
	ЗначениеПоУмолчанию	= Истина;
	
	Если НЕ ПараметрыОбработки.Свойство(ИмяПараметра) Тогда
		ПараметрыОбработки.Вставить(ИмяПараметра, ЗначениеПоУмолчанию);
	КонецЕсли;
	
	ИмяПараметра		= "ВоспроизводитьПереводыСтроки";
	ЗначениеПоУмолчанию	= Истина;
	
	Если НЕ ПараметрыОбработки.Свойство(ИмяПараметра) Тогда
		ПараметрыОбработки.Вставить(ИмяПараметра, ЗначениеПоУмолчанию);
	КонецЕсли;
	
КонецПроцедуры

Процедура РазбитьСтрокуНаБлокиСтрок(Текст, БлокиСтрок, СтатистикаБлока, ПараметрыОбработки)
	
	МассивСлов = СтрРазделить(Текст, " 	");
	
	Если ПараметрыОбработки.Свойство("ОставшиесяСлова") ИЛИ НельзяДобавитьСледующуюСтроку(СтатистикаБлока) Тогда
		ДобавитьОставшиесяСлова(0, МассивСлов, МассивСлов[0], ПараметрыОбработки);
		
		Возврат;
	КонецЕсли;
	
	РазделительСлов = ПараметрыОбработки.РазделительСлов;
	
	ТекущаяСтрока = "";
	
	ЭтоПервоеСловоВСтроке = Истина;
	
	ОбщееКоличествоСлов = МассивСлов.Количество();
	
	Для ИндексСлова = 0 По ОбщееКоличествоСлов - 1 Цикл
		
		Слово = МассивСлов[ИндексСлова];
		
		Пока Истина Цикл // Продолжаем вывод слова
			
			ПрефиксСлова = ?(ЭтоПервоеСловоВСтроке, "", РазделительСлов);
			
			СвободноСимволов = СтатистикаБлока.ТекущийБлок.МаксимальнаяДлинаСтроки - СтрДлина(ТекущаяСтрока);
			
			СловоПомещается = (СтрДлина(ПрефиксСлова) + СтрДлина(Слово) <= СвободноСимволов);
			
			Если СловоПомещается Тогда
				ТекущаяСтрока = ТекущаяСтрока + ПрефиксСлова + Слово;
				
				ЭтоПервоеСловоВСтроке = Ложь;
				
				Прервать;
			КонецЕсли;
			
			// Здесь либо перенос слова, либо разрыв слова.
			// Необходимо добавить новую строку.
			
			ЭтоПоследняяСтрокаБлока = ((СтатистикаБлока.КоличествоСтрок + 1) = СтатистикаБлока.ТекущийБлок.МаксимальноеКоличествоСтрок);
			
			ЕстьСледующийБлок = (СтатистикаБлока.СледующийБлок <> Неопределено);
			
			Если ЭтоПоследняяСтрокаБлока Тогда
				БлокКандидатДляСледующейСтроки = ?(ЕстьСледующийБлок, СтатистикаБлока.СледующийБлок, Неопределено);
				
				ПродолжаемВыводВТекущийБлок = Ложь;
			Иначе
				БлокКандидатДляСледующейСтроки = СтатистикаБлока.ТекущийБлок;
				
				ПродолжаемВыводВТекущийБлок = Истина;
			КонецЕсли;
			
			Если БлокКандидатДляСледующейСтроки = Неопределено Тогда
				
				// Закончились свободные строки в блоках строк
				
				ЗавершитьСборТекущейСтроки(ТекущаяСтрока, СтатистикаБлока);
				
				ДобавитьОставшиесяСлова(ИндексСлова, МассивСлов, Слово, ПараметрыОбработки);
				
				Возврат;
				
			КонецЕсли;
			
			МаксимальнаяДлинаСледующейСтроки = БлокКандидатДляСледующейСтроки.МаксимальнаяДлинаСтроки;
			
			СловоПомещаетсяЦеликомВСледующейСтроке = (СтрДлина(Слово) <= МаксимальнаяДлинаСледующейСтроки);
			
			Если ЗначениеЗаполнено(ТекущаяСтрока)
				И СловоПомещаетсяЦеликомВСледующейСтроке
				И ПараметрыОбработки.МинимизироватьРазрывыСтрок Тогда
				
				// Однозначно переносим слово
				
				НеобходимоРазорватьСлово = Ложь;
			Иначе
				// Пробуем разорвать слово.
				// Если не получается, то переносим слово.
				
				РазрывСлова = РазорватьСлово(
					Слово,
					СвободноСимволов - СтрДлина(ПрефиксСлова),
					СтатистикаБлока);
				
				НеобходимоРазорватьСлово = (РазрывСлова <> Неопределено);
			КонецЕсли;
			
			Если НеобходимоРазорватьСлово Тогда
				ТекущаяСтрока = ТекущаяСтрока + ПрефиксСлова + РазрывСлова.Отрывок;
			КонецЕсли;
			
			// Завершаем текущую строку
			ЗавершитьСборТекущейСтроки(ТекущаяСтрока, СтатистикаБлока);
			
			// Начинаем новую строку
			ЭтоПервоеСловоВСтроке = Истина;
			Если НЕ ПродолжаемВыводВТекущийБлок Тогда
				СтатистикаБлока = ИнициализироватьСтатистикуБлока(СтатистикаБлока.НомерБлока + 1, БлокиСтрок);
			КонецЕсли;
			
			Если НеобходимоРазорватьСлово Тогда
				Слово = РазрывСлова.Остаток;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ЗавершитьСборТекущейСтроки(ТекущаяСтрока, СтатистикаБлока);
	
	Если СтатистикаБлока.КоличествоСтрок = СтатистикаБлока.ТекущийБлок.МаксимальноеКоличествоСтрок Тогда
		СтатистикаБлока = ИнициализироватьСтатистикуБлока(СтатистикаБлока.НомерБлока + 1, БлокиСтрок);
	КонецЕсли;
	
КонецПроцедуры

Функция ИнициализироватьСтатистикуБлока(НомерБлока, БлокиСтрок)
	
	КоличествоБлоков = БлокиСтрок.Количество();
	
	СтатистикаБлока = Новый Структура();
	
	СтатистикаБлока.Вставить("НомерБлока",		?(НомерБлока <= КоличествоБлоков, НомерБлока, Неопределено));
	СтатистикаБлока.Вставить("ТекущийБлок",		?(НомерБлока <= КоличествоБлоков, БлокиСтрок[НомерБлока - 1], Неопределено));
	СтатистикаБлока.Вставить("СледующийБлок",	?(НомерБлока < КоличествоБлоков, БлокиСтрок[НомерБлока], Неопределено));
	
	СтатистикаБлока.Вставить("КоличествоСтрок",	0);
	
	Возврат СтатистикаБлока;
	
КонецФункции

Процедура УдалитьКрайниеПустыеСтроки(МассивСтрок)
	
	// Удаляем начальные пустые строки
	
	КоличествоСтрок = МассивСтрок.Количество();
	
	Для Счетчик = 1 По КоличествоСтрок Цикл
		
		ТекСтрока = МассивСтрок[0];
		
		Если ПустаяСтрока(ТекСтрока) Тогда
			МассивСтрок.Удалить(0);
		Иначе
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	// Удаляем конечные пустые строки
	
	КоличествоСтрок = МассивСтрок.Количество();
	
	Для Счетчик = 1 По КоличествоСтрок Цикл
		
		Индекс = МассивСтрок.ВГраница();
		
		ТекСтрока = МассивСтрок[Индекс];
		
		Если ПустаяСтрока(ТекСтрока) Тогда
			МассивСтрок.Удалить(Индекс);
		Иначе
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция НельзяДобавитьСледующуюСтроку(СтатистикаБлока)
	
	Если СтатистикаБлока.ТекущийБлок = Неопределено Тогда
		
		Возврат Истина;
		
	Иначе
		
		Возврат (СтатистикаБлока.КоличествоСтрок = СтатистикаБлока.ТекущийБлок.МаксимальноеКоличествоСтрок)
			И  (СтатистикаБлока.СледующийБлок = Неопределено);
			
	КонецЕсли;
	
КонецФункции

Функция РазорватьСлово(Слово, СвободноСимволов, СтатистикаБлока)
	
	Если СтрДлина(Слово) < 4 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДлинаОтрывка = СвободноСимволов;
	
	ДлинаОстатка = СтрДлина(Слово) - ДлинаОтрывка;
	
	Если ДлинаОтрывка < 2 Тогда
		
		// Отрывок слишком короткий.
		// Разрыв слова невозможен.
		
		Возврат Неопределено;
		
	ИначеЕсли ДлинаОстатка < 2 Тогда
		
		// Остаток слишком короткий.
		// Увеличиваем остаток, и уменьшаем отрывок.
		
		ДлинаОстатка = 2;
		ДлинаОтрывка = СтрДлина(Слово) - ДлинаОстатка;
		
	КонецЕсли;
	
	Разрыв = Новый Структура();
	Разрыв.Вставить("Отрывок", Лев(Слово, ДлинаОтрывка));
	Разрыв.Вставить("Остаток", Прав(Слово, ДлинаОстатка));
	
	Возврат Разрыв;
	
КонецФункции

Процедура ЗавершитьСборТекущейСтроки(ТекущаяСтрока, СтатистикаБлока)
	
	СтатистикаБлока.ТекущийБлок.Строки.Добавить(ТекущаяСтрока);
	
	СтатистикаБлока.КоличествоСтрок = СтатистикаБлока.КоличествоСтрок + 1;
	
	ТекущаяСтрока = "";
	
КонецПроцедуры

Процедура ДобавитьОставшиесяСлова(Знач ИндексСлова, МассивСлов, СловоПоИндексу, ПараметрыОбработки)
	
	Перем ОставшиесяСлова;
	
	ВремМассив = Новый Массив();
	
	Если ЗначениеЗаполнено(СловоПоИндексу) Тогда
		ВремМассив.Добавить(СловоПоИндексу);
		
		ИндексСлова = ИндексСлова + 1;
	КонецЕсли;
	
	ПоследнийИндекс = МассивСлов.ВГраница();
	
	Для Индекс = ИндексСлова По ПоследнийИндекс Цикл
		ВремМассив.Добавить(МассивСлов[Индекс]);
	КонецЦикла;
	
	ВремСтрока = СтрСоединить(ВремМассив, ПараметрыОбработки.РазделительСлов);
	
	Если НЕ ПараметрыОбработки.Свойство("ОставшиесяСлова", ОставшиесяСлова) Тогда
		ОставшиесяСлова = "";
	КонецЕсли;
	
	ОставшиесяСлова = ОставшиесяСлова
		+ ?(ЗначениеЗаполнено(ОставшиесяСлова), ПараметрыОбработки.РазделительСлов, "")
		+ ВремСтрока;
	
	ПараметрыОбработки.Вставить("ОставшиесяСлова", ОставшиесяСлова);
	
КонецПроцедуры

#КонецОбласти

 #Область СерииДокументов

#Область ПанельСерииДокументов

Функция ПолучитьОписаниеСерииДокументов(СтрокаТаблицы, СвойстваСерий)
	
	СвойстваСерии = СвойстваСерий.Получить(СтрокаТаблицы.ИдентификаторСерииДокументов);
	
	Если СвойстваСерии <> Неопределено Тогда
		Возврат СвойстваСерии;
	КонецЕсли;
	
	СвойстваСерии = ПолучитьПустуюСтруктуруСвойстваСерии();
	
	СвойстваСерии.ОбщиеСвойства.ЗаголовочныйДокументСсылка		= СтрокаТаблицы.Ссылка;
	СвойстваСерии.ОбщиеСвойства.ЗаголовочныйДокументПроведен	= СтрокаТаблицы.Проведен;
	СвойстваСерии.ОбщиеСвойства.ЗаголовочныйДокументДата		= СтрокаТаблицы.Дата;
	СвойстваСерии.ОбщиеСвойства.ЗаголовочныйДокументНомер		= РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
		СтрокаТаблицы.Ссылка,
		СтрокаТаблицы.Номер);
		
	СвойстваСерии.ОбщиеСвойства.СписокДокументовСерии		= СтрокаТаблицы.СписокДокументовСерии;
	СвойстваСерии.ОбщиеСвойства.КоличествоДокументовСерии	= СтрокаТаблицы.СписокДокументовСерии.Количество();
	
	СвойстваСерий.Вставить(СтрокаТаблицы.ИдентификаторСерииДокументов, СвойстваСерии);
	
	Возврат СвойстваСерии;
	
КонецФункции

Функция ПолучитьПустуюСтруктуруСвойстваСерииДокументов()
	
	СвойстваСерииДокументов = Новый Структура("
		|СвойстваСерии,
		|СвойстваДокумента");
	
	СвойстваСерииДокументов.СвойстваСерии		= ПолучитьПустуюСтруктуруСвойстваСерии();
	СвойстваСерииДокументов.СвойстваДокумента	= ПолучитьПустуюСтруктуруСвойстваДокумента();
	
	Возврат СвойстваСерииДокументов;
	
КонецФункции

Функция ПолучитьПустуюСтруктуруСвойстваСерии()
	
	СвойстваСерии = Новый Структура("
		|ОбщиеСвойства,
		|Ошибки");
	
	СвойстваСерии.ОбщиеСвойства = Новый Структура("
		|ЗаголовочныйДокументСсылка,
		|ЗаголовочныйДокументНомер,
		|ЗаголовочныйДокументДата,
		|ЗаголовочныйДокументПроведен,
		|СписокДокументовСерии,
		|КоличествоДокументовСерии");
	
	СвойстваСерии.Ошибки = Новый Структура("
		|ЕстьОшибки,
		|СписокОшибок");
	
	// Возможные ошибки:
	// 1) Менее одного или более одного заголовочного документа;
	// 2) Менее двух строк в таб.части СписокДокументовСерии;
	// 3) Состав содержательных документов, указанный в таб.части СписокДокументовСерии,
	//    отличается от фактического состава документов с таким же идентификатором серии;
	// 4) Различное состояние пометки удаления у документов серии.
	СвойстваСерии.Ошибки.ЕстьОшибки	= Ложь;
	СвойстваСерии.Ошибки.СписокОшибок	= Новый Массив();
	
	Возврат СвойстваСерии;
	
КонецФункции

Функция ПолучитьПустуюСтруктуруСвойстваДокумента()
	
	СвойстваДокумента = Новый Структура("
		|ЭтоЗаголовочныйДокумент,
		|ЭтоСодержательныйДокумент,
		|ПорядковыйНомерДокумента");
	
	Возврат СвойстваДокумента;
	
КонецФункции

Функция ПрочитатьСостояниеДокументовСерии(Знач ЗаголовочныйДокументОбъект)
	
	СписокДокументовСерии	= ЗаголовочныйДокументОбъект.СписокДокументовСерии;
	Ссылка					= ЗаголовочныйДокументОбъект.Ссылка;
	
	Если ТипЗнч(СписокДокументовСерии) = Тип("ДанныеФормыКоллекция") Тогда
		ВремТаблица = СписокДокументовСерии.Выгрузить(, "ДокументОписи");
		
		СписокСсылок = ВремТаблица.ВыгрузитьКолонку("ДокументОписи");
	Иначе
		СписокСсылок = СписокДокументовСерии.ВыгрузитьКолонку("ДокументОписи");
	КонецЕсли;
	
	ОбъектМетаданныхДокумент = Метаданные.НайтиПоТипу(ТипЗнч(Ссылка));
	
	ИменаТабличныхЧастей = ПолучитьИменаТабличныхЧастейРазделов(ОбъектМетаданныхДокумент);
	
	ИмяДокумента = ОбъектМетаданныхДокумент.Имя;
	
	Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Шапки документов
	|//
	|ВЫБРАТЬ
	|	Ссылка			КАК Ссылка,
	|	Проведен		КАК Проведен,
	|	ПометкаУдаления	КАК ПометкаУдаления
	|ИЗ
	|	Документ.%1
	|ГДЕ
	|	Ссылка В(&СписокСсылок)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Количество строк в табличных частях
	|//";
	
	Текст = СтрШаблон(Текст, ИмяДокумента);
	
	ТекстШаблон = "
	|ВЫБРАТЬ
	|	Ссылка					КАК Ссылка,
	|	""%2""					КАК ИмяТабличнойЧасти,
	|	МАКСИМУМ(НомерСтроки)	КАК КоличествоСтрок
	|ИЗ
	|	Документ.%1.%2
	|ГДЕ
	|	Ссылка В(&СписокСсылок)
	|СГРУППИРОВАТЬ ПО
	|	Ссылка,
	|	""%2""";
	
	ТекстОбъединить = "
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|";
	
	Счетчик = 1;
	
	Для Каждого ИмяТабличнойЧасти Из ИменаТабличныхЧастей Цикл
		Текст = Текст + ?(Счетчик = 1, "", ТекстОбъединить)
			+ СтрШаблон(ТекстШаблон, ИмяДокумента, ИмяТабличнойЧасти);
		
		Счетчик = Счетчик + 1;
	КонецЦикла;
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("СписокСсылок", СписокСсылок);
	ЗапросПоиск.Текст = Текст;
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатыЗапроса = ЗапросПоиск.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	
	ТаблицаШапкиДокументов = РезультатыЗапроса[0].Выгрузить();
	ТаблицаКоличествоСтрок = РезультатыЗапроса[1].Выгрузить();
	
	ШаблонКоличествоСтрокТабличныхЧастей = Новый Структура();
	
	Для Каждого ИмяТабличнойЧасти Из ИменаТабличныхЧастей Цикл
		ШаблонКоличествоСтрокТабличныхЧастей.Вставить(ИмяТабличнойЧасти, 0);
	КонецЦикла;
	
	ШаблонКоличествоСтрокТабличныхЧастей = Новый ФиксированнаяСтруктура(ШаблонКоличествоСтрокТабличныхЧастей);
	
	СостояниеДокументовСерии = Новый Соответствие();
	
	ПоискДок = Новый Структура("Ссылка");
	ПоискТЧ = Новый Структура("Ссылка,ИмяТабличнойЧасти");
	
	Для Каждого ОписьСсылка Из СписокСсылок Цикл
		Если Не ЗначениеЗаполнено(ОписьСсылка) Тогда
			Продолжить;
		КонецЕсли;
		
		СостояниеДокумента = Новый Структура("
			|Проведен,
			|ПометкаУдаления,
			|КоличествоСтрокТабличныхЧастей");
		
		СостояниеДокумента.КоличествоСтрокТабличныхЧастей = Новый Структура(ШаблонКоличествоСтрокТабличныхЧастей);
		
		ПоискДок.Ссылка = ОписьСсылка;
		
		МассивСтрок = ТаблицаШапкиДокументов.НайтиСтроки(ПоискДок);
		
		СтрокаТаблицы = МассивСтрок[0];
		
		ЗаполнитьЗначенияСвойств(СостояниеДокумента, СтрокаТаблицы, "Проведен,ПометкаУдаления");
		
		Для Каждого ИмяТабличнойЧасти Из ИменаТабличныхЧастей Цикл
			ПоискТЧ.Ссылка				= ОписьСсылка;
			ПоискТЧ.ИмяТабличнойЧасти	= ИмяТабличнойЧасти;
			
			МассивСтрок = ТаблицаКоличествоСтрок.НайтиСтроки(ПоискТЧ);
			
			Если МассивСтрок.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаТаблицы = МассивСтрок[0];
			
			СостояниеДокумента.КоличествоСтрокТабличныхЧастей[ИмяТабличнойЧасти] = СтрокаТаблицы.КоличествоСтрок;
		КонецЦикла;
		
		СостояниеДокументовСерии.Вставить(ОписьСсылка, СостояниеДокумента);
	КонецЦикла;
	
	Возврат СостояниеДокументовСерии;
	
КонецФункции

Функция ПолучитьИменаТабличныхЧастейРазделов(ОбъектМетаданныхДокумент)
	
	ИскомыйПрефиксИмени = "Раздел";
	
	Имена = Новый Массив();
	
	Для Каждого Элемент Из ОбъектМетаданныхДокумент.ТабличныеЧасти Цикл
		Если СтрНачинаетсяС(Элемент.Имя, ИскомыйПрефиксИмени) Тогда
			Имена.Добавить(Элемент.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Имена;
	
КонецФункции

#КонецОбласти

#Область НастройкиСерийДокументов

Функция ПолучитьТаблицуНастроекОграниченияРазмераДокументовИнвентаризации()
	
	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("ТипОписи",		Новый ОписаниеТипов("Тип"));
	Таблица.Колонки.Добавить("КоличествоСтрок",	ОбщегоНазначения.ОписаниеТипаЧисло(6, 0, ДопустимыйЗнак.Неотрицательный));
	
	// 0510466
	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.ТипОписи = Тип("ДокументСсылка.ИнвентаризационнаяОписьНФА");
	НоваяСтрока.КоличествоСтрок = 50000;
	
	// 0510468
	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.ТипОписи = Тип("ДокументСсылка.ИнвентаризационнаяОписьРасчетовПоПоступлениям");
	НоваяСтрока.КоличествоСтрок = 30000;
	
	// 0510468
	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.ТипОписи = Тип("ДокументСсылка.УдалитьИнвентаризационнаяОписьРасчетовПоПоступлениям");
	НоваяСтрока.КоличествоСтрок = 30000; // 30000 строк * 3 подстроки = 90000 строк. Могут быть по 3 подстроки (долгосрочная, просроченная, иная).
	
	// 0510469
	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.ТипОписи = Тип("ДокументСсылка.ИнвентаризационнаяОписьРасчетовСКонтрагентами");
	НоваяСтрока.КоличествоСтрок = 30000; // 30000 строк * 3 подстроки = 90000 строк. Могут быть по 3 подстроки (долгосрочная, просроченная, иная).
	
	Возврат Таблица;
	
КонецФункции

Функция ПолучитьИменаРеквизитовШапкиОбщихДанныхСерииДокументов(ДокументОбъект)
	
	ТипДокумента = ТипЗнч(ДокументОбъект.Ссылка);
	
	ОбщиеРеквизитыШапки = "
		|Дата,
		|Организация,
		|Подразделение,
		|ИФО,
		|ДатаНачала,
		|ДатаОкончания,
		|ДатаИнвентаризации,
		|Ответственный,
		|ОтветственныйИсполнитель,
		|ОтветственныйИсполнительБухгалтерскойСлужбы,
		|РешениеОПроведенииИнвентаризации,
		|Комиссия,
		|НомерКомиссии,
		|НомерРабочейКомиссии";
	
	Если ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьНФА") Тогда
		// 0510466
		Возврат ОбщиеРеквизитыШапки + ",МОЛ";
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьРасчетовПоПоступлениям")
		Или ТипДокумента = Тип("ДокументСсылка.УдалитьИнвентаризационнаяОписьРасчетовПоПоступлениям")
		Или ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьРасчетовСКонтрагентами") Тогда
		// 0510468
		Возврат ОбщиеРеквизитыШапки + ",МестоИнвентаризации";
	
	КонецЕсли;
	
КонецФункции

Функция ПолучитьПустуюСтруктуруРасчетаСерииДокументов()
	
	РасчетСерииДокументов = Новый Структура("
		|ЗаполняемыйДокументСсылка,
		|ИдентификаторСерииДокументов,
		|КоличествоДокументовСерии,
		|ТаблицыНомеровСтрокРазделов");
	
	РасчетСерииДокументов.ТаблицыНомеровСтрокРазделов = Новый Структура();
	
	Возврат РасчетСерииДокументов;
	
КонецФункции

Функция ПолучитьПустуюТаблицуНомеровСтрокСерииДокументов()
	
	ТипНомерСтроки = ОбщегоНазначения.ОписаниеТипаЧисло(8, 0, ДопустимыйЗнак.Неотрицательный);
	
	ТаблицаНомеровСтрок = Новый ТаблицаЗначений();
	ТаблицаНомеровСтрок.Колонки.Добавить("НомерСтрокиНач",	ТипНомерСтроки);
	ТаблицаНомеровСтрок.Колонки.Добавить("НомерСтрокиКон",	ТипНомерСтроки);
	
	Возврат ТаблицаНомеровСтрок;
	
КонецФункции

#КонецОбласти

#Область ЗаполнениеДокументовСерии

Функция СоздатьНовыйСодержательныйДокумент(МетаданныеДокумента, РасчетСерииДокументов, ЗаголовочныйДокумент, НомерДокумента, ПараметрыФункции)
	
	СодержательныйДокумент = Документы[МетаданныеДокумента.Имя].СоздатьДокумент();
	
	ЗаполнитьЗначенияСвойств(СодержательныйДокумент, ПараметрыФункции.ПараметрыРасчетаСерииДокументов.ШапкаДокумента);
	
	СодержательныйДокумент.ИдентификаторСерииДокументов				= РасчетСерииДокументов.ИдентификаторСерииДокументов;
	СодержательныйДокумент.НомерЗаголовочногоДокумента				= ЗаголовочныйДокумент.Номер;
	СодержательныйДокумент.ПорядковыйНомерДокументаВСерииДокументов	= НомерДокумента;
	СодержательныйДокумент.КоличествоДокументовВСерииДокументов		= РасчетСерииДокументов.КоличествоДокументовСерии;
	
	Возврат СодержательныйДокумент;
	
КонецФункции

Процедура ЗаписатьСодержательныйДокумент(СодержательныйДокумент, ЗаполняемыйДокумент)
	
	СодержательныйДокумент.Записать(РежимЗаписиДокумента.Запись);
			
	НоваяСтрокаДокумента = ЗаполняемыйДокумент.СписокДокументовСерии.Добавить();
	НоваяСтрокаДокумента.ДокументОписи = СодержательныйДокумент.Ссылка;
	
КонецПроцедуры

Процедура ЗаписатьСодержательныеДокументыСерии(ЗаполняемыйДокумент, РасчетСерииДокументов, Данные, ПараметрыФункции)
	
	// Заполняем заголовочный документ.
	ЗаполняемыйДокумент.ЭтоЗаголовочныйДокумент = Истина;
	ЗаполняемыйДокумент.ИдентификаторСерииДокументов = РасчетСерииДокументов.ИдентификаторСерииДокументов;
	ЗаполняемыйДокумент.СписокДокументовСерии.Очистить();
	
	МетаданныеДокумента = ЗаполняемыйДокумент.Метаданные();
	
	ТипДокумента = ТипЗнч(ЗаполняемыйДокумент);
		
	Если ТипДокумента = Тип("ДокументОбъект.ИнвентаризационнаяОписьНФА") Тогда
		// 0510466
		
		// Очищаем таблицы заголовочного документа.
		ЗаполняемыйДокумент.Раздел1.Очистить();
		ЗаполняемыйДокумент.ДополнениеРаздела1.Очистить();
		ЗаполняемыйДокумент.Раздел21.Очистить();
		ЗаполняемыйДокумент.Раздел22.Очистить();
		ЗаполняемыйДокумент.Раздел3.Очистить();
		ЗаполняемыйДокумент.Раздел4.Очистить();
		
		// Содержательные документы.
		Для НомерДокумента = 1 По РасчетСерииДокументов.КоличествоДокументовСерии Цикл
			// Создаем новый содержательный документ.
			СодержательныйДокумент = СоздатьНовыйСодержательныйДокумент(МетаданныеДокумента, РасчетСерииДокументов, ЗаполняемыйДокумент, НомерДокумента, ПараметрыФункции);
			
			ДобавитьПорциюСтрокТаблицыВСодержательныйДокумент(СодержательныйДокумент.Раздел1, Данные.Раздел1, РасчетСерииДокументов.ТаблицыНомеровСтрокРазделов.Раздел1, НомерДокумента);
			
			Документы.ИнвентаризационнаяОписьНФА.ЗаполнитьДополнениеРаздела1СодержательногоДокумента(СодержательныйДокумент, Данные);
			
			// Общие сведения всех содержательных документов.
			СодержательныйДокумент.СписокСчетов.Загрузить(ПараметрыФункции.СписокСчетов);
			СодержательныйДокумент.МестаИнвентаризации.Загрузить(ПараметрыФункции.МестаИнвентаризации);
			СодержательныйДокумент.СписокНФА.Загрузить(ПараметрыФункции.СписокНФА);
			
			// Записываем текущий содержательный документ.
			ЗаписатьСодержательныйДокумент(СодержательныйДокумент, ЗаполняемыйДокумент);
		КонецЦикла;
		
	ИначеЕсли ТипДокумента = Тип("ДокументОбъект.ИнвентаризационнаяОписьРасчетовПоПоступлениям")
		Или ТипДокумента = Тип("ДокументОбъект.УдалитьИнвентаризационнаяОписьРасчетовПоПоступлениям")
		Или ТипДокумента = Тип("ДокументОбъект.ИнвентаризационнаяОписьРасчетовСКонтрагентами") Тогда
		// 0510468, 0510469
		
		// Очищаем таблицы заголовочного документа.
		ЗаполняемыйДокумент.Раздел11.Очистить();
		ЗаполняемыйДокумент.Раздел12.Очистить();
		ЗаполняемыйДокумент.Раздел21.Очистить();
		ЗаполняемыйДокумент.Раздел22.Очистить();
		
		ЗаполняемыйДокумент.ИтогиРаздела21ПоСчету.Очистить();
		ЗаполняемыйДокумент.ИтогиРаздела21ПоКонтрагенту.Очистить();
		ЗаполняемыйДокумент.ИтогиРаздела22ПоСчету.Очистить();
		ЗаполняемыйДокумент.ИтогиРаздела22ПоКонтрагенту.Очистить();
		
		КоличествоДокументовРаздел11 = РасчетСерииДокументов.ТаблицыНомеровСтрокРазделов.Раздел11.Количество();
		КоличествоДокументовРаздел12 = РасчетСерииДокументов.ТаблицыНомеровСтрокРазделов.Раздел12.Количество();
		
		Для НомерДокумента = 1 По РасчетСерииДокументов.КоличествоДокументовСерии Цикл
			// Создаем новый содержательный документ.
			СодержательныйДокумент = СоздатьНовыйСодержательныйДокумент(МетаданныеДокумента, РасчетСерииДокументов, ЗаполняемыйДокумент, НомерДокумента, ПараметрыФункции);
			
			Если НомерДокумента <= КоличествоДокументовРаздел11 Тогда
				ДобавитьПорциюСтрокТаблицыВСодержательныйДокумент(СодержательныйДокумент.Раздел11, Данные.Раздел11, РасчетСерииДокументов.ТаблицыНомеровСтрокРазделов.Раздел11, НомерДокумента);
			КонецЕсли;
			
			Если НомерДокумента <= КоличествоДокументовРаздел12 Тогда
				ДобавитьПорциюСтрокТаблицыВСодержательныйДокумент(СодержательныйДокумент.Раздел12, Данные.Раздел12, РасчетСерииДокументов.ТаблицыНомеровСтрокРазделов.Раздел12, НомерДокумента);
			КонецЕсли;
			
			// Общие сведения всех содержательных документов.
			СодержательныйДокумент.СписокСчетов.Загрузить(ПараметрыФункции.СписокСчетов);
			
			// Записываем текущий содержательный документ.
			ЗаписатьСодержательныйДокумент(СодержательныйДокумент, ЗаполняемыйДокумент);
		КонецЦикла;
		
		
	Иначе
		ТекстСообщения = СтрШаблон(НСтр("ru='Не предусмотрено формирование серии документов для документа ""%1"".'"), МетаданныеДокумента.Имя);
		
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;
	
КонецПроцедуры

Функция РассчитатьТаблицуНомеровСтрокСерииДокументов_ЕстьКолонкаКоличествоПодстрок(Таблица, ОграничениеРазмераДокумента)
	
	ТаблицаНомеровСтрок = ПолучитьПустуюТаблицуНомеровСтрокСерииДокументов();
	
	КоличествоСтрокТаблицы = Таблица.Количество();
	
	Если КоличествоСтрокТаблицы = 0 Тогда
		Возврат ТаблицаНомеровСтрок;
	КонецЕсли;
	
	НоваяСтрока = ТаблицаНомеровСтрок.Добавить();
	НоваяСтрока.НомерСтрокиНач = 1;
	
	КоличествоСтрокТекущегоДокумента = 0;
	
	НомерСтрокиТаблицы = 1;
	
	Пока НомерСтрокиТаблицы <= КоличествоСтрокТаблицы Цикл
		СтрокаТаблицы = Таблица[НомерСтрокиТаблицы - 1];
		
		КоличествоСтрокТекущегоДокумента = КоличествоСтрокТекущегоДокумента + 1 + СтрокаТаблицы.КоличествоПодстрок;
		
		Если КоличествоСтрокТекущегоДокумента < ОграничениеРазмераДокумента Тогда
			НомерСтрокиТаблицы = НомерСтрокиТаблицы + 1;
			
			Продолжить;
		КонецЕсли;
		
		Если КоличествоСтрокТекущегоДокумента = ОграничениеРазмераДокумента Тогда
			НоваяСтрока.НомерСтрокиКон = НомерСтрокиТаблицы;
			
			Если НомерСтрокиТаблицы < КоличествоСтрокТаблицы Тогда
				НоваяСтрока = ТаблицаНомеровСтрок.Добавить();
				НоваяСтрока.НомерСтрокиНач = НомерСтрокиТаблицы + 1;
				
				КоличествоСтрокТекущегоДокумента = 0;
			КонецЕсли;
		Иначе
			// НомерСтрокиТекущегоДокумента > ОграничениеРазмераДокумента.
			// Текущая строка не помещается в ограничение размера документа.
			
			КоличествоСтрокБезТекущейСтроки = КоличествоСтрокТекущегоДокумента - 1 - СтрокаТаблицы.КоличествоПодстрок;
			
			Если КоличествоСтрокБезТекущейСтроки > 0 Тогда
				// Исключаем текущую строку в полном составе из текущего документа,
				// и начинаем следующий документ с этой же строки.
				
				НоваяСтрока.НомерСтрокиКон = НомерСтрокиТаблицы - 1;
				
				НоваяСтрока = ТаблицаНомеровСтрок.Добавить();
				НоваяСтрока.НомерСтрокиНач = НомерСтрокиТаблицы;
				
				КоличествоСтрокТекущегоДокумента = 0;
				
				Продолжить;
			Иначе
				// Включаем текущую строку в полном составе, несмотря на то,
				// что ее размер превышает ограничение размера документа.
				
				НоваяСтрока.НомерСтрокиКон = НомерСтрокиТаблицы;
				
				Если НомерСтрокиТаблицы < КоличествоСтрокТаблицы Тогда
					НоваяСтрока = ТаблицаНомеровСтрок.Добавить();
					НоваяСтрока.НомерСтрокиНач = НомерСтрокиТаблицы + 1;
					
					КоличествоСтрокТекущегоДокумента = 0;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		НомерСтрокиТаблицы = НомерСтрокиТаблицы + 1;
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(НоваяСтрока.НомерСтрокиКон) Тогда
		НоваяСтрока.НомерСтрокиКон = НомерСтрокиТаблицы - 1;
	КонецЕсли;
	
	Возврат ТаблицаНомеровСтрок;
	
КонецФункции

Функция РассчитатьТаблицуНомеровСтрокСерииДокументов_БезКолонкиКоличествоПодстрок(Таблица, ОграничениеРазмераДокумента)
	
	ТаблицаНомеровСтрок = ПолучитьПустуюТаблицуНомеровСтрокСерииДокументов();
	
	КоличествоСтрокТаблицы = Таблица.Количество();
	
	Если КоличествоСтрокТаблицы = 0 Тогда
		Возврат ТаблицаНомеровСтрок;
	КонецЕсли;
	
	НомерСтрокиНач = 1;
	
	Пока Истина Цикл
		НоваяСтрока = ТаблицаНомеровСтрок.Добавить();
		НоваяСтрока.НомерСтрокиНач = НомерСтрокиНач;
		
		НомерСтрокиКон = НомерСтрокиНач + ОграничениеРазмераДокумента - 1;
		
		Если НомерСтрокиКон >= КоличествоСтрокТаблицы Тогда
			НоваяСтрока.НомерСтрокиКон = КоличествоСтрокТаблицы;
			Прервать;
		КонецЕсли;
		
		НоваяСтрока.НомерСтрокиКон = НомерСтрокиКон;
		
		НомерСтрокиНач = НомерСтрокиКон + 1;
	КонецЦикла;
	
	Возврат ТаблицаНомеровСтрок;
	
КонецФункции

Процедура ДобавитьПорциюСтрокТаблицыВСодержательныйДокумент(ТабличнаяЧасть, ТаблицаДанных, ТаблицаНомеровСтрокРаздела, НомерДокумента)
	
	СтрокаТаблицыНомеровСтрок = ТаблицаНомеровСтрокРаздела[НомерДокумента - 1];
	
	Для НомерСтроки = СтрокаТаблицыНомеровСтрок.НомерСтрокиНач По СтрокаТаблицыНомеровСтрок.НомерСтрокиКон Цикл
		СтрокаТаблицы = ТаблицаДанных[НомерСтроки - 1];
		
		НоваяСтрока = ТабличнаяЧасть.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

 #Область ИнвентаризационныеОписи61н 
 
 #Область Настройки

Процедура ЗаполнитьСведенияИзМетаданныхДокументовОписей61н(ТаблицаНастроек)
	
	Для Каждого СтрокаТаблицы Из ТаблицаНастроек Цикл
		МетаданныеДокумента = Метаданные.НайтиПоТипу(СтрокаТаблицы.ТипДокумента);
		
		Если МетаданныеДокумента = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТаблицы.ИмяДокумента = МетаданныеДокумента.Имя;
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.ИмяРеквизитаСотрудникДляРасписки) Тогда
			СтрокаТаблицы.СинонимРеквизитаСотрудникДляРасписки = МетаданныеДокумента.Реквизиты[СтрокаТаблицы.ИмяРеквизитаСотрудникДляРасписки].Синоним;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьТаблицуКодовСчетовИнвентаризацияНФА0510466(ДобавитьПользовательскиеСчета = Истина, Организация = Неопределено)
	
	Таблица = ПолучитьПустуюТаблицуКодовСчетов();
	
	ДобавитьКодыСчетов(Таблица, "101.00");
	ДобавитьКодыСчетов(Таблица, "102.00");
	ДобавитьКодыСчетов(Таблица, "103.00");
	ДобавитьКодыСчетов(Таблица, "105.00");
	ДобавитьКодыСчетов(Таблица, "106.00");
	ДобавитьКодыСчетов(Таблица, "108.00");
	ДобавитьКодыСчетов(Таблица, "111.60");
	ДобавитьКодыСчетов(Таблица, "113.00");
	ДобавитьКодыСчетов(Таблица, "01");
	ДобавитьКодыСчетов(Таблица, "02");
	ДобавитьКодыСчетов(Таблица, "07");
	ДобавитьКодыСчетов(Таблица, "12");
	ДобавитьКодыСчетов(Таблица, "13");
	ДобавитьКодыСчетов(Таблица, "21");
	ДобавитьКодыСчетов(Таблица, "22");
	ДобавитьКодыСчетов(Таблица, "23");
	ДобавитьКодыСчетов(Таблица, "25"); // только объекты финансовой аренды
	ДобавитьКодыСчетов(Таблица, "27.02"); // только МЗ
	
	Если ДобавитьПользовательскиеСчета Тогда
		ЗапросПоиск = Новый Запрос();
		ЗапросПоиск.УстановитьПараметр("Организация", Организация);
		ЗапросПоиск.Текст = "
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СчетГруппа.Код КАК КодСчета
		|ИЗ
		|	РегистрСведений.ДополнительныеГруппыСчетовИнвентаризацииМЗ
		|ГДЕ
		|	Организация = &Организация";
		
		УстановитьПривилегированныйРежим(Истина);
		Выборка = ЗапросПоиск.Выполнить().Выбрать();
		УстановитьПривилегированныйРежим(Ложь);
		
		Поиск = Новый Структура("КодыСчетовСтрокой");
		
		Пока Выборка.Следующий() Цикл
			КодСчета = Выборка.КодСчета;
			
			Поиск.КодыСчетовСтрокой = КодСчета;
			
			МассивСтрок = Таблица.НайтиСтроки(Поиск);
			
			Если МассивСтрок.Количество() > 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ДобавитьКодыСчетов(Таблица, КодСчета);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Таблица;
	
КонецФункции

Функция ПолучитьПредставленияСтатусовОбъясненияОтветственногоЛица()
	
	Список = Новый СписокЗначений();
	Список.Добавить(Перечисления.СтатусыОбъясненияОтветственногоЛица.НеТребуется,	НСтр("ru='0 - не требуется'"));
	Список.Добавить(Перечисления.СтатусыОбъясненияОтветственногоЛица.НеПринято,		НСтр("ru='1 - не принято'"));
	Список.Добавить(Перечисления.СтатусыОбъясненияОтветственногоЛица.Принято,		НСтр("ru='2 - принято'"));
	
	Возврат Список;
	
КонецФункции

Функция ПолучитьНастройкиСтатусаОбъяснения(ОписьСсылка)
	
	ИмяТабличнойЧасти = "Раздел4";
	
	// Только излишки и недостача. Неактив сюда не включается.
	ПоказателиОтклонений = Новый Массив();
	
	Если ТипЗнч(ОписьСсылка) = Тип("ДокументСсылка.ИнвентаризационнаяОписьБСО") Тогда
		// 0510465
		ПоказателиОтклонений.Добавить("СуммаИзлишкиНеПодтверждено");
		ПоказателиОтклонений.Добавить("СуммаНедостачаНеПодтверждено");
		
	ИначеЕсли ТипЗнч(ОписьСсылка) = Тип("ДокументСсылка.ИнвентаризационнаяОписьНФА") Тогда
		// 0510466
		ПоказателиОтклонений.Добавить("СуммаНедостачаНеПодтверждено");
		ПоказателиОтклонений.Добавить("КоличествоИзлишкиНеПодтверждено");
		
	ИначеЕсли ТипЗнч(ОписьСсылка) = Тип("ДокументСсылка.ИнвентаризационнаяОписьНаличныхСредств") Тогда
		// 0510467
		ПоказателиОтклонений.Добавить("СуммаИзлишки");
		ПоказателиОтклонений.Добавить("СуммаНедостача");
		
	Иначе
		ИмяДокумента = Метаданные.НайтиПоТипу(ТипЗнч(ОписьСсылка)).Имя;
		
		ВызватьИсключение СтрШаблон(НСтр("ru='Для документа %1 не определены настройки заполнения статуса объяснения ответственного лица.'"), ИмяДокумента);
	КонецЕсли;
	
	НастройкиСтатусаОбъяснения = Новый Структура();
	НастройкиСтатусаОбъяснения.Вставить("ИмяТабличнойЧасти",	ИмяТабличнойЧасти);
	НастройкиСтатусаОбъяснения.Вставить("ПоказателиОтклонений",	ПоказателиОтклонений);
	
	Возврат НастройкиСтатусаОбъяснения;
	
КонецФункции

#КонецОбласти

#Область ПанелиРаспискиИОписи

// Панель расписки

Функция ПолучитьПредставлениеДокументаРасписки(НомерДокумента, ДатаДокумента)
	
	Возврат СтрШаблон(НСтр("ru='Расписка %1 от %2'"), СокрЛП(НомерДокумента), Формат(ДатаДокумента, "ДФ=дд.ММ.гггг"));
	
КонецФункции

// Общее

Процедура ЗаполнитьСписокВыбораКомментарий(СписокВыбораКомментарий, СтрокаТаблицыДиагностики)
	
	// Добавляем в список только непомеченные на удаление документы
	
	ПараИзДокумента = СтрокаТаблицыДиагностики.Приемник;
	
	Для Каждого СтрокаТаблицы Из СтрокаТаблицыДиагностики.СтрокиОбратныхСсылок Цикл
		Если СтрокаТаблицы.Источник = ПараИзДокумента Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаТаблицы.ИсточникПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		
		СписокВыбораКомментарий.Добавить(
			СтрокаТаблицы.Источник,
			ПолучитьПредставлениеДокументаРасписки(СтрокаТаблицы.ИсточникНомерДокумента, СтрокаТаблицы.ИсточникДатаДокумента));
	КонецЦикла;
	
КонецПроцедуры

Функция НоваяПанельРасписки(ОписьСсылка)
	Возврат
		ТипЗнч(ОписьСсылка) = Тип("ДокументСсылка.ИнвентаризационнаяОписьГосДолгаВЦенныхБумагах")
		Или ТипЗнч(ОписьСсылка) = Тип("ДокументСсылка.ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам")
		Или ТипЗнч(ОписьСсылка) = Тип("ДокументСсылка.ИнвентаризационнаяОписьГосДолгаПоПредоставленнымГарантиям")
		Или ТипЗнч(ОписьСсылка) = Тип("ДокументСсылка.ИнвентаризационнаяОписьЦенныхБумаг");
КонецФункции

Функция ПолучитьОписаниеОписиИзТаблицыНастроекЗаполненияОписейПоРешению(ОписьСсылка, Организация)
	
	НастройкиОписи = ПолучитьТаблицуНастроекЗаполненияОписейПоРешению(ТипЗнч(ОписьСсылка),, Организация)[0];
	
	СтрокаТаблицыНастроекЗаполненияОписейПоРешению = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(НастройкиОписи);
	
	СтрокаТаблицыНастроекЗаполненияОписейПоРешению.ТаблицаКодовСчетов = ОбщегоНазначения.ТаблицаЗначенийВМассив(НастройкиОписи.ТаблицаКодовСчетов);
	
	ОписаниеРеквизитаСчет = ДиагностироватьОписаниеРеквизитаОписи(НастройкиОписи.ИмяРеквизитаСчет);
	
	ОписаниеРеквизитаМестоИнвентаризации = ДиагностироватьОписаниеРеквизитаОписи(НастройкиОписи.ИмяРеквизитаМестоИнвентаризации, "МестоИнвентаризации");
	
	ОписаниеОписи = Новый Структура();
	ОписаниеОписи.Вставить("СтрокаТаблицыНастроекЗаполненияОписейПоРешению", СтрокаТаблицыНастроекЗаполненияОписейПоРешению);
	ОписаниеОписи.Вставить("ОписаниеРеквизитаСчет", ОписаниеРеквизитаСчет);
	ОписаниеОписи.Вставить("ОписаниеРеквизитаМестоИнвентаризации", ОписаниеРеквизитаМестоИнвентаризации);
	
	Возврат ОписаниеОписи;
	
КонецФункции

#КонецОбласти

#Область ДиагностикаСвязейДокументовОписейИРасписок

Функция ПрочитатьПарыСсылокОписьРасписка(МассивОписей = Неопределено, МассивРасписок = Неопределено, ТаблицаНастроек)
	
	ПрочитатьНомераДатыДокументов = Истина;
	
	Если МассивОписей = Неопределено И МассивРасписок = Неопределено Тогда
		ВызватьИсключение НСтр("ru='Не указан ни один из параметров функции ПрочитатьПарыСсылокОписьРасписка()'");
	КонецЕсли;
	
	ИменаДокументов = ИнвентаризацияСервер.ПолучитьИменаДокументовОписей61н(ТаблицаНастроек, МассивОписей);
	
	ЗапросПоиск = Новый Запрос();
	
	Если МассивОписей <> Неопределено Тогда
		ЗапросПоиск.УстановитьПараметр("МассивОписей", МассивОписей);
		
		ЗапросПоиск.Текст = ЗапросПоиск.Текст + "
		|////////////////////////////////////////////////////////////////////////////////
		|// Указанные документы описей
		|//";
		
		Шаблон = "
		|ВЫБРАТЬ
		|	Опись.Ссылка												КАК Ссылка,
		|	ЕСТЬNULL(СоответствиеДокументов.ДокументРасписки,
		|		ЗНАЧЕНИЕ(Документ.РаспискаИнвентаризации.ПустаяСсылка))	КАК ДокументРасписки,
		|	Опись.Проведен												КАК Проведен,
		|	Опись.ПометкаУдаления										КАК ПометкаУдаления
		|%1
		|ИЗ
		|	Документ.%2 КАК Опись
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствияДокументовИнвентаризационныхОписейИРасписок КАК СоответствиеДокументов
		|		ПО Опись.Ссылка = СоответствиеДокументов.ДокументОписи
		|ГДЕ
		|	Ссылка В(&МассивОписей)";
		
		ТекстПоместить = "ПОМЕСТИТЬ
		|	УказанныеДокументыОписей";
		
		ТекстОбъединить = "
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|";
			
		Счетчик = 1;
		
		Для Каждого ИмяДокумента Из ИменаДокументов Цикл
			ЗапросПоиск.Текст = ЗапросПоиск.Текст + ?(Счетчик = 1, "", ТекстОбъединить)
				+ СтрШаблон(Шаблон, ?(Счетчик = 1, ТекстПоместить, ""), ИмяДокумента);
			
			Счетчик = Счетчик + 1;
		КонецЦикла;
		
		ЗапросПоиск.Текст = ЗапросПоиск.Текст + "
		|;
		|";
	КонецЕсли;
	
	Если МассивРасписок <> Неопределено Тогда
		ЗапросПоиск.УстановитьПараметр("МассивРасписок", МассивРасписок);
		
		ЗапросПоиск.Текст = ЗапросПоиск.Текст + "
		|////////////////////////////////////////////////////////////////////////////////
		|// Указанные документы расписок
		|//
		|ВЫБРАТЬ
		|	Ссылка				КАК Ссылка,
		|	ДокументОписи		КАК ДокументОписи,
		|	Проведен			КАК Проведен,
		|	ПометкаУдаления		КАК ПометкаУдаления
		|ПОМЕСТИТЬ
		|	УказанныеДокументыРасписок
		|ИЗ
		|	Документ.РаспискаИнвентаризации
		|ГДЕ
		|	Ссылка В(&МассивРасписок)
		|;";
	КонецЕсли;
	
	ЗапросПоиск.Текст = ЗапросПоиск.Текст + "
	|////////////////////////////////////////////////////////////////////////////////
	|// Пары ссылок для дальнейшего анализа
	|//
	|";
	
	ДобавленТекстВыбрать = Ложь;
	
	ТекстОбъединить = "
	|
	|ОБЪЕДИНИТЬ
	|";
	
	Если МассивОписей <> Неопределено Тогда
		ЗапросПоиск.Текст = ЗапросПоиск.Текст + ?(ДобавленТекстВыбрать, ТекстОбъединить, "ВЫБРАТЬ РАЗЛИЧНЫЕ") + "
		|	Ссылка				КАК Источник,
		|	ДокументРасписки	КАК Приемник,
		|	Проведен			КАК ИсточникПроведен,
		|	ПометкаУдаления		КАК ИсточникПометкаУдаления
		|ИЗ
		|	УказанныеДокументыОписей
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	Ссылка				КАК Источник,
		|	ДокументОписи		КАК Приемник,
		|	Проведен			КАК ИсточникПроведен,
		|	ПометкаУдаления		КАК ИсточникПометкаУдаления
		|ИЗ
		|	Документ.РаспискаИнвентаризации
		|ГДЕ
		|	Ссылка В(ВЫБРАТЬ ДокументРасписки ИЗ УказанныеДокументыОписей)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	Ссылка				КАК Источник,
		|	ДокументОписи		КАК Приемник,
		|	Проведен			КАК ИсточникПроведен,
		|	ПометкаУдаления		КАК ИсточникПометкаУдаления
		|ИЗ
		|	Документ.РаспискаИнвентаризации
		|ГДЕ
		|	ДокументОписи В(ВЫБРАТЬ Ссылка ИЗ УказанныеДокументыОписей)";
		
		ДобавленТекстВыбрать = Истина;
	КонецЕсли;
	
	Если МассивРасписок <> Неопределено Тогда
		ЗапросПоиск.Текст = ЗапросПоиск.Текст + ?(ДобавленТекстВыбрать, ТекстОбъединить + "ВЫБРАТЬ", "ВЫБРАТЬ РАЗЛИЧНЫЕ") + "
		|	Ссылка				КАК Источник,
		|	ДокументОписи		КАК Приемник,
		|	Проведен			КАК ИсточникПроведен,
		|	ПометкаУдаления		КАК ИсточникПометкаУдаления
		|ИЗ
		|	УказанныеДокументыРасписок
		|";
		
		ДобавленТекстВыбрать = Истина;
		
		Шаблон = "
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	Опись.Ссылка												КАК Источник,
		|	ЕСТЬNULL(СоответствиеДокументов.ДокументРасписки,
		|		ЗНАЧЕНИЕ(Документ.РаспискаИнвентаризации.ПустаяСсылка))	КАК Приемник,
		|	Опись.Проведен												КАК ИсточникПроведен,
		|	Опись.ПометкаУдаления										КАК ИсточникПометкаУдаления
		|ИЗ
		|	Документ.%1 КАК Опись
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствияДокументовИнвентаризационныхОписейИРасписок КАК СоответствиеДокументов
		|		ПО Опись.Ссылка = СоответствиеДокументов.ДокументОписи
		|ГДЕ
		|	Опись.Ссылка В(ВЫБРАТЬ ДокументОписи ИЗ УказанныеДокументыРасписок)
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	Опись.Ссылка												КАК Источник,
		|	ЕСТЬNULL(СоответствиеДокументов.ДокументРасписки,
		|		ЗНАЧЕНИЕ(Документ.РаспискаИнвентаризации.ПустаяСсылка))	КАК Приемник,
		|	Опись.Проведен												КАК ИсточникПроведен,
		|	Опись.ПометкаУдаления										КАК ИсточникПометкаУдаления
		|ИЗ
		|	Документ.%1 КАК Опись
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СоответствияДокументовИнвентаризационныхОписейИРасписок КАК СоответствиеДокументов
		|		ПО Опись.Ссылка = СоответствиеДокументов.ДокументОписи
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ УказанныеДокументыРасписок
		|		ПО СоответствиеДокументов.ДокументРасписки = УказанныеДокументыРасписок.Ссылка";
		
		//|ОБЪЕДИНИТЬ
		//|
		//|ВЫБРАТЬ
		//|	Ссылка				КАК Источник,
		//|	ДокументРасписки	КАК Приемник,
		//|	Проведен			КАК ИсточникПроведен,
		//|	ПометкаУдаления		КАК ИсточникПометкаУдаления
		//|ИЗ
		//|	Документ.%1
		//|ГДЕ
		//|	Ссылка В(ВЫБРАТЬ ДокументОписи ИЗ УказанныеДокументыРасписок)
		//|
		//|ОБЪЕДИНИТЬ
		//|
		//|ВЫБРАТЬ
		//|	Ссылка				КАК Источник,
		//|	ДокументРасписки	КАК Приемник,
		//|	Проведен			КАК ИсточникПроведен,
		//|	ПометкаУдаления		КАК ИсточникПометкаУдаления
		//|ИЗ
		//|	Документ.%1
		//|ГДЕ
		//|	ДокументРасписки В(ВЫБРАТЬ Ссылка ИЗ УказанныеДокументыРасписок)";
		
		
		Для Каждого ИмяДокумента Из ИменаДокументов Цикл
			ЗапросПоиск.Текст = ЗапросПоиск.Текст + СтрШаблон(Шаблон, ИмяДокумента);
		КонецЦикла;
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	Таблица = ЗапросПоиск.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Если ПрочитатьНомераДатыДокументов Тогда
		ДобавитьКолонкиНомерДатаДокумента(Таблица);
	КонецЕсли;
	
	Возврат Таблица;
	
КонецФункции

Процедура ДобавитьКолонкиНомерДатаДокумента(Таблица)
	
	Таблица.Колонки.Добавить("ИсточникНомерДокумента",	Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("ИсточникДатаДокумента",	Новый ОписаниеТипов("Дата"));
	
	МассивСсылок = Таблица.ВыгрузитьКолонку("Источник");
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МассивСсылок, "Номер,Дата");
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		ДокументСсылка = СтрокаТаблицы.Источник;
		
		Свойства = ЗначенияРеквизитов.Получить(ДокументСсылка);
		
		НомерДокумента = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка, Свойства.Номер);
		
		СтрокаТаблицы.ИсточникНомерДокумента = НомерДокумента;
		СтрокаТаблицы.ИсточникДатаДокумента = Свойства.Дата;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДиагностироватьПарыСсылокОписьРасписка(ТаблицаПарСсылок)
	
	ТаблицаПарСсылок.Колонки.Добавить("КоличествоОбратныхСсылок",	ОбщегоНазначения.ОписаниеТипаЧисло(4,0,ДопустимыйЗнак.Неотрицательный));
	ТаблицаПарСсылок.Колонки.Добавить("СтрокиОбратныхСсылок",		Новый ОписаниеТипов("Массив"));
	ТаблицаПарСсылок.Колонки.Добавить("ЕстьВзаимнаяСсылка",			Новый ОписаниеТипов("Булево"));
	ТаблицаПарСсылок.Колонки.Добавить("СтрокаВзаимнойСсылки");
	
	ПоискИсточник = Новый Структура("Источник");
	ПоискПриемник = Новый Структура("Приемник");
	
	Для Каждого СтрокаПарыСсылок Из ТаблицаПарСсылок Цикл
		
		// Обратные ссылки
		
		СтрокаПарыСсылок.СтрокиОбратныхСсылок = Новый Массив();
		
		ПоискПриемник.Приемник = СтрокаПарыСсылок.Источник;
		
		МассивСтрок = ТаблицаПарСсылок.НайтиСтроки(ПоискПриемник);
		
		Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
			СтрокаПарыСсылок.СтрокиОбратныхСсылок.Добавить(СтрокаТаблицы);
			СтрокаПарыСсылок.КоличествоОбратныхСсылок = СтрокаПарыСсылок.СтрокиОбратныхСсылок.Количество();
		КонецЦикла;
		
		// Взаимные ссылки
		
		Если Не ЗначениеЗаполнено(СтрокаПарыСсылок.Приемник) Или СтрокаПарыСсылок.ЕстьВзаимнаяСсылка Тогда
			Продолжить;
		КонецЕсли;
		
		ПоискИсточник.Источник = СтрокаПарыСсылок.Приемник;
		
		МассивСтрок = ТаблицаПарСсылок.НайтиСтроки(ПоискИсточник);
		
		Если МассивСтрок.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТаблицы = МассивСтрок[0];
		
		Если СтрокаТаблицы.Приемник = СтрокаПарыСсылок.Источник Тогда
			СтрокаТаблицы.ЕстьВзаимнаяСсылка = Истина;
			СтрокаТаблицы.СтрокаВзаимнойСсылки = СтрокаПарыСсылок;
			
			СтрокаПарыСсылок.ЕстьВзаимнаяСсылка = Истина;
			СтрокаПарыСсылок.СтрокаВзаимнойСсылки = СтрокаТаблицы;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОтборСчетовИКФО

Функция ОпределитьПрименяемыеЗначенияКФО(Счет, ТаблицаСписокСчетов, РодителиСчетов, ДополнительныеПараметры)
	
	ПоискСчет					= ДополнительныеПараметры.ПоискСчет;
	ПоискСсылка					= ДополнительныеПараметры.ПоискСсылка;
	КоличествоРодителейСчетов	= ДополнительныеПараметры.КоличествоРодителейСчетов;
	
	ПрименяемыеЗначенияКФО = Новый Массив();
	
	ПоискСчет.Счет = Счет;
	
	МассивСтрок = ТаблицаСписокСчетов.НайтиСтроки(ПоискСчет);
	
	Если МассивСтрок.Количество() = 0 Тогда
		// Такой счет в списке счетов в явном виде не указан.
		// Проверяем, может указаны его родители.
		// Используем настройку ближайшего родителя.
		
		ПоискСсылка.Ссылка = Счет;
		
		МассивСтрокРодителей = РодителиСчетов.НайтиСтроки(ПоискСсылка);
		
		СвойстваСчета = МассивСтрокРодителей[0];
		
		МассивСсылок = Новый Массив();
		
		Для УровеньРодителя = 1 По КоличествоРодителейСчетов Цикл
			
			УровеньРодителяСтрокой = Формат(УровеньРодителя, "ЧГ=0");
			
			ИмяПоляСсылка = "Родитель" + УровеньРодителяСтрокой + "Ссылка";
			
			РодительСсылка = СвойстваСчета[ИмяПоляСсылка];
			
			Если Не ЗначениеЗаполнено(РодительСсылка) Тогда
				Продолжить;
			КонецЕсли;
			
			ПоискСчет.Счет = РодительСсылка;
			
			МассивСтрок = ТаблицаСписокСчетов.НайтиСтроки(ПоискСчет);
			
			Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
				КФО = СтрокаТаблицы.КФО;
				
				Если Не ЗначениеЗаполнено(КФО) Тогда
					Продолжить;
				КонецЕсли;
				
				Если ПрименяемыеЗначенияКФО.Найти(КФО) = Неопределено Тогда
					ПрименяемыеЗначенияКФО.Добавить(СтрокаТаблицы.КФО);
				КонецЕсли;
			КонецЦикла;
			
		КонецЦикла;
		
		Возврат ПрименяемыеЗначенияКФО;
	КонецЕсли;
	
	// Такой счет явно указан в списке счетов.
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		КФО = СтрокаТаблицы.КФО;
		
		Если Не ЗначениеЗаполнено(КФО) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПрименяемыеЗначенияКФО.Найти(КФО) = Неопределено Тогда
			ПрименяемыеЗначенияКФО.Добавить(СтрокаТаблицы.КФО);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ПрименяемыеЗначенияКФО;
	
КонецФункции

Функция ОпределитьНеПрименяемыеЗначенияКФО(Знач ПрименяемыеЗначенияКФО, Знач ПолныйСписокКФО)
	
	НеПрименяемыеЗначенияКФО = Новый Массив();
	
	Для Каждого КФО Из ПолныйСписокКФО Цикл
		Если ПрименяемыеЗначенияКФО.Найти(КФО) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НеПрименяемыеЗначенияКФО.Добавить(КФО);
	КонецЦикла;
	
	Возврат НеПрименяемыеЗначенияКФО;
	
КонецФункции

#КонецОбласти

#Область РасчетИзлишковНедостачи 

Функция ПолучитьПараметрыОбработкиИзлишковНедостачи(КолонкиСвязи, КолонкиПоказателей, ПараметрыРасчета)
	
	Перем КолонкиСвязиСтрокой, КолонкиПоказателейСтрокой, КолонкиПоказателейМассив;
	
	ИменаСлужебныхКолонок = ИменаСлужебныхКолонокДляРасчетаИзлишковНедостачи();
	
	ПостфиксИмениПоказателяИзлишки = "Излишки";
	ПостфиксИмениПоказателяНедостача = "Недостача";
	
	Если ТипЗнч(КолонкиСвязи) = Тип("Строка") Тогда
		КолонкиСвязиСтрокой = КолонкиСвязи;
	ИначеЕсли ТипЗнч(КолонкиСвязи) = Тип("Массив") Тогда
		КолонкиСвязиСтрокой = СтрРазделить(КолонкиСвязи, ", ", Ложь);
	Иначе
		ВызватьИсключение СтрШаблон(НСтр("ru='Передан параметр неожидаемого типа %1. Ожидается тип Строка, Массив.'"), ТипЗнч(КолонкиСвязи));
	КонецЕсли;
	
	Если ТипЗнч(КолонкиПоказателей) = Тип("Строка") Тогда
		КолонкиПоказателейМассив = СтрРазделить(КолонкиПоказателей, ", ", Ложь);
		
	ИначеЕсли ТипЗнч(КолонкиПоказателей) = Тип("Массив") Тогда
		КолонкиПоказателейМассив = КолонкиПоказателей;
	Иначе
		ВызватьИсключение СтрШаблон(НСтр("ru='Передан параметр неожидаемого типа %1. Ожидается тип Строка, Массив.'"), ТипЗнч(КолонкиСвязи));
	КонецЕсли;
	
	КолонкиРасхождений = Новый Структура();
	Для Каждого ИмяПоказателя Из КолонкиПоказателейМассив Цикл
		КолонкиРасхождений.Вставить(ИмяПоказателя + ПостфиксИмениПоказателяИзлишки, 0);
		КолонкиРасхождений.Вставить(ИмяПоказателя + ПостфиксИмениПоказателяНедостача, 0);
	КонецЦикла;
	
	ОчищающаяСтруктура = Новый ФиксированнаяСтруктура(КолонкиРасхождений);
	
	ПараметрыОбработки = Новый Структура();
	ПараметрыОбработки.Вставить("КолонкиРасхождений",				КолонкиРасхождений);
	ПараметрыОбработки.Вставить("ОчищающаяСтруктура",				ОчищающаяСтруктура);
	ПараметрыОбработки.Вставить("ИменаСлужебныхКолонок",			ИменаСлужебныхКолонок);
	ПараметрыОбработки.Вставить("ПостфиксИмениПоказателяИзлишки",	ПостфиксИмениПоказателяИзлишки);
	ПараметрыОбработки.Вставить("ПостфиксИмениПоказателяНедостача",	ПостфиксИмениПоказателяНедостача);
	
	ПараметрыОбработки.Вставить("КолонкиСвязиСтрокой",				КолонкиСвязиСтрокой);
	ПараметрыОбработки.Вставить("КолонкиПоказателейМассив",			КолонкиПоказателейМассив);
	ПараметрыОбработки.Вставить("Поиск",							Новый Структура());
	
	ПараметрыОбработки.Вставить("ПараметрыРасчета",					ПараметрыРасчета);
	
	Возврат ПараметрыОбработки;
	
КонецФункции

Процедура ОбойтиТаблицуДляПоискаИзлишковНедостачи(ТаблицаУчет, ТаблицаФакт, ТаблицаИзлишкиНедостача, ПараметрыОбработки, ОбходТаблицыУчет)
	
	Если ОбходТаблицыУчет Тогда
		ТаблицаОбхода = ТаблицаУчет;
		ТаблицаПоиска = ТаблицаФакт;
	Иначе
		ТаблицаОбхода = ТаблицаФакт;
		ТаблицаПоиска = ТаблицаУчет;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицыОбхода Из ТаблицаОбхода Цикл
		СтрокаТаблицыОбхода[ПараметрыОбработки.ИменаСлужебныхКолонок.СтрокаОбработана] = Истина;
		
		ЗаполнитьЗначенияСвойств(ПараметрыОбработки.Поиск, СтрокаТаблицыОбхода);
		
		МассивСтрок = ТаблицаПоиска.НайтиСтроки(ПараметрыОбработки.Поиск);
		
		Если МассивСтрок.Количество() = 0 Тогда
			СтрокаТаблицыУчет = ?(ОбходТаблицыУчет, СтрокаТаблицыОбхода, Неопределено);
			СтрокаТаблицыФакт = ?(ОбходТаблицыУчет, Неопределено, СтрокаТаблицыОбхода);
			
			ПроверитьИДобавитьСтрокуИзлишковНедостачи(ТаблицаИзлишкиНедостача, СтрокаТаблицыУчет, СтрокаТаблицыФакт, ПараметрыОбработки, ОбходТаблицыУчет);
			
			Продолжить;
		КонецЕсли;
		
		Для Каждого СтрокаТаблицыПоиска Из МассивСтрок Цикл
			СтрокаТаблицыПоиска[ПараметрыОбработки.ИменаСлужебныхКолонок.СтрокаОбработана] = Истина;
			
			СтрокаТаблицыУчет = ?(ОбходТаблицыУчет, СтрокаТаблицыОбхода, СтрокаТаблицыПоиска);
			СтрокаТаблицыФакт = ?(ОбходТаблицыУчет, СтрокаТаблицыПоиска, СтрокаТаблицыОбхода);
			
			ПроверитьИДобавитьСтрокуИзлишковНедостачи(ТаблицаИзлишкиНедостача, СтрокаТаблицыУчет, СтрокаТаблицыФакт, ПараметрыОбработки, ОбходТаблицыУчет);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьИДобавитьСтрокуИзлишковНедостачи(ТаблицаИзлишкиНедостача, СтрокаТаблицыУчет, СтрокаТаблицыФакт, ПараметрыОбработки, ОбходТаблицыУчет)
	
	ЕстьРасхождение = Ложь;
	
	ЗаполнитьЗначенияСвойств(ПараметрыОбработки.КолонкиРасхождений, ПараметрыОбработки.ОчищающаяСтруктура);
	
	Для Каждого ИмяПоказателя Из ПараметрыОбработки.КолонкиПоказателейМассив Цикл
		Расхождение = ?(СтрокаТаблицыФакт = Неопределено, 0, СтрокаТаблицыФакт[ИмяПоказателя])
			- ?(СтрокаТаблицыУчет = Неопределено, 0, СтрокаТаблицыУчет[ИмяПоказателя]);
		
		Если Расхождение = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ЕстьРасхождение = Истина;
		
		Если Расхождение > 0 Тогда
			// Излишки
			ПараметрыОбработки.КолонкиРасхождений[ИмяПоказателя + ПараметрыОбработки.ПостфиксИмениПоказателяИзлишки] = Расхождение;
			
		ИначеЕсли Расхождение < 0 Тогда
			// Недостача
			ПараметрыОбработки.КолонкиРасхождений[ИмяПоказателя + ПараметрыОбработки.ПостфиксИмениПоказателяНедостача] = -Расхождение;
		КонецЕсли;
	КонецЦикла;
	
	Если ЕстьРасхождение Или ОбходТаблицыУчет И ПараметрыОбработки.ПараметрыРасчета.ПовторитьТаблицуУчет Тогда
		НоваяСтрока = ТаблицаИзлишкиНедостача.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ?(СтрокаТаблицыУчет <> Неопределено, СтрокаТаблицыУчет, СтрокаТаблицыФакт), ПараметрыОбработки.КолонкиСвязиСтрокой);
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ПараметрыОбработки.КолонкиРасхождений);
		
		Если ПараметрыОбработки.ПараметрыРасчета.ЭтоОписьНФА Тогда
			// Код строки
			КодСтроки = ?(СтрокаТаблицыФакт <> Неопределено,
				СтрокаТаблицыФакт[ПараметрыОбработки.ПараметрыРасчета.КолонкиКодСтроки.ИмяКолонкиТаблицыФакт],
				СтрокаТаблицыУчет[ПараметрыОбработки.ПараметрыРасчета.КолонкиКодСтроки.ИмяКолонкиТаблицыУчет]);
				
			НоваяСтрока[ПараметрыОбработки.ПараметрыРасчета.КолонкиКодСтроки.ИмяКолонкиТаблицыИзлишкиНедостача] = КодСтроки;
			
			// Цена
			Если СтрокаТаблицыФакт <> Неопределено Тогда
				Цена = СтрокаТаблицыФакт.Цена;
			ИначеЕсли СтрокаТаблицыУчет.Количество <> 0 Тогда
				Цена = СтрокаТаблицыУчет.Сумма / СтрокаТаблицыУчет.Количество;
			Иначе
				Цена = 0;
			КонецЕсли;
				
			// Сумма недостачи
			Если ПараметрыОбработки.КолонкиРасхождений.КоличествоНедостача > 0 Тогда
				Если СтрокаТаблицыУчет.Количество = ПараметрыОбработки.КолонкиРасхождений.КоличествоНедостача Тогда
					СуммаНедостача = СтрокаТаблицыУчет.Сумма;
				Иначе
					СуммаНедостача = Окр(ПараметрыОбработки.КолонкиРасхождений.КоличествоНедостача * Цена, 2);
				КонецЕсли;
				
				НоваяСтрока.СуммаНедостача = СуммаНедостача;
			КонецЕсли;
			
			// Сведения из раздела 2.1
			НоваяСтрока.КоличествоИзРаздела21 = ?(СтрокаТаблицыФакт <> Неопределено, СтрокаТаблицыФакт.Количество, 0);
			НоваяСтрока.Цена = Цена;
			
		ИначеЕсли ПараметрыОбработки.ПараметрыРасчета.ЭтоОпись0510465 Тогда
			СтрокаТаблицы = ?(СтрокаТаблицыФакт <> Неопределено, СтрокаТаблицыФакт, СтрокаТаблицыУчет);
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы, "КодСтроки,Цена");
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ИменаСлужебныхКолонокДляРасчетаИзлишковНедостачи()
	
	ИменаСлужебныхКолонок = Новый Структура();
	ИменаСлужебныхКолонок.Вставить("СтрокаОбработана", "РасчетИзлишковНедостачи_СтрокаОбработана");
	
	Возврат ИменаСлужебныхКолонок;
	
КонецФункции

Процедура ДобавитьСлужебныеКолонкиДляРасчетаИзлишковНедостачи(ТаблицаУчет, ТаблицаФакт)
	
	ИменаСлужебныхКолонок = ИменаСлужебныхКолонокДляРасчетаИзлишковНедостачи();
	
	ТаблицаУчет.Колонки.Добавить(ИменаСлужебныхКолонок.СтрокаОбработана, Новый ОписаниеТипов("Булево"));
	ТаблицаФакт.Колонки.Добавить(ИменаСлужебныхКолонок.СтрокаОбработана, Новый ОписаниеТипов("Булево"));
	
КонецПроцедуры

#КонецОбласти

Функция ДиагностироватьМестаИнвентаризации(МассивМестИнвентаризации)
	
	МассивМестХранения = Новый Массив();
	
	КоличествоТекстовых = 0;
	КоличествоСсылочных = 0;
	КоличествоВообще = МассивМестИнвентаризации.Количество();
	
	ЕдинственноеЗначениеТекстовое = Неопределено;
	ЕдинственноеЗначениеСсылочное = Неопределено;
	ЕдинственноеЗначениеВообще = ?(КоличествоВообще = 1, МассивМестИнвентаризации[0], Неопределено);
	
	Для Каждого МестоИнвентаризации Из МассивМестИнвентаризации Цикл
		
		Если ТипЗнч(МестоИнвентаризации) = Тип("Строка") Тогда
			КоличествоТекстовых = КоличествоТекстовых + 1;
			
			ЕдинственноеЗначениеТекстовое = МестоИнвентаризации;
			
			Продолжить;
		КонецЕсли;
		
		КоличествоСсылочных = КоличествоСсылочных + 1;
		
		ЕдинственноеЗначениеСсылочное = МестоИнвентаризации;
		
		Если ТипЗнч(МестоИнвентаризации) = Тип("СправочникСсылка.МестаХранения") Тогда
			МассивМестХранения.Добавить(МестоИнвентаризации);
		КонецЕсли;
	КонецЦикла;
	
	Если КоличествоТекстовых <> 1 Тогда
		ЕдинственноеЗначениеТекстовое = Неопределено;
	КонецЕсли;
	
	Если КоличествоСсылочных <> 1 Тогда
		ЕдинственноеЗначениеСсылочное = Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура();
	Результат.Вставить("МассивМестИнвентаризации", МассивМестИнвентаризации);
	Результат.Вставить("МассивМестХранения", МассивМестХранения);
	Результат.Вставить("ЕстьТекстовые", (КоличествоТекстовых > 0));
	Результат.Вставить("ЕстьСсылочные", (КоличествоСсылочных > 0));
	Результат.Вставить("ЕдинственноеЗначениеТекстовое", ЕдинственноеЗначениеТекстовое);
	Результат.Вставить("ЕдинственноеЗначениеСсылочное", ЕдинственноеЗначениеСсылочное);
	Результат.Вставить("ЕдинственноеЗначениеВообще",	ЕдинственноеЗначениеВообще);
	
	Возврат Результат;
	
КонецФункции

Процедура ТипизироватьВходныеПараметрыПрочерковПустыхПолей(СтруктураИменПолей, ДополнительныеСимволыПустыхПолей)
	
	// Преобразуем входные параметры в ожидаемый тип массив.
	
	Для Каждого Элемент Из СтруктураИменПолей Цикл
		ИмяНабора = Элемент.Ключ;
		ИменаПолей = Элемент.Значение;
		
		Если ТипЗнч(ИменаПолей) = Тип("Строка") Тогда
			ИменаПолейМассив = СтрРазделить(ИменаПолей, ", ", Ложь);
			
			СтруктураИменПолей[ИмяНабора] = ИменаПолейМассив;
		КонецЕсли;
	КонецЦикла;
	
	Если ДополнительныеСимволыПустыхПолей = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Элемент Из ДополнительныеСимволыПустыхПолей Цикл
		ИмяНабора = Элемент.Ключ;
		СимволыПустыхПолей = Элемент.Значение;
		
		УдаляемыеЭлементы = Новый Массив();
		
		Для Каждого ЭлементДоп Из СимволыПустыхПолей Цикл
			ИменаПолейДоп = ЭлементДоп.Ключ;
			СимволПустогоПоля = ЭлементДоп.Значение;
			
			Если ТипЗнч(ИменаПолейДоп) = Тип("Строка") Тогда
				УдаляемыеЭлементы.Добавить(ИменаПолейДоп);
				
				ИменаПолейДопМассив = СтрРазделить(ИменаПолейДоп, ", ", Ложь);
				
				СимволыПустыхПолей.Вставить(ИменаПолейДопМассив, СимволПустогоПоля);
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого Элемент Из УдаляемыеЭлементы Цикл
			СимволыПустыхПолей.Удалить(Элемент);
		КонецЦикла;
		
		ДополнительныеСимволыПустыхПолей[ИмяНабора] = СимволыПустыхПолей;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьИменаДополнительныхПустыхПолей(СтруктураИменПолей, ДополнительныеСимволыПустыхПолей)
	
	Перем ИменаПолей;
	
	Если ДополнительныеСимволыПустыхПолей = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Элемент Из ДополнительныеСимволыПустыхПолей Цикл
		ИмяНабора = Элемент.Ключ;
		СимволыПустыхПолей = Элемент.Значение;
		
		СтруктураИменПолей.Свойство(ИмяНабора, ИменаПолей);
		
		Если ИменаПолей = Неопределено Тогда
			// Такого набора не определено в основных настройках.
			// Создаем такой набор и добавляем в него все доп.поля.
			ИменаПолей = Новый Массив();
			
			СтруктураИменПолей.Вставить(ИмяНабора, ИменаПолей);
		КонецЕсли;
		
		Для Каждого ЭлементДоп Из СимволыПустыхПолей Цикл
			ИменаПолейДоп = ЭлементДоп.Ключ;
			
			Для Каждого ИмяПоля Из ИменаПолейДоп Цикл
				Если ИменаПолей.Найти(ИмяПоля) = Неопределено Тогда
					ИменаПолей.Добавить(ИмяПоля);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		СтруктураИменПолей[ИмяНабора] = ИменаПолей;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьТекстыДляОформленияПустыхПолей(ИменаПолей, ДополнительныеСимволыПустыхПолей = Неопределено)
	
	СимволПрочерка = НСтр("ru='—'");
	
	Палитра = Новый Структура();
	
	НовыйТекст = Новый Структура();
	
	Для Каждого Элемент Из ИменаПолей Цикл
		ИмяНабора = Элемент.Ключ;
		ИменаПолейПрочерк = Элемент.Значение;
		
		Для Каждого ИмяПоля Из ИменаПолейПрочерк Цикл
			Палитра.Вставить(ИмяПоля, "");
			НовыйТекст.Вставить(ИмяПоля, СимволПрочерка);
		КонецЦикла;
		
		Если ДополнительныеСимволыПустыхПолей <> Неопределено И ДополнительныеСимволыПустыхПолей.Свойство(ИмяНабора) Тогда
			СимволыПустыхПолей = ДополнительныеСимволыПустыхПолей[ИмяНабора];
			
			Для Каждого ЭлементДоп Из СимволыПустыхПолей Цикл
				ИменаПолейДоп = ЭлементДоп.Ключ;
				СимволПустогоПоля = ЭлементДоп.Значение;
				
				Для Каждого ИмяПоляДоп Из ИменаПолейДоп Цикл
					Палитра.Вставить(ИмяПоляДоп, "");
					НовыйТекст.Вставить(ИмяПоляДоп, СимволПустогоПоля);
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	ПустаяПалитра = Новый ФиксированнаяСтруктура(Палитра);
	
	Тексты = Новый Структура();
	Тексты.Вставить("НовыйТекст",		НовыйТекст);
	Тексты.Вставить("Палитра",			Палитра);
	Тексты.Вставить("ПустаяПалитра",	ПустаяПалитра);
	
	Возврат Тексты;
	
КонецФункции

