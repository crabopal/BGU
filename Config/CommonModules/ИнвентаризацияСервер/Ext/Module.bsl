Процедура УстановитьПредставлениеСпискаСчетовНаФормеОписи(ФормаДокумента, МаксимальнаяДлинаСтроки = 50) Экспорт
	
	СписокСчетов = ФормаДокумента.Объект.СписокСчетов;
	
	МассивСтрок = Новый Массив();
	
	Для Каждого СтрокаТаблицы Из СписокСчетов Цикл
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.Счет) Тогда
			Продолжить;
		КонецЕсли;
		
		МассивСтрок.Добавить(СтрШаблон("%1.%2",
			?(ЗначениеЗаполнено(СтрокаТаблицы.КФО), Строка(СтрокаТаблицы.КФО), "0"),
			Строка(СтрокаТаблицы.Счет)));
	КонецЦикла;
	
	Если МассивСтрок.Количество() = 0 Тогда
		Представление = НСтр("ru='<отсутствует>'");
	Иначе
		Представление = ИнвентаризацияКлиентСервер.СократитьСтроку(СтрСоединить(МассивСтрок, ", "), МаксимальнаяДлинаСтроки);
	КонецЕсли;
	
	ФормаДокумента.ПредставлениеСпискаСчетов = Представление;
	
КонецПроцедуры

Процедура УстановитьПредставлениеНомераКомиссииНаФормеОписи(ФормаДокумента) Экспорт
	
	Объект = ФормаДокумента.Объект;
	
	ПредставлениеНомераКомиссии = "";
	
	Если ЗначениеЗаполнено(Объект.НомерКомиссии) Или ЗначениеЗаполнено(Объект.НомерРабочейКомиссии) Тогда
		ПредставлениеНомераКомиссии = ИнвентаризацияКлиентСервер.ФорматироватьПолныйНомерКомиссии(Объект.НомерКомиссии, Объект.НомерРабочейКомиссии);
	КонецЕсли;
	
	ФормаДокумента.ПредставлениеНомераКомиссии = ПредставлениеНомераКомиссии;
	
КонецПроцедуры

Процедура УстановитьПредставлениеСпискаМестИнвентаризацииНаФормеОписи(ФормаДокумента, МаксимальнаяДлинаСтроки = 30) Экспорт
	
	Объект = ФормаДокумента.Объект;
	
	МассивСтрок = Новый Массив();
	
	Для Каждого СтрокаТаблицы Из Объект.МестаИнвентаризации Цикл
		МассивСтрок.Добавить(Строка(СтрокаТаблицы.МестоИнвентаризации));
	КонецЦикла;
	
	Если МассивСтрок.Количество() = 0 Тогда
		Представление = НСтр("ru='<отсутствует>'");
	Иначе
		Представление = ИнвентаризацияКлиентСервер.СократитьСтроку(СтрСоединить(МассивСтрок, ", "), МаксимальнаяДлинаСтроки);
	КонецЕсли;
	
	ФормаДокумента.ПредставлениеМестаПроведения = Представление;
	
КонецПроцедуры

// Добавляет в список выбора только такие значения, которые могут быть выбраны вручную
Процедура ЗаполнитьСписокВыбораЭлементаСтатусОбъяснения(Элемент) Экспорт
	
	ПредставленияСтатусов = ПолучитьПредставленияСтатусовОбъясненияОтветственногоЛица();
	
	ДобавляемыеЗначения = Новый Массив();
	ДобавляемыеЗначения.Добавить(Перечисления.СтатусыОбъясненияОтветственногоЛица.НеПринято);
	ДобавляемыеЗначения.Добавить(Перечисления.СтатусыОбъясненияОтветственногоЛица.Принято);
	
	Элемент.СписокВыбора.Очистить();
	
	Для Каждого Значение Из ДобавляемыеЗначения Цикл
		Представление = ПредставленияСтатусов.НайтиПоЗначению(Значение).Представление;
		
		Элемент.СписокВыбора.Добавить(Значение, Представление);
	КонецЦикла;
	
	Элемент.РежимВыбораИзСписка = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область НедоступностьИзмененияКолонок

Процедура НастроитьНедоступностьИзмененияКолонокНаФормеОписи(Форма, Знач ИменаЭлементовКолонок, Знач УстановитьЦветТекста = Истина,
		Знач ИменаКолонокСОтключаемойНедоступностью = Неопределено) Экспорт
	
	Элементы = Форма.Элементы;
	
	Если ИменаКолонокСОтключаемойНедоступностью <> Неопределено Тогда
		КэшироватьСвойстваЭлементовНедоступныхКолонок(Форма, ИменаКолонокСОтключаемойНедоступностью);
	КонецЕсли;
	
	ОписаниеНедоступнойКолонки = НовыйОписаниеНедоступнойКолонки();
	
	ИсключаяСвойства = ?(УстановитьЦветТекста = Истина, Неопределено, "ЦветТекста");
	
	Для Каждого ИмяЭлемента Из ИменаЭлементовКолонок Цикл
		ЭлементКолонки = Элементы[ИмяЭлемента];
		
		УстановитьСвойстваИОбработчикиСобытийЭлементаКолонки(
			ЭлементКолонки,
			ОписаниеНедоступнойКолонки,
			ИсключаяСвойства);
	КонецЦикла;
	
КонецПроцедуры

Процедура ОтключитьНедоступностьИзмененияКолонокНаФормеОписи(Форма, Знач ИменаЭлементовКолонок,
		Знач ИменаКолонокСОтключаемойНедоступностью = Неопределено) Экспорт
	
	Перем Кэш, ОписаниеИзКэша;
	
	Элементы = Форма.Элементы;
	
	ОписаниеДоступнойКолонки = НовыйОписаниеДоступнойКолонки();
	
	ЕстьКорректныйКэш = Ложь;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "КэшСвойстваЭлементовНедоступныхКолонок") Тогда
		Кэш = Форма.КэшСвойстваЭлементовНедоступныхКолонок;
		
		ЕстьКорректныйКэш = (ТипЗнч(Кэш) = Тип("ФиксированнаяСтруктура"));
	КонецЕсли;
	
	Для Каждого ИмяЭлемента Из ИменаЭлементовКолонок Цикл
		ЭлементКолонки = Элементы[ИмяЭлемента];
		
		Если ИменаКолонокСОтключаемойНедоступностью = Неопределено Тогда
			УстановитьСвойстваИОбработчикиСобытийЭлементаКолонки(
				ЭлементКолонки,
				ОписаниеДоступнойКолонки);
			
			Продолжить;
		КонецЕсли;
		
		Если ИменаКолонокСОтключаемойНедоступностью.Найти(ИмяЭлемента) = Неопределено Тогда
			// Для этой колонки не требуется действие.
			Продолжить;
		КонецЕсли;
		
		Если ЕстьКорректныйКэш И Кэш.Свойство(ИмяЭлемента, ОписаниеИзКэша) Тогда
			// В кэш успели сохранить свойства этой колонки.
			УстановитьСвойстваИОбработчикиСобытийЭлементаКолонки(
				ЭлементКолонки,
				ОписаниеИзКэша);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область Печать

// Устарела. Более не используется.
Процедура ВывестиПечатнуюФормуРасписки(ТабДокумент, Опись, ПечатныеФормыРасписок) Экспорт
	
	Поиск = Новый Структура("Опись", Опись);
	
	МассивСтрок = ПечатныеФормыРасписок.НайтиСтроки(Поиск);
	
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТабДокумент.Вывести(МассивСтрок[0].ТабличныйДокументРасписки);
	
	ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	
КонецПроцедуры

Процедура ЗаполнитьРазмерыРазделов(Данные, ИменаРазделов, ДокументСсылка, ИменаПолей = "КодСтроки,НомерСтроки") Экспорт
	
	РазмерыРазделов = Данные.ДополнительныеПараметры.РазмерыРазделов;
	
	ИменаРазделовМассив = СтрРазделить(ИменаРазделов, ", ");
	
	ИменаПолейМассив = СтрРазделить(ИменаПолей, ", ");
	
	ПоискДокумента = Новый Структура("Ссылка", ДокументСсылка);
	
	Для Каждого ИмяРаздела Из ИменаРазделовМассив Цикл
		РазмерРаздела = Новый Структура();
		
		ВыборкаИтогов = Данные.Выборки[ИмяРаздела];
		ВыборкаИтогов.Сбросить();
		
		ЕстьДанные = ВыборкаИтогов.НайтиСледующий(ПоискДокумента);
		
		Для Каждого ИмяПоля Из ИменаПолейМассив Цикл
			Если ЕстьДанные И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ВыборкаИтогов, ИмяПоля) Тогда
				Значение = ВыборкаИтогов[ИмяПоля];
			Иначе
				Значение = 0;
			КонецЕсли;
			
			РазмерРаздела.Вставить(ИмяПоля, Значение);
		КонецЦикла;
		
		РазмерыРазделов.Вставить(ИмяРаздела, РазмерРаздела);
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьСведенияОтветственногоИсполнителяДляПечати(ОтветственныйИсполнитель, Дата) Экспорт
	
	ДанныеСотрудника = Новый Структура();
	ДанныеСотрудника.Вставить("СсылкаНаОбъект",	ОтветственныйИсполнитель);
	ДанныеСотрудника.Вставить("Период",			Дата);
	ДанныеСотрудника.Вставить("ДолжностьНаименование");
	ДанныеСотрудника.Вставить("Фамилия");
	ДанныеСотрудника.Вставить("Имя");
	ДанныеСотрудника.Вставить("Отчество");
	ДанныеСотрудника.Вставить("Код");
	
	ПолучатьКИдляПечати = Истина;
	
	Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника,, ПолучатьКИдляПечати);
	
	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("ДолжностьНаименование",	ДанныеСотрудника.ДолжностьНаименование);
	ЗначенияПараметров.Вставить("Должность",				ДанныеСотрудника.ДолжностьНаименование);
	// И.О. Фамилия
	ЗначенияПараметров.Вставить("ФИО",						КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника,Истина,,Истина));
	// Фамилия Имя Отчество
	ЗначенияПараметров.Вставить("ФИОПолное",				КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника,Ложь,,Ложь));
	ЗначенияПараметров.Вставить("НомерТелефона",			ДанныеСотрудника.ТелефонРабочийФизическиеЛица);
	ЗначенияПараметров.Вставить("ЭлектроннаяПочта",			ДанныеСотрудника.EmailФизическиеЛица);
	ЗначенияПараметров.Вставить("Код",						ДанныеСотрудника.Код);
	
	Возврат ЗначенияПараметров;
	
КонецФункции

Функция ПолучитьНастройкиПрочерковПустыхПолей(СтруктураИменПолей, ДополнительныеСимволыПустыхПолей = Неопределено) Экспорт
	
	ТипизироватьВходныеПараметрыПрочерковПустыхПолей(СтруктураИменПолей, ДополнительныеСимволыПустыхПолей);
	
	ДобавитьИменаДополнительныхПустыхПолей(СтруктураИменПолей, ДополнительныеСимволыПустыхПолей);
	
	ОформлениеПустыхПолей = Новый Структура();
	ОформлениеПустыхПолей.Вставить("ИменаПолей",			СтруктураИменПолей);
	ОформлениеПустыхПолей.Вставить("ИменаПолейДоп",			ДополнительныеСимволыПустыхПолей);
	ОформлениеПустыхПолей.Вставить("Тексты",				ПолучитьТекстыДляОформленияПустыхПолей(СтруктураИменПолей, ДополнительныеСимволыПустыхПолей));
	ОформлениеПустыхПолей.Вставить("ЗаполняющаяСтруктура",	ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ОформлениеПустыхПолей.Тексты.Палитра));
	
	Возврат ОформлениеПустыхПолей;
	
КонецФункции

Процедура ПрочеркнутьПустыеПоля(ОбластьСтрокаТаблицы, Выборка, ОформлениеПустыхПолей, КлючНабораПолей) Экспорт
	
	Тексты					= ОформлениеПустыхПолей.Тексты;
	ИменаПолей				= ОформлениеПустыхПолей.ИменаПолей;
	ЗаполняющаяСтруктура	= ОформлениеПустыхПолей.ЗаполняющаяСтруктура;
	
	ЗаполнитьЗначенияСвойств(Тексты.Палитра, ОбластьСтрокаТаблицы.Параметры);
	
	ЗаполняющаяСтруктура.Очистить();
	
	Для Каждого ИмяПоля Из ИменаПолей[КлючНабораПолей] Цикл
		Если Не ЗначениеЗаполнено(Тексты.Палитра[ИмяПоля]) Тогда
			ЗаполняющаяСтруктура.Вставить(ИмяПоля, Тексты.НовыйТекст[ИмяПоля]);
		КонецЕсли;
	КонецЦикла;
	
	Если ЗаполняющаяСтруктура.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ОбластьСтрокаТаблицы.Параметры, ЗаполняющаяСтруктура);
	
	ЗаполнитьЗначенияСвойств(Тексты.Палитра, Тексты.ПустаяПалитра);
	
КонецПроцедуры

#КонецОбласти

Функция ПолучитьСпискиМОЛДляСпискаМестИнвентаризации(Знач Сотрудник, Знач МассивМестИнвентаризации) Экспорт
	
	ДиагностикаМестИнвентаризации = ДиагностироватьМестаИнвентаризации(МассивМестИнвентаризации);
	
	МассивМестИнвентаризации		= ДиагностикаМестИнвентаризации.МассивМестИнвентаризации;
	МассивМестХранения				= ДиагностикаМестИнвентаризации.МассивМестХранения;
	ЕдинственноеЗначениеТекстовое	= ДиагностикаМестИнвентаризации.ЕдинственноеЗначениеТекстовое;
	ЕстьТекстовые					= ДиагностикаМестИнвентаризации.ЕстьТекстовые;
	ЕстьСсылочные					= ДиагностикаМестИнвентаризации.ЕстьСсылочные;
	
	СписокСотрудников = Новый Массив();
	СписокСотрудников.Добавить(Сотрудник);
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("СписокСотрудников", СписокСотрудников);
	ЗапросПоиск.УстановитьПараметр("СписокМестХранения", МассивМестХранения);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Список всех ЦМО сотрудника
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Ссылка	КАК Ссылка
	|ИЗ
	|	Справочник.ЦМО
	|ГДЕ
	|	Сотрудник В(&СписокСотрудников)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Список ЦМО сотрудника с указанными местами хранения
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СправочникЦМО.Ссылка	КАК Ссылка
	|ИЗ
	|	Справочник.ЦМО КАК СправочникЦМО
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.МестаХранения КАК СправочникМестаХранения
	|		ПО СправочникЦМО.МестоХранения = СправочникМестаХранения.Ссылка
	|		И СправочникМестаХранения.Ссылка В(&СписокМестХранения)
	|		И СправочникЦМО.Сотрудник В(&СписокСотрудников)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Список всех контрагентов сотрудника
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Контрагент	КАК Ссылка
	|ИЗ
	|	Справочник.Сотрудники
	|ГДЕ
	|	Ссылка В(&СписокСотрудников)
	|	И Контрагент <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)";
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатыЗапроса = ЗапросПоиск.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	
	Если ЕстьТекстовые Тогда
		// По всем ЦМО и всем местам хранения сотрудника.
		// Этот список включает в себя любые явно заданные места хранения.
		
		// [0]. Список всех ЦМО сотрудника
		СписокЦМО = РезультатыЗапроса[0].Выгрузить().ВыгрузитьКолонку("Ссылка");;
	Иначе
		// Только по явно указанным местам хранения сотрудника
		
		// [1]. Список ЦМО сотрудника с указанными местами хранения
		СписокЦМО = РезультатыЗапроса[1].Выгрузить().ВыгрузитьКолонку("Ссылка");;
	КонецЕсли;
	
	// [2]. Список всех контрагентов сотрудника
	СписокКонтрагентов	= РезультатыЗапроса[2].Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Результат = Новый Структура();
	Результат.Вставить("СписокЦМО",						СписокЦМО);
	Результат.Вставить("СписокКонтрагентов",			СписокКонтрагентов);
	Результат.Вставить("ДиагностикаМестИнвентаризации",	ДиагностикаМестИнвентаризации);
	
	Возврат Результат;
	
КонецФункции

Процедура КэшироватьДанныеКомиссийРешенияДляДокументаОписи(Форма) Экспорт
	
	КэшНаФорме = Новый Структура();
	
	Если ЭтоАдресВременногоХранилища(Форма.АдресХранилища) Тогда
		КэшНаФорме = ПолучитьИзВременногоХранилища(Форма.АдресХранилища);
	КонецЕсли;
	
	ДокументРешения = Форма.Объект.РешениеОПроведенииИнвентаризации;
	
	ТабличнаяЧастьКомиссии = ДокументРешения.Комиссии;
	
	СведенияКомиссий = ПолучитьСведенияКомиссийДляФормыДокумента(ДокументРешения);
	
	ДеревоАктуальныхКомиссий = СведенияКомиссий.ДеревоАктуальныхКомиссий;
	
	КэшНаФорме.Вставить("ДеревоАктуальныхКомиссий", ДеревоАктуальныхКомиссий);
	
	Форма.АдресХранилища = ПоместитьВоВременноеХранилище(КэшНаФорме, Форма.УникальныйИдентификатор);
	
КонецПроцедуры

#Область ПанелиРаспискиИОписи

// Панель расписки

Процедура НастроитьПанельРаспискиНаФормеОписи(ФормаДокумента) Экспорт
	
	ОписьСсылка = ФормаДокумента.Объект.Ссылка;
	
	ТаблицаНастроек = ИнвентаризацияСервер.ПолучитьТаблицуНастроекОписей61н();
	
	СтрокаТаблицыНастроек = ИнвентаризацияСервер.ПолучитьСтрокуТаблицыНастроекОписей61нПоОписи(ОписьСсылка, ТаблицаНастроек);
	
	ЭлементПанель					= ФормаДокумента.Элементы.ПанельРасписки;
	ЭлементРасписка					= ФормаДокумента.Элементы.ДекорацияРаспискаНадпись;
	ЭлементКомментарийКартинка		= ФормаДокумента.Элементы.ДекорацияРаспискаКомментарийКартинка;
	ЭлементКомментарийТекст			= ФормаДокумента.Элементы.ДекорацияРаспискаКомментарийТекстНадпись;
	ЭлементКомментарийГиперссылка	= ФормаДокумента.Элементы.ДекорацияРаспискаКомментарийГиперссылкаНадпись;
	
	ВидимостьПанелиРасписки = ИнвентаризацияКлиентСервер.ЭтоОбычныйДокументОписи(ФормаДокумента.Объект)
		Или ИнвентаризацияКлиентСервер.ЭтоЗаголовочныйДокументСерииДокументовОписи(ФормаДокумента.Объект);
	
	Расписка				= Неопределено;
	РаспискаПроведена		= Ложь;
	РаспискаПометкаУдаления	= Ложь;
	СписокВыбораКомментарий	= Новый СписокЗначений();
	
	Если ВидимостьПанелиРасписки Тогда
		// Панель расписки видна.
		ЭлементПанель.ЦветФона = ЦветаСтиля.ЦветФонаВнимание;
		
		ЭлементКомментарийКартинка.Видимость	= Ложь;
		ЭлементКомментарийТекст.Видимость		= Ложь;
		ЭлементКомментарийГиперссылка.Видимость	= Ложь;
		
		Если ЗначениеЗаполнено(ОписьСсылка) Тогда
			МассивОписей = Новый Массив();
			МассивОписей.Добавить(ОписьСсылка);
			
			Таблица = ПрочитатьПарыСсылокОписьРасписка(МассивОписей,, ТаблицаНастроек);
			
			ДиагностироватьПарыСсылокОписьРасписка(Таблица);
			
			Поиск = Новый Структура("Источник", ОписьСсылка);
			
			МассивСтрок = Таблица.НайтиСтроки(Поиск);
			
			СтрокаТаблицыДиагностики = МассивСтрок[0];
			
			Расписка = СтрокаТаблицыДиагностики.Приемник;
			
			Если ЗначениеЗаполнено(Расписка) Тогда
				Поиск = Новый Структура("Источник", Расписка);
				
				МассивСтрок = Таблица.НайтиСтроки(Поиск);
				
				Если МассивСтрок.Количество() > 0 Тогда
					СтрокаРасписки = МассивСтрок[0];
					
					ЭлементРасписка.Заголовок = ПолучитьПредставлениеДокументаРасписки(СтрокаРасписки.ИсточникНомерДокумента, СтрокаРасписки.ИсточникДатаДокумента);
					
					РаспискаПроведена = СтрокаРасписки.ИсточникПроведен;
					РаспискаПометкаУдаления	= СтрокаРасписки.ИсточникПометкаУдаления;
				Иначе
					ЭлементРасписка.Заголовок = Строка(Расписка);
					
					ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Расписка, "Проведен,ПометкаУдаления");
					
					РаспискаПроведена = ЗначенияРеквизитов.Проведен;
					РаспискаПометкаУдаления	= ЗначенияРеквизитов.ПометкаУдаления;
				КонецЕсли;
				
				ЭлементРасписка.Доступность = Истина;
				
				Если РаспискаПометкаУдаления Тогда
					ЭлементКомментарийТекст.Заголовок = НСтр("ru='Помечена на удаление'");
					ЭлементКомментарийТекст.Видимость = Истина;
				ИначеЕсли Не РаспискаПроведена Тогда
					ЭлементКомментарийТекст.Заголовок = НСтр("ru='Не проведена'");
					ЭлементКомментарийТекст.Видимость = Истина;
				КонецЕсли;
				
				ШаблонОбнаружено = НСтр("ru=';Также обнаружена еще;;Также обнаружено еще;Также обнаружено еще;Также обнаружено еще'");
			Иначе
				ЭлементРасписка.Заголовок = НСтр("ru='Создать расписку'");
				ЭлементРасписка.Доступность = Истина;
				
				ШаблонОбнаружено = НСтр("ru=';Обнаружена;;Обнаружено;Обнаружено;Обнаружено'");
			КонецЕсли;
			
			ЗаполнитьСписокВыбораКомментарий(СписокВыбораКомментарий, СтрокаТаблицыДиагностики);
			
			КоличествоРасписокВСписке = СписокВыбораКомментарий.Количество();
			
			Если КоличествоРасписокВСписке > 0 Тогда
				ТекстОбнаружено = СтрокаСЧислом(ШаблонОбнаружено,
				    КоличествоРасписокВСписке,
				    ВидЧисловогоЗначения.Количественное,
				    "L=ru");

				ТекстКоличествоРасписок = СтрокаСЧислом(НСтр("ru=';%1 расписка;;%1 расписки;%1 расписок;%1 расписок'"),
				    КоличествоРасписокВСписке,
				    ВидЧисловогоЗначения.Количественное,
				    "L=ru");
				
				ЭлементКомментарийГиперссылка.Заголовок = СтрШаблон(НСтр("ru='%1 %2 к этому документу описи'"), ТекстОбнаружено, ТекстКоличествоРасписок);
				
				ЭлементКомментарийКартинка.Видимость = Истина;
				ЭлементКомментарийГиперссылка.Видимость = Истина;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Расписка) И РаспискаПроведена И КоличествоРасписокВСписке = 0 Тогда
				ЭлементПанель.ЦветФона = ЦветаСтиля.ЦветФонаБлоковИнформационнойПанели;
			КонецЕсли;
			
		Иначе
			
			Если НоваяПанельРасписки(ОписьСсылка) Тогда
				ЭлементРасписка.Заголовок = НСтр("ru='Создать расписку (документ будет записан)'");
			Иначе
				ЭлементРасписка.Заголовок = НСтр("ru='Создать расписку (доступно после записи документа описи)'");
				ЭлементРасписка.Доступность = Ложь;
			КонецЕсли;
		КонецЕсли;
	Иначе
		// Панель расписки не видна.
		ЭлементПанель.Видимость = Ложь;
	КонецЕсли;
	
	ДанныеПанелиРасписки = Новый Структура();
	ДанныеПанелиРасписки.Вставить("Расписка",					Расписка);
	ДанныеПанелиРасписки.Вставить("РаспискаПроведена",			РаспискаПроведена);
	ДанныеПанелиРасписки.Вставить("РаспискаПометкаУдаления",	РаспискаПометкаУдаления);
	ДанныеПанелиРасписки.Вставить("СписокВыбораКомментарий",	СписокВыбораКомментарий);
	ДанныеПанелиРасписки.Вставить("СтрокаТаблицыНастроек",		СтрокаТаблицыНастроек);
	ДанныеПанелиРасписки.Вставить("ОписаниеОписиИзТаблицыНастроекЗаполненияОписейПоРешению",
		ПолучитьОписаниеОписиИзТаблицыНастроекЗаполненияОписейПоРешению(ОписьСсылка,
			ФормаДокумента.Объект.Организация));
	
	ФормаДокумента.ДанныеПанелиРасписки = Новый ФиксированнаяСтруктура(ДанныеПанелиРасписки);
	
КонецПроцедуры

// Панель описи

Процедура НастроитьПанельОписиНаФормеРасписки(ФормаДокумента) Экспорт
	
	ЭлементПанель					= ФормаДокумента.Элементы.ПанельОписи;
	ЭлементКомментарийКартинка		= ФормаДокумента.Элементы.ДекорацияОписьКомментарийКартинка;
	ЭлементКомментарийТекст			= ФормаДокумента.Элементы.ДекорацияОписьКомментарийТекстНадпись;
	ЭлементКомментарийГиперссылка	= ФормаДокумента.Элементы.ДекорацияОписьКомментарийГиперссылкаНадпись;
	
	ЭлементПанель.ЦветФона = ЦветаСтиля.ЦветФонаВнимание;
	
	ЭлементКомментарийКартинка.Видимость	= Ложь;
	ЭлементКомментарийТекст.Видимость		= Ложь;
	ЭлементКомментарийГиперссылка.Видимость	= Ложь;
	
	Объект = ФормаДокумента.Объект;
	
	РаспискаСсылка = Объект.Ссылка;
	
	Если Не ЗначениеЗаполнено(РаспискаСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаНастроек = ИнвентаризацияСервер.ПолучитьТаблицуНастроекОписей61н();
	
	МассивРасписок = Новый Массив();
	МассивРасписок.Добавить(РаспискаСсылка);
	
	Таблица = ПрочитатьПарыСсылокОписьРасписка(, МассивРасписок, ТаблицаНастроек);
	
	ДиагностироватьПарыСсылокОписьРасписка(Таблица);
	
	Поиск = Новый Структура("Источник", РаспискаСсылка);
	
	МассивСтрок = Таблица.НайтиСтроки(Поиск);
	
	СтрокаТаблицыДиагностики = МассивСтрок[0];
	
	Опись = СтрокаТаблицыДиагностики.Приемник;
	
	Если ЗначениеЗаполнено(Опись) Тогда
		Если Не СтрокаТаблицыДиагностики.ИсточникПометкаУдаления И Не СтрокаТаблицыДиагностики.ЕстьВзаимнаяСсылка Тогда
			ЭлементКомментарийКартинка.Видимость = Истина;
			
			ЭлементКомментарийТекст.Заголовок = НСтр("ru='Эта расписка не является основной для документа описи'");
			ЭлементКомментарийТекст.Видимость = Истина;
		КонецЕсли;
		
		ШаблонОбнаружено = НСтр("ru=';Также обнаружена еще;;Также обнаружено еще;Также обнаружено еще;Также обнаружено еще'");
	Иначе
		ШаблонОбнаружено = НСтр("ru=';Обнаружена;;Обнаружено;Обнаружено;Обнаружено'");
	КонецЕсли;
	
	СписокВыбораКомментарий = Новый СписокЗначений();
	
	ЗаполнитьСписокВыбораКомментарий(СписокВыбораКомментарий, СтрокаТаблицыДиагностики);
	
	КоличествоОписейВСписке = СписокВыбораКомментарий.Количество();
	
	Если КоличествоОписейВСписке > 0 Тогда
		ТекстОбнаружено = СтрокаСЧислом(ШаблонОбнаружено,
		    КоличествоОписейВСписке,
		    ВидЧисловогоЗначения.Количественное,
		    "L=ru");

		ТекстКоличествоОписей = СтрокаСЧислом(НСтр("ru=';%1 опись;;%1 описи;%1 описей;%1 описей'"),
		    КоличествоОписейВСписке,
		    ВидЧисловогоЗначения.Количественное,
		    "L=ru");
		
		ЭлементКомментарийГиперссылка.Заголовок = СтрШаблон(НСтр("ru='%1 %2 к этому документу расписки'"), ТекстОбнаружено, ТекстКоличествоОписей);
		
		ЭлементКомментарийКартинка.Видимость = Истина;
		ЭлементКомментарийГиперссылка.Видимость = Истина;
	КонецЕсли;
	
	Если СтрокаТаблицыДиагностики.ЕстьВзаимнаяСсылка И КоличествоОписейВСписке = 0 Тогда
		ЭлементПанель.ЦветФона = ЦветаСтиля.ЦветФонаБлоковИнформационнойПанели;
	КонецЕсли;
	
	ДанныеПанелиОписи = Новый Структура();
	ДанныеПанелиОписи.Вставить("СписокВыбораКомментарий", СписокВыбораКомментарий);
	
	ФормаДокумента.ДанныеПанелиОписи = Новый ФиксированнаяСтруктура(ДанныеПанелиОписи);
	
КонецПроцедуры

#КонецОбласти

#Область ОтборСчетовИКФО

Функция ПолучитьНастройкиОтбораСчетовИКФО(ТаблицаСписокСчетов, ДатаИнвентаризации) Экспорт
	
	НаДату = ИнвентаризацияКлиентСервер.ПолучитьДатуСрезаРегистровСведенийНакопления(ДатаИнвентаризации);
	
	КоличествоРодителейСчетов = 4;
	
	ВремТаблица = ТаблицаСписокСчетов.Скопировать(,"Счет");
	ВремТаблица.Свернуть("Счет");
	СписокСчетов = ВремТаблица.ВыгрузитьКолонку("Счет");
	
	СписокСчетов = БухгалтерскийУчет.СписокСчетов(СписокСчетов, НаДату);
	
	ВремТаблица = ТаблицаСписокСчетов.Скопировать(,"КФО");
	ВремТаблица.Свернуть("КФО");
	СписокКФО = ВремТаблица.ВыгрузитьКолонку("КФО");
	
	ИспользоватьОтборПоКФО = (СписокКФО.Найти(Перечисления.КВД.ПустаяСсылка()) = Неопределено);
	
	ДетальнаяТаблицаИсключаемыеСчета = Новый ТаблицаЗначений();
	ДетальнаяТаблицаИсключаемыеСчета.Колонки.Добавить("КФО",	Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ДетальнаяТаблицаИсключаемыеСчета.Колонки.Добавить("Счет",	Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	
	ПолныйСписокКФО = Новый Массив();
	
	Для Каждого Значение Из Перечисления.КВД Цикл
		ПолныйСписокКФО.Добавить(Значение);
	КонецЦикла;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ПоискСчет",					Новый Структура("Счет"));
	ДополнительныеПараметры.Вставить("ПоискСсылка",					Новый Структура("Ссылка"));
	ДополнительныеПараметры.Вставить("КоличествоРодителейСчетов",	КоличествоРодителейСчетов);
	
	РодителиСчетов = ИнвентаризацияСервер.ПолучитьРодителейСчетов(СписокСчетов, КоличествоРодителейСчетов);
	
	Для Каждого Счет Из СписокСчетов Цикл
		Если Не ЗначениеЗаполнено(Счет) Тогда
			Продолжить;
		КонецЕсли;
		
		ПрименяемыеЗначенияКФО = ОпределитьПрименяемыеЗначенияКФО(Счет, ТаблицаСписокСчетов, РодителиСчетов, ДополнительныеПараметры);
		
		Если ПрименяемыеЗначенияКФО.Количество() = 0 Тогда
			// Явных значений КФО не указано, применяется КФО0
			Продолжить;
		КонецЕсли;
		
		НеПрименяемыеЗначенияКФО = ОпределитьНеПрименяемыеЗначенияКФО(ПрименяемыеЗначенияКФО, ПолныйСписокКФО);
		
		Для Каждого КФО Из НеПрименяемыеЗначенияКФО Цикл
			НоваяСтрока = ДетальнаяТаблицаИсключаемыеСчета.Добавить();
			НоваяСтрока.Счет = Счет;
			НоваяСтрока.КФО = КФО;
		КонецЦикла;
	КонецЦикла;
	
	НастройкиОтбора = Новый Структура();
	НастройкиОтбора.Вставить("ИспользоватьОтборПоКФО",				ИспользоватьОтборПоКФО);
	НастройкиОтбора.Вставить("СписокКФО",							СписокКФО);
	НастройкиОтбора.Вставить("СписокСчетов",						СписокСчетов);
	НастройкиОтбора.Вставить("ДетальнаяТаблицаИсключаемыеСчета",	ДетальнаяТаблицаИсключаемыеСчета);
	
	Возврат НастройкиОтбора;
	
КонецФункции

#КонецОбласти

Функция ПолучитьТекстЗаключенияКомиссииПоОписи(ЗаключениеКомиссииСсылка) Экспорт
	
	Если Не ЗначениеЗаполнено(ЗаключениеКомиссииСсылка) Тогда
		Возврат "";
	КонецЕсли;
	
	СвойстваЭлемента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЗаключениеКомиссииСсылка, "Наименование,НаименованиеПолное");
	
	Если ЗначениеЗаполнено(СвойстваЭлемента.НаименованиеПолное) Тогда
		Возврат СвойстваЭлемента.НаименованиеПолное;
	Иначе
		Возврат СвойстваЭлемента.Наименование;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьТекстМестаИнвентаризации(МестоИнвентаризацииСсылка) Экспорт
	
	Если Не ЗначениеЗаполнено(МестоИнвентаризацииСсылка) Тогда
		Возврат "";
	КонецЕсли;
	
	СвойстваЭлемента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(МестоИнвентаризацииСсылка, "Наименование,НаименованиеПолное");
	
	Если ЗначениеЗаполнено(СвойстваЭлемента.НаименованиеПолное) Тогда
		Возврат СвойстваЭлемента.НаименованиеПолное;
	Иначе
		Возврат СвойстваЭлемента.Наименование;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьТекстЗаключенияКомиссииОтклоненияНеВыявлены(ОписьСсылка) Экспорт
	
	СтрокаТаблицыНастроек = ПолучитьСтрокуТаблицыНастроекОписей61нПоОписи(ОписьСсылка);
	
	КодФормыОписи = СтрокаТаблицыНастроек.КодФормы;
	
	Если Не ЗначениеЗаполнено(КодФормыОписи) Тогда
		Возврат "";
	КонецЕсли;
	
	ПредопределенныеЗначения = СтандартныеПодсистемыПовтИсп.СсылкиПоИменамПредопределенных(
		"Справочник.ЗаключенияКомиссииПоИнвентаризационнымОписям");
	
	ИмяПредопределенныхДанных = "ОтклоненияНеВыявлены" + Строка(КодФормыОписи);
	ЗаключениеКомиссииСсылка = ПредопределенныеЗначения.Получить(ИмяПредопределенныхДанных);
	
	Если ЗначениеЗаполнено(ЗаключениеКомиссииСсылка) Тогда
		Возврат ПолучитьТекстЗаключенияКомиссииПоОписи(ЗаключениеКомиссииСсылка);
	Иначе
		Возврат СтрокаТаблицыНастроек.ЗаключениеКомиссииОтклоненияНеУстановлены;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьПустуюТаблицуТабличнойЧасти(МетаданныеТабличнойЧасти) Экспорт
	
	Таблица = Новый ТаблицаЗначений();
	
	Для Каждого Реквизит Из МетаданныеТабличнойЧасти.Реквизиты Цикл
		Таблица.Колонки.Добавить(Реквизит.Имя, Новый ОписаниеТипов(Реквизит.Тип.Типы()));
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

Процедура ДобавитьКолонкиДоПолногоСоставаТабличнойЧасти(Таблица, МетаданныеТабличнойЧасти) Экспорт
	
	ТаблицаШаблон = ПолучитьПустуюТаблицуТабличнойЧасти(МетаданныеТабличнойЧасти);
	
	Для Каждого Колонка Из ТаблицаШаблон.Колонки Цикл
		ИмяКолонки = Колонка.Имя;
		
		Если Таблица.Колонки.Найти(ИмяКолонки) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Таблица.Колонки.Добавить(ИмяКолонки, Новый ОписаниеТипов(Колонка.ТипЗначения));
	КонецЦикла;
	
КонецПроцедуры

Процедура ИсключитьТипNullВКолонкахТаблицы(Таблица, ИменаКолонок) Экспорт
	
	Если ТипЗнч(ИменаКолонок) = Тип("Строка") Тогда
		СписокИмен = СтрРазделить(ИменаКолонок, ",", Ложь);
	Иначе
		СписокИмен = ИменаКолонок;
	КонецЕсли;
	
	Для Каждого ИмяКолонки Из СписокИмен Цикл
	    ТипКолонки = Таблица.Колонки[ИмяКолонки].ТипЗначения;
		
		Если Не ТипКолонки.СодержитТип(Тип("Null")) Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяВременнойКолонки = "ВременнаяКолонка" + СтрЗаменить(Строка(Новый УникальныйИдентификатор()), "-", "_");
		
	    Таблица.Колонки[ИмяКолонки].Имя = ИмяВременнойКолонки;
	    
	    Таблица.Колонки.Добавить(ИмяКолонки, Новый ОписаниеТипов(ТипКолонки, , "Null"));
		
	    Таблица.ЗагрузитьКолонку(Таблица.ВыгрузитьКолонку(ИмяВременнойКолонки), ИмяКолонки);

	    Таблица.Колонки.Удалить(ИмяВременнойКолонки);
	КонецЦикла;
	
КонецПроцедуры

// СерииДокументов
Процедура УстановитьОграниченияИспользованияПоляНомерДокументаСерииДокументов(ФормаДокумента) Экспорт
	
	// Обход ошибки платформы 60012313
	
	Список = ФормаДокумента.Список;
	
	Поля = Новый Массив();
	Поля.Добавить("НомерДокументаСерииДокументов");
	
	Список.УстановитьОграниченияИспользованияВГруппировке(Поля);
	Список.УстановитьОграниченияИспользованияВПорядке(Поля);
	Список.УстановитьОграниченияИспользованияВОтборе(Поля);
	
КонецПроцедуры

Процедура ПриПолученииДанныхНаСервереНомерДокументаСерииДокументов(ИмяЭлемента, Настройки, Строки) Экспорт
	
	// Обход ошибки платформы 60012313
	
	Для Каждого Элемент Из Строки Цикл
		Данные = Элемент.Значение.Данные;
		
		Если Не ЗначениеЗаполнено(Данные.ИдентификаторСерииДокументов) Тогда
			НомерДокументаСерииДокументов = "";
		ИначеЕсли Данные.ЭтоЗаголовочныйДокумент ТОГДА
			НомерДокументаСерииДокументов = Данные.Номер;
		Иначе
			НомерДокументаСерииДокументов = Данные.НомерЗаголовочногоДокумента
				+ "/" + Формат(Данные.ПорядковыйНомерДокументаВСерииДокументов, "ЧГ=0");
		КонецЕсли;
		
		Данные.НомерДокументаСерииДокументов = НомерДокументаСерииДокументов;
	КонецЦикла;
	
КонецПроцедуры
// Конец СерииДокументов

#Область ПодборКомиссииДляОписи52н

// Читает данные из описи 52н, Решения, сопоставляет их и определяет подходящие комиссии и их составы
// с учетом рабочих комиссий. Комиссии выбираются из указанных для описи в указанном Решении.
// Сопоставление выполняется по значениям реквизитов описи и раздела 1 Решения.
//
// Параметры:
//	Опись52н	- ДокументСсылка	- опись приказа 52н. Из этой описи выбираются сведения о комиссии и ее составе.
//	РешениеОПроведенииИнвентаризации	- ДокументСсылка.РешениеОПроведенииИнвентаризации
//										Из этого Решения будут определяться комиссии, назначенные указанной описи.
//	НастройкиСравнения	- Структура	- см. ИнвентаризацияСервер.ПолучитьНастройкиСравненияКомиссий52н()
//
// Возвращаемое значение:
//	ТаблицаЗначений	- подходящие комиссии и их составы. См. ПолучитьПустуюТаблицуКомиссийНазначенныхРешениемДляОписи52н().
//	 * КомиссияСсылка		- СправочникСсылка.ПостоянноДействующиеКомиссии
//	 * НомерКомиссии		- Число
//	 * НомерРабочейКомиссии	- Число
//	 * СоставКомиссии		- ТаблицаЗначений	- состав комиссии, каким он бы заполнился для документа 61н.
Функция НайтиПодходящиеКомиссииДляОписи52н(Опись52н, РешениеОПроведенииИнвентаризации, НастройкиСравнения) Экспорт
	
	ТаблицаКомиссий = ПолучитьПустуюТаблицуКомиссийНазначенныхРешениемДляОписи52н();
	
	Если Не ЗначениеЗаполнено(Опись52н) Или Не ЗначениеЗаполнено(РешениеОПроведенииИнвентаризации) Тогда
		Возврат ТаблицаКомиссий;
	КонецЕсли;
	
	Данные = ПрочитатьКомиссииНазначенныеРешениемДляОписи52н(Опись52н, РешениеОПроведенииИнвентаризации, ТаблицаКомиссий);
	
	Если Данные = Неопределено Тогда
		// Решение аннулировано.
		Возврат ТаблицаКомиссий;
	КонецЕсли;
	
	МассивСтрок = Новый Массив();
	
	Для Каждого СтрокаКомиссии Из Данные.ТаблицаКомиссий Цикл
		Если КомиссииСовпадают(Данные, СтрокаКомиссии, НастройкиСравнения) Тогда
			МассивСтрок.Добавить(СтрокаКомиссии);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Данные.ТаблицаКомиссий.Скопировать(МассивСтрок);
	
КонецФункции

// Определяет первую по счету подходящую комиссию. См. НайтиПодходящиеКомиссииДляОписи52н().
//
// Возвращаемое значение:
//	Структура
Функция НайтиПодходящуюКомиссиюДляОписи52н(Опись52н, РешениеОПроведенииИнвентаризации, НастройкиСравнения = Неопределено) Экспорт
	
	ПодходящаяКомиссия = Новый Структура("
		|КомиссияСсылка,
		|НомерКомиссии,
		|НомерРабочейКомиссии,
		|СоставКомиссии");
	
	Если НастройкиСравнения = Неопределено Тогда
		НастройкиСравнения = ИнвентаризацияСервер.ПолучитьНастройкиСравненияКомиссий52н();
	КонецЕсли;
	
	ТаблицаКомиссий = ИнвентаризацияСервер.НайтиПодходящиеКомиссииДляОписи52н(Опись52н, РешениеОПроведенииИнвентаризации, НастройкиСравнения);
	
	Если ТаблицаКомиссий.Количество() > 0 Тогда
		ЗаполнитьЗначенияСвойств(ПодходящаяКомиссия, ТаблицаКомиссий[0]);
	КонецЕсли;
	
	Возврат ПодходящаяКомиссия;
	
КонецФункции

Функция ПолучитьНастройкиСравненияКомиссий52н() Экспорт
	
	НастройкиСравнения = Новый Структура();
	НастройкиСравнения.Вставить("СравнитьПриказыОКомиссии",	Истина);
	НастройкиСравнения.Вставить("СравнитьПредседателей",	Истина);
	НастройкиСравнения.Вставить("СравнитьСоставыКомиссий",	Истина);
	
	Возврат НастройкиСравнения;
	
КонецФункции

#КонецОбласти

#Область РасчетИзлишковНедостачи

Функция ПолучитьПараметрыРасчетаИзлишковНедостачи() Экспорт
	
	КолонкиКодСтроки = Новый Структура();
	КолонкиКодСтроки.Вставить("ИмяКолонкиТаблицыИзлишкиНедостача",	"");
	КолонкиКодСтроки.Вставить("ИмяКолонкиТаблицыФакт",				"");
	КолонкиКодСтроки.Вставить("ИмяКолонкиТаблицыУчет",				"");
	
	ПараметрыРасчета = Новый Структура();
	ПараметрыРасчета.Вставить("ПовторитьТаблицуУчет",	Ложь);
	ПараметрыРасчета.Вставить("ЭтоОписьНФА",			Ложь);
	ПараметрыРасчета.Вставить("КолонкиКодСтроки",		КолонкиКодСтроки);
	ПараметрыРасчета.Вставить("ЭтоОпись0510465",		Ложь);
	
	Возврат ПараметрыРасчета;
	
КонецФункции

// В переданных таблицах ТаблицаУчет, ТаблицаФакт должно быть обеспечено отсутствие дублей строк по колонкам связи.
// Иначе расчет излишков и недостач будет неверным и будет содержать дубли строк по колонкам связи.
//
//	ПараметрыРасчета	- Структура	- см. функцию ПолучитьПараметрыРасчетаИзлишковНедостачи()
Процедура РассчитатьИзлишкиНедостачу(ТаблицаУчет, ТаблицаФакт, ТаблицаИзлишкиНедостача, КолонкиСвязи, КолонкиПоказателей, ПараметрыРасчета) Экспорт
	
	ПараметрыОбработки = ПолучитьПараметрыОбработкиИзлишковНедостачи(КолонкиСвязи, КолонкиПоказателей, ПараметрыРасчета);
	
	ДобавитьСлужебныеКолонкиДляРасчетаИзлишковНедостачи(ТаблицаУчет, ТаблицаФакт);
	
	//
	// Обходим таблицу учета
	//
	КолонкиПоиска = ПараметрыОбработки.КолонкиСвязиСтрокой;
	
	ПараметрыОбработки.Поиск = Новый Структура(КолонкиПоиска);
	
	ТаблицаФакт.Индексы.Добавить(КолонкиПоиска);
	
	ОбойтиТаблицуДляПоискаИзлишковНедостачи(ТаблицаУчет, ТаблицаФакт, ТаблицаИзлишкиНедостача, ПараметрыОбработки, Истина);
	
	//
	// Обходим таблицу факта
	//
	КолонкиПоиска = ПараметрыОбработки.КолонкиСвязиСтрокой + "," + ПараметрыОбработки.ИменаСлужебныхКолонок.СтрокаОбработана;
	
	Поиск = Новый Структура(КолонкиПоиска);
	Поиск[ПараметрыОбработки.ИменаСлужебныхКолонок.СтрокаОбработана] = Ложь;
	
	ПараметрыОбработки.Поиск = Поиск;
	
	ТаблицаУчет.Индексы.Добавить(КолонкиПоиска);
	ТаблицаФакт.Индексы.Добавить(КолонкиПоиска);
	
	ПоискСтрокаНеОбработана = Новый Структура(ПараметрыОбработки.ИменаСлужебныхКолонок.СтрокаОбработана, Ложь);
	
	МассивСтрокТаблицыФакт = ТаблицаФакт.НайтиСтроки(ПоискСтрокаНеОбработана);
	
	ОбойтиТаблицуДляПоискаИзлишковНедостачи(ТаблицаУчет, МассивСтрокТаблицыФакт, ТаблицаИзлишкиНедостача, ПараметрыОбработки, Ложь);
	
	
КонецПроцедуры

#КонецОбласти

#Область ОтборПоПодразделению

// Для документов Решение, ИзменениеРешения.

Процедура НастроитьОтборПоПодразделениюНаФормеРешения(ФормаДокумента) Экспорт
	
	Объект = ФормаДокумента.Объект;
	
	Если НеобходимКонтрольОтбораПоПодразделению(Объект.Подразделение) Тогда
		СписокЗаполненныхСчетов = ПолучитьСписокУникальныхЗаполненныхСчетовИзРешения(Объект.Объекты);
		
		НаДату = ПолучитьДатуОпределенияПримененияСчетовОтборПоПодразделению(Объект.Дата);
		
		СписокСчетов = НайтиСчетаБезУчетаПоПодразделениям(СписокЗаполненныхСчетов, НаДату);
	Иначе
		СписокСчетов = Новый Массив();
	КонецЕсли;
	
	ФормаДокумента.Элементы.ДекорацияПодразделение.Видимость = (СписокСчетов.Количество() > 0);
	
	ФормаДокумента.СообщениеОтбораПоПодразделению = Новый ФорматированнаяСтрока(
		ПолучитьСообщениеОтбораПоПодразделениюДляРешения(СписокСчетов));
	
	УстановитьПредустановленныйОтборСчетаУчетПоПодразделениям(ФормаДокумента);
	
КонецПроцедуры

Процедура ОчиститьСчетаБезУчетаПоПодразделениямНаФормеРешения(ФормаДокумента) Экспорт
	
	// В Решении может быть указан счет-группа, у которого есть субсчет без учета по подразделениям.
	// Такой счет-группа тоже очищается, даже если у него включен учет по подразделениям.
	
	Объект = ФормаДокумента.Объект;
	
	НаДату = ПолучитьДатуОпределенияПримененияСчетовОтборПоПодразделению(Объект.Дата);
	
	СписокСчетовДокумента = ПолучитьСписокУникальныхЗаполненныхСчетовИзРешения(Объект.Объекты);
	
	ИсключаемыеСчетаИзНастроек = ПолучитьИсключаемыеСчетаВсехОписейИзНастроек(ФормаДокумента.ТаблицаНастроекЗаполненияОписейПоРешению);
	
	ТаблицаСтрок = НайтиСтрокиСоСчетамиБезУчетаПоПодразделениям(Объект.Объекты, СписокСчетовДокумента, ИсключаемыеСчетаИзНастроек, НаДату);
	
	ОчищающаяСтруктура = Новый Структура("Счет");
	
	Для Каждого СтрокаТаблицы Из ТаблицаСтрок Цикл
		СтрокаТЧОбъекты = Объект.Объекты[СтрокаТаблицы.ИндексСтроки];
		
		ЗаполнитьЗначенияСвойств(СтрокаТЧОбъекты, ОчищающаяСтруктура);
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьНаличиеСчетовБезУчетаПоПодразделениямДокументаРешения(Знач ДокументОбъект, Отказ, Знач ПараметрыПроверкиЗаполнения) Экспорт
	
	Если Не НеобходимКонтрольОтбораПоПодразделению(ДокументОбъект.Подразделение,
		ПараметрыПроверкиЗаполнения.ИспользоватьУчетПоПодразделениям) Тогда
		
		Возврат;
	КонецЕсли;
	
	НаДату = ПолучитьДатуОпределенияПримененияСчетовОтборПоПодразделению(ДокументОбъект.Дата);
	
	СписокСчетовДокумента = ПолучитьСписокУникальныхЗаполненныхСчетовИзРешения(ДокументОбъект.Объекты);
	
	ИсключаемыеСчетаИзНастроек = ПолучитьИсключаемыеСчетаВсехОписейИзНастроек(ПараметрыПроверкиЗаполнения.ТаблицаНастроек);
	
	ТаблицаСтрок = НайтиСтрокиСоСчетамиБезУчетаПоПодразделениям(ДокументОбъект.Объекты, СписокСчетовДокумента, ИсключаемыеСчетаИзНастроек, НаДату);
	
	ТекстШаблон = НСтр("ru='%1, однако в шапке документа подразделение заполнено.'");
	
	Для Каждого СтрокаТаблицы Из ТаблицаСтрок Цикл
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон(ТекстШаблон, СтрокаТаблицы.Описание),
			ДокументОбъект.Ссылка,
			ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Объекты", СтрокаТаблицы.ИндексСтроки + 1, "Счет"),
			"Объект", Отказ);
	КонецЦикла;
	
КонецПроцедуры

// Для документов описей.

Процедура НастроитьОтборПоПодразделениюНаФормеОписи(ФормаДокумента) Экспорт
	
	Объект = ФормаДокумента.Объект;
	
	Если НеобходимКонтрольОтбораПоПодразделению(Объект.Подразделение) Тогда
		СпискиСчетов = ПолучитьСпискиСчетовИзОписиДляПроверкиОтбораПоПодразделению(Объект);
		
		НаДату = ПолучитьДатуОпределенияПримененияСчетовОтборПоПодразделению(Объект.Дата);
		
		СписокСчетов = НайтиСчетаБезУчетаПоПодразделениям(СпискиСчетов.СчетаЗаполнения, СпискиСчетов.СчетаИсключения, НаДату);
	Иначе
		СписокСчетов = Новый Массив();
	КонецЕсли;
	
	ФормаДокумента.Элементы.ДекорацияПодразделение.Видимость = (СписокСчетов.Количество() > 0);
	
	ФормаДокумента.СообщениеОтбораПоПодразделению = Новый ФорматированнаяСтрока(
		ПолучитьСообщениеОтбораПоПодразделениюДляОписи(ФормаДокумента, СписокСчетов));
	
КонецПроцедуры

Процедура ПроверитьНаличиеСчетовБезУчетаПоПодразделениямДокументаОписи(Знач ДокументОбъект, Отказ, Знач ИмяЭлементаНадписиПредставлениеСчета = "ПредставлениеСчета") Экспорт
	
	Перем СтрокаТаблицыНастроек, ОписаниеРеквизитаСчет;
	
	Если Не НеобходимКонтрольОтбораПоПодразделению(ДокументОбъект.Подразделение) Тогда
		Возврат;
	КонецЕсли;
	
	СпискиСчетов = ПолучитьСпискиСчетовИзОписиДляПроверкиОтбораПоПодразделению(ДокументОбъект, СтрокаТаблицыНастроек, ОписаниеРеквизитаСчет);
	
	НаДату = ПолучитьДатуОпределенияПримененияСчетовОтборПоПодразделению(ДокументОбъект.Дата);
	
	ТекстШаблон = НСтр("ru='%1, однако в шапке документа подразделение заполнено.'");
	
	Если ОписаниеРеквизитаСчет.Отсутствует Или ОписаниеРеквизитаСчет.РасположенВШапке Тогда
		СписокСчетов = НайтиСчетаБезУчетаПоПодразделениям(СпискиСчетов.СчетаЗаполнения, СпискиСчетов.СчетаИсключения, НаДату);
		
		Если СписокСчетов.Количество() > 0 Тогда
			Если ОписаниеРеквизитаСчет.РасположенВШапке Тогда
				СчетЗаполнения = ДокументОбъект[ОписаниеРеквизитаСчет.ИмяПоля];
				
			ИначеЕсли ОписаниеРеквизитаСчет.Отсутствует Тогда
				СчетЗаполнения = СтрокаТаблицыНастроек.ТаблицаКодовСчетов[0].СсылкиСчетов[0];
			КонецЕсли;
			
			Если СписокСчетов.Найти(СчетЗаполнения) <> Неопределено Тогда
				ТекстСчет = СтрШаблон(НСтр("ru='На счете %1'"), Строка(СчетЗаполнения));
			Иначе
				ТекстСчет = СтрШаблон(НСтр("ru='На субсчете %1'"), Строка(СписокСчетов[0]));
			КонецЕсли;
			
			Описание = СтрШаблон(НСтр("ru='%1 не ведется учет по подразделениям'"), ТекстСчет);
			
			Если ЗначениеЗаполнено(ИмяЭлементаНадписиПредставлениеСчета) Тогда
				Поле = ИмяЭлементаНадписиПредставлениеСчета;
				ПутьКДанным = "";
			Иначе
				Поле = ОписаниеРеквизитаСчет.ИмяПоля;
				ПутьКДанным = "Объект";
			КонецЕсли;
			
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон(ТекстШаблон, Описание),
				ДокументОбъект.Ссылка,
				Поле,
				ПутьКДанным, Отказ);
		КонецЕсли;
		
	ИначеЕсли ОписаниеРеквизитаСчет.РасположенВТабличнойЧасти Тогда
		ТаблицаСтрок = НайтиСтрокиСоСчетамиБезУчетаПоПодразделениям(
			ДокументОбъект[ОписаниеРеквизитаСчет.ИмяТабличнойЧасти], СпискиСчетов.СчетаЗаполнения, СпискиСчетов.СчетаИсключения, НаДату);
		
		Для Каждого СтрокаТаблицы Из ТаблицаСтрок Цикл
			ПутьКТабличнойЧасти = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(
				ОписаниеРеквизитаСчет.ИмяТабличнойЧасти,
				СтрокаТаблицы.ИндексСтроки + 1,
				ОписаниеРеквизитаСчет.ИмяКолонки);
			
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон(ТекстШаблон, СтрокаТаблицы.Описание),
				ДокументОбъект.Ссылка,
				ПутьКТабличнойЧасти,
				"Объект", Отказ);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

