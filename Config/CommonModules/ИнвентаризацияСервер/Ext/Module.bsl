Процедура РаспечататьПриНеобходимости0504087(ВидДокумента,
	
	// Все стандартные параметры обработчика Печать() библиотеки БСП
	МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	ИмяМакетаСФактическимНаличием	= "Форма0504087_ФактНаличие";
	ИмяМакетаБезФактическогоНаличия	= "Форма0504087";
	
	НужноПечататьСФактическимНаличием	= УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, ИмяМакетаСФактическимНаличием);
	НужноПечататьБезФактическогоНаличия	= УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, ИмяМакетаБезФактическогоНаличия);
	
	Если НЕ НужноПечататьСФактическимНаличием И НЕ НужноПечататьБезФактическогоНаличия Тогда
		Возврат;
	КонецЕсли;
	
	ПрименяемыеПечатныеФормы = ОпределитьПрименяемыеПечатныеФормы_194н(МассивОбъектов, ВидДокумента);
	
	Ссылки52н	= ПрименяемыеПечатныеФормы["Ссылки52н"];
	Ссылки194н	= ПрименяемыеПечатныеФормы["Ссылки194н"];
	
	ТабличныеДокументы = Новый Соответствие();
	
	//
	// Печатная форма в редакции Приказа 52н
	//
	Если Ссылки52н.Количество() > 0 Тогда
		
		ТабДокумент = Документы[ВидДокумента].ПечатьФормы0504087(Ссылки52н, ОбъектыПечати, НужноПечататьСФактическимНаличием);
		
		ТабличныеДокументы.Вставить("52н", ТабДокумент);
		
	КонецЕсли;
	
	//
	// Печатная форма в редакции Приказа 194н
	//
	Если Ссылки194н.Количество() > 0 Тогда
		
		ПараметрыБСП = Новый Структура();
		ПараметрыБСП.Вставить("МассивОбъектов",			МассивОбъектов);
		ПараметрыБСП.Вставить("ПараметрыПечати",		ПараметрыПечати);
		ПараметрыБСП.Вставить("КоллекцияПечатныхФорм",	КоллекцияПечатныхФорм);
		ПараметрыБСП.Вставить("ОбъектыПечати",			ОбъектыПечати);
		ПараметрыБСП.Вставить("ПараметрыВывода",		ПараметрыВывода);
		
		НастройкиВывода = Новый Структура();
		
		Если ВидДокумента = "ИнвентаризацияМЗ" Тогда
			НастройкиВывода.Вставить("КоличествоЗнаковПослеЗапятойДляКоличества", 3);
			
		ИначеЕсли ВидДокумента = "ИнвентаризацияОС" Тогда
			НастройкиВывода.Вставить("КоличествоЗнаковПослеЗапятойДляКоличества", 0);
			
		ИначеЕсли ВидДокумента = "ИнвентаризацияИК" Тогда
			// Количество знаков не задаем явно, оно определяется для каждого документа индивидуально
		КонецЕсли;
		
		ВыборкиДляПечати = Документы[ВидДокумента].Печать0504087_194н_ПолучитьВыборкиДляПечати(Ссылки194н);
		
		ТабДокумент = Печать0504087_194н(ВыборкиДляПечати, НужноПечататьСФактическимНаличием, ПараметрыБСП, НастройкиВывода);
		
		ТабличныеДокументы.Вставить("194н", ТабДокумент);
		
	КонецЕсли;
	
	// Порядок вывода версий печатных форм
	ПорядокВывода = Новый Массив();
	ПорядокВывода.Добавить("52н");
	ПорядокВывода.Добавить("194н");
	
	ОбщийТабличныйДокумент = Неопределено;
	
	Для Каждого ВерсияПечатнойФормы Из ПорядокВывода Цикл
		
		ПечатнаяФорма = ТабличныеДокументы.Получить(ВерсияПечатнойФормы);
		
		Если ПечатнаяФорма = Неопределено Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		Если ОбщийТабличныйДокумент = Неопределено Тогда
			
			ОбщийТабличныйДокумент = ПечатнаяФорма;
			
		Иначе
			
			ОбщийТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			
			ОбщийТабличныйДокумент.Вывести(ПечатнаяФорма);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ИмяМакета = ?(НужноПечататьСФактическимНаличием,
		ИмяМакетаСФактическимНаличием,
		ИмяМакетаБезФактическогоНаличия);
		
	УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
		КоллекцияПечатныхФорм,
		ИмяМакета,
		"Инвентаризационная опись по объектам НФА (ф. 0504087)",
		ОбщийТабличныйДокумент);
	
КонецПроцедуры

Функция ПолучитьОписаниеМОЛ(ВыборкаШапка) Экспорт
	
	МОЛ			= ВыборкаШапка["МОЛ"];
	Дата		= ВыборкаШапка["ДатаИнвентаризации"];
	Организация	= ВыборкаШапка["Организация"];
	
	МОЛДолжность	= "";
	МОЛКраткоеФИО	= "";
	МОЛПолноеФИО	= "";
	
	Если ЗначениеЗаполнено(МОЛ) И ТипЗнч(МОЛ) = Тип("СправочникСсылка.Контрагенты") Тогда
		Сотрудник = ОпределитьСотрудникаПоКонтрагенту(МОЛ, Организация);
		
		Если ЗначениеЗаполнено(Сотрудник) Тогда
			// Заменяем на сотрудника для того, чтобы вывести должность
			
			МОЛ = Сотрудник;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(МОЛ) И ТипЗнч(МОЛ) = Тип("СправочникСсылка.Сотрудники") Тогда
		
		ТребуемыеДанные = Новый Структура("Должность,НаименованиеПолное,Фамилия,Имя,Отчество");
		ТребуемыеДанные.Вставить("СсылкаНаОбъект",	МОЛ);
		ТребуемыеДанные.Вставить("Период",			Дата);
		
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ТребуемыеДанные);
		
		МОЛДолжность	= ТребуемыеДанные.Должность;
		МОЛКраткоеФИО	= КорреспондентыКлиентСервер.ФИО(ТребуемыеДанные,Истина,,Истина);
		МОЛПолноеФИО	= ТребуемыеДанные.НаименованиеПолное;
		
	ИначеЕсли ЗначениеЗаполнено(МОЛ) И ТипЗнч(МОЛ) = Тип("СправочникСсылка.Контрагенты") Тогда
		
		ТребуемыеДанные = Новый Структура("НаименованиеПолное,Сотрудник,Фамилия,Имя,Отчество");
		ТребуемыеДанные.Вставить("СсылкаНаОбъект",	МОЛ);
		ТребуемыеДанные.Вставить("Период",			Дата);
		
		Справочники.Контрагенты.ПолучитьДанныеКонтрагента(ТребуемыеДанные);
		
		МОЛДолжность	= "";
		МОЛКраткоеФИО	= КорреспондентыКлиентСервер.ФИО(ТребуемыеДанные,Истина,,Истина);
		МОЛПолноеФИО	= ТребуемыеДанные.НаименованиеПолное;
		
	КонецЕсли;
	
	Если ПустаяСтрока(МОЛКраткоеФИО) Тогда
		МОЛКраткоеФИО = МОЛПолноеФИО;
	КонецЕсли;
	
	ОписаниеМОЛ = Новый Структура();
	ОписаниеМОЛ.Вставить("МОЛДолжность",	МОЛДолжность);
	ОписаниеМОЛ.Вставить("МОЛКраткоеФИО",	МОЛКраткоеФИО);
	ОписаниеМОЛ.Вставить("МОЛПолноеФИО",	МОЛПолноеФИО);
	
	Возврат ОписаниеМОЛ;
	
КонецФункции

Функция ОпределитьВидДокумента(Документ)
	
	Возврат Метаданные.НайтиПоТипу(ТипЗнч(Документ.Ссылка)).Имя;
	
КонецФункции

#КонецОбласти

Процедура ПроверитьДатыИнвентаризации(ДокументОбъект, Отказ) Экспорт
	
	// Проверяется взаимное заполнение полей (либо в шапке документа, либо в табличной части):
	//	- ДатаНачала
	//	- ДатаОкончания
	//	- ДатаИнвентаризации
	
	Шаблоны = Новый Структура();
	Шаблоны.Вставить("ДатаНачала",					НСтр("ru='Дата начала проведения инвентаризации предшествует дате инвентаризации%1'"));
	Шаблоны.Вставить("ДатаОкончания",				НСтр("ru='Дата окончания проведения инвентаризации предшествует дате начала проведения инвентаризации%1'"));
	Шаблоны.Вставить("ДатаИнвентаризации",			НСтр("ru='Дата инвентаризации позже окончания периода проведения инвентаризации%1'"));
	Шаблоны.Вставить("НомерСтрокиТабличнойЧасти",	НСтр("ru=' (таблица ""%1"", строка %2)'"));
	
	Ссылка = ДокументОбъект["Ссылка"];
	
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.РешениеОПроведенииИнвентаризации") Тогда
		
		// Даты инвентаризации указываются и проверяются в табличной части документа
		
		ИмяТаблицы = "Объекты";
		
		ПредставлениеТаблицы = НСтр("ru='Объекты инвентаризации'");
		
		НомерСтроки = 0;
		
		Для Каждого СтрокаТаблицы Из ДокументОбъект[ИмяТаблицы] Цикл
			
			НомерСтроки = НомерСтроки + 1;
			
			ПроверитьДатыИнвентаризации_ОдинНаборДанных(СтрокаТаблицы, Ссылка, Шаблоны, Отказ, ИмяТаблицы, ПредставлениеТаблицы, НомерСтроки);
			
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(Ссылка) = Тип("ДокументСсылка.ИзменениеРешенияОПроведенииИнвентаризации") Тогда
		
		// Даты инвентаризации указываются и проверяются в табличной части документа
		
		ТипИзмененияОтмена = Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Отмена;
		
		ИмяТаблицы = "Объекты";
		
		ПредставлениеТаблицы = НСтр("ru='Объекты инвентаризации'");
		
		НомерСтроки = 0;
		
		Для Каждого СтрокаТаблицы Из ДокументОбъект[ИмяТаблицы] Цикл
			
			НомерСтроки = НомерСтроки + 1;
			
			Если СтрокаТаблицы.ТипИзменения = ТипИзмененияОтмена Тогда
				Продолжить;
			КонецЕсли;
			
			ПроверитьДатыИнвентаризации_ОдинНаборДанных(СтрокаТаблицы, Ссылка, Шаблоны, Отказ, ИмяТаблицы, ПредставлениеТаблицы, НомерСтроки);
			
		КонецЦикла;
		
	Иначе
		
		// Даты инвентаризации указываются и проверяются в шапке документа
		
		ПроверитьДатыИнвентаризации_ОдинНаборДанных(ДокументОбъект, Ссылка, Шаблоны, Отказ);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьНеобходимостьУказанияМОЛВТабличнойЧастиОбъекты(ДокументОбъект, Отказ, ПараметрыПроверкиЗаполненияРешения) Экспорт
	
	ТаблицаОбъекты				= ПараметрыПроверкиЗаполненияРешения.ТаблицаОбъекты;
	ПредставлениеТаблицыОбъекты	= ПараметрыПроверкиЗаполненияРешения.ПредставлениеТаблицыОбъекты;
	
	Для Каждого СтрокаТаблицы Из ТаблицаОбъекты Цикл
		
		Если Не СтрокаТаблицы.ОдинаковоеНаличиеРеквизитаМОЛ Тогда
			Продолжить;
		КонецЕсли;
		
		НомерСтроки = СтрокаТаблицы.НомерСтроки;
		
		ИндексТекст = ИнвентаризацияСервер.ФорматироватьИндексСтрокиТаблицыДляВыводаСообщения(НомерСтроки - 1);
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.Сотрудник) И СтрокаТаблицы.ЕстьРеквизитМОЛ Тогда
			// Незаполненный МОЛ
			
			Отказ = Истина;
			
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
				"Колонка",,
				НСтр("ru='Сотрудник'"),
				НомерСтроки,
				ПредставлениеТаблицыОбъекты);
				
			ОбщегоНазначения.СообщитьПользователю(
				ТекстСообщения,
				ДокументОбъект.Ссылка,
				"Объект.Объекты[" + ИндексТекст + "].Сотрудник");
				
		ИначеЕсли ЗначениеЗаполнено(СтрокаТаблицы.Сотрудник) И Не СтрокаТаблицы.ЕстьРеквизитМОЛ Тогда
			// Ошибочно заполненный МОЛ
			
			Отказ = Истина;
			
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
				"Колонка",
				"Корректность",
				НСтр("ru='Сотрудник'"),
				НомерСтроки,
				ПредставлениеТаблицыОбъекты,
				НСтр("ru='Описью по указанному счету не предусмотрено указание ответственного лица'"));
				
			ОбщегоНазначения.СообщитьПользователю(
				ТекстСообщения,
				ДокументОбъект.Ссылка,
				"Объект.Объекты[" + ИндексТекст + "].Сотрудник");
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьПараметрыПроверкиЗаполненияРешения(ДокументОбъект) Экспорт
	
	// Из раздела 1 и состава комиссий исключены строки с типом изменения Отмена.
	// Табличная часть Объекты расширена колонками КодФормы, ЕстьРеквизитМОЛ.
	// Табличная часть СоставыКомиссий представлена плоской таблицей с колонками Сотрудник, НомерКомиссии, НомерРабочейКомиссии.
	
	ТаблицаОбъекты = ДокументОбъект.Объекты.Выгрузить();
	
	Если ЭтоДокументИзмененияРешения(ДокументОбъект) Тогда
		Поиск = Новый Структура("ТипИзменения", Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Отмена);
		
		МассивСтрок = ТаблицаОбъекты.НайтиСтроки(Поиск);
		
		Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
			ТаблицаОбъекты.Удалить(СтрокаТаблицы);
		КонецЦикла;
		
		ДатаРешения = НачалоДня(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОбъект.Решение, "Дата"));
	Иначе
		ДатаРешения = НачалоДня(ДокументОбъект.Дата);
	КонецЕсли;
	
	ТаблицаНастроек = ПолучитьТаблицуНастроекЗаполненияОписейПоРешению(, Истина, ДокументОбъект.Организация);
	
	СопоставитьТаблицыОбъектовИНастроек(ТаблицаОбъекты, ТаблицаНастроек);
	
	ЗаполнитьКолонкуКодФормыВТаблицеОбъекты(ТаблицаОбъекты, ТаблицаНастроек, ДатаРешения);
	
	ЗаполнитьКолонкуЕстьРеквизитМОЛВТаблицеОбъекты(ТаблицаОбъекты, ТаблицаНастроек);
	
	ПараметрыПроверкиЗаполнения = Новый Структура();
	ПараметрыПроверкиЗаполнения.Вставить("ТаблицаНастроек",				ТаблицаНастроек);
	ПараметрыПроверкиЗаполнения.Вставить("ТаблицаОбъекты",				ТаблицаОбъекты);
	ПараметрыПроверкиЗаполнения.Вставить("ПредставлениеТаблицыОбъекты",	Метаданные.НайтиПоТипу(ТипЗнч(ДокументОбъект.Ссылка)).ТабличныеЧасти.Объекты.Синоним);
	ПараметрыПроверкиЗаполнения.Вставить("СоставыКомиссий",				ПолучитьПрименяемыеСоставыПодразделовРаздела2(ДокументОбъект));
	ПараметрыПроверкиЗаполнения.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	
	Возврат ПараметрыПроверкиЗаполнения;
	
КонецФункции

Процедура ПроверитьОтсутствиеМОЛвСоставеКомиссииРешения(Знач ДокументОбъект, Отказ, ПараметрыПроверкиЗаполненияРешения) Экспорт
	
	// Приказ Минфина от 13.09.2023 N 144н, пункт 5
	// Не допускается включение в состав комиссии лиц, на которых возложена материальная ответственность за объекты, инвентаризируемые комиссией.
	
	НачалоПримененияПриказа144н = ПолучитьНачалоПримененияПриказа144н();
	
	КодыФорм = Новый Массив();
	КодыФорм.Добавить("0504086");
	КодыФорм.Добавить("0504087");
	КодыФорм.Добавить("0504088");
	КодыФорм.Добавить("0510465");
	КодыФорм.Добавить("0510466");
	КодыФорм.Добавить("0510467");
	
	ТаблицаОбъекты				= ПараметрыПроверкиЗаполненияРешения.ТаблицаОбъекты;
	ПредставлениеТаблицыОбъекты	= ПараметрыПроверкиЗаполненияРешения.ПредставлениеТаблицыОбъекты;
	СоставыКомиссий				= ПараметрыПроверкиЗаполненияРешения.СоставыКомиссий;
	
	ПоискСРабочейКомиссией = Новый Структура("Сотрудник,НомерКомиссии,НомерРабочейКомиссии");
	ПоискБезРабочейКомиссии = Новый Структура("Сотрудник,НомерКомиссии");
	
	Для Каждого СтрокаТаблицы Из ТаблицаОбъекты Цикл
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.Сотрудник) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.ДатаИнвентаризации) И СтрокаТаблицы.ДатаИнвентаризации < НачалоПримененияПриказа144н Тогда
			Продолжить;
		КонецЕсли;
		
		НайденКодФормы = Ложь;
		
		Для Каждого КодФормы Из КодыФорм Цикл
			Если СтрНайти(СтрокаТаблицы.КодФормы, КодФормы) <> 0 Тогда
				НайденКодФормы = Истина;
				
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Не НайденКодФормы Тогда
			Продолжить;
		КонецЕсли;
		
		Поиск = ?(ЗначениеЗаполнено(СтрокаТаблицы.НомерРабочейКомиссии), ПоискСРабочейКомиссией, ПоискБезРабочейКомиссии);
		
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаТаблицы);
		
		МассивСтрок = СоставыКомиссий.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Отказ = Истина;
		
		НомерСтроки = СтрокаТаблицы.НомерСтроки;
		
		ИндексТекст = ИнвентаризацияСервер.ФорматироватьИндексСтрокиТаблицыДляВыводаСообщения(НомерСтроки - 1);
		
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Колонка", "Корректность",
			НСтр("ru='Сотрудник'"),
			НомерСтроки,
			ПредставлениеТаблицыОбъекты,
			НСтр("ru='Материально ответственное лицо ошибочно включено в состав инвентаризационной комиссии'"));
			
		ОбщегоНазначения.СообщитьПользователю(
			ТекстСообщения,
			ДокументОбъект.Ссылка,
			"Объект.Объекты[" + ИндексТекст + "].Сотрудник");
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьНаличиеОтветственногоИсполнителяВСоставеКомиссииОписи(Знач ДокументОбъект, Отказ, Знач ИмяРеквизитаОтветственныйИсполнитель, Знач ИмяТабличнойЧастиСоставКомиссии = "СоставКомиссии") Экспорт
	
	// Приказ Минфина от 13.09.2023 N 144н, пункт 6
	// Включение лица, осуществляющего ведение бухгалтерского учета, в состав комиссии,
	// уполномоченной на проведение инвентаризации денежных средств, иных ценностей,
	// находящихся на счетах и во вкладах или на хранении в кредитной организации,
	// а также электронных денежных средств, иных финансовых активов и (или) обязательств,
	// принимаемых к бухгалтерскому учету в результате осуществления лицами, осуществляющими ведение бухгалтерского учета,
	// полномочий по начислению физическим лицам выплат по оплате труда, иных выплат,
	// а также обязательных платежей в бюджеты бюджетной системы Российской Федерации, является обязательным.
	
	ОтветственныйИсполнитель = ДокументОбъект[ИмяРеквизитаОтветственныйИсполнитель];
	
	Если Не ЗначениеЗаполнено(ОтветственныйИсполнитель) Тогда
		Возврат;
	КонецЕсли;
	
	Поиск = Новый Структура("Сотрудник", ОтветственныйИсполнитель);
	
	МассивСтрок = ДокументОбъект[ИмяТабличнойЧастиСоставКомиссии].НайтиСтроки(Поиск);
	
	Если МассивСтрок.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Истина;
	
	ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
		"Поле", "Корректность",
		ДокументОбъект.Ссылка.Метаданные().Реквизиты[ИмяРеквизитаОтветственныйИсполнитель].Синоним,
		,,
		НСтр("ru='Ответственный исполнитель отсутствует в составе инвентаризационной комиссии'"));
		
	ОбщегоНазначения.СообщитьПользователю(
		ТекстСообщения,
		ДокументОбъект.Ссылка,
		"Объект." + ИмяРеквизитаОтветственныйИсполнитель);
	
КонецПроцедуры

Процедура УстановитьДатуИнвентаризации(ДанныеЗаполнения, ДокументОбъект) Экспорт
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") И ДанныеЗаполнения.Свойство("ДатаИнвентаризации") Тогда
		Возврат;
	КонецЕсли;
	
	ДокументОбъект["ДатаИнвентаризации"] = ТекущаяДатаСеанса();
	
КонецПроцедуры

Функция ПолучитьКомпонентыДатыДляПодписи(Дата, ТолькоДвеПоследниеЦифрыГода = Ложь) Экспорт
	
	// Компоненты даты для заполнения даты в печатных формах вида
	// "___" _________ 20__ г.
	
	Если ЗначениеЗаполнено(Дата) Тогда
		МассивСтрок = СтрРазделить(Формат(Дата, "ДФ='дд ММММ'"), " ");
		
		Дня		= МассивСтрок[0];
		Месяца	= МассивСтрок[1];
		Года	= Формат(Год(Дата), "ЧГ=0");
		Если ТолькоДвеПоследниеЦифрыГода Тогда
			Года = Прав(Года, 2);
		КонецЕсли;
	Иначе
		Дня		= "";
		Месяца	= "";
		Если ТолькоДвеПоследниеЦифрыГода Тогда
			Года = "";
		Иначе
			Года	= "20      ";
		КонецЕсли;
	КонецЕсли;
	
	КомпонентыДаты = Новый Структура();
	КомпонентыДаты.Вставить("Дня",		Дня);
	КомпонентыДаты.Вставить("Месяца",	Месяца);
	КомпонентыДаты.Вставить("Года",		Года);
	
	Возврат КомпонентыДаты;
	
КонецФункции

Процедура ЗаполнитьКЭКОстатков(ТаблицаЗадолженности, СчетаРасчетовКИСЕ = Неопределено, КонтрагентКИЕ = Неопределено) Экспорт
	
	Если СчетаРасчетовКИСЕ = Неопределено Тогда
		СчетаРасчетовКИСЕ = БухгалтерскийУчет.СписокСчетов(ПланыСчетов.ЕПСБУ.КодыСчетовРасчетовКИСЕ());
	КонецЕсли;
	
	КЭКОстатков = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КОСГУ.Ссылка КАК Ссылка,
	|	ПОДСТРОКА(КОСГУ.Код,3,1) КАК КодКИЕ
	|ИЗ
	|	Справочник.КОСГУ КАК КОСГУ
	|ГДЕ
	|	КОСГУ.Код В (""000"", ""001"", ""002"", ""003"", ""004"", ""005"", ""006"", ""007"", ""008"", ""009"")
	|";
	
	Результат = Запрос.Выполнить();
	ВыборкаКЭКОстатков = Результат.Выбрать();
	Пока ВыборкаКЭКОстатков.Следующий() Цикл
		КЭКОстатков.Вставить(ВыборкаКЭКОстатков.КодКИЕ, ВыборкаКЭКОстатков.Ссылка);
	КонецЦикла;
	
	КЭК000 = КЭКОстатков.Получить("0");
	
	Для Каждого СтрокаТаблицы Из ТаблицаЗадолженности Цикл
		Если КонтрагентКИЕ <> Неопределено Тогда
			ЗначениеКонтрагентКИЕ = КонтрагентКИЕ;
		Иначе
			ЗначениеКонтрагентКИЕ = СтрокаТаблицы.КонтрагентКИЕ;
		КонецЕсли;
		
		Если СчетаРасчетовКИСЕ.Найти(СтрокаТаблицы.Счет) = Неопределено Или СтрокаТаблицы.СчетЗабалансовый Или СтрокаТаблицы.СчетБезДетализацииКОСГУ Тогда
			Продолжить;
		ИначеЕсли СтрокаТаблицы.СчетКИЕ <> "0" Тогда
			СтрокаТаблицы.КЭК = КЭКОстатков.Получить(СтрокаТаблицы.СчетКИЕ);
		ИначеЕсли ЗначениеЗаполнено(ЗначениеКонтрагентКИЕ) Тогда
			СтрокаТаблицы.КЭК = КЭКОстатков.Получить(ЗначениеКонтрагентКИЕ);
		Иначе
			СтрокаТаблицы.КЭК = КЭК000;
		КонецЕсли;	
		
	КонецЦикла;
		
КонецПроцедуры

// Ожидаются реквизиты шапки: МОЛ, Организация.
Функция ПолучитьСписокОтбораПоМОЛ(ШапкаДокумента) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ШапкаДокумента.МОЛ) Тогда
		Возврат Новый Массив();
	КонецЕсли;
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МОЛ",			ШапкаДокумента.МОЛ);
	ЗапросПоиск.УстановитьПараметр("Организация",	ШапкаДокумента.Организация);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Список для отбора МОЛ в документах инвентаризационных описей
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка	КАК Ссылка
	|ИЗ
	|	Справочник.Сотрудники
	|ГДЕ
	|	НЕ ПометкаУдаления
	|	И Ссылка = &МОЛ
	|	И Владелец = &Организация
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Ссылка	КАК Ссылка
	|ИЗ
	|	Справочник.ЦМО
	|ГДЕ
	|	НЕ ПометкаУдаления
	|	И (Ссылка = &МОЛ ИЛИ Сотрудник = &МОЛ)
	|	И Владелец = &Организация
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Контрагент	КАК Ссылка
	|ИЗ
	|	Справочник.Сотрудники
	|ГДЕ
	|	НЕ ПометкаУдаления
	|	И Ссылка = &МОЛ
	|	И Владелец = &Организация";
	
	Возврат ЗапросПоиск.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

Процедура ПроверитьЗаполнениеПолногоСчетаВТабличнойЧасти(Знач ДокументОбъект, Отказ) Экспорт
	
	Перем РезультатПроверки;
	
	ТипОписи = ТипЗнч(ДокументОбъект.Ссылка);
	
	Если ТипОписи = Тип("ДокументСсылка.ИнвентаризацияМЗ") Тогда
		ИмяТабличнойЧасти = "Материалы";
		
	ИначеЕсли ТипОписи = Тип("ДокументСсылка.ИнвентаризацияОС") Тогда
		ИмяТабличнойЧасти = "Инвентаризация";
		
	ИначеЕсли ТипОписи = Тип("ДокументСсылка.ИнвентаризацияИК") Тогда
		ИмяТабличнойЧасти = "Инвентаризация";
	Иначе
		Возврат;
	КонецЕсли;
	
	ПараметрыПроверки = ОбщегоНазначенияБГУ.ПолучитьПараметрыПроверкиРеквизитов();
	
	ВариантФормированияОписи = ДокументОбъект.ВариантФормированияОписи;
	
	Если ВариантФормированияОписи = 0 Тогда
		// 0. Опись до 2018 г. Счет в шапке
		
		Возврат;
		
	ИначеЕсли ВариантФормированияОписи = 1 Тогда
		// 1. Опись с 2018 г. Счет в таблице (26 знаков)
		
		ПараметрыПроверки.ПроверяемыеРеквизиты.Добавить(ИмяТабличнойЧасти + ".Счет");
		
		Если ТипОписи = Тип("ДокументСсылка.ИнвентаризацияМЗ") Или ТипОписи = Тип("ДокументСсылка.ИнвентаризацияОС") Тогда
			ПараметрыПроверки.ПроверяемыеРеквизиты.Добавить(ИмяТабличнойЧасти + ".КФО");
		КонецЕсли;
		
		ПризнакиУчета = Новый Структура();
		ПризнакиУчета.Вставить("Счет",		"Счет");
		ПризнакиУчета.Вставить("УчетПоКПС",	"КПС");
		
		ПараметрыПроверки.ПроверяемыеПризнакиУчета.Вставить(ИмяТабличнойЧасти, ПризнакиУчета);
		
	Иначе
		// 2. Опись с 2018 г. Счет в таблице (5 знаков)
		// 3. Опись с 2018 г. Счет в таблице (5 знаков). Одна строка - один объект
		
		ПараметрыПроверки.ПроверяемыеРеквизиты.Добавить(ИмяТабличнойЧасти + ".Счет");
	КонецЕсли;
	
	Если Не ОбщегоНазначенияБГУ.УказанныеРеквизитыЗаполнены(ДокументОбъект, ПараметрыПроверки, РезультатПроверки) Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьОписаниеРасположенияРеквизитовОписи(СтрокаТаблицыНастроек) Экспорт
	
	ОписаниеРеквизитов = Новый Структура();
	
	ОписаниеРеквизитов.Вставить("Счет",					ДиагностироватьОписаниеРеквизитаОписи(СтрокаТаблицыНастроек.ИмяРеквизитаСчет));
	ОписаниеРеквизитов.Вставить("КФО",					ДиагностироватьОписаниеРеквизитаОписи(СтрокаТаблицыНастроек.ИмяРеквизитаКФО));
	ОписаниеРеквизитов.Вставить("Сотрудник",			ДиагностироватьОписаниеРеквизитаОписи(СтрокаТаблицыНастроек.ИмяРеквизитаМОЛ));
	ОписаниеРеквизитов.Вставить("МестоИнвентаризации",	ДиагностироватьОписаниеРеквизитаОписи(СтрокаТаблицыНастроек.ИмяРеквизитаМестоИнвентаризации, "МестоИнвентаризации"));
	
	Возврат ОписаниеРеквизитов;
	
КонецФункции

