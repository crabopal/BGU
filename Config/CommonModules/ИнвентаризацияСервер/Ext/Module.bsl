	ИменаКолонок.Вставить("СуммаНедостача",			"НедостачаСумма");
	
	НеиспользуемыеРеквизиты = Новый Соответствие();
	
	//
	// 0. Опись до 2018 г. Счет в шапке
	//
	НастройкиВарианта = Новый Структура();
	НастройкиВарианта.Вставить("РеквизитыШапки",			"НеЗаполнятьЦену,
															|ОбъяснениеПричинРасхождений,
															|ЗаключениеКомиссии");
	НастройкиВарианта.Вставить("РеквизитыТабличнойЧасти",	"Счет,
															|КФО,
															|КПС,
															|СтатусОбъекта,
															|ЦелеваяФункцияАктива,
															|КоличествоНеСоответствует,
															|СуммаНеСоответствует,
															|Примечание");
	НастройкиВарианта.Вставить("ЭлементыФормы",			"МатериалыГрупповоеЗаполнениеМатериалы");
	ПолучитьНастройкиФормы0504087_ОбработатьТекстовыеНастройки(НастройкиВарианта);
	НеиспользуемыеРеквизиты.Вставить(0, НастройкиВарианта);
		
	//
	// 1. Опись с 2018 г. Счет в таблице (26 знаков)
	//
	// КФО и КПС не скрываем
	НастройкиВарианта = Новый Структура();
	НастройкиВарианта.Вставить("РеквизитыШапки",			"");
	НастройкиВарианта.Вставить("РеквизитыТабличнойЧасти",	"");
	НастройкиВарианта.Вставить("ЭлементыФормы",				"");
	ПолучитьНастройкиФормы0504087_ОбработатьТекстовыеНастройки(НастройкиВарианта);
	НеиспользуемыеРеквизиты.Вставить(1, НастройкиВарианта);
	
	//
	// 2. Опись с 2018 г. Счет в таблице (5 знаков)
	// 3. Опись с 2018 г. Счет в таблице (5 знаков). Одна строка - один объект
	//
	НастройкиВарианта = Новый Структура();
	НастройкиВарианта.Вставить("РеквизитыШапки",			"");
	НастройкиВарианта.Вставить("РеквизитыТабличнойЧасти",	"КФО,КПС");
	НастройкиВарианта.Вставить("ЭлементыФормы",				"");
	ПолучитьНастройкиФормы0504087_ОбработатьТекстовыеНастройки(НастройкиВарианта);
	НеиспользуемыеРеквизиты.Вставить(2, НастройкиВарианта);
	НеиспользуемыеРеквизиты.Вставить(3, НастройкиВарианта);
	
	
	НастройкиДокумента = Новый Структура();
	НастройкиДокумента.Вставить("ИмяТабличнойЧасти",					"Материалы");
	НастройкиДокумента.Вставить("ИменаКолонокЧисловыхПоказателей",		ИменаКолонок);
	НастройкиДокумента.Вставить("ИмяРеквизитаСчетВШапке",				"Счет");
	НастройкиДокумента.Вставить("УстанавливатьСчетВТабличнойЧасти",		Истина);
	НастройкиДокумента.Вставить("ОтдельныйЭлементДляТабличнойЧасти",	"");
	НастройкиДокумента.Вставить("НеиспользуемыеРеквизиты",				НеиспользуемыеРеквизиты);
	


	Возврат НастройкиДокумента;
	
КонецФункции

