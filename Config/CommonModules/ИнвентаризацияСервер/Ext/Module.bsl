Функция ПолучитьОписаниеЭлементаРасшифровки(АдресДанныхРасшифровки, Расшифровка) Экспорт
	
	ДанныеРасшифровки = ПолучитьИзВременногоХранилища(АдресДанныхРасшифровки);
	ЭлементРасшифровки = ДанныеРасшифровки.Элементы[Расшифровка];
	
	ИмяПоляРасшифровки = "";
	Для Каждого ЗначениеПоля Из ЭлементРасшифровки.ПолучитьПоля() Цикл
		ИмяПоляРасшифровки = ЗначениеПоля.Поле;
		Прервать;
	КонецЦикла;
	
	ОписаниеЭлементаРасшифровки = Новый Структура();
	ОписаниеЭлементаРасшифровки.Вставить("ИмяПоляРасшифровки", ИмяПоляРасшифровки);
	ОписаниеЭлементаРасшифровки.Вставить("ОсновноеДействие", ЭлементРасшифровки.ОсновноеДействие);
	ОписаниеЭлементаРасшифровки.Вставить("СписокПолей", Новый Соответствие());
	ОписаниеЭлементаРасшифровки.Вставить("ГруппировкиРодителей", Новый Массив());
	ОписаниеЭлементаРасшифровки.Вставить("СписокРодительскихПолей", Новый Соответствие());
	
	ЗаполнитьСпискиПолейИГруппировкиРодителей(ОписаниеЭлементаРасшифровки, ЭлементРасшифровки);
	
	Возврат ОписаниеЭлементаРасшифровки;

КонецФункции

