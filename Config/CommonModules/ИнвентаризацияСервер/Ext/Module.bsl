Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию_2_0_74(Параметры) Экспорт
	
	// Обработчик обновления для версии 2.0.74
	// Инициализация нового реквизита ДатаИнвентаризации в документах инвентаризации
	
	ИменаДокументов = ПолучитьИменаДокументовДляПереходаНаНовуюВерсию_2_0_74();
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("НачальнаяДата",	'20200101');
	ЗапросПоиск.УстановитьПараметр("ПустаяДата",	'00010101');
	
	ТекстВыборкаШаблон = "
	|ВЫБРАТЬ
	|	Ссылка
	|ИЗ
	|	(ВЫБРАТЬ ПЕРВЫЕ 100
	|		Ссылка
	|	ИЗ
	|		Документ.[ИмяДокумента]
	|	ГДЕ
	|		ДатаИнвентаризации = &ПустаяДата
	|		И НЕ ПометкаУдаления
	|		И Дата >= &НачальнаяДата
	|	УПОРЯДОЧИТЬ ПО
	|		Дата УБЫВ) КАК Док
	|";
	
	ТекстОбъединитьВсе = "
	|ОБЪЕДИНИТЬ ВСЕ
	|";
	
	ТекстЗапроса = "";
	
	Для Каждого ИмяДокумента Из	ИменаДокументов Цикл
		ТекстЗапроса = ТекстЗапроса
			+ ?(ЗначениеЗаполнено(ТекстЗапроса), ТекстОбъединитьВсе, "")
			+ СтрЗаменить(ТекстВыборкаШаблон, "[ИмяДокумента]", ИмяДокумента);
	КонецЦикла;
	
	ЗапросПоиск.Текст = ТекстЗапроса;
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, ЗапросПоиск.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию_2_0_74(Параметры) Экспорт
	
	ОбработкаВсехВидовДокументовЗавершена = Истина; // Начальное значение определяется алгоритмом дальнейшей обработки
	
	Параметры.ОбработкаЗавершена = Ложь;
	
	ИменаДокументов = ПолучитьИменаДокументовДляПереходаНаНовуюВерсию_2_0_74();
	
	Для Каждого ИмяДокумента Из	ИменаДокументов Цикл
		ПолноеИмяОбъекта = "Документ." + ИмяДокумента;
		Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
		
		Пока Выборка.Следующий() Цикл
			
			НачатьТранзакцию();
			
			Блокировка = Новый БлокировкаДанных;
			Элемент = Блокировка.Добавить(ПолноеИмяОбъекта);
			Элемент.УстановитьЗначение("Ссылка", Выборка.Ссылка);
			Элемент.Режим = РежимБлокировкиДанных.Исключительный;
			
			Попытка
				Блокировка.Заблокировать();
			Исключение
				// Объект не удается заблокировать - попробуем обработать его на следующей итерации.
				// Отдельно обрабатывать ошибку не требуется, т.к. в худшем случае обработчик зациклится
				// и прервется автоматически.
				ЗафиксироватьТранзакцию();
				Продолжить;
			КонецПопытки;
			
			Если Не ОбщегоНазначения.СсылкаСуществует(Выборка.Ссылка) Тогда
				// Вероятно был удален раньше, чем обработчик дошел до него
				ЗафиксироватьТранзакцию();
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
				Продолжить;
			КонецЕсли;
			
			ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
			
			ДокументОбъект.ДатаИнвентаризации = ДокументОбъект.Дата;
			
			Попытка
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект);
				
				ЗафиксироватьТранзакцию();
				
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
			Исключение
				ОтменитьТранзакцию();
				
				ТекстСообщения = СтрШаблон(
					НСтр("ru='Не удалось записать документ %1 по причине: %2'"),
					Выборка.Ссылка,
					ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
					
				ЗаписьЖурналаРегистрации(
					ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
					УровеньЖурналаРегистрации.Предупреждение,
					,
					,
					ТекстСообщения);
					
				ВызватьИсключение;
			КонецПопытки;
			
		КонецЦикла;
		
		ОбработкаТекущегоВидаДокументовЗавершена = НЕ ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
		
		ОбработкаВсехВидовДокументовЗавершена = ОбработкаВсехВидовДокументовЗавершена И ОбработкаТекущегоВидаДокументовЗавершена;
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = ОбработкаВсехВидовДокументовЗавершена;
	
КонецПроцедуры

Функция ПолучитьИменаДокументовДляПереходаНаНовуюВерсию_2_0_74()
	
	ИменаДокументов = Новый Массив();
	ИменаДокументов.Добавить("ИнвентаризацияГосдолгаПоКредитамИГарантиям");
	ИменаДокументов.Добавить("ИнвентаризацияДрагКамнейВИК");
	ИменаДокументов.Добавить("ИнвентаризацияДрагКамнейВНФА");
	ИменаДокументов.Добавить("ИнвентаризацияДрагМеталловВИК");
	ИменаДокументов.Добавить("ИнвентаризацияДрагМеталловВНФА");
	ИменаДокументов.Добавить("ИнвентаризацияИК");
	ИменаДокументов.Добавить("ИнвентаризацияКассы");
	ИменаДокументов.Добавить("ИнвентаризацияКредитовИЗаймов");
	ИменаДокументов.Добавить("ИнвентаризацияМЗ");
	ИменаДокументов.Добавить("ИнвентаризацияОС");
	ИменаДокументов.Добавить("ИнвентаризацияОстатковНаСчетах");
	ИменаДокументов.Добавить("ИнвентаризацияРасчетовПоПоступлениям");
	
	Возврат ИменаДокументов;
	
КонецФункции

