Процедура КэшироватьСвойстваЭлементовНедоступныхКолонок(Форма, Знач ИменаКэшируемыхЭлементов)
	
	Если ТипЗнч(Форма.КэшСвойстваЭлементовНедоступныхКолонок) = Тип("ФиксированнаяСтруктура") Тогда
		Кэш = Новый Структура(Форма.КэшСвойстваЭлементовНедоступныхКолонок);
	Иначе
		Кэш = Новый Структура();
	КонецЕсли;
	
	Для Каждого ИмяЭлемента Из ИменаКэшируемыхЭлементов Цикл
		Если Кэш.Свойство(ИмяЭлемента) Тогда
			// По этой колонке уже есть сведения.
			Продолжить;
		КонецЕсли;
		
		ЭлементКолонки = Форма.Элементы[ИмяЭлемента];
		
		Описание = НовыйОписаниеНедоступнойКолонки();
		
		ЗаполнитьЗначенияСвойств(Описание.Свойства, ЭлементКолонки);
		
		Для Каждого Элемент Из Описание.ОбработчикиСобытий Цикл
			ИмяСобытия = Элемент.Ключ;
			
			ИмяОбработчика = ЭлементКолонки.ПолучитьДействие(ИмяСобытия);
			
			Описание.ОбработчикиСобытий[ИмяСобытия] = ИмяОбработчика;
		КонецЦикла;
		
		Кэш.Вставить(ИмяЭлемента, Описание);
	КонецЦикла;
	
	Форма.КэшСвойстваЭлементовНедоступныхКолонок = Новый ФиксированнаяСтруктура(Кэш);
	
КонецПроцедуры

Процедура УстановитьСвойстваИОбработчикиСобытийЭлементаКолонки(ЭлементКолонки, Описание, ИсключаяСвойства = Неопределено)
	
	// Устанавливаем явно заданные свойства.
	ЗаполнитьЗначенияСвойств(ЭлементКолонки, Описание.Свойства,, ИсключаяСвойства);
	
	// Подключаем явно заданные обработчики событий.
	Для Каждого Элемент Из Описание.ОбработчикиСобытий Цикл
		ИмяСобытия = Элемент.Ключ;
		ИмяОбработчика = Элемент.Значение;
		
		ЭлементКолонки.УстановитьДействие(ИмяСобытия, ИмяОбработчика);
	КонецЦикла;
	
КонецПроцедуры

