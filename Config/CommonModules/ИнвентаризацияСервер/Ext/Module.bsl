Функция ДокументВнеДерева(Знач ДокументСсылка, Знач РезультатыПоиска, Решение)

	Поиск = Новый Структура("ИзменениеРешения", ДокументСсылка);
	
	МассивСтрок = РезультатыПоиска.ВнеДереваДокументов.НайтиСтроки(Поиск);
	
	Если МассивСтрок.Количество() > 0 Тогда
		Решение = МассивСтрок[0].Решение;
		
		Возврат Истина;
	КонецЕсли;
	
	Решение = Неопределено;
	
	Возврат Ложь;
	
КонецФункции

Функция СоставитьДеревоДокументов(Знач ТаблицыДокументов)
	
	ДеревоДокументов = ПолучитьПустоеДеревоДокументов();
	
	ТаблицаДокументов = ТаблицыДокументов.СРешением;
	ТаблицаДокументов.Колонки.Добавить("СтрокаОбработана", Новый ОписаниеТипов("Булево"));
	
	Поиск = Новый Структура();
	Поиск.Вставить("ЭтоИзменениеРешения", Ложь);
	Поиск.Вставить("СтрокаОбработана", Ложь);
	
	МассивСтрок = ТаблицаДокументов.НайтиСтроки(Поиск);
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		СтрокаДерева = ДеревоДокументов.Строки.Добавить();
		СтрокаДерева.Документ			= СтрокаТаблицы.Решение;
		СтрокаДерева.Дата				= СтрокаТаблицы.Дата;
		СтрокаДерева.Номер				= СтрокаТаблицы.Номер;
		СтрокаДерева.ПометкаУдаления	= СтрокаТаблицы.РешениеПометкаУдаления;
		СтрокаДерева.Проведен			= СтрокаТаблицы.РешениеПроведен;
		
		Поиск.Вставить("Решение", СтрокаТаблицы.Решение);
		Поиск.Вставить("ЭтоИзменениеРешения", Истина);
		
		СоставитьЦепочкиОтДокумента(СтрокаДерева, ТаблицаДокументов, Поиск);
	КонецЦикла;
	
	ЗаполнитьМаксимальныйУровеньВоВсемДереве(ДеревоДокументов);
	
	// Документы с некорректно заполненными реквизитами связи,
	// которые не позволяют включить их в формируемое дерево документов.
	ВнеДереваДокументов = Новый ТаблицаЗначений();
	ВнеДереваДокументов.Колонки.Добавить("Решение",				Новый ОписаниеТипов("ДокументСсылка.РешениеОПроведенииИнвентаризации"));
	ВнеДереваДокументов.Колонки.Добавить("ИзменениеРешения",	Новый ОписаниеТипов("ДокументСсылка.ИзменениеРешенияОПроведенииИнвентаризации"));
	
	Поиск = Новый Структура();
	Поиск.Вставить("ЭтоИзменениеРешения", Истина);
	Поиск.Вставить("СтрокаОбработана", Ложь);
	
	МассивСтрок = ТаблицаДокументов.НайтиСтроки(Поиск);
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		НоваяСтрока = ВнеДереваДокументов.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
	КонецЦикла;
	
	Поиск = Новый Структура();
	Поиск.Вставить("Решение", Документы.РешениеОПроведенииИнвентаризации.ПустаяСсылка());
	
	Для Каждого Ссылка Из ТаблицыДокументов.БезРешения Цикл
		Поиск.Вставить("ИзменениеРешения", Ссылка);
		
		МассивСтрок = ВнеДереваДокументов.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ВнеДереваДокументов.Добавить();
		НоваяСтрока.ИзменениеРешения = Ссылка;
	КонецЦикла;
	
	Результат = Новый Структура();
	Результат.Вставить("ДеревоДокументов",		ДеревоДокументов);
	Результат.Вставить("ВнеДереваДокументов",	ВнеДереваДокументов);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьПустоеДеревоДокументов()
	
	ТипДокумент = Новый ОписаниеТипов();
	ТипДокумент.Типы().Добавить("ДокументСсылка.РешениеОПроведенииИнвентаризации");
	ТипДокумент.Типы().Добавить("ДокументСсылка.ИзменениеРешенияОПроведенииИнвентаризации");
	
	ТипБулево = Новый ОписаниеТипов("Булево");
	ТипДата = ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата);
	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипНомерИзменений = ОбщегоНазначения.ОписаниеТипаЧисло(3,0,ДопустимыйЗнак.Неотрицательный);
	
	ДеревоДокументов = Новый ДеревоЗначений();
	ДеревоДокументов.Колонки.Добавить("Документ",				ТипДокумент);
	ДеревоДокументов.Колонки.Добавить("Дата",					ТипДата);
	ДеревоДокументов.Колонки.Добавить("Номер",					ТипСтрока);
	ДеревоДокументов.Колонки.Добавить("ПометкаУдаления",		ТипБулево);
	ДеревоДокументов.Колонки.Добавить("Проведен",				ТипБулево);
	ДеревоДокументов.Колонки.Добавить("ЭтоКонечныйДокумент",	ТипБулево);
	ДеревоДокументов.Колонки.Добавить("Уровень",				ТипНомерИзменений);
	ДеревоДокументов.Колонки.Добавить("МаксимальныйУровень",	ТипНомерИзменений);
	ДеревоДокументов.Колонки.Добавить("НомерИзменения",			ТипНомерИзменений);
	ДеревоДокументов.Колонки.Добавить("Аннулирующее",			ТипБулево);
	
	Возврат ДеревоДокументов;
	
КонецФункции

Функция	ПолучитьПустуюТаблицуКомиссий()
	
	// Состав колонок см. Функция НайтиДокументыСоставляющиеЦепочки()
	
	ТипДокумент = Новый ОписаниеТипов();
	ТипДокумент.Типы().Добавить("ДокументСсылка.РешениеОПроведенииИнвентаризации");
	ТипДокумент.Типы().Добавить("ДокументСсылка.ИзменениеРешенияОПроведенииИнвентаризации");
	
	ТаблицаКомиссий = Новый ТаблицаЗначений();
	ТаблицаКомиссий.Колонки.Добавить("Документ",			ТипДокумент);
	ТаблицаКомиссий.Колонки.Добавить("НомерСтроки",			ОбщегоНазначения.ОписаниеТипаЧисло(6,0,ДопустимыйЗнак.Неотрицательный));
	ТаблицаКомиссий.Колонки.Добавить("Комиссия",			Новый ОписаниеТипов("СправочникСсылка.ПостоянноДействующиеКомиссии"));
	ТаблицаКомиссий.Колонки.Добавить("ТипИзменения",		Новый ОписаниеТипов("ПеречислениеСсылка.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации"));
	ТаблицаКомиссий.Колонки.Добавить("Модифицированность",	Новый ОписаниеТипов("Булево"));
	
	Возврат ТаблицаКомиссий;
	
КонецФункции
	
Процедура ЗаполнитьМаксимальныйУровеньВоВсемДереве(ДеревоДокументов)
	
	Поиск = Новый Структура("ЭтоКонечныйДокумент", Истина);
	
	МассивСтрок = ДеревоДокументов.Строки.НайтиСтроки(Поиск, Истина);
	
	Для Каждого СтрокаДерева Из МассивСтрок Цикл
		МаксимальныйУровень = СтрокаДерева.Уровень;
		
		СтрокаДерева.МаксимальныйУровень = МаксимальныйУровень;
		
		ЗаполнитьМаксимальныйУровеньВоРодительскихСтроках(СтрокаДерева, МаксимальныйУровень);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьМаксимальныйУровеньВоРодительскихСтроках(СтрокаДерева, МаксимальныйУровень)
	
	СтрокаРодителя = СтрокаДерева.Родитель;
	
	Если СтрокаРодителя = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если СтрокаРодителя.МаксимальныйУровень > МаксимальныйУровень Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаРодителя.МаксимальныйУровень = МаксимальныйУровень;
	
	Если СтрокаРодителя.Уровень = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьМаксимальныйУровеньВоРодительскихСтроках(СтрокаРодителя, МаксимальныйУровень);
	
КонецПроцедуры

Процедура СоставитьЦепочкиОтДокумента(СтрокаДерева, ТаблицаДокументов, Поиск, ПредыдущееИзменениеРешения = Неопределено, Уровень = 1)
	
	Если ПредыдущееИзменениеРешения = Неопределено Тогда
		ПредыдущееИзменениеРешения = Документы.ИзменениеРешенияОПроведенииИнвентаризации.ПустаяСсылка();
	КонецЕсли;
	
	Поиск.Вставить("ПредыдущееИзменениеРешения", ПредыдущееИзменениеРешения);
	
	МассивСтрок = ТаблицаДокументов.НайтиСтроки(Поиск);
	
	Если МассивСтрок.Количество() = 0 Тогда
		// Такой документ является конечным документом цепочки
		СтрокаДерева.ЭтоКонечныйДокумент = Истина;
		
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		ИзменениеРешения = СтрокаТаблицы.ИзменениеРешения;
		
		СтрокаТаблицы.СтрокаОбработана = Истина;
		
		НоваяСтрокаДерева = СтрокаДерева.Строки.Добавить();
		НоваяСтрокаДерева.Документ			= ИзменениеРешения;
		НоваяСтрокаДерева.Дата				= СтрокаТаблицы.Дата;
		НоваяСтрокаДерева.Номер				= СтрокаТаблицы.Номер;
		НоваяСтрокаДерева.Уровень			= Уровень;
		НоваяСтрокаДерева.НомерИзменения	= СтрокаТаблицы.НомерИзменения;
		НоваяСтрокаДерева.Аннулирующее		= СтрокаТаблицы.Аннулирующее;
		
		СоставитьЦепочкиОтДокумента(НоваяСтрокаДерева, ТаблицаДокументов, Поиск, ИзменениеРешения, Уровень + 1);
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьСтрокуПервоначальногоДокумента(ДокументСсылка, ДеревоДокументов)
	
	СтрокаДокумента = ПолучитьСтрокуДокументаВДереве(ДокументСсылка, ДеревоДокументов);
	
	Если СтрокаДокумента = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Пока СтрокаДокумента.Родитель <> Неопределено Цикл
		СтрокаДокумента = СтрокаДокумента.Родитель;
	КонецЦикла;
	
	Возврат СтрокаДокумента;
	
КонецФункции

Функция ПолучитьСтрокуДокументаВДереве(ДокументСсылка, ДеревоДокументов)
	
	Поиск = Новый Структура("Документ", ДокументСсылка);
	
	ВключатьПодчиненные = Истина;
	
	МассивСтрок = ДеревоДокументов.Строки.НайтиСтроки(Поиск, ВключатьПодчиненные);
	
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат МассивСтрок[0];
	
КонецФункции

Функция ПолучитьСтрокуПоследующегоДокументаВДереве(ДокументСсылка, ДеревоДокументов)
	
	СтрокаДокумента = ПолучитьСтрокуДокументаВДереве(ДокументСсылка, ДеревоДокументов);
	
	Если СтрокаДокумента = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СтрокаДокумента = ПолучитьСтрокуДокументаВДереве(ДокументСсылка, ДеревоДокументов);
		
	Если СтрокаДокумента.Строки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат СтрокаДокумента.Строки[0];
	
КонецФункции

Функция ПолучитьСтрокуПоследнегоДокументаВДереве(СтрокаДокумента)
	
	Если СтрокаДокумента = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если СтрокаДокумента.ЭтоКонечныйДокумент Тогда
		Возврат СтрокаДокумента;
	КонецЕсли;
	
	Поиск = Новый Структура("ЭтоКонечныйДокумент", Истина);
	
	МассивСтрок = СтрокаДокумента.Строки.НайтиСтроки(Поиск, Истина);
	
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат МассивСтрок[0];
	
КонецФункции

Функция ПолучитьСтрокуАннулирующегоДокумента(СтрокаРешения)
	
	Перем СтрокаДокумента;
	
	Поиск = Новый Структура("Аннулирующее", Истина);
	
	МассивСтрок = СтрокаРешения.Строки.НайтиСтроки(Поиск, Истина);
	
	Если МассивСтрок.Количество() > 0 Тогда
		СтрокаДокумента = МассивСтрок[0];
	КонецЕсли;
	
	Возврат СтрокаДокумента;
	
КонецФункции

Функция НайтиДокументыСоставляющиеЦепочки(СписокДокументов, ИсключаемыеДокументы, ПолучитьТабличныеЧастиКомиссии = Ложь)
	
	Перем ТаблицаКомиссии;
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("СписокДокументов", СписокДокументов);
	ЗапросПоиск.УстановитьПараметр("ИсключаемыеДокументы", ИсключаемыеДокументы);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Соответствие Документ-Решение
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	Ссылка	КАК Документ,
	|	Ссылка	КАК Решение
	|ПОМЕСТИТЬ
	|	СвязьДокументРешение
	|ИЗ
	|	Документ.РешениеОПроведенииИнвентаризации
	|ГДЕ
	|	Ссылка В (&СписокДокументов)
	|	И НЕ Ссылка В (&ИсключаемыеДокументы)
	|	И НЕ ПометкаУдаления
	|	
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Ссылка	КАК Документ,
	|	Решение	КАК Решение
	|ИЗ
	|	Документ.ИзменениеРешенияОПроведенииИнвентаризации
	|ГДЕ
	|	Ссылка В (&СписокДокументов)
	|	И НЕ Ссылка В (&ИсключаемыеДокументы)
	|	И Решение <> ЗНАЧЕНИЕ(Документ.РешениеОПроведенииИнвентаризации.ПустаяСсылка)
	|	И НЕ ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Изменения решений
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Решение						КАК Решение,
	|	Решение.ПометкаУдаления		КАК РешениеПометкаУдаления,
	|	Решение.Проведен			КАК РешениеПроведен,
	|	Ссылка						КАК ИзменениеРешения,
	|	ПометкаУдаления				КАК ИзменениеРешенияПометкаУдаления,
	|	Проведен					КАК ИзменениеРешенияПроведен,
	|	НомерИзменения				КАК НомерИзменения,
	|	Аннулирующее				КАК Аннулирующее,
	|	ПредыдущееИзменениеРешения	КАК ПредыдущееИзменениеРешения,
	|	Дата						КАК Дата,
	|	Номер						КАК Номер
	|ПОМЕСТИТЬ
	|	ИзмененияРешений
	|ИЗ
	|	Документ.ИзменениеРешенияОПроведенииИнвентаризации
	|ГДЕ
	|	Решение В (ВЫБРАТЬ Решение ИЗ СвязьДокументРешение)
	|	И НЕ Ссылка В (&ИсключаемыеДокументы)
	|	И НЕ ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Все документы найденных цепочек
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СвязьДокументРешение.Решение						КАК Решение,
	|	РешениеОПроведенииИнвентаризации.ПометкаУдаления	КАК РешениеПометкаУдаления,
	|	РешениеОПроведенииИнвентаризации.Проведен			КАК РешениеПроведен,
	|	
	|	ЛОЖЬ												КАК ЭтоИзменениеРешения,
	|	НЕОПРЕДЕЛЕНО										КАК ИзменениеРешения,
	|	НЕОПРЕДЕЛЕНО										КАК ИзменениеРешенияПометкаУдаления,
	|	НЕОПРЕДЕЛЕНО										КАК ИзменениеРешенияПроведен,
	|	
	|	НЕОПРЕДЕЛЕНО										КАК НомерИзменения,
	|	НЕОПРЕДЕЛЕНО										КАК Аннулирующее,
	|	НЕОПРЕДЕЛЕНО										КАК ПредыдущееИзменениеРешения,
	|	
	|	РешениеОПроведенииИнвентаризации.Дата				КАК Дата,
	|	РешениеОПроведенииИнвентаризации.Номер				КАК Номер
	|ИЗ
	|	СвязьДокументРешение
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РешениеОПроведенииИнвентаризации КАК РешениеОПроведенииИнвентаризации
	|		ПО	СвязьДокументРешение.Решение = РешениеОПроведенииИнвентаризации.Ссылка
	|		
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ИзмененияРешений.Решение							КАК Решение,
	|	ИзмененияРешений.РешениеПометкаУдаления				КАК РешениеПометкаУдаления,
	|	ИзмененияРешений.РешениеПроведен					КАК РешениеПроведен,
	|	
	|	ИСТИНА												КАК ЭтоИзменениеРешения,
	|	ИзмененияРешений.ИзменениеРешения					КАК ИзменениеРешения,
