Функция ПолучитьПустуюТаблицуОтметок()
	
	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипБулево = Новый ОписаниеТипов("Булево");
	ТипМассив = Новый ОписаниеТипов("Массив");
	ТипДата = ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата);
	ТипНомерКомиссии = ОбщегоНазначения.ОписаниеТипаЧисло(4,0,ДопустимыйЗнак.Неотрицательный);
	
	ТаблицаОтметок = Новый ТаблицаЗначений();
	ТаблицаОтметок.Колонки.Добавить("Отметка",					ТипБулево);
	ТаблицаОтметок.Колонки.Добавить("КодСтрокиПредставление",	ТипСтрока);
	ТаблицаОтметок.Колонки.Добавить("СчетПредставление",		ТипСтрока);
	ТаблицаОтметок.Колонки.Добавить("СотрудникПредставление",	ТипСтрока);
	ТаблицаОтметок.Колонки.Добавить("КомиссияПредставление",	ТипСтрока);
	ТаблицаОтметок.Колонки.Добавить("НомераСтрок",				ТипМассив);
	ТаблицаОтметок.Колонки.Добавить("НомерСтроки",				Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(4,0,ДопустимыйЗнак.Неотрицательный)));
	
	ТаблицаОтметок.Колонки.Добавить("ДатаИнвентаризации",			ТипДата);
	ТаблицаОтметок.Колонки.Добавить("ДатаНачала",					ТипДата);
	ТаблицаОтметок.Колонки.Добавить("ДатаОкончания",				ТипДата);
	ТаблицаОтметок.Колонки.Добавить("МестоИнвентаризацииПредставление", ТипСтрока);
	
	ТаблицаОтметок.Колонки.Добавить("ПризнакСплошнойИнвентаризации", ТипБулево);
	ТаблицаОтметок.Колонки.Добавить("ПризнакВыборочнойИнвентаризации", ТипБулево);
	ТаблицаОтметок.Колонки.Добавить("ПризнакИнойИнвентаризации", ТипБулево);
	ТаблицаОтметок.Колонки.Добавить("ПримечаниеПредставление", ТипСтрока);
	
	ТаблицаОтметок.Колонки.Добавить("ДокументыОписей",				Новый ОписаниеТипов("ТаблицаЗначений"));
	ТаблицаОтметок.Колонки.Добавить("ПредставлениеДокументовОписей",ТипСтрока);
	ТаблицаОтметок.Колонки.Добавить("СписокДокументовОписей",		Новый ОписаниеТипов("СписокЗначений"));
	ТаблицаОтметок.Колонки.Добавить("ЕстьПроведенный",				ТипБулево);
	
	Возврат ТаблицаОтметок;
	
КонецФункции	

