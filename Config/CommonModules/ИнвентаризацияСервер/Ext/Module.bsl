	НастройкиВарианта.Вставить("РеквизитыТабличнойЧасти",	"КПС");
	НастройкиВарианта.Вставить("ЭлементыФормы",				"");
	ПолучитьНастройкиФормы0504087_ОбработатьТекстовыеНастройки(НастройкиВарианта);
	НеиспользуемыеРеквизиты.Вставить(2, НастройкиВарианта);
	НеиспользуемыеРеквизиты.Вставить(3, НастройкиВарианта);
	
	НастройкиДокумента = Новый Структура();
	НастройкиДокумента.Вставить("ИмяТабличнойЧасти",					"Инвентаризация");
	НастройкиДокумента.Вставить("ИменаКолонокЧисловыхПоказателей",		ИменаКолонок);
	НастройкиДокумента.Вставить("ИмяРеквизитаСчетВШапке",				"Счет");
	НастройкиДокумента.Вставить("УстанавливатьСчетВТабличнойЧасти",		Истина);
	НастройкиДокумента.Вставить("ОтдельныйЭлементДляТабличнойЧасти",	"");
	НастройкиДокумента.Вставить("НеиспользуемыеРеквизиты",				НеиспользуемыеРеквизиты);
	
	Возврат НастройкиДокумента;
	
КонецФункции

Процедура ПолучитьНастройкиФормы0504087_ОбработатьТекстовыеНастройки(НастройкиВарианта)
	
	РеквизитыШапкиСтрокой			= НастройкиВарианта["РеквизитыШапки"];
	РеквизитыТабличнойЧастиСтрокой	= НастройкиВарианта["РеквизитыТабличнойЧасти"];
	
	// Переводим каждое свойство из строки в массив
	Для Каждого Элемент Из НастройкиВарианта Цикл
		
		НастройкиВарианта.Вставить(Элемент.Ключ, СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(Элемент.Значение));
		
	КонецЦикла;
	
	// Добавляем очищающие структуры для удобства дальнейшей очистки неиспользуемых данных
	НастройкиВарианта.Вставить("РеквизитыШапки_ОчищающаяСтруктура",				Новый Структура(РеквизитыШапкиСтрокой));
	НастройкиВарианта.Вставить("РеквизитыТабличнойЧасти_ОчищающаяСтруктура",	Новый Структура(РеквизитыТабличнойЧастиСтрокой));
	
КонецПроцедуры

