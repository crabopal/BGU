Функция УстанавливатьКоличествоПоУмолчанию(ДокументОбъект) Экспорт
	
	Перем Счет;
	
	МассивСчетов = ПолучитьСчетаУстановкиКоличестваПоУмолчанию();
	
	ТипДокумента = ТипЗнч(ДокументОбъект.Ссылка);
	
	Если ТипДокумента = Тип("ДокументСсылка.ИнвентаризацияМЗ") Тогда
		Счет = ДокументОбъект.СчетГруппа;
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ИнвентаризацияОС") Тогда
		Счет = ДокументОбъект.СчетУчета;
		
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
	Возврат (МассивСчетов.Найти(Счет) <> Неопределено);
	
КонецФункции

Процедура Редактирование0504087_РассчитатьРасхождениеВТаблице(Таблица, ИменаКолонок, УстановитьЕстьОтклонения = Ложь) Экспорт
	
	// Предназначен для вызова в случае ВариантФормированияОписи = 1,2,3
	// 1. Опись с 2018 г. Счет в таблице (26 знаков)
	// 2. Опись с 2018 г. Счет в таблице (5 знаков)
	// 3. Опись с 2018 г. Счет в таблице (5 знаков). Одна строка - один объект
	
	СтруктураФормы = Новый Структура();
	
	СтруктураФормы.Вставить("КэшВариантФормированияОписи", Новый Структура());
	
	СтруктураФормы.КэшВариантФормированияОписи.Вставить("ИменаКолонокЧисловыхПоказателей", ИменаКолонок);
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		
		ИнвентаризацияКлиентСервер.Редактирование0504087_РассчитатьРасхождениеВСтроке(СтруктураФормы, СтрокаТаблицы, УстановитьЕстьОтклонения);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура Редактирование0504087_СоздатьКолонкиЧисловыхПоказателей(Таблица, ДокументСсылка, ИменаКолонок) Экспорт
	
	Настройки = ПолучитьНастройкиФормы0504087(ТипЗнч(ДокументСсылка));
	
	ИменаКолонок = Настройки["ИменаКолонокЧисловыхПоказателей"];
	
	ИменаКоличество = Новый Массив();
	ИменаКоличество.Добавить(ИменаКолонок["КоличествоУчет"]);
	ИменаКоличество.Добавить(ИменаКолонок["КоличествоФакт"]);
	ИменаКоличество.Добавить(ИменаКолонок["КоличествоИзлишек"]);
	ИменаКоличество.Добавить(ИменаКолонок["КоличествоНедостача"]);
	ИменаКоличество.Добавить("КоличествоНеСоответствует");
	
	ИменаСумма = Новый Массив();
	ИменаСумма.Добавить(ИменаКолонок["СуммаУчет"]);
	ИменаСумма.Добавить(ИменаКолонок["СуммаФакт"]);
	ИменаСумма.Добавить(ИменаКолонок["СуммаИзлишек"]);
	ИменаСумма.Добавить(ИменаКолонок["СуммаНедостача"]);
	ИменаСумма.Добавить("СуммаНеСоответствует");
	
	ТипКоличество	= ОбщегоНазначения.ОписаниеТипаЧисло(15,3,ДопустимыйЗнак.Неотрицательный);
	ТипСумма		= ОбщегоНазначения.ОписаниеТипаЧисло(15,2,ДопустимыйЗнак.Неотрицательный);
	
	Для Каждого ИмяКолонки Из ИменаКоличество Цикл
		Если Таблица.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
			Таблица.Колонки.Добавить(ИмяКолонки, ТипКоличество);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ИмяКолонки Из ИменаСумма Цикл
		Если Таблица.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
			Таблица.Колонки.Добавить(ИмяКолонки, ТипСумма);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Обрабатывает строки с нулевым количеством: устанавливает Количество, Цену (при наличии колонки), ЕдИзм (при наличии колонки).
Процедура УстановитьКоличествоПоУмолчанию(Таблица, ИменаКолонок, ИспользоватьБалансовуюСтоимость = Истина, НеЗаполнятьЦену = Ложь, ЗаполнитьКолонкуЕдИзм = Ложь) Экспорт
	
	Перем УслЕдИзм;
	
	СчетаУстановкиКоличества = ПолучитьСчетаУстановкиКоличестваПоУмолчанию();
	
	КоличествоПоУмолчанию = ПолучитьКоличествоПоУмолчанию();
	
	ИмяКолонкиКоличество	= ИменаКолонок["КоличествоУчет"];
	ИмяКолонкиСумма			= ИменаКолонок["СуммаУчет"];
	ИмяКолонкиСчет			= "Счет";
	
	ЕстьКолонкаЦена = (Таблица.Колонки.Найти("Цена") <> Неопределено);
	
	Поиск = Новый Структура(ИмяКолонкиКоличество, 0);
	
	МассивСтрок = Таблица.НайтиСтроки(Поиск);
	
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполняющаяСтруктура = Новый Структура();
	ЗаполняющаяСтруктура.Вставить(ИмяКолонкиКоличество, КоличествоПоУмолчанию);
	
	// В этих строках таблицы нулевое количество
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		
		Если СчетаУстановкиКоличества.Найти(СтрокаТаблицы["Счет"]) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗаполнитьКолонкуЕдИзм И НЕ ЗначениеЗаполнено(УслЕдИзм) Тогда
			ПолучитьУсловнуюЕдиницуИзмерения(УслЕдИзм);
			
			Таблица.Колонки.Добавить("ЕдИзм", Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"));
			
			ЗаполняющаяСтруктура.Вставить("ЕдИзм", УслЕдИзм);
		КонецЕсли;
			
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ЗаполняющаяСтруктура);
		
		Если ЕстьКолонкаЦена Тогда
			
			Если ИспользоватьБалансовуюСтоимость Тогда
				// Для балансовой цены номенклатуры
				// цена изменится, потому что мы установили новое значение количества.
				
				Если НЕ НеЗаполнятьЦену Тогда
					СтрокаТаблицы["Цена"] = СтрокаТаблицы[ИмяКолонкиСумма] / КоличествоПоУмолчанию;
				КонецЕсли;
			Иначе
				// Для установленной цены номенклатуры
				// сумма по данным учета изменится, потому что мы установили новое значение количества.
				
				СтрокаТаблицы[ИмяКолонкиСумма] = СтрокаТаблицы["Цена"] * КоличествоПоУмолчанию;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПолучитьУсловнуюЕдиницуИзмерения(УслЕдИзм)
	
	УслЕдИзм = Справочники.КлассификаторЕдиницИзмерения.ЕдиницаИзмеренияПоКоду("876");
	
	Если НЕ ЗначениеЗаполнено(УслЕдИзм) Тогда
		
		ВызватьИсключение НСтр("ru='В справочнике ""Классификатор единиц измерения"" не найден элемент ""Условная единица"", код 876.
			|Этот элемент требуется для дальнейшего заполнения документа инвентаризации.
			|Необходимо добавить в справочник элемент ""Условная единица"", код 876, и повторить заполнение документа инвентаризации.'")
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьУсловноеОформлениеКолонкаЕдИзм(ФормаДокумента, ИмяРеквизитаТаблица, ИмяЭлементаТаблица, ЭтоНоменклатура) Экспорт
	
	Текст = ?(ЭтоНоменклатура, НСтр("ru='<авто>'"), НСтр("ru='шт'"));
	
	НовыйЭлементУО = ФормаДокумента.УсловноеОформление.Элементы.Добавить();
	НовыйЭлементУО.Представление = "Колонка ЕдИзм - надпись ""шт"" при незаполненной единице измерения";
	
	// Условие
	Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект." + ИмяРеквизитаТаблица + ".ЕдИзм");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	// Оформление
	НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ПоясняющийТекст);
	НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", Текст);
	
	// Оформляемые поля
	ОформляемоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяЭлементаТаблица + "ЕдИзм");
	
КонецПроцедуры

#КонецОбласти

#Область ЦепочкиИзмененийРешения

Функция ЕстьДублиСтрокТабличнаяЧастьКомиссии(ДокументОбъект) Экспорт
	
	ДокументСсылка = ДокументОбъект.Ссылка;
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ИзменениеРешенияОПроведенииИнвентаризации") Тогда
		Таблица = ДокументОбъект.Комиссии.Выгрузить();
		
		Поиск = Новый Структура("ТипИзменения", Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Отмена);
		
		МассивСтрок = Таблица.НайтиСтроки(Поиск);
		
		Для Каждого УдаляемаяСтрока Из МассивСтрок Цикл
			Таблица.Удалить(УдаляемаяСтрока);
		КонецЦикла;
	Иначе
		Таблица = ДокументОбъект.Комиссии;
	КонецЕсли;
	
	ТаблицаДублиСтрок = ОбщегоНазначенияБГУ.НайтиДублиСтрок(Таблица, "Комиссия");
	
	Если ТаблицаДублиСтрок.Количество() > 0 Тогда
		ПараметрыВывода = Новый Структура();
		ПараметрыВывода.Вставить("ТаблицаИмя",					"Комиссии");
		ПараметрыВывода.Вставить("ТаблицаПредставление",		НСтр("ru='Инвентаризационные комиссии'"));
		ПараметрыВывода.Вставить("ОбъектСсылка",				ДокументСсылка);
		ПараметрыВывода.Вставить("ИмяПоляДляВыводаСообщений",	"Комиссия");
		
		ОбщегоНазначенияБГУ.ВывестиСообщенияОДубляхСтрок(ТаблицаДублиСтрок, ПараметрыВывода);
		
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция ЕстьНедопустимыеНомераКомиссий(ДокументОбъект) Экспорт
	
	ЕстьНедопустимыеНомера = Ложь;
	
	ТекстШаблон = НСтр("ru='Указан недопустимый номер комиссии ""%1"" (таблица ""Объекты инвентаризации"", строка %2).
		|В табличной части ""Инвентаризационные комиссии"" отсутствует комиссия с таким номером'");
	
	СведенияКомиссий = ПолучитьСведенияКомиссийДляФормыДокумента(ДокументОбъект);
	
	ДеревоАктуальныхКомиссий = СведенияКомиссий.ДеревоАктуальныхКомиссий;
	
	Поиск = Новый Структура("НомерКомиссии,НомерРабочейКомиссии");
	
	Для Каждого СтрокаТаблицы Из ДокументОбъект.Объекты Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.НомерКомиссии) Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаТаблицы);
		
		МассивСтрок = ДеревоАктуальныхКомиссий.Строки.НайтиСтроки(Поиск, Истина);
		
		Если МассивСтрок.Количество() = 0 Тогда
			ЕстьНедопустимыеНомера = Истина;
			
			Индекс = ДокументОбъект.Объекты.Индекс(СтрокаТаблицы);
			
			ИндексТекст = ИнвентаризацияСервер.ФорматироватьИндексСтрокиТаблицыДляВыводаСообщения(Индекс);
			
			НомерСтрокиТекст = Строка(Индекс + 1);
			
			ОбщегоНазначения.СообщитьПользователю(
				СтрШаблон(ТекстШаблон,
					ИнвентаризацияКлиентСервер.ФорматироватьПолныйНомерКомиссии(СтрокаТаблицы.НомерКомиссии, СтрокаТаблицы.НомерРабочейКомиссии),
					НомерСтрокиТекст),
				ДокументОбъект.Ссылка,
				"Объект.Объекты[" + ИндексТекст + "].НомерКомиссии");
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ЕстьНедопустимыеНомера;
	
КонецФункции

// Для одного документа Решения, Изменения решения ищет рабочие комиссии без указания уполномоченного председателем лица и выводит сообщения.
//
// Параметры:
//	ДокументОбъект	- ДокументОбъект.РешениеОПроведенииИнвентаризации,
//					ДокументОбъект.ИзменениеРешенияОПроведенииИнвентаризации	- объект проверяемого документа.
//	ЕстьОшибкиЗаполнения	- Булево	- возвращаемое значение, признак наличия рабочей комиссии без указания уполномоченного председателем лица.
Процедура ПроверитьНаличиеРабочихКомиссийБезУполномоченногоЛицаПоОбъекту(ДокументОбъект, ЕстьОшибкиЗаполнения) Экспорт
	
	Перем ТаблицаНомераСтрок;
	
	ТаблицаКомиссийДокумента = ДокументОбъект.Комиссии.Выгрузить(,"НомерСтроки,Комиссия");
	
	СписокКомиссий = ТаблицаКомиссийДокумента.ВыгрузитьКолонку("Комиссия");
	
	Если Не Справочники.ПостоянноДействующиеКомиссии.ЕстьРабочиеКомиссииБезУполномоченногоЛица(СписокКомиссий, ТаблицаНомераСтрок) Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьОшибкиЗаполнения = Истина;
	
	ТаблицаПроблемныеКомиссии = ТаблицаНомераСтрок.Скопировать(,"Комиссия");
	ТаблицаПроблемныеКомиссии.Свернуть("Комиссия");
	ПроблемныеКомиссии = ТаблицаПроблемныеКомиссии.ВыгрузитьКолонку("Комиссия");
	
	Поиск = Новый Структура("Комиссия");
	
	ТекстШаблонОднаРК		= НСтр("ru='Для рабочей инвентаризационной комиссии ""%1"" комиссии ""%2"" не задано уполномоченное председателем лицо.'");
	ТекстШаблонНесколькоРК	= НСтр("ru='Для рабочих инвентаризационных комиссий ""%1"" комиссии ""%2"" не задано уполномоченное председателем лицо.'");
	
	Для Каждого Комиссия Из ПроблемныеКомиссии Цикл
		Поиск.Комиссия = Комиссия;
		
		МассивСтрок = ТаблицаНомераСтрок.НайтиСтроки(Поиск);
		
		ПредставленияНомеровРК = Новый Массив();
		
		Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
			ПредставленияНомеровРК.Добавить(ИнвентаризацияКлиентСервер.ФорматироватьНомерРабочейКомиссии(СтрокаТаблицы.НомерРабочейКомиссии));
		КонецЦикла;
		
		МассивСтрок = ТаблицаКомиссийДокумента.НайтиСтроки(Поиск);
		
		СтрокаТаблицыКомиссийДокумента = МассивСтрок[0];
		
		ТекстСообщения = СтрШаблон(?(ПредставленияНомеровРК.Количество() = 1, ТекстШаблонОднаРК, ТекстШаблонНесколькоРК),
			ИнвентаризацияКлиентСервер.СократитьСтроку(СтрСоединить(ПредставленияНомеровРК, ","), 15),
			Строка(Комиссия));
		
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
			ДокументОбъект.Ссылка,
			"Объект." + ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Комиссии", СтрокаТаблицыКомиссийДокумента.НомерСтроки, "Комиссия"));
	КонецЦикла;
	
КонецПроцедуры

#Область СоставлениеДерева

Функция ПостроитьДеревоДокументовДляВводаНаОсновании(ДокументСсылка, ЗаполняемыйДокументСсылка, ТаблицыДокументов = Неопределено) Экспорт
	
	Перем РезультатыПоиска, Решение, МаксимальныйУровеньВетвиДокумента, УровеньДокумента, МаксимальныйУровеньДерева;
	Перем АннулирующееИзменениеСсылка, Аннулирующее;
	Перем ПервыйДокумент, ПоследнийДокумент;
	
    Если ТаблицыДокументов = Неопределено Тогда
		ТаблицыДокументов = НайтиДокументыСоставляющиеЦепочки(ДокументСсылка, ЗаполняемыйДокументСсылка);
	КонецЕсли;
	
	РезультатыПоиска = СоставитьДеревоДокументов(ТаблицыДокументов);
	
	ПометкаУдаления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "ПометкаУдаления");
	
	Если ПометкаУдаления Тогда
		ТаблицаОшибок = ПустаяТаблицаСписокОшибокДереваДокументов();
	Иначе
		ГруппироватьПоРешению = Ложь;
		
		ТаблицаОшибок = ДиагностироватьОшибкиДереваДокументов(РезультатыПоиска, ГруппироватьПоРешению);
	КонецЕсли;
	
	ВнеДерева = ДокументВнеДерева(ДокументСсылка, РезультатыПоиска, Решение);
	
	Если ВнеДерева Тогда
		СтрокаРешения = ПолучитьСтрокуДокументаВДереве(Решение, РезультатыПоиска.ДеревоДокументов);
	Иначе
		СтрокаРешения = ПолучитьСтрокуПервоначальногоДокумента(ДокументСсылка, РезультатыПоиска.ДеревоДокументов);
		
		Если СтрокаРешения <> Неопределено Тогда
			ПервыйДокумент = СтрокаРешения.Документ;
		КонецЕсли;
		
		СтрокаДокумента = ПолучитьСтрокуДокументаВДереве(ДокументСсылка, РезультатыПоиска.ДеревоДокументов);
		
		Если СтрокаДокумента <> Неопределено Тогда
			МаксимальныйУровеньВетвиДокумента	= СтрокаДокумента.МаксимальныйУровень;
			УровеньДокумента					= СтрокаДокумента.Уровень;
		КонецЕсли;
		
		СтрокаПоследнегоДокумента = ПолучитьСтрокуПоследнегоДокументаВДереве(СтрокаДокумента);
		
		Если СтрокаПоследнегоДокумента <> Неопределено Тогда
			ПоследнийДокумент = СтрокаПоследнегоДокумента.Документ;
		КонецЕсли;
	КонецЕсли;
	
	Если СтрокаРешения <> Неопределено Тогда
		СтрокаАннулирующегоДокумента = ПолучитьСтрокуАннулирующегоДокумента(СтрокаРешения);
		
		Если СтрокаАннулирующегоДокумента <> Неопределено Тогда
			АннулирующееИзменениеСсылка	= СтрокаАннулирующегоДокумента.Документ;
		КонецЕсли;
		
		МаксимальныйУровеньДерева = СтрокаРешения.МаксимальныйУровень;
	КонецЕсли;
	
	Аннулирующее = ЗначениеЗаполнено(АннулирующееИзменениеСсылка);
	
	Результат = Новый Структура();
	Результат.Вставить("Дерево", Новый Структура());
	Результат.Дерево.Вставить("ДеревоДокументов",				РезультатыПоиска.ДеревоДокументов);
	Результат.Дерево.Вставить("ТаблицаОшибок",					ТаблицаОшибок);
	
	Результат.Дерево.Вставить("Аннулирующее",					Аннулирующее);
	Результат.Дерево.Вставить("АннулирующееИзменениеСсылка",	АннулирующееИзменениеСсылка);
	Результат.Дерево.Вставить("МаксимальныйУровеньДерева",		МаксимальныйУровеньДерева);
	
	Результат.Дерево.Вставить("ПервыйДокумент",					ПервыйДокумент);
	Результат.Дерево.Вставить("ПоследнийДокумент",				ПоследнийДокумент);
	
	Результат.Вставить("ВнеДереваДокументов", РезультатыПоиска.ВнеДереваДокументов);
	
	Результат.Вставить("Документ", Новый Структура());
	Результат.Документ.Вставить("МаксимальныйУровеньВетвиДокумента",	МаксимальныйУровеньВетвиДокумента);
	Результат.Документ.Вставить("УровеньДокумента",						УровеньДокумента);
	Результат.Документ.Вставить("ВнеДерева",							ВнеДерева);
	
	ДопустимоСозданиеИзмененияРешения = (Не ПометкаУдаления И ТаблицаОшибок.Количество() = 0 И Аннулирующее = Ложь);
	
	Если ПометкаУдаления Тогда	
		ТекстОшибки = НСтр("ru='Документ-основание помечен на удаление'");
		
	ИначеЕсли ТаблицаОшибок.Количество() > 0 Тогда	
		ТекстОшибки = НСтр("ru='Обнаружены ошибки построения цепочки документов.
			|Подробности см. на форме документа-основания.'");
		
	ИначеЕсли Аннулирующее = Истина Тогда
		ТекстОшибки = СтрШаблон(
			НСтр("ru='Решение о проведении инвентаризации аннулировано документом %1.'"),
			АннулирующееИзменениеСсылка);
		
	Иначе
		ТекстОшибки = "";
	КонецЕсли;
	
	Результат.Вставить("ДопустимоСозданиеИзмененияРешения",	ДопустимоСозданиеИзмененияРешения);
	Результат.Вставить("ТекстОшибки",						ТекстОшибки);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДанныеВосходящихЦепочек(СписокДокументов, ДокументОбъект = Неопределено, ПечатьРешениеСУчетомИзменений = Ложь, ФорматПечати = "61н") Экспорт
	
	Перем СтрокаПоследнегоДокумента;
	
	// Используется для расчета таблиц сравнения состава комиссий
	// Нисходящие цепочки не требуются
	
	Если СписокДокументов.Количество() > 0 Тогда
		ТаблицыДокументов = НайтиДокументыСоставляющиеЦепочки(СписокДокументов,, Истина);
		
		ОбщаяТаблицаКомиссий = ТаблицыДокументов.ТаблицаКомиссии;
		
		РезультатыПоиска = СоставитьДеревоДокументов(ТаблицыДокументов);
		
		УдалитьНисходящиеЦепочки(РезультатыПоиска, СписокДокументов, ТаблицыДокументов);
		
		ДеревоДокументов = РезультатыПоиска.ДеревоДокументов;
	Иначе
		ДеревоДокументов = ПолучитьПустоеДеревоДокументов();
		
		ОбщаяТаблицаКомиссий = ПолучитьПустуюТаблицуКомиссий();
	КонецЕсли;
	
	// Табличные части Комиссии документов
	
	ДеревоДокументов.Колонки.Добавить("ТаблицаКомиссии", Новый ОписаниеТипов("ТаблицаЗначений"));
	
	ДобавитьВДеревоТабличныеЧастиДокументов(ДеревоДокументов, ОбщаяТаблицаКомиссий);
	
	// Добавляем документ из формы, даже еще незаписанный
	
	Если ДокументОбъект <> Неопределено Тогда
		ДобавитьПоследнийДокументЦепочкиИзФормы(ДеревоДокументов, ОбщаяТаблицаКомиссий, ДокументОбъект);
	КонецЕсли;
	
	ДеревоДокументов.Колонки.Добавить("МаксимальноеКоличествоКомиссий",	ОбщегоНазначения.ОписаниеТипаЧисло(3,0,ДопустимыйЗнак.Неотрицательный));
	
	ЗаполнитьКолонкуМаксимальноеКоличествоКомиссийВоВсемДереве(ДеревоДокументов);
	
	// Общий список ссылок комиссий
	
	ВремТаблица = ОбщаяТаблицаКомиссий.Скопировать(, "Комиссия");
	ВремТаблица.Свернуть("Комиссия");
	МассивКомиссий = ВремТаблица.ВыгрузитьКолонку("Комиссия");
	
	// Расчет сравнения состава комиссий
	
	ДополнительныеПараметры = ПолучитьДополнительныеПараметрыДляРасчетаПодразделовРаздела2(МассивКомиссий, ДокументОбъект, ПечатьРешениеСУчетомИзменений);
	
	ДополнительныеПараметры.Вставить("ПечатьРешениеСУчетомИзменений", ПечатьРешениеСУчетомИзменений);
	
	ДобавитьНастройкиОформленияИзмененныхЗначенийКорректировкиПриказ157н(ДополнительныеПараметры);
	
	Если ДополнительныеПараметры.ВыводитьПризнакМодифицированностиСтроки Тогда
		ФорматПечати = ИнвентаризацияКлиентСервер.ПолучитьФорматПечатиМодифицированныхСтрокИзмененияРешенияДляФормыДокумента();
	КонецЕсли;
	
	ДополнительныеПараметры.Вставить("ФорматПечати", ФорматПечати);
	
	ДеревоДокументов.Колонки.Добавить("ТаблицаПодразделовРаздела2",	Новый ОписаниеТипов("ТаблицаЗначений"));
	
	ЗаполнитьТаблицыСравненияСоставаКомиссийВоВсемДереве(ДеревоДокументов, МассивКомиссий, ДополнительныеПараметры);
	
	Если ПечатьРешениеСУчетомИзменений Тогда
		Для Каждого СтрокаРешения Из ДеревоДокументов.Строки Цикл
			ПреобразоватьТаблицыСравненияСоставаКомиссийВАктуальныеНаДату(СтрокаРешения);
		КонецЦикла;
	КонецЕсли;
	
	// Табличные документы подразделов раздела 2
	
	ЗаполнитьТабличныеДокументыПодразделовРаздела2(ДеревоДокументов, СписокДокументов, ДокументОбъект, ДополнительныеПараметры);
	
	ДанныеВосходящихЦепочек = Новый Структура();
	ДанныеВосходящихЦепочек.Вставить("ДеревоДокументов",	ДеревоДокументов);
	ДанныеВосходящихЦепочек.Вставить("ДанныеКомиссий",		ДополнительныеПараметры.ДанныеКомиссий);
	
	Возврат ДанныеВосходящихЦепочек;
	
КонецФункции

Функция ПостроитьДеревоДокументовДляНастройкиФормыДокумента(ДокументОбъект) Экспорт
	
	Перем РезультатыПоиска;
	
	РешениеСсылка = ПолучитьСсылкуРешения(ДокументОбъект);
	
	ТаблицыДокументов = НайтиДокументыСоставляющиеЦепочки(РешениеСсылка, Неопределено);
	
	РезультатыПоиска = СоставитьДеревоДокументов(ТаблицыДокументов);
	
	Если ДокументОбъект.ПометкаУдаления Тогда
		ТаблицаОшибок = ПустаяТаблицаСписокОшибокДереваДокументов();
	Иначе
		ГруппироватьПоРешению = Ложь;
		
		ТаблицаОшибок = ДиагностироватьОшибкиДереваДокументов(РезультатыПоиска, ГруппироватьПоРешению);
	КонецЕсли;
	
	ЕстьОшибкиЦепочки = (ТаблицаОшибок.Количество() > 0);
	
	КоличествоСтрок = ПолучитьКоличествоСтрокПредыдущихДокументов(ДокументОбъект);
	
	КоличествоСтрокИсходногоРешения				= КоличествоСтрок.Решение;
	КоличествоСтрокПредыдущегоИзмененияРешения	= КоличествоСтрок.ИзменениеРешения;
	
	КоличествоСтрокПредыдущегоДокумента = ?(
		КоличествоСтрокПредыдущегоИзмененияРешения > 0,
		КоличествоСтрокПредыдущегоИзмененияРешения,
		КоличествоСтрокИсходногоРешения);
		
	ОкружающиеДокументыЦепочки = ПолучитьОкружающиеДокументыЦепочки(ДокументОбъект, РезультатыПоиска.ДеревоДокументов);
	
	Результат = Новый Структура();
	Результат.Вставить("ЕстьОшибкиЦепочки",	ЕстьОшибкиЦепочки);
	Результат.Вставить("ТаблицаОшибок",		ТаблицаОшибок);
	
	Результат.Вставить("КоличествоСтрокИсходногоРешения",				КоличествоСтрок.Решение);
	Результат.Вставить("КоличествоСтрокПредыдущегоИзмененияРешения",	КоличествоСтрок.ИзменениеРешения);
	Результат.Вставить("КоличествоСтрокПредыдущегоДокумента",			КоличествоСтрокПредыдущегоДокумента);
	
	Результат.Вставить("ОкружающиеДокументыЦепочки", ОкружающиеДокументыЦепочки);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСтрокуПоследнегоДокументаВосходящейЦепочки(ДеревоДокументов) Экспорт
	
	СтрокаДокумента = ДеревоДокументов.Строки[0];
	
	Пока СтрокаДокумента.Строки.Количество() > 0 Цикл
		СтрокаДокумента = СтрокаДокумента.Строки[0];
	КонецЦикла;
	
	Возврат СтрокаДокумента;
	
КонецФункции

#КонецОбласти

#Область НастройкаФорм

Процедура КэшироватьДанныеКомиссийДокумента(Форма, ОбновитьТабличныеДокументы = Ложь, ИмяЭлементаСтраниц = Неопределено) Экспорт
	
	КэшНаФорме = Новый Структура();
	
	Если ЭтоАдресВременногоХранилища(Форма.АдресХранилища) Тогда
		КэшНаФорме = ПолучитьИзВременногоХранилища(Форма.АдресХранилища);
	КонецЕсли;
	
	Объект = Форма.Объект;
	
	ТабличнаяЧастьКомиссии = Объект.Комиссии;
	
	СведенияКомиссий = ПолучитьСведенияКомиссийДляФормыДокумента(Объект);
	
	ДеревоАктуальныхКомиссий	= СведенияКомиссий.ДеревоАктуальныхКомиссий;
	ТаблицаПредставлений		= СведенияКомиссий.ТаблицаПредставлений;
	
	КэшНаФорме.Вставить("ДеревоАктуальныхКомиссий", ДеревоАктуальныхКомиссий);
	
	// Представления комиссий в табличной части Комиссии
	
	ЗаполнитьПредставленияКомиссийТабличнойЧасти(Форма, ТаблицаПредставлений);
	
	// Табличные документы подразделов раздела 2
	
	Если ОбновитьТабличныеДокументы Тогда
		ТабличныеДокументы = ПолучитьТабличныеДокументыПодразделовРаздела2(Форма);
		
		НастроитьТабличныеДокументыНаФорме(Форма, ТабличныеДокументы, ИмяЭлементаСтраниц); 
	КонецЕсли;
	
	Форма.АдресХранилища = ПоместитьВоВременноеХранилище(КэшНаФорме, Форма.УникальныйИдентификатор);
	
КонецПроцедуры

Процедура КэшироватьТаблицуНастроекЗаполненияОписейПоРешению(Форма) Экспорт
	
	ИмяТаблицыФормы = "ТаблицаНастроекЗаполненияОписейПоРешению";
	
	ТаблицаНастроек = ПолучитьТаблицуНастроекЗаполненияОписейПоРешению(,, Форма.Объект.Организация);
	
	ПодготовитьСчетаВТаблицеНастроек(ТаблицаНастроек);
	
	ДобавитьРеквизитыКолонокТаблицыНастроекЗаполненияОписейПоРешению(Форма, ИмяТаблицыФормы, ТаблицаНастроек);
	
	ТаблицаФормы = Форма[ИмяТаблицыФормы];
	
	ТаблицаФормы.Загрузить(ТаблицаНастроек);
	
	КоличествоСтрок = ТаблицаНастроек.Количество();
	
	Для НомерСтроки = 1 По КоличествоСтрок Цикл
		СтрокаТаблицыФормы = ТаблицаФормы[НомерСтроки - 1];
		СтрокаТаблицыНастроек = ТаблицаНастроек[НомерСтроки - 1];
		
		СтрокаТаблицыФормы.ТаблицаКодовСчетов.Загрузить(СтрокаТаблицыНастроек.ТаблицаКодовСчетов);
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьСведенияКомиссийДляФормыДокумента(ДокументОбъект) Экспорт
	
	ЭтоДокументИзмененияРешения = ЭтоДокументИзмененияРешения(ДокументОбъект);
	
	ИсходныеСведенияКомиссий = ПрочитатьСведенияКомиссийДляФормыДокумента(ДокументОбъект);
	
	ТаблицаПервичныеДокументы	= ИсходныеСведенияКомиссий.ПервичныеДокументы;
	ТаблицаРабочиеКомиссии		= ИсходныеСведенияКомиссий.РабочиеКомиссии;
	МассивСсылок				= ИсходныеСведенияКомиссий.МассивСсылок;
	
	Дерево = ПолучитьПустоеДеревоКомиссийДляФормыДокумента();
	
	ТаблицаПредставлений = ПолучитьПустуюТаблицуПредставленийКомиссийДляФормыДокумента();
	
	ТабличнаяЧастьКомиссии = ДокументОбъект.Комиссии;
	
	УникальныеСсылки = Новый Массив();
	
	// Составляем дерево и таблицу представлений по всем комиссиям
	Для Каждого Комиссия Из МассивСсылок Цикл
		Если НЕ ЗначениеЗаполнено(Комиссия) Тогда
			Продолжить;
		КонецЕсли;
		
		Если УникальныеСсылки.Найти(Комиссия) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		УникальныеСсылки.Добавить(Комиссия);
		
		ДобавитьСведенияКомиссииВДерево(Дерево, ТаблицаПредставлений, Комиссия, ИсходныеСведенияКомиссий, ТабличнаяЧастьКомиссии);
	КонецЦикла;
	
	// Оставляем лишь актуальные комиссии
	Если ЭтоДокументИзмененияРешения Тогда
		УдалитьОтмененныеКомиссии(Дерево, ТабличнаяЧастьКомиссии);
	КонецЕсли;
	
	ЗаполнитьКолонкуНомерКомиссии(Дерево, ТабличнаяЧастьКомиссии, ЭтоДокументИзмененияРешения);
	
	ЗаполнитьКолонкуЧетныйНомерКомиссии(Дерево);
	
	СведенияКомиссий = Новый Структура();
	СведенияКомиссий.Вставить("ДеревоАктуальныхКомиссий",	Дерево);
	СведенияКомиссий.Вставить("ТаблицаПредставлений",		ТаблицаПредставлений);
	
	Возврат СведенияКомиссий;
	
КонецФункции

Процедура ИнициализироватьСостояниеЦепочкиДокументов(Форма) Экспорт
	
	РезультатПроверки = ПостроитьДеревоДокументовДляНастройкиФормыДокумента(Форма.Объект);
	
	ЗаполнитьЗначенияСвойств(Форма, РезультатПроверки, "ЕстьОшибкиЦепочки");
	
	Форма.ОкружающиеДокументыЦепочки = Новый ФиксированнаяСтруктура(РезультатПроверки.ОкружающиеДокументыЦепочки);
	
	АдресХранилищаОшибкиЦепочки = "";
	
	Если РезультатПроверки.ЕстьОшибкиЦепочки Тогда
		ГруппироватьПоРешению = Ложь;
		
		ТабДокумент = ЗаполнитьТабличныйДокументСпискаОшибок(РезультатПроверки.ТаблицаОшибок, ГруппироватьПоРешению);
		
		АдресХранилищаОшибкиЦепочки = ПоместитьВоВременноеХранилище(ТабДокумент, Форма.УникальныйИдентификатор);
	КонецЕсли;
	
	Форма.АдресХранилищаОшибкиЦепочки = АдресХранилищаОшибкиЦепочки;
	
КонецПроцедуры

Процедура НастроитьФормуИндикаторыОшибокЦепочкиДокументов(Форма) Экспорт
	
	ЕстьОшибкиЦепочки = Форма.ЕстьОшибкиЦепочки;
	
	АннулирующееИзменение = Форма.ОкружающиеДокументыЦепочки.Аннулирующий.ДокументСсылка;
	
	ВидимостьРешениеАннулировано = Ложь;
	
	ВидимостьПоследующиеДокументы = Ложь;
	
	Если Не ЕстьОшибкиЦепочки Тогда
		ВидимостьРешениеАннулировано = ЗначениеЗаполнено(АннулирующееИзменение) И АннулирующееИзменение <> Форма.Объект.Ссылка;
		
		Если Не ВидимостьРешениеАннулировано Тогда
			ВидимостьПоследующиеДокументы = ЗначениеЗаполнено(Форма.ОкружающиеДокументыЦепочки.Следующий.ДокументСсылка);
		КонецЕсли;
	КонецЕсли;
	
	Форма.Элементы["ГруппаПометкаУдаления"].Видимость = Форма.Объект.ПометкаУдаления;
	
	Форма.Элементы["ГруппаОшибкиЦепочки"].Видимость = ЕстьОшибкиЦепочки;
	
	Форма.Элементы["ГруппаРешениеАннулировано"].Видимость = ВидимостьРешениеАннулировано;
	
	Форма.Элементы["ГруппаПоследующиеДокументы"].Видимость = ВидимостьПоследующиеДокументы;
	
КонецПроцедуры

Процедура НастроитьФормуИндикаторОкружающиеДокументы(Форма) Экспорт
	
	ДокументСсылка = Форма.Объект.Ссылка;
	
	ЗначенияПараметров = Новый Структура("
		|НадписьДокументЦепочкиПредыдущийНомерИзменения,
		|НадписьДокументЦепочкиСледующийНомерИзменения,
		|НадписьДокументЦепочкиПоследнийНомерИзменения,
		|НадписьДокументЦепочкиПервыйПредставление,
		|НадписьДокументЦепочкиПредыдущийПредставление,
		|НадписьДокументЦепочкиСледующийПредставление,
		|НадписьДокументЦепочкиПоследнийПредставление,
		|НадписьДокументЦепочкиАннулирующийПредставление,
		|НадписьДокументЦепочкиАннулирующийЗаголовок");
	
	ЭтоДокументИзмененияРешения = ИнвентаризацияКлиентСервер.ЭтоДокументИзмененияРешения(Форма.Объект.Ссылка);
	
	ОкружающиеДокументыЦепочки = Форма.ОкружающиеДокументыЦепочки;
	
	// Заголовки
	
	ЗначенияПараметров.НадписьДокументЦепочкиПредыдущийНомерИзменения	= СтрШаблон(НСтр("ru='№%1'"), ОкружающиеДокументыЦепочки.Предыдущий.НомерИзменения);
	ЗначенияПараметров.НадписьДокументЦепочкиСледующийНомерИзменения	= СтрШаблон(НСтр("ru='№%1'"), ОкружающиеДокументыЦепочки.Следующий.НомерИзменения);
	ЗначенияПараметров.НадписьДокументЦепочкиПоследнийНомерИзменения	= СтрШаблон(НСтр("ru='№%1'"), ОкружающиеДокументыЦепочки.Последний.НомерИзменения);
	ЗначенияПараметров.НадписьДокументЦепочкиАннулирующийЗаголовок		= СтрШаблон(НСтр("ru='Изменение №%1'"), ОкружающиеДокументыЦепочки.Аннулирующий.НомерИзменения);
	
	// Номера и даты
	
	ЗначенияПараметров.НадписьДокументЦепочкиПервыйПредставление		= ОкружающиеДокументыЦепочки.Первый.Представление;
	ЗначенияПараметров.НадписьДокументЦепочкиПредыдущийПредставление	= ОкружающиеДокументыЦепочки.Предыдущий.Представление;
	ЗначенияПараметров.НадписьДокументЦепочкиСледующийПредставление		= ОкружающиеДокументыЦепочки.Следующий.Представление;
	ЗначенияПараметров.НадписьДокументЦепочкиПоследнийПредставление		= ОкружающиеДокументыЦепочки.Последний.Представление;
	ЗначенияПараметров.НадписьДокументЦепочкиАннулирующийПредставление	= ОкружающиеДокументыЦепочки.Аннулирующий.Представление;
	
	ЗаполнитьЗначенияСвойств(Форма, ЗначенияПараметров);
	
	// Расчет видимости блоков
	
	Предыдущий	= ОкружающиеДокументыЦепочки.Предыдущий.ДокументСсылка;
	Следующий	= ОкружающиеДокументыЦепочки.Следующий.ДокументСсылка;
	Последний	= ОкружающиеДокументыЦепочки.Последний.ДокументСсылка;
	
	СледующееИзменениеПоследнее = (ЗначениеЗаполнено(Следующий) И ЗначениеЗаполнено(Последний) И Следующий = Последний);
	
	ПоказатьПервый = ЭтоДокументИзмененияРешения;
	
	ПоказатьПредыдущий = ЭтоДокументИзмененияРешения
		И ЗначениеЗаполнено(Предыдущий)
		И ИнвентаризацияКлиентСервер.ЭтоДокументИзмененияРешения(Предыдущий);
	
	ПоказатьСледующий = ЗначениеЗаполнено(Следующий);
	
	ПоказатьПоследний = ЗначениеЗаполнено(Последний)
		И ИнвентаризацияКлиентСервер.ЭтоДокументИзмененияРешения(Последний)
		И Последний <> ДокументСсылка
		И Не СледующееИзменениеПоследнее;
	
	ПоказатьРазделитель1 = ПоказатьПредыдущий И ПоказатьПервый;
	ПоказатьРазделитель2 = ПоказатьСледующий И (ПоказатьПервый Или ПоказатьПредыдущий);
	ПоказатьРазделитель3 = ПоказатьПоследний И (ПоказатьПервый Или ПоказатьПредыдущий Или ПоказатьСледующий);
	
	// Установка видимости блоков
	
	Если ЭтоДокументИзмененияРешения Тогда
		Форма.Элементы.ГруппаДокументЦепочкиПервый.Видимость		= ПоказатьПервый;
		Форма.Элементы.ГруппаДокументЦепочкиПредыдущий.Видимость	= ПоказатьПредыдущий;
	КонецЕсли;
	
	Форма.Элементы.ГруппаДокументЦепочкиСледующий.Видимость	= ПоказатьСледующий;
	Форма.Элементы.ГруппаДокументЦепочкиПоследний.Видимость	= ПоказатьПоследний;
	
	Форма.Элементы.ДекорацияДокументЦепочкиСледующийЯвляетсяПоследним.Видимость		= СледующееИзменениеПоследнее;
	Форма.Элементы.ДекорацияДокументЦепочкиСледующийНеЯвляетсяПоследним.Видимость	= Не СледующееИзменениеПоследнее;
	
	Если ЭтоДокументИзмененияРешения Тогда
		Форма.Элементы.ДекорацияРазделительДокументов1.Видимость	= ПоказатьРазделитель1;
		Форма.Элементы.ДекорацияРазделительДокументов2.Видимость	= ПоказатьРазделитель2;
	КонецЕсли;
	
	Форма.Элементы.ДекорацияРазделительДокументов3.Видимость	= ПоказатьРазделитель3;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеКолонкиТаблицыОбъекты

Процедура ДобавитьУсловноеОформление_ТаблицаОбъекты_МОЛ(ФормаДокумента) Экспорт
	
	ЭлементУО = ФормаДокумента.УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Отметка незаполненного или ошибочно заполненного МОЛ'");
	
	// Условия
	ГруппаИли = ЭлементУО.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаИли.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
	
	// Незаполненный МОЛ
	ГруппаИ1 = ГруппаИли.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаИ1.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
	
	Условие = ГруппаИ1.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Объекты.Сотрудник");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	Условие = ГруппаИ1.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Объекты.ЕстьРеквизитМОЛ");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Истина;
	
	Условие = ГруппаИ1.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Объекты.ОдинаковоеНаличиеРеквизитаМОЛ");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Истина;
	
	// Ошибочно заполненный МОЛ
	ГруппаИ2 = ГруппаИли.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаИ2.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
	
	Условие = ГруппаИ2.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Объекты.Сотрудник");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	
	Условие = ГруппаИ2.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Объекты.ЕстьРеквизитМОЛ");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Ложь;
	
	Условие = ГруппаИ2.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Объекты.ОдинаковоеНаличиеРеквизитаМОЛ");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Истина;
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Истина);
	
	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ОбъектыСотрудник");
	
КонецПроцедуры

Процедура ЗаполнитьСлужебныеКолонкиТаблицыОбъекты(ФормаДокумента) Экспорт
	
	ТабличнаяЧасть = ФормаДокумента.Объект.Объекты;
	
	ТаблицаОбъекты = ТабличнаяЧасть.Выгрузить();
	
	ТаблицаНастроек = ФормаДокумента.ТаблицаНастроекЗаполненияОписейПоРешению;
	
	СопоставитьТаблицыОбъектовИНастроек(ТаблицаОбъекты, ТаблицаНастроек);
	
	Если ИнвентаризацияКлиентСервер.ЭтоДокументИзмененияРешения(ФормаДокумента.Объект.Ссылка) Тогда
		ДатаРешения = НачалоДня(ФормаДокумента.ОкружающиеДокументыЦепочки.Первый.Дата);
	Иначе
		ДатаРешения = НачалоДня(ФормаДокумента.Объект.Дата);
	КонецЕсли;
	
	ЗаполнитьКолонкуКодФормыВТаблицеОбъекты(ТаблицаОбъекты, ТаблицаНастроек, ДатаРешения);
	
	ЗаполнитьКолонкуЕстьРеквизитМОЛВТаблицеОбъекты(ТаблицаОбъекты, ТаблицаНастроек);
	
	СкопироватьКолонкуВТабличнуюЧастьРешения(ТабличнаяЧасть, ТаблицаОбъекты, "КодФормы,ЕстьРеквизитМОЛ,ОдинаковоеНаличиеРеквизитаМОЛ");
	
КонецПроцедуры

Процедура ЗаполнитьСлужебныеКолонкиТаблицыОбъектыВТекущейСтроке(Знач ТаблицаНастроек, СтруктураТекущиеДанные, Знач ДатаРешения) Экспорт
	
	// Повторяет часть колонок таблицы Объекты, от которых зависит расчет служебных колонок
	ТаблицаОбъектыОднаСтрока = Новый ТаблицаЗначений();
	ТаблицаОбъектыОднаСтрока.Колонки.Добавить("Счет",				Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаОбъектыОднаСтрока.Колонки.Добавить("ДатаИнвентаризации",	ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	ТаблицаОбъектыОднаСтрока.Колонки.Добавить("ТипИзменения",		Новый ОписаниеТипов("ПеречислениеСсылка.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации"));
	
	// Служебные колонки
	ДобавитьСлужебныеКолонкиТаблицыОбъекты(ТаблицаОбъектыОднаСтрока);
	
	НоваяСтрока = ТаблицаОбъектыОднаСтрока.Добавить();
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураТекущиеДанные);
	
	СопоставитьТаблицыОбъектовИНастроек(ТаблицаОбъектыОднаСтрока, ТаблицаНастроек);
	
	ЗаполнитьКолонкуКодФормыВТаблицеОбъекты(ТаблицаОбъектыОднаСтрока, ТаблицаНастроек, ДатаРешения);
	
	ЗаполнитьКолонкуЕстьРеквизитМОЛВТаблицеОбъекты(ТаблицаОбъектыОднаСтрока, ТаблицаНастроек);
	
	ЗаполнитьЗначенияСвойств(СтруктураТекущиеДанные, ТаблицаОбъектыОднаСтрока[0], "КодФормы,ЕстьРеквизитМОЛ,ОдинаковоеНаличиеРеквизитаМОЛ");
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеОписей

Функция ПолучитьПараметрыФормыВыбораДанныхИзРешения(ОписьСсылка, РешениеОПроведенииИнвентаризации, УникальныйИдентификатор, ВызыватьИсключение = Истина) Экспорт
	
	Перем РезультатПроверки, ПоследнееИзменение;
	
	ПроверитьВозможностьЗаполненияОписиПоРешению(РешениеОПроведенииИнвентаризации, РезультатПроверки, ВызыватьИсключение);
	
	ПоследнийДокумент = РезультатПроверки.Дерево.ПоследнийДокумент;
	
	ЭтоИзменениеРешения = (ТипЗнч(ПоследнийДокумент) = Тип("ДокументСсылка.ИзменениеРешенияОПроведенииИнвентаризации"));
	
	Если ЭтоИзменениеРешения Тогда
		ПоследнееИзменение = ПоследнийДокумент;
	КонецЕсли;
	
	НастройкиОбъединенияСтрок = ПолучитьНастройкиОбъединенияСтрокДляВыбораИзРешения(ОписьСсылка);
	
	Данные = ПодготовитьДанныеДляВыбораИзРешения(ОписьСсылка, РешениеОПроведенииИнвентаризации, НастройкиОбъединенияСтрок);
	
	РешениеСодержитДанныеДляЗаполненияОписи = (Данные.ДополнительныеПараметры.ГруппыСтрок.Количество() > 0);
		
	Если Не РешениеСодержитДанныеДляЗаполненияОписи И ВызыватьИсключение Тогда
		ТекстСообщения = НСтр("ru='Решение не содержит данных для заполнения описи.
		 	|Заполнение описи по Решению не выполнено.'");
		
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;
	
	ПередаваемаяСтруктура = Новый Структура();
	ПередаваемаяСтруктура.Вставить("Решение",					РешениеОПроведенииИнвентаризации);
	ПередаваемаяСтруктура.Вставить("ПоследнееИзменение",		ПоследнееИзменение);
	ПередаваемаяСтруктура.Вставить("Данные",					Данные);
	ПередаваемаяСтруктура.Вставить("ОписьСсылка",				ОписьСсылка);
	ПередаваемаяСтруктура.Вставить("НастройкиОбъединенияСтрок",	НастройкиОбъединенияСтрок);
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("АдресХранилища", ПоместитьВоВременноеХранилище(ПередаваемаяСтруктура, УникальныйИдентификатор));
	ПараметрыФормы.Вставить("РешениеСодержитДанныеДляЗаполненияОписи", РешениеСодержитДанныеДляЗаполненияОписи);
	
	Возврат ПараметрыФормы;
	
КонецФункции

Функция ПолучитьПустыеНастройкиОбъединенияСтрокДляВыбораИзРешения() Экспорт
	
	Возврат Новый Структура("ПоСчетам,ПоМестамИнвентаризации", Ложь, Ложь);
	
КонецФункции

Функция ПодготовитьДанныеДляВыбораИзРешения(Знач ОписьСсылка, Знач РешениеОПроведенииИнвентаризации, Знач НастройкиОбъединенияСтрок, Знач КэшДанных = Неопределено) Экспорт
	
	Если КэшДанных <> Неопределено Тогда
		Данные = КэшДанных;
	Иначе
		Данные = ПрочитатьДанныеДляВыбораИзРешения(ОписьСсылка, РешениеОПроведенииИнвентаризации);
	КонецЕсли;
	
	РазбитьТаблицуОбъектыНаГруппыСтрок(
		Данные.ДанныеРешения.ТаблицаОбъекты,
		Данные.ДополнительныеПараметры.ТаблицаНастроекПоТипуОписи,
		ТипЗнч(ОписьСсылка),
		Данные.ДополнительныеПараметры,
		НастройкиОбъединенияСтрок);
	
	ЗаполнитьТаблицуОтметокИСписокСотрудников(Данные);
	
	НайтиДокументыОписей(Данные);
	
	Возврат Данные;
	
КонецФункции

Процедура ЗаполнитьОписьПоРешениюИзФормыОписи(ФормаОписи, РезультатВыбора) Экспорт
	
	Перем ТабличнаяЧастьОтборСчетов;
	
	ОбъектОписи = ФормаОписи.Объект;
	
	ПереданнаяСтруктура = ПолучитьИзВременногоХранилища(РезультатВыбора.АдресХранилища);
	
	Данные = ПереданнаяСтруктура.Данные;
	
	ГруппыСтрок = Данные.ДополнительныеПараметры.ГруппыСтрок;
	
	// Для таблицы отметок заранее формируется лишь одна группа строк и далее выбирается лишь одна подгруппа
	ГруппаСтрок = ГруппыСтрок[0];
	
	Подгруппа = ГруппаСтрок.ПодгруппыСтрок[РезультатВыбора.НомерСтроки - 1];
	
	ОпределитьКомиссиюДляПодгруппыСтрок(Данные, Подгруппа);
	
	// Шапка описи
	
	ЗаполнитьШапкуОписиПоРешению(ОбъектОписи, Данные, Подгруппа);
	
	// Табличные части описи
	
	ЗаполнитьСоставКомиссииОписиПоРешению(ОбъектОписи, Данные, Подгруппа);
	
	ЗаполнитьОтборСчетовОписиПоРешению(ОбъектОписи, Данные, Подгруппа);
	
	ЗаполнитьСписокМестИнвентаризацииОписиПоРешению(ОбъектОписи, Данные, Подгруппа);
	
	ЗавершитьЗаполнениеОписиПоРешению(ОбъектОписи, Данные, Подгруппа, РезультатВыбора.НомерСтроки);
	
КонецПроцедуры

Функция ПолучитьНастройкиОбъединенияСтрокДляВыбораИзРешения(Знач ОписьСсылка) Экспорт
	
	НастройкиОбъединенияСтрок = ПолучитьПустыеНастройкиОбъединенияСтрокДляВыбораИзРешения();
	
	Если ТипЗнч(ОписьСсылка) = Тип("Строка") Тогда
		ТипОписи = Тип(СтрШаблон("ДокументСсылка.%1", ОписьСсылка));
	Иначе
		ТипОписи = ТипЗнч(ОписьСсылка);
	КонецЕсли;
	
	Если ТипОписи = Тип("ДокументСсылка.ИнвентаризационнаяОписьНФА") Тогда
		НастройкиОбъединенияСтрок.ПоМестамИнвентаризации = Истина;
		
	ИначеЕсли ТипОписи = Тип("ДокументСсылка.ИнвентаризационнаяОписьРасчетовПоПоступлениям")
		Или ТипОписи = Тип("ДокументСсылка.УдалитьИнвентаризационнаяОписьРасчетовПоПоступлениям")
		Или ТипОписи = Тип("ДокументСсылка.ИнвентаризационнаяОписьРасчетовСКонтрагентами") Тогда
		НастройкиОбъединенияСтрок.ПоСчетам = Истина;
		
	КонецЕсли;
	
	Возврат НастройкиОбъединенияСтрок;
	
КонецФункции

#КонецОбласти

#Область Форматирование

Функция ПолучитьПредставлениеСчетаДляРешения(Знач СтрокаТаблицы, Знач ДляИзмененияРешения = Ложь) Экспорт
	
	ПредставлениеСчета = ПолучитьПредставлениеСчетаДляРешенияСлужебный(СтрокаТаблицы);
	
	Если Не ДляИзмененияРешения Тогда
		Возврат ПредставлениеСчета;
	КонецЕсли;
	
	Результат = Новый Структура();
	
	Результат.Вставить("Актуальный", ПредставлениеСчета);
	
	Если СтрокаТаблицы.ТипИзменения = Перечисления.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Корректировка Тогда
		Результат.Вставить("ДоИзменения", ПолучитьПредставлениеСчетаДляРешенияСлужебный(СтрокаТаблицы, Истина));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ПроверкаДопустимостиПометкиУдаления

Процедура ПроверитьДопустимостьИзмененияПометкиУдаленияПередЗаписьюДокументаЦепочкиРешения(Знач ДокументОбъект, Отказ) Экспорт
	
	// Установка пометки удаления допускается только для самых последних документов цепочки изменений.
	// Сброс пометки удаления допускается только для Решения без изменений.
	// Сброс пометки удаления запрещен для любых Изменений решения.
	
	Если ДокументОбъект.ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	
	ТекущееЗначение	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОбъект.Ссылка, "ПометкаУдаления");
	НовоеЗначение	= ДокументОбъект.ПометкаУдаления;
	
	Если ТекущееЗначение = НовоеЗначение Тогда
		Возврат;
	КонецЕсли;
	
	ПометкаУдаленияУстановлена	= ТекущееЗначение = Ложь И НовоеЗначение = Истина;
	ПометкаУдаленияСброшена		= ТекущееЗначение = Истина И НовоеЗначение = Ложь;
	
	ЭтоИзменениеРешения = ЭтоДокументИзмененияРешения(ДокументОбъект);
	
	Если ЭтоИзменениеРешения И ПометкаУдаленияСброшена Тогда
		Отказ = Истина;
		
		ВызватьИсключение НСтр("ru='Отменено снятие пометки удаления документа.
			|Для документов Изменение решения о проведении инвентаризации не допускается снятие установленной пометки удаления.
			|При необходимости оформите новый документ Изменение решения о проведении инвентаризации.'");
		
		Возврат;
	КонецЕсли;
	
	Если ЭтоИзменениеРешения Тогда
		РешениеСсылка = ДокументОбъект.Решение;
		
		НомерИзмененияПроверяемогоДокумента = ДокументОбъект.НомерИзменения;
	Иначе
		РешениеСсылка = ДокументОбъект.Ссылка;
		
		НомерИзмененияПроверяемогоДокумента = 0;
	КонецЕсли;
	
	КоличествоДокументов = ПолучитьКоличествоПоследующихДокументовЦепочки(РешениеСсылка, ДокументОбъект.Ссылка, НомерИзмененияПроверяемогоДокумента);
	
	Если КоличествоДокументов = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Истина;
	
	ТекстШаблон = НСтр("ru='%1.
		|Обнаружено последующее Изменение решения о проведении инвентаризации (ф. 0510447).
		|Допускается %2 пометки удаления только у самых последних документов цепочки изменений.'");
	
	ТекстЧтоДопускается = ?(ПометкаУдаленияУстановлена, НСтр("ru='установка'"), НСтр("ru='снятие'"));
	
	Если ПометкаУдаленияУстановлена Тогда
		ТекстСообщения = НСтр("ru='Отменена установка пометки удаления документа'");
		
	ИначеЕсли ПометкаУдаленияСброшена Тогда
		ТекстСообщения = НСтр("ru='Отменено снятие пометки удаления документа'");
	КонецЕсли;
	
	ВызватьИсключение СтрШаблон(ТекстШаблон, ТекстСообщения, ТекстЧтоДопускается);
	
КонецПроцедуры

#КонецОбласти

#Область ТабДокОписаниеОшибок

Функция ЗаполнитьТабличныйДокументСпискаОшибок(ТаблицаСписокОшибок, ГруппироватьПоРешению) Экспорт
	
	ТабДокумент = Новый ТабличныйДокумент();
	
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.КлючПараметровПечати = "ПараметрыПечати_СписокОшибокДереваДокументовРешениеОПроведенииИнвентаризации";
	
	Макет = ПолучитьОбщийМакет("ОшибкиЦепочкиИзмененийРешения");
	
	Области = Новый Структура();
	
	Области.Вставить("НаименованиеОшибки",				Макет.ПолучитьОбласть("НаименованиеОшибки"));
	Области.Вставить("ГруппировкаРешение",				Макет.ПолучитьОбласть("ГруппировкаРешение"));

	Области.Вставить("ШапкаПростойСписокДокументов",	Макет.ПолучитьОбласть("ШапкаПростойСписокДокументов"));
	Области.Вставить("СтрокаПростойСписокДокументов",	Макет.ПолучитьОбласть("СтрокаПростойСписокДокументов"));

	Области.Вставить("ШапкаРазличныеУровни",			Макет.ПолучитьОбласть("ШапкаРазличныеУровни"));
	Области.Вставить("СтрокаРазличныеУровни",			Макет.ПолучитьОбласть("СтрокаРазличныеУровни"));

	Области.Вставить("ШапкаДублиДокументов",			Макет.ПолучитьОбласть("ШапкаДублиДокументов"));
	Области.Вставить("СтрокаДублиДокументов	",			Макет.ПолучитьОбласть("СтрокаДублиДокументов"));
	
	Области.Вставить("ШапкаОшибки910",					Макет.ПолучитьОбласть("ШапкаОшибки910"));
	Области.Вставить("СтрокаОшибки910",					Макет.ПолучитьОбласть("СтрокаОшибки910"));
	
	Для Каждого СтрокаОшибки Из ТаблицаСписокОшибок Цикл
		
		КодОшибки = СтрокаОшибки.КодОшибки;
			
		//
		// Наименование ошибки
		//
		ЗначенияПараметров = Новый Структура();
		ЗначенияПараметров.Вставить("Наименование", СтрокаОшибки.Наименование);
		
		Области.НаименованиеОшибки.Параметры.Заполнить(ЗначенияПараметров);
		
		ТабДокумент.Вывести(Области.НаименованиеОшибки);
		
		ТабДокумент.НачатьГруппуСтрок();
		
		Если ГруппироватьПоРешению Тогда
			
			Для Каждого Расшифровка Из СтрокаОшибки.Расшифровка Цикл
				//
				// Группировка по документу Решения
				//
				Ссылка = Расшифровка.Ключ;
				
				Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
					Ссылка = НСтр("ru='<Решение не указано>'");
				КонецЕсли;
				
				ЗначенияПараметров = Новый Структура();
				ЗначенияПараметров.Вставить("Ссылка", Ссылка);
				
				Области.ГруппировкаРешение.Параметры.Заполнить(ЗначенияПараметров);
				
				ТабДокумент.Вывести(Области.ГруппировкаРешение);
				
				ТабДокумент.НачатьГруппуСтрок(, Ложь);
				
				//
				// Таблица
				//
				ВывестиТаблицуОшибок(Расшифровка.Значение, ТабДокумент, Области, КодОшибки);
				
				ТабДокумент.ЗакончитьГруппуСтрок();
			КонецЦикла;
			
		Иначе
			//
			// Таблица
			//
			ВывестиТаблицуОшибок(СтрокаОшибки.Расшифровка, ТабДокумент, Области, КодОшибки);
		КонецЕсли;
		
		ТабДокумент.ЗакончитьГруппуСтрок();
		
	КонецЦикла;
		
	Возврат ТабДокумент;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область ЛистыОзнакомленияСогласования

Функция СоставитьТаблицуСотрудниковДляЗаполненияТабличнойЧастиЛистОзнакомления(Данные) Экспорт
	
	ТаблицаСотрудников = СоставитьОбщуюТаблицуСотрудников(Данные);
	
	СортироватьПоНаименованиюСотрудника(ТаблицаСотрудников);
	
	Возврат ТаблицаСотрудников;
	
КонецФункции

Функция ПолучитьПустуюТаблицуСотрудниковДляЛистаОзнакомления() Экспорт
	
	ТаблицаСотрудников = Новый ТаблицаЗначений();
	ТаблицаСотрудников.Колонки.Добавить("Сотрудник",			Новый ОписаниеТипов(Метаданные.ОпределяемыеТипы.СотрудникДляОзнакомления.Тип));
	ТаблицаСотрудников.Колонки.Добавить("Модифицированность",	Новый ОписаниеТипов("Булево"));
	
	Возврат ТаблицаСотрудников;
	
КонецФункции

Функция ПолучитьДанныеДляЗаполненияТабличнойЧастиЛистСогласования(СогласующиеЛицаСсылка) Экспорт
	
	Если Не ЗначениеЗаполнено(СогласующиеЛицаСсылка) Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("Ссылка", СогласующиеЛицаСсылка);
	ЗапросПоиск.Текст = "ВЫБРАТЬ
	                    |	СписокЛиц.Сотрудник КАК Сотрудник
	                    |ИЗ
	                    |	Справочник.СогласующиеЛица.СписокЛиц КАК СписокЛиц
	                    |ГДЕ
	                    |	СписокЛиц.Ссылка = &Ссылка";
	
	Возврат ЗапросПоиск.Выполнить().Выгрузить();
	
КонецФункции

Процедура ЗаполнитьКолонкиРасположенияСотрудниковВРазделахДокумента(ДокументОбъект) Экспорт
	
	ДокументСсылка = ДокументОбъект.Ссылка;
	
	МассивДокументов = Новый Массив();
	МассивДокументов.Добавить(ДокументСсылка);
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.РешениеОПроведенииИнвентаризации") Тогда
		ТаблицаРасположения = Документы.РешениеОПроведенииИнвентаризации.ПолучитьРасположениеСотрудниковВРазделахДокумента(МассивДокументов);
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ИзменениеРешенияОПроведенииИнвентаризации") Тогда
		ТаблицаРасположения = Документы.ИзменениеРешенияОПроведенииИнвентаризации.ПолучитьРасположениеСотрудниковВРазделахДокумента(МассивДокументов);
		
	Иначе
		Возврат;
	КонецЕсли;
	
	ОчищающаяСтруктура = Новый Структура();
	ОчищающаяСтруктура.Вставить("УказанВРазделе1",	Ложь);
	ОчищающаяСтруктура.Вставить("УказанВРазделе2",	Ложь);
	
	Поиск = Новый Структура();
	
	Для Каждого СтрокаТаблицы Из ДокументОбъект.ЛистОзнакомления Цикл
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ОчищающаяСтруктура);
		
		Поиск.Вставить("Сотрудник", СтрокаТаблицы.Сотрудник);
		
		МассивСтрок = ТаблицаРасположения.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, МассивСтрок[0], "УказанВРазделе1,УказанВРазделе2");
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьДублиСотрудников(ТаблицаСотрудников, ДокументСсылка, ИмяТабличнойЧасти, ПредставлениеТабличнойЧасти, Отказ) Экспорт
	
	КолонкиДублей = "Сотрудник";
	
	ТаблицаДублиСтрок = ОбщегоНазначенияБГУ.НайтиДублиСтрок(ТаблицаСотрудников, КолонкиДублей);
	
	Если ТаблицаДублиСтрок.Количество() > 0 Тогда
		Отказ = Истина;
		
		ПараметрыВывода = Новый Структура();
		ПараметрыВывода.Вставить("ТаблицаИмя",				ИмяТабличнойЧасти);
		ПараметрыВывода.Вставить("ТаблицаПредставление",	ПредставлениеТабличнойЧасти);
		ПараметрыВывода.Вставить("ОбъектСсылка",			ДокументСсылка);
		ПараметрыВывода.Вставить("ШаблонСтроки",			НСтр("ru='Обнаружены дубли сотрудников (таблица ""[ТаблицаПредставление]"", строки [НомераСтрок])'"));
		
		ОбщегоНазначенияБГУ.ВывестиСообщенияОДубляхСтрок(ТаблицаДублиСтрок, ПараметрыВывода);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ДолгосрочнаяЗадолженностьИнвентаризация

Функция ПараметрыЗаполненияДолгосрочнойЗадолженностиИнвентаризации() Экспорт
	
	Параметры = Новый Структура("
		|НаДату,
		|СУчетомИсправленияОшибокПрошлыхЛет,
		|КонецПериодаИсправленияОшибокПрошлыхЛет,
		|ВидЗадолженности,
		|ИспользоватьУчетПоИФО,
		|ИспользоватьКонтрольИсполненияДоговоров");
	
	Возврат Параметры;
	
КонецФункции

Процедура ЗаполнитьДолгосрочнуюЗадолженностьИнвентаризации(ТаблицаОписи, Знач ДокументОбъект, Знач ДополнительныеПараметры) Экспорт
	
	ВидЗадолженности						= ДополнительныеПараметры.ВидЗадолженности;
	ИспользоватьУчетПоИФО					= ДополнительныеПараметры.ИспользоватьУчетПоИФО;
	ИспользоватьКонтрольИсполненияДоговоров	= ДополнительныеПараметры.ИспользоватьКонтрольИсполненияДоговоров;
	
	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2, ДопустимыйЗнак.Любой));
	ТаблицаОписи.Колонки.Добавить("Долгосрочная", ОписаниеТипаСуммы);
	ТаблицаОписи.Колонки.Добавить("Просроченная", ОписаниеТипаСуммы);
	ТаблицаОписи.Колонки.Добавить("ДатаИсполнения", Новый ОписаниеТипов("Дата"));
	ТаблицаОписи.Колонки.Добавить("ПросроченнаяЗадолженностьУстановлена", Новый ОписаниеТипов("Булево"));
	
	Если ИспользоватьКонтрольИсполненияДоговоров Тогда
		
		Если ЗначениеЗаполнено(ДополнительныеПараметры.НаДату) Тогда
			НаДату = ДополнительныеПараметры.НаДату;
		Иначе
			НаДату = ИнвентаризацияКлиентСервер.ПолучитьДатуСрезаРегистровСведенийНакопления52н(ДокументОбъект.ДатаИнвентаризации);
		КонецЕсли;
		
		// Расчет долгосрочной и просроченной задолженности всегда ведется с детализацией по договорам.
		ТаблицаОтбора = ТаблицаОписи.Скопировать(,
			"Контрагент,Договор,Счет,КПС,КФО" + ?(ИспользоватьУчетПоИФО, ",ИФО", ""));
		ТаблицаОтбора30300 = ТаблицаОписи.СкопироватьКолонки(
			"Счет,КПС,КФО" + ?(ИспользоватьУчетПоИФО, ",ИФО", ""));//ВидНалоговИПлатежейНаименование
		СтрокиКУдалению = Новый Массив;
		Для Каждого СтрокаОтбора Из ТаблицаОтбора Цикл
			Если БухгалтерскийУчет.СчетВИерархии(СтрокаОтбора.Счет, "303.00") Тогда
				НоваяСтрока = ТаблицаОтбора30300.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОтбора);
				СтрокиКУдалению.Добавить(СтрокаОтбора);
			КонецЕсли;
		КонецЦикла;
		Для Каждого СтрокаКУдалению Из СтрокиКУдалению Цикл
			ТаблицаОтбора.Удалить(СтрокаКУдалению);
		КонецЦикла;
		
		// Получаем данные анализа задолженности с показателями по долгосрочной и просроченной задолженности.
		ТаблицаОтбора.Колонки.Счет.Имя = "СчетРасчетов";
		КолонкиПоиска = "Контрагент,Договор,СчетРасчетов,КПС,КФО" + ?(ИспользоватьУчетПоИФО, ",ИФО", "");
		ТаблицаОтбора.Свернуть(КолонкиПоиска);
		
		ПараметрыАнализаЗадолженности = КонтрольИсполненияДоговоров.НовыеПараметрыАнализаЗадолженности();
		ПараметрыАнализаЗадолженности.ЗаполнятьСУчетомИсправленияОшибокПрошлыхЛет = ДополнительныеПараметры.СУчетомИсправленияОшибокПрошлыхЛет;
		ПараметрыАнализаЗадолженности.КонецПериодаИсправленияОшибокПрошлыхЛет = ДополнительныеПараметры.КонецПериодаИсправленияОшибокПрошлыхЛет;
		
		АнализЗадолженности = КонтрольИсполненияДоговоров.АнализЗадолженности(
			ДокументОбъект.Организация,
			НаДату,
			ТаблицаОтбора,
			ВидЗадолженности,,
			ПараметрыАнализаЗадолженности);
		
		АнализЗадолженности.Свернуть(КолонкиПоиска + ",Валюта,СрокИсполнения,ВидЗадолженности",
			"Остаток,Краткосрочная,Долгосрочная,Просроченная");
		АнализЗадолженности.Индексы.Добавить(КолонкиПоиска);
		
		// Получаем данные анализа задолженности с показателями по долгосрочной и просроченной задолженности.
		ТаблицаОтбора30300.Колонки.Счет.Имя = "Счет30300";
		КолонкиПоиска30300 = "Счет30300,КПС,КФО" + ?(ИспользоватьУчетПоИФО, ",ИФО", ""); // ,ВидНалоговИПлатежейНаименование
		ТаблицаОтбора30300.Свернуть(КолонкиПоиска30300);
		
		АнализЗадолженности30300 = Отчеты.АнализЗадолженностиПоПлатежамВБюджеты.АнализЗадолженностиПоПлатежамВБюджеты(
			ДокументОбъект.Организация,
			НачалоДня(ДокументОбъект.ДатаИнвентаризации),
			КонецДня(ДокументОбъект.ДатаИнвентаризации),
			ТаблицаОтбора30300);
		
		АнализЗадолженности30300.Свернуть(КолонкиПоиска30300 + ",СрокИсполнения",
			"СуммаКонечныйОстаток,Просроченная");
		АнализЗадолженности30300.Индексы.Добавить(КолонкиПоиска30300);
		
		// Заполним долгосрочную и просроченную в таблице задолженности по данным анализа.
		Для Каждого СтрокаЗадолженности Из ТаблицаОписи Цикл
			Если БухгалтерскийУчет.СчетВИерархии(СтрокаЗадолженности.Счет, "303.00") Тогда
				ЗаполнитьДолгосрочнуюПросроченнуюВСтрокеЗадолженности30300(СтрокаЗадолженности,
					АнализЗадолженности30300, КолонкиПоиска30300, ДокументОбъект.Организация, НаДату);
			Иначе
				ЗаполнитьДолгосрочнуюПросроченнуюВСтрокеЗадолженности(СтрокаЗадолженности,
					АнализЗадолженности, КолонкиПоиска, ДокументОбъект.Организация, НаДату);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Если ДокументОбъект.РежимЗаполнения = 1 Тогда
		ЗаполнитьПросроченнуюЗадолженностьВНеобработанныхСтроках(ТаблицаОписи, ДокументОбъект.ДатаИнвентаризации);
	КонецЕсли;
	ЗаполнитьДатуВозникновенияДляПросроченнойЗадолженности(ТаблицаОписи);
	
	КолонкиГруппировки = "Контрагент,КодЦели" + ?(ДокументОбъект.РежимЗаполнения = 1, ",Договор,ДатаВозникновения,ДатаИсполнения", "")
		+ ",Счет,КПС,КЭК,КФО" + ?(ИспользоватьУчетПоИФО, ",ИФО", "");
		
	ТаблицаОписи.Свернуть(КолонкиГруппировки,
		"Всего,Подтверждено,НеПодтверждено,ИстекСрокДавности,Долгосрочная,Просроченная");
	
КонецПроцедуры

Процедура ЗаполнитьДолгосрочнуюПросроченнуюВСтрокеЗадолженности(СтрокаЗадолженности, АнализЗадолженности, КолонкиПоиска, Организация, НаДату)
	
	ОтборЗадолженности = Новый Структура(КолонкиПоиска);
	ЗаполнитьЗначенияСвойств(ОтборЗадолженности, СтрокаЗадолженности);
	ОтборЗадолженности.СчетРасчетов = СтрокаЗадолженности.Счет;
	Если БухгалтерскийУчет.СчетВИерархии(ОтборЗадолженности.СчетРасчетов, "206.00") Тогда
		// В графиках по договорам с поставщиками счет расчетов всегда 302.хх, приведем счета 206.хх.
		КодСчетаРасчетов = Строка(ОтборЗадолженности.СчетРасчетов);
		ОтборЗадолженности.СчетРасчетов = БухгалтерскийУчет.СчетПоКоду("302." + Прав(КодСчетаРасчетов, 2), НаДату, Организация);
	КонецЕсли;
	
	НайденныеСтроки = АнализЗадолженности.НайтиСтроки(ОтборЗадолженности);
	
	ИспользоватьВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	ИтогОстаток = 0;
	ИтогДолгосрочная = 0;
	ИтогПросроченная = 0;
	МинСрокИсполнения = Дата("00010101000000");
	ВалютаРасчетов = Справочники.Валюты.ПустаяСсылка();
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		
		Если НайденнаяСтрока.Остаток = 0 Тогда
			Продолжить; // Пропускаем строки, на которые не распределены остатки задолженности.
		КонецЕсли;
		
		Если ИспользоватьВалютныйУчет Тогда
			Если Не ЗначениеЗаполнено(ВалютаРасчетов) И ЗначениеЗаполнено(НайденнаяСтрока.Валюта) Тогда
				ВалютаРасчетов = НайденнаяСтрока.Валюта;
			ИначеЕсли ЗначениеЗаполнено(ВалютаРасчетов) И НайденнаяСтрока.Валюта <> ВалютаРасчетов Тогда
				Продолжить; // Не поддерживаются две разные валюты в графике по договору, один договор - одна валюта расчетов.
			КонецЕсли;
		КонецЕсли;
		
		ИтогОстаток = ИтогОстаток + НайденнаяСтрока.Остаток;
		ИтогДолгосрочная = ИтогДолгосрочная + НайденнаяСтрока.Долгосрочная;
		ИтогПросроченная = ИтогПросроченная + НайденнаяСтрока.Просроченная;
		
		Если НайденнаяСтрока.Просроченная <> 0 Тогда // Расчет минимального срока исполнения просроченной задолженности.
			СрокИсполнения = ?(ЗначениеЗаполнено(НайденнаяСтрока.СрокИсполнения), НайденнаяСтрока.СрокИсполнения, Дата("00010101000000"));
			МинСрокИсполнения = ?(НЕ ЗначениеЗаполнено(МинСрокИсполнения), СрокИсполнения, Мин(МинСрокИсполнения, СрокИсполнения));
		КонецЕсли;
		
	КонецЦикла;
	
	Если ИспользоватьВалютныйУчет И ВалютаРасчетов<>ВалютаРегламентированногоУчета И ИтогОстаток>0 Тогда // Расчеты в валюте.
		// Считаем, что график (в валюте) задан на весь остаток задолженности по счету расчетов (в рублях) => расчет через пропорцию. 
		КурсВалютыРасчетов = СтрокаЗадолженности.Всего / ИтогОстаток;
		СтрокаЗадолженности.Долгосрочная   = ИтогДолгосрочная * КурсВалютыРасчетов;
		СтрокаЗадолженности.Просроченная   = ИтогПросроченная * КурсВалютыРасчетов;
		СтрокаЗадолженности.ДатаИсполнения = МинСрокИсполнения;
		СтрокаЗадолженности.ПросроченнаяЗадолженностьУстановлена = Истина;
	ИначеЕсли СтрокаЗадолженности.Всего = ИтогОстаток Тогда // Расчеты в рублях.
		СтрокаЗадолженности.Долгосрочная   = ИтогДолгосрочная;
		СтрокаЗадолженности.Просроченная   = ИтогПросроченная;
		СтрокаЗадолженности.ДатаИсполнения = МинСрокИсполнения;
		СтрокаЗадолженности.ПросроченнаяЗадолженностьУстановлена = Истина;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьДолгосрочнуюПросроченнуюВСтрокеЗадолженности30300(СтрокаЗадолженности, АнализЗадолженности, КолонкиПоиска, Организация, НаДату)
	
	ОтборЗадолженности = Новый Структура(КолонкиПоиска);
	ЗаполнитьЗначенияСвойств(ОтборЗадолженности, СтрокаЗадолженности);
	ОтборЗадолженности.Счет30300 = СтрокаЗадолженности.Счет;
	
	НайденныеСтроки = АнализЗадолженности.НайтиСтроки(ОтборЗадолженности);
	
	ИтогОстаток = 0;
	ИтогПросроченная = 0;
	МинСрокИсполнения = Дата("00010101000000");
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		
		ИтогОстаток = ИтогОстаток + НайденнаяСтрока.СуммаКонечныйОстаток;
		ИтогПросроченная = ИтогПросроченная + НайденнаяСтрока.Просроченная;
		
		Если НайденнаяСтрока.Просроченная <> 0 Тогда // Расчет минимального срока исполнения просроченной задолженности.
			СрокИсполнения = ?(ЗначениеЗаполнено(НайденнаяСтрока.СрокИсполнения), НайденнаяСтрока.СрокИсполнения, Дата("00010101000000"));
			МинСрокИсполнения = ?(НЕ ЗначениеЗаполнено(МинСрокИсполнения), СрокИсполнения, Мин(МинСрокИсполнения, СрокИсполнения));
		КонецЕсли;
		
	КонецЦикла;
	
	СтрокаЗадолженности.Просроченная   = ИтогПросроченная;
	СтрокаЗадолженности.ДатаИсполнения = МинСрокИсполнения;
	СтрокаЗадолженности.ПросроченнаяЗадолженностьУстановлена = Истина;
	
КонецПроцедуры

Процедура ЗаполнитьПросроченнуюЗадолженностьВНеобработанныхСтроках(ТаблицаОписи, ДатаИнвентаризации)
	
	// Задолженность считается просроченной, если у договора задана дата его окончания,
	// и эта дата окончания договора меньше даты инвентаризации.
	
	ТаблицаОписи.Индексы.Добавить("ПросроченнаяЗадолженностьУстановлена");
	Поиск = Новый Структура("ПросроченнаяЗадолженностьУстановлена", Ложь);
	МассивСтрок = ТаблицаОписи.НайтиСтроки(Поиск);
	
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ВремТЗ = ТаблицаОписи.Скопировать(МассивСтрок, "Договор");
	ВремТЗ.Свернуть("Договор");
	
	СписокДоговоров = ВремТЗ.ВыгрузитьКолонку("Договор");
	
	Если ПолучитьФункциональнуюОпцию("СрокИсполненияВРегистреСрокиИсполненияИСуммыОбязательств") Тогда
		СвойстваДоговоров = УчетРасчетов.СрокиИсполненияИСуммыОбязательствПоДоговорам(СписокДоговоров, ДатаИнвентаризации);
	Иначе // Дата исполнения указывается в справочнике "Договоры" в реквизите "Окончание" (закладка "Свойства").
		СвойстваДоговоров = ИнвентаризацияСервер.ПолучитьДатыОкончанияДоговоров(СписокДоговоров);
	КонецЕсли;
	
	Поиск = Новый Структура("Договор");
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		
		Если СтрокаТаблицы.Просроченная <> 0 ИЛИ ЗначениеЗаполнено(СтрокаТаблицы.ДатаИсполнения) Тогда
			Продолжить; // Поля уже заполнены.
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаТаблицы);
		МассивСвойств = СвойстваДоговоров.НайтиСтроки(Поиск);
		Если МассивСвойств.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СвойстваДоговора = МассивСвойств[0];
		
		ОкончаниеДоговора = СвойстваДоговора.ОкончаниеДоговора;
		ДоговорПросрочен = СвойстваДоговора.ДоговорПросрочен;
		
		ОтсутствуетСвойство = (ОкончаниеДоговора = Неопределено ИЛИ ДоговорПросрочен = Неопределено);
		Если ОтсутствуетСвойство ИЛИ НЕ ЗначениеЗаполнено(ОкончаниеДоговора) Тогда
			Продолжить;
		КонецЕсли;
		
		Если НачалоДня(ОкончаниеДоговора) > НачалоДня(ДатаИнвентаризации) ИЛИ НЕ ДоговорПросрочен Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТаблицы.Просроченная = СтрокаТаблицы.Всего;
		СтрокаТаблицы.ДатаИсполнения = ОкончаниеДоговора;
		СтрокаТаблицы.ПросроченнаяЗадолженностьУстановлена = Истина;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьДатуВозникновенияДляПросроченнойЗадолженности(ТаблицаОписи)
	
	// Дата возникновения задолженности в колонке «Просроченная – Дата возникновения» заполняется только для просроченной задолженности.
	Если ТаблицаОписи.Колонки.Найти("ДатаВозникновения") = Неопределено Тогда
		ТаблицаОписи.Колонки.Добавить("ДатаВозникновения", Новый ОписаниеТипов("Дата"));
	КонецЕсли;
	
	Для Каждого СтрокаОписи Из ТаблицаОписи Цикл
		Если ЗначениеЗаполнено(СтрокаОписи.Договор) И СтрокаОписи.Просроченная <> 0 Тогда
			СтрокаОписи.ДатаВозникновения = УчетРасчетов.ДатаВозникновенияЗадолженности(СтрокаОписи.Договор);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Устарела. Следует использовать УчетРасчетов.СрокиИсполненияИСуммыОбязательствПоДоговорам().
Функция ПолучитьДатыОкончанияДоговоров(СписокДоговоров) Экспорт
	
	СписокСвойств = Новый Массив();
	СписокСвойств.Добавить(ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.ОкончаниеДоговора);
	СписокСвойств.Добавить(ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.ДоговорПросрочен);
	
	ВидыДоговоров = Новый Массив();
	
	ПрименятьОтборПоВидуДоговора = (ВидыДоговоров.Количество() > 0);
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("СписокСвойств", СписокСвойств);
	ЗапросПоиск.УстановитьПараметр("СписокДоговоров", СписокДоговоров);
	ЗапросПоиск.УстановитьПараметр("ПрименятьОтборПоВидуДоговора", ПрименятьОтборПоВидуДоговора);
	ЗапросПоиск.УстановитьПараметр("ВидыДоговоров", ВидыДоговоров);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Свойства договоров
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка						КАК Договор,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения.ОкончаниеДоговора) ТОГДА
	|			Значение
	|		ИНАЧЕ
	|			НЕОПРЕДЕЛЕНО
	|	КОНЕЦ)						КАК ОкончаниеДоговора,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА Свойство = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения.ДоговорПросрочен) ТОГДА
	|			Значение
	|		ИНАЧЕ
	|			НЕОПРЕДЕЛЕНО
	|	КОНЕЦ)						КАК ДоговорПросрочен
	|ИЗ
	|	Справочник.Договоры.ДополнительныеРеквизиты
	|ГДЕ
	|	Свойство В (&СписокСвойств)
	|	И Ссылка В (&СписокДоговоров)
	|	И ВЫБОР
	|		КОГДА &ПрименятьОтборПоВидуДоговора ТОГДА
	|			Ссылка.ВидДоговора В(&ВидыДоговоров)
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ
	|СГРУППИРОВАТЬ ПО
	|	Ссылка";
	
	Возврат ЗапросПоиск.Выполнить().Выгрузить();
	
КонецФункции
		
Процедура ОставитьОстаткиТолькоПросроченнойЗадолженности52н(ТаблицаОстатковОписи, ПараметрыПоиска, РежимЗаполнения) Экспорт
	
	ОставитьОстаткиБезОборотовЗаГод = (РежимЗаполнения = 2);
	
	Если ОставитьОстаткиБезОборотовЗаГод Тогда
		НаличиеКолонок = ОпределитьНаличиеКолонокТаблицыОстатковЗадолженности(ТаблицаОстатковОписи);
		
		ТаблицаОборотов = ПолучитьТаблицуОборотовСНачалаГода(ТаблицаОстатковОписи, ПараметрыПоиска, НаличиеКолонок, Истина);
		
		Поиск = Новый Структура(ПолучитьИменаПолейПоискОборотовЗадолженности(НаличиеКолонок));
	КонецЕсли;
	
	КоличествоСтрок = ТаблицаОстатковОписи.Количество();
	
	Для Счетчик = 1 По КоличествоСтрок Цикл
		СтрокаТаблицыОстатков = ТаблицаОстатковОписи[КоличествоСтрок - Счетчик];
		
		Если ЗначениеЗаполнено(СтрокаТаблицыОстатков.Просроченная) Тогда
			// Это просроченная задолженность.
			Продолжить;
		КонецЕсли;
		
		Если ОставитьОстаткиБезОборотовЗаГод Тогда
			ЗаполнитьЗначенияСвойств(Поиск, СтрокаТаблицыОстатков);
			
			МассивСтрокОборотов = ТаблицаОборотов.НайтиСтроки(Поиск);
			
			Если МассивСтрокОборотов.Количество() = 0 Тогда
				// Такой остаток не имеет оборотов за год.
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		ТаблицаОстатковОписи.Удалить(СтрокаТаблицыОстатков);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ДолгосрочнаяЗадолженностьИнвентаризация61н

Функция ПараметрыЗаполненияДолгосрочнойЗадолженностиИнвентаризации61н() Экспорт
	
	Параметры = Новый Структура("
		|ВидЗадолженности,
		|ПараметрыПоиска,
		|СоответствующиеСчетаРасчетов");
	
	Возврат Параметры;
	
КонецФункции

// ПараметрыЗаполнения - Структура - см.ПараметрыЗаполненияДолгосрочнойЗадолженностиИнвентаризации61н()
Процедура ЗаполнитьДолгосрочнуюЗадолженностьИнвентаризации61н(ТаблицаОписи, Знач ПараметрыПроцедуры, Знач ПараметрыЗаполнения) Экспорт
	
	ВидЗадолженности				= ПараметрыЗаполнения.ВидЗадолженности;
	ПараметрыПоиска					= ПараметрыЗаполнения.ПараметрыПоиска;
	СоответствующиеСчетаРасчетов	= ПараметрыЗаполнения.СоответствующиеСчетаРасчетов;
	
	ИспользоватьУчетПоИФО					= ПараметрыПоиска.ИспользоватьУчетПоИФО;
	ИспользоватьКонтрольИсполненияДоговоров	= ПараметрыПоиска.ИспользоватьКонтрольИсполненияДоговоров;
	
	// Заполним дату возникновения задолженности.
	ЗаполнитьДатуВозникновенияЗадолженности61н(ТаблицаОписи);
	
	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	
	ТаблицаОписи.Колонки.Добавить("ДолгосрочнаяВал",						ОписаниеТипаСуммы);
	ТаблицаОписи.Колонки.Добавить("ДолгосрочнаяРуб",						ОписаниеТипаСуммы);
	ТаблицаОписи.Колонки.Добавить("ПросроченнаяВал",						ОписаниеТипаСуммы);
	ТаблицаОписи.Колонки.Добавить("ПросроченнаяРуб",						ОписаниеТипаСуммы);
	ТаблицаОписи.Колонки.Добавить("ДатаИсполнения",							Новый ОписаниеТипов("Дата"));
	ТаблицаОписи.Колонки.Добавить("ПросроченнаяЗадолженностьУстановлена",	Новый ОписаниеТипов("Булево"));
	ТаблицаОписи.Колонки.Добавить("КоличествоПодстрок",						ОбщегоНазначения.ОписаниеТипаЧисло(1, 0, ДопустимыйЗнак.Неотрицательный));
	
	Если ИспользоватьКонтрольИсполненияДоговоров Тогда
		ДатаОпределенияЗадолженности = ПараметрыПоиска.ДатаОстатков;
		
		Если ТипЗнч(ДатаОпределенияЗадолженности) = Тип("Граница") Тогда
			ДатаОпределенияЗадолженности = ДатаОпределенияЗадолженности.Значение;
		КонецЕсли;
		
		ДатаОпределенияЗадолженности = КонецДня(ДатаОпределенияЗадолженности);
		
		// Расчет долгосрочной и просроченной задолженности всегда ведется с детализацией по договорам.
		ТаблицаОтбора = ТаблицаОписи.Скопировать(,
			"Контрагент,Договор,Счет,КПС,КФО,Валюта" + ?(ИспользоватьУчетПоИФО, ",ИФО", ""));
		ТаблицаОтбора.Колонки.Счет.Имя = "СчетРасчетов";
		КолонкиПоиска = "Контрагент,Договор,СчетРасчетов,КПС,КФО,Валюта" + ?(ИспользоватьУчетПоИФО, ",ИФО", "");
		ТаблицаОтбора.Свернуть(КолонкиПоиска);
		
		// Получаем данные анализа задолженности с показателями по долгосрочной и просроченной задолженности.
		АнализЗадолженности = КонтрольИсполненияДоговоров.АнализЗадолженности(
			ПараметрыПроцедуры.Организация,
			ДатаОпределенияЗадолженности,
			ТаблицаОтбора,
			ВидЗадолженности);
		
		АнализЗадолженности.Свернуть(КолонкиПоиска + ",Валюта,СрокИсполнения,ВидЗадолженности",
			"Остаток,Краткосрочная,Долгосрочная,Просроченная");
		АнализЗадолженности.Индексы.Добавить(КолонкиПоиска);
		
		// Заполним долгосрочную и просроченную в таблице задолженности по данным анализа.
		Для Каждого СтрокаЗадолженности Из ТаблицаОписи Цикл
			ЗаполнитьДолгосрочнуюПросроченнуюВСтрокеЗадолженности61н(СтрокаЗадолженности,
				АнализЗадолженности, КолонкиПоиска, ПараметрыПоиска, СоответствующиеСчетаРасчетов);
		КонецЦикла;
		
	КонецЕсли;
	
	ТаблицаОписи.Индексы.Добавить("ПросроченнаяЗадолженностьУстановлена");
	
	ЗаполнитьДолгосрочнуюПросроченнуюЗадолженностьВНеобработанныхСтроках61н(ТаблицаОписи, ПараметрыПроцедуры.ДатаИнвентаризации);
	
	КолонкиГруппировки = "Контрагент,КодЦели,Договор,ДатаВозникновения,ДатаИсполнения"
		+ ",Счет,КПС,КЭК,КФО,Валюта,КоличествоПодстрок" + ?(ИспользоватьУчетПоИФО, ",ИФО", "");
	
	Если ТаблицаОписи.Колонки.Найти("Подразделение") <> Неопределено Тогда
		КолонкиГруппировки = КолонкиГруппировки + ",Подразделение";
	КонецЕсли;
	
	ТаблицаОписи.Свернуть(КолонкиГруппировки,
		"СуммаВал,СуммаРуб,ДолгосрочнаяВал,ДолгосрочнаяРуб,ПросроченнаяВал,ПросроченнаяРуб");
	
КонецПроцедуры

Процедура ЗаполнитьДатуВозникновенияЗадолженности61н(ТаблицаОписи) Экспорт
	
	Если ТаблицаОписи.Колонки.Найти("ДатаВозникновения") = Неопределено Тогда
		ТаблицаОписи.Колонки.Добавить("ДатаВозникновения", Новый ОписаниеТипов("Дата"));
	КонецЕсли;
	
	ВремТаблица = ТаблицаОписи.Скопировать(,"Договор");
	ВремТаблица.Свернуть("Договор");
	
	СписокДоговоров = ВремТаблица.ВыгрузитьКолонку("Договор");
	
	ДатыВозникновенияЗадолженности = УчетРасчетов.ДатыВозникновенияЗадолженности(СписокДоговоров);
	
	Для Каждого СтрокаЗадолженности Из ТаблицаОписи Цикл
		Если Не ЗначениеЗаполнено(СтрокаЗадолженности.Договор) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаЗадолженности.ДатаВозникновения = ДатыВозникновенияЗадолженности.Получить(СтрокаЗадолженности.Договор);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьДолгосрочнуюПросроченнуюВСтрокеЗадолженности61н(СтрокаЗадолженности, АнализЗадолженности, КолонкиПоиска, ПараметрыПоиска, СоответствующиеСчетаРасчетов)
	
	УказанаИностраннаяВалюта = ПараметрыПоиска.ИспользоватьВалютныйУчет И СтрокаЗадолженности.Валюта <> ПараметрыПоиска.ВалютаРУ;
	
	ОтборЗадолженности = Новый Структура(КолонкиПоиска);
	ЗаполнитьЗначенияСвойств(ОтборЗадолженности, СтрокаЗадолженности);
	ОтборЗадолженности.СчетРасчетов = СтрокаЗадолженности.Счет;
	
	// Соответствие счетов 206-302
	СоответствияСчета = СоответствующиеСчетаРасчетов.Получить(ОтборЗадолженности.СчетРасчетов);
	
	Если СоответствияСчета <> Неопределено Тогда
		ОтборЗадолженности.СчетРасчетов = СоответствияСчета;
	КонецЕсли;
	
	ПустаяДата = '00010101';
	
	НайденныеСтроки = АнализЗадолженности.НайтиСтроки(ОтборЗадолженности);
	
	ИтогОстаток			= 0;
	ИтогДолгосрочная	= 0;
	ИтогПросроченная	= 0;
	ДатаИсполнения		= ПустаяДата;
	
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		Если НайденнаяСтрока.Остаток = 0 Тогда
			Продолжить; // Пропускаем строки, на которые не распределены остатки задолженности.
		КонецЕсли;
		
		ИтогОстаток			= ИтогОстаток		+ НайденнаяСтрока.Остаток;
		ИтогДолгосрочная	= ИтогДолгосрочная	+ НайденнаяСтрока.Долгосрочная;
		ИтогПросроченная	= ИтогПросроченная	+ НайденнаяСтрока.Просроченная;
		
		СрокИсполнения = ?(ЗначениеЗаполнено(НайденнаяСтрока.СрокИсполнения), НайденнаяСтрока.СрокИсполнения, ПустаяДата);
		
		ДатаИсполнения = Макс(ДатаИсполнения, СрокИсполнения);
	КонецЦикла;
	
	Если ИтогОстаток <= 0
		Или УказанаИностраннаяВалюта И СтрокаЗадолженности.СуммаВал <> ИтогОстаток
		Или Не УказанаИностраннаяВалюта И СтрокаЗадолженности.СуммаРуб <> ИтогОстаток Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ИтогДолгосрочная)
		И Не ЗначениеЗаполнено(ИтогПросроченная)
		И Не ЗначениеЗаполнено(ДатаИсполнения) Тогда
		Возврат;
	КонецЕсли;
	
	Если УказанаИностраннаяВалюта Тогда
		// Расчеты в валюте.
		// Считаем, что график (в валюте) задан на весь остаток задолженности по счету расчетов (в рублях) => расчет через пропорцию. 
		КурсВалютыРасчетов = ?(ЗначениеЗаполнено(СтрокаЗадолженности.СуммаВал),
			СтрокаЗадолженности.СуммаРуб / СтрокаЗадолженности.СуммаВал,
			0);
			
		СтрокаЗадолженности.ДолгосрочнаяВал	= ИтогДолгосрочная;
		СтрокаЗадолженности.ДолгосрочнаяРуб	= ИтогДолгосрочная * КурсВалютыРасчетов;
		СтрокаЗадолженности.ПросроченнаяВал	= ИтогПросроченная;
		СтрокаЗадолженности.ПросроченнаяРуб	= ИтогПросроченная * КурсВалютыРасчетов;
	Иначе
		// Расчеты в рублях.
		СтрокаЗадолженности.ДолгосрочнаяРуб	= ИтогДолгосрочная;
		СтрокаЗадолженности.ПросроченнаяРуб	= ИтогПросроченная;
	КонецЕсли;
	
	СтрокаЗадолженности.ДатаИсполнения = ДатаИсполнения;
	СтрокаЗадолженности.ПросроченнаяЗадолженностьУстановлена = Истина;
	
	Если ЗначениеЗаполнено(СтрокаЗадолженности.ДолгосрочнаяВал) Или ЗначениеЗаполнено(СтрокаЗадолженности.ДолгосрочнаяРуб) Тогда
		СтрокаЗадолженности.КоличествоПодстрок = СтрокаЗадолженности.КоличествоПодстрок + 1;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаЗадолженности.ПросроченнаяВал) Или ЗначениеЗаполнено(СтрокаЗадолженности.ПросроченнаяРуб) Тогда
		СтрокаЗадолженности.КоличествоПодстрок = СтрокаЗадолженности.КоличествоПодстрок + 1;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьДолгосрочнуюПросроченнуюЗадолженностьВНеобработанныхСтроках61н(ТаблицаОписи, ДатаИнвентаризации)
	
	Поиск = Новый Структура("ПросроченнаяЗадолженностьУстановлена", Ложь);
	МассивСтрок = ТаблицаОписи.НайтиСтроки(Поиск);
	
	Если МассивСтрок.Количество() = 0 Тогда
		// После изменений в функции КонтрольИсполненияДоговоров.АнализЗадолженности() должен всегда приходить сюда.
		// Не должно больше быть строк, в которых ПросроченнаяЗадолженностьУстановлена = Ложь.
		Возврат;
	КонецЕсли;
	
	КонецПериодаКраткосрочнойЗадолженности = КонецДня(ДобавитьМесяц(ДатаИнвентаризации, 12));
	ДатаИсполненияПриНевозможностиУстановления = ИнвентаризацияКлиентСервер.ПолучитьДатуИсполненияПриНевозможностиУстановления();
	
	ВремТЗ = ТаблицаОписи.Скопировать(МассивСтрок, "Договор");
	ВремТЗ.Свернуть("Договор");
	
	СписокДоговоров = ВремТЗ.ВыгрузитьКолонку("Договор");
	
	Если ПолучитьФункциональнуюОпцию("СрокИсполненияВРегистреСрокиИсполненияИСуммыОбязательств") Тогда
		ТаблицаСвойстваДоговоров = УчетРасчетов.СрокиИсполненияИСуммыОбязательствПоДоговорам(СписокДоговоров, ДатаИнвентаризации);
	Иначе // Дата исполнения указывается в справочнике "Договоры" в реквизите "Окончание" (закладка "Свойства").
		ТаблицаСвойстваДоговоров = ПолучитьДатыОкончанияДоговоров(СписокДоговоров);
	КонецЕсли;
	
	Поиск = Новый Структура("Договор");
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		Если СтрокаТаблицы.ПросроченнаяВал <> 0
			Или СтрокаТаблицы.ПросроченнаяРуб <> 0
			Или СтрокаТаблицы.ДолгосрочнаяВал <> 0
			Или СтрокаТаблицы.ДолгосрочнаяРуб <> 0
			Или ЗначениеЗаполнено(СтрокаТаблицы.ДатаИсполнения) Тогда
			// Поля уже заполнены
			Продолжить;
		КонецЕсли;
		
		СтрокаТаблицы.ПросроченнаяЗадолженностьУстановлена = Истина;
		
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаТаблицы);
		
		МассивСвойств = ТаблицаСвойстваДоговоров.НайтиСтроки(Поиск);
		
		Если МассивСвойств.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СвойстваДоговора = МассивСвойств[0];
		
		ОкончаниеДоговора = СвойстваДоговора.ОкончаниеДоговора;
		ДоговорПросрочен = СвойстваДоговора.ДоговорПросрочен;
		
		СтрокаТаблицы.ДатаИсполнения = ОкончаниеДоговора;
		
		УказаноЗначениеДоговорПросрочен = (ТипЗнч(ДоговорПросрочен) = Тип("Булево"));
		УказаноЗначениеОкончаниеДоговора = (ТипЗнч(ОкончаниеДоговора) = Тип("Дата"));
		
		ЗадолженностьПросроченная = Ложь;
		ЗадолженностьДолгосрочная = Ложь;
		
		Если УказаноЗначениеОкончаниеДоговора И ЗначениеЗаполнено(ОкончаниеДоговора) Тогда
			Если КонецПериодаКраткосрочнойЗадолженности < ОкончаниеДоговора
				И ОкончаниеДоговора < ДатаИсполненияПриНевозможностиУстановления Тогда
				ЗадолженностьДолгосрочная = Истина;
				
			ИначеЕсли ОкончаниеДоговора < ДатаИнвентаризации Тогда
				ЗадолженностьПросроченная = Истина;
			КонецЕсли;
			
		ИначеЕсли УказаноЗначениеДоговорПросрочен Тогда
			ЗадолженностьПросроченная = ДоговорПросрочен;
		КонецЕсли;
		
		Если ЗадолженностьПросроченная Тогда
			СтрокаТаблицы.ПросроченнаяВал = СтрокаТаблицы.СуммаВал;
			СтрокаТаблицы.ПросроченнаяРуб = СтрокаТаблицы.СуммаРуб;
			
		ИначеЕсли ЗадолженностьДолгосрочная Тогда
			СтрокаТаблицы.ДолгосрочнаяВал = СтрокаТаблицы.СуммаВал;
			СтрокаТаблицы.ДолгосрочнаяРуб = СтрокаТаблицы.СуммаРуб;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОставитьОстаткиТолькоПросроченнойЗадолженности61н(ТаблицаОстатковОписи, ПараметрыПоискаОборотов, РежимЗаполнения) Экспорт
	
	ОставитьОстаткиБезОборотовЗаГод = (РежимЗаполнения = 2);
	
	Если ОставитьОстаткиБезОборотовЗаГод Тогда
		НаличиеКолонок = ОпределитьНаличиеКолонокТаблицыОстатковЗадолженности(ТаблицаОстатковОписи);
		
		ТаблицаОборотов = ПолучитьТаблицуОборотовСНачалаГода(ТаблицаОстатковОписи, ПараметрыПоискаОборотов, НаличиеКолонок);
		
		Поиск = Новый Структура(ПолучитьИменаПолейПоискОборотовЗадолженности(НаличиеКолонок));
	КонецЕсли;
	
	КоличествоСтрок = ТаблицаОстатковОписи.Количество();
	
	Для Счетчик = 1 По КоличествоСтрок Цикл
		СтрокаТаблицыОстатков = ТаблицаОстатковОписи[КоличествоСтрок - Счетчик];
		
		Если ЗначениеЗаполнено(СтрокаТаблицыОстатков.ПросроченнаяРуб)
			Или ЗначениеЗаполнено(СтрокаТаблицыОстатков.ПросроченнаяВал) Тогда
			// Это просроченная задолженность.
			Продолжить;
		КонецЕсли;
		
		Если ОставитьОстаткиБезОборотовЗаГод Тогда
			ЗаполнитьЗначенияСвойств(Поиск, СтрокаТаблицыОстатков);
			
			МассивСтрокОборотов = ТаблицаОборотов.НайтиСтроки(Поиск);
			
			Если МассивСтрокОборотов.Количество() = 0 Тогда
				// Такой остаток не имеет оборотов за год.
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		ТаблицаОстатковОписи.Удалить(СтрокаТаблицыОстатков);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПустуюДатуПогашенияПоДатеОкончанияДоговора(ТаблицаОписи, ДатаИнвентаризации) Экспорт
	
	Поиск = Новый Структура("ДатаПогашения", '00010101');
	
	МассивСтрокКОбработке = ТаблицаОписи.НайтиСтроки(Поиск);
	
	Если МассивСтрокКОбработке.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ВремТЗ = ТаблицаОписи.Скопировать(МассивСтрокКОбработке, "Договор");
	ВремТЗ.Свернуть("Договор");
	
	СписокДоговоров = ВремТЗ.ВыгрузитьКолонку("Договор");
	
	Если ПолучитьФункциональнуюОпцию("СрокИсполненияВРегистреСрокиИсполненияИСуммыОбязательств") Тогда
		ТаблицаСвойстваДоговоров = УчетРасчетов.СрокиИсполненияИСуммыОбязательствПоДоговорам(СписокДоговоров, ДатаИнвентаризации);
	Иначе // Дата исполнения указывается в справочнике "Договоры" в реквизите "Окончание" (закладка "Свойства").
		ТаблицаСвойстваДоговоров = ПолучитьДатыОкончанияДоговоров(СписокДоговоров);
	КонецЕсли;
	
	Поиск = Новый Структура("Договор");
	
	Для Каждого СтрокаТаблицы Из МассивСтрокКОбработке Цикл
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаТаблицы);
		
		МассивСвойств = ТаблицаСвойстваДоговоров.НайтиСтроки(Поиск);
		
		Если МассивСвойств.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СвойстваДоговора = МассивСвойств[0];
		
		СтрокаТаблицы.ДатаПогашения = СвойстваДоговора.ОкончаниеДоговора;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область АнализОборотовВОписяхРасчетов

Функция ПолучитьПустыеПараметрыПоискаОборотовСНачалаГода() Экспорт
	
	Возврат Новый Структура("Организация,ДатаИнвентаризации,ИспользоватьУчетПоИФО,ИспользоватьУчетПоПодразделениям");
	
КонецФункции

#КонецОбласти

Функция ПолучитьПорциюСведенийСотрудниковНаДату(ТаблицаСотрудников, НаДату) Экспорт
	
	ТребуемыеДанные = "НаименованиеПолное,ДолжностьНаименование,Подразделение";
	
	Поиск = Новый Структура("ДатаОпределенияСведений", НаДату);
	
	СписокСсылок = ТаблицаСотрудников.Скопировать(Поиск, "Сотрудник").ВыгрузитьКолонку("Сотрудник");
	
	СпискиПоТипам = РазбитьНаСотрудниковИКонтрагентов(СписокСсылок);
	
	ПорцияСведений = Справочники.Сотрудники.ПолучитьДанныеСотрудников(СпискиПоТипам.СписокСотрудников, ТребуемыеДанные, НаДату);
	
	ДобавитьСведенияКонтрагентов(ПорцияСведений, СпискиПоТипам.СписокКонтрагентов, НаДату);
	
	Возврат ПорцияСведений;
	
КонецФункции

Процедура ВывестиСтрокиДанныхСУчетомМинимальногоКоличестваСтрок(ТабДок, МассивСтрокДанных, Область, ОчищающаяСтруктура, МинимальноеКоличествоСтрок = 0, КоличествоОчищаемыхПервыхКолонокНачинаяСоВторойСтроки = 0) Экспорт
	
	КоличествоСтрок = МассивСтрокДанных.Количество();
	
	НомерСтроки = 0;
	
	Для Каждого СтрокаДанных Из МассивСтрокДанных Цикл
		
		НомерСтроки = НомерСтроки + 1;
		
		Область.Параметры.Заполнить(СтрокаДанных);
		
		ТабДок.Вывести(Область);
		
		Если НомерСтроки >= 2 И КоличествоОчищаемыхПервыхКолонокНачинаяСоВторойСтроки > 0 Тогда
			
			ОчиститьПервыеКолонкиРанееВыведеннойОбласти(ТабДок, Область, КоличествоОчищаемыхПервыхКолонокНачинаяСоВторойСтроки);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если КоличествоСтрок < МинимальноеКоличествоСтрок Тогда
		
		Область.Параметры.Заполнить(ОчищающаяСтруктура);
		
		Для Счетчик = 1 По (МинимальноеКоличествоСтрок - КоличествоСтрок) Цикл
			
			НомерСтроки = НомерСтроки + 1;
			
			ТабДок.Вывести(Область);
			
			Если НомерСтроки >= 2 И КоличествоОчищаемыхПервыхКолонокНачинаяСоВторойСтроки > 0 Тогда
				
				ОчиститьПервыеКолонкиРанееВыведеннойОбласти(ТабДок, Область, КоличествоОчищаемыхПервыхКолонокНачинаяСоВторойСтроки);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

// Ищет существующие документы такого же вида с совпадающими реквизитами шапки.
//
// Параметры
//	ДокументОбъект
//
// Возвращаемое значение
//	Структура с ключами
//		* Существуют					- Булево	- признак наличия документов
//		* СписокДокументов				- ТаблицаЗначений	- таблица с номерами и датами найденных документов
//		* ПредставлениеСпискаДокументов	- Строка	- представление номеров и дат найденных документов
//		* ТекстСообщения				- Строка	- текст сообщения о результатах поиска
Функция СуществуютАналогичныеДокументы(Знач ДокументОбъект, Знач ПроверяемыеРеквизитыШапки, Знач ЗначениеПроведен=Истина, Знач ЗначениеПометкаУдаления=Ложь) Экспорт
	
	МетаданныеДокумента = Метаданные.НайтиПоТипу(ТипЗнч(ДокументОбъект.Ссылка));
	
	Таблица = ПолучитьАналогичныеДокументы(ДокументОбъект, МетаданныеДокумента, ПроверяемыеРеквизитыШапки, ЗначениеПроведен, ЗначениеПометкаУдаления);
	
	ИсключитьУказанныйДокумент(ДокументОбъект.Ссылка, Таблица);
	
	РезультатПроверки = Новый Структура("
		|Существуют,
		|СписокДокументов,
		|ПредставлениеСпискаДокументов,
		|ТекстСообщения");
	
	ЗаполнитьРезультатПроверки(РезультатПроверки, Таблица, МетаданныеДокумента);
	
	Возврат РезультатПроверки;
	
КонецФункции

Функция ПолучитьКодНФА(Выборка, ДополнительныеПараметры) Экспорт
	
	Если Выборка.НФАЭтоОС Тогда
		// Основное средство
		
		Если ЗначениеЗаполнено(Выборка["ИнвентарныйНомер"]) Тогда
			Возврат Выборка["ИнвентарныйНомер"];
			
		ИначеЕсли ЗначениеЗаполнено(Выборка["НоменклатурныйНомер"]) Тогда
			Возврат Выборка["НоменклатурныйНомер"];
			
		ИначеЕсли ДополнительныеПараметры["Графа3_ВыводитьКодОС"] Тогда
			Возврат Выборка["КодЭлемента"];
		КонецЕсли;
		
	Иначе
		// Номенклатура
		
		Если ЗначениеЗаполнено(Выборка["НоменклатурныйНомер"]) Тогда
			Возврат Выборка["НоменклатурныйНомер"];
			
		ИначеЕсли ДополнительныеПараметры["Графа3_ВыводитьКодМЗ"] Тогда
			Возврат Выборка["КодЭлемента"];
		КонецЕсли;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ПолучитьНаименованиеНФА(Выборка, ДополнительныеПараметры) Экспорт
	
	Если Не Выборка.НФАЭтоОС Тогда
		// Номенклатура
		
		Если ДополнительныеПараметры.Графа2_ВыводитьСубконто3 Тогда
			Субконто3Представление = Выборка["Субконто3Представление"];
			
			Если ЗначениеЗаполнено(Субконто3Представление) Тогда
				Возврат СтрШаблон("%1 (%2)", Выборка["НаименованиеНФА"], Субконто3Представление);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Выборка["НаименованиеНФА"];
	
КонецФункции

Процедура ЗаполнитьИменаДокументовВТаблицеОбъектыРешения(ТаблицаОбъекты) Экспорт
	
	ТаблицаНастроек = ПолучитьТаблицуНастроекЗаполненияОписейПоРешению();
	
	СопоставитьТаблицыОбъектовИНастроек(ТаблицаОбъекты, ТаблицаНастроек);
	
	ТаблицаОбъекты.Колонки.Добавить("ИменаДокументов", Новый ОписаниеТипов("Массив"));
	
	Для Каждого СтрокаТаблицы Из ТаблицаОбъекты Цикл
		СтрокаТаблицы.ИменаДокументов = Новый Массив();
		
		Для Каждого СтрокаНастройки Из СтрокаТаблицы.СопоставленныеСтрокиНастроек Цикл
			СтрокаТаблицы.ИменаДокументов.Добавить(ТаблицаНастроек[СтрокаНастройки.НомерСтрокиТаблицыНастроек - 1].ИмяДокумента);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьКодыФормВТаблицеОбъектыРешения(ТаблицаОбъекты, Организация, ДатаРешения) Экспорт
	
	ТаблицаНастроек = ПолучитьТаблицуНастроекЗаполненияОписейПоРешению(,, Организация);
	
	СопоставитьТаблицыОбъектовИНастроек(ТаблицаОбъекты, ТаблицаНастроек);
	
	ЗаполнитьКолонкуКодФормыВТаблицеОбъекты(ТаблицаОбъекты, ТаблицаНастроек, ДатаРешения);
	
КонецПроцедуры

Функция ПолучитьПредставлениеСтатусаОбъектаДляИнвентаризации(СтатусОбъекта) Экспорт
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтатусОбъекта, "Наименование,НаименованиеПолное");
	
	Если ЗначениеЗаполнено(ЗначенияРеквизитов.НаименованиеПолное) Тогда
		Возврат ЗначенияРеквизитов.НаименованиеПолное;
	КонецЕсли;
	
	Возврат ЗначенияРеквизитов.Наименование;
	
КонецФункции

Функция ПолучитьДанныеКомиссийДляПечатиРешения(МассивКомиссий) Экспорт
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивСсылок", МассивКомиссий);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Реквизиты комиссий
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка		КАК Ссылка,
	|	Временная	КАК Временная
	|ИЗ
	|	Справочник.ПостоянноДействующиеКомиссии
	|ГДЕ
	|	Ссылка В(&МассивСсылок)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Реквизиты первичных документов, определяющих состав комиссии
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка				КАК Ссылка,
	|	НаименованиеПриказа	КАК Наименование,
	|	НомерПриказа		КАК Номер,
	|	ДатаПриказа			КАК Дата
	|ИЗ
	|	Справочник.ПостоянноДействующиеКомиссии
	|ГДЕ
	|	Ссылка В(&МассивСсылок)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Составы комиссий
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка,
	|	Сотрудник,
	|	СтатусЧленаКомиссии,
	|	НомерРабочейКомиссии,
	|	ОтветственныйИсполнитель,
	|	ВЫБОР
	|		КОГДА СтатусЧленаКомиссии = ЗНАЧЕНИЕ(Перечисление.СтатусыЧленовКомиссии.Председатель) ТОГДА
	|			1
	|		КОГДА СтатусЧленаКомиссии = ЗНАЧЕНИЕ(Перечисление.СтатусыЧленовКомиссии.ЗаместительПредседателя) ТОГДА
	|			2
	|		КОГДА СтатусЧленаКомиссии = ЗНАЧЕНИЕ(Перечисление.СтатусыЧленовКомиссии.УполномоченноеПредседателемЛицо) ТОГДА
	|			3
	|		ИНАЧЕ
	|			4
	|	КОНЕЦ КАК Порядок
	|ИЗ
	|	Справочник.ПостоянноДействующиеКомиссии.СоставКомиссии
	|ГДЕ
	|	Ссылка В(&МассивСсылок)
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	Порядок,
	|	НомерРабочейКомиссии,
	|	НомерСтроки
	|;";
	
	РезультатыЗапроса = ЗапросПоиск.ВыполнитьПакет();
	
	Результат = Новый Структура();
	
	// [0]. Реквизиты комиссий
	Результат.Вставить("Шапки", РезультатыЗапроса[0].Выгрузить());
	
	// [1]. Реквизиты первичных документов, определяющих состав комиссии
	Результат.Вставить("АктыОСоставеКомиссий", РезультатыЗапроса[1].Выгрузить());
	
	// [2]. Составы комиссий
	Результат.Вставить("СоставыКомиссий", РезультатыЗапроса[2].Выгрузить());
	
	Возврат Результат;
	
КонецФункции

Процедура ПроверитьНаличиеСтрокВТабличнойЧасти(Знач Объект, Знач ИмяТЧ, Отказ, Знач ТекстСообщения = Неопределено) Экспорт
	
	Если Объект[ИмяТЧ].Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекстСообщения = Неопределено Тогда
		МетаданныеТЧ = Объект.Ссылка.Метаданные().ТабличныеЧасти[ИмяТЧ];
		
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Список", "Заполнение",,, МетаданныеТЧ.Синоним);
	КонецЕсли;
	
	ОбщегоНазначения.СообщитьПользователю(
		ТекстСообщения,
		Объект.Ссылка, ИмяТЧ,
		"Объект", Отказ);
	
КонецПроцедуры

Процедура ПроверитьЗаполненностьРеквизитовШапки(Знач ДокументОбъект, Знач ИменаРеквизитов, Отказ) Экспорт
	
	Если ТипЗнч(ИменаРеквизитов) = Тип("Строка") Тогда
		МассивИмен = СтрРазделить(ИменаРеквизитов, ", ");
		
	ИначеЕсли ТипЗнч(ИменаРеквизитов) = Тип("Массив") Тогда
		МассивИмен = ИменаРеквизитов;
	Иначе
		ИмяПроцедуры = "ПроверитьЗаполненностьРеквизитовШапки";
		ИмяПараметра = "ИменаРеквизитов";
		
		ВызватьИсключение СтрШаблон(
			НСтр("ru='Некорректный тип параметра %1 процедуры %2(). Ожидается тип значения Строка или Массив.'"),
			ИмяПараметра, ИмяПроцедуры);
	КонецЕсли;
	
	ДокументСсылка = ДокументОбъект.Ссылка;
	
	МетаданныеДокумента = ДокументСсылка.Метаданные();
	
	Для Каждого ИмяРеквизита Из МассивИмен Цикл
		Если Не ЗначениеЗаполнено(ДокументОбъект[ИмяРеквизита]) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение",
				МетаданныеДокумента.Реквизиты[ИмяРеквизита].Синоним);
				
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументСсылка,, "Объект." + ИмяРеквизита, Отказ);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#Область ПечатьТаблицыСРазбивкойНаСтраницы

Функция ПолучитьПараметрыВыводаТаблицы() Экспорт
	
	// Имена экспортных процедур ожидаются в формате:
	//	<Общий модуль>.<Имя процедуры>				- для процедур, расположенных в общих модулях
	//	Документы.<Вид документа>.<Имя процедуры>	- для процедур, расположенных в модулях менеджеров документов
	
	ИменаПроцедур = Новый Структура("
		|РассчитатьИтогиПоСтранице,
		|РассчитатьИтогиПоТаблице,
		|ЗаполнитьОбластьСтрокаТаблицы,
		|ЗаполнитьОбластиИтоговПоСтранице,
		|ЗаполнитьОбластиИтоговПоТаблице");
	
	Области = Новый Структура("
		|Заголовок,
		|ШапкаТаблицы,
		|СтрокаТаблицы,
		|ИтогиПоСтраницеЧислами,
		|ИтогиПоСтраницеПрописью,
		|ИтогиПоТаблицеЧислами,
		|ИтогиПоТаблицеПрописью,
		|ПустаяСтрока");
	
	Выборки = Новый Структура("
		|ДетальныеЗаписи,
		|ИтогиТаблицы");
	
	// Предназначается для хранения произвольных промежуточных данных в течение вывода таблицы
	ДополнительныеПараметры = Новый Структура();
	
	Параметры = Новый Структура();
	Параметры.Вставить("НастройкиВывода",			ПолучитьНастройкиВыводаТаблицыПоУмолчанию());
	Параметры.Вставить("ИменаПроцедур",				ИменаПроцедур);
	Параметры.Вставить("Области",					Области);
	Параметры.Вставить("Итоги",						ПолучитьПустыеИтоги());
	Параметры.Вставить("Выборки",					Выборки);
	Параметры.Вставить("СтатистикаВывода",			ПолучитьПустуюСтатистикуВывода());
	Параметры.Вставить("ДополнительныеПараметры",	ДополнительныеПараметры);
	Параметры.Вставить("Служебные",					ПолучитьПустуюСлужебнуюСтруктуру());
	Параметры.Вставить("ТабличныйДокумент");
	
	Возврат Параметры;
	
КонецФункции

Процедура ВывестиТаблицуСРазбивкойНаСтраницы(Параметры) Экспорт
	
	ПроверитьПараметрыВыводаТаблицы(Параметры);
	
	Параметры.СтатистикаВывода.КоличествоСтрок = Параметры.Выборки.ДетальныеЗаписи.Количество();
	
	ИмяПроцедурыЗаполнитьОбластьСтрокаТаблицы = Параметры.ИменаПроцедур.ЗаполнитьОбластьСтрокаТаблицы;
	
	// Итоги по странице
	
	ИмяПроцедурыРассчитатьИтогиПоСтранице = Параметры.ИменаПроцедур.РассчитатьИтогиПоСтранице;
	
	ИмяПроцедурыЗаполнитьОбластиИтоговПоСтранице = Параметры.ИменаПроцедур.ЗаполнитьОбластиИтоговПоСтранице;
	
	ИспользоватьПользовательскуюПроцедуруРассчитатьИтогиПоСтранице = (Параметры.НастройкиВывода.ВыводитьИтогиПоСтранице И ЗначениеЗаполнено(ИмяПроцедурыРассчитатьИтогиПоСтранице));
	
	ИспользоватьПользовательскуюПроцедуруЗаполнитьОбластиИтоговПоСтранице = (Параметры.НастройкиВывода.ВыводитьИтогиПоСтранице И ЗначениеЗаполнено(ИмяПроцедурыЗаполнитьОбластиИтоговПоСтранице));
	
	ВывестиИтогиПоСтраницеЧислами = (Параметры.НастройкиВывода.ВыводитьИтогиПоСтранице И Параметры.Области.ИтогиПоСтраницеЧислами <> Неопределено);
	
	ВывестиИтогиПоСтраницеПрописью = (Параметры.НастройкиВывода.ВыводитьИтогиПоСтранице И Параметры.Области.ИтогиПоСтраницеПрописью <> Неопределено);
	
	//РассчитатьИтогиПоСтранице = (Параметры.НастройкиВывода.ВыводитьИтогиПоСтранице И ЗначениеЗаполнено(ИмяПроцедурыРассчитатьИтогиПоСтранице));
	//
	//ЗаполнитьОбластиИтоговПоСтранице = (Параметры.НастройкиВывода.ВыводитьИтогиПоСтранице И ЗначениеЗаполнено(ИмяПроцедурыЗаполнитьОбластиИтоговПоСтранице));
	//
	//ВывестиИтогиПоСтраницеЧислами = (Параметры.НастройкиВывода.ВыводитьИтогиПоСтранице И Параметры.Области.ИтогиПоСтраницеЧислами <> Неопределено);
	//
	//ВывестиИтогиПоСтраницеПрописью = (Параметры.НастройкиВывода.ВыводитьИтогиПоСтранице И Параметры.Области.ИтогиПоСтраницеПрописью <> Неопределено);
	
	
	
	
	// Итоги по таблице
	
	ИмяПроцедурыРассчитатьИтогиПоТаблице = Параметры.ИменаПроцедур.РассчитатьИтогиПоТаблице;
	
	ИмяПроцедурыЗаполнитьОбластиИтоговПоТаблице = Параметры.ИменаПроцедур.ЗаполнитьОбластиИтоговПоТаблице;
	
	
	
	ИспользоватьПользовательскуюПроцедуруРассчитатьИтогиПоТаблице = (Параметры.НастройкиВывода.ВыводитьИтогиПоТаблице И ЗначениеЗаполнено(ИмяПроцедурыРассчитатьИтогиПоТаблице));
	
	ИспользоватьПользовательскуюПроцедуруЗаполнитьОбластиИтоговПоТаблице = (Параметры.НастройкиВывода.ВыводитьИтогиПоТаблице И ЗначениеЗаполнено(ИмяПроцедурыЗаполнитьОбластиИтоговПоТаблице));
	
	ВывестиИтогиПоТаблицеЧислами = (Параметры.НастройкиВывода.ВыводитьИтогиПоТаблице И Параметры.Области.ИтогиПоТаблицеЧислами <> Неопределено);
	
	ВывестиИтогиПоТаблицеПрописью =	(Параметры.НастройкиВывода.ВыводитьИтогиПоТаблице И Параметры.Области.ИтогиПоТаблицеПрописью <> Неопределено);
	
	//РассчитатьИтогиПоТаблице = (Параметры.НастройкиВывода.ВыводитьИтогиПоТаблице И ЗначениеЗаполнено(ИмяПроцедурыРассчитатьИтогиПоТаблице));
	//
	//ЗаполнитьОбластиИтоговПоТаблице = (Параметры.НастройкиВывода.ВыводитьИтогиПоТаблице И ЗначениеЗаполнено(ИмяПроцедурыЗаполнитьОбластиИтоговПоТаблице));
	//
	//ВывестиИтогиПоТаблицеЧислами = (Параметры.НастройкиВывода.ВыводитьИтогиПоТаблице И Параметры.Области.ИтогиПоТаблицеЧислами <> Неопределено);
	//
	//ВывестиИтогиПоТаблицеПрописью = (Параметры.НастройкиВывода.ВыводитьИтогиПоТаблице И Параметры.Области.ИтогиПоТаблицеПрописью <> Неопределено);
	
	
	
	// Автоматический расчет итогов по таблице
	Если ВывестиИтогиПоТаблицеЧислами Тогда
		ИнициализироватьИтоги(Параметры);
		
		Параметры.Области.ИтогиПоТаблицеЧислами.Параметры.Заполнить(Параметры.Итоги.ПоТаблице);
	КонецЕсли;
	
	// Проверка вывода
	ПроверкаВывода = ПолучитьНастройкиПроверкиВывода(Параметры);
	
	// Пустые строки на последней странице
	ВывестиПустыеСтроки = (Параметры.НастройкиВывода.ДозаполнитьПустымиСтроками И Параметры.Области.ПустаяСтрока <> Неопределено);
	
	// Новая страница
	ОдностраничныйДокумент = Новый ТабличныйДокумент();
	ЗаполнитьЗначенияСвойств(ОдностраничныйДокумент, Параметры.ТабличныйДокумент, "КлючПараметровПечати");
	Параметры.Служебные.Вставить("ОдностраничныйДокумент", ОдностраничныйДокумент);
	
	ТабличныйДокумент = Параметры.ТабличныйДокумент;
	
	Если Параметры.СтатистикаВывода.КоличествоСтрок = 0 Тогда
		
		Проверка = ВыбратьПроверкуВывода(ПроверкаВывода, Параметры);
		
		ОбновитьЗаполняемыеОбластиПроверкиВывода(Параметры, Проверка);
		
		Если Не ТабличныйДокумент.ПроверитьВывод(Проверка.МассивОбластей) Тогда
			
			ЗавершитьТекущуюСтраницу(ТабличныйДокумент, Параметры, ВывестиИтогиПоСтраницеЧислами, ВывестиИтогиПоСтраницеПрописью);
			
			НачатьНовуюСтраницу(ТабличныйДокумент, Параметры, ВывестиИтогиПоСтраницеЧислами);
			
		КонецЕсли;
		
		ВывестиНачалоТаблицы(ТабличныйДокумент, Параметры);
		
	КонецЕсли;
	
	Пока Параметры.Выборки.ДетальныеЗаписи.Следующий() Цикл
		
		Параметры.СтатистикаВывода.НомерСтроки = Параметры.СтатистикаВывода.НомерСтроки + 1;
		
		Параметры.Области.СтрокаТаблицы.Параметры.Заполнить(Параметры.Выборки.ДетальныеЗаписи);
		
		Если ЗначениеЗаполнено(ИмяПроцедурыЗаполнитьОбластьСтрокаТаблицы) Тогда
			
			Выполнить ИмяПроцедурыЗаполнитьОбластьСтрокаТаблицы + "(Параметры.Области.СтрокаТаблицы, Параметры.Выборки.ДетальныеЗаписи, Параметры.СтатистикаВывода, Параметры.ДополнительныеПараметры)";
			
		КонецЕсли;
		
		Проверка = ВыбратьПроверкуВывода(ПроверкаВывода, Параметры);
		
		ОбновитьЗаполняемыеОбластиПроверкиВывода(Параметры, Проверка);
		
		Если Не ТабличныйДокумент.ПроверитьВывод(Проверка.МассивОбластей) Тогда
			
			ЗавершитьТекущуюСтраницу(ТабличныйДокумент, Параметры, ВывестиИтогиПоСтраницеЧислами, ВывестиИтогиПоСтраницеПрописью);
			
			НачатьНовуюСтраницу(ТабличныйДокумент, Параметры, ВывестиИтогиПоСтраницеЧислами);
			
			Если Параметры.НастройкиВывода.ПовторятьШапку И Параметры.СтатистикаВывода.ВыведеноСтрокВсего > 0 Тогда
				
				ТабличныйДокумент.Вывести(Параметры.Области.ШапкаТаблицы);
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если Параметры.СтатистикаВывода.ВыведеноСтрокВсего = 0 Тогда
			
			ВывестиНачалоТаблицы(ТабличныйДокумент, Параметры);
			
		КонецЕсли;
		
		ТабличныйДокумент.Вывести(Параметры.Области.СтрокаТаблицы);
		
		Параметры.СтатистикаВывода.ВыведеноСтрокВсего = Параметры.СтатистикаВывода.ВыведеноСтрокВсего + 1;
		
		Параметры.СтатистикаВывода.ВыведеноСтрокНаТекущейСтранице = Параметры.СтатистикаВывода.ВыведеноСтрокНаТекущейСтранице + 1;
		
		Если ВывестиИтогиПоСтраницеЧислами Тогда
			УвеличитьИтогиПоСтранице(Параметры);
			
			Параметры.Области.ИтогиПоСтраницеЧислами.Параметры.Заполнить(Параметры.Итоги.ПоСтранице);
		КонецЕсли;
		
		Если ИспользоватьПользовательскуюПроцедуруРассчитатьИтогиПоСтранице Тогда
			
			Выполнить ИмяПроцедурыРассчитатьИтогиПоСтранице + "(Параметры.Итоги.ПоСтранице, Параметры.Выборки.ДетальныеЗаписи, Параметры.СтатистикаВывода, Параметры.ДополнительныеПараметры)";
			
		КонецЕсли;
		
		Если ИспользоватьПользовательскуюПроцедуруЗаполнитьОбластиИтоговПоСтранице Тогда
			
			Выполнить ИмяПроцедурыЗаполнитьОбластиИтоговПоСтранице + "(Параметры.Области.ИтогиПоСтраницеЧислами, Параметры.Области.ИтогиПоСтраницеПрописью, Параметры.Итоги.ПоСтранице, Параметры.СтатистикаВывода, Параметры.ДополнительныеПараметры)";
			
		КонецЕсли;
		
	КонецЦикла;
	
	//
	// Итоги по таблице
	// Рассчитываем, но не выводим
	//
	
	Если Параметры.СтатистикаВывода.КоличествоСтрок = 0 Тогда
		
		// Итоги по странице пока еще ни разу не были ни рассчитаны, ни выведены в области.
		
		Если ВывестиИтогиПоСтраницеЧислами Тогда
			Параметры.Области.ИтогиПоСтраницеЧислами.Параметры.Заполнить(Параметры.Итоги.ПоСтранице);
		КонецЕсли;
		
		Если ИспользоватьПользовательскуюПроцедуруРассчитатьИтогиПоСтранице Тогда
			
			Выполнить ИмяПроцедурыРассчитатьИтогиПоСтранице + "(Параметры.Итоги.ПоСтранице, Параметры.Выборки.ДетальныеЗаписи, Параметры.СтатистикаВывода, Параметры.ДополнительныеПараметры)";
			
		КонецЕсли;
		
		Если ИспользоватьПользовательскуюПроцедуруЗаполнитьОбластиИтоговПоСтранице Тогда
			
			Выполнить ИмяПроцедурыЗаполнитьОбластиИтоговПоСтранице + "(Параметры.Области.ИтогиПоСтраницеЧислами, Параметры.Области.ИтогиПоСтраницеПрописью, Параметры.Итоги.ПоСтранице, Параметры.СтатистикаВывода, Параметры.ДополнительныеПараметры)";
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ИспользоватьПользовательскуюПроцедуруРассчитатьИтогиПоТаблице Тогда
		
		Выполнить ИмяПроцедурыРассчитатьИтогиПоТаблице + "(Параметры.Итоги.ПоТаблице, Параметры.Выборки.ИтогиТаблицы, Параметры.СтатистикаВывода, Параметры.ДополнительныеПараметры)";
		
	КонецЕсли;
	
	Если ИспользоватьПользовательскуюПроцедуруЗаполнитьОбластиИтоговПоТаблице Тогда
		
		Выполнить ИмяПроцедурыЗаполнитьОбластиИтоговПоТаблице + "(Параметры.Области.ИтогиПоТаблицеЧислами, Параметры.Области.ИтогиПоТаблицеПрописью, Параметры.Итоги.ПоТаблице, Параметры.СтатистикаВывода, Параметры.ДополнительныеПараметры)";
		
	КонецЕсли;
	
	//
	// Пустые строки до конца страницы
	//
	
	Если ВывестиПустыеСтроки Тогда
		
		ОбластьПустаяСтрока = Параметры.Области.ПустаяСтрока;
		
		// Для проверки вывода используем набор областей последней строки,
		// где область строки таблицы заменена на область пустой строки.
		
		Проверка = ПроверкаВывода.НесколькоСтрокТаблицыПоследняяСтрока;
		
		ОбновитьЗаполняемыеОбластиПроверкиВывода(Параметры, Проверка);
		
		МассивОбластей = Проверка.МассивОбластей;
		
		МассивОбластей[0] = ОбластьПустаяСтрока;
		
		Пока ТабличныйДокумент.ПроверитьВывод(МассивОбластей) Цикл
			
			ТабличныйДокумент.Вывести(ОбластьПустаяСтрока);
			
		КонецЦикла;
		
	КонецЕсли;
	
	//
	// Итоги по таблице
	// Выводим
	// При необходимости, выводим сначала итоги по странице, и сразу за ними - итоги по таблице
	//
	
	Если ВывестиИтогиПоСтраницеЧислами Тогда
		
		ТабличныйДокумент.Вывести(Параметры.Области.ИтогиПоСтраницеЧислами);
		
	КонецЕсли;
	
	Если ВывестиИтогиПоТаблицеЧислами Тогда
		
		ТабличныйДокумент.Вывести(Параметры.Области.ИтогиПоТаблицеЧислами);
		
	КонецЕсли;
	
	Если ВывестиИтогиПоСтраницеПрописью Тогда
		
		ТабличныйДокумент.Вывести(Параметры.Области.ИтогиПоСтраницеПрописью);
		
	КонецЕсли;
			
	Если ВывестиИтогиПоТаблицеПрописью Тогда
		
		ТабличныйДокумент.Вывести(Параметры.Области.ИтогиПоТаблицеПрописью);
		
	КонецЕсли;
	
	Если Параметры.СтатистикаВывода.ПрименяетсяОдностраничныйДокумент Тогда
		Параметры.ТабличныйДокумент.Вывести(ТабличныйДокумент);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОчиститьИтогиИСтатистикуВывода(Параметры) Экспорт
	
	Параметры.Итоги = ПолучитьПустыеИтоги();
	
	Параметры.СтатистикаВывода = ПолучитьПустуюСтатистикуВывода();
	
	Параметры.Служебные = ПолучитьПустуюСлужебнуюСтруктуру();
	
КонецПроцедуры

#КонецОбласти

#Область ВыводСКонтролемРазбивкиНаСтраницы

Процедура ВывестиСКонтролемРазбивкиНаСтраницы(ТабДокПриемник, ТабДокИсточник, ВысотаПервогоБлокаСтрокИсточника, ВысотаВторогоИПоследующихБлоковСтрокИсточника = Неопределено) Экспорт
	
	ПроверитьВысотыБлоковСтрок(ВысотаПервогоБлокаСтрокИсточника, ВысотаВторогоИПоследующихБлоковСтрокИсточника);
	
	БлокиСтрок = РазбитьТабДокНаБлокиСтрокПоВысоте(ТабДокИсточник, ВысотаПервогоБлокаСтрокИсточника, ВысотаВторогоИПоследующихБлоковСтрокИсточника);
	
	МассивОбластей = Новый Массив();
	
	МассивОбластей.Добавить(Неопределено);
	
	Для Каждого БлокСтрок Из БлокиСтрок Цикл
		
		ТекущаяОбласть = ТабДокИсточник.ПолучитьОбласть(БлокСтрок.НомерПервойСтроки,, БлокСтрок.НомерПоследнейСтроки);
		
		МассивОбластей[0] = ТекущаяОбласть;
		
		Если НЕ ТабДокПриемник.ПроверитьВывод(МассивОбластей) Тогда
			
			ТабДокПриемник.ВывестиГоризонтальныйРазделительСтраниц();
			
		КонецЕсли;
		
		ТабДокПриемник.Вывести(ТекущаяОбласть);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область РазбиениеТекстаНаБлокиСтрок

// Добавляет описание одного блока строк.
//
// Параметры:
//	БлокиСтрок					- любая переменная, массив	- формируемая коллекция описаний блоков;
//	МаксимальноеКоличествоСтрок	- число от 1 до 1000		- при достижении указанного количества строк будет начат следующий блок;
//	МаксимальнаяДлинаСтроки		- число от 5 до 1000		- при достижении указанного количества символов будет начата следующая строка.
Процедура ДобавитьОписаниеБлокаСтрок(БлокиСтрок, МаксимальноеКоличествоСтрок = Неопределено, МаксимальнаяДлинаСтроки, ИмяОбластиМакета = Неопределено) Экспорт
	
	Если ТипЗнч(БлокиСтрок) <> Тип("Массив") Тогда
		БлокиСтрок = Новый Массив();
	КонецЕсли;
	
	Описание = Новый Структура();
	Описание.Вставить("МаксимальноеКоличествоСтрок",	МаксимальноеКоличествоСтрок);
	Описание.Вставить("МаксимальнаяДлинаСтроки",		МаксимальнаяДлинаСтроки);
	Описание.Вставить("Строки",							Новый Массив());
	Описание.Вставить("ИмяОбластиМакета",				ИмяОбластиМакета);
	
	БлокиСтрок.Добавить(Описание);
	
КонецПроцедуры

// Разбивает строку текста на блоки строк. Текст может быть многострочным.
//
// Блоков строк может быть произвольное количество.
// Каждый блок строк состоит из одной или более строк одинаковой длины.
// Все строки внутри блока имеют одинаковую длину (в символах).
//
// Разбиение текста на блоки строк выполняется следующим образом:
//	1) Формируется описание блоков строк, их количество и параметры;
//	2) Начинается вывод текста. Вывод начинается в самый первый блок;
//	3) Когда заполнена первая строка первого блока, добавляется новая строка.
//	4) Эта новая строка находится в первом блоке, если пока не превышено
//		максимальное количество строк первого блока;
//	5) Если уже достигнуто максимальное количество строк первого блока,
//		то начинается вывод в следующий по порядку блок (второй).
//		Длина строки следующего блока отличается от длины строки предыдущего.
//	6) И так далее, до окончания выводимого текста.
//	7) Если израсходованы уже все строки во всех блоках, а текст еще не выведен полностью,
//		то остаток текста выводится в самую последнюю строку самого последнего блока.
//		При этом, конечно, в такой последней строке будет превышена максимальная длина строки.
//
// Параметры:
//	Текст				- Строка	- Исходный текст, который необходимо разбить на строки. Может быть многострочным.
//
//	БлокиСтрок			- Массив	- Коллекция описаний блоков строк.
//						Описание очередного блока добавляется с помощью процедуры ДобавитьОписаниеБлокаСтрок(...)
//
//	ПараметрыОбработки	- Структура	- Определяет способ формирования строк.
//						Опциональный параметр.
//						Может содержать ключи:
//		* МинимизироватьРазрывыСтрок	- Булево	- Если очередное выводимое слово
//										является длинным, и не помещается в текущую строку,
//										но помещается в следующую, то такое слово будет
//										перенесено целиком в следующую строку, без разрыва.
//										Такой вариант выглядит более читаемым.
//										Значение по умолчанию: Истина
//		* ВоспроизводитьПереводыСтроки	- Булево	- Применяется только при обработке многострочного текста.
//										Если текст содержит переводы строк, то может требоваться сохранить
//										такое его форматирование, и выводить новые строки
//										действительно с новых строк блоков.
//										Значение по умолчанию: Истина
//	
// Возвращаемое значение:
//	БлокиСтрок.Строки	- Массив строк	- Дозаполняется переданная входная коллекция БлокиСтрок.
//						В свойство Строки добавляется результат разбиения для соответствующего блока.
//
// Пример использования:
//	
//	Перем БлокиСтрок;
//	
//	Текст = "Однажды, в студеную зимнюю пору,
//		|Я из лесу вышел; был сильный мороз.
//		|Гляжу, поднимается медленно в гору
//		|Лошадка, везущая хворосту воз.
//		|И, шествуя важно, в спокойствии чинном,
//		|Лошадку ведет под уздцы мужичок";
//	
//	// Блок 1
//	ДобавитьОписаниеБлокаСтрок(БлокиСтрок, 1, 20);
//	
//	// Блок 2
//	ДобавитьОписаниеБлокаСтрок(БлокиСтрок, 10, 10);
//	
//	РазбитьТекстНаБлокиСтрок(Текст, БлокиСтрок);
//	
//	НомерБлока = 0;
//	
//	Для Каждого Блок Из БлокиСтрок Цикл
//		НомерБлока = НомерБлока + 1;
//		НомерСтрокиВнутриБлока = 0;
//		
//		Для Каждого Строка Из Блок.Строки Цикл
//			НомерСтрокиВнутриБлока = НомерСтрокиВнутриБлока + 1;
//			
//			НоваяСтрока = Объект.БлокиСтрок.Добавить();
//			НоваяСтрока.Строка = Строка;
//			НоваяСтрока.НомерБлока = НомерБлока;
//			НоваяСтрока.НомерСтрокиВнутриБлока = НомерСтрокиВнутриБлока;
//			НоваяСтрока.ДлинаСтроки = СтрДлина(Строка);
//		КонецЦикла;
//	КонецЦикла;
Процедура РазбитьТекстНаБлокиСтрок(Текст, БлокиСтрок, ПараметрыОбработки = Неопределено) Экспорт
	
	Перем ОставшиесяСлова;
	
	ПроверитьКорректностьОписанийБлоковСтрок(БлокиСтрок);
	
	ПроверитьКорректностьПараметровОбработки(ПараметрыОбработки);
	
	РазделительСлов = " ";
	
	ПараметрыОбработки.Вставить("РазделительСлов", РазделительСлов);
	
	Если ПараметрыОбработки.ВоспроизводитьПереводыСтроки Тогда
		
		МассивСтрок = СтрРазделить(Текст, Символы.ПС, Истина);
		
		УдалитьКрайниеПустыеСтроки(МассивСтрок);
		
	Иначе
		
		Текст = СокрЛП(СтрЗаменить(Текст, Символы.ПС, РазделительСлов));
		
		МассивСтрок = Новый Массив();
		МассивСтрок.Добавить(Текст);
		
	КонецЕсли;
	
	СтатистикаБлока = ИнициализироватьСтатистикуБлока(1, БлокиСтрок);
	
	Для Каждого ТекСтрока Из МассивСтрок Цикл
		РазбитьСтрокуНаБлокиСтрок(ТекСтрока, БлокиСтрок, СтатистикаБлока, ПараметрыОбработки);
	КонецЦикла;
	
	// Если текст не поместился в отведенное количество строк,
	// то принудительно вписываем его в самую последнюю строку
	Если ПараметрыОбработки.Свойство("ОставшиесяСлова", ОставшиесяСлова) Тогда
		
		Строки = БлокиСтрок[БлокиСтрок.ВГраница()].Строки;
		
		ПоследняяСтрока = Строки[Строки.ВГраница()];
		
		ПоследняяСтрока = ПоследняяСтрока
			+ ?(ЗначениеЗаполнено(ПоследняяСтрока), ПараметрыОбработки.РазделительСлов, "")
			+ ОставшиесяСлова;
			
		Строки[Строки.ВГраница()] = ПоследняяСтрока;
		
	КонецЕсли;
	
КонецПроцедуры

// Формирует многострочный табличный документ, содержащий Текст.
// Текст разбивается на блоки строк.
Функция РазбитьТекстНаБлокиСтрокИВывестиВТабличныйДокумент(Текст, БлокиСтрок, Макет, МинимальноеКоличествоСтрок = Неопределено, ИмяПараметраОбласти = "Текст") Экспорт
	
	МаксимальноеКоличествоСтрокГлобальная = 1000;
	
	ИнвентаризацияСервер.РазбитьТекстНаБлокиСтрок(Текст, БлокиСтрок);
	
	ТабДокумент = Новый ТабличныйДокумент();
	
	НомерБлока = 0;
	
	ВыведеноСтрок = 0;
	
	ЗначенияПараметров = Новый Структура();
	
	Для Каждого Блок Из БлокиСтрок Цикл
		
		НомерБлока = НомерБлока + 1;
		
		ЗаполняемаяОбласть = Макет.ПолучитьОбласть(Блок.ИмяОбластиМакета);
		
		Для Каждого Строка Из Блок.Строки Цикл
			ЗначенияПараметров.Вставить(ИмяПараметраОбласти, Строка);
			
			ЗаполняемаяОбласть.Параметры.Заполнить(ЗначенияПараметров);
			
			ТабДокумент.Вывести(ЗаполняемаяОбласть);
			
			ВыведеноСтрок = ВыведеноСтрок + 1;
		КонецЦикла;
		
	КонецЦикла;
	
	Если МинимальноеКоличествоСтрок = Неопределено
		ИЛИ ВыведеноСтрок >= МинимальноеКоличествоСтрок Тогда
		Возврат ТабДокумент;
	КонецЕсли;
	
	// Гарантируем минимальное количество выведенных строк текста.
	// Добавляем пустые строки, начиная с самого первого блока.
	// При достижении максимального количества строк блока
	// переходим к выводу пустых строк следующего блока.
	
	КоличествоСтрокНеобходимоДобавитьВсего = (МинимальноеКоличествоСтрок - ВыведеноСтрок);
	
	КоличествоСтрокДобавлено = 0;
	
	Для Каждого Блок Из БлокиСтрок Цикл
		
		ОбластьПустойСтроки = Макет.ПолучитьОбласть(Блок.ИмяОбластиМакета);
		
		КоличествоСтрокВБлокеМаксимальное = ?(Блок.МаксимальноеКоличествоСтрок <> Неопределено,
			Блок.МаксимальноеКоличествоСтрок,
			МаксимальноеКоличествоСтрокГлобальная);
			
		КоличествоСтрокВБлокеСвободно = (КоличествоСтрокВБлокеМаксимальное - Блок.Строки.Количество());
		
		Для Счетчик = 1 По КоличествоСтрокВБлокеСвободно Цикл
			ТабДокумент.Вывести(ОбластьПустойСтроки);
			
			КоличествоСтрокДобавлено = КоличествоСтрокДобавлено + 1;
			
			Если КоличествоСтрокДобавлено >= КоличествоСтрокНеобходимоДобавитьВсего Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если КоличествоСтрокДобавлено >= КоличествоСтрокНеобходимоДобавитьВсего Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТабДокумент;
	
КонецФункции

#КонецОбласти

#Область СерииДокументов

#Область ПанельСерииДокументов

Процедура НастроитьПанельСерииДокументовНаФормеОписи(ФормаДокумента) Экспорт
	
	ОписьСсылка = ФормаДокумента.Объект.Ссылка;
	
	ЭлементПанельСерииДокументовЗаголовочныйДокумент	= ФормаДокумента.Элементы.ПанельСерииДокументовЗаголовочныйДокумент;
	
	ЭлементПанельСерииДокументовСодержательныйДокумент	= ФормаДокумента.Элементы.ПанельСерииДокументовСодержательныйДокумент;
	ЭлементДекорацияПорядковыйНомер						= ФормаДокумента.Элементы.ДекорацияПорядковыйНомер;
	ЭлементДекорацияЗаголовочныйДокументГиперссылка		= ФормаДокумента.Элементы.ДекорацияЗаголовочныйДокументГиперссылка;
	
	ЭлементПанельСерииДокументовЗаголовочныйДокумент.Видимость		= Ложь;
	ЭлементПанельСерииДокументовСодержательныйДокумент.Видимость	= Ложь;
	
	МассивДокументов = Новый Массив();
	МассивДокументов.Добавить(ОписьСсылка);
	
	СерииДокументов = ПрочитатьСерииДокументов(МассивДокументов);
	
	СвойстваСерииДокументов = СерииДокументов.Получить(ОписьСсылка);
	
	Если СвойстваСерииДокументов = Неопределено Тогда
		ФормаДокумента.ДанныеПанелиСерииДокументов = Неопределено;
		
		Возврат;
	КонецЕсли;
	
	// Удаляем таблицу значений. На форме документа она не используется, и не может быть передана на форму.
	СвойстваСерииДокументов.СвойстваСерии.ОбщиеСвойства.Удалить("СписокДокументовСерии");
	
	Если СвойстваСерииДокументов.СвойстваДокумента.ЭтоЗаголовочныйДокумент Тогда
		ЭлементПанельСерииДокументовЗаголовочныйДокумент.Видимость		= Истина;
		ЭлементПанельСерииДокументовСодержательныйДокумент.Видимость	= Ложь;
		
	ИначеЕсли СвойстваСерииДокументов.СвойстваДокумента.ЭтоСодержательныйДокумент Тогда
		ЭлементПанельСерииДокументовЗаголовочныйДокумент.Видимость		= Ложь;
		ЭлементПанельСерииДокументовСодержательныйДокумент.Видимость	= Истина;
		
		ПредставлениеПорядковыйНомер = ФормаДокумента.Объект.ПорядковыйНомерДокументаВСерииДокументов;
		ПредставлениеКоличествоДокументов = ФормаДокумента.Объект.КоличествоДокументовВСерииДокументов;
		
		Если Не ЗначениеЗаполнено(ПредставлениеПорядковыйНомер) Тогда
			ПредставлениеПорядковыйНомер = "?";
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ПредставлениеКоличествоДокументов) Тогда
			ПредставлениеКоличествоДокументов = "?";
		КонецЕсли;
		
		ЭлементДекорацияПорядковыйНомер.Заголовок = СтрШаблон(НСтр("ru='Порядковый номер %1 из %2.'"),
			ПредставлениеПорядковыйНомер,
			ПредставлениеКоличествоДокументов);
			
		Если ЗначениеЗаполнено(СвойстваСерииДокументов.СвойстваСерии.ОбщиеСвойства.ЗаголовочныйДокументСсылка) Тогда
			ЭлементДекорацияЗаголовочныйДокументГиперссылка.Заголовок = СтрШаблон(НСтр("ru='Заголовочный документ %1 от %2'"),
				СвойстваСерииДокументов.СвойстваСерии.ОбщиеСвойства.ЗаголовочныйДокументНомер,
				Формат(СвойстваСерииДокументов.СвойстваСерии.ОбщиеСвойства.ЗаголовочныйДокументДата, "ДФ=дд.ММ.гггг"));
		Иначе
			ЭлементДекорацияЗаголовочныйДокументГиперссылка.Заголовок = НСтр("ru='Заголовочный документ не найден'");
		КонецЕсли;
		
		ЭлементДекорацияЗаголовочныйДокументГиперссылка.ЦветТекста = 
			?(ЗначениеЗаполнено(СвойстваСерииДокументов.СвойстваСерии.ОбщиеСвойства.ЗаголовочныйДокументСсылка),
				Новый Цвет(),
				ЦветаСтиля.ТекстПредупреждающейНадписи);
	КонецЕсли;
	
	ФормаДокумента.ДанныеПанелиСерииДокументов = Новый ФиксированнаяСтруктура(СвойстваСерииДокументов);
	
КонецПроцедуры

// Параметры:
//	МассивДокументов	- Массив	- ссылки ДокументСсылка одного вида (типа).
//						Не предполагается передача ссылок на документы разных видов.
Функция ПрочитатьСерииДокументов(МассивДокументов) Экспорт
	
	ОбъектМетаданныхДокумент = Метаданные.НайтиПоТипу(ТипЗнч(МассивДокументов[0]));
	
	ИмяДокумента = ОбъектМетаданныхДокумент.Имя;
	
	ТекстШаблон = "
	|ВЫБРАТЬ
	|	ИдентификаторСерииДокументов КАК ИдентификаторСерииДокументов
	|ПОМЕСТИТЬ
	|	ИдентификаторыСерийДокументов
	|ИЗ
	|	Документ.%1
	|ГДЕ
	|	Ссылка В(&МассивДокументов)
	|	И ИдентификаторСерииДокументов <> """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Ссылка							КАК Ссылка,
	|	ИдентификаторСерииДокументов	КАК ИдентификаторСерииДокументов,
	|	Номер							КАК Номер,
	|	Дата							КАК Дата,
	|	ЭтоЗаголовочныйДокумент			КАК ЭтоЗаголовочныйДокумент,
	|	СписокДокументовСерии			КАК СписокДокументовСерии,
	|	Проведен						КАК Проведен,
	|	ПометкаУдаления					КАК ПометкаУдаления
	|ИЗ
	|	Документ.%1
	|ГДЕ
	|	ИдентификаторСерииДокументов В (ВЫБРАТЬ ИдентификаторСерииДокументов ИЗ ИдентификаторыСерийДокументов)
	|УПОРЯДОЧИТЬ ПО
	|	ЭтоЗаголовочныйДокумент УБЫВ // Сначала заголовочные документы, затем содержательные.";
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивДокументов", МассивДокументов);
	ЗапросПоиск.Текст = СтрШаблон(ТекстШаблон, ИмяДокумента);
	
	УстановитьПривилегированныйРежим(Истина);
	ТаблицаОписей = ЗапросПоиск.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	ТаблицаОписей.Индексы.Добавить("Ссылка");
	
	СерииДокументов = Новый Соответствие();
	
	СвойстваСерий = Новый Соответствие();
	
	Для Каждого СтрокаТаблицы Из ТаблицаОписей Цикл
		СвойстваСерииДокументов = ПолучитьПустуюСтруктуруСвойстваСерииДокументов();
		
		СвойстваСерииДокументов.СвойстваСерии = ПолучитьОписаниеСерииДокументов(СтрокаТаблицы, СвойстваСерий);
		
		СвойстваСерииДокументов.СвойстваДокумента.ЭтоЗаголовочныйДокумент	= СтрокаТаблицы.ЭтоЗаголовочныйДокумент;
		СвойстваСерииДокументов.СвойстваДокумента.ЭтоСодержательныйДокумент	= Не СтрокаТаблицы.ЭтоЗаголовочныйДокумент;
		
		Если Не СтрокаТаблицы.ЭтоЗаголовочныйДокумент Тогда
			// Это содержательный документ.
			Для Каждого СтрокаДокументаСерии Из СвойстваСерииДокументов.СвойстваСерии.ОбщиеСвойства.СписокДокументовСерии Цикл
				Если СтрокаДокументаСерии.ДокументОписи = СтрокаТаблицы.Ссылка Тогда
					СвойстваСерииДокументов.СвойстваДокумента.ПорядковыйНомерДокумента = СтрокаДокументаСерии.НомерСтроки;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		СерииДокументов.Вставить(СтрокаТаблицы.Ссылка, СвойстваСерииДокументов);
	КонецЦикла;
	
	// Оставляем сведения только по указанным документам.
	// Удаляем сведения по всем остальным документам серии, если они не были указаны.
	
	УдаляемыеСсылки = Новый Массив();
	
	Для Каждого Элемент Из СерииДокументов Цикл
		ДокументСсылка = Элемент.Ключ;
		
		Если МассивДокументов.Найти(ДокументСсылка) = Неопределено Тогда
			УдаляемыеСсылки.Добавить(ДокументСсылка);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ДокументСсылка Из УдаляемыеСсылки Цикл
		СерииДокументов.Удалить(ДокументСсылка);
	КонецЦикла;
	
	Возврат СерииДокументов;
	
КонецФункции

Процедура ЗаполнитьСлужебныеКолонкиСпискаДокументовСерии(ФормаДокумента) Экспорт
	
	ЗаголовочныйДокументОбъект = ФормаДокумента.Объект;
	
	СостояниеДокументовСерии = ПрочитатьСостояниеДокументовСерии(ЗаголовочныйДокументОбъект);
	
	Для Каждого СтрокаТаблицы Из ЗаголовочныйДокументОбъект.СписокДокументовСерии Цикл
		ДокументОписи = СтрокаТаблицы.ДокументОписи;
		
		Если Не ЗначениеЗаполнено(ДокументОписи) Тогда
			СтрокаТаблицы.ИндексКартинки = -1;
			Продолжить;
		КонецЕсли;
		
		СостояниеДокумента = СостояниеДокументовСерии.Получить(ДокументОписи);
		
		// Коллекция картинок СостоянияДокумента
		Если СостояниеДокумента.Проведен Тогда
			СтрокаТаблицы.ИндексКартинки = 0;
			
		ИначеЕсли СостояниеДокумента.ПометкаУдаления Тогда
			СтрокаТаблицы.ИндексКартинки = 1;
			
		Иначе
			СтрокаТаблицы.ИндексКартинки = 2;
		КонецЕсли;
		
		Для Каждого Элемент Из СостояниеДокумента.КоличествоСтрокТабличныхЧастей Цикл
			ИмяТабличнойЧасти	= Элемент.Ключ;
			КоличествоСтрок		= Элемент.Значение;
			
			СтрокаТаблицы["КоличествоСтрок" + ИмяТабличнойЧасти] = КоличествоСтрок;
		КонецЦикла;
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СостояниеДокумента, "ПометкаУдаления,Проведен");
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ПечатьСерииДокументов

Процедура ПрочитатьСерииДокументовДляПечати(Знач МассивОбъектов, СерииДокументовДляПечати) Экспорт
	
	СерииДокументов = ПрочитатьСерииДокументов(МассивОбъектов);
	
	ДополненныйМассивОбъектов = Новый Массив();
	
	Для Каждого Элемент Из СерииДокументов Цикл
		ЗаголовочныйДокументСсылка = Элемент.Значение.СвойстваСерии.ОбщиеСвойства.ЗаголовочныйДокументСсылка;
		
		Если ДополненныйМассивОбъектов.Найти(ЗаголовочныйДокументСсылка) = Неопределено Тогда
			ДополненныйМассивОбъектов.Добавить(ЗаголовочныйДокументСсылка);
		КонецЕсли;
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ДополненныйМассивОбъектов, МассивОбъектов, Истина);
	
	СерииДокументовДляПечати = Новый Структура();
	СерииДокументовДляПечати.Вставить("ДополненныйМассивОбъектов",	ДополненныйМассивОбъектов);
	СерииДокументовДляПечати.Вставить("СерииДокументов",			СерииДокументов);
	
КонецПроцедуры

Функция ПолучитьСтрокуШапкиЗаголовочногоДокумента(Знач Данные, Знач СтрокаШапки, ОписаниеСерииДокументов) Экспорт
	
	ШапкиПоиска = Данные.Выборки.ШапкиПоискаЗаголовочныхДокументов;
	
	ШапкиПоиска.Сбросить();
	
	ОписаниеСерииДокументов = Данные.СерииДокументовДляПечати.СерииДокументов.Получить(СтрокаШапки.Ссылка);
	
	Поиск = Новый Структура("Ссылка", ОписаниеСерииДокументов.СвойстваСерии.ОбщиеСвойства.ЗаголовочныйДокументСсылка);
	
	ШапкиПоиска.НайтиСледующий(Поиск);
	
	Возврат ШапкиПоиска;
	
КонецФункции

Процедура ЗаполнитьБлокСведенийСерииДокументов(ЗначенияПараметров, СтрокаШапки) Экспорт
	
	ЭтоЗаголовочныйДокумент = ИнвентаризацияКлиентСервер.ЭтоЗаголовочныйДокументСерииДокументовОписи(СтрокаШапки);
	ЭтоСодержательныйДокумент = ИнвентаризацияКлиентСервер.ЭтоСодержательныйДокументСерииДокументовОписи(СтрокаШапки);
	
	Если ЭтоЗаголовочныйДокумент Тогда
		ШаблонСерияДокументовСтрока1 = НСтр("ru='Заголовочный документ серии документов'");
		
		ШаблонСерияДокументовСтрока2 = СтрШаблон(НСтр("ru='Содержательных документов в серии: %1'"),
			СтрокаШапки.КоличествоДокументовВСерииДокументов);
			
		ШаблонСерияДокументовСтрока3 = "";
		
	ИначеЕсли ЭтоСодержательныйДокумент Тогда
		ШаблонСерияДокументовСтрока1 = НСтр("ru='Содержательный документ серии документов'");
		
		ШаблонСерияДокументовСтрока2 = СтрШаблон(НСтр("ru='Порядковый номер %1 из %2'"),
			СтрокаШапки.ПорядковыйНомерДокументаВСерииДокументов,
			СтрокаШапки.КоличествоДокументовВСерииДокументов);
			
		ШаблонСерияДокументовСтрока3 = СтрШаблон(НСтр("ru='Системный номер документа: %1 от %2'"),
			СтрокаШапки.Номер,
			Формат(СтрокаШапки.Дата, "ДФ=дд.ММ.гггг чч:мм:сс"));
			
	Иначе
		ШаблонСерияДокументовСтрока1 = "";
		ШаблонСерияДокументовСтрока2 = "";
		ШаблонСерияДокументовСтрока3 = "";
	КонецЕсли;
	
	ЗначенияПараметров.Вставить("ШаблонСерияДокументовСтрока1", ШаблонСерияДокументовСтрока1);
	ЗначенияПараметров.Вставить("ШаблонСерияДокументовСтрока2", ШаблонСерияДокументовСтрока2);
	ЗначенияПараметров.Вставить("ШаблонСерияДокументовСтрока3", ШаблонСерияДокументовСтрока3);
	
КонецПроцедуры

Процедура ОбвестиЗаголовокСерииДокументов(Область, СброситьГраницы = Ложь) Экспорт
	
	Если СброситьГраницы Тогда
		Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
	Иначе
		Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
	КонецЕсли;
	
	ОбластьЗаголовок = Область.Области.Найти("ЗаголовокСерииДокументов");
	
	ОбластьЗаголовок.Обвести(Линия, Линия, Линия, Линия);
	
КонецПроцедуры

Процедура ЗаполнитьДатуНомерДокументаДляПечатиСерииДокументов(ЗначенияПараметров, СтрокаШапкиДокументаСРаспиской, СтрокаШапки) Экспорт
	
	ЭтоСодержательныйДокумент = ИнвентаризацияКлиентСервер.ЭтоСодержательныйДокументСерииДокументовОписи(СтрокаШапки);
	
	Если ЭтоСодержательныйДокумент Тогда
		ИспользуемыйНомер = СтрокаШапки.НомерЗаголовочногоДокумента;
	Иначе
		ИспользуемыйНомер = СтрокаШапкиДокументаСРаспиской.Номер;
	КонецЕсли;
	
	ИспользуемыйНомер = РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
		СтрокаШапки.Ссылка,
		ИспользуемыйНомер);
	
	Если ЭтоСодержательныйДокумент Тогда
		ИспользуемыйНомер = СтрШаблон("%1/%2", ИспользуемыйНомер, Формат(СтрокаШапки.ПорядковыйНомерДокументаВСерииДокументов, "ЧГ=0"));
	КонецЕсли;
	
	ЗначенияПараметров.Вставить("Номер",	ИспользуемыйНомер);
	ЗначенияПараметров.Вставить("Дата",		СтрокаШапкиДокументаСРаспиской.Дата);
	
КонецПроцедуры

#КонецОбласти

#Область УдалениеСодержательныхДокументов

Процедура УстановитьПометкуУдаленияСодержательныхДокументовСерии(ЗаголовочныйДокументОписи, ЗначениеПометкиУдаления) Экспорт
	
	ПустойИдентификаторСерииДокументов = Неопределено;
	
	МетаданныеДокумента = Метаданные.НайтиПоТипу(ТипЗнч(ЗаголовочныйДокументОписи.Ссылка));
	
	ИмяДокумента = МетаданныеДокумента.Имя;
	
	СписокДокументовСерии = ЗаголовочныйДокументОписи.СписокДокументовСерии;
	
	НачатьТранзакцию();
	
	Попытка
		Для Каждого СтрокаТаблицы Из СписокДокументовСерии Цикл
			ОписьСсылка = СтрокаТаблицы.ДокументОписи;
			
			Если Не ЗначениеЗаполнено(ОписьСсылка) Тогда
				Продолжить;
			КонецЕсли;
			
			Блокировка = Новый БлокировкаДанных;
			Блокировка.Добавить(СтрШаблон("Документ.%1", ИмяДокумента)).УстановитьЗначение("Ссылка", ОписьСсылка);
			Блокировка.Заблокировать();
			
			ДокументОбъект = ОписьСсылка.ПолучитьОбъект();
			
			ДокументОбъект.ПометкаУдаления = ЗначениеПометкиУдаления;
			
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		
		ТекстСообщения = СтрШаблон(НСтр("ru = '%1 пометки удаления содержательных документов серии документов'"),
			?(ЗначениеПометкиУдаления, НСтр("ru = 'Установка'"), НСтр("ru = 'Снятие'")));
		
		ЗаписьЖурналаРегистрации(ТекстСообщения,
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура ОчиститьСодержательныеДокументыСерии(ЗаголовочныйДокументОписи) Экспорт
	
	ПустойИдентификаторСерииДокументов = Неопределено;
	
	МетаданныеДокумента = Метаданные.НайтиПоТипу(ТипЗнч(ЗаголовочныйДокументОписи.Ссылка));
	
	ИмяДокумента = МетаданныеДокумента.Имя;
	
	ИменаТабличныхЧастейРазделов = ПолучитьИменаТабличныхЧастейРазделов(МетаданныеДокумента);
	
	СписокДокументовСерии = ЗаголовочныйДокументОписи.СписокДокументовСерии;
	
	НачатьТранзакцию();
	
	Попытка
		Для Каждого СтрокаТаблицы Из СписокДокументовСерии Цикл
			ОписьСсылка = СтрокаТаблицы.ДокументОписи;
			
			Если Не ЗначениеЗаполнено(ОписьСсылка) Тогда
				Продолжить;
			КонецЕсли;
			
			Блокировка = Новый БлокировкаДанных;
			Блокировка.Добавить(СтрШаблон("Документ.%1", ИмяДокумента)).УстановитьЗначение("Ссылка", ОписьСсылка);
			Блокировка.Заблокировать();
			
			ДокументОбъект = ОписьСсылка.ПолучитьОбъект();
			
			ДокументОбъект.ПометкаУдаления = Истина;
			
			Для Каждого ИмяТабличнойЧасти Из ИменаТабличныхЧастейРазделов Цикл
				ДокументОбъект[ИмяТабличнойЧасти].Очистить();
			КонецЦикла;
			
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Очистка содержательных документов серии документов'"),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеДокументовСерии

Процедура ДобавитьПараметрыРасчетаСерииДокументов(ПараметрыФункции, ДокументОбъект) Экспорт
	
	ШапкаДокумента = Новый Структура(ПолучитьИменаРеквизитовШапкиОбщихДанныхСерииДокументов(ДокументОбъект));
	
	ЗаполнитьЗначенияСвойств(ШапкаДокумента, ДокументОбъект);
	
	ПараметрыРасчетаСерииДокументов = Новый Структура();
	ПараметрыРасчетаСерииДокументов.Вставить("ЗаполняемыйДокументСсылка",	ДокументОбъект.Ссылка);
	ПараметрыРасчетаСерииДокументов.Вставить("ШапкаДокумента",				ШапкаДокумента);
	
	ПараметрыФункции.Вставить("ПараметрыРасчетаСерииДокументов", ПараметрыРасчетаСерииДокументов);
	
КонецПроцедуры

Функция РассчитатьСериюДокументов(Данные, ПараметрыФункции) Экспорт
	
	Перем КоличествоДокументовСерии;
	
	ЗаполняемыйДокументСсылка = ПараметрыФункции.ПараметрыРасчетаСерииДокументов.ЗаполняемыйДокументСсылка;
	
	ТипДокумента = ТипЗнч(ЗаполняемыйДокументСсылка);
	
	МетаданныеДокумента = ЗаполняемыйДокументСсылка.Метаданные();
	
	ОграничениеРазмераДокумента = ПолучитьОграничениеРазмераДокументаОписи(ЗаполняемыйДокументСсылка, ПараметрыФункции.Организация);
	
	РасчетСерииДокументов = ПолучитьПустуюСтруктуруРасчетаСерииДокументов();
	РасчетСерииДокументов.ЗаполняемыйДокументСсылка		= ЗаполняемыйДокументСсылка;
	РасчетСерииДокументов.ИдентификаторСерииДокументов	= Новый УникальныйИдентификатор();
	
	Если ЗначениеЗаполнено(ОграничениеРазмераДокумента) И ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьНФА") Тогда
		// 0510466
		
		Таблица1 = Данные.Раздел1;
		
		ОбщееКоличествоСтрок1 = Таблица1.Количество();
		
		Если ОбщееКоличествоСтрок1 <= ОграничениеРазмераДокумента Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ТаблицаНомеровСтрок1 = РассчитатьТаблицуНомеровСтрокСерииДокументов_БезКолонкиКоличествоПодстрок(Таблица1, ОграничениеРазмераДокумента);
		
		КоличествоДокументовСерии = ТаблицаНомеровСтрок1.Количество();
		
		РасчетСерииДокументов.ТаблицыНомеровСтрокРазделов.Вставить("Раздел1", ТаблицаНомеровСтрок1);
		
	ИначеЕсли ЗначениеЗаполнено(ОграничениеРазмераДокумента) И ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьРасчетовПоПоступлениям") Тогда
		// 0510468
		
		Таблица1 = Данные.Раздел11;
		Таблица2 = Данные.Раздел12;
		
		ОбщееКоличествоСтрок1 = Таблица1.Количество();
		ОбщееКоличествоСтрок2 = Таблица2.Количество();
		
		Если ОбщееКоличествоСтрок1 <= ОграничениеРазмераДокумента И ОбщееКоличествоСтрок2 <= ОграничениеРазмераДокумента Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ТаблицаНомеровСтрок1 = РассчитатьТаблицуНомеровСтрокСерииДокументов_БезКолонкиКоличествоПодстрок(Таблица1, ОграничениеРазмераДокумента);
		ТаблицаНомеровСтрок2 = РассчитатьТаблицуНомеровСтрокСерииДокументов_БезКолонкиКоличествоПодстрок(Таблица2, ОграничениеРазмераДокумента);
		
		КоличествоДокументовСерии = Макс(ТаблицаНомеровСтрок1.Количество(), ТаблицаНомеровСтрок2.Количество());
		
		РасчетСерииДокументов.ТаблицыНомеровСтрокРазделов.Вставить("Раздел11", ТаблицаНомеровСтрок1);
		РасчетСерииДокументов.ТаблицыНомеровСтрокРазделов.Вставить("Раздел12", ТаблицаНомеровСтрок2);
		
	ИначеЕсли ЗначениеЗаполнено(ОграничениеРазмераДокумента)
		И (ТипДокумента = Тип("ДокументСсылка.УдалитьИнвентаризационнаяОписьРасчетовПоПоступлениям")
			Или ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьРасчетовСКонтрагентами")) Тогда
		// 0510468, 0510469
		
		Таблица1 = Данные.Раздел11;
		Таблица2 = Данные.Раздел12;
		
		ОбщееКоличествоСтрок1 = Таблица1.Количество() + Таблица1.Итог("КоличествоПодстрок");
		ОбщееКоличествоСтрок2 = Таблица2.Количество() + Таблица2.Итог("КоличествоПодстрок");
		
		Если ОбщееКоличествоСтрок1 <= ОграничениеРазмераДокумента И ОбщееКоличествоСтрок2 <= ОграничениеРазмераДокумента Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ТаблицаНомеровСтрок1 = РассчитатьТаблицуНомеровСтрокСерииДокументов_ЕстьКолонкаКоличествоПодстрок(Таблица1, ОграничениеРазмераДокумента);
		ТаблицаНомеровСтрок2 = РассчитатьТаблицуНомеровСтрокСерииДокументов_ЕстьКолонкаКоличествоПодстрок(Таблица2, ОграничениеРазмераДокумента);
		
		КоличествоДокументовСерии = Макс(ТаблицаНомеровСтрок1.Количество(), ТаблицаНомеровСтрок2.Количество());
		
		РасчетСерииДокументов.ТаблицыНомеровСтрокРазделов.Вставить("Раздел11", ТаблицаНомеровСтрок1);
		РасчетСерииДокументов.ТаблицыНомеровСтрокРазделов.Вставить("Раздел12", ТаблицаНомеровСтрок2);
		
	Иначе
		ТекстСообщения = СтрШаблон(НСтр("ru='Не предусмотрено формирование серии документов для документа ""%1"".'"), МетаданныеДокумента.Имя);
		
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;
	
	Если КоличествоДокументовСерии = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	РасчетСерииДокументов.КоличествоДокументовСерии = КоличествоДокументовСерии;
	
	Возврат РасчетСерииДокументов;
	
КонецФункции

Процедура СоздатьСериюДокументов(РасчетСерииДокументов, Данные, ПараметрыФункции) Экспорт
	
	ЗаполняемыйДокументСсылка = РасчетСерииДокументов.ЗаполняемыйДокументСсылка;
	
	ТипДокумента = ТипЗнч(ЗаполняемыйДокументСсылка);
	ПредставлениеТипаДокумента = Строка(ТипДокумента);
	
	МетаданныеДокумента = ЗаполняемыйДокументСсылка.Метаданные();
	
	НачатьТранзакцию();
	
	Попытка
		БлокировкаДанных = Новый БлокировкаДанных;
		ЭлементБлокировкиДанных = БлокировкаДанных.Добавить(МетаданныеДокумента.ПолноеИмя());
		ЭлементБлокировкиДанных.УстановитьЗначение("Ссылка", ЗаполняемыйДокументСсылка);
		ЭлементБлокировкиДанных.Режим = РежимБлокировкиДанных.Исключительный;
		БлокировкаДанных.Заблокировать();
		
		ЗаполняемыйДокумент = ЗаполняемыйДокументСсылка.ПолучитьОбъект();
		
		ЗаписатьСодержательныеДокументыСерии(ЗаполняемыйДокумент, РасчетСерииДокументов, Данные, ПараметрыФункции);
		
		// Записываем заголовочный документ.
		ЗаполняемыйДокумент.Записать(РежимЗаписиДокумента.Запись);
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		
		ЗаписьЖурналаРегистрации(СтрШаблон(НСтр("ru = 'Заполнение документа %1 по данным учета'"), ПредставлениеТипаДокумента),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура ОбновитьРеквизитыСерииСодержательныхДокументовСерии(ДокументОбъект) Экспорт
	
	Если Не ИнвентаризацияКлиентСервер.ЭтоЗаголовочныйДокументСерииДокументовОписи(ДокументОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	НомерЗаголовочногоДокумента = ДокументОбъект.Номер;
	
	МассивСодержательныхДокументов = ДокументОбъект.СписокДокументовСерии.Выгрузить(, "ДокументОписи").ВыгрузитьКолонку("ДокументОписи");
	
	РеквизитыСодержательныхДокументов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МассивСодержательныхДокументов,
		"НомерЗаголовочногоДокумента,ПорядковыйНомерДокументаВСерииДокументов,КоличествоДокументовВСерииДокументов");
		
	КоличествоДокументовВСерииДокументов = ДокументОбъект.СписокДокументовСерии.Количество();
	
	МетаданныеДокумента = ДокументОбъект.Метаданные();
	
	Для Каждого СтрокаТаблицы Из ДокументОбъект.СписокДокументовСерии Цикл
		ОписьСсылка = СтрокаТаблицы.ДокументОписи;                                    
		
		Если Не ЗначениеЗаполнено(ОписьСсылка) Тогда
			Продолжить;
		КонецЕсли;
		
		ПорядковыйНомерДокументаВСерииДокументов = СтрокаТаблицы.НомерСтроки;
		
		РеквизитыСодержательногоДокумента = РеквизитыСодержательныхДокументов.Получить(ОписьСсылка);
		
		Если РеквизитыСодержательногоДокумента.НомерЗаголовочногоДокумента = НомерЗаголовочногоДокумента
			И РеквизитыСодержательногоДокумента.ПорядковыйНомерДокументаВСерииДокументов = ПорядковыйНомерДокументаВСерииДокументов
			И РеквизитыСодержательногоДокумента.КоличествоДокументовВСерииДокументов = КоличествоДокументовВСерииДокументов Тогда
			// Текущие значения реквизитов являются актуальными.
			Продолжить;
		КонецЕсли;
		
		Попытка
			Блокировка = Новый БлокировкаДанных;
			Блокировка.Добавить(МетаданныеДокумента.ПолноеИмя()).УстановитьЗначение("Ссылка", ОписьСсылка);
			Блокировка.Заблокировать();
		Исключение
			ТекстСообщения = СтрШаблон(
				НСтр("ru='Не удалось заблокировать содержательный документ %1 (текущий порядковый номер %2) серии документов %3 для обновления свойств серии документов.'"),
				МетаданныеДокумента.Синоним,
				СтрокаТаблицы.НомерСтроки,
				ДокументОбъект.ИдентификаторСерииДокументов);
				
			ВызватьИсключение ТекстСообщения;
		КонецПопытки;
		
		СодержательныйДокумент = ОписьСсылка.ПолучитьОбъект();
		
		СодержательныйДокумент.НомерЗаголовочногоДокумента				= НомерЗаголовочногоДокумента;
		СодержательныйДокумент.ПорядковыйНомерДокументаВСерииДокументов	= ПорядковыйНомерДокументаВСерииДокументов;
		СодержательныйДокумент.КоличествоДокументовВСерииДокументов		= КоличествоДокументовВСерииДокументов;
		
		СодержательныйДокумент.Записать(РежимЗаписиДокумента.Запись);
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбновитьРеквизитыСерииЗаголовочногоДокументаСерии(ДокументОбъект) Экспорт
	
	Если Не ИнвентаризацияКлиентСервер.ЭтоЗаголовочныйДокументСерииДокументовОписи(ДокументОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	ДокументОбъект.КоличествоДокументовВСерииДокументов = ДокументОбъект.СписокДокументовСерии.Количество();
	
КонецПроцедуры

Процедура НастроитьПрефиксДокументаСерииДокументов(ДокументОбъект, Префикс) Экспорт
	
	Если ЗначениеЗаполнено(ДокументОбъект.ИдентификаторСерииДокументов) И Не ДокументОбъект.ЭтоЗаголовочныйДокумент Тогда
		Префикс = "С";
	Иначе
		Префикс = "0";
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

// ИндикаторКворумаПрисутствия
Процедура ДополнитьИсключаемыеДокументыПриПроверкеКворумаПрисутствияДокументовСерии(ИсключаемыеДокументы, Список) Экспорт
	
	// Исключаем содержательные документы серии.
	
	ТипДокумента = ТипЗнч(Список[0]);
	
	Если ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьНФА")
		Или ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьРасчетовПоПоступлениям")
		Или ТипДокумента = Тип("ДокументСсылка.ИнвентаризационнаяОписьРасчетовСКонтрагентами") Тогда
		
		РеквизитыСерии = "ИдентификаторСерииДокументов,ЭтоЗаголовочныйДокумент";
		
		УстановитьПривилегированныйРежим(Истина);
		ЗначенияРеквизитовДокументов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(Список, РеквизитыСерии);
		УстановитьПривилегированныйРежим(Ложь);
		
		Для Каждого Ссылка Из Список Цикл
			ЗначенияРеквизитов = ЗначенияРеквизитовДокументов.Получить(Ссылка);
			
			Если ИнвентаризацияКлиентСервер.ЭтоСодержательныйДокументСерииДокументовОписи(ЗначенияРеквизитов) Тогда
				ИсключаемыеДокументы.Добавить(Ссылка);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры
// Конец ИндикаторКворумаПрисутствия

#КонецОбласти

#Область ИнвентаризационныеОписи61н

Процедура ПроверитьСовпадениеСотрудникаВОписиИРасписке(ДокументОписи, Отказ = Неопределено) Экспорт
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДокументОписи, "ДополнительныеСвойства") Тогда
		ИмяСвойства = "ВыполненаПроверкаСовпаденияСотрудникаВОписиИРасписке";
		
		Если ДокументОписи.ДополнительныеСвойства.Свойство(ИмяСвойства) Тогда
			// Проверка уже была выполнена в обработчике проверки заполнения документа.
			Возврат;
		КонецЕсли;
		
		ДокументОписи.ДополнительныеСвойства.Вставить(ИмяСвойства, Истина);
	КонецЕсли;
	
	ОписьСсылка = ДокументОписи.Ссылка;
	
	Если Не ЗначениеЗаполнено(ОписьСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	МассивОписей = Новый Массив();
	МассивОписей.Добавить(ОписьСсылка);
	
	ТаблицаНастроек = ИнвентаризацияСервер.ПолучитьТаблицуНастроекОписей61н();
	
	Таблица = ПрочитатьПарыСсылокОписьРасписка(МассивОписей,, ТаблицаНастроек);
	
	ДиагностироватьПарыСсылокОписьРасписка(Таблица);
	
	Поиск = Новый Структура("Источник", ОписьСсылка);
	
	МассивСтрок = Таблица.НайтиСтроки(Поиск);
	
	СтрокаТаблицыДиагностики = МассивСтрок[0];
	
	Расписка = СтрокаТаблицыДиагностики.Приемник;
	
	Если Не ЗначениеЗаполнено(Расписка) Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	ЗначенияРеквизитовРасписки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Расписка, "Сотрудник");
	УстановитьПривилегированныйРежим(Ложь);
	
	СотрудникИзРасписки = ЗначенияРеквизитовРасписки.Сотрудник;
	
	СтрокаТаблицыНастроек = ИнвентаризацияСервер.ПолучитьСтрокуТаблицыНастроекОписей61нПоОписи(ОписьСсылка, ТаблицаНастроек);
	
	ИмяРеквизитаСотрудникДляРасписки = СтрокаТаблицыНастроек.ИмяРеквизитаСотрудникДляРасписки;
	
	СотрудникИзОписи = ДокументОписи[ИмяРеквизитаСотрудникДляРасписки];
	
	Если СотрудникИзОписи = СотрудникИзРасписки Тогда
		Возврат;
	КонецЕсли;
	
	Если Отказ = Неопределено Тогда
		ТекстСправочно = НСтр("ru='Справочно: '");
	Иначе
		ТекстСправочно = "";
	КонецЕсли;
	
	ОбщегоНазначения.СообщитьПользователю(
		СтрШаблон(НСтр("ru='%1Опись и расписка оформлены в отношении различных сотрудников.'"), ТекстСправочно),
		ОписьСсылка,, "Объект." + ИмяРеквизитаСотрудникДляРасписки, Отказ);
	
КонецПроцедуры

Процедура ЗаполнитьСтатусОбъясненияНеТребуется(ТаблицаРаздела, ОписьСсылка) Экспорт
	
	НастройкиСтатусаОбъяснения = ПолучитьНастройкиСтатусаОбъяснения(ОписьСсылка);
	
	ПоказателиОтклонений = НастройкиСтатусаОбъяснения.ПоказателиОтклонений;
	
	СтатусОбъясненияНеТребуется = Перечисления.СтатусыОбъясненияОтветственногоЛица.НеТребуется;
	
	Для Каждого СтрокаТаблицы Из ТаблицаРаздела Цикл
		ЕстьЗаполненныйПоказатель = Ложь;
		
		Для Каждого ИмяПоказателя Из ПоказателиОтклонений Цикл
			Если ЗначениеЗаполнено(СтрокаТаблицы[ИмяПоказателя]) Тогда
				ЕстьЗаполненныйПоказатель = Истина;
				
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ЕстьЗаполненныйПоказатель Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТаблицы.СтатусОбъяснения = СтатусОбъясненияНеТребуется;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьСписокИсключаемыхСчетовИзНастроекЗаполненияОписейПоРешению(ТипОписи, Организация) Экспорт
	
	СписокСчетов = Новый Массив();
	
	ТаблицаНастроек = ПолучитьТаблицуНастроекЗаполненияОписейПоРешению(ТипОписи, Истина, Организация);
	
	Если ТаблицаНастроек.Количество() = 0 Тогда
		Возврат СписокСчетов;
	КонецЕсли;
	
	СтрокаТаблицыНастроек = ТаблицаНастроек[0];
	
	Для Каждого СтрокаТаблицыКодовСчетов Из СтрокаТаблицыНастроек.ТаблицаКодовСчетов Цикл
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СписокСчетов, СтрокаТаблицыКодовСчетов.СсылкиИсключаемыхСчетов, Истина);
	КонецЦикла;
	
	Возврат СписокСчетов;
	
КонецФункции

