Процедура Редактирование0504087_РассчитатьФактическиеПоказатели(ФормаДокумента, ТекущиеДанные, ИмяИзмененногоПоля) Экспорт
	
	// Гр.7		=	Гр.5	х	Гр.6
	// Сумма		Цена		Количество
	
	ИменаКолонок = ФормаДокумента["КэшВариантФормированияОписи"]["ИменаКолонокЧисловыхПоказателей"];
	
	ИмяКоличествоФакт	= ИменаКолонок["КоличествоФакт"];
	ИмяСуммаФакт		= ИменаКолонок["СуммаФакт"];
	
	РассчитатьСумму = (ИмяИзмененногоПоля = ИмяКоличествоФакт ИЛИ ИмяИзмененногоПоля = "Цена");
	
	РассчитатьЦену = (ИмяИзмененногоПоля = ИмяСуммаФакт);
	
	Если РассчитатьСумму Тогда
		
		ТекущиеДанные[ИмяСуммаФакт] = ТекущиеДанные[ИмяКоличествоФакт] * ТекущиеДанные["Цена"];
		
	ИначеЕсли РассчитатьЦену Тогда
		
		Если ТекущиеДанные[ИмяКоличествоФакт] = 0 Тогда
			Цена = 0;
		Иначе
			Цена = ТекущиеДанные[ИмяСуммаФакт] / ТекущиеДанные[ИмяКоличествоФакт];
		КонецЕсли;
		
		ТекущиеДанные["Цена"] = Цена;
	КонецЕсли;
	
КонецПроцедуры

Процедура Редактирование0504087_РассчитатьРасхождениеВСтроке(ФормаДокумента, ТекущиеДанные) Экспорт
	
	// Предназначен для вызова в случае ВариантФормированияОписи = 1,2,3
	// 1. Опись с 2018 г. Счет в таблице (26 знаков)
	// 2. Опись с 2018 г. Счет в таблице (5 знаков)
	// 3. Опись с 2018 г. Счет в таблице (5 знаков). Одна строка - один объект
	
	ИменаКолонок = ФормаДокумента["КэшВариантФормированияОписи"]["ИменаКолонокЧисловыхПоказателей"];
	
	ИмяКоличествоУчет		= ИменаКолонок["КоличествоУчет"];
	ИмяКоличествоФакт		= ИменаКолонок["КоличествоФакт"];
	ИмяКоличествоИзлишек	= ИменаКолонок["КоличествоИзлишек"];
	ИмяКоличествоНедостача	= ИменаКолонок["КоличествоНедостача"];
	
	ИмяСуммаУчет			= ИменаКолонок["СуммаУчет"];
	ИмяСуммаФакт			= ИменаКолонок["СуммаФакт"];
	ИмяСуммаИзлишек			= ИменаКолонок["СуммаИзлишек"];
	ИмяСуммаНедостача		= ИменаКолонок["СуммаНедостача"];
	
	ДельтаКолво = ТекущиеДанные[ИмяКоличествоУчет] - ТекущиеДанные[ИмяКоличествоФакт];
	
	//
	// Недостача
	//
	ТекущиеДанные[ИмяКоличествоНедостача] = ?(ДельтаКолво>0, ДельтаКолво, 0);
	
	// Гр.14 = Гр.13 х (Гр.12 / Гр.11)
	Если ТекущиеДанные[ИмяКоличествоУчет] <> 0 Тогда
		
		Если ТекущиеДанные[ИмяКоличествоНедостача] = ТекущиеДанные[ИмяКоличествоУчет] Тогда
			// Отсутствует в полном количестве
			
			Сумма = ТекущиеДанные[ИмяСуммаУчет];
			
		Иначе
			
			Сумма = ТекущиеДанные[ИмяСуммаУчет] * ТекущиеДанные[ИмяКоличествоНедостача] / ТекущиеДанные[ИмяКоличествоУчет];
			
		КонецЕсли;
		
	Иначе
		
		Сумма = 0;
		
	КонецЕсли;
	
	ТекущиеДанные[ИмяСуммаНедостача] = Сумма;
	
	//
	// Излишек
	//
	ТекущиеДанные[ИмяКоличествоИзлишек] = ?(ДельтаКолво<0, -ДельтаКолво, 0);
	
	// Гр.16 = Гр.15 х Гр.5
	ТекущиеДанные[ИмяСуммаИзлишек] = ТекущиеДанные[ИмяКоличествоИзлишек] * ТекущиеДанные["Цена"];
	
	//
	// Не соответствует условиям актива
	//
	// Гр.18 = Гр.17 х (Гр.12 / Гр.11)
	Если ТекущиеДанные[ИмяКоличествоУчет] <> 0 Тогда
		
		Если ТекущиеДанные["КоличествоНеСоответствует"] = ТекущиеДанные[ИмяКоличествоУчет] Тогда
			// Не соответствует в полном количестве
			
			Сумма = ТекущиеДанные[ИмяСуммаУчет];
			
		Иначе
			
			Сумма = ТекущиеДанные[ИмяСуммаУчет] * ТекущиеДанные["КоличествоНеСоответствует"] / ТекущиеДанные[ИмяКоличествоУчет];
			
		КонецЕсли;
		
	Иначе
		
		Сумма = 0;
		
	КонецЕсли;
	
	ТекущиеДанные["СуммаНеСоответствует"] = Сумма;
	
КонецПроцедуры

// Возвращаемое значение:
//	Настройки для указанного вида документов	- Структура с ключами:
//		
//		ИмяТабличнойЧасти					- Строка
// 	
//		ОтдельныйЭлементДляТабличнойЧасти	- Строка
//
//		НеиспользуемыеРеквизиты				- Соответствие Число<->Структура
//		(отдельно для каждого значения ВариантФормированияОписи)
//
//			- РеквизитыШапки			- Массив строк
//
//			- РеквизитыТабличнойЧасти	- Массив строк
//
//			- ЭлементыФормы				- Массив строк
//
Функция ПолучитьНастройкиФормы0504092(ВидДокумента)
	
	НеиспользуемыеРеквизиты = Новый Соответствие();
	
	//
	// 0. Опись до 2018 г.
	//
	НастройкиВарианта = Новый Структура();
	НастройкиВарианта.Вставить("РеквизитыШапки",			"");
	НастройкиВарианта.Вставить("РеквизитыТабличнойЧасти",	"КоличествоНеСоответствует,
															|СуммаНеСоответствует,
															|БалансоваяЦена,
															|ОценочнаяЦена");
	НастройкиВарианта.Вставить("ЭлементыФормы",				"СтраницаКомиссия");
	ПолучитьНастройкиФормы0504087_ОбработатьТекстовыеНастройки(НастройкиВарианта);
	НеиспользуемыеРеквизиты.Вставить(0, НастройкиВарианта);
		
	//
	// 1. Опись с 2018 г.
	//
	НастройкиВарианта = Новый Структура();
	НастройкиВарианта.Вставить("РеквизитыШапки",			"");
	НастройкиВарианта.Вставить("РеквизитыТабличнойЧасти",	"МОЛ,
															|БалансоваяСтоимость,
															|РыночнаяСтоимость,
															|РазницаСтоимостей");
	НастройкиВарианта.Вставить("ЭлементыФормы",				"");
	ПолучитьНастройкиФормы0504087_ОбработатьТекстовыеНастройки(НастройкиВарианта);
	НеиспользуемыеРеквизиты.Вставить(1, НастройкиВарианта);
	
	
	НастройкиДокумента = Новый Структура();
	НастройкиДокумента.Вставить("ИмяТабличнойЧасти",					"ВедомостьРасхождений");
	НастройкиДокумента.Вставить("ОтдельныйЭлементДляТабличнойЧасти",	"");
	НастройкиДокумента.Вставить("НеиспользуемыеРеквизиты",				НеиспользуемыеРеквизиты);
	
	Возврат НастройкиДокумента;
	
КонецФункции

#Область Приказ194н

Функция ВариантФормированияОписи0504092_ПолучитьСписокВыбора()
	
	СписокВыбора = Новый СписокЗначений();
	
	СписокВыбора.Добавить(0, НСтр("ru='Опись до 2018 г.'"));
	СписокВыбора.Добавить(1, НСтр("ru='Опись с 2018 г.'"));
	
	Возврат СписокВыбора;
	
КонецФункции

Процедура ВариантФормированияОписи0504092_ИнициализироватьФорму(ФормаДокумента) Экспорт
	
	// Инициализируем реквизиты формы
	ВариантФормированияОписи0504092_ИнициализироватьКэшФормы(ФормаДокумента);
	
	// Настраиваем список выбора
	СписокВыбора = ВариантФормированияОписи0504092_ПолучитьСписокВыбора();
	
	НастраиваемыйСписок = ФормаДокумента.Элементы["ВариантФормированияОписи"].СписокВыбора;
	
	НастраиваемыйСписок.Очистить();
	
	Для Каждого Элемент Из СписокВыбора Цикл
		НастраиваемыйСписок.Добавить(Элемент.Значение, Элемент.Представление);
	КонецЦикла;
	
	// Скрываем неиспользуемые реквизиты
	НастроитьВидимостьНеиспользуемыхРеквизитов(
		ФормаДокумента,
		ФормаДокумента.Объект["ВариантФормированияОписи"],
		Ложь);
	
КонецПроцедуры

Процедура ВариантФормированияОписи0504092_ИнициализироватьКэшФормы(ФормаДокумента)
	
	ВидДокумента = ОпределитьВидДокумента(ФормаДокумента.Объект);
	
	НастройкиДокумента = ПолучитьНастройкиФормы0504092(ВидДокумента);
	
	ФормаДокумента["КэшВариантФормированияОписи"] = Новый ФиксированнаяСтруктура(НастройкиДокумента);
	
КонецПроцедуры

Процедура ВариантФормированияОписи0504092_РассчитатьПеременныеРеквизиты_ПриИзмененииВарианта(ФормаДокумента, НовоеЗначениеВарианта) Экспорт
	
	ТекущееЗначениеВарианта = ФормаДокумента.Объект["ВариантФормированияОписи"];
	
	ТребуетсяРасчетВВариант0 = (НовоеЗначениеВарианта = 0);
	
	ТребуетсяРасчетВВариант1 = (НовоеЗначениеВарианта > 0);
	
	Если НЕ ТребуетсяРасчетВВариант0 И НЕ ТребуетсяРасчетВВариант1 Тогда
		Возврат;
	КонецЕсли;
	
	
	Если ТребуетсяРасчетВВариант0 Тогда
		ВариантФормированияОписи0504092_РассчитатьПеременныеРеквизиты_ВВариант0(ФормаДокумента, НовоеЗначениеВарианта);
		
	ИначеЕсли ТребуетсяРасчетВВариант1 Тогда
		ВариантФормированияОписи0504092_РассчитатьПеременныеРеквизиты_ВВариант1(ФормаДокумента, НовоеЗначениеВарианта);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВариантФормированияОписи0504092_РассчитатьПеременныеРеквизиты_ВВариант0(ФормаДокумента, НовоеЗначениеВарианта)
	
	НеиспользуемыеРеквизиты	= ФормаДокумента["КэшВариантФормированияОписи"]["НеиспользуемыеРеквизиты"].Получить(НовоеЗначениеВарианта);
	ИмяТабличнойЧасти		= ФормаДокумента["КэшВариантФормированияОписи"]["ИмяТабличнойЧасти"];
	
	ОчищающаяСтруктура = НеиспользуемыеРеквизиты["РеквизитыТабличнойЧасти"];
	
	Шапка = ФормаДокумента.Объект;
	
	Таблица = ФормаДокумента.Объект[ИмяТабличнойЧасти];
	
	СтруктураИнициализации = Новый Структура();
	СтруктураИнициализации.Вставить("БалансоваяСтоимость",	0);
	СтруктураИнициализации.Вставить("РыночнаяСтоимость",	0);
	СтруктураИнициализации.Вставить("РазницаСтоимостей",	0);
	СтруктураИнициализации.Вставить("МОЛ",					Шапка["МОЛ"]);
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		// Инициализируем новые реквизиты
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтруктураИнициализации);
		
		// Очищаем реквизиты переменного использования (неиспользуемые)
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ОчищающаяСтруктура);
	КонецЦикла;
	
КонецПроцедуры

Процедура ВариантФормированияОписи0504092_РассчитатьПеременныеРеквизиты_ВВариант1(ФормаДокумента, НовоеЗначениеВарианта)
	
	НеиспользуемыеРеквизиты	= ФормаДокумента["КэшВариантФормированияОписи"]["НеиспользуемыеРеквизиты"].Получить(НовоеЗначениеВарианта);
	ИмяТабличнойЧасти		= ФормаДокумента["КэшВариантФормированияОписи"]["ИмяТабличнойЧасти"];
	
	ОчищающаяСтруктура = НеиспользуемыеРеквизиты["РеквизитыТабличнойЧасти"];
	
	Шапка = ФормаДокумента.Объект;
	
	Таблица = ФормаДокумента.Объект[ИмяТабличнойЧасти];
	
	СтруктураИнициализации = Новый Структура();
	СтруктураИнициализации.Вставить("БалансоваяЦена",				0);
	СтруктураИнициализации.Вставить("КоличествоНеСоответствует ",	0);
	СтруктураИнициализации.Вставить("СуммаНеСоответствует",			0);
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		// Инициализируем новые реквизиты
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтруктураИнициализации);
		
		Если СтрокаТаблицы["ИзлишкиКоличество"] = 0 Тогда
			ОценочнаяЦена = 0;
		Иначе
			ОценочнаяЦена = СтрокаТаблицы["ИзлишкиСумма"] / СтрокаТаблицы["ИзлишкиКоличество"];
		КонецЕсли;
		
		СтрокаТаблицы["ОценочнаяЦена"] = ОценочнаяЦена;
		
		// Очищаем реквизиты переменного использования (неиспользуемые)
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ОчищающаяСтруктура);
	КонецЦикла;
	
КонецПроцедуры



Функция ВариантФормированияОписи0504087_ПолучитьСписокВыбора()
	
	СписокВыбора = Новый СписокЗначений();
	
	СписокВыбора.Добавить(0, НСтр("ru='Опись до 2018 г. Счет в шапке'"));
	СписокВыбора.Добавить(1, НСтр("ru='Опись с 2018 г. Счет в таблице (26 знаков)'"));
	СписокВыбора.Добавить(2, НСтр("ru='Опись с 2018 г. Счет в таблице (5 знаков)'"));
	СписокВыбора.Добавить(3, НСтр("ru='Опись с 2018 г. Счет в таблице (5 знаков). Одна строка - один объект'"));
	
	Возврат СписокВыбора;
	
КонецФункции

Процедура ВариантФормированияОписи0504087_ОчиститьНеиспользуемыеРеквизиты(ДокументОбъект) Экспорт
	
	ВидДокумента = ОпределитьВидДокумента(ДокументОбъект);
	
	Настройки = ПолучитьНастройкиФормы0504087(ВидДокумента);
	
	НеиспользуемыеРеквизиты	= Настройки["НеиспользуемыеРеквизиты"].Получить(ДокументОбъект["ВариантФормированияОписи"]);
	
	Если НеиспользуемыеРеквизиты = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Реквизиты шапки
	ОчищающаяСтруктура = НеиспользуемыеРеквизиты["РеквизитыШапки_ОчищающаяСтруктура"];
	ЗаполнитьЗначенияСвойств(ДокументОбъект, ОчищающаяСтруктура);
	
	// Реквизиты табличных частей
	ОчищающаяСтруктура = НеиспользуемыеРеквизиты["РеквизитыТабличнойЧасти_ОчищающаяСтруктура"];
	
	ОчищатьТЧ = (ОчищающаяСтруктура.Количество() > 0);
	
	Если ОчищатьТЧ Тогда
		ТабличнаяЧасть = ДокументОбъект[Настройки["ИмяТабличнойЧасти"]];
		
		Для Каждого СтрокаТаблицы Из ТабличнаяЧасть Цикл
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ОчищающаяСтруктура);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры


Процедура ВариантФормированияОписи0504087_ИнициализироватьФорму(ФормаДокумента, ИгнорироватьРеквизитКПС = Ложь) Экспорт
	
	// Инициализируем реквизиты формы
	ВариантФормированияОписи0504087_ИнициализироватьКэшФормы(ФормаДокумента);
	
	// Настраиваем список выбора
	СписокВыбора = ВариантФормированияОписи0504087_ПолучитьСписокВыбора();
	
	НастраиваемыйСписок = ФормаДокумента.Элементы["ВариантФормированияОписи"].СписокВыбора;
	
	НастраиваемыйСписок.Очистить();
	
	Для Каждого Элемент Из СписокВыбора Цикл
		НастраиваемыйСписок.Добавить(Элемент.Значение, Элемент.Представление);
	КонецЦикла;
	
	// Скрываем неиспользуемые реквизиты
	НастроитьВидимостьНеиспользуемыхРеквизитов(
		ФормаДокумента,
		ФормаДокумента.Объект["ВариантФормированияОписи"],
		Ложь,
		ИгнорироватьРеквизитКПС);
	
КонецПроцедуры

Процедура ВариантФормированияОписи0504087_ИнициализироватьКэшФормы(ФормаДокумента)
	
	ВидДокумента = ОпределитьВидДокумента(ФормаДокумента.Объект);
	
	НастройкиДокумента = ПолучитьНастройкиФормы0504087(ВидДокумента);
	
	ФормаДокумента["КэшВариантФормированияОписи"] = Новый ФиксированнаяСтруктура(НастройкиДокумента);
	
КонецПроцедуры

Процедура ВариантФормированияОписи_НастроитьВидимостьРеквизитов_ПриИзмененииВарианта(ФормаДокумента, НовоеЗначениеВарианта, ИгнорироватьРеквизитКПС = Ложь) Экспорт
	
	// Делаем видимыми все реквизиты путем включения невидимых для ТЕКУЩЕГО варианта формирования описи
	НастроитьВидимостьНеиспользуемыхРеквизитов(
		ФормаДокумента,
		ФормаДокумента.Объект["ВариантФормированияОписи"],
		Истина,
		ИгнорироватьРеквизитКПС);
	
	// Скрываем неиспользуемые реквизиты НОВОГО варианта формирования
	НастроитьВидимостьНеиспользуемыхРеквизитов(
		ФормаДокумента,
		НовоеЗначениеВарианта,
		Ложь,
		ИгнорироватьРеквизитКПС);
	
КонецПроцедуры

Процедура НастроитьВидимостьНеиспользуемыхРеквизитов(ФормаДокумента, ВариантФормированияОписи, НоваяВидимость, ИгнорироватьРеквизитКПС = Ложь)
	
	ОтдельныйЭлементДляТабличнойЧасти	= ФормаДокумента["КэшВариантФормированияОписи"]["ОтдельныйЭлементДляТабличнойЧасти"];
	НеиспользуемыеРеквизиты				= ФормаДокумента["КэшВариантФормированияОписи"]["НеиспользуемыеРеквизиты"].Получить(ВариантФормированияОписи);
	ИмяТабличнойЧасти					= ФормаДокумента["КэшВариантФормированияОписи"]["ИмяТабличнойЧасти"];
	
	Если ЗначениеЗаполнено(ОтдельныйЭлементДляТабличнойЧасти) Тогда
		ИмяТабличнойЧасти = ОтдельныйЭлементДляТабличнойЧасти;
	КонецЕсли;
	
	// Реквизиты шапки
	Для Каждого ИмяРеквизита Из НеиспользуемыеРеквизиты["РеквизитыШапки"] Цикл
		Если ИмяРеквизита = "КПС" И ИгнорироватьРеквизитКПС Тогда
			Продолжить;
		КонецЕсли;
		
		ФормаДокумента.Элементы[ИмяРеквизита].Видимость = НоваяВидимость;
	КонецЦикла;
	
	// Реквизиты табличных частей
	Для Каждого ИмяРеквизита Из НеиспользуемыеРеквизиты["РеквизитыТабличнойЧасти"] Цикл
		Если ИмяРеквизита = "КПС" И ИгнорироватьРеквизитКПС Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяЭлемента = ИмяТабличнойЧасти + ИмяРеквизита;
		
		ФормаДокумента.Элементы[ИмяЭлемента].Видимость = НоваяВидимость;
	КонецЦикла;
	
	// Элементы формы
	Для Каждого ИмяЭлемента Из НеиспользуемыеРеквизиты["ЭлементыФормы"] Цикл
		ФормаДокумента.Элементы[ИмяЭлемента].Видимость = НоваяВидимость;
	КонецЦикла;
	
КонецПроцедуры


Процедура ВариантФормированияОписи0504087_РассчитатьПеременныеРеквизиты_ПриИзмененииВарианта(ФормаДокумента, НовоеЗначениеВарианта) Экспорт
	
	ТекущееЗначениеВарианта = ФормаДокумента.Объект["ВариантФормированияОписи"];
	
	ТребуетсяРасчетВВариант0 = (ТекущееЗначениеВарианта > 0 И НовоеЗначениеВарианта = 0);
	
	ТребуетсяРасчетВВариант123 = (ТекущееЗначениеВарианта = 0 И НовоеЗначениеВарианта > 0);
	
	Если НЕ ТребуетсяРасчетВВариант0 И НЕ ТребуетсяРасчетВВариант123 Тогда
		Возврат;
	КонецЕсли;
	
	
	Если ТребуетсяРасчетВВариант0 Тогда
		ВариантФормированияОписи0504087_РассчитатьПеременныеРеквизиты_ВВариант0(ФормаДокумента, НовоеЗначениеВарианта);
		
	ИначеЕсли ТребуетсяРасчетВВариант123 Тогда
		ВариантФормированияОписи0504087_РассчитатьПеременныеРеквизиты_ВВариант123(ФормаДокумента, НовоеЗначениеВарианта);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВариантФормированияОписи0504087_РассчитатьПеременныеРеквизиты_ВВариант0(ФормаДокумента, НовоеЗначениеВарианта)
	
	НеиспользуемыеРеквизиты	= ФормаДокумента["КэшВариантФормированияОписи"]["НеиспользуемыеРеквизиты"].Получить(НовоеЗначениеВарианта);
	ИменаКолонок			= ФормаДокумента["КэшВариантФормированияОписи"]["ИменаКолонокЧисловыхПоказателей"];
	ИмяТабличнойЧасти		= ФормаДокумента["КэшВариантФормированияОписи"]["ИмяТабличнойЧасти"];
	
	ИмяКоличествоУчет		= ИменаКолонок["КоличествоУчет"];
	ИмяКоличествоФакт		= ИменаКолонок["КоличествоФакт"];
	ИмяКоличествоИзлишек	= ИменаКолонок["КоличествоИзлишек"];
	ИмяКоличествоНедостача	= ИменаКолонок["КоличествоНедостача"];
	
	ИмяСуммаУчет			= ИменаКолонок["СуммаУчет"];
	ИмяСуммаФакт			= ИменаКолонок["СуммаФакт"];
	ИмяСуммаИзлишек			= ИменаКолонок["СуммаИзлишек"];
	ИмяСуммаНедостача		= ИменаКолонок["СуммаНедостача"];
	
	ИмяЦена = "Цена";
	
	ОчищающаяСтруктура = НеиспользуемыеРеквизиты["РеквизитыТабличнойЧасти"];
	
	
	Таблица = ФормаДокумента.Объект[ИмяТабличнойЧасти];
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		
		//
		// 1. Рассчитываем реквизиты переменного назначения
		//
		
		// Цена, СуммаФакт
		ПрименяетсяПромежуточнаяЦена = (СтрокаТаблицы[ИмяКоличествоУчет] > 0 И СтрокаТаблицы[ИмяКоличествоИзлишек] > 0);
		Если ПрименяетсяПромежуточнаяЦена Тогда
			СтрокаТаблицы[ИмяЦена] = (СтрокаТаблицы[ИмяСуммаУчет] + СтрокаТаблицы[ИмяСуммаИзлишек]) / СтрокаТаблицы[ИмяКоличествоФакт];
			
			СтрокаТаблицы[ИмяСуммаФакт] = СтрокаТаблицы[ИмяЦена] * СтрокаТаблицы[ИмяКоличествоФакт];
		Иначе
			
			Если СтрокаТаблицы[ИмяКоличествоУчет] <> 0 Тогда
				
				Цена = СтрокаТаблицы[ИмяСуммаУчет] / СтрокаТаблицы[ИмяКоличествоУчет];
			
			ИначеЕсли СтрокаТаблицы[ИмяКоличествоФакт] <> 0 Тогда
				
				Цена = СтрокаТаблицы[ИмяСуммаФакт] / СтрокаТаблицы[ИмяКоличествоФакт];
				
			Иначе
				
				Цена = 0;
				
			КонецЕсли;
			
			СтрокаТаблицы[ИмяЦена] = Цена;
				
			СтрокаТаблицы[ИмяСуммаФакт] = СтрокаТаблицы[ИмяЦена] * СтрокаТаблицы[ИмяКоличествоФакт];
		КонецЕсли;
		
		ДельтаСумма = СтрокаТаблицы[ИмяСуммаУчет] - СтрокаТаблицы[ИмяСуммаФакт];
		
		// СуммаНедостача
		СтрокаТаблицы[ИмяСуммаНедостача] = ?(ДельтаСумма > 0, ДельтаСумма, 0);
		
		// СуммаИзлишек
		СтрокаТаблицы[ИмяСуммаИзлишек] = ?(ДельтаСумма < 0, -ДельтаСумма, 0);
		
		//
		// 2. Очищаем реквизиты переменного использования (неиспользуемые)
		//
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ОчищающаяСтруктура);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ВариантФормированияОписи0504087_РассчитатьПеременныеРеквизиты_ВВариант123(ФормаДокумента, НовоеЗначениеВарианта)
	
	НеиспользуемыеРеквизиты				= ФормаДокумента["КэшВариантФормированияОписи"]["НеиспользуемыеРеквизиты"].Получить(НовоеЗначениеВарианта);
	ИменаКолонок						= ФормаДокумента["КэшВариантФормированияОписи"]["ИменаКолонокЧисловыхПоказателей"];
	ИмяРеквизитаСчетВШапке				= ФормаДокумента["КэшВариантФормированияОписи"]["ИмяРеквизитаСчетВШапке"];
	ИмяТабличнойЧасти					= ФормаДокумента["КэшВариантФормированияОписи"]["ИмяТабличнойЧасти"];
	УстанавливатьСчетВТабличнойЧасти	= ФормаДокумента["КэшВариантФормированияОписи"]["УстанавливатьСчетВТабличнойЧасти"];
	
	ИмяКоличествоУчет		= ИменаКолонок["КоличествоУчет"];
	ИмяКоличествоФакт		= ИменаКолонок["КоличествоФакт"];
	ИмяКоличествоИзлишек	= ИменаКолонок["КоличествоИзлишек"];
	ИмяКоличествоНедостача	= ИменаКолонок["КоличествоНедостача"];
	
	ИмяСуммаУчет			= ИменаКолонок["СуммаУчет"];
	ИмяСуммаФакт			= ИменаКолонок["СуммаФакт"];
	ИмяСуммаИзлишек			= ИменаКолонок["СуммаИзлишек"];
	ИмяСуммаНедостача		= ИменаКолонок["СуммаНедостача"];
	
	ИмяЦена = "Цена";
	
	ОчищающаяСтруктура = НеиспользуемыеРеквизиты["РеквизитыТабличнойЧасти_ОчищающаяСтруктура"];
	
	Шапка = ФормаДокумента.Объект;
	
	Таблица = ФормаДокумента.Объект[ИмяТабличнойЧасти];
	
	ЗаполняющаяСтруктура = Новый Структура("КФО,КПС");
	ЗаполнитьЗначенияСвойств(ЗаполняющаяСтруктура, Шапка);
	Если УстанавливатьСчетВТабличнойЧасти Тогда
		ЗаполняющаяСтруктура.Вставить("Счет",	Шапка[ИмяРеквизитаСчетВШапке]);
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		
		//
		// 1. Инициализируем новые реквизиты
		//
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ЗаполняющаяСтруктура);
		
		СтрокаТаблицы["СтатусОбъекта"]				= "";
		СтрокаТаблицы["ЦелеваяФункцияАктива"]		= "";
		СтрокаТаблицы["КоличествоНеСоответствует"]	= 0;
		СтрокаТаблицы["СуммаНеСоответствует"]		= 0;
		СтрокаТаблицы["Примечание"]					= "";
		
		//
		// 2. Рассчитываем реквизиты переменного назначения
		//
		
		// Цена, СуммаФакт
		ПрименяетсяПромежуточнаяЦена = (СтрокаТаблицы[ИмяКоличествоУчет] > 0 И СтрокаТаблицы[ИмяКоличествоИзлишек] > 0);
		Если ПрименяетсяПромежуточнаяЦена Тогда
			СтрокаТаблицы[ИмяЦена] = СтрокаТаблицы[ИмяСуммаИзлишек] / СтрокаТаблицы[ИмяКоличествоИзлишек];
			
			СтрокаТаблицы[ИмяСуммаФакт] = СтрокаТаблицы[ИмяЦена] * СтрокаТаблицы[ИмяКоличествоФакт];
		КонецЕсли;
		
		// СуммаНедостача
		Если СтрокаТаблицы[ИмяКоличествоУчет] = 0 Тогда
			СуммаНедостача = 0;
		Иначе
			СуммаНедостача = СтрокаТаблицы[ИмяКоличествоНедостача] * СтрокаТаблицы[ИмяСуммаУчет] / СтрокаТаблицы[ИмяКоличествоУчет];
		КонецЕсли;
		СтрокаТаблицы[ИмяСуммаНедостача] = СуммаНедостача;
		
		// СуммаИзлишек
		СтрокаТаблицы[ИмяСуммаИзлишек] = СтрокаТаблицы[ИмяКоличествоИзлишек] * СтрокаТаблицы[ИмяЦена];
		
		//
		// 3. Очищаем реквизиты переменного использования (неиспользуемые)
		//
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ОчищающаяСтруктура);
		
	КонецЦикла;
	
КонецПроцедуры


Функция ПолучитьТекстЗапросаБлижайшиеОбщиеРодителиСчетов(ИмяВременнойТаблицыОстатки, ИмяПоляНФА, ИмяПоляИнвНомер = Неопределено, КоличествоПодзапросов) Экспорт
	
	КоличествоПодзапросов = 6;
	
	Возврат "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Лишь НФА и счета
	|//
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	" + ИмяПоляНФА + "	КАК НФА,
	|	" + ?(ИмяПоляИнвНомер = Неопределено, "НЕОПРЕДЕЛЕНО", ИмяПоляИнвНомер) + "	КАК ИнвНомер,
	|	Счет			КАК Счет
	|ПОМЕСТИТЬ
	|	НФАиСчета
	|ИЗ
	|	" + ИмяВременнойТаблицыОстатки + "
	|ИНДЕКСИРОВАТЬ ПО
	|	НФА,
	|	ИнвНомер,
	|	Счет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Свойства всех счетов указанной группы
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка										КАК Счет,
	|	Ссылка.Родитель								КАК Родитель1,
	|	Ссылка.Родитель.Родитель					КАК Родитель2,
	|	Ссылка.Родитель.Родитель.Родитель			КАК Родитель3,
	|	Ссылка.Родитель.Родитель.Родитель.Родитель	КАК Родитель4,
	|	ВЫБОР
	|		КОГДА Ссылка = &СчетГруппа ТОГДА
	|			0
	|		КОГДА Ссылка.Родитель = &СчетГруппа ТОГДА
	|			1
	|		КОГДА Ссылка.Родитель.Родитель = &СчетГруппа ТОГДА
	|			2
