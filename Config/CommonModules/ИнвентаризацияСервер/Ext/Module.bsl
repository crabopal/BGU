#Область ОтборПоПодразделению

// Для документов Решение, ИзменениеРешения.

Процедура УстановитьПредустановленныйОтборСчетаУчетПоПодразделениям(ФормаДокумента)
	
	ПредустановленныйОтбор = Неопределено;
	
	Объект = ФормаДокумента.Объект;
	
	Если ЗначениеЗаполнено(Объект.Подразделение) Тогда
		НастройкиКомпоновки = Новый НастройкиКомпоновкиДанных();
		
		НовыйЭлемент = НастройкиКомпоновки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		НовыйЭлемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("УчетПоПодразделениям");
		НовыйЭлемент.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		НовыйЭлемент.ПравоеЗначение = Истина;
		
		ПредустановленныйОтбор = ОбщегоНазначения.ЗначениеВСтрокуXML(НастройкиКомпоновки);
	КонецЕсли;
	
	ФормаДокумента.ПредустановленныйОтборСчета = ПредустановленныйОтбор;
	
КонецПроцедуры

Функция ПолучитьСообщениеОтбораПоПодразделениюДляРешения(СписокСчетов, КоличествоВыводимыхСчетов = 5)
	
	КоличествоСчетов = СписокСчетов.Количество();
	
	Если КоличествоСчетов = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	МассивСтрок = Новый Массив();
	МассивСтрок.Добавить(НСтр("ru='Подразделение заполнено в шапке документа, но в табличной части ""Объекты инвентаризации"" '"));
	
	Если КоличествоСчетов = 1 Тогда
		МассивСтрок.Добавить(НСтр("ru='указан счет (субсчет) '"));
	Иначе
		МассивСтрок.Добавить(НСтр("ru='указаны счета (субсчета) '"));
	КонецЕсли;
	
	РазделительСчетов = ", ";
	
	Счетчик = 0;
	
	Для Каждого СчетСсылка Из СписокСчетов Цикл
		Счетчик = Счетчик + 1;
		
		Если Счетчик > КоличествоВыводимыхСчетов Тогда
			Прервать;
		КонецЕсли;
		
		Если Счетчик > 1 Тогда
			МассивСтрок.Добавить(РазделительСчетов);
		КонецЕсли;
		
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока(Строка(СчетСсылка),,,, ПолучитьНавигационнуюСсылку(СчетСсылка)));
	КонецЦикла;
	
	Если КоличествоСчетов > КоличествоВыводимыхСчетов Тогда
		ТекстСтроки = СтрШаблон(НСтр("ru=' (и еще %1)'"), КоличествоСчетов - КоличествоВыводимыхСчетов);
		
		МассивСтрок.Добавить(ТекстСтроки);
	КонецЕсли;
	
	Если КоличествоСчетов = 1 Тогда
		МассивСтрок.Добавить(НСтр("ru=', на котором отключен учет по подразделениям.'"));
	Иначе
		МассивСтрок.Добавить(НСтр("ru=', на которых отключен учет по подразделениям.'"));
	КонецЕсли;
	
	МассивСтрок.Добавить(НСтр("ru='
		|
		|'"));
	МассивСтрок.Добавить(НСтр("ru='Необходимо либо очистить подразделение в шапке документа для возможности указания произвольных счетов, '"));
	МассивСтрок.Добавить(НСтр("ru='либо указать только счета с включенным учетом по подразделениям.'"));
	
	Возврат МассивСтрок;
	
КонецФункции

Функция ПолучитьСписокУникальныхЗаполненныхСчетовИзРешения(ТЧОбъекты)
	
	ВремТаблица = ТЧОбъекты.Выгрузить(, "Счет");
	ВремТаблица.Свернуть("Счет");
	
	СписокСчетов = ВремТаблица.ВыгрузитьКолонку("Счет");
	
	ПустыеЗначения = Новый Массив();
	ПустыеЗначения.Добавить(ПланыСчетов.ЕПСБУ.ПустаяСсылка());
	ПустыеЗначения.Добавить(Неопределено);
	ПустыеЗначения.Добавить(Null);
	
	Для Каждого ПустоеЗначение Из ПустыеЗначения Цикл
		Индекс = СписокСчетов.Найти(ПустоеЗначение);
		
		Если Индекс = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СписокСчетов.Удалить(Индекс);
	КонецЦикла;
	
	Возврат СписокСчетов;
	
КонецФункции

Функция ПолучитьИсключаемыеСчетаВсехОписейИзНастроек(ТаблицаНастроек)
	
	СписокСчетов = Новый Массив();
	
	Для Каждого СтрокаТаблицыНастроек Из ТаблицаНастроек Цикл
		Для Каждого СтрокаТаблицыКодовСчетов Из СтрокаТаблицыНастроек.ТаблицаКодовСчетов Цикл
			Для Каждого Счет Из СтрокаТаблицыКодовСчетов.СсылкиИсключаемыхСчетов Цикл
				Если СписокСчетов.Найти(Счет) = Неопределено Тогда
					СписокСчетов.Добавить(Счет);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	Возврат СписокСчетов;
	
КонецФункции

// Для документов описей.

Функция ПолучитьСпискиСчетовИзОписиДляПроверкиОтбораПоПодразделению(Знач ДокументОбъект, СтрокаТаблицыНастроек = Неопределено, ОписаниеРеквизитаСчет = Неопределено)
	
	// Определяется два списка счетов:
	//  - счета заполнения описи, определяются из описи или из настроек описи (для 0510467).
	//  - счета-исключения, определяются из настроек описи.
	
	Если СтрокаТаблицыНастроек = Неопределено Тогда
		ТаблицаНастроек = ПолучитьТаблицуНастроекЗаполненияОписейПоРешению(
			ТипЗнч(ДокументОбъект.Ссылка), Истина, ДокументОбъект.Организация);
		
		СтрокаТаблицыНастроек = ТаблицаНастроек[0];
	КонецЕсли;
	
	ОписаниеРеквизитаСчет = ДиагностироватьОписаниеРеквизитаОписи(СтрокаТаблицыНастроек.ИмяРеквизитаСчет);
	
	СпискиСчетов = Новый Структура();
	СпискиСчетов.Вставить("СчетаЗаполнения", ПолучитьСчетаЗаполненияОписи(ДокументОбъект, СтрокаТаблицыНастроек, ОписаниеРеквизитаСчет));
	СпискиСчетов.Вставить("СчетаИсключения", ПолучитьСчетаИсключенияОписиИзНастроек(СтрокаТаблицыНастроек));
	
	Возврат СпискиСчетов;
	
КонецФункции

Функция ПолучитьСообщениеОтбораПоПодразделениюДляОписи(ФормаДокумента, СписокСчетов, КоличествоВыводимыхСчетов = 5)
	
	КоличествоСчетов = СписокСчетов.Количество();
	
	Если КоличествоСчетов = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	МассивСтрок = Новый Массив();
	
	ОписаниеРеквизитаСчет = ФормаДокумента.ДанныеПанелиРасписки.ОписаниеОписиИзТаблицыНастроекЗаполненияОписейПоРешению.ОписаниеРеквизитаСчет;
	
	// Начальная часть.
	Если ОписаниеРеквизитаСчет.Отсутствует Или ОписаниеРеквизитаСчет.РасположенВШапке Тогда
		СчетСсылка = СписокСчетов[0];
		
		МассивСтрок.Добавить(НСтр("ru='Подразделение заполнено в шапке документа, но на счете заполнения описи '"));
		МассивСтрок.Добавить(Новый ФорматированнаяСтрока(Строка(СчетСсылка),,,, ПолучитьНавигационнуюСсылку(СчетСсылка)));
		МассивСтрок.Добавить(НСтр("ru=' отключен учет по подразделениям.'"));
		
	ИначеЕсли ОписаниеРеквизитаСчет.РасположенВТабличнойЧасти Тогда
		МассивСтрок.Добавить(НСтр("ru='Подразделение заполнено в шапке документа, но в табличной части ""Список счетов"" '"));
		
		Если КоличествоСчетов = 1 Тогда
			МассивСтрок.Добавить(НСтр("ru='указан счет (субсчет) '"));
		Иначе
			МассивСтрок.Добавить(НСтр("ru='указаны счета (субсчета) '"));
		КонецЕсли;
		
		РазделительСчетов = ", ";
		
		Счетчик = 0;
		
		Для Каждого СчетСсылка Из СписокСчетов Цикл
			Счетчик = Счетчик + 1;
			
			Если Счетчик > КоличествоВыводимыхСчетов Тогда
				Прервать;
			КонецЕсли;
			
			Если Счетчик > 1 Тогда
				МассивСтрок.Добавить(РазделительСчетов);
			КонецЕсли;
			
			МассивСтрок.Добавить(Новый ФорматированнаяСтрока(Строка(СчетСсылка),,,, ПолучитьНавигационнуюСсылку(СчетСсылка)));
		КонецЦикла;
		
		Если КоличествоСчетов > КоличествоВыводимыхСчетов Тогда
			ТекстСтроки = СтрШаблон(НСтр("ru=' (и еще %1)'"), КоличествоСчетов - КоличествоВыводимыхСчетов);
			
			МассивСтрок.Добавить(ТекстСтроки);
		КонецЕсли;
		
		Если КоличествоСчетов = 1 Тогда
			МассивСтрок.Добавить(НСтр("ru=', на котором отключен учет по подразделениям.'"));
		Иначе
			МассивСтрок.Добавить(НСтр("ru=', на которых отключен учет по подразделениям.'"));
		КонецЕсли;
	КонецЕсли;
	
	// Общая часть.
	МассивСтрок.Добавить(НСтр("ru='
		|
		|Заполнение описи при таком сочетании настроек не предусмотрено.
		|
		|'"));
	
	// Конечная часть.
	Если ОписаниеРеквизитаСчет.РасположенВШапке Тогда
		МассивСтрок.Добавить(НСтр("ru='В случае, если документ описи формируется по некоторому подразделению, '"));
		МассивСтрок.Добавить(НСтр("ru='то на счете заполнения описи должен быть включен учет по подразделениям.'"));
		
	ИначеЕсли ОписаниеРеквизитаСчет.РасположенВТабличнойЧасти Тогда
		МассивСтрок.Добавить(НСтр("ru='В случае, если документ описи формируется по некоторому подразделению, '"));
		МассивСтрок.Добавить(НСтр("ru='то на всех счетах (и их субсчетах) из табличной части ""Список счетов"" '"));
		МассивСтрок.Добавить(НСтр("ru='должен быть включен учет по подразделениям.'"));
	КонецЕсли;
	
	Возврат МассивСтрок;
	
КонецФункции

Функция ПолучитьСчетаЗаполненияОписи(ДокументОбъект, СтрокаТаблицыНастроек, ОписаниеРеквизитаСчет)
	
	СписокСчетов = Новый Массив();
	
	Если ОписаниеРеквизитаСчет.Отсутствует Тогда
		// Счета заполнения описи указаны только в настройках описи.
		Для Каждого СтрокаТаблицыКодовСчетов Из СтрокаТаблицыНастроек.ТаблицаКодовСчетов Цикл
			Для Каждого Счет Из СтрокаТаблицыКодовСчетов.СсылкиСчетов Цикл
				Если СписокСчетов.Найти(Счет) = Неопределено Тогда
					СписокСчетов.Добавить(Счет);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
	ИначеЕсли ОписаниеРеквизитаСчет.РасположенВШапке Тогда
		Счет = ДокументОбъект[ОписаниеРеквизитаСчет.ИмяПоля];
		
		Если ЗначениеЗаполнено(Счет) Тогда
			СписокСчетов.Добавить(Счет);
		КонецЕсли;
		
	ИначеЕсли ОписаниеРеквизитаСчет.РасположенВТабличнойЧасти Тогда
		Для Каждого СтрокаТаблицы Из ДокументОбъект[ОписаниеРеквизитаСчет.ИмяТабличнойЧасти] Цикл
			Счет = СтрокаТаблицы[ОписаниеРеквизитаСчет.ИмяКолонки];
			
			Если ЗначениеЗаполнено(Счет) И СписокСчетов.Найти(Счет) = Неопределено Тогда
				СписокСчетов.Добавить(Счет);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат СписокСчетов;
	
КонецФункции

Функция ПолучитьСчетаИсключенияОписиИзНастроек(СтрокаТаблицыНастроек)
	
	ЗапросПоискСсылокСчетов = Новый Запрос();
	
	КоллекцияСтрокНастроек = Новый Массив();
	КоллекцияСтрокНастроек.Добавить(СтрокаТаблицыНастроек);
	
	ПодготовитьПоискСсылокИсключаемыхСчетов(ЗапросПоискСсылокСчетов, КоллекцияСтрокНастроек);
	
	СписокСчетов = Новый Массив();
	
	Если ЗапросПоискСсылокСчетов.Текст = "" Тогда
		Возврат СписокСчетов;
	КонецЕсли;
	
	ТаблицаИсключаемыхСчетов = ЗапросПоискСсылокСчетов.Выполнить().Выгрузить();
	
	Для Каждого СтрокаТаблицы Из ТаблицаИсключаемыхСчетов Цикл
		Счет = СтрокаТаблицы.Ссылка;
		
		Если СписокСчетов.Найти(Счет) = Неопределено Тогда
			СписокСчетов.Добавить(Счет);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СписокСчетов;
	
КонецФункции

// Общие.

Функция НеобходимКонтрольОтбораПоПодразделению(Подразделение, ИспользоватьУчетПоПодразделениям = Неопределено)
	
	Если ИспользоватьУчетПоПодразделениям = Неопределено Тогда
		ЗначениеФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	Иначе
		ЗначениеФО = ИспользоватьУчетПоПодразделениям;
	КонецЕсли;
	
	Возврат ЗначениеФО И ЗначениеЗаполнено(Подразделение);
	
КонецФункции

Функция ПолучитьДатуОпределенияПримененияСчетовОтборПоПодразделению(ДатаДокумента)
	
	Если ЗначениеЗаполнено(ДатаДокумента) Тогда
		Возврат ДатаДокумента;
	Иначе
		Возврат ТекущаяДатаСеанса();
	КонецЕсли;
	
КонецФункции

Функция НайтиСтрокиСоСчетамиБезУчетаПоПодразделениям(ТаблицаДокумента, СписокСчетовДокумента, ИсключаемыеСчетаОписиИзНастроек, НаДату)
	
	ТаблицаСтрок = Новый ТаблицаЗначений();
	ТаблицаСтрок.Колонки.Добавить("ИндексСтроки", ОбщегоНазначения.ОписаниеТипаЧисло(6, 0, ДопустимыйЗнак.Неотрицательный));
	ТаблицаСтрок.Колонки.Добавить("Описание", Новый ОписаниеТипов("Строка"));
	
	ШаблонСчет = НСтр("ru='На счете %1 не ведется учет по подразделениям'");
	ШаблонСубсчет = НСтр("ru='На субсчете %1 не ведется учет по подразделениям'");
	
	ТаблицаСчетов = НайтиСчетаБезУчетаПоПодразделениям(СписокСчетовДокумента, ИсключаемыеСчетаОписиИзНастроек, НаДату, Истина);
	
	ПоискСчета = Новый Структура("Ссылка");
	
	КоличествоРодителейСчетов = 3;
	СтруктурыПоискаРодителей = Новый Массив();
	Для Счетчик = 1 По КоличествоРодителейСчетов Цикл
		ИмяЭлемента = "Родитель" + Строка(Счетчик);
		
		СтруктурыПоискаРодителей.Добавить(Новый Структура(ИмяЭлемента));
	КонецЦикла;
	
	ОчищающаяСтруктура = Новый Структура("Счет");
	
	ИндексСтроки = -1;
	
	Для Каждого СтрокаДокумента Из ТаблицаДокумента Цикл
		ИндексСтроки = ИндексСтроки + 1;
		
		Счет = СтрокаДокумента.Счет;
		
		Если Не ЗначениеЗаполнено(Счет) Тогда
			Продолжить;
		КонецЕсли;
		
		ПоискСчета.Ссылка = Счет;
		
		МассивСтрок = ТаблицаСчетов.НайтиСтроки(ПоискСчета);
		
		Если МассивСтрок.Количество() > 0 Тогда
			НоваяСтрока = ТаблицаСтрок.Добавить();
			НоваяСтрока.ИндексСтроки = ИндексСтроки;
			НоваяСтрока.Описание = СтрШаблон(ШаблонСчет, Строка(Счет));
		Иначе
			Для Счетчик = 1 По КоличествоРодителейСчетов Цикл
				ИмяЭлемента = "Родитель" + Строка(Счетчик);
				
				ПоискРодителя = СтруктурыПоискаРодителей[Счетчик - 1];
				
				ПоискРодителя[ИмяЭлемента] = Счет;
				
				МассивСтрок = ТаблицаСчетов.НайтиСтроки(ПоискРодителя);
				
				Если МассивСтрок.Количество() > 0 Тогда
					Субсчет = МассивСтрок[0].Ссылка;
					
					НоваяСтрока = ТаблицаСтрок.Добавить();
					НоваяСтрока.ИндексСтроки = ИндексСтроки;
					НоваяСтрока.Описание = СтрШаблон(ШаблонСубсчет, Строка(Субсчет));
					
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТаблицаСтрок;
	
КонецФункции

Функция НайтиСчетаБезУчетаПоПодразделениям(КоллекцияСчетов, ИсключаемыеСчетаИзНастроек, НаДату = Неопределено, ВыбратьРодителей = Ложь)
	
	Если ТипЗнч(КоллекцияСчетов) = Тип("ПланСчетовСсылка.ЕПСБУ") Тогда
		СписокСчетов = Новый Массив();
		СписокСчетов.Добавить(КоллекцияСчетов);
		
	ИначеЕсли ТипЗнч(КоллекцияСчетов) = Тип("ДанныеФормыКоллекция") Тогда
		СписокСчетов = КоллекцияСчетов.Выгрузить(, "Счет");
		
	Иначе
		СписокСчетов = КоллекцияСчетов;
	КонецЕсли;
	
	Если НаДату = Неопределено Тогда
		УсловиеНаДату = "ИСТИНА";
	Иначе
		УсловиеНаДату = "ДатаНачалаДействия <= &НаДату
		|	И (ДатаОкончанияДействия = &ПустаяДата ИЛИ ДатаОкончанияДействия >= &НаДату)";
	КонецЕсли;
	
	Если ВыбратьРодителей Тогда
		ТекстВыбратьРодителей = "
			|	ЕСТЬNULL(Родитель, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) КАК Родитель1,
			|	ЕСТЬNULL(Родитель.Родитель, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) КАК Родитель2,
			|	ЕСТЬNULL(Родитель.Родитель.Родитель, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) КАК Родитель3";
	Иначе
		ТекстВыбратьРодителей = "ИСТИНА КАК Поле1";
	КонецЕсли;
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("СписокСчетов", СписокСчетов);
	ЗапросПоиск.УстановитьПараметр("ИсключаемыеСчетаИзНастроек", ИсключаемыеСчетаИзНастроек);
	ЗапросПоиск.УстановитьПараметр("НаДату", НаДату);
	ЗапросПоиск.УстановитьПараметр("ПустаяДата", '00010101');
	ЗапросПоиск.Текст = "	
	|ВЫБРАТЬ
	|	Ссылка КАК Ссылка,
	|	&ТекстВыбратьРодителей
	|ИЗ
	|	ПланСчетов.ЕПСБУ
	|ГДЕ
	|	Ссылка В ИЕРАРХИИ(&СписокСчетов)
	|	И НЕ Ссылка В(&ИсключаемыеСчетаИзНастроек)
	|	И &УсловиеНаДату
	|	И НЕ ЭлементГруппа
	|	И НЕ УчетПоПодразделениям
	|УПОРЯДОЧИТЬ ПО
	|	Порядок";
	
	ЗапросПоиск.Текст = СтрЗаменить(ЗапросПоиск.Текст, "&УсловиеНаДату", УсловиеНаДату);
	ЗапросПоиск.Текст = СтрЗаменить(ЗапросПоиск.Текст, "&ТекстВыбратьРодителей", ТекстВыбратьРодителей);
	
	Таблица = ЗапросПоиск.Выполнить().Выгрузить();
	
	Если ВыбратьРодителей Тогда
		Возврат Таблица;
	Иначе
		Возврат Таблица.ВыгрузитьКолонку("Ссылка");
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область СписокСчетовНаФормеСпискаДокументов

Процедура УстановитьПараметрыВыбораОтбораПоСчетуНаФормеСпискаДокументовОписи(ФормаСписка)
	
	ТипДокумента = ОпределитьТипДокументаОписиИзФормыСписка(ФормаСписка);
	
	ТаблицаНастроек = ИнвентаризацияСервер.ПолучитьТаблицуНастроекЗаполненияОписейПоРешению(ТипДокумента, Истина);
	
	СтрокаТаблицыНастроек = ТаблицаНастроек[0];
	
	СписокСчетов = ПолучитьСписокСчетовЗаполненияОписиИзНастроек(СтрокаТаблицыНастроек);
	
	НовыйМассив = Новый Массив();
	
	НовыйПараметр = Новый ПараметрВыбора("ОграниченияСписокСчетов", СписокСчетов);
	НовыйМассив.Добавить(НовыйПараметр);
	
	НовыйПараметр = Новый ПараметрВыбора("ВыборГруппИЭлементов", Истина);
	НовыйМассив.Добавить(НовыйПараметр);
	
	НовыеПараметры = Новый ФиксированныйМассив(НовыйМассив);
	
	Элемент = ФормаСписка.Элементы.ОтборПоСчету;
	
	Элемент.ПараметрыВыбора = НовыеПараметры;
	
КонецПроцедуры

Процедура НастроитьПолеОтбораПоСчетуНаФормеСписка(ФормаСписка)
	
	Элемент = ФормаСписка.Элементы.ОтборПоСчету;
	
	Элемент.КнопкаВыпадающегоСписка = Ложь;
	Элемент.КнопкаСоздания = Ложь;
	Элемент.КнопкаВыбора = Истина;
	
	Элемент.ОтображениеКнопкиВыбора = ОтображениеКнопкиВыбора.ОтображатьВПолеВвода;
	Элемент.ИсторияВыбораПриВводе = ИсторияВыбораПриВводе.НеИспользовать;
	
	Элемент.РастягиватьПоГоризонтали = Ложь;
	
КонецПроцедуры	

Процедура ЗаполнитьПредставлениеСпискаСчетовНаФормеСпискаДокументов(ИмяЭлемента, Настройки, Строки,
		ИмяТЧСоСчетами, КоличествоСчитываемыхСчетов = Неопределено)
	
	ОбъектМетаданных = Метаданные.НайтиПоТипу(Настройки.Выбор.ДоступныеПоляВыбора.Элементы.Найти("Ссылка").ТипЗначения.Типы()[0]);
	
	ИмяДокумента = ОбъектМетаданных.Имя;
	
	ОграничиватьКоличествоСчетов = (КоличествоСчитываемыхСчетов <> Неопределено);
	
	КоличествоСчитываемыхСчетовСтрокой = ?(ОграничиватьКоличествоСчетов,
		Формат(КоличествоСчитываемыхСчетов + 1, "ЧГ=0"), // +1 для возможности диагностики наличия счетов сверх ограничения.
		"");
	
	Если ОграничиватьКоличествоСчетов Тогда
		ТекстЗапроса = "
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ТЧ.Ссылка				КАК Ссылка,
		|	ТЧ.Счет					КАК СчетСсылка,
		|	ТЧ.Счет.Представление	КАК Счет
		|ИЗ
		|	Документ.&ИмяДокумента.&ИмяТЧСоСчетами КАК ТЧ
		|ГДЕ
		|	ТЧ.Ссылка В(&СписокДокументов)
		|	И (ТЧ.Ссылка, ТЧ.Счет) В
		|		(ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ &КоличествоСчитываемыхСчетовСтрокой
		|			ТЧВнутренняя.Ссылка	КАК Ссылка,
		|			ТЧВнутренняя.Счет	КАК СчетСсылка
		|		ИЗ
		|			Документ.&ИмяДокумента.&ИмяТЧСоСчетами КАК ТЧВнутренняя
		|		ГДЕ
		|			ТЧВнутренняя.Ссылка = ТЧ.Ссылка)";
		
	Иначе
		ТекстЗапроса = "
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ТЧ.Ссылка				КАК Ссылка,
		|	ТЧ.Счет					КАК СчетСсылка,
		|	ТЧ.Счет.Представление	КАК Счет
		|ИЗ
		|	Документ.&ИмяДокумента.&ИмяТЧСоСчетами КАК ТЧ
		|ГДЕ
		|	ТЧ.Ссылка В(&СписокДокументов)";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИмяДокумента", ИмяДокумента);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИмяТЧСоСчетами", ИмяТЧСоСчетами);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&КоличествоСчитываемыхСчетовСтрокой", КоличествоСчитываемыхСчетовСтрокой);
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("СписокДокументов", Строки.ПолучитьКлючи());
	ЗапросПоиск.Текст = ТекстЗапроса;
	
	УстановитьПривилегированныйРежим(Истина);
	ОбщаяВыборкаСчетов = ЗапросПоиск.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	
	Для Каждого Элемент Из Строки Цикл
		Данные = Элемент.Значение.Данные;
		
		Данные.ПредставлениеСпискаСчетов = ПолучитьПредставлениеСписокСчетовДокумента(ОбщаяВыборкаСчетов, Данные.Ссылка, КоличествоСчитываемыхСчетов);
	КонецЦикла;
	
КонецПроцедуры

Функция ОпределитьТипДокументаОписиИзФормыСписка(ФормаСписка)
	
	МассивСлов = СтрРазделить(ФормаСписка.ИмяФормы, ".", Ложь);
	
	ИмяДокумента = МассивСлов[1];
	
	ТипДокумента = Тип(СтрШаблон("ДокументСсылка.%1", ИмяДокумента));
	
	Возврат ТипДокумента;
	
КонецФункции

Функция ПолучитьСписокСчетовЗаполненияОписиИзНастроек(СтрокаТаблицыНастроек)
	
	СписокСчетов = Новый Массив();
	
	Для Каждого СтрокаТаблицы Из СтрокаТаблицыНастроек.ТаблицаКодовСчетов Цикл
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СписокСчетов, СтрокаТаблицы.СсылкиСчетов);
	КонецЦикла;
	
	ДобавитьСубсчета(СписокСчетов);
	
	СчетаИсключения = ПолучитьСчетаИсключенияОписиИзНастроек(СтрокаТаблицыНастроек);
	
	Если СтрокаТаблицыНастроек.ТипОписи = Тип("ДокументСсылка.ИнвентаризационнаяОписьНФА") Тогда
		ПользовательскиеСчета = ПолучитьВсеПользовательскиеСчетаИнвентаризацииНФА();
		
		Для Каждого Счет Из ПользовательскиеСчета Цикл
			Если СписокСчетов.Найти(Счет) = Неопределено И СчетаИсключения.Найти(Счет) = Неопределено Тогда
				СписокСчетов.Добавить(Счет);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого Счет Из СчетаИсключения Цикл
		Индекс = СписокСчетов.Найти(Счет);
		
		Если Индекс <> Неопределено Тогда
			СписокСчетов.Удалить(Индекс);
		КонецЕсли;
	КонецЦикла;
	
	Возврат СписокСчетов;
	
КонецФункции

Процедура ДобавитьСубсчета(СписокСчетов, НаДату = Неопределено)
	
	Если НаДату = Неопределено Тогда
		НаДату = ТекущаяДатаСеанса();
	КонецЕсли;
	
	ИспользоватьОтборПоДате = Истина;
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("СписокСчетов", СписокСчетов);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьОтборПоДате", ИспользоватьОтборПоДате);
	ЗапросПоиск.УстановитьПараметр("НаДату", НаДату);
	ЗапросПоиск.УстановитьПараметр("ПустаяДата", '00010101');
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ
	|	Ссылка КАК Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ
	|ГДЕ
	|	Ссылка В ИЕРАРХИИ(&СписокСчетов)
	|	И ВЫБОР
	|		КОГДА &ИспользоватьОтборПоДате ТОГДА
	|			ДатаНачалаДействия <= &НаДату
	|			И (ДатаОкончанияДействия = &ПустаяДата ИЛИ ДатаОкончанияДействия >= &НаДату)
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ
	|УПОРЯДОЧИТЬ ПО
	|	Порядок";
	
	УстановитьПривилегированныйРежим(Истина);
	СписокСчетов = ЗапросПоиск.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Функция ПолучитьВсеПользовательскиеСчетаИнвентаризацииНФА()
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СчетГруппа КАК СчетГруппа
	|ПОМЕСТИТЬ
	|	УказанныеСчета
	|ИЗ
	|	РегистрСведений.ДополнительныеГруппыСчетовИнвентаризацииМЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Ссылка КАК Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ
	|ГДЕ
	|	Ссылка В ИЕРАРХИИ(ВЫБРАТЬ СчетГруппа ИЗ УказанныеСчета)
	|УПОРЯДОЧИТЬ ПО
	|	Порядок";
	
	УстановитьПривилегированныйРежим(Истина);
	СписокСчетов = ЗапросПоиск.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат СписокСчетов;
	
КонецФункции

Функция ПолучитьПредставлениеСписокСчетовДокумента(ОбщаяВыборкаСчетов, СсылкаОписи, КоличествоСчетов)
	
	ОграничиватьКоличествоСчетов = (КоличествоСчетов <> Неопределено);
	
	ТекстСокращение = "...";
	
	ПоискОписи = Новый Структура("Ссылка", СсылкаОписи);
	
	ОбщаяВыборкаСчетов.Сбросить();
	
	СписокТекстов = Новый Массив();
	
	Счетчик = 0;
	
	Пока ОбщаяВыборкаСчетов.НайтиСледующий(ПоискОписи) Цикл
		Счетчик = Счетчик + 1;
		
		Если ОграничиватьКоличествоСчетов И Счетчик > КоличествоСчетов Тогда
			СписокТекстов.Добавить(ТекстСокращение);
			Прервать;
		КонецЕсли;
		
		ПредставлениеСчета = ?(ЗначениеЗаполнено(ОбщаяВыборкаСчетов.Счет), ОбщаяВыборкаСчетов.Счет, "000.00");
		
		СписокТекстов.Добавить(ПредставлениеСчета);
	КонецЦикла;
	
	Возврат СтрСоединить(СписокТекстов, ", ");
	
КонецФункции

#КонецОбласти

#Область РасшифровкаСКД

Процедура ЗаполнитьСпискиПолейИГруппировкиРодителей(ОписаниеЭлементаРасшифровки, ЭлементРасшифровки, ЭтоОбходРодителя = Ложь)
	
	Если ТипЗнч(ЭлементРасшифровки) = Тип("ЭлементРасшифровкиКомпоновкиДанныхПоля") Тогда
		Для Каждого ЗначениеПоля Из ЭлементРасшифровки.ПолучитьПоля() Цикл
			СвойстваПоляРасшифровкиКД = НовыйСвойстваПоляРасшифровкиКД();
			
			ЗаполнитьЗначенияСвойств(СвойстваПоляРасшифровкиКД, ЗначениеПоля);
			
			СписокПолей = ?(ЭтоОбходРодителя,
				ОписаниеЭлементаРасшифровки.СписокРодительскихПолей,
				ОписаниеЭлементаРасшифровки.СписокПолей);
				
			СписокПолей.Вставить(ЗначениеПоля.Поле, СвойстваПоляРасшифровкиКД);
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(ЭлементРасшифровки) = Тип("ЭлементРасшифровкиКомпоновкиДанныхГруппировка") Тогда
		ОписаниеЭлементаРасшифровки.ГруппировкиРодителей.Добавить(ЭлементРасшифровки.Группировка);
	КонецЕсли;
	
	Для Каждого Родитель Из ЭлементРасшифровки.ПолучитьРодителей() Цикл
		ЗаполнитьСпискиПолейИГруппировкиРодителей(ОписаниеЭлементаРасшифровки, Родитель, Истина);
	КонецЦикла;
	
КонецПроцедуры

// Содержит свойства, аналогичные платформенному типу ЗначениеПоляРасшифровкиКомпоновкиДанных,
// кроме свойства Поле.
Функция НовыйСвойстваПоляРасшифровкиКД()
	
	Возврат Новый Структура("Значение,Иерархия");
	
КонецФункции

#КонецОбласти

#Область ГрупповоеСопоставлениеСтрокРешенияИОписей

Процедура СопоставитьОписиСТаблицейОбъекты(СписокРешений, ТаблицаОбъекты, ТаблицыОписей, ТаблицаНастроек,
		РасположенияРеквизитовОписей, НастройкиИменПолейРешения)
	
	// Для описей, у которых и счет, и место инвентаризации указываются в шапке документа,
	// сопоставление со строкой таблицы Объекты выполняется по простому равенству значений соответствующих полей.
	
	// Для описей, у которых счет или место инвентаризации указываются в табличных частях,
	// сопоставление со строкой таблицы Объекты выполняется по наличию строк таблицы Объекты
	// для всевозможных сочетаний значений полей табличных частей описи.
	// Для таких описей в таблице Объекты должны быть все счета, все места инвентаризации, указанные в описи.
	// И в каждой такой строке таблицы Объекты поля должны совпадать с полями шапки описи.
	// Если в описи есть некоторое сочетание строк табличных частей, для которого нет соответствующей строки
	// в таблице Объекты, то такая опись считается не сопоставленной.
	
	ДобавитьКолонкиДляСопоставления(ТаблицаОбъекты, ТаблицыОписей);
	
	Для Каждого РешениеСсылка Из СписокРешений Цикл
		
		Для Каждого Элемент Из ТаблицыОписей Цикл
			ИмяДокумента		= Элемент.Ключ;
			ТаблицыВидаОписи	= Элемент.Значение;
			ТаблицаШапокОписей	= ТаблицыВидаОписи.Шапки;
			
			ЗначениеРасположенияРеквизитовОписи = РасположенияРеквизитовОписей[ИмяДокумента];
			
			ЗначениеНастройкиИменОписи = НастройкиИменПолейРешения[ИмяДокумента];
			
			КодФормы = ПолучитьКодФормыПоИмениДокумента(ИмяДокумента, ТаблицаНастроек);
			
			МассивСтрокТаблицыОбъекты = НайтиСтрокиТаблицыОбъектыДляВидаОписи(ТаблицаОбъекты, РешениеСсылка, КодФормы, ТаблицаНастроек);
			
			Если МассивСтрокТаблицыОбъекты.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Для Каждого СтрокаШапкиОписи Из ТаблицаШапокОписей Цикл
				ИндексыСопоставленныхСтрокТаблицОписи = Новый Структура();
				ИндексыСопоставленныхСтрокТаблицОписи.Вставить("СписокСчетов", Новый Массив());
				ИндексыСопоставленныхСтрокТаблицОписи.Вставить("МестаИнвентаризации", Новый Массив());
				
				ОписьБылаСопоставлена = Ложь;
				
				СопоставленныеПоляШапки = Новый Соответствие();
				
				Для Каждого СтрокаТаблицыОбъекты Из МассивСтрокТаблицыОбъекты Цикл
					ИндексСтрокиТаблицыОбъекты = ТаблицаОбъекты.Индекс(СтрокаТаблицыОбъекты);
					
					Если ТипЗнч(ЗначениеРасположенияРеквизитовОписи) = Тип("Соответствие") Тогда
						// Для описей с несколькими строками в таблице настроек.
						
						ИндексСтроки = ОпределитьИндексПодходящейСтрокиТаблицыНастроекДляСопоставленияОписиСТаблицейОбъекты(
							ИмяДокумента, СтрокаТаблицыОбъекты, ТаблицаНастроек);
							
						РасположениеРеквизитовОписи = ЗначениеРасположенияРеквизитовОписи.Получить(ИндексСтроки);
						
						НастройкиИменОписи = ЗначениеНастройкиИменОписи.Получить(ИндексСтроки);
					Иначе
						РасположениеРеквизитовОписи = ЗначениеРасположенияРеквизитовОписи;
						
						НастройкиИменОписи = ЗначениеНастройкиИменОписи;
					КонецЕсли;
					
					// Сопоставляем поля шапки описи.
					НеСопоставленныеПоляШапки = Новый Соответствие();
					
					СопоставитьНаборПолейШапкиОписиИСтрокиТаблицыОбъекты(СтрокаШапкиОписи, СтрокаТаблицыОбъекты,
						НастройкиИменОписи.ИменаПолейРешения,
						НастройкиИменОписи.СоответствиеИменРешениеОпись,
						НеСопоставленныеПоляШапки, СопоставленныеПоляШапки);
					
					// Сопоставляем таблицы описи.
					ЕстьТабличныеЧасти = РасположениеРеквизитовОписи.Счет.РасположенВТабличнойЧасти
						Или РасположениеРеквизитовОписи.МестоИнвентаризации.РасположенВТабличнойЧасти;
					
					ЕстьСопоставленныеСтрокиТаблицОписи = Неопределено;
					
					Если ЕстьТабличныеЧасти Тогда
						СопоставитьТабличныеЧастиОписиИСтрокиТаблицыОбъекты(СтрокаШапкиОписи, СтрокаТаблицыОбъекты,
							ТаблицыВидаОписи, РасположениеРеквизитовОписи,
							ИндексыСопоставленныхСтрокТаблицОписи, ЕстьСопоставленныеСтрокиТаблицОписи);
					КонецЕсли;
					
					ОписьСопоставленаСтроке = (НеСопоставленныеПоляШапки.Количество() = 0);
					
					Если ЕстьТабличныеЧасти Тогда
						ОписьСопоставленаСтроке = ОписьСопоставленаСтроке И ЕстьСопоставленныеСтрокиТаблицОписи;
					КонецЕсли;
					
					Если ОписьСопоставленаСтроке Тогда
						// Опись успешно сопоставлена со строкой Решения.
						ОписьБылаСопоставлена = Истина;
						
						// Записываем сопоставление в таблицу объектов.
						НоваяСтрокаСопоставленныеОписи = СтрокаТаблицыОбъекты.СопоставленныеОписи.Добавить();
						НоваяСтрокаСопоставленныеОписи.ИмяДокумента = ИмяДокумента;
						НоваяСтрокаСопоставленныеОписи.ИндексСтрокиТаблицыШапокОписей = ТаблицаШапокОписей.Индекс(СтрокаШапкиОписи);
						
						СтрокаТаблицыОбъекты.КоличествоСопоставленныхОписей = СтрокаТаблицыОбъекты.СопоставленныеОписи.Количество();
						СтрокаТаблицыОбъекты.ЕстьСопоставленныеОписи = Истина;
						
						// Записываем сопоставление в таблицу описей.
						СтрокаШапкиОписи.ИндексыСопоставленныхСтрокТаблицыОбъекты.Добавить(ИндексСтрокиТаблицыОбъекты);
						СтрокаШапкиОписи.КоличествоСопоставленныхСтрокТаблицыОбъекты = СтрокаШапкиОписи.ИндексыСопоставленныхСтрокТаблицыОбъекты.Количество();
						СтрокаШапкиОписи.ЕстьСопоставленныеСтрокиТаблицыОбъекты = Истина;
					КонецЕсли;
				КонецЦикла;
				
				НеСопоставленныеПоляШапки = ОпределитьНеСопоставленныеПоляШапки(СопоставленныеПоляШапки, НастройкиИменОписи);
				
				СтрокаШапкиОписи.НеСопоставленныеПоляШапки = НеСопоставленныеПоляШапки;
				
				НеСопоставленныеЗначенияИзТаблиц = ОпределитьНеСопоставленныеЗначенияИзТаблиц(ИмяДокумента, СтрокаШапкиОписи,
					ТаблицыВидаОписи, ИндексыСопоставленныхСтрокТаблицОписи, РасположениеРеквизитовОписи);
				
				СтрокаШапкиОписи.НеСопоставленныеЗначенияИзТаблиц = НеСопоставленныеЗначенияИзТаблиц;
				
				Если ОписьБылаСопоставлена И НеСопоставленныеЗначенияИзТаблиц <> Неопределено Тогда
					ИндексСтрокиТаблицыШапокОписей = ТаблицаШапокОписей.Индекс(СтрокаШапкиОписи);
					
					УдалитьСопоставлениеОписи(СтрокаШапкиОписи, ТаблицаОбъекты, ИмяДокумента, ИндексСтрокиТаблицыШапокОписей);
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьНастройкиИменПолейРешенияДляСопоставленияСШапкамиОписей(РасположенияРеквизитовОписей, ТаблицаНастроек)
	
	НастройкиИмен = Новый Структура();
	
	Для Каждого Элемент Из РасположенияРеквизитовОписей Цикл
		ИмяДокумента = Элемент.Ключ;
		РасположениеРеквизитов = Элемент.Значение;
		
		СтрокаТаблицыНастроек = ТаблицаНастроек.Найти(ИмяДокумента, "ИмяДокумента");
		
		ОписаниеПолей = ПолучитьОписаниеПолейРешенияДляСопоставленияСШапкамиОписей(РасположениеРеквизитов, СтрокаТаблицыНастроек.Приказ52н);
		
		НастройкиИмен.Вставить(ИмяДокумента, ОписаниеПолей);
	КонецЦикла;
	
	Возврат НастройкиИмен;
	
КонецФункции

Функция ПолучитьОписаниеПолейРешенияДляСопоставленияСШапкамиОписей(Знач РасположениеРеквизитов, Знач ЭтоОписьПриказа52н)
	
	Если ТипЗнч(РасположениеРеквизитов) = Тип("Соответствие") Тогда
		// Для описей с несколькими строками в таблице настроек.
		
		ОписаниеПолей = Новый Соответствие();
		
		// Особенности описи.
		Для Каждого Элемент Из РасположениеРеквизитов Цикл
			ИндексСтрокиТаблицыНастроек = Элемент.Ключ;
			СтруктураРасположениеРеквизитов = Элемент.Значение;
			
			ОписаниеПолей.Вставить(ИндексСтрокиТаблицыНастроек,
				ПолучитьОписаниеПолейРешенияДляСопоставленияСШапкамиОписей(СтруктураРасположениеРеквизитов, ЭтоОписьПриказа52н));
		КонецЦикла;
		
		Возврат ОписаниеПолей;
	КонецЕсли;
	
	// Стандартный набор.
	Если ЭтоОписьПриказа52н Тогда
		ИменаПолейРешения = ПолучитьСтандартныйНаборПолейРешенияДляСопоставленияСШапкамиОписей52н();
	Иначе
		ИменаПолейРешения = ПолучитьСтандартныйНаборПолейРешенияДляСопоставленияСШапкамиОписей61н();
	КонецЕсли;
	
	ИменаПолейРешения = СтрРазделить(ИменаПолейРешения, ", ", Ложь);
	
	СоответствиеИменРешениеОпись = Новый Соответствие();
	
	ДобавитьИменаИСоответствиеПолейРешенияДляСопоставленияСШапкамиОписей(
		ИменаПолейРешения, СоответствиеИменРешениеОпись, РасположениеРеквизитов);
	
	Если СоответствиеИменРешениеОпись.Количество() = 0 Тогда
		СоответствиеИменРешениеОпись = Неопределено;
	КонецЕсли;
	
	ОписаниеПолей = Новый Структура();
	ОписаниеПолей.Вставить("ИменаПолейРешения", ИменаПолейРешения);
	ОписаниеПолей.Вставить("СоответствиеИменРешениеОпись", СоответствиеИменРешениеОпись);
	
	Возврат ОписаниеПолей;
	
КонецФункции

Процедура ДобавитьИменаИСоответствиеПолейРешенияДляСопоставленияСШапкамиОписей(ИменаПолейРешения, СоответствиеИменРешениеОпись,
		РасположениеРеквизитов)
	
	СписокПолей = СтрРазделить("Сотрудник,МестоИнвентаризации,КФО,Счет", ", ", Ложь);
	
	Для Каждого ИмяПоля Из СписокПолей Цикл
		Если РасположениеРеквизитов[ИмяПоля].РасположенВШапке Тогда
			ИменаПолейРешения.Добавить(ИмяПоля);
			
			Если ИмяПоля <> РасположениеРеквизитов[ИмяПоля].ИмяПоля Тогда
				СоответствиеИменРешениеОпись.Вставить(ИмяПоля, РасположениеРеквизитов[ИмяПоля].ИмяПоля);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ОпределитьНеСопоставленныеПоляШапки(СопоставленныеПоляШапки, НастройкиИменОписи)
	
	НеСопоставленныеПоляШапки = Новый Соответствие();
	
	Для Каждого ИмяПоля Из НастройкиИменОписи.ИменаПолейРешения Цикл
		Если СопоставленныеПоляШапки.Получить(ИмяПоля) = Неопределено Тогда
			НеСопоставленныеПоляШапки.Вставить(ИмяПоля, Истина);
		КонецЕсли;
	КонецЦикла;
	
	Возврат НеСопоставленныеПоляШапки;
	
КонецФункции

Функция ОпределитьИндексПодходящейСтрокиТаблицыНастроекДляСопоставленияОписиСТаблицейОбъекты(ИмяДокумента,
		СтрокаТаблицыОбъекты, ТаблицаНастроек)
	
	Для Каждого СтрокаТаблицы Из СтрокаТаблицыОбъекты.СопоставленныеСтрокиНастроек Цикл
		НомерСтрокиТаблицыНастроек = СтрокаТаблицы.НомерСтрокиТаблицыНастроек;
		
		ИндексСтрокиТаблицыНастроек = НомерСтрокиТаблицыНастроек - 1;
		
		СтрокаТаблицыНастроек = ТаблицаНастроек[ИндексСтрокиТаблицыНастроек];
		
		Если СтрокаТаблицыНастроек.ИмяДокумента = ИмяДокумента Тогда
			Возврат ИндексСтрокиТаблицыНастроек;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Процедура ДобавитьКолонкиДляСопоставления(ТаблицаОбъекты, ТаблицыОписей)
	
	// Колонки для сопоставления с таблицей описей.
	ТаблицаОбъекты.Колонки.Добавить("СопоставленныеОписи",				Новый ОписаниеТипов("ТаблицаЗначений"));
	ТаблицаОбъекты.Колонки.Добавить("ЕстьСопоставленныеОписи",			Новый ОписаниеТипов("Булево"));
	ТаблицаОбъекты.Колонки.Добавить("КоличествоСопоставленныхОписей",	ОбщегоНазначения.ОписаниеТипаЧисло(6, 0, ДопустимыйЗнак.Неотрицательный));
	
	Для Каждого СтрокаТаблицы Из ТаблицаОбъекты Цикл
		СтрокаТаблицы.СопоставленныеОписи = НовыйСопоставленныеОписи();
	КонецЦикла;
	
	// Колонки для сопоставления с таблицей объектов.
	Для Каждого Элемент Из ТаблицыОписей Цикл
		ИмяДокумента		= Элемент.Ключ;
		ТаблицыВидаОписи	= Элемент.Значение;
		ТаблицаШапокОписей	= ТаблицыВидаОписи.Шапки;
		
		// Колонки для сопоставления с таблицей объектов.
		ТаблицаШапокОписей.Колонки.Добавить("ИндексыСопоставленныхСтрокТаблицыОбъекты",		Новый ОписаниеТипов("Массив"));
		ТаблицаШапокОписей.Колонки.Добавить("ЕстьСопоставленныеСтрокиТаблицыОбъекты",		Новый ОписаниеТипов("Булево"));
		ТаблицаШапокОписей.Колонки.Добавить("КоличествоСопоставленныхСтрокТаблицыОбъекты",	ОбщегоНазначения.ОписаниеТипаЧисло(6, 0, ДопустимыйЗнак.Неотрицательный));
		ТаблицаШапокОписей.Колонки.Добавить("НеСопоставленныеПоляШапки",					Новый ОписаниеТипов("Соответствие"));
		ТаблицаШапокОписей.Колонки.Добавить("НеСопоставленныеЗначенияИзТаблиц",				Новый ОписаниеТипов("Структура"));
		
		Для Каждого СтрокаТаблицы Из ТаблицаШапокОписей Цикл
			СтрокаТаблицы.ИндексыСопоставленныхСтрокТаблицыОбъекты = Новый Массив();
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Функция НовыйСопоставленныеОписи()
	
	СопоставленныеОписи = Новый ТаблицаЗначений();
	СопоставленныеОписи.Колонки.Добавить("ИмяДокумента",					Новый ОписаниеТипов("Строка"));
	СопоставленныеОписи.Колонки.Добавить("ИндексСтрокиТаблицыШапокОписей",	ОбщегоНазначения.ОписаниеТипаЧисло(6, 0, ДопустимыйЗнак.Неотрицательный));
	
	Возврат СопоставленныеОписи;
	
КонецФункции

Функция НайтиСтрокиТаблицыОбъектыДляВидаОписи(ТаблицаОбъекты, РешениеСсылка, КодФормы, ТаблицаНастроек)
	
	ИмяКолонки = ПолучитьИмяКолонкиДляБыстрогоПоиска(КодФормы);
	
	Если ТаблицаОбъекты.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
		Возврат Новый Массив();
	КонецЕсли;
	
	Поиск = Новый Структура();
	Поиск.Вставить("Решение", РешениеСсылка);
	Поиск.Вставить(ИмяКолонки, Истина);
	
	Возврат ТаблицаОбъекты.НайтиСтроки(Поиск);
	
КонецФункции

Процедура СопоставитьНаборПолейШапкиОписиИСтрокиТаблицыОбъекты(Знач СтрокаШапкиОписи, Знач СтрокаТаблицыОбъекты,
		Знач ИменаПолейРешения, Знач СоответствиеИменРешениеОпись = Неопределено,
		НеСопоставленныеПоляШапки, СопоставленныеПоляШапки)
	
	Для Каждого ИмяПоляРешения Из ИменаПолейРешения Цикл
		ИмяПоляОписи = Неопределено;
		
		Если СоответствиеИменРешениеОпись <> Неопределено Тогда
			ИмяПоляОписи = СоответствиеИменРешениеОпись.Получить(ИмяПоляРешения);
		КонецЕсли;
		
		Если ИмяПоляОписи = Неопределено Тогда
			ИмяПоляОписи = ИмяПоляРешения;
		КонецЕсли;
		
		Если СтрокаТаблицыОбъекты[ИмяПоляРешения] = СтрокаШапкиОписи[ИмяПоляОписи] Тогда
			СопоставленныеПоляШапки.Вставить(ИмяПоляРешения, Истина);
		Иначе
			НеСопоставленныеПоляШапки.Вставить(ИмяПоляРешения, Истина);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура СопоставитьТабличныеЧастиОписиИСтрокиТаблицыОбъекты(Знач СтрокаШапкиОписи, Знач СтрокаТаблицыОбъекты,
		Знач ТаблицыВидаОписи, Знач РасположениеРеквизитовОписи,
		ИндексыСопоставленныхСтрокТаблицОписи, ЕстьСопоставленныеСтрокиТаблицОписи)
	
	Перем ЕстьСписокСчетов, ЕстьМестаИнвентаризации;
	
	Если РасположениеРеквизитовОписи.Счет.РасположенВТабличнойЧасти Тогда
		СопоставитьТабличнуюЧастьСписокСчетов(СтрокаШапкиОписи, СтрокаТаблицыОбъекты, ТаблицыВидаОписи,
			РасположениеРеквизитовОписи, ИндексыСопоставленныхСтрокТаблицОписи, ЕстьСписокСчетов);
	КонецЕсли;
	
	Если РасположениеРеквизитовОписи.МестоИнвентаризации.РасположенВТабличнойЧасти Тогда
		СопоставитьТабличнуюЧастьМестаИнвентаризации(СтрокаШапкиОписи, СтрокаТаблицыОбъекты, ТаблицыВидаОписи,
			РасположениеРеквизитовОписи, ИндексыСопоставленныхСтрокТаблицОписи, ЕстьМестаИнвентаризации);
	КонецЕсли;
	
	ЕстьСопоставленныеСтрокиТаблицОписи = Ложь;
	
	Если ЕстьСписокСчетов <> Неопределено И ЕстьМестаИнвентаризации <> Неопределено Тогда
		ЕстьСопоставленныеСтрокиТаблицОписи = ЕстьСписокСчетов И ЕстьМестаИнвентаризации;
		
	ИначеЕсли ЕстьСписокСчетов <> Неопределено Тогда
		ЕстьСопоставленныеСтрокиТаблицОписи = ЕстьСписокСчетов;
		
	ИначеЕсли ЕстьМестаИнвентаризации <> Неопределено Тогда
		ЕстьСопоставленныеСтрокиТаблицОписи = ЕстьМестаИнвентаризации;
	КонецЕсли;
	
КонецПроцедуры

Функция ОпределитьНеСопоставленныеЗначенияИзТаблиц(ИмяДокумента, СтрокаШапкиОписи,
		ТаблицыВидаОписи, ИндексыСопоставленныхСтрокТаблицОписи, РасположениеРеквизитовОписи)
	
	Перем СписокСчетов, МестаИнвентаризации;
	
	ОписьСсылка = СтрокаШапкиОписи.Ссылка;
	
	Если РасположениеРеквизитовОписи.Счет.РасположенВТабличнойЧасти Тогда
		СписокСчетов = ПолучитьОтсутствующиеЗначенияСписокСчетов(ОписьСсылка,
			ТаблицыВидаОписи.СписокСчетов, ИндексыСопоставленныхСтрокТаблицОписи.СписокСчетов);
	КонецЕсли;
	
	Если РасположениеРеквизитовОписи.МестоИнвентаризации.РасположенВТабличнойЧасти Тогда
		МестаИнвентаризации = ПолучитьОтсутствующиеЗначенияМестаИнвентаризации(ОписьСсылка,
			ТаблицыВидаОписи.МестаИнвентаризации, ИндексыСопоставленныхСтрокТаблицОписи.МестаИнвентаризации);
	КонецЕсли;
	
	ЕстьСписокСчетов = (СписокСчетов <> Неопределено И СписокСчетов.Количество() > 0);
	ЕстьМестаИнвентаризации = (МестаИнвентаризации <> Неопределено И МестаИнвентаризации.Количество() > 0);
	
	Если Не ЕстьСписокСчетов И Не ЕстьМестаИнвентаризации Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НеСопоставленныеЗначения = Новый Структура();
	
	Если ЕстьСписокСчетов Тогда
		НеСопоставленныеЗначения.Вставить("СписокСчетов", СписокСчетов);
	КонецЕсли;
	
	Если ЕстьМестаИнвентаризации Тогда
		НеСопоставленныеЗначения.Вставить("МестаИнвентаризации", МестаИнвентаризации);
	КонецЕсли;
	
	Возврат НеСопоставленныеЗначения;
	
КонецФункции

Функция ПолучитьОтсутствующиеЗначенияСписокСчетов(ОписьСсылка, ТаблицаСписокСчетов, ИндексыСопоставленныхСтрок)
	
	МассивЗначений = Новый Массив();
	
	Поиск = Новый Структура("Ссылка", ОписьСсылка);
	
	ВсеСтроки = ТаблицаСписокСчетов.НайтиСтроки(Поиск);
	
	Если ИндексыСопоставленныхСтрок.Количество() = ВсеСтроки.Количество() Тогда
		Возврат МассивЗначений;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из ВсеСтроки Цикл
		ИндексСтроки = ТаблицаСписокСчетов.Индекс(СтрокаТаблицы);
		
		Если ИндексыСопоставленныхСтрок.Найти(ИндексСтроки) = Неопределено Тогда
			// Такая строка не была сопоставлена ранее.
			ОтсутствующееЗначение = Новый Структура("КФО,Счет");
			
			ЗаполнитьЗначенияСвойств(ОтсутствующееЗначение, СтрокаТаблицы);
			
			МассивЗначений.Добавить(ОтсутствующееЗначение);
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивЗначений;
	
КонецФункции

Функция ПолучитьОтсутствующиеЗначенияМестаИнвентаризации(ОписьСсылка, ТаблицаМестаИнвентаризации, ИндексыСопоставленныхСтрок)
	
	МассивЗначений = Новый Массив();
	
	Поиск = Новый Структура("Ссылка", ОписьСсылка);
	
	ВсеСтроки = ТаблицаМестаИнвентаризации.НайтиСтроки(Поиск);
	
	Если ИндексыСопоставленныхСтрок.Количество() = ВсеСтроки.Количество() Тогда
		Возврат МассивЗначений;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из ВсеСтроки Цикл
		ИндексСтроки = ТаблицаМестаИнвентаризации.Индекс(СтрокаТаблицы);
		
		Если ИндексыСопоставленныхСтрок.Найти(ИндексСтроки) = Неопределено Тогда
			// Такая строка не была сопоставлена ранее.
			МассивЗначений.Добавить(СтрокаТаблицы.МестоИнвентаризации);
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивЗначений;
	
КонецФункции

Процедура УдалитьСопоставлениеОписи(СтрокаШапкиОписи, ТаблицаОбъекты, ИмяДокумента, ИндексСтрокиТаблицыШапокОписей)
	
	// Удаляем сопоставление из таблицы Объекты.
	Поиск = Новый Структура("ИмяДокумента,ИндексСтрокиТаблицыШапокОписей", ИмяДокумента, ИндексСтрокиТаблицыШапокОписей);
	
	Для Каждого ИндексСтроки Из СтрокаШапкиОписи.ИндексыСопоставленныхСтрокТаблицыОбъекты Цикл
		СтрокаТаблицыОбъекты = ТаблицаОбъекты[ИндексСтроки];
		
		СтрокаТаблицыСопоставленныеОписи = СтрокаТаблицыОбъекты.СопоставленныеОписи.НайтиСтроки(Поиск)[0];
		
		СтрокаТаблицыОбъекты.СопоставленныеОписи.Удалить(СтрокаТаблицыСопоставленныеОписи);
		
		СтрокаТаблицыОбъекты.КоличествоСопоставленныхОписей = СтрокаТаблицыОбъекты.СопоставленныеОписи.Количество();
		СтрокаТаблицыОбъекты.ЕстьСопоставленныеОписи = (СтрокаТаблицыОбъекты.КоличествоСопоставленныхОписей > 0);
	КонецЦикла;
	
	// Удаляем сопоставление из таблицы шапок описей.
	СтрокаШапкиОписи.ИндексыСопоставленныхСтрокТаблицыОбъекты.Очистить();
	СтрокаШапкиОписи.КоличествоСопоставленныхСтрокТаблицыОбъекты = 0;
	СтрокаШапкиОписи.ЕстьСопоставленныеСтрокиТаблицыОбъекты = Ложь;
	
КонецПроцедуры

Процедура СопоставитьТабличнуюЧастьСписокСчетов(Знач СтрокаШапкиОписи, Знач СтрокаТаблицыОбъекты, Знач ТаблицыВидаОписи,
		РасположениеРеквизитовОписи, ИндексыСопоставленныхСтрокТаблицОписи, ЕстьСопоставленнаяСтрокаТаблицыОписи)
	
	Поиск = Новый Структура();
	Поиск.Вставить("Ссылка", СтрокаШапкиОписи.Ссылка);
	Поиск.Вставить(РасположениеРеквизитовОписи.Счет.ИмяКолонки, СтрокаТаблицыОбъекты.Счет);
	
	Если РасположениеРеквизитовОписи.КФО.РасположенВТабличнойЧасти Тогда
		Поиск.Вставить(РасположениеРеквизитовОписи.КФО.ИмяКолонки, СтрокаТаблицыОбъекты.КФО);
	КонецЕсли;
	
	ТаблицаОписи = ТаблицыВидаОписи[РасположениеРеквизитовОписи.Счет.ИмяТабличнойЧасти];
	
	МассивСтрок = ТаблицаОписи.НайтиСтроки(Поиск);
	
	ЕстьСопоставленнаяСтрокаТаблицыОписи = (МассивСтрок.Количество() > 0);
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		ИндексСтроки = ТаблицаОписи.Индекс(СтрокаТаблицы);
		
		Если ИндексыСопоставленныхСтрокТаблицОписи.СписокСчетов.Найти(ИндексСтроки) = Неопределено Тогда
			ИндексыСопоставленныхСтрокТаблицОписи.СписокСчетов.Добавить(ИндексСтроки);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура СопоставитьТабличнуюЧастьМестаИнвентаризации(Знач СтрокаШапкиОписи, Знач СтрокаТаблицыОбъекты, Знач ТаблицыВидаОписи,
		РасположениеРеквизитовОписи, ИндексыСопоставленныхСтрокТаблицОписи, ЕстьСопоставленнаяСтрокаТаблицыОписи)
	
	Поиск = Новый Структура();
	Поиск.Вставить("Ссылка", СтрокаШапкиОписи.Ссылка);
	Поиск.Вставить("МестоИнвентаризации", СтрокаТаблицыОбъекты.МестоИнвентаризации);
	
	ЗаполнитьЗначенияСвойств(Поиск, СтрокаТаблицыОбъекты);
	
	МассивСтрок = ТаблицыВидаОписи.МестаИнвентаризации.НайтиСтроки(Поиск);
	
	ЕстьСопоставленнаяСтрокаТаблицыОписи = (МассивСтрок.Количество() > 0);
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		ИндексСтроки = ТаблицыВидаОписи.МестаИнвентаризации.Индекс(СтрокаТаблицы);
		
		Если ИндексыСопоставленныхСтрокТаблицОписи.МестаИнвентаризации.Найти(ИндексСтроки) = Неопределено Тогда
			ИндексыСопоставленныхСтрокТаблицОписи.МестаИнвентаризации.Добавить(ИндексСтроки);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьИмяКолонкиДляБыстрогоПоиска(КодФормы)
	
	Возврат СтрШаблон("КолонкаБыстрогоПоиска%1", КодФормы);
	
КонецФункции

#КонецОбласти

#Область ГрупповоеФормированиеОписей

#Область ПолучениеДанных

Функция НайтиПоследниеДокументыДеревьев(ТаблицыДокументов, ЗаполняемыйДокументСсылка = Неопределено)
	
	ПоследниеДокументы = НовыйПоследниеДокументы();
	
	ВремТаблица = ТаблицыДокументов.СРешением.Скопировать(, "Решение");
	ВремТаблица.Свернуть("Решение");
	
	СписокРешений = ВремТаблица.ВыгрузитьКолонку("Решение");
	
	ТаблицыТекущегоДокумента = Новый Структура();
	ТаблицыТекущегоДокумента.Вставить("БезРешения", ТаблицыДокументов.БезРешения);
	
	Для Каждого РешениеСсылка Из СписокРешений Цикл
		НоваяСтрока = ПоследниеДокументы.Добавить();
		НоваяСтрока.Решение = РешениеСсылка;
		
		ТаблицыТекущегоДокумента.Вставить("СРешением", ТаблицыДокументов.СРешением.Скопировать(Новый Структура("Решение", РешениеСсылка)));
		
		РезультатПроверки = ПостроитьДеревоДокументовДляВводаНаОсновании(РешениеСсылка, ЗаполняемыйДокументСсылка, ТаблицыТекущегоДокумента);
		
		ТаблицаОшибок = РезультатПроверки.Дерево.ТаблицаОшибок;
		
		НоваяСтрока.ТаблицаОшибок = ТаблицаОшибок;
		
		Если ТаблицаОшибок.Количество() > 0 Тогда	
			НоваяСтрока.ЕстьОшибкиПостроенияЦепочки = Истина;
		Иначе
			НоваяСтрока.ПоследнийДокумент = РезультатПроверки.Дерево.ПоследнийДокумент;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ПоследниеДокументы;
	
КонецФункции

Функция НовыйПоследниеДокументы()
	
	МассивТипов = Новый Массив();
	МассивТипов.Добавить(Тип("ДокументСсылка.РешениеОПроведенииИнвентаризации"));
	МассивТипов.Добавить(Тип("ДокументСсылка.ИзменениеРешенияОПроведенииИнвентаризации"));
	
	ТипБулево = Новый ОписаниеТипов("Булево");
	
	ПоследниеДокументы = Новый ТаблицаЗначений();
	ПоследниеДокументы.Колонки.Добавить("Решение",						Новый ОписаниеТипов("ДокументСсылка.РешениеОПроведенииИнвентаризации"));
	ПоследниеДокументы.Колонки.Добавить("ПоследнийДокумент",			Новый ОписаниеТипов(МассивТипов));
	ПоследниеДокументы.Колонки.Добавить("ЕстьОшибкиПостроенияЦепочки",	ТипБулево);
	ПоследниеДокументы.Колонки.Добавить("ТаблицаОшибок",				Новый ОписаниеТипов("ТаблицаЗначений"));
	
	Возврат ПоследниеДокументы;
	
КонецФункции

Функция ПолучитьПризнакиДокументовРешений(СписокРешений, ТаблицыДокументов, ПоследниеДокументыДеревьев)
	
	ПризнакиДокументовРешений = Новый Соответствие();
	
	Для Каждого РешениеСсылка Из СписокРешений Цикл
		ПризнакиДокументаРешения = ПолучитьПризнакиДокументаРешения(РешениеСсылка, ТаблицыДокументов, ПоследниеДокументыДеревьев);
		
		ПризнакиДокументовРешений.Вставить(РешениеСсылка, ПризнакиДокументаРешения);
	КонецЦикла;
	
	Возврат ПризнакиДокументовРешений;
	
КонецФункции

Функция ПолучитьПризнакиДокументаРешения(РешениеСсылка, ТаблицыДокументов, ПоследниеДокументыДеревьев)
	
	// Признаки содержатся в таблице ТаблицыДокументов.СРешением.
	
	ПризнакиДокументаРешения = НовыйПризнакиДокументаРешения();
	
	ПоискРешения = Новый Структура();
	ПоискРешения.Вставить("Решение", РешениеСсылка);
	ПоискРешения.Вставить("ЭтоИзменениеРешения", Ложь);
	
	МассивСтрок = ТаблицыДокументов.СРешением.НайтиСтроки(ПоискРешения);
	
	Если МассивСтрок.Количество() = 0 Тогда
		// Решение помечено на удаление и не участвует в построении цепочки документов.
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РешениеСсылка, "Дата,Номер,ПометкаУдаления,Проведен");
		
		ПризнакиДокументаРешения.Дата				= ЗначенияРеквизитов.Дата;
		ПризнакиДокументаРешения.НомерСистемный		= ЗначенияРеквизитов.Номер;
		ПризнакиДокументаРешения.НомерДляПечати		= ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(РешениеСсылка, ЗначенияРеквизитов.Номер);
		ПризнакиДокументаРешения.ПометкаУдаления	= ЗначенияРеквизитов.ПометкаУдаления;
		ПризнакиДокументаРешения.Проведен			= ЗначенияРеквизитов.Проведен;
		
		Возврат ПризнакиДокументаРешения;
	КонецЕсли;
	
	СтрокаТаблицы = МассивСтрок[0];
	
	ПризнакиДокументаРешения.Дата				= СтрокаТаблицы.Дата;
	ПризнакиДокументаРешения.НомерСистемный		= СтрокаТаблицы.Номер;
	ПризнакиДокументаРешения.НомерДляПечати		= ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(РешениеСсылка, СтрокаТаблицы.Номер);
	ПризнакиДокументаРешения.ПометкаУдаления	= СтрокаТаблицы.РешениеПометкаУдаления;
	ПризнакиДокументаРешения.Проведен			= СтрокаТаблицы.РешениеПроведен;
	
	Поиск = Новый Структура("Решение", РешениеСсылка);
	
	СтрокаПоследнегоДокумента = ПоследниеДокументыДеревьев.НайтиСтроки(Поиск)[0];
	
	ЗаполнитьЗначенияСвойств(ПризнакиДокументаРешения, СтрокаПоследнегоДокумента, "ЕстьОшибкиПостроенияЦепочки,ТаблицаОшибок");
	
	ПоследнийДокумент = СтрокаПоследнегоДокумента.ПоследнийДокумент;
	
	Если ТипЗнч(ПоследнийДокумент) = Тип("ДокументСсылка.ИзменениеРешенияОПроведенииИнвентаризации") Тогда
		ПоискИзмененияРешения = Новый Структура();
		ПоискИзмененияРешения.Вставить("Решение", РешениеСсылка);
		ПоискИзмененияРешения.Вставить("ИзменениеРешения", ПоследнийДокумент);
		
		МассивСтрок = ТаблицыДокументов.СРешением.НайтиСтроки(ПоискИзмененияРешения);
		
		Если МассивСтрок.Количество() > 0 Тогда
			СтрокаТаблицы = МассивСтрок[0];
			
			ПризнакиДокументаРешения.Аннулировано = СтрокаТаблицы.Аннулирующее;
			ПризнакиДокументаРешения.КоличествоИзменений = СтрокаТаблицы.НомерИзменения;
		КонецЕсли;
		
		ПризнакиДокументаРешения.ПоследнееИзменение = ПоследнийДокумент;
	КонецЕсли;
	
	Возврат ПризнакиДокументаРешения;
	
КонецФункции

Функция НовыйПризнакиДокументаРешения()
	
	ПризнакиДокументаРешения = Новый Структура();
	ПризнакиДокументаРешения.Вставить("Дата",					'00010101');
	ПризнакиДокументаРешения.Вставить("НомерСистемный",			"");
	ПризнакиДокументаРешения.Вставить("НомерДляПечати",			"");
	ПризнакиДокументаРешения.Вставить("ПометкаУдаления",		Ложь);
	ПризнакиДокументаРешения.Вставить("Проведен",				Ложь);
	ПризнакиДокументаРешения.Вставить("Аннулировано",			Ложь);
	ПризнакиДокументаРешения.Вставить("КоличествоИзменений",	0);
	ПризнакиДокументаРешения.Вставить("ПоследнееИзменение");
	
	ПризнакиДокументаРешения.Вставить("ЕстьОшибкиПостроенияЦепочки", Ложь);
	ПризнакиДокументаРешения.Вставить("ТаблицаОшибок"); // На форму не передается, очищается.
	
	Возврат ПризнакиДокументаРешения;
	
КонецФункции

Функция ПрочитатьТаблицуОбъектыПоследнихДокументовДеревьев(ПоследниеДокументыДеревьев)
	
	ВремТаблица = ПоследниеДокументыДеревьев.Скопировать(, "ПоследнийДокумент");
	ВремТаблица.Свернуть("ПоследнийДокумент");
	
	СписокДокументов = ВремТаблица.ВыгрузитьКолонку("ПоследнийДокумент");
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("СписокДокументов", СписокДокументов);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Ссылка					КАК Решение,
	|	ЗНАЧЕНИЕ(Документ.ИзменениеРешенияОПроведенииИнвентаризации.ПустаяСсылка) КАК ИзменениеРешения,
	|	Ссылка					КАК ПоследнийДокумент,
	|	ЗНАЧЕНИЕ(Перечисление.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.ПустаяСсылка) КАК ТипИзменения,
	|	НомерСтроки				КАК НомерСтроки,
	|	Примечание				КАК Примечание,
	|	// Показатели актуальные
	|	КФО						КАК КФО,
	|	Счет					КАК Счет,
	|	Сотрудник				КАК Сотрудник,
	|	ДатаИнвентаризации		КАК ДатаИнвентаризации,
	|	ДатаНачала				КАК ДатаНачала,
	|	ДатаОкончания			КАК ДатаОкончания,
	|	НомерКомиссии			КАК НомерКомиссии,
	|	НомерРабочейКомиссии	КАК НомерРабочейКомиссии,
	|	МестоИнвентаризации		КАК МестоИнвентаризации
	|ИЗ
	|	Документ.РешениеОПроведенииИнвентаризации.Объекты
	|ГДЕ
	|	Ссылка В(&СписокДокументов)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ДокРешение.Ссылка				КАК Решение,
	|	ДокИзменениеРешения.Ссылка		КАК ИзменениеРешения,
	|	ДокИзменениеРешения.Ссылка		КАК ПоследнийДокумент,
	|	ТЧОбъекты.ТипИзменения			КАК ТипИзменения,
	|	ТЧОбъекты.НомерСтроки			КАК НомерСтроки,
	|	ТЧОбъекты.Примечание			КАК Примечание,
	|	// Показатели актуальные
	|	ТЧОбъекты.КФО					КАК КФО,
	|	ТЧОбъекты.Счет					КАК Счет,
	|	ТЧОбъекты.Сотрудник				КАК Сотрудник,
	|	ТЧОбъекты.ДатаИнвентаризации	КАК ДатаИнвентаризации,
	|	ТЧОбъекты.ДатаНачала			КАК ДатаНачала,
	|	ТЧОбъекты.ДатаОкончания			КАК ДатаОкончания,
	|	ТЧОбъекты.НомерКомиссии			КАК НомерКомиссии,
	|	ТЧОбъекты.НомерРабочейКомиссии	КАК НомерРабочейКомиссии,
	|	ТЧОбъекты.МестоИнвентаризации	КАК МестоИнвентаризации
	|ИЗ
	|	Документ.ИзменениеРешенияОПроведенииИнвентаризации.Объекты КАК ТЧОбъекты
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИзменениеРешенияОПроведенииИнвентаризации КАК ДокИзменениеРешения
	|		ПО ТЧОбъекты.Ссылка = ДокИзменениеРешения.Ссылка
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РешениеОПроведенииИнвентаризации КАК ДокРешение
	|		ПО ДокИзменениеРешения.Решение = ДокРешение.Ссылка
	|ГДЕ
	|	ТЧОбъекты.Ссылка В(&СписокДокументов)
	|	И НЕ ТЧОбъекты.ТипИзменения = ЗНАЧЕНИЕ(Перечисление.ТипыИзмененияСтрокиРешенияОПроведенииИнвентаризации.Отмена)";
	
	Возврат ЗапросПоиск.Выполнить().Выгрузить();
	
КонецФункции

Процедура ПрименитьОтборТаблицыОбъектыДляГрупповогоФормированияОписей(ТаблицаОбъекты, ПараметрыПоиска)
	
	ОтборМассивКодовФорм = ПараметрыПоиска.ОтборМассивКодовФорм;
	
	Если ОтборМассивКодовФорм.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	УдаляемыеСтроки = Новый Массив();
	
	Для Каждого СтрокаТаблицыОбъекты Из ТаблицаОбъекты Цикл
		НайденКодФормы = Ложь;
		
		Для Каждого КодФормы Из СтрокаТаблицыОбъекты.МассивКодовФорм Цикл
			Если ОтборМассивКодовФорм.Найти(КодФормы) <> Неопределено Тогда
				НайденКодФормы = Истина;
				
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Не НайденКодФормы Тогда
			УдаляемыеСтроки.Добавить(СтрокаТаблицыОбъекты);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого УдаляемаяСтрока Из УдаляемыеСтроки Цикл
		ТаблицаОбъекты.Удалить(УдаляемаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДополнитьТаблицуОбъектыКолонкамиКодовФормДляБыстрогоПоиска(ТаблицаОбъекты, РазличныеКодыФорм)
	
	// Создаем колонки-флажки вида КолонкаБыстрогоПоиска<КодФормы>
	
	РазличныеКодыФорм = Новый Массив();
	
	Для Каждого СтрокаТаблицы Из ТаблицаОбъекты Цикл
		Для Каждого КодФормы Из СтрокаТаблицы.МассивКодовФорм Цикл
			ИмяКолонки = ПолучитьИмяКолонкиДляБыстрогоПоиска(КодФормы);
			
			Если РазличныеКодыФорм.Найти(КодФормы) = Неопределено Тогда
				РазличныеКодыФорм.Добавить(КодФормы);
				
				ТаблицаОбъекты.Колонки.Добавить(ИмяКолонки, Новый ОписаниеТипов("Булево"));
			КонецЕсли;
			
			СтрокаТаблицы[ИмяКолонки] = Истина;
		КонецЦикла;
	КонецЦикла;
	
	ВремСписок = Новый СписокЗначений();
	ВремСписок.ЗагрузитьЗначения(РазличныеКодыФорм);
	ВремСписок.СортироватьПоЗначению();
	
	РазличныеКодыФорм = ВремСписок.ВыгрузитьЗначения();
	
КонецПроцедуры

Функция ПолучитьРасположенияРеквизитовОписей(ТаблицыОписей, ТаблицаНастроек)
	
	РасположенияРеквизитов = Новый Структура();
	
	Для Каждого Элемент Из ТаблицыОписей Цикл
		ИмяДокумента = Элемент.Ключ;
		
		Поиск = Новый Структура("ИмяДокумента", ИмяДокумента);
		
		МассивСтрок = ТаблицаНастроек.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() = 1 Тогда
			СтрокаТаблицыНастроек = МассивСтрок[0];
			
			РасположениеРеквизитов = ПолучитьОписаниеРасположенияРеквизитовОписи(СтрокаТаблицыНастроек);
			
		ИначеЕсли МассивСтрок.Количество() > 1 Тогда
			// Для описей с несколькими строками в таблице настроек.
			
			ЗначениеРасположенияРеквизитовОписи = Новый Соответствие();
			
			Для Каждого СтрокаТаблицыНастроек Из МассивСтрок Цикл
				РасположениеРеквизитов = ПолучитьОписаниеРасположенияРеквизитовОписи(СтрокаТаблицыНастроек);
				
				ИндексСтрокиТаблицыНастроек = ТаблицаНастроек.Индекс(СтрокаТаблицыНастроек);
				
				ЗначениеРасположенияРеквизитовОписи.Вставить(ИндексСтрокиТаблицыНастроек, РасположениеРеквизитов);
			КонецЦикла;
			
			РасположениеРеквизитов = ЗначениеРасположенияРеквизитовОписи;
		КонецЕсли;
		
		РасположенияРеквизитов.Вставить(ИмяДокумента, РасположениеРеквизитов);
	КонецЦикла;
	
	Возврат РасположенияРеквизитов;
	
КонецФункции

#КонецОбласти

#Область ЧтениеОписей

Функция ПрочитатьТаблицыОписейДляГрупповогоФормированияОписей(СписокРешений, ПараметрыПоиска, РазличныеКодыФорм, ЧитатьПомеченныеНаУдаление = Ложь)
	
	Перем ТаблицыДокумента;
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("СписокРешений", СписокРешений);
	ЗапросПоиск.УстановитьПараметр("ЧитатьПомеченныеНаУдаление", ЧитатьПомеченныеНаУдаление);
	
	ИндексыТаблиц = Новый Структура();
	ИндексыТаблиц.Вставить("ПоследнийДобавленныйИндекс", -1);

	ЗапросПоиск.Текст = ПолучитьТекстЗапросаГрупповоеФормированиеОписей(ИндексыТаблиц, ПараметрыПоиска, РазличныеКодыФорм);
	
	УпорядочитьИндексыПодзапросов(ЗапросПоиск.Текст);
	
	ИндексыТаблиц.Удалить("ПоследнийДобавленныйИндекс");
	
	ТаблицыОписей = Новый Структура();
	
	Если ИндексыТаблиц.Количество() = 0 Тогда
		Возврат ТаблицыОписей;
	КонецЕсли;
	
	РезультатыЗапроса = ЗапросПоиск.ВыполнитьПакет();
	
	Для Каждого Элемент Из ИндексыТаблиц Цикл
		МассивИмен = СтрРазделить(Элемент.Ключ, "_");
		
		ИмяДокумента	= МассивИмен[0];
		ИмяТаблицы		= МассивИмен[1];
		ИндексТаблицы	= Элемент.Значение;
		
		Таблица = РезультатыЗапроса[ИндексТаблицы].Выгрузить();
		
		Таблица.Индексы.Добавить("Ссылка");
		
		Если Не ТаблицыОписей.Свойство(ИмяДокумента, ТаблицыДокумента) Тогда
			ТаблицыДокумента = Новый Структура();
			
			ТаблицыОписей.Вставить(ИмяДокумента, ТаблицыДокумента);
		КонецЕсли;
		
		ТаблицыДокумента.Вставить(ИмяТаблицы, Таблица);
	КонецЦикла;
	
	Возврат ТаблицыОписей;
	
КонецФункции

