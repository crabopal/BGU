Процедура ДобавитьУсловноеОформление_НедоступностьСтатусаОбъясненияПриОтсутствииОтклонений(ФормаДокумента) Экспорт
	
	НастройкиСтатусаОбъяснения = ПолучитьНастройкиСтатусаОбъяснения(ФормаДокумента.Объект.Ссылка);
	
	ПоказателиОтклонений	= НастройкиСтатусаОбъяснения.ПоказателиОтклонений;
	ИмяТабличнойЧасти		= НастройкиСтатусаОбъяснения.ИмяТабличнойЧасти;
	
	УсловноеОформление = ФормаДокумента.УсловноеОформление;
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = СтрШаблон(НСтр("ru='Недоступность статуса объяснения при отсутствии расхождений (%1)'"), ИмяТабличнойЧасти);
	
	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект." + ИмяТабличнойЧасти + ".СтатусОбъяснения");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Перечисления.СтатусыОбъясненияОтветственногоЛица.НеТребуется;
	
	Для Каждого ИмяПоля Из ПоказателиОтклонений Цикл
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект." + ИмяТабличнойЧасти + "." + ИмяПоля);
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	КонецЦикла;
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
	
	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТабличнойЧасти + "СтатусОбъяснения");

КонецПроцедуры

