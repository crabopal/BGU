		ОбластьТитул.Параметры.Заполнить(ОписаниеМОЛ);
		ТабДокумент.Вывести(ОбластьТитул);
		
		//---
		// Расписка
		//---
		ОбластьРасписка = Макет.ПолучитьОбласть("Расписка");
		ОбластьРасписка.Параметры.Заполнить(ОписаниеМОЛ);
		
		КомпонентыДатыДляПодписи = ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи('00010101');
		ОбластьРасписка.Параметры.Заполнить(КомпонентыДатыДляПодписи);
		
		ТабДокумент.Вывести(ОбластьРасписка);
		
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		//---
		// Подвал
		//---
		// Здесь заполняем, но пока не выводим.
		// Используется для проверки вывода далее.
		
		Выборки = Новый Структура();
		Выборки.Вставить("Шапка",				ВыборкаШапка);
		Выборки.Вставить("ДокументКомиссия",	ВыборкаДокументКомиссия);
		Выборки.Вставить("ДокументТаблицаНФА",	ВыборкаДокументТаблицаНФА);
		
		КомпонентыДатыДляПодписи = ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи(ВыборкаШапка["ДатаПодписиМОЛ"]);
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ОписаниеМОЛ",					ОписаниеМОЛ);
		ДополнительныеПараметры.Вставить("КоличествоСтрокВыборки",		КоличествоСтрокВыборки);
		ДополнительныеПараметры.Вставить("КомпонентыДатыДляПодписи",	КомпонентыДатыДляПодписи);
		
		//---
		// Таблица
		//---
		ПараметрыВыводаТаблицы.Выборки.ИтогиТаблицы = Выборки.ДокументТаблицаНФА;
		ПараметрыВыводаТаблицы.Выборки.ДетальныеЗаписи = Выборки.ДокументТаблицаНФА.Выбрать();
		
		ПараметрыВыводаТаблицы.ДополнительныеПараметры.Вставить("КоличествоЗнаковПослеЗапятойДляКоличества", КоличествоЗнаковПослеЗапятойДляКоличества);
		ПараметрыВыводаТаблицы.ДополнительныеПараметры.Вставить("ЭтоИнвентаризация11140", ЭтоИнвентаризация11140);
		
		ИнвентаризацияСервер.ВывестиТаблицуСРазбивкойНаСтраницы(ПараметрыВыводаТаблицы);
		
		ИнвентаризацияСервер.ОчиститьИтогиИСтатистикуВывода(ПараметрыВыводаТаблицы);
		
		//---
		// Подвал
