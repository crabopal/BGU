
#Область ПрограммныйИнтерфейс

Процедура НачатьПоискНоменклатурыПоШтрихкоду(ОписаниеОповещения, ПараметрыОбработки, КэшированныеЗначения, Форма) Экспорт
	
	НоменклатураПоШтрихкоду = РозничныеПродажиБГУВызовСервера.ПолучитьНоменклатуруПоШтрихкоду(ПараметрыОбработки, КэшированныеЗначения);
	
	Если НЕ НоменклатураПоШтрихкоду.Количество() = 0 Тогда
		
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, НоменклатураПоШтрихкоду);
		
	Иначе
		
		Если ПараметрыОбработки.ДействияСНеизвестнымиШтрихкодами = "Зарегистрировать" Тогда
			
			Кнопки = Новый СписокЗначений;
			
			Кнопки.Добавить("СоздатьНовыйТовар", НСтр("ru = 'Создать новый товар'"));
			Кнопки.Добавить("УказатьВСуществующем", НСтр("ru = 'Записать штрихкод в существующий товар'"));
			Кнопки.Добавить("Отмена", НСтр("ru = 'Отмена'"));
			
			ТекстВопроса = НСтр("ru = 'Товар со штрихкодом %1 не найден'");
			ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстВопроса, ПараметрыОбработки.Штрихкоды.Штрихкод);
			
			ДополнительныеПараметры = Новый Структура;
			ДополнительныеПараметры.Вставить("Штрихкод", ПараметрыОбработки.Штрихкоды.Штрихкод);
			ДополнительныеПараметры.Вставить("Форма", Форма);
			ДополнительныеПараметры.Вставить("ОписаниеОповещениеПриЗавершении", ОписаниеОповещения);
			ДополнительныеПараметры.Вставить("ПараметрыОбработки", ПараметрыОбработки);
			ДополнительныеПараметры.Вставить("КэшированныеЗначения", КэшированныеЗначения);
			
			Оповещение = Новый ОписаниеОповещения("ЗарегистрироватьШтрихкодыПродолжение", ЭтотОбъект, ДополнительныеПараметры);
			
			ПоказатьВопрос(Оповещение, ТекстВопроса, Кнопки,, "СоздатьНовыйТовар");
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

// Процедура показывает ввод штрихкода и оповещает в случае успешного ввода
//
// Параметры:
//  ОповещениеУспешногоВвода - ОписаниеОповещения - описание оповещения успешного ввода штрихкода
//  Заголовок                - Строка             - переопределяемый загловок
Процедура ПоказатьВводШтрихкода(ОповещениеУспешногоВвода, Количество = Неопределено, Заголовок = "") Экспорт 
	
	Если НЕ ЗначениеЗаполнено(Заголовок) Тогда
		Заголовок = НСтр("ru = 'Введите штрихкод'");
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура(
		"ОповещениеУспешногоВвода, Количество",
		ОповещениеУспешногоВвода,
		Количество);
		
	Оповещение = Новый ОписаниеОповещения(
		"ПоказатьВводШтрихкодаЗавершение",
		ЭтотОбъект,
		ДополнительныеПараметры);
		
	ПоказатьВводЗначения(Оповещение, "", Заголовок);
	
КонецПроцедуры

Процедура ОткрытьПодборПрейскуранта(Форма, Объект, ДополнительныйПараметр = Неопределено, ПараметрыОтбора = Неопределено) Экспорт

	Параметры = Новый Структура;
	
	ДатаРасчетов 		= ?(НачалоДня(Объект.Дата) = НачалоДня(ТекущаяДата()) И Объект.Ссылка.Пустая(), Неопределено, Объект.Дата);
	ЗаголовокПодбора 	= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Подбор номенклатуры из прейскуранта в %1'"), Объект.Ссылка);
	Параметры.Вставить("ДатаРасчетов"	, ДатаРасчетов);	
	Параметры.Вставить("Организация"	, Объект.Организация);
	Параметры.Вставить("Заголовок"		, ЗаголовокПодбора);
	Параметры.Вставить("ЕстьЦена"		, ЗначениеЗаполнено(Объект.ТипЦены));
    	
	ИспользуетсяДоговорПлатежногоАгента = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "ПараметрыДоговораПлатежногоАгента");
	Параметры.Вставить("ИспользуетсяДоговорПлатежногоАгента", ИспользуетсяДоговорПлатежногоАгента);
	Если ИспользуетсяДоговорПлатежногоАгента Тогда	
		Параметры.Вставить("ПараметрыДоговораПлатежногоАгента", Объект.ПараметрыДоговораПлатежногоАгента);
	КонецЕсли;
	
	Если ТипЗнч(ПараметрыОтбора) = Тип("Структура") Тогда 
		Для Каждого КлючИЗначение Из ПараметрыОтбора Цикл
			Параметры.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
	Иначе
		Форма.ДополнитьСтруктуруПодбора(Параметры);
	КонецЕсли;	
		
	ОценкаПроизводительностиКлиент.ЗамерВремени("ОткрытиеФормыПодборИзПрейскуранта");
	ОткрытьФорму("Обработка.ПодборИзПрейскуранта.Форма.ФормаПодбора", Параметры, Форма, Форма.УникальныйИдентификатор);
	
КонецПроцедуры	


#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗарегистрироватьШтрихкодыПродолжение(Результат, ДополнительныеПараметры) Экспорт
	
	ДополнительныеПараметры.Вставить("Действие", Результат);
	
	Описание = Новый ОписаниеОповещения("ЗарегистрироватьШтрихкодыЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	Если Результат = "СоздатьНовыйТовар" Тогда
		
		ДанныеЗаполнения = Новый Структура;
		ДанныеЗаполнения.Вставить("Штрихкод", ДополнительныеПараметры.Штрихкод);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Основание", ДанныеЗаполнения);
		
		ОткрытьФорму("Справочник.Прейскурант.ФормаОбъекта", ПараметрыФормы, ДополнительныеПараметры.Форма,,,, Описание,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца
		);
		
	ИначеЕсли Результат = "УказатьВСуществующем" Тогда
		
		ОткрытьФорму("Справочник.Прейскурант.ФормаВыбора",, ДополнительныеПараметры.Форма,,,, Описание,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца
		);
		
	Иначе
		
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОписаниеОповещениеПриЗавершении, Новый Массив);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗарегистрироватьШтрихкодыЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	НоменклатураПоШтрихкоду = Новый Массив;
	
	Если Результат = Неопределено И ДополнительныеПараметры.Действие = "СоздатьНовыйТовар" Тогда
		
		НоменклатураПоШтрихкоду = РозничныеПродажиБГУВызовСервера.ПолучитьНоменклатуруПоШтрихкоду(
			ДополнительныеПараметры.ПараметрыОбработки,
			ДополнительныеПараметры.КэшированныеЗначения
		);
		
		ДополнительныеПараметры.ОписаниеОповещениеПриЗавершении.ДополнительныеПараметры.Вставить("ВыполненноеДействие", ДополнительныеПараметры.Действие);
		
	ИначеЕсли Результат = Неопределено И ДополнительныеПараметры.Действие = "УказатьВСуществующем" Тогда
		
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОписаниеОповещениеПриЗавершении, НоменклатураПоШтрихкоду);
		Возврат;
	КонецЕсли;
	
	Если ДополнительныеПараметры.Действие = "УказатьВСуществующем" Тогда
		
		Если РозничныеПродажиБГУВызовСервера.ЗаменитьШтрихкодТовара(Результат, ДополнительныеПараметры.Штрихкод) Тогда
			
			НоменклатураПоШтрихкоду.Добавить(Результат);
			ТекстСообщения = НСтр("ru = 'Штрихкод ""%1"" записан в товар ""%2""'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
				ДополнительныеПараметры.ПараметрыОбработки.Штрихкоды.Штрихкод,
				Результат
			);
			
			ПоказатьОповещениеПользователя(ТекстСообщения);
			
			ДополнительныеПараметры.ОписаниеОповещениеПриЗавершении.ДополнительныеПараметры.Вставить("ВыполненноеДействие", ДополнительныеПараметры.Действие);
			
		КонецЕсли;
		
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОписаниеОповещениеПриЗавершении, НоменклатураПоШтрихкоду);
	
КонецПроцедуры

Процедура ПоказатьВводШтрихкодаЗавершение(Штрихкод, ДополнительныеПараметры) Экспорт
	
	ОповещениеУспешногоВвода = ДополнительныеПараметры.ОповещениеУспешногоВвода;
	Количество = ДополнительныеПараметры.Количество;
	
	Если (Штрихкод <> Неопределено) Тогда
		Если Не ПустаяСтрока(Штрихкод) Тогда
			Если Количество = Неопределено Тогда
				Количество = 1;
			КонецЕсли;
			ВыполнитьОбработкуОповещения(
				ОповещениеУспешногоВвода,
				РозничныеПродажиБГУКлиентСервер.СтруктураДанныхШтрихкода(Штрихкод, Количество));
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#Область ПроцедурыИФункцииРМК
// Процедура открывает форму ФормаРМКУправляемаяИнформацииОбОшибке с текстом информации.
//
Процедура ВывестиИнформациюДляРМКУправляемой(ЗаголовокИнформации, 
											 ТекстИнформации = Неопределено, 
											 ОбработчикОповещения = Неопределено, 
											 ВладелецФормы = Неопределено,
											 Подсказка = Неопределено) Экспорт
	
	ПараметрыИнформации = ПодключаемоеОборудованиеБГУКлиентСервер.ПолучитьСтруктуруВыводимойВРМКИнформации();
	ПараметрыИнформации.ЗаголовокИнформации = ЗаголовокИнформации;
	Если ТекстИнформации = Неопределено Тогда
		ПараметрыИнформации.ТекстИнформации = Символы.Таб;
	Иначе
		ПараметрыИнформации.ТекстИнформации = ТекстИнформации;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Подсказка) Тогда
		ПараметрыИнформации.ПоказатьПодсказку = Истина;
		ПараметрыИнформации.Подсказка = Подсказка;
	КонецЕсли;
	
	ОткрытьФормуИнформацииДляРМКУправляемой(ПараметрыИнформации, ОбработчикОповещения, ВладелецФормы);
	
КонецПроцедуры

// Открывает форму ФормаРМКУправляемаяИнформацииОбОшибке в модальном режиме из РМК (управляемый режим).
//
Функция ОткрытьФормуИнформацииДляРМКУправляемой(ПараметрыИнформации, 
												ОбработчикОповещения = Неопределено,
												ВладелецФормы = Неопределено) Экспорт
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗаголовокИнформации", ПараметрыИнформации.ЗаголовокИнформации);
	
	Если ПараметрыИнформации.Свойство("ТекстИнформации") Тогда
		ПараметрыФормы.Вставить("ТекстИнформации", ПараметрыИнформации.ТекстИнформации);
	КонецЕсли;
	
	Если ПараметрыИнформации.Свойство("ТипОтвета") И ЗначениеЗаполнено(ПараметрыИнформации.ТипОтвета) Тогда
		ПараметрыФормы.Вставить("ТипОтвета", ПараметрыИнформации.ТипОтвета);
	КонецЕсли;
	
	Если ПараметрыИнформации.Свойство("ОтветПоУмолчанию") И ЗначениеЗаполнено(ПараметрыИнформации.ОтветПоУмолчанию) Тогда
		ПараметрыФормы.Вставить("ОтветПоУмолчанию", ПараметрыИнформации.ОтветПоУмолчанию);
	КонецЕсли;
	
	Если ПараметрыИнформации.Свойство("ПоказатьПодсказку") И ПараметрыИнформации.ПоказатьПодсказку Тогда
		ПараметрыФормы.Вставить("Подсказка", ПараметрыИнформации.Подсказка);
	КонецЕсли;
	
	Если ВладелецФормы = Неопределено Тогда
		Режим = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
		ОткрытьФорму("ОбщаяФорма.ФормаРМКУправляемаяИнформацииОбОшибке", ПараметрыФормы,,,,, ОбработчикОповещения, Режим); 
	Иначе
		Режим = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
		ОткрытьФорму("ОбщаяФорма.ФормаРМКУправляемаяИнформацииОбОшибке", ПараметрыФормы, ВладелецФормы,,,, ОбработчикОповещения, Режим); 
	КонецЕсли;
	
КонецФункции

// Открывает форму ФормаРМКУправляемаяИнформацииОбОшибке с текстом вопроса.
//
Функция ВывестиВопросДляРМКУправляемой(ЗаголовокИнформации, 
									   ТекстИнформации = Неопределено, 
									   ОтветПоУмолчанию = "Нет", 
									   ОбработчикОповещения = Неопределено,
									   ВладелецФормы = Неопределено) Экспорт

	ПараметрыИнформации = РозничныеПродажиБГУКлиентСервер.ВыводимаяВРМКИнформация();
	ПараметрыИнформации.ЗаголовокИнформации = ЗаголовокИнформации;
	Если ТекстИнформации = Неопределено Тогда
		ПараметрыИнформации.ТекстИнформации = Символы.Таб;
	Иначе
		ПараметрыИнформации.ТекстИнформации = ТекстИнформации;
	КонецЕсли;
	ПараметрыИнформации.ТипОтвета           = "Вопрос";
	ПараметрыИнформации.ОтветПоУмолчанию    = ОтветПоУмолчанию;
	
	РозничныеПродажиБГУКлиент.ОткрытьФормуИнформацииДляРМКУправляемой(ПараметрыИнформации, ОбработчикОповещения, ВладелецФормы);
	
КонецФункции

// Обновляет табло в РМК, учитывая текущую операцию и прочие параметры.
//
// Параметры:
//  Объект - ДанныеФормыСтруктура.
//  Элементы - ВсеЭлементыФормы.
//  СтруктураДанных - Структура.
//  НадписьИнформацияОТоваре - Строка.
//  НадписьТекущаяСумма - Строка.
//
Процедура ОбновитьТаблоНоменклатуры(Объект, Элементы, СтруктураДанных, НадписьИнформацияОТоваре, НадписьТекущаяСумма) Экспорт 
	
	ВыведеныЧеки            = СтруктураДанных.ВыведеныЧеки;
	ОставлятьФлагТаблоСдачи = СтруктураДанных.ОставлятьФлагТаблоСдачи;
	ВыведенаСдача           = СтруктураДанных.ВыведенаСдача;
	
	Если ВыведеныЧеки Тогда
		Возврат;
	КонецЕсли;
	
	ОбновитьТекстПроСкидку(Элементы);
	
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Если Объект.Товары.Количество() > 0 Тогда
			Элементы.Товары.ТекущаяСтрока = Объект.Товары[Объект.Товары.Количество() - 1].ПолучитьИдентификатор();
			ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
		КонецЕсли;
	КонецЕсли;
	
	Если ТекущаяСтрока = Неопределено Тогда
		НадписьИнформацияОТоваре = "";
		НадписьТекущаяСумма = "";
		
		Возврат;
	КонецЕсли;
	
	Если ОставлятьФлагТаблоСдачи Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.СтраницыИнформации.ТекущаяСтраница = Элементы.СтраницаИнформации;
	
	ВыведенаСдача = Ложь;
	
	ИнформацияОТоваре = СокрЛП(ТекущаяСтрока.Номенклатура);
	Если ЗначениеЗаполнено(ТекущаяСтрока.ПредставлениеТабло) Тогда
		ИнформацияОТоваре = СокрЛП(ТекущаяСтрока.ПредставлениеТабло);
	КонецЕсли;
	
	НадписьИнформацияОТоваре = ИнформацияОТоваре;
	
	ИспользуемоеКоличество = ТекущаяСтрока.Количество;
	УпаковкаСтроки = СокрЛП(ТекущаяСтрока.ЕдиницаИзмерения);
		
	СуммаСтрокиТовара = ТекущаяСтрока.Цена * ИспользуемоеКоличество;
	
	НадписьТекущаяСумма = "";
	Если НЕ СуммаСтрокиТовара = 0 Тогда
		
		ПредставлениеТекущейСтроки = "%1 х %2 %3 = %4";
		
		ЦенаСтроки = РозничныеПродажиБГУКлиентСервер.ФорматСумм(ТекущаяСтрока.Цена);
		КоличествоСтроки = Формат(ИспользуемоеКоличество, "ЧН=0");
		
		СкидкаСтроки = "";
		Скидка = СуммаСтрокиТовара - ТекущаяСтрока.Сумма;
		
		Если (Скидка > 0.01 ИЛИ Скидка < -0.01) Тогда
			
			ПредставлениеТекущейСтроки = "%1 х %2 %3 %5 = %4";
			
			СкидкаСтроки = "%1 %2 (%1 %3)";
			Если Скидка > 0 Тогда
				ЗнакСкидки = "-";
				ОбщийПроцентСкидкиСтрокой = Формат(Окр(100*Скидка/СуммаСтрокиТовара, 2, 1), "ЧДЦ=2") + "%";
				СуммаСкидкиСтрокой = РозничныеПродажиБГУКлиентСервер.ФорматСумм(Скидка);
			Иначе
				ЗнакСкидки = "+";
				ОбщийПроцентСкидкиСтрокой = Формат(-1*Окр(100*Скидка/СуммаСтрокиТовара, 2, 1), "ЧДЦ=2") + "%";
				СуммаСкидкиСтрокой = РозничныеПродажиБГУКлиентСервер.ФорматСумм(-1*Скидка);
			КонецЕсли;
			
			СкидкаСтроки = СтрШаблон(СкидкаСтроки, ЗнакСкидки, СуммаСкидкиСтрокой, ОбщийПроцентСкидкиСтрокой);
			
			НадписьТекущаяСумма = СтрШаблон(ПредставлениеТекущейСтроки,
				ЦенаСтроки, КоличествоСтроки, УпаковкаСтроки, РозничныеПродажиБГУКлиентСервер.ФорматСумм(ТекущаяСтрока.Сумма), СкидкаСтроки);
		Иначе
			
			НадписьТекущаяСумма = СтрШаблон(ПредставлениеТекущейСтроки,
				ЦенаСтроки, КоличествоСтроки, УпаковкаСтроки, РозничныеПродажиБГУКлиентСервер.ФорматСумм(ТекущаяСтрока.Сумма));
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Обновляет цвет и текст для текущей скидки.
//
// Параметры:
//  ДисконтнаяКарта - СправочникСсылка.ИнформационныеКарты.
//  ВладелецДисконтнойКарты - СправочникСсылка.Контрагенты, СправочникСсылка.Пользователи, СправочникСсылка.ФизическиеЛица.
//  Элементы - ВсеЭлементыФормы.
//
Процедура ОбновитьТекстПроСкидку(Элементы) Экспорт 
	
	ЦветТекстаЗаголовка = Новый Цвет();
	ВладелецСкидки = "";
	ЗаголовокСкидки = НСтр("ru = 'Скидка'");
	
	Элементы.СуммаСкидки.Заголовок = ЗаголовокСкидки;
	Элементы.СуммаСкидки.ЦветТекстаЗаголовка = ЦветТекстаЗаголовка;
	
КонецПроцедуры

// Устанавливает заголовок в РМК, учитывая текущую операцию и прочие параметры.
//
// Параметры:
//  СтруктураДанных - Структура.
//  Элементы - ВсеЭлементыФормы.
//  НадписьЗаголовок - Строка.
//
Процедура УстановитьЗаголовокВРМК(СтруктураДанных, Элементы, НадписьЗаголовок) Экспорт 
	
	ВидОперации                  = СтруктураДанных.ВидОперации;
	ОперацияСДенежнымиСредствами = СтруктураДанных.ОперацияСДенежнымиСредствами;
	ЦветПродажи                  = СтруктураДанных.ЦветПродажи;
	
	СтрокаЗаголовок = "";
	
	Если ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийЧекККМ.Возврат") Тогда
		Если ОперацияСДенежнымиСредствами Тогда
			СтрокаЗаголовок = НСтр("ru = 'Возврат денежных средств без передачи товаров'");
		Иначе
			СтрокаЗаголовок = НСтр("ru = 'Возврат'") 
		КонецЕсли;
		ЗаголовокЧ004Возврат = НСтр("ru = 'Продажа (F5)'");
		Элементы.КартинкаЧО04Возврат.Заголовок = ЗаголовокЧ004Возврат;
		Элементы.КартинкаЧО04Возврат.ТекстНевыбраннойКартинки = ЗаголовокЧ004Возврат;
		Элементы.КартинкаЧО04Возврат.ЦветТекста = WebЦвета.Красный;
		
		ЗаголовокЧ009ДС = НСтр("ru = 'Без передачи товаров (Shift + F10)'");
		Элементы.КартинкаЧО09ОперацияДС.Заголовок = ЗаголовокЧ009ДС;
		Элементы.КартинкаЧО09ОперацияДС.ТекстНевыбраннойКартинки = ЗаголовокЧ009ДС;
	Иначе
		Если ОперацияСДенежнымиСредствами Тогда
			СтрокаЗаголовок = НСтр("ru = 'Прием денежных средств без передачи товаров'");
		Иначе
			СтрокаЗаголовок = НСтр("ru = 'Продажа'");
		КонецЕсли;
		ЗаголовокЧ004Возврат = НСтр("ru = 'Возврат (F5)'");
		Элементы.КартинкаЧО04Возврат.Заголовок = ЗаголовокЧ004Возврат;
		Элементы.КартинкаЧО04Возврат.ТекстНевыбраннойКартинки = ЗаголовокЧ004Возврат;
		Элементы.КартинкаЧО04Возврат.ЦветТекста = ЦветПродажи;
		
		ЗаголовокЧ009ДС = НСтр("ru = 'Без передачи товаров (Shift + F10)'");
		Элементы.КартинкаЧО09ОперацияДС.Заголовок = ЗаголовокЧ009ДС;
		Элементы.КартинкаЧО09ОперацияДС.ТекстНевыбраннойКартинки = ЗаголовокЧ009ДС;
	КонецЕсли;
	
	Если ОперацияСДенежнымиСредствами Тогда
		Элементы.КартинкаЧО09ОперацияДС.ЦветТекста = WebЦвета.Синий;
	Иначе
		Элементы.КартинкаЧО09ОперацияДС.ЦветТекста = ЦветПродажи;
	КонецЕсли;
	
	//Если Пользователь = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Пользователь) Тогда
	//	Элементы.НадписьЗаголовок.ЦветТекста = WebЦвета.Зеленый;
	//Иначе
	//	СтрокаЗаголовок = "" + Пользователь + " - " + СтрокаЗаголовок;
	//	Элементы.НадписьЗаголовок.ЦветТекста = WebЦвета.Красный;
	//КонецЕсли;
			
	НадписьЗаголовок = СтрокаЗаголовок;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти
