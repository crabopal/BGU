Процедура ПриОпределенииНастроекПодключения(Настройки) Экспорт
	
	Настройки.c2b.ОбъектМетаданных = Метаданные.РегистрыСведений.НастройкиИнтеграцииСПлатежнымиСистемами;
	
КонецПроцедуры

Процедура ПриЗаписиНастроекПодключения(ПараметрыОплаты, Отказ, СообщениеОбОшибке) Экспорт
	
	НачатьТранзакцию();
	
	Попытка
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.НастройкиИнтеграцииСПлатежнымиСистемами");
		ЭлементБлокировки.УстановитьЗначение("Организация"					, ПараметрыОплаты.c2b.Получить("Организация")); 
		ЭлементБлокировки.УстановитьЗначение("ПараметрыДоговораЭквайринга"	, ПараметрыОплаты.c2b.Получить("ПараметрыДоговораЭквайринга"));
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		
		Если ЗначениеЗаполнено(ПараметрыОплаты.c2b.Получить("ТорговаяТочка")) Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ
			|	НастройкиИнтеграцииСПлатежнымиСистемами.Организация КАК Организация,
			|	НастройкиИнтеграцииСПлатежнымиСистемами.ПараметрыДоговораЭквайринга КАК ПараметрыДоговораЭквайринга
			|ИЗ
			|	РегистрСведений.НастройкиИнтеграцииСПлатежнымиСистемами КАК НастройкиИнтеграцииСПлатежнымиСистемами
			|ГДЕ
			|	НастройкиИнтеграцииСПлатежнымиСистемами.ТорговаяТочка = &ТорговаяТочка";
			
			Запрос.УстановитьПараметр("ТорговаяТочка", ПараметрыОплаты.c2b.Получить("ТорговаяТочка"));
			
			РезультатЗапроса = Запрос.Выполнить();
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				Набор = РегистрыСведений.НастройкиИнтеграцииСПлатежнымиСистемами.СоздатьНаборЗаписей();
				Набор.Отбор.Организация.Установить(ВыборкаДетальныеЗаписи.Организация);
				Набор.Отбор.ПараметрыДоговораЭквайринга.Установить(ВыборкаДетальныеЗаписи.ПараметрыДоговораЭквайринга);
				Набор.Записать();
			КонецЦикла;
			
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ИСТИНА КАК Поле
		|ИЗ
		|	РегистрСведений.НастройкиИнтеграцииСПлатежнымиСистемами КАК НастройкиИнтеграцииСПлатежнымиСистемами
		|ГДЕ
		|	НастройкиИнтеграцииСПлатежнымиСистемами.Организация = &Организация
		|	И НастройкиИнтеграцииСПлатежнымиСистемами.ТорговаяТочка <> &ТорговаяТочка
		|	И НастройкиИнтеграцииСПлатежнымиСистемами.ПараметрыДоговораЭквайринга = &ПараметрыДоговораЭквайринга";
		
		Запрос.УстановитьПараметр("Организация"					, ПараметрыОплаты.c2b.Получить("Организация")); 
		Запрос.УстановитьПараметр("ПараметрыДоговораЭквайринга"	, ПараметрыОплаты.c2b.Получить("ПараметрыДоговораЭквайринга"));
		Запрос.УстановитьПараметр("ТорговаяТочка"				, ПараметрыОплаты.c2b.Получить("ТорговаяТочка"));
		
		РезультатЗапроса = Запрос.Выполнить();
		Если Не РезультатЗапроса.Пустой() Тогда
			Отказ             = Истина;
			СообщениеОбОшибке = НСтр("ru = 'Для организации уже задана настройка интеграции.'");
			ОтменитьТранзакцию();
			Возврат;
		КонецЕсли;
		
		Запись = РегистрыСведений.НастройкиИнтеграцииСПлатежнымиСистемами.СоздатьМенеджерЗаписи();
		Запись.ТорговаяТочка 				= ПараметрыОплаты.c2b.Получить("ТорговаяТочка");
		Запись.ПараметрыДоговораЭквайринга 	= ПараметрыОплаты.c2b.Получить("ПараметрыДоговораЭквайринга");
		Запись.Организация   				= ПараметрыОплаты.c2b.Получить("Организация");
		
		Запись.Записать();
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации(
			НСтр("ru = 'Настройка интеграции с платежными системами'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.РегистрыСведений.НастройкиИнтеграцииСПлатежнымиСистемами,
			,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Отказ = Истина;
		СообщениеОбОшибке = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область ПрикладныеОперации

Процедура ПриФормированииЗаказаНаОплатуСБП(ДокументОплаты, ЗаказНаОплату, НастройкаПодключения, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(ДокументОплаты) Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(ДокументОплаты) <> Тип("ДокументСсылка.СчетНаОплату") И ТипЗнч(ДокументОплаты) <> Тип("ДокументСсылка.ЧекККМ") Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОплаты, "СуммаДокумента, Дата");
	ЗаказНаОплату.СуммаОплаты 					= ДанныеДокумента.СуммаДокумента;
	ЗаказНаОплату.ДатаОплаты  					= ДанныеДокумента.Дата;
	ЗаказНаОплату.НазначениеПлатежа 			= "";
	ЗаказНаОплату.ОтложенноеПолучениеСтатуса 	= Ложь;
	
КонецПроцедуры

Процедура ПриФормированииЗаказаНаВозвратСБП(ДокументВозврата, ЗаказНаВозврат, НастройкаПодключения, ДополнительныеПараметры) Экспорт 

	Если Не ЗначениеЗаполнено(ДокументВозврата) Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(ДокументВозврата) <> Тип("ДокументСсылка.ЧекККМНаВозврат") Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументВозврата,"СуммаДокумента, Дата");
    ЗаказНаВозврат.ДатаВозврата  = РеквизитыДокумента.Дата;
    ЗаказНаВозврат.СуммаВозврата = РеквизитыДокумента.СуммаДокумента;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция НастройкиИнтеграцииСБП(Организация, ПараметрыДоговораЭквайринга) Экспорт
	
	Настройки = Новый Структура("ИнтеграцияДоступна, Настройка");
	Настройки.ИнтеграцияДоступна = Ложь;
	
	Если (Не ЗначениеЗаполнено(Организация)) Или (Не ЗначениеЗаполнено(ПараметрыДоговораЭквайринга)) Тогда
		Возврат Настройки;
	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	НастройкиИнтеграцииСПлатежнымиСистемами.ТорговаяТочка КАК ТорговаяТочка
	               |ИЗ
	               |	РегистрСведений.НастройкиИнтеграцииСПлатежнымиСистемами КАК НастройкиИнтеграцииСПлатежнымиСистемами
	               |ГДЕ
	               |	НастройкиИнтеграцииСПлатежнымиСистемами.Организация = &Организация
	               |	И НастройкиИнтеграцииСПлатежнымиСистемами.ПараметрыДоговораЭквайринга = &ПараметрыДоговораЭквайринга"; 
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Организация"					, Организация);
	Запрос.УстановитьПараметр("ПараметрыДоговораЭквайринга"	, ПараметрыДоговораЭквайринга);
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	Если РезультатЗапроса.Следующий() Тогда
		Настройки.ИнтеграцияДоступна 	= Истина;
		Настройки.Настройка 			= РезультатЗапроса.ТорговаяТочка;
	КонецЕсли;	
	
	Возврат Настройки;
	
КонецФункции

#Область ПрикладныеОперации

Функция ИдентификаторОплатыВПлатежнойСистемеСБП(ПараметрыПроцедуры) Экспорт
	
	ЗаказНаОплату = Новый Структура("СуммаОплаты, ДатаОплаты, СрокЖизниQRКода, ОтложенноеПолучениеСтатуса, НазначениеПлатежа");
	ПереводыСБПc2bПереопределяемый.ПриФормированииЗаказаНаОплатуСБП(ПараметрыПроцедуры.ДокументОплаты, ЗаказНаОплату, ПараметрыПроцедуры.НастройкаИнтеграции, Неопределено);
	РезультатОперации = ПереводыСБПc2b.ДинамическаяСсылка(ПараметрыПроцедуры.ДокументОплаты, ПараметрыПроцедуры.НастройкаИнтеграции);
	Возврат РезультатОперации;
	
КонецФункции

Функция СоздатьЭквайринговуюОперациюПриЗагрузкеИзСБП(Операция) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);    
	
	ДанныеЗаполнения = Новый Структура;
	ДанныеЗаполнения.Вставить("Дата"						, Операция.ДатаОплаты);
	ДанныеЗаполнения.Вставить("ВидОперации"					, Операция.ВидОперации);
	ДанныеЗаполнения.Вставить("ПараметрыДоговораЭквайринга"	, Операция.ПараметрыДоговораЭквайринга);
	ДанныеЗаполнения.Вставить("СуммаДокумента"				, Операция.СуммаДокумента);
		
	Счет = Операция.Счет;
	ДокументОплаты = Документы.ЭквайринговаяОперация.СоздатьДокумент();
	
	ДокументОплаты.Заполнить(Счет);
	ЗаполнитьЗначенияСвойств(ДокументОплаты, ДанныеЗаполнения);
	ДокументОплаты.ДокументОснование = Счет;
	ДокументОплаты.ДокументыЧекаККМ.Очистить();
	
	ПараметрыДоговораЭквайрингаРеквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОплаты.ПараметрыДоговораЭквайринга,
	"Организация, Эквайер, ДоговорЭквайринга, Подразделение, ИФО, КФО, КБКНазначениеПлатежа, КОСГУНазначениеПлатежа, ЛицевойСчет,
	|ИсточникСредств, СпособОплатыУслугЭквайера, СпособУчетаОбязательств, СчетУчетаЗатрат, КПСУчетаЗатрат, СубконтоЗатрат1,
	|СубконтоЗатрат2, СубконтоЗатрат3, СчетУчетаЗатратНУ, СубконтоЗатратНУ1, СубконтоЗатратНУ2, СубконтоЗатратНУ3, СтавкаНДС");
	ЗаполнитьЗначенияСвойств(ДокументОплаты, ПараметрыДоговораЭквайрингаРеквизиты);
	
	ДокументОплаты.ВидПервичногоДокумента = НСтр("ru='Отчет сервиса СБП'");
	ДокументОплаты.НомерПервичногоДокумента = "1";
	ДокументОплаты.ДатаПервичногоДокумента = Операция.ДатаОплаты;
	
	ДокументОплаты.ОплатаВыполнена = Истина;
	
	ДокументОплаты.ПробитЧек = Ложь;
	ДокументОплаты.ТипРасчета = Перечисления.ТипыРасчетаДенежнымиСредствами.ПриходДенежныхСредств;
	
	Счет20531 = БухгалтерскийУчет.СчетПоКоду("205.31", Операция.ДатаОплаты, ПараметрыДоговораЭквайрингаРеквизиты.Организация);
	РеквизитыТиповойОперацииЭО = Новый Структура();
	РеквизитыТиповойОперацииЭО.Вставить("СчетПоступления",			БухгалтерскийУчет.СчетПоКоду("201.23", Операция.ДатаОплаты, ПараметрыДоговораЭквайрингаРеквизиты.Организация));
	РеквизитыТиповойОперацииЭО.Вставить("СчетРасчетовСЭквайером",	БухгалтерскийУчет.СчетПоКоду("302.26", Операция.ДатаОплаты, ПараметрыДоговораЭквайрингаРеквизиты.Организация));
	РеквизитыТиповойОперацииЭО.Вставить("ПроводкиИсполненияПлана",	Истина);
	
	ДокументОплаты.СчетРасчетов = Счет20531;
	
	НовыйДокЧекаККМ = ДокументОплаты.ДокументыЧекаККМ.Добавить();
	НовыйДокЧекаККМ.ДокументОснованиеЧекаККМ = Счет;
	СуммаСчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Счет, "СуммаДокумента");
	НовыйДокЧекаККМ.ПризнакСпособаРасчета = Перечисления.ПризнакиСпособаРасчета.ПредоплатаПолная;
	
	РабочееМесто = МенеджерОборудованияВызовСервера.РабочееМестоКлиента();
	НастройкиОборудования = ЭквайрингВызовСервера.ПолучитьНастройкиОборудованияЭквайринга(РабочееМесто, ДокументОплаты.Организация);
	ДокументОплаты.ФискальныйРегистратор = НастройкиОборудования.ФР;
	ДокументОплаты.Комментарий = НСтр("ru='Оплата через СБП'");
	
	Если ПараметрыДоговораЭквайрингаРеквизиты.СпособОплатыУслугЭквайера = Перечисления.СпособыОплатыУслугЭквайринга.КомиссияУдерживаетсяПриПроведенииПлатежа Тогда 
		ДанныеВидаКартыДоговораЭквайринга = ЭквайрингВызовСервера.ПолучитьДанныеВидаКартыДоговораЭквайринга(ДокументОплаты.ПараметрыДоговораЭквайринга);
		Если ДанныеВидаКартыДоговораЭквайринга <> Неопределено Тогда 
			ПроцентТорговойУступки 	= ДанныеВидаКартыДоговораЭквайринга.ПроцентТорговойУступки;
			СуммаКомиссииБанка 		= ДокументОплаты.СуммаДокумента / 100 * ПроцентТорговойУступки;
			ДокументОплаты.ПроцентКомиссииБанка = ПроцентТорговойУступки;
			ДокументОплаты.СуммаКомиссииБанка 	= СуммаКомиссииБанка;
		КонецЕсли;	
	КонецЕсли;	
	
	Попытка
		ИдентификаторДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(ДокументОплаты));
		ТиповаяОперация = БухгалтерскиеОперацииСервер.ТиповаяОперацияПоУмолчанию(ИдентификаторДокумента);
		
		БухгалтерскиеОперацииСервер.ДобавитьДанныеДляПроведения(
		ДокументОплаты,
		ТиповаяОперация,
		РеквизитыТиповойОперацииЭО);
		
		ДокументОплаты.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru='ИнтеграцияССервисомПриемаПлатежейБГУ.СоздатьЭквайринговуюОперациюПриЗагрузкеИзСБП'",
		ОбщегоНазначения.КодОсновногоЯзыка()),
		УровеньЖурналаРегистрации.Ошибка,
		Метаданные.ОбщиеМодули.ИнтеграцияССервисомПриемаПлатежейБГУ,
		,
		НСтр("ru='Ошибка проведения документа ""Эквайринговая операция"" при загрузке операций из СБП'",
		ОбщегоНазначения.КодОсновногоЯзыка()));
		
		ДокументОплаты.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения", Истина);
		ДокументОплаты.Записать();
	КонецПопытки;
	
	Попытка
		СчетДок = Счет.ПолучитьОбъект();
		СчетДок.СчетОплачен = Истина;
		СчетДок.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru='ИнтеграцияССервисомПриемаПлатежейБГУ.СоздатьЭквайринговуюОперациюПриЗагрузкеИзСБП'",
		ОбщегоНазначения.КодОсновногоЯзыка()),
		УровеньЖурналаРегистрации.Ошибка,
		Метаданные.ОбщиеМодули.ИнтеграцияССервисомПриемаПлатежейБГУ,
		,
		НСтр("ru='Ошибка записи признака ""Счет оплачен"" документа ""Счет на оплату"" при загрузке операций из СБП'",
		ОбщегоНазначения.КодОсновногоЯзыка()));
		
		СчетДок.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения", Истина);
		СчетДок.Записать();
	КонецПопытки;
	
	УстановитьПривилегированныйРежим(Ложь);
	Возврат ДокументОплаты.Ссылка;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#КонецОбласти

