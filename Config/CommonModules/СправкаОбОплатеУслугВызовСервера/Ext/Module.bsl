

#Область СлужебныйПрограммныйИнтерфейс

Функция ДанныеПечатиУведомления(Ссылка) Экспорт
	
	ДанныеПечатиУведомления = НовыеДанныеПечатиУведомления();

	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, "Уведомление");
	Реквизиты          = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыДокумента.Уведомление, "Ссылка,ВидУведомления,Организация");
	ДанныеПечатиУведомления.УведомленияДляПечати = Реквизиты.Ссылка;
	
	СписокПечатаемыхЛистов = УведомлениеОСпецрежимахНалогообложенияВызовСервера.ПечатьУведомленияБРО(Реквизиты.Ссылка);
	Для Каждого Элт Из СписокПечатаемыхЛистов Цикл 
		ЗначениеДляМодификации = Элт.Значение;
		ТабДок = ПолучитьИзВременногоХранилища(ЗначениеДляМодификации[0]);
		УИД = Новый УникальныйИдентификатор;
		ЗначениеДляМодификации[0] = ПоместитьВоВременноеХранилище(ТабДок, УИД);
		ЗначениеДляМодификации[1] = УИД;
	КонецЦикла;
	ДанныеПечатиУведомления.Вставить("СписокПечатаемыхЛистов", СписокПечатаемыхЛистов);

	ДанныеПечатиУведомления.ДополнительныеПараметры.Вставить("ЗаголовокФормы",
		СтрШаблон("%1 (%2)", Реквизиты.ВидУведомления, Реквизиты.Организация));
		
	ДанныеПечатиУведомления.ПоследнийЦиклОбмена = ПоследнийЦиклОбмена(Реквизиты);
	
	Возврат ДанныеПечатиУведомления;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыеДанныеПечатиУведомления()
	
	Результат = Новый Структура;
	Результат.Вставить("УведомленияДляПечати");
	Результат.Вставить("СписокПечатаемыхЛистов");
	Результат.Вставить("ДополнительныеПараметры", Новый Структура);
	Результат.Вставить("ПоследнийЦиклОбмена",     Неопределено);
	
	Возврат Результат;
	
КонецФункции

Функция ПоследнийЦиклОбмена(Реквизиты)

	КонтролирующийОрган = ?(УведомлениеОСпецрежимахНалогообложенияПовтИсп.ВидыУведомленийВФНС()[Реквизиты.ВидУведомления] = Истина,
		Перечисления.ТипыКонтролирующихОрганов.ФНС, Неопределено);
		
	СтатусОтправки 			 = Неопределено;
	СостояниеСдачиОтчетности = Неопределено;
	ТекущееСостояние 		 = Неопределено;
	ЦиклОбмена 				 = Неопределено;
	ПоследнийЦиклОбмена 	 = Неопределено;
	
	ЭлектронныйДокументооборотСКонтролирующимиОрганами.ОпределитьСтатусИСостояниеСдачиОтчетности(
		Реквизиты.Ссылка, Реквизиты.Организация, КонтролирующийОрган, СостояниеСдачиОтчетности, СтатусОтправки);
	СтатусОтправкиВЖурнале = УведомлениеОСпецрежимахНалогообложения.СохраненныйСтатусОтправкиУведомления(Реквизиты);
	
	МожноПечататьСЭЦП = СтрНачинаетсяС(СтатусОтправки, "Сдано")
		И СостояниеСдачиОтчетности = Перечисления.СостояниеСдачиОтчетности.ПоложительныйРезультатДокументооборота
		И СтрНайти(СтатусОтправки, СтатусОтправкиВЖурнале) = 1;
		
	Если МожноПечататьСЭЦП Тогда 
		ТекущееСостояние = РегламентированнаяОтчетность.ТекущееСостояниеОтправки(Реквизиты.Ссылка, КонтролирующийОрган);
		ЦиклОбмена = ДокументооборотСКОВызовСервера.ПолучитьПоследнийЦиклОбмена(Реквизиты.Ссылка);
	КонецЕсли;
	
	Если ТекущееСостояние <> Неопределено И ЗначениеЗаполнено(ЦиклОбмена) Тогда
		ПоследнийЦиклОбмена = ЦиклОбмена;
	КонецЕсли;
	
	Возврат ПоследнийЦиклОбмена;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТекстЗапросаСвязиСправкиИУведомления() Экспорт 
	Возврат "ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЖурналСправокОбОплатеУслуг.Ссылка КАК Ссылка,
	|	ЖурналСправокОбОплатеУслуг.Уведомление КАК Уведомление,
	|	УведомлениеОСпецрежимахНалогообложения.ИмяОтчета КАК ИмяОтчета,
	|	УведомлениеОСпецрежимахНалогообложения.ИмяФормы КАК ИмяФормы,
	|	УведомлениеОСпецрежимахНалогообложения.ВидУведомления КАК ВидУведомления,
	|	УведомлениеОСпецрежимахНалогообложения.Организация КАК Организация,
	|	СправкаОбОплатеУслугДляНалоговогоВычета.УИДСправкиВЖурнале КАК УИД
	|ИЗ
	|	Документ.ЖурналСправокОбОплатеУслуг.Справки КАК ЖурналСправокОбОплатеУслугСправки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЖурналСправокОбОплатеУслуг КАК ЖурналСправокОбОплатеУслуг
	|			ЛЕВОЕ СОЕДИНЕНИЕ Документ.УведомлениеОСпецрежимахНалогообложения КАК УведомлениеОСпецрежимахНалогообложения
	|			ПО ЖурналСправокОбОплатеУслуг.Уведомление = УведомлениеОСпецрежимахНалогообложения.Ссылка
	|		ПО ЖурналСправокОбОплатеУслугСправки.Ссылка = ЖурналСправокОбОплатеУслуг.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СправкаОбОплатеУслугДляНалоговогоВычета КАК СправкаОбОплатеУслугДляНалоговогоВычета
	|		ПО ЖурналСправокОбОплатеУслугСправки.СправкаОбОплатеУслуг = СправкаОбОплатеУслугДляНалоговогоВычета.Ссылка
	|ГДЕ
	|	ЖурналСправокОбОплатеУслугСправки.СправкаОбОплатеУслуг = &СправкаОбОплатеУслуг
	|	И ЖурналСправокОбОплатеУслуг.Проведен";
КонецФункции

Функция ПечатьСправкиБРО(СправкаДляПечати) Экспорт
	Запрос = Новый Запрос(ТекстЗапросаСвязиСправкиИУведомления());
	Запрос.УстановитьПараметр("СправкаОбОплатеУслуг", СправкаДляПечати);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		СписокПечатаемыхЛистов = Отчеты[Выборка.ИмяОтчета].СформироватьСправку(Выборка.Уведомление.ПолучитьОбъект(), Выборка.УИД);
		УведомлениеОСпецрежимахНалогообложения.ПроставлениеКоличестваСтраниц(СписокПечатаемыхЛистов);
		Результат = Новый Структура;
		Результат.Вставить("СписокПечатаемыхЛистов", СписокПечатаемыхЛистов);
		Результат.Вставить("ДополнительныеПараметры", Новый Структура("ЗаголовокФормы", Строка(Выборка.ВидУведомления) + " " + Выборка.Организация));
		Результат.Вставить("ДанныеПечатиУведомления", ДанныеПечатиУведомления(Выборка.Ссылка));
		Возврат Результат;
	КонецЕсли;
КонецФункции

Функция ПечатьЖурналаБРО(ЖурналСправок) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	УведомлениеОСпецрежимахНалогообложения.Ссылка КАК Ссылка,
	|	УведомлениеОСпецрежимахНалогообложения.Организация КАК Организация,
	|	УведомлениеОСпецрежимахНалогообложения.ВидУведомления КАК ВидУведомления,
	|	УведомлениеОСпецрежимахНалогообложения.ИмяОтчета КАК ИмяОтчета
	|ИЗ
	|	Документ.ЖурналСправокОбОплатеУслуг КАК ЖурналСправокОбОплатеУслуг
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УведомлениеОСпецрежимахНалогообложения КАК УведомлениеОСпецрежимахНалогообложения
	|		ПО ЖурналСправокОбОплатеУслуг.Уведомление = УведомлениеОСпецрежимахНалогообложения.Ссылка
	|ГДЕ
	|	ЖурналСправокОбОплатеУслуг.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ЖурналСправок);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		СписокПечатаемыхЛистов = Отчеты[Выборка.ИмяОтчета].СформироватьСписокЛистов(Выборка.Ссылка);
		УведомлениеОСпецрежимахНалогообложения.ПроставлениеКоличестваСтраниц(СписокПечатаемыхЛистов);
		Результат = Новый Структура;
		Результат.Вставить("СписокПечатаемыхЛистов", СписокПечатаемыхЛистов);
		Результат.Вставить("ДополнительныеПараметры", Новый Структура("ЗаголовокФормы", Строка(Выборка.ВидУведомления) + " " + Выборка.Организация));
		Возврат Результат;
	КонецЕсли;
КонецФункции

#КонецОбласти