// Остатки

// Возвращает таблицу с остатками расходов УСН
//
Функция ОстаткиРасходовУСН(Период, СчетаРасходов, ОтборРасходов, Реквизиты) Экспорт
	
	// Блокируем регистр бухгалтерии для получения остатков.
	УстанавливатьБлокировку = ?(Реквизиты.Свойство("ТиповаяОперация"), Реквизиты.ТиповаяОперация.УстанавливатьБлокировку, Ложь);
	Если УстанавливатьБлокировку Тогда
		
	//	Блокировка = Новый БлокировкаДанных;
	//	
	//	Блокировка.Заблокировать();
		
	КонецЕсли;
	
	// Получаем остатки
	
	Запрос = Новый Запрос;
	
	УсловияОтбораРасходовПоРеквизитам = "";
	УсловияОтбораРасходовПоОстаткам = "";
	ЕстьОтборРасходов = (ЗначениеЗаполнено(ОтборРасходов) И ОтборРасходов.Количество() > 0);
	Если ЕстьОтборРасходов Тогда
		
		РеквизитыСправочникаРасходыУСН = "ВидРасхода,ЭлементРасхода,Партия,ИмяСпискаДокумента,НомерСтрокиДокумента,
			|ОтражениеВУСН,СчетРасчетов,Контрагент,Договор,ДокументРасчетов";
		
		Для Каждого ЭлементОтбора Из ОтборРасходов Цикл
			
			Запрос.УстановитьПараметр(ЭлементОтбора.Ключ, ЭлементОтбора.Значение);
			Если Найти(РеквизитыСправочникаРасходыУСН, ЭлементОтбора.Ключ) > 0 Тогда
				УсловияОтбораРасходовПоРеквизитам = УсловияОтбораРасходовПоРеквизитам
					+ ?(ПустаяСтрока(УсловияОтбораРасходовПоРеквизитам), "", " И ")
					+ "РасходыУСН." + ЭлементОтбора.Ключ + " В (&" + ЭлементОтбора.Ключ + ")";
			Иначе
				УсловияОтбораРасходовПоОстаткам = УсловияОтбораРасходовПоОстаткам
					+ ?(ПустаяСтрока(УсловияОтбораРасходовПоОстаткам), "", " И ")
					+ "ОстаткиРасходовУСН." + ЭлементОтбора.Ключ + " В (&" + ЭлементОтбора.Ключ + ")";
			КонецЕсли;
			
		КонецЦикла;
		
		Если НЕ ПустаяСтрока(УсловияОтбораРасходовПоРеквизитам) Тогда
			
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	РасходыУСН.Ссылка КАК РасходУСН
			|ПОМЕСТИТЬ ОтборРасходовУСН
			|ИЗ
			|	Справочник.РасходыУСН КАК РасходыУСН
			|ГДЕ
			|	РасходыУСН.Организация = &Организация
			|	И &УсловияОтбораРасходовПоРеквизитам
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	РасходУСН";
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловияОтбораРасходовПоРеквизитам",
				УсловияОтбораРасходовПоРеквизитам);
			Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета();
			
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст +
	"ВЫБРАТЬ
	|	Остатки.Организация КАК Организация,
	|	ЕСТЬNULL(Остатки.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
	|	Остатки.КФО КАК КФО,
	|	ЕСТЬNULL(Остатки.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) КАК КПС,
	|	ЕСТЬNULL(Остатки.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК Подразделение,
	|	Остатки.Счет КАК СчетУчетаУСН,
	|	ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.РасходыУСН) КАК РасходыУСН,
	|	Остатки.Субконто1 КАК СубконтоРасходов2,
	|	Остатки.Субконто3 КАК СубконтоРасходов3,
	|	ВЫБОР
	|		КОГДА &ИспользоватьВалютныйУчет
	|				И Остатки.Счет.Валютный
	|			ТОГДА Остатки.Валюта
	|		ИНАЧЕ &ВалютаРеглУчета
	|	КОНЕЦ КАК Валюта,
	|	ВЫБОР
	|		КОГДА Остатки.Счет.Количественный
	|			ТОГДА Остатки.КоличествоОстаток
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Количество,
	|	ВЫБОР
	|		КОГДА &ИспользоватьВалютныйУчет
	|				И Остатки.Счет.Валютный
	|			ТОГДА Остатки.ВалютнаяСуммаОстаток
	|		ИНАЧЕ Остатки.СуммаОстаток + Остатки.СуммаНеУчитываетсяНУОстаток + Остатки.СуммаЕНВДОстаток + Остатки.СуммаНДСОстаток
	|	КОНЕЦ КАК СуммаВал,
	|	Остатки.СуммаОстаток КАК СуммаРуб,
	|	ВЫБОР
	|		КОГДА Остатки.Счет.НалоговыйУчетНеУчитываемых
	|			ТОГДА Остатки.СуммаНеУчитываетсяНУОстаток
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаНеУчитываетсяНУРуб,
	|	ВЫБОР
	|		КОГДА &ПлательщикЕНВД
	|				И Остатки.Счет.НалоговыйУчетЕНВД
	|			ТОГДА Остатки.СуммаЕНВДОстаток
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаЕНВДРуб,
	|	ВЫБОР
	|		КОГДА Остатки.Счет.НалоговыйУчетНДС
	|			ТОГДА Остатки.СуммаНДСОстаток
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаНДСРуб
	|ПОМЕСТИТЬ ОстаткиРасходовУСН
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В (&СчетаРасходовУСН),
	|			,
	|			Организация = &Организация
	|				И КФО В (&КФО)
	|				И &УсловиеИФО
	|				И &УсловиеОтбораРасходовУСН) КАК Остатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстаткиРасходовУСН.Организация КАК Организация,
	|	ОстаткиРасходовУСН.ИФО КАК ИФО,
	|	ОстаткиРасходовУСН.КФО КАК КФО,
	|	ОстаткиРасходовУСН.КПС КАК КПС,
	|	ОстаткиРасходовУСН.Подразделение КАК Подразделение,
	|	ОстаткиРасходовУСН.СчетУчетаУСН КАК СчетУчетаУСН,
	|	ОстаткиРасходовУСН.РасходыУСН.ВидРасхода КАК ВидРасхода,
	|	ОстаткиРасходовУСН.РасходыУСН.ЭлементРасхода КАК ЭлементРасхода,
	|	ОстаткиРасходовУСН.РасходыУСН.Партия КАК Партия,
	|	ОстаткиРасходовУСН.РасходыУСН.ИмяСпискаДокумента КАК ИмяСпискаДокумента,
	|	ОстаткиРасходовУСН.РасходыУСН.НомерСтрокиДокумента КАК НомерСтрокиДокумента,
	|	ОстаткиРасходовУСН.РасходыУСН.ОтражениеВУСН КАК ОтражениеВУСН,
	|	ОстаткиРасходовУСН.РасходыУСН.СчетРасчетов КАК СчетРасчетов,
	|	ОстаткиРасходовУСН.РасходыУСН.Контрагент КАК Контрагент,
	|	ОстаткиРасходовУСН.РасходыУСН.Договор КАК Договор,
	|	ОстаткиРасходовУСН.РасходыУСН.ДокументРасчетов КАК ДокументРасчетов,
	|	ОстаткиРасходовУСН.РасходыУСН КАК РасходыУСН,
	|	ОстаткиРасходовУСН.СубконтоРасходов2,
	|	ОстаткиРасходовУСН.СубконтоРасходов3,
	|	ОстаткиРасходовУСН.Валюта,
	|	ОстаткиРасходовУСН.Количество,
	|	ОстаткиРасходовУСН.СуммаВал,
	|	ОстаткиРасходовУСН.СуммаРуб,
	|	ОстаткиРасходовУСН.СуммаНеУчитываетсяНУРуб,
	|	ОстаткиРасходовУСН.СуммаЕНВДРуб,
	|	ОстаткиРасходовУСН.СуммаНДСРуб
	|ИЗ
	|	ОстаткиРасходовУСН КАК ОстаткиРасходовУСН
	|ГДЕ
	|	&УсловияОтбораРасходовПоОстаткам";
	
	Запрос.УстановитьПараметр("Период",      Период);
	Запрос.УстановитьПараметр("Организация", Реквизиты.Организация);
	
	Запрос.УстановитьПараметр("СчетаРасходовУСН", СчетаРасходов);
	
	Если ЕстьОтборРасходов Тогда
		
		Если ПустаяСтрока(УсловияОтбораРасходовПоРеквизитам) Тогда
			Запрос.УстановитьПараметр("УсловиеОтбораРасходовУСН", Истина);
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОтбораРасходовУСН",
				"Субконто2 В (ВЫБРАТЬ ОтборРасходовУСН.РасходУСН ИЗ ОтборРасходовУСН)");
		КонецЕсли;
		
		Если ПустаяСтрока(УсловияОтбораРасходовПоОстаткам) Тогда
			Запрос.УстановитьПараметр("УсловияОтбораРасходовПоОстаткам", Истина);
		Иначе
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловияОтбораРасходовПоОстаткам",
				УсловияОтбораРасходовПоОстаткам);
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("КФО", УчетУСНКлиентСервер.МассивКФОдляНалоговогоУчетаУСН());
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ПоВсемИФО = Реквизиты.Свойство("ПоВсемИФО") И Реквизиты.ПоВсемИФО;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО",
		?(ИспользоватьУчетПоИФО И НЕ ПоВсемИФО, "ИФО В (&ИФО)", "ИСТИНА") );
	
	Запрос.УстановитьПараметр("ИспользоватьВалютныйУчет", ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	Запрос.УстановитьПараметр("ВалютаРеглУчета", БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета());
	
	УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Реквизиты.Организация, Реквизиты.Дата);
	Запрос.УстановитьПараметр("ПлательщикЕНВД", УчетнаяПолитика.ПлательщикЕНВД);
	
	ОстаткиРасходов = Запрос.Выполнить().Выгрузить();
	
	Возврат ОстаткиРасходов;
	
КонецФункции

// Возвращает таблицу с остатками прочих расчетов УСН
//
Функция ОстаткиПрочихРасчетовУСН(Период, СчетаРасчетов, ОтборРасчетов, Реквизиты) Экспорт
	
	// Блокируем регистр бухгалтерии для получения остатков.
	УстанавливатьБлокировку = ?(Реквизиты.Свойство("ТиповаяОперация"), Реквизиты.ТиповаяОперация.УстанавливатьБлокировку, Ложь);
	Если УстанавливатьБлокировку Тогда
		
	//	Блокировка = Новый БлокировкаДанных;
	//	
	//	Блокировка.Заблокировать();
		
	КонецЕсли;
	
	// Получаем остатки
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = Запрос.Текст +
	"ВЫБРАТЬ
	|	Остатки.Организация КАК Организация,
	|	ЕСТЬNULL(Остатки.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
	|	Остатки.КФО КАК КФО,
	|	ЕСТЬNULL(Остатки.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) КАК КПС,
	|	ЕСТЬNULL(Остатки.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК Подразделение,
	|	Остатки.Счет КАК СчетРасчетов,
	|	Остатки.Субконто1 КАК Субконто1,
	|	Остатки.Субконто2 КАК Субконто2,
	|	Остатки.Субконто3 КАК Субконто3,
	|	ВЫБОР
	|		КОГДА &ИспользоватьВалютныйУчет
	|				И Остатки.Счет.Валютный
	|			ТОГДА Остатки.Валюта
	|		ИНАЧЕ &ВалютаРеглУчета
	|	КОНЕЦ КАК Валюта,
	|	ВЫБОР
	|		КОГДА &ИспользоватьВалютныйУчет
	|				И Остатки.Счет.Валютный
	|			ТОГДА Остатки.ВалютнаяСуммаОстаток
	|		ИНАЧЕ Остатки.СуммаОстаток + Остатки.СуммаНеУчитываетсяНУОстаток + Остатки.СуммаЕНВДОстаток + Остатки.СуммаНДСОстаток
	|	КОНЕЦ КАК СуммаВал,
	|	Остатки.СуммаОстаток КАК СуммаРуб,
	|	ВЫБОР
	|		КОГДА Остатки.Счет.НалоговыйУчетНеУчитываемых
	|			ТОГДА Остатки.СуммаНеУчитываетсяНУОстаток
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаНеУчитываетсяНУРуб,
	|	ВЫБОР
	|		КОГДА &ПлательщикЕНВД
	|				И Остатки.Счет.НалоговыйУчетЕНВД
	|			ТОГДА Остатки.СуммаЕНВДОстаток
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаЕНВДРуб,
	|	ВЫБОР
	|		КОГДА Остатки.Счет.НалоговыйУчетНДС
	|			ТОГДА Остатки.СуммаНДСОстаток
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаНДСРуб
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В (&СчетаРасчетов),
	|			,
	|			Организация = &Организация
	|				И КФО В (&КФО)
	|				И &УсловиеИФО
	|				И &УсловиеОтбораРасчетовУСН) КАК Остатки";
	
	Запрос.УстановитьПараметр("Период",      Период);
	Запрос.УстановитьПараметр("Организация", Реквизиты.Организация);
	
	Запрос.УстановитьПараметр("СчетаРасчетов", СчетаРасчетов);
	
	ЕстьОтборРасчетов = (ЗначениеЗаполнено(ОтборРасчетов) И ОтборРасчетов.Количество() > 0);
	Если ЕстьОтборРасчетов Тогда
		
		УсловияОтбораРасчетов = "";
		Для Каждого ЭлементОтбора Из ОтборРасчетов Цикл
			
			Запрос.УстановитьПараметр(ЭлементОтбора.Ключ, ЭлементОтбора.Значение);
			
			Если Найти("ИФО,КФО", ЭлементОтбора.Ключ) = 0 Тогда
				УсловияОтбораРасчетов = УсловияОтбораРасчетов
					+ ?(ПустаяСтрока(УсловияОтбораРасчетов), "", " И ")
					+ ЭлементОтбора.Ключ + " В (&" + ЭлементОтбора.Ключ + ")";
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	Если ЕстьОтборРасчетов И НЕ ПустаяСтрока(УсловияОтбораРасчетов) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОтбораРасчетовУСН", УсловияОтбораРасчетов);
	Иначе
		Запрос.УстановитьПараметр("УсловиеОтбораРасчетовУСН", Истина);
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО",
		?(Реквизиты.ИспользоватьУчетПоИФО, "ИФО В (&ИФО)", "ИСТИНА") );
	
	Запрос.УстановитьПараметр("ИспользоватьВалютныйУчет", Реквизиты.ИспользоватьВалютныйУчет);
	Запрос.УстановитьПараметр("ПлательщикЕНВД", Реквизиты.ПлательщикЕНВД);
	Запрос.УстановитьПараметр("ВалютаРеглУчета", БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета());
	
	ОстаткиРасчетов = Запрос.Выполнить().Выгрузить();
	
	// Добавим колонку "Документ расчетов".
	ВидСубконтоДокументыРасчетов = ПланыВидовХарактеристик.ВидыСубконто.ДокументыРасчетов;
	ОстаткиРасчетов.Колонки.Добавить("ДокументРасчетов", ВидСубконтоДокументыРасчетов.ТипЗначения);
	Для Каждого СтрокаОстатков Из ОстаткиРасчетов Цикл
		
		СвойстваСчетаРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаОстатков.СчетРасчетов);
		Если СвойстваСчетаРасчетов.ВидСубконто1 = ВидСубконтоДокументыРасчетов Тогда
			НомерСубконтоДокументыРасчетов = 1;
		ИначеЕсли СвойстваСчетаРасчетов.ВидСубконто2 = ВидСубконтоДокументыРасчетов Тогда
			НомерСубконтоДокументыРасчетов = 2;
		ИначеЕсли СвойстваСчетаРасчетов.ВидСубконто3 = ВидСубконтоДокументыРасчетов Тогда
			НомерСубконтоДокументыРасчетов = 3;
		Иначе
			НомерСубконтоДокументыРасчетов = 0;
		КонецЕсли;
		Если НомерСубконтоДокументыРасчетов > 0 Тогда
			СтрокаОстатков.ДокументРасчетов = СтрокаОстатков["Субконто" + НомерСубконтоДокументыРасчетов];
		КонецЕсли;
		
		Если СвойстваСчетаРасчетов.Вид = ВидСчета.Пассивный Тогда
			// Меняем знак остатка для счета УД "Доходы по обычным видам деятельности (УСН)".
			СтрокаОстатков.СуммаВал                = (-1) * СтрокаОстатков.СуммаВал;
			СтрокаОстатков.СуммаРуб                = (-1) * СтрокаОстатков.СуммаРуб;
			СтрокаОстатков.СуммаНДСРуб             = (-1) * СтрокаОстатков.СуммаНДСРуб;
			СтрокаОстатков.СуммаНеУчитываетсяНУРуб = (-1) * СтрокаОстатков.СуммаНеУчитываетсяНУРуб;
			СтрокаОстатков.СуммаЕНВДРуб            = (-1) * СтрокаОстатков.СуммаЕНВДРуб;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ОстаткиРасчетов;
	
КонецФункции

#КонецОбласти

#Область КнигаУчетаДоходовИРасходов

Процедура СформироватьДвиженияПоНалоговомуУчетуУСН(ДокументСсылка, НаборЗаписейРегистраБухгалтерии, ТаблицыДляДвижений = Неопределено) Экспорт
	
	ЗаписатьДвижения = (ТаблицыДляДвижений = Неопределено);
	
	МетаданныеДокумента = ДокументСсылка.Метаданные();
	Если НЕ МетаданныеДокумента.Движения.Содержит(Метаданные.РегистрыНакопления.КнигаУчетаДоходовИРасходов)
	 ИЛИ МетаданныеДокумента.Имя = "ОперацияБух" Тогда
		Возврат;
	КонецЕсли;
	
	ДатаСрезаУчетнойПолитики = ?(СтрНайти(МетаданныеДокумента.Имя, "ВводНачальныхОстатков")>0,
		КонецГода(ДокументСсылка.Дата) + 1, ДокументСсылка.Дата);
	Если НЕ УчетУСНВызовСервера.ПрименяетсяУСН(ДокументСсылка.Организация, ДатаСрезаУчетнойПолитики) Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Ложь;
	
	ДвиженияУСН = Новый Структура;
	ДвиженияУСН.Вставить("КнигаУчетаДоходовИРасходов", РегистрыНакопления.КнигаУчетаДоходовИРасходов.СоздатьНаборЗаписей());
	ДвиженияУСН.Вставить("РасшифровкаКУДиР",           РегистрыСведений.РасшифровкаКУДиР.СоздатьНаборЗаписей());
	
	Если ЗаписатьДвижения Тогда
		
		Для Каждого РегистрУСН из ДвиженияУСН Цикл
			НаборЗаписей = РегистрУСН.Значение;
			НаборЗаписей.Отбор.Регистратор.Установить(ДокументСсылка);
			НаборЗаписей.Прочитать();
			Если НаборЗаписей.Количество() > 0 Тогда
				НаборЗаписей.Очистить();
			КонецЕсли;
			НаборЗаписей.Записывать = Истина;
		КонецЦикла;
		
	КонецЕсли;
	
	ОтразитьДоходыРасходыВКУДиР(ДвиженияУСН, ДокументСсылка, НаборЗаписейРегистраБухгалтерии);
	
	Если НЕ Отказ Тогда
		Для Каждого РегистрУСН из ДвиженияУСН Цикл
			Если РегистрУСН.Ключ = "РасшифровкаКУДиР"
				И НЕ МетаданныеДокумента.Движения.Содержит(Метаданные.РегистрыСведений.РасшифровкаКУДиР) Тогда
				Продолжить; // Некоторые документы не двигают регистр РасшифровкаКУДиР.
			Иначе
				НаборЗаписей = РегистрУСН.Значение;
				Если ЗаписатьДвижения Тогда
					НаборЗаписей.Записать(Истина);
				Иначе // Режим без записи движений.
					ТаблицыДляДвижений.Вставить(РегистрУСН.Ключ, НаборЗаписей.Выгрузить());
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОтразитьДоходыРасходыВКУДиР(ДвиженияУСН, ДокументСсылка, ПроводкиДокумента) Экспорт
	
	УчетнаяПолитика = Справочники.Организации.ПолучитьУчетнуюПолитику(
		ДокументСсылка.Организация,
		БухгалтерскийУчет.ДатаУстановкиУчетнойПолитики(ДокументСсылка.Организация, ДокументСсылка.Дата) );
	
	ОписаниеТипаСумм = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	
	МетаданныеРасходовУСН = Метаданные.Справочники.РасходыУСН.Реквизиты;
	МетаданныеДокумента   = ДокументСсылка.Метаданные();
	
	ДвиженияДенежныхСредств = Новый ТаблицаЗначений;
	// Общие разрезы учета.
	ДвиженияДенежныхСредств.Колонки.Добавить("Период",        Новый ОписаниеТипов("Дата"));
	ДвиженияДенежныхСредств.Колонки.Добавить("Организация",   Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ДвиженияДенежныхСредств.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ДвиженияДенежныхСредств.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	// Характеристики движения денежных средств.
	ДвиженияДенежныхСредств.Колонки.Добавить("ВидОперацииУСН", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыОперацийУСН"));
	ДвиженияДенежныхСредств.Колонки.Добавить("СчетБУ",         Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ДвиженияДенежныхСредств.Колонки.Добавить("Контрагент",     Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ДвиженияДенежныхСредств.Колонки.Добавить("Договор",        Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ДвиженияДенежныхСредств.Колонки.Добавить("ЦМО",            Новый ОписаниеТипов("СправочникСсылка.ЦМО"));
	ДвиженияДенежныхСредств.Колонки.Добавить("ВидНалога",      Новый ОписаниеТипов("СправочникСсылка.ВидыНалоговИПлатежей"));
	ДвиженияДенежныхСредств.Колонки.Добавить("Сумма",            ОписаниеТипаСумм);
	
	ПризнанныеДоходы  = Новый ТаблицаЗначений;
	// Общие разрезы учета.
	ПризнанныеДоходы.Колонки.Добавить("Период",        Новый ОписаниеТипов("Дата"));
	ПризнанныеДоходы.Колонки.Добавить("Организация",   Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ПризнанныеДоходы.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПризнанныеДоходы.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	// Характеристики доходов УСН.
	ПризнанныеДоходы.Колонки.Добавить("ВидОперацииУСН",      Новый ОписаниеТипов("Строка"));
	ПризнанныеДоходы.Колонки.Добавить("Контрагент",          Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ПризнанныеДоходы.Колонки.Добавить("Договор",             Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ПризнанныеДоходы.Колонки.Добавить("ЦМО",                 Новый ОписаниеТипов("СправочникСсылка.ЦМО"));
	ПризнанныеДоходы.Колонки.Добавить("ДокументОплаты",      ПланыВидовХарактеристик.ВидыСубконто.ДокументыОплатыУСН.ТипЗначения);
	ПризнанныеДоходы.Колонки.Добавить("СчетДт",              Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПризнанныеДоходы.Колонки.Добавить("СчетКт",              Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПризнанныеДоходы.Колонки.Добавить("БазаРаспределения",   ОписаниеТипаСумм);
	ПризнанныеДоходы.Колонки.Добавить("ДоходыВсего",         ОписаниеТипаСумм);
	ПризнанныеДоходы.Колонки.Добавить("ДоходыУСН",           ОписаниеТипаСумм);
	ПризнанныеДоходы.Колонки.Добавить("ДоходыНеУчитываемые", ОписаниеТипаСумм);
	ПризнанныеДоходы.Колонки.Добавить("ДоходыЕНВД",          ОписаниеТипаСумм);
	
	ПризнанныеРасходы  = Новый ТаблицаЗначений;
	// Общие разрезы учета.
	ПризнанныеРасходы.Колонки.Добавить("Период",        Новый ОписаниеТипов("Дата"));
	ПризнанныеРасходы.Колонки.Добавить("Организация",   Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ПризнанныеРасходы.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПризнанныеРасходы.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	// Характеристики расходов УСН.
	ПризнанныеРасходы.Колонки.Добавить("ДокументОплаты",       ПланыВидовХарактеристик.ВидыСубконто.ДокументыОплатыУСН.ТипЗначения);
	ПризнанныеРасходы.Колонки.Добавить("Контрагент",           МетаданныеРасходовУСН.Контрагент.Тип);
	ПризнанныеРасходы.Колонки.Добавить("Договор",              МетаданныеРасходовУСН.Договор.Тип);
	ПризнанныеРасходы.Колонки.Добавить("ВидРасхода",           МетаданныеРасходовУСН.ВидРасхода.Тип);
	ПризнанныеРасходы.Колонки.Добавить("ЭлементРасхода",       МетаданныеРасходовУСН.ЭлементРасхода.Тип);
	ПризнанныеРасходы.Колонки.Добавить("Партия",               МетаданныеРасходовУСН.Партия.Тип);
	ПризнанныеРасходы.Колонки.Добавить("ИмяСпискаДокумента",   МетаданныеРасходовУСН.ИмяСпискаДокумента.Тип);
	ПризнанныеРасходы.Колонки.Добавить("НомерСтрокиДокумента", МетаданныеРасходовУСН.НомерСтрокиДокумента.Тип);
	ПризнанныеРасходы.Колонки.Добавить("СчетДт",               Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПризнанныеРасходы.Колонки.Добавить("СчетКт",               Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПризнанныеРасходы.Колонки.Добавить("ОписаниеРасходов",     Новый ОписаниеТипов("Строка"));
	ПризнанныеРасходы.Колонки.Добавить("БазаРаспределения",    ОписаниеТипаСумм);
	ПризнанныеРасходы.Колонки.Добавить("РасходыВсего",         ОписаниеТипаСумм);
	ПризнанныеРасходы.Колонки.Добавить("РасходыУСН",           ОписаниеТипаСумм);
	ПризнанныеРасходы.Колонки.Добавить("РасходыНеУчитываемые", ОписаниеТипаСумм);
	ПризнанныеРасходы.Колонки.Добавить("РасходыЕНВД",          ОписаниеТипаСумм);
	ПризнанныеРасходы.Колонки.Добавить("НДС",                  ОписаниеТипаСумм);
	
	// Соберем признанные расходы из проводок документа по забалансовым счетам учета расходов УСН.
	Для Каждого Проводка Из ПроводкиДокумента Цикл
		
		Если НЕ УчетУСНВызовСервера.ПрименяетсяУСН(Проводка.Организация, Проводка.Период)
		 ИЛИ НЕ УчетУСНКлиентСервер.ВедетсяУчетУСНпоКФО(Проводка.КФО) Тогда
			Продолжить;
		КонецЕсли;
		
		Сумма                = ?(ЗначениеЗаполнено(Проводка.Сумма),                Проводка.Сумма, 0);
		СуммаНеУчитываетсяНУ = ?(ЗначениеЗаполнено(Проводка.СуммаНеУчитываетсяНУ), Проводка.СуммаНеУчитываетсяНУ, 0);
		СуммаЕНВД            = ?(ЗначениеЗаполнено(Проводка.СуммаЕНВД),            Проводка.СуммаЕНВД, 0);
		СуммаНДС             = ?(ЗначениеЗаполнено(Проводка.СуммаНДС),             Проводка.СуммаНДС, 0);
		
		// Поступления денежных средств.
		Если БухгалтерскийУчет.СчетВИерархии(Проводка.СчетДт, "201.00") Тогда
			
			Поступление = ДвиженияДенежныхСредств.Добавить();
			ЗаполнитьЗначенияСвойств(Поступление, Проводка, "Период,Организация,ИФО,КФО");
			
			Если БухгалтерскийУчет.СчетВИерархии(Проводка.СчетКт, "206.20,206.30,206.90")
			 ИЛИ БухгалтерскийУчет.СчетВИерархии(Проводка.СчетКт, "302.20,302.30,302.90") Тогда
				Поступление.ВидОперацииУСН = Перечисления.ВидыОперацийУСН.ВозвратОтПоставщика;
