		// Корректировка КУДиР при списании материальных запасов на ЕНВД или на неучитываемые расходы.
		ИначеЕсли НЕ ЗначениеЗаполнено(Проводка.СчетДт)
			И БухгалтерскийУчет.СчетВИерархии(Проводка.СчетКт, "У10,У15,У20,У41")
			И НЕ БухгалтерскийУчет.СчетВИерархии(Проводка.СчетКт, "У10.СО,У10.О,У10.ОР,У10.Р,У15.СО,У15.О,У20.О,У20.Р,У41.СО,У41.О,У41.ОР,У41.Р")
			Тогда // расходы УСН уже оплачены
			
			ДокументОплаты = Проводка.СубконтоКт.ДокументыОплатыУСН;
			Если ЗначениеЗаполнено(ДокументОплаты) Тогда
				УчетнаяПолитикаНаМоментОплаты = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(
					ДокументОплаты.Организация, ДокументОплаты.Дата);
			Иначе // Если учет на счете расчетов ведется без расчетных документов, и расчеты оплачены авансом,
				// нет возможности определить учетную политику на дату оплаты.
				УчетнаяПолитикаНаМоментОплаты = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(
					Проводка.Организация, Проводка.Период); // Определяем на текущую дату и считаем, что изменений не было.
			КонецЕсли;
			
			ТоварыПоОплате    = (УчетнаяПолитикаНаМоментОплаты.ПорядокПризнанияРасходовПоТоварам =
				Перечисления.ПорядокПризнанияРасходовПоТоварам.ПоОплатеПоставщику);
			МатериалыПоОплате = (УчетнаяПолитикаНаМоментОплаты.ПорядокПризнанияМатериальныхРасходов =
				Перечисления.ПорядокПризнанияМатериальныхРасходов.ПоОплатеПоставщику);
			НДСПоОплате       = (УчетнаяПолитикаНаМоментОплаты.ПорядокПризнанияРасходовПоНДС =
				Перечисления.ПорядокПризнанияРасходовПоНДС.ПоОплатеПоставщику);
			
			Если (ТоварыПоОплате    И БухгалтерскийУчет.СчетВИерархии(Проводка.СчетКт, "У41.СП"))
			 ИЛИ (МатериалыПоОплате И БухгалтерскийУчет.СчетВИерархии(Проводка.СчетКт, "У10.СП")) Тогда
				КорректировкаСуммы    = Сумма;
				КорректировкаСуммыНДС = СуммаНДС;
			Иначе
				КорректировкаСуммы    = 0;
				КорректировкаСуммыНДС = ?(НДСПоОплате, СуммаНДС, 0);
			КонецЕсли;
			
			Если КорректировкаСуммы > 0
			 ИЛИ КорректировкаСуммыНДС > 0 Тогда
			
				ПризнанныйРасход = ДобавитьПризнанныйРасход(ПризнанныеРасходы, Проводка,
					- КорректировкаСуммы, 0, 0, - КорректировкаСуммыНДС);
				
				ПризнанныйРасход.ДокументОплаты = ДокументОплаты;
				
			КонецЕсли;
			
		// Корректировка КУДиР при возврате материальных запасов поставщику.
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Проводка.СчетДт, "УРК")
			И (   БухгалтерскийУчет.СчетВИерархии(Проводка.СчетКт, "У10.СП")
			  ИЛИ БухгалтерскийУчет.СчетВИерархии(Проводка.СчетКт, "У41.СП") )
