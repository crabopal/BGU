				Поступление.Договор        = Проводка.СубконтоКт.Договоры;
				
			ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Проводка.СчетКт, "205.00,209.00") Тогда
				Поступление.ВидОперацииУСН = Перечисления.ВидыОперацийУСН.ОплатаОтПокупателя;
				Поступление.Контрагент     = Проводка.СубконтоКт.Контрагенты;
				Поступление.Договор        = Проводка.СубконтоКт.Договоры;
				
			ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Проводка.СчетКт, "208.00") Тогда
				Поступление.ВидОперацииУСН = Перечисления.ВидыОперацийУСН.ВозвратОтПодотчетногоЛица;
				Поступление.Контрагент     = Проводка.СубконтоКт.Контрагенты;
				
			ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Проводка.СчетКт, "401.10") Тогда
				
				Если ТипЗнч(Проводка.ХарактеристикаДвиженияКт) = Тип("СправочникСсылка.ЦМО") Тогда
					Поступление.ВидОперацииУСН = Перечисления.ВидыОперацийУСН.РозничнаяВыручка;
					Поступление.ЦМО            = Проводка.ХарактеристикаДвиженияКт;
				Иначе
					Поступление.ВидОперацииУСН = Перечисления.ВидыОперацийУСН.ПрочееПоступление;
				КонецЕсли;
				
			Иначе
				Поступление.ВидОперацииУСН = Перечисления.ВидыОперацийУСН.НеОтражается;
			КонецЕсли;
			
			Поступление.СчетБУ = Проводка.СчетДт; // Счет учета денежных средств (субсчет 201).
			Поступление.Сумма  = Сумма;
			
		КонецЕсли;
		
		// Списания денежных средств.
		Если БухгалтерскийУчет.СчетВИерархии(Проводка.СчетКт, "201.00") Тогда
			
			Списание = ДвиженияДенежныхСредств.Добавить();
			ЗаполнитьЗначенияСвойств(Списание, Проводка, "Период,Организация,ИФО,КФО");
			
			Если БухгалтерскийУчет.СчетВИерархии(Проводка.СчетДт, "206.20,206.30,206.90")
			 ИЛИ БухгалтерскийУчет.СчетВИерархии(Проводка.СчетДт, "302.20,302.30,302.90") Тогда
				Списание.ВидОперацииУСН = Перечисления.ВидыОперацийУСН.ОплатаПоставщику;
				Списание.Контрагент     = Проводка.СубконтоДт.Контрагенты;
				Списание.Договор        = Проводка.СубконтоДт.Договоры;
				
			ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Проводка.СчетДт, "205.00,209.00") Тогда
				Списание.ВидОперацииУСН = Перечисления.ВидыОперацийУСН.ВозвратПокупателю;
				Списание.Контрагент     = Проводка.СубконтоДт.Контрагенты;
				Списание.Договор        = Проводка.СубконтоДт.Договоры;
				
			ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Проводка.СчетДт, "208.00") Тогда
				Списание.ВидОперацииУСН = ?(БухгалтерскийУчет.СчетВИерархии(Проводка.СчетКт, "201.30"),
					Перечисления.ВидыОперацийУСН.ВыдачаПодотчетномуЛицу,
					Перечисления.ВидыОперацийУСН.ПеречислениеПодотчетномуЛицу);
				Списание.Контрагент     = Проводка.СубконтоДт.Контрагенты;
				
			ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Проводка.СчетДт, "206.10,302.10") Тогда
				Списание.ВидОперацииУСН = ?(БухгалтерскийУчет.СчетВИерархии(Проводка.СчетКт, "201.30"),
					Перечисления.ВидыОперацийУСН.ВыплатаЗаработнойПлаты,
					Перечисления.ВидыОперацийУСН.ПеречислениеЗаработнойПлаты);
				Списание.Контрагент     = Проводка.СубконтоДт.Контрагенты;
				
			ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Проводка.СчетДт, "303.00") Тогда
				Списание.ВидОперацииУСН = Перечисления.ВидыОперацийУСН.ПеречислениеНалога;
				Списание.ВидНалога      = Проводка.СубконтоДт.ВидыНалоговИПлатежей;
				
			ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Проводка.СчетДт, "304.03") Тогда
				Списание.ВидОперацииУСН = Перечисления.ВидыОперацийУСН.ПеречислениеУдержанийИзЗаработнойПлаты;
				Списание.Контрагент     = Проводка.СубконтоДт.Контрагенты;
				
			ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Проводка.СчетДт, "401.10") Тогда
				
				Если ТипЗнч(Проводка.ХарактеристикаДвиженияДт) = Тип("СправочникСсылка.ЦМО") Тогда
					Списание.ВидОперацииУСН = Перечисления.ВидыОперацийУСН.СторноРозничнойВыручки;
					Списание.ЦМО            = Проводка.ХарактеристикаДвиженияДт;
				Иначе
					Списание.ВидОперацииУСН = Перечисления.ВидыОперацийУСН.ПрочееСписание;
				КонецЕсли;
				
			ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Проводка.СчетДт, "401.20") Тогда
				Списание.ВидОперацииУСН = Перечисления.ВидыОперацийУСН.ПрочееСписание;
				
			Иначе
				Списание.ВидОперацииУСН = Перечисления.ВидыОперацийУСН.НеОтражается;
			КонецЕсли;
			
			Списание.СчетБУ = Проводка.СчетКт; // Счет учета денежных средств (субсчет 201).
			Списание.Сумма  = Сумма;
			
		КонецЕсли;
		
		// Доходы УСН.
		Если БухгалтерскийУчет.СчетВИерархии(Проводка.СчетКт, "У99")
		И НЕ БухгалтерскийУчет.СчетВИерархии(Проводка.СчетДт, "У99") Тогда
			
			Если Сумма <> 0
			 ИЛИ СуммаНеУчитываетсяНУ <> 0
			 ИЛИ СуммаЕНВД <> 0 Тогда
			
				ПризнанныйДоход = ПризнанныеДоходы.Добавить();
				ЗаполнитьЗначенияСвойств(ПризнанныйДоход, Проводка, "Период,Организация,ИФО,КФО");
				
				Если Проводка.ХарактеристикаДвиженияКт = Перечисления.ПорядокОтраженияАвансовУСН.ДоходУСН
