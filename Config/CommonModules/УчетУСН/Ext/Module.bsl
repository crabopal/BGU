				НоваяПроводка.СчетКт = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У99");
				БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Кт", "ДокументыОплатыУСН", Проводка.СубконтоДт3);
				НоваяПроводка.ХарактеристикаДвиженияКт = Перечисления.ПорядокОтраженияАвансовУСН.ДоходЕНВД;
				
				СвойстваСчетаДтУСН = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяПроводка.СчетДт);
				СвойстваСчетаКтУСН = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяПроводка.СчетКт);
				Если СвойстваСчетаДтУСН.УчетПоПодразделениям И СвойстваСчетаДт.УчетПоПодразделениям Тогда
					НоваяПроводка.ПодразделениеДт = Проводка.ПодразделениеДт;
					Если СвойстваСчетаКтУСН.УчетПоПодразделениям Тогда
						НоваяПроводка.ПодразделениеКт = НоваяПроводка.ПодразделениеДт;
					КонецЕсли;
				КонецЕсли;
				Если СвойстваСчетаДтУСН.УчетПоКПС И СвойстваСчетаДт.УчетПоКПС Тогда
					НоваяПроводка.КПСДт = Проводка.КПСДт;
					Если СвойстваСчетаКтУСН.УчетПоКПС Тогда
						НоваяПроводка.КПСКт = НоваяПроводка.КПСДт;
					КонецЕсли;
				КонецЕсли;
				
				НоваяПроводка.Сумма     = - (Проводка.Сумма - Проводка.СуммаЕНВД);
				НоваяПроводка.СуммаЕНВД = + (Проводка.Сумма - Проводка.СуммаЕНВД);
				
				КоличествоДобавленныхПроводок = КоличествоДобавленныхПроводок + 1;
				
			ИначеЕсли НЕ ЭтоОсобыйПорядокНалогообложения И Проводка.СуммаЕНВД > 0 Тогда
				
				Если НЕ ИспользуетсяСчетАП Тогда // После перехода на 64н эти проводки формируются типовой операцией "Зачет аванса полученного (УСН + ЕНВД)".
					
					// Скорректируем показатель СуммаЕНВД на счете 205.ХХ, если зачли авансы, отнесенные к деятельности на ЕНВД.
					НоваяПроводка = ТаблицаПроводок.Вставить(ИндексПроводки + КоличествоДобавленныхПроводок);
					ЗаполнитьЗначенияСвойств(НоваяПроводка, Проводка, ,
						"СчетДт,СубконтоДт1,СубконтоДт2,СубконтоДт3,КПСДт,КЭКДт,ПодразделениеДт,
						|ВалютаДт,ВалютнаяСуммаДт,КоличествоДт,ВалютнаяСуммаКт,КоличествоКт,
						|Сумма,СуммаНеУчитываетсяНУ,СуммаЕНВД,СуммаНДС"); // без корреспонденции
					
					НоваяПроводка.Содержание = НСтр("ru = 'Аванс отнесен к деятельности на УСН.'");
					НоваяПроводка.СчетДт     = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("000");
					НоваяПроводка.ВидСубконтоДт1 = ВидыСубконто.ПустаяСсылка();
					НоваяПроводка.ВидСубконтоДт2 = ВидыСубконто.ПустаяСсылка();
					НоваяПроводка.ВидСубконтоДт3 = ВидыСубконто.ПустаяСсылка();
					
					НоваяПроводка.СуммаЕНВД = - Проводка.СуммаЕНВД;
					
					КоличествоДобавленныхПроводок = КоличествоДобавленныхПроводок + 1;
					
				КонецЕсли;
				
				// Скорректируем доходы на счете У99 "Доходы и расходы".
				НоваяПроводка = ТаблицаПроводок.Вставить(ИндексПроводки + КоличествоДобавленныхПроводок);
				ЗаполнитьЗначенияСвойств(НоваяПроводка, Проводка,
					"Активность,Период,Организация,ИФО,КФО,
					|ВидПервичногоДокумента,ДатаПервичногоДокумента,НомерПервичногоДокумента"); // без корреспонденции
				НоваяПроводка.ВидСубконтоДт1 = ВидыСубконто.ПустаяСсылка();
				НоваяПроводка.ВидСубконтоДт2 = ВидыСубконто.ПустаяСсылка();
				НоваяПроводка.ВидСубконтоДт3 = ВидыСубконто.ПустаяСсылка();
				НоваяПроводка.ВидСубконтоКт1 = ВидыСубконто.ПустаяСсылка();
				НоваяПроводка.ВидСубконтоКт2 = ВидыСубконто.ПустаяСсылка();
				НоваяПроводка.ВидСубконтоКт3 = ВидыСубконто.ПустаяСсылка();
				
				НоваяПроводка.Содержание = НСтр("ru = 'Аванс отнесен к деятельности на УСН.'");
				НоваяПроводка.СчетДт = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("УРК");
				БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Дт", "Контрагенты", Проводка.СубконтоДт1);
				БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Дт", "Договоры",    Проводка.СубконтоДт2);
				НоваяПроводка.ХарактеристикаДвиженияДт = ПорядокНалогообложения;
				
				НоваяПроводка.СчетКт = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У99");
				БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Кт", "ДокументыОплатыУСН", Проводка.СубконтоДт3);
				НоваяПроводка.ХарактеристикаДвиженияКт = Перечисления.ПорядокОтраженияАвансовУСН.ДоходУСН;
				
				СвойстваСчетаДтУСН = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяПроводка.СчетДт);
				СвойстваСчетаКтУСН = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяПроводка.СчетКт);
				Если СвойстваСчетаДтУСН.УчетПоПодразделениям И СвойстваСчетаДт.УчетПоПодразделениям Тогда
					НоваяПроводка.ПодразделениеДт = Проводка.ПодразделениеДт;
					Если СвойстваСчетаКтУСН.УчетПоПодразделениям Тогда
						НоваяПроводка.ПодразделениеКт = НоваяПроводка.ПодразделениеДт;
					КонецЕсли;
				КонецЕсли;
				Если СвойстваСчетаДтУСН.УчетПоКПС И СвойстваСчетаДт.УчетПоКПС Тогда
					НоваяПроводка.КПСДт = Проводка.КПСДт;
					Если СвойстваСчетаКтУСН.УчетПоКПС Тогда
						НоваяПроводка.КПСКт = НоваяПроводка.КПСДт;
					КонецЕсли;
				КонецЕсли;
				
				НоваяПроводка.Сумма     = + Проводка.СуммаЕНВД;
				НоваяПроводка.СуммаЕНВД = - Проводка.СуммаЕНВД;
				
				КоличествоДобавленныхПроводок = КоличествоДобавленныхПроводок + 1;
				
			КонецЕсли;
			
		КонецЕсли;
		
		ЭтоОплаченныеДоходыУСН = БухгалтерскийУчет.СчетВИерархии(Проводка.СчетДт, "УД");
		Если ЭтоОплаченныеДоходыУСН Тогда
			
			КоличествоДобавленныхПроводок = 1;
			
			ДокументОплатыУСН = Проводка.ХарактеристикаДвиженияДт;
			Если Проводка.СуммаНДС > 0 Тогда
				
				// Скорректируем доходы на счете У99 "Доходы и расходы".
				НоваяПроводка = ТаблицаПроводок.Вставить(ИндексПроводки + КоличествоДобавленныхПроводок);
				ЗаполнитьЗначенияСвойств(НоваяПроводка, Проводка,
					"Активность,Период,Организация,ИФО,КФО,
					|ВидПервичногоДокумента,ДатаПервичногоДокумента,НомерПервичногоДокумента"); // без корреспонденции
				НоваяПроводка.ВидСубконтоДт1 = ВидыСубконто.ПустаяСсылка();
				НоваяПроводка.ВидСубконтоДт2 = ВидыСубконто.ПустаяСсылка();
				НоваяПроводка.ВидСубконтоДт3 = ВидыСубконто.ПустаяСсылка();
				НоваяПроводка.ВидСубконтоКт1 = ВидыСубконто.ПустаяСсылка();
				НоваяПроводка.ВидСубконтоКт2 = ВидыСубконто.ПустаяСсылка();
				НоваяПроводка.ВидСубконтоКт3 = ВидыСубконто.ПустаяСсылка();
				
				НоваяПроводка.Содержание = НСтр("ru = 'Предъявленный покупателям НДС исключен из доходов'");
				НоваяПроводка.СчетДт = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("УРК");
				БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Дт", "Контрагенты", Проводка.СубконтоДт1);
				БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Дт", "Договоры",    Проводка.СубконтоДт2);
				
				НоваяПроводка.СчетКт = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У99");
				БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Кт", "ДокументыОплатыУСН", ДокументОплатыУСН);
				
				СвойстваСчетаДтУСН = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяПроводка.СчетДт);
				СвойстваСчетаКтУСН = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяПроводка.СчетКт);
				Если СвойстваСчетаДтУСН.УчетПоПодразделениям И СвойстваСчетаДт.УчетПоПодразделениям Тогда
					НоваяПроводка.ПодразделениеДт = Проводка.ПодразделениеДт;
					Если СвойстваСчетаКтУСН.УчетПоПодразделениям Тогда
						НоваяПроводка.ПодразделениеКт = НоваяПроводка.ПодразделениеДт;
					КонецЕсли;
				КонецЕсли;
				Если СвойстваСчетаДтУСН.УчетПоКПС И СвойстваСчетаДт.УчетПоКПС Тогда
					НоваяПроводка.КПСДт = Проводка.КПСДт;
					Если СвойстваСчетаКтУСН.УчетПоКПС Тогда
						НоваяПроводка.КПСКт = НоваяПроводка.КПСДт;
					КонецЕсли;
				КонецЕсли;
				
				НоваяПроводка.Сумма    = - Проводка.СуммаНДС;
				НоваяПроводка.СуммаНДС = + Проводка.СуммаНДС;
				
				КоличествоДобавленныхПроводок = КоличествоДобавленныхПроводок + 1;
				
			КонецЕсли;
			
		КонецЕсли;
		
		// РАСХОДЫ
		// Корректировать нужно, если это расходы по деятельности с особым порядком налогообложения (ЕНВД и пр.)
		//  или расходы, не учитываемые при налогообложении по ст. 251 и 270 НК РФ.
		
		Если НЕ ЗначениеЗаполнено(СвойстваСчетаДт)
		 ИЛИ СвойстваСчетаДт.ТипСчета <> ПредопределенноеЗначение("Перечисление.ТипыСчетов.Налоговый") Тогда
			Продолжить; // корректируем только проводки по счетам УСН
		КонецЕсли;
		
		ЭтоНеУчитываемые  = (Проводка.ХарактеристикаДвиженияДт = Перечисления.ОтражениеВУСН.НеПринимаются);
		ЭтоЕНВД           = (Проводка.ХарактеристикаДвиженияДт = Перечисления.ОтражениеВУСН.ОсобыйПорядок);
		
		Если ЭтоНеУчитываемые ИЛИ ЭтоЕНВД Тогда
			
			// Скорректируем стоимость списания имущества.
			МассивСчетовУСН = БухгалтерскийУчет.СписокСчетов("У10,У15,У20,У41,У68,У70");
			Если МассивСчетовУСН.Найти(Проводка.СчетКт) <> Неопределено Тогда
			
				Если ЭтоНеУчитываемые И (Проводка.Сумма <> 0 ИЛИ Проводка.СуммаЕНВД <> 0 ИЛИ Проводка.СуммаНДС <> 0) Тогда
					
					НоваяПроводка = ТаблицаПроводок.Вставить(ИндексПроводки);
					ЗаполнитьЗначенияСвойств(НоваяПроводка, Проводка, ,
						"СчетДт,СубконтоДт1,СубконтоДт2,СубконтоДт3,КПСДт,ПодразделениеДт,
						|ВалютаДт,ВалютнаяСуммаДт,КоличествоДт,
						|ВалютнаяСуммаКт,КоличествоКт"); // без корреспонденции
					
					// списываем суммы в остальных ресурсах на не учитываемые
					НоваяПроводка.СуммаНеУчитываетсяНУ = - (Проводка.Сумма + Проводка.СуммаЕНВД + Проводка.СуммаНДС);
					
				ИначеЕсли ЭтоЕНВД И (Проводка.Сумма <> 0 ИЛИ Проводка.СуммаНеУчитываетсяНУ <> 0 ИЛИ Проводка.СуммаНДС <> 0) Тогда
					
					НоваяПроводка = ТаблицаПроводок.Вставить(ИндексПроводки);
					ЗаполнитьЗначенияСвойств(НоваяПроводка, Проводка, ,
						"СчетДт,СубконтоДт1,СубконтоДт2,СубконтоДт3,КПСДт,ПодразделениеДт,
						|ВалютаДт,ВалютнаяСуммаДт,КоличествоДт,
						|ВалютнаяСуммаКт,КоличествоКт"); // без корреспонденции
					
					// списываем суммы в остальных ресурсах на ЕНВД
					НоваяПроводка.СуммаЕНВД = - (Проводка.Сумма + Проводка.СуммаНеУчитываетсяНУ + Проводка.СуммаНДС);
					
				КонецЕсли;
				
			КонецЕсли;
			
			// общую сумму расходов спишем по соответствующему ресурсу
			ОбщаяСуммаРасходов = Проводка.Сумма + Проводка.СуммаНеУчитываетсяНУ + Проводка.СуммаЕНВД + Проводка.СуммаНДС;
			
			Проводка.СуммаНеУчитываетсяНУ = ?(ЭтоНеУчитываемые, ОбщаяСуммаРасходов, 0);
			Проводка.СуммаЕНВД            = ?(ЭтоЕНВД,          ОбщаяСуммаРасходов, 0);
			Проводка.Сумма                = 0;
			Проводка.СуммаНДС             = 0;
			
		КонецЕсли;
		
		Если БухгалтерскийУчет.СчетВИерархии(Проводка.СчетДт, "УРН")
		   И БухгалтерскийУчет.СчетВИерархии(Проводка.СчетКт, "УРН") Тогда
			
			Если (Проводка.СуммаЕНВД <> 0 ИЛИ Проводка.СуммаНеУчитываетсяНУ <> 0) Тогда
				
				// Расходы на уплату налогов отнесены к ЕНВД или к неучитываемым расходам.
				// Уплата налогов всегда отражается по Дт УРН по ресурсу "Сумма".
				НоваяПроводка = ТаблицаПроводок.Вставить(ИндексПроводки);
				ЗаполнитьЗначенияСвойств(НоваяПроводка, Проводка, ,
					"СчетДт,СубконтоДт1,СубконтоДт2,СубконтоДт3,КПСДт,ПодразделениеДт,
					|ВалютаДт,ВалютнаяСуммаДт,КоличествоДт,
					|ВалютнаяСуммаКт,КоличествоКт"); // без корреспонденции
				
				// Списываем сумму зачета оплаты из ресурса "Сумма" за счет неучитываемых и ЕНВД.
				НоваяПроводка.Сумма                = Проводка.СуммаНеУчитываетсяНУ + Проводка.СуммаЕНВД;
				НоваяПроводка.СуммаНеУчитываетсяНУ = - Проводка.СуммаНеУчитываетсяНУ;
				НоваяПроводка.СуммаЕНВД            = - Проводка.СуммаЕНВД;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Возвращает реквизиты первичного документа для занесения в графу 2 КУДиР
//
Функция РеквизитыПервичногоДокумента(Знач Документ, Знач УказыватьВид = Ложь, СтруктураРеквизитов = Неопределено) Экспорт
	
	ОпределитьНомерДокументаСНастройкойПрефиксов = (СтруктураРеквизитов <> Неопределено);
	
	СтруктураРеквизитов = Новый Структура("Наименование,Номер,Дата");
	
	Если НЕ ЗначениеЗаполнено(Документ) Тогда
		Возврат "";
	КонецЕсли;
	
	ВидНаПечать		= "";
	НомерНаПечать	= "";
	ДатаНаПечать	= "";
	ДатаДокумента	= '00010101';
	
	МетаданныеДокумента	= Документ.Метаданные();

	Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("НомерПервичногоДокумента", МетаданныеДокумента) И
		ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ДатаПервичногоДокумента", МетаданныеДокумента) Тогда

		НомерНаПечать = Документ.НомерПервичногоДокумента;
		ДатаНаПечать  = Формат(Документ.ДатаПервичногоДокумента, "ДЛФ=D");
		ДатаДокумента = НачалоДня(Документ.ДатаПервичногоДокумента);
	КонецЕсли;

	//Если дата и номер первичного документа не указаны или не заполнены, используем дату и номер регистрации
	Если НЕ ЗначениеЗаполнено(НомерНаПечать) Тогда
		Если ОпределитьНомерДокументаСНастройкойПрефиксов Тогда
			НомерДокументаСНастройкойПрефиксов = РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(Документ, Документ.Номер);
			
			НомерНаПечать = НомерДокументаСНастройкойПрефиксов;
		Иначе
			НомерДокументаБезПрефиксов = ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Документ.Номер, Истина, Истина);
			
			НомерНаПечать = НомерДокументаБезПрефиксов;
		КонецЕсли;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ДатаНаПечать) Тогда
		ДатаНаПечать = Формат(Документ.Дата, "ДЛФ=D");
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ДатаДокумента) Тогда
		ДатаДокумента = НачалоДня(Документ.Дата);
	КонецЕсли;
	
	Если УказыватьВид Тогда
	
		Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ВидПервичногоДокумента", МетаданныеДокумента)
		   И ЗначениеЗаполнено(Документ.ВидПервичногоДокумента) Тогда
			ВидНаПечать = Документ.ВидПервичногоДокумента;
		Иначе
			ВидНаПечать = МетаданныеДокумента.Синоним;
		КонецЕсли;
	
		РеквизитыПервичногоДокумента	= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = '%1 № %2 от %3'"),
			ВидНаПечать, НомерНаПечать, ДатаНаПечать);

	Иначе
	
		РеквизитыПервичногоДокумента	= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = '№ %1 от %2'"),
			НомерНаПечать, ДатаНаПечать);

	КонецЕсли;
	
	СтруктураРеквизитов.Наименование = ВидНаПечать;
	СтруктураРеквизитов.Номер = НомерНаПечать;
	СтруктураРеквизитов.Дата = ДатаДокумента;
	
	Возврат РеквизитыПервичногоДокумента;
	
КонецФункции

