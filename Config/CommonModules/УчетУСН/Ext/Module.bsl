				ОписаниеДвиженияДенежныхСредств,
				Оплата.Контрагент);
		КонецЕсли;
		
	ИначеЕсли Оплата.ВидОперацииУСН = Перечисления.ВидыОперацийУСН.РозничнаяВыручка Тогда
		
		ОписаниеОперации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
