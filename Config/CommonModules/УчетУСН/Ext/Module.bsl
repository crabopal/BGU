
#Область ПрограммныйИнтерфейс

// Возвращает размеры ставок налога для переданной организации.
//
// Параметры:
//   Организация - СправочникСсылка.Организации
//   ОтчетныйПериод - Дата
//
// Возвращаемое значение:
//   Структура:
//      - ОсновнаяСтавка - Число - размер основной ставки налога УСН
//      - ПовышеннаяСтавка - Число - размер повышенной ставки налога УСН
//
Функция СтавкиНалогаУСН(Организация, ОтчетныйПериод) Экспорт
	
	СтавкиНалогаУСН = Новый Структура;
	СтавкиНалогаУСН.Вставить("ОсновнаяСтавка", 0);
	СтавкиНалогаУСН.Вставить("ПовышеннаяСтавка", 0);
	
	УчетнаяПолитика = Справочники.Организации.ПолучитьУчетнуюПолитику(Организация, ОтчетныйПериод);
	СтавкиНалогаУСН.ОсновнаяСтавка = УчетнаяПолитика.СтавкаНалогаУСН;
	
	Если УчетнаяПолитика.ПрименяетсяУСНДоходы Тогда
		СтавкиНалогаУСН.ПовышеннаяСтавка = 
			УчетУСНКлиентСервер.НалоговыеСтавкиПоУмолчанию(ОтчетныйПериод).СтавкаУСНДоходыПовышенная;
	Иначе
		СтавкиНалогаУСН.ПовышеннаяСтавка = 
			УчетУСНКлиентСервер.НалоговыеСтавкиПоУмолчанию(ОтчетныйПериод).СтавкаУСНДоходыМинусРасходыПовышенная;
	КонецЕсли;
	
	Возврат СтавкиНалогаУСН;
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция НаименованиеКонтрагентаДляКУДиР(Контрагент) Экспорт
	
	Возврат ?(ЗначениеЗаполнено(Контрагент.НаименованиеСокращенное), 
				Контрагент.НаименованиеСокращенное,
				Контрагент.Наименование);
	
КонецФункции

// Определяет, что не требуется сдавать отчетность и уплачивать налог за переданный период (год)
// по причине регистрации организации в декабре этого года (п. 2 статьи 55 НК РФ).
//
// Параметры:
//  Организация   - СправочникСсылка.Организации - проверяемая организация
//  Период        - Дата - проверяемый период
//
// Возвращаемое значение:
//   Булево   - Если ИСТИНА, это пропущенный период
//              (организация зарегистрирована в декабре переданного года, и для нее актуальны требования п.2 статьи 55 НК РФ).
//
Функция НалоговыйПериодПропущен(Организация, Период, ДатаРегистрации = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Организация) ИЛИ НЕ ЗначениеЗаполнено(Период) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПропущенныйПериод = ИнтерфейсыВзаимодействияБРО.ПропущенныйНалоговыйПериод(
		Перечисления.ВариантыРасширенногоПервогоНалоговогоПериода.РегистрацияВДекабре,
		Организация,
		ДатаРегистрации);
	
	Возврат ПропущенныйПериод <> Неопределено И (Год(ПропущенныйПериод) = Год(Период));
	
КонецФункции

// Определяет, что переданный период находится в пределах расширенного первого налогового периода -
// с даты регистрации в декабре по конец следующего года после регистрации (п. 2 статьи 55 НК РФ).
//
// Параметры:
//  Организация   - СправочникСсылка.Организации - проверяемая организация
//  Период        - Дата - проверяемый период (в пределах расширенного налогового периода)
//
// Возвращаемое значение:
//   Булево   - Если ИСТИНА, это расширенный период
//             (организация зарегистрирована в декабре переданного или прошлого года,
//              и для нее актуальны требования п.2 статьи 55 НК РФ).
//
Функция НалоговыйПериодРасширен(Организация, Период, ДатаРегистрации = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Организация) ИЛИ НЕ ЗначениеЗаполнено(Период) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НалоговыйПериод = ИнтерфейсыВзаимодействияБРО.БлижайшийНалоговыйПериод(Организация,
		Период, Перечисления.ВариантыРасширенногоПервогоНалоговогоПериода.РегистрацияВДекабре, , ДатаРегистрации);
	
	Возврат НалоговыйПериод.Начало < НалоговыйПериод.Период;
	
КонецФункции

// Возвращает список дат перехода организации с УСН на ОСНО.
//
// Параметры:
//   Организация - СправочникСсылка.Организации - организация, для которой необходимо получить даты перехода.
//
// Возвращаемое значение:
//   СписокЗначений - список дат перехода с УСН на ОСНО
//       * Значение - Дата - конец последнего дня применения УСН.
//       * Представление - Строка - строка вида "Переход на ОСНО с 1 января 2026 г.".
Функция ДатыПереходаСУСННаОСНО(Организация) Экспорт
	
	ДатыПерехода = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НастройкиСистемыНалогообложения.Период КАК Период,
	|	НастройкиСистемыНалогообложения.ПрименяетсяУСН КАК ПрименяетсяУСН,
	|	НастройкиСистемыНалогообложения.ПлательщикНалогаНаПрибыль КАК ПрименяетсяОСНО
	|ИЗ
	|	РегистрСведений.УчетнаяПолитикаОрганизаций КАК НастройкиСистемыНалогообложения
	|ГДЕ
	|	НастройкиСистемыНалогообложения.Организация = &Организация
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат ДатыПерехода;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	
	ВПредыдущемПериодеПрименяласьУСН = Ложь;
	Пока Выборка.Следующий() Цикл
		Если Выборка.ПрименяетсяОСНО И ВПредыдущемПериодеПрименяласьУСН Тогда
			ДатаПерехода = НачалоДня(Выборка.Период) - 1;
			Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Переход на ОСНО с %1'"), Формат(Выборка.Период, "ДЛФ=DD;"));
			ДатыПерехода.Добавить(ДатаПерехода, Представление);
		КонецЕсли;
		ВПредыдущемПериодеПрименяласьУСН = Выборка.ПрименяетсяУСН;
	КонецЦикла;
	
	Возврат ДатыПерехода;
	
КонецФункции

#КонецОбласти

#Область ИсключениеНДСИзДоходовУСН

Функция ПустаяТаблицаЗачетАвансовПолученныхУСН() Экспорт

	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	
	// Счет и аналитика учета расчетов с контрагентами (покупателями).
	ПустаяТаблица.Колонки.Добавить("СчетРасчетов",  Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("Контрагент",    Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ПустаяТаблица.Колонки.Добавить("Договор",       Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ПустаяТаблица.Колонки.Добавить("ДокументОплаты", ПланыВидовХарактеристик.ВидыСубконто.ДокументыОплатыУСН.ТипЗначения);
	ПустаяТаблица.Колонки.Добавить("Валюта",        Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	
	// Суммы для отражения в налоговом учете (УСН).
	ПустаяТаблица.Колонки.Добавить("СуммаВал", ОписаниеТипаСуммы);                // Сумма в валюте расчетов.
	ПустаяТаблица.Колонки.Добавить("СуммаРуб", ОписаниеТипаСуммы);                // Сумма в рублях, включая НДС.
	ПустаяТаблица.Колонки.Добавить("СуммаНеУчитываетсяНУРуб", ОписаниеТипаСуммы); // Сумма в рублях, не учитываемая при налогообложении.
	ПустаяТаблица.Колонки.Добавить("СуммаЕНВДРуб", ОписаниеТипаСуммы);            // Сумма в рублях, относящаяся к деятельности с особым порядком налогообложения (ЕНВД и пр.).
	ПустаяТаблица.Колонки.Добавить("СуммаНДСРуб", ОписаниеТипаСуммы);             // Сумма НДС в рублях.
	
	Возврат ПустаяТаблица;

КонецФункции

Функция ТаблицаЗачетАвансовПолученныхУСН(ТаблицаРасчетовСЗачетомАвансов, ТаблицыРеализации, Реквизиты, Отказ) Экспорт
	
	ТаблицаЗачетАвансовПолученныхУСН = ПустаяТаблицаЗачетАвансовПолученныхУСН();
	
	УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Реквизиты.Организация, Реквизиты.Дата);
	Если НЕ УчетнаяПолитика.ПрименяетсяУСН Тогда
		Возврат ТаблицаЗачетАвансовПолученныхУСН;
	КонецЕсли;
	Если Реквизиты.Свойство("СпособИсключенияНДСИзДоходовУСН") И Реквизиты.СпособИсключенияНДСИзДоходовУСН <> Перечисления.СпособыИсключенияНДСизДоходовУСН.Автоматически Тогда
		Возврат ТаблицаЗачетАвансовПолученныхУСН; // Ниже автоматический алгоритм (способ) исключения НДС из доходов УСН при зачете аванса полученного.
	КонецЕсли;
	
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	
	Для Каждого СтрокаРасчетов Из ТаблицаРасчетовСЗачетомАвансов Цикл
		
		Если НЕ (СтрокаРасчетов.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем
			И УчетУСНКлиентСервер.ВедетсяУчетУСНпоКФО(СтрокаРасчетов.КФО)
			И УчетРасчетов.ВедетсяУчетАвансовПолученных(СтрокаРасчетов.СчетРасчетов) ) Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаРасчетов.ЭтоЗачетАванса Тогда
			
			НоваяСтрока = ТаблицаЗачетАвансовПолученныхУСН.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРасчетов,
				"ИФО,КФО,КПС,Подразделение,СчетРасчетов,Контрагент,Договор,Валюта");
			НоваяСтрока.ДокументОплаты = СтрокаРасчетов.ДопСубконтоАвансов;
			НоваяСтрока.СуммаВал = СтрокаРасчетов.СуммаРасчетов;
			Если Реквизиты.ВидДеятельностиУСН = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсобыйПорядокНалогообложения Тогда
				НоваяСтрока.СуммаЕНВДРуб = СтрокаРасчетов.СуммаРубПоКурсуАванса;
			Иначе
				НоваяСтрока.СуммаРуб = СтрокаРасчетов.СуммаРубПоКурсуАванса;
			КонецЕсли;
			
			Если Реквизиты.ВидДеятельностиУСН = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсновнаяСистемаНалогообложения Тогда
				
				// Исключение НДС, расчет НДС в составе суммы зачтенного аванса полученного.
				
				СуммаДокумента    = 0; // Итоговая сумма документа.
				СуммаНДС          = 0; // в т.ч. НДС.
				СуммаЕНВД         = 0; // Реализация по деятельности с особым порядком налогообложения (ЕНВД и пр.).
				СуммаКомиссии     = 0; // Реализация по договорам комиссии.
				СуммаУСН          = 0; // Реализация по деятельности на УСН.
				
				Для Каждого ТаблицаРеализации Из ТаблицыРеализации Цикл
					
					ИмяТаблицы = ТаблицаРеализации.Ключ;
					Таблица    = ТаблицаРеализации.Значение;
					
					Отбор = Новый Структура("Контрагент, Договор",
						СтрокаРасчетов.Контрагент,
						СтрокаРасчетов.Договор);
					Отбор.Вставить("КФО", СтрокаРасчетов.КФО);
					Если Реквизиты.ИспользоватьУчетПоИФО Тогда
						Отбор.Вставить("ИФО", СтрокаРасчетов.ИФО);
					КонецЕсли;
					СвойстваСчетаРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаРасчетов.СчетРасчетов);
					Если СвойстваСчетаРасчетов.УчетПоКПС Тогда
						Отбор.Вставить("КПС", СтрокаРасчетов.КПС);
					КонецЕсли;
					Если Реквизиты.ИспользоватьУчетПоПодразделениям И СвойстваСчетаРасчетов.УчетПоПодразделениям Тогда
						Отбор.Вставить("Подразделение", СтрокаРасчетов.Подразделение);
					КонецЕсли;
					НайденныеСтрокиРеализации = Таблица.НайтиСтроки(Отбор);
					Для Каждого СтрокаТаблицы Из НайденныеСтрокиРеализации Цикл
						СуммаДокумента = СуммаДокумента + СтрокаТаблицы.СуммаРуб;
						СуммаНДС = СуммаНДС + СтрокаТаблицы.СуммаНДСРуб;
					КонецЦикла;
					
				КонецЦикла;
				
				СуммаУСН = СуммаДокумента - СуммаЕНВД - СуммаКомиссии;
				
				Если СуммаДокумента = 0 ИЛИ СтрокаРасчетов.СуммаРубПоКурсуАванса = 0 Тогда
					СуммаНДСЗачтено = 0;
				ИначеЕсли СтрокаРасчетов.СуммаРубПоКурсуАванса >= СуммаДокумента Тогда // Аванс зачтен на полную сумму документа реализации.
					СуммаНДСЗачтено = СуммаНДС;
				ИначеЕсли СтрокаРасчетов.СуммаРубПоКурсуАванса < СуммаДокумента Тогда // Частичный зачет аванса.
					КоэффициентНДС = СуммаНДС / СуммаДокумента;
					СуммаНДСЗачтено = Окр(СтрокаРасчетов.СуммаРубПоКурсуАванса * КоэффициентНДС, 2);
				КонецЕсли;
				
				СобственнаяВыручка = СуммаДокумента - СуммаКомиссии;
				ДоляСобственнойВыручкиУСН  = ?(СобственнаяВыручка = 0, 0, СуммаУСН / СобственнаяВыручка);
				ДоляСобственнойВыручкиЕНВД = ?(СобственнаяВыручка = 0, 0, СуммаЕНВД / СобственнаяВыручка);
				
				ИсключитьНДСИзДоходовУСН = Окр(СуммаНДСЗачтено * ДоляСобственнойВыручкиУСН, 2);
				Если ИсключитьНДСИзДоходовУСН <> 0 Тогда
					// НДС исключается из доходов УСН в обработчике УчетУСН.СкорректироватьПроводкиОтраженияДоходовРасходов.
					НоваяСтрока.СуммаНДСРуб = ИсключитьНДСИзДоходовУСН;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаЗачетАвансовПолученныхУСН;
	
КонецФункции

Функция ПустаяТаблицаПогашениеЗадолженностиПокупателейУСН() Экспорт

	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Идентификация строки.
	ПустаяТаблица.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	
	// Счет и аналитика учета расчетов с контрагентами (покупателями).
	ПустаяТаблица.Колонки.Добавить("СчетРасчетов",  Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("Контрагент",    Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ПустаяТаблица.Колонки.Добавить("Договор",       Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ПустаяТаблица.Колонки.Добавить("ДокументРасчетов", ПланыВидовХарактеристик.ВидыСубконто.ДокументыРасчетов.ТипЗначения);
	ПустаяТаблица.Колонки.Добавить("ДокументОплаты",   ПланыВидовХарактеристик.ВидыСубконто.ДокументыОплатыУСН.ТипЗначения);
	ПустаяТаблица.Колонки.Добавить("Валюта",        Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	
	// Суммы для отражения в налоговом учете (УСН).
	ПустаяТаблица.Колонки.Добавить("СуммаВал", ОписаниеТипаСуммы);                // Сумма в валюте расчетов.
	ПустаяТаблица.Колонки.Добавить("СуммаРуб", ОписаниеТипаСуммы);                // Сумма в рублях, включая НДС.
	ПустаяТаблица.Колонки.Добавить("СуммаНеУчитываетсяНУРуб", ОписаниеТипаСуммы); // Сумма в рублях, не учитываемая при налогообложении.
	ПустаяТаблица.Колонки.Добавить("СуммаЕНВДРуб", ОписаниеТипаСуммы);            // Сумма в рублях, относящаяся к деятельности с особым порядком налогообложения (ЕНВД и пр.).
	ПустаяТаблица.Колонки.Добавить("СуммаНДСРуб", ОписаниеТипаСуммы);             // Сумма НДС в рублях.
	ПустаяТаблица.Колонки.Добавить("КнигаПродажСуммаБезНДС", ОписаниеТипаСуммы);  // Сумма без НДС в рублях по данным регистра КнигаПродаж.
	ПустаяТаблица.Колонки.Добавить("КнигаПродажСуммаНДС", ОписаниеТипаСуммы);     // Сумма НДС в рублях по данным регистра КнигаПродаж.
	ПустаяТаблица.Колонки.Добавить("ИсключитьНДСИзДоходовУСН", ОписаниеТипаСуммы); // Сумма НДС в рублях к исключению из доходов УСН.
	
	Возврат ПустаяТаблица;

КонецФункции

Функция ТаблицаПогашениеЗадолженностиПокупателейУСН(ТаблицаРасчетовСПогашениемЗадолженности, Реквизиты, Отказ) Экспорт
	
	ТаблицаПогашениеЗадолженностиПокупателейУСН = ПустаяТаблицаПогашениеЗадолженностиПокупателейУСН();
	
	УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Реквизиты.Организация, Реквизиты.Дата);
	Если НЕ УчетнаяПолитика.ПрименяетсяУСН Тогда
		Возврат ТаблицаПогашениеЗадолженностиПокупателейУСН;
	КонецЕсли;
	Если Реквизиты.Свойство("УказатьВручнуюДоходыУСН") И Реквизиты.УказатьВручнуюДоходыУСН Тогда
		// В ручном режиме автоматический алгоритм исключения НДС из доходов УСН отключен,
		// т.к. сумма учитываемых доходов указывается пользователем уже за исключением НДС.
		Возврат ТаблицаПогашениеЗадолженностиПокупателейУСН;
	КонецЕсли;
	
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	Реквизиты.Вставить("ПлательщикЕНВД", Истина);
	
	// Получим остатки расчетов УСН (по документам расчетов) по счету УРД "Расчеты с дебиторами (покупателями, заказчиками)".
	ПериодОстатков = ?(Реквизиты.Свойство("ПериодОстатков"), Реквизиты.ПериодОстатков,
		УчетРасчетов.ПериодПолученияОстатков(Реквизиты, "Дата"));
	СчетДоходовУСН = БухгалтерскийУчет.СчетПоКоду("УД", ПериодОстатков, Реквизиты.Организация);
	СвойстваСчетаДоходовУСН = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетДоходовУСН);
	
	ОтборРасчетов = Новый Структура;
	ОтборРасчетов.Вставить("Субконто1", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
		ТаблицаРасчетовСПогашениемЗадолженности.ВыгрузитьКолонку("Контрагент")));
	ОтборРасчетов.Вставить("Субконто2", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
		ТаблицаРасчетовСПогашениемЗадолженности.ВыгрузитьКолонку("Договор")));
	ОтборРасчетов.Вставить("КФО", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
		ТаблицаРасчетовСПогашениемЗадолженности.ВыгрузитьКолонку("КФО")));
	Если Реквизиты.ИспользоватьУчетПоИФО Тогда
		ОтборРасчетов.Вставить("ИФО", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
			ТаблицаРасчетовСПогашениемЗадолженности.ВыгрузитьКолонку("ИФО")));
	КонецЕсли;
	
	ПериодОстатков = ?(Реквизиты.Свойство("ПериодОстатков"), Реквизиты.ПериодОстатков,
		УчетРасчетов.ПериодПолученияОстатков(Реквизиты.Ссылка));
	ОстаткиРасчетовУСН = ОстаткиПрочихРасчетовУСН(ПериодОстатков, СчетДоходовУСН, ОтборРасчетов, Реквизиты);
	ОбщегоНазначенияБГУ.УпорядочитьТаблицуПоДокументу(ОстаткиРасчетовУСН, "ДокументРасчетов", "ДатаДокументаРасчетов");
	ОстаткиРасчетовУСН.Индексы.Добавить("ДокументРасчетов");
	
	// Отражение дебетового оборота по счету УД при погашении задолженности.
	Для Каждого СтрокаРасчетов Из ТаблицаРасчетовСПогашениемЗадолженности Цикл
		
		Если НЕ (СтрокаРасчетов.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем
			И УчетУСНКлиентСервер.ВедетсяУчетУСНпоКФО(СтрокаРасчетов.КФО)
			И УчетРасчетов.ВедетсяУчетАвансовПолученных(СтрокаРасчетов.СчетРасчетов) ) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не СтрокаРасчетов.ЭтоАванс Тогда
			
			ОсталосьПогаситьСуммаРасчетов = СтрокаРасчетов.СуммаРасчетов;
			
			Отбор = Новый Структура("Субконто1, Субконто2",
				СтрокаРасчетов.Контрагент,
				СтрокаРасчетов.Договор);
			Отбор.Вставить("КФО", СтрокаРасчетов.КФО);
			Если Реквизиты.ИспользоватьУчетПоИФО Тогда
				Отбор.Вставить("ИФО", СтрокаРасчетов.ИФО);
			КонецЕсли;
			СвойстваСчетаРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаРасчетов.СчетРасчетов);
			Если СвойстваСчетаРасчетов.УчетПоКПС И СвойстваСчетаДоходовУСН.УчетПоКПС Тогда
				Отбор.Вставить("КПС", СтрокаРасчетов.КПС);
			КонецЕсли;
			Если Реквизиты.ИспользоватьУчетПоПодразделениям И СвойстваСчетаРасчетов.УчетПоПодразделениям И СвойстваСчетаДоходовУСН.УчетПоПодразделениям Тогда
				Отбор.Вставить("Подразделение", СтрокаРасчетов.Подразделение);
			КонецЕсли;
			НайденныеСтрокиРеализации = ОстаткиРасчетовУСН.НайтиСтроки(Отбор);
			Для Каждого СтрокаРеализации Из НайденныеСтрокиРеализации Цикл
				
				СуммаПогаситьВал = Мин(СтрокаРеализации.СуммаВал, ОсталосьПогаситьСуммаРасчетов);
				Если СуммаПогаситьВал <= 0 Тогда
					Продолжить;
				КонецЕсли;
				
				Коэффициент = СуммаПогаситьВал / СтрокаРеализации.СуммаВал;
				
				НоваяСтрока = ТаблицаПогашениеЗадолженностиПокупателейУСН.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРасчетов,
					"ИмяСписка,СинонимСписка,НомерСтроки,ИФО,КФО,КПС,Подразделение,СчетРасчетов,Контрагент,Договор,Валюта");
				НоваяСтрока.ДокументРасчетов = СтрокаРеализации.ДокументРасчетов;
				НоваяСтрока.ДокументОплаты = Реквизиты.Ссылка;
				НоваяСтрока.СуммаВал                = Окр(СтрокаРеализации.СуммаВал * Коэффициент, 2, 1);
				НоваяСтрока.СуммаРуб                = Окр(СтрокаРеализации.СуммаРуб * Коэффициент, 2, 1);
				НоваяСтрока.СуммаНеУчитываетсяНУРуб = Окр(СтрокаРеализации.СуммаНеУчитываетсяНУРуб * Коэффициент, 2, 1);
				НоваяСтрока.СуммаЕНВДРуб            = Окр(СтрокаРеализации.СуммаЕНВДРуб * Коэффициент, 2, 1);
				НоваяСтрока.СуммаНДСРуб             = Окр(СтрокаРеализации.СуммаНДСРуб * Коэффициент, 2, 1);
				
				НоваяСтрока.ИсключитьНДСИзДоходовУСН = НоваяСтрока.СуммаНДСРуб; // По данным документов начисления доходов (реализации товаров, работ, услуг).
				
				СтрокаРеализации.СуммаВал                = СтрокаРеализации.СуммаВал - НоваяСтрока.СуммаВал;
				СтрокаРеализации.СуммаРуб                = СтрокаРеализации.СуммаРуб - НоваяСтрока.СуммаРуб;
				СтрокаРеализации.СуммаНеУчитываетсяНУРуб = СтрокаРеализации.СуммаНеУчитываетсяНУРуб - НоваяСтрока.СуммаНеУчитываетсяНУРуб;
				СтрокаРеализации.СуммаЕНВДРуб            = СтрокаРеализации.СуммаЕНВДРуб - НоваяСтрока.СуммаЕНВДРуб;
				СтрокаРеализации.СуммаНДСРуб             = СтрокаРеализации.СуммаНДСРуб - НоваяСтрока.СуммаНДСРуб;
				
				ОсталосьПогаситьСуммаРасчетов = ОсталосьПогаситьСуммаРасчетов - СуммаПогаситьВал;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Добавляем данные счетов-фактур (книга продаж).
	Если УчетнаяПолитика.ИсключатьНДСИзДоходовУСНПоДаннымКнигиПродаж Тогда
		
		// Получим данные счетов-фактур по расчетным документам (по данным счета УД).
		ДокументыРасчетов = Новый Массив;
		Для Каждого СтрокаРасчетовУСН Из ОстаткиРасчетовУСН Цикл
			Если ЗначениеЗаполнено(СтрокаРасчетовУСН.ДокументРасчетов)
				И ДокументыРасчетов.Найти(СтрокаРасчетовУСН.ДокументРасчетов) = Неопределено Тогда
				ДокументыРасчетов.Добавить(СтрокаРасчетовУСН.ДокументРасчетов);
			КонецЕсли;
		КонецЦикла;
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ДокументыРасчетов", ДокументыРасчетов);
		Запрос.УстановитьПараметр("Организация", Реквизиты.Организация);
		Запрос.УстановитьПараметр("КонецПериода", КонецДня(Реквизиты.Дата));
		Запрос.Текст =
		"ВЫБРАТЬ
		|	КнигаПродажОбороты.СчетФактура.Контрагент КАК Контрагент,
		|	КнигаПродажОбороты.СчетФактура.Договор КАК Договор,
		|	КнигаПродажОбороты.СчетФактура.ДокументОснование КАК ДокументРасчетов,
		|	КнигаПродажОбороты.СуммаБезНДСОборот КАК СуммаБезНДС,
		|	КнигаПродажОбороты.СуммаНДСОборот КАК СуммаНДС
		|ИЗ
		|	РегистрНакопления.КнигаПродаж.Обороты(
		|			,
		|			&КонецПериода,
		|			,
		|			Организация = &Организация
		|				И ПричинаНалогообложения = ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.Реализация)
		|				И СчетФактура.ДокументОснование В (&ДокументыРасчетов)) КАК КнигаПродажОбороты";
		НДСПоРеализации = Запрос.Выполнить().Выгрузить();
		
		Для Каждого СтрокаНДСПоРеализации Из НДСПоРеализации Цикл
			ОбщегоНазначенияБГУ.РаспределитьСуммуПоСтрокамТаблицы(СтрокаНДСПоРеализации.СуммаБезНДС,
				ТаблицаПогашениеЗадолженностиПокупателейУСН, "КнигаПродажСуммаБезНДС", "СуммаВал");
			ОбщегоНазначенияБГУ.РаспределитьСуммуПоСтрокамТаблицы(СтрокаНДСПоРеализации.СуммаНДС,
				ТаблицаПогашениеЗадолженностиПокупателейУСН, "КнигаПродажСуммаНДС", "СуммаВал");
		КонецЦикла;
		
		Для Каждого СтрокаТаблицы Из ТаблицаПогашениеЗадолженностиПокупателейУСН Цикл
			
			СуммаДокумента    = СтрокаТаблицы.КнигаПродажСуммаБезНДС + СтрокаТаблицы.КнигаПродажСуммаНДС; // Итоговая сумма документа.
			СуммаНДС          = СтрокаТаблицы.КнигаПродажСуммаНДС; // в т.ч. НДС.
			СуммаЕНВД         = СтрокаТаблицы.СуммаЕНВДРуб; // Реализация по деятельности с особым порядком налогообложения (ЕНВД и пр.).
			СуммаКомиссии     = 0; // Реализация по договорам комиссии.
			СуммаУСН          = СуммаДокумента - СуммаЕНВД - СуммаКомиссии; // Реализация по деятельности на УСН.
			
			СуммаРуб = СтрокаТаблицы.СуммаРуб + СтрокаТаблицы.СуммаНДСРуб;
			Если СуммаДокумента = 0 ИЛИ СуммаРуб = 0 Тогда
				СуммаНДСЗачтено = 0;
			ИначеЕсли СуммаРуб >= СуммаДокумента Тогда // Задолженность погашена на полную сумму остатка по документу реализации.
				СуммаНДСЗачтено = СуммаНДС;
			ИначеЕсли СуммаРуб < СуммаДокумента Тогда // Частичное погашение задолженности.
				КоэффициентНДС = СуммаНДС / СуммаДокумента;
				СуммаНДСЗачтено = Окр(СуммаРуб * КоэффициентНДС, 2);
			КонецЕсли;
			
			СобственнаяВыручка = СуммаДокумента - СуммаКомиссии;
			ДоляСобственнойВыручкиУСН  = ?(СобственнаяВыручка = 0, 0, СуммаУСН / СобственнаяВыручка);
			ДоляСобственнойВыручкиЕНВД = ?(СобственнаяВыручка = 0, 0, СуммаЕНВД / СобственнаяВыручка);
			
			СтрокаТаблицы.ИсключитьНДСИзДоходовУСН = Мин(
				СтрокаТаблицы.ИсключитьНДСИзДоходовУСН, // Не превышает сумму НДС по документам начисления доходов.
				СтрокаТаблицы.СуммаНДСРуб, // Не превышает сумму по счету-фактуре.
				Окр(СуммаНДСЗачтено * ДоляСобственнойВыручкиУСН, 2) ); // По данным счетов-фактур и книги продаж.
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ТаблицаПогашениеЗадолженностиПокупателейУСН;
	
КонецФункции

#КонецОбласти

#Область ПрименяетсяУСНДоходыМинусРасходы

Процедура УстановитьУсловноеОформлениеОтражениеВУСН(Форма, ИмяТаблицы = "Материалы") Экспорт
	
	УсловноеОформление = Форма.УсловноеОформление.Элементы;
	
	Элемент = УсловноеОформление.Добавить();
	Элемент.Использование = Истина;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Элемент.Отбор,
		"Объект." + ИмяТаблицы + ".ОтражениеВУСН", Неопределено, ВидСравненияКомпоновкиДанных.НеЗаполнено);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст",      "<авто>");
	
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Поле = Новый ПолеКомпоновкиДанных(ИмяТаблицы + "ОтражениеВУСН");
	Поле.Использование = Истина;
	
КонецПроцедуры

Функция ОтражениеВУСНпоВидуЗатрат(ВидЗатрат) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ВидЗатрат) Тогда
		Возврат Перечисления.ОтражениеВУСН.НеПринимаются;
	КонецЕсли;
	
	Если ВидЗатрат.ВидДеятельностиДляНалоговогоУчетаЗатрат =
			Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсобыйПорядокНалогообложения Тогда
		Возврат Перечисления.ОтражениеВУСН.ОсобыйПорядок;
	ИначеЕсли ВидЗатрат.ВидДеятельностиДляНалоговогоУчетаЗатрат =
				Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.РаспределяемыеЗатраты Тогда
		Возврат Перечисления.ОтражениеВУСН.Распределяются;
	Иначе // ОсновнаяСистемаНалогообложения
		Если ВидЗатрат.ВидРасходовНУ = Перечисления.ВидыРасходовНУ.НеУчитываемыеВЦеляхНалогообложения Тогда
			Возврат Перечисления.ОтражениеВУСН.НеПринимаются;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Перечисления.ОтражениеВУСН.Принимаются;
	
КонецФункции

Функция ВидРасходовПоСчетуУчетаУСН(СчетУСН) Экспорт
	
	Если БухгалтерскийУчет.СчетВИерархии(СчетУСН, "У01") Тогда
		Возврат Перечисления.ВидыРасходовУСН.ОС;
	ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СчетУСН, "У04") Тогда
		Возврат Перечисления.ВидыРасходовУСН.НМА;
	ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СчетУСН, "У08") Тогда
		Возврат Перечисления.ВидыРасходовУСН.КапВложения;
	ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СчетУСН, "У10")
		ИЛИ   БухгалтерскийУчет.СчетВИерархии(СчетУСН, "У41") Тогда
		Возврат Перечисления.ВидыРасходовУСН.МатериальныеЗапасы;
	ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СчетУСН, "У15") Тогда
		Возврат Перечисления.ВидыРасходовУСН.ДопРасходы;
	ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СчетУСН, "У20") Тогда
		Возврат Перечисления.ВидыРасходовУСН.Услуги;
	ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СчетУСН, "У68") Тогда
		Возврат Перечисления.ВидыРасходовУСН.Налоги;
	ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СчетУСН, "У70") Тогда
		Возврат Перечисления.ВидыРасходовУСН.ОплатаТруда;
	КонецЕсли;
	
КонецФункции

Функция ЕстьПравоНаВычетНДС(УчетнаяПолитика)
	
	Если УчетнаяПолитика.НДСПрименяетсяОсвобождениеОтУплаты Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат УчетнаяПолитика.СтавкаНалогообложенияПриУСН <> Перечисления.ВидыСтавокНДС.ПониженнаяУСН И
			УчетнаяПолитика.СтавкаНалогообложенияПриУСН <> Перечисления.ВидыСтавокНДС.ОбщаяУСН;
	
КонецФункции

// Формирование элементов учета расходов (справочник "Расходы УСН")

Функция ПолучитьЭлементыУчетаРасходовУСН(ДокументПартии) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РасходыУСН.Ссылка КАК Ссылка,
	|	РасходыУСН.ПометкаУдаления КАК ПометкаУдаления,
	|	РасходыУСН.Наименование КАК Наименование,
	|	РасходыУСН.ВидРасхода КАК ВидРасхода,
	|	РасходыУСН.ЭлементРасхода КАК ЭлементРасхода,
	|	РасходыУСН.ОтражениеВУСН КАК ОтражениеВУСН,
	|	РасходыУСН.СчетРасчетов КАК СчетРасчетов,
	|	РасходыУСН.Контрагент КАК Контрагент,
	|	РасходыУСН.Договор КАК Договор,
	|	РасходыУСН.ДокументРасчетов КАК ДокументРасчетов,
	|	РасходыУСН.Партия КАК Партия,
	|	РасходыУСН.ИмяСпискаДокумента КАК ИмяСпискаДокумента,
	|	РасходыУСН.НомерСтрокиДокумента КАК НомерСтрокиДокумента,
	|	РасходыУСН.ВведенИзмененВручную КАК ВведенИзмененВручную
	|ИЗ
	|	Справочник.РасходыУСН КАК РасходыУСН
	|ГДЕ
	|	РасходыУСН.Партия = &ДокументПартии
	|
	|УПОРЯДОЧИТЬ ПО
	|	РасходыУСН.НомерСтрокиДокумента";
	Запрос.УстановитьПараметр("ДокументПартии", ДокументПартии);
	
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Процедура СформироватьЭлементыУчетаРасходовУСН(ДокументПартии, ТаблицаРасходовУСН) Экспорт
	
	Если ТаблицаРасходовУСН.Колонки.Найти("РасходыУСН") = Неопределено Тогда
		ТаблицаРасходовУСН.Колонки.Добавить("РасходыУСН", Новый ОписаниеТипов("СправочникСсылка.РасходыУСН"));
	КонецЕсли;
	
	// Поиск существующих элементов учета расходов УСН для данного документа партии.
	СуществующиеЭлементыУчетаРасходовУСН = ПолучитьЭлементыУчетаРасходовУСН(ДокументПартии);
	СуществующиеЭлементыУчетаРасходовУСН.Колонки.Добавить("Использован", Новый ОписаниеТипов("Булево"));
	
	Для Каждого СтрокаРасхода Из ТаблицаРасходовУСН Цикл
		
		СписокСвойств = "Партия,ИмяСпискаДокумента,НомерСтрокиДокумента,
			|ВидРасхода,ЭлементРасхода,ОтражениеВУСН,
			|СчетРасчетов,Контрагент,Договор,ДокументРасчетов";
		СвойстваРасходаУСН = Новый Структура(СписокСвойств);
		ЗаполнитьЗначенияСвойств(СвойстваРасходаУСН, СтрокаРасхода, СписокСвойств);
		
		Если СвойстваРасходаУСН.ВидРасхода = Перечисления.ВидыРасходовУСН.ОС
		 ИЛИ СвойстваРасходаУСН.ВидРасхода = Перечисления.ВидыРасходовУСН.НМА Тогда
			РеквизитыПоиска = "Партия, ИмяСпискаДокумента, НомерСтрокиДокумента, ВидРасхода, ЭлементРасхода, ДокументРасчетов";
		Иначе
			РеквизитыПоиска = "Партия, ИмяСпискаДокумента, НомерСтрокиДокумента, ВидРасхода, ЭлементРасхода";
		КонецЕсли;
		
		// Сформируем элементы справочника "Расходы УСН".
		Отбор = Новый Структура(РеквизитыПоиска);
		ЗаполнитьЗначенияСвойств(Отбор, СтрокаРасхода);
		Отбор.Вставить("ВведенИзмененВручную", Ложь);
		НайденныеЭлементы = СуществующиеЭлементыУчетаРасходовУСН.НайтиСтроки(Отбор);
		Если НайденныеЭлементы.Количество() > 0 Тогда
			
			ЭлементУчетаРасходовУСН = НайденныеЭлементы[0];
			ЭлементУчетаРасходовУСН.Использован = Истина;
			
			ЗаписатьЭлемент = Ложь;
			Для Каждого Свойство Из СвойстваРасходаУСН Цикл
				Если ЭлементУчетаРасходовУСН[Свойство.Ключ] <> Свойство.Значение Тогда
					ЗаписатьЭлемент = Истина;
					ЭлементРасходовОбъект = ЭлементУчетаРасходовУСН.Ссылка.ПолучитьОбъект();
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если ЭлементУчетаРасходовУСН.ПометкаУдаления Тогда
				ЗаписатьЭлемент = Истина;
				ЭлементРасходовОбъект = ЭлементУчетаРасходовУСН.Ссылка.ПолучитьОбъект();
			КонецЕсли;
			
		Иначе
			
			ЗаписатьЭлемент = Истина;
			ЭлементРасходовОбъект = Справочники.РасходыУСН.СоздатьЭлемент();
			
		КонецЕсли;
		
		// Записываем новые или обновляем существующие.
		Если ЗаписатьЭлемент Тогда
			
			ЭтоНовый = ЭлементРасходовОбъект.ЭтоНовый();
			
			ЗаполнитьЗначенияСвойств(ЭлементРасходовОбъект, СвойстваРасходаУСН);
			
			Попытка
				
				ЭлементРасходовОбъект.Наименование = Справочники.РасходыУСН.АвтоНаименованиеРасходаУСН(ЭлементРасходовОбъект);
				
				ЭлементРасходовОбъект.ПометкаУдаления = Ложь;
				ЭлементРасходовОбъект.Записать();
				ЭлементУчетаРасходовУСН = ЭлементРасходовОбъект.Ссылка;
				
			Исключение
				ВызватьИсключение "Ошибка при формировании элементов учета расходов УСН.
					|"+ ОписаниеОшибки();
			КонецПопытки;
			
			Если ЭтоНовый Тогда
				// Запишем в таблицу существующих.
				НовыйЭлементУчета = СуществующиеЭлементыУчетаРасходовУСН.Добавить();
				ЗаполнитьЗначенияСвойств(НовыйЭлементУчета, ЭлементУчетаРасходовУСН);
				НовыйЭлементУчета.Использован = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
		// Заполним информацию о расходах УСН в таблице.
		СтрокаРасхода.РасходыУСН = ЭлементУчетаРасходовУСН.Ссылка;
		
	КонецЦикла;
	
	// Пометка на удаление неиспользованных элементов справочника "Расходы УСН".
	НеиспользованныеЭлементы = СуществующиеЭлементыУчетаРасходовУСН.НайтиСтроки(
		Новый Структура("ПометкаУдаления, Использован", Ложь, Ложь));
	Для Каждого НеиспользованныйЭлемент Из НеиспользованныеЭлементы Цикл
		НеиспользованныйЭлементОбъект = НеиспользованныйЭлемент.Ссылка.ПолучитьОбъект();
		НеиспользованныйЭлементОбъект.ПометкаУдаления = Истина;
		Попытка
			НеиспользованныйЭлементОбъект.Записать();
		Исключение
			ВызватьИсключение "Ошибка при формировании элементов учета расходов УСН.
				|"+ ОписаниеОшибки();
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

// Поступление расходов УСН

Функция ПустаяТаблицаПоступлениеРасходовУСН() Экспорт

	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Идентификация строки.
	ПустаяТаблица.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	
	// Свойства расходов для формирования элементов справочника "Расходы УСН".
	МетаданныеРасходовУСН  = Метаданные.Справочники.РасходыУСН.Реквизиты;
	ПустаяТаблица.Колонки.Добавить("Партия",               МетаданныеРасходовУСН.Партия.Тип);
	ПустаяТаблица.Колонки.Добавить("ИмяСпискаДокумента",   МетаданныеРасходовУСН.ИмяСпискаДокумента.Тип);
	ПустаяТаблица.Колонки.Добавить("НомерСтрокиДокумента", МетаданныеРасходовУСН.НомерСтрокиДокумента.Тип);
	ПустаяТаблица.Колонки.Добавить("ВидРасхода",           МетаданныеРасходовУСН.ВидРасхода.Тип);
	ПустаяТаблица.Колонки.Добавить("ЭлементРасхода",       МетаданныеРасходовУСН.ЭлементРасхода.Тип);
	ПустаяТаблица.Колонки.Добавить("ОтражениеВУСН",        МетаданныеРасходовУСН.ОтражениеВУСН.Тип);
	ПустаяТаблица.Колонки.Добавить("СчетРасчетов",         МетаданныеРасходовУСН.СчетРасчетов.Тип);
	ПустаяТаблица.Колонки.Добавить("Контрагент",           МетаданныеРасходовУСН.Контрагент.Тип);
	ПустаяТаблица.Колонки.Добавить("Договор",              МетаданныеРасходовУСН.Договор.Тип);
	ПустаяТаблица.Колонки.Добавить("ДокументРасчетов",     МетаданныеРасходовУСН.ДокументРасчетов.Тип);
	
	ПустаяТаблица.Колонки.Добавить("Валюта", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	
	ОписаниеТипаСуммы       = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества  = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	ОписаниеТипаСубконто    = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	ОписаниеТипаВидСубконто = Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто");
	
	ПустаяТаблица.Колонки.Добавить("СчетУчетаУСН", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	
	// Элементы справочника "РасходыУСН" формируются "на лету" при подготовке таблицы поступления расходов.
	// Ссылки на сформированные элементы справочника сохраняются в колонках таблицы источника данных
	// для использования в проводках по счетам учета расходов УСН.
	ПустаяТаблица.Колонки.Добавить("РасходыУСН", Новый ОписаниеТипов("СправочникСсылка.РасходыУСН"));
	
	// Дополнительная аналитика учета расходов УСН.
	ПустаяТаблица.Колонки.Добавить("ВидСубконтоРасходов2",  ОписаниеТипаВидСубконто);
	ПустаяТаблица.Колонки.Добавить("СубконтоРасходов2",     ОписаниеТипаСубконто);
	ПустаяТаблица.Колонки.Добавить("ВидСубконтоРасходов3",  ОписаниеТипаВидСубконто);
	ПустаяТаблица.Колонки.Добавить("СубконтоРасходов3",     ОписаниеТипаСубконто);
	
	// Суммы поступивших расходов заполняются из соответствующих таблиц поступления (материалов, услуг и пр.).
	ПустаяТаблица.Колонки.Добавить("Количество",              ОписаниеТипаКоличества);
	ПустаяТаблица.Колонки.Добавить("СуммаВал",                ОписаниеТипаСуммы); // Сумма с НДС в валюте документа.
	ПустаяТаблица.Колонки.Добавить("СуммаРуб",                ОписаниеТипаСуммы); // Сумма с НДС в рублях.
	ПустаяТаблица.Колонки.Добавить("СуммаНДСВал",             ОписаниеТипаСуммы); // Сумма НДС в рублях.
	ПустаяТаблица.Колонки.Добавить("СуммаНДСРуб",             ОписаниеТипаСуммы); // Сумма НДС в рублях.
	ПустаяТаблица.Колонки.Добавить("СуммаНеУчитываетсяНУРуб", ОписаниеТипаСуммы); // Сумма с НДС в рублях.
	ПустаяТаблица.Колонки.Добавить("СуммаЕНВДРуб",            ОписаниеТипаСуммы); // Сумма с НДС в рублях.
	
	Возврат ПустаяТаблица;

КонецФункции

Функция ТаблицаПоступлениеРасходовУСН(ТаблицыПоступления, Реквизиты, Отказ) Экспорт
	
	ТаблицаРасходовУСН = ПустаяТаблицаПоступлениеРасходовУСН();
	
	УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Реквизиты.Организация, Реквизиты.Дата);
	Если НЕ УчетнаяПолитика.ПрименяетсяУСНДоходыМинусРасходы Тогда
		Возврат ТаблицаРасходовУСН;
	КонецЕсли;
	
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	
	// Параметры учетной политики в части учета расходов УСН.
	Реквизиты.Вставить("ТоварыПоОплате", УчетнаяПолитика.ПорядокПризнанияРасходовПоТоварам =
		Перечисления.ПорядокПризнанияРасходовПоТоварам.ПоОплатеПоставщику);
	Реквизиты.Вставить("ТоварыПоОтгрузке", УчетнаяПолитика.ПорядокПризнанияРасходовПоТоварам =
		Перечисления.ПорядокПризнанияРасходовПоТоварам.ПоФактуРеализации);
	Реквизиты.Вставить("МатериалыПоОплате", УчетнаяПолитика.ПорядокПризнанияМатериальныхРасходов =
		Перечисления.ПорядокПризнанияМатериальныхРасходов.ПоОплатеПоставщику);
	Реквизиты.Вставить("ДопРасходыПоОплате", УчетнаяПолитика.ПорядокПризнанияДопРасходов =
