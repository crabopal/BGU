	Реквизиты.Вставить("НДСПоОплате", УчетнаяПолитика.ПорядокПризнанияРасходовПоНДС =
		Перечисления.ПорядокПризнанияРасходовПоНДС.ПоОплатеПоставщику);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
