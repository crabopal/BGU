				НСтр("ru = '%1: оплата от контрагента ""%2""'"),
				ОписаниеДвиженияДенежныхСредств,
				Оплата.Контрагент);
		КонецЕсли;
		
	ИначеЕсли Оплата.ВидОперацииУСН = Перечисления.ВидыОперацийУСН.ВозвратПокупателю Тогда
		
		Если БухгалтерскийУчет.СчетВИерархии(Оплата.СчетБУ, "201.30") Тогда
			ОписаниеДвиженияДенежныхСредств = НСтр("ru = 'Выдача из кассы'");
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Оплата.СчетБУ, "201.20") Тогда
			ОписаниеДвиженияДенежныхСредств = НСтр("ru = 'Списание с р/с'");
