				И ЗначениеЗаполнено(Реквизиты.АвтоОтражениеВУСН) Тогда // Отражение в УСН определено типовой операцией.
				РасходУСН.ОтражениеВУСН = Реквизиты.АвтоОтражениеВУСН;
			ИначеЕсли ЗначениеЗаполнено(СтрокаДокумента.ВидЗатрат) Тогда // Отражение в УСН определим из вида затрат.
				РасходУСН.ОтражениеВУСН = УчетУСН.ОтражениеВУСНпоВидуЗатрат(СтрокаДокумента.ВидЗатрат);
			Иначе
				РасходУСН.ОтражениеВУСН = Перечисления.ОтражениеВУСН.НеПринимаются;
			КонецЕсли;
			
			Если Реквизиты.ДопРасходыПоОплате Тогда
				РасходУСН.СчетУчетаУСН = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У15.О");
			Иначе
				РасходУСН.СчетУчетаУСН = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У15.СО");
			КонецЕсли;
			
			РасходУСН.ВидСубконтоРасходов2 = ПланыВидовХарактеристик.ВидыСубконто.Номенклатура;
			РасходУСН.СубконтоРасходов2    = СтрокаДокумента.Номенклатура;
			РасходУСН.ВидСубконтоРасходов3 = ПланыВидовХарактеристик.ВидыСубконто.Партии;
			РасходУСН.СубконтоРасходов3    = СтрокаДокумента.ПартияВложений;
			
			Если РасходУСН.ОтражениеВУСН = Перечисления.ОтражениеВУСН.НеПринимаются Тогда
				РасходУСН.СуммаНеУчитываетсяНУРуб = СтрокаДокумента.СуммаРуб;
				РасходУСН.СуммаВал = СтрокаДокумента.СуммаВал;
				РасходУСН.СуммаНДСРуб = 0;
				РасходУСН.СуммаНДСВал = 0;
			ИначеЕсли РасходУСН.ОтражениеВУСН = Перечисления.ОтражениеВУСН.ОсобыйПорядок Тогда
				РасходУСН.СуммаЕНВДРуб = СтрокаДокумента.СуммаРуб;
				РасходУСН.СуммаВал = СтрокаДокумента.СуммаВал;
				РасходУСН.СуммаНДСРуб = 0;
				РасходУСН.СуммаНДСВал = 0;
			Иначе
				РасходУСН.СуммаРуб    = СтрокаДокумента.СуммаРуб - СтрокаДокумента.СуммаНДСРуб;
				РасходУСН.СуммаВал    = СтрокаДокумента.СуммаВал - СтрокаДокумента.СуммаНДСВал;
				РасходУСН.СуммаНДСРуб = СтрокаДокумента.СуммаНДСВал * РасходУСН.СуммаРуб / РасходУСН.СуммаВал;
				РасходУСН.СуммаНДСВал = СтрокаДокумента.СуммаНДСВал;
			КонецЕсли;
			
			Если Реквизиты.ЕстьПравоНаВычетНДС Тогда // НДС не учитывается в расходах УСН.
				РасходУСН.СуммаНеУчитываетсяНУРуб = РасходУСН.СуммаНеУчитываетсяНУРуб + РасходУСН.СуммаНДСРуб;
				РасходУСН.СуммаНДСРуб = 0;
			КонецЕсли;
			
			Если УчетРасчетов.УчетАгентскогоНДС(СтрокаДокумента.Договор) И СтрокаДокумента.СуммаНДСВал > 0 Тогда
				ДобавитьСтрокуАгентскийНДС(ТаблицаРасходовУСН, СтрокаДокумента, РасходУСН);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Вложения во внеоборотные активы.
	Если ТаблицыПоступления.Свойство("ВложенияВоВнеоборотныеАктивы")
	   И ТаблицыПоступления.ВложенияВоВнеоборотныеАктивы.Количество() > 0 Тогда
		
		Для Каждого СтрокаДокумента Из ТаблицыПоступления.ВложенияВоВнеоборотныеАктивы Цикл
			
			Если НЕ УчетУСНКлиентСервер.ВедетсяУчетУСНпоКФО(СтрокаДокумента.КФО) Тогда
				Продолжить;
			КонецЕсли;
			Если СтрокаДокумента.СуммаВал = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			РасходУСН = ТаблицаРасходовУСН.Добавить();
			ЗаполнитьЗначенияСвойств(РасходУСН, СтрокаДокумента,
				"ИмяСписка,СинонимСписка,НомерСтроки,ИФО,КФО,КПС,Подразделение,СчетРасчетов,Контрагент,Договор,Валюта");
			
			РасходУСН.ИмяСпискаДокумента   = СтрокаДокумента.ИмяСписка;
			РасходУСН.НомерСтрокиДокумента = СтрокаДокумента.НомерСтроки;
		
			Если БухгалтерскийУчет.СчетВИерархии(СтрокаДокумента.СчетВложений, "106.60") Тогда
				// Вложения в права пользования нематериальными активами.
				// Неисключительные права пользования на результаты интеллектуальной деятельности не относятся к НМА (п.3 ст. 257 НК РФ).
				РасходУСН.СчетУчетаУСН   = БухгалтерскийУчет.СчетПоКоду("У20.О", Реквизиты.Дата, Реквизиты.Организация);
				РасходУСН.ВидРасхода     = Перечисления.ВидыРасходовУСН.Услуги;
				РасходУСН.ЭлементРасхода = СтрокаДокумента.ВидЗатрат;
			Иначе
				// Расходы на приобретение ОС, НМА.
				РасходУСН.СчетУчетаУСН   = БухгалтерскийУчет.СчетПоКоду("У08.ПО", Реквизиты.Дата, Реквизиты.Организация);
				РасходУСН.ВидРасхода     = Перечисления.ВидыРасходовУСН.КапВложения;
				РасходУСН.ЭлементРасхода = СтрокаДокумента.ВидЗатрат;
			КонецЕсли;
			
			РасходУСН.ВидСубконтоРасходов2 = ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства;
			РасходУСН.СубконтоРасходов2    = СтрокаДокумента.ВнеоборотныйАктив;
			РасходУСН.ВидСубконтоРасходов3 = ПланыВидовХарактеристик.ВидыСубконто.ВидыЗатрат;
			РасходУСН.СубконтоРасходов3    = СтрокаДокумента.ВидЗатрат;
			
			Если Реквизиты.Свойство("АвтоОтражениеВУСН")
				И ЗначениеЗаполнено(Реквизиты.АвтоОтражениеВУСН) Тогда // Отражение в УСН определено типовой операцией.
				РасходУСН.ОтражениеВУСН = Реквизиты.АвтоОтражениеВУСН;
			ИначеЕсли ЗначениеЗаполнено(СтрокаДокумента.ВидЗатрат) Тогда // Отражение в УСН определим из вида затрат.
				РасходУСН.ОтражениеВУСН = УчетУСН.ОтражениеВУСНпоВидуЗатрат(СтрокаДокумента.ВидЗатрат);
			Иначе
				РасходУСН.ОтражениеВУСН = Перечисления.ОтражениеВУСН.НеПринимаются;
			КонецЕсли;
			
			Если РасходУСН.ОтражениеВУСН = Перечисления.ОтражениеВУСН.НеПринимаются Тогда
				РасходУСН.СуммаНеУчитываетсяНУРуб = СтрокаДокумента.СуммаРуб;
				РасходУСН.СуммаВал = СтрокаДокумента.СуммаВал;
				РасходУСН.СуммаНДСРуб = 0;
				РасходУСН.СуммаНДСВал = 0;
			ИначеЕсли РасходУСН.ОтражениеВУСН = Перечисления.ОтражениеВУСН.ОсобыйПорядок Тогда
				РасходУСН.СуммаЕНВДРуб = СтрокаДокумента.СуммаРуб;
				РасходУСН.СуммаВал = СтрокаДокумента.СуммаВал;
				РасходУСН.СуммаНДСРуб = 0;
				РасходУСН.СуммаНДСВал = 0;
			Иначе
				РасходУСН.СуммаРуб    = СтрокаДокумента.СуммаРуб - СтрокаДокумента.СуммаНДСРуб;
				РасходУСН.СуммаВал    = СтрокаДокумента.СуммаВал - СтрокаДокумента.СуммаНДСВал;
				РасходУСН.СуммаНДСРуб = СтрокаДокумента.СуммаНДСВал * РасходУСН.СуммаРуб / РасходУСН.СуммаВал;
				РасходУСН.СуммаНДСВал = СтрокаДокумента.СуммаНДСВал;
			КонецЕсли;
			
			Если Реквизиты.ЕстьПравоНаВычетНДС Тогда // НДС не учитывается в расходах УСН.
				РасходУСН.СуммаНеУчитываетсяНУРуб = РасходУСН.СуммаНеУчитываетсяНУРуб + РасходУСН.СуммаНДСРуб;
				РасходУСН.СуммаНДСРуб = 0;
			КонецЕсли;
			
			Если УчетРасчетов.УчетАгентскогоНДС(СтрокаДокумента.Договор) И СтрокаДокумента.СуммаНДСВал > 0 Тогда
				ДобавитьСтрокуАгентскийНДС(ТаблицаРасходовУСН, СтрокаДокумента, РасходУСН);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Поступление основных средств.
	Если ТаблицыПоступления.Свойство("ПоступлениеОсновныхСредств")
	   И ТаблицыПоступления.ПоступлениеОсновныхСредств.Количество() > 0 Тогда
		
		Для Каждого СтрокаДокумента Из ТаблицыПоступления.ПоступлениеОсновныхСредств Цикл
			
			Если НЕ УчетУСНКлиентСервер.ВедетсяУчетУСНпоКФО(СтрокаДокумента.КФО) Тогда
				Продолжить;
			КонецЕсли;
			Если СтрокаДокумента.СуммаВал = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			РасходУСН = ТаблицаРасходовУСН.Добавить();
			ЗаполнитьЗначенияСвойств(РасходУСН, СтрокаДокумента,
				"ИмяСписка,СинонимСписка,НомерСтроки,ИФО,КФО,КПС,Подразделение,СчетРасчетов,Контрагент,Договор,Валюта");
			
			РасходУСН.ИмяСпискаДокумента   = СтрокаДокумента.ИмяСписка;
			РасходУСН.НомерСтрокиДокумента = СтрокаДокумента.НомерСтроки;
			
			Если БухгалтерскийУчет.СчетВИерархии(СтрокаДокумента.СчетВложений, "106.60") Тогда
				// Вложения в права пользования нематериальными активами.
				// Неисключительные права пользования на результаты интеллектуальной деятельности не относятся к НМА (п.3 ст. 257 НК РФ).
				РасходУСН.СчетУчетаУСН   = БухгалтерскийУчет.СчетПоКоду("У20.О", Реквизиты.Дата, Реквизиты.Организация);
				РасходУСН.ВидРасхода     = Перечисления.ВидыРасходовУСН.Услуги;
				РасходУСН.ЭлементРасхода = СтрокаДокумента.ВидЗатрат;
			Иначе
				// Расходы на приобретение ОС, НМА.
				РасходУСН.СчетУчетаУСН   = БухгалтерскийУчет.СчетПоКоду("У08.ПО", Реквизиты.Дата, Реквизиты.Организация);
				РасходУСН.ВидРасхода     = Перечисления.ВидыРасходовУСН.КапВложения;
				РасходУСН.ЭлементРасхода = СтрокаДокумента.ВнеоборотныйАктив;
			КонецЕсли;
			
			РасходУСН.ВидСубконтоРасходов2 = ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства;
			РасходУСН.СубконтоРасходов2    = СтрокаДокумента.ВнеоборотныйАктив;
			РасходУСН.ВидСубконтоРасходов3 = ПланыВидовХарактеристик.ВидыСубконто.ВидыЗатрат;
			РасходУСН.СубконтоРасходов3    = СтрокаДокумента.ВидЗатрат;
			
			Если Реквизиты.Свойство("АвтоОтражениеВУСН")
				И ЗначениеЗаполнено(Реквизиты.АвтоОтражениеВУСН) Тогда // Отражение в УСН определено типовой операцией.
				РасходУСН.ОтражениеВУСН = Реквизиты.АвтоОтражениеВУСН;
			ИначеЕсли ЗначениеЗаполнено(СтрокаДокумента.ВидЗатрат) Тогда // Отражение в УСН определим из вида затрат.
				РасходУСН.ОтражениеВУСН = УчетУСН.ОтражениеВУСНпоВидуЗатрат(СтрокаДокумента.ВидЗатрат);
			Иначе
				РасходУСН.ОтражениеВУСН = Перечисления.ОтражениеВУСН.НеПринимаются;
			КонецЕсли;
			
			РасходУСН.Количество = СтрокаДокумента.Количество;
			
			Если РасходУСН.ОтражениеВУСН = Перечисления.ОтражениеВУСН.НеПринимаются Тогда
				РасходУСН.СуммаНеУчитываетсяНУРуб = СтрокаДокумента.СуммаРуб;
				РасходУСН.СуммаВал = СтрокаДокумента.СуммаВал;
				РасходУСН.СуммаНДСРуб = 0;
				РасходУСН.СуммаНДСВал = 0;
			ИначеЕсли РасходУСН.ОтражениеВУСН = Перечисления.ОтражениеВУСН.ОсобыйПорядок Тогда
				РасходУСН.СуммаЕНВДРуб = СтрокаДокумента.СуммаРуб;
				РасходУСН.СуммаВал = СтрокаДокумента.СуммаВал;
				РасходУСН.СуммаНДСРуб = 0;
				РасходУСН.СуммаНДСВал = 0;
			Иначе
				РасходУСН.СуммаРуб    = СтрокаДокумента.СуммаРуб - СтрокаДокумента.СуммаНДСРуб;
				РасходУСН.СуммаВал    = СтрокаДокумента.СуммаВал - СтрокаДокумента.СуммаНДСВал;
				РасходУСН.СуммаНДСРуб = СтрокаДокумента.СуммаНДСВал * РасходУСН.СуммаРуб / РасходУСН.СуммаВал;
				РасходУСН.СуммаНДСВал = СтрокаДокумента.СуммаНДСВал;
			КонецЕсли;
			
			Если Реквизиты.ЕстьПравоНаВычетНДС Тогда // НДС не учитывается в расходах УСН.
				РасходУСН.СуммаНеУчитываетсяНУРуб = РасходУСН.СуммаНеУчитываетсяНУРуб + РасходУСН.СуммаНДСРуб;
				РасходУСН.СуммаНДСРуб = 0;
			КонецЕсли;
			
			Если УчетРасчетов.УчетАгентскогоНДС(СтрокаДокумента.Договор) И СтрокаДокумента.СуммаНДСВал > 0 Тогда
				ДобавитьСтрокуАгентскийНДС(ТаблицаРасходовУСН, СтрокаДокумента, РасходУСН);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ТаблицаРасходовУСН.ЗаполнитьЗначения(Реквизиты.Ссылка, "Партия");
	ТаблицаРасходовУСН.ЗаполнитьЗначения(Реквизиты.Ссылка, "ДокументРасчетов");
	
	ТаблицаРасходовУСН.Сортировать("ИмяСпискаДокумента,НомерСтрокиДокумента");
	
	// Формируем элементы учета расходов УСН.
	СформироватьЭлементыУчетаРасходовУСН(Реквизиты.Ссылка, ТаблицаРасходовУСН);
	
	Возврат ТаблицаРасходовУСН;
	
КонецФункции

Процедура ДобавитьСтрокуАгентскийНДС(ТаблицаРасходовУСН, СтрокаДокумента, РасходУСН)
	
	// Агентский НДС учтем как отдельный расход,
	АгентскийНДС = ТаблицаРасходовУСН.Добавить();
	ЗаполнитьЗначенияСвойств(АгентскийНДС, СтрокаДокумента,
		"ИмяСписка,СинонимСписка,НомерСтроки,ИФО,КФО,КПС,Подразделение,Контрагент,Договор,Валюта");
	
	АгентскийНДС.ИмяСпискаДокумента   = СтрокаДокумента.ИмяСписка;
	АгентскийНДС.НомерСтрокиДокумента = СтрокаДокумента.НомерСтроки;

	АгентскийНДС.ВидРасхода     = Перечисления.ВидыРасходовУСН.Налоги;
	АгентскийНДС.ЭлементРасхода = Справочники.ВидыНалоговИПлатежей.НДС;
	АгентскийНДС.ОтражениеВУСН  = РасходУСН.ОтражениеВУСН;
	АгентскийНДС.СчетУчетаУСН   = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У68.О");
	
	АгентскийНДС.ВидСубконтоРасходов2 = ПланыВидовХарактеристик.ВидыСубконто.ВидыНалоговИПлатежей;
	АгентскийНДС.СубконтоРасходов2    = Справочники.ВидыНалоговИПлатежей.НДС;
	АгентскийНДС.СчетРасчетов         = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("УРН"); // 303.04
	
	АгентскийНДС.СуммаВал = СтрокаДокумента.СуммаНДСВал;
	
	// и уберем суммы НДС из расходов на приобретение материальных запасов, услуг и пр.
	Если АгентскийНДС.ОтражениеВУСН = Перечисления.ОтражениеВУСН.НеПринимаются Тогда
		
		АгентскийНДС.СуммаНеУчитываетсяНУРуб = СтрокаДокумента.СуммаНДСРуб;
		
		РасходУСН.СуммаНеУчитываетсяНУРуб = РасходУСН.СуммаНеУчитываетсяНУРуб - СтрокаДокумента.СуммаНДСРуб;
		РасходУСН.СуммаВал                = РасходУСН.СуммаВал - СтрокаДокумента.СуммаНДСВал;
		
	ИначеЕсли АгентскийНДС.ОтражениеВУСН = Перечисления.ОтражениеВУСН.ОсобыйПорядок Тогда
		
		АгентскийНДС.СуммаЕНВДРуб = СтрокаДокумента.СуммаНДСРуб;
		
		РасходУСН.СуммаЕНВДРуб    = РасходУСН.СуммаЕНВДРуб - СтрокаДокумента.СуммаНДСРуб;
		РасходУСН.СуммаВал        = РасходУСН.СуммаВал - СтрокаДокумента.СуммаНДСВал;
		
	Иначе
		
		АгентскийНДС.СуммаРуб = СтрокаДокумента.СуммаНДСРуб;
		
	КонецЕсли;
	
	РасходУСН.СуммаНДСВал = 0;
	РасходУСН.СуммаНДСРуб = 0;
	
КонецПроцедуры

// Ввод начальных остатков

Функция ПодготовитьТаблицыВводОстатковРасходовУСН(Документ, Параметры = Неопределено, Отказ) Экспорт
	
	ТаблицыПоступления = Новый Структура;
	ТаблицыПоступления.Вставить("ПоступлениеМатериальныхЗапасов",
		УправлениеМатериальнымиЗапасами.ПустаяТаблицаПоступлениеМатериальныхЗапасов());
	//ТаблицыПоступления.Вставить("ПоступлениеУслугРабот",          УчетРасчетов.ПустаяТаблицаПоступлениеУслугРабот());
	//ТаблицыПоступления.Вставить("ПоступлениеДопРасходов",         УчетРасчетов.ПустаяТаблицаПоступлениеДопРасходов());
	//ТаблицыПоступления.Вставить("ВложенияВоВнеоборотныеАктивы",   УправлениеОсновнымиСредствами.ПустаяТаблицаВложенияВоВнеоборотныеАктивы());
	
	// При вводе начальных остатков СчетУчетаУСН задан явно в табличной части документа.
	ТаблицыПоступления.ПоступлениеМатериальныхЗапасов.Колонки.Добавить("СчетУчетаУСН", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	
	ДатаСрезаУчетнойПолитики = КонецГода(Документ.Дата)+1;
	Если НЕ Документ.ОтражатьВНалоговомУчете
	 ИЛИ НЕ УчетУСНВызовСервера.ПрименяетсяУСНДоходыМинусРасходы(Документ.Организация, ДатаСрезаУчетнойПолитики) Тогда
		Возврат ТаблицыПоступления;
	КонецЕсли;
	
	Если Параметры = Неопределено Тогда
		Параметры = Новый Структура;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Если Документ.РазделУчета = Перечисления.РазделыУчетаДляВводаОстатков.Материалы Тогда
	
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Материалы",
			"НомерСтроки,ИФО,КФО,КПС,Подразделение,СчетРасчетов,КонтрагентРасчетов,ДоговорРасчетов,Валюта,
			|Счет,СчетУСН,Номенклатура,ЦМО,Количество,Сумма,СуммаНДС,ВалютнаяСумма,ВалютнаяСуммаНДС,ОтражениеВУСН",
			Документ, Параметры);
		
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	""Материалы"" КАК ИмяСписка,
		|	""Материалы"" КАК СинонимСписка,
		|	Материалы.НомерСтроки КАК НомерСтроки,
		|	Материалы.ИФО КАК ИФО,
		|	Материалы.КФО КАК КФО,
		|	Материалы.КПС КАК КПС,
		|	Материалы.Подразделение КАК Подразделение,
		|	Материалы.Счет.УчетПоПодразделениям КАК УчетПоПодразделениям,
		|	Материалы.Счет КАК СчетУчета,
		|	Материалы.СчетУСН КАК СчетУчетаУСН,
		|	Материалы.Номенклатура КАК Номенклатура,
		|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦМО) КАК ДопИзмерениеВидСубконто,
		|	Материалы.ЦМО КАК ДопИзмерение,
		|	Материалы.СчетРасчетов КАК СчетРасчетов,
		|	Материалы.КонтрагентРасчетов КАК Контрагент,
		|	Материалы.ДоговорРасчетов КАК Договор,
		|	Материалы.Валюта КАК Валюта,
		|	Материалы.Количество КАК Количество,
		|	Материалы.Сумма + Материалы.СуммаНДС КАК СуммаРуб,
		|	Материалы.СуммаНДС КАК СуммаНДСРуб,
		|	Материалы.ВалютнаяСумма + Материалы.ВалютнаяСуммаНДС КАК СуммаВал,
		|	Материалы.ВалютнаяСуммаНДС КАК СуммаНДСВал,
		|	Материалы.ОтражениеВУСН КАК ОтражениеВУСН
		|ИЗ
		|	ТаблицаМатериалы КАК Материалы
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
	
		ТаблицаМатериалы = Запрос.Выполнить().Выгрузить();
		Для Каждого Строка Из ТаблицаМатериалы Цикл
			
			Если НЕ УчетУСНКлиентСервер.ОтражатьВУСНДоходыМинусРасходы(Документ.Организация, ДатаСрезаУчетнойПолитики, Строка.КФО) Тогда
				Продолжить;
			КонецЕсли;
			
			// Материальные запасы.
			Если БухгалтерскийУчет.СчетВИерархии(Строка.СчетУчета, "105.00")
			И НЕ БухгалтерскийУчет.СчетВИерархии(Строка.СчетУчета, "105.Б8,105.Г8,105.29,105.39") Тогда
				
				Если НЕ ЗначениеЗаполнено(Строка.СчетУчетаУСН) Тогда
					ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
						НСтр("ru = 'Счет (УСН)'"), Строка.НомерСтроки, Строка.СинонимСписка);
					ПолеКолонки = "Объект." + Строка.ИмяСписка + "[" + Формат(Строка.НомерСтроки-1, "ЧН=0; ЧГ=") + "].СчетУСН";
					БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстСообщения, ПолеКолонки, Отказ);
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(Строка.ОтражениеВУСН) Тогда
					ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
						НСтр("ru = 'Расходы (УСН)'"), Строка.НомерСтроки, Строка.СинонимСписка);
					ПолеКолонки = "Объект." + Строка.ИмяСписка + "[" + Формат(Строка.НомерСтроки-1, "ЧН=0; ЧГ=") + "].ОтражениеВУСН";
					БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстСообщения, ПолеКолонки, Отказ);
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(Строка.СчетРасчетов) Тогда
					ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
						НСтр("ru = 'Счет расчетов (УСН)'"), Строка.НомерСтроки, Строка.СинонимСписка);
					ПолеКолонки = "Объект." + Строка.ИмяСписка + "[" + Формат(Строка.НомерСтроки-1, "ЧН=0; ЧГ=") + "].СчетРасчетов";
					БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстСообщения, ПолеКолонки, Отказ);
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(Строка.Контрагент) Тогда
					ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
						НСтр("ru = 'Контрагент (УСН)'"), Строка.НомерСтроки, Строка.СинонимСписка);
					ПолеКолонки = "Объект." + Строка.ИмяСписка + "[" + Формат(Строка.НомерСтроки-1, "ЧН=0; ЧГ=") + "].КонтрагентРасчетов";
					БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстСообщения, ПолеКолонки, Отказ);
				КонецЕсли;
				
				Если БухгалтерскийУчетПовтИсп.НаСчетеВедетсяУчетПоДоговорам(Строка.СчетРасчетов)
				   И НЕ ЗначениеЗаполнено(Строка.Договор) Тогда
					ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
						НСтр("ru = 'Договор (УСН)'"), Строка.НомерСтроки, Строка.СинонимСписка);
					ПолеКолонки = "Объект." + Строка.ИмяСписка + "[" + Формат(Строка.НомерСтроки-1, "ЧН=0; ЧГ=") + "].ДоговорРасчетов";
					БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстСообщения, ПолеКолонки, Отказ);
				КонецЕсли;
				
				НоваяСтрока = ТаблицыПоступления.ПоступлениеМатериальныхЗапасов.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
				
				Если Не ЗначениеЗаполнено(Строка.Валюта) Тогда
					НоваяСтрока.Валюта = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета();
					НоваяСтрока.СуммаВал    = НоваяСтрока.СуммаРуб;
					НоваяСтрока.СуммаНДСВал = НоваяСтрока.СуммаНДСРуб;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ТаблицыПоступления;
	
КонецФункции

Функция ТаблицаВводОстатковРасходовУСН(ТаблицыПоступления, Реквизиты, Отказ) Экспорт
	
	ТаблицаРасходовУСН = ПустаяТаблицаПоступлениеРасходовУСН();
	
	// Материальные запасы.
	Если ТаблицыПоступления.Свойство("ПоступлениеМатериальныхЗапасов")
	   И ТаблицыПоступления.ПоступлениеМатериальныхЗапасов.Количество() > 0 Тогда
		
		Для Каждого СтрокаДокумента Из ТаблицыПоступления.ПоступлениеМатериальныхЗапасов Цикл
			
			РасходУСН = ТаблицаРасходовУСН.Добавить();
			ЗаполнитьЗначенияСвойств(РасходУСН, СтрокаДокумента,
				"ИмяСписка,СинонимСписка,НомерСтроки,ИФО,КФО,КПС,Подразделение,СчетРасчетов,Контрагент,Договор,Валюта");
			
			РасходУСН.ИмяСпискаДокумента   = СтрокаДокумента.ИмяСписка;
			РасходУСН.НомерСтрокиДокумента = СтрокаДокумента.НомерСтроки;
		
			РасходУСН.ВидРасхода     = Перечисления.ВидыРасходовУСН.МатериальныеЗапасы;
			РасходУСН.ЭлементРасхода = СтрокаДокумента.Номенклатура;
			
			Если ЗначениеЗаполнено(СтрокаДокумента.ОтражениеВУСН) Тогда
				РасходУСН.ОтражениеВУСН = СтрокаДокумента.ОтражениеВУСН;
			Иначе
				РасходУСН.ОтражениеВУСН = Перечисления.ОтражениеВУСН.НеПринимаются;
			КонецЕсли;
			
			РасходУСН.СчетУчетаУСН         = СтрокаДокумента.СчетУчетаУСН;
			РасходУСН.ВидСубконтоРасходов2 = ПланыВидовХарактеристик.ВидыСубконто.Номенклатура;
			РасходУСН.СубконтоРасходов2    = СтрокаДокумента.Номенклатура;
			
			РасходУСН.Количество  = СтрокаДокумента.Количество;
			
			Если РасходУСН.ОтражениеВУСН = Перечисления.ОтражениеВУСН.НеПринимаются Тогда
				РасходУСН.СуммаНеУчитываетсяНУРуб = СтрокаДокумента.СуммаРуб;
				РасходУСН.СуммаВал = СтрокаДокумента.СуммаВал;
				РасходУСН.СуммаНДСРуб = 0;
				РасходУСН.СуммаНДСВал = 0;
			ИначеЕсли РасходУСН.ОтражениеВУСН = Перечисления.ОтражениеВУСН.ОсобыйПорядок Тогда
				РасходУСН.СуммаЕНВДРуб = СтрокаДокумента.СуммаРуб;
				РасходУСН.СуммаВал = СтрокаДокумента.СуммаВал;
				РасходУСН.СуммаНДСРуб = 0;
				РасходУСН.СуммаНДСВал = 0;
			Иначе
				РасходУСН.СуммаРуб    = СтрокаДокумента.СуммаРуб - СтрокаДокумента.СуммаНДСРуб;
				РасходУСН.СуммаВал    = СтрокаДокумента.СуммаВал - СтрокаДокумента.СуммаНДСВал;
				РасходУСН.СуммаНДСРуб = СтрокаДокумента.СуммаНДСВал * РасходУСН.СуммаРуб / РасходУСН.СуммаВал;
				РасходУСН.СуммаНДСВал = СтрокаДокумента.СуммаНДСВал;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ТаблицаРасходовУСН.ЗаполнитьЗначения(Реквизиты.Ссылка, "Партия");
	ТаблицаРасходовУСН.ЗаполнитьЗначения(Реквизиты.Ссылка, "ДокументРасчетов");
	
	ТаблицаРасходовУСН.Сортировать("ИмяСпискаДокумента,НомерСтрокиДокумента");
	
	// Формируем элементы учета расходов УСН.
	СформироватьЭлементыУчетаРасходовУСН(Реквизиты.Ссылка, ТаблицаРасходовУСН);
	
	Возврат ТаблицаРасходовУСН;
	
КонецФункции

// Эквайринговая операция

Функция ПодготовитьТаблицыРасходовПоЭквайринговойОперации(Документ, Параметры = Неопределено, Отказ) Экспорт
	
	ТаблицыПоступления = Новый Структура;
	ТаблицыПоступления.Вставить("ПоступлениеУслугРабот", УчетРасчетов.ПустаяТаблицаПоступлениеУслугРабот());
	
	Если НЕ УчетУСНВызовСервера.ПрименяетсяУСНДоходыМинусРасходы(Документ.Организация, Документ.Дата) Тогда
		Возврат ТаблицыПоступления;
	КонецЕсли;
	
	Если Параметры = Неопределено Тогда
		Параметры = Новый Структура;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Документ",
		"ИФО,КФО,КПСУчетаЗатрат,Подразделение,Эквайер,ДоговорЭквайринга,ОтражениеВУСН,СуммаКомиссииБанка",
		Документ, Параметры);
	
	Запрос.Текст = Запрос.Текст +
	"ВЫБРАТЬ
	|	ЭквайринговаяОперация.ИФО КАК ИФО,
	|	ЭквайринговаяОперация.КФО КАК КФО,
	|	ЭквайринговаяОперация.КПСУчетаЗатрат КАК КПС,
	|	ЭквайринговаяОперация.Подразделение КАК Подразделение,
	|	ЭквайринговаяОперация.Эквайер КАК Контрагент,
	|	ЭквайринговаяОперация.ДоговорЭквайринга КАК Договор,
	|	ЭквайринговаяОперация.ОтражениеВУСН КАК ОтражениеВУСН,
	|	ЭквайринговаяОперация.СуммаКомиссииБанка КАК Сумма
	|ИЗ
	|	Документ КАК ЭквайринговаяОперация
	|ГДЕ
	|	ЭквайринговаяОперация.СуммаКомиссииБанка > 0";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		// Определим вид затрат.
		ВидЗатрат = Справочники.ВидыЗатрат.ПустаяСсылка();
		
		СвойстваСчетаЗатрат = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Документ.СчетУчетаЗатрат);
		Для НомерСубконто = 1 По СвойстваСчетаЗатрат.КоличествоСубконто Цикл
			
			ВидСубконто = СвойстваСчетаЗатрат["ВидСубконто" + НомерСубконто];
			Если ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ВидыЗатрат Тогда
				ВидЗатрат = Документ["СубконтоЗатрат" + НомерСубконто];
			КонецЕсли;
			
		КонецЦикла;
		
		// Заполним информацию о расходах на комиссию эквайера.
		НоваяСтрока = ТаблицыПоступления.ПоступлениеУслугРабот.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка,
			"ИФО,КФО,КПС,Подразделение,Контрагент,Договор,ОтражениеВУСН");
		
		НоваяСтрока.Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
		НоваяСтрока.ВидЗатрат    = ВидЗатрат;
		НоваяСтрока.Содержание   = "Комиссия эквайера";
		
		СчетРасчетов = УчетРасчетов.ОпределитьСчетРасчетовПоПараметрам(Параметры, "Поступление",
			Документ.Дата, Документ.Организация, Документ.ИФО);
		Если ЗначениеЗаполнено(СчетРасчетов) Тогда
			НоваяСтрока.СчетРасчетов = СчетРасчетов;
		Иначе
			НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.СчетПоКоду("302.26", Документ.Дата, Документ.Организация);
		КонецЕсли;
		
		НоваяСтрока.Валюта   = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета();
		НоваяСтрока.СуммаВал = Выборка.Сумма;
		НоваяСтрока.СуммаРуб = Выборка.Сумма;
		
	КонецЕсли;
	
	Возврат ТаблицыПоступления;
	
КонецФункции

// Авансовый отчет, Отчет о расходах подотчетного лица

Функция ПодготовитьТаблицыРасходовПоАвансовомуОтчету(Документ, Параметры = Неопределено) Экспорт
	
	ТаблицыПоступления = Новый Структура;
	ТаблицыПоступления.Вставить("ПоступлениеМатериальныхЗапасов", УправлениеМатериальнымиЗапасами.ПустаяТаблицаПоступлениеМатериальныхЗапасов());
	ТаблицыПоступления.Вставить("ПоступлениеВозвратнойТары",      УправлениеМатериальнымиЗапасами.ПустаяТаблицаПоступлениеВозвратнойТары());
	ТаблицыПоступления.Вставить("ПоступлениеУслугРабот",          УчетРасчетов.ПустаяТаблицаПоступлениеУслугРабот());
	ТаблицыПоступления.Вставить("ПоступлениеДопРасходов",         УчетРасчетов.ПустаяТаблицаПоступлениеДопРасходов());
	ТаблицыПоступления.Вставить("ВложенияВоВнеоборотныеАктивы",   УправлениеОсновнымиСредствами.ПустаяТаблицаВложенияВоВнеоборотныеАктивы());
	ТаблицыПоступления.Вставить("ПоступлениеОсновныхСредств",     УправлениеОсновнымиСредствами.ПустаяТаблицаПоступлениеОсновныхСредств());
	
	Если НЕ УчетУСНВызовСервера.ПрименяетсяУСНДоходыМинусРасходы(Документ.Организация, Документ.Дата) Тогда
		Возврат ТаблицыПоступления;
	КонецЕсли;
	
	Если Параметры = Неопределено Тогда
		Параметры = Новый Структура;
	КонецЕсли;
	
	КурсДокумента = Документ.Курс / ?(Документ.Кратность = 0, 1, Документ.Кратность);
	
	Запрос = Новый Запрос;
	
	ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Израсходовано",
		"НомерСтроки,ИФО,КФО,КПС,КЭК,Подразделение,ПоДокументу,СчетДебета,СубконтоДебета1,СубконтоДебета2,СубконтоДебета3,
		|СчетКредита,КомуЗаЧто,ОтражениеВУСН,ВалютаДокумента,Количество,СтавкаНДС,СуммаНДС,Сумма,СуммаВВалюте",
		Документ, Параметры);
	
	Запрос.Текст = Запрос.Текст +
	"ВЫБРАТЬ
	|	""Израсходовано"" КАК ИмяСписка,
	|	""Израсходовано"" КАК СинонимСписка,
	|	Израсходовано.НомерСтроки КАК НомерСтроки,
	|	Израсходовано.ИФО КАК ИФО,
	|	Израсходовано.КФО КАК КФО,
	|	Израсходовано.КПС КАК КПС,
	|	Израсходовано.КЭК КАК КЭК,
	|	Израсходовано.Подразделение КАК Подразделение,
	|	Израсходовано.СчетДебета КАК СчетДебета,
	|	Израсходовано.СубконтоДебета1 КАК СубконтоДебета1,
	|	Израсходовано.СубконтоДебета2 КАК СубконтоДебета2,
	|	Израсходовано.СубконтоДебета3 КАК СубконтоДебета3,
	|	Израсходовано.СчетКредита КАК СчетКредита,
	|	Израсходовано.КомуЗаЧто КАК КомуЗаЧто,
	|	Израсходовано.ОтражениеВУСН КАК ОтражениеВУСН,
	|	Израсходовано.ВалютаДокумента КАК Валюта,
	|	Израсходовано.Количество КАК Количество,
	|	Израсходовано.СтавкаНДС КАК СтавкаНДС,
	|	Израсходовано.СуммаНДС КАК СуммаНДС,
	|	Израсходовано.Сумма КАК Сумма,
	|	Израсходовано.СуммаВВалюте КАК СуммаВВалюте
	|ИЗ
	|	ТаблицаИзрасходовано КАК Израсходовано
	|ГДЕ
	|	НЕ Израсходовано.ПоДокументу
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	ТаблицаИзрасходовано = Запрос.Выполнить().Выгрузить();
	Для Каждого Строка Из ТаблицаИзрасходовано Цикл
		
		Если НЕ УчетУСНКлиентСервер.ОтражатьВУСНДоходыМинусРасходы(Документ.Организация, Документ.Дата, Строка.КФО) Тогда
			Продолжить;
		КонецЕсли;
		Если БухгалтерскийУчет.СчетВИерархии(Строка.СчетДебета, "206.00,302.00") Тогда
			Продолжить; // Расчеты с контрагентами пропускаем, не возникает расходов УСН.
		КонецЕсли;
		
		// ПоступлениеМатериальныхЗапасов, ПоступлениеВозвратнойТары.
		Если БухгалтерскийУчет.СчетВИерархии(Строка.СчетДебета, "105.00") Тогда
			
			Номенклатура            = Справочники.Номенклатура.ПустаяСсылка();
			ЦМО                     = Справочники.ЦМО.ПустаяСсылка();
			ДопАналитика            = Неопределено;
			ДопАналитикаВидСубконто = Неопределено;
			
			СвойстваСчетаДебета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Строка.СчетДебета);
			Для НомерСубконто = 1 По СвойстваСчетаДебета.КоличествоСубконто Цикл
				
				ВидСубконто = СвойстваСчетаДебета["ВидСубконто" + НомерСубконто];
				Если ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Номенклатура Тогда
					Номенклатура = Строка["СубконтоДебета" + НомерСубконто];
				ИначеЕсли ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ЦМО Тогда
					ЦМО = Строка["СубконтоДебета" + НомерСубконто];
				Иначе
					ДопАналитикаВидСубконто = ВидСубконто;
					ДопАналитика = Строка["СубконтоДебета" + НомерСубконто];
				КонецЕсли;
				
			КонецЦикла;
			
			Если Не ЗначениеЗаполнено(Номенклатура) Тогда
				Продолжить;
			КонецЕсли;
			
			ЭтоТара = (Номенклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Тара);
			
			Если Строка.Сумма > 0 Тогда
				
				Если ЭтоТара Тогда
					НоваяСтрока = ТаблицыПоступления.ПоступлениеВозвратнойТары.Добавить();
				Иначе
					НоваяСтрока = ТаблицыПоступления.ПоступлениеМатериальныхЗапасов.Добавить();
				КонецЕсли;
				
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка,
					"ИмяСписка,СинонимСписка,НомерСтроки,ИФО,КФО,КПС,Подразделение");
				
				НоваяСтрока.СчетУчета    = Строка.СчетДебета;
				НоваяСтрока.Номенклатура = Номенклатура;
				
				Если ЗначениеЗаполнено(ЦМО) Тогда
					НоваяСтрока.ДопИзмерениеВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ЦМО;
					НоваяСтрока.ДопИзмерение            = ЦМО;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ДопАналитикаВидСубконто) И ЗначениеЗаполнено(ДопАналитика) Тогда
					НоваяСтрока.ДопАналитикаВидСубконто = ДопАналитикаВидСубконто;
					НоваяСтрока.ДопАналитика            = ДопАналитика;
				КонецЕсли;
				
				НоваяСтрока.СчетРасчетов = Строка.СчетКредита;
				НоваяСтрока.Контрагент   = Документ.Сотрудник.Контрагент;
				НоваяСтрока.Валюта       = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета();
				
				НоваяСтрока.Количество = Строка.Количество;
				
				Если НЕ ЭтоТара Тогда
					НоваяСтрока.СтавкаНДС     = Строка.СтавкаНДС;
					НоваяСтрока.СуммаНДСВал   = Строка.СуммаНДС;
					НоваяСтрока.СуммаНДСРуб   = Строка.СуммаНДС;
					НоваяСтрока.ОтражениеВУСН = Строка.ОтражениеВУСН;
				КонецЕсли;
				
				НоваяСтрока.СуммаВал = Строка.Сумма;
				НоваяСтрока.СуммаРуб = Строка.Сумма;
				
			КонецЕсли;
			
			Если Строка.СуммаВВалюте > 0 Тогда
				
				Если ЭтоТара Тогда
					НоваяСтрока = ТаблицыПоступления.ПоступлениеВозвратнойТары.Добавить();
				Иначе
					НоваяСтрока = ТаблицыПоступления.ПоступлениеМатериальныхЗапасов.Добавить();
				КонецЕсли;
				
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка,
					"ИмяСписка,СинонимСписка,НомерСтроки,ИФО,КФО,КПС,Подразделение");
				
				НоваяСтрока.СчетУчета    = Строка.СчетДебета;
				НоваяСтрока.Номенклатура = Номенклатура;
				
				Если ЗначениеЗаполнено(ЦМО) Тогда
					НоваяСтрока.ДопИзмерениеВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ЦМО;
					НоваяСтрока.ДопИзмерение            = ЦМО;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ДопАналитикаВидСубконто) И ЗначениеЗаполнено(ДопАналитика) Тогда
					НоваяСтрока.ДопАналитикаВидСубконто = ДопАналитикаВидСубконто;
					НоваяСтрока.ДопАналитика            = ДопАналитика;
				КонецЕсли;
				
				НоваяСтрока.СчетРасчетов = Строка.СчетКредита;
				НоваяСтрока.Контрагент   = Документ.Сотрудник.Контрагент;
				НоваяСтрока.Валюта       = Строка.Валюта;
				
				НоваяСтрока.Количество = Строка.Количество;
				
				Если НЕ ЭтоТара Тогда
					НоваяСтрока.СтавкаНДС     = Строка.СтавкаНДС;
					НоваяСтрока.СуммаНДСВал   = Строка.СуммаНДС;
					НоваяСтрока.СуммаНДСРуб   = Строка.СуммаНДС * КурсДокумента;
					НоваяСтрока.ОтражениеВУСН = Строка.ОтражениеВУСН;
				КонецЕсли;
				
				НоваяСтрока.СуммаВал = Строка.СуммаВВалюте;
				НоваяСтрока.СуммаРуб = Строка.СуммаВВалюте * КурсДокумента;
				
			КонецЕсли;
			
		// ПоступлениеДопРасходов.
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Строка.СчетДебета, "106.2П,106.3П,106.4П") Тогда
			
			Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
			ВидЗатрат    = Справочники.ВидыЗатрат.ПустаяСсылка();
			Партия       = Неопределено;
			
			СвойстваСчетаДебета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Строка.СчетДебета);
			Для НомерСубконто = 1 По СвойстваСчетаДебета.КоличествоСубконто Цикл
				
				ВидСубконто = СвойстваСчетаДебета["ВидСубконто" + НомерСубконто];
				Если ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Номенклатура Тогда
					Номенклатура = Строка["СубконтоДебета" + НомерСубконто];
				ИначеЕсли ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ВидыЗатрат Тогда
					ВидЗатрат = Строка["СубконтоДебета" + НомерСубконто];
				ИначеЕсли ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Партии Тогда
					Партия = Строка["СубконтоДебета" + НомерСубконто];
				КонецЕсли;
				
			КонецЦикла;
			
			Если Не ЗначениеЗаполнено(ВидЗатрат) ИЛИ Не ЗначениеЗаполнено(Номенклатура) Тогда
				Продолжить;
			КонецЕсли;
			
			Если Строка.Сумма > 0 Тогда
				
				НоваяСтрока = ТаблицыПоступления.ПоступлениеДопРасходов.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка,
					"ИмяСписка,СинонимСписка,НомерСтроки,ИФО,КФО,КПС,Подразделение");
				
				НоваяСтрока.Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
				НоваяСтрока.Содержание   = Строка.КомуЗаЧто;
				НоваяСтрока.КЭК          = Строка.КЭК;
				НоваяСтрока.ВидЗатрат    = ВидЗатрат;
				
				НоваяСтрока.СчетВложений          = Строка.СчетДебета;
				НоваяСтрока.ПартияВложений        = Партия;
				НоваяСтрока.КПСВложений           = Строка.КПС;
				НоваяСтрока.ПодразделениеВложений = Строка.Подразделение;
				НоваяСтрока.НоменклатураВложений  = Номенклатура;
				
				НоваяСтрока.СчетРасчетов = Строка.СчетКредита;
				НоваяСтрока.Контрагент   = Документ.Сотрудник.Контрагент;
				НоваяСтрока.Валюта       = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета();
				
				НоваяСтрока.Количество  = Строка.Количество;
				НоваяСтрока.СтавкаНДС   = Строка.СтавкаНДС;
				НоваяСтрока.СуммаНДСВал = Строка.СуммаНДС;
				НоваяСтрока.СуммаНДСРуб = Строка.СуммаНДС;
				НоваяСтрока.СуммаВал    = Строка.Сумма;
				НоваяСтрока.СуммаРуб    = Строка.Сумма;
				
			КонецЕсли;
			
			Если Строка.СуммаВВалюте > 0 Тогда
				
				НоваяСтрока = ТаблицыПоступления.ПоступлениеДопРасходов.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка,
					"ИмяСписка,СинонимСписка,НомерСтроки,ИФО,КФО,КПС,Подразделение");
				
				НоваяСтрока.Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
				НоваяСтрока.Содержание   = Строка.КомуЗаЧто;
				НоваяСтрока.КЭК          = Строка.КЭК;
				НоваяСтрока.ВидЗатрат    = ВидЗатрат;
				
				НоваяСтрока.СчетВложений          = Строка.СчетДебета;
				НоваяСтрока.ПартияВложений        = Партия;
				НоваяСтрока.КПСВложений           = Строка.КПС;
				НоваяСтрока.ПодразделениеВложений = Строка.Подразделение;
				НоваяСтрока.НоменклатураВложений  = Номенклатура;
				
				НоваяСтрока.СчетРасчетов = Строка.СчетКредита;
				НоваяСтрока.Контрагент   = Документ.Сотрудник.Контрагент;
				НоваяСтрока.Валюта       = Строка.Валюта;
				
				НоваяСтрока.Количество  = Строка.Количество;
				НоваяСтрока.СтавкаНДС   = Строка.СтавкаНДС;
				НоваяСтрока.СуммаНДСВал = Строка.СуммаНДС;
				НоваяСтрока.СуммаНДСРуб = Строка.СуммаНДС * КурсДокумента;
				НоваяСтрока.СуммаВал    = Строка.СуммаВВалюте;
				НоваяСтрока.СуммаРуб    = Строка.СуммаВВалюте * КурсДокумента;
				
			КонецЕсли;
			
		// ВложенияВоВнеоборотныеАктивы.
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Строка.СчетДебета, "106.10,106.21,106.22,106.31,106.32,106.41,106.42,106.43") Тогда
			
			ВнеоборотныйАктив = Справочники.ОсновныеСредства.ПустаяСсылка();
			ВидЗатрат         = Справочники.ВидыЗатрат.ПустаяСсылка();
			
			СвойстваСчетаДебета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Строка.СчетДебета);
			Для НомерСубконто = 1 По СвойстваСчетаДебета.КоличествоСубконто Цикл
				
				ВидСубконто = СвойстваСчетаДебета["ВидСубконто" + НомерСубконто];
				Если ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства Тогда
					ВнеоборотныйАктив = Строка["СубконтоДебета" + НомерСубконто];
				ИначеЕсли ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ВидыЗатрат Тогда
					ВидЗатрат = Строка["СубконтоДебета" + НомерСубконто];
				КонецЕсли;
				
			КонецЦикла;
			
			Если Не ЗначениеЗаполнено(ВидЗатрат) ИЛИ Не ЗначениеЗаполнено(ВнеоборотныйАктив) Тогда
				Продолжить;
			КонецЕсли;
			
			ЭтоПоступлениеОсновныхСредств = (Строка.Количество <> 0);
			
			Если Строка.Сумма > 0 Тогда
				
				Если ЭтоПоступлениеОсновныхСредств Тогда
					НоваяСтрока = ТаблицыПоступления.ПоступлениеОсновныхСредств.Добавить();
				Иначе // Доп.вложения в основные средства.
					НоваяСтрока = ТаблицыПоступления.ВложенияВоВнеоборотныеАктивы.Добавить();
					НоваяСтрока.Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
					НоваяСтрока.Содержание   = Строка.КомуЗаЧто;
				КонецЕсли;
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка,
					"ИмяСписка,СинонимСписка,НомерСтроки,ИФО,КФО,КПС,Подразделение");
				
				НоваяСтрока.СчетВложений      = Строка.СчетДебета;
				НоваяСтрока.ВнеоборотныйАктив = ВнеоборотныйАктив;
				НоваяСтрока.ВидЗатрат         = ВидЗатрат;
				
				НоваяСтрока.СчетРасчетов = Строка.СчетКредита;
				НоваяСтрока.Контрагент   = Документ.Сотрудник.Контрагент;
				НоваяСтрока.Валюта       = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета();
				
				НоваяСтрока.Количество  = Строка.Количество;
				НоваяСтрока.СтавкаНДС   = Строка.СтавкаНДС;
				НоваяСтрока.СуммаНДСВал = Строка.СуммаНДС;
				НоваяСтрока.СуммаНДСРуб = Строка.СуммаНДС;
				НоваяСтрока.СуммаВал    = Строка.Сумма;
				НоваяСтрока.СуммаРуб    = Строка.Сумма;
				
			КонецЕсли;
			
			Если Строка.СуммаВВалюте > 0 Тогда
				
				Если ЭтоПоступлениеОсновныхСредств Тогда
					НоваяСтрока = ТаблицыПоступления.ПоступлениеОсновныхСредств.Добавить();
				Иначе // Доп.вложения в основные средства.
					НоваяСтрока = ТаблицыПоступления.ВложенияВоВнеоборотныеАктивы.Добавить();
					НоваяСтрока.Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
					НоваяСтрока.Содержание   = Строка.КомуЗаЧто;
				КонецЕсли;
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка,
					"ИмяСписка,СинонимСписка,НомерСтроки,ИФО,КФО,КПС,Подразделение");
				
				НоваяСтрока.СчетВложений      = Строка.СчетДебета;
				НоваяСтрока.ВнеоборотныйАктив = ВнеоборотныйАктив;
				НоваяСтрока.ВидЗатрат         = ВидЗатрат;
				
				НоваяСтрока.СчетРасчетов = Строка.СчетКредита;
				НоваяСтрока.Контрагент   = Документ.Сотрудник.Контрагент;
				НоваяСтрока.Валюта       = Строка.Валюта;
				
				НоваяСтрока.Количество  = Строка.Количество;
				НоваяСтрока.СтавкаНДС   = Строка.СтавкаНДС;
				НоваяСтрока.СуммаНДСВал = Строка.СуммаНДС;
				НоваяСтрока.СуммаНДСРуб = Строка.СуммаНДС * КурсДокумента;
				НоваяСтрока.СуммаВал    = Строка.СуммаВВалюте;
				НоваяСтрока.СуммаРуб    = Строка.СуммаВВалюте * КурсДокумента;
				
			КонецЕсли;
			
		// ПоступлениеУслугРабот.
		Иначе
			
			ВидЗатрат = Справочники.ВидыЗатрат.ПустаяСсылка();
			
			СвойстваСчетаДебета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Строка.СчетДебета);
			Для НомерСубконто = 1 По СвойстваСчетаДебета.КоличествоСубконто Цикл
				
				ВидСубконто = СвойстваСчетаДебета["ВидСубконто" + НомерСубконто];
				Если ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ВидыЗатрат Тогда
					ВидЗатрат = Строка["СубконтоДебета" + НомерСубконто];
				КонецЕсли;
				
			КонецЦикла;
			
			Если Строка.Сумма > 0 Тогда
				
				НоваяСтрока = ТаблицыПоступления.ПоступлениеУслугРабот.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка,
					"ИмяСписка,СинонимСписка,НомерСтроки,ИФО,КФО,КПС,Подразделение");
				
				НоваяСтрока.Номенклатура  = Справочники.Номенклатура.ПустаяСсылка();
				НоваяСтрока.Содержание    = Строка.КомуЗаЧто;
				НоваяСтрока.КЭК           = Строка.КЭК;
				НоваяСтрока.ВидЗатрат     = ВидЗатрат;
				НоваяСтрока.ОтражениеВУСН = Строка.ОтражениеВУСН;
				
				НоваяСтрока.СчетРасчетов = Строка.СчетКредита;
				НоваяСтрока.Контрагент   = Документ.Сотрудник.Контрагент;
				НоваяСтрока.Валюта       = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета();
				
				НоваяСтрока.Количество  = Строка.Количество;
				НоваяСтрока.СтавкаНДС   = Строка.СтавкаНДС;
				НоваяСтрока.СуммаНДСВал = Строка.СуммаНДС;
				НоваяСтрока.СуммаНДСРуб = Строка.СуммаНДС;
				НоваяСтрока.СуммаВал    = Строка.Сумма;
				НоваяСтрока.СуммаРуб    = Строка.Сумма;
				
			КонецЕсли;
			
			Если Строка.СуммаВВалюте > 0 Тогда
				
				НоваяСтрока = ТаблицыПоступления.ПоступлениеУслугРабот.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка,
					"ИмяСписка,СинонимСписка,НомерСтроки,ИФО,КФО,КПС,Подразделение");
				
				НоваяСтрока.Номенклатура  = Справочники.Номенклатура.ПустаяСсылка();
				НоваяСтрока.Содержание    = Строка.КомуЗаЧто;
				НоваяСтрока.КЭК           = Строка.КЭК;
				НоваяСтрока.ВидЗатрат     = ВидЗатрат;
				НоваяСтрока.ОтражениеВУСН = Строка.ОтражениеВУСН;
				
				НоваяСтрока.СчетРасчетов = Строка.СчетКредита;
				НоваяСтрока.Контрагент   = Документ.Сотрудник.Контрагент;
				НоваяСтрока.Валюта       = Строка.Валюта;
				
				НоваяСтрока.Количество  = Строка.Количество;
				НоваяСтрока.СтавкаНДС   = Строка.СтавкаНДС;
				НоваяСтрока.СуммаНДСВал = Строка.СуммаНДС;
				НоваяСтрока.СуммаНДСРуб = Строка.СуммаНДС * КурсДокумента;
				НоваяСтрока.СуммаВал    = Строка.СуммаВВалюте;
				НоваяСтрока.СуммаРуб    = Строка.СуммаВВалюте * КурсДокумента;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицыПоступления;
	
КонецФункции

Функция ПодготовитьТаблицыРасходовУСНПоРасходамПодотчетногоЛица(РасходыПодотчетногоЛица, Документ) Экспорт
	
	ТаблицыПоступления = Новый Структура;
	ТаблицыПоступления.Вставить("ПоступлениеМатериальныхЗапасов", УправлениеМатериальнымиЗапасами.ПустаяТаблицаПоступлениеМатериальныхЗапасов());
	ТаблицыПоступления.Вставить("ПоступлениеВозвратнойТары",      УправлениеМатериальнымиЗапасами.ПустаяТаблицаПоступлениеВозвратнойТары());
	ТаблицыПоступления.Вставить("ПоступлениеУслугРабот",          УчетРасчетов.ПустаяТаблицаПоступлениеУслугРабот());
	ТаблицыПоступления.Вставить("ПоступлениеДопРасходов",         УчетРасчетов.ПустаяТаблицаПоступлениеДопРасходов());
	ТаблицыПоступления.Вставить("ВложенияВоВнеоборотныеАктивы",   УправлениеОсновнымиСредствами.ПустаяТаблицаВложенияВоВнеоборотныеАктивы());
	ТаблицыПоступления.Вставить("ПоступлениеОсновныхСредств",     УправлениеОсновнымиСредствами.ПустаяТаблицаПоступлениеОсновныхСредств());
	
	Если НЕ УчетУСНВызовСервера.ПрименяетсяУСНДоходыМинусРасходы(Документ.Организация, Документ.Дата) Тогда
		Возврат ТаблицыПоступления;
	КонецЕсли;
	
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	Для Каждого Строка Из РасходыПодотчетногоЛица Цикл
		
		Если НЕ УчетУСНКлиентСервер.ОтражатьВУСНДоходыМинусРасходы(Документ.Организация, Документ.Дата, Строка.КФО) Тогда
			Продолжить;
		КонецЕсли;
		
		// ПоступлениеМатериальныхЗапасов, ПоступлениеВозвратнойТары.
		Если БухгалтерскийУчет.СчетВИерархии(Строка.СчетДебета, "105.00") Тогда
			
			Номенклатура            = Справочники.Номенклатура.ПустаяСсылка();
			ЦМО                     = Справочники.ЦМО.ПустаяСсылка();
			ДопАналитика            = Неопределено;
			ДопАналитикаВидСубконто = Неопределено;
			
			СвойстваСчетаДебета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Строка.СчетДебета);
			Для НомерСубконто = 1 По СвойстваСчетаДебета.КоличествоСубконто Цикл
				
				ВидСубконто = СвойстваСчетаДебета["ВидСубконто" + НомерСубконто];
				Если ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Номенклатура Тогда
					Номенклатура = Строка["СубконтоДебета" + НомерСубконто];
				ИначеЕсли ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ЦМО Тогда
					ЦМО = Строка["СубконтоДебета" + НомерСубконто];
				Иначе
					ДопАналитикаВидСубконто = ВидСубконто;
					ДопАналитика = Строка["СубконтоДебета" + НомерСубконто];
				КонецЕсли;
				
			КонецЦикла;
			
			Если Не ЗначениеЗаполнено(Номенклатура) Тогда
				Продолжить;
			КонецЕсли;
			
			ЭтоТара = (Номенклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Тара);
			
			Если Строка.СуммаРасчетов > 0 Тогда
				
				Если ЭтоТара Тогда
					НоваяСтрока = ТаблицыПоступления.ПоступлениеВозвратнойТары.Добавить();
				Иначе
					НоваяСтрока = ТаблицыПоступления.ПоступлениеМатериальныхЗапасов.Добавить();
				КонецЕсли;
				
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка,
					"ИмяСписка,СинонимСписка,НомерСтроки,ИФО,КФО,КПС,Подразделение");
				
				НоваяСтрока.СчетУчета    = Строка.СчетДебета;
				НоваяСтрока.Номенклатура = Номенклатура;
				
				Если ЗначениеЗаполнено(ЦМО) Тогда
					НоваяСтрока.ДопИзмерениеВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ЦМО;
					НоваяСтрока.ДопИзмерение            = ЦМО;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ДопАналитикаВидСубконто) И ЗначениеЗаполнено(ДопАналитика) Тогда
					НоваяСтрока.ДопАналитикаВидСубконто = ДопАналитикаВидСубконто;
					НоваяСтрока.ДопАналитика            = ДопАналитика;
				КонецЕсли;
				
				НоваяСтрока.СчетРасчетов = Строка.СчетРасчетов;
				НоваяСтрока.Контрагент   = Документ.Сотрудник.Контрагент;
				
				НоваяСтрока.Количество = Строка.Количество;
				
				Если НЕ ЭтоТара Тогда
					НоваяСтрока.СуммаНДСВал   = Строка.СуммаНДС;
					НоваяСтрока.СуммаНДСРуб   = Строка.СуммаНДС;
					НоваяСтрока.ОтражениеВУСН = Строка.ОтражениеВУСН;
				КонецЕсли;
				
				Если Не ЗначениеЗаполнено(Строка.Валюта) Тогда
					НоваяСтрока.Валюта = ВалютаРегламентированногоУчета;
				Иначе
					НоваяСтрока.Валюта = Строка.Валюта;
				КонецЕсли;
				
				НоваяСтрока.Количество = Строка.Количество;
				НоваяСтрока.СуммаВал   = Строка.СуммаРасчетов;
				НоваяСтрока.СуммаРуб   = Строка.СуммаРубПоКурсуАванса;
				
			КонецЕсли;
			
		// ПоступлениеДопРасходов.
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Строка.СчетДебета, "106.2П,106.3П,106.4П") Тогда
			
			Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
			ВидЗатрат    = Справочники.ВидыЗатрат.ПустаяСсылка();
			Партия       = Неопределено;
			
			СвойстваСчетаДебета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Строка.СчетДебета);
			Для НомерСубконто = 1 По СвойстваСчетаДебета.КоличествоСубконто Цикл
				
				ВидСубконто = СвойстваСчетаДебета["ВидСубконто" + НомерСубконто];
				Если ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Номенклатура Тогда
					Номенклатура = Строка["СубконтоДебета" + НомерСубконто];
				ИначеЕсли ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ВидыЗатрат Тогда
					ВидЗатрат = Строка["СубконтоДебета" + НомерСубконто];
				ИначеЕсли ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Партии Тогда
					Партия = Строка["СубконтоДебета" + НомерСубконто];
				КонецЕсли;
				
			КонецЦикла;
			
			Если Не ЗначениеЗаполнено(ВидЗатрат) ИЛИ Не ЗначениеЗаполнено(Номенклатура) Тогда
				Продолжить;
			КонецЕсли;
			
			Если Строка.СуммаРасчетов > 0 Тогда
				
				НоваяСтрока = ТаблицыПоступления.ПоступлениеДопРасходов.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка,
					"ИмяСписка,СинонимСписка,НомерСтроки,ИФО,КФО,КПС,Подразделение");
				
				НоваяСтрока.Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
				НоваяСтрока.Содержание   = Строка.НаименованиеРасхода;
				НоваяСтрока.КЭК          = Строка.КЭК;
				НоваяСтрока.ВидЗатрат    = ВидЗатрат;
				
				НоваяСтрока.СчетВложений          = Строка.СчетДебета;
				НоваяСтрока.ПартияВложений        = Партия;
				НоваяСтрока.КПСВложений           = Строка.КПС;
				НоваяСтрока.ПодразделениеВложений = Строка.Подразделение;
				НоваяСтрока.НоменклатураВложений  = Номенклатура;
				
				НоваяСтрока.СчетРасчетов = Строка.СчетРасчетов;
				НоваяСтрока.Контрагент   = Документ.Сотрудник.Контрагент;
				
				Если Не ЗначениеЗаполнено(Строка.Валюта) Тогда
					НоваяСтрока.Валюта = ВалютаРегламентированногоУчета;
				Иначе
					НоваяСтрока.Валюта = Строка.Валюта;
				КонецЕсли;
				
				НоваяСтрока.Количество  = Строка.Количество;
				НоваяСтрока.СуммаНДСВал = Строка.СуммаНДС;
				НоваяСтрока.СуммаНДСРуб = Строка.СуммаНДС;
				НоваяСтрока.СуммаВал    = Строка.СуммаРасчетов;
				НоваяСтрока.СуммаРуб    = Строка.СуммаРубПоКурсуАванса;
				
			КонецЕсли;
			
		// ВложенияВоВнеоборотныеАктивы.
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Строка.СчетДебета, "106.10,106.21,106.22,106.31,106.32,106.41,106.42,106.43") Тогда
			
			ВнеоборотныйАктив = Справочники.ОсновныеСредства.ПустаяСсылка();
			ВидЗатрат         = Справочники.ВидыЗатрат.ПустаяСсылка();
			
			СвойстваСчетаДебета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Строка.СчетДебета);
			Для НомерСубконто = 1 По СвойстваСчетаДебета.КоличествоСубконто Цикл
				
				ВидСубконто = СвойстваСчетаДебета["ВидСубконто" + НомерСубконто];
				Если ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства Тогда
					ВнеоборотныйАктив = Строка["СубконтоДебета" + НомерСубконто];
				ИначеЕсли ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ВидыЗатрат Тогда
					ВидЗатрат = Строка["СубконтоДебета" + НомерСубконто];
				КонецЕсли;
				
			КонецЦикла;
			
			Если Не ЗначениеЗаполнено(ВидЗатрат) ИЛИ Не ЗначениеЗаполнено(ВнеоборотныйАктив) Тогда
				Продолжить;
			КонецЕсли;
			
			ЭтоПоступлениеОсновныхСредств = (Строка.Количество <> 0);
			
			Если Строка.СуммаРасчетов > 0 Тогда
				
				Если ЭтоПоступлениеОсновныхСредств Тогда
					НоваяСтрока = ТаблицыПоступления.ПоступлениеОсновныхСредств.Добавить();
				Иначе // Доп.вложения в основные средства.
					НоваяСтрока = ТаблицыПоступления.ВложенияВоВнеоборотныеАктивы.Добавить();
					НоваяСтрока.Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
					НоваяСтрока.Содержание   = Строка.НаименованиеРасхода;
				КонецЕсли;
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка,
					"ИмяСписка,СинонимСписка,НомерСтроки,ИФО,КФО,КПС,Подразделение");
				
				НоваяСтрока.СчетВложений      = Строка.СчетДебета;
				НоваяСтрока.ВнеоборотныйАктив = ВнеоборотныйАктив;
				НоваяСтрока.ВидЗатрат         = ВидЗатрат;
				
				НоваяСтрока.СчетРасчетов = Строка.СчетРасчетов;
				НоваяСтрока.Контрагент   = Документ.Сотрудник.Контрагент;
				
				Если Не ЗначениеЗаполнено(Строка.Валюта) Тогда
					НоваяСтрока.Валюта = ВалютаРегламентированногоУчета;
				Иначе
					НоваяСтрока.Валюта = Строка.Валюта;
				КонецЕсли;
				
				НоваяСтрока.Количество  = Строка.Количество;
				НоваяСтрока.СуммаНДСВал = Строка.СуммаНДС;
				НоваяСтрока.СуммаНДСРуб = Строка.СуммаНДС;
				НоваяСтрока.СуммаВал    = Строка.СуммаРасчетов;
				НоваяСтрока.СуммаРуб    = Строка.СуммаРубПоКурсуАванса;
				
			КонецЕсли;
			
		// ПоступлениеУслугРабот.
		Иначе
			
			ВидЗатрат = Справочники.ВидыЗатрат.ПустаяСсылка();
			
			СвойстваСчетаДебета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Строка.СчетДебета);
			Для НомерСубконто = 1 По СвойстваСчетаДебета.КоличествоСубконто Цикл
				
				ВидСубконто = СвойстваСчетаДебета["ВидСубконто" + НомерСубконто];
				Если ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ВидыЗатрат Тогда
					ВидЗатрат = Строка["СубконтоДебета" + НомерСубконто];
				КонецЕсли;
				
			КонецЦикла;
			
			Если Строка.СуммаРасчетов > 0 Тогда
				
				НоваяСтрока = ТаблицыПоступления.ПоступлениеУслугРабот.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка,
					"ИмяСписка,СинонимСписка,НомерСтроки,ИФО,КФО,КПС,Подразделение");
				
				НоваяСтрока.Номенклатура  = Справочники.Номенклатура.ПустаяСсылка();
				НоваяСтрока.Содержание    = Строка.НаименованиеРасхода;
				НоваяСтрока.КЭК           = Строка.КЭК;
				НоваяСтрока.ВидЗатрат     = ВидЗатрат;
				НоваяСтрока.ОтражениеВУСН = Строка.ОтражениеВУСН;
				
				НоваяСтрока.СчетРасчетов = Строка.СчетРасчетов;
				НоваяСтрока.Контрагент   = Документ.Сотрудник.Контрагент;
				
				Если Не ЗначениеЗаполнено(Строка.Валюта) Тогда
					НоваяСтрока.Валюта = ВалютаРегламентированногоУчета;
				Иначе
					НоваяСтрока.Валюта = Строка.Валюта;
				КонецЕсли;
				
				НоваяСтрока.Количество  = Строка.Количество;
				НоваяСтрока.СуммаНДСВал = Строка.СуммаНДС;
				НоваяСтрока.СуммаНДСРуб = Строка.СуммаНДС;
				НоваяСтрока.СуммаВал    = Строка.СуммаРасчетов;
				НоваяСтрока.СуммаРуб    = Строка.СуммаРубПоКурсуАванса;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицыПоступления;
	
КонецФункции

Функция ПодготовитьТаблицуОплатПоставщикамПодотчетнымЛицом(Документ, Параметры = Неопределено) Экспорт
	
	ТаблицаОплат = УчетРасчетов.ПустаяТаблицаРасчетовСПогашениемЗадолженности();
	
	Если НЕ УчетУСНВызовСервера.ПрименяетсяУСНДоходыМинусРасходы(Документ.Организация, Документ.Дата) Тогда
		Возврат ТаблицаОплат;
	КонецЕсли;
	
	Если Параметры = Неопределено Тогда
		Параметры = Новый Структура;
	КонецЕсли;
	
	КурсДокумента = Документ.Курс / ?(Документ.Кратность = 0, 1, Документ.Кратность);
	
	Запрос = Новый Запрос;
	ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Израсходовано",
		"НомерСтроки,ИФО,КФО,КПС,КЭК,Подразделение,ПоДокументу,СчетДебета,СубконтоДебета1,СубконтоДебета2,СубконтоДебета3,
		|СчетКредита,КомуЗаЧто,ВалютаДокумента,Сумма,СуммаВВалюте",
		Документ, Параметры);
	
	Запрос.Текст = Запрос.Текст +
	"ВЫБРАТЬ
	|	""Израсходовано"" КАК ИмяСписка,
	|	""Израсходовано"" КАК СинонимСписка,
	|	Израсходовано.НомерСтроки КАК НомерСтроки,
	|	Израсходовано.ИФО КАК ИФО,
	|	Израсходовано.Подразделение КАК Подразделение,
	|	Израсходовано.КФО КАК КФО,
	|	Израсходовано.КПС КАК КПС,
	|	Израсходовано.КЭК КАК КЭК,
	|	Израсходовано.СчетДебета КАК СчетДебета,
	|	Израсходовано.СубконтоДебета1 КАК СубконтоДебета1,
	|	Израсходовано.СубконтоДебета2 КАК СубконтоДебета2,
	|	Израсходовано.СубконтоДебета3 КАК СубконтоДебета3,
	|	Израсходовано.СчетКредита КАК СчетКредита,
	|	Израсходовано.КомуЗаЧто КАК КомуЗаЧто,
	|	Израсходовано.ВалютаДокумента КАК Валюта,
	|	Израсходовано.Сумма КАК Сумма,
	|	Израсходовано.СуммаВВалюте КАК СуммаВВалюте
	|ИЗ
	|	ТаблицаИзрасходовано КАК Израсходовано
	|ГДЕ
	|	НЕ Израсходовано.ПоДокументу
	|	И Израсходовано.СчетДебета В(&СчетаРасчетовСКонтрагентами)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	Запрос.УстановитьПараметр("СчетаРасчетовСКонтрагентами",
		БухгалтерскийУчет.СписокСчетов("302.00"));
	
	ОплаченоПодотчетнымЛицом = Запрос.Выполнить().Выгрузить();
	Для Каждого Строка Из ОплаченоПодотчетнымЛицом Цикл
		
		Если НЕ УчетРасчетовКлиентСервер.ВедетсяУчетПоДокументамРасчетов(Документ.Организация, Документ.Дата,
				Строка.КФО, Строка.Валюта, Строка.СчетДебета) Тогда
			Продолжить;
		КонецЕсли;
		
		Контрагент       = Справочники.Контрагенты.ПустаяСсылка();
		Договор          = Справочники.Договоры.ПустаяСсылка();
		ДокументРасчетов = Неопределено;
		
		СвойстваСчетаДебета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Строка.СчетДебета);
		Для НомерСубконто = 1 По СвойстваСчетаДебета.КоличествоСубконто Цикл
			
			ВидСубконто = СвойстваСчетаДебета["ВидСубконто" + НомерСубконто];
			Если ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Контрагенты Тогда
				Контрагент = Строка["СубконтоДебета" + НомерСубконто];
			ИначеЕсли ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Договоры Тогда
				Договор = Строка["СубконтоДебета" + НомерСубконто];
			ИначеЕсли ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ДокументыРасчетов Тогда
				ДокументРасчетов = Строка["СубконтоДебета" + НомерСубконто];
			КонецЕсли;
			
		КонецЦикла;
		
		Если Не ЗначениеЗаполнено(ДокументРасчетов) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Строка.Сумма > 0 Тогда
			
			НоваяСтрока = ТаблицаОплат.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка,
				"ИмяСписка,СинонимСписка,НомерСтроки,ИФО,КФО,КПС,КЭК,Подразделение");
			
			НоваяСтрока.СчетРасчетов  = Строка.СчетДебета;
			НоваяСтрока.Контрагент    = Контрагент;
			НоваяСтрока.Договор       = Договор;
			
			НоваяСтрока.ВидДопСубконтоРасчетов = ПланыВидовХарактеристик.ВидыСубконто.ДокументыРасчетов;
			НоваяСтрока.ДопСубконтоРасчетов    = ДокументРасчетов;
			
			НоваяСтрока.ВидДоговора       = НоваяСтрока.Договор.ВидДоговора;
			НоваяСтрока.УчетАгентскогоНДС = УчетРасчетов.УчетАгентскогоНДС(НоваяСтрока.Договор);
			НоваяСтрока.РасчетыВВалюте    = Ложь;
			
			НоваяСтрока.Валюта                = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета();
			НоваяСтрока.СуммаРасчетов         = Строка.Сумма;
			НоваяСтрока.СуммаРуб              = Строка.Сумма;
			НоваяСтрока.СуммаРубПоКурсуАванса = НоваяСтрока.СуммаРуб;
			
		КонецЕсли;
		
		Если Строка.СуммаВВалюте > 0 Тогда
			
			НоваяСтрока = ТаблицаОплат.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка,
				"ИмяСписка,СинонимСписка,НомерСтроки,ИФО,КФО,КПС,Подразделение");
			
			НоваяСтрока.СчетРасчетов  = Строка.СчетДебета;
			НоваяСтрока.Контрагент    = Контрагент;
			НоваяСтрока.Договор       = Договор;
			
			НоваяСтрока.ВидДопСубконтоРасчетов = ПланыВидовХарактеристик.ВидыСубконто.ДокументыРасчетов;
			НоваяСтрока.ДопСубконтоРасчетов    = ДокументРасчетов;
			
			НоваяСтрока.ВидДоговора       = НоваяСтрока.Договор.ВидДоговора;
			НоваяСтрока.УчетАгентскогоНДС = УчетРасчетов.УчетАгентскогоНДС(НоваяСтрока.Договор);
			НоваяСтрока.РасчетыВВалюте    = Истина;
			
			НоваяСтрока.Валюта                = Строка.Валюта;
			НоваяСтрока.СуммаРасчетов         = Строка.СуммаВВалюте;
			НоваяСтрока.СуммаРуб              = Строка.СуммаВВалюте * КурсДокумента;
			НоваяСтрока.СуммаРубПоКурсуАванса = НоваяСтрока.СуммаРуб;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаОплат;
	
КонецФункции

Функция ПодготовитьТаблицуОплатПоПриходнымДокументам(Документ, Параметры = Неопределено) Экспорт
	
	ТаблицаОплат = УчетРасчетов.ПустаяТаблицаРасчетовСПогашениемЗадолженности();
	
	Если НЕ УчетУСНВызовСервера.ПрименяетсяУСНДоходыМинусРасходы(Документ.Организация, Документ.Дата) Тогда
		Возврат ТаблицаОплат;
	КонецЕсли;
	
	Если Параметры = Неопределено Тогда
		Параметры = Новый Структура;
	КонецЕсли;
	
	// Выберем оплаченные приходные документы.
	Запрос = Новый Запрос;
	ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Израсходовано",
		"НомерСтроки,Сотрудник,ПоДокументу,ПриходныйДокумент",
		Документ, Параметры);
	
	Запрос.Текст = Запрос.Текст +
	"ВЫБРАТЬ
	|	""Израсходовано"" КАК ИмяСписка,
	|	""Израсходовано"" КАК СинонимСписка,
	|	Израсходовано.НомерСтроки КАК НомерСтроки,
	|	Израсходовано.Сотрудник КАК Сотрудник,
	|	Израсходовано.Сотрудник.Контрагент КАК Контрагент,
	|	Израсходовано.ПриходныйДокумент КАК ПриходныйДокумент
	|ИЗ
	|	ТаблицаИзрасходовано КАК Израсходовано
	|ГДЕ
	|	Израсходовано.ПоДокументу";
	ОплаченныеПриходныеДокументы = Запрос.Выполнить().Выгрузить();
	
	// Получим остатки неоплаченных расходов УСН по выбранным приходным документам.
	ОтборРасходов = Новый Структура;
	ОтборРасходов.Вставить("СчетРасчетов",     БухгалтерскийУчет.СписокСчетов("208.00"));
	ОтборРасходов.Вставить("Контрагент",       ОплаченныеПриходныеДокументы.ВыгрузитьКолонку("Контрагент"));
	ОтборРасходов.Вставить("ДокументРасчетов", ОплаченныеПриходныеДокументы.ВыгрузитьКолонку("ПриходныйДокумент"));
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		ОтборРасходов.Вставить("ИФО", Документ.ИФО);
	КонецЕсли;
	
	ОстаткиРасходовУСН = ОстаткиРасходовУСН(
		Новый Граница(Документ.МоментВремени(), ВидГраницы.Исключая),
		БухгалтерскийУчет.СписокСчетов("У01.ВО,У01.О,У04.О,У08.ПО,У10.О,У10.СО,У10.ОР,У15.О,У15.СО,У41.О,У41.СО,У41.ОР"),
		ОтборРасходов,
		Новый Структура("Организация,Дата", Документ.Организация, Документ.Дата));
	
	// Все неоплаченные расходы УСН по выбранным платежным документам считаем оплаченными данным авансовым отчетом.
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОплаченныеПриходныеДокументы.ИмяСписка КАК ИмяСписка,
	|	ОплаченныеПриходныеДокументы.СинонимСписка КАК СинонимСписка,
	|	ОплаченныеПриходныеДокументы.НомерСтроки КАК НомерСтроки,
	|	ОплаченныеПриходныеДокументы.Сотрудник КАК Сотрудник,
	|	ОплаченныеПриходныеДокументы.Контрагент КАК Контрагент,
	|	ОплаченныеПриходныеДокументы.ПриходныйДокумент КАК ПриходныйДокумент
	|ПОМЕСТИТЬ ОплаченныеПриходныеДокументы
	|ИЗ
	|	&ОплаченныеПриходныеДокументы КАК ОплаченныеПриходныеДокументы
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ПриходныйДокумент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстаткиРасходовУСН.Организация КАК Организация,
	|	ОстаткиРасходовУСН.ИФО КАК ИФО,
	|	ОстаткиРасходовУСН.КФО КАК КФО,
	|	ОстаткиРасходовУСН.КПС КАК КПС,
	|	ОстаткиРасходовУСН.Подразделение КАК Подразделение,
	|	ОстаткиРасходовУСН.СчетРасчетов КАК СчетРасчетов,
	|	ОстаткиРасходовУСН.Контрагент КАК Контрагент,
	|	ОстаткиРасходовУСН.ДокументРасчетов КАК ДокументРасчетов,
	|	ОстаткиРасходовУСН.НомерСтрокиДокумента КАК НомерСтрокиДокументРасчетов,
	|	ОстаткиРасходовУСН.Валюта КАК Валюта,
	|	ОстаткиРасходовУСН.СуммаВал КАК СуммаВал,
	|	ОстаткиРасходовУСН.СуммаРуб КАК СуммаРуб,
	|	ОстаткиРасходовУСН.СуммаНеУчитываетсяНУРуб КАК СуммаНеУчитываетсяНУРуб,
	|	ОстаткиРасходовУСН.СуммаЕНВДРуб КАК СуммаЕНВДРуб,
	|	ОстаткиРасходовУСН.СуммаНДСРуб КАК СуммаНДСРуб
	|ПОМЕСТИТЬ НеоплаченныеРасходыУСНПоПриходнымДокументам
	|ИЗ
	|	&ОстаткиРасходовУСН КАК ОстаткиРасходовУСН
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ДокументРасчетов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОплаченныеПриходныеДокументы.ИмяСписка КАК ИмяСписка,
	|	ОплаченныеПриходныеДокументы.СинонимСписка КАК СинонимСписка,
	|	ОплаченныеПриходныеДокументы.НомерСтроки КАК НомерСтроки,
	|	ОплаченныеПриходныеДокументы.Сотрудник,
	|	НеоплаченныеРасходыУСНПоПриходнымДокументам.Организация,
	|	НеоплаченныеРасходыУСНПоПриходнымДокументам.ИФО,
	|	НеоплаченныеРасходыУСНПоПриходнымДокументам.КФО,
	|	НеоплаченныеРасходыУСНПоПриходнымДокументам.КПС,
	|	НеоплаченныеРасходыУСНПоПриходнымДокументам.Подразделение,
	|	НеоплаченныеРасходыУСНПоПриходнымДокументам.СчетРасчетов,
	|	НеоплаченныеРасходыУСНПоПриходнымДокументам.Контрагент,
	|	НеоплаченныеРасходыУСНПоПриходнымДокументам.ДокументРасчетов,
	|	НеоплаченныеРасходыУСНПоПриходнымДокументам.НомерСтрокиДокументРасчетов КАК НомерСтрокиДокументРасчетов,
	|	НеоплаченныеРасходыУСНПоПриходнымДокументам.Валюта,
	|	НеоплаченныеРасходыУСНПоПриходнымДокументам.СуммаВал,
	|	НеоплаченныеРасходыУСНПоПриходнымДокументам.СуммаРуб,
	|	НеоплаченныеРасходыУСНПоПриходнымДокументам.СуммаНеУчитываетсяНУРуб,
	|	НеоплаченныеРасходыУСНПоПриходнымДокументам.СуммаЕНВДРуб,
	|	НеоплаченныеРасходыУСНПоПриходнымДокументам.СуммаНДСРуб
	|ИЗ
	|	НеоплаченныеРасходыУСНПоПриходнымДокументам КАК НеоплаченныеРасходыУСНПоПриходнымДокументам
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОплаченныеПриходныеДокументы КАК ОплаченныеПриходныеДокументы
	|		ПО НеоплаченныеРасходыУСНПоПриходнымДокументам.ДокументРасчетов = ОплаченныеПриходныеДокументы.ПриходныйДокумент
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИмяСписка,
	|	НомерСтроки,
	|	НомерСтрокиДокументРасчетов";
	Запрос.УстановитьПараметр("ОстаткиРасходовУСН",           ОстаткиРасходовУСН);
	Запрос.УстановитьПараметр("ОплаченныеПриходныеДокументы", ОплаченныеПриходныеДокументы);
	
	РасходыУСНКОплате = Запрос.Выполнить().Выгрузить();
	Для Каждого Строка Из РасходыУСНКОплате Цикл
		
		Если Не ЗначениеЗаполнено(Строка.ДокументРасчетов) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаОплат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка,
			"ИмяСписка,СинонимСписка,НомерСтроки,ИФО,КФО,КПС,Подразделение,СчетРасчетов,Контрагент,Валюта");
		НоваяСтрока.ЭтоАванс = Ложь;
		
		НоваяСтрока.ВидДопСубконтоРасчетов = ПланыВидовХарактеристик.ВидыСубконто.ДокументыРасчетов;
		НоваяСтрока.ДопСубконтоРасчетов    = Строка.ДокументРасчетов;
		
		НоваяСтрока.РасчетыВВалюте = (НоваяСтрока.Валюта <> БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета());
		
		НоваяСтрока.СуммаРасчетов = Строка.СуммаВал;
		НоваяСтрока.СуммаРуб      = Строка.СуммаРуб
								  + Строка.СуммаНеУчитываетсяНУРуб
								  + Строка.СуммаЕНВДРуб
								  + Строка.СуммаНДСРуб;
		НоваяСтрока.СуммаРубПоКурсуАванса = НоваяСтрока.СуммаРуб;
		
	КонецЦикла;
	
	// Сворачиваем по всем колонкам, суммируя суммовые показатели.
	ОбщегоНазначенияБГУ.СвернутьТаблицуИСуммироватьКолонки(ТаблицаОплат,
		"ОстатокРасчетов,СуммаРасчетов,СуммаРуб,СуммаРубПоКурсуАванса,СуммаЕНВДРуб");
	
	Возврат ТаблицаОплат;
	
КонецФункции

// Признание расходов при отражении Авансового отчета, Отчета о расходах подотчетного лица.
Функция ТаблицаОплаченныеАвансомРасходыПодотчетнихЛиц(ТаблицаПоступлениеРасходовУСН, Реквизиты, Отказ) Экспорт
	
	ТаблицаОплаченныхРасходовУСН = УчетУСН.ПустаяТаблицаОплаченныхРасходовУСН();
	
	УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Реквизиты.Организация, Реквизиты.Дата);
	Если НЕ УчетнаяПолитика.ПрименяетсяУСНДоходыМинусРасходы Тогда
		Возврат ТаблицаОплаченныхРасходовУСН;
	КонецЕсли;
	Если ТаблицаПоступлениеРасходовУСН.Количество() = 0 Тогда
		Возврат ТаблицаОплаченныхРасходовУСН;
	КонецЕсли;
	
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	
	// Параметры учетной политики в части учета расходов УСН.
	Реквизиты.Вставить("ТоварыПоОплате", УчетнаяПолитика.ПорядокПризнанияРасходовПоТоварам =
		Перечисления.ПорядокПризнанияРасходовПоТоварам.ПоОплатеПоставщику);
	Реквизиты.Вставить("ТоварыПоОтгрузке", УчетнаяПолитика.ПорядокПризнанияРасходовПоТоварам =
		Перечисления.ПорядокПризнанияРасходовПоТоварам.ПоФактуРеализации);
	Реквизиты.Вставить("МатериалыПоОплате", УчетнаяПолитика.ПорядокПризнанияМатериальныхРасходов =
		Перечисления.ПорядокПризнанияМатериальныхРасходов.ПоОплатеПоставщику);
	Реквизиты.Вставить("ДопРасходыПоОплате", УчетнаяПолитика.ПорядокПризнанияДопРасходов =
		Перечисления.ПорядокПризнанияДопРасходов.ПоОплатеПоставщику);
	Реквизиты.Вставить("ТаможенныеПлатежиПоОплате", УчетнаяПолитика.ПорядокПризнанияТаможенныхПлатежей =
		Перечисления.ПорядокПризнанияТаможенныхПлатежей.ПоОплате);
	Реквизиты.Вставить("НДСПоОплате", УчетнаяПолитика.ПорядокПризнанияРасходовПоНДС =
		Перечисления.ПорядокПризнанияРасходовПоНДС.ПоОплатеПоставщику);

	// Подготовим таблицу остатков авансов.
	ОстаткиАвансов = РасчетыСПодотчетнымиЛицами.ОстаткиАвансов(Реквизиты.Ссылка, ТаблицаПоступлениеРасходовУСН, Реквизиты);
	ОстаткиАвансов.Свернуть("Организация,ИФО,КФО,КПС,Подразделение,СчетРасчетов,Контрагент,Валюта", "СуммаРасчетов,СуммаРуб");
	
	// Заполним таблицу оплаченных расходов.
	Для Каждого Аванс Из ОстаткиАвансов Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("КФО", Аванс.КФО);
		
		Если Реквизиты.ИспользоватьУчетПоИФО Тогда
			Отбор.Вставить("ИФО", Аванс.ИФО);
		КонецЕсли;
		
		СвойстваСчетаРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Аванс.СчетРасчетов);
		Если Реквизиты.ИспользоватьУчетПоПодразделениям И СвойстваСчетаРасчетов.УчетПоПодразделениям Тогда
			Отбор.Вставить("Подразделение", Аванс.Подразделение);
		КонецЕсли;
		Если Реквизиты.ИспользоватьВалютныйУчет И СвойстваСчетаРасчетов.Валютный Тогда
			Отбор.Вставить("Валюта", Аванс.Валюта);
		КонецЕсли;
		
		Отбор.Вставить("СчетРасчетов", Аванс.СчетРасчетов);
		Отбор.Вставить("Контрагент",   Аванс.Контрагент);
		
		ОписаниеТипаСуммы      = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
		ОписаниеТипаКоличества = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
		
		ОплаченныеРасходыУСН = ТаблицаПоступлениеРасходовУСН.Скопировать(Отбор);
		// Сворачиваем по всем колонкам таблицы УчетУСН.ПустаяТаблицаПоступлениеРасходовУСН().
		ОплаченныеРасходыУСН.Свернуть("ИмяСписка,СинонимСписка,НомерСтроки,ИФО,КФО,КПС,Подразделение,
		|СчетУчетаУСН,ВидРасхода,ЭлементРасхода,Партия,ИмяСпискаДокумента,НомерСтрокиДокумента,ОтражениеВУСН,
		|СчетРасчетов,Контрагент,Договор,ДокументРасчетов,Валюта,РасходыУСН,
		|ВидСубконтоРасходов2,СубконтоРасходов2,ВидСубконтоРасходов3,СубконтоРасходов3",
			"Количество,СуммаВал,СуммаРуб,СуммаНДСВал,СуммаНДСРуб,СуммаНеУчитываетсяНУРуб,СуммаЕНВДРуб");
		ОплаченныеРасходыУСН.Колонки.Добавить("ОплаченоКоличество",              ОписаниеТипаКоличества);
		ОплаченныеРасходыУСН.Колонки.Добавить("ОплаченоСуммаВал",                ОписаниеТипаСуммы);
		ОплаченныеРасходыУСН.Колонки.Добавить("ОплаченоСуммаРуб",                ОписаниеТипаСуммы);
		ОплаченныеРасходыУСН.Колонки.Добавить("ОплаченоСуммаНеУчитываетсяНУРуб", ОписаниеТипаСуммы);
		ОплаченныеРасходыУСН.Колонки.Добавить("ОплаченоСуммаЕНВДРуб",            ОписаниеТипаСуммы);
		ОплаченныеРасходыУСН.Колонки.Добавить("ОплаченоСуммаНДСРуб",             ОписаниеТипаСуммы);
		ОплаченныеРасходыУСН.Колонки.Добавить("ВсегоРасходовВал",                ОписаниеТипаСуммы);
		ОплаченныеРасходыУСН.Колонки.Добавить("ВсегоРасходовРуб",                ОписаниеТипаСуммы);
		Для Каждого СтрокаРасходовУСН Из ОплаченныеРасходыУСН Цикл
			
			Если СвойстваСчетаРасчетов.УчетПоКПС Тогда
				СвойстваСчетаУСН = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаРасходовУСН.СчетУчетаУСН);
				Если СвойстваСчетаУСН.УчетПоКПС И (СтрокаРасходовУСН.КПС <> Аванс.КПС) Тогда
					Продолжить; // Пропускаем расходы по другим КПС.
				КонецЕсли;
			КонецЕсли;
			
			Если СтрокаРасходовУСН.СуммаВал > 0 Тогда
				// Распределять оплату будем только на строки с положительной суммой расходов УСН.
				СтрокаРасходовУСН.ВсегоРасходовВал = СтрокаРасходовУСН.СуммаВал + СтрокаРасходовУСН.СуммаНДСВал;
				СтрокаРасходовУСН.ВсегоРасходовРуб = СтрокаРасходовУСН.СуммаРуб +
					СтрокаРасходовУСН.СуммаНеУчитываетсяНУРуб + СтрокаРасходовУСН.СуммаЕНВДРуб + СтрокаРасходовУСН.СуммаНДСРуб;
			КонецЕсли;
			
		КонецЦикла;
		
		РаспределитьСуммуОплатыРасходовУСН(
			Мин(Аванс.СуммаРасчетов, ОплаченныеРасходыУСН.Итог("ВсегоРасходовВал")),
			Мин(Аванс.СуммаРуб,      ОплаченныеРасходыУСН.Итог("ВсегоРасходовРуб")),
			ОплаченныеРасходыУСН);
		
		Для Каждого РасходУСН Из ОплаченныеРасходыУСН Цикл
			
			Если РасходУСН.ОплаченоСуммаВал = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ТаблицаОплаченныхРасходовУСН.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, РасходУСН,
				"ИмяСписка,СинонимСписка,НомерСтроки,ИФО,КФО,КПС,Подразделение,Контрагент,Договор,ДокументРасчетов,Валюта,
				|СчетУчетаУСН,РасходыУСН,ВидСубконтоРасходов2,СубконтоРасходов2,ВидСубконтоРасходов3,СубконтоРасходов3");
			
			НоваяСтрока.Количество              = РасходУСН.ОплаченоКоличество;
			НоваяСтрока.СуммаВал                = РасходУСН.ОплаченоСуммаВал;
			НоваяСтрока.СуммаРуб                = РасходУСН.ОплаченоСуммаРуб;
			НоваяСтрока.СуммаНеУчитываетсяНУРуб = РасходУСН.ОплаченоСуммаНеУчитываетсяНУРуб;
			НоваяСтрока.СуммаЕНВДРуб            = РасходУСН.ОплаченоСуммаЕНВДРуб;
			НоваяСтрока.СуммаНДСРуб             = РасходУСН.ОплаченоСуммаНДСРуб;
			
			НоваяСтрока.КорСчетУСН = СчетУчетаОплаченныхРасходовУСН(
				НоваяСтрока.СчетУчетаУСН, НоваяСтрока.РасходыУСН, Реквизиты);
			
			НоваяСтрока.ДокументОплаты = Реквизиты.Ссылка;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТаблицаОплаченныхРасходовУСН;
	
КонецФункции

// Признание расходов при погашении задолженности подотчетным лицам документами оплаты.
Функция ТаблицаОплаченныеРасходыПодотчетнихЛиц(ТаблицаРасшифровкаПлатежаУнифицированная, Реквизиты, Отказ) Экспорт
	
	ТаблицаОплаченныхРасходовУСН = УчетУСН.ПустаяТаблицаОплаченныхРасходовУСН();
	
	УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Реквизиты.Организация, Реквизиты.Дата);
	Если НЕ УчетнаяПолитика.ПрименяетсяУСНДоходыМинусРасходы Тогда
		Возврат ТаблицаОплаченныхРасходовУСН;
	КонецЕсли;
	
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	
	// Параметры учетной политики в части учета расходов УСН.
	Реквизиты.Вставить("ТоварыПоОплате", УчетнаяПолитика.ПорядокПризнанияРасходовПоТоварам =
		Перечисления.ПорядокПризнанияРасходовПоТоварам.ПоОплатеПоставщику);
	Реквизиты.Вставить("ТоварыПоОтгрузке", УчетнаяПолитика.ПорядокПризнанияРасходовПоТоварам =
		Перечисления.ПорядокПризнанияРасходовПоТоварам.ПоФактуРеализации);
	Реквизиты.Вставить("МатериалыПоОплате", УчетнаяПолитика.ПорядокПризнанияМатериальныхРасходов =
		Перечисления.ПорядокПризнанияМатериальныхРасходов.ПоОплатеПоставщику);
	Реквизиты.Вставить("ДопРасходыПоОплате", УчетнаяПолитика.ПорядокПризнанияДопРасходов =
		Перечисления.ПорядокПризнанияДопРасходов.ПоОплатеПоставщику);
	Реквизиты.Вставить("ТаможенныеПлатежиПоОплате", УчетнаяПолитика.ПорядокПризнанияТаможенныхПлатежей =
		Перечисления.ПорядокПризнанияТаможенныхПлатежей.ПоОплате);
	Реквизиты.Вставить("НДСПоОплате", УчетнаяПолитика.ПорядокПризнанияРасходовПоНДС =
		Перечисления.ПорядокПризнанияРасходовПоНДС.ПоОплатеПоставщику);

	ТаблицаОплат = ТаблицаРасшифровкаПлатежаУнифицированная.СкопироватьКолонки();
	Для Каждого СтрокаРасшифровкаПлатежа Из ТаблицаРасшифровкаПлатежаУнифицированная Цикл
		Если УчетУСНКлиентСервер.ВедетсяУчетУСНпоКФО(СтрокаРасшифровкаПлатежа.КФО) Тогда
			НоваяОплата = ТаблицаОплат.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяОплата, СтрокаРасшифровкаПлатежа);
		КонецЕсли;
	КонецЦикла;
	ТаблицаОплат.Свернуть("ИФО,КФО,КПС,Подразделение,СчетРасчетов,Контрагент,Валюта", "СуммаРасчетов,СуммаРуб");
	
	Если ТаблицаОплат.Количество() = 0 Тогда
		Возврат ТаблицаОплаченныхРасходовУСН;
	КонецЕсли;
	
	// Получим остатки неоплаченных расходов УСН по оплаченным документам расчетов.
	СчетаРасходовКОплате = БухгалтерскийУчет.СписокСчетов(
		"У01.О,У01.ВО,У04.О,У08.ПО,У08.О,У10.О,У10.СО,У10.ОР,У15.О,У15.СО,У20.О,У41.О,У41.СО,У41.ОР,У70.О");
	
	ОтборРасходов = Новый Структура;
	ОтборРасходов.Вставить("СчетРасчетов", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
		ТаблицаОплат.ВыгрузитьКолонку("СчетРасчетов")));
	ОтборРасходов.Вставить("Контрагент", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
		ТаблицаОплат.ВыгрузитьКолонку("Контрагент")));
	
	Если Реквизиты.ИспользоватьУчетПоИФО Тогда
		ОтборРасходов.Вставить("ИФО", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
			ТаблицаОплат.ВыгрузитьКолонку("ИФО")));
	КонецЕсли;
	ОтборРасходов.Вставить("КФО", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
		ТаблицаОплат.ВыгрузитьКолонку("КФО")));
	
	ПериодОстатков = ?(Реквизиты.Свойство("ПериодОстатков"), Реквизиты.ПериодОстатков,
		УчетРасчетов.ПериодПолученияОстатков(Реквизиты.Ссылка));
	ОстаткиРасходовУСН = ОстаткиРасходовУСН(ПериодОстатков, СчетаРасходовКОплате, ОтборРасходов, Реквизиты);
	ОбщегоНазначенияБГУ.УпорядочитьТаблицуПоДокументу(ОстаткиРасходовУСН, "ДокументРасчетов", "ДатаДокументаРасчетов");
	
	// Заполним таблицу оплаченных расходов УСН.
	Для Каждого Оплата Из ТаблицаОплат Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("КФО", Оплата.КФО);
		
		Если Реквизиты.ИспользоватьУчетПоИФО Тогда
			Отбор.Вставить("ИФО", Оплата.ИФО);
		КонецЕсли;
		
		СвойстваСчетаРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Оплата.СчетРасчетов);
		Если Реквизиты.ИспользоватьУчетПоПодразделениям И СвойстваСчетаРасчетов.УчетПоПодразделениям Тогда
			Отбор.Вставить("Подразделение", Оплата.Подразделение);
		КонецЕсли;
		Если Реквизиты.ИспользоватьВалютныйУчет И СвойстваСчетаРасчетов.Валютный Тогда
			Отбор.Вставить("Валюта", Оплата.Валюта);
		КонецЕсли;
		
		Отбор.Вставить("СчетРасчетов", Оплата.СчетРасчетов);
		Отбор.Вставить("Контрагент",   Оплата.Контрагент);
		
		ОписаниеТипаСуммы      = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
		ОписаниеТипаКоличества = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
		
		ОплаченныеРасходыУСН = ОстаткиРасходовУСН.Скопировать(Отбор);
		ОплаченныеРасходыУСН.Колонки.Добавить("ОплаченоКоличество",              ОписаниеТипаКоличества);
		ОплаченныеРасходыУСН.Колонки.Добавить("ОплаченоСуммаВал",                ОписаниеТипаСуммы);
		ОплаченныеРасходыУСН.Колонки.Добавить("ОплаченоСуммаРуб",                ОписаниеТипаСуммы);
		ОплаченныеРасходыУСН.Колонки.Добавить("ОплаченоСуммаНеУчитываетсяНУРуб", ОписаниеТипаСуммы);
		ОплаченныеРасходыУСН.Колонки.Добавить("ОплаченоСуммаЕНВДРуб",            ОписаниеТипаСуммы);
		ОплаченныеРасходыУСН.Колонки.Добавить("ОплаченоСуммаНДСРуб",             ОписаниеТипаСуммы);
		ОплаченныеРасходыУСН.Колонки.Добавить("ВсегоРасходовВал",                ОписаниеТипаСуммы);
		ОплаченныеРасходыУСН.Колонки.Добавить("ВсегоРасходовРуб",                ОписаниеТипаСуммы);
		Для Каждого СтрокаРасходовУСН Из ОплаченныеРасходыУСН Цикл
			
			Если СвойстваСчетаРасчетов.УчетПоКПС Тогда
				СвойстваСчетаУСН = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаРасходовУСН.СчетУчетаУСН);
				Если СвойстваСчетаУСН.УчетПоКПС И (СтрокаРасходовУСН.КПС <> Оплата.КПС) Тогда
					Продолжить; // Пропускаем расходы по другим КПС.
				КонецЕсли;
			КонецЕсли;
			
			Если СтрокаРасходовУСН.СуммаВал > 0 Тогда
				// Распределять оплату будем только на строки с положительной суммой расходов УСН.
				СтрокаРасходовУСН.ВсегоРасходовВал = СтрокаРасходовУСН.СуммаВал;
				СтрокаРасходовУСН.ВсегоРасходовРуб = СтрокаРасходовУСН.СуммаРуб +
					СтрокаРасходовУСН.СуммаНеУчитываетсяНУРуб + СтрокаРасходовУСН.СуммаЕНВДРуб + СтрокаРасходовУСН.СуммаНДСРуб;
			КонецЕсли;
			
		КонецЦикла;
		
		ОсталосьПогаситьВал = Мин(Оплата.СуммаРасчетов, ОплаченныеРасходыУСН.Итог("ВсегоРасходовВал"));
		Если Оплата.Валюта = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета() Тогда
			// Если расчеты в рублях, сумма оплаченных расходов не может превышать сумму расходов,
			// признанных первоначально при поступлении расходов.
			ОсталосьПогаситьРуб = Мин(Оплата.СуммаРуб, ОплаченныеРасходыУСН.Итог("ВсегоРасходовРуб"));
		Иначе
			// Если расчеты в валюте, сумма расходов в рублях может быть как больше, так и меньше суммы расходов,
			// признанных первоначально при поступлении расходов из-за разницы курсов.
			Коэффициент = ?(Оплата.СуммаРасчетов = 0, 0, ОсталосьПогаситьВал / Оплата.СуммаРасчетов);
			ОсталосьПогаситьРуб = Коэффициент * Оплата.СуммаРуб;
		КонецЕсли;
		
		// В таблице ОплаченныеРасходыУСН отобраны расходы УСН по подотчетному лицу.
		// Распределим сумму оплаты на все расходы УСН по данному расчетному документу.
		РаспределитьСуммуОплатыРасходовУСН(ОсталосьПогаситьВал, ОсталосьПогаситьРуб, ОплаченныеРасходыУСН);
		
		Для Каждого РасходУСН Из ОплаченныеРасходыУСН Цикл
			
			Если РасходУСН.ОплаченоСуммаВал = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ТаблицаОплаченныхРасходовУСН.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, РасходУСН,
				"ИФО,КФО,КПС,Подразделение,СчетРасчетов,Контрагент,Договор,ДокументРасчетов,Валюта,СчетУчетаУСН,РасходыУСН");
			
			СвойстваСчетаУчетаУСН = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(РасходУСН.СчетУчетаУСН);
			НоваяСтрока.ВидСубконтоРасходов2 = СвойстваСчетаУчетаУСН.ВидСубконто1;
			НоваяСтрока.СубконтоРасходов2    = РасходУСН.СубконтоРасходов2;
			НоваяСтрока.ВидСубконтоРасходов3 = СвойстваСчетаУчетаУСН.ВидСубконто3;
			НоваяСтрока.СубконтоРасходов3    = РасходУСН.СубконтоРасходов3;
			
			НоваяСтрока.Количество              = РасходУСН.ОплаченоКоличество;
			НоваяСтрока.СуммаВал                = РасходУСН.ОплаченоСуммаВал;
			НоваяСтрока.СуммаРуб                = РасходУСН.ОплаченоСуммаРуб;
			НоваяСтрока.СуммаНеУчитываетсяНУРуб = РасходУСН.ОплаченоСуммаНеУчитываетсяНУРуб;
			НоваяСтрока.СуммаЕНВДРуб            = РасходУСН.ОплаченоСуммаЕНВДРуб;
			НоваяСтрока.СуммаНДСРуб             = РасходУСН.ОплаченоСуммаНДСРуб;
			
			НоваяСтрока.КорСчетУСН = СчетУчетаОплаченныхРасходовУСН(
				НоваяСтрока.СчетУчетаУСН, НоваяСтрока.РасходыУСН, Реквизиты);
			
			НоваяСтрока.ДокументОплаты = Реквизиты.Ссылка;
			
			// Спишем рублевые остатки расходов (УСН), учтенные по курсу на дату документа поступления (партии).
			Если РасходУСН.Валюта <> БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета() Тогда
				
				Коэффициент = ?(РасходУСН.СуммаВал = 0, 0, РасходУСН.ОплаченоСуммаВал / РасходУСН.СуммаВал);
				
				Если Коэффициент * РасходУСН.СуммаРуб                <> РасходУСН.ОплаченоСуммаРуб
				 ИЛИ Коэффициент * РасходУСН.СуммаНДСРуб             <> РасходУСН.ОплаченоСуммаНДСРуб
				 ИЛИ Коэффициент * РасходУСН.СуммаЕНВДРуб            <> РасходУСН.ОплаченоСуммаЕНВДРуб
				 ИЛИ Коэффициент * РасходУСН.СуммаНеУчитываетсяНУРуб <> РасходУСН.ОплаченоСуммаНеУчитываетсяНУРуб Тогда
					
					КорректировкаСуммРуб = ТаблицаОплаченныхРасходовУСН.Добавить();
					ЗаполнитьЗначенияСвойств(КорректировкаСуммРуб, НоваяСтрока,
						"ИмяСписка,СинонимСписка,НомерСтроки,
						|ИФО,КФО,КПС,Подразделение,СчетРасчетов,Контрагент,Договор,ДокументРасчетов,Валюта,СчетУчетаУСН,РасходыУСН,
						|ВидСубконтоРасходов2,СубконтоРасходов2,ВидСубконтоРасходов3,СубконтоРасходов3");
					
					КорректировкаСуммРуб.СуммаРуб                = Коэффициент * РасходУСН.СуммаРуб                - РасходУСН.ОплаченоСуммаРуб;
					КорректировкаСуммРуб.СуммаНДСРуб             = Коэффициент * РасходУСН.СуммаНДСРуб             - РасходУСН.ОплаченоСуммаНДСРуб;
					КорректировкаСуммРуб.СуммаЕНВДРуб            = Коэффициент * РасходУСН.СуммаЕНВДРуб            - РасходУСН.ОплаченоСуммаЕНВДРуб;
					КорректировкаСуммРуб.СуммаНеУчитываетсяНУРуб = Коэффициент * РасходУСН.СуммаНеУчитываетсяНУРуб - РасходУСН.ОплаченоСуммаНеУчитываетсяНУРуб;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТаблицаОплаченныхРасходовУСН;
	
КонецФункции

// Оплата труда, налоги с ФОТ

Функция ВедетсяУчетРасчетовПоНалогу(ВидНалоговИПлатежей) Экспорт
	
	ВидыНалоговИПлатежей = Справочники.ВидыНалоговИПлатежей;
	
	Если ВидНалоговИПлатежей = ВидыНалоговИПлатежей.НДС
	 ИЛИ ВидНалоговИПлатежей = ВидыНалоговИПлатежей.НДФЛ
	 ИЛИ ВидНалоговИПлатежей = ВидыНалоговИПлатежей.СтраховыеВзносы_ПФРДополнительная
	 ИЛИ ВидНалоговИПлатежей = ВидыНалоговИПлатежей.СтраховыеВзносы_ПФРДополнительнаяЛетныхЭкипажей
	 ИЛИ ВидНалоговИПлатежей = ВидыНалоговИПлатежей.СтраховыеВзносы_ПФРДополнительнаяНаДоплатуКПенсииШахтерам
	 ИЛИ ВидНалоговИПлатежей = ВидыНалоговИПлатежей.СтраховыеВзносы_ПФРЗаЗанятыхНаПодземныхИВредныхРаботах
	 ИЛИ ВидНалоговИПлатежей = ВидыНалоговИПлатежей.СтраховыеВзносы_ПФРЗаЗанятыхНаПодземныхИВредныхРаботахБезСпецОценки
	 ИЛИ ВидНалоговИПлатежей = ВидыНалоговИПлатежей.СтраховыеВзносы_ПФРЗаЗанятыхНаПодземныхИВредныхРаботахСпецОценка
	 ИЛИ ВидНалоговИПлатежей = ВидыНалоговИПлатежей.СтраховыеВзносы_ПФРЗаЗанятыхНаТяжелыхИПрочихРаботах
	 ИЛИ ВидНалоговИПлатежей = ВидыНалоговИПлатежей.СтраховыеВзносы_ПФРЗаЗанятыхНаТяжелыхИПрочихРаботахБезСпецОценки
	 ИЛИ ВидНалоговИПлатежей = ВидыНалоговИПлатежей.СтраховыеВзносы_ПФРЗаЗанятыхНаТяжелыхИПрочихРаботахСпецОценка
	 ИЛИ ВидНалоговИПлатежей = ВидыНалоговИПлатежей.СтраховыеВзносы_ПФРНакопительная
	 ИЛИ ВидНалоговИПлатежей = ВидыНалоговИПлатежей.СтраховыеВзносы_ПФРПоСуммарномуТарифу
	 ИЛИ ВидНалоговИПлатежей = ВидыНалоговИПлатежей.СтраховыеВзносы_ПФРСтраховая
	 ИЛИ ВидНалоговИПлатежей = ВидыНалоговИПлатежей.СтраховыеВзносы_ТФОМС
	 ИЛИ ВидНалоговИПлатежей = ВидыНалоговИПлатежей.СтраховыеВзносы_ФСС
	 ИЛИ ВидНалоговИПлатежей = ВидыНалоговИПлатежей.СтраховыеВзносы_ФФОМС
	 ИЛИ ВидНалоговИПлатежей = ВидыНалоговИПлатежей.ФСС_Добровольные
	 ИЛИ ВидНалоговИПлатежей = ВидыНалоговИПлатежей.ФСС_НС
	 ИЛИ ВидНалоговИПлатежей = ВидыНалоговИПлатежей.СФР_НС
	Тогда
		// Начисление этих налогов проводится на счет У68 документами отражения зарплаты в учете,
		// поступления материальных запасов, услуг и пр. Расчеты по налогу ведутся на счете УРН.
		Возврат Истина;
	КонецЕсли;
	
	// Начисление этих налогов на счет У68 не производится, расчеты по ним не ведутся.
	// При выплате они сразу отражаются в расходах КУДиР (Дт У99) на всю сумму.
	Возврат Ложь;
	
КонецФункции

Функция ПодготовитьТаблицыРасходовПриОтраженииЗарплаты(Документ, Параметры = Неопределено, Отказ) Экспорт
	
	ОписаниеТипаСуммы        = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТиповСубконто    = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	// Идентификация строки.
	ПустаяТаблица.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	// Вид операции (начисления, удержания, отчисления).
	ПустаяТаблица.Колонки.Добавить("ВидОперации",   Новый ОписаниеТипов("Строка"));
	ПустаяТаблица.Колонки.Добавить("ВидОперацииОтраженияЗарплаты", Новый ОписаниеТипов("СправочникСсылка.ВидыОперацийОтраженияЗарплаты"));
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	// Счет и аналитика отражения начислений, удержаний, отчислений.
	ПустаяТаблица.Колонки.Добавить("Счет",          Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("Субконто1",     ОписаниеТиповСубконто);
	ПустаяТаблица.Колонки.Добавить("Субконто2",     ОписаниеТиповСубконто);
	ПустаяТаблица.Колонки.Добавить("Субконто3",     ОписаниеТиповСубконто);
	ПустаяТаблица.Колонки.Добавить("КЭК",           Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ПустаяТаблица.Колонки.Добавить("ВидЗатрат",     Новый ОписаниеТипов("СправочникСсылка.ВидыЗатрат"));
	ПустаяТаблица.Колонки.Добавить("ВидНалога",     Новый ОписаниеТипов("СправочникСсылка.ВидыНалоговИПлатежей"));
	ПустаяТаблица.Колонки.Добавить("Налог",         Новый ОписаниеТипов("СправочникСсылка.НалогиИПлатежиОрганизации"));
	// Сотрудник.
	ПустаяТаблица.Колонки.Добавить("СчетРасчетов",  Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("Контрагент",    Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ПустаяТаблица.Колонки.Добавить("Договор",       Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ПустаяТаблица.Колонки.Добавить("Валюта",        Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	// Отражение в налоговом учете при УСН.
	ПустаяТаблица.Колонки.Добавить("ОтражениеВУСН", Новый ОписаниеТипов("ПеречислениеСсылка.ОтражениеВУСН"));
	
	ПустаяТаблица.Колонки.Добавить("СуммаВал",      ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаРуб",      ОписаниеТипаСуммы);
	
	ТаблицыРасходов = Новый Структура;
	ТаблицыРасходов.Вставить("Начисления", ПустаяТаблица.Скопировать());
	ТаблицыРасходов.Вставить("Удержания",  ПустаяТаблица.Скопировать());
	ТаблицыРасходов.Вставить("НалогиСФОТ", ПустаяТаблица.Скопировать());
	
	Если НЕ УчетУСНВызовСервера.ПрименяетсяУСНДоходыМинусРасходы(Документ.Организация, Документ.Дата) Тогда
		Возврат ТаблицыРасходов;
	КонецЕсли;
	
	Если Параметры = Неопределено Тогда
		Параметры = Новый Структура;
	КонецЕсли;
	
	Параметры.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Параметры.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Параметры.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	
	КурсДокумента = Параметры.Курс / ?(Параметры.Кратность = 0, 1, Параметры.Кратность);
	
	Запрос = Новый Запрос;
	
	ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Операции",
		"НомерСтроки,ИФО,КФО,КПС,КЭК,Подразделение,Счет,Субконто1,Субконто2,Субконто3,
		|ВидОперации,ОсновнойКонтрагент,Контрагент,Договор,ВидНалога,Налог,ВалютаДокумента,ОтражениеВУСН,Сумма",
		Документ, Параметры);
	
	Запрос.Текст = Запрос.Текст +
	"ВЫБРАТЬ
	|	""Операции"" КАК ИмяСписка,
	|	""Операции"" КАК СинонимСписка,
	|	Операции.НомерСтроки КАК НомерСтроки,
	|	Операции.ИФО КАК ИФО,
	|	Операции.КФО КАК КФО,
	|	Операции.КПС КАК КПС,
	|	Операции.КЭК КАК КЭК,
	|	Операции.Подразделение КАК Подразделение,
	|	Операции.Счет КАК Счет,
	|	Операции.Субконто1 КАК Субконто1,
	|	Операции.Субконто2 КАК Субконто2,
	|	Операции.Субконто3 КАК Субконто3,
	|	Операции.ВидОперации КАК ВидОперацииОтраженияЗарплаты,
	|	Операции.ВидОперации.Код КАК ВидОперации,
	|	ВЫБОР
	|		КОГДА Операции.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА Операции.ОсновнойКонтрагент
	|		ИНАЧЕ Операции.Контрагент
	|	КОНЕЦ КАК Контрагент,
	|	ВЫБОР
	|		КОГДА Операции.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	|		ИНАЧЕ Операции.Договор
	|	КОНЕЦ КАК Договор,
	|	Операции.ВидНалога КАК ВидНалога,
	|	Операции.Налог КАК Налог,
	|	Операции.ОтражениеВУСН КАК ОтражениеВУСН,
	|	Операции.ВалютаДокумента КАК Валюта,
	|	Операции.Сумма КАК Сумма
	|ИЗ
	|	ТаблицаОперации КАК Операции
	|ГДЕ
	|	Операции.КФО В(&КФО)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	Запрос.УстановитьПараметр("КФО", УчетУСНКлиентСервер.МассивКФОдляНалоговогоУчетаУСН());
	
	ТаблицаОперации = Запрос.Выполнить().Выгрузить();
	
	// I. Обработаем начисления и отчисления.
	Для Каждого Строка Из ТаблицаОперации Цикл
		
		ЭтоНачисление = (Найти(Строка.ВидОперации, "Начисление") > 0);
		ЭтоОтчисления = (Найти(Строка.ВидОперации, "Отчисления") > 0)
					ИЛИ (Найти(Строка.ВидОперации, "СтраховыеВзносы") > 0)
					ИЛИ (Найти(Строка.ВидОперации, "ЕдиныйСтраховойТариф") > 0);
		
		Если ЭтоНачисление И Строка.Сумма <> 0 Тогда
			
			// Расходы на оплату труда.
			НоваяСтрока = ТаблицыРасходов.Начисления.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			
			НоваяСтрока.ВидОперации = СокрЛП(Строка.ВидОперации);
			
			НоваяСтрока.СуммаВал = Строка.Сумма;
			НоваяСтрока.СуммаРуб = Строка.Сумма * КурсДокумента;
			
		ИначеЕсли ЭтоОтчисления И Строка.Сумма <> 0 Тогда
			
			// Расходы на уплату налогов с ФОТ.
			НоваяСтрока = ТаблицыРасходов.НалогиСФОТ.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			
			НоваяСтрока.ВидОперации = СокрЛП(Строка.ВидОперации);
			
			НоваяСтрока.СуммаВал = Строка.Сумма;
			НоваяСтрока.СуммаРуб = Строка.Сумма * КурсДокумента;
			
		Иначе
			Продолжить;
		КонецЕсли;
		
		СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Строка.Счет);
		Если СвойстваСчета.ВидСубконто1 = ПланыВидовХарактеристик.ВидыСубконто.ВидыЗатрат Тогда
			НоваяСтрока.ВидЗатрат = НоваяСтрока.Субконто1;
		ИначеЕсли СвойстваСчета.ВидСубконто2 = ПланыВидовХарактеристик.ВидыСубконто.ВидыЗатрат Тогда
			НоваяСтрока.ВидЗатрат = НоваяСтрока.Субконто2;
		ИначеЕсли СвойстваСчета.ВидСубконто3 = ПланыВидовХарактеристик.ВидыСубконто.ВидыЗатрат Тогда
			НоваяСтрока.ВидЗатрат = НоваяСтрока.Субконто3;
		КонецЕсли;
		
		Если НоваяСтрока.ВидОперации = "НачислениеПособияФСС"
		 ИЛИ НоваяСтрока.ВидОперации = "НачислениеНСиПЗ" Тогда
			// Согласно абз. 2 п. 1 ст. 252 НК РФ расходами признаются затраты, осуществленные (понесенные) налогоплательщиком.
			// Суммы, выплачиваемые за счет ФСС, не являются расходами, понесенными организацией самостоятельно.
			НоваяСтрока.ОтражениеВУСН = Перечисления.ОтражениеВУСН.НеПринимаются;
		ИначеЕсли ЗначениеЗаполнено(Строка.ОтражениеВУСН) Тогда // Отражение в УСН явно указано в строке документа.
			НоваяСтрока.ОтражениеВУСН = Строка.ОтражениеВУСН;
		ИначеЕсли Параметры.Свойство("АвтоОтражениеВУСН")
			И ЗначениеЗаполнено(Параметры.АвтоОтражениеВУСН) Тогда // Отражение в УСН определено типовой операцией.
			НоваяСтрока.ОтражениеВУСН = Параметры.АвтоОтражениеВУСН;
		ИначеЕсли ЗначениеЗаполнено(НоваяСтрока.ВидЗатрат) Тогда // Отражение в УСН определим из вида затрат.
			НоваяСтрока.ОтражениеВУСН = УчетУСН.ОтражениеВУСНпоВидуЗатрат(НоваяСтрока.ВидЗатрат);
		Иначе
			НоваяСтрока.ОтражениеВУСН = Перечисления.ОтражениеВУСН.НеПринимаются;
		КонецЕсли;
		
	КонецЦикла;
	
	// II. Обработаем удержания.
	Для Каждого Строка Из ТаблицаОперации Цикл
		
		ЭтоУдержания = (Найти(Строка.ВидОперации, "Удержания") > 0);
		Если ЭтоУдержания И Строка.Сумма <> 0 Тогда
			
			ОтборНачислений = Новый Структура("ИФО,КФО,КПС,КЭК,Подразделение,Контрагент,Договор,Валюта");
			ЗаполнитьЗначенияСвойств(ОтборНачислений, Строка);
			
			НачисленияВЭтомДокументе = ТаблицыРасходов.Начисления.Скопировать(ОтборНачислений);
			ВсегоНачисленийВЭтомДокументе = НачисленияВЭтомДокументе.Итог("СуммаВал");
			СуммаУдержанийКРаспределению  = Мин(Строка.Сумма, ВсегоНачисленийВЭтомДокументе);
			
			Если СуммаУдержанийКРаспределению > 0 Тогда
				
				// 1. Распределим сумму удержаний по начислениям в этом документе.
				ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(Строка.Сумма * КурсДокумента,
					НачисленияВЭтомДокументе, "СуммаРуб", "СуммаВал");
				
				ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(Строка.Сумма,
					НачисленияВЭтомДокументе, "СуммаВал");
				
				Для Каждого СтрокаНачислений Из НачисленияВЭтомДокументе Цикл
					
					НоваяСтрока = ТаблицыРасходов.Удержания.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
					
					// Запомним, к какому начислению относится это удержание.
					НоваяСтрока.НомерСтроки   = СтрокаНачислений.НомерСтроки;
					НоваяСтрока.ОтражениеВУСН = СтрокаНачислений.ОтражениеВУСН;
					
					Если СокрЛП(Строка.ВидОперации) = "УдержанияПФРДополнительная"
					 ИЛИ СокрЛП(Строка.ВидОперации) = "УдержанияНДФЛ"
					 ИЛИ СокрЛП(Строка.ВидОперации) = "УдержанияНДФЛСПревышения" Тогда
						
						НоваяСтрока.СуммаВал = СтрокаНачислений.СуммаВал;
						НоваяСтрока.СуммаРуб = СтрокаНачислений.СуммаРуб;
						
						НоваяСтрока = ТаблицыРасходов.НалогиСФОТ.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
						
						НоваяСтрока.ОтражениеВУСН = СтрокаНачислений.ОтражениеВУСН;
						
						НоваяСтрока.СуммаВал = СтрокаНачислений.СуммаВал;
						НоваяСтрока.СуммаРуб = СтрокаНачислений.СуммаРуб;
						
					ИначеЕсли СокрЛП(Строка.ВидОперации) = "УдержанияНДФЛПередачаЗадолженностиВНалоговыйОрган" Тогда
						
						НоваяСтрока.СуммаВал = (-1) * СтрокаНачислений.СуммаВал;
						НоваяСтрока.СуммаРуб = (-1) * СтрокаНачислений.СуммаРуб;
						
						НоваяСтрока = ТаблицыРасходов.НалогиСФОТ.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
						
						НоваяСтрока.ОтражениеВУСН = СтрокаНачислений.ОтражениеВУСН;
						
						// Операция отражается в учете как сторно удержания НДФЛ.
						НоваяСтрока.СуммаВал = (-1) * СтрокаНачислений.СуммаВал;
						НоваяСтрока.СуммаРуб = (-1) * СтрокаНачислений.СуммаРуб;
						
					ИначеЕсли СокрЛП(Строка.ВидОперации) = "УдержанияРазные" Тогда
						
						НоваяСтрока.СуммаВал = СтрокаНачислений.СуммаВал;
						НоваяСтрока.СуммаРуб = СтрокаНачислений.СуммаРуб;
						
						НоваяСтрока = ТаблицыРасходов.Начисления.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
						
						// Счет и Субконто1 могут быть установлены в окне "Настройка отражения расходов в учете".
						Если ЗначениеЗаполнено(Строка.Счет) Тогда
							НоваяСтрока.СчетРасчетов = Строка.Счет;
						Иначе
							НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.СчетПоКоду("304.03", Документ.Дата, Документ.Организация);
						КонецЕсли;
						Если ЗначениеЗаполнено(Строка.Субконто1) Тогда
							НоваяСтрока.Контрагент = Строка.Субконто1;
						КонецЕсли;
						
						НоваяСтрока.ОтражениеВУСН = СтрокаНачислений.ОтражениеВУСН;
						
						НоваяСтрока.СуммаВал = СтрокаНачислений.СуммаВал;
						НоваяСтрока.СуммаРуб = СтрокаНачислений.СуммаРуб;
						
					КонецЕсли;
					
				КонецЦикла;
				
				// 2. Нераспределенный остаток удержаний распределим по остаткам начислений.
				НеРаспределеноУдержанийРуб = Строка.Сумма * КурсДокумента - НачисленияВЭтомДокументе.Итог("СуммаРуб");
				НеРаспределеноУдержанийВал = Строка.Сумма - НачисленияВЭтомДокументе.Итог("СуммаВал");
				Если НеРаспределеноУдержанийРуб > 0 ИЛИ НеРаспределеноУдержанийВал > 0 Тогда
					
					// Получим остатки неоплаченных расходов УСН по оплаченным документам расчетов.
					СчетаНачислений = БухгалтерскийУчет.СписокСчетов("У70.О");
					
					ОтборРасходов = Новый Структура;
					ОтборРасходов.Вставить("ВидРасхода", Перечисления.ВидыРасходовУСН.ОплатаТруда);
					ОтборРасходов.Вставить("Контрагент", Строка.Контрагент);
					ОтборРасходов.Вставить("Договор",    Строка.Договор);
					ОтборРасходов.Вставить("Валюта",     Строка.Валюта);
					
					Если Параметры.ИспользоватьУчетПоИФО Тогда
						ОтборРасходов.Вставить("ИФО", Строка.ИФО);
					КонецЕсли;
					//Если Параметры.ИспользоватьУчетПоПодразделениям Тогда
					//	ОтборРасходов.Вставить("Подразделение", Строка.Подразделение);
					//КонецЕсли;
					ОтборРасходов.Вставить("КФО", Строка.КФО);
					
					ПериодОстатков = Новый Граница(Документ.Ссылка.МоментВремени(), ВидГраницы.Исключая);
					ОстаткиРасходовУСН = ОстаткиРасходовУСН(ПериодОстатков, СчетаНачислений, ОтборРасходов, Параметры);
					ОбщегоНазначенияБГУ.УпорядочитьТаблицуПоДокументу(ОстаткиРасходовУСН, "ДокументРасчетов", "ДатаДокументаРасчетов");
					
					ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(НеРаспределеноУдержанийРуб,
						ОстаткиРасходовУСН, "СуммаРуб", "СуммаВал");
					
					ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(НеРаспределеноУдержанийВал,
						ОстаткиРасходовУСН, "СуммаВал");
					
					Для Каждого СтрокаОстатков Из ОстаткиРасходовУСН Цикл
						
						НоваяСтрока = ТаблицыРасходов.Удержания.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОстатков);
						
						// Запомним, к какому начислению относится это удержание.
						НоваяСтрока.НомерСтроки   = СтрокаОстатков.НомерСтрокиДокумента;
						НоваяСтрока.ОтражениеВУСН = СтрокаОстатков.ОтражениеВУСН;
						
						НоваяСтрока.СуммаВал = СтрокаОстатков.СуммаВал;
						НоваяСтрока.СуммаРуб = СтрокаОстатков.СуммаРуб;
						
						Если СокрЛП(Строка.ВидОперации) = "УдержанияПФРДополнительная"
						 ИЛИ СокрЛП(Строка.ВидОперации) = "УдержанияНДФЛ"
						 ИЛИ СокрЛП(Строка.ВидОперации) = "УдержанияНДФЛСПревышения" Тогда
							
							НоваяСтрока = ТаблицыРасходов.НалогиСФОТ.Добавить();
							ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
							
							НоваяСтрока.ОтражениеВУСН = СтрокаОстатков.ОтражениеВУСН;
							
							НоваяСтрока.СуммаВал = СтрокаОстатков.СуммаВал;
							НоваяСтрока.СуммаРуб = СтрокаОстатков.СуммаРуб;
							
						ИначеЕсли СокрЛП(Строка.ВидОперации) = "УдержанияНДФЛПередачаЗадолженностиВНалоговыйОрган" Тогда
							
							НоваяСтрока = ТаблицыРасходов.НалогиСФОТ.Добавить();
							ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
							
							НоваяСтрока.ОтражениеВУСН = СтрокаОстатков.ОтражениеВУСН;
							
							// Операция отражается в учете как сторно удержания НДФЛ.
							НоваяСтрока.СуммаВал = (-1) * СтрокаОстатков.СуммаВал;
							НоваяСтрока.СуммаРуб = (-1) * СтрокаОстатков.СуммаРуб;
							
						КонецЕсли;
						
					КонецЦикла;
					
				КонецЕсли;
				
			Иначе
				
				НоваяСтрока = ТаблицыРасходов.Удержания.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
				
				НоваяСтрока.ОтражениеВУСН = Перечисления.ОтражениеВУСН.НеПринимаются;
				
				НоваяСтрока.СуммаВал = Строка.Сумма;
				НоваяСтрока.СуммаРуб = Строка.Сумма * КурсДокумента;
				
				Если СокрЛП(Строка.ВидОперации) = "УдержанияПФРДополнительная"
				 ИЛИ СокрЛП(Строка.ВидОперации) = "УдержанияНДФЛ"
				 ИЛИ СокрЛП(Строка.ВидОперации) = "УдержанияНДФЛСПревышения" Тогда
					
					НоваяСтрока = ТаблицыРасходов.НалогиСФОТ.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
					
					НоваяСтрока.ОтражениеВУСН = Перечисления.ОтражениеВУСН.НеПринимаются;
					
					НоваяСтрока.СуммаВал = Строка.Сумма;
					НоваяСтрока.СуммаРуб = Строка.Сумма * КурсДокумента;
					
				ИначеЕсли СокрЛП(Строка.ВидОперации) = "УдержанияНДФЛПередачаЗадолженностиВНалоговыйОрган" Тогда
					
					НоваяСтрока = ТаблицыРасходов.НалогиСФОТ.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
					
					НоваяСтрока.ОтражениеВУСН = Перечисления.ОтражениеВУСН.НеПринимаются;
					
					// Операция отражается в учете как сторно удержания НДФЛ.
					НоваяСтрока.СуммаВал = (-1) * Строка.Сумма;
					НоваяСтрока.СуммаРуб = (-1) * Строка.Сумма * КурсДокумента;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицыРасходов.Удержания.Свернуть("ИмяСписка,СинонимСписка,НомерСтроки,
		|ИФО,КФО,КПС,КЭК,Подразделение,Счет,Субконто1,Субконто2,Субконто3,ВидЗатрат,
		|ВидОперации,ВидОперацииОтраженияЗарплаты,Контрагент,Договор,Валюта,ОтражениеВУСН", "СуммаВал,СуммаРуб");
	ТаблицыРасходов.Удержания.Сортировать("ИмяСписка,НомерСтроки");
	
	ТаблицыРасходов.НалогиСФОТ.Свернуть("ИмяСписка,СинонимСписка,НомерСтроки,
		|ИФО,КФО,КПС,КЭК,Подразделение,Счет,Субконто1,Субконто2,Субконто3,ВидЗатрат,ВидНалога,Налог,
		|ВидОперации,ВидОперацииОтраженияЗарплаты,Контрагент,Договор,Валюта,ОтражениеВУСН", "СуммаВал,СуммаРуб");
	ТаблицыРасходов.НалогиСФОТ.Сортировать("ИмяСписка,НомерСтроки");
	
	Возврат ТаблицыРасходов;
	
КонецФункции

Функция ПустаяТаблицаРасходыУСННаОплатуТрудаИНалогиСФОТ() Экспорт

	ПустаяТаблица = ПустаяТаблицаПоступлениеРасходовУСН();
	
	// Дополнительные колонки.
	ПустаяТаблица.Колонки.Добавить("ВидОперации", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	
	Возврат ПустаяТаблица;

КонецФункции

Функция ТаблицаРасходыУСННаОплатуТрудаИНалогиСФОТ(ТаблицыПоступления, Реквизиты, Отказ) Экспорт
	
	ТаблицаРасходовУСН = ПустаяТаблицаРасходыУСННаОплатуТрудаИНалогиСФОТ();
	
	УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Реквизиты.Организация, Реквизиты.Дата);
	Если НЕ УчетнаяПолитика.ПрименяетсяУСНДоходыМинусРасходы Тогда
		Возврат ТаблицаРасходовУСН;
	КонецЕсли;
	
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	
	// Оплата труда (начисления).
	Если ТаблицыПоступления.Свойство("Начисления")
	   И ТаблицыПоступления.Начисления.Количество() > 0 Тогда
		
		Для Каждого СтрокаДокумента Из ТаблицыПоступления.Начисления Цикл
			
			Если НЕ УчетУСНКлиентСервер.ВедетсяУчетУСНпоКФО(СтрокаДокумента.КФО) Тогда
				Продолжить;
			КонецЕсли;
			
			РасходУСН = ТаблицаРасходовУСН.Добавить();
			ЗаполнитьЗначенияСвойств(РасходУСН, СтрокаДокумента,
				"ИмяСписка,СинонимСписка,НомерСтроки,ИФО,КФО,КПС,Подразделение,ВидОперации,СчетРасчетов,Контрагент,Договор,Валюта");
			
			РасходУСН.ИмяСпискаДокумента   = СтрокаДокумента.ИмяСписка;
			РасходУСН.НомерСтрокиДокумента = СтрокаДокумента.НомерСтроки;
		
			РасходУСН.ВидРасхода     = Перечисления.ВидыРасходовУСН.ОплатаТруда;
			РасходУСН.ЭлементРасхода = СтрокаДокумента.Контрагент;
			
			Если ЗначениеЗаполнено(СтрокаДокумента.ОтражениеВУСН) Тогда
				РасходУСН.ОтражениеВУСН = СтрокаДокумента.ОтражениеВУСН;
			Иначе
				РасходУСН.ОтражениеВУСН = Перечисления.ОтражениеВУСН.НеПринимаются;
			КонецЕсли;
			
			РасходУСН.СчетУчетаУСН = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У70.О");
			Если НЕ ЗначениеЗаполнено(РасходУСН.СчетРасчетов) Тогда
				РасходУСН.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
					СтрокаДокумента.КЭК, "302.00", , Реквизиты.Дата, Реквизиты.Организация, СтрокаДокумента.ИФО);
			КонецЕсли;
			
			РасходУСН.ВидСубконтоРасходов2 = ПланыВидовХарактеристик.ВидыСубконто.Контрагенты;
			РасходУСН.СубконтоРасходов2    = СтрокаДокумента.Контрагент;
			
			РасходУСН.СуммаВал = СтрокаДокумента.СуммаВал;
			Если РасходУСН.ОтражениеВУСН = Перечисления.ОтражениеВУСН.НеПринимаются Тогда
				РасходУСН.СуммаНеУчитываетсяНУРуб = СтрокаДокумента.СуммаРуб;
			ИначеЕсли РасходУСН.ОтражениеВУСН = Перечисления.ОтражениеВУСН.ОсобыйПорядок Тогда
				РасходУСН.СуммаЕНВДРуб = СтрокаДокумента.СуммаРуб;
			Иначе
				РасходУСН.СуммаРуб = СтрокаДокумента.СуммаРуб;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Удержания.
	Если ТаблицыПоступления.Свойство("Удержания")
	   И ТаблицыПоступления.Удержания.Количество() > 0 Тогда
		
		Для Каждого СтрокаДокумента Из ТаблицыПоступления.Удержания Цикл
			
			Если НЕ УчетУСНКлиентСервер.ВедетсяУчетУСНпоКФО(СтрокаДокумента.КФО) Тогда
				Продолжить;
			КонецЕсли;
			
			РасходУСН = ТаблицаРасходовУСН.Добавить();
			ЗаполнитьЗначенияСвойств(РасходУСН, СтрокаДокумента,
				"ИмяСписка,СинонимСписка,НомерСтроки,ИФО,КФО,КПС,Подразделение,ВидОперации,Контрагент,Договор,Валюта,ОтражениеВУСН");
			
			РасходУСН.ИмяСпискаДокумента   = СтрокаДокумента.ИмяСписка;
			РасходУСН.НомерСтрокиДокумента = СтрокаДокумента.НомерСтроки;
		
			РасходУСН.ВидРасхода     = Перечисления.ВидыРасходовУСН.ОплатаТруда;
			РасходУСН.ЭлементРасхода = СтрокаДокумента.Контрагент;
			
			РасходУСН.СчетУчетаУСН = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У70.О");
			РасходУСН.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
				СтрокаДокумента.КЭК, "302.00", , Реквизиты.Дата, Реквизиты.Организация, СтрокаДокумента.ИФО);
			
			РасходУСН.ВидСубконтоРасходов2 = ПланыВидовХарактеристик.ВидыСубконто.Контрагенты;
			РасходУСН.СубконтоРасходов2    = СтрокаДокумента.Контрагент;
			
			РасходУСН.СуммаВал = - СтрокаДокумента.СуммаВал;
			Если РасходУСН.ОтражениеВУСН = Перечисления.ОтражениеВУСН.НеПринимаются Тогда
				РасходУСН.СуммаНеУчитываетсяНУРуб = - СтрокаДокумента.СуммаРуб;
			ИначеЕсли РасходУСН.ОтражениеВУСН = Перечисления.ОтражениеВУСН.ОсобыйПорядок Тогда
				РасходУСН.СуммаЕНВДРуб = - СтрокаДокумента.СуммаРуб;
			Иначе
				РасходУСН.СуммаРуб = - СтрокаДокумента.СуммаРуб;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Налоги с ФОТ.
	Если ТаблицыПоступления.Свойство("НалогиСФОТ")
	   И ТаблицыПоступления.НалогиСФОТ.Количество() > 0 Тогда
		
		// Соответствие видов операций отражения зарплаты и счетов учета.
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ВидыОперацийОтраженияЗарплаты.Ссылка КАК ВидОперации,
		|	ВидыОперацийОтраженияЗарплаты.ВидНалога КАК ВидНалога,
		|	ВидыОперацийОтраженияЗарплаты.ВидНалога.СчетУчета КАК КодСчетаУчета
		|ИЗ
		|	Справочник.ВидыОперацийОтраженияЗарплаты КАК ВидыОперацийОтраженияЗарплаты
		|ГДЕ
		|	ВидыОперацийОтраженияЗарплаты.ЭтоВзносы";
		ВидыОперацийОтраженияЗарплаты = Запрос.Выполнить().Выгрузить();
		
		Для Каждого СтрокаДокумента Из ТаблицыПоступления.НалогиСФОТ Цикл
			
			Если НЕ УчетУСНКлиентСервер.ВедетсяУчетУСНпоКФО(СтрокаДокумента.КФО) Тогда
				Продолжить;
			КонецЕсли;
			
			РасходУСН = ТаблицаРасходовУСН.Добавить();
			ЗаполнитьЗначенияСвойств(РасходУСН, СтрокаДокумента,
				"ИмяСписка,СинонимСписка,НомерСтроки,ИФО,КФО,КПС,Подразделение,ВидОперации,Контрагент,Договор,Валюта");
			
			РасходУСН.ИмяСпискаДокумента   = СтрокаДокумента.ИмяСписка;
			РасходУСН.НомерСтрокиДокумента = СтрокаДокумента.НомерСтроки;
		
			РасходУСН.ВидРасхода = Перечисления.ВидыРасходовУСН.Налоги;
			
			// Вид налога определяется по аналогии с типовыми операциями документа (СубконтоКт1).
			ВидНалога = Справочники.ВидыНалоговИПлатежей.ПустаяСсылка();
			Если ЗначениеЗаполнено(СтрокаДокумента.Счет)
				И ТипЗнч(СтрокаДокумента.Субконто1) = Тип("СправочникСсылка.ВидыНалоговИПлатежей") Тогда
				ВидНалога = СтрокаДокумента.Субконто1;
			ИначеЕсли ЗначениеЗаполнено(СтрокаДокумента.ВидНалога) Тогда
				ВидНалога = СтрокаДокумента.ВидНалога;
			ИначеЕсли ЗначениеЗаполнено(СтрокаДокумента.Налог) Тогда
				ВидНалога = СтрокаДокумента.Налог.ВидНалогаИлиПлатежа;
			Иначе
				ВидОперацииОтраженияЗарплаты = ВидыОперацийОтраженияЗарплаты.Найти(СтрокаДокумента.ВидОперацииОтраженияЗарплаты, "ВидОперации");
				Если ВидОперацииОтраженияЗарплаты <> Неопределено Тогда
					ВидНалога = ВидОперацииОтраженияЗарплаты.ВидНалога;
				КонецЕсли;
			КонецЕсли;
			Если Не ЗначениеЗаполнено(ВидНалога) Тогда
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
					НСтр("ru = 'Вид налога'"), СтрокаДокумента.НомерСтроки, СтрокаДокумента.СинонимСписка);
				ПолеКолонки = "Объект." + СтрокаДокумента.ИмяСписка + "[" + Формат(СтрокаДокумента.НомерСтроки-1, "ЧН=0; ЧГ=") + "].ВидНалога";
				БухгалтерскиеОперацииСервер.ДобавитьСообщениеОбОшибке(ТекстСообщения, ПолеКолонки, Отказ);
			КонецЕсли;
			РасходУСН.ЭлементРасхода = ВидНалога;
			
			Если ЗначениеЗаполнено(ВидНалога) Тогда
				РеквизитыВидаНалога = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВидНалога, "СчетУчета");
				Если Справочники.ВидыНалоговИПлатежей.ОплачиваетсяЧерезЕНП(ВидНалога, Реквизиты.Организация) Тогда
					// Для налогов (платежей), оплачиваемых через ЕНП, расчеты ведутся на счете 303.хх. Счет УРН не используется.
					РасходУСН.СчетРасчетов = БухгалтерскийУчет.СчетПоКоду(РеквизитыВидаНалога.СчетУчета, Реквизиты.Дата, Реквизиты.Организация);
				Иначе // Для остальных налогов (платежей) расчеты ведутся на счете УРН.
					РасходУСН.СчетРасчетов = БухгалтерскийУчет.СчетПоКоду("УРН", Реквизиты.Дата, Реквизиты.Организация);
				КонецЕсли;
			Иначе
				РасходУСН.СчетРасчетов = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
			КонецЕсли;
			
			// Отражение в расходах УСН.
			Если ЗначениеЗаполнено(СтрокаДокумента.ОтражениеВУСН) Тогда // Отражение в УСН явно указано в строке документа.
				РасходУСН.ОтражениеВУСН = СтрокаДокумента.ОтражениеВУСН;
			ИначеЕсли Реквизиты.Свойство("АвтоОтражениеВУСН")
				И ЗначениеЗаполнено(Реквизиты.АвтоОтражениеВУСН) Тогда // Отражение в УСН определено типовой операцией.
				РасходУСН.ОтражениеВУСН = Реквизиты.АвтоОтражениеВУСН;
			ИначеЕсли ЗначениеЗаполнено(СтрокаДокумента.ВидЗатрат) Тогда // Отражение в УСН определим из вида затрат.
				РасходУСН.ОтражениеВУСН = УчетУСН.ОтражениеВУСНпоВидуЗатрат(СтрокаДокумента.ВидЗатрат);
			Иначе
				РасходУСН.ОтражениеВУСН = Перечисления.ОтражениеВУСН.НеПринимаются;
			КонецЕсли;
			
			РасходУСН.СчетУчетаУСН         = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У68.О");
			РасходУСН.ВидСубконтоРасходов2 = ПланыВидовХарактеристик.ВидыСубконто.ВидыНалоговИПлатежей;
			РасходУСН.СубконтоРасходов2    = РасходУСН.ЭлементРасхода;
			
			РасходУСН.СуммаВал = СтрокаДокумента.СуммаВал;
			Если РасходУСН.ОтражениеВУСН = Перечисления.ОтражениеВУСН.НеПринимаются Тогда
				РасходУСН.СуммаНеУчитываетсяНУРуб = СтрокаДокумента.СуммаРуб;
			ИначеЕсли РасходУСН.ОтражениеВУСН = Перечисления.ОтражениеВУСН.ОсобыйПорядок Тогда
				РасходУСН.СуммаЕНВДРуб = СтрокаДокумента.СуммаРуб;
			Иначе
				РасходУСН.СуммаРуб = СтрокаДокумента.СуммаРуб;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ТаблицаРасходовУСН.ЗаполнитьЗначения(Реквизиты.Ссылка, "Партия");
	ТаблицаРасходовУСН.ЗаполнитьЗначения(Реквизиты.Ссылка, "ДокументРасчетов");
	
	ТаблицаРасходовУСН.Сортировать("ИмяСпискаДокумента,НомерСтрокиДокумента");
	
	// Формируем элементы учета расходов УСН.
	СформироватьЭлементыУчетаРасходовУСН(Реквизиты.Ссылка, ТаблицаРасходовУСН);
	
	Возврат ТаблицаРасходовУСН;
	
КонецФункции

Функция ПустаяТаблицаНачисленияЗаСчетНалоговыхПлатежей() Экспорт

	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	// Идентификация строки.
	ПустаяТаблица.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("КЭК",           Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ПустаяТаблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	// Счет и аналитика учета расчетов по налогам и сборам.
	ПустаяТаблица.Колонки.Добавить("СчетРасчетов",  Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("ВидНалога",     Новый ОписаниеТипов("СправочникСсылка.ВидыНалоговИПлатежей"));
	ПустаяТаблица.Колонки.Добавить("Валюта",        Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	ПустаяТаблица.Колонки.Добавить("ДокументРасчетов",
		ПланыВидовХарактеристик.ВидыСубконто.ДокументыРасчетов.ТипЗначения);
	// Суммовые показатели операции.
	ПустаяТаблица.Колонки.Добавить("СуммаВал", ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаРуб", ОписаниеТипаСуммы);
	// Дополнительные колонки.
	ПустаяТаблица.Колонки.Добавить("ВидОперации", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	
	Возврат ПустаяТаблица;

КонецФункции

// Подготавливает таблицу расшифровки налогового платежа (для целей УСН).
//
Функция ПодготовитьТаблицуНачисленийЗаСчетНалоговыхПлатежейПоДокументу(Документ, Параметры = Неопределено, Отказ) Экспорт
	
	ТаблицаНачислений = ПустаяТаблицаНачисленияЗаСчетНалоговыхПлатежей();
	
	Если Параметры = Неопределено Тогда
		Параметры = Новый Структура;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	МетаданныеДокумента = Документ.Метаданные();
	
	Запрос = Новый Запрос;
	
	Если МетаданныеДокумента.Имя = "ОтражениеЗарплатыВУчете" Тогда
		
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Операции",
			"НомерСтроки,ИФО,КФО,КПС,КЭК,Подразделение,
			|ВидОперации,ОсновнойКонтрагент,Контрагент,Договор,ВалютаДокумента,Сумма",
			Документ, Параметры);
		
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	""Операции"" КАК ИмяСписка,
		|	""Операции"" КАК СинонимСписка,
		|	Операции.НомерСтроки КАК НомерСтроки,
		|	Операции.ИФО КАК ИФО,
		|	Операции.КФО КАК КФО,
		|	Операции.КПС КАК КПС,
		|	Операции.КЭК КАК КЭК,
		|	Операции.Подразделение КАК Подразделение,
		|	Операции.ВидОперации.Код КАК ВидОперации,
		|	ВЫБОР
		|		КОГДА Операции.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|			ТОГДА Операции.ОсновнойКонтрагент
		|		ИНАЧЕ Операции.Контрагент
		|	КОНЕЦ КАК Контрагент,
		|	ВЫБОР
		|		КОГДА Операции.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|			ТОГДА ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
		|		ИНАЧЕ Операции.Договор
		|	КОНЕЦ КАК Договор,
		|	Операции.ВалютаДокумента КАК Валюта,
		|	Операции.Сумма КАК СуммаВал,
		|	Операции.Сумма * &КурсДокумента КАК СуммаРуб
		|ИЗ
		|	ТаблицаОперации КАК Операции
		|ГДЕ
		|	Операции.КФО В(&КФО)
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
		Запрос.УстановитьПараметр("КФО", УчетУСНКлиентСервер.МассивКФОдляНалоговогоУчетаУСН());
		Запрос.УстановитьПараметр("КурсДокумента", Параметры.Курс / ?(Параметры.Кратность = 0, 1, Параметры.Кратность));
		
		ТаблицаОперации = Запрос.Выполнить().Выгрузить();
		Для Каждого Строка Из ТаблицаОперации Цикл
			
			Если СокрЛП(Строка.ВидОперации) = "НачислениеПособияФСС" Тогда
			
				НоваяСтрока = ТаблицаНачислений.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
				
				НоваяСтрока.ВидНалога    = Справочники.ВидыНалоговИПлатежей.СтраховыеВзносы_ФСС; // 303.02
				НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.СчетПоКоду("УРН", Документ.Дата, Документ.Организация);
				
			ИначеЕсли СокрЛП(Строка.ВидОперации) = "НачислениеНСиПЗ" Тогда
				
				НоваяСтрока = ТаблицаНачислений.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
				
				НоваяСтрока.ВидНалога    = Справочники.ВидыНалоговИПлатежей.ВидНалогаНСиПЗ(Документ.Дата); // 303.06
				НоваяСтрока.СчетРасчетов = БухгалтерскийУчет.СчетПоКоду("УРН", Документ.Дата, Документ.Организация);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ТаблицаНачислений.ЗаполнитьЗначения(Документ, "ДокументРасчетов");
	
	Возврат ТаблицаНачислений;
	
КонецФункции

// Удержания из оплаты труда (алименты и пр.)

// Признание расходов при отражении удержаний из оплаты труда документом Отражение зарплаты в учете.
Функция ТаблицаОплаченныеАвансомУдержанияИзОплатыТруда(ТаблицаПоступлениеРасходовУСН, Реквизиты, Отказ) Экспорт
	
	ТаблицаОплаченныхРасходовУСН = УчетУСН.ПустаяТаблицаОплаченныхРасходовУСН();
	
	УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Реквизиты.Организация, Реквизиты.Дата);
	Если НЕ УчетнаяПолитика.ПрименяетсяУСНДоходыМинусРасходы Тогда
		Возврат ТаблицаОплаченныхРасходовУСН;
	КонецЕсли;
	Если ТаблицаПоступлениеРасходовУСН.Количество() = 0 Тогда
		Возврат ТаблицаОплаченныхРасходовУСН;
	КонецЕсли;
	
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	
	// Параметры учетной политики в части учета расходов УСН.
	Реквизиты.Вставить("ТоварыПоОплате", УчетнаяПолитика.ПорядокПризнанияРасходовПоТоварам =
		Перечисления.ПорядокПризнанияРасходовПоТоварам.ПоОплатеПоставщику);
	Реквизиты.Вставить("ТоварыПоОтгрузке", УчетнаяПолитика.ПорядокПризнанияРасходовПоТоварам =
		Перечисления.ПорядокПризнанияРасходовПоТоварам.ПоФактуРеализации);
	Реквизиты.Вставить("МатериалыПоОплате", УчетнаяПолитика.ПорядокПризнанияМатериальныхРасходов =
		Перечисления.ПорядокПризнанияМатериальныхРасходов.ПоОплатеПоставщику);
	Реквизиты.Вставить("ДопРасходыПоОплате", УчетнаяПолитика.ПорядокПризнанияДопРасходов =
		Перечисления.ПорядокПризнанияДопРасходов.ПоОплатеПоставщику);
	Реквизиты.Вставить("ТаможенныеПлатежиПоОплате", УчетнаяПолитика.ПорядокПризнанияТаможенныхПлатежей =
		Перечисления.ПорядокПризнанияТаможенныхПлатежей.ПоОплате);
	Реквизиты.Вставить("НДСПоОплате", УчетнаяПолитика.ПорядокПризнанияРасходовПоНДС =
		Перечисления.ПорядокПризнанияРасходовПоНДС.ПоОплатеПоставщику);
	
	Отбор = Новый Структура("СчетРасчетов", БухгалтерскийУчет.СчетПоКоду("304.03", Реквизиты.Дата, Реквизиты.Организация));
	УдержанияИзОплатыТруда = ТаблицаПоступлениеРасходовУСН.Скопировать(Отбор);
	УдержанияИзОплатыТруда.Колонки.Добавить("КЭК", Новый ОписаниеТипов("СправочникСсылка.КОСГУ")); // Учет по КЭК на счете 304.03 не ведется.
	УдержанияИзОплатыТруда.Колонки.Добавить("СчетАвансов", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	Для Каждого Удержание Из УдержанияИзОплатыТруда Цикл
		Удержание.СчетАвансов = Удержание.СчетРасчетов; // Нет отдельного счета авансов для счета 304.03.
	КонецЦикла;
	
	// Подготовим таблицу остатков авансов.
	ОстаткиАвансов = УчетРасчетов.ОстаткиАвансов(Реквизиты.Дата, УдержанияИзОплатыТруда, Реквизиты);
	Если ОстаткиАвансов.Количество() = 0 Тогда
		Возврат ТаблицаОплаченныхРасходовУСН;
	КонецЕсли;
	ОстаткиАвансов.Свернуть("ИФО,КФО,КПС,Подразделение,СчетАвансов,Контрагент,Валюта", "СуммаРасчетов,СуммаРуб");
	
	// Заполним таблицу оплаченных расходов.
	Для Каждого Аванс Из ОстаткиАвансов Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("КФО", Аванс.КФО);
		
		Если Реквизиты.ИспользоватьУчетПоИФО Тогда
			Отбор.Вставить("ИФО", Аванс.ИФО);
		КонецЕсли;
		
		СвойстваСчетаРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Аванс.СчетАвансов);
		Если Реквизиты.ИспользоватьУчетПоПодразделениям И СвойстваСчетаРасчетов.УчетПоПодразделениям Тогда
			Отбор.Вставить("Подразделение", Аванс.Подразделение);
		КонецЕсли;
		Если Реквизиты.ИспользоватьВалютныйУчет И СвойстваСчетаРасчетов.Валютный Тогда
			Отбор.Вставить("Валюта", Аванс.Валюта);
		КонецЕсли;
		
		Отбор.Вставить("СчетРасчетов", Аванс.СчетАвансов);
		Отбор.Вставить("Контрагент",   Аванс.Контрагент);
		
		ОписаниеТипаСуммы      = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
		ОписаниеТипаКоличества = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
		
		ОплаченныеРасходыУСН = УдержанияИзОплатыТруда.Скопировать(Отбор);
		// Сворачиваем по всем колонкам таблицы УчетУСН.ПустаяТаблицаПоступлениеРасходовУСН().
		ОплаченныеРасходыУСН.Свернуть("ИмяСписка,СинонимСписка,НомерСтроки,ИФО,КФО,КПС,Подразделение,
		|СчетУчетаУСН,ВидРасхода,ЭлементРасхода,Партия,ИмяСпискаДокумента,НомерСтрокиДокумента,ОтражениеВУСН,
		|СчетРасчетов,Контрагент,Договор,ДокументРасчетов,Валюта,РасходыУСН,
		|ВидСубконтоРасходов2,СубконтоРасходов2,ВидСубконтоРасходов3,СубконтоРасходов3",
			"Количество,СуммаВал,СуммаРуб,СуммаНДСВал,СуммаНДСРуб,СуммаНеУчитываетсяНУРуб,СуммаЕНВДРуб");
		ОплаченныеРасходыУСН.Колонки.Добавить("ОплаченоКоличество",              ОписаниеТипаКоличества);
		ОплаченныеРасходыУСН.Колонки.Добавить("ОплаченоСуммаВал",                ОписаниеТипаСуммы);
		ОплаченныеРасходыУСН.Колонки.Добавить("ОплаченоСуммаРуб",                ОписаниеТипаСуммы);
		ОплаченныеРасходыУСН.Колонки.Добавить("ОплаченоСуммаНеУчитываетсяНУРуб", ОписаниеТипаСуммы);
		ОплаченныеРасходыУСН.Колонки.Добавить("ОплаченоСуммаЕНВДРуб",            ОписаниеТипаСуммы);
		ОплаченныеРасходыУСН.Колонки.Добавить("ОплаченоСуммаНДСРуб",             ОписаниеТипаСуммы);
		ОплаченныеРасходыУСН.Колонки.Добавить("ВсегоРасходовВал",                ОписаниеТипаСуммы);
		ОплаченныеРасходыУСН.Колонки.Добавить("ВсегоРасходовРуб",                ОписаниеТипаСуммы);
		Для Каждого СтрокаРасходовУСН Из ОплаченныеРасходыУСН Цикл
			
			Если СвойстваСчетаРасчетов.УчетПоКПС Тогда
				СвойстваСчетаУСН = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаРасходовУСН.СчетУчетаУСН);
				Если СвойстваСчетаУСН.УчетПоКПС И (СтрокаРасходовУСН.КПС <> Аванс.КПС) Тогда
					Продолжить; // Пропускаем расходы по другим КПС.
				КонецЕсли;
			КонецЕсли;
			
			Если СтрокаРасходовУСН.СуммаВал > 0 Тогда
				// Распределять оплату будем только на строки с положительной суммой расходов УСН.
				СтрокаРасходовУСН.ВсегоРасходовВал = СтрокаРасходовУСН.СуммаВал + СтрокаРасходовУСН.СуммаНДСВал;
				СтрокаРасходовУСН.ВсегоРасходовРуб = СтрокаРасходовУСН.СуммаРуб +
					СтрокаРасходовУСН.СуммаНеУчитываетсяНУРуб + СтрокаРасходовУСН.СуммаЕНВДРуб + СтрокаРасходовУСН.СуммаНДСРуб;
			КонецЕсли;
			
		КонецЦикла;
		
		РаспределитьСуммуОплатыРасходовУСН(
			Мин(Аванс.СуммаРасчетов, ОплаченныеРасходыУСН.Итог("ВсегоРасходовВал")),
			Мин(Аванс.СуммаРуб,      ОплаченныеРасходыУСН.Итог("ВсегоРасходовРуб")),
			ОплаченныеРасходыУСН);
		
		Для Каждого РасходУСН Из ОплаченныеРасходыУСН Цикл
			
			Если РасходУСН.ОплаченоСуммаВал = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ТаблицаОплаченныхРасходовУСН.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, РасходУСН,
				"ИмяСписка,СинонимСписка,НомерСтроки,ИФО,КФО,КПС,Подразделение,Контрагент,Договор,ДокументРасчетов,Валюта,
				|СчетУчетаУСН,РасходыУСН,ВидСубконтоРасходов2,СубконтоРасходов2,ВидСубконтоРасходов3,СубконтоРасходов3");
			
			НоваяСтрока.Количество              = РасходУСН.ОплаченоКоличество;
			НоваяСтрока.СуммаВал                = РасходУСН.ОплаченоСуммаВал;
			НоваяСтрока.СуммаРуб                = РасходУСН.ОплаченоСуммаРуб;
			НоваяСтрока.СуммаНеУчитываетсяНУРуб = РасходУСН.ОплаченоСуммаНеУчитываетсяНУРуб;
			НоваяСтрока.СуммаЕНВДРуб            = РасходУСН.ОплаченоСуммаЕНВДРуб;
			НоваяСтрока.СуммаНДСРуб             = РасходУСН.ОплаченоСуммаНДСРуб;
			
			НоваяСтрока.КорСчетУСН = СчетУчетаОплаченныхРасходовУСН(
				НоваяСтрока.СчетУчетаУСН, НоваяСтрока.РасходыУСН, Реквизиты);
			
			НоваяСтрока.ДокументОплаты = Реквизиты.Ссылка;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТаблицаОплаченныхРасходовУСН;
	
КонецФункции

// Признание расходов при погашении задолженности (перечислении удержаний) контрагентам документами оплаты.
Функция ТаблицаПеречислениеУдержанийИзОплатыТруда(ТаблицаРасчетов, Реквизиты, Отказ) Экспорт
	
	ТаблицаОплаченныхРасходовУСН = УчетУСН.ПустаяТаблицаОплаченныхРасходовУСН();
	
	УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Реквизиты.Организация, Реквизиты.Дата);
	Если НЕ УчетнаяПолитика.ПрименяетсяУСНДоходыМинусРасходы Тогда
		Возврат ТаблицаОплаченныхРасходовУСН;
	КонецЕсли;
	
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	
	// Параметры учетной политики в части учета расходов УСН.
	Реквизиты.Вставить("ТоварыПоОплате", УчетнаяПолитика.ПорядокПризнанияРасходовПоТоварам =
		Перечисления.ПорядокПризнанияРасходовПоТоварам.ПоОплатеПоставщику);
	Реквизиты.Вставить("ТоварыПоОтгрузке", УчетнаяПолитика.ПорядокПризнанияРасходовПоТоварам =
		Перечисления.ПорядокПризнанияРасходовПоТоварам.ПоФактуРеализации);
	Реквизиты.Вставить("МатериалыПоОплате", УчетнаяПолитика.ПорядокПризнанияМатериальныхРасходов =
		Перечисления.ПорядокПризнанияМатериальныхРасходов.ПоОплатеПоставщику);
	Реквизиты.Вставить("ДопРасходыПоОплате", УчетнаяПолитика.ПорядокПризнанияДопРасходов =
		Перечисления.ПорядокПризнанияДопРасходов.ПоОплатеПоставщику);
	Реквизиты.Вставить("ТаможенныеПлатежиПоОплате", УчетнаяПолитика.ПорядокПризнанияТаможенныхПлатежей =
		Перечисления.ПорядокПризнанияТаможенныхПлатежей.ПоОплате);
	Реквизиты.Вставить("НДСПоОплате", УчетнаяПолитика.ПорядокПризнанияРасходовПоНДС =
		Перечисления.ПорядокПризнанияРасходовПоНДС.ПоОплатеПоставщику);
	
	// Подготовим таблицу оплат для целей УСН.
	ТаблицаОплат = ТаблицаРасчетов.СкопироватьКолонки();
	Если ТаблицаРасчетов.Колонки.Найти("ЭтоАванс") <> Неопределено Тогда // ТаблицаРасчетовСПогашениемЗадолженности
		
		Для Каждого СтрокаРасчетов Из ТаблицаРасчетов Цикл
			Если НЕ СтрокаРасчетов.ЭтоАванс И УчетУСНКлиентСервер.ВедетсяУчетУСНпоКФО(СтрокаРасчетов.КФО) Тогда
				НоваяОплата = ТаблицаОплат.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяОплата, СтрокаРасчетов);
			КонецЕсли;
		КонецЦикла;
		
	Иначе // ТаблицаРасшифровкаПлатежаУнифицированная
		
		Для Каждого СтрокаРасшифровкаПлатежа Из ТаблицаРасчетов Цикл
			Если УчетУСНКлиентСервер.ВедетсяУчетУСНпоКФО(СтрокаРасшифровкаПлатежа.КФО) Тогда
				НоваяОплата = ТаблицаОплат.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяОплата, СтрокаРасшифровкаПлатежа);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	ТаблицаОплат.Свернуть("ИФО,КФО,КПС,Подразделение,СчетРасчетов,Контрагент,Валюта", "СуммаРасчетов,СуммаРуб");
	
	Если ТаблицаОплат.Количество() = 0 Тогда
		Возврат ТаблицаОплаченныхРасходовУСН;
	КонецЕсли;
	
	// Получим остатки неоплаченных расходов УСН по оплаченным документам расчетов.
	СчетаРасходовКОплате = БухгалтерскийУчет.СписокСчетов("У70.О");
	
	ОтборРасходов = Новый Структура;
	ОтборРасходов.Вставить("СчетРасчетов", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
		ТаблицаОплат.ВыгрузитьКолонку("СчетРасчетов")));
	ОтборРасходов.Вставить("Контрагент", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
		ТаблицаОплат.ВыгрузитьКолонку("Контрагент")));
	
	Если Реквизиты.ИспользоватьУчетПоИФО Тогда
		ОтборРасходов.Вставить("ИФО", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
			ТаблицаОплат.ВыгрузитьКолонку("ИФО")));
	КонецЕсли;
	ОтборРасходов.Вставить("КФО", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
		ТаблицаОплат.ВыгрузитьКолонку("КФО")));
	
	ПериодОстатков = ?(Реквизиты.Свойство("ПериодОстатков"), Реквизиты.ПериодОстатков,
		УчетРасчетов.ПериодПолученияОстатков(Реквизиты.Ссылка));
	ОстаткиРасходовУСН = ОстаткиРасходовУСН(ПериодОстатков, СчетаРасходовКОплате, ОтборРасходов, Реквизиты);
	ОбщегоНазначенияБГУ.УпорядочитьТаблицуПоДокументу(ОстаткиРасходовУСН, "ДокументРасчетов", "ДатаДокументаРасчетов");
	
	// Заполним таблицу оплаченных расходов УСН.
	Для Каждого Оплата Из ТаблицаОплат Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("КФО", Оплата.КФО);
		
		Если Реквизиты.ИспользоватьУчетПоИФО Тогда
			Отбор.Вставить("ИФО", Оплата.ИФО);
		КонецЕсли;
		
		СвойстваСчетаРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Оплата.СчетРасчетов);
		Если Реквизиты.ИспользоватьУчетПоПодразделениям И СвойстваСчетаРасчетов.УчетПоПодразделениям Тогда
			Отбор.Вставить("Подразделение", Оплата.Подразделение);
		КонецЕсли;
		Если Реквизиты.ИспользоватьВалютныйУчет И СвойстваСчетаРасчетов.Валютный Тогда
			Отбор.Вставить("Валюта", Оплата.Валюта);
		КонецЕсли;
		
		Отбор.Вставить("СчетРасчетов", Оплата.СчетРасчетов);
		Отбор.Вставить("Контрагент",   Оплата.Контрагент);
		
		ОписаниеТипаСуммы      = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
		ОписаниеТипаКоличества = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
		
		ОплаченныеРасходыУСН = ОстаткиРасходовУСН.Скопировать(Отбор);
		ОплаченныеРасходыУСН.Колонки.Добавить("ОплаченоКоличество",              ОписаниеТипаКоличества);
		ОплаченныеРасходыУСН.Колонки.Добавить("ОплаченоСуммаВал",                ОписаниеТипаСуммы);
		ОплаченныеРасходыУСН.Колонки.Добавить("ОплаченоСуммаРуб",                ОписаниеТипаСуммы);
		ОплаченныеРасходыУСН.Колонки.Добавить("ОплаченоСуммаНеУчитываетсяНУРуб", ОписаниеТипаСуммы);
		ОплаченныеРасходыУСН.Колонки.Добавить("ОплаченоСуммаЕНВДРуб",            ОписаниеТипаСуммы);
		ОплаченныеРасходыУСН.Колонки.Добавить("ОплаченоСуммаНДСРуб",             ОписаниеТипаСуммы);
		ОплаченныеРасходыУСН.Колонки.Добавить("ВсегоРасходовВал",                ОписаниеТипаСуммы);
		ОплаченныеРасходыУСН.Колонки.Добавить("ВсегоРасходовРуб",                ОписаниеТипаСуммы);
		Для Каждого СтрокаРасходовУСН Из ОплаченныеРасходыУСН Цикл
			
			Если СвойстваСчетаРасчетов.УчетПоКПС Тогда
				СвойстваСчетаУСН = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаРасходовУСН.СчетУчетаУСН);
				Если СвойстваСчетаУСН.УчетПоКПС И (СтрокаРасходовУСН.КПС <> Оплата.КПС) Тогда
					Продолжить; // Пропускаем расходы по другим КПС.
				КонецЕсли;
			КонецЕсли;
			
			Если СтрокаРасходовУСН.СуммаВал > 0 Тогда
				// Распределять оплату будем только на строки с положительной суммой расходов УСН.
				СтрокаРасходовУСН.ВсегоРасходовВал = СтрокаРасходовУСН.СуммаВал;
				СтрокаРасходовУСН.ВсегоРасходовРуб = СтрокаРасходовУСН.СуммаРуб +
					СтрокаРасходовУСН.СуммаНеУчитываетсяНУРуб + СтрокаРасходовУСН.СуммаЕНВДРуб + СтрокаРасходовУСН.СуммаНДСРуб;
			КонецЕсли;
			
		КонецЦикла;
		
		ОсталосьПогаситьВал = Мин(Оплата.СуммаРасчетов, ОплаченныеРасходыУСН.Итог("ВсегоРасходовВал"));
		Если Оплата.Валюта = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета() Тогда
			// Если расчеты в рублях, сумма оплаченных расходов не может превышать сумму расходов,
			// признанных первоначально при поступлении расходов.
			ОсталосьПогаситьРуб = Мин(Оплата.СуммаРуб, ОплаченныеРасходыУСН.Итог("ВсегоРасходовРуб"));
		Иначе
			// Если расчеты в валюте, сумма расходов в рублях может быть как больше, так и меньше суммы расходов,
			// признанных первоначально при поступлении расходов из-за разницы курсов.
			Коэффициент = ?(Оплата.СуммаРасчетов = 0, 0, ОсталосьПогаситьВал / Оплата.СуммаРасчетов);
			ОсталосьПогаситьРуб = Коэффициент * Оплата.СуммаРуб;
		КонецЕсли;
		
		// В таблице ОплаченныеРасходыУСН отобраны расходы УСН по подотчетному лицу.
		// Распределим сумму оплаты на все расходы УСН по данному расчетному документу.
		РаспределитьСуммуОплатыРасходовУСН(ОсталосьПогаситьВал, ОсталосьПогаситьРуб, ОплаченныеРасходыУСН);
		
		Для Каждого РасходУСН Из ОплаченныеРасходыУСН Цикл
			
			Если РасходУСН.ОплаченоСуммаВал = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ТаблицаОплаченныхРасходовУСН.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, РасходУСН,
				"ИФО,КФО,КПС,Подразделение,СчетРасчетов,Контрагент,Договор,ДокументРасчетов,Валюта,СчетУчетаУСН,РасходыУСН");
			
			СвойстваСчетаУчетаУСН = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(РасходУСН.СчетУчетаУСН);
			НоваяСтрока.ВидСубконтоРасходов2 = СвойстваСчетаУчетаУСН.ВидСубконто1;
			НоваяСтрока.СубконтоРасходов2    = РасходУСН.СубконтоРасходов2;
			НоваяСтрока.ВидСубконтоРасходов3 = СвойстваСчетаУчетаУСН.ВидСубконто3;
			НоваяСтрока.СубконтоРасходов3    = РасходУСН.СубконтоРасходов3;
			
			НоваяСтрока.Количество              = РасходУСН.ОплаченоКоличество;
			НоваяСтрока.СуммаВал                = РасходУСН.ОплаченоСуммаВал;
			НоваяСтрока.СуммаРуб                = РасходУСН.ОплаченоСуммаРуб;
			НоваяСтрока.СуммаНеУчитываетсяНУРуб = РасходУСН.ОплаченоСуммаНеУчитываетсяНУРуб;
			НоваяСтрока.СуммаЕНВДРуб            = РасходУСН.ОплаченоСуммаЕНВДРуб;
			НоваяСтрока.СуммаНДСРуб             = РасходУСН.ОплаченоСуммаНДСРуб;
			
			НоваяСтрока.КорСчетУСН = СчетУчетаОплаченныхРасходовУСН(
				НоваяСтрока.СчетУчетаУСН, НоваяСтрока.РасходыУСН, Реквизиты);
			
			НоваяСтрока.ДокументОплаты = Реквизиты.Ссылка;
			
			// Спишем рублевые остатки расходов (УСН), учтенные по курсу на дату документа поступления (партии).
			Если РасходУСН.Валюта <> БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета() Тогда
				
				Коэффициент = ?(РасходУСН.СуммаВал = 0, 0, РасходУСН.ОплаченоСуммаВал / РасходУСН.СуммаВал);
				
				Если Коэффициент * РасходУСН.СуммаРуб                <> РасходУСН.ОплаченоСуммаРуб
				 ИЛИ Коэффициент * РасходУСН.СуммаНДСРуб             <> РасходУСН.ОплаченоСуммаНДСРуб
				 ИЛИ Коэффициент * РасходУСН.СуммаЕНВДРуб            <> РасходУСН.ОплаченоСуммаЕНВДРуб
				 ИЛИ Коэффициент * РасходУСН.СуммаНеУчитываетсяНУРуб <> РасходУСН.ОплаченоСуммаНеУчитываетсяНУРуб Тогда
					
					КорректировкаСуммРуб = ТаблицаОплаченныхРасходовУСН.Добавить();
					ЗаполнитьЗначенияСвойств(КорректировкаСуммРуб, НоваяСтрока,
						"ИмяСписка,СинонимСписка,НомерСтроки,
						|ИФО,КФО,КПС,Подразделение,СчетРасчетов,Контрагент,Договор,ДокументРасчетов,Валюта,СчетУчетаУСН,РасходыУСН,
						|ВидСубконтоРасходов2,СубконтоРасходов2,ВидСубконтоРасходов3,СубконтоРасходов3");
					
					КорректировкаСуммРуб.СуммаРуб                = Коэффициент * РасходУСН.СуммаРуб                - РасходУСН.ОплаченоСуммаРуб;
					КорректировкаСуммРуб.СуммаНДСРуб             = Коэффициент * РасходУСН.СуммаНДСРуб             - РасходУСН.ОплаченоСуммаНДСРуб;
					КорректировкаСуммРуб.СуммаЕНВДРуб            = Коэффициент * РасходУСН.СуммаЕНВДРуб            - РасходУСН.ОплаченоСуммаЕНВДРуб;
					КорректировкаСуммРуб.СуммаНеУчитываетсяНУРуб = Коэффициент * РасходУСН.СуммаНеУчитываетсяНУРуб - РасходУСН.ОплаченоСуммаНеУчитываетсяНУРуб;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТаблицаОплаченныхРасходовУСН;
	
КонецФункции

// Имущественные налоги

Функция ТаблицаНачислениеИмущественныхНалогов(Документ, Параметры = Неопределено) Экспорт
	
	ТаблицаРасходовУСН = ПустаяТаблицаПоступлениеРасходовУСН();
	
	Если НЕ УчетУСНВызовСервера.ПрименяетсяУСНДоходыМинусРасходы(Документ.Организация, Документ.Дата) Тогда
		Возврат ТаблицаРасходовУСН;
	КонецЕсли;
	
	Если Параметры = Неопределено Тогда
		Параметры = Новый Структура;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "ДвиженияДокумента",
		"НомерСтроки,ИФО,КФО,КПСДт,ПодразделениеДт,СчетДт,СубконтоДт1,СубконтоДт2,СубконтоДт3,
		|ВидНалогаИлиПлатежа,НалогСборПлатеж,ОтражениеВУСН,Сумма",
		Документ, Параметры);
	
	Запрос.Текст = Запрос.Текст +
	"ВЫБРАТЬ
	|	""ДвиженияДокумента"" КАК ИмяСписка,
	|	""Бухгалтерский учет"" КАК СинонимСписка,
	|	НачислениеИмущественныхНалогов.НомерСтроки КАК НомерСтроки,
	|	НачислениеИмущественныхНалогов.ИФО КАК ИФО,
	|	НачислениеИмущественныхНалогов.КФО КАК КФО,
	|	НачислениеИмущественныхНалогов.КПСДт КАК КПС,
	|	НачислениеИмущественныхНалогов.ПодразделениеДт КАК Подразделение,
	|	НачислениеИмущественныхНалогов.СчетДт КАК СчетДт,
	|	НачислениеИмущественныхНалогов.СубконтоДт1 КАК СубконтоЗатрат1,
	|	НачислениеИмущественныхНалогов.СубконтоДт2 КАК СубконтоЗатрат2,
	|	НачислениеИмущественныхНалогов.СубконтоДт3 КАК СубконтоЗатрат3,
	|	НачислениеИмущественныхНалогов.ВидНалогаИлиПлатежа КАК ВидНалогаИлиПлатежа,
	|	НачислениеИмущественныхНалогов.ВидНалогаИлиПлатежа.СчетУчета КАК КодСчетаРасчетов,
	|	НачислениеИмущественныхНалогов.НалогСборПлатеж КАК НалогСборПлатеж,
	|	НачислениеИмущественныхНалогов.ОтражениеВУСН КАК ОтражениеВУСН,
	|	НачислениеИмущественныхНалогов.Сумма КАК Сумма
	|ИЗ
	|	ТаблицаДвиженияДокумента КАК НачислениеИмущественныхНалогов
	|ГДЕ
	|	НачислениеИмущественныхНалогов.Сумма > 0";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если НЕ УчетУСНКлиентСервер.ВедетсяУчетУСНпоКФО(Выборка.КФО) Тогда
			Продолжить;
		КонецЕсли;
		Если Выборка.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		РасходУСН = ТаблицаРасходовУСН.Добавить();
		ЗаполнитьЗначенияСвойств(РасходУСН, Выборка,
			"ИмяСписка,СинонимСписка,НомерСтроки,ИФО,КФО,КПС,Подразделение");
		
		РасходУСН.ИмяСпискаДокумента   = Выборка.ИмяСписка;
		РасходУСН.НомерСтрокиДокумента = Выборка.НомерСтроки;
		
		РасходУСН.ВидРасхода = Перечисления.ВидыРасходовУСН.Налоги;
		РасходУСН.ЭлементРасхода = Выборка.ВидНалогаИлиПлатежа;
		
		// Определим вид затрат.
		ВидЗатрат = Справочники.ВидыЗатрат.ПустаяСсылка();
		СвойстваСчетаЗатрат = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Выборка.СчетДт);
		Для НомерСубконто = 1 По СвойстваСчетаЗатрат.КоличествоСубконто Цикл
			
			ВидСубконто = СвойстваСчетаЗатрат["ВидСубконто" + НомерСубконто];
			Если ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ВидыЗатрат Тогда
				ВидЗатрат = Выборка["СубконтоЗатрат" + НомерСубконто];
			КонецЕсли;
			
		КонецЦикла;
		
		Если ЗначениеЗаполнено(Выборка.ОтражениеВУСН) Тогда // Отражение в УСН явно указано в строке документа.
			РасходУСН.ОтражениеВУСН = Выборка.ОтражениеВУСН;
		ИначеЕсли Параметры.Свойство("АвтоОтражениеВУСН")
			И ЗначениеЗаполнено(Параметры.АвтоОтражениеВУСН) Тогда // Отражение в УСН определено типовой операцией.
			РасходУСН.ОтражениеВУСН = Параметры.АвтоОтражениеВУСН;
		ИначеЕсли ЗначениеЗаполнено(ВидЗатрат) Тогда // Отражение в УСН определим из вида затрат.
			РасходУСН.ОтражениеВУСН = УчетУСН.ОтражениеВУСНпоВидуЗатрат(ВидЗатрат);
		Иначе
			РасходУСН.ОтражениеВУСН = Перечисления.ОтражениеВУСН.Принимаются;
		КонецЕсли;
		
		РасходУСН.СчетУчетаУСН         = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У68.О");
		РасходУСН.ВидСубконтоРасходов2 = ПланыВидовХарактеристик.ВидыСубконто.ВидыНалоговИПлатежей;
		РасходУСН.СубконтоРасходов2    = Выборка.ВидНалогаИлиПлатежа;
		
		Если РасходУСН.ОтражениеВУСН = Перечисления.ОтражениеВУСН.НеПринимаются Тогда
			РасходУСН.СуммаНеУчитываетсяНУРуб = Выборка.Сумма;
			РасходУСН.СуммаВал = Выборка.Сумма;
		ИначеЕсли РасходУСН.ОтражениеВУСН = Перечисления.ОтражениеВУСН.ОсобыйПорядок Тогда
			РасходУСН.СуммаЕНВДРуб = Выборка.Сумма;
			РасходУСН.СуммаВал = Выборка.Сумма;
		Иначе
			РасходУСН.СуммаРуб = Выборка.Сумма;
			РасходУСН.СуммаВал = Выборка.Сумма;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.КодСчетаРасчетов) Тогда
			РасходУСН.СчетРасчетов = БухгалтерскийУчет.СчетПоКоду(Выборка.КодСчетаРасчетов, Документ.Дата, Документ.Организация);
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаРасходовУСН.ЗаполнитьЗначения(Документ.Ссылка, "Партия");
	ТаблицаРасходовУСН.ЗаполнитьЗначения(Документ.Ссылка, "ДокументРасчетов");
	
	// Формируем элементы учета расходов УСН.
	СформироватьЭлементыУчетаРасходовУСН(Документ.Ссылка, ТаблицаРасходовУСН);
	
	Возврат ТаблицаРасходовУСН;
	
КонецФункции

// Оплата расходов УСН

Функция ПустаяТаблицаОплаченныхРасходовУСН() Экспорт

	ОписаниеТипаСуммы       = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества  = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	ОписаниеТипаСубконто    = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	ОписаниеТипаВидСубконто = Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто");
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Идентификация строки.
	ПустаяТаблица.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	
	// Аналитика учета расчетов с контрагентами.
	ПустаяТаблица.Колонки.Добавить("СчетРасчетов",  Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("Контрагент",    Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ПустаяТаблица.Колонки.Добавить("Договор",       Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ПустаяТаблица.Колонки.Добавить("ДокументРасчетов",
		ПланыВидовХарактеристик.ВидыСубконто.ДокументыРасчетов.ТипЗначения);
	ПустаяТаблица.Колонки.Добавить("Валюта",        Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	
	// Счет и аналитика учета расходов УСН в оплате (Кт).
	ПустаяТаблица.Колонки.Добавить("СчетУчетаУСН",  Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("РасходыУСН",    Новый ОписаниеТипов("СправочникСсылка.РасходыУСН"));
	ПустаяТаблица.Колонки.Добавить("ВидСубконтоРасходов2",  ОписаниеТипаВидСубконто);
	ПустаяТаблица.Колонки.Добавить("СубконтоРасходов2",     ОписаниеТипаСубконто);
	ПустаяТаблица.Колонки.Добавить("ВидСубконтоРасходов3",  ОписаниеТипаВидСубконто);
	ПустаяТаблица.Колонки.Добавить("СубконтоРасходов3",     ОписаниеТипаСубконто);
	
	// Счет и аналитика учета оплаченных расходов УСН (Дт).
	ПустаяТаблица.Колонки.Добавить("КорСчетУСН",    Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("ДокументОплаты",
		ПланыВидовХарактеристик.ВидыСубконто.ДокументыОплатыУСН.ТипЗначения);
	
	ПустаяТаблица.Колонки.Добавить("Количество",              ОписаниеТипаКоличества);
	ПустаяТаблица.Колонки.Добавить("СуммаВал",                ОписаниеТипаСуммы); // Сумма в валюте документа.
	ПустаяТаблица.Колонки.Добавить("СуммаРуб",                ОписаниеТипаСуммы); // Сумма в рублях.
	ПустаяТаблица.Колонки.Добавить("СуммаНеУчитываетсяНУРуб", ОписаниеТипаСуммы); // Сумма в рублях.
	ПустаяТаблица.Колонки.Добавить("СуммаЕНВДРуб",            ОписаниеТипаСуммы); // Сумма в рублях.
	ПустаяТаблица.Колонки.Добавить("СуммаНДСРуб",             ОписаниеТипаСуммы); // Сумма НДС в рублях.
	
	Возврат ПустаяТаблица;

КонецФункции

Функция ТаблицаЗачетАвансовПоставщикуУСН(ТаблицаПоступлениеРасходовУСН, ТаблицаРасчетовСЗачетомАвансов, Реквизиты, Отказ) Экспорт
	
	ТаблицаОплаченныхРасходовУСН = ПустаяТаблицаОплаченныхРасходовУСН();
	
	УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Реквизиты.Организация, Реквизиты.Дата);
	Если НЕ УчетнаяПолитика.ПрименяетсяУСНДоходыМинусРасходы Тогда
		Возврат ТаблицаОплаченныхРасходовУСН;
	КонецЕсли;
	
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	
	// Параметры учетной политики в части учета расходов УСН.
	Реквизиты.Вставить("ТоварыПоОплате", УчетнаяПолитика.ПорядокПризнанияРасходовПоТоварам =
		Перечисления.ПорядокПризнанияРасходовПоТоварам.ПоОплатеПоставщику);
	Реквизиты.Вставить("ТоварыПоОтгрузке", УчетнаяПолитика.ПорядокПризнанияРасходовПоТоварам =
		Перечисления.ПорядокПризнанияРасходовПоТоварам.ПоФактуРеализации);
	Реквизиты.Вставить("МатериалыПоОплате", УчетнаяПолитика.ПорядокПризнанияМатериальныхРасходов =
		Перечисления.ПорядокПризнанияМатериальныхРасходов.ПоОплатеПоставщику);
	Реквизиты.Вставить("ДопРасходыПоОплате", УчетнаяПолитика.ПорядокПризнанияДопРасходов =
		Перечисления.ПорядокПризнанияДопРасходов.ПоОплатеПоставщику);
	Реквизиты.Вставить("ТаможенныеПлатежиПоОплате", УчетнаяПолитика.ПорядокПризнанияТаможенныхПлатежей =
		Перечисления.ПорядокПризнанияТаможенныхПлатежей.ПоОплате);
	Реквизиты.Вставить("НДСПоОплате", УчетнаяПолитика.ПорядокПризнанияРасходовПоНДС =
		Перечисления.ПорядокПризнанияРасходовПоНДС.ПоОплатеПоставщику);

	// Подготовим таблицу расходов к оплате.
	РасходыУСНкОплате = ТаблицаПоступлениеРасходовУСН.Скопировать();
	РасходыКУдалению = Новый Массив;
	Для Каждого РасходУСН Из РасходыУСНкОплате Цикл
		Если РасходУСН.ВидРасхода = Перечисления.ВидыРасходовУСН.Налоги
		   И БухгалтерскийУчет.СчетВИерархии(РасходУСН.СчетУчетаУСН, "У68.НА") Тогда
		// Агентский НДС исключаем, т.к. он оплачивается в налоговую, а не поставщику.
		РасходыКУдалению.Добавить(РасходУСН);
		КонецЕсли;
	КонецЦикла;
	Для Каждого РасходКУдалению Из РасходыКУдалению Цикл
		РасходыУСНкОплате.Удалить(РасходКУдалению);
	КонецЦикла;
	
	// Подготовим таблицу зачтенных авансов.
	ТаблицаЗачтенныхАвансов = ТаблицаРасчетовСЗачетомАвансов.Скопировать(
		Новый Структура("ЭтоЗачетАванса", Истина));
	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ТаблицаЗачтенныхАвансов.Колонки.Добавить("РасходыУСНВал", ОписаниеТипаСуммы);
	ТаблицаЗачтенныхАвансов.Колонки.Добавить("РасходыУСНРуб", ОписаниеТипаСуммы);
	ОстаткиРасходовУСН = РасходыУСНкОплате.Скопировать(, "ИФО,КФО,КПС,Подразделение,Контрагент,Договор,СчетРасчетов,Валюта,
		|СуммаВал, СуммаРуб, СуммаНДСВал, СуммаНДСРуб, СуммаНеУчитываетсяНУРуб, СуммаЕНВДРуб");
	ОстаткиРасходовУСН.Свернуть("ИФО,КФО,КПС,Подразделение,Контрагент,Договор,СчетРасчетов,Валюта",
		"СуммаВал, СуммаРуб, СуммаНДСВал, СуммаНДСРуб, СуммаНеУчитываетсяНУРуб, СуммаЕНВДРуб");
	Для Каждого СтрокаОстаткиРасходовУСН Из ОстаткиРасходовУСН Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("СчетРасчетов", СтрокаОстаткиРасходовУСН.СчетРасчетов);
		Отбор.Вставить("Контрагент",   СтрокаОстаткиРасходовУСН.Контрагент);
		Отбор.Вставить("КФО", СтрокаОстаткиРасходовУСН.КФО);
		Если ЗначениеЗаполнено(СтрокаОстаткиРасходовУСН.Договор)
		   И БухгалтерскийУчетПовтИсп.НаСчетеВедетсяУчетПоДоговорам(СтрокаОстаткиРасходовУСН.СчетРасчетов) Тогда
			Отбор.Вставить("Договор", СтрокаОстаткиРасходовУСН.Договор);
		КонецЕсли;
		Если Реквизиты.ИспользоватьУчетПоИФО Тогда
			Отбор.Вставить("ИФО", СтрокаОстаткиРасходовУСН.ИФО);
		КонецЕсли;
		СвойстваСчетаРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаОстаткиРасходовУСН.СчетРасчетов);
		Если СвойстваСчетаРасчетов.УчетПоКПС И ЗначениеЗаполнено(СтрокаОстаткиРасходовУСН.КПС) Тогда
			Отбор.Вставить("КПС", СтрокаОстаткиРасходовУСН.КПС);
		КонецЕсли;
		Если Реквизиты.ИспользоватьУчетПоПодразделениям И СвойстваСчетаРасчетов.УчетПоПодразделениям Тогда
			Отбор.Вставить("Подразделение", СтрокаОстаткиРасходовУСН.Подразделение);
		КонецЕсли;
		Если Реквизиты.ИспользоватьВалютныйУчет И СвойстваСчетаРасчетов.Валютный Тогда
			Отбор.Вставить("Валюта", СтрокаОстаткиРасходовУСН.Валюта);
		КонецЕсли;
		
		НайденныеСтроки = ТаблицаЗачтенныхАвансов.НайтиСтроки(Отбор);
		
		ОбщегоНазначенияБГУ.РаспределитьСуммуПоСтрокамТаблицы(
			СтрокаОстаткиРасходовУСН.СуммаВал,
			НайденныеСтроки, "РасходыУСНВал", "СуммаРасчетов", Ложь);
		
		ОбщегоНазначенияБГУ.РаспределитьСуммуПоСтрокамТаблицы(
			СтрокаОстаткиРасходовУСН.СуммаРуб + СтрокаОстаткиРасходовУСН.СуммаНДСРуб + СтрокаОстаткиРасходовУСН.СуммаНеУчитываетсяНУРуб + СтрокаОстаткиРасходовУСН.СуммаЕНВДРуб,
			НайденныеСтроки, "РасходыУСНРуб", "СуммаРубПоКурсуАванса", Ложь);
			
	КонецЦикла;
	
	// Заполним таблицу оплаченных расходов.
	Для Каждого ЗачтенныйАванс Из ТаблицаЗачтенныхАвансов Цикл
		
		ОплаченныеРасходыУСН = ОплаченныеРасходыУСНЗачетАванса(
			ЗачтенныйАванс, РасходыУСНкОплате, Реквизиты);
		
		Для Каждого РасходУСН Из ОплаченныеРасходыУСН Цикл
			
			Если РасходУСН.ОплаченоСуммаВал = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ТаблицаОплаченныхРасходовУСН.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, РасходУСН,
				"ИмяСписка,СинонимСписка,НомерСтроки,ИФО,КФО,КПС,Подразделение,Контрагент,Договор,ДокументРасчетов,Валюта,
				|СчетУчетаУСН,РасходыУСН,ВидСубконтоРасходов2,СубконтоРасходов2,ВидСубконтоРасходов3,СубконтоРасходов3");
			
			НоваяСтрока.Количество              = РасходУСН.ОплаченоКоличество;
			НоваяСтрока.СуммаВал                = РасходУСН.ОплаченоСуммаВал;
			НоваяСтрока.СуммаРуб                = РасходУСН.ОплаченоСуммаРуб;
			НоваяСтрока.СуммаНеУчитываетсяНУРуб = РасходУСН.ОплаченоСуммаНеУчитываетсяНУРуб;
			НоваяСтрока.СуммаЕНВДРуб            = РасходУСН.ОплаченоСуммаЕНВДРуб;
			НоваяСтрока.СуммаНДСРуб             = РасходУСН.ОплаченоСуммаНДСРуб;
			
			НоваяСтрока.КорСчетУСН = СчетУчетаОплаченныхРасходовУСН(
				НоваяСтрока.СчетУчетаУСН, НоваяСтрока.РасходыУСН, Реквизиты);
			
			Если БухгалтерскийУчетПовтИсп.НаСчетеВедетсяУчетПоДокументамРасчетов(ЗачтенныйАванс.СчетАвансов) Тогда
				НоваяСтрока.ДокументОплаты = ЗачтенныйАванс.ДопСубконтоАвансов;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТаблицаОплаченныхРасходовУСН;
	
КонецФункции

Функция ТаблицаОплатаПоставщикуУСН(ТаблицаРасчетовСПогашениемЗадолженности, Реквизиты, Отказ) Экспорт
	
	ТаблицаОплаченныхРасходовУСН = ПустаяТаблицаОплаченныхРасходовУСН();
	
	УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Реквизиты.Организация, Реквизиты.Дата);
	Если НЕ УчетнаяПолитика.ПрименяетсяУСНДоходыМинусРасходы Тогда
		Возврат ТаблицаОплаченныхРасходовУСН;
	КонецЕсли;
	
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	Реквизиты.Вставить("ПлательщикЕНВД",                   УчетнаяПолитика.ПлательщикЕНВД);
	
	// Параметры учетной политики в части учета расходов УСН.
	Реквизиты.Вставить("ТоварыПоОплате", УчетнаяПолитика.ПорядокПризнанияРасходовПоТоварам =
		Перечисления.ПорядокПризнанияРасходовПоТоварам.ПоОплатеПоставщику);
	Реквизиты.Вставить("ТоварыПоОтгрузке", УчетнаяПолитика.ПорядокПризнанияРасходовПоТоварам =
		Перечисления.ПорядокПризнанияРасходовПоТоварам.ПоФактуРеализации);
	Реквизиты.Вставить("МатериалыПоОплате", УчетнаяПолитика.ПорядокПризнанияМатериальныхРасходов =
		Перечисления.ПорядокПризнанияМатериальныхРасходов.ПоОплатеПоставщику);
	Реквизиты.Вставить("ДопРасходыПоОплате", УчетнаяПолитика.ПорядокПризнанияДопРасходов =
		Перечисления.ПорядокПризнанияДопРасходов.ПоОплатеПоставщику);
	Реквизиты.Вставить("ТаможенныеПлатежиПоОплате", УчетнаяПолитика.ПорядокПризнанияТаможенныхПлатежей =
		Перечисления.ПорядокПризнанияТаможенныхПлатежей.ПоОплате);
	Реквизиты.Вставить("НДСПоОплате", УчетнаяПолитика.ПорядокПризнанияРасходовПоНДС =
		Перечисления.ПорядокПризнанияРасходовПоНДС.ПоОплатеПоставщику);

	// Отберем документы расчетов (партии поступления расходов УСН), оплаченные документом.
	ТаблицаОплат = ТаблицаРасчетовСПогашениемЗадолженности.СкопироватьКолонки();
	Для Каждого СтрокаРасчетов Из ТаблицаРасчетовСПогашениемЗадолженности Цикл
		Если НЕ СтрокаРасчетов.ЭтоАванс И УчетУСНКлиентСервер.ВедетсяУчетУСНпоКФО(СтрокаРасчетов.КФО) Тогда
			НоваяОплата = ТаблицаОплат.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяОплата, СтрокаРасчетов);
		КонецЕсли;
	КонецЦикла;
	
	Если ТаблицаОплат.Количество() = 0 Тогда
		Возврат ТаблицаОплаченныхРасходовУСН;
	КонецЕсли;
	
	// Получим остатки неоплаченных расходов УСН по оплаченным документам расчетов.
	СчетаРасходовКОплате = БухгалтерскийУчет.СписокСчетов(
		"У01.О,У01.ВО,У04.О,У08.ПО,У08.О,У10.О,У10.СО,У10.ОР,У15.О,У15.СО,У20.О,У41.О,У41.СО,У41.ОР,У70.О");
	
	ОтборРасходов = Новый Структура;
	ОтборРасходов.Вставить("СчетРасчетов", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
		ТаблицаОплат.ВыгрузитьКолонку("СчетРасчетов")));
	ОтборРасходов.Вставить("Контрагент", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
		ТаблицаОплат.ВыгрузитьКолонку("Контрагент")));
	
	Если Реквизиты.ИспользоватьУчетПоИФО Тогда
		ОтборРасходов.Вставить("ИФО", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
			ТаблицаОплат.ВыгрузитьКолонку("ИФО")));
	КонецЕсли;
	ОтборРасходов.Вставить("КФО", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
		ТаблицаОплат.ВыгрузитьКолонку("КФО")));
	
	ПериодОстатков = ?(Реквизиты.Свойство("ПериодОстатков"), Реквизиты.ПериодОстатков,
		УчетРасчетов.ПериодПолученияОстатков(Реквизиты.Ссылка));
	ОстаткиРасходовУСН = ОстаткиРасходовУСН(ПериодОстатков, СчетаРасходовКОплате, ОтборРасходов, Реквизиты);
	ОбщегоНазначенияБГУ.УпорядочитьТаблицуПоДокументу(ОстаткиРасходовУСН, "ДокументРасчетов", "ДатаДокументаРасчетов");
	
	// Заполним таблицу оплаченных расходов УСН.
	Для Каждого Оплата Из ТаблицаОплат Цикл
		
		ОплаченныеРасходыУСН = ОплаченныеРасходыУСНПогашениеЗадолженности(
			Оплата, ОстаткиРасходовУСН, Реквизиты);
		
		Для Каждого РасходУСН Из ОплаченныеРасходыУСН Цикл
			
			Если РасходУСН.ОплаченоСуммаВал = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ТаблицаОплаченныхРасходовУСН.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Оплата, "ИмяСписка,СинонимСписка,НомерСтроки");
			ЗаполнитьЗначенияСвойств(НоваяСтрока, РасходУСН,
				"ИФО,КФО,КПС,Подразделение,СчетРасчетов,Контрагент,Договор,ДокументРасчетов,Валюта,СчетУчетаУСН,РасходыУСН");
			
			СвойстваСчетаУчетаУСН = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(РасходУСН.СчетУчетаУСН);
			НоваяСтрока.ВидСубконтоРасходов2 = СвойстваСчетаУчетаУСН.ВидСубконто1;
			НоваяСтрока.СубконтоРасходов2    = РасходУСН.СубконтоРасходов2;
			НоваяСтрока.ВидСубконтоРасходов3 = СвойстваСчетаУчетаУСН.ВидСубконто3;
			НоваяСтрока.СубконтоРасходов3    = РасходУСН.СубконтоРасходов3;
			
			НоваяСтрока.Количество              = РасходУСН.ОплаченоКоличество;
			НоваяСтрока.СуммаВал                = РасходУСН.ОплаченоСуммаВал;
			НоваяСтрока.СуммаРуб                = РасходУСН.ОплаченоСуммаРуб;
			НоваяСтрока.СуммаНеУчитываетсяНУРуб = РасходУСН.ОплаченоСуммаНеУчитываетсяНУРуб;
			НоваяСтрока.СуммаЕНВДРуб            = РасходУСН.ОплаченоСуммаЕНВДРуб;
			НоваяСтрока.СуммаНДСРуб             = РасходУСН.ОплаченоСуммаНДСРуб;
			
			НоваяСтрока.КорСчетУСН = СчетУчетаОплаченныхРасходовУСН(
				НоваяСтрока.СчетУчетаУСН, НоваяСтрока.РасходыУСН, Реквизиты);
			
			НоваяСтрока.ДокументОплаты = Реквизиты.Ссылка;
			
			// Спишем рублевые остатки расходов (УСН), учтенные по курсу на дату документа поступления (партии).
			Если РасходУСН.Валюта <> БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета() Тогда
				
				Коэффициент = ?(РасходУСН.СуммаВал = 0, 0, РасходУСН.ОплаченоСуммаВал / РасходУСН.СуммаВал);
				
				Если Коэффициент * РасходУСН.СуммаРуб                <> РасходУСН.ОплаченоСуммаРуб
				 ИЛИ Коэффициент * РасходУСН.СуммаНДСРуб             <> РасходУСН.ОплаченоСуммаНДСРуб
				 ИЛИ Коэффициент * РасходУСН.СуммаЕНВДРуб            <> РасходУСН.ОплаченоСуммаЕНВДРуб
				 ИЛИ Коэффициент * РасходУСН.СуммаНеУчитываетсяНУРуб <> РасходУСН.ОплаченоСуммаНеУчитываетсяНУРуб Тогда
					
					КорректировкаСуммРуб = ТаблицаОплаченныхРасходовУСН.Добавить();
					ЗаполнитьЗначенияСвойств(КорректировкаСуммРуб, НоваяСтрока,
						"ИмяСписка,СинонимСписка,НомерСтроки,
						|ИФО,КФО,КПС,Подразделение,СчетРасчетов,Контрагент,Договор,ДокументРасчетов,Валюта,СчетУчетаУСН,РасходыУСН,
						|ВидСубконтоРасходов2,СубконтоРасходов2,ВидСубконтоРасходов3,СубконтоРасходов3");
					
					КорректировкаСуммРуб.СуммаРуб                = Коэффициент * РасходУСН.СуммаРуб                - РасходУСН.ОплаченоСуммаРуб;
					КорректировкаСуммРуб.СуммаНДСРуб             = Коэффициент * РасходУСН.СуммаНДСРуб             - РасходУСН.ОплаченоСуммаНДСРуб;
					КорректировкаСуммРуб.СуммаЕНВДРуб            = Коэффициент * РасходУСН.СуммаЕНВДРуб            - РасходУСН.ОплаченоСуммаЕНВДРуб;
					КорректировкаСуммРуб.СуммаНеУчитываетсяНУРуб = Коэффициент * РасходУСН.СуммаНеУчитываетсяНУРуб - РасходУСН.ОплаченоСуммаНеУчитываетсяНУРуб;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТаблицаОплаченныхРасходовУСН;
	
КонецФункции

Функция ОплаченныеРасходыУСНЗачетАванса(Оплата, ТаблицаРасходовУСН, Реквизиты)
	
	Отбор = Новый Структура;
	Отбор.Вставить("КФО", Оплата.КФО);
	
	Если Реквизиты.ИспользоватьУчетПоИФО Тогда
		Отбор.Вставить("ИФО", Оплата.ИФО);
	КонецЕсли;
	
	СвойстваСчетаРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Оплата.СчетРасчетов);
	Если Реквизиты.ИспользоватьУчетПоПодразделениям И СвойстваСчетаРасчетов.УчетПоПодразделениям Тогда
		Отбор.Вставить("Подразделение", Оплата.Подразделение);
	КонецЕсли;
	Если Реквизиты.ИспользоватьВалютныйУчет И СвойстваСчетаРасчетов.Валютный Тогда
		Отбор.Вставить("Валюта", Оплата.Валюта);
	КонецЕсли;
	
	Отбор.Вставить("СчетРасчетов", Оплата.СчетРасчетов);
	Отбор.Вставить("Контрагент",   Оплата.Контрагент);
	
	Если ЗначениеЗаполнено(Оплата.Договор)
	   И БухгалтерскийУчетПовтИсп.НаСчетеВедетсяУчетПоДоговорам(Оплата.СчетРасчетов) Тогда
		Отбор.Вставить("Договор", Оплата.Договор);
	КонецЕсли;
	
	ОписаниеТипаСуммы      = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	
	ОплаченныеРасходыУСН = ТаблицаРасходовУСН.Скопировать(Отбор);
	// Сворачиваем по всем колонкам таблицы УчетУСН.ПустаяТаблицаПоступлениеРасходовУСН().
	// Избавляемся от строк с отрицательными суммами расходов, например, удержание НДФЛ.
	ОплаченныеРасходыУСН.Свернуть("ИмяСписка,СинонимСписка,НомерСтроки,ИФО,КФО,КПС,Подразделение,
	|СчетУчетаУСН,ВидРасхода,ЭлементРасхода,Партия,ИмяСпискаДокумента,НомерСтрокиДокумента,ОтражениеВУСН,
	|СчетРасчетов,Контрагент,Договор,ДокументРасчетов,Валюта,РасходыУСН,
	|ВидСубконтоРасходов2,СубконтоРасходов2,ВидСубконтоРасходов3,СубконтоРасходов3",
		"Количество,СуммаВал,СуммаРуб,СуммаНДСВал,СуммаНДСРуб,СуммаНеУчитываетсяНУРуб,СуммаЕНВДРуб");
	ОплаченныеРасходыУСН.Колонки.Добавить("ОплаченоКоличество",              ОписаниеТипаКоличества);
	ОплаченныеРасходыУСН.Колонки.Добавить("ОплаченоСуммаВал",                ОписаниеТипаСуммы);
	ОплаченныеРасходыУСН.Колонки.Добавить("ОплаченоСуммаРуб",                ОписаниеТипаСуммы);
	ОплаченныеРасходыУСН.Колонки.Добавить("ОплаченоСуммаНеУчитываетсяНУРуб", ОписаниеТипаСуммы);
	ОплаченныеРасходыУСН.Колонки.Добавить("ОплаченоСуммаЕНВДРуб",            ОписаниеТипаСуммы);
	ОплаченныеРасходыУСН.Колонки.Добавить("ОплаченоСуммаНДСРуб",             ОписаниеТипаСуммы);
	ОплаченныеРасходыУСН.Колонки.Добавить("ВсегоРасходовВал",                ОписаниеТипаСуммы);
	Для Каждого СтрокаРасходовУСН Из ОплаченныеРасходыУСН Цикл
		
		Если СвойстваСчетаРасчетов.УчетПоКПС Тогда
			СвойстваСчетаУСН = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаРасходовУСН.СчетУчетаУСН);
			Если СвойстваСчетаУСН.УчетПоКПС И (СтрокаРасходовУСН.КПС <> Оплата.КПС) Тогда
				Продолжить; // Пропускаем расходы по другим КПС.
			КонецЕсли;
		КонецЕсли;
		
		Если СтрокаРасходовУСН.СуммаВал > 0 Тогда
			// Распределять оплату будем только на строки с положительной суммой расходов УСН.
			СтрокаРасходовУСН.ВсегоРасходовВал = СтрокаРасходовУСН.СуммаВал + СтрокаРасходовУСН.СуммаНДСВал;
		КонецЕсли;
		
	КонецЦикла;
	
	СуммаОплатыВал = Мин(Оплата.СуммаРасчетов, Оплата.РасходыУСНВал);
	СуммаОплатыРуб = Мин(Оплата.СуммаРубПоКурсуАванса, Оплата.РасходыУСНРуб);
	РаспределитьСуммуОплатыРасходовУСН(СуммаОплатыВал, СуммаОплатыРуб, ОплаченныеРасходыУСН);
	
	Возврат ОплаченныеРасходыУСН;
	
КонецФункции

Функция ОплаченныеРасходыУСНПогашениеЗадолженности(Оплата, ТаблицаРасходовУСН, Реквизиты)
	
	Отбор = Новый Структура;
	Отбор.Вставить("КФО", Оплата.КФО);
	
	Если Реквизиты.ИспользоватьУчетПоИФО Тогда
		Отбор.Вставить("ИФО", Оплата.ИФО);
	КонецЕсли;
	
	СвойстваСчетаРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Оплата.СчетРасчетов);
	Если Реквизиты.ИспользоватьУчетПоПодразделениям И СвойстваСчетаРасчетов.УчетПоПодразделениям Тогда
		Отбор.Вставить("Подразделение", Оплата.Подразделение);
	КонецЕсли;
	Если Реквизиты.ИспользоватьВалютныйУчет И СвойстваСчетаРасчетов.Валютный Тогда
		Отбор.Вставить("Валюта", Оплата.Валюта);
	КонецЕсли;
	
	Отбор.Вставить("СчетРасчетов", Оплата.СчетРасчетов);
	Отбор.Вставить("Контрагент",   Оплата.Контрагент);
	
	Если ЗначениеЗаполнено(Оплата.Договор)
	   И БухгалтерскийУчетПовтИсп.НаСчетеВедетсяУчетПоДоговорам(Оплата.СчетРасчетов) Тогда
		Отбор.Вставить("Договор", Оплата.Договор);
	КонецЕсли;
	
	ВедетсяУчетПоДокументамРасчетов =
		(Оплата.ВидДопСубконтоРасчетов = ПланыВидовХарактеристик.ВидыСубконто.ДокументыРасчетов)
		И ЗначениеЗаполнено(Оплата.ДопСубконтоРасчетов);
	Если ВедетсяУчетПоДокументамРасчетов Тогда
		Отбор.Вставить("ДокументРасчетов", Оплата.ДопСубконтоРасчетов);
	КонецЕсли;
	
	ОписаниеТипаСуммы      = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	
	ОплаченныеРасходыУСН = ТаблицаРасходовУСН.Скопировать(Отбор);
	ОплаченныеРасходыУСН.Колонки.Добавить("ОплаченоКоличество",              ОписаниеТипаКоличества);
	ОплаченныеРасходыУСН.Колонки.Добавить("ОплаченоСуммаВал",                ОписаниеТипаСуммы);
	ОплаченныеРасходыУСН.Колонки.Добавить("ОплаченоСуммаРуб",                ОписаниеТипаСуммы);
	ОплаченныеРасходыУСН.Колонки.Добавить("ОплаченоСуммаНеУчитываетсяНУРуб", ОписаниеТипаСуммы);
	ОплаченныеРасходыУСН.Колонки.Добавить("ОплаченоСуммаЕНВДРуб",            ОписаниеТипаСуммы);
	ОплаченныеРасходыУСН.Колонки.Добавить("ОплаченоСуммаНДСРуб",             ОписаниеТипаСуммы);
	ОплаченныеРасходыУСН.Колонки.Добавить("ВсегоРасходовВал",                ОписаниеТипаСуммы);
	ОплаченныеРасходыУСН.Колонки.Добавить("ВсегоРасходовРуб",                ОписаниеТипаСуммы);
	Для Каждого СтрокаРасходовУСН Из ОплаченныеРасходыУСН Цикл
		
		Если СвойстваСчетаРасчетов.УчетПоКПС Тогда
			СвойстваСчетаУСН = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаРасходовУСН.СчетУчетаУСН);
			Если СвойстваСчетаУСН.УчетПоКПС И (СтрокаРасходовУСН.КПС <> Оплата.КПС) Тогда
				Продолжить; // Пропускаем расходы по другим КПС.
			КонецЕсли;
		КонецЕсли;
		
		Если СтрокаРасходовУСН.СуммаВал > 0 Тогда
			// Распределять оплату будем только на строки с положительной суммой расходов УСН.
			СтрокаРасходовУСН.ВсегоРасходовВал = СтрокаРасходовУСН.СуммаВал;
			СтрокаРасходовУСН.ВсегоРасходовРуб = СтрокаРасходовУСН.СуммаРуб +
				СтрокаРасходовУСН.СуммаНеУчитываетсяНУРуб + СтрокаРасходовУСН.СуммаЕНВДРуб + СтрокаРасходовУСН.СуммаНДСРуб;
		КонецЕсли;
		
	КонецЦикла;
	
	ОсталосьПогаситьВал = Мин(Оплата.СуммаРасчетов, ОплаченныеРасходыУСН.Итог("ВсегоРасходовВал"));
	Если Оплата.Валюта = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета() Тогда
		// Если расчеты в рублях, сумма оплаченных расходов не может превышать сумму расходов,
		// признанных первоначально при поступлении расходов.
		ОсталосьПогаситьРуб = Мин(Оплата.СуммаРуб, ОплаченныеРасходыУСН.Итог("ВсегоРасходовРуб"));
	Иначе
		// Если расчеты в валюте, сумма расходов в рублях может быть как больше, так и меньше суммы расходов,
		// признанных первоначально при поступлении расходов из-за разницы курсов.
		Коэффициент = ?(Оплата.СуммаРасчетов = 0, 0, ОсталосьПогаситьВал / Оплата.СуммаРасчетов);
		ОсталосьПогаситьРуб = Коэффициент * Оплата.СуммаРуб;
	КонецЕсли;
	
	Если ВедетсяУчетПоДокументамРасчетов Тогда
		
		// В таблице ОплаченныеРасходыУСН отобраны расходы УСН по оплаченному расчетному документу.
		// Просто распределим сумму оплаты на все расходы УСН по данному расчетному документу.
		РаспределитьСуммуОплатыРасходовУСН(ОсталосьПогаситьВал, ОсталосьПогаситьРуб, ОплаченныеРасходыУСН);
		
	Иначе
		
		// В таблице ОплаченныеРасходыУСН отобраны расходы УСН по нескольким расчетным документам.
		// Выстраиваем их по FIFO и последовательно распределяем сумму оплаты по каждому расчетному документу.
		ДокументыРасчетов = ОплаченныеРасходыУСН.Скопировать(, "ДокументРасчетов,ДатаДокументаРасчетов,ВсегоРасходовВал,ВсегоРасходовРуб");
		ДокументыРасчетов.Свернуть("ДокументРасчетов,ДатаДокументаРасчетов", "ВсегоРасходовВал,ВсегоРасходовРуб");
		ДокументыРасчетов.Сортировать("ДатаДокументаРасчетов");
		
		Для Каждого ДокументРасчетов Из ДокументыРасчетов Цикл
			
			ОтборПоДокументуРасчетов = Новый Структура("ДокументРасчетов", ДокументРасчетов.ДокументРасчетов);
			ОплаченныеРасходыПоДокументуРасчетовУСН = ОплаченныеРасходыУСН.НайтиСтроки(ОтборПоДокументуРасчетов);
			
			ПогаситьВал = Мин(ОсталосьПогаситьВал, ДокументРасчетов.ВсегоРасходовВал);
			Если Оплата.Валюта = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета() Тогда
				ПогаситьРуб = Мин(ОсталосьПогаситьРуб, ДокументРасчетов.ВсегоРасходовРуб);
			Иначе
				Коэффициент = ?(ОсталосьПогаситьВал = 0, 0, ПогаситьВал / ОсталосьПогаситьВал);
				ПогаситьРуб = Коэффициент * ОсталосьПогаситьРуб;
			КонецЕсли;
			
			РаспределитьСуммуОплатыРасходовУСН(ПогаситьВал, ПогаситьРуб, ОплаченныеРасходыПоДокументуРасчетовУСН);
			
			ОсталосьПогаситьВал = ОсталосьПогаситьВал - ПогаситьВал;
			ОсталосьПогаситьРуб = ОсталосьПогаситьРуб - ПогаситьРуб;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ОплаченныеРасходыУСН;
	
КонецФункции

Процедура РаспределитьСуммуОплатыРасходовУСН(СуммаОплатыВал, СуммаОплатыРуб, ОплаченныеРасходыУСН)
	
	Если СуммаОплатыВал < 0 Тогда
		Возврат;
	КонецЕсли;
	
	ОбщегоНазначенияБГУ.РаспределитьСуммуПоСтрокамТаблицы(СуммаОплатыВал,
		ОплаченныеРасходыУСН, "ОплаченоСуммаВал", "ВсегоРасходовВал");
	
	ОбщегоНазначенияБГУ.РаспределитьСуммуПоСтрокамТаблицы(СуммаОплатыРуб,
		ОплаченныеРасходыУСН, "ОплаченоСуммаРуб", "ВсегоРасходовВал");
	
	Для Каждого СтрокаРасходовУСН Из ОплаченныеРасходыУСН Цикл
		
		Если СтрокаРасходовУСН.СуммаВал = 0
		 ИЛИ СтрокаРасходовУСН.ОплаченоСуммаВал = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		// Рассчитаем долю оплаченного количества, сумм в рублях и НДС.
		ДоляОплатыРасходов = ?(СтрокаРасходовУСН.ОплаченоСуммаВал < СтрокаРасходовУСН.ВсегоРасходовВал,
			СтрокаРасходовУСН.ОплаченоСуммаВал / СтрокаРасходовУСН.ВсегоРасходовВал, 1);
			
		СтрокаРасходовУСН.ОплаченоКоличество = ДоляОплатыРасходов * СтрокаРасходовУСН.Количество;
		
		// Распределим сумму оплаты в рублях по компонентам.
		БазаРаспределения = Новый Массив;
		БазаРаспределения.Добавить(СтрокаРасходовУСН.СуммаРуб);
		БазаРаспределения.Добавить(СтрокаРасходовУСН.СуммаНеУчитываетсяНУРуб);
		БазаРаспределения.Добавить(СтрокаРасходовУСН.СуммаЕНВДРуб);
		БазаРаспределения.Добавить(СтрокаРасходовУСН.СуммаНДСРуб);
		
		РаспределениеСуммыОплатыРуб = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
			СтрокаРасходовУСН.ОплаченоСуммаРуб, БазаРаспределения);
		Если РаспределениеСуммыОплатыРуб = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаРасходовУСН.ОплаченоСуммаРуб                = РаспределениеСуммыОплатыРуб[0];
		СтрокаРасходовУСН.ОплаченоСуммаНеУчитываетсяНУРуб = РаспределениеСуммыОплатыРуб[1];
		СтрокаРасходовУСН.ОплаченоСуммаЕНВДРуб            = РаспределениеСуммыОплатыРуб[2];
		СтрокаРасходовУСН.ОплаченоСуммаНДСРуб             = РаспределениеСуммыОплатыРуб[3];
		
	КонецЦикла;
	
КонецПроцедуры

Функция СчетУчетаОплаченныхРасходовУСН(СчетУчетаУСН, РасходУСН, Реквизиты)
	
	КодСчетаУчетаУСН = Строка(СчетУчетаУСН);
	
	// ОС: не Оплачены.
	Если Найти(КодСчетаУчетаУСН, "У01.О") Тогда
		
		Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У01.П"); // Признать расходы.
		
	ИначеЕсли Найти(КодСчетаУчетаУСН, "У01.ВО") Тогда
		
		Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У01.В"); // Признать расходы.
		
	// НМА: не Оплачены.
	ИначеЕсли Найти(КодСчетаУчетаУСН, "У04.О") Тогда
		
		Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У04.П"); // Признать расходы.
		
	// Кап. вложения: имущество не Принято к учету, расходы не Оплачены.
	ИначеЕсли Найти(КодСчетаУчетаУСН, "У08.ПО") Тогда
		
		Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У08.П"); // Принять к учету.
		
	// Кап. вложения в неамортизируемое имущество: расходы не Оплачены.
	ИначеЕсли Найти(КодСчетаУчетаУСН, "У08.О") Тогда
		
		Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У99"); // Включаем расходы в КУДиР.
		
	// Материалы: не Списаны, не Оплачены.
	ИначеЕсли Найти(КодСчетаУчетаУСН, "У10.СО") Тогда
		
		Если Реквизиты.МатериалыПоОплате Тогда
			
			Если РасходУСН.ОтражениеВУСН = Перечисления.ОтражениеВУСН.Распределяются Тогда
				Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У10.Р"); // Распределить.
			Иначе
				Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У10.СП"); // Не Списаны, расходы Признаны.
			КонецЕсли;
			
		Иначе
			Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У10.С"); // Списать.
		КонецЕсли;
		
	// Материалы: не Оплачены, не Распределены.
	ИначеЕсли Найти(КодСчетаУчетаУСН, "У10.ОР") Тогда
		
		Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У10.Р"); // Распределить.
		
	// Товары: не Списаны, не Оплачены.
	ИначеЕсли Найти(КодСчетаУчетаУСН, "У41.СО") Тогда
		
		Если Реквизиты.ТоварыПоОплате Тогда
			
			Если РасходУСН.ОтражениеВУСН = Перечисления.ОтражениеВУСН.Распределяются Тогда
				Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У41.Р"); // Распределить.
			Иначе
				Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У41.СП"); // Не Списаны, расходы Признаны.
			КонецЕсли;
			
		Иначе
			Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У41.С"); // Списать.
		КонецЕсли;
		
	// Товары: не Оплачены, не Распределены.
	ИначеЕсли Найти(КодСчетаУчетаУСН, "У41.ОР") Тогда
		
		Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У41.Р"); // Распределить.
		
	// Вложения в материальные запасы: не Списаны, не Оплачены.
	ИначеЕсли Найти(КодСчетаУчетаУСН, "У15.СО") Тогда
		
		Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У15.С"); // Списать (принять к учету).
		
	// Доп. расходы: не Оплачены.
	ИначеЕсли Найти(КодСчетаУчетаУСН, "У15.О") Тогда
		
		Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У99"); // Включаем расходы в КУДиР.
		
	// Материалы, товары, услуги и пр.: не Оплачены.
	ИначеЕсли Найти(КодСчетаУчетаУСН, "У10.О")
	      ИЛИ Найти(КодСчетаУчетаУСН, "У20.О")
	      ИЛИ Найти(КодСчетаУчетаУСН, "У41.О")
	      ИЛИ Найти(КодСчетаУчетаУСН, "У70.О") Тогда
		
		Если РасходУСН.ОтражениеВУСН = Перечисления.ОтражениеВУСН.Распределяются Тогда
			Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду(Лев(КодСчетаУчетаУСН, 4)+"Р"); // Распределить.
		Иначе
			Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У99"); // Включаем расходы в КУДиР.
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции

// Начисление обязательств за счет резерва

Функция ПустаяТаблицаПриемкаТоваровРаботУслугУСН() Экспорт
	
	ОписаниеТипаСуммы       = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества  = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Идентификация строки.
	ПустаяТаблица.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	
	// Аналитика учета расчетов с контрагентами.
	ПустаяТаблица.Колонки.Добавить("СчетРасчетов",  Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("Контрагент",    Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ПустаяТаблица.Колонки.Добавить("Договор",       Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ПустаяТаблица.Колонки.Добавить("Валюта",        Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	
	// Приемка товаров, работ, услуг.
	ПустаяТаблица.Колонки.Добавить("ВнеоборотныйАктив", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ПустаяТаблица.Колонки.Добавить("Номенклатура",      Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ПустаяТаблица.Колонки.Добавить("Содержание",        Новый ОписаниеТипов("Строка"));
	ПустаяТаблица.Колонки.Добавить("Количество",        ОписаниеТипаКоличества);
	ПустаяТаблица.Колонки.Добавить("СуммаРуб",          ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаВал",          ОписаниеТипаСуммы);
	
	Возврат ПустаяТаблица;
	
КонецФункции

Функция ПодготовитьТаблицыПриемкаТоваровРаботУслугУСН(ТаблицыПоступления, Документ, Параметры = Неопределено, Отказ) Экспорт
	
	ТаблицыПриемкаТоваровРаботУслуг = Новый Структура;
	ТаблицыПриемкаТоваровРаботУслуг.Вставить("ТоварыРаботыУслуги", ПустаяТаблицаПриемкаТоваровРаботУслугУСН());
	ТаблицыПриемкаТоваровРаботУслуг.Вставить("ДокументыПоступления", Новый ТаблицаЗначений);
	
	Если НЕ УчетУСНВызовСервера.ПрименяетсяУСНДоходыМинусРасходы(Документ.Организация, Документ.Дата) Тогда
		Возврат ТаблицыПриемкаТоваровРаботУслуг;
	КонецЕсли;
	
	// Материальные запасы.
	Если ТаблицыПоступления.Свойство("ПоступлениеМатериальныхЗапасов")
	   И ТаблицыПоступления.ПоступлениеМатериальныхЗапасов.Количество() > 0 Тогда
		
		Для Каждого СтрокаДокумента Из ТаблицыПоступления.ПоступлениеМатериальныхЗапасов Цикл
			
			Если НЕ УчетУСНКлиентСервер.ВедетсяУчетУСНпоКФО(СтрокаДокумента.КФО) Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ТаблицыПриемкаТоваровРаботУслуг.ТоварыРаботыУслуги.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДокумента);
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Услуги, работы.
	Если ТаблицыПоступления.Свойство("ПоступлениеУслугРабот")
	   И ТаблицыПоступления.ПоступлениеУслугРабот.Количество() > 0 Тогда
		
		Для Каждого СтрокаДокумента Из ТаблицыПоступления.ПоступлениеУслугРабот Цикл
			
			Если НЕ УчетУСНКлиентСервер.ВедетсяУчетУСНпоКФО(СтрокаДокумента.КФО) Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ТаблицыПриемкаТоваровРаботУслуг.ТоварыРаботыУслуги.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДокумента);
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Услуги, работы.
	Если ТаблицыПоступления.Свойство("ПоступлениеОсновныхСредств")
	   И ТаблицыПоступления.ПоступлениеОсновныхСредств.Количество() > 0 Тогда
		
		Для Каждого СтрокаДокумента Из ТаблицыПоступления.ПоступлениеОсновныхСредств Цикл
			
			Если НЕ УчетУСНКлиентСервер.ВедетсяУчетУСНпоКФО(СтрокаДокумента.КФО) Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ТаблицыПриемкаТоваровРаботУслуг.ТоварыРаботыУслуги.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДокумента);
			
		КонецЦикла;
		
	КонецЕсли;
	
	МетаданныеДокумента = Документ.Метаданные();
	Если ОбщегоНазначенияБГУ.ЕстьТабЧастьДокумента("ДокументыПоступления", МетаданныеДокумента) Тогда
		ТаблицыПриемкаТоваровРаботУслуг.ДокументыПоступления = Документ.ДокументыПоступления.Выгрузить();
	КонецЕсли;
	
	Возврат ТаблицыПриемкаТоваровРаботУслуг;
	
КонецФункции

Функция ПустаяТаблицаНачислениеОбязательствЗаСчетРезерваУСН() Экспорт

	ОписаниеТипаСуммы       = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества  = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	ОписаниеТипаСубконто    = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	ОписаниеТипаВидСубконто = Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто");
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Идентификация строки.
	ПустаяТаблица.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	
	// Свойства расходов для формирования элементов справочника "Расходы УСН".
	МетаданныеРасходовУСН  = Метаданные.Справочники.РасходыУСН.Реквизиты;
	ПустаяТаблица.Колонки.Добавить("Партия",               МетаданныеРасходовУСН.Партия.Тип);
	ПустаяТаблица.Колонки.Добавить("ИмяСпискаДокумента",   МетаданныеРасходовУСН.ИмяСпискаДокумента.Тип);
	ПустаяТаблица.Колонки.Добавить("НомерСтрокиДокумента", МетаданныеРасходовУСН.НомерСтрокиДокумента.Тип);
	ПустаяТаблица.Колонки.Добавить("ВидРасхода",           МетаданныеРасходовУСН.ВидРасхода.Тип);
	ПустаяТаблица.Колонки.Добавить("ЭлементРасхода",       МетаданныеРасходовУСН.ЭлементРасхода.Тип);
	ПустаяТаблица.Колонки.Добавить("ОтражениеВУСН",        МетаданныеРасходовУСН.ОтражениеВУСН.Тип);
	
	// Аналитика учета расчетов с контрагентами.
	ПустаяТаблица.Колонки.Добавить("СчетРасчетов",  Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("Контрагент",    Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ПустаяТаблица.Колонки.Добавить("Договор",       Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ПустаяТаблица.Колонки.Добавить("ДокументРасчетов",
		ПланыВидовХарактеристик.ВидыСубконто.ДокументыРасчетов.ТипЗначения);
	ПустаяТаблица.Колонки.Добавить("Валюта",        Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	
	// Счет и аналитика учета расходов УСН к погашению (Кт).
	ПустаяТаблица.Колонки.Добавить("СчетУчетаУСН",  Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("РасходыУСН",    Новый ОписаниеТипов("СправочникСсылка.РасходыУСН"));
	ПустаяТаблица.Колонки.Добавить("ВидСубконтоРасходов2",  ОписаниеТипаВидСубконто);
	ПустаяТаблица.Колонки.Добавить("СубконтоРасходов2",     ОписаниеТипаСубконто);
	ПустаяТаблица.Колонки.Добавить("ВидСубконтоРасходов3",  ОписаниеТипаВидСубконто);
	ПустаяТаблица.Колонки.Добавить("СубконтоРасходов3",     ОписаниеТипаСубконто);
	
	// Счет и аналитика учета расходов УСН к оплате (Дт).
	ПустаяТаблица.Колонки.Добавить("КорРасходыУСН", Новый ОписаниеТипов("СправочникСсылка.РасходыУСН"));
	
	// Содержание проводки.
	ПустаяТаблица.Колонки.Добавить("Содержание", Новый ОписаниеТипов("Строка"));
	
	// Количество, сумма.
	ПустаяТаблица.Колонки.Добавить("Количество",              ОписаниеТипаКоличества);
	ПустаяТаблица.Колонки.Добавить("СуммаВал",                ОписаниеТипаСуммы); // Сумма в валюте документа.
	ПустаяТаблица.Колонки.Добавить("СуммаРуб",                ОписаниеТипаСуммы); // Сумма в рублях.
	ПустаяТаблица.Колонки.Добавить("СуммаНеУчитываетсяНУРуб", ОписаниеТипаСуммы); // Сумма в рублях.
	ПустаяТаблица.Колонки.Добавить("СуммаЕНВДРуб",            ОписаниеТипаСуммы); // Сумма в рублях.
	ПустаяТаблица.Колонки.Добавить("СуммаНДСРуб",             ОписаниеТипаСуммы); // Сумма НДС в рублях.
	ПустаяТаблица.Колонки.Добавить("СуммаНДСВал",             ОписаниеТипаСуммы); // Сумма НДС в валюте документа.
	
	Возврат ПустаяТаблица;

КонецФункции

Функция ТаблицаНачислениеОбязательствЗаСчетРезерваУСН(ТаблицыПриемкаТоваровРаботУслуг, Реквизиты, Отказ) Экспорт
	
	ТаблицаНачислениеОбязательствЗаСчетРезерваУСН = ПустаяТаблицаНачислениеОбязательствЗаСчетРезерваУСН();
	
	УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Реквизиты.Организация, Реквизиты.Дата);
	Если НЕ УчетнаяПолитика.ПрименяетсяУСНДоходыМинусРасходы Тогда
		Возврат ТаблицаНачислениеОбязательствЗаСчетРезерваУСН;
	КонецЕсли;
	
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	Реквизиты.Вставить("ПлательщикЕНВД",                   УчетнаяПолитика.ПлательщикЕНВД);
	
	// Параметры учетной политики в части учета расходов УСН.
	Реквизиты.Вставить("ТоварыПоОплате", УчетнаяПолитика.ПорядокПризнанияРасходовПоТоварам =
		Перечисления.ПорядокПризнанияРасходовПоТоварам.ПоОплатеПоставщику);
	Реквизиты.Вставить("ТоварыПоОтгрузке", УчетнаяПолитика.ПорядокПризнанияРасходовПоТоварам =
		Перечисления.ПорядокПризнанияРасходовПоТоварам.ПоФактуРеализации);
	Реквизиты.Вставить("МатериалыПоОплате", УчетнаяПолитика.ПорядокПризнанияМатериальныхРасходов =
		Перечисления.ПорядокПризнанияМатериальныхРасходов.ПоОплатеПоставщику);
	Реквизиты.Вставить("ДопРасходыПоОплате", УчетнаяПолитика.ПорядокПризнанияДопРасходов =
		Перечисления.ПорядокПризнанияДопРасходов.ПоОплатеПоставщику);
	Реквизиты.Вставить("ТаможенныеПлатежиПоОплате", УчетнаяПолитика.ПорядокПризнанияТаможенныхПлатежей =
		Перечисления.ПорядокПризнанияТаможенныхПлатежей.ПоОплате);
	Реквизиты.Вставить("НДСПоОплате", УчетнаяПолитика.ПорядокПризнанияРасходовПоНДС =
		Перечисления.ПорядокПризнанияРасходовПоНДС.ПоОплатеПоставщику);
	
	ТоварыРаботыУслуги = ТаблицыПриемкаТоваровРаботУслуг.ТоварыРаботыУслуги;
	ДокументыПоступления = ТаблицыПриемкаТоваровРаботУслуг.ДокументыПоступления;
	
	Если ТоварыРаботыУслуги.Количество() = 0 Тогда
		Возврат ТаблицаНачислениеОбязательствЗаСчетРезерваУСН;
	КонецЕсли;
	
	// Получим остатки расходов УСН по принятым позициям Номенклатуры.
	СчетаРасходовУСН = БухгалтерскийУчет.СписокСчетов(
		"У08.ПО,У10.СО,У15.СО,У20.О,У41.СО");
	
	ОтборРасходов = Новый Структура;
	
	ВидыРасходовУСН = Новый Массив;
	ВидыРасходовУСН.Добавить(Перечисления.ВидыРасходовУСН.КапВложения);
	ВидыРасходовУСН.Добавить(Перечисления.ВидыРасходовУСН.МатериальныеЗапасы);
	ВидыРасходовУСН.Добавить(Перечисления.ВидыРасходовУСН.Услуги);
	ВидыРасходовУСН.Добавить(Перечисления.ВидыРасходовУСН.ДопРасходы);
	ОтборРасходов.Вставить("ВидРасхода", ВидыРасходовУСН);
	
	ОтборРасходов.Вставить("СчетРасчетов", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
		ТоварыРаботыУслуги.ВыгрузитьКолонку("СчетРасчетов")));
	ОтборРасходов.Вставить("Контрагент", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
		ТоварыРаботыУслуги.ВыгрузитьКолонку("Контрагент")));
	ОтборРасходов.Вставить("Договор", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
		ТоварыРаботыУслуги.ВыгрузитьКолонку("Договор")));
	
	Если Реквизиты.ИспользоватьУчетПоИФО Тогда
		ОтборРасходов.Вставить("ИФО", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
			ТоварыРаботыУслуги.ВыгрузитьКолонку("ИФО")));
	КонецЕсли;
	ОтборРасходов.Вставить("КФО", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
		ТоварыРаботыУслуги.ВыгрузитьКолонку("КФО")));
	
	Если ДокументыПоступления.Количество() > 0 Тогда // Акт приемки ф.0510452.
		ОтборРасходов.Вставить("ДокументРасчетов", ДокументыПоступления.ВыгрузитьКолонку("ДокументОснование"));
	КонецЕсли;
	
	ПериодОстатков = ?(Реквизиты.Свойство("ПериодОстатков"), Реквизиты.ПериодОстатков,
		УчетРасчетов.ПериодПолученияОстатков(Реквизиты.Ссылка));
	ОстаткиРасходовУСН = ОстаткиРасходовУСН(ПериодОстатков, СчетаРасходовУСН, ОтборРасходов, Реквизиты);
	ОбщегоНазначенияБГУ.УпорядочитьТаблицуПоДокументу(ОстаткиРасходовУСН, "ДокументРасчетов", "ДатаДокументаРасчетов");
	
	// Заполним таблицу расходов УСН по принятым позициям Номенклатуры.
	Для Каждого СтрокаПриемкаТоваровРаботУслуг Из ТоварыРаботыУслуги Цикл
		
		РасходыУСНПоПринятымТРУ = РасходыУСНПоПринятымТРУ(
			СтрокаПриемкаТоваровРаботУслуг, ОстаткиРасходовУСН, Реквизиты);
		
		Для Каждого ПринятыеРасходыУСН Из РасходыУСНПоПринятымТРУ Цикл
			
			НоваяСтрока = ТаблицаНачислениеОбязательствЗаСчетРезерваУСН.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПриемкаТоваровРаботУслуг,
				"ИмяСписка,СинонимСписка,НомерСтроки");
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ПринятыеРасходыУСН, "ВидРасхода,ЭлементРасхода,ОтражениеВУСН,
				|ИФО,КФО,КПС,Подразделение,СчетРасчетов,Контрагент,Договор,ДокументРасчетов,Валюта,СчетУчетаУСН,РасходыУСН");
			
			СвойстваСчетаУчетаУСН = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ПринятыеРасходыУСН.СчетУчетаУСН);
			НоваяСтрока.ВидСубконтоРасходов2 = СвойстваСчетаУчетаУСН.ВидСубконто1;
			НоваяСтрока.СубконтоРасходов2    = ПринятыеРасходыУСН.СубконтоРасходов2;
			НоваяСтрока.ВидСубконтоРасходов3 = СвойстваСчетаУчетаУСН.ВидСубконто3;
			НоваяСтрока.СубконтоРасходов3    = ПринятыеРасходыУСН.СубконтоРасходов3;
			
			// Элементы, по которым учтены расходы УСН в корреспонденции с 401.60.
			НоваяСтрока.КорРасходыУСН = ПринятыеРасходыУСН.РасходыУСН;
			НоваяСтрока.ИмяСпискаДокумента   = СтрокаПриемкаТоваровРаботУслуг.ИмяСписка;
			НоваяСтрока.НомерСтрокиДокумента = СтрокаПриемкаТоваровРаботУслуг.НомерСтроки;
			
			НоваяСтрока.Количество              = ПринятыеРасходыУСН.ПринятоКоличество;
			НоваяСтрока.СуммаВал                = ПринятыеРасходыУСН.ПринятоСуммаВал;
			НоваяСтрока.СуммаРуб                = ПринятыеРасходыУСН.ПринятоСуммаРуб;
			НоваяСтрока.СуммаНеУчитываетсяНУРуб = ПринятыеРасходыУСН.ПринятоСуммаНеУчитываетсяНУРуб;
			НоваяСтрока.СуммаЕНВДРуб            = ПринятыеРасходыУСН.ПринятоСуммаЕНВДРуб;
			НоваяСтрока.СуммаНДСРуб             = ПринятыеРасходыУСН.ПринятоСуммаНДСРуб;
			
			// Содержание операции.
			Если ЗначениеЗаполнено(СтрокаПриемкаТоваровРаботУслуг.ВнеоборотныйАктив) Тогда
				ПредставлениеОбъекта = БухгалтерскиеОперацииПовтИсп.ПредставлениеОбъекта(СтрокаПриемкаТоваровРаботУслуг.ВнеоборотныйАктив);
			Иначе
				ПредставлениеОбъекта = БухгалтерскиеОперацииПовтИсп.ПредставлениеОбъекта(СтрокаПриемкаТоваровРаботУслуг.Номенклатура);
			КонецЕсли;
			НоваяСтрока.Содержание = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Начисление обязательств за счет резерва: %1'"),
					ПредставлениеОбъекта);
				
		КонецЦикла;
		
	КонецЦикла;
	
	// Формируем новые элементы учета расходов УСН с партией/расчетным документом "Акт приемки", Дт 401.60 Кт 302.00.
	ТаблицаНачислениеОбязательствЗаСчетРезерваУСН.ЗаполнитьЗначения(Реквизиты.Ссылка, "Партия");
	ТаблицаНачислениеОбязательствЗаСчетРезерваУСН.ЗаполнитьЗначения(Реквизиты.Ссылка, "ДокументРасчетов");
	ТаблицаНачислениеОбязательствЗаСчетРезерваУСН.Сортировать("ИмяСпискаДокумента,НомерСтрокиДокумента");
	СформироватьЭлементыУчетаРасходовУСН(Реквизиты.Ссылка, ТаблицаНачислениеОбязательствЗаСчетРезерваУСН);
	
	Возврат ТаблицаНачислениеОбязательствЗаСчетРезерваУСН;
	
КонецФункции

Функция РасходыУСНПоПринятымТРУ(ПриемкаТоваровРаботУслуг, ТаблицаРасходовУСН, Реквизиты)
	
	Отбор = Новый Структура;
	Отбор.Вставить("КФО", ПриемкаТоваровРаботУслуг.КФО);
	
	Если Реквизиты.ИспользоватьУчетПоИФО Тогда
		Отбор.Вставить("ИФО", ПриемкаТоваровРаботУслуг.ИФО);
	КонецЕсли;
	
	СвойстваСчетаРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ПриемкаТоваровРаботУслуг.СчетРасчетов);
	Если Реквизиты.ИспользоватьУчетПоПодразделениям И СвойстваСчетаРасчетов.УчетПоПодразделениям Тогда
		Отбор.Вставить("Подразделение", ПриемкаТоваровРаботУслуг.Подразделение);
	КонецЕсли;
	Если Реквизиты.ИспользоватьВалютныйУчет И СвойстваСчетаРасчетов.Валютный Тогда
		Отбор.Вставить("Валюта", ПриемкаТоваровРаботУслуг.Валюта);
	КонецЕсли;
	
	Отбор.Вставить("СчетРасчетов", ПриемкаТоваровРаботУслуг.СчетРасчетов);
	Отбор.Вставить("Контрагент",   ПриемкаТоваровРаботУслуг.Контрагент);
	
	Если ЗначениеЗаполнено(ПриемкаТоваровРаботУслуг.Договор)
	   И БухгалтерскийУчетПовтИсп.НаСчетеВедетсяУчетПоДоговорам(ПриемкаТоваровРаботУслуг.СчетРасчетов) Тогда
		Отбор.Вставить("Договор", ПриемкаТоваровРаботУслуг.Договор);
	КонецЕсли;
	
	ОписаниеТипаСуммы      = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	
	ПринятыеРасходыУСН = ТаблицаРасходовУСН.Скопировать(Отбор);
	ПринятыеРасходыУСН.Колонки.Добавить("ПринятоКоличество",              ОписаниеТипаКоличества);
	ПринятыеРасходыУСН.Колонки.Добавить("ПринятоСуммаВал",                ОписаниеТипаСуммы);
	ПринятыеРасходыУСН.Колонки.Добавить("ПринятоСуммаРуб",                ОписаниеТипаСуммы);
	ПринятыеРасходыУСН.Колонки.Добавить("ПринятоСуммаНеУчитываетсяНУРуб", ОписаниеТипаСуммы);
	ПринятыеРасходыУСН.Колонки.Добавить("ПринятоСуммаЕНВДРуб",            ОписаниеТипаСуммы);
	ПринятыеРасходыУСН.Колонки.Добавить("ПринятоСуммаНДСРуб",             ОписаниеТипаСуммы);
	ПринятыеРасходыУСН.Колонки.Добавить("ВсегоРасходовВал",               ОписаниеТипаСуммы);
	ПринятыеРасходыУСН.Колонки.Добавить("ВсегоРасходовРуб",               ОписаниеТипаСуммы);
	Для Каждого СтрокаРасходовУСН Из ПринятыеРасходыУСН Цикл
		
		Если СвойстваСчетаРасчетов.УчетПоКПС Тогда
			СвойстваСчетаУСН = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаРасходовУСН.СчетУчетаУСН);
			Если СвойстваСчетаУСН.УчетПоКПС И (СтрокаРасходовУСН.КПС <> ПриемкаТоваровРаботУслуг.КПС) Тогда
				Продолжить; // Пропускаем расходы по другим КПС.
			КонецЕсли;
		КонецЕсли;
		
		Если СтрокаРасходовУСН.СуммаВал > 0 Тогда
			// Распределять оплату будем только на строки с положительной суммой расходов УСН.
			СтрокаРасходовУСН.ВсегоРасходовВал = СтрокаРасходовУСН.СуммаВал;
			СтрокаРасходовУСН.ВсегоРасходовРуб = СтрокаРасходовУСН.СуммаРуб +
				СтрокаРасходовУСН.СуммаНеУчитываетсяНУРуб + СтрокаРасходовУСН.СуммаЕНВДРуб + СтрокаРасходовУСН.СуммаНДСРуб;
		КонецЕсли;
		
	КонецЦикла;
	
	//Если Реквизиты.Свойство("Курс") И Реквизиты.Свойство("Кратность") Тогда
	//	КурсРасчетов = ?(Реквизиты.Кратность = 0, 1, Реквизиты.Курс / Реквизиты.Кратность);
	//Иначе
	//	КурсРасчетов = 1;
	//КонецЕсли;
	
	ОсталосьПогаситьВал = Мин(ПриемкаТоваровРаботУслуг.СуммаВал, ПринятыеРасходыУСН.Итог("ВсегоРасходовВал"));
	Если ПриемкаТоваровРаботУслуг.Валюта = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета() Тогда
		// Если расчеты в рублях, сумма оплаченных расходов не может превышать сумму расходов,
		// признанных первоначально при поступлении расходов.
		ОсталосьПогаситьРуб = Мин(ПриемкаТоваровРаботУслуг.СуммаРуб, ПринятыеРасходыУСН.Итог("ВсегоРасходовРуб"));
	Иначе
		// Если расчеты в валюте, сумма расходов в рублях может быть как больше, так и меньше суммы расходов,
		// признанных первоначально при поступлении расходов из-за разницы курсов.
		Коэффициент = ?(ПриемкаТоваровРаботУслуг.СуммаВал = 0, 0, ОсталосьПогаситьВал / ПриемкаТоваровРаботУслуг.СуммаВал);
		ОсталосьПогаситьРуб = Коэффициент * ПриемкаТоваровРаботУслуг.СуммаРуб;
	КонецЕсли;
	
	// В таблице ПринятыеРасходыУСН отобраны расходы УСН по нескольким расчетным документам.
	// Выстраиваем их по FIFO и последовательно распределяем сумму принято по каждому расчетному документу.
	ДокументыРасчетов = ПринятыеРасходыУСН.Скопировать(, "ДокументРасчетов,ДатаДокументаРасчетов,ВсегоРасходовВал,ВсегоРасходовРуб");
	ДокументыРасчетов.Свернуть("ДокументРасчетов,ДатаДокументаРасчетов", "ВсегоРасходовВал,ВсегоРасходовРуб");
	ДокументыРасчетов.Сортировать("ДатаДокументаРасчетов");
	
	Для Каждого ДокументРасчетов Из ДокументыРасчетов Цикл
		
		ОтборПоДокументуРасчетов = Новый Структура("ДокументРасчетов", ДокументРасчетов.ДокументРасчетов);
		ПринятыеРасходыПоДокументуРасчетовУСН = ПринятыеРасходыУСН.НайтиСтроки(ОтборПоДокументуРасчетов);
		
		ПогаситьВал = Мин(ОсталосьПогаситьВал, ДокументРасчетов.ВсегоРасходовВал);
		Если ПриемкаТоваровРаботУслуг.Валюта = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета() Тогда
			ПогаситьРуб = Мин(ОсталосьПогаситьРуб, ДокументРасчетов.ВсегоРасходовРуб);
		Иначе
			Коэффициент = ?(ОсталосьПогаситьВал = 0, 0, ПогаситьВал / ОсталосьПогаситьВал);
			ПогаситьРуб = Коэффициент * ОсталосьПогаситьРуб;
		КонецЕсли;
		
		РаспределитьСуммуПринятыхРасходовПоДокументуРасчетовУСН(ПогаситьВал, ПогаситьРуб, ПринятыеРасходыПоДокументуРасчетовУСН);
		
		ОсталосьПогаситьВал = ОсталосьПогаситьВал - ПогаситьВал;
		ОсталосьПогаситьРуб = ОсталосьПогаситьРуб - ПогаситьРуб;
		
	КонецЦикла;
	
	Возврат ПринятыеРасходыУСН;
	
КонецФункции

Процедура РаспределитьСуммуПринятыхРасходовПоДокументуРасчетовУСН(СуммаПринятоВал, СуммаПринятоРуб, ПринятыеРасходыУСН)
	
	Если СуммаПринятоВал < 0 Тогда
		Возврат;
	КонецЕсли;
	
	ОбщегоНазначенияБГУ.РаспределитьСуммуПоСтрокамТаблицы(СуммаПринятоВал,
		ПринятыеРасходыУСН, "ПринятоСуммаВал", "ВсегоРасходовВал");
	
	ОбщегоНазначенияБГУ.РаспределитьСуммуПоСтрокамТаблицы(СуммаПринятоРуб,
		ПринятыеРасходыУСН, "ПринятоСуммаРуб", "ВсегоРасходовВал");
	
	Для Каждого СтрокаРасходовУСН Из ПринятыеРасходыУСН Цикл
		
		Если СтрокаРасходовУСН.СуммаВал = 0
		 ИЛИ СтрокаРасходовУСН.ПринятоСуммаВал = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		// Рассчитаем долю оплаченного количества, сумм в рублях и НДС.
		ДоляРасходовПринято = ?(СтрокаРасходовУСН.ПринятоСуммаВал < СтрокаРасходовУСН.ВсегоРасходовВал,
			СтрокаРасходовУСН.ПринятоСуммаВал / СтрокаРасходовУСН.ВсегоРасходовВал, 1);
			
		СтрокаРасходовУСН.ПринятоКоличество = ДоляРасходовПринято * СтрокаРасходовУСН.Количество;
		
		// Распределим сумму оплаты в рублях по компонентам.
		БазаРаспределения = Новый Массив;
		БазаРаспределения.Добавить(СтрокаРасходовУСН.СуммаРуб);
		БазаРаспределения.Добавить(СтрокаРасходовУСН.СуммаНеУчитываетсяНУРуб);
		БазаРаспределения.Добавить(СтрокаРасходовУСН.СуммаЕНВДРуб);
		БазаРаспределения.Добавить(СтрокаРасходовУСН.СуммаНДСРуб);
		
		РаспределениеСуммыПринятоРуб = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
			СтрокаРасходовУСН.ПринятоСуммаРуб, БазаРаспределения);
		Если РаспределениеСуммыПринятоРуб = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаРасходовУСН.ПринятоСуммаРуб                = РаспределениеСуммыПринятоРуб[0];
		СтрокаРасходовУСН.ПринятоСуммаНеУчитываетсяНУРуб = РаспределениеСуммыПринятоРуб[1];
		СтрокаРасходовУСН.ПринятоСуммаЕНВДРуб            = РаспределениеСуммыПринятоРуб[2];
		СтрокаРасходовУСН.ПринятоСуммаНДСРуб             = РаспределениеСуммыПринятоРуб[3];
		
	КонецЦикла;
	
КонецПроцедуры



// Уплата налогов и сборов УСН

// Подготавливает таблицу расшифровки налогового платежа (для целей УСН).
//
Функция ПодготовитьТаблицуРасшифровкаНалоговогоПлатежаПоДокументу(Документ, Реквизиты = Неопределено, Отказ) Экспорт
	
	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	
	РасшифровкаПлатежа = Новый ТаблицаЗначений;
	// Идентификация строки.
	РасшифровкаПлатежа.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	РасшифровкаПлатежа.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	РасшифровкаПлатежа.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	// Признак поступления денежных средств.
	РасшифровкаПлатежа.Колонки.Добавить("ЭтоПоступление", Новый ОписаниеТипов("Булево"));
	// Общие разрезы учета.
	РасшифровкаПлатежа.Колонки.Добавить("ИФО",            Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	РасшифровкаПлатежа.Колонки.Добавить("КФО",            Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	РасшифровкаПлатежа.Колонки.Добавить("КПС",            Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	РасшифровкаПлатежа.Колонки.Добавить("Подразделение",  Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	// Счет и аналитика учета расчетов по налогам и сборам.
	РасшифровкаПлатежа.Колонки.Добавить("СчетРасчетов",   Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	РасшифровкаПлатежа.Колонки.Добавить("ВидНалога",      Новый ОписаниеТипов("СправочникСсылка.ВидыНалоговИПлатежей"));
	РасшифровкаПлатежа.Колонки.Добавить("Валюта",         Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	// Суммовые показатели операции.
	РасшифровкаПлатежа.Колонки.Добавить("Сумма",          ОписаниеТипаСуммы);
	
	Если Реквизиты = Неопределено Тогда
		Реквизиты = Новый Структура;
	КонецЕсли;
	
	ПериодОстатков = ?(Реквизиты.Свойство("ПериодОстатков"), Реквизиты.ПериодОстатков,
		УчетРасчетов.ПериодПолученияОстатков(Реквизиты, "Дата"));
	
	Если НЕ УчетУСНВызовСервера.ПрименяетсяУСНДоходыМинусРасходы(Документ.Организация, ПериодОстатков) Тогда
		Возврат РасшифровкаПлатежа;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	МетаданныеДокумента = Документ.Метаданные();
	
	Если МетаданныеДокумента.Имя = "ЗаявкаНаКассовыйРасход"
	 ИЛИ МетаданныеДокумента.Имя = "КассовоеВыбытие"
	 ИЛИ МетаданныеДокумента.Имя = "ПлатежноеПоручение" Тогда
		
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "РасшифровкаПлатежа",
			"НомерСтроки,ИФО,КФО,КБКНазначениеПлатежа,КОСГУНазначениеПлатежа,Подразделение,Контрагент,НалогСборПлатеж,Сумма",
			Документ, Реквизиты);
		
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	""РасшифровкаПлатежа"" КАК ИмяСписка,
		|	""Расшифровка платежа"" КАК СинонимСписка,
		|	РасшифровкаПлатежа.НомерСтроки КАК НомерСтроки,
		|	ЛОЖЬ КАК ЭтоПоступление,
		|	РасшифровкаПлатежа.ИФО КАК ИФО,
		|	РасшифровкаПлатежа.КФО КАК КФО,
		|	РасшифровкаПлатежа.КБКНазначениеПлатежа КАК КПС,
		|	РасшифровкаПлатежа.Подразделение КАК Подразделение,
		|	РасшифровкаПлатежа.НалогСборПлатеж.ВидНалогаИлиПлатежа КАК ВидНалога,
		|	РасшифровкаПлатежа.Сумма КАК Сумма
		|ИЗ
		|	ТаблицаРасшифровкаПлатежа КАК РасшифровкаПлатежа
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";     
		
	ИначеЕсли МетаданныеДокумента.Имя = "РСКППеречисление" Тогда   
		
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "ДетализацияПлатежа",
			"НомерСтроки,ИФО,КФО,РазделЛС,КБКНазначениеПлатежа,КОСГУНазначениеПлатежа,Подразделение,Контрагент,НалогСборПлатеж,Сумма",
			Документ, Реквизиты);
		
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	""РасшифровкаПлатежа"" КАК ИмяСписка,
		|	""Расшифровка платежа"" КАК СинонимСписка,
		|	ДетализацияПлатежа.НомерСтроки КАК НомерСтроки,
		|	ЛОЖЬ КАК ЭтоПоступление,
		|	ДетализацияПлатежа.ИФО КАК ИФО, 
		|	ВЫБОР КОГДА ДетализацияПлатежа.КФО = ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка)
		|		ТОГДА
		|";
		ПлатежноРасчетныеДокументы.ТекстЗапросаКФОПоКодуПоступленияЕБП(Запрос.Текст, "ДетализацияПлатежа.РазделЛС.КодПоступленияЕБП", "");
		
	    Запрос.Текст = Запрос.Текст + " 
		|		ИНАЧЕ ДетализацияПлатежа.КФО
		|	КОНЕЦ КАК КФО, 
		|	ДетализацияПлатежа.КБКНазначениеПлатежа КАК КПС,
		|	ДетализацияПлатежа.Подразделение КАК Подразделение,
		|	ДетализацияПлатежа.НалогСборПлатеж.ВидНалогаИлиПлатежа КАК ВидНалога,
		|	ДетализацияПлатежа.Сумма КАК Сумма
		|ИЗ
		|	ТаблицаДетализацияПлатежа КАК ДетализацияПлатежа
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";   
		
	ИначеЕсли МетаданныеДокумента.Имя = "ЗаявкаНаКассовыйРасходСокращенная" Тогда
		
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Документ",
			"ИФО,КФО,КБКНазначениеПлатежа,КОСГУНазначениеПлатежа,Подразделение,Контрагент,НалогСборПлатеж,СуммаДокумента",
			Документ, Реквизиты);
		
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	ЛОЖЬ КАК ЭтоПоступление,
		|	РасшифровкаПлатежа.ИФО КАК ИФО,
		|	РасшифровкаПлатежа.КФО КАК КФО,
		|	РасшифровкаПлатежа.КБКНазначениеПлатежа КАК КПС,
		|	РасшифровкаПлатежа.Подразделение КАК Подразделение,
		|	РасшифровкаПлатежа.НалогСборПлатеж.ВидНалогаИлиПлатежа КАК ВидНалога,
		|	РасшифровкаПлатежа.СуммаДокумента КАК Сумма
		|ИЗ
		|	Документ КАК РасшифровкаПлатежа";
		
	ИначеЕсли МетаданныеДокумента.Имя = "СводнаяЗаявкаНаКассовыйРасход" Тогда
		
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Документ",
			"ИФО,КФО,КБКНазначениеПлатежа,КОСГУНазначениеПлатежа,Подразделение,Контрагент,ВидНалогаИлиПлатежа,СуммаДокумента",
			Документ, Реквизиты);
		
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	ЛОЖЬ КАК ЭтоПоступление,
		|	РасшифровкаПлатежа.ИФО КАК ИФО,
		|	РасшифровкаПлатежа.КФО КАК КФО,
		|	РасшифровкаПлатежа.КБКНазначениеПлатежа КАК КПС,
		|	РасшифровкаПлатежа.Подразделение КАК Подразделение,
		|	РасшифровкаПлатежа.ВидНалогаИлиПлатежа КАК ВидНалога,
		|	РасшифровкаПлатежа.СуммаДокумента КАК Сумма
		|ИЗ
		|	Документ КАК РасшифровкаПлатежа";
		
	ИначеЕсли МетаданныеДокумента.Имя = "КассовоеПоступление" Тогда
		
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "РасшифровкаПлатежа",
			"НомерСтроки,ИФО,КФО,КБКНазначениеПлатежа,КОСГУНазначениеПлатежа,Подразделение,Контрагент,НалогСборПлатеж,Сумма",
			Документ, Реквизиты);
		
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	""РасшифровкаПлатежа"" КАК ИмяСписка,
		|	""Расшифровка платежа"" КАК СинонимСписка,
		|	РасшифровкаПлатежа.НомерСтроки КАК НомерСтроки,
		|	ИСТИНА КАК ЭтоПоступление,
		|	РасшифровкаПлатежа.ИФО КАК ИФО,
		|	РасшифровкаПлатежа.КФО КАК КФО,
		|	РасшифровкаПлатежа.КБКНазначениеПлатежа КАК КПС,
		|	РасшифровкаПлатежа.Подразделение КАК Подразделение,
		|	РасшифровкаПлатежа.НалогСборПлатеж.ВидНалогаИлиПлатежа КАК ВидНалога,
		|	РасшифровкаПлатежа.Сумма КАК Сумма
		|ИЗ
		|	ТаблицаРасшифровкаПлатежа КАК РасшифровкаПлатежа
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки"; 
		
	ИначеЕсли МетаданныеДокумента.Имя = "ПоступлениеНаСчет" Тогда
		
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "ДетализацияПлатежа",
			"НомерСтроки,ИФО,КФО,КБКНазначениеПлатежа,РазделЛС,КОСГУНазначениеПлатежа,Подразделение,Контрагент,НалогСборПлатеж,Сумма",
			Документ, Реквизиты);
		
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	""РасшифровкаПлатежа"" КАК ИмяСписка,
		|	""Расшифровка платежа"" КАК СинонимСписка,
		|	ДетализацияПлатежа.НомерСтроки КАК НомерСтроки,
		|	ИСТИНА КАК ЭтоПоступление,
		|	ДетализацияПлатежа.ИФО КАК ИФО,
		|	ДетализацияПлатежа.КБКНазначениеПлатежа КАК КПС,
		|	ДетализацияПлатежа.Подразделение КАК Подразделение,
		|	ДетализацияПлатежа.НалогСборПлатеж.ВидНалогаИлиПлатежа КАК ВидНалога,
		|	ВЫБОР КОГДА ДетализацияПлатежа.КФО = ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка)
		|		ТОГДА
		|";
		ПлатежноРасчетныеДокументы.ТекстЗапросаКФОПоКодуПоступленияЕБП(Запрос.Текст, "ДетализацияПлатежа.РазделЛС.КодПоступленияЕБП", "");

		Запрос.Текст = Запрос.Текст + "
		|		ИНАЧЕ ДетализацияПлатежа.КФО
		|	КОНЕЦ КАК КФО,
		|	ДетализацияПлатежа.Сумма КАК Сумма
		|ИЗ
		|	ТаблицаДетализацияПлатежа КАК ДетализацияПлатежа
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
		
	ИначеЕсли МетаданныеДокумента.Имя = "РаспределениеЕНП" Тогда   
		
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Налоги",
			"НомерСтроки,ИФО,КФО,КПС,Подразделение,ВидНалогаИлиПлатежа,НалогСборПлатеж,Сумма",
			Документ, Реквизиты);
		
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	""Налоги"" КАК ИмяСписка,
		|	""Принадлежность сумм ЕНП"" КАК СинонимСписка,
		|	Налоги.НомерСтроки КАК НомерСтроки,
		|	ЛОЖЬ КАК ЭтоПоступление,
		|	Налоги.ИФО КАК ИФО,
		|	Налоги.КФО КАК КФО,
		|	Налоги.КПС КАК КПС,
		|	Налоги.Подразделение КАК Подразделение,
		|	Налоги.ВидНалогаИлиПлатежа КАК ВидНалога,
		|	Налоги.Сумма КАК Сумма
		|ИЗ
		|	ТаблицаНалоги КАК Налоги
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";     
		
	КонецЕсли;
	
	ДвижениеДенежныхСредств = Запрос.Выполнить().Выгрузить();
	Для Каждого Строка Из ДвижениеДенежныхСредств Цикл
		
		Если НЕ УчетУСНКлиентСервер.ВедетсяУчетУСНпоКФО(Строка.КФО) Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ УчетУСН.ВедетсяУчетРасчетовПоНалогу(Строка.ВидНалога) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = РасшифровкаПлатежа.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
		НоваяСтрока.СчетРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("УРН");
		
		//00-00014281 - добавляем подразделение из шапки
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.Подразделение) И ОбщегоНазначения.ЕстьРеквизитОбъекта("Подразделение", МетаданныеДокумента) Тогда
			НоваяСтрока.Подразделение = Документ.Подразделение; 
		КонецЕсли;
		
	КонецЦикла;
	
	Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ВалютаДокумента", МетаданныеДокумента) Тогда
		РасшифровкаПлатежа.ЗаполнитьЗначения(Документ.ВалютаДокумента, "Валюта");
	Иначе
		РасшифровкаПлатежа.ЗаполнитьЗначения(БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета(), "Валюта");
	КонецЕсли;
	
	Возврат РасшифровкаПлатежа;
	
КонецФункции

// Структура таблицы прочих расчетов УСН.
//
Функция ПустаяТаблицаРасчетыПоНалогамИСборамУСН() Экспорт

	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Идентификация строки.
	ПустаяТаблица.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	
	// Признак аванса. После погашения задолженности, аванс добавляется в таблицу последней строкой.
	ПустаяТаблица.Колонки.Добавить("ЭтоАванс",      Новый ОписаниеТипов("Булево"));
	
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	
	// Счет и аналитика учета расчетов УСН по налогам и сборам.
	ПустаяТаблица.Колонки.Добавить("СчетРасчетов",     Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("ВидНалога",        Новый ОписаниеТипов("СправочникСсылка.ВидыНалоговИПлатежей"));
	ПустаяТаблица.Колонки.Добавить("ДокументРасчетов", ПланыВидовХарактеристик.ВидыСубконто.ДокументыРасчетов.ТипЗначения);
	ПустаяТаблица.Колонки.Добавить("Валюта",           Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	
	// Суммы расчетов.
	ПустаяТаблица.Колонки.Добавить("ОстатокРасчетов",         ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаРасчетов",           ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаРуб",                ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаНеУчитываетсяНУРуб", ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаЕНВДРуб",            ОписаниеТипаСуммы);
	
	Возврат ПустаяТаблица;

КонецФункции

// Формирует таблицу прочих расчетов УСН по налогам и сборам.
//
Функция ТаблицаРасчетыПоНалогамИСборамУСН(РасшифровкаНалоговогоПлатежа, Реквизиты, Отказ) Экспорт
	
	ТаблицаРасчетов = ПустаяТаблицаРасчетыПоНалогамИСборамУСН();
	
	ПериодОстатков = ?(Реквизиты.Свойство("ПериодОстатков"), Реквизиты.ПериодОстатков,
		УчетРасчетов.ПериодПолученияОстатков(Реквизиты, "Дата"));
	УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Реквизиты.Организация, ПериодОстатков);
	Если НЕ УчетнаяПолитика.ПрименяетсяУСНДоходыМинусРасходы Тогда
		Возврат ТаблицаРасчетов;
	КонецЕсли;
	
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	Реквизиты.Вставить("ПлательщикЕНВД",                   УчетнаяПолитика.ПлательщикЕНВД);
	
	// Получим остаток расчетов УСН по налогам и сборам.
	СчетаРасчетовПоНалогам = БухгалтерскийУчет.СчетПоКоду("УРН", ПериодОстатков, Реквизиты.Организация);
	
	ОтборРасчетов = Новый Структура;
	ОтборРасчетов.Вставить("Субконто1", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
		РасшифровкаНалоговогоПлатежа.ВыгрузитьКолонку("ВидНалога")));
	
	Если Реквизиты.ИспользоватьУчетПоИФО Тогда
		ОтборРасчетов.Вставить("ИФО", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
			РасшифровкаНалоговогоПлатежа.ВыгрузитьКолонку("ИФО")));
	КонецЕсли;
	ОтборРасчетов.Вставить("КФО", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
		РасшифровкаНалоговогоПлатежа.ВыгрузитьКолонку("КФО")));
	
	ПериодОстатков = ?(Реквизиты.Свойство("ПериодОстатков"), Реквизиты.ПериодОстатков,
		УчетРасчетов.ПериодПолученияОстатков(Реквизиты.Ссылка));
	ОстаткиРасчетовУСН = ОстаткиПрочихРасчетовУСН(ПериодОстатков, СчетаРасчетовПоНалогам, ОтборРасчетов, Реквизиты);
	ОбщегоНазначенияБГУ.УпорядочитьТаблицуПоДокументу(ОстаткиРасчетовУСН, "ДокументРасчетов", "ДатаДокументаРасчетов");
	
	// Погасим задолженность, выделим аванс.
	Для Каждого СтрокаПлатежа Из РасшифровкаНалоговогоПлатежа Цикл
		
		НераспределенныйОстаток = СтрокаПлатежа.Сумма;
		
		Если ОстаткиРасчетовУСН.Количество() > 0 Тогда
		
			Отбор = Новый Структура("КФО,Субконто1",
				СтрокаПлатежа.КФО,
				СтрокаПлатежа.ВидНалога);
			
			СвойстваСчетаРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаПлатежа.СчетРасчетов);
			Если Реквизиты.ИспользоватьУчетПоИФО Тогда
				Отбор.Вставить("ИФО", СтрокаПлатежа.ИФО);
			КонецЕсли;
			Если СвойстваСчетаРасчетов.УчетПоКПС Тогда
				Отбор.Вставить("КПС", СтрокаПлатежа.КПС);
			КонецЕсли;
			Если Реквизиты.ИспользоватьУчетПоПодразделениям И СвойстваСчетаРасчетов.УчетПоПодразделениям Тогда
				Отбор.Вставить("Подразделение", СтрокаПлатежа.Подразделение);
			КонецЕсли;
			Если Реквизиты.ИспользоватьВалютныйУчет И СвойстваСчетаРасчетов.Валютный Тогда
				Отбор.Вставить("Валюта", СтрокаПлатежа.Валюта);
			КонецЕсли;
			
			ОстаткиЗадолженности = ОстаткиРасчетовУСН.НайтиСтроки(Отбор);
			
			// Добавим строки задолженности.
			Знак = ?(СтрокаПлатежа.ЭтоПоступление, +1, -1);
			Для Каждого СтрокаОстатка Из ОстаткиЗадолженности Цикл
				
				Если НераспределенныйОстаток <= 0 Тогда
					Прервать;
				КонецЕсли;
				
				ПогашеннаяСумма = Мин(НераспределенныйОстаток, Знак * СтрокаОстатка.СуммаВал);
				Если ПогашеннаяСумма <= 0 Тогда
					Продолжить;
				КонецЕсли;
				
				СтрокаРасчетов = ТаблицаРасчетов.Добавить();
				СтрокаРасчетов.ЭтоАванс = Ложь;
				
				ЗаполнитьЗначенияСвойств(СтрокаРасчетов, СтрокаОстатка,
					"ИФО,КФО,КПС,Подразделение,Валюта,СчетРасчетов,ДокументРасчетов");
				
				ЗаполнитьЗначенияСвойств(СтрокаРасчетов, СтрокаПлатежа,
					"ИмяСписка,СинонимСписка,НомерСтроки,ВидНалога");
				
				СтрокаРасчетов.ОстатокРасчетов = Знак * СтрокаОстатка.СуммаВал;
				СтрокаРасчетов.СуммаРасчетов   = ПогашеннаяСумма;
				
				Если Реквизиты.ИспользоватьВалютныйУчет
				   И СтрокаПлатежа.Валюта <> БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета() Тогда
					КоэффициентРуб = ?(СтрокаОстатка.СуммаВал = 0, 1,
						СтрокаОстатка.СуммаРуб + СтрокаОстатка.СуммаНеУчитываетсяНУРуб + СтрокаОстатка.СуммаЕНВДРуб / СтрокаОстатка.СуммаВал);
					ПогашеннаяСуммаРуб = Окр(ПогашеннаяСумма * КоэффициентРуб, 2);
				Иначе
					ПогашеннаяСуммаРуб = ПогашеннаяСумма;
				КонецЕсли;
				
				// Распределим сумму оплаты по компонентам.
				БазаРаспределения = Новый Массив;
				БазаРаспределения.Добавить(СтрокаОстатка.СуммаРуб);
				БазаРаспределения.Добавить(СтрокаОстатка.СуммаНеУчитываетсяНУРуб);
				БазаРаспределения.Добавить(СтрокаОстатка.СуммаЕНВДРуб);
				
				РаспределениеСуммыОплатыРуб = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
					ПогашеннаяСуммаРуб, БазаРаспределения);
				Если РаспределениеСуммыОплатыРуб = Неопределено Тогда
					СтрокаРасчетов.СуммаРуб = ПогашеннаяСуммаРуб;
				Иначе
					СтрокаРасчетов.СуммаРуб                = РаспределениеСуммыОплатыРуб[0];
					СтрокаРасчетов.СуммаНеУчитываетсяНУРуб = РаспределениеСуммыОплатыРуб[1];
					СтрокаРасчетов.СуммаЕНВДРуб            = РаспределениеСуммыОплатыРуб[2];
				КонецЕсли;
				
				НераспределенныйОстаток = НераспределенныйОстаток - ПогашеннаяСумма;
				
				СтрокаОстатка.СуммаВал                = СтрокаОстатка.СуммаВал                - Знак * СтрокаРасчетов.СуммаРасчетов;
				СтрокаОстатка.СуммаРуб                = СтрокаОстатка.СуммаРуб                - Знак * СтрокаРасчетов.СуммаРуб;
				СтрокаОстатка.СуммаНеУчитываетсяНУРуб = СтрокаОстатка.СуммаНеУчитываетсяНУРуб - Знак * СтрокаРасчетов.СуммаНеУчитываетсяНУРуб;
				СтрокаОстатка.СуммаЕНВДРуб            = СтрокаОстатка.СуммаЕНВДРуб            - Знак * СтрокаРасчетов.СуммаЕНВДРуб;
				
			КонецЦикла;
			
		КонецЕсли;
		
		// Добавим строку аванса.
		Если НераспределенныйОстаток > 0 Тогда
			
			СтрокаРасчетов = ТаблицаРасчетов.Добавить();
			СтрокаРасчетов.ЭтоАванс = Истина;
			
			ЗаполнитьЗначенияСвойств(СтрокаРасчетов, СтрокаПлатежа,
				"ИмяСписка,СинонимСписка,НомерСтроки,ИФО,КФО,КПС,Подразделение,Валюта,СчетРасчетов,ВидНалога,Валюта");
			
			СтрокаРасчетов.ДокументРасчетов = Реквизиты.Ссылка;
			
			СтрокаРасчетов.СуммаРасчетов = НераспределенныйОстаток;
			
			Если Реквизиты.ИспользоватьВалютныйУчет
			   И СтрокаПлатежа.Валюта <> БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета() Тогда
				КоэффициентРуб = ?(Реквизиты.Кратность = 0, Реквизиты.Курс, Реквизиты.Курс / Реквизиты.Кратность);
				СтрокаРасчетов.СуммаРуб = Окр(НераспределенныйОстаток * КоэффициентРуб, 2);
			Иначе
				СтрокаРасчетов.СуммаРуб = НераспределенныйОстаток;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаРасчетов;
	
КонецФункции

Функция ТаблицаУплатаНалоговИСборовУСН(ТаблицаРасчетыПоНалогамИСборамУСН, Реквизиты, Отказ) Экспорт
	
	ТаблицаОплаченныхРасходовУСН = ПустаяТаблицаОплаченныхРасходовУСН();
	
	ПериодОстатков = ?(Реквизиты.Свойство("ПериодОстатков"), Реквизиты.ПериодОстатков,
		УчетРасчетов.ПериодПолученияОстатков(Реквизиты, "Дата"));
	УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Реквизиты.Организация, ПериодОстатков);
	Если НЕ УчетнаяПолитика.ПрименяетсяУСНДоходыМинусРасходы Тогда
		Возврат ТаблицаОплаченныхРасходовУСН;
	КонецЕсли;
	
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	
	// Отберем документы расчетов (партии поступления расходов УСН), оплаченные документом.
	ТаблицаОплат = ТаблицаРасчетыПоНалогамИСборамУСН.СкопироватьКолонки();
	Для Каждого СтрокаРасчетов Из ТаблицаРасчетыПоНалогамИСборамУСН Цикл
		Если НЕ СтрокаРасчетов.ЭтоАванс
		   И УчетУСНКлиентСервер.ВедетсяУчетУСНпоКФО(СтрокаРасчетов.КФО) Тогда
			НоваяОплата = ТаблицаОплат.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяОплата, СтрокаРасчетов);
		КонецЕсли;
	КонецЦикла;
	
	Если ТаблицаОплат.Количество() = 0 Тогда
		Возврат ТаблицаОплаченныхРасходовУСН;
	КонецЕсли;
	
	// Получим остатки неоплаченных расходов УСН на уплату налогов и сборов.
	СчетаРасходовКОплате = БухгалтерскийУчет.СписокСчетов("У68.О");
	
	ОтборРасходов = Новый Структура;
	ОтборРасходов.Вставить("ВидРасхода",   Перечисления.ВидыРасходовУСН.Налоги);
	ОтборРасходов.Вставить("ЭлементРасхода", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
		ТаблицаОплат.ВыгрузитьКолонку("ВидНалога")));
	
	Если Реквизиты.ИспользоватьУчетПоИФО Тогда
		ОтборРасходов.Вставить("ИФО", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
			ТаблицаОплат.ВыгрузитьКолонку("ИФО")));
	КонецЕсли;
	ОтборРасходов.Вставить("КФО", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
		ТаблицаОплат.ВыгрузитьКолонку("КФО")));
	
	ПериодОстатков = ?(Реквизиты.Свойство("ПериодОстатков"), Реквизиты.ПериодОстатков,
		УчетРасчетов.ПериодПолученияОстатков(Реквизиты.Ссылка));
	ОстаткиРасходовУСН = ОстаткиРасходовУСН(ПериодОстатков, СчетаРасходовКОплате, ОтборРасходов, Реквизиты);
	ОбщегоНазначенияБГУ.УпорядочитьТаблицуПоДокументу(ОстаткиРасходовУСН, "ДокументРасчетов", "ДатаДокументаРасчетов");
	
	// Заполним таблицу оплаченных расходов УСН.
	Для Каждого Оплата Из ТаблицаОплат Цикл
		
		Если НЕ УчетУСН.ВедетсяУчетРасчетовПоНалогу(Оплата.ВидНалога) Тогда
			Продолжить;
		КонецЕсли;
		
		СуммаОсталосьПогасить = Оплата.СуммаРасчетов;
		Если СуммаОсталосьПогасить <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Отбор = Новый Структура("КФО,СчетРасчетов,ЭлементРасхода",
			Оплата.КФО,
			Оплата.СчетРасчетов,
			Оплата.ВидНалога);
		
		СвойстваСчетаРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Оплата.СчетРасчетов);
		Если Реквизиты.ИспользоватьУчетПоИФО Тогда
			Отбор.Вставить("ИФО", Оплата.ИФО);
		КонецЕсли;
		Если Реквизиты.ИспользоватьУчетПоПодразделениям И СвойстваСчетаРасчетов.УчетПоПодразделениям Тогда
			Отбор.Вставить("Подразделение", Оплата.Подразделение);
		КонецЕсли;
		Если Реквизиты.ИспользоватьВалютныйУчет И СвойстваСчетаРасчетов.Валютный Тогда
			Отбор.Вставить("Валюта", Оплата.Валюта);
		КонецЕсли;
		
		ОстаткиНеоплаченныхРасходов = ОстаткиРасходовУСН.НайтиСтроки(Отбор);
		Для каждого РасходУСН Из ОстаткиНеоплаченныхРасходов Цикл
			
			Если СуммаОсталосьПогасить <= 0 Тогда
				Прервать;
			КонецЕсли;
			
			Если РасходУСН.СуммаВал <= 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Если СвойстваСчетаРасчетов.УчетПоКПС Тогда
				СвойстваСчетаУСН = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(РасходУСН.СчетУчетаУСН);
				Если СвойстваСчетаУСН.УчетПоКПС И (РасходУСН.КПС <> Оплата.КПС) Тогда
					Продолжить; // Пропускаем расходы по другим КПС.
				КонецЕсли;
			КонецЕсли;
			
			СуммаПогасить = Мин(РасходУСН.СуммаВал, СуммаОсталосьПогасить);
			Коэффициент   = СуммаПогасить / РасходУСН.СуммаВал;
			
			НоваяСтрока = ТаблицаОплаченныхРасходовУСН.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, РасходУСН,
				"ИФО,КФО,КПС,Подразделение,СчетРасчетов,СчетУчетаУСН,Валюта,СчетУчетаУСН,РасходыУСН");
			
			НоваяСтрока.НомерСтроки = ТаблицаОплаченныхРасходовУСН.Количество();
			
			НоваяСтрока.СуммаВал                = Окр(РасходУСН.СуммаВал                * Коэффициент, 2, 1);
			НоваяСтрока.СуммаРуб                = Окр(РасходУСН.СуммаРуб                * Коэффициент, 2, 1);
			НоваяСтрока.СуммаНеУчитываетсяНУРуб = Окр(РасходУСН.СуммаНеУчитываетсяНУРуб * Коэффициент, 2, 1);
			НоваяСтрока.СуммаЕНВДРуб            = Окр(РасходУСН.СуммаЕНВДРуб            * Коэффициент, 2, 1);
			
			Если РасходУСН.ОтражениеВУСН = Перечисления.ОтражениеВУСН.Распределяются Тогда
				НоваяСтрока.КорСчетУСН = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У68.Р");
			Иначе
				НоваяСтрока.КорСчетУСН = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У99");
			КонецЕсли;
			
			СвойстваСчетаУСН = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(РасходУСН.СчетУчетаУСН);
			НоваяСтрока.ВидСубконтоРасходов2 = СвойстваСчетаУСН.ВидСубконто1;
			НоваяСтрока.СубконтоРасходов2    = РасходУСН.СубконтоРасходов2;
			НоваяСтрока.ВидСубконтоРасходов3 = СвойстваСчетаУСН.ВидСубконто3;
			НоваяСтрока.СубконтоРасходов3    = РасходУСН.СубконтоРасходов3;
			
			НоваяСтрока.ДокументОплаты = Реквизиты.Ссылка;
			
			СуммаОсталосьПогасить = СуммаОсталосьПогасить - СуммаПогасить;
			
			РасходУСН.СуммаВал                = РасходУСН.СуммаВал                - НоваяСтрока.СуммаВал;
			РасходУСН.СуммаРуб                = РасходУСН.СуммаРуб                - НоваяСтрока.СуммаРуб;
			РасходУСН.СуммаНеУчитываетсяНУРуб = РасходУСН.СуммаНеУчитываетсяНУРуб - НоваяСтрока.СуммаНеУчитываетсяНУРуб;
			РасходУСН.СуммаЕНВДРуб            = РасходУСН.СуммаЕНВДРуб            - НоваяСтрока.СуммаЕНВДРуб;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТаблицаОплаченныхРасходовУСН;
	
КонецФункции

Функция ТаблицаЗачетОплатыНалоговИСборовУСН(ТаблицаПоступлениеРасходовУСН, ТаблицаНачисленийЗаСчетНалогов, Реквизиты, Отказ) Экспорт
	
	ТаблицаОплаченныхРасходовУСН = ПустаяТаблицаОплаченныхРасходовУСН();
	
	УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Реквизиты.Организация, Реквизиты.Дата);
	Если НЕ УчетнаяПолитика.ПрименяетсяУСНДоходыМинусРасходы Тогда
		Возврат ТаблицаОплаченныхРасходовУСН;
	КонецЕсли;
	
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	Реквизиты.Вставить("ПлательщикЕНВД",                   УчетнаяПолитика.ПлательщикЕНВД);
	
	// Подготовим таблицу расходов к оплате.
	РасходыУСНкОплате = ТаблицаПоступлениеРасходовУСН.Скопировать();
	РасходыКУдалению = Новый Массив;
	Для Каждого РасходУСН Из РасходыУСНкОплате Цикл
		Если РасходУСН.ВидРасхода <> Перечисления.ВидыРасходовУСН.Налоги Тогда
			РасходыКУдалению.Добавить(РасходУСН);
		КонецЕсли;
	КонецЦикла;
	Для Каждого РасходКУдалению Из РасходыКУдалению Цикл
		РасходыУСНкОплате.Удалить(РасходКУдалению);
	КонецЦикла;
	
	Если РасходыУСНкОплате.Количество() = 0 Тогда
		Возврат ТаблицаОплаченныхРасходовУСН;
	КонецЕсли;
	
	// Получим остаток расчетов УСН по налогам и сборам.
	СчетаРасчетовПоНалогам = БухгалтерскийУчет.СчетПоКоду("УРН", Реквизиты.Дата, Реквизиты.Организация);
	
	ОтборРасчетов = Новый Структура;
	ОтборРасчетов.Вставить("Субконто1", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
		РасходыУСНкОплате.ВыгрузитьКолонку("ЭлементРасхода")));
	
	Если Реквизиты.ИспользоватьУчетПоИФО Тогда
		ОтборРасчетов.Вставить("ИФО", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
			РасходыУСНкОплате.ВыгрузитьКолонку("ИФО")));
	КонецЕсли;
	ОтборРасчетов.Вставить("КФО", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
		РасходыУСНкОплате.ВыгрузитьКолонку("КФО")));
	
	ПериодОстатков = ?(Реквизиты.Свойство("ПериодОстатков"), Реквизиты.ПериодОстатков,
		Новый Граница(Реквизиты.Ссылка.МоментВремени(), ВидГраницы.Исключая));
	ОстаткиОплатыНалогов = ОстаткиПрочихРасчетовУСН(ПериодОстатков, СчетаРасчетовПоНалогам, ОтборРасчетов, Реквизиты);
	ОбщегоНазначенияБГУ.УпорядочитьТаблицуПоДокументу(ОстаткиОплатыНалогов, "ДокументРасчетов", "ДатаДокументаРасчетов");
	
	// Сформируем общую таблицу оплат из (1) таблицы начислений за счет налогов
	// и (2) таблицы остатков расчетов УСН по налогам и сборам.
	ТаблицаОплат = ТаблицаНачисленийЗаСчетНалогов.Скопировать();
	Для Каждого Оплата Из ОстаткиОплатыНалогов Цикл
		НоваяСтрока = ТаблицаОплат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Оплата);
		НоваяСтрока.ВидНалога = Оплата.Субконто1;
	КонецЦикла;
	
	// Заполним таблицу оплаченных расходов УСН.
	Для Каждого Оплата Из ТаблицаОплат Цикл
		
		Если НЕ УчетУСН.ВедетсяУчетРасчетовПоНалогу(Оплата.ВидНалога) Тогда
			Продолжить;
		КонецЕсли;
		
		СуммаОсталосьПогасить = Оплата.СуммаВал;
		Если СуммаОсталосьПогасить <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Отбор = Новый Структура("КФО,СчетРасчетов,ЭлементРасхода",
			Оплата.КФО,
			Оплата.СчетРасчетов,
			Оплата.ВидНалога);
		
		СвойстваСчетаРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Оплата.СчетРасчетов);
		Если Реквизиты.ИспользоватьУчетПоИФО Тогда
			Отбор.Вставить("ИФО", Оплата.ИФО);
		КонецЕсли;
		Если Реквизиты.ИспользоватьУчетПоПодразделениям И СвойстваСчетаРасчетов.УчетПоПодразделениям Тогда
			Отбор.Вставить("Подразделение", Оплата.Подразделение);
		КонецЕсли;
		Если Реквизиты.ИспользоватьВалютныйУчет И СвойстваСчетаРасчетов.Валютный Тогда
			Отбор.Вставить("Валюта", Оплата.Валюта);
		КонецЕсли;
		
		ОстаткиНеоплаченныхРасходов = РасходыУСНкОплате.НайтиСтроки(Отбор);
		Для каждого РасходУСН Из ОстаткиНеоплаченныхРасходов Цикл
			
			Если СуммаОсталосьПогасить <= 0 Тогда
				Прервать;
			КонецЕсли;
			
			Если РасходУСН.СуммаВал <= 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Если СвойстваСчетаРасчетов.УчетПоКПС Тогда
				СвойстваСчетаУСН = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(РасходУСН.СчетУчетаУСН);
				Если СвойстваСчетаУСН.УчетПоКПС И (РасходУСН.КПС <> Оплата.КПС) Тогда
					Продолжить; // Пропускаем расходы по другим КПС.
				КонецЕсли;
			КонецЕсли;
			
			СуммаПогасить = Мин(РасходУСН.СуммаВал, СуммаОсталосьПогасить);
			Коэффициент   = СуммаПогасить / РасходУСН.СуммаВал;
			
			НоваяСтрока = ТаблицаОплаченныхРасходовУСН.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, РасходУСН,
				"ИмяСписка,СинонимСписка,НомерСтроки,ИФО,КФО,КПС,Подразделение,СчетРасчетов,СчетУчетаУСН,Валюта,СчетУчетаУСН,РасходыУСН");
			
			НоваяСтрока.СуммаВал                = Окр(РасходУСН.СуммаВал                * Коэффициент, 2, 1);
			НоваяСтрока.СуммаРуб                = Окр(РасходУСН.СуммаРуб                * Коэффициент, 2, 1);
			НоваяСтрока.СуммаНеУчитываетсяНУРуб = Окр(РасходУСН.СуммаНеУчитываетсяНУРуб * Коэффициент, 2, 1);
			НоваяСтрока.СуммаЕНВДРуб            = Окр(РасходУСН.СуммаЕНВДРуб            * Коэффициент, 2, 1);
			
			НоваяСтрока.КорСчетУСН = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У99");
			
			СвойстваСчетаУСН = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(РасходУСН.СчетУчетаУСН);
			НоваяСтрока.ВидСубконтоРасходов2 = СвойстваСчетаУСН.ВидСубконто1;
			НоваяСтрока.СубконтоРасходов2    = РасходУСН.СубконтоРасходов2;
			НоваяСтрока.ВидСубконтоРасходов3 = СвойстваСчетаУСН.ВидСубконто3;
			НоваяСтрока.СубконтоРасходов3    = РасходУСН.СубконтоРасходов3;
			
			НоваяСтрока.ДокументОплаты = Оплата.ДокументРасчетов;
			
			СуммаОсталосьПогасить = СуммаОсталосьПогасить - СуммаПогасить;
			
			РасходУСН.СуммаВал                = РасходУСН.СуммаВал                - НоваяСтрока.СуммаВал;
			РасходУСН.СуммаРуб                = РасходУСН.СуммаРуб                - НоваяСтрока.СуммаРуб;
			РасходУСН.СуммаНеУчитываетсяНУРуб = РасходУСН.СуммаНеУчитываетсяНУРуб - НоваяСтрока.СуммаНеУчитываетсяНУРуб;
			РасходУСН.СуммаЕНВДРуб            = РасходУСН.СуммаЕНВДРуб            - НоваяСтрока.СуммаЕНВДРуб;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТаблицаОплаченныхРасходовУСН;
	
КонецФункции

// Распределение ЕНП

// Подготавливает таблицу распределения ЕНП для целей УСН.
//
Функция ПодготовитьТаблицуРаспределениеЕНППоДокументу(Документ, Реквизиты = Неопределено, Отказ) Экспорт
	
	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	
	РаспределениеЕНП = Новый ТаблицаЗначений;
	// Идентификация строки.
	РаспределениеЕНП.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	РаспределениеЕНП.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	РаспределениеЕНП.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	// Общие разрезы учета.
	РаспределениеЕНП.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	РаспределениеЕНП.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	РаспределениеЕНП.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	РаспределениеЕНП.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	// Счет и аналитика учета расчетов по налогам и сборам.
	РаспределениеЕНП.Колонки.Добавить("СчетРасчетов",  Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	РаспределениеЕНП.Колонки.Добавить("ВидНалога",     Новый ОписаниеТипов("СправочникСсылка.ВидыНалоговИПлатежей"));
	// Суммовые показатели операции.
	РаспределениеЕНП.Колонки.Добавить("Сумма",         ОписаниеТипаСуммы);
	
	Если Реквизиты = Неопределено Тогда
		Реквизиты = Новый Структура;
	КонецЕсли;
	
	Если НЕ УчетУСНВызовСервера.ПрименяетсяУСНДоходыМинусРасходы(Документ.Организация, Документ.Дата) Тогда
		Возврат РаспределениеЕНП;
	КонецЕсли;
	
	Запрос = Новый Запрос;

	ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Налоги",
		"НомерСтроки,ИФО,КФО,КПС,Подразделение,Счет,ВидНалогаИлиПлатежа,НалогСборПлатеж,Сумма",
		Документ, Реквизиты);
	
	Запрос.Текст = Запрос.Текст +
	"ВЫБРАТЬ
	|	""Налоги"" КАК ИмяСписка,
	|	""Принадлежность сумм ЕНП"" КАК СинонимСписка,
	|	Налоги.НомерСтроки КАК НомерСтроки,
	|	Налоги.ИФО КАК ИФО,
	|	Налоги.КФО КАК КФО,
	|	Налоги.КПС КАК КПС,
	|	Налоги.Подразделение КАК Подразделение,
	|	Налоги.Счет КАК СчетРасчетов,
	|	Налоги.ВидНалогаИлиПлатежа КАК ВидНалога,
	|	Налоги.Сумма КАК Сумма
	|ИЗ
	|	ТаблицаНалоги КАК Налоги
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	ТаблицаНалоги = Запрос.Выполнить().Выгрузить();
	Для Каждого Строка Из ТаблицаНалоги Цикл
		
		Если НЕ УчетУСНКлиентСервер.ВедетсяУчетУСНпоКФО(Строка.КФО) Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ Справочники.ВидыНалоговИПлатежей.ОплачиваетсяЧерезЕНП(Строка.ВидНалога, Документ.Организация) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = РаспределениеЕНП.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
	КонецЦикла;
	
	Возврат РаспределениеЕНП;
	
КонецФункции

Функция ТаблицаОплатаНалоговИСборовЧерезЕНПвУСН(ТаблицаРаспределениеЕНП, Реквизиты, Отказ) Экспорт
	
	ТаблицаОплаченныхРасходовУСН = ПустаяТаблицаОплаченныхРасходовУСН();
	
	УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Реквизиты.Организация, Реквизиты.Дата);
	Если НЕ УчетнаяПолитика.ПрименяетсяУСНДоходыМинусРасходы Тогда
		Возврат ТаблицаОплаченныхРасходовУСН;
	КонецЕсли;
	
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	
	// Получим остатки неоплаченных расходов УСН на уплату налогов и сборов.
	СчетаРасходовКОплате = БухгалтерскийУчет.СписокСчетов("У68.О");
	
	ОтборРасходов = Новый Структура;
	ОтборРасходов.Вставить("ВидРасхода",   Перечисления.ВидыРасходовУСН.Налоги);
	ОтборРасходов.Вставить("ЭлементРасхода", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
		ТаблицаРаспределениеЕНП.ВыгрузитьКолонку("ВидНалога")));
	
	Если Реквизиты.ИспользоватьУчетПоИФО Тогда
		ОтборРасходов.Вставить("ИФО", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
			ТаблицаРаспределениеЕНП.ВыгрузитьКолонку("ИФО")));
	КонецЕсли;
	ОтборРасходов.Вставить("КФО", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
		ТаблицаРаспределениеЕНП.ВыгрузитьКолонку("КФО")));
	
	ПериодОстатков = Новый Граница(Реквизиты.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	ОстаткиРасходовУСН = ОстаткиРасходовУСН(ПериодОстатков, СчетаРасходовКОплате, ОтборРасходов, Реквизиты);
	ОбщегоНазначенияБГУ.УпорядочитьТаблицуПоДокументу(ОстаткиРасходовУСН, "ДокументРасчетов", "ДатаДокументаРасчетов");
	
	// Заполним таблицу оплаченных расходов УСН.
	Для Каждого Оплата Из ТаблицаРаспределениеЕНП Цикл
		
		Если НЕ Справочники.ВидыНалоговИПлатежей.ОплачиваетсяЧерезЕНП(Оплата.ВидНалога, Реквизиты.Организация) Тогда
			Продолжить;
		КонецЕсли;
		
		СуммаОсталосьПогасить = Оплата.Сумма;
		Если СуммаОсталосьПогасить <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Отбор = Новый Структура("КФО,СчетРасчетов,ЭлементРасхода",
			Оплата.КФО,
			Оплата.СчетРасчетов,
			Оплата.ВидНалога);
		
		СвойстваСчетаРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Оплата.СчетРасчетов);
		Если Реквизиты.ИспользоватьУчетПоИФО Тогда
			Отбор.Вставить("ИФО", Оплата.ИФО);
		КонецЕсли;
		Если Реквизиты.ИспользоватьУчетПоПодразделениям И СвойстваСчетаРасчетов.УчетПоПодразделениям Тогда
			Отбор.Вставить("Подразделение", Оплата.Подразделение);
		КонецЕсли;
		Если Реквизиты.ИспользоватьВалютныйУчет И СвойстваСчетаРасчетов.Валютный Тогда
			Отбор.Вставить("Валюта", Оплата.Валюта);
		КонецЕсли;
		
		ОстаткиНеоплаченныхРасходов = ОстаткиРасходовУСН.НайтиСтроки(Отбор);
		Для каждого РасходУСН Из ОстаткиНеоплаченныхРасходов Цикл
			
			Если СуммаОсталосьПогасить <= 0 Тогда
				Прервать;
			КонецЕсли;
			
			Если РасходУСН.СуммаВал <= 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Если СвойстваСчетаРасчетов.УчетПоКПС Тогда
				СвойстваСчетаУСН = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(РасходУСН.СчетУчетаУСН);
				Если СвойстваСчетаУСН.УчетПоКПС И (РасходУСН.КПС <> Оплата.КПС) Тогда
					Продолжить; // Пропускаем расходы по другим КПС.
				КонецЕсли;
			КонецЕсли;
			
			СуммаПогасить = Мин(РасходУСН.СуммаВал, СуммаОсталосьПогасить);
			Коэффициент   = СуммаПогасить / РасходУСН.СуммаВал;
			
			НоваяСтрока = ТаблицаОплаченныхРасходовУСН.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, РасходУСН,
				"ИФО,КФО,КПС,Подразделение,СчетРасчетов,СчетУчетаУСН,Валюта,СчетУчетаУСН,РасходыУСН");
			
			НоваяСтрока.НомерСтроки = ТаблицаОплаченныхРасходовУСН.Количество();
			
			НоваяСтрока.СуммаВал                = Окр(РасходУСН.СуммаВал                * Коэффициент, 2, 1);
			НоваяСтрока.СуммаРуб                = Окр(РасходУСН.СуммаРуб                * Коэффициент, 2, 1);
			НоваяСтрока.СуммаНеУчитываетсяНУРуб = Окр(РасходУСН.СуммаНеУчитываетсяНУРуб * Коэффициент, 2, 1);
			НоваяСтрока.СуммаЕНВДРуб            = Окр(РасходУСН.СуммаЕНВДРуб            * Коэффициент, 2, 1);
			
			Если РасходУСН.ОтражениеВУСН = Перечисления.ОтражениеВУСН.Распределяются Тогда
				НоваяСтрока.КорСчетУСН = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У68.Р");
			Иначе
				НоваяСтрока.КорСчетУСН = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У99");
			КонецЕсли;
			
			СвойстваСчетаУСН = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(РасходУСН.СчетУчетаУСН);
			НоваяСтрока.ВидСубконтоРасходов2 = СвойстваСчетаУСН.ВидСубконто1;
			НоваяСтрока.СубконтоРасходов2    = РасходУСН.СубконтоРасходов2;
			НоваяСтрока.ВидСубконтоРасходов3 = СвойстваСчетаУСН.ВидСубконто3;
			НоваяСтрока.СубконтоРасходов3    = РасходУСН.СубконтоРасходов3;
			
			НоваяСтрока.ДокументОплаты = Реквизиты.Ссылка;
			
			СуммаОсталосьПогасить = СуммаОсталосьПогасить - СуммаПогасить;
			
			РасходУСН.СуммаВал                = РасходУСН.СуммаВал                - НоваяСтрока.СуммаВал;
			РасходУСН.СуммаРуб                = РасходУСН.СуммаРуб                - НоваяСтрока.СуммаРуб;
			РасходУСН.СуммаНеУчитываетсяНУРуб = РасходУСН.СуммаНеУчитываетсяНУРуб - НоваяСтрока.СуммаНеУчитываетсяНУРуб;
			РасходУСН.СуммаЕНВДРуб            = РасходУСН.СуммаЕНВДРуб            - НоваяСтрока.СуммаЕНВДРуб;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТаблицаОплаченныхРасходовУСН;
	
КонецФункции

// Списание материальных запасов в УСН

Функция ПустаяТаблицаСписаниеМатериальныхЗапасовУСН() Экспорт

	ОписаниеТипаСуммы       = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества  = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	ОписаниеТипаСубконто    = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	ОписаниеТипаВидСубконто = Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто");
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Идентификация строки.
	ПустаяТаблица.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	
	// Счет и аналитика учета расходов УСН по НЕсписанным партиям материальных запасов (Кт).
	ПустаяТаблица.Колонки.Добавить("СчетУчетаУСН",  Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("РасходыУСН",    Новый ОписаниеТипов("СправочникСсылка.РасходыУСН"));
	ПустаяТаблица.Колонки.Добавить("Партия",
		ПланыВидовХарактеристик.ВидыСубконто.ДокументыРасчетов.ТипЗначения);
	ПустаяТаблица.Колонки.Добавить("ВидСубконтоРасходов2",  ОписаниеТипаВидСубконто);
	ПустаяТаблица.Колонки.Добавить("СубконтоРасходов2",     ОписаниеТипаСубконто);
	ПустаяТаблица.Колонки.Добавить("ВидСубконтоРасходов3",  ОписаниеТипаВидСубконто);
	ПустаяТаблица.Колонки.Добавить("СубконтоРасходов3",     ОписаниеТипаСубконто);
	
	// Аналитика учета расходов УСН по списанным партиям материальных запасов (Дт).
	ПустаяТаблица.Колонки.Добавить("ПодразделениеПолучатель", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	
	// Количество и стоимость списанных материальных запасов.
	ПустаяТаблица.Колонки.Добавить("Количество",              ОписаниеТипаКоличества);
	ПустаяТаблица.Колонки.Добавить("Валюта",                  Новый ОписаниеТипов("СправочникСсылка.Валюты")); // Валюта расчетов.
	ПустаяТаблица.Колонки.Добавить("СуммаВал",                ОписаниеТипаСуммы); // Сумма в валюте расчетов.
	ПустаяТаблица.Колонки.Добавить("СуммаРуб",                ОписаниеТипаСуммы); // Сумма в рублях.
	ПустаяТаблица.Колонки.Добавить("СуммаНеУчитываетсяНУРуб", ОписаниеТипаСуммы); // Сумма в рублях.
	ПустаяТаблица.Колонки.Добавить("СуммаЕНВДРуб",            ОписаниеТипаСуммы); // Сумма в рублях.
	ПустаяТаблица.Колонки.Добавить("СуммаНДСРуб",             ОписаниеТипаСуммы); // Сумма НДС в рублях.
	
	Возврат ПустаяТаблица;

КонецФункции

Функция ТаблицаСписаниеМатериальныхЗапасовУСН(ТаблицыСписания, Реквизиты, Отказ) Экспорт
	
	ТаблицаСписанныхПартийУСН = ПустаяТаблицаСписаниеМатериальныхЗапасовУСН();
	
	УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Реквизиты.Организация, Реквизиты.Дата);
	Если НЕ УчетнаяПолитика.ПрименяетсяУСНДоходыМинусРасходы Тогда
		Возврат ТаблицаСписанныхПартийУСН;
	КонецЕсли;
	
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	Реквизиты.Вставить("ПлательщикЕНВД",                   УчетнаяПолитика.ПлательщикЕНВД);
	
	// Параметры учетной политики в части учета расходов УСН.
	Реквизиты.Вставить("ТоварыПоОплате", УчетнаяПолитика.ПорядокПризнанияРасходовПоТоварам =
		Перечисления.ПорядокПризнанияРасходовПоТоварам.ПоОплатеПоставщику);
	Реквизиты.Вставить("ТоварыПоОтгрузке", УчетнаяПолитика.ПорядокПризнанияРасходовПоТоварам =
		Перечисления.ПорядокПризнанияРасходовПоТоварам.ПоФактуРеализации);
	Реквизиты.Вставить("МатериалыПоОплате", УчетнаяПолитика.ПорядокПризнанияМатериальныхРасходов =
		Перечисления.ПорядокПризнанияМатериальныхРасходов.ПоОплатеПоставщику);
	Реквизиты.Вставить("ДопРасходыПоОплате", УчетнаяПолитика.ПорядокПризнанияДопРасходов =
		Перечисления.ПорядокПризнанияДопРасходов.ПоОплатеПоставщику);
	Реквизиты.Вставить("ТаможенныеПлатежиПоОплате", УчетнаяПолитика.ПорядокПризнанияТаможенныхПлатежей =
		Перечисления.ПорядокПризнанияТаможенныхПлатежей.ПоОплате);
	Реквизиты.Вставить("НДСПоОплате", УчетнаяПолитика.ПорядокПризнанияРасходовПоНДС =
		Перечисления.ПорядокПризнанияРасходовПоНДС.ПоОплатеПоставщику);

	// Отберем партии, списанные документом, для отражения в УСН.
	ТаблицаСписанныхПартий = УправлениеМатериальнымиЗапасами.ПустаяТаблицаСписаниеМатериальныхЗапасов();
	Для Каждого ТаблицаСписанных Из ТаблицыСписания Цикл
		Для Каждого СтрокаСписанных Из ТаблицаСписанных.Значение Цикл
			Если СтрокаСписанных.ВидУчета = "БУ"
			   И УчетУСНКлиентСервер.ВедетсяУчетУСНпоКФО(СтрокаСписанных.КФО)
			   И БухгалтерскийУчетПовтИсп.НаСчетеВедетсяПартионныйУчет(СтрокаСписанных.СчетУчета)
			   И НЕ СтрокаСписанных.СчетУчета = БухгалтерскийУчет.СчетПоКоду("02.33")
			   И ЗначениеЗаполнено(СтрокаСписанных.Партия)
			Тогда
				НоваяПартия = ТаблицаСписанныхПартий.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяПартия, СтрокаСписанных);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	// Получим остатки расходов УСН по несписанным партиям материальных запасов.
	СчетаМатериальныхЗапасовКСписанию = БухгалтерскийУчет.СписокСчетов(
		"У10.С,У10.СО,У10.СП,У41.С,У41.СО,У41.СП");
	
	ОтборРасходов = Новый Структура;
	ОтборРасходов.Вставить("Партия", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
		ТаблицаСписанныхПартий.ВыгрузитьКолонку("Партия")));
	ОтборРасходов.Вставить("ЭлементРасхода", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
		ТаблицаСписанныхПартий.ВыгрузитьКолонку("Номенклатура")));
	
	Если Реквизиты.ИспользоватьУчетПоИФО Тогда
		ОтборРасходов.Вставить("ИФО", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
			ТаблицаСписанныхПартий.ВыгрузитьКолонку("ИФО")));
	КонецЕсли;
	//Если Реквизиты.ИспользоватьУчетПоПодразделениям Тогда
	//	ОтборРасходов.Вставить("Подразделение", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
	//		ТаблицаСписанныхПартий.ВыгрузитьКолонку("Подразделение")));
	//КонецЕсли;
	ОтборРасходов.Вставить("КФО", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
		ТаблицаСписанныхПартий.ВыгрузитьКолонку("КФО")));
	
	ПериодОстатков = ?(Реквизиты.Свойство("ПериодОстатков"), Реквизиты.ПериодОстатков,
		Новый Граница(Реквизиты.Ссылка.МоментВремени(), ВидГраницы.Исключая));
	ОстаткиРасходовУСН = ОстаткиРасходовУСН(ПериодОстатков, СчетаМатериальныхЗапасовКСписанию, ОтборРасходов, Реквизиты);
	ОбщегоНазначенияБГУ.УпорядочитьТаблицуПоДокументу(ОстаткиРасходовУСН, "Партия", "ДатаДокументаПартии");
	
	// Заполним таблицу списанных партий материальных запасов для отражения в УСН.
	Для Каждого СписаннаяПартия Из ТаблицаСписанныхПартий Цикл
		
		КоличествоОсталосьПогасить = СписаннаяПартия.Количество;
		Если КоличествоОсталосьПогасить <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Отбор = Новый Структура("КФО,Партия,ЭлементРасхода",
			СписаннаяПартия.КФО,
			СписаннаяПартия.Партия,
			СписаннаяПартия.Номенклатура);
		
		СвойстваСчетаУчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СписаннаяПартия.СчетУчета);
		Если Реквизиты.ИспользоватьУчетПоИФО Тогда
			Отбор.Вставить("ИФО", СписаннаяПартия.ИФО);
		КонецЕсли;
		//Если СвойстваСчетаРасчетов.УчетПоКПС Тогда
		//	Отбор.Вставить("КПС", Оплата.КПС);
		//КонецЕсли;
		Если Реквизиты.ИспользоватьУчетПоПодразделениям И СвойстваСчетаУчета.УчетПоПодразделениям Тогда
			Отбор.Вставить("Подразделение", СписаннаяПартия.Подразделение);
		КонецЕсли;
		
		ОстаткиРасходовПоСписаннойПартии = ОстаткиРасходовУСН.НайтиСтроки(Отбор);
		Для каждого РасходУСН Из ОстаткиРасходовПоСписаннойПартии Цикл
			
			Если КоличествоОсталосьПогасить <= 0 Тогда
				Прервать;
			КонецЕсли;
			
			Если РасходУСН.Количество <= 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Количество = Мин(РасходУСН.Количество, КоличествоОсталосьПогасить);
			Коэффициент  = Количество / РасходУСН.Количество;
			
			НоваяСтрока = ТаблицаСписанныхПартийУСН.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СписаннаяПартия,
				"ИмяСписка,СинонимСписка,НомерСтроки,ПодразделениеПолучатель");
			ЗаполнитьЗначенияСвойств(НоваяСтрока, РасходУСН,
				"ИФО,КФО,КПС,Подразделение,СчетУчетаУСН,РасходыУСН,Партия,Валюта");
			
			НоваяСтрока.Количество              = Количество;
			НоваяСтрока.СуммаВал                = Окр(РасходУСН.СуммаВал                * Коэффициент, 2, 1);
			НоваяСтрока.СуммаРуб                = Окр(РасходУСН.СуммаРуб                * Коэффициент, 2, 1);
			НоваяСтрока.СуммаНеУчитываетсяНУРуб = Окр(РасходУСН.СуммаНеУчитываетсяНУРуб * Коэффициент, 2, 1);
			НоваяСтрока.СуммаЕНВДРуб            = Окр(РасходУСН.СуммаЕНВДРуб            * Коэффициент, 2, 1);
			НоваяСтрока.СуммаНДСРуб             = Окр(РасходУСН.СуммаНДСРуб             * Коэффициент, 2, 1);
			
			СвойстваСчетаУчетаУСН = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(РасходУСН.СчетУчетаУСН);
			НоваяСтрока.ВидСубконтоРасходов2 = СвойстваСчетаУчетаУСН.ВидСубконто1;
			НоваяСтрока.СубконтоРасходов2    = РасходУСН.СубконтоРасходов2;
			НоваяСтрока.ВидСубконтоРасходов3 = СвойстваСчетаУчетаУСН.ВидСубконто3;
			НоваяСтрока.СубконтоРасходов3    = РасходУСН.СубконтоРасходов3;
			
			КоличествоОсталосьПогасить = КоличествоОсталосьПогасить - Количество;
			
			РасходУСН.Количество              = РасходУСН.Количество              - НоваяСтрока.Количество;
			РасходУСН.СуммаВал                = РасходУСН.СуммаВал                - НоваяСтрока.СуммаВал;
			РасходУСН.СуммаРуб                = РасходУСН.СуммаРуб                - НоваяСтрока.СуммаРуб;
			РасходУСН.СуммаНеУчитываетсяНУРуб = РасходУСН.СуммаНеУчитываетсяНУРуб - НоваяСтрока.СуммаНеУчитываетсяНУРуб;
			РасходУСН.СуммаЕНВДРуб            = РасходУСН.СуммаЕНВДРуб            - НоваяСтрока.СуммаЕНВДРуб;
			РасходУСН.СуммаНДСРуб             = РасходУСН.СуммаНДСРуб             - НоваяСтрока.СуммаНДСРуб;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТаблицаСписанныхПартийУСН;
	
КонецФункции

Функция СчетУСНСписанныхМатериальныхЗапасов(СчетУчетаМатериальныхЗапасовУСН, ОтражениеВУСН) Экспорт
	
	КодСчетаУчетаУСН = Строка(СчетУчетаМатериальныхЗапасовУСН);
	
	Если ОтражениеВУСН = Перечисления.ОтражениеВУСН.Распределяются Тогда
		
		Если Найти(КодСчетаУчетаУСН, "У10") Тогда // Материалы.
			
			Если Найти(КодСчетаУчетаУСН, "У10.СО") Тогда
				Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У10.ОР"); // Оплатить, распределить.
			Иначе
				Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У10.Р"); // Распределить.
			КонецЕсли;
			
		ИначеЕсли Найти(КодСчетаУчетаУСН, "У41") Тогда // Товары.
			
			Если Найти(КодСчетаУчетаУСН, "У41.СО") Тогда
				Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У41.ОР"); // Оплатить, распределить.
			Иначе
				Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У41.Р"); // Распределить.
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		
		// Материалы: не Списаны, не Оплачены.
		Если Найти(КодСчетаУчетаУСН, "У10.СО") Тогда
			Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У10.О"); // Оплатить.
			
		// Товары: не Списаны, не Оплачены.
		ИначеЕсли Найти(КодСчетаУчетаУСН, "У41.СО") Тогда
			Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У41.О"); // Оплатить.
			
		// Материалы, товары: не Списаны.
		ИначеЕсли Найти(КодСчетаУчетаУСН, "У10.С")
		      ИЛИ Найти(КодСчетаУчетаУСН, "У41.С") Тогда
			Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У99"); // Включаем расходы в КУДиР.
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции

// Списание доп. расходов, включаемых в себестоимость

Функция ПустаяТаблицаСписаниеДопРасходовУСН() Экспорт

	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",                   Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",                   Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",                   Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("Подразделение",         Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	
	// Счет и аналитика учета доп. расходов.
	ПустаяТаблица.Колонки.Добавить("СчетУчетаУСН",          Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("РасходыУСН",            Новый ОписаниеТипов("СправочникСсылка.РасходыУСН"));
	ПустаяТаблица.Колонки.Добавить("Номенклатура",          Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ПустаяТаблица.Колонки.Добавить("Партия",
		ПланыВидовХарактеристик.ВидыСубконто.Партии.ТипЗначения);
	ПустаяТаблица.Колонки.Добавить("ДокументОплаты",
		ПланыВидовХарактеристик.ВидыСубконто.ДокументыОплатыУСН.ТипЗначения);
	
	// Суммы доп. расходов к списанию.
	ПустаяТаблица.Колонки.Добавить("Валюта",                  Новый ОписаниеТипов("СправочникСсылка.Валюты")); // Валюта расчетов.
	ПустаяТаблица.Колонки.Добавить("СуммаВал",                ОписаниеТипаСуммы); // Сумма в валюте расчетов.
	ПустаяТаблица.Колонки.Добавить("СуммаРуб",                ОписаниеТипаСуммы); // Сумма без НДС в рублях.
	ПустаяТаблица.Колонки.Добавить("СуммаНеУчитываетсяНУРуб", ОписаниеТипаСуммы); // Сумма с НДС в рублях.
	ПустаяТаблица.Колонки.Добавить("СуммаЕНВДРуб",            ОписаниеТипаСуммы); // Сумма с НДС в рублях.
	ПустаяТаблица.Колонки.Добавить("СуммаНДСРуб",             ОписаниеТипаСуммы); // Сумма НДС в рублях.
	
	// Порядок отражения в налоговом учете при УСН.
	ПустаяТаблица.Колонки.Добавить("ОтражениеВУСН", Новый ОписаниеТипов("ПеречислениеСсылка.ОтражениеВУСН"));
	
	Возврат ПустаяТаблица;

КонецФункции

Функция ТаблицаСписаниеДопРасходовУСН(Реквизиты) Экспорт
	
	ТаблицаСписаниеДопРасходов = ПустаяТаблицаСписаниеДопРасходовУСН();
	
	УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Реквизиты.Организация, Реквизиты.Дата);
	Если НЕ УчетнаяПолитика.ПрименяетсяУСНДоходыМинусРасходы Тогда
		Возврат ТаблицаСписаниеДопРасходов;
	КонецЕсли;
	
