		КонецЕсли;
		
		Если Оплата.ВидНалога = Справочники.ВидыНалоговИПлатежей.НДФЛ Тогда
			ОписаниеОперации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = '%1: перечисление НДФЛ работников'"),
				ОписаниеДвиженияДенежныхСредств);
		Иначе
			ОписаниеОперации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = '%1: перечисление налога (%2)'"),
				ОписаниеДвиженияДенежныхСредств,
				Оплата.ВидНалога);
		КонецЕсли;
		
	ИначеЕсли Оплата.ВидОперацииУСН = Перечисления.ВидыОперацийУСН.ВыплатаЗаработнойПлаты
		ИЛИ Оплата.ВидОперацииУСН = Перечисления.ВидыОперацийУСН.ПеречислениеЗаработнойПлаты Тогда
		
		Если БухгалтерскийУчет.СчетВИерархии(Оплата.СчетБУ, "201.30") Тогда
			ОписаниеДвиженияДенежныхСредств = НСтр("ru = 'Выдача из кассы'");
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Оплата.СчетБУ, "201.20") Тогда
			ОписаниеДвиженияДенежныхСредств = НСтр("ru = 'Списание с р/с'");
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Оплата.СчетБУ, "201.10") Тогда
			ОписаниеДвиженияДенежныхСредств = НСтр("ru = 'Списание с л/с'");
		Иначе
			ОписаниеДвиженияДенежныхСредств = НСтр("ru = 'Списание денежных средств'");
		КонецЕсли;
		
		ОписаниеОперации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = '%1: выплата заработной платы ""%2""'"),
			ОписаниеДвиженияДенежныхСредств,
			Оплата.Контрагент);
		
	ИначеЕсли Оплата.ВидОперацииУСН = Перечисления.ВидыОперацийУСН.ПеречислениеУдержанийИзЗаработнойПлаты Тогда
		
		Если БухгалтерскийУчет.СчетВИерархии(Оплата.СчетБУ, "201.30") Тогда
			ОписаниеДвиженияДенежныхСредств = НСтр("ru = 'Выдача из кассы'");
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Оплата.СчетБУ, "201.20") Тогда
			ОписаниеДвиженияДенежныхСредств = НСтр("ru = 'Списание с р/с'");
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Оплата.СчетБУ, "201.10") Тогда
			ОписаниеДвиженияДенежныхСредств = НСтр("ru = 'Списание с л/с'");
		Иначе
			ОписаниеДвиженияДенежныхСредств = НСтр("ru = 'Списание денежных средств'");
		КонецЕсли;
		
		ОписаниеОперации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = '%1: перечисление удержаний из заработной платы ""%2""'"),
			ОписаниеДвиженияДенежныхСредств,
			Оплата.Контрагент);
		
	КонецЕсли;
	
	Возврат ОписаниеОперации;
	
КонецФункции

Функция ОписаниеОперацииДляКУДиР(Операция, ДокументСсылка)
	
	ОписаниеОперации = "";
	
	МетаданныеДокумента = ДокументСсылка.Метаданные();
	Если МетаданныеДокумента.Имя = "АктОбОказанииУслуг" Тогда
		
		ОписаниеОперации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Оказание услуг контрагенту ""%1"" по договору ""%2""'"),
			Операция.Контрагент,
			Операция.Договор);
		
	ИначеЕсли МетаданныеДокумента.Имя = "НачислениеДоходов"
		ИЛИ МетаданныеДокумента.Имя = "НачислениеЗаУслугиОбразования"
		ИЛИ МетаданныеДокумента.Имя = "НачислениеСтудентамЗаПрочиеУслуги"
		ИЛИ МетаданныеДокумента.Имя = "СписаниеДоходовБудущихПериодов" Тогда
		
		ОписаниеОперации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Оказание услуг контрагенту ""%1"" по договору ""%2""'"),
			Операция.Контрагент,
			Операция.Договор);
		
	ИначеЕсли МетаданныеДокумента.Имя = "НакладнаяНаОтпускМ15" Тогда
		
		Если ДокументСсылка.ВидПередачиМЗ = Перечисления.ВидыПередачиМЗ.ПередачаНаСторону Тогда
			
			ОписаниеОперации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Передача материальных запасов контрагенту ""%1"" по договору ""%2""'"),
				Операция.Контрагент,
				Операция.Договор);
			
		ИначеЕсли ДокументСсылка.ВидПередачиМЗ = Перечисления.ВидыПередачиМЗ.ВозвратПоставщику Тогда
			
			ОписаниеОперации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Возврат материальных запасов поставщику ""%1"" по договору ""%2""'"),
				Операция.Контрагент,
				Операция.Договор);
			
		КонецЕсли;
		
	ИначеЕсли МетаданныеДокумента.Имя = "НакладнаяНаРеализациюТорг12" Тогда
		
		ОписаниеОперации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Реализация материальных запасов покупателю ""%1"" по договору ""%2""'"),
			Операция.Контрагент,
			Операция.Договор);
		
	ИначеЕсли МетаданныеДокумента.Имя = "КассовоеПоступление"
		ИЛИ МетаданныеДокумента.Имя = "ПриходныйКассовыйОрдер"
		ИЛИ МетаданныеДокумента.Имя = "ЭквайринговаяОперация" Тогда
		
		Если ЗначениеЗаполнено(Операция.Договор) Тогда
			
			ОписаниеОперации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Поступление денежных средств от контрагента ""%1"" по договору ""%2""'"),
				Операция.Контрагент,
				Операция.Договор);
			
		Иначе
			
			ОписаниеОперации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Поступление денежных средств от контрагента ""%1""'"),
				Операция.Контрагент);
			
		КонецЕсли;
		
	ИначеЕсли МетаданныеДокумента.Имя = "ОтражениеЗарплатыВУчете" Тогда
		
		ОписаниеОперации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Начисление заработной платы и налогов с ФОТ за %1'"),
			Формат(Операция.Период, "ДФ=""ММММ гггг"""));
		
	ИначеЕсли МетаданныеДокумента.Имя = "ПередачаОбъектаОС"
		ИЛИ МетаданныеДокумента.Имя = "ПередачаГруппОбъектовОС"
		ИЛИ МетаданныеДокумента.Имя = "ПередачаЗдания" Тогда
		
		ОписаниеОперации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Реализация объектов ОС, НМА контрагенту ""%1"" по договору ""%2""'"),
			Операция.Контрагент,
			Операция.Договор);
		
	ИначеЕсли МетаданныеДокумента.Имя = "ПоступлениеМЗ" Тогда
		
		Если ДокументСсылка.ВидПоступленияМЗ = Перечисления.ВидыПоступленийМЗ.ПоступлениеОтПоставщика Тогда
			
			ОписаниеОперации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Поступление материальных запасов от поставщика ""%1"" по договору ""%2""'"),
				Операция.Контрагент,
				Операция.Договор);
			
		ИначеЕсли ДокументСсылка.ВидПоступленияМЗ = Перечисления.ВидыПоступленийМЗ.ВозвратОтПокупателя Тогда
			
			ОписаниеОперации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Возврат материальных запасов от покупателя ""%1"" по договору ""%2""'"),
				Операция.Контрагент,
				Операция.Договор);
			
		ИначеЕсли ДокументСсылка.ВидПоступленияМЗ = Перечисления.ВидыПоступленийМЗ.Поступление Тогда
			
			ОтКонтрагента = ?(ЗначениеЗаполнено(ДокументСсылка.Контрагент),
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = ' от контрагента ""%1""'"), ДокументСсылка.Контрагент), "");
			ПоДоговору = ?(ЗначениеЗаполнено(ДокументСсылка.Договор),
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = ' по договору ""%1""'"), ДокументСсылка.Договор), "");
			ОписаниеОперации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Прочее поступление материальных запасов%1%2'"),
				ОтКонтрагента,
				ПоДоговору);
			
		КонецЕсли;
		
	ИначеЕсли МетаданныеДокумента.Имя = "ПоступлениеУслугРабот" Тогда
		
		ОписаниеОперации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Контрагентом ""%1"" оказаны услуги по договору ""%2""'"),
			Операция.Контрагент,
			Операция.Договор);
		
	ИначеЕсли МетаданныеДокумента.Имя = "АвансовыйОтчет" Тогда
		
		ОписаниеОперации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Представлен авансовый отчет: %1'"),
			ДокументСсылка.Сотрудник);
		Если ЗначениеЗаполнено(ДокументСсылка.НазначениеАванса) Тогда
			ОписаниеОперации = ОписаниеОперации + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = ', назначение аванса  ""%1""'"),
				ДокументСсылка.НазначениеАванса);
		КонецЕсли;
		
	ИначеЕсли МетаданныеДокумента.Имя = "ОтчетОРасходахПодотчетногоЛица" Тогда
		
		ОписаниеОперации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Представлен отчет о расходах подотчетного лица: %1'"),
			ДокументСсылка.Сотрудник);
		Если ЗначениеЗаполнено(ДокументСсылка.НазначениеАванса) Тогда
			ОписаниеОперации = ОписаниеОперации + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = ', назначение аванса  ""%1""'"),
				ДокументСсылка.НазначениеАванса);
		КонецЕсли;
		
	ИначеЕсли МетаданныеДокумента.Имя = "ТребованиеНакладная0315006" Тогда
		
		ОписаниеОперации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Требование накладная на списание материалов, МОЛ/Место хранения: %1'"),
				ДокументСсылка.ЦМООтправитель);
		
	ИначеЕсли МетаданныеДокумента.Имя = "СписаниеДопРасходовУСН" Тогда
		
		ОписаниеОперации = НСтр("ru = 'Регламентная операция'");
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ОписаниеОперации) Тогда
		ОписаниеОперации = МетаданныеДокумента.Синоним;
	КонецЕсли;
	
	Возврат ОписаниеОперации;
	
КонецФункции

Процедура СкорректироватьПроводкиОтраженияДоходовРасходов(ТаблицаПроводок, ДокументОбъект, ДополнительныеРеквизиты) Экспорт
	
	ВидыДеятельностиНУ = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат;
	ВидыСубконто       = ПланыВидовХарактеристик.ВидыСубконто;
	
	КоличествоПроводок = ТаблицаПроводок.Количество();
	Для НомерПроводки = 1 По КоличествоПроводок Цикл
		
		ИндексПроводки = КоличествоПроводок - НомерПроводки;
		Проводка = ТаблицаПроводок[ИндексПроводки];
		
		СвойстваСчетаДт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Проводка.СчетДт);
		СвойстваСчетаКт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Проводка.СчетКт);
		
		Проводка.Сумма                = ?(Проводка.Сумма = NULL,                0, Проводка.Сумма);
		Проводка.СуммаНеУчитываетсяНУ = ?(Проводка.СуммаНеУчитываетсяНУ = NULL, 0, Проводка.СуммаНеУчитываетсяНУ);
		Проводка.СуммаЕНВД            = ?(Проводка.СуммаЕНВД = NULL,            0, Проводка.СуммаЕНВД);
		Проводка.СуммаНДС             = ?(Проводка.СуммаНДС = NULL,             0, Проводка.СуммаНДС);
		
		// ДОХОДЫ
		ИспользуетсяСчетАП = (Проводка.Период >= УчетРасчетов.ДатаПереходаНаЗабалансовыйСчетАП(Проводка.Организация));
		Если ИспользуетсяСчетАП Тогда
			ЭтоЗачетАвансаПолученного = БухгалтерскийУчет.СчетВИерархии(Проводка.СчетДт, "АП")
				И (Проводка.ХарактеристикаДвиженияДт <> Перечисления.СобытияНДС.ВозвратАвансаПолученного);
		Иначе
			ЭтоЗачетАвансаПолученного =
				(УчетРасчетов.ВедетсяУчетАвансовПолученных(Проводка.СчетДт)
				И УчетРасчетов.ВедетсяУчетАвансовПолученных(Проводка.СчетКт));
		КонецЕсли;
		
		Если ЭтоЗачетАвансаПолученного И УчетУСНКлиентСервер.ВедетсяУчетРасчетовПоЕНВД(Проводка.Организация, Проводка.Период, Проводка.КФО) Тогда
			
			КоличествоДобавленныхПроводок = 1;
			
			ПорядокНалогообложения = Проводка["ХарактеристикаДвижения" + ?(ИспользуетсяСчетАП, "Дт", "Кт")];
			ЭтоОсобыйПорядокНалогообложения = (ПорядокНалогообложения = ВидыДеятельностиНУ.ОсобыйПорядокНалогообложения);
			Если ЭтоОсобыйПорядокНалогообложения И (Проводка.Сумма - Проводка.СуммаЕНВД > 0) Тогда
				
				Если НЕ ИспользуетсяСчетАП Тогда // После перехода на 64н эти проводки формируются типовой операцией "Зачет аванса полученного (УСН + ЕНВД)".
					
					// Скорректируем показатель СуммаЕНВД на счете 205.ХХ, если зачли авансы, отнесенные к деятельности на УСН.
					НоваяПроводка = ТаблицаПроводок.Вставить(ИндексПроводки + КоличествоДобавленныхПроводок);
					ЗаполнитьЗначенияСвойств(НоваяПроводка, Проводка, ,
						"СчетДт,СубконтоДт1,СубконтоДт2,СубконтоДт3,КПСДт,КЭКДт,ПодразделениеДт,
						|ВалютаДт,ВалютнаяСуммаДт,КоличествоДт,ВалютнаяСуммаКт,КоличествоКт,
						|Сумма,СуммаНеУчитываетсяНУ,СуммаЕНВД,СуммаНДС"); // без корреспонденции
					
					НоваяПроводка.Содержание = НСтр("ru = 'Аванс отнесен к деятельности на ЕНВД.'");
					НоваяПроводка.СчетДт     = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("000");
					НоваяПроводка.ВидСубконтоДт1 = ВидыСубконто.ПустаяСсылка();
					НоваяПроводка.ВидСубконтоДт2 = ВидыСубконто.ПустаяСсылка();
					НоваяПроводка.ВидСубконтоДт3 = ВидыСубконто.ПустаяСсылка();
					
					НоваяПроводка.СуммаЕНВД = Проводка.Сумма - Проводка.СуммаЕНВД;
					
					КоличествоДобавленныхПроводок = КоличествоДобавленныхПроводок + 1;
					
				КонецЕсли;
				
				// Скорректируем доходы на счете У99 "Доходы и расходы".
				НоваяПроводка = ТаблицаПроводок.Вставить(ИндексПроводки + КоличествоДобавленныхПроводок);
				ЗаполнитьЗначенияСвойств(НоваяПроводка, Проводка,
					"Активность,Период,Организация,ИФО,КФО,
					|ВидПервичногоДокумента,ДатаПервичногоДокумента,НомерПервичногоДокумента"); // без корреспонденции
				НоваяПроводка.ВидСубконтоДт1 = ВидыСубконто.ПустаяСсылка();
				НоваяПроводка.ВидСубконтоДт2 = ВидыСубконто.ПустаяСсылка();
				НоваяПроводка.ВидСубконтоДт3 = ВидыСубконто.ПустаяСсылка();
				НоваяПроводка.ВидСубконтоКт1 = ВидыСубконто.ПустаяСсылка();
				НоваяПроводка.ВидСубконтоКт2 = ВидыСубконто.ПустаяСсылка();
				НоваяПроводка.ВидСубконтоКт3 = ВидыСубконто.ПустаяСсылка();
				
				НоваяПроводка.Содержание = НСтр("ru = 'Аванс отнесен к деятельности на ЕНВД.'");
				НоваяПроводка.СчетДт = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("УРК");
				БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Дт", "Контрагенты", Проводка.СубконтоДт1);
				БухгалтерскийУчет.УстановитьСубконто(НоваяПроводка, "Дт", "Договоры",    Проводка.СубконтоДт2);
