												+ ПризнанныйДоход.ДоходыЕНВД;
				Если ПризнанныйДоход.ВидОперацииУСН = "НДСИсключенИзДоходовУСН" Тогда
					ПризнанныйДоход.БазаРаспределения = 0;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если НЕ УчетУСНВызовСервера.ПрименяетсяУСНДоходыМинусРасходы(Проводка.Организация, Проводка.Период) Тогда
			Продолжить;
		КонецЕсли;
		
		// Расходы УСН.
		Если БухгалтерскийУчет.СчетВИерархии(Проводка.СчетДт, "У99,У10.СП,У41.СП")
		И НЕ БухгалтерскийУчет.СчетВИерархии(Проводка.СчетКт, "У99,У10.СП,У41.СП") Тогда
			
			Если Сумма <> 0
			 ИЛИ СуммаНеУчитываетсяНУ <> 0
			 ИЛИ СуммаЕНВД <> 0
			 ИЛИ СуммаНДС <> 0 Тогда
			
				Если БухгалтерскийУчет.СчетВИерархии(Проводка.СчетКт, "У10.С,У41.С") Тогда // расходы УСН уже оплачены
				
					ДокументОплаты = Проводка.СубконтоКт.ДокументыОплатыУСН;
					Если ЗначениеЗаполнено(ДокументОплаты) Тогда
						УчетнаяПолитикаНаМоментОплаты = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(
							ДокументОплаты.Организация, ДокументОплаты.Дата);
					Иначе // Если учет на счете расчетов ведется без расчетных документов, и расчеты оплачены авансом,
						// нет возможности определить учетную политику на дату оплаты.
						УчетнаяПолитикаНаМоментОплаты = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(
							Проводка.Организация, Проводка.Период); // Определяем на текущую дату и считаем, что изменений не было.
					КонецЕсли;
					
					НДСПоОплате = (УчетнаяПолитикаНаМоментОплаты.ПорядокПризнанияРасходовПоНДС =
						Перечисления.ПорядокПризнанияРасходовПоНДС.ПоОплатеПоставщику);
					Если НДСПоОплате Тогда
						ПризнанныйРасход = ДобавитьПризнанныйРасход(ПризнанныеРасходы, Проводка,
							Сумма, СуммаНеУчитываетсяНУ, СуммаЕНВД, 0);
					Иначе
						ПризнанныйРасход = ДобавитьПризнанныйРасход(ПризнанныеРасходы, Проводка,
							Сумма, СуммаНеУчитываетсяНУ, СуммаЕНВД, СуммаНДС);
					КонецЕсли;
					
				Иначе
					ПризнанныйРасход = ДобавитьПризнанныйРасход(ПризнанныеРасходы, Проводка,
						Сумма, СуммаНеУчитываетсяНУ, СуммаЕНВД, СуммаНДС);
				КонецЕсли;
				
				ПризнанныйРасход.ДокументОплаты = Проводка.СубконтоДт.ДокументыОплатыУСН;
				
			КонецЕсли;
			
		// Включение в расходы НДС по факту его оплаты поставщику.
		ИначеЕсли СуммаНДС > 0
			И УчетнаяПолитика.ПорядокПризнанияРасходовПоНДС = Перечисления.ПорядокПризнанияРасходовПоНДС.ПоОплатеПоставщику
			И НЕ БухгалтерскийУчет.СчетВИерархии(Проводка.СчетДт, "У10.СО,У10.О,У15.СО,У15.О,У20.О,У41.СО,У41.О")
			И    БухгалтерскийУчет.СчетВИерархии(Проводка.СчетКт, "У10.СО,У10.О,У15.СО,У15.О,У20.О,У41.СО,У41.О") Тогда
		
			ПризнанныйРасход = ДобавитьПризнанныйРасход(ПризнанныеРасходы, Проводка,
