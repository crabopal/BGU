			ОписаниеДвиженияДенежныхСредств = НСтр("ru = 'Списание с л/с'");
		Иначе
			ОписаниеДвиженияДенежныхСредств = НСтр("ru = 'Списание денежных средств'");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Оплата.Договор) Тогда
			ОписаниеОперации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = '%1: возврат оплаты покупателю (дебитору) ""%2"" по договору ""%3""'"),
				ОписаниеДвиженияДенежныхСредств,
				Оплата.Контрагент,
				Оплата.Договор);
