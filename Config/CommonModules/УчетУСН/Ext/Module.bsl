			ДокументОплаты = Проводка.СубконтоКт.ДокументыОплатыУСН;
			Если ЗначениеЗаполнено(ДокументОплаты) Тогда
				УчетнаяПолитикаНаМоментОплаты = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(
					ДокументОплаты.Организация, ДокументОплаты.Дата);
			Иначе // Если учет на счете расчетов ведется без расчетных документов, и расчеты оплачены авансом,
				// нет возможности определить учетную политику на дату оплаты.
				УчетнаяПолитикаНаМоментОплаты = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(
					Проводка.Организация, Проводка.Период); // Определяем на текущую дату и считаем, что изменений не было.
			КонецЕсли;
			
			ТоварыПоОплате    = (УчетнаяПолитикаНаМоментОплаты.ПорядокПризнанияРасходовПоТоварам =
				Перечисления.ПорядокПризнанияРасходовПоТоварам.ПоОплатеПоставщику);
			МатериалыПоОплате = (УчетнаяПолитикаНаМоментОплаты.ПорядокПризнанияМатериальныхРасходов =
				Перечисления.ПорядокПризнанияМатериальныхРасходов.ПоОплатеПоставщику);
			НДСПоОплате       = (УчетнаяПолитикаНаМоментОплаты.ПорядокПризнанияРасходовПоНДС =
				Перечисления.ПорядокПризнанияРасходовПоНДС.ПоОплатеПоставщику);
			
			Если (ТоварыПоОплате    И БухгалтерскийУчет.СчетВИерархии(Проводка.СчетКт, "У41.СП"))
			 ИЛИ (МатериалыПоОплате И БухгалтерскийУчет.СчетВИерархии(Проводка.СчетКт, "У10.СП")) Тогда
				КорректировкаСуммы    = Сумма;
				КорректировкаСуммыНДС = СуммаНДС;
			Иначе
				КорректировкаСуммы    = 0;
				КорректировкаСуммыНДС = ?(НДСПоОплате, СуммаНДС, 0);
			КонецЕсли;
			
			Если КорректировкаСуммы > 0
			 ИЛИ КорректировкаСуммыНДС > 0 Тогда
			
				ПризнанныйРасход = ДобавитьПризнанныйРасход(ПризнанныеРасходы, Проводка,
					- КорректировкаСуммы, 0, 0, - КорректировкаСуммыНДС);
				
				ПризнанныйРасход.ДокументОплаты = ДокументОплаты;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// 1. Отражение в КУДиР поступления и списания денежных средств.
	Если ДвиженияДенежныхСредств.Количество() > 0 Тогда
	
		ДвиженияДенежныхСредств.Свернуть("Период,Организация,ИФО,КФО,
			|ВидОперацииУСН,СчетБУ,Контрагент,Договор,ЦМО,ВидНалога", "Сумма");
		Для Каждого Оплата Из ДвиженияДенежныхСредств Цикл
			
			СодержаниеОперации = ОписаниеОплатыДляКУДиР(Оплата);
			
			Если Оплата.ВидОперацииУСН = Перечисления.ВидыОперацийУСН.ОплатаОтПокупателя Тогда
				
				ОтборПоДоговору = Новый Структура("Период,Организация,ИФО,КФО,Контрагент");
				ЗаполнитьЗначенияСвойств(ОтборПоДоговору, Оплата);
				Если ЗначениеЗаполнено(Оплата.Договор) Тогда
					ОтборПоДоговору.Вставить("Договор", Оплата.Договор);
				КонецЕсли;
				ОтборПоДоговору.Вставить("СчетДт", БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("УРК"));
				
				ПризнанныеДоходыПоДоговору = ВыделитьОплаченныеДоходы(Оплата.Сумма,
					ПризнанныеДоходы, ОтборПоДоговору);
				
				ОтразитьПризнанныеДоходыВКУДиР(ПризнанныеДоходыПоДоговору,
					СодержаниеОперации, ДвиженияУСН, ДокументСсылка);
				
			ИначеЕсли Оплата.ВидОперацииУСН = Перечисления.ВидыОперацийУСН.ВозвратПокупателю Тогда
				
				ОтборПоДоговору = Новый Структура("Период,Организация,ИФО,КФО,Контрагент");
				ЗаполнитьЗначенияСвойств(ОтборПоДоговору, Оплата);
				Если ЗначениеЗаполнено(Оплата.Договор) Тогда
					ОтборПоДоговору.Вставить("Договор", Оплата.Договор);
				КонецЕсли;
				ОтборПоДоговору.Вставить("СчетДт", БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("УРК"));
				
				ПризнанныеДоходыПоДоговору = ВыделитьОплаченныеДоходы(-1 * Оплата.Сумма,
					ПризнанныеДоходы, ОтборПоДоговору);
				
				ОтразитьПризнанныеДоходыВКУДиР(ПризнанныеДоходыПоДоговору,
					СодержаниеОперации, ДвиженияУСН, ДокументСсылка);
			
			ИначеЕсли Оплата.ВидОперацииУСН = Перечисления.ВидыОперацийУСН.РозничнаяВыручка
				ИЛИ Оплата.ВидОперацииУСН = Перечисления.ВидыОперацийУСН.СторноРозничнойВыручки Тогда
				
				ОтборДоходов = Новый Структура("Период,Организация,ИФО,КФО");
				ЗаполнитьЗначенияСвойств(ОтборДоходов, Оплата);
				ОтборДоходов.Вставить("СчетДт", БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("УРТ"));
				ОтборДоходов.Вставить("ЦМО",    Оплата.ЦМО);
				
				Если Оплата.ВидОперацииУСН = Перечисления.ВидыОперацийУСН.РозничнаяВыручка Тогда
					ПризнанныеДоходыПоЦМО = ВыделитьОплаченныеДоходы(Оплата.Сумма,
						ПризнанныеДоходы, ОтборДоходов);
				Иначе
					ПризнанныеДоходыПоЦМО = ВыделитьОплаченныеДоходы(-1 * Оплата.Сумма,
						ПризнанныеДоходы, ОтборДоходов);
				КонецЕсли;
				
				ОтборРасходов = Новый Структура("Период,Организация,ИФО,КФО");
				ЗаполнитьЗначенияСвойств(ОтборРасходов, Оплата);
				ОтборРасходов.Вставить("СчетКт",         БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("УРТ"));
				ОтборРасходов.Вставить("ЭлементРасхода", Оплата.ЦМО);
				
				ПризнанныеРасходыПоЦМО = ВыделитьОплаченныеРасходы(0,
					ПризнанныеРасходы, ОтборРасходов);
				
				ОтразитьРозничныеДоходыИРасходыВКУДиР(ПризнанныеДоходыПоЦМО, ПризнанныеРасходыПоЦМО,
					СодержаниеОперации, ДвиженияУСН, ДокументСсылка);
				
			ИначеЕсли Оплата.ВидОперацииУСН = Перечисления.ВидыОперацийУСН.ПрочееПоступление Тогда
				
				ОтборПрочихДоходов = Новый Структура("Период,Организация,ИФО,КФО");
				ЗаполнитьЗначенияСвойств(ОтборПрочихДоходов, Оплата);
				ОтборПрочихДоходов.Вставить("СчетДт", БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("УР"));
				
				ПризнанныеДоходыПоПрочимОперациям = ВыделитьОплаченныеДоходы(Оплата.Сумма,
					ПризнанныеДоходы, ОтборПрочихДоходов);
				
				ОтразитьПризнанныеДоходыВКУДиР(ПризнанныеДоходыПоПрочимОперациям,
					СодержаниеОперации, ДвиженияУСН, ДокументСсылка);
				
			КонецЕсли;
			
			Если НЕ УчетУСНВызовСервера.ПрименяетсяУСНДоходыМинусРасходы(Оплата.Организация, Оплата.Период) Тогда
				Продолжить;
			КонецЕсли;
			
			Если Оплата.ВидОперацииУСН = Перечисления.ВидыОперацийУСН.ОплатаПоставщику Тогда
				
				ОтборПоДоговору = Новый Структура("Период,Организация,ИФО,КФО,Контрагент,Договор");
				ЗаполнитьЗначенияСвойств(ОтборПоДоговору, Оплата);
				
				ПризнанныеРасходыПоДоговору = ВыделитьОплаченныеРасходы(Оплата.Сумма,
					ПризнанныеРасходы, ОтборПоДоговору);
				
				ОтразитьПризнанныеРасходыВКУДиР(ПризнанныеРасходыПоДоговору,
					СодержаниеОперации, ДвиженияУСН, ДокументСсылка);
				
			ИначеЕсли Оплата.ВидОперацииУСН = Перечисления.ВидыОперацийУСН.ВозвратОтПоставщика Тогда
				
				ОтборПоДоговору = Новый Структура("Период,Организация,ИФО,КФО,Контрагент,Договор");
				ЗаполнитьЗначенияСвойств(ОтборПоДоговору, Оплата);
				
				ПризнанныеРасходыПоДоговору = ВыделитьОплаченныеРасходы(-1 * Оплата.Сумма,
					ПризнанныеРасходы, ОтборПоДоговору);
				
				ОтразитьПризнанныеРасходыВКУДиР(ПризнанныеРасходыПоДоговору,
					СодержаниеОперации, ДвиженияУСН, ДокументСсылка);
				
			ИначеЕсли Оплата.ВидОперацииУСН = Перечисления.ВидыОперацийУСН.ВыдачаПодотчетномуЛицу
				ИЛИ Оплата.ВидОперацииУСН = Перечисления.ВидыОперацийУСН.ПеречислениеПодотчетномуЛицу Тогда
				
				ОтборПоКонтрагенту = Новый Структура("Период,Организация,ИФО,КФО,Контрагент");
				ЗаполнитьЗначенияСвойств(ОтборПоКонтрагенту, Оплата);
				
				ПризнанныеРасходыПоКонтрагенту = ВыделитьОплаченныеРасходы(Оплата.Сумма,
					ПризнанныеРасходы, ОтборПоКонтрагенту);
				
				ОтразитьПризнанныеРасходыВКУДиР(ПризнанныеРасходыПоКонтрагенту,
					СодержаниеОперации, ДвиженияУСН, ДокументСсылка);
				
			ИначеЕсли Оплата.ВидОперацииУСН = Перечисления.ВидыОперацийУСН.ВозвратОтПодотчетногоЛица Тогда
				
				ВыплаченоПодочетномуЛицу = ПризнанныеРасходы.СкопироватьКолонки();
				
				СтрокаРасходыВсего = ВыплаченоПодочетномуЛицу.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаРасходыВсего, Оплата, "Период,Организация,ИФО,КФО");
				СтрокаРасходыВсего.РасходыВсего = - Оплата.Сумма;
				
				ОтразитьПризнанныеРасходыВКУДиР(ВыплаченоПодочетномуЛицу,
					СодержаниеОперации, ДвиженияУСН, ДокументСсылка);
				
			ИначеЕсли Оплата.ВидОперацииУСН = Перечисления.ВидыОперацийУСН.ПеречислениеНалога Тогда
				
				ОтборПоВидуНалога = Новый Структура("Период,Организация,ИФО,КФО");
				ЗаполнитьЗначенияСвойств(ОтборПоВидуНалога, Оплата);
				ОтборПоВидуНалога.Вставить("ВидРасхода",     Перечисления.ВидыРасходовУСН.Налоги);
				ОтборПоВидуНалога.Вставить("ЭлементРасхода", Оплата.ВидНалога);
				
				ПризнанныеРасходыПоВидуНалога = ВыделитьОплаченныеРасходы(Оплата.Сумма,
					ПризнанныеРасходы, ОтборПоВидуНалога);
				
				ОтразитьПризнанныеРасходыВКУДиР(ПризнанныеРасходыПоВидуНалога,
					СодержаниеОперации, ДвиженияУСН, ДокументСсылка);
				
			ИначеЕсли Оплата.ВидОперацииУСН = Перечисления.ВидыОперацийУСН.ВыплатаЗаработнойПлаты
				ИЛИ Оплата.ВидОперацииУСН = Перечисления.ВидыОперацийУСН.ПеречислениеЗаработнойПлаты
				ИЛИ Оплата.ВидОперацииУСН = Перечисления.ВидыОперацийУСН.ПеречислениеУдержанийИзЗаработнойПлаты Тогда
				
				ОтборПоКонтрагенту = Новый Структура("Период,Организация,ИФО,КФО,Контрагент");
				ЗаполнитьЗначенияСвойств(ОтборПоКонтрагенту, Оплата);
				
				ПризнанныеРасходыПоКонтрагенту = ВыделитьОплаченныеРасходы(Оплата.Сумма,
					ПризнанныеРасходы, ОтборПоКонтрагенту);
				
				ОтразитьПризнанныеРасходыВКУДиР(ПризнанныеРасходыПоКонтрагенту,
					СодержаниеОперации, ДвиженияУСН, ДокументСсылка);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	// 2. Отражение признанных доходов остальными документами.
	Если ПризнанныеДоходы.Количество() > 0 Тогда
		
		РеквизитыГруппировки = "ВидОперацииУСН,Период,Организация,ИФО,КФО,СчетДт,СчетКт,Контрагент,Договор,ЦМО";
		ПризнанныеДоходыСводно = ПризнанныеДоходы.Скопировать();
		ПризнанныеДоходыСводно.Свернуть(РеквизитыГруппировки);
		Для Каждого ПризнанныйДоход Из ПризнанныеДоходыСводно Цикл
			
			СодержаниеОперации = ОписаниеОперацииДляКУДиР(ПризнанныйДоход, ДокументСсылка);
			
			Отбор = Новый Структура(РеквизитыГруппировки);
			ЗаполнитьЗначенияСвойств(Отбор, ПризнанныйДоход);
			ПризнанныеДоходыДетально = ПризнанныеДоходы.Скопировать(Отбор);
			
			ОтразитьПризнанныеДоходыВКУДиР(ПризнанныеДоходыДетально,
				СодержаниеОперации, ДвиженияУСН, ДокументСсылка);
			
		КонецЦикла;
		
	КонецЕсли;
	
	// 3. Отражение признанных расходов остальными документами.
	Если ПризнанныеРасходы.Количество() > 0 Тогда
		
		РеквизитыГруппировки = "Период,Организация,ИФО,КФО,СчетДт,СчетКт,Контрагент,Договор,ВидРасхода";
		ПризнанныеРасходыСводно = ПризнанныеРасходы.Скопировать();
		ПризнанныеРасходыСводно.Свернуть(РеквизитыГруппировки);
		Для Каждого ПризнанныйРасход Из ПризнанныеРасходыСводно Цикл
			
			СодержаниеОперации = ОписаниеОперацииДляКУДиР(ПризнанныйРасход, ДокументСсылка);
			
			Отбор = Новый Структура(РеквизитыГруппировки);
			ЗаполнитьЗначенияСвойств(Отбор, ПризнанныйРасход);
			ПризнанныеРасходыДетально = ПризнанныеРасходы.Скопировать(Отбор);
			
			ОтразитьПризнанныеРасходыВКУДиР(ПризнанныеРасходыДетально,
				СодержаниеОперации, ДвиженияУСН, ДокументСсылка);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ДобавитьПризнанныйРасход(ПризнанныеРасходы, Проводка, РасходыУСН, РасходыНеУчитываемые, РасходыЕНВД, СуммаНДС)
	
	ПризнанныйРасход = ПризнанныеРасходы.Добавить();
	ЗаполнитьЗначенияСвойств(ПризнанныйРасход, Проводка, "Период,Организация,ИФО,КФО");
	
	ПризнанныйРасход.СчетДт = Проводка.СчетДт;
	ПризнанныйРасход.СчетКт = Проводка.СчетКт;
	
	Если БухгалтерскийУчет.СчетВИерархии(Проводка.СчетКт, "УРТ") Тогда
		
		ПризнанныйРасход.ВидРасхода     = Перечисления.ВидыРасходовУСН.МатериальныеЗапасы;
		ПризнанныйРасход.ЭлементРасхода = Проводка.СубконтоКт.ЦМО;
		
	ИначеЕсли БухгалтерскийУчетПовтИсп.ЕстьСубконтоСчета(Проводка.СчетКт,
			ПланыВидовХарактеристик.ВидыСубконто.РасходыУСН) Тогда
		
		ЭлементУчетаРасходовУСН = Проводка.СубконтоКт.РасходыУСН;
		Если ЗначениеЗаполнено(ЭлементУчетаРасходовУСН) Тогда
			ЗаполнитьЗначенияСвойств(ПризнанныйРасход, ЭлементУчетаРасходовУСН,
				"ВидРасхода,ЭлементРасхода,Партия,ИмяСпискаДокумента,НомерСтрокиДокумента,Контрагент,Договор");
		КонецЕсли;
		
	КонецЕсли;
	
	Если БухгалтерскийУчет.СчетВИерархии(Проводка.СчетКт, "У01")
	 ИЛИ БухгалтерскийУчет.СчетВИерархии(Проводка.СчетКт, "У04") Тогда
		ПризнанныйРасход.ОписаниеРасходов =
			НСтр("ru = 'расходы на приобретение (изготовление, модернизацию) ОС и НМА'");
	ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Проводка.СчетКт, "У08") Тогда
		ПризнанныйРасход.ОписаниеРасходов =
			НСтр("ru = 'расходы на приобретение (изготовление, модернизацию) имущества, не являющегося амортизируемым'");
	ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Проводка.СчетКт, "У10") Тогда
		ПризнанныйРасход.ОписаниеРасходов =
			НСтр("ru = 'расходы на приобретение материальных запасов'");
	ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Проводка.СчетКт, "У15") Тогда
		ПризнанныйРасход.ОписаниеРасходов =
			НСтр("ru = 'доп. расходы на приобретение материальных запасов'");
	ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Проводка.СчетКт, "У20") Тогда
		ПризнанныйРасход.ОписаниеРасходов =
			НСтр("ru = 'расходы на услуги сторонних организаций'");
	ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Проводка.СчетКт, "У41") Тогда
		ПризнанныйРасход.ОписаниеРасходов =
			НСтр("ru = 'расходы на приобретение товаров'");
	ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Проводка.СчетКт, "У68") Тогда
		ПризнанныйРасход.ОписаниеРасходов =
			НСтр("ru = 'расходы на уплату налогов (взносов)'");
	ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Проводка.СчетКт, "У70") Тогда
		ПризнанныйРасход.ОписаниеРасходов =
			НСтр("ru = 'расходы на оплату труда'");
	ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Проводка.СчетКт, "УРТ") Тогда
		ПризнанныйРасход.ОписаниеРасходов =
			НСтр("ru = 'себестоимость розничных продаж'");
	КонецЕсли;
	
	ПризнанныйРасход.РасходыУСН           = РасходыУСН + СуммаНДС;
	ПризнанныйРасход.РасходыНеУчитываемые = РасходыНеУчитываемые;
	ПризнанныйРасход.РасходыЕНВД          = РасходыЕНВД;
	ПризнанныйРасход.НДС                  = СуммаНДС;
	
	ПризнанныйРасход.БазаРаспределения = ПризнанныйРасход.РасходыУСН
										+ ПризнанныйРасход.РасходыНеУчитываемые
										+ ПризнанныйРасход.РасходыЕНВД;
	
	Возврат ПризнанныйРасход;
	
КонецФункции

Функция ВыделитьОплаченныеДоходы(СуммаОплаты, ТаблицаДоходов, ОтборДоходов)
	
	НайденныеСтроки = ТаблицаДоходов.НайтиСтроки(ОтборДоходов);
	Если НайденныеСтроки.Количество() > 0 Тогда
		
		НоваяТаблица = ТаблицаДоходов.Скопировать(НайденныеСтроки);
		
		ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(СуммаОплаты,
			НоваяТаблица, "ДоходыВсего", "БазаРаспределения");
		
		Для Каждого Строка Из НайденныеСтроки Цикл
			ТаблицаДоходов.Удалить(Строка);
		КонецЦикла;
		
	Иначе
		НоваяТаблица = ТаблицаДоходов.СкопироватьКолонки();
	КонецЕсли;
	
	// Нераспределенный остаток добавляем отдельной строкой.
	Если НоваяТаблица.Итог("ДоходыВсего") <> СуммаОплаты Тогда
		
		СтрокаДоходыВсего = НоваяТаблица.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДоходыВсего, ОтборДоходов);
		СтрокаДоходыВсего.ДоходыВсего = СуммаОплаты - НоваяТаблица.Итог("ДоходыВсего");
		
	КонецЕсли;
	
	Возврат НоваяТаблица;
	
КонецФункции

Функция ВыделитьОплаченныеРасходы(СуммаОплаты, ТаблицаРасходов, ОтборРасходов)
	
	НайденныеСтроки = ТаблицаРасходов.НайтиСтроки(ОтборРасходов);
	Если НайденныеСтроки.Количество() > 0 Тогда
		
		НоваяТаблица = ТаблицаРасходов.Скопировать(НайденныеСтроки);
		
		ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(СуммаОплаты,
			НоваяТаблица, "РасходыВсего", "БазаРаспределения");
		
		Для Каждого Строка Из НайденныеСтроки Цикл
			ТаблицаРасходов.Удалить(Строка);
		КонецЦикла;
		
	Иначе
		НоваяТаблица = ТаблицаРасходов.СкопироватьКолонки();
	КонецЕсли;
	
	// Нераспределенный остаток добавляем отдельной строкой.
	Если НоваяТаблица.Итог("РасходыВсего") <> СуммаОплаты Тогда
		
		СтрокаРасходыВсего = НоваяТаблица.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаРасходыВсего, ОтборРасходов);
		СтрокаРасходыВсего.РасходыВсего = СуммаОплаты - НоваяТаблица.Итог("РасходыВсего");
		
	КонецЕсли;
	
	Возврат НоваяТаблица;
	
КонецФункции

Процедура ОтразитьПризнанныеДоходыВКУДиР(ПризнанныеДоходы, СодержаниеОперации, ДвиженияУСН, ДокументСсылка)
	
	// Отразим признанные доходы в регистре "КнигаУчетаДоходовИРасходов".
	ИтогиДоходовУСН = ПризнанныеДоходы.Скопировать();
	ИтогиДоходовУСН.Свернуть("Период,Организация,ИФО,КФО,ВидОперацииУСН",
		"ДоходыУСН,ДоходыЕНВД,ДоходыВсего");
	
	ВалютаРеглУчета = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета();
	
	Для Каждого СтрокаИтогов Из ИтогиДоходовУСН Цикл
		
		Если СтрокаИтогов.ДоходыВсего = 0
		   И СтрокаИтогов.ДоходыУСН = 0
		   И СтрокаИтогов.ДоходыЕНВД = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		// Добавим запись КУДиР.
		ЗаписьКУДиР = ДвиженияУСН.КнигаУчетаДоходовИРасходов.Добавить();
		
		ЗаписьКУДиР.Период      = СтрокаИтогов.Период;
		ЗаписьКУДиР.Организация = СтрокаИтогов.Организация;
		ЗаписьКУДиР.Содержание  = СодержаниеОперации;
		
		ЗаписьКУДиР.РеквизитыПервичногоДокумента = РеквизитыПервичногоДокумента(ДокументСсылка);
		
		ЗаписьКУДиР.ДоходыВсего = СтрокаИтогов.ДоходыВсего;
		ЗаписьКУДиР.ДоходыУСН   = СтрокаИтогов.ДоходыУСН;
		ЗаписьКУДиР.ДоходыЕНВД  = СтрокаИтогов.ДоходыЕНВД;
		
		УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(
			СтрокаИтогов.Организация, СтрокаИтогов.Период);
		Если УчетнаяПолитика.ПлательщикЕНВД Тогда
			
			Если СтрокаИтогов.ВидОперацииУСН = "АвансОтнесенКДеятельностиНаУСН" Тогда
				
				ЗаписьКУДиР.Содержание = ЗаписьКУДиР.Содержание +
					СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = '. Аванс на сумму %1 отнесен к деятельности на УСН.'"),
						ОбщегоНазначенияБГУ.ФорматСумм(ЗаписьКУДиР.ДоходыУСН, ВалютаРеглУчета));
				
			ИначеЕсли СтрокаИтогов.ВидОперацииУСН = "АвансОтнесенКДеятельностиНаЕНВД" Тогда
				
				ЗаписьКУДиР.Содержание = ЗаписьКУДиР.Содержание +
					СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = '. Аванс на сумму %1 отнесен к деятельности на ЕНВД.'"),
						ОбщегоНазначенияБГУ.ФорматСумм(ЗаписьКУДиР.ДоходыЕНВД, ВалютаРеглУчета));
				
			ИначеЕсли ЗаписьКУДиР.ДоходыЕНВД > 0 Тогда
				
				ЗаписьКУДиР.Содержание = ЗаписьКУДиР.Содержание +
					СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = '. Оплата на сумму %1 отнесена к деятельности на ЕНВД.'"),
						ОбщегоНазначенияБГУ.ФорматСумм(ЗаписьКУДиР.ДоходыЕНВД, ВалютаРеглУчета));
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если УчетнаяПолитика.ПрименяетсяУСН Тогда
			
			Если СтрокаИтогов.ВидОперацииУСН = "НДСИсключенИзДоходовУСН" Тогда
				
				ЗаписьКУДиР.Содержание = ЗаписьКУДиР.Содержание +
					СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = '. Предъявленный покупателям НДС в сумме %1 исключен из доходов.'"),
						ОбщегоНазначенияБГУ.ФорматСумм(-ЗаписьКУДиР.ДоходыУСН, ВалютаРеглУчета));
				
			КонецЕсли;
			
		КонецЕсли;
		
		// Ключ синхронизации с записями регистра сведений "РасшифровкаКУДиР".
		ЗаписьКУДиР.КлючЗаписиКУДиР = ДвиженияУСН.КнигаУчетаДоходовИРасходов.Количество();
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОтразитьПризнанныеРасходыВКУДиР(ПризнанныеРасходы, СодержаниеОперации, ДвиженияУСН, ДокументСсылка)
	
	// Отразим признанные расходы в регистрах "КнигаУчетаДоходовИРасходов" и "РасшифровкаКУДиР".
	ИтогиРасходовУСН = ПризнанныеРасходы.Скопировать();
	ИтогиРасходовУСН.Свернуть("Период,Организация,ИФО,КФО,ВидРасхода,ОписаниеРасходов",
		"РасходыВсего,РасходыУСН,НДС");
	
	Для Каждого СтрокаИтогов Из ИтогиРасходовУСН Цикл
		
		// Нет признанных расходов, только Расходы (всего).
		Если СтрокаИтогов.РасходыВсего <> 0
		   И СтрокаИтогов.РасходыУСН = 0
		   И СтрокаИтогов.НДС = 0 Тогда
			
			// Добавим запись КУДиР.
			ЗаписьКУДиР = ДвиженияУСН.КнигаУчетаДоходовИРасходов.Добавить();
			
			ЗаписьКУДиР.Период      = СтрокаИтогов.Период;
			ЗаписьКУДиР.Организация = СтрокаИтогов.Организация;
			
			ЗаписьКУДиР.РеквизитыПервичногоДокумента = РеквизитыПервичногоДокумента(ДокументСсылка);
			
			ЗаписьКУДиР.РасходыВсего = СтрокаИтогов.РасходыВсего;
			
			ЗаписьКУДиР.Содержание = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = '%1.'"),
				СодержаниеОперации);
			
			ЗаписьКУДиР.РасходыВсего = СтрокаИтогов.РасходыВсего;
			
		// Есть признанные расходы.
		ИначеЕсли СтрокаИтогов.РасходыУСН <> 0
			ИЛИ СтрокаИтогов.НДС <> 0 Тогда
			
			УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(
				СтрокаИтогов.Организация, СтрокаИтогов.Период);
			НДСПоОплатеПоставщику = (УчетнаяПолитика.ПорядокПризнанияРасходовПоНДС =
				Перечисления.ПорядокПризнанияРасходовПоНДС.ПоОплатеПоставщику);
			
			// Добавим основную запись КУДиР.
			ЗаписьКУДиР = ДвиженияУСН.КнигаУчетаДоходовИРасходов.Добавить();
			
			ЗаписьКУДиР.Период      = СтрокаИтогов.Период;
			ЗаписьКУДиР.Организация = СтрокаИтогов.Организация;
			
			ЗаписьКУДиР.ВидРасхода = СтрокаИтогов.ВидРасхода;
			ЗаписьКУДиР.РеквизитыПервичногоДокумента = РеквизитыПервичногоДокумента(ДокументСсылка);
			
			ЗаписьКУДиР.РасходыВсего = СтрокаИтогов.РасходыВсего;
			ЗаписьКУДиР.РасходыУСН   = СтрокаИтогов.РасходыУСН;
			ЗаписьКУДиР.НДС          = СтрокаИтогов.НДС;
			
			ОписаниеДействия = ?( ЗаписьКУДиР.РасходыУСН < 0,
				НСтр("ru = 'Сторнированы'"), НСтр("ru = 'Признаны'") );
			
			ЗаписьКУДиР.Содержание = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = '%1. %2 %3.'"),
				СодержаниеОперации,
				ОписаниеДействия,
				СтрокаИтогов.ОписаниеРасходов);
			
			// Ключ синхронизации с записями регистра сведений "РасшифровкаКУДиР".
			ЗаписьКУДиР.КлючЗаписиКУДиР = ДвиженияУСН.КнигаУчетаДоходовИРасходов.Количество();
			
			// Записи расшифровки КУДиР.
			Отбор = Новый Структура("Период,Организация,ИФО,КФО,ВидРасхода,ОписаниеРасходов");
			ЗаполнитьЗначенияСвойств(Отбор, СтрокаИтогов);
			ЗаписиРасшифровкиКУДиР = ПризнанныеРасходы.Скопировать(Отбор);
			
			Если НДСПоОплатеПоставщику И СтрокаИтогов.НДС <> 0 Тогда
				
				// Добавим запись КУДиР по НДС.
				ЗаписьПоНДС = ДвиженияУСН.КнигаУчетаДоходовИРасходов.Добавить();
				
				ЗаписьПоНДС.Период      = СтрокаИтогов.Период;
				ЗаписьПоНДС.Организация = СтрокаИтогов.Организация;
				
				ЗаписьПоНДС.ВидРасхода = Перечисления.ВидыРасходовУСН.НДС;
				ЗаписьПоНДС.РеквизитыПервичногоДокумента = РеквизитыПервичногоДокумента(ДокументСсылка);
				
				// Уберем НДС из основной записи КУДиР, добавим в запись по НДС.
				Если ЗаписьКУДиР.РасходыВсего > 0 Тогда
					ЗаписьКУДиР.РасходыВсего = ЗаписьКУДиР.РасходыВсего - СтрокаИтогов.НДС;
					ЗаписьПоНДС.РасходыВсего = ЗаписьПоНДС.РасходыВсего + СтрокаИтогов.НДС;
				КонецЕсли;
				ЗаписьКУДиР.РасходыУСН = ЗаписьКУДиР.РасходыУСН - СтрокаИтогов.НДС;
				ЗаписьПоНДС.РасходыУСН = ЗаписьПоНДС.РасходыУСН + СтрокаИтогов.НДС;
				ЗаписьКУДиР.НДС = 0;
				ЗаписьПоНДС.НДС = 0;
				
				ОписаниеДействия = ?( ЗаписьПоНДС.РасходыУСН < 0,
					НСтр("ru = 'Сторнированы'"), НСтр("ru = 'Признаны'") );
				
				ЗаписьПоНДС.Содержание = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = '%1. %2 %3.'"),
					СодержаниеОперации,
					ОписаниеДействия,
					НСтр("ru = 'расходы на уплату НДС, предъявленного поставщиком'"));
				
				// Ключ синхронизации с записями регистра сведений "РасшифровкаКУДиР".
				ЗаписьПоНДС.КлючЗаписиКУДиР = ДвиженияУСН.КнигаУчетаДоходовИРасходов.Количество();
				
				// Уберем НДС из расшифровки основной записи КУДиР, добавим расшифровку записи по НДС.
				ЗаписиРасшифровкиНДС = ЗаписиРасшифровкиКУДиР.Скопировать();
				Для Каждого ЗаписьРасшифровкиКУДиР Из ЗаписиРасшифровкиКУДиР Цикл
					ЗаписьРасшифровкиКУДиР.РасходыУСН = ЗаписьРасшифровкиКУДиР.РасходыУСН - ЗаписьРасшифровкиКУДиР.НДС;
					ЗаписьРасшифровкиКУДиР.НДС = 0;
				КонецЦикла;
				Для Каждого ЗаписьРасшифровкиНДС Из ЗаписиРасшифровкиНДС Цикл
					ЗаписьРасшифровкиНДС.РасходыУСН = ЗаписьРасшифровкиНДС.НДС;
					ЗаписьРасшифровкиНДС.НДС = 0;
				КонецЦикла;
				
				Если ЗаписьКУДиР.РасходыУСН = 0
				   И ЗаписьКУДиР.НДС = 0 Тогда
					// Признаны только расходы на уплату НДС, и они отражаются отдельной записью по НДС.
					// Убираем основную запись КУДиР и не будем формировать расшифровку.
					ЗаписьПоНДС.РасходыВсего = ЗаписьПоНДС.РасходыВсего + ЗаписьКУДиР.РасходыВсего;
					ЗаписьПоНДС.КлючЗаписиКУДиР = ЗаписьКУДиР.КлючЗаписиКУДиР;
					ДвиженияУСН.КнигаУчетаДоходовИРасходов.Удалить(ЗаписьКУДиР);
				Иначе
					// Сформируем движения регистра "РасшифровкаКУДиР" для основной записи КУДиР.
					ДобавитьЗаписиРасшифровкиКУДиР(ЗаписиРасшифровкиКУДиР, ЗаписьКУДиР, ДвиженияУСН);
				КонецЕсли;
				
				// Сформируем движения регистра "РасшифровкаКУДиР" для записи по НДС.
				ДобавитьЗаписиРасшифровкиКУДиР(ЗаписиРасшифровкиНДС, ЗаписьПоНДС, ДвиженияУСН);
				
			Иначе
				
				// Сформируем движения регистра "РасшифровкаКУДиР".
				ДобавитьЗаписиРасшифровкиКУДиР(ЗаписиРасшифровкиКУДиР, ЗаписьКУДиР, ДвиженияУСН);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОтразитьРозничныеДоходыИРасходыВКУДиР(ПризнанныеДоходы, ПризнанныеРасходы, СодержаниеОперации, ДвиженияУСН, ДокументСсылка)
	
	// Добавим запись КУДиР.
	ЗаписьКУДиР = ДвиженияУСН.КнигаУчетаДоходовИРасходов.Добавить();
	
	ЗаписьКУДиР.Период      = ДокументСсылка.Дата;
	ЗаписьКУДиР.Организация = ДокументСсылка.Организация;
	ЗаписьКУДиР.Содержание  = СодержаниеОперации;
	
	ЗаписьКУДиР.РеквизитыПервичногоДокумента = РеквизитыПервичногоДокумента(ДокументСсылка);
	
	ЗаписьКУДиР.ДоходыВсего = ПризнанныеДоходы.Итог("ДоходыВсего");
	ЗаписьКУДиР.ДоходыУСН   = ПризнанныеДоходы.Итог("ДоходыУСН");
	ЗаписьКУДиР.ДоходыЕНВД  = ПризнанныеДоходы.Итог("ДоходыЕНВД");
	
	ЗаписьКУДиР.РасходыВсего = ПризнанныеРасходы.Итог("РасходыВсего");
	ЗаписьКУДиР.РасходыУСН   = ПризнанныеРасходы.Итог("РасходыУСН");
	ЗаписьКУДиР.НДС          = ПризнанныеРасходы.Итог("НДС");
	
	УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(
		ДокументСсылка.Организация, ДокументСсылка.Дата);
	Если УчетнаяПолитика.ПлательщикЕНВД Тогда
		
		Если ЗаписьКУДиР.ДоходыЕНВД > 0 Тогда
			
			ВалютаРеглУчета = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета();
			
			ЗаписьКУДиР.Содержание = ЗаписьКУДиР.Содержание +
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = ' Оплата на сумму %1 отнесена к деятельности на ЕНВД.'"),
					ОбщегоНазначенияБГУ.ФорматСумм(ЗаписьКУДиР.ДоходыЕНВД, ВалютаРеглУчета));
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьЗаписиРасшифровкиКУДиР(ЗаписиРасшифровкиКУДиР, ЗаписьКУДиР, ДвиженияУСН)
	
	НомерСтрокиРасшифровки = 0;
	
	Для Каждого ЗаписьРасшифровки Из ЗаписиРасшифровкиКУДиР Цикл
		
		Если ЗаписьРасшифровки.РасходыУСН <> 0 Тогда
			
			Запись = ДвиженияУСН.РасшифровкаКУДиР.Добавить();
			ЗаполнитьЗначенияСвойств(Запись, ЗаписьКУДиР,
				"Период,Регистратор,Организация,КлючЗаписиКУДиР,РеквизитыПервичногоДокумента");
			
			НомерСтрокиРасшифровки = НомерСтрокиРасшифровки + 1;
			Запись.НомерСтрокиРасшифровки = НомерСтрокиРасшифровки;
			
			Запись.Активность = Истина;
			Запись.ВидРасхода = ЗаписьКУДиР.ВидРасхода;
			
			Запись.РасходыУСН = ЗаписьРасшифровки.РасходыУСН - ЗаписьРасшифровки.НДС;
			
			Запись.ДокументОплатыРасходов       = ЗаписьРасшифровки.ДокументОплаты;
			Запись.ДокументПоступленияРасходов  = ЗаписьРасшифровки.Партия;
			
			Если Запись.ВидРасхода = Перечисления.ВидыРасходовУСН.МатериальныеЗапасы
			 ИЛИ Запись.ВидРасхода = Перечисления.ВидыРасходовУСН.Услуги
			 ИЛИ Запись.ВидРасхода = Перечисления.ВидыРасходовУСН.ДопРасходы Тогда
				
				Запись.Содержание = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = '%1. Поступление %2'"),
					ЗаписьРасшифровки.ЭлементРасхода,
					РеквизитыПервичногоДокумента(ЗаписьРасшифровки.Партия));
				
			ИначеЕсли Запись.ВидРасхода = Перечисления.ВидыРасходовУСН.ОС
			 ИЛИ Запись.ВидРасхода = Перечисления.ВидыРасходовУСН.НМА Тогда
				
				Если ТипЗнч(ЗаписьРасшифровки.ЭлементРасхода) = Тип("СправочникСсылка.ИнвентарныеНомераОС") Тогда
					Запись.Содержание = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = '%1, инв. № %2. %3'"),
						СокрЛП(ЗаписьРасшифровки.ЭлементРасхода.ОС),
						СокрЛП(ЗаписьРасшифровки.ЭлементРасхода),
						РеквизитыПервичногоДокумента(ЗаписьРасшифровки.Партия, Истина));
				Иначе
					Запись.Содержание = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = '%1. %2'"),
						СокрЛП(ЗаписьРасшифровки.ЭлементРасхода),
						РеквизитыПервичногоДокумента(ЗаписьРасшифровки.Партия, Истина));
				КонецЕсли;
				
			ИначеЕсли Запись.ВидРасхода = Перечисления.ВидыРасходовУСН.КапВложения Тогда
				
				Запись.Содержание = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = '%1. Поступление %2'"),
					СокрЛП(ЗаписьРасшифровки.ЭлементРасхода),
					РеквизитыПервичногоДокумента(ЗаписьРасшифровки.Партия));
				
			ИначеЕсли Запись.ВидРасхода = Перечисления.ВидыРасходовУСН.НДС Тогда
				
				Запись.Содержание = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = '(НДС) %1. Поступление %2'"),
					ЗаписьРасшифровки.ЭлементРасхода,
					РеквизитыПервичногоДокумента(ЗаписьРасшифровки.Партия));
				
			ИначеЕсли Запись.ВидРасхода = Перечисления.ВидыРасходовУСН.Налоги Тогда
				
				Запись.Содержание = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Налоги (взносы): %1 (%2)'"),
					ЗаписьРасшифровки.ЭлементРасхода,
					РеквизитыПервичногоДокумента(ЗаписьРасшифровки.Партия, Истина));
				
			ИначеЕсли Запись.ВидРасхода = Перечисления.ВидыРасходовУСН.ОплатаТруда Тогда
				
				Запись.Содержание = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Оплата труда (перечисление удержаний): %1 (%2)'"),
					ЗаписьРасшифровки.ЭлементРасхода,
					РеквизитыПервичногоДокумента(ЗаписьРасшифровки.Партия, Истина));
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЗаписьРасшифровки.НДС <> 0 Тогда
			
			Запись = ДвиженияУСН.РасшифровкаКУДиР.Добавить();
			ЗаполнитьЗначенияСвойств(Запись, ЗаписьКУДиР,
				"Период,Регистратор,Организация,КлючЗаписиКУДиР,РеквизитыПервичногоДокумента");
			
			НомерСтрокиРасшифровки = НомерСтрокиРасшифровки + 1;
			Запись.НомерСтрокиРасшифровки = НомерСтрокиРасшифровки;
			
			Запись.Активность = Истина;
			Запись.ВидРасхода = Перечисления.ВидыРасходовУСН.НДС;
			
			Запись.РасходыУСН = ЗаписьРасшифровки.НДС;
			
			Запись.ДокументОплатыРасходов       = ЗаписьРасшифровки.ДокументОплаты;
			Запись.ДокументПоступленияРасходов  = ЗаписьРасшифровки.Партия;
			
			Если ЗаписьРасшифровки.ВидРасхода = Перечисления.ВидыРасходовУСН.МатериальныеЗапасы
			 ИЛИ ЗаписьРасшифровки.ВидРасхода = Перечисления.ВидыРасходовУСН.Услуги
			 ИЛИ ЗаписьРасшифровки.ВидРасхода = Перечисления.ВидыРасходовУСН.ДопРасходы Тогда
				
				Запись.Содержание = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = '(НДС) %1. Поступление %2'"),
					ЗаписьРасшифровки.ЭлементРасхода,
					РеквизитыПервичногоДокумента(ЗаписьРасшифровки.Партия));
				
			ИначеЕсли ЗаписьРасшифровки.ВидРасхода = Перечисления.ВидыРасходовУСН.ОС
			 ИЛИ ЗаписьРасшифровки.ВидРасхода = Перечисления.ВидыРасходовУСН.НМА Тогда
				
				Запись.Содержание = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = '(НДС) %1. Принятие к учету %2'"),
					СокрЛП(ЗаписьРасшифровки.ЭлементРасхода),
					РеквизитыПервичногоДокумента(ЗаписьРасшифровки.Партия));
				
			ИначеЕсли ЗаписьРасшифровки.ВидРасхода = Перечисления.ВидыРасходовУСН.КапВложения Тогда
				
				Запись.Содержание = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = '(НДС) %1. Поступление %2'"),
					СокрЛП(ЗаписьРасшифровки.ЭлементРасхода),
					РеквизитыПервичногоДокумента(ЗаписьРасшифровки.Партия));
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ОписаниеОплатыДляКУДиР(Оплата)
	
	ОписаниеОперации = "";
	
	Если Оплата.ВидОперацииУСН = Перечисления.ВидыОперацийУСН.ОплатаПоставщику Тогда
		
		Если БухгалтерскийУчет.СчетВИерархии(Оплата.СчетБУ, "201.30") Тогда
			ОписаниеДвиженияДенежныхСредств = НСтр("ru = 'Выдача из кассы'");
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Оплата.СчетБУ, "201.20") Тогда
			ОписаниеДвиженияДенежныхСредств = НСтр("ru = 'Списание с р/с'");
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Оплата.СчетБУ, "201.10") Тогда
			ОписаниеДвиженияДенежныхСредств = НСтр("ru = 'Списание с л/с'");
		Иначе
			ОписаниеДвиженияДенежныхСредств = НСтр("ru = 'Списание денежных средств'");
		КонецЕсли;
		
		ОписаниеОперации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = '%1: оплата поставщику ""%2"" по договору ""%3""'"),
			ОписаниеДвиженияДенежныхСредств,
			Оплата.Контрагент,
			Оплата.Договор);
		
	ИначеЕсли Оплата.ВидОперацииУСН = Перечисления.ВидыОперацийУСН.ВозвратОтПоставщика Тогда
		
		Если БухгалтерскийУчет.СчетВИерархии(Оплата.СчетБУ, "201.30") Тогда
			ОписаниеДвиженияДенежныхСредств = НСтр("ru = 'Поступление в кассу'");
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Оплата.СчетБУ, "201.20") Тогда
			ОписаниеДвиженияДенежныхСредств = НСтр("ru = 'Поступление на р/с'");
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Оплата.СчетБУ, "201.10") Тогда
			ОписаниеДвиженияДенежныхСредств = НСтр("ru = 'Поступление на л/с'");
		Иначе
			ОписаниеДвиженияДенежныхСредств = НСтр("ru = 'Поступление денежных средств'");
		КонецЕсли;
		
		ОписаниеОперации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = '%1: возврат оплаты поставщику ""%2"" по договору ""%3""'"),
			ОписаниеДвиженияДенежныхСредств,
			Оплата.Контрагент,
			Оплата.Договор);
		
	ИначеЕсли Оплата.ВидОперацииУСН = Перечисления.ВидыОперацийУСН.ОплатаОтПокупателя Тогда
		
		Если БухгалтерскийУчет.СчетВИерархии(Оплата.СчетБУ, "201.30") Тогда
			ОписаниеДвиженияДенежныхСредств = НСтр("ru = 'Поступление в кассу'");
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Оплата.СчетБУ, "201.20") Тогда
			ОписаниеДвиженияДенежныхСредств = НСтр("ru = 'Поступление на р/с'");
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(Оплата.СчетБУ, "201.10") Тогда
			ОписаниеДвиженияДенежныхСредств = НСтр("ru = 'Поступление на л/с'");
		Иначе
			ОписаниеДвиженияДенежныхСредств = НСтр("ru = 'Поступление денежных средств'");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Оплата.Договор) Тогда
			ОписаниеОперации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = '%1: оплата от покупателя (дебитора) ""%2"" по договору ""%3""'"),
				ОписаниеДвиженияДенежныхСредств,
