	|	РасходыДетально.СписатьНаЕНВДСуммаЕНВД
	|ИЗ
	|	РасходыСводно КАК РасходыСводно
	|		ЛЕВОЕ СОЕДИНЕНИЕ РасходыДетально КАК РасходыДетально
	|		ПО РасходыСводно.ИдСтроки = РасходыДетально.ИдСтроки
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтрокиСводно,
	|	НомерСтрокиДетально";
	Запрос.УстановитьПараметр("Ссылка", Реквизиты.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ДобавитьСтрокуРаспределениеРасходовПоВидамДеятельностиУСН(ТаблицаРаспределениеРасходов, Выборка,
			Выборка.СписатьНаУСНСумма,
			Выборка.СписатьНаУСНСуммаНДС,
			Выборка.СписатьНаУСНСуммаНеУчитываетсяНУ,
			Выборка.СписатьНаУСНСуммаЕНВД,
			Перечисления.ОтражениеВУСН.Принимаются);
		
		ДобавитьСтрокуРаспределениеРасходовПоВидамДеятельностиУСН(ТаблицаРаспределениеРасходов, Выборка,
			Выборка.СписатьНаЕНВДСумма,
			Выборка.СписатьНаЕНВДСуммаНДС,
			Выборка.СписатьНаЕНВДСуммаНеУчитываетсяНУ,
			Выборка.СписатьНаЕНВДСуммаЕНВД,
			Перечисления.ОтражениеВУСН.ОсобыйПорядок);
		
	КонецЦикла;
	
	Возврат ТаблицаРаспределениеРасходов;
	
КонецФункции

Процедура ДобавитьСтрокуРаспределениеРасходовПоВидамДеятельностиУСН(ТаблицаРаспределениеРасходов, Выборка,
				Сумма, СуммаНДС, СуммаНеУчитываетсяНУ, СуммаЕНВД, ОтражениеВУСН)
	
	Если Сумма = 0
	   И СуммаНДС = 0
	   И СуммаНеУчитываетсяНУ = 0
	   И СуммаЕНВД = 0 Тогда
		Возврат;
	КонецЕсли;
	
	РаспределениеРасходов = ТаблицаРаспределениеРасходов.Добавить();
	ЗаполнитьЗначенияСвойств(РаспределениеРасходов, Выборка,
		"ИФО,КФО,КПС,Подразделение,СчетУчетаУСН,РасходыУСН,Субконто1");
	
	СвойстваСчетаУСН = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Выборка.СчетУчетаУСН);
	Если СвойстваСчетаУСН.ВидСубконто3 = ПланыВидовХарактеристик.ВидыСубконто.ДокументыОплатыУСН Тогда
		РаспределениеРасходов.ДокументОплаты = Выборка.Субконто3;
	КонецЕсли;
	
	РаспределениеРасходов.СуммаРуб                = Сумма;
	РаспределениеРасходов.СуммаНДСРуб             = СуммаНДС;
	РаспределениеРасходов.СуммаНеУчитываетсяНУРуб = СуммаНеУчитываетсяНУ;
	РаспределениеРасходов.СуммаЕНВДРуб            = СуммаЕНВД;
	
	РаспределениеРасходов.ОтражениеВУСН = ОтражениеВУСН;

КонецПроцедуры

// Ввод остатков ОС и НМА в УСН

Функция ПустаяТаблицаВводОстатковОсновныхСредствУСН() Экспорт

	ОписаниеТипаСуммы      = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Идентификация строки.
	ПустаяТаблица.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	
	// Счет и аналитика учета расходов УСН на приобретение ОС, НМА (Дт).
	ПустаяТаблица.Колонки.Добавить("СчетУчетаУСН",     Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("РасходыУСН",       Новый ОписаниеТипов("СправочникСсылка.РасходыУСН"));
	ПустаяТаблица.Колонки.Добавить("ОсновноеСредство", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	
	// Порядок отражения стоимости объекта в налоговом учете при УСН.
	ПустаяТаблица.Колонки.Добавить("ПорядокВключенияСтоимостиВСоставРасходовУСН",
		Новый ОписаниеТипов("ПеречислениеСсылка.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН"));
	ПустаяТаблица.Колонки.Добавить("РасходыПроизведеныДоПереходаНаУСН", Новый ОписаниеТипов("Булево"));
	ПустаяТаблица.Колонки.Добавить("ЭтоОплаченныеРасходы", Новый ОписаниеТипов("Булево"));
	
	// Свойства расходов для формирования элементов справочника "Расходы УСН".
	МетаданныеРасходовУСН  = Метаданные.Справочники.РасходыУСН.Реквизиты;
	ПустаяТаблица.Колонки.Добавить("Партия",               МетаданныеРасходовУСН.Партия.Тип);
	ПустаяТаблица.Колонки.Добавить("ИмяСпискаДокумента",   МетаданныеРасходовУСН.ИмяСпискаДокумента.Тип);
	ПустаяТаблица.Колонки.Добавить("НомерСтрокиДокумента", МетаданныеРасходовУСН.НомерСтрокиДокумента.Тип);
	ПустаяТаблица.Колонки.Добавить("ВидРасхода",           МетаданныеРасходовУСН.ВидРасхода.Тип);
	ПустаяТаблица.Колонки.Добавить("ЭлементРасхода",       МетаданныеРасходовУСН.ЭлементРасхода.Тип);
	ПустаяТаблица.Колонки.Добавить("ОтражениеВУСН",        МетаданныеРасходовУСН.ОтражениеВУСН.Тип);
	ПустаяТаблица.Колонки.Добавить("СчетРасчетов",         МетаданныеРасходовУСН.СчетРасчетов.Тип);
	ПустаяТаблица.Колонки.Добавить("Контрагент",           МетаданныеРасходовУСН.Контрагент.Тип);
	ПустаяТаблица.Колонки.Добавить("Договор",              МетаданныеРасходовУСН.Договор.Тип);
	ПустаяТаблица.Колонки.Добавить("ДокументРасчетов",     МетаданныеРасходовУСН.ДокументРасчетов.Тип);
	
	// Количество и стоимость принимаемых вложений во внеоборотные активы.
	ПустаяТаблица.Колонки.Добавить("Количество",              ОписаниеТипаКоличества);
	ПустаяТаблица.Колонки.Добавить("Валюта",                  Новый ОписаниеТипов("СправочникСсылка.Валюты")); // Валюта расчетов.
	ПустаяТаблица.Колонки.Добавить("СуммаВал",                ОписаниеТипаСуммы); // Сумма в валюте расчетов.
	ПустаяТаблица.Колонки.Добавить("СуммаРуб",                ОписаниеТипаСуммы); // Сумма в рублях.
	
	Возврат ПустаяТаблица;

КонецФункции

Функция ТаблицаВводОстатковОсновныхСредствУСН(ТаблицаВводОстатковОсновныхСредств, Реквизиты, Отказ) Экспорт
	
	ТаблицаРасходовУСН = ПустаяТаблицаВводОстатковОсновныхСредствУСН();
	
	Если НЕ УчетУСНВызовСервера.ПрименяетсяУСНДоходыМинусРасходы(Реквизиты.Организация, КонецГода(Реквизиты.Дата)+1) Тогда
		Возврат ТаблицаРасходовУСН;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаВводОстатков.ИмяСписка КАК ИмяСписка,
	|	ТаблицаВводОстатков.СинонимСписка КАК СинонимСписка,
	|	ТаблицаВводОстатков.НомерСтроки КАК НомерСтроки,
	|	ТаблицаВводОстатков.ИФО КАК ИФО,
	|	ТаблицаВводОстатков.КФО КАК КФО,
	|	ТаблицаВводОстатков.КПС КАК КПС,
	|	ТаблицаВводОстатков.Подразделение КАК Подразделение,
	|	ТаблицаВводОстатков.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаВводОстатков.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТаблицаВводОстатков.СчетУчетаОС КАК СчетУчетаОС,
	|	ТаблицаВводОстатков.СостояниеОС КАК СостояниеОС,
	|	ТаблицаВводОстатков.ПорядокВключенияСтоимостиВСоставРасходовУСН КАК ПорядокВключенияСтоимостиВСоставРасходовУСН,
	|	ТаблицаВводОстатков.Количество КАК Количество
	|ПОМЕСТИТЬ ВводОстатковОСиНМА
	|ИЗ
	|	&ТаблицаВводОстатковОсновныхСредств КАК ТаблицаВводОстатков
	|ГДЕ
	|	ТаблицаВводОстатков.ПорядокВключенияСтоимостиВСоставРасходовУСН <> ЗНАЧЕНИЕ(Перечисление.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН.НеВключатьВСоставРасходов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВводОстатковОСиНМА.ИмяСписка КАК ИмяСписка,
	|	ВводОстатковОСиНМА.СинонимСписка КАК СинонимСписка,
	|	ВводОстатковОСиНМА.НомерСтроки КАК НомерСтроки,
	|	ВводОстатковОСиНМА.ИФО КАК ИФО,
	|	ВводОстатковОСиНМА.КФО КАК КФО,
	|	ВводОстатковОСиНМА.КПС КАК КПС,
	|	ВводОстатковОСиНМА.Подразделение КАК Подразделение,
	|	ВводОстатковОСиНМА.ОсновноеСредство КАК ОсновноеСредство,
	|	ВЫРАЗИТЬ(ВводОстатковОСиНМА.ОсновноеСредство КАК Справочник.ОсновныеСредства).ВидНФА КАК ВидНФА,
	|	ВводОстатковОСиНМА.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ВводОстатковОСиНМА.СчетУчетаОС КАК СчетУчетаОС,
	|	ВводОстатковОСиНМА.СостояниеОС КАК СостояниеОС,
	|	ВводОстатковОСиНМА.ПорядокВключенияСтоимостиВСоставРасходовУСН КАК ПорядокВключенияСтоимостиВСоставРасходовУСН,
	|	ОстаткиРасходовУСН.РасходыПроизведеныДоПереходаНаУСН КАК РасходыПроизведеныДоПереходаНаУСН,
	|	""ОС_РасходыУСН"" КАК ИмяСпискаДокумента,
	|	ОстаткиРасходовУСН.НомерСтроки КАК НомерСтрокиДокумента,
	|	ОстаткиРасходовУСН.СчетРасчетов КАК СчетРасчетов,
	|	ОстаткиРасходовУСН.Контрагент КАК Контрагент,
	|	ОстаткиРасходовУСН.Договор КАК Договор,
	|	ОстаткиРасходовУСН.Валюта КАК Валюта,
	|	ЕСТЬNULL(ОстаткиРасходовУСН.СуммаОплаченныхРасходовРуб, 0) КАК СуммаОплаченныхРасходовРуб,
	|	ЕСТЬNULL(ОстаткиРасходовУСН.СуммаНеоплаченныхРасходовРуб, 0) КАК СуммаНеоплаченныхРасходовРуб,
	|	ЕСТЬNULL(ОстаткиРасходовУСН.СуммаНеоплаченныхРасходовВал, 0) КАК СуммаНеоплаченныхРасходовВал
	|ИЗ
	|	ВводОстатковОСиНМА КАК ВводОстатковОСиНМА
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ВводНачальныхОстатков.ОС_РасходыУСН КАК ОстаткиРасходовУСН
	|		ПО (ОстаткиРасходовУСН.Ссылка = &Ссылка)
	|			И ВводОстатковОСиНМА.ОсновноеСредство = ОстаткиРасходовУСН.ОС
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки,
	|	НомерСтрокиДокумента";
	
	Если ТипЗнч(Реквизиты.Ссылка) = Тип("ДокументСсылка.ВводНачальныхОстатковОС") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.ВводНачальныхОстатков", "Документ.ВводНачальныхОстатковОС");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ОС_РасходыУСН", "РасходыУСН");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВводОстатковОСиНМА.ОсновноеСредство = ОстаткиРасходовУСН.ОС", "ИСТИНА");
	КонецЕсли;	
	
	Запрос.УстановитьПараметр("Ссылка", Реквизиты.Ссылка);
	Запрос.УстановитьПараметр("ТаблицаВводОстатковОсновныхСредств", ТаблицаВводОстатковОсновныхСредств);
	
	ТаблицаВводОстатковУСН = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаТаблицы Из ТаблицаВводОстатковУСН Цикл
		
		Если НЕ УчетУСНКлиентСервер.ВедетсяУчетУСНпоКФО(СтрокаТаблицы.КФО) Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаТаблицы.СуммаНеоплаченныхРасходовРуб > 0 Тогда
			
			НоваяСтрока = ТаблицаРасходовУСН.Добавить();
			НоваяСтрока.ЭтоОплаченныеРасходы = Ложь;
			ЗаполнитьОбщиеРеквизитыРасходовУСНприВводеОстатковПоОС(НоваяСтрока, СтрокаТаблицы, Реквизиты);
			
			Если СтрокаТаблицы.ПорядокВключенияСтоимостиВСоставРасходовУСН =
					Перечисления.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН.ВключитьВСоставРасходовНаОСиНМА Тогда
				Если СтрокаТаблицы.ВидНФА = Перечисления.ВидыНФА.НМА Тогда
					НоваяСтрока.СчетУчетаУСН = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У04.О");
				ИначеЕсли НЕ СтрокаТаблицы.СостояниеОС = Перечисления.СостоянияОС.ВведеноВЭксплуатацию Тогда
					НоваяСтрока.СчетУчетаУСН = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У01.ВО");
				Иначе
					НоваяСтрока.СчетУчетаУСН = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У01.О");
				КонецЕсли;
			Иначе
				НоваяСтрока.СчетУчетаУСН = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У08.О");
			КонецЕсли;
			
			НоваяСтрока.Валюта     = СтрокаТаблицы.Валюта;
			НоваяСтрока.СуммаВал   = СтрокаТаблицы.СуммаНеоплаченныхРасходовВал;
			НоваяСтрока.СуммаРуб   = СтрокаТаблицы.СуммаНеоплаченныхРасходовРуб;
			
		КонецЕсли;
		
		Если СтрокаТаблицы.СуммаОплаченныхРасходовРуб > 0 Тогда
			
			НоваяСтрока = ТаблицаРасходовУСН.Добавить();
			НоваяСтрока.ЭтоОплаченныеРасходы = Истина;
			ЗаполнитьОбщиеРеквизитыРасходовУСНприВводеОстатковПоОС(НоваяСтрока, СтрокаТаблицы, Реквизиты);
			
			Если СтрокаТаблицы.ПорядокВключенияСтоимостиВСоставРасходовУСН =
					Перечисления.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН.ВключитьВСоставРасходовНаОСиНМА Тогда
				Если СтрокаТаблицы.ВидНФА = Перечисления.ВидыНФА.НМА Тогда
					НоваяСтрока.СчетУчетаУСН = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У04.П");
				ИначеЕсли НЕ СтрокаТаблицы.СостояниеОС = Перечисления.СостоянияОС.ВведеноВЭксплуатацию Тогда
					НоваяСтрока.СчетУчетаУСН = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У01.В");
				Иначе
					НоваяСтрока.СчетУчетаУСН = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У01.П");
				КонецЕсли;
			Иначе
				НоваяСтрока.СчетУчетаУСН = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У08.П");
			КонецЕсли;
			
			НоваяСтрока.Валюта     = БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета();
			НоваяСтрока.СуммаВал   = СтрокаТаблицы.СуммаОплаченныхРасходовРуб;
			НоваяСтрока.СуммаРуб   = СтрокаТаблицы.СуммаОплаченныхРасходовРуб;
			
		КонецЕсли;
		
	КонецЦикла;
	
	СформироватьЭлементыУчетаРасходовУСН(Реквизиты.Ссылка, ТаблицаРасходовУСН);
	
	Возврат ТаблицаРасходовУСН;
	
КонецФункции

Процедура ЗаполнитьОбщиеРеквизитыРасходовУСНприВводеОстатковПоОС(НоваяСтрока, СтрокаТаблицы, Реквизиты)
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
	
	// Заполним реквизиты для формирования новых элементов учета расходов УСН.
	НоваяСтрока.Партия               = Реквизиты.Ссылка;
	НоваяСтрока.ИмяСпискаДокумента   = СтрокаТаблицы.ИмяСпискаДокумента;
	НоваяСтрока.НомерСтрокиДокумента = СтрокаТаблицы.НомерСтрокиДокумента;
	
	Если СтрокаТаблицы.ВидНФА = Перечисления.ВидыНФА.НМА Тогда
		НоваяСтрока.ВидРасхода     = Перечисления.ВидыРасходовУСН.НМА;
		НоваяСтрока.ЭлементРасхода = СтрокаТаблицы.ОсновноеСредство;
	Иначе
		НоваяСтрока.ВидРасхода     = Перечисления.ВидыРасходовУСН.ОС;
		Если ЗначениеЗаполнено(СтрокаТаблицы.ИнвентарныйНомер) Тогда
			НоваяСтрока.ЭлементРасхода = СтрокаТаблицы.ИнвентарныйНомер;
		Иначе
			НоваяСтрока.ЭлементРасхода = СтрокаТаблицы.ОсновноеСредство;
		КонецЕсли;
	КонецЕсли;
	
	НоваяСтрока.ОтражениеВУСН = Перечисления.ОтражениеВУСН.Принимаются;
	
	НоваяСтрока.СчетРасчетов     = СтрокаТаблицы.СчетРасчетов;
	НоваяСтрока.Контрагент       = СтрокаТаблицы.Контрагент;
	НоваяСтрока.Договор          = СтрокаТаблицы.Договор;
	НоваяСтрока.ДокументРасчетов = Реквизиты.Ссылка;
	
КонецПроцедуры

// Принятие к учету ОС и НМА в УСН

// Подготавливает таблицу документа принятия к учету ОС, НМА (для целей УСН).
//
Функция ПодготовитьТаблицуПринятиеКУчетуОсновныхСредствПоДокументу(Документ, Параметры = Неопределено) Экспорт
	
	ОписаниеТипаКоличества = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	
	ТаблицаДокумента = Новый ТаблицаЗначений;
	// Идентификация строки.
	ТаблицаДокумента.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ТаблицаДокумента.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ТаблицаДокумента.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	// Объект учета внеоборотных активов.
	ТаблицаДокумента.Колонки.Добавить("ОсновноеСредство",     Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ТаблицаДокумента.Колонки.Добавить("ИнвентарныйНомер",     Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	ТаблицаДокумента.Колонки.Добавить("Количество",           ОписаниеТипаКоличества);
	ТаблицаДокумента.Колонки.Добавить("ВведеноВЭксплуатацию", Новый ОписаниеТипов("Булево"));
	ТаблицаДокумента.Колонки.Добавить("ПорядокВключенияСтоимостиВСоставРасходовУСН",
		Новый ОписаниеТипов("ПеречислениеСсылка.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН"));
	
	Если НЕ УчетУСНВызовСервера.ПрименяетсяУСНДоходыМинусРасходы(Документ.Организация, Документ.Дата) Тогда
		Возврат ТаблицаДокумента;
	КонецЕсли;
	
	Если Параметры = Неопределено Тогда
		Параметры = Новый Структура;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	МетаданныеДокумента = Документ.Метаданные();
	
	ЕстьТабЧастьОсновныеСредства = ОбщегоНазначенияБГУ.ЕстьТабЧастьДокумента("ОсновныеСредства", МетаданныеДокумента);
	Если ЕстьТабЧастьОсновныеСредства Тогда
		
		ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "ОсновныеСредства",
			"НомерСтроки,ОсновноеСредство,ИнвентарныйНомер,Количество,
			|ПринятиеКУчетуОдновременноСВводомВЭксплуатацию,ПорядокВключенияСтоимостиВСоставРасходовУСН",
			Документ, Параметры);
		
		Запрос.Текст = Запрос.Текст +
		"ВЫБРАТЬ
		|	""ОсновныеСредства"" КАК ИмяСписка,
		|	""Основные средства"" КАК СинонимСписка,
		|	ОсновныеСредства.НомерСтроки КАК НомерСтроки,
		|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
		|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	ОсновныеСредства.Количество КАК Количество,
		|	ОсновныеСредства.ПринятиеКУчетуОдновременноСВводомВЭксплуатацию КАК ВведеноВЭксплуатацию,
		|	ОсновныеСредства.ПорядокВключенияСтоимостиВСоставРасходовУСН КАК ПорядокВключенияСтоимостиВСоставРасходовУСН
		|ИЗ
		|	ТаблицаОсновныеСредства КАК ОсновныеСредства
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
		
		ПринятиеКУчетуОсновныхСредств = Запрос.Выполнить().Выгрузить();
		Для Каждого СтрокаДокумента Из ПринятиеКУчетуОсновныхСредств Цикл
			НоваяСтрока = ТаблицаДокумента.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДокумента);
		КонецЦикла;
		
	Иначе
		
		НоваяСтрока = ТаблицаДокумента.Добавить();
		НоваяСтрока.ОсновноеСредство     = Документ.ОсновноеСредство;
		НоваяСтрока.ИнвентарныйНомер     = Документ.ИнвентарныйНомер;
		НоваяСтрока.Количество           = 1;
		НоваяСтрока.ВведеноВЭксплуатацию = Документ.ПринятиеКУчетуОдновременноСВводомВЭксплуатацию;
		НоваяСтрока.ПорядокВключенияСтоимостиВСоставРасходовУСН =
			Документ.ПорядокВключенияСтоимостиВСоставРасходовУСН;
		
	КонецЕсли;
	
	Возврат ТаблицаДокумента;
	
КонецФункции

Функция ПустаяТаблицаПринятиеКУчетуОсновныхСредствУСН() Экспорт

	ОписаниеТипаСуммы      = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Идентификация строки.
	ПустаяТаблица.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	
	// Счет и аналитика учета расходов УСН, отнесенных на вложения во внеоборотные активы (Кт).
	ПустаяТаблица.Колонки.Добавить("СчетВложенийУСН", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("КапВложенияУСН",  Новый ОписаниеТипов("СправочникСсылка.РасходыУСН"));
	ПустаяТаблица.Колонки.Добавить("ОбъектВложений",
		ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства.ТипЗначения);
	ПустаяТаблица.Колонки.Добавить("ДокументОплаты",
		ПланыВидовХарактеристик.ВидыСубконто.ДокументыОплатыУСН.ТипЗначения);
	ПустаяТаблица.Колонки.Добавить("КоличествоВложений", ОписаниеТипаКоличества);
	
	// Счет и аналитика учета расходов УСН на приобретение ОС, НМА (Дт).
	ПустаяТаблица.Колонки.Добавить("СчетУчетаУСН",     Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("РасходыУСН",       Новый ОписаниеТипов("СправочникСсылка.РасходыУСН"));
	ПустаяТаблица.Колонки.Добавить("ОсновноеСредство", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	
	// Порядок отражения стоимости объекта в налоговом учете при УСН.
	ПустаяТаблица.Колонки.Добавить("ПорядокВключенияСтоимостиВСоставРасходовУСН",
		Новый ОписаниеТипов("ПеречислениеСсылка.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН"));
	
	// Свойства расходов для формирования элементов справочника "Расходы УСН".
	МетаданныеРасходовУСН  = Метаданные.Справочники.РасходыУСН.Реквизиты;
	ПустаяТаблица.Колонки.Добавить("Партия",               МетаданныеРасходовУСН.Партия.Тип);
	ПустаяТаблица.Колонки.Добавить("ИмяСпискаДокумента",   МетаданныеРасходовУСН.ИмяСпискаДокумента.Тип);
	ПустаяТаблица.Колонки.Добавить("НомерСтрокиДокумента", МетаданныеРасходовУСН.НомерСтрокиДокумента.Тип);
	ПустаяТаблица.Колонки.Добавить("ВидРасхода",           МетаданныеРасходовУСН.ВидРасхода.Тип);
	ПустаяТаблица.Колонки.Добавить("ЭлементРасхода",       МетаданныеРасходовУСН.ЭлементРасхода.Тип);
	ПустаяТаблица.Колонки.Добавить("ОтражениеВУСН",        МетаданныеРасходовУСН.ОтражениеВУСН.Тип);
	ПустаяТаблица.Колонки.Добавить("СчетРасчетов",         МетаданныеРасходовУСН.СчетРасчетов.Тип);
	ПустаяТаблица.Колонки.Добавить("Контрагент",           МетаданныеРасходовУСН.Контрагент.Тип);
	ПустаяТаблица.Колонки.Добавить("Договор",              МетаданныеРасходовУСН.Договор.Тип);
	ПустаяТаблица.Колонки.Добавить("ДокументРасчетов",     МетаданныеРасходовУСН.ДокументРасчетов.Тип);
	
	// Количество и стоимость принимаемых вложений во внеоборотные активы.
	ПустаяТаблица.Колонки.Добавить("Количество",              ОписаниеТипаКоличества);
	ПустаяТаблица.Колонки.Добавить("Валюта",                  Новый ОписаниеТипов("СправочникСсылка.Валюты")); // Валюта расчетов.
	ПустаяТаблица.Колонки.Добавить("СуммаВал",                ОписаниеТипаСуммы); // Сумма в валюте расчетов.
	ПустаяТаблица.Колонки.Добавить("СуммаРуб",                ОписаниеТипаСуммы); // Сумма в рублях.
	ПустаяТаблица.Колонки.Добавить("СуммаНеУчитываетсяНУРуб", ОписаниеТипаСуммы); // Сумма в рублях.
	ПустаяТаблица.Колонки.Добавить("СуммаЕНВДРуб",            ОписаниеТипаСуммы); // Сумма в рублях.
	ПустаяТаблица.Колонки.Добавить("СуммаНДСРуб",             ОписаниеТипаСуммы); // Сумма НДС в рублях.
	
	Возврат ПустаяТаблица;

КонецФункции

Функция ТаблицаПринятиеКУчетуОсновныхСредствУСН(ТаблицаОСиНМА, Документ, Реквизиты, Отказ) Экспорт
	
	ТаблицаПринятыхОСиНМА           = ПустаяТаблицаПринятиеКУчетуОсновныхСредствУСН();
	ТаблицаАмортизируемогоИмущества = ПустаяТаблицаПринятиеКУчетуОсновныхСредствУСН();
	
	Если НЕ УчетУСНВызовСервера.ПрименяетсяУСНДоходыМинусРасходы(Реквизиты.Организация, Реквизиты.Дата) Тогда
		Возврат ТаблицаПринятыхОСиНМА;
	КонецЕсли;
	
	Если ТипЗнч(Документ) = Тип("ДокументСсылка.РешениеОПризнанииОбъектовОС") Тогда
		ЭтоПриобретение = (Документ.ВидОперации = Перечисления.ВидыОперацийПризнанияОС.Приобретение);
		ЭтоИзготовление = (Документ.ВидОперации = Перечисления.ВидыОперацийПризнанияОС.Изготовление);
		ВнеоборотныйАктив = Документ.КапитальноеВложение;
	Иначе
		ЭтоПриобретение = (Документ.ВидПоступления = Перечисления.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуПриобретение);
		ЭтоИзготовление = (Документ.ВидПоступления = Перечисления.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуИзготовление);
		ВнеоборотныйАктив = Документ.ВнеоборотныйАктив;
	КонецЕсли;
	
	Если Не ЭтоПриобретение И Не ЭтоИзготовление Тогда
		Возврат ТаблицаПринятыхОСиНМА;
	КонецЕсли;
	
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	
	// Получим все остатки расходов УСН по указанному в документе внеоборотному активу.
	СчетаВложенийВоВнеоборотныеАктивыУСН = БухгалтерскийУчет.СписокСчетов("У08.ПО,У08.П");
	
	ОтборРасходов = Новый Структура;
	ОтборРасходов.Вставить("СубконтоРасходов2", ВнеоборотныйАктив);
	
	Если Реквизиты.ИспользоватьУчетПоИФО Тогда
		ОтборРасходов.Вставить("ИФО", Документ.ИФО);
	КонецЕсли;
	//Если Реквизиты.ИспользоватьУчетПоПодразделениям Тогда
	//	ОтборРасходов.Вставить("Подразделение", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
	//		ТаблицаОСиНМА.ВыгрузитьКолонку("Подразделение")));
	//КонецЕсли;
	ОтборРасходов.Вставить("КФО", Документ.КФО);
	
	ПериодОстатков = ?(Реквизиты.Свойство("ПериодОстатков"), Реквизиты.ПериодОстатков,
		Новый Граница(Реквизиты.Ссылка.МоментВремени(), ВидГраницы.Исключая));
	ОстаткиРасходовУСН = ОстаткиРасходовУСН(ПериодОстатков, СчетаВложенийВоВнеоборотныеАктивыУСН, ОтборРасходов, Реквизиты);
	ОбщегоНазначенияБГУ.УпорядочитьТаблицуПоДокументу(ОстаткиРасходовУСН, "Партия", "ДатаДокументаПартии");
	
	// Рассчитаем долю списания кап. вложений.
	Если ЭтоИзготовление Тогда // указывается в документе
		Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("КоличествоВложений", Документ.Метаданные()) Тогда
			КоличествоКапВложенийВсего = Документ.КоличествоВложений;
		Иначе
			КоличествоКапВложенийВсего = Документ.Количество;
		КонецЕсли;
	Иначе
		КоличествоКапВложенийВсего = ОстаткиРасходовУСН.Итог("Количество");
	КонецЕсли;
	КоличествоОбъектовОСиНМАВсего = ТаблицаОСиНМА.Итог("Количество");
	Коэффициент = ?(КоличествоКапВложенийВсего = 0, 0, КоличествоОбъектовОСиНМАВсего / КоличествоКапВложенийВсего);
	Если Коэффициент = 0 Тогда
		Возврат ТаблицаПринятыхОСиНМА;
	КонецЕсли;
	
	// Распределим аккумулированные кап. вложения по объектам ОС и НМА.
	ОписаниеТипаСуммы      = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	ТаблицаОСиНМА.Колонки.Добавить("КоличествоВложений",      ОписаниеТипаКоличества);
	ТаблицаОСиНМА.Колонки.Добавить("СуммаВал",                ОписаниеТипаСуммы);
	ТаблицаОСиНМА.Колонки.Добавить("СуммаРуб",                ОписаниеТипаСуммы);
	ТаблицаОСиНМА.Колонки.Добавить("СуммаНеУчитываетсяНУРуб", ОписаниеТипаСуммы);
	ТаблицаОСиНМА.Колонки.Добавить("СуммаЕНВДРуб",            ОписаниеТипаСуммы);
	ТаблицаОСиНМА.Колонки.Добавить("СуммаНДСРуб",             ОписаниеТипаСуммы);
	
	Для Каждого ОстатокВложений Из ОстаткиРасходовУСН Цикл
		
		СписатьКоличество              = Окр(ОстатокВложений.Количество              * Коэффициент, 2, 1);
		СписатьСуммаВал                = Окр(ОстатокВложений.СуммаВал                * Коэффициент, 2, 1);
		СписатьСуммаРуб                = Окр(ОстатокВложений.СуммаРуб                * Коэффициент, 2, 1);
		СписатьСуммаНеУчитываетсяНУРуб = Окр(ОстатокВложений.СуммаНеУчитываетсяНУРуб * Коэффициент, 2, 1);
		СписатьСуммаЕНВДРуб            = Окр(ОстатокВложений.СуммаЕНВДРуб            * Коэффициент, 2, 1);
		СписатьСуммаНДСРуб             = Окр(ОстатокВложений.СуммаНДСРуб             * Коэффициент, 2, 1);
		
		// Количество и суммы кап.вложений распределяем по объектам ОС и НМА, принимаемым к учету.
		ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(СписатьКоличество,
			ТаблицаОСиНМА, "КоличествоВложений", "Количество");
		ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(СписатьСуммаВал,
			ТаблицаОСиНМА, "СуммаВал", "Количество");
		ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(СписатьСуммаРуб,
			ТаблицаОСиНМА, "СуммаРуб", "Количество");
		ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(СписатьСуммаНеУчитываетсяНУРуб,
			ТаблицаОСиНМА, "СуммаНеУчитываетсяНУРуб", "Количество");
		ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(СписатьСуммаЕНВДРуб,
			ТаблицаОСиНМА, "СуммаЕНВДРуб", "Количество");
		ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(СписатьСуммаНДСРуб,
			ТаблицаОСиНМА, "СуммаНДСРуб", "Количество");
		
		Для Каждого СтрокаОСиНМА Из ТаблицаОСиНМА Цикл
			
			ПорядокВключенияСтоимостиВСоставРасходовУСН = СтрокаОСиНМА.ПорядокВключенияСтоимостиВСоставРасходовУСН;
			
			Если ПорядокВключенияСтоимостиВСоставРасходовУСН =
					Перечисления.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН.ВключитьВСоставРасходовНаОСиНМА Тогда
				НоваяСтрока = ТаблицаАмортизируемогоИмущества.Добавить();
			Иначе
				НоваяСтрока = ТаблицаПринятыхОСиНМА.Добавить();
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ОстатокВложений,
				"ИФО,КФО,КПС,Подразделение,Валюта,СчетРасчетов,Контрагент,Договор,ДокументРасчетов,ОтражениеВУСН");
			
			НоваяСтрока.СчетВложенийУСН = ОстатокВложений.СчетУчетаУСН;
			НоваяСтрока.КапВложенияУСН  = ОстатокВложений.РасходыУСН;
			НоваяСтрока.ОбъектВложений  = ОстатокВложений.СубконтоРасходов2;
			
			СвойстваСчетаВложений = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяСтрока.СчетВложенийУСН);
			Если СвойстваСчетаВложений.ВидСубконто3 = ПланыВидовХарактеристик.ВидыСубконто.ДокументыОплатыУСН Тогда
				НоваяСтрока.ДокументОплаты  = ОстатокВложений.СубконтоРасходов3;
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОСиНМА,
				"ИмяСписка,СинонимСписка,НомерСтроки,КоличествоВложений,Количество,
				|СуммаВал,СуммаРуб,СуммаНеУчитываетсяНУРуб,СуммаЕНВДРуб,СуммаНДСРуб");
			
			Если ПорядокВключенияСтоимостиВСоставРасходовУСН =
					Перечисления.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН.ВключитьВСоставРасходовНаОСиНМА Тогда
				
				// Расходы УСН учитываем по новому объекту ОС, НМА, НПА.
				НоваяСтрока.ОсновноеСредство = СтрокаОСиНМА.ОсновноеСредство;
				
				// Заполним реквизиты для формирования новых элементов учета расходов УСН.
				НоваяСтрока.Партия               = Документ;
				НоваяСтрока.ИмяСпискаДокумента   = СтрокаОСиНМА.ИмяСписка;
				НоваяСтрока.НомерСтрокиДокумента = СтрокаОСиНМА.НомерСтроки;
				
				Если СтрокаОСиНМА.ОсновноеСредство.ВидНФА = Перечисления.ВидыНФА.НМА Тогда
					НоваяСтрока.ВидРасхода     = Перечисления.ВидыРасходовУСН.НМА;
					НоваяСтрока.ЭлементРасхода = СтрокаОСиНМА.ОсновноеСредство;
				Иначе
					НоваяСтрока.ВидРасхода     = Перечисления.ВидыРасходовУСН.ОС;
					Если ЗначениеЗаполнено(СтрокаОСиНМА.ИнвентарныйНомер) Тогда
						НоваяСтрока.ЭлементРасхода = СтрокаОСиНМА.ИнвентарныйНомер;
					Иначе
						НоваяСтрока.ЭлементРасхода = СтрокаОСиНМА.ОсновноеСредство;
					КонецЕсли;
				КонецЕсли;
				
			Иначе
			
				// Расходы УСН учитываем по тому же объекту вложений.
				НоваяСтрока.ОсновноеСредство = ОстатокВложений.СубконтоРасходов2;
				
				// Новые элементы учета расходов УСН не формируем.
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ОстатокВложений,
					"Партия,ИмяСпискаДокумента,НомерСтрокиДокумента,ВидРасхода,ЭлементРасхода,РасходыУСН");
				
			КонецЕсли;
			
			НоваяСтрока.СчетУчетаУСН = СчетРасходовУСНприПринятииКУчетуОсновныхСредствУСН(
				НоваяСтрока.СчетВложенийУСН,
				НоваяСтрока.ОсновноеСредство,
				СтрокаОСиНМА.ВведеноВЭксплуатацию,
				ПорядокВключенияСтоимостиВСоставРасходовУСН);
			
		КонецЦикла;
		
	КонецЦикла;
	
	СформироватьЭлементыУчетаРасходовУСН(Документ, ТаблицаАмортизируемогоИмущества);
	
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ТаблицаАмортизируемогоИмущества, ТаблицаПринятыхОСиНМА);
	ТаблицаПринятыхОСиНМА.Сортировать("ИмяСписка,НомерСтроки");
	
	Возврат ТаблицаПринятыхОСиНМА;
	
КонецФункции

Функция СчетРасходовУСНприПринятииКУчетуОсновныхСредствУСН(СчетВложенийУСН, ОсновноеСредство, ВведеноВЭксплуатацию, ПорядокВключенияСтоимостиВСоставРасходовУСН)
	
	КодСчетаУчетаУСН = Строка(СчетВложенийУСН);
	
	Если ПорядокВключенияСтоимостиВСоставРасходовУСН =
			Перечисления.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН.ВключитьВСоставРасходовНаОСиНМА Тогда
		
		// Кап. вложения: не Оплачены.
		Если Найти(КодСчетаУчетаУСН, "У08.ПО") Тогда
			
			Если ОсновноеСредство.ВидНФА = Перечисления.ВидыНФА.НМА Тогда
				Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У04.О"); // Не меняем статус оплаты.
			ИначеЕсли НЕ ВведеноВЭксплуатацию Тогда
				Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У01.ВО"); // Не меняем статус оплаты.
			Иначе
				Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У01.О"); // Не меняем статус оплаты.
			КонецЕсли;
			
		// Кап. вложения: Оплачены.
		ИначеЕсли Найти(КодСчетаУчетаУСН, "У08.П") Тогда
			
			Если ОсновноеСредство.ВидНФА = Перечисления.ВидыНФА.НМА Тогда
				Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У04.П"); // Не меняем статус оплаты.
			ИначеЕсли НЕ ВведеноВЭксплуатацию Тогда
				Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У01.В"); // Не меняем статус оплаты.
			Иначе
				Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У01.П"); // Не меняем статус оплаты.
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ПорядокВключенияСтоимостиВСоставРасходовУСН =
			Перечисления.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН.ВключитьВСоставМатериальныхРасходов Тогда
		
		// Кап. вложения: не Оплачены.
		Если Найти(КодСчетаУчетаУСН, "У08.ПО") Тогда
			
			Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У08.О"); // Не меняем статус оплаты.
			
		// Кап. вложения: Оплачены.
		ИначеЕсли Найти(КодСчетаУчетаУСН, "У08.П") Тогда
			
			Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У99"); // Включаем расходы в КУДиР.
			
		КонецЕсли;
		
	Иначе
		
		Возврат ПланыСчетов.ЕПСБУ.ПустаяСсылка();
		
	КонецЕсли;
	
КонецФункции

// Модернизация ОС и НМА в УСН

Функция ПустаяТаблицаМодернизацияОсновныхСредствУСН() Экспорт

	ОписаниеТипаСуммы      = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Идентификация строки.
	ПустаяТаблица.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	ПустаяТаблица.Колонки.Добавить("ИдентификаторСтроки", Новый ОписаниеТипов("Строка"));
	
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	
	// Счет и аналитика учета расходов УСН, отнесенных на вложения во внеоборотные активы (Кт).
	ПустаяТаблица.Колонки.Добавить("СчетВложенийУСН", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("КапВложенияУСН",  Новый ОписаниеТипов("СправочникСсылка.РасходыУСН"));
	ПустаяТаблица.Колонки.Добавить("ОбъектВложений",
		ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства.ТипЗначения);
	ПустаяТаблица.Колонки.Добавить("ДокументОплаты",
		ПланыВидовХарактеристик.ВидыСубконто.ДокументыОплатыУСН.ТипЗначения);
	
	// Счет и аналитика учета расходов УСН на приобретение ОС, НМА (Дт).
	ПустаяТаблица.Колонки.Добавить("СчетУчетаУСН",     Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("РасходыУСН",       Новый ОписаниеТипов("СправочникСсылка.РасходыУСН"));
	ПустаяТаблица.Колонки.Добавить("ОсновноеСредство", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	
	// Порядок отражения стоимости объекта в налоговом учете при УСН, указанный при принятии к учету.
	ПустаяТаблица.Колонки.Добавить("ПорядокВключенияСтоимостиВСоставРасходовУСН",
		Новый ОписаниеТипов("ПеречислениеСсылка.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН"));
	
	// Свойства расходов для формирования элементов справочника "Расходы УСН".
	МетаданныеРасходовУСН  = Метаданные.Справочники.РасходыУСН.Реквизиты;
	ПустаяТаблица.Колонки.Добавить("Партия",               МетаданныеРасходовУСН.Партия.Тип);
	ПустаяТаблица.Колонки.Добавить("ИмяСпискаДокумента",   МетаданныеРасходовУСН.ИмяСпискаДокумента.Тип);
	ПустаяТаблица.Колонки.Добавить("НомерСтрокиДокумента", МетаданныеРасходовУСН.НомерСтрокиДокумента.Тип);
	ПустаяТаблица.Колонки.Добавить("ВидРасхода",           МетаданныеРасходовУСН.ВидРасхода.Тип);
	ПустаяТаблица.Колонки.Добавить("ЭлементРасхода",       МетаданныеРасходовУСН.ЭлементРасхода.Тип);
	ПустаяТаблица.Колонки.Добавить("ОтражениеВУСН",        МетаданныеРасходовУСН.ОтражениеВУСН.Тип);
	ПустаяТаблица.Колонки.Добавить("СчетРасчетов",         МетаданныеРасходовУСН.СчетРасчетов.Тип);
	ПустаяТаблица.Колонки.Добавить("Контрагент",           МетаданныеРасходовУСН.Контрагент.Тип);
	ПустаяТаблица.Колонки.Добавить("Договор",              МетаданныеРасходовУСН.Договор.Тип);
	ПустаяТаблица.Колонки.Добавить("ДокументРасчетов",     МетаданныеРасходовУСН.ДокументРасчетов.Тип);
	
	// Стоимость вложений во внеоборотные активы.
	ПустаяТаблица.Колонки.Добавить("Валюта",                  Новый ОписаниеТипов("СправочникСсылка.Валюты")); // Валюта расчетов.
	ПустаяТаблица.Колонки.Добавить("СуммаВал",                ОписаниеТипаСуммы); // Сумма в валюте расчетов.
	ПустаяТаблица.Колонки.Добавить("СуммаРуб",                ОписаниеТипаСуммы); // Сумма в рублях.
	ПустаяТаблица.Колонки.Добавить("СуммаНеУчитываетсяНУРуб", ОписаниеТипаСуммы); // Сумма в рублях.
	ПустаяТаблица.Колонки.Добавить("СуммаЕНВДРуб",            ОписаниеТипаСуммы); // Сумма в рублях.
	ПустаяТаблица.Колонки.Добавить("СуммаНДСРуб",             ОписаниеТипаСуммы); // Сумма НДС в рублях.
	
	Возврат ПустаяТаблица;

КонецФункции

Функция ТаблицаМодернизацияОсновныхСредствУСН(ТаблицаОСиНМА, Документ, Реквизиты, Отказ) Экспорт
	
	ТаблицаМодернизацииОСиНМА       = ПустаяТаблицаМодернизацияОсновныхСредствУСН();
	ТаблицаАмортизируемогоИмущества = ПустаяТаблицаМодернизацияОсновныхСредствУСН();
	
	Если НЕ УчетУСНВызовСервера.ПрименяетсяУСНДоходыМинусРасходы(Реквизиты.Организация, Реквизиты.Дата) Тогда
		Возврат ТаблицаМодернизацииОСиНМА;
	КонецЕсли;
	
	Если Документ.ВидОперации <> Перечисления.ВидыОперацийРеконструкцияОС.МодернизацияОС Тогда
		// Согласно пп. 1 п. 1 ст. 346.16 НК РФ налогоплательщик уменьшает полученные доходы
		// на расходы на достройку, дооборудование, реконструкцию, модернизацию и техническое перевооружение ОС.
		// Модернизация НМА не предусмотрена гл. 26.2 НК РФ. Кап. ремонт в УСН не отражается.
		Возврат ТаблицаМодернизацииОСиНМА;
	КонецЕсли;
	
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	
	// Получим все остатки расходов УСН по указанному в документе внеоборотному активу.
	СчетаВложенийВоВнеоборотныеАктивыУСН = БухгалтерскийУчет.СписокСчетов("У08.ПО,У08.П");
	
	ОтборРасходов = Новый Структура;
	ОтборРасходов.Вставить("СубконтоРасходов2", Документ.ВнеоборотныйАктив);
	
	Если Реквизиты.ИспользоватьУчетПоИФО Тогда
		ОтборРасходов.Вставить("ИФО", Документ.ИФО);
	КонецЕсли;
	//Если Реквизиты.ИспользоватьУчетПоПодразделениям Тогда
	//	ОтборРасходов.Вставить("Подразделение", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
	//		ТаблицаОСиНМА.ВыгрузитьКолонку("Подразделение")));
	//КонецЕсли;
	ОтборРасходов.Вставить("КФО", Документ.КФО);
	
	ПериодОстатков = ?(Реквизиты.Свойство("ПериодОстатков"), Реквизиты.ПериодОстатков,
		Новый Граница(Реквизиты.Ссылка.МоментВремени(), ВидГраницы.Исключая));
	ОстаткиРасходовУСН = ОстаткиРасходовУСН(ПериодОстатков, СчетаВложенийВоВнеоборотныеАктивыУСН, ОтборРасходов, Реквизиты);
	ОбщегоНазначенияБГУ.УпорядочитьТаблицуПоДокументу(ОстаткиРасходовУСН, "Партия", "ДатаДокументаПартии");
	
	// Распределим аккумулированные кап. вложения по объектам ОС и НМА.
	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ТаблицаОСиНМА.Колонки.Добавить("СуммаВал",                ОписаниеТипаСуммы);
	ТаблицаОСиНМА.Колонки.Добавить("СуммаРуб",                ОписаниеТипаСуммы);
	ТаблицаОСиНМА.Колонки.Добавить("СуммаНеУчитываетсяНУРуб", ОписаниеТипаСуммы);
	ТаблицаОСиНМА.Колонки.Добавить("СуммаЕНВДРуб",            ОписаниеТипаСуммы);
	ТаблицаОСиНМА.Колонки.Добавить("СуммаНДСРуб",             ОписаниеТипаСуммы);
	
	ТаблицаОСиНМА.Колонки.Добавить("БазаРаспределения", ОписаниеТипаСуммы);
	Для Каждого СтрокаОСиНМА Из ТаблицаОСиНМА Цикл
		СтрокаОСиНМА.БазаРаспределения = // Пропорционально сумме вложений, отнесенной на строку.
			СтрокаОСиНМА.СуммаМодернизации
			+ СтрокаОСиНМА.СуммаДемонтажа
			+ СтрокаОСиНМА.СуммаТранспортировки;
	КонецЦикла;
	
	Для Каждого ОстатокВложений Из ОстаткиРасходовУСН Цикл
		
		// Cуммы кап.вложений распределяем по модернизируемым объектам ОС и НМА.
		ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(ОстатокВложений.СуммаВал,
			ТаблицаОСиНМА, "СуммаВал", "БазаРаспределения");
		ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(ОстатокВложений.СуммаРуб,
			ТаблицаОСиНМА, "СуммаРуб", "БазаРаспределения");
		ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(ОстатокВложений.СуммаНеУчитываетсяНУРуб,
			ТаблицаОСиНМА, "СуммаНеУчитываетсяНУРуб", "БазаРаспределения");
		ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(ОстатокВложений.СуммаЕНВДРуб,
			ТаблицаОСиНМА, "СуммаЕНВДРуб", "БазаРаспределения");
		ОбщегоНазначенияБГУ.РаспределитьСуммуПоКолонкеТаблицы(ОстатокВложений.СуммаНДСРуб,
			ТаблицаОСиНМА, "СуммаНДСРуб", "БазаРаспределения");
		
		Для Каждого СтрокаОСиНМА Из ТаблицаОСиНМА Цикл
			
			ПорядокВключенияСтоимостиВСоставРасходовУСН = СтрокаОСиНМА.ПорядокВключенияСтоимостиВСоставРасходовУСН;
			
			Если ПорядокВключенияСтоимостиВСоставРасходовУСН =
					Перечисления.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН.ВключитьВСоставРасходовНаОСиНМА Тогда
				НоваяСтрока = ТаблицаАмортизируемогоИмущества.Добавить();
			Иначе
				НоваяСтрока = ТаблицаМодернизацииОСиНМА.Добавить();
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ОстатокВложений,
				"ИФО,КФО,КПС,Подразделение,Валюта,СчетРасчетов,Контрагент,Договор,ДокументРасчетов,ОтражениеВУСН");
			
			НоваяСтрока.СчетВложенийУСН = ОстатокВложений.СчетУчетаУСН;
			НоваяСтрока.КапВложенияУСН  = ОстатокВложений.РасходыУСН;
			НоваяСтрока.ОбъектВложений  = ОстатокВложений.СубконтоРасходов2;
			
			СвойстваСчетаВложений = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяСтрока.СчетВложенийУСН);
			Если СвойстваСчетаВложений.ВидСубконто3 = ПланыВидовХарактеристик.ВидыСубконто.ДокументыОплатыУСН Тогда
				НоваяСтрока.ДокументОплаты  = ОстатокВложений.СубконтоРасходов3;
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОСиНМА,
				"ИмяСписка,СинонимСписка,НомерСтроки,
				|СуммаВал,СуммаРуб,СуммаНеУчитываетсяНУРуб,СуммаЕНВДРуб,СуммаНДСРуб");
			
			Если ПорядокВключенияСтоимостиВСоставРасходовУСН =
					Перечисления.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН.ВключитьВСоставРасходовНаОСиНМА Тогда
				
				// Расходы УСН учитываем по новому объекту ОС, НМА, НПА.
				НоваяСтрока.ОсновноеСредство = СтрокаОСиНМА.ОсновноеСредство;
				
				// Заполним реквизиты для формирования новых элементов учета расходов УСН.
				НоваяСтрока.Партия               = Документ;
				НоваяСтрока.ИмяСпискаДокумента   = СтрокаОСиНМА.ИмяСписка;
				НоваяСтрока.НомерСтрокиДокумента = СтрокаОСиНМА.НомерСтроки;
				
				Если СтрокаОСиНМА.ОсновноеСредство.ВидНФА = Перечисления.ВидыНФА.НМА Тогда
					НоваяСтрока.ВидРасхода     = Перечисления.ВидыРасходовУСН.НМА;
					НоваяСтрока.ЭлементРасхода = СтрокаОСиНМА.ОсновноеСредство;
				Иначе
					НоваяСтрока.ВидРасхода     = Перечисления.ВидыРасходовУСН.ОС;
					Если ЗначениеЗаполнено(СтрокаОСиНМА.ИнвентарныйНомер) Тогда
						НоваяСтрока.ЭлементРасхода = СтрокаОСиНМА.ИнвентарныйНомер;
					Иначе
						НоваяСтрока.ЭлементРасхода = СтрокаОСиНМА.ОсновноеСредство;
					КонецЕсли;
				КонецЕсли;
				
			Иначе
			
				// Расходы УСН учитываем по тому же объекту вложений.
				НоваяСтрока.ОсновноеСредство = ОстатокВложений.СубконтоРасходов2;
				
				// Новые элементы учета расходов УСН не формируем.
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ОстатокВложений,
					"Партия,ИмяСпискаДокумента,НомерСтрокиДокумента,ВидРасхода,ЭлементРасхода,РасходыУСН");
				
			КонецЕсли;
			
			НоваяСтрока.СчетУчетаУСН = СчетРасходовУСНприПринятииКУчетуОсновныхСредствУСН(
				НоваяСтрока.СчетВложенийУСН,
				НоваяСтрока.ОсновноеСредство,
				СтрокаОСиНМА.СостояниеОС = Перечисления.СостоянияОС.ВведеноВЭксплуатацию,
				ПорядокВключенияСтоимостиВСоставРасходовУСН);
			
		КонецЦикла;
		
	КонецЦикла;
	
	СформироватьЭлементыУчетаРасходовУСН(Документ, ТаблицаАмортизируемогоИмущества);
	
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ТаблицаАмортизируемогоИмущества, ТаблицаМодернизацииОСиНМА);
	ТаблицаМодернизацииОСиНМА.Сортировать("ИмяСписка,НомерСтроки");
	
	Возврат ТаблицаМодернизацииОСиНМА;
	
КонецФункции

// Ввод в эксплуатацию ОС в УСН

// Подготавливает таблицу по документу ввода в эксплуатацию ОС (для целей УСН).
//
Функция ПодготовитьТаблицуВводВЭксплуатациюОсновныхСредствПоДокументу(Документ, Параметры = Неопределено) Экспорт
	
	ОписаниеТипаКоличества = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	
	ТаблицаДокумента = Новый ТаблицаЗначений;
	// Идентификация строки.
	ТаблицаДокумента.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ТаблицаДокумента.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ТаблицаДокумента.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	// Объект учета внеоборотных активов.
	ТаблицаДокумента.Колонки.Добавить("КФО",              Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ТаблицаДокумента.Колонки.Добавить("ОсновноеСредство", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ТаблицаДокумента.Колонки.Добавить("ИнвентарныйНомер", Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	ТаблицаДокумента.Колонки.Добавить("Количество",       ОписаниеТипаКоличества);
	
	Если Документ.ВидОперацииДокумента <> 0 Тогда
		Возврат ТаблицаДокумента; // "0" - ввод в эксплуатацию.
	КонецЕсли;
	
	Если НЕ УчетУСНВызовСервера.ПрименяетсяУСНДоходыМинусРасходы(Документ.Организация, Документ.Дата) Тогда
		Возврат ТаблицаДокумента;
	КонецЕсли;
	
	Если Параметры = Неопределено Тогда
		Параметры = Новый Структура;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "ОсновныеСредства",
		"НомерСтроки,КФО,ОсновноеСредство,ИнвентарныйНомер,Количество",
		Документ, Параметры);
	
	Запрос.Текст = Запрос.Текст +
	"ВЫБРАТЬ
	|	""ОсновныеСредства"" КАК ИмяСписка,
	|	""Основные средства"" КАК СинонимСписка,
	|	ОсновныеСредства.НомерСтроки КАК НомерСтроки,
	|	ОсновныеСредства.КФО КАК КФО,
	|	ОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ОсновныеСредства.Количество КАК Количество
	|ИЗ
	|	ТаблицаОсновныеСредства КАК ОсновныеСредства
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	ВводВЭкплуатациюОсновныхСредств = Запрос.Выполнить().Выгрузить();
	Для Каждого СтрокаДокумента Из ВводВЭкплуатациюОсновныхСредств Цикл
		НоваяСтрока = ТаблицаДокумента.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДокумента);
	КонецЦикла;
	
	Возврат ТаблицаДокумента;
	
КонецФункции

Функция ПустаяТаблицаВводВЭксплуатациюОсновныхСредствУСН() Экспорт

	ОписаниеТипаСуммы       = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТипаКоличества  = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3, ДопустимыйЗнак.Любой));
	ОписаниеТипаСубконто    = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	ОписаниеТипаВидСубконто = Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто");
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Идентификация строки.
	ПустаяТаблица.Колонки.Добавить("ИмяСписка",     ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("СинонимСписка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(50));
	ПустаяТаблица.Колонки.Добавить("НомерСтроки",   ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(5));
	
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	
	// Счет и аналитика учета расходов УСН на приобретение ОС.
	ПустаяТаблица.Колонки.Добавить("ОсновноеСредство",  Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ПустаяТаблица.Колонки.Добавить("СчетУчетаУСН",      Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("КорСчетУСН",        Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("РасходыУСН",        Новый ОписаниеТипов("СправочникСсылка.РасходыУСН"));
	ПустаяТаблица.Колонки.Добавить("ВидСубконтоРасходов2",  ОписаниеТипаВидСубконто);
	ПустаяТаблица.Колонки.Добавить("СубконтоРасходов2",     ОписаниеТипаСубконто);
	ПустаяТаблица.Колонки.Добавить("ВидСубконтоРасходов3",  ОписаниеТипаВидСубконто);
	ПустаяТаблица.Колонки.Добавить("СубконтоРасходов3",     ОписаниеТипаСубконто);
	
	// Количество и стоимость принимаемых вложений во внеоборотные активы.
	ПустаяТаблица.Колонки.Добавить("Количество",              ОписаниеТипаКоличества);
	ПустаяТаблица.Колонки.Добавить("Валюта",                  Новый ОписаниеТипов("СправочникСсылка.Валюты")); // Валюта расчетов.
	ПустаяТаблица.Колонки.Добавить("СуммаВал",                ОписаниеТипаСуммы); // Сумма в валюте расчетов.
	ПустаяТаблица.Колонки.Добавить("СуммаРуб",                ОписаниеТипаСуммы); // Сумма в рублях.
	ПустаяТаблица.Колонки.Добавить("СуммаНеУчитываетсяНУРуб", ОписаниеТипаСуммы); // Сумма в рублях.
	ПустаяТаблица.Колонки.Добавить("СуммаЕНВДРуб",            ОписаниеТипаСуммы); // Сумма в рублях.
	ПустаяТаблица.Колонки.Добавить("СуммаНДСРуб",             ОписаниеТипаСуммы); // Сумма НДС в рублях.
	
	Возврат ПустаяТаблица;

КонецФункции

Функция ТаблицаВводВЭксплуатациюОсновныхСредствУСН(ТаблицаОС, Документ, Реквизиты, Отказ) Экспорт
	
	ТаблицаВведенныхВЭксплуатациюОС = ПустаяТаблицаВводВЭксплуатациюОсновныхСредствУСН();
	
	Если НЕ УчетУСНВызовСервера.ПрименяетсяУСНДоходыМинусРасходы(Реквизиты.Организация, Реквизиты.Дата) Тогда
		Возврат ТаблицаВведенныхВЭксплуатациюОС;
	КонецЕсли;
	
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	
	// Получим все остатки расходов УСН по указанным в документе объектам ОС.
	СчетаНеВведенныхВЭксплуатациюОсновныхСредствУСН = БухгалтерскийУчет.СписокСчетов("У01.ВО,У01.В");
	
	ОтборРасходов = Новый Структура;
	ОтборРасходов.Вставить("СубконтоРасходов2", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
		ТаблицаОС.ВыгрузитьКолонку("ОсновноеСредство")));
	
	Если Реквизиты.ИспользоватьУчетПоИФО Тогда
		ОтборРасходов.Вставить("ИФО", Документ.ИФО);
	КонецЕсли;
	//Если Реквизиты.ИспользоватьУчетПоПодразделениям Тогда
	//	ОтборРасходов.Вставить("Подразделение", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
	//		ТаблицаОС.ВыгрузитьКолонку("Подразделение")));
	//КонецЕсли;
	ОтборРасходов.Вставить("КФО", ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(
		ТаблицаОС.ВыгрузитьКолонку("КФО")));
	
	ПериодОстатков = ?(Реквизиты.Свойство("ПериодОстатков"), Реквизиты.ПериодОстатков,
		Новый Граница(Реквизиты.Ссылка.МоментВремени(), ВидГраницы.Исключая));
	ОстаткиРасходовУСН = ОстаткиРасходовУСН(ПериодОстатков,
		СчетаНеВведенныхВЭксплуатациюОсновныхСредствУСН, ОтборРасходов, Реквизиты);
	ОбщегоНазначенияБГУ.УпорядочитьТаблицуПоДокументу(ОстаткиРасходовУСН, "Партия", "ДатаДокументаПартии");
	
	Для Каждого СтрокаОС Из ТаблицаОС Цикл
		
		Если СтрокаОС.Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Отбор = Новый Структура("КФО,СубконтоРасходов2",
			СтрокаОС.КФО, СтрокаОС.ОсновноеСредство);
		
		ОстаткиРасходовПоОбъектуОС = ОстаткиРасходовУСН.НайтиСтроки(Отбор);
		Для Каждого РасходУСН Из ОстаткиРасходовПоОбъектуОС Цикл
			
			НоваяСтрока = ТаблицаВведенныхВЭксплуатациюОС.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаОС,
				"ИмяСписка,СинонимСписка,НомерСтроки,ОсновноеСредство");
			ЗаполнитьЗначенияСвойств(НоваяСтрока, РасходУСН,
				"ИФО,КФО,КПС,Подразделение,СчетУчетаУСН,РасходыУСН,Валюта,
				|Количество,СуммаВал,СуммаРуб,СуммаНеУчитываетсяНУРуб,СуммаЕНВДРуб,СуммаНДСРуб");
			
			СвойстваСчетаУчетаУСН = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(РасходУСН.СчетУчетаУСН);
			НоваяСтрока.ВидСубконтоРасходов2 = СвойстваСчетаУчетаУСН.ВидСубконто1;
			НоваяСтрока.СубконтоРасходов2    = РасходУСН.СубконтоРасходов2;
			НоваяСтрока.ВидСубконтоРасходов3 = СвойстваСчетаУчетаУСН.ВидСубконто3;
			НоваяСтрока.СубконтоРасходов3    = РасходУСН.СубконтоРасходов3;
			
			НоваяСтрока.КорСчетУСН = СчетРасходовУСНприВводеВЭксплуатациюОсновныхСредствУСН(РасходУСН.СчетУчетаУСН);
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТаблицаВведенныхВЭксплуатациюОС;
	
КонецФункции

Функция СчетРасходовУСНприВводеВЭксплуатациюОсновныхСредствУСН(СчетУчетаУСН)
	
	КодСчетаУчетаУСН = Строка(СчетУчетаУСН);
	
	// ОС: не Введены в эксплуатацию, не Оплачены.
	Если Найти(КодСчетаУчетаУСН, "У01.ВО") Тогда
		
		Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У01.О"); // Не меняем статус оплаты.
		
	// ОС: не Введены в эксплуатацию, Оплачены.
	ИначеЕсли Найти(КодСчетаУчетаУСН, "У01.В") Тогда
		
		Возврат БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("У01.П"); // Не меняем статус оплаты.
		
	Иначе
		
		Возврат ПланыСчетов.ЕПСБУ.ПустаяСсылка();
		
	КонецЕсли;
	
КонецФункции

// Признание расходов на ОС и НМА

Функция ПустаяТаблицаПризнанныхРасходовНаПриобретениеОсновныхСредствУСН() Экспорт

	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	
	// Счет и аналитика учета расходов на ОС и НМА.
	ПустаяТаблица.Колонки.Добавить("СчетУчетаУСН",     Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("РасходыУСН",       Новый ОписаниеТипов("СправочникСсылка.РасходыУСН"));
	ПустаяТаблица.Колонки.Добавить("ОсновноеСредство", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ПустаяТаблица.Колонки.Добавить("ДокументОплаты",
		ПланыВидовХарактеристик.ВидыСубконто.ДокументыОплатыУСН.ТипЗначения);
	
	// Суммы расходов к списанию.
	ПустаяТаблица.Колонки.Добавить("СуммаРуб",                ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаНеУчитываетсяНУРуб", ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаЕНВДРуб",            ОписаниеТипаСуммы);
	ПустаяТаблица.Колонки.Добавить("СуммаНДСРуб",             ОписаниеТипаСуммы);
	
	Возврат ПустаяТаблица;

КонецФункции

Функция ТаблицаПризнанныхРасходовНаПриобретениеОсновныхСредствУСН(Реквизиты) Экспорт
	
	ТаблицаПризнанныхРасходов = ПустаяТаблицаПризнанныхРасходовНаПриобретениеОсновныхСредствУСН();
	
	Если НЕ УчетУСНВызовСервера.ПрименяетсяУСНДоходыМинусРасходы(Реквизиты.Организация, Реквизиты.Дата) Тогда
		Возврат ТаблицаПризнанныхРасходов;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОСиНМА.НомерСтроки,
	|	ОСиНМА.ИдСтроки КАК ИдСтроки,
	|	ОСиНМА.ИФО,
	|	ОСиНМА.КФО,
	|	ОСиНМА.КПС,
	|	ОСиНМА.Подразделение,
	|	ОСиНМА.ОсновноеСредство,
	|	ОСиНМА.ДокументОплаты
	|ПОМЕСТИТЬ ОСиНМА
	|ИЗ
	|	Документ.РасчетРасходовНаОСиНМАПриУСН.ОСиНМА КАК ОСиНМА
	|ГДЕ
	|	ОСиНМА.Ссылка = &Ссылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ИдСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПризнанныеРасходыУСН.НомерСтроки,
	|	ПризнанныеРасходыУСН.ИдСтроки КАК ИдСтроки,
	|	ПризнанныеРасходыУСН.СчетУчета,
	|	ПризнанныеРасходыУСН.РасходыУСН,
	|	ПризнанныеРасходыУСН.СписатьСумма,
	|	ПризнанныеРасходыУСН.СписатьНДС,
	|	ПризнанныеРасходыУСН.СписатьНеУчитываетсяНУ,
	|	ПризнанныеРасходыУСН.СписатьЕНВД
	|ПОМЕСТИТЬ ПризнанныеРасходыУСН
	|ИЗ
	|	Документ.РасчетРасходовНаОСиНМАПриУСН.ПризнанныеРасходыУСН КАК ПризнанныеРасходыУСН
	|ГДЕ
	|	ПризнанныеРасходыУСН.Ссылка = &Ссылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ИдСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОСиНМА.НомерСтроки КАК НомерСтрокиОС,
	|	ОСиНМА.ИдСтроки,
	|	ОСиНМА.ИФО,
	|	ОСиНМА.КФО,
	|	ОСиНМА.КПС,
	|	ОСиНМА.Подразделение,
	|	ОСиНМА.ОсновноеСредство,
	|	ОСиНМА.ДокументОплаты,
	|	ПризнанныеРасходыУСН.НомерСтроки КАК НомерСтрокиРасходов,
	|	ПризнанныеРасходыУСН.СчетУчета КАК СчетУчетаУСН,
	|	ПризнанныеРасходыУСН.РасходыУСН КАК РасходыУСН,
	|	ПризнанныеРасходыУСН.СписатьСумма,
	|	ПризнанныеРасходыУСН.СписатьНДС,
	|	ПризнанныеРасходыУСН.СписатьНеУчитываетсяНУ,
	|	ПризнанныеРасходыУСН.СписатьЕНВД
	|ИЗ
	|	ОСиНМА КАК ОСиНМА
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПризнанныеРасходыУСН КАК ПризнанныеРасходыУСН
	|		ПО ОСиНМА.ИдСтроки = ПризнанныеРасходыУСН.ИдСтроки
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтрокиОС,
	|	НомерСтрокиРасходов";
	Запрос.УстановитьПараметр("Ссылка", Реквизиты.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.СписатьСумма = 0
		   И Выборка.СписатьНДС = 0
		   И Выборка.СписатьНеУчитываетсяНУ = 0
		   И Выборка.СписатьЕНВД = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаПризнанныхРасходов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка,
			"ИФО,КФО,КПС,Подразделение,СчетУчетаУСН,РасходыУСН,ОсновноеСредство,ДокументОплаты");
		
		НоваяСтрока.СуммаРуб                = Выборка.СписатьСумма;
		НоваяСтрока.СуммаНДСРуб             = Выборка.СписатьНДС;
		НоваяСтрока.СуммаНеУчитываетсяНУРуб = Выборка.СписатьНеУчитываетсяНУ;
		НоваяСтрока.СуммаЕНВДРуб            = Выборка.СписатьЕНВД;
		
	КонецЦикла;
	
	Возврат ТаблицаПризнанныхРасходов;
	
КонецФункции

Процедура ПроверитьКорректностьЗаполненияТаблицыРасходовНаОСиНМА(ДокументОбъект, Отказ) Экспорт
	
	УчетнаяПолитика = Справочники.Организации.ПолучитьУчетнуюПолитику(
		ДокументОбъект.Организация, ДокументОбъект.Дата);
	Если НЕ УчетнаяПолитика.ПрименяетсяУСНДоходыМинусРасходы Тогда
		Возврат;
	КонецЕсли;
	
	МетаданныеТабЧастиОСиНМА = ДокументОбъект.Метаданные().ТабличныеЧасти.ОСиНМА;
	
	Для Каждого СтрокаОСиНМА Из ДокументОбъект.ОСиНМА Цикл
	
		Если СтрокаОСиНМА.РасходыПроизведеныДоПереходаНаУСН Тогда
			
			Если ЗначениеЗаполнено(СтрокаОСиНМА.ПервоначальнаяСтоимость) Тогда
				
				ТекстОшибки = НСтр("ru='
					|Графа 6 ""Первоначальная стоимость"" раздела II КУДиР не заполняется по ОС и НМА, приобретенным (изготовленным, сооруженным, созданным) до перехода на УСН.'");
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
					МетаданныеТабЧастиОСиНМА.Реквизиты.ПервоначальнаяСтоимость.Синоним,
					СтрокаОСиНМА.НомерСтроки,
					МетаданныеТабЧастиОСиНМА.Синоним,
					ТекстОшибки);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка,
					"ОСиНМА[" + Формат(СтрокаОСиНМА.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].ПервоначальнаяСтоимость", "Объект", Отказ);
				
			КонецЕсли;
			
		Иначе
			
			Если ЗначениеЗаполнено(СтрокаОСиНМА.СрокПолезногоИспользования) Тогда
				
				ТекстОшибки = НСтр("ru='
					|Графа 7 ""Срок полезного использования"" раздела II КУДиР не заполняется по ОС и НМА, приобретенным (изготовленным, сооруженным, созданным) в период применения УСН.'");
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
					МетаданныеТабЧастиОСиНМА.Реквизиты.СрокПолезногоИспользования.Синоним,
					СтрокаОСиНМА.НомерСтроки,
					МетаданныеТабЧастиОСиНМА.Синоним,
					ТекстОшибки);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка,
					"ОСиНМА[" + Формат(СтрокаОСиНМА.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].СрокПолезногоИспользования", "Объект", Отказ);
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаОСиНМА.ОстаточнаяСтоимость) Тогда
				
				ТекстОшибки = НСтр("ru='
					|Графа 8 ""Остаточная стоимость"" раздела II КУДиР не заполняется по ОС и НМА, приобретенным (изготовленным, сооруженным, созданным) в период применения УСН.'");
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
					МетаданныеТабЧастиОСиНМА.Реквизиты.ОстаточнаяСтоимость.Синоним,
					СтрокаОСиНМА.НомерСтроки,
					МетаданныеТабЧастиОСиНМА.Синоним,
					ТекстОшибки);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка,
					"ОСиНМА[" + Формат(СтрокаОСиНМА.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].ОстаточнаяСтоимость", "Объект", Отказ);
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаОСиНМА.РасходыПрошлыхПериодов) Тогда
				
				ТекстОшибки = НСтр("ru='
					|Графа 14 ""Включено в расходы за предыдущие налоговые периоды"" раздела II КУДиР не заполняется по ОС и НМА, приобретенным (изготовленным, сооруженным, созданным) в период применения УСН.'");
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
					МетаданныеТабЧастиОСиНМА.Реквизиты.РасходыПрошлыхПериодов.Синоним,
					СтрокаОСиНМА.НомерСтроки,
					МетаданныеТабЧастиОСиНМА.Синоним,
					ТекстОшибки);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка,
					"ОСиНМА[" + Формат(СтрокаОСиНМА.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].РасходыПрошлыхПериодов", "Объект", Отказ);
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаОСиНМА.ОставшаясяЧастьРасходов) Тогда
				
				ТекстОшибки = НСтр("ru='
					|Графа 15 ""Оставшая часть расходов"" раздела II КУДиР не заполняется по ОС и НМА, приобретенным (изготовленным, сооруженным, созданным) в период применения УСН.'");
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Корректность",
					МетаданныеТабЧастиОСиНМА.Реквизиты.ОставшаясяЧастьРасходов.Синоним,
					СтрокаОСиНМА.НомерСтроки,
					МетаданныеТабЧастиОСиНМА.Синоним,
					ТекстОшибки);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка,
					"ОСиНМА[" + Формат(СтрокаОСиНМА.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].ОставшаясяЧастьРасходов", "Объект", Отказ);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьУсловноеОформлениеПолейТаблицыРасходовНаОСиНМА(УсловноеОформление) Экспорт
	
	// Расходы произведены до перехода на УСН.
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ОСиНМАПервоначальнаяСтоимость");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
