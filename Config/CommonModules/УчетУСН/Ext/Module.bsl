	|	РасчетДолейСписания.КФО,
	|	РасчетДолейСписания.КПС,
	|	РасчетДолейСписания.Подразделение,
	|	РасчетДолейСписания.Номенклатура,
	|	РасчетДолейСписания.Партия
	|ПОМЕСТИТЬ РасчетДолейСписания
	|ИЗ
	|	Документ.СписаниеДопРасходовУСН.РасчетДолейСписания КАК РасчетДолейСписания
	|ГДЕ
	|	РасчетДолейСписания.Ссылка = &Ссылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ИдСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДопРасходыУСН.НомерСтроки,
	|	ДопРасходыУСН.ИдСтроки КАК ИдСтроки,
	|	ДопРасходыУСН.СчетУчета,
	|	ДопРасходыУСН.РасходыУСН,
	|	ДопРасходыУСН.Субконто3,
	|	ДопРасходыУСН.Валюта,
	|	ДопРасходыУСН.СписатьНаУСНСуммаВал,
	|	ДопРасходыУСН.СписатьНаУСНСумма,
	|	ДопРасходыУСН.СписатьНаУСНСуммаНДС,
	|	ДопРасходыУСН.СписатьНаУСНСуммаНеУчитываетсяНУ,
	|	ДопРасходыУСН.СписатьНаУСНСуммаЕНВД,
	|	ДопРасходыУСН.СписатьНаНеУчитываемыеСуммаВал,
	|	ДопРасходыУСН.СписатьНаНеУчитываемыеСумма,
	|	ДопРасходыУСН.СписатьНаНеУчитываемыеСуммаНДС,
	|	ДопРасходыУСН.СписатьНаНеУчитываемыеСуммаНеУчитываетсяНУ,
	|	ДопРасходыУСН.СписатьНаНеУчитываемыеСуммаЕНВД,
	|	ДопРасходыУСН.СписатьНаЕНВДСуммаВал,
	|	ДопРасходыУСН.СписатьНаЕНВДСумма,
	|	ДопРасходыУСН.СписатьНаЕНВДСуммаНДС,
	|	ДопРасходыУСН.СписатьНаЕНВДСуммаНеУчитываетсяНУ,
	|	ДопРасходыУСН.СписатьНаЕНВДСуммаЕНВД
	|ПОМЕСТИТЬ ДопРасходыУСН
	|ИЗ
	|	Документ.СписаниеДопРасходовУСН.ДопРасходыУСН КАК ДопРасходыУСН
	|ГДЕ
	|	ДопРасходыУСН.Ссылка = &Ссылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ИдСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РасчетДолейСписания.НомерСтроки КАК НомерСтрокиРасчета,
	|	РасчетДолейСписания.ИдСтроки,
	|	РасчетДолейСписания.ИФО,
	|	РасчетДолейСписания.КФО,
	|	РасчетДолейСписания.КПС,
	|	РасчетДолейСписания.Подразделение,
	|	РасчетДолейСписания.Номенклатура,
	|	РасчетДолейСписания.Партия,
	|	ДопРасходыУСН.НомерСтроки КАК НомерСтрокиРасходов,
	|	ДопРасходыУСН.СчетУчета КАК СчетУчетаУСН,
	|	ДопРасходыУСН.РасходыУСН КАК РасходыУСН,
	|	ДопРасходыУСН.Субконто3 КАК Субконто3,
	|	ДопРасходыУСН.Валюта КАК Валюта,
	|	ДопРасходыУСН.СписатьНаУСНСуммаВал,
	|	ДопРасходыУСН.СписатьНаУСНСумма,
	|	ДопРасходыУСН.СписатьНаУСНСуммаНДС,
	|	ДопРасходыУСН.СписатьНаУСНСуммаНеУчитываетсяНУ,
	|	ДопРасходыУСН.СписатьНаУСНСуммаЕНВД,
	|	ДопРасходыУСН.СписатьНаНеУчитываемыеСуммаВал,
	|	ДопРасходыУСН.СписатьНаНеУчитываемыеСумма,
	|	ДопРасходыУСН.СписатьНаНеУчитываемыеСуммаНДС,
	|	ДопРасходыУСН.СписатьНаНеУчитываемыеСуммаНеУчитываетсяНУ,
	|	ДопРасходыУСН.СписатьНаНеУчитываемыеСуммаЕНВД,
	|	ДопРасходыУСН.СписатьНаЕНВДСуммаВал,
	|	ДопРасходыУСН.СписатьНаЕНВДСумма,
	|	ДопРасходыУСН.СписатьНаЕНВДСуммаНДС,
	|	ДопРасходыУСН.СписатьНаЕНВДСуммаНеУчитываетсяНУ,
	|	ДопРасходыУСН.СписатьНаЕНВДСуммаЕНВД
	|ИЗ
	|	РасчетДолейСписания КАК РасчетДолейСписания
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДопРасходыУСН КАК ДопРасходыУСН
	|		ПО РасчетДолейСписания.ИдСтроки = ДопРасходыУСН.ИдСтроки
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтрокиРасчета,
	|	НомерСтрокиРасходов";
	Запрос.УстановитьПараметр("Ссылка", Реквизиты.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ДобавитьСтрокуСписанияДопРасходовУСН(ТаблицаСписаниеДопРасходов, Выборка,
			Выборка.СписатьНаУСНСуммаВал,
			Выборка.СписатьНаУСНСумма,
			Выборка.СписатьНаУСНСуммаНДС,
			Выборка.СписатьНаУСНСуммаНеУчитываетсяНУ,
			Выборка.СписатьНаУСНСуммаЕНВД,
			Перечисления.ОтражениеВУСН.Принимаются);
		
		ДобавитьСтрокуСписанияДопРасходовУСН(ТаблицаСписаниеДопРасходов, Выборка,
			Выборка.СписатьНаНеУчитываемыеСуммаВал,
			Выборка.СписатьНаНеУчитываемыеСумма,
			Выборка.СписатьНаНеУчитываемыеСуммаНДС,
			Выборка.СписатьНаНеУчитываемыеСуммаНеУчитываетсяНУ,
			Выборка.СписатьНаНеУчитываемыеСуммаЕНВД,
			Перечисления.ОтражениеВУСН.НеПринимаются);
		
		ДобавитьСтрокуСписанияДопРасходовУСН(ТаблицаСписаниеДопРасходов, Выборка,
			Выборка.СписатьНаЕНВДСуммаВал,
			Выборка.СписатьНаЕНВДСумма,
			Выборка.СписатьНаЕНВДСуммаНДС,
			Выборка.СписатьНаЕНВДСуммаНеУчитываетсяНУ,
			Выборка.СписатьНаЕНВДСуммаЕНВД,
			Перечисления.ОтражениеВУСН.ОсобыйПорядок);
		
	КонецЦикла;
	
	Возврат ТаблицаСписаниеДопРасходов;
	
КонецФункции

Процедура ДобавитьСтрокуСписанияДопРасходовУСН(ТаблицаСписаниеДопРасходов, Выборка,
				СуммаВал, Сумма, СуммаНДС, СуммаНеУчитываетсяНУ, СуммаЕНВД, ОтражениеВУСН)
	
	Если СуммаВал = 0
	   И Сумма = 0
	   И СуммаНДС = 0
	   И СуммаНеУчитываетсяНУ = 0
	   И СуммаЕНВД = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СписаниеДопРасходов = ТаблицаСписаниеДопРасходов.Добавить();
	ЗаполнитьЗначенияСвойств(СписаниеДопРасходов, Выборка,
		"ИФО,КФО,КПС,Подразделение,СчетУчетаУСН,РасходыУСН,Партия,Валюта");
	
	СвойстваСчетаУСН = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Выборка.СчетУчетаУСН);
	Если СвойстваСчетаУСН.ВидСубконто3 = ПланыВидовХарактеристик.ВидыСубконто.ДокументыОплатыУСН Тогда
		СписаниеДопРасходов.ДокументОплаты = Выборка.Субконто3;
	КонецЕсли;
	
	СписаниеДопРасходов.СуммаВал                = СуммаВал;
	СписаниеДопРасходов.СуммаРуб                = Сумма;
	СписаниеДопРасходов.СуммаНДСРуб             = СуммаНДС;
	СписаниеДопРасходов.СуммаНеУчитываетсяНУРуб = СуммаНеУчитываетсяНУ;
	СписаниеДопРасходов.СуммаЕНВДРуб            = СуммаЕНВД;
	
	СписаниеДопРасходов.ОтражениеВУСН = ОтражениеВУСН;

КонецПроцедуры

// Распределение расходов по видам деятельности

Функция ПустаяТаблицаРаспределениеРасходовПоВидамДеятельностиУСН() Экспорт

	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	ОписаниеТиповСубконто = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("ИФО",           Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	ПустаяТаблица.Колонки.Добавить("КФО",           Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",           Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	
	// Счет и аналитика учета доп. расходов.
	ПустаяТаблица.Колонки.Добавить("СчетУчетаУСН",  Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("РасходыУСН",    Новый ОписаниеТипов("СправочникСсылка.РасходыУСН"));
	ПустаяТаблица.Колонки.Добавить("Субконто1",     ОписаниеТиповСубконто);
	ПустаяТаблица.Колонки.Добавить("ДокументОплаты",
		ПланыВидовХарактеристик.ВидыСубконто.ДокументыОплатыУСН.ТипЗначения);
	
	// Суммы доп. расходов к списанию.
	ПустаяТаблица.Колонки.Добавить("СуммаРуб",                ОписаниеТипаСуммы); // Сумма без НДС в рублях.
	ПустаяТаблица.Колонки.Добавить("СуммаНеУчитываетсяНУРуб", ОписаниеТипаСуммы); // Сумма с НДС в рублях.
	ПустаяТаблица.Колонки.Добавить("СуммаЕНВДРуб",            ОписаниеТипаСуммы); // Сумма с НДС в рублях.
	ПустаяТаблица.Колонки.Добавить("СуммаНДСРуб",             ОписаниеТипаСуммы); // Сумма НДС в рублях.
	
	// Порядок отражения в налоговом учете при УСН.
	ПустаяТаблица.Колонки.Добавить("ОтражениеВУСН", Новый ОписаниеТипов("ПеречислениеСсылка.ОтражениеВУСН"));
	
	Возврат ПустаяТаблица;

КонецФункции

Функция ТаблицаРаспределениеРасходовПоВидамДеятельностиУСН(Реквизиты) Экспорт
	
	ТаблицаРаспределениеРасходов = ПустаяТаблицаРаспределениеРасходовПоВидамДеятельностиУСН();
	
	УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Реквизиты.Организация, Реквизиты.Дата);
	Если НЕ УчетнаяПолитика.ПрименяетсяУСНДоходыМинусРасходы Тогда
		Возврат ТаблицаРаспределениеРасходов;
	КонецЕсли;
	
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
