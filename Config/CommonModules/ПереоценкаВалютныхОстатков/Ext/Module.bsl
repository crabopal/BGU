
#Область ПрограммныйИнтерфейс

Процедура ВыполнитьПереоценкуВалютныхОстатков() Экспорт
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания();
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет") Тогда
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(ИмяПользователя()) Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	
	ИмяСобытия = НСтр("ru = 'Переоценка валютных остатков.'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка());
	
	ЗаписьЖурналаРегистрации(
		ИмяСобытия,
		УровеньЖурналаРегистрации.Информация,
		,
		,
		НСтр("ru = 'Начата регламентная переоценка валютных остатков.'"));
	
	ПриПереоценкеВозниклиОшибки = Неопределено;
	ОписаниеОшибок = "";
	
	ПереоценитьВалютныеОстатки(ПриПереоценкеВозниклиОшибки, ОписаниеОшибок);
	
	Если ПриПереоценкеВозниклиОшибки Тогда
		ОписаниеПричин = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Во время регламентного задания переоценки валютных остатков возникли ошибки: %1'"), ОписаниеОшибок);
		
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,
			УровеньЖурналаРегистрации.Предупреждение,
			, 
			,
			ОписаниеПричин);
	Иначе
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,
			УровеньЖурналаРегистрации.Информация,
			,
			,
			НСтр("ru = 'Завершена регламентная переоценка валютных остатков.'"));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

Процедура ПереоценитьВалютныеОстатки(Отказ, ОписаниеОшибок)
	Отказ = Не КурсыВалютЗагружены();
	
	Если Отказ Тогда
		ОписаниеОшибок = НСтр("ru='не загружены актуальные курсы валют.'");
		Возврат;
	КонецЕсли;
	
	Организации = Справочники.Организации.Выбрать();
	
	Пока Организации.Следующий() Цикл
		ДокОбъект = Документы.ПереоценкаВалютныхОстатков.СоздатьДокумент();
	
		ДокОбъект.Дата = ТекущаяДатаСеанса();
		ДокОбъект.Организация = Организации.Ссылка;
		
		Документы.ПереоценкаВалютныхОстатков.СформироватьДанныеДляПереоценки(ДокОбъект);
		
		Если ДокОбъект.ТаблицаПереоценки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ДокОбъект.ЭтоНовый() Тогда
			ДокОбъект.УстановитьСсылкуНового(Документы.ПереоценкаВалютныхОстатков.ПолучитьСсылку());
			ДокСсылка = ДокОбъект.ПолучитьСсылкуНового();
		Иначе
			ДокСсылка = ДокОбъект.Ссылка;
		КонецЕсли;
		
		ИдентификаторДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(ДокСсылка));
		ТиповаяОперация = БухгалтерскиеОперацииСервер.ТиповаяОперацияПоУмолчанию(ИдентификаторДокумента);
		
		Если Не ЗначениеЗаполнено(ТиповаяОперация) Тогда
			Отказ = Истина;
			ОписаниеОшибок = НСтр("ru='не найдена типовая операция документа переоценки валютных остатков.'");
			Возврат;
		КонецЕсли;
		
		ДополнительныеРеквизиты = Справочники.ТиповыеОперации.ПустаяСтруктураДопРеквизитовОперации(ТиповаяОперация);
		ЗначенияДопРеквизитов = БухгалтерскиеОперацииСервер.РеквизитыТиповойОперацииПоУмолчанию(ИдентификаторДокумента, ТиповаяОперация, ДокОбъект.Организация);
		ЗаполнитьЗначенияСвойств(ДополнительныеРеквизиты, ЗначенияДопРеквизитов);
		
		БухгалтерскиеОперацииСервер.ДобавитьДанныеДляПроведения(ДокОбъект, ТиповаяОперация, ДополнительныеРеквизиты);
		
		Попытка
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
			
			Отказ = Истина;
			ОписаниеОшибок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='не удалось провести документ переоценки валютных остатков №%1 от %2'"),
																					ДокОбъект.Номер,
																					Формат(ДокОбъект.Дата, "ДЛФ=D"));
			Возврат;
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

Функция КурсыВалютЗагружены()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Валюты.Ссылка
	               |ИЗ
	               |	РегистрСведений.КурсыВалют.СрезПоследних КАК КурсыВалют
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Валюты КАК Валюты
	               |		ПО КурсыВалют.Валюта = Валюты.Ссылка
	               |ГДЕ
	               |	КурсыВалют.Период МЕЖДУ &ДатаНачала И &ДатаОкончания"; 
				   
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ТекущаяДатаСеанса()));
	
	Возврат Запрос.Выполнить().Выгрузить().Количество() > 0;
КонецФункции
