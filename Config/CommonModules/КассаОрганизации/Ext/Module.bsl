#Область ПрограммныйИнтерфейс

// Проверяет равенство суммы в шапке документа и в таблице "Расшифровка".
// Вызывается из процедуры "ОбработкаПроверкиЗаполнения".
// Параметры:
// Объект - ДокументОбъект.ВедомостьНаВыдачуДенегИзКассы,
//			ДокументОбъект.ПриходныйКассовыйОрдер,
//			ДокументОбъект.ПриходныйОрдерФондовый,
//			ДокументОбъект.РасходныйКассовыйОрдер,
//			ДокументОбъект.РасходныйОрдерФондовый - проверяемый документ.
// ИмяТЧ - Строка - имя табличной части.
// Отказ - Булево - Возвращаемый параметр.Устанавливается в "Истина", если
//					сумма в шапке документа не равна сумме в таблице документа.
//
Процедура ПроверитьКорректностьЗаполненияТаблицыКассовогоДокумента(Объект, ИмяТЧ = "РасшифровкаПлатежа", Отказ) Экспорт

	Если Объект.СуммаДокумента <> Объект[ИмяТЧ].Итог("Сумма") Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Корректность",НСтр("ru = 'Сумма'"),,,
			СтрШаблон(НСтр("ru = 'Сумма документа не совпадает с суммой в таблице ""%1"".'"),
			?(ИмяТЧ = "РасшифровкаПлатежа", НСтр("ru = 'Расшифровка платежа'"), НСтр("ru = 'Расшифровка'"))));
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,, "Объект.СуммаДокумента",, Отказ);
	КонецЕсли;

КонецПроцедуры

// Возвращает номер текущего листа кассовой книги 
// 
// Возвращаемое значение: 
// Число. Номер текущего листа кассовой книги
//
// Параметры:
//  ТекущийЛист - ДокументОбъект.ЛистКассовойКниги, 
//                ДокументОбъект.ЛистКассовойКнигиФондовый
//  
Функция ПолучитьНомерТекущегоЛистаКассовойКниги(ТекущийЛист) Экспорт
	
	ИмяОбъекта = ТекущийЛист.Метаданные().Имя;
		
	Запрос=Новый Запрос;
	
	Запрос.УстановитьПараметр("Организация",		ТекущийЛист.Организация);
	Запрос.УстановитьПараметр("Подразделение",		ТекущийЛист.Подразделение);
	Запрос.УстановитьПараметр("ЕстьПодразделение",	ЗначениеЗаполнено(ТекущийЛист.Подразделение));
	Запрос.УстановитьПараметр("ДатаНачала",			НачалоГода(ТекущийЛист.Дата));
	Запрос.УстановитьПараметр("ДатаКонца",			ТекущийЛист.Дата);
	Запрос.УстановитьПараметр("Ссылка",				ТекущийЛист.Ссылка);
	
	
	Если НЕ ПолучитьФункциональнуюОпцию("ФондоваяКнигаОтдельноОтДенежной") Тогда
		
		Запрос.Текст="ВЫБРАТЬ ПЕРВЫЕ 1
		|	ВложенныйЗапрос.НомерЛиста КАК НомерЛиста,
		|	ВложенныйЗапрос.Ссылка.КоличествоЛистов КАК КоличествоЛистов
		|ИЗ
		|	(ВЫБРАТЬ
		|		ЛистКассовойКнигиФондовый.НомерЛиста КАК НомерЛиста,
		|		ЛистКассовойКнигиФондовый.Ссылка КАК Ссылка
		|	ИЗ
		|		Документ.ЛистКассовойКнигиФондовый КАК ЛистКассовойКнигиФондовый
		|	ГДЕ
		|		ЛистКассовойКнигиФондовый.Организация = &Организация
		|		И ЛистКассовойКнигиФондовый.Дата МЕЖДУ &ДатаНачала И &ДатаКонца
		|		И ЛистКассовойКнигиФондовый.Проведен
		|		И (&ЕстьПодразделение
		|					И ЛистКассовойКнигиФондовый.Подразделение = &Подразделение
		|				ИЛИ НЕ &ЕстьПодразделение
		|					И (ЛистКассовойКнигиФондовый.Подразделение ЕСТЬ NULL 
		|						ИЛИ ЛистКассовойКнигиФондовый.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)))
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ЛистКассовойКнигиФондовый.НомерЛиста,
		|		ЛистКассовойКнигиФондовый.Ссылка
		|	ИЗ
		|		Документ.ЛистКассовойКнигиФондовый_52н КАК ЛистКассовойКнигиФондовый
		|	ГДЕ
		|		ЛистКассовойКнигиФондовый.Организация = &Организация
		|		И ЛистКассовойКнигиФондовый.Дата МЕЖДУ &ДатаНачала И &ДатаКонца
		|		И ЛистКассовойКнигиФондовый.Проведен
		|		И (&ЕстьПодразделение
		|					И ЛистКассовойКнигиФондовый.Подразделение = &Подразделение
		|				ИЛИ НЕ &ЕстьПодразделение
		|					И (ЛистКассовойКнигиФондовый.Подразделение ЕСТЬ NULL 
		|						ИЛИ ЛистКассовойКнигиФондовый.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)))
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ЛистКассовойКниги.НомерЛиста,
		|		ЛистКассовойКниги.Ссылка
		|	ИЗ
		|		Документ.ЛистКассовойКниги КАК ЛистКассовойКниги
		|	ГДЕ
		|		ЛистКассовойКниги.Организация = &Организация
		|		И (&ЕстьПодразделение
		|					И ЛистКассовойКниги.Подразделение = &Подразделение
		|				ИЛИ НЕ &ЕстьПодразделение
		|					И (ЛистКассовойКниги.Подразделение ЕСТЬ NULL 
		|						ИЛИ ЛистКассовойКниги.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)))
		|		И ЛистКассовойКниги.Дата МЕЖДУ &ДатаНачала И &ДатаКонца
		|		И ЛистКассовойКниги.Проведен
		|		И ЛистКассовойКниги.Ссылка <> &Ссылка
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ЛистКассовойКниги.НомерЛиста,
		|		ЛистКассовойКниги.Ссылка
		|	ИЗ
		|		Документ.ЛистКассовойКниги_52н КАК ЛистКассовойКниги
		|	ГДЕ
		|		ЛистКассовойКниги.Организация = &Организация
		|		И (&ЕстьПодразделение
		|					И ЛистКассовойКниги.Подразделение = &Подразделение
		|				ИЛИ НЕ &ЕстьПодразделение
		|					И (ЛистКассовойКниги.Подразделение ЕСТЬ NULL 
		|						ИЛИ ЛистКассовойКниги.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)))
		|		И ЛистКассовойКниги.Дата МЕЖДУ &ДатаНачала И &ДатаКонца
		|		И ЛистКассовойКниги.Проведен
		|		И ЛистКассовойКниги.Ссылка <> &Ссылка) КАК ВложенныйЗапрос
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерЛиста УБЫВ";
		
	Иначе
		
		ЗапросТекст="ВЫБРАТЬ ПЕРВЫЕ 1
		|	ВложенныйЗапрос.НомерЛиста КАК НомерЛиста,
		|	ВложенныйЗапрос.Ссылка.КоличествоЛистов КАК КоличествоЛистов
		|ИЗ
		|	(ВЫБРАТЬ
		|		ЛистКассовойКнигиФондовый.НомерЛиста КАК НомерЛиста,
		|		ЛистКассовойКнигиФондовый.Ссылка КАК Ссылка
		|	ИЗ
		|		&ДокументЛистКассовойКниги КАК ЛистКассовойКнигиФондовый
		|	ГДЕ
		|		ЛистКассовойКнигиФондовый.Организация = &Организация
		|		И ЛистКассовойКнигиФондовый.Дата МЕЖДУ &ДатаНачала И &ДатаКонца
		|		И ЛистКассовойКнигиФондовый.Проведен
		|       И ЛистКассовойКнигиФондовый.Ссылка <> &Ссылка
		|		И (&ЕстьПодразделение
		|					И ЛистКассовойКнигиФондовый.Подразделение = &Подразделение
		|				ИЛИ НЕ &ЕстьПодразделение
		|					И (ЛистКассовойКнигиФондовый.Подразделение ЕСТЬ NULL 
		|						ИЛИ ЛистКассовойКнигиФондовый.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)))
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ЛистКассовойКнигиФондовый.НомерЛиста,
		|		ЛистКассовойКнигиФондовый.Ссылка
		|	ИЗ
		|		&ДокументЛистКассовойКниги_52н КАК ЛистКассовойКнигиФондовый
		|	ГДЕ
		|		ЛистКассовойКнигиФондовый.Организация = &Организация
		|		И ЛистКассовойКнигиФондовый.Дата МЕЖДУ &ДатаНачала И &ДатаКонца
		|		И ЛистКассовойКнигиФондовый.Проведен
		|       И ЛистКассовойКнигиФондовый.Ссылка <> &Ссылка
		|		И (&ЕстьПодразделение
		|					И ЛистКассовойКнигиФондовый.Подразделение = &Подразделение
		|				ИЛИ НЕ &ЕстьПодразделение
		|					И (ЛистКассовойКнигиФондовый.Подразделение ЕСТЬ NULL 
		|						ИЛИ ЛистКассовойКнигиФондовый.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)))) КАК ВложенныйЗапрос
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерЛиста УБЫВ";
		
		Если Найти(ИмяОбъекта, "Фондовый") = 0 Тогда
			 ЗапросТекст = СтрЗаменить(ЗапросТекст , "&ДокументЛистКассовойКниги ", "Документ.ЛистКассовойКниги ");
			 ЗапросТекст = СтрЗаменить(ЗапросТекст , "&ДокументЛистКассовойКниги_52н ", "Документ.ЛистКассовойКниги_52н ");
		 Иначе
			 ЗапросТекст = СтрЗаменить(ЗапросТекст , "&ДокументЛистКассовойКниги ", "Документ.ЛистКассовойКнигиФондовый ");
			 ЗапросТекст = СтрЗаменить(ЗапросТекст , "&ДокументЛистКассовойКниги_52н ", "Документ.ЛистКассовойКнигиФондовый_52н ");
		КонецЕсли;	 
		
		Запрос.Текст=ЗапросТекст;
		
	КонецЕсли;
				 
	Выборка=Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Макс((Выборка.НомерЛиста + Выборка.КоличествоЛистов), 0);
	КонецЕсли;
	
	Возврат 1;
	
КонецФункции

//Заполняет строки документа Отчет кассира по фондовой кассе. 
// 
// Параметры: 
// ОтчетКассира - ДокументОбъект.ЛистКассовойКниги, 
//                ДокументОбъект.ЛистКассовойКнигиФондовый
// 
Процедура ЗаполнитьОтчетКассираФондовый(ОтчетКассира) Экспорт
	
	Если ОтчетКассира.ЭтоНовый() Тогда
		ОтчетКассира.УстановитьВремя();
	КонецЕсли;
	
	ОтчетКассира.НомерЛиста = ПолучитьНомерТекущегоЛистаКассовойКниги(ОтчетКассира);
	
	ОтчетКассира.КоличествоЛистов = 1;
	
	ОрганизацииДляОтбора = Справочники.Организации.ВсеСубъектыУчетаПолномочий(ОтчетКассира.Организация);
		
	Запрос=Новый Запрос;
	
	Запрос.УстановитьПараметр("Дата",				НачалоДня(ОтчетКассира.Дата));
	Запрос.УстановитьПараметр("НачДата",			НачалоДня(ОтчетКассира.Дата));
	Запрос.УстановитьПараметр("КонДата",			КонецДня(ОтчетКассира.Дата));
	Запрос.УстановитьПараметр("Организация",		ОрганизацииДляОтбора);
	Запрос.УстановитьПараметр("Подразделение",		ОтчетКассира.Подразделение);
	Запрос.УстановитьПараметр("ЕстьПодразделение",	ЗначениеЗаполнено(ОтчетКассира.Подразделение));
	
	// ОСТАТКИ НА НАЧАЛО ДНЯ
	
	Запрос.Текст="
	|ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(ВложенныйЗапрос.ОстатокБюджет), 0) КАК НачалоДняБюджет,
	|	ЕСТЬNULL(СУММА(ВложенныйЗапрос.ОстатокВнебюджет), 0) КАК НачалоДняВнеБюдж,
	|	ЕСТЬNULL(СУММА(ВложенныйЗапрос.ОстатокУчреждение), 0) КАК НачалоДняУчреждение,
	|	ЕСТЬNULL(СУММА(ВложенныйЗапрос.ОстатокВремРасп), 0) КАК НачалоДняВремРасп
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВЫБОР
	|			КОГДА ДенежныеДокументыОстатки.КФО = ЗНАЧЕНИЕ(Перечисление.КВД.Бюджет)
	|				ТОГДА ДенежныеДокументыОстатки.СуммаОстаток
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК ОстатокБюджет,
	|		ВЫБОР
	|			КОГДА ДенежныеДокументыОстатки.КФО <> ЗНАЧЕНИЕ(Перечисление.КВД.Бюджет)
	|				ТОГДА ДенежныеДокументыОстатки.СуммаОстаток
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК ОстатокВнебюджет,
	|		ВЫБОР
	|			КОГДА ДенежныеДокументыОстатки.КФО <> ЗНАЧЕНИЕ(Перечисление.КВД.ВременноеРаспоряжение)
	|				ТОГДА ДенежныеДокументыОстатки.СуммаОстаток
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК ОстатокУчреждение,
	|		ВЫБОР
	|			КОГДА ДенежныеДокументыОстатки.КФО = ЗНАЧЕНИЕ(Перечисление.КВД.ВременноеРаспоряжение)
	|				ТОГДА ДенежныеДокументыОстатки.СуммаОстаток
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК ОстатокВремРасп
	|	ИЗ
	|		РегистрНакопления.ДенежныеДокументы.Остатки(&Дата, Организация В (&Организация)) КАК ДенежныеДокументыОстатки
	|	ГДЕ
	|		(&ЕстьПодразделение
	|					И ДенежныеДокументыОстатки.Подразделение = &Подразделение
	|				ИЛИ НЕ &ЕстьПодразделение
	|					И (ДенежныеДокументыОстатки.Подразделение ЕСТЬ NULL 
	|						ИЛИ ДенежныеДокументыОстатки.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)))) КАК ВложенныйЗапрос";
				 
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	ЗаполнитьЗначенияСвойств(ОтчетКассира, Выборка);
	
	// ДОКУМЕНТЫ ЗА ДЕНЬ

	Если ОтчетКассира.ВыводитьКаждуюПроводку Тогда
		
		Запрос.Текст ="ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РасходныйКассовыйОрдер.Ссылка КАК КассовыйДокумент,
		|	ПОДСТРОКА(РасходныйКассовыйОрдер.Выдать, 1, 1000) КАК ОтКогоКому,
		|	НАЧАЛОПЕРИОДА(РасходныйКассовыйОрдер.Дата, ДЕНЬ) КАК Дата,
		|	РасходныйКассовыйОрдер.КорСчет КАК КорСчет,
		|	РасходныйКассовыйОрдер.Дата КАК ДатаПорядка,
		|	РасходныйКассовыйОрдер.Номер КАК Номер
		|ПОМЕСТИТЬ Документы
		|ИЗ
		|	Документ.РасходныйОрдерФондовый КАК РасходныйКассовыйОрдер
		|ГДЕ
		|	РасходныйКассовыйОрдер.Организация В (&Организация)
		|	И (&ЕстьПодразделение
		|				И РасходныйКассовыйОрдер.Подразделение = &Подразделение
		|			ИЛИ НЕ &ЕстьПодразделение
		|				И (РасходныйКассовыйОрдер.Подразделение ЕСТЬ NULL 
		|					ИЛИ РасходныйКассовыйОрдер.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
		|					ИЛИ НЕ РасходныйКассовыйОрдер.Подразделение.ВедетсяКассоваяКнига))
		|	И РасходныйКассовыйОрдер.Дата МЕЖДУ &НачДата И &КонДата
		|	И РасходныйКассовыйОрдер.Проведен
		|	И РасходныйКассовыйОрдер.Оплачено
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПриходныйКассовыйОрдер.Ссылка,
		|	ПОДСТРОКА(ПриходныйКассовыйОрдер.Ссылка.ПринятоОт, 1, 1000),
		|	НАЧАЛОПЕРИОДА(ПриходныйКассовыйОрдер.Дата, ДЕНЬ),
		|	ПриходныйКассовыйОрдер.КорСчет,
		|	ПриходныйКассовыйОрдер.Дата,
		|	ПриходныйКассовыйОрдер.Номер
		|ИЗ
		|	Документ.ПриходныйОрдерФондовый КАК ПриходныйКассовыйОрдер
		|ГДЕ
		|	ПриходныйКассовыйОрдер.Организация В (&Организация)
		|	И (&ЕстьПодразделение
		|				И ПриходныйКассовыйОрдер.Подразделение = &Подразделение
		|			ИЛИ НЕ &ЕстьПодразделение
		|				И (ПриходныйКассовыйОрдер.Подразделение ЕСТЬ NULL 
		|					ИЛИ ПриходныйКассовыйОрдер.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
