	|	ДолжныБытьЛисты.Фондовый КАК Фондовый,
	|	СУММА(ДолжныБытьЛисты.НачОстУчреждениеУч) КАК НачОстУчреждениеУч,
	|	СУММА(ДолжныБытьЛисты.НачОстВремРаспУч) КАК НачОстВремРаспУч,
	|	СУММА(ДолжныБытьЛисты.ПриходУчреждениеУч) КАК ПриходУчреждениеУч,
	|	СУММА(ДолжныБытьЛисты.ПриходВремРаспУч) КАК ПриходВремРаспУч,
	|	СУММА(ДолжныБытьЛисты.РасходУчреждениеУч) КАК РасходУчреждениеУч,
	|	СУММА(ДолжныБытьЛисты.РасходВремРаспУч) КАК РасходВремРаспУч,
	|	СУММА(ДолжныБытьЛисты.КонОстУчреждениеУч) КАК КонОстУчреждениеУч,
	|	СУММА(ДолжныБытьЛисты.КонОстВремРаспУч) КАК КонОстВремРаспУч,
	|	Листы.Ссылка КАК ЛистКассовойКниги,
	|	СУММА(ЕСТЬNULL(Листы.КонОстУчреждение, 0)) КАК КонОстУчреждение,
	|	СУММА(ЕСТЬNULL(Листы.КонОстВремРасп, 0)) КАК КонОстВремРасп,
	|	СУММА(ЕСТЬNULL(Листы.НачОстУчреждение, 0)) КАК НачОстУчреждение,
	|	СУММА(ЕСТЬNULL(Листы.НачОстВремРасп, 0)) КАК НачОстВремРасп,
	|	СУММА(ЕСТЬNULL(Листы.ПриходУчреждение, 0)) КАК ПриходУчреждение,
	|	СУММА(ЕСТЬNULL(Листы.РасходУчреждение, 0)) КАК РасходУчреждение,
	|	СУММА(ЕСТЬNULL(Листы.ПриходВремРасп, 0)) КАК ПриходВремРасп,
	|	СУММА(ЕСТЬNULL(Листы.РасходВремРасп, 0)) КАК РасходВремРасп,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Листы.ПриходУчреждение, 0) <> ЕСТЬNULL(ДолжныБытьЛисты.ПриходУчреждениеУч, 0)
	|				ИЛИ ЕСТЬNULL(Листы.РасходУчреждение, 0) <> ЕСТЬNULL(ДолжныБытьЛисты.РасходУчреждениеУч, 0)
	|				ИЛИ ЕСТЬNULL(Листы.ПриходВремРасп, 0) <> ЕСТЬNULL(ДолжныБытьЛисты.ПриходВремРаспУч, 0)
	|				ИЛИ ЕСТЬNULL(Листы.РасходВремРасп, 0) <> ЕСТЬNULL(ДолжныБытьЛисты.РасходВремРаспУч, 0)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Расхождения
	|ИЗ
	|	ДолжныБытьЛисты КАК ДолжныБытьЛисты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Листы КАК Листы
	|		ПО ДолжныБытьЛисты.Дата = Листы.Дата
	|			И ДолжныБытьЛисты.Валюта = Листы.ВалютаДокумента
	|			И ДолжныБытьЛисты.Фондовый = Листы.Фондовый
	|
	|СГРУППИРОВАТЬ ПО
	|	ДолжныБытьЛисты.Дата,
	|	ДолжныБытьЛисты.Валюта,
	|	ДолжныБытьЛисты.Фондовый,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Листы.ПриходУчреждение, 0) <> ЕСТЬNULL(ДолжныБытьЛисты.ПриходУчреждениеУч, 0)
	|				ИЛИ ЕСТЬNULL(Листы.РасходУчреждение, 0) <> ЕСТЬNULL(ДолжныБытьЛисты.РасходУчреждениеУч, 0)
	|				ИЛИ ЕСТЬNULL(Листы.ПриходВремРасп, 0) <> ЕСТЬNULL(ДолжныБытьЛисты.ПриходВремРаспУч, 0)
	|				ИЛИ ЕСТЬNULL(Листы.РасходВремРасп, 0) <> ЕСТЬNULL(ДолжныБытьЛисты.РасходВремРаспУч, 0)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ,
	|	Листы.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Валюта,
	|	Фондовый";
	
	Таблица = Запрос.Выполнить().Выгрузить();
	Таблица.Сортировать("Дата, Валюта, Фондовый");
	Таблица.Колонки.Добавить("Рабочий", ОбщегоНазначения.ОписаниеТипаЧисло(1));
	Таблица.Колонки.Добавить("ДеньНедели", ОбщегоНазначения.ОписаниеТипаСтрока(11));
	Таблица.Колонки.Добавить("Состояние", ОбщегоНазначения.ОписаниеТипаСтрока(20));
	Таблица.Колонки.Добавить("Исправить", Новый ОписаниеТипов("Булево"));

	БлижайшиеДаты = Неопределено;
	ОсновнойКалендарь = КалендарныеГрафики.ОсновнойПроизводственныйКалендарь();
	Если НЕ ОсновнойКалендарь = Неопределено Тогда
		БлижайшиеДаты = КалендарныеГрафики.БлижайшиеРабочиеДаты(ОсновнойКалендарь, МассивДат);
	КонецЕсли;	
		
	Для каждого ТекСтр Из Таблица Цикл
		
		ТекСтр.ДеньНедели = ДниНедели[ДеньНедели(ТекСтр.Дата) - 1];
		Если НЕ БлижайшиеДаты = Неопределено Тогда
			ТекСтр.Рабочий = ?(БлижайшиеДаты.Получить(ТекСтр.Дата) = ТекСтр.Дата, 2, 1);
		Иначе
			ТекСтр.Рабочий = ?(ДеньНедели(ТекСтр.Дата) < 6, 2, 1);
		КонецЕсли;	 
		
		Если ЗначениеЗаполнено(ТекСтр.ЛистКассовойКниги) Тогда
			Если ТекСтр.Расхождения Тогда
				ТекСтр.Состояние = "Перезаполнить";
				ТекСтр.Исправить = Истина;
			Иначе
				ТекСтр.Состояние = "Не требуется";
				ТекСтр.Исправить = Ложь;
			КонецЕсли; 	
		Иначе
			ТекСтр.Состояние = "Создать";
			ТекСтр.Исправить = (ТекСтр.Рабочий = 2);
		КонецЕсли; 
		
	КонецЦикла; 
	
	Возврат Таблица;

КонецФункции	

Функция ТаблицаВыплатПоПлатежнойВедомости(ПлатежнаяВедомость) Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ПлатежнаяВедомостьРасшифровкаПлатежа.КФО КАК КФО,
	|	ПлатежнаяВедомостьРасшифровкаПлатежа.КПС КАК КПС,
	|	ПлатежнаяВедомостьРасшифровкаПлатежа.КЭК КАК КЭК,
	|	ПлатежнаяВедомостьРасшифровкаПлатежа.КодЦели КАК КодЦели,
	|	ПлатежнаяВедомостьРасшифровкаПлатежа.КодМероприятия КАК КодМероприятия,
	|	ПлатежнаяВедомостьРасшифровкаПлатежа.ДопКлассификация КАК ДопКлассификация,
	|	ПлатежнаяВедомостьРасшифровкаПлатежа.Сумма КАК Сумма,
	|	ПлатежнаяВедомостьРасшифровкаПлатежа.Ссылка.Номер КАК ПервичныйДокументНомер,
	|	ПлатежнаяВедомостьРасшифровкаПлатежа.Ссылка.Дата КАК ПервичныйДокументДата,
	|	ПлатежнаяВедомость0504403Состав.Контрагент КАК Контрагент,
	|	ПлатежнаяВедомость0504403Состав.ОснованиеПринятияОбязательства КАК ОснованиеПринятияОбязательств,
	|	РасходныйКассовыйОрдерРасшифровкаПлатежа.СчетРасчетов КАК КорСчет,
	|	ПлатежнаяВедомостьРасшифровкаПлатежа.Ссылка.Подразделение КАК ПодразделениеСотр
	|ИЗ
	|	Документ.ПлатежнаяВедомость0504403.РасшифровкаПлатежа КАК ПлатежнаяВедомостьРасшифровкаПлатежа
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПлатежнаяВедомость0504403.Состав КАК ПлатежнаяВедомость0504403Состав
	|		ПО ПлатежнаяВедомостьРасшифровкаПлатежа.ИдентификаторСтроки = ПлатежнаяВедомость0504403Состав.ИдентификаторСтроки
	|			И ПлатежнаяВедомостьРасшифровкаПлатежа.Ссылка = ПлатежнаяВедомость0504403Состав.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.РасходныйКассовыйОрдер.РасшифровкаПлатежа КАК РасходныйКассовыйОрдерРасшифровкаПлатежа
	|		ПО ПлатежнаяВедомостьРасшифровкаПлатежа.Ссылка = РасходныйКассовыйОрдерРасшифровкаПлатежа.Ссылка.ДокументОснование
	|			И ПлатежнаяВедомостьРасшифровкаПлатежа.КФО = РасходныйКассовыйОрдерРасшифровкаПлатежа.КФО
	|			И ПлатежнаяВедомостьРасшифровкаПлатежа.КПС = РасходныйКассовыйОрдерРасшифровкаПлатежа.КПС
	|			И ПлатежнаяВедомостьРасшифровкаПлатежа.КЭК = РасходныйКассовыйОрдерРасшифровкаПлатежа.КЭК
	|			И ПлатежнаяВедомостьРасшифровкаПлатежа.КодЦели = РасходныйКассовыйОрдерРасшифровкаПлатежа.КодЦели
	|			И ПлатежнаяВедомостьРасшифровкаПлатежа.КодМероприятия = РасходныйКассовыйОрдерРасшифровкаПлатежа.КодМероприятия
	|			И ПлатежнаяВедомостьРасшифровкаПлатежа.ДопКлассификация = РасходныйКассовыйОрдерРасшифровкаПлатежа.ДопКлассификация
	|ГДЕ
	|	ПлатежнаяВедомостьРасшифровкаПлатежа.Ссылка = &Ссылка
	|	И ПлатежнаяВедомостьРасшифровкаПлатежа.Выплачено = ИСТИНА");
	
	Запрос.УстановитьПараметр("Ссылка", ПлатежнаяВедомость);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции	

Функция ДенежныхДокументовДостаточноДляСписания(ДокументОбъект) Экспорт
		
	Запрос = Новый Запрос;
	ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Расшифровка",
			"КФО,ВидДенежногоДокумента,ДенежныйДокумент,Количество,Сумма",
			ДокументОбъект);

	Запрос.Текст = Запрос.Текст + 
	"ВЫБРАТЬ
	|	РасходныйОрдерФондовыйРасшифровка.КФО КАК КФО,
	|	РасходныйОрдерФондовыйРасшифровка.ВидДенежногоДокумента КАК ВидДенежногоДокумента,
	|	РасходныйОрдерФондовыйРасшифровка.ДенежныйДокумент КАК ДенежныйДокумент,
	|	СУММА(ЕСТЬNULL(ДенежныеДокументыОстатки.КоличествоОстаток, 0) - РасходныйОрдерФондовыйРасшифровка.Количество) КАК Количество,
	|	СУММА(ЕСТЬNULL(ДенежныеДокументыОстатки.СуммаОстаток, 0) - РасходныйОрдерФондовыйРасшифровка.Сумма) КАК Сумма
	|ПОМЕСТИТЬ ОстаткиПревышение
	|ИЗ
	|	ТаблицаРасшифровка КАК РасходныйОрдерФондовыйРасшифровка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ДенежныеДокументы.Остатки(
	|				&Период,
	|				Организация = &Организация
	|					И Подразделение = &Подразделение) КАК ДенежныеДокументыОстатки
	|		ПО РасходныйОрдерФондовыйРасшифровка.КФО = ДенежныеДокументыОстатки.КФО
	|			И РасходныйОрдерФондовыйРасшифровка.ВидДенежногоДокумента = ДенежныеДокументыОстатки.ВидДенежногоДокумента
	|			И РасходныйОрдерФондовыйРасшифровка.ДенежныйДокумент = ДенежныеДокументыОстатки.ДенежныйДокумент
	|
	|СГРУППИРОВАТЬ ПО
	|	РасходныйОрдерФондовыйРасшифровка.КФО,
	|	РасходныйОрдерФондовыйРасшифровка.ВидДенежногоДокумента,
	|	РасходныйОрдерФондовыйРасшифровка.ДенежныйДокумент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстаткиПревышение.ВидДенежногоДокумента КАК ВидДенежногоДокумента,
	|	ОстаткиПревышение.ДенежныйДокумент КАК ДенежныйДокумент
	|ИЗ
	|	ОстаткиПревышение КАК ОстаткиПревышение
	|ГДЕ
	|	(ОстаткиПревышение.Количество < 0
	|				И &УчетПоКоличеству
	|			ИЛИ ОстаткиПревышение.Сумма < 0)";
		
	Запрос.УстановитьПараметр("УчетПоКоличеству", ПолучитьФункциональнуюОпцию("ВестиКоличественныйУчетДенежныхДокументов"));
	Запрос.УстановитьПараметр("Организация", ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("Период", ?(ДокументОбъект.Ссылка.Пустая(),
		Новый Граница(КонецДня(ДокументОбъект.Дата), ВидГраницы.Включая),
		Новый Граница(ДокументОбъект.Ссылка.МоментВремени(), ВидГраницы.Исключая)));
	Если ЗначениеЗаполнено(ДокументОбъект.Подразделение)
		И ДокументОбъект.Подразделение.ВедетсяКассоваяКнига Тогда
		Запрос.УстановитьПараметр("Подразделение", ДокументОбъект.Подразделение);
	Иначе
		Запрос.УстановитьПараметр("Подразделение", ПредопределенноеЗначение("Справочник.Подразделения.ПустаяСсылка"));
	КонецЕсли;  
			
	Результат = Запрос.Выполнить().Пустой();
		
	Возврат Результат;
	
КонецФункции	

// Метод регламентного задания "ФормированиеЛистовКассовойКниги"
//
Процедура ФормированиеЛистовКассовойКниги() Экспорт
	
	Перем СписокИзмененных;
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(Метаданные.РегламентныеЗадания.ФормированиеДокументовСписанияДБП);
	
	ИмяСобытия = НСтр("ru = 'Формирование листов кассовой книги'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка());
	
	ЗаписьЖурналаРегистрации(
		ИмяСобытия,
		УровеньЖурналаРегистрации.Информация,
		,
		,
		НСтр("ru = 'Начато регламентное создание листов кассовой книги.'"));
		
	УстановитьПривилегированныйРежим(Истина);

	Если МонопольныйРежим() Тогда
		// Если база работает в монопольном режиме (например, запущено фоновое задание, которое включило монопольный режим
		//  и выгружает данные из области данных для последующей загрузки в модели сервиса),
		//  то будут ошибки при всех попытках записи данных в базу.
		ЗаписьЖурналаРегистрации(
		ИмяСобытия,
		УровеньЖурналаРегистрации.Информация,
		,
		,
		НСтр("ru='Принудительное завершение выполнения регламентного задания: информационная база открыта в монопольном режиме.'"));
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	Организации.Ссылка КАК Организация,
	|	ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка) КАК Подразделение
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.ПометкаУдаления = ЛОЖЬ
	|	И Организации.УчетПереданныхПолномочий = ЛОЖЬ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Подразделения.Владелец,
	|	Подразделения.Ссылка
	|ИЗ
	|	Справочник.Подразделения КАК Подразделения
	|ГДЕ
	|	Подразделения.ПометкаУдаления = ЛОЖЬ
	|	И Подразделения.ОбособленноеПодразделение = ИСТИНА
	|	И Подразделения.ВедетсяКассоваяКнига = ИСТИНА
	|	И Подразделения.Владелец.УчетПереданныхПолномочий = ЛОЖЬ");
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ОбработкаОбъект = Обработки.ПроверкаКассовойКниги.Создать();
		ОбработкаОбъект.ДатаНачала = НачалоДня(ТекущаяДатаСеанса());
		ОбработкаОбъект.ДатаКонца = КонецДня(ТекущаяДатаСеанса());
		ОбработкаОбъект.Организация = Выборка.Организация;
		ОбработкаОбъект.Подразделение = Выборка.Подразделение;
		ОбработкаОбъект.ЭлектроннаяКнига = 1;
		ОбработкаОбъект.ИмяМакета = "ПФ_MXL_ОтчетКассира_52н";
		                                                                        
		ЗаписьЖурналаРегистрации(
				ИмяСобытия,
				УровеньЖурналаРегистрации.Информация,
				,
				,
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='За %1 по %2, %3.'")
				, Формат(ОбработкаОбъект.ДатаНачала, "ДФ=dd.MM.yyyy"), ОбработкаОбъект.Организация, ОбработкаОбъект.Подразделение));
				
		ОбработкаОбъект.ЗаполнитьТабличнуюЧастьЭлектронныеЛисты();
		ОбработкаОбъект.ИсправитьКассовуюКнигу(СписокИзмененных, Ложь);
		
		Если ТипЗнч(СписокИзмененных) = Тип("Массив") И СписокИзмененных.Количество() > 0 Тогда
			ЗаписьЖурналаРегистрации(
				ИмяСобытия,
				УровеньЖурналаРегистрации.Информация,
				,
				,
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='%1, %2 %3 %4'")
				, ОбработкаОбъект.Организация, ОбработкаОбъект.Подразделение, Символы.ПС, СтрСоединить(СписокИзмененных, Символы.ПС)));
		Иначе
			ЗаписьЖурналаРегистрации(
				ИмяСобытия,
				УровеньЖурналаРегистрации.Информация,
				,
				,
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='%1, %2 - данные для формирования листов кассовой книги отсутствуют.'")
				, ОбработкаОбъект.Организация, ОбработкаОбъект.Подразделение));
		КонецЕсли;	
		
	КонецЦикла;	
	
	ЗаписьЖурналаРегистрации(
		ИмяСобытия,
		УровеньЖурналаРегистрации.Информация,
		,
		,
		НСтр("ru = 'Завершено регламентное создание листов кассовой книги.'"));
	
КонецПроцедуры	

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Вставляет в шапку листа штамп "Фондовый".
 //
 // Параметры
 //  ОблШапка  - ТабличныйДокумент - область шапки документа
 //  НомерСтрокиНачало  - Число - номер строки, с которой начинается шапка
 //
Процедура ПечатьШтампаФондовый(ОблШапка, НомерСтрокиНачало)
	
	Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 2);
	
	ОблШапка.Область(НомерСтрокиНачало+1, 5, НомерСтрокиНачало+1, 7).Объединить();
	ОблШапка.Область(НомерСтрокиНачало+1, 5, НомерСтрокиНачало+1, 7).Обвести(Линия, Линия, Линия, Линия);
	ОблШапка.Область(НомерСтрокиНачало+1, 5, НомерСтрокиНачало+1, 7).Текст                   = "Ф О Н Д О В Ы Й";
	ЦветПечати                                              = Новый Цвет(83,114,187); 
	ОблШапка.Область(НомерСтрокиНачало+1, 5, НомерСтрокиНачало+1, 7).ЦветТекста              = ЦветПечати;
	ОблШапка.Область(НомерСтрокиНачало+1, 5, НомерСтрокиНачало+1, 7).ЦветРамки               = ЦветПечати;
	ОблШапка.Область(НомерСтрокиНачало+1, 5, НомерСтрокиНачало+1, 7).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	ОблШапка.Область(НомерСтрокиНачало+1, 5, НомерСтрокиНачало+1, 7).ВертикальноеПоложение   = ВертикальноеПоложение.Центр;
	ЖирныйШрифт                                             = Новый Шрифт(ОблШапка.Область(НомерСтрокиНачало+1, 5, НомерСтрокиНачало+1, 7).Шрифт,, 11, Истина);
	ОблШапка.Область(НомерСтрокиНачало+1, 5, НомерСтрокиНачало+1, 7).Шрифт                   = ЖирныйШрифт;

	ОблШапка.Область(НомерСтрокиНачало+1, 15, НомерСтрокиНачало+1, 17).Объединить();
	ОблШапка.Область(НомерСтрокиНачало+1, 15, НомерСтрокиНачало+1, 17).Обвести(Линия, Линия, Линия, Линия);
	ОблШапка.Область(НомерСтрокиНачало+1, 15, НомерСтрокиНачало+1, 17).Текст                   = "Ф О Н Д О В Ы Й";
	ЦветПечати                                              = Новый Цвет(83,114,187); 
	ОблШапка.Область(НомерСтрокиНачало+1, 15, НомерСтрокиНачало+1, 17).ЦветТекста              = ЦветПечати;
	ОблШапка.Область(НомерСтрокиНачало+1, 15, НомерСтрокиНачало+1, 17).ЦветРамки               = ЦветПечати;
	ОблШапка.Область(НомерСтрокиНачало+1, 15, НомерСтрокиНачало+1, 17).ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
	ОблШапка.Область(НомерСтрокиНачало+1, 15, НомерСтрокиНачало+1, 17).ВертикальноеПоложение   = ВертикальноеПоложение.Центр;
	ЖирныйШрифт                                             = Новый Шрифт(ОблШапка.Область(НомерСтрокиНачало+1, 15, НомерСтрокиНачало+1, 17).Шрифт,, 11, Истина);
	ОблШапка.Область(НомерСтрокиНачало+1, 15, НомерСтрокиНачало+1, 17).Шрифт                   = ЖирныйШрифт;
	
КонецПроцедуры

// Процедура заполняет параметры области шапки листа,
// а также ставит штамп "Фондовый".
// 
// Параметры: 
// ОблШапка - Область таблицы - таблица, содреждащая
// область шапки листа
// 
Процедура ЗаполнитьШапкуЛиста(ОблШапка, Выборка, КоличествоЛистов)
	
	СтруктураОблШапка = Новый Структура("НомерЛиста", Макс(Выборка.НомерЛиста, 0) + КоличествоЛистов);
	ОблШапка.Параметры.Заполнить(Выборка);
    ОблШапка.Параметры.Заполнить(СтруктураОблШапка);

	Если ТипЗнч(Выборка.Ссылка) = Тип("ДокументСсылка.ЛистКассовойКнигиФондовый") или Выборка.Фондовый Тогда
		
		ПечатьШтампаФондовый(ОблШапка, 1);
		
	КонецЕсли;
	
	КоличествоЛистов = КоличествоЛистов + 1;
	
КонецПроцедуры

// Функция подсчитывает количество листов за текущий месяц.
// 
// Возвращаемое значение: 
// Число.
// Количество листов за текущий месяц.
// 
Функция ЛистовЗаМесяц(ВыборкаДокументов, КоличествоЛистов, ИмяМакета = "ПФ_MXL_ОтчетКассира")
	
	Запрос=Новый Запрос;
	
	Запрос.УстановитьПараметр("Организация",		ВыборкаДокументов.Организация);
	Запрос.УстановитьПараметр("Дата",				КонецДня(ВыборкаДокументов.Дата));
	Запрос.УстановитьПараметр("ДатаНач",			НачалоМесяца(ВыборкаДокументов.Дата));
	Запрос.УстановитьПараметр("Ссылка",				ВыборкаДокументов.Ссылка);
	Запрос.УстановитьПараметр("Подразделение",		ВыборкаДокументов.Подразделение);
	Запрос.УстановитьПараметр("ЕстьПодразделение",	ЗначениеЗаполнено(ВыборкаДокументов.Подразделение));
	
	Если НЕ ПолучитьФункциональнуюОпцию("ФондоваяКнигаОтдельноОтДенежной") Тогда
		
		ЗапросТекст="ВЫБРАТЬ
		|	ЛистКассовойКниги.Ссылка,
		|	ЕСТЬNULL(ЛистКассовойКниги.КоличествоЛистов, 0) КАК КоличествоЛистов
		|ПОМЕСТИТЬ ЛистыКассовойКниги
		|ИЗ
		|	&ДокументЛистКассовойКниги КАК ЛистКассовойКниги
		|ГДЕ
		|	ЛистКассовойКниги.Организация = &Организация
		|	И НЕ ЛистКассовойКниги.ПометкаУдаления
		|	И ЛистКассовойКниги.Дата МЕЖДУ &ДатаНач И &Дата
		|	И ЛистКассовойКниги.Ссылка <> &Ссылка
		|	И (&ЕстьПодразделение
		|				И ЛистКассовойКниги.Подразделение = &Подразделение
		|			ИЛИ НЕ &ЕстьПодразделение
		|				И (ЛистКассовойКниги.Подразделение ЕСТЬ NULL 
		|					ИЛИ ЛистКассовойКниги.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)))
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЛистКассовойКниги.Ссылка,
		|	ЕСТЬNULL(ЛистКассовойКниги.КоличествоЛистов, 0)
		|ИЗ
		|	&ДокументЛистКассовойКнигиФондовый КАК ЛистКассовойКниги
		|ГДЕ
		|	ЛистКассовойКниги.Организация = &Организация
		|	И НЕ ЛистКассовойКниги.ПометкаУдаления
		|	И ЛистКассовойКниги.Дата МЕЖДУ &ДатаНач И &Дата
		|	И ЛистКассовойКниги.Ссылка <> &Ссылка
		|	И (&ЕстьПодразделение
		|				И ЛистКассовойКниги.Подразделение = &Подразделение
		|			ИЛИ НЕ &ЕстьПодразделение
		|				И (ЛистКассовойКниги.Подразделение ЕСТЬ NULL 
		|					ИЛИ ЛистКассовойКниги.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(ЛистыКассовойКниги.КоличествоЛистов), 0) КАК КоличествоЛистов
		|ИЗ
		|	ЛистыКассовойКниги КАК ЛистыКассовойКниги";
		
	Иначе
		
		ЗапросТекст="ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(ЛистКассовойКниги.КоличествоЛистов), 0) КАК КоличествоЛистов
		|ИЗ
		|	&ДокументЛистКассовойКниги КАК ЛистКассовойКниги
		|ГДЕ
		|	ЛистКассовойКниги.Проведен
		|	И ЛистКассовойКниги.Организация = &Организация
		|	И ЛистКассовойКниги.Дата МЕЖДУ &ДатаНач И &Дата
		|	И ЛистКассовойКниги.Ссылка <> &Ссылка
		|	И (&ЕстьПодразделение
		|				И ЛистКассовойКниги.Подразделение = &Подразделение
		|			ИЛИ НЕ &ЕстьПодразделение
		|				И (ЛистКассовойКниги.Подразделение ЕСТЬ NULL 
		|					ИЛИ ЛистКассовойКниги.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)))";
		
		
		Если ТипЗнч(ВыборкаДокументов.Ссылка) = Тип("ДокументСсылка.ЛистКассовойКнигиФондовый")
			ИЛИ ТипЗнч(ВыборкаДокументов.Ссылка) = Тип("ДокументСсылка.ЛистКассовойКнигиФондовый_52н") Тогда
			ЗапросТекст = СтрЗаменить(ЗапросТекст, "&ДокументЛистКассовойКниги ", "&ДокументЛистКассовойКнигиФондовый ");
		КонецЕсли	
			
	КонецЕсли;
	
	Если ИмяМакета = "ПФ_MXL_ОтчетКассира_52н" Тогда
		ЗапросТекст = СтрЗаменить(ЗапросТекст, "&ДокументЛистКассовойКниги ", "Документ.ЛистКассовойКниги_52н ");
	    ЗапросТекст = СтрЗаменить(ЗапросТекст, "&ДокументЛистКассовойКнигиФондовый ", "Документ.ЛистКассовойКнигиФондовый_52н ");
	Иначе
		ЗапросТекст = СтрЗаменить(ЗапросТекст, "&ДокументЛистКассовойКниги ", "Документ.ЛистКассовойКниги ");
	    ЗапросТекст = СтрЗаменить(ЗапросТекст, "&ДокументЛистКассовойКнигиФондовый ", "Документ.ЛистКассовойКнигиФондовый ");
	КонецЕсли;	
	
	Запрос.Текст = ЗапросТекст;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат ?(ЗначениеЗаполнено(Выборка.КоличествоЛистов), Выборка.КоличествоЛистов, 0) + КоличествоЛистов;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

#КонецОбласти


