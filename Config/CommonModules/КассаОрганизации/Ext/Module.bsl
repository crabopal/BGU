	|	ЛистКассовойКнигиФондовыйКассовыеОрдера.ПриходБюджет,
	|	ЛистКассовойКнигиФондовыйКассовыеОрдера.РасходБюджет,
	|	ЛистКассовойКнигиФондовыйКассовыеОрдера.ПриходВнеБюдж,
	|	ЛистКассовойКнигиФондовыйКассовыеОрдера.РасходВнеБюдж,
	|	ЛистКассовойКнигиФондовыйКассовыеОрдера.ПриходУчреждение,
	|	ЛистКассовойКнигиФондовыйКассовыеОрдера.РасходУчреждение,
	|	ЛистКассовойКнигиФондовыйКассовыеОрдера.ПриходВремРасп,
	|	ЛистКассовойКнигиФондовыйКассовыеОрдера.РасходВремРасп,
	|	ЛистКассовойКнигиФондовыйКассовыеОрдера.КФО,
	|	ВЫБОР
	|		КОГДА ЛистКассовойКнигиФондовыйКассовыеОрдера.КассовыйДокумент ЕСТЬ NULL 
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ
	|ИЗ
	|	&ДокументЛистКассовойКнигиФондовыйКассовыеОрдера КАК ЛистКассовойКнигиФондовыйКассовыеОрдера
	|ГДЕ
	|	ЛистКассовойКнигиФондовыйКассовыеОрдера.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтроки";
	
	
	Если ИмяМакета = "ПФ_MXL_ОтчетКассира_52н" Тогда
		ЗапросТекст = СтрЗаменить(ЗапросТекст , "&ДокументЛистКассовойКниги ", "Документ.ЛистКассовойКниги_52н ");
		ЗапросТекст = СтрЗаменить(ЗапросТекст , "&ДокументЛистКассовойКнигиКассовыеОрдера ", "Документ.ЛистКассовойКниги_52н.КассовыеОрдера ");
	    ЗапросТекст = СтрЗаменить(ЗапросТекст , "&ДокументЛистКассовойКнигиФондовый ", "Документ.ЛистКассовойКнигиФондовый_52н ");
		ЗапросТекст = СтрЗаменить(ЗапросТекст , "&ДокументЛистКассовойКнигиФондовыйКассовыеОрдера ", "Документ.ЛистКассовойКнигиФондовый_52н.КассовыеОрдера ");
	Иначе
		ЗапросТекст = СтрЗаменить(ЗапросТекст , "&ДокументЛистКассовойКниги ", "Документ.ЛистКассовойКниги ");
		ЗапросТекст = СтрЗаменить(ЗапросТекст , "&ДокументЛистКассовойКнигиКассовыеОрдера ", "Документ.ЛистКассовойКниги.КассовыеОрдера ");
	    ЗапросТекст = СтрЗаменить(ЗапросТекст , "&ДокументЛистКассовойКнигиФондовый ", "Документ.ЛистКассовойКнигиФондовый ");
		ЗапросТекст = СтрЗаменить(ЗапросТекст , "&ДокументЛистКассовойКнигиФондовыйКассовыеОрдера ", "Документ.ЛистКассовойКнигиФондовый.КассовыеОрдера ");
	КонецЕсли;	
	
	Запрос.Текст = ЗапросТекст;
				   
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.УстановитьПараметр("ВалютаРегламентированногоУчета", Константы.ВалютаРегламентированногоУчета.Получить());
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	ВыборкаДокументов = МассивРезультатов[3].Выбрать();	
	
	КассовыеОрдера = МассивРезультатов[4].Выгрузить();

	
	Пока ВыборкаДокументов.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТаблицаРезультат.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
    	НомерСтрокиНачало = ТаблицаРезультат.ВысотаТаблицы + 1;

		ОблШапка = Макет.ПолучитьОбласть("Заголовок");
		
		ЗаполнитьШапкуЛиста(ОблШапка, ВыборкаДокументов, КоличествоЛистов);
		
		ТаблицаРезультат.Вывести(ОблШапка);
		
		ОблНачало = Макет.ПолучитьОбласть("Начало");
		ОблНачало.Параметры.Заполнить(ВыборкаДокументов);
		
		// для вывода в вебклиенте уберем флаг "отрицательное красным" для нулевых ячеек
		ОблНачало.Область("R1C7").ВыделятьОтрицательные		= НЕ (ВыборкаДокументов.НачалоДняБюджет = 0) ИЛИ НЕ (ВыборкаДокументов.НачалоДняУчреждение = 0);
		ОблНачало.Область("R1C17").ВыделятьОтрицательные	= НЕ (ВыборкаДокументов.НачалоДняБюджет = 0) ИЛИ НЕ (ВыборкаДокументов.НачалоДняУчреждение = 0);
		ОблНачало.Область("R1C9").ВыделятьОтрицательные		= НЕ (ВыборкаДокументов.НачалоДняВнеБюдж = 0) ИЛИ НЕ (ВыборкаДокументов.НачалоДняВремРасп = 0);
		ОблНачало.Область("R1C19").ВыделятьОтрицательные	= НЕ (ВыборкаДокументов.НачалоДняВнеБюдж = 0) ИЛИ НЕ (ВыборкаДокументов.НачалоДняВремРасп = 0);
		
		ТаблицаРезультат.Вывести(ОблНачало);

		ОблПодвал = Макет.ПолучитьОбласть("Подвал");
		
		Если (Не ВыводВФорму) или ВыборкаДокументов.Фондовый Тогда 
			//убираем доступность полей ввода "в том числе на зарплату"
			
			ОблПодвал.Область("R3C7").Защита = Истина;		
			ОблПодвал.Область("R3C7").ЦветФона = ЦветАвто;
			ОблПодвал.Область("R3C9").Защита = Истина;		
			ОблПодвал.Область("R3C9").ЦветФона = ЦветАвто;
			ОблПодвал.Область("R3C17").Защита = Истина;		
			ОблПодвал.Область("R3C17").ЦветФона = ЦветАвто;
			ОблПодвал.Область("R3C19").Защита = Истина;		
			ОблПодвал.Область("R3C19").ЦветФона = ЦветАвто;
			
		КонецЕсли;
		
		КоличествоОрдеров = "Записи в кассовой книге проверил и документы в количестве ----- приходных и ----- расходных получил";
		СтруктураОблПодвал = Новый Структура("КоличествоОрдеров", КоличествоОрдеров);
		
		ТекДОБ 		= 0;
		ТекКОБ 		= 0;
		ТекДОВнеБ 	= 0;
		ТекКОВнеБ 	= 0;
		ТекДОУ 		= 0;
		ТекКОУ 		= 0;
		ТекДОВР 	= 0;
		ТекКОВР 	= 0;

		

		КолПКО = 0;
		КолРКО = 0;
		
		КассовыеДокументы = Новый Массив;
		
		Выборка = ВыборкаДокументов.Выбрать();
		
		ВыборкаКО = КассовыеОрдера.Скопировать(Новый Структура("Ссылка", ВыборкаДокументов.Ссылка));
		
		Для Каждого Выборка Из ВыборкаКО Цикл
			
			Если НЕ Выборка.КОЗаполнен тогда
				Продолжить;
			КонецЕсли;
			
			ОблСтрока = Макет.ПолучитьОбласть("Строка");
			
			Если (Не ВыводВФорму) Тогда
				ОблСтрока.Область("R1C3").Защита 	= Истина;
				ОблСтрока.Область("R1C3").ЦветФона 	= ЦветАвто;
				ОблСтрока.Область("R1C13").Защита 	= Истина;
				ОблСтрока.Область("R1C13").ЦветФона = ЦветАвто;
			КонецЕсли;
			
			ОблСтрока.Параметры.Заполнить(Выборка);
			
			Если Найти(Нрег(ТипЗнч(Выборка.КассовыйДокумент)),"приходный")>0 Тогда
				
				ПрефиксДок = "ПКО ";
				
				Если КассовыеДокументы.Найти(Выборка.КассовыйДокумент) = Неопределено Тогда
					КолПКО = КолПКО + 1;
					КассовыеДокументы.Добавить(Выборка.КассовыйДокумент);
				КонецЕсли;
				
			Иначе
				
				ПрефиксДок = "РКО ";
				
				Если КассовыеДокументы.Найти(Выборка.КассовыйДокумент) = Неопределено Тогда
					КолРКО = КолРКО + 1;
					КассовыеДокументы.Добавить(Выборка.КассовыйДокумент);
				КонецЕсли;
				
			КонецЕсли;
			
			// для вывода в вебклиенте уберем флаг "отрицательное красным" для нулевых ячеек
			ОблСтрока.Область("R1C7").ВыделятьОтрицательные		= НЕ (Выборка.ПриходБюджет = 0) ИЛИ НЕ (Выборка.ПриходУчреждение = 0);
			ОблСтрока.Область("R1C17").ВыделятьОтрицательные	= НЕ (Выборка.ПриходБюджет = 0) ИЛИ НЕ (Выборка.ПриходУчреждение = 0);
			ОблСтрока.Область("R1C8").ВыделятьОтрицательные		= НЕ (Выборка.РасходБюджет = 0) ИЛИ НЕ (Выборка.РасходУчреждение = 0);
			ОблСтрока.Область("R1C18").ВыделятьОтрицательные	= НЕ (Выборка.РасходБюджет = 0) ИЛИ НЕ (Выборка.РасходУчреждение = 0);
			ОблСтрока.Область("R1C9").ВыделятьОтрицательные		= НЕ (Выборка.ПриходВнеБюдж = 0) ИЛИ НЕ (Выборка.ПриходВремРасп = 0);
			ОблСтрока.Область("R1C19").ВыделятьОтрицательные	= НЕ (Выборка.ПриходВнеБюдж = 0) ИЛИ НЕ (Выборка.ПриходВремРасп = 0);
			ОблСтрока.Область("R1C10").ВыделятьОтрицательные	= НЕ (Выборка.РасходВнеБюдж = 0) ИЛИ НЕ (Выборка.РасходВремРасп = 0);
			ОблСтрока.Область("R1C20").ВыделятьОтрицательные	= НЕ (Выборка.РасходВнеБюдж = 0) ИЛИ НЕ (Выборка.РасходВремРасп = 0);
			
			СтруктураОблСтрока = Новый Структура("НомерДок, КорСчет");
			
			СтруктураОблСтрока.НомерДок = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(Выборка.КассовыйДокумент,Выборка.КассовыйДокумент.Номер);
			СтруктураОблСтрока.КорСчет 	= БухгалтерскийУчетПовтИсп.ПолучитьПредставлениеСчета(Выборка.КорСчет, , Выборка.КФО);
			ОблСтрока.Параметры.Заполнить(СтруктураОблСтрока);
			
			МассивПроверки = Новый Массив;
			МассивПроверки.Добавить(ОблСтрока);
			МассивПроверки.Добавить(ОблПодвал);
			
			Если НЕ ТаблицаРезультат.ПроверитьВывод(МассивПроверки) Тогда // перенос
				
				ОблПеренос = Макет.ПолучитьОбласть("Перенос");
				СтруктураОблПеренос = Новый Структура("Слова,ДОБ,КОБ,ДОВнеБ,КОВнеБ,ДОУ,КОУ,ДОВР,КОВР");
				СтруктураОблПеренос.Слова 	= "Перенос";
				СтруктураОблПеренос.ДОБ 	= ТекДОБ;
				СтруктураОблПеренос.КОБ 	= ТекКОБ;
				СтруктураОблПеренос.ДОВнеБ	= ТекДОВнеБ;
				СтруктураОблПеренос.КОВнеБ 	= ТекКОВнеБ;
				СтруктураОблПеренос.ДОУ 	= ТекДОУ;
				СтруктураОблПеренос.КОУ 	= ТекКОУ;
				СтруктураОблПеренос.ДОВР 	= ТекДОВР;
				СтруктураОблПеренос.КОВР 	= ТекКОВР;

				
				ОблПеренос.Параметры.Заполнить(СтруктураОблПеренос);
				
				// для вывода в вебклиенте уберем флаг "отрицательное красным" для нулевых ячеек
				ОблПеренос.Область("R1C7").ВыделятьОтрицательные	= НЕ (ТекДОБ = 0) ИЛИ НЕ (ТекДОУ = 0);
				ОблПеренос.Область("R1C17").ВыделятьОтрицательные	= НЕ (ТекДОБ = 0) ИЛИ НЕ (ТекДОУ = 0);
				ОблПеренос.Область("R1C8").ВыделятьОтрицательные	= НЕ (ТекКОБ = 0) ИЛИ НЕ (ТекКОУ = 0);
				ОблПеренос.Область("R1C18").ВыделятьОтрицательные	= НЕ (ТекКОБ = 0) ИЛИ НЕ (ТекКОУ = 0);
				ОблПеренос.Область("R1C9").ВыделятьОтрицательные	= НЕ (ТекДОВнеБ = 0) ИЛИ НЕ (ТекДОВР = 0);
				ОблПеренос.Область("R1C19").ВыделятьОтрицательные	= НЕ (ТекДОВнеБ = 0) ИЛИ НЕ (ТекДОВР = 0);
				ОблПеренос.Область("R1C10").ВыделятьОтрицательные	= НЕ (ТекКОВнеБ = 0) ИЛИ НЕ (ТекКОВР = 0);
				ОблПеренос.Область("R1C20").ВыделятьОтрицательные	= НЕ (ТекКОВнеБ = 0) ИЛИ НЕ (ТекКОВР = 0);
				
				ТаблицаРезультат.Вывести(ОблПеренос);
				ТаблицаРезультат.ВывестиГоризонтальныйРазделительСтраниц();
				ЗаполнитьШапкуЛиста(ОблШапка, ВыборкаДокументов, КоличествоЛистов);
				ТаблицаРезультат.Вывести(ОблШапка);
				ОблПеренос.Параметры.Заполнить(Новый Структура("слова", "С переноса"));
				ТаблицаРезультат.Вывести(ОблПеренос);
				
			КонецЕслИ;
			
			ТекДОБ 		= ТекДОБ 	+ Выборка.ПриходБюджет;
			ТекКОБ 		= ТекКОБ 	+ Выборка.РасходБюджет;
			ТекДОВнеБ 	= ТекДОВнеБ + Выборка.ПриходВнеБюдж;
			ТекДОВнеБ 	= ТекДОВнеБ + Выборка.РасходВнеБюдж;
			ТекДОУ 		= ТекДОУ 	+ Выборка.ПриходУчреждение;
			ТекКОУ 		= ТекКОУ 	+ Выборка.РасходУчреждение;
			ТекДОВР 	= ТекДОВР 	+ Выборка.ПриходВремРасп;
			ТекКОВР 	= ТекКОВР 	+ Выборка.РасходВремРасп;

			
			ТаблицаРезультат.Вывести(ОблСтрока);
			
		КонецЦикла;
		
		КоличествоОрдеров = "Записи в кассовой книге проверил и документы в количестве " +  
						   ?(КолПКО > 0, НРег(ЧислоПрописью(КолПКО, , " приходный, приходных, приходных, м,,,,,0")), "----- приходных") + 
						   " и " + ?(КолРКО > 0, НРег(ЧислоПрописью(КолРКО, , " расходный, расходных, расходных, м,,,,,0")), "----- расходных") + 
						   " получил";
		
	    СтруктураОблПодвал.Вставить("КоличествоОрдеров", 	КоличествоОрдеров);
		
		СтруктураОблПодвал.Вставить("ДОБИтог", 				ВыборкаКО.Итог("ПриходБюджет"));
		СтруктураОблПодвал.Вставить("КОБИтог", 				ВыборкаКО.Итог("РасходБюджет"));
		СтруктураОблПодвал.Вставить("ДОВнеБИтог", 			ВыборкаКО.Итог("ПриходВнеБюдж"));
		СтруктураОблПодвал.Вставить("КОВнеБИтог", 			ВыборкаКО.Итог("РасходВнеБюдж"));
		
		СтруктураОблПодвал.Вставить("ДОУИтог", 				ВыборкаКО.Итог("ПриходУчреждение"));
		СтруктураОблПодвал.Вставить("КОУИтог", 				ВыборкаКО.Итог("РасходУчреждение"));
		СтруктураОблПодвал.Вставить("ДОВРИтог", 			ВыборкаКО.Итог("ПриходВремРасп"));
		СтруктураОблПодвал.Вставить("КОВРИтог", 			ВыборкаКО.Итог("РасходВремРасп"));

		
		СтруктураОблПодвал.Вставить("ОстКонБЗП", 			ВыборкаДокументов.КонецДняЗПБюджет);
		СтруктураОблПодвал.Вставить("ОстКонВнеБЗП", 		ВыборкаДокументов.КонецДняЗПВнеБюдж);
		СтруктураОблПодвал.Вставить("ОстКонУЗП", 			ВыборкаДокументов.КонецДняЗПУчреждение);
		СтруктураОблПодвал.Вставить("ОстКонВРЗП", 			ВыборкаДокументов.КонецДняЗПВремРасп);
		
		СтруктураОблПодвал.Вставить("ОстКонБ", 				ВыборкаДокументов.КонецДняБюджет);
		СтруктураОблПодвал.Вставить("ОстКонВнеБ", 			ВыборкаДокументов.КонецДняВнеБюдж);
		СтруктураОблПодвал.Вставить("ОстКонУ", 				ВыборкаДокументов.КонецДняУчреждение);
		СтруктураОблПодвал.Вставить("ОстКонВР", 			ВыборкаДокументов.КонецДняВремРасп);
		
		ОстатокКон = 0;
		
		Если НЕ ВыборкаДокументов.Фондовый Тогда
			ОстатокКон = ВыборкаДокументов.КонецДняБюджет + ВыборкаДокументов.КонецДняВнеБюдж;
		КонецЕсли;
		
		СтруктураОблПодвал.Вставить("ОстКон", ОстатокКон);
		
		СтруктураОблПодвал.Вставить("КассирФИО", 	КорреспондентыКлиентСервер.ФИО(Новый Структура("Фамилия, Имя, Отчество", ВыборкаДокументов.КассирФамилия, ВыборкаДокументов.КассирИмя, ВыборкаДокументов.КассирОтчество), Истина));					
		СтруктураОблПодвал.Вставить("ГлБухгалтерФИО", 	КорреспондентыКлиентСервер.ФИО(Новый Структура("Фамилия, Имя, Отчество", ВыборкаДокументов.ГлБухгалтерФамилия, ВыборкаДокументов.ГлБухгалтерИмя, ВыборкаДокументов.ГлБухгалтерОтчество), Истина));
		
		ОблПодвал.Параметры.Заполнить(СтруктураОблПодвал);
		
		// для вывода в вебклиенте уберем флаг "отрицательное красным" для нулевых ячеек
		ОблПодвал.Область("R1C7").ВыделятьОтрицательные		= НЕ (ВыборкаКО.Итог("ПриходБюджет") = 0) ИЛИ НЕ (ВыборкаКО.Итог("ПриходУчреждение") = 0);
		ОблПодвал.Область("R1C17").ВыделятьОтрицательные	= НЕ (ВыборкаКО.Итог("ПриходБюджет") = 0) ИЛИ НЕ (ВыборкаКО.Итог("ПриходУчреждение") = 0);
		ОблПодвал.Область("R1C8").ВыделятьОтрицательные		= НЕ (ВыборкаКО.Итог("РасходБюджет") = 0) ИЛИ НЕ (ВыборкаКО.Итог("РасходУчреждение") = 0);
		ОблПодвал.Область("R1C18").ВыделятьОтрицательные	= НЕ (ВыборкаКО.Итог("РасходБюджет") = 0) ИЛИ НЕ (ВыборкаКО.Итог("РасходУчреждение") = 0);
		ОблПодвал.Область("R1C9").ВыделятьОтрицательные		= НЕ (ВыборкаКО.Итог("ПриходВнеБюдж") = 0) ИЛИ НЕ (ВыборкаКО.Итог("ПриходВремРасп") = 0);
		ОблПодвал.Область("R1C19").ВыделятьОтрицательные	= НЕ (ВыборкаКО.Итог("ПриходВнеБюдж") = 0) ИЛИ НЕ (ВыборкаКО.Итог("ПриходВремРасп") = 0);
		ОблПодвал.Область("R1C10").ВыделятьОтрицательные	= НЕ (ВыборкаКО.Итог("РасходВнеБюдж") = 0) ИЛИ НЕ (ВыборкаКО.Итог("РасходВремРасп") = 0);
		ОблПодвал.Область("R1C20").ВыделятьОтрицательные	= НЕ (ВыборкаКО.Итог("РасходВнеБюдж") = 0) ИЛИ НЕ (ВыборкаКО.Итог("РасходВремРасп") = 0);
		ОблПодвал.Область("R2C7").ВыделятьОтрицательные		= НЕ (ВыборкаДокументов.КонецДняБюджет = 0)ИЛИ НЕ (ВыборкаДокументов.КонецДняУчреждение = 0);
		ОблПодвал.Область("R2C17").ВыделятьОтрицательные	= НЕ (ВыборкаДокументов.КонецДняБюджет = 0)ИЛИ НЕ (ВыборкаДокументов.КонецДняУчреждение = 0);
		ОблПодвал.Область("R2C9").ВыделятьОтрицательные		= НЕ (ВыборкаДокументов.КонецДняВнеБюдж = 0)ИЛИ НЕ (ВыборкаДокументов.КонецДняВремРасп = 0);
		ОблПодвал.Область("R2C19").ВыделятьОтрицательные	= НЕ (ВыборкаДокументов.КонецДняВнеБюдж = 0)ИЛИ НЕ (ВыборкаДокументов.КонецДняВремРасп = 0);
		ОблПодвал.Область("R5C9").ВыделятьОтрицательные		= НЕ (ВыборкаДокументов.КонецДняБюджет + ВыборкаДокументов.КонецДняВнеБюдж = 0)
															ИЛИ НЕ (ВыборкаДокументов.КонецДняУчреждение + ВыборкаДокументов.КонецДняВремРасп = 0);
		ОблПодвал.Область("R5C19").ВыделятьОтрицательные	= НЕ (ВыборкаДокументов.КонецДняБюджет + ВыборкаДокументов.КонецДняВнеБюдж = 0)
															ИЛИ НЕ (ВыборкаДокументов.КонецДняУчреждение + ВыборкаДокументов.КонецДняВремРасп = 0);
			
		ТаблицаРезультат.Вывести(ОблПодвал);
		
		Если ВыборкаДокументов.ПоследнийДеньМесяца Тогда
			
			ПоследнийДень = Макет.ПолучитьОбласть("ПослДень");
			ПоследнийДень.Параметры.Заполнить(Новый Структура("КолВоЛистовЗаПериод", "Количество листов кассовой книги за "
			+ Формат(ВыборкаДокументов.Дата, "ДФ='ММММ гггг'") + " г. - "
			+ Строка(ЛистовЗаМесяц(ВыборкаДокументов, КоличествоЛистов, ИмяМакета))));
			
			ТаблицаРезультат.Вывести(ПоследнийДень);
			
			Если Месяц(ВыборкаДокументов.Дата) = 12 Тогда
				
				ПоследнийДень.Параметры.Заполнить(Новый Структура("КолВоЛистовЗаПериод", "Количество листов кассовой книги за "
				+ Формат(ВыборкаДокументов.Дата, "ДФ='гггг'") + " г. - "
				+ Строка(ВыборкаДокументов.НомерЛиста + КоличествоЛистов - 1)));
				
				ТаблицаРезультат.Вывести(ПоследнийДень);
				
			КонецЕсли;	
			
		КонецЕсли;	
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТаблицаРезультат, 
		                                               НомерСтрокиНачало, ОбъектыПечати, ВыборкаДокументов.Ссылка);
													   
		Если НЕ ПечатьПриЗаполнении И КоличествоЛистов <> ВыборкаДокументов.КоличествоЛистов Тогда
			ТекстОшибки = НСтр("ru = 'Ошибка. В %1 сохраненное количество листов не совпадает с фактическим. Необходимо перезаполнить документ.'");
			ОбщегоНазначения.СообщитьПользователю(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ВыборкаДокументов.Ссылка), ВыборкаДокументов.Ссылка, "Объект");
		КонецЕсли;
			
		Если НЕ ПечатьПриЗаполнении Тогда
		
			КоличествоЛистов = 0;
		
		КонецЕсли; 
														
	КонецЦикла;
	
	Возврат ТаблицаРезультат;
	
КонецФункции

// Функция определяет право записи и формирования проводок для экземпляра кассового документа
//
Функция ПраваНаТекущийКассовыйДокумент(Ссылка) Экспорт
	
	Если Ссылка.Метаданные().Движения.Содержит(Метаданные.РегистрыНакопления.НаличныеДенежныеСредства) Тогда
		МетаданныеРегистра	= Метаданные.РегистрыНакопления.НаличныеДенежныеСредства;
	Иначе
		МетаданныеРегистра	= Метаданные.РегистрыНакопления.ДенежныеДокументы;
	КонецЕсли;
	
	РольПроведенияДоступна 				= ПравоДоступа("Изменение", МетаданныеРегистра);
	РольИзменениеДоступна 				= ПравоДоступа("Изменение",  Ссылка.Метаданные());
	РольФормированиеПроводокДоступна	= ПравоДоступа("Изменение", Метаданные.РегистрыБухгалтерии.ЖурналПроводокЕПСБУ);
	РольПолныеПраваДоступна 			= Пользователи.ЭтоПолноправныйПользователь();
	
	ЕстьДвиженияРегистра = Ложь;
	
	Если Ссылка.Проведен Тогда
		НаборЗаписей = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(МетаданныеРегистра.ПолноеИмя()).СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(Ссылка);
		НаборЗаписей.Прочитать();
		Если НаборЗаписей.Количество() > 0 Тогда
			ЕстьДвиженияРегистра = Истина;
		КонецЕсли;	
	КонецЕсли;	
	
	СтруктураРолей = Новый Структура("РазрешитьПроведение, РазрешитьОтменуПроведения, РазрешитьЗапись, ЭлементыТолькоПросмотр, РазрешитьФормированиеПроводок", Ложь, Ложь, Ложь, Истина, Ложь);
	
	Если ПолучитьФункциональнуюОпцию("ФормированиеПроводокОбособленноОтДокумента") Тогда
		Если Ссылка.Пустая()
			ИЛИ НЕ Ссылка.Проведен 
			ИЛИ ЕстьДвиженияРегистра = Ложь Тогда
			// непроведенный документ могут редактировать кассир и бухгалтер у которого есть право ДобавлениеИзменениеКассовыхДокументов
			СтруктураРолей.ЭлементыТолькоПросмотр	= НЕ РольИзменениеДоступна;
			СтруктураРолей.РазрешитьЗапись			= РольИзменениеДоступна;
			СтруктураРолей.РазрешитьПроведение		= РольПроведенияДоступна;
			
		ИначеЕсли БухгалтерскиеОперацииСервер.ЕстьПроводкиДокумента(Ссылка) Тогда
			// если документ проведен в бух учете, то нельзя редактировать и перепроводить
		Иначе
			// документ проведен в оперативном учете, кассир может с ним делать все что угодно
			СтруктураРолей.ЭлементыТолькоПросмотр	= НЕ РольПроведенияДоступна;
			СтруктураРолей.РазрешитьПроведение 		= РольПроведенияДоступна;
			СтруктураРолей.РазрешитьЗапись			= РольПроведенияДоступна;
		КонецЕсли;
		СтруктураРолей.РазрешитьОтменуПроведения = СтруктураРолей.РазрешитьПроведение;
	Иначе
		Если Ссылка.Пустая()
			ИЛИ НЕ Ссылка.Проведен 
			ИЛИ ЕстьДвиженияРегистра = Ложь Тогда
			// непроведенный документ могут редактировать кассир и бухгалтер у которого есть право ДобавлениеИзменениеКассовыхДокументов
			СтруктураРолей.ЭлементыТолькоПросмотр		= НЕ РольИзменениеДоступна;
			СтруктураРолей.РазрешитьЗапись				= РольИзменениеДоступна;
			СтруктураРолей.РазрешитьПроведение 			= РольПроведенияДоступна;
			СтруктураРолей.РазрешитьОтменуПроведения	= РольПроведенияДоступна;
		ИначеЕсли БухгалтерскиеОперацииСервер.ЕстьПроводкиДокумента(Ссылка) Тогда
			// если документ проведен в бух учете, то бухгалтер может только изменить бух. операцию и перепровести. Кассир может отменить проведение.
			СтруктураРолей.ЭлементыТолькоПросмотр 		= НЕ РольПолныеПраваДоступна;
			СтруктураРолей.РазрешитьОтменуПроведения	= РольПроведенияДоступна;
			СтруктураРолей.РазрешитьЗапись				= РольФормированиеПроводокДоступна;
			СтруктураРолей.РазрешитьФормированиеПроводок= РольФормированиеПроводокДоступна;
			СтруктураРолей.РазрешитьПроведение			= РольПолныеПраваДоступна;
		Иначе
			// документ проведен в оперативном учете. кассир может его менять, а бухгалтер записывать типовую операцию
			СтруктураРолей.ЭлементыТолькоПросмотр		= НЕ РольПроведенияДоступна;
			СтруктураРолей.РазрешитьЗапись				= РольИзменениеДоступна;
			СтруктураРолей.РазрешитьОтменуПроведения	= РольПроведенияДоступна;
			СтруктураРолей.РазрешитьПроведение			= РольПроведенияДоступна;
			СтруктураРолей.РазрешитьФормированиеПроводок= РольФормированиеПроводокДоступна;
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтруктураРолей;
	
КонецФункции

Функция ПолучитьЛимитОстатка(Организация, Подразделение, НаДату) Экспорт
	
	Запрос=Новый Запрос;
	Запрос.УстановитьПараметр("Дата",				НачалоДня(НаДату));
	Запрос.УстановитьПараметр("Организация",		Организация);
	Запрос.УстановитьПараметр("Подразделение",		Подразделение);
	Запрос.УстановитьПараметр("ЕстьПодразделение",	ЗначениеЗаполнено(Подразделение));
	
	Запрос.Текст = "ВЫБРАТЬ
	|	ЛимитыОстаткаКассыСрезПоследних.ЛимитОстаткаКассы КАК ЛимитОстаткаКассы
	|ИЗ
	|	РегистрСведений.ЛимитыОстаткаКассы.СрезПоследних(&Дата, Организация = &Организация) КАК ЛимитыОстаткаКассыСрезПоследних
	|ГДЕ
	|	(&ЕстьПодразделение
	|				И ЛимитыОстаткаКассыСрезПоследних.Подразделение = &Подразделение
	|			ИЛИ НЕ &ЕстьПодразделение
	|				И (ЛимитыОстаткаКассыСрезПоследних.Подразделение ЕСТЬ NULL
	|					ИЛИ ЛимитыОстаткаКассыСрезПоследних.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)))";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ЛимитОстаткаКассы;
	Иначе
		Возврат 0;
	КонецЕсли;	
	
КонецФункции

Функция ЭлектронныеЛистыКассовойКнигиЗаПериод(ДатаНачала, ДатаКонца, Организация, Подразделение) Экспорт
	
	ДниНедели = Новый Массив;
	ДниНедели.Добавить("Понедельник");
	ДниНедели.Добавить("Вторник");
	ДниНедели.Добавить("Среда");
	ДниНедели.Добавить("Четверг");
	ДниНедели.Добавить("Пятница");
	ДниНедели.Добавить("Суббота");
	ДниНедели.Добавить("Воскресенье");
	
	ОрганизацииДляОтбора = Справочники.Организации.ВсеСубъектыУчетаПолномочий(Организация);

	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("НачалоГода",                     НачалоДня(НачалоГода(ДатаНачала)));
	Запрос.УстановитьПараметр("ДатаНачала",						НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаКонца",						КонецДня(ДатаКонца));
	Запрос.УстановитьПараметр("Организация",					ОрганизацииДляОтбора);
	Запрос.УстановитьПараметр("ПоВсемОрганизациям",				Не ЗначениеЗаполнено(Организация));
	Запрос.УстановитьПараметр("ВалютаРегламентированногоУчета", Константы.ВалютаРегламентированногоУчета.Получить());
	Запрос.УстановитьПараметр("Подразделение",					Подразделение);
	Запрос.УстановитьПараметр("ЕстьПодразделение",				ЗначениеЗаполнено(Подразделение));

	Запрос.Текст = "ВЫБРАТЬ
	|	НаличныеДенежныеСредстваОстатки.Валюта КАК Валюта,
	|	&ДатаНачала КАК ДатаОтч,
	|	ЛОЖЬ КАК Фондовый
	|ПОМЕСТИТЬ ДатыИВалютыПредв
	|ИЗ
	|	РегистрНакопления.НаличныеДенежныеСредства.Остатки(
	|			&НачалоГода,
	|			(&ПоВсемОрганизациям
	|				ИЛИ Организация В (&Организация))
	|				И (&ЕстьПодразделение
	|						И Подразделение = &Подразделение
	|					ИЛИ НЕ &ЕстьПодразделение
	|						И (Подразделение ЕСТЬ NULL
	|							ИЛИ Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)))) КАК НаличныеДенежныеСредстваОстатки
	|ГДЕ
	|	НЕ НаличныеДенежныеСредстваОстатки.СуммаОстаток = 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	НаличныеДенежныеСредстваОбороты.Валюта,
	|	&ДатаНачала,
	|	ЛОЖЬ
	|ИЗ
	|	РегистрНакопления.НаличныеДенежныеСредства.Обороты(
	|			&НачалоГода,
	|			&ДатаНачала,
	|			Период,
	|			(&ПоВсемОрганизациям
	|				ИЛИ Организация В (&Организация))
	|				И (&ЕстьПодразделение
	|						И Подразделение = &Подразделение
	|					ИЛИ НЕ &ЕстьПодразделение
	|						И (Подразделение ЕСТЬ NULL
	|							ИЛИ Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)))) КАК НаличныеДенежныеСредстваОбороты
	|ГДЕ
	|	НЕ НаличныеДенежныеСредстваОбороты.СуммаПриход = 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	НаличныеДенежныеСредстваОбороты.Валюта,
	|	НаличныеДенежныеСредстваОбороты.Период,
	|	ЛОЖЬ
	|ИЗ
	|	РегистрНакопления.НаличныеДенежныеСредства.Обороты(
	|			&ДатаНачала,
	|			&ДатаКонца,
	|			День,
	|			(&ПоВсемОрганизациям
	|				ИЛИ Организация В (&Организация))
	|				И (&ЕстьПодразделение
	|						И Подразделение = &Подразделение
	|					ИЛИ НЕ &ЕстьПодразделение
	|						И (Подразделение ЕСТЬ NULL
	|							ИЛИ Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)))) КАК НаличныеДенежныеСредстваОбороты
	|ГДЕ
	|	НЕ НаличныеДенежныеСредстваОбороты.СуммаПриход = 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&ВалютаРегламентированногоУчета,
	|	&ДатаНачала,
	|	ИСТИНА
	|ИЗ
	|	РегистрНакопления.ДенежныеДокументы.Остатки(
	|			&НачалоГода,
	|			(&ПоВсемОрганизациям
	|				ИЛИ Организация В (&Организация))
	|				И (&ЕстьПодразделение
	|						И Подразделение = &Подразделение
	|					ИЛИ НЕ &ЕстьПодразделение
	|						И (Подразделение ЕСТЬ NULL
	|							ИЛИ Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)))) КАК ДенежныеДокументыОстатки
	|ГДЕ
	|	НЕ ДенежныеДокументыОстатки.СуммаОстаток = 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&ВалютаРегламентированногоУчета,
	|	&ДатаНачала,
	|	ИСТИНА
	|ИЗ
	|	РегистрНакопления.ДенежныеДокументы.Обороты(
	|			&НачалоГода,
	|			&ДатаНачала,
