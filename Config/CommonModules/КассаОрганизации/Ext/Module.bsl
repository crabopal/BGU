		|					ИЛИ НЕ ПриходныйОрдерФондовый.Подразделение.ВедетсяКассоваяКнига))
		|	И ПриходныйОрдерФондовый.Дата МЕЖДУ &НачДата И &КонДата
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаПорядка,
		|	Номер";				 
					 
	КонецЕсли;
				 
	Выборка = Запрос.Выполнить().Выбрать();
	
	ОтчетКассира.КассовыеОрдера.Очистить();
	
	Пока Выборка.Следующий() цикл
		
		НовСтр = ОтчетКассира.КассовыеОрдера.Добавить();
		
		ЗаполнитьЗначенияСвойств(НовСтр, Выборка);
		
	КонецЦикла;
	
	// ОСТАТКИ НА КОНЕЦ ДНЯ
	
	ОтчетКассира.ПриходБюджет 		= ОтчетКассира.КассовыеОрдера.Итог("ПриходБюджет");
	ОтчетКассира.РасходБюджет 		= ОтчетКассира.КассовыеОрдера.Итог("РасходБюджет");
	ОтчетКассира.ПриходВнеБюдж 		= ОтчетКассира.КассовыеОрдера.Итог("ПриходВнеБюдж");
	ОтчетКассира.РасходВнеБюдж 		= ОтчетКассира.КассовыеОрдера.Итог("РасходВнеБюдж");
	ОтчетКассира.ПриходУчреждение	= ОтчетКассира.КассовыеОрдера.Итог("ПриходУчреждение");
	ОтчетКассира.РасходУчреждение	= ОтчетКассира.КассовыеОрдера.Итог("РасходУчреждение");
	ОтчетКассира.ПриходВремРасп		= ОтчетКассира.КассовыеОрдера.Итог("ПриходВремРасп");
	ОтчетКассира.РасходВремРасп		= ОтчетКассира.КассовыеОрдера.Итог("РасходВремРасп");

	
	ОтчетКассира.КонецДняБюджет 	= ОтчетКассира.НачалоДняБюджет + ОтчетКассира.ПриходБюджет - ОтчетКассира.РасходБюджет;
	ОтчетКассира.КонецДняВнеБюдж 	= ОтчетКассира.НачалоДняВнеБюдж + ОтчетКассира.ПриходВнеБюдж - ОтчетКассира.РасходВнеБюдж;
	ОтчетКассира.КонецДняУчреждение	= ОтчетКассира.НачалоДняУчреждение + ОтчетКассира.ПриходУчреждение - ОтчетКассира.РасходУчреждение;
	ОтчетКассира.КонецДняВремРасп	= ОтчетКассира.НачалоДняВремРасп + ОтчетКассира.ПриходВремРасп - ОтчетКассира.РасходВремРасп; 
	
	ОтчетКассира.ВсегоПриход 		= ОтчетКассира.ПриходУчреждение + ОтчетКассира.ПриходВремРасп;
	ОтчетКассира.ВсегоРасход 		= ОтчетКассира.РасходУчреждение + ОтчетКассира.РасходВремРасп;
	
КонецПроцедуры //ЗаполнитьОтчетКассираФондовый()

// Процедура заполняет строки документа Отчет кассира по денежной кассе. 
// 
// Параметры: 
// ОтчетКассира - ДокументОбъект.ЛистКассовойКниги 
// 
Процедура ЗаполнитьОтчетКассира(ОтчетКассира) Экспорт
	
	Если ОтчетКассира.ЭтоНовый() Тогда
		ОтчетКассира.УстановитьВремя();
	КонецЕсли;
	
	ОтчетКассира.НомерЛиста = ПолучитьНомерТекущегоЛистаКассовойКниги(ОтчетКассира);
	
	ОтчетКассира.КоличествоЛистов = 1;
	
	ОрганизацииДляОтбора = Справочники.Организации.ВсеСубъектыУчетаПолномочий(ОтчетКассира.Организация);
	
	Запрос=Новый Запрос;
	Запрос.УстановитьПараметр("Дата",				НачалоДня(ОтчетКассира.Дата));
	Запрос.УстановитьПараметр("НачДата",			НачалоДня(ОтчетКассира.Дата));
	Запрос.УстановитьПараметр("КонДата",			КонецДня(ОтчетКассира.Дата));
	Запрос.УстановитьПараметр("Организация",		ОрганизацииДляОтбора);
	Запрос.УстановитьПараметр("ВалютаДокумента",	ОтчетКассира.ВалютаДокумента);
	Запрос.УстановитьПараметр("Подразделение",		ОтчетКассира.Подразделение);
	Запрос.УстановитьПараметр("ЕстьПодразделение",	ЗначениеЗаполнено(ОтчетКассира.Подразделение));
	
	// ОСТАТКИ НА НАЧАЛО ДНЯ
	
	Запрос.Текст="ВЫБРАТЬ
	|	ЕСТЬNULL(СУММА(ВложенныйЗапрос.ОстатокБюджет), 0) КАК НачалоДняБюджет,
	|	ЕСТЬNULL(СУММА(ВложенныйЗапрос.ОстатокВнебюджет), 0) КАК НачалоДняВнеБюдж,
	|	ЕСТЬNULL(СУММА(ВложенныйЗапрос.ОстатокУчреждение), 0) КАК НачалоДняУчреждение,
	|	ЕСТЬNULL(СУММА(ВложенныйЗапрос.ОстатокВремРасп), 0) КАК НачалоДняВремРасп
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВЫБОР
	|			КОГДА НаличныеДенежныеСредстваОстатки.КФО = ЗНАЧЕНИЕ(Перечисление.КВД.Бюджет)
	|				ТОГДА НаличныеДенежныеСредстваОстатки.СуммаОстаток
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК ОстатокБюджет,
	|		ВЫБОР
	|			КОГДА НаличныеДенежныеСредстваОстатки.КФО <> ЗНАЧЕНИЕ(Перечисление.КВД.Бюджет)
	|				ТОГДА НаличныеДенежныеСредстваОстатки.СуммаОстаток
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК ОстатокВнебюджет,
	|		ВЫБОР
	|			КОГДА НаличныеДенежныеСредстваОстатки.КФО <> ЗНАЧЕНИЕ(Перечисление.КВД.ВременноеРаспоряжение)
	|				ТОГДА НаличныеДенежныеСредстваОстатки.СуммаОстаток
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК ОстатокУчреждение,
	|		ВЫБОР
	|			КОГДА НаличныеДенежныеСредстваОстатки.КФО = ЗНАЧЕНИЕ(Перечисление.КВД.ВременноеРаспоряжение)
	|				ТОГДА НаличныеДенежныеСредстваОстатки.СуммаОстаток
	|			ИНАЧЕ 0
	|		КОНЕЦ КАК ОстатокВремРасп
	|	ИЗ
	|		РегистрНакопления.НаличныеДенежныеСредства.Остатки(
	|				&Дата,
	|				Организация В (&Организация)
	|					И Валюта = &ВалютаДокумента) КАК НаличныеДенежныеСредстваОстатки
	|	ГДЕ
	|		(&ЕстьПодразделение
	|					И НаличныеДенежныеСредстваОстатки.Подразделение = &Подразделение
	|				ИЛИ НЕ &ЕстьПодразделение
	|					И (НаличныеДенежныеСредстваОстатки.Подразделение ЕСТЬ NULL 
	|						ИЛИ НаличныеДенежныеСредстваОстатки.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)))) КАК ВложенныйЗапрос";
				 
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	ЗаполнитьЗначенияСвойств(ОтчетКассира, Выборка);
	
	// ДОКУМЕНТЫ ЗА ДЕНЬ
	
	Если ОтчетКассира.ВыводитьКаждуюПроводку Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РасходныйКассовыйОрдер.Ссылка КАК КассовыйДокумент,
		|	ПОДСТРОКА(РасходныйКассовыйОрдер.Выдать, 1, 1000) КАК ОтКогоКому,
		|	НАЧАЛОПЕРИОДА(РасходныйКассовыйОрдер.Дата, ДЕНЬ) КАК Дата,
		|	РасходныйКассовыйОрдер.КорСчет КАК КорСчет,
		|	РасходныйКассовыйОрдер.Дата КАК ДатаПорядка,
		|	РасходныйКассовыйОрдер.Номер КАК Номер,
