	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДатыИВалютыПредв.Валюта КАК Валюта,
	|	МИНИМУМ(ДатыИВалютыПредв.ДатаОтч) КАК ДатаОтч,
	|	ДатыИВалютыПредв.Фондовый КАК Фондовый
	|ИЗ
	|	ДатыИВалютыПредв КАК ДатыИВалютыПредв
	|
	|СГРУППИРОВАТЬ ПО
	|	ДатыИВалютыПредв.Валюта,
	|	ДатыИВалютыПредв.Фондовый"; 
	
	ДатыИВалюты = Запрос.Выполнить().Выгрузить();
	
	МассивДат = Новый Массив;
	Сутки = 24*60*60;
	П1 = КонецДня(ДатаНачала);
	П2 = КонецДня(ДатаКонца)+1;
	Пока П1 < П2 Цикл
		МассивДат.Добавить(НачалоДня(П1));
		П1 = П1 + Сутки;
	КонецЦикла;
	
	ВсеДатыИВалюты = ДатыИВалюты.СкопироватьКолонки();
	
	Для Каждого ДатаИВалюта Из ДатыИВалюты Цикл
		Для Каждого ДатаИзМассива Из МассивДат Цикл
			Если НЕ НачалоДня(ДатаИзМассива) < НачалоДня(ДатаИВалюта.ДатаОтч) Тогда
				НовСтр = ВсеДатыИВалюты.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтр, ДатаИВалюта);
				НовСтр.ДатаОтч = ДатаИзМассива;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Запрос.УстановитьПараметр("ВсеДатыИВалюты", ВсеДатыИВалюты);
	
	Запрос.Текст = "ВЫБРАТЬ
	|	КОНЕЦПЕРИОДА(ВсеДатыИВалюты.ДатаОтч, ДЕНЬ) КАК ДатаОтч,
	|	ВсеДатыИВалюты.Фондовый КАК Фондовый,
	|	ВсеДатыИВалюты.Валюта КАК Валюта
	|ПОМЕСТИТЬ ВсеДатыИВалюты
