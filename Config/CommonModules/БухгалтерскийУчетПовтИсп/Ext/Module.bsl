// Параметры:
//  КодКЭК - Строка - Код КЭК
// 
// Возвращаемое значение:
//  Неопределено, СправочникСсылка.КОСГУ - КЭК по коду
Функция КЭКПоКоду(КодКЭК) Экспорт
	
	Возврат Справочники.КОСГУ.НайтиПоКоду(КодКЭК);
	
КонецФункции

Функция КПСПоКоду(КодКПС, НаДату = Неопределено, ВидКПС = Неопределено) Экспорт
	
	ПустойКПС = Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка();
	
	Если НЕ СтрДлина(КодКПС) = 17 Тогда
		Возврат ПустойКПС;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НаДату) Тогда
		НаДату = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Запрос = Новый Запрос(	"ВЫБРАТЬ ПЕРВЫЕ 1
	                      	|	КлассификационныеПризнакиСчетов.Ссылка КАК Ссылка
	                      	|ИЗ
	                      	|	Справочник.КлассификационныеПризнакиСчетов КАК КлассификационныеПризнакиСчетов
	                      	|ГДЕ
	                      	|	КлассификационныеПризнакиСчетов.Код = &КодКПС
	                      	|	И КлассификационныеПризнакиСчетов.ДатаНачалаДействия <= &НаДату
	                      	|	И КлассификационныеПризнакиСчетов.ДатаОкончанияДействия >= &НаДату
	                      	|	И КлассификационныеПризнакиСчетов.ЭтоГруппа = ЛОЖЬ
	                      	|	И КлассификационныеПризнакиСчетов.ПометкаУдаления = ЛОЖЬ");
	
	Запрос.УстановитьПараметр("КодКПС", КодКПС);
	Запрос.УстановитьПараметр("НаДату", НаДату);
	
	Если ЗначениеЗаполнено(ВидКПС) Тогда
		Запрос.Текст = Запрос.Текст + 	"
										|	И КлассификационныеПризнакиСчетов.ВидПоказателя = &ВидКПС";
		Запрос.УстановитьПараметр("ВидКПС", ВидКПС);
	КонецЕсли;	
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка
	КонецЕсли;
	
	Возврат ПустойКПС;
	
КонецФункции

Функция РазделЛицевогоСчетаПоИсточникуСредств(ЛицевойСчет, ИсточникСредств, ИсполняемыйДоговор = Неопределено) Экспорт 
	
	Если ТипЗНЧ(ИсточникСредств) = Тип("СправочникСсылка.РазделыЛицевыхСчетов") Тогда
		КодПоступления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ИсточникСредств, "КодПоступленияЕБП");
		КФО = ПлатежноРасчетныеДокументыКлиентСервер.КФОПоКодуПоступленияЕБП(КодПоступления); 
	Иначе
		КодПоступления = ПредопределенноеЗначение("Перечисление.КодыПоступленийЕБП.ПустаяСсылка");
		КФО = ПредопределенноеЗначение("Перечисление.КВД.ПустаяСсылка");
	КонецЕсли;  
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	РазделыЛицевыхСчетовДопустимыеКФО.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ РазделыЛСПоКФО
	|ИЗ
	|	Справочник.РазделыЛицевыхСчетов.ДопустимыеКФО КАК РазделыЛицевыхСчетовДопустимыеКФО
	|ГДЕ
	|	РазделыЛицевыхСчетовДопустимыеКФО.Ссылка.Владелец = &Владелец
	|	И РазделыЛицевыхСчетовДопустимыеКФО.КФО = &КФО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РазделыЛицевыхСчетов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.РазделыЛицевыхСчетов КАК РазделыЛицевыхСчетов
	|ГДЕ
	|	РазделыЛицевыхСчетов.Владелец = &Владелец
	|	И ВЫБОР
	|			КОГДА РазделыЛицевыхСчетов.Владелец.МодульИнтеграции = ЗНАЧЕНИЕ(Перечисление.МодулиИнтеграции.ПустаяСсылка)
	|					ИЛИ РазделыЛицевыхСчетов.Владелец.МодульИнтеграции = ЗНАЧЕНИЕ(Перечисление.МодулиИнтеграции.НетИнтеграции)
	|				ТОГДА ВЫБОР ТИПЗНАЧЕНИЯ(&ИсточникСредств)
	|						КОГДА ТИП(Справочник.ИсточникиСредств)
	|							ТОГДА РазделыЛицевыхСчетов.ИсточникСредств = &ИсточникСредств
	|						КОГДА ТИП(Справочник.РазделыЛицевыхСчетов)
	|							ТОГДА РазделыЛицевыхСчетов.Ссылка В
	|									(ВЫБРАТЬ
	|										РазделыЛСПоКФО.Ссылка
	|									ИЗ
	|										РазделыЛСПоКФО)
	|						ИНАЧЕ ИСТИНА
	|					КОНЕЦ
	|			ИНАЧЕ ВЫБОР ТИПЗНАЧЕНИЯ(&ИсточникСредств)
	|					КОГДА ТИП(Справочник.РазделыЛицевыхСчетов)
	|						ТОГДА РазделыЛицевыхСчетов.КодПоступленияЕБП = &КодПоступления
	|					ИНАЧЕ ЛОЖЬ
	|				КОНЕЦ
	|		КОНЕЦ
	|	И НЕ РазделыЛицевыхСчетов.Владелец.КазначейскоеСопровождениеНаРазделах
	|	И РазделыЛицевыхСчетов.ПометкаУдаления = ЛОЖЬ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	РазделыЛицевыхСчетов.Ссылка
	|ИЗ
	|	Справочник.РазделыЛицевыхСчетов КАК РазделыЛицевыхСчетов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Договоры КАК Договоры
	|		ПО РазделыЛицевыхСчетов.Ссылка = Договоры.РазделЛицевогоСчета
	|			И (Договоры.Ссылка = &ИсполняемыйДоговор)
	|			И (Договоры.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПокупателем)
	|				ИЛИ Договоры.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СОтправителемТрансферта))
	|ГДЕ
	|	РазделыЛицевыхСчетов.Владелец = &Владелец
	|	И ВЫБОР
	|			КОГДА РазделыЛицевыхСчетов.Владелец.МодульИнтеграции = ЗНАЧЕНИЕ(Перечисление.МодулиИнтеграции.ПустаяСсылка)
	|					ИЛИ РазделыЛицевыхСчетов.Владелец.МодульИнтеграции = ЗНАЧЕНИЕ(Перечисление.МодулиИнтеграции.НетИнтеграции)
	|				ТОГДА ВЫБОР ТИПЗНАЧЕНИЯ(&ИсточникСредств)
	|						КОГДА ТИП(Справочник.ИсточникиСредств)
	|							ТОГДА РазделыЛицевыхСчетов.ИсточникСредств = &ИсточникСредств
	|						КОГДА ТИП(Справочник.РазделыЛицевыхСчетов)
	|							ТОГДА РазделыЛицевыхСчетов.Ссылка В
	|									(ВЫБРАТЬ
	|										РазделыЛСПоКФО.Ссылка
	|									ИЗ
	|										РазделыЛСПоКФО)
	|						ИНАЧЕ ЛОЖЬ
	|					КОНЕЦ
	|			ИНАЧЕ ВЫБОР ТИПЗНАЧЕНИЯ(&ИсточникСредств)
	|					КОГДА ТИП(Справочник.РазделыЛицевыхСчетов)
	|						ТОГДА РазделыЛицевыхСчетов.КодПоступленияЕБП = &КодПоступления
	|					ИНАЧЕ ЛОЖЬ
	|				КОНЕЦ
	|		КОНЕЦ
	|	И РазделыЛицевыхСчетов.Владелец.КазначейскоеСопровождениеНаРазделах
	|	И РазделыЛицевыхСчетов.ПометкаУдаления = ЛОЖЬ");
	
	Запрос.УстановитьПараметр("Владелец", ЛицевойСчет); 
	Запрос.УстановитьПараметр("КФО", КФО);
	Запрос.УстановитьПараметр("ИсточникСредств", ИсточникСредств); 
	Запрос.УстановитьПараметр("КодПоступления", КодПоступления); 
	Запрос.УстановитьПараметр("ИсполняемыйДоговор", ИсполняемыйДоговор);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.РазделыЛицевыхСчетов.ПустаяСсылка();
	
КонецФункции

// Определяет номер журнала по счетам дебета и кредита
// 
// Параметры:
//	СчетДт - ПланСчетовСсылка.ЕПСБУ - Счет дебета
//	СчетКт - ПланСчетовСсылка.ЕПСБУ - Счет кредита
//
// Возвращаемое значение:
//  СправочникСсылка.Журналы
Функция НомерЖурнала(Знач СчетДт, Знач СчетКт) Экспорт
	
	ПустойЖурнал = Справочники.Журналы.ПустаяСсылка();
	
	ПараметрыСчетДт = ПолучитьСвойстваСчета(СчетДт);
    ПараметрыСчетКт = ПолучитьСвойстваСчета(СчетКт);
	
	Если ПараметрыСчетДт = Неопределено И  ПараметрыСчетКт = Неопределено Тогда
		Возврат (ПустойЖурнал);
	КонецЕсли;
	
	Если ПараметрыСчетДт = Неопределено Тогда
		Если НЕ ПараметрыСчетКт.Забалансовый Тогда
			Возврат (ПустойЖурнал);
		Иначе
			ПараметрыСчетДт = ПараметрыСчетКт;
		КонецЕсли;
	КонецЕсли;
	
	Если ПараметрыСчетКт = Неопределено Тогда
		Если НЕ ПараметрыСчетДт.Забалансовый = Ложь Тогда
			Возврат (ПустойЖурнал);
		Иначе
			ПараметрыСчетКт = ПараметрыСчетДт;
		КонецЕсли;
	КонецЕсли; 
	
	ПриоритетДт = ?(ЗначениеЗаполнено(ПараметрыСчетДт.НомерЖурналаПриоритет), ПараметрыСчетДт.НомерЖурналаПриоритет, 0);
	ПриоритетКт = ?(ЗначениеЗаполнено(ПараметрыСчетКт.НомерЖурналаПриоритет), ПараметрыСчетКт.НомерЖурналаПриоритет, 0);
	
	Если ПриоритетДт = ПриоритетКт Тогда
		Если ЗначениеЗаполнено(ПараметрыСчетКт.НомерЖурнала) Тогда
			Возврат (ПараметрыСчетКт.НомерЖурнала);  
		Иначе
			Возврат (ПараметрыСчетДт.НомерЖурнала);  
		КонецЕсли;
	Иначе 
		Если ПриоритетДт = 0 Тогда
			Возврат (ПараметрыСчетКт.НомерЖурнала); 
		ИначеЕсли ПриоритетКт = 0 Тогда  
			Возврат (ПараметрыСчетДт.НомерЖурнала);
		ИначеЕсли ПриоритетДт < ПриоритетКт Тогда
			Возврат (ПараметрыСчетДт.НомерЖурнала);
		Иначе	
			Возврат (ПараметрыСчетКт.НомерЖурнала);
		КонецЕсли;
	КонецЕсли;
	
	Возврат (ПустойЖурнал);

КонецФункции

// Возвращаемое значение:
//   Соответствие из КлючИЗначение:
//    * Ключ - Тип - тип объекта
//    * Значение - Строка - имя реквизита связи
//
Функция ТипыСубконтоСвязанныеСОрганизацией() Экспорт
	
	Результат = Новый Соответствие;
	
	ТипыВидовСубконто     = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	МетаданныеОрганизации = Метаданные.Справочники.Организации;
	
	Для каждого Тип Из ТипыВидовСубконто.Типы() Цикл
		
		Если Справочники.ТипВсеСсылки().СодержитТип(Тип) Тогда
			
			ОбъектМетаданных = Метаданные.НайтиПоТипу(Тип);
			
			Если ОбъектМетаданных.Владельцы.Количество() > 0
				И ОбъектМетаданных.Владельцы.Содержит(МетаданныеОрганизации) Тогда
				Результат.Вставить(Тип, "Владелец");
			КонецЕсли;

			Если ОбъектМетаданных.Реквизиты.Найти("Организация") <> Неопределено Тогда
				Результат.Вставить(Тип, "Организация");
			КонецЕсли;
			
		ИначеЕсли Документы.ТипВсеСсылки().СодержитТип(Тип) Тогда

			Результат.Вставить(Тип, "Организация");
			
		КонецЕсли;	   
		
	КонецЦикла;
	
	Результат.Вставить(Тип("СправочникСсылка.РазделыЛицевыхСчетов"), "Организация");

	Возврат Результат;

КонецФункции

// Работа с метаданными.

Функция ПолучитьДеревоМетаданныхДокумента(ИмяДокумента, ПараметрыФункциональныхОпций = Неопределено, НеиспользуемыеРеквизиты = Неопределено) Экспорт
	
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("Строка"));
	КС = Новый КвалификаторыСтроки();
	ОписаниеСтр = Новый ОписаниеТипов(МассивТипов,КС);
	
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("Булево"));
	ОписаниеБулево = Новый ОписаниеТипов(МассивТипов);
	
	
	Если Метаданные.Документы.Найти(ИмяДокумента) = Неопределено Тогда
		ДеревоРеквизитов = Новый ДеревоЗначений;
		ДеревоРеквизитов.Колонки.Добавить("Имя", ОписаниеСтр); 
		ДеревоРеквизитов.Колонки.Добавить("КодДляФормулы", ОписаниеСтр);
		ДеревоРеквизитов.Колонки.Добавить("Таблица", ОписаниеБулево);
		ДеревоРеквизитов.Колонки.Добавить("Поле", ОписаниеСтр);
		
		СписокТаблиц =Новый Массив;
		СписокТаблиц.Добавить("<>");
		Возврат Новый Структура("ДеревоРеквизитов, СписокТаблиц", ДеревоРеквизитов, СписокТаблиц); 	
	КонецЕсли;
		
	ПредставлениеДокумента = Метаданные.Документы[ИмяДокумента].Синоним;
	
	СхемаКомпоновки = Новый СхемаКомпоновкиДанных;
	
	ИсточникДанных = СхемаКомпоновки.ИсточникиДанных.Добавить();
	ИсточникДанных.ТипИсточникаДанных = "Local";
	ИсточникДанных.Имя = "ЭтаИБ";
	
	НаборДанных = СхемаКомпоновки.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
	
	НаборДанных.АвтоЗаполнениеДоступныхПолей = Истина;
	НаборДанных.ИсточникДанных  = ИсточникДанных.Имя;
	НаборДанных.Имя = "РеквизитыДокумента";
	НаборДанных.Запрос = " ВЫБРАТЬ
						   |	ВыбДокумент.*
						   |ИЗ
						   |	Документ." + ИмяДокумента + " КАК ВыбДокумент";
	
										   
	ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновки, ПараметрыФункциональныхОпций);
	
	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(ИсточникНастроек);

	ДеревоРеквизитов = Новый ДеревоЗначений;
	ДеревоРеквизитов.Колонки.Добавить("Имя", ОписаниеСтр); 
	ДеревоРеквизитов.Колонки.Добавить("КодДляФормулы", ОписаниеСтр);
	ДеревоРеквизитов.Колонки.Добавить("Таблица", ОписаниеБулево);
	ДеревоРеквизитов.Колонки.Добавить("Поле", ОписаниеСтр);
	СписокТаблиц =Новый Массив;
	
	Корневой = ДеревоРеквизитов.Строки.Добавить();
	Корневой.Имя = ПредставлениеДокумента;
	Корневой.КодДляФормулы = "Документ";
	СписокТаблиц.Добавить("<>");
	
	ЗаполнитьДеревоРеквизитов(Корневой, Компоновщик.Настройки.ДоступныеПоляВыбора.Элементы, СписокТаблиц,, 0);
	
	Если НеиспользуемыеРеквизиты<>Неопределено Тогда
		Если ТипЗнч(НеиспользуемыеРеквизиты) = Тип("Строка") Тогда
			МассивНеиспользуемыхРеквизитов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(НеиспользуемыеРеквизиты, ",");
		ИначеЕсли ТипЗнч(НеиспользуемыеРеквизиты) = Тип("Массив") Тогда
			МассивНеиспользуемыхРеквизитов = НеиспользуемыеРеквизиты;
		Иначе
			МассивНеиспользуемыхРеквизитов = Неопределено;
		КонецЕсли;
		Если МассивНеиспользуемыхРеквизитов <> Неопределено Тогда
			Для каждого ТекРеквизит Из МассивНеиспользуемыхРеквизитов Цикл
			
				СтрокаРеквизита = Корневой.Строки.Найти(ТекРеквизит, "Поле");
				Если СтрокаРеквизита<>Неопределено Тогда
					Корневой.Строки.Удалить(СтрокаРеквизита);
				КонецЕсли;
			
			КонецЦикла; 	
		КонецЕсли;
	КонецЕсли;
	
	Возврат Новый Структура("ДеревоРеквизитов, СписокТаблиц", ДеревоРеквизитов, СписокТаблиц);
	
КонецФункции

// Получить массив реквизитов типа счет.
// 
// Параметры:
//  ТипОбъектаМетаданных - Строка - Тип объекта метаданных
//  ИмяОбъектаМетаданных - Строка - Имя объекта метаданных
// 
// Возвращаемое значение:
//  Массив из Строка - имена реквизитов
Функция ПолучитьМассивРеквизитовТипаСчет(ТипОбъектаМетаданных = "Документы", ИмяОбъектаМетаданных) Экспорт
	
	МассивРеквизитов = Новый Массив;
	
	ТипПС = ТекущийПланСчетов();
	
	МетаданныеРеквизитов = Метаданные[ТипОбъектаМетаданных][ИмяОбъектаМетаданных].Реквизиты;
	
	Для Каждого Реквизит ИЗ МетаданныеРеквизитов Цикл
		
		Если Реквизит.Тип.СодержитТип(ТипПС) Тогда
			
			МассивРеквизитов.Добавить(Реквизит.Имя);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МассивРеквизитов;
	
КонецФункции

// Возвращает список наименований объектов метаданных заданного типа
//
Функция ПолучитьМассивВидовОбъектовМетаданных(ТипОбъектаМетаданных = "Документы") Экспорт

	МассивОбъектов = Новый Массив;
	МетаданныеОбъектов = Метаданные[ТипОбъектаМетаданных];
	Для Каждого ТекОбъект ИЗ МетаданныеОбъектов Цикл
		
		МассивОбъектов.Добавить(ТекОбъект.Имя);
		
	КонецЦикла;
	
	Возврат МассивОбъектов;
		
КонецФункции

Функция ПолучитьМассивРеквизитовОбъекта(ТипОбъектаМетаданных = "Документы", ИмяОбъектаМетаданных) Экспорт
	
	МассивРеквизитов = Новый Массив;
	
	МетаданныеРеквизитов = Метаданные[ТипОбъектаМетаданных][ИмяОбъектаМетаданных].Реквизиты;
	
	Для Каждого Реквизит ИЗ МетаданныеРеквизитов Цикл
		
		МассивРеквизитов.Добавить(Реквизит.Имя);
		
	КонецЦикла;
	
	Возврат МассивРеквизитов;
	
КонецФункции

Функция ПолучитьСписокРеквизитовОбъекта(ТипОбъектаМетаданных = "Документы", ИмяОбъектаМетаданных) Экспорт
	
	СписокРеквизитов = Новый СписокЗначений;
	
	МетаданныеРеквизитов = Метаданные[ТипОбъектаМетаданных][ИмяОбъектаМетаданных].Реквизиты;
	
	Для Каждого Реквизит ИЗ МетаданныеРеквизитов Цикл
		
		СписокРеквизитов.Добавить(Реквизит.Имя, ?(ПустаяСтрока(Реквизит.Синоним), Реквизит.Имя, Реквизит.Синоним));
		
	КонецЦикла;
	
	Возврат СписокРеквизитов;
	
КонецФункции

Функция ПолучитьСписокРеквизитовОбъектаМетаданных(ОбъектМетаданные) Экспорт
	
	СписокРеквизитов = Новый СписокЗначений;
	
	ОбъектМД = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(ОбъектМетаданные);
	
	Если ТипЗнч(ОбъектМД) = Тип("КоллекцияОбъектовМетаданных") Тогда
		Возврат СписокРеквизитов;
	КонецЕсли;	
	
	МетаданныеРеквизитов = ОбъектМД.Реквизиты;
	
	Для Каждого Реквизит ИЗ МетаданныеРеквизитов Цикл
		СписокРеквизитов.Добавить(Реквизит.Имя, ?(ПустаяСтрока(Реквизит.Синоним), Реквизит.Имя, Реквизит.Синоним));
	КонецЦикла;  
	
	Для Каждого ТабЧасть ИЗ ОбъектМД.ТабличныеЧасти Цикл
		ИмяТабЧасти = ТабЧасть.Имя;
		СинонимТабЧасти = ?(ПустаяСтрока(ТабЧасть.Синоним), ИмяТабЧасти, ТабЧасть.Синоним); 
		Для Каждого Реквизит ИЗ ТабЧасть.Реквизиты Цикл  
			СписокРеквизитов.Добавить(ИмяТабЧасти + "." + Реквизит.Имя, СинонимТабЧасти + "." + ?(ПустаяСтрока(Реквизит.Синоним), Реквизит.Имя, Реквизит.Синоним));
		КонецЦикла;	
	КонецЦикла;	
	
	Возврат СписокРеквизитов;
	
КонецФункции

// Учетная политика.

// Возвращает структуру, содержащую элементы учетной политики организации
//
Функция УчетнаяПолитикаОрганизации(Организация, НаДату = Неопределено) Экспорт
	
	Возврат Справочники.Организации.ПолучитьУчетнуюПолитику(Организация, НаДату);
	
КонецФункции

Функция ТекущаяСтруктураРПС(Организация, ИФО = Неопределено, НаДату = Неопределено) Экспорт
	
	Результат = Справочники.СтруктурыРПС.ПустаяСсылка();
	
	Если ЗначениеЗаполнено(Организация) Тогда
		
		Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") И ЗначениеЗаполнено(ИФО) Тогда
			Запрос = Новый Запрос("ВЫБРАТЬ
			|	НастройкиИспользованияРПС.СтруктураРПС
			|ИЗ
			|	РегистрСведений.НастройкиИспользованияРПС КАК НастройкиИспользованияРПС
			|ГДЕ
			|	НастройкиИспользованияРПС.Организация = &Организация
			|	И НастройкиИспользованияРПС.ИФО = &ИФО");
			Запрос.УстановитьПараметр("Организация", Организация);
			Запрос.УстановитьПараметр("ИФО", ИФО);
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Результат = Выборка.СтруктураРПС;
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Результат) Тогда
			Результат = УчетнаяПолитикаОрганизации(Организация, НаДату).СтруктураРПС;
		КонецЕсли;
		
	КонецЕсли;

	Возврат Результат;
	
КонецФункции

Функция ТекущийТипПланаСчетов(Организация, ИФО = Неопределено, НаДату = Неопределено) Экспорт
	
	ТекСтруктураРПС = ТекущаяСтруктураРПС(Организация, ИФО, НаДату);
	
	Если ТекСтруктураРПС = Неопределено Тогда
		
		Возврат ПредопределенноеЗначение("Перечисление.ТипыПлановСчетов.ПустаяСсылка");
		
	Иначе
	
		Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекСтруктураРПС, "ТипПланаСчетов");
		
	КонецЕсли;
	
КонецФункции

Функция ВидыКПСПоУчетнойПолитике(Организация, ИФО = Неопределено, КФО = Неопределено, НаДату = Неопределено) Экспорт
	
	Результат = Новый Массив;
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	НастройкиСтруктурРПС.ТипКПС
	|ИЗ
	|	РегистрСведений.НастройкиСтруктурРПС КАК НастройкиСтруктурРПС
	|ГДЕ
	|	НастройкиСтруктурРПС.СтруктураРПС = &СтруктураРПС");
	
	Запрос.УстановитьПараметр("СтруктураРПС", ТекущаяСтруктураРПС(Организация, ИФО, НаДату)); 
	
	Если ЗначениеЗаполнено(КФО) Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И НастройкиСтруктурРПС.КФО = &КФО";
		Запрос.УстановитьПараметр("КФО", КФО); 
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ТипКПС = Перечисления.ТипыАналитическихПризнаков.БюджетнаяКлассификация Тогда
			Результат.Добавить(Перечисления.ВидыКБК.гКБК);
			Результат.Добавить(Перечисления.ВидыКБК.КДБ);
			Результат.Добавить(Перечисления.ВидыКБК.КИФ);
			Результат.Добавить(Перечисления.ВидыКБК.КРБ);
		ИначеЕсли Выборка.ТипКПС = Перечисления.ТипыАналитическихПризнаков.КлассификацияАУБУ Тогда
			Результат.Добавить(Перечисления.ВидыКБК.АУИБУ);
		ИначеЕсли Выборка.ТипКПС = Перечисления.ТипыАналитическихПризнаков.ПроизвольнаяКлассификация Тогда
			Результат.Добавить(Перечисления.ВидыКБК.Произвольный);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;
	
КонецФункции

// Допустимые КФО по учетной политике.
// 
// Параметры:
//  Организация - СправочникСсылка.Организации
//  ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения - ИФО
//  НаДату - Дата - На дату
// 
// Возвращаемое значение:
//  Массив из ПеречислениеСсылка.КВД - КФО по учетной политике
Функция КФОПоУчетнойПолитике(Организация, ИФО = Неопределено, НаДату = Неопределено) Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	НастройкиСтруктурРПС.КФО КАК КФО
	                      |ИЗ
	                      |	РегистрСведений.НастройкиСтруктурРПС КАК НастройкиСтруктурРПС
	                      |ГДЕ
	                      |	НастройкиСтруктурРПС.СтруктураРПС = &СтруктураРПС
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	НастройкиСтруктурРПС.КФО.Порядок");
	
	Запрос.УстановитьПараметр("СтруктураРПС", ТекущаяСтруктураРПС(Организация, ИФО, НаДату)); 
	
	Выборка = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("КФО");
	
	Возврат Выборка;
	
КонецФункции

Функция ТипКЭКПоУчетнойПолитике(Организация, ИФО = Неопределено, КФО = Неопределено, НаДату = Неопределено) Экспорт
	
