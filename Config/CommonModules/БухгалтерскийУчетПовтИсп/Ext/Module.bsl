// Возвращает массив имен метаданных-документов, у которых курс иностранной валюты
// может быть получен из регистра сведений "СостояниеПлатежноРасчетныхДокументов"
// Возвращаемое значение:
// ФиксированныйМассив - Массив объектов типа Строка, например "ЗаявкаНаКассовыйРасход"
Функция ДокументыСКурсомИностраннойВалютыВРегистреСостояниеПРД() Экспорт
	
	МассивДокументов = Новый Массив;
	
	МассивДокументов.Добавить("ЗаявкаНаКассовыйРасход");
	
	Возврат Новый ФиксированныйМассив(МассивДокументов);
	
КонецФункции

// Возвращает виды документов- регистраторов регистра бухгалтерии.
// Возвращаемое значение:
// ФиксированныйМассив - Массив объектов типа СправочникСсылка.ИдентификаторыОбъектовМетаданных
Функция ВидыДокументовРегистраторовРБ() Экспорт

	Результат = Новый Массив;
	
	Для каждого ТипПараметра Из Метаданные.ОпределяемыеТипы.РегистраторыРегистраБухгалтерии.Тип.Типы() Цикл
	
		Результат.Добавить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипПараметра));
	
	КонецЦикла;
	Результат.Добавить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Тип("ДокументСсылка.ОперацияБух")));
	
	Возврат Новый ФиксированныйМассив(Результат);

КонецФункции // ВидыДокументовРегистраторовРБ()

