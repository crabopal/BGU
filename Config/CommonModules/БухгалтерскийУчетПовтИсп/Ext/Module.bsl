// Устарела. Более не используется.
Функция ПолучитьСписокПриемовПищи(КатегорияДовольствующихся = Неопределено) Экспорт
	Запрос = Новый Запрос;
	Если КатегорияДовольствующихся = Неопределено Тогда
		Запрос.Текст = "ВЫБРАТЬ
		               |	ПриемыПищи.Ссылка,
		               |	ПриемыПищи.Код,
		               |	ПриемыПищи.Наименование
		               |ИЗ
		               |	Справочник.ПриемыПищи КАК ПриемыПищи
		               |АВТОУПОРЯДОЧИВАНИЕ";
	Иначе
		Запрос.Текст = "ВЫБРАТЬ
		               |	КатегорииДовольствующихсяПриемыПищи.ПриемПищи.Ссылка КАК Ссылка,
		               |	КатегорииДовольствующихсяПриемыПищи.ПриемПищи.Код КАК Код,
		               |	КатегорииДовольствующихсяПриемыПищи.ПриемПищи.Наименование Как Наименование
		               |ИЗ
		               |	Справочник.КатегорииДовольствующихся.ПриемыПищи КАК КатегорииДовольствующихсяПриемыПищи
		               |ГДЕ
		               |	КатегорииДовольствующихсяПриемыПищи.Ссылка = &КатегорияДовольствующихся
		               |АВТОУПОРЯДОЧИВАНИЕ";
		Запрос.УстановитьПараметр("КатегорияДовольствующихся", КатегорияДовольствующихся);
		
	КонецЕсли;
	СписокЗначений = Новый СписокЗначений;
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат СписокЗначений;
	КонецЕсли;
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		СписокЗначений.Добавить(Новый Структура("Ссылка, Код", Выборка.Ссылка, Выборка.Код), Выборка.Наименование);
	КонецЦикла;
	Возврат СписокЗначений;
КонецФункции

