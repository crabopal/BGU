#Область ПрограммныйИнтерфейс

// Работа с планом счетов, счетами, субконто, КПС, КЭК.

// Текущий план счетов.
// 
// Возвращаемое значение:
//  Тип - Текущий план счетов
Функция ТекущийПланСчетов() Экспорт
	
	// Изменить после разработки механизма.
	ИмяПланаСчетов = Строка(Константы.ОсновнойПланСчетов.Получить());
	
	ТипПС = Тип("ПланСчетовСсылка.ЕПСБУ");
	Возврат ТипПС;
	
КонецФункции

// Дата перехода на редакцию ПС.
// 
// Параметры:
//  Организация - СправочникСсылка.Организации
//  Период - Дата
// 
// Возвращаемое значение:
//  Дата - Дата перехода на редакцию ПС
Функция ДатаПереходаНаРедакциюПС(Знач Организация, Знач Период) Экспорт
	
	ДатаПерехода = '00010101';
	
	Если Период >= Дата('20190101') Тогда
		ПараметрРедакцияПС = ПредопределенноеЗначение("Перечисление.РедакцииПланаСчетов.Приказ298н2019");
	ИначеЕсли Период >= Дата('20180101') Тогда	
		ПараметрРедакцияПС = ПредопределенноеЗначение("Перечисление.РедакцииПланаСчетов.Приказ64н2018");
	Иначе
		ПараметрРедакцияПС = ПредопределенноеЗначение("Перечисление.РедакцииПланаСчетов.ПустаяСсылка");
	КонецЕсли;	
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ
	|	ДатыПереходаНаПрименениеРедакцийПС.ДатаНачалаПрименения КАК ДатаНачалаПрименения
	|ИЗ
	|	РегистрСведений.ДатыПереходаНаПрименениеРедакцийПС КАК ДатыПереходаНаПрименениеРедакцийПС
	|ГДЕ
	|	ДатыПереходаНаПрименениеРедакцийПС.Организация = &Организация
	|	И ДатыПереходаНаПрименениеРедакцийПС.РедакцияПС = &РедакцияПС");
	
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("РедакцияПС", ПараметрРедакцияПС);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ДатаПерехода = Выборка.ДатаНачалаПрименения;
	ИначеЕсли ПараметрРедакцияПС = ПредопределенноеЗначение("Перечисление.РедакцииПланаСчетов.Приказ298н2019") Тогда
		ДатаПерехода = Дата('20181231');
	КонецЕсли;
	
	Возврат НачалоДня(ДатаПерехода);
	
КонецФункции

Функция ПроверитьСоответствиеСчетаПлануСчетов(Счет,ТипПланаСчетов) Экспорт
	
	Соответствует = Ложь;
	Если ЗначениеЗаполнено(Счет) Тогда
		мПараметрыСчета   = ПолучитьСвойстваСчета(Счет);
		Если мПараметрыСчета = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТипПланаСчетов) Тогда
		Если ТипПланаСчетов = Перечисления.ТипыПлановСчетов.ДляАвтономных Тогда
			Если мПараметрыСчета.ДляАвтономных Тогда
				Соответствует = Истина;
			КонецЕсли;
		ИначеЕсли ТипПланаСчетов = Перечисления.ТипыПлановСчетов.ДляБюджетных Тогда
			Если мПараметрыСчета.ДляБюджетных Тогда
				Соответствует = Истина;
			КонецЕсли;
		ИначеЕсли ТипПланаСчетов = Перечисления.ТипыПлановСчетов.ДляКазенных Тогда
			Если мПараметрыСчета.ДляКазенных Тогда
				Соответствует = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Соответствует;
	
КонецФункции

Функция ПолучитьСоответствиеИменСправочниковРеквизитамКПС() Экспорт
	
	МДС = Метаданные.Справочники;
	Реквизиты = МДС.КлассификационныеПризнакиСчетов.Реквизиты;
	
	Результат = Новый Соответствие;
	
	Результат.Вставить(МДС.ВидыДоходовКДБ.Имя,         			Реквизиты.ВидДоходаКДБ.Имя);
	Результат.Вставить(МДС.ГруппыПодвидовКДБ.Имя,         		Реквизиты.ГруппаПодвидаКДБ.Имя);
	
	Результат.Вставить(МДС.РазделыПодразделыКРБ.Имя,         	Реквизиты.РазделПодразделКРБ.Имя);
	Результат.Вставить(МДС.ЦелевыеСтатьиКРБ.Имя,             	Реквизиты.ЦелеваяСтатьяКРБ.Имя);
	Результат.Вставить(МДС.ПрограммыЦелевыхСтатейКРБ.Имя,    	Реквизиты.ПрограммаЦелевойСтатьиКРБ.Имя);
	Результат.Вставить(МДС.ВидыРасходовКРБ.Имя,              	Реквизиты.ВидРасходаКРБ.Имя);
	
	Результат.Вставить(МДС.ГруппыПодгруппыКИФ.Имя, 				Реквизиты.ГруппаПодгруппаКИФ.Имя);
	Результат.Вставить(МДС.СтатьиКИФ.Имя,          				Реквизиты.СтатьяКИФ.Имя);
	Результат.Вставить(МДС.ВидыКИФ.Имя,            				Реквизиты.ВидКИФ.Имя);
	
	Возврат Новый ФиксированноеСоответствие(Результат);
	
КонецФункции

// Получить свойства счета.
// 
// Параметры:
//  Счет - ПланСчетовСсылка.ЕПСБУ
// 
// Возвращаемое значение:
//  Неопределено, Структура - Получить свойства счета:
// * Ссылка - ПланСчетовСсылка.ЕПСБУ -
// * Наименование - Строка-
// * Код - Строка
// * Родитель - ПланСчетовСсылка.ЕПСБУ -
// * Наименование - Строка
// * Вид - ВидСчета
// * Забалансовый - Булево
// * ЗапретитьИспользоватьВПроводках - Булево
// * НомерЖурнала - СправочникСсылка.Журналы
// * НомерЖурналаПриоритет - Число
// * УчетПоКПС - Булево
// * УчетПоКЭК - Булево
// * УчетПоПодразделениям - Булево
// * РазрешитьНеУказыватьПодразделение - Булево
// * НалоговыйУчетНеУчитываемых - Булево
// * НалоговыйУчетЕНВД - Булево
// * НалоговыйУчетНДС - Булево
// * КОСГУДт - СправочникСсылка.КОСГУ
// * КОСГУКт - СправочникСсылка.КОСГУ
// * ДляКазенных - Булево
// * ДляБюджетных - Булево
// * ДляАвтономных - Булево
// * Валютный - Булево
// * Количественный - Булево
// * ЭлементГруппа - Булево
// * ТипСчета - ПеречислениеСсылка.ТипыСчетов
// * КоличествоСубконто - Число
// * ДатаНачалаДействия - Дата
// * ДатаОкончанияДействия - Дата
// * ВидСубконто1 - ПланВидовХарактеристикСсылка.ВидыСубконто
// * ВидСубконто1Наименование - Строка
// * ВидСубконто1ТипЗначения - ОписаниеТипов
// * ВидСубконто1Суммовой - Булево
// * ВидСубконто1ТолькоОбороты - Булево
// * ВидСубконто1Валютный - Булево
// * ВидСубконто1Количественный - Булево
// * ВидСубконто1Обязательный - Булево
// * ВидСубконто2 - ПланВидовХарактеристикСсылка.ВидыСубконто
// * ВидСубконто2Наименование - Строка
// * ВидСубконто2ТипЗначения - ОписаниеТипов
// * ВидСубконто2Суммовой - Булево
// * ВидСубконто2ТолькоОбороты - Булево
// * ВидСубконто2Валютный - Булево
// * ВидСубконто2Количественный - Булево
// * ВидСубконто2Обязательный - Булево
// * ВидСубконто3 - ПланВидовХарактеристикСсылка.ВидыСубконто
// * ВидСубконто3Наименование - Строка
// * ВидСубконто3ТипЗначения - ОписаниеТипов
// * ВидСубконто3Суммовой - Булево
// * ВидСубконто3ТолькоОбороты - Булево
// * ВидСубконто3Валютный - Булево
// * ВидСубконто3Количественный - Булево
// * ВидСубконто3Обязательный - Булево
//
Функция ПолучитьСвойстваСчета(Счет) Экспорт
	
	Если НЕ (ОбщегоНазначения.ЗначениеСсылочногоТипа(Счет) И ОбщегоНазначения.ВидОбъектаПоСсылке(Счет) = "ПланСчетов") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДанныеСчета = Новый Структура;
	
	ДанныеСчета.Вставить("Ссылка",							Счет.Ссылка);
	ДанныеСчета.Вставить("Наименование",					Счет.Наименование);
	ДанныеСчета.Вставить("Код",								Счет.Код);
	ДанныеСчета.Вставить("Родитель",						Счет.Родитель);
	ДанныеСчета.Вставить("Наименование",					Счет.Наименование);
	ДанныеСчета.Вставить("Вид",								Счет.Вид);
	ДанныеСчета.Вставить("Забалансовый",					Счет.Забалансовый);
	ДанныеСчета.Вставить("ЗапретитьИспользоватьВПроводках",	Счет.ЗапретитьИспользоватьВПроводках);
	ДанныеСчета.Вставить("НомерЖурнала",					Счет.НомерЖурнала);
	ДанныеСчета.Вставить("НомерЖурналаПриоритет",			Счет.НомерЖурнала.Приоритет);
	ДанныеСчета.Вставить("УчетПоКПС",						Счет.УчетПоКПС);
	ДанныеСчета.Вставить("УчетПоКЭК",						Счет.УчетПоКЭК);
	ДанныеСчета.Вставить("УчетПоПодразделениям",			Счет.УчетПоПодразделениям);
	ДанныеСчета.Вставить("РазрешитьНеУказыватьПодразделение", Счет.РазрешитьНеУказыватьПодразделение);
	ДанныеСчета.Вставить("НалоговыйУчетНеУчитываемых",		Счет.НалоговыйУчетНеУчитываемых);
	ДанныеСчета.Вставить("НалоговыйУчетЕНВД",				Счет.НалоговыйУчетЕНВД);
	ДанныеСчета.Вставить("НалоговыйУчетНДС",				Счет.НалоговыйУчетНДС);
	ДанныеСчета.Вставить("КОСГУДт",							Счет.КОСГУДт);
	ДанныеСчета.Вставить("КОСГУКт",							Счет.КОСГУКт);
	ДанныеСчета.Вставить("БезДетализацииКОСГУ",				Счет.БезДетализацииКОСГУ);
	ДанныеСчета.Вставить("ДляКазенных",						Счет.ДляКазенных);
	ДанныеСчета.Вставить("ДляБюджетных",					Счет.ДляБюджетных);
	ДанныеСчета.Вставить("ДляАвтономных",					Счет.ДляАвтономных);
	ДанныеСчета.Вставить("Валютный",						Счет.Валютный);
	ДанныеСчета.Вставить("Количественный",					Счет.Количественный);
	ДанныеСчета.Вставить("ЭлементГруппа",					Счет.ЭлементГруппа);
	ДанныеСчета.Вставить("ТипСчета",						Счет.ТипСчета);
	ДанныеСчета.Вставить("КоличествоСубконто",				Счет.ВидыСубконто.Количество());
	
	ДанныеСчета.Вставить("ДатаНачалаДействия",		Счет.ДатаНачалаДействия);
	ДанныеСчета.Вставить("ДатаОкончанияДействия",	Счет.ДатаОкончанияДействия);
	// Дату окончания действия для удобства сразу приведем к концу дня.
	Если ЗначениеЗаполнено(ДанныеСчета.ДатаОкончанияДействия) Тогда
		ДанныеСчета.ДатаОкончанияДействия = КонецДня(ДанныеСчета.ДатаОкончанияДействия);
	КонецЕсли;
	
	МаксКоличествоСубконто = БухгалтерскийУчетПовтИсп.ПолучитьМаксКоличествоСубконто();
	Для Индекс = 1 По МаксКоличествоСубконто Цикл
		
		Если Индекс <= Счет.ВидыСубконто.Количество() Тогда
			ДанныеСчета.Вставить("ВидСубконто" + Индекс,                        Счет.ВидыСубконто[Индекс - 1].ВидСубконто);
			ДанныеСчета.Вставить("ВидСубконто" + Индекс + "Наименование",       Строка(Счет.ВидыСубконто[Индекс - 1].ВидСубконто));
			ДанныеСчета.Вставить("ВидСубконто" + Индекс + "ТипЗначения",        Счет.ВидыСубконто[Индекс - 1].ВидСубконто.ТипЗначения);
			ДанныеСчета.Вставить("ВидСубконто" + Индекс + "Суммовой",           Счет.ВидыСубконто[Индекс - 1].Суммовой);
			ДанныеСчета.Вставить("ВидСубконто" + Индекс + "ТолькоОбороты",      Счет.ВидыСубконто[Индекс - 1].ТолькоОбороты);
			ДанныеСчета.Вставить("ВидСубконто" + Индекс + "Валютный",           Счет.ВидыСубконто[Индекс - 1].Валютный);
			ДанныеСчета.Вставить("ВидСубконто" + Индекс + "Количественный",     Счет.ВидыСубконто[Индекс - 1].Количественный);
			ДанныеСчета.Вставить("ВидСубконто" + Индекс + "ВводПустыхСубконто", НЕ Счет.ВидыСубконто[Индекс - 1].Обязательный); // оставлено для совместимости, использовать признак "Обязательный"
			ДанныеСчета.Вставить("ВидСубконто" + Индекс + "Обязательный",       Счет.ВидыСубконто[Индекс - 1].Обязательный);
		Иначе
			ДанныеСчета.Вставить("ВидСубконто" + Индекс,                        Неопределено);
			ДанныеСчета.Вставить("ВидСубконто" + Индекс + "Наименование",       "");
			ДанныеСчета.Вставить("ВидСубконто" + Индекс + "ТипЗначения",        Неопределено);
			ДанныеСчета.Вставить("ВидСубконто" + Индекс + "Суммовой",           Ложь);
			ДанныеСчета.Вставить("ВидСубконто" + Индекс + "ТолькоОбороты",      Ложь);
			ДанныеСчета.Вставить("ВидСубконто" + Индекс + "Валютный",           Ложь);
			ДанныеСчета.Вставить("ВидСубконто" + Индекс + "Количественный",     Ложь);
			ДанныеСчета.Вставить("ВидСубконто" + Индекс + "ВводПустыхСубконто", Ложь);
			ДанныеСчета.Вставить("ВидСубконто" + Индекс + "Обязательный",       Ложь);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ДанныеСчета;
	
КонецФункции

// Возвращает максимальное значение признаков учета для счетов, включая всех подчиненных.
// Коды счетов передаются строкой, через запятую. Так же задаются при необходимости коды счетов исключений.
// Возвращается структура с ключами - именами признаков учета. Значения ключей - максимум по каждому признаку учета.
// Если счета не найдены, то все признаки равны Ложь.
//
// Параметры:
//  СтрокаСчетов			 - Строка - строка кодов счетов, в иерархии которых получаются признаки
//  СтрокаСчетовИсключений	 - Строка - строка кодов счетов, исключаемых из запроса. Исключаются все счета в иерархии.
//  ДатаАктуальности		 - Дата - дата, на которую проверяется действие счета
// 
// Возвращаемое значение:
// Структура - максимум по каждому признаку:
//	* Валютный - Булево - 
//	* Количественный - Булево - 
//	* УчетПоКПС - Булево - 
//	* УчетПоПодразделениям - Булево - 
//	* УчетПоКЭК - Булево - 
//	* РазрешитьНеУказыватьПодразделение - Булево - 
//
Функция ПолучитьПризнакиУчета(СтрокаСчетов, СтрокаСчетовИсключений="", Знач ДатаАктуальности = '00010101') Экспорт
	Если Не ЗначениеЗаполнено(ДатаАктуальности) Тогда
		ДатаАктуальности = ТекущаяДатаСеанса();
	КонецЕсли;
	МассивКодовСчетов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаСчетов, ",");
	МассивКодовСчетовИсключений = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаСчетовИсключений, ",");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЕСТЬNULL(МАКСИМУМ(ЕПСБУ.Валютный), ЛОЖЬ) КАК Валютный,
	               |	ЕСТЬNULL(МАКСИМУМ(ЕПСБУ.Количественный), ЛОЖЬ) КАК Количественный,
	               |	ЕСТЬNULL(МАКСИМУМ(ЕПСБУ.УчетПоКПС), ЛОЖЬ) КАК УчетПоКПС,
	               |	ЕСТЬNULL(МАКСИМУМ(ЕПСБУ.УчетПоПодразделениям), ЛОЖЬ) КАК УчетПоПодразделениям,
	               |	ЕСТЬNULL(МАКСИМУМ(ЕПСБУ.РазрешитьНеУказыватьПодразделение), ЛОЖЬ) КАК РазрешитьНеУказыватьПодразделение,
	               |	ЕСТЬNULL(МАКСИМУМ(ЕПСБУ.УчетПоКЭК), ЛОЖЬ) КАК УчетПоКЭК
	               |ИЗ
	               |	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	               |ГДЕ
	               |	ЕПСБУ.Ссылка В ИЕРАРХИИ
	               |			(ВЫБРАТЬ
	               |				ЕПСБУ.Ссылка
	               |			ИЗ
	               |				ПланСчетов.ЕПСБУ КАК ЕПСБУ
	               |			ГДЕ
	               |				ЕПСБУ.Код В (&СписокКодов))
	               |	И ЕПСБУ.ЭлементГруппа = ЛОЖЬ
	               |	И (ЕПСБУ.ДатаНачалаДействия = ДАТАВРЕМЯ(1, 1, 1)
	               |			ИЛИ ЕПСБУ.ДатаНачалаДействия <= &ДатаАктуальностиСчетов)
	               |	И (ЕПСБУ.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
	               |			ИЛИ ЕПСБУ.ДатаОкончанияДействия >= &ДатаАктуальностиСчетов)";
	Если МассивКодовСчетовИсключений.Количество() > 0 Тогда
		Запрос.Текст = Запрос.Текст + "				   
	               |	И НЕ ЕПСБУ.Ссылка В ИЕРАРХИИ
	               |				(ВЫБРАТЬ
	               |					ЕПСБУ.Ссылка
	               |				ИЗ
	               |					ПланСчетов.ЕПСБУ КАК ЕПСБУ
	               |				ГДЕ
	               |					ЕПСБУ.Код В (&СписокКодовИсключений))";
		Запрос.УстановитьПараметр("СписокКодовИсключений",	МассивКодовСчетовИсключений);
	КонецЕсли;			   
	Запрос.УстановитьПараметр("СписокКодов", МассивКодовСчетов);
	Запрос.УстановитьПараметр("ДатаАктуальностиСчетов", НачалоДня(ДатаАктуальности));
	Результат = Новый Структура("Валютный, Количественный, УчетПоКПС, УчетПоПодразделениям, УчетПоКЭК, РазрешитьНеУказыватьПодразделение",
		Ложь, Ложь, Ложь, Ложь, Ложь, Ложь);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

