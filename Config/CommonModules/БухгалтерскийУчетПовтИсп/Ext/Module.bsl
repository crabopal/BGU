Функция ПолучитьТипыЗначенияСубконтоСчета(Счет) Экспорт

	СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Счет);
	
	Если СвойстваСчета = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура("ПустоеЗначениеСубконто1, ПустоеЗначениеСубконто2, ПустоеЗначениеСубконто3");
	Если СвойстваСчета.ВидСубконто1 <> Неопределено Тогда
		Если СвойстваСчета.ВидСубконто1ТипЗначения.Типы().Количество() = 1 Тогда
			Результат.ПустоеЗначениеСубконто1 = ПустоеЗначениеЗаданногоТипа(СвойстваСчета.ВидСубконто1ТипЗначения.Типы()[0]);
		КонецЕсли;
	КонецЕсли;
	Если СвойстваСчета.ВидСубконто2 <> Неопределено Тогда
		Если СвойстваСчета.ВидСубконто2ТипЗначения.Типы().Количество() = 1 Тогда
			Результат.ПустоеЗначениеСубконто2 = ПустоеЗначениеЗаданногоТипа(СвойстваСчета.ВидСубконто2ТипЗначения.Типы()[0]);
		КонецЕсли;
	КонецЕсли;
	Если СвойстваСчета.ВидСубконто3 <> Неопределено Тогда
		Если СвойстваСчета.ВидСубконто3ТипЗначения.Типы().Количество() = 1 Тогда
			Результат.ПустоеЗначениеСубконто3 = ПустоеЗначениеЗаданногоТипа(СвойстваСчета.ВидСубконто3ТипЗначения.Типы()[0]);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

