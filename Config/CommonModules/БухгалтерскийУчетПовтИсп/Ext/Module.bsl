// Служебная. Возвращает массив с датами изменения плана счетов.
//
Функция ДатыИзмененияПланаСчетов() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЕПСБУ.ДатаНачалаДействия КАК ДатаИзмененияПланаСчетов
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ДОБАВИТЬКДАТЕ(ЕПСБУ.ДатаОкончанияДействия, ДЕНЬ, 1)
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаИзмененияПланаСчетов УБЫВ";
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ДатаИзмененияПланаСчетов");
	
КонецФункции

// Служебная. Для прикладной логики следует использовать БухгалтерскийУчет.СчетПоКоду().
// БухгалтерскийУчетКлиентСервер.СчетПоКоду() в следующей версии будет удалена
// Возвращает актуальный счет на заданную дату.
//
Функция СчетПоКоду(КодСчета, НаДату) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЕПСБУ.Ссылка КАК Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Код = &Код
	|	И &УсловиеНаДату
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЕПСБУ.ДатаНачалаДействия УБЫВ";
	Запрос.УстановитьПараметр("Код", КодСчета);
	
	Если ТипЗнч(НаДату) = Тип("Дата") Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеНаДату",
			"ЕПСБУ.ДатаНачалаДействия <= &НаДату
			|	И (ЕПСБУ.ДатаОкончанияДействия = &ПустаяДата
			|	ИЛИ ЕПСБУ.ДатаОкончанияДействия >= &НаДату)");
		Запрос.УстановитьПараметр("НаДату",     НачалоДня(НаДату));
		Запрос.УстановитьПараметр("ПустаяДата", Дата("00010101000000"));
		
	Иначе // Убираем ограничение по дате актуальности счета.
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеНаДату", "ИСТИНА");
		
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат ?(Выборка.Следующий(), Выборка.Ссылка, ПланыСчетов.ЕПСБУ.ПустаяСсылка());
	
КонецФункции

// Служебная. Для прикладной логики следует использовать БухгалтерскийУчет.СписокСчетов().
// БухгалтерскийУчет.СписокСчетов() в следующей версии будет удалена
// Возвращает массив счетов для использования в условиях и запросах.
// 
// Параметры:
//  Счета - Строка - Коды счетов, разделенные запятой
//        - ПланСчетовСсылка.ЕПСБУ - Счет для получения подчиненных счетов
//        - Структура из ПланСчетовСсылка.ЕПСБУ, Строка -
//  НаДату - Неопределено - На дату
//  БезУчетаИерархии - Булево - Без учета иерархии
// 
// Возвращаемое значение:
//  Массив из ПланСчетовСсылка.ЕПСБУ - Список счетов
Функция СписокСчетов(Счета, НаДату = Неопределено, БезУчетаИерархии = Ложь) Экспорт
	
	Если ТипЗнч(Счета) = Тип("Строка") Тогда
		МассивСчетов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(
			СтрЗаменить(Счета, " ", ""), ",", , Истина);
		СчетаЗаданыСсылками = Ложь;
		
	ИначеЕсли ТипЗнч(Счета) = Тип("ПланСчетовСсылка.ЕПСБУ") Тогда
		МассивСчетов = Счета;
		СчетаЗаданыСсылками = Истина;
		
	ИначеЕсли ТипЗнч(Счета) = Тип("Структура") Тогда
		МассивСчетов = Новый Массив;
		СчетаЗаданыСсылками = Ложь;
		Для Каждого Счет Из Счета Цикл
			МассивСчетов.Добавить(Счет.Значение);
			СчетаЗаданыСсылками = ТипЗнч(Счет.Значение) = Тип("ПланСчетовСсылка.ЕПСБУ");
		КонецЦикла;
		
	Иначе
		Возврат Новый Массив;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивСчетов", МассивСчетов);
	
	Если СчетаЗаданыСсылками Тогда
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЕПСБУ.Ссылка КАК Счет
		|ИЗ
		|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|ГДЕ
		|	ЕПСБУ.Ссылка В ИЕРАРХИИ(&МассивСчетов)
		|	И &УсловиеНаДату
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЕПСБУ.Код";
		
	Иначе // Счета заданы кодами.
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЕПСБУ.Ссылка КАК Счет
		|ПОМЕСТИТЬ СчетаЕПСБУ
		|ИЗ
		|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|ГДЕ
		|	ЕПСБУ.Код В(&МассивСчетов)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕПСБУ.Ссылка КАК Счет
		|ИЗ
		|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|ГДЕ
		|	ЕПСБУ.Ссылка В ИЕРАРХИИ
		|			(ВЫБРАТЬ
		|				СчетаЕПСБУ.Счет
		|			ИЗ
		|				СчетаЕПСБУ)
		|	И &УсловиеНаДату
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЕПСБУ.Код";
		
	КонецЕсли;
	
	Если ТипЗнч(НаДату) = Тип("Дата") Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеНаДату",
			"ЕПСБУ.ДатаНачалаДействия <= &НаДату
			|	И (ЕПСБУ.ДатаОкончанияДействия = &ПустаяДата
			|	ИЛИ ЕПСБУ.ДатаОкончанияДействия >= &НаДату)");
		Запрос.УстановитьПараметр("НаДату",     НачалоДня(НаДату));
		Запрос.УстановитьПараметр("ПустаяДата", Дата("00010101000000"));
		
	Иначе // Убираем ограничение по дате актуальности счета.
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеНаДату", "ИСТИНА");
		
	КонецЕсли;
	
	Если БезУчетаИерархии Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "В ИЕРАРХИИ", "В");
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Счет");
	
КонецФункции

// Служебная. Для прикладной логики следует использовать БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК().
// Возвращает счет (массив счетов) для использования в условиях и запросах.
//
Функция ПолучитьАналитическийСчетПоКЭК(Знач КЭК, ДопустимыеСчета = "", ПолучитьВсеСчета = Ложь, Знач НаДату = Неопределено, Знач Организация = Неопределено, Знач ИФО = Неопределено, Знач КПС = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(КЭК) Тогда
		Возврат ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	КонецЕсли;  
	
	Если ЗначениеЗаполнено(КПС) И ТипЗнч(КПС) = Тип("СправочникСсылка.КлассификационныеПризнакиСчетов") Тогда 
		РеквизитыКПС = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(КПС, "АналитическаяГруппаКДБ,АналитическаяГруппаКИФ,ВидПоказателя,УточнениеПоказателя");
		Если РеквизитыКПС.ВидПоказателя = ПредопределенноеЗначение("Перечисление.ВидыКБК.КДБ")
			ИЛИ РеквизитыКПС.УточнениеПоказателя = ПредопределенноеЗначение("Перечисление.ВидыКБК.КДБ") Тогда
			Если ТипЗнч(КЭК) = Тип("СправочникСсылка.КОСГУ") Тогда 
				КЭК = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КЭК, "Код");
			КонецЕсли;
			Если КЭК = "172" ИЛИ КЭК = "173" Тогда
				КЭК = РеквизитыКПС.АналитическаяГруппаКДБ;
			КонецЕсли;  
		ИначеЕсли РеквизитыКПС.ВидПоказателя = ПредопределенноеЗначение("Перечисление.ВидыКБК.КИФ")
			ИЛИ РеквизитыКПС.УточнениеПоказателя = ПредопределенноеЗначение("Перечисление.ВидыКБК.КИФ") Тогда
			Если ТипЗнч(КЭК) = Тип("СправочникСсылка.КОСГУ") Тогда 
				КЭК = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КЭК, "Код");
			КонецЕсли;
			Если КЭК = "172" ИЛИ КЭК = "173" Тогда
				КЭК = РеквизитыКПС.АналитическаяГруппаКИФ;
			КонецЕсли;  	
		КонецЕсли;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	
	ТекстЗапроса = "
	|ВЫБРАТЬ";
	
	Если НЕ ПолучитьВсеСчета Тогда
		ТекстЗапроса = ТекстЗапроса + " ПЕРВЫЕ 1";
	КонецЕсли;
	
	КЭКРодитель = Неопределено;
	
	ТекстЗапроса = ТекстЗапроса + "
	|	СоответствияАналитическихСчетовКЭК.Счет КАК Счет
	|ИЗ
	|	РегистрСведений.СоответствияАналитическихСчетовКЭК КАК СоответствияАналитическихСчетовКЭК
	|ГДЕ
	|	НЕ СоответствияАналитическихСчетовКЭК.Счет.ЭлементГруппа";
	
	Если ТипЗнч(КЭК) = Тип("Строка") Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|	И (СоответствияАналитическихСчетовКЭК.КЭК.Код = &КЭК
		|		ИЛИ (НЕ СоответствияАналитическихСчетовКЭК.КЭК.Код = &КЭК
		|			И СоответствияАналитическихСчетовКЭК.КЭК.Код = &КЭКРодитель))";
		КЭКРодитель = Прав(КЭК, 2) + "0";
	ИначеЕсли ТипЗнч(КЭК) = Тип("СправочникСсылка.КОСГУ") Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|	И (СоответствияАналитическихСчетовКЭК.КЭК = &КЭК
		|		ИЛИ (НЕ СоответствияАналитическихСчетовКЭК.КЭК = &КЭК
		|			И СоответствияАналитическихСчетовКЭК.КЭК = &КЭКРодитель))";
		КЭКРодитель = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КЭК, "Родитель");
	Иначе
		Возврат (ПланыСчетов.ЕПСБУ.ПустаяСсылка());
	КонецЕсли;
	
	Если ТипЗнч(НаДату) = Тип("Дата") Тогда
		// Отбор по сроку действия счетов.
		ТекстЗапроса = ТекстЗапроса + "
			|   И СоответствияАналитическихСчетовКЭК.Счет.ДатаНачалаДействия <= &НаДату
			|	И (СоответствияАналитическихСчетовКЭК.Счет.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
			|	 ИЛИ СоответствияАналитическихСчетовКЭК.Счет.ДатаОкончанияДействия >= &НаДату)";
		Запрос.УстановитьПараметр("НаДату", НачалоДня(НаДату));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Организация) Тогда
		// Отбор по типу учреждения (типу плана счетов).
		ТекущийИФО = ?(ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") И ЗначениеЗаполнено(ИФО), ИФО,
			Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
		ТипПланаСчетов = БухгалтерскийУчетПовтИсп.ТекущийТипПланаСчетов(Организация, ТекущийИФО, НаДату);
		Если ТипПланаСчетов = ПредопределенноеЗначение("Перечисление.ТипыПлановСчетов.ДляАвтономных") Тогда
			ТекстЗапроса = ТекстЗапроса + "
				|   И СоответствияАналитическихСчетовКЭК.Счет.ДляАвтономных";
		ИначеЕсли ТипПланаСчетов = ПредопределенноеЗначение("Перечисление.ТипыПлановСчетов.ДляБюджетных") Тогда
			ТекстЗапроса = ТекстЗапроса + "
				|   И СоответствияАналитическихСчетовКЭК.Счет.ДляБюджетных";
		ИначеЕсли ТипПланаСчетов = ПредопределенноеЗначение("Перечисление.ТипыПлановСчетов.ДляКазенных") Тогда
			ТекстЗапроса = ТекстЗапроса + "
				|   И СоответствияАналитическихСчетовКЭК.Счет.ДляКазенных";
		КонецЕсли;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("КЭК", КЭК);
	Запрос.УстановитьПараметр("КЭКРодитель", КЭКРодитель);
	
	Если ЗначениеЗаполнено(ДопустимыеСчета) Тогда
		СписокДопустимыхСчетов = СписокСчетов(ДопустимыеСчета);
		ТекстЗапроса = ТекстЗапроса + "
		|	И СоответствияАналитическихСчетовКЭК.Счет В (&СписокСчетов)";
		Запрос.УстановитьПараметр("СписокСчетов",СписокДопустимыхСчетов);
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + "
	|УПОРЯДОЧИТЬ ПО
	| СоответствияАналитическихСчетовКЭК.Счет.Порядок";
	
	Запрос.Текст = ТекстЗапроса;
	
	Если ПолучитьВсеСчета Тогда 
		Возврат (Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Счет"));
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Счет;
	КонецЕсли;
	
	Возврат ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьДеревоРеквизитов(ПриемникЗначения, ИсточникЗначения, СписокТаблиц, ЭтоТаблица = Ложь, Уровень)
	
	Для Каждого ЭлементИсточник Из ИсточникЗначения Цикл
		Если Найти(ЭлементИсточник.Заголовок, "Ссылка") > 0 ИЛИ 
			Найти(ЭлементИсточник.Заголовок, "Версия данных") > 0 ИЛИ 
			Найти(ЭлементИсточник.Заголовок, "Предопределенный") > 0 ИЛИ
			Найти(ЭлементИсточник.Заголовок, "Пометка удаления") > 0 ИЛИ
			Найти(ЭлементИсточник.Заголовок, "Проведен") > 0 ИЛИ
			Найти(Строка(ЭлементИсточник.Поле), "Родитель.Родитель") > 0 ИЛИ
			Найти(Строка(ЭлементИсточник.Поле), "ГоловнаяОрганизация.ГоловнаяОрганизация") > 0 ИЛИ
			Найти(ЭлементИсточник.Заголовок, "Группа.Группа") > 0 ИЛИ
			ЭлементИсточник.Заголовок = "Системные поля" Тогда
			Продолжить;
		КонецЕсли;	
		Если Найти(ЭлементИсточник.Заголовок, "Владелец") > 0 И ЭлементИсточник.ТипЗначения.СодержитТип(Тип("СправочникСсылка.Организации")) Тогда
			Продолжить;
		КонецЕсли;	
		Если ЭлементИсточник.Таблица И НЕ ЭлементИсточник.Родитель = Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		Если ЭлементИсточник.ТипЗначения.СодержитТип(Тип("СправочникСсылка.Валюты")) И НЕ ЭлементИсточник.Родитель = Неопределено Тогда
			Продолжить;
		КонецЕсли;	

		
		ЭлементПриемник = ПриемникЗначения.Строки.Добавить();
		ЭлементПриемник.Имя = ЭлементИсточник.Заголовок;
		ЭлементПриемник.Поле = ЭлементИсточник.Поле;
		
		Если ЭлементИсточник.Таблица Тогда 
			ЭлементПриемник.Таблица = Истина;
			СписокТаблиц.Добавить(ЭлементПриемник.Поле);
			ЭтоТаблица = Истина;
		ИначеЕсли ЭлементИсточник.Родитель = Неопределено Тогда
			ЭтоТаблица = Ложь;
		КонецЕсли;		
			
		Если НЕ ЭтоТаблица Тогда
			ЭлементПриемник.КодДляФормулы = "Документ." + ЭлементПриемник.Поле;
		Иначе
			ЭлементПриемник.КодДляФормулы = "Таблица." + ЭлементПриемник.Поле;
		КонецЕсли;

		Если ЭлементИсточник.ТипЗначения.СодержитТип(Тип("ПланСчетовСсылка.ЕПСБУ")) Тогда
			Продолжить;
		КонецЕсли;
		
		Если (НЕ ЭтоТаблица И Уровень > 0) или Уровень > 1 тогда
			Продолжить;
		КонецЕсли;	
		
		Если ЭлементИсточник.Элементы.Количество() > 0 Тогда
			ЗаполнитьДеревоРеквизитов(ЭлементПриемник, ЭлементИсточник.Элементы, СписокТаблиц, ЭтоТаблица, Уровень + 1);	
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПустоеЗначениеЗаданногоТипа(ЗаданныйТип)
	Если ЗаданныйТип = Тип("Строка") Тогда
		Возврат "";
	ИначеЕсли ЗаданныйТип = Тип("Число") Тогда
		Возврат 0;
	ИначеЕсли ЗаданныйТип = Тип("Булево") Тогда
		Возврат Ложь;
	ИначеЕсли ЗаданныйТип = Тип("Дата") Тогда
		Возврат '00010101';
	ИначеЕсли ОбщегоНазначения.ЭтоСсылка(ЗаданныйТип) Тогда
		Идентификатор = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ЗаданныйТип);
		Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Идентификатор, "ЗначениеПустойСсылки");
	Иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

#КонецОбласти
