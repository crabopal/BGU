// Возвращает массив КПС соответствующий учетной политике организации и действующий на определенную дату.
// 
// Параметры:
//  Организация - СправочникСсылка.Организации
//  ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения - ИФО
//  КФО - ПеречислениеСсылка.КВД - КФО
//  НаДату - Дата - На дату
// 
// Возвращаемое значение:
//  Массив из СправочникСсылка.КлассификационныеПризнакиСчетов - КПСПо учетной политике
Функция КПСПоУчетнойПолитике(Организация, ИФО = Неопределено, КФО = Неопределено, НаДату = Неопределено) Экспорт
	
	ВидыКПС = ВидыКПСПоУчетнойПолитике(Организация, ИФО, КФО, НаДату);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КлассификационныеПризнакиСчетов.Ссылка
	               |ИЗ
	               |	Справочник.КлассификационныеПризнакиСчетов КАК КлассификационныеПризнакиСчетов
	               |ГДЕ
	               |	КлассификационныеПризнакиСчетов.ВидПоказателя В(&ВидыКПС)";
	Если НаДату<>Неопределено Тогда
		Запрос.Текст = Запрос.Текст + "
				   |	И (КлассификационныеПризнакиСчетов.ДатаНачалаДействия <= &НаДату
				   |	ИЛИ КлассификационныеПризнакиСчетов.ДатаНачалаДействия = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
				   |	И (КлассификационныеПризнакиСчетов.ДатаОкончанияДействия >= &НаДату
				   |	ИЛИ КлассификационныеПризнакиСчетов.ДатаОкончанияДействия = ДАТАВРЕМЯ(2999, 1, 1, 0, 0, 0))";
		Запрос.УстановитьПараметр("НаДату", НаДату);
	КонецЕсли;
	СписокВидовКПС = Новый СписокЗначений;
	СписокВидовКПС.ЗагрузитьЗначения(ВидыКПС);
	Запрос.УстановитьПараметр("ВидыКПС", СписокВидовКПС);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

// Возвращает год периода первой записи в регистре сведений "Учетная полиитика"
// (без учета Организации) уменьшенный на единицу
//
Функция ПолучитьГодНачалаВеденияУчетаВИнформационнойБазе() Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	ГодНачала = Год(ТекущаяДатаСеанса()) - 1;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(ГОД(МИНИМУМ(УчетнаяПолитикаОрганизаций.Период)) - 1, НЕОПРЕДЕЛЕНО) КАК ГодНачала
	|ИЗ
	|	РегистрСведений.УчетнаяПолитикаОрганизаций КАК УчетнаяПолитикаОрганизаций";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() И НЕ Выборка.ГодНачала = Неопределено Тогда
		
		ГодНачала = Выборка.ГодНачала;
		
	КонецЕсли;
	
	Возврат ГодНачала;
	
КонецФункции

// Возвращает дату перехода организации с УСН на ОСНО в указанном периоде.
//
// Параметры:
//   Организация - СправочникСсылка.Организации - организация, для которой определяется дата перехода
//   НачалоПериода - Дата - начало периода поиска
//   КонецПериода - Дата - конец периода поиска
//
// Возвращаемое значение:
//   Дата - дата перехода на ОСНО в указанном периоде, или 00010101, если перехода не было
Функция ДатаПереходаНаОСНОЗаПериод(Организация, НачалоПериода, КонецПериода) Экспорт
	
	ДатаПерехода = '00010101';
	
	ДатыПереходаСУСННаОСНО = УчетУСН.ДатыПереходаСУСННаОСНО(Организация);
	Для Каждого Элемент Из ДатыПереходаСУСННаОСНО Цикл
		Если Элемент.Значение >= НачалоПериода И Элемент.Значение <= КонецПериода Тогда
			ДатаПерехода = Элемент.Значение;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ДатаПерехода;
	
КонецФункции

