// Аналитический КЭК по счету.
// 
// Параметры:
//  Счет - ПланСчетовСсылка.ЕПСБУ
// 
// Возвращаемое значение:
//  СправочникСсылка.КОСГУ - Аналитический КЭК по счету
Функция АналитическийКЭКпоСчету(Счет) Экспорт
	
	// Для счета 302.34 используется отдельный алгоритм определения.
	// В некоторых случаях в регистре может быть добавлен КЭК 214, но возвращать нужно 340
	Если Счет = БухгалтерскийУчет.СчетПоКоду("302.34") Тогда
		Возврат АналитическийКЭКпоСчетуСУчетомПоступленияМЗ(Счет);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СоответствияАналитическихСчетовКЭК.КЭК КАК КЭК
	|ИЗ
	|	РегистрСведений.СоответствияАналитическихСчетовКЭК КАК СоответствияАналитическихСчетовКЭК
	|ГДЕ
	|	СоответствияАналитическихСчетовКЭК.Счет = &Счет";
	
	Запрос.УстановитьПараметр("Счет", Счет);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.КЭК;
	Иначе
		Возврат Справочники.КОСГУ.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

Функция АналитическийКЭКпоСчетуСУчетомПоступленияМЗ(Счет) Экспорт
	
	КЭК340 = БухгалтерскийУчетПовтИсп.КЭКПоКоду("340");
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СоответствияАналитическихСчетовКЭК.КЭК КАК КЭК,
	|	ВЫБОР
	|		КОГДА СоответствияАналитическихСчетовКЭК.КЭК = &КЭК340
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК Порядок
	|ИЗ
	|	РегистрСведений.СоответствияАналитическихСчетовКЭК КАК СоответствияАналитическихСчетовКЭК
	|ГДЕ
	|	СоответствияАналитическихСчетовКЭК.Счет = &Счет
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок";
	
	Запрос.УстановитьПараметр("Счет", Счет);
	Запрос.УстановитьПараметр("КЭК340", КЭК340);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.КЭК;
	Иначе
		Возврат Справочники.КОСГУ.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

// Функция возвращает массив допустимых видов КБК для переданного счета,
// если передан счет-группа, то возвращается массив допустимых видов КБК для всех счетов этой группы.
// Если на счете не ведется учет по КПС, то возвращается пустой массив;
//
Функция ПолучитьДопустимыеВидыКПССчета(СчетСсылка) Экспорт
	
	Если НЕ СчетСсылка.УчетПоКПС И НЕ СчетСсылка.ЭлементГруппа Тогда
		Возврат Новый Массив;
	КонецЕсли;	
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ
	|	ВидыКБКСчетов.ВидКБК КАК ВидКБК
	|ИЗ
	|	РегистрСведений.ВидыКБКСчетов КАК ВидыКБКСчетов
	|ГДЕ
	|	ВидыКБКСчетов.Счет = &Счет
	|	И ВидыКБКСчетов.Счет.УчетПоКПС
	|");
	
	Если СчетСсылка.ЭлементГруппа Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВидыКБКСчетов.Счет = &Счет", "ВидыКБКСчетов.Счет В Иерархии (&Счет)");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Счет", СчетСсылка);
	
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ВидКБК");
	Если Результат.Количество() = 0 Тогда
		Результат.Добавить(Перечисления.ВидыКБК.гКБК);
		Результат.Добавить(Перечисления.ВидыКБК.КДБ);
		Результат.Добавить(Перечисления.ВидыКБК.КИФ);
		Результат.Добавить(Перечисления.ВидыКБК.КРБ);
	Конецесли;
	
	Результат.Добавить(Перечисления.ВидыКБК.Произвольный);
	
	Результат.Добавить(Перечисления.ВидыКБК.АУИБУ);


	Возврат Результат;
	
КонецФункции

// Допустимые КЭК счета.
// 
// Параметры:
//  Счет - ПланСчетовСсылка.ЕПСБУ
// 
// Возвращаемое значение:
//  Массив из СправочникСсылка.КОСГУ - Допустимые КЭКСчета
Функция ДопустимыеКЭКСчета(Счет) Экспорт
	
	Результат = Новый Массив;
	
	Если НЕ (ОбщегоНазначения.ЗначениеСсылочногоТипа(Счет) И ОбщегоНазначения.ВидОбъектаПоСсылке(Счет) = "ПланСчетов") Тогда
		Возврат Результат;
	КонецЕсли;	
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	КЭКСчетов.КЭК
	|ИЗ
	|	РегистрСведений.КЭКСчетов КАК КЭКСчетов
	|ГДЕ
	|	КЭКСчетов.Счет = &Счет");
	
	Запрос.УстановитьПараметр("Счет", Счет);

	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Результат.Добавить(Выборка.КЭК);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

