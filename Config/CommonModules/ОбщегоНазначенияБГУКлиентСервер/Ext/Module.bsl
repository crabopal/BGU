// Устарела.
// Заполнить виды первичных документов.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения:
//   * ПараметрыПодключаемыхКоманд - Структура
//   * Элементы - ВсеЭлементыФормы:
//     ** ПервичныйДокумент - ПолеФормы
//   * ПараметрыПечатныхФорм - Структура из см. ПустаяСтрокаПараметраПечатныхФорм
//
Процедура ОбновитьВидыПервичныхДокументов(Форма) Экспорт
	
	СписокПечатныхФорм = Форма.Элементы.ПервичныйДокумент.СписокВыбора; // СписокЗначений
	СписокПечатныхФорм.Очистить();
	Объект = Форма.Объект;
	
	Для Каждого Строка Из Форма.ПараметрыПечатныхФорм Цикл
		Если УсловияВидимостиКомандыПечатиВыполняются(Строка.Значение.УсловияВидимости, Объект) Тогда
			СписокПечатныхФорм.Добавить(Строка.Значение.ВидПервичногоДокумента, Строка.Значение.Представление);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Устарела.
// Пустая строка параметра печатных форм.
// 
// Возвращаемое значение:
//  Структура - Пустая строка параметра печатных форм:
// * Представление - Строка -
// * ВидПервичногоДокумента - СправочникСсылка.ПервичныеДокументы
// * УсловияВидимости - Массив из Строка
Функция ПустаяСтрокаПараметраПечатныхФорм() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Представление", "");
	Результат.Вставить("ВидПервичногоДокумента", ПредопределенноеЗначение("Справочник.ПервичныеДокументы.ПустаяСсылка"));
	Результат.Вставить("УсловияВидимости", Новый Массив);
	Возврат Результат;
КонецФункции

// Устарела. Следует использовать ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(...).
// Формирует текст сообщения, подставляя значения
// параметров в шаблоны сообщений.
//
// Параметры
//  ВидПоля       - Строка - может принимать значения:
//                  Поле, Колонка, Список
//  ВидСообщения  - Строка - может принимать значения:
//                  Заполнение, Корректность
