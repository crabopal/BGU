// Возвращает элемент формы заданного типа, содержащий текущий элемент
// Поиск ведется рекурсивно, до первного родителя нужного типа.
// Если элемент нужного типа не получен (получена родительская управляемая форма, то возвращается неопределено
//
// Параметры:
//	Элемент - Элемент формы
//	Тип - тип родителя для поиска
//
// Возвращаемое значение:
//	ЭлементФормы - найденный элемент нужного типа
//	Неопределено - элемент нужного типа не найден
//
Функция РодительскийЭлементЗаданногоТипа(Знач Элемент, Тип) Экспорт
	Если ТипЗнч(Элемент.Родитель) = Тип Тогда
		Возврат Элемент.Родитель;
	ИначеЕсли ТипЗнч(Элемент.Родитель) = Тип("ФормаКлиентскогоПриложения") Тогда
		Возврат Неопределено;
	Иначе
		Возврат РодительскийЭлементЗаданногоТипа(Элемент.Родитель, Тип);
	КонецЕсли;
КонецФункции

#Область ФлажокБезОграничения

// Флажок <без ограничения>
//	Механизм предназначен для интерактивного совместного редактирования
// двух связанных между собой реквизитов (ссылки и флажка), когда требуется
// различать 2 различных состояния при пустом значении реквизита-ссылки
// (<пустое значение> и <без ограничения>).
//
//	Взаимосвязанные реквизиты:
//	- Ссылочный реквизит
//		Далее обозначается как реквизит-ссылка.
//		В случае пустого значения различаются 2 состояния
//		в зависимости от значения связанного реквизита-флажка.
//	- Реквизит флажка "Без ограничения"
//		Далее обозначается как реквизит-флажок.
//		Позволяет задать состояние <без ограничения> при установленном флажке.
//		При сброшенном флажке и пустой ссылке устанавливается состояние <пустое значение>.
//
Процедура ФлажокБезОграничения_ИнициализироватьВсеФлажкиБезОграничения(ДокументОбъект, НастройкиМеханизма, ДанныеЗаполнения = Неопределено) Экспорт
	
	// Размещаем все настройки в массив
	МассивНастроек = ФлажокБезОграничения_ПривестиНастройкиМеханизмаКОжидаемомуФормату(НастройкиМеханизма);
	
	// Инициализируем все флажки
	Для Каждого ТекущиеНастройки Из МассивНастроек Цикл
		ИмяРеквизитаСсылка	= ТекущиеНастройки["ИмяРеквизитаСсылка"];
		ИмяРеквизитаФлажок	= ТекущиеНастройки["ИмяРеквизитаФлажок"];
		
		// Определим значение реквизита ссылки
		// Сначала берем из самого документа
		ЗначениеРеквизитаСсылка = ДокументОбъект[ИмяРеквизитаСсылка];
		
		// Если указаны данные заполнения, то пробуем взять значение оттуда
		Если НЕ ДанныеЗаполнения = Неопределено Тогда
			ВремСтруктура = Новый Структура(ИмяРеквизитаСсылка);
			ЗаполнитьЗначенияСвойств(ВремСтруктура, ДанныеЗаполнения);
			
			Если ЗначениеЗаполнено(ВремСтруктура[ИмяРеквизитаСсылка]) Тогда
				ЗначениеРеквизитаСсылка = ВремСтруктура[ИмяРеквизитаСсылка];
			КонецЕсли;
		КонецЕсли;
		
		// Инициализируем флажок
		ДокументОбъект[ИмяРеквизитаФлажок] = НЕ ЗначениеЗаполнено(ЗначениеРеквизитаСсылка);
	КонецЦикла;
	
КонецПроцедуры

Процедура ФлажокБезОграничения_НастроитьЭлементСсылку(Форма, НастройкиМеханизма) Экспорт
	
	Объект = Форма["Объект"];
	
	ИмяРеквизитаСсылка	= НастройкиМеханизма["ИмяРеквизитаСсылка"];
	ИмяРеквизитаФлажок	= НастройкиМеханизма["ИмяРеквизитаФлажок"];
	
	ЭлементСсылка			= Форма.Элементы[ИмяРеквизитаСсылка];
	ЗначениеРеквизитаФлажок	= Объект[ИмяРеквизитаФлажок];
	
	ТекстПустоеЗначение	= НСтр("ru='<пустое значение>'");
	ТекстБезОграничения	= НСтр("ru='<без ограничения>'");
	
	ЭлементСсылка.ПодсказкаВвода = ?(ЗначениеРеквизитаФлажок, ТекстБезОграничения, ТекстПустоеЗначение);
	
КонецПроцедуры

Функция ФлажокБезОграничения_ПривестиНастройкиМеханизмаКОжидаемомуФормату(НастройкиМеханизма) Экспорт
	
	МассивНастроек = Новый Массив();
	
	Если ТипЗнч(НастройкиМеханизма) = Тип("Структура") Тогда
		// Опциональный параметр РеквизитСсылкаПустоеЗначение
		Если НЕ НастройкиМеханизма.Свойство("РеквизитСсылкаПустоеЗначение") Тогда
			ЗначениеПоУмолчанию = Неопределено;
			НастройкиМеханизма.Вставить("РеквизитСсылкаПустоеЗначение", ЗначениеПоУмолчанию);
		КонецЕсли;
		
		МассивНастроек.Добавить(Новый ФиксированнаяСтруктура(НастройкиМеханизма));
		
	ИначеЕсли ТипЗнч(НастройкиМеханизма) = Тип("Массив") Тогда
		Для Каждого ТекущаяНастройка Из НастройкиМеханизма Цикл
			Если ТипЗнч(ТекущаяНастройка) = Тип("Структура") Тогда
				// Опциональный параметр РеквизитСсылкаПустоеЗначение
				Если НЕ ТекущаяНастройка.Свойство("РеквизитСсылкаПустоеЗначение") Тогда
					ЗначениеПоУмолчанию = Неопределено;
					ТекущаяНастройка.Вставить("РеквизитСсылкаПустоеЗначение", ЗначениеПоУмолчанию);
				КонецЕсли;
				
				МассивНастроек.Добавить(Новый ФиксированнаяСтруктура(ТекущаяНастройка));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат МассивНастроек;
	
КонецФункции

Функция ФлажокБезОграничения_ИмяРеквизитаФормыДляНастроекМеханизма() Экспорт
	
	Возврат "ФлажокБезОграничения_НастройкиМеханизма";
	
КонецФункции

Процедура ФлажокБезОграничения_РеквизитСсылка_ПриИзменении(Форма, Элемент) Экспорт
	
	// Определяем имя реквизита-флажка
	НастройкиМеханизма = ФлажокБезОграничения_ОпределитьНастройкиМеханизмаДляЭлемента(Форма, Элемент);
	
	Если НЕ НастройкиМеханизма = Неопределено Тогда
		ИмяРеквизитаСсылка	= НастройкиМеханизма["ИмяРеквизитаСсылка"];
		ИмяРеквизитаФлажок	= НастройкиМеханизма["ИмяРеквизитаФлажок"];
		
		Объект = Форма["Объект"];
		
		// При необходимости сбрасываем флажок "Без ограничения"
		Если Объект[ИмяРеквизитаФлажок] Тогда
			Объект[ИмяРеквизитаФлажок] = Ложь;
		КонецЕсли;
		
		ФлажокБезОграничения_НастроитьЭлементСсылку(Форма, НастройкиМеханизма);
	КонецЕсли;
	
КонецПроцедуры

Процедура ФлажокБезОграничения_РеквизитФлажок_ПриИзменении(Форма, Элемент) Экспорт
	
	// Определяем имя реквизита-ссылки
	НастройкиМеханизма = ФлажокБезОграничения_ОпределитьНастройкиМеханизмаДляЭлемента(Форма, Элемент);
	
	Если НЕ НастройкиМеханизма = Неопределено Тогда
		ИмяРеквизитаСсылка				= НастройкиМеханизма["ИмяРеквизитаСсылка"];
		ИмяРеквизитаФлажок				= НастройкиМеханизма["ИмяРеквизитаФлажок"];
		РеквизитСсылкаПустоеЗначение	= НастройкиМеханизма["РеквизитСсылкаПустоеЗначение"];
		
		Объект = Форма["Объект"];
		
		// При установленном флажке очищаем значение ссылки
		Если Объект[ИмяРеквизитаФлажок] И ЗначениеЗаполнено(Объект[ИмяРеквизитаСсылка]) Тогда
			Объект[ИмяРеквизитаСсылка] = РеквизитСсылкаПустоеЗначение;
		КонецЕсли;
		
		ФлажокБезОграничения_НастроитьЭлементСсылку(Форма, НастройкиМеханизма);
	КонецЕсли;
	
КонецПроцедуры

