// Возвращает структуру, содержащую имена реквизитов для записи председателя комиссии в документы
//
// Параметры:
//  Должность - Строка - имя реквизита должность документа 
//  Фамилия - Строка - имя реквизита фамилия документа
//  Имя - Строка - имя реквизита имя документа
//  Отчество - Строка - имя реквизита отчетства документа
//
// Возвращаемое значение:
//  Структура - структура имен реквизитов председателя:
//  * Должность - Строка - имя реквизита должность документа
//  * Фамилия - Строка - имя реквизита фамилия документа
//  * Имя - Строка - имя реквизита имя документа
//  * Отчество - Строка - имя реквизита отчетство документа
Функция СтруктураИменРеквизитовВыбораПредседателяКомиссии(Должность = "ДолжностьПредседателяКомиссии",
	Фамилия = "ФамилияПредседателяКомиссии", Имя = "ИмяПредседателяКомиссии",
	Отчество = "ОтчествоПредседателяКомиссии") Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Должность"	, Должность);
	Результат.Вставить("Фамилия"	, Фамилия);
	Результат.Вставить("Имя"		, Имя);
	Результат.Вставить("Отчество"	, Отчество);
	Возврат Результат;
	
КонецФункции // СтруктураИменРеквизитовВыбораПредседателяКомиссии()

// Структура параметров выбора комисии.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма документа
// 
// Возвращаемое значение:
//  Структура - Структура параметров выбора комисии:
// * Форма - ФормаКлиентскогоПриложения - форма документа. Используется только для установки модифицированности.
// 					Можно не передавать
// * ИменаРеквизитовПредседателя - Структура - :
// ** Должность - Строка - имя реквизита должность документа
// ** Фамилия - Строка - имя реквизита фамилия документа
// ** Имя - Строка - имя реквизита имя документа
// ** Отчество - Строка - имя реквизита отчетство документа
// * Приказ - Структура - о создании комиссии:
// ** ЕстьНомерПриказа - Булево
// ** НомерПриказа - Строка
// ** ДатаПриказа - Строка 
// ** НаименованиеПриказа - Строка 
Функция СтруктураПараметровВыбораКомисии(Форма = Неопределено) Экспорт
	
	РеквизитыПредседателя = СтруктураИменРеквизитовВыбораПредседателяКомиссии();
	
	РеквизитыПриказа = Новый Структура;
	РеквизитыПриказа.Вставить("ЕстьНомерПриказа"	, Истина);
	РеквизитыПриказа.Вставить("НомерПриказа"		, "НомерПриказа");
	РеквизитыПриказа.Вставить("ДатаПриказа"			, "ДатаПриказа");
	РеквизитыПриказа.Вставить("НаименованиеПриказа"	, "НаименованиеПриказа");
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Форма", Форма);
	ДопПараметры.Вставить("ИменаРеквизитовПредседателя"	, РеквизитыПредседателя);
	ДопПараметры.Вставить("Приказ"						, РеквизитыПриказа);
	
	Возврат ДопПараметры;
	
КонецФункции

// Заполняет реквизиты комиссии документа.
//
// Параметры:
//  Комиссия - СправочникСсылка.ПостоянноДействующиеКомиссии
//  ДопПараметры - Структура - :
//   * Форма - ФормаКлиентскогоПриложения - в этой процедуре не используется
//   * ИменаРеквизитовПредседателя - Структура - см. СтруктураИменРеквизитовВыбораПредседателяКомиссии()
//   * Приказ - Структура - см. СтруктураПараметровВыбораКомисии()
//  Объект - ДанныеФормыКоллекция, ДокументОбъект - документ 
Процедура ЗаполнитьКомиссиюВДокументе(Комиссия, ДопПараметры, Объект) Экспорт
	
	Если Комиссия = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Приказ = ДопПараметры.Приказ;
	ИменаРеквизитовПредседателя = ДопПараметры.ИменаРеквизитовПредседателя;
	
	Объект.СоставКомиссии.Очистить();
	Объект[ИменаРеквизитовПредседателя.Должность] = "";
	Объект[ИменаРеквизитовПредседателя.Фамилия]   = "";
	Объект[ИменаРеквизитовПредседателя.Имя]       = "";
	Объект[ИменаРеквизитовПредседателя.Отчество]  = "";
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "ДатаИнвентаризации") Тогда
		НаДату = Объект.ДатаИнвентаризации;
	Иначе
		НаДату = Объект.Дата;
	КонецЕсли;
	
	ТекущаяКомиссия = ОбщегоНазначенияБГУВызовСервера.ПолучитьДанныеКомиссии(Комиссия, НаДату);
	
	Если Приказ.ЕстьНомерПриказа Тогда
		ДанныеПриказа = Новый Структура;
		ДанныеПриказа.Вставить(Приказ.НомерПриказа , ТекущаяКомиссия.НомерПриказа);
		ДанныеПриказа.Вставить(Приказ.ДатаПриказа , ТекущаяКомиссия.ДатаПриказа);
		ДанныеПриказа.Вставить(Приказ.НаименованиеПриказа, ТекущаяКомиссия.НаименованиеПриказа);
		ЗаполнитьЗначенияСвойств(Объект, ДанныеПриказа);
	КонецЕсли;
	
	Для Каждого ТекСтрокаКомиссии Из ТекущаяКомиссия.ДанныеКомиссии Цикл
		
		Если ТекСтрокаКомиссии.Председатель Тогда
			Объект[ИменаРеквизитовПредседателя.Должность] = ТекСтрокаКомиссии.ДолжностьЧленаКомиссии;
			Объект[ИменаРеквизитовПредседателя.Фамилия]   = ТекСтрокаКомиссии.ФамилияЧленаКомиссии;
			Объект[ИменаРеквизитовПредседателя.Имя]       = ТекСтрокаКомиссии.ИмяЧленаКомиссии;
			Объект[ИменаРеквизитовПредседателя.Отчество]  = ТекСтрокаКомиссии.ОтчествоЧленаКомиссии;
			ЗаполнитьЗначенияСвойств(Объект, Новый Структура("Председатель", ТекСтрокаКомиссии.Сотрудник));
		Иначе
			ЗаполнитьЗначенияСвойств(Объект.СоставКомиссии.Добавить(), ТекСтрокаКомиссии);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

