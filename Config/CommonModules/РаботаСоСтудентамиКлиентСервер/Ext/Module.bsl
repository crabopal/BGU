
#Область ПрограммныйИнтерфейс

Процедура УстановитьВидимостьПредыдущихДанныхПриказа(Форма) Экспорт 
	
	Элементы = Форма.Элементы;
	
	Элементы.СтудентыПоказатьПредыдущиеДанные.Пометка = Форма.ПоказыватьПредыдущиеДанные;
	
	МассивЭлементов = Новый Массив;
	
	МассивЭлементов.Добавить("СтудентыФакультетПредыдущий");
	МассивЭлементов.Добавить("СтудентыСтавкаОплатыПредыдущая");
	МассивЭлементов.Добавить("СтудентыГруппаПредыдущая");
	МассивЭлементов.Добавить("СтудентыКурсПредыдущий");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивЭлементов, "Видимость", Форма.ПоказыватьПредыдущиеДанные);
	
КонецПроцедуры

Функция ПолучитьПериодПриказа(Объект) Экспорт

	Возврат ?(ЗначениеЗаполнено(Объект.ДатаНачалаДействия), НачалоДня(Объект.ДатаНачалаДействия), НачалоДня(Объект.Дата));

КонецФункции 

Функция ПолучитьЗначениеСтавки(Ставка, РабочихДней = 0, ДнейПосещения = 0, НачалоПериода, КонецПериода, ПрерыватьПоОшибке = Ложь) Экспорт 
	
	Перем Результат;
	
	Результат = 0;
	
	Если ТипЗнч(НачалоПериода) <> Тип("Дата") ИЛИ ТипЗнч(КонецПериода) <> Тип("Дата") 
	 ИЛИ Месяц(НачалоПериода) <> Месяц(КонецПериода) 
	 ИЛИ ТипЗнч(Ставка) <> Тип("СправочникСсылка.СтавкиОплатыОбразование") Тогда
		
		Если ПрерыватьПоОшибке  Тогда
			
			ТекстОшибки = НСтр("ru='Переданы недопустимые параметры расчета ставки оплаты! 
									     |(Ставка """ + Ставка + """, начало периода """ + НачалоПериода + """, конец периода """ + КонецПериода + """'");
		
			ВызватьИсключение ТекстОшибки;
			
		КонецЕсли; 
		
	Иначе                                
		
		КоличествоДнейДействия = День(КонецПериода) - День(НачалоПериода) + 1;
		КоличествоДнейВПериоде = День(КонецМесяца(КонецПериода)); 
		ДанныеСтавки = РаботаСоСтудентамиПовтИсп.ПолучитьДанныеСтавки(Ставка, НачалоПериода);
		
		Если ДанныеСтавки.ЭтоФиксированнаяСтавкаЗаПериод Тогда
			
			Если КоличествоДнейДействия <> КоличествоДнейВПериоде Тогда
				Результат = ДанныеСтавки.СуммаНачисления / КоличествоДнейВПериоде * КоличествоДнейДействия;
			Иначе
				Результат = ДанныеСтавки.СуммаНачисления;
			КонецЕсли; 
			
		Иначе
				
			СуммаФиксированнаяСтавкаЗаМесяц = ДанныеСтавки.СуммаФиксированнаяСтавкаЗаМесяц;
			СуммаПеременнойСтавки = ?(РабочихДней = 0, 0, ДанныеСтавки.СуммаПеременнаяСтавкаЗаМесяц * ДнейПосещения / РабочихДней);
			СуммаЗаДни = ДанныеСтавки.СуммаСтавкаЗаДень * ДнейПосещения;
			
			Результат = СуммаФиксированнаяСтавкаЗаМесяц + СуммаПеременнойСтавки + СуммаЗаДни;
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСуммуНачисленияПоСтроке(Объект, СтрокаТЧ) Экспорт 
	
	Возврат ПолучитьЗначениеСтавки(
						СтрокаТЧ.СтавкаОплаты, 
						Объект.КоличествоРабочихДней, 
						СтрокаТЧ.ДнейПосещения,
						СтрокаТЧ.ПериодНачисленияНачало,
						СтрокаТЧ.ПериодНачисленияКонец
				) * РаботаСоСтудентамиПовтИсп.ПолучитьКоэффициентЛьготы(СтрокаТЧ.Льгота);
								 
КонецФункции

// Формирует уникальное имя колонки таблицы
//
Функция ИмяКолонкиПоПолю(Поле) Экспорт
	
	Значение = "Поле" + СтрЗаменить(Поле.УникальныйИдентификатор(), "-", "");
	Возврат Значение;
	
КонецФункции

///////////////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ РАБОТЫ С ПРЕДСТАВЛЕНИЕМ ПЕРИОДА

Функция ПолучитьПредставлениеМесяца(ДатаНачалаМесяца) Экспорт
	
	Возврат Формат(ДатаНачалаМесяца, "ДФ='MMMM yyyy'");
	
КонецФункции

Процедура ПериодЗаполнитьПредставление(Форма, ПутьРеквизита, ПутьРеквизитаПредставления, Отказ = Ложь, СтрокаТабличнойЧасти = "ПустаяСтрока") Экспорт  
	
	Если СтрокаТабличнойЧасти = "ПустаяСтрока" Тогда
		Данные = Форма;
	Иначе
		Если СтрокаТабличнойЧасти = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Данные = СтрокаТабличнойЧасти;
	КонецЕсли;
	
	Значение = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(Данные, ПутьРеквизита);
	ОбщегоНазначенияКлиентСервер.УстановитьРеквизитФормыПоПути(Данные, ПутьРеквизитаПредставления, ПолучитьПредставлениеМесяца(Значение));
	
КонецПроцедуры

Процедура ПериодЗаполнитьПредставлениеВТабличнойЧасти(ДанныеТабличнойЧасти, ПутьРеквизита, ПутьРеквизитаПредставления) Экспорт  
	
	Для Каждого СтрокаТабличнойЧасти Из ДанныеТабличнойЧасти Цикл
		
		Значение = ОбщегоНазначенияКлиентСервер.ПолучитьРеквизитФормыПоПути(СтрокаТабличнойЧасти, ПутьРеквизита);
		ОбщегоНазначенияКлиентСервер.УстановитьРеквизитФормыПоПути(СтрокаТабличнойЧасти, ПутьРеквизитаПредставления, ПолучитьПредставлениеМесяца(Значение));
		
	КонецЦикла;
	
КонецПроцедуры

