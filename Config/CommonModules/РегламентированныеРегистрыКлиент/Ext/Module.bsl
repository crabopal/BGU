//  Синхронизируются настройки в форме отчета с настройками произведенными во внешней форме
//
Процедура ОбработкаЭлементаОтбора(ЭлементОтбора,Отчет)
	Для Каждого ЭлементНастройки Из Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл	
		Если ЭлементНастройки.ИдентификаторПользовательскойНастройки = ЭлементОтбора.ИдентификаторПользовательскойНастройки Тогда
			Если ЭлементОтбора.ЛевоеЗначение = ЭлементНастройки.ЛевоеЗначение тогда 
				ЭлементОтбора.Использование		= ЭлементНастройки.Использование;
				ЭлементОтбора.ВидСравнения		= ЭлементНастройки.ВидСравнения;
				ЭлементОтбора.ПравоеЗначение	= ЭлементНастройки.ПравоеЗначение;
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;
	
	
	Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") тогда									
		Для каждого ЭлементГруппы из ЭлементОтбора.Элементы цикл
			ОбработкаЭлементаОтбора(ЭлементГруппы,Отчет);
		КонецЦикла;	
	ИНаче	
		Если ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Организация") тогда
			Отчет.Организация = ЭлементОтбора.ПравоеЗначение;
			Если не ЭлементОтбора.Использование тогда
				Отчет.Организация = "";
			КонецЕсли;	
		КонецЕсли;	
		// Проверка установки функциональных опций ИФо и Подразделение
		Если Отчет.КомпоновщикНастроек.Настройки.Отбор.ДоступныеПоляОтбора.НайтиПоле(ЭлементОтбора.ЛевоеЗначение) = неопределено тогда
			Отчет.КомпоновщикНастроек.Настройки.Отбор.Элементы.Удалить(ЭлементОтбора);
		КонецЕсли;	
	КонецЕсли;
	
КонецПРоцедуры

Процедура ОбновитьКомпоновщикНастроек(Форма,КомпоновщикНастроек)  экспорт
	Отчет = Форма.Отчет;
	Настройки = РегламентированныеРегистры.ПолучитьНастройки(КомпоновщикНастроек);
	Отчет.КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);
	Отчет.КомпоновщикНастроек.ЗагрузитьПользовательскиеНастройки(КомпоновщикНастроек.ПользовательскиеНастройки);
	
	КоличествоЭлементов = Отчет.КомпоновщикНастроек.Настройки.Отбор.Элементы.Количество();
	Для ИндексОбхода = 1 по КоличествоЭлементов цикл
		ЭлементОтбора = Отчет.КомпоновщикНастроек.Настройки.Отбор.Элементы[КоличествоЭлементов - ИндексОбхода];
		ОбработкаЭлементаОтбора(ЭлементОтбора,Отчет);
	КонецЦикла;
	
	Если Форма.Элементы.Найти("МакетОформления") <> Неопределено тогда
		ЗначениеПараметра = Отчет.КомпоновщикНастроек.Настройки.ПараметрыВывода.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("МакетОформления"));
		
		Если ЗначениеПараметра <> Неопределено Тогда
			Форма.МакетОформления = ЗначениеПараметра.Значение;
		КонецЕсли;
		
		Для Каждого ЭлементНастройки Из Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл	
			Если ЭлементНастройки.ИдентификаторПользовательскойНастройки = ЗначениеПараметра.ИдентификаторПользовательскойНастройки Тогда
				Форма.МакетОформления = ЗначениеПараметра.Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;	
КонецПРоцедуры

///////////////////////////////////////////////////////////////////////////
//   Процедура синхронизирует отбор в форме отчета с пользовательскими настройками

Процедура СинхронизироватьОтборПользовательскиеНастройки(Форма) экспорт
	Отчет = Форма.Отчет;
	Для каждого ЭлементОтбора из Отчет.КомпоновщикНастроек.Настройки.Отбор.Элементы цикл
		Для Каждого ЭлементНастройки Из Отчет.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл	
			Если ЭлементНастройки.ИдентификаторПользовательскойНастройки = ЭлементОтбора.ИдентификаторПользовательскойНастройки Тогда
				ЭлементНастройки.ЛевоеЗначение = ЭлементОтбора.ЛевоеЗначение;
				ЭлементНастройки.Использование = ЭлементОтбора.Использование;
				ЭлементНастройки.ПравоеЗначение = ЭлементОтбора.ПравоеЗначение;
				ЭлементНастройки.ВидСравнения   = ЭлементОтбора.ВидСравнения;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПРоцедуры	

Процедура УстановитьМакетОформления(МакетОформления,КомпоновщикНастроек,ПользовательскиеНастройки) экспорт
	
	ЗначениеПараметра = КомпоновщикНастроек.Настройки.ПараметрыВывода.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("МакетОформления"));
	
	Если ЗначениеПараметра <> Неопределено Тогда
		ЗначениеПараметра.Использование = Истина;
		ЗначениеПараметра.Значение      = МакетОформления;
		Для Каждого ЭлементНастройки Из ПользовательскиеНастройки.Элементы Цикл	
			Если ЭлементНастройки.ИдентификаторПользовательскойНастройки = ЗначениеПараметра.ИдентификаторПользовательскойНастройки Тогда
				ЭлементНастройки.Использование = Истина;
				ЭлементНастройки.Значение      = МакетОформления;
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;
	Для каждого ВложенныеЭлементы из КомпоновщикНастроек.Настройки.Структура цикл
		Если ТипЗнч(ВложенныеЭлементы) = Тип("НастройкиВложенногоОбъектаКомпоновкиДанных") тогда
			УстановитьМакетОформления(МакетОформления,ВложенныеЭлементы,ПользовательскиеНастройки);
	    КонецЕсли;
	КонецЦикла;
КонецПРоцедуры	

//////////////////////////////////////////////////////////////////////////
//  Процедуры и функции работы с Отбором на форме отчета

ПРоцедура ОбходЭлементовОтбораДляВыбораФормы(Элемент,ЛевоеЗначение,МастерПоле,Элементы) 
	Для каждого ЭлементОтбора из Элементы цикл
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") тогда							
			ОбходЭлементовОтбораДляВыбораФормы(Элемент,ЛевоеЗначение,МастерПоле,ЭлементОтбора.Элементы);
		ИНаче
			Если ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ЛевоеЗначение) тогда
				Если не МастерПоле.Свойство("Отбор") тогда
					Продолжить;
				КонецЕсли;	
				ПолеОтбора	= Неопределено;
				Форма		= Неопределено;
				МастерПоле.Отбор.Свойство("ПолеОтбора",ПолеОтбора);
				МастерПоле.Отбор.Свойство("Форма",Форма);
				Если ЗначениеЗаполнено(ПолеОтбора) и ЗначениеЗаполнено(Форма) тогда
					ПараметрыФормы = Новый	Структура;
					Если ЗначениеЗаполнено(ЭлементОтбора.ПравоеЗначение) тогда
						ПараметрыФормы.Вставить("Отбор",Новый Структура(ПолеОтбора, ЭлементОтбора.ПравоеЗначение));
					КонецЕсли;
					ОткрытьФорму(Форма+".ФормаВыбора",ПараметрыФормы,Элемент);
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры	

Процедура ОтборПравоеЗначениеНачалоВыбора(Элемент, СтандартнаяОбработка, ТекущиеДанные, СписокЗависимыхПолей, КомпоновщикНастроек) экспорт
	Если ТипЗнч(СписокЗависимыхПолей) <> Тип("Структура") тогда
		Возврат;
	КонецЕсли;
	Для каждого ЗависимоеПоле из  СписокЗависимыхПолей цикл
		МастерПоле = ЗависимоеПоле.Значение;
		Если ТипЗнч(МастерПоле) <> Тип("Структура") тогда
			Продолжить;
		КонецЕсли;
		Если не МастерПоле.Свойство("МастерПоле") тогда
			Продолжить;
		КонецЕсли;	
		ЛевоеЗначение = МастерПоле.МастерПоле;
		Если ТекущиеДанные.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ЗависимоеПоле.Ключ) Тогда
			СтандартнаяОбработка = Ложь;
			ОбходЭлементовОтбораДляВыбораФормы(Элемент,ЛевоеЗначение,МастерПоле,КомпоновщикНастроек.Настройки.Отбор.Элементы); 				
		КонецЕсли;	
	КонецЦикла;
КонецПРоцедуры	

ПРоцедура ОбходЭлементовОтбораДляОчисткиПравогоПоля(ЛевоеЗначение,Элементы) 
	Для каждого ЭлементОтбора из Элементы цикл
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") тогда							
			ОбходЭлементовОтбораДляОчисткиПравогоПоля(ЛевоеЗначение,ЭлементОтбора.Элементы);
		ИНаче
			Если ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ЛевоеЗначение)тогда
				ЭлементОтбора.ПравоеЗначение = "";
				ЭлементОтбора.Использование  = Ложь;
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры	


Процедура ОтборПравоеЗначениеПриИзмененииОчистка(СписокПолейДляОчистки, КомпоновщикНастроек) экспорт
	Если ТипЗнч(СписокПолейДляОчистки) <> Тип("Структура") тогда
		Возврат;
	КонецЕсли;	
	Для каждого ПолеДляОчистки из СписокПолейДляОчистки цикл
		ОбходЭлементовОтбораДляОчисткиПравогоПоля(ПолеДляОчистки.Ключ,КомпоновщикНастроек.Настройки.Отбор.Элементы); 
	КонецЦикла;	
КонецПРоцедуры	

Процедура УстановкаПравогоПоляЭлементаОтбора(ИмяПоля,Значение,Элементы, ПользовательскиеНастройки = Неопределено) экспорт
	Для каждого ЭлементОтбора из Элементы цикл
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") тогда								
			УстановкаПравогоПоляЭлементаОтбора(ИмяПоля,Значение,ЭлементОтбора.Элементы)
		ИНаче
			Если ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоля)тогда
				ЭлементОтбора.Использование = ЗначениеЗаполнено(Значение);
				ЭлементОтбора.ПравоеЗначение = Значение;
				Если ПользовательскиеНастройки <> Неопределено тогда
					Для Каждого ЭлементНастройки Из ПользовательскиеНастройки.Элементы Цикл	
						Если ЭлементНастройки.ИдентификаторПользовательскойНастройки = ЭлементОтбора.ИдентификаторПользовательскойНастройки Тогда
							ЭлементНастройки.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоля);
							ЭлементНастройки.Использование = ЗначениеЗаполнено(Значение);
							ЭлементНастройки.ПравоеЗначение = Значение;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;
КонецПроцедуры	

