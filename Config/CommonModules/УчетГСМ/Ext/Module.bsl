Функция ПолучитьНаименованиеКультуры(НоменклатураСсылка) Экспорт
	Результат = "";
	
	СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НоменклатураСсылка, "Наименование, НаименованиеПолное");
	
	Если СтруктураДанных.НаименованиеПолное = "" Тогда
		Результат = СтруктураДанных.Наименование;
	Иначе
		Результат = СтруктураДанных.НаименованиеПолное;
	КонецЕсли;	
	
	Возврат Результат;
