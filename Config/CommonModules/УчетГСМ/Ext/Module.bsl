Функция НайтиПредыдущийПутевойЛист(ПутевойЛист, ТранспортноеСредство, ДатаПутевогоЛиста) Экспорт
	Результат = Неопределено;
	
	Если НЕ ЗначениеЗаполнено(ТранспортноеСредство) Тогда
		Возврат Результат;
	КонецЕсли;	
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЖурналПутевыхЛистов.Ссылка КАК Ссылка,
	|	ЖурналПутевыхЛистов.Дата КАК Дата
	|ИЗ
	|	ЖурналДокументов.ЖурналПутевыхЛистов КАК ЖурналПутевыхЛистов
	|ГДЕ
	|	ЖурналПутевыхЛистов.ТранспортноеСредство = &ТранспортноеСредство
	|	И ЖурналПутевыхЛистов.Дата <= &Дата
	|	И НЕ ЖурналПутевыхЛистов.Ссылка = &ТекущийДокумент
	|	И ЖурналПутевыхЛистов.ПометкаУдаления = ЛОЖЬ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЖурналПутевыхЛистов.Дата УБЫВ,
	|	ЖурналПутевыхЛистов.НомерСмены УБЫВ");
	
	Запрос.УстановитьПараметр("ТранспортноеСредство", ТранспортноеСредство);
	Запрос.УстановитьПараметр("Дата", ДатаПутевогоЛиста);
	Запрос.УстановитьПараметр("ТекущийДокумент", ПутевойЛист);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат  Результат;
КонецФункции

Функция ПолучитьДанныеВидаГСМ(ВидГСМ) Экспорт
	СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВидГСМ, "КодМаркиГорючего,МаркаГорючего,ЕдиницаИзмерения");
	
	Возврат СтруктураДанных;
КонецФункции	

Функция ПолучитьНаименованиеКонтрагента(Заказчик, ДатаЗапроса) Экспорт
	Если ТипЗнч(Заказчик) = Тип("СправочникСсылка.Контрагенты") Тогда
		СтруктураРезультат = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Заказчик, "Код,НаименованиеСокращенное");
		СтруктураРезультат.Вставить("СсылкаНаОбъект",Заказчик);
		СтруктураРезультат.Вставить("Период",ДатаЗапроса);
		СтруктураРезультат.Вставить("НаименованиеПолное");
		
		Если НЕ ЗначениеЗаполнено(СтруктураРезультат.НаименованиеСокращенное) Тогда
			Справочники.Контрагенты.ПолучитьДанныеКонтрагента(СтруктураРезультат);
		КонецЕсли;
		СтруктураРезультат.Вставить("Адрес",ПолучитьАдресКонтрагента(Заказчик));
	ИначеЕсли ТипЗнч(Заказчик) = Тип("СправочникСсылка.Подразделения") Тогда
		СтруктураРезультат = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Заказчик, "Код,НаименованиеПолное");
		СтруктураРезультат.Вставить("СсылкаНаОбъект",Заказчик);
		СтруктураРезультат.Вставить("Период",ДатаЗапроса);
		СтруктураРезультат.Вставить("НаименованиеСокращенное", Заказчик.Наименование);
		СтруктураРезультат.Вставить("Адрес","");
	ИначеЕсли ТипЗнч(Заказчик) = Тип("СправочникСсылка.Сотрудники") Тогда
		СтруктураРезультат = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Заказчик, "Код,Наименование");
		СтруктураРезультат.Вставить("СсылкаНаОбъект",Заказчик);
		СтруктураРезультат.Вставить("Период",ДатаЗапроса);
		СтруктураРезультат.Вставить("НаименованиеСокращенное", КорреспондентыКлиентСервер.ФИО(Строка(Заказчик)));
		СтруктураРезультат.Вставить("НаименованиеПолное");
		СтруктураРезультат.Вставить("Адрес","");
	КонецЕсли;
	
	Возврат СтруктураРезультат;
КонецФункции

