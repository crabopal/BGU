		КонецЦикла;	
	ИначеЕсли ТипЗнч(ПутевойЛистСсылка) = Тип("ДокументСсылка.ПутевойЛистЭСМ2") Тогда
		Для Каждого ТекСтрока Из ПутевойЛистСсылка.РезультатыРаботыТС Цикл
			Если ЗначениеЗаполнено(ТекСтрока.КоличествоВремениПростоя) Тогда
				РезультатДляСтроки = ТекСтрока.КоличествоВремениПростоя;
				Результат = Результат + РезультатДляСтроки;
			КонецЕсли;	
		КонецЦикла;
	ИначеЕсли ТипЗнч(ПутевойЛистСсылка) = Тип("ДокументСсылка.ПутевойЛист3") Тогда
	ИначеЕсли ТипЗнч(ПутевойЛистСсылка) = Тип("ДокументСсылка.ПутевойЛист412АПК") Тогда
		//нет данных, будут добавлены при запросе
		Результат = 0;
