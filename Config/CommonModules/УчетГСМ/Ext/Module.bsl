Функция ПоказанияСпидометраРасчетные(ПутевойЛист, ВсеПоказания = Ложь) Экспорт
	РезультатПриВыезде = 0;
	Результат = 0; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	ТаксировкаПутевогоЛиста.Ссылка,
	               |	ТаксировкаПутевогоЛиста.ПоказанияСпидометраПриВыезде,
	               |	ТаксировкаПутевогоЛиста.ПробегОбщий
	               |ИЗ
	               |	Документ.ТаксировкаПутевогоЛиста КАК ТаксировкаПутевогоЛиста
	               |ГДЕ
	               |	ТаксировкаПутевогоЛиста.ПутевойЛист = &ПутевойЛист
	               |	И ТаксировкаПутевогоЛиста.ПометкаУдаления = ЛОЖЬ";
				   
	Запрос.УстановитьПараметр("ПутевойЛист", ПутевойЛист);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		РезультатПриВыезде = Выборка.ПоказанияСпидометраПриВыезде;
		Результат = ?(Выборка.ПоказанияСпидометраПриВыезде = 0, 0, Выборка.ПоказанияСпидометраПриВыезде + Выборка.ПробегОбщий);
	КонецЦикла;	
	
	Если ВсеПоказания Тогда
		СтруктураПоказанийСпидометра = Новый Структура;
		СтруктураПоказанийСпидометра.Вставить("ПриВыезде", РезультатПриВыезде);
		СтруктураПоказанийСпидометра.Вставить("ПриВозвращении", Результат);
		
		Результат = СтруктураПоказанийСпидометра;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

