Функция ИнвентарныйНомерОбъекта(ОсновноеСредство) Экспорт
	ПараметрыОС = Новый Структура;
	ПараметрыОС.Вставить("ОсновноеСредство", ОсновноеСредство);
	ДанныеИнвентарногоНомера = УправлениеОсновнымиСредствами.ПолучитьДанныеИнвентарногоНомераОС(ПараметрыОС);
	
	Возврат СокрЛП(ДанныеИнвентарногоНомера.ИнвентарныйНомер);
КонецФункции		

Функция ПолучитьАдресКонтрагента(Заказчик) Экспорт
	Результат = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Заказчик.ЮридическоеФизическоеЛицо,
															Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты);
															
	Возврат Результат;
КонецФункции

Функция ПолучитьДанныеВодителя(Водитель, ДатаПутевогоЛиста, СрокДействия = Неопределено) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	СтруктураДанныхВодителя = Новый Структура;
	ДанныеВодителя = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Водитель, "Контрагент");
	КонтрагентВодителя = ДанныеВодителя.Контрагент;
	ДанныеКонтрагента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(КонтрагентВодителя, "ЮридическоеФизическоеЛицо");
	
	ДанныеФизлица = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеКонтрагента.ЮридическоеФизическоеЛицо, "СтраховойНомерПФР");
	СНИЛС = ДанныеФизлица.СтраховойНомерПФР;
	Если ЗначениеЗаполнено(СрокДействия) Тогда
		Если СрокДействия >= Дата(2023,09,01) Тогда
			СтруктураДанныхВодителя.Вставить("СНИЛС",СНИЛС);
			СтруктураДанныхВодителя.Вставить("НаименованиеСНИЛС", НСтр("ru = 'СНИЛС'"));
		КонецЕсли;	
	КонецЕсли;	
	
	//данные удостоверения
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ДокументыФизическихЛицСрезПоследних.Представление,
	|	ДокументыФизическихЛицСрезПоследних.ВидДокумента,
	|	ДокументыФизическихЛицСрезПоследних.Серия,
	|	ДокументыФизическихЛицСрезПоследних.Номер,
	|	ДокументыФизическихЛицСрезПоследних.ДатаВыдачи,
	|	ДокументыФизическихЛицСрезПоследних.СрокДействия,
	|	ДокументыФизическихЛицСрезПоследних.КемВыдан,
	|	ДокументыФизическихЛицСрезПоследних.КодПодразделения
	|ИЗ
	|	РегистрСведений.ДокументыФизическихЛиц.СрезПоследних(&ДатаЗапроса, Физлицо = &Физлицо) КАК ДокументыФизическихЛицСрезПоследних
	|ГДЕ
	|	ДокументыФизическихЛицСрезПоследних.ВидДокумента = ЗНАЧЕНИЕ(Справочник.ВидыДокументовФизическихЛиц.ВодительскоеУдостоверение)");
	Запрос.УстановитьПараметр("Физлицо", ДанныеКонтрагента.ЮридическоеФизическоеЛицо);
	Запрос.УстановитьПараметр("ДатаЗапроса", ДатаПутевогоЛиста);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		СтруктураДанныхВодителя.Вставить("ПредставлениеУдостоверения",Выборка.Представление);
		СтруктураДанныхВодителя.Вставить("ВидДокументаУдостоверения", Выборка.ВидДокумента);
		СтруктураДанныхВодителя.Вставить("СерияУдостоверения",Выборка.Серия);
		СтруктураДанныхВодителя.Вставить("НомерУдостоверения",Выборка.Номер);
		СтруктураДанныхВодителя.Вставить("ДатаВыдачиУдостоверения",Выборка.ДатаВыдачи);
		СтруктураДанныхВодителя.Вставить("СрокДействияУдостоверения",Выборка.СрокДействия);
		СтруктураДанныхВодителя.Вставить("КемВыданУдостоверение",Выборка.КемВыдан);
		СтруктураДанныхВодителя.Вставить("ПредставлениеУдостоверения",Выборка.КодПодразделения);
		
		Если ЗначениеЗаполнено(СрокДействия) Тогда
			Если СрокДействия >= Дата(2023,09,01) Тогда
				СтруктураДанныхВодителя.Вставить("ДатаУдостоверения",Формат(Выборка.ДатаВыдачи, "ДФ='dd.MM.yyyy'"));
				СтруктураДанныхВодителя.Вставить("ВыданоВУ", НСтр("ru = ', выдано'"));
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	КлассВодителяСрезПоследних.Класс
	|ИЗ
	|	РегистрСведений.КлассВодителя.СрезПоследних(&ДатаЗапроса, Физлицо = &Физлицо) КАК КлассВодителяСрезПоследних");
	Запрос.УстановитьПараметр("ДатаЗапроса", ДатаПутевогоЛиста);
	Запрос.УстановитьПараметр("Физлицо", ДанныеКонтрагента.ЮридическоеФизическоеЛицо);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СтруктураДанныхВодителя.Вставить("КлассВодителя",Выборка.Класс);
	КонецЕсли;

	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат СтруктураДанныхВодителя;
КонецФункции	

Функция НайтиТаксировкиПоДокументу(ДокументОснование) Экспорт
	
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПутевойЛист3") ИЛИ
		ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПутевойЛист4П") ИЛИ
		ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПутевойЛист4С") ИЛИ
		ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПутевойЛист6спец") ИЛИ
		ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПутевойЛистЭСМ2") ИЛИ
		ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПутевойЛист3спец") ИЛИ
		ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПутевойЛист412АПК") ИЛИ
		ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПутевойЛист6") Тогда
		
		Результат = Документы.ТаксировкаПутевогоЛиста.ПустаяСсылка();
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаксировкаПутевогоЛиста.Ссылка
		|ИЗ
		|	Документ.ТаксировкаПутевогоЛиста КАК ТаксировкаПутевогоЛиста
		|ГДЕ
		|	ТаксировкаПутевогоЛиста.ПутевойЛист = &ПутевойЛист";
		
		Запрос.УстановитьПараметр("ПутевойЛист", ДокументОснование);

		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат = Выборка.Ссылка;
		КонецЦикла;	
			
	ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.РабочийЛистАгрегата") ИЛИ
		ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.УчетныйЛистТрактористаМашиниста") Тогда
		
		Результат = Документы.ТаксировкаРабочегоЛистаАгрегата.ПустаяСсылка();
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаксировкаРабочегоЛистаАгрегата.Ссылка
		|ИЗ
		|	Документ.ТаксировкаРабочегоЛистаАгрегата КАК ТаксировкаРабочегоЛистаАгрегата
		|ГДЕ
		|	ТаксировкаРабочегоЛистаАгрегата.РабочийЛистАгрегата = &РабочийЛист";
		
		Запрос.УстановитьПараметр("РабочийЛист", ДокументОснование);

		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат = Выборка.Ссылка;
		КонецЦикла;	
	КонецЕсли;	
	
    Возврат Результат;
КонецФункции

Процедура ЗаполнитьТекстПроТаксировку(Форма)  Экспорт
	ТаксировкаСсылка = УчетГСМ.НайтиТаксировкиПоДокументу(Форма["Объект"].Ссылка);
	Форма["ДокументТаксировка"] = ТаксировкаСсылка;
	
	Если НЕ ЗначениеЗаполнено(Форма["ДокументТаксировка"]) Тогда
		Форма.НадписьТаксировка = "Ввести таксировку";
	Иначе
		Форма.НадписьТаксировка = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='№ %1 от %2 г.'"),	Форма.ДокументТаксировка.Номер, Формат(Форма.ДокументТаксировка.Дата, "ДЛФ=D"));
	КонецЕсли;	
	
КонецПроцедуры	

Функция ПолучитьСокращенноеНаименованиеКонтрагента(Контрагент) Экспорт
	СтруктураРезультат = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Контрагент, "Код,НаименованиеСокращенное");
	
	Возврат СтруктураРезультат;
КонецФункции

Функция ПолучитьПериодРаботРабочегоЛистаАгрегата(РабочийЛистАгрегата) Экспорт
	
	Результат = Новый Структура;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	МИНИМУМ(РабочийЛистАгрегатаРезультатыРаботыАгрегата.ДатаРабот) КАК НачалоПериода,
	|	МАКСИМУМ(РабочийЛистАгрегатаРезультатыРаботыАгрегата.ДатаРабот) КАК КонецПериода
	|ИЗ
	|	Документ.РабочийЛистАгрегата.РезультатыРаботыАгрегата КАК РабочийЛистАгрегатаРезультатыРаботыАгрегата
	|ГДЕ
	|	РабочийЛистАгрегатаРезультатыРаботыАгрегата.Ссылка = &РабочийЛистАгрегата");
	
	Запрос.УстановитьПараметр("РабочийЛистАгрегата", РабочийЛистАгрегата);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Результат.Вставить("НачалоПериода",Выборка.НачалоПериода);
		Результат.Вставить("КонецПериода",Выборка.КонецПериода);
	КонецЦикла;	
	
	Если Результат.КонецПериода = NULL Тогда
		Результат = Неопределено;
	КонецЕсли;	
		
	Возврат Результат;
КонецФункции	

Функция ПолучитьФормулуДляТС() Экспорт
	ДанныеФормулы = Новый Структура;
	
	Формула = "(0.01 * (Транспортная (базовая) норма расхода * Пробег +  Норма расхода на транспортную работу) + Норма расхода на работу спец.оборудования и выполнение операций) * (1 + 0.01 * Поправочные коэффициенты) + Норма расхода на ездки самосвала + Норма расхода отопителей/кондиционеров, на прогрев и простой + ∑(Пробег/Контрольное значение*Поправочное значение) = Результат";
	Пояснение = ", где Транспортная (базовая) норма расхода включает в себя норму расхода на дополнительную массу прицепа, при наличии прицепа, Норма расхода на транспортную работу рассчитывается как произведение расхода ГСМ на выполнение транспортной работы по перевозке груза и объема транспортной работы";
	
	ДанныеФормулы.Вставить("Формула",Формула);
	ДанныеФормулы.Вставить("Пояснение",Пояснение);
	
	Возврат ДанныеФормулы;
КонецФункции

Функция ПолучитьФормулуДляАгрегата(ИдентификаторФормулы) Экспорт
	ДанныеФормулы = Новый Структура;
	
	Если ИдентификаторФормулы = 1 Тогда
		Формула = "(Продолжительность работы агрегата (ч) / Контрольный период (ч)) * Расход ГСМ за контрольный период * (1+0.01 * Поправочные коэффициенты) + ∑(Продолжительность работы агрегата (ч) / Контрольный период поправки (ч) * Поправочное значение) = Результат";
		Пояснение = ", где Контрольный период (ч) - значение основного параметра расчета нормы расхода, а Поправочное значение рассчитывается как Продолжительность работы агрегата (ч) / Значение основного параметра расчета (ч) * Значение расхода";
		ОсновнойПоказатель = "Продолжительность работы (ч)";
	ИначеЕсли ИдентификаторФормулы = 2 Тогда
		Формула = "(Объем работы (ед) / Норма выработки (ед)) * Расход ГСМ для нормы выработки*(1+0.01*Поправочные коэффициенты) + ∑(Объем работы (ед) / Объем работы поправки (ед) * Поправочное значение) = Результат";
		Пояснение = ", где Норма выработки (ед) - значение основного параметра расчета нормы расхода, а Поправочное значение рассчитывается как Объем работы (ед) / Значение основного параметра расчета * Значение расхода";
		ОсновнойПоказатель = "Объем работы";
	ИначеЕсли ИдентификаторФормулы = 3 Тогда
		Формула = "(Количество работы агрегата по счетчику / Контрольное количество работы агрегата по счетчику)*Расход ГСМ на работу агрегата при контрольных показателях счетчика * (1+0.01 * Поправочные коэффициенты) + ∑(Количество работы агрегата по счетчику / Контрольное количество работы агрегата по счетчику для поправки * Поправочное значение) = Результат";
		Пояснение = ", где Контрольное количество работы агрегата по счетчику - значение основного параметра расчета нормы расхода, а Поправочное значение рассчитывается как Количество работы агрегата по счетчику / Значение основного параметра расчета * Значение расхода";
		ОсновнойПоказатель = "Количество работы агрегата по счетчику";
	Иначе
		Формула = "Формула не определена";
		Пояснение = "";
		ОсновнойПоказатель = "";
	КонецЕсли;	
	
	ДанныеФормулы.Вставить("Формула",Формула);
	ДанныеФормулы.Вставить("Пояснение",Пояснение);
	ДанныеФормулы.Вставить("ОсновнойПоказатель",ОсновнойПоказатель);
	
	Возврат ДанныеФормулы;
КонецФункции

Функция ПолучитьФормулуДляСМ() Экспорт
	ДанныеФормулы = Новый Структура;
	Формула = "(0.01 * (Нормативный расход горючего * Норма расхода смазочных материалов и специальных жидкостей) * (1 + 0.01 * Поправочные коэффициенты) + ∑(Расход горючего/Контрольное значение расхода горючего*Поправочное значение) = Результат";
	Пояснение = ", где Контрольное значение расхода горючего - значение в единицах расхода горючего при котором расход смазочных материалов равен поправочному значению";
	
	ДанныеФормулы.Вставить("Формула",Формула);
	ДанныеФормулы.Вставить("Пояснение",Пояснение);
	
	Возврат ДанныеФормулы;
КонецФункции

Функция НастройкиОкругления(Организация, ВидГСМ, ДатаСведений) Экспорт
	//проверка на наличие настройки для организации и вида ГСМ
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	НастройкиОкругленияРасчетаНормативногоРасходаГСМСрезПоследних.КоличествоЗнаковДробнойЧасти КАК КоличествоЗнаковДробнойЧасти,
	|	НастройкиОкругленияРасчетаНормативногоРасходаГСМСрезПоследних.РежимОкругленияРезультата КАК РежимОкругленияРезультата
	|ИЗ
	|	РегистрСведений.НастройкиОкругленияРасчетаНормативногоРасходаГСМ.СрезПоследних(&ДатаСведений, Организация = &Организация) КАК НастройкиОкругленияРасчетаНормативногоРасходаГСМСрезПоследних
	|ГДЕ
	|	НастройкиОкругленияРасчетаНормативногоРасходаГСМСрезПоследних.ВидГСМ = &ВидГСМ");

	Запрос.УстановитьПараметр("ДатаСведений", ДатаСведений);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ВидГСМ", ВидГСМ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат Выборка;
	
КонецФункции	

Функция ПолучитьПараметрыОкругленияРасчетаНормГСМ(Организация, ВидГСМ, ДатаСведений) Экспорт
		
	ПараметрыОкругления = Новый Структура;
	
	Выборка = НастройкиОкругления(Организация, ВидГСМ, ДатаСведений);
	
	Пока Выборка.Следующий() Цикл
		ПараметрыОкругления.Вставить("КоличествоЗнаковДробнойЧасти", Выборка.КоличествоЗнаковДробнойЧасти);
		ПараметрыОкругления.Вставить("РежимОкругления", ?(Выборка.РежимОкругленияРезультата = 1, РежимОкругления.Окр15как10, РежимОкругления.Окр15как20));
		
		Возврат ПараметрыОкругления;
	КонецЦикла;
	
	Выборка = НастройкиОкругления(Организация, Справочники.ВидыГСМ.ПустаяСсылка(), ДатаСведений);
	
	Пока Выборка.Следующий() Цикл
		ПараметрыОкругления.Вставить("КоличествоЗнаковДробнойЧасти", Выборка.КоличествоЗнаковДробнойЧасти);
		ПараметрыОкругления.Вставить("РежимОкругления", ?(Выборка.РежимОкругленияРезультата = 1, РежимОкругления.Окр15как10, РежимОкругления.Окр15как20));
		
		Возврат ПараметрыОкругления;
	КонецЦикла;
	
	ПараметрыОкругления.Вставить("КоличествоЗнаковДробнойЧасти", 1);
	ПараметрыОкругления.Вставить("РежимОкругления", РежимОкругления.Окр15как20);
	
	Возврат ПараметрыОкругления;
КонецФункции	

Функция РежимыНастроекЗаполненияДокументаДляОС(Организация, ВидОбъектаРасходаГСМ, ВидДокумента, ОсновноеСредство) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	НастройкиДокументовУчетаГСМ.ЗаполнятьРеквизитВодительПринял,
	               |	НастройкиДокументовУчетаГСМ.ЗаполнятьРеквизитВодительСдал,
	               |	НастройкиДокументовУчетаГСМ.ЗаполнятьПоказанияСпидометраПоДаннымПоследнегоПЛ,
	               |	НастройкиДокументовУчетаГСМ.ЗаполнятьПоказанияСпидометраПоДаннымТаксировкиПоследнегоПЛ,
	               |	НастройкиДокументовУчетаГСМ.ЗаполнятьОстатокГорючегоПоДаннымПоследнегоПЛ,
	               |	НастройкиДокументовУчетаГСМ.ЗаполнятьОстатокГорючегоПоДаннымТаксировкиПоследнегоПЛ
	               |ИЗ
	               |	РегистрСведений.НастройкиДокументовУчетаГСМ КАК НастройкиДокументовУчетаГСМ
	               |ГДЕ
	               |	НастройкиДокументовУчетаГСМ.Организация = &Организация
	               |	И НастройкиДокументовУчетаГСМ.ОсновноеСредство = &ОсновноеСредство
	               |	И НастройкиДокументовУчетаГСМ.ВидОбъектаРасходаГСМ = &ВидОбъектаРасходаГСМ
	               |	И НастройкиДокументовУчетаГСМ.ВидДокументаУчетаГСМ = &ВидДокументаУчетаГСМ";
				   
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ОсновноеСредство", ОсновноеСредство);
	Запрос.УстановитьПараметр("ВидОбъектаРасходаГСМ", ВидОбъектаРасходаГСМ);
	Запрос.УстановитьПараметр("ВидДокументаУчетаГСМ", ВидДокумента);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат
КонецФункции

Функция РежимыНастроекЗаполненияДокумента(Организация, ВидОбъектаРасходаГСМ, ВидДокумента, ОсновноеСредство) Экспорт
	СтруктураНастроекЗаполненияДокумента = Новый Структура;
	СтруктураНастроекЗаполненияДокумента.Вставить("ЗаполнятьРеквизитВодительПринял", Ложь);
	СтруктураНастроекЗаполненияДокумента.Вставить("ЗаполнятьРеквизитВодительСдал", Ложь);
	СтруктураНастроекЗаполненияДокумента.Вставить("ЗаполнятьПоказанияСпидометраПоДаннымПоследнегоПЛ", Ложь);
	СтруктураНастроекЗаполненияДокумента.Вставить("ЗаполнятьПоказанияСпидометраПоДаннымТаксировкиПоследнегоПЛ", Ложь);
	СтруктураНастроекЗаполненияДокумента.Вставить("ЗаполнятьОстатокГорючегоПоДаннымПоследнегоПЛ", Ложь);
	СтруктураНастроекЗаполненияДокумента.Вставить("ЗаполнятьОстатокГорючегоПоДаннымТаксировкиПоследнегоПЛ", Ложь);
	
	РежимыОС = РежимыНастроекЗаполненияДокументаДляОС(Организация, ВидОбъектаРасходаГСМ, ВидДокумента, ОсновноеСредство);
	
	Если РежимыОС.Количество() = 0 Тогда
		РежимыОС = РежимыНастроекЗаполненияДокументаДляОС(Организация, ВидОбъектаРасходаГСМ, ВидДокумента, Справочники.ОсновныеСредства.ПустаяСсылка());
	КонецЕсли;	
	
	Если РежимыОС.Количество() > 0 Тогда 
		СтруктураНастроекЗаполненияДокумента.ЗаполнятьРеквизитВодительПринял = РежимыОС[0].ЗаполнятьРеквизитВодительПринял;
		СтруктураНастроекЗаполненияДокумента.ЗаполнятьРеквизитВодительСдал = РежимыОС[0].ЗаполнятьРеквизитВодительСдал;
		СтруктураНастроекЗаполненияДокумента.ЗаполнятьПоказанияСпидометраПоДаннымПоследнегоПЛ = РежимыОС[0].ЗаполнятьПоказанияСпидометраПоДаннымПоследнегоПЛ;
		СтруктураНастроекЗаполненияДокумента.ЗаполнятьПоказанияСпидометраПоДаннымТаксировкиПоследнегоПЛ = РежимыОС[0].ЗаполнятьПоказанияСпидометраПоДаннымТаксировкиПоследнегоПЛ;
		СтруктураНастроекЗаполненияДокумента.ЗаполнятьОстатокГорючегоПоДаннымПоследнегоПЛ = РежимыОС[0].ЗаполнятьОстатокГорючегоПоДаннымПоследнегоПЛ;
		СтруктураНастроекЗаполненияДокумента.ЗаполнятьОстатокГорючегоПоДаннымТаксировкиПоследнегоПЛ = РежимыОС[0].ЗаполнятьОстатокГорючегоПоДаннымТаксировкиПоследнегоПЛ;
	КонецЕсли;
	
	Возврат СтруктураНастроекЗаполненияДокумента;
	
КонецФункции	

