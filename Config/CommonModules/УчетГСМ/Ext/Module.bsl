Функция ПолучитьПредставлениеЛицензииНаПроведениеМедосмотров(Лицензия) Экспорт 
	
	Шаблон = "";
	ПредставлениеЛицензии = "";
	
	Если ЗначениеЗаполнено(Лицензия) Тогда
		
		РеквизитыЛицензииОрганизации = Новый Структура("Серия,Номер,ДатаНачала,ДатаОкончания");
		СведенияОЛицензииОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Лицензия, РеквизитыЛицензииОрганизации);
		
		Если СведенияОЛицензииОрганизации.ДатаОкончания = Дата(1,1,1) Тогда 
			Шаблон = "%1 № %2 от %3, %4";
			ДатаОкончанияЛицензии = "бессрочно";
		Иначе
			Шаблон = "%1 № %2 от %3, до %4"; 
			ДатаОкончанияЛицензии = Формат(СведенияОЛицензииОрганизации.ДатаОкончания,"ДФ=dd.MM.yyyy")
		КонецЕсли;
		
		ПредставлениеЛицензии = СтрШаблон(Шаблон, СведенияОЛицензииОрганизации.Серия, СведенияОЛицензииОрганизации.Номер,
			Формат(СведенияОЛицензииОрганизации.ДатаНачала,"ДФ=dd.MM.yyyy"), ДатаОкончанияЛицензии);
	КонецЕсли;
	
	Возврат ПредставлениеЛицензии;
		
КонецФункции  

Функция ЗначениеРеквизитаЭПД(ЭПД, Организация, НаименованиеРеквизита, ЗначениеПоУмолчанию) Экспорт
	Результат = ЗначениеПоУмолчанию;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗначенияРеквизитовДокументовЭПД.Документ КАК Документ,
	|	ЗначенияРеквизитовДокументовЭПД.Организация КАК Организация,
	|	ЗначенияРеквизитовДокументовЭПД.ИмяРеквизита КАК ИмяРеквизита,
	|	ЗначенияРеквизитовДокументовЭПД.ЗначениеРеквизита КАК ЗначениеРеквизита,
	|	ЗначенияРеквизитовДокументовЭПД.Титул КАК Титул,
	|	ЗначенияРеквизитовДокументовЭПД.НомерВерсии КАК НомерВерсии
	|ИЗ
	|	РегистрСведений.ЗначенияРеквизитовДокументовЭПД КАК ЗначенияРеквизитовДокументовЭПД
	|ГДЕ
	|	ЗначенияРеквизитовДокументовЭПД.Документ = &Документ
	|	И ЗначенияРеквизитовДокументовЭПД.Организация = &Организация
	|	И ЗначенияРеквизитовДокументовЭПД.ИмяРеквизита = &ИмяРеквизита
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерВерсии УБЫВ";
	Запрос.УстановитьПараметр("Документ", ЭПД);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ИмяРеквизита", НаименованиеРеквизита);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат = Выборка.ЗначениеРеквизита;
	КонецЦикла;	

	Возврат Результат;
КонецФункции

Функция ПробегПоЭлектронномуПутевомуЛисту(ЭПД, Организация) Экспорт
	Результат = 0;

	ПоказанияОбометраПриВыезде = ЗначениеРеквизитаЭПД(ЭПД, Организация, "ТитулВыездПоказанияОдометраПриВыезде", 0);
	ПоказанияОбометраПриЗаезде = ЗначениеРеквизитаЭПД(ЭПД, Организация, "ТитулЗаездПоказанияОдометраПриЗаезде", 0);
	
	Пробег = ПоказанияОбометраПриЗаезде - ПоказанияОбометраПриВыезде;
	
	Если Пробег > 0 Тогда
		Результат = Пробег;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

Функция ЭтоВисокосныйГод(ДатаРасчета) Экспорт
	ВсегоДнейВГоду = ДеньГода(КонецГода(ДатаРасчета));
	Результат = ?(ВсегоДнейВГоду = 366, Истина, Ложь);
	
	Возврат Результат;
КонецФункции	