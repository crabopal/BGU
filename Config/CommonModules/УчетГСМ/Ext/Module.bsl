Функция ПолучитьНормыРасходаТС(Организация,ВидОбъектаРасходаГСМ,ОбъектРасходаГСМ,ВидНастройкиРасходаГСМ,ВидГСМ,ДатаЗапроса) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НастройкиНормРасходаГСМСрезПоследних.НазваниеНастройки,
	|	НастройкиНормРасходаГСМСрезПоследних.Настройка,
	|	НастройкиНормРасходаГСМСрезПоследних.ДействуетПослеПревышенияПробегаИлиПредельногоСрокаЭксплуатации,
	|	НастройкиНормРасходаГСМСрезПоследних.ДействуетДоПревышенияПробега,
	|	НастройкиНормРасходаГСМСрезПоследних.ПредельныйПробег,
	|	НастройкиНормРасходаГСМСрезПоследних.НачалоПериодаКонтроляПробега,
	|	НастройкиНормРасходаГСМСрезПоследних.ПредельнаяДата,
	|	НастройкиНормРасходаГСМСрезПоследних.ПредельнаяДатаОкончанияДействия,
	|	НастройкиНормРасходаГСМСрезПоследних.ПредельныйПробегОкончанияДействия
	|ИЗ
	|	РегистрСведений.НастройкиНормРасходаГСМ.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ТС = &ОбъектРасходаГСМ) КАК НастройкиНормРасходаГСМСрезПоследних
	|ГДЕ
	|	ТИПЗНАЧЕНИЯ(НастройкиНормРасходаГСМСрезПоследних.Настройка) = ТИПЗНАЧЕНИЯ(&ВидНастройкиРасходаГСМ)
	|	И НастройкиНормРасходаГСМСрезПоследних.Настройка.ВидГСМ В(&ВидГСМ)
	|	И НастройкиНормРасходаГСМСрезПоследних.ВидОбъектаРасходаГСМ В(&ВидОбъектаРасходаГСМ)
	|	И (РАЗНОСТЬДАТ(&Период, НастройкиНормРасходаГСМСрезПоследних.ДатаОкончанияДействия, ДЕНЬ) >= 0
	|			ИЛИ НастройкиНормРасходаГСМСрезПоследних.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))";

	СписокДоступныхЗначенийВидаОбъектов = Новый СписокЗначений;
	СписокДоступныхЗначенийВидаОбъектов.Добавить(ВидОбъектаРасходаГСМ);
	СписокДоступныхЗначенийВидаОбъектов.Добавить(Перечисления.ВидыОбъектовРасходаГСМ.ПустаяСсылка());
	
	СписокДоступныхЗначенийВидаГСМ = Новый СписокЗначений;
	СписокДоступныхЗначенийВидаГСМ.Добавить(ВидГСМ);
	СписокДоступныхЗначенийВидаГСМ.Добавить(Справочники.ВидыГСМ.ПустаяСсылка());
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ВидОбъектаРасходаГСМ", СписокДоступныхЗначенийВидаОбъектов);
	Запрос.УстановитьПараметр("ОбъектРасходаГСМ", ОбъектРасходаГСМ);
	Запрос.УстановитьПараметр("Период", ДатаЗапроса);
	Запрос.УстановитьПараметр("ВидНастройкиРасходаГСМ", ВидНастройкиРасходаГСМ);
	Запрос.УстановитьПараметр("ВидГСМ", СписокДоступныхЗначенийВидаГСМ);

	Результат = Запрос.Выполнить();
	
    Возврат Результат;
КонецФункции	

Функция ПолучитьПаспортТранспортногоСредства(ТранспортноеСредство, Период = '00010101') Экспорт
	
	Результат = Новый Структура("СерияНомер,ИдентификационныйНомер,Марка,Модель,
		|Тип,ДвигательМодель,ДвигательНомер,НомерШасси,НомерКузова,ЭкологическийКласс,
		|Масса,ГаражныйНомер,Грузоподъемность,Колонна,РегистрационныйЗнак,ДатаРегистрации,ДатаСнятияСУчета");
	
	Если Не ЗначениеЗаполнено(ТранспортноеСредство) Тогда
		Возврат Результат; 
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", Период);	
	Запрос.УстановитьПараметр("ОсновноеСредство", ТранспортноеСредство);	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПТС.СерияНомер КАК СерияНомер,
	|	ПТС.ИдентификационныйНомер КАК ИдентификационныйНомер,
	|	ПТС.Марка КАК Марка,
	|	ПТС.Модель КАК Модель,
	|	ПТС.Тип КАК Тип,
	|	ПТС.ДвигательМодель КАК ДвигательМодель,
	|	ПТС.ДвигательНомер КАК ДвигательНомер,
	|	ПТС.НомерШасси КАК НомерШасси,
	|	ПТС.НомерКузова КАК НомерКузова,
	|	ПТС.ЭкологическийКласс КАК ЭкологическийКласс,
	|	ПТС.Масса КАК Масса,
	|	ПТС.ГаражныйНомер КАК ГаражныйНомер,
	|	ПТС.Грузоподъемность КАК Грузоподъемность,
	|	ПТС.Колонна КАК Колонна,
	|	ПТС.РегистрационныйЗнак КАК РегистрационныйЗнак,
	|	ПТС.ДатаРегистрации КАК ДатаРегистрации,
	|	ПТС.ДатаСнятияСУчета КАК ДатаСнятияСУчета
	|ИЗ
	|	РегистрСведений.ПаспортаТранспортныхСредств.СрезПоследних(&Период, ОсновноеСредство = &ОсновноеСредство) КАК ПТС";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЦикла;	
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьГосударственныйНомернойЗнакТС(ТранспортноеСредство) Экспорт
	
	ПТС = ПолучитьПаспортТранспортногоСредства(ТранспортноеСредство);
	Результат = ПТС.РегистрационныйЗнак;
	
	Возврат ?(ЗначениеЗаполнено(Результат), Результат, "");
	
КонецФункции	

Функция ПолучитьМаркуТС(ТранспортноеСредство) Экспорт
	
