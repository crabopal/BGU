	               |	И НЕ ТаксировкаРабочегоЛистаАгрегатаФактическийРасходГСМ.Ссылка.ВидТаксировки В (&ВидСводнойТаксировки)
	               |	И ТаксировкаРабочегоЛистаАгрегатаФактическийРасходГСМ.Ссылка.Проведен = ИСТИНА";
	
	Запрос.УстановитьПараметр("НачалоПериода",НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода",КонецДня(КонецПериода));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Агрегат", Агрегат);
	Запрос.УстановитьПараметр("ВидГСМ", ВидГСМ);
	Запрос.УстановитьПараметр("ВидСводнойТаксировки", МассивВидовСводныхТаксировок());
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат = Выборка.ФактическийРасход;
	КонецЦикла;
	
	Возврат Результат;
