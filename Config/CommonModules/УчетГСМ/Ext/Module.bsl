Функция ОстатокГСМПоТаблицеОстатков(ВидГСМ, ТаблицаОстатков) Экспорт
	Результат  = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОстаткиГСМ.ВидГСМ,
	               |	ОстаткиГСМ.ОстатокГорючегоПриВозвращении КАК ОстатокГорючего
	               |ПОМЕСТИТЬ ОстаткиГСМПриВозвращении
	               |ИЗ
	               |	&ОстаткиГСМ КАК ОстаткиГСМ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОстаткиГСМПриВозвращении.ОстатокГорючего
	               |ИЗ
	               |	ОстаткиГСМПриВозвращении КАК ОстаткиГСМПриВозвращении
	               |ГДЕ
	               |	ОстаткиГСМПриВозвращении.ВидГСМ В (&ВидГСМ)";
	Запрос.УстановитьПараметр("ОстаткиГСМ", ТаблицаОстатков);
	Запрос.УстановитьПараметр("ВидГСМ", ВидГСМ);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат = Результат + Выборка.ОстатокГорючего;
	КонецЦикла;	
	
	Возврат Результат;
КонецФункции

Функция НайтиПредыдущийУчетныйЛист(УчетныйЛист, Машина, ДатаУчетногоЛиста) Экспорт
	Результат = Неопределено;
	
	Если НЕ ЗначениеЗаполнено(Машина) Тогда
		Возврат Результат;
	КонецЕсли;	
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЖурналПутевыхЛистов.Ссылка,
	|	ЖурналПутевыхЛистов.Дата,
	|	ЖурналПутевыхЛистов.НомерСмены
	|ПОМЕСТИТЬ ПервичныеДокументы
	|ИЗ
	|	ЖурналДокументов.ЖурналПутевыхЛистов КАК ЖурналПутевыхЛистов
	|ГДЕ
	|	ЖурналПутевыхЛистов.ТранспортноеСредство = &Машина
	|	И ЖурналПутевыхЛистов.Дата <= &Дата
	|	И НЕ ЖурналПутевыхЛистов.Ссылка = &ТекущийДокумент
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	УчетныйЛистТрактористаМашиниста.Ссылка,
	|	УчетныйЛистТрактористаМашиниста.Дата,
	|	0
	|ИЗ
	|	Документ.УчетныйЛистТрактористаМашиниста КАК УчетныйЛистТрактористаМашиниста
	|ГДЕ
	|	УчетныйЛистТрактористаМашиниста.Агрегат = &Машина
	|	И УчетныйЛистТрактористаМашиниста.Дата <= &Дата
	|	И НЕ УчетныйЛистТрактористаМашиниста.Ссылка = &ТекущийДокумент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПервичныеДокументы.Ссылка,
	|	ПервичныеДокументы.Дата КАК Дата
	|ИЗ
	|	ПервичныеДокументы КАК ПервичныеДокументы
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ,
	|	ПервичныеДокументы.НомерСмены УБЫВ");
	
	Запрос.УстановитьПараметр("Машина", Машина);
	Запрос.УстановитьПараметр("Дата", ДатаУчетногоЛиста);
	Запрос.УстановитьПараметр("ТекущийДокумент", УчетныйЛист);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат  Результат;
КонецФункции

Функция ПоказанияСпидометраПоПутевомуЛисту(ПутевойЛист) Экспорт
	Результат = 0;
	
	Если ЗначениеЗаполнено(ПутевойЛист) Тогда
		Если ТипЗнч(ПутевойЛист) = Тип("ДокументСсылка.ПутевойЛистЭСМ2") Тогда
			КоличествоСтрок = ПутевойЛист.ЗаданиеВодителю.Количество();
			Если КоличествоСтрок>0 Тогда
				Результат = ПутевойЛист.ЗаданиеВодителю[КоличествоСтрок-1].ПоказанияСпидометраПриВозвращении;
			КонецЕсли;	
		Иначе	
			Результат = ПутевойЛист.ПоказанияСпидометраПриВозвращении;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

Функция ОстаткиГорючегоПоПутевомуЛисту(ПутевойЛист) Экспорт
	ОстатокГСМ = 0;
	МаркиГСМ = "";
	КодыМарокГСМ = "";
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ВидГСМ", Новый ОписаниеТипов("СправочникСсылка.ВидыГСМ"));
	Результат.Колонки.Добавить("МаркаГСМ", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("КодМаркиГСМ", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ОстатокГСМ", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("ЕдиницаИзмерения", Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"));
	Результат.Колонки.Добавить("ВариантГСМ", Новый ОписаниеТипов("Число"));
	
	Если ЗначениеЗаполнено(ПутевойЛист) Тогда
		Если ТипЗнч(ПутевойЛист) = Тип("ДокументСсылка.ПутевойЛистЭСМ2") Тогда
			КоличествоСтрок = ПутевойЛист.ЗаданиеВодителю.Количество();
			Если КоличествоСтрок>0 Тогда
				ТекСтрока = ПутевойЛист.ЗаданиеВодителю[КоличествоСтрок-1];
				ОстатокГСМ = ТекСтрока.ОстатокГорючегоПриВозвращении;
				ВариантГСМ = 0;
				ВидГСМ = Справочники.ВидыГСМ.ПустаяСсылка();
				
				Если ЗначениеЗаполнено(ТекСтрока.ВыданоБензинВидГСМ) Тогда
					ДобавитьСтрокуГСМ = Истина;
					ВидГСМ = ТекСтрока.ВыданоБензинВидГСМ;
					ВариантГСМ = 1;
				ИначеЕсли ЗначениеЗаполнено(ТекСтрока.ВыданоДТВидГСМ) Тогда	
					ДобавитьСтрокуГСМ = Истина;
					ВидГСМ = ТекСтрока.ВыданоДТВидГСМ;
					ВариантГСМ = 2;
				ИначеЕсли ЗначениеЗаполнено(ТекСтрока.ВыданоИногоГорючего) Тогда	
					ДобавитьСтрокуГСМ = Истина;
					ВидГСМ = ТекСтрока.ВыданоИногоГорючегоВидГСМ;
					ВариантГСМ = 3;
				КонецЕсли;	
				
				НоваяСтрока = Результат.Добавить();
				НоваяСтрока.ВидГСМ = ВидГСМ;
				НоваяСтрока.ВариантГСМ = ВариантГСМ;
				НоваяСтрока.ОстатокГСМ = ОстатокГСМ;
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(ПутевойЛист) = Тип("ДокументСсылка.ПутевойЛист3") Тогда	
			Для Каждого ТекСтрока Из ПутевойЛист.ДвижениеГорючего Цикл
				НоваяСтрока = Результат.Добавить();
				НоваяСтрока.ВидГСМ = ТекСтрока.ВидГСМ;
				НоваяСтрока.МаркаГСМ = ТекСтрока.МаркаГорючего;
				НоваяСтрока.КодМаркиГСМ = ТекСтрока.КодМаркиГорючего;
				НоваяСтрока.ОстатокГСМ = ТекСтрока.ОстатокГорючегоПриВозвращении;
				НоваяСтрока.ЕдиницаИзмерения = ТекСтрока.ЕдиницаИзмеренияГорючего;
			КонецЦикла;	
		ИначеЕсли ТипЗнч(ПутевойЛист) = Тип("ДокументСсылка.ПутевойЛист6") Тогда	
			Для Каждого ТекСтрока Из ПутевойЛист.ДвижениеГорючего Цикл
				НоваяСтрока = Результат.Добавить();
				НоваяСтрока.ВидГСМ = ТекСтрока.ВидГСМ;
				НоваяСтрока.МаркаГСМ = ТекСтрока.МаркаГорючего;
				НоваяСтрока.КодМаркиГСМ = ТекСтрока.КодМаркиГорючего;
				НоваяСтрока.ОстатокГСМ = ТекСтрока.ЗамерОстаткаГорючегоПриВозвращении;
				НоваяСтрока.ЕдиницаИзмерения = ТекСтрока.ЕдиницаИзмеренияГорючего;
			КонецЦикла;	
		ИначеЕсли ТипЗнч(ПутевойЛист) = Тип("ДокументСсылка.ПутевойЛист412АПК") Тогда 	
			Для Каждого ТекСтрока Из ПутевойЛист.ДвижениеГорючего Цикл
				НоваяСтрока = Результат.Добавить();
				НоваяСтрока.ВидГСМ = ТекСтрока.ВидГСМ;
				НоваяСтрока.МаркаГСМ = ТекСтрока.МаркаГорючего;
				НоваяСтрока.КодМаркиГСМ = ТекСтрока.КодМаркиГорючего;
				НоваяСтрока.ОстатокГСМ = ТекСтрока.ОстатокГорючегоПриВозвращении;
				НоваяСтрока.ЕдиницаИзмерения = ТекСтрока.ЕдиницаИзмерения;
			КонецЦикла;	
		ИначеЕсли ТипЗнч(ПутевойЛист) = Тип("ДокументСсылка.УчетныйЛистТрактористаМашиниста") Тогда 	
			Для Каждого ТекСтрока Из ПутевойЛист.ДвижениеГорючего Цикл
				НоваяСтрока = Результат.Добавить();
				НоваяСтрока.ВидГСМ = ТекСтрока.ВидГСМ;
				НоваяСтрока.МаркаГСМ = ТекСтрока.МаркаГорючего;
				НоваяСтрока.КодМаркиГСМ = ТекСтрока.КодМаркиГорючего;
				НоваяСтрока.ОстатокГСМ = ТекСтрока.ОстатокГорючегоПриВозвращении;
				НоваяСтрока.ЕдиницаИзмерения = ТекСтрока.ЕдиницаИзмерения;
			КонецЦикла;	
		Иначе 	
			Для Каждого ТекСтрока Из ПутевойЛист.ДвижениеГорючего Цикл
				НоваяСтрока = Результат.Добавить();
				НоваяСтрока.ВидГСМ = ТекСтрока.ВидГСМ;
				НоваяСтрока.МаркаГСМ = ТекСтрока.МаркаГорючего;
				НоваяСтрока.КодМаркиГСМ = ТекСтрока.КодМаркиГорючего;
				НоваяСтрока.ОстатокГСМ = ТекСтрока.ОстатокГорючегоПриВозвращении;
			КонецЦикла;	
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

Функция ПробегДоТаксировки(ТранспортноеСредство, НачалоПериода, КонецПериода, ПоказанияСпидометраПриВыезде) Экспорт
	Результат = 0;
	
	ПробегТСНаНачалоПериода = ПробегТСНаНачалоПериода(ТранспортноеСредство, НачалоПериода, КонецПериода);	
	ПробегТСЗаПериод = ПробегТСЗаПериод(ТранспортноеСредство, НачалоПериода, КонецПериода);
	ПробегЗаПоследнийПериод = ПоказанияСпидометраПриВыезде - ПробегТСНаКонецПериода(ТранспортноеСредство, НачалоПериода, КонецПериода);
	Если ПробегЗаПоследнийПериод < 0 Тогда
		ПробегЗаПоследнийПериод = 0;
	КонецЕсли;	
	Результат = ПробегТСНаНачалоПериода + ПробегТСЗаПериод + ПробегЗаПоследнийПериод;
	
	Возврат Результат;
КонецФункции	

Функция ПробегТСЗаПериод(ТранспортноеСредство, НачалоПериода, КонецПериода) Экспорт
	Результат = 0;
	ТаблицаСбросаПробега = ТаблицаСбросовСчетчикаПробега(ТранспортноеСредство, НачалоПериода, КонецПериода);
	Если ТаблицаСбросаПробега.Количество()=0 Тогда
		Результат = ПробегТСЗаПериодБезИзменений(ТранспортноеСредство, НачалоПериода, КонецПериода);
	Иначе
		НачалоИнтервала = НачалоПериода;
		Для Каждого ТекСтрока Из ТаблицаСбросаПробега Цикл
			КонецИнтервала = НачалоДня(ТекСтрока.ДатаПЛ)-1;
			РезультатДляПериода = ПробегТСЗаПериодБезИзменений(ТранспортноеСредство, НачалоИнтервала, КонецИнтервала);
			НачалоИнтервала = НачалоДня(ТекСтрока.ДатаПЛ);
			Результат = Результат + РезультатДляПериода;
		КонецЦикла;	
		РезультатДляПериода = ПробегТСЗаПериодБезИзменений(ТранспортноеСредство, НачалоИнтервала, КонецПериода);
		Результат = Результат + РезультатДляПериода;
	КонецЕсли;
	
	Возврат Результат;	
КонецФункции	

Функция ТаблицаСбросовСчетчикаПробега(ТранспортноеСредство, НачалоПериода, КонецПериода)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТаксировкаПутевогоЛиста.Ссылка,
	               |	ТаксировкаПутевогоЛиста.ДатаПутевогоЛиста КАК ДатаПЛ
	               |ИЗ
	               |	Документ.ТаксировкаПутевогоЛиста КАК ТаксировкаПутевогоЛиста
	               |ГДЕ
	               |	ТаксировкаПутевогоЛиста.ДатаПутевогоЛиста МЕЖДУ &НачалоПериода И &КонецПериода
	               |	И ТаксировкаПутевогоЛиста.ТранспортноеСредство = &ТранспортноеСредство
	               |	И ТаксировкаПутевогоЛиста.Проведен = ИСТИНА
	               |	И НЕ ТаксировкаПутевогоЛиста.ВидТаксировки В (&ВидСводнойТаксировки)
	               |	И ТаксировкаПутевогоЛиста.ПерваяТаксировкаПослеСбросаСчетчикаПробега = ИСТИНА
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДатаПЛ";
				   
	Запрос.УстановитьПараметр("НачалоПериода",НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода",КонецДня(КонецПериода));
	Запрос.УстановитьПараметр("ТранспортноеСредство",ТранспортноеСредство);
	Запрос.УстановитьПараметр("ВидСводнойТаксировки",МассивВидовСводныхТаксировок());
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
КонецФункции

Функция ДатаПоследнегоСбросаСчетчикаПробега(ТранспортноеСредство, ДатаСведений, Таксировка = Неопределено) Экспорт
	Запрос = Новый Запрос;
	
	НачалоПериода = Дата(1,1,1);
	КонецПериода = ДатаСведений;
	
	ТаблицаДанныхОСбросах = ТаблицаСбросовСчетчикаПробега(ТранспортноеСредство, НачалоПериода, КонецПериода);
	
	Если ТаблицаДанныхОСбросах.Количество()=0 Тогда
		Результат = НачалоПериода;
	Иначе
		ТаксировкаПЛ = ТаблицаДанныхОСбросах[ТаблицаДанныхОСбросах.Количество()-1].Ссылка;
		Если ТаксировкаПЛ = Таксировка Тогда
			Если ТаблицаДанныхОСбросах.Количество()>1 Тогда
				ТаксировкаПЛ = ТаблицаДанныхОСбросах[ТаблицаДанныхОСбросах.Количество()-2].Ссылка;
				Результат = ТаксировкаПЛ.ДатаПутевогоЛиста;
			Иначе
				Результат = Дата(1,1,1);
			КонецЕсли;	
		Иначе	
			Результат = ТаксировкаПЛ.ДатаПутевогоЛиста;
		КонецЕсли;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

Функция ПробегТСЗаПериодБезИзменений(ТранспортноеСредство, НачалоПериода, КонецПериода) Экспорт
	Результат = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЕСТЬNULL(ТаксировкаПутевогоЛиста.ПоказанияСпидометраПриВыезде, 0) КАК ПоказанияСпидометраНаНачалоПериода,
	|	ТаксировкаПутевогоЛиста.Ссылка
	|ПОМЕСТИТЬ ПерваяТаксировка
	|ИЗ
	|	Документ.ТаксировкаПутевогоЛиста КАК ТаксировкаПутевогоЛиста
	|ГДЕ
	|	ТаксировкаПутевогоЛиста.ДатаПутевогоЛиста МЕЖДУ &НачалоПериода И &КонецПериода
	|	И ТаксировкаПутевогоЛиста.ТранспортноеСредство = &ТранспортноеСредство
	|	И ТаксировкаПутевогоЛиста.Проведен = ИСТИНА
	|	И НЕ ТаксировкаПутевогоЛиста.ВидТаксировки В (&ВидСводнойТаксировки)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТаксировкаПутевогоЛиста.ДатаПутевогоЛиста,
	|	ТаксировкаПутевогоЛиста.НомерСмены
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЕСТЬNULL(ТаксировкаПутевогоЛиста.ПоказанияСпидометраПриВыезде, 0) + ЕСТЬNULL(ТаксировкаПутевогоЛиста.ПробегОбщий, 0) КАК ПоказанияСпидометраНаКонецПериода,
	|	ТаксировкаПутевогоЛиста.Ссылка
	|ПОМЕСТИТЬ ПоследняяТаксировка
	|ИЗ
	|	Документ.ТаксировкаПутевогоЛиста КАК ТаксировкаПутевогоЛиста
	|ГДЕ
	|	ТаксировкаПутевогоЛиста.ДатаПутевогоЛиста МЕЖДУ &НачалоПериода И &КонецПериода
	|	И ТаксировкаПутевогоЛиста.ТранспортноеСредство = &ТранспортноеСредство
	|	И ТаксировкаПутевогоЛиста.Проведен = ИСТИНА
	|	И НЕ ТаксировкаПутевогоЛиста.ВидТаксировки В (&ВидСводнойТаксировки)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТаксировкаПутевогоЛиста.ДатаПутевогоЛиста УБЫВ,
	|	ТаксировкаПутевогоЛиста.НомерСмены УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПоследняяТаксировка.ПоказанияСпидометраНаКонецПериода - ПерваяТаксировка.ПоказанияСпидометраНаНачалоПериода КАК ПробегЗаПериод
	|ИЗ
	|	ПерваяТаксировка КАК ПерваяТаксировка,
	|	ПоследняяТаксировка КАК ПоследняяТаксировка";
	
	Запрос.УстановитьПараметр("НачалоПериода",НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода",КонецДня(КонецПериода));
	Запрос.УстановитьПараметр("ТранспортноеСредство",ТранспортноеСредство);
	Запрос.УстановитьПараметр("ВидСводнойТаксировки",МассивВидовСводныхТаксировок());
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ПробегЗаПериод > 0 Тогда
			Результат = Выборка.ПробегЗаПериод;
		КонецЕсли;
	КонецЦикла;	
	
	Возврат Результат;
КонецФункции	

Функция СрокДействияПутевогоЛиста(ДатаПутевогоЛиста, ДатаОкончанияСрокаДействия, СОт = Ложь) Экспорт
	
	ДатаДокумента = Формат(ДатаПутевогоЛиста, "ДФ=""дд ММММ гггг 'г.'""");
	ДатаОкончанияДействия = Формат(ДатаОкончанияСрокаДействия, "ДФ=""дд ММММ гггг 'г.'""");
	
	Если (ДатаДокумента = ДатаОкончанияДействия)ИЛИ(ДатаОкончанияСрокаДействия = '00010101') Тогда
		
		Результат = ?(СОт, "от ","")+ДатаДокумента;
		
	Иначе
		
		Результат = "с " + ДатаДокумента + " по "+ДатаОкончанияДействия;
		
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	
	
Процедура ОбработатьДобавлениеЗакупокДляВидаГСМ(Знач КоллекцияВидовГСМ, Знач ВыбранноеЗначение) Экспорт
	КолонкиПоиска = "ВидГСМ";
	
	ТаблицаЗаправкиГСМ = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресДанныхЗаправкиВХранилище);
	ВидГСМ = ВыбранноеЗначение.ВидГСМ;
	
	СтруктураПоискаГСМ = Новый Структура(КолонкиПоиска);
	СтруктураПоискаГСМ.ВидГСМ = ВидГСМ;
	
	Если ЗначениеЗаполнено(ВидГСМ) Тогда
		СтрокиИсходныхДанных = КоллекцияВидовГСМ.НайтиСтроки(СтруктураПоискаГСМ);
		Для Каждого	ТекСтрока Из СтрокиИсходныхДанных Цикл
			КоллекцияВидовГСМ.Удалить(ТекСтрока);
		КонецЦикла;	
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из ТаблицаЗаправкиГСМ Цикл
		ЭлементКоллекции = КоллекцияВидовГСМ.Добавить();
		ЗаполнитьЗначенияСвойств(ЭлементКоллекции, СтрокаТаблицы);
	КонецЦикла;
	
КонецПроцедуры		

Функция ПолучитьДанныеПутевогоЛиста(ДокументСсылка) Экспорт
	СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "ТранспортноеСредство, Водитель, Номер, Дата, СерияПутевогоЛиста, СрокДействия, ГаражныйНомер, РегистрационныйНомернойЗнак, НомерСмены");
	
	Возврат СтруктураДанных;
КонецФункции

Функция ПолучитьДанныеЭлектронногоПутевогоЛиста(ДокументСсылка, Таксировка) Экспорт
	СтруктураДанныхЭПЛ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Организация");
	Организация = СтруктураДанныхЭПЛ.Организация;
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ТранспортноеСредство", Справочники.ОсновныеСредства.ПустаяСсылка());
	СтруктураДанных.Вставить("Водитель", Справочники.Сотрудники.ПустаяСсылка());
	СтруктураДанных.Вставить("Номер", "");
	СтруктураДанных.Вставить("Дата", Дата(1,1,1));
	СтруктураДанных.Вставить("СерияПутевогоЛиста", "");
	СтруктураДанных.Вставить("СрокДействия", Дата(1,1,1));
	СтруктураДанных.Вставить("ГаражныйНомер", "");
	СтруктураДанных.Вставить("РегистрационныйНомернойЗнак", "");
	СтруктураДанных.Вставить("НомерСмены", 0);
	
	ДанныеРеквизитовЭПД = ДанныеРеквизитовЭПДЭлектронногоПутевогоЛиста(ДокументСсылка);
	
	СтруктураДанных.Номер = ДанныеРеквизитовЭПД.ТитулОформлениеНомерПутевогоЛиста;
	СтруктураДанных.Дата = ДанныеРеквизитовЭПД.ТитулОформлениеДатаПутевогоЛиста;
	СтруктураДанных.СрокДействия = ДанныеРеквизитовЭПД.ТитулОформлениеДатаВТечениеКоторойПутевойЛистМожетБытьИспользован;
	СтруктураДанных.РегистрационныйНомернойЗнак = ДанныеРеквизитовЭПД.ТитулОформлениеТранспортноеСредствоРегистрационныйНомер;
	
	ТранспортноеСредство = ТранспортноеСредствоПоРегистрационномуНомеру(Организация, СтруктураДанных.РегистрационныйНомернойЗнак, СтруктураДанных.Дата);
	
	Если ЗначениеЗаполнено(ТранспортноеСредство) Тогда
		СтруктураДанных.ТранспортноеСредство = ТранспортноеСредство;
		
		ПаспортТС = ПолучитьПаспортТранспортногоСредства(ТранспортноеСредство, СтруктураДанных.Дата); 
		СтруктураДанных.ГаражныйНомер = ПаспортТС.ГаражныйНомер;
	КонецЕсли;	
	
	Водители = ДанныеРеквизитовЭПД.ТитулОформлениеВодители;
	СтруктураДанных.Вставить("Водители", Водители);
	
	Если Водители.Количество() = 1 Тогда
		ДанныеОВодителе = Новый Структура;
		ДанныеОВодителе.Вставить("ИНН", ДанныеРеквизитовЭПД.ТитулОформлениеВодители[0].ФЛ_ИНН);
		ДанныеОВодителе.Вставить("НомерВУ", ДанныеРеквизитовЭПД.ТитулОформлениеВодители[0].НомерВУ);
		ДанныеОВодителе.Вставить("Фамилия", ДанныеРеквизитовЭПД.ТитулОформлениеВодители[0].Фамилия);
		ДанныеОВодителе.Вставить("Имя", ДанныеРеквизитовЭПД.ТитулОформлениеВодители[0].Имя);
		ДанныеОВодителе.Вставить("Отчество", ДанныеРеквизитовЭПД.ТитулОформлениеВодители[0].Отчество);
		
		Водитель = ВодительПоДаннымЭПЛ(Организация, ДанныеОВодителе, СтруктураДанных.Дата);
		
		СтруктураДанных.Водитель = Водитель;
		СтруктураДанных.НомерСмены = 1;
	Иначе
		НомерСмены = 1;
		Для Каждого ТекСтрока Из Водители Цикл
			ДанныеОВодителе = Новый Структура;
			ДанныеОВодителе.Вставить("ИНН", ТекСтрока.ФЛ_ИНН);
			ДанныеОВодителе.Вставить("НомерВУ", ТекСтрока.НомерВУ);
			ДанныеОВодителе.Вставить("Фамилия", ТекСтрока.Фамилия);
			ДанныеОВодителе.Вставить("Имя", ТекСтрока.Имя);
			ДанныеОВодителе.Вставить("Отчество", ТекСтрока.Отчество);
			
			ТекВодитель = ВодительПоДаннымЭПЛ(Организация, ДанныеОВодителе, СтруктураДанных.Дата);
			
			ЕстьТаксировкаЭПЛДляВодителя = ЕстьТаксировкаЭПЛДляВодителя(ДокументСсылка, Таксировка, ТекВодитель);
			
			Если НЕ ЕстьТаксировкаЭПЛДляВодителя Тогда
				СтруктураДанных.Водитель = ТекВодитель;
				СтруктураДанных.НомерСмены = НомерСмены;
				
				Прервать;
			КонецЕсли;	
			
			НомерСмены = НомерСмены + 1;
		КонецЦикла;
	КонецЕсли;	
	
	Возврат СтруктураДанных;
КонецФункции

Функция ТаксировкиПоЭлектронномуПутевомуЛисту(ПутевойЛист) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТаксировкаПутевогоЛиста.Ссылка КАК ТаксировкаПутевогоЛиста
	               |ИЗ
	               |	Документ.ТаксировкаПутевогоЛиста КАК ТаксировкаПутевогоЛиста
	               |ГДЕ
	               |	ТаксировкаПутевогоЛиста.ПутевойЛист = &ПутевойЛист
	               |	И ТаксировкаПутевогоЛиста.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("ПутевойЛист", ПутевойЛист);
	Результат = Запрос.Выполнить().Выгрузить();

	Возврат Результат;
КонецФункции

Функция КоличествоТаксировокПоЭлектронномуПутевомуЛисту(ПутевойЛист) Экспорт
	Результат = 0;
	
	Данные = ТаксировкиПоЭлектронномуПутевомуЛисту(ПутевойЛист);
	
	Результат = Данные.Количество();
	
	Возврат Результат;
КонецФункции

Функция ДанныеРеквизитовЭПДЭлектронногоПутевогоЛиста(ДокументЭПЛ) Экспорт
	Возврат ОбменСГИСЭПДВызовСервера.ДанныеРеквизитовЭПД(ДокументЭПЛ);	
КонецФункции

Функция ЕстьТаксировкаЭПЛДляВодителя(ПутевойЛист, Таксировка, ВодительСотрудник)
	Результат = Ложь;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТаксировкаПутевогоЛиста.Ссылка КАК ТаксировкаПутевогоЛиста
	               |ИЗ
	               |	Документ.ТаксировкаПутевогоЛиста КАК ТаксировкаПутевогоЛиста
	               |ГДЕ
	               |	ТаксировкаПутевогоЛиста.ПутевойЛист = &ПутевойЛист
	               |	И ТаксировкаПутевогоЛиста.МОЛ = &Водитель";
	Запрос.УстановитьПараметр("ПутевойЛист", ПутевойЛист);
	Запрос.УстановитьПараметр("Ссылка", Таксировка);
	Запрос.УстановитьПараметр("Водитель", ВодительСотрудник);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Истина;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

Функция ВодительПоДаннымЭПЛ(Организация, ДанныеОВодителе, ДатаСведений) Экспорт
	Результат = Справочники.Сотрудники.ПустаяСсылка();	

	ИНН = ДанныеОВодителе.ИНН;
	НомерВУ = ДанныеОВодителе.НомерВУ;
	ФИО = СокрЛП(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = '%1 %2 %3'"), ДанныеОВодителе.Фамилия, ДанныеОВодителе.Имя, ДанныеОВодителе.Отчество));
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Сотрудники.Ссылка КАК Сотрудник,
	               |	ВЫРАЗИТЬ(Сотрудники.Контрагент КАК Справочник.Контрагенты).ИНН КАК ИНН
	               |ИЗ
	               |	Справочник.Сотрудники КАК Сотрудники
	               |ГДЕ
	               |	Сотрудники.Владелец = &Организация
	               |	И Сотрудники.Наименование = &Наименование";
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Наименование", ФИО);
	ТаблицаВыгрузкиРезультатов = Запрос.Выполнить().Выгрузить();
	
	Если ТаблицаВыгрузкиРезультатов.Количество() = 1 Тогда
		Результат = ТаблицаВыгрузкиРезультатов[0].Сотрудник;
	ИначеЕсли ТаблицаВыгрузкиРезультатов.Количество() > 1 Тогда
		Для Каждого ТекСтрока Из ТаблицаВыгрузкиРезультатов Цикл
			Если ЗначениеЗаполнено(ИНН) Тогда
				Если ИНН = ТекСтрока.ИНН Тогда
					Результат = ТекСтрока.Сотрудник;
					Прервать;
				КонецЕсли;
			ИначеЕсли ЗначениеЗаполнено(НомерВУ) Тогда
				ДанныеВодителя = ПолучитьДанныеВодителя(ТекСтрока.Сотрудник ,ДатаСведений);
				Если НомерВУ = ДанныеВодителя.НомерУдостоверения Тогда
					Результат = ТекСтрока.Сотрудник;
					Прервать;
				КонецЕсли;	
			КонецЕсли;	
		КонецЦикла;
		Если НЕ ЗначениеЗаполнено(Результат) Тогда
			Результат = ТаблицаВыгрузкиРезультатов[0].Сотрудник;
		КонецЕсли;	
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

Функция ТранспортноеСредствоПоРегистрационномуНомеру(Организация, РегистрационныйНомер, ДатаСведений) Экспорт
	Результат = Справочники.ОсновныеСредства.ПустаяСсылка();
	
	РегистрационныйНомерУсловие = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("%1%2", РегистрационныйНомер, "%");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ПаспортаТранспортныхСредствСрезПоследних.ОсновноеСредство КАК ОсновноеСредство
	               |ИЗ
	               |	РегистрСведений.ПаспортаТранспортныхСредств.СрезПоследних(
	               |			&ДатаСведений,
	               |			Организация = &Организация
	               |				И РегистрационныйЗнак ПОДОБНО &РегистрационныйНомерУсловие) КАК ПаспортаТранспортныхСредствСрезПоследних";

	Запрос.УстановитьПараметр("ДатаСведений", ДатаСведений);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("РегистрационныйНомерУсловие", РегистрационныйНомерУсловие);
    Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Результат = Выборка.ОсновноеСредство;	
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

Функция ПолучитьДанныеРабочегоЛистаАгрегата(ДокументСсылка) Экспорт
	СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Агрегат, МОЛ, Номер, Дата, МаркаДвигателяАгрегата, НомерДвигателяАгрегата");
	
	Возврат СтруктураДанных;
КонецФункции	

Функция ПолучитьДанныеУчетногоЛистаТракториста(ДокументСсылка) Экспорт
