КонецФункции
	
Функция ПолучитьПутевойЛистТаксировки(ДокументСсылка) Экспорт
	Результат = "";
	
	СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "СерияПутевогоЛиста, НомерПутевогоЛиста, ДатаПутевогоЛиста");
	
	Если СокрЛП(СтруктураДанных.СерияПутевогоЛиста) = "" Тогда
		Результат = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Путевой лист № %1 от %2 г'"), СтруктураДанных.НомерПутевогоЛиста, Формат(СтруктураДанных.ДатаПутевогоЛиста,"ДФ=dd.MM.yyyy"));
	Иначе
		Результат = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Путевой лист %1 № %2 от %3 г'"), СтруктураДанных.СерияПутевогоЛиста, СтруктураДанных.НомерПутевогоЛиста, Формат(СтруктураДанных.ДатаПутевогоЛиста,"ДФ=dd.MM.yyyy"));
	КонецЕсли;	
		
	Возврат Результат;
КонецФункции	

Функция ПолучитьРабочийЛистТаксировки(ДокументСсылка) Экспорт
	Результат = "";
	
	СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "НомерРабочегоЛистаАгрегата, ДатаРабочегоЛистаАгрегата");
	
	Если ДокументСсылка.ВидТаксировки = Перечисления.ВидыТаксировкиДокументовУчетаГСМ.РасчетРасходаГСМПоЛистуТракториста Тогда
		Результат = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Учетный лист тракториста-машиниста № %1 от %2 г'"),СтруктураДанных.НомерРабочегоЛистаАгрегата, Формат(СтруктураДанных.ДатаРабочегоЛистаАгрегата,"ДФ=dd.MM.yyyy"));
	Иначе	
		Результат = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Рабочий лист агрегата № %1 от %2 г'"),СтруктураДанных.НомерРабочегоЛистаАгрегата, Формат(СтруктураДанных.ДатаРабочегоЛистаАгрегата,"ДФ=dd.MM.yyyy"));
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

Функция ПолучитьДанныеТаксировкиПутевогоЛиста(ДокументСсылка) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("НаименованиеДокумента", "");
	Результат.Вставить("НомерКартинки", 0);
	
	Результат.НаименованиеДокумента = УчетГСМ.ПолучитьПутевойЛистТаксировки(ДокументСсылка);
	Результат.НомерКартинки = УчетГСМ.ПолучитьНомерКартинкиОперацииТаксировкиПутевогоЛиста(ДокументСсылка);
	
	Возврат Результат;
КонецФункции	

Функция ПолучитьДанныеТаксировкиУчетногоЛистаАгрегата(ДокументСсылка) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("НаименованиеДокумента", "");
	Результат.Вставить("НомерКартинки", 0);
	
	Результат.НаименованиеДокумента = ПолучитьРабочийЛистТаксировки(ДокументСсылка);
	Результат.НомерКартинки = УчетГСМ.ПолучитьНомерКартинкиОперацииТаксировкиУчетногоЛиста(ДокументСсылка);
	
	Возврат Результат;
КонецФункции	

Функция НаименованиеПервичногоДокументаДляТаксировки(ДокументСсылка) Экспорт
	Результат = "";
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ТаксировкаПутевогоЛиста") Тогда
		Результат = ПолучитьПутевойЛистТаксировки(ДокументСсылка);
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ТаксировкаРабочегоЛистаАгрегата") Тогда
		Результат = ПолучитьРабочийЛистТаксировки(ДокументСсылка);
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

Функция МОЛТаксировки(ДокументСсылка) Экспорт
	Результат = "";
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ТаксировкаПутевогоЛиста") 
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ТаксировкаРабочегоЛистаАгрегата") Тогда
		Результат = КорреспондентыКлиентСервер.ФИО(СокрЛП(ДокументСсылка.МОЛ));
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

Функция ОписаниеТаксировки(ДокументСсылка) Экспорт
	Результат = УчетГСМ.НаименованиеПервичногоДокументаДляТаксировки(ДокументСсылка) + ", " + УчетГСМ.ИдентификаторОСТаксировки(ДокументСсылка) +", " + УчетГСМ.МОЛТаксировки(ДокументСсылка);
	
	Возврат Результат;
КонецФункции	

Функция ИдентификаторОСТаксировки(ДокументСсылка) Экспорт
	Результат = "";
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ТаксировкаПутевогоЛиста") Тогда
		Результат = ПолучитьГосударственныйНомернойЗнакТС(ДокументСсылка.ТранспортноеСредство);
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ТаксировкаРабочегоЛистаАгрегата") Тогда
		Если ДокументСсылка.ВидТаксировки = Перечисления.ВидыТаксировкиДокументовУчетаГСМ.РасчетРасходаГСМПоЛистуТракториста Тогда
			Результат = ПолучитьГосударственныйНомернойЗнакТС(ДокументСсылка.Агрегат);
		Иначе	
			Результат = ПолучитьМаркуДвигателя(ДокументСсылка.Агрегат)+" "+ПолучитьНомерДвигателя(ДокументСсылка.Агрегат);
		КонецЕсли;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

Функция ПолучитьНомерКартинкиОперацииТаксировкиПутевогоЛиста(ДокументСсылка) Экспорт
	Результат = 0;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВЫБОР
	               |		КОГДА ОперацииДокументов.Операция ЕСТЬ NULL 
	               |				И ЖурналПроводокЕПСБУ.Регистратор ЕСТЬ NULL 
	               |			ТОГДА 0
	               |		КОГДА НЕ ОперацииДокументов.Операция ЕСТЬ NULL 
	               |				И ЖурналПроводокЕПСБУ.Регистратор ЕСТЬ NULL 
	               |			ТОГДА 1
	               |		ИНАЧЕ 2
	               |	КОНЕЦ КАК ЕстьОперация
	               |ИЗ
	               |	Документ.ТаксировкаПутевогоЛиста КАК ТаксировкаПутевогоЛиста
	               |		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
	               |		ПО ТаксировкаПутевогоЛиста.Ссылка = ОперацииДокументов.Документ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ЖурналПроводокЕПСБУ
	               |		ПО ТаксировкаПутевогоЛиста.Ссылка = ЖурналПроводокЕПСБУ.Регистратор
	               |			И (ЖурналПроводокЕПСБУ.НомерСтроки = 1)}
	               |ГДЕ
	               |	ТаксировкаПутевогоЛиста.Ссылка = &Ссылка";
				   
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);			   
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Результат = Выборка.ЕстьОперация;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции	

