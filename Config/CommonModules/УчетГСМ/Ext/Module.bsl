	ТаблицаДанныхОМаршрутах = РезультатыЗапроса[1].Выгрузить();  
	Если ДанныеТолькоОПоказанияхОдометра Тогда
		КоличествоСтрок = ТаблицаДанныхОМаршрутах.Количество();
		НомерСтроки = 0;
		ПоследниеПоказанияСпидометра = ПоказанияСпидометраПриВыезде;
		Для Каждого ТекСтрока Из ТаблицаДанныхОМаршрутах Цикл
			
			Если ПоследниеПоказанияСпидометра <> ТекСтрока.НачалоМаршрута Тогда
				НоваяСтрока = ТаблицаМаршруты.Добавить();
				НоваяСтрока.Пробег = ТекСтрока.НачалоМаршрута - ПоследниеПоказанияСпидометра;
			КонецЕсли;
			
			НоваяСтрока = ТаблицаМаршруты.Добавить();
			НоваяСтрока.Пробег = ТекСтрока.КонецМаршрута - ТекСтрока.НачалоМаршрута;
			
			Если НомерСтроки = (КоличествоСтрок -1) Тогда
				НоваяСтрока = ТаблицаМаршруты.Добавить();
				НоваяСтрока.Пробег = ПоказанияСпидометраПриВозвращении - ТекСтрока.КонецМаршрута;
			КонецЕсли;	
			
			ПоследниеПоказанияСпидометра = ТекСтрока.КонецМаршрута;
			НоваяСтрока.Простой = ТекСтрока.Простой;
			НомерСтроки = НомерСтроки + 1;
		КонецЦикла;	
	ИначеЕсли ДанныеОбОбратномПробеге Тогда
		Для Каждого ТекСтрока Из ТаблицаДанныхОМаршрутах Цикл
			НоваяСтрока = ТаблицаМаршруты.Добавить();
			НоваяСтрока.Пробег = ТекСтрока.Пробег;
			НоваяСтрока.Простой = ТекСтрока.Простой;
			
			НоваяСтрока = ТаблицаМаршруты.Добавить();
			НоваяСтрока.Пробег = ТекСтрока.ПробегОбратно;
			НоваяСтрока.Простой = ТекСтрока.ПростойНаОбратном;
		КонецЦикла;	
	Иначе
		ТаблицаМаршруты = ТаблицаДанныхОМаршрутах;
	КонецЕсли;	
	
	//контроль некорректных маршрутов
	Если ТаблицаМаршруты.Итог("Пробег") <> ОбщийПробег Тогда
		Результат.СообщениеПользователю = НСтр("ru='Общий пробег, рассчитанный по показаниям спидометра (одометра) при выезде и возвращении, не соответствует сумме пробегов для каждого маршрута из документа ""Путевой лист""! Следует вручную привести список маршрутов в соответствие с путевым листом. '");
	КонецЕсли;	
	
	ПереченьОтрицательныхПробегов = "";
	НомерСтроки = 0;
	ЕстьОтрицательныеПробеги = Ложь;
	Для Каждого ТекСтрока Из ТаблицаМаршруты Цикл
		Если ТекСтрока.Пробег < 0 Тогда
			
			ПереченьОтрицательныхПробегов = ПереченьОтрицательныхПробегов + ?(НомерСтроки = 0, "", ", ") + СокрЛП(НомерСтроки);
			ЕстьОтрицательныеПробеги = Истина;
		КонецЕсли;	
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	Если ЕстьОтрицательныеПробеги Тогда
		СообщениеПользователюПоМаршрутам = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Пробег части маршрутов (%1) из документа ""Путевой лист"" меньше нуля! Следует вручную привести список маршрутов в соответствие с путевым листом. '"), ПереченьОтрицательныхПробегов);
		Результат.СообщениеПользователюПоМаршрутам = СообщениеПользователюПоМаршрутам;
		Результат.ЕстьПредупреждения = Истина;
	КонецЕсли;	
	
	Результат.Маршруты = ТаблицаМаршруты;
	
	Возврат Результат;
КонецФункции

Функция НомерСменыДляПутевогоЛиста(ПутевойЛист, ОсновноеСредство, ДатаПутевогоЛиста) Экспорт
	Результат = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЖурналПутевыхЛистов.Ссылка
	               |ИЗ
	               |	ЖурналДокументов.ЖурналПутевыхЛистов КАК ЖурналПутевыхЛистов
	               |ГДЕ
	               |	ЖурналПутевыхЛистов.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	               |	И ЖурналПутевыхЛистов.ПометкаУдаления = ЛОЖЬ
	               |	И НЕ ЖурналПутевыхЛистов.Ссылка В (&ПутевойЛист)
	               |	И ЖурналПутевыхЛистов.ТранспортноеСредство = &ОсновноеСредство";
				   
	Запрос.УстановитьПараметр("ПутевойЛист", ПутевойЛист); 
	Запрос.УстановитьПараметр("ОсновноеСредство", ОсновноеСредство); 
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(ДатаПутевогоЛиста)); 			   
	Запрос.УстановитьПараметр("КонецПериода", ДатаПутевогоЛиста); 
	
	РезультатЗапроса = Запрос.Выполнить();
	ТаблицаЗначений = РезультатЗапроса.Выгрузить();
	
	Результат = ТаблицаЗначений.Количество();
	
	Возврат Результат;
КонецФункции

Функция ПоказанияСпидометраПоследнейСмены(НомерСмены, ОсновноеСредство, ДатаПутевогоЛиста) Экспорт
	Результат = 0;
		
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ТаксировкаПутевогоЛиста.Ссылка
	               |ИЗ
	               |	Документ.ТаксировкаПутевогоЛиста КАК ТаксировкаПутевогоЛиста
	               |ГДЕ
	               |	ТаксировкаПутевогоЛиста.ДатаПутевогоЛиста = &ДатаПутевогоЛиста
	               |	И ТаксировкаПутевогоЛиста.НомерСмены < &НомерСмены
	               |	И ТаксировкаПутевогоЛиста.ТранспортноеСредство = &ОсновноеСредство
	               |	И НЕ ТаксировкаПутевогоЛиста.ВидТаксировки В (&ВидСводнойТаксировки)
	               |	И ТаксировкаПутевогоЛиста.ПометкаУдаления = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ТаксировкаПутевогоЛиста.НомерСмены УБЫВ";
				   
	Запрос.УстановитьПараметр("НомерСмены", НомерСмены); 
	Запрос.УстановитьПараметр("ОсновноеСредство", ОсновноеСредство); 
	Запрос.УстановитьПараметр("ДатаПутевогоЛиста", ДатаПутевогоЛиста); 			   
	Запрос.УстановитьПараметр("ВидСводнойТаксировки", МассивВидовСводныхТаксировок());
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Таксировка = Выборка.Ссылка;
		Результат = Таксировка.ПоказанияСпидометраПриВыезде + Таксировка.ПробегОбщий;	
	КонецЦикла;	
	
	Возврат Результат;
КонецФункции

Функция ПолучитьДанныеМаршрутаДвижения(МаршрутДвижения) Экспорт
	СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(МаршрутДвижения, "Наименование, Протяженность, МестоОтправления, МестоНазначения, ОбратныйМаршрутДвижения");
	
	Возврат СтруктураДанных;
КонецФункции

Функция ДанныеКонтрагентаСотрудника(Контрагент, ДатаСведений) Экспорт
	Результат = Новый Структура("Период, СсылкаНаОбъект, Фамилия, Имя, Отчество, ФамилияИО, Должность");
	
	ФамилияИО = Справочники.Контрагенты.ФамилияИО(Контрагент, Истина, ДатаСведений);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	Сотрудники.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.Сотрудники КАК Сотрудники
	               |ГДЕ
	               |	Сотрудники.Контрагент = &Контрагент";
	
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Выборка = Запрос.Выполнить().Выбрать();	
	
	Если Выборка.Следующий() Тогда
		Сотрудник = Выборка.Ссылка;
		Результат.Вставить("СсылкаНаОбъект", Сотрудник);
		Результат.Вставить("Период", ДатаСведений);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(Результат, Истина);
		Результат.Вставить("ФамилияИО", ФамилияИО);
	Иначе
		Результат.Вставить("ФамилияИО", ФамилияИО);
		Результат.Вставить("Период", ДатаСведений);
		Результат.Вставить("СсылкаНаОбъект", Неопределено);
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	
	
Функция ЦенаДляВидаГСМПоДоговору(ВидГСМ, ПараметрыДоговора, РозничнаяЦена = 0) Экспорт
	Результат = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПараметрыДоговораПоставкиГСМЦены.Цена КАК Цена,
	               |	ПараметрыДоговораПоставкиГСМЦены.СкидкаОтРозничнойЦены КАК СкидкаОтРозничнойЦены,
	               |	ПараметрыДоговораПоставкиГСМЦены.Ссылка.КоличествоЗнаковДробнойЧастиДляСкидки КАК КоличествоЗнаковДробнойЧастиДляСкидки,
	               |	ПараметрыДоговораПоставкиГСМЦены.Ссылка.РежимОкругленияРезультатаДляСкидки КАК РежимОкругленияРезультатаДляСкидки,
	               |	ПараметрыДоговораПоставкиГСМЦены.Ссылка.СпособОпределенияЦен КАК СпособОпределенияЦен
	               |ИЗ
	               |	Справочник.ПараметрыДоговораПоставкиГСМ.Цены КАК ПараметрыДоговораПоставкиГСМЦены
	               |ГДЕ
	               |	ПараметрыДоговораПоставкиГСМЦены.Ссылка = &ПараметрыДоговораПоставки
	               |	И ПараметрыДоговораПоставкиГСМЦены.ВидГСМ = &ВидГСМ";
	
	Запрос.УстановитьПараметр("ПараметрыДоговораПоставки", ПараметрыДоговора);
	Запрос.УстановитьПараметр("ВидГСМ", ВидГСМ);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если Выборка.СкидкаОтРозничнойЦены > 0 И РозничнаяЦена > 0 Тогда
			Скидка = Окр(РозничнаяЦена * Выборка.СкидкаОтРозничнойЦены / 100, 
				Выборка.КоличествоЗнаковДробнойЧастиДляСкидки, 
				Выборка.РежимОкругленияРезультатаДляСкидки);
			Результат = РозничнаяЦена - Скидка;
		Иначе
			Результат = Выборка.Цена;
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

Функция ДанныеОПоступленияхГСМДляТаксировки(Таксировка) Экспорт
	Запрос = Новый Запрос;
