Функция ПолучитьОграниченияОсновногоПараметраРасчетаДляТС(ВидНормы) Экспорт
	
	СписокОсновныхПараметров = Новый СписокЗначений;
	
	Если ВидНормы = Перечисления.ВидыНормРасходаГСМ.БазоваяНормаРасхода ИЛИ ВидНормы = Перечисления.ВидыНормРасходаГСМ.ТранспортнаяНормаНаПробег Тогда
		//пустой параметр
	ИначеЕсли ВидНормы = Перечисления.ВидыНормРасходаГСМ.ТранспортнаяНормаНаПеревозкуГруза Тогда
		СписокОсновныхПараметров.Добавить(Перечисления.ВидыПараметровДляНормРасходаГСМ.ОбъемТранспортнойРаботы);
	ИначеЕсли ВидНормы = Перечисления.ВидыНормРасходаГСМ.НормаНаДополнительнуюМассуПрицепа Тогда
		СписокОсновныхПараметров.Добавить(Перечисления.ВидыПараметровДляНормРасходаГСМ.МассаСнаряженногоПрицепа);
	ИначеЕсли ВидНормы = Перечисления.ВидыНормРасходаГСМ.НормаДляОтопителя Тогда
		СписокОсновныхПараметров.Добавить(Перечисления.ВидыПараметровДляНормРасходаГСМ.ВремяРаботыОтопителя);
		СписокОсновныхПараметров.Добавить(Перечисления.ВидыПараметровДляНормРасходаГСМ.ВремяПрогрева);
		СписокОсновныхПараметров.Добавить(Перечисления.ВидыПараметровДляНормРасходаГСМ.ВремяПростоя);
	ИначеЕсли ВидНормы = Перечисления.ВидыНормРасходаГСМ.НормаРасходаНаРаботуСпецоборудования Тогда
		СписокОсновныхПараметров.Добавить(Перечисления.ВидыПараметровДляНормРасходаГСМ.ВремяРаботыСпецоборудования);
		СписокОсновныхПараметров.Добавить(Перечисления.ВидыПараметровДляНормРасходаГСМ.КоличествоОпераций);
	ИначеЕсли ВидНормы = Перечисления.ВидыНормРасходаГСМ.ТранспортнаяНормаСамосвалаНаЕздку Тогда
		СписокОсновныхПараметров.Добавить(Перечисления.ВидыПараметровДляНормРасходаГСМ.КоличествоЕздок);
	КонецЕсли;	
	
	Возврат СписокОсновныхПараметров;
КонецФункции	

Функция ОсновнойПараметрРасчетаРасходаГСМАгрегата(Организация, ОсновноеСредство) Экспорт
	Результат = Новый Структура;
	ОсновнойПараметрРасчета = Перечисления.ВидыПараметровДляНормРасходаГСМДляАгрегатов.ПустаяСсылка();
	ЕдиницаИзмеренияРаботы = Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	НастройкиДокументовУчетаГСМ.РЛАОсновнойПараметрРасчета,
	               |	НастройкиДокументовУчетаГСМ.ЕдиницаИзмеренияРаботы
	               |ИЗ
	               |	РегистрСведений.НастройкиДокументовУчетаГСМ КАК НастройкиДокументовУчетаГСМ
	               |ГДЕ
	               |	НастройкиДокументовУчетаГСМ.Организация = &Организация
	               |	И НастройкиДокументовУчетаГСМ.ОсновноеСредство = &ОсновноеСредство
	               |	И НастройкиДокументовУчетаГСМ.ВидОбъектаРасходаГСМ = &ВидОбъектаРасходаГСМ";
				   
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ОсновноеСредство", ОсновноеСредство);
	Запрос.УстановитьПараметр("ВидОбъектаРасходаГСМ", Перечисления.ВидыОбъектовРасходаГСМ.Агрегаты);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ОсновнойПараметрРасчета = Выборка.РЛАОсновнойПараметрРасчета;
		ЕдиницаИзмеренияРаботы = Выборка.ЕдиницаИзмеренияРаботы;
	КонецЦикла;
	
	Результат.Вставить("ОсновнойПараметрРасчета", ОсновнойПараметрРасчета);
	Результат.Вставить("ЕдиницаИзмеренияРаботы", ЕдиницаИзмеренияРаботы);
	
	Возврат Результат;
КонецФункции	

Функция СписокТранспортныхКартМОЛ(ЗаправилМОЛ) Экспорт
	Результат = Новый ТаблицаЗначений;
	
	Если Не ЗначениеЗаполнено(ЗаправилМОЛ) Тогда
		Возврат Результат;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПРЕДСТАВЛЕНИЕ(ТопливныеКартыВодителей.БСОТК) КАК НаименованиеТК,
	               |	ТопливныеКартыВодителей.БСОТК КАК БСОТК,
	               |	ТопливныеКартыВодителей.СерияТК КАК СерияТК,
	               |	ТопливныеКартыВодителей.НомерТК КАК НомерТК,
	               |	ТопливныеКартыВодителей.ПараметрыДоговораПоставкиГСМ КАК ПараметрыДоговораПоставкиГСМ,
	               |	ТопливныеКартыВодителей.Организация КАК Организация,
	               |	ВЫРАЗИТЬ(ТопливныеКартыВодителей.ПараметрыДоговораПоставкиГСМ КАК Справочник.ПараметрыДоговораПоставкиГСМ).Контрагент КАК Контрагент
	               |ИЗ
	               |	РегистрСведений.ТопливныеКартыВодителей КАК ТопливныеКартыВодителей
	               |ГДЕ
	               |	ТопливныеКартыВодителей.Водитель = &МОЛ
	               |	И ТопливныеКартыВодителей.Количество > 0";
				   
	Запрос.УстановитьПараметр("МОЛ", ЗаправилМОЛ);
	РезультатЗапроса = Запрос.Выполнить();
	Результат = РезультатЗапроса.Выгрузить();
	Для каждого ТекСтрока Из Результат Цикл
		ТекСтрока.НаименованиеТК = СокрЛП(ТекСтрока.БСОТК)+?(СокрЛП(ТекСтрока.СерияТК)="",""," "+СокрЛП(ТекСтрока.СерияТК))+" № "+СокрЛП(ТекСтрока.НомерТК);
	КонецЦикла;	
	
	Возврат Результат;
КонецФункции

Функция ТаксировкаПоследнегоПутевогоЛиста(ТекущийДокументТаксировки) Экспорт
