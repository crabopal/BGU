	Результат = СокрЛП(ПТС.Марка);
	
	Возврат ?(ЗначениеЗаполнено(Результат), Результат, "");
	
КонецФункции	

Функция ПолучитьМаркуИМодельТС(ТранспортноеСредство) Экспорт
	
