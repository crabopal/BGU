
#Область ПрограммныйИнтерфейс

// Заполнить файлы сотрудников в таблице.
// 
// Параметры:
//  Параметры - см. ОбщегоНазначенияБГУКлиентСервер.ПараметрыВыбораФайлаОсобогоМненияСотрудника
Процедура ЗаполнитьФайлыСотрудниковВТаблице(Параметры) Экспорт
	ФайлыСотрудников = РегистрыСведений.ФайлыСотрудниковКДокументам.ФайлыСотрудников(Параметры.Документ);
	Для Каждого Строка Из Параметры.Таблица Цикл
		Строка.ФайлОсобогоМнения = ФайлыСотрудников.Получить(Строка.Сотрудник);
	КонецЦикла;
КонецПроцедуры

Функция ПолучитьФайлСотрудника(Сотрудник, Форма = Неопределено, ОбъектСФайлами = Неопределено, 
	ПолеФайла = "ФайлСотрудника", ПолеНадписи = "НадписьФайлНеВыбран", ПолеУдалить = "НадписьУдалитьФайл") Экспорт
	
	Если Форма = Неопределено И ОбъектСФайлами = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;	
	
	ФайлСортудника = Неопределено;
	
	Документ = ?(Форма = Неопределено, ОбъектСФайлами, Форма.Объект.Ссылка);  
	
	Запрос = Новый Запрос( "
	|ВЫБРАТЬ
	|	ФайлыСотрудниковКДокументам.ФайлСотрудника КАК ФайлСотрудника
	|ИЗ
	|	РегистрСведений.ФайлыСотрудниковКДокументам КАК ФайлыСотрудниковКДокументам
	|ГДЕ
	|	ФайлыСотрудниковКДокументам.Документ = &Документ
	|	И ФайлыСотрудниковКДокументам.Сотрудник = &Сотрудник");
	
	Запрос.УстановитьПараметр("Документ", Документ);
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ФайлСортудника = Выборка.ФайлСотрудника;
	КонецЕсли;	
	
	Если Форма <> Неопределено Тогда
		ЕстьПравоИзменение = ПравоДоступа("Изменение", Метаданные.РегистрыСведений.РезультатыГолосованияКомиссий);
		Форма.Элементы[ПолеФайла].Видимость = ЗначениеЗаполнено(ФайлСортудника);
		Форма.Элементы[ПолеУдалить].Видимость = ЕстьПравоИзменение И ЗначениеЗаполнено(ФайлСортудника);
		Форма.Элементы[ПолеНадписи].Видимость = ЕстьПравоИзменение И НЕ ЗначениеЗаполнено(ФайлСортудника);
		Форма[ПолеФайла] = ФайлСортудника;
	КонецЕсли;
	
	Возврат ФайлСортудника;
	
КонецФункции

Процедура ОбработатьВыборФайлаСотрудника(ЗначениеВыбора, Сотрудник, Форма, 
	ПолеФайла = "ФайлСотрудника", ПолеНадписи = "НадписьФайлНеВыбран", ПолеУдалить = "НадписьУдалитьФайл") Экспорт
	
	РегистрыСведений.ФайлыСотрудниковКДокументам.ЗаписатьФайлСотрудника(Форма.Объект.Ссылка, Сотрудник, ЗначениеВыбора);
	
	Форма[ПолеФайла] = ЗначениеВыбора;
	Форма.Элементы[ПолеФайла].Видимость = ЗначениеЗаполнено(ЗначениеВыбора);
	Форма.Элементы[ПолеУдалить].Видимость = ЗначениеЗаполнено(ЗначениеВыбора);
	Форма.Элементы[ПолеНадписи].Видимость = НЕ ЗначениеЗаполнено(ЗначениеВыбора);
	
КонецПроцедуры	

Процедура ОткрепитьФайлСотрудника(ФайлСотрудника, Сотрудник, Форма,
	ПолеФайла = "ФайлСотрудника", ПолеНадписи = "НадписьФайлНеВыбран", ПолеУдалить = "НадписьУдалитьФайл") Экспорт
	
	РегистрыСведений.ФайлыСотрудниковКДокументам.УдалитьФайлСотрудника(Форма.Объект.Ссылка, Сотрудник);

	Форма[ПолеФайла] = ФайлСотрудника;
	Форма.Элементы[ПолеФайла].Видимость = ЗначениеЗаполнено(ФайлСотрудника);
	Форма.Элементы[ПолеУдалить].Видимость = ЗначениеЗаполнено(ФайлСотрудника);
	Форма.Элементы[ПолеНадписи].Видимость = НЕ ЗначениеЗаполнено(ФайлСотрудника);
			
КонецПроцедуры	

Процедура ПриСозданииНаСервере(ЭтотОбъект, ДобавляемыеЭлементы) Экспорт
	РаботаСФайлами.ПриСозданииНаСервере(ЭтотОбъект, ДобавляемыеЭлементы);
КонецПроцедуры	

#КонецОбласти