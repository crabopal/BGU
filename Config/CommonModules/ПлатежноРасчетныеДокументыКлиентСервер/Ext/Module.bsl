Функция ДопустимыеКодыСимволов() Экспорт
	
	// Допустимые символы ASCII  с 32 по 59, 61, с 63 по 126, 168 (Ё), 184 (ё), 185 (№) и с 192 по 255
	// Соответствие символов Unicode, по которым выполняется проверка в языке 1С:Предприятие:
	// 32 - 59, 61, 63 - 126, 1025(Ё), 1105(ё), 8470 (№), 1040-1103

	ДопустимыеСимволыКоды = Новый Соответствие;
	
	Для Сч = 32 По 59 Цикл
		ДопустимыеСимволыКоды.Вставить(Сч, Символ(Сч));
	КонецЦикла;
	ДопустимыеСимволыКоды.Вставить(61, Символ(61));
	Для Сч = 63 По 126 Цикл
		ДопустимыеСимволыКоды.Вставить(Сч, Символ(Сч));
	КонецЦикла;
	ДопустимыеСимволыКоды.Вставить(125, Символ(125));
	ДопустимыеСимволыКоды.Вставить(126, Символ(126));
	ДопустимыеСимволыКоды.Вставить(1025, Символ(1025));
	ДопустимыеСимволыКоды.Вставить(1105, Символ(1105));
	ДопустимыеСимволыКоды.Вставить(8470, Символ(8470));
	Для Сч = 1040 По 1103 Цикл
		ДопустимыеСимволыКоды.Вставить(Сч, Символ(Сч));
	КонецЦикла;   
	
	Возврат ДопустимыеСимволыКоды;
	
КонецФункции  

Функция ПроверитьДопустимыеСимволыВСтроке(СтрокаСимволов) Экспорт
	
	ДопустимыеСимволыКоды = ДопустимыеКодыСимволов();
	
	Ошибки = Новый Массив; 
	
	Для Инд = 1 По СтрДлина(СтрокаСимволов) Цикл
		ТекСимвол = Сред(СтрокаСимволов,Инд,1);
		ТекКод = КодСимвола(ТекСимвол);
		Если ДопустимыеСимволыКоды.Получить(ТекКод) = Неопределено Тогда 
			Ошибки.Добавить(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='%1 - й символ ""%2"" - ЗАПРЕЩЕН в обмене с ЕБП.'"), Инд, ТекСимвол));
		КонецЕсли 
	КонецЦикла;  
	
	Возврат Ошибки;
	
КонецФункции	

