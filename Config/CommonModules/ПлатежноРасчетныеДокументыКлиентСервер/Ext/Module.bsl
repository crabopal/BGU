Функция КФОПоКодуПоступленияЕБП(КодПоступления) Экспорт  
	
	СоотвествиеКодов = Новый Соответствие;  
	
	СоотвествиеКодов.Вставить(ПредопределенноеЗначение("Перечисление.КодыПоступленийЕБП.ГЗ"), ПредопределенноеЗначение("Перечисление.КВД.СубсидииНаГосзадание"));
	СоотвествиеКодов.Вставить(ПредопределенноеЗначение("Перечисление.КодыПоступленийЕБП.ЦС"), ПредопределенноеЗначение("Перечисление.КВД.СубсидииНаИныеЦели"));
	СоотвествиеКодов.Вставить(ПредопределенноеЗначение("Перечисление.КодыПоступленийЕБП.КВ"), ПредопределенноеЗначение("Перечисление.КВД.БюджетныеИнвестиции")); 
	СоотвествиеКодов.Вставить(ПредопределенноеЗначение("Перечисление.КодыПоступленийЕБП.ИЦ"), ПредопределенноеЗначение("Перечисление.КВД.СубсидииНаИныеЦели")); 
	СоотвествиеКодов.Вставить(ПредопределенноеЗначение("Перечисление.КодыПоступленийЕБП.ГР"), ПредопределенноеЗначение("Перечисление.КВД.СубсидииНаИныеЦели"));
    СоотвествиеКодов.Вставить(ПредопределенноеЗначение("Перечисление.КодыПоступленийЕБП.МС"), ПредопределенноеЗначение("Перечисление.КВД.СредстваОМС"));  
	СоотвествиеКодов.Вставить(ПредопределенноеЗначение("Перечисление.КодыПоступленийЕБП.ПД"), ПредопределенноеЗначение("Перечисление.КВД.Внебюджет"));
	СоотвествиеКодов.Вставить(ПредопределенноеЗначение("Перечисление.КодыПоступленийЕБП.ОБ"), ПредопределенноеЗначение("Перечисление.КВД.ВременноеРаспоряжение"));
	СоотвествиеКодов.Вставить(ПредопределенноеЗначение("Перечисление.КодыПоступленийЕБП.ВР"), ПредопределенноеЗначение("Перечисление.КВД.ВременноеРаспоряжение"));
	 
	Возврат СоотвествиеКодов.Получить(КодПоступления);  
	
КонецФункции  


