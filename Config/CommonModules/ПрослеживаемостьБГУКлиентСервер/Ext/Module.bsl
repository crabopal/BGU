#Область ПрограммныйИнтерфейс

// Возвращает признак применения Федерального Закона от 09.11.2020 № 371-ФЗ
// который вводит понятие прослеживаемости для определенных групп товаров
// Параметры
// Дата - тип дата, в данном параметре передается
//        дата на которую необходимо определить признак применения ФЗ
// Возвращаемое значение:
//  Булево - признак применения
//           Истина - ФЗ применяется
//           Ложь   - ФЗ не применяется
Функция ДатаНачалаУчетаПрослеживаемыхТоваров() Экспорт
	
	Возврат '20210701000000';
	
КонецФункции

Функция ВедетсяУчетПрослеживаемыхТоваров(Дата) Экспорт
	
	НачалоПримененияФЗ = ДатаНачалаУчетаПрослеживаемыхТоваров();
	
	Если Дата < НачалоПримененияФЗ Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

Функция КодыОперацийПрослеживаемостиПоступлениеОтПоставщика() Экспорт
	ВидыОпераций = ВидыОперацийПрослеживаемости();
	ВидыОпераций.ПоступлениеОтПоставщика = Истина;
	Возврат КодыОперацийПрослеживаемости(ВидыОпераций);
КонецФункции

Функция КодыОперацийПрослеживаемостиПрочееПоступление() Экспорт
	ВидыОпераций = ВидыОперацийПрослеживаемости();
	ВидыОпераций.ПрочееПоступление = Истина;
	Возврат КодыОперацийПрослеживаемости(ВидыОпераций);
КонецФункции

Функция КодыОперацийПрослеживаемостиВозвратОтПокупателя() Экспорт
	ВидыОпераций = ВидыОперацийПрослеживаемости();
	ВидыОпераций.ВозвратОтПокупателя = Истина;
	Возврат КодыОперацийПрослеживаемости(ВидыОпераций);
КонецФункции

Функция КодыОперацийПрослеживаемостиУтилизация() Экспорт
	ВидыОпераций = ВидыОперацийПрослеживаемости();
	ВидыОпераций.Утилизация = Истина;
	Возврат КодыОперацийПрослеживаемости(ВидыОпераций);
КонецФункции

Функция КодыОперацийПрослеживаемости(ВидыОпераций) Экспорт

	Результат = Новый Массив;
	УникальныеЗначения = Новый Соответствие;
	Если ВидыОпераций.ПоступлениеОтПоставщика Тогда
		ДобавитьУникальноеЗначение(Результат, ПредопределенноеЗначение("Справочник.КодыОперацийПрослеживаемости.ПриобретениеПлательщикомНДС"), УникальныеЗначения);
		ДобавитьУникальноеЗначение(Результат, ПредопределенноеЗначение("Справочник.КодыОперацийПрослеживаемости.ПриобретениеНеплательщикомНДС"), УникальныеЗначения);
	КонецЕсли;
	Если ВидыОпераций.ПрочееПоступление Тогда
		ДобавитьУникальноеЗначение(Результат, ПредопределенноеЗначение("Справочник.КодыОперацийПрослеживаемости.ВозвратРанееУтраченногоТовара"), УникальныеЗначения);
		ДобавитьУникальноеЗначение(Результат, ПредопределенноеЗначение("Справочник.КодыОперацийПрослеживаемости.ВозвратИзПроизводства"), УникальныеЗначения);
		ДобавитьУникальноеЗначение(Результат, ПредопределенноеЗначение("Справочник.КодыОперацийПрослеживаемости.ПолучениеНеСвязанноеСРеализацией"), УникальныеЗначения);
		ДобавитьУникальноеЗначение(Результат, ПредопределенноеЗначение("Справочник.КодыОперацийПрослеживаемости.БезвозмездноеПолучение"), УникальныеЗначения);
		ДобавитьУникальноеЗначение(Результат, ПредопределенноеЗначение("Справочник.КодыОперацийПрослеживаемости.ПриобретениеПлательщикомНДС"), УникальныеЗначения);
		ДобавитьУникальноеЗначение(Результат, ПредопределенноеЗначение("Справочник.КодыОперацийПрослеживаемости.ПриобретениеНеплательщикомНДС"), УникальныеЗначения);
	КонецЕсли;
	Если ВидыОпераций.ВозвратОтПокупателя Тогда
		ДобавитьУникальноеЗначение(Результат, ПредопределенноеЗначение("Справочник.КодыОперацийПрослеживаемости.ВозвратОтРозничногоПокупателя"), УникальныеЗначения);
		ДобавитьУникальноеЗначение(Результат, ПредопределенноеЗначение("Справочник.КодыОперацийПрослеживаемости.ПолучениеНеСвязанноеСРеализацией"), УникальныеЗначения);
	КонецЕсли;
	Если ВидыОпераций.Списание Тогда
		ДобавитьУникальноеЗначение(Результат, ПредопределенноеЗначение("Справочник.КодыОперацийПрослеживаемости.ПередачаНеСвязаннаяСРеализацией"), УникальныеЗначения);
		ДобавитьУникальноеЗначение(Результат, ПредопределенноеЗначение("Справочник.КодыОперацийПрослеживаемости.ПередачаВПроизводство"), УникальныеЗначения);
		ДобавитьУникальноеЗначение(Результат, ПредопределенноеЗначение("Справочник.КодыОперацийПрослеживаемости.УничтожениеУтратаВследствиеДействияНепреодолимойСилы"), УникальныеЗначения);
		ДобавитьУникальноеЗначение(Результат, ПредопределенноеЗначение("Справочник.КодыОперацийПрослеживаемости.НедостачаВыявленнаяВХодеИнвентаризации"), УникальныеЗначения);
	КонецЕсли;
	Если ВидыОпераций.Передача Тогда
		ДобавитьУникальноеЗначение(Результат, ПредопределенноеЗначение("Справочник.КодыОперацийПрослеживаемости.БезвозмезднаяПередача"), УникальныеЗначения);
		ДобавитьУникальноеЗначение(Результат, ПредопределенноеЗначение("Справочник.КодыОперацийПрослеживаемости.ПередачаНеСвязаннаяСРеализацией"), УникальныеЗначения);
		ДобавитьУникальноеЗначение(Результат, ПредопределенноеЗначение("Справочник.КодыОперацийПрослеживаемости.Реализация"), УникальныеЗначения);
	КонецЕсли;
	Если ВидыОпераций.Утилизация Тогда
		ДобавитьУникальноеЗначение(Результат, ПредопределенноеЗначение("Справочник.КодыОперацийПрослеживаемости.ЗахоронениеОбезвреживаниеУтилизацияТовара"), УникальныеЗначения);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ВидыОперацийПрослеживаемости() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("ПоступлениеОтПоставщика", Ложь);
	Результат.Вставить("ПрочееПоступление", Ложь);
	Результат.Вставить("ВозвратОтПокупателя", Ложь);
	Результат.Вставить("Списание", Ложь);
	Результат.Вставить("Передача", Ложь);
	Результат.Вставить("Утилизация", Ложь);
	Возврат Результат;
КонецФункции

// Код операции прослеживаемости.
// 
// Возвращаемое значение:
//  Структура - Код операции прослеживаемости:
// * Код - Строка -
// * Наименование - Строка -
// * ПометкаУдаления - Булево -
Функция КодОперацииПрослеживаемости() Экспорт
	СтрокаРезультат = Новый Структура;
	СтрокаРезультат.Вставить("Код", "");
	СтрокаРезультат.Вставить("Наименование", "");
	СтрокаРезультат.Вставить("ПометкаУдаления", Ложь);
	Возврат СтрокаРезультат;	
КонецФункции
	
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьУникальноеЗначение(Массив, Значение, УникальныеЗначения)

	Если УникальныеЗначения.Получить(Значение) = Неопределено Тогда
		Массив.Добавить(Значение);
		УникальныеЗначения.Вставить(Значение, Истина);
	КонецЕсли;

КонецПроцедуры
 

#КонецОбласти 