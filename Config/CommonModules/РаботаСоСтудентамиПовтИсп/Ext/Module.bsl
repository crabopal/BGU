// Возвращает структуру данных, необходимых для расчета оплаты в указанный период (период при фиксированной ставки на весь срок)
// В целях оптимизации работы рекомендуется в параметр Период всегда передавать первое число нужного месяца,
// если Параметр период не передан - возвращаются значения без указания суммы начисления за период при использовании фиксированной ставки за период
//
// Параметры
//  Ставка  - СправочникСсылка.СтавкиОплатыОбразование - ссылка на элемент, по которому необходимо получить данные
//  Период  - Дата - Дата в периоде, за который необходимо получить данные
//
// Возвращаемое значение:
//   Структура - поля структуры:
//					  Валюта
//					  ЭтоФиксированнаяСтавкаЗаПериод
//               СуммаФиксированнаяСтавкаЗаПериод
//               СуммаФиксированнаяСтавкаЗаМесяц
//               СуммаПеременнаяСтавкаЗаМесяц
//               СуммаСтавкаЗаДень
//               СуммаНачисления - если не фиксированная ставка, то 0
//
Функция ПолучитьДанныеСтавки(Ставка, Период = Неопределено) Экспорт 

	СтруктураРеквизитов = Новый Структура("Валюта,
								  					 |ЭтоФиксированнаяСтавкаЗаПериод,
			               					 |СуммаФиксированнаяСтавкаЗаПериод,
			               					 |СуммаФиксированнаяСтавкаЗаМесяц,
			               					 |СуммаПеременнаяСтавкаЗаМесяц,
			               					 |СуммаСтавкаЗаДень");
								 
	СтруктураДанных = РаботаСоСтудентамиВызовСервера.ЗначенияРеквизитовОбъекта(Ставка, СтруктураРеквизитов);
	СтруктураДанных.Вставить("СуммаНачисления", 0);

	Если СтруктураДанных.ЭтоФиксированнаяСтавкаЗаПериод = Истина Тогда
		
		Если Период <> Неопределено Тогда
			СтруктураДанных.СуммаНачисления = РаботаСоСтудентамиВызовСервера.СуммаНачисленияСтавкиВПериод(Ставка, Период);
		КонецЕсли; 
		
	ИначеЕсли СтруктураДанных.ЭтоФиксированнаяСтавкаЗаПериод = Ложь Тогда
		
	Иначе
		
		// Защита от пустой ссылки
		СтруктураДанных.Валюта = ПредопределенноеЗначение("Справочник.Валюты.ПустаяСсылка");
		СтруктураДанных.ЭтоФиксированнаяСтавкаЗаПериод = Ложь;
		СтруктураДанных.СуммаФиксированнаяСтавкаЗаПериод = 0;
		СтруктураДанных.СуммаФиксированнаяСтавкаЗаМесяц = 0;
		СтруктураДанных.СуммаПеременнаяСтавкаЗаМесяц = 0;
		СтруктураДанных.СуммаСтавкаЗаДень = 0;
		
	КонецЕсли; 
	
	СтруктураДанных.Вставить("РасчетБезДнейПосещения", (СтруктураДанных.СуммаПеременнаяСтавкаЗаМесяц = 0 И СтруктураДанных.СуммаСтавкаЗаДень = 0));
	
	Возврат СтруктураДанных;

КонецФункции 

Функция ПолучитьДанныеСостояния(Состояние) Экспорт 

	Возврат РаботаСоСтудентамиВызовСервера.ЗначенияРеквизитовОбъекта(Состояние, "ДействуетНачисление, НачислятьВДеньПриказа");

