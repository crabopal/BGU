// ПРОГРАММНЫЙ ИНТЕРФЕЙС

Процедура ВвестиПараметры(ПараметрКоманды, ПараметрыВыполненияКоманды, ОбработкаЗавершения) Экспорт 
	
	РеквизитыДокумента = Новый Структура;
	РеквизитыДокумента.Вставить("ПараметрКоманды", ПараметрКоманды);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Событие","Проверка");
	ПараметрыФормы.Вставить("ИмяМетода","НастройкаЗаполнения");
	ПараметрыФормы.Вставить("ИндексМетода",Неопределено);
	ПараметрыФормы.Вставить("РеквизитыДокумента", РеквизитыДокумента);
	ПараметрыФормы.Вставить("ДополнительныеРеквизиты", Неопределено);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ОбработкаЗавершения",ОбработкаЗавершения);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаВводаПараметров",ЗаполнениеОтчетностиКлиент,ДополнительныеПараметры);
	
	ОткрытьФорму("Обработка.ОбработкаДанныхОтчетности.Форма.НастройкаЗаполнения", ПараметрыФормы, 
	ПараметрыВыполненияКоманды.Источник, ПараметрыВыполненияКоманды.Уникальность, ПараметрыВыполненияКоманды.Окно, ПараметрыВыполненияКоманды.НавигационнаяСсылка,
	ОписаниеОповещения);
	
КонецПроцедуры

Процедура СохранениеПередЗакрытием(Форма, Событие = "", Источник = "") Экспорт 
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("форма",форма);
	ДополнительныеПараметры.Вставить("Событие",Событие);
	ДополнительныеПараметры.Вставить("Источник",Источник);

	ОписаниеОповещения = Новый ОписаниеОповещения("ЗакончитьЗакрытие",ЗаполнениеОтчетностиКлиент,ДополнительныеПараметры);
	
	
	ТекстВопроса = НСтр("ru = 'Данные изменены. Сохранить изменения?'");
	ЗаголовокВопроса = НСтр("ru = 'Выберите действие...'");
	
	ПоказатьВопрос(ОписаниеОповещения ,ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена,,,ЗаголовокВопроса);
	
КонецПроцедуры	


Процедура ПроверитьНаименование(Результат , ДополнительныеПараметры) Экспорт 
	
	Колекция = ДополнительныеПараметры.Колекция;
	ИмяКолонки = ДополнительныеПараметры.ИмяКолонки;
	ИмяКоллекции = ДополнительныеПараметры.ИмяКоллекции;
	ПроверяемаяСтрока = ДополнительныеПараметры.ПроверяемаяСтрока;
	
	Если Не ДополнительныеПараметры.Свойство("РедактируемоеЗначение") Тогда 
		ДополнительныеПараметры.Вставить("РедактируемоеЗначение",ПроверяемаяСтрока[ИмяКолонки]);
	КонецЕсли;

	ТекущаяСтрокаИндекс = Колекция.Индекс(ДополнительныеПараметры.ПроверяемаяСтрока);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПроверитьНаименование",ЗаполнениеОтчетностиКлиент,ДополнительныеПараметры);
	
	/////////////////////////////////////////////////////////////////////////////
	Если ДополнительныеПараметры.Этап = "Начало" Тогда
		
		Если ПустаяСтрока(ДополнительныеПараметры.РедактируемоеЗначение) Тогда
			ДополнительныеПараметры.РедактируемоеЗначение = ЗаполнениеОтчетностиКлиентСервер.ПолучитьУникальноеЗначениеСтроковогоПоляКоллекции(
			ИмяКолонки, Колекция, ТекущаяСтрокаИндекс, ДополнительныеПараметры.ЗначениеПоУмолчанию, "_", 25);
			
			ДополнительныеПараметры.Этап = "ВозвратРезультата";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
			Возврат;
		КонецЕсли;
		
		ДопустимоеИмя = БюджетнаяОтчетностьКлиентСервер.ВернутьАлфавитноЦифровоеПредставление(ДополнительныеПараметры.РедактируемоеЗначение);
		Если ПустаяСтрока(ДопустимоеИмя) Тогда
			ДопустимоеИмя = ДополнительныеПараметры.ЗначениеПоУмолчанию;
		КонецЕсли;
		
		
		
		Если ДопустимоеИмя <> ДополнительныеПараметры.РедактируемоеЗначение Тогда
			
			ДополнительныеПараметры.Вставить("ДопустимоеИмя",ДопустимоеИмя);
			
			ТекстВопроса = НСтр("ru = 'Имя содержит недопустимые символы. Исправить автоматически значение имени?'");
			ДополнительныеПараметры.Этап = "РезультатВопроса";
			ПоказатьВопрос(ОписаниеОповещения,ТекстВопроса,РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да, НСтр("ru = 'Выберите действие...'"));
			
		Иначе 
			ДополнительныеПараметры.Этап = "Окончание";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
			
		КонецЕсли;
		

	/////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "РезультатВопроса" Тогда 
		Если Результат <> КодВозвратаДиалога.Да Тогда 
			
			ДополнительныеПараметры.Этап = "ВозвратРезультата";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
			Возврат;

		КонецЕсли;	
		
		ДополнительныеПараметры.РедактируемоеЗначение = ДополнительныеПараметры.ДопустимоеИмя;
		
		ДополнительныеПараметры.Этап = "Окончание";
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
		
		
	/////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "Окончание" Тогда 
		
		ИмяПараметра = ЗаполнениеОтчетностиКлиентСервер.ПолучитьУникальноеЗначениеСтроковогоПоляКоллекции(
		ИмяКолонки, Колекция, ТекущаяСтрокаИндекс, ДополнительныеПараметры.РедактируемоеЗначение, "_", 25);
		
		Если ПустаяСтрока(ИмяПараметра) Тогда
			
			ТекстСообщения = НСтр("ru = 'Имя уже используется! Задайте другое значение имени.'");
			
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,
			ДополнительныеПараметры.Ссылка, ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяКоллекции,ТекущаяСтрокаИндекс,ИмяКолонки));
			
			ДополнительныеПараметры.Этап = "ВозвратРезультата";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
			Возврат;
			
		Иначе
			
			ДополнительныеПараметры.РедактируемоеЗначение = ИмяПараметра;
			
			ДополнительныеПараметры.Этап = "ВозвратРезультата";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
			Возврат;
			
		КонецЕсли;
		
		/////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "ВозвратРезультата" Тогда 
		
		ПроверяемаяСтрока[ИмяКолонки] = ДополнительныеПараметры.РедактируемоеЗначение;
		
		
		Если ДополнительныеПараметры.ОбработкаЗавершения = Неопределено Тогда 
			Возврат;
		КонецЕсли;
		
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОбработкаЗавершения);
		
		
	КонецЕсли;	
	
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

Процедура ЗакончитьЗакрытие(Результат, ДополнительныеПараметры) Экспорт 
	
	Если Результат = КодВозвратаДиалога.Нет Тогда 
		ДополнительныеПараметры.форма.Модифицированность = Ложь;
		ДополнительныеПараметры.форма.Закрыть();
		
	ИначеЕсли Результат = КодВозвратаДиалога.Да Тогда 
		
		Если не ДополнительныеПараметры.форма.ПроверитьЗаполнение() Тогда 
			Возврат;
		КонецЕсли;	
		
		ВозвращаемыеДанные = ДополнительныеПараметры.форма.ПодготовитьСтруктуруВозврата();
		Если ВозвращаемыеДанные = Неопределено Тогда 
			Возврат;
		КонецЕсли;	
		ДополнительныеПараметры.форма.Модифицированность = Ложь;
		
		Если ДополнительныеПараметры.форма.МодальныйРежим Тогда
			ДополнительныеПараметры.форма.Закрыть(ВозвращаемыеДанные);
			
		Иначе
			Оповестить(ДополнительныеПараметры.Событие, ВозвращаемыеДанные, ДополнительныеПараметры.Источник);
			ДополнительныеПараметры.форма.Закрыть();
			
		КонецЕсли;
		
	Иначе //отмена
		
		Возврат;
		
	КонецЕсли;	
	
КонецПроцедуры	

Процедура ОбработкаВводаПараметров(Результат, ДополнительныеПараметры) Экспорт
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("Отказ", Ложь);
	ВозвращаемоеЗначение.Вставить("АдресПараметров", Неопределено);
	
	Если Результат = Неопределено Тогда 
		ВозвращаемоеЗначение.Отказ = Истина;
		
	ИначеЕсли Не ЭтоАдресВременногоХранилища(Результат.АдресПараметров) Тогда 
		ВозвращаемоеЗначение.Отказ = Истина;
		
	Иначе 
		ВозвращаемоеЗначение.АдресПараметров = Результат.АдресПараметров;
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОбработкаЗавершения, ВозвращаемоеЗначение);	
	
КонецПроцедуры	