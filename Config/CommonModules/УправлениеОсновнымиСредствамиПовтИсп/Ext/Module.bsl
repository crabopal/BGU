
#Область ПрограммныйИнтерфейс

Функция СчетАмортизацииОС(СчетУчетаОС) Экспорт
	
	Возврат УправлениеОсновнымиСредствами.ВсеСчетаУчетаОС(СчетУчетаОС).СчетАмортизации;
	
КонецФункции

Функция СчетОбесцененияОС(СчетУчетаОС) Экспорт
	
	Возврат УправлениеОсновнымиСредствами.ВсеСчетаУчетаОС(СчетУчетаОС).СчетОбесценения;
	
КонецФункции

Функция ЗабалансовыйСчетОС(СчетУчетаОС) Экспорт
	
	Возврат УправлениеОсновнымиСредствами.ВсеСчетаУчетаОС(СчетУчетаОС).ЗабалансовыйСчет;
	
КонецФункции

Функция СчетПередачиОСвУправление(СчетУчетаОС) Экспорт
	
	Возврат УправлениеОсновнымиСредствами.ВсеСчетаУчетаОС(СчетУчетаОС).СчетПередачиВУправление;
	
КонецФункции

Функция СчетПередачиОСВАренду(СчетУчетаОС) Экспорт
	
	Возврат УправлениеОсновнымиСредствами.ВсеСчетаУчетаОС(СчетУчетаОС).СчетПередачиВАренду;
	
КонецФункции

Функция СчетПередачиОСВПользование(СчетУчетаОС) Экспорт
	
	Возврат УправлениеОсновнымиСредствами.ВсеСчетаУчетаОС(СчетУчетаОС).СчетПередачиВПользование;
	
КонецФункции

Функция СчетУчетаПоЗабалансовомуСчетуОС(ЗабалансовыйСчетОС) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ЗабалансовыйСчетОС) Тогда
		Возврат ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СоответствиеСчетовОС.СчетОС КАК СчетУчета,
	|	СоответствиеСчетовОС.ЗабалансовыйСчет КАК ЗабалансовыйСчет
	|ИЗ
	|	РегистрСведений.СоответствиеСчетовОС КАК СоответствиеСчетовОС
	|ГДЕ
	|	СоответствиеСчетовОС.ЗабалансовыйСчет = &ЗабалансовыйСчетОС";
	Запрос.УстановитьПараметр("ЗабалансовыйСчетОС", ЗабалансовыйСчетОС);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.СчетУчета;
	Иначе
		Возврат ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

Функция СчетаУчетаОСПоВидам() Экспорт
	
	Запрос = Новый Запрос;
	//101.00
	СчетаПоВидамИмущества = Новый Соответствие;
	СчетаПоВидамИмущества.Вставить("101.10", Перечисления.ВидыИмущества.НедвижимоеИмущество);
	СчетаПоВидамИмущества.Вставить("101.20", Перечисления.ВидыИмущества.ДвижимоеОсобоЦенное);
	СчетаПоВидамИмущества.Вставить("101.30", Перечисления.ВидыИмущества.ИноеДвижимое);
	СчетаПоВидамИмущества.Вставить("101.40", Перечисления.ВидыИмущества.Лизинг);
	СчетаПоВидамИмущества.Вставить("101.90", Перечисления.ВидыИмущества.ВКонцессии);
	
	ШаблонЗапросаОС =
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка,
	|	ЕПСБУ.ЭлементГруппа КАК ЭлементГруппа,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыНФА.ОС) КАК ВидНФА,
	|	&ВидИмущества КАК ВидИмущества,
	|	ВЫБОР
	|		КОГДА ПОДСТРОКА(ЕПСБУ.Код, 6, 1) = ""1""
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЖилыеПомещения,
	|	ВЫБОР
	|		КОГДА ПОДСТРОКА(ЕПСБУ.Код, 6, 1) = ""2""
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК НежилыеПомещения,
	|	ВЫБОР
	|		КОГДА ПОДСТРОКА(ЕПСБУ.Код, 6, 1) = ""3""
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Сооружения,
	|	ВЫБОР
	|		КОГДА ПОДСТРОКА(ЕПСБУ.Код, 6, 1) = ""4""
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Машины,
	|	ВЫБОР
	|		КОГДА ПОДСТРОКА(ЕПСБУ.Код, 6, 1) = ""5""
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Транспорт,
	|	ВЫБОР
	|		КОГДА ПОДСТРОКА(ЕПСБУ.Код, 6, 1) = ""6""
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ХозИнвентарь,
	|	ВЫБОР
	|		КОГДА ПОДСТРОКА(ЕПСБУ.Код, 6, 1) = ""7""
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Библиотека,
	|	ВЫБОР
	|		КОГДА ПОДСТРОКА(ЕПСБУ.Код, 6, 1) = ""8""
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Прочие,
	|	Ложь КАК Аренда,
	|	Ложь КАК Хранение,
	|	NULL КАК БудущийВидНФА,
	|	Ложь КАК ПолученныеПоЦС,
	|	ЕПСБУ.Порядок
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Ссылка В (&Родитель)";
	
	ИндексЗапросов = 0;
	ПервыйЗапрос = Истина;
	Для каждого СчетВидИмущества Из СчетаПоВидамИмущества Цикл
	
		Если НЕ ПервыйЗапрос Тогда
			Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяОбъединенияЗапросов("Все");
		КонецЕсли;
		ПервыйЗапрос = Ложь;
		Запрос.Текст = Запрос.Текст
		+ СтрЗаменить(СтрЗаменить(ШаблонЗапросаОС, "&ВидИмущества", "&ВидИмущества" + ИндексЗапросов),
			"&Родитель", "&Родитель" + ИндексЗапросов);
		Запрос.УстановитьПараметр("ВидИмущества" + ИндексЗапросов, СчетВидИмущества.Значение);
		Запрос.УстановитьПараметр("Родитель" + ИндексЗапросов, БухгалтерскийУчет.СписокСчетов(СчетВидИмущества.Ключ));
		ИндексЗапросов = ИндексЗапросов + 1;
	
	КонецЦикла;
	
	// 102.00, 103.00
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяОбъединенияЗапросов("Все") +
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка,
	|	ЕПСБУ.ЭлементГруппа КАК ЭлементГруппа,
	|	ВЫБОР
	|		КОГДА ЕПСБУ.Ссылка В (&Счет103)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыНФА.НПА)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыНФА.НМА)
	|	КОНЕЦ КАК ВидНФА,
	|	ВЫБОР
	|		КОГДА ПОДСТРОКА(ЕПСБУ.Код, 5, 1) = ""1""
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыИмущества.НедвижимоеИмущество)
	|		КОГДА ПОДСТРОКА(ЕПСБУ.Код, 5, 1) = ""2""
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыИмущества.ДвижимоеОсобоЦенное)
	|		КОГДА ПОДСТРОКА(ЕПСБУ.Код, 5, 1) = ""3""
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыИмущества.ИноеДвижимое)
	|		КОГДА ПОДСТРОКА(ЕПСБУ.Код, 5, 1) = ""4""
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыИмущества.Лизинг)
	|		КОГДА ПОДСТРОКА(ЕПСБУ.Код, 5, 1) = ""9""
	|			ТОГДА ВЫБОР
	|					КОГДА ПОДСТРОКА(ЕПСБУ.Код, 6, 1) = ""1""
	|						ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыИмущества.НедвижимоеИмущество)
	|					ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыИмущества.ВКонцессии)
	|				КОНЕЦ
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыИмущества.ПустаяСсылка)
	|	КОНЕЦ КАК ВидИмущества,
	|	NULL КАК ЖилыеПомещения,
	|	NULL КАК НежилыеПомещения,
	|	NULL КАК Сооружения,
	|	NULL КАК Машины,
	|	NULL КАК Транспорт,
	|	NULL КАК ХозИнвентарь,
	|	NULL КАК Библиотека,
	|	NULL КАК Прочие,
	|	ЛОЖЬ КАК Аренда,
	|	ЛОЖЬ КАК Хранение,
	|	NULL КАК БудущийВидНФА,
	|	NULL КАК ПолученныеПоЦС,
	|	ЕПСБУ.Порядок КАК Порядок
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Ссылка В (&Счет102, &Счет103)";
	
	Запрос.УстановитьПараметр("Счет102", БухгалтерскийУчет.СписокСчетов("102.00"));
	Запрос.УстановитьПараметр("Счет103", БухгалтерскийУчет.СписокСчетов("103.00"));
	
	// 106.00, 107.00
	СчетаПоВидамИмущества = Новый Соответствие;
	СчетаПоВидамИмущества.Вставить("106.10", Перечисления.ВидыИмущества.НедвижимоеИмущество);
	СчетаПоВидамИмущества.Вставить("106.20", Перечисления.ВидыИмущества.ДвижимоеОсобоЦенное);
	СчетаПоВидамИмущества.Вставить("106.30", Перечисления.ВидыИмущества.ИноеДвижимое);
	СчетаПоВидамИмущества.Вставить("106.40", Перечисления.ВидыИмущества.Лизинг);
	СчетаПоВидамИмущества.Вставить("106.90", Перечисления.ВидыИмущества.ВКонцессии);
	
	СчетаПоВидамИмущества.Вставить("107.10", Перечисления.ВидыИмущества.НедвижимоеИмущество);
	СчетаПоВидамИмущества.Вставить("107.20", Перечисления.ВидыИмущества.ДвижимоеОсобоЦенное);
	СчетаПоВидамИмущества.Вставить("107.30", Перечисления.ВидыИмущества.ИноеДвижимое);
	СчетаПоВидамИмущества.Вставить("107.40", Перечисления.ВидыИмущества.Лизинг);
	ШаблонЗапросаВложений =
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка,
	|	ЕПСБУ.ЭлементГруппа КАК ЭлементГруппа,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыНФА.КапВложения) КАК ВидНФА,
	|	&ВидИмущества КАК ВидИмущества,
	|	NULL КАК ЖилыеПомещения,
	|	NULL КАК НежилыеПомещения,
	|	NULL КАК Сооружения,
	|	NULL КАК Машины,
	|	NULL КАК Транспорт,
	|	NULL КАК ХозИнвентарь,
	|	NULL КАК Библиотека,
	|	NULL КАК Прочие,
	|	ЛОЖЬ КАК Аренда,
	|	ЛОЖЬ КАК Хранение,
	|	ВЫБОР
	|		КОГДА ПОДСТРОКА(ЕПСБУ.Код, 6, 1) В (""1"", ""С"")
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыНФА.ОС)
	|		КОГДА ПОДСТРОКА(ЕПСБУ.Код, 6, 1) = ""2""
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыНФА.НМА)
	|		КОГДА ПОДСТРОКА(ЕПСБУ.Код, 6, 1) = ""3""
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыНФА.НПА)
	|	КОНЕЦ КАК БудущийВидНФА,
	|	NULL КАК ПолученныеПоЦС,
	|	ЕПСБУ.Порядок КАК Порядок
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|		ПО ЕПСБУ.Ссылка = ЕПСБУВидыСубконто.Ссылка
	|ГДЕ
	|	ЕПСБУ.Ссылка В(&Родитель)
	|	И ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства)";
	Для каждого СчетВидИмущества Из СчетаПоВидамИмущества Цикл
	
		Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяОбъединенияЗапросов("Все")
		+ СтрЗаменить(СтрЗаменить(ШаблонЗапросаВложений, "&ВидИмущества", "&ВидИмущества" + ИндексЗапросов),
			"&Родитель", "&Родитель" + ИндексЗапросов);
		Запрос.УстановитьПараметр("ВидИмущества" + ИндексЗапросов, СчетВидИмущества.Значение);
		Запрос.УстановитьПараметр("Родитель" + ИндексЗапросов, БухгалтерскийУчет.СписокСчетов(СчетВидИмущества.Ключ));
		ИндексЗапросов = ИндексЗапросов + 1;
	
	КонецЦикла;
	
	//108
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяОбъединенияЗапросов("Все") +
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка,
	|	ЕПСБУ.ЭлементГруппа КАК ЭлементГруппа,
