	Запрос.УстановитьПараметр("Счет108", БухгалтерскийУчет.СписокСчетов("108.00"));
	
	//111.60
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяОбъединенияЗапросов("Все") +
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка,
	|	ЕПСБУ.ЭлементГруппа КАК ЭлементГруппа,
