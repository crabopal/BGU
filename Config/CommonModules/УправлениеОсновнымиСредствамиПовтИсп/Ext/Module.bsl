	|						ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыИмущества.ИноеДвижимое)
	|					ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыИмущества.ВКонцессии)
	|				КОНЕЦ
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыИмущества.ПустаяСсылка)
	|	КОНЕЦ КАК ВидИмущества,
	|	NULL КАК ЖилыеПомещения,
	|	NULL КАК НежилыеПомещения,
	|	NULL КАК Сооружения,
	|	NULL КАК Машины,
	|	NULL КАК Транспорт,
	|	NULL КАК ХозИнвентарь,
	|	NULL КАК Библиотека,
	|	NULL КАК Прочие,
	|	ЛОЖЬ КАК Аренда,
	|	ЛОЖЬ КАК Хранение,
	|	NULL КАК БудущийВидНФА,
	|	NULL КАК ПолученныеПоЦС,
	|	ЕПСБУ.Порядок КАК Порядок
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|		ПО ЕПСБУ.Ссылка = ЕПСБУВидыСубконто.Ссылка
	|ГДЕ
