				СписокСчетов.Добавить("01.12");
			ИначеЕсли ВидИмущества = Перечисления.ВидыИмущества.ДвижимоеОсобоЦенное Тогда
				СписокСчетов.Добавить("01.21");
				СписокСчетов.Добавить("01.22");
			ИначеЕсли ВидИмущества = Перечисления.ВидыИмущества.ИноеДвижимое Тогда
				СписокСчетов.Добавить("01.31");
				СписокСчетов.Добавить("01.32");
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ВидНФА = Перечисления.ВидыНФА.КапВложения Тогда
		Если Не ЗначениеЗаполнено(ВидИмущества) Тогда
			СписокСчетов.Добавить("106.00");		
		ИначеЕсли ВидИмущества = Перечисления.ВидыИмущества.НедвижимоеИмущество Тогда
			СписокСчетов.Добавить("106.10");
		ИначеЕсли ВидИмущества = Перечисления.ВидыИмущества.ДвижимоеОсобоЦенное Тогда
			СписокСчетов.Добавить("106.20");
		ИначеЕсли ВидИмущества = Перечисления.ВидыИмущества.ИноеДвижимое Тогда
			СписокСчетов.Добавить("106.30");
		ИначеЕсли ВидИмущества = Перечисления.ВидыИмущества.Лизинг Тогда
			СписокСчетов.Добавить("106.40");
		КонецЕсли;
	КонецЕсли;
	
	Если СписокСчетов.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Счет
	|ПОМЕСТИТЬ СчетаЕПСБУ
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Код В(&МассивКодов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Результат
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|		ПО ЕПСБУ.Ссылка = ЕПСБУВидыСубконто.Ссылка
	|			И (ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства))
	|ГДЕ
	|	ЕПСБУ.Ссылка В ИЕРАРХИИ
	|			(ВЫБРАТЬ
	|				СчетаЕПСБУ.Счет
	|			ИЗ
	|				СчетаЕПСБУ)
	|	И НЕ ЕПСБУ.ЭлементГруппа";
	
	Если ПолучатьКод Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЕПСБУ.Ссылка КАК Результат", "ЕПСБУ.Код КАК Результат");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("МассивКодов", СписокСчетов);
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Результат");
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
