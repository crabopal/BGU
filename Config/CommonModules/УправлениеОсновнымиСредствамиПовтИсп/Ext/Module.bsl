//
Функция МассивСчетовОС(ПараметрыПолученияСчетовОС) Экспорт
	
	ЕстьБалансовыеСчета = ПараметрыПолученияСчетовОС.ЖилыеПомещения
		Или ПараметрыПолученияСчетовОС.НежилыеПомещения
		Или ПараметрыПолученияСчетовОС.Сооружения
		Или ПараметрыПолученияСчетовОС.ИнвестНедвижимость
		Или ПараметрыПолученияСчетовОС.Машины
		Или ПараметрыПолученияСчетовОС.Транспорт
		Или ПараметрыПолученияСчетовОС.ХозИнвентарь
		Или ПараметрыПолученияСчетовОС.Биоресурсы
		Или ПараметрыПолученияСчетовОС.Библиотека
		Или ПараметрыПолученияСчетовОС.Прочие;
	
	Если ПараметрыПолученияСчетовОС.ВидИмущества = Перечисления.ВидыИмущества.НедвижимоеИмущество Тогда
		Родитель101 = "101.10";
		Родитель102 = "102.10";
		Родитель103 = "103.10";
		Родитель106 = "106.10";
	ИначеЕсли ПараметрыПолученияСчетовОС.ВидИмущества = Перечисления.ВидыИмущества.ДвижимоеОсобоЦенное Тогда
		Родитель101 = "101.20";
		Родитель102 = "102.20";
		Родитель103 = "103.20";
		Родитель106 = "106.20";
	ИначеЕсли ПараметрыПолученияСчетовОС.ВидИмущества = Перечисления.ВидыИмущества.ИноеДвижимое Тогда
		Родитель101 = "101.30";
		Родитель102 = "102.30";
		Родитель103 = "103.30";
		Родитель106 = "106.30";
	ИначеЕсли ПараметрыПолученияСчетовОС.ВидИмущества = Перечисления.ВидыИмущества.Лизинг Тогда
		Родитель101 = "101.40";
		Родитель102 = "102.40";
		Родитель103 = "103.40";
		Родитель106 = "106.40";
	ИначеЕсли ПараметрыПолученияСчетовОС.ВидИмущества = Перечисления.ВидыИмущества.ВКонцессии Тогда
		Родитель101 = "101.90";
		Родитель102 = "";
		Родитель103 = "103.90";
		Родитель106 = "106.90";
	Иначе
		Родитель101 = "101.00";
		Родитель102 = "102.00";
		Родитель103 = "103.00";
		Родитель106 = "106.00";
	КонецЕсли;
	
	Родитель108 = Новый Массив;
	
	Если ПараметрыПолученияСчетовОС.ИК Тогда
		
		Родитель101 = "";
		Родитель102 = "";
		Родитель103 = "";
		Родитель106 = "";
		
		Если ПараметрыПолученияСчетовОС.ВидИмущества = Перечисления.ВидыИмущества.НедвижимоеИмущество
			ИЛИ ПараметрыПолученияСчетовОС.ВидИмущества = Перечисления.ВидыИмущества.Казна
			Или Не ЗначениеЗаполнено(ПараметрыПолученияСчетовОС.ВидИмущества) Тогда
			Если ПараметрыПолученияСчетовОС.ОС Тогда
				Родитель108.Добавить("108.51");
			ИначеЕсли ПараметрыПолученияСчетовОС.НПА Тогда
				Родитель108.Добавить("108.55");
			КонецЕсли;
		КонецЕсли;
		
		Если ПараметрыПолученияСчетовОС.ВидИмущества = Перечисления.ВидыИмущества.ИноеДвижимое
			ИЛИ ПараметрыПолученияСчетовОС.ВидИмущества = Перечисления.ВидыИмущества.Казна
			Или Не ЗначениеЗаполнено(ПараметрыПолученияСчетовОС.ВидИмущества) Тогда
			Если ПараметрыПолученияСчетовОС.ОС Тогда
				Родитель108.Добавить("108.52");
				Родитель108.Добавить("108.53");
			ИначеЕсли ПараметрыПолученияСчетовОС.НМА Тогда
				Родитель108.Добавить("108.54");
			КонецЕсли;
		КонецЕсли;
		
		Если ПараметрыПолученияСчетовОС.ВидИмущества = Перечисления.ВидыИмущества.ВКонцессии
			ИЛИ ПараметрыПолученияСчетовОС.ВидИмущества = Перечисления.ВидыИмущества.Казна
			Или Не ЗначениеЗаполнено(ПараметрыПолученияСчетовОС.ВидИмущества) Тогда
			Если ПараметрыПолученияСчетовОС.ОС Тогда
				Родитель108.Добавить("108.91");
				Родитель108.Добавить("108.92");
			ИначеЕсли ПараметрыПолученияСчетовОС.НПА Тогда
				Родитель108.Добавить("108.95");
			ИначеЕсли ПараметрыПолученияСчетовОС.НМА Тогда
				Родитель108.Добавить("108.9I");
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	ЧастиЗапроса = Новый Массив;
	
	Если ЕстьБалансовыеСчета И ЗначениеЗаполнено(Родитель101) Тогда
		
		Запрос.УстановитьПараметр("Родитель101", Родитель101);
		ЧастиЗапроса.Добавить(
		"ВЫБРАТЬ
		|	ЕПСБУ.Ссылка КАК Ссылка
		|ИЗ
		|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|ГДЕ
		|	ЕПСБУ.Ссылка В ИЕРАРХИИ
		|			(ВЫБРАТЬ
		|				ВТ.Ссылка
		|			ИЗ
		|				ПланСчетов.ЕПСБУ КАК ВТ
		|			ГДЕ
		|				ВТ.Код = &Родитель101)
		|	И ПОДСТРОКА(ЕПСБУ.Код, 6, 1) В (&П5)
		|	И ЕПСБУ.ЭлементГруппа = ЛОЖЬ");
		
		Массив5 = Новый Массив;
		Если ПараметрыПолученияСчетовОС.ЖилыеПомещения Тогда
			Массив5.Добавить("1");
		КонецЕсли;
		Если ПараметрыПолученияСчетовОС.НежилыеПомещения Тогда
			Массив5.Добавить("2");
		КонецЕсли;
		Если ПараметрыПолученияСчетовОС.Сооружения Тогда
			Массив5.Добавить("2");
			Массив5.Добавить("3");
			Если Не ПараметрыПолученияСчетовОС.ИнвестНедвижимость Тогда 
				ЧастиЗапроса[ЧастиЗапроса.ВГраница()] = ЧастиЗапроса[ЧастиЗапроса.ВГраница()] +
				" И ВЫБОР КОГДА ПОДСТРОКА(ЕПСБУ.Код, 6, 1) = ""3"" ТОГДА ЕПСБУ.Ссылка.ДатаНачалаДействия = ДАТАВРЕМЯ(1,1,1) ИНАЧЕ ИСТИНА КОНЕЦ";
			КонецЕсли;
		КонецЕсли;
		Если ПараметрыПолученияСчетовОС.ИнвестНедвижимость Тогда
			Массив5.Добавить("3");
			Если Не ПараметрыПолученияСчетовОС.Сооружения Тогда
				ЧастиЗапроса[ЧастиЗапроса.ВГраница()] = ЧастиЗапроса[ЧастиЗапроса.ВГраница()] +
				" И ВЫБОР КОГДА ПОДСТРОКА(ЕПСБУ.Код, 6, 1) = ""3"" ТОГДА ЕПСБУ.Ссылка.ДатаНачалаДействия = ДАТАВРЕМЯ(2018,1,1) ИНАЧЕ ИСТИНА КОНЕЦ";
			КонецЕсли;
		КонецЕсли;
		Если ПараметрыПолученияСчетовОС.Машины Тогда
			Массив5.Добавить("4");
		КонецЕсли;
		Если ПараметрыПолученияСчетовОС.Транспорт Тогда
			Массив5.Добавить("5");
		КонецЕсли;
		Если ПараметрыПолученияСчетовОС.ХозИнвентарь Тогда
			Массив5.Добавить("6");
		КонецЕсли;
		Если ПараметрыПолученияСчетовОС.Биоресурсы Тогда
			Массив5.Добавить("7");
			Если Не ПараметрыПолученияСчетовОС.Библиотека Тогда
				ЧастиЗапроса[ЧастиЗапроса.ВГраница()] = ЧастиЗапроса[ЧастиЗапроса.ВГраница()] +
				" И ВЫБОР КОГДА ПОДСТРОКА(ЕПСБУ.Код, 6, 1) = ""7"" ТОГДА ЕПСБУ.Ссылка.ДатаНачалаДействия = ДАТАВРЕМЯ(2018,1,1) ИНАЧЕ ИСТИНА КОНЕЦ";
			КонецЕсли;
		КонецЕсли;
		Если ПараметрыПолученияСчетовОС.Библиотека Тогда
			Массив5.Добавить("7");
			Массив5.Добавить("8");
			Если Не ПараметрыПолученияСчетовОС.Биоресурсы Тогда
				ЧастиЗапроса[ЧастиЗапроса.ВГраница()] = ЧастиЗапроса[ЧастиЗапроса.ВГраница()] +
				" И ВЫБОР КОГДА ПОДСТРОКА(ЕПСБУ.Код, 6, 1) = ""7"" ТОГДА ЕПСБУ.Ссылка.ДатаНачалаДействия = ДАТАВРЕМЯ(1,1,1) ИНАЧЕ ИСТИНА КОНЕЦ";
			КонецЕсли;
		КонецЕсли;
		Если ПараметрыПолученияСчетовОС.Прочие Тогда
			Массив5.Добавить("8");
		КонецЕсли;
		Запрос.УстановитьПараметр("П5", Массив5);
		
	КонецЕсли;
	
	Если ПараметрыПолученияСчетовОС.НМА И ЗначениеЗаполнено(Родитель102) Тогда
		
