// Функция возвращает таблицу родителей по коду ОКОФ
//
Функция ВыбратьРодителейОКОФ(ОКОФ) Экспорт
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ОбщероссийскийКлассификаторОсновныхФондов.Ссылка КАК Ссылка,
	|	0 КАК УровеньГруппировки
	|ИЗ
	|	Справочник.ОбщероссийскийКлассификаторОсновныхФондов КАК ОбщероссийскийКлассификаторОсновныхФондов
	|ГДЕ
	|	ОбщероссийскийКлассификаторОсновныхФондов.Ссылка = &ОКОФ
	|ИТОГИ
	|	СУММА(УровеньГруппировки)
	|ПО
	|	Ссылка ТОЛЬКО ИЕРАРХИЯ";
	
	Если ТипЗнч(ОКОФ) = Тип("Строка") Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Ссылка = &ОКОФ", "Код = &ОКОФ");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);	
	Запрос.УстановитьПараметр("ОКОФ", ОКОФ);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Для Инд = 0 По Результат.Количество() - 1 Цикл
		
		Результат[Инд].УровеньГруппировки = Результат.Количество() - Инд;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция РасшифровываемыеПоказателиРеглОтчета(ИДОтчета, ИДРедакцииОтчета, ПараметрыОтчета) Экспорт
	
	ПоказателиОтчета = Новый Структура;
	РегламентированнаяОтчетностьБГУАвтозаполнение.ЗаполнитьПоказателиРегламентированногоОтчета(ПоказателиОтчета, ИДОтчета, ИДРедакцииОтчета, ПараметрыОтчета);
	
	Показатели = Новый Массив;
	
	Для Каждого Показатель Из ПоказателиОтчета Цикл
		Если Показатель.Значение[1] Тогда
			Показатели.Добавить(Показатель.Ключ);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Показатели;
	
КонецФункции

// Формирует соответствие ссылок на способы начисления и их представлений
//
// Возвращаемое значение:
//  - Соответствие - ключ: ПеречислениеСсылка.СпособНачисленияАмортизации, Значение: стрококвое представление ссылки
Функция СпособыНачисленияАмортизации_Соответствие() Экспорт
	ПриВводеВЭксплуатацию = Перечисления.СпособНачисленияАмортизации.ПриВводеВЭксплуатацию; 
	ПриВводеВЭксплуатациюСтрока = Строка(ПриВводеВЭксплуатацию); 
	
	Линейный = Перечисления.СпособНачисленияАмортизации.Линейный; 
	ЛинейныйСтрока = Строка(Линейный);
	
	УменьшаемогоОстатка = Перечисления.СпособНачисленияАмортизации.УменьшаемогоОстатка; 
	УменьшаемогоОстаткаСтрока = Строка(УменьшаемогоОстатка);

	ПропорциональноОбъемуПродукции = Перечисления.СпособНачисленияАмортизации.ПропорциональноОбъемуПродукции; 
	ПропорциональноОбъемуПродукцииСтрока = Строка(ПропорциональноОбъемуПродукции);
	
	
	МетодыНачисления = Новый Соответствие;
	МетодыНачисления.Вставить(Перечисления.СпособНачисленияАмортизации.ПустаяСсылка(), "");
	МетодыНачисления.Вставить(ПриВводеВЭксплуатацию, ПриВводеВЭксплуатациюСтрока);
	МетодыНачисления.Вставить(Линейный, ЛинейныйСтрока);
	МетодыНачисления.Вставить(УменьшаемогоОстатка, УменьшаемогоОстаткаСтрока);
	МетодыНачисления.Вставить(ПропорциональноОбъемуПродукции, ПропорциональноОбъемуПродукцииСтрока);

	МетодыНачисления.Вставить("0", "");
	МетодыНачисления.Вставить("1", "");
	МетодыНачисления.Вставить("2", ПриВводеВЭксплуатациюСтрока);
	МетодыНачисления.Вставить("3", ЛинейныйСтрока);
	МетодыНачисления.Вставить("4", УменьшаемогоОстаткаСтрока);
	МетодыНачисления.Вставить("5", ПропорциональноОбъемуПродукцииСтрока);
		
	Возврат МетодыНачисления;
КонецФункции	
	
