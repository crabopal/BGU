// Устарела. Использовать МассивСчетовОС()
Функция ПолучитьМассивСчетовОС(	ВидИмущества = Неопределено,
								ЖилыеПомещения = Ложь,
								НежилыеПомещения = Ложь,
								Сооружения = Ложь,
								Машины = Ложь,
								Транспорт = Ложь,
								ХозИнвентарь = Ложь,
								Библиотека = Ложь,
								Прочие = Ложь,
								Аренда = Ложь,
								Хранение = Ложь) Экспорт
								
	СтруктураСчетов = УправлениеОсновнымиСредствамиКлиентСервер.СтруктураЗапрашиваемыхСчетов();
	СтруктураСчетов.ВидИмущества		= ВидИмущества;
	СтруктураСчетов.ЖилыеПомещения		= ЖилыеПомещения;
	СтруктураСчетов.НежилыеПомещения	= НежилыеПомещения;
	СтруктураСчетов.Сооружения			= Сооружения;
	СтруктураСчетов.Машины				= Машины;
	СтруктураСчетов.Транспорт			= Транспорт;
	СтруктураСчетов.ХозИнвентарь		= ХозИнвентарь;
	СтруктураСчетов.Библиотека			= Библиотека;
	СтруктураСчетов.Прочие				= Прочие;
	СтруктураСчетов.Аренда				= Аренда;
	СтруктураСчетов.Хранение			= Хранение;
	
	Возврат МассивСчетовОС(СтруктураСчетов);
	
	Результат = Новый Массив;
	
	Массив4 = Новый Массив;
	Если ВидИмущества = Неопределено Тогда
		Массив4.Добавить("1");
		Массив4.Добавить("2");
		Массив4.Добавить("3");
		Массив4.Добавить("4");
	ИначеЕсли ВидИмущества = Перечисления.ВидыИмущества.НедвижимоеИмущество Тогда
		Массив4.Добавить("1");
	ИначеЕсли ВидИмущества = Перечисления.ВидыИмущества.ДвижимоеОсобоЦенное Тогда
		Массив4.Добавить("2");
	ИначеЕсли ВидИмущества = Перечисления.ВидыИмущества.ИноеДвижимое Тогда
		Массив4.Добавить("3");
	ИначеЕсли ВидИмущества = Перечисления.ВидыИмущества.Лизинг Тогда
		Массив4.Добавить("4");
	КонецЕсли;
	
	Массив5 = Новый Массив;
	Если ЖилыеПомещения Тогда
		Массив5.Добавить("1");
	КонецЕсли;
	Если НежилыеПомещения Тогда
		Массив5.Добавить("2");
	КонецЕсли;
	Если Сооружения Тогда
		Массив5.Добавить("3");
	КонецЕсли;
	Если Машины Тогда
		Массив5.Добавить("4");
	КонецЕсли;
	Если Транспорт Тогда
		Массив5.Добавить("5");
	КонецЕсли;
	Если ХозИнвентарь Тогда
		Массив5.Добавить("6");
	КонецЕсли;
	Если Библиотека Тогда
		Массив5.Добавить("7");
	КонецЕсли;
	Если Прочие Тогда
		Массив5.Добавить("8");
	КонецЕсли;
	
	Для Каждого Тек4 Из Массив4 Цикл
		Для Каждого Тек5 Из Массив5 Цикл
			Счет = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("101."+Тек4+Тек5);
			Если ЗначениеЗаполнено(Счет) Тогда
				Результат.Добавить(Счет);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Если Аренда Тогда
		Счет = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("01.11");
		Если ЗначениеЗаполнено(Счет) Тогда
			Результат.Добавить(Счет);
		КонецЕсли;
		Счет = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("01.12");
		Если ЗначениеЗаполнено(Счет) Тогда
			Результат.Добавить(Счет);
		КонецЕсли;
		Счет = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("01.21");
		Если ЗначениеЗаполнено(Счет) Тогда
			Результат.Добавить(Счет);
		КонецЕсли;
		Счет = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("01.22");
		Если ЗначениеЗаполнено(Счет) Тогда
			Результат.Добавить(Счет);
		КонецЕсли;
		Счет = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("01.31");
		Если ЗначениеЗаполнено(Счет) Тогда
			Результат.Добавить(Счет);
		КонецЕсли;
		Счет = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("01.32");
		Если ЗначениеЗаполнено(Счет) Тогда
			Результат.Добавить(Счет);
		КонецЕсли;
	КонецЕсли;
	
	Если Хранение Тогда
		Счет = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("02.1");
		Если ЗначениеЗаполнено(Счет) Тогда
			Результат.Добавить(Счет);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

