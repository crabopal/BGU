		|	И ЕПСБУ.ЭлементГруппа = ЛОЖЬ");
		
	КонецЕсли;
	
	Если Родитель108.Количество() > 0 Тогда
		
		Запрос.УстановитьПараметр("Родитель108", Родитель108);
		ЧастиЗапроса.Добавить(
		"ВЫБРАТЬ
		|	ЕПСБУ.Ссылка КАК Ссылка
		|ИЗ
		|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|ГДЕ
		|	ЕПСБУ.Ссылка В ИЕРАРХИИ
		|			(ВЫБРАТЬ
		|				ВТ.Ссылка
		|			ИЗ
		|				ПланСчетов.ЕПСБУ КАК ВТ
		|			ГДЕ
		|				ВТ.Код В (&Родитель108))
		|	И ЕПСБУ.ЭлементГруппа = ЛОЖЬ");
		
