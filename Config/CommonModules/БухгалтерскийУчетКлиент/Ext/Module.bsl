Процедура СпособЗачетаАвансаПриИзменении(Элемент, Форма) Экспорт
	
	УчетРасчетовКлиент.СпособЗачетаАвансаПриИзменении(Элемент, Форма);
	
КонецПроцедуры

Функция РазрешитьЗаполнениеТаблицыАвансы(Форма, Объект) Экспорт

	ТекстПредупреждения = "";
	Если Объект.Ссылка.Пустая()
		ИЛИ Форма.Модифицированность Тогда
		
		ТекстПредупреждения = НСтр("ru = 'Перед заполнением таблицы авансов следует записать документ'");
		
	КонецЕсли;
	
	Если ПустаяСтрока(ТекстПредупреждения) Тогда
		Возврат Истина;
	Иначе
		ПоказатьПредупреждение(, ТекстПредупреждения);
		Возврат Ложь;
	КонецЕсли;

КонецФункции

Процедура ДокументАвансаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка, Форма, Объект) Экспорт
	
	СтандартнаяОбработка = Ложь;
	Параметры = Новый Структура;
	Параметры.Вставить("Организация", Объект.Организация);
	Параметры.Вставить("Контрагент", Объект.Контрагент);
	Параметры.Вставить("Договор", Объект.Договор);
	Параметры.Вставить("РежимВыбора", Истина);
	Если Объект.Ссылка.Пустая() Тогда
		Параметры.Вставить("Период", КонецДня(Объект.Дата));
	Иначе
		Параметры.Вставить("Период", Объект.Ссылка);
	КонецЕсли;
	
	Форма.ДополнитьПараметрыВыбораДокументаАвансов(Параметры);

	ОткрытьФорму("Обработка.ПодборДокументовАвансов.Форма", Параметры, Элемент);

КонецПроцедуры

Процедура ДокументАвансаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка, Форма, Объект) Экспорт

	УчетРасчетовКлиент.ДокументАвансаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка, Форма, Объект);

КонецПроцедуры

