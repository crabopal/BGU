#Область СлужебныеПроцедурыИФункции

// Осуществляет поиск элемента нужного типа, для установки отбора при начале выбора значения субконто
//
Функция ПолучитьСубконтоНужногоТипа(Параметры, ТекНомерСубконто, Тип, Счет, МаксКоличествоСубконто)
	Перем ПроверяемоеСубконто;
	
	Для Индекс = 1 По МаксКоличествоСубконто Цикл
		
		Если Индекс = ТекНомерСубконто Тогда
			Продолжить;
		КонецЕсли;
		
		Параметры.Свойство("Субконто"+Индекс, ПроверяемоеСубконто);
		Если ТипЗнч(ПроверяемоеСубконто) = Тип Тогда
			Возврат ПроверяемоеСубконто;
		КонецЕсли;
		
	КонецЦикла;
	
	// если поиск по элементам не удался, то пробуем поиск по субконто счета
	
	ДанныеСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(Счет);
	Для Индекс = 1 По МаксКоличествоСубконто Цикл
		
		Если Индекс = ТекНомерСубконто Тогда
			Продолжить;
		КонецЕсли;
		
		Параметры.Свойство("Субконто"+Индекс);
		Если ДанныеСчета["ВидСубконто"+Индекс]<>Неопределено Тогда
			Если ДанныеСчета["ВидСубконто"+Индекс+"ТипЗначения"].СодержитТип(Тип) Тогда
				Возврат Параметры["Субконто"+Индекс];
			КонецЕсли;
		КонецЕсли;
	
	КонецЦикла; 
	
	Возврат Неопределено;

КонецФункции

Функция ПолноеИмяПоТипуЗначения(ТипЗначения) Экспорт
	
	ТипыБГУ = СтандартныеПодсистемыКлиентПовтИсп.ПараметрыРаботыКлиента().ПараметрыБГУ_ИменаТипов;
	
	ПолноеИмяТипа = ТипыБГУ.Получить(ТипЗначения);
	Если ПолноеИмяТипа = Неопределено Тогда
		ПолноеИмяТипа = ОбщегоНазначенияБГУВызовСервера.ВернутьСтрокуТипаПоТипу(ТипЗначения, "ПолноеИмя");
	КонецЕсли;
	
	Возврат ?(ЗначениеЗаполнено(ПолноеИмяТипа), ПолноеИмяТипа, "");
	
КонецФункции

