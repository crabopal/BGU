	Результат.Вставить("Телефон", "");
	Результат.Вставить("АдресЭП", "");
	Результат.Вставить("ОтказКлиентаОтСохраненияТелефонаEmail", Истина);
	
	ЗаполнитьЗначенияСвойств(Результат, ДокументОснование);
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ФискальныеОперации.НомерЧекаККМ КАК НомерЧекаККМ,
	               |	ФискальныеОперации.Дата КАК ДатаЧекаККМ,
	               |	ФискальныеОперации.ФискальныйПризнак КАК ФискальныйПризнак,
	               |	ФискальныеОперации.ИдентификаторЗаписи КАК ИдентификаторЗаписи,
	               |	ФискальныеОперации.ТипРасчета КАК ТипРасчета,
	               |	ФискальныеОперации.НомерСменыККМ КАК НомерСменыККМ,
	               |	ФискальныеОперации.Сумма КАК СуммаЧекаККМ,
	               |	ФискальныеОперации.ОплатаНаличные КАК ОплатаНаличные,
	               |	ФискальныеОперации.ОплатаЭлектронно КАК ОплатаЭлектронно,
	               |	ФискальныеОперации.ОплатаПостоплата КАК ОплатаПостоплата,
	               |	ФискальныеОперации.ОплатаПредоплата КАК ОплатаПредоплата,
	               |	ФискальныеОперации.ОплатаВстречноеПредоставление КАК ОплатаВстречноеПредоставление,
	               |	ФискальныеОперации.ЗаводскойНомерФН КАК ЗаводскойНомерФН,
	               |	ФискальныеОперации.РегистрационныйНомерККТ КАК РегистрационныйНомерККТ,
	               |	ФискальныеОперации.ДополнительныйРеквизит КАК ДополнительныйРеквизит,
	               |	ФискальныеОперации.ДанныеXML КАК ДанныеXMLЧекаККМ,
	               |	ФискальныеОперации.АдресСайтаПроверки КАК АдресСайтаПроверки
	               |ИЗ
	               |	РегистрСведений.ФискальныеОперации КАК ФискальныеОперации
	               |ГДЕ
	               |	ФискальныеОперации.ДокументОснование = &ДокументОснование
	               |	И ФискальныеОперации.ТипДокумента = &ТипДокумента
	               |	И ФискальныеОперации.ИдентификаторЗаписи = &ИдентификаторЗаписи
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ФискальныеОперации.Дата УБЫВ";
	
	Если ИдентификаторЗаписи = Неопределено Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И ФискальныеОперации.ИдентификаторЗаписи = &ИдентификаторЗаписи", "");
	КонецЕсли;	
	
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	Запрос.УстановитьПараметр("ТипДокумента", ТипДокумента);
	Запрос.УстановитьПараметр("ИдентификаторЗаписи", ИдентификаторЗаписи);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
		Результат.ТекстовыеДанныеXML = Выборка.ДанныеXMLЧекаККМ.Получить();
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

