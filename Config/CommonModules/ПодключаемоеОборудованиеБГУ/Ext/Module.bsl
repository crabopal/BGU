	               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.Ссылка,
	               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.Контрагент,
	               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.ДоговорКонтрагента,
	               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.Ссылка.НачислениеЗаУслугу.Номенклатура,
	               |	1,
	               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.Сумма,
	               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.СтавкаНДС,
	               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.СуммаНДС,
	               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.Сумма,
	               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.Студент,
	               |	ЗНАЧЕНИЕ(Справочник.Дети.ПустаяСсылка),
	               |	2
	               |ИЗ
	               |	Документ.НачислениеСтудентамЗаПрочиеУслуги.Начисления КАК НачислениеСтудентамЗаПрочиеУслугиНачисления
	               |ГДЕ
	               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.Ссылка В(&МассивДокументовРеализации)
	               |	И НачислениеСтудентамЗаПрочиеУслугиНачисления.Сумма > 0
	               |	И НачислениеСтудентамЗаПрочиеУслугиНачисления.ДоговорКонтрагента.НеПрименятьККТКромеРасчетовНаличнымиИЭСП = ЛОЖЬ
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	НачислениеРодительскойПлатыНачисления.Ссылка,
	               |	НачислениеРодительскойПлатыНачисления.Контрагент,
	               |	НачислениеРодительскойПлатыНачисления.ДоговорКонтрагента,
	               |	НачислениеРодительскойПлатыНачисления.ГруппаДетскогоУчреждения.Номенклатура,
	               |	1,
	               |	НачислениеРодительскойПлатыНачисления.Сумма,
	               |	НачислениеРодительскойПлатыНачисления.СтавкаНДС,
	               |	НачислениеРодительскойПлатыНачисления.СуммаНДС,
	               |	НачислениеРодительскойПлатыНачисления.Всего,
	               |	ЗНАЧЕНИЕ(Справочник.Студенты.ПустаяСсылка),
	               |	НачислениеРодительскойПлатыНачисления.Ребенок,
	               |	3
	               |ИЗ
	               |	Документ.НачислениеРодительскойПлаты.Начисления КАК НачислениеРодительскойПлатыНачисления
	               |ГДЕ
	               |	НачислениеРодительскойПлатыНачисления.Ссылка В(&МассивДокументовРеализации)
	               |	И НачислениеРодительскойПлатыНачисления.Всего > 0
	               |	И НачислениеРодительскойПлатыНачисления.ДоговорКонтрагента.НеПрименятьККТКромеРасчетовНаличнымиИЭСП = ЛОЖЬ
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	СписаниеДоходовБудущихПериодовДоходыБудущихПериодов.Ссылка,
	               |	СписаниеДоходовБудущихПериодовДоходыБудущихПериодов.Контрагент,
	               |	СписаниеДоходовБудущихПериодовДоходыБудущихПериодов.Договор,
	               |	СписаниеДоходовБудущихПериодовДоходыБудущихПериодов.Номенклатура,
	               |	1,
	               |	СписаниеДоходовБудущихПериодовДоходыБудущихПериодов.Всего,
	               |	СписаниеДоходовБудущихПериодовДоходыБудущихПериодов.СтавкаНДС,
	               |	СписаниеДоходовБудущихПериодовДоходыБудущихПериодов.СуммаНДС,
	               |	СписаниеДоходовБудущихПериодовДоходыБудущихПериодов.Всего,
	               |	ЗНАЧЕНИЕ(Справочник.Студенты.ПустаяСсылка),
	               |	ЗНАЧЕНИЕ(Справочник.Дети.ПустаяСсылка),
	               |	4
	               |ИЗ
	               |	Документ.СписаниеДоходовБудущихПериодов.ДоходыБудущихПериодов КАК СписаниеДоходовБудущихПериодовДоходыБудущихПериодов
	               |ГДЕ
	               |	СписаниеДоходовБудущихПериодовДоходыБудущихПериодов.Ссылка В(&МассивДокументовРеализации)
	               |	И СписаниеДоходовБудущихПериодовДоходыБудущихПериодов.Всего > 0
	               |	И СписаниеДоходовБудущихПериодовДоходыБудущихПериодов.Договор.НеПрименятьККТКромеРасчетовНаличнымиИЭСП = ЛОЖЬ
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	АктОбОказанииУслуг.Ссылка,
	               |	АктОбОказанииУслуг.Ссылка.Контрагент,
	               |	АктОбОказанииУслуг.Ссылка.Договор,
	               |	АктОбОказанииУслуг.Номенклатура,
	               |	1,
	               |	АктОбОказанииУслуг.Всего,
	               |	АктОбОказанииУслуг.СтавкаНДС,
	               |	АктОбОказанииУслуг.СуммаНДС,
	               |	АктОбОказанииУслуг.Всего,
	               |	ЗНАЧЕНИЕ(Справочник.Студенты.ПустаяСсылка),
	               |	ЗНАЧЕНИЕ(Справочник.Дети.ПустаяСсылка),
	               |	5
	               |ИЗ
	               |	Документ.АктОбОказанииУслуг.УслугиОказанные КАК АктОбОказанииУслуг
	               |ГДЕ
	               |	АктОбОказанииУслуг.Ссылка В(&МассивДокументовРеализации)
	               |	И АктОбОказанииУслуг.Всего > 0
	               |	И АктОбОказанииУслуг.Ссылка.Договор.НеПрименятьККТКромеРасчетовНаличнымиИЭСП = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("МассивДокументовРеализации", МассивДокументовОснованийЧекаККМ);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции	

