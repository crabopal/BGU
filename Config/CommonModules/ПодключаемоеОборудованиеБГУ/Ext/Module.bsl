Функция ПереченьСистемНалогообложенияПоставщика(Организация)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ПараметрыДоговораПлатежногоАгентаСистемыНалогообложенияЧекаККМ.СистемаНалогообложенияЧекаККМ КАК СистемаНалогообложенияЧекаККМ
	               |ИЗ
	               |	Справочник.ПараметрыДоговораПлатежногоАгента.СистемыНалогообложенияЧекаККМ КАК ПараметрыДоговораПлатежногоАгентаСистемыНалогообложенияЧекаККМ
	               |ГДЕ
	               |	ПараметрыДоговораПлатежногоАгентаСистемыНалогообложенияЧекаККМ.Ссылка.Организация = &Организация
	               |	И ПараметрыДоговораПлатежногоАгентаСистемыНалогообложенияЧекаККМ.Ссылка.ПометкаУдаления = ЛОЖЬ";	
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;	
	
КонецФункции

