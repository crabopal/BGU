КонецФункции	

Функция НомерФискальногоНакопителя(КассаККМЧека) Экспорт
	
	Результат = "";
	Если ЗначениеЗаполнено(КассаККМЧека) Тогда
		ОборудованиеЧека = КассаККМЧека.ПодключаемоеОборудование;
		Если ЗначениеЗаполнено(ОборудованиеЧека) Тогда
			Если ОборудованиеЧека.ТипОборудования = ПредопределенноеЗначение("Перечисление.ТипыПодключаемогоОборудования.ККТ") Тогда
				ПараметрыРегистрацииУстройства = ОборудованиеЧекопечатающиеУстройства.ПараметрыРегистрацииУстройства(ОборудованиеЧека);
				Если ПараметрыРегистрацииУстройства.ЕстьДанные Тогда
					Результат = ПараметрыРегистрацииУстройства.ЗаводскойНомерФН;
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

