	Результат.Колонки.Добавить("Цена");
	Результат.Колонки.Добавить("Сумма");
	Результат.Колонки.Добавить("СтавкаНДС");
	Результат.Колонки.Добавить("СуммаНДС");
	Результат.Колонки.Добавить("СуммаВключаетНДС");
	Результат.Колонки.Добавить("НомерСекции");
	Результат.Колонки.Добавить("ЕдиницаИзмеренияПредметаРасчета");
	
	Результат.Колонки.Добавить("ПризнакПредметаРасчета");
	Результат.Колонки.Добавить("ПризнакСпособаРасчета");
