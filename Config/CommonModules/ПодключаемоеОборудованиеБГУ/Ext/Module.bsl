Функция СтавкаНДСИзНоменклатуры(ПризнакСпособаРасчета, Номенклатура) Экспорт
	ЭтоАванс = Ложь;
	Если ПризнакСпособаРасчета = Перечисления.ПризнакиСпособаРасчета.Аванс Тогда
		ЭтоАванс = Истина;
	КонецЕсли;	
	
	Результат = Перечисления.СтавкиНДС.БезНДС;
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, "СтавкаНДС");
	СтавкаНДС = ЗначенияРеквизитов.СтавкаНДС;
	Если ЗначениеЗаполнено(СтавкаНДС) Тогда
		Если ЭтоАванс Тогда
			Результат = УчетНДСКлиентСервер.ПолучитьРасчетнуюСтавку(СтавкаНДС);
		Иначе
			Результат = СтавкаНДС;
		КонецЕсли;	
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция СуммаНДСПоСтавкеВСоставеСуммы(СтавкаНДС, Сумма) Экспорт
	СтавкаНДСДляРасчета = УчетНДСКлиентСервер.ЗначениеСтавкиНДС(СтавкаНДС);
	Результат = Сумма * СтавкаНДСДляРасчета / (100 + СтавкаНДСДляРасчета);
	
	Возврат Результат;
КонецФункции	

Функция НаименованиеКонтрагентаПлательщика(КонтрагентПлательщик, ФИОПолностью = Истина, ВозвратДС = Ложь) Экспорт
	Результат = "";
	
	Если НЕ ЗначениеЗаполнено(КонтрагентПлательщик) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если КонтрагентПлательщик.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
		Если ФИОПолностью Тогда
			Результат = СокрЛП(КонтрагентПлательщик);
			Если ВозвратДС И ЗначениеЗаполнено(КонтрагентПлательщик.НаименованиеДП) Тогда
				Результат = КонтрагентПлательщик.НаименованиеДП
			КонецЕсли;	
			Если НЕ ВозвратДС И ЗначениеЗаполнено(КонтрагентПлательщик.НаименованиеРП) Тогда
				Результат = СокрЛП(КонтрагентПлательщик.НаименованиеРП);
			КонецЕсли;
		Иначе	
			Результат = Справочники.Контрагенты.ФамилияИО(СокрЛП(КонтрагентПлательщик));
		КонецЕсли;
	Иначе
		Результат = КонтрагентПлательщик.НаименованиеСокращенное;
		Если Не ЗначениеЗаполнено(Результат) Тогда
			ЮридическоеФизическоеЛицо = КонтрагентПлательщик.ЮридическоеФизическоеЛицо;
			Результат = ЮридическоеФизическоеЛицо.НаименованиеПолное;
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

Функция ДокументыОснованияСЧекамиДляРеестра(ЧекиККМДляРеестраПлатежейСсылка, ДокументыОснования) Экспорт
	Результат = Неопределено;
	
	МассивДокументыОснования = ДокументыОснования.ВыгрузитьКолонку("ДокументОснованиеЧековККМ");
	
	МассивДокументовЧекиДляРеестра = Новый Массив;
	Если ЗначениеЗаполнено(ЧекиККМДляРеестраПлатежейСсылка) Тогда
		МассивДокументовЧекиДляРеестра.Добавить(ЧекиККМДляРеестраПлатежейСсылка);
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЧекиККМДляРеестраПлатежейДокументыГруппыЧековККМ.Ссылка КАК Ссылка,
	|	ЧекиККМДляРеестраПлатежейДокументыГруппыЧековККМ.ДокументОснованиеЧековККМ КАК ДокументОснованиеЧековККМ
	|ПОМЕСТИТЬ НайденныеЧекиККМДляРеестровПлатежей
	|ИЗ
	|	Документ.ЧекиККМДляРеестраПлатежей.ДокументыГруппыЧековККМ КАК ЧекиККМДляРеестраПлатежейДокументыГруппыЧековККМ
	|ГДЕ
	|	ЧекиККМДляРеестраПлатежейДокументыГруппыЧековККМ.ДокументОснованиеЧековККМ В(&ДокументыОснованияЧековККМ)
	|	И ЧекиККМДляРеестраПлатежейДокументыГруппыЧековККМ.Ссылка.ПометкаУдаления = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НайденныеЧекиККМДляРеестровПлатежей.Ссылка КАК Ссылка,
	|	НайденныеЧекиККМДляРеестровПлатежей.ДокументОснованиеЧековККМ КАК ДокументОснованиеЧековККМ
	|ПОМЕСТИТЬ СписокДокументовСЧеками
	|ИЗ
	|	НайденныеЧекиККМДляРеестровПлатежей КАК НайденныеЧекиККМДляРеестровПлатежей
	|ГДЕ
	|	НЕ НайденныеЧекиККМДляРеестровПлатежей.Ссылка В (&ЧекиККМДляРеестра)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СписокДокументовСЧеками.ДокументОснованиеЧековККМ КАК ДокументОснованиеЧековККМ
	|ИЗ
	|	СписокДокументовСЧеками КАК СписокДокументовСЧеками";
	
	Запрос.УстановитьПараметр("ДокументыОснованияЧековККМ", МассивДокументыОснования);
	Запрос.УстановитьПараметр("ЧекиККМДляРеестра", МассивДокументовЧекиДляРеестра);

	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
КонецФункции

