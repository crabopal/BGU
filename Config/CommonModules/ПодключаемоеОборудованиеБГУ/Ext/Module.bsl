
#Область ПрограммныйИнтерфейс

Функция ВидСистемыНалогообложенияОрганизации(Организация, ДатаСведений) Экспорт
	Результат = Перечисления.ВидыСистемыНалогообложенияЧекаККМ.ОСН;
	
	УчетнаяПолитика = ПлатежноРасчетныеДокументыПовтИсп.ПолучитьУчетнуюПолитикуОрганизации(Организация, ДатаСведений);
	
	Если УчетнаяПолитика.ПрименяетсяУСНДоходы Тогда
		Результат = Перечисления.ВидыСистемыНалогообложенияЧекаККМ.УСНДоходы;
	ИначеЕсли УчетнаяПолитика.ПрименяетсяУСНДоходыМинусРасходы Тогда
		Результат = Перечисления.ВидыСистемыНалогообложенияЧекаККМ.УСНДоходыМинусРасходы;
	КонецЕсли;	
	
	Если УчетнаяПолитика.ПлательщикЕНВД Тогда
		Результат = Перечисления.ВидыСистемыНалогообложенияЧекаККМ.ЕНВД;
	КонецЕсли;	
	
	Возврат Результат;	
КонецФункции

Функция ВидСистемыНалогообложенияБПООрганизации(Организация, ДатаСведений) Экспорт
	Результат = Новый Массив;
	Результат.Добавить(Перечисления.ТипыСистемНалогообложенияККТ.ОСН);
	
	УчетнаяПолитика = ПлатежноРасчетныеДокументыПовтИсп.ПолучитьУчетнуюПолитикуОрганизации(Организация, ДатаСведений);
	
	Если УчетнаяПолитика.ПрименяетсяУСНДоходы Тогда
		Результат.Добавить(Перечисления.ТипыСистемНалогообложенияККТ.УСНДоход);
	ИначеЕсли УчетнаяПолитика.ПрименяетсяУСНДоходыМинусРасходы Тогда
		Результат.Добавить(Перечисления.ТипыСистемНалогообложенияККТ.УСНДоходРасход);
	КонецЕсли;	
	
	Если УчетнаяПолитика.ПлательщикЕНВД Тогда
		Результат.Добавить(Перечисления.ТипыСистемНалогообложенияККТ.ЕНВД);
	КонецЕсли;	
	
	Возврат Результат;	
КонецФункции

Функция ПереченьСистемНалогообложенияОрганизации(Организация, ДатаСведений) Экспорт
	
	Результат = Новый Массив;
	
	УчетнаяПолитика = ПлатежноРасчетныеДокументыПовтИсп.ПолучитьУчетнуюПолитикуОрганизации(Организация, ДатаСведений);
	
	Если УчетнаяПолитика.ПлательщикЕНВД Тогда
		Результат.Добавить(Перечисления.ВидыСистемыНалогообложенияЧекаККМ.ЕНВД);
	КонецЕсли;	
	
	Если УчетнаяПолитика.ПрименяетсяУСНДоходы Тогда
		Результат.Добавить(Перечисления.ВидыСистемыНалогообложенияЧекаККМ.УСНДоходы);
	ИначеЕсли УчетнаяПолитика.ПрименяетсяУСНДоходыМинусРасходы Тогда
		Результат.Добавить(Перечисления.ВидыСистемыНалогообложенияЧекаККМ.УСНДоходыМинусРасходы);
	Иначе	
		Результат.Добавить(Перечисления.ВидыСистемыНалогообложенияЧекаККМ.ОСН);
	КонецЕсли;
	
	ТаблицаСНОПоставщиков = ПереченьСистемНалогообложенияПоставщика(Организация);
	Для каждого ТекСтрока Из ТаблицаСНОПоставщиков Цикл
		СистемаНалогообложенияЧекаККМ = ТекСтрока.СистемаНалогообложенияЧекаККМ;
		Если Результат.Найти(СистемаНалогообложенияЧекаККМ) = Неопределено Тогда
			Результат.Добавить(СистемаНалогообложенияЧекаККМ);
		Конецесли;	
	КонецЦикла;	
	
	Возврат Результат;	
	
КонецФункции
	
Функция ЕдиныеСтавкиВДокументеОснованииЧекаККМ(ДокументСсылка) Экспорт
	ПустаяСтавка = Перечисления.СтавкиНДС.ПустаяСсылка();
	ТаблицаПоСтавкам = Новый ТаблицаЗначений;
	ТаблицаПоСтавкам.Колонки.Добавить("СтавкаНДС");
	ТаблицаПоСтавкам.Колонки.Добавить("СуммаНДС");
	
	Результат = Новый Структура("Единая, ЕдинаяДляТЧ, Значение, СуммаНДС, Всего, ТаблицаПоСтавкам", Истина, Истина, ПустаяСтавка, 0, 0, ТаблицаПоСтавкам);
	
	Товары = ТаблицаНоменклатурыЧекаККМ(ДокументСсылка);
	Результат.СуммаНДС = Товары.Итог("СуммаНДС");
	Результат.Всего = Товары.Итог("Сумма");
	
	Значение = ПустаяСтавка;
	Товары.Свернуть("СтавкаНДС", "СуммаНДС");
	Для каждого ТекСтрока Из Товары Цикл
		Если ТекСтрока.СуммаНДС <> 0 Тогда
			Значение = ТекСтрока.СтавкаНДС;
			НоваяСтрока = ТаблицаПоСтавкам.Добавить();
			НоваяСтрока.СтавкаНДС = ТекСтрока.СтавкаНДС;
			НоваяСтрока.СуммаНДС = ТекСтрока.СуммаНДС;
		КонецЕсли;	
	КонецЦикла;
	
	ТаблицаПоСтавкам.Сортировать("СтавкаНДС Убыв");
	
	Результат.ТаблицаПоСтавкам = ТаблицаПоСтавкам;
	
	ТипДокумента = ПодключаемоеОборудованиеБГУВызовСервера.ТипДокумента(ДокументСсылка);
	Если (ТипДокумента = 5) ИЛИ (ТипДокумента = 6) Тогда
		СтавкаДокумента = Перечисления.СтавкиНДС.ПустаяСсылка();
	Иначе
		СтавкаДокумента = ?(ДокументСсылка.СтавкаНДС = Перечисления.СтавкиНДС.ПустаяСсылка(), Перечисления.СтавкиНДС.БезНДС ,ДокументСсылка.СтавкаНДС);
	КонецЕсли;
	
	Результат.Единая = Истина;
	Для каждого ТекСтрока Из ТаблицаПоСтавкам Цикл
		Если НЕ (СтавкаДокумента = ТекСтрока.СтавкаНДС) Тогда
			Результат.Единая = Ложь;	
		КонецЕсли;
	КонецЦикла;
	Результат.Значение = Значение;
	Результат.ЕдинаяДляТЧ = ?(ТаблицаПоСтавкам.Количество()>1, Ложь, Истина);
	
	Возврат Результат;
КонецФункции	

Функция ЕдиныеСтавкиВДокументеОтчетПоКассовойСмене(ОтчетПоКассовойСмене, СписокСчетовОтбора = Неопределено) Экспорт
	
	ПустаяСтавка = Перечисления.СтавкиНДС.ПустаяСсылка();
	ТаблицаПоСтавкам = Новый ТаблицаЗначений;
	ТаблицаПоСтавкам.Колонки.Добавить("СтавкаНДС");
	ТаблицаПоСтавкам.Колонки.Добавить("СуммаНДС");
	
	Результат = Новый Структура("Единая, ЕдинаяДляТЧ, Значение, СуммаНДС, Всего, ТаблицаПоСтавкам", Истина, Истина, ПустаяСтавка, 0, 0, ТаблицаПоСтавкам);
	
	ПродажиПоСтавкамНДС = ОтчетПоКассовойСмене.ПродажиПоСтавкамНДС.Выгрузить();
	ПродажиПоСтавкамНДС.Колонки.Добавить("СчетУчета",	Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));

	ПродажиПоСтавкамНДСПредоплата = ОтчетПоКассовойСмене.ПродажиПоСтавкамНДСПредоплата.Выгрузить();
	ПродажиПоСтавкамНДСПредоплата.Колонки.Добавить("СчетУчета",	Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	
	Для Каждого СтрокаПредоплата Из ПродажиПоСтавкамНДСПредоплата Цикл 
		НоваяСтрока = ПродажиПоСтавкамНДС.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПредоплата);
	КонецЦикла;
	
	Для каждого ТекСтрока Из ПродажиПоСтавкамНДС Цикл
		ТекСтрока.СчетУчета = ТекСтрока.СтатьяАналитикиОплаты.СчетУчета;
	КонецЦикла;	
	
	Результат.СуммаНДС = 0;
	Результат.Всего = 0;
	
	Значение = ПустаяСтавка;
	ПродажиПоСтавкамНДС.Свернуть("ТипОплаты, СчетУчета, СтавкаНДС", "СуммаНДС, Сумма");
	Для каждого ТекСтрока Из ПродажиПоСтавкамНДС Цикл
		ОтбиратьСчетУчета = Ложь;
		Если СписокСчетовОтбора = Неопределено Тогда
			ОтбиратьСчетУчета = Истина;
		Иначе	
			Если СписокСчетовОтбора.Найти(ТекСтрока.СчетУчета) <> Неопределено Тогда
				ОтбиратьСчетУчета = Истина;
			КонецЕсли;	
		КонецЕсли;	
		
		Если (ТекСтрока.СуммаНДС <> 0)И(ТекСтрока.ТипОплаты = Перечисления.ТипыОплатЧекаККМ.Наличные)И(ОтбиратьСчетУчета) Тогда
			Значение = ТекСтрока.СтавкаНДС;
			НоваяСтрока = ТаблицаПоСтавкам.Добавить();
			НоваяСтрока.СтавкаНДС = ТекСтрока.СтавкаНДС;
			НоваяСтрока.СуммаНДС = ТекСтрока.СуммаНДС;
			
			Результат.СуммаНДС = Результат.СуммаНДС + ТекСтрока.СуммаНДС;
			Результат.Всего = Результат.Всего + ТекСтрока.Сумма;
			
		КонецЕсли;	
	КонецЦикла;
	
	ТаблицаПоСтавкам.Сортировать("СтавкаНДС Убыв");
	
	Результат.ТаблицаПоСтавкам = ТаблицаПоСтавкам;
	
	Результат.ЕдинаяДляТЧ = ?(ТаблицаПоСтавкам.Количество()<2, Истина, Ложь);
	Если Результат.ЕдинаяДляТЧ Тогда
		Если ТаблицаПоСтавкам.Количество() = 0 Тогда
			Результат.Значение = Перечисления.СтавкиНДС.БезНДС;
		ИначеЕсли ТаблицаПоСтавкам.Количество() = 1 Тогда
			Результат.Значение = ТаблицаПоСтавкам[0].СтавкаНДС;
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции	

Функция ЕдиныеСтавкиВДокументеОснованииПКО(ДокументСсылка) Экспорт
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Дата, Организация, КорСчет, ДокументОснование");
	КорСчет = ЗначенияРеквизитов.КорСчет;
	ДокументОснование = ЗначенияРеквизитов.ДокументОснование;
	
	Счет20531 = БухгалтерскийУчет.СчетПоКоду("205.31", ЗначенияРеквизитов.Дата, ЗначенияРеквизитов.Организация);
	
	СписокСчетовОтбора = Новый Массив;
	Если КорСчет = Счет20531 Тогда
		СписокСчетовОтбора.Добавить(Счет20531);
		СписокСчетовОтбора.Добавить(ПланыСчетов.ЕПСБУ.ПустаяСсылка());
	Иначе
		СписокСчетовОтбора.Добавить(КорСчет);
	КонецЕсли;	
	
	Возврат ЕдиныеСтавкиВДокументеОтчетПоКассовойСмене(ДокументОснование, СписокСчетовОтбора);
КонецФункции

Функция ТаблицаНоменклатурыЧекаККМ(ДокументСсылка, ОтменаОплаты = Ложь, НомерЧека = 0) Экспорт
	
	Результат = ПустаяТаблицаНоменклатурыЧекаККМ();
	ТипДокумента = ПодключаемоеОборудованиеБГУВызовСервера.ТипДокумента(ДокументСсылка);	
	
	Если (ТипДокумента = 16) ИЛИ (ТипДокумента = 15) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяССылка) КАК Номенклатура,
		               |	ЧекККМИсправительныйНоменклатураЧекаККМ.НаименованиеНоменклатуры КАК Наименование,
		               |	ЧекККМИсправительныйНоменклатураЧекаККМ.Количество КАК Количество,
		               |	ЧекККМИсправительныйНоменклатураЧекаККМ.Цена КАК Цена,
		               |	ЧекККМИсправительныйНоменклатураЧекаККМ.Сумма КАК Сумма,
		               |	ЧекККМИсправительныйНоменклатураЧекаККМ.СтавкаНДС КАК СтавкаНДС,
		               |	ЧекККМИсправительныйНоменклатураЧекаККМ.СуммаНДС КАК СуммаНДС,
		               |	ЧекККМИсправительныйНоменклатураЧекаККМ.Всего КАК Всего,
		               |	ИСТИНА КАК СуммаВключаетНДС,
		               |	ЧекККМИсправительныйНоменклатураЧекаККМ.НомерСекции КАК НомерСекции,
		               |	ЧекККМИсправительныйНоменклатураЧекаККМ.ЕдиницаИзмерения КАК ЕдиницаИзмеренияПредметаРасчета,
		               |	"""" КАК СодержаниеУслуги,
		               |	ЛОЖЬ КАК ЕстьСодержаниеУслуги,
		               |	ЧекККМИсправительныйНоменклатураЧекаККМ.ПризнакСпособаРасчета КАК ПризнакСпособаРасчета,
		               |	ЧекККМИсправительныйНоменклатураЧекаККМ.ПризнакПредметаРасчета КАК ПризнакПредметаРасчета,
		               |	ЧекККМИсправительныйНоменклатураЧекаККМ.ЦенаСоСкидками КАК ЦенаСоСкидками,
		               |	"""" КАК ДополнениеНоменклатуры,
		               |	ЛОЖЬ КАК ЕстьДополнениеНоменклатуры,
		               |	ЧекККМИсправительныйНоменклатураЧекаККМ.СуммаСкидок КАК СуммаСкидок,
		               |	ЧекККМИсправительныйНоменклатураЧекаККМ.КодСтраныПроисхожденияТовара КАК КодСтраныПроисхожденияТовара,
		               |	ЧекККМИсправительныйНоменклатураЧекаККМ.НомерТаможеннойДекларации КАК НомерТаможеннойДекларации,
		               |	ЧекККМИсправительныйНоменклатураЧекаККМ.Штрихкод КАК Штрихкод,
		               |	ЧекККМИсправительныйНоменклатураЧекаККМ.НомерСтроки КАК НомерСтроки
		               |ИЗ
		               |	Документ.ЧекККМИсправительный.НоменклатураЧекаККМ КАК ЧекККМИсправительныйНоменклатураЧекаККМ
		               |ГДЕ
		               |	ЧекККМИсправительныйНоменклатураЧекаККМ.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", ДокументСсылка); 
		РезультатЗапроса = Запрос.Выполнить();
		СписокНоменклатуры = РезультатЗапроса.Выгрузить();
		
		Результат = СписокНоменклатуры;
	
	ИначеЕсли (ТипДокумента = 14) Тогда
		
		ТекЧекККМ = ДокументСсылка.ЧекиККМ.Получить(НомерЧека - 1);
		КлючЧека = ТекЧекККМ.КлючЧека;
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЧекиККМДляРеестраПлатежейНоменклатураЧековККМ.Номенклатура КАК Номенклатура,
		               |	ВЫРАЗИТЬ(ЧекиККМДляРеестраПлатежейНоменклатураЧековККМ.Номенклатура КАК Справочник.Номенклатура).НаименованиеДляЧекаККМ КАК Наименование,
		               |	ЧекиККМДляРеестраПлатежейНоменклатураЧековККМ.Количество КАК Количество,
		               |	ЧекиККМДляРеестраПлатежейНоменклатураЧековККМ.Сумма / ЧекиККМДляРеестраПлатежейНоменклатураЧековККМ.Количество КАК Цена,
		               |	ЧекиККМДляРеестраПлатежейНоменклатураЧековККМ.Сумма КАК Сумма,
		               |	ЧекиККМДляРеестраПлатежейНоменклатураЧековККМ.СтавкаНДС КАК СтавкаНДС,
		               |	ЧекиККМДляРеестраПлатежейНоменклатураЧековККМ.СуммаНДС КАК СуммаНДС,
		               |	ЧекиККМДляРеестраПлатежейНоменклатураЧековККМ.Сумма КАК Всего,
		               |	ИСТИНА КАК СуммаВключаетНДС,
		               |	0 КАК НомерСекции,
		               |	ЧекиККМДляРеестраПлатежейНоменклатураЧековККМ.НомерСтроки КАК НомерСтроки,
		               |	ВЫРАЗИТЬ(ЧекиККМДляРеестраПлатежейНоменклатураЧековККМ.Номенклатура КАК Справочник.Номенклатура).ЕдиницаИзмерения КАК ЕдиницаИзмеренияПредметаРасчета,
		               |	"""" КАК СодержаниеУслуги,
		               |	ИСТИНА КАК ЕстьСодержаниеУслуги,
		               |	ЧекиККМДляРеестраПлатежейНоменклатураЧековККМ.ПризнакСпособаРасчета КАК ПризнакСпособаРасчета,
		               |	ВЫРАЗИТЬ(ЧекиККМДляРеестраПлатежейНоменклатураЧековККМ.Номенклатура КАК Справочник.Номенклатура).ПризнакПредметаРасчета КАК ПризнакПредметаРасчета,
		               |	ЧекиККМДляРеестраПлатежейНоменклатураЧековККМ.Сумма / ЧекиККМДляРеестраПлатежейНоменклатураЧековККМ.Количество КАК ЦенаСоСкидками,
		               |	ЧекиККМДляРеестраПлатежейНоменклатураЧековККМ.ДополнениеНаименованияНоменклатуры КАК ДополнениеНоменклатуры,
		               |	ИСТИНА КАК ЕстьДополнениеНоменклатуры,
