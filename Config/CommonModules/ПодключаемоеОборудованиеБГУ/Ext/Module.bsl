Процедура СформироватьДанныеДляЧековККМПоПлательщикам(КассаККМ, СписокПлательщиков, СписокКонтрагентов, РасшифровкаПлатежейДляЧеков, ДанныеЧеков, 
	СистемаНалогообложения, НаправлятьПокупателямЭлектронныеЧеки, РодительскаяПлата) Экспорт
	
	ПризнакСпособаРасчета = КассаККМ.ПризнакСпособаРасчетаПлатежа;
	ЗаполнятьФИОРебенка = КассаККМ.ЗаполнятьФИОРебенкаВЧекахККМ;
	ЗаполнятьФИОПлательщика = КассаККМ.ЗаполнятьФИОПлательщикаВЧекахККМ;
	
	Если НЕ ЗначениеЗаполнено(ПризнакСпособаРасчета) Тогда
		ПризнакСпособаРасчета = Перечисления.ПризнакиСпособаРасчета.Аванс;
	КонецЕсли;	
	
	Для каждого ТекПлательщик Из СписокПлательщиков Цикл
		Плательщик = ТекПлательщик.Плательщик;
		
		НоваяШапка = ДанныеЧеков.ШапкаЧеков.Добавить();
		КлючЧека = Новый УникальныйИдентификатор;
		НоваяШапка.КлючЧека = КлючЧека;
		НоваяШапка.ТипРасчета = Перечисления.ТипыРасчетаДенежнымиСредствами.ПриходДенежныхСредств;
		НоваяШапка.Контрагент = Плательщик;
		НоваяШапка.Плательщик = Плательщик;
		НоваяШапка.Сумма = ТекПлательщик.Сумма;
		НоваяШапка.СистемаНалогообложенияЧекаККМ = СистемаНалогообложения;
		
		СуммаНоменклатуры = 0;
		
		ПараметрыОтбораПлательщика = Новый Структура("Плательщик", ТекПлательщик.Плательщик); 	
		МассивКонтрагентов = СписокКонтрагентов.НайтиСтроки(ПараметрыОтбораПлательщика);
		
		Для каждого ТекКонтрагент Из МассивКонтрагентов Цикл
			
			ПараметрыОтбора = Новый Структура("Контрагент", ТекКонтрагент.Контрагент); 	
		
			МассивНоменклатураЧека = РасшифровкаПлатежейДляЧеков.НайтиСтроки(ПараметрыОтбора);
			Для Каждого СтрокаНоменклатурыЧека Из МассивНоменклатураЧека Цикл
				НоваяНоменклатура = ДанныеЧеков.НоменклатураЧеков.Добавить();
				НоваяНоменклатура.КлючЧека = КлючЧека;
				НоваяНоменклатура.Номенклатура = СтрокаНоменклатурыЧека.Номенклатура;
				НоваяНоменклатура.Сумма = ?(СтрокаНоменклатурыЧека.СуммаОплатыЭСП > 0, СтрокаНоменклатурыЧека.СуммаОплатыЭСП, СтрокаНоменклатурыЧека.Сумма);
				НоваяНоменклатура.Количество = 1;
				НоваяНоменклатура.СтавкаНДС = СтавкаНДСИзНоменклатуры(ПризнакСпособаРасчета, СтрокаНоменклатурыЧека.Номенклатура);;
				НоваяНоменклатура.СуммаНДС = СуммаНДСПоСтавкеВСоставеСуммы(НоваяНоменклатура.СтавкаНДС, НоваяНоменклатура.Сумма);
				
				ДополнениеНаименованияНоменклатуры = "";
				Если РодительскаяПлата Тогда
					Если ЗаполнятьФИОРебенка Тогда
						ДополнениеНаименованияНоменклатуры = "(" + НаименованиеКонтрагентаПлательщика(СтрокаНоменклатурыЧека.Контрагент)+ ")";
					КонецЕсли;
					Если ЗаполнятьФИОПлательщика Тогда
						КтоОплатил = Плательщик;
						ДополнениеНаименованияНоменклатуры = ДополнениеНаименованияНоменклатуры + НСтр("ru = ' от '") + НаименованиеКонтрагентаПлательщика(КтоОплатил);
					КонецЕсли;	
				Иначе
					Договор = СтрокаНоменклатурыЧека.Договор;
					
					ДополнениеНаименованияНоменклатуры = "";
					Если ЗначениеЗаполнено(СтрокаНоменклатурыЧека.Контрагент) И ЗначениеЗаполнено(Договор) Тогда
						ОснованиеОплаты = СокрЛП(Договор.ВидОбязательства)+ НСтр("ru = ' от '") + Формат(Договор.ДатаДоговора, "ДФ=dd.MM.yyyy") + НСтр("ru = ' № '") + СокрЛП(Договор.НомерДоговора);
						ДополнениеНаименованияНоменклатуры = НСтр("ru = 'от '") + НаименованиеКонтрагентаПлательщика(СтрокаНоменклатурыЧека.Контрагент)+ НСтр("ru = ' Основание: '")+ОснованиеОплаты;
					КонецЕсли;
					
					Если ЗначениеЗаполнено(Договор) Тогда
						Если ЗначениеЗаполнено(Договор.ПризнакСпособаРасчета) Тогда
							ПризнакСпособаРасчета = Договор.ПризнакСпособаРасчета;
						КонецЕсли;	
					КонецЕсли;	
				КонецЕсли;	
				
				НоваяНоменклатура.ДополнениеНаименованияНоменклатуры = СокрЛП(ДополнениеНаименованияНоменклатуры);
				НоваяНоменклатура.ПризнакСпособаРасчета = ПризнакСпособаРасчета;
				
				СуммаНоменклатуры = СуммаНоменклатуры + СтрокаНоменклатурыЧека.Сумма; 
			КонецЦикла;	
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СформироватьДанныеДляЧековККМПоКонтрагентам(КассаККМ, СписокПлательщиков, СписокКонтрагентов, РасшифровкаПлатежейДляЧеков, ДанныеЧеков,
	СистемаНалогообложения, НаправлятьПокупателямЭлектронныеЧеки, РодительскаяПлата) Экспорт
	
	ПризнакСпособаРасчета = КассаККМ.ПризнакСпособаРасчетаПлатежа;
	ЗаполнятьФИОРебенка = КассаККМ.ЗаполнятьФИОРебенкаВЧекахККМ;
	ЗаполнятьФИОПлательщика = КассаККМ.ЗаполнятьФИОПлательщикаВЧекахККМ;
	
	Если НЕ ЗначениеЗаполнено(ПризнакСпособаРасчета) Тогда
		ПризнакСпособаРасчета = Перечисления.ПризнакиСпособаРасчета.Аванс;
	КонецЕсли;	
	
	Для каждого ТекКонтрагент Из СписокКонтрагентов Цикл
		ПараметрыОтбора = Новый Структура("Контрагент", ТекКонтрагент.Контрагент); 	
		
		НоваяШапка = ДанныеЧеков.ШапкаЧеков.Добавить();
		КлючЧека = Новый УникальныйИдентификатор;
		НоваяШапка.КлючЧека = КлючЧека;
		НоваяШапка.Контрагент = ТекКонтрагент.Контрагент;
		НоваяШапка.ТипРасчета = Перечисления.ТипыРасчетаДенежнымиСредствами.ПриходДенежныхСредств;
		НоваяШапка.Сумма = ТекКонтрагент.Сумма;
		НоваяШапка.СистемаНалогообложенияЧекаККМ = СистемаНалогообложения;
		
		ПараметрыОтбораПлательщика = Новый Структура("Контрагент", ТекКонтрагент.Контрагент); 	
		МассивПлательщиков = СписокПлательщиков.НайтиСтроки(ПараметрыОтбораПлательщика);
		Плательщик = ТекКонтрагент.Контрагент;
		НоваяШапка.Плательщик = Плательщик;
		
		СуммаНоменклатуры = 0;
		МассивНоменклатураЧека = РасшифровкаПлатежейДляЧеков.НайтиСтроки(ПараметрыОтбора);
		Для Каждого СтрокаНоменклатурыЧека Из МассивНоменклатураЧека Цикл
			НоваяНоменклатура = ДанныеЧеков.НоменклатураЧеков.Добавить();
			НоваяНоменклатура.КлючЧека = КлючЧека;
			НоваяНоменклатура.Номенклатура = СтрокаНоменклатурыЧека.Номенклатура;
			НоваяНоменклатура.Сумма = ?(СтрокаНоменклатурыЧека.СуммаОплатыЭСП > 0, СтрокаНоменклатурыЧека.СуммаОплатыЭСП, СтрокаНоменклатурыЧека.Сумма);
			НоваяНоменклатура.Количество = 1;
			НоваяНоменклатура.СтавкаНДС = СтавкаНДСИзНоменклатуры(ПризнакСпособаРасчета, СтрокаНоменклатурыЧека.Номенклатура);
			НоваяНоменклатура.СуммаНДС = СуммаНДСПоСтавкеВСоставеСуммы(НоваяНоменклатура.СтавкаНДС, НоваяНоменклатура.Сумма);
			
			ДополнениеНаименованияНоменклатуры = "";
			Если РодительскаяПлата Тогда
				Если ЗаполнятьФИОРебенка Тогда
					ДополнениеНаименованияНоменклатуры = "(" + НаименованиеКонтрагентаПлательщика(СтрокаНоменклатурыЧека.Контрагент)+ ")";	
				КонецЕсли;
				Если ЗаполнятьФИОПлательщика Тогда
					КтоОплатил = ?(МассивПлательщиков.Количество()>0, МассивПлательщиков[0].Плательщик, Справочники.Контрагенты.ПустаяСсылка());
					ДополнениеНаименованияНоменклатуры = ДополнениеНаименованияНоменклатуры + НСтр("ru = ' от '") + НаименованиеКонтрагентаПлательщика(КтоОплатил);
				КонецЕсли;	
			Иначе
				Договор = СтрокаНоменклатурыЧека.Договор;
				
				ДополнениеНаименованияНоменклатуры = "";
				Если ЗначениеЗаполнено(СтрокаНоменклатурыЧека.Контрагент) И ЗначениеЗаполнено(Договор) Тогда
					ОснованиеОплаты = СокрЛП(Договор.ВидОбязательства)+ НСтр("ru = ' от '") + Формат(Договор.ДатаДоговора, "ДФ=dd.MM.yyyy") + НСтр("ru = ' № '") + СокрЛП(Договор.НомерДоговора);
					ДополнениеНаименованияНоменклатуры = НСтр("ru = 'от '") + НаименованиеКонтрагентаПлательщика(СтрокаНоменклатурыЧека.Контрагент)+ НСтр("ru = ' Основание: '")+ОснованиеОплаты;
				КонецЕсли;	
			КонецЕсли;	
			
			НоваяНоменклатура.ДополнениеНаименованияНоменклатуры = СокрЛП(ДополнениеНаименованияНоменклатуры);
			НоваяНоменклатура.ПризнакСпособаРасчета = ПризнакСпособаРасчета;
			
			СуммаНоменклатуры = СуммаНоменклатуры + СтрокаНоменклатурыЧека.Сумма; 
		КонецЦикла;	
		
	КонецЦикла;	
	
КонецПроцедуры

Процедура СформироватьДанныеДляЧековККМПоКаждомуПлатежуКонтрагентов(КассаККМ, СписокПлательщиков, СписокКонтрагентов, РасшифровкаПлатежейДляЧеков, ДанныеЧеков,
	СистемаНалогообложения, НаправлятьПокупателямЭлектронныеЧеки, РодительскаяПлата) Экспорт
	
	ПризнакСпособаРасчета = КассаККМ.ПризнакСпособаРасчетаПлатежа;
	ЗаполнятьФИОРебенка = КассаККМ.ЗаполнятьФИОРебенкаВЧекахККМ;
	ЗаполнятьФИОПлательщика = КассаККМ.ЗаполнятьФИОПлательщикаВЧекахККМ;
	
	Если НЕ ЗначениеЗаполнено(ПризнакСпособаРасчета) Тогда
		ПризнакСпособаРасчета = Перечисления.ПризнакиСпособаРасчета.Аванс;
	КонецЕсли;	
	
	Для каждого ТекКонтрагент Из СписокКонтрагентов Цикл
		ПараметрыОтбора = Новый Структура("КлючСтроки", ТекКонтрагент.КлючСтроки); 	
		
		НоваяШапка = ДанныеЧеков.ШапкаЧеков.Добавить();
		КлючЧека = ТекКонтрагент.КлючСтроки;
		НоваяШапка.КлючЧека = КлючЧека;
		НоваяШапка.Контрагент = ТекКонтрагент.Контрагент;
		НоваяШапка.ТипРасчета = Перечисления.ТипыРасчетаДенежнымиСредствами.ПриходДенежныхСредств;
		НоваяШапка.Сумма = ТекКонтрагент.Сумма;
		НоваяШапка.СистемаНалогообложенияЧекаККМ = СистемаНалогообложения;
		НоваяШапка.Плательщик = ТекКонтрагент.Контрагент;
		
		СуммаНоменклатуры = 0;
		МассивНоменклатураЧека = РасшифровкаПлатежейДляЧеков.НайтиСтроки(ПараметрыОтбора);
		Для Каждого СтрокаНоменклатурыЧека Из МассивНоменклатураЧека Цикл
			НоваяНоменклатура = ДанныеЧеков.НоменклатураЧеков.Добавить();
			НоваяНоменклатура.КлючЧека = КлючЧека;
			НоваяНоменклатура.Номенклатура = СтрокаНоменклатурыЧека.Номенклатура;
			НоваяНоменклатура.Сумма = ?(СтрокаНоменклатурыЧека.СуммаОплатыЭСП > 0, СтрокаНоменклатурыЧека.СуммаОплатыЭСП, СтрокаНоменклатурыЧека.Сумма);
			НоваяНоменклатура.Количество = 1;
			НоваяНоменклатура.СтавкаНДС = СтавкаНДСИзНоменклатуры(ПризнакСпособаРасчета, СтрокаНоменклатурыЧека.Номенклатура);
			НоваяНоменклатура.СуммаНДС = СуммаНДСПоСтавкеВСоставеСуммы(НоваяНоменклатура.СтавкаНДС, НоваяНоменклатура.Сумма);
			
			ДополнениеНаименованияНоменклатуры = "";
			Если РодительскаяПлата Тогда
				Если ЗаполнятьФИОРебенка Тогда
					ДополнениеНаименованияНоменклатуры = "(" + НаименованиеКонтрагентаПлательщика(СтрокаНоменклатурыЧека.Контрагент)+ ")";	
				КонецЕсли;
				Если ЗаполнятьФИОПлательщика Тогда
					КтоОплатил = ТекКонтрагент.Контрагент;
					Если ЗначениеЗаполнено(СтрокаНоменклатурыЧека.Ребенок) Тогда
						ПараметрыОтбораПлательщика = Новый Структура("Контрагент", ТекКонтрагент.Контрагент);
						МассивПлательщиков = СписокПлательщиков.НайтиСтроки(ПараметрыОтбораПлательщика);
						Для каждого ТекПлательщик Из МассивПлательщиков Цикл
							КтоОплатил = ТекПлательщик.Плательщик;
							Прервать;
						КонецЦикла;	
					КонецЕсли;
					ДополнениеНаименованияНоменклатуры = ДополнениеНаименованияНоменклатуры + НСтр("ru = ' от '") + НаименованиеКонтрагентаПлательщика(КтоОплатил);
				КонецЕсли;
				Договор = СтрокаНоменклатурыЧека.Договор;
			Иначе
				Договор = СтрокаНоменклатурыЧека.Договор;
				
				ДополнениеНаименованияНоменклатуры = "";
				Если ЗначениеЗаполнено(СтрокаНоменклатурыЧека.Контрагент) И ЗначениеЗаполнено(Договор) Тогда
					ОснованиеОплаты = СокрЛП(Договор.ВидОбязательства)+ НСтр("ru = ' от '") + Формат(Договор.ДатаДоговора, "ДФ=dd.MM.yyyy") + НСтр("ru = ' № '") + СокрЛП(Договор.НомерДоговора);
					ДополнениеНаименованияНоменклатуры = НСтр("ru = 'от '") + НаименованиеКонтрагентаПлательщика(СтрокаНоменклатурыЧека.Контрагент)+ НСтр("ru = ' Основание: '")+ОснованиеОплаты;
				КонецЕсли;
				
			КонецЕсли;	
			Если ЗначениеЗаполнено(Договор) Тогда
				Если ЗначениеЗаполнено(Договор.ПризнакСпособаРасчета) Тогда
					ПризнакСпособаРасчета = Договор.ПризнакСпособаРасчета;
				КонецЕсли;	
			КонецЕсли;	
			
			НоваяНоменклатура.ДополнениеНаименованияНоменклатуры = СокрЛП(ДополнениеНаименованияНоменклатуры);
			НоваяНоменклатура.ПризнакСпособаРасчета = ПризнакСпособаРасчета;
			
			СуммаНоменклатуры = СуммаНоменклатуры + СтрокаНоменклатурыЧека.Сумма; 
		КонецЦикла;	
		
	КонецЦикла;	
	
КонецПроцедуры

Процедура СформироватьДанныеДляЧековККМПоГруппеКонтрагентов(КассаККМ, ТаблицаДокументовОснованийЧекаККМ, ДанныеЧеков,
	СистемаНалогообложения, НаправлятьПокупателямЭлектронныеЧеки) Экспорт

	ЗаполнятьФИОРебенка = КассаККМ.ЗаполнятьФИОРебенкаВЧекахККМ;
	ЗаполнятьФИОПлательщика = КассаККМ.ЗаполнятьФИОПлательщикаВЧекахККМ;
	
	ПроводкиПоДокументамПередачи = ПодключаемоеОборудованиеБГУ.ПроводкиПоДокументамПередачи(ТаблицаДокументовОснованийЧекаККМ, "ДокументОснованиеЧековККМ");
	ДанныеДляЧековККМПоДокументамРеализации = ДанныеДляЧековККМПоДокументамРеализации(ТаблицаДокументовОснованийЧекаККМ);
	ДанныеПоКонтрагентамИДоговорам = ДанныеДляЧековККМПоДокументамРеализации.Скопировать();
	ДанныеПоКонтрагентамИДоговорам.Свернуть("Регистратор, Контрагент, Договор, Ребенок, Студент", "Всего");
	
	Для каждого ТекСтрока Из ТаблицаДокументовОснованийЧекаККМ Цикл
		Если ЗначениеЗаполнено(ТекСтрока.ДокументОснованиеЧековККМ) Тогда
			Если ТекСтрока.ДокументОснованиеЧековККМ.Проведен Тогда
				ДополнительныйКонтрольДокументаОснованияхЧекаККМ(ТекСтрока.ДокументОснованиеЧековККМ);
				СформироватьДанныеЧековККМДляДокументаРеализации(ДанныеЧеков, ПроводкиПоДокументамПередачи, ДанныеДляЧековККМПоДокументамРеализации, 
					ДанныеПоКонтрагентамИДоговорам, ТекСтрока.ДокументОснованиеЧековККМ, ТекСтрока.НомерСтроки, 
					СистемаНалогообложения, НаправлятьПокупателямЭлектронныеЧеки, ЗаполнятьФИОРебенка, ЗаполнятьФИОПлательщика);
			Иначе	
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru='В строке %1 не проведен документ-основание чеков ККМ'"),
						СокрЛП(ТекСтрока.НомерСтроки));
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,,);
			КонецЕсли;	
		Иначе
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='В строке %1 не заполнен документ-основание чеков ККМ'"),
					СокрЛП(ТекСтрока.НомерСтроки));
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,,);
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры

Процедура ДополнительныйКонтрольДокументаОснованияхЧекаККМ(ДокументОснованиеЧековККМ)
	Если ТипЗнч(ДокументОснованиеЧековККМ) = Тип("ДокументСсылка.НачислениеДоходов") Тогда
		Если НЕ ЗначениеЗаполнено(ДокументОснованиеЧековККМ.Номенклатура) Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='У документа %1 не заполнена номенклатура, которая необходима для формирования сведений чека ККМ'"),
					СокрЛП(ДокументОснованиеЧековККМ));
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,,);
		КонецЕсли;	
	ИначеЕсли ТипЗнч(ДокументОснованиеЧековККМ) = Тип("ДокументСсылка.НачислениеЗаУслугиОбразования") Тогда
		Если НЕ ЗначениеЗаполнено(ДокументОснованиеЧековККМ.Номенклатура) Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='У документа %1 не заполнена номенклатура, которая необходима для формирования сведений чека ККМ'"),
					СокрЛП(ДокументОснованиеЧековККМ));
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,,);
		КонецЕсли;	
	ИначеЕсли ТипЗнч(ДокументОснованиеЧековККМ) = Тип("ДокументСсылка.НачислениеСтудентамЗаПрочиеУслуги") Тогда
		Если НЕ ЗначениеЗаполнено(ДокументОснованиеЧековККМ.НачислениеЗаУслугу) Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='У документа %1 не заполнен реквизит ""Начисление за услугу"" с указанием номенклатуры, которая необходима для формирования сведений чека ККМ'"),
					СокрЛП(ДокументОснованиеЧековККМ));
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,,);
		Иначе
			Если НЕ ЗначениеЗаполнено(ДокументОснованиеЧековККМ.НачислениеЗаУслугу.Номенклатура) Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru='У документа %1 у значения реквизита ""Начисление за услугу"" не заполнена номенклатура, которая необходима для формирования сведений чека ККМ'"),
						СокрЛП(ДокументОснованиеЧековККМ));
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,,);
			КонецЕсли;	
		КонецЕсли;	
	ИначеЕсли ТипЗнч(ДокументОснованиеЧековККМ) = Тип("ДокументСсылка.НачислениеРодительскойПлаты") Тогда
		Если НЕ ЗначениеЗаполнено(ДокументОснованиеЧековККМ.ГруппаДетскогоУчреждения) Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='У документа %1 не заполнен реквизит ""Группа ДДУ"" с указанием номенклатуры, которая необходима для формирования сведений чека ККМ'"),
					СокрЛП(ДокументОснованиеЧековККМ));
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,,);
		Иначе
			Если НЕ ЗначениеЗаполнено(ДокументОснованиеЧековККМ.ГруппаДетскогоУчреждения.Номенклатура) Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru='У документа %1 у значения реквизита ""Группа ДДУ"" не заполнена номенклатура, которая необходима для формирования сведений чека ККМ'"),
						СокрЛП(ДокументОснованиеЧековККМ));
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,,);
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры

Процедура СформироватьДанныеЧековККМДляДокументаРеализации(ДанныеЧеков, ПроводкиПоДокументамПередачи, 
	 ДанныеДляЧековККМПоДокументамРеализации, ДанныеПоКонтрагентамИДоговорам, ДокОснованиеЧекаККМ, 
	 НомерСтрокиДокОснованиеЧекаККМ, СистемаНалогообложения, НаправлятьПокупателямЭлектронныеЧеки,
	 ЗаполнятьФИОРебенка, ЗаполнятьФИОПлательщика)

	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Регистратор", ДокОснованиеЧекаККМ);
	
	МассивДанныхКонтрагентовДоговоров = ДанныеПоКонтрагентамИДоговорам.НайтиСтроки(ПараметрыОтбора);
	
	Для каждого ТекСтрока Из МассивДанныхКонтрагентовДоговоров Цикл
		Контрагент = ТекСтрока.Контрагент;
		Договор = ТекСтрока.Договор;
		
		ПлатятЗаКонтрагента = Контрагент;
		Если ЗначениеЗаполнено(ТекСтрока.Ребенок) Тогда
			Если ЗначениеЗаполнено(ТекСтрока.Ребенок.Контрагент) Тогда
				ПлатятЗаКонтрагента = ТекСтрока.Ребенок.Контрагент;
			Иначе
				ПлатятЗаКонтрагента = Контрагент;
			КонецЕсли;
		ИначеЕсли ЗначениеЗаполнено(ТекСтрока.Студент) Тогда
			Если ЗначениеЗаполнено(ТекСтрока.Студент.Контрагент) Тогда
				ПлатятЗаКонтрагента = ТекСтрока.Студент.Контрагент;
			Иначе
				ПлатятЗаКонтрагента = Контрагент;
			КонецЕсли;
		КонецЕсли;	
		
		НоваяШапка = ДанныеЧеков.ШапкаЧеков.Добавить();
		КлючЧека = Новый УникальныйИдентификатор;
		НоваяШапка.КлючЧека = КлючЧека;
		НоваяШапка.ТипРасчета = Перечисления.ТипыРасчетаДенежнымиСредствами.ПриходДенежныхСредств;
		НоваяШапка.Контрагент = ПлатятЗаКонтрагента;
		НоваяШапка.Плательщик = Контрагент;
		НоваяШапка.Договор = Договор;
		НоваяШапка.Сумма = 0;
		НоваяШапка.СуммаРеализации = ТекСтрока.Всего;
		НоваяШапка.СистемаНалогообложенияЧекаККМ = СистемаНалогообложения;
		
		//определение зачета аванса
		ПараметрыОтбораЗачетаАвансовКонтрагентов = Новый Структура;
		ПараметрыОтбораЗачетаАвансовКонтрагентов.Вставить("Регистратор", ДокОснованиеЧекаККМ);
		ПараметрыОтбораЗачетаАвансовКонтрагентов.Вставить("СчетДт", Планысчетов.ЕПСБУ.АвансыПолученные);
		ПараметрыОтбораЗачетаАвансовКонтрагентов.Вставить("СубконтоДт1", Контрагент);
		ПараметрыОтбораЗачетаАвансовКонтрагентов.Вставить("СубконтоДт2", Договор);
		
		МассивПроводок = ПроводкиПоДокументамПередачи.НайтиСтроки(ПараметрыОтбораЗачетаАвансовКонтрагентов);
		
		СуммаЗачетаАванса = 0;
		Для каждого СтрокаЗачетаАванса Из МассивПроводок Цикл
			СуммаЗачетаАванса = СуммаЗачетаАванса + СтрокаЗачетаАванса.Сумма;
		КонецЦикла;
		НоваяШапка.СуммаПредоплаты = СуммаЗачетаАванса;
		
		Если ТекСтрока.Всего = СуммаЗачетаАванса Тогда
			ПризнакСпособаРасчета = Перечисления.ПризнакиСпособаРасчета.ПередачаСПолнойОплатой;
		Иначе	
			ПризнакСпособаРасчета = Перечисления.ПризнакиСпособаРасчета.ПередачаБезОплаты;
		КонецЕсли;
		
		ПараметрыОтбораКонтрагентов = Новый Структура;
		ПараметрыОтбораКонтрагентов.Вставить("Регистратор", ДокОснованиеЧекаККМ);
		ПараметрыОтбораКонтрагентов.Вставить("Контрагент", Контрагент);
		ПараметрыОтбораКонтрагентов.Вставить("Договор", Договор);
		
		МассивДанныхНоменклатуры = ДанныеДляЧековККМПоДокументамРеализации.НайтиСтроки(ПараметрыОтбораКонтрагентов);
		
		Для каждого СтрокаНоменклатурыЧека Из МассивДанныхНоменклатуры Цикл
			НоваяНоменклатура = ДанныеЧеков.НоменклатураЧеков.Добавить();
			НоваяНоменклатура.КлючЧека = КлючЧека;
			НоваяНоменклатура.Номенклатура = СтрокаНоменклатурыЧека.Номенклатура;
			НоваяНоменклатура.Сумма = СтрокаНоменклатурыЧека.Всего;
			НоваяНоменклатура.Количество = СтрокаНоменклатурыЧека.Количество;
			НоваяНоменклатура.СтавкаНДС = СтрокаНоменклатурыЧека.СтавкаНДС;
			НоваяНоменклатура.СуммаНДС = СтрокаНоменклатурыЧека.СуммаНДС;
			
			ДополнениеНаименованияНоменклатуры = "";
			Если НЕ (ПлатятЗаКонтрагента = Контрагент) Тогда
				Если ЗаполнятьФИОРебенка Тогда
					ДополнениеНаименованияНоменклатуры = "(" + НаименованиеКонтрагентаПлательщика(ПлатятЗаКонтрагента)+ ")";
				КонецЕсли;
				Если ЗаполнятьФИОПлательщика Тогда
					КтоОплатил = Контрагент;
					ДополнениеНаименованияНоменклатуры = ДополнениеНаименованияНоменклатуры + НСтр("ru = ' (плательщик: '") + НаименованиеКонтрагентаПлательщика(КтоОплатил)+ НСтр("ru = ')'");
				КонецЕсли;	
			Иначе
				Договор = СтрокаНоменклатурыЧека.Договор;
				
				ДополнениеНаименованияНоменклатуры = "";
				Если ЗначениеЗаполнено(СтрокаНоменклатурыЧека.Контрагент) И ЗначениеЗаполнено(Договор) Тогда
					ОснованиеОплаты = СокрЛП(Договор.ВидОбязательства)+ НСтр("ru = ' от '") + Формат(Договор.ДатаДоговора, "ДФ=dd.MM.yyyy") + НСтр("ru = ' № '") + СокрЛП(Договор.НомерДоговора);
					ДополнениеНаименованияНоменклатуры = НСтр("ru = '(плательщик: '") + НаименованиеКонтрагентаПлательщика(СтрокаНоменклатурыЧека.Контрагент)+
						НСтр("ru = ' Основание: '")+ОснованиеОплаты+ НСтр("ru = ')'");	
				КонецЕсли;	
			КонецЕсли;	
			
			НоваяНоменклатура.ДополнениеНаименованияНоменклатуры = СокрЛП(ДополнениеНаименованияНоменклатуры);
			НоваяНоменклатура.ПризнакСпособаРасчета = ПризнакСпособаРасчета;
			
		КонецЦикла;	
		
	КонецЦикла;	
	
