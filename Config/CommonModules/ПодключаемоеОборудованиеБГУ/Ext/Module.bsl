Функция ИсточникДанныхИсправляемогоЧекаККМ(ДокументОснование, НомерЧека = Неопределено) Экспорт
	Результат = Новый Структура("ИсточникДанных, ДанныеЧекаККМ", 0, Неопределено);
	ИсточникДанных = 0;
	
	Если ЗначениеЗаполнено(ДокументОснование) Тогда
		Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЧекиККМДляРеестраПлатежей") Тогда
			Если НомерЧека = Неопределено Тогда
				ДанныеФискальнойОперации = Неопределено;
			Иначе	
				ДанныеФискальнойОперации = ДанныеЧекаГруппыПлатежей(ДокументОснование,,НомерЧека);
				Если ЗначениеЗаполнено(ДанныеФискальнойОперации.ИдентификаторЗаписи) Тогда
					ИсточникДанных = 1;
				Иначе
					ИсточникДанных = 2;
					
					ОбщиеПараметры = ПодготовитьДанныеДляПробитияЧекаИзСпискаЧеков(ДокументОснование, ДокументОснование.Ссылка, НомерЧека);
					ДанныеФискальнойОперации = ДанныеЧекаПоОбщимПараметрам(ДокументОснование, НомерЧека, ОбщиеПараметры);
				КонецЕсли;	
			КонецЕсли;
		Иначе	
			ДанныеФискальнойОперации = ДанныеЧека(ДокументОснование);
			Если ЗначениеЗаполнено(ДанныеФискальнойОперации.ИдентификаторЗаписи) Тогда
				ИсточникДанных = 1;
			Иначе
				ИсточникДанных = 2;
				
				ОбщиеПараметры  = ПодготовитьДанныеДляПробитияЧека(ДокументОснование, ДокументОснование.Ссылка);
				ДанныеФискальнойОперации = ДанныеЧекаПоОбщимПараметрам(ДокументОснование, , ОбщиеПараметры);
			КонецЕсли;	
		КонецЕсли;
		
		Результат.ИсточникДанных = ИсточникДанных;
		Результат.ДанныеЧекаККМ = ДанныеФискальнойОперации;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция ДанныеЧекаПоОбщимПараметрам(ДокументОснование, НомерЧека = 0, ОбщиеПараметрыЧека) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("НомерЧекаККМ", 0);
	Результат.Вставить("НомерСменыККМ", 0);
	
	Результат.Вставить("ДатаЧекаККМ", Дата(1,1,1));
	Результат.Вставить("ФискальныйПризнак", "");
	Результат.Вставить("СуммаЧекаККМ", 0);
	Результат.Вставить("ИдентификаторЗаписи", "");
	Результат.Вставить("ТипРасчета", Перечисления.ТипыРасчетаДенежнымиСредствами.ПустаяСсылка());
	Результат.Вставить("НомерСменыККМ", 0);
	Результат.Вставить("ОплатаНаличные", 0);
	Результат.Вставить("ОплатаПостоплата", 0);
	Результат.Вставить("ОплатаПредоплата", 0);
	Результат.Вставить("ОплатаЭлектронно", 0);
	Результат.Вставить("ОплатаВстречноеПредоставление", 0);
	Результат.Вставить("ЗаводскойНомерФН", "");
	Результат.Вставить("РегистрационныйНомерККТ", "");
	Результат.Вставить("ДополнительныйРеквизит", "");
	Результат.Вставить("АдресСайтаПроверки", "");
	Результат.Вставить("ТекстовыеДанныеXML", "");
	Результат.Вставить("Контрагент", Справочники.Контрагенты.ПустаяСсылка());
	Результат.Вставить("Договор", Справочники.Договоры.ПустаяСсылка());
	Результат.Вставить("СистемаНалогообложенияЧекаККМ", Перечисления.ВидыСистемыНалогообложенияЧекаККМ.ПустаяСсылка());
	Результат.Вставить("ПараметрыДоговораПлатежногоАгента", Справочники.ПараметрыДоговораПлатежногоАгента.ПустаяСсылка());
	Результат.Вставить("Телефон", "");
	Результат.Вставить("АдресЭП", "");
	Результат.Вставить("ОтказКлиентаОтСохраненияТелефонаEmail", Истина);
	
	Если ДокументОснование.НомерЧекаККМ = 0 Тогда
		Результат = Неопределено;
	Иначе
		Если НомерЧека > 0 Тогда
			ЗаполнитьЗначенияСвойств(Результат, ДокументОснование.ЧекиККМ[НомерЧека-1]); 
		Иначе	
			ЗаполнитьЗначенияСвойств(Результат, ДокументОснование);
			ТипДокумента = ПодключаемоеОборудованиеБГУВызовСервера.ТипДокумента(ДокументОснование);
			Если (ТипДокумента = 5) ИЛИ (ТипДокумента = 6) ИЛИ (ТипДокумента = 7) Тогда
				Результат.ДатаЧекаККМ = ДокументОснование.Дата;	
			КонецЕсли;	
		КонецЕсли;
		
		СуммаЧека = 0;
		ОплатаНаличные = 0;
		ОплатаЭлектронно = 0;
		ОплатаПостоплата = 0;
		ОплатаПредоплата = 0;
		
		Для каждого ТекСтрока Из ОбщиеПараметрыЧека.ТаблицаОплат Цикл
			СуммаЧека = СуммаЧека + ТекСтрока.Сумма;
			Если ТекСтрока.ТипОплаты = Перечисления.ТипыОплатыККТ.Наличные Тогда
				ОплатаНаличные = ОплатаНаличные + ТекСтрока.Сумма;
			ИначеЕсли ТекСтрока.ТипОплаты = Перечисления.ТипыОплатыККТ.Электронно Тогда
				ОплатаЭлектронно = ОплатаЭлектронно + ТекСтрока.Сумма;
			ИначеЕсли ТекСтрока.ТипОплаты = Перечисления.ТипыОплатыККТ.Предоплата Тогда
				ОплатаПредоплата = ОплатаПредоплата + ТекСтрока.Сумма;
			ИначеЕсли ТекСтрока.ТипОплаты = Перечисления.ТипыОплатыККТ.Постоплата Тогда
				ОплатаПостоплата = ОплатаПостоплата + ТекСтрока.Сумма;
			КонецЕсли;	
		КонецЦикла;	
		
		Результат.ОплатаНаличные = ОплатаНаличные;
		Результат.ОплатаЭлектронно = ОплатаЭлектронно;
		Результат.ОплатаПостоплата = ОплатаПостоплата;
		Результат.ОплатаПредоплата = ОплатаПредоплата;
		Результат.СуммаЧекаККМ = СуммаЧека;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

Функция ЗаключительныйЧекИсправительный(ДокументОснование, НомерЧекаККМ = 0) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Документы.ЧекККМИсправительный.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ЧекККМИсправительный.Ссылка КАК Ссылка
	               |ПОМЕСТИТЬ ИсправительныеЧеки
	               |ИЗ
	               |	Документ.ЧекККМИсправительный КАК ЧекККМИсправительный
	               |ГДЕ
	               |	ЧекККМИсправительный.ДокументОснование = &ДокументОснование
	               |	И ЧекККМИсправительный.НомерИсправляемогоЧекаККМ = &НомерЧекаККМ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ИсправительныеЧеки.Ссылка КАК Ссылка,
	               |	ФискальныеОперации.ИдентификаторЗаписи КАК ИдентификаторЗаписи,
	               |	ФискальныеОперации.НомерЧекаККМ КАК НомерЧекаККМ,
	               |	ФискальныеОперации.Дата КАК ДатаЧекаККМ,
	               |	ФискальныеОперации.Сумма КАК Сумма,
	               |	ИСТИНА КАК Исправление
	               |ПОМЕСТИТЬ ИсправительныеЧекиСФискальнойОперацией
	               |ИЗ
	               |	ИсправительныеЧеки КАК ИсправительныеЧеки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФискальныеОперации КАК ФискальныеОперации
	               |		ПО ИсправительныеЧеки.Ссылка = ФискальныеОперации.ДокументОснование
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ФискальныеОперации.ДокументОснование КАК Ссылка,
	               |	ФискальныеОперации.ИдентификаторЗаписи КАК ИдентификаторЗаписи,
	               |	ФискальныеОперации.НомерЧекаККМ КАК НомерЧекаККМ,
	               |	ФискальныеОперации.Дата КАК ДатаЧекаККМ,
	               |	ФискальныеОперации.Сумма КАК Сумма,
	               |	ЛОЖЬ КАК Исправление
	               |ПОМЕСТИТЬ КассовыеЧеки
	               |ИЗ
	               |	РегистрСведений.ФискальныеОперации КАК ФискальныеОперации
	               |ГДЕ
	               |	ФискальныеОперации.ДокументОснование = &ДокументОснование
	               |	И ФискальныеОперации.НомерЧекаККМ = &НомерЧекаККМ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ИсправительныеЧекиСФискальнойОперацией.Ссылка КАК Ссылка,
	               |	ИсправительныеЧекиСФискальнойОперацией.ИдентификаторЗаписи КАК ИдентификаторЗаписи,
	               |	ИсправительныеЧекиСФискальнойОперацией.НомерЧекаККМ КАК НомерЧекаККМ,
	               |	ИсправительныеЧекиСФискальнойОперацией.ДатаЧекаККМ КАК ДатаЧекаККМ,
	               |	ИсправительныеЧекиСФискальнойОперацией.Сумма КАК Сумма,
	               |	ИсправительныеЧекиСФискальнойОперацией.Исправление КАК Исправление
	               |ИЗ
	               |	ИсправительныеЧекиСФискальнойОперацией КАК ИсправительныеЧекиСФискальнойОперацией
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	КассовыеЧеки.Ссылка,
	               |	КассовыеЧеки.ИдентификаторЗаписи,
	               |	КассовыеЧеки.НомерЧекаККМ,
	               |	КассовыеЧеки.ДатаЧекаККМ,
	               |	КассовыеЧеки.Сумма,
	               |	КассовыеЧеки.Исправление
	               |ИЗ
	               |	КассовыеЧеки КАК КассовыеЧеки
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДатаЧекаККМ УБЫВ";
	
	Если НомерЧекаККМ = 0 Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЧекККМИсправительный.НомерИсправляемогоЧекаККМ = &НомерЧекаККМ", "ИСТИНА = ИСТИНА");	
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ФискальныеОперации.НомерЧекаККМ = &НомерЧекаККМ", "ИСТИНА = ИСТИНА");	
	КонецЕсли;	
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	Запрос.УстановитьПараметр("НомерЧекаККМ", НомерЧекаККМ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если Выборка.Исправление Тогда
			Результат = Выборка.Ссылка;
		КонецЕсли;	
	КонецЕсли;	
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
КонецФункции	

Функция УстаревшиеСтавкиНДС() Экспорт
	
	УстаревшиеСтавкиНДС = Новый Массив;
	УстаревшиеСтавкиНДС.Добавить(Перечисления.СтавкиНДС.НДС18);
	УстаревшиеСтавкиНДС.Добавить(Перечисления.СтавкиНДС.НДС18_118);
	
	Возврат УстаревшиеСтавкиНДС;
	
КонецФункции

Функция СтрокаБезСлужебныхСимволов(ТекстСтроки) Экспорт
	ТекстСтроки = СтрЗаменить(ТекстСтроки, Символы.ВК, " ");
	ТекстСтроки = СтрЗаменить(ТекстСтроки, Символы.ВТаб, " ");
	ТекстСтроки = СтрЗаменить(ТекстСтроки, Символы.НПП, " ");
	ТекстСтроки = СтрЗаменить(ТекстСтроки, Символы.ПС, " ");
	ТекстСтроки = СтрЗаменить(ТекстСтроки, Символы.ПФ, " ");
	ТекстСтроки = СтрЗаменить(ТекстСтроки, Символы.Таб, " ");
	
	Возврат ТекстСтроки;
КонецФункции

Функция ТекстДополненияНаименованияНоменклатурыДляКонтрагентаИДоговора(Контрагент, Договор, ФИОПолностью = Истина) Экспорт
	ОснованиеОплаты = СокрЛП(Договор.ВидОбязательства)+ НСтр("ru = ' от '") + Формат(Договор.ДатаДоговора, "ДФ=dd.MM.yyyy") + НСтр("ru = ' № '") + СокрЛП(Договор.НомерДоговора);
	Результат = НСтр("ru = 'от '") + НаименованиеКонтрагентаПлательщика(Контрагент, ФИОПолностью)+ НСтр("ru = ' Основание: '")+ОснованиеОплаты;	
	
	Возврат Результат;
КонецФункции

Функция ДанныеСотрудникаФизическогоЛица(ФизическоеЛицо, ДатаСведений) Экспорт
	Результат = Новый Структура("Период, СсылкаНаОбъект, Фамилия, Имя, Отчество, ФамилияИО, Должность");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	Контрагенты.Ссылка КАК Контрагент
	               |ПОМЕСТИТЬ КонтрагентыФЛ
	               |ИЗ
	               |	Справочник.Контрагенты КАК Контрагенты
	               |ГДЕ
	               |	Контрагенты.ЮридическоеФизическоеЛицо = &ФизическоеЛицо
	               |	И Контрагенты.ПометкаУдаления = ЛОЖЬ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	Сотрудники.Ссылка КАК Сотрудник,
	               |	КонтрагентыФЛ.Контрагент КАК Контрагент
	               |ИЗ
	               |	КонтрагентыФЛ КАК КонтрагентыФЛ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК Сотрудники
	               |		ПО КонтрагентыФЛ.Контрагент = Сотрудники.Контрагент";
	
	Запрос.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицо);
	Выборка = Запрос.Выполнить().Выбрать();	
	
	Если Выборка.Следующий() Тогда
		ФамилияИО = Справочники.Контрагенты.ФамилияИО(Выборка.Контрагент, Истина, ДатаСведений);
	
		Сотрудник = Выборка.Сотрудник;
		Результат.Вставить("СсылкаНаОбъект", Сотрудник);
		Результат.Вставить("Период", ДатаСведений);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(Результат, Истина);
		Результат.Вставить("ФамилияИО", ФамилияИО);
	Иначе
		ФамилияИО = Справочники.Контрагенты.ФамилияИО(Выборка.Контрагент, Истина, ДатаСведений);
		
		Результат.Вставить("ФамилияИО", ФамилияИО);
		Результат.Вставить("Должность", Справочники.Должности.ПустаяСсылка());
		Результат.Вставить("Период", ДатаСведений);
		Результат.Вставить("СсылкаНаОбъект", Неопределено);
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

Функция ДолжностьДляЧекаККМ(ФизическоеЛицо, ДатаСведений) Экспорт
	Результат = "";
	
	Если ДатаСведений = Дата(1,1,1) Тогда
		ДатаСведений = ТекущаяДатаСеанса();
	КонецЕсли;	
	
	ДанныеСотрудникаФизическогоЛица = ДанныеСотрудникаФизическогоЛица(ФизическоеЛицо, ДатаСведений);
	Должность = ДанныеСотрудникаФизическогоЛица.Должность;
	Если ЗначениеЗаполнено(Должность) Тогда
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Должность, "ДолжностьДляЧекаККМ");
		Результат = ЗначенияРеквизитов.ДолжностьДляЧекаККМ;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

Функция ФизическоеЛицоКассира(КассирСсылка) Экспорт
	Результат = Справочники.ФизическиеЛица.ПустаяСсылка();
	
	Если ТипЗнч(КассирСсылка) = Тип("СправочникСсылка.Пользователи") Тогда
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(КассирСсылка, "ФизическоеЛицо");
		Результат = ЗначенияРеквизитов.ФизическоеЛицо;
	ИначеЕсли ТипЗнч(КассирСсылка) = Тип("СправочникСсылка.Сотрудники") Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	Сотрудники.Контрагент.ЮридическоеФизическоеЛицо КАК ФизическоеЛицо
		               |ИЗ
		               |	Справочник.Сотрудники КАК Сотрудники
		               |ГДЕ
		               |	Сотрудники.Ссылка = &Ссылка";
		Запрос.УстановитьПараметр("Ссылка", КассирСсылка);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Результат = Выборка.ФизическоеЛицо;
		КонецЕсли;	
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

Функция ИсправительныйЧекККМОперацииНепримененияККТ(ДокументСсылка) экспорт
	Результат = Документы.ЧекККМИсправительный.ПустаяСсылка();
	
	Если (ТипЗнч(ДокументСсылка) = Тип("Структура"))
		ИЛИ НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Результат;
	КонецЕсли;	
	
	ВидОперации = Перечисления.ВидыИсправительныхЧековККМБГУ.НеприменениеККТ;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЧекККМИсправительныйДокументыОснованияКорректировки.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ЧекККМИсправительный.ДокументыОснованияКорректировки КАК ЧекККМИсправительныйДокументыОснованияКорректировки
	               |ГДЕ
	               |	ЧекККМИсправительныйДокументыОснованияКорректировки.ДокументБезЧекаККМ = &ДокументБезЧекаККМ
	               |	И ЧекККМИсправительныйДокументыОснованияКорректировки.Ссылка.ПометкаУдаления = ЛОЖЬ
	               |	И ЧекККМИсправительныйДокументыОснованияКорректировки.Ссылка.ВидОперации = &ВидОперации";
	Запрос.УстановитьПараметр("ДокументБезЧекаККМ", ДокументСсылка);
	Запрос.УстановитьПараметр("ВидОперации", ВидОперации);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;	
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

Функция СтавкаНДСПоСтавкеНДСЧислом(СтавкаНДСЧислом) Экспорт
	
	Если СтавкаНДСЧислом = Неопределено Тогда
		Возврат Перечисления.СтавкиНДС.БезНДС;
	ИначеЕсли СтавкаНДСЧислом = 0 Тогда
		Возврат Перечисления.СтавкиНДС.НДС0;
	ИначеЕсли СтавкаНДСЧислом = 110 Тогда
		Возврат Перечисления.СтавкиНДС.НДС10_110;
	ИначеЕсли СтавкаНДСЧислом = 118 Тогда
		Возврат Перечисления.СтавкиНДС.НДС18_118;
	ИначеЕсли СтавкаНДСЧислом = 120 Тогда
		Возврат Перечисления.СтавкиНДС.НДС20_120;
	ИначеЕсли СтавкаНДСЧислом = 105 Тогда
		Возврат Перечисления.СтавкиНДС.НДС5_105;
	ИначеЕсли СтавкаНДСЧислом = 107 Тогда
		Возврат Перечисления.СтавкиНДС.НДС7_107;
	ИначеЕсли СтавкаНДСЧислом = 122 Тогда
		Возврат Перечисления.СтавкиНДС.НДС22_122;	
	ИначеЕсли СтавкаНДСЧислом = 10 Тогда
		Возврат Перечисления.СтавкиНДС.НДС10;
	ИначеЕсли СтавкаНДСЧислом = 18 Тогда
		Возврат Перечисления.СтавкиНДС.НДС18;
	ИначеЕсли СтавкаНДСЧислом = 20 Тогда
		Возврат Перечисления.СтавкиНДС.НДС20;
	ИначеЕсли СтавкаНДСЧислом = 5 Тогда
		Возврат Перечисления.СтавкиНДС.НДС5;
	ИначеЕсли СтавкаНДСЧислом = 7 Тогда
		Возврат Перечисления.СтавкиНДС.НДС7;
	ИначеЕсли СтавкаНДСЧислом = 22 Тогда
		Возврат Перечисления.СтавкиНДС.НДС22;	
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции // СтавкаНДСПоСтавкеНДСЧислом()

Функция ЧекККМДляЮЛилиИП(Контрагент, ДатаЧека) Экспорт
	Результат = Новый Структура;
	
	Результат.Вставить("Заполнить", Ложь);
	Результат.Вставить("Получатель", "");
	Результат.Вставить("ПолучательИНН", "");
	
	Если ЗначениеЗаполнено(Контрагент) Тогда
		Если Контрагент.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
			Результат.Заполнить = Истина;
			Результат.ПолучательИНН = Контрагент.ИНН;
			Если ЗначениеЗаполнено(Контрагент.НаименованиеСокращенное) Тогда
				Результат.Получатель = Контрагент.НаименованиеСокращенное; 
			Иначе	
				Если ЗначениеЗаполнено(Контрагент.ЮридическоеФизическоеЛицо) Тогда
					ЮридическоеФизическоеЛицо = Контрагент.ЮридическоеФизическоеЛицо;
					Результат.Получатель = ЮридическоеФизическоеЛицо.НаименованиеПолное;
				КонецЕсли;	
			КонецЕсли;	
		ИначеЕсли Контрагент.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
			Если ЗначениеЗаполнено(Контрагент.ЮридическоеФизическоеЛицо) Тогда
				ЮридическоеФизическоеЛицо = Контрагент.ЮридическоеФизическоеЛицо;
				Если ЗначениеЗаполнено(ЮридическоеФизическоеЛицо.ОГРНИП)
					ИЛИ ЗначениеЗаполнено(ЮридическоеФизическоеЛицо.СвидетельствоСерияНомер) Тогда
					Результат.Заполнить = Истина;
					
					Если ЗначениеЗаполнено(Контрагент.НаименованиеСокращенное) Тогда
						Результат.ПолучательИНН = Контрагент.ИНН;
					Иначе	
						Результат.ПолучательИНН = ЮридическоеФизическоеЛицо.ИНН;
					КонецЕсли;	
					Если ЗначениеЗаполнено(Контрагент.НаименованиеСокращенное) Тогда
						Результат.Получатель = Контрагент.НаименованиеСокращенное;
					Иначе
						Результат.Получатель = Контрагент.Наименование;
					КонецЕсли;
					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

Функция ЕстьПравоНастройкиККТ() Экспорт
	
	Результат = Истина;
	
	Результат = Пользователи.РолиДоступны("ДобавлениеИзменениеПодключаемогоОборудования") ИЛИ
		Пользователи.РолиДоступны("ПолныеПрава");
	
	Возврат Результат;
	
КонецФункции

Функция ДанныеЧекаККМНаЗачетАвансаПоДокументамОснованиям(ДатаСведений, ТаблицаДокументовОснованийЧекаККМ) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("ТипПередачи", 0);
	Результат.Вставить("СуммаПредоплаты", 0);
	
	СуммаВсехДокументов = 0;
	СуммаВсехАвансов = 0;
	
	ПроводкиПоДокументамПередачи = ПроводкиПоДокументамПередачи(ТаблицаДокументовОснованийЧекаККМ);
	
	ЕстьОшибки = Ложь;
	Для каждого ТекСтрока Из ТаблицаДокументовОснованийЧекаККМ Цикл
		Если ЗначениеЗаполнено(ТекСтрока.ДокументОснованиеЧекаККМ) Тогда
			Если ТекСтрока.ДокументОснованиеЧекаККМ.Проведен Тогда
				ТекСтрока.СуммаДокументаОснования = ТекСтрока.ДокументОснованиеЧекаККМ.СуммаДокумента;
				
				ПараметрыОтбора = Новый Структура;
				ПараметрыОтбора.Вставить("Регистратор", ТекСтрока.ДокументОснованиеЧекаККМ);
				
				МассивПроводок = ПроводкиПоДокументамПередачи.НайтиСтроки(ПараметрыОтбора);
				Если МассивПроводок.Количество() = 0 Тогда
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru='Бухгалтерская операция документа %1 в строке %2 не имеет проводок'"),
							СокрЛП(ТекСтрока.ДокументОснованиеЧекаККМ), СокрЛП(ТекСтрока.НомерСтроки));
					
					ТекСтрока.ОписаниеОшибки = ТекстСообщения;
				Иначе
					ПараметрыОтбора = Новый Структура;
					ПараметрыОтбора.Вставить("Регистратор", ТекСтрока.ДокументОснованиеЧекаККМ);
					ПараметрыОтбора.Вставить("СчетДт", Планысчетов.ЕПСБУ.АвансыПолученные);
					МассивПроводокЗачетАванса = ПроводкиПоДокументамПередачи.НайтиСтроки(ПараметрыОтбора);
					СуммаЗачетаАванса = 0;
					Для каждого ТекПроводка Из МассивПроводокЗачетАванса Цикл
						СуммаЗачетаАванса = СуммаЗачетаАванса + ТекПроводка.Сумма;
					КонецЦикла;
					ТекСтрока.СуммаПредоплаты = СуммаЗачетаАванса;
				КонецЕсли;
				
				СуммаВсехДокументов = СуммаВсехДокументов + ТекСтрока.СуммаДокументаОснования;
				СуммаВсехАвансов = СуммаВсехАвансов + ТекСтрока.СуммаПредоплаты;
				
			Иначе
				ЕстьОшибки = Истина;
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru='Документ %1 в строке %2 не проведен'"),
						СокрЛП(ТекСтрока.ДокументОснованиеЧекаККМ), СокрЛП(ТекСтрока.НомерСтроки));
				ТекСтрока.ОписаниеОшибки = ТекстСообщения;
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
	
	Если НЕ ЕстьОшибки Тогда
		Результат.СуммаПредоплаты = СуммаВсехАвансов;
		
		Если СуммаВсехДокументов > 0 Тогда
			Если СуммаВсехАвансов = 0 Тогда
				Результат.ТипПередачи = 0;
			ИначеЕсли СуммаВсехАвансов = СуммаВсехДокументов Тогда
				Результат.ТипПередачи = 1;
			ИначеЕсли СуммаВсехАвансов < СуммаВсехДокументов Тогда
				Результат.ТипПередачи = 2;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;
	
	Результат.Вставить("ТаблицаПредоплаты", ТаблицаДокументовОснованийЧекаККМ);
	Возврат Результат;
КонецФункции

Функция ПроводкиПоДокументамПередачи(ДокументыПередачи, ИмяРеквизитаТаблицы = "") Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументыПередачи", ДокументыПередачи);
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	Таб.ДокументОснованиеЧекаККМ КАК ДокументПередачи
	               |ПОМЕСТИТЬ ДокументыПередачи
	               |ИЗ
	               |	&ДокументыПередачи КАК Таб
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт КАК СчетДт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.КПСДт КАК КПСДт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.КЭКДт КАК КЭКДт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.КФО КАК КФО,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт КАК СчетКт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.КПСКт КАК КПСКт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.КЭККт КАК КЭККт,
	               |	СУММА(ЖурналПроводокЕПСБУДвиженияССубконто.Сумма) КАК Сумма,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор КАК Регистратор,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.Содержание КАК Содержание,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт1 КАК СубконтоДт1,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт2 КАК СубконтоДт2,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт3 КАК СубконтоДт3,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.ПодразделениеДт КАК ПодразделениеДт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.ПодразделениеКт КАК ПодразделениеКт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1 КАК СубконтоКт1,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт2 КАК СубконтоКт2,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт3 КАК СубконтоКт3
	               |ИЗ
	               |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	               |			,
	               |			,
	               |			Регистратор В
	               |				(ВЫБРАТЬ
	               |					ДокументыПередачи.ДокументПередачи
	               |				ИЗ
	               |					ДокументыПередачи),
	               |			,
	               |			) КАК ЖурналПроводокЕПСБУДвиженияССубконто
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ДокументыПередачи КАК ДокументыПередачи
	               |		ПО ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор = ДокументыПередачи.ДокументПередачи
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.КПСДт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.КЭКДт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.КФО,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.КПСКт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.КЭККт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.Содержание,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт2,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт1,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт3,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.ПодразделениеКт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.ПодразделениеДт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт3,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт2";
	Если ЗначениеЗаполнено(ИмяРеквизитаТаблицы) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Таб.ДокументОснованиеЧекаККМ КАК ДокументПередачи", "Таб."+ИмяРеквизитаТаблицы+" КАК ДокументПередачи");	
	КонецЕсли;	
	Запрос.Текст = ТекстЗапроса;
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
КонецФункции	

Функция ВидимостьКомандККТПоТипуКассыККМ(КассаККМ) Экспорт
	Результат = Истина;
	Если ЗначениеЗаполнено(КассаККМ) Тогда
		ПодключаемоеОборудование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(КассаККМ, "ПодключаемоеОборудование");
		Если ЗначениеЗаполнено(ПодключаемоеОборудование) Тогда
			ТипОборудования = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПодключаемоеОборудование, "ТипОборудования");
			Если ТипОборудования = Перечисления.ТипыПодключаемогоОборудования.ККТ Или
				 ТипОборудования = Перечисления.ТипыПодключаемогоОборудования.ОблачнаяККТ Тогда
				Результат = Истина;
			Иначе
				Результат = Ложь;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

Функция НомерТелефонаДляЭлектронногоЧекаКорректен(НомерТелефона) Экспорт
	Результат = Истина;
	
	ПроверяемоеЗначение = СокрЛП(НомерТелефона);
	
	ДлинаПроверяемоеЗначение = СтрДлина(ПроверяемоеЗначение);
	
	Если ДлинаПроверяемоеЗначение = 0 Тогда
		Возврат Результат;
	КонецЕсли;	
	
	Если ДлинаПроверяемоеЗначение < 10 Тогда
		Результат = Ложь;
	КонецЕсли;
	
	Для н = 1 По ДлинаПроверяемоеЗначение Цикл
		Если Найти("01234567890", Сред(ПроверяемоеЗначение, н, 1)) = 0 Тогда
			Результат = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;	
	
	Возврат Результат;
КонецФункции	

Функция АдресЭлектроннойПочтаДляЭлектронногоЧекаКорректен(АдресЭлектроннойПочты) Экспорт
	Результат = Истина;
	
	ПроверяемоеЗначение = СокрЛП(АдресЭлектроннойПочты);
	
	ДлинаПроверяемоеЗначение = СтрДлина(ПроверяемоеЗначение);
	
	Если ДлинаПроверяемоеЗначение = 0 Тогда
		Возврат Результат;
	КонецЕсли;	
	
	ЕстьКоммерческоеЭт = Ложь;
	ЕстьТочка = Ложь;
	Для н = 1 По ДлинаПроверяемоеЗначение Цикл
		Если Найти("@", Сред(ПроверяемоеЗначение, н, 1)) > 0 Тогда
			ЕстьКоммерческоеЭт = Истина;
		ИначеЕсли Найти(".", Сред(ПроверяемоеЗначение, н, 1)) > 0 Тогда 
			ЕстьТочка = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ ЕстьКоммерческоеЭт ИЛИ НЕ ЕстьТочка Тогда
		Результат = Ложь;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

Функция КассирДляПКО(КассаККМ) Экспорт
