Функция ДозаполнениеСпискаНоменклатуры(СписокНоменклатуры)
	Шт = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("796");
	
	НомерСтроки = 1;
	Для каждого ТекТовар Из СписокНоменклатуры Цикл
		Если НЕ ЗначениеЗаполнено(ТекТовар.Наименование) Тогда
			Если ЗначениеЗаполнено(ТекТовар.Номенклатура) Тогда
				Если ЗначениеЗаполнено(ТекТовар.Номенклатура.НаименованиеПолное) Тогда
					ТекТовар.Наименование = ТекТовар.Номенклатура.НаименованиеПолное;
				Иначе
					ТекТовар.Наименование = ТекТовар.Номенклатура.Наименование;
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;	
		Если ЗначениеЗаполнено(ТекТовар.Номенклатура) Тогда
			Если ТипЗнч(ТекТовар.Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда 
				Если ЗначениеЗаполнено(ТекТовар.Номенклатура.НаименованиеДляЧекаККМ) Тогда
					Если ТекТовар.ЕстьДополнениеНоменклатуры Тогда
						ТекТовар.Наименование = СокрЛП(ТекТовар.Наименование + " " + ТекТовар.ДополнениеНоменклатуры);
					КонецЕсли;
				Иначе
					Если ТекТовар.ЕстьСодержаниеУслуги Тогда
						Если ЗначениеЗаполнено(ТекТовар.СодержаниеУслуги) Тогда
							Если ТекТовар.ЕстьДополнениеНоменклатуры Тогда
								ТекТовар.Наименование = СокрЛП(ТекТовар.СодержаниеУслуги + " " + ТекТовар.ДополнениеНоменклатуры);
							Иначе
								ТекТовар.Наименование = ТекТовар.СодержаниеУслуги;
							КонецЕсли;
						Иначе
							Если ТекТовар.ЕстьДополнениеНоменклатуры Тогда
								ТекТовар.Наименование = СокрЛП(ТекТовар.Наименование + " " + ТекТовар.ДополнениеНоменклатуры);
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ТекТовар.ЕдиницаИзмеренияПредметаРасчета) Тогда
			ТекТовар.ЕдиницаИзмеренияПредметаРасчета = Шт;
		КонецЕсли;
		
		ТекТовар.НомерСтроки = НомерСтроки;
		СуммаВключаетНДС = ТекТовар.СуммаВключаетНДС;
		Если НЕ СуммаВключаетНДС Тогда
			ТекТовар.СтавкаНДС = ?(ТекТовар.СтавкаНДС = Перечисления.СтавкиНДС.ПустаяСсылка(), Перечисления.СтавкиНДС.БезНДС, ТекТовар.СтавкаНДС);
			ТекТовар.Цена = ?(ТекТовар.Количество = 0, 0, Окр(ТекТовар.Всего/ТекТовар.Количество, 2));
			ТекТовар.Сумма = ТекТовар.Всего;
		Иначе
			ТекТовар.Цена = Окр(ТекТовар.Цена,2);
		КонецЕсли;
		
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;	
	
	Возврат СписокНоменклатуры;
КонецФункции

Процедура ЗаполнитьОплатуПриПробитииЧекаККМ(ДокументОбъект, ТипДокумента, ОбщиеПараметры, СуммаНоменклатуры)
	
	ДокументСсылка = ДокументОбъект.Ссылка;
	ТипПередачи = 0;
	
	Если ТипДокумента = 15 Тогда
		Если ДокументСсылка.СуммаОплатыНаличными > 0 Тогда
			// Наличные
			СтрокаОплаты = Новый Структура();
			СтрокаОплаты.Вставить("ТипОплаты", Перечисления.ТипыОплатыККТ.Наличные);
			СтрокаОплаты.Вставить("Наименование", НСтр("ru = 'Наличные'"));
			СтрокаОплаты.Вставить("Сумма", ДокументСсылка.СуммаОплатыНаличными);
			ОбщиеПараметры.ТаблицаОплат.Добавить(СтрокаОплаты);
		КонецЕсли;	
		Если ДокументСсылка.СуммаОплатыЭлектронно > 0 Тогда
			// Платежная карта или безналичный расчет
			СтрокаОплаты = Новый Структура();
			СтрокаОплаты.Вставить("ТипОплаты", Перечисления.ТипыОплатыККТ.Электронно);
			СтрокаОплаты.Вставить("Наименование", НСтр("ru = 'Электронно'"));
			СтрокаОплаты.Вставить("Сумма", ДокументСсылка.СуммаОплатыЭлектронно);
			ОбщиеПараметры.ТаблицаОплат.Добавить(СтрокаОплаты);
		КонецЕсли;
		Если ДокументСсылка.СуммаПредоплаты > 0 Тогда
			// зачет аванса
			СтрокаОплаты = Новый Структура();
			СтрокаОплаты.Вставить("ТипОплаты", Перечисления.ТипыОплатыККТ.Предоплата);
			СтрокаОплаты.Вставить("Наименование", НСтр("ru = 'Зачет аванса'"));
			СтрокаОплаты.Вставить("Сумма", ДокументСсылка.СуммаПредоплаты);
			ОбщиеПараметры.ТаблицаОплат.Добавить(СтрокаОплаты);
		КонецЕсли;
		Если ДокументСсылка.СуммаПостоплаты > 0 Тогда
			// Постоплата
			СтрокаОплаты = Новый Структура();
			СтрокаОплаты.Вставить("ТипОплаты", Перечисления.ТипыОплатыККТ.Постоплата);
			СтрокаОплаты.Вставить("Наименование", НСтр("ru = 'Постоплата'"));
			СтрокаОплаты.Вставить("Сумма", ДокументСсылка.СуммаПостоплаты);
			ОбщиеПараметры.ТаблицаОплат.Добавить(СтрокаОплаты);
		КонецЕсли;
		Если ДокументСсылка.СуммаОплатыВстречнымПредоставлением > 0 Тогда
			// Встречное предоставление
			СтрокаОплаты = Новый Структура();
			СтрокаОплаты.Вставить("ТипОплаты", Перечисления.ТипыОплатыККТ.ВстречноеПредоставление);
			СтрокаОплаты.Вставить("Наименование", НСтр("ru = 'Встречное предоставление'"));
			СтрокаОплаты.Вставить("Сумма", ДокументСсылка.СуммаОплатыВстречнымПредоставлением);
			ОбщиеПараметры.ТаблицаОплат.Добавить(СтрокаОплаты);
		КонецЕсли;
		
		Возврат;
	ИначеЕсли ТипДокумента = 7 Тогда	
		ТипПередачи = ДокументОбъект.ТипПередачи;
	КонецЕсли;
	
	СуммаЗачетаАванса = 0;
	Если ТипДокумента = 1
		ИЛИ ТипДокумента = 3
		ИЛИ ТипДокумента = 7
		ИЛИ ТипДокумента = 8
		ИЛИ ТипДокумента = 17 Тогда
		СуммаЗачетаАванса = ДокументСсылка.ДокументыЧекаККМ.Итог("СуммаПредоплаты");
	КонецЕсли;
	
	СуммаОплатыВстречнымПредоставлением = 0;
	Если (ТипДокумента = 7) И (ТипПередачи = 3) Тогда
		СуммаОплатыВстречнымПредоставлением = ДокументСсылка.ДокументыЧекаККМ.Итог("СуммаВстречногоПредоставления");
	КонецЕсли;
	Если СуммаОплатыВстречнымПредоставлением > 0 Тогда
		// Встречное предоставление
		СтрокаОплаты = Новый Структура();
		СтрокаОплаты.Вставить("ТипОплаты", Перечисления.ТипыОплатыККТ.ВстречноеПредоставление);
		СтрокаОплаты.Вставить("Наименование", НСтр("ru = 'Встречное предоставление'"));
		СтрокаОплаты.Вставить("Сумма", СуммаОплатыВстречнымПредоставлением);
		ОбщиеПараметры.ТаблицаОплат.Добавить(СтрокаОплаты);
		
		Если СуммаЗачетаАванса > 0 Тогда
			// зачет аванса
			СтрокаОплаты = Новый Структура();
			СтрокаОплаты.Вставить("ТипОплаты", Перечисления.ТипыОплатыККТ.Предоплата);
			СтрокаОплаты.Вставить("Наименование", НСтр("ru = 'Зачет аванса'"));
			СтрокаОплаты.Вставить("Сумма", СуммаЗачетаАванса);
			ОбщиеПараметры.ТаблицаОплат.Добавить(СтрокаОплаты);
		КонецЕсли;	
		
		СуммаРазница = СуммаНоменклатуры - СуммаЗачетаАванса - СуммаОплатыВстречнымПредоставлением;
		
		Если СуммаРазница > 0 Тогда
			// Постоплата
			СтрокаОплаты = Новый Структура();
			СтрокаОплаты.Вставить("ТипОплаты", Перечисления.ТипыОплатыККТ.Постоплата);
			СтрокаОплаты.Вставить("Наименование", НСтр("ru = 'Постоплата'"));
			СтрокаОплаты.Вставить("Сумма", СуммаРазница);
			ОбщиеПараметры.ТаблицаОплат.Добавить(СтрокаОплаты);
		КонецЕсли;	
		
		Возврат;
	КонецЕсли;	
		
	СуммаРазница = СуммаНоменклатуры - СуммаЗачетаАванса - ДокументСсылка.СуммаДокумента;
	
	ОплачиваетсяНаличными = Истина;
	ОплачиваетсяПлатежнойКартой = Ложь;
	
	Если ТипДокумента = 3 ИЛИ ТипДокумента = 4 Тогда
		ОплачиваетсяПлатежнойКартой = Истина;
	ИначеЕсли ТипДокумента = 5 ИЛИ ТипДокумента = 6 Тогда
		Если ДокументОбъект.ФормаОплаты = 1 Или ДокументОбъект.ФормаОплаты = 2 Тогда
			ОплачиваетсяПлатежнойКартой = Истина;
			ОплачиваетсяНаличными = Ложь;
		КонецЕсли;	
	КонецЕсли;
	
	ЭтоПостоплата = Ложь;
	Если ТипДокумента = 1 
		ИЛИ ТипДокумента = 3 Тогда
		ЭтоПостоплата = ДокументСсылка.ЭтоПостоплата;
	ИначеЕсли ТипДокумента = 5 
		ИЛИ ТипДокумента = 6 Тогда
		Если ДокументСсылка.ПризнакСпособаРасчетаЧекаККМ = Перечисления.ПризнакиСпособаРасчета.ПередачаБезОплаты Тогда
			ЭтоПостоплата = Истина;
			ОплачиваетсяПлатежнойКартой = Ложь;
			ОплачиваетсяНаличными = Ложь;
		КонецЕсли;
	ИначеЕсли ТипДокумента = 7 Тогда 
		ЭтоПостоплата = Истина;
		ОплачиваетсяПлатежнойКартой = Ложь;
		ОплачиваетсяНаличными = Ложь;
		Если ДокументСсылка.ТипПередачи = 0 Тогда
			СуммаЗачетаАванса = 0;
			СуммаРазница = СуммаНоменклатуры;
		ИначеЕсли ДокументСсылка.ТипПередачи = 1 Тогда
			СуммаЗачетаАванса = СуммаНоменклатуры;
			СуммаРазница = 0;
		ИначеЕсли ДокументСсылка.ТипПередачи = 2 Тогда
			СуммаРазница = СуммаНоменклатуры - СуммаЗачетаАванса;
		КонецЕсли;	
	ИначеЕсли ТипДокумента = 8
		ИЛИ ТипДокумента = 17 Тогда 
		ЭтоПостоплата = ДокументСсылка.ЭтоПостоплата;
		ОплачиваетсяПлатежнойКартой = Истина;
		ОплачиваетсяНаличными = Ложь;
	ИначеЕсли ТипДокумента = 9 
		ИЛИ ТипДокумента = 10 
		ИЛИ ТипДокумента = 11 
		ИЛИ ТипДокумента = 12 
		ИЛИ ТипДокумента = 13
		ИЛИ ТипДокумента = 18 
		ИЛИ ТипДокумента = 19 Тогда
		//Безналичная оплата
		ОплачиваетсяПлатежнойКартой = Истина;
		ОплачиваетсяНаличными = Ложь;
	КонецЕсли;
	
	Если ОплачиваетсяПлатежнойКартой Тогда
		// Платежная карта или безналичный расчет
		СтрокаОплаты = Новый Структура();
		СтрокаОплаты.Вставить("ТипОплаты", Перечисления.ТипыОплатыККТ.Электронно);
		СтрокаОплаты.Вставить("Наименование", НСтр("ru = 'Электронно'"));
		СтрокаОплаты.Вставить("Сумма", ДокументСсылка.СуммаДокумента);
		ОбщиеПараметры.ТаблицаОплат.Добавить(СтрокаОплаты);
	ИначеЕсли ОплачиваетсяНаличными Тогда
		// Наличные
		СтрокаОплаты = Новый Структура();
		СтрокаОплаты.Вставить("ТипОплаты", Перечисления.ТипыОплатыККТ.Наличные);
		СтрокаОплаты.Вставить("Наименование", НСтр("ru = 'Наличные'"));
		СтрокаОплаты.Вставить("Сумма", ДокументСсылка.СуммаДокумента);
		ОбщиеПараметры.ТаблицаОплат.Добавить(СтрокаОплаты);
	КонецЕсли;	
	
	Если ЭтоПостоплата Тогда
		Если СуммаРазница > 0 Тогда
			// Постоплата
			СтрокаОплаты = Новый Структура();
			СтрокаОплаты.Вставить("ТипОплаты", Перечисления.ТипыОплатыККТ.Постоплата);
			СтрокаОплаты.Вставить("Наименование", НСтр("ru = 'Постоплата'"));
			СтрокаОплаты.Вставить("Сумма", СуммаРазница);
			ОбщиеПараметры.ТаблицаОплат.Добавить(СтрокаОплаты);
		КонецЕсли;
		
		Если СуммаЗачетаАванса > 0 Тогда
			// зачет аванса
			СтрокаОплаты = Новый Структура();
			СтрокаОплаты.Вставить("ТипОплаты", Перечисления.ТипыОплатыККТ.Предоплата);
			СтрокаОплаты.Вставить("Наименование", НСтр("ru = 'Зачет аванса'"));
			СтрокаОплаты.Вставить("Сумма", СуммаЗачетаАванса);
			ОбщиеПараметры.ТаблицаОплат.Добавить(СтрокаОплаты);
		КонецЕсли;
	КонецЕсли;
	
	Если ОбщиеПараметры.Свойство("ИсправлениеВстречнымПредоставлением") Тогда
		Если ОбщиеПараметры.ИсправлениеВстречнымПредоставлением Тогда
			Оплаты = Новый Массив;
			ВсегоОплата = 0;
			Для каждого ТекОплата Из ОбщиеПараметры.ТаблицаОплат Цикл
				ВсегоОплата = ВсегоОплата + ТекОплата.Сумма;
			КонецЦикла;
			СтруктураОплаты = Новый Структура;
			СтруктураОплаты.Вставить("ТипОплаты", ПредопределенноеЗначение("Перечисление.ТипыОплатыККТ.ВстречноеПредоставление"));
			СтруктураОплаты.Вставить("Сумма", ВсегоОплата);
			Оплаты.Добавить(СтруктураОплаты);
			ОбщиеПараметры.ТаблицаОплат = Оплаты;
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры // ЗаполнитьОплатуПриПробитииЧекаККМ()

Процедура ДополнитьТоварамиПараметрыПриПробитииЧека(ОбщиеПараметры, ТаблицаТоваровЧека, ТаблицаСоответствияТоваровСекциям)
	
	ЕстьКодМаркировки 		= НЕ (ТаблицаТоваровЧека.Колонки.Найти("КодМаркировки") = Неопределено);
	ЕстьШтрихкод 			= НЕ (ТаблицаТоваровЧека.Колонки.Найти("Штрихкод") = Неопределено);
	ЕстьКодТру 				= НЕ (ТаблицаТоваровЧека.Колонки.Найти("КодТру") = Неопределено);
	ЕстьРазрешительныйРежим = НЕ (ТаблицаТоваровЧека.Колонки.Найти("РазрешительныйРежимИдентификаторЗапросаГИСМТ") = Неопределено);
	ЕстьВетРецепт 			= НЕ (ТаблицаТоваровЧека.Колонки.Найти("НомерДокументаВет") = Неопределено);  
	ЕстьЧастичнаяПродажа 	= НЕ (ТаблицаТоваровЧека.Колонки.Найти("Числитель") = Неопределено);  
	ТипыУслуг 				= РозничныеПродажиБГУ.ТипыУслугРабот();
		
	Для Каждого СтрокаТЧ Из ТаблицаТоваровЧека Цикл
		
		КодМаркировки			= "";
		СтрокаТаблицыТоваров	= Новый СписокЗначений();
		ПризнакСпособаРасчета 	= СтрокаТЧ.ПризнакСпособаРасчета;
		ЭтоАванс 				= ПризнакСпособаРасчета	= Перечисления.ПризнакиСпособаРасчета.Аванс;
		СтавкаНДС 				= СтавкаНДСВФорматеБПО(СтрокаТЧ.СтавкаНДС, ЭтоАванс); 
		КодЕдиницыИзмерения		= "255";
		Если ЗначениеЗаполнено(СтрокаТЧ.Номенклатура) И ТипЗнч(СтрокаТЧ.Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда 
			ПараметрыНоменклатуры 				= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаТЧ.Номенклатура, "ТипНоменклатуры, КодВидаНоменклатурнойКлассификации, ЕдиницаИзмерения");
			ТипНоменклатуры						= ПараметрыНоменклатуры.ТипНоменклатуры;
			ЭтоТовар		    				= ТипыУслуг.Найти(ТипНоменклатуры) = Неопределено;
			КодВидаНоменклатурнойКлассификации 	= ПараметрыНоменклатуры.КодВидаНоменклатурнойКлассификации; 
			
			Если ЗначениеЗаполнено(ПараметрыНоменклатуры.ЕдиницаИзмерения) Тогда 
				КодЕдиницыИзмерения = ПараметрыНоменклатуры.ЕдиницаИзмерения.Код;
			КонецЕсли;	
		Иначе
			ЭтоТовар 							= Ложь;
			КодВидаНоменклатурнойКлассификации  = "";
		КонецЕсли;	
			
		Если ЕстьКодМаркировки И ЗначениеЗаполнено(СтрокаТЧ.КодМаркировки) Тогда 
			Штрихкод 					= СтрокаТЧ.КодМаркировки;
			КодКонтрольнойМаркиСтрока 	= СтрЗаменить(СтрокаТЧ.КодМаркировки, "\u001d", ОбщегоНазначенияБПОКлиентСервер.РазделительGS1());
			КодМаркировки 				= КодКонтрольнойМаркиСтрока;
		ИначеЕсли ЕстьШтрихкод И ЗначениеЗаполнено(СтрокаТЧ.Штрихкод) И ЭтоТовар Тогда
			ШтрихКод = МенеджерОборудованияКлиентСервер.ШтрихкодВBase64(СтрокаТЧ.Штрихкод);
		Иначе 
			ШтрихКод = "";
		КонецЕсли;
		КодКонтрольнойМаркиСтрока = СтрЗаменить(Штрихкод, "\u001d", ОбщегоНазначенияБПОКлиентСервер.РазделительGS1());
		ШтрихкодBase64 = КодКонтрольнойМаркиСтрока;
		
		НормализованныйКодМаркировки = Неопределено;
		Если ШтрихкодBase64 <> "" Тогда
			Если ЗначениеЗаполнено(СтрокаТЧ.Номенклатура) И ТипЗнч(СтрокаТЧ.Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
				ВидМаркируемойПродукции 		= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТЧ.Номенклатура, "ВидМаркируемойПродукции");
				ВидПродукции 					= ОбменИСМПБГУ.СопоставитьТипыМаркировкиРазрешительныйРежим(ВидМаркируемойПродукции);
				НормализованныйКод				= ИнтеграцияТСПИоТ.НормализованныйКодПоПолномуКодуДляПередачиВЛокальныйМодульЧестныйЗнак(ШтрихкодBase64, ВидПродукции);
				Если НормализованныйКод <> "" Тогда 
					НормализованныйКодМаркировки = НормализованныйКод;
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;
		
		Если ЕстьРазрешительныйРежим Тогда 
			РазрешительныйРежимИдентификаторЗапросаГИСМТ 	= СтрокаТЧ.РазрешительныйРежимИдентификаторЗапросаГИСМТ;
			РазрешительныйРежимДатаЗапросаГИСМТ 			= СтрокаТЧ.РазрешительныйРежимДатаЗапросаГИСМТ;
			РазрешительныйРежимВерсияБазы 					= СтрокаТЧ.РазрешительныйРежимВерсияБазы;
			РазрешительныйРежимИдентификаторЭкземпляраПО 	= СтрокаТЧ.РазрешительныйРежимИдентификаторЭкземпляраПО;
		Иначе
			РазрешительныйРежимИдентификаторЗапросаГИСМТ 	= "";
			РазрешительныйРежимДатаЗапросаГИСМТ 			= "";
			РазрешительныйРежимВерсияБазы 					= "";
			РазрешительныйРежимИдентификаторЭкземпляраПО 	= "";
		КонецЕсли;	  
		
		ПараметрыАлкогольнойПродукции 					= Неопределено;
		
		ЕдиницаИзмеренияПредметаРасчета					= ?(СтрокаТЧ.ЕдиницаИзмеренияПредметаРасчета = Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка(),
		 "", СтрокаТЧ.ЕдиницаИзмеренияПредметаРасчета);
		
		Количество 										= ?(СтрокаТЧ.Количество = 0, 1, СтрокаТЧ.Количество);
		СтрокаПозицииЧека 								= ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыФискальнойСтрокиЧека(); 
		СтрокаПозицииЧека.Наименование 					= СтрокаТЧ.Наименование;
		СтрокаПозицииЧека.Количество   					= СтрокаТЧ.Количество;
		СтрокаПозицииЧека.Цена         					= Окр(СтрокаТЧ.Сумма/Количество, 2);
		СтрокаПозицииЧека.ЦенаСоСкидками 				= СтрокаТЧ.Цена - (СтрокаТЧ.СуммаСкидок/Количество);
		СтрокаПозицииЧека.СуммаСкидок 					= СтрокаТЧ.СуммаСкидок;
		СтрокаПозицииЧека.Сумма        					= СтрокаТЧ.Сумма;
		СтрокаПозицииЧека.НомерСекции  					= СтрокаТЧ.НомерСекции;
		СтрокаПозицииЧека.СтавкаНДС    					= СтавкаНДС;
		СтрокаПозицииЧека.СуммаНДС  					= СтрокаТЧ.СуммаНДС;
		
		СтрокаПозицииЧека.ПризнакСпособаРасчета 		= СтрокаТЧ.ПризнакСпособаРасчета;
		СтрокаПозицииЧека.ПризнакПредметаРасчета 		= СтрокаТЧ.ПризнакПредметаРасчета;
		
		СтрокаПозицииЧека.ЕдиницаИзмерения 				= Строка(ЕдиницаИзмеренияПредметаРасчета);  
		СтрокаПозицииЧека.КодЕдиницыИзмерения			= СокрЛП(КодЕдиницыИзмерения);
		
		СтрокаПозицииЧека.КодСтраныПроисхожденияТовара 	= СокрЛП(СтрокаТЧ.КодСтраныПроисхожденияТовара);
		СтрокаПозицииЧека.НомерТаможеннойДекларации 	= СокрЛП(СтрокаТЧ.НомерТаможеннойДекларации);
		
		СтрокаПозицииЧека.Вставить("ЕдиницаИзмеренияПредметаРасчета", Строка(ЕдиницаИзмеренияПредметаРасчета));
		СтрокаПозицииЧека.Вставить("ПараметрыАлкогольнойПродукции"	, ПараметрыАлкогольнойПродукции);
		
		СтрокаПозицииЧека.ШтрихкодBase64						= ШтрихкодBase64;
		СтрокаПозицииЧека.КодВидаНоменклатурнойКлассификации 	= КодВидаНоменклатурнойКлассификации;
		СтрокаПозицииЧека.КонтрольнаяМарка 						= КодМаркировки;
		СтрокаПозицииЧека.НормализованныйКодМаркировки 			= НормализованныйКодМаркировки;
		
		СтрокаПозицииЧека.ЗапросПроверкиКода.ИдентификаторЗапроса 		= РазрешительныйРежимИдентификаторЗапросаГИСМТ;
		СтрокаПозицииЧека.ЗапросПроверкиКода.ВременнаяМетка 			= РазрешительныйРежимДатаЗапросаГИСМТ;
		СтрокаПозицииЧека.ЗапросПроверкиКода.ИдентификаторЭкземпляра 	= РазрешительныйРежимИдентификаторЭкземпляраПО;
		СтрокаПозицииЧека.ЗапросПроверкиКода.ВерсияБазы 				= РазрешительныйРежимВерсияБазы;
		
		Если ЕстьВетРецепт Тогда  
			Если ЗначениеЗаполнено(СтрокаТЧ.НомерДокументаВет) Тогда 
				Если СтрокаТЧ.ТипДокументаВет = 2 Тогда 
					ЭтоТребование = Истина;
				Иначе	
					ЭтоТребование = Ложь
				КонецЕсли;	
				СтрокаПозицииЧека.ВетеринарныйПрепарат 		= Истина;
				СтрокаПозицииЧека.ВетеринарноеТребование 	= ЭтоТребование;
				СтрокаПозицииЧека.РецептНомер 				= СтрокаТЧ.НомерДокументаВет;
				СтрокаПозицииЧека.РецептДата 				= СтрокаТЧ.ДатаДокументаВет;
				СтрокаПозицииЧека.ШтрихкодBase64 			= "";
				СтрокаПозицииЧека.Штрихкод 					= "";
			КонецЕсли;
		КонецЕсли;
		
		Если ЕстьЧастичнаяПродажа Тогда
			Если СтрокаТЧ.Числитель > 0 И Не СтрокаТЧ.СписатьВЧЗ Тогда 
				СтрокаПозицииЧека.ДробноеКоличество.Числитель 		= СтрокаТЧ.Числитель;
				СтрокаПозицииЧека.ДробноеКоличество.Знаменатель		= СтрокаТЧ.Знаменатель;
				СтрокаПозицииЧека.ПризнакПредметаРасчета 			= Перечисления.ПризнакиПредметаРасчета.ТоварМаркируемыйСИИмеющийКМ;
				СтрокаПозицииЧека.ЕдиницаИзмеренияПредметаРасчета 	= Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка();
				СтрокаПозицииЧека.КодЕдиницыИзмерения 				= "796";
				СтрокаПозицииЧека.ЕдиницаИзмерения 					= "";
				СтрокаПозицииЧека.Количество   						= 1;
				СтрокаПозицииЧека.ШтрихкодBase64 					= "";
				СтрокаПозицииЧека.Штрихкод 							= "";	
			КонецЕсли;
		КонецЕсли;	
		
		Если ЕстьКодТру И Не ПустаяСтрока(СтрокаТЧ.КодТру) Тогда
			СтрокаПозицииЧека.ИспользованСертификатФСС = Истина;	
		КонецЕсли;
		
		ОбщиеПараметры.ПозицииЧека.Добавить(СтрокаПозицииЧека);  
		
		Если ЕстьКодТру И Не ПустаяСтрока(СтрокаТЧ.КодТру) Тогда 
			СтрокаТекста = "ТРУ (КОД):" + СтрокаТЧ.КодТРУ; 
			ТекстоваяСтрокаЧека = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыТекстовойСтрокиЧека(СтрокаТекста);
			ОбщиеПараметры.ПозицииЧека.Добавить(ТекстоваяСтрокаЧека);
		КонецЕсли;	
		
	КонецЦикла;
	
КонецПроцедуры

Функция АдресМестаРасчетаКассыККМ(Организация, КассаККМ)
	
	Если ЗначениеЗаполнено(КассаККМ) Тогда
		Результат = КассаККМ.АдресМестаРасчета;	
		
		Если НЕ ЗначениеЗаполнено(Результат) Тогда
			Результат = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Организация,
													Справочники.ВидыКонтактнойИнформации.ФактАдресОрганизации);
			Если НЕ ЗначениеЗаполнено(Результат) Тогда
				Результат = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Организация,
														Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);
			КонецЕсли;											
		КонецЕсли;													
	КонецЕсли;															
	
	Возврат Результат;
	
КонецФункции

Функция НаименованиеМестаРасчетаКассыККМ(Организация, КассаККМ)
	
	Если ЗначениеЗаполнено(КассаККМ) Тогда
		Результат = КассаККМ.НаименованиеМестаРасчета;	
		
		Если НЕ ЗначениеЗаполнено(Результат) Тогда
			Результат = Организация.НаименованиеСокращенное;
		КонецЕсли;													
	КонецЕсли;															
	
	Возврат Результат;
	
КонецФункции	

Функция ПредставлениеТелефона(ДанныеТелефон)
	
	Если ТипЗнч(ДанныеТелефон) = Тип("Структура") Тогда
		
		ПредставлениеТелефона = УправлениеКонтактнойИнформациейКлиентСервер.СформироватьПредставлениеТелефона(
			СократитьНеЦифры(ДанныеТелефон.countryCode),
			ДанныеТелефон.areaCode,
			ДанныеТелефон.number,
			ДанныеТелефон.extNumber,
			"");
			
	Иначе
		
		ПредставлениеТелефона = УправлениеКонтактнойИнформациейКлиентСервер.СформироватьПредставлениеТелефона(
			СократитьНеЦифры(ДанныеТелефон.КодСтраны), 
			ДанныеТелефон.КодГорода,
			ДанныеТелефон.Номер,
			ДанныеТелефон.Добавочный,
			"");
		
	КонецЕсли;
	
	Возврат ПредставлениеТелефона;
	
КонецФункции

Функция СократитьНеЦифры(Текст, ДопустимоКромеЦифр = "", Направление = Истина)
	
	Длина = СтрДлина(Текст);
	Если Направление Тогда
		// Сокращение слева
		Индекс = 1;
		Конец  = 1 + Длина;
		Шаг    = 1;
	Иначе
		// Сокращение справа    
		Индекс = Длина;
		Конец  = 0;
		Шаг    = -1;
	КонецЕсли;
	
	Пока Индекс <> Конец Цикл
		Символ = Сред(Текст, Индекс, 1);
		ЭтоЦифра = (Символ >= "0" И Символ <= "9") Или СтрНайти(ДопустимоКромеЦифр, Символ) = 0;
		Если ЭтоЦифра Тогда
			Прервать;
		КонецЕсли;
		Индекс = Индекс + Шаг;
	КонецЦикла;
	
	Если Направление Тогда
		// Сокращение слева
		Возврат Прав(Текст, Длина - Индекс + 1);
	КонецЕсли;
	
	// Сокращение справа
	Возврат Лев(Текст, Индекс);
	
КонецФункции

// Функция возвращает пустую структуру состояния кассовой смены.
//
Функция ПолучитьСтруктуруОписанияКассовойСмены()
	
	СостояниеКассовойСмены = Новый Структура;
	СостояниеКассовойСмены.Вставить("ДатаИзмененияСтатуса");
	СостояниеКассовойСмены.Вставить("СтатусКассовойСмены");
	СостояниеКассовойСмены.Вставить("КассоваяСмена");
	СостояниеКассовойСмены.Вставить("НаличностьВКассе");
	СостояниеКассовойСмены.Вставить("НомерКассовойСмены");
	СостояниеКассовойСмены.Вставить("СменаОткрыта", Ложь);
	
	// Описание реквизитов кассовой смены.
	СостояниеКассовойСмены.Вставить("КассаККМ");
	СостояниеКассовойСмены.Вставить("Организация");
		
	Возврат СостояниеКассовойСмены;
	
КонецФункции

#КонецОбласти
