	|	ДанныеНоменклатуры.ЕстьСодержаниеУслуги КАК ЕстьСодержаниеУслуги,
	|	ДанныеНоменклатуры.ПризнакПредметаРасчета КАК ПризнакПредметаРасчета,
	|	ДанныеОПризнакахСпособаРасчета.ПризнакСпособаРасчета КАК ПризнакСпособаРасчета,
	|	ДанныеНоменклатуры.Цена КАК ЦенаСоСкидками,
	|	0 КАК СуммаСкидок,
	|	ДанныеНоменклатуры.ЕстьДополнение КАК ЕстьДополнениеНоменклатуры,
	|	ДанныеНоменклатуры.Дополнение КАК ДополнениеНоменклатуры,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ДанныеНоменклатуры.Номенклатура) = ТИП(Справочник.Номенклатура)
	|			ТОГДА ВЫРАЗИТЬ(ДанныеНоменклатуры.Номенклатура.СтранаПроисхождения КАК Справочник.СтраныМира).Код
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК КодСтраныПроисхожденияТовара,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ДанныеНоменклатуры.Номенклатура) = ТИП(Справочник.Номенклатура)
	|			ТОГДА ВЫРАЗИТЬ(ДанныеНоменклатуры.Номенклатура.НомерГТД КАК Справочник.НомераГТД).Код
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК НомерТаможеннойДекларации,
	|	ДанныеНоменклатуры.КодМаркировки КАК КодМаркировки,
	|	ДанныеНоменклатуры.Штрихкод КАК Штрихкод
	|ИЗ
	|	ДанныеНоменклатуры КАК ДанныеНоменклатуры
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДанныеОПризнакахСпособаРасчета КАК ДанныеОПризнакахСпособаРасчета
	|		ПО ДанныеНоменклатуры.Ссылка = ДанныеОПризнакахСпособаРасчета.Ссылка";
	
	Запрос.УстановитьПараметр("ДанныеОПризнакахСпособаРасчета", ТаблицаДокументыЧекаККМ);
	Запрос.УстановитьПараметр("МассивАкты", МассивАкты);
	Запрос.УстановитьПараметр("МассивТОРГ12", МассивТОРГ12);
	Запрос.УстановитьПараметр("МассивМ15", МассивМ15);
	Запрос.УстановитьПараметр("МассивСчета", МассивСчета);
	Запрос.УстановитьПараметр("МассивКвитанции", МассивКвитанции);
	Запрос.УстановитьПараметр("МассивРозницаВозврат", МассивРозницаВозврат);
	Шт = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("796");
	Запрос.УстановитьПараметр("Шт", Шт);
	
	РезультатЗапроса = Запрос.Выполнить();
	СписокНоменклатуры = РезультатЗапроса.Выгрузить();
	
	Результат = ДозаполнениеСпискаНоменклатуры(СписокНоменклатуры);
	
	Возврат Результат;
КонецФункции   

Функция ПодготовитьДанныеДляПробитияЧекаИзСпискаЧеков(ДокументОбъект, ДокументСсылка, НомерЧека = 1, ПоискПоПорядковомуНомеру = Ложь, ОсобыйВыводСообщения = Ложь, ТекстПолногоСообщения  = "") Экспорт
	
	Если ПоискПоПорядковомуНомеру Тогда
		ТекЧекККМ = ДокументСсылка.ЧекиККМ[НомерЧека-1];
	Иначе	
		ПараметрыОтбора = Новый Структура("НомерЧекаККМ", НомерЧека); 	
		НайденныеСтроки = ДокументСсылка.ЧекиККМ.НайтиСтроки(ПараметрыОтбора);
		
		Если НайденныеСтроки.Количество() = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ТекЧекККМ = НайденныеСтроки[0];
	КонецЕсли;
	
	ТипРасчета = ТекЧекККМ.ТипРасчета;
	
	КассаККМ = ДокументОбъект.КассаККМ;	
	
	ТаблицаТоваровЧека = ТаблицаНоменклатурыЧекаККМ(ДокументСсылка, , НомерЧека);	
	
	Если ТекЧекККМ.НомерЧекаККМ = 0 Тогда
		НомерЧекаККМ = НомерЧека;
		НомерСменыККМ = 1;
		ДатаЧекаККМ = ТекущаяДата();
	Иначе
		Если НЕ ЗначениеЗаполнено(ТекЧекККМ.СтатусЧекаККМ) Тогда
			ДанныеЧека = ДанныеЧекаГруппыПлатежей(ДокументСсылка, , ТекЧекККМ.НомерЧекаККМ);
			НомерЧекаККМ = ДанныеЧека.НомерЧекаККМ;
			НомерСменыККМ = ДанныеЧека.НомерСменыККМ;
			ДатаЧекаККМ = ДанныеЧека.ДатаЧекаККМ;
		Иначе
			НомерЧекаККМ = ТекЧекККМ.НомерЧекаККМ;
			НомерСменыККМ = ТекЧекККМ.НомерСменыККМ;
			ДатаЧекаККМ = ТекЧекККМ.ДатаЧекаККМ;
		КонецЕсли;	
	КонецЕсли;	
	
	
	ТаблицаСоответствияТоваровСекциям = Новый Соответствие();
	ПодключаемоеОборудованиеБГУВызовСервера.ЗаполнитьСоответствиеСекцийДляТабличнойЧастиПоКассеККМ(ДокументСсылка, КассаККМ, 
		ТекЧекККМ.СистемаНалогообложенияЧекаККМ, ТаблицаТоваровЧека, ТаблицаСоответствияТоваровСекциям, ТекЧекККМ.ПараметрыДоговораПлатежногоАгента);
	
	ОбщиеПараметры = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыОперацииФискализацииЧека();
	
	ОбщиеПараметры.Вставить("КорректируемыйДокумент");
	ОбщиеПараметры.Вставить("ТипДокумента", Перечисления.ТипыФискальныхДокументовККТ.КассовыйЧек);
	ОбщиеПараметры.Вставить("ИсправлениеВстречнымПредоставлением", Ложь);
	
	ОбщиеПараметры.КассаККМ = КассаККМ;
	НеПечататьФискальныйЧекПриОтправкеЭлектронного = КассаККМ.НеПечататьФискальныйЧекПриОтправкеЭлектронного;
	
	ДополнитьТоварамиПараметрыПриПробитииЧека(ОбщиеПараметры, ТаблицаТоваровЧека, ТаблицаСоответствияТоваровСекциям);
	
	// Общие параметры чека
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("Организация");
	СтруктураРеквизитов.Вставить("Телефон");
	СтруктураРеквизитов.Вставить("АдресЭП");
	СтруктураРеквизитов.Вставить("Дата");
	СтруктураРеквизитов.Вставить("Ответственный");
	СтруктураРеквизитов.Вставить("ПараметрыДоговораПлатежногоАгента");
	СтруктураРеквизитов.Вставить("СистемаНалогообложенияЧекаККМ");
	СтруктураРеквизитов.Вставить("СуммаДокумента");
	РеквизитыДокумента = СтруктураРеквизитов;
	ЗаполнитьЗначенияСвойств(РеквизитыДокумента, ТекЧекККМ);
	РеквизитыДокумента.Организация = ДокументСсылка.Организация;
	РеквизитыДокумента.Дата = ДокументСсылка.Дата;
	РеквизитыДокумента.Ответственный = ДокументСсылка.Ответственный;
	РеквизитыДокумента.СуммаДокумента = ТекЧекККМ.Сумма;
	
	ДополнительныеСведенияКассовогоЧека = 
		ПодключаемоеОборудованиеБГУВызовСервера.ДополнительныеСведенияКассовогоЧека(ДокументСсылка, ТекЧекККМ.КлючЧека);
	Если ЗначениеЗаполнено(ДополнительныеСведенияКассовогоЧека.АбонентскийНомерТелефона) Тогда
		Телефон = ДополнительныеСведенияКассовогоЧека.АбонентскийНомерТелефона;
	Иначе
		Телефон = РеквизитыДокумента.Телефон;
	КонецЕсли;
	Если ЗначениеЗаполнено(ДополнительныеСведенияКассовогоЧека.АдресЭлектроннойПочты) Тогда
		АдресЭП = ДополнительныеСведенияКассовогоЧека.АдресЭлектроннойПочты;
	Иначе
		АдресЭП = РеквизитыДокумента.АдресЭП;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекЧекККМ.Плательщик) Тогда
		Контрагент = ТекЧекККМ.Плательщик;
	Иначе	
		Контрагент = ТекЧекККМ.Контрагент;
	КонецЕсли;
	Если ЗначениеЗаполнено(Контрагент) Тогда
		ДанныеЮЛиИП = ЧекККМДляЮЛилиИП(Контрагент, РеквизитыДокумента.Дата);
		Если ДанныеЮЛиИП.Заполнить Тогда
			ОбщиеПараметры.Получатель = ДанныеЮЛиИП.Получатель;
			ОбщиеПараметры.ПолучательИНН = ДанныеЮЛиИП.ПолучательИНН;
		КонецЕсли;
		
		Если Контрагент.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
			ОбщиеПараметры.СубъектПерсональныхДанных = Контрагент.ЮридическоеФизическоеЛицо;
		КонецЕсли;	
	КонецЕсли;	
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("НаименованиеПолное");
	СтруктураРеквизитов.Вставить("ИНН");
	СтруктураРеквизитов.Вставить("КПП");
	РеквизитыОрганизация = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыДокумента.Организация, СтруктураРеквизитов);
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("ЭлектронныйЧекSMSПередаютсяПрограммой1С");
	СтруктураРеквизитов.Вставить("ЭлектронныйЧекEmailПередаютсяПрограммой1С");
	СтруктураРеквизитов.Вставить("СерийныйНомер");
	СтруктураРеквизитов.Вставить("Код");
	
	СтруктураРеквизитов.Вставить("СпособФорматноЛогическогоКонтроля", "ПодключаемоеОборудование.СпособФорматноЛогическогоКонтроля");
	СтруктураРеквизитов.Вставить("ДопустимоеРасхождениеФорматноЛогическогоКонтроля", "ПодключаемоеОборудование.ДопустимоеРасхождениеФорматноЛогическогоКонтроля");
	СтруктураРеквизитов.Вставить("ТипОборудования", "ПодключаемоеОборудование.ТипОборудования");
	
	РеквизитыКассыККМ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(КассаККМ, СтруктураРеквизитов);
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("Наименование");
	СтруктураРеквизитов.Вставить("ИНН");
	
	ФизическоеЛицо = ФизическоеЛицоКассира(РеквизитыДокумента.Ответственный);	
	РеквизитыКассир = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ФизическоеЛицо, СтруктураРеквизитов);
	ДолжностьДляЧекаККМ = ДолжностьДляЧекаККМ(ФизическоеЛицо, РеквизитыДокумента.Дата);
	
	ОбщиеПараметры.ТипРасчета = ТипРасчета;
	
	ЕстьКонтактныеДанныеДляЭлектронногоЧека = Ложь;
	Если ЗначениеЗаполнено(Телефон) Тогда
		Если РеквизитыКассыККМ.ЭлектронныйЧекSMSПередаютсяПрограммой1С Тогда
			ОбщиеПараметры.Отправляет1СSMS = Истина;
		КонецЕсли;
		Если СтрДлина(СокрЛП(Телефон)) = 10 Тогда
			ОбщиеПараметры.ПокупательНомер = "+7" + Телефон;
		Иначе	
			ОбщиеПараметры.ПокупательНомер = "+" + Телефон;
		КонецЕсли;
		ЕстьКонтактныеДанныеДляЭлектронногоЧека = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(АдресЭП) Тогда
		Если РеквизитыКассыККМ.ЭлектронныйЧекEmailПередаютсяПрограммой1С Тогда
			ОбщиеПараметры.Отправляет1СEmail = Истина;
		КонецЕсли;
		ОбщиеПараметры.ПокупательEmail = АдресЭП;
		ЕстьКонтактныеДанныеДляЭлектронногоЧека = Истина;
	КонецЕсли;
	
	ОбщиеПараметры.Электронно = ?(НеПечататьФискальныйЧекПриОтправкеЭлектронного И ЕстьКонтактныеДанныеДляЭлектронногоЧека, Истина, Ложь);
	
	ОбщиеПараметры.ДокументОснование = ДокументСсылка;
	
	ЗначениеПоляКассир = СокрЛП(ДолжностьДляЧекаККМ + " " + РеквизитыКассир.Наименование);
	ОбщиеПараметры.Кассир          = ЗначениеПоляКассир;
	ОбщиеПараметры.Вставить("ИмяКассира", ЗначениеПоляКассир);
	ОбщиеПараметры.КассирИНН       = РеквизитыКассир.ИНН;
	
	ОбщиеПараметры.Организация = ДокументСсылка.Организация;
	ОбщиеПараметры.ОрганизацияНазвание = РеквизитыОрганизация.НаименованиеПолное;
	ОбщиеПараметры.ОрганизацияИНН = РеквизитыОрганизация.ИНН;
	ОбщиеПараметры.ОрганизацияКПП = РеквизитыОрганизация.КПП;
	ОбщиеПараметры.НомерКассы     = РеквизитыКассыККМ.Код;
	ОбщиеПараметры.НомерЧека      = НомерЧекаККМ;
	ОбщиеПараметры.НомерСмены     = НомерСменыККМ;
	ОбщиеПараметры.ДатаВремя	  = ДатаЧекаККМ;
	
	АдресМестаПродаж = АдресМестаРасчетаКассыККМ(РеквизитыДокумента.Организация, КассаККМ);
	НаименованиеМестаПродаж = НаименованиеМестаРасчетаКассыККМ(РеквизитыДокумента.Организация, КассаККМ);
	
	СерийныйНомер = РеквизитыКассыККМ.СерийныйНомер;
	Если НЕ ЗначениеЗаполнено(СерийныйНомер) Тогда
		СерийныйНомер = "1";
	КонецЕсли;
	
	ОбщиеПараметры.АдресРасчетов = АдресМестаПродаж;
	ОбщиеПараметры.МестоРасчетов = Строка(НаименованиеМестаПродаж) + ", " + АдресМестаПродаж;
	ОбщиеПараметры.АдресМагазина = АдресМестаПродаж;
	ОбщиеПараметры.НаименованиеМагазина = Строка(НаименованиеМестаПродаж);
	ОбщиеПараметры.СерийныйНомер = СерийныйНомер;
	ОбщиеПараметры.СистемаНалогообложения = КодСистемыНалогообложения(РеквизитыДокумента.Организация,
																				РеквизитыДокумента.СистемаНалогообложенияЧекаККМ);
																				
	ЗаключительныйЧекИсправительный = ЗаключительныйЧекИсправительный(ДокументСсылка, НомерЧекаККМ);
	Если ЗначениеЗаполнено(ЗаключительныйЧекИсправительный) Тогда
		ВерсияФФД = ЗаключительныйЧекИсправительный.ВерсияФФД;
		ОбщиеПараметры.ДополнительныйРеквизит = ЗаключительныйЧекИсправительный.ФискальныйПризнакИсправляемогоЧекаККМ;
		
		ТипФискальногоДокументаККТ = ?(ВерсияФФД = "1.1", Перечисления.ТипыФискальныхДокументовККТ.КассовыйЧекКоррекции, 
			Перечисления.ТипыФискальныхДокументовККТ.КассовыйЧек);
		
		ОбщиеПараметры.ТипДокумента = ТипФискальногоДокументаККТ;
		ОбщиеПараметры.ИсправлениеВстречнымПредоставлением = ЗаключительныйЧекИсправительный.ИсправлениеВстречнымПредоставлением;
		
		Если ЗначениеЗаполнено(ЗаключительныйЧекИсправительный.ДокументОснование) Тогда
			ОбщиеПараметры.КорректируемыйДокумент = ЗаключительныйЧекИсправительный.ДокументОснование;
		КонецЕсли;	
	КонецЕсли;	
																				
	ЗаполнитьПараметрыПлатежногоДоговора(ОбщиеПараметры, 
											РеквизитыДокумента.ПараметрыДоговораПлатежногоАгента,
											РеквизитыДокумента.СуммаДокумента);
																				
	Если РеквизитыКассыККМ.ТипОборудования = Перечисления.ТипыПодключаемогоОборудования.ККТ Тогда
		// При необходимости будет проведен формато-логический контроль
		ОбщиеПараметры.СпособФорматноЛогическогоКонтроля = РеквизитыКассыККМ.СпособФорматноЛогическогоКонтроля;
		ОбщиеПараметры.ДопустимоеРасхождениеФорматноЛогическогоКонтроля = РеквизитыКассыККМ.ДопустимоеРасхождениеФорматноЛогическогоКонтроля;
		Если ФорматноЛогическийКонтрольКлиентСервер.НуженФорматноЛогическийКонтроль(ОбщиеПараметры) Тогда
			ФорматноЛогическийКонтрольКлиентСервер.ПровестиФорматноЛогическийКонтроль(ОбщиеПараметры);
		КонецЕсли;
	КонецЕсли;
	
	Если РеквизитыКассыККМ.ТипОборудования = Перечисления.ТипыПодключаемогоОборудования.ОблачнаяККТ Тогда
		ОбщиеПараметры.ОблачнаяККТ = Истина;
	КонецЕсли;
	
	СуммаНоменклатуры = ТаблицаТоваровЧека.Итог("Сумма");
	
	СтрокаОплаты = Новый Структура();
	Если ДокументСсылка.ВидОперации = 1 Тогда
		СтрокаОплаты.Вставить("ТипОплаты", Перечисления.ТипыОплатыККТ.ВстречноеПредоставление);
		СтрокаОплаты.Вставить("Наименование", НСтр("ru = 'Встречное предоставление'"));
		СтрокаОплаты.Вставить("Сумма", ТекЧекККМ.Сумма);
		ОбщиеПараметры.ТаблицаОплат.Добавить(СтрокаОплаты);
		
		Если ТекЧекККМ.СуммаПредоплаты > 0 Тогда
			// зачет аванса
			СтрокаОплаты = Новый Структура();
			СтрокаОплаты.Вставить("ТипОплаты", Перечисления.ТипыОплатыККТ.Предоплата);
			СтрокаОплаты.Вставить("Наименование", НСтр("ru = 'Зачет аванса'"));
			СтрокаОплаты.Вставить("Сумма", ТекЧекККМ.СуммаПредоплаты);
			ОбщиеПараметры.ТаблицаОплат.Добавить(СтрокаОплаты);
		КонецЕсли;
		
		СуммаПостоплаты = ТекЧекККМ.СуммаРеализации - ТекЧекККМ.СуммаПредоплаты - ТекЧекККМ.Сумма;
		Если СуммаПостоплаты > 0 Тогда
			// Постоплата
			СтрокаОплаты = Новый Структура();
			СтрокаОплаты.Вставить("ТипОплаты", Перечисления.ТипыОплатыККТ.Постоплата);
			СтрокаОплаты.Вставить("Наименование", НСтр("ru = 'Постоплата'"));
			СтрокаОплаты.Вставить("Сумма", СуммаПостоплаты);
			ОбщиеПараметры.ТаблицаОплат.Добавить(СтрокаОплаты);
		КонецЕсли;
	ИначеЕсли ДокументСсылка.ВидОперации = 2 Тогда
		Если ТекЧекККМ.СуммаПредоплаты > 0 Тогда
			// зачет аванса
			СтрокаОплаты = Новый Структура();
			СтрокаОплаты.Вставить("ТипОплаты", Перечисления.ТипыОплатыККТ.Предоплата);
			СтрокаОплаты.Вставить("Наименование", НСтр("ru = 'Зачет аванса'"));
			СтрокаОплаты.Вставить("Сумма", ТекЧекККМ.СуммаПредоплаты);
			ОбщиеПараметры.ТаблицаОплат.Добавить(СтрокаОплаты);
		КонецЕсли;
		СуммаПостоплаты = ТекЧекККМ.СуммаРеализации - ТекЧекККМ.СуммаПредоплаты;
		Если СуммаПостоплаты > 0 Тогда
			// Постоплата
			СтрокаОплаты = Новый Структура();
			СтрокаОплаты.Вставить("ТипОплаты", Перечисления.ТипыОплатыККТ.Постоплата);
			СтрокаОплаты.Вставить("Наименование", НСтр("ru = 'Постоплата'"));
			СтрокаОплаты.Вставить("Сумма", СуммаПостоплаты);
			ОбщиеПараметры.ТаблицаОплат.Добавить(СтрокаОплаты);
		КонецЕсли;
	ИначеЕсли ДокументСсылка.ВидОперации = 3 Тогда
		Если ТекЧекККМ.СуммаПредоплаты > 0 Тогда
			// зачет аванса
			СтрокаОплаты = Новый Структура();
			СтрокаОплаты.Вставить("ТипОплаты", Перечисления.ТипыОплатыККТ.Предоплата);
			СтрокаОплаты.Вставить("Наименование", НСтр("ru = 'Зачет аванса'"));
			СтрокаОплаты.Вставить("Сумма", ТекЧекККМ.СуммаПредоплаты);
			ОбщиеПараметры.ТаблицаОплат.Добавить(СтрокаОплаты);
		КонецЕсли;
		СуммаПостоплаты = ТекЧекККМ.СуммаРеализации - ТекЧекККМ.СуммаПредоплаты;
		Если СуммаПостоплаты > 0 Тогда
			// Постоплата
			СтрокаОплаты = Новый Структура();
			СтрокаОплаты.Вставить("ТипОплаты", Перечисления.ТипыОплатыККТ.Постоплата);
			СтрокаОплаты.Вставить("Наименование", НСтр("ru = 'Постоплата'"));
			СтрокаОплаты.Вставить("Сумма", СуммаПостоплаты);
			ОбщиеПараметры.ТаблицаОплат.Добавить(СтрокаОплаты);
		КонецЕсли;
	Иначе	
		СтрокаОплаты.Вставить("ТипОплаты", Перечисления.ТипыОплатыККТ.Электронно);
		СтрокаОплаты.Вставить("Наименование", НСтр("ru = 'Электронно'"));
		СтрокаОплаты.Вставить("Сумма", ТекЧекККМ.Сумма);
		ОбщиеПараметры.ТаблицаОплат.Добавить(СтрокаОплаты);
	КонецЕсли;
	
	Возврат ОбщиеПараметры;
КонецФункции	

Функция ПодготовитьДанныеДляПробитияЧека(ДокументОбъект, ДокументСсылка, НомерЧека = 1, ОсобыйВыводСообщения = Ложь, ТекстПолногоСообщения  = "", ОтменаОплаты = Ложь) Экспорт
	ТипДокумента = ПодключаемоеОборудованиеБГУВызовСервера.ТипДокумента(ДокументСсылка);
	
	Если ТипДокумента = 14 Тогда
		ОбщиеПараметры = ПодготовитьДанныеДляПробитияЧекаИзСпискаЧеков(ДокументОбъект, ДокументСсылка, НомерЧека, Истина, ОсобыйВыводСообщения, ТекстПолногоСообщения);
		
		Возврат ОбщиеПараметры;
	КонецЕсли;	
		
	ТипРасчета = ДокументСсылка.ТипРасчета;
	
	Если ТипДокумента = 3 Тогда
		Если ДокументОбъект.ОтменаОплатыВыполнена Тогда
			ОтменаОплаты = Истина;
		КонецЕсли;	
	КонецЕсли;	
	
	Если ОтменаОплаты Тогда
		ТипРасчета = Перечисления.ТипыРасчетаДенежнымиСредствами.ВозвратДенежныхСредств;
	КонецЕсли;	
	
	ТаблицаТоваровЧека = ТаблицаНоменклатурыЧекаККМ(ДокументСсылка, ОтменаОплаты);	
	
	ТаблицаСоответствияТоваровСекциям = Новый Соответствие();
	Если (ТипДокумента = 3) ИЛИ (ТипДокумента = 4) Тогда
		КассаККМ = ДокументОбъект.ФискальныйРегистратор;	
	Иначе	
		КассаККМ = ДокументОбъект.КассаККМ;	
	КонецЕсли;
	
	Если ТипДокумента <> 15 Тогда
		ПодключаемоеОборудованиеБГУВызовСервера.ЗаполнитьСоответствиеСекцийДляТабличнойЧастиПоКассеККМ(ДокументСсылка, КассаККМ,
			ДокументСсылка.СистемаНалогообложенияЧекаККМ, ТаблицаТоваровЧека, ТаблицаСоответствияТоваровСекциям);
	КонецЕсли;
	
	ОбщиеПараметры = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыОперацииФискализацииЧека();
	
	ОбщиеПараметры.Вставить("КорректируемыйДокумент");
	ОбщиеПараметры.Вставить("ТипДокумента", Перечисления.ТипыФискальныхДокументовККТ.КассовыйЧек);
	ОбщиеПараметры.Вставить("ИсправлениеВстречнымПредоставлением", Ложь);
	
	ОбщиеПараметры.КассаККМ = КассаККМ;
	
	НеПечататьФискальныйЧекПриОтправкеЭлектронного = КассаККМ.НеПечататьФискальныйЧекПриОтправкеЭлектронного;
	
	Если ТипДокумента = 15 Тогда
		ТаблицаСоответствияТоваровСекциям = Новый Соответствие();
		ОбщиеПараметры.ДополнительныйРеквизит = ДокументСсылка.ФискальныйПризнакИсправляемогоЧекаККМ;
		Если ЗначениеЗаполнено(ДокументСсылка.ДокументОснование) Тогда
			ОбщиеПараметры.КорректируемыйДокумент = ДокументСсылка.ДокументОснование;
		КонецЕсли;	
	Иначе
		ЗаключительныйЧекИсправительный = ПодключаемоеОборудованиеБГУ.ЗаключительныйЧекИсправительный(ДокументСсылка);
		Если ЗначениеЗаполнено(ЗаключительныйЧекИсправительный) Тогда
			ВерсияФФД = ЗаключительныйЧекИсправительный.ВерсияФФД;
			ОбщиеПараметры.ДополнительныйРеквизит = ЗаключительныйЧекИсправительный.ФискальныйПризнакИсправляемогоЧекаККМ;
			
			ТипФискальногоДокументаККТ = ?(ВерсияФФД = "1.1", Перечисления.ТипыФискальныхДокументовККТ.КассовыйЧекКоррекции, 
				Перечисления.ТипыФискальныхДокументовККТ.КассовыйЧек);
			
			ОбщиеПараметры.ТипДокумента = ТипФискальногоДокументаККТ;
			ОбщиеПараметры.ИсправлениеВстречнымПредоставлением = ЗаключительныйЧекИсправительный.ИсправлениеВстречнымПредоставлением;
			
			Если ЗначениеЗаполнено(ЗаключительныйЧекИсправительный.ДокументОснование) Тогда
				ОбщиеПараметры.КорректируемыйДокумент = ЗаключительныйЧекИсправительный.ДокументОснование;
			КонецЕсли;	
		Иначе
			ДанныеИсправления = Новый Структура("ИсправительныйЧекККМ", Документы.ЧекККМИсправительный.ПустаяСсылка());
			ЗаполнитьЗначенияСвойств(ДанныеИсправления, ДокументСсылка);
			Если ЗначениеЗаполнено(ДанныеИсправления.ИсправительныйЧекККМ) Тогда
				ИсправительныйЧекККМ = ДанныеИсправления.ИсправительныйЧекККМ;
				ВерсияФФД = ИсправительныйЧекККМ.ВерсияФФД;
				ОбщиеПараметры.ДополнительныйРеквизит = ИсправительныйЧекККМ.ФискальныйПризнакИсправляемогоЧекаККМ;
				
				ТипФискальногоДокументаККТ = ?(ВерсияФФД = "1.1", Перечисления.ТипыФискальныхДокументовККТ.КассовыйЧекКоррекции, 
					Перечисления.ТипыФискальныхДокументовККТ.КассовыйЧек);
				
				ОбщиеПараметры.ТипДокумента = ТипФискальногоДокументаККТ;
				
				ОбщиеПараметры.ИсправлениеВстречнымПредоставлением = ИсправительныйЧекККМ.ИсправлениеВстречнымПредоставлением;
				
				Если ЗначениеЗаполнено(ИсправительныйЧекККМ.ДокументОснование) Тогда
					ОбщиеПараметры.КорректируемыйДокумент = ИсправительныйЧекККМ.ДокументОснование;
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
	
	ДополнитьТоварамиПараметрыПриПробитииЧека(ОбщиеПараметры, ТаблицаТоваровЧека, ТаблицаСоответствияТоваровСекциям);
	
	// Общие параметры чека
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("Организация");
	СтруктураРеквизитов.Вставить("Телефон");
	СтруктураРеквизитов.Вставить("АдресЭП");
	СтруктураРеквизитов.Вставить("Дата"); 
	Если ТипДокумента <> 19 Тогда 
		СтруктураРеквизитов.Вставить("Контрагент");
	КонецЕсли;	
	СтруктураРеквизитов.Вставить("Ответственный");
	СтруктураРеквизитов.Вставить("ПараметрыДоговораПлатежногоАгента");
	СтруктураРеквизитов.Вставить("СистемаНалогообложенияЧекаККМ");
	СтруктураРеквизитов.Вставить("СуммаДокумента");
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, СтруктураРеквизитов);
	
	Если ТипДокумента <> 19 Тогда 
		Контрагент = РеквизитыДокумента.Контрагент;
	Иначе
		Контрагент = ДокументСсылка.Контрагенты[0].Контрагент;
    КонецЕсли;
	
	Если ЗначениеЗаполнено(Контрагент) Тогда
		ДанныеЮЛиИП = ЧекККМДляЮЛилиИП(Контрагент, РеквизитыДокумента.Дата);
		Если ДанныеЮЛиИП.Заполнить Тогда
			ОбщиеПараметры.Получатель = ДанныеЮЛиИП.Получатель;
			ОбщиеПараметры.ПолучательИНН = ДанныеЮЛиИП.ПолучательИНН;
		КонецЕсли;
		
		Если Контрагент.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
			ОбщиеПараметры.СубъектПерсональныхДанных = Контрагент.ЮридическоеФизическоеЛицо;
		КонецЕсли;	
	КонецЕсли;	
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("НаименованиеПолное");
	СтруктураРеквизитов.Вставить("ИНН");
	СтруктураРеквизитов.Вставить("КПП");
	РеквизитыОрганизация = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыДокумента.Организация, СтруктураРеквизитов);
	
	ОбщиеПараметры.Организация = РеквизитыДокумента.Организация;
	ОбщиеПараметры.ОрганизацияНазвание = РеквизитыОрганизация.НаименованиеПолное;
	ОбщиеПараметры.ОрганизацияИНН = РеквизитыОрганизация.ИНН;
	ОбщиеПараметры.ОрганизацияКПП = РеквизитыОрганизация.КПП;
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("ЭлектронныйЧекSMSПередаютсяПрограммой1С");
	СтруктураРеквизитов.Вставить("ЭлектронныйЧекEmailПередаютсяПрограммой1С");
	СтруктураРеквизитов.Вставить("СерийныйНомер");
	СтруктураРеквизитов.Вставить("Код");
	
	СтруктураРеквизитов.Вставить("СпособФорматноЛогическогоКонтроля", "ПодключаемоеОборудование.СпособФорматноЛогическогоКонтроля");
	СтруктураРеквизитов.Вставить("ДопустимоеРасхождениеФорматноЛогическогоКонтроля", "ПодключаемоеОборудование.ДопустимоеРасхождениеФорматноЛогическогоКонтроля");
	СтруктураРеквизитов.Вставить("ТипОборудования", "ПодключаемоеОборудование.ТипОборудования");
	
	РеквизитыКассыККМ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(КассаККМ, СтруктураРеквизитов);
	
	КодНастройкиКассира = 0;
	Если (ТипДокумента = 1) Тогда
		КодНастройкиКассира = КассирДляПКО(КассаККМ);
	ИначеЕсли (ТипДокумента = 2) Тогда	
		КодНастройкиКассира = КассирДляРКО(КассаККМ);
	КонецЕсли;
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("Наименование");
	СтруктураРеквизитов.Вставить("ИНН");
	
	Если ТипДокумента = 1 
		ИЛИ ТипДокумента = 2 Тогда 
			Если КодНастройкиКассира = 0 Тогда
				ФизическоеЛицо = ФизическоеЛицоКассира(ДокументСсылка.Кассир);
				РеквизитыКассир = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ФизическоеЛицо, СтруктураРеквизитов);
			Иначе
				ФизическоеЛицо = ФизическоеЛицоКассира(РеквизитыДокумента.Ответственный);
				РеквизитыКассир = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ФизическоеЛицо, СтруктураРеквизитов);
			КонецЕсли;	
	Иначе
		ФизическоеЛицо = ФизическоеЛицоКассира(РеквизитыДокумента.Ответственный);
		РеквизитыКассир = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ФизическоеЛицо, СтруктураРеквизитов);
	КонецЕсли;
	ДолжностьДляЧекаККМ = ДолжностьДляЧекаККМ(ФизическоеЛицо, РеквизитыДокумента.Дата);
	
	ОбщиеПараметры.ТипРасчета = ТипРасчета;
	
	ДополнительныеСведенияКассовогоЧека = 
		ПодключаемоеОборудованиеБГУВызовСервера.ДополнительныеСведенияКассовогоЧека(ДокументСсылка);
	Телефон = ДополнительныеСведенияКассовогоЧека.АбонентскийНомерТелефона;
	АдресЭП = ДополнительныеСведенияКассовогоЧека.АдресЭлектроннойПочты;
	
	ЕстьКонтактныеДанныеДляЭлектронногоЧека = Ложь;
	Если ЗначениеЗаполнено(Телефон) Тогда
		Если РеквизитыКассыККМ.ЭлектронныйЧекSMSПередаютсяПрограммой1С Тогда
			ОбщиеПараметры.Отправляет1СSMS = Истина;
		КонецЕсли;
		
		Если СтрДлина(СокрЛП(Телефон)) = 10 Тогда
			ОбщиеПараметры.ПокупательНомер = "+7" + Телефон;
		Иначе
			ОбщиеПараметры.ПокупательНомер = "+" + Телефон;
		КонецЕсли;	
		
		ЕстьКонтактныеДанныеДляЭлектронногоЧека = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(АдресЭП) Тогда
		Если РеквизитыКассыККМ.ЭлектронныйЧекEmailПередаютсяПрограммой1С Тогда
			ОбщиеПараметры.Отправляет1СEmail = Истина;
		КонецЕсли;
		ОбщиеПараметры.ПокупательEmail = АдресЭП;
		
		ЕстьКонтактныеДанныеДляЭлектронногоЧека = Истина;
	КонецЕсли;
	
	ОбщиеПараметры.Электронно = ?(НеПечататьФискальныйЧекПриОтправкеЭлектронного И ЕстьКонтактныеДанныеДляЭлектронногоЧека, Истина, Ложь);
	
	ОбщиеПараметры.ДокументОснование = ДокументСсылка;
	
	ЗначениеПоляКассир = СокрЛП(ДолжностьДляЧекаККМ + " " + РеквизитыКассир.Наименование);
	ОбщиеПараметры.Кассир          = ЗначениеПоляКассир;
	ОбщиеПараметры.Вставить("ИмяКассира", ЗначениеПоляКассир);
	ОбщиеПараметры.КассирИНН       = РеквизитыКассир.ИНН;
	
	ОбщиеПараметры.ОрганизацияНазвание = РеквизитыОрганизация.НаименованиеПолное;
	ОбщиеПараметры.ОрганизацияИНН = РеквизитыОрганизация.ИНН;
	ОбщиеПараметры.ОрганизацияКПП = РеквизитыОрганизация.КПП;
	ОбщиеПараметры.НомерКассы     = РеквизитыКассыККМ.Код;
	ОбщиеПараметры.НомерЧека      = НомерЧека;
	ОбщиеПараметры.НомерСмены     = 1;
	
	АдресМестаПродаж = АдресМестаРасчетаКассыККМ(РеквизитыДокумента.Организация, КассаККМ);
	НаименованиеМестаПродаж = НаименованиеМестаРасчетаКассыККМ(РеквизитыДокумента.Организация, КассаККМ);
	
	СерийныйНомер = РеквизитыКассыККМ.СерийныйНомер;
	Если НЕ ЗначениеЗаполнено(СерийныйНомер) Тогда
		СерийныйНомер = "1";
	КонецЕсли;
	
	ОбщиеПараметры.АдресРасчетов = АдресМестаПродаж;
	ОбщиеПараметры.МестоРасчетов = Строка(НаименованиеМестаПродаж) + ", " + АдресМестаПродаж;
	ОбщиеПараметры.АдресМагазина = АдресМестаПродаж;
	ОбщиеПараметры.НаименованиеМагазина = Строка(НаименованиеМестаПродаж);
	ОбщиеПараметры.СерийныйНомер = СерийныйНомер;
	ОбщиеПараметры.СистемаНалогообложения = КодСистемыНалогообложения(РеквизитыДокумента.Организация,
																				РеквизитыДокумента.СистемаНалогообложенияЧекаККМ);
																				
	ЗаполнитьПараметрыПлатежногоДоговора(ОбщиеПараметры, 
											РеквизитыДокумента.ПараметрыДоговораПлатежногоАгента,
											РеквизитыДокумента.СуммаДокумента, ТаблицаТоваровЧека);
																				
	Если РеквизитыКассыККМ.ТипОборудования = Перечисления.ТипыПодключаемогоОборудования.ККТ Тогда
		// При необходимости будет проведен формато-логический контроль
		ОбщиеПараметры.СпособФорматноЛогическогоКонтроля = РеквизитыКассыККМ.СпособФорматноЛогическогоКонтроля;
		ОбщиеПараметры.ДопустимоеРасхождениеФорматноЛогическогоКонтроля = РеквизитыКассыККМ.ДопустимоеРасхождениеФорматноЛогическогоКонтроля;
		Если ФорматноЛогическийКонтрольКлиентСервер.НуженФорматноЛогическийКонтроль(ОбщиеПараметры) Тогда
			ФорматноЛогическийКонтрольКлиентСервер.ПровестиФорматноЛогическийКонтроль(ОбщиеПараметры);
		КонецЕсли;
	КонецЕсли;
	
	Если РеквизитыКассыККМ.ТипОборудования = Перечисления.ТипыПодключаемогоОборудования.ОблачнаяККТ Тогда
		ОбщиеПараметры.ОблачнаяККТ = Истина;
	КонецЕсли;
	
	СуммаНоменклатуры = ТаблицаТоваровЧека.Итог("Сумма");
	
	ЗаполнитьОплатуПриПробитииЧекаККМ(ДокументОбъект, ТипДокумента, ОбщиеПараметры, СуммаНоменклатуры); 
	
	//Поддержка изменений ФФД по приказу N ЕД-7-20/236@
	Если ТипДокумента = 3 Или ТипДокумента = 4 Или ТипДокумента = 5 Или ТипДокумента = 6 Или ТипДокумента = 7 Или ТипДокумента = 8 Или ТипДокумента = 15 Или ТипДокумента = 16 Или ТипДокумента = 17 Тогда 
		ОбщиеПараметры.Интернет 		= ДокументСсылка.РасчетВИнтернете;
		ОбщиеПараметры.МестоРасчетов 	= ДокументСсылка.АдресСайта;
	КонецЕсли;	
	
	Возврат ОбщиеПараметры;
	
КонецФункции // ПодготовитьДанныеДляПробитияЧека()

Функция ПодготовитьДанныеДляПробитияЧекаКоррекции(ДокументОбъект, ДокументСсылка, НомерЧека = 1, ОсобыйВыводСообщения = Ложь, ТекстПолногоСообщения  = "", ОтменаОплаты = Ложь) Экспорт
	ТипДокумента = ПодключаемоеОборудованиеБГУВызовСервера.ТипДокумента(ДокументСсылка);
	
	ТаблицаТоваровЧека = ТаблицаНоменклатурыЧекаККМ(ДокументСсылка, ОтменаОплаты);	
	
	ОбщиеПараметры = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыОперацииФискализацииЧека();
	
	ОбщиеПараметрыФискализации = ОборудованиеЧекопечатающиеУстройства.ПараметрыФискализацииЧека();
	
	Для каждого ТекПараметр Из ОбщиеПараметрыФискализации Цикл
		ОбщиеПараметры.Вставить(ТекПараметр.Ключ, ТекПараметр.Значение);
	КонецЦикла;	
	
	ОбщиеПараметры.Вставить("КассаККМ", Справочники.ФискальныеРегистраторы.ПустаяСсылка());
	
	ОбщиеПараметры.ТипРасчета = ДокументСсылка.ТипРасчета;
	
	ТаблицаСоответствияТоваровСекциям = Новый Соответствие();
	ПозицииЧека = Новый Массив;
	ОбщиеПараметры.Вставить("ПозицииЧека", ПозицииЧека);
	ДополнитьТоварамиПараметрыПриПробитииЧека(ОбщиеПараметры, ТаблицаТоваровЧека, ТаблицаСоответствияТоваровСекциям);
	
	Если ТипДокумента = 16 Тогда
		ОбщиеПараметры.Вставить("ТипДокумента", Перечисления.ТипыФискальныхДокументовККТ.КассовыйЧекКоррекции);
		ДанныеКоррекции = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыДанныеКоррекции();
		ОбщиеПараметры.Вставить("ДанныеКоррекции", ДанныеКоррекции);
		ОбщиеПараметры.ДанныеКоррекции.ТипКоррекции      = ДокументСсылка.ТипКоррекции;
		ОбщиеПараметры.ДанныеКоррекции.ОписаниеКоррекции = ДокументСсылка.ОписаниеКоррекции;
		ОбщиеПараметры.ДанныеКоррекции.ДатаКоррекции     = ДокументСсылка.ДатаКоррекции;
		ОбщиеПараметры.ДанныеКоррекции.НомерПредписания  = ДокументСсылка.НомерПредписания;
		ОбщиеПараметры.НеприменениеККТ = Истина;
	ИначеЕсли ТипДокумента = 15 Тогда
		ТипФискальногоДокументаККТ = ?(ДокументСсылка.ВерсияФФД = "1.1", Перечисления.ТипыФискальныхДокументовККТ.КассовыйЧекКоррекции, 
			Перечисления.ТипыФискальныхДокументовККТ.КассовыйЧек);
		
		ОбщиеПараметры.Вставить("ТипДокумента", ТипФискальногоДокументаККТ);
		ОбщиеПараметры.ДополнительныйРеквизит = ДокументСсылка.ФискальныйПризнакИсправляемогоЧекаККМ;
		Если ЗначениеЗаполнено(ДокументСсылка.ДокументОснование) Тогда
			ОбщиеПараметры.Вставить("КорректируемыйДокумент", ДокументСсылка.ДокументОснование);
		Иначе
			ОбщиеПараметры.Вставить("КорректируемыйДокумент");
		КонецЕсли;	
	Иначе
		ТипФискальногоДокументаККТ = Перечисления.ТипыФискальныхДокументовККТ.КассовыйЧек;
		ОбщиеПараметры.Вставить("ТипДокумента", ТипФискальногоДокументаККТ);
	КонецЕсли;	
	
	КассаККМ = ДокументОбъект.КассаККМ;	
	ОбщиеПараметры.КассаККМ = КассаККМ;
	
	ЕстьКонтактныеДанныеДляЭлектронногоЧека = Ложь;
	ОбщиеПараметры.Отправляет1СSMS = Ложь;
	
	ДополнительныеСведенияКассовогоЧека = 
		ПодключаемоеОборудованиеБГУВызовСервера.ДополнительныеСведенияКассовогоЧека(ДокументСсылка);
	Телефон = ДополнительныеСведенияКассовогоЧека.АбонентскийНомерТелефона;
	АдресЭП = ДополнительныеСведенияКассовогоЧека.АдресЭлектроннойПочты;
	
	Если ЗначениеЗаполнено(ДокументСсылка.Телефон) Тогда
		Телефон = ДокументСсылка.Телефон;
	КонецЕсли;
	Если ЗначениеЗаполнено(ДокументСсылка.АдресЭП) Тогда
		АдресЭП = ДокументСсылка.АдресЭП;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Телефон) Тогда
		Если КассаККМ.ЭлектронныйЧекSMSПередаютсяПрограммой1С Тогда
			ОбщиеПараметры.Отправляет1СSMS = Истина;
		КонецЕсли;
		Если СтрДлина(СокрЛП(Телефон)) = 10 Тогда
			ОбщиеПараметры.ПокупательНомер = "+7" + Телефон;
		Иначе
			ОбщиеПараметры.ПокупательНомер = "+" + Телефон;
		КонецЕсли;	
		
		ЕстьКонтактныеДанныеДляЭлектронногоЧека = Истина;
	КонецЕсли;
	
	ОбщиеПараметры.Отправляет1СEmail = Ложь;
	Если ЗначениеЗаполнено(АдресЭП) Тогда
		Если КассаККМ.ЭлектронныйЧекEmailПередаютсяПрограммой1С Тогда
			ОбщиеПараметры.Отправляет1СEmail = Истина;
		КонецЕсли;
		ОбщиеПараметры.ПокупательEmail = АдресЭП;
		ЕстьКонтактныеДанныеДляЭлектронногоЧека = Истина;
	КонецЕсли;
	
	НеПечататьФискальныйЧекПриОтправкеЭлектронного = ?(КассаККМ.НеПечататьФискальныйЧекПриОтправкеЭлектронного И ЕстьКонтактныеДанныеДляЭлектронногоЧека, Истина, Ложь);
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("Наименование");
	СтруктураРеквизитов.Вставить("ИНН");
	ФизическоеЛицо = ФизическоеЛицоКассира(ДокументСсылка.Ответственный);	
	РеквизитыКассир = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ФизическоеЛицо, СтруктураРеквизитов);
	ДолжностьДляЧекаККМ = ДолжностьДляЧекаККМ(ФизическоеЛицо, ДокументСсылка.Дата);
	
	ЗначениеПоляКассир = СокрЛП(ДолжностьДляЧекаККМ + " " + РеквизитыКассир.Наименование);
	ОбщиеПараметры.Кассир          = ЗначениеПоляКассир;
	ОбщиеПараметры.Вставить("ИмяКассира", ЗначениеПоляКассир);
	ОбщиеПараметры.Вставить("КассирИНН", РеквизитыКассир.ИНН);
	
	// Общие параметры чека
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("Организация");
	СтруктураРеквизитов.Вставить("Телефон");
	СтруктураРеквизитов.Вставить("АдресЭП");
	СтруктураРеквизитов.Вставить("Дата");
	СтруктураРеквизитов.Вставить("Контрагент");
	СтруктураРеквизитов.Вставить("Ответственный");
	СтруктураРеквизитов.Вставить("ПараметрыДоговораПлатежногоАгента");
	СтруктураРеквизитов.Вставить("СистемаНалогообложенияЧекаККМ");
	СтруктураРеквизитов.Вставить("СуммаДокумента");
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, СтруктураРеквизитов);
	
	Контрагент = РеквизитыДокумента.Контрагент;
	Если ЗначениеЗаполнено(Контрагент) Тогда
		ДанныеЮЛиИП = ЧекККМДляЮЛилиИП(Контрагент, РеквизитыДокумента.Дата);
		Если ДанныеЮЛиИП.Заполнить Тогда
			ОбщиеПараметры.Получатель = ДанныеЮЛиИП.Получатель;
			ОбщиеПараметры.ПолучательИНН = ДанныеЮЛиИП.ПолучательИНН;
		КонецЕсли;
		
		Если Контрагент.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
			ОбщиеПараметры.СубъектПерсональныхДанных = Контрагент.ЮридическоеФизическоеЛицо;
		КонецЕсли;	
	КонецЕсли;	
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("НаименованиеПолное");
	СтруктураРеквизитов.Вставить("ИНН");
	СтруктураРеквизитов.Вставить("КПП");
	РеквизитыОрганизация = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыДокумента.Организация, СтруктураРеквизитов);
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("ЭлектронныйЧекSMSПередаютсяПрограммой1С");
	СтруктураРеквизитов.Вставить("ЭлектронныйЧекEmailПередаютсяПрограммой1С");
	СтруктураРеквизитов.Вставить("СерийныйНомер");
	СтруктураРеквизитов.Вставить("Код");
	
	СтруктураРеквизитов.Вставить("СпособФорматноЛогическогоКонтроля", "ПодключаемоеОборудование.СпособФорматноЛогическогоКонтроля");
	СтруктураРеквизитов.Вставить("ДопустимоеРасхождениеФорматноЛогическогоКонтроля", "ПодключаемоеОборудование.ДопустимоеРасхождениеФорматноЛогическогоКонтроля");
	СтруктураРеквизитов.Вставить("ТипОборудования", "ПодключаемоеОборудование.ТипОборудования");
	
	РеквизитыКассыККМ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(КассаККМ, СтруктураРеквизитов);
	
	Если РеквизитыКассыККМ.ЭлектронныйЧекSMSПередаютсяПрограммой1С Тогда
		ОбщиеПараметры.Отправляет1СSMS = Истина;
	КонецЕсли;
	
	Если РеквизитыКассыККМ.ЭлектронныйЧекEmailПередаютсяПрограммой1С Тогда
		ОбщиеПараметры.Отправляет1СEmail = Истина;
	КонецЕсли;  
	
	Если РеквизитыКассыККМ.ТипОборудования = Перечисления.ТипыПодключаемогоОборудования.ОблачнаяККТ Тогда
		ОбщиеПараметры.ОблачнаяККТ = Истина;
	КонецЕсли;
	
	ОбщиеПараметры.Электронно = ?(НеПечататьФискальныйЧекПриОтправкеЭлектронного, Истина, Ложь);
	ОбщиеПараметры.ДокументОснование = ДокументСсылка;
	
	ОбщиеПараметры.Вставить("СистемаНалогообложения", КодСистемыНалогообложения(ДокументСсылка.Организация,
																				ДокументСсылка.СистемаНалогообложенияЧекаККМ));
	
	ОбщиеПараметры.ОплатаНаличные = ДокументСсылка.СуммаОплатыНаличными;
	ОбщиеПараметры.ОплатаЭлектронно = ДокументСсылка.СуммаОплатыЭлектронно;
	ОбщиеПараметры.ОплатаПредоплата = ДокументСсылка.СуммаПредоплаты;
	ОбщиеПараметры.ОплатаПостоплата = ДокументСсылка.СуммаПостоплаты;
	ОбщиеПараметры.ОплатаВстречноеПредоставление = ДокументСсылка.СуммаОплатыВстречнымПредоставлением;
	ОбщиеПараметры.СуммаЧека = ДокументСсылка.СуммаОплатыНаличными +
		ДокументСсылка.СуммаОплатыЭлектронно + ДокументСсылка.СуммаПредоплаты +
		ДокументСсылка.СуммаПостоплаты + ДокументСсылка.СуммаОплатыВстречнымПредоставлением;
	
	ТаблицаОплат = Новый Массив;
	ОбщиеПараметры.Вставить("ТаблицаОплат", ТаблицаОплат);
	
	Если ДокументСсылка.СуммаОплатыЭлектронно > 0 Тогда
		// Платежная карта или безналичный расчет
		СтрокаОплаты = Новый Структура();
		СтрокаОплаты.Вставить("ТипОплаты", Перечисления.ТипыОплатыККТ.Электронно);
		СтрокаОплаты.Вставить("Наименование", НСтр("ru = 'Электронно'"));
		СтрокаОплаты.Вставить("Сумма", ДокументСсылка.СуммаОплатыЭлектронно);
		ОбщиеПараметры.ТаблицаОплат.Добавить(СтрокаОплаты);
	КонецЕсли;	
	Если ДокументСсылка.СуммаОплатыНаличными > 0 Тогда
		// Наличные
		СтрокаОплаты = Новый Структура();
		СтрокаОплаты.Вставить("ТипОплаты", Перечисления.ТипыОплатыККТ.Наличные);
		СтрокаОплаты.Вставить("Наименование", НСтр("ru = 'Наличные'"));
		СтрокаОплаты.Вставить("Сумма", ДокументСсылка.СуммаОплатыНаличными);
		ОбщиеПараметры.ТаблицаОплат.Добавить(СтрокаОплаты);
	КонецЕсли;	
	Если ДокументСсылка.СуммаПостоплаты > 0 Тогда
		// Постоплата
		СтрокаОплаты = Новый Структура();
		СтрокаОплаты.Вставить("ТипОплаты", Перечисления.ТипыОплатыККТ.Постоплата);
		СтрокаОплаты.Вставить("Наименование", НСтр("ru = 'Постоплата'"));
		СтрокаОплаты.Вставить("Сумма", ДокументСсылка.СуммаПостоплаты);
		ОбщиеПараметры.ТаблицаОплат.Добавить(СтрокаОплаты);
	КонецЕсли;
	
	Если ДокументСсылка.СуммаПредоплаты > 0 Тогда
		// зачет аванса
		СтрокаОплаты = Новый Структура();
		СтрокаОплаты.Вставить("ТипОплаты", Перечисления.ТипыОплатыККТ.Предоплата);
		СтрокаОплаты.Вставить("Наименование", НСтр("ru = 'Зачет аванса'"));
		СтрокаОплаты.Вставить("Сумма", ДокументСсылка.СуммаПредоплаты);
		ОбщиеПараметры.ТаблицаОплат.Добавить(СтрокаОплаты);
	КонецЕсли;
	
	Возврат ОбщиеПараметры;
	
КонецФункции

Процедура ЗаполнитьПараметрыПлатежногоДоговора(ОбщиеПараметры, ДоговорПлатежногоАгента, СуммаДокумента, ТаблицаТоваровЧека = Неопределено) Экспорт
	
	РеквизитыПлатежногоДоговора = ПараметрыПлатежногоДоговора(ДоговорПлатежногоАгента, СуммаДокумента);
	
	Если ЗначениеЗаполнено(РеквизитыПлатежногоДоговора) И ЗначениеЗаполнено(ОбщиеПараметры.КассаККМ) И ВерсияФФД(ОбщиеПараметры.КассаККМ) <> "1.2" Тогда
		
		ДанныеАгента 		= ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыДанныеАгента();
		ДанныеПоставщика 	= ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыДанныеПоставщика(); 
		
		ДанныеАгента.ПлатежныйАгент.Операция 			= РеквизитыПлатежногоДоговора.ОперацияПлатежногоАгента;
		ДанныеАгента.ПлатежныйАгент.Телефон  			= РеквизитыПлатежногоДоговора.ТелефонПлатежногоАгента;
		ДанныеАгента.ОператорПеревода.Телефон     		= РеквизитыПлатежногоДоговора.ТелефонОператораПеревода;
		ДанныеАгента.ОператорПеревода.Наименование 		= РеквизитыПлатежногоДоговора.НаименованиеОператораПеревода;
		ДанныеАгента.ОператорПеревода.Адрес        		= РеквизитыПлатежногоДоговора.АдресОператораПеревода;
		ДанныеАгента.ОператорПеревода.ИНН          		= РеквизитыПлатежногоДоговора.ИННОператораПеревода;
		ДанныеАгента.ОператорПоПриемуПлатежей.Телефон 	= РеквизитыПлатежногоДоговора.ТелефонОператораПоПриемуПлатежей;
		
		ДанныеПоставщика.Телефон      = РеквизитыПлатежногоДоговора.ТелефонПоставщика;
		ДанныеПоставщика.Наименование = Строка(РеквизитыПлатежногоДоговора.ПоставщикУслуг);
		ДанныеПоставщика.ИНН          = РеквизитыПлатежногоДоговора.ИННПоставщикаУслуг;
		
		ОбщиеПараметры.ПризнакАгента = РеквизитыПлатежногоДоговора.ПризнакАгента;
		Для Каждого СтрокаТовар Из ОбщиеПараметры.ПозицииЧека Цикл    
			СтрокаТовар.ДанныеАгента 					= ДанныеАгента;
			СтрокаТовар.ДанныеПоставщика 				= ДанныеПоставщика;
		КонецЦикла;
		
	КонецЕсли;  
	
	Если ЗначениеЗаполнено(ОбщиеПараметры.КассаККМ) И ВерсияФФД(ОбщиеПараметры.КассаККМ) = "1.2" И ТаблицаТоваровЧека <> Неопределено Тогда
		ЕстьДанныеАгента = НЕ (ТаблицаТоваровЧека.Колонки.Найти("ПараметрыДоговораПлатежногоАгента") = Неопределено);
		Если ЕстьДанныеАгента Тогда 
			Для Каждого СтрокаТовар Из ОбщиеПараметры.ПозицииЧека Цикл 
				Если СтрокаТовар.Свойство("Наименование") Тогда 
					НайденнаяСтрока = ТаблицаТоваровЧека.Найти(СтрокаТовар.Наименование, "Наименование"); 
					Если НайденнаяСтрока <> Неопределено Тогда
						ДоговорАгента = НайденнаяСтрока.ПараметрыДоговораПлатежногоАгента;
						Если ЗначениеЗаполнено(ДоговорАгента) Тогда 
							РеквизитыПлатежногоДоговора = ПараметрыПлатежногоДоговора(ДоговорАгента, СуммаДокумента);
							ДанныеАгента 		= ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыДанныеАгента();
							ДанныеПоставщика 	= ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыДанныеПоставщика(); 
							
							ДанныеАгента.ПлатежныйАгент.Операция 			= РеквизитыПлатежногоДоговора.ОперацияПлатежногоАгента;
							ДанныеАгента.ПлатежныйАгент.Телефон  			= РеквизитыПлатежногоДоговора.ТелефонПлатежногоАгента;
							ДанныеАгента.ОператорПеревода.Телефон     		= РеквизитыПлатежногоДоговора.ТелефонОператораПеревода;
							ДанныеАгента.ОператорПеревода.Наименование 		= РеквизитыПлатежногоДоговора.НаименованиеОператораПеревода;
							ДанныеАгента.ОператорПеревода.Адрес        		= РеквизитыПлатежногоДоговора.АдресОператораПеревода;
							ДанныеАгента.ОператорПеревода.ИНН          		= РеквизитыПлатежногоДоговора.ИННОператораПеревода;
							ДанныеАгента.ОператорПоПриемуПлатежей.Телефон 	= РеквизитыПлатежногоДоговора.ТелефонОператораПоПриемуПлатежей;
							
							ДанныеПоставщика.Телефон      = РеквизитыПлатежногоДоговора.ТелефонПоставщика;
							ДанныеПоставщика.Наименование = Строка(РеквизитыПлатежногоДоговора.ПоставщикУслуг);
							ДанныеПоставщика.ИНН          = РеквизитыПлатежногоДоговора.ИННПоставщикаУслуг;
							
							СтрокаТовар.ПризнакАгентаПоПредметуРасчета 	= РеквизитыПлатежногоДоговора.ПризнакАгента;
							СтрокаТовар.ДанныеАгента 					= ДанныеАгента;
							СтрокаТовар.ДанныеПоставщика 				= ДанныеПоставщика;
						КонецЕсли;	
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		Иначе
			РеквизитыПлатежногоДоговора = ПараметрыПлатежногоДоговора(ДоговорПлатежногоАгента, СуммаДокумента);
			Если ЗначениеЗаполнено(РеквизитыПлатежногоДоговора) И ЗначениеЗаполнено(ОбщиеПараметры.КассаККМ) Тогда
				ДанныеАгента 		= ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыДанныеАгента();
				ДанныеПоставщика 	= ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыДанныеПоставщика(); 
				ДанныеАгента.ПлатежныйАгент.Операция 			= РеквизитыПлатежногоДоговора.ОперацияПлатежногоАгента;
				ДанныеАгента.ПлатежныйАгент.Телефон  			= РеквизитыПлатежногоДоговора.ТелефонПлатежногоАгента;
				ДанныеАгента.ОператорПеревода.Телефон     		= РеквизитыПлатежногоДоговора.ТелефонОператораПеревода;
				ДанныеАгента.ОператорПеревода.Наименование 		= РеквизитыПлатежногоДоговора.НаименованиеОператораПеревода;
				ДанныеАгента.ОператорПеревода.Адрес        		= РеквизитыПлатежногоДоговора.АдресОператораПеревода;
				ДанныеАгента.ОператорПеревода.ИНН          		= РеквизитыПлатежногоДоговора.ИННОператораПеревода;
				ДанныеАгента.ОператорПоПриемуПлатежей.Телефон 	= РеквизитыПлатежногоДоговора.ТелефонОператораПоПриемуПлатежей;
				ДанныеПоставщика.Телефон      = РеквизитыПлатежногоДоговора.ТелефонПоставщика;
				ДанныеПоставщика.Наименование = Строка(РеквизитыПлатежногоДоговора.ПоставщикУслуг);
				ДанныеПоставщика.ИНН          = РеквизитыПлатежногоДоговора.ИННПоставщикаУслуг;
				
				Для Каждого СтрокаТовар Из ОбщиеПараметры.ПозицииЧека Цикл    
					СтрокаТовар.ПризнакАгентаПоПредметуРасчета 	= РеквизитыПлатежногоДоговора.ПризнакАгента;
					СтрокаТовар.ДанныеАгента 					= ДанныеАгента;
					СтрокаТовар.ДанныеПоставщика 				= ДанныеПоставщика;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ПараметрыПлатежногоДоговора(ПлатежныйДоговор, СуммаДокумента) Экспорт
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("ТипДоговора");
	СтруктураРеквизитов.Вставить("ПоставщикУслуг");
	СтруктураРеквизитов.Вставить("Посредник");
	СтруктураРеквизитов.Вставить("ПроцентКомиссионногоВознаграждения");
	СтруктураРеквизитов.Вставить("АдресОператораПеревода");
	СтруктураРеквизитов.Вставить("ИННОператораПеревода");
	СтруктураРеквизитов.Вставить("НаименованиеОператораПеревода");
	СтруктураРеквизитов.Вставить("ОперацияПлатежногоАгента");
	СтруктураРеквизитов.Вставить("ПризнакАгента");
	СтруктураРеквизитов.Вставить("ТелефонПлатежногоАгента");
	СтруктураРеквизитов.Вставить("ТелефонОператораПоПриемуПлатежей");
	СтруктураРеквизитов.Вставить("ТелефонОператораПеревода");
	СтруктураРеквизитов.Вставить("ТелефонПоставщика");
	СтруктураРеквизитов.Вставить("ТелефонПоставщика");
	СтруктураРеквизитов.Вставить("ПризнакАгента");
	СтруктураРеквизитов.Вставить("ИННПоставщикаУслуг");
	
	Если НЕ ЗначениеЗаполнено(ПлатежныйДоговор) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	РеквизитыПлатежногоДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПлатежныйДоговор, СтруктураРеквизитов);
	
	ВознагражденияАгента = СуммаДокумента / 100 * РеквизитыПлатежногоДоговора.ПроцентКомиссионногоВознаграждения;
	РеквизитыПлатежногоДоговора.Вставить("ВознагражденияАгента", ВознагражденияАгента);
	
	Возврат РеквизитыПлатежногоДоговора;
	
КонецФункции

Функция ВерсияФФД(КассаККМЧека) Экспорт
	Результат = "1.0.5";
	Если ЗначениеЗаполнено(КассаККМЧека) Тогда
		ОборудованиеЧека = КассаККМЧека.ПодключаемоеОборудование;
		Если ЗначениеЗаполнено(ОборудованиеЧека) Тогда
			Если ОборудованиеЧека.ТипОборудования = ПредопределенноеЗначение("Перечисление.ТипыПодключаемогоОборудования.ККТ") Тогда
				ПараметрыРегистрацииУстройства = ОборудованиеЧекопечатающиеУстройства.ПараметрыРегистрацииУстройства(ОборудованиеЧека);
				Если ПараметрыРегистрацииУстройства.ЕстьДанные Тогда
					Результат = ПараметрыРегистрацииУстройства.ВерсияФФДККТ;
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат Результат;	
КонецФункции

// Возвращает ставку НДС в формате БПО
//  Параметры:
//   СтавкаНДС - Перечисление.СтавкиНДС
//   ЭтоАванс - Булево
//  
//  ВозвращаемоеЗначение:
//   Значения: Неопределено-БезНДС, 0, 10, 18, 110, 118
Функция СтавкаНДСВФорматеБПО(СтавкаНДС, ЭтоАванс = Ложь) Экспорт
	
	Если СтавкаНДС = Перечисления.СтавкиНДС.БезНДС Тогда
		Возврат Неопределено;
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС0 Тогда
		Возврат 0;
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС10_110 Тогда
		Возврат 110;
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС18_118 Тогда
		Возврат 118;
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС20_120 Тогда
		Возврат 120;
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС5_105 Тогда
		Возврат 105;
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС7_107 Тогда
		Возврат 107;
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС22_122 Тогда
		Возврат 122;	
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС10 Тогда
		Если ЭтоАванс Тогда
			Возврат 110;
		Иначе	
			Возврат 10;
		КонецЕсли;
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС18 Тогда
		Если ЭтоАванс Тогда
			Возврат 118;
		Иначе	
			Возврат 18;
		КонецЕсли;
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС20 Тогда
		Если ЭтоАванс Тогда
			Возврат 120;
		Иначе	
			Возврат 20;
		КонецЕсли;
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС22 Тогда
		Если ЭтоАванс Тогда
			Возврат 122;
		Иначе	
			Возврат 22;
		КонецЕсли;	
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС5 Тогда
		Возврат ?(ЭтоАванс, 105, 5);
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС7 Тогда
		Возврат ?(ЭтоАванс, 107, 7);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции // СтавкаНДСВФорматеБПО()

Функция КодСистемыНалогообложения(Организация, ВидНалога, ДатаДокумента = Неопределено) Экспорт
	
	Если ВидНалога = Перечисления.ВидыСистемыНалогообложенияЧекаККМ.ОСН Тогда
		Возврат Перечисления.ТипыСистемНалогообложенияККТ.ОСН;
	ИначеЕсли ВидНалога = Перечисления.ВидыСистемыНалогообложенияЧекаККМ.УСНДоходы Тогда
		Возврат Перечисления.ТипыСистемНалогообложенияККТ.УСНДоход;
	ИначеЕсли ВидНалога = Перечисления.ВидыСистемыНалогообложенияЧекаККМ.УСНДоходыМинусРасходы Тогда
		Возврат Перечисления.ТипыСистемНалогообложенияККТ.УСНДоходРасход;
	ИначеЕсли ВидНалога = Перечисления.ВидыСистемыНалогообложенияЧекаККМ.ЕНВД Тогда
		Возврат Перечисления.ТипыСистемНалогообложенияККТ.ЕНВД;
	Иначе
		Возврат Перечисления.ТипыСистемНалогообложенияККТ.ОСН;
	КонецЕсли;
	
КонецФункции

// Возвращает числовое значение ставки НДС по значению перечисления.
//
// Параметры:
// СтавкаНДС - ПеречислениеСсылка.СтавкиНДС - значение перечисления СтавкиНДС.
//
Функция ПолучитьСтавкуНДСЧислом(Знач СтавкаНДС) Экспорт
	
	Возврат УчетНДСКлиентСервер.ПолучитьМножительСтавки(СтавкаНДС,, Истина);
	
КонецФункции

Процедура ПреобразоватьТелефонКПользовательсткомуВиду(ВведенноеЧисло, ТелефонСтрокой) Экспорт
	
	Если СтрДлина(ВведенноеЧисло) = 11 Тогда
		ВведенноеЧислоСтрокой = ВведенноеЧисло;
		
		ТелефонСтрокой = "+"+ Сред(ВведенноеЧислоСтрокой, 1, 1) + "(";
		ТелефонСтрокой = ТелефонСтрокой + Сред(ВведенноеЧислоСтрокой, 2, 3);
		ТелефонСтрокой = ТелефонСтрокой + ")";
		ТелефонСтрокой = ТелефонСтрокой + Сред(ВведенноеЧислоСтрокой, 5, 3);
		ТелефонСтрокой = ТелефонСтрокой + "-";
		ТелефонСтрокой = ТелефонСтрокой + Сред(ВведенноеЧислоСтрокой, 8, 2);
		ТелефонСтрокой = ТелефонСтрокой + "-";
		ТелефонСтрокой = ТелефонСтрокой + Сред(ВведенноеЧислоСтрокой, 10, 2);
		
		Возврат;
	КонецЕсли;	
	
	ВведенноеЧислоСтрокой = Формат(ВведенноеЧисло, "ЧГ=0");
	ВведенноеЧислоСтрокой = Лев(ВведенноеЧислоСтрокой, 10);
	Если СтрДлина(ВведенноеЧислоСтрокой) < 10 Тогда
		ВведенноеЧислоСтрокой = Формат(ВведенноеЧисло, "ЧЦ=10; ЧДЦ=; ЧВН=; ЧГ=0");
	КонецЕсли;
	
	ТелефонСтрокой = "+7(";
	ТелефонСтрокой = ТелефонСтрокой + Сред(ВведенноеЧислоСтрокой, 1, 3);
	ТелефонСтрокой = ТелефонСтрокой + ")";
	ТелефонСтрокой = ТелефонСтрокой + Сред(ВведенноеЧислоСтрокой, 4, 3);
	ТелефонСтрокой = ТелефонСтрокой + "-";
	ТелефонСтрокой = ТелефонСтрокой + Сред(ВведенноеЧислоСтрокой, 7, 2);
	ТелефонСтрокой = ТелефонСтрокой + "-";
	ТелефонСтрокой = ТелефонСтрокой + Сред(ВведенноеЧислоСтрокой, 9, 2);
	
КонецПроцедуры

// Записывает телефон контрагенту
//  Параметры:
//   Контрагент - СправочникСсылка.Контрагенты
//   Телефон - Строка(10)
//
Процедура ЗаписатьТелефонКонтрагента(Контрагент, НомерТелефона) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Контрагент)
		ИЛИ НЕ ЗначениеЗаполнено(НомерТелефона) Тогда
		Возврат;
	КонецЕсли;
	
	ДлинаНомера = СтрДлина(НомерТелефона);
	
	Если ДлинаНомера = 10 Тогда
		НомерСтраны = "7";
		КодГорода = Лев(НомерТелефона, 3);
		Номер     = Сред(НомерТелефона, 4);
	ИначеЕсли ДлинаНомера = 11 Тогда
		НомерСтраны = Лев(НомерТелефона, 1);
		КодГорода = Сред(НомерТелефона, 2, 3);
		Номер     = Сред(НомерТелефона, 5);
	Иначе
		Возврат;
	КонецЕсли;
	
	НомераСтран = Новый Массив;
	НомераСтран.Добавить("");
	НомераСтран.Добавить(НомерСтраны);
	
	// Поиск
	КонтрагентОбъект = Контрагент.ПолучитьОбъект();
	ВидКИ = Справочники.ВидыКонтактнойИнформации.ТелефонДомашнийФизическиеЛица;
	ТипКИ = Перечисления.ТипыКонтактнойИнформации.Телефон;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КонтрагентыКонтактнаяИнформация.НомерТелефона КАК НомерТелефона,
	|	КонтрагентыКонтактнаяИнформация.НомерСтроки КАК НомерСтроки,
	|	КонтрагентыКонтактнаяИнформация.Вид КАК Вид,
	|	КонтрагентыКонтактнаяИнформация.Тип КАК Тип
	|ИЗ
	|	Справочник.Контрагенты.КонтактнаяИнформация КАК КонтрагентыКонтактнаяИнформация
	|ГДЕ
	|	КонтрагентыКонтактнаяИнформация.Ссылка = &Контрагент
	|	И КонтрагентыКонтактнаяИнформация.НомерТелефона = &НомерТелефона
	|	И КонтрагентыКонтактнаяИнформация.Тип = &Тип
	|	И КонтрагентыКонтактнаяИнформация.Вид = &Вид
	|	И КонтрагентыКонтактнаяИнформация.Страна В(&НомераСтран)";
	
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("НомерТелефона"  , НомерТелефона);
	Запрос.УстановитьПараметр("Тип"  , ТипКИ);
	Запрос.УстановитьПараметр("Вид"  , ВидКИ);
	Запрос.УстановитьПараметр("НомераСтран"  , НомераСтран);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		// Такой телефон есть
		НомерНайденнойСтроки = Выборка.НомерСтроки;
		ИндексСтроки = НомерНайденнойСтроки - 1;
		Если НЕ(ИндексСтроки = 0) Тогда
			КонтрагентОбъект.КонтактнаяИнформация.Сдвинуть(ИндексСтроки, - ИндексСтроки);
		КонецЕсли;
	Иначе
		// Добавляем телефон
		ПространствоИмен = "http://www.v8.1c.ru/ssl/contactinfo";
		
		Результат = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип(ПространствоИмен, "КонтактнаяИнформация"));
		
		Данные = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип(ПространствоИмен, "НомерТелефона"));
		Данные.Номер     = Номер;
		Данные.КодГорода = КодГорода;
		
		Если ДлинаНомера = 11 Тогда
			Данные.КодСтраны = НомерСтраны;
		КонецЕсли;
		
		Результат.Представление = ПредставлениеТелефона(Данные);
		Результат.Состав        = Данные;
		
		ДанныеВыбора = УправлениеКонтактнойИнформациейЛокализация.КонтактнаяИнформацияXDTOВXML(Результат);
		
		УправлениеКонтактнойИнформацией.ЗаписатьКонтактнуюИнформацию(КонтрагентОбъект,
																	 ДанныеВыбора,
																	 ВидКИ,
																	 ТипКИ);
		
		КоличествоСтрок = КонтрагентОбъект.КонтактнаяИнформация.Количество();
		ИндексСтроки = КоличествоСтрок - 1;
		Если НЕ(ИндексСтроки = 0) Тогда
			КонтрагентОбъект.КонтактнаяИнформация.Сдвинуть(ИндексСтроки, - ИндексСтроки);
		КонецЕсли;
		
		ФизЛицо = Контрагент.ЮридическоеФизическоеЛицо;
		ФизЛицоОбъект = ФизЛицо.ПолучитьОбъект();
		
		УправлениеКонтактнойИнформацией.ЗаписатьКонтактнуюИнформацию(ФизЛицоОбъект,
																	 ДанныеВыбора,
																	 ВидКИ,
																	 ТипКИ);
																	 
		КоличествоСтрок = ФизЛицоОбъект.КонтактнаяИнформация.Количество();
		ИндексСтроки = КоличествоСтрок - 1;
		Если ИндексСтроки > 0 Тогда
			ФизЛицоОбъект.КонтактнаяИнформация.Сдвинуть(ИндексСтроки, - ИндексСтроки);
		КонецЕсли;
		
		Попытка
			ФизЛицоОбъект.Записать();
		Исключение
			ТекстСообщения = НСтр("ru='Не удалось записать телефон физического лица по причине: '" + ОписаниеОшибки());
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,,);
			Возврат;
		КонецПопытки;
		
		Попытка
			КонтрагентОбъект.Записать();
		Исключение
			ТекстСообщения = НСтр("ru='Не удалось записать телефон контрагента по причине: '" + ОписаниеОшибки());
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,,);
			Возврат;
		КонецПопытки;
	КонецЕсли;
	
	
КонецПроцедуры

// Записывает электронную почту в контактную информацию контрагента
//  Параметры:
//   Контрагент - СправочникСсылка.Контрагенты
//   Email - Строка
//
Процедура ЗаписатьEmailКонтрагента(Контрагент, Email) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Контрагент)
		ИЛИ НЕ ЗначениеЗаполнено(Email) Тогда
		Возврат;
	КонецЕсли;
	
	// Поиск
	КонтрагентОбъект = Контрагент.ПолучитьОбъект();
	ВидКИ = Справочники.ВидыКонтактнойИнформации.EmailФизическиеЛица;
	ТипКИ = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
	Email = нрег(Email);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КонтрагентыКонтактнаяИнформация.НомерСтроки,
	|	КонтрагентыКонтактнаяИнформация.АдресЭП,
	|	КонтрагентыКонтактнаяИнформация.Вид,
	|	КонтрагентыКонтактнаяИнформация.Тип
	|ИЗ
	|	Справочник.Контрагенты.КонтактнаяИнформация КАК КонтрагентыКонтактнаяИнформация
	|ГДЕ
	|	КонтрагентыКонтактнаяИнформация.Ссылка = &Контрагент
	|	И КонтрагентыКонтактнаяИнформация.АдресЭП = &АдресЭП
	|	И КонтрагентыКонтактнаяИнформация.Тип = &Тип
	|	И КонтрагентыКонтактнаяИнформация.Вид = &Вид";
	
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("АдресЭП"        , Email);
	Запрос.УстановитьПараметр("Тип"  , ТипКИ);
	Запрос.УстановитьПараметр("Вид"  , ВидКИ);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		// Такой адрес ЭП есть
		НомерНайденнойСтроки = Выборка.НомерСтроки;
		ИндексСтроки = НомерНайденнойСтроки - 1;
		Если НЕ(ИндексСтроки = 0) Тогда
			КонтрагентОбъект.КонтактнаяИнформация.Сдвинуть(ИндексСтроки, - ИндексСтроки);
		КонецЕсли;
	Иначе
		// Добавляем Адрес ЭП
		ЗначенияПолей = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияXMLПоПредставлению(Email, ВидКИ);
		
		УправлениеКонтактнойИнформацией.ЗаписатьКонтактнуюИнформацию(КонтрагентОбъект,
																	 ЗначенияПолей,
																	 ВидКИ,
																	 ТипКИ);
		
		КоличествоСтрок = КонтрагентОбъект.КонтактнаяИнформация.Количество();
		ИндексСтроки = КоличествоСтрок - 1;
		Если ИндексСтроки > 0 Тогда
			КонтрагентОбъект.КонтактнаяИнформация.Сдвинуть(ИндексСтроки, - ИндексСтроки);
		КонецЕсли;
		
		
		ФизЛицо = Контрагент.ЮридическоеФизическоеЛицо;
		ФизЛицоОбъект = ФизЛицо.ПолучитьОбъект();
		УправлениеКонтактнойИнформацией.ЗаписатьКонтактнуюИнформацию(ФизЛицоОбъект,
																	 ЗначенияПолей,
																	 ВидКИ,
																	 ТипКИ);
		КоличествоСтрок = ФизЛицоОбъект.КонтактнаяИнформация.Количество();
		ИндексСтроки = КоличествоСтрок - 1;
		Если ИндексСтроки > 0 Тогда
			ФизЛицоОбъект.КонтактнаяИнформация.Сдвинуть(ИндексСтроки, - ИндексСтроки);
		КонецЕсли;
		
		Попытка
			ФизЛицоОбъект.Записать();
		Исключение
			ТекстСообщения = НСтр("ru='Не удалось записать электронную почту физического лица по причине: '" + ОписаниеОшибки());
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,,);
			Возврат;
		КонецПопытки;
		
		Попытка
			КонтрагентОбъект.Записать();
		Исключение
			ТекстСообщения = НСтр("ru='Не удалось записать электронную почту контрагента по причине: '" + ОписаниеОшибки());
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,,);
			Возврат;
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

// Проверяет, что включена ф.о "Использовать подключаемое оборудование" и настроено оборудование.
//
Функция ИспользоватьПодключаемоеОборудование(ТипыПодключенногоОборудования = Неопределено) Экспорт
	
	ИспользоватьПодключаемоеОборудование = ПодключаемоеОборудованиеБГУВызовСервера.ИспользоватьПодключаемоеОборудование();
	
	Если ТипыПодключенногоОборудования = Неопределено Тогда
		ТипыПодключенногоОборудования = МенеджерОборудованияВызовСервера.ТипыИспользуемогоОборудованияТекущегоРабочегоМеста();
	КонецЕсли;
	
	Возврат
		ИспользоватьПодключаемоеОборудование
		И ТипыПодключенногоОборудования <> Неопределено
		И ТипыПодключенногоОборудования.Количество() > 0;
		
КонецФункции  
	
// Функция выполняет открытие кассовой смены.
//
Функция ОткрытьКассовуюСмену(КассаККМ, ОписаниеОшибки = "", ТекстПереходящегоОстатка = "") Экспорт
	
	Результат = Истина;
	
	СтруктураСостояниеКассовойСмены = ПолучитьСостояниеКассовойСмены(КассаККМ);
	
	ДатаОткрытияКассовойСмены = ТекущаяДатаСеанса();
	
	ТекстПереходящегоОстатка = "";
	Если СтруктураСостояниеКассовойСмены.СтатусКассовойСмены = Перечисления.СтатусыКассовойСмены.Открыта Тогда
		
		// Если смена открыта, то с момента открытия должно пройти не больше чем 24 часа.
		Если ДатаОткрытияКассовойСмены - СтруктураСостояниеКассовойСмены.ДатаИзмененияСтатуса < 86400 Тогда
			
			// Все в порядке
			
		Иначе
			
			Результат = Ложь;
			// Вероятно, что смена была не закрыта.
			ОписаниеОшибки = НСтр("ru = 'С момента открытия кассовой смены истекло более 24 часов.'");
			
		КонецЕсли;
		
	Иначе
		
		// Смена закрыта. Откроем новую кассовую смену.
		
		НоваяКассоваяСмена = Документы.КассоваяСмена.СоздатьДокумент();
		
		НоваяКассоваяСмена.КассаККМ				  = КассаККМ;
		НоваяКассоваяСмена.Организация			  = КассаККМ.Организация;
		НоваяКассоваяСмена.ФискальноеУстройство	  = КассаККМ.ПодключаемоеОборудование;
		НоваяКассоваяСмена.Дата                   = ДатаОткрытияКассовойСмены;
		НоваяКассоваяСмена.Статус    = Перечисления.СтатусыКассовойСмены.Открыта;
		НоваяКассоваяСмена.НачалоКассовойСмены    = ДатаОткрытияКассовойСмены;
		НоваяКассоваяСмена.ОкончаниеКассовойСмены = '00010101';
		//НоваяКассоваяСмена.Кассир               = Пользователи.ТекущийПользователь();
		
		Если НоваяКассоваяСмена.ПроверитьЗаполнение() Тогда
			НоваяКассоваяСмена.Записать(РежимЗаписиДокумента.Проведение);
			
			СуммаОстатка = СуммаОстаткаДСПоКассеККМ(КассаККМ);
			Если СуммаОстатка <> 0 Тогда
				ТекстПереходящегоОстатка = НСтр("ru = 'Сумма остатка в кассе: %1 руб.'");
				ТекстПереходящегоОстатка = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстПереходящегоОстатка, 
																						 Формат(СуммаОстатка, "ЧЦ=15; ЧДЦ=2; ЧРГ=' '; ЧН=0,00; ЧГ=3,0"));
			КонецЕсли;
		Иначе
			Результат = Ложь;
			ОписаниеОшибки = НСтр("ru = 'Проверьте настройки кассы ККМ.'");
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции
	
// Функция возвращает текущую сумму положительного остатка денежных средств (ДС) по кассе ККМ.
// Параметры:
//  КассаККМ - СправочникСсылка.КассыККМ
// Возвращаемое значение:
//  Число
//
Функция СуммаОстаткаДСПоКассеККМ(КассаККМ, ДоговорПлатежногоАгента = Неопределено) Экспорт

	СуммаОстатка = 0;
	
	Возврат СуммаОстатка;
КонецФункции // СуммаОстаткаДСПоКассеККМ()

// Функция возвращает структуру, характеризующую состояние последней кассовой смены по кассе ККМ.
//
Функция ПолучитьСостояниеКассовойСмены(КассаККМ) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	КассоваяСмена.Номер КАК НомерКассовойСмены,
	|	КассоваяСмена.Ссылка КАК КассоваяСмена,
	|	КассоваяСмена.Статус КАК СтатусКассовойСмены,
	|	КассоваяСмена.КассаККМ КАК КассаККМ,
	|	КассоваяСмена.Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА КассоваяСмена.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыКассовойСмены.Открыта)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК СменаОткрыта,
	|	ВЫБОР
	|		КОГДА КассоваяСмена.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыКассовойСмены.Открыта)
	|			ТОГДА КассоваяСмена.НачалоКассовойСмены
	|		ИНАЧЕ КассоваяСмена.ОкончаниеКассовойСмены
	|	КОНЕЦ КАК ДатаИзмененияСтатуса
	|ИЗ
	|	Документ.КассоваяСмена КАК КассоваяСмена
	|ГДЕ
	|	КассоваяСмена.Проведен
	|	И КассоваяСмена.КассаККМ = &КассаККМ
	|
	|УПОРЯДОЧИТЬ ПО
	|	КассоваяСмена.Дата УБЫВ,
	|	КассоваяСмена УБЫВ";
	
	Запрос.УстановитьПараметр("КассаККМ", КассаККМ);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	ОписаниеКассовойСмены = ПолучитьСтруктуруОписанияКассовойСмены();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ОписаниеКассовойСмены, Выборка);
	Иначе
		
		ОписаниеКассовойСмены.НаличностьВКассе    = 0;
	КонецЕсли;
	
	Возврат ОписаниеКассовойСмены;
	
КонецФункции

// Процедура выполняет закрытие кассовой смены.
//
Функция ЗакрытьКассовуюСмену(КассаККМ, ОписаниеОшибки = "", СсылкаНаОтчет = Неопределено) Экспорт
	
	Результат = Истина;
	
	СтруктураСостояниеКассовойСмены = ПолучитьСостояниеКассовойСмены(КассаККМ);
	
	Если СтруктураСостояниеКассовойСмены.СтатусКассовойСмены = Перечисления.СтатусыКассовойСмены.Открыта Тогда
		
		КассоваяСменаОбъект = СтруктураСостояниеКассовойСмены.КассоваяСмена.ПолучитьОбъект();
		КассоваяСменаОбъект.Дата                   = ТекущаяДатаСеанса();
		КассоваяСменаОбъект.Статус    = Перечисления.СтатусыКассовойСмены.Закрыта;
		КассоваяСменаОбъект.ОкончаниеКассовойСмены = КассоваяСменаОбъект.Дата;
		
		Попытка
			КассоваяСменаОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Если НЕ СсылкаНаОтчет = Неопределено Тогда
				
				ОбъектОтчет = СсылкаНаОтчет.ПолучитьОбъект();
				ОбъектОтчет.КассоваяСмена = СтруктураСостояниеКассовойСмены.КассоваяСмена;
				ОбъектОтчет.Записать(РежимЗаписиДокумента.Запись);
			КонецЕсли;
		Исключение
			
			Результат = Ложь;
			
			ОписаниеОшибки = НСтр("ru = 'При закрытии кассовой смены произошла ошибка.
			                            |Дополнительное описание:
			                            |%ДополнительноеОписание%'");
			ОписаниеОшибки = СтрЗаменить(ОписаниеОшибки, "%ДополнительноеОписание%", ИнформацияОбОшибке().Описание);
			
		КонецПопытки;
		
	Иначе
		
		// Смена не открыта.
		Попытка
			Если НЕ СсылкаНаОтчет = Неопределено Тогда
				ОбъектОтчет = СсылкаНаОтчет.ПолучитьОбъект();
				ОбъектОтчет.КассоваяСмена = СтруктураСостояниеКассовойСмены.КассоваяСмена;
				ОбъектОтчет.Записать(РежимЗаписиДокумента.Запись);
			КонецЕсли;
		Исключение
			
			Результат = Ложь;
			
			ОписаниеОшибки = НСтр("ru = 'При закрытии кассовой смены произошла ошибка.
			                            |Дополнительное описание:
			                            |%ДополнительноеОписание%'");
			ОписаниеОшибки = СтрЗаменить(ОписаниеОшибки, "%ДополнительноеОписание%", ИнформацияОбОшибке().Описание);
			
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ИспользуетсяККТСПередачейДанных(КассаККМ) Экспорт
	Результат = Истина;
	СтруктураДанныхКассы = ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьПараметрыКассыККМ(КассаККМ);
	ПодключаемоеОборудование = СтруктураДанныхКассы.ИдентификаторУстройства;
	Если ЗначениеЗаполнено(ПодключаемоеОборудование) Тогда
		Если ПодключаемоеОборудование.ТипОборудования = Перечисления.ТипыПодключаемогоОборудования.ФискальныйРегистратор Тогда
			Результат = Ложь;
		КонецЕсли;
	КонецЕсли;
	Если СтруктураДанныхКассы.ИспользоватьБезПодключенияОборудования Тогда
		Результат = Ложь;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

Функция НомерЧека(ДокументОснование) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	ТипДокумента = Перечисления.ТипыФискальныхДокументовККТ.КассовыйЧек;
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЧекККМИсправительный") Тогда
		Если ДокументОснование.ВидОперации = 
			Перечисления.ВидыИсправительныхЧековККМБГУ.НеприменениеККТ Тогда
			ТипДокумента = Перечисления.ТипыФискальныхДокументовККТ.КассовыйЧекКоррекции;
		КонецЕсли;	
	КонецЕсли;	
	
	Результат = 0;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ФискальныеОперации.НомерЧекаККМ КАК НомерЧекаККМ
	               |ИЗ
	               |	РегистрСведений.ФискальныеОперации КАК ФискальныеОперации
	               |ГДЕ
	               |	ФискальныеОперации.ДокументОснование = &ДокументОснование
	               |	И ФискальныеОперации.ТипДокумента = &ТипДокумента
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ФискальныеОперации.Дата УБЫВ";
	
	
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	Запрос.УстановитьПараметр("ТипДокумента", ТипДокумента);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка.НомерЧекаККМ;	
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

Функция ДанныеЧека(ДокументОснование, ТипДокумента = Неопределено, ИдентификаторЗаписи = Неопределено) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
