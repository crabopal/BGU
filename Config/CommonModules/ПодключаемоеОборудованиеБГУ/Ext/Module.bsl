			ТипДокумента = Перечисления.ТипыФискальныхДокументовККТ.КассовыйЧекКоррекции;
		Иначе
			ТипДокумента = Перечисления.ТипыФискальныхДокументовККТ.КассовыйЧек;
		КонецЕсли;	
