Функция НаименованиеПредметаПоНоменклатуреЧекаККМДоговора(Договор) Экспорт
	Результат = "";
	Если НЕ ЗначениеЗаполнено(Договор) Тогда
		Возврат Результат;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(Договор.НоменклатураПлатежаДляЧекаККМ) Тогда
		Номенклатура = Договор.НоменклатураПлатежаДляЧекаККМ;
		ТекстПредметаРасчета = СокрЛП(Номенклатура.НаименованиеПолное);
		Если ЗначениеЗаполнено(Номенклатура.НаименованиеДляЧекаККМ) Тогда
			ТекстПредметаРасчета = СокрЛП(Номенклатура.НаименованиеДляЧекаККМ);
		КонецЕсли;
	Иначе
		Возврат Результат;
	КонецЕсли;
	
	Результат = ТекстПредметаРасчета;
	
	Возврат Результат;
КонецФункции	

Функция ТаблицаНоменклатурыЧекаККМДляДокументовОснований(ДокументыОснованияЧекаККМ) Экспорт
	МассивАкты		= Новый Массив;
	МассивТОРГ12	= Новый Массив;
	МассивМ15		= Новый Массив;
	МассивСчета		= Новый Массив;
	МассивКвитанции = Новый Массив;
	МассивРозницаВозврат = Новый Массив;
	
	Для каждого ТекСтрока Из ДокументыОснованияЧекаККМ Цикл
		Если ТипЗнч(ТекСтрока.ДокументОснованиеЧекаККМ) = Тип("ДокументСсылка.АктОбОказанииУслуг") Тогда
			МассивАкты.Добавить(ТекСтрока.ДокументОснованиеЧекаККМ);
		ИначеЕсли ТипЗнч(ТекСтрока.ДокументОснованиеЧекаККМ) = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12") Тогда
			МассивТОРГ12.Добавить(ТекСтрока.ДокументОснованиеЧекаККМ);
		ИначеЕсли ТипЗнч(ТекСтрока.ДокументОснованиеЧекаККМ) = Тип("ДокументСсылка.НакладнаяНаОтпускМ15") Тогда
			МассивМ15.Добавить(ТекСтрока.ДокументОснованиеЧекаККМ);
		ИначеЕсли ТипЗнч(ТекСтрока.ДокументОснованиеЧекаККМ) = Тип("ДокументСсылка.СчетНаОплату") Тогда
			МассивСчета.Добавить(ТекСтрока.ДокументОснованиеЧекаККМ);
		ИначеЕсли ТипЗнч(ТекСтрока.ДокументОснованиеЧекаККМ) = Тип("ДокументСсылка.КвитанцияНаОплатуГосуслуг") Тогда
			МассивКвитанции.Добавить(ТекСтрока.ДокументОснованиеЧекаККМ);
		ИначеЕсли ТипЗнч(ТекСтрока.ДокументОснованиеЧекаККМ) = Тип("ДокументСсылка.ЗаявлениеНаВозвратПоЧекуККМ") Тогда
			МассивРозницаВозврат.Добавить(ТекСтрока.ДокументОснованиеЧекаККМ);
		КонецЕсли;	
	КонецЦикла;
	
	Если ТипЗнч(ДокументыОснованияЧекаККМ) = Тип("ТаблицаЗначений") Тогда
		ТаблицаДокументыЧекаККМ = ДокументыОснованияЧекаККМ;
	Иначе	
		ТаблицаДокументыЧекаККМ = ДокументыОснованияЧекаККМ.Выгрузить(,"ДокументОснованиеЧекаККМ, ПризнакСпособаРасчета");
	КонецЕсли;	
	
