Функция СостояниеПослеОтменыАннулирования(ЭлектронныйДокумент, СоставМаршрута)
	
	// Если один из подписантов отказывался от подписания, то состояние после отмены аннулирования = "Требуется уточнение"
	Если СоставМаршрута.Найти(ПредопределенноеЗначение(
			"Перечисление.СостоянияДокументовВнутреннегоЭДО.ТребуетсяУточнение"), "Состояние") <> Неопределено Тогда
		Состояние = ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.ТребуетсяУточнение");
	ИначеЕсли СоставМаршрута.Найти(ПредопределенноеЗначение(
			"Перечисление.СостоянияДокументовВнутреннегоЭДО.ТребуетсяПодписание"), "Состояние") <> Неопределено Тогда
		Состояние = ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.ТребуетсяПодписание");
	Иначе
		Состояние = ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.Завершен");
	КонецЕсли;
	
	Возврат Состояние;
	
КонецФункции

Процедура ОтметитьПодписаниеВМаршрутеЭлектронногоДокумента(Параметры, СоставМаршрута)
	
	СостояниеТребуетсяПодписание = ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.ТребуетсяПодписание");
	СостояниеПодписано = ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.Завершен");
	
	ЭлектронныйДокумент = Параметры.ЭлектронныйДокумент;
	Подписант = Параметры.Подписант;
	ВидПодписи = Параметры.ВидПодписи;
	ДатаПодписи = Параметры.ДатаПодписи;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Подписант", Подписант);
	ПараметрыОтбора.Вставить("ВидПодписи", ВидПодписи);
	ПараметрыОтбора.Вставить("Состояние", СостояниеТребуетсяПодписание);
	
	СтрокиМаршрута = СоставМаршрута.НайтиСтроки(ПараметрыОтбора);
	
	Если СтрокиМаршрута.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Подпись пользователя не требуется'");
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.СоставМаршрутаЭлектронногоДокумента.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ЭлектронныйДокумент.Установить(ЭлектронныйДокумент);
	НаборЗаписей.Отбор.Идентификатор.Установить(СтрокиМаршрута[0].Идентификатор);
	
