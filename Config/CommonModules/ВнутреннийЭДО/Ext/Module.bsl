#Область УведомленияОЗадачах

Функция СистемнаяУчетнаяЗаписьНастроена(ОписаниеОшибки)
	
	Если Не ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.РаботаСПочтовымиСообщениями") Тогда
		ОписаниеОшибки = НСтр("ru = 'Отправка почты не предусмотрена в программе.'");
	Иначе
		МодульРаботаСПочтовымиСообщениями = ОбщегоНазначения.ОбщийМодуль("РаботаСПочтовымиСообщениями");
		Если МодульРаботаСПочтовымиСообщениями.УчетнаяЗаписьНастроена(МодульРаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись(), Истина, Ложь) Тогда
			Возврат Истина;
		КонецЕсли;
		ОписаниеОшибки = НСтр("ru = 'Системная учетная запись электронной почты не настроена для отправки.'");
	КонецЕсли;
	
	Возврат Ложь;
КонецФункции

Функция ВыбратьЗадачиПоИсполнителям()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УведомленияОЗадачахВнутреннегоЭДО.ЭлектронныйДокумент КАК ДокументСсылка,
	|	ВЫБОР
	|		КОГДА УведомленияОЗадачахВнутреннегоЭДО.ЭлектронныйДокумент.ДатаДокумента = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА УведомленияОЗадачахВнутреннегоЭДО.ЭлектронныйДокумент.Дата
	|		ИНАЧЕ УведомленияОЗадачахВнутреннегоЭДО.ЭлектронныйДокумент.ДатаДокумента
	|	КОНЕЦ КАК ДатаДокумента,
	|	УведомленияОЗадачахВнутреннегоЭДО.ЭлектронныйДокумент.НомерДокумента КАК НомерДокумента,
	|	УведомленияОЗадачахВнутреннегоЭДО.ЭлектронныйДокумент.УчетныйДокумент КАК УчетныйДокумент,
	|	УведомленияОЗадачахВнутреннегоЭДО.Подписант КАК Исполнитель,
	|	УведомленияОЗадачахВнутреннегоЭДО.ДатаИзменения КАК ДатаИзменения,
	|	УведомленияОЗадачахВнутреннегоЭДО.ВидПодписи КАК ВидПодписи
	|ИЗ
	|	РегистрСведений.УведомленияОЗадачахВнутреннегоЭДО КАК УведомленияОЗадачахВнутреннегоЭДО
	|ИТОГИ ПО
	|	Исполнитель";
	
	Результат = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Возврат Результат;
	
КонецФункции

Функция ОтправитьУведомлениеОНовыхЗадачах(Исполнитель, ЗадачиПоИсполнителю, ПараметрыРассылки)
	
	ПочтовыйАдресПолучателя = АдресЭлектроннойПочты(Исполнитель);
	Если ПустаяСтрока(ПочтовыйАдресПолучателя) Тогда
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Внутренний ЭДО. Уведомление о новых задачах'",
			ОбщегоНазначения.КодОсновногоЯзыка()), 
			УровеньЖурналаРегистрации.Информация,,,
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Уведомление не отправлено, так как не указан почтовый адрес у пользователя %1.'"), Строка(Исполнитель)));
		Возврат Ложь;
	КонецЕсли;
	
	ТекстПисьма = "";
	Для Каждого Задача Из ЗадачиПоИсполнителю.Строки Цикл
		ТекстПисьма = ТекстПисьма + СформироватьПредставлениеЗадачи(Задача, ПараметрыРассылки);
	КонецЦикла;
	ТемаПисьма = НСтр("ru = 'Новые задачи по обработке документов'");
	
	ПараметрыПисьма = Новый Структура;
	ПараметрыПисьма.Вставить("Тема", ТемаПисьма);
	ПараметрыПисьма.Вставить("Тело", ТекстПисьма);
	ПараметрыПисьма.Вставить("Кому", ПочтовыйАдресПолучателя);
	
	МодульРаботаСПочтовымиСообщениями = ОбщегоНазначения.ОбщийМодуль("РаботаСПочтовымиСообщениями");
	Попытка
		УчетнаяЗапись = МодульРаботаСПочтовымиСообщениями.СистемнаяУчетнаяЗапись();
		Письмо = МодульРаботаСПочтовымиСообщениями.ПодготовитьПисьмо(УчетнаяЗапись, ПараметрыПисьма);
		МодульРаботаСПочтовымиСообщениями.ОтправитьПисьмо(УчетнаяЗапись, Письмо);
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Процессы обработки документов.Уведомление о новых задачах'",
			ОбщегоНазначения.КодОсновногоЯзыка()), 
			УровеньЖурналаРегистрации.Ошибка,,,
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Ошибка при отправке уведомления о новых задачах: %1'"), 
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат Ложь;
	КонецПопытки;
	
	ЗаписьЖурналаРегистрации(НСтр("ru = 'Внутренний ЭДО. Уведомление о новых задачах'",
		ОбщегоНазначения.КодОсновногоЯзыка()),
		УровеньЖурналаРегистрации.Информация,,,
		СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Уведомления успешно отправлены на адрес %1.'"), ПочтовыйАдресПолучателя));
	Возврат Истина;
	
КонецФункции

// Возвращает адрес электронной почты пользователя Получатель для рассылки уведомлений о задачах.
//
// Параметры:
//  Получатель  - СправочникСсылка.Пользователи - исполнитель задачи.
//  Адрес       - Строка - возвращаемый адрес электронной почты.
//
//
Функция АдресЭлектроннойПочты(Получатель)
	
	Адрес = "";
	
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.КонтактнаяИнформация") Тогда
		МодульУправлениеКонтактнойИнформацией = ОбщегоНазначения.ОбщийМодуль("УправлениеКонтактнойИнформацией");
		Если ТипЗнч(Получатель) = Тип("СправочникСсылка.Пользователи") Тогда
			Адрес = МодульУправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
				Получатель, МодульУправлениеКонтактнойИнформацией.ВидКонтактнойИнформацииПоИмени("EmailПользователя"));
		КонецЕсли;
	КонецЕсли;
	
	Возврат Адрес;
	
КонецФункции

Функция СформироватьПредставлениеЗадачи(ЗадачаСтруктура, ПараметрыРассылки)
	
	Результат = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Документ на подпись: %1'"), ЗадачаСтруктура.ДокументСсылка) + Символы.ПС;
	Если ЗначениеЗаполнено(ЗадачаСтруктура.ДатаДокумента) Тогда
		Результат = Результат + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Дата документа: %1'"), Формат(ЗадачаСтруктура.ДатаДокумента, "ДФ=""dd.MM.yyyy""")) + Символы.ПС;
	КонецЕсли;
	Если ЗначениеЗаполнено(ЗадачаСтруктура.ДатаИзменения) Тогда
		Результат = Результат + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Дата создания задачи: %1'"), Формат(ЗадачаСтруктура.ДатаИзменения, "ДФ=""dd.MM.yyyy HH:mm""")) + Символы.ПС;
	КонецЕсли;
	Если ЗначениеЗаполнено(ЗадачаСтруктура.Исполнитель) Тогда
		Результат = Результат + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Исполнитель: %1'"), ЗадачаСтруктура.Исполнитель) + Символы.ПС;
	КонецЕсли;
	Если ЗначениеЗаполнено(ЗадачаСтруктура.ВидПодписи) Тогда
		Результат = Результат + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Вид подписи: %1'"), ЗадачаСтруктура.ВидПодписи) + Символы.ПС;
	КонецЕсли;
	
	ВывестиСсылки(Результат, ЗадачаСтруктура.ДокументСсылка, ПараметрыРассылки);
	
	Возврат Результат + Символы.ПС;
	
КонецФункции

Процедура ВывестиСсылки(Результат, Ссылка, ПараметрыРассылки)
	
	Результат = Результат + Символы.ПС;
	
	Если ЗначениеЗаполнено(ПараметрыРассылки.АдресИБВЛокальнойСети) Тогда
		// Выводится ссылка в локальной сети
		Результат = Результат +
			НСтр("ru='Ссылка: '")
			+ Символы.ПС
			+ НавигационнаяСсылкаДляУведомления(Ссылка, ПараметрыРассылки.АдресИБВЛокальнойСети)
			+ Символы.ПС;
	Иначе
		// Если не указан адрес в локальной сети и не указан внешний адрес,
		// то выводится внутренняя ссылка.
		Если НЕ ЗначениеЗаполнено(ПараметрыРассылки.АдресИБВИнтернет) Тогда
			Результат = Результат +
				НСтр("ru='Ссылка: '")
				+ Символы.ПС
				+ ПолучитьНавигационнуюСсылку(Ссылка)
				+ Символы.ПС;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметрырассылки.АдресИБВИнтернет) Тогда
		// Выводится внешняя ссылка
		Результат = Результат +
			НСтр("ru='Внешняя ссылка: '")
			+ Символы.ПС
			+ НавигационнаяСсылкаДляУведомления(Ссылка, ПараметрыРассылки.АдресИБВИнтернет, Истина)
			+ Символы.ПС;
	КонецЕсли;
	
КонецПроцедуры

Функция НавигационнаяСсылкаДляУведомления(Ссылка, АдресПубликацииИБ, ВебПубликация=Ложь)
	
	АдресПубликацииИБ = СОКРЛП(АдресПубликацииИБ);
	
	Если ВебПубликация И Прав(АдресПубликацииИБ, 1) <> "/" Тогда
		АдресПубликацииИБ = АдресПубликацииИБ + "/";
	КонецЕсли;
	
	Возврат АдресПубликацииИБ + "#" + ПолучитьНавигационнуюСсылку(Ссылка);
	
КонецФункции

Функция ПолучитьДанныеПодписантов(Знач Источник)
	
	ПодписантыДляУведомления = Новый Массив;
	
	// Записи для отправки уведомлений создаются при следующих условиях: 
	// - При включенной настройке параметров учета ИспользоватьУведомленияОЗадачахВнутреннийЭДО;
	// - Для строки маршрута указан пользователь и у него задан адрес электронной почты;
	// - Для строки маршрута задано состояние "Требуется подписание";
	
	ТаблицаНабораИсточника = Источник.Выгрузить();
	
	ОтборПоГруппе = Новый Структура();
	ОтборПоГруппе.Вставить("Группа", "И");
	СтрокиПоГруппе = ТаблицаНабораИсточника.НайтиСтроки(ОтборПоГруппе);
	
	ПорядокГрупп = Новый Массив;
	Для Каждого СтрокаПоГруппе Из СтрокиПоГруппе Цикл
		ПорядокГрупп.Добавить(СтрокаПоГруппе.Порядок);
	КонецЦикла;
	
	ОтборПоСостояниюЗавершен = Новый Структура();
	ОтборПоСостояниюЗавершен.Вставить("Группа", "");
	ОтборПоСостояниюЗавершен.Вставить("Состояние", Перечисления.СостоянияДокументовВнутреннегоЭДО.Завершен);
	СтрокиПоСостояниюЗавершен = ТаблицаНабораИсточника.НайтиСтроки(ОтборПоСостояниюЗавершен);
	
	ПорядокДляИсключения = Новый Массив;
	Для Каждого СтрокаПоСостоянию Из СтрокиПоСостояниюЗавершен Цикл
		Если ПорядокГрупп.Найти(СтрокаПоСостоянию.Порядок) <> Неопределено Тогда
			ПорядокДляИсключения.Добавить(СтрокаПоСостоянию.Порядок);
		КонецЕсли;
	КонецЦикла;
	
	ОтборДляУведомлений = Новый Структура();
	ОтборДляУведомлений.Вставить("Группа", "");
	ОтборДляУведомлений.Вставить("Состояние", Перечисления.СостоянияДокументовВнутреннегоЭДО.ТребуетсяПодписание);
	СтрокиДляУведомлений = ТаблицаНабораИсточника.НайтиСтроки(ОтборДляУведомлений);
	
	Для Каждого СтрокаМаршрута Из СтрокиДляУведомлений Цикл
		Если ЗначениеЗаполнено(СтрокаМаршрута.Подписант) Тогда
			Если ПорядокДляИсключения.Найти(СтрокаМаршрута.Порядок) = Неопределено Тогда
				ПочтовыйАдресПолучателя = АдресЭлектроннойПочты(СтрокаМаршрута.Подписант);
				Если ЗначениеЗаполнено(ПочтовыйАдресПолучателя) Тогда
					
					ДанныеУведомления = Новый Структура;
					ДанныеУведомления.Вставить("ЭлектронныйДокумент",	СтрокаМаршрута.ЭлектронныйДокумент);
					ДанныеУведомления.Вставить("Подписант",				СтрокаМаршрута.Подписант);
					ДанныеУведомления.Вставить("ВидПодписи",			СтрокаМаршрута.ВидПодписи);
					ДанныеУведомления.Вставить("ДатаИзменения",			ТекущаяДатаСеанса());
					
					ПодписантыДляУведомления.Добавить(ДанныеУведомления);
				Иначе
					ЗаписьЖурналаРегистрации(НСтр("ru = 'Внутренний ЭДО. Запись уведомления о задаче для отправки пользователю'",
						ОбщегоНазначения.КодОсновногоЯзыка()), 
						УровеньЖурналаРегистрации.Информация,,,
						СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Уведомление не записано, так как не указан почтовый адрес у пользователя %1.'"), Строка(СтрокаМаршрута.Подписант)));
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ПодписантыДляУведомления;
	
КонецФункции

#КонецОбласти

#КонецОбласти
