Функция НастройкаВнутреннегоЭДО(Организация, ИмяНастройки, ЗначениеПоУмолчанию)
	
	Результат = ЗначениеПоУмолчанию;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НастройкиЭДОБГУ.ВнутреннийЭДОПроверятьНаличиеКлючаПЭПВРеестре КАК ЗначениеНастройки
	|ИЗ
	|	РегистрСведений.НастройкиЭДОБГУ КАК НастройкиЭДОБГУ
	|ГДЕ
	|	НастройкиЭДОБГУ.Организация = &Организация";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВнутреннийЭДОПроверятьНаличиеКлючаПЭПВРеестре", ИмяНастройки);
	
	Запрос.УстановитьПараметр("Организация", Организация);
	
	УстановитьПривилегированныйРежим(Истина);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Выборка.ЗначениеНастройки;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция РезультатЗапросаАктуальногоЭлектроногоДокумента(УчетныйДокумент, ИдентификаторКомандыПечати)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СостоянияЭлектронныхДокументов.ЭлектронныйДокумент КАК ЭлектронныйДокумент
	|ИЗ
	|	РегистрСведений.СостоянияЭлектронныхДокументов КАК СостоянияЭлектронныхДокументов
	|ГДЕ
	|	СостоянияЭлектронныхДокументов.Актуальный
	|	И СостоянияЭлектронныхДокументов.ЭлектронныйДокумент.УчетныйДокумент = &УчетныйДокумент
	|	И СостоянияЭлектронныхДокументов.ЭлектронныйДокумент.ИдентификаторКомандыПечати = &ИдентификаторКомандыПечати";
	
	Запрос.УстановитьПараметр("УчетныйДокумент", УчетныйДокумент);
	Запрос.УстановитьПараметр("ИдентификаторКомандыПечати", ИдентификаторКомандыПечати);
	
	Возврат Запрос.Выполнить();
	
КонецФункции

// Формирует пустую таблицу команд печати для исключения из сценариев внутреннего ЭДО
//
// // Возвращаемое значение:
//           ТаблицаИсключений  - ТаблицаЗначений - таблица команд для исключения из внутреннего ЭДО
//                ** УчетныйДокумент    - ДокументСсылка - документ для которого применяется исключение.
//                ** ИдентификаторКомандыПечати - Строка - идентификатор команды.
//                ** ПричинаИсключенияКомандыПечати - Строка - текстовое сообщение для пользователя о причинах исключения из внутреннего ЭДО.
Функция ПодготовитьТаблицуИсключенийКомандПечати() Экспорт
	
	ТаблицаИсключений = Новый ТаблицаЗначений;
	ТаблицаИсключений.Колонки.Добавить("УчетныйДокумент",				 Метаданные.ОпределяемыеТипы.ОснованиеВнутреннегоЭлектронногоДокумента.Тип);
	ТаблицаИсключений.Колонки.Добавить("ИдентификаторКомандыПечати",     Новый ОписаниеТипов("Строка"));
	ТаблицаИсключений.Колонки.Добавить("ПричинаИсключенияКомандыПечати", Новый ОписаниеТипов("Строка"));
	ТаблицаИсключений.Индексы.Добавить("УчетныйДокумент,ИдентификаторКомандыПечати");
	
	Возврат ТаблицаИсключений; 

КонецФункции

