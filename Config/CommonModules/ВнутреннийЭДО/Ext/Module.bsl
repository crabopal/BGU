Процедура ОтметитьАннулированиеВМаршрутеЭлектронногоДокумента(Параметры, СоставМаршрута)
	
	СостояниеТребуетсяПодписание = ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.ТребуетсяПодписание");
	СостояниеАннулирован = ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.Аннулирован");
	
	ЭлектронныйДокумент = Параметры.ЭлектронныйДокумент;
	Подписант = Параметры.Подписант;
	ВидПодписи = Параметры.ВидПодписи;
	
	Если ЗначениеЗаполнено(ВидПодписи) Тогда
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Подписант", Подписант);
		ПараметрыОтбора.Вставить("ВидПодписи", ВидПодписи);
		ПараметрыОтбора.Вставить("Состояние", СостояниеТребуетсяПодписание);
		
		СтрокиМаршрута = СоставМаршрута.НайтиСтроки(ПараметрыОтбора);
		
		Если СтрокиМаршрута.Количество() = 0 Тогда
			ВызватьИсключение НСтр("ru = 'Подпись пользователя не требуется'");
		КонецЕсли;
		
		НаборЗаписей = РегистрыСведений.СоставМаршрутаЭлектронногоДокумента.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ЭлектронныйДокумент.Установить(ЭлектронныйДокумент);
		НаборЗаписей.Отбор.Идентификатор.Установить(СтрокиМаршрута[0].Идентификатор);
		
		Запись = НаборЗаписей.Добавить();
		ЗаполнитьЗначенияСвойств(Запись, СтрокиМаршрута[0]);
		Запись.ЭлектронныйДокумент = ЭлектронныйДокумент;
		Запись.Состояние = СостояниеАннулирован;
		
		НаборЗаписей.Записать();
		
		СтрокиМаршрута[0].Состояние = СостояниеАннулирован;
		
	КонецЕсли;
	
	// При аннулировании необходимо также установить состояние у корневого элемента маршрута
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ИдентификаторРодителя", ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор());
	
	СтрокиМаршрута = СоставМаршрута.НайтиСтроки(ПараметрыОтбора);
	
	НаборЗаписей = РегистрыСведений.СоставМаршрутаЭлектронногоДокумента.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ЭлектронныйДокумент.Установить(ЭлектронныйДокумент);
	НаборЗаписей.Отбор.Идентификатор.Установить(СтрокиМаршрута[0].Идентификатор);
	
	Запись = НаборЗаписей.Добавить();
	ЗаполнитьЗначенияСвойств(Запись, СтрокиМаршрута[0]);
	Запись.ЭлектронныйДокумент = ЭлектронныйДокумент;
	Запись.Состояние = СостояниеАннулирован;
	
	НаборЗаписей.Записать();
	
	СтрокиМаршрута[0].Состояние = СостояниеАннулирован;
	
КонецПроцедуры

Процедура ОтметитьОтменуАннулированияВМаршрутеЭлектронногоДокумента(Параметры, СоставМаршрута)
	
	СостояниеТребуетсяПодписание = ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.ТребуетсяПодписание");
	СостояниеАннулирован = ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.Аннулирован");
	
	ЭлектронныйДокумент = Параметры.ЭлектронныйДокумент;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Состояние", СостояниеАннулирован);
	
	СтрокиМаршрута = СоставМаршрута.НайтиСтроки(ПараметрыОтбора);
	
	Если СтрокиМаршрута.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Документ не аннулирован'");
	КонецЕсли;
	
	Для Каждого СтрокаМаршрута Из СтрокиМаршрута Цикл
		
		Если ЗначениеЗаполнено(СтрокаМаршрута.Подписант) Тогда
			Состояние = СостояниеТребуетсяПодписание;
		Иначе
			Состояние = НачальноеСостояниеДокумента();
		КонецЕсли;
		
		НаборЗаписей = РегистрыСведений.СоставМаршрутаЭлектронногоДокумента.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ЭлектронныйДокумент.Установить(ЭлектронныйДокумент);
		НаборЗаписей.Отбор.Идентификатор.Установить(СтрокаМаршрута.Идентификатор);
		
		Запись = НаборЗаписей.Добавить();
		ЗаполнитьЗначенияСвойств(Запись, СтрокаМаршрута);
		Запись.ЭлектронныйДокумент = ЭлектронныйДокумент;
		Запись.Состояние = Состояние;
		
		НаборЗаписей.Записать();
		
		СтрокаМаршрута.Состояние = Состояние;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбновитьСостоянияВМаршрутеЭлектронногоДокумента(ЭлектронныйДокумент, СоставМаршрута)
	
	ОбновитьСостоянияМаршрута(СоставМаршрута);
	
	НаборЗаписей = РегистрыСведений.СоставМаршрутаЭлектронногоДокумента.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ЭлектронныйДокумент.Установить(ЭлектронныйДокумент);
	
	НаборЗаписей.Загрузить(СоставМаршрута);
	Для Каждого Запись Из НаборЗаписей Цикл
		Запись.ЭлектронныйДокумент = ЭлектронныйДокумент;
	КонецЦикла;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

Процедура ОбновитьСостоянияМаршрута(СоставМаршрута)
	
	Корень = СоставМаршрута.Найти(
		ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор(), "ИдентификаторРодителя");
	
	// Если корню установлено состояние "Аннулирован", то его не пересчитываем
	Если Корень.Состояние <> ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.Аннулирован") Тогда
		СостояниеСтрокиМаршрута(СоставМаршрута, Корень);
	КонецЕсли;
	
КонецПроцедуры

Функция СостояниеСтрокиМаршрута(СоставМаршрута, ТекущаяСтрока)
	
	СостояниеПодписано = ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.Завершен");
	СостояниеПодписьНеТребуется = ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.ЗакрытПринудительно");
	
	Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.Группа) Тогда
		Возврат ТекущаяСтрока.Состояние;
	КонецЕсли;
	
	Если ТекущаяСтрока.Группа = "И" Тогда
		ПодчиненныеСтроки = СоставМаршрута.НайтиСтроки(
			Новый Структура("ИдентификаторРодителя", ТекущаяСтрока.Идентификатор));
		КоличествоСтрок = ПодчиненныеСтроки.Количество();
		КоличествоПодписанных = 0;
		Для Каждого ПодчиненнаяСтрока Из ПодчиненныеСтроки Цикл
			Если СостояниеСтрокиМаршрута(СоставМаршрута, ПодчиненнаяСтрока) = СостояниеПодписано Тогда
				КоличествоПодписанных = КоличествоПодписанных + 1;
			КонецЕсли;
		КонецЦикла;
		// Если все строки группы И подписаны, группа отмечается как выполненная
		Если КоличествоПодписанных = КоличествоСтрок Тогда
			ТекущаяСтрока.Состояние = СостояниеПодписано;
		КонецЕсли;
	ИначеЕсли ТекущаяСтрока.Группа = "ИЛИ" Тогда
		ПодчиненныеСтроки = СоставМаршрута.НайтиСтроки(
			Новый Структура("ИдентификаторРодителя", ТекущаяСтрока.Идентификатор));
		ПодписаннаяСтрока = Неопределено;
		Для Каждого ПодчиненнаяСтрока Из ПодчиненныеСтроки Цикл
			Если СостояниеСтрокиМаршрута(СоставМаршрута, ПодчиненнаяСтрока) = СостояниеПодписано Тогда
				ПодписаннаяСтрока = ПодчиненнаяСтрока;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		// Если хотя бы одна строка группы ИЛИ подписана, группа отмечается как выполненная
		// А остальные строки отмечаются как не требующие подписи
		Если ПодписаннаяСтрока <> Неопределено Тогда
			ТекущаяСтрока.Состояние = СостояниеПодписано;
			Для Каждого ПодчиненнаяСтрока Из ПодчиненныеСтроки Цикл
				Если ПодчиненнаяСтрока = ПодписаннаяСтрока Тогда
					Продолжить;
				КонецЕсли;
				УстановитьСостояниеСтрокиМаршрута(СоставМаршрута, ПодчиненнаяСтрока, СостояниеПодписьНеТребуется);
			КонецЦикла;
		КонецЕсли;
	ИначеЕсли ТекущаяСтрока.Группа = "ПоОчереди" Тогда
		ПодчиненныеСтроки = СоставМаршрута.НайтиСтроки(
			Новый Структура("ИдентификаторРодителя", ТекущаяСтрока.Идентификатор));
		КоличествоСтрок = ПодчиненныеСтроки.Количество();
		КоличествоПодписанных = 0;
		МаксимальныйПорядокПодписаннойСтроки = 0;
		Для Каждого ПодчиненнаяСтрока Из ПодчиненныеСтроки Цикл
			Если СостояниеСтрокиМаршрута(СоставМаршрута, ПодчиненнаяСтрока) = СостояниеПодписано Тогда
				КоличествоПодписанных = КоличествоПодписанных + 1;
				МаксимальныйПорядокПодписаннойСтроки = Макс(МаксимальныйПорядокПодписаннойСтроки, ПодчиненнаяСтрока.Порядок);
			КонецЕсли;
		КонецЦикла;
		// Если все строки группы ПоОчереди подписаны, группа отмечается как выполненная
		Если КоличествоПодписанных = КоличествоСтрок Тогда
			ТекущаяСтрока.Состояние = СостояниеПодписано;
			// Если одна из строк группы ПоОчереди подписана, то следующая строка отмечается как требующая подписи
		ИначеЕсли МаксимальныйПорядокПодписаннойСтроки > 0 Тогда
			Для Каждого ПодчиненнаяСтрока Из ПодчиненныеСтроки Цикл
				Если ПодчиненнаяСтрока.Порядок = МаксимальныйПорядокПодписаннойСтроки + 1 Тогда
					ВключитьСтартовыеЭтапыМаршрута(СоставМаршрута, ПодчиненнаяСтрока);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	Иначе
		ВызватьИсключение НСтр("ru='Недопустимое значение группы маршрута'");
	КонецЕсли;
	
	Возврат ТекущаяСтрока.Состояние;
	
КонецФункции

Процедура УстановитьСостояниеСтрокиМаршрута(СоставМаршрута, ТекущаяСтрока, Состояние)
	
	ТекущаяСтрока.Состояние = Состояние;
	
	Если ЗначениеЗаполнено(ТекущаяСтрока.Группа) Тогда
		ПодчиненныеСтроки = СоставМаршрута.НайтиСтроки(
			Новый Структура("ИдентификаторРодителя", ТекущаяСтрока.Идентификатор));
		Для Каждого ПодчиненнаяСтрока Из ПодчиненныеСтроки Цикл
			УстановитьСостояниеСтрокиМаршрута(СоставМаршрута, ПодчиненнаяСтрока, Состояние);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновитьСостояниеЭлектронногоДокументаПоМаршруту(Параметры, СоставМаршрута)
	
	ЭлектронныйДокумент = Параметры.ЭлектронныйДокумент;
	ДатаИзменения = Параметры.ДатаИзменения;
	ТекущееСостояние = Параметры.ТекущееСостояние;
	
	Корень = СоставМаршрута.Найти(
		ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор(), "ИдентификаторРодителя");
	
	СостояниеЗавершен = ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.Завершен");
	
	Если Корень.Состояние = СостояниеЗавершен И ТекущееСостояние.Состояние <> СостояниеЗавершен Тогда
		УстановитьСостояниеЭлектронногоДокумента(ЭлектронныйДокумент, СостояниеЗавершен, ДатаИзменения, Истина, "");
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьСтрокуДереваМаршрутаПодписания(СтрокаДерева, ПараметрыПроверки)
	
	Если Не ЗначениеЗаполнено(СтрокаДерева.Группа) И Не ЗначениеЗаполнено(СтрокаДерева.Подписант) Тогда
		ПараметрыПроверки.ЕстьПустыеЗначения = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаДерева.Подписант) И Не ЗначениеЗаполнено(СтрокаДерева.ВидПодписи) Тогда
		ПараметрыПроверки.ЕстьПустыеВидыПодписи = Истина;
	КонецЕсли;
	
	ПодчиненныеСтроки = СтрокаДерева.ПолучитьЭлементы();
	Если ПодчиненныеСтроки.Количество() = 0 И СтрокаДерева.ЭтоСтрокаУсловия Тогда
		ПараметрыПроверки.ЕстьГруппыБезПодписантов = Истина;
	Иначе
		Для Каждого ПодчиненнаяСтрокаДерева Из ПодчиненныеСтроки Цикл
			ПроверитьСтрокуДереваМаршрутаПодписания(ПодчиненнаяСтрокаДерева, ПараметрыПроверки);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Функция ПустаяТаблицаМаршрутаКПодписанию()
	
	ТаблицаПодписания = Новый ТаблицаЗначений;
	ТаблицаПодписания.Колонки.Добавить("Идентификатор",
		Новый ОписаниеТипов("УникальныйИдентификатор"));
	ТаблицаПодписания.Колонки.Добавить("ИдентификаторРодителя",
		Новый ОписаниеТипов("УникальныйИдентификатор"));
	ТаблицаПодписания.Колонки.Добавить("Порядок",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0, ДопустимыйЗнак.Любой)));
	ТаблицаПодписания.Колонки.Добавить("Группа",
		Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(30)));
	ТаблицаПодписания.Колонки.Добавить("Подписант",
		Новый ОписаниеТипов("СправочникСсылка.Пользователи"));
	ТаблицаПодписания.Колонки.Добавить("ВидПодписи",
		Новый ОписаниеТипов("ПеречислениеСсылка.ВидыЭлектронныхПодписейБГУ"));
	ТаблицаПодписания.Колонки.Добавить("Сертификат",
		Новый ОписаниеТипов("СправочникСсылка.СертификатыКлючейЭлектроннойПодписиИШифрования"));
	ТаблицаПодписания.Колонки.Добавить("НомерСтрокиМаршрута",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(3, 0, ДопустимыйЗнак.Неотрицательный)));
	ТаблицаПодписания.Колонки.Добавить("ИзмененПользователем",
		Новый ОписаниеТипов("Булево"));
	ТаблицаПодписания.Колонки.Добавить("Состояние",
		Новый ОписаниеТипов("ПеречислениеСсылка.СостоянияДокументовВнутреннегоЭДО"));
	
	Возврат ТаблицаПодписания;
	
КонецФункции

Процедура ПрочитатьСтрокиДереваВТаблицуСоставМаршрута(РодительскийУзелДерева, Таблица)
	
	Если ТипЗнч(РодительскийУзелДерева) = Тип("ДеревоЗначений") Тогда
		ИдентификаторРодителя = ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор();
		УчитыватьПорядок = Ложь;
	Иначе
		ИдентификаторРодителя = РодительскийУзелДерева.Идентификатор;
		УчитыватьПорядок = РодительскийУзелДерева.Группа = "ПоОчереди";
	КонецЕсли;
	
	ПодчиненныеУзлы = РодительскийУзелДерева.Строки;
	Порядок = 1;
	Для Каждого Узел Из ПодчиненныеУзлы Цикл
		НоваяСтрокаТаблицы = Таблица.Добавить();
		Если Не ЗначениеЗаполнено(Узел.Идентификатор) Тогда
			Узел.Идентификатор = Новый УникальныйИдентификатор;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(НоваяСтрокаТаблицы, Узел);
		НоваяСтрокаТаблицы.ИдентификаторРодителя = ИдентификаторРодителя;
		НоваяСтрокаТаблицы.Порядок = Порядок;
		
		Если УчитыватьПорядок Тогда
			Порядок = Порядок + 1;
		КонецЕсли;
		
		Если ТипЗнч(Таблица) = Тип("ТаблицаЗначений") Тогда
			НоваяСтрокаТаблицы.НомерСтрокиМаршрута = Таблица.Количество();
		КонецЕсли;
		
		ПрочитатьСтрокиДереваВТаблицуСоставМаршрута(Узел, Таблица);
	КонецЦикла;
	
КонецПроцедуры

Функция ШтампВизуализацииПростойЭлектроннойПодписи(Свойства, ТекстОтметки = "", ЛоготипОрганизации = Неопределено)

	ОтображатьДатуПодписанияПоОрганизации = Истина;
	ВнутреннийЭДОПереопределяемый.ЗаполнитьНастройкуОтображатьДатуПодписанияПоОрганизации(Свойства.Организация, ОтображатьДатуПодписанияПоОрганизации);
	
	Если Константы.ОтображатьДатуПодписанияВШтампеВизуализацииПЭП.Получить() = Истина 
		И ОтображатьДатуПодписанияПоОрганизации Тогда
		Штамп = УправлениеПечатью.МакетПечатнойФормы("Документ.ВнутреннийЭлектронныйДокумент.ПФ_MXL_ШтампПЭПсДатой");
	Иначе
		Штамп = УправлениеПечатью.МакетПечатнойФормы("Документ.ВнутреннийЭлектронныйДокумент.ПФ_MXL_ШтампПЭП");
	КонецЕсли;
	
	ПараметрыШтампа = Новый Структура;
	ПараметрыШтампа.Вставить("ВладелецПодписи", Свойства.ВладелецПодписи);
	ПараметрыШтампа.Вставить("Должность", Свойства.Должность);
	ПараметрыШтампа.Вставить("ДатаПодписи", Свойства.ДатаПодписи);
	ПараметрыШтампа.Вставить("УстановившийПодпись", Свойства.УстановившийПодпись);
	ПараметрыШтампа.Вставить("ТекстОтметки", ТекстОтметки);
	
	НаименованиеОрганизации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Свойства.Организация, "НаименованиеСокращенное");
	Если НЕ ЗначениеЗаполнено(НаименованиеОрганизации) Тогда
		НаименованиеОрганизации = Свойства.Организация;	
	КонецЕсли;
	ПараметрыШтампа.Вставить("Организация", НаименованиеОрганизации);
	
	ЗаполнитьЗначенияСвойств(Штамп.Параметры, ПараметрыШтампа);
	
	Если ЛоготипОрганизации <> Неопределено Тогда
		Штамп.Области.Картинка.Картинка = ЛоготипОрганизации;
	КонецЕсли;
	
	Возврат Штамп;
	
КонецФункции

Функция УстановленныеПростыеПодписи(Объект)
	
	Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(Объект)) Тогда
		ОбъектСсылка = Объект;
	Иначе
		ОбъектСсылка = Объект.Ссылка;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НЕОПРЕДЕЛЕНО КАК Подпись,
	|	ЭлектронныеПодписи.ПорядковыйНомер КАК ПорядковыйНомер,
	|	ЭлектронныеПодписи.УстановившийПодпись КАК УстановившийПодпись,
	|	ЭлектронныеПодписи.ДатаПодписи КАК ДатаПодписи,
	|	ЭлектронныеПодписи.ВладелецПодписи КАК ВладелецПодписи,
	|	ЭлектронныеПодписи.Должность КАК Должность,
	|	ЭлектронныеПодписи.Организация КАК Организация,
	|	ИСТИНА КАК ПростаяПодпись
	|ИЗ
	|	РегистрСведений.ПростыеЭлектронныеПодписиБГУ КАК ЭлектронныеПодписи
	|ГДЕ
	|	ЭлектронныеПодписи.ПодписанныйОбъект = &ПодписанныйОбъект
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПорядковыйНомер";
	
	Запрос.УстановитьПараметр("ПодписанныйОбъект", ОбъектСсылка);
	
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	
	ЭлектронныеПодписи = Новый Массив;
	Пока Выборка.Следующий() Цикл
		ОтпечатокСтруктура = Новый Структура(
			"ПорядковыйНомер, ДатаПодписи, УстановившийПодпись, ПростаяПодпись,
			|ДатаПроверкиПодписи, ИмяФайлаПодписи, Комментарий, ПодписьВерна,
			|КомуВыданСертификат, ВладелецПодписи, Должность, Организация");
		ЗаполнитьЗначенияСвойств(ОтпечатокСтруктура, Выборка);
		ЭлектронныеПодписи.Добавить(ОтпечатокСтруктура);
	КонецЦикла;
	
	Возврат ЭлектронныеПодписи;
	
КонецФункции

Функция УсловияВыполняются(Условия, Объект)
	
	ИменаРеквизитов = Новый Массив;
	Для Каждого Условие Из Условия Цикл
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, Условие.Реквизит) Тогда
			ИменаРеквизитов.Добавить(Условие.Реквизит);
		КонецЕсли;
	КонецЦикла;
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект, СтрСоединить(ИменаРеквизитов,","));
	
	Для Каждого Условие Из Условия Цикл
		ИмяРеквизита = Условие.Реквизит;
		Если Не ЗначенияРеквизитов.Свойство(ИмяРеквизита) Тогда
			Продолжить;
		КонецЕсли;
		УсловиеВыполняется = Истина;
		Если Условие.ВидСравнения = ВидСравнения.Равно
			Или Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно Тогда
			УсловиеВыполняется = ЗначенияРеквизитов[ИмяРеквизита] = Условие.Значение;
		ИначеЕсли Условие.ВидСравнения = ВидСравнения.Больше
			Или Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Больше Тогда
			УсловиеВыполняется = ЗначенияРеквизитов[ИмяРеквизита] > Условие.Значение;
		ИначеЕсли Условие.ВидСравнения = ВидСравнения.БольшеИлиРавно
			Или Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно Тогда
			УсловиеВыполняется = ЗначенияРеквизитов[ИмяРеквизита] >= Условие.Значение;
		ИначеЕсли Условие.ВидСравнения = ВидСравнения.Меньше
			Или Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше Тогда
			УсловиеВыполняется = ЗначенияРеквизитов[ИмяРеквизита] < Условие.Значение;
		ИначеЕсли Условие.ВидСравнения = ВидСравнения.МеньшеИлиРавно
			Или Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно Тогда
			УсловиеВыполняется = ЗначенияРеквизитов[ИмяРеквизита] <= Условие.Значение;
		ИначеЕсли Условие.ВидСравнения = ВидСравнения.НеРавно
			Или Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно Тогда
			УсловиеВыполняется = ЗначенияРеквизитов[ИмяРеквизита] <> Условие.Значение;
		ИначеЕсли Условие.ВидСравнения = ВидСравнения.ВСписке
			Или Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке Тогда
			Если ТипЗнч(Условие.Значение) = Тип("СписокЗначений") Тогда
				УсловиеВыполняется = Условие.Значение.НайтиПоЗначению(ЗначенияРеквизитов[ИмяРеквизита]) <> Неопределено;
			Иначе // Массив
				УсловиеВыполняется = Условие.Значение.Найти(ЗначенияРеквизитов[ИмяРеквизита]) <> Неопределено;
			КонецЕсли;
		ИначеЕсли Условие.ВидСравнения = ВидСравнения.НеВСписке
			Или Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке Тогда
			Если ТипЗнч(Условие.Значение) = Тип("СписокЗначений") Тогда
				УсловиеВыполняется = Условие.Значение.НайтиПоЗначению(ЗначенияРеквизитов[ИмяРеквизита]) = Неопределено;
			Иначе // Массив
				УсловиеВыполняется = Условие.Значение.Найти(ЗначенияРеквизитов[ИмяРеквизита]) = Неопределено;
			КонецЕсли;
		ИначеЕсли Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено Тогда
			УсловиеВыполняется = ЗначениеЗаполнено(ЗначенияРеквизитов[ИмяРеквизита]);
		ИначеЕсли Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
			УсловиеВыполняется = Не ЗначениеЗаполнено(ЗначенияРеквизитов[ИмяРеквизита]);
		КонецЕсли;
		Если Не УсловиеВыполняется Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция ЗначенияПараметровШаблонаПоложенияОбИспользованииПЭП(ДанныеОрганизации)
	
	НаименованиеОрганизации = "";
 	
	ЗначениеСвойства = Неопределено;
	Если ДанныеОрганизации.Свойство("Наименование", ЗначениеСвойства)
		И ЗначениеЗаполнено(ЗначениеСвойства) Тогда;
		НаименованиеОрганизации = ЗначениеСвойства;
	КонецЕсли;
	
	ЧастиИмени = Новый Структура;
	ЧастиИмени.Вставить("Фамилия",  ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеОрганизации, "Фамилия", ""));
	ЧастиИмени.Вставить("Имя",      ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеОрганизации, "Имя", ""));
	ЧастиИмени.Вставить("Отчество", ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеОрганизации, "Отчество", ""));
	
	РуководительФИО = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ЧастиИмени);
	
	ТекущаяДата = Формат(ТекущаяДатаСеанса(), "ДФ='дд.ММ.гггг'");
	
	ЗначенияПараметров = Новый Структура;
	ЗначенияПараметров.Вставить("НаименованиеОрганизации", НаименованиеОрганизации); 
	ЗначенияПараметров.Вставить("РуководительДолжность",
		ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеОрганизации, "Должность", ""));
	ЗначенияПараметров.Вставить("РуководительФИО", РуководительФИО);
	ЗначенияПараметров.Вставить("ТекущаяДата", ТекущаяДата);
	ЗначенияПараметров.Вставить("НазваниеКонфигурации", Метаданные.Представление());
	
	Возврат ЗначенияПараметров;
	
КонецФункции

Функция ЗапретРедактированияФормДокументовПослеЗавершенияПодписания(Организация)
	
	ИмяНастройки = "ВнутреннийЭДОЗапретРедактированияФормДокументовПослеЗавершенияПодписания";
	ЗначениеПоУмолчанию = Ложь;
	
	Возврат НастройкаВнутреннегоЭДО(Организация, ИмяНастройки, ЗначениеПоУмолчанию);
	
КонецФункции

Функция ПроверятьНаличиеКлючаПЭПВРеестре(Организация)
	
	ИмяНастройки = "ВнутреннийЭДОПроверятьНаличиеКлючаПЭПВРеестре";
	ЗначениеПоУмолчанию = Ложь;
	
