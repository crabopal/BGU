
#Область СлужебныйПрограммныйИнтерфейс

Процедура ПриЧтенииНаСервере(Форма, Источник, ГруппаДляГиперссылки = Неопределено, ГруппаДляПодменю = Неопределено) Экспорт
	
	Если НЕ ВнутреннийЭДОПереопределяемый.ИспользуютсяВнутренниеДокументы() Тогда
		Возврат
	КонецЕсли;
	
	ТипыДокументовВнутреннегоЭДО = Новый ОписаниеТипов(ВнутреннийЭДОПовтИсп.ТипыУчетныхДокументовВнутреннегоЭДО());
	Если НЕ ТипыДокументовВнутреннегоЭДО.СодержитТип(ТипЗнч(Источник.Ссылка)) Тогда
		Возврат;
	КонецЕсли;
	
	УправлениеЭлементамиФормыУчетногоДокумента(Форма, Источник);
	
	Если НЕ ПравоДоступа("Просмотр", Метаданные.РегистрыСведений.СостоянияУчетныхДокументов) Тогда
		Возврат;
	КонецЕсли;
	
	Если ДокументОбрабатываетсяВнутреннимЭДОБЭД(Источник.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьКомандыВнутреннегоЭДО(Форма, ГруппаДляПодменю);
	
	ОбновитьГиперссылкуСостояниеЭД(Форма, ГруппаДляГиперссылки);
	
КонецПроцедуры

Процедура ПриСозданииНаСервере(Форма, Источник, ГруппаДляГиперссылки = Неопределено, ГруппаДляПодменю = Неопределено) Экспорт
	
	// Для не новых документов логика реализована в процедуре ПриЧтенииНаСервере
	Если НЕ Источник.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ПравоДоступа("Просмотр", Метаданные.РегистрыСведений.СостоянияУчетныхДокументов) Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ВнутреннийЭДОПереопределяемый.ИспользуютсяВнутренниеДокументы() Тогда
		Возврат
	КонецЕсли;
	
	ТипыДокументовВнутреннегоЭДО = Новый ОписаниеТипов(ВнутреннийЭДОПовтИсп.ТипыУчетныхДокументовВнутреннегоЭДО());
	Если НЕ ТипыДокументовВнутреннегоЭДО.СодержитТип(ТипЗнч(Источник.Ссылка)) Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьКомандыВнутреннегоЭДО(Форма, ГруппаДляПодменю);
	
	ОбновитьГиперссылкуСостояниеЭД(Форма, ГруппаДляГиперссылки);
	
КонецПроцедуры

Процедура ПриСозданииНаСервереФормыСписка(Форма, ИмяСписка, ГруппаДляПодменю = Неопределено) Экспорт
	
	Если НЕ ВнутреннийЭДОПереопределяемый.ИспользуютсяВнутренниеДокументы() Тогда
		Возврат
	КонецЕсли;
	
	Если НЕ ПравоДоступа("Просмотр", Метаданные.РегистрыСведений.СостоянияУчетныхДокументов) Тогда
		Возврат;
	КонецЕсли;
	
	ИмяКолонки = "СостояниеЭДОБГУ";
	ЗаголовокКолонки = НСтр("ru = 'Состояние внутр. ЭДО'");
	ЭтоФормаВыбора = 
		Форма.Параметры.Свойство("РежимВыбора") И Форма.Параметры.РежимВыбора;
	
	Элементы = Форма.Элементы;
	
	ТипыДокументовВнутреннегоЭДО = Новый ОписаниеТипов(ВнутреннийЭДОПовтИсп.ТипыУчетныхДокументовВнутреннегоЭДО());
	
	ТаблицаФормы = Элементы.Найти(СокрЛП(ИмяСписка));
	
	Если ТипЗнч(ТаблицаФормы) <> Тип("ТаблицаФормы")
		ИЛИ ТаблицаФормы.ПутьКДанным <> СокрЛП(ИмяСписка) Тогда
		// Если по имени динамического списка таблица найдена, но путь к данным отличается от имени динамического списка,
		// либо не найдена вообще, то выполняется попытка найти таблицу перебором всех элементов по совпадению пути к данным
		ТаблицаФормы = Неопределено;
		Для Каждого ЭлементФормы Из Элементы Цикл
			Если ТипЗнч(ЭлементФормы) <> Тип("ТаблицаФормы") Тогда
				Продолжить;
			КонецЕсли;
			Если ЭлементФормы.ПутьКДанным = СокрЛП(ИмяСписка) Тогда
				ТаблицаФормы = ЭлементФормы;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ТаблицаФормы = Неопределено Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ТекущийСписок = Форма[ТаблицаФормы.ПутьКДанным];
	ОсновнаяТаблица = ТекущийСписок.ОсновнаяТаблица;
	
	Если НЕ ЗначениеЗаполнено(ОсновнаяТаблица) Тогда
		Возврат;
	КонецЕсли;
	
	ТипыДокументовСписка = Новый Соответствие;
	
	// Для форм списков документов колонка добавляется, если тип документа есть в настройках внутреннего ЭДО
	Если СтрРазделить(ОсновнаяТаблица, ".")[0] = "Документ" Тогда
		ТипДокумента = Тип("ДокументСсылка." + СтрРазделить(ОсновнаяТаблица, ".")[1]);
		ТипыДокументовСписка.Вставить(ТипДокумента, Истина);
		Если НЕ ТипыДокументовВнутреннегоЭДО.СодержитТип(ТипДокумента) Тогда
			Возврат;
		КонецЕсли;
	ИначеЕсли СтрРазделить(ОсновнаяТаблица, ".")[0] = "Справочник" Тогда
		ТипДокумента = Тип("СправочникСсылка." + СтрРазделить(ОсновнаяТаблица, ".")[1]);
		ТипыДокументовСписка.Вставить(ТипДокумента, Истина);
		Если НЕ ТипыДокументовВнутреннегоЭДО.СодержитТип(ТипДокумента) Тогда
			Возврат;
		КонецЕсли;
		// Для журналов документов колонка добавляется, если для хотя бы один тип документа есть в настройках внутреннего ЭДО
	ИначеЕсли СтрРазделить(ОсновнаяТаблица, ".")[0] = "ЖурналДокументов" Тогда
		ЕстьПодходящиеТипы = Ложь;
		Для Каждого РегистируемыйДокумент Из Метаданные.НайтиПоПолномуИмени(ОсновнаяТаблица).РегистрируемыеДокументы Цикл
			ТипДокумента = Тип("ДокументСсылка." + РегистируемыйДокумент.Имя);
			ТипыДокументовСписка.Вставить(ТипДокумента, Истина);
			Если ТипыДокументовВнутреннегоЭДО.СодержитТип(ТипДокумента) Тогда
				ЕстьПодходящиеТипы = Истина;
				//Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ ЕстьПодходящиеТипы Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ТекстЗапроса = "";
	Если ТекущийСписок.ПроизвольныйЗапрос Тогда
		ТекстЗапроса = ТекущийСписок.ТекстЗапроса;
	Иначе
		ИсполняемаяСхема = ТаблицаФормы.ПолучитьИсполняемуюСхемуКомпоновкиДанных();
		НаборДанныхДинамическогоСписка = ИсполняемаяСхема.НаборыДанных.Найти("НаборДанныхДинамическогоСписка");
		Если НаборДанныхДинамическогоСписка <> Неопределено Тогда
			ТекущийСписок.ПроизвольныйЗапрос = Истина;
			ТекстЗапроса = НаборДанныхДинамическогоСписка.Запрос;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекстЗапроса) Тогда
		Возврат;
	КонецЕсли;
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.РежимКомпоновкиДанных = Истина;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
	
	ПоследнийЗапрос = СхемаЗапроса.ПакетЗапросов[СхемаЗапроса.ПакетЗапросов.Количество() - 1];
	
	Если ПоследнийЗапрос.Колонки.Найти(ИмяКолонки) <> Неопределено Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Обнаружено дублирование имен полей динамического списка ""%1"". Колонка со статусом документа выведена не будет'"),
			ИмяСписка);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ОператорВыбрать = ПоследнийЗапрос.Операторы[0];
	
	ИсточникОсновнойТаблицы = ОператорВыбрать.Источники[0];
	
	ИсточникСостоянияУчетныхДокументов = ОператорВыбрать.Источники.Добавить(
		"РегистрСведений.СостоянияУчетныхДокументов", "СостоянияУчетныхДокументов");
	
	Попытка
		Если НЕ ИсточникОсновнойТаблицы.Соединения.Добавить(
			ИсточникСостоянияУчетныхДокументов,
			ИсточникОсновнойТаблицы.Источник.Псевдоним + ".Ссылка = СостоянияУчетныхДокументов.УчетныйДокумент") Тогда
			Возврат;
		КонецЕсли;
	Исключение
		Возврат;
	КонецПопытки;
	
	Соединение = ИсточникОсновнойТаблицы.Соединения.НайтиПоПсевдониму("СостоянияУчетныхДокументов");
	Соединение.ОбязательноеСоединение = Ложь;
	Соединение.НачалоГруппыНеобязательныхСоединений = Истина;
	
	// Проверка необходимости включения состояния внутренного документа БЭД в добавляемую колонку
	ТребуетсяВключениеСостоянияБЭДВКолонку = Ложь;
	ТипыДокументовВнутреннегоЭДОБЭД = ТипыДокументовВнутреннегоЭДОБЭД();
	Для Каждого ТипДокументаВнутреннегоЭДОБЭД Из ТипыДокументовВнутреннегоЭДОБЭД Цикл
		Если ТипыДокументовСписка[ТипДокументаВнутреннегоЭДОБЭД] <> Неопределено Тогда
			ТребуетсяВключениеСостоянияБЭДВКолонку = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если ТребуетсяВключениеСостоянияБЭДВКолонку Тогда
		ТребуетсяВключениеСостоянияБЭДВКолонку = Ложь;
		Для Каждого Источник Из ОператорВыбрать.Источники Цикл
			Если Источник.Источник.ИмяТаблицы = "РегистрСведений.СостоянияПоОбъектамУчетаЭДО" Тогда
				ТребуетсяВключениеСостоянияБЭДВКолонку = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ТребуетсяВключениеСостоянияБЭДВКолонку Тогда
		ВыбираемоеПоле =
		"ВЫБОР
		|	КОГДА НЕ СостоянияУчетныхДокументов.ПредставлениеСостояния ЕСТЬ NULL
		|		ТОГДА СостоянияУчетныхДокументов.ПредставлениеСостояния
		|	КОГДА ТИПЗНАЧЕНИЯ("+ИсточникОсновнойТаблицы.Источник.Псевдоним+".Ссылка) В (&ТипыДокументовВнутреннегоЭДОБЭД)
		|		ТОГДА СостоянияЭД.ПредставлениеСостояния
		|КОНЕЦ";
	Иначе
		ВыбираемоеПоле = "СостоянияУчетныхДокументов.ПредставлениеСостояния";
	КонецЕсли;
	ОператорВыбрать.ВыбираемыеПоля.Добавить(ВыбираемоеПоле);
	
	КолонкаСтатус = ПоследнийЗапрос.Колонки.Получить(ПоследнийЗапрос.Колонки.Количество() - 1);
	КолонкаСтатус.Псевдоним = ИмяКолонки;
	
	СтруктураСвойствДинамическогоСписка = ОбщегоНазначения.СтруктураСвойствДинамическогоСписка();
	СтруктураСвойствДинамическогоСписка.ТекстЗапроса = СхемаЗапроса.ПолучитьТекстЗапроса();
	ОбщегоНазначения.УстановитьСвойстваДинамическогоСписка(ТаблицаФормы, СтруктураСвойствДинамическогоСписка);
	
	Если ТребуетсяВключениеСостоянияБЭДВКолонку Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
			ТекущийСписок, "ТипыДокументовВнутреннегоЭДОБЭД", ТипыДокументовВнутреннегоЭДОБЭД, Истина);
	КонецЕсли;
	
	// добавление колонки на форму
	КолонкаСостоянияЭДО = Элементы.Добавить(ИмяСписка+ИмяКолонки, Тип("ПолеФормы"), ТаблицаФормы);
	КолонкаСостоянияЭДО.Вид = ВидПоляФормы.ПолеНадписи;
	КолонкаСостоянияЭДО.ПутьКДанным = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("%1.%2", ИмяСписка, ИмяКолонки);
	КолонкаСостоянияЭДО.Заголовок = ЗаголовокКолонки;
	КолонкаСостоянияЭДО.ГиперссылкаЯчейки = ?(ЭтоФормаВыбора, Ложь, Истина);
	КолонкаСостоянияЭДО.ЦветТекста = ЦветаСтиля.ГиперссылкаЦвет;
	
	// в форме выбора команды внутреннего ЭДО не выводятся	
	Если ЭтоФормаВыбора Тогда
		Возврат;	
	КонецЕсли;
	
	Если ГруппаДляПодменю <> Неопределено Тогда
		ДобавитьКомандыВнутреннегоЭДОДляФормыСписка(Форма, ГруппаДляПодменю, ГруппаДляПодменю.Имя);
	ИначеЕсли ТаблицаФормы.ПоложениеКоманднойПанели <> ПоложениеКоманднойПанелиЭлементаФормы.Нет
		И ТаблицаФормы.КоманднаяПанель.ПодчиненныеЭлементы.Количество() > 0 Тогда
		ДобавитьКомандыВнутреннегоЭДОДляФормыСписка(Форма, ТаблицаФормы.КоманднаяПанель, ТаблицаФормы.Имя);
	Иначе
		ДобавитьКомандыВнутреннегоЭДОДляФормыСписка(Форма);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриСозданииНаСервереФормыСправочникаОрганизации(Форма) Экспорт
	
	Если НЕ ВнутреннийЭДОПереопределяемый.ИспользуютсяВнутренниеДокументы() Тогда
		Возврат
	КонецЕсли;
	
	ДобавитьКомандыВнутреннегоЭДОДляСправочникаОрганизации(Форма);
	
КонецПроцедуры

Функция ТребуетсяЗапретитьРедактированиеФормыДокумента(Организация, УчетныйДокумент) Экспорт
	
	Если ПравоДоступа("Изменение", Метаданные.РегистрыСведений.НастройкиВнутреннегоЭДОБГУ) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ ЗапретРедактированияФормДокументовПослеЗавершенияПодписания(Организация) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если СостояниеУчетногоДокумента(УчетныйДокумент).Состояние = НачальноеСостояниеДокумента() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция КомандыПечатиОбъекта(МетаданныеОбъекта) Экспорт
	КомандыПечати = УправлениеПечатью.КомандыПечатиОбъекта(МетаданныеОбъекта);
	// Удаление команд-исключений и команд без менеджера печати
	ПоследнийИндекс = КомандыПечати.Количество() - 1;
	Для Индекс = 0 По ПоследнийИндекс Цикл
		ОбратныйИндекс = ПоследнийИндекс - Индекс;
		Если Не ЗначениеЗаполнено(КомандыПечати[ОбратныйИндекс].МенеджерПечати) Тогда
			КомандыПечати.Удалить(ОбратныйИндекс);
		ИначеЕсли ВнутреннийЭДОПовтИсп.ПечатныеФормыИсключения()[КомандыПечати[ОбратныйИндекс].Идентификатор] = Истина Тогда
			КомандыПечати.Удалить(ОбратныйИндекс);
		КонецЕсли;
	КонецЦикла;
	Возврат КомандыПечати;
КонецФункции

Функция КомандаПечатиПодходитПоУсловиям(КомандаПечати, УчетныйДокумент) Экспорт
	
	Результат = ВнутреннийЭДОПереопределяемый.КомандаПечатиПодходитПоУсловиям(КомандаПечати, УчетныйДокумент);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КомандаПечати.УсловияВидимостиПоТипамОбъектов) Тогда
		УсловияВидимости = КомандаПечати.УсловияВидимостиПоТипамОбъектов[ТипЗнч(УчетныйДокумент)];
	Иначе
		УсловияВидимости = КомандаПечати.УсловияВидимости;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(УсловияВидимости) И Не УсловияВыполняются(УсловияВидимости, УчетныйДокумент) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция КомандаПечатиПоИдентификатору(КомандыПечати, ИдентификаторКомандыПечати) Экспорт
	
	ЭтоВнешняяПечатнаяФорма = Ложь;
	Если СтрДлина(ИдентификаторКомандыПечати) > 32 Тогда
		Идентификатор = Прав(ИдентификаторКомандыПечати, 32);
		Идентификатор = Лев(Идентификатор, 8)
			+ "-" + Сред(Идентификатор, 9, 4)
			+ "-" + Сред(Идентификатор, 13, 4)
			+ "-" + Сред(Идентификатор, 17, 4)
			+ "-" + Сред(Идентификатор, 21);
		Если СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(Идентификатор) Тогда
			ЭтоВнешняяПечатнаяФорма = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если ЭтоВнешняяПечатнаяФорма Тогда
		
		ПараметрыПоиска = Новый Структура;
		ПараметрыПоиска.Вставить("Идентификатор",
			Лев(ИдентификаторКомандыПечати, СтрДлина(ИдентификаторКомандыПечати) - 32));
		ПараметрыПоиска.Вставить("УникальныйИдентификатор", Прав(ИдентификаторКомандыПечати, 32));
		
		НайденныеКомандыПечати = КомандыПечати.НайтиСтроки(ПараметрыПоиска);
		Если НайденныеКомандыПечати.Количество() = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		КомандаПечати = НайденныеКомандыПечати[0];
	Иначе
		ПараметрыПоиска = Новый Структура;
		ПараметрыПоиска.Вставить("Идентификатор", ИдентификаторКомандыПечати);
		НайденныеКомандыПечати = КомандыПечати.НайтиСтроки(ПараметрыПоиска);
		Для Каждого КомандаПечати Из НайденныеКомандыПечати Цикл
			Если КомандаПечати.МенеджерПечати <> "СтандартныеПодсистемы.ДополнительныеОтчетыИОбработки" Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если КомандаПечати = Неопределено И КомандыПечати.Количество() > 0 Тогда
		// Проверка для команд печати - если выполняется печать регистра учета, поиск по наименованию невозможен.
		// В этом случае провеяется доступная команда печати для регистра учета.
		Если КомандыПечати[0].Идентификатор = "РегистрУчета" Тогда
			КомандаПечати = КомандыПечати[0];
		КонецЕсли;
	КонецЕсли;
	
	Возврат КомандаПечати;
	
КонецФункции

Функция ОписаниеНовогоЭлектронногоДокумента(Параметры) Экспорт
	
	Описание = Новый Структура;
	Описание.Вставить("АдресОсновногоФайла", "");
	Описание.Вставить("ИмяФайла", "");
	
	Описание.Вставить("АдресОсновногоФайлаPDF", "");
	Описание.Вставить("ИмяФайлаPDF", "");

	ДвоичныеДанныеДокумента = ДвоичныеДанныеУчетногоДокумента(Параметры);

	ДвоичныеДанныеДокументаPDF = ДвоичныеДанныеPDFУчетногоДокумента(Параметры);

	Если ДвоичныеДанныеДокумента = Неопределено Тогда
		Возврат Описание;
	КонецЕсли;
	
	Описание.АдресОсновногоФайла = ПоместитьВоВременноеХранилище(ДвоичныеДанныеДокумента, Новый УникальныйИдентификатор);

	Если НЕ ДвоичныеДанныеДокументаPDF = Неопределено Тогда
		Описание.АдресОсновногоФайлаPDF = ПоместитьВоВременноеХранилище(ДвоичныеДанныеДокументаPDF, Новый УникальныйИдентификатор);
	КонецЕсли;
	
	ПредставлениеДокумента = ВнутреннийЭДОКлиентСервер.ПредставлениеДокументаПоСвойствам(Параметры);
	
	ИмяБезРасширения = ПредставлениеДокумента;
	ИмяБезРасширения = СтрЗаменить(ИмяБезРасширения, " ", "_");
	ИмяБезРасширения = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(ИмяБезРасширения, "_");
	
	ПолноеИмяФайла = ИмяБезРасширения + ".zip";

	ПолноеИмяФайлаPDF = ИмяБезРасширения + ".pdf";
	
	Описание.ИмяФайла = ПолноеИмяФайла;

	Описание.ИмяФайлаPDF = ПолноеИмяФайлаPDF;

	Возврат Описание;
	
КонецФункции

