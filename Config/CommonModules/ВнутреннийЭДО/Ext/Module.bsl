				ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.СоставМаршрутаЭлектронногоДокумента");
				ЭлементБлокировки.УстановитьЗначение("ЭлектронныйДокумент", ЭлектронныйДокумент);
			КонецЦикла;
		Иначе
			ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.СоставМаршрутаЭлектронногоДокумента");
			ЭлементБлокировки.УстановитьЗначение("ЭлектронныйДокумент", ВнутренниеЭлектронныеДокументы);
		КонецЕсли;
		Блокировка.Заблокировать();
	Исключение
