Процедура СоздатьЭлектронныеДокументы(УчетныеДокументы) Экспорт
	
	МассивУчетныхДокументов = Новый Массив;
	Для Каждого КлючЗначение Из УчетныеДокументы Цикл
		МассивУчетныхДокументов.Добавить(КлючЗначение.Ключ);
	КонецЦикла;
	
	НачатьТранзакцию();
	Попытка
		
		ЗаблокироватьРегистрСостоянияУчетныхДокументов(МассивУчетныхДокументов);
		
		Для Каждого КлючЗначение Из УчетныеДокументы Цикл
			
			УчетныйДокумент = КлючЗначение.Ключ;
			
			Для Каждого ПараметрыЭД Из КлючЗначение.Значение Цикл
				
				ИдентификаторКомандыПечати = ПараметрыЭД.ИдентификаторКомандыПечати;
				МаршрутПодписания = ПараметрыЭД.МаршрутПодписания;
				ДеревоМаршрута = ПараметрыЭД.ДеревоМаршрута;
				Организация = ПараметрыЭД.Организация;
				ВидДокумента = ПараметрыЭД.ВидДокумента;
				ДатаДокумента = ПараметрыЭД.ДатаДокумента;
				НомерДокумента = ПараметрыЭД.НомерДокумента;
				Ответственный = ПараметрыЭД.Ответственный;
				
				Состояние = СостояниеАктуальногоЭлектронногоДокумента(УчетныйДокумент, ИдентификаторКомандыПечати);
				
				ПроверитьВозможностьСозданияЭлектронногоДокумента(Состояние);
				
				Если ЗначениеЗаполнено(МаршрутПодписания) Тогда
					СоставМаршрута = СоставМаршрутаПодписания(МаршрутПодписания);
				Иначе
					СоставМаршрута = Неопределено;
					ЗаполнитьТаблицуСоставМаршрутаПоДереву(
						ДанныеФормыВЗначение(ОбщегоНазначения.ЗначениеИзСтрокиXML(ДеревоМаршрута), Тип("ДеревоЗначений")),
						СоставМаршрута);
				КонецЕсли;
				
				ПараметрыНовогоДокумента = Новый Структура;
				ПараметрыНовогоДокумента.Вставить("УчетныйДокумент", УчетныйДокумент);
				ПараметрыНовогоДокумента.Вставить("Организация", Организация);
				ПараметрыНовогоДокумента.Вставить("ВидДокумента", ВидДокумента);
				ПараметрыНовогоДокумента.Вставить("ДатаДокумента", ДатаДокумента);
				ПараметрыНовогоДокумента.Вставить("НомерДокумента", НомерДокумента);
				ПараметрыНовогоДокумента.Вставить("ИдентификаторКомандыПечати", ИдентификаторКомандыПечати);
				Описание = ОписаниеНовогоЭлектронногоДокумента(ПараметрыНовогоДокумента);
				
				Если НЕ ЗначениеЗаполнено(Описание.АдресОсновногоФайла) Тогда
					Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'Для документа ""%1"" электронный документ вида ""%2"" не может быть сформирован, проверьте возможность печати соответствующей формы из документа'"),
						УчетныйДокумент, ВидДокумента);
					ВызватьИсключение Сообщение;
				КонецЕсли;
				
				АдресОсновногоФайла = Описание.АдресОсновногоФайла;
				ИмяФайла = Описание.ИмяФайла;
				
				АдресОсновногоФайлаPDF = Описание.АдресОсновногоФайлаPDF;
				ИмяФайлаPDF = Описание.ИмяФайлаPDF;
				
				ВнутреннийЭДОбъект = Документы.ВнутреннийЭлектронныйДокумент.СоздатьДокумент();
				
				ЗаполнитьЗначенияСвойств(ВнутреннийЭДОбъект, ПараметрыНовогоДокумента);
				
				ВнутреннийЭДОбъект.Дата = ТекущаяДатаСеанса();
				ВнутреннийЭДОбъект.Ответственный = Ответственный;
				
