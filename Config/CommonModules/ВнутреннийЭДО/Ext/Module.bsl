Процедура ОбновитьГиперссылкуСостояниеЭД(Форма, ГруппаДляГиперссылки)
	
	Если Форма.Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	ГруппаДляРазмещения = НайтиДобавитьГруппуДляГиперссылки(Форма, ГруппаДляГиперссылки);
	Гиперссылка = НайтиДобавитьГиперссылкуСостояниеЭД(Форма, ГруппаДляРазмещения);
	
	Состояние = СостояниеУчетногоДокумента(Форма.Объект.Ссылка);
	
	Гиперссылка.Заголовок = Состояние.ПредставлениеСостояния;
	
КонецПроцедуры

Функция НайтиДобавитьГруппуДляГиперссылки(Форма, ГруппаДляГиперссылки)
	
	Если ТипЗнч(ГруппаДляГиперссылки) = Тип("Строка") Тогда
		ГруппаДляРазмещения = Форма.Элементы.Найти(ГруппаДляГиперссылки);
	ИначеЕсли ТипЗнч(ГруппаДляГиперссылки) = Тип("ГруппаФормы") Тогда
		ГруппаДляРазмещения = ГруппаДляГиперссылки;
	Иначе
		ГруппаДляРазмещения = Неопределено;
	КонецЕсли;
	
	Если ГруппаДляРазмещения = Неопределено Тогда
		ГруппаДляРазмещения = Форма.Элементы.Найти("ГруппаСостояниеЭДО");
	КонецЕсли;
	
	Если ГруппаДляРазмещения = Неопределено Тогда
		ГруппаДляРазмещения = Форма.Элементы.Найти("ГруппаСостояниеЭДОБГУ");
	КонецЕсли;
	
	Если ГруппаДляРазмещения = Неопределено Тогда
		ГруппаКомментарий = Форма.Элементы.Найти("ГруппаОтветственныйКомментарий");
		Если ГруппаКомментарий = Неопределено Тогда
			ГруппаДляРазмещения = Форма.Элементы.Добавить("ГруппаСостояниеЭДОБГУ", Тип("ГруппаФормы"));
		Иначе
			ГруппаДляРазмещения = Форма.Элементы.Вставить("ГруппаСостояниеЭДОБГУ", Тип("ГруппаФормы"),
				ГруппаКомментарий.Родитель, ГруппаКомментарий);
		КонецЕсли;
		ГруппаДляРазмещения.Вид = ВидГруппыФормы.ОбычнаяГруппа;
		ГруппаДляРазмещения.Отображение = ОтображениеОбычнойГруппы.Нет;
		ГруппаДляРазмещения.ОтображатьЗаголовок = Ложь;
		ГруппаДляРазмещения.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
		ГруппаДляРазмещения.РастягиватьПоГоризонтали = Истина;
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
			Форма.Элементы, ГруппаДляРазмещения.Имя, "Группировка", ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда);
	КонецЕсли;
	
	Возврат ГруппаДляРазмещения;
	
КонецФункции

Функция НайтиДобавитьГиперссылкуСостояниеЭД(Форма, ГруппаДляРазмещения)
	
	ИмяДекорации = ВнутреннийЭДОКлиентСервер.ИмяДекорацииСостояниеЭДО();
	Декорация = Форма.Элементы.Найти(ИмяДекорации);
	
	Если Декорация = Неопределено Тогда
		
		Декорация = Форма.Элементы.Добавить(ИмяДекорации, Тип("ДекорацияФормы"), ГруппаДляРазмещения);
		Декорация.Вид = ВидДекорацииФормы.Надпись;
		Декорация.Гиперссылка = Истина;
		Декорация.УстановитьДействие("Нажатие", "Подключаемый_ДекорацияБГУНажатие");
		
		ПодчиненныеЭлементы = ГруппаДляРазмещения.ПодчиненныеЭлементы;
		Если ПодчиненныеЭлементы.Количество() > 1 Тогда
			Форма.Элементы.Переместить(Декорация, ГруппаДляРазмещения, ПодчиненныеЭлементы.Получить(0));
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Декорация;
	
КонецФункции

Процедура УправлениеЭлементамиФормыУчетногоДокумента(Форма, Источник)
	
	СтандартнаяОбработка = Истина;
	Организация = Неопределено;
	ВнутреннийЭДОПереопределяемый.ПриПолученииОрганизацииПоОбъекту(Форма, Источник, Организация, СтандартнаяОбработка);
	
	Если СтандартнаяОбработка Тогда
		Организация = Источник.Организация;
	КонецЕсли;
	
	Ссылка = Источник.Ссылка;
	
	Если ТребуетсяЗапретитьРедактированиеФормыДокумента(Организация, Ссылка) Тогда
		Форма.ТолькоПросмотр = Истина;
	КонецЕсли;
	
КонецПроцедуры

// Возвращает актуальное состояние ЭДО учетного документа
// 
// Параметры:
//  УчетныйДокумент - ОпределяемыйТип.ОснованиеВнутреннегоЭлектронногоДокумента - объект учета.
// 
// Возвращаемое значение:
//  Структура - состояние актуальных электронных документов объекта учета:
//  * Состояние - ПеречислениеСсылка.СостоянияДокументовВнутреннегоЭДО
//  * ПредставлениеСостояния - Строка
//
Функция СостояниеУчетногоДокументаПоЭлектронным(УчетныйДокумент)
	
	Результат = Новый Структура;
	Результат.Вставить("Состояние", НачальноеСостояниеДокумента());
	Результат.Вставить("ПредставлениеСостояния", Строка(Результат.Состояние));
	
	СостоянияЭДО = СостоянияЭлектронныхДокументов(УчетныйДокумент);
	
	КоличествоВсего = СостоянияЭДО.Количество();
	
	Если КоличествоВсего = 0 Тогда
		Возврат Результат;
	ИначеЕсли КоличествоВсего = 1 Тогда
		Результат.Состояние = СостоянияЭДО[0];
		Результат.ПредставлениеСостояния = Строка(Результат.Состояние);
		Возврат Результат;
	КонецЕсли;
	
	НеНачат = Новый Массив;
	ВРаботе = Новый Массив;
	Завершен = Новый Массив;
	
	СостоянияЗавершенногоЭДО = СостоянияЗавершенногоЭДО();
	
	Для каждого Состояние Из СостоянияЭДО Цикл
		Если НЕ ЗначениеЗаполнено(Состояние) ИЛИ Состояние = НачальноеСостояниеДокумента() Тогда
			НеНачат.Добавить(Состояние);
		ИначеЕсли СостоянияЗавершенногоЭДО[Состояние] <> Неопределено Тогда
			Завершен.Добавить(Состояние);
		Иначе
			ВРаботе.Добавить(Состояние);
		КонецЕсли;
	КонецЦикла;
	
	Если НеНачат.Количество() Тогда
		Состояние = НеНачат[0];
		ПредставлениеСостояния = НСтр("ru='Не начат'");
		Количество = НеНачат.Количество();
	ИначеЕсли ВРаботе.Количество() Тогда
		Состояние = ВРаботе[0];
		ПредставлениеСостояния = НСтр("ru='В работе'");
		Количество = ВРаботе.Количество();
	Иначе
		Состояние = Завершен[0];
		ПредставлениеСостояния = НСтр("ru='Завершен'");
		Количество = Завершен.Количество();
	КонецЕсли;
	
	Если КоличествоВсего > 1 Тогда
		Если Количество = КоличествоВсего Тогда
			ДополнениеПредставления = Строка(Количество);
		Иначе
			ДополнениеПредставления = СтрШаблон("%1/%2", Количество, КоличествоВсего);
		КонецЕсли;
		ПредставлениеСостояния = СтрШаблон("%1 (%2)", ПредставлениеСостояния, ДополнениеПредставления);
	КонецЕсли;
	
	Результат.Состояние = Состояние;
	Результат.ПредставлениеСостояния = ПредставлениеСостояния;
	
	Возврат Результат;
	
КонецФункции

Функция СостоянияЭлектронныхДокументов(УчетныйДокумент)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СостоянияЭлектронныхДокументов.Состояние КАК Состояние
	|ИЗ
	|	РегистрСведений.СостоянияЭлектронныхДокументов КАК СостоянияЭлектронныхДокументов
	|ГДЕ
	|	СостоянияЭлектронныхДокументов.ЭлектронныйДокумент.УчетныйДокумент = &УчетныйДокумент
	|	И СостоянияЭлектронныхДокументов.Актуальный";
	
	Запрос.УстановитьПараметр("УчетныйДокумент", УчетныйДокумент);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Состояние");
	
КонецФункции

Функция СостоянияЗавершенногоЭДО()
	
	Состояния = Новый Соответствие;
	Состояния.Вставить(Перечисления.СостоянияДокументовВнутреннегоЭДО.Завершен, Истина);
	Состояния.Вставить(Перечисления.СостоянияДокументовВнутреннегоЭДО.Аннулирован, Истина);
	Состояния.Вставить(Перечисления.СостоянияДокументовВнутреннегоЭДО.ЗакрытПринудительно, Истина);
	Возврат Состояния;
	
КонецФункции

Процедура ОбновитьСостояниеУчетногоДокумента(УчетныйДокумент)
	
	Состояние = СостояниеУчетногоДокументаПоЭлектронным(УчетныйДокумент);
	
	УстановитьСостояниеУчетногоДокумента(УчетныйДокумент, Состояние.Состояние, Состояние.ПредставлениеСостояния);
	
КонецПроцедуры

Процедура УстановитьСостояниеЭлектронногоДокумента(ЭлектронныйДокумент, Состояние, ДатаИзменения, Актуальный, Комментарий)
	
	НаборЗаписей = РегистрыСведений.СостоянияЭлектронныхДокументов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ЭлектронныйДокумент.Установить(ЭлектронныйДокумент);
	
	Запись = НаборЗаписей.Добавить();
	Запись.ЭлектронныйДокумент = ЭлектронныйДокумент;
	Запись.Состояние = Состояние;
	Запись.Актуальный = Актуальный;
	Запись.ДатаИзменения = ДатаИзменения;
	Запись.Комментарий = Комментарий;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

Процедура УстановитьСостояниеУчетногоДокумента(УчетныйДокумент, Состояние, ПредставлениеСостояния)
	
	НаборЗаписей = РегистрыСведений.СостоянияУчетныхДокументов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.УчетныйДокумент.Установить(УчетныйДокумент);
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() = 0 Тогда
		
		Запись = НаборЗаписей.Добавить();
		Запись.УчетныйДокумент = УчетныйДокумент;
		Запись.Состояние = Состояние;
		Запись.ПредставлениеСостояния = ПредставлениеСостояния;
		
		НаборЗаписей.Записать();
		
	ИначеЕсли НаборЗаписей[0].Состояние <> Состояние
		ИЛИ НаборЗаписей[0].ПредставлениеСостояния <> ПредставлениеСостояния Тогда
		
		Запись = НаборЗаписей[0];
		Запись.Состояние = Состояние;
		Запись.ПредставлениеСостояния = ПредставлениеСостояния;
		
		НаборЗаписей.Записать();
		
	КонецЕсли;
	
КонецПроцедуры

Функция ДляПечатнойФормыВыполненаНастройкаВнутреннегоЭДО(Организация, ИдентификаторДокумента, ИдентификаторКомандыПечати)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НастройкиВнутреннегоЭДОБГУ.МаршрутПодписания КАК МаршрутПодписания
	|ИЗ
	|	РегистрСведений.НастройкиВнутреннегоЭДОБГУ КАК НастройкиВнутреннегоЭДОБГУ
	|ГДЕ
	|	НастройкиВнутреннегоЭДОБГУ.Организация = &Организация
	|	И НастройкиВнутреннегоЭДОБГУ.ИдентификаторДокумента = &ИдентификаторДокумента
	|	И НастройкиВнутреннегоЭДОБГУ.ИдентификаторКомандыПечати = &ИдентификаторКомандыПечати
	|	И НастройкиВнутреннегоЭДОБГУ.Формировать";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ИдентификаторДокумента", ИдентификаторДокумента);
	Запрос.УстановитьПараметр("ИдентификаторКомандыПечати", ИдентификаторКомандыПечати);
	
	Возврат НЕ Запрос.Выполнить().Пустой();
	
КонецФункции

Процедура ДобавитьЭлектроннуюПодпись(ВидПодписи, ФайлДляПодписи, СвойстваПодписи)
	
	Если ВидПодписи = ПредопределенноеЗначение("Перечисление.ВидыЭлектронныхПодписейБГУ.Усиленная") Тогда
		ЭлектроннаяПодпись.ДобавитьПодпись(ФайлДляПодписи, СвойстваПодписи);
	ИначеЕсли ВидПодписи = ПредопределенноеЗначение("Перечисление.ВидыЭлектронныхПодписейБГУ.Простая") Тогда
		ДобавитьПростуюПодпись(ФайлДляПодписи, СвойстваПодписи);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьПростуюПодпись(ФайлДляПодписи, СвойстваПодписи)
	
	ПорядковыйНомер = 1;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	МАКСИМУМ(ЭлектронныеПодписи.ПорядковыйНомер) КАК ПоследнийПорядковыйНомер
	|ИЗ
	|	РегистрСведений.ПростыеЭлектронныеПодписиБГУ КАК ЭлектронныеПодписи
	|ГДЕ
	|	ЭлектронныеПодписи.ПодписанныйОбъект = &ПодписанныйОбъект";
	
	Запрос.УстановитьПараметр("ПодписанныйОбъект", ФайлДляПодписи);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.ПоследнийПорядковыйНомер) Тогда
		ПорядковыйНомер = Выборка.ПоследнийПорядковыйНомер + 1;
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.ПростыеЭлектронныеПодписиБГУ.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ПодписанныйОбъект.Установить(ФайлДляПодписи);
	НаборЗаписей.Отбор.ПорядковыйНомер.Установить(ПорядковыйНомер);
	
	Запись = НаборЗаписей.Добавить();
	Запись.ПодписанныйОбъект = ФайлДляПодписи;
	Запись.ПорядковыйНомер = ПорядковыйНомер;
	Запись.ДатаПодписи = СвойстваПодписи.ДатаПодписи;
	Запись.ВладелецПодписи = СвойстваПодписи.ВладелецПодписи;
	Запись.УстановившийПодпись = СвойстваПодписи.УстановившийПодпись;
	Запись.Должность = СвойстваПодписи.Должность;
	Запись.Организация = СвойстваПодписи.Организация;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

// Формирует пустое дерево маршрута подписания со всеми необходимыми колонками.
// 
// Возвращаемое значение:
//  ДеревоЗначений - дерево маршрута подписания.
//
Функция ПустоеДеревоМаршрутаКПодписанию()
	
	ДеревоПодписания = Новый ДеревоЗначений;
	ДеревоПодписания.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("УникальныйИдентификатор"));
	ДеревоПодписания.Колонки.Добавить("Группа", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(30)));
	ДеревоПодписания.Колонки.Добавить("Подписант", Новый ОписаниеТипов("СправочникСсылка.Пользователи"));
	ДеревоПодписания.Колонки.Добавить("ВидПодписи", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыЭлектронныхПодписейБГУ"));
	
	//ДополнитьДеревоПодписанияСлужебнымиКолонками(ДеревоПодписания);
	
	Возврат ДеревоПодписания;
	
КонецФункции

// Заполняет дерево значений по таблице маршрута подписания.
//
// Параметры:
//  Дерево	 - ДеревоЗначений, Неопределено - дерево для формирования маршрута. Если не задано, будет сформировано.
//  Таблица	 - ТаблицаЗначений - таблица маршрута подписания. По структуре должна соответствовать табличной части
//    "СоставМаршрута" справочника "МаршрутыПодписания".
//
Процедура ЗаполнитьДеревоПоТаблицеМаршрута(Дерево, Таблица)
	
	// Если дерево не задано, инициализируем его
	Если Дерево = Неопределено Тогда
		Дерево = ПустоеДеревоМаршрутаКПодписанию();
	КонецЕсли;
	
	ПараметрыПоиска = Новый Структура("ИдентификаторРодителя", ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор());
	СтрокиВерхнегоУровня = Таблица.НайтиСтроки(ПараметрыПоиска);
	ПрочитатьСтрокиТаблицыМаршрутаВДерево(СтрокиВерхнегоУровня, Дерево, Таблица);
	
КонецПроцедуры

Процедура ПрочитатьСтрокиТаблицыМаршрутаВДерево(СтрокиТаблицы, РодительскийУзелДерева, Таблица)
	
	ПодчиненныеУзлы = РодительскийУзелДерева.Строки;
	
	Для Каждого СтрокаТаблицы Из СтрокиТаблицы Цикл
		
		НовыйУзел = ПодчиненныеУзлы.Добавить();
		ЗаполнитьЗначенияСвойств(НовыйУзел, СтрокаТаблицы);
		
		ДочерниеСтроки = Таблица.НайтиСтроки(Новый Структура("ИдентификаторРодителя", СтрокаТаблицы.Идентификатор));
		ПрочитатьСтрокиТаблицыМаршрутаВДерево(ДочерниеСтроки, НовыйУзел, Таблица);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьВспомогательныеКолонкиВДеревеМаршрута(УзелДерева, ИмяОсновногоРеквизита)
	
	СтрокиДерева = УзелДерева.ПолучитьЭлементы();
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		ЗаполнитьВспомогательныеКолонкиВДеревеМаршрута(СтрокаДерева, ИмяОсновногоРеквизита);
		ВнутреннийЭДОКлиентСервер.ЗаполнитьСлужебныеРеквизитыСтрокиДерева(СтрокаДерева, ИмяОсновногоРеквизита);
	КонецЦикла;
	
КонецПроцедуры

Процедура ВключитьСтартовыеЭтапыМаршрута(СоставМаршрута, ТекущаяСтрока = Неопределено)
	
	Если ТекущаяСтрока = Неопределено Тогда
		ТекущаяСтрока = СоставМаршрута.Найти(
			ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор(), "ИдентификаторРодителя");
	КонецЕсли;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущаяСтрока.Группа) Тогда
		Если ТекущаяСтрока.Группа = "И" ИЛИ ТекущаяСтрока.Группа = "ИЛИ" Тогда
			ПодчиненныеСтроки = СоставМаршрута.НайтиСтроки(
				Новый Структура("ИдентификаторРодителя", ТекущаяСтрока.Идентификатор));
			Для Каждого ПодчиненнаяСтрока Из ПодчиненныеСтроки Цикл
				ВключитьСтартовыеЭтапыМаршрута(СоставМаршрута, ПодчиненнаяСтрока);
			КонецЦикла;
		ИначеЕсли ТекущаяСтрока.Группа = "ПоОчереди" Тогда
			ПодчиненныеСтроки = СоставМаршрута.НайтиСтроки(
				Новый Структура("ИдентификаторРодителя, Порядок", ТекущаяСтрока.Идентификатор, 1));
			Для Каждого ПодчиненнаяСтрока Из ПодчиненныеСтроки Цикл
				ВключитьСтартовыеЭтапыМаршрута(СоставМаршрута, ПодчиненнаяСтрока);
				Прервать;
			КонецЦикла;
		Иначе
			ВызватьИсключение НСтр("ru='Недопустимое значение группы маршрута'");
		КонецЕсли;
	ИначеЕсли НЕ ЗначениеЗаполнено(ТекущаяСтрока.Состояние)
		ИЛИ ТекущаяСтрока.Состояние = НачальноеСостояниеДокумента() Тогда
		ТекущаяСтрока.Состояние = ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.ТребуетсяПодписание");
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьВозможностьПодписанияЭлектронногоДокумента(Состояние)
	
	Если НЕ Состояние.Актуальный Тогда
		ВызватьИсключение НСтр("ru = 'Документ не актуальный'");
	ИначеЕсли Состояние.Состояние <> ПредопределенноеЗначение(
		"Перечисление.СостоянияДокументовВнутреннегоЭДО.ТребуетсяПодписание") Тогда
		ВызватьИсключение НСтр("ru = 'Состояние документа не предполагает подписание'");
