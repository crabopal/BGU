	КонецПопытки;
	
КонецПроцедуры

Функция ДоступныеДляВыбораСертификатыКлючейЭП() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сертификаты.Ссылка КАК Ссылка,
	|	Сертификаты.Пользователь КАК Пользователь
	|ПОМЕСТИТЬ ВсеСертификаты
	|ИЗ
	|	Справочник.СертификатыКлючейЭлектроннойПодписиИШифрования КАК Сертификаты
	|ГДЕ
	|	НЕ Сертификаты.Отозван
	|	И НЕ Сертификаты.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВсеСертификаты.Ссылка КАК Ссылка
	|ИЗ
	|	ВсеСертификаты КАК ВсеСертификаты";
	
	Если НЕ Пользователи.ЭтоПолноправныйПользователь( , , Ложь) Тогда
		
		Запрос.Текст = Запрос.Текст + "
		|ГДЕ
		|	ВсеСертификаты.Ссылка В
		|			(ВЫБРАТЬ
		|				ВсеСертификаты.Ссылка КАК Ссылка
		|			ИЗ
		|				ВсеСертификаты КАК ВсеСертификаты
		|					ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СертификатыКлючейЭлектроннойПодписиИШифрования.Пользователи КАК СертификатыКлючейЭлектроннойПодписиИШифрованияПользователи
		|					ПО
		|						ВсеСертификаты.Ссылка = СертификатыКлючейЭлектроннойПодписиИШифрованияПользователи.Ссылка
		|			ГДЕ
		|				ВсеСертификаты.Пользователь В (&Пользователи)
		|				И СертификатыКлючейЭлектроннойПодписиИШифрованияПользователи.Пользователь ЕСТЬ NULL
		|		
		|			ОБЪЕДИНИТЬ ВСЕ
		|		
		|			ВЫБРАТЬ
		|				ВсеСертификаты.Ссылка
		|			ИЗ
		|				ВсеСертификаты КАК ВсеСертификаты
		|					ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СертификатыКлючейЭлектроннойПодписиИШифрования.Пользователи КАК СертификатыКлючейЭлектроннойПодписиИШифрованияПользователи
		|					ПО
		|						ВсеСертификаты.Ссылка = СертификатыКлючейЭлектроннойПодписиИШифрованияПользователи.Ссылка
		|			ГДЕ
		|				СертификатыКлючейЭлектроннойПодписиИШифрованияПользователи.Пользователь В (&Пользователи))";
		
		ПользователиДляОтбора = Новый Массив;
		ПользователиДляОтбора.Добавить(Пользователи.АвторизованныйПользователь());
		ПользователиДляОтбора.Добавить(Справочники.Пользователи.ПустаяСсылка());
		ПользователиДляОтбора.Добавить(Пользователи.СсылкаНеуказанногоПользователя());
		
		Запрос.УстановитьПараметр("Пользователи", ПользователиДляОтбора);
		
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

Процедура ПодписатьЭлектронныйДокумент(Параметры) Экспорт
	
	УчетныйДокумент = Параметры.УчетныйДокумент;
	ЭлектронныйДокумент = Параметры.ЭлектронныйДокумент;
	ВидПодписи = Параметры.ВидПодписи;
	ФайлДляПодписи = Параметры.ФайлДляПодписи;
	ЭтоДанныеPDF = Параметры.ЭтоДанныеPDF;
	
	Если ТипЗнч(Параметры.СвойстваПодписи) = Тип("Строка") Тогда
		СвойстваПодписи = ПолучитьИзВременногоХранилища(Параметры.СвойстваПодписи);
	Иначе
		СвойстваПодписи = Параметры.СвойстваПодписи;
	КонецЕсли;
	
	Подписант = СвойстваПодписи.УстановившийПодпись;
	ДатаИзменения = СвойстваПодписи.ДатаПодписи;
	
	НачатьТранзакцию();
	Попытка
		
		Если НЕ ЭтоДанныеPDF Тогда
			ЗаблокироватьРегистрСостоянияУчетныхДокументов(УчетныйДокумент);
			
			ТекущееСостояние = СостояниеЭлектронногоДокумента(ЭлектронныйДокумент);
			
			ПроверитьВозможностьПодписанияЭлектронногоДокумента(ТекущееСостояние);
			
			МаршрутПодписания = СоставМаршрутаПодписанияДокумента(ЭлектронныйДокумент);
			
			ПараметрыПодписи = Новый Структура;
			ПараметрыПодписи.Вставить("ЭлектронныйДокумент", ЭлектронныйДокумент);
			ПараметрыПодписи.Вставить("Подписант", Подписант);
			ПараметрыПодписи.Вставить("ВидПодписи", ВидПодписи);
			ПараметрыПодписи.Вставить("ДатаПодписи", ДатаИзменения);
			
			ОтметитьПодписаниеВМаршрутеЭлектронногоДокумента(ПараметрыПодписи, МаршрутПодписания);
			
			ОбновитьСостоянияВМаршрутеЭлектронногоДокумента(ЭлектронныйДокумент, МаршрутПодписания);
			
			ПараметрыСостояния = Новый Структура;
			ПараметрыСостояния.Вставить("ЭлектронныйДокумент", ЭлектронныйДокумент);
			ПараметрыСостояния.Вставить("ДатаИзменения", ДатаИзменения);
			ПараметрыСостояния.Вставить("ТекущееСостояние", ТекущееСостояние);
			
			ОбновитьСостояниеЭлектронногоДокументаПоМаршруту(ПараметрыСостояния, МаршрутПодписания);
		КонецЕсли;
	
		ДобавитьЭлектроннуюПодпись(ВидПодписи, ФайлДляПодписи, СвойстваПодписи);

		Если НЕ ЭтоДанныеPDF Тогда
			ОбновитьСостояниеУчетногоДокумента(УчетныйДокумент);
		КонецЕсли;
		
		ЗафиксироватьТранзакцию()
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура ПодписатьЭлектронныйДокументPDF(Параметры) Экспорт
	
	УчетныйДокумент = Параметры.УчетныйДокумент;
	ЭлектронныйДокумент = Параметры.ЭлектронныйДокумент;
	ВидПодписи = Параметры.ВидПодписи;
	
	ФайлДляПодписиPDF = Параметры.ФайлДляПодписиPDF;
	
	Если ТипЗнч(Параметры.СвойстваПодписи) = Тип("Строка") Тогда
		СвойстваПодписиPDF = ПолучитьИзВременногоХранилища(Параметры.СвойстваПодписи);
	Иначе
		СвойстваПодписиPDF = Параметры.СвойстваПодписи;
	КонецЕсли;
	
	Подписант = СвойстваПодписиPDF.УстановившийПодпись;
	ДатаИзменения = СвойстваПодписиPDF.ДатаПодписи;
	
	НачатьТранзакцию();
	Попытка
		
		ДобавитьЭлектроннуюПодпись(ВидПодписи, ФайлДляПодписиPDF, СвойстваПодписиPDF);
		
		ЗафиксироватьТранзакцию()
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура ОтказатьсяОтПодписанияЭлектронногоДокумента(Параметры) Экспорт
	
	УчетныйДокумент = Параметры.УчетныйДокумент;
	ЭлектронныйДокумент = Параметры.ЭлектронныйДокумент;
	ВидПодписи = Параметры.ВидПодписи;
	Комментарий = Параметры.Комментарий;
	
	ТекущийПользователь = Пользователи.ТекущийПользователь();
	ДатаИзменения = ТекущаяДатаСеанса();
	
	НачатьТранзакцию();
	Попытка
		
		ЗаблокироватьРегистрСостоянияУчетныхДокументов(УчетныйДокумент);
		
		ТекущееСостояние = СостояниеЭлектронногоДокумента(ЭлектронныйДокумент);
		
		ПроверитьВозможностьОтказаОтПодписанияЭлектронногоДокумента(ТекущееСостояние);
		
		МаршрутПодписания = СоставМаршрутаПодписанияДокумента(ЭлектронныйДокумент);
		
		ПараметрыПодписи = Новый Структура;
		ПараметрыПодписи.Вставить("ЭлектронныйДокумент", ЭлектронныйДокумент);
		ПараметрыПодписи.Вставить("Подписант", ТекущийПользователь);
