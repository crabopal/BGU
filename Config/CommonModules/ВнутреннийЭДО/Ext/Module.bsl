Процедура АннулироватьЭлектронныеДокументы(УчетныеДокументы) Экспорт
	
	МассивУчетныхДокументов = Новый Массив;
	Для Каждого КлючЗначение Из УчетныеДокументы Цикл
		МассивУчетныхДокументов.Добавить(КлючЗначение.Ключ);
	КонецЦикла;
	
	НачатьТранзакцию();
	Попытка
		
		ЗаблокироватьРегистрСостоянияУчетныхДокументов(МассивУчетныхДокументов);
		
		Для Каждого КлючЗначение Из УчетныеДокументы Цикл
			
			УчетныйДокумент = КлючЗначение.Ключ;
			
			Для Каждого ПараметрыДействия Из КлючЗначение.Значение Цикл
				
				ЭлектронныйДокумент = ПараметрыДействия.ЭлектронныйДокумент;
				ВидПодписи = ПараметрыДействия.ВидПодписи;
				Комментарий = ПараметрыДействия.Комментарий;
				Ответственный = ПараметрыДействия.Ответственный;
				
				ТекущееСостояние = СостояниеЭлектронногоДокумента(ЭлектронныйДокумент);
				
				ПроверитьВозможностьАннулированияЭлектронногоДокумента(ТекущееСостояние);
				
				МаршрутПодписания = СоставМаршрутаПодписанияДокумента(ЭлектронныйДокумент);
				
				ПараметрыПодписи = Новый Структура;
				ПараметрыПодписи.Вставить("ЭлектронныйДокумент", ЭлектронныйДокумент);
				ПараметрыПодписи.Вставить("Подписант", Ответственный);
				ПараметрыПодписи.Вставить("ВидПодписи", ВидПодписи);
				
				ОтметитьАннулированиеВМаршрутеЭлектронногоДокумента(ПараметрыПодписи, МаршрутПодписания);
				
				ОбновитьСостоянияВМаршрутеЭлектронногоДокумента(ЭлектронныйДокумент, МаршрутПодписания);
				
				ПараметрыСостояния = Новый Структура;
				ПараметрыСостояния.Вставить("УчетныйДокумент", УчетныйДокумент);
				ПараметрыСостояния.Вставить("ЭлектронныйДокумент", ЭлектронныйДокумент);
				ПараметрыСостояния.Вставить("ДатаИзменения", ТекущаяДатаСеанса());
				ПараметрыСостояния.Вставить("Состояние",
				ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.Аннулирован"));
				ПараметрыСостояния.Вставить("Актуальный", Истина);
				ПараметрыСостояния.Вставить("Комментарий", Комментарий);
				
				УстановитьСостояниеДокумента(ПараметрыСостояния);
				
			КонецЦикла;
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию()
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

