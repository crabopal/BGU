Функция ЭлектронныеДокументыАктуальные(УчетныйДокумент) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СостоянияЭлектронныхДокументов.ЭлектронныйДокумент КАК ЭлектронныйДокумент,
	|	ПРЕДСТАВЛЕНИЕ(СостоянияЭлектронныхДокументов.ЭлектронныйДокумент) КАК ПредставлениеДокумента,
	|	СостоянияЭлектронныхДокументов.ЭлектронныйДокумент.ВидДокумента КАК ВидДокумента,
	|	СостоянияЭлектронныхДокументов.ЭлектронныйДокумент.ИдентификаторКомандыПечати КАК ИдентификаторКомандыПечати,
	|	СостоянияЭлектронныхДокументов.Состояние КАК Состояние
	|ИЗ
	|	РегистрСведений.СостоянияЭлектронныхДокументов КАК СостоянияЭлектронныхДокументов
	|ГДЕ
	|	СостоянияЭлектронныхДокументов.ЭлектронныйДокумент.УчетныйДокумент = &УчетныйДокумент
	|	И СостоянияЭлектронныхДокументов.Актуальный";
	
	Запрос.УстановитьПараметр("УчетныйДокумент", УчетныйДокумент);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ЭлектронныеДокументыИзНастройки(Организация, ИдентификаторДокумента) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НастройкиВнутреннегоЭДОБГУ.ИдентификаторКомандыПечати КАК ИдентификаторКомандыПечати,
	|	НастройкиВнутреннегоЭДОБГУ.МаршрутПодписания КАК МаршрутПодписания,
	|	&НачальноеСостояниеДокумента КАК Состояние
	|ИЗ
	|	РегистрСведений.НастройкиВнутреннегоЭДОБГУ КАК НастройкиВнутреннегоЭДОБГУ
	|ГДЕ
	|	НастройкиВнутреннегоЭДОБГУ.Организация = &Организация
	|	И НастройкиВнутреннегоЭДОБГУ.ИдентификаторДокумента = &ИдентификаторДокумента
	|	И НастройкиВнутреннегоЭДОБГУ.Формировать
	|
	|УПОРЯДОЧИТЬ ПО
	|	НастройкиВнутреннегоЭДОБГУ.ОсновнаяПечатнаяФорма УБЫВ";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ИдентификаторДокумента", ИдентификаторДокумента);
	Запрос.УстановитьПараметр("НачальноеСостояниеДокумента", НачальноеСостояниеДокумента());
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция СостояниеАктуальногоЭлектронногоДокумента(УчетныйДокумент, ИдентификаторКомандыПечати) Экспорт
	
	ЭлектронныйДокумент = АктуальныйЭлектронныйДокумент(УчетныйДокумент, ИдентификаторКомандыПечати);
	
	Возврат СостояниеЭлектронногоДокумента(ЭлектронныйДокумент);
	
КонецФункции

Функция АктуальныйЭлектронныйДокумент(УчетныйДокумент, ИдентификаторКомандыПечати) Экспорт
	
	Результат = РезультатЗапросаАктуальногоЭлектроногоДокумента(УчетныйДокумент, ИдентификаторКомандыПечати);
	
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ЭлектронныйДокумент;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция СуществуетАктуальныйЭлектронныйДокумент(УчетныйДокумент, ИдентификаторКомандыПечати) Экспорт
	
	Результат = РезультатЗапросаАктуальногоЭлектроногоДокумента(УчетныйДокумент, ИдентификаторКомандыПечати);
	
	Возврат НЕ Результат.Пустой();
	
КонецФункции

Функция СостояниеЭлектронногоДокумента(ЭлектронныйДокумент) Экспорт
	
	Состояние = Новый Структура;
	Состояние.Вставить("Состояние", НачальноеСостояниеДокумента());
	Состояние.Вставить("ПредставлениеСостояния", Строка(Состояние.Состояние));
	Состояние.Вставить("ДатаИзменения", '00010101');
	Состояние.Вставить("Комментарий", "");
	Состояние.Вставить("Актуальный", Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СостоянияЭлектронныхДокументов.Состояние КАК Состояние,
	|	ПРЕДСТАВЛЕНИЕ(СостоянияЭлектронныхДокументов.Состояние) КАК ПредставлениеСостояния,
	|	СостоянияЭлектронныхДокументов.ДатаИзменения КАК ДатаИзменения,
	|	СостоянияЭлектронныхДокументов.Комментарий КАК Комментарий,
	|	СостоянияЭлектронныхДокументов.Актуальный КАК Актуальный
	|ИЗ
	|	РегистрСведений.СостоянияЭлектронныхДокументов КАК СостоянияЭлектронныхДокументов
	|ГДЕ
	|	СостоянияЭлектронныхДокументов.ЭлектронныйДокумент = &ЭлектронныйДокумент";
	
	Запрос.УстановитьПараметр("ЭлектронныйДокумент", ЭлектронныйДокумент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Состояние, Выборка);
	КонецЕсли;
	
	Возврат Состояние;
	
КонецФункции

Функция СостояниеУчетногоДокумента(УчетныйДокумент) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Состояние", НачальноеСостояниеДокумента());
	Результат.Вставить("ПредставлениеСостояния", Строка(Результат.Состояние));
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СостоянияУчетныхДокументов.Состояние КАК Состояние,
	|	ПРЕДСТАВЛЕНИЕ(СостоянияУчетныхДокументов.Состояние) КАК ПредставлениеСостояния
	|ИЗ
	|	РегистрСведений.СостоянияУчетныхДокументов КАК СостоянияУчетныхДокументов
	|ГДЕ
	|	СостоянияУчетныхДокументов.УчетныйДокумент = &УчетныйДокумент";
	
	Запрос.УстановитьПараметр("УчетныйДокумент", УчетныйДокумент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НачальноеСостояниеДокумента() Экспорт
	
	Возврат ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.НеНачат");
	
КонецФункции

Функция СостояниеДокументаТребуетсяПодписание() Экспорт
	
	Возврат ПредопределенноеЗначение("Перечисление.СостоянияДокументовВнутреннегоЭДО.ТребуетсяПодписание");
	
КонецФункции

Процедура УстановитьСостояниеДокумента(Параметры) Экспорт
	
	УчетныйДокумент = Параметры.УчетныйДокумент;
	ЭлектронныйДокумент = Параметры.ЭлектронныйДокумент; // ДокументСсылка.ВнутреннийЭлектронныйДокумент
	Состояние = Параметры.Состояние;
	Актуальный = Параметры.Актуальный;
	Комментарий = Параметры.Комментарий;
	ДатаИзменения = Параметры.ДатаИзменения;
	
	Если НЕ ЗначениеЗаполнено(ДатаИзменения) Тогда
		ДатаИзменения = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(УчетныйДокумент) Тогда
		УчетныйДокумент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭлектронныйДокумент, "УчетныйДокумент");
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		
		УстановитьСостояниеЭлектронногоДокумента(ЭлектронныйДокумент, Состояние, ДатаИзменения, Актуальный, Комментарий);
		
		ОбновитьСостояниеУчетногоДокумента(УчетныйДокумент);
		
		ЗафиксироватьТранзакцию()
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// Заполняет на форме дерево маршрута подписания.
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма, на которой нужно отрисовать дерево маршрута подписания.
//  ТаблицаМаршрута - ТаблицаЗначений
//  ИсточникДанных - ДокументСсылка.СообщениеЭДОПрисоединенныеФайлы, ДокументСсылка.СообщениеОбменСБанками - ссылка на электронный документ.
//  ИмяРеквизитаДерева - Строка - имя реквизита дерева маршрута на форме.
//  ИмяОсновногоРеквизита- Строка - имя реквизита дерева, который будет выводиться в основной колонке.
//
Процедура ЗаполнитьДеревоМаршрутаНаФорме(Форма, ТаблицаМаршрута, ИмяРеквизитаДерева, ИмяОсновногоРеквизита) Экспорт
	
	// Заполним дерево из табличной части
	Дерево = Форма.РеквизитФормыВЗначение(ИмяРеквизитаДерева);
	Дерево.Строки.Очистить();
	ЗаполнитьДеревоПоТаблицеМаршрута(Дерево, ТаблицаМаршрута);
	Форма.ЗначениеВРеквизитФормы(Дерево, ИмяРеквизитаДерева);
	
	// Инициализируем вспомогательные колонки в дереве
	ЗаполнитьВспомогательныеКолонкиВДеревеМаршрута(Форма[ИмяРеквизитаДерева], ИмяОсновногоРеквизита);
	
КонецПроцедуры

Процедура ЗаполнитьТаблицуСоставМаршрутаПоДереву(Дерево, Таблица) Экспорт
	
	// Если таблица не задана, инициализируем ее
	Если Таблица = Неопределено Тогда
		Таблица = ПустаяТаблицаМаршрутаКПодписанию();
	КонецЕсли;
	
	ПрочитатьСтрокиДереваВТаблицуСоставМаршрута(Дерево, Таблица);
	
КонецПроцедуры

Процедура СохранитьМаршрутПодписанияДокумента(ПараметрыМаршрута) Экспорт
	
	ЭлектронныйДокумент = ПараметрыМаршрута.ЭлектронныйДокумент;
	СоставМаршрута = ПараметрыМаршрута.СоставМаршрута;
	
	ВключитьСтартовыеЭтапыМаршрута(СоставМаршрута);
	
	НаборЗаписей = РегистрыСведений.СоставМаршрутаЭлектронногоДокумента.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ЭлектронныйДокумент.Установить(ЭлектронныйДокумент);
	
	Для Каждого СтрокаМаршрута Из СоставМаршрута Цикл
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.ЭлектронныйДокумент = ЭлектронныйДокумент;
		ЗаполнитьЗначенияСвойств(НоваяЗапись, СтрокаМаршрута);
	КонецЦикла;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

Функция СоставМаршрутаПодписания(МаршрутПодписания) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СоставМаршрута.Идентификатор КАК Идентификатор,
	|	СоставМаршрута.ИдентификаторРодителя КАК ИдентификаторРодителя,
	|	СоставМаршрута.Порядок КАК Порядок,
	|	СоставМаршрута.Группа КАК Группа,
	|	СоставМаршрута.Подписант КАК Подписант,
	|	СоставМаршрута.ВидПодписи КАК ВидПодписи,
	|	СоставМаршрута.Сертификат КАК Сертификат,
	|	СоставМаршрута.НомерСтроки КАК НомерСтрокиМаршрута,
