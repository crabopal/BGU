Процедура ИзменитьМаршрутыПодписанияВНеподписанныхВнутреннихЭД(Знач Дерево) Экспорт
	
	НачатьТранзакцию();
	Попытка
		ТЗИзмененныхСтрокМаршрута = ПустаяТаблицаМаршрутаКПодписанию();
		ПрочитатьСтрокиДереваВТаблицуСоставМаршрута(Дерево, ТЗИзмененныхСтрокМаршрута); 
		ТЗИзмененныхСтрокМаршрута.Индексы.Добавить("Идентификатор");
		
		МассивИдентификаторов = ТЗИзмененныхСтрокМаршрута.Скопировать(,"Идентификатор");
		МассивЭлектронныхДокументов = ПолучитьМассивЭлектронныхДокументовПоИдентификаторуМаршрутаПодписания(МассивИдентификаторов);
		
		ЗаблокироватьРегистрСоставМаршрутаЭлектронногоДокумента(МассивЭлектронныхДокументов);
		
		Для Каждого Элемент Из МассивЭлектронныхДокументов Цикл
			
			НаборЗаписей = РегистрыСведений.СоставМаршрутаЭлектронногоДокумента.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ЭлектронныйДокумент.Установить(Элемент);
			НаборЗаписей.Прочитать();
			
			Для Каждого Запись Из НаборЗаписей Цикл 
				
				НайденнаяСтрока = ТЗИзмененныхСтрокМаршрута.Найти(Запись.Идентификатор,"Идентификатор");
				
				Если НайденнаяСтрока = Неопределено ИЛИ Запись.Состояние <> Перечисления.СостоянияДокументовВнутреннегоЭДО.ТребуетсяПодписание  
						 ИЛИ Запись.ИзмененПользователем Тогда
					Продолжить;
				КонецЕсли;
				
				УсловиеСравненияСертификатов = 
					ЗначениеЗаполнено(НайденнаяСтрока.Сертификат) <> ЗначениеЗаполнено(Запись.Сертификат)
					ИЛИ НайденнаяСтрока.Сертификат <> Запись.Сертификат; 
				
				Если НайденнаяСтрока.ВидПодписи <> Запись.ВидПодписи
						ИЛИ УсловиеСравненияСертификатов
						ИЛИ НайденнаяСтрока.Подписант <> Запись.Подписант Тогда 
					Запись.Подписант  = НайденнаяСтрока.Подписант;
					Запись.ВидПодписи = НайденнаяСтрока.ВидПодписи;
					Запись.Сертификат = ?(НайденнаяСтрока.ВидПодписи = Перечисления.ВидыЭлектронныхПодписейБГУ.Простая,
						Неопределено, НайденнаяСтрока.Сертификат);
				КонецЕсли;
			КонецЦикла;
			НаборЗаписей.Записать();	
		КонецЦикла;	
	
		ЗафиксироватьТранзакцию(); 
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// Установить исключительную управляемую блокировку на регистр сведений "ТекущиеСтатусыДокументов"
// по измерению "УчетныйДокумент" согласно указанным документам.
//
// Параметры:
//   УчетныеДокументы - Массив из ДокументСсылка, ДокументСсылка - ссылки на документы или одна ссылка.
//
Процедура ЗаблокироватьРегистрСостоянияУчетныхДокументов(УчетныеДокументы) Экспорт
	
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Если ТипЗнч(УчетныеДокументы) = Тип("Массив") Тогда
			Для Каждого УчетныйДокумент Из УчетныеДокументы Цикл
				ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.СостоянияУчетныхДокументов");
				ЭлементБлокировки.УстановитьЗначение("УчетныйДокумент", УчетныйДокумент);
			КонецЦикла;
		Иначе
			ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.СостоянияУчетныхДокументов");
			ЭлементБлокировки.УстановитьЗначение("УчетныйДокумент", УчетныеДокументы);
		КонецЕсли;
		Блокировка.Заблокировать();
	Исключение
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// Установить исключительную управляемую блокировку на регистр сведений "СоставМаршрутаЭлектронногоДокумента"
// по измерению "Электронный документ" согласно указанным документам.
