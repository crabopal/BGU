	ЗаполнитьЗначенияСвойств(Запись, СтрокиМаршрута[0]);
	Запись.ЭлектронныйДокумент = ЭлектронныйДокумент;
	Запись.Состояние = СостояниеПодписано;
	Запись.ДатаПодписи = ДатаПодписи;
	
	НаборЗаписей.Записать();
	
	СтрокиМаршрута[0].Состояние = СостояниеПодписано;
	СтрокиМаршрута[0].ДатаПодписи = ДатаПодписи;
	
