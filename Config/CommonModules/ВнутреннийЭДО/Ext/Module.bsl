Процедура УстановитьУсловноеОформлениеДереваМаршрута(Форма, ИмяРеквизитаДерева) Экспорт
	
	// Видимость колонки "ВидПодписи"
	Элемент = Форма.УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ИмяРеквизитаДерева + "ВидПодписи");
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяРеквизитаДерева + ".ЭтоСтрокаУсловия");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	Элемент.Оформление.УстановитьЗначениеПараметра("Отображать", Ложь);
	
	// Видимость колонки "Сертификат"
	Элемент = Форма.УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ИмяРеквизитаДерева + "Сертификат");
	
	ГруппаИли = Элемент.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаИли.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
	
	ОтборЭлемента = ГруппаИли.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяРеквизитаДерева + ".ЭтоСтрокаУсловия");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	ОтборЭлемента = ГруппаИли.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяРеквизитаДерева + ".ВидПодписи");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
	ОтборЭлемента.ПравоеЗначение = ПредопределенноеЗначение("Перечисление.ВидыЭлектронныхПодписейБГУ.Усиленная");
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	Элемент.Оформление.УстановитьЗначениеПараметра("Отображать", Ложь);
	
	// Текст пустой колонки "Сертификат"
	Элемент = Форма.УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ИмяРеквизитаДерева + "Сертификат");
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяРеквизитаДерева + ".Сертификат");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'любым сертификатом'"));
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ПоясняющийТекст);
	
КонецПроцедуры

Процедура ПроверитьДеревоМаршрутаПодписания(ДеревоМаршрута, Отказ) Экспорт
	
	ПараметрыПроверки = Новый Структура;
	ПараметрыПроверки.Вставить("ЕстьПустыеЗначения", Ложь);
	ПараметрыПроверки.Вставить("ЕстьПустыеВидыПодписи", Ложь);
	ПараметрыПроверки.Вставить("ЕстьГруппыБезПодписантов", Ложь);
	
	Для Каждого СтрокаДерева Из ДеревоМаршрута.ПолучитьЭлементы() Цикл
		ПроверитьСтрокуДереваМаршрутаПодписания(СтрокаДерева, ПараметрыПроверки);
	КонецЦикла;
	
	Ошибки = Неопределено;
	
	Если ПараметрыПроверки.ЕстьПустыеЗначения Тогда
		ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки, "ДеревоМаршрута", 
			НСтр("ru = 'В составе маршрута есть незаполненные группы и/или пользователи'"), Неопределено);
	КонецЕсли;
	
	Если ПараметрыПроверки.ЕстьПустыеВидыПодписи Тогда
		ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки, "ДеревоМаршрута", 
			НСтр("ru = 'В составе маршрута есть незаполненные виды подписи'"), Неопределено);
	КонецЕсли;
	
	Если ПараметрыПроверки.ЕстьГруппыБезПодписантов Тогда
		ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки, "ДеревоМаршрута", 
			НСтр("ru = 'В составе маршрута есть группы, не содержащие подписантов'"), Неопределено);
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки, Отказ);
	
КонецПроцедуры

Функция ТабличныеДокументыИдентичны(ПервыйТабличныйДокумент, ВторойТабличныйДокумент) Экспорт
	
	ПредставлениеПервогоДокумента = ТабличныйДокументСтрокой(ПервыйТабличныйДокумент);
	УдалитьСлужебныеТеги(ПредставлениеПервогоДокумента);
	
	ПредставлениеВторогоДокумента = ТабличныйДокументСтрокой(ВторойТабличныйДокумент);
	УдалитьСлужебныеТеги(ПредставлениеВторогоДокумента);
	
	Возврат ПредставлениеПервогоДокумента = ПредставлениеВторогоДокумента;
	
КонецФункции


Функция ТабличныйДокументИзДвоичныхДанныхАрхива(ДвоичныеДанные) Экспорт
	
	ТабДок = Новый ТабличныйДокумент;
	
	Если ДвоичныеДанные = Неопределено Тогда
		Возврат ТабДок;
	КонецЕсли;
	
	ВременныйКаталог = ФайловаяСистема.СоздатьВременныйКаталог();
	
	Попытка
		ЧтениеZipФайла = Новый ЧтениеZipФайла(ДвоичныеДанные.ОткрытьПотокДляЧтения());
	Исключение
		Возврат ТабДок;
	КонецПопытки;
	
	Для Каждого ЭлементZipФайла Из ЧтениеZipФайла.Элементы Цикл
		Если НРег(ЭлементZipФайла.Расширение) = "mxl" Тогда
			ЧтениеZipФайла.Извлечь(ЭлементZipФайла, ВременныйКаталог);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	ЧтениеZipФайла.Закрыть();

	Если НайтиФайлы(ВременныйКаталог,"*.mxl").Количество()  > 0 Тогда
		ТабДок.Прочитать(НайтиФайлы(ВременныйКаталог,"*.mxl")[0].ПолноеИмя);
	КонецЕсли; 
	
	//@skip-check empty-except-statement
	Попытка
		ФайловаяСистема.УдалитьВременныйКаталог(ВременныйКаталог);
	Исключение
		// Обработка исключения не требуется
	КонецПопытки;
	
	Возврат ТабДок;
	
КонецФункции

Функция ДвоичныеДанныеУчетногоДокумента(Параметры) Экспорт
	
	Если Параметры.Свойство("АдресТабличногоДокумента") И ЗначениеЗаполнено(Параметры.АдресТабличногоДокумента) Тогда
		
		Если Параметры.Свойство("ИмяФайла") Тогда
		
			ИмяВременногоКаталога = ФайловаяСистема.СоздатьВременныйКаталог();
			
			ИмяФайла = СтроковыеФункции.СтрокаЛатиницей(Параметры.ИмяФайла);
			
			ПолноеИмяФайла = ФайловаяСистема.УникальноеИмяФайла(
				ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ИмяВременногоКаталога)
				+ ИмяФайла + ".mxl");
			
		Иначе
			
			ПолноеИмяФайла = ПолучитьИмяВременногоФайла("mxl");
			ИмяВременногоКаталога = ПолноеИмяФайла;
			
		КонецЕсли;
		
		ТабДок = ПолучитьИзВременногоХранилища(Параметры.АдресТабличногоДокумента);
		ТабДок.Записать(ПолноеИмяФайла, ТипФайлаТабличногоДокумента.MXL);
		
		ИмяАрхива = ПолучитьИмяВременногоФайла("zip");
		ЗаписьZipФайла = Новый ЗаписьZipФайла(ИмяАрхива);
		ЗаписьZipФайла.Добавить(ПолноеИмяФайла);
		ЗаписьZipФайла.Записать();
		
		ДвоичныеДанные = Новый ДвоичныеДанные(ИмяАрхива);
		
		ФайловаяСистема.УдалитьВременныйКаталог(ИмяВременногоКаталога);
		ФайловаяСистема.УдалитьВременныйФайл(ИмяАрхива);
		
		Возврат ДвоичныеДанные;
		
	ИначеЕсли Параметры.Свойство("ИдентификаторДокумента") Тогда
		ИдентификаторДокумента = Параметры.ИдентификаторДокумента;
	Иначе
		ИдентификаторДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(Параметры.УчетныйДокумент));
	КонецЕсли;
	
	КомандыПечати = КомандыПечатиОбъекта(
		ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(ИдентификаторДокумента));
	
	КомандаПечати = КомандаПечатиПоИдентификатору(КомандыПечати, Параметры.ИдентификаторКомандыПечати);
	
	Если КомандаПечати = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	КомандаПечати = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(КомандаПечати);
	КомандаПечати.ДополнительныеПараметры.Вставить("ИсключитьШтампы");
	
	ОбъектУчета = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Параметры.УчетныйДокумент);
	
	НастройкиСохранения = УправлениеПечатью.НастройкиСохранения();
	НастройкиСохранения.ФорматыСохранения.Добавить(ТипФайлаТабличногоДокумента.MXL);
	НастройкиСохранения.УпаковатьВАрхив = Истина;
	НастройкиСохранения.ПереводитьИменаФайловВТранслит = Истина;
	
	// Привилегированный режим требуется при получении печатной формы актуального документа для сравнения
	// с сохраненной в файле при открытии формы ЭД подписантом внутреннего документа, не имеющим прав на учетный документ
	УстановитьПривилегированныйРежим(Истина);
	
	РезультатПечати = УправлениеПечатью.НапечататьВФайл(КомандаПечати, ОбъектУчета, НастройкиСохранения);
	
	Если КомандаПечати.ДополнительныеПараметры.Свойство("СвойстваВнутреннегоЭД") Тогда
		ЗаполнитьЗначенияСвойств(Параметры, КомандаПечати.ДополнительныеПараметры.СвойстваВнутреннегоЭД);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РезультатПечати) Тогда
		Возврат РезультатПечати[0].ДвоичныеДанные;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ДвоичныеДанныеPDFУчетногоДокумента(Параметры) Экспорт
	
	Если Параметры.Свойство("АдресТабличногоДокумента") И ЗначениеЗаполнено(Параметры.АдресТабличногоДокумента) Тогда
		
		Если Параметры.Свойство("ИмяФайла") Тогда
		
			ИмяВременногоКаталога = ФайловаяСистема.СоздатьВременныйКаталог();
			
			ИмяФайла = СтроковыеФункции.СтрокаЛатиницей(Параметры.ИмяФайла);
			
			ПолноеИмяФайла = ФайловаяСистема.УникальноеИмяФайла(
				ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ИмяВременногоКаталога)
				+ ИмяФайла + ".pdf");
			
		Иначе
			
			ПолноеИмяФайла = ПолучитьИмяВременногоФайла("pdf");
			ИмяВременногоКаталога = ПолноеИмяФайла;
			
		КонецЕсли;
		
		ТабДок = ПолучитьИзВременногоХранилища(Параметры.АдресТабличногоДокумента);
		ТабДок.Записать(ПолноеИмяФайла, ТипФайлаТабличногоДокумента.PDF);
		
		//ИмяАрхива = ПолучитьИмяВременногоФайла("zip");
		//ЗаписьZipФайла = Новый ЗаписьZipФайла(ИмяАрхива);
		//ЗаписьZipФайла.Добавить(ПолноеИмяФайла);
		//ЗаписьZipФайла.Записать();
		//
		ДвоичныеДанные = Новый ДвоичныеДанные(ПолноеИмяФайла);
		
		ФайловаяСистема.УдалитьВременныйКаталог(ИмяВременногоКаталога);
		//ФайловаяСистема.УдалитьВременныйФайл(ИмяАрхива);
		
		Возврат ДвоичныеДанные;
		
	ИначеЕсли Параметры.Свойство("ИдентификаторДокумента") Тогда
		ИдентификаторДокумента = Параметры.ИдентификаторДокумента;
	Иначе
		ИдентификаторДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(Параметры.УчетныйДокумент));
	КонецЕсли;
	
	КомандыПечати = КомандыПечатиОбъекта(
		ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(ИдентификаторДокумента));
	
	КомандаПечати = КомандаПечатиПоИдентификатору(КомандыПечати, Параметры.ИдентификаторКомандыПечати);
	
	Если КомандаПечати = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	КомандаПечати = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(КомандаПечати);
	КомандаПечати.ДополнительныеПараметры.Вставить("ИсключитьШтампы");
	
	ОбъектУчета = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Параметры.УчетныйДокумент);
	
	НастройкиСохранения = УправлениеПечатью.НастройкиСохранения();
	НастройкиСохранения.ФорматыСохранения.Добавить(ТипФайлаТабличногоДокумента.PDF);
	НастройкиСохранения.УпаковатьВАрхив = Ложь;
	НастройкиСохранения.ПереводитьИменаФайловВТранслит = Истина;
	
	// Привилегированный режим требуется при получении печатной формы актуального документа для сравнения
	// с сохраненной в файле при открытии формы ЭД подписантом внутреннего документа, не имеющим прав на учетный документ
	УстановитьПривилегированныйРежим(Истина);
	
	РезультатПечати = УправлениеПечатью.НапечататьВФайл(КомандаПечати, ОбъектУчета, НастройкиСохранения);
	
	Если КомандаПечати.ДополнительныеПараметры.Свойство("СвойстваВнутреннегоЭД") Тогда
		ЗаполнитьЗначенияСвойств(Параметры, КомандаПечати.ДополнительныеПараметры.СвойстваВнутреннегоЭД);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РезультатПечати) Тогда
		Возврат РезультатПечати[0].ДвоичныеДанные;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ТабличныйДокументСтрокой(ТабличныйДокумент) Экспорт
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();
	
	СериализаторXDTO.ЗаписатьXML(ЗаписьXML, ТабличныйДокумент);
	
	Возврат ЗаписьXML.Закрыть();
	
КонецФункции

Процедура УдалитьСлужебныеТеги(ТабличныйДокументСериализованный) Экспорт
	
	Теги = Новый Массив;
	
	Теги.Добавить(Новый Структура("Имя, ЕстьАтрибуты", "printSettings", Ложь));
	Теги.Добавить(Новый Структура("Имя, ЕстьАтрибуты", "printSettingsName", Ложь));
	Теги.Добавить(Новый Структура("Имя, ЕстьАтрибуты", "namedItem", Истина));
	Теги.Добавить(Новый Структура("Имя, ЕстьАтрибуты", "columnsID", Ложь));
	Теги.Добавить(Новый Структура("Имя, ЕстьАтрибуты", "id", Ложь));
	Теги.Добавить(Новый Структура("Имя, ЕстьАтрибуты", "viewSettings", Ложь));
	Теги.Добавить(Новый Структура("Имя, ЕстьАтрибуты", "format", Ложь));
	
	Для Каждого Тег Из Теги Цикл
		
		ИмяТега = Тег.Имя;
		ЗакрывающийСимвол = ?(Тег.ЕстьАтрибуты, "", ">");
		
		ОткрывающийТег = "<"+ИмяТега+ЗакрывающийСимвол;
		ЗакрывающийТег = "</"+ИмяТега+">";
		
		ПозицияОкончание = СтрНайти(ТабличныйДокументСериализованный, ЗакрывающийТег);
		
		Пока ПозицияОкончание > 0 Цикл
			
			ПозицияНачало = СтрНайти(ТабличныйДокументСериализованный, ОткрывающийТег,
				НаправлениеПоиска.СКонца, ПозицияОкончание);
			
			Если ПозицияНачало > 0 Тогда
				ТабличныйДокументСериализованный = Лев(ТабличныйДокументСериализованный, ПозицияНачало - 1) +
					Сред(ТабличныйДокументСериализованный, ПозицияОкончание + СтрДлина(ИмяТега) + 5);
			КонецЕсли;
			
			ПозицияОкончание = СтрНайти(ТабличныйДокументСериализованный, ЗакрывающийТег);
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция СсылкаНаСертификатПоОтпечатку(Отпечаток) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Отпечаток", Отпечаток);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сертификаты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СертификатыКлючейЭлектроннойПодписиИШифрования КАК Сертификаты
	|ГДЕ
	|	Сертификаты.Отпечаток = &Отпечаток";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция УстановленныеПодписи(Объект) Экспорт
	
	УстановленныеПодписи = Новый Массив;
	
	Подписи = ЭлектроннаяПодпись.УстановленныеПодписи(Объект,, Истина);
	
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Подписи, УстановленныеПростыеПодписи(Объект));
	
	Для Каждого Подпись Из Подписи Цикл
		
		ОтпечатокСтруктура = Новый Структура(
			"ПорядковыйНомер, ДатаПодписи, УстановившийПодпись, ПростаяПодпись, ДатаПроверкиПодписи,
			|ИмяФайлаПодписи, КомуВыданСертификат, Отпечаток, Подпись, ПодписьВерна, Комментарий, ТребуетсяПроверка,
			|Сертификат, ВладелецПодписи, Должность, Организация, ТипПодписи, СрокДействияПоследнейМеткиВремени,
			|ИдентификаторПодписи, РезультатПроверкиПодписиПоМЧД, МашиночитаемаяДоверенность, МашиночитаемаяДоверенностьВерна");
		
		ЗаполнитьЗначенияСвойств(ОтпечатокСтруктура, Подпись);
		
		ОтпечатокСтруктура.Вставить("Объект", Объект);
		
		Если ОтпечатокСтруктура.ПростаяПодпись <> Истина Тогда
			ОтпечатокСтруктура.Сертификат = ОтпечатокСтруктура.Сертификат.Получить();
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ОтпечатокСтруктура.РезультатПроверкиПодписиПоМЧД) Тогда
			ОтпечатокСтруктура.МашиночитаемаяДоверенностьВерна = ОтпечатокСтруктура.РезультатПроверкиПодписиПоМЧД[0].Верна;
			ОтпечатокСтруктура.МашиночитаемаяДоверенность = ОтпечатокСтруктура.РезультатПроверкиПодписиПоМЧД[0].МашиночитаемаяДоверенность;
		КонецЕсли;	
		
		// Вставка в результирующий массив по возрастанию даты подписания
		Для Индекс = 0 По УстановленныеПодписи.ВГраница() Цикл
			Если Подпись.ДатаПодписи < УстановленныеПодписи[Индекс].ДатаПодписи Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		УстановленныеПодписи.Вставить(Индекс, ОтпечатокСтруктура);
		
	КонецЦикла;
	
	Возврат УстановленныеПодписи;
	
КонецФункции

Процедура ДобавитьШтампыЭлектронныхПодписей(ТабличныйДокумент, ЭлектронныеПодписиДляШтампа, Организация) Экспорт
	
	Если ЭлектронныеПодписиДляШтампа.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыШтампа = Новый Структура;
	ПараметрыШтампа.Вставить("ТекстОтметки", "");
	ПараметрыШтампа.Вставить("Логотип");
	
	Штампы = Новый Массив;
	Для Каждого Подпись Из ЭлектронныеПодписиДляШтампа Цикл
		
		МодульРаботаСФайламиПереопределяемый = ОбщегоНазначения.ОбщийМодуль("РаботаСФайламиПереопределяемый");
		
		Если Подпись.Свойство("ПростаяПодпись") И Подпись.ПростаяПодпись = Истина Тогда
			
			Если НЕ Подпись.Свойство("Организация") ИЛИ НЕ ЗначениеЗаполнено(Подпись.Организация) Тогда
				Подпись.Вставить("Организация", Организация);
			КонецЕсли;
			
			МодульРаботаСФайламиПереопределяемый.ПриПечатиФайлаСоШтампом(ПараметрыШтампа, Неопределено);
			
			Штамп = ШтампВизуализацииПростойЭлектроннойПодписи(Подпись, ПараметрыШтампа.ТекстОтметки, ПараметрыШтампа.Логотип);
			
		Иначе
			
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Не удалось получить сертификат усиленной электронной подписи для подписанта %1.
					|Штамп электронной подписи не может быть визуализирован.
					|Для дальнейшей работы с элекронным документом, проверьте наличие сертификата в локальном хранилище.'"),
					Подпись.УстановившийПодпись.Наименование);
			
			ДвоичныеДанныеСертификата = ?(Подпись.Свойство("АдресСертификата"),
											ПолучитьИзВременногоХранилища(Подпись.АдресСертификата), Неопределено); 
											
			Если Подпись.Свойство("Сертификат") И ЗначениеЗаполнено(Подпись.Сертификат) Тогда
				СертификатКриптографии = Новый СертификатКриптографии(Подпись.Сертификат);
			ИначеЕсли ЗначениеЗаполнено(ДвоичныеДанныеСертификата) Тогда
				СертификатКриптографии = Новый СертификатКриптографии(ДвоичныеДанныеСертификата);
			ИначеЕсли ЗначениеЗаполнено(Подпись.Отпечаток) Тогда
				СсылкаНаСертификат = СсылкаНаСертификатПоОтпечатку(Подпись.Отпечаток);
				Если ЗначениеЗаполнено(СсылкаНаСертификат) Тогда
					СертификатКриптографии = Новый СертификатКриптографии(СсылкаНаСертификат.ДанныеСертификата.Получить());
				Иначе
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
					Продолжить;
				КонецЕсли;
			Иначе
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
				Продолжить;
			КонецЕсли;

			ИдентификаторПодписи = Новый Массив;
			ИдентификаторПодписи.Добавить(Подпись.ИдентификаторПодписи);
			
			МодульРаботаСФайламиПереопределяемый.ПриПечатиФайлаСоШтампом(ПараметрыШтампа, СертификатКриптографии);
			
			СвойстваПодписи = ЭлектроннаяПодписьКлиентСервер.НовыеСвойстваПодписи();
            ЗаполнитьЗначенияСвойств(СвойстваПодписи, Подпись);
            СвойстваПодписи.Сертификат = СертификатКриптографии.Выгрузить();
            Если Подпись.Свойство("АдресПодписи") Тогда 
				СвойстваПодписи.Подпись = ПолучитьИзВременногоХранилища(Подпись.АдресПодписи);
			КонецЕсли;
            Если ЭтоАдресВременногоХранилища(СвойстваПодписи.РезультатПроверкиПодписиПоМЧД) Тогда
                СвойстваПодписи.РезультатПроверкиПодписиПоМЧД = ПолучитьИзВременногоХранилища(СвойстваПодписи.РезультатПроверкиПодписиПоМЧД);
            КонецЕсли;
			
			ОтображатьДатуПодписанияПоОрганизации = Истина;
			ВнутреннийЭДОПереопределяемый.ЗаполнитьНастройкуОтображатьДатуПодписанияПоОрганизации(Организация, ОтображатьДатуПодписанияПоОрганизации);
			Если Не (Константы.ОтображатьДатуПодписанияВШтампеВизуализацииПЭП.Получить() = Истина 
			    И ОтображатьДатуПодписанияПоОрганизации) Тогда
			    СвойстваПодписи.ДатаПодписи = Неопределено;
			    СвойстваПодписи.ДатаПодписиИзМетки = Неопределено;
			КонецЕсли;
			
            Штамп = ШтампВизуализацииЭлектроннойПодписи(СвойстваПодписи, Подпись.ДатаПодписи, 
				ПараметрыШтампа.ТекстОтметки, ПараметрыШтампа.Логотип, , Организация);

		КонецЕсли;
		
		Штампы.Добавить(Штамп);
		
	КонецЦикла;

	//Отступ чтобы штампы не накладывались на представление документа
	МакетШтампов = УправлениеПечатью.МакетПечатнойФормы("Документ.ВнутреннийЭлектронныйДокумент.ПФ_MXL_ШтампПЭП");
	ОбластьМакета = МакетШтампов.ПолучитьОбласть("Отступ");
	
	//Удаление горизонтального разделителя с конца табличного документа, если таковой имеется
	ТекущаяОбласть = ТабличныйДокумент.Область(ТабличныйДокумент.ВысотаТаблицы,,ТабличныйДокумент.ВысотаТаблицы,);
	ТекущаяОбласть.НачалоСтраницы = Ложь;
	ТекущаяОбласть.КонецСтраницы = Ложь;
	
	ТабличныйДокумент.Вывести(ОбластьМакета);
	
	ЭлектроннаяПодпись.ДобавитьШтампыВТабличныйДокумент(ТабличныйДокумент, Штампы);
	
КонецПроцедуры

Функция МЧДПодписи(ПодписанныйОбъект, ИдентификаторПодписи) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("НомерДоверенности", "");
	Результат.Вставить("МашиночитаемаяДоверенность", Неопределено);
	Результат.Вставить("Представление", "");
	Результат.Вставить("ДатаВыдачи", Дата(1,1,1));
	Результат.Вставить("ДатаОкончания", Дата(1,1,1));

	Если НЕ ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.МашиночитаемыеДоверенности") Тогда
		Возврат Результат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	МодульМашиночитаемыеДоверенностиФНССлужебный = ОбщегоНазначения.ОбщийМодуль("МашиночитаемыеДоверенностиФНССлужебный");
	ВыборкаМЧД = МодульМашиночитаемыеДоверенностиФНССлужебный.МЧДПодписей(ПодписанныйОбъект, ИдентификаторПодписи);
	НомерДоверенности = "";
	Если ЗначениеЗаполнено(ВыборкаМЧД) Тогда
		Если ВыборкаМЧД.Следующий() Тогда
			МашиночитаемаяДоверенность = ВыборкаМЧД.МашиночитаемаяДоверенность;
			Реквизиты = "НомерДоверенности, ДатаВыдачи, ДатаОкончания";
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(МашиночитаемаяДоверенность, Реквизиты);
			Если ЗначениеЗаполнено(МашиночитаемаяДоверенность) Тогда
				НомерДоверенности = ЗначенияРеквизитов.НомерДоверенности;
			КонецЕсли;	
			
			Результат.НомерДоверенности = НомерДоверенности;
			Результат.МашиночитаемаяДоверенность = МашиночитаемаяДоверенность;
			Результат.Представление = ВыборкаМЧД.Представление;
			Результат.ДатаВыдачи = ЗначенияРеквизитов.ДатаВыдачи;
			Результат.ДатаОкончания = ЗначенияРеквизитов.ДатаОкончания;
		КонецЕсли;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
КонецФункции

Функция ШтампВизуализацииЭлектроннойПодписи(СвойстваПодписи, ДатаПодписи = Неопределено, ТекстОтметки = "", ЛоготипОрганизации = Неопределено, СведенияМЧД = Неопределено, Организация = Неопределено) Экспорт
	
	СтандартнаяОбработка = Истина;
	
	ШтампВизуализацииЭлектроннойПодписи = Новый ТабличныйДокумент;
	
	Если СтандартнаяОбработка Тогда

		МодульЭлектроннаяПодпись = ОбщегоНазначения.ОбщийМодуль("ЭлектроннаяПодпись"); 
		ШтампВизуализацииЭлектроннойПодписи = МодульЭлектроннаяПодпись.ШтампВизуализацииЭлектроннойПодписи(
                СвойстваПодписи, ДатаПодписи,ТекстОтметки, ЛоготипОрганизации); 

		ОтображатьДатуПодписанияПоОрганизации = Истина;
		ВнутреннийЭДОПереопределяемый.ЗаполнитьНастройкуОтображатьДатуПодписанияПоОрганизации(Организация, ОтображатьДатуПодписанияПоОрганизации);
				
		Если Константы.ОтображатьДатуПодписанияВШтампеВизуализацииПЭП.Получить() = Истина 
			И ОтображатьДатуПодписанияПоОрганизации Тогда
			ШтампВизуализацииЭлектроннойПодписи.Область(3,3,3,3).Заполнение = ТипЗаполненияОбластиТабличногоДокумента.Параметр;
			ШтампВизуализацииЭлектроннойПодписи.Область(3,3,3,3).Параметр = "ДатаПодписи";
			ШтампВизуализацииЭлектроннойПодписи.Область(3,3,3,3).ВертикальноеПоложение = ВертикальноеПоложение.Верх;
			ШтампВизуализацииЭлектроннойПодписи.Параметры.ДатаПодписи = ДатаПодписи;
		КонецЕсли;
				
		ШтампВизуализацииЭлектроннойПодписи.Области.Штамп.ЦветРамки  =  Новый Цвет(0, 0, 0);
		ШтампВизуализацииЭлектроннойПодписи.Области.Штамп.ЦветТекста = ЦветаСтиля.ЦветТекстаПоля.ПолучитьАбсолютный();
		
	КонецЕсли;
	
	Возврат ШтампВизуализацииЭлектроннойПодписи;
	
КонецФункции

// Заполняет сведения о физическом лице по переданному пользователю и перечню подписываемых объектов
// для заполнения свойств простой электронной подписи по каждому объекту.
// Данные пользователя по подписываемым объектам, где Ключ - подписываемый документ (уже заполнен)
//
// Параметры:
//  Пользователь - СправочникСсылка.Пользователи - пользователь ИБ.
//  Сведения - Структура - данные пользователя:
//   * ПолноеИмя - Строка - полное имя физического лица пользователя, например "Иванов Иван Иванович".
//   * ОрганизацииИДолжности - Соответствие из Структура:
//       ** Организация - ОпределяемыйТип.Организация - организация пользователя.
//       ** Должность - Строка - занимаемая в организации должность.
//
Процедура ЗаполнитьСведенияОПользователе(Знач Пользователь, Сведения) Экспорт
	
	ВнутреннийЭДОПереопределяемый.ЗаполнитьСведенияОПользователе(Пользователь, Сведения);
	
КонецПроцедуры

// см. УправлениеПечатьюПереопределяемый.ПечатьДокументовПриСозданииНаСервере
Процедура ПечатьДокументовПриСозданииНаСервере(Форма, Отказ, СтандартнаяОбработка) Экспорт
	
	Если НЕ ВнутреннийЭДОПереопределяемый.ИспользуютсяВнутренниеДокументы() Тогда
		Возврат
	КонецЕсли;
	
	Если НЕ ПравоДоступа("Просмотр", Метаданные.РегистрыСведений.СостоянияУчетныхДокументов) Тогда
		Возврат;
	КонецЕсли;
	
	ОбъектыУчета = Форма.Параметры.ПараметрКоманды;
	
	Если Не ЗначениеЗаполнено(ОбъектыУчета) Тогда 
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ОбъектыУчета) <> Тип("Массив") Тогда
		ОбъектыУчета = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ОбъектыУчета);
	КонецЕсли;
	
	ОбъектУчета = ОбъектыУчета[0];
	
	Если ДокументОбрабатываетсяВнутреннимЭДОБЭД(ОбъектУчета) Тогда
		Возврат;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "ЭмблемаСервиса1СЭДОПодписаниеКартинка", "Видимость", Ложь);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "ПредставлениеПрогрессаПодписанияДекорация", "Видимость", Ложь);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "ОтправитьНаПодписьКнопкаФормы", "Видимость", Ложь);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "ГруппаДополнительнаяИнформация", "Видимость", Ложь);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "ДополнительнаяИнформация", "Видимость", Ложь);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "КартинкаИнформации", "Видимость", Ложь);
	
	ТипыДокументовВнутреннегоЭДО = Новый ОписаниеТипов(ВнутреннийЭДОПовтИсп.ТипыУчетныхДокументовВнутреннегоЭДО());
	Если НЕ ТипыДокументовВнутреннегоЭДО.СодержитТип(ТипЗнч(ОбъектУчета)) Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Форма.Параметры.ПараметрыИсточника) Тогда
		ИдентификаторКомандыПечати = Форма.Параметры.ПараметрыИсточника.ИдентификаторКоманды;
	ИначеЕсли Форма.Параметры.ПараметрыПечати.Свойство("Идентификатор") Тогда
		ИдентификаторКомандыПечати = Форма.Параметры.ПараметрыПечати.Идентификатор;
	Иначе
		ИдентификаторКомандыПечати = Форма.Параметры.ИменаМакетов;
		// Сохранение идентификатора печатной формы для последующего получения при нажатии на гиперссылку с состоянием ЭДО
		Форма.Параметры.ПараметрыПечати.Вставить("Идентификатор", ИдентификаторКомандыПечати);
	КонецЕсли;
	
	ЭлектронныйДокумент = АктуальныйЭлектронныйДокумент(ОбъектУчета, ИдентификаторКомандыПечати);
	
	// Если для данной печатной формы нет настройки внутреннего ЭДО - гиперссылка не выводится
	Если ЭлектронныйДокумент = Неопределено Тогда
		
		Если НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ОбъектУчета, "Организация") Тогда
			Возврат;
		КонецЕсли;
		
		//@skip-check wrong-string-literal-content
		Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбъектУчета, "Организация");
		
		Если НЕ ДляПечатнойФормыВыполненаНастройкаВнутреннегоЭДО(
			Организация, ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(ОбъектУчета)), ИдентификаторКомандыПечати) Тогда
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	Состояние = СостояниеЭлектронногоДокумента(ЭлектронныйДокумент);
	
	ГруппаЭлементовВнутреннегоЭДО = Форма.Элементы.Вставить(
		"ГруппаЭлементовВнутреннегоЭДОБГУ", 
		Тип("ГруппаФормы"), Форма.Элементы.ГруппаКоманднаяПанель, 
		Форма.Элементы.КоманднаяПанельЛеваяЧасть);
		
	ГруппаЭлементовВнутреннегоЭДО.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаЭлементовВнутреннегоЭДО.РастягиватьПоВертикали = Ложь;
	ГруппаЭлементовВнутреннегоЭДО.РастягиватьПоГоризонтали = Ложь;
	ГруппаЭлементовВнутреннегоЭДО.ОтображатьЗаголовок = Ложь;
	ГруппаЭлементовВнутреннегоЭДО.Отображение = ОтображениеОбычнойГруппы.Нет;
	
	ЭмблемаСервиса1СЭДОКартинкаПодписание = Форма.Элементы.Добавить(
		"ЭмблемаВнутреннегоЭДОБГУ",
		Тип("ДекорацияФормы"),
		ГруппаЭлементовВнутреннегоЭДО);
	
	ЭмблемаСервиса1СЭДОКартинкаПодписание.Вид = ВидДекорацииФормы.Картинка;
	ЭмблемаСервиса1СЭДОКартинкаПодписание.Картинка = БиблиотекаКартинок.Оригинал;
	
	ПредставлениеПрогрессаПодписанияДекорация = Форма.Элементы.Добавить(
		"ПредставлениеПрогрессаПодписанияДекорацияБГУ",
		Тип("ДекорацияФормы"),
		ГруппаЭлементовВнутреннегоЭДО);
	
	ПредставлениеПрогрессаПодписанияДекорация.Вид = ВидДекорацииФормы.Надпись;
	ПредставлениеПрогрессаПодписанияДекорация.РастягиватьПоГоризонтали = Истина;
	ПредставлениеПрогрессаПодписанияДекорация.АвтоМаксимальнаяШирина = Ложь;
	ПредставлениеПрогрессаПодписанияДекорация.Заголовок =
		Новый ФорматированнаяСтрока(Состояние.ПредставлениеСостояния,,,, "ВнутреннийЭДОБГУПрогрессПодписания");
	ПредставлениеПрогрессаПодписанияДекорация.УстановитьДействие("ОбработкаНавигационнойСсылки", "Подключаемый_ОбработкаНавигационнойСсылки");
	
КонецПроцедуры

// см. УправлениеПечатьюПереопределяемый.ПриПечати
Процедура ПриПечати(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если НЕ ВнутреннийЭДОПереопределяемый.ИспользуютсяВнутренниеДокументы()
		ИЛИ ПараметрыПечати.Свойство("ИсключитьШтампы") Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ПравоДоступа("Просмотр", Метаданные.РегистрыСведений.СостоянияУчетныхДокументов) Тогда
		Возврат;
	КонецЕсли;
	
	Если ОбщегоНазначения.ЗначениеСсылочногоТипа(МассивОбъектов) Тогда
		МассивОбъектовДляПечати = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(МассивОбъектов);
	ИначеЕсли МассивОбъектов.Количество() = 1 Тогда
		МассивОбъектовДляПечати = ОбщегоНазначения.СкопироватьРекурсивно(МассивОбъектов);
	ИначеЕсли ОбъектыПечати.Количество() = 0 Тогда
		Возврат;
	Иначе
		МассивОбъектовДляПечати = ОбщегоНазначения.СкопироватьРекурсивно(МассивОбъектов);
	КонецЕсли;
	
	Если МассивОбъектовДляПечати.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// МассивОбъектов необходимо упорядочить в соответствии со списком ОбъектыПечати
	Если МассивОбъектовДляПечати.Количество() = ОбъектыПечати.Количество() Тогда
		МассивОбъектовДляПечати = Новый Массив;
		Для Каждого ОбъектПечати Из ОбъектыПечати Цикл
			МассивОбъектовДляПечати.Добавить(ОбъектПечати.Значение);
		КонецЦикла;
	КонецЕсли;
	
	ТипыДокументовВнутреннегоЭДО = Новый ОписаниеТипов(ВнутреннийЭДОПовтИсп.ТипыУчетныхДокументовВнутреннегоЭДО());
	
	//Если в пачке нет документов внутреннего ЭДО БГУ, то штампы не выводятся
	ЕстьДокументыВнутреннегоЭДОБГУ = Ложь;
	Для Каждого Ссылка Из МассивОбъектовДляПечати Цикл
		Если ТипыДокументовВнутреннегоЭДО.СодержитТип(ТипЗнч(Ссылка)) Тогда
			ЕстьДокументыВнутреннегоЭДОБГУ = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если НЕ ЕстьДокументыВнутреннегоЭДОБГУ Тогда
		Возврат;
	КонецЕсли;
	
	//Если в пачке есть документы БЭД, то штампы не выводятся
	Для Каждого Ссылка Из МассивОбъектовДляПечати Цикл
		Если ДокументОбрабатываетсяВнутреннимЭДОБЭД(Ссылка) Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ПечатнаяФорма Из КоллекцияПечатныхФорм Цикл
		
		ВывестиРазделительПослеДокумента = Ложь;
		
		ИсходныйТабличныйДокумент = ПечатнаяФорма.ТабличныйДокумент;
		
		Если ИсходныйТабличныйДокумент.ВысотаТаблицы = 0 Тогда
			// к пустому документу штампы не добавляются
			Продолжить;
		КонецЕсли;
		
		ИдентификаторКомандыПечати = ПечатнаяФорма.ИмяМакета;
		
		ТабличныйДокументСоШтампами = Новый ТабличныйДокумент;
		ЗаполнитьЗначенияСвойств(ТабличныйДокументСоШтампами, ИсходныйТабличныйДокумент);
		
		Для Каждого Ссылка Из МассивОбъектовДляПечати Цикл
			
			ИмяОбласти = "";
			
			Если ОбъектыПечати.Количество() = 0 Тогда
				ОбластьДокумент = ИсходныйТабличныйДокумент;
			ИначеЕсли МассивОбъектовДляПечати.Количество() = 1 Тогда
				// передан только один объект для печати
				// штамп будет выведен в конец исходного табличного документа
				ОбластьДокумент = ИсходныйТабличныйДокумент;
			Иначе
				ДокументОбласть = ОбъектыПечати.НайтиПоЗначению(Ссылка);
				Если ДокументОбласть = Неопределено Тогда
					// не удалось найти имя области для объекта печати;
					// штамп будет выведен в конец исходного табличного документа
					ОбластьДокумент = ИсходныйТабличныйДокумент;
				Иначе
					ИмяОбласти = ДокументОбласть.Представление;
					Если ИсходныйТабличныйДокумент.Области.Найти(ИмяОбласти) = Неопределено Тогда
						// в табличном документе нет области, соответствующей объекту печати;
						// штамп объекта не выводится
						ТабличныйДокументСоШтампами.Присоединить(ИсходныйТабличныйДокумент);
						Продолжить;
					Иначе
						ОбластьДокумент = ИсходныйТабличныйДокумент.ПолучитьОбласть(ИмяОбласти);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			Если ТабличныйДокументСоШтампами.ВысотаТаблицы > 0 И ВывестиРазделительПослеДокумента Тогда
				ТабличныйДокументСоШтампами.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;
			
			ВывестиРазделительПослеДокумента = ОбластьДокумент.Область(
				ОбластьДокумент.ВысотаТаблицы,, ОбластьДокумент.ВысотаТаблицы).КонецСтраницы;
			
			НомерСтрокиНачало = ТабличныйДокументСоШтампами.ВысотаТаблицы + 1;
			
			ТабличныйДокументСоШтампами.Присоединить(ОбластьДокумент);
			
			НомерСтрокиКонец = ТабличныйДокументСоШтампами.ВысотаТаблицы;
			
			ТабличныйДокументСоШтампами.Область(ТабличныйДокументСоШтампами.ВысотаТаблицы, , ТабличныйДокументСоШтампами.ВысотаТаблицы).КонецСтраницы = Ложь;
			
			// Если документ не относится к внутреннему ЭДО БГУ, то штамп не выводится
			Если НЕ ТипыДокументовВнутреннегоЭДО.СодержитТип(ТипЗнч(Ссылка)) Тогда
				Продолжить;
			КонецЕсли;
			
			ЭлектронныйДокумент = АктуальныйЭлектронныйДокумент(Ссылка, ИдентификаторКомандыПечати);
			
			Если Не ЗначениеЗаполнено(ЭлектронныйДокумент) Тогда
				Продолжить;
			КонецЕсли;
			
			РеквизитыЭлектронногоДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
				ЭлектронныйДокумент, "ОсновнойФайл, Организация");
			
			ЭлектронныеПодписи = УстановленныеПодписи(РеквизитыЭлектронногоДокумента.ОсновнойФайл);
			
			Если ЭлектронныеПодписи.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ДвоичныеДанныеСохраненногоДокумента = РаботаСФайлами.ДвоичныеДанныеФайла(
				РеквизитыЭлектронногоДокумента.ОсновнойФайл, Ложь);
			
			Если ДвоичныеДанныеСохраненногоДокумента = Неопределено Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Штампы визуализации электронной подписи для документа %1 не выведены,
					|так как не удалось получить данные подписанного электронного документа'"),
					Ссылка);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
				Продолжить;
			КонецЕсли;
			
			ТабличныйДокументСохраненногоДокумента = ТабличныйДокументИзДвоичныхДанныхАрхива(ДвоичныеДанныеСохраненногоДокумента);
			
			ПараметрыПечатиВФайл = Новый Структура("УчетныйДокумент, ИдентификаторКомандыПечати", Ссылка, ИдентификаторКомандыПечати);
			ТабличныйДокументАктуальногоДокумента = ТабличныйДокументИзДвоичныхДанныхАрхива(
				ДвоичныеДанныеУчетногоДокумента(ПараметрыПечатиВФайл));
				
			Если НЕ НеПроверятьАктуальностьДокумента(ТабличныйДокументСохраненногоДокумента, ТабличныйДокументАктуальногоДокумента) Тогда	
				Если НЕ ТабличныеДокументыИдентичны(ТабличныйДокументСохраненногоДокумента, ТабличныйДокументАктуальногоДокумента) Тогда
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'Штампы визуализации электронной подписи для документа %1 не выведены,
						|так как данные печатной формы отличаются от данных подписанного электронного документа'"),
						Ссылка);
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			ДобавитьШтампыЭлектронныхПодписей(ТабличныйДокументСоШтампами, ЭлектронныеПодписи, РеквизитыЭлектронногоДокумента.Организация);
			
			Если НЕ ПустаяСтрока(ИмяОбласти) Тогда
				ТабличныйДокументСоШтампами.Область(НомерСтрокиНачало, , НомерСтрокиКонец).Имя = "";
				ТабличныйДокументСоШтампами.Область(НомерСтрокиНачало, , ТабличныйДокументСоШтампами.ВысотаТаблицы).Имя = ИмяОбласти;
			КонецЕсли;
			
		КонецЦикла;
		
		ПечатнаяФорма.ТабличныйДокумент = ТабличныйДокументСоШтампами;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ШаблонПоложенияОбИспользованииПЭП(Параметры) Экспорт
	
	ПечатныеФормы = Новый Соответствие;
	
	Макет = УправлениеПечатью.МакетПечатнойФормы(
		СтрШаблон("Обработка.НастройкиВнутреннегоЭДОБГУ.ПФ_MXL_ШаблонПоложенияОбИспользованииПЭП_%1", 
			ОбщегоНазначения.КодОсновногоЯзыка()));
	
	МакетУведомления = УправлениеПечатью.МакетПечатнойФормы(
		СтрШаблон("Обработка.НастройкиВнутреннегоЭДОБГУ.ПФ_MXL_ШаблонУведомленияОбИспользованииПЭП_%1", 
			ОбщегоНазначения.КодОсновногоЯзыка()));
	
	Попытка
		
		ТабличныйДокумент = Новый ТабличныйДокумент;
		Область = Макет.ПолучитьОбласть("Приказ");
		ЗаполнитьЗначенияСвойств(Область.Параметры, Параметры);
		ТабличныйДокумент.Вывести(Область);	
		ПечатныеФормы.Вставить("Приказ", ТабличныйДокумент);
		
		ТабличныйДокумент = Новый ТабличныйДокумент;
		Область = Макет.ПолучитьОбласть("ПриложениеКПриказу");
		ЗаполнитьЗначенияСвойств(Область.Параметры, Параметры);
		ТабличныйДокумент.Вывести(Область);	
		ПечатныеФормы.Вставить("ПриложениеКПриказу", ТабличныйДокумент);
		
		ТабличныйДокумент = Новый ТабличныйДокумент;
		Область = Макет.ПолучитьОбласть("Приложение1");
		ЗаполнитьЗначенияСвойств(Область.Параметры, Параметры);
		ТабличныйДокумент.Вывести(Область);
		ПечатныеФормы.Вставить("Приложение1", ТабличныйДокумент);

		ТабличныйДокумент = Новый ТабличныйДокумент;
		Область = МакетУведомления.ПолучитьОбласть("Уведомление");
		
		ЗначенияПараметров = Новый Структура;
		ЗначенияПараметров.Вставить("ФИОСотрудника", НСтр("ru = 'Ф.И.О. сотрудника'"));
		ЗначенияПараметров.Вставить("НаименованиеОрганизации", Параметры.НаименованиеОрганизации);
		ЗначенияПараметров.Вставить("ДатаВступленияВСилу", Параметры.ДатаВступленияВСилу);
		
		ЗаполнитьЗначенияСвойств(Область.Параметры, ЗначенияПараметров); 
		ТабличныйДокумент.Вывести(Область);
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		ПечатныеФормы.Вставить("Приложение2", ТабличныйДокумент);

	Исключение
		ТекстОшибки = НСтр("ru = 'Не удалось заполнить значения параметров шаблона положения об использовании простой ЭП причине:'")
			+ Символы.ПС
			+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;
	
	Возврат ПечатныеФормы;
	
КонецФункции

Функция ШаблонУведомленияОбИспользованииПЭП(Организация, СписокПользователей) Экспорт
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	Макет = УправлениеПечатью.МакетПечатнойФормы(
		СтрШаблон("Обработка.НастройкиВнутреннегоЭДОБГУ.ПФ_MXL_ШаблонУведомленияОбИспользованииПЭП_%1", 
			ОбщегоНазначения.КодОсновногоЯзыка()));
	
	ДанныеОрганизации = Новый Структура;
	ВнутреннийЭДОПереопределяемый.ЗаполнитьРегистрационныеДанныеОрганизации(Организация, ДанныеОрганизации);
	
	ДанныеОрганизацииПараметры = ЗначенияПараметровШаблонаПоложенияОбИспользованииПЭП(ДанныеОрганизации);
	
	Попытка
		Область = Макет.ПолучитьОбласть("Уведомление");
		
		ДатаВступленияВСилу = Формат(ТекущаяДатаСеанса(), "ДЛФ=D");
		
		Для Каждого Пользователь Из СписокПользователей Цикл
			
			Если Не ЗначениеЗаполнено(Пользователь) Тогда
				Продолжить;
			КонецЕсли;
			
			ДанныеСотрудника = ВнутреннийЭДОПереопределяемый.СведенияФизЛицаПользователя(Пользователь, Организация);
			
			ЗначенияПараметров = Новый Структура;
			ЗначенияПараметров.Вставить("ФИОСотрудника", ФизическиеЛицаКлиентСервер.ФамилияИнициалы(
				ДанныеСотрудника.ИмяПолное));
			ЗначенияПараметров.Вставить("НаименованиеОрганизации", ДанныеОрганизацииПараметры.НаименованиеОрганизации);
			ЗначенияПараметров.Вставить("ДатаВступленияВСилу", ДатаВступленияВСилу);
			
			ЗаполнитьЗначенияСвойств(Область.Параметры, ЗначенияПараметров);
			
			ТабличныйДокумент.Вывести(Область);
			
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			
		КонецЦикла;
		
	Исключение
		ТекстОшибки = НСтр("ru = 'Не удалось заполнить значения параметров шаблона положения об использовании простой ЭП причине:'")
			+ Символы.ПС
			+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;

	Возврат ТабличныйДокумент;
	
КонецФункции

Функция СформироватьПечатныеФормыЭлектронныхДокументов(ЭлектронныеДокументы) Экспорт
	
	ПечатныеФормы = Новый Массив;
	
	ДанныеДокументов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(ЭлектронныеДокументы, "Организация, ОсновнойФайл");
	
	Для Каждого ЭлектронныйДокумент Из ЭлектронныеДокументы Цикл
		
		ДанныеДокумента = ДанныеДокументов[ЭлектронныйДокумент];
		
		ОсновнойФайл = ДанныеДокумента["ОсновнойФайл"];
		
		ДвоичныеДанные = РаботаСФайлами.ДвоичныеДанныеФайла(ОсновнойФайл);
		
		ТабличныйДокумент = ТабличныйДокументИзДвоичныхДанныхАрхива(ДвоичныеДанные);
		
		ЭлектронныеПодписи = УстановленныеПодписи(ОсновнойФайл);
		
		ДобавитьШтампыЭлектронныхПодписей(ТабличныйДокумент, ЭлектронныеПодписи, ДанныеДокумента["Организация"]);
		
		ПечатнаяФорма = Новый Структура;
		ПечатнаяФорма.Вставить("ИмяМакета", "ЭлектронныйДокумент" + Строка(Новый УникальныйИдентификатор()));
		ПечатнаяФорма.Вставить("СинонимМакета", Строка(ЭлектронныйДокумент) + НСтр("ru = ' (Электронный документ)'"));
		ПечатнаяФорма.Вставить("ТабличныйДокумент", ТабличныйДокумент);
		ПечатнаяФорма.Вставить("Ссылка", ЭлектронныйДокумент);
		
		ПечатныеФормы.Добавить(ПечатнаяФорма);
		
	КонецЦикла;
	
	Возврат ПечатныеФормы;
	
КонецФункции

Функция СформироватьРеестрЭлектронныхДокументов(ЭлектронныеДокументы) Экспорт
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_РеестрВнутреннихЭлектронныхДокументов";
	
	ОтображатьДатуПроведения = ВнутреннийЭДОПереопределяемый.ИспользоватьОтдельнуюДатуПроведенияДокументов();
	
	ИмяМакета = "ПФ_MXL_РеестрВнутреннихЭлектронныхДокументов";
	Если ОтображатьДатуПроведения Тогда
		ИмяМакета = "ПФ_MXL_РеестрВнутреннихЭлектронныхДокументовСДатойПроведения";	
	КонецЕсли;
	Макет = Документы.ВнутреннийЭлектронныйДокумент.ПолучитьМакет(ИмяМакета);
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.ДатаСоставления = Формат(ТекущаяДатаСеанса(), "ДЛФ=DT");
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	Если ОтображатьДатуПроведения Тогда
		ДанныеДокументов = ПолучитьДанныеЭлектронныхДокументов(ЭлектронныеДокументы);
    Иначе
		ДанныеДокументов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(ЭлектронныеДокументы,
			"Организация, ВидДокумента, ДатаДокумента, НомерДокумента");
	КонецЕсли;
	
	НомерСтроки = 1;
	
	Для Каждого ЭлектронныйДокумент Из ЭлектронныеДокументы Цикл
		
		ДанныеДокумента = ДанныеДокументов[ЭлектронныйДокумент];
		
		ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
		
		ОбластьСтрока.Параметры.НомерСтроки = НомерСтроки;
		ОбластьСтрока.Параметры.ДатаДокумента = ДанныеДокумента.ДатаДокумента;
		Если ОтображатьДатуПроведения Тогда
			ОбластьСтрока.Параметры.ДатаПроведения = Формат(ДанныеДокумента.ДатаПроведения,"ДФ=dd.MM.yyyy"); 
		КонецЕсли;
		ОбластьСтрока.Параметры.НомерДокумента = ДанныеДокумента.НомерДокумента;
		ОбластьСтрока.Параметры.ВидДокумента = ДанныеДокумента.ВидДокумента;
		ОбластьСтрока.Параметры.Организация = ДанныеДокумента.Организация;
		
		ТабличныйДокумент.Вывести(ОбластьСтрока);
		
		НомерСтроки = НомерСтроки + 1;
		
	КонецЦикла;
	
	//ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	//ТабличныйДокумент.Вывести(ОбластьПодвал);
	
	ПечатнаяФорма = Новый Структура;
	ПечатнаяФорма.Вставить("ИмяМакета", "РеестрЭлектронныхДокументов");
	ПечатнаяФорма.Вставить("СинонимМакета", НСтр("ru = 'Реестр электронных документов'"));
	ПечатнаяФорма.Вставить("ТабличныйДокумент", ТабличныйДокумент);
	
	Возврат ПечатнаяФорма;
	
КонецФункции

Процедура ПроверитьВозможностьИспользованияПростойПодписи(ОписаниеДанных, Отказ, ОписаниеОшибки) Экспорт
	
	Пользователь = Пользователи.ТекущийПользователь();
	ДатаПроверки = ТекущаяДатаСеанса();
	
	УникальныеОрганизации = Новый Соответствие;
	
	Для Каждого Данные Из ОписаниеДанных Цикл
		Если Данные.ВидПодписи = ПредопределенноеЗначение("Перечисление.ВидыЭлектронныхПодписейБГУ.Простая") Тогда
			УникальныеОрганизации.Вставить(Данные.СвойстваПодписи.Организация);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Организация Из УникальныеОрганизации Цикл
		
		Если Не ПроверятьНаличиеКлючаПЭПВРеестре(Организация.Ключ) Тогда
			Продолжить;
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	РеестрКлючейПростыхЭлектронныхПодписейСрезПоследних.Пользователь КАК Пользователь,
		|	РеестрКлючейПростыхЭлектронныхПодписейСрезПоследних.ДатаОтзыва КАК ДатаОтзыва
		|ИЗ
		|	РегистрСведений.РеестрКлючейПростыхЭлектронныхПодписей.СрезПоследних(
		|			&ДатаПроверки,
		|			Организация = &Организация
		|				И Пользователь = &Пользователь) КАК РеестрКлючейПростыхЭлектронныхПодписейСрезПоследних
		|ГДЕ
		|	(РеестрКлючейПростыхЭлектронныхПодписейСрезПоследних.ДатаОтзыва = ДАТАВРЕМЯ(1, 1, 1)
		|			ИЛИ КОНЕЦПЕРИОДА(РеестрКлючейПростыхЭлектронныхПодписейСрезПоследних.ДатаОтзыва, ДЕНЬ) >= &ДатаПроверки)";
		
		Запрос.УстановитьПараметр("ДатаПроверки", ДатаПроверки);
		Запрос.УстановитьПараметр("Организация", Организация.Ключ);
		Запрос.УстановитьПараметр("Пользователь", Пользователь);
		
		УстановитьПривилегированныйРежим(Истина);
		Отказ = Запрос.Выполнить().Пустой();
		УстановитьПривилегированныйРежим(Ложь);
		
		Если Отказ Тогда
			ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='Подписание не выполнено. Ключ простой электронной подписи пользователя отсутствует в реестре выданных ключей на %1'"),
				Формат(ДатаПроверки, "ДЛФ=D"));
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ТабличныйДокументИзДвоичныхДанныхФайла(ДвоичныеДанные) Экспорт
	
	ТабДок = Новый ТабличныйДокумент;
	
	Если ДвоичныеДанные = Неопределено Тогда
		Возврат ТабДок;
	КонецЕсли;
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("mxl");
	
	ДвоичныеДанные.Записать(ИмяВременногоФайла);
	
	ТабДок.Прочитать(ИмяВременногоФайла);
	
	Попытка
		УдалитьФайлы(ИмяВременногоФайла);
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Удаление временного mxl файла'"), УровеньЖурналаРегистрации.Ошибка,,, 
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
	КонецПопытки;
	
	Возврат ТабДок;
	
КонецФункции

Функция ПараметрыУчетногоДокумента(УчетныйДокумент) Экспорт
	
	ИдентификаторДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(УчетныйДокумент));
	
	МетаданныеОбъекта = УчетныйДокумент.Метаданные();
	
	СтандартнаяОбработка = Истина;
	
	РеквизитыУчетногоДокумента = Новый Структура;
	РеквизитыУчетногоДокумента.Вставить("Номер", "");
	РеквизитыУчетногоДокумента.Вставить("Дата", "");
	РеквизитыУчетногоДокумента.Вставить("Организация", Справочники.Организации.ПустаяСсылка());
	ВнутреннийЭДОПереопределяемый.ПриЗаполненииРеквизитовУчетногоДокумента(
		УчетныйДокумент, РеквизитыУчетногоДокумента, СтандартнаяОбработка);
	
	Если НЕ СтандартнаяОбработка Тогда
		НомерДокумента = РеквизитыУчетногоДокумента.Номер;
		ДатаДокумента = РеквизитыУчетногоДокумента.Дата;
		Организация = РеквизитыУчетногоДокумента.Организация;
	ИначеЕсли МетаданныеОбъекта.Нумератор = Неопределено И МетаданныеОбъекта.ДлинаНомера = 0 Тогда
		РеквизитыУчетногоДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			УчетныйДокумент, "Организация, Дата");
		НомерДокумента = "";
		ДатаДокумента = РеквизитыУчетногоДокумента.Дата;
		Организация = РеквизитыУчетногоДокумента.Организация;
	Иначе
		РеквизитыУчетногоДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			УчетныйДокумент, "Организация, Номер, Дата");
		НомерДокумента = РеквизитыУчетногоДокумента.Номер;
		ДатаДокумента = РеквизитыУчетногоДокумента.Дата;
		Организация = РеквизитыУчетногоДокумента.Организация;
	КонецЕсли;
	
	Результат = Новый Структура;
	Результат.Вставить("НомерДокумента", НомерДокумента);
	Результат.Вставить("ДатаДокумента", ДатаДокумента);
	Результат.Вставить("Организация", Организация);
	Результат.Вставить("ИдентификаторДокумента", ИдентификаторДокумента);
	
	Возврат Результат;
	
КонецФункции

Процедура ПриЗаполненииВидовОграниченийПравОбъектовМетаданных(Описание) Экспорт
	
	Описание = Описание + "
		|Документ.ВнутреннийЭлектронныйДокумент.Чтение.Организации
		|Документ.ВнутреннийЭлектронныйДокумент.Изменение.Организации
		|РегистрСведений.НастройкиВнутреннегоЭДОБГУ.Чтение.Организации
		|РегистрСведений.НастройкиВнутреннегоЭДОБГУ.Изменение.Организации
		|РегистрСведений.РеестрКлючейПростыхЭлектронныхПодписей.Чтение.Организации
		|РегистрСведений.РеестрКлючейПростыхЭлектронныхПодписей.Изменение.Организации
		|РегистрСведений.СостоянияЭлектронныхДокументов.Чтение.Организации
		|РегистрСведений.СостоянияЭлектронныхДокументов.Изменение.Организации
		|";
	
КонецПроцедуры

Процедура ПриЗаполненииСписковСОграничениемДоступа(Списки) Экспорт
	
	Списки.Вставить(Метаданные.Документы.ВнутреннийЭлектронныйДокумент, Истина);
	Списки.Вставить(Метаданные.РегистрыСведений.НастройкиВнутреннегоЭДОБГУ, Истина);
	Списки.Вставить(Метаданные.РегистрыСведений.РеестрКлючейПростыхЭлектронныхПодписей, Истина);
	Списки.Вставить(Метаданные.РегистрыСведений.СостоянияЭлектронныхДокументов, Истина); 
	
КонецПроцедуры

Функция НеПроверятьАктуальностьДокумента(СохраненныйДокумент, АктуальныйДокумент) Экспорт
	Результат = Ложь;
	
	Если СохраненныйДокумент.ВысотаТаблицы > 4000 Тогда	
		Результат = Истина;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

Функция ПолучитьДанныеЭлектронныхДокументов(ЭлектронныеДокументы)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ВнутреннийЭлектронныйДокумент.ДатаДокумента КАК ДатаДокумента,
	               |	ЖурналПроводокЕПСБУ.Период КАК ДатаПроведения,
	               |	ВнутреннийЭлектронныйДокумент.НомерДокумента КАК НомерДокумента,
	               |	ВнутреннийЭлектронныйДокумент.ВидДокумента КАК ВидДокумента,
	               |	ВнутреннийЭлектронныйДокумент.Организация КАК Организация,
	               |	ВнутреннийЭлектронныйДокумент.Ссылка КАК ЭлектронныйДокумент
	               |ИЗ
	               |	Документ.ВнутреннийЭлектронныйДокумент КАК ВнутреннийЭлектронныйДокумент
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ЖурналПроводокЕПСБУ
	               |		ПО (ВЫБОР
	               |				КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУ.Регистратор) = ТИПЗНАЧЕНИЯ(ВнутреннийЭлектронныйДокумент.УчетныйДокумент)
	               |					ТОГДА ЖурналПроводокЕПСБУ.Регистратор = ВнутреннийЭлектронныйДокумент.УчетныйДокумент
	               |				ИНАЧЕ ЛОЖЬ
	               |			КОНЕЦ)
	               |ГДЕ
	               |	ВнутреннийЭлектронныйДокумент.Ссылка В(&ЭлектронныеДокументы)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЭлектронныйДокумент";
	
	Запрос.УстановитьПараметр("ЭлектронныеДокументы", ЭлектронныеДокументы);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ДанныеДокументов = Новый Соответствие;
	
	Пока Выборка.Следующий() Цикл
		
		ДанныеДокумента = Новый Структура;
		ДанныеДокумента.Вставить("ДатаДокумента");
		ДанныеДокумента.Вставить("ДатаПроведения");
	    ДанныеДокумента.Вставить("НомерДокумента");
	    ДанныеДокумента.Вставить("ВидДокумента");
	    ДанныеДокумента.Вставить("Организация");

		ЗаполнитьЗначенияСвойств(ДанныеДокумента,Выборка);
		
		ДанныеДокументов.Вставить(Выборка.ЭлектронныйДокумент,ДанныеДокумента); 
		
	КонецЦикла;
	
	Возврат ДанныеДокументов;
	
КонецФункции

Функция ПолучитьМассивЭлектронныхДокументовПоИдентификаторуМаршрутаПодписания(МассивИдентификаторов) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	СоставМаршрутаЭлектронногоДокумента.ЭлектронныйДокумент КАК ЭлектронныйДокумент
	               |ИЗ
	               |	РегистрСведений.СоставМаршрутаЭлектронногоДокумента КАК СоставМаршрутаЭлектронногоДокумента
	               |ГДЕ
	               |	СоставМаршрутаЭлектронногоДокумента.Идентификатор В(&Идентификаторы)
	               |	И СоставМаршрутаЭлектронногоДокумента.НомерСтрокиМаршрута = 1
	               |	И (СоставМаршрутаЭлектронногоДокумента.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияДокументовВнутреннегоЭДО.НеНачат)
	               |			ИЛИ СоставМаршрутаЭлектронногоДокумента.Состояние = ЗНАЧЕНИЕ(Перечисление.СостоянияДокументовВнутреннегоЭДО.ТребуетсяПодписание)
	               |			ИЛИ СоставМаршрутаЭлектронногоДокумента.Состояние = &ПустоеЗначениеПеречисления)";

	Запрос.УстановитьПараметр("Идентификаторы", МассивИдентификаторов);
	Запрос.УстановитьПараметр("ПустоеЗначениеПеречисления", Перечисления.СостоянияДокументовВнутреннегоЭДО.ПустаяСсылка());

	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат.ВыгрузитьКолонку("ЭлектронныйДокумент");
	
КонецФункции

Функция ПолучитьМаршрутыПодписанияССовпадающимиGUIDСтрок(МассивИдентификаторов, МаршрутПодписания) Экспорт
	
 	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	МаршрутыПодписанияБГУСоставМаршрута.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.МаршрутыПодписанияБГУ.СоставМаршрута КАК МаршрутыПодписанияБГУСоставМаршрута
	|ГДЕ
	|	МаршрутыПодписанияБГУСоставМаршрута.Идентификатор В (&МассивИдентификаторов)
	|		И НЕ МаршрутыПодписанияБГУСоставМаршрута.Ссылка = &МаршрутПодписания
	|		И МаршрутыПодписанияБГУСоставМаршрута.Группа = """"";
	
	Запрос.УстановитьПараметр("МассивИдентификаторов", МассивИдентификаторов);
	Запрос.УстановитьПараметр("МаршрутПодписания", МаршрутПодписания);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат.ВыгрузитьКолонку("Ссылка");
	
КонецФункции

#КонецОбласти

#Область ПрограммныйИнтерфейс
// Выполняет рассылку уведомлений исполнителям о новых задачах за период с момента предыдущей рассылки.
// Рассылка выполняется по почте от имени системной учетной записи.
// Также является обработчиком регламентного задания УведомлениеОЗадачахВнутреннийЭДО.
//
Процедура УведомитьОЗадачахВнутреннегоЭДО() Экспорт
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(
		Метаданные.РегламентныеЗадания.УведомлениеОЗадачахВнутреннийЭДО);
	
	ОписаниеОшибки = "";
	ВидСообщения = НСтр("ru = 'Внутренний ЭДО. Уведомление о задачах'", ОбщегоНазначения.КодОсновногоЯзыка());
	
	Если НЕ СистемнаяУчетнаяЗаписьНастроена(ОписаниеОшибки) Тогда
		ЗаписьЖурналаРегистрации(ВидСообщения, УровеньЖурналаРегистрации.Ошибка,
			Метаданные.РегламентныеЗадания.УведомлениеОЗадачахВнутреннийЭДО,, ОписаниеОшибки);
		Возврат;
	КонецЕсли;
	
	ДатаУведомления = ТекущаяДатаСеанса();
	
	ЗаписьЖурналаРегистрации(ВидСообщения, УровеньЖурналаРегистрации.Информация,,,
		СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Начато регламентное уведомление о задачах по состоянию на %1'"),
		ДатаУведомления));
	
	АдресИБВЛокальнойСети = ОбщегоНазначения.АдресПубликацииИнформационнойБазыВЛокальнойСети();
	АдресИБВИнтернет = ОбщегоНазначения.АдресПубликацииИнформационнойБазыВИнтернете();
	
	ПараметрыРассылки = Новый Структура;
	ПараметрыРассылки.Вставить("АдресИБВЛокальнойСети", АдресИБВЛокальнойСети);
	ПараметрыРассылки.Вставить("АдресИБВИнтернет", АдресИБВИнтернет);
	
	ЗадачиПоИсполнителям = ВыбратьЗадачиПоИсполнителям();
	Для Каждого СтрокаИсполнителя Из ЗадачиПоИсполнителям.Строки Цикл
		ЗадачиПоИсполнителюОтправлены = ОтправитьУведомлениеОНовыхЗадачах(СтрокаИсполнителя.Исполнитель, СтрокаИсполнителя, ПараметрыРассылки);
		Если ЗадачиПоИсполнителюОтправлены Тогда
			// Выполняется очистка отправленных уведомлений по пользователю.
			УстановитьПривилегированныйРежим(Истина);
			НаборЗаписей = РегистрыСведений.УведомленияОЗадачахВнутреннегоЭДО.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Подписант.Установить(СтрокаИсполнителя.Исполнитель);
			НаборЗаписей.Записать();
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
	КонецЦикла;
	
	ЗаписьЖурналаРегистрации(ВидСообщения, УровеньЖурналаРегистрации.Информация,,,
		СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Завершено регламентное уведомление о задачах (уведомлено исполнителей: %1)'"),
		ЗадачиПоИсполнителям.Строки.Количество()));
	
КонецПроцедуры

// Выполняет создание записей регистра УведомленияОЗадачахВнутреннегоЭДО для рассылки уведомлений по составу маршрута электронного документа.
// По каждой созданной записи регистра выполняется отправка уведомлений регламентным заданием.
//
Процедура ПриЗаписиСоставМаршрутаЭлектронногоДокумента(Источник, Отказ, Замещение) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУведомленияОЗадачахВнутреннийЭДО") Тогда
		
		ПодписантыДляУведомления = ПолучитьДанныеПодписантов(Источник);
		
		Для Каждого ДанныеПодписанта Из ПодписантыДляУведомления Цикл
			Если ДанныеПодписанта.ЭлектронныйДокумент <> Неопределено Тогда
				
				НаборЗаписей = РегистрыСведений.УведомленияОЗадачахВнутреннегоЭДО.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.ЭлектронныйДокумент.Установить(ДанныеПодписанта.ЭлектронныйДокумент);
				НаборЗаписей.Отбор.Подписант.Установить(ДанныеПодписанта.Подписант);
				
				Запись = НаборЗаписей.Добавить();
				ЗаполнитьЗначенияСвойств(Запись, ДанныеПодписанта);
				
				НаборЗаписей.Записать();
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьКомандыВнутреннегоЭДО(Форма, ГруппаДляПодменю = Неопределено, Префикс = "")
	
	ПодменюВнутреннееЭДО = НайтиДобавитьПодменю(Форма, ГруппаДляПодменю, Префикс);
	
	ДобавитьКомандуПросмотретьЭД(Форма, ГруппаДляПодменю, Префикс, ПодменюВнутреннееЭДО);
	
	ДобавитьКомандуОткрытьЭДНаПодпись(Форма, ГруппаДляПодменю, Префикс, ПодменюВнутреннееЭДО);
	
КонецПроцедуры

Процедура ДобавитьКомандыВнутреннегоЭДОДляФормыСписка(Форма, ГруппаДляПодменю = Неопределено, Префикс = "")
	
	ПодменюВнутреннееЭДО = НайтиДобавитьПодменю(Форма, ГруппаДляПодменю, Префикс);
	
	ДобавитьКомандуПросмотретьЭД(Форма, ГруппаДляПодменю, Префикс, ПодменюВнутреннееЭДО);
	
	ДобавитьКомандуСоздатьЭД(Форма, ГруппаДляПодменю, Префикс, ПодменюВнутреннееЭДО);
	
	ДобавитьКомандуАннулироватьЭД(Форма, ГруппаДляПодменю, Префикс, ПодменюВнутреннееЭДО);
	
	ДобавитьКомандуОткрытьЭДНаПодпись(Форма, ГруппаДляПодменю, Префикс, ПодменюВнутреннееЭДО);
	
КонецПроцедуры

Процедура ДобавитьКомандыВнутреннегоЭДОДляСправочникаОрганизации(Форма)
	
	ИмяКоманды = "ВнутреннийЭДО_ОткрытьНастройкиВнутреннегоЭДО";
	
	Если Форма.Команды.Найти(ИмяКоманды) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ПравоДоступа("Просмотр", Метаданные.РегистрыСведений.НастройкиВнутреннегоЭДОБГУ) Тогда
		Возврат;
	КонецЕсли;
	
	ПодменюВнутреннееЭДО = НайтиДобавитьПодменю(Форма, Неопределено, "");
	
	ГруппаКомандыЭДО = Форма.Элементы.Найти("КомандыЭДО");
	Если ГруппаКомандыЭДО <> Неопределено Тогда
		Родитель = ПодменюВнутреннееЭДО.Родитель;
		ИндексГруппыЭДОБЭД = Родитель.ПодчиненныеЭлементы.Индекс(ГруппаКомандыЭДО);
		Если Родитель.ПодчиненныеЭлементы.Количество() - 1 > ИндексГруппыЭДОБЭД Тогда
			Форма.Элементы.Переместить(ПодменюВнутреннееЭДО,
				Родитель, Родитель.ПодчиненныеЭлементы[ИндексГруппыЭДОБЭД + 1]);
		КонецЕсли;
	КонецЕсли;
	
	КомандаФормы = Форма.Команды.Добавить(ИмяКоманды);
	КомандаФормы.Действие = "Подключаемый_ВыполнитьКомандуБГУ";
	КомандаФормы.Заголовок = НСтр("ru = 'Настройки внутреннего ЭДО'");
	КомандаФормы.ИзменяетСохраняемыеДанные = Ложь;
	КомандаФормы.Отображение = ОтображениеКнопки.Картинка;
	КомандаФормы.Картинка = БиблиотекаКартинок.Настройка;
	
	НовыйЭлемент = Форма.Элементы.Добавить(ИмяКоманды, Тип("КнопкаФормы"), ПодменюВнутреннееЭДО);
	НовыйЭлемент.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
	НовыйЭлемент.ИмяКоманды = ИмяКоманды;
	
КонецПроцедуры

Функция НайтиДобавитьПодменю(Форма, Родитель, Префикс)
	
	Подменю = Форма.Элементы.Найти(Префикс+"КомандыЭДОБГУ");
	
	Если Подменю = Неопределено Тогда
		
		Если ТипЗнч(Родитель) = Тип("Строка") Тогда
			ГруппаДляРазмещения = Форма.Элементы.Найти(Родитель);
		ИначеЕсли ТипЗнч(Родитель) = Тип("ГруппаФормы") Тогда
			ГруппаДляРазмещения = Родитель;
		ИначеЕсли Форма.Элементы.Найти("КомандыФормы") <> Неопределено Тогда
			ГруппаДляРазмещения = Форма.Элементы["КомандыФормы"];
		Иначе
			ГруппаДляРазмещения = Форма.КоманднаяПанель;
		КонецЕсли;
		
		Подменю = Форма.Элементы.Добавить(Префикс+"КомандыЭДОБГУ", Тип("ГруппаФормы"), ГруппаДляРазмещения);
		Подменю.Вид = ВидГруппыФормы.Подменю;
		Подменю.Заголовок = НСтр("ru = 'Внутр. ЭДО'");
		Подменю.Картинка = БиблиотекаКартинок.Оригинал;
		
	КонецЕсли;
	
	Возврат Подменю;
	
КонецФункции

Процедура ДобавитьКомандуПросмотретьЭД(Форма, ГруппаДляПодменю, Префикс, Родитель)
	
	ИмяКоманды = "ВнутреннийЭДО_ПросмотретьЭлектронныйДокумент";
	
	Если Форма.Команды.Найти(ИмяКоманды+Префикс) = Неопределено Тогда
		КомандаФормы = Форма.Команды.Добавить(ИмяКоманды+Префикс);
		КомандаФормы.Действие = "Подключаемый_ВыполнитьКомандуБГУ";
		КомандаФормы.Заголовок = НСтр("ru = 'Просмотреть электронный документ'");
		КомандаФормы.ИзменяетСохраняемыеДанные = Ложь;
		КомандаФормы.Отображение = ОтображениеКнопки.Картинка;
		КомандаФормы.Картинка = БиблиотекаКартинок.ОткрытьВыбранныйФайл;
	КонецЕсли;
	
	Если Форма.Элементы.Найти(Префикс+ИмяКоманды) = Неопределено Тогда
		НовыйЭлемент = Форма.Элементы.Добавить(Префикс+ИмяКоманды, Тип("КнопкаФормы"), Родитель);
		НовыйЭлемент.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
		НовыйЭлемент.ИмяКоманды = ИмяКоманды+Префикс;
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьКомандуОткрытьЭДНаПодпись(Форма, ГруппаДляПодменю, Префикс, Родитель)
	
	ИмяКоманды = "ВнутреннийЭДО_ОткрытьЭлектронныеДокументыНаПодпись";
	
	Если Форма.Команды.Найти(ИмяКоманды+Префикс) = Неопределено Тогда
		КомандаФормы = Форма.Команды.Добавить(ИмяКоманды+Префикс);
		КомандаФормы.Действие = "Подключаемый_ВыполнитьКомандуБГУ";
		КомандаФормы.Заголовок = НСтр("ru = 'Электронные документы на подпись'");
		КомандаФормы.ИзменяетСохраняемыеДанные = Ложь;
		КомандаФормы.Отображение = ОтображениеКнопки.Картинка;
		КомандаФормы.Картинка = БиблиотекаКартинок.УточнитьСостояниеОригиналаПервичногоДокументаПоПечатнымФормам;
	КонецЕсли;
	
	Если Форма.Элементы.Найти(Префикс+ИмяКоманды) = Неопределено Тогда
		ПодменюВнутреннееЭДОПрочее = Форма.Элементы.Добавить(Префикс+"ВнутреннийЭДО_ГруппаПрочее", Тип("ГруппаФормы"), Родитель);
		ПодменюВнутреннееЭДОПрочее.Вид = ВидГруппыФормы.ГруппаКнопок;
		
		НовыйЭлемент = Форма.Элементы.Добавить(Префикс+ИмяКоманды, Тип("КнопкаФормы"), ПодменюВнутреннееЭДОПрочее);
		НовыйЭлемент.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
		НовыйЭлемент.ИмяКоманды = ИмяКоманды+Префикс;
	КонецЕсли;
	
КонецПроцедуры

