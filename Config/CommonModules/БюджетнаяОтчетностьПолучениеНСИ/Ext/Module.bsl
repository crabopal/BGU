// Возвращает код ИНН для распорядителя организации
//
Функция РаспорядительКонтрагентИНН(Знач Организация) Экспорт

	РаспорядительИНН = "";
	
	РаспорядительКонтрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация,"Распорядитель");
	Если ЗначениеЗаполнено(РаспорядительКонтрагент) Тогда
		РаспорядительИНН = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РаспорядительКонтрагент,"ИНН");
	КонецЕсли;
	
	Возврат РаспорядительИНН;

КонецФункции // РаспорядительКонтрагентИНН()

// Определяет основную организацию для указанной организации.
// Если существует головная организация, то возвращается она, иначе - указанная организация
//
Функция ОсновнаяОрганизация(Знач Организация) Экспорт

	Учредитель = ГоловнаяОрганизация(Организация);
	Если ЗначениеЗаполнено(Учредитель) Тогда
		Возврат Учредитель;
	Иначе
		Возврат Организация;
	КонецЕсли;

КонецФункции // ОсновнаяОрганизация()

// Возвращает официальное наименование учреждения (если задано).
//
// Параметры
//  Учреждение	 		  - СправочникСсылка.Организации;
//
//  ПриоритетСокращенного - Булево. Если задано и сокращенное, и полное наименования,
//                 			то будет возвращено сокращенное наименование учреждения.
//                          Если указано значение Неопределено, приоритет устанавливается системой.
//
//	НаДату				  - Дата. В случае хранения истории наименований, при указании даты, будет 
//							возвращено значение наименования на указанную дату (не используется в БГУ).
//							Если указано значение Неопределено, получается значение из реквизитов справочника.
//
// Возвращаемое значение:
//   Строка - наименование учреждения.
//
Функция ОфициальноеНаименование(Знач Организация, Знач ПриоритетСокращенного = Неопределено, Знач НаДату = Неопределено) Экспорт
 
	Если ТипЗнч(Организация) = Тип("СправочникСсылка.Организации") Тогда
		Возврат ОфициальноеНаименованиеОрганизации(Организация, ПриоритетСокращенного);
	ИначеЕсли ТипЗнч(Организация) = Тип("СправочникСсылка.Контрагенты") Тогда
		Возврат ОфициальноеНаименованиеКонтрагента(Организация, ПриоритетСокращенного);
	КонецЕсли;
	
КонецФункции // ОфициальноеНаименование()

Функция ОфициальноеНаименованиеОрганизации(Знач Организация, Знач ПриоритетСокращенного = Неопределено)
	
	Возврат БюджетнаяОтчетностьПолучениеНСИПереопределяемый.ОфициальноеНаименованиеОрганизации(Организация,ПриоритетСокращенного);

КонецФункции // ОфициальноеНаименованиеОрганизации()

Функция ОфициальноеНаименованиеКонтрагента(Знач Контрагент, Знач ПриоритетСокращенного = Неопределено)

	Возврат БюджетнаяОтчетностьПолучениеНСИПереопределяемый.ОфициальноеНаименованиеКонтрагента(Контрагент,ПриоритетСокращенного);

КонецФункции // ОфициальноеНаименованиеКонтрагента()

Функция СокращенноеНаименованиеКонтрагента(Знач Контрагент) Экспорт
	
	Возврат БюджетнаяОтчетностьПолучениеНСИПереопределяемый.СокращенноеНаименованиеКонтрагента(Контрагент);

КонецФункции // СокращенноеНаименованиеКонтрагента()


// Определяет является ли организация обособленным подразделением
//
Функция ЭтоОбособленноеПодразделение(Знач Организация) Экспорт

	Учредитель = ГоловнаяОрганизация(Организация);
	
	Возврат ЗначениеЗаполнено(Учредитель) И Учредитель <> Организация;;

КонецФункции // ОбособленноеПодразделение()

// Получает классификационные коды, такие как ИНН, КПП, УБП, ОКПО и пр.
//
// Параметры
//  Организация  - Организация или Контрагент
//                 
//  Код - общепринятое значение кода, например: ИНН, КПП, ОКПО
//
// Возвращаемое значение:
//   Строковое значение кода или пустая строка, если код не предусмотрен.
//
Функция ПолучитьКод(Знач Организация, Знач Код, Знач ПривестиКСтроке = Истина) Экспорт
	
	Коды = ПолучитьКоды(Организация, Код, ПривестиКСтроке);
	Если Не Коды = Неопределено Тогда
		Возврат Коды[Код];
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции // ПубличныйКод()

// Инициалы имени и фамилия руководителя организации
