//
Функция ФИОРуководителя(Знач Организация, Знач Актуальность = Неопределено, Знач СначалаИнициалы = Истина) Экспорт

	Возврат ФИООтветственногоЛица(Организация, "Руководитель", СначалаИнициалы, Актуальность);

КонецФункции // ФИОРуководителя()

// Инициалы имени и фамилия гл. бухгалтера организации
//
// Параметры
//  Организация     - организация для которой требуется получить данные
//                 
//  СначалаИнициалы - Вывод в режиме И.О. Фамилия.
//                    Если параметр = Ложь, тогда вывод в формате Фамилия И.О.
//
//  Актуальность - дата, на которую требуется получить данные
//
// Возвращаемое значение:
//   Строка
//
Функция ФИОГлавногоБухгалтера(Знач Организация, Знач Актуальность = Неопределено, Знач СначалаИнициалы = Истина) Экспорт

	Возврат ФИООтветственногоЛица(Организация, "ГлавныйБухгалтер", СначалаИнициалы, Актуальность);

КонецФункции // ФИОГлавногоБухгалтера()

// Инициалы имени и фамилия руководителя планово-финансовой службы организации
//
// Параметры
//  Организация     - организация для которой требуется получить данные
//                 
//  СначалаИнициалы - Вывод в режиме И.О. Фамилия.
//                    Если параметр = Ложь, тогда вывод в формате Фамилия И.О.
//
//  Актуальность - дата, на которую требуется получить данные
//
// Возвращаемое значение:
//   Строка
//
Функция ФИОРуководителяПФС(Знач Организация, Знач Актуальность = Неопределено, Знач СначалаИнициалы = Истина) Экспорт

	Возврат ФИООтветственногоЛица(Организация, "РуководительПФС", СначалаИнициалы, Актуальность);

КонецФункции // ФИОРуководителяПФС()

// Инициалы имени и фамилия ответственного лица организации
//
// Параметры
//  Организация     - организация для которой требуется получить данные
//
//  Роль            - ключевое имя отв. лица. 
//
//  СначалаИнициалы - Вывод в режиме И.О. Фамилия.
//                    Если параметр = Ложь, тогда вывод в формате Фамилия И.О.
//
//  Актуальность - дата, на которую требуется получить данные
//
// Возвращаемое значение:
//   Строка
//
Функция ФИООтветственногоЛица(Знач Организация, Знач Роль, Знач СначалаИнициалы = Истина, Знач Актуальность = Неопределено) Экспорт

	ПерсонаСсылка = ОтветственноеЛицоОрганизации(Организация, Роль, Актуальность);
	
	РеквизитыПерсоны = БюджетнаяОтчетностьПолучениеНСИПереопределяемый.ПолучитьРеквизитыОтветственногоЛица(ПерсонаСсылка,Актуальность);
	
	Если ЗначениеЗаполнено(РеквизитыПерсоны.Фамилия) Тогда
		Если СначалаИнициалы Тогда
			Возврат БюджетнаяОтчетностьКлиентСервер.СобратьСтрокуФИОИзСоставляющих(РеквизитыПерсоны, "СначалаИнициалы");
		Иначе
			Возврат БюджетнаяОтчетностьКлиентСервер.СобратьСтрокуФИОИзСоставляющих(РеквизитыПерсоны, "ИнициалыПотом");			
		КонецЕсли;
	Иначе
		Возврат БюджетнаяОтчетностьКлиентСервер.ПолучитьФамилиюИмяОтчество(РеквизитыПерсоны.Наименование, СначалаИнициалы);
	КонецЕсли;
	
КонецФункции // ФИООтветственногоЛица()

// Возвращает контактное лицо организации с указанной ролью
//
// Параметры
//  Организация  - Справочник.Организации.
//                 организационная единица для которой определяется физлицо
//  Роль		 - Справочник.РолиКонтактныхЛиц
//                 искомая роль контактного лица
//
// Возвращаемое значение:
//   Справочник.КонтактныеЛицаОрганизаций
//
Функция ОтветственноеЛицоОрганизации(Организация, Роль,  Дата = Неопределено) Экспорт

	Возврат БюджетнаяОтчетностьПолучениеНСИПереопределяемый.ОтветственноеЛицоОрганизации(Организация, Роль,  Дата);
	
КонецФункции // ОтветственноеЛицоОрганизации()

Функция ПолучитьНаименованиеСчета(Счет,Дата = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Счет) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Счет,"Наименование");
	
КонецФункции

