// Методы общего назначения.

// Получает контрагента, соответствующего организации по ИНН, КПП, Бюджету
//
// Параметры
//  Организация - СправочникСсылка.Организации
//  СоздаватьКонтрагента - булево - Истина - если контрагента нет, то будет создан, Ложь - контрагент создан не будет
//
// Возвращаемое значение:
//   СправочникСсылка.Контрагенты - найденный контрагент. Если не найден, возвращается пустая ссылка.
//
Функция КонтрагентПоОрганизации(Знач Организация, СоздаватьКонтрагента = Ложь) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Организация) ИЛИ ТипЗнч(Организация) <> Тип("СправочникСсылка.Организации") Тогда
		Возврат Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;
		

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Контрагенты.Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЮридическиеЛица КАК ЮридическиеЛица
		|		ПО Контрагенты.ЮридическоеФизическоеЛицо = ЮридическиеЛица.Ссылка
		|ГДЕ
		|	Контрагенты.ПометкаУдаления = ЛОЖЬ
		|	И Контрагенты.ВидКонтрагента = &ВидКонтрагента
		|	И ЮридическиеЛица.ИНН = &ИНН
		|	И ЮридическиеЛица.КПП = &КПП
		|	И ЮридическиеЛица.Бюджет = &Бюджет";
		
	СтруктураРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Организация,"Бюджет,ИНН,КПП,Наименование,НаименованиеПолное,КодПоППП,КодОКПО,КодПоРПБС,ДатаРегистрации,НаименованиеСокращенное");	
		
	Запрос.УстановитьПараметр("Бюджет", СтруктураРеквизитов.Бюджет);
	Запрос.УстановитьПараметр("ИНН", СтруктураРеквизитов.ИНН);
	Запрос.УстановитьПараметр("КПП", СтруктураРеквизитов.КПП);
	Запрос.УстановитьПараметр("ВидКонтрагента", Перечисления.ЮрФизЛицо.ЮрЛицо);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;
	
	Если СоздаватьКонтрагента = Истина Тогда
		//Создаем юр. лицо
		ТекЮрЛицо = Справочники.ЮридическиеЛица.СоздатьЭлемент();
		ЗаполнитьЗначенияСвойств(ТекЮрЛицо,СтруктураРеквизитов);
		ТекЮрЛицо.Записать();
		
		//Создаем контрагента
		ТекКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();
		ТекКонтрагент.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо;
		ТекКонтрагент.ЮридическоеФизическоеЛицо = ТекЮрЛицо.Ссылка;
		ЗаполнитьЗначенияСвойств(ТекКонтрагент,СтруктураРеквизитов);
		ТекКонтрагент.Записать();
		
		Возврат ТекКонтрагент.Ссылка;
	КонецЕсли;




	Возврат Справочники.Контрагенты.ПустаяСсылка();
КонецФункции

