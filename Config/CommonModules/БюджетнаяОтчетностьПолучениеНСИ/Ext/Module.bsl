// Методы унификации обращения к метаданным через имя области в бланке отчета

// Переопределяемый метод обращения к реквизитам аналитики.
//
Функция СоответствиеПолейИТиповАналитики() Экспорт

	СоответствиеПолей = Новый ТаблицаЗначений;
	СоответствиеПолей.Колонки.Добавить("ТипЗначения");
	СоответствиеПолей.Колонки.Добавить("ИмяРеквизита");
	СоответствиеПолей.Колонки.Добавить("ПутьКДанным");
	СоответствиеПолей.Колонки.Добавить("ЭтоВыражение", Новый ОписаниеТипов("Булево"));
	
	БюджетнаяОтчетностьПолучениеНСИПереопределяемый.ДополнитьСоответствиеПолейИТиповАналитики(СоответствиеПолей);
	
	Возврат СоответствиеПолей;
	
КонецФункции // СоответствиеПолейИТиповАналитики()

// Получает выражение для обращения к ИБ в запросе при получении реквизитов из 
// разметки, определенной в областях бланка отчета
//
Функция ПолучитьПутьКДаннымДляПоляАналитики(Знач ТипЗначения, Знач ВыражениеВладелец, Знач ИмяПоля) Экспорт

	ИмяТипа = ПереносимоеИмяТипа(ТипЗначения);
	
	ОписаниеПоля = БюджетнаяОтчетностьСерверПовтИсп.ПолучитьПутьКДаннымДляПоляАналитики(ИмяТипа, ИмяПоля);
	Если ОписаниеПоля = Неопределено Тогда
		Возврат Неопределено;
	ИначеЕсли ОписаниеПоля.ЭтоВыражение Тогда
		Возврат СтрЗаменить(ОписаниеПоля.ПутьКДанным, "$", ВыражениеВладелец);
	Иначе
		Возврат ВыражениеВладелец+"."+ОписаниеПоля.ПутьКДанным;
	КонецЕсли;
	
КонецФункции // ПолучитьПутьКДаннымДляПоляАналитики()

Функция ПереносимоеИмяТипа(Знач ТипЗначения)

	МетаданныеТипа = Метаданные.НайтиПоТипу(ТипЗначения);
	
	Возврат МетаданныеТипа.ПолноеИмя();

КонецФункции // ПереносимоеИмяТипа()

// Обертка для отображения прикладных реквизитов на реквизиты ИБ
//
Функция ИмяРеквизитаБюджета(Знач ИмяРеквизита) Экспорт

	Если ВРег(ИмяРеквизита) = "ОКАТО" Тогда
		Возврат "Код";
	Иначе
		Возврат ИмяРеквизита;
	КонецЕсли;
	
КонецФункции // ИмяРеквизитаБюджета()

Функция ПолучитьРеквизитБюджета(Знач Параметр, Знач ИФО, Знач РеквизитБюджета)

	Запрос = БюджетнаяОтчетностьПолучениеНСИПереопределяемый.ПостроитьЗапросКБюджету(Параметр, ИФО, РеквизитБюджета);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Значение;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции // ПолучитьРеквизитБюджета()

// Получает классификационные коды, такие как ИНН, КПП, УБП, ОКПО и пр. в пакетном режиме
//
// Параметры
//  Организация  - Организация или Контрагент
//                 
//  Код - общепринятое значение кода, например: ИНН, КПП, ОКПО
//
// Возвращаемое значение:
//   Строковое значение кода или пустая строка, если код не предусмотрен.
//
Функция ПолучитьКоды(Знач Организация, Знач Коды, Знач ПривестиКСтроке = Истина) Экспорт

	МассивКодов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Коды, ",");
	Поля = Неопределено;
	
	Если ТипЗнч(Организация) = Тип("СправочникСсылка.Организации") Тогда
		Поля = ПоляКодовОрганизации();
		ЭтоОрганизация = Истина;
	ИначеЕсли ТипЗнч(Организация) = Тип("СправочникСсылка.Контрагенты") Тогда
		Поля = ПоляКодовКонтрагента();
		ЭтоОрганизация = Ложь;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	ПоляЗапроса = "";
	Для Каждого ТребуемоеПоле Из МассивКодов Цикл
		
		ПутьКДанным = Поля[ВРег(ТребуемоеПоле)];
		Если ПутьКДанным <> Неопределено Тогда
			Если ПривестиКСтроке Тогда
				Поле = "ПРЕДСТАВЛЕНИЕ($." + ПутьКДанным + ") КАК " + ТребуемоеПоле;
			Иначе
				Поле = "$." + ПутьКДанным + " КАК " + ТребуемоеПоле;
			КонецЕсли;
		Иначе
			Поле = """"" КАК " + ТребуемоеПоле;
		КонецЕсли;
		
		ПоляЗапроса = ПоляЗапроса + ",
		|	" + Поле;
		
	КонецЦикла;
	
	ПоляЗапроса = Сред(ПоляЗапроса,2);
	
	Если ЭтоОрганизация Тогда
		Результат = ЗапросПоКодамОрганизации(Организация, ПоляЗапроса);
	Иначе
		Результат = ЗапросПоКодамКонтрагента(Организация, ПоляЗапроса);
	КонецЕсли;

	СтруктураОтвета = Новый Структура(Коды);
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	ЗаполнитьЗначенияСвойств(СтруктураОтвета, Выборка);
	
	Возврат СтруктураОтвета;
	
КонецФункции // ПолучитьКоды()

// коды организаций и контрагентов
Функция ПоляКодовОрганизации()

	Поля = Новый Соответствие;
	
	БюджетнаяОтчетностьПолучениеНСИПереопределяемый.ЗаполнитьСоответствиеПолейКодовОрганизации(Поля);
	
	Возврат Поля;

КонецФункции // ПоляКодовОрганизации()

Функция ПоляКодовКонтрагента()

	Поля = Новый Соответствие;
	
	БюджетнаяОтчетностьПолучениеНСИПереопределяемый.ЗаполнитьСоответствиеПолейКодовКонтрагента(Поля);

	Возврат Поля;

КонецФункции // ПоляКодовКонтрагента()

Функция ЗапросПоКодамОрганизации(Знач Организация, Знач ПоляВыборки)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	" + СтрЗаменить(ПоляВыборки,"$","Таблица") + "
	|ИЗ
	|	Справочник.Организации КАК Таблица
	|ГДЕ
	|	Таблица.Ссылка = &Организация";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Возврат Запрос.Выполнить();

КонецФункции // ЗапросПоКодамОрганизации()

Функция ЗапросПоКодамКонтрагента(Знач Контрагент, Знач ПоляВыборки)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	" + СтрЗаменить(ПоляВыборки,"$","Таблица") + "
	|ИЗ
	|	Справочник.Контрагенты КАК Таблица
	|ГДЕ
	|	Таблица.Ссылка = &Контрагент";
	
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	
	Возврат Запрос.Выполнить();

КонецФункции // ЗапросПоКодамОрганизации()

Функция ПолучитьОрганизациюДляОтветственныхЛиц(Знач Организация) Экспорт
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Возврат Организация;
	КонецЕсли;
	
	РеквизитыПолномочий = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Организация,"УчетПереданныхПолномочий,ПолучательПолномочий",Истина);
	
	ОрганизацияДляЗапроса = Организация;
	
	Если РеквизитыПолномочий.УчетПереданныхПолномочий = Истина
		И ЗначениеЗаполнено(РеквизитыПолномочий.ПолучательПолномочий) Тогда
		//если учет переданых полномочий, то ответственные лица - от организации получателя полномочий
		ОрганизацияДляЗапроса = РеквизитыПолномочий.ПолучательПолномочий;
	КонецЕсли;
	
	Возврат ОрганизацияДляЗапроса;
	
КонецФункции
