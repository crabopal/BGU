// Возвращаемое значение:
//  Строка - 
//
Функция ВидПодбораПоВидуИзвещения(ВидИзвещения) Экспорт
	Если ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеНФАПоставщика") Тогда
		Возврат "ПолучениеНФАПоставщика";
	ИначеЕсли ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеНФАСоСклада") Тогда
		Возврат "ПолучениеНФАСоСклада";
	ИначеЕсли ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаДенежныхСредств") Тогда
		Возврат "Платежи";
	ИначеЕсли ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаБСО") Тогда
		Возврат "БСО";
	ИначеЕсли ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаФинансовыхВложений") Тогда
		Возврат "ПередачаФинансовыхВложений";
	ИначеЕсли ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаВложенийВФинансовыеАктивы") Тогда
		Возврат "ПередачаВложенийВФинансовыеАктивы";
	ИначеЕсли ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеДенежныхСредств") Тогда
		Возврат "ПолучениеПлатежей";
	ИначеЕсли ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеБСО") Тогда
		Возврат "ПолучениеБСО";
	ИначеЕсли ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеФинансовыхВложений") Тогда
		Возврат "ПолучениеФинансовыхВложений";
	ИначеЕсли ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеВложенийВФинансовыеАктивы") Тогда
		Возврат "ПолучениеВложенийВФинансовыеАктивы";
	ИначеЕсли ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.РасчетыПоМБТ") Тогда
		Возврат "СписаниеДоходовБудущихПериодов";
	ИначеЕсли ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаРасчетовПоПоставкамНФА") Тогда
		Возврат ВидПодбораПоступленияНФА();
	ИначеЕсли ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаУточненияРасчетовПоПоставкамНФА") Тогда
		Возврат ВидПодбораУточнениеПоступленияНФА();
	ИначеЕсли ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ОтПолучателя_ПолучениеГрузополучателемНФАОтПоставщика") Тогда
		Возврат ВидПодбораОтПолучателя_ПолучениеГрузополучателемНФАОтПоставщика();
	ИначеЕсли ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ОтПолучателя_ПередачаСведенийОРазделенииЗемельныхУчастковОПУИ") Тогда
		Возврат ВидПодбораОтПолучателя_ПередачаСведенийОРазделенииЗемельныхУчастковОПУИ();
	Иначе
		Возврат "";
	КонецЕсли;
КонецФункции

