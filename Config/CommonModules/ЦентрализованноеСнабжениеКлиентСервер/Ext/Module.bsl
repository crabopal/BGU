//@strict-types

#Область ПрограммныйИнтерфейс

// Заполнить данные новой строки.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения:
//   * Объект - ДанныеФормыСтруктура:
//    ** Ссылка - ДокументСсылка -
//    ** ВидИзвещения - ПеречислениеСсылка -
//   * ВсеДопустимыеКорреспонденции - см. ЦентрализованноеСнабжениеКлиентСервер.ПустаяДопустимаяКорреспонденция
//   * СвойстваИспользуемыхСчетов - ДанныеФормыКоллекция
//  Строка - ДанныеФормыЭлементКоллекции:
//   * СубконтоДт1 - Характеристика.ВидыСубконто
//   * СубконтоКт1 - Характеристика.ВидыСубконто
Процедура ЗаполнитьДанныеНовойСтроки(Форма, Строка) Экспорт

	Объект = Форма.Объект;
	
	ДопустимыеКорреспонденции = Форма.ВсеДопустимыеКорреспонденции;
	Если ДопустимыеКорреспонденции = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоВходящееИзвещение = ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ИзвещениеВходящее");
	СвойстваИспользуемыхСчетов = Форма.СвойстваИспользуемыхСчетов;
	ЦентрализованноеСнабжениеКлиентСервер.ЗаполнитьСчетЕслиДопустимЕдинственныйСчет(Строка, ДопустимыеКорреспонденции,
		СвойстваИспользуемыхСчетов, "Дт");
	ЦентрализованноеСнабжениеКлиентСервер.ЗаполнитьСчетЕслиДопустимЕдинственныйСчет(Строка, ДопустимыеКорреспонденции,
		СвойстваИспользуемыхСчетов, "Кт");

	ПараметрыПодстановки = ЦентрализованноеСнабжениеКлиентСервер.УстановитьЗначенияСубконтоДтКт_Параметры();
	ПараметрыПодстановки.ДтКт = "Дт";
	ПараметрыПодстановки.Объект = Объект;
	ПараметрыПодстановки.ДопустимыеКорреспонденции = ДопустимыеКорреспонденции;
	ЦентрализованноеСнабжениеКлиентСервер.СкопироватьСвойстваСчетовИзФормы(Форма.СвойстваИспользуемыхСчетов, ПараметрыПодстановки);
	Если ЭтоВходящееИзвещение Тогда
		ЦентрализованноеСнабжениеКлиентСервер.ЗаполнитьПараметрыПодстановкиСубконтоВходящееИзвещение(ПараметрыПодстановки, Объект);
	Иначе
		ЦентрализованноеСнабжениеКлиентСервер.ЗаполнитьПараметрыПодстановкиСубконтоИсходящееИзвещение(ПараметрыПодстановки, Объект);
	КонецЕсли;
	ЦентрализованноеСнабжениеКлиентСервер.ПодставитьЗначенияСубконтоВСтрокуИсходящееИзвещение(Строка, ПараметрыПодстановки);

	ПараметрыПодстановки = ЦентрализованноеСнабжениеКлиентСервер.УстановитьЗначенияСубконтоДтКт_Параметры();
	ПараметрыПодстановки.ДтКт = "Кт";
	ПараметрыПодстановки.ДопустимыеКорреспонденции = ДопустимыеКорреспонденции;
	ЦентрализованноеСнабжениеКлиентСервер.СкопироватьСвойстваСчетовИзФормы(Форма.СвойстваИспользуемыхСчетов, ПараметрыПодстановки);
	Если ЭтоВходящееИзвещение Тогда
		ЦентрализованноеСнабжениеКлиентСервер.ЗаполнитьПараметрыПодстановкиСубконтоВходящееИзвещение(ПараметрыПодстановки, Объект);
	Иначе
		ЦентрализованноеСнабжениеКлиентСервер.ЗаполнитьПараметрыПодстановкиСубконтоИсходящееИзвещение(ПараметрыПодстановки, Объект);
	КонецЕсли;
	ЦентрализованноеСнабжениеКлиентСервер.ПодставитьЗначенияСубконтоВСтрокуИсходящееИзвещение(Строка, ПараметрыПодстановки);
	
	Если ЗначениеЗаполнено(Строка.СубконтоДт1) Тогда
		ЦентрализованноеСнабжениеКлиентСервер.УстановитьДетальныйКЭКВСтрокеДокумента(Объект, Строка, "Дт");
	КонецЕсли;
	Если ЗначениеЗаполнено(Строка.СубконтоКт1) Тогда
		ЦентрализованноеСнабжениеКлиентСервер.УстановитьДетальныйКЭКВСтрокеДокумента(Объект, Строка, "Кт");
	КонецЕсли;
	
КонецПроцедуры

// Установить детальный КЭКВСтроке документа.
// 
// Параметры:
//  Объект - ДанныеФормыСтруктура, ДокументОбъект.ИзвещениеИсходящее, ДокументОбъект.ИзвещениеВходящее - :
//   * Дата - Дата
//   * ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения
//   * Организация - СправочникСсылка.Организации
//  ТекущиеДанные - ДанныеФормыЭлементКоллекции, СтрокаТабличнойЧасти - :
//   * КФО - ПеречислениеСсылка.КВД
//   * КЭКДт - СправочникСсылка.КОСГУ
//   * КЭККт - СправочникСсылка.КОСГУ
//  ДтКт - Строка
Процедура УстановитьДетальныйКЭКВСтрокеДокумента(Объект, ТекущиеДанные, ДтКт) Экспорт
	
	КодКЭК = Строка(ТекущиеДанные["КЭК" + ДтКт]);
	
	Если СтрНайти(БухгалтерскийУчетКлиентСервер.КОСГУКонтрагенты(), КодКЭК) > 0
		ИЛИ СтрНайти(БухгалтерскийУчетКлиентСервер.КОСГУМатериалы(), КодКЭК) > 0 Тогда
			
		ПараметрыКЭК = БухгалтерскийУчетКлиентСервер.ПараметрыРасчетаКЭКПроводки();
		ПараметрыКЭК.Дата        = Объект.Дата;
		ПараметрыКЭК.ИФО         = Объект.ИФО;
		ПараметрыКЭК.КФО         = ТекущиеДанные.КФО;
		ПараметрыКЭК.Организация = Объект.Организация;
		Счет = ТекущиеДанные["Счет" + ДтКт];  // ПланСчетовСсылка.ЕПСБУ
		ПараметрыКЭК.Счет        = Счет;
		ПараметрыКЭК.ДтКт        = ДтКт;
		УстановитьСубконтоВПараметрыИзСтроки(ПараметрыКЭК, ТекущиеДанные, ДтКт);
		
		ТекущиеДанные["КЭК" + ДтКт] = БухгалтерскийУчетВызовСервера.КЭКПроводки(ПараметрыКЭК);
		
	КонецЕсли;
	
КонецПроцедуры

// Подставить значения субконто в строку исходящее извещение.
// 
// Параметры:
//  ТекущиеДанные - ДанныеФормыЭлементКоллекции, СтрокаТабличнойЧасти -
//  ПараметрыПодстановки - см. УстановитьЗначенияСубконтоДтКт_Параметры
Процедура ПодставитьЗначенияСубконтоВСтрокуИсходящееИзвещение(ТекущиеДанные, ПараметрыПодстановки) Экспорт
	УстановитьЗначенияСубконтоВСтроке(ТекущиеДанные, ПараметрыПодстановки);
КонецПроцедуры

// Скопировать свойства счетов из формы.
// 
// Параметры:
//  СвойстваИспользуемыхСчетов - ДанныеФормыКоллекция:
//   * Счет - ПланСчетовСсылка.ЕПСБУ -
//  ПараметрыПодстановки - см. УстановитьЗначенияСубконтоДтКт_Параметры
Процедура СкопироватьСвойстваСчетовИзФормы(СвойстваИспользуемыхСчетов, ПараметрыПодстановки) Экспорт
	Для Каждого СтрокаСчета Из СвойстваИспользуемыхСчетов Цикл
		СвойстваСчета = СтруктураСвойствСчета();
		ЗаполнитьЗначенияСвойств(СвойстваСчета, СтрокаСчета);
		ПараметрыПодстановки.СвойстваСчетов.Вставить(СтрокаСчета.Счет, СвойстваСчета);
	КонецЦикла;
КонецПроцедуры

// Установить реквизиты счета.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения:
//   * СвойстваИспользуемыхСчетов - ДанныеФормыКоллекция:
//  ДанныеСтроки - ДанныеФормыЭлементКоллекции
//  ДтКт - Строка - "Дт" или "Кт"
Процедура УстановитьРеквизитыСчета(Форма, ДанныеСтроки, ДтКт) Экспорт
	
	Счет = ДанныеСтроки["Счет" + ДтКт]; // ПланСчетовСсылка.ЕПСБУ
	Если Не ЗначениеЗаполнено(Счет) Тогда
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура("Счет", Счет);
	ДанныеСчетов = Форма.СвойстваИспользуемыхСчетов.НайтиСтроки(Отбор);
	Если ДанныеСчетов.Количество() = 0 Тогда
		СвойстваСчетаБД = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(Счет);
		СвойстваСчета = СтруктураСвойствСчета();
		ЗаполнитьЗначенияСвойств(СвойстваСчета, СвойстваСчетаБД);
		СвойстваСчета.УчетПоПодразделениямОбязательный = Не СвойстваСчетаБД.РазрешитьНеУказыватьПодразделение;
	Иначе
		СвойстваСчета = ДанныеСчетов[0]; // см. СтруктураСвойствСчета
	КонецЕсли;
	
	ДанныеСтроки["Счет" + ДтКт + "УчетПоПодразделениям"] = СвойстваСчета.УчетПоПодразделениям;
	ДанныеСтроки["Счет" + ДтКт + "УчетПоКПС"] 			 = СвойстваСчета.УчетПоКПС;
	ДанныеСтроки["Счет" + ДтКт + "УчетПоКЭК"] 			 = СвойстваСчета.УчетПоКЭК;
	ДанныеСтроки["Счет" + ДтКт + "КоличествоСубконто"]   = СвойстваСчета.КоличествоСубконто;
	ДанныеСтроки["Счет" + ДтКт + "УчетПоПодразделениямОбязательный"] = СвойстваСчета.УчетПоПодразделениямОбязательный;

КонецПроцедуры

// Заполнить параметры подстановки субконто Исходящее извещение.
// 
// Параметры:
//  ПараметрыПодстановки - см. УстановитьЗначенияСубконтоДтКт_Параметры
//  Объект - ДанныеФормыСтруктура, ДокументОбъект.ИзвещениеВходящее, ДокументОбъект.ИзвещениеИсходящее - :
//   * ВидИзвещения - ПеречислениеСсылка.ВидыОперацийИсходящееИзвещение
//   * Получатель - СправочникСсылка.Контрагенты
//   * Поставщик - СправочникСсылка.Контрагенты
//   * Договор - СправочникСсылка.Договоры
Процедура ЗаполнитьПараметрыПодстановкиСубконтоИсходящееИзвещение(ПараметрыПодстановки, Объект) Экспорт
	ПараметрыПодстановки.ВидИзвещения = Объект.ВидИзвещения;
	Если Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.РасчетыПоМБТ")
		ИЛИ Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеРасчетовПоМБТ") Тогда
		ПараметрыПодстановки.КонтрагентКт = Объект.Получатель;                                 
		ПараметрыПодстановки.КонтрагентДт = Объект.Получатель;

	ИначеЕсли Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаОбязательств")
		ИЛИ Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеОбязательств") Тогда
		ПараметрыПодстановки.КонтрагентКт = Объект.Получатель;
		ПараметрыПодстановки.КонтрагентДт = Объект.Получатель;
		
	ИначеЕсли Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеТребований") Тогда
		ПараметрыПодстановки.КонтрагентДт = Объект.Поставщик;
		ПараметрыПодстановки.КонтрагентКт = Объект.Получатель;
	ИначеЕсли Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ОтПолучателя_ОтражениеВУчетеРазделенияЗемельныхУчастковЭДО") Тогда
		ПараметрыПодстановки.КонтрагентДт = Объект.Получатель;
		ПараметрыПодстановки.КонтрагентКт = ПараметрыПодстановки.КонтрагентДт;
	Иначе
		ПараметрыПодстановки.КонтрагентДт = Объект.Получатель;
		ПараметрыПодстановки.КонтрагентКт = Объект.Поставщик;
		ПараметрыПодстановки.ДоговорКт = Объект.Договор;
	КонецЕсли;
КонецПроцедуры

// Заполнить параметры подстановки субконто Входящее извещение.
// 
// Параметры:
//  ПараметрыПодстановки - см. УстановитьЗначенияСубконтоДтКт_Параметры
//  Объект - ДанныеФормыСтруктура:
//   * ВидИзвещения - ПеречислениеСсылка.ВидыОперацийВходящееИзвещение, ПеречислениеСсылка.ВидыОперацийИсходящееИзвещение - 
//   * Отправитель - СправочникСсылка.Контрагенты
//   * Поставщик - СправочникСсылка.Контрагенты
//   * Договор - СправочникСсылка.Договоры
//  ДтКт - Строка - "Дт" или "Кт"
Процедура ЗаполнитьПараметрыПодстановкиСубконтоВходящееИзвещение(ПараметрыПодстановки, Объект, ДтКт = "") Экспорт
	ПараметрыПодстановки.ВидИзвещения = Объект.ВидИзвещения;
	Если ДтКт = "" Или ДтКт = "Дт" Тогда
		Если Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийВходящееИзвещение.ПолучениеДохода")
			Или Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийВходящееИзвещение.РасчетыПоМБТ") Тогда
			ПараметрыПодстановки.КонтрагентДт = Объект.Отправитель;
		ИначеЕсли Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийВходящееИзвещение.ПолучениеРБП") Тогда
			ПараметрыПодстановки.ДоговорДт = Объект.Договор;
		ИначеЕсли Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийВходящееИзвещение.ПолучениеРасчетовПоПоставкамНФА")
				Или Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийВходящееИзвещение.ПолучениеУточненияРасчетовПоПоставкамНФА") Тогда
			ПараметрыПодстановки.КонтрагентДт = Объект.Отправитель;
		КонецЕсли;
	КонецЕсли;
	Если ДтКт = "" Или ДтКт = "Кт" Тогда
		Если Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийВходящееИзвещение.НачислениеДохода")
			Или Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийВходящееИзвещение.ПолучениеДохода")
			Или Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийВходящееИзвещение.ПолучениеФА")
			Или Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийВходящееИзвещение.ПолучениеОбязательств")
			Или Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийВходящееИзвещение.РасчетыПоМБТ")
			Или Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийВходящееИзвещение.ПолучениеРБП") Тогда
			ПараметрыПодстановки.КонтрагентКт = Объект.Отправитель;
		ИначеЕсли Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийВходящееИзвещение.ПолучениеРасчетовПоПоставкамНФА")
				Или Объект.ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийВходящееИзвещение.ПолучениеУточненияРасчетовПоПоставкамНФА") Тогда
			ПараметрыПодстановки.ДоговорКт = Объект.Договор;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Заполнить допустимые корреспонденции документа.
// 
// Параметры:
//  ПараметрыПодстановки - см. УстановитьЗначенияСубконтоДтКт_Параметры
//  Форма - ФормаКлиентскогоПриложения
Процедура ЗаполнитьДопустимыеКорреспонденцииДокумента(ПараметрыПодстановки, Форма) Экспорт
	ПараметрыПодстановки.ДопустимыеКорреспонденции = ДопустимыеКорреспонденцииДокумента(Форма);
КонецПроцедуры

// Это вид входящего извещения входящее извещение.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения:
//   * Объект - ДанныеФормыСтруктура
// 
// Возвращаемое значение:
// Булево
Функция ЭтоВидВходящегоИзвещенияВходящееИзвещение(Форма) Экспорт

	ДопустимыеКорреспонденции = ДопустимыеКорреспонденцииДокумента(Форма);
	Если ДопустимыеКорреспонденции = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Установить параметры выбора счетов.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения:
//   * Объект - ДанныеФормыСтруктураСКоллекцией
//   * ВсеДопустимыеКорреспонденции - см. ЦентрализованноеСнабжениеКлиентСервер.ПустаяДопустимаяКорреспонденция
//   * Элементы - ВсеЭлементыФормы:
//     ** ПередаваемыеПроводкиСчетДт - ПолеФормы
//     ** ПередаваемыеПроводкиСчетКт - ПолеФормы
Процедура УстановитьПараметрыВыбораСчетов(Форма) Экспорт

	Элементы = Форма.Элементы;
	ДопустимыеКорреспонденции = ДопустимыеКорреспонденцииДокумента(Форма); // см. ПустаяДопустимаяКорреспонденция
	
	Если ТипЗнч(ДопустимыеКорреспонденции) = Тип("Структура")
		Или ТипЗнч(ДопустимыеКорреспонденции) = Тип("ФиксированнаяСтруктура") Тогда
		ПараметрыВыбораДт = ДопустимыеКорреспонденции.СчетаДт;
		ПараметрыВыбораКт = ДопустимыеКорреспонденции.СчетаКт;
	Иначе
		ПараметрыВыбораДт = Неопределено;
		ПараметрыВыбораКт = Неопределено;
	КонецЕсли;
	
	ПараметрыВыбораСчетДт = Новый Массив;
	ПараметрыВыбораСчетДт.Добавить(Новый ПараметрВыбора("ОграниченияСписокСчетов", ПараметрыВыбораДт));
	ПараметрыВыбораСчетДт.Добавить(Новый ПараметрВыбора("ВыборГруппИЭлементов", ИспользованиеГруппИЭлементов.Элементы));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПередаваемыеПроводкиСчетДт",
		"ПараметрыВыбора", Новый ФиксированныйМассив(ПараметрыВыбораСчетДт));

	ПараметрыВыбораСчетКт = Новый Массив;
	ПараметрыВыбораСчетКт.Добавить(Новый ПараметрВыбора("ОграниченияСписокСчетов", ПараметрыВыбораКт));
	ПараметрыВыбораСчетКт.Добавить(Новый ПараметрВыбора("ВыборГруппИЭлементов", ИспользованиеГруппИЭлементов.Элементы));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПередаваемыеПроводкиСчетКт",
		"ПараметрыВыбора", Новый ФиксированныйМассив(ПараметрыВыбораСчетКт));
	
КонецПроцедуры

// Пустая допустимая корреспонденция.
// 
// Возвращаемое значение:
//  Структура - Пустая допустимая корреспонденция:
// * СчетаДт - Массив из Строка
// * СчетаКт - Массив из Строка
Функция ПустаяДопустимаяКорреспонденция() Экспорт
	Возврат Новый Структура("СчетаДт, СчетаКт", Новый Массив, Новый Массив);
КонецФункции

// Получить ссылки счетов.
// 
// Параметры:
//  СторонаКорреспондеции - Массив из Структура:
//    * Ссылка - ПланСчетовСсылка.ЕПСБУ
// 
// Возвращаемое значение:
//  Массив из ПланСчетовСсылка.ЕПСБУ
Функция ПолучитьСсылкиСчетов(СторонаКорреспондеции) Экспорт
	Результат = Новый Массив;
	Для Каждого Счет Из СторонаКорреспондеции Цикл
		Результат.Добавить(Счет.Ссылка);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Установить значения субконто в строке.
// 
// Параметры:
//  Строка - ДанныеФормыЭлементКоллекции -
//  Параметры - Структура -:
//   * ДтКт - Строка -
//   * ДопустимыеКорреспонденции - Структура - см. ПустаяДопустимаяКорреспонденция
// Объект - ДанныеФормыСтруктура
Процедура УстановитьЗначенияСубконтоВСтроке(Строка, Параметры) Экспорт
	
	Если Параметры.ДопустимыеКорреспонденции = Неопределено Тогда
		Возврат;
	КонецЕсли;

	УстановитьЗначенияСубконтоДтКт_ПроверитьПараметры(Параметры);

	Если НЕ ЗначениеЗаполнено(Параметры.ДтКт) Или ВРег(Параметры.ДтКт) = "ДТ" Тогда
		УстановитьЗначенияСубконтоДтКт(Строка, Параметры, "Дт", Параметры.ДопустимыеКорреспонденции);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Параметры.ДтКт) Или ВРег(Параметры.ДтКт) = "КТ" Тогда
		УстановитьЗначенияСубконтоДтКт(Строка, Параметры, "Кт", Параметры.ДопустимыеКорреспонденции);
	КонецЕсли;
	
КонецПроцедуры

// Установить значения субконто дт кт параметры.
// 
// Возвращаемое значение:
//  Структура - Установить значения субконто дт кт параметры:
//   * КонтрагентДт - СправочникСсылка.Контрагенты
//   * ДоговорДт - СправочникСсылка.Договоры
//   * КонтрагентКт - СправочникСсылка.Контрагенты
//   * ДоговорКт - СправочникСсылка.Договоры
//   * ДтКт - Строка
//   * ВидИзвещения - ПеречислениеСсылка.ВидыОперацийИсходящееИзвещение
//   * ДопустимыеКорреспонденции - см. ПустаяДопустимаяКорреспонденция
//   * Объект - ДокументОбъект.ИзвещениеВходящее
//   		- ДокументОбъект.ИзвещениеИсходящее
//   		- ДанныеФормыСтруктура:
//   		 ** Ссылка - ДокументСсылка.ИзвещениеВходящее, ДокументСсылка.ИзвещениеИсходящее -
//   * СвойстваСчетов - Соответствие из КлючИЗначение:
//     ** Ключ - ПланСчетовСсылка.ЕПСБУ -
//     ** Значение - Структура
Функция УстановитьЗначенияСубконтоДтКт_Параметры() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("КонтрагентДт", ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка"));
	Результат.Вставить("ДоговорДт",    ПредопределенноеЗначение("Справочник.Договоры.ПустаяСсылка"));
	Результат.Вставить("КонтрагентКт", ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка"));
	Результат.Вставить("ДоговорКт",    ПредопределенноеЗначение("Справочник.Договоры.ПустаяСсылка"));
	Результат.Вставить("ДтКт", "");
	Результат.Вставить("ВидИзвещения", ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПустаяСсылка"));
	Результат.Вставить("ДопустимыеКорреспонденции", ПустаяДопустимаяКорреспонденция());
	Результат.Вставить("Объект");
	Результат.Вставить("СвойстваСчетов", Новый Соответствие);
	
	//@skip-check constructor-function-return-section - Объект заполняется в вызывающем коде
	Возврат Результат;
КонецФункции

// Заполнить счет если допустим единственный счет.
// 
// Параметры:
//  Строка - ДанныеФормыЭлементКоллекции - Строка
//  ДопустимыеКорреспонденции - см. ЦентрализованноеСнабжениеКлиентСервер.ПустаяДопустимаяКорреспонденция
//  СвойстваИспользуемыхСчетов - ДанныеФормыКоллекция - 
//  ДтКт - Строка
Процедура ЗаполнитьСчетЕслиДопустимЕдинственныйСчет(Строка, ДопустимыеКорреспонденции, СвойстваИспользуемыхСчетов, ДтКт) Экспорт
	Счет = ЕдинственныйДопустимыйСчет(ДопустимыеКорреспонденции, ДтКт);
	Если Не ЗначениеЗаполнено(Счет) Тогда
		Возврат;
	КонецЕсли;
	Отбор = Новый Структура("Счет", Счет);
	ДанныеСчетов = СвойстваИспользуемыхСчетов.НайтиСтроки(Отбор);
	Если ДанныеСчетов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	СвойстваСчета = ДанныеСчетов[0]; // см. ЦентрализованноеСнабжениеКлиентСервер.СтруктураСвойствСчета
	Строка["Счет" + ДтКт]                          = Счет;
	Строка["Счет" + ДтКт + "УчетПоПодразделениям"] = СвойстваСчета.УчетПоПодразделениям;
	Строка["Счет" + ДтКт + "УчетПоКПС"]            = СвойстваСчета.УчетПоКПС;
	Строка["Счет" + ДтКт + "УчетПоКЭК"]            = СвойстваСчета.УчетПоКЭК;
	Строка["Счет" + ДтКт + "КоличествоСубконто"]   = СвойстваСчета.КоличествоСубконто;
КонецПроцедуры

// Единственный допустимый счет.
// 
// Параметры:
//  ДопустимыеКорреспонденции - см. ЦентрализованноеСнабжениеКлиентСервер.ПустаяДопустимаяКорреспонденция
//  ДтКт - Строка
// 
// Возвращаемое значение:
//  ПланСчетовСсылка.ЕПСБУ - Единственный допустимый счет:
Функция ЕдинственныйДопустимыйСчет(ДопустимыеКорреспонденции, ДтКт) Экспорт
	ДопустимыеСчета = Новый Массив;
	ДопустимыеСчета = ДопустимыеКорреспонденции["Счета" + ДтКт]; // Массив из см. ЦентрализованноеСнабжениеКлиентСервер.СтруктураСвойствСчета
	Если ДопустимыеСчета.Количество() <> 1 Тогда
		Возврат ПредопределенноеЗначение("ПланСчетов.ЕПСБУ.ПустаяСсылка");
	Иначе
		Возврат ДопустимыеСчета[0];
	КонецЕсли;
КонецФункции

// Структура свойств счета.
// 
// Возвращаемое значение:
//  Структура - Структура свойств счета:
// * Ссылка - ПланСчетовСсылка.ЕПСБУ
// * УчетПоПодразделениям - Булево
// * УчетПоПодразделениямОбязательный - Булево
// * УчетПоКПС - Булево
// * УчетПоКЭК - Булево
// * КоличествоСубконто - Число
// * НомерСубконтоКонтрагенты - Число
// * НомерСубконтоДоговоры - Число
Функция СтруктураСвойствСчета() Экспорт
	СтрокаРезультата = Новый Структура;
	СтрокаРезультата.Вставить("Ссылка", ПредопределенноеЗначение("ПланСчетов.ЕПСБУ.ПустаяСсылка"));
	СтрокаРезультата.Вставить("УчетПоПодразделениям", Ложь);
	СтрокаРезультата.Вставить("УчетПоПодразделениямОбязательный", Ложь);
	СтрокаРезультата.Вставить("УчетПоКПС", Ложь);
	СтрокаРезультата.Вставить("УчетПоКЭК", Ложь);
	СтрокаРезультата.Вставить("КоличествоСубконто", 0);
	СтрокаРезультата.Вставить("НомерСубконтоКонтрагенты", 0);
	СтрокаРезультата.Вставить("НомерСубконтоДоговоры", 0);
	Возврат СтрокаРезультата;
КонецФункции

// Передаваемые проводки соответствуют виду извещения.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения:
//    * Объект - ДанныеФормыСтруктураСКоллекцией
//    * ВсеДопустимыеКорреспонденции - см. ЦентрализованноеСнабжениеКлиентСервер.ПустаяДопустимаяКорреспонденция
//    * ПередаваемыеПроводки - ТаблицаЗначений
// 
// Возвращаемое значение:
//  Булево - Передаваемые проводки соответствуют виду извещения
Функция ПередаваемыеПроводкиСоответствуютВидуИзвещения(Форма) Экспорт
	Объект = Форма.Объект;
	ДопустимыеКорреспонденции = ДопустимыеКорреспонденцииДокумента(Форма);
	
	ПередаваемыеПроводки = Объект.ПередаваемыеПроводки; // ТаблицаЗначений -
	Если ДопустимыеКорреспонденции = Неопределено Тогда
		// Проводок не должно быть
		Возврат ПередаваемыеПроводки.Количество() = 0;
	КонецЕсли;
	
	СчетаДт = ПолучитьСсылкиСчетовИндексированно(ДопустимыеКорреспонденции.СчетаДт); 
	СчетаКт = ПолучитьСсылкиСчетовИндексированно(ДопустимыеКорреспонденции.СчетаКт);
	
	Для Каждого Строка Из ПередаваемыеПроводки Цикл
		Если СчетаДт.Получить(Строка.СчетДт) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		Если СчетаКт.Получить(Строка.СчетКт) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;

КонецФункции

// Получить ссылки счетов индексированно.
// 
// Параметры:
//  СторонаКорреспондеции - Массив из Структура:
//    * Ссылка - ПланСчетовСсылка.ЕПСБУ
// 
// Возвращаемое значение:
//  Соответствие - ссылки счетов:
//    * Ключ - ПланСчетовСсылка.ЕПСБУ -
//    * Значение - Булево - 
Функция ПолучитьСсылкиСчетовИндексированно(СторонаКорреспондеции) Экспорт
	Результат = Новый Соответствие;
	Для Каждого Счет Из СторонаКорреспондеции Цикл
		Результат.Вставить(Счет, Истина);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// В Исходящем извещении доступна передача НФА.
// 
// Параметры:
//  ВидИзвещения - ПеречислениеСсылка.ВидыОперацийИсходящееИзвещение -
// 
// Возвращаемое значение:
//  Булево
Функция ВидимостьПередачиНФАИсходящееИзвещение(ВидИзвещения) Экспорт
	Возврат ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаНФАПоставщика");
КонецФункции

// Видимость денежных обязательств исходящее извещение.
// 
// Параметры:
//  ВидИзвещения - ПеречислениеСсылка.ВидыОперацийИсходящееИзвещение -
// 
// Возвращаемое значение:
//  Булево - 
Функция ВидимостьДенежныхОбязательствИсходящееИзвещение(ВидИзвещения) Экспорт
	Возврат ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаНФАПоставщика");
КонецФункции

// Видимость документов передачи исходящее извещение.
// 
// Параметры:
//  ВидИзвещения - ПеречислениеСсылка.ВидыОперацийИсходящееИзвещение -
// 
// Возвращаемое значение:
//  Булево - 
Функция ВидимостьДокументовПередачиИсходящееИзвещение(ВидИзвещения) Экспорт
	Возврат ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаБСО")
		Или ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаВложенийВФинансовыеАктивы")
		Или ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаДенежныхСредств")
		Или ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаНФАСоСклада")
		Или ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаФинансовыхВложений")
		Или ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеБСО")
		Или ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеВложенийВФинансовыеАктивы")
		Или ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеДенежныхСредств")
		Или ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеДохода")
		Или ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеОбязательств")
		Или ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеРасчетовПоМБТ")
		Или ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеРБП")
		Или ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеТребований")
		Или ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПолучениеФинансовыхВложений")
		Или ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.РасчетыПоМБТ")
		Или ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаРасчетовПоПоставкамНФА")
		Или ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ПередачаУточненияРасчетовПоПоставкамНФА")
		Или ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ОтПолучателя_ПолучениеГрузополучателемНФАОтПоставщика")
		Или ВидИзвещения = ПредопределенноеЗначение("Перечисление.ВидыОперацийИсходящееИзвещение.ОтПолучателя_ПередачаСведенийОРазделенииЗемельныхУчастковОПУИ");
