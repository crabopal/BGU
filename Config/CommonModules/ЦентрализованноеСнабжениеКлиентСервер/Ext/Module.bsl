// Параметры обновления состава видимой таблицы перечисления.
// 
// Возвращаемое значение:
//  Структура - Параметры обновления состава видимой таблицы перечисления:
// * ПоказыватьОперацииОтЗаказчика - Булево - 
// * ПоказыватьОперацииОтПолучателя - Булево - 
// * ПоказыватьОперацииЭДООтЗаказчика - Булево - 
// * ПоказыватьОперацииЭДООтПолучателя - Булево - 
// * ЗаголовокОперацииОтЗаказчика - Строка - 
// * ЗаголовокОперацииОтПолучателя - Строка - 
// * ЗаголовокОперацииЭДООтЗаказчика - Строка - 
// * ЗаголовокОперацииЭДООтПолучателя - Строка - 
Функция ПараметрыОбновленияСоставаВидимойТаблицыПеречисления() Экспорт
	ПараметрыОбновления = Новый Структура;
	ПараметрыОбновления.Вставить("ПоказыватьОперацииОтЗаказчика", Ложь);
	ПараметрыОбновления.Вставить("ПоказыватьОперацииОтПолучателя", Ложь);
	ПараметрыОбновления.Вставить("ПоказыватьОперацииЭДООтЗаказчика", Ложь);
	ПараметрыОбновления.Вставить("ПоказыватьОперацииЭДООтПолучателя", Ложь);
	ПараметрыОбновления.Вставить("ЗаголовокОперацииОтЗаказчика", "");
	ПараметрыОбновления.Вставить("ЗаголовокОперацииОтПолучателя", "");
	ПараметрыОбновления.Вставить("ЗаголовокОперацииЭДООтЗаказчика", "");
	ПараметрыОбновления.Вставить("ЗаголовокОперацииЭДООтПолучателя", "");
	
	Возврат ПараметрыОбновления;
КонецФункции

// Обновить состав видимой таблицы перечисления.
// 
// Параметры:
//  Форма - см. Перечисление.ВидыОперацийВходящееИзвещение.Форма.ФормаВыбора
//        - см. Перечисление.ВидыОперацийИсходящееИзвещение.Форма.ФормаВыбора2
//  ПараметрыЗаполнения - см. ПараметрыОбновленияСоставаВидимойТаблицыПеречисления
Процедура ОбновитьСоставВидимойТаблицыПеречисления(Форма, ПараметрыЗаполнения) Экспорт
	Форма.Список.Очистить();
	
	КоличествоВидов = Число(ПараметрыЗаполнения.ПоказыватьОперацииОтЗаказчика)
		+ Число(ПараметрыЗаполнения.ПоказыватьОперацииОтПолучателя)
		+ Число(ПараметрыЗаполнения.ПоказыватьОперацииЭДООтЗаказчика)
		+ Число(ПараметрыЗаполнения.ПоказыватьОперацииЭДООтПолучателя);
	
	Если КоличествоВидов = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ОперацииОтОтправителя = ПараметрыЗаполнения.ПоказыватьОперацииОтЗаказчика
		Или ПараметрыЗаполнения.ПоказыватьОперацииЭДООтЗаказчика;
	ОперацииОтПолучателя = ПараметрыЗаполнения.ПоказыватьОперацииОтПолучателя
		Или ПараметрыЗаполнения.ПоказыватьОперацииЭДООтПолучателя;
	
	ИсходящиеОтЗаказчика = Новый Массив; // Массив из ДанныеФормыЭлементКоллекции
	ИсходящиеОтПолучателя = Новый Массив; // Массив из ДанныеФормыЭлементКоллекции
	ОтветныеОтЗаказчика = Новый Массив; // Массив из ДанныеФормыЭлементКоллекции
	ОтветныеОтПолучателя = Новый Массив; // Массив из ДанныеФормыЭлементКоллекции
	
	Для Каждого СтрокаВида Из Форма.СписокВсеВиды Цикл
		Если СтрокаВида.ДокументооборотОтОтправителя И ОперацииОтОтправителя Тогда
			Если СтрокаВида.КлассическийДО И ПараметрыЗаполнения.ПоказыватьОперацииОтЗаказчика Тогда
				ИсходящиеОтЗаказчика.Добавить(СтрокаВида);
			КонецЕсли;
			Если СтрокаВида.ЭДО И ПараметрыЗаполнения.ПоказыватьОперацииЭДООтЗаказчика Тогда
				ОтветныеОтЗаказчика.Добавить(СтрокаВида);
			КонецЕсли;
		КонецЕсли;
		Если СтрокаВида.ДокументооборотОтПолучателя И ОперацииОтПолучателя Тогда
			Если СтрокаВида.КлассическийДО И ПараметрыЗаполнения.ПоказыватьОперацииОтПолучателя Тогда
				ИсходящиеОтПолучателя.Добавить(СтрокаВида);
			КонецЕсли;
			Если СтрокаВида.ЭДО И ПараметрыЗаполнения.ПоказыватьОперацииЭДООтПолучателя Тогда
				ОтветныеОтПолучателя.Добавить(СтрокаВида);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ВывестиСтрокиВСписок(Форма.Список, ИсходящиеОтЗаказчика, ПараметрыЗаполнения.ЗаголовокОперацииОтЗаказчика);
	ВывестиСтрокиВСписок(Форма.Список, ИсходящиеОтПолучателя, ПараметрыЗаполнения.ЗаголовокОперацииОтПолучателя);
	ВывестиСтрокиВСписок(Форма.Список, ОтветныеОтЗаказчика, ПараметрыЗаполнения.ЗаголовокОперацииЭДООтЗаказчика);
	ВывестиСтрокиВСписок(Форма.Список, ОтветныеОтПолучателя, ПараметрыЗаполнения.ЗаголовокОперацииЭДООтПолучателя);

	Возврат;

	Форма.Список.Очистить();
	
	КоличествоВидов = Число(ПараметрыЗаполнения.ПоказыватьОперацииОтЗаказчика)
		+ Число(ПараметрыЗаполнения.ПоказыватьОперацииОтПолучателя)
		+ Число(ПараметрыЗаполнения.ПоказыватьОперацииЭДООтЗаказчика)
		+ Число(ПараметрыЗаполнения.ПоказыватьОперацииЭДООтПолучателя);
	
	Если КоличествоВидов = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ИсходящиеОтЗаказчика = Новый Массив; // Массив из ДанныеФормыЭлементКоллекции
	ИсходящиеОтПолучателя = Новый Массив; // Массив из ДанныеФормыЭлементКоллекции
	ОтветныеОтЗаказчика = Новый Массив; // Массив из ДанныеФормыЭлементКоллекции
	ОтветныеОтПолучателя = Новый Массив; // Массив из ДанныеФормыЭлементКоллекции
	
	Для Каждого СтрокаВида Из Форма.СписокВсеВиды Цикл
		Если СтрокаВида.ОтветноеИзвещение И СтрокаВида.ДокументооборотОтПолучателя Тогда
			Если ПараметрыЗаполнения.ПоказыватьОперацииЭДООтПолучателя Тогда
				ОтветныеОтПолучателя.Добавить(СтрокаВида);
			КонецЕсли;
		ИначеЕсли СтрокаВида.ОтветноеИзвещение И Не СтрокаВида.ДокументооборотОтПолучателя Тогда
			Если ПараметрыЗаполнения.ПоказыватьОперацииЭДООтЗаказчика Тогда
				ОтветныеОтЗаказчика.Добавить(СтрокаВида);
			КонецЕсли;
		ИначеЕсли Не СтрокаВида.ОтветноеИзвещение И СтрокаВида.ДокументооборотОтПолучателя Тогда
			Если ПараметрыЗаполнения.ПоказыватьОперацииОтПолучателя Тогда
				ИсходящиеОтПолучателя.Добавить(СтрокаВида);
			КонецЕсли;
		ИначеЕсли Не СтрокаВида.ОтветноеИзвещение И Не СтрокаВида.ДокументооборотОтПолучателя Тогда
			Если ПараметрыЗаполнения.ПоказыватьОперацииОтЗаказчика Тогда
				ИсходящиеОтЗаказчика.Добавить(СтрокаВида);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ВывестиСтрокиВСписок(Форма.Список, ИсходящиеОтЗаказчика, ПараметрыЗаполнения.ЗаголовокОперацииОтЗаказчика);
	ВывестиСтрокиВСписок(Форма.Список, ИсходящиеОтПолучателя, ПараметрыЗаполнения.ЗаголовокОперацииОтПолучателя);
	ВывестиСтрокиВСписок(Форма.Список, ОтветныеОтЗаказчика, ПараметрыЗаполнения.ЗаголовокОперацииЭДООтЗаказчика);
	ВывестиСтрокиВСписок(Форма.Список, ОтветныеОтПолучателя, ПараметрыЗаполнения.ЗаголовокОперацииЭДООтПолучателя);
КонецПроцедуры

Процедура ВывестиСтрокиВСписок(Список, МассивСтрок, ЗаголовокГруппы)
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(ЗаголовокГруппы) Тогда
		НоваяСтрока = Список.Добавить();
		НоваяСтрока.Представление = ЗаголовокГруппы;
		НоваяСтрока.Описание = ПустойHTMLДокумент();
	КонецЕсли;
	Для Каждого СтрокаВида Из МассивСтрок Цикл
		НоваяСтрока = Список.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаВида);
	КонецЦикла;
КонецПроцедуры

Функция ПустойHTMLДокумент()
	Возврат
	"<html>
	|<head></head>
	|<body>
	|</body>
	|</html>";
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Установить субконто в параметры из строки.
// 
// Параметры:
//  ПараметрыКЭК - см. БухгалтерскийУчетКлиентСервер.ПараметрыРасчетаКЭКПроводки
//  ТекущиеДанные - ДанныеФормыЭлементКоллекции
//  ДтКт - Строка
Процедура УстановитьСубконтоВПараметрыИзСтроки(ПараметрыКЭК, ТекущиеДанные, ДтКт)
	Для Номер = 1 По 3 Цикл
		ЗначениеСубконто = ТекущиеДанные["Субконто" + ДтКт + Номер]; // Характеристика.ВидыСубконто
		ПараметрыКЭК["Субконто" + Номер] = ЗначениеСубконто;
	КонецЦикла;
КонецПроцедуры

// Допустимые корреспонденции по виду извещения.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения:
//   * Объект - ДанныеФормыСтруктураСКоллекцией
//   * ВсеДопустимыеКорреспонденции - см. ЦентрализованноеСнабжениеКлиентСервер.ПустаяДопустимаяКорреспонденция
// 
// Возвращаемое значение:
// см. ПустаяДопустимаяКорреспонденция
Функция ДопустимыеКорреспонденцииДокумента(Форма)
	ДопустимыеКорреспонденции = Форма.ВсеДопустимыеКорреспонденции;
	Возврат ДопустимыеКорреспонденции;
КонецФункции

Процедура УстановитьЗначенияСубконтоДтКт_ПроверитьПараметры(Параметры)
	ОбязательныеКлючиЕсть = Параметры.Свойство("КонтрагентДт")
		И Параметры.Свойство("ДоговорДт")
		И Параметры.Свойство("КонтрагентКт")
		И Параметры.Свойство("ДоговорКт")
		И Параметры.Свойство("ДтКт");
	Если Не ОбязательныеКлючиЕсть Тогда
		ВызватьИсключение "В параметрах процедуры ЦентрализованноеСнабжениеКлиентСервер.УстановитьЗначенияСубконтоВСтроке заданы не все обязательные ключи.
		|	Обязательные ключи описаны в функции ЦентрализованноеСнабжениеКлиентСервер.УстановитьЗначенияСубконтоДтКт_Параметры";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметры.ДтКт) Тогда
		ДтКт = ВРЕГ(Параметры.ДтКт);
		Если ДтКт <> "ДТ" И ДтКт <> "КТ" Тогда
			ВызватьИсключение "В параметрах процедуры ЦентрализованноеСнабжениеКлиентСервер.УстановитьЗначенияСубконтоВСтроке не правильно заполнен параметр ДтКт";
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Установить значения субконто дт кт.
// 
// Параметры:
//  Строка - ДанныеФормыЭлементКоллекции - Строка
//  Параметры - Структура:
//  ДтКт - Строка - Дт кт
//  ДопустимыеКорреспонденции - см. ПустаяДопустимаяКорреспонденция
Процедура УстановитьЗначенияСубконтоДтКт(Строка, Параметры, ДтКт, ДопустимыеКорреспонденции)
	Счет = Строка["Счет" + ДтКт]; // ПланСчетовСсылка.ЕПСБУ
	СвойстваСчета = Параметры.СвойстваСчетов.Получить(Счет); // см. СтруктураСвойствСчета
	Если СвойстваСчета = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОчищатьДоговор = Ложь;
	Если СвойстваСчета.НомерСубконтоКонтрагенты > 0 И ЗначениеЗаполнено(Параметры["Контрагент" + ДтКт]) Тогда
		Строка["Субконто" + ДтКт + СвойстваСчета.НомерСубконтоКонтрагенты] = Параметры["Контрагент" + ДтКт];
		ОчищатьДоговор = Истина;
		Если Параметры.Объект <> Неопределено Тогда
			УстановитьДетальныйКЭКВСтрокеДокумента(Параметры.Объект, Строка, ДтКт);
		КонецЕсли;
	КонецЕсли;
	Если СвойстваСчета.НомерСубконтоДоговоры > 0 И (ЗначениеЗаполнено(Параметры["Договор" + ДтКт]) Или ОчищатьДоговор) Тогда
		Строка["Субконто" + ДтКт + СвойстваСчета.НомерСубконтоДоговоры] = Параметры["Договор" + ДтКт];
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
