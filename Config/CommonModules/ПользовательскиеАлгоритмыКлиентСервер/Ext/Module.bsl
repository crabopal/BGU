
////////////////////////////////////////////////////////////////////////////////
// ПРОГРАММНЫЙ ИНТЕРФЕЙС

Процедура ОбновитьОтображениеТекстаПроцедуры(Знач ЭтаФорма, Знач РедактируемыеПроцедуры, Знач ИдентификаторТекущейПроцедуры) Экспорт 

	// Настройка отображения списка выбора процедур
	ОбновитьСписокВыбора(ЭтаФорма.Объект.Ссылка, ЭтаФорма.Элементы.ТекущаяПроцедура, РедактируемыеПроцедуры);
	
	// Установка значения текущей процедуры
	Если ЗначениеЗаполнено(ИдентификаторТекущейПроцедуры) Тогда
		
		СтрокаТекПроцедуры = НайтиЗаписьОРедактируемойПроцедуре(РедактируемыеПроцедуры, ИдентификаторТекущейПроцедуры);
		
		Если СтрокаТекПроцедуры <> Неопределено Тогда
		
			ЭтаФорма.ТекущаяПроцедура = ИдентификаторТекущейПроцедуры;
			
			Если Не СтрокаТекПроцедуры.Загружена Тогда
				СтрокаТекПроцедуры.ТекстПроцедуры = ПользовательскиеАлгоритмыВызовСервера.ПолучитьТекстПроцедуры(ЭтаФорма.Объект.Ссылка, СтрокаТекПроцедуры.ИмяПроцедуры);
				СтрокаТекПроцедуры.Загружена      = Истина;
			КонецЕсли;
			
			ЭтаФорма.ТекстПроцедуры.УстановитьТекст(СтрокаТекПроцедуры.ТекстПроцедуры);
			ЭтаФорма.Элементы.ТекстПроцедуры.ТолькоПросмотр = Ложь;
			
		Иначе
			
			ЭтаФорма.ТекстПроцедуры.УстановитьТекст("");
			ЭтаФорма.Элементы.ТекстПроцедуры.ТолькоПросмотр = Истина;
			
		КонецЕсли;
		
	ИначеЕсли НайтиЗаписьОРедактируемойПроцедуре(РедактируемыеПроцедуры, ИдентификаторТекущейПроцедуры) = Неопределено Тогда
		
		ЭтаФорма.ТекстПроцедуры.УстановитьТекст("");
		ЭтаФорма.Элементы.ТекстПроцедуры.ТолькоПросмотр = Истина;
		
	КонецЕсли;

КонецПроцедуры

Процедура СохранитьТекущиеДанные(Знач ЭтаФорма) Экспорт 

	ИДПроцедуры = ЭтаФорма.ТекущаяПроцедура;
	
	Если ЗначениеЗаполнено(ИДПроцедуры) Тогда
		
		СтрРедактируемых = НайтиЗаписьОРедактируемойПроцедуре(ЭтаФорма.ТаблицаРедактированияПроцедур, ИДПроцедуры);		
		
		Если Не СтрРедактируемых = Неопределено Тогда
			СтрРедактируемых.ТекстПроцедуры = ЭтаФорма.ТекстПроцедуры.ПолучитьТекст();
			СтрРедактируемых.Загружена      = Истина;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Функция НайтиЗаписьОРедактируемойПроцедуре(РедактируемыеПроцедуры, ИДПроцедуры) Экспорт 

	СтрокиПроцедур = РедактируемыеПроцедуры.НайтиСтроки(Новый Структура("Идентификатор", ИДПроцедуры));
	
	Если СтрокиПроцедур.Количество() Тогда
		Возврат СтрокиПроцедур[0];
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции // НайтиЗаписьОРедактируемойПроцедуре()

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

Процедура ОбновитьСписокВыбора(Модуль, ПолеВыбораПроцедуры, РедактируемыеПроцедуры) 
	
	СписокВыбора = Новый СписокЗначений;

	Для Каждого СтрРедактируемых Из РедактируемыеПроцедуры Цикл
		СписокВыбора.Добавить(СтрРедактируемых.Идентификатор,СтрРедактируемых.ИмяПроцедуры,,БиблиотекаКартинок.Процедура);
	КонецЦикла;
	
	СписокВыбора = ПользовательскиеАлгоритмыВызовСервера.ДобавитьВСписокСобытия(Модуль,СписокВыбора);
	
	ПолеВыбораПроцедуры.СписокВыбора.Очистить();
	ОбщегоНазначенияКлиентСервер.ЗаполнитьКоллекциюСвойств(СписокВыбора, ПолеВыбораПроцедуры.СписокВыбора);
	

КонецПроцедуры 