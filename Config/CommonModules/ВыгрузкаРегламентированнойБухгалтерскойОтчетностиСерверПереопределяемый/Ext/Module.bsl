Функция ПолучитьСписокПредустановленныхОбработокФорматовВыгрузки() Экспорт 
	
	МенеджерСправочника = Справочники.ФорматыВыгрузкиБухгалтерскойОтчетности;
	
	Результат = Новый Соответствие;
		

	Результат.Вставить(МенеджерСправочника.СводОтчетов_1_11,				"ВыгрузкаСводОтчетов110");
	Результат.Вставить(МенеджерСправочника.СводОтчетов_2_0,					"ВыгрузкаСводОтчетов20");
	Результат.Вставить(МенеджерСправочника.ДепартаментФинансовМосквы,		"ВыгрузкаГРБСМосквы");
	Результат.Вставить(МенеджерСправочника.ФК_ГРБС_4_4,						"ВыгрузкаВФорматеФК_4_4");
	Результат.Вставить(МенеджерСправочника.ФК_ГРБС_4_5,						"ВыгрузкаВФорматеФК_4_5");
	Результат.Вставить(МенеджерСправочника.ФК_ГРБС_4_8,						"ВыгрузкаВФорматеФК_4_8");
	Результат.Вставить(МенеджерСправочника.ФК_ГРБС_4_9,						"ВыгрузкаВФорматеФК_4_9");
	Результат.Вставить(МенеджерСправочника.ФК_ФО_3_0_21,					"ВыгрузкаВФорматеФК_3_0_21");
	Результат.Вставить(МенеджерСправочника.ФК_АУБУ_4_0,						"ВыгрузкаАУиБУвФорматеФК_4_0");
	Результат.Вставить(МенеджерСправочника.ФК_АУБУ_5_0,						"ВыгрузкаАУиБУвФорматеФК_5_0");
	Результат.Вставить(МенеджерСправочника.ФК_АУБУ_6_0,						"ВыгрузкаАУиБУвФорматеФК_6_0");
	Результат.Вставить(МенеджерСправочника.МинфинФорма14,					"ВыгрузкаФормы14Минфин");
	Результат.Вставить(МенеджерСправочника.ИсполнениеСудебныхРешений,		"ВыгрузкаСведенияОбИсполненииСудебныхРешений");
	Результат.Вставить(МенеджерСправочника.ОтчетностьФНС_5_0,				"ВыгрузкаОтчетностиДляФНС");
	Результат.Вставить(МенеджерСправочника.bus_gov_ru_1_7_8,				"ВыгрузкаОтчетности_BusGovRu_1_7_8");
	Результат.Вставить(МенеджерСправочника.ВыгрузкаВФорматеСводСмарт,		"ВыгрузкаВФорматеСводСмарт");

	Возврат Результат; 
	
КонецФункции	

Функция ПолучитьИнформациюОПредставителеВИФНС(Организация) Экспорт 
	
	Результат = Новый Структура;
	Результат.Вставить("Тип","");
	Результат.Вставить("Фамилия","");
	Результат.Вставить("Имя","");
	Результат.Вставить("Отчество","");
	Результат.Вставить("Телефон","");
	Результат.Вставить("Документ","");
	
	Если Не ЗначениеЗаполнено(Организация) Тогда 
		Возврат Результат;
	КонецЕсли;	
	
	Попытка
		ТекущийПользователь = Пользователи.ТекущийПользователь();
	Исключение
	    ТекущийПользователь = Неопределено;//может быть исключение, если внешний пользователь, игнорируем
	КонецПопытки;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка",Организация);
	Запрос.УстановитьПараметр("ТекущийПользователь",ТекущийПользователь);
	Запрос.Текст =	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Организации.РегистрацияВНалоговомОргане КАК РегистрацияВНалоговомОргане,
	|	ЕСТЬNULL(РегистрацииВНалоговомОрганеПодписанты.Доверенность, Организации.РегистрацияВНалоговомОргане.Доверенность) КАК Доверенность,
	|	ЕСТЬNULL(РегистрацииВНалоговомОрганеПодписанты.ДокументПредставителя, Организации.РегистрацияВНалоговомОргане.ДокументПредставителя) КАК ДокументПредставителя,
	|	ЕСТЬNULL(РегистрацииВНалоговомОрганеПодписанты.Представитель, Организации.РегистрацияВНалоговомОргане.Представитель) КАК Представитель,
	|	ЕСТЬNULL(РегистрацииВНалоговомОрганеПодписанты.УполномоченноеЛицоПредставителя, Организации.РегистрацияВНалоговомОргане.УполномоченноеЛицоПредставителя) КАК УполномоченноеЛицоПредставителя
	|ПОМЕСТИТЬ НастройкиПодписантов
	|ИЗ
	|	Справочник.Организации КАК Организации
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РегистрацииВНалоговомОргане.Подписанты КАК РегистрацииВНалоговомОрганеПодписанты
	|		ПО Организации.РегистрацияВНалоговомОргане = РегистрацииВНалоговомОрганеПодписанты.Ссылка
	|			И (РегистрацииВНалоговомОрганеПодписанты.Пользователь = &ТекущийПользователь)
	|ГДЕ
	|	Организации.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА НастройкиПодписантов.Представитель В (НЕОПРЕДЕЛЕНО, ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка), ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
	|			ТОГДА ""Руководитель""
	|		ИНАЧЕ ""Представитель""
	|	КОНЕЦ КАК Тип,
	|	ВЫБОР
	|		КОГДА НастройкиПодписантов.Представитель В (НЕОПРЕДЕЛЕНО, ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка), ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
	|			ТОГДА """"
	|		КОГДА НастройкиПодписантов.Представитель ССЫЛКА Справочник.ФизическиеЛица
	|				И НастройкиПодписантов.Представитель <> ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
	|			ТОГДА ВЫРАЗИТЬ(НастройкиПодписантов.Представитель КАК Справочник.ФизическиеЛица).Наименование
	|		КОГДА НастройкиПодписантов.Представитель ССЫЛКА Справочник.Контрагенты
	|				И НастройкиПодписантов.Представитель <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			ТОГДА НастройкиПодписантов.УполномоченноеЛицоПредставителя
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ФИОПредставителя,
	|	ВЫБОР
	|		КОГДА НастройкиПодписантов.Представитель В (НЕОПРЕДЕЛЕНО, ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка), ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
	|			ТОГДА """"
	|		ИНАЧЕ НастройкиПодписантов.ДокументПредставителя
	|	КОНЕЦ КАК ДокументПредставителя
	|ИЗ
	|	НастройкиПодписантов КАК НастройкиПодписантов";
		
	ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	
	Если ТаблицаРезультат.Количество()=0 Тогда 
		ВызватьИсключение НСтр("ru = 'Для организации отчета не задан налоговый орган. Для получения данных о представителе в ИФНС требуется указать налоговый орган.'");
	КонецЕсли;	
	
	ДанныеПредставителя = ТаблицаРезультат[0];
	
	Если ДанныеПредставителя.Тип = "Руководитель" Тогда 
		
		Руководитель = БюджетнаяОтчетностьПолучениеНСИ.ОтветственноеЛицоОрганизации(Организация,"Руководитель");
		
		Результат.Тип = "Руководитель";
		ДанныеФИО = Справочники.Сотрудники.ПолучитьДанныеСотрудников(Руководитель,"Фамилия,Имя,Отчество");
		Если ДанныеФИО.Количество()>0 Тогда
			ЗаполнитьЗначенияСвойств(Результат,ДанныеФИО[0]);
		Иначе	
			ЗаполнитьЗначенияСвойств(Результат,БюджетнаяОтчетностьКлиентСервер.РазобратьСтрокуФИОНаСоставляющие(Руководитель.Наименование));
		КонецЕсли;
		
		Результат.Телефон = Справочники.Контрагенты.ПолучитьКонтактнуюИнформацию(Руководитель.Контрагент,Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагенты);
		Результат.Документ = "";
		
	Иначе 
		
		Результат.Тип = "Представитель";
		ЗаполнитьЗначенияСвойств(Результат,БюджетнаяОтчетностьКлиентСервер.РазобратьСтрокуФИОНаСоставляющие(ДанныеПредставителя.ФИОПредставителя));
		Результат.Телефон = "";
		Результат.Документ = ДанныеПредставителя.ДокументПредставителя;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции	


