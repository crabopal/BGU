
#Область ПрограммныйИнтерфейс

Функция ПолучитьДоступныеОбновления(НеОтбирать = Ложь) Экспорт
	
	ОтображениеПоставляемыхДанных = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("ПоставляемыеДанные", "ОтображениеПоставляемыхДанных");
	
	Если НеОтбирать Или ТипЗнч(ОтображениеПоставляемыхДанных)<>Тип("СписокЗначений") Тогда
		ОтображениеПоставляемыхДанных = Новый СписокЗначений;
	КонецЕсли;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ПоставляемыеДанные.Ссылка КАК Ссылка,
	|	ПоставляемыеДанные.ВидДанных КАК ВидДанных,
	|	ПоставляемыеДанные.ДатаДобавления КАК ДатаДобавления,
	|	ПоставляемыеДанные.ИдентификаторФайла КАК ИдентификаторФайла,
	|	ПоставляемыеДанныеПредставление.Значение КАК Наименование,
	|	ЕСТЬNULL(ПоставляемыеДанныеОписаниеДанных.Значение, """") КАК ПодробноеОписаниеДанных
	|ПОМЕСТИТЬ ВсеОбновления
	|ИЗ
	|	Справочник.ПоставляемыеДанные КАК ПоставляемыеДанные
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПоставляемыеДанные.ХарактеристикиДанных КАК ПоставляемыеДанныеПредставление
	|		ПО (ПоставляемыеДанныеПредставление.Ссылка = ПоставляемыеДанные.Ссылка)
	|			И (ПоставляемыеДанныеПредставление.Характеристика = ""Представление""
	|				ИЛИ ПоставляемыеДанныеПредставление.Характеристика = ""Наименование"")
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПоставляемыеДанные.ХарактеристикиДанных КАК ПоставляемыеДанныеОписаниеДанных
	|		ПО (ПоставляемыеДанныеОписаниеДанных.Ссылка = ПоставляемыеДанные.Ссылка)
	|			И (ПоставляемыеДанныеОписаниеДанных.Характеристика = ""ОписаниеДанных""
	|				ИЛИ ПоставляемыеДанныеОписаниеДанных.Характеристика = ""ОписаниеВерсии"")
	|ГДЕ
	|	НЕ ПоставляемыеДанные.Ссылка В (&ВидыДанных)
	|	И НЕ (ВЫРАЗИТЬ(ПоставляемыеДанныеПредставление.Значение КАК СТРОКА(9))) = ""Календари""
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОбновленияПоставляемыхДанныхБГУ.ПоставляемыеДанные.Ссылка КАК ПоставляемыеДанныеСсылка,
	|	ОбновленияПоставляемыхДанныхБГУ.ИдентификаторФайла КАК ИдентификаторФайла,
	|	ОбновленияПоставляемыхДанныхБГУ.ДатаЗагрузки КАК ДатаЗагрузки
	|ПОМЕСТИТЬ ОбновленияТекущейОбласти
	|ИЗ
	|	РегистрСведений.ОбновленияПоставляемыхДанныхБГУ КАК ОбновленияПоставляемыхДанныхБГУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ВсеОбновления.ИдентификаторФайла = ОбновленияТекущейОбласти.ИдентификаторФайла
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ФайлИзменен,
	|	ВсеОбновления.ИдентификаторФайла КАК ИдентификаторФайла,
	|	ВсеОбновления.Ссылка КАК ПоставляемыеДанныеСсылка,
	|	ВсеОбновления.Наименование КАК НаименованиеДанных,
	|	ВсеОбновления.ПодробноеОписаниеДанных КАК ПодробноеОписаниеДанных,
	|	ВсеОбновления.ДатаДобавления КАК ДатаДобавления,
	|	ВсеОбновления.ВидДанных КАК ВидДанных,
	|	ЕСТЬNULL(ОбновленияТекущейОбласти.ДатаЗагрузки, ""НОВОЕ!"") КАК ДатаЗагрузки
	|ИЗ
	|	ВсеОбновления КАК ВсеОбновления
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОбновленияТекущейОбласти КАК ОбновленияТекущейОбласти
	|		ПО ВсеОбновления.Ссылка = ОбновленияТекущейОбласти.ПоставляемыеДанныеСсылка
	|ГДЕ
	|	НЕ ВсеОбновления.Наименование ЕСТЬ NULL
	|
	|УПОРЯДОЧИТЬ ПО
	|	ФайлИзменен УБЫВ,
	|	ДатаЗагрузки УБЫВ,
	|	ДатаДобавления УБЫВ");
	
	Запрос.УстановитьПараметр("ВидыДанных", ОтображениеПоставляемыхДанных.ВыгрузитьЗначения());

	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции	

Процедура СформироватьЭлементыФормыДляОбновления(СтрокаОбновления, Элементы) Экспорт
	
	// Группа для вида данных
	ЭлементГруппа = Элементы.Найти("Обновление" + СтрокаОбновления.НомерСтроки);
	Если ЭлементГруппа = Неопределено Тогда
		ЭлементГруппа = Элементы.Добавить("Обновление" + СтрокаОбновления.НомерСтроки, Тип("ГруппаФормы"), Элементы.СписокОбновлений);
	КонецЕсли;	
	ЭлементГруппа.Вид 						= ВидГруппыФормы.ОбычнаяГруппа;
	ЭлементГруппа.РастягиватьПоГоризонтали 	= Истина;
	ЭлементГруппа.Отображение 				= ОтображениеОбычнойГруппы.СлабоеВыделение;
	ЭлементГруппа.ОтображатьЗаголовок 		= Ложь;
	
	// Группа описания вида данных
	ЭлементГруппаОписанияДанных = Элементы.Найти("ОписаниеДанных" + СтрокаОбновления.НомерСтроки);
	Если ЭлементГруппаОписанияДанных = Неопределено Тогда
		ЭлементГруппаОписанияДанных = Элементы.Добавить("ОписаниеДанных" + СтрокаОбновления.НомерСтроки, Тип("ГруппаФормы"), ЭлементГруппа);
	КонецЕсли;
	ЭлементГруппаОписанияДанных.Вид 				= ВидГруппыФормы.ОбычнаяГруппа;
	ЭлементГруппаОписанияДанных.Отображение 		= ОтображениеОбычнойГруппы.Нет;
	ЭлементГруппаОписанияДанных.Группировка 		= ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
	ЭлементГруппаОписанияДанных.ОтображатьЗаголовок = Ложь;
	
		
	ЭлементОписание = Элементы.Найти("ЭлементОписание" + СтрокаОбновления.НомерСтроки);
	Если ЭлементОписание = Неопределено Тогда
		ЭлементОписание = Элементы.Добавить("ЭлементОписание" + СтрокаОбновления.НомерСтроки, Тип("ДекорацияФормы"), ЭлементГруппаОписанияДанных);
	КонецЕсли;	
	ЭлементОписание.Вид 						= ВидДекорацииФормы.Надпись;
	ЭлементОписание.Заголовок 					= СтрокаОбновления.НаименованиеДанных;
	ЭлементОписание.Гиперссылка 				= Истина;
	ЭлементОписание.РастягиватьПоГоризонтали 	= Истина;
	ЭлементОписание.Высота 						= 2;
	ЭлементОписание.УстановитьДействие("Нажатие", "Подключаемый_ПерейтиКПодробномуОписанию");
	
	
	КнопкаЗагрузки = Элементы.Найти("КнопкаЗагрузки" + СтрокаОбновления.НомерСтроки);
	Если КнопкаЗагрузки = Неопределено Тогда 
		КнопкаЗагрузки = Элементы.Добавить("КнопкаЗагрузки" + СтрокаОбновления.НомерСтроки, Тип("КнопкаФормы"), ЭлементГруппаОписанияДанных);
	КонецЕсли;
	КнопкаЗагрузки.ИмяКоманды 	= "ЗагрузитьДанные";
	КнопкаЗагрузки.Отображение 	= ОтображениеКнопки.КартинкаИТекст;
	КнопкаЗагрузки.Вид 			= ВидКнопкиФормы.ОбычнаяКнопка;
	КнопкаЗагрузки.Высота		= 2;
	КнопкаЗагрузки.ЦветФона		= WebЦвета.Пшеничный;
	
	
	КартинкаСтатуса = Элементы.Найти("КартинкаСтатуса" + СтрокаОбновления.НомерСтроки);
	Если КартинкаСтатуса = Неопределено Тогда
		КартинкаСтатуса = Элементы.Добавить("КартинкаСтатуса" + СтрокаОбновления.НомерСтроки, Тип("ДекорацияФормы"), ЭлементГруппаОписанияДанных);
	КонецЕсли;	
	КартинкаСтатуса.Вид = ВидДекорацииФормы.Картинка;
	КартинкаСтатуса.Высота = 2;
	
	Если СтрокаОбновления.ДатаЗагрузки = "НОВОЕ!" Тогда
		КартинкаСтатуса.Вид 		= ВидДекорацииФормы.Картинка;
		КартинкаСтатуса.Картинка 	= БиблиотекаКартинок.Новое;
	ИначеЕсли СтрокаОбновления.ФайлИзменен Тогда
		КартинкаСтатуса.Вид 		= ВидДекорацииФормы.Картинка;
		КартинкаСтатуса.Картинка 	= БиблиотекаКартинок.Обновлено;
	Иначе
		КартинкаСтатуса.Вид 		= ВидДекорацииФормы.Надпись;
		КартинкаСтатуса.Заголовок 	= "Загружено " + Формат(Дата(СтрокаОбновления.ДатаЗагрузки), "ДФ=dd.MM.yyyy");
	КонецЕсли;				
	
	
	СтрокаОбновления.ИмяЭлементаОписания 	= ЭлементОписание.Имя;
	СтрокаОбновления.ИмяКнопкиЗагрузки 		= КнопкаЗагрузки.Имя;
	
КонецПроцедуры	

Процедура УстановитьИнформациюОбОбновлении(ЭлементПоставляемыхДанных, Форма) Экспорт
		
	МассивСсылок = Форма.Объект.Обновления.НайтиСтроки(Новый Структура("ПоставляемыеДанныеСсылка", ЭлементПоставляемыхДанных));
	Если МассивСсылок.Количество() = 0 Тогда 
		Возврат;
	КонецЕсли;
	
	ОбновляемаяСтрока = МассивСсылок[0];
	ДатаЗагрузки = Неопределено;
	
	Если ОтметитьУстановкуОбновления(ЭлементПоставляемыхДанных,ОбновляемаяСтрока.ДатаЗагрузки) = Ложь Тогда
		Возврат;
	КонецЕсли;
		
	ОбновляемаяСтрока.ФайлИзменен = Ложь;
	
	СформироватьЭлементыФормыДляОбновления(ОбновляемаяСтрока, Форма.Элементы);
	
КонецПроцедуры

Функция ОтметитьУстановкуОбновления(ЭлементПоставляемыхДанных,ДатаЗагрузки=Неопределено) Экспорт
	
	НаборЗаписей = РегистрыСведений.ОбновленияПоставляемыхДанныхБГУ.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ПоставляемыеДанные.Установить(ЭлементПоставляемыхДанных);
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() = 0 Тогда
		МенеджерЗаписи = НаборЗаписей.Добавить();
		МенеджерЗаписи.ПоставляемыеДанные = ЭлементПоставляемыхДанных;
	Иначе
		МенеджерЗаписи = НаборЗаписей.Получить(0);
	КонецЕсли;
	
	МенеджерЗаписи.ИдентификаторФайла 	= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭлементПоставляемыхДанных, "ИдентификаторФайла").ИдентификаторФайла;
	МенеджерЗаписи.ДатаЗагрузки 		= ТекущаяДатаСеанса();
	
	ДатаЗагрузки      = МенеджерЗаписи.ДатаЗагрузки;
	
	Попытка
		НаборЗаписей.Записать();
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции


Процедура ПараметрыЗагрузкиБюджетнойКлассификации(Отказ, Форма) Экспорт
	
	// бюджетные классификаторы
	
	Параметры = Форма.Параметры;
	
	ИсточникДанных 	= Неопределено;
	
	Если Параметры.Свойство("ПоставляемыеДанныеСсылка", ИсточникДанных) Тогда
		
		
		ДиспетчерОбновлений = Форма.РеквизитФормыВЗначение("Объект");
		
		Форма.АдресВременногоХранилища = ПоместитьВоВременноеХранилище(ПоставляемыеДанные.ПоставляемыеДанныеИзКэша(ИсточникДанных), Форма.УникальныйИдентификатор);

		ДиспетчерОбновлений.ПрочитатьФайлПакета(Форма.АдресВременногоХранилища);

		ДеревоДоступныхОбновлений = ДиспетчерОбновлений.СформироватьДеревоДоступныхОбновлений();
		Форма.ЗначениеВРеквизитФормы(ДеревоДоступныхОбновлений, "ДоступныеОбновления");
		Форма.ЗначениеВРеквизитФормы(ДиспетчерОбновлений, "Объект");
		
		Форма.ИсточникДанных = ИсточникДанных;
		Форма.НеВыбиратьФайлы = Истина;
		
	КонецЕсли;	
	
КонецПроцедуры	

Процедура ПараметрыЗагрузкиКомплектаОтчетности(Отказ, Форма) Экспорт
	
	Параметры = Форма.Параметры;
	
	ИсточникДанных 	= Неопределено;
	
	Если Параметры.Свойство("ПоставляемыеДанныеСсылка", ИсточникДанных) Тогда
		
		Форма.ИмяФайлаКомплектаОтчетности   = "supplied-data.repx";
		Форма.АдресФайлаКомплектаОтчетности = ПоместитьВоВременноеХранилище(ПоставляемыеДанные.ПоставляемыеДанныеИзКэша(ИсточникДанных), Форма.УникальныйИдентификатор);
		
		Форма.Объект.РазрешитьУдалениеОбъектов = Истина;
		
		Форма.ИсточникДанных = ИсточникДанных;
		Форма.НеВыбиратьФайлы = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПараметрыЗагрузкиФорматовОбменаБанкКазначейство(Отказ, Форма) Экспорт
	
	Параметры = Форма.Параметры;
	
	ИсточникДанных 	= Неопределено;
	
	Если Параметры.Свойство("ПоставляемыеДанныеСсылка", ИсточникДанных) Тогда
		
		ПараметрыДанных = ИсточникДанных.ХарактеристикиДанных;
				
		ДиспетчерОбновлений = Форма.РеквизитФормыВЗначение("Объект");
		НоваяСтрока = ДиспетчерОбновлений.ФайлыФорматов.Добавить();
        НоваяСтрока.Загружать 	= Истина;
        НоваяСтрока.Дата 		= ИсточникДанных.ДатаДобавления;
		ДиспетчерОбновлений.ДатаОбновления = ИсточникДанных.ДатаДобавления;
		
		Стр = ПараметрыДанных.НайтиСтроки(Новый Структура("Характеристика", "Идентификатор"));
		Если Стр.Количество() > 0 Тогда
        	НоваяСтрока.ИмяФайла = Стр[0].Значение;
			ДиспетчерОбновлений.Идентификатор = Стр[0].Значение;
		КонецЕсли;	
		
		Стр = ПараметрыДанных.НайтиСтроки(Новый Структура("Характеристика", "Представление"));
		Если Стр.Количество() > 0 Тогда
        	НоваяСтрока.Описание = Стр[0].Значение;
			ДиспетчерОбновлений.Комментарий = Стр[0].Значение;
		КонецЕсли;	
		
		НоваяСтрока.АдресФайлаВХранилище 	= ПоместитьВоВременноеХранилище(ПоставляемыеДанные.ПоставляемыеДанныеИзКэша(ИсточникДанных), Форма.УникальныйИдентификатор);
		
		Форма.ЗначениеВРеквизитФормы(ДиспетчерОбновлений, "Объект");
		
		Форма.ИсточникДанных = ИсточникДанных;
		Форма.НеВыбиратьФайлы = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗарегистрироватьОбработчикиПоставляемыхДанных(Обработчики) Экспорт
	
	Обработчик = Обработчики.Добавить();
	Обработчик.ВидДанных 		= "КомплектОтчГосУчр";
	Обработчик.КодОбработчика 	= "КомплектОтчГосУчр";
	Обработчик.Обработчик 		= ПоставляемыеДанныеБГУ;
	
	Обработчик = Обработчики.Добавить();
	Обработчик.ВидДанных 		= "ФорматБанкиКазна";
	Обработчик.КодОбработчика 	= "ФорматБанкиКазна";
	Обработчик.Обработчик 		= ПоставляемыеДанныеБГУ;
	
КонецПроцедуры	

// Вызывается при получении уведомления о новых данных.
// В теле следует проверить, необходимы ли эти данные приложению, 
// и если да - вызвать метод: 
// 
// ПоставляемыеФайлы.ЗагрузитьДанные(Дескриптор);
//
// Параметры:
//   Дескриптор   - ОбъектXDTO Дескриптор.
//
Процедура ДоступныНовыеДанные(Знач Дескриптор, Загружать) Экспорт
	
	Если  Дескриптор.DataType = "КомплектОтчГосУчр"
		ИЛИ Дескриптор.DataType = "ФорматБанкиКазна"

		Тогда
		
		Загружать = Истина;
		
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

// Вызывается после вызова ЗагрузитьДанные, позволяет разобрать данные.
//
// Параметры:
//   Дескриптор   - ОбъектXDTO Дескриптор.
//   ПутьКФайлу   - строка. Полное имя извлеченного файла. Файл будет автоматически удален 
//                  после завершения процедуры.
//
Процедура ОбработатьНовыеДанные(Дескриптор, ПутьКФайлу) Экспорт
	
	Если Дескриптор.DataType = "КомплектОтчГосУчр"
		ИЛИ Дескриптор.DataType = "ФорматБанкиКазна"
		Тогда
		
		ПоставляемыеДанные.СохранитьПоставляемыеДанныеВКэш(Дескриптор, ПутьКФайлу);
		
	КонецЕсли;
	
