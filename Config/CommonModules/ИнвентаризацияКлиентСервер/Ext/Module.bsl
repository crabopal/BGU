Процедура Редактирование0504087_РассчитатьФактическиеПоказатели(ФормаДокумента, ТекущиеДанные, ИмяИзмененногоПоля) Экспорт
	
	// Гр.7		=	Гр.5	х	Гр.6
	// Сумма		Цена		Количество
	
	ИменаКолонок = ФормаДокумента["КэшВариантФормированияОписи"]["ИменаКолонокЧисловыхПоказателей"];
	
	ИмяКоличествоФакт	= ИменаКолонок["КоличествоФакт"];
	ИмяСуммаФакт		= ИменаКолонок["СуммаФакт"];
	
	РассчитатьСумму = (ИмяИзмененногоПоля = ИмяКоличествоФакт ИЛИ ИмяИзмененногоПоля = "Цена");
	
	РассчитатьЦену = (ИмяИзмененногоПоля = ИмяСуммаФакт);
	
	Если РассчитатьСумму Тогда
		
		ТекущиеДанные[ИмяСуммаФакт] = ТекущиеДанные[ИмяКоличествоФакт] * ТекущиеДанные["Цена"];
		
	ИначеЕсли РассчитатьЦену Тогда
		
		Если ТекущиеДанные[ИмяКоличествоФакт] = 0 Тогда
			Цена = 0;
		Иначе
			Цена = ТекущиеДанные[ИмяСуммаФакт] / ТекущиеДанные[ИмяКоличествоФакт];
		КонецЕсли;
		
		ТекущиеДанные["Цена"] = Цена;
	КонецЕсли;
	
КонецПроцедуры

Процедура Редактирование0504087_РассчитатьРасхождениеВСтроке(ФормаДокумента, ТекущиеДанные, УстановитьЕстьОтклонения = Ложь) Экспорт
	
	// Предназначен для вызова в случае ВариантФормированияОписи = 1,2,3
	// 1. Опись с 2018 г. Счет в таблице (26 знаков)
	// 2. Опись с 2018 г. Счет в таблице (5 знаков)
	// 3. Опись с 2018 г. Счет в таблице (5 знаков). Одна строка - один объект
	
	ИменаКолонок = ФормаДокумента["КэшВариантФормированияОписи"]["ИменаКолонокЧисловыхПоказателей"];
	
	ИмяКоличествоУчет		= ИменаКолонок["КоличествоУчет"];
	ИмяКоличествоФакт		= ИменаКолонок["КоличествоФакт"];
	ИмяКоличествоИзлишек	= ИменаКолонок["КоличествоИзлишек"];
	ИмяКоличествоНедостача	= ИменаКолонок["КоличествоНедостача"];
	
	ИмяСуммаУчет			= ИменаКолонок["СуммаУчет"];
	ИмяСуммаФакт			= ИменаКолонок["СуммаФакт"];
	ИмяСуммаИзлишек			= ИменаКолонок["СуммаИзлишек"];
	ИмяСуммаНедостача		= ИменаКолонок["СуммаНедостача"];
	
	ДельтаКолво = ТекущиеДанные[ИмяКоличествоУчет] - ТекущиеДанные[ИмяКоличествоФакт];
	
	//
	// Недостача
	//
	ТекущиеДанные[ИмяКоличествоНедостача] = ?(ДельтаКолво>0, ДельтаКолво, 0);
	
	// Гр.14 = Гр.13 х (Гр.12 / Гр.11)
	Если ТекущиеДанные[ИмяКоличествоУчет] <> 0 Тогда
		
		Если ТекущиеДанные[ИмяКоличествоНедостача] = ТекущиеДанные[ИмяКоличествоУчет] Тогда
			// Отсутствует в полном количестве
			
			Сумма = ТекущиеДанные[ИмяСуммаУчет];
			
		Иначе
			
			Сумма = ТекущиеДанные[ИмяСуммаУчет] * ТекущиеДанные[ИмяКоличествоНедостача] / ТекущиеДанные[ИмяКоличествоУчет];
			
		КонецЕсли;
		
	Иначе
		
		Сумма = 0;
		
	КонецЕсли;
	
	ТекущиеДанные[ИмяСуммаНедостача] = Сумма;
	
	//
	// Излишек
	//
	ТекущиеДанные[ИмяКоличествоИзлишек] = ?(ДельтаКолво<0, -ДельтаКолво, 0);
	
	// Гр.16 = Гр.15 х Гр.5
	ТекущиеДанные[ИмяСуммаИзлишек] = ТекущиеДанные[ИмяКоличествоИзлишек] * ТекущиеДанные["Цена"];
	
	//
	// Не соответствует условиям актива
	//
	// Гр.18 = Гр.17 х (Гр.12 / Гр.11)
	Если ТекущиеДанные[ИмяКоличествоУчет] <> 0 Тогда
		
		Если ТекущиеДанные["КоличествоНеСоответствует"] = ТекущиеДанные[ИмяКоличествоУчет] Тогда
			// Не соответствует в полном количестве
			
			Сумма = ТекущиеДанные[ИмяСуммаУчет];
			
		Иначе
			
			Сумма = ТекущиеДанные[ИмяСуммаУчет] * ТекущиеДанные["КоличествоНеСоответствует"] / ТекущиеДанные[ИмяКоличествоУчет];
			
		КонецЕсли;
		
	Иначе
		
		Сумма = 0;
		
	КонецЕсли;
	
	ТекущиеДанные["СуммаНеСоответствует"] = Сумма;
	
	//
	// Есть отклонения
	//
	
	Если УстановитьЕстьОтклонения Тогда
		ТекущиеДанные["ЕстьОтклонения"] = (ДельтаКолво <> 0);
	КонецЕсли;
	
КонецПроцедуры

Процедура Редактирование0504087_ПересчитатьСтрокуИнвентаризацииОС(ТекущиеДанные, ТолькоСумму = Ложь) Экспорт
	
	// Предназначен для вызова в случае ВариантФормированияОписи = 0
	// 0. Опись до 2018 г.
	
	Если Не ТолькоСумму Тогда
		ТекущиеДанные.ЕстьОтклонения     = ТекущиеДанные.КоличествоФУ <> ТекущиеДанные.КоличествоБУ;
		ТекущиеДанные.КоличествоНедостач = ?(ТекущиеДанные.КоличествоБУ > ТекущиеДанные.КоличествоФУ,
		                                     ТекущиеДанные.КоличествоБУ - ТекущиеДанные.КоличествоФУ, 0);
		ТекущиеДанные.КоличествоИзлишков = ?(ТекущиеДанные.КоличествоФУ > ТекущиеДанные.КоличествоБУ,
		                                     ТекущиеДанные.КоличествоФУ - ТекущиеДанные.КоличествоБУ, 0);
	КонецЕсли;
	ТекущиеДанные.СуммаФУ       = ?(ТекущиеДанные.КоличествоФУ = ТекущиеДанные.КоличествоБУ,
	                                ТекущиеДанные.СуммаБУ, ТекущиеДанные.Цена * ТекущиеДанные.КоличествоФУ);
	ТекущиеДанные.СуммаНедостач = ?(ТекущиеДанные.КоличествоНедостач = ТекущиеДанные.КоличествоБУ,
	                                ТекущиеДанные.СуммаБУ, ТекущиеДанные.Цена * ТекущиеДанные.КоличествоНедостач);
	ТекущиеДанные.СуммаИзлишков = ТекущиеДанные.Цена * ТекущиеДанные.КоличествоИзлишков;

КонецПроцедуры

Функция НовыйПараметрыФормыГрупповогоФормированияОписей() Экспорт
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("ДокументСсылка", Неопределено);
	ПараметрыФормы.Вставить("ОтборМассивКодовФорм", Новый Массив());
	
	// Значение Неопределено означает применение сохраненной настройки формы.
	// Значения Истина или Ложь замещают собой сохраненную настройку формы.
	ПараметрыФормы.Вставить("ВыводитьТолькоФормируемыеКодыФорм", Неопределено);
	ПараметрыФормы.Вставить("ИскатьОписиПоПриказу52н", Неопределено);
	
	Возврат ПараметрыФормы;
	
КонецФункции

