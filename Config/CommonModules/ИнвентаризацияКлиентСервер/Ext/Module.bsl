Процедура ОбновитьПредставленияНомеровБСО(ТекДанные, ИмяПоляНомерНач, ИмяПоляНомерКон) Экспорт
	
	ПостфиксИмениПредставления = "Представление";
	
	ДлинаНомера = ТекДанные["ДлинаНомера"];
	
	// Представление "Номер начальный"
	ТекДанные[ИмяПоляНомерНач + ПостфиксИмениПредставления] = ИнвентаризацияКлиентСервер.ПолучитьПредставлениеНомераБСО(
		ТекДанные[ИмяПоляНомерНач],
		ДлинаНомера);
		
	// Представление "Номер конечный"
	ТекДанные[ИмяПоляНомерКон + ПостфиксИмениПредставления] = ИнвентаризацияКлиентСервер.ПолучитьПредставлениеНомераБСО(
		ТекДанные[ИмяПоляНомерКон],
		ДлинаНомера);
		
КонецПроцедуры

Функция ПолучитьПредставлениеНомераБСО(НомерЧисло, ДлинаПредставления, ИспользоватьДлинуПредставления = Истина) Экспорт
	
	Если НомерЧисло = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДлинаПредставления) Тогда
		ДлинаПредставления = ОбщегоНазначенияБГУКлиентСервер.МаксимальнаяДлинаНомераБСО();
	КонецЕсли;
	
	Возврат Формат(НомерЧисло, СтрШаблон("ЧЦ=%1;ЧВН=;ЧГ=0", ДлинаПредставления));
	
КонецФункции

Функция ПолучитьКодСтрокиПриложения(НомерСтрокиРаздела, ПорядковыйНомер) Экспорт
	
	Если Не ЗначениеЗаполнено(НомерСтрокиРаздела) И Не ЗначениеЗаполнено(ПорядковыйНомер) Тогда
		Возврат "";
		
	ИначеЕсли ПорядковыйНомер < 100 Тогда
		ПорядковыйНомерПредставление = Формат(ПорядковыйНомер, "ЧЦ=2;ЧВН=;ЧН='00';ЧГ=");
		
	Иначе
		ПорядковыйНомерПредставление = Формат(ПорядковыйНомер, "ЧГ=");
	КонецЕсли;
	
	Возврат СтрШаблон("%1.%2", Формат(НомерСтрокиРаздела, "ЧН='0';ЧГ="), ПорядковыйНомерПредставление);
	
КонецФункции

