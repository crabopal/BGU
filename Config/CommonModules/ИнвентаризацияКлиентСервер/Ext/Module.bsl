Процедура РассчитатьМодифицированностьВСтрокеТаблицы(СтрокаТаблицы, НастройкиДокумента, ИмяТаблицы, ТаблицаПредыдущегоДокумента = Неопределено) Экспорт
	
	Перем	СтрокаПредыдущегоДокумента,
			ПостфиксПредыдущий;
	
	ИмяКолонкиМодифицированность = "Модифицированность";
	
	ИменаПоказателей = НастройкиДокумента["Таблица" + ИмяТаблицы].Показатели.ИсточникМодифицированности;
	
	ПостфиксПредыдущий = НастройкиДокумента.ПостфиксыИменКолонокПоказателей.Предыдущий;
	
	НомерСтроки = СтрокаТаблицы.НомерСтроки;
	
	ПредыдущиеПоказателиПереданыВТаблице = (ТаблицаПредыдущегоДокумента <> Неопределено);
	
	Если ПредыдущиеПоказателиПереданыВТаблице Тогда
		ЭтоДобавленнаяСтрокаТекущегоДокумента = (НомерСтроки > ТаблицаПредыдущегоДокумента.Количество());
	Иначе
		ЭтоДобавленнаяСтрокаТекущегоДокумента = (НЕ СтрокаТаблицы["ЭтоСтрокаИсходногоРешения"] И НЕ СтрокаТаблицы["ЭтоДобавленнаяРанееСтрока"]);
	КонецЕсли;
	
	Если ЭтоДобавленнаяСтрокаТекущегоДокумента Тогда
		СтрокаТаблицы[ИмяКолонкиМодифицированность] = Истина;
		
		Возврат;
	КонецЕсли;
	
	Модифицированность = Ложь;
	
	Для Каждого ИмяПоказателя Из ИменаПоказателей Цикл
		Если ПредыдущиеПоказателиПереданыВТаблице Тогда
			СтрокаПредыдущегоДокумента = ТаблицаПредыдущегоДокумента[НомерСтроки - 1];
			
			ПредыдущееЗначение = СтрокаПредыдущегоДокумента[ИмяПоказателя];
		Иначе
			ПредыдущееЗначение = СтрокаТаблицы[ИмяПоказателя + ПостфиксПредыдущий];
		КонецЕсли;
		
		Если СтрокаТаблицы[ИмяПоказателя] <> ПредыдущееЗначение Тогда
			Модифицированность = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	СтрокаТаблицы[ИмяКолонкиМодифицированность] = Модифицированность;
	
КонецПроцедуры	

