Функция ПустаяТаблицаВыплатПодотчетнымЛицамИзКассы() Экспорт

	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	// Общие разрезы учета.
	ПустаяТаблица.Колонки.Добавить("КФО", 				Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС", 				Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("ПодразделениеСотр", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ПустаяТаблица.Колонки.Добавить("КЭК", 				Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	
	// Счет и аналитика учета расчетов с подотчетными лицами.
	ПустаяТаблица.Колонки.Добавить("КорСчет", 						Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("Контрагент", 					Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ПустаяТаблица.Колонки.Добавить("ОснованиеПринятияОбязательств", Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	
	// Суммы расчетов.
	ПустаяТаблица.Колонки.Добавить("Сумма", ОписаниеТипаСуммы);
	
	// Вспомогательные реквизиты.
	ПустаяТаблица.Колонки.Добавить("ДопКлассификация", 	Новый ОписаниеТипов("СправочникСсылка.ДополнительнаяБюджетнаяКлассификация"));
	ПустаяТаблица.Колонки.Добавить("КодМероприятия", 	Новый ОписаниеТипов("СправочникСсылка.Мероприятия"));
	ПустаяТаблица.Колонки.Добавить("КодЦели", 			Новый ОписаниеТипов("СправочникСсылка.ВидыЦелевыхСредств"));
	
	// Первичный документ
	ПустаяТаблица.Колонки.Добавить("ПервичныйДокументНомер", Новый ОписаниеТипов("Строка"));
	ПустаяТаблица.Колонки.Добавить("ПервичныйДокументДата", Новый ОписаниеТипов("Дата"));

	
	Возврат ПустаяТаблица;
	
КонецФункции

Функция ТаблицаВыплатПодотчетнымЛицамИзКассы(ВедомостьНаВыдачуПодотчетнымЛицам) Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ВедомостьНаВыдачуПодотчетнымЛицамРасшифровкаПлатежа.КорСчет КАК КорСчет,
	|	ВедомостьНаВыдачуПодотчетнымЛицамРасшифровкаПлатежа.КФО КАК КФО,
	|	ВедомостьНаВыдачуПодотчетнымЛицамРасшифровкаПлатежа.КПС КАК КПС,
	|	ВедомостьНаВыдачуПодотчетнымЛицамРасшифровкаПлатежа.КЭК КАК КЭК,
	|	ВедомостьНаВыдачуПодотчетнымЛицамРасшифровкаПлатежа.ПодразделениеСотр КАК ПодразделениеСотр,
	|	ВедомостьНаВыдачуПодотчетнымЛицамРасшифровкаПлатежа.Сотрудник.Контрагент КАК Контрагент,
	|	ВЫБОР
	|		КОГДА НЕ ВЫРАЗИТЬ(ВедомостьНаВыдачуПодотчетнымЛицамРасшифровкаПлатежа.ДокументОснование КАК Документ.ЗаявлениеНаВыдачуАванса) ЕСТЬ NULL
	|			ТОГДА ВЫРАЗИТЬ(ВедомостьНаВыдачуПодотчетнымЛицамРасшифровкаПлатежа.ДокументОснование КАК Документ.ЗаявлениеНаВыдачуАванса).ОснованиеПринятияОбязательства
	|		КОГДА НЕ ВЫРАЗИТЬ(ВедомостьНаВыдачуПодотчетнымЛицамРасшифровкаПлатежа.ДокументОснование КАК Документ.РешениеОКомандировании) ЕСТЬ NULL
	|			ТОГДА ВЫРАЗИТЬ(ВедомостьНаВыдачуПодотчетнымЛицамРасшифровкаПлатежа.ДокументОснование КАК Документ.РешениеОКомандировании).ОснованиеПринятияОбязательства
	|		КОГДА НЕ ВЫРАЗИТЬ(ВедомостьНаВыдачуПодотчетнымЛицамРасшифровкаПлатежа.ДокументОснование КАК Документ.ЗаявкаОбоснованиеЗакупкиМалогоОбъема) ЕСТЬ NULL
	|			ТОГДА ВЫРАЗИТЬ(ВедомостьНаВыдачуПодотчетнымЛицамРасшифровкаПлатежа.ДокументОснование КАК Документ.ЗаявкаОбоснованиеЗакупкиМалогоОбъема).Договор
	|		КОГДА НЕ ВЫРАЗИТЬ(ВедомостьНаВыдачуПодотчетнымЛицамРасшифровкаПлатежа.ДокументОснование КАК Документ.ЗаявкаОбоснованиеЗакупкиМалогоОбъемаЧерезПодотчетноеЛицо) ЕСТЬ NULL
	|			ТОГДА ВЫРАЗИТЬ(ВедомостьНаВыдачуПодотчетнымЛицамРасшифровкаПлатежа.ДокументОснование КАК Документ.ЗаявкаОбоснованиеЗакупкиМалогоОбъемаЧерезПодотчетноеЛицо).ОснованиеПринятияОбязательства
	|		КОГДА НЕ ВЫРАЗИТЬ(ВедомостьНаВыдачуПодотчетнымЛицамРасшифровкаПлатежа.ДокументОснование КАК Документ.РешениеОКомпенсацииРасходовДляКрайнегоСевера) ЕСТЬ NULL
	|			ТОГДА ВЫРАЗИТЬ(ВедомостьНаВыдачуПодотчетнымЛицамРасшифровкаПлатежа.ДокументОснование КАК Документ.РешениеОКомпенсацииРасходовДляКрайнегоСевера).ОснованиеПринятияОбязательства
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	|	КОНЕЦ КАК ОснованиеПринятияОбязательств,
	|	ВедомостьНаВыдачуПодотчетнымЛицамРасшифровкаПлатежа.КодЦели КАК КодЦели,
	|	ВедомостьНаВыдачуПодотчетнымЛицамРасшифровкаПлатежа.КодМероприятия КАК КодМероприятия,
	|	ВедомостьНаВыдачуПодотчетнымЛицамРасшифровкаПлатежа.ДопКлассификация КАК ДопКлассификация,
	|	ВедомостьНаВыдачуПодотчетнымЛицамРасшифровкаПлатежа.Сумма КАК Сумма,
	|	ВедомостьНаВыдачуПодотчетнымЛицамРасшифровкаПлатежа.Ссылка.Номер КАК ПервичныйДокументНомер,
	|	ВедомостьНаВыдачуПодотчетнымЛицамРасшифровкаПлатежа.Ссылка.Дата КАК ПервичныйДокументДата
	|ИЗ
	|	Документ.ВедомостьНаВыдачуПодотчетнымЛицам.РасшифровкаПлатежа КАК ВедомостьНаВыдачуПодотчетнымЛицамРасшифровкаПлатежа
	|ГДЕ
	|	ВедомостьНаВыдачуПодотчетнымЛицамРасшифровкаПлатежа.Ссылка = &Ссылка
	|	И ВедомостьНаВыдачуПодотчетнымЛицамРасшифровкаПлатежа.Выплачено = ИСТИНА");
	
	Запрос.УстановитьПараметр("Ссылка", ВедомостьНаВыдачуПодотчетнымЛицам);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции	

Функция ПодготовитьТаблицуРасходовПоАвансовомуОтчету(Документ, Параметры = Неопределено, Отказ) Экспорт
	
	Если Параметры = Неопределено Тогда
		Параметры = Новый Структура;
	КонецЕсли;
	
	Если НЕ Параметры.Свойство("ПоВсемКФО") Тогда
		Параметры.Вставить("ПоВсемКФО", Ложь);
	КонецЕсли;
	Если НЕ Параметры.Свойство("ПоВсемКПС") Тогда
		Параметры.Вставить("ПоВсемКПС", Ложь);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВалютаРегламентированногоУчета", БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета());
	
	ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "Израсходовано",
		"НомерСтроки,ИФО,КФО,КПС,КЭК,Подразделение,ПоДокументу,СуммаВключаетНДС,ПредъявленСФ,
		|СчетДебета,ПодразделениеДт,КПСДт,КЭКДт,СубконтоДебета1,СубконтоДебета2,СубконтоДебета3,
		|СчетНУ,СубконтоНУ1,СубконтоНУ2,СубконтоНУ3,
		|Сотрудник,СчетКредита,ДокументДата,КомуЗаЧто,СпособОбеспечения,
		|ОтражениеВУСН,ВалютаДокумента,Сумма,СуммаВВалюте,СуммаНДС,Количество",
		Документ, Параметры);
	
	Запрос.Текст = Запрос.Текст +
	"ВЫБРАТЬ
	|	""Израсходовано"" КАК ИмяСписка,
	|	""Израсходовано"" КАК СинонимСписка,
	|	Израсходовано.НомерСтроки КАК НомерСтроки,
	|	Израсходовано.ИФО КАК ИФО,
	|	Израсходовано.КФО КАК КФО,
	|	Израсходовано.КПС КАК КПС,
	|	Израсходовано.КЭК КАК КЭК,
	|	Израсходовано.Подразделение КАК Подразделение,
	|	Израсходовано.СчетДебета КАК СчетДебета,
	|	ВЫБОР
	|		КОГДА Израсходовано.КПСДт = ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)
	|			ТОГДА Израсходовано.КПС
	|		ИНАЧЕ Израсходовано.КПСДт
	|	КОНЕЦ КАК КПСДт,
	|	Израсходовано.КЭКДт КАК КЭКДт,
	|	ВЫБОР
	|		КОГДА Израсходовано.ПодразделениеДт = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|			ТОГДА Израсходовано.Подразделение
	|		ИНАЧЕ Израсходовано.ПодразделениеДт
	|	КОНЕЦ КАК ПодразделениеДт,
	|	Израсходовано.СубконтоДебета1 КАК СубконтоДебета1,
	|	Израсходовано.СубконтоДебета2 КАК СубконтоДебета2,
	|	Израсходовано.СубконтоДебета3 КАК СубконтоДебета3,
	|	Израсходовано.Сотрудник КАК Сотрудник,
	|	Израсходовано.Сотрудник.Контрагент КАК Контрагент,
	|	Израсходовано.СчетКредита КАК СчетРасчетов,
	|	Израсходовано.ДокументДата КАК ДокументДата,
	|	Израсходовано.КомуЗаЧто КАК КомуЗаЧто,
	|	Израсходовано.ПредъявленСФ КАК ПредъявленСФ,
	|	Израсходовано.ОтражениеВУСН КАК ОтражениеВУСН,
	|	ВЫБОР
	|		КОГДА Израсходовано.Сумма = 0
	|			ТОГДА Израсходовано.ВалютаДокумента
	|		ИНАЧЕ &ВалютаРегламентированногоУчета
	|	КОНЕЦ КАК Валюта,
	|	Израсходовано.СпособОбеспечения КАК СпособОбеспечения,
	|	Израсходовано.Сумма КАК Сумма,
	|	Израсходовано.СуммаВВалюте КАК СуммаВВалюте,
	|	ВЫБОР
	|		КОГДА Израсходовано.Сумма = 0
	|			ТОГДА Израсходовано.СуммаВВалюте
	|		КОГДА СуммаВключаетНДС
	|			ТОГДА Израсходовано.Сумма
	|		ИНАЧЕ Израсходовано.Сумма + Израсходовано.СуммаНДС
	|	КОНЕЦ КАК СуммаРасчетов,
	|	Израсходовано.СуммаНДС КАК СуммаНДС,
	|	Израсходовано.Количество КАК Количество,
	|	Израсходовано.СчетНУ КАК СчетНУ,
	|	Израсходовано.СубконтоНУ1 КАК СубконтоНУ1,
	|	Израсходовано.СубконтоНУ2 КАК СубконтоНУ2,
	|	Израсходовано.СубконтоНУ3 КАК СубконтоНУ3
	|ИЗ
	|	ТаблицаИзрасходовано КАК Израсходовано
	|ГДЕ
	|	НЕ Израсходовано.ПоДокументу
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДокументДата,
	|	НомерСтроки";
	
	ТаблицаИзрасходовано = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаИзрасходовано;
	
КонецФункции

Функция ТаблицаРасходовПоАвансовомуОтчетуСКурсамиВыдачи(ТаблицаДокумента, Документ, Реквизиты, Отказ) Экспорт
	
	ТаблицаРасходов = ПустаяТаблицаРасходовПоАвансовомуОтчету();
	
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	
	Если НЕ Реквизиты.Свойство("ПоВсемКФО") Тогда
		Реквизиты.Вставить("ПоВсемКФО", Ложь);
	КонецЕсли;
	Если НЕ Реквизиты.Свойство("ПоВсемКПС") Тогда
		Реквизиты.Вставить("ПоВсемКПС", Ложь);
	КонецЕсли;
	
	ДобавитьСлужебныеКолонкиРасчетовСПодотчетнымиЛицами(ТаблицаДокумента, Реквизиты);
	
	// Подготовим таблицу остатков авансов.
	ОстаткиАвансов = ОстаткиАвансов(Документ, ТаблицаДокумента, Реквизиты);
	
	Для Каждого СтрокаДокумента Из ТаблицаДокумента Цикл
		
		НераспределенныйОстаток = СтрокаДокумента.СуммаРасчетов;
		
		Если ОстаткиАвансов.Количество() > 0 Тогда
			
			Отбор = ОбщиеПараметрыОтбораАвансов(СтрокаДокумента, Реквизиты);
			НайденныеОстаткиАвансов = ОстаткиАвансов.НайтиСтроки(Отбор);
			
			ДобавитьСтрокиЗачтенныхАвансов(
			ТаблицаРасходов,
			НераспределенныйОстаток,
			НайденныеОстаткиАвансов,
			СтрокаДокумента,
			Реквизиты);
			
		КонецЕсли;
		
		// Сумму расчетов, оставшуюся после зачета всех авансов, добавляем отдельной строкой.
		ДобавитьСтрокуЗадолженности(
		ТаблицаРасходов,
		НераспределенныйОстаток,
		СтрокаДокумента,
		Реквизиты);
		
	КонецЦикла;
	
	КолонкиГруппировки = 
		"ИмяСписка,СинонимСписка,НомерСтроки,ИФО,КФО,КПС,Подразделение,КЭК,СчетРасчетов,
		|Контрагент,Валюта,КомуЗаЧто,Количество,РасчетыВВалюте,ПредъявленСФ,СуммаНДС,СпособОбеспечения,
		|СчетНУ,СубконтоНУ1,СубконтоНУ2,СубконтоНУ3,
		|СчетДебета,КПСДт,КЭКДт,ПодразделениеДт,СубконтоДебета1,СубконтоДебета2,СубконтоДебета3";
	КолонкиСуммирования = "ОстатокРасчетов, СуммаРасчетов, СуммаРуб, СуммаРубПоКурсуАванса";
	ТаблицаРасходов.Свернуть(КолонкиГруппировки,КолонкиСуммирования);
	
	Возврат ТаблицаРасходов;
	
КонецФункции

Функция ОстаткиАвансов(Документ, ТаблицаДокумента, Реквизиты) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Организация", Реквизиты.Организация);
	
	Запрос.УстановитьПараметр("ИспользоватьВалютныйУчет", ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	
	Запрос.УстановитьПараметр("СчетаРасчетов", БухгалтерскийУчет.СписокСчетов("208.00"));
	Запрос.УстановитьПараметр("ИФО",
		ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(ТаблицаДокумента.ВыгрузитьКолонку("ИФО")));
	Запрос.УстановитьПараметр("Подразделение",
		ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(ТаблицаДокумента.ВыгрузитьКолонку("Подразделение")));
	Запрос.УстановитьПараметр("КФО",
		ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(ТаблицаДокумента.ВыгрузитьКолонку("КФО")));
	Запрос.УстановитьПараметр("Контрагент",
		ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(ТаблицаДокумента.ВыгрузитьКолонку("Контрагент")));
	
	Запрос.УстановитьПараметр("ДокументыАванса",
		ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(Документ.Получено.ВыгрузитьКолонку("ДокументАванса")));
	
	ТекстЗапроса = Запрос.Текст +
	"ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт КАК СчетРасчетов,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт.Код КАК КодСчета,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт.ДатаОкончанияДействия КАК ДатаОкончанияДействияСчета,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт1 КАК Контрагент,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Организация,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ИФО КАК ИФО,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КФО,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ПодразделениеДт КАК Подразделение,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСДт КАК КПС,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ВалютаДт КАК Валюта,
	|	ВЫБОР
	|		КОГДА &ИспользоватьВалютныйУчет
	|				И ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт.Валютный
	|			ТОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВалютнаяСуммаДт
	|		ИНАЧЕ ЖурналПроводокЕПСБУДвиженияССубконто.Сумма
	|	КОНЕЦ КАК СуммаРасчетов,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Сумма КАК СуммаРуб
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|			,
	|			,
	|			Активность
	|				И Организация = &Организация
	|				И &УсловиеПоИФО
	|				И &УсловиеПоПодразделению
	|				И КФО В (&КФО)
	|				И СчетДт В (&СчетаРасчетов)
	|				И СубконтоДт1 В (&Контрагент)
	|				И Регистратор В (&ДокументыАванса),
	|			,
	|			) КАК ЖурналПроводокЕПСБУДвиженияССубконто";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоИФО",
		?(Реквизиты.ИспользоватьУчетПоИФО, "ИФО В (&ИФО)", "ИСТИНА") );
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоПодразделению",
		?(Реквизиты.ИспользоватьУчетПоПодразделениям, "(ПодразделениеДт В (&Подразделение) ИЛИ ПодразделениеДт ЕСТЬ NULL)", "ИСТИНА") );
		
	Если НЕ Реквизиты.ИспользоватьУчетПоИФО Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЖурналПроводокЕПСБУДвиженияССубконто.ИФО", "ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)");
	КонецЕсли;
	Если НЕ Реквизиты.ИспользоватьУчетПоПодразделениям Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЖурналПроводокЕПСБУДвиженияССубконто.ПодразделениеДт", "ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)");
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	
	Авансы = Запрос.Выполнить().Выгрузить();
	Для Каждого СтрокаАванс Из Авансы Цикл
		Если ЗначениеЗаполнено(СтрокаАванс.ДатаОкончанияДействияСчета)
			И СтрокаАванс.ДатаОкончанияДействияСчета < Реквизиты.ДатаУтверждения Тогда
			СтрокаАванс.СчетРасчетов = БухгалтерскийУчет.СчетПоКоду(СтрокаАванс.КодСчета, Реквизиты.ДатаУтверждения, Реквизиты.Организация);
		КонецЕсли;
	КонецЦикла;
	
	ДатаУтверждения = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Реквизиты, "ДатаУтверждения");
	Если Не ЗначениеЗаполнено(ДатаУтверждения) Тогда
		ДатаУтверждения = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Реквизиты, "Дата");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДатаУтверждения) Тогда
		РегистрыСведений.СоответствиеКПСПриПереносеОстатков.ЗаменитьКПСвТаблицахСУчетомПереносаОстатковПоКПС(
			ДатаУтверждения, Авансы);
	КонецЕсли;
	
	Возврат Авансы;
	
КонецФункции

Функция ПустаяТаблицаКурсовыхРазницПриВозвратеАвансаПодотчетнымЛицом() Экспорт

	ОписаниеТипаСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18, 2, ДопустимыйЗнак.Любой));
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	
	ПустаяТаблица.Колонки.Добавить("КФО",            Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ПустаяТаблица.Колонки.Добавить("КПС",            Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ПустаяТаблица.Колонки.Добавить("Подразделение",  Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	ПустаяТаблица.Колонки.Добавить("СчетРасчетов",   Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПустаяТаблица.Колонки.Добавить("Валюта",         Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	ПустаяТаблица.Колонки.Добавить("КурсоваяРазница",ОписаниеТипаСуммы);

	Возврат ПустаяТаблица;

КонецФункции

// Формирует таблицу курсовых разниц при возврате аванса в иностранной валюте.
//
Функция ТаблицаКурсовыхРазницПриВозвратеАванса(РасшифровкаПлатежа, Реквизиты, Отказ) Экспорт
	
	ТаблицаКурсовыхРазниц = ПустаяТаблицаКурсовыхРазницПриВозвратеАвансаПодотчетнымЛицом();
	
	УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Реквизиты.Организация, Реквизиты.Дата);
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	
	Если НЕ Реквизиты.Свойство("ПоВсемКФО") Тогда
		Реквизиты.Вставить("ПоВсемКФО", Ложь);
	КонецЕсли;
	Если НЕ Реквизиты.Свойство("ПоВсемКПС") Тогда
		Реквизиты.Вставить("ПоВсемКПС", Ложь);
	КонецЕсли;
	
	ДобавитьСлужебныеКолонкиРасчетовСПодотчетнымиЛицами(РасшифровкаПлатежа, Реквизиты);
	
	// Получим остатки задолженности со счетов бухгалтерского учета.
	ПериодОстатков = ?(Реквизиты.Свойство("ПериодОстатков"), Реквизиты.ПериодОстатков,
		Новый Граница(Реквизиты.Ссылка.МоментВремени(), ВидГраницы.Исключая));
	ОстаткиЗадолженности = ОстаткиЗадолженности(ПериодОстатков, РасшифровкаПлатежа, Реквизиты);
	
	// Для каждой строки платежа определим курсвоую разницу (если был аванс)
	Для Каждого СтрокаПлатежа Из РасшифровкаПлатежа Цикл
		
		НераспределенныйОстаток = СтрокаПлатежа.СуммаРасчетов;
		
		Если ОстаткиЗадолженности.Количество() > 0 Тогда
		
			Отбор = ОбщиеПараметрыОтбораАвансов(СтрокаПлатежа, Реквизиты);
			
			НайденныеОстаткиЗадолженности = ОстаткиЗадолженности.НайтиСтроки(Отбор);
			
			ДобавитьСтрокиКурсовойРазницы(
				ТаблицаКурсовыхРазниц,
				НераспределенныйОстаток,
				НайденныеОстаткиЗадолженности,
				СтрокаПлатежа,
				Реквизиты);
			
		КонецЕсли;
		
		// Нераспределенный остаток означает, что подотчетное лицо
		// возвращает сумму, превышающую остаток задолженности за ним.
		Если НераспределенныйОстаток > 0 Тогда
			
			ТекстОшибки = НСтр("ru='Возвращается сумма, превышающая остаток задолженности за подотчетным лицом.
			|
			|Указана сумма: %1 %2; Остаток задолженности: %3 %2; Превышение: %4 %2'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
			СтрокаПлатежа.СуммаРасчетов,
			СтрокаПлатежа.Валюта,
			СтрокаПлатежа.СуммаРасчетов - НераспределенныйОстаток,
			НераспределенныйОстаток);
			
			ПолеСуммаЗачета = "РасшифровкаПлатежа[" + Формат(СтрокаПлатежа.НомерСтроки - 1, "ЧН=0; ЧГ=") + "].Сумма";
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Реквизиты.Ссылка, ПолеСуммаЗачета, "Объект", Отказ);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаКурсовыхРазниц;
	
КонецФункции

// Остатки задолженности.
Функция ОстаткиЗадолженности(Период, РасшифровкаПлатежа, Реквизиты) Экспорт
	
	Если РасшифровкаПлатежа.Количество() = 0 Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("МоментВремени", Период);
	Запрос.УстановитьПараметр("Организация",   Реквизиты.Организация);
	
	Запрос.УстановитьПараметр("ИспользоватьВалютныйУчет",   Реквизиты.ИспользоватьВалютныйУчет);
	
	
	ПараметрыОтбора = ПараметрыОтбораОстатковАвансов(РасшифровкаПлатежа, Реквизиты);
	КолонкиПараметровУчета = 
		"УчетПоИФО, УчетПоКПС, УчетПоПодразделениям, ПоВсемКФО, ПоВсемКПС,
		|КонтрагентЕстьСубконто,
		|ДопАналитикаЕстьСубконто,ДопАналитикаВидСубконто";
	ТаблицаПараметровУчета = ПараметрыОтбора.Скопировать();
	ТаблицаПараметровУчета.Свернуть(КолонкиПараметровУчета);
	ТаблицаПараметровУчета.Колонки.Добавить("НомераСубконто", Новый ОписаниеТипов("Соответствие"));
	
	
	// Текст запроса по остаткам формируется для каждого набора параметров учета расчетов.
	ТекстОбщегоЗапроса = "";
	Для НомерЗапроса=1 По ТаблицаПараметровУчета.Количество() Цикл
		
		НаборПараметровУчета = ТаблицаПараметровУчета[НомерЗапроса-1];
		
		Если НЕ НаборПараметровУчета.КонтрагентЕстьСубконто Тогда
			Продолжить;
		КонецЕсли;
		
		МассивСубконто = Новый Массив;
		
		// Контрагент.
		МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
		НаборПараметровУчета.НомераСубконто.Вставить("Контрагент", 1);
		
		// ДопАналитика (документ расчетов или др.).
		Если НаборПараметровУчета.ДопАналитикаЕстьСубконто Тогда
			
			МассивСубконто.Добавить(НаборПараметровУчета.ДопАналитикаВидСубконто);
			НаборПараметровУчета.НомераСубконто.Вставить("ДопАналитика",
				НаборПараметровУчета.НомераСубконто.Количество() + 1);
			
		КонецЕсли;
		
		// Добавляем виртуальную таблицу.
		Запрос.Текст = Запрос.Текст + ТекстЗапросаОстаткиАвансов(НаборПараметровУчета, НомерЗапроса);
		
		// Устанавливаем параметры виртуальной таблицы.
		Отбор = Новый Структура(КолонкиПараметровУчета);
		ЗаполнитьЗначенияСвойств(Отбор, НаборПараметровУчета);
		ОтборОстатков = ПараметрыОтбора.Скопировать(Отбор);
		
		Запрос.УстановитьПараметр("Счета" + НомерЗапроса,
			ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(ОтборОстатков.ВыгрузитьКолонку("СчетОстатков")) );
		Запрос.УстановитьПараметр("ИФО" + НомерЗапроса,
			ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(ОтборОстатков.ВыгрузитьКолонку("ИФО")) );
		Запрос.УстановитьПараметр("КФО" + НомерЗапроса,
			ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(ОтборОстатков.ВыгрузитьКолонку("КФО")) );
		Запрос.УстановитьПараметр("КПС" + НомерЗапроса,
			ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(ОтборОстатков.ВыгрузитьКолонку("КПС")) );
		Запрос.УстановитьПараметр("Подразделение" + НомерЗапроса,
			ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(ОтборОстатков.ВыгрузитьКолонку("Подразделение")) );
		Запрос.УстановитьПараметр("Контрагенты" + НомерЗапроса,
			ОбщегоНазначенияБГУ.УдалитьПовторяющиесяЭлементыМассива(ОтборОстатков.ВыгрузитьКолонку("Контрагент")) );
		Запрос.УстановитьПараметр("УчетПоПодразделениям" + НомерЗапроса,
			НаборПараметровУчета.УчетПоПодразделениям);
		Запрос.УстановитьПараметр("УчетПоКПС" + НомерЗапроса,
			НаборПараметровУчета.УчетПоКПС);
		Запрос.УстановитьПараметр("ДопАналитикаВидСубконто" + НомерЗапроса,
			НаборПараметровУчета.ДопАналитикаВидСубконто);
		
		Запрос.УстановитьПараметр("Субконто" + НомерЗапроса, МассивСубконто);
		
		// Соединение виртуальных таблиц.
		Если НЕ ПустаяСтрока(ТекстОбщегоЗапроса) Тогда
			ТекстОбщегоЗапроса = ТекстОбщегоЗапроса + "
		|
		|	ОБЪЕДИНИТЬ ВСЕ
		|";
		КонецЕсли;
		
		ТекстОбщегоЗапроса = ТекстОбщегоЗапроса +
		"ВЫБРАТЬ
		|	ТаблицаОстаткиАвансов_НомерЗапроса.СчетРасчетов,
		|	ТаблицаОстаткиАвансов_НомерЗапроса.УчетПоПодразделениям,
		|	ТаблицаОстаткиАвансов_НомерЗапроса.УчетПоКПС,
		|	ТаблицаОстаткиАвансов_НомерЗапроса.ИФО,
		|	ТаблицаОстаткиАвансов_НомерЗапроса.КФО,
		|	ТаблицаОстаткиАвансов_НомерЗапроса.КПС,
		|	ТаблицаОстаткиАвансов_НомерЗапроса.Подразделение,
		|	ТаблицаОстаткиАвансов_НомерЗапроса.Контрагент,
		|	ТаблицаОстаткиАвансов_НомерЗапроса.ДопСубконтоАвансов,
		|	ТаблицаОстаткиАвансов_НомерЗапроса.ВидДопСубконтоАвансов,
		|	ТаблицаОстаткиАвансов_НомерЗапроса.Валюта,
		|	ТаблицаОстаткиАвансов_НомерЗапроса.СуммаРасчетов,
		|	ТаблицаОстаткиАвансов_НомерЗапроса.СуммаРуб
		|ИЗ
		|	ОстаткиАвансов_НомерЗапроса КАК ТаблицаОстаткиАвансов_НомерЗапроса";
		
		ТекстОбщегоЗапроса = СтрЗаменить(ТекстОбщегоЗапроса, "_НомерЗапроса", Строка(НомерЗапроса));
		
	КонецЦикла;
	
	Запрос.Текст = Запрос.Текст + ТекстОбщегоЗапроса;
	Если ПустаяСтрока(Запрос.Текст) Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	
	ОстаткиЗадолженности = Запрос.Выполнить().Выгрузить();
	ОбщегоНазначенияБГУ.УпорядочитьТаблицуПоДокументу(ОстаткиЗадолженности, "ДопСубконтоАвансов", "ДатаДокументаАвансов");
	
	Возврат ОстаткиЗадолженности;
	
КонецФункции

Функция ПараметрыОтбораОстатковАвансов(ТаблицаДокумента, Реквизиты)
	
	ПараметрыОтбора = ТаблицаДокумента.СкопироватьКолонки("ИФО,КФО,КПС,Подразделение,Контрагент");
	ПараметрыОтбора.Колонки.Добавить("СчетОстатков", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	Для Каждого СтрокаДокумента Из ТаблицаДокумента Цикл
		
		Отбор = ПараметрыОтбора.Добавить();
		ЗаполнитьЗначенияСвойств(Отбор, СтрокаДокумента);
		Отбор.СчетОстатков = СтрокаДокумента.СчетРасчетов;
		
	КонецЦикла;
	
	ПараметрыОтбора.Колонки.Добавить("УчетПоИФО",            Новый ОписаниеТипов("Булево"));
	ПараметрыОтбора.Колонки.Добавить("УчетПоКПС",            Новый ОписаниеТипов("Булево"));
	ПараметрыОтбора.Колонки.Добавить("УчетПоПодразделениям", Новый ОписаниеТипов("Булево"));
	ПараметрыОтбора.Колонки.Добавить("ПоВсемКФО",            Новый ОписаниеТипов("Булево"));
	ПараметрыОтбора.Колонки.Добавить("ПоВсемКПС",            Новый ОписаниеТипов("Булево"));
	
	ПараметрыОтбора.Колонки.Добавить("КонтрагентЕстьСубконто",   Новый ОписаниеТипов("Булево"));
	ПараметрыОтбора.Колонки.Добавить("ДопАналитикаЕстьСубконто", Новый ОписаниеТипов("Булево"));
	ПараметрыОтбора.Колонки.Добавить("ДопАналитикаВидСубконто",  Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто"));
	
	Для Каждого Отбор Из ПараметрыОтбора Цикл
		
		СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Отбор.СчетОстатков);
		
		Отбор.УчетПоИФО = Реквизиты.ИспользоватьУчетПоИФО;
		Отбор.УчетПоКПС = СвойстваСчета.УчетПоКПС;
		Отбор.УчетПоПодразделениям =
			Реквизиты.ИспользоватьУчетПоПодразделениям И СвойстваСчета.УчетПоПодразделениям;
		Отбор.ПоВсемКФО = Реквизиты.ПоВсемКФО;
		Отбор.ПоВсемКПС = Реквизиты.ПоВсемКПС;
		
		Для Индекс = 1 По СвойстваСчета.КоличествоСубконто Цикл
		
			ВидСубконто = СвойстваСчета["ВидСубконто" + Индекс];
			Если ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Контрагенты Тогда
				Отбор.КонтрагентЕстьСубконто = Истина;
			Иначе
				Отбор.ДопАналитикаЕстьСубконто = Истина;
				Отбор.ДопАналитикаВидСубконто  = ВидСубконто;
			КонецЕсли;
		
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ПараметрыОтбора;
	
КонецФункции

Функция ТекстЗапросаОстаткиАвансов(ПараметрыУчета, НомерЗапроса)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Остатки.Счет КАК СчетРасчетов,
	|	&УчетПоПодразделениям_НомерЗапроса КАК УчетПоПодразделениям,
	|	&УчетПоКПС_НомерЗапроса КАК УчетПоКПС,
	|	Остатки.ИФО КАК ИФО,
	|	Остатки.КФО КАК КФО,
	|	Остатки.КПС КАК КПС,
	|	Остатки.Подразделение КАК Подразделение,
	|	Остатки.Субконто1 КАК Контрагент,
	|	Остатки.ДопАналитика КАК ДопСубконтоАвансов,
	|	&ДопАналитикаВидСубконто_НомерЗапроса КАК ВидДопСубконтоАвансов,
	|	Остатки.Валюта КАК Валюта,
	|	ВЫБОР
	|		КОГДА &ИспользоватьВалютныйУчет
	|				И Остатки.Счет.Валютный
	|			ТОГДА Остатки.ВалютнаяСуммаОстатокДт
	|		ИНАЧЕ Остатки.СуммаОстатокДт
	|	КОНЕЦ КАК СуммаРасчетов,
	|	Остатки.СуммаОстатокДт КАК СуммаРуб
	|ПОМЕСТИТЬ ОстаткиАвансов_НомерЗапроса
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&МоментВремени,
	|			Счет В (&Счета_НомерЗапроса),
	|			&Субконто_НомерЗапроса,
	|			Организация = &Организация
	|				И &УсловиеПоИФО
	|				И &УсловиеПоКФО
	|				И &УсловиеПоКонтрагентам
	|				И &УсловиеПоКПС
	|				И &УсловиеПоПодразделению) КАК Остатки";
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоИФО",
		?(ПараметрыУчета.УчетПоИФО, "ИФО В (&ИФО_НомерЗапроса)", "ИСТИНА") );
		
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоКФО",
		?(НЕ ПараметрыУчета.ПоВсемКФО, "КФО В (&КФО_НомерЗапроса)", "ИСТИНА") );
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоКПС",
		?(ПараметрыУчета.УчетПоКПС И НЕ ПараметрыУчета.ПоВсемКПС, "КПС В (&КПС_НомерЗапроса)", "ИСТИНА") );
		
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоПодразделению",
		?(ПараметрыУчета.УчетПоПодразделениям, "Подразделение В (&Подразделение_НомерЗапроса)", "ИСТИНА") );
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеПоКонтрагентам",
		"Субконто"+ПараметрыУчета.НомераСубконто["Контрагент"]+" В (&Контрагенты_НомерЗапроса)");
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Остатки.Контрагент",
		"Остатки.Субконто"+ПараметрыУчета.НомераСубконто["Контрагент"]);
		
	Если ПараметрыУчета.ДопАналитикаЕстьСубконто Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Остатки.ДопАналитика",
			"Остатки.Субконто"+ПараметрыУчета.НомераСубконто["ДопАналитика"]);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Остатки.ДопАналитика",
			"НЕОПРЕДЕЛЕНО");
	КонецЕсли;
	
	Если НЕ ПараметрыУчета.УчетПоКПС Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Остатки.КПС", "ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)");
	КонецЕсли;
	Если НЕ ПараметрыУчета.УчетПоИФО Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Остатки.ИФО", "ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)");
	КонецЕсли;
	Если НЕ ПараметрыУчета.УчетПоПодразделениям Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Остатки.Подразделение", "ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)");
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "_НомерЗапроса", Строка(НомерЗапроса));
	
	Возврат ТекстЗапроса + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета();
	
КонецФункции

Функция ДетализироватьРасшифровкуПлатежаПоВедомостиПеречислений(РасшифровкаПлатежа, Документ, Параметры = Неопределено, Отказ) Экспорт
	
	Если Не ЗначениеЗаполнено(Параметры.ВедомостьНаВыплатуВБанк)
		ИЛИ ТипЗнч(Параметры.ВедомостьНаВыплатуВБанк) <> Тип("ДокументСсылка.ВедомостьНаВыплатуВБанк") Тогда
		Возврат РасшифровкаПлатежа; // Ведомость на перечисление сотрудникам.
		// Будем считать получателем контрагента, указанного в расчетно-платежном документе.
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	// Список сотрудников из ведомости перечислений поместим в виртуальную таблицу.
	ОбщегоНазначенияБГУ.ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, "РасшифровкаПлатежа",
		"Сотрудник,ОснованиеПринятияОбязательства,КФО,КПС,КЭК,КодЦели,КодМероприятия,ДопКлассификация,Сумма",
		Параметры.ВедомостьНаВыплатуВБанк, Параметры);
	
	// Сохраним все колонки таблицы расшифровки платежа.
	Запрос.УстановитьПараметр("РасшифровкаПлатежаРасчетноПлатежногоДокумента", РасшифровкаПлатежа);
	ОбщиеПоляЗапроса = "";
	Для Каждого Колонка Из РасшифровкаПлатежа.Колонки Цикл
		Если СтрНайти("Контрагент,Договор,СуммаРуб", Колонка.Имя) > 0 Тогда
			Продолжить; // Эти колонки заполним по ведомости перечислений.
		КонецЕсли;
		ОбщиеПоляЗапроса = ?(ЗначениеЗаполнено(ОбщиеПоляЗапроса), ОбщиеПоляЗапроса + ",", "") + "
			|	РасшифровкаПлатежа." + Колонка.Имя + " КАК " + Колонка.Имя;
	КонецЦикла;
	
	Запрос.Текст = Запрос.Текст +
	"ВЫБРАТЬ" + ОбщиеПоляЗапроса + "
	|ПОМЕСТИТЬ ТаблицаРасшифровкаПлатежаРасчетноПлатежногоДокумента
	|ИЗ
	|	&РасшифровкаПлатежаРасчетноПлатежногоДокумента КАК РасшифровкаПлатежа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ" + ОбщиеПоляЗапроса + ",
	|	ВедомостьПеречислений.Сотрудник.Контрагент КАК Контрагент,
	|	ВедомостьПеречислений.ОснованиеПринятияОбязательства КАК Договор,
	|	ВедомостьПеречислений.Сумма КАК СуммаРуб
	|ИЗ
	|	ТаблицаРасшифровкаПлатежаРасчетноПлатежногоДокумента КАК РасшифровкаПлатежа
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаРасшифровкаПлатежа КАК ВедомостьПеречислений
	|		ПО РасшифровкаПлатежа.КФО = ВедомостьПеречислений.КФО
	|			И РасшифровкаПлатежа.КПС = ВедомостьПеречислений.КПС
	|			И РасшифровкаПлатежа.КЭК = ВедомостьПеречислений.КЭК
	|			И РасшифровкаПлатежа.КодЦели = ВедомостьПеречислений.КодЦели
	|			И РасшифровкаПлатежа.КодМероприятия = ВедомостьПеречислений.КодМероприятия
	|			И РасшифровкаПлатежа.ДопКлассификация = ВедомостьПеречислений.ДопКлассификация
	|
	|УПОРЯДОЧИТЬ ПО
	|	Контрагент";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Возвращает момент времени, на который будут рассчитаны данные предыдущего аванса.
//
// Параметры:
// АвансовыйОтчет - ДокументСсылка.АвансовыйОтчет или ДокументОбъект.АвансовыйОтчет - авансовый отчет,
// для которого необходимо получить данные предыдущего аванса.
//
// Возвращаемое значение:
// МоментВремени.
//
Функция МоментВремениДокументаНачальногоОстатка(АвансовыйОтчет) Экспорт
	
	МоментВремени = АвансовыйОтчет.МоментВремени();
	
	Авансы = АвансовыйОтчет.Получено.ВыгрузитьКолонку("ДокументАванса");
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(
		Авансы, АвансовыйОтчет.Израсходовано.ВыгрузитьКолонку("ПриходныйДокумент"), Истина);
	
	ОбщегоНазначенияКлиентСервер.УдалитьВсеВхожденияЗначенияИзМассива(Авансы, Неопределено);
	ОбщегоНазначенияКлиентСервер.УдалитьВсеВхожденияТипаИзМассива(Авансы, Тип("Строка"));
	
	Если Авансы.Количество() = 0 Тогда
		Возврат МоментВремени;
	КонецЕсли;
	
	МоментыВремениПроведения = МоментыВремениПроведенияДокументов(Авансы);
	
	Для Каждого МоментВремениПроведения ИЗ МоментыВремениПроведения Цикл
		Если МоментВремени.Сравнить(МоментВремениПроведения) > 0 Тогда
			МоментВремени = МоментВремениПроведения;
		КонецЕсли;
	КонецЦикла;
	
	Возврат МоментВремени;
	
КонецФункции

// Формирует таблицу корректировки денежных обязательств по авансовому отчету.
//
Функция ТаблицаКорректировкиДенежныхОбязательствПоАвансовомуОтчету(Реквизиты, РасходыПоАвансовомуОтчету) Экспорт
	
	РасчетыВВалюте = Ложь;
	СвойстваСчетаДО = БухгалтерскийУчет.ПолучитьСвойстваСчетов("502.12",,"Валютный");
	Для Каждого Свойство Из СвойстваСчетаДО Цикл
		РасчетыВВалюте = РасчетыВВалюте ИЛИ Свойство.Значение.Валютный;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("РасчетыВВалюте", РасчетыВВалюте);
	Запрос.УстановитьПараметр("ВалютаРегУчета", Константы.ВалютаРегламентированногоУчета.Получить());
	Запрос.УстановитьПараметр("ЗаявлениеНаВыдачуАванса", Реквизиты.ЗаявлениеНаВыдачуАванса);
	Запрос.УстановитьПараметр("Обязательство", Реквизиты.Обязательство);
	Запрос.УстановитьПараметр("РазделЛицСчета", Реквизиты.РазделЛицСчета);
	Запрос.УстановитьПараметр("Израсходовано", РасходыПоАвансовомуОтчету);
	Запрос.УстановитьПараметр("АвансовыйОтчетСсылка", Реквизиты.Ссылка);
	Запрос.УстановитьПараметр("Счет208", БухгалтерскийУчет.СписокСчетов("208.00", Реквизиты.Дата, , Реквизиты.Организация));
	Запрос.УстановитьПараметр("Счет20834", БухгалтерскийУчет.СчетПоКоду("208.34", Реквизиты.Дата, Реквизиты.Организация));
	Запрос.УстановитьПараметр("СчетаМатериалы", БухгалтерскийУчет.СписокСчетов("105.00, 106.2П, 106.3П", Реквизиты.Дата, , Реквизиты.Организация));
	
