	|	Расходы.ОтражениеВУСН КАК ОтражениеВУСН,
	|	Расходы.ПредъявленСФ КАК ПредъявленСФ,
	|	Расходы.СуммаНДС КАК СуммаНДС,
	|	Расходы.СпособОбеспечения КАК СпособОбеспечения
	|ИЗ
	|	Расходы КАК Расходы
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок,
	|	НомерСтроки";
	
	ТаблицаРасходы = Запрос.Выполнить().Выгрузить();
	
	Счета208 = БухгалтерскиеОперации.СчетПоКоду("208.00", Параметры.Дата);
	Для Каждого СтрокаРасходы Из ТаблицаРасходы Цикл
		СтрокаРасходы.СчетРасчетов = БухгалтерскийУчет.ПолучитьАналитическийСчетПоКЭК(
			СтрокаРасходы.КЭК, Счета208, , Параметры.Дата, Параметры.Организация, СтрокаРасходы.ИФО);
	КонецЦикла;
	
	Возврат ТаблицаРасходы;
	
КонецФункции

Функция ТаблицаРасходовПоОтчетуОРасходахСКурсамиВыдачи(ТаблицаДокумента, Документ, Реквизиты, Отказ) Экспорт
	
	ТаблицаРасходов = ПустаяТаблицаРасходовПоОтчетуОРасходах();
	
	Реквизиты.Вставить("ИспользоватьУчетПоИФО",            ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	Реквизиты.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Реквизиты.Вставить("ИспользоватьВалютныйУчет",         ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	
	Если НЕ Реквизиты.Свойство("ПоВсемКФО") Тогда
		Реквизиты.Вставить("ПоВсемКФО", Ложь);
	КонецЕсли;
	Если НЕ Реквизиты.Свойство("ПоВсемКПС") Тогда
		Реквизиты.Вставить("ПоВсемКПС", Ложь);
	КонецЕсли;
	
	ДобавитьСлужебныеКолонкиРасчетовСПодотчетнымиЛицами(ТаблицаДокумента, Реквизиты);
	
	// Подготовим таблицу остатков авансов.
	ОстаткиАвансов = ОстаткиАвансов(Документ, ТаблицаДокумента, Реквизиты);
	
	Для Каждого СтрокаДокумента Из ТаблицаДокумента Цикл
		
		НераспределенныйОстаток = СтрокаДокумента.СуммаРасчетов;
		
		Если ОстаткиАвансов.Количество() > 0 Тогда
			
			Отбор = ОбщиеПараметрыОтбораАвансов(СтрокаДокумента, Реквизиты);
			НайденныеОстаткиАвансов = ОстаткиАвансов.НайтиСтроки(Отбор);
			
			ДобавитьСтрокиЗачтенныхАвансов(
			ТаблицаРасходов,
			НераспределенныйОстаток,
			НайденныеОстаткиАвансов,
			СтрокаДокумента,
			Реквизиты);
			
		КонецЕсли;
		
		// Сумму расчетов, оставшуюся после зачета всех авансов, добавляем отдельной строкой.
		ДобавитьСтрокуЗадолженности(
		ТаблицаРасходов,
		НераспределенныйОстаток,
		СтрокаДокумента,
		Реквизиты);
		
	КонецЦикла;
	
	КолонкиГруппировки = 
		"ИмяСписка,СинонимСписка,НомерСтроки,ИФО,КФО,КПС,Подразделение,КЭК,СчетРасчетов,
		|Контрагент,Валюта,НаименованиеРасхода,Количество,РасчетыВВалюте,СпособОбеспечения,
		|СчетНУ,СубконтоНУ1,СубконтоНУ2,СубконтоНУ3,ОтражениеВУСН,
		|СчетДебета,КПСДт,КЭКДт,ПодразделениеДт,СубконтоДебета1,СубконтоДебета2,СубконтоДебета3,
		|ПредъявленСФ,СуммаНДС";
		
	КолонкиСуммирования = "ОстатокРасчетов, СуммаРасчетов, СуммаРуб, СуммаРубПоКурсуАванса";
	ТаблицаРасходов.Свернуть(КолонкиГруппировки,КолонкиСуммирования);
	
	Возврат ТаблицаРасходов;
	
КонецФункции

Функция СуточныеПоНормативу(Отбор) Экспорт
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("КФО", Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	Результат.Колонки.Добавить("Норматив", ОбщегоНазначения.ОписаниеТипаЧисло(15, 2, ДопустимыйЗнак.Неотрицательный));
	Результат.Колонки.Добавить("Валюта", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	Результат.Колонки.Добавить("ОплачиваютсяОднодневныеКомандировки", Новый ОписаниеТипов("Булево"));
	
	ПроцентНадбавки = 0;
	ПроцентИзменения = 100;
	
	Если Отбор.Страна <> ПредопределенноеЗначение("Справочник.СтраныМира.Россия") Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	НадбавкиКСуточнымВЗагранкомандировках.ПроцентНадбавки КАК ПроцентНадбавки
		|ИЗ
		|	РегистрСведений.НадбавкиКСуточнымВЗагранкомандировках КАК НадбавкиКСуточнымВЗагранкомандировках
		|ГДЕ
		|	НадбавкиКСуточнымВЗагранкомандировках.ОсобыйСтатус = &ОсобыйСтатус";
		Запрос.УстановитьПараметр("ОсобыйСтатус", Отбор.ОсобыйСтатус);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ПроцентНадбавки = Выборка.ПроцентНадбавки;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Отбор.ДополнительноеУсловие) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ПоправкиКНормативамСуточных.ПроцентИзменения КАК ПроцентИзменения
		|ИЗ
		|	РегистрСведений.ПоправкиКНормативамСуточных КАК ПоправкиКНормативамСуточных
		|ГДЕ
		|	ПоправкиКНормативамСуточных.ДополнительноеУсловие = &ДополнительноеУсловие";
		Запрос.УстановитьПараметр("ДополнительноеУсловие", Отбор.ДополнительноеУсловие);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ПроцентИзменения = Выборка.ПроцентИзменения;
		КонецЕсли;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НормативыСуточныхСрезПоследних.Сумма КАК Сумма,
	|	НормативыСуточныхСрезПоследних.Валюта КАК Валюта,
	|	НормативыСуточныхСрезПоследних.КФО КАК КФО,
	|	НормативыСуточныхСрезПоследних.ОплачиваютсяОднодневныеКомандировки КАК ОплачиваютсяОднодневныеКомандировки,
	|	1 КАК Приоритет
	|ПОМЕСТИТЬ НормативыСПриоритетами
	|ИЗ
	|	РегистрСведений.НормативыСуточных.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ВидДоговора = &ВидДоговора
	|				И Страна = &Страна
	|				И Территория = &Территория) КАК НормативыСуточныхСрезПоследних
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	НормативыСуточныхСрезПоследних.Сумма,
	|	НормативыСуточныхСрезПоследних.Валюта,
	|	НормативыСуточныхСрезПоследних.КФО,
	|	НормативыСуточныхСрезПоследних.ОплачиваютсяОднодневныеКомандировки,
	|	2
	|ИЗ
	|	РегистрСведений.НормативыСуточных.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ВидДоговора = &ВидДоговора
	|				И Страна = &Страна
	|				И Территория = ЗНАЧЕНИЕ(Справочник.ТерриторииСОтдельнымиНормативами.ПустаяСсылка)) КАК НормативыСуточныхСрезПоследних
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	НормативыСуточныхСрезПоследних.Сумма,
	|	НормативыСуточныхСрезПоследних.Валюта,
	|	НормативыСуточныхСрезПоследних.КФО,
	|	НормативыСуточныхСрезПоследних.ОплачиваютсяОднодневныеКомандировки,
	|	3
	|ИЗ
	|	РегистрСведений.НормативыСуточных.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ВидДоговора = &ВидДоговора
	|				И Страна = ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)
	|				И Территория = ЗНАЧЕНИЕ(Справочник.ТерриторииСОтдельнымиНормативами.ПустаяСсылка)) КАК НормативыСуточныхСрезПоследних
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	НормативыСуточныхСрезПоследних.Сумма,
	|	НормативыСуточныхСрезПоследних.Валюта,
	|	НормативыСуточныхСрезПоследних.КФО,
	|	НормативыСуточныхСрезПоследних.ОплачиваютсяОднодневныеКомандировки,
	|	4
	|ИЗ
	|	РегистрСведений.НормативыСуточных.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровССотрудниками.ПустаяСсылка)
	|				И Страна = &Страна
	|				И Территория = &Территория) КАК НормативыСуточныхСрезПоследних
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	НормативыСуточныхСрезПоследних.Сумма,
	|	НормативыСуточныхСрезПоследних.Валюта,
	|	НормативыСуточныхСрезПоследних.КФО,
	|	НормативыСуточныхСрезПоследних.ОплачиваютсяОднодневныеКомандировки,
	|	5
	|ИЗ
	|	РегистрСведений.НормативыСуточных.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровССотрудниками.ПустаяСсылка)
	|				И Страна = &Страна
	|				И Территория = ЗНАЧЕНИЕ(Справочник.ТерриторииСОтдельнымиНормативами.ПустаяСсылка)) КАК НормативыСуточныхСрезПоследних
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	НормативыСуточныхСрезПоследних.Сумма,
	|	НормативыСуточныхСрезПоследних.Валюта,
	|	НормативыСуточныхСрезПоследних.КФО,
	|	НормативыСуточныхСрезПоследних.ОплачиваютсяОднодневныеКомандировки,
	|	6
	|ИЗ
	|	РегистрСведений.НормативыСуточных.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровССотрудниками.ПустаяСсылка)
	|				И Страна = ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)
	|				И Территория = ЗНАЧЕНИЕ(Справочник.ТерриторииСОтдельнымиНормативами.ПустаяСсылка)) КАК НормативыСуточныхСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МИНИМУМ(НормативыСПриоритетами.Приоритет) КАК Приоритет
	|ПОМЕСТИТЬ МинимальныйПриоритет
	|ИЗ
	|	НормативыСПриоритетами КАК НормативыСПриоритетами
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НормативыСПриоритетами.Сумма КАК Норматив,
	|	НормативыСПриоритетами.Валюта КАК Валюта,
	|	НормативыСПриоритетами.КФО КАК КФО,
	|	НормативыСПриоритетами.ОплачиваютсяОднодневныеКомандировки КАК ОплачиваютсяОднодневныеКомандировки
	|ИЗ
	|	НормативыСПриоритетами КАК НормативыСПриоритетами
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ МинимальныйПриоритет КАК МинимальныйПриоритет
	|		ПО НормативыСПриоритетами.Приоритет = МинимальныйПриоритет.Приоритет
	|
	|УПОРЯДОЧИТЬ ПО
	|	НормативыСПриоритетами.Приоритет";
	
	Запрос.УстановитьПараметр("Период", Отбор.Период);
	Запрос.УстановитьПараметр("Организация", Отбор.Организация);
	Запрос.УстановитьПараметр("ВидДоговора", Отбор.ВидДоговора);
	Запрос.УстановитьПараметр("Страна", Отбор.Страна);
	Запрос.УстановитьПараметр("Территория", Отбор.Территория);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Результат.Добавить(), Выборка);
	КонецЦикла;
	
	Для Каждого СтрокаРезультата Из Результат Цикл
		СтрокаРезультата.Норматив = СтрокаРезультата.Норматив * (100 + ПроцентНадбавки + ПроцентИзменения) / 100;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

