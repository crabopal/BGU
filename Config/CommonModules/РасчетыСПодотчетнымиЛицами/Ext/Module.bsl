Функция ОбщиеПараметрыОтбораАвансов(СтрокаДокумента, Реквизиты)
	
	Отбор = Новый Структура("СчетРасчетов,Контрагент",
		СтрокаДокумента.СчетРасчетов,
		СтрокаДокумента.Контрагент);
	
	СвойстваСчетаРасчетов = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаДокумента.СчетРасчетов);
	Если Реквизиты.ИспользоватьУчетПоИФО Тогда
		Отбор.Вставить("ИФО", СтрокаДокумента.ИФО);
	КонецЕсли;
	Если НЕ Реквизиты.ПоВсемКФО Тогда
		Отбор.Вставить("КФО",СтрокаДокумента.КФО);
	КонецЕсли;
	Если СвойстваСчетаРасчетов.УчетПоКПС И НЕ Реквизиты.ПоВсемКПС Тогда
		Отбор.Вставить("КПС", СтрокаДокумента.КПС);
	КонецЕсли;
	Если Реквизиты.ИспользоватьУчетПоПодразделениям И СвойстваСчетаРасчетов.УчетПоПодразделениям Тогда
		Отбор.Вставить("Подразделение", СтрокаДокумента.Подразделение);
	КонецЕсли;
	Если (Реквизиты.ИспользоватьВалютныйУчет И СвойстваСчетаРасчетов.Валютный) ИЛИ СтрокаДокумента.РасчетыВВалюте Тогда
		Отбор.Вставить("Валюта", СтрокаДокумента.Валюта);
	КонецЕсли;
	
	Возврат Отбор;
	
КонецФункции

Процедура ДобавитьСтрокиЗачтенныхАвансов(ТаблицаРасчетов, НераспределеннаяСумма, ОстаткиАвансов, СтрокаДокумента, Реквизиты)

	Знак = 1;
	
	Для Каждого СтрокаОстатка Из ОстаткиАвансов Цикл
		
		Если НераспределеннаяСумма <= 0 Тогда
			Прервать;
		КонецЕсли;
		
		ЗачитываемыйАванс = Мин(НераспределеннаяСумма, Знак * СтрокаОстатка.СуммаРасчетов);
		Если ЗачитываемыйАванс <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаРасчетов = ТаблицаРасчетов.Добавить();
		СтрокаРасчетов.ЭтоЗачетАванса = Истина;
		
		ЗаполнитьЗначенияСвойств(СтрокаРасчетов, СтрокаДокумента);
		
		СтрокаРасчетов.ОстатокРасчетов = Знак * СтрокаОстатка.СуммаРасчетов;
		СтрокаРасчетов.СуммаРасчетов   = ЗачитываемыйАванс;
		
		КоэффициентКурсаАванса = ?(НЕ СтрокаДокумента.РасчетыВВалюте, 1,
			?(СтрокаОстатка.СуммаРасчетов = 0, 0, СтрокаОстатка.СуммаРуб / СтрокаОстатка.СуммаРасчетов));
		
		КоэффициентРуб = ?(НЕ СтрокаДокумента.РасчетыВВалюте, 1,
			?(СтрокаДокумента.СуммаРасчетов = 0, 0, СтрокаДокумента.СуммаРуб / СтрокаДокумента.СуммаРасчетов));
		
		СтрокаРасчетов.СуммаРубПоКурсуАванса = Окр(ЗачитываемыйАванс * КоэффициентКурсаАванса, 2);
		СтрокаРасчетов.СуммаРуб              = Окр(ЗачитываемыйАванс * КоэффициентРуб, 2);
		
		НераспределеннаяСумма = НераспределеннаяСумма - ЗачитываемыйАванс;
		
		СтрокаОстатка.СуммаРасчетов = СтрокаОстатка.СуммаРасчетов - Знак * СтрокаРасчетов.СуммаРасчетов;
		СтрокаОстатка.СуммаРуб      = СтрокаОстатка.СуммаРуб      - Знак * СтрокаРасчетов.СуммаРубПоКурсуАванса;
		
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьСтрокуЗадолженности(ТаблицаРасчетов, НераспределеннаяСумма, СтрокаДокумента, Реквизиты)

	Если НераспределеннаяСумма <= 0 Тогда
		Возврат;
	КонецЕсли;

	СтрокаРасчетов = ТаблицаРасчетов.Добавить();
	СтрокаРасчетов.ЭтоЗачетАванса = Ложь;
	
	ЗаполнитьЗначенияСвойств(СтрокаРасчетов, СтрокаДокумента);
	
	СтрокаРасчетов.СуммаРасчетов = НераспределеннаяСумма;

	КоэффициентРуб = ?(НЕ СтрокаДокумента.РасчетыВВалюте, 1,
		?(СтрокаДокумента.СуммаРасчетов = 0, 0, СтрокаДокумента.СуммаРуб / СтрокаДокумента.СуммаРасчетов));

	СтрокаРасчетов.СуммаРуб              = Окр(НераспределеннаяСумма * КоэффициентРуб, 2);
	СтрокаРасчетов.СуммаРубПоКурсуАванса = СтрокаРасчетов.СуммаРуб;

КонецПроцедуры

Функция ДобавитьСлужебныеКолонкиРасчетовСПодотчетнымиЛицами(ТаблицаДокумента, Реквизиты)
	
	Если ТаблицаДокумента = Неопределено Тогда
		Возврат ТаблицаДокумента;
	КонецЕсли;
	
	НетКолонкиСуммаРуб = (ТаблицаДокумента.Колонки.Найти("СуммаРуб") = Неопределено);
	Если НетКолонкиСуммаРуб Тогда
		ТаблицаДокумента.Колонки.Добавить("СуммаРуб", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(18, 2));
	КонецЕсли;
	
	ТаблицаДокумента.Колонки.Добавить("РасчетыВВалюте",    Новый ОписаниеТипов("Булево"));
	ТаблицаДокумента.Колонки.Добавить("Курс",              ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(10, 4));
	ТаблицаДокумента.Колонки.Добавить("Кратность",         ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(10, 0));
	
	Для Каждого СтрокаДокумента Из ТаблицаДокумента Цикл
		
		СтрокаДокумента.РасчетыВВалюте = СтрокаДокумента.Валюта <> БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета();
		
		Если СтрокаДокумента.РасчетыВВалюте Тогда
			
			Если Реквизиты.Свойство("КурсыВалют") Тогда
				КурсКратность = Реквизиты.КурсыВалют.Найти(СтрокаДокумента.Валюта, "Валюта");
				СтрокаДокумента.Курс      = КурсКратность.Курс;
				СтрокаДокумента.Кратность = КурсКратность.Кратность;
			ИначеЕсли НЕ (Реквизиты.Свойство("Курс") И Реквизиты.Свойство("Кратность")) Тогда
				КурсКратность = РаботаСКурсамиВалют.ПолучитьКурсВалюты(СтрокаДокумента.Валюта, НачалоДня(Реквизиты.Дата));
				СтрокаДокумента.Курс      = КурсКратность.Курс;
				СтрокаДокумента.Кратность = КурсКратность.Кратность;
			Иначе
				СтрокаДокумента.Курс      = Реквизиты.Курс;
				СтрокаДокумента.Кратность = Реквизиты.Кратность;
			КонецЕсли;
			
			Если НетКолонкиСуммаРуб Тогда
				КурсДокумента = ?(СтрокаДокумента.Кратность = 0, СтрокаДокумента.Курс,
									СтрокаДокумента.Курс / СтрокаДокумента.Кратность);
				СтрокаДокумента.СуммаРуб = Окр(СтрокаДокумента.СуммаРасчетов * КурсДокумента, 2);
			Иначе
				// Колонка "СуммаРуб" уже рассчитана.
			КонецЕсли;
			
		Иначе
			СтрокаДокумента.СуммаРуб  = СтрокаДокумента.СуммаРасчетов;
			СтрокаДокумента.Курс      = 1;
			СтрокаДокумента.Кратность = 1;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаДокумента;
	
КонецФункции

Процедура ДобавитьСтрокиКурсовойРазницы(ТаблицаРасчетов, НераспределеннаяСумма, ОстаткиАвансов, СтрокаДокумента, Реквизиты)
	
	НераспределеннаяСуммаРуб = СтрокаДокумента.СуммаРуб;
	
	Для Каждого СтрокаОстатка Из ОстаткиАвансов Цикл
		
		Если НераспределеннаяСумма <= 0 Тогда
			Прервать;
		КонецЕсли;
		
		ЗачитываемыйАванс = Мин(НераспределеннаяСумма, СтрокаОстатка.СуммаРасчетов);
		Если ЗачитываемыйАванс <= 0 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаРасчетов = ТаблицаРасчетов.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрокаРасчетов, СтрокаДокумента);
		
		КоэффициентКурсаАванса = ?(НЕ СтрокаДокумента.РасчетыВВалюте, 1,
			?(СтрокаОстатка.СуммаРасчетов = 0, 0, СтрокаОстатка.СуммаРуб / СтрокаОстатка.СуммаРасчетов));
		
		КоэффициентКурсаВозврата = ?(НЕ СтрокаДокумента.РасчетыВВалюте, 1,
			?(СтрокаДокумента.СуммаРасчетов = 0, 0, СтрокаДокумента.СуммаРуб / СтрокаДокумента.СуммаРасчетов));
		
		Если НераспределеннаяСумма = СтрокаОстатка.СуммаРасчетов Тогда
			СтрокаРасчетов.КурсоваяРазница = НераспределеннаяСуммаРуб - СтрокаОстатка.СуммаРуб;
		Иначе
			СтрокаРасчетов.КурсоваяРазница = Окр(ЗачитываемыйАванс * (КоэффициентКурсаВозврата-КоэффициентКурсаАванса), 2);
		КонецЕсли;
		
		НераспределеннаяСумма = НераспределеннаяСумма - ЗачитываемыйАванс;
		НераспределеннаяСуммаРуб = НераспределеннаяСуммаРуб - Окр(ЗачитываемыйАванс * КоэффициентКурсаВозврата, 2);
		
		СтрокаОстатка.СуммаРасчетов = СтрокаОстатка.СуммаРасчетов - ЗачитываемыйАванс;
		СтрокаОстатка.СуммаРуб      = СтрокаОстатка.СуммаРуб      - Окр(ЗачитываемыйАванс * КоэффициентКурсаАванса, 2);
		
	КонецЦикла;

КонецПроцедуры

Функция МоментыВремениПроведенияДокументов(СписокДокументов)
	
	МоментыВремениПроведения = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ЖурналПроводокЕПСБУ.Период КАК Период,
	|	ЖурналПроводокЕПСБУ.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ЖурналПроводокЕПСБУ
	|ГДЕ
	|	ЖурналПроводокЕПСБУ.Регистратор В(&СписокДокументов)
	|	И ЖурналПроводокЕПСБУ.Активность";
	
	Запрос.УстановитьПараметр("СписокДокументов", СписокДокументов);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НовыйМомент = Новый МоментВремени(Выборка.Период, Выборка.Регистратор);
		МоментыВремениПроведения.Добавить(НовыйМомент);
	КонецЦикла;
	
	Возврат МоментыВремениПроведения;
	
КонецФункции

#КонецОбласти
