
#Область ПрограммныйИнтерфейс

// Возвращает массив КФО (КВД), по которым ведется налоговый учет по налогу на прибыль.
//
Функция ПолучитьМассивКФОдляНалоговогоУчета() Экспорт
	
	МассивКФО = Новый Массив;
	МассивКФО.Добавить(ПредопределенноеЗначение("Перечисление.КВД.Внебюджет"));
	
	Возврат МассивКФО;
	
КонецФункции

Функция ВедетсяНалоговыйУчетПоКФО(КФО) Экспорт
	
	Возврат (ПолучитьМассивКФОдляНалоговогоУчета().Найти(КФО) <> Неопределено);
	
КонецФункции

Функция ОтражатьВНалоговомУчете(Организация, Период, КФО) Экспорт
	
	Возврат ВедетсяНалоговыйУчетПоКФО(КФО)
		И НалоговыйУчетВызовСервера.ПлательщикНалогаНаПрибыль(Организация, Период);
	
КонецФункции

// Возвращает счет налогового учета (по налогу на прибыль), соответствующий счету бух.учета (кроме 109.00 и 106.хИ).
// Для счетов 109.00 и 106.хИ для определения счета налогового учета следует использовать функцию СчетРасходовНУ().
//
Функция СчетНУпоСчетуБУ(СчетБУ, НаДату, ДтКт="") Экспорт
	
	ВидСчетаБУ = НалоговыйУчетКлиентСервер.ВидСчетаБУ(СчетБУ);
	
	Если ВидСчетаБУ = "СчетЗатрат" Тогда
		// Для определения счета расходов НУ предназначена функция СчетРасходовНУ().
		Возврат ПредопределенноеЗначение("ПланСчетов.ЕПСБУ.ПустаяСсылка");
		
	ИначеЕсли ВидСчетаБУ = "СчетОС" ИЛИ ВидСчетаБУ = "СчетНПА" Тогда
		Возврат БухгалтерскийУчетКлиентСервер.СчетПоКоду("Н01", НаДату); // Основные средства.
		
	ИначеЕсли ВидСчетаБУ = "СчетНМА" Тогда
		Возврат БухгалтерскийУчетКлиентСервер.СчетПоКоду("Н04", НаДату); // Нематериальные активы.
		
	ИначеЕсли ВидСчетаБУ = "СчетАмортизацииОС" Тогда
		Возврат БухгалтерскийУчетКлиентСервер.СчетПоКоду("Н02", НаДату); // Амортизация основных средств.
		
	ИначеЕсли ВидСчетаБУ = "СчетАмортизацииНМА" Тогда
		Возврат БухгалтерскийУчетКлиентСервер.СчетПоКоду("Н05", НаДату); // Амортизация нематериальных активов.
		
	ИначеЕсли ВидСчетаБУ = "СчетПравПользованияИмуществом"
		  ИЛИ ВидСчетаБУ = "СчетПравПользованияНМА"
		  ИЛИ ВидСчетаБУ = "СчетАмортизацииПравПользованияИмуществом"
		  ИЛИ ВидСчетаБУ = "СчетАмортизацииПравПользованияНМА" Тогда
		Возврат БухгалтерскийУчетКлиентСервер.СчетПоКоду("НПВ", НаДату);
		
	ИначеЕсли ВидСчетаБУ = "СчетВложенийПраваПользованияНМА" Тогда
		// Неисключительные права пользования на результаты интеллектуальной деятельности не относятся к НМА (п.3 ст. 257 НК РФ).
		// Вложения в права пользования НМА (неисключительные) не формируют стоимость амортизируемого имущества,
		// а относятся на затраты налогового учета по налогу на прибыль в течение срока полезного использования.
		Возврат БухгалтерскийУчетКлиентСервер.СчетПоКоду("Н97", НаДату); // Расходы будущих периодов.
		
	ИначеЕсли ВидСчетаБУ = "СчетВложенийВНА" Тогда
		Возврат БухгалтерскийУчетКлиентСервер.СчетПоКоду("Н08", НаДату); // Вложения во внеоборотные активы.
		
	ИначеЕсли ВидСчетаБУ = "СчетМатериалов" ИЛИ ВидСчетаБУ = "СчетБиологическихАктивов" Тогда
		Возврат БухгалтерскийУчетКлиентСервер.СчетПоКоду("Н10", НаДату); // Материалы.
		
	ИначеЕсли ВидСчетаБУ = "СчетВложенийМЗ" ИЛИ ВидСчетаБУ = "СчетВложенийБА" Тогда
		Возврат БухгалтерскийУчетКлиентСервер.СчетПоКоду("Н15", НаДату); // Вложения в материальные запасы.
		
	ИначеЕсли ВидСчетаБУ = "СчетТоваровНаСкладах" Тогда
		Возврат БухгалтерскийУчетКлиентСервер.СчетПоКоду("Н41.01", НаДату); // Товары на складах.
		
	ИначеЕсли ВидСчетаБУ = "СчетТоваровВРознице" Тогда
		Возврат БухгалтерскийУчетКлиентСервер.СчетПоКоду("Н41.02", НаДату); // Товары в рознице.
		
	ИначеЕсли ВидСчетаБУ = "СчетТорговойНаценки" Тогда
		Возврат БухгалтерскийУчетКлиентСервер.СчетПоКоду("Н42", НаДату); // Наценка на товары.
		
	ИначеЕсли ВидСчетаБУ = "СчетГотовойПродукции" Тогда
		Возврат БухгалтерскийУчетКлиентСервер.СчетПоКоду("Н43", НаДату); // Готовая продукция.
		
	ИначеЕсли ВидСчетаБУ = "СчетРасчетовСПерсоналом" Тогда
		Возврат БухгалтерскийУчетКлиентСервер.СчетПоКоду("Н70", НаДату); // Расходы на оплату труда.
		
	ИначеЕсли ВидСчетаБУ = "СчетРасчетовСПокупателями"
		  ИЛИ ВидСчетаБУ = "СчетРасчетовСПоставщиками"
		  ИЛИ ВидСчетаБУ = "СчетРасчетовСПодотчетнымиЛицами"
		  ИЛИ ВидСчетаБУ = "СчетВложенийВФинансовыеАктивы"
		  ИЛИ ВидСчетаБУ = "СчетПрочихРасчетов" Тогда // Расчеты с дебиторами и кредиторами.
		Возврат БухгалтерскийУчетКлиентСервер.СчетПоКоду("НПВ", НаДату);
		
	ИначеЕсли ВидСчетаБУ = "СчетРасчетовПоНалогамИСборам" Тогда
		
		Если БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "303.02") Тогда // ФССБольничный
			Возврат БухгалтерскийУчетКлиентСервер.СчетПоКоду("Н69.01", НаДату);
		ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "303.10") Тогда // СтраховаяПенсия
			Возврат БухгалтерскийУчетКлиентСервер.СчетПоКоду("Н69.02", НаДату);
		ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "303.11") Тогда // НакопительнаяПенсия
			Возврат БухгалтерскийУчетКлиентСервер.СчетПоКоду("Н69.03", НаДату);
		ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "303.07") Тогда // ФФОМС
			Возврат БухгалтерскийУчетКлиентСервер.СчетПоКоду("Н69.06", НаДату);
		ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "303.08") Тогда // ТФОМС
			Возврат БухгалтерскийУчетКлиентСервер.СчетПоКоду("Н69.07", НаДату);
		ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "303.09") Тогда // ДополнительныеВзносыНаПенсию
			Возврат БухгалтерскийУчетКлиентСервер.СчетПоКоду("Н69.08", НаДату);
		ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "303.06") Тогда // ФССНесчастныйСлучай
			Возврат БухгалтерскийУчетКлиентСервер.СчетПоКоду("Н69.09", НаДату);
		Иначе
			Возврат БухгалтерскийУчетКлиентСервер.СчетПоКоду("НПВ", НаДату); // Прочие поступления и выбытия.
		КонецЕсли;
		
	ИначеЕсли ВидСчетаБУ = "СчетПрочихДоходов"
		  ИЛИ ВидСчетаБУ = "СчетПрочихРасходов" Тогда
		
		Если ДтКт = "Дт" Тогда
			Возврат БухгалтерскийУчетКлиентСервер.СчетПоКоду("Н91.02", НаДату);
		Иначе
			Возврат БухгалтерскийУчетКлиентСервер.СчетПоКоду("Н91.01", НаДату);
		КонецЕсли;
		
	ИначеЕсли ВидСчетаБУ = "СчетДБП" Тогда
		Возврат БухгалтерскийУчетКлиентСервер.СчетПоКоду("НПВ", НаДату);
		
	ИначеЕсли ВидСчетаБУ = "СчетРБП" Тогда
		Возврат БухгалтерскийУчетКлиентСервер.СчетПоКоду("Н97", НаДату);
		
	ИначеЕсли ВидСчетаБУ = "СчетРезервовПредстоящихРасходов" Тогда
		Возврат БухгалтерскийУчетКлиентСервер.СчетПоКоду("Н96", НаДату);
		
	КонецЕсли;
	
	Возврат ПредопределенноеЗначение("ПланСчетов.ЕПСБУ.ПустаяСсылка");
	
КонецФункции

// Возвращает счет расходов налогового учета (по налогу на прибыль), соответствующий счетам бух.учета 109.00, 106.хИ и 401.20
// с учетом правил определения прямых и косвенных расходов.
//
Функция СчетРасходовНУ(СчетБУ, СубконтоБУ1, СубконтоБУ2, СубконтоБУ3, КорСчетБУ, Организация, ИФО, Подразделение, НаДату) Экспорт
	
	Если НЕ ЗначениеЗаполнено(СчетБУ) Тогда
		Возврат ПредопределенноеЗначение("ПланСчетов.ЕПСБУ.ПустаяСсылка");
	КонецЕсли;
	
	Если БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "109.90") Тогда
		Возврат БухгалтерскийУчетКлиентСервер.СчетПоКоду("Н44", НаДату); // Всегда косвенные.
	ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "401.20") Тогда
		Возврат БухгалтерскийУчетКлиентСервер.СчетПоКоду("Н91.02", НаДату); // Не делятся на прямые и косвенные.
	КонецЕсли;
	
	// Для счетов 109.60, 109.70, 109.80 нужно определить тип расходов НУ - прямые или косвенные.
	ЭтоПрямыеРасходы = Ложь;
	
	ВидСубконтоВидыЗатрат = ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.ВидыЗатрат");
	СвойстваСчетаБУ = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(СчетБУ);
	
	ВидЗатрат = ПредопределенноеЗначение("Справочник.ВидыЗатрат.ПустаяСсылка");
	Если СвойстваСчетаБУ.ВидСубконто1 = ВидСубконтоВидыЗатрат И СубконтоБУ1<>Неопределено Тогда
		ВидЗатрат = СубконтоБУ1;
	ИначеЕсли  СвойстваСчетаБУ.ВидСубконто2 = ВидСубконтоВидыЗатрат И СубконтоБУ2<>Неопределено Тогда
		ВидЗатрат = СубконтоБУ2;
	ИначеЕсли  СвойстваСчетаБУ.ВидСубконто3 = ВидСубконтоВидыЗатрат И СубконтоБУ3<>Неопределено Тогда
		ВидЗатрат = СубконтоБУ3;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВидЗатрат) Тогда
		
		Правила = НалоговыйУчетПовтИспВызовСервера.ПравилаОпределенияПрямыхРасходов(ВидЗатрат, Организация, КонецГода(НаДату));
		Для Каждого Правило Из Правила Цикл
			
			Если ЗначениеЗаполнено(Правило.Счет)
				И НЕ СчетБУ = Правило.Счет
				И НЕ СчетБУ.ПринадлежитЭлементу(Правило.Счет) Тогда
				Продолжить;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ИФО) Тогда
				// Если ИФО в проводке БУ не указано, расходы будут отнесены к прямым только если
				// есть подходящее правило без указания ИФО (правило для всех ИФО).
				Если ЗначениеЗаполнено(Правило.ИФО) Тогда
					Продолжить;
				КонецЕсли;
			ИначеЕсли ЗначениеЗаполнено(Правило.ИФО)
				И НЕ ИФО = Правило.ИФО
				И НЕ ИФО.ПринадлежитЭлементу(Правило.ИФО) Тогда
				Продолжить;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(Подразделение) Тогда
				// Если подразделение в проводке БУ не указано, расходы будут отнесены к прямым только если
				// есть подходящее правило без указания подразделения (правило для всех подразделений).
				Если ЗначениеЗаполнено(Правило.Подразделение) Тогда
					Продолжить;
				КонецЕсли;
			ИначеЕсли ЗначениеЗаполнено(Правило.Подразделение)
				И НЕ Подразделение = Правило.Подразделение
				И НЕ Подразделение.ПринадлежитЭлементу(Правило.Подразделение) Тогда
				Продолжить;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(КорСчетБУ) Тогда
				// Если кор.счет БУ неизвестен, расходы будут отнесены к прямым только если
				// есть подходящее правило без указания кор.счета (правило для всех кор.счетов).
				Если ЗначениеЗаполнено(Правило.КорСчет) Тогда
					Продолжить;
				КонецЕсли;
			ИначеЕсли ЗначениеЗаполнено(Правило.КорСчет)
				И НЕ КорСчетБУ = Правило.КорСчет
				И НЕ КорСчетБУ.ПринадлежитЭлементу(Правило.КорСчет) Тогда
				Продолжить;
			КонецЕсли;
			
			ЭтоПрямыеРасходы = Истина; // Нашли подходящее правило.
			Прервать;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "109.60")
	 ИЛИ БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "106.2И,106.3И,106.4И") Тогда
		
		Если ЭтоПрямыеРасходы Тогда
			Возврат БухгалтерскийУчетКлиентСервер.СчетПоКоду("Н20.01", НаДату);
		Иначе
			Возврат БухгалтерскийУчетКлиентСервер.СчетПоКоду("Н20.02", НаДату);
		КонецЕсли;
		
	ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "110.60") Тогда
		
		Если ЭтоПрямыеРасходы Тогда
			Возврат БухгалтерскийУчетКлиентСервер.СчетПоКоду("Н20.11", НаДату);
		Иначе
			Возврат БухгалтерскийУчетКлиентСервер.СчетПоКоду("Н20.12", НаДату);
		КонецЕсли;
		
	ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "109.70") Тогда
		
		Если ЭтоПрямыеРасходы Тогда
			Возврат БухгалтерскийУчетКлиентСервер.СчетПоКоду("Н25.01", НаДату);
		Иначе
			Возврат БухгалтерскийУчетКлиентСервер.СчетПоКоду("Н25.02", НаДату);
		КонецЕсли;
		
	ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "110.70") Тогда
		
		Если ЭтоПрямыеРасходы Тогда
			Возврат БухгалтерскийУчетКлиентСервер.СчетПоКоду("Н25.11", НаДату);
		Иначе
			Возврат БухгалтерскийУчетКлиентСервер.СчетПоКоду("Н25.12", НаДату);
		КонецЕсли;
		
	ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "109.80") Тогда
		
		Если ЭтоПрямыеРасходы Тогда
			Возврат БухгалтерскийУчетКлиентСервер.СчетПоКоду("Н26.01", НаДату);
		Иначе
			Возврат БухгалтерскийУчетКлиентСервер.СчетПоКоду("Н26.02", НаДату);
		КонецЕсли;
		
	ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "110.80") Тогда
		
		Если ЭтоПрямыеРасходы Тогда
			Возврат БухгалтерскийУчетКлиентСервер.СчетПоКоду("Н26.11", НаДату);
		Иначе
			Возврат БухгалтерскийУчетКлиентСервер.СчетПоКоду("Н26.12", НаДату);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ПредопределенноеЗначение("ПланСчетов.ЕПСБУ.ПустаяСсылка");
	
КонецФункции

// Возвращает вид счета бух.учета по типу учитываемых активов и обязательств.
//
Функция ВидСчетаБУ(СчетБУ) Экспорт
	
	Если БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "109.00")
	 ИЛИ БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "110.00")
	 ИЛИ БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "106.2И,106.3И,106.4И") Тогда
		Возврат "СчетЗатрат";
		
	ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "101.00") Тогда
		Возврат "СчетОС";
		
	ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "102.00") Тогда
		Возврат "СчетНМА";
		
	ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "103.00") Тогда
		Возврат "СчетНПА";
		
	ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "111.40") Тогда
		Возврат "СчетПравПользованияИмуществом";
		
	ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "111.60") Тогда
		Возврат "СчетПравПользованияНМА";
		
	ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "104.00") Тогда
		
		СчетАмортизацииПравПользованияИмуществом = БухгалтерскийУчетКлиентСервер.СписокСчетов("104.40", '20180101');
		СчетАмортизацииПравПользованияНМА = БухгалтерскийУчетКлиентСервер.СписокСчетов("104.60");
		
		СчетаАмортизацииНМА = БухгалтерскийУчетКлиентСервер.СписокСчетов(
			"104.29,104.39,104.49,104.2D,104.2I,104.2N,104.2R,104.3D,104.3I,104.3N,104.3R");
		
		Если БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, СчетАмортизацииПравПользованияНМА) Тогда
			Возврат "СчетАмортизацииПравПользованияНМА";
		ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, СчетАмортизацииПравПользованияИмуществом) Тогда
			Возврат "СчетАмортизацииПравПользованияИмуществом";
		ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, СчетаАмортизацииНМА) Тогда
			Возврат "СчетАмортизацииНМА";
		Иначе
			Возврат "СчетАмортизацииОС";
		КонецЕсли;
		
	ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "105.00") Тогда
		
		Если БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "105.27,105.37") Тогда
			Возврат "СчетГотовойПродукции";
		ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "105.А8,105.В8") Тогда
			Возврат "СчетТоваровНаСкладах";
		ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "105.Б8,105.Г8") Тогда
			Возврат "СчетТоваровВРознице";
		ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "105.29,105.39") Тогда
			Возврат "СчетТорговойНаценки";
		Иначе
			Возврат "СчетМатериалов";
		КонецЕсли;
		
	ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "113.00") Тогда
		Возврат "СчетБиологическихАктивов";
		
	ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "106.00") Тогда
		
		Если БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "106.2П,106.3П,106.4П,106.56") Тогда
			Возврат "СчетВложенийМЗ"; // Вложения в материальные запасы.
		ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "106.27,106.37") Тогда
			Возврат "СчетВложенийБА"; // // Вложения в биологические активы.
		ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "106.60") Тогда
			Возврат "СчетВложенийПраваПользованияНМА"; // // Вложения в права пользования нематериальными активами.
		Иначе // Счета 106.2И,106.3И,106.4И отсекаются выше.
			Возврат "СчетВложенийВНА"; // Вложения во внеоборотные активы.
		КонецЕсли;
			
	ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "206.10,302.10,304.02,304.03") Тогда
		Возврат "СчетРасчетовСПерсоналом";
		
	ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "205.00,209.00") Тогда
		Возврат "СчетРасчетовСПокупателями"; // По доходам.
		
	ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "206.00,302.00") Тогда
		Возврат "СчетРасчетовСПоставщиками"; // По принятым обязательствам.
		
	ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "208.00") Тогда
		Возврат "СчетРасчетовСПодотчетнымиЛицами";
		
	ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "303.00") Тогда
		Возврат "СчетРасчетовПоНалогамИСборам";
		
	//ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "210.00,304.00") Тогда
	ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "210.00,304.00,207.00,301.00") Тогда
		Возврат "СчетПрочихРасчетов";
		
	ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "215.00") Тогда
		Возврат "СчетВложенийВФинансовыеАктивы";
		
	ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "401.10") Тогда
		Возврат "СчетПрочихДоходов";
		
	ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "401.20") Тогда
		Возврат "СчетПрочихРасходов";
		
	ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "401.30") Тогда
		Возврат "СчетФинансовыйРезультатПрошлыхЛет";
		
	ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "401.40") Тогда
		Возврат "СчетДБП";
		
	ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "401.50") Тогда
		Возврат "СчетРБП";
		
	ИначеЕсли БухгалтерскийУчетКлиентСервер.СчетВИерархии(СчетБУ, "401.60") Тогда
		Возврат "СчетРезервовПредстоящихРасходов";
		
	КонецЕсли;
	
	Возврат ПредопределенноеЗначение("ПланСчетов.ЕПСБУ.ПустаяСсылка");
	
КонецФункции

Функция ЭтоПрочиеРасходы(СчетБУ) Экспорт
	
	Возврат НалоговыйУчетКлиентСервер.ВидСчетаБУ(СчетБУ) = "СчетПрочихРасходов";
	
КонецФункции

// Возвращает массив счетов расходов НУ, на которые возможно отнести сумму амортизационной премии.
//
Функция ВозможныеСчетаУчетаЗатратПоАмортизационнойПремии() Экспорт
	
	// Расходы в виде капитальных вложений, предусмотренные п. 9 статьи 258 НК РФ,
	// признаются в качестве косвенных расходов (абз. 2 п. 3 статьи 272 НК РФ).
	// Таким образом, амортизационная премия может отражаться только в косвенных расходах.
	МассивСчетов = Новый Массив;
	МассивСчетов.Добавить("Н20.02");
	МассивСчетов.Добавить("Н25.02");
	МассивСчетов.Добавить("Н26.02");
	МассивСчетов.Добавить("Н44");
	
	Возврат МассивСчетов;
	
КонецФункции

Функция НачислениеНалогаНаПрибыльПоКЭК189(ДатаНачисления) Экспорт
	
	// Согласно Приказу Минфина России от 29.11.2017 N 209н (ред. от 13.05.2019),
	// с 01.01.2019 г. налог на прибыль начисляется и уплачивается по КЭК 189.
	Возврат (НачалоМесяца(ДатаНачисления) >= Дата('20190101'));
	
КонецФункции

#КонецОбласти
