//
// Возвращаемое значение:
//	Строка	- имя команды формы, гарантированно отсутствующей на форме.
Функция ПолучитьУникальноеИмяКомандыФормы(Форма, ЖелаемоеИмяКоманды) Экспорт
	
	ШаблонИмени = "%1%2";
	
