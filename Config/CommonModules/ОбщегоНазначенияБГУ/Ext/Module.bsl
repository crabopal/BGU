	НоваяКоманда = Форма.Команды.Добавить(ИмяКоманды);
	НоваяКоманда.Действие		= "Подключаемый_МеханизмГолосованияКомиссии_КомандаУстановитьРешениеЗаВВыделенныхСтроках";
	НоваяКоманда.Заголовок		= НСтр("ru='Установить решение ""За"" в выделенных строках'");
	НоваяКоманда.Отображение	= ОтображениеКнопки.Текст;
	НоваяКоманда.Подсказка		= "";
	
	
	// Команда "Установить решение "За" во всех строках"
	
	ОбозначениеКоманды = "КомандаУстановитьРешениеЗаВоВсехСтроках";
	ИмяКоманды = ОбщегоНазначенияБГУ.ПолучитьУникальноеИмяКомандыФормы(Форма, ОбозначениеКоманды);
	НастройкиМеханизма.ИменаКоманд.Вставить(ОбозначениеКоманды, ИмяКоманды);
	
	НоваяКоманда = Форма.Команды.Добавить(ИмяКоманды);
	НоваяКоманда.Действие		= "Подключаемый_МеханизмГолосованияКомиссии_КомандаУстановитьРешениеЗаВоВсехСтроках";
	НоваяКоманда.Заголовок		= НСтр("ru='Установить решение ""За"" во всех строках'");
	НоваяКоманда.Отображение	= ОтображениеКнопки.Текст;
	НоваяКоманда.Подсказка		= "";
	
	
	// Команда "Установить решение "Против" в выделенных строках"
	
	ОбозначениеКоманды = "КомандаУстановитьРешениеПротивВВыделенныхСтроках";
	ИмяКоманды = ОбщегоНазначенияБГУ.ПолучитьУникальноеИмяКомандыФормы(Форма, ОбозначениеКоманды);
	НастройкиМеханизма.ИменаКоманд.Вставить(ОбозначениеКоманды, ИмяКоманды);
	
	НоваяКоманда = Форма.Команды.Добавить(ИмяКоманды);
	НоваяКоманда.Действие		= "Подключаемый_МеханизмГолосованияКомиссии_КомандаУстановитьРешениеПротивВВыделенныхСтроках";
	НоваяКоманда.Заголовок		= НСтр("ru='Установить решение ""Против"" в выделенных строках'");
	НоваяКоманда.Отображение	= ОтображениеКнопки.Текст;
	НоваяКоманда.Подсказка		= "";
	
	
	// Команда "Установить решение "Против" во всех строках"
	
	ОбозначениеКоманды = "КомандаУстановитьРешениеПротивВоВсехСтроках";
	ИмяКоманды = ОбщегоНазначенияБГУ.ПолучитьУникальноеИмяКомандыФормы(Форма, ОбозначениеКоманды);
	НастройкиМеханизма.ИменаКоманд.Вставить(ОбозначениеКоманды, ИмяКоманды);
	
	НоваяКоманда = Форма.Команды.Добавить(ИмяКоманды);
	НоваяКоманда.Действие		= "Подключаемый_МеханизмГолосованияКомиссии_КомандаУстановитьРешениеПротивВоВсехСтроках";
	НоваяКоманда.Заголовок		= НСтр("ru='Установить решение ""Против"" во всех строках'");
	НоваяКоманда.Отображение	= ОтображениеКнопки.Текст;
	НоваяКоманда.Подсказка		= "";
	
КонецПроцедуры

Процедура МеханизмГолосованияКомиссии_ДобавитьЭлементыФормы(Знач Форма, ЭлементПанелиГолосования, ЭлементМенюУстановитьРешение, ЭлементГруппыКолонокГолосования, НастройкиМеханизма)
	
	// Панель голосования
	
	МеханизмГолосованияКомиссии_ДобавитьЭлементыФормы_ПанельГолосования(Форма, ЭлементПанелиГолосования, НастройкиМеханизма);
	
	// Подменю команд "Установить решение"
	
	МеханизмГолосованияКомиссии_ДобавитьЭлементыФормы_КнопкиКомандУстановитьРешение(Форма, ЭлементМенюУстановитьРешение, НастройкиМеханизма);
	
	// Колонки таблицы
	
	МеханизмГолосованияКомиссии_ДобавитьЭлементыФормы_КолонкиТаблицы(Форма, ЭлементГруппыКолонокГолосования, НастройкиМеханизма);
	
КонецПроцедуры

Процедура МеханизмГолосованияКомиссии_ДобавитьЭлементыФормы_ПанельГолосования(Знач Форма, ЭлементПанелиГолосования, НастройкиМеханизма)
	
	// Панель голосования
	
	НастройкиМеханизма.ИменаЭлементов.Вставить("ПанельГолосования", ЭлементПанелиГолосования.Имя);
	
	ЭлементПанелиГолосования.ЦветФона = ЦветаСтиля.ФонУправляющегоПоля;
	ЭлементПанелиГолосования.Подсказка = "";
	ЭлементПанелиГолосования.ОтображатьЗаголовок = Ложь;
	ЭлементПанелиГолосования.РастягиватьПоГоризонтали = Ложь;
	
	Для Каждого Элемент Из ЭлементПанелиГолосования.ПодчиненныеЭлементы Цикл
		Элемент.Видимость = Ложь;
	КонецЦикла;
	
	
	// Надпись "Голосование"
	
	ОбозначениеЭлемента = "НадписьГолосование";
	
	ИмяЭлемента = ОбщегоНазначенияБГУ.ПолучитьУникальноеИмяЭлементаФормы(Форма, ОбозначениеЭлемента);
	НастройкиМеханизма.ИменаЭлементов.Вставить(ОбозначениеЭлемента, ИмяЭлемента);
	
	НовыйЭлемент = Форма.Элементы.Добавить(ИмяЭлемента, Тип("ДекорацияФормы"), ЭлементПанелиГолосования);
	НовыйЭлемент.Вид						= ВидДекорацииФормы.Надпись;
	НовыйЭлемент.Заголовок					= НСтр("ru='Голосование:'");
	НовыйЭлемент.ОтображениеПодсказки		= ОтображениеПодсказки.Нет;
	
	
	// Поле "Сотрудник"
	
	ОбозначениеРеквизита = "Сотрудник";
	
	ИмяРеквизита = НастройкиМеханизма.ИменаРеквизитов[ОбозначениеРеквизита];
	ИмяЭлемента = ОбщегоНазначенияБГУ.ПолучитьУникальноеИмяЭлементаФормы(Форма, ИмяРеквизита);
	НастройкиМеханизма.ИменаЭлементов.Вставить(ОбозначениеРеквизита, ИмяЭлемента);
	
	НовыйЭлемент = Форма.Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), ЭлементПанелиГолосования);
	НовыйЭлемент.Вид						= ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным				= ИмяРеквизита;
	НовыйЭлемент.ПоложениеЗаголовка			= ПоложениеЗаголовкаЭлементаФормы.Нет;
	НовыйЭлемент.Подсказка					= НСтр("ru='Сотрудник выбирается из присутствующих членов комиссии'");
	НовыйЭлемент.ПодсказкаВвода				= НСтр("ru='Сотрудник'");
	НовыйЭлемент.КнопкаВыбора				= Ложь;
	НовыйЭлемент.КнопкаСоздания				= Ложь;
	НовыйЭлемент.КнопкаОткрытия				= Ложь;
	НовыйЭлемент.КнопкаВыпадающегоСписка	= Истина;
	НовыйЭлемент.РежимВыбораИзСписка		= Истина;
	НовыйЭлемент.КнопкаОчистки				= Истина;
	НовыйЭлемент.ОтображениеПодсказки		= ОтображениеПодсказки.Кнопка;
	НовыйЭлемент.ИсторияВыбораПриВводе		= ИсторияВыбораПриВводе.НеИспользовать;
	НовыйЭлемент.Ширина						= 24;
	
	// Кнопка "Сохранить результаты голосования"	
	
	ОбозначениеЭлемента = "КнопкаСохранитьРезультатыГолосования";
	ИмяЭлемента = ОбщегоНазначенияБГУ.ПолучитьУникальноеИмяЭлементаФормы(Форма, ОбозначениеЭлемента);
	НастройкиМеханизма.ИменаЭлементов.Вставить(ОбозначениеЭлемента, ИмяЭлемента);
	
	НовыйЭлемент = Форма.Элементы.Добавить(ИмяЭлемента, Тип("КнопкаФормы"), ЭлементПанелиГолосования);
	НовыйЭлемент.ИмяКоманды = НастройкиМеханизма.ИменаКоманд.КомандаСохранитьРезультатыГолосования;
	
	
	// Надпись "Файл"
	
	ОбозначениеЭлемента = "НадписьФайл";
	
	ИмяЭлемента = ОбщегоНазначенияБГУ.ПолучитьУникальноеИмяЭлементаФормы(Форма, ОбозначениеЭлемента);
	НастройкиМеханизма.ИменаЭлементов.Вставить(ОбозначениеЭлемента, ИмяЭлемента);
	
	НовыйЭлемент = Форма.Элементы.Добавить(ИмяЭлемента, Тип("ДекорацияФормы"), ЭлементПанелиГолосования);
	НовыйЭлемент.Вид					= ВидДекорацииФормы.Надпись;
	НовыйЭлемент.Заголовок				= НСтр("ru='Файл:'");
	НовыйЭлемент.ОтображениеПодсказки	= ОтображениеПодсказки.Нет;
	
	
	// Надпись "Файл не выбран"
	
	ОбозначениеЭлемента = "НадписьФайлНеВыбран";
	
	ИмяЭлемента = ОбщегоНазначенияБГУ.ПолучитьУникальноеИмяЭлементаФормы(Форма, ОбозначениеЭлемента);
	НастройкиМеханизма.ИменаЭлементов.Вставить(ОбозначениеЭлемента, ИмяЭлемента);
	
	НовыйЭлемент = Форма.Элементы.Добавить(ИмяЭлемента, Тип("ДекорацияФормы"), ЭлементПанелиГолосования);
	НовыйЭлемент.Вид						= ВидДекорацииФормы.Надпись;
	НовыйЭлемент.Гиперссылка				= Истина;
	НовыйЭлемент.Заголовок					= НСтр("ru='Нажмите для выбора'");
	НовыйЭлемент.Ширина						= 30;
	НовыйЭлемент.МаксимальнаяШирина			= 50;
	НовыйЭлемент.МаксимальнаяВысота			= 1;
	НовыйЭлемент.РастягиватьПоГоризонтали	= Истина;
	НовыйЭлемент.Подсказка					= НСтр("ru='Прикрепить файл'");
	
	
	// Надпись "Удалить файл"
	
	ОбозначениеЭлемента = "НадписьУдалитьФайл";
	
	ИмяЭлемента = ОбщегоНазначенияБГУ.ПолучитьУникальноеИмяЭлементаФормы(Форма, ОбозначениеЭлемента);
	НастройкиМеханизма.ИменаЭлементов.Вставить(ОбозначениеЭлемента, ИмяЭлемента);
	
	НовыйЭлемент = Форма.Элементы.Добавить(ИмяЭлемента, Тип("ДекорацияФормы"), ЭлементПанелиГолосования);
	НовыйЭлемент.Вид							= ВидДекорацииФормы.Картинка;
	Попытка
		НовыйЭлемент.Картинка					= БиблиотекаКартинок.Открепить;
	Исключение
	КонецПопытки;
	НовыйЭлемент.Гиперссылка					= Истина;
	НовыйЭлемент.ВертикальноеПоложениеВГруппе	= ВертикальноеПоложениеЭлемента.Центр;
	НовыйЭлемент.Видимость						= Ложь;
	НовыйЭлемент.Подсказка						= НСтр("ru='Открепить файл'");
	
	
	// Надпись "Файл сотрудника"
	
	ОбозначениеРеквизита = "ФайлСотрудника";
	
	ИмяРеквизита = НастройкиМеханизма.ИменаРеквизитов[ОбозначениеРеквизита];
	ИмяЭлемента = ОбщегоНазначенияБГУ.ПолучитьУникальноеИмяЭлементаФормы(Форма, ИмяРеквизита);
	НастройкиМеханизма.ИменаЭлементов.Вставить(ОбозначениеРеквизита, ИмяЭлемента);
	
	НовыйЭлемент = Форма.Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), ЭлементПанелиГолосования);
	НовыйЭлемент.Вид						= ВидПоляФормы.ПолеНадписи;
	НовыйЭлемент.Гиперссылка				= Истина;
	НовыйЭлемент.ПутьКДанным				= ИмяРеквизита;
	НовыйЭлемент.ПоложениеЗаголовка			= ПоложениеЗаголовкаЭлементаФормы.Нет;
	НовыйЭлемент.РастягиватьПоГоризонтали	= Ложь;
	НовыйЭлемент.Подсказка					= НСтр("ru='Открыть файл'");
	
КонецПроцедуры

Процедура МеханизмГолосованияКомиссии_ДобавитьЭлементыФормы_КолонкиТаблицы(Знач Форма, ЭлементГруппыКолонокГолосования, НастройкиМеханизма)
	
	ИмяТабличнойЧасти = НастройкиМеханизма.ИмяТабличнойЧасти;
	
	
	// Общая группа колонок голосования
	
	НастройкиМеханизма.ИменаЭлементовКолонок.Вставить("ОбщаяГруппаКолонок", ЭлементГруппыКолонокГолосования.Имя);
	
	ЭлементГруппыКолонокГолосования.ЦветФонаЗаголовка			= ЦветаСтиля.ФонУправляющегоПоля;
	ЭлементГруппыКолонокГолосования.Группировка					= ГруппировкаКолонок.Горизонтальная;
	ЭлементГруппыКолонокГолосования.ОтображатьЗаголовок			= Ложь;
	ЭлементГруппыКолонокГолосования.ОтображатьВШапке			= Ложь;
	ЭлементГруппыКолонокГолосования.РастягиватьПоГоризонтали	= Истина;
	ЭлементГруппыКолонокГолосования.Подсказка					= "";
	
	Для Каждого Элемент Из ЭлементГруппыКолонокГолосования.ПодчиненныеЭлементы Цикл
		Элемент.Видимость = Ложь;
	КонецЦикла;
	
	
	// Колонка "Решение сотрудника (голос)"
	
	ОбозначениеРеквизита = "РешениеСотрудникаПоРезолюции";
	
	ИмяКолонки = НастройкиМеханизма.ИменаКолонок[ОбозначениеРеквизита];
	ИмяЭлемента = ОбщегоНазначенияБГУ.ПолучитьУникальноеИмяЭлементаФормы(Форма, ИмяТабличнойЧасти + ИмяКолонки);
	НастройкиМеханизма.ИменаЭлементовКолонок.Вставить(ОбозначениеРеквизита, ИмяЭлемента);
	
	НовыйЭлемент = Форма.Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), ЭлементГруппыКолонокГолосования);
	НовыйЭлемент.Вид						= ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным				= "Объект." + ИмяТабличнойЧасти + "." + ИмяКолонки;
	НовыйЭлемент.Заголовок					= НСтр("ru='Решение'");
	НовыйЭлемент.ФиксацияВТаблице			= ФиксацияВТаблице.Лево;
	Попытка
		НовыйЭлемент.КартинкаШапки			= БиблиотекаКартинок.ПользовательСистемыВзаимодействия;
	Исключение
	КонецПопытки;
	НовыйЭлемент.ЦветФонаЗаголовка			= ЦветаСтиля.ФонУправляющегоПоля;
	НовыйЭлемент.РедактированиеТекста		= Ложь;
	НовыйЭлемент.Ширина						= 8;
	НовыйЭлемент.ШиринаВыпадающегоСписка	= 5;
	НовыйЭлемент.РастягиватьПоГоризонтали	= Ложь;
	НовыйЭлемент.Подсказка					= "";
	
	
	// Группа колонок "% за"
	
	ИмяЭлементаГруппа = ОбщегоНазначенияБГУ.ПолучитьУникальноеИмяЭлементаФормы(Форма, ИмяТабличнойЧасти + "ГруппаПроцентГолосовЗа");
	
	НовыйЭлементГруппа = Форма.Элементы.Добавить(ИмяЭлементаГруппа, Тип("ГруппаФормы"), ЭлементГруппыКолонокГолосования);
	НовыйЭлементГруппа.Заголовок			= НСтр("ru='% за'");
	НовыйЭлементГруппа.Группировка			= ГруппировкаКолонок.ВЯчейке;
	НовыйЭлементГруппа.ОтображатьЗаголовок	= Истина;
	НовыйЭлементГруппа.ОтображатьВШапке		= Истина;
	НовыйЭлементГруппа.ФиксацияВТаблице		= ФиксацияВТаблице.Лево;
	Попытка
		НовыйЭлементГруппа.КартинкаШапки	= БиблиотекаКартинок.ГрупповоеОбсуждение;
	Исключение
	КонецПопытки;
	НовыйЭлементГруппа.ЦветФонаЗаголовка	= ЦветаСтиля.ФонУправляющегоПоля;
	НовыйЭлементГруппа.Подсказка			= "";
	
	
	// Колонка "Итог голосования"
	
	ОбозначениеРеквизита = "ИтогГолосования";
	
	ИмяКолонки = НастройкиМеханизма.ИменаКолонок[ОбозначениеРеквизита];
	ИмяЭлемента = ОбщегоНазначенияБГУ.ПолучитьУникальноеИмяЭлементаФормы(Форма, ИмяТабличнойЧасти + ИмяКолонки);
	НастройкиМеханизма.ИменаЭлементовКолонок.Вставить(ОбозначениеРеквизита, ИмяЭлемента);
	
	НовыйЭлемент = Форма.Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), НовыйЭлементГруппа);
	НовыйЭлемент.Вид						= ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным				= "Объект." + ИмяТабличнойЧасти + "." + ИмяКолонки;
	НовыйЭлемент.ФиксацияВТаблице			= ФиксацияВТаблице.Лево;
	НовыйЭлемент.ТолькоПросмотр				= Истина;
	НовыйЭлемент.Формат						= "ЧЦ=5; ЧДЦ=2";
	НовыйЭлемент.ОтображатьВШапке			= Ложь;
	НовыйЭлемент.Ширина						= 4;
	НовыйЭлемент.РастягиватьПоГоризонтали	= Ложь;
	НовыйЭлемент.Подсказка					= "";
	
	
	// Колонка "Резолюция комиссии одобрена"
	
	ОбозначениеРеквизита = "РезолюцияКомиссииОдобрена";
	
	ИмяКолонки = НастройкиМеханизма.ИменаКолонок[ОбозначениеРеквизита];
	ИмяЭлемента = ОбщегоНазначенияБГУ.ПолучитьУникальноеИмяЭлементаФормы(Форма, ИмяТабличнойЧасти + ИмяКолонки);
	НастройкиМеханизма.ИменаЭлементовКолонок.Вставить(ОбозначениеРеквизита, ИмяЭлемента);
	
	НовыйЭлемент = Форма.Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), НовыйЭлементГруппа);
	НовыйЭлемент.Вид					= ВидПоляФормы.ПолеФлажка;
	НовыйЭлемент.ПутьКДанным			= "Объект." + ИмяТабличнойЧасти + "." + ИмяКолонки;
	НовыйЭлемент.ФиксацияВТаблице		= ФиксацияВТаблице.Лево;
	НовыйЭлемент.ТолькоПросмотр			= Истина;
	НовыйЭлемент.ФорматРедактирования	= "ЧЦ=5; ЧДЦ=2";
	НовыйЭлемент.ОтображатьВШапке		= Ложь;
	НовыйЭлемент.Подсказка				= "";
	
КонецПроцедуры

Процедура МеханизмГолосованияКомиссии_ДобавитьЭлементыФормы_КнопкиКомандУстановитьРешение(Знач Форма, ЭлементМенюУстановитьРешение, НастройкиМеханизма)
	
	// Самая внешняя группа меню
	
	ЭлементМенюУстановитьРешение.Заголовок	= НСтр("ru='Установить решение'");
	ЭлементМенюУстановитьРешение.ЦветФона	= ЦветаСтиля.ФонУправляющегоПоля;
	Попытка
		ЭлементМенюУстановитьРешение.Картинка = БиблиотекаКартинок.ПользовательСистемыВзаимодействия;
	Исключение
	КонецПопытки;
	ЭлементМенюУстановитьРешение.Подсказка	= "";
	
	Для Каждого Элемент Из ЭлементМенюУстановитьРешение.ПодчиненныеЭлементы Цикл
		Элемент.Видимость = Ложь;
	КонецЦикла;
	
	
	// Группа кнопок "Во всех строках"
	
	ОбозначениеЭлемента = "ГруппаКнопокУстановитьРешениеВоВсехСтроках";
	ИмяЭлемента = ОбщегоНазначенияБГУ.ПолучитьУникальноеИмяЭлементаФормы(Форма, ОбозначениеЭлемента);
	НастройкиМеханизма.ИменаЭлементов.Вставить(ОбозначениеЭлемента, ИмяЭлемента);
	
	ГруппаКнопок = Форма.Элементы.Добавить(ИмяЭлемента, Тип("ГруппаФормы"), ЭлементМенюУстановитьРешение);
	ГруппаКнопок.Вид		= ВидГруппыФормы.ГруппаКнопок;
	ГруппаКнопок.Заголовок	= НСтр("ru='Установить решение во всех строках'");
	
	// Кнопка "За"
	
	ОбозначениеЭлемента = "КнопкаУстановитьРешениеЗаВоВсехСтроках";
	ИмяЭлемента = ОбщегоНазначенияБГУ.ПолучитьУникальноеИмяЭлементаФормы(Форма, ОбозначениеЭлемента);
	НастройкиМеханизма.ИменаЭлементов.Вставить(ОбозначениеЭлемента, ИмяЭлемента);
	
	НовыйЭлемент = Форма.Элементы.Добавить(ИмяЭлемента, Тип("КнопкаФормы"), ГруппаКнопок);
	НовыйЭлемент.ИмяКоманды = НастройкиМеханизма.ИменаКоманд.КомандаУстановитьРешениеЗаВоВсехСтроках;
	
	// Кнопка "Против"
	
	ОбозначениеЭлемента = "КнопкаУстановитьРешениеПротивВоВсехСтроках";
	ИмяЭлемента = ОбщегоНазначенияБГУ.ПолучитьУникальноеИмяЭлементаФормы(Форма, ОбозначениеЭлемента);
	НастройкиМеханизма.ИменаЭлементов.Вставить(ОбозначениеЭлемента, ИмяЭлемента);
	
	НовыйЭлемент = Форма.Элементы.Добавить(ИмяЭлемента, Тип("КнопкаФормы"), ГруппаКнопок);
	НовыйЭлемент.ИмяКоманды = НастройкиМеханизма.ИменаКоманд.КомандаУстановитьРешениеПротивВоВсехСтроках;
	
	
	// Группа кнопок "В выделенных строках"
	
	ОбозначениеЭлемента = "ГруппаКнопокУстановитьРешениеВВыделенныхСтроках";
	ИмяЭлемента = ОбщегоНазначенияБГУ.ПолучитьУникальноеИмяЭлементаФормы(Форма, ОбозначениеЭлемента);
	НастройкиМеханизма.ИменаЭлементов.Вставить(ОбозначениеЭлемента, ИмяЭлемента);
	
	ГруппаКнопок = Форма.Элементы.Добавить(ИмяЭлемента, Тип("ГруппаФормы"), ЭлементМенюУстановитьРешение);
	ГруппаКнопок.Вид		= ВидГруппыФормы.ГруппаКнопок;
	ГруппаКнопок.Заголовок	= НСтр("ru='Установить решение в выделенных строках'");
	
	// Кнопка "За"
	
	ОбозначениеЭлемента = "КнопкаУстановитьРешениеЗаВВыделенныхСтроках";
	ИмяЭлемента = ОбщегоНазначенияБГУ.ПолучитьУникальноеИмяЭлементаФормы(Форма, ОбозначениеЭлемента);
	НастройкиМеханизма.ИменаЭлементов.Вставить(ОбозначениеЭлемента, ИмяЭлемента);
	
	НовыйЭлемент = Форма.Элементы.Добавить(ИмяЭлемента, Тип("КнопкаФормы"), ГруппаКнопок);
	НовыйЭлемент.ИмяКоманды = НастройкиМеханизма.ИменаКоманд.КомандаУстановитьРешениеЗаВВыделенныхСтроках;
	
	// Кнопка "Против"
	
	ОбозначениеЭлемента = "КнопкаУстановитьРешениеПротивВВыделенныхСтроках";
	ИмяЭлемента = ОбщегоНазначенияБГУ.ПолучитьУникальноеИмяЭлементаФормы(Форма, ОбозначениеЭлемента);
	НастройкиМеханизма.ИменаЭлементов.Вставить(ОбозначениеЭлемента, ИмяЭлемента);
	
	НовыйЭлемент = Форма.Элементы.Добавить(ИмяЭлемента, Тип("КнопкаФормы"), ГруппаКнопок);
	НовыйЭлемент.ИмяКоманды = НастройкиМеханизма.ИменаКоманд.КомандаУстановитьРешениеПротивВВыделенныхСтроках;
	
КонецПроцедуры

Процедура МеханизмГолосованияКомиссии_ДобавитьОбработчикиСобытийЭлементовФормы(Знач Форма, НастройкиМеханизма)
	
	// Панель "Голосование"
	
	// Сотрудник
	
	Элемент = Форма.Элементы[НастройкиМеханизма.ИменаЭлементов.Сотрудник];
	
	ИмяСобытия		= "ПриИзменении";
	ИмяОбработчика	= "Подключаемый_МеханизмГолосованияКомиссии_СотрудникПриИзменении";
	Элемент.УстановитьДействие(ИмяСобытия, ИмяОбработчика);
	
	ИмяСобытия		= "НачалоВыбора";
	ИмяОбработчика	= "Подключаемый_МеханизмГолосованияКомиссии_СотрудникНачалоВыбора";
	Элемент.УстановитьДействие(ИмяСобытия, ИмяОбработчика);
	
	
	// Надпись "Файл не выбран"
	
	Элемент = Форма.Элементы[НастройкиМеханизма.ИменаЭлементов.НадписьФайлНеВыбран];
	
	ИмяСобытия		= "Нажатие";
	ИмяОбработчика	= "Подключаемый_МеханизмГолосованияКомиссии_НадписьФайлНеВыбранНажатие";
	Элемент.УстановитьДействие(ИмяСобытия, ИмяОбработчика);
	
	
	// Надпись "Удалить файл"
	
	Элемент = Форма.Элементы[НастройкиМеханизма.ИменаЭлементов.НадписьУдалитьФайл];
	
	ИмяСобытия		= "Нажатие";
	ИмяОбработчика	= "Подключаемый_МеханизмГолосованияКомиссии_НадписьУдалитьФайлНажатие";
	Элемент.УстановитьДействие(ИмяСобытия, ИмяОбработчика);
	
	
	// Колонка "Решение сотрудника (голос)"
	
	Элемент = Форма.Элементы[НастройкиМеханизма.ИменаЭлементовКолонок.РешениеСотрудникаПоРезолюции];
	
	ИмяСобытия		= "ОбработкаВыбора";
	ИмяОбработчика	= "Подключаемый_МеханизмГолосованияКомиссии_РешениеСотрудникаПоРезолюцииОбработкаВыбора";
	Элемент.УстановитьДействие(ИмяСобытия, ИмяОбработчика);
	
КонецПроцедуры

Процедура МеханизмГолосованияКомиссии_НастроитьДоступностьЭлементов(Форма)
	
	Объект = Форма.Объект;
	
	НастройкиМеханизма = Форма.НастройкиМеханизмаГолосованияКомиссии;
	
	ИменаРеквизитов							= НастройкиМеханизма.ИменаЭлементов;
	ИменаЭлементов							= НастройкиМеханизма.ИменаЭлементов;
	ИменаЭлементовКолонок					= НастройкиМеханизма.ИменаЭлементовКолонок;
	ЕстьПравоЗаписиРезультатовГолосования	= НастройкиМеханизма.ЕстьПравоЗаписиРезультатовГолосования;
	ЕстьПравоПрисоединенияФайлов			= НастройкиМеханизма.ЕстьПравоПрисоединенияФайлов;
	
	Сотрудник = Форма[ИменаРеквизитов.Сотрудник];
	
	ДокументЗаписан = (Не Объект.Ссылка.Пустая());
	
	СотрудникУказан = ЗначениеЗаполнено(Сотрудник);
	
	// Панель голосования
	Форма.Элементы[ИменаЭлементов.ПанельГолосования].Видимость = Истина;
	
	// Поле Сотрудник
	Форма.Элементы[ИменаЭлементов.Сотрудник].Доступность = ДокументЗаписан;
	
	// Видимость гиперссылок прикрепленного файла настраивается аналогично РаботаСФайламиБГУ.ПолучитьФайлСотрудника
	ФайлПрисоединен = ЗначениеЗаполнено(Форма[ИменаРеквизитов.ФайлСотрудника]);
	Форма.Элементы[ИменаЭлементов.ФайлСотрудника].Видимость			= ЕстьПравоПрисоединенияФайлов И ФайлПрисоединен;
	Форма.Элементы[ИменаЭлементов.НадписьУдалитьФайл].Видимость		= ЕстьПравоПрисоединенияФайлов И ФайлПрисоединен;
	Форма.Элементы[ИменаЭлементов.НадписьФайлНеВыбран].Видимость	= ЕстьПравоПрисоединенияФайлов И Не ФайлПрисоединен;
	Форма.Элементы[ИменаЭлементов.НадписьФайл].Видимость			= ЕстьПравоПрисоединенияФайлов;
	
	// Кнопки команд
	Форма.Элементы[ИменаЭлементов.КнопкаУстановитьРешениеЗаВоВсехСтроках].Видимость				= СотрудникУказан И ЕстьПравоЗаписиРезультатовГолосования;
	Форма.Элементы[ИменаЭлементов.КнопкаУстановитьРешениеПротивВоВсехСтроках].Видимость			= СотрудникУказан И ЕстьПравоЗаписиРезультатовГолосования;
	Форма.Элементы[ИменаЭлементов.КнопкаУстановитьРешениеЗаВВыделенныхСтроках].Видимость		= СотрудникУказан И ЕстьПравоЗаписиРезультатовГолосования;
	Форма.Элементы[ИменаЭлементов.КнопкаУстановитьРешениеПротивВВыделенныхСтроках].Видимость	= СотрудникУказан И ЕстьПравоЗаписиРезультатовГолосования;
	Форма.Элементы[ИменаЭлементов.КнопкаСохранитьРезультатыГолосования].Видимость				= ЕстьПравоЗаписиРезультатовГолосования;
	
	// Колонки табличной части
	Форма.Элементы[ИменаЭлементовКолонок.ОбщаяГруппаКолонок].Видимость = СотрудникУказан;
	
КонецПроцедуры

Процедура МеханизмГолосованияКомиссии_ЗаполнитьКолонкиТаблицы(Форма)
	
	Объект = Форма.Объект;
	
	ТабличнаяЧасть = Объект[Форма.НастройкиМеханизмаГолосованияКомиссии.ИмяТабличнойЧасти];
	
	ИменаРеквизитов	= Форма.НастройкиМеханизмаГолосованияКомиссии.ИменаРеквизитов;
	ИменаКолонок	= Форма.НастройкиМеханизмаГолосованияКомиссии.ИменаКолонок;
	
	Сотрудник = Форма[ИменаРеквизитов.Сотрудник];
	
	ОчищающаяСтруктура = Новый Структура();
	ОчищающаяСтруктура.Вставить(ИменаКолонок.РешениеСотрудникаПоРезолюции);
	ОчищающаяСтруктура.Вставить(ИменаКолонок.ИтогГолосования);
	ОчищающаяСтруктура.Вставить(ИменаКолонок.РезолюцияКомиссииОдобрена);
	
	ЗаполнитьРезультатыГолосования = Не Объект.Ссылка.Пустая()
		И ЗначениеЗаполнено(Сотрудник)
		И ЗначениеЗаполнено(Объект.Комиссия)
		И ЗначениеЗаполнено(Объект.Организация);
		
	Если ЗаполнитьРезультатыГолосования Тогда
		
		РезультатГолосованияСотрудника = ОбщегоНазначенияБГУ.РезультатыГолосованияСотрудникаПоДокументу(
			Сотрудник, Объект.Ссылка, Объект.Комиссия, Объект.Организация);
			
		РезультатГолосованияКомиссии = ОбщегоНазначенияБГУ.РезультатыГолосованияКомиссийПоДокументам(
			Объект.Ссылка, Объект.Комиссия, Объект.Организация);
			
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из ТабличнаяЧасть Цикл
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ОчищающаяСтруктура);
		
		Если ЗаполнитьРезультатыГолосования Тогда
			
			Если РезультатГолосованияСотрудника.Количество() > 0 Тогда
				
				Результаты = РезультатГолосованияСотрудника.Найти(СтрокаТаблицы.ИдентификаторСтроки, "ИдентификаторСтроки");
				
				Если Результаты <> Неопределено Тогда
					СтрокаТаблицы.РешениеСотрудникаПоРезолюции = Результаты.РезультатГолосования;
				КонецЕсли;
				
			КонецЕсли;
			
			Если РезультатГолосованияКомиссии.Количество() > 0 Тогда
				
				ОтборПоИдентификаторуСтроки = Новый Структура("Документ, ИдентификаторСтроки",
					Объект.Ссылка, СтрокаТаблицы.ИдентификаторСтроки);
					
				РезультатыГолосованияПоСтроке = РезультатГолосованияКомиссии.НайтиСтроки(ОтборПоИдентификаторуСтроки);
				
				Если РезультатыГолосованияПоСтроке.Количество() > 0 Тогда
					СтрокаТаблицы.ИтогГолосования = РезультатыГолосованияПоСтроке[0].ИтогГолосования;
					СтрокаТаблицы.РезолюцияКомиссииОдобрена = РезультатыГолосованияПоСтроке[0].РезолюцияКомиссииОдобрена;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура МеханизмГолосованияКомиссии_УстановитьУсловноеОформление(Форма, НастройкиМеханизма)
	
	ПутиКДанным = Новый Структура();
	ПутиКДанным.Вставить("РешениеСотрудникаПоРезолюции", "Объект." + НастройкиМеханизма.ИмяТабличнойЧасти + "." + НастройкиМеханизма.ИменаКолонок.РешениеСотрудникаПоРезолюции);
	
	//---
	// Решение сотрудника (голос) "за"
	//---
	
	ЭлементУО = Форма.УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Решение сотрудника (голос) ""за""'");
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ОтметкаПоложительногоВыполненияЗадачи);
	
	// Условие
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение	= Новый ПолеКомпоновкиДанных(ПутиКДанным.РешениеСотрудникаПоРезолюции);
	Условие.ВидСравнения	= ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение	= Перечисления.РезультатыГолосованияЧленовКомиссии.За;
	
	// Оформляемые поля
	ИмяЭлемента = НастройкиМеханизма.ИменаЭлементовКолонок.РешениеСотрудникаПоРезолюции;
	ПолеДляОформления = ЭлементУО.Поля.Элементы.Добавить();
	ПолеДляОформления.Поле = Новый ПолеКомпоновкиДанных(ИмяЭлемента);
	
	//---
	// Решение сотрудника (голос) "против"
	//---
	
	ЭлементУО = Форма.УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Решение сотрудника (голос) ""против""'");
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ОтметкаОтрицательногоВыполненияЗадачи);
	
	// Условие
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение	= Новый ПолеКомпоновкиДанных(ПутиКДанным.РешениеСотрудникаПоРезолюции);
	Условие.ВидСравнения	= ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение	= Перечисления.РезультатыГолосованияЧленовКомиссии.Против;
	
	// Оформляемые поля
	ИмяЭлемента = НастройкиМеханизма.ИменаЭлементовКолонок.РешениеСотрудникаПоРезолюции;
	ПолеДляОформления = ЭлементУО.Поля.Элементы.Добавить();
	ПолеДляОформления.Поле = Новый ПолеКомпоновкиДанных(ИмяЭлемента);
	
	
	Если Не НастройкиМеханизма.ЕстьПравоЗаписиРезультатовГолосования Тогда
		//---
		// Только просмотр решения сотрудника при отсутствии прав записи
		//---
			
		ЭлементУО = Форма.УсловноеОформление.Элементы.Добавить();
		ЭлементУО.Представление = НСтр("ru='Только просмотр решения сотрудника при отсутствии прав записи'");
		
		// Оформление
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
		
		// Условие
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение	= Истина;
		Условие.ВидСравнения	= ВидСравненияКомпоновкиДанных.Равно;
		Условие.ПравоеЗначение	= Истина;
		
		// Оформляемые поля
		ИмяЭлемента = НастройкиМеханизма.ИменаЭлементовКолонок.РешениеСотрудникаПоРезолюции;
		ПолеДляОформления = ЭлементУО.Поля.Элементы.Добавить();
		ПолеДляОформления.Поле = Новый ПолеКомпоновкиДанных(ИмяЭлемента);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область РезолюцииКомиссий

Процедура ИнициализироватьФормуДляВыбораРезолюцииКомиссий_ДобавитьРеквизитыФормы(Форма, ИмяРеквизитаНастроек, НастройкиМеханизма)
	
	ДобавляемыеРеквизиты = Новый Массив();
	
	// РЕКВИЗИТЫ ФОРМЫ
	
	НовыйРеквизитФормы = Новый РеквизитФормы(
		ИмяРеквизитаНастроек,
		Новый ОписаниеТипов());
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизитФормы);
	
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
КонецПроцедуры

Процедура ИнициализироватьФормуДляВыбораРезолюцииКомиссий_ЗаполнитьМассивРезолюций(Форма, НастройкиМеханизма)
	
	НастройкиМеханизма.МассивРезолюций = ПолучитьМассивРезолюцийДляВидаДокумента(Форма.Объект.Ссылка);
	
КонецПроцедуры

Процедура ИнициализироватьФормуДляВыбораРезолюцииКомиссий_ЗаполнитьСписокВыбораРезолюций(Форма, ЭлементРезолюцииКомиссии, НастройкиМеханизма)
	
	МассивРезолюций = НастройкиМеханизма.МассивРезолюций;
	
	СписокВыбора = ЭлементРезолюцииКомиссии.СписокВыбора;
	
	СписокВыбора.Очистить();
	
	Для Каждого Элемент Из МассивРезолюций Цикл
		СписокВыбора.Добавить(Элемент.Текст);
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьТаблицуРезолюцийДляВидаДокумента(ИмяДокумента)
	
	Перем КодыФорм;
	
	ПривязкаФорм = ОбщегоНазначенияБГУПовтИсп.ПолучитьПривязкуФормКДокументам();
	
	ПривязкаРезолюций = ОбщегоНазначенияБГУПовтИсп.ПолучитьПривязкуРезолюцийКФормам();
	
	Если НЕ ПривязкаФорм.Свойство(ИмяДокумента, КодыФорм) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаРезолюций = ПолучитьПустуюТаблицуРезолюцийФормы();
	
	Для Каждого КодФормы Из КодыФорм Цикл
		ТаблицаРезолюцийФормы = ПривязкаРезолюций.Получить(КодФормы);
		
		Если ТаблицаРезолюцийФормы = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ТаблицаРезолюцийФормы, ТаблицаРезолюций);
	КонецЦикла;
	
	Возврат ТаблицаРезолюций;
	
КонецФункции

#КонецОбласти

#Область МеханизмОзнакомленияСотрудников

Процедура МеханизмОзнакомленияСотрудников_ИнициализироватьНастройкиМеханизма(Форма, ДопустимыРазличныеДатыДействийОдногоСотрудника = Ложь, Знач ОтборСотрудника)
	
	Если ОтборСотрудника = Неопределено Тогда
		ОтборСотрудника = Новый Соответствие();
	КонецЕсли;
	
	ТаблицаНастроекДокумента = МеханизмОзнакомленияСотрудников_ПолучитьТаблицуНастроекДокумента(Форма);
	
	РезультатПроверки = МеханизмОзнакомленияСотрудников_ПроверитьКорректностьПараметров(Форма, ТаблицаНастроекДокумента);
	
	СоответствиеВидДействия			= РезультатПроверки.СоответствиеВидДействия;
	СоответствиеИмяТабличнойЧасти	= РезультатПроверки.СоответствиеИмяТабличнойЧасти;
	ПорядокВидовДействий			= РезультатПроверки.ПорядокВидовДействий;
	
	ДопустимоРедактирование = ОбщегоНазначенияБГУКлиентСервер.МеханизмОзнакомленияСотрудников_ДопустимоРедактирование(Форма);
	
	УстанавливатьДоступностьЭлементов = Истина;
	
	Если МеханизмОзнакомленияСотрудников_ЭтоНастройкиИзПОД(Форма.НастройкиМеханизмаОзнакомленияСотрудников) Тогда
		// Переданы настройки из ПОД.
		УстанавливатьДоступностьЭлементов = Форма.НастройкиМеханизмаОзнакомленияСотрудников.УстанавливатьДоступностьЭлементов;
	КонецЕсли;
	
	НастройкиМеханизма = Новый Структура();
	НастройкиМеханизма.Вставить("ТабличныеЧасти",									Новый Структура());
	НастройкиМеханизма.Вставить("СоответствиеВидДействия",							СоответствиеВидДействия); // для определения вида действия по имени табличной части
	НастройкиМеханизма.Вставить("СоответствиеИмяТабличнойЧасти",					СоответствиеИмяТабличнойЧасти); // для определения имени табличной части по виду действия
	НастройкиМеханизма.Вставить("ПорядокВидовДействий",								ПорядокВидовДействий); // определяется порядком добавления строк настроек при подключении механизма
	НастройкиМеханизма.Вставить("СообщениеОКонфликтахДействийПриЗаписи",			Неопределено);
	НастройкиМеханизма.Вставить("ДопустимоРедактирование",							ДопустимоРедактирование);
	НастройкиМеханизма.Вставить("ДопустимыРазличныеДатыДействийОдногоСотрудника",	ДопустимыРазличныеДатыДействийОдногоСотрудника);
	НастройкиМеханизма.Вставить("ЕстьПравоЗаписиРезультатовОзнакомления",			Пользователи.РолиДоступны("ДобавлениеИзменениеРезультатовОзнакомленияСотрудников,ПолныеПрава"));
	НастройкиМеханизма.Вставить("ОтборСотрудника",									ОтборСотрудника);
	НастройкиМеханизма.Вставить("УстанавливатьДоступностьЭлементов",				УстанавливатьДоступностьЭлементов);
	
	Для Каждого ВидДействия Из ПорядокВидовДействий Цикл
		ИмяТабличнойЧасти = НастройкиМеханизма.СоответствиеИмяТабличнойЧасти.Получить(ВидДействия);
		
		НастройкиТабличнойЧасти = Новый Структура();
		НастройкиТабличнойЧасти.Вставить("ИменаРеквизитов",	Новый Структура());
		НастройкиТабличнойЧасти.Вставить("ИменаКоманд",		Новый Структура());
		НастройкиТабличнойЧасти.Вставить("ИменаЭлементов",	Новый Структура());
		
		Поиск = Новый Структура("ИмяТабличнойЧасти", ИмяТабличнойЧасти);
		
		НастройкиТабличнойЧасти.Вставить("ДопустимоЕдиновременноеДействиеВсехСотрудников", ТаблицаНастроекДокумента.НайтиСтроки(Поиск)[0].ДопустимоЕдиновременноеДействиеВсехСотрудников);
		
		// Реквизиты
		
		ОбозначениеРеквизита = "Сотрудник";
		НастройкиТабличнойЧасти.ИменаРеквизитов.Вставить(ОбозначениеРеквизита, МеханизмОзнакомленияСотрудников_СформироватьИмяРеквизита(ОбозначениеРеквизита, ИмяТабличнойЧасти));
		
		ОбозначениеРеквизита = "СотрудникПрежнееЗначение";
		НастройкиТабличнойЧасти.ИменаРеквизитов.Вставить(ОбозначениеРеквизита, МеханизмОзнакомленияСотрудников_СформироватьИмяРеквизита(ОбозначениеРеквизита, ИмяТабличнойЧасти));
		
		ОбозначениеРеквизита = "Флажок";
		НастройкиТабличнойЧасти.ИменаРеквизитов.Вставить(ОбозначениеРеквизита, МеханизмОзнакомленияСотрудников_СформироватьИмяРеквизита(ОбозначениеРеквизита, ИмяТабличнойЧасти));
		
		ОбозначениеРеквизита = "Дата";
		НастройкиТабличнойЧасти.ИменаРеквизитов.Вставить(ОбозначениеРеквизита, МеханизмОзнакомленияСотрудников_СформироватьИмяРеквизита(ОбозначениеРеквизита, ИмяТабличнойЧасти));
		
		ОбозначениеРеквизита = "Модифицированность";
		НастройкиТабличнойЧасти.ИменаРеквизитов.Вставить(ОбозначениеРеквизита, МеханизмОзнакомленияСотрудников_СформироватьИмяРеквизита(ОбозначениеРеквизита, ИмяТабличнойЧасти));
		
		// Команды
		
		ОбозначениеКоманды = "СохранитьРезультаты";
		НастройкиТабличнойЧасти.ИменаКоманд.Вставить(ОбозначениеКоманды, МеханизмОзнакомленияСотрудников_СформироватьИмяРеквизита(ОбозначениеКоманды, ИмяТабличнойЧасти));
		
		// Элементы формы
		
		ОбозначениеЭлемента = "ПанельСтраницы";
		НастройкиТабличнойЧасти.ИменаЭлементов.Вставить(ОбозначениеЭлемента, МеханизмОзнакомленияСотрудников_СформироватьИмяРеквизита(ОбозначениеЭлемента, ИмяТабличнойЧасти));
		
		ОбозначениеЭлемента = "СтраницаРедактированиеНедоступно";
		НастройкиТабличнойЧасти.ИменаЭлементов.Вставить(ОбозначениеЭлемента, МеханизмОзнакомленияСотрудников_СформироватьИмяРеквизита(ОбозначениеЭлемента, ИмяТабличнойЧасти));
		
		ОбозначениеЭлемента = "СтраницаДанные";
		НастройкиТабличнойЧасти.ИменаЭлементов.Вставить(ОбозначениеЭлемента, МеханизмОзнакомленияСотрудников_СформироватьИмяРеквизита(ОбозначениеЭлемента, ИмяТабличнойЧасти));
		
		ОбозначениеЭлемента = "СтраницаДоступОтсутствует";
		НастройкиТабличнойЧасти.ИменаЭлементов.Вставить(ОбозначениеЭлемента, МеханизмОзнакомленияСотрудников_СформироватьИмяРеквизита(ОбозначениеЭлемента, ИмяТабличнойЧасти));
		
		ОбозначениеЭлемента = "КолонкаСотрудник";
		НастройкиТабличнойЧасти.ИменаЭлементов.Вставить(ОбозначениеЭлемента, ИмяТабличнойЧасти + "Сотрудник");
		
		НастройкиМеханизма.ТабличныеЧасти.Вставить(ИмяТабличнойЧасти, НастройкиТабличнойЧасти);
	КонецЦикла;
	
	Форма.НастройкиМеханизмаОзнакомленияСотрудников = НастройкиМеханизма;
	
КонецПроцедуры

Функция МеханизмОзнакомленияСотрудников_СоздатьНастройкиИзПОД()
	
	// Передаем настройки через реквизит формы, потому что для существующих документов
	// ПОД настраивает формы в обработчике события ПриЧтенииНаСервере,
	// а механизм ознакомления инициализируется позже, в обработчике события ПриСозданииНаСервере.
	
	НастройкиМеханизма = Новый Структура();
	НастройкиМеханизма.Вставить("ЭтоНастройкиИзПОД", Истина);
	НастройкиМеханизма.Вставить("УстанавливатьДоступностьЭлементов", Ложь);
	
	Возврат НастройкиМеханизма;
	
КонецФункции

Функция МеханизмОзнакомленияСотрудников_ЭтоНастройкиИзПОД(НастройкиМеханизма)
	
	Возврат ТипЗнч(НастройкиМеханизма) = Тип("Структура")
		И НастройкиМеханизма.Свойство("ЭтоНастройкиИзПОД")
		И НастройкиМеханизма.ЭтоНастройкиИзПОД = Истина;
	
КонецФункции

Функция МеханизмОзнакомленияСотрудников_ПолучитьТаблицуНастроекДокумента(Параметр)
	
	Перем ИмяДокумента;
	
	Если ТипЗнч(Параметр) = Тип("Строка") Тогда
		ИмяДокумента = Параметр;
	Иначе
		Форма = Параметр;
		
		ДокументОбъект = Форма.Объект;
		
		ТипДокумента = ТипЗнч(ДокументОбъект.Ссылка);
		
		ИмяДокумента = Метаданные.НайтиПоТипу(ТипДокумента).Имя;
	КонецЕсли;
	
	ТаблицаНастроекДокумента = МеханизмОзнакомленияСотрудников_ПустаяТаблицаНастроекДокумента();
	
	Документы[ИмяДокумента].МеханизмОзнакомленияСотрудников_НастройкиДокумента(ТаблицаНастроекДокумента);
	
	Возврат ТаблицаНастроекДокумента;
	
КонецФункции

Функция МеханизмОзнакомленияСотрудников_ПустаяТаблицаНастроекДокумента()
	
	ТаблицаНастроек = Новый ТаблицаЗначений();
	ТаблицаНастроек.Колонки.Добавить("ИмяТабличнойЧасти",								Новый ОписаниеТипов("Строка"));
	ТаблицаНастроек.Колонки.Добавить("ВидДействияСотрудникаСДокументом",				Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДействийСотрудникаСДокументом"));
	ТаблицаНастроек.Колонки.Добавить("ДопустимоЕдиновременноеДействиеВсехСотрудников",	Новый ОписаниеТипов("Булево"));
	
	Возврат ТаблицаНастроек;
	
КонецФункции

Функция МеханизмОзнакомленияСотрудников_ПроверитьКорректностьПараметров(Форма, ТаблицаНастроекДокумента)
	
	ТекстШаблон = НСтр("ru = '#МеханизмОзнакомленияСотрудников. Некорректные настройки документа %1. %2'");
	
	ТипДокумента = ТипЗнч(Форма.Объект.Ссылка);
	
	МетаданныеДокумента = Метаданные.НайтиПоТипу(ТипДокумента);
	
	ИмяДокумента = МетаданныеДокумента.Имя;
	
	Если ТаблицаНастроекДокумента.Количество() = 0 Тогда
		ТекстСообщения = СтрШаблон(ТекстШаблон, ИмяДокумента, НСтр("ru = 'Таблица настроек документа не заполнена'"));
		
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;
	
	ИменаТабличныхЧастей = Новый Массив();
	
	СоответствиеВидДействия = Новый Соответствие();
	СоответствиеИмяТабличнойЧасти = Новый Соответствие();
	ПорядокВидовДействий = Новый Массив();
	
	Для Каждого СтрокаТаблицыНастроек Из ТаблицаНастроекДокумента Цикл
		ИмяТабличнойЧасти					= СтрокаТаблицыНастроек.ИмяТабличнойЧасти;
		ВидДействияСотрудникаСДокументом	= СтрокаТаблицыНастроек.ВидДействияСотрудникаСДокументом;
		
		Если Не ЗначениеЗаполнено(ИмяТабличнойЧасти) Тогда
			ТекстСообщения = СтрШаблон(ТекстШаблон, ИмяДокумента, НСтр("ru = 'Не заполнено поле ИмяТабличнойЧасти в настройках документа'"));
			
			ВызватьИсключение ТекстСообщения;
		КонецЕсли;
		
		ОтсутствуетТабличнаяЧасть = (МетаданныеДокумента.ТабличныеЧасти.Найти(ИмяТабличнойЧасти) = Неопределено);
		
		Если ОтсутствуетТабличнаяЧасть Тогда
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Отсутствует табличная часть ""%1"", указанная в настройках документа'"), ИмяТабличнойЧасти);
			
			ТекстСообщения = СтрШаблон(ТекстШаблон, ИмяДокумента, ТекстСообщения);
			
			ВызватьИсключение ТекстСообщения;
		КонецЕсли;
		
		УжеВстречаласьТабличнаяЧасть = (ИменаТабличныхЧастей.Найти(ИмяТабличнойЧасти) <> Неопределено);
		
		Если УжеВстречаласьТабличнаяЧасть Тогда
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Табличная часть ""%1"" указана в настройках документа более одного раза'"), ИмяТабличнойЧасти);
			
			ТекстСообщения = СтрШаблон(ТекстШаблон, ИмяДокумента, ТекстСообщения);
			
			ВызватьИсключение ТекстСообщения;
		КонецЕсли;
		
		ИменаТабличныхЧастей.Добавить(ИмяТабличнойЧасти);
		
		Если Не ЗначениеЗаполнено(ВидДействияСотрудникаСДокументом) Тогда
			ТекстСообщения = СтрШаблон(ТекстШаблон, ИмяДокумента, НСтр("ru = 'Не заполнено поле ВидДействияСотрудникаСДокументом в настройках документа'"));
			
			ВызватьИсключение ТекстСообщения;
		КонецЕсли;
		
		СоответствиеВидДействия.Вставить(ИмяТабличнойЧасти, ВидДействияСотрудникаСДокументом);
		СоответствиеИмяТабличнойЧасти.Вставить(ВидДействияСотрудникаСДокументом, ИмяТабличнойЧасти);
		ПорядокВидовДействий.Добавить(ВидДействияСотрудникаСДокументом);
	КонецЦикла;
	
	РезультатПроверки = Новый Структура();
	РезультатПроверки.Вставить("СоответствиеВидДействия",		СоответствиеВидДействия);
	РезультатПроверки.Вставить("СоответствиеИмяТабличнойЧасти",	СоответствиеИмяТабличнойЧасти);
	РезультатПроверки.Вставить("ПорядокВидовДействий",			ПорядокВидовДействий);
	
	Возврат РезультатПроверки;
	
КонецФункции

Процедура МеханизмОзнакомленияСотрудников_ЗаполнитьРезультатыОзнакомленияСотрудника(Форма, ДополнительныеПараметры)
	
	Объект = Форма.Объект;
	
	ИмяТабличнойЧасти	= ДополнительныеПараметры.ИмяТабличнойЧасти;
	ИменаРеквизитов		= ДополнительныеПараметры.ИменаРеквизитов;
	
	Сотрудник = Форма[ИменаРеквизитов.Сотрудник];
	
	ВидДействия = Форма.НастройкиМеханизмаОзнакомленияСотрудников.СоответствиеВидДействия.Получить(ИмяТабличнойЧасти);
	
	РезультатыДействия = МеханизмОзнакомленияСотрудников_ПрочитатьРезультатыДействияСотрудника(Сотрудник, Объект.Ссылка, Объект.Организация, ВидДействия);
	
	Флажок	= Ложь;
	Дата	= '00010101';
	
	Если РезультатыДействия.Количество() > 0 Тогда
		Дата = РезультатыДействия[0].Дата;
		
		Если ЗначениеЗаполнено(Дата) Тогда
			Флажок = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Форма[ИменаРеквизитов.Флажок]	= Флажок;
	Форма[ИменаРеквизитов.Дата]		= Дата;
	
КонецПроцедуры

Функция МеханизмОзнакомленияСотрудников_ПрочитатьРезультатыДействияСотрудника(Сотрудник, Документ, Организация, ВидДействия)
	
	РезультатыДействия = Новый ТаблицаЗначений();
	
	Если Не ЗначениеЗаполнено(Сотрудник)
		ИЛИ Не ЗначениеЗаполнено(Документ)
		ИЛИ Не ЗначениеЗаполнено(Организация) Тогда
		Возврат РезультатыДействия;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РезультатыОзнакомленияСотрудников.Дата КАК Дата
	               |ИЗ
	               |	РегистрСведений.РезультатыОзнакомленияСотрудников КАК РезультатыОзнакомленияСотрудников
	               |ГДЕ
	               |	РезультатыОзнакомленияСотрудников.Организация = &Организация
	               |	И РезультатыОзнакомленияСотрудников.Сотрудник = &Сотрудник
	               |	И РезультатыОзнакомленияСотрудников.ДокументОснование = &ДокументОснование
	               |	И РезультатыОзнакомленияСотрудников.ВидДействия = &ВидДействия";
	Запрос.УстановитьПараметр("Организация",		Организация);
	Запрос.УстановитьПараметр("Сотрудник",			Сотрудник);
	Запрос.УстановитьПараметр("ДокументОснование",	Документ);
	Запрос.УстановитьПараметр("ВидДействия",		ВидДействия);
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатыДействия = Запрос.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат РезультатыДействия;
	
КонецФункции

Функция МеханизмОзнакомленияСотрудников_СформироватьИмяРеквизита(ОбозначениеРеквизита, ИмяТабличнойЧасти)
	
	Возврат МеханизмОзнакомленияСотрудников_ПрефиксИменРеквизитов()
		+ ИмяТабличнойЧасти + "_" + ОбозначениеРеквизита;
	
КонецФункции

Функция МеханизмОзнакомленияСотрудников_ПрефиксИменРеквизитов()
	
	Возврат "МеханизмОзнакомленияСотрудников_";
	
КонецФункции

Процедура МеханизмОзнакомленияСотрудников_ЗаполнитьКолонкиОзнакомления(Форма)
	
	Перем ЕстьКонфликтыДействий;
	
	Объект = Форма.Объект;
	
	ТаблицаДействияСотрудников = МеханизмОзнакомленияСотрудников_ПрочитатьДействияСотрудниковПоДокументуВЦелом(Объект.Ссылка, Объект.Организация);
	
	НастройкиМеханизма = Форма.НастройкиМеханизмаОзнакомленияСотрудников;
	
	Поиск = Новый Структура();
	
	Для Каждого ЭлементОписания Из НастройкиМеханизма.ТабличныеЧасти Цикл
		ИмяТабличнойЧасти		= ЭлементОписания.Ключ;
		ОписаниеТабличнойЧасти	= ЭлементОписания.Значение;
		
		ВидДействия = НастройкиМеханизма.СоответствиеВидДействия.Получить(ИмяТабличнойЧасти);
		
		Для Каждого СтрокаТабличнойЧасти Из Объект[ИмяТабличнойЧасти] Цикл
			Сотрудник = СтрокаТабличнойЧасти.Сотрудник;
			
			Если Не ЗначениеЗаполнено(Сотрудник) Тогда
				Продолжить;
			КонецЕсли;
			
			Поиск.Вставить("Сотрудник",		Сотрудник);
			Поиск.Вставить("ВидДействия",	ВидДействия);
			
			Дата = '00010101';
			
			Если ТаблицаДействияСотрудников.Количество() > 0 Тогда
				МассивСтрок = ТаблицаДействияСотрудников.НайтиСтроки(Поиск);
				
				Если МассивСтрок.Количество() > 0 Тогда
					Дата = МассивСтрок[0].Дата;
				КонецЕсли;
			КонецЕсли;
			
			Флажок	= ЗначениеЗаполнено(Дата);
			
			СтрокаТабличнойЧасти.Дата	= Дата;
			СтрокаТабличнойЧасти.Флажок	= Флажок;
		КонецЦикла;
	КонецЦикла;
	
	МеханизмОзнакомленияСотрудников_ДиагностироватьКонфликтыДействий(Форма, ТаблицаДействияСотрудников, ЕстьКонфликтыДействий);
	
	Если ЕстьКонфликтыДействий Тогда
		СообщениеОКонфликтахДействий = МеханизмОзнакомленияСотрудников_СформироватьСообщениеОКонфликтахДействий(Форма, ТаблицаДействияСотрудников);
		
		ОбщегоНазначения.СообщитьПользователю(
			СтрШаблон(НСтр("ru='Справочно: %1'"), СообщениеОКонфликтахДействий.ТекстСообщения),
			Форма.Объект.Ссылка,
			"Объект." + ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТабличнойЧасти, СообщениеОКонфликтахДействий.НомерСтроки, "Сотрудник"));
	КонецЕсли;
	
КонецПроцедуры

Функция МеханизмОзнакомленияСотрудников_ПрочитатьДействияСотрудниковПоДокументуВЦелом(Документ, Организация)
	
	Если Не ЗначениеЗаполнено(Документ)
		ИЛИ Не ЗначениеЗаполнено(Организация) Тогда
		РезультатыОзнакомленияСотрудников = Новый ТаблицаЗначений;
		РезультатыОзнакомленияСотрудников.Колонки.Добавить("Сотрудник");
		РезультатыОзнакомленияСотрудников.Колонки.Добавить("ВидДействия");
		РезультатыОзнакомленияСотрудников.Колонки.Добавить("Дата");
		
		Возврат РезультатыОзнакомленияСотрудников;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РезультатыОзнакомленияСотрудников.Сотрудник КАК Сотрудник,
	               |	РезультатыОзнакомленияСотрудников.ВидДействия КАК ВидДействия,
	               |	РезультатыОзнакомленияСотрудников.Дата КАК Дата
	               |ИЗ
	               |	РегистрСведений.РезультатыОзнакомленияСотрудников КАК РезультатыОзнакомленияСотрудников
	               |ГДЕ
	               |	РезультатыОзнакомленияСотрудников.Организация = &Организация
	               |	И РезультатыОзнакомленияСотрудников.ДокументОснование = &ДокументОснование";
	Запрос.УстановитьПараметр("Организация",		Организация);
	Запрос.УстановитьПараметр("ДокументОснование",	Документ);
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатыОзнакомленияСотрудников = Запрос.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат РезультатыОзнакомленияСотрудников;
	
КонецФункции

Процедура МеханизмОзнакомленияСотрудников_ЗаписатьТаблицуДействий(Форма, ТаблицаДействий)
	
	ДокументОбъект = Форма.Объект;
	
	ДокументСсылка	= ДокументОбъект.Ссылка;
	Организация		= ДокументОбъект.Организация;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Для Каждого СтрокаТаблицы Из ТаблицаДействий Цикл
		Если Не СтрокаТаблицы.Записывать Тогда
			Продолжить;
		КонецЕсли;
		
		НаборЗаписей = РегистрыСведений.РезультатыОзнакомленияСотрудников.СоздатьНаборЗаписей();
		
		НаборЗаписей.Отбор.Организация.Установить(Организация);
		НаборЗаписей.Отбор.ДокументОснование.Установить(ДокументСсылка);
		НаборЗаписей.Отбор.Сотрудник.Установить(СтрокаТаблицы.Сотрудник);
		НаборЗаписей.Отбор.ВидДействия.Установить(СтрокаТаблицы.ВидДействия);
		
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() > 0 Тогда
			НаборЗаписей.Очистить();
		КонецЕсли;
		
		НаборЗаписей.Записывать = Истина;
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.Дата) Тогда
			НоваяЗапись = НаборЗаписей.Добавить();
			
			НоваяЗапись.Организация			= Организация;
			НоваяЗапись.ДокументОснование	= ДокументСсылка;
			НоваяЗапись.Сотрудник			= СтрокаТаблицы.Сотрудник;
			НоваяЗапись.ВидДействия			= СтрокаТаблицы.ВидДействия;
			
			НоваяЗапись.Дата = СтрокаТаблицы.Дата;
		КонецЕсли;
		
		НаборЗаписей.Записать(Истина);
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура МеханизмОзнакомленияСотрудников_УстановитьУсловноеОформление(Форма)
	
	УсловноеОформление = Форма.УсловноеОформление;
	
	ПредставлениеШаблон = НСтр("ru='Колонки данных механизма в табличной части ""%1"" при недоступном редактировании (МеханизмОзнакомленияСотрудников)'");
	
	ШрифтНаклонный = Новый Шрифт(,,,Истина);
	
	НастройкиМеханизма = Форма.НастройкиМеханизмаОзнакомленияСотрудников;
	
	ТабличныеЧасти = НастройкиМеханизма.ТабличныеЧасти;
	
	Для Каждого ЭлементОписания Из ТабличныеЧасти Цикл
		ИмяТабличнойЧасти = ЭлементОписания.Ключ;
		
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ЭлементУО.Представление = СтрШаблон(ПредставлениеШаблон, ИмяТабличнойЧасти);
		
		// Условия
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("МеханизмОзнакомленияСотрудников_ДопустимоРедактирование");
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Условие.ПравоеЗначение = Ложь;
		
		// Оформление
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстИнформационнойНадписи);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Шрифт", ШрифтНаклонный);
		
		// Оформляемые поля
		ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТабличнойЧасти + "Флажок");
		
		ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТабличнойЧасти + "Дата");
	КонецЦикла;
	
КонецПроцедуры

Процедура МеханизмОзнакомленияСотрудников_УстановитьОтборСотрудника(Форма)
	
	// Если установлен элемент отбора, то:
	// - по указанному виду действия устанавливается указанный сотрудник, выбор иного сотрудника запрещен;
	// - по всем остальным видам действий запрещается указание и выбор любого сотрудника.
	
	НастройкиМеханизма = Форма.НастройкиМеханизмаОзнакомленияСотрудников;
	
	СоответствиеВидДействия	= НастройкиМеханизма.СоответствиеВидДействия;
	ОтборСотрудника			= НастройкиМеханизма.ОтборСотрудника;
	
	Если ОтборСотрудника.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ИменаТабличныхЧастейУстановленОтборСотрудника = Новый Массив();
	
	Для Каждого ЭлементОтбора Из ОтборСотрудника Цикл
		ОтборСотрудникСсылка	= ЭлементОтбора.Ключ;
		ОтборВидДействия		= ЭлементОтбора.Значение;
		
		Если Не ЗначениеЗаполнено(ОтборСотрудникСсылка) Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого ЭлементСоответствия Из СоответствиеВидДействия Цикл
			ИмяТабличнойЧасти	= ЭлементСоответствия.Ключ;
			ВидДействия			= ЭлементСоответствия.Значение;
			
			Если ВидДействия = ОтборВидДействия Тогда
				Если ИменаТабличныхЧастейУстановленОтборСотрудника.Найти(ИмяТабличнойЧасти) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				ИменаТабличныхЧастейУстановленОтборСотрудника.Добавить(ИмяТабличнойЧасти);
				
				МеханизмОзнакомленияСотрудников_НастроитьПанельУстановленОтборСотрудника(Форма, ИмяТабличнойЧасти, ОтборСотрудникСсылка);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Для Каждого ЭлементОписания Из НастройкиМеханизма.ТабличныеЧасти Цикл
		ИмяТабличнойЧасти = ЭлементОписания.Ключ;
		
		Если ИменаТабличныхЧастейУстановленОтборСотрудника.Найти(ИмяТабличнойЧасти) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		МеханизмОзнакомленияСотрудников_НастроитьПанельЗапрещенВыборСотрудника(Форма, ИмяТабличнойЧасти);
	КонецЦикла;
	
КонецПроцедуры

Процедура МеханизмОзнакомленияСотрудников_НастроитьПанельУстановленОтборСотрудника(Форма, ИмяТабличнойЧасти, ОтборСотрудникСсылка)
	
	НастройкиМеханизма = Форма.НастройкиМеханизмаОзнакомленияСотрудников;
	
	ИменаРеквизитов	= НастройкиМеханизма.ТабличныеЧасти[ИмяТабличнойЧасти].ИменаРеквизитов;
	ИменаКоманд		= НастройкиМеханизма.ТабличныеЧасти[ИмяТабличнойЧасти].ИменаКоманд;
	
	// Устанавливаем сотрудника
	Форма[ИменаРеквизитов.Сотрудник]			= ОтборСотрудникСсылка;
	Форма[ИменаРеквизитов.СотрудникПрежнееЗначение]	= ОтборСотрудникСсылка;
	
	// Считываем результат действия сотрудника
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ИмяТабличнойЧасти",	ИмяТабличнойЧасти);
	ДополнительныеПараметры.Вставить("ИменаРеквизитов",		ИменаРеквизитов);
	
	МеханизмОзнакомленияСотрудников_ЗаполнитьРезультатыОзнакомленияСотрудника(Форма, ДополнительныеПараметры);
	
	// Запрещаем интерактивное изменение сотрудника
	ЭлементСотрудника = Форма.Элементы[ИменаРеквизитов.Сотрудник];
	ЭлементСотрудника.ТолькоПросмотр = Истина;
	
	СписокВыбора = Новый Массив();
	СписокВыбора.Добавить(ОтборСотрудникСсылка);
	
	ЭлементСотрудника.СписокВыбора.ЗагрузитьЗначения(СписокВыбора);
	
КонецПроцедуры

Процедура МеханизмОзнакомленияСотрудников_НастроитьПанельЗапрещенВыборСотрудника(Форма, ИмяТабличнойЧасти)
	
	НастройкиМеханизма = Форма.НастройкиМеханизмаОзнакомленияСотрудников;
	
	ИменаРеквизитов	= НастройкиМеханизма.ТабличныеЧасти[ИмяТабличнойЧасти].ИменаРеквизитов;
	ИменаКоманд		= НастройкиМеханизма.ТабличныеЧасти[ИмяТабличнойЧасти].ИменаКоманд;
	
	// Запрещаем интерактивное изменение сотрудника и его результатов ознакомления
	Форма.Элементы[ИменаРеквизитов.Сотрудник].ТолькоПросмотр	= Истина;
	Форма.Элементы[ИменаРеквизитов.Флажок].ТолькоПросмотр		= Истина;
	Форма.Элементы[ИменаРеквизитов.Дата].ТолькоПросмотр			= Истина;
	Форма.Элементы[ИменаКоманд.СохранитьРезультаты].Доступность	= Ложь;
	
КонецПроцедуры

Процедура МеханизмОзнакомленияСотрудников_ОбновитьПанельПослеЧтенияИлиЗаписиФормы(Форма)
	
	Если Не ОбщегоНазначенияБГУКлиентСервер.МеханизмОзнакомленияСотрудников_УстановленОтборСотрудника(Форма)
		И ОбщегоНазначенияБГУКлиентСервер.МеханизмОзнакомленияСотрудников_ОчищатьРеквизитыМеханизмаПослеЧтенияЗаписиФормы() Тогда
		МеханизмОзнакомленияСотрудников_ОчиститьРеквизитыМеханизма(Форма);
	КонецЕсли;
	
	МеханизмОзнакомленияСотрудников_ПроверитьДопустимостьРедактирования(Форма);
	
	МеханизмОзнакомленияСотрудников_УстановитьДоступностьЭлементов(Форма);
	
КонецПроцедуры

Процедура МеханизмОзнакомленияСотрудников_ДобавитьОстальныеДействия(Форма, ТаблицаДействий, ТекущаяСтрока, НастройкиМеханизма)
	
	// Добаляет остальные действия этого сотрудника, если этот сотрудник указан в остальных табличных частях
	
	НастройкиМеханизма = Форма.НастройкиМеханизмаОзнакомленияСотрудников;
	
	ПоискРезультатДействия = Новый Структура("Сотрудник,ВидДействия,Дата");
	
	ЗаполнитьЗначенияСвойств(ПоискРезультатДействия, ТекущаяСтрока, "Сотрудник,Дата");
	
	ПоискСотрудник = Новый Структура("Сотрудник");
	
	ЗаполнитьЗначенияСвойств(ПоискСотрудник, ТекущаяСтрока, "Сотрудник");
	
	Для Каждого ВидДействия Из НастройкиМеханизма.ПорядокВидовДействий Цикл
		Если ВидДействия = ТекущаяСтрока.ВидДействия Тогда
			Продолжить;
		КонецЕсли;
		
		ПоискРезультатДействия.ВидДействия = ВидДействия;
		
		МассивСтрок = ТаблицаДействий.НайтиСтроки(ПоискРезультатДействия);
		
		Если МассивСтрок.Количество() > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяТабличнойЧасти = НастройкиМеханизма.СоответствиеИмяТабличнойЧасти.Получить(ВидДействия);
		
		МассивСтрок = Форма.Объект[ИмяТабличнойЧасти].НайтиСтроки(ПоискСотрудник);
		
		Если МассивСтрок.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаДействий.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока, "Записывать");
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ПоискРезультатДействия);
		НоваяСтрока.ДобавленоЗаодно = Истина;
	КонецЦикла;
	
КонецПроцедуры

Процедура МеханизмОзнакомленияСотрудников_ДиагностироватьКонфликтыДействий(Форма, ТаблицаДействий, ЕстьКонфликтыДействий)
	
	ЕстьКонфликтыДействий = Ложь;
	
	НастройкиМеханизма = Форма.НастройкиМеханизмаОзнакомленияСотрудников;
	
	ТаблицаДействий.Колонки.Добавить("ЕстьКонфликт", Новый ОписаниеТипов("Булево"));
	
	ВремТаблица = ТаблицаДействий.Скопировать(, "Сотрудник");
	ВремТаблица.Свернуть("Сотрудник");
	СписокСотрудников = ВремТаблица.ВыгрузитьКолонку("Сотрудник");
	
	Поиск = Новый Структура("Сотрудник");
	
	Для Каждого Сотрудник Из СписокСотрудников Цикл
		Поиск.Сотрудник = Сотрудник;
		
		МассивСтрок = ТаблицаДействий.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() = 1 Или НастройкиМеханизма.ДопустимыРазличныеДатыДействийОдногоСотрудника Тогда
			Продолжить;
		КонецЕсли;
		
		ВремТаблица = ТаблицаДействий.Скопировать(МассивСтрок, "Дата");
		ВремТаблица.Свернуть("Дата");
		
		Если ВремТаблица.Количество() = 1 Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
			СтрокаТаблицы.ЕстьКонфликт = Истина;
			
			ЕстьКонфликтыДействий = Истина;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура МеханизмОзнакомленияСотрудников_ОчиститьРеквизитыМеханизма(Форма, ИмяТабличнойЧасти = Неопределено)
	
	НастройкиМеханизма = Форма.НастройкиМеханизмаОзнакомленияСотрудников;
	
	Для Каждого ЭлементОписания Из НастройкиМеханизма.ТабличныеЧасти Цикл
		ИмяТЧ		= ЭлементОписания.Ключ;
		ОписаниеТЧ	= ЭлементОписания.Значение;
		
		Если ИмяТабличнойЧасти <> Неопределено И ИмяТабличнойЧасти <> ИмяТЧ Тогда
			Продолжить;
		КонецЕсли;
		
		ИменаРеквизитов = ОписаниеТЧ.ИменаРеквизитов;
		
		Для Каждого ОписаниеРеквизита Из ИменаРеквизитов Цикл
			ИмяРеквизита = ОписаниеРеквизита.Значение;
			
			Форма[ИмяРеквизита] = Неопределено;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Функция МеханизмОзнакомленияСотрудников_ПолучитьТаблицуДействий(Форма, ДополнительныеПараметры = Неопределено)
	
	РежимЗаписиОднойТабличнойЧасти = (ДополнительныеПараметры <> Неопределено);
	
	ТаблицаДействий = Новый ТаблицаЗначений();
	ТаблицаДействий.Колонки.Добавить("Сотрудник",		Новый ОписаниеТипов("СправочникСсылка.Сотрудники"));
	ТаблицаДействий.Колонки.Добавить("ВидДействия",		Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДействийСотрудникаСДокументом"));
	ТаблицаДействий.Колонки.Добавить("Дата",			ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	ТаблицаДействий.Колонки.Добавить("Записывать",		Новый ОписаниеТипов("Булево"));
	ТаблицаДействий.Колонки.Добавить("ДобавленоЗаодно",	Новый ОписаниеТипов("Булево"));
	
	НастройкиМеханизма = Форма.НастройкиМеханизмаОзнакомленияСотрудников;
	
	Для Каждого ЭлементОписания Из НастройкиМеханизма.ТабличныеЧасти Цикл
		ИмяТабличнойЧасти		= ЭлементОписания.Ключ;
		ОписаниеТабличнойЧасти	= ЭлементОписания.Значение;
		
		ИменаРеквизитов = ОписаниеТабличнойЧасти.ИменаРеквизитов;
		
		Модифицированность = Форма[ИменаРеквизитов.Модифицированность];
		
		Если Не Модифицированность Тогда
			Продолжить;
		КонецЕсли;
		
		ВидДействия = НастройкиМеханизма.СоответствиеВидДействия.Получить(ИмяТабличнойЧасти);
		
		ДопустимоЕдиновременноеДействиеВсехСотрудников = ОписаниеТабличнойЧасти.ДопустимоЕдиновременноеДействиеВсехСотрудников;
		
		Если РежимЗаписиОднойТабличнойЧасти И ДополнительныеПараметры.СобытиеСохранениеПриИзмененииСотрудника Тогда
			ИмяРеквизитаСотрудник = ИменаРеквизитов.СотрудникПрежнееЗначение;
		Иначе
			ИмяРеквизитаСотрудник = ИменаРеквизитов.Сотрудник;
		КонецЕсли;
		
		Сотрудник = Форма[ИмяРеквизитаСотрудник];
		
		Записывать = ?(РежимЗаписиОднойТабличнойЧасти, (ИмяТабличнойЧасти = ДополнительныеПараметры.ИмяТабличнойЧасти), Истина);
		
		Если ЗначениеЗаполнено(Сотрудник) Тогда
			НоваяСтрока = ТаблицаДействий.Добавить();
			НоваяСтрока.Сотрудник	= Сотрудник;
			НоваяСтрока.ВидДействия	= ВидДействия;
			НоваяСтрока.Дата		= Форма[ИменаРеквизитов.Дата];
			НоваяСтрока.Записывать	= Записывать;
			
			Если Не НастройкиМеханизма.ДопустимыРазличныеДатыДействийОдногоСотрудника Тогда
				МеханизмОзнакомленияСотрудников_ДобавитьОстальныеДействия(Форма, ТаблицаДействий, НоваяСтрока, НастройкиМеханизма);
			КонецЕсли;
			
		ИначеЕсли ДопустимоЕдиновременноеДействиеВсехСотрудников Тогда
			Для Каждого СтрокаТаблицы Из Форма.Объект[ИмяТабличнойЧасти] Цикл
				Если Не ЗначениеЗаполнено(СтрокаТаблицы.Сотрудник) Тогда
					Продолжить;
				КонецЕсли;
				
				НоваяСтрока = ТаблицаДействий.Добавить();
				НоваяСтрока.Сотрудник	= СтрокаТаблицы.Сотрудник;
				НоваяСтрока.ВидДействия	= ВидДействия;
				НоваяСтрока.Дата		= Форма[ИменаРеквизитов.Дата];
				НоваяСтрока.Записывать	= Записывать;
				
				Если Не НастройкиМеханизма.ДопустимыРазличныеДатыДействийОдногоСотрудника Тогда
					МеханизмОзнакомленияСотрудников_ДобавитьОстальныеДействия(Форма, ТаблицаДействий, НоваяСтрока, НастройкиМеханизма);
				КонецЕсли;
			КонецЦикла;
			
		Иначе
			Продолжить;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТаблицаДействий;
	
КонецФункции

Функция МеханизмОзнакомленияСотрудников_СформироватьСообщениеОКонфликтахДействий(Форма, ТаблицаДействий, ДополнительныеПараметры = Неопределено)
	
	ШаблонСообщения = НСтр("ru='Не поддерживаются различные даты %1 для одного сотрудника. Для сотрудника ""%2"" %3.%4'");
	
	ШаблонДатаДействияУстановлена = НСтр("ru='дата %1 %2'");
	ШаблонДатаДействияУдалена = НСтр("ru='дата %1 не установлена'");
	
	ПредставленияВидовДействий = Новый Соответствие();
	ПредставленияВидовДействий.Вставить(Перечисления.ВидыДействийСотрудникаСДокументом.Ознакомление, НСтр("ru='ознакомления'"));
	ПредставленияВидовДействий.Вставить(Перечисления.ВидыДействийСотрудникаСДокументом.Согласование, НСтр("ru='согласования'"));
	
	// Найдено всего сотрудников с конфликтами действий
	Если ТаблицаДействий.Колонки.Найти("ДобавленоЗаодно") = Неопределено Тогда
		ТаблицаДействий.Колонки.Добавить("ДобавленоЗаодно", Новый ОписаниеТипов("Булево"));
	КонецЕсли;
	
	ПоискСотрудников = Новый Структура("ЕстьКонфликт,ДобавленоЗаодно", Истина, Ложь);
	
	ТаблицаКонфликтов = ТаблицаДействий.Скопировать(ПоискСотрудников);
	
	ВремТаблица = ТаблицаКонфликтов.Скопировать();
	ВремТаблица.Свернуть("Сотрудник");
	СписокСотрудников = ВремТаблица.ВыгрузитьКолонку("Сотрудник");
	
	// В сообщении упоминаем первого найденного сотрудника
	
	НастройкиМеханизма = Форма.НастройкиМеханизмаОзнакомленияСотрудников;
	
	Сотрудник = СписокСотрудников[0];
	
	ПоискДляВыводаСообщения = Новый Структура("Сотрудник,ДобавленоЗаодно", Сотрудник, Ложь);
	
	Если ДополнительныеПараметры <> Неопределено Тогда
		// Один вид действия
		
		ПоискДляВыводаСообщения.Вставить("ВидДействия", НастройкиМеханизма.СоответствиеВидДействия.Получить(ДополнительныеПараметры.ИмяТабличнойЧасти));
	КонецЕсли;
	
	МассивСтрок = ТаблицаДействий.НайтиСтроки(ПоискДляВыводаСообщения);
	
	СтрокаТаблицыДействийДляВыводаСообщения = МассивСтрок[0];
	
	ИмяТабличнойЧасти = НастройкиМеханизма.СоответствиеИмяТабличнойЧасти.Получить(СтрокаТаблицыДействийДляВыводаСообщения.ВидДействия);
	
	ПоискПоСотруднику = Новый Структура("Сотрудник", Сотрудник);
	
	МассивСтрок = ТаблицаКонфликтов.НайтиСтроки(ПоискПоСотруднику);
	
	СписокДействий = Новый Массив();
	СписокДат = Новый Массив();
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		Представление = ПредставленияВидовДействий.Получить(СтрокаТаблицы.ВидДействия);
		
		СписокДействий.Добавить(Представление);
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.Дата) Тогда
			ТекстДатаДействия = СтрШаблон(ШаблонДатаДействияУстановлена, Представление, Формат(СтрокаТаблицы.Дата, "ДФ=дд.ММ.гггг"));
		Иначе
			ТекстДатаДействия = СтрШаблон(ШаблонДатаДействияУдалена, Представление);
		КонецЕсли;
		
		СписокДат.Добавить(ТекстДатаДействия);
	КонецЦикла;
	
	КоличествоСотрудниковСКонфликтами = СписокСотрудников.Количество();
	
	Если КоличествоСотрудниковСКонфликтами > 1 Тогда
		ТекстЕстьЕщеСотрудники = " " + СтрокаСЧислом(НСтр("ru=';Аналогичный конфликт дат обнаружен еще у %1 сотрудника;;Аналогичные конфликты дат обнаружены еще у %1 сотрудников;Аналогичные конфликты дат обнаружены еще у %1;Аналогичные конфликты дат обнаружены еще у %1 сотрудников'"),
		    КоличествоСотрудниковСКонфликтами - 1,
		    ВидЧисловогоЗначения.Количественное,
		    "L=ru");
	Иначе
		ТекстЕстьЕщеСотрудники = "";
	КонецЕсли;
	
	ТекстСообщения = СтрШаблон(ШаблонСообщения,
		СтрСоединить(СписокДействий, ", "),
		Строка(Сотрудник),
		СтрСоединить(СписокДат, ", "),
		ТекстЕстьЕщеСотрудники);
	
	ИмяРеквизитаСотрудник = НастройкиМеханизма.ТабличныеЧасти[ИмяТабличнойЧасти].ИменаРеквизитов.Сотрудник;
	
	Поиск = Новый Структура();
	Поиск.Вставить("Сотрудник", Сотрудник);
	Поиск.Вставить("Дата",		СтрокаТаблицыДействийДляВыводаСообщения.Дата);
	
	МассивСтрок = Форма.Объект[ИмяТабличнойЧасти].НайтиСтроки(Поиск);
	
	НомерСтроки = ?(МассивСтрок.Количество() > 0, МассивСтрок[0].НомерСтроки, 0);
	
	Результат = Новый Структура();
	Результат.Вставить("ТекстСообщения",		ТекстСообщения);
	Результат.Вставить("ИмяТабличнойЧасти",		ИмяТабличнойЧасти);
	Результат.Вставить("НомерСтроки",			НомерСтроки);
	Результат.Вставить("ИмяРеквизитаСотрудник",	ИмяРеквизитаСотрудник);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

// см. ОбщегоНазначенияПереопределяемый.ПриДобавленииПараметровРаботыКлиента
Процедура УстановитьПараметрыРаботыКлиентаДляВыбораСубконто(Параметры)
	// для выбора субконто в бухгалтерской операции
	
	СоответствиеИмен = Новый Соответствие;
	
	Для каждого Документ Из Метаданные.Документы Цикл
	
		СоответствиеИмен.Вставить(Тип("ДокументСсылка." + Документ.Имя), Документ.ПолноеИмя());
		
	КонецЦикла;
	
	СоответствиеТипов = Новый Соответствие;
	
	Для каждого ОбъектМетаданных Из Метаданные.Справочники Цикл
		
		СоответствиеИмен.Вставить(Тип("СправочникСсылка." + ОбъектМетаданных.Имя), ОбъектМетаданных.ПолноеИмя());
		
		РеквизитыДляОтбора = Новый Массив;
		
		Если ОбъектМетаданных.Владельцы.Количество() > 0 Тогда
			
			МассивВладельцев = Новый Массив;
			Для каждого ОбъектВладелец Из ОбъектМетаданных.Владельцы Цикл
				Если СтрРазделить(ОбъектВладелец.ПолноеИмя(),".")[0] = "Справочник" Тогда
					МассивВладельцев.Добавить(Тип("СправочникСсылка." + ОбъектВладелец.Имя));
				ИначеЕсли СтрРазделить(ОбъектВладелец.ПолноеИмя(),".")[0] = "ПланВидовХарактеристик" Тогда
					МассивВладельцев.Добавить(Тип("ПланВидовХарактеристикСсылка." + ОбъектВладелец.Имя));
				КонецЕсли;
			КонецЦикла;
			РеквизитыДляОтбора.Добавить(Новый Структура("Владелец", МассивВладельцев));
			
		КонецЕсли;
		
		Если ОбъектМетаданных.Реквизиты.Найти("Организация") <> Неопределено Тогда
			РеквизитыДляОтбора.Добавить(Новый Структура("Организация",
				ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Тип("СправочникСсылка.Организации"))));
		КонецЕсли;
		
		Если РеквизитыДляОтбора.Количество() > 0 Тогда
			СоответствиеТипов.Вставить(Тип("СправочникСсылка." + ОбъектМетаданных.Имя), РеквизитыДляОтбора);
		КонецЕсли;
	
	КонецЦикла;
	
	Параметры.Вставить("ПараметрыБГУ_ИменаТипов",             Новый ФиксированноеСоответствие(СоответствиеИмен));
	Параметры.Вставить("ПараметрыБГУ_ПодчиненныеСправочники", Новый ФиксированноеСоответствие(СоответствиеТипов));
	
КонецПроцедуры

// Возвращает структуру данных документа прекращения договора о материальной ответственности
//
// Параметры:
//  ДоговорСсылка - ДокументСсылка.ДоговорМОЛ, ДокументСсылка.ДоговорКоллективнойМО
//  Проведен - Булево (отбор проведенных)
// Возвращаемое значение:
// Структура:
//  ДокументСсылка - ДокументСсылка.ПрекращениеДоговорМОЛ, ДокументСсылка.ПрекращениеДоговорКоллективнойМО
//  ДатаПрекращения - Дата (только при передаче параметра "Проведен" в значении Истина)
//
Функция ДанныеПрекращенияДоговораСМОЛ(ДоговорСсылка, Проведен = Ложь) Экспорт

	ПолноеИмяОбъекта = СтандартныеПодсистемыВызовСервера.ПолноеИмяОбъектаМетаданных(ТипЗнч(ДоговорСсылка));
	Возврат ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмяОбъекта).ДанныеПрекращенияДоговора(ДоговорСсылка, Проведен);
	
КонецФункции

#КонецОбласти
