Функция НайтиДублиСтрок(ПроверяемаяТаблица, КоллекцияИменКолонок, УчитыватьНезаполненныеЗначения = Ложь) Экспорт
	
	Перем СтруктураИменКолонок;
	
	ТипНомерСтроки = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(7, 0));
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("НомерСтроки",		ТипНомерСтроки);
	Результат.Колонки.Добавить("НомераСтрокДублей",	Новый ОписаниеТипов("Массив"));
	
	Если ПроверяемаяТаблица.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ТипЗнч(ПроверяемаяТаблица) = Тип("ТаблицаЗначений") Тогда
		ЕстьКолонкаНомерСтроки = (ПроверяемаяТаблица.Колонки.Найти("НомерСтроки") <> Неопределено);
	Иначе
		// Тип("ДанныеФормыКоллекция")
		ЕстьКолонкаНомерСтроки = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ПроверяемаяТаблица[0], "НомерСтроки");
	КонецЕсли;
	
	// Приводим параметры к ожидаемому типу
	Если ТипЗнч(КоллекцияИменКолонок) = Тип("Структура") Тогда
		СтруктураИменКолонок = КоллекцияИменКолонок;
	ИначеЕсли ТипЗнч(КоллекцияИменКолонок) = Тип("Массив") Тогда
		СтруктураИменКолонок = Новый Структура();
		Для Каждого Элем Из КоллекцияИменКолонок Цикл
			СтруктураИменКолонок.Вставить(Элем);
		КонецЦикла;
	ИначеЕсли ТипЗнч(КоллекцияИменКолонок) = Тип("Строка") Тогда
		СтруктураИменКолонок = Новый Структура(КоллекцияИменКолонок);
	КонецЕсли;
	
	НомерСтроки = 0;
	ТаблицаНомераСтрокДублей = Новый ТаблицаЗначений;
	ТаблицаНомераСтрокДублей.Колонки.Добавить("НомерСтроки", ТипНомерСтроки);
	Для Каждого СтрокаТаблицы Из ПроверяемаяТаблица Цикл
		НомерСтроки = НомерСтроки + 1;
		
		ЗаполнитьЗначенияСвойств(СтруктураИменКолонок, СтрокаТаблицы);
		
		Если Не УчитыватьНезаполненныеЗначения Тогда
			ПропуститьТекущуюСтроку = Ложь;
			
			Для Каждого Элемент Из СтруктураИменКолонок Цикл
				Если Не ЗначениеЗаполнено(Элемент.Значение) Тогда
					ПропуститьТекущуюСтроку = Истина;
					
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если ПропуститьТекущуюСтроку Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		МассивСтрокДублей = ПроверяемаяТаблица.НайтиСтроки(СтруктураИменКолонок);
		
		Если МассивСтрокДублей.Количество() > 1 Тогда
			ТаблицаНомераСтрокДублей.Очистить();
			Для Каждого СтрокаДубль Из МассивСтрокДублей Цикл
				НоваяСтрокаДубль = ТаблицаНомераСтрокДублей.Добавить();
				НоваяСтрокаДубль["НомерСтроки"] = ?(ЕстьКолонкаНомерСтроки, СтрокаДубль.НомерСтроки, ПроверяемаяТаблица.Индекс(СтрокаДубль) + 1);
			КонецЦикла;
			ТаблицаНомераСтрокДублей.Сортировать("НомерСтроки");
			
			// Запоминаем номера строк обнаруженных дублей
			НоваяСтрока = Результат.Добавить();
			НоваяСтрока["НомерСтроки"]			= ?(ЕстьКолонкаНомерСтроки, СтрокаТаблицы.НомерСтроки, НомерСтроки);
			НоваяСтрока["НомераСтрокДублей"]	= ТаблицаНомераСтрокДублей.ВыгрузитьКолонку("НомерСтроки");
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПараметрыВыводаСообщенийОДубляхСтрок() Экспорт
	
	ПараметрыВывода = Новый Структура("
		|ТаблицаИмя,
		|ТаблицаПредставление,
		|ОбъектСсылка,
		|ШаблонСтроки,
		|ИмяПоляДляВыводаСообщений");
	
	Возврат ПараметрыВывода;
	
КонецФункции

// Выводит сообщения о дублях строк в указанной таблице.
//
// Параметры:
//	ТаблицаДублиСтрок	- ТаблицаЗначений	- результат функции НайтиДублиСтрок()
//	ПараметрыВывода		- Структура			- результат функции ПараметрыВыводаСообщенийОДубляхСтрок()
Процедура ВывестиСообщенияОДубляхСтрок(ТаблицаДублиСтрок, ПараметрыВывода) Экспорт
	
	Перем	ТаблицаИмя,
			ТаблицаПредставление,
			ОбъектСсылка,
			ШаблонСтроки,
			ИмяПоляДляВыводаСообщений;
	
	ПараметрыВывода.Свойство("ТаблицаИмя",					ТаблицаИмя);
	ПараметрыВывода.Свойство("ТаблицаПредставление",		ТаблицаПредставление);
	ПараметрыВывода.Свойство("ОбъектСсылка",				ОбъектСсылка);
	ПараметрыВывода.Свойство("ШаблонСтроки",				ШаблонСтроки);
	ПараметрыВывода.Свойство("ИмяПоляДляВыводаСообщений",	ИмяПоляДляВыводаСообщений);
	
	Если НЕ ЗначениеЗаполнено(ИмяПоляДляВыводаСообщений) Тогда
		ИмяПоляДляВыводаСообщений = "НомерСтроки";
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ШаблонСтроки) Тогда
		Если ЗначениеЗаполнено(ТаблицаПредставление) Тогда
			ШаблонСтроки = НСтр("ru='Обнаружены дубли строк (таблица ""[ТаблицаПредставление]"", строки [НомераСтрок])'");
		Иначе
			ШаблонСтроки = НСтр("ru='Обнаружены дубли строк (строки [НомераСтрок])'");
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОбъектСсылка) Тогда
		ПолеТаблицы = "Объект." + ТаблицаИмя;
	Иначе
		ПолеТаблицы = ТаблицаИмя;
	КонецЕсли;
	
	ВставляемыеЗначения = Новый Структура();
	ВставляемыеЗначения.Вставить("ТаблицаПредставление", ТаблицаПредставление);
	Для Каждого СтрокаТаблицы Из ТаблицаДублиСтрок Цикл
		НомерСтроки			= СтрокаТаблицы["НомерСтроки"];
		НомераСтрокДублей	= СтрокаТаблицы["НомераСтрокДублей"];
		Если НомерСтроки = НомераСтрокДублей[0] Тогда
			Продолжить; // не выводим сообщение для самой первой строки дубля
		КонецЕсли;
		
		ВставляемыеЗначения.Вставить("НомераСтрок", СтрСоединить(НомераСтрокДублей, ", "));
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ШаблонСтроки, ВставляемыеЗначения);
		
		ИндексСтрокиТекст = Формат(НомерСтроки - 1, "ЧГ=0");
		
		ОбщегоНазначения.СообщитьПользователю(
			ТекстСообщения,
			ОбъектСсылка,
			ПолеТаблицы + "[" + ИндексСтрокиТекст + "]." + ИмяПоляДляВыводаСообщений);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСоставКомиссии(ФормаДокумента, ТолькоПредседательИУполномоченные = Ложь) Экспорт
	
	Объект = ФормаДокумента.Объект;
	
	ТаблицаСостава = ПрочитатьТаблицуСоставаКомиссии(Объект.Комиссия, ТолькоПредседательИУполномоченные);
	
	Объект.СоставКомиссии.Загрузить(ТаблицаСостава);
	
КонецПроцедуры

Функция ПрочитатьТаблицуСоставаКомиссии(Комиссия, ТолькоПредседательИУполномоченные = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Комиссия", Комиссия);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СоставКомиссии.Сотрудник КАК Сотрудник,
	|	СоставКомиссии.СтатусЧленаКомиссии КАК СтатусЧленаКомиссии,
	|	СоставКомиссии.НомерРабочейКомиссии КАК НомерРабочейКомиссии
	|ИЗ
	|	Справочник.ПостоянноДействующиеКомиссии.СоставКомиссии КАК СоставКомиссии
	|ГДЕ
	|	СоставКомиссии.Ссылка = &Комиссия
	|
	|УПОРЯДОЧИТЬ ПО
	|	СоставКомиссии.НомерСтроки";
	
	ТаблицаСостава = Запрос.Выполнить().Выгрузить();
	
	Если ТолькоПредседательИУполномоченные Тогда
		// Выбираем только председателя и уполномоченных лиц, если в комиссии сформированы рабочие комиссии.
		
		Поиск = Новый Структура("СтатусЧленаКомиссии", Перечисления.СтатусыЧленовКомиссии.УполномоченноеПредседателемЛицо);
		
		МассивСтрок = ТаблицаСостава.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() > 0 Тогда
			КоличествоСтрок = ТаблицаСостава.Количество();
			
			Для Счетчик = 1 По КоличествоСтрок Цикл
				ИндексСтроки = КоличествоСтрок - Счетчик;
				
				СтрокаТаблицы = ТаблицаСостава[ИндексСтроки];
				
				Если СтрокаТаблицы.СтатусЧленаКомиссии = Перечисления.СтатусыЧленовКомиссии.Председатель
					Или СтрокаТаблицы.СтатусЧленаКомиссии = Перечисления.СтатусыЧленовКомиссии.УполномоченноеПредседателемЛицо Тогда
					Продолжить;
				КонецЕсли;
				
				ТаблицаСостава.Удалить(СтрокаТаблицы);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ТаблицаСостава;
	
КонецФункции

// Установить флаг доступности редактирования строк в документах НФА.
// Также устанавливает в локальную переменную КэшПараметров.Локальные.ЗапрещеноРедактироватьСтрокиНастройка
// имена элементов для данной формы. см. ПустаяНастройкаНедоступныхЭлементовФормыВДокументахНФА
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения:
//   * Объект - ДанныеФормыСтруктура:
//    ** Ссылка - ДокументСсылка
Процедура УстановитьДоступностьРедактированияСтрокВДокументахНФА(Форма) Экспорт
	
	Если Не Константы.ЗапретитьИнтерактивныйВводСтрокВДокументахСписанияНФА.Получить() Тогда
		Возврат;
	КонецЕсли;
	ОбщегоНазначенияБГУКлиентСервер.УстановитьПризнакЗапрещеноДобавлениеСтрокВДокументыНФА(Форма, Истина);
	УстановитьНастройкуДоступностиРедактированияСтрокВДокументахНФА(Форма);
	ОбщегоНазначенияБГУКлиентСервер.ИзменитьДоступностьРедактированияСтрок(Форма);
	
КонецПроцедуры

// Заполняет в локальный кэш формы настройку доступности редактирования строк в документах НФА,
// при использовании константы ЗапретитьИнтерактивныйВводСтрокВДокументахСписанияНФА.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - Форма:
// * Объект - ДанныеФормыСтруктура - :
// ** Ссылка - ДокументСсылка - 
Процедура УстановитьНастройкуДоступностиРедактированияСтрокВДокументахНФА(Форма) Экспорт
	МенеджерДокумента = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Форма.Объект.Ссылка);
	НастройкаДокумента = МенеджерДокумента.НастройкаНедоступностиЭлементовТаблицы();
	
	НастройкаЭлементов = ПустаяНастройкаНедоступныхЭлементовФормыВДокументахНФА();

	СтандартныеКоманды = Новый Массив;
	СтандартныеКоманды.Добавить("Добавить"); 
	СтандартныеКоманды.Добавить("КонтекстноеМенюДобавить"); 
	СтандартныеКоманды.Добавить("Скопировать"); 
	СтандартныеКоманды.Добавить("КонтекстноеМенюСкопировать"); 
	
	ОтключаемыеКнопки = Новый Соответствие;
	ТребуемыеПути = Новый Соответствие;
	Для Каждого Тч Из НастройкаДокумента Цикл
		Если Тч.Ключ = "ИменаСкрываемыхКнопок" Тогда
			Для Каждого ИмяКнопки Из Тч.Значение Цикл
				ОтключаемыеКнопки.Вставить(ИмяКнопки, Истина);
			КонецЦикла;
		Иначе
			Для Каждого ИмяПоля Из Тч.Значение Цикл
				ТребуемыеПути.Вставить("Объект." + Тч.Ключ + "." + ИмяПоля, Истина);
			КонецЦикла;
			Для Каждого ИмяКоманды Из СтандартныеКоманды Цикл
				ОтключаемыеКнопки.Вставить(Тч.Ключ + ИмяКоманды, Истина);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	НайденыВсеТолькоПросмотр = Ложь;
	НайденыВсеВидимость = Ложь;
	Для Каждого ЭлементФормы Из Форма.Элементы Цикл
		ТипЭлемента = ТипЗнч(ЭлементФормы);
		Если ТипЭлемента = Тип("ПолеФормы") И ТребуемыеПути.Получить(ЭлементФормы.ПутьКДанным) <> Неопределено Тогда
			НастройкаЭлементов.ТолькоПросмотр.Добавить(ЭлементФормы.Имя);
			НайденыВсеТолькоПросмотр = НастройкаЭлементов.ТолькоПросмотр.Количество() = ТребуемыеПути.Количество();
		ИначеЕсли ТипЭлемента = Тип("КнопкаФормы")
			И ОтключаемыеКнопки.Получить(ЭлементФормы.Имя) <> Неопределено Тогда
			НастройкаЭлементов.Видимость.Добавить(ЭлементФормы.Имя);
			НайденыВсеВидимость = НастройкаЭлементов.Видимость.Количество() = ОтключаемыеКнопки.Количество(); 
		КонецЕсли;
		Если НайденыВсеТолькоПросмотр И НайденыВсеВидимость Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Форма.КэшПараметров.Локальные.Вставить("ЗапрещеноРедактироватьСтрокиНастройка", НастройкаЭлементов);
КонецПроцедуры

// Отключает блокировку редактирования строк в документах учета НФА.
// Используется только при включенной константе ЗапретитьИнтерактивныйВводСтрокВДокументахСписанияНФА,
// когда в документе есть разные режимы работы, которые могут не зависеть от значения константы 
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
Процедура РазблокироватьРеквизитыСтрокВДокументахНФА(Форма) Экспорт
	Если Не Константы.ЗапретитьИнтерактивныйВводСтрокВДокументахСписанияНФА.Получить() Тогда
		Возврат;
	КонецЕсли;
	ОбщегоНазначенияБГУКлиентСервер.УстановитьПризнакЗапрещеноДобавлениеСтрокВДокументыНФА(Форма, Ложь);
	ОбщегоНазначенияБГУКлиентСервер.ИзменитьДоступностьРедактированияСтрок(Форма);
КонецПроцедуры

// Проверяет правильность заполнения реквизитов типа "Сотрудник" по значению Владельца.
// При проверке учитывается настройка использования Централизованной бухгалтерии и 
// правила выбора реквизитов типа Сотрудник для централизованной бухгалтерии.
// Если владелец сотрудника не соответствует Организации или Централизованной бухгалтерии,
// то реквизит очищается. 
// 
// Параметры:
//  Объект - ДокументОбъект, ДанныеФормыСтруктура -
//  ИменаРеквизитов - Строка - имена реквизитов объекта, разделенные запятыми
//                  - Массив из Строка - имена реквизитов объекта
Процедура ПроверитьИОчиститьРеквизитыПоОрганизации(Объект, ИменаРеквизитов) Экспорт
	
	ПроверяемыеРеквизиты = Новый Массив;
	Если ТипЗнч(ИменаРеквизитов) = Тип("Массив") Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ПроверяемыеРеквизиты, ИменаРеквизитов);
	ИначеЕсли ТипЗнч(ИменаРеквизитов) = Тип("Строка") Тогда
		ПроверяемыеРеквизиты = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(ИменаРеквизитов);
	Иначе
		ВызватьИсключение "Не правильный параметр ""ИменаРеквизитов"". Значение параметра = " + ИменаРеквизитов;
	КонецЕсли;
	
	Если ПроверяемыеРеквизиты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполненныеРеквизиты = Новый Массив;
	ПроверяемыеЗначения = Новый Массив; // Массив из СправочникСсылка.Сотрудники
	Для Каждого Реквизит Из ПроверяемыеРеквизиты Цикл
		Если ЗначениеЗаполнено(Объект[Реквизит]) Тогда
			ПроверяемыеЗначения.Добавить(Объект[Реквизит]);
			ЗаполненныеРеквизиты.Добавить(Реквизит);
		КонецЕсли;
	КонецЦикла;
	Если ПроверяемыеЗначения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(ПроверяемыеЗначения, "Владелец");
	Организация = Объект.Организация;
	ЦентрализованнаяБухгалтерия = Константы.ОрганизацияЦентрализованнаяБухгалтерия.Получить();
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьЦентрализованнуюБухгалтерию") Тогда
		ИОМ = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(Объект.Ссылка));
		Настройка = РегистрыСведений.НастройкиВыбораОтветственныхСотрудниковЦБ.НастройкиПоОбъекту(ИОМ,
			?(ЗаполненныеРеквизиты.Количество() = 1, ЗаполненныеРеквизиты[0], 0));
		Для Каждого Реквизит Из ЗаполненныеРеквизиты Цикл
			ДействующаяНастройка = Настройка.Найти(Реквизит, "ИмяРеквизита");
			Если ДействующаяНастройка = Неопределено
					Или Не ЗначениеЗаполнено(ДействующаяНастройка.СпособВыбора) Тогда
				СпособВыбора = Перечисления.СпособВыбораОтветственногоЦБ.ИзСотрудниковУчреждения;
			Иначе
				СпособВыбора = ДействующаяНастройка.СпособВыбора;
			КонецЕсли;
			ОрганизацияСотрудника = ЗначенияРеквизитов.Получить(Объект[Реквизит]);
			ТребуетсяОчистка =
				(СпособВыбора = Перечисления.СпособВыбораОтветственногоЦБ.ИзСотрудниковУчреждения
					И ОрганизацияСотрудника <> Организация)
				Или (СпособВыбора = Перечисления.СпособВыбораОтветственногоЦБ.ИзСотрудниковЦБ
					И ОрганизацияСотрудника <> ЦентрализованнаяБухгалтерия)
				Или (СпособВыбора = Перечисления.СпособВыбораОтветственногоЦБ.ИзСотрудниковУчрежденияИЦБ
					И ОрганизацияСотрудника <> Организация
					И ОрганизацияСотрудника <> ЦентрализованнаяБухгалтерия);
			Если ТребуетсяОчистка Тогда
				Объект[Реквизит] = Неопределено;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

// Очищает все реквизиты объекта, включая табличные части
//
// Параметры:
//	Объект - СправочникОбъект, ДокументОбъект, ПВХОбъект. Объект, который нужно очистить
Процедура ОчиститьОбъект(Объект) Экспорт
	
	МетаданныеОбъекта = Объект.Метаданные();
	
	Для Каждого Реквизит Из МетаданныеОбъекта.Реквизиты Цикл
		Объект[Реквизит.Имя] = Неопределено;
	КонецЦикла;
	
	Для Каждого ТабличнаяЧасть Из МетаданныеОбъекта.ТабличныеЧасти Цикл
		Объект[ТабличнаяЧасть.Имя].Очистить();
	КонецЦикла;
	
КонецПроцедуры

// Получает перечисление массивов
//
// Параметры:
//	Массив1 (Массив).
//	Массив2 (Массив).
//
// Возращает массив, являющийся перечислением Массива1 и Массива2
//
Функция ПолучитьПересечениеМассивов(Массив1, Массив2) Экспорт
	
	Если (Массив1.Количество() = 0) ИЛИ (Массив2.Количество() = 0) Тогда
		МассивРезультат = Новый Массив;
		Возврат МассивРезультат;
	КонецЕсли;	
	
	МассивТ   = Новый Массив;
	МассивТ.Добавить(ТипЗнч(Массив1[0]));
	ОписаниеТ = Новый ОписаниеТипов(МассивТ);
	
	Таб1 = Новый ТаблицаЗначений;
	Таб1.Колонки.Добавить("К1", ОписаниеТ);
	Таб2 = Новый ТаблицаЗначений;
	Таб2.Колонки.Добавить("К1", ОписаниеТ);
	
	Для каждого Зн из Массив1 Цикл
		СтрокаТаб1 = Таб1.Добавить();
		СтрокаТаб1.К1 = Зн;
	КонецЦикла;	
	
	Для каждого Зн из Массив2 Цикл
		СтрокаТаб2 = Таб2.Добавить();
		СтрокаТаб2.К1 = Зн;
	КонецЦикла;	
	
	МВТ = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	Запрос.Текст = "ВЫБРАТЬ
					|	К1
					|ПОМЕСТИТЬ Т1
					|ИЗ
					|	&Таб1 КАК Таб1;
					|/////////////////////////
					|ВЫБРАТЬ
					|	К1
					|ПОМЕСТИТЬ Т2
					|ИЗ
					|	&Таб2 КАК Таб2;
					|/////////////////////////
					|ВЫБРАТЬ РАЗЛИЧНЫЕ
					|	*
					|ИЗ
					|	Т1
					|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ
					|	Т2 ПО Т1.К1 = Т2.К1
					|";
					
	Запрос.УстановитьПараметр("Таб1", Таб1);				
	Запрос.УстановитьПараметр("Таб2", Таб2);				
	
	ТабР = Запрос.Выполнить().Выгрузить();				
	МассивРезультат = ТабР.ВыгрузитьКолонку("К1");
	
	Возврат МассивРезультат;
	
КонецФункции	

// Вспомогательная процедура Функции Массив
Процедура ДобавитьВМассивАргумент(Результат, Значение)
	
	Если Значение = Неопределено Тогда
		
		ВызватьИсключение "Ok";
		
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		
		Для Каждого ЭлементМассива Из Значение Цикл
			Результат.Добавить(ЭлементМассива);
		КонецЦикла;
		
	Иначе
		Результат.Добавить(Значение)
	КонецЕсли;
	
КонецПроцедуры

// Функция формирует массив «на лету».
//
	
Функция Массив(Значение1, Значение2 = Неопределено, Значение3 = Неопределено,
	Значение4 = Неопределено, Значение5 = Неопределено, Значение6 = Неопределено,
	Значение7 = Неопределено, Значение8 = Неопределено, Значение9 = Неопределено) Экспорт
	
	Результат = Новый Массив;
	
	Попытка
		ДобавитьВМассивАргумент(Результат, Значение1);
		ДобавитьВМассивАргумент(Результат, Значение2);
		ДобавитьВМассивАргумент(Результат, Значение3);
		ДобавитьВМассивАргумент(Результат, Значение4);
		ДобавитьВМассивАргумент(Результат, Значение5);
		ДобавитьВМассивАргумент(Результат, Значение6);
		ДобавитьВМассивАргумент(Результат, Значение7);
		ДобавитьВМассивАргумент(Результат, Значение8);
		ДобавитьВМассивАргумент(Результат, Значение9);
	Исключение
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции // Массив()

 // Удаляет движения документа по указанному регистру либо по всем регистрам. 
//
// Параметры:
//  Движения	- коллекция движений документа.
//  ИмяРегистра - имя регистра, движения по которому будут удалены;
//				необязательный, если не указан - удаляются все движения.
//
Процедура УдалитьДвиженияДокумента(Движения,ИмяРегистра = "") Экспорт

	Если ИмяРегистра = "" Тогда
		Для Каждого ДвиженияРегистра Из Движения Цикл
			ДвиженияРегистра.Очистить();
		КонецЦикла;
	Иначе
		Движения[ИмяРегистра].Очистить();
	КонецЕсли;

КонецПроцедуры // УдалитьДвиженияДокумента()

Процедура ПоместитьТабЧастьВВиртуальнуюТаблицу(Запрос, ИмяТабЧасти, СписокПолей,
	Документ, Параметры = Неопределено, ИндексироватьПо = "") Экспорт
	
	Если Параметры = Неопределено Тогда
		Параметры = Новый Структура;
	КонецЕсли;
	
	МетаданныеДокумента = Документ.Метаданные();
	
	Запрос.Текст = Запрос.Текст + "ВЫБРАТЬ";
	
	ПоляВыборки = СтрРазделить(СписокПолей, ",");
	
	Для Каждого ПолеВыборки Из ПоляВыборки Цикл
		
		Поле = СокрЛП(ПолеВыборки);
		
		Если ЕстьРеквизитТабЧастиДокумента(Поле, МетаданныеДокумента, ИмяТабЧасти) ИЛИ Поле = "НомерСтроки" Тогда
			
			Запрос.Текст = Запрос.Текст + "
				|	" + ИмяТабЧасти + "." + Поле + " КАК " + Поле + ",";
			
		ИначеЕсли ЕстьРеквизитДокумента(Поле, МетаданныеДокумента) Тогда
			
			Запрос.Текст = Запрос.Текст + "
				|	&Документ" + Поле + " КАК " + Поле+ ",";
			Запрос.УстановитьПараметр("Документ" + Поле, Документ[Поле]);
			
		ИначеЕсли Параметры.Свойство(Поле) Тогда
			
			Запрос.Текст = Запрос.Текст + "
				|	&Параметр" + Поле + " КАК " + Поле+ ",";
			Запрос.УстановитьПараметр("Параметр" + Поле, Параметры[Поле]);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Запрос.Текст = Лев(Запрос.Текст, СтрДлина(Запрос.Текст) - 1); // убираем последнюю запятую
	
	Если ЕстьТабЧастьДокумента(ИмяТабЧасти, МетаданныеДокумента) Тогда
		
		Запрос.УстановитьПараметр("Таблица" + ИмяТабЧасти, Документ[ИмяТабЧасти].Выгрузить());
		Запрос.Текст = Запрос.Текст + "
			|ПОМЕСТИТЬ Таблица" + ИмяТабЧасти + "
			|ИЗ
			|	&Таблица" + ИмяТабЧасти + " КАК " + ИмяТабЧасти;
		
	Иначе
		
		Запрос.Текст = Запрос.Текст + "
			|ПОМЕСТИТЬ Документ";
		
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(ИндексироватьПо) Тогда
		
		Запрос.Текст = Запрос.Текст + "
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	" + ИндексироватьПо;
		
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + ТекстРазделителяЗапросовПакета();
	
КонецПроцедуры

Функция ТекстРазделителяОбъединенияЗапросов(Все = "") Экспорт

	ТекстРазделителя =
	"
	|
	|	ОБЪЕДИНИТЬ " + Все + "
	|";

	Возврат ТекстРазделителя;

КонецФункции

// Формирует структуру, содержащую значения реквизитов шапки документа по ссылке на документ.
//
// Параметры: 
//  ДокументСсылка			- ДокументСсылка	- документ для формирования структуры шапки;
//	СтруктураРеквизитов		- Структура			- перечень имен запрашиваемых реквизитов,
//							значение которых нужно получить. Ключ структуры - синоним,
//							который будет являться ключем возвращаемой структуры,
//							значение структуры - путь к данным;
//
// Возвращаемое значение:
//  Структура	- (по умолчанию) в качестве ключа будет стоять синоним реквизита,
//		переданный в параметрах, а значение будет содержать значение реквизита.
//
Функция СформироватьСтруктуруШапкиДокументаПоСсылке(ДокументСсылка, Знач СтруктураРеквизитов = Неопределено) Экспорт
	
	// Возвращаемое значение:
	Результат = Новый Структура();
	
	МетаданныеДокумента = ДокументСсылка.Метаданные();
	
	ИмяДокумента = МетаданныеДокумента.Имя;
	
	Если НЕ ТипЗнч(СтруктураРеквизитов) = Тип("Структура") Тогда
		// Выбираем все реквизиты документа (кроме табличных частей) из метаданных.
		
		СтруктураРеквизитов = Новый Структура();
		РеквизитыМетаданные = МетаданныеДокумента.Реквизиты;
		Для Каждого Реквизит Из РеквизитыМетаданные Цикл
			ИмяРеквизита = Реквизит.Имя;
			СтруктураРеквизитов.Вставить(ИмяРеквизита, ИмяРеквизита);
		КонецЦикла;	
		
		// Стандартные реквизиты:
		СтруктураРеквизитов.Вставить("Номер",			"Номер");
		СтруктураРеквизитов.Вставить("Дата",			"Дата");
		СтруктураРеквизитов.Вставить("Ссылка",			"Ссылка");
		СтруктураРеквизитов.Вставить("ПометкаУдаления",	"ПометкаУдаления");
		СтруктураРеквизитов.Вставить("Проведен",		"Проведен");
	КонецЕсли;	
	
	ПоляВыборки = "";
	ИменаВыбираемыхПолей = "";
	Для Каждого КлючЗначение Из СтруктураРеквизитов Цикл
		ВыражениеПоля	= КлючЗначение.Значение;
		ПсевдонимПоля	= КлючЗначение.Ключ;
		ПоляВыборки = ПоляВыборки + "
									|Документ." + ВыражениеПоля + " КАК " + ПсевдонимПоля + ", ";
		Результат.Вставить(ПсевдонимПоля);
		ИменаВыбираемыхПолей = ИменаВыбираемыхПолей + "," + ВыражениеПоля;
	КонецЦикла;	

	ПоляВыборки = Лев(ПоляВыборки,СтрДлина(ПоляВыборки)-2);
	
	ЗапросВыборка = Новый Запрос();
	ЗапросВыборка.УстановитьПараметр("ДокументСсылка", ДокументСсылка);
	ЗапросВыборка.Текст = "ВЫБРАТЬ " +  ПоляВыборки + "
					|ИЗ Документ." + ИмяДокумента + " КАК Документ
					|ГДЕ Документ.Ссылка = &ДокументСсылка";  
					
	// Выполняем запрос:
	Выборка = ЗапросВыборка.Выполнить().Выбрать();
	Выборка.Следующий();
	
	ЗаполнитьЗначенияСвойств(Результат, Выборка);
	
	Возврат Результат;
	
КонецФункции

Процедура ВыгрузитьТаблицыЗапроса(Приемник, РезультатЗапроса, ТаблицыЗапроса) Экспорт
	
	Если ТипЗнч(ТаблицыЗапроса) = Тип("Структура") Тогда
		
		Для Каждого НомерТаблицы Из ТаблицыЗапроса Цикл
			Приемник.Вставить(НомерТаблицы.Ключ, РезультатЗапроса[НомерТаблицы.Значение].Выгрузить());
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(ТаблицыЗапроса) = Тип("Массив") Тогда
		
		НомерТаблицы = 0;                 
		
		Для Каждого ИмяТаблицы Из ТаблицыЗапроса Цикл
			
			Если ЗначениеЗаполнено(ИмяТаблицы) Тогда
				Приемник.Вставить(ИмяТаблицы, РезультатЗапроса[НомерТаблицы].Выгрузить());
			КонецЕсли;
			
			НомерТаблицы = НомерТаблицы + 1;
			
		КонецЦикла;	
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьПараметрыПроверкиРеквизитов() Экспорт
	
	ПараметрыПроверки = Новый Структура();
	ПараметрыПроверки.Вставить("ПроверяемыеРеквизиты",				Новый Массив());
	ПараметрыПроверки.Вставить("ПроверяемыеСубконто",				Новый Структура());
	ПараметрыПроверки.Вставить("ПроверяемыеПризнакиУчета",			Новый Структура());
	ПараметрыПроверки.Вставить("ПараметрыДляПроверкиУсловий",		Новый Структура());
	ПараметрыПроверки.Вставить("ПроверяемыеРеквизитыУсловия",		Новый Структура());
	ПараметрыПроверки.Вставить("ПроверяемыеСубконтоУсловия",		Новый Структура());
	ПараметрыПроверки.Вставить("ИсключаемыеРеквизиты",				Новый Массив());
	ПараметрыПроверки.Вставить("ПереопределяемыеТабличныеЧасти",	Новый Структура());
	ПараметрыПроверки.Вставить("МаксКолвоСообщений",				200);
	ПараметрыПроверки.Вставить("ВыводитьСообщения",					Истина);
	
	ПараметрыПроверки.Вставить("ПеренаправлениеВыводаСообщений_ТабличныеЧасти",	Новый Структура());
	ПараметрыПроверки.Вставить("ПеренаправлениеВыводаСообщений_Реквизиты",		Новый Соответствие());
	
	Возврат ПараметрыПроверки;
	
КонецФункции

// Проверяет заполненность указанных реквизитов шапки и табличных частей.
//	Можно проверять заполненность реквизитов как безусловно (параметр "ПроверяемыеРеквизиты"),
// так и в зависимости от счета, расположенного в проверяемой строке (параметры "ПроверяемыеСубконто"
// и "ПроверяемыеПризнакиУчета"). Можно указать несколько таких наборов полей, зависящих от
// нескольких различных полей счетов.
//
// Параметры:
// ----------
//	ДокументОбъект		- (документ-объект) Проверяемый документ.
//	ПараметрыПроверки	- (структура) Определяет состав проверяемых реквизитов
//						и параметры выполняемых проверок. См.ПолучитьПараметрыПроверкиРеквизитов()
//						Ожидаются ключи:
//		  /	* ПроверяемыеРеквизиты		- Массив из строк
// произ  |								Пример:	"Организация", "Дата"	- реквизиты шапки,
// воль   |								"Основная.КФО", "Дополнительная.Счет"	- реквизиты табличных частей.
// ное --<	* ПроверяемыеСубконто		- Структура - Ключ=Имя табличной части,
//		  |								Значение=(соответствие или массив соответствий) обозначений субконто и колонок
// соче-  |								(2 варианта - по номеру субконто или виду субконто).
// тание  \	* ПроверяемыеПризнакиУчета	- Структура - Ключ=Имя табличной части,
//										Значение=(структура или массив структур) признаки учета и колонки.
//			* ПеренаправлениеВыводаСообщений_ТабличныеЧасти	- Структура - Ключ=Имя табличной части,
//															Значение=Имя другой табл.части с идентичными колонками,
//															которой будут адресоваться сообщения.
//			* ПеренаправлениеВыводаСообщений_Реквизиты	- Соответствие
//											Пример: ["Сотрудник", "Организация"] - реквизит шапки
//													["Основная.КФО", "КФОПредставление"]	- реквизит табл.части
//			* ПараметрыДляПроверкиУсловий	- Структура - значения параметров, доступных для использования
//											при проверке выполнения условий проверки заполненности реквизитов.
//											В текстах условий обращение к значению параметра
//											осуществляется в виде &<ИмяПараметра>.
//			* ПроверяемыеРеквизитыУсловия	- Структура - тексты условий, используемых при проверке заполненности
//											реквизитов в табличной части, кроме реквизитов субконто.
//											Если результат проверки условия = Истина, то проверка заполненности выполняется,
//											Если результат проверки условия = Ложь, то заполненность не проверяется.
//											Ключ - Имя табличной части,
//		  									Значение - Структура - тексты условий, индивидуально для различных полей.
//													Ключ - ИмяРеквизита
//													Значение - Строка - текст условия на языке СКД.
//													Допустимо обращение к полям проверяемой строки табличной части
//													и к параметрам для проверки условий.
//			* ПроверяемыеСубконтоУсловия	- Структура - тексты условий, используемых при проверке заполненности
//											реквизитов в табличной части, являющихся реквизитами субконто.
//											Если результат проверки условия = Истина, то проверка заполненности выполняется,
//											Если результат проверки условия = Ложь, то заполненность не проверяется.
//											Ключ - Имя табличной части,
//		  									Значение - Структура - тексты условий, проверяемые для указанного поля счета
//													Ключ - ИмяПоляСчета (ИмяПоляСвязиСчет)
//													Значение - Строка - текст условия на языке СКД.
//													Допустимо обращение к полям проверяемой строки табличной части
//													и к параметрам для проверки условий,
//													ВидыСубконто_НомерСубконто_<ИмяПоляСвязиСчет>,
//													ВидыСубконто_ВидСубконто_<ИмяПоляСвязиСчет>,
//													ВидыСубконто_ВводПустыхСубконто_<ИмяПоляСвязиСчет>
//
//			* ПереопределяемыеТабличныеЧасти	- Структура	- таблицы значений, используемые вместо оригинальных табличных частей документа.
//											Может использоваться для проверки произвольных таблиц значений.
//											Ключ - имя табличной части.
//											Значение - таблица значений.
//											Опциональный параметр.
//			* МаксКолвоСообщений	- Число
//			* ВыводитьСообщения		- Булево
//
//	РезультатПроверки - Структура	- Возвращаемое значение. Результаты проверки. Содержит ключи:
//						* КоличествоОшибок
//						* СчетчикСообщений
//						* ПроверкаПрервана
//
// Возврат:
// --------
//	ИСТИНА,	если все указанные реквизиты заполнены,
//	ЛОЖЬ,	если хотя бы один реквизит не заполнен.
//
// Пример использования
