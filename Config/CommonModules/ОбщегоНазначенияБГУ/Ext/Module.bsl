//
// Возвращаемое значение:
//	Строка	- имя элемента формы, гарантированно отсутствующего на форме.
Функция ПолучитьУникальноеИмяЭлементаФормы(Форма, ЖелаемоеИмяЭлемента) Экспорт
	
	ШаблонИмени = "%1%2";
	
	ШаблонСчетчика = "_%1";
	
	ИмяКандидат = ЖелаемоеИмяЭлемента;
	
	Счетчик = 0;
	
	Пока Истина Цикл
		
		ИмяНайдено = (Форма.Элементы.Найти(ИмяКандидат) <> Неопределено);
		
		Если ИмяНайдено Тогда
			
			Счетчик = Счетчик + 1;
			
			СчетчикСтрокой = СтрШаблон(ШаблонСчетчика, Формат(Счетчик, "ЧГ="));
			
			ИмяКандидат = СтрШаблон(ШаблонИмени, ЖелаемоеИмяЭлемента, СчетчикСтрокой);
			
		Иначе	
			
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ИмяКандидат;
	
КонецФункции

// Возвращает имя команды формы, гарантированно отсутствующего на форме. Используется для добавления команд формы.
// Если команда формы с желаемым именем уже существует, будет выполнен перебор имен до появления уникального имени команды формы.
//
// Имя команды формы при переборе имен имеет вид <ЖелаемоеИмяКоманды_<Счетчик>, где <Счетчик> - число от 1.
//
// Параметры:
//	Форма				- Управляемая форма	- форма, в которой проверяется наличие команд.
//											Обязательный параметр;
//	ЖелаемоеИмяКоманды	- Строка	- начальное имя искомой команды.
//									Если команда формы с таким именем отсутствует на форме, то будет возвращено это значение;
