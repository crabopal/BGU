Функция СравнитьПоказателиТаблиц(Таблица1, Таблица2, Знач КоллекцияИменКолонокСвязи, Знач КоллекцияИменКолонокПоказателей, ЗапрашиваемыеСведения, УсловиеСписания = "") Экспорт
	
	Перем	МассивИменКолонокСвязи,
			МассивИменКолонокПоказателей,
			МассивИменОтсутствующихКолонок,
			СписыватьПриРазличныхЗнаках,
				// переменные для таблицы СписанияВОбеихТаблицахВРазмереСоответствия
				РассчитатьСписанияВОбеихТаблицахВРазмереСоответствия,
				ТаблицаСписанияВОбеихТаблицахВРазмереСоответствия,
				ПустыеЗначенияВсехПоказателей,
				ИменаВсехКолонокКромеПоказателей,
				ИменаВсехКолонокПоказателей,
				ИменаКолонокСуммирования,
				СлужебныеКолонки_ТаблицаСписанияВОбеихТаблицахВРазмереСоответствия,
				СлужебныеКолонкиИтогов_ТаблицаСписанияВОбеихТаблицахВРазмереСоответствия,
					// переменные для таблицы СписанияВОбеихТаблицахПолностьюТаблица1ИПервыеСтрокиТаблицы2
					РассчитатьСписанияВОбеихТаблицахПолностьюТаблица1ИПервыеСтрокиТаблицы2,
					ТаблицаСписанияВОбеихТаблицахПолностьюТаблица1ИПервыеСтрокиТаблицы2,
					ЗаполненаПерваяСтрока,
					ИменаКопируемыхКолонокТаблицы2;
	
	СписыватьПриРазличныхЗнаках = Ложь;
	
	// Входная проверка.
	МассивИменОтсутствующихКолонок = Новый Массив();
	// Приводим параметры к ожидаемому типу:
	Если ТипЗнч(КоллекцияИменКолонокСвязи) = Тип("Массив") Тогда
		МассивИменКолонокСвязи = КоллекцияИменКолонокСвязи;
	ИначеЕсли ТипЗнч(КоллекцияИменКолонокСвязи) = Тип("Структура") Тогда
		МассивИменКолонокСвязи = Новый Массив();
		Для Каждого Элем Из КоллекцияИменКолонокСвязи Цикл
			МассивИменКолонокСвязи.Добавить(Элем.Ключ);
		КонецЦикла;
	ИначеЕсли ТипЗнч(КоллекцияИменКолонокСвязи) = Тип("Строка") Тогда
		МассивИменКолонокСвязи = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(КоллекцияИменКолонокСвязи);
	КонецЕсли;
	
	Если ТипЗнч(КоллекцияИменКолонокПоказателей) = Тип("Массив") Тогда
		МассивИменКолонокПоказателей = КоллекцияИменКолонокПоказателей;
	ИначеЕсли ТипЗнч(КоллекцияИменКолонокПоказателей) = Тип("Структура") Тогда
