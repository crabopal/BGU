#Область СлужебныеПроцедурыИФункции

Функция МассивИлиСтруктуруВСтроку(МассивИлиСтруктура, СимволРазделитель = ",", КлючИлиЗначение = "Ключ")
	
	Результат = "";
	
	// Входная проверка:
	Если ТипЗнч(МассивИлиСтруктура) = Тип("Массив") Тогда
		ЭтоМассив = Истина;
		
	ИначеЕсли ТипЗнч(МассивИлиСтруктура) = Тип("Структура") Тогда
		ЭтоМассив = Ложь;
		Если НЕ КлючИлиЗначение = "Ключ" Тогда
			КлючИлиЗначение = "Значение";
		КонецЕсли;
		
	Иначе
		Возврат Результат;
	КонецЕсли;
	
	ПервыйЭлемент = Истина;
	Для Каждого Элем Из МассивИлиСтруктура Цикл
		
		Если ЭтоМассив Тогда
			Результат = Результат + ?(ПервыйЭлемент, "", СимволРазделитель) + Элем;
		Иначе
			// Это структура.
			Результат = Результат + ?(ПервыйЭлемент, "", СимволРазделитель) + Элем[КлючИлиЗначение];
		КонецЕсли;
		
		ПервыйЭлемент = Ложь;
	КонецЦикла;	
	
	Возврат Результат;
	
КонецФункции

Функция ИмяРеквизитаСинтаксическиКорректно(ИмяРеквизита)
	
	Попытка
		Если ТипЗнч(ИмяРеквизита) = Тип("Строка") Тогда
			Если НЕ ПустаяСтрока(ИмяРеквизита) Тогда
				ВремСтруктура = Новый Структура(ИмяРеквизита);
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Возврат Ложь;
	
КонецФункции

Функция СледуетИсключитьРеквизит(ИмяРеквизита, ИмяТаблЧасти="", ИсключаемыеРеквизиты)
	
	ПроверяемоеИмя = ?(ЗначениеЗаполнено(ИмяТаблЧасти),
		ИмяТаблЧасти + "." + ИмяРеквизита,
		ИмяРеквизита);
	
	РеквизитНайден = НЕ (ИсключаемыеРеквизиты.Найти(ПроверяемоеИмя) = Неопределено);
	
	Возврат РеквизитНайден;
	
КонецФункции

#Область СравнениеОбъектов

Функция СравнитьОбъекты(Источник,Приемник,ПараметрыСравнения)
	Если ТипЗнч(Источник)<>ТипЗнч(Приемник) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("Число"));
	МассивТипов.Добавить(Тип("Строка"));
	МассивТипов.Добавить(Тип("Дата"));
	МассивТипов.Добавить(Тип("Булево"));
	
	СписокТипов = Новый ОписаниеТипов(МассивТипов);
	
	Если СписокТипов.СодержитТип(ТипЗнч(Источник))		
		ИЛИ Справочники.ТипВсеСсылки().СодержитТип(ТипЗнч(Источник)) 	
		ИЛИ Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(Источник))		
		ИЛИ ПланыВидовРасчета.ТипВсеСсылки().СодержитТип(ТипЗнч(Источник))		
		ИЛИ Перечисления.ТипВсеСсылки().СодержитТип(ТипЗнч(Источник))
		ИЛИ ПланыВидовХарактеристик.ТипВсеСсылки().СодержитТип(ТипЗнч(Источник))
		ИЛИ ПланыСчетов.ТипВсеСсылки().СодержитТип(ТипЗнч(Источник))
        ИЛИ ПланыОбмена.ТипВсеСсылки().СодержитТип(ТипЗнч(Источник)) Тогда
		Возврат Источник = Приемник;
	КонецЕсли;
	
	Если ТипЗнч(Источник)=Тип("Структура") Тогда
		Возврат СравнитьСтруктуры(Источник,Приемник,ПараметрыСравнения);
	КонецЕсли; 
	
	Если ТипЗнч(Источник)=Тип("Соответствие") Тогда
		Возврат СравнитьСоответствия(Источник,Приемник,ПараметрыСравнения);
	КонецЕсли;
	
	Если ТипЗнч(Источник)=Тип("Массив") Тогда
		Возврат СравнитьМассивы(Источник,Приемник,ПараметрыСравнения);
	КонецЕсли;
	
	Если ТипЗнч(Источник)=Тип("ТаблицаЗначений") Тогда
		ПараметрыСравнения.Уровень = ПараметрыСравнения.Уровень + 1;
		Возврат СравнитьТаблицыЗначений(Источник,Приемник,ПараметрыСравнения);
	КонецЕсли;
	
	Если ТипЗнч(Источник)=Тип("СтрокаТаблицыЗначений") Тогда
		ПараметрыСравнения.Уровень = ПараметрыСравнения.Уровень + 1;
		Возврат СравнитьСтрокиТаблицыЗначений(Источник,Приемник,ПараметрыСравнения);
	КонецЕсли;
	
	Если ТипЗнч(Источник)=Тип("ДеревоЗначений") Тогда
		ПараметрыСравнения.Уровень = ПараметрыСравнения.Уровень + 1;
		Возврат СравнитьДеревьяЗначений(Источник,Приемник,ПараметрыСравнения);
	КонецЕсли;
	
	Если ТипЗнч(Источник)=Тип("СтрокаДереваЗначений") Тогда
		ПараметрыСравнения.Уровень = ПараметрыСравнения.Уровень + 1;
		Возврат СравнитьСтрокиДеревьевЗначений(Источник,Приемник,ПараметрыСравнения);
	КонецЕсли;
	
	// Если алгоритм дошел до данной точки, значит в источнике содержится значение,
	// не поддерживаемое для сравнения на данный момент.
	Попытка
		Результат = Источник = Приемник;
	Исключение
		Результат = Ложь;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция СравнитьСтруктуры(Источник,Приемник,ПараметрыСравнения)
	
	Перем	КолонкиСравнения,
			КоллекцияИсточникЭтоСтруктура,
			ЗначениеИсточник,
			ЗначениеПриемник;
	
	СравниватьВсеЭлементы = Истина;
	Если ТипЗнч(ПараметрыСравнения) = Тип("Структура") Тогда
		Если ПараметрыСравнения.Свойство("КолонкиСравнения", КолонкиСравнения) Тогда
			Если ТипЗнч(КолонкиСравнения) = Тип("Массив") Тогда
				СравниватьВсеЭлементы = (КолонкиСравнения.Количество() = 0);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если СравниватьВсеЭлементы Тогда
		Если Источник.Количество() <> Приемник.Количество() Тогда
			Возврат Ложь;
		КонецЕсли;
		КоллекцияИсточник = Источник;
		КоллекцияИсточникЭтоСтруктура = Истина;
	Иначе
		// Сравниваем только элементы с указанными именами.
		КоллекцияИсточник = КолонкиСравнения;
		КоллекцияИсточникЭтоСтруктура = Ложь;
	КонецЕсли;
	
	Для Каждого ЭлементИсточник Из КоллекцияИсточник Цикл
		ИмяЭлемента = ?(КоллекцияИсточникЭтоСтруктура, ЭлементИсточник.Ключ, ЭлементИсточник["Имя"]);
		
		Если Приемник.Свойство(ИмяЭлемента, ЗначениеПриемник) Тогда
			Источник.Свойство(ИмяЭлемента, ЗначениеИсточник);
			Если НЕ СравнитьОбъекты(ЗначениеИсточник, ЗначениеПриемник, ПараметрыСравнения) Тогда
				Возврат Ложь;
			КонецЕсли;	
		Иначе
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция СравнитьСоответствия(Источник,Приемник,ПараметрыСравнения)
	
	Если Источник.Количество() <> Приемник.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого КлючИЗначение Из Источник Цикл
		ЗначениеПриемника = Неопределено;
		ЗначениеПриемника = Приемник.Получить(КлючИЗначение.Ключ);
		Если НЕ СравнитьОбъекты(КлючИЗначение.Значение,ЗначениеПриемника, ПараметрыСравнения) Тогда
			Возврат Ложь;
		КонецЕсли;	
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция СравнитьМассивы(Источник, Приемник, ПараметрыСравнения)
	
	Если Источник.Количество() <> Приемник.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Инд = 0 По Источник.Количество()-1 Цикл
		Если НЕ СравнитьОбъекты(Источник[Инд],Приемник[Инд], ПараметрыСравнения) Тогда
			Возврат Ложь;
		КонецЕсли;		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция СравнитьТаблицыЗначений(Источник, Приемник, ПараметрыСравнения)
	Если ПараметрыСравнения.Свойство("КолонкиСравнения") И ПараметрыСравнения.Уровень = 1  Тогда
		КолонкиИсточника = ПараметрыСравнения.КолонкиСравнения; 
	Иначе
		КолонкиИсточника =  Источник.Колонки;
		КолонкиПриемника =  Приемник.Колонки;

		Если Источник.Количество() <> Приемник.Количество()
			ИЛИ НЕ СравнитьКолонки(КолонкиИсточника,КолонкиПриемника) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Для Инд = 0 По Источник.Количество()-1 Цикл
		Для Каждого Колонка Из КолонкиИсточника Цикл
			Если НЕ СравнитьОбъекты(Источник[Инд][Колонка.Имя],Приемник[Инд][Колонка.Имя], ПараметрыСравнения) Тогда
				Возврат Ложь;
			КонецЕсли;					
		КонецЦикла;
	КонецЦикла;
	Возврат Истина;
	
КонецФункции

Функция СравнитьСтрокиТаблицыЗначений(Источник,Приемник, ПараметрыСравнения)
	Если ПараметрыСравнения.Свойство("КолонкиСравнения") И ПараметрыСравнения.Уровень = 1  Тогда
		КолонкиИсточника = ПараметрыСравнения.КолонкиСравнения; 
	Иначе
		КолонкиИсточника =  Источник.Владелец().Колонки;
		КолонкиПриемника =  Приемник.Владелец().Колонки;
		Если НЕ СравнитьКолонки(КолонкиИсточника,КолонкиПриемника) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого Колонка Из КолонкиИсточника Цикл
		Если НЕ СравнитьОбъекты(Источник[Колонка.Имя],Приемник[Колонка.Имя],ПараметрыСравнения) Тогда
			Возврат Ложь;
		КонецЕсли;				
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция СравнитьДеревьяЗначений(Источник,Приемник, ПараметрыСравнения)
	Если ПараметрыСравнения.Свойство("КолонкиСравнения") И ПараметрыСравнения.Уровень = 1 Тогда
		КолонкиИсточника = ПараметрыСравнения.КолонкиСравнения; 
	Иначе	
		КолонкиИсточника = Источник.Колонки;
		КолонкиПриемника = Приемник.Колонки;

		Если Источник.Количество() <> Приемник.Количество() 
			ИЛИ НЕ СравнитьКолонки(КолонкиИсточника,КолонкиПриемника) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	ИсключаяДочерниеСтроки = Неопределено;
	
	Если НЕ ПараметрыСравнения.Свойство("ИсключаяДочерниеСтроки",ИсключаяДочерниеСтроки) Тогда
		ИсключаяДочерниеСтроки = Ложь;
	КонецЕсли;
	
	Если Источник.Строки.Количество() <> Приемник.Строки.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Инд = 0 По Источник.Строки.Количество()-1 Цикл
		Для Каждого Колонка Из КолонкиИсточника Цикл
			Если НЕ СравнитьОбъекты(Источник.Строки[Инд][Колонка.Имя],Приемник.Строки[Инд][Колонка.Имя], ПараметрыСравнения) Тогда
				Возврат Ложь;
			КонецЕсли;					
		КонецЦикла;
		Если НЕ ИсключаяДочерниеСтроки Тогда
			Если Источник.Строки[Инд].Строки.Количество() <> Приемник.Строки[Инд].Строки.Количество() Тогда
				Возврат Ложь;
			ИначеЕсли Источник.Строки[Инд].Строки.Количество() > 0 Тогда
				ПараметрыСравнения.Вставить("КолонкиСравнения",КолонкиИсточника);
				СравнитьДеревьяЗначений(Источник.Строки[Инд],Приемник.Строки[Инд], ПараметрыСравнения)
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция СравнитьСтрокиДеревьевЗначений(Источник,Приемник, ПараметрыСравнения)
	Если ПараметрыСравнения.Свойство("КолонкиСравнения") И ПараметрыСравнения.Уровень = 1 Тогда
		КолонкиИсточника = ПараметрыСравнения.КолонкиСравнения; 
	Иначе	

		КолонкиИсточника =  Источник.Владелец().Колонки;
		КолонкиПриемника =  Приемник.Владелец().Колонки;

		Если НЕ СравнитьКолонки(КолонкиИсточника,КолонкиПриемника) Тогда
			Возврат Ложь;
		КонецЕсли; 
		
	КонецЕсли;
	ИсключаяДочерниеСтроки = Неопределено;
	
	Если НЕ ПараметрыСравнения.Свойство("ИсключаяДочерниеСтроки",ИсключаяДочерниеСтроки) Тогда
		ИсключаяДочерниеСтроки = Ложь;
	КонецЕсли;
	
	Для Каждого Колонка Из КолонкиИсточника Цикл
		Если НЕ СравнитьОбъекты(Источник[Колонка.Имя],Приемник[Колонка.Имя], ПараметрыСравнения) Тогда
			Возврат Ложь;
		КонецЕсли;					
	КонецЦикла;
	Если НЕ ИсключаяДочерниеСтроки Тогда
		Если Источник.Строки.Количество() <> Приемник.Строки.Количество() Тогда
			Возврат Ложь;
		ИначеЕсли Источник.Строки.Количество() > 0 Тогда
			ПараметрыСравнения.Вставить("КолонкиСравнения",КолонкиИсточника);
			СравнитьДеревьяЗначений(Источник,Приемник, ПараметрыСравнения)
		КонецЕсли;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция СравнитьКолонки(КолонкиИсточника,КолонкиПриемника)
	Если КолонкиИсточника.Количество() <> КолонкиПриемника.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого Колонка Из КолонкиИсточника Цикл
		Если КолонкиПриемника.Найти(Колонка.Имя)=Неопределено Тогда 
			Возврат Ложь;
		КонецЕсли;					
	КонецЦикла;
	
    Возврат Истина;
	
КонецФункции

Функция СформироватьКоллекциюКолонок(ВходящийМассивКолонок)
	МассивКолонок = Новый Массив;
	Для Каждого ЭлМас Из ВходящийМассивКолонок Цикл
		СтруктураКолонки = Новый Структура;
		СтруктураКолонки.Вставить("Имя",ЭлМас);
		МассивКолонок.Добавить(СтруктураКолонки);
	КонецЦикла;
	Возврат МассивКолонок;
КонецФункции	

#КонецОбласти

#Область ОбработкаТаблиц
 
Процедура ОбновитьФлагиВСтроке(СтрокаТаблицы, Знач СлужебныеКолонки, Знач СлужебныеКолонкиИтогов, Знач МассивИменКолонокПоказателей)
	
	// Инициализация итогов по строке:
	СписаноПолностью	= Истина;	// полностью списан КАЖДЫЙ показатель (условие по И)
	Превышение			= Ложь;		// есть превышение ХОТЯ БЫ у одного показателя (условие по ИЛИ)
	
	// Индивидуальные флажки для каждого показателя:
	Для Каждого ИмяКолонкиПоказателя Из МассивИменКолонокПоказателей Цикл
		ИмяКолонкиСписаноПолностью		= СлужебныеКолонки["СписаноПолностью"][ИмяКолонкиПоказателя];
		ИмяКолонкиСписаноЧастично		= СлужебныеКолонки["СписаноЧастично"][ИмяКолонкиПоказателя];
		ИмяКолонкиНеСписаноПолностью	= СлужебныеКолонки["НеСписаноПолностью"][ИмяКолонкиПоказателя];
		ИмяКолонкиПревышение			= СлужебныеКолонки["Превышение"][ИмяКолонкиПоказателя];
		Списано	= СтрокаТаблицы[СлужебныеКолонки["Списано"][ИмяКолонкиПоказателя]];
		Остаток	= СтрокаТаблицы[СлужебныеКолонки["Остаток"][ИмяКолонкиПоказателя]];
		Если Остаток = 0 Тогда
			СтрокаТаблицы[ИмяКолонкиСписаноПолностью]	= Истина;
			СтрокаТаблицы[ИмяКолонкиСписаноЧастично]	= Ложь;
			СтрокаТаблицы[ИмяКолонкиНеСписаноПолностью]	= Ложь;
		ИначеЕсли Списано = 0 Тогда
			СтрокаТаблицы[ИмяКолонкиСписаноПолностью]	= Ложь;
			СтрокаТаблицы[ИмяКолонкиСписаноЧастично]	= Ложь;
			СтрокаТаблицы[ИмяКолонкиНеСписаноПолностью]	= Истина;
		Иначе
			СтрокаТаблицы[ИмяКолонкиСписаноПолностью]	= Ложь;
			СтрокаТаблицы[ИмяКолонкиСписаноЧастично]	= Истина;
			СтрокаТаблицы[ИмяКолонкиНеСписаноПолностью]	= Ложь;
		КонецЕсли;
		СтрокаТаблицы[ИмяКолонкиПревышение]	= (СтрокаТаблицы[ИмяКолонкиСписаноЧастично] ИЛИ СтрокаТаблицы[ИмяКолонкиНеСписаноПолностью]);
		
		// Итоги по строке:
		СписаноПолностью = СписаноПолностью И СтрокаТаблицы[ИмяКолонкиСписаноПолностью];
		Превышение = Превышение ИЛИ СтрокаТаблицы[ИмяКолонкиПревышение];
	КонецЦикла;
	
	// Флажки для каждой строки в целом (итоги):
	СтрокаТаблицы[СлужебныеКолонкиИтогов["СписаноПолностью"]]	= СписаноПолностью;
	СтрокаТаблицы[СлужебныеКолонкиИтогов["Превышение"]]			= Превышение;
	
КонецПроцедуры

Функция ДобавитьСлужебныеКолонкиВТаблицу(Таблица, МассивИменКолонокПоказателей, КолонкиТаблицы)
	
	ТипБулево = Новый ОписаниеТипов("Булево");
	
	СлужебныеКолонки = Новый Структура();
	СлужебныеКолонки.Вставить("Списано",			Новый Структура());
	СлужебныеКолонки.Вставить("Остаток",			Новый Структура());
	СлужебныеКолонки.Вставить("СписаноПолностью",	Новый Структура());
	СлужебныеКолонки.Вставить("СписаноЧастично",	Новый Структура());
	СлужебныеКолонки.Вставить("НеСписаноПолностью",	Новый Структура());
	СлужебныеКолонки.Вставить("Превышение",			Новый Структура());
	
	Для Каждого ИмяКолонкиПоказателя Из МассивИменКолонокПоказателей Цикл
		ОписаниеТиповКолонки = Таблица.Колонки[ИмяКолонкиПоказателя].ТипЗначения;
		
		// Добавлеям служебные колонки:
		ИмяДобавленнойКолонкиСписано			= ДобавитьКолонкуВТаблицу(Таблица, ИмяКолонкиПоказателя + "_Списано",			ОписаниеТиповКолонки);
		ИмяДобавленнойКолонкиОстаток			= ДобавитьКолонкуВТаблицу(Таблица, ИмяКолонкиПоказателя + "_Остаток",			ОписаниеТиповКолонки);
		ИмяДобавленнойКолонкиСписаноПолностью	= ДобавитьКолонкуВТаблицу(Таблица, ИмяКолонкиПоказателя + "_СписаноПолностью",	ТипБулево);
		ИмяДобавленнойКолонкиСписаноЧастично	= ДобавитьКолонкуВТаблицу(Таблица, ИмяКолонкиПоказателя + "_СписаноЧастично",	ТипБулево);
		ИмяДобавленнойКолонкиНеСписаноПолностью	= ДобавитьКолонкуВТаблицу(Таблица, ИмяКолонкиПоказателя + "_НеСписаноПолностью",ТипБулево);
		ИмяДобавленнойКолонкиПревышение			= ДобавитьКолонкуВТаблицу(Таблица, ИмяКолонкиПоказателя + "_Превышение",		ТипБулево);
		
		СлужебныеКолонки["Списано"].Вставить(ИмяКолонкиПоказателя,				ИмяДобавленнойКолонкиСписано);
		СлужебныеКолонки["Остаток"].Вставить(ИмяКолонкиПоказателя,				ИмяДобавленнойКолонкиОстаток);
		СлужебныеКолонки["СписаноПолностью"].Вставить(ИмяКолонкиПоказателя,		ИмяДобавленнойКолонкиСписаноПолностью);
		СлужебныеКолонки["СписаноЧастично"].Вставить(ИмяКолонкиПоказателя,		ИмяДобавленнойКолонкиСписаноЧастично);
		СлужебныеКолонки["НеСписаноПолностью"].Вставить(ИмяКолонкиПоказателя,	ИмяДобавленнойКолонкиНеСписаноПолностью);
		СлужебныеКолонки["Превышение"].Вставить(ИмяКолонкиПоказателя,			ИмяДобавленнойКолонкиПревышение);
		
		// Запоминаем имена созданных колонок:
		СлужебныеМассив = Неопределено;
		Если НЕ КолонкиТаблицы.Свойство("СлужебныеМассив", СлужебныеМассив) Тогда
			СлужебныеМассив = Новый Массив();
		КонецЕсли;
		СлужебныеМассив.Добавить(ИмяДобавленнойКолонкиСписано);
		СлужебныеМассив.Добавить(ИмяДобавленнойКолонкиОстаток);
		СлужебныеМассив.Добавить(ИмяДобавленнойКолонкиСписаноПолностью);
		СлужебныеМассив.Добавить(ИмяДобавленнойКолонкиСписаноЧастично);
		СлужебныеМассив.Добавить(ИмяДобавленнойКолонкиНеСписаноПолностью);
		СлужебныеМассив.Добавить(ИмяДобавленнойКолонкиПревышение);
		КолонкиТаблицы.Вставить("СлужебныеМассив",	СлужебныеМассив);
		КолонкиТаблицы.Вставить("Служебные",		СтрСоединить(СлужебныеМассив, ","));
		
		// Служебная колонка "Списано" - сначала равна 0.
		Таблица.ЗаполнитьЗначения(0, СлужебныеКолонки["Списано"][ИмяКолонкиПоказателя]);
		
		// Инициализируем служебную колонку "Остаток" - он сначала равен самим значениям показателя:
		ЗначенияПоказателя = Таблица.ВыгрузитьКолонку(ИмяКолонкиПоказателя);
		Таблица.ЗагрузитьКолонку(
			ЗначенияПоказателя,
			СлужебныеКолонки["Остаток"][ИмяКолонкиПоказателя]);
	КонецЦикла;
	
	Возврат СлужебныеКолонки;
	
КонецФункции

Функция ДобавитьСлужебныеКолонкиИтоговВТаблицу(Таблица, КолонкиТаблицы)
	
	ТипБулево = Новый ОписаниеТипов("Булево");
	
	СлужебныеКолонкиИтогов = Новый Структура();
	
	ИмяДобавленнойКолонкиСтрокаОбработана	= ДобавитьКолонкуВТаблицу(Таблица, "СтрокаОбработана",	ТипБулево);
	ИмяДобавленнойКолонкиСписаноПолностью	= ДобавитьКолонкуВТаблицу(Таблица, "СписаноПолностью",	ТипБулево);
	ИмяДобавленнойКолонкиПревышение			= ДобавитьКолонкуВТаблицу(Таблица, "Превышение",	ТипБулево);
	
	СлужебныеКолонкиИтогов.Вставить("СтрокаОбработана",	ИмяДобавленнойКолонкиСтрокаОбработана);
	СлужебныеКолонкиИтогов.Вставить("СписаноПолностью",	ИмяДобавленнойКолонкиСписаноПолностью);
	СлужебныеКолонкиИтогов.Вставить("Превышение",		ИмяДобавленнойКолонкиПревышение);
	
	
	// Запоминаем имена созданных колонок:
	СлужебныеМассив = Неопределено;
	Если НЕ КолонкиТаблицы.Свойство("СлужебныеМассив", СлужебныеМассив) Тогда
		СлужебныеМассив = Новый Массив();
	КонецЕсли;
	СлужебныеМассив.Добавить(ИмяДобавленнойКолонкиСтрокаОбработана);
	СлужебныеМассив.Добавить(ИмяДобавленнойКолонкиСписаноПолностью);
	СлужебныеМассив.Добавить(ИмяДобавленнойКолонкиПревышение);
	КолонкиТаблицы.Вставить("СлужебныеМассив",	СлужебныеМассив);
	КолонкиТаблицы.Вставить("Служебные",		СтрСоединить(СлужебныеМассив, ","));
	
	Возврат СлужебныеКолонкиИтогов;
	
КонецФункции

Функция ДобавитьСлужебныеКолонкиВТаблицуСписанияВОбеихТаблицахВРазмереСоответствия(Таблица, МассивИменКолонокПоказателей, КолонкиТаблицы)
	
	ТипБулево = Новый ОписаниеТипов("Булево");
	
	СлужебныеКолонки = Новый Структура();
	СлужебныеКолонки.Вставить("СписаноПолностью",			Новый Структура());
	СлужебныеКолонки.Вставить("СписаноЧастично",			Новый Структура());
	СлужебныеКолонки.Вставить("СписаноПолностьюВТаблице1",	Новый Структура());
	
	// Эти служебные колонки имеются также в обеих таблицах (1 и 2)
	ИменаСовпадающихСлужебныхКолонокСтрока = "";
	
	Для Каждого ИмяКолонкиПоказателя Из МассивИменКолонокПоказателей Цикл
		ОписаниеТиповКолонки = Таблица.Колонки[ИмяКолонкиПоказателя].ТипЗначения;
		
		// Добавлеям служебные колонки:
		ИмяДобавленнойКолонкиСписаноПолностью			= ДобавитьКолонкуВТаблицу(Таблица, ИмяКолонкиПоказателя + "_СписаноПолностью",	ТипБулево);
		ИмяДобавленнойКолонкиСписаноЧастично			= ДобавитьКолонкуВТаблицу(Таблица, ИмяКолонкиПоказателя + "_СписаноЧастично",	ТипБулево);
		ИмяДобавленнойКолонкиСписаноПолностьюВТаблице1	= ДобавитьКолонкуВТаблицу(Таблица, ИмяКолонкиПоказателя + "_СписаноПолностьюВТаблице1",	ТипБулево);
		
		СлужебныеКолонки["СписаноПолностью"].Вставить(ИмяКолонкиПоказателя,				ИмяДобавленнойКолонкиСписаноПолностью);
		СлужебныеКолонки["СписаноЧастично"].Вставить(ИмяКолонкиПоказателя,				ИмяДобавленнойКолонкиСписаноЧастично);
		СлужебныеКолонки["СписаноПолностьюВТаблице1"].Вставить(ИмяКолонкиПоказателя,	ИмяДобавленнойКолонкиСписаноПолностьюВТаблице1);
		
		// Запоминаем имена созданных колонок:
		СлужебныеМассив = Неопределено;
		Если НЕ КолонкиТаблицы.Свойство("СлужебныеМассив", СлужебныеМассив) Тогда
			СлужебныеМассив = Новый Массив();
		КонецЕсли;
		СлужебныеМассив.Добавить(ИмяДобавленнойКолонкиСписаноПолностью);
		СлужебныеМассив.Добавить(ИмяДобавленнойКолонкиСписаноЧастично);
		КолонкиТаблицы.Вставить("СлужебныеМассив",	СлужебныеМассив);
		КолонкиТаблицы.Вставить("Служебные",		СтрСоединить(СлужебныеМассив, ","));
		
		ИменаСовпадающихСлужебныхКолонокСтрока = ИменаСовпадающихСлужебныхКолонокСтрока
			+ ?(ЗначениеЗаполнено(ИменаСовпадающихСлужебныхКолонокСтрока), ",", "")
			+ ИмяДобавленнойКолонкиСписаноПолностью
			+ "," + ИмяДобавленнойКолонкиСписаноЧастично;
	КонецЦикла;
	
	СлужебныеКолонки.Вставить("ИменаСовпадающихСлужебныхКолонокСтрока",	ИменаСовпадающихСлужебныхКолонокСтрока);
	
	Возврат СлужебныеКолонки;
	
КонецФункции

Функция ДобавитьСлужебныеКолонкиИтоговВТаблицуСписанияВОбеихТаблицахВРазмереСоответствия(Таблица, КолонкиТаблицы)
	
	ТипНомерСтроки	= Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(6,0,ДопустимыйЗнак.Неотрицательный));
	
	СлужебныеКолонкиИтогов = Новый Структура();
	
	ИмяДобавленнойКолонкиИндексСтроки1		= ДобавитьКолонкуВТаблицу(Таблица, "ИндексСтроки1",		ТипНомерСтроки);
	ИмяДобавленнойКолонкиИндексСтроки2		= ДобавитьКолонкуВТаблицу(Таблица, "ИндексСтроки2",		ТипНомерСтроки);
	
	СлужебныеКолонкиИтогов.Вставить("ИндексСтроки1",	ИмяДобавленнойКолонкиИндексСтроки1);
	СлужебныеКолонкиИтогов.Вставить("ИндексСтроки2",	ИмяДобавленнойКолонкиИндексСтроки2);
	
	// Запоминаем имена созданных колонок:
	СлужебныеМассив = Неопределено;
	Если НЕ КолонкиТаблицы.Свойство("СлужебныеМассив", СлужебныеМассив) Тогда
		СлужебныеМассив = Новый Массив();
	КонецЕсли;
	СлужебныеМассив.Добавить(ИмяДобавленнойКолонкиИндексСтроки1);
	СлужебныеМассив.Добавить(ИмяДобавленнойКолонкиИндексСтроки2);
	КолонкиТаблицы.Вставить("СлужебныеМассив",	СлужебныеМассив);
	КолонкиТаблицы.Вставить("Служебные",		СтрСоединить(СлужебныеМассив, ","));
	
	Возврат СлужебныеКолонкиИтогов;
	
КонецФункции

Функция ДобавитьКолонкуВТаблицу(Таблица, Знач ИмяКолонкиКандидат, Знач ОписаниеТипаКолонки)
	
	Если Таблица.Колонки.Найти(ИмяКолонкиКандидат) <> Неопределено Тогда
		// Такая служебная колонка уще существует.
		// Удаляем такую колонку.
		// Вероятнее всего, она оказалась в таблице потому,
		// что ранее эта таблица уже была подвергнута обработке.
		Таблица.Колонки.Удалить(ИмяКолонкиКандидат);
	КонецЕсли;
	
	Таблица.Колонки.Добавить(ИмяКолонкиКандидат, ОписаниеТипаКолонки);
	
	Возврат ИмяКолонкиКандидат;
	
КонецФункции

Процедура УдалитьСлужебныеКолонкиТаблицы(Таблица, СлужебныеКолонки)
	
	Для Каждого ОбозначениеКолонки Из СлужебныеКолонки Цикл
		Для Каждого ДобавленнаяКолонка Из ОбозначениеКолонки.Значение Цикл
			ИмяКолонки = ДобавленнаяКолонка.Значение;
			Таблица.Колонки.Удалить(ИмяКолонки);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьСлужебныеКолонкиИтогоТаблицы(Таблица, СлужебныеКолонкиИтогов)
	
	Для Каждого ОбозначениеКолонки Из СлужебныеКолонкиИтогов Цикл
		ИмяКолонки = ОбозначениеКолонки.Значение;
		Таблица.Колонки.Удалить(ИмяКолонки);
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьСведения_ПревышенияТаблицы1НадТаблицей2(ОбработаннаяТаблица1, СлужебныеКолонки, СлужебныеКолонкиИтогов, МассивИменКолонокПоказателей)
	
	// Возвращаемая таблица:
	КЧ = Новый КвалификаторыЧисла(5, 0, ДопустимыйЗнак.Неотрицательный);
	ТипНомерСтроки = Новый ОписаниеТипов("Число", КЧ);
	ТипТЗ = Новый ОписаниеТипов("ТаблицаЗначений");
	Результат = Новый ТаблицаЗначений();
	Результат.Колонки.Добавить("НомерСтроки",	ТипНомерСтроки);
	Результат.Колонки.Добавить("Превышения",	ТипТЗ);
	
	Поиск = Новый Структура(СлужебныеКолонкиИтогов["Превышение"], Истина);
	МассивСтрок = ОбработаннаяТаблица1.НайтиСтроки(Поиск);
	ТаблицаПревышения = Новый ТаблицаЗначений();
	ТаблицаПревышения.Колонки.Добавить("ИмяКолонки",	Новый ОписаниеТипов("Строка"));
	ТаблицаПревышения.Колонки.Добавить("Превышение",	Новый ОписаниеТипов("Число"));
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		
		НомерСтроки = ОбработаннаяТаблица1.Индекс(СтрокаТаблицы) + 1;
		Для Каждого ИмяКолонкиПоказателя Из МассивИменКолонокПоказателей Цикл
			Если СтрокаТаблицы[СлужебныеКолонки["Превышение"][ИмяКолонкиПоказателя]] Тогда
				НоваяСтрока = ТаблицаПревышения.Добавить();
				НоваяСтрока["ИмяКолонки"] = ИмяКолонкиПоказателя;
				НоваяСтрока["Превышение"] = СтрокаТаблицы[СлужебныеКолонки["Остаток"][ИмяКолонкиПоказателя]];
			КонецЕсли;
		КонецЦикла;
		
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока["НомерСтроки"]	= НомерСтроки;
		НоваяСтрока["Превышения"]	= ТаблицаПревышения;
		
		ТаблицаПревышения = Новый ТаблицаЗначений();
		ТаблицаПревышения.Колонки.Добавить("ИмяКолонки",	Новый ОписаниеТипов("Строка"));
		ТаблицаПревышения.Колонки.Добавить("Превышение",	Новый ОписаниеТипов("Число"));
	КонецЦикла;
	
	Результат.Сортировать("НомерСтроки");
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСведения_СписанияВТаблицеВРазмереСоответствия(ОбработаннаяТаблица, СлужебныеКолонки, СлужебныеКолонкиИтогов, КолонкиТаблицы, МассивИменКолонокПоказателей)
	
	СлужебныеМассив = КолонкиТаблицы["СлужебныеМассив"];
	
	СоответствиеИменКолонок = Новый Соответствие();
	
	// Выгружаем отдельные служебные колонки
	ВыгружаемыеСлужебныеКолонки = Новый Массив();
	ВыгружаемыеСлужебныеКолонки.Добавить(СлужебныеКолонкиИтогов["СписаноПолностью"]);
	Для Каждого Элем Из СлужебныеКолонки["СписаноПолностью"] Цикл
		ВыгружаемыеСлужебныеКолонки.Добавить(Элем.Значение);
	КонецЦикла;
	
	// Выгружаем все изначальные колонки таблицы, кроме добавленных служебных:
	ИменаВыгружаемыхКолонок = "";
	Для Каждого Колонка Из ОбработаннаяТаблица.Колонки Цикл
		ИмяКолонки = Колонка.Имя;
		ЭтоКолонкаПоказателя = НЕ (МассивИменКолонокПоказателей.Найти(ИмяКолонки) = Неопределено);
		Если ЭтоКолонкаПоказателя Тогда
			ДобавитьКолонку = Истина;
			ИмяКолонкиСписано = СлужебныеКолонки["Списано"][ИмяКолонки];
			СоответствиеИменКолонок.Вставить(ИмяКолонки, ИмяКолонкиСписано);
			ИмяКолонки = ИмяКолонкиСписано; // подменяем имя колонки
		Иначе
			ЭтоИзначальнаяКолонка = (СлужебныеМассив.Найти(ИмяКолонки) = Неопределено);
			ДобавитьКолонку = ЭтоИзначальнаяКолонка ИЛИ НЕ (ВыгружаемыеСлужебныеКолонки.Найти(ИмяКолонки) = Неопределено);
		КонецЕсли;
		Если ДобавитьКолонку Тогда
			ИменаВыгружаемыхКолонок = ИменаВыгружаемыхКолонок
				+ ?(ИменаВыгружаемыхКолонок = "", "", ",")
				+ ИмяКолонки;
		КонецЕсли;
	КонецЦикла;
	Поиск = Новый Структура(СлужебныеКолонкиИтогов["СтрокаОбработана"], Истина);
	Результат = ОбработаннаяТаблица.Скопировать(Поиск, ИменаВыгружаемыхКолонок);
	
	// Переименовываем служебные колонки "Списано" в изначальные колонки показателей:
	Для Каждого Элемент Из СоответствиеИменКолонок Цикл
		ТекущееИмяКолонки	= Элемент.Значение;
		НовоеИмяКолонки		= Элемент.Ключ;
		Результат.Колонки[ТекущееИмяКолонки].Имя = НовоеИмяКолонки;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСведения_СписанияВТаблице2ВРазмереТаблицы1(СведенияТаблицы1, СведенияТаблицы2, МассивИменКолонокПоказателей)
	
	// Сначала берем строки с "успешным" списанием из таблицы 2:
	Результат = ПолучитьСведения_СписанияВТаблицеВРазмереСоответствия(
		СведенияТаблицы2["Таблица"],
		СведенияТаблицы2["СлужебныеКолонки"],
		СведенияТаблицы2["СлужебныеКолонкиИтогов"],
		СведенияТаблицы2["КолонкиТаблицы"],
		МассивИменКолонокПоказателей);
	
	// Теперь добавляем оставшиеся значения, но уже из таблицы 1:
	ИменаКолонокСвязи = СведенияТаблицы1["КолонкиТаблицы"]["Связь"];
	Поиск = Новый Структура(СведенияТаблицы1["СлужебныеКолонкиИтогов"]["Превышение"], Истина);
	МассивСтрокТаблицы1 = СведенияТаблицы1["Таблица"].НайтиСтроки(Поиск);
	Для Каждого СтрокаТаблицы1 Из МассивСтрокТаблицы1 Цикл
		НоваяСтрока = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы1, ИменаКолонокСвязи);
		
		Для Каждого ИмяКолонкиПоказателя Из МассивИменКолонокПоказателей Цикл
			ИмяКолонкиОстаток = СведенияТаблицы1["СлужебныеКолонки"]["Остаток"][ИмяКолонкиПоказателя];
			Остаток = СтрокаТаблицы1[ИмяКолонкиОстаток];
			НоваяСтрока[ИмяКолонкиПоказателя] = Остаток;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСведения_ОстаткиВТаблице(ОбработаннаяТаблица, СлужебныеКолонки, СлужебныеКолонкиИтогов, КолонкиТаблицы, МассивИменКолонокПоказателей)
	
	СлужебныеМассив = КолонкиТаблицы["СлужебныеМассив"];
	
	СоответствиеИменКолонок = Новый Соответствие();
	
	// Выгружаем все изначальные колонки таблицы, кроме добавленных служебных:
	ИменаВыгружаемыхКолонок = "";
	Для Каждого Колонка Из ОбработаннаяТаблица.Колонки Цикл
		ИмяКолонки = Колонка.Имя;
		ЭтоКолонкаПоказателя = НЕ (МассивИменКолонокПоказателей.Найти(ИмяКолонки) = Неопределено);
		Если ЭтоКолонкаПоказателя Тогда
			ДобавитьКолонку = Истина;
			ИмяКолонкиСписано = СлужебныеКолонки["Остаток"][ИмяКолонки];
			СоответствиеИменКолонок.Вставить(ИмяКолонки, ИмяКолонкиСписано);
			ИмяКолонки = ИмяКолонкиСписано; // подменяем имя колонки
		Иначе
			ЭтоИзначальнаяКолонка = (СлужебныеМассив.Найти(ИмяКолонки) = Неопределено);
			ДобавитьКолонку = ЭтоИзначальнаяКолонка;
		КонецЕсли;
		Если ДобавитьКолонку Тогда
			ИменаВыгружаемыхКолонок = ИменаВыгружаемыхКолонок
				+ ?(ИменаВыгружаемыхКолонок = "", "", ",")
				+ ИмяКолонки;
		КонецЕсли;
	КонецЦикла;
	Поиск = Новый Структура(СлужебныеКолонкиИтогов["СписаноПолностью"], Ложь);
	Результат = ОбработаннаяТаблица.Скопировать(Поиск, ИменаВыгружаемыхКолонок);
	
	// Переименовываем служебные колонки "Списано" в изначальные колонки показателей:
	Для Каждого Элемент Из СоответствиеИменКолонок Цикл
		ТекущееИмяКолонки	= Элемент.Значение;
		НовоеИмяКолонки		= Элемент.Ключ;
		Результат.Колонки[ТекущееИмяКолонки].Имя = НовоеИмяКолонки;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСведения_ТаблицаСписанияВОбеихТаблицахВРазмереСоответствия(	Таблица,
																			СлужебныеКолонки_ТаблицаСписанияВОбеихТаблицахВРазмереСоответствия,
																			Знач ИменаВсехКолонокКромеПоказателей,
																			ИменаКолонокСуммирования)
	
	// Удаляем строки, в которых вообще не было никаких списаний показателей
	
	Поиск = Новый Структура();
	
	Для Каждого ОписаниеКолонки Из СлужебныеКолонки_ТаблицаСписанияВОбеихТаблицахВРазмереСоответствия["СписаноПолностью"] Цикл
		ИмяКолонки = ОписаниеКолонки.Значение;
		Поиск.Вставить(ИмяКолонки, Ложь);
		
		Индекс = ИменаВсехКолонокКромеПоказателей.Найти(ИмяКолонки);
		Если Индекс <> Неопределено Тогда
			ИменаВсехКолонокКромеПоказателей.Удалить(Индекс);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ОписаниеКолонки Из СлужебныеКолонки_ТаблицаСписанияВОбеихТаблицахВРазмереСоответствия["СписаноЧастично"] Цикл
		ИмяКолонки = ОписаниеКолонки.Значение;
		Поиск.Вставить(ИмяКолонки, Ложь);
		
		Индекс = ИменаВсехКолонокКромеПоказателей.Найти(ИмяКолонки);
		Если Индекс <> Неопределено Тогда
			ИменаВсехКолонокКромеПоказателей.Удалить(Индекс);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ОписаниеКолонки Из СлужебныеКолонки_ТаблицаСписанияВОбеихТаблицахВРазмереСоответствия["СписаноПолностьюВТаблице1"] Цикл
		ИмяКолонки = ОписаниеКолонки.Значение;
		Поиск.Вставить(ИмяКолонки, Ложь);
		
		Индекс = ИменаВсехКолонокКромеПоказателей.Найти(ИмяКолонки);
		Если Индекс <> Неопределено Тогда
			ИменаВсехКолонокКромеПоказателей.Удалить(Индекс);
		КонецЕсли;
	КонецЦикла;
	
	МассивСтрок = Таблица.НайтиСтроки(Поиск);
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		Таблица.Удалить(СтрокаТаблицы);
	КонецЦикла;
	
	ИменаКолонокГруппировки = СтрСоединить(ИменаВсехКолонокКромеПоказателей, ",");
	
	Таблица.Свернуть(ИменаКолонокГруппировки, ИменаКолонокСуммирования);
	
	Возврат Таблица;
	
КонецФункции

Функция НайтиПервуюСтрокуТаблицы(Знач Таблица, Знач СтруктураПоиска)
	
	Результат = Неопределено;
	
	МассивСтрок = Таблица.НайтиСтроки(СтруктураПоиска);
	НаименьшийИндекс = Таблица.Количество();
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		ИндексСтроки = Таблица.Индекс(СтрокаТаблицы);
		Если ИндексСтроки < НаименьшийИндекс Тогда
			НаименьшийИндекс = ИндексСтроки;
			Результат = СтрокаТаблицы;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьОписаниеПредопределенногоУсловияСравненияПоказателейТаблиц(УсловиеСписания)
	
	ОписаниеПредопределенногоУсловия = НовыйОписаниеПредопределенногоУсловияСравненияПоказателейТаблиц();
	
	Если Не ЗначениеЗаполнено(УсловиеСписания) Тогда
		Возврат ОписаниеПредопределенногоУсловия;
	КонецЕсли;
	
	Если УсловиеСписания = "ПредопределенноеУсловие№1" Тогда
		ОписаниеПредопределенногоУсловия.Применяется = Истина;
		ОписаниеПредопределенногоУсловия.НомерУсловия = 1;
		
	ИначеЕсли СтрНачинаетсяС(УсловиеСписания, "ПредопределенноеУсловие№2") Тогда
		ОписаниеПредопределенногоУсловия.Применяется = Истина;
		ОписаниеПредопределенногоУсловия.НомерУсловия = 2;
		ОписаниеПредопределенногоУсловия.Параметры = ВыделитьПараметрыПредопределенногоУсловияСравненияПоказателейТаблиц(УсловиеСписания);
		
	ИначеЕсли СтрНачинаетсяС(УсловиеСписания, "ПредопределенноеУсловие№3") Тогда
		ОписаниеПредопределенногоУсловия.Применяется = Истина;
		ОписаниеПредопределенногоУсловия.НомерУсловия = 3;
		ОписаниеПредопределенногоУсловия.Параметры = ВыделитьПараметрыПредопределенногоУсловияСравненияПоказателейТаблиц(УсловиеСписания);
		
	Иначе
		СообщитьОНекорректномЗначенииПараметраУсловияСравненияПоказателейТаблиц(УсловиеСписания);
	КонецЕсли;
	
	Возврат ОписаниеПредопределенногоУсловия;
	
КонецФункции

Функция НовыйОписаниеПредопределенногоУсловияСравненияПоказателейТаблиц()
	
	ОписаниеПредопределенногоУсловия = Новый Структура();
	ОписаниеПредопределенногоУсловия.Вставить("Применяется", Ложь);
	ОписаниеПредопределенногоУсловия.Вставить("НомерУсловия", 0);
	ОписаниеПредопределенногоУсловия.Вставить("Параметры", Новый Массив());
	
	Возврат ОписаниеПредопределенногоУсловия;
	
КонецФункции

Функция ВыделитьПараметрыПредопределенногоУсловияСравненияПоказателейТаблиц(УсловиеСписания)
	
	СимволРазделитель = "/";
	
	МассивСлов = СтрРазделить(УсловиеСписания, СимволРазделитель, Ложь);
	
	Если МассивСлов.Количество() < 2 Тогда
		// Первое слово - префикс "ПредопределенноеУсловие№n" и параметром не является.
		СообщитьОНекорректномЗначенииПараметраУсловияСравненияПоказателейТаблиц(УсловиеСписания);
	КонецЕсли;
	
	МассивСлов.Удалить(0);
	
	Возврат МассивСлов;
	
КонецФункции

Процедура СообщитьОНекорректномЗначенииПараметраУсловияСравненияПоказателейТаблиц(УсловиеСписания)
	
	ТекстСообщения = СтрШаблон(НСтр("ru='Параметр УсловиеСписания функции СравнитьПоказателиТаблиц() задан некорректно.
		|Ожидается строковое значение вида ""ПредопределенноеУсловие№1""
		|или ""ПредопределенноеУсловие№2(3)/<параметр>"".
		|
		|Передано значение ""%1""'"),
		УсловиеСписания);
	
	ВызватьИсключение ТекстСообщения;
	
КонецПроцедуры

#КонецОбласти

#Область УчетПоИФО

Процедура ОчиститьИФОРегистра(ИмяРегистра, ПоляИФО) 
	
	Блокировка = Новый БлокировкаДанных;
	Если Метаданные.РегистрыБухгалтерии.Найти(ИмяРегистра) <> Неопределено Тогда
		Блокировка.Добавить("РегистрБухгалтерии." + ИмяРегистра);
		МенеджерРегистра = РегистрыБухгалтерии[ИмяРегистра];
		ЭтоРБ = Истина;
	ИначеЕсли Метаданные.РегистрыНакопления.Найти(ИмяРегистра) <> Неопределено Тогда
		Блокировка.Добавить("РегистрНакопления." + ИмяРегистра);
		МенеджерРегистра = РегистрыНакопления[ИмяРегистра];
		ЭтоРБ = Ложь;
	Иначе
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗЛИЧНЫЕ
				   |	ТекРегистр.Регистратор
				   |ИЗ
				   |	" + ?(ЭтоРБ, "РегистрБухгалтерии.", "РегистрНакопления.") + ИмяРегистра + " КАК ТекРегистр
				   |";
	ВсеУсловие = "";
	МассивПолей = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПоляИФО);
	Для Каждого ТекПолеИФО Из МассивПолей Цикл
		ВсеУсловие = ВсеУсловие
			+ ?(ЗначениеЗаполнено(ВсеУсловие), " ИЛИ ", "")
			+ "
			|	(ТекРегистр." + ТекПолеИФО + " ЕСТЬ NULL 
			|			ИЛИ ТекРегистр."
			+ ТекПолеИФО
			+ " <> ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка))";
	КонецЦикла;

	ТекстЗапроса = ТекстЗапроса + " ГДЕ " + ВсеУсловие;

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;	

	НачатьТранзакцию();
	Попытка       
		
		Блокировка.Заблокировать();
		УстановитьПривилегированныйРежим(Истина);	
		МенеджерРегистра.УстановитьИспользованиеИтогов(Ложь);
		Результат = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = Результат.Выбрать();
	
		ПустойИФО = Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			ТекНаборЗаписей = МенеджерРегистра.СоздатьНаборЗаписей();
			ТекНаборЗаписей.Отбор.Регистратор.Установить(ВыборкаДетальныеЗаписи.Регистратор);
			ТекНаборЗаписей.Прочитать();
			Для Каждого Запись Из ТекНаборЗаписей Цикл
				Для Каждого ТекПолеИФО Из МассивПолей Цикл 
					Запись[ТекПолеИФО] = ПустойИФО;
				КонецЦикла;
			КонецЦикла;
			ТекНаборЗаписей.Записывать = Истина;
			ОбновлениеИнформационнойБазы.ЗаписатьДанные(ТекНаборЗаписей);
		КонецЦикла;	
		
		МенеджерРегистра.УстановитьИспользованиеИтогов(Истина);
	
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура ОпределитьОбрабатываемыеРегистрыКоллекцииРегистров(СоответствиеРегистров,КоллекцияРегистров)
	
	Для Каждого ТекРег Из КоллекцияРегистров Цикл
		Для Каждого ТекИзмерение Из ТекРег.Измерения Цикл
			Если ТекИзмерение.Тип.СодержитТип(Тип("СправочникСсылка.ИсточникиФинансовогоОбеспечения")) Тогда
				ДобавленныеПоля = СоответствиеРегистров.Получить(ТекРег.Имя);
				Если ДобавленныеПоля = Неопределено Тогда
					СоответствиеРегистров.Вставить(ТекРег.Имя,ТекИзмерение.Имя);
				Иначе
					СоответствиеРегистров.Вставить(ТекРег.Имя,ДобавленныеПоля+","+ТекИзмерение.Имя);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого ТекРеквизит Из ТекРег.Реквизиты Цикл
			Если ТекРеквизит.Тип.СодержитТип(Тип("СправочникСсылка.ИсточникиФинансовогоОбеспечения")) Тогда
				ДобавленныеПоля = СоответствиеРегистров.Получить(ТекРег.Имя);
				Если ДобавленныеПоля = Неопределено Тогда
					СоответствиеРегистров.Вставить(ТекРег.Имя,ТекРеквизит.Имя);
				Иначе
					СоответствиеРегистров.Вставить(ТекРег.Имя,ДобавленныеПоля+","+ТекРеквизит.Имя);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла; 
	КонецЦикла;
		
КонецПроцедуры

#КонецОбласти

#Область ОтключениеУчетаВалютИПодразделенийНаСчетах
 
Функция СчетаСУчетомПоПодразделениям()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.УчетПоПодразделениям
	|	И НЕ ЕПСБУ.ЭлементГруппа";
	
	Возврат Запрос.Выполнить();
	
КонецФункции

Процедура ОтключитьПризнакВалютныйВСчетах(ИзменяемыеСчета)
	Для Каждого Счет Из ИзменяемыеСчета Цикл
		Если Не Счет.Валютный Тогда
			Продолжить;
		КонецЕсли;
		СчетОбъект = Счет.ПолучитьОбъект();
		СчетОбъект.Валютный = Ложь;
		СчетОбъект.ОбменДанными.Загрузка = Истина;
		СчетНомер = СчетОбъект.Код;
		Попытка
			СчетОбъект.Записать();
		Исключение
			ТекстСообщенияОбОшибке = НСтр("ru='Не удалось отключить валютный учет для счета:  %1 по причине  %2'");
			ТекстСообщенияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				ТекстСообщенияОбОшибке, СчетНомер, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));

			ЗаписьЖурналаРегистрации(НСтр("ru = 'Отключение валютного учета'", ОбщегоНазначения.КодОсновногоЯзыка()),
				УровеньЖурналаРегистрации.Ошибка, , , ТекстСообщенияОбОшибке + Символы.ПС
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

			ВызватьИсключение ТекстСообщенияОбОшибке;

		КонецПопытки;

	КонецЦикла;
КонецПроцедуры

Функция СчетаСИзмененнымВалютнымУчетом()
	Таблица = ПланыСчетов.ЕПСБУ.ПолучитьДанныеСчетов(, "Валютный");
	СчетаБезВалюты = Таблица.НайтиСтроки(Новый Структура("Валютный", Ложь));
	Таблица = Таблица.Скопировать(СчетаБезВалюты, "Код,ДатаНачалаДействия");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Таблица", Таблица);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Таблица.Код КАК Код,
	|	Таблица.ДатаНачалаДействия КАК ДатаНачалаДействия
	|ПОМЕСТИТЬ СчетаБезВалюты
	|ИЗ
	|	&Таблица КАК Таблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СчетаБезВалюты КАК СчетаБезВалюты
	|		ПО ЕПСБУ.Код = СчетаБезВалюты.Код
	|			И ЕПСБУ.ДатаНачалаДействия = СчетаБезВалюты.ДатаНачалаДействия
	|ГДЕ
	|	ЕПСБУ.Валютный
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЕПСБУ.Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Валютный = ЛОЖЬ";

	Возврат Запрос.Выполнить();
	
КонецФункции

#КонецОбласти 

#Область МеханизмГолосованияКомиссии

Процедура МеханизмГолосованияКомиссии_ДобавитьРеквизитыФормы(Знач Форма, НастройкиМеханизма, ИмяРеквизитаНастроек)
	
	ДобавляемыеРеквизиты = Новый Массив();
	
	ИменаРеквизитов		= НастройкиМеханизма.ИменаРеквизитов;
	ИменаКолонок		= НастройкиМеханизма.ИменаКолонок;
	ИмяТабличнойЧасти	= НастройкиМеханизма.ИмяТабличнойЧасти;
	
	// РЕКВИЗИТЫ ФОРМЫ
	
	НовыйРеквизитФормы = Новый РеквизитФормы(
		ИмяРеквизитаНастроек,
		Новый ОписаниеТипов());
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизитФормы);
	
	
	ОбозначениеРеквизита = "ВыбранныйСотрудник";
	ИмяРеквизита = ОбщегоНазначенияБГУ.ПолучитьУникальноеИмяРеквизитаФормы(Форма, ОбозначениеРеквизита);
	ИменаРеквизитов.Вставить(ОбозначениеРеквизита, ИмяРеквизита);
	НовыйРеквизитФормы = Новый РеквизитФормы(
		ИмяРеквизита,
		Новый ОписаниеТипов("СправочникСсылка.Сотрудники"));
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизитФормы);
	
	
	ОбозначениеРеквизита = "РешениеСотрудникаМодифицированность";
	ИмяРеквизита = ОбщегоНазначенияБГУ.ПолучитьУникальноеИмяРеквизитаФормы(Форма, ОбозначениеРеквизита);
	ИменаРеквизитов.Вставить(ОбозначениеРеквизита, ИмяРеквизита);
	НовыйРеквизитФормы = Новый РеквизитФормы(
		ИмяРеквизита,
		Новый ОписаниеТипов("Булево"));
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизитФормы);
	
	
	ОбозначениеРеквизита = "Сотрудник";
	ИмяРеквизита = ОбщегоНазначенияБГУ.ПолучитьУникальноеИмяРеквизитаФормы(Форма, ОбозначениеРеквизита);
	ИменаРеквизитов.Вставить(ОбозначениеРеквизита, ИмяРеквизита);
	НовыйРеквизитФормы = Новый РеквизитФормы(
		ИмяРеквизита,
		Новый ОписаниеТипов("СправочникСсылка.Сотрудники"));
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизитФормы);
	
	
	ОбозначениеРеквизита = "ФайлСотрудника";
	ИмяРеквизита = ОбщегоНазначенияБГУ.ПолучитьУникальноеИмяРеквизитаФормы(Форма, ОбозначениеРеквизита);
	ИменаРеквизитов.Вставить(ОбозначениеРеквизита, ИмяРеквизита);
	НовыйРеквизитФормы = Новый РеквизитФормы(
		ИмяРеквизита,
		Новый ОписаниеТипов(Метаданные.ОпределяемыеТипы.ПрисоединенныйФайл.Тип.Типы()));
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизитФормы);
	
	
	// КОЛОНКИ ТАБЛИЧНОЙ ЧАСТИ
	
	ОбозначениеКолонки = "РешениеСотрудникаПоРезолюции";
	ИмяКолонки = ОбщегоНазначенияБГУ.ПолучитьУникальноеИмяРеквизитаФормы(Форма, ОбозначениеКолонки);
	ИменаКолонок.Вставить(ОбозначениеКолонки, ИмяКолонки);
	НовыйРеквизитФормы = Новый РеквизитФормы(
		ИмяКолонки,
		Новый ОписаниеТипов("ПеречислениеСсылка.РезультатыГолосованияЧленовКомиссии"),
		"Объект." + ИмяТабличнойЧасти,
		НСтр("ru='Решение по резолюции'"));
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизитФормы);
	
	
	ОбозначениеКолонки = "ИтогГолосования";
	ИмяКолонки = ОбщегоНазначенияБГУ.ПолучитьУникальноеИмяРеквизитаФормы(Форма, ОбозначениеКолонки);
	ИменаКолонок.Вставить(ОбозначениеКолонки, ИмяКолонки);
	НовыйРеквизитФормы = Новый РеквизитФормы(
		ИмяКолонки,
		Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(5,2,ДопустимыйЗнак.Неотрицательный)),
		"Объект." + ИмяТабличнойЧасти,
		НСтр("ru='% за'"));
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизитФормы);
	
	
	ОбозначениеКолонки = "РезолюцияКомиссииОдобрена";
	ИмяКолонки = ОбщегоНазначенияБГУ.ПолучитьУникальноеИмяРеквизитаФормы(Форма, ОбозначениеКолонки);
	ИменаКолонок.Вставить(ОбозначениеКолонки, ИмяКолонки);
	НовыйРеквизитФормы = Новый РеквизитФормы(
		ИмяКолонки,
		Новый ОписаниеТипов("Булево"),
		"Объект." + ИмяТабличнойЧасти,
		НСтр("ru='Одобрено'"));
		
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизитФормы);
	
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
КонецПроцедуры

Процедура МеханизмГолосованияКомиссии_ДобавитьКомандыФормы(Знач Форма, НастройкиМеханизма)
	
	// Команда "Сохранить результаты голосования"
	
	ОбозначениеКоманды = "КомандаСохранитьРезультатыГолосования";
