Функция ИмяПрограммы() Экспорт
	
	Если СтандартныеПодсистемыСервер.ЭтоБазоваяВерсияКонфигурации() Тогда
		Возврат "StateAccountingBase";
	Иначе
		Возврат "StateAccounting";
	КонецЕсли;
	
КонецФункции	

// см. ОбщегоНазначенияПереопределяемый.ПриДобавленииПараметровРаботыКлиента
Процедура ПараметрыРаботыКлиента(Параметры) Экспорт
	
	Если ОбщегоНазначения.ДоступноИспользованиеРазделенныхДанных() Тогда
		УстановитьПараметрыРаботыКлиентаДляВыбораСубконто(Параметры);
		Параметры.Вставить("ПараметрыБГУ_ПервичныеДокументы",
			ОбщегоНазначения.СкопироватьРекурсивно(ПервичныеДокументыБГУПовтИсп.ВсеПервичныеДокументы(), Истина)); 
		Параметры.Вставить("РазрешитьИзменениеРеквизитовБезОчисткиТабличныхЧастейВДокументахНФА",
			Константы.РазрешитьИзменениеРеквизитовБезОчисткиТабличныхЧастейВДокументахНФА.Получить());
	КонецЕсли;
	
КонецПроцедуры

