						ВозможнаяКолонка = КолонкиТабличнойЧасти.Найти(Слово);
						СловоЯвляетсяКолонкой = НЕ (ВозможнаяКолонка = Неопределено);
						Если СловоЯвляетсяКолонкой Тогда
							// Добавляем эту колонку
							Если ИменаИспользуемыхКолонок.Найти(Слово) = Неопределено Тогда
								ИменаИспользуемыхКолонок.Добавить(Слово);
								
								// Поле набора данных
								Поле = НаборДанныхОбъект.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
								Поле.Поле			= Слово;
								Поле.ПутьКДанным	= Слово;
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		// СКД: Поля текущего объекта данных и сами данные (завершаем настройку):
		Поле = НаборДанныхОбъект.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		Поле.Поле			= ИмяПоляНомерСтроки;
		Поле.ПутьКДанным	= ИмяПоляНомерСтроки;
		
		// Проверяемую табл.часть берем или из объекта, или из переданных параметров
		Данные = Неопределено;
		Если НЕ ПереопределяемыеТабличныеЧасти.Свойство(ИмяТаблЧасти, Данные) Тогда
			Данные = ДокументОбъект[ИмяТаблЧасти].Выгрузить(, ИмяПоляНомерСтроки + "," + МассивИлиСтруктуруВСтроку(ИменаИспользуемыхКолонок)); // для ТабличнойЧасти
		КонецЕсли;
		
		ВнешниеНаборыДанных.Вставить(НаборДанныхОбъект_Имя, Данные);
		
		// Параметры, доступные при вычислении всех условий
		Для Каждого Параметр Из ПараметрыДляПроверкиУсловий Цикл
			НовыйПараметр = СКД.Параметры.Добавить();
			НовыйПараметр.Имя			= Параметр.Ключ;
			НовыйПараметр.Значение		= Параметр.Значение;
			НовыйПараметр.Использование	= ИспользованиеПараметраКомпоновкиДанных.Всегда;
		КонецЦикла;
		
		//---
		// СКД: Выполнение компоновки:
		МакетКомпоновкиДанных = КомпоновщикМакета.Выполнить(
			СКД, //1
			Настройки, //2
			, //3
			, //4
			Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений")); //5
		ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных();
		ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновкиДанных, ВнешниеНаборыДанных);
		
		// СКД: Вывод результата компоновки в таблицу значений:
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений();
		ПроцессорВывода.УстановитьОбъект(ТЗВсеНомераСтрок);
		ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
		//---
		
		// Общее количество ошибок заполнения этой табл.части:
		КоличествоОшибокТаблЧасть	= 0;
		СчетчикСообщенийТаблЧасть	= 0;
		СтрокаИтого = ТЗВсеНомераСтрок.Строки[ТЗВсеНомераСтрок.Строки.Количество() - 1]; // строка Итого - самая последняя строка
		Для Каждого ИмяКолонки Из ИменаКолонокРезультата Цикл
			КоличествоОшибокТаблЧасть = КоличествоОшибокТаблЧасть + СтрокаИтого[ПрефиксВычисляемогоПоля + ИмяКолонки];
		КонецЦикла;
		Если КоличествоОшибокТаблЧасть > 0 Тогда
			Результат = Ложь;
		КонецЕсли;
		// Обновляем общее количество ошибок:
		КоличествоОшибок = КоличествоОшибок + КоличествоОшибокТаблЧасть;
		
		// Удаляем итоговую строку:
		ТЗВсеНомераСтрок.Строки.Удалить(СтрокаИтого);
		
		// Кэшируем представления полей проверяемой табл.части:
		ПредставлениеРеквизитовТаблЧасти = Новый Структура();
		Для Каждого ИмяКолонки Из ИменаИспользуемыхКолонок Цикл
			ПредставлениеРеквизитовТаблЧасти.Вставить(ИмяКолонки, ТаблЧастьМетаданные.Реквизиты.Найти(ИмяКолонки).Синоним);
			//ПредставлениеРеквизитовТаблЧасти.Вставить(ИмяКолонки, ИмяКолонки);
		КонецЦикла;
		
		// Обходим все строки, в которых есть хотя бы один незаполненный реквизит,
		// в порядке возрастания номеров строк:
		Для Каждого СтрокаТЗ Из ТЗВсеНомераСтрок.Строки Цикл
			
			Если ПроверкаПрервана Тогда
				Прервать; // Здесь прерываем, т.к. известно общее кол-во ошибок заполнения этой табл.части.
			КонецЕсли;
			
			НомерСтроки = СтрокаТЗ[ИмяПоляНомерСтроки];
			ИндексСтроки = НомерСтроки - 1;
			
			Для Каждого ИмяКолонки Из ИменаКолонокРезультата Цикл

				Если ПроверкаПрервана Тогда
					Прервать; // Здесь прерываем, т.к. известно общее кол-во ошибок заполнения этой табл.части.
				КонецЕсли;
			
				ИмяПоля = ПрефиксВычисляемогоПоля + ИмяКолонки;
				Если СтрокаТЗ[ИмяПоля] >= 1 Тогда
					// Это поле не заполнено, а должно быть.
					
					Если СчетчикСообщений < МаксКолвоСообщений Тогда
						// Допустимое количество выведенных сообщений об ошибках не превышено.
						
						Если ВыводитьСообщения Тогда
							ПредставлениеРеквизита = ПредставлениеРеквизитовТаблЧасти[ИмяКолонки];
							
							// Сведения для вывода сообщений по этому полю:
							ИмяПоляДляВыводаСообщений = ПеренаправлениеВыводаСообщений_Реквизиты.Получить(ИмяТаблЧасти + СимволРазделитель + ИмяКолонки);
							Если ИмяПоляДляВыводаСообщений = Неопределено Тогда
								ИмяПоляДляВыводаСообщений = ИмяКолонки;
							КонецЕсли;
							
							ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
								ПредставлениеРеквизита, НомерСтроки, ПредставлениеТаблЧасти);
							
							ИндексСтрокиТекст = Формат(ИндексСтроки, "ЧГ=0");
							
							ОбщегоНазначения.СообщитьПользователю(
								ТекстСообщения,
								ДокСсылка,
								"Объект." + ИмяТаблЧастиДляВыводаСообщений + "[" + ИндексСтрокиТекст + "]." + ИмяПоляДляВыводаСообщений);
						КонецЕсли;
							
						СчетчикСообщений = СчетчикСообщений + 1;
						СчетчикСообщенийТаблЧасть = СчетчикСообщенийТаблЧасть + 1;
						
					Иначе
						// Превышено допустимое количество выведенных сообщений.
						ПроверкаПрервана = Истина;
						Прервать; // Здесь прерываем, т.к. известно общее кол-во ошибок заполнения этой табл.части.
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла; // ИменаКолонокРезультата
			
		КонецЦикла; // ТЗВсеНомераСтрок.Строки
		
		// Вывели сообщения обо всех незаполненных реквизитах табличной части?
		Если ВыводитьСообщения И ПроверкаПрервана И КоличествоОшибокТаблЧасть > 0 Тогда
			КолвоНевыведенныхСообщений = КоличествоОшибокТаблЧасть - СчетчикСообщенийТаблЧасть;
			Текст = НСтр("ru='Также не заполнены и другие колонки таблицы ""%1"" (еще %2полей)'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст,
				ПредставлениеТаблЧасти,
				"" + КолвоНевыведенныхСообщений + Символы.НПП);
			ОбщегоНазначения.СообщитьПользователю(
				ТекстСообщения,
				ДокСсылка,
				"Объект." + ИмяТаблЧастиДляВыводаСообщений);
		КонецЕсли;
	КонецЦикла;
	
	// Возвращаем результат проверки:
	РезультатПроверки	= Новый Структура("КоличествоОшибок, СчетчикСообщений, ПроверкаПрервана",
		КоличествоОшибок,
		СчетчикСообщений,
		ПроверкаПрервана);
	Возврат Результат;
	
КонецФункции

// Документы по типам.
// 
// Параметры:
//  Документы - Массив из ДокументСсылка
// 
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Тип
//   * Значение - Массив из ДокументСсылка
Функция ДокументыПоТипам(Документы) Экспорт
	ДокументыПоТипам = Новый Соответствие;
	Для Каждого Документ Из Документы Цикл
		Если ЗначениеЗаполнено(Документ) Тогда
			ТипДокумента = ТипЗнч(Документ);
			Если ДокументыПоТипам[ТипДокумента] = Неопределено Тогда
				ДокументыПоТипам[ТипДокумента] = Новый Массив;
			КонецЕсли;
			ДокументыПоТипам[ТипДокумента].Добавить(Документ);
		КонецЕсли;
	КонецЦикла;
	Возврат ДокументыПоТипам;
КонецФункции

// Проверить дата документа основания не больше даты документа.
// 
// Параметры:
//  Объект - ДокументОбъект
//  ДатаДокуменаОснования - Строка - имя проверяемого реквизита
//                        - Структура:
//                         * Имя - Строка -имя проверяемого реквизита
//                         * Синоним - Строка - представление проверяемого реквизита
//  Отказ - Булево - устанавливается в Истина, если проверяемый реквизит больше даты документа
Процедура ПроверитьДатаДокументаОснованияНеБольшеДатыДокумента(Объект, Знач ДатаДокуменаОснования, Отказ) Экспорт
	
	СинонимРеквизита = "";
	Если ТипЗнч(ДатаДокуменаОснования) = Тип("Структура") Тогда
		СинонимРеквизита = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДатаДокуменаОснования, "Синоним", "");
		ДатаДокуменаОснования = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДатаДокуменаОснования, "Имя", "");	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДатаДокуменаОснования) Тогда
		Если Объект[ДатаДокуменаОснования] > Объект.Дата Тогда
			Отказ = Истина;
			Если ПустаяСтрока(СинонимРеквизита) Тогда
				СинонимРеквизита = Объект.Метаданные().Реквизиты[ДатаДокуменаОснования].Синоним;
			КонецЕсли;
			ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(, "Корректность", СинонимРеквизита, , ,
				СтрШаблон(НСтр("ru = '%1 больше даты документа - %2'"),
					Формат(Объект[ДатаДокуменаОснования], "ДФ=dd.MM.yyyy;"),
					Формат(Объект.Дата, "ДФ=dd.MM.yyyy;")));
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Объект.Ссылка, ДатаДокуменаОснования, "Объект");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьЗаполнениеОтсутствияЧленовКомиссии(Знач ДокументОбъект, Отказ, Знач ИмяТабличнойЧастиСоставКомиссии = "СоставКомиссии", Знач ПредставлениеТабличнойЧасти = Неопределено) Экспорт
	
	Если ПредставлениеТабличнойЧасти = Неопределено Тогда
		ПредставлениеТабличнойЧасти = НСтр("ru='Состав комиссии'");
	КонецЕсли;
	
	Для Каждого СтрокаКомиссии Из ДокументОбъект[ИмяТабличнойЧастиСоставКомиссии] Цикл
		Если СтрокаКомиссии.Отсутствует И Не ЗначениеЗаполнено(СтрокаКомиссии.ПричинаОтсутствия) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", , НСтр("ru = 'Причина отсутствия'"), СтрокаКомиссии.НомерСтроки, ПредставлениеТабличнойЧасти);
			
			ПутьКРеквизиту = "Объект." + ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТабличнойЧастиСоставКомиссии, СтрокаКомиссии.НомерСтроки, "ПричинаОтсутствия");
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ДокументОбъект.Ссылка, ПутьКРеквизиту,, Отказ);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ЗначениеПеречисленияПоСинониму(ИмяПеречисления, Синоним) Экспорт 
	ЭлементПеречисления = Неопределено;
	Для каждого ТекЭлемент Из Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления Цикл
		Если ТекЭлемент.Синоним = Синоним Тогда
			ЭлементПеречисления = Перечисления[ИмяПеречисления][ТекЭлемент.Имя];
			Прервать;
		КонецЕсли;
	КонецЦикла; 
	Возврат ЭлементПеречисления; // возвращаем значение перечисления или Неопределено
КонецФункции  

// Возвращает массив сотрудников, у которых в качестве контрагента указано физическое лицо, 
// относящееся к указанному пользователю.
// Если пользователь не указан, то используется текущий пользователь.
// Если организация не указана, то возвращаются сотрудники по всем допустимым по RLS организациям.
// 
// Параметры:
//  Пользователь - СправочникСсылка.Пользователи, Неопределено - Пользователь
//  Организация - СправочникСсылка.Организации, Массив из СправочникСсылка.Организации, Неопределено - Организация
// 
// Возвращаемое значение:
//  Массив из СправочникСсылка.Сотрудники - Сотрудники по пользователю
Функция СотрудникиПоПользователю(Знач Пользователь = Неопределено, Организация = Неопределено) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Контрагенты.Ссылка
	|ПОМЕСТИТЬ Контрагенты
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Пользователи КАК Пользователи
	|		ПО Контрагенты.ЮридическоеФизическоеЛицо = Пользователи.ФизическоеЛицо
	|ГДЕ
	|	Пользователи.Ссылка = &Пользователь
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Сотрудники.Ссылка
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Контрагенты КАК Контрагенты
	|		ПО Сотрудники.Контрагент = Контрагенты.Ссылка
	|ГДЕ
	|	&Условие";
	Если Не ЗначениеЗаполнено(Пользователь) Тогда
		Пользователь = Пользователи.АвторизованныйПользователь();
	КонецЕсли;
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Если ТипЗнч(Организация) = Тип("Массив") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Условие", "Сотрудники.Владелец В (&Организация)");
		Запрос.УстановитьПараметр("Организация", Организация);
	ИначеЕсли ЗначениеЗаполнено(Организация) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Условие", "Сотрудники.Владелец = &Организация");
		Запрос.УстановитьПараметр("Организация", Организация);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Условие", "ИСТИНА");
	КонецЕсли;
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
КонецФункции 

// Пустая настройка недоступных элементов формы в документах НФА.
// 
// Возвращаемое значение:
//  Структура - Пустая настройка недоступных элементов формы в документах НФА:
// * ТолькоПросмотр - Массив из Строка -
// * Видимость - Массив из Строка -  
//
Функция ПустаяНастройкаНедоступныхЭлементовФормыВДокументахНФА() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("ТолькоПросмотр", Новый Массив);
	Результат.Вставить("Видимость", Новый Массив);
	Возврат Результат;
КонецФункции

// Возвращает сериализованный объект в виде двоичных данных.
//
// Параметры:
//  Объект - Любой сериализуемый в XML объект.
//
// Возвращаемое значение:
//  ДвоичныеДанные - сериализованный объект.
//
Функция СериализоватьОбъектВДвоичныеДанные(Объект) Экспорт
	ЗаписьXML = Новый ЗаписьFastInfoset;
	ЗаписьXML.УстановитьДвоичныеДанные();
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	ЗаписатьXML(ЗаписьXML, Объект, НазначениеТипаXML.Явное);
	Возврат ЗаписьXML.Закрыть();
КонецФункции

// Десериализует объект из двоичных данных
// 
// Параметры:
//   ДанныеОбъекта - двоичные данные, представляющие собой объект, сериализованный, 
//   например, при помощи СериализоватьОбъектВДвоичныеДанные.
//
Функция ДесериализоватьОбъектИзДвоичныхДанных(ДанныеОбъекта) Экспорт
	ЧтениеXML = Новый ЧтениеFastInfoset;
	ЧтениеXML.УстановитьДвоичныеДанные(ДанныеОбъекта);
	Объект = ПрочитатьXML(ЧтениеXML);
	ЧтениеXML.Закрыть();
	Возврат Объект;
КонецФункции


#Область ФлажокБезОграничения

Процедура ФлажокБезОграничения_ИнициализироватьФорму(Форма, НастройкиМеханизма) Экспорт
	
	ФлажокБезОграничения_СохранитьНастройкиМеханизмаВФорме(Форма, НастройкиМеханизма);
	
	ФлажокБезОграничения_НастроитьВсеЭлементыСсылок(Форма);
	
КонецПроцедуры

Процедура ФлажокБезОграничения_СохранитьНастройкиМеханизмаВФорме(Форма, НастройкиМеханизма)
	
	// Создаем реквизит формы для хранения настроек механизма
	ИмяРеквизитаФормы = ОбщегоНазначенияБГУКлиентСервер.ФлажокБезОграничения_ИмяРеквизитаФормыДляНастроекМеханизма();
	НовыйРеквизитФормы = Новый РеквизитФормы(ИмяРеквизитаФормы, Новый ОписаниеТипов());
	ДобавляемыеРеквизиты = Новый Массив();
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизитФормы);
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	// Размещаем все настройки в массив
	МассивНастроек = ОбщегоНазначенияБГУКлиентСервер.ФлажокБезОграничения_ПривестиНастройкиМеханизмаКОжидаемомуФормату(НастройкиМеханизма);
	
	// Сохраняем настройки в реквизит формы
	Форма[ИмяРеквизитаФормы] = Новый ФиксированныйМассив(МассивНастроек);
	
КонецПроцедуры

Процедура ФлажокБезОграничения_НастроитьВсеЭлементыСсылок(Форма)
	
	ИмяРеквизитаФормы	= ОбщегоНазначенияБГУКлиентСервер.ФлажокБезОграничения_ИмяРеквизитаФормыДляНастроекМеханизма();
	МассивНастроек		= Форма[ИмяРеквизитаФормы];
	
	Для Каждого ТекущиеНастройки Из МассивНастроек Цикл
		ОбщегоНазначенияБГУКлиентСервер.ФлажокБезОграничения_НастроитьЭлементСсылку(Форма, ТекущиеНастройки);
	КонецЦикла;
	
КонецПроцедуры

