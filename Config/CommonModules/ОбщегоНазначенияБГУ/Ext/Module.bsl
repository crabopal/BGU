// Функция формирует представление заголовка документа
//
// Возвращаемое значение:
//  Строка - представление номера документа
//
Функция СформироватьЗаголовокДокумента(ДокументОбъект, НазваниеДокумента = "") Экспорт

	Возврат НазваниеДокумента + " № " + ДокументОбъект.Номер
	                          + " от " + Формат(ДокументОбъект.Дата, "ДФ='дд ММММ гггг'") + " г.";

КонецФункции // СформироватьЗаголовокДокумента()

// Формирует сообщение из строки с параметрами. Как строка, так и значения
// параметров могут быть заданы на нескольких языках.
//
// Параметры:
//  Сообщение    - Строка - текст сообщения с включенными в него параметерами 
//                 в форме %ИмяПараметра%.
//  Параметры    - Структура - структура, в которой перечислены значения
//                 параметров.
//
Функция ФорматироватьСообщение(Сообщение, Параметры = Неопределено) Экспорт
	
	Если Найти(СтрЗаменить(Сообщение, " ", ""), ТекущийЯзык().КодЯзыка + "=") <> 0 Тогда
		ТекстСообщения = НСтр(Сообщение);
	Иначе
		ТекстСообщения = Сообщение
	КонецЕсли;
	
	Если Параметры = Неопределено Тогда
		
		Результат = ТекстСообщения;
		
	Иначе
		
		ОстатокСообщения   = ТекстСообщения;
		ПозНачалаПараметра = Найти(ОстатокСообщения, "%");
		
		Результат = "";
		Если ПозНачалаПараметра > 0 Тогда
			
			Пока ПозНачалаПараметра > 0 Цикл
				
				Результат = Результат + Лев(ОстатокСообщения, ПозНачалаПараметра - 1);
				
				ОстатокСообщения  = Сред(ОстатокСообщения, ПозНачалаПараметра + 1);
				ПозКонцаПараметра = Найти(ОстатокСообщения, "%");
				
				Если ПозКонцаПараметра = 1 Тогда // двойной «%» — не параметр
					
					Результат = Результат + "%";
					
				ИначеЕсли ПозКонцаПараметра = 0 Тогда // ошибка
					
					Результат = Результат + "%";
					Прервать;
					
				Иначе
					
					ПутьКДанным = Лев(ОстатокСообщения, ПозКонцаПараметра - 1);
					Попытка
						Значение = Параметры;
						Для Каждого Имя Из СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПутьКДанным, ".") Цикл
							Значение = Значение[Имя];
						КонецЦикла;
					Исключение
						Значение = "";
					КонецПопытки;
					Результат = Результат + ФорматироватьСообщение(СокрЛП(Значение), Неопределено);
					
				КонецЕсли;
				
				ОстатокСообщения   = Сред(ОстатокСообщения, ПозКонцаПараметра + 1);
				ПозНачалаПараметра = Найти(ОстатокСообщения, "%");
				
			КонецЦикла;
			
		КонецЕсли;
		Результат = Результат + ОстатокСообщения;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции // ФорматироватьСообщение()

// Возвращает головную организацию для заданной организации
// Если для организации реквизит ГоловнаяОрганизация не заполнен 
// это значит, что сама организация является голвной
//
// Параметры
//  Организация - СправочникСсылка.Организации
//                 <продолжение описания параметра>
//
// Возвращаемое значение:
//   СправочникСсылка.Организации
//
Функция ГоловнаяОрганизация(Организация) Экспорт

	Если Организация.Пустая() ИЛИ Организация.ГоловнаяОрганизация.Пустая() Тогда
		Возврат Организация;
	Иначе
		Возврат Организация.ГоловнаяОрганизация;
	КонецЕсли;

КонецФункции // ГоловнаяОрганизация()

// Формирует список обособленных структурных подразделений организации
//
Функция ПолучитьСписокОбособленныхПодразделенийОрганизации(Организация) Экспорт

	СписокОрганизаций = Новый СписокЗначений;

	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Организации.Ссылка,
	|	Организации.Наименование
	|ИЗ
	|	Справочник.Организации КАК Организации
	|
	|ГДЕ
	|	Организации.ГоловнаяОрганизация = &Организация");
	Запрос.УстановитьПараметр("Организация", Организация);

	Выборка = Запрос.Выполнить().Выбрать(); 
	Пока Выборка.Следующий() Цикл
		СписокОрганизаций.Добавить(Выборка.Ссылка, Выборка.Наименование);
	КонецЦикла;

	Возврат СписокОрганизаций;

КонецФункции

// Функция ищет значение реквизита по заданному представлению. Для справочников поиск ведется по основному представлению.
//
// Возвращаемое значение:
//   Найденное значение реквизита
//
Функция ПолучитьЗначениеРеквизитаИзСтроки(ТипРеквизита, СтрЗначениеРеквизита) Экспорт
	
	ТипБулево = Новый ОписаниеТипов("Булево");
	ТипЧисло =  Новый ОписаниеТипов("Число");
	
	Если ТипРеквизита = "Строка" Тогда
		Возврат СтрЗначениеРеквизита;
	ИначеЕсли  ТипРеквизита = "Число" Тогда
		Возврат ТипЧисло.ПривестиЗначение(СтрЗначениеРеквизита);
	ИначеЕсли  ТипРеквизита = "Дата" Тогда
		Возврат Дата(СтрЗначениеРеквизита);
	ИначеЕсли  ТипРеквизита = "Булево" Тогда
		Возврат ТипБулево.ПривестиЗначение(СтрЗначениеРеквизита);
	КонецЕсли;

	ЧастиИмени = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТипРеквизита, ".");
	ТипОбъекта=ЧастиИмени[0];
	ВидОбъекта=ЧастиИмени[1];
	
	Если ТипОбъекта="ПланСчетов" Тогда
		Возврат ПланыСчетов[ВидОбъекта].НайтиПоКоду(СтрЗначениеРеквизита);
	ИначеЕсли ТипОбъекта="Справочник" Тогда
		Если Метаданные.НайтиПоПолномуИмени(ТипРеквизита).ОсновноеПредставление 
					= Метаданные.СвойстваОбъектов.ОсновноеПредставлениеСправочника.ВВидеКода Тогда
			Возврат Справочники[ВидОбъекта].НайтиПоКоду(СтрЗначениеРеквизита);
		Иначе
			Возврат Справочники[ВидОбъекта].НайтиПоНаименованию(СтрЗначениеРеквизита);
		КонецЕсли;
	ИначеЕсли ТипОбъекта="Перечисление" Тогда
		Возврат Перечисления[ВидОбъекта][СтрЗначениеРеквизита];
	ИначеЕсли ТипОбъекта="ПланВидовХарактеристик" Тогда
		Если Метаданные.НайтиПоПолномуИмени(ТипРеквизита).ОсновноеПредставление 
					= Метаданные.СвойстваОбъектов.ОсновноеПредставлениеВидаХарактеристики.ВВидеКода Тогда
			Возврат ПланыВидовХарактеристик[ВидОбъекта].НайтиПоКоду(СтрЗначениеРеквизита);
		Иначе
			Возврат ПланыВидовХарактеристик[ВидОбъекта].НайтиПоНаименованию(СтрЗначениеРеквизита);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Неопределено;

КонецФункции // ПолучитьЗначениеРеквизита()

// Процедура добавляет отбор переданный в параметрах обработки выбора в условие запроса
// Может использоваться, например, в обработке получения данных выбора, когда в конфигураторе заданы параметры выбора
//
Процедура ДобавитьПараметрыВыбораВЗапрос(Запрос, Отбор = "", ЭлементыОтбора, ПервоеУсловие, НомерПараметра = 1, МетаданныеОбъекта = Неопределено) Экспорт
	Для каждого ЭлементОтбора Из ЭлементыОтбора Цикл
		Если МетаданныеОбъекта <> Неопределено Тогда
			// выполняем проверку реквизита отбора у объекта метаданных
			РеквизитНайден = Ложь;
			ПолноеИмяМетаданного = МетаданныеОбъекта.ПолноеИмя();
			ПроверятьПоРеквизитам = Лев(ПолноеИмяМетаданного, 13) <> "Перечисление.";
			Если ПроверятьПоРеквизитам Тогда
				РеквизитНайден = МетаданныеОбъекта.Реквизиты.Найти(ЭлементОтбора.Ключ) <> Неопределено;
			КонецЕсли;
			
			Если НЕ РеквизитНайден Тогда
				Для каждого СтандартныйРеквизит Из МетаданныеОбъекта.СтандартныеРеквизиты Цикл
				
					Если ЭлементОтбора.Ключ = СтандартныйРеквизит.Имя Тогда
						РеквизитНайден = Истина;
						Прервать;
					КонецЕсли;
				
				КонецЦикла; 
			КонецЕсли;
			
			Если НЕ РеквизитНайден Тогда
				Продолжить;
			КонецЕсли;
			
		КонецЕсли;
		
		ИмяПараметра = "П"+НомерПараметра;
		Если ТипЗнч(ЭлементОтбора.Значение) = Тип("ФиксированныйМассив")
			ИЛИ ТипЗнч(ЭлементОтбора.Значение) = Тип("Массив")
			ИЛИ ТипЗнч(ЭлементОтбора.Значение) = Тип("СписокЗначений") Тогда
			Отбор = Отбор+?(ПервоеУсловие, "", Символы.ПС+"И ")+"ОсновнаяТаблица."+ЭлементОтбора.Ключ+" В (&"+ИмяПараметра+")";
		Иначе
			Отбор = Отбор+?(ПервоеУсловие, "", Символы.ПС+"И ")+"ОсновнаяТаблица."+ЭлементОтбора.Ключ+" = &"+ИмяПараметра;
		КонецЕсли;
	    Запрос.УстановитьПараметр(ИмяПараметра, ЭлементОтбора.Значение);
		ПервоеУсловие = Ложь;
		НомерПараметра = НомерПараметра + 1;
	КонецЦикла;
КонецПроцедуры

// Процедура копирует отбор компоновки данных в условие запроса.
// Может использоваться, например, при получении данных выбора объекта, для которого в настройках типовых операций задан дополнительный отбор
// 
// Параметры:
//  Запрос - Запрос
//  ОтборСписка - Строка - Отбор списка
//  ЭлементыОтбора - КоллекцияЭлементовОтбораКомпоновкиДанных - Элементы отбора
//  ПервоеУсловие - Булево - Первое условие
//  НомерПараметра - Число - Номер параметра
//  ВидУсловия - Строка - Вид условия
Процедура СкопироватьОтборКомпоновкиДанныхВЗапрос(Запрос, ОтборСписка, ЭлементыОтбора, ПервоеУсловие, НомерПараметра=1, ВидУсловия = "И") Экспорт
	
	Для каждого ЭлементОтбора Из ЭлементыОтбора Цикл
		Если ЭлементОтбора.Использование Тогда
			Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
				
				Если ЭлементОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИЛИ Тогда
					ТипГруппы = "ИЛИ";
				Иначе
					ТипГруппы = "И";
				КонецЕслИ;
				
				Если НЕ ПервоеУсловие Тогда
					ОтборСписка = ОтборСписка + Символы.ПС + ВидУсловия + " ";
				КонецЕсли;
				ПервоеУсловие = Ложь;
				Если ЭлементОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаНе Тогда 
					ОтборСписка = ОтборСписка + "НЕ (";
				Иначе
					ОтборСписка = ОтборСписка + "(";
				КонецЕсли;
				СкопироватьОтборКомпоновкиДанныхВЗапрос(Запрос, ОтборСписка, ЭлементОтбора.Элементы, Истина, НомерПараметра, ТипГруппы);
				ОтборСписка = ОтборСписка + ")";
			Иначе
				Если ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено 
					ИЛИ ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
			
				Иначе 
					
					Если НЕ ПервоеУсловие Тогда
						ОтборСписка = ОтборСписка + Символы.ПС + ВидУсловия + " ";
					КонецЕсли;
					ПервоеУсловие = Ложь;
					
					Если ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке Тогда
						ОтборСписка = ОтборСписка + "ОсновнаяТаблица."+ЭлементОтбора.ЛевоеЗначение+" В (&П"+НомерПараметра+")";
					ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке Тогда
						ОтборСписка = ОтборСписка + "НЕ ОсновнаяТаблица."+ЭлементОтбора.ЛевоеЗначение+" В (&П"+НомерПараметра+")";
					ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно Тогда
						ОтборСписка = ОтборСписка + "ОсновнаяТаблица."+ЭлементОтбора.ЛевоеЗначение+" = &П"+НомерПараметра;	
					ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно Тогда
						ОтборСписка = ОтборСписка + "ОсновнаяТаблица."+ЭлементОтбора.ЛевоеЗначение+" <> &П"+НомерПараметра;	
					ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии 
						ИЛИ ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии Тогда
						ОтборСписка = ОтборСписка + "ОсновнаяТаблица."+ЭлементОтбора.ЛевоеЗначение+" В ИЕРАРХИИ (&П"+НомерПараметра+")";	
					ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВИерархии 
						ИЛИ ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии Тогда
						ОтборСписка = ОтборСписка + "НЕ ОсновнаяТаблица."+ЭлементОтбора.ЛевоеЗначение+" В ИЕРАРХИИ (&П"+НомерПараметра+")";	
					ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Больше Тогда
						ОтборСписка = ОтборСписка + "ОсновнаяТаблица."+ЭлементОтбора.ЛевоеЗначение+" > &П"+НомерПараметра;	
					ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно Тогда
						ОтборСписка = ОтборСписка + "ОсновнаяТаблица."+ЭлементОтбора.ЛевоеЗначение+" >= &П"+НомерПараметра;	
					ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше Тогда
						ОтборСписка = ОтборСписка + "ОсновнаяТаблица."+ЭлементОтбора.ЛевоеЗначение+" < &П"+НомерПараметра;	
					ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно Тогда
						ОтборСписка = ОтборСписка + "ОсновнаяТаблица."+ЭлементОтбора.ЛевоеЗначение+" <= &П"+НомерПараметра;	
					ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Содержит
						Или ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НачинаетсяС Тогда
						ОтборСписка = ОтборСписка + "ОсновнаяТаблица."+ЭлементОтбора.ЛевоеЗначение+" ПОДОБНО &П"+НомерПараметра+" СПЕЦСИМВОЛ ""/""";	
					ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеСодержит
						Или ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеНачинаетсяС Тогда
						ОтборСписка = ОтборСписка + "НЕ ОсновнаяТаблица."+ЭлементОтбора.ЛевоеЗначение+" ПОДОБНО &П"+НомерПараметра+" СПЕЦСИМВОЛ ""/""";
					КонецЕсли;
					Если ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Содержит
						Или ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеСодержит Тогда
						ЗначениеПараметра = "%"+ЭлементОтбора.ПравоеЗначение+"%";
					ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НачинаетсяС
						Или ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеНачинаетсяС Тогда
						ЗначениеПараметра = ""+ЭлементОтбора.ПравоеЗначение+"%";
					ИначеЕсли ТипЗнч(ЭлементОтбора.ПравоеЗначение) = Тип("СтандартнаяДатаНачала") Тогда
						ЗначениеПараметра = ЭлементОтбора.ПравоеЗначение.Дата;
					Иначе
						ЗначениеПараметра = ЭлементОтбора.ПравоеЗначение;
					КонецЕсли;
					Запрос.УстановитьПараметр("П"+НомерПараметра, ЗначениеПараметра);
					НомерПараметра = НомерПараметра+1;
					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	
	КонецЦикла; 
	
КонецПроцедуры

// Устанавливает управляемую блокировку таблицы
//
// Параметры:
//  СтруктураПараметров 		- <Структура>. Структура параметров блокировки. Обязательный параметр.
//								Обязательно должна содержать свойства:
//								"ИмяТаблицы" - <Строка> - имя таблицы, на которую накладывается блокировка.
//									Например: "АвансовыйОтчет"
//								Необязательные свойства:
//								"ТипТаблицы" - <Строка> - тип таблицы, на которую накладывается блокировка.
//									Пространство блокировки состоит из типа таблицы и имени таблицы.
//									Например: "Документ"
//									Значение по умолчанию: "РегистрНакопления"
//								"РежимБлокировки" - <РежимБлокировкиДанных> - режим накладываемой блокировки.
//									Значение по умолчанию: РежимБлокировкиДанных.Исключительный
//								"ИсточникДанных" - источник данных для блокировки.
//									Может передаваться значение любого типа, поддерживаемого свойством ИсточникДанных элемента блокировки,
//									а также типа "Менеджер временных таблиц".
//									Если в структуре нет этого свойства - блокировки через ИспользоватьИзИсточникаДанных() не накладываются.
//								"ИмяВременнойТаблицы" - <Строка> - имя временной таблицы менеджера временных таблиц, которая служит источником данных для блокировки.
//									Обязательно должно указываться, если в качестве источника данных процедуре передан менеджер временных таблиц.
//  КоллекцияЗначенийБлокировки	- <Структура или Соответствие> - описывает значения блокировки, накладываемые с помощью УстановитьЗначение().
//									Ключ - поле блокировки - <Строка или (только для соответствия) ПланыВидовХарактеристикСсылка>, 
//										ПланыВидовХарактеристикСсылка используется для блокировки регистра бухгалтерии по виду субконто.
//									Значение - блокируемое значение - <Произвольный тип>.
//									Если передано Неопределено или если коллекция не содержит ни одного элемента -
//									блокировки методом УстановитьЗначение() не накладываются.
//  КоллекцияОписанияИсточника	- <Структура или Соответствие> - описывает значения блокировки, накладываемые с помощью ИспользоватьИзИсточникаДанных().
//									Ключ - поле блокировки - <Строка или (только для соответствия) ПланыВидовХарактеристикСсылка>, 
//										ПланыВидовХарактеристикСсылка используется для блокировки регистра бухгалтерии по виду субконто.
//									Значение - поле таблицы источника данных - <Строка>.
//									Если передано Неопределено или если коллекция не содержит ни одного элемента -
//									блокировки методом ИспользоватьИзИсточникаДанных() не накладываются.
//  Отказ 						- <Булево> - при ошибке в процессе установки блокировки в этот параметр процедура возвращает значение Истина
//  Заголовок 					- <Строка> - заголовок сообщения об ошибке при установке блокировки
//
Процедура УстановитьУправляемуюБлокировку(
	СтруктураПараметров,
	КоллекцияЗначенийБлокировки = Неопределено,
	КоллекцияОписанияИсточника = Неопределено,
	Отказ = Ложь,
	Заголовок = ""
) Экспорт
	
	Если НЕ ТипЗнч(СтруктураПараметров) = Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ИспользоватьЗначенияБлокировки = КоллекцияЗначенийБлокировки <> Неопределено 
		И (ТипЗнч(КоллекцияЗначенийБлокировки) = Тип("Структура") 
			ИЛИ ТипЗнч(КоллекцияЗначенийБлокировки) = Тип("Соответствие"))
		И КоллекцияЗначенийБлокировки.Количество() > 0;
		
	ИспользоватьИсточникДанных     = КоллекцияОписанияИсточника <> Неопределено 
		И (ТипЗнч(КоллекцияОписанияИсточника) = Тип("Структура") 
			ИЛИ ТипЗнч(КоллекцияОписанияИсточника) = Тип("Соответствие"))
		И КоллекцияОписанияИсточника.Количество() > 0
		И СтруктураПараметров.Свойство("ИсточникДанных");
	
	Если НЕ ИспользоватьЗначенияБлокировки И НЕ ИспользоватьИсточникДанных Тогда
		Возврат;
	КонецЕсли;
	
	Блокировка = Новый БлокировкаДанных;
	
	ТипТаблицы = ?(СтруктураПараметров.Свойство("ТипТаблицы"), СтруктураПараметров.ТипТаблицы, "РегистрНакопления");
	ИмяТаблицы = СтруктураПараметров.ИмяТаблицы;
	ПространствоБлокировки = ТипТаблицы  + "." + ИмяТаблицы;
	ЭлементБлокировки = Блокировка.Добавить(ПространствоБлокировки);
	
	РежимБлокировки = ?(СтруктураПараметров.Свойство("РежимБлокировки"), СтруктураПараметров.РежимБлокировки, РежимБлокировкиДанных.Исключительный);
	ЭлементБлокировки.Режим = РежимБлокировки;
	
	Если ИспользоватьЗначенияБлокировки Тогда
		
		Для каждого ЭлементКоллекции Из КоллекцияЗначенийБлокировки Цикл
			
			ЭлементБлокировки.УстановитьЗначение(ЭлементКоллекции.Ключ, ЭлементКоллекции.Значение);
			
		КонецЦикла;
	
	КонецЕсли;
	
	Если ИспользоватьИсточникДанных Тогда
		
		ИсточникДанных = СтруктураПараметров.ИсточникДанных; 
		
		Если ТипЗнч(ИсточникДанных) = Тип("МенеджерВременныхТаблиц") Тогда
		
			Запрос = Новый Запрос;
			Запрос.МенеджерВременныхТаблиц = ИсточникДанных;
			ТекстЗапроса = "";
			Для каждого ЭлементКоллекции Из КоллекцияОписанияИсточника Цикл
				ТекстЗапроса = ТекстЗапроса + ",
				|	Таб." + ЭлементКоллекции.Значение;
			КонецЦикла;
			ТекстЗапроса = Сред(ТекстЗапроса, 2);
			ТекстЗапроса = 			
			"ВЫБРАТЬ РАЗЛИЧНЫЕ"
			+ ТекстЗапроса + "
			|ИЗ
			|	" + СтруктураПараметров.ИмяВременнойТаблицы + " КАК Таб";
			Запрос.Текст = ТекстЗапроса;
			Результат    = Запрос.Выполнить();
			
			ЭлементБлокировки.ИсточникДанных = Результат;
			
		Иначе
			
			ЭлементБлокировки.ИсточникДанных = ИсточникДанных;
			
		КонецЕсли;
	
		Для каждого ЭлементКоллекции Из КоллекцияОписанияИсточника Цикл
			
			ЭлементБлокировки.ИспользоватьИзИсточникаДанных(ЭлементКоллекции.Ключ, ЭлементКоллекции.Значение);
			
		КонецЦикла;
	
	КонецЕсли;
	
	Попытка
	
		Блокировка.Заблокировать();
	
	Исключение
		
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки(),,,,Отказ);
	    ВызватьИсключение "Операция не выполнена";
		
	КонецПопытки;

КонецПроцедуры

// Функция проверяет наличие подчиненных элементов справочника (иерархия элементов).
//
// Параметры:
//  ЗначениеДляПроверки - СправочникСсылка, ссылка на элемент справочника, для которого
//                        необходимо определить наличие подчиненных.
//  Предупредить - булево, выдать или нет предупреждение.
//  ПервыйЭлементГруппы - переменная, куда будет помещена ссылка на первый элемент группы
//
Функция ЭлементЯвляетсяГруппой(ЗначениеДляПроверки, Предупредить = Истина, ПервыйЭлементГруппы = Неопределено) Экспорт
	СтрокаИсточникаДляЗапроса = ВернутьСтрокуТипаПоТипу(ТипЗнч(ЗначениеДляПроверки),"Запрос");
	
	Запрос = Новый Запрос;
	Запрос.Текст  = "Выбрать Первые 1
			|	ТекИсточник.Ссылка КАК Ссылка,
			|   ТекИсточник.Код КАК Код
			|ИЗ " + СтрокаИсточникаДляЗапроса + " КАК ТекИсточник
			|ГДЕ
			|	Ссылка.Родитель = &ТекСсылка
			|УПОРЯДОЧИТЬ ПО
			|	ТекИсточник.Код";
			
	Запрос.УстановитьПараметр("ТекСсылка",ЗначениеДляПроверки);
	Выборка = Запрос.Выполнить().Выбрать();
	ЭтоГруппа = ?(Выборка.Количество()>0,Истина,Ложь);
	
	Если ЭтоГруппа Тогда
		Если Выборка.Следующий() Тогда
			ПервыйЭлементГруппы = Выборка.Ссылка;	
		КонецЕсли;
	Конецесли;

	Возврат(ЭтоГруппа);
	
КонецФункции

// Возвращает значение настройки рабочей даты для пользователя.
//
// Параметры:
//	Пользователь - Справочник.Пользователи - пользователь, для которого запрашивается рабочая дата.
//		Если не задано, то устанавливается для текущего пользователя.
//  ТолькоЗначение - Булево - если определить рабочую дату не удалось, то возвращается
//								Истина:	пустая дата
//								Ложь:	текущая дата сеанса
//
//
// Возвращаемое значение:
//	Дата - Значение настройки рабочей даты пользователя или пустая дата, если настройка не задана.
//
Функция РабочаяДатаПользователя(Пользователь = Неопределено, ТолькоЗначение = Ложь) Экспорт
	
	Если Не ЗначениеЗаполнено(Пользователь) Тогда
		Пользователь = ПользователиКлиентСервер.АвторизованныйПользователь();
	КонецЕсли;
	
	ЗначенияНастроек = Новый Структура("РабочаяДата");
	ЗаполнениеРеквизитовОбъектов.ПолучитьЗначенияНастроекПользователя(Пользователь, ЗначенияНастроек);
	Результат = ЗначенияНастроек.РабочаяДата;
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Результат = ?(ТолькоЗначение, '0001-01-01', ТекущаяДатаСеанса()); 		
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

// Заполняет колонку таблицы значений последовательными номерами
// Параметры:
//	Таблица - таблица значений, строки которой нужно пронумеровать
//	ИмяКолонкиНомераСтроки - колонка таблицы значений, в которой будут указаны номера строк
Процедура ПронумероватьТаблицуЗначений(Таблица, ИмяКолонкиНомераСтроки) Экспорт

	Таблица.Колонки.Добавить(ИмяКолонкиНомераСтроки, ПолучитьОписаниеТиповЧисла(15, 0));

	КоличествоСтрок = Таблица.Количество() - 1;
	Для НомерСтроки = 0 По КоличествоСтрок Цикл
		Таблица[НомерСтроки][ИмяКолонкиНомераСтроки] = НомерСтроки;
	КонецЦикла;

КонецПроцедуры

// Позволяет определить есть ли среди реквизитов шапки документа
// реквизит с переданным именем.
//
// Параметры: 
//  ИмяРеквизита - строковое имя искомого реквизита, 
//  МетаданныеДокумента - объект описания метаданных документа, среди реквизитов которого производится поиск.
//
// Возвращаемое значение:
//  Истина - нашли реквизит с таким именем, Ложь - не нашли.
//
Функция ЕстьРеквизитДокумента(ИмяРеквизита, МетаданныеДокумента) Экспорт

	Возврат НЕ (МетаданныеДокумента.Реквизиты.Найти(ИмяРеквизита) = Неопределено);

КонецФункции // ЕстьРеквизитДокумента()

// Позволяет определить есть ли табличная часть документа с переданным именем.
//
// Параметры: 
//  ИмяТабЧасти - строковое имя искомой табличной части,
//  МетаданныеДокумента - объект описания метаданных документа, среди реквизитов которого производится поиск.
//
// Возвращаемое значение:
//  Истина - нашли реквизит с таким именем, Ложь - не нашли.
//
Функция ЕстьТабЧастьДокумента(ИмяТабЧасти, МетаданныеДокумента) Экспорт

	Если МетаданныеДокумента.ТабличныеЧасти.Найти(ИмяТабЧасти) = Неопределено Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли; 

КонецФункции // ЕстьТабЧастьДокумента()

// Позволяет определить есть ли среди реквизитов табличной части документа
// реквизит с переданным именем.
//
// Параметры: 
//  ИмяРеквизита - строковое имя искомого реквизита, 
//  МетаданныеДокумента - объект описания метаданных документа, среди реквизитов которого производится поиск.
//  ИмяТабЧасти  - строковое имя табличной части документа, среди реквизитов которого производится поиск
//
// Возвращаемое значение:
//  Истина - нашли реквизит с таким именем, Ложь - не нашли.
//
Функция ЕстьРеквизитТабЧастиДокумента(ИмяРеквизита, МетаданныеДокумента, ИмяТабЧасти = Неопределено) Экспорт
	
	ТабЧасти = Новый Массив;
	
	Если ИмяТабЧасти = Неопределено Тогда
		Для Каждого  ТабЧасть Из МетаданныеДокумента.ТабличныеЧасти Цикл
		ТабЧасти.Добавить(ТабЧасть);
		КонецЦикла;
	Иначе
		ТабЧасти.Добавить(МетаданныеДокумента.ТабличныеЧасти.Найти(ИмяТабЧасти));
	КонецЕсли;	
	
	Для Каждого ТабЧасть Из ТабЧасти Цикл
		Если ТабЧасть = Неопределено Тогда // Нет такой таб. части в документе
			Возврат Ложь;
		ИначеЕсли НЕ (ТабЧасть.Реквизиты.Найти(ИмяРеквизита) = Неопределено) Тогда
			Возврат Истина;
		КонецЕсли;
