Процедура ЗаполнитьАдресаПередОтправкойПоПочте(ПараметрыОтправкиПолучатель, ОбъектИзвлеченияКонтактов) Экспорт
	
	ПолучателиОтправки = Новый Массив;
	ПараметрыОтправкиПолучатель = Новый Массив;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ОбъектИзвлеченияКонтактов, "Контрагент") Тогда
		ПолучателиОтправки.Добавить(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбъектИзвлеченияКонтактов, "Контрагент"));
	КонецЕсли;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ОбъектИзвлеченияКонтактов, "Плательщик") Тогда
		ПолучателиОтправки.Добавить(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбъектИзвлеченияКонтактов, "Плательщик"));
	КонецЕсли;
	
	ПолучателиОтправки = ОбщегоНазначенияКлиентСервер.СвернутьМассив(ПолучателиОтправки);
	
	Если ПолучателиОтправки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	
	
	//Далее используется служебный API БСП (взаимодействия)
	Контакты = Взаимодействия.АдресаЭлектроннойПочтыКонтактов(ПолучателиОтправки);
	
	Для Каждого Контакт Из Контакты Цикл				
		
		РеквизитыПолучателя = Новый Структура;
		
		РеквизитыПолучателя.Вставить("Адрес", Контакт.Адрес);
		РеквизитыПолучателя.Вставить("Представление", Контакт.Представление); 
		РеквизитыПолучателя.Вставить("ИсточникКонтактнойИнформации", Контакт.Контакт);
		
		ПараметрыОтправкиПолучатель.Добавить(РеквизитыПолучателя);
		
	КонецЦикла;	
	
КонецПроцедуры

