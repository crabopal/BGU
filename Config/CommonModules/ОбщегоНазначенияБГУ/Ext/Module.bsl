Функция УказанныеРеквизитыЗаполнены(ДокументОбъект, Знач ПараметрыПроверки, РезультатПроверки) Экспорт
	
	Перем	ПроверяемыеРеквизиты,
			ПроверяемыеСубконто,
			ПроверяемыеПризнакиУчета,
			ПеренаправлениеВыводаСообщений_ТабличныеЧасти,
			ПеренаправлениеВыводаСообщений_Реквизиты,
			МаксКолвоСообщений,
			ВыводитьСообщения,
			ИсключаемыеРеквизиты, // можно указывать и реквизиты шапки, и табл.частей
			ПараметрыДляПроверкиУсловий,
			ПроверяемыеРеквизитыУсловия,
			ПроверяемыеСубконтоУсловия,
			СтруктураУсловий,
			ТекстУсловия,
			ПереопределяемыеТабличныеЧасти,
			
			// Используются в случае указания субконто:
			СпособУказанияСубконто_ПоНомеру,
			СпособУказанияСубконто_ПоВиду,

			// Признак досрочного прекращения проверки заполнения
			// из-за достижения максимального кол-ва выводимых сообщений об ошибках:
			ПроверкаПрервана;
	
	// Входная проверка (начало):
	ПараметрыПроверки.Свойство("ПроверяемыеРеквизиты", ПроверяемыеРеквизиты);
	Если НЕ ТипЗнч(ПроверяемыеРеквизиты) = Тип("Массив") Тогда
		ПроверяемыеРеквизиты = Новый Массив();
	КонецЕсли;
	
	ПараметрыПроверки.Свойство("ПроверяемыеСубконто", ПроверяемыеСубконто);
	Если ТипЗнч(ПроверяемыеСубконто) = Тип("Структура") Тогда
		// Ключ		- имя табл.части
		// Значение	- соответствие или массив соответствий
		// Приведем все значения к массивам соответствий:
		Для Каждого Элем Из ПроверяемыеСубконто Цикл
			ИмяТаблЧасти = Элем.Ключ;
			ВремЗнач = Элем.Значение;
			Если ТипЗнч(ВремЗнач) = Тип("Соответствие") Тогда
				НовыйМассив = Новый Массив();
				НовыйМассив.Добавить(ВремЗнач);
				ПроверяемыеСубконто.Вставить(ИмяТаблЧасти, НовыйМассив);
			ИначеЕсли НЕ ТипЗнч(ВремЗнач) = Тип("Массив") Тогда
				// Некорректное значение.
				ПроверяемыеСубконто.Удалить(ИмяТаблЧасти);
			КонецЕсли;
		КонецЦикла;
	Иначе
		ПроверяемыеСубконто = Новый Структура();
	КонецЕсли;
	
	ПараметрыПроверки.Свойство("ПроверяемыеПризнакиУчета", ПроверяемыеПризнакиУчета);
	Если ТипЗнч(ПроверяемыеПризнакиУчета) = Тип("Структура") Тогда
		// Ключ		- имя табл.части
		// Значение	- структура или массив структур
		// Приведем все значения к массивам структур:
		Для Каждого Элем Из ПроверяемыеПризнакиУчета Цикл
			ИмяТаблЧасти = Элем.Ключ;
			ВремЗнач = Элем.Значение;
			Если ТипЗнч(ВремЗнач) = Тип("Структура") Тогда
				НовыйМассив = Новый Массив();
				НовыйМассив.Добавить(ВремЗнач);
				ПроверяемыеПризнакиУчета.Вставить(ИмяТаблЧасти, НовыйМассив);
			ИначеЕсли НЕ ТипЗнч(ВремЗнач) = Тип("Массив") Тогда
				// Некорректное значение.
				ПроверяемыеСубконто.Удалить(ИмяТаблЧасти);
			КонецЕсли;
		КонецЦикла;
	Иначе
		ПроверяемыеПризнакиУчета = Новый Структура();
	КонецЕсли;
	
	ПараметрыПроверки.Свойство("ПеренаправлениеВыводаСообщений_ТабличныеЧасти", ПеренаправлениеВыводаСообщений_ТабличныеЧасти);
	Если НЕ ТипЗнч(ПеренаправлениеВыводаСообщений_ТабличныеЧасти) = Тип("Структура") Тогда
		ПеренаправлениеВыводаСообщений_ТабличныеЧасти = Новый Структура();
	КонецЕсли;
	
	ПараметрыПроверки.Свойство("ПеренаправлениеВыводаСообщений_Реквизиты", ПеренаправлениеВыводаСообщений_Реквизиты);
	Если НЕ ТипЗнч(ПеренаправлениеВыводаСообщений_Реквизиты) = Тип("Соответствие") Тогда
		ПеренаправлениеВыводаСообщений_Реквизиты = Новый Соответствие();
	КонецЕсли;
	
	ПараметрыПроверки.Свойство("ПараметрыДляПроверкиУсловий", ПараметрыДляПроверкиУсловий);
	Если НЕ ТипЗнч(ПараметрыДляПроверкиУсловий) = Тип("Структура") Тогда
		ПараметрыДляПроверкиУсловий = Новый Структура();
	КонецЕсли;
	
	ПараметрыПроверки.Свойство("ПроверяемыеРеквизитыУсловия", ПроверяемыеРеквизитыУсловия);
	Если НЕ ТипЗнч(ПроверяемыеРеквизитыУсловия) = Тип("Структура") Тогда
		ПроверяемыеРеквизитыУсловия = Новый Структура();
	КонецЕсли;
	
	ПараметрыПроверки.Свойство("ПроверяемыеСубконтоУсловия", ПроверяемыеСубконтоУсловия);
	Если НЕ ТипЗнч(ПроверяемыеСубконтоУсловия) = Тип("Структура") Тогда
		ПроверяемыеСубконтоУсловия = Новый Структура();
	КонецЕсли;
	
	ПараметрыПроверки.Свойство("МаксКолвоСообщений", МаксКолвоСообщений);
	Если НЕ ТипЗнч(МаксКолвоСообщений) = Тип("Число") ИЛИ МаксКолвоСообщений < 1 Тогда
		МаксКолвоСообщений = 200;
	КонецЕсли;
	
	ПараметрыПроверки.Свойство("ВыводитьСообщения", ВыводитьСообщения);
	Если НЕ ТипЗнч(ВыводитьСообщения) = Тип("Булево") Тогда
		ВыводитьСообщения = Истина;
	КонецЕсли;
	
	ПараметрыПроверки.Свойство("ИсключаемыеРеквизиты", ИсключаемыеРеквизиты);
	Если НЕ ТипЗнч(ИсключаемыеРеквизиты) = Тип("Массив") Тогда
		ИсключаемыеРеквизиты = Новый Массив();
	КонецЕсли;
	
	ПараметрыПроверки.Свойство("ПереопределяемыеТабличныеЧасти", ПереопределяемыеТабличныеЧасти);
	Если НЕ ТипЗнч(ПереопределяемыеТабличныеЧасти) = Тип("Структура") Тогда
		ПереопределяемыеТабличныеЧасти = Новый Структура();
	КонецЕсли;
	
	// Возвращаемые сведения:
	Результат			= Истина;
	КоличествоОшибок	= 0;
	СчетчикСообщений	= 0;
	ПроверкаПрервана	= Ложь;
	РезультатПроверки	= Новый Структура("КоличествоОшибок, СчетчикСообщений, ПроверкаПрервана", 0, 0, Ложь);
	
	// Инициализация:
	ДокСсылка = ДокументОбъект.Ссылка; // используется только при выводе сообщений
	ИмяИсточникаДанных								= "ИсточникДанных";
	НаборДанныхОбъект_Имя							= "ТаблЧасть";
	
	ИмяПоляНомерСтроки								= "НомерСтроки";
	ПрефиксВычисляемогоПоля							= "КолвоПустых_";
	НаборДанныхЗапросПризнакиСчетов_ПрефиксИмениПоля= "ПризнакиСчетов_";
	ПрефиксПараметраВидСубконто						= "ПараметрВидСубконто_";
	
	ОбозначениеПоляСвязиСчет						= "Счет";
	СпособУказанияСубконто_Ключ						= 1; // произвольное значение
	
	СпособУказанияСубконто_ПоНомеру					= 1;
	СпособУказанияСубконто_ПоВиду					= 2;
	МаксимальныйНомерСубконто						= Строка(Метаданные.ПланыСчетов.ЕПСБУ.МаксКоличествоСубконто);
	
	//
	// 1.	Разделяем общий список имен реквизитов
	//		на реквизиты шапки и реквизиты табличных частей.
	
	// Символ-разделитель имени табличной части и имени ее реквизита:
	СимволРазделитель = ".";
	
	// Имена проверяемых реквизитов шапки:
	РеквизитыШапки = Новый Массив();
	
	// Имена проверяемых табличных частей и имена проверяемых реквизитов:
	ТабличныеЧасти					= Новый Массив();
	НезависимыеРеквизиты			= Новый Структура(); //[ИмяТаблЧасти - массив имен рекв.]
	
	// Получим имена независимых реквизитов:
	Реквизиты = Неопределено;
	Для Каждого ИмяРеквизита Из ПроверяемыеРеквизиты Цикл
		Если НЕ ТипЗнч(ИмяРеквизита) = Тип("Строка") ИЛИ НЕ ЗначениеЗаполнено(ИмяРеквизита) Тогда
			Продолжить;
		КонецЕсли;
		
		инд = Найти(ИмяРеквизита, СимволРазделитель);
		Если инд = 0 Тогда
			// Обнаружен реквизит шапки.
			Если НЕ ИмяРеквизитаСинтаксическиКорректно(ИмяРеквизита)
				ИЛИ СледуетИсключитьРеквизит(ИмяРеквизита, , ИсключаемыеРеквизиты) Тогда
				Продолжить;
			КонецЕсли;
			
			Если РеквизитыШапки.Найти(ИмяРеквизита) = Неопределено Тогда 
				РеквизитыШапки.Добавить(ИмяРеквизита);
			КонецЕсли;
			
		Иначе
			// Обнаружен реквизит табл.части.
			
			ИмяТаблЧасти = Лев(ИмяРеквизита, инд-1);
			ИмяРеквизитаТаблЧасти = Сред(ИмяРеквизита, инд+1);
			
			Если НЕ ИмяРеквизитаСинтаксическиКорректно(ИмяТаблЧасти)
				ИЛИ НЕ ИмяРеквизитаСинтаксическиКорректно(ИмяРеквизитаТаблЧасти)
				ИЛИ СледуетИсключитьРеквизит(ИмяРеквизитаТаблЧасти, ИмяТаблЧасти, ИсключаемыеРеквизиты) Тогда
				Продолжить;
			КонецЕсли;
			
			Если ТабличныеЧасти.Найти(ИмяТаблЧасти) = Неопределено Тогда
				// Обнаружен первый реквизит этой табл.части.
				ТабличныеЧасти.Добавить(ИмяТаблЧасти);
			КонецЕсли;
			
			НезависимыеРеквизиты.Свойство(ИмяТаблЧасти, Реквизиты);
			Если Реквизиты = Неопределено Тогда
				// Обнаружен первый реквизит этой табл.части.
				Реквизиты = Новый Массив();
			КонецЕсли;
			Если Реквизиты.Найти(ИмяРеквизитаТаблЧасти) = Неопределено Тогда
				Реквизиты.Добавить(ИмяРеквизитаТаблЧасти);
			КонецЕсли;
			
			НезависимыеРеквизиты.Вставить(ИмяТаблЧасти, Реквизиты);
		КонецЕсли;
		
	КонецЦикла;
	
	// Продолжение входной проверки реквизитов субконто.
	// Удаляем некорректные элементы, оставляем только корректные, определяем способ указания субконто.
	Для Каждого ЭлементСубконто Из ПроверяемыеСубконто Цикл
		ИмяТаблЧасти		= ЭлементСубконто.Ключ;
		МассивРеквизитов	= ЭлементСубконто.Значение;
		
		НекорректныеМассивыРеквизитов = Новый Массив();
		ПоляСвязиСчет = Новый Массив();
		Для инд = 0 По МассивРеквизитов.Количество() - 1 Цикл
			Реквизиты = МассивРеквизитов[инд];
			
			СпособУказанияСубконто = Неопределено; // начальное значение
			ОбнаруженоПолеСвязи = Ложь;
			
			Если ТипЗнч(Реквизиты) = Тип("Соответствие") Тогда
				НекорректныеРеквизиты = Новый Массив();
				Для Каждого ЭлементРеквизит Из Реквизиты Цикл
					ОбозначениеРеквизита	= ЭлементРеквизит.Ключ;
					ИмяРеквизитаТаблЧасти	= ЭлементРеквизит.Значение;
					
					Если ОбозначениеРеквизита = ОбозначениеПоляСвязиСчет Тогда
						ИмяПоляСвязиСчет = ИмяРеквизитаТаблЧасти;
						
						Если ИмяРеквизитаСинтаксическиКорректно(ИмяПоляСвязиСчет)
							И НЕ СледуетИсключитьРеквизит(ИмяПоляСвязиСчет, ИмяТаблЧасти, ИсключаемыеРеквизиты) Тогда
							// Для текущего поля связи "счет" уже были зависимые поля субконто?
							Если ПоляСвязиСчет.Найти(ИмяПоляСвязиСчет) = Неопределено Тогда
								// Пока не было такого поля связи.
								ПоляСвязиСчет.Добавить(ИмяПоляСвязиСчет);
								ОбнаруженоПолеСвязи = Истина;
							КонецЕсли;
							
							Продолжить;
						КонецЕсли;
						
					КонецЕсли;
					
					// Определим способ указания субконто:
					Если ТипЗнч(ОбозначениеРеквизита) = Тип("Строка") Тогда
						
						ДлинаСловаСубконто = 8;
						ПоследнийСимвол = Прав(ОбозначениеРеквизита, 1);
						
						ОбозначениеРеквизитаКорректное = (СтрДлина(ОбозначениеРеквизита) = ДлинаСловаСубконто + 1)
							И ВРег(Лев(ОбозначениеРеквизита, ДлинаСловаСубконто)) = "СУБКОНТО"
							И (ПоследнийСимвол >= "1" И ПоследнийСимвол <= МаксимальныйНомерСубконто)
							И (НЕ ЗначениеЗаполнено(СпособУказанияСубконто) ИЛИ СпособУказанияСубконто = СпособУказанияСубконто_ПоНомеру);
							
						Если НЕ ОбозначениеРеквизитаКорректное
							ИЛИ НЕ ИмяРеквизитаСинтаксическиКорректно(ИмяРеквизитаТаблЧасти)
							ИЛИ СледуетИсключитьРеквизит(ИмяРеквизитаТаблЧасти, ИмяТаблЧасти, ИсключаемыеРеквизиты) Тогда
							НекорректныеРеквизиты.Добавить(ОбозначениеРеквизита);
							Продолжить;
						КонецЕсли;
							
						СпособУказанияСубконто = СпособУказанияСубконто_ПоНомеру;
						
					ИначеЕсли ТипЗнч(ОбозначениеРеквизита) = Тип("ПланВидовХарактеристикСсылка.ВидыСубконто") Тогда
						ОбозначениеРеквизитаКорректное = ЗначениеЗаполнено(ОбозначениеРеквизита)
							И (НЕ ЗначениеЗаполнено(СпособУказанияСубконто) ИЛИ СпособУказанияСубконто = СпособУказанияСубконто_ПоВиду);
						
						Если НЕ ОбозначениеРеквизитаКорректное
							ИЛИ НЕ ИмяРеквизитаСинтаксическиКорректно(ИмяРеквизитаТаблЧасти)
							ИЛИ СледуетИсключитьРеквизит(ИмяРеквизитаТаблЧасти, ИмяТаблЧасти, ИсключаемыеРеквизиты) Тогда
							НекорректныеРеквизиты.Добавить(ОбозначениеРеквизита);
							Продолжить;
						КонецЕсли;
						
						СпособУказанияСубконто = СпособУказанияСубконто_ПоВиду;
						
					Иначе
						НекорректныеРеквизиты.Добавить(ОбозначениеРеквизита);
						Продолжить;
						
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			// Текущие реквизиты субконто корректные?
			Если ОбнаруженоПолеСвязи И ЗначениеЗаполнено(СпособУказанияСубконто) Тогда
				// Да.
				// Завершаем настройку.
				
				Если ТабличныеЧасти.Найти(ИмяТаблЧасти) = Неопределено Тогда
					// Обнаружен первый реквизит этой табл.части.
					ТабличныеЧасти.Добавить(ИмяТаблЧасти);
				КонецЕсли;
				
				// Удаляем некорректные:
				Для Каждого ВремЭлем Из НекорректныеРеквизиты Цикл
					Реквизиты.Удалить(ВремЭлем);
				КонецЦикла;
				
				// Запоминаем способ указания субконто:
				Реквизиты.Вставить(СпособУказанияСубконто_Ключ, СпособУказанияСубконто);
				
			Иначе
				// Нет.
				НекорректныеМассивыРеквизитов.Добавить(инд);
			КонецЕсли;
			
		КонецЦикла;
		
		// Удаляем некорректные массивы (в обратном порядке):
		ВремКолво = НекорректныеМассивыРеквизитов.Количество();
		Для инд = 0 По ВремКолво - 1 Цикл
			индУдаляемый = НекорректныеМассивыРеквизитов[(ВремКолво - 1) - инд];
			МассивРеквизитов.Удалить(индУдаляемый);
		КонецЦикла;
		
		// Для текущей табл.части остались допустимые реквизиты субконто?
		Если МассивРеквизитов.Количество() = 0 Тогда
			ПроверяемыеСубконто.Удалить(ИмяТаблЧасти);
		КонецЕсли;
			
	КонецЦикла;
	
	// Продолжение входной проверки реквизитов признаков учета.
	// Удаляем некорректные элементы, оставляем только корректные.
	ДопустимыеПризнакиУчета = Новый Структура("
		|УчетПоПодразделениям,
		|УчетПоКПС,
		|УчетПоКЭК,
		|Количественный,
		|Валютный,
		// Обязательность заполнения признаков учета
		|РазрешитьНеУказыватьПодразделение");
		
	Для Каждого ЭлементПризнакУчета Из ПроверяемыеПризнакиУчета Цикл
		ИмяТаблЧасти		= ЭлементПризнакУчета.Ключ;
		МассивРеквизитов	= ЭлементПризнакУчета.Значение;
		
		НекорректныеМассивыРеквизитов = Новый Массив();
		ПоляСвязиСчет = Новый Массив();
		Для инд = 0 По МассивРеквизитов.Количество() - 1 Цикл
			Реквизиты = МассивРеквизитов[инд];
			
			ОбнаруженоПолеСвязи			= Ложь;
			ОбнаруженоПолеПризнакаУчета	= Ложь;
			
			Если ТипЗнч(Реквизиты) = Тип("Структура") Тогда
				НекорректныеРеквизиты = Новый Массив();
				Для Каждого ЭлементРеквизит Из Реквизиты Цикл
					ОбозначениеРеквизита	= ЭлементРеквизит.Ключ;
					ИмяРеквизитаТаблЧасти	= ЭлементРеквизит.Значение;
					
					Если ОбозначениеРеквизита = ОбозначениеПоляСвязиСчет Тогда
						ИмяПоляСвязиСчет = ИмяРеквизитаТаблЧасти;
						
						Если ИмяРеквизитаСинтаксическиКорректно(ИмяПоляСвязиСчет)
							И НЕ СледуетИсключитьРеквизит(ИмяПоляСвязиСчет, ИмяТаблЧасти, ИсключаемыеРеквизиты) Тогда
							// Для текущего поля связи "счет" уже были зависимые поля признаков учета?
							Если ПоляСвязиСчет.Найти(ИмяПоляСвязиСчет) = Неопределено Тогда
								// Пока не было такого поля связи.
								ПоляСвязиСчет.Добавить(ИмяПоляСвязиСчет);
								ОбнаруженоПолеСвязи = Истина;
							КонецЕсли;
							
							Продолжить;
						КонецЕсли;
					КонецЕсли;
					
					Попытка
						ОбозначениеРеквизитаКорректное = ДопустимыеПризнакиУчета.Свойство(ОбозначениеРеквизита);
					Исключение
						ОбозначениеРеквизитаКорректное = Ложь;
					КонецПопытки;
					
					Если ОбозначениеРеквизитаКорректное
						И ИмяРеквизитаСинтаксическиКорректно(ИмяРеквизитаТаблЧасти)
						И НЕ СледуетИсключитьРеквизит(ИмяРеквизитаТаблЧасти, ИмяТаблЧасти, ИсключаемыеРеквизиты) Тогда
						ОбнаруженоПолеПризнакаУчета = Истина;
					Иначе
						НекорректныеРеквизиты.Добавить(ОбозначениеРеквизита);
						Продолжить;
					КонецЕсли;
					
				КонецЦикла;
			КонецЕсли;
			
			// Текущие реквизиты признаков учета корректные?
			Если ОбнаруженоПолеСвязи И ОбнаруженоПолеПризнакаУчета Тогда
				// Да.
				// Завершаем настройку.
				
				Если ТабличныеЧасти.Найти(ИмяТаблЧасти) = Неопределено Тогда
					// Обнаружен первый реквизит этой табл.части.
					ТабличныеЧасти.Добавить(ИмяТаблЧасти);
				КонецЕсли;
				
				// Удаляем некорректные:
				Для Каждого ВремЭлем Из НекорректныеРеквизиты Цикл
					Реквизиты.Удалить(ВремЭлем);
				КонецЦикла;
				
			Иначе
				// Нет.
				НекорректныеМассивыРеквизитов.Добавить(инд);
			КонецЕсли;
			
		КонецЦикла;
		
		// Удаляем некорректные массивы (в обратном порядке):
		ВремКолво = НекорректныеМассивыРеквизитов.Количество();
		Для инд = 0 По ВремКолво - 1 Цикл
			индУдаляемый = НекорректныеМассивыРеквизитов[(ВремКолво - 1) - инд];
			МассивРеквизитов.Удалить(индУдаляемый);
		КонецЦикла;
		
		// Для текущей табл.части остались допустимые реквизиты субконто?
		Если МассивРеквизитов.Количество() = 0 Тогда
			ПроверяемыеПризнакиУчета.Удалить(ИмяТаблЧасти);
		КонецЕсли;
			
	КонецЦикла;
	
	//
	// 2.	Проверяем заполненность по порядку.
	//
	
	//
	// 2.1.	Реквизиты шапки - проверяем явным перебором.
	//
	Для Каждого ИмяРеквизита Из РеквизитыШапки Цикл
		Если НЕ ЗначениеЗаполнено(ДокументОбъект[ИмяРеквизита]) Тогда
			// Значение реквизита шапки документа не заполнено.
			Результат = Ложь;
			КоличествоОшибок = КоличествоОшибок + 1;
			
			Если СчетчикСообщений < МаксКолвоСообщений Тогда
				// Допустимое количество выведенных сообщений об ошибках не превышено.
				
				Если ВыводитьСообщения Тогда
					ПредставлениеРеквизита = ДокументОбъект.Метаданные().Реквизиты.Найти(ИмяРеквизита).Синоним;
					//ПредставлениеРеквизита = ИмяРеквизита;
					
					// Сведения для вывода сообщений по этому полю:
					ИмяПоляДляВыводаСообщений = ПеренаправлениеВыводаСообщений_Реквизиты.Получить(ИмяРеквизита);
					Если ИмяПоляДляВыводаСообщений = Неопределено Тогда
						ИмяПоляДляВыводаСообщений = ИмяРеквизита;
					КонецЕсли;
					
					ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение", ПредставлениеРеквизита);
					
					ОбщегоНазначения.СообщитьПользователю(
						ТекстСообщения,
						ДокСсылка,
						"Объект." + ИмяПоляДляВыводаСообщений);
				КонецЕсли;
				
				СчетчикСообщений = СчетчикСообщений + 1;
				
			Иначе
				// Превышено допустимое количество выведенных сообщений.
				ПроверкаПрервана = Истина;
				// Здесь не прерываем, т.к. пока неизвестно общее кол-во таких ошибок.

			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	// Вывели сообщения обо всех незаполненных реквизитах шапки?
	Если ВыводитьСообщения И ПроверкаПрервана И КоличествоОшибок > 0 Тогда
		КолвоНевыведенныхСообщений = КоличествоОшибок - СчетчикСообщений;
		Текст = НСтр("ru='Также не заполнены и другие реквизиты шапки документа (еще %1реквизитов)'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст, "" + КолвоНевыведенныхСообщений + Символы.НПП);
			ОбщегоНазначения.СообщитьПользователю(
				ТекстСообщения,
				ДокСсылка);
	КонецЕсли;
	
	//
	// 2.2.	Реквизиты табличных частей - проверяем, используя СКД
	//
	//	С помощью СКД получаем ДЛЯ КАЖДОЙ ТАБЛ.ЧАСТИ таблицу вида:
	//	
	//	"НомерСтроки"	"КолвоПустых_<ИмяРеквизита1>"	"КолвоПустых_<ИмяРеквизита2>"	"КолвоПустых_<ИмяРеквизита3>"
	//			1					0								0								0
	//			3					1								0								1
	//			5					0								1								1
	//			6					0								0								1
	//	ИТОГО	-					1								1								3
	// 
	//	, где
	//		НомерСтроки	- колонка "номер строки" проверяемой табл.части, в которой
	//					хотя бы один из проверяемых реквизитов <ИмяРеквизита1...3>
	//					не заполнен;
	//		КолвоПустых_<ИмяРеквизита1...3>	- колонки вычисляемых полей, рассчитываемых для
	//								соответствующих проверяемых полей строк табл.части:
	//								=1, если значение поля не заполнено,
	//								=0, если значение поля заполнено.
	//	В последней строке (ИТОГО) можно увидеть, во скольких строках табл.части
	// не заполнен каждый из проверяемых реквизитов.
	//
	
	Для Каждого ИмяТаблЧасти Из ТабличныеЧасти Цикл
		
		// Сведения для вывода сообщений по этой табл.части:
		ИмяТаблЧастиДляВыводаСообщений = Неопределено;
		Если НЕ ПеренаправлениеВыводаСообщений_ТабличныеЧасти.Свойство(ИмяТаблЧасти, ИмяТаблЧастиДляВыводаСообщений) Тогда
			ИмяТаблЧастиДляВыводаСообщений = ИмяТаблЧасти;
		КонецЕсли;
		
		ТаблЧастьМетаданные = ДокументОбъект.Метаданные().ТабличныеЧасти.Найти(ИмяТаблЧасти);
		//ТаблЧастьМетаданные = ДокументОбъект.Метаданные().ТабличныеЧасти.Найти(ИмяТаблЧастиДляВыводаСообщений);
		ПредставлениеТаблЧасти = ТаблЧастьМетаданные.Синоним;
		
		// Есть еще свободное кол-во сообщений для проверки этой табл.части?
		Если ВыводитьСообщения И ПроверкаПрервана И КоличествоОшибок > 0 Тогда
			Текст = НСтр("ru='Проверка заполнения таблицы ""%1"" не проводилась (превышено количество сообщений об ошибках)'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст,
				ПредставлениеТаблЧасти);
			ОбщегоНазначения.СообщитьПользователю(
				ТекстСообщения,
				ДокСсылка,
				"Объект." + ИмяТаблЧастиДляВыводаСообщений);
			// Переходим к проверке следующей табл.части:	
			Продолжить;
		КонецЕсли;
		
		// Проверяемые реквизиты текущей табличной части:
		МассивНезависимыхРеквизитов		= Неопределено;
		МассивРеквизитовСубконто		= Неопределено;
		МассивРеквизитовПризнаковУчета	= Неопределено;
		
		ПроверятьНезависимыеРеквизиты	= НезависимыеРеквизиты.Свойство(ИмяТаблЧасти, МассивНезависимыхРеквизитов);
		ПроверятьСубконто				= ПроверяемыеСубконто.Свойство(ИмяТаблЧасти, МассивРеквизитовСубконто);
		ПроверятьПризнакиУчета			= ПроверяемыеПризнакиУчета.Свойство(ИмяТаблЧасти, МассивРеквизитовПризнаковУчета);
		
		// Таблица, заполняемая системой КД далее:
		ТЗВсеНомераСтрок = Новый ДеревоЗначений();
		ТЗВсеНомераСтрок.Колонки.Добавить(ИмяПоляНомерСтроки, Новый ОписаниеТипов("Число",
			Новый КвалификаторыЧисла(6, 0, ДопустимыйЗнак.Неотрицательный)));
		
		// СКД:
		СКД = Новый СхемаКомпоновкиДанных();
		
		// СКД: Источник данных:
		ИД = СКД.ИсточникиДанных.Добавить();
		ИД.Имя = ИмяИсточникаДанных;
		ИД.ТипИсточникаДанных = "Local";
		
		// СКД: Компоновщик макета:
		КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных();
			
		// СКД: Сами данные, выгружаемые из проверяемых табл.частей:
		ВнешниеНаборыДанных = Новый Структура();
		
		// СКД: Тип значения добавляемых вычисляемых полей:
		ОписаниеТиповВычисляемыеПоля = Новый ОписаниеТипов("Число",
			Новый КвалификаторыЧисла(6, 0, ДопустимыйЗнак.Неотрицательный));
		
		// СКД: Набор данных-объект проверяемой табличной части:
		НаборДанныхОбъект = СКД.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
		НаборДанныхОбъект.Имя				= НаборДанныхОбъект_Имя;
		НаборДанныхОбъект.ИмяОбъекта		= НаборДанныхОбъект_Имя;
		НаборДанныхОбъект.ИсточникДанных	= ИмяИсточникаДанных;
		
		// СКД: Наборы данных, связи и параметры для проверки субконто:
		Если ПроверятьСубконто Тогда
			
			// Текст запрос для набора-запроса:
			ТекстЗапросаВидыСубконто = "
			|ВЫБРАТЬ
			|	Ссылка								КАК ВидыСубконто_Счет_<ИмяПоляСвязиСчет>,
			|	НомерСтроки							КАК ВидыСубконто_НомерСубконто_<ИмяПоляСвязиСчет>,
			|	ВидСубконто							КАК ВидыСубконто_ВидСубконто_<ИмяПоляСвязиСчет>,
			|	НЕ ЕПСБУВидыСубконто.Обязательный	КАК ВидыСубконто_ВводПустыхСубконто_<ИмяПоляСвязиСчет>
			|ИЗ
			|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
			|ГДЕ
			|	Ссылка = &<ИмяПоляСвязиСчет>
			|;";
			
			Для Каждого РеквизитыСубконто Из МассивРеквизитовСубконто Цикл
				ИмяПоляСвязиСчет = РеквизитыСубконто.Получить(ОбозначениеПоляСвязиСчет);
				
				// Набор данных-запрос:
				ИмяНабораДанныхЗапрос = "ВидыСубконто_" + ИмяПоляСвязиСчет;
				ТекстЗапроса = СтрЗаменить(ТекстЗапросаВидыСубконто, "<ИмяПоляСвязиСчет>", ИмяПоляСвязиСчет);
				Набор = СКД.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
				Набор.Имя				= ИмяНабораДанныхЗапрос;
				Набор.Запрос			= ТекстЗапроса;
				Набор.ИсточникДанных	= ИмяИсточникаДанных;
				
				// Связь наборов данных:
				Связь = СКД.СвязиНаборовДанных.Добавить();
				Связь.НаборДанныхИсточник	= НаборДанныхОбъект_Имя;
				Связь.НаборДанныхПриемник	= ИмяНабораДанныхЗапрос;
				Связь.ВыражениеИсточник		= ИмяПоляСвязиСчет;
				Связь.ВыражениеПриемник		= "ВидыСубконто_Счет_" + ИмяПоляСвязиСчет;
				Связь.Параметр				= ИмяПоляСвязиСчет;
				Связь.Обязательная			= Истина;
				
				// Указываем переданные виды субконто в соответствующих параметрах:
				СпособУказанияСубконто = РеквизитыСубконто.Получить(СпособУказанияСубконто_Ключ);
				Если СпособУказанияСубконто = СпособУказанияСубконто_ПоВиду Тогда
					
					Для Каждого ЭлементСубконто Из РеквизитыСубконто Цикл
						
						ЭтоВидСубконто = (ТипЗнч(ЭлементСубконто.Ключ) = Тип("ПланВидовХарактеристикСсылка.ВидыСубконто"));
						Если НЕ ЭтоВидСубконто Тогда
							Продолжить;
						КонецЕсли;
						
						ИмяРеквизита	= ЭлементСубконто.Значение;
						ВидСубконто		= ЭлементСубконто.Ключ;
						ИмяПараметра	= ПрефиксПараметраВидСубконто + ИмяРеквизита;
						
						ПараметрВидСубконто = СКД.Параметры.Добавить();
						ПараметрВидСубконто.Имя = ИмяПараметра;
						ПараметрВидСубконто.ТипЗначения = Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто");
						ПараметрВидСубконто.Значение = ВидСубконто;
						ПараметрВидСубконто.Использование = ИспользованиеПараметраКомпоновкиДанных.Всегда;
						
					КонецЦикла;
					
				КонецЕсли;
				
			КонецЦикла; // РеквизитыСубконто
			
		КонецЕсли;
		
		// СКД: Наборы данных, связи и параметры для проверки признаков учета:
		Если ПроверятьПризнакиУчета Тогда
			
			// Текст запрос для набора-запроса:
			ТекстЗапросаПризнакиСчетов = "
			|ВЫБРАТЬ
			|	<ДопустимыеПризнакиУчета>
			|	Ссылка	КАК ПризнакиСчетов_Счет_<ИмяПоляСвязиСчет>
			|ИЗ
			|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
			|ГДЕ
			|	Ссылка = &<ИмяПоляСвязиСчет>
			|;";
			
			// Перечисляем признаки учета для текста запроса:
			СтрокаДопустимыеПризнакиУчета = "";
			Для Каждого Элем Из ДопустимыеПризнакиУчета Цикл
				ПризнакУчета = Элем.Ключ;
				СтрокаДопустимыеПризнакиУчета = СтрокаДопустимыеПризнакиУчета
					+ ?(ЗначениеЗаполнено(СтрокаДопустимыеПризнакиУчета), "
						|	", "")
					+ ПризнакУчета + "	КАК " + НаборДанныхЗапросПризнакиСчетов_ПрефиксИмениПоля + ПризнакУчета + "_<ИмяПоляСвязиСчет>,";
			КонецЦикла;
			
			Для Каждого РеквизитыПризнаковУчета Из МассивРеквизитовПризнаковУчета Цикл
				
				ИмяПоляСвязиСчет = РеквизитыПризнаковУчета[ОбозначениеПоляСвязиСчет];
				
				// Набор данных-запрос:
				ИмяНабораДанныхЗапрос = "ПризнакиУчета_" + ИмяПоляСвязиСчет;
				ТекстЗапроса = СтрЗаменить(ТекстЗапросаПризнакиСчетов, "<ДопустимыеПризнакиУчета>", СтрокаДопустимыеПризнакиУчета);
				ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<ИмяПоляСвязиСчет>", ИмяПоляСвязиСчет);
				Набор = СКД.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
				Набор.Имя				= ИмяНабораДанныхЗапрос;
				Набор.Запрос			= ТекстЗапроса;
				Набор.ИсточникДанных	= ИмяИсточникаДанных;
				
				// Связь наборов данных:
				Связь = СКД.СвязиНаборовДанных.Добавить();
				Связь.НаборДанныхИсточник	= НаборДанныхОбъект_Имя;
				Связь.НаборДанныхПриемник	= ИмяНабораДанныхЗапрос;
				Связь.ВыражениеИсточник		= ИмяПоляСвязиСчет;
				Связь.ВыражениеПриемник		= НаборДанныхЗапросПризнакиСчетов_ПрефиксИмениПоля + "Счет_" + ИмяПоляСвязиСчет;
				Связь.Параметр				= ИмяПоляСвязиСчет;
				Связь.Обязательная			= Истина;
			КонецЦикла;
			
		КонецЕсли;
		
		// СКД: Настройки:
		КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных();
		КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СКД)); 
		Настройки = КомпоновщикНастроек.Настройки;
		
		// СКД: Структура настроек - группировки и выбранные поля:
		Настройки.Структура.Очистить();
		// Выбранные поля всего отчета - начало:
		Поле = Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		Поле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоляНомерСтроки);
		// Группировка по полю "Номер строки":
		СтруктураГруппировкиНомерСтроки = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
		ПолеГруппировки = СтруктураГруппировкиНомерСтроки.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
		ПолеГруппировки.Использование  = Истина;
		ПолеГруппировки.Поле           = Новый ПолеКомпоновкиДанных(ИмяПоляНомерСтроки);
		ПолеГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.Элементы;
		СтруктураГруппировкиНомерСтроки.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
		СтруктураГруппировкиНомерСтроки.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
		// Детальные записи:
		СтруктураГруппировки = СтруктураГруппировкиНомерСтроки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
		ПолеГруппировки = СтруктураГруппировки.ПоляГруппировки.Элементы.Добавить(Тип("АвтоПолеГруппировкиКомпоновкиДанных"));
		ПолеГруппировки.Использование  = Истина;
		СтруктураГруппировки.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
		СтруктураГруппировки.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
		
		// СКД: Поля текущего объекта данных (начало):
		НаборДанныхОбъект.Поля.Очистить();
		ИменаИспользуемыхКолонок	= Новый Массив();
		ИменаКолонокРезультата		= Новый Массив();
		
		// СКД: Вычисляемые поля, ресурсы, отбор:
		СКД.ВычисляемыеПоля.Очистить();
		СКД.ПоляИтога.Очистить();
		Настройки.Выбор.Элементы.Очистить();
		// Отбор по группировке "Номер строки":
		СтруктураГруппировкиНомерСтроки.Отбор.Элементы.Очистить();
		ГруппаКорень = СтруктураГруппировкиНомерСтроки.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
		ГруппаКорень.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
		Если ПроверятьНезависимыеРеквизиты Тогда
			// Группа отбора верхнего уровня:
			ГруппаТекКорень = ГруппаКорень.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
			ГруппаТекКорень.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
