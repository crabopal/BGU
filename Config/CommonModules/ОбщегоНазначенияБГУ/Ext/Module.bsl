// Возвращает имя реквизита, гарантированно отсутствующего на форме. Используется для добавления реквизитов формы.
// Если реквизит с желаемым именем уже существует, будет выполнен перебор имен до появления уникального имени реквизита.
//
// Имя реквизита при переборе имен имеет вид <ЖелаемоеИмяРеквизита>_<Счетчик>, где <Счетчик> - число от 1.
//
// Параметры:
//	Форма					- Управляемая форма	- форма, в которой проверяется наличие реквизита.
//												Обязательный параметр;
//	ЖелаемоеИмяРеквизита	- Строка	- начальное имя искомого реквизита.
//										Если реквизит с таким именем отсутствует на форме, то будет возвращено это значение;
//										Обязательный параметр;
//	ИмяТаблицыФормы			- Строка	- имя реквизита формы типа ТаблицаЗначений;
//										В этом случае имя реквизита будет искаться среди колонок таблицы формы;
//	ИмяТабличнойЧастиОбъекта	- Строка	- имя табличной части объекта.
//											В этом случае имя реквизита будет искаться среди колонок табличной части объекта;
//	
//	При необходимости получения имени колонки в таблице, необходимо указать лишь один из параметров:
//	ИмяТаблицыФормы	или ИмяТабличнойЧастиОбъекта. В зависимости от того, где необходимо искать наличие реквизита.
//
// Возвращаемое значение:
//	Строка	- имя реквизита, гарантированно отсутствующего на форме.
Функция ПолучитьУникальноеИмяРеквизитаФормы(Форма, ЖелаемоеИмяРеквизита, ИмяТаблицыФормы = Неопределено, ИмяТабличнойЧастиОбъекта = Неопределено) Экспорт
	
	ШаблонИмени = "%1%2";
	
	ШаблонСчетчика = "_%1";
	
	Если ИмяТаблицыФормы = Неопределено И ИмяТабличнойЧастиОбъекта = Неопределено Тогда
		
		Путь = Неопределено;
		
	ИначеЕсли ИмяТаблицыФормы <> Неопределено Тогда
		
		Путь = ИмяТаблицыФормы;
		
	ИначеЕсли ИмяТабличнойЧастиОбъекта <> Неопределено Тогда
		
		Путь = "Объект." + ИмяТабличнойЧастиОбъекта;
		
	КонецЕсли;
	
	МассивРеквизитов = Форма.ПолучитьРеквизиты(Путь);
	
	ИменаРеквизитов = Новый Массив();
	
	Для Каждого Реквизит Из МассивРеквизитов Цикл
		
		ИменаРеквизитов.Добавить(НРег(Реквизит.Имя));
		
	КонецЦикла;
		
	ИмяКандидат = ЖелаемоеИмяРеквизита;
	
	Счетчик = 0;
	
	Пока Истина Цикл
		
		ИмяНайдено = (ИменаРеквизитов.Найти(НРег(ИмяКандидат)) <> Неопределено);
		
		Если ИмяНайдено Тогда
			
			Счетчик = Счетчик + 1;
			
			СчетчикСтрокой = СтрШаблон(ШаблонСчетчика, Формат(Счетчик, "ЧГ="));
			
			ИмяКандидат = СтрШаблон(ШаблонИмени, ЖелаемоеИмяРеквизита, СчетчикСтрокой);
			
		Иначе	
			
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ИмяКандидат;
	
КонецФункции

// Возвращает имя элемента формы, гарантированно отсутствующего на форме. Используется для добавления элементов формы.
// Если элемент формы с желаемым именем уже существует, будет выполнен перебор имен до появления уникального имени элемента формы.
//
// Имя элемента формы при переборе имен имеет вид <ЖелаемоеИмяЭлемента>_<Счетчик>, где <Счетчик> - число от 1.
//
// Параметры:
//	Форма					- Управляемая форма	- форма, в которой проверяется наличие элемента формы.
//												Обязательный параметр;
//	ЖелаемоеИмяЭлемента	- Строка	- начальное имя искомого реквизита.
//										Если элемент формы с таким именем отсутствует на форме, то будет возвращено это значение;
