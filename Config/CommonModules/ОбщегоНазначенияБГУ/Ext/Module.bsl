// Служебная функция, предназначенная для получения описания типов строки, заданной длины.
//  Используется для совместимости с БГУ ред. 1.0
// 
// Параметры:
//  ДлинаСтроки - число, длина строки.
//
// Возвращаемое значение:
//  Объект "ОписаниеТипов" для строки указанной длины.
//
Функция ПолучитьОписаниеТиповСтроки(ДлинаСтроки) Экспорт

	Массив = Новый Массив; 
	Массив.Добавить(Тип("Строка"));

	КвалификаторСтроки = Новый КвалификаторыСтроки(ДлинаСтроки, ДопустимаяДлина.Переменная);

	Возврат Новый ОписаниеТипов(Массив, , КвалификаторСтроки);

КонецФункции 

// Служебная функция, предназначенная для получения описания типов числа, заданной разрядности.
//  Используется для совместимости с БГУ ред. 1.0
// 
// Параметры:
//  Разрядность 			- число, разряд числа.
//  РазрядностьДробнойЧасти - число, разряд дробной части.
//
// Возвращаемое значение:
//  Объект "ОписаниеТипов" для числа указанной разрядности.
//
Функция ПолучитьОписаниеТиповЧисла(Разрядность,РазрядностьДробнойЧасти=0) Экспорт

	Массив = Новый Массив;

	Массив.Добавить(Тип("Число"));
	КвалификаторЧисла = Новый КвалификаторыЧисла(Разрядность,РазрядностьДробнойЧасти);

	Возврат Новый ОписаниеТипов(Массив, КвалификаторЧисла);

КонецФункции 

#КонецОбласти

#Область СравнениеОбъектов

// Сравнивает значения элементов двух коллекций именованных элементов.
//
// Параметры:
//	Коллекция1				- Коллекция именованных элементов	- первая сравниваемая коллекция;
//	Коллекция2				- Коллекция именованных элементов	- вторая сравниваемая коллекция;
//	КоллекцияИменЭлементов	- Массив, Строка, Структура	- имена сравниваемых элементов;
//	ЗапрашиваемыеСведения	- Строка	- одна или несколько (через запятую) строк из перечня (см. структуру возврата);
//
// Возврат:
//	Структура	- содержит поля, указанные в ЗапрашиваемыеСведения:
//	* ОтсутствующиеВКоллекции1		- Массив	- имена элементов (из указанных), которые отсутствуют в коллекции 1;
//	* ОтсутствующиеВКоллекции2		- Массив	- имена элементов (из указанных), которые отсутствуют в коллекции 2;
//	* СовпавшиеЗначения				- Массив	- имена элементов (из указанных), значения которых равны;
//	* РазличныеЗначения				- Массив	- имена элементов (из указанных), значения которых различаются;
//	* ЗначенияСовпадаютПолностью	- Булево	- Истина, если совпадают значения всех элементов (из указанных).
Функция СравнитьЭлементыКоллекций(Коллекция1, Коллекция2, Знач КоллекцияИменЭлементов, ЗапрашиваемыеСведения) Экспорт
	
	Перем МассивИменЭлементов;
	
	// Входная проверка.
	
	// Приводим параметры к ожидаемому типу:
	Если ТипЗнч(КоллекцияИменЭлементов) = Тип("Массив") Тогда
		МассивИменЭлементов = КоллекцияИменЭлементов;
	ИначеЕсли ТипЗнч(КоллекцияИменЭлементов) = Тип("Структура") Тогда
		МассивИменЭлементов = Новый Массив();
		Для Каждого Элем Из КоллекцияИменЭлементов Цикл
			МассивИменЭлементов.Добавить(Элем.Ключ);
		КонецЦикла;
	ИначеЕсли ТипЗнч(КоллекцияИменЭлементов) = Тип("Строка") Тогда
		МассивИменЭлементов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(КоллекцияИменЭлементов);
	КонецЕсли;
	
	МассивСведений = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(ЗапрашиваемыеСведения);
	
	ТаблицаСравнения = Новый ТаблицаЗначений();
	ТаблицаСравнения.Колонки.Добавить("ИмяЭлемента",				Новый ОписаниеТипов("Строка"));
	ТаблицаСравнения.Колонки.Добавить("ПрисутствуетВКоллекции1",	Новый ОписаниеТипов("Булево"));
	ТаблицаСравнения.Колонки.Добавить("ПрисутствуетВКоллекции2",	Новый ОписаниеТипов("Булево"));
	ТаблицаСравнения.Колонки.Добавить("ЗначенияСовпадают",			Новый ОписаниеТипов("Булево"));
	
	// Заполняем таблицу сравнения:
	Для Каждого ИмяЭлемента Из МассивИменЭлементов Цикл
		Попытка
			Значение1 = Коллекция1[ИмяЭлемента];
			ПрисутствуетВКоллекции1 = Истина;
		Исключение
			Значение1 = Неопределено;
			ПрисутствуетВКоллекции1 = Ложь;
		КонецПопытки;
		Попытка
			Значение2 = Коллекция2[ИмяЭлемента];
			ПрисутствуетВКоллекции2 = Истина;
		Исключение
			Значение2 = Неопределено;
			ПрисутствуетВКоллекции2 = Ложь;
		КонецПопытки;
		
		Если ПрисутствуетВКоллекции1 И ПрисутствуетВКоллекции2 Тогда
			ЗначенияЯвляютсяКоллекциями =
					(ТипЗнч(Значение1) = Тип("Структура") ИЛИ ТипЗнч(Значение1) = Тип("Соответствие") ИЛИ ТипЗнч(Значение1) = Тип("Массив"))
				И	(ТипЗнч(Значение2) = Тип("Структура") ИЛИ ТипЗнч(Значение2) = Тип("Соответствие") ИЛИ ТипЗнч(Значение2) = Тип("Массив"));
			Если ЗначенияЯвляютсяКоллекциями Тогда
				ЗначенияСовпадают = ОбщегоНазначенияБГУ.ФункцияСравненияОбъектов(Значение1, Значение2);
			Иначе
				ЗначенияСовпадают = (Значение1 = Значение2);
			КонецЕсли;
		Иначе
			ЗначенияСовпадают = Ложь;
		КонецЕсли;
		
		НоваяСтрока								= ТаблицаСравнения.Добавить();
		НоваяСтрока["ИмяЭлемента"]				= ИмяЭлемента;
		НоваяСтрока["ПрисутствуетВКоллекции1"]	= ПрисутствуетВКоллекции1;
		НоваяСтрока["ПрисутствуетВКоллекции2"]	= ПрисутствуетВКоллекции2;
		НоваяСтрока["ЗначенияСовпадают"]		= ЗначенияСовпадают;
	КонецЦикла;
	
	// Возвращаемые сведения о результатах сравнения коллекций
	
	Результат = Новый Структура();
	Для Каждого ОбозначениеСведений Из МассивСведений Цикл
		
		Если ВРег(ОбозначениеСведений) = ВРег("ОтсутствующиеВКоллекции1") Тогда
			Поиск = Новый Структура("ПрисутствуетВКоллекции1", Ложь);
			Сведения = ТаблицаСравнения.Скопировать(Поиск, "ИмяЭлемента").ВыгрузитьКолонку("ИмяЭлемента");
			
			Результат.Вставить(ОбозначениеСведений, Сведения);
		КонецЕсли;
		
		Если ВРег(ОбозначениеСведений) = ВРег("ОтсутствующиеВКоллекции2") Тогда
			Поиск = Новый Структура("ПрисутствуетВКоллекции2", Ложь);
			Сведения = ТаблицаСравнения.Скопировать(Поиск, "ИмяЭлемента").ВыгрузитьКолонку("ИмяЭлемента");
			
			Результат.Вставить(ОбозначениеСведений, Сведения);
		КонецЕсли;
		
		Если ВРег(ОбозначениеСведений) = ВРег("СовпавшиеЗначения") Тогда
			Поиск = Новый Структура("ЗначенияСовпадают", Истина);
			Сведения = ТаблицаСравнения.Скопировать(Поиск, "ИмяЭлемента").ВыгрузитьКолонку("ИмяЭлемента");
			
			Результат.Вставить(ОбозначениеСведений, Сведения);
		КонецЕсли;
		
		Если ВРег(ОбозначениеСведений) = ВРег("РазличныеЗначения") Тогда
			Поиск = Новый Структура("ЗначенияСовпадают", Ложь);
			Сведения = ТаблицаСравнения.Скопировать(Поиск, "ИмяЭлемента").ВыгрузитьКолонку("ИмяЭлемента");
			
			Результат.Вставить(ОбозначениеСведений, Сведения);
		КонецЕсли;
		
		Если ВРег(ОбозначениеСведений) = ВРег("ЗначенияСовпадаютПолностью") Тогда
			Поиск = Новый Структура("ЗначенияСовпадают", Истина);
			МассивСтрок = ТаблицаСравнения.НайтиСтроки(Поиск);
			Сведения = (ТаблицаСравнения.Количество() = МассивСтрок.Количество());
			
			Результат.Вставить(ОбозначениеСведений, Сведения);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// ПараметрыСравнения - Структура - содержит параметры, влияющие на алгоритм сравнения:
// - ИсключаяДочерниеСтроки - булево - параметр, используемый для сравнения строк дерева значений
// - КолонкиСравнения - массив имен колонок, по которым будут сравниваться ТЗ,ДЗ,СТЗ,СДЗ 
Функция ФункцияСравненияОбъектов(Источник,Приемник,ПараметрыСравнения = Неопределено) Экспорт
	
	Если ПараметрыСравнения = Неопределено Тогда
		ПараметрыСравнения = Новый Структура;
	КонецЕсли;
	МассивКолонок = Неопределено;
	Если ПараметрыСравнения.Свойство("КолонкиСравнения",МассивКолонок) Тогда
		Если МассивКолонок.Количество()>0 Тогда
			МассивКолонок = СформироватьКоллекциюКолонок(МассивКолонок);
			ПараметрыСравнения.Вставить("КолонкиСравнения",МассивКолонок);
		Иначе
			ПараметрыСравнения.Удалить("КолонкиСравнения");
		КонецЕсли;
	КонецЕсли;
	ПараметрыСравнения.Вставить("Уровень",0);
	Попытка	
		Возврат СравнитьОбъекты(Источник,Приемник,ПараметрыСравнения);
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

#КонецОбласти       

#Область ВключениеУчетаПодразделений

// Заполняет Подразделение в регистре РасчетыСоСтудентами, если ведется учет по учащихся
Процедура ВключитьУчетПоПодразделениямВФоне(ПараметрыПроцедуры, АдресРезультата) Экспорт

	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьУчетСтудентов") Тогда
		Константы.ИспользоватьУчетПоПодразделениям.Установить(Истина);
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СведенияОСтудентах.Период КАК Период,
	|	СведенияОСтудентах.Студент КАК Студент,
	|	СведенияОСтудентах.Факультет КАК Факультет
	|ИЗ
	|	РегистрСведений.СведенияОСтудентах КАК СведенияОСтудентах
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СостоянияСтудентов КАК СостоянияСтудентов
	|		ПО СведенияОСтудентах.Значение = СостоянияСтудентов.Ссылка
	|ГДЕ
	|	СостоянияСтудентов.ДействуетНачисление";
	ФакультетыСтудентов  = Запрос.Выполнить().Выгрузить();
	ФакультетыСтудентов.Индексы.Добавить("Студент");
	
	Запрос.Текст =
	 "ВЫБРАТЬ РАЗЛИЧНЫЕ
	 |	РасчетыСоСтудентами.Регистратор КАК Регистратор,
	 |	РасчетыСоСтудентами.Период КАК Период
	 |ИЗ
	 |	РегистрНакопления.РасчетыСоСтудентами КАК РасчетыСоСтудентами
	 |ГДЕ
	 |	РасчетыСоСтудентами.Факультет = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	НачатьТранзакцию();
	Попытка
	
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.РасчетыСоСтудентами.НаборЗаписей");
		ЭлементБлокировки.ИсточникДанных = РезультатЗапроса;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Регистратор", "Регистратор");
		ЭлементБлокировки = Блокировка.Добавить("Константа.ИспользоватьУчетПоПодразделениям");
		Блокировка.Заблокировать();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			НаборЗаписей = РегистрыНакопления.РасчетыСоСтудентами.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Регистратор.Установить(Выборка.Регистратор);
			НаборЗаписей.Прочитать();
			
			Отбор = Новый Структура("Студент");
			
			Для каждого Запись Из НаборЗаписей Цикл
				
				Если ЗначениеЗаполнено(Запись.Факультет) Тогда
					Продолжить;
				КонецЕсли;
				
				Отбор.Студент = Запись.Студент;
				Факультеты = ФакультетыСтудентов.НайтиСтроки(Отбор);
				ФакультетСтудента = Справочники.Подразделения.ПустаяСсылка();
				ДатаФакультета = '0001.01.01';
				Для каждого СтрокаФакультета Из Факультеты Цикл
				
					Если СтрокаФакультета.Период <= Запись.Период
						И СтрокаФакультета.Период > ДатаФакультета Тогда
						ФакультетСтудента = СтрокаФакультета.Факультет;
						ДатаФакультета = СтрокаФакультета.Период;
					КонецЕсли;
				
				КонецЦикла;
				
				Если ЗначениеЗаполнено(ФакультетСтудента) Тогда
					Запись.Факультет = ФакультетСтудента;
				КонецЕсли;
			
			КонецЦикла;
			
			Если НаборЗаписей.Модифицированность() Тогда
			
				НаборЗаписей.ОбменДанными.Загрузка = Истина;
				НаборЗаписей.Записать(Истина);
			
			КонецЕсли; 
		
		КонецЦикла;
		
		Константы.ИспользоватьУчетПоПодразделениям.Установить(Истина);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Включение учета по подразделениям'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
		
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ПроцедурыИФункцииОбновленияИБ

// Определяет расположение акталога шаблонов информационных баз
//
// Возвращаемое значение:
//   Путь к папке tmplts
//
Функция ОбщийКаталогШаблонов() Экспорт

	Попытка
		Оболочка = Новый COMObject("wScript.Shell");
		КаталогДанныхПриложений = Оболочка.SpecialFolders.Item("AppData");
	Исключение
		Возврат ""
	КонецПопытки;
	
	Если Не ЗначениеЗаполнено(КаталогДанныхПриложений) Тогда 
		Возврат "" 
	КонецЕсли;
	
	КаталогШаблонов = "";
	СисИнфо 		= Новый СистемнаяИнформация;
	ЭлементыВерсии 	= СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СисИнфо.ВерсияПриложения,".");
	
	// Определение текущей версии приложения.
	Если (Число(ЭлементыВерсии[0]) = 8 И Число(ЭлементыВерсии[1]) >= 2) ИЛИ (Число(ЭлементыВерсии[0]) > 8) Тогда
		
		КаталогПоУмолчанию = Новый Файл(КаталогДанныхПриложений + "\1C\1Cv82\tmplts\");
		Если КаталогПоУмолчанию.Существует() Тогда
			КаталогПоУмолчанию = КаталогПоУмолчанию.ПолноеИмя;
		Иначе
			КаталогПоУмолчанию = "";
		КонецЕсли;
		
		ФайлКонфигурации = Новый Файл(КаталогДанныхПриложений + "\1C\1CEStart\1CEStart.cfg");
		Если Не ФайлКонфигурации.Существует() Тогда
			Возврат КаталогПоУмолчанию;
		КонецЕсли;
		
		// Чтение файла настройки.
		Текст = Новый ЧтениеТекста(ФайлКонфигурации.ПолноеИмя, КодировкаТекста.UTF16);
		Стр 			= "";
		КаталогШаблонов = "";
		
		Пока Стр <> Неопределено Цикл
			
			Стр = Текст.ПрочитатьСтроку();
			Если Стр = Неопределено Тогда
				Прервать;
			КонецЕсли; 
			Если Найти(ВРег(Стр), ВРег("ConfigurationTemplatesLocation")) = 0 Тогда
				Продолжить;
			КонецЕсли; 
			ПозицияРазделителя = Найти(Стр, "=");
			Если ПозицияРазделителя = 0 Тогда
				Продолжить;
			КонецЕсли; 
			
			КаталогШаблонов = СокрЛП(Сред(Стр, ПозицияРазделителя + 1));
			
		КонецЦикла; 
		
		Если ПустаяСтрока(КаталогШаблонов) Тогда
			Возврат КаталогПоУмолчанию;
		КонецЕсли;
		
	Иначе	
		
		КаталогПоУмолчанию = Новый Файл(КаталогПрограммы() + "\tmplts");
		Если КаталогПоУмолчанию.Существует() Тогда
			КаталогПоУмолчанию = КаталогПоУмолчанию.ПолноеИмя;
		Иначе
			КаталогПоУмолчанию = "";
		КонецЕсли;
		
		ФайлКонфигурации = Новый Файл(КаталогДанныхПриложений + "\1C\1Cv8"+ЭлементыВерсии[1]+"\v8cscadr.lst");
		
		Если ФайлКонфигурации.Существует() Тогда
			
			КаталогШаблонов = "";
			ЧтениеТекста = Новый ЧтениеТекста;
			ЧтениеТекста.Открыть(ФайлКонфигурации.ПолноеИмя,КодировкаТекста.Системная,,, Ложь);
			
			С = ЧтениеТекста.ПрочитатьСтроку();
			Пока С <> Неопределено Цикл
				С = СокрЛП(С);
				Если НРег(Лев(С, 7)) = "file://" Тогда
					КаталогШаблонов = СокрЛ(Сред(С, 8));
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если КаталогШаблонов = "" Тогда
				Возврат КаталогПоУмолчанию; 
			КонецЕсли;
			
		Иначе
			Возврат КаталогПоУмолчанию;
		КонецЕсли;		
	КонецЕсли;

	Возврат КаталогШаблонов;
	
КонецФункции // ОбщийКаталогШаблонов()

// Определяет положение каталога шаблонов для текущего релиза текущей конфигурации.
//
Функция ПолучитьКаталогШаблонов() Экспорт

	КаталогШаблонов = ОбщийКаталогШаблонов();
	
	Если КаталогШаблонов = "" Тогда
		Возврат "" 
	КонецЕсли;
	
	МетаданныеКонфигурации = Метаданные;
	
	КаталогШаблоновКонфигурации = "";
	ИдКонфигурации = МетаданныеКонфигурации.Имя;
	
	Если ИдКонфигурации = "БухгалтерияБюджетногоУчреждения" Тогда
		КаталогШаблоновКонфигурации = "BudgetAccounting"
	ИначеЕсли ИдКонфигурации = "СводОтчетовПРОФ" Тогда
		КаталогШаблоновКонфигурации = "BudgetConsolidation"
	ИначеЕсли ИдКонфигурации = "БюджетнаяОтчетность" Тогда
		КаталогШаблоновКонфигурации = "BudgetReports"
	КонецЕсли;
	
	Если КаталогШаблоновКонфигурации = "" Тогда
		Возврат ""
	КонецЕсли;
		
	ТекРелиз = МетаданныеКонфигурации.Версия;
	ПерваяТочка = Найти(ТекРелиз, ".");
	ВтораяТочка = ПерваяТочка + Найти(Сред(ТекРелиз, ПерваяТочка) + 1, ".");
	ТекРедакция = СтрЗаменить(Лев(ТекРелиз, ВтораяТочка), ".", "_");
	ПозНомераРелиза = СтрДлина(ТекРедакция) + 2;
	
	КаталогиРедакции = НайтиФайлы(КаталогШаблонов + "\1c\" + КаталогШаблоновКонфигурации, ТекРедакция + "*");
	
	ПоследняяСборка = -1;
	Результат = "";
	
	Для Каждого Каталог Из КаталогиРедакции Цикл
		Если Не Каталог.ЭтоКаталог() Тогда
			Продолжить
		КонецЕсли;
		
		НомерРелизаСборки = Сред(Каталог.Имя, ПозНомераРелиза);
		П = Найти(НомерРелизаСборки, "_");
		Если П = 0 Тогда
			Продолжить
		КонецЕсли;
		
		Сборка = Число(Лев(НомерРелизаСборки, П - 1)) * 1000 + Число(Сред(НомерРелизаСборки, П + 1));
		
		Если Сборка > ПоследняяСборка Тогда
			ПоследняяСборка = Сборка;
			Результат = Каталог.ПолноеИмя;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции // ПолучитьКаталогШаблонов()

Процедура УстановитьОпциюВеденияУчетаПоОрганизациям() Экспорт
	
	ЭтоБазоваяВерсияКонфигурации = СтандартныеПодсистемыСервер.ЭтоБазоваяВерсияКонфигурации();
	
	УчетПоОрганизациям = НЕ ЭтоБазоваяВерсияКонфигурации ИЛИ Справочники.Организации.КоличествоОрганизаций() > 1;
	
	УстановитьПривилегированныйРежим(Истина);
	
	ВестиУчетПоОрганизациям = Константы.ИспользоватьНесколькоОрганизаций.СоздатьМенеджерЗначения();
	ВестиУчетПоОрганизациям.Значение = УчетПоОрганизациям;
	ВестиУчетПоОрганизациям.ОбменДанными.Загрузка = Истина;
	ВестиУчетПоОрганизациям.Записать();
	
	НеВестиУчетПоОрганизациям = Константы.НеИспользоватьНесколькоОрганизаций.СоздатьМенеджерЗначения();
	НеВестиУчетПоОрганизациям.Значение = НЕ УчетПоОрганизациям;
	НеВестиУчетПоОрганизациям.ОбменДанными.Загрузка = Истина;
	НеВестиУчетПоОрганизациям.Записать();
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры   

