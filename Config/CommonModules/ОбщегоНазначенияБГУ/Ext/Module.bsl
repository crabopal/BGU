	НастройкиМеханизма.ИменаКоманд.Вставить(ОбозначениеКоманды, ИмяКоманды);
	
	НоваяКоманда = Форма.Команды.Добавить(ИмяКоманды);
	НоваяКоманда.Действие		= "Подключаемый_МеханизмГолосованияКомиссии_КомандаСохранитьРезультатыГолосования";
	НоваяКоманда.Заголовок		= НСтр("ru='Сохранить результаты'");
	НоваяКоманда.Подсказка		= НСтр("ru='Сохранить результаты голосования выбранного сотрудника'");
