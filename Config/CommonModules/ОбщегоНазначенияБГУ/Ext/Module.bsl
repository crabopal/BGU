Процедура МеханизмГолосованияКомиссии_ИнициализироватьФормуДокумента(Знач Форма,
	Знач ИмяТабличнойЧасти,
	Знач ЭлементПанелиГолосования,
	Знач ЭлементМенюУстановитьРешение,
	Знач ЭлементГруппыКолонокГолосования) Экспорт
	
	ИмяРеквизитаНастроек = "НастройкиМеханизмаГолосованияКомиссии";
	
	НастройкиМеханизма = Новый Структура();
	НастройкиМеханизма.Вставить("ИменаРеквизитов",			Новый Структура());
	НастройкиМеханизма.Вставить("ИменаКолонок",				Новый Структура());
	НастройкиМеханизма.Вставить("ИменаЭлементов",			Новый Структура());
	НастройкиМеханизма.Вставить("ИменаЭлементовКолонок",	Новый Структура());
	НастройкиМеханизма.Вставить("ИменаКоманд",				Новый Структура());
	НастройкиМеханизма.Вставить("ИмяТабличнойЧасти",		ИмяТабличнойЧасти);
	НастройкиМеханизма.Вставить("ЕстьПравоЗаписиРезультатовГолосования",	Пользователи.РолиДоступны("ДобавлениеИзменениеРезультатовГолосования,ПолныеПрава"));
	НастройкиМеханизма.Вставить("ЕстьПравоПрисоединенияФайлов",				Пользователи.РолиДоступны("ДобавлениеИзменениеПапокИФайлов,ПолныеПрава"));

	
	// Реквизиты формы
	МеханизмГолосованияКомиссии_ДобавитьРеквизитыФормы(Форма, НастройкиМеханизма, ИмяРеквизитаНастроек);
	
	// Команды формы
	МеханизмГолосованияКомиссии_ДобавитьКомандыФормы(Форма, НастройкиМеханизма);
	
	// Элементы формы
	МеханизмГолосованияКомиссии_ДобавитьЭлементыФормы(Форма, ЭлементПанелиГолосования, ЭлементМенюУстановитьРешение, ЭлементГруппыКолонокГолосования, НастройкиМеханизма);
	
	// Обработчики событий элементов формы
	МеханизмГолосованияКомиссии_ДобавитьОбработчикиСобытийЭлементовФормы(Форма, НастройкиМеханизма);
	
	МеханизмГолосованияКомиссии_УстановитьУсловноеОформление(Форма, НастройкиМеханизма);
	
	Форма[ИмяРеквизитаНастроек] = НастройкиМеханизма;
	
	МеханизмГолосованияКомиссии_ЗаполнитьКолонкиТаблицы(Форма);
	
	МеханизмГолосованияКомиссии_НастроитьДоступностьЭлементов(Форма);
	
КонецПроцедуры

Процедура МеханизмГолосованияКомиссии_ПослеЗаписиНаСервере(Форма) Экспорт
	
	МеханизмГолосованияКомиссии_ЗаполнитьКолонкиТаблицы(Форма);
	
	МеханизмГолосованияКомиссии_НастроитьДоступностьЭлементов(Форма);
	
КонецПроцедуры

Процедура МеханизмГолосованияКомиссии_СотрудникПриИзменении_Сервер(Форма) Экспорт
	
	ИменаРеквизитов = Форма.НастройкиМеханизмаГолосованияКомиссии.ИменаРеквизитов;
	
	ИменаЭлементов = Форма.НастройкиМеханизмаГолосованияКомиссии.ИменаЭлементов;
	
	Сотрудник = Форма[ИменаРеквизитов.Сотрудник];
	
	МеханизмГолосованияКомиссии_ЗаполнитьКолонкиТаблицы(Форма);
	
	Форма[ИменаРеквизитов.ВыбранныйСотрудник] = Сотрудник;
	
	РаботаСФайламиБГУ.ПолучитьФайлСотрудника(
		Сотрудник,
		Форма,
		,
		ИменаРеквизитов.ФайлСотрудника,
		ИменаЭлементов.НадписьФайлНеВыбран,
		ИменаЭлементов.НадписьУдалитьФайл);
	
	МеханизмГолосованияКомиссии_НастроитьДоступностьЭлементов(Форма);
	
	ОбщегоНазначенияБГУКлиентСервер.МеханизмГолосованияКомиссии_УстановитьДоступностьКнопкиСохранитьРезультатыГолосования(Форма);
	
КонецПроцедуры	

Процедура МеханизмГолосованияКомиссии_СохранитьРезультатыГолосования(Форма, ДополнительныеПараметры) Экспорт
	
	Объект = Форма.Объект;
	
	Организация	= Объект.Организация;
	Комиссия	= Объект.Комиссия;
	Ссылка		= Объект.Ссылка;
	
	Сотрудник				= ДополнительныеПараметры.Сотрудник;
	РезультатыГолосования	= ДополнительныеПараметры.РезультатыГолосования;
	
	Если Ссылка.Пустая()
		ИЛИ Не ЗначениеЗаполнено(Комиссия)
		ИЛИ Не ЗначениеЗаполнено(Организация)
		ИЛИ Не ЗначениеЗаполнено(Сотрудник) Тогда
		Возврат;
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.РезультатыГолосованияКомиссий.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Организация.Установить(Организация);
	НаборЗаписей.Отбор.Комиссия.Установить(Комиссия);
	НаборЗаписей.Отбор.ДокументОснование.Установить(Ссылка);
	НаборЗаписей.Отбор.Сотрудник.Установить(Сотрудник);
	НаборЗаписей.Прочитать();
	Если НаборЗаписей.Количество() > 0 Тогда
		НаборЗаписей.Очистить();
	КонецЕсли;
	НаборЗаписей.Записывать = Истина;
	
	Для Каждого РезультатГолосования Из РезультатыГолосования Цикл
		
		Если Не ЗначениеЗаполнено(РезультатГолосования.РешениеСотрудникаПоРезолюции) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.Организация = Организация;
		НоваяЗапись.Комиссия = Комиссия;
		НоваяЗапись.Сотрудник = Сотрудник;
		НоваяЗапись.ДокументОснование = Ссылка;
		НоваяЗапись.ИдентификаторСтроки = РезультатГолосования.ИдентификаторСтроки;
		НоваяЗапись.РезультатГолосования = РезультатГолосования.РешениеСотрудникаПоРезолюции;
		
	КонецЦикла;
	
	НаборЗаписей.Записать(Истина);
	
	ОбщегоНазначенияБГУКлиентСервер.МеханизмГолосованияКомиссии_УстановитьПризнакМодифицированностиРешенияСотрудника(Форма, Ложь);
	
	МеханизмГолосованияКомиссии_НастроитьДоступностьЭлементов(Форма);
	
	МеханизмГолосованияКомиссии_ЗаполнитьКолонкиТаблицы(Форма);
	
КонецПроцедуры

Процедура МеханизмГолосованияКомиссии_СохранитьРезультатыГолосования_ПередЗаписьюНаСервере(Форма) Экспорт
	
	НастройкиМеханизма = Форма.НастройкиМеханизмаГолосованияКомиссии;
	
	ИменаРеквизитов = НастройкиМеханизма.ИменаРеквизитов;
	
	Если Не Форма[ИменаРеквизитов.РешениеСотрудникаМодифицированность] Тогда
		Возврат;
	КонецЕсли;
	
	Сотрудник = Форма[ИменаРеквизитов.Сотрудник];
	
	ТабличнаяЧасть = Форма.Объект[НастройкиМеханизма.ИмяТабличнойЧасти];
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Форма", Форма);
	ДопПараметры.Вставить("Сотрудник", Сотрудник);
	ДопПараметры.Вставить("РезультатыГолосования", ОбщегоНазначенияБГУКлиентСервер.МеханизмГолосованияКомиссии_ПолучитьРезультатыГолосованияСотрудника(ТабличнаяЧасть));
	
	ОбщегоНазначенияБГУ.МеханизмГолосованияКомиссии_СохранитьРезультатыГолосования(Форма, ДопПараметры);
	
	ОбщегоНазначенияБГУКлиентСервер.МеханизмГолосованияКомиссии_УстановитьПризнакМодифицированностиРешенияСотрудника(Форма, Ложь);
	
	ОбщегоНазначенияБГУКлиентСервер.МеханизмГолосованияКомиссии_УстановитьДоступностьКнопкиСохранитьРезультатыГолосования(Форма);
	
КонецПроцедуры

