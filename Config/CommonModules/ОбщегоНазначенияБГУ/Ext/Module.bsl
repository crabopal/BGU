				Если РассчитатьСписанияВОбеихТаблицахВРазмереСоответствия Тогда
					НоваяСтрока = ТаблицаСписанияВОбеихТаблицахВРазмереСоответствия.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы2,,СлужебныеКолонки_ТаблицаСписанияВОбеихТаблицахВРазмереСоответствия["ИменаСовпадающихСлужебныхКолонокСтрока"]);
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы1,,СлужебныеКолонки_ТаблицаСписанияВОбеихТаблицахВРазмереСоответствия["ИменаСовпадающихСлужебныхКолонокСтрока"]);
					ЗаполнитьЗначенияСвойств(НоваяСтрока, ПустыеЗначенияВсехПоказателей);
					НоваяСтрока[ИмяКолонкиПоказателя] = ВеличинаСписания;
					
					// Служебные колонки
					ИмяКолонкиСписаноПолностью	= СлужебныеКолонки_ТаблицаСписанияВОбеихТаблицахВРазмереСоответствия["СписаноПолностью"][ИмяКолонкиПоказателя];
					ИмяКолонкиСписаноЧастично	= СлужебныеКолонки_ТаблицаСписанияВОбеихТаблицахВРазмереСоответствия["СписаноЧастично"][ИмяКолонкиПоказателя];
					СписаноПолностью			= (СтрокаТаблицы1[ИмяКолонкиОстаток] = 0 И СтрокаТаблицы2[ИмяКолонкиОстаток] = 0) И (НЕ ВеличинаСписания = 0);
					СписаноЧастично				= НЕ (СтрокаТаблицы1[ИмяКолонкиОстаток] = 0 И СтрокаТаблицы2[ИмяКолонкиОстаток] = 0) И НЕ(ВеличинаСписания = 0);
					ИмяКолонкиИндексСтроки1		= СлужебныеКолонкиИтогов_ТаблицаСписанияВОбеихТаблицахВРазмереСоответствия["ИндексСтроки1"];
					ИмяКолонкиИндексСтроки2		= СлужебныеКолонкиИтогов_ТаблицаСписанияВОбеихТаблицахВРазмереСоответствия["ИндексСтроки2"];
					НоваяСтрока[ИмяКолонкиСписаноПолностью]	= СписаноПолностью;
					НоваяСтрока[ИмяКолонкиСписаноЧастично]	= СписаноЧастично;
					НоваяСтрока[ИмяКолонкиИндексСтроки1]	= Таблица1.Индекс(СтрокаТаблицы1);
					НоваяСтрока[ИмяКолонкиИндексСтроки2]	= Таблица2.Индекс(СтрокаТаблицы2);
					
					ИмяКолонкиСписаноПолностьюВТаблице1					= СлужебныеКолонки_ТаблицаСписанияВОбеихТаблицахВРазмереСоответствия["СписаноПолностьюВТаблице1"][ИмяКолонкиПоказателя];;
					НоваяСтрока[ИмяКолонкиСписаноПолностьюВТаблице1]	= (СтрокаТаблицы1[ИмяКолонкиОстаток] = 0 И ВеличинаСписания <> 0);
				КонецЕсли;
				Если РассчитатьСписанияВОбеихТаблицахПолностьюТаблица1ИПервыеСтрокиТаблицы2 Тогда
					Если НЕ ЗаполненаПерваяСтрока Тогда
						ЗаполнитьЗначенияСвойств(СтрокаТаблицыСписанияВОбеихТаблицахПолностьюТаблица1ИПервыеСтрокиТаблицы2, СтрокаТаблицы2, ИменаКопируемыхКолонокТаблицы2, ИменаВсехКолонокПоказателей);
						ЗаполненаПерваяСтрока = Истина;
					КонецЕсли;
				КонецЕсли;
				
				АнализироватьПоказатель = НЕ (Остаток_Таблица1 = 0);
			КонецЦикла;
			
			// Анализируемая таблица, флаги:
			ОбновитьФлагиВСтроке(
				СтрокаТаблицы1,
				СлужебныеКолонки_Таблица1,
				СлужебныеКолонкиИтогов_Таблица1,
				МассивИменКолонокПоказателей);
		КонецЦикла;
		
	КонецЦикла;
	
	// Настраиваем флаги в необработанных строках таблицы-эталона:
	Поиск = Новый Структура(СлужебныеКолонкиИтогов_Таблица2["СтрокаОбработана"], Ложь);
	МассивСтрокТаблицы2 = Таблица2.НайтиСтроки(Поиск);
	Для Каждого НеобработаннаяСтрока Из МассивСтрокТаблицы2 Цикл
		ОбновитьФлагиВСтроке(
			НеобработаннаяСтрока,
			СлужебныеКолонки_Таблица2,
			СлужебныеКолонкиИтогов_Таблица2,
			МассивИменКолонокПоказателей);
	КонецЦикла;
	
	// Возвращаемые сведения о результатах сравнения таблиц
	
	Результат = Новый Структура();
	Для Каждого ОбозначениеСведений Из МассивСведений Цикл
		
		Если ВРег(ОбозначениеСведений) = ВРег("ПревышенияТаблицы1НадТаблицей2") Тогда
			Сведения = ПолучитьСведения_ПревышенияТаблицы1НадТаблицей2(
				Таблица1,
				СлужебныеКолонки_Таблица1,
				СлужебныеКолонкиИтогов_Таблица1,
				МассивИменКолонокПоказателей);
			Результат.Вставить(ОбозначениеСведений, Сведения);
		КонецЕсли;
		
		Если ВРег(ОбозначениеСведений) = ВРег("СписанияВТаблице1ВРазмереСоответствия") Тогда
			Сведения = ПолучитьСведения_СписанияВТаблицеВРазмереСоответствия(
				Таблица1,
				СлужебныеКолонки_Таблица1,
				СлужебныеКолонкиИтогов_Таблица1,
				КолонкиТаблицы1,
				МассивИменКолонокПоказателей);
			Результат.Вставить(ОбозначениеСведений, Сведения);
		КонецЕсли;
		
		Если ВРег(ОбозначениеСведений) = ВРег("СписанияВТаблице2ВРазмереСоответствия") Тогда
			Сведения = ПолучитьСведения_СписанияВТаблицеВРазмереСоответствия(
				Таблица2,
				СлужебныеКолонки_Таблица2,
				СлужебныеКолонкиИтогов_Таблица2,
				КолонкиТаблицы2,
				МассивИменКолонокПоказателей);
			Результат.Вставить(ОбозначениеСведений, Сведения);
		КонецЕсли;
		
		Если ВРег(ОбозначениеСведений) = ВРег("СписанияВТаблице2ВРазмереТаблицы1") Тогда
			СведенияТаблицы1 = Новый Структура();
			СведенияТаблицы1.Вставить("Таблица",				Таблица1);
			СведенияТаблицы1.Вставить("СлужебныеКолонки",		СлужебныеКолонки_Таблица1);
			СведенияТаблицы1.Вставить("СлужебныеКолонкиИтогов",	СлужебныеКолонкиИтогов_Таблица1);
			СведенияТаблицы1.Вставить("КолонкиТаблицы",			КолонкиТаблицы1);
			
			СведенияТаблицы2 = Новый Структура();
			СведенияТаблицы2.Вставить("Таблица",				Таблица2);
			СведенияТаблицы2.Вставить("СлужебныеКолонки",		СлужебныеКолонки_Таблица2);
			СведенияТаблицы2.Вставить("СлужебныеКолонкиИтогов",	СлужебныеКолонкиИтогов_Таблица2);
			СведенияТаблицы2.Вставить("КолонкиТаблицы",			КолонкиТаблицы2);
			
			Сведения = ПолучитьСведения_СписанияВТаблице2ВРазмереТаблицы1(
				СведенияТаблицы1,
				СведенияТаблицы2,
				МассивИменКолонокПоказателей);
				
			Результат.Вставить(ОбозначениеСведений, Сведения);
		КонецЕсли;
		
		Если ВРег(ОбозначениеСведений) = ВРег("ОстаткиВТаблице1") Тогда
			Сведения = ПолучитьСведения_ОстаткиВТаблице(
				Таблица1,
				СлужебныеКолонки_Таблица1,
				СлужебныеКолонкиИтогов_Таблица1,
				КолонкиТаблицы1,
				МассивИменКолонокПоказателей);
			Результат.Вставить(ОбозначениеСведений, Сведения);
		КонецЕсли;
		
		Если ВРег(ОбозначениеСведений) = ВРег("ОстаткиВТаблице2") Тогда
			Сведения = ПолучитьСведения_ОстаткиВТаблице(
				Таблица2,
				СлужебныеКолонки_Таблица2,
				СлужебныеКолонкиИтогов_Таблица2,
				КолонкиТаблицы2,
				МассивИменКолонокПоказателей);
			Результат.Вставить(ОбозначениеСведений, Сведения);
		КонецЕсли;
		
		Если ВРег(ОбозначениеСведений) = ВРег("СписанияВОбеихТаблицахВРазмереСоответствия") Тогда
			Сведения = ПолучитьСведения_ТаблицаСписанияВОбеихТаблицахВРазмереСоответствия(
				ТаблицаСписанияВОбеихТаблицахВРазмереСоответствия,
				СлужебныеКолонки_ТаблицаСписанияВОбеихТаблицахВРазмереСоответствия,
				ИменаВсехКолонокКромеПоказателей,
				ИменаКолонокСуммирования);
			
			Результат.Вставить(ОбозначениеСведений, Сведения);
		КонецЕсли;
		
		Если ВРег(ОбозначениеСведений) = ВРег("ПолноеВзаимноеСписаниеПоказателей") Тогда
			Поиск = Новый Структура("СписаноПолностью", Истина);
			КоличествоСтрокСписаноПолностьюТаблица1 = Таблица1.НайтиСтроки(Поиск).Количество();
			КоличествоСтрокСписаноПолностьюТаблица2 = Таблица2.НайтиСтроки(Поиск).Количество();
			
			Сведения = (КоличествоСтрокСписаноПолностьюТаблица1 = Таблица1.Количество()
					И	КоличествоСтрокСписаноПолностьюТаблица2 = Таблица2.Количество());
			
			Результат.Вставить(ОбозначениеСведений, Сведения);
		КонецЕсли;
		
		Если ВРег(ОбозначениеСведений) = ВРег("СписанияВОбеихТаблицахПолностьюТаблица1ИПервыеСтрокиТаблицы2") Тогда
			Сведения = ТаблицаСписанияВОбеихТаблицахПолностьюТаблица1ИПервыеСтрокиТаблицы2;
			
			Результат.Вставить(ОбозначениеСведений, Сведения);
		КонецЕсли;
		
	КонецЦикла;
	
	// Удаляем служебные колонки, добавленные ранее:
	УдалитьСлужебныеКолонкиТаблицы(Таблица1,		СлужебныеКолонки_Таблица1);
	УдалитьСлужебныеКолонкиИтогоТаблицы(Таблица1,	СлужебныеКолонкиИтогов_Таблица1);
	УдалитьСлужебныеКолонкиТаблицы(Таблица2,		СлужебныеКолонки_Таблица2);
	УдалитьСлужебныеКолонкиИтогоТаблицы(Таблица2,	СлужебныеКолонкиИтогов_Таблица2);
	
	Возврат Результат;
	
КонецФункции

// Упорядочивает одну таблицу по другой (таблице порядка).
//
// Параметры:
//	Таблица					- ТаблицаЗначений	- упорядочиваемая таблица;
//	ТаблицаПорядка			- ТаблицаЗначений	- порядок строк в этой таблице
//		определяет порядок упорядочивания;
//  МассивИменКолонокСвязи	- Массив			- имена колонок связи,
//		по которым будет установлено соответствие строк в указанных таблицах.
//		Эти колонки должны присутствовать в обеих таблицах.
Процедура УпорядочитьТаблицуПоТаблицеПорядка(Таблица, Знач ТаблицаПорядка, Знач МассивИменКолонокСвязи) Экспорт
	
	// Входная проверка:
	// Проверяем наличие указанных колонок:
	ЕстьОтсутствующаяКолонка = Ложь;
	Для Каждого ИмяКолонки Из МассивИменКолонокСвязи Цикл
		Если Таблица.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
			ЕстьОтсутствующаяКолонка = Истина;
			Прервать;
		КонецЕсли;
		Если ТаблицаПорядка.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
			ЕстьОтсутствующаяКолонка = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ЕстьОтсутствующаяКолонка Тогда
		// Выходим:
		Возврат;
	КонецЕсли;
	
	КЧ = Новый КвалификаторыЧисла(6, 0, ДопустимыйЗнак.Неотрицательный);
	ТипНомерСтроки	= Новый ОписаниеТипов("Число", КЧ);
	
	ИмяДобавленнойКолонкиМладшийНомерСтроки	= ДобавитьКолонкуВТаблицу(Таблица, "МладшийНомерСтроки", ТипНомерСтроки);
	ИмяДобавленнойКолонкиСтаршийНомерСтроки	= ДобавитьКолонкуВТаблицу(Таблица, "СтаршийНомерСтроки", ТипНомерСтроки);
	
	// Структура для поиска по таблицам:
	ИменаКолонокСвязи = СтрСоединить(МассивИменКолонокСвязи, ",");
	Поиск = Новый Структура(ИменаКолонокСвязи);
	
	НаибольшийСтаршийНомерСтроки = ТаблицаПорядка.Количество() + 1;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаТаблицы);
		СтрокаТаблицыПорядка = НайтиПервуюСтрокуТаблицы(ТаблицаПорядка, Поиск);
		Если СтрокаТаблицыПорядка = Неопределено Тогда
			СтаршийНомерСтроки = НаибольшийСтаршийНомерСтроки;
		Иначе
			СтаршийНомерСтроки = ТаблицаПорядка.Индекс(СтрокаТаблицыПорядка) + 1;
		КонецЕсли;
		МладшийНомерСтроки = Таблица.Индекс(СтрокаТаблицы) + 1;
		СтрокаТаблицы[ИмяДобавленнойКолонкиМладшийНомерСтроки] = МладшийНомерСтроки;
		СтрокаТаблицы[ИмяДобавленнойКолонкиСтаршийНомерСтроки] = СтаршийНомерСтроки;
	КонецЦикла;
	
	Таблица.Сортировать(ИмяДобавленнойКолонкиСтаршийНомерСтроки + " возр,"
		+ ИмяДобавленнойКолонкиМладшийНомерСтроки + " возр");
		
	Таблица.Колонки.Удалить(ИмяДобавленнойКолонкиМладшийНомерСтроки);
	Таблица.Колонки.Удалить(ИмяДобавленнойКолонкиСтаршийНомерСтроки);
	
КонецПроцедуры

Процедура УпорядочитьТаблицуПоДокументу(ТаблицаЗначений, КолонкаДокумента, КолонкаДаты, Направление = "Возр") Экспорт

	Если ТаблицаЗначений.Колонки.Найти(КолонкаДаты) = Неопределено Тогда
		ТаблицаЗначений.Колонки.Добавить(КолонкаДаты, ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповДаты(ЧастиДаты.ДатаВремя));
	КонецЕсли;
	
	Если ТаблицаЗначений.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьДатуДокументаКРезультатуЗапроса(ТаблицаЗначений, КолонкаДокумента, КолонкаДаты);
	
	СписокКолонок = КолонкаДаты + " " + Направление + ", " + КолонкаДокумента + " " + Направление;
	ТаблицаЗначений.Сортировать(СписокКолонок, Новый СравнениеЗначений);
	
КонецПроцедуры

Процедура ДобавитьДатуДокументаКРезультатуЗапроса(Результат, КолонкаДокумента, КолонкаСДатой) Экспорт

	КэшПоТипам = Новый Соответствие;
	
	Для каждого СтрокаТаблицы из Результат Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы[КолонкаДокумента]) тогда
			Продолжить;
		КонецЕсли;
		
		ТипЗначенияКолонки = ТипЗнч(СтрокаТаблицы[КолонкаДокумента]);
		ИмяМетаданных      = Метаданные.НайтиПоТипу(ТипЗначенияКолонки).Имя;
		Если Метаданные.Документы.Найти(ИмяМетаданных) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		МассивТипа = КэшПоТипам[ИмяМетаданных];
		Если МассивТипа = Неопределено Тогда
			МассивТипа = Новый Массив;
			КэшПоТипам.Вставить(ИмяМетаданных, МассивТипа);
		КонецЕсли;
		МассивТипа.Добавить(СтрокаТаблицы[КолонкаДокумента]);
		
	КонецЦикла;
	
	Если КэшПоТипам.Количество()=0 тогда
		Возврат;
	КонецЕсли;
	
	Запрос = новый Запрос;
	
	Для Каждого КлючИЗначение ИЗ КэшПоТипам Цикл
		
		Запрос.Текст = Запрос.Текст+
		?(Запрос.Текст="","",
		"
		|Объединить все")+
		"
		|	ВЫБРАТЬ
		|		Док.Ссылка Как Ссылка,
		|		Док.Дата
		|	ИЗ Документ."+КлючИЗначение.Ключ+" КАК Док
		|	Где Док.ссылка в  (&ДокументыТипа_"+КлючИЗначение.Ключ+")";
		УдалитьПовторяющиесяЭлементыМассива(КлючИЗначение.Значение);
		Запрос.УстановитьПараметр("ДокументыТипа_"+КлючИЗначение.Ключ, КлючИЗначение.Значение);
		
	КонецЦикла;
	
	Результат.Индексы.Добавить(КолонкаДокумента);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить(КолонкаДокумента, Выборка.Ссылка);
		
		НайденныеСтроки = Результат.НайтиСтроки(ПараметрыОтбора);
		Для Каждого Строка ИЗ НайденныеСтроки Цикл
			Строка[КолонкаСДатой] = Выборка.Дата;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

// Распределяет сумму по указанной колонке таблицы (по всем строкам) пропорционально базе.
//
Процедура РаспределитьСуммуПоКолонкеТаблицы(РаспределяемаяСумма, Таблица, ИмяКолонки, ИмяКолонкиБазы = "") Экспорт

	ИмяКолонкиБазы = ?(ПустаяСтрока(ИмяКолонкиБазы), ИмяКолонки, ИмяКолонкиБазы);
	
	Если РаспределяемаяСумма <> 0 Тогда
		
		БазаРаспределения = Таблица.ВыгрузитьКолонку(ИмяКолонкиБазы);
		
		МассивНовыхСумм = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
			РаспределяемаяСумма, БазаРаспределения);
		Если МассивНовыхСумм <> Неопределено Тогда
			Таблица.ЗагрузитьКолонку(МассивНовыхСумм, ИмяКолонки);
		КонецЕсли;
		
	Иначе
		Таблица.ЗаполнитьЗначения(0, ИмяКолонки);
	КонецЕсли;

КонецПроцедуры

// Распределяет сумму по выбранным строкам таблицы пропорционально базе.
//
Процедура РаспределитьСуммуПоСтрокамТаблицы(РаспределяемаяСумма, СтрокиТаблицы, ИмяКолонки, ИмяКолонкиБазы = "", ОчиститьКолонку = Истина) Экспорт

	Если СтрокиТаблицы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ИмяКолонкиБазы = ?(ПустаяСтрока(ИмяКолонкиБазы), ИмяКолонки, ИмяКолонкиБазы);
	
	БазаРаспределения = Новый Массив;
	Для Каждого СтрокаТаблицы Из СтрокиТаблицы Цикл
		БазаРаспределения.Добавить(СтрокаТаблицы[ИмяКолонкиБазы]);
	КонецЦикла;
	
	МассивНовыхСумм = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
		РаспределяемаяСумма, БазаРаспределения);
	
	Для Инд = 0 По СтрокиТаблицы.Количество() - 1 Цикл
		
		СтрокаТаблицы = СтрокиТаблицы[Инд];
		НоваяСумма = ?(МассивНовыхСумм = Неопределено, 0, МассивНовыхСумм[Инд]);
		
		Если ОчиститьКолонку Тогда
			СтрокаТаблицы[ИмяКолонки] = НоваяСумма;
		Иначе
			СтрокаТаблицы[ИмяКолонки] = СтрокаТаблицы[ИмяКолонки] + НоваяСумма;
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

// Сворачивает таблицу значений по всем колонкам, суммируя значения в указанных колонках суммирования.
//
Процедура СвернутьТаблицуИСуммироватьКолонки(Таблица, КолонкиСуммирования) Экспорт
	
	КолонкиГруппировок = "";
	Для Каждого Колонка Из Таблица.Колонки Цикл
		Если Найти(КолонкиСуммирования, Колонка.Имя) = 0 Тогда
			КолонкиГруппировок = КолонкиГруппировок + ?(ПустаяСтрока(КолонкиГруппировок), "", ",") + Колонка.Имя;
		КонецЕсли;
	КонецЦикла;
	
	Таблица.Свернуть(КолонкиГруппировок, КолонкиСуммирования);
	
КонецПроцедуры

// Формирует таблицу значений из табличного документа
//
// Параметры:
//	ТаблицаИлиПуть - Табличный документ, строка, содержащая путь к макету табличного документа
//                   Передаваемая строка должна содержать полный путь к макету,
//                   например: "Справочник.ВидыВыплатНаКартыМИР.ВидыВыплат".
//                   для общего макета - имя макета, например "КодыКБК"
//					 Первая строка табличного документа должна содержать наименования колонок	
//
// Возвращаемое значение:
//	Таблица значений с колонками, определенными первой строкой табличного документа
//
Функция ТаблицаЗначенийИзТабличногоДокументв(Знач ТаблицаИлиПуть) Экспорт  
	
	ТаблицаРезультат = Новый ТаблицаЗначений;
	
	Если ТипЗнч(ТаблицаИлиПуть) = Тип("ТабличныйДокумент") Тогда
		ТаблицаДляОбработки = ТаблицаИлиПуть;
	Иначе
		ЧастиПути = СтрРазделить(ТаблицаИлиПуть, ".");
		Если НЕ ЧастиПути.Количество() = 1 И НЕ ЧастиПути.Количество() = 3 Тогда
			Возврат ТаблицаРезультат;
		КонецЕсли;
		Если ЧастиПути.Количество() = 1 Тогда
			ТаблицаДляОбработки = ПолучитьОбщийМакет(ЧастиПути[0]);
		Иначе
			МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ЧастиПути[0] + "." + ЧастиПути[1]);
			ТаблицаДляОбработки = МенеджерОбъекта.ПолучитьМакет(ЧастиПути[2]);
		КонецЕсли;
	КонецЕсли;
	
	ТипСтрока = ПолучитьОписаниеТиповСтроки(0);

	Для ИндКол = 1 По ТаблицаДляОбработки.ШиринаТаблицы Цикл
		ТаблицаРезультат.Колонки.Добавить(ТаблицаДляОбработки.Область("R1C" + ИндКол).Текст, ТипСтрока);
	КонецЦикла;
	
	Для ИндСтр = 2 По ТаблицаДляОбработки.ВысотаТаблицы Цикл
		НоваяСтрока = ТаблицаРезультат.Добавить();
		Для ИндКол = 1 По ТаблицаДляОбработки.ШиринаТаблицы Цикл
			НоваяСтрока[ИндКол - 1] = ТаблицаДляОбработки.Область("R" + ИндСтр + "C" + ИндКол).Текст;
		КонецЦикла;
	КонецЦикла;

	Возврат ТаблицаРезультат;
	
КонецФункции

#КонецОбласти

#Область ПроцедурыВерсионированияОбъектов

// см. ВерсионированиеОбъектовПереопределяемый.ПриПодготовкеДанныхОбъекта
//
// Параметры:
//  Объект - ДокументОбъект - версионируемый объект:
//  ДополнительныеРеквизиты - ТаблицаЗначений - коллекция дополнительных реквизитов, которые требуется сохранить вместе
//                                              с версией объекта:
//   * Идентификатор - Произвольный - уникальный идентификатор реквизита. Требуется при восстановлении из версии
//                                    объекта в случае, когда значение реквизита хранится отдельно от объекта.
//   * Наименование - Строка - название реквизита.
//   * Значение - Произвольный - значение реквизита.
//
Процедура ПриПодготовкеДанныхОбъекта(Объект, ДополнительныеРеквизиты) Экспорт  
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьОтдельнуюДатуПроведенияДокументов") 
		И Метаданные.ОпределяемыеТипы.ДокументыСОтдельнойДатойПроведения.Тип.СодержитТип(ТипЗнч(Объект.Ссылка)) Тогда 
		Если Объект.ДополнительныеСвойства.Свойство("ОтдельнаяДатаПроведения") Тогда
			ДатаПроведения = Объект.ДополнительныеСвойства.ОтдельнаяДатаПроведения;
		Иначе  
			ДатаПроведения = БухгалтерскийУчет.УстановленнаяДатаПроведения(Объект.Ссылка); 
		КонецЕсли;
		Реквизит = ДополнительныеРеквизиты.Добавить(); 
		Реквизит.Идентификатор = "ДатаПроведения";
		Реквизит.Наименование = "Дата проведения";
		Реквизит.Значение = ?(ЗначениеЗаполнено(ДатаПроведения), ДатаПроведения, Объект.Дата); 
	КонецЕсли; 
	
КонецПроцедуры 

// см. ВерсионированиеОбъектовПереопределяемый.ПриВосстановленииВерсииОбъект
//
// Параметры:
//  Объект - Объект - версионируемый объект.
//  ДополнительныеРеквизиты - ТаблицаЗначений - коллекция дополнительных реквизитов, которые были сохранены вместе с
//                                              версией объекта:
//   * Идентификатор - Произвольный - уникальный идентификатор реквизита.
//   * Наименование - Строка - название реквизита.
//   * Значение - Произвольный - значение реквизита.
Процедура ПриВосстановленииВерсииОбъекта(Объект, ДополнительныеРеквизиты) Экспорт   
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьОтдельнуюДатуПроведенияДокументов") 
		И Метаданные.ОпределяемыеТипы.ДокументыСОтдельнойДатойПроведения.Тип.СодержитТип(ТипЗнч(Объект.Ссылка)) Тогда
		ОтдельнаяДатаПроведения = ДополнительныеРеквизиты.Найти("ДатаПроведения", "Идентификатор");
		Если ОтдельнаяДатаПроведения  = Неопределено Тогда
			// Нет отдельной даты проведения, ничего делать не требуется.
			Возврат; 
		КонецЕсли;
		ЗаписьДаты = РегистрыСведений.ДатыПроведенияДокументов.СоздатьМенеджерЗаписи();
		ЗаписьДаты.Документ = Объект.Ссылка;
		ЗаписьДаты.ДатаПроведения = ОтдельнаяДатаПроведения.Значение; 
		ЗаписьДаты.Записать(Истина);
	КонецЕсли;

КонецПроцедуры
 
#КонецОбласти

#Область УчетПоИФО

// Устанавливает пустую ссылку в ИФО в регистрах накопления и регистре бухгалтерии.
// Вызывается через подситему ДлительныеОперации при изменении константы в форме НастройкаПараметровУчета.
// 
// Параметры:
// 	ПараметрыПроцедуры - Структура - не используется
// 	АдресРезультата - Строка - не используется
Процедура ОтключитьУчетПоИФОВФоне(ПараметрыПроцедуры, АдресРезультата) Экспорт
	
	НачатьТранзакцию();
	Попытка
		
		Блокировка = Новый БлокировкаДанных;
		Блокировка.Добавить("Константа.ИспользоватьУчетПоИФО");
		Блокировка.Заблокировать();
		
		СоответствиеРегистров = Новый Соответствие;
		ОпределитьОбрабатываемыеРегистрыКоллекцииРегистров(СоответствиеРегистров, Метаданные.РегистрыБухгалтерии);
		ОпределитьОбрабатываемыеРегистрыКоллекцииРегистров(СоответствиеРегистров, Метаданные.РегистрыНакопления);
		Для Каждого КлючИЗначение Из СоответствиеРегистров Цикл
			ОчиститьИФОРегистра(КлючИЗначение.Ключ,КлючИЗначение.Значение)
		КонецЦикла;
		Константы.ИспользоватьУчетПоИФО.Установить(Ложь);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Отключение учета по ИФО'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;		
	КонецПопытки;
	
КонецПроцедуры

Процедура ОчиститьИФОПередЗаписьюНабораЗаписейПередЗаписью(Источник, Отказ, РежимЗаписи) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		Возврат;
	КонецЕсли;
	
	МассивПолей = ОбщегоНазначенияБГУПовтИсп.ОпределитьМассивПолейИФО(Источник.Метаданные().Имя);
	Если МассивПолей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПустойИФО = Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка();
	Для Каждого ТекЗапись ИЗ Источник Цикл
		Для Каждого ТекПоле Из МассивПолей Цикл
			ТекЗапись[ТекПоле] = ПустойИФО;
		КонецЦикла;		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

 #Область ОтключениеУчетаВалютИПодразделенийНаСчетах

// Устанавливает Null в валюту и валютную сумму в регистре бухгалтерии у всех не валютных счетов.
// Вызывается через подситему ДлительныеОперации при изменении константы в форме НастройкаПараметровУчета.
// 
// Параметры:
// 	ПараметрыПроцедуры - Структура - не используется
// 	АдресРезультата - Строка - не используется
Процедура ОтключитьВалютныйУчетВФоне(ПараметрыПроцедуры, АдресРезультата) Экспорт
	
	ЗапросСчета = СчетаСИзмененнымВалютнымУчетом();
	
	ИзменяемыеСчета = ЗапросСчета.Выгрузить().ВыгрузитьКолонку("Ссылка");
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрБухгалтерии.ЖурналПроводокЕПСБУ");
		ЭлементБлокировки.ИсточникДанных = ЗапросСчета;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Счет", "Ссылка");
		ЭлементБлокировки = Блокировка.Добавить("Константа.ИспользоватьВалютныйУчет");
		Блокировка.Заблокировать();
	
		Если ИзменяемыеСчета.Количество() > 0 Тогда
			РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.ОчиститьИзмерениеПоПризнакуУчета(ИзменяемыеСчета, "Валютный", Null);
			ОтключитьПризнакВалютныйВСчетах(ИзменяемыеСчета);
		КонецЕсли;
		Константы.ИспользоватьВалютныйУчет.Установить(Ложь);
		ЗафиксироватьТранзакцию();
	Исключение	
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Отключение валютного учета'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;		
	КонецПопытки;
	
КонецПроцедуры

// Устанавливает пустую ссылку в Подразделение в регистре бухгалтерии у всех счетов с учетом по подразделениям.
// Вызывается через подситему ДлительныеОперации при изменении константы в форме НастройкаПараметровУчета.
// 
// Параметры:
// 	ПараметрыПроцедуры - Структура - не используется
// 	АдресРезультата - Строка - не используется
Процедура ОтключитьУчетПоПодразделениямВФоне(ПараметрыПроцедуры, АдресРезультата) Экспорт
	
	ЗапросСчета = СчетаСУчетомПоПодразделениям();
	ИзменяемыеСчета = ЗапросСчета.Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	НачатьТранзакцию();
	Попытка
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрБухгалтерии.ЖурналПроводокЕПСБУ");
		ЭлементБлокировки.ИсточникДанных = ЗапросСчета;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Счет", "Ссылка");
		ЭлементБлокировки = Блокировка.Добавить("Константа.ИспользоватьУчетПоПодразделениям");
		Блокировка.Заблокировать();
		
		Если ИзменяемыеСчета.Количество() > 0 Тогда
			РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.ОчиститьИзмерениеПоПризнакуУчета(ИзменяемыеСчета,
				"УчетПоПодразделениям", Справочники.Подразделения.ПустаяСсылка());
		КонецЕсли;
		РегистрыНакопления.СтоимостьОбъектовОС.ОчиститьПодразделение();
		Константы.ИспользоватьУчетПоПодразделениям.Установить(Ложь);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти 

#Область МеханизмГолосованияКомиссии

// Устанавливает условное оформление таблицы СоставКомиссии:
// - вывод текста "Выбрать файл", "Удалить файл".
// - видимость колонок с текстом удаления и выбора файла
// - обязательность причины отсутствия, если указано отсутствие.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
Процедура УстановитьУсловноеОформлениеКомиссии(Форма) Экспорт
	
	УсловноеОформление = Форма.УсловноеОформление;
	Элементы = Форма.Элементы;
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, Элементы.СоставКомиссииФайлОсобогоМненияОтсутствует.Имя);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.СоставКомиссии.Отсутствует", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);

	ЭлементУО = УсловноеОформление.Элементы.Добавить();
