//
Функция УдалитьПовторяющиесяЭлементыМассива(МассивЭлементов) Экспорт
	
	Возврат ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивЭлементов);
	
		
КонецФункции

// Устарела. Используется для совместимости с БГУ ред. 1.0
// Следует использовать ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива
//
Процедура УдалитьНепроверяемыеРеквизитыИзМассива(МассивРеквизитов, МассивНепроверяемыхРеквизитов) Экспорт

	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(МассивРеквизитов, МассивНепроверяемыхРеквизитов);
	
КонецПроцедуры

//устарела. см. ЗаполнениеРеквизитовОбъектов.ОрганизацияПоУмолчанию()
Функция ПолучитьОсновнуюОрганизациюТекущегоПользователя() Экспорт
	
	ОсновнаяОрганизация = Справочники.Организации.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Организации.Ссылка
	|ПОМЕСТИТЬ РазрешенныеОрганизации
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.ПометкаУдаления = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РазрешенныеОрганизации.Ссылка
	|ИЗ
	|	РазрешенныеОрганизации КАК РазрешенныеОрганизации";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() = 1 И Выборка.Следующий() Тогда
		
		ОсновнаяОрганизация = Выборка.Ссылка;
		
	Иначе
		
		ТекущийПользователь = Пользователи.АвторизованныйПользователь();
		ОрганизацияИзХранилищаОбщихНастроек = ХранилищеОбщихНастроек.Загрузить("ТЕКУЩАЯОРГАНИЗАЦИЯ",,, ТекущийПользователь);
		
		Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	РазрешенныеОрганизации.Ссылка КАК ОрганизацияКонстанты,
		|	NULL КАК ОрганизацияНастройки,
		|	NULL КАК Организация
		|ПОМЕСТИТЬ вт
		|ИЗ
		|	РазрешенныеОрганизации КАК РазрешенныеОрганизации,
		|	Константа.ОсновнаяОрганизация КАК ОсновнаяОрганизация
		|ГДЕ
		|	РазрешенныеОрганизации.Ссылка = ОсновнаяОрганизация.Значение
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	NULL,
		|	РазрешенныеОрганизации.Ссылка,
		|	NULL
		|ИЗ
		|	РазрешенныеОрганизации КАК РазрешенныеОрганизации,
		|	РегистрСведений.ПерсональныеНастройки КАК ПерсональныеНастройки
		|ГДЕ
		|	ПерсональныеНастройки.Пользователь = &Пользователь
		|	И ПерсональныеНастройки.Настройка = &Настройка
		|	И РазрешенныеОрганизации.Ссылка = ПерсональныеНастройки.ЗначениеНастройки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	NULL,
		|	NULL,
		|	РазрешенныеОрганизации.Ссылка
		|ИЗ
		|	РазрешенныеОрганизации КАК РазрешенныеОрганизации
		|ГДЕ
		|	РазрешенныеОрганизации.Ссылка = &ОрганизацияИзХранилищаОбщихНастроек
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МАКСИМУМ(вт.ОрганизацияКонстанты) КАК ОрганизацияКонстанты,
		|	МАКСИМУМ(вт.ОрганизацияНастройки) КАК ОрганизацияНастройки,
		|	МАКСИМУМ(вт.Организация) КАК Организация
		|ИЗ
		|	вт КАК вт";
		Запрос.УстановитьПараметр("Пользователь", ТекущийПользователь);
		Запрос.УстановитьПараметр("Настройка", ПланыВидовХарактеристик.ПерсональныеНастройки.ОсновнаяОрганизация);
		Запрос.УстановитьПараметр("ОрганизацияИзХранилищаОбщихНастроек", ОрганизацияИзХранилищаОбщихНастроек);
		УстановитьПривилегированныйРежим(Истина);
		Результат = Запрос.Выполнить();
		Если НЕ Результат.Пустой() Тогда
			Выборка = Результат.Выбрать();
			Выборка.Следующий();
			Если ЗначениеЗаполнено(Выборка.ОрганизацияНастройки) Тогда
				ОсновнаяОрганизация = Выборка.ОрганизацияНастройки;
			ИначеЕсли ЗначениеЗаполнено(Выборка.ОрганизацияКонстанты) Тогда
				ОсновнаяОрганизация = Выборка.ОрганизацияКонстанты;
			ИначеЕсли ЗначениеЗаполнено(Выборка.Организация) Тогда
				ОсновнаяОрганизация = Выборка.Организация;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ОсновнаяОрганизация;
	
КонецФункции

// Устарела. Следует использовать ПервичныеДокументыБГУ.ДобавитьУсловиеКомандыПечати
// Добавить условие команды печати по виду первичного документа.
// 
// Параметры:
//  КомандаПечати - СтрокаТаблицыЗначений: см. УправлениеПечатью.СоздатьКоллекциюКомандПечати
//  РазрешитьСДокументомКонтрагента - Булево - Форма используется если выбрано значение "ДокументКонтрагента"
Процедура ДобавитьУсловиеКомандыПечатиПоВидуПервичногоДокумента(КомандаПечати, РазрешитьСДокументомКонтрагента = Ложь) Экспорт
	
	ИдентификаторПечатнойФормы = "";
	Если КомандаПечати.ДополнительныеПараметры.Свойство("ВидПервичногоДокумента") Тогда
		ИдентификаторПечатнойФормы = КомандаПечати.Идентификатор;
	КонецЕсли;
	
	ДобавитьУсловиеКомандыПечатиИдентификаторПечатнойФормы(КомандаПечати, ИдентификаторПечатнойФормы, РазрешитьСДокументомКонтрагента);
	
КонецПроцедуры

// Устарела. Следует использовать ПервичныеДокументыБГУ.ДобавитьУсловиеКомандыПечати
// Добавить условие команды печати идентификатор печатной формы.
// 
// Параметры:
//  КомандаПечати - СтрокаТаблицыЗначений: см. УправлениеПечатью.СоздатьКоллекциюКомандПечати
//  ИдентификаторПечатнойФормы - Строка - Идентификатор печатной формы
//  РазрешитьСДокументомКонтрагента - Булево - Форма используется если выбрано значение "ДокументКонтрагента"
Процедура ДобавитьУсловиеКомандыПечатиИдентификаторПечатнойФормы(КомандаПечати, ИдентификаторПечатнойФормы, РазрешитьСДокументомКонтрагента = Ложь) Экспорт

	ПервичныйДокумент = ПервичныеДокументыБГУ.НайтиПоИдентификатору(ИдентификаторПечатнойФормы);

	Условия = Новый СписокЗначений;
	Условия.Добавить(Справочники.ПервичныеДокументы.ПустаяСсылка());
	Если РазрешитьСДокументомКонтрагента Тогда
		Условия.Добавить(Справочники.ПервичныеДокументы.ПустаяСсылка());
	КонецЕсли;
	Если ЗначениеЗаполнено(ПервичныйДокумент) Тогда
		Условия.Добавить(ПервичныйДокумент);
	КонецЕсли;
	
	УправлениеПечатью.ДобавитьУсловиеВидимостиКоманды(КомандаПечати,
		"ПервичныйДокумент",
		Условия,
		ВидСравнения.ВСписке);
	
КонецПроцедуры

// Устарела. Следует использовать ПервичныеДокументыБГУ.УстановитьСвойстваКомандыПечати
// Установить вид первичного документа команды печати.
// 
// Параметры:
//  КомандаПечати - СтрокаТаблицыЗначений: см. УправлениеПечатью.СоздатьКоллекциюКомандПечати
//  ДобавитьУсловие - Булево - добавить условие видимости команды
//  РазрешитьСДокументомКонтрагента - Булево - Форма используется если выбрано значение "ДокументКонтрагента"
Процедура УстановитьВидПервичногоДокументаКомандыПечати(КомандаПечати, ДобавитьУсловие = Истина, РазрешитьСДокументомКонтрагента = Ложь) Экспорт
	
	ВидПервичногоДокумента = ПервичныеДокументыБГУ.НайтиПоИдентификатору(КомандаПечати.Идентификатор);
	Если ЗначениеЗаполнено(ВидПервичногоДокумента) Тогда
		КомандаПечати.ДополнительныеПараметры.Вставить("ВидПервичногоДокумента", ВидПервичногоДокумента);
	КонецЕсли;
	Если ДобавитьУсловие Тогда
		ДобавитьУсловиеКомандыПечатиПоВидуПервичногоДокумента(КомандаПечати, РазрешитьСДокументомКонтрагента);
	КонецЕсли;
	
КонецПроцедуры

// Устарела. Следует использовать ПервичныеДокументыБГУ.ПриСозданииНаСервере
// Заполнить виды первичных документов.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения:
//   * ПараметрыПодключаемыхКоманд - Структура
//   * Элементы - ВсеЭлементыФормы:
//     ** ИдентификаторПечатнойФормы - ПолеФормы
//   * ПараметрыПечатныхФорм - Произвольный
//  ДобавлятьДокументКонтрагента - Булево - Добавлять в список первичных документов строку "ДокументКонтрагента"
//  УсловиеВидимостиДокументаКонтрагента - Массив из Структура - описание структуры см. ПодключаемыеКоманды.ДобавитьУсловиеВидимостиКоманды
Процедура ЗаполнитьВидыПервичныхДокументов(Форма, ДобавлятьДокументКонтрагента = Ложь, Знач УсловиеВидимостиДокументаКонтрагента = Неопределено) Экспорт
	
	ТаблицаКоманд = УправлениеПечатью.КомандыПечатиФормы(Форма);
	ПечатныеФормы = Новый Структура;
	
	Для Каждого Строка Из ТаблицаКоманд Цикл
		ВидПервичногоДокумента = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Строка.ДополнительныеПараметры, "ВидПервичногоДокумента");
		Если Не ЗначениеЗаполнено(ВидПервичногоДокумента) Тогда
			Продолжить;
		КонецЕсли;
		ПечатнаяФорма = ОбщегоНазначенияБГУКлиентСервер.ПустаяСтрокаПараметраПечатныхФорм();
		ПечатнаяФорма.ВидПервичногоДокумента = Справочники.ПервичныеДокументы.НайтиПоИдентификатору(Строка.Идентификатор);
		ПечатнаяФорма.Представление = Строка.Представление;
		ПечатнаяФорма.УсловияВидимости = Строка.УсловияВидимости;
		
		ПечатныеФормы.Вставить(Строка.Идентификатор, ПечатнаяФорма);
	КонецЦикла;
	
	Если ДобавлятьДокументКонтрагента Тогда
		Если УсловиеВидимостиДокументаКонтрагента = Неопределено Тогда
			УсловиеВидимостиДокументаКонтрагента = Новый Массив;
		КонецЕсли;
		
		ПечатнаяФорма = ОбщегоНазначенияБГУКлиентСервер.ПустаяСтрокаПараметраПечатныхФорм();
		ПечатнаяФорма.Представление = НСтр("ru = 'Документ контрагента'");
		ПечатнаяФорма.УсловияВидимости = УсловиеВидимостиДокументаКонтрагента;
		ПечатныеФормы.Вставить("ДокументКонтрагента", ПечатнаяФорма);
	КонецЕсли;
	
	Форма.ПараметрыПечатныхФорм = ПечатныеФормы;
	ОбщегоНазначенияБГУКлиентСервер.ОбновитьВидыПервичныхДокументов(Форма);
	
КонецПроцедуры

