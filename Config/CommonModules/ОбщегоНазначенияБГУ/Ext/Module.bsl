// Функция формирует представление суммы прописью в указанной валюте
//
// Возвращаемое значение:
//  Строка - сумма прописью
//
Функция СформироватьСуммуПрописью(Сумма,Знач Валюта) Экспорт
	
	ПараметрыПрописиНаРусском = "";
	Если Не ЗначениеЗаполнено(Валюта) Тогда
		
		Валюта = Константы.ВалютаРегламентированногоУчета.Получить();
		Если ПустаяСтрока(Валюта.ПараметрыПрописи) Тогда
			ПараметрыПрописиНаРусском = "рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 2";
		Иначе
			ПараметрыПрописиНаРусском = Валюта.ПараметрыПрописи;
		КонецЕсли;
		
	Иначе
		
		ПараметрыПрописиНаРусском = Валюта.ПараметрыПрописи;
	
	КонецЕсли;
	
	Если ПараметрыПрописиНаРусском = "" Тогда
		Возврат ОбщегоНазначенияБГУ.ФорматСумм(Сумма);
	Иначе
		Возврат ЧислоПрописью(Сумма, "Л=ru_RU" ,ПараметрыПрописиНаРусском);
	КонецЕсли;

КонецФункции // СформироватьСуммуПрописью()

Функция ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка,Знач Номер) Экспорт
	Возврат РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(ДокументСсылка,Номер);
КонецФункции

// Стандартная для данной конфигурации функция форматирования сумм
//
// Параметры: 
//  Сумма  - число, которое мы хотим форматировать, 
//  Валюта - ссылка на элемент справочника валют, если задан, то к в результирующую строку
//           будет добавлено представление валюты
//  ЧН     - строка, представляющая нулевое значение числа,
//  ЧРГ    - символ-разделитель групп целой части числа.
//
// Возвращаемое значение:
//  Отформатированная должным образом строковое представление суммы.
//
Функция ФорматСумм(Сумма, Валюта = Неопределено, ЧН = "", ЧРГ = "", ЧРД = "." ) Экспорт

	ФорматнаяСтрока = "ЧЦ=15;ЧДЦ=2" + ";ЧРД="+ЧРД +
					?(ЗначениеЗаполнено(ЧН), ";ЧН=" + ЧН, "") +
					?(ЗначениеЗаполнено(ЧРГ), ";ЧРГ=" + ЧРГ, "");

	РезультирующаяСтрока = СокрЛ(Формат(Сумма, ФорматнаяСтрока));
	
	Если ЗначениеЗаполнено(Валюта) Тогда
		РезультирующаяСтрока = РезультирующаяСтрока + " " + СокрП(Валюта);
	КонецЕсли;

	Возврат РезультирующаяСтрока;

КонецФункции // ФорматСумм()

#КонецОбласти

#Область ЗаполнениеПараметровСеанса

Процедура УстановитьТекущуюОрганизацию(Организация) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	ПараметрыСеанса.ТекущаяОрганизация = Организация;
	
	ХранилищеОбщихНастроек.Сохранить("ТЕКУЩАЯОРГАНИЗАЦИЯ",, Организация);
	
КонецПроцедуры

// процедура определяет основную организацию текущего пользователя, пишет в параметр 
// сеанса и устанавливает ее в параметр Организация
//
Процедура НайтиИУстановитьТекущуюОрганизацию(Организация, ИнициализацияПараметраСеанса = Ложь) Экспорт
	
	Если НЕ ОбщегоНазначения.ДоступноИспользованиеРазделенныхДанных() Тогда
		Возврат;
	КонецЕсли;
	
	Организация = ЗаполнениеРеквизитовОбъектов.ОрганизацияПоУмолчанию(,,ИнициализацияПараметраСеанса); 
	
	УстановитьТекущуюОрганизацию(Организация);
	
КонецПроцедуры

Процедура НачальнаяУстановкаПараметраСеанса(ИмяПараметра, УстановленныеПараметры) Экспорт
	
	Если ОбщегоНазначения.ДоступноИспользованиеРазделенныхДанных() Тогда
		Если ИмяПараметра = "ТекущаяОрганизация" Тогда
			ОрганизацияПоУмолчанию = ЗаполнениеРеквизитовОбъектов.ОрганизацияПоУмолчанию(,,Истина);
			ПараметрыСеанса.ТекущаяОрганизация = ОрганизацияПоУмолчанию;
			УстановленныеПараметры.Добавить(ИмяПараметра);
		КонецЕсли;
	КонецЕсли;
	
	Если ИмяПараметра = "КонтекстФормированияБухгалтерскойОперации" Тогда
		ПараметрыСеанса.КонтекстФормированияБухгалтерскойОперации = "";
		УстановленныеПараметры.Добавить(ИмяПараметра);
	КонецЕсли;
	
КонецПроцедуры	

#КонецОбласти

#Область РаботаСФормами

// Выполняет установку отбора по указанной организации в динамических списках.
// Вызывать необходимо из обработчика формы ПриСозданииНаСервере.
// Если в форму при открытии был передан отбор по организации, то функция не будет выполнена.
//
// Параметры
//  Форма          - УправляемаяФорма  - форма, в которой необходимо установить отбор
//  ИмяСписка      - Строка - имя реквизита формы типа ДинамическийСписок.
//  ИмяРеквизита   - Строка - имя поля-организации в динамическом списке.
//  ЗначениеОтбора - СправочникСсылка.Организации, СписокЗначений, Массив - значение отбора.
//                   Если значение не задано, то будет подставлена основная организация из
//                   настроек пользователя.
//
// Возвращаемое значение:
//   СправочникСсылка.Организации - Если отбор установлен, то вернет значение отбора.
//
Функция УстановитьОтборСпискаПоОрганизации(Форма, ИмяСписка = "Список", ИмяРеквизита = "Организация", ЗначениеОтбора = Неопределено) Экспорт

	ОсновнаяОрганизация = Справочники.Организации.ПустаяСсылка();
	Представление = Неопределено;
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьНесколькоОрганизаций") Тогда
		
		Если Форма.Параметры.Свойство("Отбор") И Форма.Параметры.Отбор.Свойство(ИмяРеквизита) Тогда
			// Если значение отбора передается в параметрах отбора - берем его оттуда.
			ОсновнаяОрганизация = Форма.Параметры.Отбор[ИмяРеквизита];
			РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
		ИначеЕсли Форма.Параметры.Свойство(ИмяРеквизита) Тогда
			// Если значение отбора передается в параметрах формы - берем его оттуда.
			ОсновнаяОрганизация = Форма.Параметры[ИмяРеквизита];
			РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
		ИначеЕсли ТипЗнч(ЗначениеОтбора) = Тип("СправочникСсылка.Организации") 
			ИЛИ ТипЗнч(ЗначениеОтбора) = Тип("СписокЗначений") 
			ИЛИ ТипЗнч(ЗначениеОтбора) = Тип("Массив") Тогда
			ОсновнаяОрганизация = ЗначениеОтбора;
			РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ;
		Иначе
			ОсновнаяОрганизация = ТекущаяОрганизация();
			РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ;
		КонецЕсли;
		
		// Форма списка (журнала) может быть открыта из формы документа по команде "Найти в списке".
		Если Форма.Параметры.Свойство("ТекущаяСтрока") И ЗначениеЗаполнено(Форма.Параметры.ТекущаяСтрока) Тогда
			ОсновнаяОрганизация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Форма.Параметры.ТекущаяСтрока, ИмяРеквизита);
		КонецЕсли;
		
		Если ТипЗнч(ОсновнаяОрганизация) = Тип("СправочникСсылка.Организации") Тогда
			ВидСравненияОтбора = ВидСравненияКомпоновкиДанных.Равно;
		Иначе
			ВидСравненияОтбора = ВидСравненияКомпоновкиДанных.ВСписке;
		КонецЕсли;
				
	Иначе
		
		ВидСравненияОтбора  = ВидСравненияКомпоновкиДанных.Равно;
		ОсновнаяОрганизация = ТекущаяОрганизация();
		РежимОтображения    = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
		
	КонецЕсли;
	
	ИспользованиеОтбора = ЗначениеЗаполнено(ОсновнаяОрганизация);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Форма[ИмяСписка], ИмяРеквизита, ОсновнаяОрганизация, ВидСравненияОтбора, Представление, ИспользованиеОтбора, РежимОтображения);
	
	Возврат ОсновнаяОрганизация;
	
КонецФункции

// Заменяет отбор, установленный пользователем в сохраненной настройке списка, на отбор, установленный программно при создании формы списка.
// Вызывается при восстановлении пользовательских настроек динамического списка
// из обработчика списка ПередЗагрузкойПользовательскихНастроекНаСервере.
//
// Параметры
//  Список      - ДинамическийСписок
//  Настройки   - ПользовательскиеНастройкиКомпоновкиДанных - восстанавливаемые настройки списка
//  ИмяОтбора   - Строка - имя элемента отбора
//
Процедура ВосстановитьОтборСписка(Список, Настройки, ИмяОтбора) Экспорт

	Отборы = ОбщегоНазначенияКлиентСервер.НайтиЭлементыИГруппыОтбора(
		Список.КомпоновщикНастроек.Настройки.Отбор, ИмяОтбора);
	
	Если Отборы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементОтбора = Отборы[0];
	ИдентификаторНастройки = ЭлементОтбора.ИдентификаторПользовательскойНастройки;
	
	Для каждого ЭлементНастроек Из Настройки.Элементы Цикл
		Если ТипЗнч(ЭлементНастроек) = Тип("ЭлементОтбораКомпоновкиДанных") 
			И ЭлементНастроек.ИдентификаторПользовательскойНастройки = ИдентификаторНастройки Тогда
			ЭлементНастроек.ПравоеЗначение = ЭлементОтбора.ПравоеЗначение;
			ЭлементНастроек.Использование  = ЭлементОтбора.Использование;
			Прервать;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Устанавливает признак "Только просмотр" элементам формы, если у текущего пользователя нет прав на изменение объекта
// Параметры:
//	Элементы - ВсеЭлементыФормы
//	Объект - ДокументОбъект или СправочникОбъект
//	ИменаРеквизитов - Строка или массив - содержит имена элементов формы. Если строка то имена указываются через запятую
//
Процедура УстановитьНедоступныеЭлементыФормы(Элементы, Объект, Знач ИменаРеквизитов) Экспорт
	Если Не ПравоДоступа("Изменение", Объект.Ссылка.Метаданные()) Тогда
		Если ТипЗнч(ИменаРеквизитов) = Тип("Строка") Тогда
			ИменаРеквизитов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ИменаРеквизитов, ",");
		КонецЕсли;
		ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаРеквизитов, "Доступность", Ложь);  
	КонецЕсли;
КонецПроцедуры

Процедура УстановитьНевидимыеКомандыЖурнала(Элементы, ИсточникКоманд, КонтекстноеМеню="Список") Экспорт
	
	ЭлементыФормы = Новый Массив;
	ЭлементыФормы.Добавить(ИсточникКоманд+"Создать");
	ЭлементыФормы.Добавить(КонтекстноеМеню+"КонтекстноеМенюСоздать");
	ЭлементыФормы.Добавить(ИсточникКоманд+"Скопировать");
	ЭлементыФормы.Добавить(КонтекстноеМеню+"КонтекстноеМенюСкопировать");
	ЭлементыФормы.Добавить(ИсточникКоманд+"Провести");
	ЭлементыФормы.Добавить(ИсточникКоманд+"ОтменаПроведения");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ЭлементыФормы, "Видимость", Ложь);
	
КонецПроцедуры

// ред.2 Формирует список выбора для элемента формы журнала документов, "отвечающего"
// за отбор по типу документа
//
// Параметры
//  ИмяЖурнала - строка, имя журнала документов, так, как оно задано в
//               конфигураторе
//  ЭлементФормы - элемент формы (поле ввода) в котором устанавливается отбор
//                по типу документа
//
Функция ПолучитьСписокВыбораДляОтбораПоТипуДокумента(ИмяЖурнала, ЭлементФормы) Экспорт
	
	СписокВыбора = Новый СписокЗначений;
	
	Для Каждого РегистрируемыйДокумент ИЗ Метаданные.ЖурналыДокументов[ИмяЖурнала].РегистрируемыеДокументы Цикл
		ЭлементФормы.СписокВыбора.Добавить(РегистрируемыйДокумент.Имя, РегистрируемыйДокумент.Синоним);
	КонецЦикла;	
	
	ЭлементФормы.СписокВыбора.СортироватьПоПредставлению();
	
	Возврат СписокВыбора;	
	
КонецФункции	

// Устанавливает элемент условного оформления для выделения сторнированного документа в списке.
// Поле динамического списка "ДокументСторнирован", должно содержать значение типа "Булево".
//
// Параметры:
//  Список  - ДинамическийСписок - реквизит формы, содержащий ДС для которого устанавливается УО.
//
// Пример:
//  ОбщегоНазначенияБГУ.УстановитьУсловноеОформлениеДокументСторнирован(Список);
//
Процедура УстановитьУсловноеОформлениеДокументСторнирован(Список) Экспорт

	ЦветТекста = Метаданные.ЭлементыСтиля.ЗакрытыйДокумент.Значение;
	УсловноеОформление = Список.УсловноеОформление.Элементы;
	
	ЭлементОформления = УсловноеОформление.Добавить();
	ЭлементОформления.Использование = Истина;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементОформления.Отбор, 
		"ДокументСторнирован", 
		Истина, 
		ВидСравненияКомпоновкиДанных.Равно,
		НСтр("ru = 'Документ сторнирован'"),
		Истина,
		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Обычный);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветТекста);

КонецПроцедуры

// Инициализирует данные формы для обеспечения редактирования в ней записи 
// регистра сведений, подчиненного ведущим объектам
//
// Параметры
//	Форма - управляемая форма
//	ИмяРегистра - строка, имя редактируемого регистра
//  ВедущиеОбъекты - структура, ключ - Имя измерения, Значение - Значение измерения
//  ИмяРеквизита - строка, имя реквизита формы. Если не указано - совпадает с именем регистра 
//	Требования:
//		Форма должна содержать реквизиты
//			<ИмяРеквизита> 				типа Менеджер записи
//			<ИмяРеквизита>Прежняя 		типа Менеджер записи
//			<ИмяРеквизита>НоваяЗапись 	типа булево
// см. также 
//		ПрочитатьЗаписьДляРедактированияВФорме
//		ЗаписатьЗаписьПослеРедактированияВФорме
//
Процедура ИнициализироватьЗаписьДляРедактированияВФорме(Форма, ИмяРегистра, ВедущиеОбъекты, Знач ИмяРеквизита = "") Экспорт
	
	МетаданныеРегистра 	= Метаданные.РегистрыСведений[ИмяРегистра];
	МенеджерЗаписи 		= РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
	
	Если НЕ ЗначениеЗаполнено(ИмяРеквизита) Тогда
		ИмяРеквизита = ИмяРегистра;
	КонецЕсли;	

	Для Каждого ВедущийОбъект Из ВедущиеОбъекты Цикл
		
		МенеджерЗаписи[ВедущийОбъект.Ключ] = ВедущийОбъект.Значение;

	КонецЦикла;	
	
	Форма.ЗначениеВРеквизитФормы(МенеджерЗаписи, ИмяРеквизита);
	
	ЗаписьКакСтруктура = ОбщегоНазначения.СтруктураПоМенеджеруЗаписи(МенеджерЗаписи, МетаданныеРегистра);
	Форма[ИмяРеквизита + "Прежняя"] = Новый ФиксированнаяСтруктура(ЗаписьКакСтруктура);
	
	Форма[ИмяРеквизита + "НоваяЗапись"] = Ложь;
	
КонецПроцедуры

// Чтение и запись записей периодических регистров сведений, подчиненных ведущему объекту 
// для редактирования регистров сведений в форме
//
// Параметры
//	Форма - управляемая форма
//	ИмяРегистра - имя редактируемого регистра
//	ВедущиеОбъекты - структура, ключ - Имя измерения, значение - Значение измерения
//  ИмяРеквизита - строка, имя реквизита формы. Если не указано - совпадает с именем регистра
//
//	Требования:
//		Форма должна содержать реквизиты
//			<ИмяРеквизита> 				типа Менеджер записи
//			<ИмяРеквизита>Прежняя 		типа Менеджер записи
//			<ИмяРеквизита>НоваяЗапись 	типа булево
// см. также 
//		ИнициализироватьЗаписьДляРедактированияВФорме
//		ЗаписатьЗаписьПослеРедактированияВФорме
//
Процедура ПрочитатьЗаписьДляРедактированияВФорме(Форма, ИмяРегистра, ВедущиеОбъекты, Знач ИмяРеквизита = "") Экспорт
	
	МетаданныеРегистра = Метаданные.РегистрыСведений[ИмяРегистра];
	
	Если НЕ ЗначениеЗаполнено(ИмяРеквизита) Тогда
		ИмяРеквизита = ИмяРегистра;
	КонецЕсли;
	
	Если Форма[ИмяРеквизита + "НоваяЗапись"] Тогда
		Возврат;
	КонецЕсли;
	
	МенеджерЗаписи = Форма.РеквизитФормыВЗначение(ИмяРеквизита);
	
	Для Каждого ВедущийОбъект Из ВедущиеОбъекты Цикл
		
		МенеджерЗаписи[ВедущийОбъект.Ключ] = ВедущийОбъект.Значение;

	КонецЦикла;	

	// Если регистр - периодический
	Если МетаданныеРегистра.ПериодичностьРегистраСведений <> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
		// Ищем последнюю запись
		Запрос = Новый Запрос;
		Запрос.Текст = "
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	РегистрСведений.Период
		|ИЗ
		|	РегистрСведений." + ИмяРегистра + " КАК РегистрСведений";
		
		Условия = Новый Массив;
		Для Каждого ВедущийОбъект Из ВедущиеОбъекты Цикл
			
			Условия.Добавить(СтрШаблон("РегистрСведений.%1 = &%1", ВедущийОбъект.Ключ));
			Запрос.УстановитьПараметр(ВедущийОбъект.Ключ, ВедущийОбъект.Значение);
			
		КонецЦикла;
		
		Если Условия.Количество() > 0 Тогда
			Запрос.Текст = Запрос.Текст + "
			|ГДЕ
			|	" + СтрСоединить(Условия, " И ");
		КонецЕсли;
		
		Запрос.Текст = Запрос.Текст + "
		|
		|УПОРЯДОЧИТЬ ПО
		|	РегистрСведений.Период УБЫВ";
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			МенеджерЗаписи.Период = Выборка.Период;
			МенеджерЗаписи.Прочитать();
		КонецЕсли;
	Иначе
		МенеджерЗаписи.Прочитать();
	КонецЕсли;
	
	// имя реквизита формы совпадает с именем регистра
	Форма.ЗначениеВРеквизитФормы(МенеджерЗаписи, ИмяРеквизита);
	
	ЗаписьКакСтруктура = ОбщегоНазначения.СтруктураПоМенеджеруЗаписи(МенеджерЗаписи, МетаданныеРегистра);
	Форма[ИмяРеквизита + "Прежняя"] = Новый ФиксированнаяСтруктура(ЗаписьКакСтруктура);
	
	Форма[ИмяРеквизита + "НоваяЗапись"] = Ложь;
	
КонецПроцедуры

// запись записей периодических регистров сведений, подчиненных ведущему объекту 
// см. ПрочитатьЗаписьДляРедактированияВФорме
//
Процедура ЗаписатьЗаписьПослеРедактированияВФорме(Форма, ИмяРегистра, ВедущиеОбъекты, ДанныеМодифицированы = Ложь, Знач ИмяРеквизита = "", Отказ = Ложь) Экспорт   
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;	
	
	МетаданныеРегистра = Метаданные.РегистрыСведений[ИмяРегистра];
	
	Если НЕ ЗначениеЗаполнено(ИмяРеквизита) Тогда
		ИмяРеквизита = ИмяРегистра;
	КонецЕсли;
	
	Если Форма[ИмяРеквизита + "НоваяЗапись"] Тогда
		ИзменилисьДанные = Истина;
	ИначеЕсли МетаданныеРегистра.ПериодичностьРегистраСведений <> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
		ИзменилисьДанные = Форма[ИмяРеквизита].Период <> Форма[ИмяРеквизита + "Прежняя"].Период;
	Иначе
		ИзменилисьДанные = Ложь;
	КонецЕсли;
	
	Если НЕ ИзменилисьДанные Тогда
		
		// Проверим для значений измерений
		
		Для Каждого ВедущийОбъект Из  ВедущиеОбъекты Цикл
			
			ИзменилисьДанные = ИзменилисьДанные ИЛИ 
			(ВедущийОбъект.Значение <> Форма[ИмяРеквизита + "Прежняя"][ВедущийОбъект.Ключ] И 
			ЗначениеЗаполнено(Форма[ИмяРеквизита + "Прежняя"][ВедущийОбъект.Ключ]));
			
		КонецЦикла	
		
	КонецЕсли;
	
	Если НЕ ИзменилисьДанные Тогда
		
		Для Каждого Поле Из МетаданныеРегистра.Ресурсы Цикл
			
			ИзменилисьДанные = ИзменилисьДанные ИЛИ (Форма[ИмяРеквизита][Поле.Имя] <> Форма[ИмяРеквизита + "Прежняя"][Поле.Имя]);
			
		КонецЦикла;
		
	КонецЕсли;

	Если НЕ ИзменилисьДанные Тогда
		
		Для Каждого Поле Из МетаданныеРегистра.Реквизиты Цикл
			
			ИзменилисьДанные = ИзменилисьДанные ИЛИ (Форма[ИмяРеквизита][Поле.Имя] <> Форма[ИмяРеквизита + "Прежняя"][Поле.Имя]);
			
		КонецЦикла;
		
	КонецЕсли;

		
	Если ИзменилисьДанные Тогда
		
		// пишем новое состояние записи
		МенеджерЗаписи = Форма.РеквизитФормыВЗначение(ИмяРеквизита);
		
		Для Каждого ВедущийОбъект Из ВедущиеОбъекты Цикл
			
			МенеджерЗаписи[ВедущийОбъект.Ключ] = ВедущийОбъект.Значение;
			
		КонецЦикла;	
		
		// если нужно сохранить старую запись, то создадим новые менеджер записи
		
		Если Форма[ИмяРеквизита + "НоваяЗапись"] Тогда
			
			НоваяЗапись = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
			
			ЗаполнитьЗначенияСвойств(НоваяЗапись,  МенеджерЗаписи);
			НоваяЗапись.Записать();
			
		Иначе
			
			МенеджерЗаписи.Записать();
			
		КонецЕсли;
		
	КонецЕсли;
	
	ДанныеМодифицированы = ИзменилисьДанные;
	
КонецПроцедуры

Процедура ПроверитьЗаписьВФорме(Форма, ИмяРегистра, ВедущиеОбъекты, Отказ, Знач ИмяРеквизита = "") Экспорт
	
	МетаданныеРегистра = Метаданные.РегистрыСведений[ИмяРегистра];
	Синоним = МетаданныеРегистра.Синоним;
	
	Если НЕ ЗначениеЗаполнено(ИмяРеквизита) Тогда
		ИмяРеквизита = ИмяРегистра;
	КонецЕсли;
	
	ИмяИзмерения = МетаданныеРегистра.Измерения[0].Имя;

	ИзменилисьДанные = Форма[ИмяРеквизита].Период <> Форма[ИмяРеквизита + "Прежняя"].Период;
	
	Если НЕ ИзменилисьДанные Тогда
		
		// Проверим для значений измерений
		
		Для Каждого ВедущийОбъект Из  ВедущиеОбъекты Цикл
			
			ИзменилисьДанные = ИзменилисьДанные ИЛИ 
			(ВедущийОбъект.Значение <> Форма[ИмяРеквизита + "Прежняя"][ВедущийОбъект.Ключ] И 
			ЗначениеЗаполнено(Форма[ИмяРеквизита + "Прежняя"][ВедущийОбъект.Ключ]));
			
		КонецЦикла	
		
	КонецЕсли;
	
	Если НЕ ИзменилисьДанные Тогда
		
		Для Каждого Поле Из МетаданныеРегистра.Ресурсы Цикл
			ИзменилисьДанные = ИзменилисьДанные ИЛИ (Форма[ИмяРеквизита][Поле.Имя] <> Форма[ИмяРеквизита + "Прежняя"][Поле.Имя]);
		КонецЦикла;
		
	КонецЕсли;
	
	Если НЕ ИзменилисьДанные Тогда
		
		Для Каждого Поле Из МетаданныеРегистра.Реквизиты Цикл
			ИзменилисьДанные = ИзменилисьДанные ИЛИ (Форма[ИмяРеквизита][Поле.Имя] <> Форма[ИмяРеквизита + "Прежняя"][Поле.Имя]);
		КонецЦикла;
		
	КонецЕсли;
	
	Если ИзменилисьДанные Тогда
		
		МенеджерЗаписи = Форма.РеквизитФормыВЗначение(ИмяРеквизита);
		
		Для Каждого СтандартныйРеквизит Из МетаданныеРегистра.СтандартныеРеквизиты Цикл
			ПроверитьЗаполнениеПоляЗаписиРегистраВФорме(МенеджерЗаписи, ИмяРегистра, СтандартныйРеквизит, Синоним, Отказ);		
		КонецЦикла;	
		
		Для Каждого Измерение Из МетаданныеРегистра.Измерения Цикл
			Если НЕ ВедущиеОбъекты.Свойство(Измерение.Имя) Тогда
				ПроверитьЗаполнениеПоляЗаписиРегистраВФорме(МенеджерЗаписи, ИмяРегистра, Измерение, Синоним, Отказ);
			КонецЕсли;	
		КонецЦикла;
		
		Для Каждого Ресурс Из МетаданныеРегистра.Ресурсы Цикл
			ПроверитьЗаполнениеПоляЗаписиРегистраВФорме(МенеджерЗаписи, ИмяРегистра, Ресурс, Синоним, Отказ);				
		КонецЦикла;	
		
		Для Каждого Реквизит Из МетаданныеРегистра.Реквизиты Цикл
			ПроверитьЗаполнениеПоляЗаписиРегистраВФорме(МенеджерЗаписи, ИмяРегистра, Реквизит, Синоним, Отказ);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьЗаполнениеПоляЗаписиРегистраВФорме(МенеджерЗаписи, ИмяРегистра, ОписаниеПоля, Синоним, Отказ)
	
	Если ОписаниеПоля.ПроверкаЗаполнения  = ПроверкаЗаполнения.ВыдаватьОшибку И Не ЗначениеЗаполнено(МенеджерЗаписи[ОписаниеПоля.Имя]) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1: не заполнено поле ""%2"".'"), Синоним, ?(ЗначениеЗаполнено(ОписаниеПоля.Синоним), ОписаниеПоля.Синоним, ОписаниеПоля.Имя)); 
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ,	ИмяРегистра + "." + ОписаниеПоля.Имя, , Отказ);
	КонецЕсли;	
	
КонецПроцедуры	

Процедура ИнициализироватьОтборКомпоновщикаНастроек(ПараметрыНастройки,
													ПредставлениеОтбора = Неопределено,
													КомпоновщикНастроек = Неопределено,
													СхемаКомпоновкиДанных = Неопределено,
													УникальныйИдентификатор = Неопределено,
													Отказ = Ложь) Экспорт
													
	Если ПараметрыНастройки.Свойство("СхемаКомпоновки") Тогда
		
		СхемаКомпоновки = ПолучитьИзВременногоХранилища(ПараметрыНастройки.СхемаКомпоновки);
		
		СхемаКомпоновкиДанных = ПараметрыНастройки.СхемаКомпоновки;
		
	Иначе
		
		// Формирование источника схемы компоновки
		
		Если ПараметрыНастройки.Свойство("ТекстЗапроса") Тогда
			ТекстЗапроса = ПараметрыНастройки.ТекстЗапроса;
		Иначе
			Если ПараметрыНастройки.Свойство("ТипЗначения") Тогда
				ТипЗначения = ПараметрыНастройки.ТипЗначения;
			ИначеЕсли ПараметрыНастройки.Свойство("Реквизит") Тогда
				ТипЗначения = ПараметрыНастройки.Реквизит.ТипЗначения;
			ИначеЕсли ПараметрыНастройки.Свойство("ИдентификаторДокумента") Тогда
				ТипЗначения = Новый ОписаниеТипов(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(
				ТипЗнч(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыНастройки.ИдентификаторДокумента, "ЗначениеПустойСсылки"))));
			Иначе
				ВызватьИсключение "Неверный вызов формы. Необходимо передать текст запроса, тип значения, или идентификатор документа";
			КонецЕсли;		
			
			ТекстЗапроса = СформироватьТекстЗапроса(ТипЗначения, Отказ);
			
			Если Отказ Тогда
				Возврат;
			КонецЕсли;
			
		КонецЕсли;
		
		Если ПустаяСтрока(ТекстЗапроса) Тогда
			ТекстСообщения = НСтр("ru='Для данного типа не поддерживается установка отбора'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
			Возврат;
		КонецЕсли;
		
		// Формирование схемы компоновки
		
		Если УникальныйИдентификатор = Неопределено Тогда
			УникальныйИдентификатор = Новый УникальныйИдентификатор;
		КонецЕсли;
		
		СхемаКомпоновки = Новый СхемаКомпоновкиДанных;
		ИсточникДанных = СхемаКомпоновки.ИсточникиДанных.Добавить();
		ИсточникДанных.ТипИсточникаДанных = "Local";
		ИсточникДанных.Имя = "ЭтаИБ";
		
		НаборДанных = СхемаКомпоновки.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
		НаборДанных.АвтоЗаполнениеДоступныхПолей	= Истина;
		НаборДанных.ИсточникДанных					= ИсточникДанных.Имя;
		НаборДанных.Запрос							= ТекстЗапроса;
		
		// Скрываем исключаемые поля
		Если ПараметрыНастройки.Свойство("ИсключенныеПоля") Тогда
			Для Каждого Поле Из ПараметрыНастройки.ИсключенныеПоля Цикл
				ПолеСхемы = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
				ПолеСхемы.Поле = Поле;
				ПолеСхемы.ПутьКДанным = Поле;
				ПолеСхемы.ОграничениеИспользования.Группировка	= Истина;
				ПолеСхемы.ОграничениеИспользования.Поле			= Истина;
				ПолеСхемы.ОграничениеИспользования.Порядок		= Истина;
				ПолеСхемы.ОграничениеИспользования.Условие		= Истина;
			КонецЦикла;
		КонецЕсли;
		
		СхемаКомпоновкиДанных = ПоместитьВоВременноеХранилище(СхемаКомпоновки, УникальныйИдентификатор);
		
	КонецЕсли;	
	
	Если КомпоновщикНастроек = Неопределено Тогда
		КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КонецЕсли;
	
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных));
		
	// Загрузка настроек из сериализованного представления
	
	Если ПараметрыНастройки.Свойство("НастройкиОтбора") Тогда
		СериализованнаяНастройка = ПараметрыНастройки.НастройкиОтбора;
		Если ЗначениеЗаполнено(СериализованнаяНастройка) Тогда
			Попытка					
				Настройки = ОбщегоНазначения.ЗначениеИзСтрокиXML(СериализованнаяНастройка);
				КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);			
				КомпоновщикНастроек.Восстановить();	
			Исключение
			КонецПопытки;
		КонецЕсли;
	ИначеЕсли ПараметрыНастройки.Свойство("Отбор") Тогда
		СериализованныйОтбор = ПараметрыНастройки.Отбор;
		Если ЗначениеЗаполнено(СериализованныйОтбор) Тогда
			Попытка					
				Отбор = ОбщегоНазначения.ЗначениеИзСтрокиXML(СериализованныйОтбор);
				Настройки = КомпоновщикНастроек.ПолучитьНастройки();
				ОбщийМодульСКД.СкопироватьОтборНастроекКомпоновкиДанных(Настройки.Отбор, Отбор);		
				КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);			
				КомпоновщикНастроек.Восстановить();	
			Исключение
			КонецПопытки;
		КонецЕсли;		
	КонецЕсли;	
	
	// Формирование представления отбора
	
	ПредставлениеОтбора = Строка(КомпоновщикНастроек.Настройки.Отбор);
	
КонецПроцедуры

Функция СформироватьТекстЗапроса(ТипыЗначения, Отказ)

	Запрос = "";
	
	Если ТипыЗначения.типы().Количество() = 1 Тогда
		ТипЗначения = ТипыЗначения.типы()[0];
		Если ТипЗначения = Тип("Строка") ИЛИ
			ТипЗначения = Тип("Дата") ИЛИ
			ТипЗначения = Тип("Число") ИЛИ
			ТипЗначения = Тип("Булево") Тогда
			
			ТекстСообщения = НСтр("ru='Для простого типа не поддерживается установка отбора'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);		
			
			Возврат Запрос;
			
		КонецЕсли;
		
		МетаданныеОбъекта = Метаданные.НайтиПоТипу(ТипЗначения);
		Запрос = "Выбрать";
		Если Перечисления.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
			Запрос = Запрос + "
							|ВыбОбъект.Ссылка,"
		Иначе
			Для каждого СтандартныйРеквизит Из МетаданныеОбъекта.СтандартныеРеквизиты Цикл
			
				Запрос = Запрос + "
							|ВыбОбъект."+СтандартныйРеквизит.Имя+",";
			
			КонецЦикла; 
			Для каждого Реквизит Из МетаданныеОбъекта.Реквизиты Цикл
			
				Запрос = Запрос + "
							|ВыбОбъект."+Реквизит.Имя+",";
			
			КонецЦикла; 
		КонецЕсли;			
		Запрос = Лев(Запрос, СтрДлина(Запрос)-1);			
		Запрос = Запрос + "
				|Из
				|"+ОбщегоНазначения.ВидОбъектаПоТипу(ТипЗначения)+"."+МетаданныеОбъекта.Имя+" Как ВыбОбъект";
		
		
	Иначе
		ТекстСообщения = НСтр("ru='Для составного типа не поддерживается установка отбора'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
				
	КонецЕсли;
	
	Возврат Запрос;

КонецФункции // СформироватьТекстЗапроса()

// Возвращает первую видимую табличную часть документа, в которой есть строки.
//
// Параметры:
//   Форма                - форма документа, который открывается;
//   СписокТабличныхПолей - Список значений - табличных полей, где
//                            Значение - имя элемента формы,
//                            Представление - имя табличной части (в метаданных)
//
Функция ПолучитьПервуюНепустуюВидимуюТабличнуюЧасть(Форма, СписокТабличныхПолей) Экспорт

	Для Каждого Элемент из СписокТабличныхПолей Цикл
		Если Форма.Объект[Элемент.Представление].Количество() > 0 Тогда
			Если Форма.Элементы[Элемент.Значение].Видимость Тогда
				// Эта табличная часть - первая видимая, у которой есть данные
				Возврат Элемент.Значение;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат "";

КонецФункции

// Заполняет в документе реквизиты локального акта, которым установлен порядок принятия решения.
//
Процедура ЗаполнитьРеквизитыЛокальногоАкта(Объект, ДанныеЗаполнения = Неопределено) Экспорт
	
	ВидДокумента = Объект.Метаданные().Имя;
	Организация = Объект.Организация;
	Если Не ЗначениеЗаполнено(Организация) И ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		Организация = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеЗаполнения, "Организация");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Организация = ПараметрыСеанса.ТекущаяОрганизация;
	КонецЕсли;
	
	РеквизитыЛокальногоАкта = ОбщегоНазначенияБГУ.РеквизитыЛокальногоАктаПоУмолчанию(ВидДокумента, Организация);
	ЗаполнитьЗначенияСвойств(Объект, РеквизитыЛокальногоАкта);
	
КонецПроцедуры

// Возвращает реквизиты локального акта, использованные в последнем документе заданного вида.
//
Функция РеквизитыЛокальногоАктаПоУмолчанию(ВидДокумента, Организация = Неопределено) Экспорт
	
	РеквизитыЛокальногоАкта = Новый Структура;
	РеквизитыЛокальногоАкта.Вставить("ВидЛокальногоАкта",   "");
	РеквизитыЛокальногоАкта.Вставить("НомерЛокальногоАкта", "");
	РеквизитыЛокальногоАкта.Вставить("ДатаЛокальногоАкта",  Дата('00010101'));
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Документ.Ссылка КАК Ссылка,
	|	Документ.ВидЛокальногоАкта КАК ВидЛокальногоАкта,
	|	Документ.НомерЛокальногоАкта КАК НомерЛокальногоАкта,
	|	Документ.ДатаЛокальногоАкта КАК ДатаЛокальногоАкта
	|ИЗ
	|	Документ.СписаниеКредиторскойЗадолженности КАК Документ
	|ГДЕ
	|	Документ.ВидЛокальногоАкта <> """"
	|	И НЕ Документ.ПометкаУдаления
	|	И &УсловиеОрганизация
	|
	|УПОРЯДОЧИТЬ ПО
	|	Документ.Дата УБЫВ";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.СписаниеКредиторскойЗадолженности", "Документ." + ВидДокумента);
	
	Если ЗначениеЗаполнено(Организация) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОрганизация", "Документ.Организация = &Организация");
		Запрос.УстановитьПараметр("Организация", Организация);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОрганизация", "ИСТИНА");
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(РеквизитыЛокальногоАкта, Выборка);
	КонецЕсли;
	
	Возврат РеквизитыЛокальногоАкта;
	
КонецФункции

// Инициализирует структуру общих параметров, изменения которых контролируются в документах.
//
Функция ИнициализироватьКэшПараметровФормы(Форма, Объект, ТиповаяОперация = Неопределено) Экспорт
	
	// Для документов, формирующих проводки, реквизит КэшПараметров добавляется в общем модуле БухгалтерскиеОперацииСервер.
	Если НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "КэшПараметров") Тогда
		ДобавляемыеРеквизиты = Новый Массив;
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("КэшПараметров", Новый ОписаниеТипов("Неопределено")));
		Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	КонецЕсли;
	
	Если ТипЗнч(Форма.КэшПараметров) <> Тип("Структура") Тогда
		
		Форма.КэшПараметров = Новый Структура;
		
		// Дата, Организация, ИФО и пр. хранят старые значения (до изменения) соответствующих реквизитов документа.
		// Имеет смысл использовать только в обработчиках ДатаПриИзменении(), ОрганизацияПриИзменении(), ИФОПриИзменении(),
		// т.к. в остальных обработчиках формы их значения совпадают с Объект.Дата, Объект.Организация, Объект.ИФО.
		Форма.КэшПараметров.Вставить("Дата");
		Форма.КэшПараметров.Вставить("Организация");
		Форма.КэшПараметров.Вставить("ИФО");
		Форма.КэшПараметров.Вставить("ВалютаДокумента");
		
		// Интервал изменения даты:
		// - в пределах дня - обычно никаких действий не требуется, т.к. изменилось только время документа;
		// - в пределах месяца - может потребоваться пересчет некоторых реквизитов, например, курса валюты;
		// - более месяца - может потребоваться пересчет реквизитов, например, оставщегося срока использования.
		// - изменился год даты - при изменении года даты может измениться план счетов и может потребоваться 
		//   актуализировать счета в документе
		// Имеет смысл использовать только в обработчике ДатаПриИзменении().
		Форма.КэшПараметров.Вставить("ИзмениласьДатаВПределахДня");
		Форма.КэшПараметров.Вставить("ИзмениласьДатаВПределахМесяца");
		Форма.КэшПараметров.Вставить("ИзмениласьДатаНаМесяцИБолее");  
		Форма.КэшПараметров.Вставить("ИзменилсяГодДаты");
		Форма.КэшПараметров.Вставить("ИзмениласьДатаСПереходомНачалаПрослеживаемости");
		// При изменении даты на месяц и более могла измениться действующая учетная политика.
		// Имеет смысл использовать только в обработчике ДатаПриИзменении().
		Форма.КэшПараметров.Вставить("ИзмениласьУчетнаяПолитика");
		
		// Общие параметры учета, часто используемые в документах.
		// Можно использовать в любых обработчиках событий документа для управления видимостью и логикой работы формы.
		Форма.КэшПараметров.Вставить("ИспользоватьУчетПоИФО");
		Форма.КэшПараметров.Вставить("ИспользоватьУчетПоПодразделениям");
		Форма.КэшПараметров.Вставить("КонтролироватьОперацииНаСоответствиеРПС");
		Форма.КэшПараметров.Вставить("ИспользоватьВалютныйУчет");
		Форма.КэшПараметров.Вставить("ВалютаРегламентированногоУчета");
		
		// Параметры учетной политики, действующие для установленных в документе Организации и Даты.
		// Можно использовать в любых обработчиках событий документа для управления видимостью и логикой работы формы.
		Форма.КэшПараметров.Вставить("УчетнаяПолитика", Новый Структура);
		Форма.КэшПараметров.УчетнаяПолитика.Вставить("ДатыИзменения");
		Форма.КэшПараметров.УчетнаяПолитика.Вставить("ДатаПоследнегоИзменения");
		// - общие сведения об учреждении:
		Форма.КэшПараметров.УчетнаяПолитика.Вставить("СтруктураРПС");
		Форма.КэшПараметров.УчетнаяПолитика.Вставить("ЭтоАвтономноеУчреждение");
		Форма.КэшПараметров.УчетнаяПолитика.Вставить("ЭтоБюджетноеУчреждение");
		Форма.КэшПараметров.УчетнаяПолитика.Вставить("ЭтоКазенноеУчреждение");
		Форма.КэшПараметров.УчетнаяПолитика.Вставить("ПолномочияАДБ");
		Форма.КэшПараметров.УчетнаяПолитика.Вставить("ПолномочияГАДБ");
		// - параметры налогообложения:
		Форма.КэшПараметров.УчетнаяПолитика.Вставить("ПлательщикНалогаНаПрибыль");
		Форма.КэшПараметров.УчетнаяПолитика.Вставить("ПрименяетсяУСНДоходы");
		Форма.КэшПараметров.УчетнаяПолитика.Вставить("ПрименяетсяУСНДоходыМинусРасходы");
		Форма.КэшПараметров.УчетнаяПолитика.Вставить("ПлательщикЕНВД");
		// - параметры учета имущества казны:
		Форма.КэшПараметров.УчетнаяПолитика.Вставить("ВедениеАналитическогоУчетаИмуществаКазны");
		Форма.КэшПараметров.УчетнаяПолитика.Вставить("НачислятьАмортизациюИмуществаКазны");
		Форма.КэшПараметров.УчетнаяПолитика.Вставить("НачислятьАмортизациюПервымЧислом");
		Форма.КэшПараметров.УчетнаяПолитика.Вставить("РасчетыСУчредителемКорректироватьОборотами");
		
		// Служебные параметры используются для внутренних механизмов конфигурации.
		Форма.КэшПараметров.Вставить("Служебные", Новый Структура);
		// - служебные параметры механизма автоматического контроля курса валюты в документе:
		Форма.КэшПараметров.Служебные.Вставить("ОбновлятьКурсВалютыАвтоматически");
		Форма.КэшПараметров.Служебные.Вставить("ИзмениласьДатаДляКонтроляКурса");
		Форма.КэшПараметров.Служебные.Вставить("ИзмениласьВалютаДляКонтроляКурса");
		// - служебные параметры механизма контроля зависимых реквизитов:
		Форма.КэшПараметров.Служебные.Вставить("РеквизитыДокументаЗависящиеОтДаты");
		Форма.КэшПараметров.Служебные.Вставить("РеквизитыТиповойОперацииЗависящиеОтДаты");
		
		// Локальные параметры могут быть добавлены в форме конкретного документа.
		Форма.КэшПараметров.Вставить("Локальные", Новый Структура);
		
	КонецЕсли;
	
	// 1. Общие реквизиты документа.
	Форма.КэшПараметров.Организация = Объект.Организация;
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "ИФО") Тогда
		Форма.КэшПараметров.ИФО = Объект.ИФО;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Ссылка)
	 ИЛИ ЗначениеЗаполнено(Объект.Дата) Тогда
		Форма.КэшПараметров.Дата = Объект.Дата;
	Иначе // Для новых документов дата по умолчанию - начало дня.
		Форма.КэшПараметров.Дата = НачалоДня(ТекущаяДатаСеанса());
	КонецЕсли;
	Форма.КэшПараметров.ИзмениласьДатаВПределахДня    					= Ложь;
	Форма.КэшПараметров.ИзмениласьДатаВПределахМесяца 					= Ложь;
	Форма.КэшПараметров.ИзмениласьДатаНаМесяцИБолее   					= Ложь;
	Форма.КэшПараметров.ИзменилсяГодДаты			  					= Ложь;
	Форма.КэшПараметров.ИзмениласьДатаСПереходомНачалаПрослеживаемости	= Ложь;
	Форма.КэшПараметров.ИзмениласьУчетнаяПолитика     					= Ложь;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "ВалютаДокумента") Тогда
		Форма.КэшПараметров.ВалютаДокумента = Объект.ВалютаДокумента;
	Иначе
		Форма.КэшПараметров.ВалютаДокумента = Форма.КэшПараметров.ВалютаРегламентированногоУчета;
	КонецЕсли;
	
	// 2. Общие параметры учета.
	Форма.КэшПараметров.ИспользоватьУчетПоИФО            = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	Форма.КэшПараметров.ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	Форма.КэшПараметров.КонтролироватьОперацииНаСоответствиеРПС   = Константы.КонтролироватьОперацииНаСоответствиеРПС.Получить();
	Форма.КэшПараметров.ИспользоватьВалютныйУчет         = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	Форма.КэшПараметров.ВалютаРегламентированногоУчета   = Константы.ВалютаРегламентированногоУчета.Получить();
	
	// 3. Параметры учетной политики.
	ДатаОпределенияУчетнойПолитики = ДатаОпределенияУчетнойПолитикиДляДокумента(Форма, Объект);
	УчетнаяПолитика = Справочники.Организации.ПолучитьУчетнуюПолитику(
		Объект.Организация, ДатаОпределенияУчетнойПолитики);
	ЗаполнитьЗначенияСвойств(Форма.КэшПараметров.УчетнаяПолитика, УчетнаяПолитика,
		"СтруктураРПС, ЭтоАвтономноеУчреждение, ЭтоБюджетноеУчреждение, ЭтоКазенноеУчреждение, ПолномочияАДБ, ПолномочияГАДБ,
		|ПлательщикНалогаНаПрибыль, ПрименяетсяУСНДоходы, ПрименяетсяУСНДоходыМинусРасходы, ПлательщикЕНВД,
		|ВедениеАналитическогоУчетаИмуществаКазны, НачислятьАмортизациюИмуществаКазны, НачислятьАмортизациюПервымЧислом");
	Форма.КэшПараметров.УчетнаяПолитика.ДатаПоследнегоИзменения = УчетнаяПолитика.Период;
	Форма.КэшПараметров.УчетнаяПолитика.ДатыИзменения = БухгалтерскийУчет.ДатыИзмененияУчетнойПолитики(Форма.КэшПараметров.Организация);
	
	// Инициируем изменение параметров функциональных опций.
	ОбщегоНазначенияБГУКлиентСервер.УстановитьПараметрОрганизацияФункциональныхОпцийФормы(Форма,
		Форма.КэшПараметров.Организация, ДатаОпределенияУчетнойПолитики);
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма.Элементы, "БухгалтерскаяОперация") Тогда
		БухгалтерскиеОперацииСервер.ПриИзмененииПараметровФункциональныхОпций(Форма.Элементы.БухгалтерскаяОперация);
	КонецЕсли;
	
	// 4. Контроль курса валюты в документах.
	Форма.КэшПараметров.Служебные.ОбновлятьКурсВалютыАвтоматически = Ложь;
	Форма.КэшПараметров.Служебные.ИзмениласьДатаДляКонтроляКурса   = Ложь;
	Форма.КэшПараметров.Служебные.ИзмениласьВалютаДляКонтроляКурса = Ложь;
	
	// 5. Контроль зависимых реквизитов.
	Форма.КэшПараметров.Служебные.РеквизитыДокументаЗависящиеОтДаты =
		ОбщегоНазначенияБГУПовтИсп.РеквизитыЗависящиеОтДаты(Объект.Ссылка.Метаданные().ПолноеИмя());
	СохранитьИменаРеквизитовОперацииЗависящихОтУчетнойПолитики(Форма, ТиповаяОперация);
	
КонецФункции

// Сохраняет в кэш параметров формы имена реквизитов типовой операции,
// которые нужно проверить при изменении учетной политики.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
//  ТиповаяОперация - СправочникСсылка.ТиповыеОперации - Типовая операция
Процедура СохранитьИменаРеквизитовОперацииЗависящихОтУчетнойПолитики(Форма, ТиповаяОперация) Экспорт
	Если ЗначениеЗаполнено(ТиповаяОперация) Тогда
		Форма.КэшПараметров.Служебные.РеквизитыТиповойОперацииЗависящиеОтДаты =
			ОбщегоНазначенияБГУПовтИсп.РеквизитыОперацииЗависящиеОтДаты(ТиповаяОперация);
	Иначе
		Форма.КэшПараметров.Служебные.РеквизитыТиповойОперацииЗависящиеОтДаты =
			Новый ФиксированныйМассив(Новый Массив);
	КонецЕсли;
КонецПроцедуры

// Обработчик изменения параметров учетной политики при изменении Даты, Организации, ИФО в форме документа.
//
Процедура ПриИзмененииУчетнойПолитики(Форма, Объект) Экспорт
	
	// При изменении Организации, ИФО и Даты значения некоторых реквизитов документа
	// могут более не соответствовать учетной политике - очищаем их.
	РеквизитыДокументаЗависящиеОтДаты       = Форма.КэшПараметров.Служебные.РеквизитыДокументаЗависящиеОтДаты;
	РеквизитыТиповойОперацииЗависящиеОтДаты = Форма.КэшПараметров.Служебные.РеквизитыТиповойОперацииЗависящиеОтДаты;
	КФОКПСТиповойОперацииЗависящиеОтДаты = Новый Массив;
	СчетаТиповойОперацииЗависящиеОтДаты = Новый Массив;
	Для каждого ТекРеквизит Из РеквизитыТиповойОперацииЗависящиеОтДаты Цикл
		
		ИмяРеквизитаФормы = БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитаФормыПоИмениДляФормулы(Форма, ТекРеквизит);
		Если ТипЗнч(Форма[ИмяРеквизитаФормы]) = Тип("ПланСчетовСсылка.ЕПСБУ") Тогда
			СчетаТиповойОперацииЗависящиеОтДаты.Добавить(ИмяРеквизитаФормы);
		Иначе
			КФОКПСТиповойОперацииЗависящиеОтДаты.Добавить(ИмяРеквизитаФормы);
		КонецЕсли;
	
	КонецЦикла;
	
	ПроверятьКФОиКПС = РеквизитыДокументаЗависящиеОтДаты.КПС.Количество() > 0
					ИЛИ РеквизитыДокументаЗависящиеОтДаты.КФО.Количество() > 0
					ИЛИ КФОКПСТиповойОперацииЗависящиеОтДаты.Количество() > 0;
	Если ПроверятьКФОиКПС Тогда
		
		ДатаУчетнойПолитикиНов = Объект.Дата;
		Для каждого ДатаИзменения Из Форма.КэшПараметров.УчетнаяПолитика.ДатыИзменения Цикл
			Если ДатаИзменения <= ДатаУчетнойПолитикиНов Тогда
				ДатаУчетнойПолитикиНов = ДатаИзменения;
				Прервать;
			КонецЕсли;
		КонецЦикла;

		ИФО = ?(ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "ИФО"), Объект.ИФО, Неопределено);
		КФО = ?(ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "КФО"), Объект.КФО, Неопределено);
		КФОПоУчетнойПолитике = БухгалтерскийУчетПовтИсп.КФОПоУчетнойПолитике(
			Объект.Организация, ИФО, ДатаУчетнойПолитикиНов);
		КПСПоУчетнойПолитике = БухгалтерскийУчетПовтИсп.КПСПоУчетнойПолитике(
			Объект.Организация, ИФО, КФО, ДатаУчетнойПолитикиНов);
		
		Для каждого ТекРеквизит Из РеквизитыДокументаЗависящиеОтДаты.КПС Цикл
			ПозицияТЧК = Найти(ТекРеквизит, ".");
			Если ПозицияТЧК = 0 Тогда
				Если КПСПоУчетнойПолитике.Найти(Объект[ТекРеквизит]) = Неопределено Тогда
					Объект[ТекРеквизит] = "";
				КонецЕсли;
			Иначе
				ИмяРеквизита = Сред(ТекРеквизит, ПозицияТЧК+1);
				Для Каждого ТекСтрока Из Объект[Лев(ТекРеквизит, ПозицияТЧК-1)] Цикл
					
					Если КПСПоУчетнойПолитике.Найти(ТекСтрока[ИмяРеквизита]) = Неопределено Тогда
						ТекСтрока[ИмяРеквизита] = "";
					КонецЕсли;
					
				КонецЦикла;
			КонецЕсли;
		КонецЦикла; 
		Для каждого ТекРеквизит Из РеквизитыДокументаЗависящиеОтДаты.КФО Цикл
			ПозицияТЧК = Найти(ТекРеквизит, ".");
			Если ПозицияТЧК = 0 Тогда
				Если КФОПоУчетнойПолитике.Найти(Объект[ТекРеквизит]) = Неопределено Тогда
					Объект[ТекРеквизит] = "";
				КонецЕсли;
			Иначе
				ИмяРеквизита = Сред(ТекРеквизит, ПозицияТЧК+1);
				Для Каждого ТекСтрока Из Объект[Лев(ТекРеквизит, ПозицияТЧК-1)] Цикл
					
					Если КФОПоУчетнойПолитике.Найти(ТекСтрока[ИмяРеквизита]) = Неопределено Тогда
						ТекСтрока[ИмяРеквизита] = "";
					КонецЕсли;
					
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		Для Каждого ИмяРеквизитаФормы Из КФОКПСТиповойОперацииЗависящиеОтДаты Цикл
			РеквизитСоответствует = Истина;
			Если ПустаяСтрока(ИмяРеквизитаФормы) Тогда
				Продолжить;
			КонецЕсли;
			Если ТипЗнч(Форма[ИмяРеквизитаФормы]) = Тип("ПеречислениеСсылка.КВД") Тогда
				РеквизитСоответствует = КФОПоУчетнойПолитике.Найти(Форма[ИмяРеквизитаФормы]) <> Неопределено;
			ИначеЕсли ТипЗнч(Форма[ИмяРеквизитаФормы]) = Тип("СправочникСсылка.КлассификационныеПризнакиСчетов") Тогда
				РеквизитСоответствует = КПСПоУчетнойПолитике.Найти(Форма[ИмяРеквизитаФормы]) <> Неопределено;
			КонецЕсли;
			Если НЕ РеквизитСоответствует Тогда
				Форма[ИмяРеквизитаФормы] = "";
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Если СчетаТиповойОперацииЗависящиеОтДаты.Количество() > 0 Тогда
		ПроверяемыеСчета = Новый Структура(СтрСоединить(СчетаТиповойОперацииЗависящиеОтДаты, ","));
		ЗаполнитьЗначенияСвойств(ПроверяемыеСчета, Форма);
		БухгалтерскиеОперацииСервер.УстановитьАктуальныеСчетаВСтруктуре(ПроверяемыеСчета, Объект.Дата, Объект.Организация);
		ЗаполнитьЗначенияСвойств(Форма, ПроверяемыеСчета);
	КонецЕсли;
	
	// При изменении Организации и Даты установим новые параметры учетной политики в форме документа.
	Если (Форма.КэшПараметров.Дата <> Объект.Дата И Форма.КэшПараметров.ИзмениласьУчетнаяПолитика)
	 ИЛИ (Форма.КэшПараметров.Организация <> Объект.Организация И ЗначениеЗаполнено(Объект.Организация))
	 ИЛИ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "ВидМежотчетногоПериода") Тогда
		
		ДатаОпределенияУчетнойПолитики = ДатаОпределенияУчетнойПолитикиДляДокумента(Форма, Объект);
		
		// Запоминаем новые значения параметров учетной политики в структуре КэшПараметров.
		УчетнаяПолитика = Справочники.Организации.ПолучитьУчетнуюПолитику(Объект.Организация, ДатаОпределенияУчетнойПолитики);
		ЗаполнитьЗначенияСвойств(Форма.КэшПараметров.УчетнаяПолитика, УчетнаяПолитика,
			"СтруктураРПС, ЭтоАвтономноеУчреждение, ЭтоБюджетноеУчреждение, ЭтоКазенноеУчреждение, ПолномочияАДБ, ПолномочияГАДБ,
			|ПлательщикНалогаНаПрибыль, ПрименяетсяУСНДоходы, ПрименяетсяУСНДоходыМинусРасходы, ПлательщикЕНВД,
			|ВедениеАналитическогоУчетаИмуществаКазны, НачислятьАмортизациюИмуществаКазны, НачислятьАмортизациюПервымЧислом");
		Форма.КэшПараметров.УчетнаяПолитика.ДатаПоследнегоИзменения = УчетнаяПолитика.Период;
		
		// Если изменилась Организация, обновим даты изменения учетной политики.
		Если Форма.КэшПараметров.Организация <> Объект.Организация Тогда
			Форма.КэшПараметров.УчетнаяПолитика.ДатыИзменения =
				БухгалтерскийУчет.ДатыИзмененияУчетнойПолитики(Объект.Организация);
		КонецЕсли;
		
		// Инициируем изменение параметров функциональных опций формы.
		ОбщегоНазначенияБГУКлиентСервер.УстановитьПараметрОрганизацияФункциональныхОпцийФормы(Форма,
			Объект.Организация, ДатаОпределенияУчетнойПолитики);
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма.Элементы, "БухгалтерскаяОперация") Тогда
			БухгалтерскиеОперацииКлиентСервер.ОбновитьВидимостьОбязательныхЭлементов(Форма);
			БухгалтерскиеОперацииСервер.ПриИзмененииПараметровФункциональныхОпций(Форма.Элементы.БухгалтерскаяОперация);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ДатаОпределенияУчетнойПолитикиДляДокумента(Форма, Объект)
	
	ДатаДокумента = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, Форма.КэшПараметров.Дата);
	
	// В большинстве случаев совпадает с датой документа.
	ДатаОпределенияУчетнойПолитики = ДатаДокумента;
	
	Если ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ВводНачальныхОстатков")
	 ИЛИ ТипЗнч(Объект.Ссылка) = Тип("ДокументСсылка.ВводНачальныхОстатковОС") Тогда
		// Про вводе начальных остатков учетную политику определяем на первое число следующего года.
		ДатаОпределенияУчетнойПолитики = КонецГода(ДатаДокумента) + 1;
		
	ИначеЕсли ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Объект, "ВидМежотчетногоПериода")
		И ЗначениеЗаполнено(Объект.ВидМежотчетногоПериода) Тогда
		// Документы с заполненным реквизитом ВидМежотчетногоПериода аналогичны вводу остатков на следующий год.
		ДатаОпределенияУчетнойПолитики = КонецГода(ДатаДокумента) + 1;
		
	КонецЕсли;
	
	Возврат ДатаОпределенияУчетнойПолитики;
	
КонецФункции

Процедура ПриЧтенииНаСервере(Форма, Объект) Экспорт
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ПроцессыОбработкиДокументов") Тогда
		МодульПроцессыОбработкиДокументов = ОбщегоНазначения.ОбщийМодуль("ПроцессыОбработкиДокументов");
		МодульПроцессыОбработкиДокументов.ПриЧтенииНаСервере(Форма, Объект);
	КонецЕсли;
	
	ВнутреннийЭДО.ПриЧтенииНаСервере(Форма, Объект);
	
	// Даты проведения документов
	//
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "ДатыПроведенияДокументов") Тогда  
		Форма.ДокументСсылка = Объект.Ссылка;
		ПрочитатьЗаписьДляРедактированияВФорме(Форма, "ДатыПроведенияДокументов", Новый Структура("Документ", Форма.ДокументСсылка));
		Форма.ДатаПроведенияЗаголовок = ?(ЗначениеЗаполнено(Форма.ДатыПроведенияДокументов.ДатаПроведения), Форма.ДатыПроведенияДокументов.ДатаПроведения, Объект.Дата);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриСозданииНаСервере(Форма, Объект) Экспорт
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ПроцессыОбработкиДокументов") Тогда
		МодульПроцессыОбработкиДокументов = ОбщегоНазначения.ОбщийМодуль("ПроцессыОбработкиДокументов");
		МодульПроцессыОбработкиДокументов.ПриСозданииНаСервере(Форма, Объект);
	КонецЕсли;
	
	ВнутреннийЭДО.ПриСозданииНаСервере(Форма, Объект);   
	
	// Даты проведения документов
	//
	Если Форма.Параметры.Ключ.Пустая() 
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "ДатыПроведенияДокументов")
		Тогда
		Форма.ДокументСсылка = Документы[Объект.Ссылка.Метаданные().Имя].ПолучитьСсылку();
		ИнициализироватьЗаписьДляРедактированияВФорме(Форма, "ДатыПроведенияДокументов", Новый Структура("Документ",  Форма.ДокументСсылка));  
		Форма.ДатаПроведенияЗаголовок = ?(ЗначениеЗаполнено(Форма.ДатыПроведенияДокументов.ДатаПроведения), Форма.ДатыПроведенияДокументов.ДатаПроведения, 
		?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДатаСеанса())); 
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписьюНаСервере(Форма, ТекущийОбъект, ПараметрыЗаписи, Отказ) Экспорт
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ПроцессыОбработкиДокументов") Тогда
		МодульПроцессыОбработкиДокументов = ОбщегоНазначения.ОбщийМодуль("ПроцессыОбработкиДокументов");
		МодульПроцессыОбработкиДокументов.ПередЗаписьюНаСервере(Форма, ТекущийОбъект, ПараметрыЗаписи, Отказ);
	КонецЕсли;
	
	// Даты проведения документов
	// Дата проведения из формы записывается в Дополнительные свойства.
	// Запись регистра производится в процедуре "ПриЗаписи" модуля объекта.
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "ДатыПроведенияДокументов") Тогда  
		ТекущийОбъект.ДополнительныеСвойства.Вставить("ОтдельнаяДатаПроведения", Форма.ДатыПроведенияДокументов.ДатаПроведения); 
	КонецЕсли;
	
КонецПроцедуры  

Процедура ПослеЗаписиНаСервере(Форма, ТекущийОбъект, ПараметрыЗаписи) Экспорт
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ПроцессыОбработкиДокументов") Тогда
		МодульПроцессыОбработкиДокументов = ОбщегоНазначения.ОбщийМодуль("ПроцессыОбработкиДокументов");
		МодульПроцессыОбработкиДокументов.ПослеЗаписиНаСервере(Форма, ТекущийОбъект, ПараметрыЗаписи);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриСозданииНаСервереФормыСписка(Форма, ДинамическийСписок, ИмяКолонки = "Статус",
	ЗаголовокКолонки = Неопределено, ПоложениеКолонки = 0) Экспорт
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ПроцессыОбработкиДокументов") Тогда
		МодульПроцессыОбработкиДокументов = ОбщегоНазначения.ОбщийМодуль("ПроцессыОбработкиДокументов");
		МодульПроцессыОбработкиДокументов.ПриСозданииНаСервереФормыСписка(
			Форма, ДинамическийСписок, ИмяКолонки, ЗаголовокКолонки, ПоложениеКолонки);
	КонецЕсли;
	
	ВнутреннийЭДО.ПриСозданииНаСервереФормыСписка(Форма, ДинамическийСписок); 
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ДатаПроведения", "Видимость", ПолучитьФункциональнуюОпцию("ИспользоватьОтдельнуюДатуПроведенияДокументов"));
	
КонецПроцедуры

Процедура ВыполнитьЗадачу(Форма, Контекст, Источник) Экспорт
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ПроцессыОбработкиДокументов") Тогда
		МодульПроцессыОбработкиДокументов = ОбщегоНазначения.ОбщийМодуль("ПроцессыОбработкиДокументов");
		МодульПроцессыОбработкиДокументов.ВыполнитьЗадачу(Форма, Контекст, Источник);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриИзмененииКлючевогоРеквизита(Форма, Объект) Экспорт
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ПроцессыОбработкиДокументов") Тогда
		МодульПроцессыОбработкиДокументов = ОбщегоНазначения.ОбщийМодуль("ПроцессыОбработкиДокументов");
		МодульПроцессыОбработкиДокументов.ВыполнитьЗадачу(Форма, "ОбновитьРеквизитыПоШаблонуПроцесса", Объект);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ГолосованиеКомиссии

// Функция возвращает таблицу с результатами голосования сотрудника по строкам документа.
// Значение в колонке ИдентификаторСтроки соответствует идентификатору строки документа.
// 
// Параметры:
//  Сотрудник - СправочникСсылка.Сотрудники
//  Документ - ОпределяемыйТип.ДокументыСГолосованиемКомиссии
//  Комиссия - СправочникСсылка.ПостоянноДействующиеКомиссии
//  Организация - СправочникСсылка.Организации
// 
// Возвращаемое значение:
//  ТаблицаЗначений -- таблица с результатами голосования:
//   * ИдентификаторСтроки - Строка
//   * РезультатГолосования - ПеречислениеСсылка.РезультатыГолосованияЧленовКомиссии
Функция РезультатыГолосованияСотрудникаПоДокументу(Сотрудник, Документ, Комиссия, Организация) Экспорт
	
	РезультатыГолосованияСотрудника = Новый ТаблицаЗначений;
	
	Если Не ЗначениеЗаполнено(Сотрудник)
		ИЛИ Не ЗначениеЗаполнено(Документ)
		ИЛИ Не ЗначениеЗаполнено(Комиссия)
		ИЛИ Не ЗначениеЗаполнено(Организация) Тогда
		Возврат РезультатыГолосованияСотрудника;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	РезультатыГолосованияКомиссий.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	РезультатыГолосованияКомиссий.РезультатГолосования КАК РезультатГолосования
	|ИЗ
	|	РегистрСведений.РезультатыГолосованияКомиссий КАК РезультатыГолосованияКомиссий
	|ГДЕ
	|	РезультатыГолосованияКомиссий.Организация = &Организация
	|	И РезультатыГолосованияКомиссий.Комиссия = &Комиссия
	|	И РезультатыГолосованияКомиссий.Сотрудник = &Сотрудник
	|	И РезультатыГолосованияКомиссий.ДокументОснование = &Документ";
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Комиссия",    Комиссия);
	Запрос.УстановитьПараметр("Сотрудник",   Сотрудник);
	Запрос.УстановитьПараметр("Документ",    Документ);
	
	РезультатыГолосованияСотрудника = Запрос.Выполнить().Выгрузить();
	РезультатыГолосованияСотрудника.Индексы.Добавить("ИдентификаторСтроки");
	
	Возврат РезультатыГолосованияСотрудника;
	
КонецФункции

// Функция возвращает таблицу со сводными результатами голосования комиссий по документам.
// 
// Параметры:
//  ДокументыДляГолосования - ДокументСсылка - документ(ы), для которых нужно получить результаты голосования.
//                          - Массив из ДокументСсылка -
//  Комиссия - СправочникСсылка.ПостоянноДействующиеКомиссии - отбор результатов голосования по Комиссии (при вызове из формы).
//  Организация - СправочникСсылка.Организации - отбор результатов голосования по Организации (при вызове из формы).
//
// Возвращаемое значение:
//  ТаблицаЗначений - ТаблицаЗначений -таблица с результатами голосования: 
//   * Документ - ДокументСсылка - ссылка на документ,
//   * ИдентификаторСтроки - Строка - соответствует идентификатору строки документа (реквизит ИдентификаторСтроки табличной части документа),
//   * ВсегоСотрудников - Число - сводные итоги голосования, используемые при подсчете результатов.
//   * КоличествоПрисутствующихСотрудников - Число - сводные итоги голосования, используемые при подсчете результатов.
//   * КоличествоГолосовЗа - Число - сводные итоги голосования, используемые при подсчете результатов.
//   * КоличествоГолосовВсего - Число - сводные итоги голосования, используемые при подсчете результатов.
//   * ИтогГолосования - Число - (% голосов за) - результаты голосования комиссии по строке документа.
//   * РезолюцияКомиссииОдобрена - Булево - результаты голосования комиссии по строке документа.
//   * ГолосованиеПоСтрокеЗавершено - Булево - голосование по строке документа завершено, если проголосовали все присутствующие члены комиссии.
//
Функция РезультатыГолосованияКомиссийПоДокументам(ДокументыДляГолосования, Комиссия = Неопределено, Организация = Неопределено) Экспорт
	
	РезультатыГолосования = Новый ТаблицаЗначений;
	РезультатыГолосования.Колонки.Добавить("Документ", Документы.ТипВсеСсылки());
	РезультатыГолосования.Колонки.Добавить("ИдентификаторСтроки",
		Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(36)));
	// Сводные показатели голосования комиссии.
	РезультатыГолосования.Колонки.Добавить("ВсегоСотрудников",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(3, 0, ДопустимыйЗнак.Неотрицательный)));
	РезультатыГолосования.Колонки.Добавить("КоличествоПрисутствующихСотрудников",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(3, 0, ДопустимыйЗнак.Неотрицательный)));
	РезультатыГолосования.Колонки.Добавить("КоличествоГолосовЗа",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(3, 0, ДопустимыйЗнак.Неотрицательный)));
	РезультатыГолосования.Колонки.Добавить("КоличествоГолосовВсего",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(3, 0, ДопустимыйЗнак.Неотрицательный)));
	РезультатыГолосования.Колонки.Добавить("МинимальныйПроцентЗа",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(5, 2, ДопустимыйЗнак.Неотрицательный)));
	РезультатыГолосования.Колонки.Добавить("ИтогГолосования",
		Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(5, 2, ДопустимыйЗнак.Неотрицательный)));
	РезультатыГолосования.Колонки.Добавить("РезолюцияКомиссииОдобрена", Новый ОписаниеТипов("Булево"));
	РезультатыГолосования.Колонки.Добавить("ГолосованиеПоСтрокеЗавершено", Новый ОписаниеТипов("Булево"));
	
	Если ТипЗнч(ДокументыДляГолосования) = Тип("Массив") Тогда // По списку документов.
		
		Если ДокументыДляГолосования.Количество() = 0 Тогда
			Возврат РезультатыГолосования;
		КонецЕсли;
		
		ИмяДокумента = Метаданные.НайтиПоТипу(ТипЗнч(ДокументыДляГолосования[0])).Имя;
		
	Иначе // По документу.
		
		Если Не ЗначениеЗаполнено(ДокументыДляГолосования) Тогда
			Возврат РезультатыГолосования;
		КонецЕсли;
		
		ИмяДокумента = Метаданные.НайтиПоТипу(ТипЗнч(ДокументыДляГолосования)).Имя;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументыДляГолосования", ДокументыДляГолосования);
	Запрос.УстановитьПараметр("СоставКомиссии", ПолныйСоставКомиссий(ДокументыДляГолосования));
	
	ИндексыРезультатов = Новый Структура;
	ИндексыРезультатов.Вставить("ВТ_СоставКомиссии", ИндексыРезультатов.Количество());
	ИндексыРезультатов.Вставить("ПрисутствующиеСотрудникиКомиссии", ИндексыРезультатов.Количество());
	ИндексыРезультатов.Вставить("РезультатыГолосованияКомиссии", ИндексыРезультатов.Количество());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СоставКомиссии.Организация КАК Организация,
	|	СоставКомиссии.Ссылка КАК Ссылка,
	|	СоставКомиссии.Комиссия КАК Комиссия,
	|	СоставКомиссии.Сотрудник КАК Сотрудник,
	|	СоставКомиссии.Отсутствует КАК Отсутствует,
	|	СоставКомиссии.ПричинаОтсутствия КАК ПричинаОтсутствия,
	|	СоставКомиссии.ЭтоПредседатель КАК ЭтоПредседатель
	|ПОМЕСТИТЬ ВТ_СоставКомиссии
	|ИЗ
	|	&СоставКомиссии КАК СоставКомиссии
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СоставКомиссии.Организация КАК Организация,
	|	СоставКомиссии.Комиссия КАК Комиссия,
	|	СоставКомиссии.Сотрудник КАК Сотрудник,
	|	СоставКомиссии.Ссылка КАК ДокументОснование
	|ПОМЕСТИТЬ ПрисутствующиеСотрудникиКомиссии
	|ИЗ
	|	ВТ_СоставКомиссии КАК СоставКомиссии
	|ГДЕ
	|	НЕ СоставКомиссии.Отсутствует
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Организация,
	|	Комиссия,
	|	Сотрудник,
	|	ДокументОснование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РезультатыГолосованияКомиссий.ДокументОснование КАК Документ,
	|	РезультатыГолосованияКомиссий.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	РезультатыГолосованияКомиссий.Сотрудник КАК Сотрудник,
	|	РезультатыГолосованияКомиссий.РезультатГолосования КАК РезультатГолосования,
	|	ВЫБОР
	|		КОГДА РезультатыГолосованияКомиссий.РезультатГолосования = ЗНАЧЕНИЕ(Перечисление.РезультатыГолосованияЧленовКомиссии.За)
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК КоличествоГолосовЗа,
	|	1 КАК КоличествоГолосовВсего
	|ИЗ
	|	РегистрСведений.РезультатыГолосованияКомиссий КАК РезультатыГолосованияКомиссий
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПрисутствующиеСотрудникиКомиссии КАК СоставКомиссииВДокументе
	|		ПО РезультатыГолосованияКомиссий.Организация = СоставКомиссииВДокументе.Организация
	|			И РезультатыГолосованияКомиссий.Комиссия = СоставКомиссииВДокументе.Комиссия
	|			И РезультатыГолосованияКомиссий.Сотрудник = СоставКомиссииВДокументе.Сотрудник
	|			И РезультатыГолосованияКомиссий.ДокументОснование = СоставКомиссииВДокументе.ДокументОснование
	|ГДЕ
	|	РезультатыГолосованияКомиссий.ДокументОснование В(&ДокументыДляГолосования)
	|	И &УсловиеОрганизация
	|	И &УсловиеКомиссия
	|ИТОГИ
	|	СУММА(КоличествоГолосовЗа),
	|	СУММА(КоличествоГолосовВсего)
	|ПО
	|	Документ,
	|	ИдентификаторСтроки";
	
	Если ЗначениеЗаполнено(Организация) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОрганизация", "РезультатыГолосованияКомиссий.Организация = &Организация");
		Запрос.УстановитьПараметр("Организация", Организация);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОрганизация", "ИСТИНА");
	КонецЕсли;
	Если ЗначениеЗаполнено(Комиссия) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКомиссия", "РезультатыГолосованияКомиссий.Комиссия = &Комиссия");
		Запрос.УстановитьПараметр("Комиссия", Комиссия);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКомиссия", "ИСТИНА");
	КонецЕсли;
	
	ИндексыРезультатов.Вставить("СоставКомиссии", ИндексыРезультатов.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	СоставКомиссии.Ссылка КАК Документ,
	|	СоставКомиссии.Сотрудник КАК Сотрудник,
	|	СоставКомиссии.ПричинаОтсутствия КАК ПричинаОтсутствия,
	|	СоставКомиссии.ЭтоПредседатель КАК ЭтоПредседатель,
	|	1 КАК ВсегоСотрудников,
	|	ВЫБОР
	|		КОГДА СоставКомиссии.Отсутствует
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК КоличествоПрисутствующихСотрудников
	|ИЗ
	|	ВТ_СоставКомиссии КАК СоставКомиссии
	|ИТОГИ
	|	СУММА(ВсегоСотрудников),
	|	СУММА(КоличествоПрисутствующихСотрудников)
	|ПО
	|	Документ";
	
	ИндексыРезультатов.Вставить("ПараметрыГолосования", ИндексыРезультатов.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	ПараметрыГолосования.Ссылка КАК Документ,
	|	ПараметрыГолосования.Комиссия КАК Комиссия,
	|	ПараметрыГолосования.Комиссия.Кворум КАК Кворум,
	|	ПараметрыГолосования.Комиссия.МинимальныйПроцентЗа КАК МинимальныйПроцентЗа,
	|	ПараметрыГолосования.Комиссия.УчитыватьГолосПредседателя КАК УчитыватьГолосПредседателя
	|ИЗ
	|	Документ.СписаниеВосстановлениеЗадолженностиПоДоходам КАК ПараметрыГолосования
	|ГДЕ
	|	ПараметрыГолосования.Ссылка В(&ДокументыДляГолосования)";
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "СписаниеВосстановлениеЗадолженностиПоДоходам", ИмяДокумента);
	
	Результаты = Запрос.ВыполнитьПакет();
	
	ВыборкаСоставКомиссии = Результаты[ИндексыРезультатов.СоставКомиссии].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаПараметрыГолосования = Результаты[ИндексыРезультатов.ПараметрыГолосования].Выбрать();
	
	ВыборкаПоДокументам = Результаты[ИндексыРезультатов.РезультатыГолосованияКомиссии].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоДокументам.Следующий() Цикл
		
		ВыборкаПараметрыГолосования.Сбросить();
		Если Не ВыборкаПараметрыГолосования.НайтиСледующий(ВыборкаПоДокументам.Документ, "Документ") Тогда
			Продолжить; // Не определены параметры голосования.
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ВыборкаПараметрыГолосования.Комиссия) Тогда
			Продолжить; // Не выбрана комиссия в документе.
		КонецЕсли;
		
		ВсегоСотрудников = 0;
		КоличествоПрисутствующихСотрудников = 0;
		ЕстьКворум = Ложь;
		Председатель = Неопределено;
		
		ВыборкаСоставКомиссии.Сбросить();
		Если ВыборкаСоставКомиссии.НайтиСледующий(ВыборкаПоДокументам.Документ, "Документ") Тогда
			
			ВсегоСотрудников = ВыборкаСоставКомиссии.ВсегоСотрудников;
			КоличествоПрисутствующихСотрудников = ВыборкаСоставКомиссии.КоличествоПрисутствующихСотрудников;
			
			ЕстьКворум = ИндикаторКворумаПрисутствияКлиентСервер.ЕстьКворумПрисутствия(ВсегоСотрудников, КоличествоПрисутствующихСотрудников, ВыборкаПараметрыГолосования.Кворум);
			
			Если ВыборкаПараметрыГолосования.МинимальныйПроцентЗа = 50
				И ВыборкаПараметрыГолосования.УчитыватьГолосПредседателя Тогда // Особый случай равенства голосов 50/50.
				
				СоставКомиссии = ВыборкаСоставКомиссии.Выбрать();
				Если СоставКомиссии.НайтиСледующий(Истина, "ЭтоПредседатель") Тогда
					Председатель = СоставКомиссии.Сотрудник; // Определили председателя.
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		ВыборкаРезультатыГолосования = ВыборкаПоДокументам.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаРезультатыГолосования.Следующий() Цикл
			
			НоваяСтрока = РезультатыГолосования.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаРезультатыГолосования, "Документ,ИдентификаторСтроки,КоличествоГолосовЗа,КоличествоГолосовВсего");
			
			НоваяСтрока.ВсегоСотрудников = ВсегоСотрудников;
			НоваяСтрока.КоличествоПрисутствующихСотрудников = КоличествоПрисутствующихСотрудников;
			НоваяСтрока.МинимальныйПроцентЗа = ВыборкаПараметрыГолосования.МинимальныйПроцентЗа;
			
			НоваяСтрока.ИтогГолосования = ?(ВсегоСотрудников = 0, 0, Окр(100 * НоваяСтрока.КоличествоГолосовЗа / КоличествоПрисутствующихСотрудников, 2));
			
			НоваяСтрока.ГолосованиеПоСтрокеЗавершено = (НоваяСтрока.КоличествоПрисутствующихСотрудников = НоваяСтрока.КоличествоГолосовВсего);
			
			Если ЕстьКворум Тогда
				
				Если ВыборкаПараметрыГолосования.МинимальныйПроцентЗа = 50 И НоваяСтрока.ИтогГолосования = 50 Тогда // Особый случай равенства голосов 50/50.
					
					Если ВыборкаПараметрыГолосования.УчитыватьГолосПредседателя И ЗначениеЗаполнено(Председатель) Тогда
						// Решение по резолюции определяет голос председателя комиссии.
						ВыборкаРезультатыГолосованияСотрудников = ВыборкаРезультатыГолосования.Выбрать();
						Если ВыборкаРезультатыГолосованияСотрудников.НайтиСледующий(Председатель, "Сотрудник") Тогда
							НоваяСтрока.РезолюцияКомиссииОдобрена =
								(ВыборкаРезультатыГолосованияСотрудников.РезультатГолосования = Перечисления.РезультатыГолосованияЧленовКомиссии.За);
						Иначе
							НоваяСтрока.РезолюцияКомиссииОдобрена = Ложь;
						КонецЕсли;
					Иначе // Голос председателя не обладает особым весом, минимальный процент голосов "за" достигнут.
						НоваяСтрока.РезолюцияКомиссииОдобрена = Истина;
					КонецЕсли;
					
				ИначеЕсли НоваяСтрока.ИтогГолосования >= ВыборкаПараметрыГолосования.МинимальныйПроцентЗа Тогда
					НоваяСтрока.РезолюцияКомиссииОдобрена = Истина;
				Иначе
					НоваяСтрока.РезолюцияКомиссииОдобрена = Ложь;
				КонецЕсли;
				
			Иначе // Голосование не состоялось.
				НоваяСтрока.РезолюцияКомиссииОдобрена = Ложь;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	РезультатыГолосования.Индексы.Добавить("Документ,ИдентификаторСтроки");
	
	Возврат РезультатыГолосования;
	
КонецФункции

// Функция возвращает список идентификаторов строк, по которым комиссией принято положительное решение
//
// Параметры:
//  ДокументДляГолосования	 - ДокументСсылка - документ, для которого нужно получить результат положительного голосования.
// 
// Возвращаемое значение:
//  Массив - список идентификаторов строк.
//
Функция ОдобренныеОбъектыГолосования(ДокументДляГолосования) Экспорт
	
	РезультатыГолосования = ОбщегоНазначенияБГУ.РезультатыГолосованияКомиссийПоДокументам(ДокументДляГолосования);
	Одобренные = Новый Массив;
	Для Каждого РезультатГолосования Из РезультатыГолосования Цикл
		Если РезультатГолосования.РезолюцияКомиссииОдобрена Тогда
			Одобренные.Добавить(РезультатГолосования.ИдентификаторСтроки);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Одобренные;
	
КонецФункции

// Функция возвращает таблицу с составом комиссий и данными сотрудников - членов комиссий для вывода в печатных формах.
//
// Параметры:
//  ДокументыДляГолосования - ДокументСсылка, Массив из ДокументСсылка - документ(ы), для которых нужно получить состав комиссий.
//
// Возвращаемое значение:
//  ТаблицаЗначений - таблица с составом комиссий: 
//   * Ссылка - ДокументСсылка - ссылка на документ
//   * Дата - Дата - дата документа
//   * НомерСтроки - Число - номер строки табличной части "Комиссия" документа,
//   * Сотрудник - СправочникСсылка.Сотрудники - член комиссии, сотрудник организации,
//   * ФизическоеЛицо - СправочникСсылка.ФизическиеЛица - физическое лицо, сопоставленное сотруднику организации,
//   * Фамилия - Строка - ФИО сотрудника организации,
//   * Имя - Строка
//   * Отчество - Строка
//   * Должность - Строка - должность сотрудника организации,
//   * Председатель - Булево - информация об сотруднике в составе комиссии по документу.
//   * Отсутствует - Булево 
//   * ПричинаОтсутствия - Строка 
//   * ФайлОсобогоМнения - Строка
//
Функция СоставКомиссийПоДокументам(ДокументыДляГолосования, ИмяТабличнойЧастиСоставКомиссии = "СоставКомиссии") Экспорт
	
	Если ДокументыДляГолосования.Количество() = 0 Тогда
		Возврат Новый ТаблицаЗначений;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", ДокументыДляГолосования);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СоставКомиссииВСправочнике.Ссылка КАК Комиссия,
	|	СоставКомиссииВСправочнике.Сотрудник КАК Сотрудник,
	|	СоставКомиссииВСправочнике.СтатусЧленаКомиссии КАК СтатусЧленаКомиссии,
	|	СоставКомиссииВСправочнике.ОтветственныйИсполнитель КАК ОтветственныйИсполнитель
	|ПОМЕСТИТЬ
	|	// Ранее заполненные составы комиссий могут ошибочно содержать дубли сотрудников.
	|	// В таком случае для статуса члена комиссии используем первое по порядку обнаруженное значение.
	|	СвойстваЧленовКомиссии
	|ИЗ
	|	(ВЫБРАТЬ
	|		Док.Комиссия КАК Комиссия,
	|		СоставКомиссииВСправочнике.Сотрудник КАК Сотрудник,
	|		МИНИМУМ(СоставКомиссииВСправочнике.НомерСтроки) КАК НомерСтроки
	|	ИЗ
	|		Документ.РешениеОПрекращенииПризнанияАктивом КАК Док
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПостоянноДействующиеКомиссии.СоставКомиссии КАК СоставКомиссииВСправочнике
	|			ПО Док.Комиссия = СоставКомиссииВСправочнике.Ссылка
	|	СГРУППИРОВАТЬ ПО
	|		Док.Комиссия,
	|		СоставКомиссииВСправочнике.Сотрудник) КАК УникальныеСотрудники
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПостоянноДействующиеКомиссии.СоставКомиссии КАК СоставКомиссииВСправочнике
	|		ПО УникальныеСотрудники.Комиссия = СоставКомиссииВСправочнике.Ссылка
	|		И УникальныеСотрудники.Сотрудник = СоставКомиссииВСправочнике.Сотрудник
	|		И УникальныеСотрудники.НомерСтроки = СоставКомиссииВСправочнике.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СоставКомиссииВДокументе.Ссылка КАК Ссылка,
	|	СоставКомиссииВДокументе.Ссылка.Дата КАК Дата,
	|	СоставКомиссииВДокументе.НомерСтроки КАК НомерСтроки,
	|	СоставКомиссииВДокументе.Сотрудник КАК Сотрудник,
	|	СоставКомиссииВДокументе.Отсутствует КАК Отсутствует,
	|	СоставКомиссииВДокументе.ПричинаОтсутствия КАК ПричинаОтсутствия,
	|	СоставКомиссииВДокументе.Сотрудник.Контрагент.ЮридическоеФизическоеЛицо КАК ФизическоеЛицо,
	|	ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка) КАК ЗамещающийСотрудник,
	|	ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка) КАК ЗамещающийСотрудникФизическоеЛицо
	|ПОМЕСТИТЬ СоставыКомиссий
	|ИЗ
	|	Документ.РешениеОПрекращенииПризнанияАктивом.СоставКомиссии КАК СоставКомиссииВДокументе
	|ГДЕ
	|	СоставКомиссииВДокументе.Ссылка В(&МассивОбъектов)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Сотрудник,
	|	Дата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СоставыКомиссийФИО.Сотрудник КАК Сотрудник,
	|	СоставыКомиссийФИО.Дата КАК Дата,
	|	ФИОФизическихЛиц.Фамилия КАК Фамилия,
	|	ФИОФизическихЛиц.Имя КАК Имя,
	|	ФИОФизическихЛиц.Отчество КАК Отчество
	|ПОМЕСТИТЬ СоставыКомиссийФИО
	|ИЗ
	|	(ВЫБРАТЬ
	|		СписокСотрудников.Сотрудник КАК Сотрудник,
	|		СписокСотрудников.Дата КАК Дата,
	|		СписокСотрудников.ФизЛицо КАК ФизЛицо,
	|		МАКСИМУМ(ФИОФизическихЛиц.Период) КАК Период
	|	ИЗ
	|		(ВЫБРАТЬ
	|			СоставыКомиссий.Сотрудник КАК Сотрудник,
	|			СоставыКомиссий.ФизическоеЛицо КАК ФизЛицо,
	|			СоставыКомиссий.Дата КАК Дата
	|		ИЗ
	|			СоставыКомиссий
	|		
	|		ОБЪЕДИНИТЬ
	|		
	|		ВЫБРАТЬ
	|			СоставыКомиссий.ЗамещающийСотрудник КАК Сотрудник,
	|			СоставыКомиссий.ЗамещающийСотрудникФизическоеЛицо КАК ФизЛицо,
	|			СоставыКомиссий.Дата КАК Дата
	|		ИЗ
	|			СоставыКомиссий
	|		ГДЕ
	|			СоставыКомиссий.ЗамещающийСотрудник <> ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
	|		) КАК СписокСотрудников
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизическихЛиц КАК ФИОФизическихЛиц
	|			ПО СписокСотрудников.ФизЛицо = ФИОФизическихЛиц.ФизическоеЛицо
	|				И (ФИОФизическихЛиц.Период <= СписокСотрудников.Дата)
	|	
	|	СГРУППИРОВАТЬ ПО
	|		СписокСотрудников.Сотрудник,
	|		СписокСотрудников.ФизЛицо,
	|		СписокСотрудников.Дата) КАК СоставыКомиссийФИО
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизическихЛиц КАК ФИОФизическихЛиц
	|		ПО СоставыКомиссийФИО.Период = ФИОФизическихЛиц.Период
	|			И СоставыКомиссийФИО.ФизЛицо = ФИОФизическихЛиц.ФизическоеЛицо
	|
	|СГРУППИРОВАТЬ ПО
	|	СоставыКомиссийФИО.Сотрудник,
	|	СоставыКомиссийФИО.Дата,
	|	ФИОФизическихЛиц.Фамилия,
	|	ФИОФизическихЛиц.Имя,
	|	ФИОФизическихЛиц.Отчество
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Сотрудник,
	|	Дата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	СоставыКомиссийДатаСреза.Сотрудник КАК Сотрудник,
	|	СоставыКомиссийДатаСреза.Дата КАК Дата,
	|	ЕСТЬNULL(ДанныеСотрудников.Должность, ЗНАЧЕНИЕ(Справочник.Должности.ПустаяСсылка)) КАК Должность
	|ПОМЕСТИТЬ СоставыКомиссийДолжность
	|ИЗ
	|	(ВЫБРАТЬ
	|		СоставыКомиссий.Сотрудник КАК Сотрудник,
	|		СоставыКомиссий.Дата КАК Дата,
	|		МАКСИМУМ(ДанныеСотрудников.Период) КАК Период
	|	ИЗ
	|		СоставыКомиссий КАК СоставыКомиссий
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеСотрудников КАК ДанныеСотрудников
	|			ПО СоставыКомиссий.Сотрудник = ДанныеСотрудников.Сотрудник
	|				И (ДанныеСотрудников.Период <= СоставыКомиссий.Дата)
	|	СГРУППИРОВАТЬ ПО
	|		СоставыКомиссий.Сотрудник,
	|		СоставыКомиссий.Дата
	|	) КАК СоставыКомиссийДатаСреза
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеСотрудников КАК ДанныеСотрудников
	|		ПО СоставыКомиссийДатаСреза.Период = ДанныеСотрудников.Период
	|			И СоставыКомиссийДатаСреза.Сотрудник = ДанныеСотрудников.Сотрудник
	|		
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	СоставыКомиссийДатаСреза.Сотрудник КАК Сотрудник,
	|	СоставыКомиссийДатаСреза.Дата КАК Дата,
	|	ЕСТЬNULL(ДанныеСотрудников.Должность, ЗНАЧЕНИЕ(Справочник.Должности.ПустаяСсылка)) КАК Должность
	|ИЗ
	|	(ВЫБРАТЬ
	|		СоставыКомиссий.ЗамещающийСотрудник КАК Сотрудник,
	|		СоставыКомиссий.Дата КАК Дата,
	|		МАКСИМУМ(ДанныеСотрудников.Период) КАК Период
	|	ИЗ
	|		СоставыКомиссий КАК СоставыКомиссий
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеСотрудников КАК ДанныеСотрудников
	|			ПО СоставыКомиссий.ЗамещающийСотрудник = ДанныеСотрудников.Сотрудник
	|				И (ДанныеСотрудников.Период <= СоставыКомиссий.Дата)
	|	ГДЕ
	|		СоставыКомиссий.ЗамещающийСотрудник <> ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
	|	СГРУППИРОВАТЬ ПО
	|		СоставыКомиссий.ЗамещающийСотрудник,
	|		СоставыКомиссий.Дата
	|	) КАК СоставыКомиссийДатаСреза
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеСотрудников КАК ДанныеСотрудников
	|		ПО СоставыКомиссийДатаСреза.Период = ДанныеСотрудников.Период
	|			И СоставыКомиссийДатаСреза.Сотрудник = ДанныеСотрудников.Сотрудник
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Сотрудник,
	|	Дата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СоставыКомиссий.Ссылка КАК Ссылка,
	|	СоставыКомиссий.Дата КАК Дата,
	|	СоставыКомиссий.НомерСтроки КАК НомерСтроки,
	|	СоставыКомиссий.Сотрудник КАК Сотрудник,
	|	СоставыКомиссий.Отсутствует КАК Отсутствует,
	|	СоставыКомиссий.ПричинаОтсутствия КАК ПричинаОтсутствия,
	|	СоставыКомиссий.ФизическоеЛицо КАК ФизическоеЛицо,
	|	СоставыКомиссийДолжность.Должность КАК Должность,
	|	ЕСТЬNULL(СоставыКомиссийДолжность.Должность.Наименование, """") КАК НаименованиеДолжности,
	|	СоставыКомиссийФИО.Фамилия КАК Фамилия,
	|	СоставыКомиссийФИО.Имя КАК Имя,
	|	СоставыКомиссийФИО.Отчество КАК Отчество,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(ФайлыСотрудниковКДокументам.ФайлСотрудника КАК Справочник.Файлы), ЗНАЧЕНИЕ(Справочник.Файлы.ПустаяСсылка)) КАК ФайлОсобогоМнения,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(ФайлыСотрудниковКДокументам.ФайлСотрудника КАК Справочник.Файлы).Наименование, """") КАК НаименованиеФайлаОсобогоМнения,
	|	
	|	ЕСТЬNULL(СвойстваЧленовКомиссии.СтатусЧленаКомиссии, ЗНАЧЕНИЕ(Перечисление.СтатусыЧленовКомиссии.ПустаяСсылка)) КАК СтатусЧленаКомиссии,
	|	ЕСТЬNULL(СвойстваЧленовКомиссии.ОтветственныйИсполнитель, ЛОЖЬ) КАК ОтветственныйИсполнитель,
	|	ЕСТЬNULL(СвойстваЧленовКомиссии.СтатусЧленаКомиссии = ЗНАЧЕНИЕ(Перечисление.СтатусыЧленовКомиссии.Председатель), ЛОЖЬ) КАК Председатель,
	|	ЕСТЬNULL(СвойстваЧленовКомиссии.СтатусЧленаКомиссии = ЗНАЧЕНИЕ(Перечисление.СтатусыЧленовКомиссии.УполномоченноеПредседателемЛицо), ЛОЖЬ) КАК УполномоченноеПредседателемЛицо,
	|
	|	СоставыКомиссий.ЗамещающийСотрудник КАК ЗамещающийСотрудник,
	|	СоставыКомиссий.ЗамещающийСотрудникФизическоеЛицо КАК ЗамещающийСотрудникФизическоеЛицо,
	|	ЕСТЬNULL(СвойстваЧленовКомиссииЗамещающийСотрудник.СтатусЧленаКомиссии, ЗНАЧЕНИЕ(Перечисление.СтатусыЧленовКомиссии.ПустаяСсылка)) КАК ЗамещающийСотрудникСтатусЧленаКомиссии,
	|	ЕСТЬNULL(СвойстваЧленовКомиссииЗамещающийСотрудник.ОтветственныйИсполнитель, ЛОЖЬ) КАК ЗамещающийСотрудникОтветственныйИсполнитель,
	|	ЕСТЬNULL(СоставыКомиссийДолжностьЗамещающийСотрудник.Должность, ЗНАЧЕНИЕ(Справочник.Должности.ПустаяСсылка)) КАК ЗамещающийСотрудникДолжность,
	|	ЕСТЬNULL(СоставыКомиссийДолжностьЗамещающийСотрудник.Должность.Наименование, """") КАК ЗамещающийСотрудникНаименованиеДолжности,
	|	ЕСТЬNULL(СоставыКомиссийФИОЗамещающийСотрудник.Фамилия, """") КАК ЗамещающийСотрудникФамилия,
	|	ЕСТЬNULL(СоставыКомиссийФИОЗамещающийСотрудник.Имя, """") КАК ЗамещающийСотрудникИмя,
	|	ЕСТЬNULL(СоставыКомиссийФИОЗамещающийСотрудник.Отчество, """") КАК ЗамещающийСотрудникОтчество
	|ИЗ
	|	СоставыКомиссий КАК СоставыКомиссий
	|		ЛЕВОЕ СОЕДИНЕНИЕ СоставыКомиссийФИО КАК СоставыКомиссийФИО
	|		ПО СоставыКомиссий.Сотрудник = СоставыКомиссийФИО.Сотрудник
	|			И СоставыКомиссий.Дата = СоставыКомиссийФИО.Дата
	|		ЛЕВОЕ СОЕДИНЕНИЕ СоставыКомиссийДолжность КАК СоставыКомиссийДолжность
	|		ПО СоставыКомиссий.Сотрудник = СоставыКомиссийДолжность.Сотрудник
	|			И СоставыКомиссий.Дата = СоставыКомиссийДолжность.Дата
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФайлыСотрудниковКДокументам КАК ФайлыСотрудниковКДокументам
	|		ПО СоставыКомиссий.Ссылка = ФайлыСотрудниковКДокументам.Документ
	|			И СоставыКомиссий.Сотрудник = ФайлыСотрудниковКДокументам.Сотрудник
	|		ЛЕВОЕ СОЕДИНЕНИЕ СвойстваЧленовКомиссии КАК СвойстваЧленовКомиссии
	|		ПО СоставыКомиссий.Ссылка.Комиссия = СвойстваЧленовКомиссии.Комиссия
	|			И СоставыКомиссий.Сотрудник = СвойстваЧленовКомиссии.Сотрудник
	|		ЛЕВОЕ СОЕДИНЕНИЕ СвойстваЧленовКомиссии КАК СвойстваЧленовКомиссииЗамещающийСотрудник
	|		ПО СоставыКомиссий.Ссылка.Комиссия = СвойстваЧленовКомиссии.Комиссия
	|			И СоставыКомиссий.ЗамещающийСотрудник = СвойстваЧленовКомиссии.Сотрудник
	|		ЛЕВОЕ СОЕДИНЕНИЕ СоставыКомиссийДолжность КАК СоставыКомиссийДолжностьЗамещающийСотрудник
	|		ПО СоставыКомиссий.ЗамещающийСотрудник = СоставыКомиссийДолжностьЗамещающийСотрудник.Сотрудник
	|			И СоставыКомиссий.Дата = СоставыКомиссийДолжностьЗамещающийСотрудник.Дата
	|		ЛЕВОЕ СОЕДИНЕНИЕ СоставыКомиссийФИО КАК СоставыКомиссийФИОЗамещающийСотрудник
	|		ПО СоставыКомиссий.ЗамещающийСотрудник = СоставыКомиссийФИОЗамещающийСотрудник.Сотрудник
	|			И СоставыКомиссий.Дата = СоставыКомиссийФИОЗамещающийСотрудник.Дата
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтроки";
	
	мДокумента = Метаданные.НайтиПоТипу(ТипЗнч(ДокументыДляГолосования[0]));
	
	ЕстьКолонкаЗамещающийСотрудник = мДокумента.ТабличныеЧасти[ИмяТабличнойЧастиСоставКомиссии].Реквизиты.Найти("ЗамещающийСотрудник") <> Неопределено;
	
	Если ЕстьКолонкаЗамещающийСотрудник Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка) КАК ЗамещающийСотрудник",
			"СоставКомиссииВДокументе.ЗамещающийСотрудник КАК ЗамещающийСотрудник");
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст,
			"ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка) КАК ЗамещающийСотрудникФизическоеЛицо",
			"ЕСТЬNULL(СоставКомиссииВДокументе.ЗамещающийСотрудник.Контрагент.ЮридическоеФизическоеЛицо, ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)) КАК ЗамещающийСотрудникФизическоеЛицо");
	КонецЕсли;
	
	ИмяДокумента = мДокумента.Имя;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "РешениеОПрекращенииПризнанияАктивом", ИмяДокумента);
	
	ПодстрокаПоиска = ".СоставКомиссии КАК СоставКомиссииВДокументе";
	ПодстрокаЗамены = СтрЗаменить(ПодстрокаПоиска, ".СоставКомиссии", "." + ИмяТабличнойЧастиСоставКомиссии);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, ПодстрокаПоиска, ПодстрокаЗамены);
	
	ЕстьПричина = (мДокумента.ТабличныеЧасти[ИмяТабличнойЧастиСоставКомиссии].Реквизиты.Найти("ПричинаОтсутствия") <> Неопределено);
	Если Не ЕстьПричина Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "СоставКомиссииВДокументе.ПричинаОтсутствия", """""");
	КонецЕсли;
	
	СоставКомиссий = Запрос.Выполнить().Выгрузить();
	СоставКомиссий.Колонки.Добавить("ОсобыеОтметки", Новый ОписаниеТипов("Строка"));
	
	Для Каждого ЧленКомиссии Из СоставКомиссий Цикл
		
		Если ЧленКомиссии.Отсутствует Тогда
			ЧленКомиссии.ОсобыеОтметки = ЧленКомиссии.ПричинаОтсутствия;
			ЧленКомиссии.ФайлОсобогоМнения = Справочники.Файлы.ПустаяСсылка();
		Иначе
			ЧленКомиссии.ОсобыеОтметки = ЧленКомиссии.НаименованиеФайлаОсобогоМнения;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СоставКомиссий;
	
КонецФункции

// Сохраняет результат голосования сотрудника (члена комиссии) по документу в регистре сведений.
// 
// Параметры:
//  ДокументДляГолосования - ФормаКлиентскогоПриложения
//  ЧленКомиссии - СправочникСсылка.Сотрудники
//  РезультатыГолосования - ПеречислениеСсылка.РезультатыГолосованияЧленовКомиссии
//                        - Массив из Структура
Процедура СохранитьРезультатыГолосованияНаСервере(ДокументДляГолосования, ЧленКомиссии, РезультатыГолосования) Экспорт
	
	Если ДокументДляГолосования.Ссылка.Пустая()
		ИЛИ Не ЗначениеЗаполнено(ДокументДляГолосования.Комиссия)
		ИЛИ Не ЗначениеЗаполнено(ДокументДляГолосования.Организация)
		ИЛИ Не ЗначениеЗаполнено(ЧленКомиссии) Тогда
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.РезультатыГолосованияКомиссий");
		ЭлементБлокировки.УстановитьЗначение("ДокументОснование", ДокументДляГолосования.Ссылка);
		ЭлементБлокировки.УстановитьЗначение("Сотрудник", ЧленКомиссии);
		Блокировка.Заблокировать();
	
		НаборЗаписей = РегистрыСведений.РезультатыГолосованияКомиссий.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Организация.Установить(ДокументДляГолосования.Организация);
		НаборЗаписей.Отбор.Комиссия.Установить(ДокументДляГолосования.Комиссия);
		НаборЗаписей.Отбор.ДокументОснование.Установить(ДокументДляГолосования.Ссылка);
		НаборЗаписей.Отбор.Сотрудник.Установить(ЧленКомиссии);
		НаборЗаписей.Прочитать();
		Если НаборЗаписей.Количество() > 0 Тогда
			НаборЗаписей.Очистить();
		КонецЕсли;
		НаборЗаписей.Записывать = Истина;
		
		Если ТипЗнч(РезультатыГолосования) = Тип("ПеречислениеСсылка.РезультатыГолосованияЧленовКомиссии")
			И ЗначениеЗаполнено(РезультатыГолосования) Тогда
		
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.Организация = ДокументДляГолосования.Организация;
			НоваяЗапись.Комиссия = ДокументДляГолосования.Комиссия;
			НоваяЗапись.Сотрудник = ЧленКомиссии;
			НоваяЗапись.ДокументОснование = ДокументДляГолосования.Ссылка;
			НоваяЗапись.ИдентификаторСтроки = "";
			НоваяЗапись.РезультатГолосования = РезультатыГолосования;
			
		ИначеЕсли ТипЗнч(РезультатыГолосования) = Тип("Массив")
			И РезультатыГолосования.Количество() > 0 Тогда
			
			Для Каждого РезультатГолосования Из РезультатыГолосования Цикл
				
				Если Не ЗначениеЗаполнено(РезультатГолосования.РешениеСотрудникаПоРезолюции) Тогда
					Продолжить;
				КонецЕсли;
				
				НоваяЗапись = НаборЗаписей.Добавить();
				НоваяЗапись.Организация = ДокументДляГолосования.Организация;
				НоваяЗапись.Комиссия = ДокументДляГолосования.Комиссия;
				НоваяЗапись.Сотрудник = ЧленКомиссии;
				НоваяЗапись.ДокументОснование = ДокументДляГолосования.Ссылка;
				НоваяЗапись.ИдентификаторСтроки = РезультатГолосования.ИдентификаторСтроки;
				НоваяЗапись.РезультатГолосования = РезультатГолосования.РешениеСотрудникаПоРезолюции;
				
			КонецЦикла;
			
		КонецЕсли;
		
		НаборЗаписей.Записать(Истина);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// Сохраняет результат голосования сотрудника (члена комиссии) по документу в регистре сведений.
// 
// Параметры:
//  ДокументДляГолосования - ДанныеФормыСтруктура:
//   * Ссылка - ОпределяемыйТип.ДокументыСГолосованиемКомиссии
//   * Комиссия - СправочникСсылка.ПостоянноДействующиеКомиссии
//   * Организация - СправочникСсылка.Организации
//  ИмяТабличнойЧасти - Строка
//  РезультатГолосования - ПеречислениеСсылка.РезультатыГолосованияЧленовКомиссии
Процедура УстановитьРешениеЕдиногласноНаСервере(ДокументДляГолосования, ИмяТабличнойЧасти, РезультатГолосования) Экспорт
	
	Если ДокументДляГолосования.Ссылка.Пустая()
		ИЛИ Не ЗначениеЗаполнено(ДокументДляГолосования.Комиссия)
		ИЛИ Не ЗначениеЗаполнено(ДокументДляГолосования.Организация) Тогда
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.РезультатыГолосованияКомиссий");
		ЭлементБлокировки.УстановитьЗначение("ДокументОснование", ДокументДляГолосования.Ссылка);
		Блокировка.Заблокировать();
		
		НаборЗаписей = РегистрыСведений.РезультатыГолосованияКомиссий.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Организация.Установить(ДокументДляГолосования.Организация);
		НаборЗаписей.Отбор.Комиссия.Установить(ДокументДляГолосования.Комиссия);
		НаборЗаписей.Отбор.ДокументОснование.Установить(ДокументДляГолосования.Ссылка);
		НаборЗаписей.Прочитать();
		Если НаборЗаписей.Количество() > 0 Тогда
			НаборЗаписей.Очистить();
		КонецЕсли;
		НаборЗаписей.Записывать = Истина;
		
		СоставКомиссии = ПолныйСоставКомиссий(ДокументДляГолосования);
		ОтборПрисутствующих = Новый Структура("Отсутствует", Ложь);
		ПрисутствующиеЧленыКомиссии = СоставКомиссии.НайтиСтроки(ОтборПрисутствующих);
		Для Каждого Присутствующий Из ПрисутствующиеЧленыКомиссии Цикл
			
			Для Каждого СтрокаЗадолженность Из ДокументДляГолосования[ИмяТабличнойЧасти] Цикл
				
				НоваяЗапись = НаборЗаписей.Добавить();
				НоваяЗапись.Организация = ДокументДляГолосования.Организация;
				НоваяЗапись.Комиссия = ДокументДляГолосования.Комиссия;
				НоваяЗапись.Сотрудник = Присутствующий.Сотрудник;
				НоваяЗапись.ДокументОснование = ДокументДляГолосования.Ссылка;
				НоваяЗапись.ИдентификаторСтроки = СтрокаЗадолженность.ИдентификаторСтроки;
				НоваяЗапись.РезультатГолосования = РезультатГолосования;
				
			КонецЦикла;
			
		КонецЦикла;
		
		НаборЗаписей.Записать(Истина);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура ЗаполнитьРезультатГолосования(Форма) Экспорт
	
	МодульМенеджера = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Форма.Объект.Ссылка);
	МодульМенеджера.ЗаполнитьРезультатГолосования(Форма);
	
КонецПроцедуры

Процедура УправлениеЭлементамиГолосования(Форма) Экспорт
	
	МодульМенеджера = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Форма.Объект.Ссылка);
