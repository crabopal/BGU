Процедура ИнициализироватьФормуДляВыбораРезолюций(Знач Форма, Знач ЭлементРезолюцииКомиссии) Экспорт
	
	ИмяРеквизитаНастроек = "НастройкиМеханизмаРезолюцииКомиссий";
	
	МассивИмен = СтрРазделить(ЭлементРезолюцииКомиссии.ПутьКДанным, ".");
	
	НастройкиМеханизма = Новый Структура();
	НастройкиМеханизма.Вставить("ИмяПоляРезолюция",	МассивИмен[МассивИмен.ВГраница()]);
	НастройкиМеханизма.Вставить("МассивРезолюций",	Новый ОписаниеТипов("Массив"));
	
	// Реквизиты формы
	ИнициализироватьФормуДляВыбораРезолюцииКомиссий_ДобавитьРеквизитыФормы(Форма, ИмяРеквизитаНастроек, НастройкиМеханизма);
	
	// Массив резолюций (кэш)
	ИнициализироватьФормуДляВыбораРезолюцииКомиссий_ЗаполнитьМассивРезолюций(Форма, НастройкиМеханизма);
	
	// Список выбора
	ИнициализироватьФормуДляВыбораРезолюцииКомиссий_ЗаполнитьСписокВыбораРезолюций(Форма, ЭлементРезолюцииКомиссии, НастройкиМеханизма);
	
	Форма[ИмяРеквизитаНастроек] = НастройкиМеханизма;
	
КонецПроцедуры

Функция ПолучитьМассивРезолюцийДляВидаДокумента(ДокументСсылка) Экспорт
	
	ИмяДокумента = ИмяДокументаПоСсылке(ДокументСсылка);
	
	ТаблицаРезолюций = ПолучитьТаблицуРезолюцийДляВидаДокумента(ИмяДокумента);
	
	Если ТаблицаРезолюций = Неопределено Тогда
		Возврат Новый Массив();
	КонецЕсли;
	
	Возврат ОбщегоНазначения.ТаблицаЗначенийВМассив(ТаблицаРезолюций);
	
КонецФункции

Функция ПолучитьПустуюТаблицуРезолюцийФормы() Экспорт
	
	ТипСтрока = Новый ОписаниеТипов("Строка");
	
	Таблица = Новый ТаблицаЗначений();
	Таблица.Колонки.Добавить("Текст",			ТипСтрока);
	Таблица.Колонки.Добавить("Идентификатор",	ТипСтрока);
	
	Возврат Таблица;
	
КонецФункции

#КонецОбласти

#Область МеханизмОзнакомленияСотрудников

Функция РезультатыОзнакомленияСотрудниковПоДокументам(СписокДокументов, ИменаТабличныхЧастей = "", Организация = Неопределено) Экспорт
	
	ТипДата = ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.ДатаВремя);
	
	РезультатыОзнакомления = Новый ТаблицаЗначений();
	РезультатыОзнакомления.Колонки.Добавить("Документ",		Документы.ТипВсеСсылки());
	РезультатыОзнакомления.Колонки.Добавить("ДокументДата",	ТипДата);
	РезультатыОзнакомления.Колонки.Добавить("НомерСтроки",	ОбщегоНазначения.ОписаниеТипаЧисло(6,0,ДопустимыйЗнак.Неотрицательный));
	РезультатыОзнакомления.Колонки.Добавить("Сотрудник",	Новый ОписаниеТипов(Метаданные.ОпределяемыеТипы.СотрудникДляОзнакомления.Тип));
	РезультатыОзнакомления.Колонки.Добавить("ВидДействия",	Новый ОписаниеТипов("ПеречислениеСсылка.ВидыДействийСотрудникаСДокументом"));
	РезультатыОзнакомления.Колонки.Добавить("Дата",			ТипДата);
	
	Если ТипЗнч(СписокДокументов) = Тип("Массив") Тогда // По списку документов.
		
		Если СписокДокументов.Количество() = 0 Тогда
			Возврат РезультатыОзнакомления;
		КонецЕсли;
		
		ИмяДокумента = Метаданные.НайтиПоТипу(ТипЗнч(СписокДокументов[0])).Имя;
		
	Иначе // По документу.
		
		Если Не ЗначениеЗаполнено(СписокДокументов) Тогда
			Возврат РезультатыОзнакомления;
		КонецЕсли;
		
		ИмяДокумента = Метаданные.НайтиПоТипу(ТипЗнч(СписокДокументов)).Имя;
		
	КонецЕсли;
	
	ТаблицаНастроекДокумента = МеханизмОзнакомленияСотрудников_ПолучитьТаблицуНастроекДокумента(ИмяДокумента);
	
	МассивИменТабличныхЧастей = СтрРазделить(ИменаТабличныхЧастей, ", ", Ложь);
	
	Если МассивИменТабличныхЧастей.Количество() = 0 Тогда
		Для Каждого СтрокаТаблицыНастроек Из ТаблицаНастроекДокумента Цикл
			МассивИменТабличныхЧастей.Добавить(СтрокаТаблицыНастроек.ИмяТабличнойЧасти);
		КонецЦикла;
	КонецЕсли;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("СписокДокументов", СписокДокументов);
	
	ТекстЗапроса = " 
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Результаты ознакомления из регистра
	|//
	|ВЫБРАТЬ
	|	ДокументОснование	КАК Документ,
	|	Сотрудник			КАК Сотрудник,
	|	ВидДействия			КАК ВидДействия,
	|	Дата				КАК Дата
	|ИЗ
	|	РегистрСведений.РезультатыОзнакомленияСотрудников
	|ГДЕ
	|	ДокументОснование В(&СписокДокументов)
	|	И &УсловиеОрганизация
	|;	
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Списки сотрудников из документов
	|//";
	
	ТекстШаблонСпискиСотрудников = "
	|ВЫБРАТЬ
	|	Ссылка		КАК Документ,
	|	Ссылка.Дата	КАК ДокументДата,
	|	НомерСтроки	КАК НомерСтроки,
	|	Сотрудник	КАК Сотрудник,
	|	&%3			КАК ВидДействия
	|ИЗ
	|	Документ.%1.%2
	|ГДЕ
	|	Ссылка В(&СписокДокументов)
	|";
	
	ТекстОбъединитьВсе = "
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|";
	
	Счетчик = 0;
	
	Для Каждого СтрокаТаблицыНастроек Из ТаблицаНастроекДокумента Цикл
		ИмяТабличнойЧасти					= СтрокаТаблицыНастроек.ИмяТабличнойЧасти;
		ВидДействияСотрудникаСДокументом	= СтрокаТаблицыНастроек.ВидДействияСотрудникаСДокументом;
		
		Если МассивИменТабличныхЧастей.Найти(ИмяТабличнойЧасти) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Счетчик = Счетчик + 1;
		
		ВидДействияСтрокой = ВидДействияСотрудникаСДокументом.Метаданные().Имя;
		
		ИмяПараметраВидДействия = СтрШаблон("ВидДействия%1", ВидДействияСтрокой);
		
		Запрос.УстановитьПараметр(ИмяПараметраВидДействия, ВидДействияСотрудникаСДокументом);
		
		ТекстЗапроса = ТекстЗапроса
			+ ?(Счетчик > 1, ТекстОбъединитьВсе, "")
			+ СтрШаблон(ТекстШаблонСпискиСотрудников, ИмяДокумента, ИмяТабличнойЧасти, ИмяПараметраВидДействия);
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Организация) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеОрганизация", "Организация = &Организация");
		
		Запрос.УстановитьПараметр("Организация", Организация);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеОрганизация", "ИСТИНА");
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	УстановитьПривилегированныйРежим(Ложь);
	
	// [0]. Результаты ознакомления из регистра
	ТаблицаДанныеРегистра = РезультатыЗапроса[0].Выгрузить();
	
	// [1]. Списки сотрудников из документов
	ТаблицаДанныеДокументов = РезультатыЗапроса[1].Выгрузить();
	
	Поиск = Новый Структура("Документ,ВидДействия,Сотрудник");
	
	Для Каждого СтрокаДанныхДокумента Из ТаблицаДанныеДокументов Цикл
		НоваяСтрока = РезультатыОзнакомления.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДанныхДокумента);
		
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаДанныхДокумента);
		
		МассивСтрок = ТаблицаДанныеРегистра.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() > 0 Тогда
			СтрокаТаблицыРегистра = МассивСтрок[0];
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицыРегистра, "Дата");
		КонецЕсли;
	КонецЦикла;
	
	РезультатыОзнакомления.Индексы.Добавить("Документ,ВидДействия");
	
	Возврат РезультатыОзнакомления;
	
КонецФункции

Процедура МеханизмОзнакомленияСотрудников_УстановитьДоступностьЭлементов(Форма) Экспорт
	
	НастройкиМеханизма = Форма.НастройкиМеханизмаОзнакомленияСотрудников;
	
	Для Каждого ЭлементОписания Из НастройкиМеханизма.ТабличныеЧасти Цикл
		ИмяТабличнойЧасти = ЭлементОписания.Ключ;
		
		МеханизмОзнакомленияСотрудников_УстановитьДоступностьЭлементовТабличнойЧасти(Форма, ИмяТабличнойЧасти);
	КонецЦикла;
	
КонецПроцедуры

Процедура МеханизмОзнакомленияСотрудников_УстановитьДоступностьЭлементовТабличнойЧасти(Форма, ИмяТабличнойЧасти) Экспорт
	
	ДопустимоРедактирование = Форма.МеханизмОзнакомленияСотрудников_ДопустимоРедактирование;
	
	НастройкиМеханизма = Форма.НастройкиМеханизмаОзнакомленияСотрудников;
	
	ОписаниеТабличнойЧасти = НастройкиМеханизма.ТабличныеЧасти[ИмяТабличнойЧасти];
	
	ИменаРеквизитов	= ОписаниеТабличнойЧасти.ИменаРеквизитов;
	ИменаКоманд		= ОписаниеТабличнойЧасти.ИменаКоманд;
	ИменаЭлементов	= ОписаниеТабличнойЧасти.ИменаЭлементов;
	
	Модифицированность	= Форма[ИменаРеквизитов.Модифицированность];
	
	ДопустимоЕдиновременноеДействиеВсехСотрудников = ОписаниеТабличнойЧасти.ДопустимоЕдиновременноеДействиеВсехСотрудников;
	ВидДействия = НастройкиМеханизма.СоответствиеВидДействия.Получить(ИмяТабличнойЧасти);
	
	Если Не ОбщегоНазначенияБГУКлиентСервер.МеханизмОзнакомленияСотрудников_УстановленОтборСотрудника(Форма) Тогда
		// Если отбор сотрудника установлен, то соответствующая настройка формы уже выполнена ранее,
		// и повторная настройка не требуется
		
		Сотрудник	= Форма[ИменаРеквизитов.Сотрудник];
		Флажок		= Форма[ИменаРеквизитов.Флажок];
		
		// Реквизиты
		Если НастройкиМеханизма.УстанавливатьДоступностьЭлементов Тогда
			Форма.Элементы[ИменаРеквизитов.Сотрудник].ТолькоПросмотр = Не ДопустимоРедактирование;
		КонецЕсли;
		
		Форма.Элементы[ИменаРеквизитов.Сотрудник].ПодсказкаВвода = ?(ДопустимоЕдиновременноеДействиеВсехСотрудников,
			НСтр("ru='Все указанные сотрудники'"),
			НСтр("ru='Сотрудник'"));
		
		Если НастройкиМеханизма.УстанавливатьДоступностьЭлементов Тогда
			Форма.Элементы[ИменаРеквизитов.Флажок].ТолькоПросмотр =
				?(ДопустимоЕдиновременноеДействиеВсехСотрудников,
					Ложь,
					Не ДопустимоРедактирование Или Не ЗначениеЗаполнено(Сотрудник));
		КонецЕсли;
		
		Если ВидДействия = ПредопределенноеЗначение("Перечисление.ВидыДействийСотрудникаСДокументом.Ознакомление") Тогда
			Заголовок = ?(ДопустимоЕдиновременноеДействиеВсехСотрудников И Не ЗначениеЗаполнено(Сотрудник),
				НСтр("ru='Ознакомлены все единовременно'"),
				НСтр("ru='Ознакомлен'"));
				
		ИначеЕсли ВидДействия = ПредопределенноеЗначение("Перечисление.ВидыДействийСотрудникаСДокументом.Согласование") Тогда
			Заголовок = ?(ДопустимоЕдиновременноеДействиеВсехСотрудников И Не ЗначениеЗаполнено(Сотрудник),
				НСтр("ru='Согласовано всеми единовременно'"),
				НСтр("ru='Согласовано'"));
				
		Иначе
			Заголовок = НСтр("ru='<Действие>'");
		КонецЕсли;
		
		Форма.Элементы[ИменаРеквизитов.Флажок].Заголовок = Заголовок;
		
		Если НастройкиМеханизма.УстанавливатьДоступностьЭлементов Тогда
			Форма.Элементы[ИменаРеквизитов.Дата].ТолькоПросмотр = ?(ДопустимоЕдиновременноеДействиеВсехСотрудников,
				Ложь,
				Не ДопустимоРедактирование Или Не Флажок);
		КонецЕсли;
	КонецЕсли;
	
	// Команды
	
	Если НастройкиМеханизма.УстанавливатьДоступностьЭлементов Тогда
		Форма.Элементы[ИменаКоманд.СохранитьРезультаты].Доступность = ДопустимоРедактирование И Модифицированность;
	КонецЕсли;
	
	Если Не ОбщегоНазначенияБГУКлиентСервер.МеханизмОзнакомленияСотрудников_УстановленОтборСотрудника(Форма)
		И ДопустимоЕдиновременноеДействиеВсехСотрудников И Не ЗначениеЗаполнено(Сотрудник) Тогда
		Форма.Элементы[ИменаКоманд.СохранитьРезультаты].Картинка = БиблиотекаКартинок.ГрупповоеОбсуждение;
		Форма.Элементы[ИменаКоманд.СохранитьРезультаты].Заголовок = НСтр("ru='Сохранить результаты'");
	Иначе
		Форма.Элементы[ИменаКоманд.СохранитьРезультаты].Картинка = БиблиотекаКартинок.ПользовательСистемыВзаимодействия;
		Форма.Элементы[ИменаКоманд.СохранитьРезультаты].Заголовок = НСтр("ru='Сохранить результат'");
	КонецЕсли;
	
	// Индикатор
	
	Если НастройкиМеханизма.ЕстьПравоЗаписиРезультатовОзнакомления Тогда
		Если ДопустимоРедактирование Тогда
			ИмяСтраницы = ИменаЭлементов.СтраницаДанные;
		Иначе
			ИмяСтраницы = ИменаЭлементов.СтраницаРедактированиеНедоступно;
		КонецЕсли;
	Иначе
		ИмяСтраницы = ИменаЭлементов.СтраницаДоступОтсутствует;
	КонецЕсли;
	
	Форма.Элементы[ИменаЭлементов.ПанельСтраницы].ТекущаяСтраница = Форма.Элементы[ИмяСтраницы];
	
КонецПроцедуры

Процедура МеханизмОзнакомленияСотрудников_ОтключитьУстановкуДоступностиЭлементов(Форма) Экспорт
	
	Если Форма.НастройкиМеханизмаОзнакомленияСотрудников = Неопределено Тогда
		Форма.НастройкиМеханизмаОзнакомленияСотрудников = МеханизмОзнакомленияСотрудников_СоздатьНастройкиИзПОД();
	Иначе
		Форма.НастройкиМеханизмаОзнакомленияСотрудников.УстанавливатьДоступностьЭлементов = Ложь;
	КонецЕсли;
	
КонецПроцедуры

#Область ОбработчикиСобытийИКоманд

// Форма документа

// Инициализирует механизм на форме документа.
//
// Параметры:
//	Форма	- ФормаКлиентскогоПриложения	- форма документа, к которой подключается механизм.
//	ДопустимыРазличныеДатыДействийОдногоСотрудника	- Булево	- признак возможности указания различных дат для различных действий одного сотрудника.
//						При указании значения Истина перед записью результата действия сотрудника выполняется проверка конфликта дат,
//						и в случае обнаруженияя конфликта выводится сообщение, запись данных не выполняется.
//	ОтборСотрудника	- Соответствие	- опциональный отбор сотрудника, запрещающий выбирать других сотрудников.
//						Ключ - СправочникСсылка.Сотрудники
//						Значение - ПеречислениеСсылка.ВидыДействийСотрудникаСДокументом
//						При передаче в параметре заполненного соответствия, панели механизма переводятся в ограниченный режим.
//						Для переданных видов действий устанавливается переданный сотрудник и отключается возможность выбрать другого сотрудника.
//						Можно указать лишь дату действия указанного сотрудника.
//						Для всех остальных видов действий блокируются панели механизма, выбор сотрудника и даты действия недоступны.
Процедура МеханизмОзнакомленияСотрудников_ИнициализироватьФорму(Форма, Знач ДопустимыРазличныеДатыДействийОдногоСотрудника = Ложь, Знач ОтборСотрудника = Неопределено) Экспорт
	
	Если Форма.НастройкиМеханизмаОзнакомленияСотрудников <> Неопределено
		И Не МеханизмОзнакомленияСотрудников_ЭтоНастройкиИзПОД(Форма.НастройкиМеханизмаОзнакомленияСотрудников) Тогда
		// Инициализация уже была выполнена ранее
		Возврат;
	КонецЕсли;
	
	МеханизмОзнакомленияСотрудников_ИнициализироватьНастройкиМеханизма(Форма, ДопустимыРазличныеДатыДействийОдногоСотрудника, ОтборСотрудника);
	
	МеханизмОзнакомленияСотрудников_УстановитьОтборСотрудника(Форма);
	
	МеханизмОзнакомленияСотрудников_ЗаполнитьКолонкиОзнакомления(Форма);
	
	МеханизмОзнакомленияСотрудников_ПроверитьДопустимостьРедактирования(Форма, Истина);
	
	МеханизмОзнакомленияСотрудников_УстановитьУсловноеОформление(Форма);
	
КонецПроцедуры

Процедура МеханизмОзнакомленияСотрудников_ПриЧтенииФормыНаСервере(Форма) Экспорт
	
	НастройкиМеханизма = Форма.НастройкиМеханизмаОзнакомленияСотрудников;
	
	ВыполненаИнициализацияМеханизма = (ТипЗнч(НастройкиМеханизма) = Тип("Структура") Или ТипЗнч(НастройкиМеханизма) = Тип("ФиксированнаяСтруктура"));
	
	Если Не ВыполненаИнициализацияМеханизма Тогда
		Возврат;
	КонецЕсли;
	
	МеханизмОзнакомленияСотрудников_ЗаполнитьКолонкиОзнакомления(Форма);
	
	МеханизмОзнакомленияСотрудников_ОбновитьПанельПослеЧтенияИлиЗаписиФормы(Форма);
	
КонецПроцедуры

Процедура МеханизмОзнакомленияСотрудников_ПередЗаписьюФормыНаСервере(Форма) Экспорт
	
	МеханизмОзнакомленияСотрудников_СохранитьРезультатыОзнакомления(Форма);
	
КонецПроцедуры

Процедура МеханизмОзнакомленияСотрудников_ПослеЗаписиФормыНаСервере(Форма) Экспорт
	
	МеханизмОзнакомленияСотрудников_УстановитьОтборСотрудника(Форма);
	
	МеханизмОзнакомленияСотрудников_ЗаполнитьКолонкиОзнакомления(Форма);
	
КонецПроцедуры

// Панель механизма

Процедура МеханизмОзнакомленияСотрудников_ПроверитьДопустимостьРедактирования(Форма, Инициализация = Ложь) Экспорт
	
	ДопустимоРедактирование = ОбщегоНазначенияБГУКлиентСервер.МеханизмОзнакомленияСотрудников_ДопустимоРедактирование(Форма);
	
	ЕстьИзменениеДоступности = (Форма.МеханизмОзнакомленияСотрудников_ДопустимоРедактирование <> ДопустимоРедактирование);
	
	Если Не Инициализация И Не ЕстьИзменениеДоступности Тогда
		Возврат;
	КонецЕсли;
	
	Форма.МеханизмОзнакомленияСотрудников_ДопустимоРедактирование = ДопустимоРедактирование;
	
	НастройкиМеханизма = Форма.НастройкиМеханизмаОзнакомленияСотрудников;
	
	Для Каждого ЭлементОписания Из НастройкиМеханизма.ТабличныеЧасти Цикл
		ИмяТабличнойЧасти		= ЭлементОписания.Ключ;
		ОписаниеТабличнойЧасти	= ЭлементОписания.Значение;
		
		Если Не ДопустимоРедактирование Тогда
			ИменаРеквизитов = ОписаниеТабличнойЧасти.ИменаРеквизитов;
			
			МеханизмОзнакомленияСотрудников_ОчиститьРеквизитыМеханизма(Форма, ИмяТабличнойЧасти);
		КонецЕсли;
		
		МеханизмОзнакомленияСотрудников_УстановитьДоступностьЭлементовТабличнойЧасти(Форма, ИмяТабличнойЧасти)
	КонецЦикла;
	
КонецПроцедуры

Процедура МеханизмОзнакомленияСотрудников_НастроитьФормуПослеПроверкиДопустимостиРедактирования(Форма) Экспорт
	
	ДопустимоРедактирование = Форма.МеханизмОзнакомленияСотрудников_ДопустимоРедактирование;
	
	НастройкиМеханизма = Форма.НастройкиМеханизмаОзнакомленияСотрудников;
	
	Для Каждого ЭлементОписания Из НастройкиМеханизма.ТабличныеЧасти Цикл
		ИмяТабличнойЧасти		= ЭлементОписания.Ключ;
		ОписаниеТабличнойЧасти	= ЭлементОписания.Значение;
		
		Если Не ДопустимоРедактирование Тогда
			ИменаРеквизитов = ОписаниеТабличнойЧасти.ИменаРеквизитов;
			
			МеханизмОзнакомленияСотрудников_ОчиститьРеквизитыМеханизма(Форма, ИмяТабличнойЧасти);
		КонецЕсли;
		
		МеханизмОзнакомленияСотрудников_УстановитьДоступностьЭлементовТабличнойЧасти(Форма, ИмяТабличнойЧасти)
	КонецЦикла;
	
КонецПроцедуры

Процедура МеханизмОзнакомленияСотрудников_СотрудникПриИзмененииСервер(Форма, ДополнительныеПараметры) Экспорт
	
	МеханизмОзнакомленияСотрудников_ЗаполнитьРезультатыОзнакомленияСотрудника(Форма, ДополнительныеПараметры);
	
	ОбщегоНазначенияБГУКлиентСервер.МеханизмОзнакомленияСотрудников_УстановитьМодифицированность(Форма, ДополнительныеПараметры.ИмяТабличнойЧасти, Ложь);
	
	МеханизмОзнакомленияСотрудников_УстановитьДоступностьЭлементовТабличнойЧасти(Форма, ДополнительныеПараметры.ИмяТабличнойЧасти);
	
КонецПроцедуры

// Команды

Процедура МеханизмОзнакомленияСотрудников_СохранитьРезультатыОзнакомления(Форма, ДополнительныеПараметры = Неопределено) Экспорт
	
	Перем ЕстьКонфликтыДействий;
	
	Форма.НастройкиМеханизмаОзнакомленияСотрудников.СообщениеОКонфликтахДействийПриЗаписи = Неопределено;
	
	ТаблицаДействий = МеханизмОзнакомленияСотрудников_ПолучитьТаблицуДействий(Форма, ДополнительныеПараметры);
	
	МеханизмОзнакомленияСотрудников_ДиагностироватьКонфликтыДействий(Форма, ТаблицаДействий, ЕстьКонфликтыДействий);
	
	Если ЕстьКонфликтыДействий Тогда
		СообщениеОКонфликтахДействий = МеханизмОзнакомленияСотрудников_СформироватьСообщениеОКонфликтахДействий(Форма, ТаблицаДействий, ДополнительныеПараметры);
		
		Форма.НастройкиМеханизмаОзнакомленияСотрудников.СообщениеОКонфликтахДействийПриЗаписи = СообщениеОКонфликтахДействий;
		
		Возврат;
	КонецЕсли;
	
	МеханизмОзнакомленияСотрудников_ЗаписатьТаблицуДействий(Форма, ТаблицаДействий);
	
	МеханизмОзнакомленияСотрудников_ЗаполнитьКолонкиОзнакомления(Форма);
	
	СписокТЧ = Новый Массив();
	
	Если ДополнительныеПараметры <> Неопределено Тогда
		СписокТЧ.Добавить(ДополнительныеПараметры.ИмяТабличнойЧасти);
	Иначе
		НастройкиМеханизма = Форма.НастройкиМеханизмаОзнакомленияСотрудников;
		
		Для Каждого ЭлементОписания Из НастройкиМеханизма.ТабличныеЧасти Цикл
			ИмяТабличнойЧасти = ЭлементОписания.Ключ;
			
			СписокТЧ.Добавить(ИмяТабличнойЧасти);
		КонецЦикла;
	КонецЕсли;
	
	Для Каждого ИмяТабличнойЧасти Из СписокТЧ Цикл
		ОбщегоНазначенияБГУКлиентСервер.МеханизмОзнакомленияСотрудников_УстановитьМодифицированность(Форма, ИмяТабличнойЧасти, Ложь);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

