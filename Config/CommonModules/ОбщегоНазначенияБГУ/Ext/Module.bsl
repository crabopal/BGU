// Функция возвращает таблицу с полным составом комиссий, включая председателей.
//
// Параметры:
//  ДокументыДляГолосования - ДокументСсылка, либо массив ссылок, либо ДанныеФормыСтруктура - документ(ы), для которых нужно получить состав комиссий.
//
// Возвращаемое значение:
//  ТаблицаЗначений - таблица с полным составом комиссий, включая председателей. 
//
Функция ПолныйСоставКомиссий(ДокументыДляГолосования) Экспорт
	
	СоставКомиссий = Новый ТаблицаЗначений;
	СоставКомиссий.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	СоставКомиссий.Колонки.Добавить("Ссылка",      Документы.ТипВсеСсылки());
	СоставКомиссий.Колонки.Добавить("Комиссия",    Новый ОписаниеТипов("СправочникСсылка.ПостоянноДействующиеКомиссии"));
	СоставКомиссий.Колонки.Добавить("Сотрудник",   Новый ОписаниеТипов("СправочникСсылка.Сотрудники"));
	СоставКомиссий.Колонки.Добавить("Отсутствует", Новый ОписаниеТипов("Булево"));
	СоставКомиссий.Колонки.Добавить("ПричинаОтсутствия", Новый ОписаниеТипов("Строка"));
	СоставКомиссий.Колонки.Добавить("ЭтоПредседатель",   Новый ОписаниеТипов("Булево"));
	
	Запрос = Новый Запрос;
	
	Если ТипЗнч(ДокументыДляГолосования) = Тип("Массив") Тогда // По списку документов.
		
		Если ДокументыДляГолосования.Количество() = 0 Тогда
			Возврат СоставКомиссий;
		КонецЕсли;
		
		ИмяДокумента = Метаданные.НайтиПоТипу(ТипЗнч(ДокументыДляГолосования[0])).Имя;
		ПредседательВШапкеДокумента = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДокументыДляГолосования[0], "Председатель");
		Запрос.УстановитьПараметр("ДокументыДляГолосования", ДокументыДляГолосования);
		
	ИначеЕсли ТипЗнч(ДокументыДляГолосования) = Тип("ДанныеФормыСтруктура") Тогда // Из формы документа, например, по кнопке "Единогласное решение".
		
		ИмяДокумента = ДокументыДляГолосования.Ссылка.Метаданные().Имя;
		ПредседательВШапкеДокумента = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДокументыДляГолосования, "Председатель");
		Запрос.УстановитьПараметр("ДокументыДляГолосования", ДокументыДляГолосования.Ссылка);
		
	Иначе // По ссылке на документ.
		
		Если Не ЗначениеЗаполнено(ДокументыДляГолосования) Тогда
			Возврат СоставКомиссий;
		КонецЕсли;
		
		ИмяДокумента = Метаданные.НайтиПоТипу(ТипЗнч(ДокументыДляГолосования)).Имя;
		ПредседательВШапкеДокумента = ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДокументыДляГолосования, "Председатель");
		Запрос.УстановитьПараметр("ДокументыДляГолосования", ДокументыДляГолосования);
		
	КонецЕсли;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СоставКомиссии.Ссылка.Организация КАК Организация,
	|	СоставКомиссии.Ссылка.Комиссия КАК Комиссия,
	|	СоставКомиссии.Ссылка КАК Ссылка,
	|	СоставКомиссии.Сотрудник КАК Сотрудник,
	|	СоставКомиссии.Отсутствует КАК Отсутствует,
	|	СоставКомиссии.ПричинаОтсутствия КАК ПричинаОтсутствия,
	|	ЕСТЬNULL(СоставКомиссииВСправочнике.СтатусЧленаКомиссии = ЗНАЧЕНИЕ(Перечисление.СтатусыЧленовКомиссии.Председатель), ЛОЖЬ) КАК ЭтоПредседатель
	|ИЗ
	|	Документ.СписаниеОбъектовОС.СоставКомиссии КАК СоставКомиссии
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПостоянноДействующиеКомиссии.СоставКомиссии КАК СоставКомиссииВСправочнике
	|		ПО СоставКомиссии.Ссылка.Комиссия = СоставКомиссииВСправочнике.Ссылка
	|			И СоставКомиссии.Сотрудник = СоставКомиссииВСправочнике.Сотрудник
	|ГДЕ
	|	СоставКомиссии.Ссылка В(&ДокументыДляГолосования)";
	
	Если ПредседательВШапкеДокумента Тогда // Добавим председателя отдельной строкой.
		Запрос.Текст = Запрос.Текст + "
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СписаниеОбъектовОС.Организация,
		|	СписаниеОбъектовОС.Комиссия,
		|	СписаниеОбъектовОС.Ссылка,
		|	СписаниеОбъектовОС.Председатель,
		|	ЛОЖЬ,
		|	"""",
		|	ИСТИНА
		|ИЗ
		|	Документ.СписаниеОбъектовОС КАК СписаниеОбъектовОС
		|ГДЕ
		|	СписаниеОбъектовОС.Ссылка В(&ДокументыДляГолосования)";
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "СписаниеОбъектовОС", ИмяДокумента);
	ПолныйСоставКомиссий = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Строка Из ПолныйСоставКомиссий Цикл
		НоваяСтрока = СоставКомиссий.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	КонецЦикла;
	
	Возврат СоставКомиссий;
	
КонецФункции

#КонецОбласти

#Область РаботаСТипами

//  Используется для совместимости с БГУ ред. 1.0
//
Функция ЭтоПримитивныйТип(ТекТип) Экспорт
	Результат = Ложь;
	Если ТипЗнч(ТекТип) = Тип("Тип") Тогда
		Если    (ТекТип = Тип("Строка")) или (ТекТип = Тип("Число")) 
			или (ТекТип = Тип("Булево")) или (ТекТип = Тип("Дата")) Тогда
			Результат = Истина;
		КонецЕсли;	
	Иначе	
		Если    (ТекТип = "Строка") или (ТекТип = "Число") 
			или (ТекТип = "Булево") или (ТекТип = "Дата") Тогда
			Результат = Истина;
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

//  Используется для совместимости с БГУ ред. 1.0
Функция ПолучитьОписаниеТиповПоТипуЗначения(Значение) Экспорт
	
	МассивТипов = Новый Массив;
	Массивтипов.Добавить(ТипЗнч(Значение));
	
	Возврат Новый ОписаниеТипов(МассивТипов);
	
КонецФункции

// Возвращает строковое описание типа для разных режимов использования.
// Для режима "ПолноеИмя" возвращается строка вида "Документ.АвансовыйОтчет"
// Для режима "Менеджер" возвращается строка вида "Документы.АвансовыйОтчет"
// Для режима "Запрос" возвращается строка вида "Документ.АвансовыйОтчет"
// Для режима "Объект" возвращается строка вида "ДокументОбъект.АвансовыйОтчет"
// Для любого другого режима возвращается строка вида "ДокументСсылка.АвансовыйОтчет"
//
// Параметры:
//  ТекТип	 - Тип - Тип, для которого нужно получить строковое описание
//  Режим	 - Строка - Режим получения типа: "ПолноеИмя", "Менеджер", "Запрос", "Объект" или любой другой
// Возвращаемое значение:
//  Строка - описание типа
//
Функция ВернутьСтрокуТипаПоТипу(ТекТип,Режим) Экспорт
	
	Если Режим = "ПолноеИмя" Тогда
		Если ОбщегоНазначения.ЭтоСсылка(ТекТип) Тогда
			Возврат Метаданные.НайтиПоТипу(ТекТип).ПолноеИмя();
		Иначе
			Возврат Строка(ТекТип);
		КонецЕсли;
	КонецЕсли;
	
	Если ТекТип = "" Тогда
		Возврат(ТекТип);
	ИначеЕсли ЭтоПримитивныйТип(ТекТип) Тогда
		Результат = Строка(ТекТип);
		Возврат(Результат);
	КонецЕсли;	
	
	Если Справочники.ТипВсеСсылки().СодержитТип(ТекТип) Тогда
		Если Режим = "Менеджер" Тогда
			ТипОбъекта = "Справочники.";
		ИначеЕсли Режим	= "Запрос" Тогда
			ТипОбъекта = "Справочник.";
		ИначеЕсли Режим	= "Объект" Тогда
			ТипОбъекта = "СправочникОбъект.";			
		Иначе	
			ТипОбъекта = "СправочникСсылка.";
		Конецесли;	
	ИначеЕсли Документы.ТипВсеСсылки().СодержитТип(ТекТип) Тогда
		Если Режим = "Менеджер" Тогда
			ТипОбъекта = "Документы.";
		ИначеЕсли Режим	= "Запрос" Тогда
			ТипОбъекта = "Документ.";
		ИначеЕсли Режим	= "Объект" Тогда
			ТипОбъекта = "ДокументОбъект.";			
		Иначе	
			ТипОбъекта = "ДокументСсылка.";
		Конецесли;	
	ИначеЕсли ПланыВидовХарактеристик.ТипВсеСсылки().СодержитТип(ТекТип) Тогда
		Если Режим = "Менеджер" Тогда
			ТипОбъекта = "ПланыВидовХарактеристик.";
		ИначеЕсли Режим	= "Запрос" Тогда
			ТипОбъекта = "ПланВидовХарактеристик.";
		ИначеЕсли Режим	= "Объект" Тогда
			ТипОбъекта = "ПланВидовХарактеристикОбъект.";			
		Иначе	
			ТипОбъекта = "ПланВидовХарактеристикСсылка.";
		Конецесли;	
	ИначеЕсли Перечисления.ТипВсеСсылки().СодержитТип(ТекТип) Тогда
		Если Режим = "Менеджер" Тогда
			ТипОбъекта = "Перечисления.";
		ИначеЕсли Режим	= "Запрос" Тогда
			ТипОбъекта = "Перечисление.";
		Иначе	
			ТипОбъекта = "ПеречислениеСсылка.";
		Конецесли;	
	ИначеЕсли ПланыСчетов.ТипВсеСсылки().СодержитТип(ТекТип) Тогда
		Если Режим = "Менеджер" Тогда
			ТипОбъекта = "ПланыСчетов.";
		ИначеЕсли Режим	= "Запрос" Тогда
			ТипОбъекта = "ПланСчетов.";
		ИначеЕсли Режим	= "Объект" Тогда
			ТипОбъекта = "ПланСчетовОбъект.";
		Иначе	
			ТипОбъекта = "ПланСчетовСсылка.";
		Конецесли;
	ИначеЕсли БизнесПроцессы.ТипВсеСсылки().СодержитТип(ТекТип) Тогда
		Если Режим = "Менеджер" Тогда
			ТипОбъекта = "БизнесПроцессы.";
		ИначеЕсли Режим	= "Запрос" Тогда
			ТипОбъекта = "БизнесПроцесс.";
		ИначеЕсли Режим	= "Объект" Тогда
			ТипОбъекта = "БизнесПроцессОбъект.";
		Иначе	
			ТипОбъекта = "БизнесПроцессСсылка.";
		Конецесли;
	ИначеЕсли Задачи.ТипВсеСсылки().СодержитТип(ТекТип) Тогда
		Если Режим = "Менеджер" Тогда
			ТипОбъекта = "Задачи.";
		ИначеЕсли Режим	= "Запрос" Тогда
			ТипОбъекта = "Задача.";
		ИначеЕсли Режим	= "Объект" Тогда
			ТипОбъекта = "ЗадачаОбъект.";
		Иначе	
			ТипОбъекта = "ЗадачаСсылка.";
		Конецесли;
	КонецЕсли;
	Результат = СформироватьСтрокуТипа(ТипОбъекта,ТекТип);
	
	Возврат Результат;
КонецФункции

Функция СформироватьСтрокуТипа(ТипОбъекта,ТекТип)
	
	ТипообразующийОбъект = Метаданные.НайтиПоТипу(ТекТип);
	ВидОбъекта           = ТипообразующийОбъект.Имя;
	Результат            = ТипОбъекта + ВидОбъекта;
	
	Возврат(Результат);
	
КонецФункции	

// Предназначена для получения пустого значения заданного типа:
//	примитивного, или ссылочного. 
//  Используется для совместимости с БГУ ред. 1.0
//
// Параметры:
//	ЗаданныйТип   - тип, пустое значение которого нужно получить
//
Функция ПустоеЗначениеТипа(ЗаданныйТип) Экспорт

	Если ЗаданныйТип = Тип("Число") Тогда
		Возврат 0;

	ИначеЕсли ЗаданныйТип = Тип("Строка") Тогда
		Возврат "";

	ИначеЕсли ЗаданныйТип = Тип("Дата") Тогда
		Возврат '00010101000000';

	ИначеЕсли ЗаданныйТип = Тип("Булево") Тогда
		Возврат Ложь;

	Иначе
		Возврат Новый (ЗаданныйТип);

	КонецЕсли;

КонецФункции // ПустоеЗначениеТипа()

// Служебная функция, предназначенная для получения описания типов ссылочного значения
