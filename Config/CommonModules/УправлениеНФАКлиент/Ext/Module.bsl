#Область ПрограммныйИнтерфейс

// Открывает форму для группового изменения реквизитов табличной части документа. 
// После закрытия заполняет реквизиты таб. части заполненными значениями
//
// Параметры:
// Форма - форма - форма документа, из которого вызывается заполнение
// ИмяДокумента - строка - имя документа
// ИмяТЧ - строка - имя табличной части                                   
// ИмяЭлементаТЧ - строка - имя элемента формы табличной части                                   
// РеквизитыТЧ - строка - разделенные запятыми имена реквизитов, которые нужно заполнить
Процедура ИзменитьРеквизитыСтрокТЧ(Форма, ИмяДокумента, ИмяТЧ, ИмяЭлементаТЧ, РеквизитыТЧ, ОповещениеОЗавершении = Неопределено) Экспорт
	ТекущиеДанные = Форма.Элементы[ИмяЭлементаТЧ].ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	
	Если ТипЗнч(РеквизитыТЧ) = Тип("Строка") Тогда
		СтруктураРеквизитов = Новый Структура(РеквизитыТЧ);
	Иначе
		СтруктураРеквизитов = РеквизитыТЧ;
	КонецЕсли;
	
	СвойстваРеквизитов = Новый Структура;
	Для каждого Реквизит из СтруктураРеквизитов Цикл
		СвойстваРеквизитов.Вставить(Реквизит.Ключ, Новый Структура);
		Если ТипЗнч(Реквизит.Значение) = Тип("Структура") Тогда              
			Для каждого СвойствоРеквизита из Реквизит.Значение Цикл
				СвойстваРеквизитов[Реквизит.Ключ].Вставить(СвойствоРеквизита.Ключ, СвойствоРеквизита.Значение);
			КонецЦикла;	
		КонецЕсли;	
	КонецЦикла;
	
	Для каждого ТекЭлемент из СвойстваРеквизитов Цикл
		ТекЭлемент.Значение.Вставить("НачальноеЗначение", ТекущиеДанные[ТекЭлемент.Ключ]);
	КонецЦикла;	
	ПараметрыФормы.Вставить("СвойстваРеквизитов", СвойстваРеквизитов);
	ПараметрыФормы.Вставить("ИмяДокумента", ИмяДокумента);
	ПараметрыФормы.Вставить("ИмяТЧ", ИмяТЧ);
	ПараметрыФормы.Вставить("ИмяЭлементаТЧ", ИмяЭлементаТЧ);
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Форма", Форма);
	ДопПараметры.Вставить("ИмяТЧ", ИмяТЧ);
	ДопПараметры.Вставить("ИмяЭлементаТЧ", ИмяЭлементаТЧ);
	ДопПараметры.Вставить("ОповещениеОЗавершении", ОповещениеОЗавершении);
	ОписаниеОповещения = Новый ОписаниеОповещения("ИзменитьРеквизитыСтрокЗавершение", ЭтотОбъект, ДопПараметры);
	ОткрытьФорму("Документ.АктОбУтилизацииОС.Форма.ФормаГрупповогоИзмененияРеквизитов", ПараметрыФормы,,,,, ОписаниеОповещения);
КонецПроцедуры	

Процедура ИзменитьРеквизитыСтрокЗавершение(Результат, ДопПараметры) Экспорт
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;                  
		
	Для каждого ИдентификаторСтроки Из ДопПараметры.Форма.Элементы[ДопПараметры.ИмяЭлементаТЧ].ВыделенныеСтроки Цикл
		ТекущиеДанные = ДопПараметры.Форма.Объект[ДопПараметры.ИмяТЧ].НайтиПоИдентификатору(ИдентификаторСтроки);
		ЗаполнитьЗначенияСвойств(ТекущиеДанные, Результат);
	КонецЦикла;                         
	
	Если ДопПараметры.ОповещениеОЗавершении <> Неопределено Тогда
		ВыполнитьОбработкуОповещения(ДопПараметры.ОповещениеОЗавершении, Результат);
	КонецЕсли;	
КонецПроцедуры

// Параметры изменения ревизита, влияющего на очитску табличных частей документа.
// 
// Возвращаемое значение:
//  Структура - Параметры изменения реквизита:
// * ЗначениеДоИзменения - СправочникСсылка -
// * ИмяРеквизита - Строка -
// * СинонимРеквизита - Строка
// * ИменаТабличныхЧастей - Строка -
// * ОбработчикПриИзменении - ОписаниеОповещения -
Функция ПараметрыИзмененияРеквизитаСОчисткойТЧ() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("ЗначениеДоИзменения", Неопределено);
	Результат.Вставить("ИмяРеквизита", "");
	Результат.Вставить("СинонимРеквизита", "");
	Результат.Вставить("ИменаТабличныхЧастей", "");
	Результат.Вставить("ОбработчикПриИзменении", Неопределено);
	//@skip-check constructor-function-return-section
	Возврат Результат;
КонецФункции

// При изменении ревизита, влияющего на очитску табличных частей документа.
// 
// Параметры:
//  Объект - ДанныеФормыСтруктура
//  ПараметрыИзменения - см. ПараметрыИзмененияРеквизитаСОчисткойТЧ
Процедура ПриИзмененииРеквизитаСОчисткойТЧ(Объект, ПараметрыИзменения) Экспорт
	
	Если ПараметрыИзменения.ЗначениеДоИзменения = Объект[ПараметрыИзменения.ИмяРеквизита] Тогда
		Возврат;
	КонецЕсли;
	
	ТабличныеЧасти = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(ПараметрыИзменения.ИменаТабличныхЧастей);
	ТребуетсяОчистка = Ложь;
	Для Каждого ТабличнаяЧасть Из ТабличныеЧасти Цикл
		ТребуетсяОчистка = ТребуетсяОчистка Или Объект[ТабличнаяЧасть].Количество() > 0;
	КонецЦикла;
	Если Не ТребуетсяОчистка Тогда
		Если ПараметрыИзменения.ОбработчикПриИзменении <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ПараметрыИзменения.ОбработчикПриИзменении);
		КонецЕсли;
	Иначе
		РазрешеноИзменениеБезОчистки = 
			СтандартныеПодсистемыКлиентПовтИсп.ПараметрыРаботыКлиента().РазрешитьИзменениеРеквизитовБезОчисткиТабличныхЧастейВДокументахНФА;
		
		Если РазрешеноИзменениеБезОчистки Тогда
			ТекстВопроса = СтрШаблон(НСтр("ru = 'Очистить табличные части документа при изменении реквизита ""%1""?'"), ПараметрыИзменения.СинонимРеквизита);
			Кнопки = Новый СписокЗначений;
			Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Очистить табличные части'"));
			Кнопки.Добавить(КодВозвратаДиалога.Нет);
		Иначе
			ТекстВопроса = СтрШаблон(НСтр("ru = 'При изменении реквизита ""%1"" будут очищены табличные части документа.
										|Продолжить?'"), ПараметрыИзменения.СинонимРеквизита);
			Кнопки = Новый СписокЗначений;
			Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Очистить табличные части'"));
			Кнопки.Добавить(КодВозвратаДиалога.Отмена);
		КонецЕсли;
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ОбработчикПриИзменении", ПараметрыИзменения.ОбработчикПриИзменении);
		ДополнительныеПараметры.Вставить("ЗначениеДоИзменения", ПараметрыИзменения.ЗначениеДоИзменения);
		ДополнительныеПараметры.Вставить("ЗначениеПослеИзменения", Объект[ПараметрыИзменения.ИмяРеквизита]);
		ДополнительныеПараметры.Вставить("Объект", Объект);
		ДополнительныеПараметры.Вставить("ИмяРеквизита", ПараметрыИзменения.ИмяРеквизита);
		ДополнительныеПараметры.Вставить("ТабличныеЧасти", ТабличныеЧасти);
		ОбработчикОтвета = Новый ОписаниеОповещения("ПослеОтветаНаВопросПриИзмененииРеквизитаСОчисткойТЧ", ЭтотОбъект, ДополнительныеПараметры);
		ПоказатьВопрос(ОбработчикОтвета, ТекстВопроса, Кнопки);
		Если Не РазрешеноИзменениеБезОчистки Тогда
			Объект[ПараметрыИзменения.ИмяРеквизита] = ПараметрыИзменения.ЗначениеДоИзменения;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Открывает актуальный элемент справочника "Обеспечение сотрудника имуществом" для переданного ЦМО или сотрудника.
// 
// Параметры:
//  СотрудникЦМО - СправочникСсылка.Сотрудники, СправочникСсылка.ЦМО-
Процедура ОткрытьОбеспечениеСотрудникаИмуществом(СотрудникЦМО) Экспорт
	
	Если Не ЗначениеЗаполнено(СотрудникЦМО) Тогда
		Возврат;
	КонецЕсли;
	
	ОбеспечениеСотрудника = УправлениеНФАВызовСервера.ОбеспечениеСотрудникаИмуществом(СотрудникЦМО);
	
	Если Не ЗначениеЗаполнено(ОбеспечениеСотрудника) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'У сотрудника не введена норма в справочнике ""Обеспечение сотрудников имуществом""'"));
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Ключ", ОбеспечениеСотрудника); 
	
	ОткрытьФорму("Справочник.ОбеспечениеСотрудниковИмуществом.ФормаОбъекта", ПараметрыФормы, , , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

// Заполняет подразделение сотрудника ЦМО на дату ТекДата
//
// Параметры:
//  - ТекОбъект - ДанныеФормыСтруктура - основной реквизит формы объекта, реквизит подразделение которого заполняется
//  - ТекЦМО - СправочникСсылка.ЦМО - ЦМО подразделение сотрудника которого получаем
//  - ТекДата - Дата - Дата, на которую получаем данные
//  - ИмяРеквизитаПодразделениеСотрудникаЦМО - Строка - имя реквизита подразделения
Процедура ЗаполнитьПодразделениеСотрудникаЦМО(ТекОбъект, ТекЦМО, ТекДата, ИмяРеквизитаПодразделениеСотрудникаЦМО) Экспорт
	ТекПодразделениеОтправитель = УправлениеНФАВызовСервера.ПодразделениеСотрудникаЦМО(ТекЦМО, ТекДата);
	Если ТекПодразделениеОтправитель <> ТекОбъект[ИмяРеквизитаПодразделениеСотрудникаЦМО] Тогда
		ТекОбъект[ИмяРеквизитаПодразделениеСотрудникаЦМО] = ТекПодразделениеОтправитель;
	КонецЕсли;	
КонецПроцедуры	

// Открывает форму просмотра значения, выбранного в колонке строки
//
// Параметры:
//  ТекущиеДанные	 -ДанныеФормыЭлементКоллекции - строка таблицы
//  ИмяКолонки		 - Строка - 
//
Процедура ОткрытьФормуЗначенияВКолонкеСтроки(ТекущиеДанные, ИмяКолонки) Экспорт
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекущиеДанные[ИмяКолонки]) Тогда
		ПоказатьЗначение(, ТекущиеДанные[ИмяКолонки]);
	КонецЕсли;
КонецПроцедуры

// Открывает файл входящего электронного акта.
// 
// Параметры:
//  ВыбранноеЗначение - номер строки списка
//  ФайлыВходящегоАкта - ДанныеФормыКоллекция - список файлов формы документа учета
//  УникальныйИдентификатор - УникальныйИдентификатор
Процедура ОткрытьЭлектронныйДокументПриложенияИзФайла(ВыбранноеЗначение, ФайлыВходящегоАкта, УникальныйИдентификатор) Экспорт

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДанныеСтроки = ФайлыВходящегоАкта.НайтиПоИдентификатору(ВыбранноеЗначение);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеСтроки.ПрисоединенныйФайл) Тогда
		ДанныеФайла = РаботаСФайламиСлужебныйВызовСервера.ДанныеФайлаДляОткрытия(
			ДанныеСтроки.ПрисоединенныйФайл, Неопределено, УникальныйИдентификатор);
		
		РаботаСФайламиКлиент.ОткрытьФайл(ДанныеФайла);
	КонецЕсли;
	
КонецПроцедуры

#Область АктПриемкиТоваровРаботУслуг

// Параметры выбора ФИОКонтактного лица акт приемки ТРУ.
// 
// Параметры:
//  Форма - ДанныеФормыСтруктура
// 
// Возвращаемое значение:
//  Структура - Параметры выбора ФИОКонтактного лица акт приемки ТРУ:
// * Форма - ДанныеФормыСтруктура - 
// * Объект - Неопределено, Произвольный - 
// * ДопустимыеТипы - СписокЗначений из Тип - 
// * Организация - Неопределено, СправочникСсылка.Организации -
// * Контрагент - Неопределено, СправочникСсылка.Контрагенты -
// * РодительскийРеквизит - Строка -
// * РеквизитОрганизация - Строка -
// * РеквизитКонтрагент - Строка -
// * ИзменениеСвязиПараметровВыбора - Неопределено, ОписаниеОповещения -
Функция ПараметрыВыбораФИОКонтактногоЛицаАктПриемкиТРУ(Форма) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Форма", Форма);
	Результат.Вставить("Объект", Неопределено);
	Результат.Вставить("ДопустимыеТипы", Новый СписокЗначений);
	Результат.Вставить("Организация", Неопределено);
	Результат.Вставить("Контрагент", Неопределено);
	Результат.Вставить("РодительскийРеквизит", "");
	Результат.Вставить("РеквизитОрганизация", "Организация");
	Результат.Вставить("РеквизитКонтрагент", "");
	Результат.Вставить("ИзменениеСвязиПараметровВыбора", Неопределено);
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "Объект") Тогда
		Объект = Форма.Объект;
		Результат.Объект = Объект;
		Если ТипЗнч(Объект) = Тип("ДанныеФормыСтруктура") Тогда
			Результат.Организация = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Объект, "Организация");
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

// Начать выбор ФИОКонтактного лица акт приемки ТРУ.
// 
// Параметры:
//  Элемент - ПолеФормы
//  Параметры - см. ПараметрыВыбораФИОКонтактногоЛицаАктПриемкиТРУ
//  СтандартнаяОбработка - Булево - Возвращаемый параметр
Процедура НачатьВыборФИОКонтактногоЛицаАктПриемкиТРУ(Элемент, Параметры, СтандартнаяОбработка) Экспорт
	СтандартнаяОбработка = Ложь;
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Форма", Параметры.Форма);
	ДополнительныеПараметры.Вставить("Элемент", Элемент);
	ДополнительныеПараметры.Вставить("Объект", Параметры.Объект);
	ДополнительныеПараметры.Вставить("Организация", Параметры.Организация);
	ДополнительныеПараметры.Вставить("Контрагент", Параметры.Контрагент);
	ДополнительныеПараметры.Вставить("ИзменениеСвязиПараметровВыбора", Параметры.ИзменениеСвязиПараметровВыбора);
	Оповещение = Новый ОписаниеОповещения("ВыборТипаПоляФИОКонтактногоЛицаАктПриемкиТРУ",
		ЭтотОбъект, ДополнительныеПараметры);
	Параметры.Форма.ПоказатьВыборИзСписка(Оповещение, Параметры.ДопустимыеТипы);
КонецПроцедуры

// Параметры установки свойства параметры выбора ответственного лица.
// 
// Возвращаемое значение:
//  Структура - Параметры установки свойства параметры выбора ответственного лица:
// * ЗначениеРеквизита - Неопределено, Строка, СправочникСсылка.ОтветственныеЛицаКонтрагентов, СправочникСсылка.Сотрудники - 
// * Контрагент - Неопределено, СправочникСсылка.Контрагенты - 
// * Организация - Неопределено, СправочникСсылка.Организации - 
// * РодительскийРеквизит - Строка -
// * РеквизитОрганизация - Строка -
// * РеквизитКонтрагент - Строка -
// * ИзменениеСвязиПараметровВыбора - Неопределено, ОписаниеОповещения -
Функция ПараметрыУстановкиСвойстваПараметрыВыбораОтветственногоЛица() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("ЗначениеРеквизита", Неопределено);
	Результат.Вставить("Контрагент", Неопределено);
	Результат.Вставить("Организация", Неопределено);
	Результат.Вставить("РодительскийРеквизит", "");
	Результат.Вставить("РеквизитОрганизация", "Организация");
	Результат.Вставить("РеквизитКонтрагент", "");
	Результат.Вставить("ИзменениеСвязиПараметровВыбора", Неопределено);
	
	Возврат Результат;
КонецФункции

// Установить параметры выбора в свойства элемента ответственного лица.
// 
// Параметры:
//  Элемент - ПолеФормы
//  Параметры - см. ПараметрыУстановкиСвойстваПараметрыВыбораОтветственногоЛица 
Процедура УстановитьПараметрыВыбораВСвойстваЭлементаОтветственногоЛица(Элемент, Параметры) Экспорт
	ТипЭлемента = ТипЗнч(Параметры.ЗначениеРеквизита);
	Если ТипЭлемента <> Тип("СправочникСсылка.ОтветственныеЛицаКонтрагентов") Тогда
		Возврат;
	КонецЕсли;
	
	ОжидаемыеСвязиПараметровВыбора = УправлениеНФАКлиентСервер
		.СвязиПараметровВыбораДляФормыВыбораЗначенияФИОКонтактногоЛицаАктПриемкиТРУ(
			Параметры.РеквизитОрганизация,
			Параметры.РеквизитКонтрагент,
			Параметры.РодительскийРеквизит,
			ТипЭлемента);
	
	СвязиПараметровВыбора = Элемент.СвязиПараметровВыбора;
	Если Параметры.ИзменениеСвязиПараметровВыбора <> Неопределено 
			И Не СвязиПараметровВыбораРавны(СвязиПараметровВыбора, ОжидаемыеСвязиПараметровВыбора) Тогда
		ВыполнитьОбработкуОповещения(Параметры.ИзменениеСвязиПараметровВыбора, ОжидаемыеСвязиПараметровВыбора);
	КонецЕсли;
	
КонецПроцедуры


#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПослеОтветаНаВопросПриИзмененииРеквизитаСОчисткойТЧ(Результат, ДополнительныеПараметры) Экспорт
	
	Объект = ДополнительныеПараметры.Объект;
	ИмяРеквизита = ДополнительныеПараметры.ИмяРеквизита;
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Если Результат = КодВозвратаДиалога.Отмена Тогда
			Объект[ИмяРеквизита] = ДополнительныеПараметры.ЗначениеДоИзменения;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Для Каждого ТабличнаяЧасть Из ДополнительныеПараметры.ТабличныеЧасти Цикл
		Объект[ТабличнаяЧасть].Очистить();
	КонецЦикла;
	
	Объект[ИмяРеквизита] = ДополнительныеПараметры.ЗначениеПослеИзменения;
	Если ДополнительныеПараметры.ОбработчикПриИзменении <> Неопределено Тогда
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОбработчикПриИзменении);
	КонецЕсли;
	
КонецПроцедуры

Функция СвязиПараметровВыбораРавны(СвязиПараметровВыбора, ОжидаемыеСвязиПараметровВыбора)
	Если ТипЗнч(СвязиПараметровВыбора) <> Тип("ФиксированныйМассив")
			Или СвязиПараметровВыбора.Количество() <> ОжидаемыеСвязиПараметровВыбора.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого ТекПараметр Из СвязиПараметровВыбора Цикл
		ПараметрНайден = Ложь;
		Для Каждого ТекОжидаемыйПараметр Из ОжидаемыеСвязиПараметровВыбора Цикл
			Если ТекПараметр.Имя = ТекОжидаемыйПараметр.Имя 
					И ТекПараметр.ПутьКДанным = ТекОжидаемыйПараметр.ПутьКДанным
					И (ТекПараметр.ИзменениеЗначения = РежимИзмененияСвязанногоЗначения.Очищать 
						И ТекОжидаемыйПараметр.Очищать
						Или ТекПараметр.ИзменениеЗначения = РежимИзмененияСвязанногоЗначения.НеИзменять
						И Не ТекОжидаемыйПараметр.Очищать) Тогда
				ПараметрНайден = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не ПараметрНайден Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

#Область АктПриемкиТоваровРаботУслуг

Процедура ВыборТипаПоляФИОКонтактногоЛицаАктПриемкиТРУ(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Элемент = ДополнительныеПараметры.Элемент; // ПолеФормы
	Если Элемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Форма = ДополнительныеПараметры.Форма;
	Форма.Модифицированность = Истина;
	Объект = ДополнительныеПараметры.Объект; // ДанныеФормыСтруктура
	ВыбранныйТип = Результат.Значение;
	ПривестиЗначениеЭлементаКВыбранномуТипуФИОКонтактногоЛицаАктПриемкиТРУ(Объект, Элемент, ВыбранныйТип);
	УправлениеНФАКлиентСервер.УстановитьСвойстваЭлементовОтветственныхЛицКонтрагентовАктПриемкиТРУ(Форма, Объект);
	ОткрытьФормуВыбораФИОКонтактногоЛицаАктПриемкиТРУ(Элемент,
		ВыбранныйТип, ДополнительныеПараметры.Организация, ДополнительныеПараметры.Контрагент);
КонецПроцедуры

Процедура ПривестиЗначениеЭлементаКВыбранномуТипуФИОКонтактногоЛицаАктПриемкиТРУ(Объект, Элемент, ВыбранныйТип)
	Если ВыбранныйТип = Тип("СправочникСсылка.ОтветственныеЛицаКонтрагентов") Тогда
		ОписаниеТипа = Новый ОписаниеТипов("СправочникСсылка.ОтветственныеЛицаКонтрагентов");
	ИначеЕсли ВыбранныйТип = Тип("СправочникСсылка.Сотрудники") Тогда
		ОписаниеТипа = Новый ОписаниеТипов("Строка");
	Иначе
		ОписаниеТипа = Новый ОписаниеТипов("Строка");
	КонецЕсли;
	Объект[Элемент.Имя] = ОписаниеТипа.ПривестиЗначение(Объект[Элемент.Имя]);
КонецПроцедуры

Процедура ОткрытьФормуВыбораФИОКонтактногоЛицаАктПриемкиТРУ(Элемент, ВыбранныйТип, Организация, Контрагент)
	Если ВыбранныйТип = Тип("СправочникСсылка.ОтветственныеЛицаКонтрагентов") Тогда
		ОткрытьФорму("Справочник.ОтветственныеЛицаКонтрагентов.ФормаВыбора",
			ПараметрыДляФормыВыбораЗначенияФИОКонтактногоЛицаАктПриемкиТРУ(Организация, Контрагент, ВыбранныйТип),
			Элемент);
	ИначеЕсли ВыбранныйТип = Тип("СправочникСсылка.Сотрудники") Тогда
		ОткрытьФорму("Справочник.Сотрудники.ФормаВыбора",
			ПараметрыДляФормыВыбораЗначенияФИОКонтактногоЛицаАктПриемкиТРУ(Организация, Контрагент, ВыбранныйТип),
			Элемент);
	КонецЕсли;
КонецПроцедуры

Функция ПараметрыДляФормыВыбораЗначенияФИОКонтактногоЛицаАктПриемкиТРУ(Организация, Контрагент, ВыбранныйТип)
	ПараметрыДляФормыВыбора = Новый Структура;
	ОтборДляФормыВыбора = ОтборДляФормыВыбораЗначенияФИОКонтактногоЛицаАктПриемкиТРУ(
		Организация, Контрагент, ВыбранныйТип);
	Если ОтборДляФормыВыбора.Количество() <> 0 Тогда
		ПараметрыДляФормыВыбора.Вставить("Отбор", ОтборДляФормыВыбора);
	КонецЕсли;
	Возврат ПараметрыДляФормыВыбора;
КонецФункции

Функция ОтборДляФормыВыбораЗначенияФИОКонтактногоЛицаАктПриемкиТРУ(Организация, Контрагент, ВыбранныйТип)
	Отбор = Новый Структура;
	Если ВыбранныйТип = Тип("СправочникСсылка.Сотрудники") Тогда
		Отбор.Вставить("Владелец", Организация);
	ИначеЕсли ВыбранныйТип = Тип("СправочникСсылка.ОтветственныеЛицаКонтрагентов") Тогда
		Отбор.Вставить("Владелец", Контрагент);
	КонецЕсли;
	Возврат Отбор;			
КонецФункции

// Оповещение о записи поступления НФА по акту приемки ТРУ
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма документа:
//   * АктПриемкиТоваровРаботУслугСсылка - ДокументСсылка.АктПриемкиТоваровРаботУслуг
//  Объект - ДанныеФормыСтруктура - объект формы
//  ПараметрыЗаписи - Структура - параметры записи документа
Процедура ПослеЗаписиПоступленияНаОснованииАктаПриемки(Форма, Объект, ПараметрыЗаписи) Экспорт
	Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "АктПриемкиТоваровРаботУслугСсылка") Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'В форме %1 отстутствует реквизит формы ""АктПриемкиТоваровРаботУслугСсылка""'"),
			Форма.ИмяФормы);
	КонецЕсли;
	Оповестить("Запись_ПоступлениеНФАПоАктуПриемкиТРУ", Форма.АктПриемкиТоваровРаботУслугСсылка, Объект.Ссылка);
КонецПроцедуры

// Обработка оповещения о записи акта приемки
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма документа
//  ИмяСобытия - Строка - имя события оповещения
//  Параметр - Произвольный - параметр оповещения
//  Источник - Произвольный - источник оповещения
Процедура ОбработкаОповещенияПоступленияНаОснованииАктаПриемки(Форма, ИмяСобытия, Параметр, Источник) Экспорт
	Если ИмяСобытия = "ЗаписьАктаПриемкиТРУ" И Параметр = Форма.Объект.Ссылка Тогда
		Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "АктПриемкиТоваровРаботУслугСсылка") Тогда
			ВызватьИсключение СтрШаблон(
				НСтр("ru = 'В форме %1 отстутствует реквизит формы ""АктПриемкиТоваровРаботУслугСсылка""'"),
				Форма.ИмяФормы);
		КонецЕсли;
		Форма.АктПриемкиТоваровРаботУслугСсылка = Источник;
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ГруппаАктПриемкиТоваровРаботУслуг", "ЦветФона", Новый Цвет);
	КонецЕсли;
КонецПроцедуры

// Обработчик нажатия на надпись акта приемки
//
// Параметры:
//  Форма - ФормаКлиентскогоПриложения - форма документа:
//   * АктПриемкиТоваровРаботУслугСсылка - ДокументСсылка.АктПриемкиТоваровРаботУслуг - ссылка на акт приемки
//  СтандартнаяОбработка - Булево - признак стандартной обработки
Процедура АктПриемкиТРУНажатиеПоступленияНаОснованииАктПриемкиТРУ(Форма, СтандартнаяОбработка) Экспорт
	СтандартнаяОбработка = Ложь;
	Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "АктПриемкиТоваровРаботУслугСсылка") Тогда
		ВызватьИсключение СтрШаблон(
			НСтр("ru = 'В форме %1 отстутствует реквизит формы ""АктПриемкиТоваровРаботУслугСсылка""'"),
			Форма.ИмяФормы);
	КонецЕсли;
	Если ЗначениеЗаполнено(Форма.АктПриемкиТоваровРаботУслугСсылка) Тогда
		ПараметрыОткрытия = Новый Структура;
		ПараметрыОткрытия.Вставить("Ключ", Форма.АктПриемкиТоваровРаботУслугСсылка);
		ОткрытьФорму("Документ.АктПриемкиТоваровРаботУслуг.ФормаОбъекта", ПараметрыОткрытия);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#КонецОбласти
