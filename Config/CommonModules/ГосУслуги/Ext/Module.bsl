

Функция ПолучитьСтруктуруТребованийКомпоненты() Экспорт
	
	НужнаКомпонента = Истина;
	СтруктураТребований = Новый Структура;
	СтруктураТребований.Вставить("ПодписыватьСообщенияДляГИСГМПНаСервере",Константы.ПодписыватьСообщенияДляГИСГМПНаСервере.Получить());
	СтруктураТребований.Вставить("ОбращатьсяКTSAСерверуНаСервере",Константы.ОбращатьсяКTSAСерверуНаСервере.Получить());
	
	Возврат СтруктураТребований;
	
КонецФункции

Функция ПолучитьПараметрыОчередиСообщений(НастройкаОбмена) Экспорт
	
	ПараметрыОчередиСообщений = Новый Структура;
	ПараметрыОчередиСообщений.Вставить("ОчередьПоддерживается",ОчередьСообщенийПоддерживается(НастройкаОбмена));
	
	МасимальноеКоличествоСообщений = 100;//больше 100 за раз не стоит
	МасимальноеКоличествоСообщений = Константы.МаксимальноеКоличествоЗапрашиваемыхСообщенийГИСГМП.Получить();
	Если МасимальноеКоличествоСообщений = Неопределено Тогда
		МасимальноеКоличествоСообщений = 100;
	КонецЕсли;
	
	ПараметрыОчередиСообщений.Вставить("МасимальноеКоличествоСообщений",МасимальноеКоличествоСообщений);
	
	МаксимальнаяДлительность = 0;
	МаксимальнаяДлительность = Константы.МаксимальнаяДлительностьЗапросаСообщенийГИСГМП.Получить();
	
	Если НЕ ЗначениеЗаполнено(МаксимальнаяДлительность) Тогда
		МаксимальнаяДлительность = 360;//6 минут;
	Иначе
		МаксимальнаяДлительность = Мин(МаксимальнаяДлительность,600);//не более 10 минут
	КонецЕсли;
	
	ПараметрыОчередиСообщений.Вставить("МаксимальнаяДлительность", МаксимальнаяДлительность);

	Возврат ПараметрыОчередиСообщений;
	
КонецФункции

Функция ЕстьОбменСИСРНИП() Экспорт
	Возврат ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюСУНИФО");
КонецФункции

Функция ЭтоОбменИСРНИП(Организация) Экспорт
	
	Если ЕстьОбменСИСРНИП() = Ложь Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ВидОбмена = БиблиотекаФункцийОбмена.ПолучитьЗначениеТребуемойНастройкиОрганизация(Организация,Неопределено,"ВидОбмена");
	Если ЗначениеЗаполнено(ВидОбмена) Тогда
		КодВидаОбмена = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидОбмена,"ПредставлениеВНомереВерсии");
		Если КодВидаОбмена = "G2" Тогда
			Возврат Истина;	
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

// Удаление ссылок на документы из РС ДанныеИсходящихСообщенийСМЭВ3 перед их удалением.
Процедура ПередУдалениемДанныеИсходящихСообщенийСМЭВ3(УдаляемыйДокументОбъект, Отказ) Экспорт
	Если УдаляемыйДокументОбъект.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	СсылкаНаДокумент = УдаляемыйДокументОбъект.Ссылка;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РС.Организация КАК Организация,
	|	РС.ИдентификаторСообщения КАК ИдентификаторСообщения,
	|	РС.ИдентификаторДанных КАК ИдентификаторДанных
	|ИЗ
	|	РегистрСведений.ДанныеИсходящихСообщенийСМЭВ3 КАК РС
	|ГДЕ
	|	РС.Данные = &СсылкаНаДокумент";
	
	Запрос.УстановитьПараметр("СсылкаНаДокумент", СсылкаНаДокумент);
	
	ТаблицаЗаписей = Запрос.Выполнить().Выгрузить();
	
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить(Метаданные.РегистрыСведений.ДанныеИсходящихСообщенийСМЭВ3.ПолноеИмя());
		ЭлементБлокировки.ИсточникДанных = ТаблицаЗаписей;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Организация", "Организация");
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("ИдентификаторСообщения", "ИдентификаторСообщения");
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("ИдентификаторДанных", "ИдентификаторДанных");
		Блокировка.Заблокировать();
		
		Для Каждого СтрТЧ Из ТаблицаЗаписей Цикл
			
			НаборЗаписей = РегистрыСведений.ДанныеИсходящихСообщенийСМЭВ3.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Организация.Установить(СтрТЧ.Организация);
			НаборЗаписей.Отбор.ИдентификаторСообщения.Установить(СтрТЧ.ИдентификаторСообщения);
			НаборЗаписей.Отбор.ИдентификаторДанных.Установить(СтрТЧ.ИдентификаторДанных);
			НаборЗаписей.Записать();
			
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Функция ОчередьСообщенийПоддерживается(НастройкаОбмена) Экспорт
	
	ОчередьПоддерживается = Истина; //по умолчанию поддерживается
	
	МассивИменПараметров = Новый Массив;
	МассивИменПараметров.Добавить("ОчередьСообщенийПоддерживается");
	ОчередьПоддерживается = Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПолучитьПараметрыНастройкиОбмена(МассивИменПараметров,НастройкаОбмена).Получить("ОчередьСообщенийПоддерживается");
	
	Если ОчередьПоддерживается <>Ложь Тогда
		ОчередьПоддерживается = Истина;
	КонецЕсли; 
	
	НастроенОбменРНИП = ЕстьОбменСИСРНИП();//в сервисах ИС РНИП и ИС УНП не поддерживается очередь
	
	Если НастроенОбменРНИП 
		ИЛИ ОчередьПоддерживается = Ложь Тогда
		
		Возврат Ложь; //НЕ поддерживается
		
	Иначе
		Возврат Истина;   //Поддерживается
	КонецЕсли;
		
КонецФункции

Функция ПолучитьКодУчастникаДляФормированияУИН(Организация) Экспорт
	
	//Получаем код участника для случаев, когда формируем 25 символьный код, где первые 8 - код участника
	
	КодУчастника = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ШаблоныИдентификаторовКвитанцийНаОплатуГосуслугСоставШаблона.НомерСтроки КАК НомерСтроки,
	               |	ШаблоныИдентификаторовКвитанцийНаОплатуГосуслугСоставШаблона.НаименованиеРеквизита КАК НаименованиеРеквизита,
	               |	ШаблоныИдентификаторовКвитанцийНаОплатуГосуслугСоставШаблона.ДлинаРеквизита КАК ДлинаРеквизита,
	               |	ШаблоныИдентификаторовКвитанцийНаОплатуГосуслугСоставШаблона.ФиксированноеПоле КАК ФиксированноеПоле,
	               |	ШаблоныИдентификаторовКвитанцийНаОплатуГосуслугСоставШаблона.Значение КАК Значение,
	               |	ШаблоныИдентификаторовКвитанцийНаОплатуГосуслугСоставШаблона.Перевести16_10 КАК Перевести16_10
	               |ИЗ
	               |	Справочник.ШаблоныИдентификаторовКвитанцийНаОплатуГосуслуг.СоставШаблона КАК ШаблоныИдентификаторовКвитанцийНаОплатуГосуслугСоставШаблона
	               |ГДЕ
	               |	ШаблоныИдентификаторовКвитанцийНаОплатуГосуслугСоставШаблона.Ссылка.Владелец = &Владелец
	               |	И ШаблоныИдентификаторовКвитанцийНаОплатуГосуслугСоставШаблона.Ссылка.ПометкаУдаления = ЛОЖЬ
	               |	И ШаблоныИдентификаторовКвитанцийНаОплатуГосуслугСоставШаблона.Ссылка.ДлинаИдентификатора = 25
	               |	И ШаблоныИдентификаторовКвитанцийНаОплатуГосуслугСоставШаблона.ФиксированноеПоле = ИСТИНА
	               |	И ШаблоныИдентификаторовКвитанцийНаОплатуГосуслугСоставШаблона.НомерСтроки = 1";
	
	Запрос.УстановитьПараметр("Владелец",Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Если Выборка.ДлинаРеквизита = 8 И СтрДлина(Выборка.Значение)<=8 Тогда
			КодУчастника = СокрЛП(Выборка.Значение);
			КодУчастника = СтрЗаменить(КодУчастника," ","");
			Если Выборка.Перевести16_10 Тогда
				КодУчастника = XMLСтрока(БиблиотекаФункцийОбменаПовтИсп.ПеревестиИз16В10(ВРег(КодУчастника)));				
			КонецЕсли;
			
			КодУчастника = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(Лев(КодУчастника,Выборка.ДлинаРеквизита), Выборка.ДлинаРеквизита); 	
		КонецЕсли;
	КонецЕсли;
		
	Возврат КодУчастника;
	
КонецФункции

Функция ПроверитьУникальностьУИНПоДоговору(УИН,Договор) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	//квитанция может быть сформирована на основании докумена Извещение о начисление доходов, 
	//тогда в ней будет договор как в извещении, а УИН заполнен из договора
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КвитанцияНаОплатуГосуслуг.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.КвитанцияНаОплатуГосуслуг КАК КвитанцияНаОплатуГосуслуг
		|ГДЕ
		|	КвитанцияНаОплатуГосуслуг.УникальныйИдентификаторНачисления = &УИН
		|	И КвитанцияНаОплатуГосуслуг.Договор <> &Договор
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Договоры.Ссылка
		|ИЗ
		|	Справочник.Договоры КАК Договоры
		|ГДЕ
		|	Договоры.УИН = &УИН
		|	И Договоры.Ссылка <> &Договор";
	
	Запрос.УстановитьПараметр("Договор", Договор);
	Запрос.УстановитьПараметр("УИН", УИН);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
	
КонецФункции
