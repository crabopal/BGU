	РезультирующаяТаблица.Колонки.Добавить("Параметры__ПолеКомплексногоПараметра__Маска_Использовать", Новый ОписаниеТипов("Булево"));
	РезультирующаяТаблица.Колонки.Добавить("Параметры__ПолеКомплексногоПараметра__ЗначениеПоУмолчанию");          //DefaultValue
	РезультирующаяТаблица.Колонки.Добавить("Параметры__ПолеКомплексногоПараметра__ЗначениеПоУмолчанию_Использовать", Новый ОписаниеТипов("Булево"));
	РезультирующаяТаблица.Колонки.Добавить("Параметры__ПолеКомплексногоПараметра__ПереченьЗначений");             //AllowedValues
	РезультирующаяТаблица.Колонки.Добавить("Параметры__ПолеКомплексногоПараметра__ПереченьЗначений_Использовать", Новый ОписаниеТипов("Булево"));
	
	//Колонки ТЧ Параметры__ПереченьЗначений
	РезультирующаяТаблица.Колонки.Добавить("Параметры__ПереченьЗначений__НаименованиеЗначения"); //@label
	РезультирующаяТаблица.Колонки.Добавить("Параметры__ПереченьЗначений__НаименованиеЗначения_Использовать", Новый ОписаниеТипов("Булево"));
	РезультирующаяТаблица.Колонки.Добавить("Параметры__ПереченьЗначений__ЗначениеВыбрано");      //@isSelected
	РезультирующаяТаблица.Колонки.Добавить("Параметры__ПереченьЗначений__ЗначениеВыбрано_Использовать", Новый ОписаниеТипов("Булево"));
	РезультирующаяТаблица.Колонки.Добавить("Параметры__ПереченьЗначений__Значение");		     //@data

	//Колонки ТЧ Параметры__ПолеКомплексногоПараметра__ПереченьЗначений
	РезультирующаяТаблица.Колонки.Добавить("Параметры__ПолеКомплексногоПараметра__ПереченьЗначений__НаименованиеЗначения"); //@label
	РезультирующаяТаблица.Колонки.Добавить("Параметры__ПолеКомплексногоПараметра__ПереченьЗначений__НаименованиеЗначения_Использовать", Новый ОписаниеТипов("Булево"));
	РезультирующаяТаблица.Колонки.Добавить("Параметры__ПолеКомплексногоПараметра__ПереченьЗначений__ЗначениеВыбрано");      //@isSelected
	РезультирующаяТаблица.Колонки.Добавить("Параметры__ПолеКомплексногоПараметра__ПереченьЗначений__ЗначениеВыбрано_Использовать", Новый ОписаниеТипов("Булево"));
	РезультирующаяТаблица.Колонки.Добавить("Параметры__ПолеКомплексногоПараметра__ПереченьЗначений__Значение");		     //@data
	
	//РеквизитыПлательщика = Новый Структура("НомерСчетаПлательщика, НаименованиеБанкаПлательщика, БикБанкаПлательщика, СчетБанкаПлательщика", "СчетНомер", "Банк", "БИК", "КоррСчет");
	//ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(ДокументСсылка.ЛицевойСчет, ДокументСсылка.РеквизитыЛицевогоСчета, РеквизитыПлательщика);

	ПрефиксКодаГосУслуги = "";
	КодСистемыИнициатора = "";
		
	КоличествоСтрок = РезультирующаяТаблица.Количество();
	
	ПредДок = Неопределено;
	ПорядковыйНомер = 1;
	ТекОрганизация = Справочники.Организации.ПустаяСсылка();
	ВерсияФорматов = "";
	Для Инд = 0 По КоличествоСтрок-1 Цикл
		Если РезультирующаяТаблица[Инд].ССЫЛКАДОКУМЕНТА <> ПредДок Тогда 
			ПорядковыйНомер = 1;
			ПредДок = РезультирующаяТаблица[Инд].ССЫЛКАДОКУМЕНТА;
			ТекОрганизация = РезультирующаяТаблица[Инд].Организация;
			ВерсияФорматов = БиблиотекаФункцийОбмена.ПолучитьЗначениеТребуемойНастройкиОрганизация(ТекОрганизация,Неопределено,"ВерсияФорматов");			
		КонецЕсли;
		РезультирующаяТаблица[Инд].НомерСтроки = ПорядковыйНомер;
		РезультирующаяТаблица[Инд].ПОЛЕСВЯЗИ   = Истина;
		
		РеквизитыПлательщика = Новый Структура("НомерСчетаПлательщика, НаименованиеБанкаПлательщика, БикБанкаПлательщика, СчетБанкаПлательщика", "СчетНомер", "Банк", "БИК", "КоррСчет");
		ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(РезультирующаяТаблица[Инд].ЛицевойСчет, РезультирующаяТаблица[Инд].РеквизитЛС, РеквизитыПлательщика);

		КПСКод = "";
		Если ТипЗнч(РезультирующаяТаблица[Инд].НачалоДействияКПС) = Тип("Дата") Тогда
			КПСКод = ПолучитьКодБК(ТекОрганизация,РезультирующаяТаблица[Инд].КПС,РезультирующаяТаблица[Инд].КЭК,РезультирующаяТаблица[Инд].НачалоДействияКПС,Неопределено,РезультирующаяТаблица[Инд].ЛицевойСчет);
		КонецЕсли;	
		РезультирующаяТаблица[Инд].КодКПС = КПСКод;
		
		РезультирующаяТаблица[Инд].СчетНомер = РеквизитыПлательщика.НомерСчетаПлательщика;
        РезультирующаяТаблица[Инд].Банк = РеквизитыПлательщика.НаименованиеБанкаПлательщика;
        РезультирующаяТаблица[Инд].БИК = РеквизитыПлательщика.БикБанкаПлательщика;
		РезультирующаяТаблица[Инд].КоррСчет = РеквизитыПлательщика.СчетБанкаПлательщика;
		
		ДополнитьСтрокуПоНастройке(РезультирующаяТаблица[Инд]);
		ДополнитьСтрокуСлужебнымиПараметрами(РезультирующаяТаблица[Инд],ПрефиксКодаГосУслуги,КодСистемыИнициатора,ВерсияФорматов);
				
		ПорядковыйНомер = ПорядковыйНомер + 1;       
	КонецЦикла;		
	
    Возврат РезультирующаяТаблица;
	

КонецФункции

Функция ПолучитьТаблицуПараметровПодписок(ДокИлиМассив)Экспорт
		
	Запрос = Новый Запрос;
	МассивСсылок = Новый Массив;
	Если ТипЗнч(ДокИлиМассив) = Тип("ДокументСсылка.ПодпискаНаУведомлениеГИСГМП") Тогда
		МассивСсылок.Добавить(ДокИлиМассив);
	Иначе
		МассивСсылок = ДокИлиМассив;
	КонецЕсли;
	//Запрос.УстановитьПараметр("Ссылка",ДокументСсылка);
	Запрос.УстановитьПараметр("Организация",ОбщегоНазначения.ЗначениеРеквизитаОбъекта(МассивСсылок[0],"Организация"));
	//Запрос.УстановитьПараметр("ДатаДокумента",ДокументСсылка.Дата);
	Запрос.УстановитьПараметр("МассивСсылок",МассивСсылок);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗначенияПараметров.Ссылка КАК ССЫЛКАДОКУМЕНТА,
		|	ЗначенияПараметров.КодПараметра КАК КодПараметра,
		|	ЗначенияПараметров.ЗначениеПараметра КАК ЗначениеПараметра,
		|	ГруппаПараметров.КлючСтроки КАК КлючСтроки,
		|	ГруппаПараметров.СтатусПараметра КАК СтатусПараметра
		|ИЗ
		|	Документ.ПодпискаНаУведомлениеГИСГМП.ГруппыПараметров КАК ГруппаПараметров
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ПодпискаНаУведомлениеГИСГМП.ЗначенияПараметровПодписки КАК ЗначенияПараметров
		|		ПО ГруппаПараметров.Ссылка = ЗначенияПараметров.Ссылка
		|			И ГруппаПараметров.КлючСтроки = ЗначенияПараметров.КлючСтроки
		|ГДЕ
		|	ГруппаПараметров.Ссылка В(&МассивСсылок)
		|	И ГруппаПараметров.СтатусПараметра В (1, 2, 3)
		|ИТОГИ ПО
		|	ССЫЛКАДОКУМЕНТА,
		|	КлючСтроки";
	
	Результат = Запрос.Выполнить();
	ВыборкаДокумент = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	РезультирующаяТаблица = Новый ТаблицаЗначений;
	РезультирующаяТаблица.Колонки.Добавить("ИмяТабЧасти", Новый ОписаниеТипов("Строка",Новый КвалификаторыСтроки(1000)));
    РезультирующаяТаблица.Колонки.Добавить("НомерСтроки");
	РезультирующаяТаблица.Колонки.Добавить("ПОЛЕСВЯЗИ");
	РезультирующаяТаблица.Колонки.Добавить("ССЫЛКАДОКУМЕНТА");
	РезультирующаяТаблица.Колонки.Добавить("КлючСтроки");
	РезультирующаяТаблица.Колонки.Добавить("СтатусПараметра");
	
	//Общие колонки для вложенных ТЧ
	РезультирующаяТаблица.Колонки.Добавить("НомерСтроки_ГЛ", Новый ОписаниеТипов("Строка",Новый КвалификаторыСтроки(1000)));
	РезультирующаяТаблица.Колонки.Добавить("ИмяТабЧасти_ГЛ", Новый ОписаниеТипов("Строка",Новый КвалификаторыСтроки(1000)));	
		
	//Колонки ТЧ Параметры
	РезультирующаяТаблица.Колонки.Добавить("Параметры__КодПараметра");
    РезультирующаяТаблица.Колонки.Добавить("Параметры__ЗначениеПараметра", Новый ОписаниеТипов("Строка",Новый КвалификаторыСтроки(1000)));

	
	Пока ВыборкаДокумент.Следующий() Цикл
		НомерСтроки = 1;
		ВыборкаКлюч = ВыборкаДокумент.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаКлюч.Следующий() Цикл
			СтрГлав = РезультирующаяТаблица.Добавить();
			СтрГлав.ИмяТабЧасти = "ГРУППАПАРАМЕТРОВ";
			СтрГлав.ПОЛЕСВЯЗИ = ИСТИНА;
			СтрГлав.ССЫЛКАДОКУМЕНТА = ВыборкаКлюч.ССЫЛКАДОКУМЕНТА;
			СтрГлав.КлючСтроки = ВыборкаКлюч.КлючСтроки;
			
			СтрГлав.НомерСтроки = НомерСтроки;
			ВыборкаДетальная = ВыборкаКлюч.Выбрать();
			НомерДет = 1;
			Пока ВыборкаДетальная.Следующий() Цикл
				СтрГлав.СтатусПараметра = ВыборкаДетальная.СтатусПараметра;
				
				НовСтр = РезультирующаяТаблица.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтр,СтрГлав);
				НовСтр.НомерСтроки = НомерДет;
				НовСтр.НомерСтроки_ГЛ = "__"+Строка(СтрГлав.НомерСтроки);
				НовСтр.ИмяТабЧасти = "ПАРАМЕТРЫ";
				НовСтр.ИмяТабЧасти_ГЛ = СтрГлав.ИмяТабЧасти;
				НовСтр.Параметры__КодПараметра = ВыборкаДетальная.КодПараметра;
				НовСтр.Параметры__ЗначениеПараметра = ВыборкаДетальная.ЗначениеПараметра;
				
				НомерДет = НомерДет + 1;
			КонецЦикла;
			НомерСтроки = НомерСтроки + 1;
		КонецЦикла;
	КонецЦикла;
	
		
    Возврат РезультирующаяТаблица;
	

КонецФункции


Процедура ОчисткаИсторииЗапросаДанныхИзОчередиГИСГМП() Экспорт
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания(Метаданные.РегламентныеЗадания.ОчисткаИсторииЗапросаДанныхИзОчередиГИСГМП);
	
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюГИСГМП")
		И НЕ ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюСУНИФО") Тогда
		Возврат;
	КонецЕсли;
	
	ИмяСобытия = НСтр("ru = 'Очистка истории запроса данных из очереди ГИС ГМП / ИС РНИП / ИС УНП'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка());
	
	ЗаписьЖурналаРегистрации(
		ИмяСобытия,
		УровеньЖурналаРегистрации.Информация,
		,
		,
		НСтр("ru = 'Начато регламентное очистки истории запроса данных из очереди ГИС ГМП / ИС РНИП / ИС УНП.'"));
		
	УстановитьПривилегированныйРежим(Истина);

	Если МонопольныйРежим() Тогда
		// Если база работает в монопольном режиме (например, запущено фоновое задание, которое включило монопольный режим
		//  и выгружает данные из области данных для последующей загрузки в модели сервиса),
		//  то будут ошибки при всех попытках записи данных в базу.
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,
			УровеньЖурналаРегистрации.Информация,
			,
			,
			НСтр("ru='Принудительное завершение выполнения регламентного задания: информационная база открыта в монопольном режиме.'"));
		Возврат;
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 100000
		|	СообщенияЗапросаДанныхОчередиСМЭВ3.Организация КАК Организация,
		|	СообщенияЗапросаДанныхОчередиСМЭВ3.ГУИД КАК ГУИД,
		|	СообщенияЗапросаДанныхОчередиСМЭВ3.ДатаЗапроса КАК ДатаЗапроса,
		|	СообщенияЗапросаДанныхОчередиСМЭВ3.ФорматОбмена КАК ФорматОбмена
		|ИЗ
		|	РегистрСведений.СообщенияЗапросаДанныхОчередиСМЭВ3 КАК СообщенияЗапросаДанныхОчередиСМЭВ3
		|ГДЕ
		|	СообщенияЗапросаДанныхОчередиСМЭВ3.ЕстьДанные = ЛОЖЬ
		|
		|УПОРЯДОЧИТЬ ПО
		|	Организация,
		|	ДатаЗапроса УБЫВ
		|ИТОГИ ПО
		|	Организация,
		|	ФорматОбмена";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаОрганизация = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	//смысл обработчика - оставляем одну последнюю запись запроса данных из очереди по каждому формату, при котором не было данных в ответе
	//удаляем по 100 000 записей за раз
	Пока ВыборкаОрганизация.Следующий() Цикл
				
		ВыборкаФорматОбмена = ВыборкаОрганизация.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		НаборЗаписей = РегистрыСведений.СообщенияЗапросаДанныхОчередиСМЭВ3.СоздатьНаборЗаписей();
		
		Пока ВыборкаФорматОбмена.Следующий() Цикл 
			
			Первый = Истина;
			
			ВыборкаДетальныеЗаписи = ВыборкаФорматОбмена.Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				Если Первый Тогда
					Первый = Ложь;
					Продолжить;
				КонецЕсли;
				
				ЗаписьНЗ = НаборЗаписей.Добавить();
				ЗаполнитьЗначенияСвойств(ЗаписьНЗ,ВыборкаДетальныеЗаписи); 
			КонецЦикла;
		
		КонецЦикла;
		Если НаборЗаписей.Количество() Тогда
			НаборЗаписей.Записать(РежимЗамещения.Удаление);
		КонецЕсли;	
	КонецЦикла;
	
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Информация,,,
		НСтр("ru = 'Завершено регламентное задание ""Очистка истории запроса данных из очереди ГИС ГМП / ИС РНИП / ИС УНП""'"),
		);
КонецПроцедуры

