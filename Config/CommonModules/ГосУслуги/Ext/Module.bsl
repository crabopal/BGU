					НовСтр.Параметры__ЭтоИдентификатор_Использовать = "false";
				   	НовСтр.Параметры__Видимость = "false";                    
					НовСтр.Параметры__Видимость_Использовать = "true";
					НовСтр.Параметры__ДляПоиска = "false";                   
				    НовСтр.Параметры__ДляПоиска_Использовать = "true";
					НовСтр.Параметры__ДляПлатежа = "true";                    
				    НовСтр.Параметры__ДляПлатежа_Использовать = "true";
					НовСтр.Параметры__Маска = "";
					НовСтр.Параметры__Маска_Использовать = "false";
					
					КассовыйОрган = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТЧ.РеквизитЛС,"КассовыйОрган.Наименование");
					НовСтр.Параметры__ЗначениеПоУмолчанию = КассовыйОрган;
					
					НовСтр.Параметры__ЗначениеПоУмолчанию_Использовать = "true";
	    			НовСтр.Параметры__ПереченьЗначений_Использовать = "false";
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Функция ПолеИспользуется(СтрокаДерева)
	Возврат НЕ (СтрокаДерева.Отключить ИЛИ СтрокаДерева.ПолеОтключеноРодителем);	
КонецФункции

Процедура ОбходВложенныхСтрокДерева(ТаблицаПоНастройке,СтрокаДереваВх,Знач Путь)
	
	Для Каждого СтрокаДерева Из СтрокаДереваВх.Строки Цикл
		ЭтоТЧ = Ложь;
		Если СтрокаДерева.Множественное Тогда
			ЭтоТЧ = Истина;
			ИмяКолонки = Путь + "_СлужТЧ_" + СтрЗаменить(СтрокаДерева.ИмяВФайле,"@","_СОБАКА_");
		Иначе
			ИмяКолонки = Путь + "_СлужПоле_" + СтрЗаменить(СтрокаДерева.ИмяВФайле,"@","_СОБАКА_");
		КонецЕсли;
		Колонка = ТаблицаПоНастройке.Колонки.Найти(ИмяКолонки);
		ЭтаКолонка = Колонка;
		Если Колонка = Неопределено Тогда
			ТаблицаПоНастройке.Колонки.Добавить(ИмяКолонки);
			ТаблицаПоНастройке.Колонки.Добавить(ИмяКолонки+"_Отключено");
			ТаблицаПоНастройке.Колонки.Добавить(ИмяКолонки+"_ЭтоТЧ");
			ЭтаКолонка = ТаблицаПоНастройке.Колонки.Найти(ИмяКолонки);
		КонецЕсли;
		ВхИндекс = ТаблицаПоНастройке.Колонки.Индекс(ТаблицаПоНастройке.Колонки.Найти(Путь));
		КолСтрок = ТаблицаПоНастройке.Количество();
		Если ТаблицаПоНастройке.Колонки.Индекс(ЭтаКолонка)>ВхИндекс И КолСтрок>0 И Колонка = Неопределено Тогда
			НовСтр = ТаблицаПоНастройке[КолСтрок-1];
		Иначе
			НовСтр = ТаблицаПоНастройке.Добавить();
		КонецЕсли;
		НовСтр[ИмяКолонки] = СтрокаДерева.ЗначениеПоля;
		НовСтр[ИмяКолонки+"_Отключено"] = СтрокаДерева.Отключить ИЛИ СтрокаДерева.ПолеОтключеноРодителем;
		НовСтр[ИмяКолонки+"_ЭтоТЧ"] = ЭтоТЧ;
		Если СтрокаДерева.Строки.Количество()>0 Тогда 
			ОбходВложенныхСтрокДерева(ТаблицаПоНастройке,СтрокаДерева,ИмяКолонки);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры


// Возвращает структуру, содержащую ключи "ДополнительныеХарактеристикиНоменклатуры" и "ТаблицаИдентификаторов".
// Входящие параметры:
//	- Номенклатура - СправочникСсылка.Номенклатура - ссылка на номенклатуру, значение настройки которой надо получить;
//	- Дата - дата, на которую необходимо получить значение настройки, если не заполнено - ТекущаяДатаСеанса();
//	- ЗначениеНастройки - если не указана номенклатура, то в данном параметре можно передать полученное ранее значение настройки
//	с типом ХранилищеЗначение
//	Если настройка не найдена, возвращает в значениях ключей Неопределено.
//
Функция ПолучитьЗначениеХарактеристики(Номенклатура=Неопределено,Дата=Неопределено,ЗначениеНастройки=Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Дата) Тогда
		Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	СтруктураНастройки = Новый Структура("ДополнительныеХарактеристикиНоменклатуры,ТаблицаИдентификаторов",Неопределено,Неопределено);
	
	Если Номенклатура<>Неопределено Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ХарактеристикиГосуслугСрезПоследних.ЗначениеНастройки
		|ИЗ
		|	РегистрСведений.ХарактеристикиГосуслуг.СрезПоследних(&Дата, Номенклатура = &Номенклатура) КАК ХарактеристикиГосуслугСрезПоследних";

		Запрос.УстановитьПараметр("Дата", Дата);
		Запрос.УстановитьПараметр("Номенклатура", Номенклатура);

		Результат = Запрос.Выполнить();

		ВыборкаДетальныеЗаписи = Результат.Выбрать();

		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			ЗначениеНастройки = ВыборкаДетальныеЗаписи.ЗначениеНастройки;
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(ЗначениеНастройки) = Тип("ХранилищеЗначения") Тогда
		ПолученноеЗначение = ЗначениеНастройки.Получить();
		Если ТипЗнч(ПолученноеЗначение) = Тип("Структура") Тогда
			СтруктураНастройки = ПолученноеЗначение;		
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтруктураНастройки;	
		
КонецФункции

/////////////////////////////////////////////////////////////////////////
// Формирование таблицы только заполненных идентификаторов документа Квитанция на оплату
// (без единого и альтернативного)

// Функция возвращает таблицу значений, используемую в форматах обмена с ИС РНИП.
// Параметры:
//	- ДокументСсылка - ссылка на документ "КвитанцияНаОплатуГосуслуг", либо массив ссылок;
//
Функция ПолучитьТаблицуДополнительныхДанных(ДокументСсылка) Экспорт
	
	МассивСсылок = Новый Массив;
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.КвитанцияНаОплатуГосуслуг") Тогда
		МассивСсылок.Добавить(ДокументСсылка);
	Иначе
		МассивСсылок = ДокументСсылка;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КвитанцияНаОплатуГосуслугТаблицаИдентификаторов.Ссылка КАК ССЫЛКАДОКУМЕНТА,
		|	КвитанцияНаОплатуГосуслугТаблицаИдентификаторов.ИмяВФайле,
		|	КвитанцияНаОплатуГосуслугТаблицаИдентификаторов.ПолеИдентификатор,
		|	&ИмяТЧ КАК ИмяТабЧасти,
		|	ИСТИНА КАК ПОЛЕСВЯЗИ
		|ИЗ
		|	Документ.КвитанцияНаОплатуГосуслуг.ТаблицаИдентификаторов КАК КвитанцияНаОплатуГосуслугТаблицаИдентификаторов
		|ГДЕ
		|	КвитанцияНаОплатуГосуслугТаблицаИдентификаторов.Ссылка В(&МассивСсылок)
		|	И КвитанцияНаОплатуГосуслугТаблицаИдентификаторов.ИмяВФайле <> ""UnifiedPayerIdentifier""
		|	И КвитанцияНаОплатуГосуслугТаблицаИдентификаторов.ИмяВФайле <> ""AltPayerIdentifier""
		|	И Подстрока(КвитанцияНаОплатуГосуслугТаблицаИдентификаторов.ПолеИдентификатор,1,1) <>""""
		|
		|УПОРЯДОЧИТЬ ПО
		|	ССЫЛКАДОКУМЕНТА";

	Запрос.УстановитьПараметр("МассивСсылок", МассивСсылок);
    Запрос.УстановитьПараметр("ИмяТЧ", ВРег("ТаблицаДопДанных"));
	
	Результат = Запрос.Выполнить();

	ТаблицаДопДанных = Результат.Выгрузить();
    ТаблицаДопДанных.Колонки.Добавить("НомерСтроки");
	Для Каждого ЭлМас Из МассивСсылок Цикл			
		НовСтр = ТаблицаДопДанных.Добавить();
		НовСтр.ИмяВФайле = "SRV_CODE";
		НовСтр.ССЫЛКАДОКУМЕНТА = ЭлМас;
		НовСтр.ПолеСвязи = ИСТИНА;
		НовСтр.ИмяТабЧасти =  ВРег("ТаблицаДопДанных");
		НовСтр.ПолеИдентификатор =  СтроковыеФункцииКлиентСервер.ДополнитьСтроку(Прав(БиблиотекаФункцийОбмена.ЗначениеРеквизита(ЭлМас,"Номенклатура.Код"),10),10);
	КонецЦикла;
	
	ПредДок = Неопределено;
	ПорядковыйНомер = 1;
	Для Каждого СтрТЧ Из ТаблицаДопДанных Цикл
		Если СтрТЧ.ССЫЛКАДОКУМЕНТА <> ПредДок Тогда 
			ПорядковыйНомер = 1;
			ПредДок = СтрТЧ.ССЫЛКАДОКУМЕНТА;
		КонецЕсли;
		СтрТЧ.НомерСтроки = ПорядковыйНомер;
		ПорядковыйНомер = ПорядковыйНомер + 1;		
	КонецЦикла;
	
	Возврат ТаблицаДопДанных;
КонецФункции

/////////////////////////////////////////////////////////////////////////
// Подготовка к экспорту 

// Функция формирует прокси по настройкам прокси (передаваемому параметру)
//
// Параметры:
// 
// НастройкиПрокси - Соответствие -
//                 ключи:
//                 НеИспользоватьПроксиДляЛокальныхАдресов - строка - 
//                 Сервер       - адрес прокси-сервера
//                 Порт         - порт прокси-сервера
//                 Пользователь - имя пользователя для авторизации на прокси-сервере
//                 Пароль       - пароль пользователя
// Протокол      - строка - протокол для которого устанавливаются параметры прокси сервера
//                 например "http", "https", "ftp"
// 
Функция СформироватьПрокси(НастройкиПрокси, Протокол) Экспорт
	
	Прокси = Новый ИнтернетПрокси;
	Прокси.НеИспользоватьПроксиДляЛокальныхАдресов = НастройкиПрокси["НеИспользоватьПроксиДляЛокальныхАдресов"];
	Прокси.Установить(Протокол, НастройкиПрокси["Сервер"], НастройкиПрокси["Порт"]);
	Прокси.Пользователь = НастройкиПрокси["Пользователь"];
	Прокси.Пароль       = НастройкиПрокси["Пароль"];
	
	Возврат Прокси;
	
КонецФункции

Функция ПолучитьДанныеПодготовки(ЗаданиеСсылка) Экспорт
	
	СоответствиеДанных = Новый Соответствие;
	СоответствиеДанных.Вставить("НужнаПодготовка",Истина);
	
	МассивПараметров = Новый Массив;
	МассивПараметров.Добавить("ОтпечатокСущностей");
	МассивПараметров.Добавить("ОтпечатокЗаголовка");
	
	//Это на сервере
	СоответствиеПараметров = Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПолучитьПараметрыНастройкиОбмена(МассивПараметров,ЗаданиеСсылка.НастройкаОбмена);
	
	ОтпечатокПодписиСущностей = СоответствиеПараметров.Получить("ОтпечатокСущностей");
	
	ОтпечатокПодписиЗаголовка = СоответствиеПараметров.Получить("ОтпечатокЗаголовка");
	
	Если ОтпечатокПодписиСущностей <> Неопределено Тогда
		СоответствиеПараметров.Вставить("ОтпечатокСущностей",ОтпечатокПодписиСущностей);
	КонецЕсли;
	Если ОтпечатокПодписиЗаголовка <> Неопределено Тогда
		СоответствиеПараметров.Вставить("ОтпечатокЗаголовка",ОтпечатокПодписиЗаголовка);
	КонецЕсли;
	
	СоответствиеДанных.Вставить("СоответствиеПараметров",СоответствиеПараметров);
	
	Если ОтпечатокПодписиСущностей = Неопределено И ОтпечатокПодписиЗаголовка = Неопределено Тогда
		//В параметрах не указано, что необходимо что-то подписывать, значит и подписывать ничего не будем
		СоответствиеДанных.Вставить("НужнаПодготовка",Ложь);
		Возврат СоответствиеДанных;
	КонецЕсли;
	
	//Это на сервере
	ФайлыДляПереноса = Новый Массив;
	РаботаСФайлами.ЗаполнитьПрисоединенныеФайлыКОбъекту(ЗаданиеСсылка,ФайлыДляПереноса);
	
	ФайлыДанных = Новый Соответствие;
	
	Для Каждого ФайлПереноса Из ФайлыДляПереноса Цикл
		
		ДанныеФайла = РаботаСФайлами.ДанныеФайла(ФайлПереноса);	
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
		ПолучитьИзВременногоХранилища(ДанныеФайла.СсылкаНаДвоичныеДанныеФайла).Записать(ИмяВременногоФайла);
					
		ТекстовыйФайл = Новый ЧтениеТекста(ИмяВременногоФайла, КодировкаТекста.UTF8);
		СодержимоеФайла = ТекстовыйФайл.Прочитать();
		
        ФайлыДанных.Вставить(ФайлПереноса,СодержимоеФайла);
		
	    ТекстовыйФайл.Закрыть();
		УдалитьФайлы(ИмяВременногоФайла);

	КонецЦикла;
	
	СоответствиеДанных.Вставить("ФайлыДанных",ФайлыДанных);
	
	Возврат СоответствиеДанных;
	
КонецФункции

Функция ПолучитьДанныеПодготовки_1_16(ЗаданиеСсылка,МассивОтправляемыхФайлов=Неопределено) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	НастройкаОрганизацийДляГИСГМП_УНП.Организация КАК Организация
		|ПОМЕСТИТЬ ВремТаб
		|ИЗ
		|	РегистрСведений.НастройкаОрганизацийДляГИСГМП_УНП КАК НастройкаОрганизацийДляГИСГМП_УНП
		|ГДЕ
		|	(НастройкаОрганизацийДляГИСГМП_УНП.Организация = &Организация
		|				И НастройкаОрганизацийДляГИСГМП_УНП.Подведомственный = НЕОПРЕДЕЛЕНО
		|			ИЛИ НастройкаОрганизацийДляГИСГМП_УНП.Подведомственный = &Организация)
		|	И НастройкаОрганизацийДляГИСГМП_УНП.ВидОбмена = &ВидОбмена
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НастройкаОтправителей.Организация КАК Организация,
		|	НастройкаОтправителей.Подведомственный КАК Подведомственный,
		|	НастройкаОтправителей.УРН КАК УРН,
		|	НастройкаОтправителей.КодУчастника КАК КодУчастника,
		|	НастройкаОтправителей.АдресTSA КАК АдресTSA,
		|	НастройкаОтправителей.РежимВзаимодействия КАК РежимВзаимодействия,
		|	НастройкаОтправителей.РежимПодписи КАК РежимПодписи,
		|	НастройкаОтправителей.СертификатЭПНачислений КАК СертификатЭПНачислений,
		|	НастройкаОтправителей.СертификатЭПНачислений.ДанныеСертификата КАК ДанныеСертификатаНачислений,
		|	НастройкаОтправителей.СертификатЭПСообщения КАК СертификатЭПСообщения,
		|	НастройкаОтправителей.СертификатЭПСообщения.ДанныеСертификата КАК ДанныеСертификатаСообщения,
		|	1 КАК ПолеПорядка,
		|	НастройкаОтправителей.ХранитьПарольЭПНачисления КАК ХранитьПарольЭПНачисления,
		|	НастройкаОтправителей.ХранитьПарольЭПСообщения КАК ХранитьПарольЭПСообщения,
		|	НастройкаОтправителей.СертификатЭПНачислений.Программа.ТипПрограммы КАК ТипПрограммыСертификатаНачислений,
		|	НастройкаОтправителей.СертификатЭПСообщения.Программа.ТипПрограммы КАК ТипПрограммыСертификатаСообщения
		|ИЗ
		|	ВремТаб КАК ВремТаб
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкаОрганизацийДляГИСГМП_УНП КАК НастройкаОтправителей
		|		ПО (НастройкаОтправителей.Организация = ВремТаб.Организация)
		|			И (НастройкаОтправителей.Подведомственный = НЕОПРЕДЕЛЕНО)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НастройкаОрганизацийДляГИСГМП_УНП.Организация,
		|	НастройкаОрганизацийДляГИСГМП_УНП.Подведомственный,
		|	НастройкаОрганизацийДляГИСГМП_УНП.УРН,
		|	НастройкаОрганизацийДляГИСГМП_УНП.КодУчастника,
		|	НастройкаОрганизацийДляГИСГМП_УНП.АдресTSA,
		|	НастройкаОрганизацийДляГИСГМП_УНП.РежимВзаимодействия,
		|	НастройкаОрганизацийДляГИСГМП_УНП.РежимПодписи,
		|	НастройкаОрганизацийДляГИСГМП_УНП.СертификатЭПНачислений,
		|	НастройкаОрганизацийДляГИСГМП_УНП.СертификатЭПНачислений.ДанныеСертификата,
		|	НастройкаОрганизацийДляГИСГМП_УНП.СертификатЭПСообщения,
		|	НастройкаОрганизацийДляГИСГМП_УНП.СертификатЭПСообщения.ДанныеСертификата,
		|	2,
		|	НастройкаОрганизацийДляГИСГМП_УНП.ХранитьПарольЭПНачисления,
		|	НастройкаОрганизацийДляГИСГМП_УНП.ХранитьПарольЭПСообщения,
		|	НастройкаОрганизацийДляГИСГМП_УНП.СертификатЭПНачислений.Программа.ТипПрограммы,
		|	НастройкаОрганизацийДляГИСГМП_УНП.СертификатЭПСообщения.Программа.ТипПрограммы
		|ИЗ
		|	РегистрСведений.НастройкаОрганизацийДляГИСГМП_УНП КАК НастройкаОрганизацийДляГИСГМП_УНП
		|ГДЕ
		|	(НастройкаОрганизацийДляГИСГМП_УНП.Организация = &Организация
		|				И НастройкаОрганизацийДляГИСГМП_УНП.Подведомственный <> НЕОПРЕДЕЛЕНО
		|			ИЛИ НастройкаОрганизацийДляГИСГМП_УНП.Подведомственный = &Организация)
		|	И НастройкаОрганизацийДляГИСГМП_УНП.ВидОбмена = &ВидОбмена
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПолеПорядка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТипыОбменаБанкиКСПараметры.Имя КАК Имя,
		|	ТипыОбменаБанкиКСПараметры.Значение КАК Значение,
		|	ТипыОбменаБанкиКСПараметры.НомерСтроки КАК НомерСтроки
		|ИЗ
		|	Справочник.ТипыОбменаБанкиКС.Параметры КАК ТипыОбменаБанкиКСПараметры
		|ГДЕ
		|	ТипыОбменаБанкиКСПараметры.Ссылка = &ВидОбмена
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
	
	Запрос.УстановитьПараметр("Организация", ЗаданиеСсылка.Организация);
	Запрос.УстановитьПараметр("ВидОбмена", ЗаданиеСсылка.ВидОбмена);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаДетальныеЗаписи = РезультатыЗапроса[1].Выбрать();
	
	СоответствиеНастроекОтправителей = Новый Соответствие;
	СоответствиеНастроекПодведомственных = Новый Соответствие;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Хост = "";
		АдресРесурса = "";
		
		ТекАдрес = СокрЛП(ВыборкаДетальныеЗаписи.АдресTSA);
		Если НРег(Лев(ТекАдрес,7)) = "http://" Тогда
			ТекАдрес = Сред(ТекАдрес,8);
		ИначеЕсли  НРег(Лев(ТекАдрес,8)) = "https://" Тогда
			ТекАдрес = Сред(ТекАдрес,9);
		КонецЕсли;
		
		Порт = Неопределено;
		
		ПозицияПортаВАдресе = Найти(ТекАдрес,":");
		
		ПозицияНачалаАдресаРесурса = Найти(ТекАдрес,"/");
		
		Если ПозицияПортаВАдресе > 0 И ПозицияНачалаАдресаРесурса> ПозицияПортаВАдресе Тогда
			Хост = Сред(ТекАдрес,1,ПозицияПортаВАдресе-1);
			Порт = Число(Сред(ТекАдрес,ПозицияПортаВАдресе+1,ПозицияНачалаАдресаРесурса-ПозицияПортаВАдресе-1)); 
		Иначе
			Хост = Сред(ТекАдрес,1,ПозицияНачалаАдресаРесурса-1);
		КонецЕсли;
		АдресРесурса = Сред(ТекАдрес,ПозицияНачалаАдресаРесурса);
	
		СтруктураНастроекТSA = Новый Структура("Хост,АдресРесурса,Порт",Хост,АдресРесурса,Порт);
		
		СтруктураНастроек = Новый Структура("ПарольЭПНачисления,ПарольЭПСообщения,СертификатЭПНачислений,СертификатЭПСообщения,РежимПодписи,РежимВзаимодействия,ТипПрограммыСертификатаНачислений,ТипПрограммыСертификатаСообщения","","");
		ЗаполнитьЗначенияСвойств(СтруктураНастроек,ВыборкаДетальныеЗаписи);
		
		Если ЗначениеЗаполнено(СтруктураНастроек.СертификатЭПНачислений) Тогда
			ДанныеСертификата = Base64Строка(ВыборкаДетальныеЗаписи.ДанныеСертификатаНачислений.Получить());
			ДанныеСертификата = СтрЗаменить(СтрЗаменить(ДанныеСертификата,Символы.ВК,""),Символы.ПС,"");
			СтруктураНастроек.Вставить("ДанныеСертификатаНачислений",ДанныеСертификата);
		Иначе
			СтруктураНастроек.Вставить("ДанныеСертификатаНачислений","");
		КонецЕсли;
		Если ЗначениеЗаполнено(СтруктураНастроек.СертификатЭПСообщения) Тогда
			ДанныеСертификата = Base64Строка(ВыборкаДетальныеЗаписи.ДанныеСертификатаСообщения.Получить());
			ДанныеСертификата = СтрЗаменить(СтрЗаменить(ДанныеСертификата,Символы.ВК,""),Символы.ПС,"");
			СтруктураНастроек.Вставить("ДанныеСертификатаСообщения",ДанныеСертификата);
		Иначе
			СтруктураНастроек.Вставить("ДанныеСертификатаСообщения","");
		КонецЕсли;
		
		СтруктураНастроек.Вставить("СтруктураНастроекТSA",СтруктураНастроекТSA);
		СтруктураНастроек.Вставить("АдресTSA",ВыборкаДетальныеЗаписи.АдресTSA);
		
		СтруктураНастроек.Вставить("ХранитьПарольЭПНачисления",ВыборкаДетальныеЗаписи.ХранитьПарольЭПНачисления);
		СтруктураНастроек.Вставить("ХранитьПарольЭПСообщения",ВыборкаДетальныеЗаписи.ХранитьПарольЭПСообщения);
			
		Если ВыборкаДетальныеЗаписи.ПолеПорядка = 1 Тогда
						
			Если ВыборкаДетальныеЗаписи.ХранитьПарольЭПНачисления 
				ИЛИ ВыборкаДетальныеЗаписи.ХранитьПарольЭПСообщения Тогда
				УстановитьПривилегированныйРежим(Истина);
				СтруктураПаролей = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ВыборкаДетальныеЗаписи.Организация,"ПарольЭПНачислений,ПарольЭПСообщения");
				УстановитьПривилегированныйРежим(Ложь);
				Если ВыборкаДетальныеЗаписи.ХранитьПарольЭПНачисления Тогда
					СтруктураНастроек.Вставить("ПарольЭПНачисления",?(ЗначениеЗаполнено(СтруктураПаролей.ПарольЭПНачислений),СтруктураПаролей.ПарольЭПНачислений,""));
				КонецЕсли;
				Если ВыборкаДетальныеЗаписи.ХранитьПарольЭПСообщения Тогда
					СтруктураНастроек.Вставить("ПарольЭПСообщения",?(ЗначениеЗаполнено(СтруктураПаролей.ПарольЭПСообщения),СтруктураПаролей.ПарольЭПСообщения,""));
				КонецЕсли;
			КонецЕсли;
			
			СоответствиеНастроекОтправителей.Вставить(ВыборкаДетальныеЗаписи.Организация,СтруктураНастроек);
		Иначе

			СтруктураНастроек.Вставить("Организация",ВыборкаДетальныеЗаписи.Подведомственный);
			СтруктураНастроек.Вставить("Отправитель",ВыборкаДетальныеЗаписи.Организация);
			
			Если ВыборкаДетальныеЗаписи.ХранитьПарольЭПНачисления 
				ИЛИ ВыборкаДетальныеЗаписи.ХранитьПарольЭПСообщения Тогда
				УстановитьПривилегированныйРежим(Истина);
				СтруктураПаролей = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ВыборкаДетальныеЗаписи.Подведомственный,"ПарольЭПНачислений,ПарольЭПСообщения");
				УстановитьПривилегированныйРежим(Ложь);
				Если ВыборкаДетальныеЗаписи.ХранитьПарольЭПНачисления Тогда
					СтруктураНастроек.Вставить("ПарольЭПНачисления",?(ЗначениеЗаполнено(СтруктураПаролей.ПарольЭПНачислений),СтруктураПаролей.ПарольЭПНачислений,""));
				КонецЕсли;
				Если ВыборкаДетальныеЗаписи.ХранитьПарольЭПСообщения Тогда
					СтруктураНастроек.Вставить("ПарольЭПСообщения",?(ЗначениеЗаполнено(СтруктураПаролей.ПарольЭПСообщения),СтруктураПаролей.ПарольЭПСообщения,""));
				КонецЕсли;
			КонецЕсли;
			
			СоответствиеНастроекПодведомственных.Вставить(ВыборкаДетальныеЗаписи.Подведомственный,СтруктураНастроек);
		КонецЕсли;
	КонецЦикла;
	
	ВыборкаПараметровВидаОбмена = РезультатыЗапроса[2].Выбрать();
	СтруктураПараметровВидаОбмена = Новый Структура;
	
	Пока ВыборкаПараметровВидаОбмена.Следующий() Цикл
		Попытка
			СтруктураПараметровВидаОбмена.Вставить(ВыборкаПараметровВидаОбмена.Имя,ВыборкаПараметровВидаОбмена.Значение);
		Исключение
			//Ничего страшного, значит это не корректный параметр, такой не нужен
		КонецПопытки;
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	СоответствиеДанных = Новый Соответствие;

	СоответствиеДанных.Вставить("СоответствиеНастроекОтправителей",СоответствиеНастроекОтправителей);
	СоответствиеДанных.Вставить("СоответствиеНастроекПодведомственных",СоответствиеНастроекПодведомственных);
	СоответствиеДанных.Вставить("СтруктураПараметровВидаОбмена",СтруктураПараметровВидаОбмена);
	
	//Это на сервере
	Если МассивОтправляемыхФайлов = Неопределено Тогда
		ФайлыДляПереноса = Новый Массив;
		РаботаСФайлами.ЗаполнитьПрисоединенныеФайлыКОбъекту(ЗаданиеСсылка,ФайлыДляПереноса);
	Иначе
		ФайлыДляПереноса = МассивОтправляемыхФайлов;
	КонецЕсли;
	
	ФайлыДанных = Новый Соответствие;
	
	// а теперь парсим и ищем документы
	//DoAcknowledgmentRequest
	//Charge - только тут могут быть разные
	//ServiceCatalog
	//Changes
	//ExportRequest
	СоответствиеГУИДОрганизаций = Новый Соответствие;
	Для Каждого ФайлПереноса Из ФайлыДляПереноса Цикл
		
		ДанныеФайла = РаботаСФайлами.ДанныеФайла(ФайлПереноса);	
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
		ПолучитьИзВременногоХранилища(ДанныеФайла.СсылкаНаДвоичныеДанныеФайла).Записать(ИмяВременногоФайла);
					
		ТекстовыйФайл = Новый ЧтениеТекста(ИмяВременногоФайла, КодировкаТекста.UTF8);
		СодержимоеФайла = ТекстовыйФайл.Прочитать();
		
		КопияСодержимого = СодержимоеФайла;
		ИскомоеВыражение = "<Charge"; 
		Поз = Найти(КопияСодержимого,ИскомоеВыражение);
		БлокКонца= "</Charge>";
		ВыражениеID = " Id=""";
		Пока Поз>0 Цикл		
			ПозКонца = Найти(КопияСодержимого,БлокКонца);
			БлокНачисления = Сред(КопияСодержимого,Поз,ПозКонца-Поз+СтрДлина(БлокКонца));
			Если Найти(БлокНачисления,"Signature")>0 Тогда
				// это уже подписанное начисление, тут ничего не нужно делать.
				КопияСодержимого = Сред(КопияСодержимого,ПозКонца+СтрДлина(БлокКонца));
				Поз = Найти(КопияСодержимого,ИскомоеВыражение);
				Продолжить;
			КонецЕсли;
			ПозицияНачалаВыраженияID = Найти(БлокНачисления,ВыражениеID);
			Если ПозицияНачалаВыраженияID>0 Тогда
				ГУИД = Сред(БлокНачисления,ПозицияНачалаВыраженияID+СтрДлина(ВыражениеID)+2,36);
				ТекНачисление = Документы.НачислениеОтПодведомственного.НайтиПоИДНачисления("N_"+ГУИД);
			
				Если НЕ ОбщегоНазначения.СсылкаСуществует(ТекНачисление) Тогда
					СоответствиеГУИДОрганизаций.Вставить(ГУИД,ЗаданиеСсылка.Организация);
				Иначе	
					ТекОрганизация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекНачисление,"Получатель");
					СоответствиеГУИДОрганизаций.Вставить(ГУИД,ТекОрганизация);
				КонецЕсли;
				
			КонецЕсли;
			КопияСодержимого = Сред(КопияСодержимого,ПозКонца+СтрДлина(БлокКонца));
			Поз = Найти(КопияСодержимого,ИскомоеВыражение); 
		КонецЦикла;
		
		
        ФайлыДанных.Вставить(ФайлПереноса,СодержимоеФайла);
		
	    ТекстовыйФайл.Закрыть();
		УдалитьФайлы(ИмяВременногоФайла);

	КонецЦикла;
	
	СоответствиеДанных.Вставить("ПакетНачислений",СоответствиеГУИДОрганизаций);
	
	СоответствиеДанных.Вставить("ФайлыДанных",ФайлыДанных);
	
	СоответствиеДанных.Вставить("ОтправляемыеФайлы",ФайлыДляПереноса);
	
	СоответствиеДанных.Вставить("Организация",ЗаданиеСсылка.Организация);
	
	СоответствиеДанных.Вставить("ПодписыватьСообщенияДляГИСГМПНаСервере",Константы.ПодписыватьСообщенияДляГИСГМПНаСервере.Получить());
	СоответствиеДанных.Вставить("ОбращатьсяКTSAСерверуНаСервере",Константы.ОбращатьсяКTSAСерверуНаСервере.Получить());
	
	Возврат СоответствиеДанных;
	
КонецФункции

Функция ПолучитьДанныеПодготовкиСпискаЗаданий_1_16(СписокЗаданий) Экспорт
	
	СоответствиеДанныхЗаданий = Новый Соответствие;
		
	Для Каждого СтрокаСписка ИЗ СписокЗаданий Цикл
		СоответствиеДанныхЗаданий.Вставить(СтрокаСписка.Значение,ПолучитьДанныеПодготовки_1_16(СтрокаСписка.Значение)); 
	КонецЦикла;
	
	Возврат СоответствиеДанныхЗаданий;
	
КонецФункции

//Подписать файлы и обратиться к TSA серверу по формату 1.16
Функция ПодписатьДанныеПоФормату_1_16_НаСервере(Знач КонтекстВыполнения,Знач Данные) Экспорт
	
	ФайлыДляПереноса = Данные.Получить("ФайлыДанных");
	
	// а теперь парсим и ищем блоки подписей:
	//DoAcknowledgmentRequest - 1 элемент
	//ServiceCatalog - 1 элемент
	//Changes - 1 элемент
	//ExportRequest - 1 элемент
	//Charge - только тут могут быть разные сертификаты, а самих блоков в файле - несколько. Обрабатывается отдельно.
	
	МассивОдиночных = Новый Массив;
	МассивОдиночных.Добавить("DoAcknowledgmentRequest"); //квитирование		
	МассивОдиночных.Добавить("ExportRequest");  //запрос к системе
	МассивОдиночных.Добавить("ServiceCatalog"); //каталог услуг ИС РНИП или ИС УНП
	МассивОдиночных.Добавить("Changes");        //каталог услуг ИС РНИП или ИС УНП
			
	ВыражениеID = " Id=""";
	
	ТекПакетНачислений = Данные["ПакетНачислений"];
	
	СоответствиеОбновленныхФайлов = Новый Соответствие;
	
	НастройкиОтправителя = Данные["СоответствиеНастроекОтправителей"][Данные["Организация"]];
	
	//Принцип использования подписей участников следующий:
	//1) для подписи заголовка всегда используется сертификат заголовка отправителя - организации - прямого участника.
	//2) для подписи сущностей ExportRequest, DoAcknowledgmentRequest - всегда используется сертификат для подписи начислений отправителя - организации - прямого участника,
	//		т.к. предполагается, что все запросы к системе выполняет отправитель (АН - для себя, ГАН - для себя и подведомственных). 
	//		Такой сценарий был реализован для форматов 1.15, его и придерживаемся.
	//3) для подписи сущностей ServiceCatalog, Changes - всегда используется сертификат для подписи начислений отправителя - организации - прямого участника, 
	//		т.к. косвенного взаимодействия при обмене с ИС РНИП и ИС УНП не предусматривается.
	//4) для подписи начислений используется сертификат участника - сформировавшего начисление:
	//		- в документе "Квитанция на оплату" участник - в реквизите Организация - это может быть как участник прямого взаимодейстия, так и косвенного.
	//		- в документе "Начисление от подведомственного" участник - в реквизите Получатель - это участник косвенного взаимодействия.
	Отправитель = Неопределено;
	Если НастройкиОтправителя <> Неопределено Тогда
		ДанныеСертификатаСущности = НастройкиОтправителя.ДанныеСертификатаНачислений;
		ДанныеСертификатаЗаголовка= НастройкиОтправителя.ДанныеСертификатаСообщения;
		Отправитель = Данные["Организация"];
	Иначе
		НастройкиПодведомственного = Данные["СоответствиеНастроекПодведомственных"][Данные["Организация"]];
		
		Если НастройкиПодведомственного = Неопределено Тогда
			ТекстОшибки = "Для организации """ + Данные["Организация"]+""" не заданы настройки участника. Подпись не выполнена.";
					
			Если КонтекстВыполнения.Свойство("ТекстОшибки") Тогда
				КонтекстВыполнения.Вставить("ТекстОшибки",ТекстОшибки);
			Иначе
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
			КонецЕсли;
					
			Возврат Ложь;
		КонецЕсли;                                                         
		
		НастройкиОтправителя = Данные["СоответствиеНастроекОтправителей"][НастройкиПодведомственного.Отправитель];			
		
		Если НастройкиОтправителя <> Неопределено Тогда
			ДанныеСертификатаЗаголовка = НастройкиОтправителя.ДанныеСертификатаСообщения;
			ДанныеСертификатаСущности = НастройкиОтправителя.ДанныеСертификатаНачислений;
			Отправитель = НастройкиПодведомственного.Отправитель;

		КонецЕсли;
	КонецЕсли;
	
	СоответствиеОбновленныхФайлов = Новый Соответствие;
		
	Попытка
		КомпонентаПодписи = СоздатьОбъектДляПодписиXML_xades();
		Если КомпонентаПодписи = Неопределено Тогда
			ТекстОшибки = НСтр("ru='Не удалось создать компоненту для формирования электронной подписи.'");
			
			Если КонтекстВыполнения.Свойство("ТекстОшибки") Тогда
				КонтекстВыполнения.Вставить("ТекстОшибки",ТекстОшибки);
			Иначе
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
			КонецЕсли;
			Возврат Ложь;
		КонецЕсли;
		//В версии 2.2.1.0 добавлено свойство СообщатьОбОшибке Булево и ТекстОшибки Строка
		КомпонентаПодписи.СообщатьОбОшибке = Ложь; //Если ложь, то компонента сама не будет выдавать сообщения об ошибке.
	Исключение
		ТекстОшибки = НСтр("ru='Не удалось создать компоненту для формирования электронной подписи.
		|%1'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Если КонтекстВыполнения.Свойство("ТекстОшибки") Тогда
			КонтекстВыполнения.Вставить("ТекстОшибки",ТекстОшибки);
		Иначе
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		КонецЕсли;
		
		Возврат Ложь;
	КонецПопытки;
	
	ПодписыватьXMLDSIG = Ложь;
	Тип_ЭП = Неопределено;
	Если Данные["СтруктураПараметровВидаОбмена"].Свойство("ТИП_ЭП",Тип_ЭП) Тогда
		ПодписыватьXMLDSIG = Тип_ЭП = "XMLDSIG";
	КонецЕсли;
	ИмяБлокаObject = "Object";
	ДлинаБлокаObject = СтрДлина(ИмяБлокаObject);
			
	Для Каждого КлючИЗначение ИЗ ФайлыДляПереноса Цикл
	    КонтекстВыполнения.Вставить("ИмяФайла",КлючИЗначение.Ключ);
		
		СодержимоеФайла = КлючИЗначение.Значение;
	
		ЕстьИзменения = Ложь;
		ФайлОбработан = Ложь;		
			
		Для Каждого ЭлМас Из МассивОдиночных Цикл
			НачальнаяПозиция = Найти(СодержимоеФайла,"<"+ЭлМас);
			Если НачальнаяПозиция = 0 Тогда
				Продолжить;
			КонецЕсли;
			ДлинаПодписываемогоТега = СтрДлина(ЭлМас);
			
			НачальныйБлок = Сред(СодержимоеФайла,1, НачальнаяПозиция-1);
	    	КонечнаяПозиция = Найти(СодержимоеФайла,"</"+ЭлМас+">");
			БлокПодписи = Сред(СодержимоеФайла,НачальнаяПозиция,КонечнаяПозиция+ДлинаПодписываемогоТега + 3 - НачальнаяПозиция);
			КонечныйБлок = Сред(СодержимоеФайла,КонечнаяПозиция + ДлинаПодписываемогоТега + 3);						
			
			Попытка
				
				КомпонентаПодписи.SignatureID = "_" + Строка(Новый УникальныйИдентификатор());
				КомпонентаПодписи.ПодписатьXadesT(
					БлокПодписи,
					ЭлМас,
					ДанныеСертификатаСущности,"",
					//Формат(ТекущаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ss"),
					Истина,
					Истина,
					НастройкиОтправителя.ПарольЭПНачисления);
					
				Подпись = КомпонентаПодписи.Подпись;
				
				Если ПодписыватьXMLDSIG = Истина Тогда
				
					// XMLDSIG
					
					Подпись = Лев(Подпись,Найти(Подпись,"<"+ИмяБлокаObject)-1)+Сред(Подпись,Найти(Подпись,"</"+ИмяБлокаObject)+ДлинаБлокаObject+3);
					СодержимоеФайла = Сред(СодержимоеФайла, 1, КонечнаяПозиция - 1) + Подпись + Сред(СодержимоеФайла,КонечнаяПозиция);
				
				Иначе
					
					ТелоЗапросаДвоичныеДанные = Base64Значение(КомпонентаПодписи.ПолучитьТелоЗапросаКTSA());
					РезультатОтправки = ОтправитьЗапросКTSAСерверу(НастройкиОтправителя,ТелоЗапросаДвоичныеДанные,ЭлМас);
					
					Если РезультатОтправки.Успех = Истина Тогда
						
						КомпонентаПодписи.ПоставитьШтампВремени(РезультатОтправки.ТекстОтвета);
						Подпись = КомпонентаПодписи.Подпись;
					
						СодержимоеФайла = Сред(СодержимоеФайла, 1, КонечнаяПозиция - 1) + Подпись + Сред(СодержимоеФайла,КонечнаяПозиция);
							
					Иначе
						Если КонтекстВыполнения.Свойство("ТекстОшибки") Тогда
							КонтекстВыполнения.Вставить("ТекстОшибки",РезультатОтправки.ТекстОшибки);
						Иначе
							ОбщегоНазначения.СообщитьПользователю(РезультатОтправки.ТекстОшибки);
						КонецЕсли;
																				
						Возврат Ложь;
					КонецЕсли;
								
				КонецЕсли;
			Исключение
								
				ТекстОшибки = НСтр("ru='При формировании подписи возникла ошибка. Не удалось подписать %1.
						|%2
						|Описание ошибки внешней компоненты: %3'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ЭлМас,ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),КомпонентаПодписи.ТекстОшибки);
							
				Если КонтекстВыполнения.Свойство("ТекстОшибки") Тогда
					КонтекстВыполнения.Вставить("ТекстОшибки",ТекстОшибки);
				Иначе
					ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
				КонецЕсли;
				
				Возврат Ложь;					
			КонецПопытки;
					
			ФайлОбработан = Истина;
		КонецЦикла;
		
		Если НЕ ФайлОбработан Тогда
			// тут подписываем все Charge
			
			ПозицияПоиска = 1;
			
			ИмяУзла = "Charge";
			ДлинаТега = СтрДлина(ИмяУзла);
			
			Пока Истина Цикл
				НеОбработанныйТекст = Сред(СодержимоеФайла,ПозицияПоиска);
				
				НачальнаяПозиция = Найти(НеОбработанныйТекст,"<" + ИмяУзла);
				
				Если НачальнаяПозиция=0 Тогда
					Прервать;
				КонецЕсли;
				
				НачальныйБлок = Сред(НеОбработанныйТекст,1, НачальнаяПозиция-1);
			    КонечнаяПозиция = Найти(НеОбработанныйТекст,"</"+ИмяУзла+">");
				
				БлокПодписи = Сред(НеОбработанныйТекст,НачальнаяПозиция,КонечнаяПозиция+ДлинаТега + 3 - НачальнаяПозиция);
				КонечныйБлок = Сред(НеОбработанныйТекст,КонечнаяПозиция + ДлинаТега + 3);
				
				Если Найти(БлокПодписи,"Signature")>0 Тогда
					// это уже подписанное начисление, нужно искать следующее
					
					ПозицияПоиска = ПозицияПоиска + КонечнаяПозиция + ДлинаТега + 3;
					Продолжить;
				КонецЕсли;	
										
		        //нужно получить Id сущности - по нему получить участника - из участника получить сертификат начисления для подписи
				
				ПозицияНачалаВыраженияID = Найти(БлокПодписи,ВыражениеID);
				
				ТекГУИД = "";
				
				Если ПозицияНачалаВыраженияID>0 Тогда
					
					ТекГУИД = Сред(БлокПодписи,ПозицияНачалаВыраженияID+СтрДлина(ВыражениеID)+2,36);
					
					ТекУчастник = ТекПакетНачислений[ТекГУИД];
					
					НастройкиТекУчастника = Данные["СоответствиеНастроекОтправителей"][ТекУчастник];
			
					Если НастройкиТекУчастника = Неопределено Тогда
						
						НастройкиТекУчастника = Данные["СоответствиеНастроекПодведомственных"][ТекУчастник];
						
					КонецЕсли;
					
					ДанныеСертификатаСущности = НастройкиТекУчастника.ДанныеСертификатаНачислений;					
					
					
					Если НЕ ЗначениеЗаполнено(ДанныеСертификатаСущности) Тогда
						ТекстОшибки = НСтр("ru='Не удалось подписать начисление участника """+ТекУчастник+""".
						|Не задан сертификат подписи начислений.'");
										
						Если КонтекстВыполнения.Свойство("ТекстОшибки") Тогда
							КонтекстВыполнения.Вставить("ТекстОшибки",ТекстОшибки);
						Иначе
							ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
						КонецЕсли;
						
						Возврат Ложь;
					КонецЕсли;
					
				КонецЕсли;					
				
				Если НЕ ЗначениеЗаполнено(НастройкиТекУчастника.АдресTSA) Тогда
					ТекстОшибки = НСтр("ru='Не удалось подписать начисление участника """+ТекУчастник+""".
					|Для участника не задан адрес TSA сервера для подписи начислений.'");
					
					Если КонтекстВыполнения.Свойство("ТекстОшибки") Тогда
						КонтекстВыполнения.Вставить("ТекстОшибки",ТекстОшибки);
					Иначе
						ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
					КонецЕсли;
			
					Возврат Ложь;
				КонецЕсли;
				
				Попытка
					
				КомпонентаПодписи.SignatureID = "_" + Строка(Новый УникальныйИдентификатор());
				КомпонентаПодписи.ПодписатьXadesT(
					БлокПодписи,
					ИмяУзла,
					ДанныеСертификатаСущности,"",
					//Формат(ТекущаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ss"),
					Истина,
					Истина,
					НастройкиТекУчастника.ПарольЭПНачисления);
					
				Подпись = КомпонентаПодписи.Подпись;
				
				Если ПодписыватьXMLDSIG = Истина Тогда
					// XMLDSIG
					Подпись = Лев(Подпись,Найти(Подпись,"<"+ИмяБлокаObject)-1)+Сред(Подпись,Найти(Подпись,"</"+ИмяБлокаObject)+ДлинаБлокаObject+3);
					СодержимоеФайла = Сред(СодержимоеФайла, 1, КонечнаяПозиция - 2 + ПозицияПоиска) + Подпись + Сред(СодержимоеФайла,КонечнаяПозиция+ПозицияПоиска-1);
		
					ПозицияПоиска = ПозицияПоиска + КонечнаяПозиция + ДлинаТега + 3 + СтрДлина(Подпись);
				
					ФайлОбработан = Истина;
					
				Иначе
					
					ТелоЗапросаДвоичныеДанные = Base64Значение(КомпонентаПодписи.ПолучитьТелоЗапросаКTSA());
					РезультатОтправки = ОтправитьЗапросКTSAСерверу(НастройкиОтправителя,ТелоЗапросаДвоичныеДанные,"начисление");
					
					Если РезультатОтправки.Успех = Истина Тогда
						
						КомпонентаПодписи.ПоставитьШтампВремени(РезультатОтправки.ТекстОтвета);
						Подпись = КомпонентаПодписи.Подпись;
					
						СодержимоеФайла = Сред(СодержимоеФайла, 1, КонечнаяПозиция - 2 + ПозицияПоиска) + Подпись + Сред(СодержимоеФайла,КонечнаяПозиция+ПозицияПоиска-1);
			
						ПозицияПоиска = ПозицияПоиска + КонечнаяПозиция + ДлинаТега + 3 + СтрДлина(Подпись);
					
						ФайлОбработан = Истина;
							
					Иначе
						Если КонтекстВыполнения.Свойство("ТекстОшибки") Тогда
							КонтекстВыполнения.Вставить("ТекстОшибки",РезультатОтправки.ТекстОшибки);
						Иначе
							ОбщегоНазначения.СообщитьПользователю(РезультатОтправки.ТекстОшибки);
						КонецЕсли;
																				
						Возврат Ложь;
					КонецЕсли;
								
				КонецЕсли;
				Исключение
					
					ТекстОшибки = НСтр("ru='При формировании подписи возникла ошибка. Не удалось подписать %1.
						|%2
						|Описание ошибки внешней компоненты: %3'");
					ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,"начисление",ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),КомпонентаПодписи.ТекстОшибки);
					
					Если КонтекстВыполнения.Свойство("ТекстОшибки") Тогда
						КонтекстВыполнения.Вставить("ТекстОшибки",ТекстОшибки);
					Иначе
						ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
					КонецЕсли;		
						
					Возврат Ложь;					
				КонецПопытки;
			КонецЦикла;	
		КонецЕсли;
		
		
		//тут подписываем тело
		Если НЕ ЗначениеЗаполнено(ДанныеСертификатаЗаголовка) Тогда
			ТекстОшибки = НСтр("ru='Не удалось подписать сообщение.
			|Для участника """+Отправитель+""" не задан сертификат подписи всего сообщения.'");
							
			Если КонтекстВыполнения.Свойство("ТекстОшибки") Тогда
				КонтекстВыполнения.Вставить("ТекстОшибки",ТекстОшибки);
			Иначе
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
			КонецЕсли;
			
			Возврат Ложь;
		КонецЕсли;
		
		
		Если Найти(СодержимоеФайла,"<soapenv:Body")>0 Тогда
			НачальныйЗаголовок = "";
			Если Найти(СодержимоеФайла,"<?xml")>0 Тогда
				Позиция = Найти(СодержимоеФайла, "?>");
				Количество = 2;
				Если Сред(СодержимоеФайла,Позиция+2,1)=Символы.ПС Тогда
					Количество = 3;
				КонецЕсли;
				НачальныйЗаголовок = Лев(СодержимоеФайла,Позиция+2);
				СодержимоеФайлаБезЗаголовка = Сред(СодержимоеФайла,Позиция+Количество);
			КонецЕсли;
			
			ПозицияУТМ = Найти(СодержимоеФайлаБезЗаголовка,"<n1:GISGMPTransferMsg");
			ТекстДоУТМ = Лев(СодержимоеФайлаБезЗаголовка,ПозицияУТМ);
			ТекстДоУТМ = СтрЗаменить(СтрЗаменить(ТекстДоУТМ,Символы.ПС,""),Символы.Таб,"");
			
			ПозицияКонецУТМ = Найти(СодержимоеФайлаБезЗаголовка,"</n1:GISGMPTransferMsg");
			ТекстКонец = Сред(СодержимоеФайлаБезЗаголовка,ПозицияКонецУТМ);
			ТекстКонец = СтрЗаменить(СтрЗаменить(ТекстКонец,Символы.ПС,""),Символы.Таб,"");
			
			ТекстСередина = Сред(СодержимоеФайлаБезЗаголовка,ПозицияУТМ+1,ПозицияКонецУТМ-1-ПозицияУТМ);
			СодержимоеФайлаБезЗаголовка = ТекстДоУТМ + ТекстСередина+ТекстКонец;
			
						
			//Вставляем сертификат в заголовок
			СодержимоеФайлаБезЗаголовка = СтрЗаменить(СодержимоеФайлаБезЗаголовка,"%СертификатЗаголовка%",ДанныеСертификатаЗаголовка);
							
			ИмяИскомогоТега = "</wsse:BinarySecurityToken>";
			ДлинаИскомогоТега = СтрДлина(ИмяИскомогоТега);
			
			НачальнаяПозиция = Найти(СодержимоеФайлаБезЗаголовка, ИмяИскомогоТега);
			НачальныйБлок  = Сред(СодержимоеФайлаБезЗаголовка,1, НачальнаяПозиция+ДлинаИскомогоТега-1);
			
			КонечнаяПозиция = НачальнаяПозиция+ДлинаИскомогоТега;
			КонечныйБлок = СокрЛ(Сред(СодержимоеФайлаБезЗаголовка,КонечнаяПозиция));
			
			БлокПодписи = "";
			Попытка
				//Подпись заголовка soap-пакета внешней компонентой
				Если КомпонентаПодписи.XMLDSign(СодержимоеФайлаБезЗаголовка, "Body", ДанныеСертификатаЗаголовка, Ложь, Ложь, НастройкиОтправителя.ПарольЭПСообщения) Тогда
					СодержимоеФайла = НачальныйЗаголовок + НачальныйБлок + КомпонентаПодписи.Sign + КонечныйБлок;
					ЕстьИзменения = Истина;
				Иначе
					
					ТекстОшибки = НСтр("ru='Не удалось подписать заголовок soap-пакета.'");
						
					Если КонтекстВыполнения.Свойство("ТекстОшибки") Тогда
						КонтекстВыполнения.Вставить("ТекстОшибки",ТекстОшибки);
					Иначе
						ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
					КонецЕсли;
										
					Возврат Ложь;
					
				КонецЕсли;				
			Исключение
								
				ТекстОшибки = НСтр("ru='При формировании подписи возникла ошибка. Не удалось подписать %1.
						|%2
						|Описание ошибки внешней компоненты: %3'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,"заголовок soap-пакета",ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),КомпонентаПодписи.ТекстОшибки);
										
				Если КонтекстВыполнения.Свойство("ТекстОшибки") Тогда
					КонтекстВыполнения.Вставить("ТекстОшибки",ТекстОшибки);
				Иначе
					ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
				КонецЕсли;
					
				Возврат Ложь;
					
			КонецПопытки;
			ФайлОбработан = Истина;
		КонецЕсли;
		
		
		Если ФайлОбработан Тогда 
			СоответствиеОбновленныхФайлов.Вставить(КлючИЗначение.Ключ,СодержимоеФайла);
		КонецЕсли;
	КонецЦикла;
	
	КомпонентаПодписи = Неопределено;
	
	Если СоответствиеОбновленныхФайлов.Количество()>0 Тогда
		//Записать изменения
		ОбновитьПрисоединенныеФайлы(СоответствиеОбновленныхФайлов);
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Процедура ПодписатьНачисления_НаСервере(знач ТЧДляПодписи,знач ИмяУзла) Экспорт
	
	Попытка
		КомпонентаПодписи = СоздатьОбъектДляПодписиXML_xades();
		Если КомпонентаПодписи = Неопределено Тогда
			ТекстОшибки = НСтр("ru='Не удалось создать компоненту для формирования электронной подписи.'");
			
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
			Возврат;
		КонецЕсли;
		ИмяЛогФайла = ПолучитьИмяВременногоФайла("txt");
		КомпонентаПодписи.LogPath = ИмяЛогФайла;		
	Исключение
		
		ТекстОшибки = НСтр("ru='Не удалось создать компоненту для формирования электронной подписи.
			|%1'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		
		Возврат;
	КонецПопытки;
	
	ДлинаТега = СтрДлина(ИмяУзла);
	
	
	Для Каждого СтрТЧ Из ТЧДляПодписи Цикл
		Если НЕ ЗначениеЗаполнено(СтрТЧ.РезультатФормирования) Тогда
			ТекстСообщения = НСтр("ru='Не удалось подписать начисление """+СтрТЧ.Объект+""" по причине: не удалось сформировать файл по причине: "+СтрТЧ.ТекстОшибки+"'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			Продолжить;
		КонецЕсли;
		ПозицияНачалаФайла = 1;
		Если Лев(СтрТЧ.РезультатФормирования,2) = "<?" Тогда
			ПозицияНачалаФайла = СтрНайти(СтрТЧ.РезультатФормирования,"?>")+2;
			СтрТЧ.РезультатФормирования = СокрЛП(Сред(СтрТЧ.РезультатФормирования,ПозицияНачалаФайла));
		КонецЕсли;
		//Если Найти(СтрТЧ.РезультатФормирования,"<?xml version=""1.0"" encoding=""UTF-8""?>")>0 Тогда
		//	СтрТЧ.РезультатФормирования = СтрЗаменить(СтрТЧ.РезультатФормирования,"<?xml version=""1.0"" encoding=""UTF-8""?>"+Символы.ПС,"");		
		//КонецЕсли;
		
		Попытка
			
			ДанныеСертификата = СтрТЧ.СертификатЭПНачислений;		 
			
			НачальнаяПозиция = Найти(СтрТЧ.РезультатФормирования,"<" + ИмяУзла);
			НачальныйБлок = Сред(СтрТЧ.РезультатФормирования,1, НачальнаяПозиция-1);
		    КонечнаяПозиция = Найти(СтрТЧ.РезультатФормирования,"</"+ИмяУзла+">");
			БлокПодписи = Сред(СтрТЧ.РезультатФормирования,НачальнаяПозиция,КонечнаяПозиция+ДлинаТега + 3 -НачальнаяПозиция);
			КонечныйБлок = Сред(СтрТЧ.РезультатФормирования,КонечнаяПозиция + ДлинаТега + 3);
			
			КомпонентаПодписи.SignatureID = "_" + Строка(Новый УникальныйИдентификатор());
			КомпонентаПодписи.ПодписатьXadesT(
				БлокПодписи,
				ИмяУзла,
				ДанныеСертификата,"",
				//Формат(ТекущаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ss"),
				Истина,
				Истина,
				СтрТЧ.ПарольЭПНачисления);
				
			Подпись = КомпонентаПодписи.Подпись;
			
				// получаем тело запроса к TSA серверу
			ТелоЗапроса64 = КомпонентаПодписи.ПолучитьТелоЗапросаКTSA();
				// формируем запрос к серверу TSA
			ЗаголовокHTTP 	= Новый Соответствие();
			ЗаголовокHTTP.Вставить("Content-Type", "application/timestamp-query");
			ЗаголовокHTTP.Вставить("Host", СтрТЧ.НастройкаTSA.Хост); //"http://www.cryptopro.ru");
			ЗапросHTTP		= Новый HTTPЗапрос(СтрТЧ.НастройкаTSA.АдресРесурса, ЗаголовокHTTP);//("/tsp/tsp.srf", ЗаголовокHTTP);
			ЗапросHTTP.УстановитьТелоИзДвоичныхДанных(Base64Значение(ТелоЗапроса64));
				// обращаемся к серверу TSA и получаем ответ
			
			ТекПрокси = ПолучениеФайловИзИнтернетаКлиентСервер.ПолучитьПрокси(СтрТЧ.АдресTSA);
											
			СоединениеHTTP = Новый HTTPСоединение(СтрТЧ.НастройкаTSA.Хост,СтрТЧ.НастройкаTSA.Порт,,,ТекПрокси,90);						
			
			ОтветHTTP = СоединениеHTTP.ОтправитьДляОбработки(ЗапросHTTP);
			
			Если ОтветHTTP.КодСостояния = 200 Тогда
				Ответ = ОтветHTTP.ПолучитьТелоКакДвоичныеДанные();
				// ставим штамп времени на подпись
				КомпонентаПодписи.ПоставитьШтампВремени(Base64Строка(Ответ));
				Подпись = КомпонентаПодписи.Подпись;
			
				СтрТЧ.РезультатФормирования = Сред(СтрТЧ.РезультатФормирования,1, КонечнаяПозиция - 1) + Подпись + Сред(СтрТЧ.РезультатФормирования,КонечнаяПозиция);
			Иначе
				ТекстОшибки = НСтр("ru='При формировании подписи возникла ошибка. Не удалось подписать начисление """+СтрТЧ.Объект+""".
				| TSA сервер вернул ошибку: (" + ОтветHTTP.КодСостояния + ") - " + ОтветHTTP.ПолучитьТелоКакСтроку()+"'");
				
				СтрТЧ.РезультатФормирования = "";
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
			КонецЕсли;
					
		Исключение
			ДанныеЛогФайла = Новый ТекстовыйДокумент;
			ДанныеЛогФайла.Прочитать(ИмяЛогФайла);
			
			ТекстЛогФайла = ДанныеЛогФайла.ПолучитьТекст();
		    ДанныеЛогФайла = Неопределено;
			
			ТекстОшибки = НСтр("ru='При формировании подписи возникла ошибка. Не удалось подписать начисление %1.
				|%2
				|Данные лог файла: %3'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,СтрТЧ.Объект,ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),ТекстЛогФайла);				
		
			СтрТЧ.РезультатФормирования = "";

			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
			
			Попытка 
				УдалитьФайлы(ИмяЛогФайла);
			Исключение
			КонецПопытки;
		КонецПопытки;
				
	КонецЦикла;
	
КонецПроцедуры




Функция ПолучитьНастройкиПодписиУчастников(Участник) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	НастройкаОрганизацийДляГИСГМП_УНП.Организация КАК Организация
		|ПОМЕСТИТЬ ВремТаб
		|ИЗ
		|	РегистрСведений.НастройкаОрганизацийДляГИСГМП_УНП КАК НастройкаОрганизацийДляГИСГМП_УНП
		|ГДЕ
		|	(НастройкаОрганизацийДляГИСГМП_УНП.Организация = &Участник
		|				И НастройкаОрганизацийДляГИСГМП_УНП.Подведомственный = НЕОПРЕДЕЛЕНО
		|			ИЛИ НастройкаОрганизацийДляГИСГМП_УНП.Подведомственный = &Участник)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НастройкаОтправителей.Организация КАК Организация,
		|	НастройкаОтправителей.Подведомственный КАК Подведомственный,
		|	НастройкаОтправителей.УРН КАК УРН,
		|	НастройкаОтправителей.КодУчастника КАК КодУчастника,
		|	НастройкаОтправителей.АдресTSA КАК АдресTSA,
		|	НастройкаОтправителей.РежимВзаимодействия КАК РежимВзаимодействия,
		|	НастройкаОтправителей.РежимПодписи КАК РежимПодписи,
		|	НастройкаОтправителей.СертификатЭПНачислений КАК СертификатЭПНачислений,
		|	НастройкаОтправителей.СертификатЭПНачислений.ДанныеСертификата КАК ДанныеСертификатаНачислений,
		|	НастройкаОтправителей.СертификатЭПСообщения КАК СертификатЭПСообщения,
		|	НастройкаОтправителей.СертификатЭПСообщения.ДанныеСертификата КАК ДанныеСертификатаСообщения,
		|	1 КАК ПолеПорядка,
		|	НастройкаОтправителей.ХранитьПарольЭПНачисления КАК ХранитьПарольЭПНачисления,
		|	НастройкаОтправителей.ХранитьПарольЭПСообщения КАК ХранитьПарольЭПСообщения
		|ИЗ
		|	ВремТаб КАК ВремТаб
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкаОрганизацийДляГИСГМП_УНП КАК НастройкаОтправителей
		|		ПО (НастройкаОтправителей.Организация = ВремТаб.Организация)
		|			И (НастройкаОтправителей.Подведомственный = НЕОПРЕДЕЛЕНО)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НастройкаОрганизацийДляГИСГМП_УНП.Организация,
		|	НастройкаОрганизацийДляГИСГМП_УНП.Подведомственный,
		|	НастройкаОрганизацийДляГИСГМП_УНП.УРН,
		|	НастройкаОрганизацийДляГИСГМП_УНП.КодУчастника,
		|	НастройкаОрганизацийДляГИСГМП_УНП.АдресTSA,
		|	НастройкаОрганизацийДляГИСГМП_УНП.РежимВзаимодействия,
		|	НастройкаОрганизацийДляГИСГМП_УНП.РежимПодписи,
		|	НастройкаОрганизацийДляГИСГМП_УНП.СертификатЭПНачислений,
		|	НастройкаОрганизацийДляГИСГМП_УНП.СертификатЭПНачислений.ДанныеСертификата,
		|	НастройкаОрганизацийДляГИСГМП_УНП.СертификатЭПСообщения,
		|	НастройкаОрганизацийДляГИСГМП_УНП.СертификатЭПСообщения.ДанныеСертификата,
		|	2,
		|	НастройкаОрганизацийДляГИСГМП_УНП.ХранитьПарольЭПНачисления,
		|	НастройкаОрганизацийДляГИСГМП_УНП.ХранитьПарольЭПСообщения
		|ИЗ
		|	РегистрСведений.НастройкаОрганизацийДляГИСГМП_УНП КАК НастройкаОрганизацийДляГИСГМП_УНП
		|ГДЕ
		|	(НастройкаОрганизацийДляГИСГМП_УНП.Организация = &Участник
		|				И НастройкаОрганизацийДляГИСГМП_УНП.Подведомственный <> НЕОПРЕДЕЛЕНО
		|			ИЛИ НастройкаОрганизацийДляГИСГМП_УНП.Подведомственный = &Участник)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПолеПорядка";
	
	Запрос.УстановитьПараметр("Участник", Участник);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаДетальныеЗаписи = РезультатыЗапроса[1].Выбрать();
	
	СоответствиеНастроекОтправителей = Новый Соответствие;
	СоответствиеНастроекПодведомственных = Новый Соответствие;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				
		Если ВыборкаДетальныеЗаписи.ПолеПорядка = 1 Тогда
			СтруктураНастроек = Новый Структура("ПарольЭПНачисления,ПарольЭПСообщения,СертификатЭПНачислений,СертификатЭПСообщения,РежимПодписи,РежимВзаимодействия","","");
			ЗаполнитьЗначенияСвойств(СтруктураНастроек,ВыборкаДетальныеЗаписи);
			Если ЗначениеЗаполнено(СтруктураНастроек.СертификатЭПНачислений) Тогда
				ДанныеСертификата = Base64Строка(ВыборкаДетальныеЗаписи.ДанныеСертификатаНачислений.Получить());
				ДанныеСертификата = СтрЗаменить(ДанныеСертификата,Символы.ВК,"");
				СтруктураНастроек.Вставить("ДанныеСертификатаНачислений",ДанныеСертификата);
			Иначе
				СтруктураНастроек.Вставить("ДанныеСертификатаНачислений","");
			КонецЕсли;
			Если ЗначениеЗаполнено(СтруктураНастроек.СертификатЭПСообщения) Тогда
				ДанныеСертификата = Base64Строка(ВыборкаДетальныеЗаписи.ДанныеСертификатаСообщения.Получить());
				ДанныеСертификата = СтрЗаменить(ДанныеСертификата,Символы.ВК,"");
				СтруктураНастроек.Вставить("ДанныеСертификатаСообщения",ДанныеСертификата);
			Иначе
				СтруктураНастроек.Вставить("ДанныеСертификатаСообщения","");
			КонецЕсли;
						
			СтруктураНастроек.Вставить("ХранитьПарольЭПНачисления",ВыборкаДетальныеЗаписи.ХранитьПарольЭПНачисления);
			СтруктураНастроек.Вставить("ХранитьПарольЭПСообщения",ВыборкаДетальныеЗаписи.ХранитьПарольЭПСообщения);
			
			Если ВыборкаДетальныеЗаписи.ХранитьПарольЭПНачисления 
				ИЛИ ВыборкаДетальныеЗаписи.ХранитьПарольЭПСообщения Тогда
				УстановитьПривилегированныйРежим(Истина);
				СтруктураПаролей = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ВыборкаДетальныеЗаписи.Организация,"ПарольЭПНачислений,ПарольЭПСообщения");
				УстановитьПривилегированныйРежим(Ложь);
				Если ВыборкаДетальныеЗаписи.ХранитьПарольЭПНачисления Тогда
					СтруктураНастроек.Вставить("ПарольЭПНачисления",?(ЗначениеЗаполнено(СтруктураПаролей.ПарольЭПНачислений),СтруктураПаролей.ПарольЭПНачислений,""));
				КонецЕсли;
				Если ВыборкаДетальныеЗаписи.ХранитьПарольЭПСообщения Тогда
					СтруктураНастроек.Вставить("ПарольЭПСообщения",?(ЗначениеЗаполнено(СтруктураПаролей.ПарольЭПСообщения),СтруктураПаролей.ПарольЭПСообщения,""));
				КонецЕсли;
			КонецЕсли;
			
			СоответствиеНастроекОтправителей.Вставить(ВыборкаДетальныеЗаписи.Организация,СтруктураНастроек);
		Иначе
			СтруктураНастроек = Новый Структура("ПарольЭПНачисления,ПарольЭПСообщения,СертификатЭПНачислений,СертификатЭПСообщения,РежимПодписи,РежимВзаимодействия","","");
			ЗаполнитьЗначенияСвойств(СтруктураНастроек,ВыборкаДетальныеЗаписи);
			СтруктураНастроек.Вставить("Организация",ВыборкаДетальныеЗаписи.Подведомственный);
			СтруктураНастроек.Вставить("Отправитель",ВыборкаДетальныеЗаписи.Организация);
			
			Если ЗначениеЗаполнено(СтруктураНастроек.СертификатЭПНачислений) Тогда
				ДанныеСертификата = Base64Строка(ВыборкаДетальныеЗаписи.ДанныеСертификатаНачислений.Получить());
				ДанныеСертификата = СтрЗаменить(ДанныеСертификата,Символы.ВК,"");
				СтруктураНастроек.Вставить("ДанныеСертификатаНачислений",ДанныеСертификата);
			Иначе
				СтруктураНастроек.Вставить("ДанныеСертификатаНачислений","");
			КонецЕсли;
			Если ЗначениеЗаполнено(СтруктураНастроек.СертификатЭПСообщения) Тогда
				ДанныеСертификата = Base64Строка(ВыборкаДетальныеЗаписи.ДанныеСертификатаСообщения.Получить());
				ДанныеСертификата = СтрЗаменить(ДанныеСертификата,Символы.ВК,"");
				СтруктураНастроек.Вставить("ДанныеСертификатаСообщения",ДанныеСертификата);
			Иначе
				СтруктураНастроек.Вставить("ДанныеСертификатаСообщения","");
			КонецЕсли;
			
			СтруктураНастроек.Вставить("ХранитьПарольЭПНачисления",ВыборкаДетальныеЗаписи.ХранитьПарольЭПНачисления);
			СтруктураНастроек.Вставить("ХранитьПарольЭПСообщения",ВыборкаДетальныеЗаписи.ХранитьПарольЭПСообщения);
			
			Если ВыборкаДетальныеЗаписи.ХранитьПарольЭПНачисления 
				ИЛИ ВыборкаДетальныеЗаписи.ХранитьПарольЭПСообщения Тогда
				УстановитьПривилегированныйРежим(Истина);
				СтруктураПаролей = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ВыборкаДетальныеЗаписи.Подведомственный,"ПарольЭПНачислений,ПарольЭПСообщения");
				УстановитьПривилегированныйРежим(Ложь);
				Если ВыборкаДетальныеЗаписи.ХранитьПарольЭПНачисления Тогда
					СтруктураНастроек.Вставить("ПарольЭПНачисления",?(ЗначениеЗаполнено(СтруктураПаролей.ПарольЭПНачислений),СтруктураПаролей.ПарольЭПНачислений,""));
				КонецЕсли;
				Если ВыборкаДетальныеЗаписи.ХранитьПарольЭПСообщения Тогда
					СтруктураНастроек.Вставить("ПарольЭПСообщения",?(ЗначениеЗаполнено(СтруктураПаролей.ПарольЭПСообщения),СтруктураПаролей.ПарольЭПСообщения,""));
				КонецЕсли;
			КонецЕсли;
			
			СоответствиеНастроекПодведомственных.Вставить(ВыборкаДетальныеЗаписи.Подведомственный,СтруктураНастроек);
		КонецЕсли;
	КонецЦикла;
		
	УстановитьПривилегированныйРежим(Ложь);
	
	СоответствиеДанных = Новый Соответствие;

	СоответствиеДанных.Вставить("СоответствиеНастроекОтправителей",СоответствиеНастроекОтправителей);
	СоответствиеДанных.Вставить("СоответствиеНастроекПодведомственных",СоответствиеНастроекПодведомственных);
	
	Возврат СоответствиеДанных;
	
КонецФункции



Функция ОтправитьЗапросКTSAСерверу(НастройкиОтправителя,ТелоЗапросаДвоичныеДанные,ИмяБлока) Экспорт
	
	ТекПрокси = ПолучениеФайловИзИнтернетаКлиентСервер.ПолучитьПрокси(НастройкиОтправителя.АдресTSA);
											
	СоединениеHTTP = Новый HTTPСоединение(НастройкиОтправителя.СтруктураНастроекТSA.Хост,НастройкиОтправителя.СтруктураНастроекТSA.Порт,,,ТекПрокси,90);					
							
		// формируем запрос к серверу TSA
	ЗаголовокHTTP 	= Новый Соответствие();
	ЗаголовокHTTP.Вставить("Content-Type", "application/timestamp-query");
	ЗаголовокHTTP.Вставить("Host", НастройкиОтправителя.СтруктураНастроекТSA.Хост);
	
	ЗапросHTTP = Новый HTTPЗапрос(НастройкиОтправителя.СтруктураНастроекТSA.АдресРесурса, ЗаголовокHTTP);
	
	ЗапросHTTP.УстановитьТелоИзДвоичныхДанных(ТелоЗапросаДвоичныеДанные);
		// обращаемся к серверу TSA и получаем ответ
		
	Результат = Новый Структура("Успех,ТекстОшибки,ТекстОтвета");
	ОтветHTTP = СоединениеHTTP.ОтправитьДляОбработки(ЗапросHTTP);
	
	Если ОтветHTTP.КодСостояния = 200 Тогда
		Результат.Успех = Истина;
		Ответ = ОтветHTTP.ПолучитьТелоКакДвоичныеДанные();
						
		Результат.ТекстОтвета = Base64Строка(Ответ);
		
	Иначе
		Результат.Успех = Ложь;
		ТекстОшибки = НСтр("ru='При формировании подписи возникла ошибка. Не удалось подписать """+ИмяБлока+""".
		| TSA сервер вернул ошибку: (" + ОтветHTTP.КодСостояния + ") - " + ОтветHTTP.ПолучитьТелоКакСтроку()+"'");
		
		Результат.ТекстОшибки = ТекстОшибки;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПодписатьБлокXML_XadesT(ИдентификаторТекущейПодписи,БлокПодписи,ИмяУзла,ДанныеСертификата,Параметр4,Параметр5,Параметр6,Пароль=Неопределено) Экспорт
	
	ТекстОшибки = "";
	Попытка
		КомпонентаПодписи = СоздатьОбъектДляПодписиXML_xades();
		//В версии 2.2.1.0 добавлено свойство СообщатьОбОшибке Булево и ТекстОшибки Строка
		КомпонентаПодписи.СообщатьОбОшибке = Ложь; //Если ложь, то компонента сама не будет выдавать сообщения об ошибке.
		КомпонентаПодписи.SignatureID = ИдентификаторТекущейПодписи;
		
		КомпонентаПодписи.ПодписатьXadesT(
								БлокПодписи,
								ИмяУзла,
								ДанныеСертификата,Параметр4,
								//Формат(ТекущаяДата(), "ДФ=yyyy-MM-ddTHH:mm:ss"),
								Параметр5,
								Параметр6,
								Пароль);
	Исключение
		ТекстОшибки = НСтр("ru='1%
					|Описание ошибки внешней компоненты: %2'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),КомпонентаПодписи.ТекстОшибки);
		
		Возврат Новый Структура("ТекстОшибки",ТекстОшибки);
	КонецПопытки;
	
	СтруктураПодписи = Новый Структура;
	СтруктураПодписи.Вставить("Подпись",КомпонентаПодписи.Подпись);
	СтруктураПодписи.Вставить("ТелоЗапроса64", Base64Значение(КомпонентаПодписи.ПолучитьТелоЗапросаКTSA()));//платформа не передает на клиент base64...
	Возврат СтруктураПодписи;
	
КонецФункции

Функция ПоставитьШтампВремени(ИдентификаторТекущейПодписи,Подпись,ТекстОтвета,ТекстОшибки="") Экспорт
	
	ТекстОшибки = "";
	
	Попытка
		КомпонентаПодписи = СоздатьОбъектДляПодписиXML_xades();
		//В версии 2.2.1.0 добавлено свойство СообщатьОбОшибке Булево и ТекстОшибки Строка
		КомпонентаПодписи.СообщатьОбОшибке = Ложь; //Если ложь, то компонента сама не будет выдавать сообщения об ошибке.
		
		КомпонентаПодписи.SignatureID = ИдентификаторТекущейПодписи;
		КомпонентаПодписи.Подпись = Подпись;
		//обход проблемы - xml должен быть заполнен
		КомпонентаПодписи.XML = Подпись;
		КомпонентаПодписи.ПоставитьШтампВремени(ТекстОтвета);
	Исключение
		
		ТекстОшибки = НСтр("ru='При формировании подписи возникла ошибка. Не удалось штамп времени в подпись.
			|%1
			|Описание ошибки внешней компоненты: %2'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),КомпонентаПодписи.ТекстОшибки);
		
		Возврат "";
	КонецПопытки;
	
	Возврат КомпонентаПодписи.Подпись;
	
КонецФункции

Функция УстановитьПодписьXMLDSign(СодержимоеФайлаБезЗаголовка,ИмяУзла,ДанныеСертификата, Параметр4, Параметр5,ПодписалиЗаголовок,Пароль=Неопределено,ТекстОшибки = "") Экспорт
	
	Попытка
		КомпонентаПодписи = СоздатьОбъектДляПодписиXML_xades();
		//В версии 2.2.1.0 добавлено свойство СообщатьОбОшибке Булево и ТекстОшибки Строка
		КомпонентаПодписи.СообщатьОбОшибке = Ложь; //Если ложь, то компонента сама не будет выдавать сообщения об ошибке.
		ПодписалиЗаголовок =  КомпонентаПодписи.XMLDSign(СодержимоеФайлаБезЗаголовка, ИмяУзла, ДанныеСертификата, Параметр4, Параметр5,Пароль);
		
		Если ПодписалиЗаголовок Тогда
			Возврат КомпонентаПодписи.Sign;
		КонецЕсли;
	Исключение
		ТекстОшибки = НСтр("ru='При формировании подписи возникла ошибка. 
			|%1
			|Описание ошибки внешней компоненты: %2'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()),КомпонентаПодписи.ТекстОшибки);

	КонецПопытки;
	
	Возврат "";
	
КонецФункции

