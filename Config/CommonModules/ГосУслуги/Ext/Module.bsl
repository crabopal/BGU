		ОбрабатываемыйДокумент = ВыборкаДетальныеЗаписи.Данные;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ОбрабатываемыйДокумент) Тогда 
		Возврат;
	КонецЕсли;
	
	ДокОбъект = ОбрабатываемыйДокумент.ПолучитьОбъект();
	
	Если ДокОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьОшибки = Ложь;
	ДокОбъект.РезультатИмпортаКод = "";
	ДокОбъект.РезультатИмпортаОписание = "";
	ДокОбъект.РезультатОбработкиОбщий = "";
	
	Если ТаблицаИмпорта.Колонки.Найти("КодОбработки") = Неопределено Тогда
        ТаблицаИмпорта.Колонки.Добавить("КодОбработки");
	КонецЕсли;
	Если ТаблицаИмпорта.Колонки.Найти("ОписаниеОбработки") = Неопределено Тогда
        ТаблицаИмпорта.Колонки.Добавить("ОписаниеОбработки");
	КонецЕсли;
	
	Для Каждого СтрТЧ Из ТаблицаИмпорта Цикл
		ДокОбъект.РезультатИмпортаКод = СтрТЧ.КодОбработки;
		ДокОбъект.РезультатИмпортаОписание = СтрТЧ.ОписаниеОбработки;
		Если СтрТЧ.КодОбработки <> "0" Тогда
			ЕстьОшибки = Истина;
		КонецЕсли;
	КонецЦикла;
		
	Если ЕстьОшибки Тогда
		УстанавливаемыйСтатус = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ОбработанЕстьОшибки;	 
	Иначе
		УстанавливаемыйСтатус = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ОбработанБезОшибок;
