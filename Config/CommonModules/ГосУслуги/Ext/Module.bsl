		Если Таблица.Колонки.Найти("ОписаниеОшибки") = Неопределено Тогда
		    Таблица.Колонки.Добавить("ОписаниеОшибки");
		КонецЕсли;
		
		Если Таблица.Количество() = 1 Тогда
			СтрТЧ = Таблица[0];
			КодОшибки = СтрТЧ.КодОшибки;
			ОписаниеОшибки = СтрТЧ.ОписаниеОшибки;
			ОбработатьОшибкуСтатуса(ИдентификаторСообщенияУчастника,КодОшибки,ОписаниеОшибки);
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	УстанавливаемыйСтатус = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ОбработанБезОшибок;
	
	ВыборкаДетальныеЗаписи = РезультатыЗапроса[0].Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Запись = РегистрыСведений.СообщенияИмпортаДанныхВСМЭВ3.СоздатьМенеджерЗаписи();
		Запись.Организация = ВыборкаДетальныеЗаписи.Организация;
		Запись.ИдентификаторСообщения = ВыборкаДетальныеЗаписи.ИдентификаторСообщения;
		Запись.Прочитать();
								
		Запись.СтатусОтправки = УстанавливаемыйСтатус;
				
		Запись.Записать(Истина);
	КонецЕсли;
	
	Если ЭтоОтветОтЭмулятора Тогда
		Возврат;
	КонецЕсли;
	
	ВыборкаДетальныеЗаписи = РезультатыЗапроса[1].Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
		ДокЗапрос = ВыборкаДетальныеЗаписи.Данные.ПолучитьОбъект();
		ДокЗапрос.СтатусОбработки = УстанавливаемыйСтатус;
		
		//ОбработкаИмпорта = Обработки.ОбменВФорматахУФК_УФЭБС.Создать();
		//Таблица = ОбработкаИмпорта.ЗагрузитьИзФайлаXML3(ТекстФайла,ФорматИмпорта,Документы.ЗаданиеНаИмпортДанныхБанкиКС.ПустаяСсылка());
		
		Если Таблица.Колонки.Найти("Done") <> Неопределено Тогда
			//это отмена квитирования начисления с платежом или с платежами
			СуммаНачисления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокЗапрос.Начисление,"СуммаДокумента");
			Если ДокЗапрос.КвитированиеБезПлатежа Тогда
				Если НЕ ЗначениеЗаполнено(ДокЗапрос.НомерОперацииЧастичногоКвитирования) Тогда
					//это отмена полного квитирования начисления без платежа
					Запись = РегистрыСведений.СтатусыКвитированияНачислений.СоздатьМенеджерЗаписи();
					Запись.Начисление = ДокЗапрос.Начисление;
					Запись.ОстатокЗадолженности = СуммаНачисления;
					Запись.СтатусКвитирования = 3;//Не сквитировано
					Запись.Записать();
					
					//сквитировано принудительно без платежа
					СтруктураРекв = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(ДокЗапрос.Начисление);
					Если СтруктураРекв.Статус = Перечисления.СтатусыИсполненияДокумента.Исполнен Тогда
						СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",ДокЗапрос.Начисление);
						СтруктураРекв.Вставить("Статус",Перечисления.СтатусыИсполненияДокумента.НаИсполнении);
						ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
					КонецЕсли;
				Иначе
					//работа с частиным квитированием будет реализована в след. релизах
				КонецЕсли;	
			Иначе
				//Если это отмена квитирования с платежами, то удалим существующий статус, т.к. он уже не актуален
				Запись = РегистрыСведений.СтатусыКвитированияНачислений.СоздатьМенеджерЗаписи();
				Запись.Начисление = ДокЗапрос.Начисление;
				Запись.Прочитать();
				Если Запись.Выбран() Тогда
					Запись.Удалить();
				КонецЕсли;
				
				Если ДокЗапрос.ОставлятьРаспределенныеПлатежи = Истина Тогда
					//не удаляем распределенные платежи
				Иначе
					//Если это отмена квитирования начисления с платежами, то удалим записи из регистра сопоставления
					//начислений и платежей, по тем документам, которые были указаны в ТЧ.
					Для Каждого СтрТЧ Из ДокЗапрос.ЗапрашиваемыеДанные Цикл
						Если ЗначениеЗаполнено(СтрТЧ.Источник) Тогда
							Запись = РегистрыСведений.СоответствиеНачисленийИПлатежей.СоздатьМенеджерЗаписи();
							Запись.Платеж = СтрТЧ.Источник;
							Запись.Прочитать();
							Если Запись.Выбран() 
								И Запись.Начисление = ДокЗапрос.Начисление Тогда						
								Запись.Удалить();
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
		Иначе
			Если Таблица.Колонки.Найти("isRevoked") = Неопределено Тогда
				Таблица.Колонки.Добавить("isRevoked",Новый ОписаниеТипов("Булево"));
			КонецЕсли;
			Если Таблица.Колонки.Найти("ОстатокЗадолженности") = Неопределено Тогда
				Таблица.Колонки.Добавить("ОстатокЗадолженности",Новый ОписаниеТипов("Число"));
			КонецЕсли;
			
			Если Таблица.Колонки.Найти("Начисление") = Неопределено Тогда
		        Таблица.Колонки.Добавить("Начисление");
			КонецЕсли;
			Если Таблица.Колонки.Найти("СтатусКвитирования") = Неопределено Тогда
		        Таблица.Колонки.Добавить("СтатусКвитирования");
			КонецЕсли;
			Если Таблица.Колонки.Найти("БанковскийИдентификаторПлатежа") = Неопределено Тогда
		        Таблица.Колонки.Добавить("БанковскийИдентификаторПлатежа");
			КонецЕсли;
			Если Таблица.Колонки.Найти("УИН") = Неопределено Тогда
				Таблица.Колонки.Добавить("УИН");
			КонецЕсли;
			Если Таблица.Колонки.Найти("НомерОперацииЧастичногоКвитирования") = Неопределено Тогда
				Таблица.Колонки.Добавить("НомерОперацииЧастичногоКвитирования");//reconcileID
			КонецЕсли;
			
			//это квитирование начисление с платежами или без платежа
			//в таблице может быть до 100 строк Quittance - как результат квитирования по каждому платежу.
			//если результат придет 1, то это или квитирование без платежа или квитирование по платежу.
			//надо тестировать.
			Если Таблица.Количество() = 1 Тогда
				СтрТЧ = Таблица[0];
				Если (ЗначениеЗаполнено(СтрТЧ.Начисление)
						ИЛИ ЗначениеЗаполнено(СтрТЧ.УИН))
					И СтрТЧ.isRevoked <> "true" Тогда
					
					Если ЗначениеЗаполнено(СтрТЧ.Начисление) Тогда
						ТекНачисление = СтрТЧ.Начисление;
					Иначе
						ТекНачисление = БиблиотекаФункцийОбмена.ПолучитьНачислениеПоУИН(СтрТЧ.УИН);	
					КонецЕсли;
					
					Если ЗначениеЗаполнено(ТекНачисление) Тогда
						Запись = РегистрыСведений.СтатусыКвитированияНачислений.СоздатьМенеджерЗаписи();
						Запись.Начисление = ТекНачисление;
						Запись.СтатусКвитирования = СтрТЧ.СтатусКвитирования;				
						Запись.ОстатокЗадолженности = СтрТЧ.ОстатокЗадолженности;
						Запись.Записать();
						
						Если ЗначениеЗаполнено(СтрТЧ.НомерОперацииЧастичногоКвитирования) Тогда
							Если ТипЗнч(ДокЗапрос) = Тип("ДокументОбъект.ЗапросУНИФО") Тогда
								ДокЗапрос.НомерОперацииЧастичногоКвитирования = СтрТЧ.НомерОперацииЧастичногоКвитирования;
							КонецЕсли;
							
							//работа с частиным квитированием будет реализована в след. релизах
							
						КонецЕсли;
						
						
						Если Запись.СтатусКвитирования = 4 Тогда
							//сквитировано принудительно без платежа
							СтруктураРекв = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(ТекНачисление);
							Если СтруктураРекв.Статус <> Перечисления.СтатусыИсполненияДокумента.Исполнен Тогда
								СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",ТекНачисление);
								СтруктураРекв.Вставить("Статус",Перечисления.СтатусыИсполненияДокумента.Исполнен);
								ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
							КонецЕсли;
						Иначе
							Если ТипЗнч(ДокЗапрос) = Тип("ДокументОбъект.ЗапросУНИФО") Тогда
								//квитирование выполнено
								
								МассивТекущихЗначений = Новый Массив;
								МассивТекущихЗначений.Добавить(2);//0 - нет, 1 - Да, 2 - запрос отправлен (прошлое значение Да), 3 - квитирование выполнено, 4 - запрос отправлен (прошлое значение Нет), 5 - сквитировать не удалось
								МассивТекущихЗначений.Добавить(4);//0 - нет, 1 - Да, 2 - запрос отправлен (прошлое значение Да), 3 - квитирование выполнено, 4 - запрос отправлен (прошлое значение Нет), 5 - сквитировать не удалось
								
								НовоеЗначение = 3;  //0 - нет, 1 - Да, 2 - запрос отправлен (прошлое значение Да), 3 - квитирование выполнено, 4 - запрос отправлен (прошлое значение Нет), 5 - сквитировать не удалось
					
								ИзменитьЗначениеТребованияКвитирования(ДокЗапрос,МассивТекущихЗначений,НовоеЗначение);	
							КонецЕсли;
							
							ПроверитьИсполнениеКвитанции(СтрТЧ.Начисление);
							
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			Иначе
				
				МассивБИП = Новый Массив;
				Для Каждого СтрТЧ Из Таблица Цикл
					Если ЗначениеЗаполнено(СтрТЧ.БанковскийИдентификаторПлатежа) Тогда
						МассивБИП.Добавить(СтрТЧ.БанковскийИдентификаторПлатежа);
					КонецЕсли;
				КонецЦикла;
					
				ЗапросСуществующихПлатежей = Новый Запрос;
				ЗапросСуществующихПлатежей.Текст = 
					"ВЫБРАТЬ
	                |	Док.Ссылка КАК Ссылка,
	                |	Док.БанковскийИдентификаторПлатежа КАК БанковскийИдентификаторПлатежа
	                |ИЗ
	                |	Документ.ПлатежВОплатуГосуслуг КАК Док
	                |ГДЕ
	                |	Док.ПометкаУдаления = ЛОЖЬ
	                |	И Док.БанковскийИдентификаторПлатежа В (&МассивБИП)
	                |
	                |ОБЪЕДИНИТЬ ВСЕ
	                |
	                |ВЫБРАТЬ
	                |	ПлатежПодведомственному.Ссылка,
	                |	ПлатежПодведомственному.БанковскийИдентификаторПлатежа
	                |ИЗ
	                |	Документ.ПлатежПодведомственному КАК ПлатежПодведомственному
	                |ГДЕ
	                |	ПлатежПодведомственному.ПометкаУдаления = ЛОЖЬ
	                |	И ПлатежПодведомственному.БанковскийИдентификаторПлатежа В (&МассивБИП)";

				ЗапросСуществующихПлатежей.УстановитьПараметр("МассивБИП",МассивБИП);
				Результат = ЗапросСуществующихПлатежей.Выполнить();
				ТаблицаПлатежей = Результат.Выгрузить();
				ТаблицаПлатежей.Индексы.Добавить("БанковскийИдентификаторПлатежа");
							
				СоотвествиеНачисленийИПлатежей = Новый Соответствие;
				СоответствиеНачисленийИСумм = Новый Соответствие;
				Для Каждого СтрТЧ Из Таблица Цикл
					Если (ЗначениеЗаполнено(СтрТЧ.Начисление)
							ИЛИ ЗначениеЗаполнено(СтрТЧ.УИН))
						И СтрТЧ.isRevoked <> "true" Тогда
						
						Если ЗначениеЗаполнено(СтрТЧ.Начисление) Тогда
							ТекНачисление = СтрТЧ.Начисление;
						Иначе
							ТекНачисление = БиблиотекаФункцийОбмена.ПолучитьНачислениеПоУИН(СтрТЧ.УИН);	
						КонецЕсли;
						
						Если НЕ ЗначениеЗаполнено(ТекНачисление) Тогда
							Продолжить;
						КонецЕсли;
						
						ИдПлатежа = СтрТЧ.БанковскийИдентификаторПлатежа;
						//если было квитирование с несколькими платежами, то у каждого платежа указывается остаток задолженности без учета следующих платежей,
						//поэтому найдем минимальный остаток задолженности, и его запишем в регистр
						СтруктураДанныхНачисления = СоответствиеНачисленийИСумм[ТекНачисление];
						Если СтруктураДанныхНачисления = Неопределено Тогда
							СтруктураДанныхНачисления = Новый Структура;
							СтруктураДанныхНачисления.Вставить("СтатусКвитирования", СтрТЧ.СтатусКвитирования);
							СтруктураДанныхНачисления.Вставить("ОстатокЗадолженности", СтрТЧ.ОстатокЗадолженности);
						Иначе
							СтруктураДанныхНачисления.ОстатокЗадолженности = Мин(СтруктураДанныхНачисления.ОстатокЗадолженности,СтрТЧ.ОстатокЗадолженности);
						КонецЕсли;
						СоответствиеНачисленийИСумм.Вставить(ТекНачисление,СтруктураДанныхНачисления);
												
						МассивПлатежей = СоотвествиеНачисленийИПлатежей[ТекНачисление];
						Если МассивПлатежей = Неопределено Тогда
							МассивПлатежей = Новый Массив;
						КонецЕсли;
							
						СтрПлатежа = ТаблицаПлатежей.Найти(ИдПлатежа,"БанковскийИдентификаторПлатежа");
						Если СтрПлатежа <> Неопределено Тогда						
							МассивПлатежей.Добавить(СтрПлатежа.Ссылка);
							СоотвествиеНачисленийИПлатежей.Вставить(ТекНачисление,МассивПлатежей);
						КонецЕсли;
												
					КонецЕсли;
				КонецЦикла;
				
				Для Каждого КлючИЗначение Из СоответствиеНачисленийИСумм Цикл
					ТекНачисление = КлючИЗначение.Ключ;
					
					Запись = РегистрыСведений.СтатусыКвитированияНачислений.СоздатьМенеджерЗаписи();
					Запись.Начисление = ТекНачисление;
					Запись.СтатусКвитирования = КлючИЗначение.Значение.СтатусКвитирования;				
					Запись.ОстатокЗадолженности = КлючИЗначение.Значение.ОстатокЗадолженности;
					Запись.Записать();
						
					ПроверитьИсполнениеКвитанции(ТекНачисление);
				КонецЦикла;
				
				Если ТипЗнч(ДокЗапрос) = Тип("ДокументОбъект.ЗапросУНИФО")
					И ДокЗапрос.ТипЗапрашиваемыхДанных = "DOACKNOWLEDGMENTREQUEST" Тогда
					
					//квитирование выполнено
					
					МассивТекущихЗначений = Новый Массив;
					МассивТекущихЗначений.Добавить(2);//0 - нет, 1 - Да, 2 - запрос отправлен (прошлое значение Да), 3 - квитирование выполнено, 4 - запрос отправлен (прошлое значение Нет), 5 - сквитировать не удалось
					МассивТекущихЗначений.Добавить(4);//0 - нет, 1 - Да, 2 - запрос отправлен (прошлое значение Да), 3 - квитирование выполнено, 4 - запрос отправлен (прошлое значение Нет), 5 - сквитировать не удалось

					НовоеЗначение = 3;  //0 - нет, 1 - Да, 2 - запрос отправлен (прошлое значение Да), 3 - квитирование выполнено, 4 - запрос отправлен (прошлое значение Нет), 5 - сквитировать не удалось
							
					Для Каждого КлючИЗначение Из СоотвествиеНачисленийИПлатежей Цикл
						ТекНачисление = КлючИЗначение.Ключ;
						МассивПлатежей = КлючИЗначение.Значение;
						Если МассивПлатежей.Количество() = 0 Тогда
							Продолжить;
						КонецЕсли;
						ИзменитьЗначениеТребованияКвитированияДляМассиваПлатежей(МассивПлатежей,ТекНачисление, МассивТекущихЗначений, НовоеЗначение);
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		ДокЗапрос.Записать();
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);	
	
КонецПроцедуры

// Запрос платежей и квитирование
// метод экспортный - для тестирования загрузки платежей из xml
Процедура ОбработатьРезультатЗапросаПлатежей(ИдентификаторСообщенияУчастника,ТекУчастник,ТекстФайла,ТаблицаДляЗапросаНовыхДанных,ЭтоОтветОтЭмулятора,ДополнительныеДанные) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ЭтоОтветОтЭмулятора Тогда
		//Только установим статус, что получили от эмулятора ответ.
		//Ответ либо приходит эталонный, либо не приходит вообще.
	    УстановитьСтатусОбработкиСообщения(ИдентификаторСообщенияУчастника,Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ОбработанБезОшибок, "Платежей получено от эмулятора: 1");
		
		УстановитьПривилегированныйРежим(Ложь);
		
		Возврат;	
	КонецЕсли;
	
	ИмяФормата = "ExportPaymentsResponse";
	
	НастройкиУчастника = БиблиотекаФункцийОбменаПовтИсп.ПолучитьНастройкиОтправителя(ТекУчастник);
	
	ФорматИмпорта = Справочники.ФорматыОбменаБанкиКС.ПолучитьФорматПоВладельцуНаправлениюНаименованию(НастройкиУчастника.ВидОбмена,Перечисления.НаправлениеОбменаБанкиКС.Импорт,ИмяФормата);
	
	Если НЕ ЗначениеЗаполнено(ФорматИмпорта) Тогда
		
		Текст = Нстр("ru='Отсутствует формат импорта данных из сервиса с кодом ""%1""'");
		Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст,ИмяФормата);
		ОбщегоНазначения.СообщитьПользователю(Текст);
		Возврат;
		
	КонецЕсли;
			
	ОбработкаИмпорта = Обработки.ОбменВФорматахУФК_УФЭБС.Создать();
	Таблица = ОбработкаИмпорта.ЗагрузитьИзФайлаXML3(ТекстФайла,ФорматИмпорта,Документы.ЗаданиеНаИмпортДанныхБанкиКС.ПустаяСсылка());
	
	Если Таблица.Колонки.Найти("СквитированноеНачисление") = Неопределено Тогда
		Таблица.Колонки.Добавить("СквитированноеНачисление");
	КонецЕсли;
	Если Таблица.Колонки.Найти("УникальныйИдентификаторНачисления") = Неопределено Тогда
		Таблица.Колонки.Добавить("УникальныйИдентификаторНачисления");
	КонецЕсли;
	Если Таблица.Колонки.Найти("СначалаОрганизации") = Неопределено Тогда
		Таблица.Колонки.Добавить("СначалаОрганизации");
	КонецЕсли;
	Если Таблица.Колонки.Найти("БанковскийИдентификаторПлатежа") = Неопределено Тогда
		Таблица.Колонки.Добавить("БанковскийИдентификаторПлатежа");
	КонецЕсли;
	Если Таблица.Колонки.Найти("ИННПолучателя") = Неопределено Тогда
		Таблица.Колонки.Добавить("ИННПолучателя");
	КонецЕсли;
	Если Таблица.Колонки.Найти("КПППолучателя") = Неопределено Тогда
		Таблица.Колонки.Добавить("КПППолучателя");
	КонецЕсли;
	Если Таблица.Колонки.Найти("hasMore") = Неопределено Тогда
		Таблица.Колонки.Добавить("hasMore",Новый ОписаниеТипов("Булево"));
	КонецЕсли;
	
	Если Таблица.Колонки.Найти("СуммаВозврата") = Неопределено Тогда
		Таблица.Колонки.Добавить("СуммаВозврата",ОбщегоНазначения.ОписаниеТипаЧисло(18,2));
	КонецЕсли;
	
	Если Таблица.Колонки.Найти("ИдентификаторВозврата") = Неопределено Тогда
		Таблица.Колонки.Добавить("ИдентификаторВозврата");
	КонецЕсли;
	
	Если Таблица.Колонки.Найти("СлужебноеПоле_ТабличнаяЧасть") = Неопределено Тогда
		Таблица.Колонки.Добавить("СлужебноеПоле_ТабличнаяЧасть");
	КонецЕсли;
	
	ВозможныПлатежиПодведомственных = ПолучитьФункциональнуюОпцию("ЭтоБазаГАН") И ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюГИСГМП");
	
	Объект = Неопределено;
	ТаблицаПолучателей = Новый ТаблицаЗначений;
	ТаблицаПолучателей.Колонки.Добавить("ИНН");
	ТаблицаПолучателей.Колонки.Добавить("КПП");
	ТаблицаПолучателей.Колонки.Добавить("Получатель");
	ТаблицаПолучателей.Колонки.Добавить("Организация");
	
	ТаблицаПолучателей.Индексы.Добавить("ИНН,КПП");
	
	
	
	МассивИменПараметров = Новый Массив;
	МассивИменПараметров.Добавить("ЗагружатьНовыеИзмененныеПлатежи");
	ЗагружатьНовыеИзмененныеПлатежи = Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПолучитьПараметрыНастройкиОбмена(МассивИменПараметров,НастройкиУчастника.НастройкаОбмена).Получить("ЗагружатьНовыеИзмененныеПлатежи");
	
	Если ЗагружатьНовыеИзмененныеПлатежи<>Ложь Тогда
		ЗагружатьНовыеИзмененныеПлатежи = Истина;
	КонецЕсли;
	
	НуженСледующийЗапрос = Ложь;
	
	СначалаОрганизации = Истина;
	
	МассивБИП = Новый Массив;
	МассивЛишнихСтрок = Новый Массив;
	ТекСтрокаПлатежа = Неопределено;
	Для Каждого СтрТЧ Из Таблица Цикл
		НуженСледующийЗапрос = СтрТЧ.hasMore ИЛИ НуженСледующийЗапрос;
		Если ЗначениеЗаполнено(СтрТЧ.БанковскийИдентификаторПлатежа) Тогда
			МассивБИП.Добавить(СтрТЧ.БанковскийИдентификаторПлатежа);
		КонецЕсли;
		Если СтрТЧ.СначалаОрганизации = Ложь
			И ВозможныПлатежиПодведомственных = Истина Тогда
			//смотрим в первую очередь получателей - контрагентов АН только если в базе включена опция
			СначалаОрганизации = Ложь;
		КонецЕсли;
				
		Если ЗначениеЗаполнено(СтрТЧ.БанковскийИдентификаторПлатежа) Тогда
			ТекСтрокаПлатежа = СтрТЧ;
			ТекСтрокаПлатежа.СуммаВозврата = 0;
		ИначеЕсли ЗначениеЗаполнено(СтрТЧ.СлужебноеПоле_ТабличнаяЧасть)
			И ЗначениеЗаполнено(СтрТЧ.СуммаВозврата)
			И ТекСтрокаПлатежа <> Неопределено
			И СтрНачинаетсяС(СтрТЧ.СлужебноеПоле_ИдентификаторСтроки,ТекСтрокаПлатежа.СлужебноеПоле_ИдентификаторСтроки+"/") Тогда
			
			ТекСтрокаПлатежа.СуммаВозврата = ТекСтрокаПлатежа.СуммаВозврата + СтрТЧ.СуммаВозврата;//в итоговую строку платежа заполним сумму возвратов из детальных строк
			МассивЛишнихСтрок.Добавить(СтрТЧ);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ЭлМас Из МассивЛишнихСтрок Цикл
		Таблица.Удалить(ЭлМас);
	КонецЦикла;
	
	ДатаОбменаЗапроса = Неопределено;
	ЗапросКСМЭВ = Неопределено;
	ИдЗапросаРС = Неопределено;
	
	ОпределитьДанныеЗапросаПоИдентификатору(ИдентификаторСообщенияУчастника,ДатаОбменаЗапроса,ЗапросКСМЭВ,ИдЗапросаРС);

	ЗапросСуществующихПлатежей = Новый Запрос;
	ЗапросСуществующихПлатежей.Текст =  "ВЫБРАТЬ
	                                    |	Док.Ссылка КАК Ссылка,
	                                    |	Док.СодержимоеФайла КАК СодержимоеФайла,
	                                    |	Док.БанковскийИдентификаторПлатежа КАК БанковскийИдентификаторПлатежа,
	                                    |	Док.СуммаВозврата КАК СуммаВозврата
	                                    |ИЗ
	                                    |	Документ.ПлатежВОплатуГосуслуг КАК Док
	                                    |ГДЕ
	                                    |	Док.ПометкаУдаления = ЛОЖЬ
	                                    |	И Док.БанковскийИдентификаторПлатежа В(&МассивБИП)
	                                    |
	                                    |ОБЪЕДИНИТЬ ВСЕ
	                                    |
	                                    |ВЫБРАТЬ
	                                    |	ПлатежПодведомственному.Ссылка,
	                                    |	ПлатежПодведомственному.СодержимоеФайла,
	                                    |	ПлатежПодведомственному.БанковскийИдентификаторПлатежа,
	                                    |	ПлатежПодведомственному.СуммаВозврата
	                                    |ИЗ
	                                    |	Документ.ПлатежПодведомственному КАК ПлатежПодведомственному
	                                    |ГДЕ
	                                    |	ПлатежПодведомственному.ПометкаУдаления = ЛОЖЬ
	                                    |	И ПлатежПодведомственному.БанковскийИдентификаторПлатежа В(&МассивБИП)";

	ЗапросСуществующихПлатежей.УстановитьПараметр("МассивБИП",МассивБИП);
	Результат = ЗапросСуществующихПлатежей.Выполнить();
	ТаблицаПлатежей = Результат.Выгрузить();
	ТаблицаПлатежей.Индексы.Добавить("БанковскийИдентификаторПлатежа");
	
	КолДок = 0;
	КоличествоВсего = 0;
	
	Объект = Неопределено;
	
	Таблица.Сортировать("СлужебноеПоле_ТабличнаяЧасть Возр");
	
	СтрПоискаНачала = "<";
	СтрПоискаКонца = "PaymentInfo>";
	КолСимволовСКонца = СтрДлина(СтрПоискаКонца);
	
	СквитированноеНачисление = Неопределено;
	Для Каждого СтрТЧ Из Таблица Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрТЧ.СлужебноеПоле_ТабличнаяЧасть)
			И ЗначениеЗаполнено(СтрТЧ.БанковскийИдентификаторПлатежа) Тогда 
						
			ПозицияТекПл = СтрНайти(ТекстФайла,СтрТЧ.БанковскийИдентификаторПлатежа);
			ПозицияНачалаПлатежа = СтрНайти(ТекстФайла,СтрПоискаНачала,НаправлениеПоиска.СКонца,ПозицияТекПл,1);
			
			ПозицияКонцаПлатежа = СтрНайти(ТекстФайла,СтрПоискаКонца,НаправлениеПоиска.СНачала,ПозицияТекПл,1)+КолСимволовСКонца;
			СодержимоеФайла = Сред(ТекстФайла,ПозицияНачалаПлатежа,ПозицияКонцаПлатежа-ПозицияНачалаПлатежа+1);
						
			
			КоличествоВсего = КоличествоВсего + 1;
			
			Объект = Неопределено;
			СквитированноеНачисление = Неопределено;
			
			СквитированноеНачисление = СтрТЧ.СквитированноеНачисление;
			
		    БанковскийИдентификаторПлатежа = СтрТЧ.БанковскийИдентификаторПлатежа;
			СтрокаПлатежа = ТаблицаПлатежей.Найти(БанковскийИдентификаторПлатежа,"БанковскийИдентификаторПлатежа");
			
			Если СтрокаПлатежа <> Неопределено Тогда
								
				Если ЗагружатьНовыеИзмененныеПлатежи = Истина
					И СтрокаПлатежа.СодержимоеФайла = СодержимоеФайла
					И СтрокаПлатежа.СуммаВозврата = СтрТЧ.СуммаВозврата Тогда
					
					//Платеж был ранее загружен и сумма возвратов совпадает 
					
					Если ЗначениеЗаполнено(ЗапросКСМЭВ) Тогда
						ЗарегистрироватьЗагрузкуДанных(ИдентификаторСообщенияУчастника,СтрокаПлатежа.Ссылка,ЗапросКСМЭВ,ДатаОбменаЗапроса,Ложь);
					ИначеЕсли ЗначениеЗаполнено(ИдЗапросаРС) Тогда
						ЗарегистрироватьЗагрузкуДанныхПоИД(ИдентификаторСообщенияУчастника,СтрокаПлатежа.Ссылка,ИдЗапросаРС,ДатаОбменаЗапроса,Ложь);
					КонецЕсли;
					
					Продолжить;
				КонецЕсли;
				
				ОбъектСсылка = СтрокаПлатежа.Ссылка;
				
			Иначе
				ОбъектСсылка = Неопределено;
			КонецЕсли;
			
			СтруктураПоискаПолучателя = Новый Структура("ИНН,КПП",СтрТЧ.ИННПолучателя,СтрТЧ.КПППолучателя);
			НайденныеСтроки = ТаблицаПолучателей.НайтиСтроки(СтруктураПоискаПолучателя);
			Если НайденныеСтроки.Количество()>0 Тогда
				ДанныеПолучателя = НайденныеСтроки[0];
			Иначе
				ДанныеПолучателя = ОпределитьПолучателяИОрганизациюПоИННКПП(СтрТЧ.ИННПолучателя,СтрТЧ.КПППолучателя,СначалаОрганизации);
				НовСтрПолучателей = ТаблицаПолучателей.Добавить();
				НовСтрПолучателей.ИНН = СтрТЧ.ИННПолучателя;
				НовСтрПолучателей.КПП = СтрТЧ.КПППолучателя;
				НовСтрПолучателей.Получатель = ДанныеПолучателя.Получатель;
				НовСтрПолучателей.Организация = ДанныеПолучателя.Организация;
			КонецЕсли;
				
			Если ЗначениеЗаполнено(ОбъектСсылка) тогда
				Объект = ОбъектСсылка.ПолучитьОбъект();
				ОчиститьТабличныеЧасти(Объект);
								
			Иначе
												
				Если ВозможныПлатежиПодведомственных = Ложь Тогда
					Объект = Документы.ПлатежВОплатуГосуслуг.СоздатьДокумент();
				Иначе	
					Если ТипЗнч(ДанныеПолучателя.Получатель) = Тип("СправочникСсылка.Контрагенты") Тогда
						Объект = Документы.ПлатежПодведомственному.СоздатьДокумент();
						Объект.Получатель = ДанныеПолучателя.Получатель;
					Иначе
						Объект = Документы.ПлатежВОплатуГосуслуг.СоздатьДокумент();
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			Объект.Организация = ДанныеПолучателя.Организация;
			Объект.Дата        = ТекущаяДатаСеанса();
			
			ЗаполнитьЗначенияСвойств(Объект,СтрТЧ);//простые реквизиты документа должны совпадать с именем реквизитов в формате				
			
			Объект.СодержимоеФайла = СодержимоеФайла;
			
			Для Каждого СтрДанных Из Таблица Цикл
				Если ЗначениеЗаполнено(СтрДанных.СлужебноеПоле_ТабличнаяЧасть)
					И СтрНачинаетсяС(СтрДанных.СлужебноеПоле_ИдентификаторСтроки,СтрТЧ.СлужебноеПоле_ИдентификаторСтроки+"/") Тогда
			        ЗаполнитьЗначенияСвойств(Объект[СтрДанных.СлужебноеПоле_ТабличнаяЧасть].Добавить(),СтрДанных);
				КонецЕсли;
			КонецЦикла;
			
			КолДок = КолДок + 1;
			
			ЗаписатьДокументПлатежа(Объект,СквитированноеНачисление);
			
			Если Объект <> Неопределено
				И ЗначениеЗаполнено(Объект.Ссылка) Тогда
				Если ЗначениеЗаполнено(ЗапросКСМЭВ) Тогда
					ЗарегистрироватьЗагрузкуДанных(ИдентификаторСообщенияУчастника,Объект.Ссылка,ЗапросКСМЭВ,ДатаОбменаЗапроса,Истина);
				ИначеЕсли ЗначениеЗаполнено(ИдЗапросаРС) Тогда
					ЗарегистрироватьЗагрузкуДанныхПоИД(ИдентификаторСообщенияУчастника,Объект.Ссылка,ИдЗапросаРС,ДатаОбменаЗапроса,Истина);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
				
	КонецЦикла;
	
	ДополнительныеДанные.ПолученоПлатежейВсего = ДополнительныеДанные.ПолученоПлатежейВсего + КоличествоВсего;
	ДополнительныеДанные.ПолученоПлатежейНовых = ДополнительныеДанные.ПолученоПлатежейНовых + КолДок;
	
	ТаблицаПлатежей.Очистить();
	
	ЗаписатьОбработкуОтветаНаПолучениеДанных(ЗапросКСМЭВ, ИдЗапросаРС, КолДок, КоличествоВсего, НуженСледующийЗапрос, ТаблицаДляЗапросаНовыхДанных, ИдентификаторСообщенияУчастника);
			
	УстановитьПривилегированныйРежим(Ложь);	
	
КонецПроцедуры

// Запрос платежей для участника с ролью АЗ 
// метод экспортный - для тестирования загрузки платежей из xml
Процедура ОбработатьРезультатЗапросаПлатежей_АЗ(ИдентификаторСообщенияУчастника,ТекУчастник,ТекстФайла,ТаблицаДляЗапросаНовыхДанных,ЭтоОтветОтЭмулятора,ДополнительныеДанные) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ЭтоОтветОтЭмулятора Тогда
		//Только установим статус, что получили от эмулятора ответ.
		//Ответ либо приходит эталонный, либо не приходит вообще.
	    УстановитьСтатусОбработкиСообщения(ИдентификаторСообщенияУчастника,Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ОбработанБезОшибок, "Платежей получено от эмулятора: 1");
		
		УстановитьПривилегированныйРежим(Ложь);
		
		Возврат;	
	КонецЕсли;
	
	ИмяФормата = "ExportPaymentsResponse_АЗ";
	
	НастройкиУчастника = БиблиотекаФункцийОбменаПовтИсп.ПолучитьНастройкиОтправителя(ТекУчастник);
	
	ФорматИмпорта = Справочники.ФорматыОбменаБанкиКС.ПолучитьФорматПоВладельцуНаправлениюНаименованию(НастройкиУчастника.ВидОбмена,Перечисления.НаправлениеОбменаБанкиКС.Импорт,ИмяФормата);
	
	Если НЕ ЗначениеЗаполнено(ФорматИмпорта) Тогда
		
		Текст = Нстр("ru='Отсутствует формат импорта данных из сервиса с кодом ""%1""'");
		Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст,ИмяФормата);
		ОбщегоНазначения.СообщитьПользователю(Текст);
		Возврат;
		
	КонецЕсли;
			
	ОбработкаИмпорта = Обработки.ОбменВФорматахУФК_УФЭБС.Создать();
	Таблица = ОбработкаИмпорта.ЗагрузитьИзФайлаXML3(ТекстФайла,ФорматИмпорта,Документы.ЗаданиеНаИмпортДанныхБанкиКС.ПустаяСсылка());
	
	//Если Таблица.Колонки.Найти("СквитированноеНачисление") = Неопределено Тогда
	//	Таблица.Колонки.Добавить("СквитированноеНачисление");
	//КонецЕсли;
	Если Таблица.Колонки.Найти("УникальныйИдентификаторНачисления") = Неопределено Тогда
		Таблица.Колонки.Добавить("УникальныйИдентификаторНачисления");
	КонецЕсли;
	//Если Таблица.Колонки.Найти("СначалаОрганизации") = Неопределено Тогда
	//	Таблица.Колонки.Добавить("СначалаОрганизации");
	//КонецЕсли;
	Если Таблица.Колонки.Найти("БанковскийИдентификаторПлатежа") = Неопределено Тогда
		Таблица.Колонки.Добавить("БанковскийИдентификаторПлатежа");
	КонецЕсли;
	Если Таблица.Колонки.Найти("ИННПолучателя") = Неопределено Тогда
		Таблица.Колонки.Добавить("ИННПолучателя");
	КонецЕсли;
	Если Таблица.Колонки.Найти("КПППолучателя") = Неопределено Тогда
		Таблица.Колонки.Добавить("КПППолучателя");
	КонецЕсли;
	Если Таблица.Колонки.Найти("hasMore") = Неопределено Тогда
		Таблица.Колонки.Добавить("hasMore",Новый ОписаниеТипов("Булево"));
	КонецЕсли;
	
	Если Таблица.Колонки.Найти("СуммаВозврата") = Неопределено Тогда
		Таблица.Колонки.Добавить("СуммаВозврата");
	КонецЕсли;
	Если Таблица.Колонки.Найти("ИдентификаторВозврата") = Неопределено Тогда
		Таблица.Колонки.Добавить("ИдентификаторВозврата");
	КонецЕсли;
	
	Если Таблица.Колонки.Найти("СлужебноеПоле_ТабличнаяЧасть") = Неопределено Тогда
		Таблица.Колонки.Добавить("СлужебноеПоле_ТабличнаяЧасть");
	КонецЕсли;
	//ВозможныПлатежиПодведомственных = ПолучитьФункциональнуюОпцию("ЭтоБазаГАН") И ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюГИСГМП");
		
	МассивИменПараметров = Новый Массив;
	МассивИменПараметров.Добавить("ЗагружатьНовыеИзмененныеПлатежи");
	ЗагружатьНовыеИзмененныеПлатежи = Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПолучитьПараметрыНастройкиОбмена(МассивИменПараметров,НастройкиУчастника.НастройкаОбмена).Получить("ЗагружатьНовыеИзмененныеПлатежи");
	
	Если ЗагружатьНовыеИзмененныеПлатежи<>Ложь Тогда
		ЗагружатьНовыеИзмененныеПлатежи = Истина;
	КонецЕсли;
	
	НуженСледующийЗапрос = Ложь;
	ТекСтрокаПлатежа = Неопределено;
	МассивЛишнихСтрок = Новый Массив;
	МассивБИП = Новый Массив;
	Для Каждого СтрТЧ Из Таблица Цикл
		НуженСледующийЗапрос = СтрТЧ.hasMore ИЛИ НуженСледующийЗапрос;
		Если ЗначениеЗаполнено(СтрТЧ.БанковскийИдентификаторПлатежа) Тогда
			МассивБИП.Добавить(СтрТЧ.БанковскийИдентификаторПлатежа);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрТЧ.БанковскийИдентификаторПлатежа) Тогда
			ТекСтрокаПлатежа = СтрТЧ;
		ИначеЕсли ЗначениеЗаполнено(СтрТЧ.СлужебноеПоле_ТабличнаяЧасть)
			И ЗначениеЗаполнено(СтрТЧ.СуммаВозврата)
			И ТекСтрокаПлатежа <> Неопределено
			И СтрНачинаетсяС(СтрТЧ.СлужебноеПоле_ИдентификаторСтроки,ТекСтрокаПлатежа.СлужебноеПоле_ИдентификаторСтроки+"/") Тогда
			
			ТекСтрокаПлатежа.СуммаВозврата = ТекСтрокаПлатежа.СуммаВозврата + СтрТЧ.СуммаВозврата;//в итоговую строку платежа заполним сумму возвратов из детальных строк
			МассивЛишнихСтрок.Добавить(СтрТЧ);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ЭлМас Из МассивЛишнихСтрок Цикл
		Таблица.Удалить(ЭлМас);
	КонецЦикла;
	
	ДатаОбменаЗапроса = Неопределено;
	ЗапросКСМЭВ = Неопределено;
	ИдЗапросаРС = Неопределено;
	
	ОпределитьДанныеЗапросаПоИдентификатору(ИдентификаторСообщенияУчастника,ДатаОбменаЗапроса,ЗапросКСМЭВ,ИдЗапросаРС);

	ЗапросСуществующихПлатежей = Новый Запрос;
	ЗапросСуществующихПлатежей.Текст = "ВЫБРАТЬ
	                                   |	ПлатежКонтрагентовГИСГМП.Ссылка КАК Ссылка,
	                                   |	ПлатежКонтрагентовГИСГМП.СодержимоеФайла КАК СодержимоеФайла,
	                                   |	ПлатежКонтрагентовГИСГМП.БанковскийИдентификаторПлатежа КАК БанковскийИдентификаторПлатежа,
	                                   |	ПлатежКонтрагентовГИСГМП.СуммаВозврата КАК СуммаВозврата
	                                   |ИЗ
	                                   |	Документ.ПлатежКонтрагентовГИСГМП КАК ПлатежКонтрагентовГИСГМП
	                                   |ГДЕ
	                                   |	ПлатежКонтрагентовГИСГМП.ПометкаУдаления = ЛОЖЬ
	                                   |	И ПлатежКонтрагентовГИСГМП.БанковскийИдентификаторПлатежа В(&МассивБИП)";

	ЗапросСуществующихПлатежей.УстановитьПараметр("МассивБИП",МассивБИП);
	Результат = ЗапросСуществующихПлатежей.Выполнить();
	ТаблицаПлатежей = Результат.Выгрузить();
	ТаблицаПлатежей.Индексы.Добавить("БанковскийИдентификаторПлатежа");
	
	КолДок = 0;
	КоличествоВсего = 0;
	
	ДокОбъект = Неопределено;
	
	Таблица.Сортировать("СлужебноеПоле_ТабличнаяЧасть Возр");
	
	СтрПоискаНачала = "<";
	СтрПоискаКонца = "PaymentInfo>";
	КолСимволовСКонца = СтрДлина(СтрПоискаКонца);
	
	СквитированноеНачисление = Неопределено;
	Для Каждого СтрТЧ Из Таблица Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрТЧ.СлужебноеПоле_ТабличнаяЧасть)
			И ЗначениеЗаполнено(СтрТЧ.БанковскийИдентификаторПлатежа) Тогда 
						
			ПозицияТекПл = СтрНайти(ТекстФайла,СтрТЧ.БанковскийИдентификаторПлатежа);
			ПозицияНачалаПлатежа = СтрНайти(ТекстФайла,СтрПоискаНачала,НаправлениеПоиска.СКонца,ПозицияТекПл,1);
			
			ПозицияКонцаПлатежа = СтрНайти(ТекстФайла,СтрПоискаКонца,НаправлениеПоиска.СНачала,ПозицияТекПл,1)+КолСимволовСКонца;
			СодержимоеФайла = Сред(ТекстФайла,ПозицияНачалаПлатежа,ПозицияКонцаПлатежа-ПозицияНачалаПлатежа+1);
						
			КоличествоВсего = КоличествоВсего + 1;
						
			ДокОбъект = Неопределено;
			СквитированноеНачисление = Неопределено;
			
			//СквитированноеНачисление = СтрТЧ.СквитированноеНачисление;
			
		    БанковскийИдентификаторПлатежа = СтрТЧ.БанковскийИдентификаторПлатежа;
			СтрокаПлатежа = ТаблицаПлатежей.Найти(БанковскийИдентификаторПлатежа,"БанковскийИдентификаторПлатежа");
			
			Если СтрокаПлатежа <> Неопределено Тогда
								
				Если ЗагружатьНовыеИзмененныеПлатежи = Истина
					И СтрокаПлатежа.СодержимоеФайла = СодержимоеФайла
					И СтрокаПлатежа.СуммаВозврата = СтрТЧ.СуммаВозврата Тогда
					
					Если ЗначениеЗаполнено(ЗапросКСМЭВ) Тогда
						ЗарегистрироватьЗагрузкуДанных(ИдентификаторСообщенияУчастника,СтрокаПлатежа.Ссылка,ЗапросКСМЭВ,ДатаОбменаЗапроса,Ложь);
					ИначеЕсли ЗначениеЗаполнено(ИдЗапросаРС) Тогда
						ЗарегистрироватьЗагрузкуДанныхПоИД(ИдентификаторСообщенияУчастника,СтрокаПлатежа.Ссылка,ИдЗапросаРС,ДатаОбменаЗапроса,Истина);	
					КонецЕсли;
					
					//Платеж был ранее загружен 
					Продолжить;
				КонецЕсли;
				
				ОбъектСсылка = СтрокаПлатежа.Ссылка;
				
			Иначе
				ОбъектСсылка = Неопределено;
			КонецЕсли;
							
			Если ЗначениеЗаполнено(ОбъектСсылка) тогда
				ДокОбъект = ОбъектСсылка.ПолучитьОбъект();
				ОчиститьТабличныеЧасти(ДокОбъект);
								
			Иначе
				
				ДокОбъект = Документы.ПлатежКонтрагентовГИСГМП.СоздатьДокумент();
								
			КонецЕсли;
			
			ДокОбъект.Дата        = ТекущаяДатаСеанса();
			
			ЗаполнитьЗначенияСвойств(ДокОбъект,СтрТЧ);//простые реквизиты документа должны совпадать с именем реквизитов в формате				
			
			ДокОбъект.СодержимоеФайла = СодержимоеФайла;
			
			Для Каждого СтрДанных Из Таблица Цикл
				Если ЗначениеЗаполнено(СтрДанных.СлужебноеПоле_ТабличнаяЧасть)
					И СтрНачинаетсяС(СтрТЧ.СлужебноеПоле_ИдентификаторСтроки,СтрТЧ.СлужебноеПоле_ИдентификаторСтроки+"/") Тогда
			        ЗаполнитьЗначенияСвойств(ДокОбъект[СтрТЧ.СлужебноеПоле_ТабличнаяЧасть].Добавить(),СтрТЧ);
				КонецЕсли;
			КонецЦикла;
			
			
				
			Попытка
				ЗаполнитьДанныеПлательщикаПоИдентификатору(ДокОбъект,ДокОбъект.ИдентификаторПлательщика);
				ПредставлениеПлатежа = Строка(ДокОбъект);
				ДокОбъект.Записать();
				
				КолДок = КолДок + 1;
				
				Если ЗначениеЗаполнено(ЗапросКСМЭВ) Тогда
					ЗарегистрироватьЗагрузкуДанных(ИдентификаторСообщенияУчастника,ДокОбъект.Ссылка,ЗапросКСМЭВ,ДатаОбменаЗапроса,Истина);
				ИначеЕсли ЗначениеЗаполнено(ИдЗапросаРС) Тогда
					ЗарегистрироватьЗагрузкуДанныхПоИд(ИдентификаторСообщенияУчастника,ДокОбъект.Ссылка,ИдЗапросаРС,ДатаОбменаЗапроса,Истина);	
				КонецЕсли;
			Исключение
				
				ТекстОшибки = НСтр("ru='Системе не удалось записать загруженный объект %1 !!! По причине: %2'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ПредставлениеПлатежа,ОписаниеОшибки());
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
				
			КонецПопытки;
			
		КонецЕсли;
				
	КонецЦикла;
	
	ТаблицаПлатежей.Очистить();
	
	ЗаписатьОбработкуОтветаНаПолучениеДанных(ЗапросКСМЭВ, ИдЗапросаРС, КолДок, КоличествоВсего, НуженСледующийЗапрос, ТаблицаДляЗапросаНовыхДанных, ИдентификаторСообщенияУчастника);
			
	УстановитьПривилегированныйРежим(Ложь);	
	
КонецПроцедуры

Процедура ЗаполнитьДанныеПлательщикаПоИдентификатору(ДокОбъект,ИдентификаторПлательщика)
	
	Если НЕ ЗначениеЗаполнено(ДокОбъект.ТипПлательщика)
		И СтрДлина(ИдентификаторПлательщика) = 22 Тогда
		//заполним реквизиты документа плательщика по идентификатору ГИС ГМП 2.1
		
		СоответствиеПлательщиков = Новый Соответствие;
		СоответствиеПлательщиков.Вставить("1",Перечисления.ТипыПлательщиковГИСГМП.ФизЛицо);
		СоответствиеПлательщиков.Вставить("2",Перечисления.ТипыПлательщиковГИСГМП.ЮрЛицоРезидентРФ);
		СоответствиеПлательщиков.Вставить("3",Перечисления.ТипыПлательщиковГИСГМП.ЮрЛицоНерезидентРФ);
		СоответствиеПлательщиков.Вставить("4",Перечисления.ТипыПлательщиковГИСГМП.ИП);
		
		ДокОбъект.ТипПлательщика = СоответствиеПлательщиков[Лев(ИдентификаторПлательщика,1)];
		
		Если ДокОбъект.ТипПлательщика = Перечисления.ТипыПлательщиковГИСГМП.ФизЛицо Тогда
			//это физ. лицо
			
			ВидыДокументов = Новый Соответствие;
			ВидыДокументов.Вставить("01","Паспорт РФ");
			ВидыДокументов.Вставить("02","Свидетельство о рождении");
			ВидыДокументов.Вставить("03","Паспорт (уд.личности) моряка");
			ВидыДокументов.Вставить("04","Уд.личности военнослужащего");
			ВидыДокументов.Вставить("05","Военный билет");
			ВидыДокументов.Вставить("06","Временное уд.личности гражданина РФ");
			ВидыДокументов.Вставить("07","Справка об освобождении из мест лишения свободы");
			ВидыДокументов.Вставить("08","Паспорт иностранного гражданина");
			ВидыДокументов.Вставить("09","Вид на жительство ");
			ВидыДокументов.Вставить("10","РВП");
			ВидыДокументов.Вставить("11","Удостоверение беженца");
			ВидыДокументов.Вставить("12","Миграционная карта");
			ВидыДокументов.Вставить("13","Паспорт гражданина СССР");
			ВидыДокументов.Вставить("14","CНИЛС");
			ВидыДокументов.Вставить("15","Уд.личности гражданина РФ");//Государственный регистрационный номер транспортного средства (ГРН)
			ВидыДокументов.Вставить("21","ИНН физ.лица");
			ВидыДокументов.Вставить("22","Водительское удостоверение");
			ВидыДокументов.Вставить("24","Свидетельство о регистрации т.с. в МВД РФ");
			ВидыДокументов.Вставить("25","Охотничий билет");
			ВидыДокументов.Вставить("26","Разрешение на хранение и ношение охотничьего оружия");
			ВидыДокументов.Вставить("28","Загран.паспорт РФ");
			ВидыДокументов.Вставить("29","Свидетельство о предоставлении временного убежища на тер. РФ");
			ВидыДокументов.Вставить("30","Свидетельство о рассмотрении ходатайства по существу");
			
			КодДокумента = Сред(ИдентификаторПлательщика,2,2);
			ДокОбъект.ВидДокументаПлательщика = ВидыДокументов[КодДокумента];
			
			Для Инд = 4 По 22 Цикл
				ТекСимвол = Сред(ИдентификаторПлательщика,Инд,1);
				Если ТекСимвол <>"0" Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			ДокОбъект.НомерДокументаПлательщика = Сред(ИдентификаторПлательщика,Инд);
			
		ИначеЕсли ДокОбъект.ТипПлательщика = Перечисления.ТипыПлательщиковГИСГМП.ЮрЛицоРезидентРФ Тогда
			//это юр. лицо резидент
			ДокОбъект.ИННПлательщика = Сред(ИдентификаторПлательщика,4,10);
			ДокОбъект.КПППлательщика = Сред(ИдентификаторПлательщика,14,9);
			ДокОбъект.ВидДокументаПлательщика = "ИНН/КПП";
			
		ИначеЕсли ДокОбъект.ТипПлательщика = Перечисления.ТипыПлательщиковГИСГМП.ЮрЛицоНерезидентРФ Тогда
			//это юр. лицо нерезидент
			
			Если Сред(ИдентификаторПлательщика,4,5) = "00000" Тогда
				ДокОбъект.ИННПлательщика = Сред(ИдентификаторПлательщика,9,5);
				ДокОбъект.ВидДокументаПлательщика = "КИО/КПП";
			Иначе			
				ДокОбъект.ИННПлательщика = Сред(ИдентификаторПлательщика,4,10);
				ДокОбъект.ВидДокументаПлательщика = "ИНН/КПП";
			КонецЕсли;
		
			ДокОбъект.КПППлательщика = Сред(ИдентификаторПлательщика,14,9);
			
			
		ИначеЕсли ДокОбъект.ТипПлательщика = Перечисления.ТипыПлательщиковГИСГМП.ИП Тогда
			//это ИП
			ДокОбъект.ВидДокументаПлательщика = "ИНН физ.лица";
			ДокОбъект.ИННПлательщика = Сред(ИдентификаторПлательщика,11,12);
		Иначе
			//такого быть не может по форматам
			
			Возврат;
		КонецЕсли;
		
		
	КонецЕсли;	
КонецПроцедуры

// Запрос начислений для участника с ролью АЗ 
// метод экспортный - для тестирования загрузки из xml
Процедура ОбработатьРезультатЗапросаНачислений_АЗ(ИдентификаторСообщенияУчастника,ТекУчастник,ТекстФайла,ТаблицаДляЗапросаНовыхДанных,ЭтоОтветОтЭмулятора) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ЭтоОтветОтЭмулятора Тогда
		//Только установим статус, что получили от эмулятора ответ.
		//Ответ либо приходит эталонный, либо не приходит вообще.
	    УстановитьСтатусОбработкиСообщения(ИдентификаторСообщенияУчастника,Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ОбработанБезОшибок, "Начислений получено от эмулятора: 1");
		
		УстановитьПривилегированныйРежим(Ложь);
		
		Возврат;	
	КонецЕсли;
	
	ИмяФормата = "ExportChargesResponse_АЗ";
	
	НастройкиУчастника = БиблиотекаФункцийОбменаПовтИсп.ПолучитьНастройкиОтправителя(ТекУчастник);
	
	ФорматИмпорта = Справочники.ФорматыОбменаБанкиКС.ПолучитьФорматПоВладельцуНаправлениюНаименованию(НастройкиУчастника.ВидОбмена,Перечисления.НаправлениеОбменаБанкиКС.Импорт,ИмяФормата);
	
	Если НЕ ЗначениеЗаполнено(ФорматИмпорта) Тогда
		
		Текст = Нстр("ru='Отсутствует формат импорта данных из сервиса с кодом ""%1""'");
		Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст,ИмяФормата);
		ОбщегоНазначения.СообщитьПользователю(Текст);
		Возврат;
		
	КонецЕсли;
			
	ОбработкаИмпорта = Обработки.ОбменВФорматахУФК_УФЭБС.Создать();
	Таблица = ОбработкаИмпорта.ЗагрузитьИзФайлаXML3(ТекстФайла,ФорматИмпорта,Документы.ЗаданиеНаИмпортДанныхБанкиКС.ПустаяСсылка());
	
	//!!! Нужно добавить проверку на сумму остатка платежа и статус квитирования при повторной загрузке начисления.
	//Реквизиты ОсталосьОплатить и СтатусКвитирования
	
	Если Таблица.Колонки.Найти("УникальныйИдентификаторНачисления") = Неопределено Тогда
		Таблица.Колонки.Добавить("УникальныйИдентификаторНачисления");
	КонецЕсли;
	
	Если Таблица.Колонки.Найти("КодУчастникаПолучателя") = Неопределено Тогда
		Таблица.Колонки.Добавить("КодУчастникаПолучателя");
	КонецЕсли;
	//Если Таблица.Колонки.Найти("КПППолучателя") = Неопределено Тогда
	//	Таблица.Колонки.Добавить("КПППолучателя");
	//КонецЕсли;
	Если Таблица.Колонки.Найти("hasMore") = Неопределено Тогда
		Таблица.Колонки.Добавить("hasMore",Новый ОписаниеТипов("Булево"));
	КонецЕсли;
		
	МассивИменПараметров = Новый Массив;
	МассивИменПараметров.Добавить("ЗагружатьНовыеИзмененныеПлатежи");
	ЗагружатьНовыеИзмененныеПлатежи = Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПолучитьПараметрыНастройкиОбмена(МассивИменПараметров,НастройкиУчастника.НастройкаОбмена).Получить("ЗагружатьНовыеИзмененныеПлатежи");
	
	Если ЗагружатьНовыеИзмененныеПлатежи<>Ложь Тогда
		ЗагружатьНовыеИзмененныеПлатежи = Истина;
	КонецЕсли;
	
	НуженСледующийЗапрос = Ложь;
		
	МассивУИН = Новый Массив;
	Для Каждого СтрТЧ Из Таблица Цикл
		НуженСледующийЗапрос = СтрТЧ.hasMore ИЛИ НуженСледующийЗапрос;
		Если ЗначениеЗаполнено(СтрТЧ.УникальныйИдентификаторНачисления) Тогда
			МассивУИН.Добавить(СтрТЧ.УникальныйИдентификаторНачисления);
		КонецЕсли;
	КонецЦикла;
	
	ДатаОбменаЗапроса = Неопределено;
	ЗапросКСМЭВ = Неопределено;
	ИдЗапросаРС = Неопределено;
	
	ОпределитьДанныеЗапросаПоИдентификатору(ИдентификаторСообщенияУчастника,ДатаОбменаЗапроса,ЗапросКСМЭВ,ИдЗапросаРС);
	
	
	ЗапросСуществующихПлатежей = Новый Запрос;
	ЗапросСуществующихПлатежей.Текст = "ВЫБРАТЬ
       |	НачислениеКонтрагентамГИСГМП.Ссылка КАК Ссылка,
       |	НачислениеКонтрагентамГИСГМП.СодержимоеФайла КАК СодержимоеФайла,
       |	НачислениеКонтрагентамГИСГМП.УникальныйИдентификаторНачисления КАК УникальныйИдентификаторНачисления,
	   |	Истина КАК ЭтоНачислениеКонтрагентам
       |ИЗ
       |	Документ.НачислениеКонтрагентамГИСГМП КАК НачислениеКонтрагентамГИСГМП
       |ГДЕ
       |	НачислениеКонтрагентамГИСГМП.ПометкаУдаления = ЛОЖЬ
       |	И НачислениеКонтрагентамГИСГМП.УникальныйИдентификаторНачисления В(&МассивУИН)
       |
       |ОБЪЕДИНИТЬ ВСЕ
       |
       |ВЫБРАТЬ
       |	КвитанцияНаОплатуГосуслуг.Ссылка,
       |	"""",
       |	КвитанцияНаОплатуГосуслуг.УникальныйИдентификаторНачисления,
	   |	Ложь
       |ИЗ
       |	Документ.КвитанцияНаОплатуГосуслуг КАК КвитанцияНаОплатуГосуслуг
       |ГДЕ
       |	КвитанцияНаОплатуГосуслуг.ПометкаУдаления = ЛОЖЬ
       |	И КвитанцияНаОплатуГосуслуг.УникальныйИдентификаторНачисления В(&МассивУИН)";

	ЗапросСуществующихПлатежей.УстановитьПараметр("МассивУИН",МассивУИН);
	Результат = ЗапросСуществующихПлатежей.Выполнить();
	
	ТаблицаНачислений = Результат.Выгрузить();	
	ТаблицаНачислений.Индексы.Добавить("УникальныйИдентификаторНачисления");
	
	КолДок = 0;
	КоличествоВсего = 0;
	
	Таблица.Сортировать("СлужебноеПоле_ТабличнаяЧасть Возр");
	
	СтрПоискаНачала = "<";
	СтрПоискаКонца = "ChargeInfo>";
	КолСимволовСКонца = СтрДлина(СтрПоискаКонца);
	
	КодУчастникаПолучателя = "";
	СквитированноеНачисление = Неопределено;
	Для Каждого СтрТЧ Из Таблица Цикл
		
		Если ЗначениеЗаполнено(СтрТЧ.КодУчастникаПолучателя) Тогда
			КодУчастникаПолучателя = СтрТЧ.КодУчастникаПолучателя;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрТЧ.СлужебноеПоле_ТабличнаяЧасть)
			И ЗначениеЗаполнено(СтрТЧ.УникальныйИдентификаторНачисления) Тогда 
						
			ПозицияТекПл = СтрНайти(ТекстФайла,СтрТЧ.УникальныйИдентификаторНачисления);
			ПозицияНачалаДокумента = СтрНайти(ТекстФайла,СтрПоискаНачала,НаправлениеПоиска.СКонца,ПозицияТекПл,1);
			
			ПозицияКонцаДокумента = СтрНайти(ТекстФайла,СтрПоискаКонца,НаправлениеПоиска.СНачала,ПозицияТекПл,1)+КолСимволовСКонца;
			СодержимоеФайла = Сред(ТекстФайла,ПозицияНачалаДокумента,ПозицияКонцаДокумента-ПозицияНачалаДокумента+1);
								
			ДокОбъект = Неопределено;
			СквитированноеНачисление = Неопределено;
			
			КоличествоВсего = КоличествоВсего + 1;
			//СквитированноеНачисление = СтрТЧ.СквитированноеНачисление;
			
		    УникальныйИдентификаторНачисления = СтрТЧ.УникальныйИдентификаторНачисления;
			СтрокаДокумента = ТаблицаНачислений.Найти(УникальныйИдентификаторНачисления,"УникальныйИдентификаторНачисления");
			
			Если СтрокаДокумента <> Неопределено Тогда
				
				Если СтрокаДокумента.ЭтоНачислениеКонтрагентам = Ложь Тогда 
					
					//это наше начисление - документ Квитанция на оплату
					Если ЗначениеЗаполнено(ЗапросКСМЭВ) Тогда
						ЗарегистрироватьЗагрузкуДанных(ИдентификаторСообщенияУчастника,СтрокаДокумента.Ссылка,ЗапросКСМЭВ,ДатаОбменаЗапроса,Ложь);
					ИначеЕсли ЗначениеЗаполнено(ИдЗапросаРС) Тогда
						ЗарегистрироватьЗагрузкуДанныхПоИд(ИдентификаторСообщенияУчастника,СтрокаДокумента.Ссылка,ИдЗапросаРС,ДатаОбменаЗапроса,Ложь);	
					КонецЕсли;
					// Загружать документ не требуется
					Продолжить;
				Иначе
					Если ЗагружатьНовыеИзмененныеПлатежи = Истина 
						И СтрокаДокумента.СодержимоеФайла = СодержимоеФайла Тогда
						
						Если ЗначениеЗаполнено(ЗапросКСМЭВ) Тогда
							ЗарегистрироватьЗагрузкуДанных(ИдентификаторСообщенияУчастника,СтрокаДокумента.Ссылка,ЗапросКСМЭВ,ДатаОбменаЗапроса,Ложь);
						ИначеЕсли ЗначениеЗаполнено(ИдЗапросаРС) Тогда
							ЗарегистрироватьЗагрузкуДанныхПоИд(ИдентификаторСообщенияУчастника,СтрокаДокумента.Ссылка,ИдЗапросаРС,ДатаОбменаЗапроса,Ложь);	
						КонецЕсли;
						
						//Документ был ранее загружен 
						Продолжить;
					КонецЕсли;
					
					ОбъектСсылка = СтрокаДокумента.Ссылка;
				КонецЕсли;
			Иначе
				ОбъектСсылка = Неопределено;
			КонецЕсли;
			
			КолДок = КолДок + 1;
			
			Если ЗначениеЗаполнено(ОбъектСсылка) тогда
				ДокОбъект = ОбъектСсылка.ПолучитьОбъект();
				ОчиститьТабличныеЧасти(ДокОбъект);
								
			Иначе
				
				ДокОбъект = Документы.НачислениеКонтрагентамГИСГМП.СоздатьДокумент();
								
			КонецЕсли;
			
			ДокОбъект.Дата        = ТекущаяДатаСеанса();
			
			ЗаполнитьЗначенияСвойств(ДокОбъект,СтрТЧ);//простые реквизиты документа должны совпадать с именем реквизитов в формате				
			
			ДокОбъект.СодержимоеФайла = СодержимоеФайла;
			ДокОбъект.КодУчастникаПолучателя = КодУчастникаПолучателя;
			
			Для Каждого СтрДанных Из Таблица Цикл
				Если ЗначениеЗаполнено(СтрДанных.СлужебноеПоле_ТабличнаяЧасть)
					И СтрНачинаетсяС(СтрТЧ.СлужебноеПоле_ИдентификаторСтроки,СтрТЧ.СлужебноеПоле_ИдентификаторСтроки+"/") Тогда
			        ЗаполнитьЗначенияСвойств(ДокОбъект[СтрТЧ.СлужебноеПоле_ТабличнаяЧасть].Добавить(),СтрТЧ);
				КонецЕсли;
			КонецЦикла;
			
			Если ДокОбъект <> Неопределено Тогда				
				
				Попытка
					ЗаполнитьДанныеПлательщикаПоИдентификатору(ДокОбъект,ДокОбъект.ОсновнойИдентификаторПлательщика);
					ПредставлениеДокумента = Строка(ДокОбъект);
					
					Если ЗначениеЗаполнено(ДокОбъект.ИННПлательщика)
						И ЗначениеЗаполнено(ДокОбъект.КПППлательщика) Тогда
						//Если заполнены ИНН и КПП плательщика, проверим, есть ли в базе организация с такими ИНН и КПП.
						//Если такая организация есть, заполним организацией из ИБ.
						ДокОбъект.Организация = БиблиотекаФункцийОбмена.НайтиОрганизациюПоИННКПП(ДокОбъект.ИННПлательщика, ДокОбъект.КПППлательщика);
					КонецЕсли;
					
					ДокОбъект.Записать();
					
					Если ЗначениеЗаполнено(ЗапросКСМЭВ) Тогда
						ЗарегистрироватьЗагрузкуДанных(ИдентификаторСообщенияУчастника,ДокОбъект.Ссылка,ЗапросКСМЭВ,ДатаОбменаЗапроса,Истина);
					ИначеЕсли ЗначениеЗаполнено(ИдЗапросаРС) Тогда
						ЗарегистрироватьЗагрузкуДанныхПоИд(ИдентификаторСообщенияУчастника,ДокОбъект.Ссылка,ИдЗапросаРС,ДатаОбменаЗапроса,Истина);
					КонецЕсли;
					
				Исключение
					
					ТекстОшибки = НСтр("ru='Системе не удалось записать загруженный объект %1 !!! По причине: %2'");
					ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ПредставлениеДокумента,ОписаниеОшибки());
					ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
					
				КонецПопытки;
			КонецЕсли;
			
		КонецЕсли;
				
	КонецЦикла;
	
	ТаблицаНачислений.Очистить();
		
	ЗаписатьОбработкуОтветаНаПолучениеДанных(ЗапросКСМЭВ, ИдЗапросаРС, КолДок, КоличествоВсего, НуженСледующийЗапрос, ТаблицаДляЗапросаНовыхДанных, ИдентификаторСообщенияУчастника);
			
	УстановитьПривилегированныйРежим(Ложь);	
	
КонецПроцедуры

Процедура ОбработатьРезультатЗапросаДоступныхПодписок(ИдентификаторСообщенияУчастника,ТекУчастник,ТекстФайла,ТаблицаДляЗапросаНовыхДанных,ЭтоОтветОтЭмулятора) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ЭтоОтветОтЭмулятора Тогда
		//Только установим статус, что получили от эмулятора ответ.
		//Ответ либо приходит эталонный, либо не приходит вообще.
	    УстановитьСтатусОбработкиСообщения(ИдентификаторСообщенияУчастника,Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ОбработанБезОшибок, "Доступных подписок получено: 1");
		
		УстановитьПривилегированныйРежим(Ложь);
		
		Возврат;	
	КонецЕсли;
	
	ИмяФормата = "SubscriptionServiceResponseSubs";
	
	НастройкиУчастника = БиблиотекаФункцийОбменаПовтИсп.ПолучитьНастройкиОтправителя(ТекУчастник);
	
	ФорматИмпорта = Справочники.ФорматыОбменаБанкиКС.ПолучитьФорматПоВладельцуНаправлениюНаименованию(НастройкиУчастника.ВидОбмена,Перечисления.НаправлениеОбменаБанкиКС.Импорт,ИмяФормата);
	
	Если НЕ ЗначениеЗаполнено(ФорматИмпорта) Тогда
		
		Текст = Нстр("ru='Отсутствует формат импорта данных из сервиса с кодом ""%1""'");
		Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст,ИмяФормата);
		ОбщегоНазначения.СообщитьПользователю(Текст);
		Возврат;
		
	КонецЕсли;
			
	ОбработкаИмпорта = Обработки.ОбменВФорматахУФК_УФЭБС.Создать();
	Таблица = ОбработкаИмпорта.ЗагрузитьИзФайлаXML3(ТекстФайла,ФорматИмпорта,Документы.ЗаданиеНаИмпортДанныхБанкиКС.ПустаяСсылка());
	
	Если Таблица.Колонки.Найти("Код") = Неопределено Тогда
		Таблица.Колонки.Добавить("Код");
	КонецЕсли;
	Если Таблица.Колонки.Найти("ПолноеНаименование") = Неопределено Тогда
		Таблица.Колонки.Добавить("ПолноеНаименование");
	КонецЕсли;
	Если Таблица.Колонки.Найти("ТипПодписки") = Неопределено Тогда
		Таблица.Колонки.Добавить("ТипПодписки");
	КонецЕсли;
	Если Таблица.Колонки.Найти("КодПараметра") = Неопределено Тогда
		Таблица.Колонки.Добавить("КодПараметра");
	КонецЕсли;
	Если Таблица.Колонки.Найти("НаименованиеПараметра") = Неопределено Тогда
		Таблица.Колонки.Добавить("НаименованиеПараметра");
	КонецЕсли;
	Если Таблица.Колонки.Найти("ФорматПараметра") = Неопределено Тогда
		Таблица.Колонки.Добавить("ФорматПараметра");
	КонецЕсли;
	Если Таблица.Колонки.Найти("Обязательный") = Неопределено Тогда
		Таблица.Колонки.Добавить("Обязательный",Новый ОписаниеТипов("Булево"));
	КонецЕсли;
	
	Если Таблица.Колонки.Найти("ОписаниеДопОграничений") = Неопределено Тогда
		Таблица.Колонки.Добавить("ОписаниеДопОграничений");
	КонецЕсли;
	
	Если Таблица.Колонки.Найти("СлужебноеПоле_ТабличнаяЧасть") = Неопределено Тогда
		Таблица.Колонки.Добавить("СлужебноеПоле_ТабличнаяЧасть");
	КонецЕсли;
		
	МассивИменПараметров = Новый Массив;
	МассивИменПараметров.Добавить("ЗагружатьНовыеИзмененныеПлатежи");
	ЗагружатьНовыеИзмененныеПлатежи = Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПолучитьПараметрыНастройкиОбмена(МассивИменПараметров,НастройкиУчастника.НастройкаОбмена).Получить("ЗагружатьНовыеИзмененныеПлатежи");
	
	Если ЗагружатьНовыеИзмененныеПлатежи<>Ложь Тогда
		ЗагружатьНовыеИзмененныеПлатежи = Истина;
	КонецЕсли;
		
	СначалаОрганизации = Истина;
	
	МассивКодовПодписок = Новый Массив;
	МассивЛишнихСтрок = Новый Массив;
	ТекСтрокаПлатежа = Неопределено;
	Для Каждого СтрТЧ Из Таблица Цикл
		Если ЗначениеЗаполнено(СтрТЧ.Код) Тогда
			МассивКодовПодписок.Добавить(СтрТЧ.Код);
		КонецЕсли;
	КонецЦикла;
		
	ДатаОбменаЗапроса = Неопределено;
	ЗапросКСМЭВ = Неопределено;
	ИдЗапросаРС = Неопределено;
	
	ОпределитьДанныеЗапросаПоИдентификатору(ИдентификаторСообщенияУчастника,ДатаОбменаЗапроса,ЗапросКСМЭВ,ИдЗапросаРС);

	ЗапросСуществующихПодписок = Новый Запрос;
	ЗапросСуществующихПодписок.Текст = 
		"ВЫБРАТЬ
		|	ПодпискиГИСГМП.Ссылка КАК Ссылка,
		|	ПодпискиГИСГМП.Код КАК Код,
		|	ПодпискиГИСГМП.Код В (&МассивКодовПодписок) КАК КодЕстьВОтвете,
		|	ПодпискиГИСГМП.СодержимоеФайла КАК СодержимоеФайла
		|ИЗ
		|	Справочник.ПодпискиГИСГМП КАК ПодпискиГИСГМП";

	ЗапросСуществующихПодписок.УстановитьПараметр("МассивКодовПодписок",МассивКодовПодписок);
	Результат = ЗапросСуществующихПодписок.Выполнить();
	ТаблицаПодписок = Результат.Выгрузить();
	ТаблицаПодписок.Индексы.Добавить("Код");
	
	КолДок = 0;
	КоличествоВсего = 0;
	
	Объект = Неопределено;
	
	Таблица.Сортировать("СлужебноеПоле_ТабличнаяЧасть Возр");
	
	СтрПоискаНачала = "<";
	СтрПоискаСледующаяПодписка = "Subscriptions ";
	СтрПоискаКонецФайла = "SubscriptionServiceResponse>";
	
	Для Каждого СтрТЧ Из Таблица Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрТЧ.СлужебноеПоле_ТабличнаяЧасть)
			И ЗначениеЗаполнено(СтрТЧ.Код) Тогда 
						
			ПозицияТекПодписки = СтрНайти(ТекстФайла,СтрТЧ.Код);
			ПозицияНачалаПодписки = СтрНайти(ТекстФайла,СтрПоискаНачала,НаправлениеПоиска.СКонца,ПозицияТекПодписки,1);
			
			ПозицияСледующейПодписки = СтрНайти(ТекстФайла,СтрПоискаСледующаяПодписка,НаправлениеПоиска.СНачала,ПозицияТекПодписки,1);
			Если ПозицияСледующейПодписки =0 Тогда
				ПозицияСледующейПодписки = СтрНайти(ТекстФайла,СтрПоискаКонецФайла,НаправлениеПоиска.СНачала,ПозицияТекПодписки,1);	
			КонецЕсли;
			//нашли позицию следующей подписки/конца узла и находим символ "<" и берем по предыдущий символ

			ПозицияКонцаПодписки = СтрНайти(ТекстФайла,СтрПоискаНачала,НаправлениеПоиска.СКонца,ПозицияСледующейПодписки,1)-1;
			
			СодержимоеФайла = СокрЛП(Сред(ТекстФайла,ПозицияНачалаПодписки,ПозицияКонцаПодписки-ПозицияНачалаПодписки));
						
			КоличествоВсего = КоличествоВсего + 1;
			
			Объект = Неопределено;
			
		    КодПодиски = СтрТЧ.Код;
			СтрокаПодписки = ТаблицаПодписок.Найти(КодПодиски,"Код");
			
			Если СтрокаПодписки <> Неопределено Тогда
								
				Если СтрокаПодписки.СодержимоеФайла = СодержимоеФайла Тогда
					
					//Подписка была ранее загружена 
										
					Продолжить;
				КонецЕсли;
				
				ОбъектСсылка = СтрокаПодписки.Ссылка;
				
			Иначе
				ОбъектСсылка = Неопределено;
			КонецЕсли;
							
			Если ЗначениеЗаполнено(ОбъектСсылка) тогда
				Объект = ОбъектСсылка.ПолучитьОбъект();
				ОчиститьТабличныеЧасти(Объект);
								
			Иначе
												
				Объект = Справочники.ПодпискиГИСГМП.СоздатьЭлемент();
				
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(Объект,СтрТЧ);//простые реквизиты документа должны совпадать с именем реквизитов в формате				
			
			Объект.СодержимоеФайла = СодержимоеФайла;
			
			Для Каждого СтрДанных Из Таблица Цикл
				Если ЗначениеЗаполнено(СтрДанных.СлужебноеПоле_ТабличнаяЧасть)
					И СтрНачинаетсяС(СтрДанных.СлужебноеПоле_ИдентификаторСтроки,СтрТЧ.СлужебноеПоле_ИдентификаторСтроки+"/") Тогда
			        ЗаполнитьЗначенияСвойств(Объект[СтрДанных.СлужебноеПоле_ТабличнаяЧасть].Добавить(),СтрДанных);
				КонецЕсли;
			КонецЦикла;
			
			КолДок = КолДок + 1;
			
			Объект.Наименование = Объект.НаименованиеПолное;
			Объект.Записать();
			
		КонецЕсли;
				
	КонецЦикла;
			
	ТаблицаПодписок.Очистить();
	
	НуженСледующийЗапрос = Ложь;
	ЗаписатьОбработкуОтветаНаПолучениеДанных(ЗапросКСМЭВ, ИдЗапросаРС, КолДок, КоличествоВсего, НуженСледующийЗапрос, ТаблицаДляЗапросаНовыхДанных, ИдентификаторСообщенияУчастника);
			
	УстановитьПривилегированныйРежим(Ложь);	
	
КонецПроцедуры

Процедура ОбработатьРезультатЗапросаПодключенияПодписки(ИдентификаторСообщенияУчастника,ТекУчастник,ТекстФайла,ТаблицаДляЗапросаНовыхДанных,ЭтоОтветОтЭмулятора) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ЭтоОтветОтЭмулятора Тогда
		//Только установим статус, что получили от эмулятора ответ.
		//Ответ либо приходит эталонный, либо не приходит вообще.
	    УстановитьСтатусОбработкиСообщения(ИдентификаторСообщенияУчастника,Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ОбработанБезОшибок, "");
		
		УстановитьПривилегированныйРежим(Ложь);
		
		Возврат;	
	КонецЕсли;
	
	ИмяФормата = "SubscriptionServiceResponseCrSubs";
	
	НастройкиУчастника = БиблиотекаФункцийОбменаПовтИсп.ПолучитьНастройкиОтправителя(ТекУчастник);
	
	ФорматИмпорта = Справочники.ФорматыОбменаБанкиКС.ПолучитьФорматПоВладельцуНаправлениюНаименованию(НастройкиУчастника.ВидОбмена,Перечисления.НаправлениеОбменаБанкиКС.Импорт,ИмяФормата);
	
	Если НЕ ЗначениеЗаполнено(ФорматИмпорта) Тогда
		
		Текст = Нстр("ru='Отсутствует формат импорта данных из сервиса с кодом ""%1""'");
		Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст,ИмяФормата);
		ОбщегоНазначения.СообщитьПользователю(Текст);
		Возврат;
		
	КонецЕсли;
			
	ОбработкаИмпорта = Обработки.ОбменВФорматахУФК_УФЭБС.Создать();
	Таблица = ОбработкаИмпорта.ЗагрузитьИзФайлаXML3(ТекстФайла,ФорматИмпорта,Документы.ЗаданиеНаИмпортДанныхБанкиКС.ПустаяСсылка());
			
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДанныеИсходящихСообщенийСМЭВ3.Организация КАК Организация,
		|	ДанныеИсходящихСообщенийСМЭВ3.ИдентификаторСообщения КАК ИдентификаторСообщения,
		|	ДанныеИсходящихСообщенийСМЭВ3.ИдентификаторДанных КАК ИдентификаторДанных,
		|	ДанныеИсходящихСообщенийСМЭВ3.Данные КАК Данные
		|ИЗ
		|	РегистрСведений.ДанныеИсходящихСообщенийСМЭВ3 КАК ДанныеИсходящихСообщенийСМЭВ3
		|ГДЕ
		|	ДанныеИсходящихСообщенийСМЭВ3.ИдентификаторСообщения = &ИдентификаторСообщения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	СообщенияИмпортаДанныхВСМЭВ3.Организация КАК Организация,
		|	СообщенияИмпортаДанныхВСМЭВ3.ИдентификаторСообщения КАК ИдентификаторСообщения
		|ИЗ
		|	РегистрСведений.СообщенияИмпортаДанныхВСМЭВ3 КАК СообщенияИмпортаДанныхВСМЭВ3
		|ГДЕ
		|	СообщенияИмпортаДанныхВСМЭВ3.ИдентификаторСообщения = &ИдентификаторСообщения";
	
	Запрос.УстановитьПараметр("ИдентификаторСообщения", ИдентификаторСообщенияУчастника);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаДетальныеЗаписи = РезультатыЗапроса[0].Выбрать();
	
	ОбрабатываемыйДокумент = Неопределено;
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ОбрабатываемыйДокумент = ВыборкаДетальныеЗаписи.Данные;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ОбрабатываемыйДокумент) Тогда 
		Возврат;
	КонецЕсли;
	
	ДокОбъект = ОбрабатываемыйДокумент.ПолучитьОбъект();
	Если ДокОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	ДокОбъект.РезультатОбработкиОбщий = "";
	
	ЕстьОшибки = Ложь;
	
	МассивОшибок = Новый Массив;
	
	МассивКолонок = Новый Массив;
	МассивКолонок.Добавить("ДатаДействия");
	МассивКолонок.Добавить("КодПодписки");
	МассивКолонок.Добавить("ИдентификаторПодписки");
	МассивКолонок.Добавить("КлючСтроки");
	МассивКолонок.Добавить("КодОбработки");
	МассивКолонок.Добавить("ОписаниеОбработки");
	МассивКолонок.Добавить("СлужебноеПоле_ТабличнаяЧасть");
	
	Для Каждого ТекКолонка Из МассивКолонок Цикл
		Если Таблица.Колонки.Найти(ТекКолонка) = Неопределено Тогда
			Таблица.Колонки.Добавить(ТекКолонка);
		КонецЕсли;
	КонецЦикла;
		
	Таблица.Сортировать("СлужебноеПоле_ТабличнаяЧасть Возр");
	
	ДатаДействия = Неопределено;
	Если Таблица.Количество() Тогда
		СтрТЧ = Таблица[0];
		Если ЗначениеЗаполнено(СтрТЧ.ДатаДействия) Тогда
			ДатаДействия = БиблиотекаФункцийОбмена.ДатаИзСтрокиРазныхФорматов(СтрТЧ.ДатаДействия);
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрТЧ.ИдентификаторПодписки) Тогда
			ДокОбъект.ИдентификаторПодписки = СтрТЧ.ИдентификаторПодписки;	
		КонецЕсли;
	КонецЕсли;
	
	ТаблицаЗначенийПараметров = ДокОбъект.ЗначенияПараметровПодписки.Выгрузить();
	ТаблицаЗначенийПараметров.Индексы.Добавить("КлючСтроки,КодПараметра");
	
	ЕстьЗаписиБезОшибок = Ложь;
	ЕстьСтрокиВТаблице = Ложь;
	//В ТЧ ГруппыПараметров могут быть строки со статусом параметра = -1 как параметр без изменений,
	//он не передается
	Для Каждого СтрТЧ Из ДокОбъект.ГруппыПараметров Цикл
		Если СтрТЧ.СтатусПараметра>0 Тогда
			ЕстьСтрокиВТаблице = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрТЧ Из Таблица Цикл
		
		Если ЗначениеЗаполнено(СтрТЧ.СлужебноеПоле_ТабличнаяЧасть) Тогда	
			Если ЗначениеЗаполнено(СтрТЧ.КодОбработки) Тогда
				
				Если СтрТЧ.КодОбработки = "0" Тогда
					ЕстьЗаписиБезОшибок = Истина;
				Иначе
					ЕстьОшибки = Истина;
					Если МассивОшибок.Найти(СтрТЧ.КодОбработки) = Неопределено Тогда
						МассивОшибок.Добавить(СтрТЧ.КодОбработки);
					КонецЕсли;	
				КонецЕсли;
				
				Если ЗначениеЗаполнено(СтрТЧ.КлючСтроки)
					И ЕстьСтрокиВТаблице Тогда
					СтрДок = ДокОбъект.ГруппыПараметров.Найти(СтрТЧ.КлючСтроки,"КлючСтроки");
					Если СтрДок <> Неопределено Тогда
									
						СтрДок.РезультатИмпортаКод = СтрТЧ.КодОбработки;
						СтрДок.РезультатИмпортаОписание = СтрТЧ.ОписаниеОбработки;
						
						Если СтрТЧ.КодОбработки = "0" Тогда
							
							Для Каждого СтрПараметра Из ДокОбъект.ПараметрыПодписки Цикл
								Попытка
									ЗаписьПараметраРС = РегистрыСведений.ПараметрыПодписокГИСГМП.СоздатьМенеджерЗаписи();
									ЗаписьПараметраРС.Период = ДатаДействия;
									ЗаписьПараметраРС.Организация = ДокОбъект.Организация;
									ЗаписьПараметраРС.Подписка = ДокОбъект.Подписка;
									ЗаписьПараметраРС.ИдентификаторПодписки = ДокОбъект.ИдентификаторПодписки;
									ЗаписьПараметраРС.ИдентификаторГруппыПараметров = СтрТЧ.КлючСтроки;
									ЗаписьПараметраРС.КодПараметра = СтрПараметра.КодПараметра;
									
									СтрокиЗначения = ТаблицаЗначенийПараметров.НайтиСтроки(Новый Структура("КлючСтроки,КодПараметра",СтрТЧ.КлючСтроки,СтрПараметра.КодПараметра));
									Если СтрокиЗначения.Количество() Тогда
										ЗаписьПараметраРС.ЗначениеПараметра = СтрокиЗначения[0].ЗначениеПараметра;	
									КонецЕсли;
									
									ЗаписьПараметраРС.ПараметрАктивен = СтрДок.СтатусПараметра <> 3;
									ЗаписьПараметраРС.Записать();
								Исключение
									ТекстСообщения = НСтр("ru='Не удалось записать данные о параметре %1 подписки по документу %2 в регистр ""Параметры подписок ГИС ГМП/ИС РНИП/ИС УНП"" по причине:
									|%3'");
									ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,СтрПараметра.КодПараметра,ДокОбъект.Ссылка,ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
									ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
									ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("Обмен с ГИС ГМП/ИС РНИП/ИС УНП.Подписки",УровеньЖурналаРегистрации.Ошибка,Метаданные.РегистрыСведений.ПараметрыПодписокГИСГМП,ДокОбъект.Ссылка,ТекстСообщения);

								КонецПопытки;
		                	КонецЦикла;
						КонецЕсли;
						
					КонецЕсли;	
				Иначе
					
					Если СтрТЧ.КодОбработки <> "0" Тогда
						ДокОбъект.РезультатОбработкиОбщий = "Ошибка, код = "+СтрТЧ.КодОбработки+","+СтрТЧ.ОписаниеОбработки;
					Иначе
						ДокОбъект.РезультатОбработкиОбщий = "Успешно, Код = "+СтрТЧ.КодОбработки+","+СтрТЧ.ОписаниеОбработки;
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	 
	Если ЕстьОшибки Тогда
		УстанавливаемыйСтатус = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ОбработанЕстьОшибки;	 
	Иначе
		УстанавливаемыйСтатус = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ОбработанБезОшибок;
	КонецЕсли;
	
	ДокОбъект.СтатусОбработки = УстанавливаемыйСтатус;
	
	ДокОбъект.Записать();	
	
	Если ЗначениеЗаполнено(ДатаДействия)
		И ЗначениеЗаполнено(ДокОбъект.ИдентификаторПодписки)
		И ЕстьЗаписиБезОшибок Тогда
		Попытка
			ЗаписьРС = РегистрыСведений.ПодключенныеПодпискиГИСГМП.СоздатьМенеджерЗаписи();
			ЗаписьРС.Период = ДатаДействия;
			ЗаписьРС.Организация = ДокОбъект.Организация;
			ЗаписьРС.Подписка = ДокОбъект.Подписка;
			ЗаписьРС.ИдентификаторПодписки = ДокОбъект.ИдентификаторПодписки;
			ЗаписьРС.ПодпискаАктивна = ДокОбъект.СтатусПодписки <> 3;
			ЗаписьРС.Записать();
			
			Если ДокОбъект.СтатусПодписки = 3 Тогда
				//отключить неотключенные параметра
				Запрос = Новый Запрос;
				Запрос.Текст = 
					"ВЫБРАТЬ
					|	ПараметрыПодписокГИСГМПСрезПоследних.Организация КАК Организация,
					|	ПараметрыПодписокГИСГМПСрезПоследних.Подписка КАК Подписка,
					|	ПараметрыПодписокГИСГМПСрезПоследних.ИдентификаторПодписки КАК ИдентификаторПодписки,
					|	ПараметрыПодписокГИСГМПСрезПоследних.ИдентификаторГруппыПараметров КАК ИдентификаторГруппыПараметров,
					|	ПараметрыПодписокГИСГМПСрезПоследних.КодПараметра КАК КодПараметра,
					|	ПараметрыПодписокГИСГМПСрезПоследних.ЗначениеПараметра КАК ЗначениеПараметра
					|ИЗ
					|	РегистрСведений.ПараметрыПодписокГИСГМП.СрезПоследних(
					|			,
					|			Организация = &Организация
					|				И ИдентификаторПодписки = &ИдентификаторПодписки) КАК ПараметрыПодписокГИСГМПСрезПоследних
					|ГДЕ
					|	ПараметрыПодписокГИСГМПСрезПоследних.ПараметрАктивен";
				
				Запрос.УстановитьПараметр("ИдентификаторПодписки", ДокОбъект.ИдентификаторПодписки);
				Запрос.УстановитьПараметр("Организация",  ДокОбъект.Организация);
				
				РезультатЗапроса = Запрос.Выполнить();
				
				ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
								
				Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
					ЗаписьНабора = РегистрыСведений.ПараметрыПодписокГИСГМП.СоздатьМенеджерЗаписи();
					ЗаполнитьЗначенияСвойств(ЗаписьНабора,ВыборкаДетальныеЗаписи);
					ЗаписьНабора.ПараметрАктивен = Ложь;
					ЗаписьНабора.Период = ДатаДействия;
					ЗаписьНабора.Записать(Истина);
				КонецЦикла;
				
	    	КонецЕсли;
		Исключение
			ТекстСообщения = НСтр("ru='Не удалось записать данные о подписке по документу %1 в регистр ""Подключенные подписки ГИС ГМП/ИС РНИП/ИС УНП"" по причине:
			|%2'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,ДокОбъект.Ссылка,ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("Обмен с ГИС ГМП/ИС РНИП/ИС УНП.Подписки",УровеньЖурналаРегистрации.Ошибка,Метаданные.РегистрыСведений.ПодключенныеПодпискиГИСГМП,ДокОбъект.Ссылка,ТекстСообщения);

		КонецПопытки;
	КонецЕсли;
			
	ТекстРезультата = "";
	Если ДокОбъект.СтатусПодписки = 3 Тогда
		ТекстРезультата = "Подписка отключена";
	ИначеЕсли ДокОбъект.СтатусПодписки = 2 Тогда 
	    ТекстРезультата = "Настройки подписки изменены";
	Иначе
		ТекстРезультата = "Подписка подключена";
	КонецЕсли;
	
	ВыборкаСИД = РезультатыЗапроса[1].Выбрать();
	Если ВыборкаСИД.Следующий() Тогда
		ЗаписьСИД = РегистрыСведений.СообщенияИмпортаДанныхВСМЭВ3.СоздатьМенеджерЗаписи();
		ЗаписьСИД.Организация = ВыборкаСИД.Организация;
		ЗаписьСИД.ИдентификаторСообщения = ВыборкаСИД.ИдентификаторСообщения;
		ЗаписьСИД.Прочитать();
		Если ЗаписьСИД.Выбран() Тогда
			ЗаписьСИД.СтатусОтправки = УстанавливаемыйСтатус;
			ЗаписьСИД.ЕстьОшибка = ЕстьОшибки;
			ЗаписьСИД.РезультатОбработки = ?(ЕстьОшибки,"Коды ошибок: "+СтрСоединить(МассивОшибок,", "),ТекстРезультата);
			ЗаписьСИД.Записать();
		КонецЕсли;
	КонецЕсли;	
							
	УстановитьПривилегированныйРежим(Ложь);	
	
КонецПроцедуры

// Загрузка платежа из уведомления по подписке
// метод экспортный - для тестирования загрузки платежей из xml
Процедура ОбработатьПолучениеПлатежаПоПодписке(ТекУчастник,ИдентификаторСообщенияСМЭВ,ТекстФайла,ЭтоОтветОтЭмулятора) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ЭтоОтветОтЭмулятора Тогда
		//Только установим статус, что получили от эмулятора ответ.
		//Ответ либо приходит эталонный, либо не приходит вообще.
	    //УстановитьСтатусОбработкиСообщения(ИдентификаторСообщенияУчастника,Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ОбработанБезОшибок, "Платежей получено от эмулятора: 1");
		
		УстановитьПривилегированныйРежим(Ложь);
		
		Возврат;	
	КонецЕсли;
	
	ИмяФормата = "NoticePayment";
	
	НастройкиУчастника = БиблиотекаФункцийОбменаПовтИсп.ПолучитьНастройкиОтправителя(ТекУчастник);
	
	ФорматИмпорта = Справочники.ФорматыОбменаБанкиКС.ПолучитьФорматПоВладельцуНаправлениюНаименованию(НастройкиУчастника.ВидОбмена,Перечисления.НаправлениеОбменаБанкиКС.Импорт,ИмяФормата);
	
	Если НЕ ЗначениеЗаполнено(ФорматИмпорта) Тогда
		
		Текст = Нстр("ru='Отсутствует формат импорта данных из сервиса с кодом ""%1""'");
		Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст,ИмяФормата);
		ОбщегоНазначения.СообщитьПользователю(Текст);
		Возврат;
		
	КонецЕсли;
			
	ОбработкаИмпорта = Обработки.ОбменВФорматахУФК_УФЭБС.Создать();
	Таблица = ОбработкаИмпорта.ЗагрузитьИзФайлаXML3(ТекстФайла,ФорматИмпорта,Документы.ЗаданиеНаИмпортДанныхБанкиКС.ПустаяСсылка());
	
	Если Таблица.Колонки.Найти("КодУчастникаПолучателя") = Неопределено Тогда
		Таблица.Колонки.Добавить("КодУчастникаПолучателя");
	КонецЕсли;
	Если Таблица.Колонки.Найти("УникальныйИдентификаторНачисления") = Неопределено Тогда
		Таблица.Колонки.Добавить("УникальныйИдентификаторНачисления");
	КонецЕсли;
	Если Таблица.Колонки.Найти("СначалаОрганизации") = Неопределено Тогда
		Таблица.Колонки.Добавить("СначалаОрганизации");
	КонецЕсли;
	Если Таблица.Колонки.Найти("БанковскийИдентификаторПлатежа") = Неопределено Тогда
		Таблица.Колонки.Добавить("БанковскийИдентификаторПлатежа");
	КонецЕсли;
	Если Таблица.Колонки.Найти("ИННПолучателя") = Неопределено Тогда
		Таблица.Колонки.Добавить("ИННПолучателя");
	КонецЕсли;
	Если Таблица.Колонки.Найти("КПППолучателя") = Неопределено Тогда
		Таблица.Колонки.Добавить("КПППолучателя");
	КонецЕсли;
		
	Если Таблица.Колонки.Найти("СлужебноеПоле_ТабличнаяЧасть") = Неопределено Тогда
		Таблица.Колонки.Добавить("СлужебноеПоле_ТабличнаяЧасть");
	КонецЕсли;
	
	Если Таблица.Колонки.Найти("ВидСобытияПоПодписке") = Неопределено Тогда
		Таблица.Колонки.Добавить("ВидСобытияПоПодписке");	
	КонецЕсли;
	
	ВозможныПлатежиПодведомственных = ПолучитьФункциональнуюОпцию("ЭтоБазаГАН") И ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюГИСГМП");
	
	Объект = Неопределено;
	
	МассивИменПараметров = Новый Массив;
	МассивИменПараметров.Добавить("ЗагружатьНовыеИзмененныеПлатежи");
	ЗагружатьНовыеИзмененныеПлатежи = Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПолучитьПараметрыНастройкиОбмена(МассивИменПараметров,НастройкиУчастника.НастройкаОбмена).Получить("ЗагружатьНовыеИзмененныеПлатежи");
	
	Если ЗагружатьНовыеИзмененныеПлатежи<>Ложь Тогда
		ЗагружатьНовыеИзмененныеПлатежи = Истина;
	КонецЕсли;
		
	СначалаОрганизации = Истина;
	
	МассивБИП = Новый Массив;
	Для Каждого СтрТЧ Из Таблица Цикл
		Если ЗначениеЗаполнено(СтрТЧ.БанковскийИдентификаторПлатежа) Тогда
			МассивБИП.Добавить(СтрТЧ.БанковскийИдентификаторПлатежа);
		КонецЕсли;
		Если СтрТЧ.СначалаОрганизации = Ложь
			И ВозможныПлатежиПодведомственных = Истина Тогда
			//смотрим в первую очередь получателей - контрагентов АН только если в базе включена опция
			СначалаОрганизации = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	ДатаОбменаЗапроса = ТекущаяДатаСеанса();
	ЗапросКСМЭВ = Неопределено;
	ИдЗапросаРС = Неопределено;
	
	//ОпределитьДанныеЗапросаПоИдентификатору(ИдентификаторСообщенияУчастника,ДатаОбменаЗапроса,ЗапросКСМЭВ,ИдЗапросаРС);

	ЗапросСуществующихПлатежей = Новый Запрос;
	ЗапросСуществующихПлатежей.Текст =  
		"ВЫБРАТЬ
	    |	Док.Ссылка КАК Ссылка,
	    |	Док.СодержимоеФайла КАК СодержимоеФайла,
	    |	Док.БанковскийИдентификаторПлатежа КАК БанковскийИдентификаторПлатежа,
	    |	Док.СуммаВозврата КАК СуммаВозврата
	    |ИЗ
	    |	Документ.ПлатежВОплатуГосуслуг КАК Док
	    |ГДЕ
	    |	Док.ПометкаУдаления = ЛОЖЬ
	    |	И Док.БанковскийИдентификаторПлатежа В(&МассивБИП)
	    |
	    |ОБЪЕДИНИТЬ ВСЕ
	    |
	    |ВЫБРАТЬ
	    |	ПлатежПодведомственному.Ссылка,
	    |	ПлатежПодведомственному.СодержимоеФайла,
	    |	ПлатежПодведомственному.БанковскийИдентификаторПлатежа,
	    |	ПлатежПодведомственному.СуммаВозврата
	    |ИЗ
	    |	Документ.ПлатежПодведомственному КАК ПлатежПодведомственному
	    |ГДЕ
	    |	ПлатежПодведомственному.ПометкаУдаления = ЛОЖЬ
	    |	И ПлатежПодведомственному.БанковскийИдентификаторПлатежа В(&МассивБИП)";

	ЗапросСуществующихПлатежей.УстановитьПараметр("МассивБИП",МассивБИП);
	Результат = ЗапросСуществующихПлатежей.Выполнить();
	ТаблицаПлатежей = Результат.Выгрузить();
	ТаблицаПлатежей.Индексы.Добавить("БанковскийИдентификаторПлатежа");
	
	КолДок = 0;
	КоличествоВсего = 0;
	
	Объект = Неопределено;
	
	Таблица.Сортировать("СлужебноеПоле_ТабличнаяЧасть Возр");
		
	СквитированноеНачисление = Неопределено;
	Для Каждого СтрТЧ Из Таблица Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрТЧ.СлужебноеПоле_ТабличнаяЧасть)
			И ЗначениеЗаполнено(СтрТЧ.БанковскийИдентификаторПлатежа) Тогда
																		
			КоличествоВсего = КоличествоВсего + 1;
			
			Объект = Неопределено;
			СквитированноеНачисление = Неопределено;
			Если ЗначениеЗаполнено(СтрТЧ.УникальныйИдентификаторНачисления) Тогда
				СквитированноеНачисление = БиблиотекаФункцийОбмена.ПолучитьНачислениеПоУИН(СтрТЧ.УникальныйИдентификаторНачисления);
			КонецЕсли;
						
		    БанковскийИдентификаторПлатежа = СтрТЧ.БанковскийИдентификаторПлатежа;
			СтрокаПлатежа = ТаблицаПлатежей.Найти(БанковскийИдентификаторПлатежа,"БанковскийИдентификаторПлатежа");
			
			Если СтрокаПлатежа <> Неопределено Тогда
				
				Если СтрТЧ.ВидСобытияПоПодписке <> "1" Тогда
					//1 - новый платеж/изменение реквизитов платежа
					//2 - изменение сопоставление с зачислением - такое не надо
					//такой платеж уже есть, а событие для уведомление не нужно
					Продолжить;
				КонецЕсли;
				
				ОбъектСсылка = СтрокаПлатежа.Ссылка;
				
			Иначе
				ОбъектСсылка = Неопределено;
			КонецЕсли;
					
			ДанныеПолучателя = ОпределитьПолучателяИОрганизациюПоИННКПП(СтрТЧ.ИННПолучателя,СтрТЧ.КПППолучателя,СначалаОрганизации);
				
			Если ЗначениеЗаполнено(ОбъектСсылка) тогда
				
				Объект = ОбъектСсылка.ПолучитьОбъект();
				ОчиститьТабличныеЧасти(Объект);
								
			Иначе
				
				Если ВозможныПлатежиПодведомственных = Ложь Тогда
					Объект = Документы.ПлатежВОплатуГосуслуг.СоздатьДокумент();
				Иначе	
					Если ТипЗнч(ДанныеПолучателя.Получатель) = Тип("СправочникСсылка.Контрагенты") Тогда
						Объект = Документы.ПлатежПодведомственному.СоздатьДокумент();
						Объект.Получатель = ДанныеПолучателя.Получатель;
					Иначе
						Объект = Документы.ПлатежВОплатуГосуслуг.СоздатьДокумент();
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			
			Объект.Организация = ДанныеПолучателя.Организация;
			Объект.Дата        = ТекущаяДатаСеанса();
			
			ЗаполнитьЗначенияСвойств(Объект,СтрТЧ);//простые реквизиты документа должны совпадать с именем реквизитов в формате				
						
			Для Каждого СтрДанных Из Таблица Цикл
				Если ЗначениеЗаполнено(СтрДанных.СлужебноеПоле_ТабличнаяЧасть)
					И СтрНачинаетсяС(СтрДанных.СлужебноеПоле_ИдентификаторСтроки,СтрТЧ.СлужебноеПоле_ИдентификаторСтроки+"/") Тогда
			        ЗаполнитьЗначенияСвойств(Объект[СтрДанных.СлужебноеПоле_ТабличнаяЧасть].Добавить(),СтрДанных);
				КонецЕсли;
			КонецЦикла;
			
			КолДок = КолДок + 1;
			
			ЗаписатьДокументПлатежа(Объект,СквитированноеНачисление);
			
			Если Объект <> Неопределено
				И ЗначениеЗаполнено(Объект.Ссылка) Тогда
				
				ЗарегистрироватьЗагрузкуДанных(ИдентификаторСообщенияСМЭВ,Объект.Ссылка,ЗапросКСМЭВ,ДатаОбменаЗапроса,Истина);
				
			КонецЕсли;
		КонецЕсли;
				
	КонецЦикла;
		
	ТаблицаПлатежей.Очистить();
				
	УстановитьПривилегированныйРежим(Ложь);	
	
КонецПроцедуры

Процедура ОбработатьПолучениеНачисленияПоПодписке(ТекУчастник,ИдентификаторСообщенияСМЭВ,ТекстФайла,ЭтоОтветОтЭмулятора) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	Если ЭтоОтветОтЭмулятора Тогда
		//Только установим статус, что получили от эмулятора ответ.
		//Ответ либо приходит эталонный, либо не приходит вообще.
	    //УстановитьСтатусОбработкиСообщения(ИдентификаторСообщенияУчастника,Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ОбработанБезОшибок);
		
		УстановитьПривилегированныйРежим(Ложь);
		
		Возврат;	
	КонецЕсли;
	
	НастройкиУчастника = БиблиотекаФункцийОбменаПовтИсп.ПолучитьНастройкиОтправителя(ТекУчастник);
	
	ИмяФормата = "NoticeCharge";
	ФорматИмпорта = Справочники.ФорматыОбменаБанкиКС.ПолучитьФорматПоВладельцуНаправлениюНаименованию(НастройкиУчастника.ВидОбмена,Перечисления.НаправлениеОбменаБанкиКС.Импорт,ИмяФормата);
	
	Если НЕ ЗначениеЗаполнено(ФорматИмпорта) Тогда
		Текст = Нстр("ru='Отсутствует формат импорта данных из сервиса с кодом ""%1""'");
		Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст,ИмяФормата);			
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);
		Возврат;
	КонецЕсли;	
		
	ОбработкаИмпорта = Обработки.ОбменВФорматахУФК_УФЭБС.Создать();
	Таблица = ОбработкаИмпорта.ЗагрузитьИзФайлаXML3(ТекстФайла,ФорматИмпорта,Документы.ЗаданиеНаИмпортДанныхБанкиКС.ПустаяСсылка());
		
	МассивКолонок = Новый Массив;
	МассивКолонок.Добавить("КодУчастникаПолучателя");
	МассивКолонок.Добавить("СначалаОрганизации");
	МассивКолонок.Добавить("УникальныйИдентификаторНачисления");
	МассивКолонок.Добавить("ДатаНачисления");
	МассивКолонок.Добавить("СрокДействия");
	МассивКолонок.Добавить("СуммаДокумента");
	МассивКолонок.Добавить("НазначениеПлатежа");
	МассивКолонок.Добавить("КодБКПлатежа");
	МассивКолонок.Добавить("КодОКАТО");
	МассивКолонок.Добавить("ОсталосьОплатить");
	МассивКолонок.Добавить("СтатусКвитирования");
	МассивКолонок.Добавить("ИННПолучателя");
	МассивКолонок.Добавить("КПППолучателя");
	МассивКолонок.Добавить("ПолучательНаименование");
	МассивКолонок.Добавить("ПолучательОГРН");
	МассивКолонок.Добавить("ПолучательБанковскийСчет");
	МассивКолонок.Добавить("ПолучательБИКБанка");
	МассивКолонок.Добавить("ПолучательНаименованиеБанка");
	МассивКолонок.Добавить("ПолучательКорСчетБанка");
	МассивКолонок.Добавить("ОсновнойИдентификаторПлательщика");
	МассивКолонок.Добавить("ПлательщикНаименование");
	МассивКолонок.Добавить("ДополнительныйИдентификаторПлательщика");
	МассивКолонок.Добавить("СтатусСоставителя");
	МассивКолонок.Добавить("ПоказательОснования");
	МассивКолонок.Добавить("ПоказательПериода");
	МассивКолонок.Добавить("ТаможенныйПлатеж");
	МассивКолонок.Добавить("ПоказательНомера");
	МассивКолонок.Добавить("ПоказательДаты");
	МассивКолонок.Добавить("ФиксированнаяСуммаСкидки");
	МассивКолонок.Добавить("ДатаОкончанияДействияСкидки");
	МассивКолонок.Добавить("ПроцентСкидки");
	МассивКолонок.Добавить("ПонижающийКоэффициент");
	МассивКолонок.Добавить("ВидКвитанции");
	МассивКолонок.Добавить("ПричинаАннулирования");
	МассивКолонок.Добавить("ДатаИзменения");
	
	МассивКолонок.Добавить("КодУслуги");
	МассивКолонок.Добавить("КатегорияУслуги");
	
	МассивКолонок.Добавить("ВидСобытияПоПодписке");
	
	Для Каждого ТекКолонка Из МассивКолонок Цикл
		Если Таблица.Колонки.Найти(ТекКолонка) = Неопределено Тогда
			Таблица.Колонки.Добавить(ТекКолонка);
		КонецЕсли;
	КонецЦикла;
		
	//ВидСобытияПоПодписке:
	//«1» - Успешный прием в ГИС ГМП извещения о начислении /уточнения извещения о начислении;
	//«2» - Наступление даты повторной отправки уведомления;  
	//«3» - Изменение результатов квитирования (уведомление направляется при изменении остатка суммы к оплате по начислению (@amountToPay) и/или статуса квитирования (@acknowledgmentStatus));
	//«4» - Истечение срока оплаты начисления в соответствии с нормативным правовым (правовым) актом. Информация, необходимая для осуществления исполнительного производства («//ExecutiveProcedureInfo»), отсутствует;
	//«5» - Истечение срока оплаты начисления в соответствии с нормативным правовым (правовым) актом. Будет направлено уведомление в ФССП России для возбуждения исполнительного производства;
	//«6» - Предварительное уведомление о наступлении Срока оплаты (необходимость оплаты начисления в срок до даты, указанной в поле «@paymentTerm», включительно);
	//«7» - Изменение задолженности по ЕНС.
	
	//по 1 - будем грузить начисление всегда, по 3 - устанавливать статус квитирования и задолженность, в остальных - будем грузить только если начисления нет
	
	ВозможныДокументыПодведомственных = ПолучитьФункциональнуюОпцию("ЭтоБазаГАН") И ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюГИСГМП");
	
	СначалаОрганизации = Истина;
		
	ДатаОбменаЗапроса = ТекущаяДатаСеанса();
	ЗапросКСМЭВ = Неопределено;
	ИдЗапросаРС = Неопределено;
	
	НачислениеСсылка = Неопределено;
	
	ДлинаНаНоменклатуру = 10;
	НачПозицияНом = Метаданные.Справочники.Номенклатура.ДлинаКода - ДлинаНаНоменклатуру + 1;
	ТипНачислениеОтПосредника = Тип("ДокументСсылка.НачислениеОтПосредникаГИСГМП");
	
	СтрПоискаНачала = "<";
	СтрПоискаСледующийБлок = "NoticeCharge ";
	СтрПоискаКонецФайла = "ExportNoticeRequest>";
	
	ПозицияПевогоБлока = СтрНайти(ТекстФайла,СтрПоискаСледующийБлок);
	ТекБлок = 1;
	Для Каждого СтрТЧ Из Таблица Цикл
		Если ЗначениеЗаполнено(СтрТЧ.УникальныйИдентификаторНачисления) Тогда
			
			НачислениеСсылка = БиблиотекаФункцийОбмена.ПолучитьНачислениеПоУИН(СтрТЧ.УникальныйИдентификаторНачисления,Истина);
			
			ДокументУжеЕсть = ЗначениеЗаполнено(НачислениеСсылка);
			
			Если ДокументУжеЕсть 
				И ТипЗнч(НачислениеСсылка) = ТипНачислениеОтПосредника Тогда
				
				//если это уведомление с начислением с УИН по которому в базе есть начисление от посредника,
				//значит мог измениться статус начисления, сумма, статус квитирования, задолженность
				
				ДокОбъект = НачислениеСсылка.ПолучитьОбъект();
				ДокОбъект.СуммаДокумента = СтрТЧ.СуммаДокумента;
				ДокОбъект.ВидКвитанции = СтрТЧ.ВидКвитанции;
				
				Если СтрТЧ.ВидКвитанции = "2"
					ИЛИ СтрТЧ.ВидКвитанции = "3"
					ИЛИ СтрТЧ.ВидКвитанции = "4" Тогда
					ДокОбъект.ДатаИзменения = СтрТЧ.ДатаИзменения;
				    ДокОбъект.ПричинаАннулирования = СтрТЧ.ПричинаАннулирования;
				КонецЕсли;	
					
				Если СтрТЧ.ВидКвитанции="3" Тогда
					НовыйСтатус = Перечисления.СтатусыИсполненияДокумента.Аннулирован;
				ИначеЕсли СтрТЧ.ОсталосьОплатить = 0
					И СтрТЧ.СуммаДокумента <> 0 Тогда
					НовыйСтатус = Перечисления.СтатусыИсполненияДокумента.Исполнен;
				Иначе
					НовыйСтатус = Перечисления.СтатусыИсполненияДокумента.НаИсполнении;
				КонецЕсли;
				
				ДокОбъект.ОсталосьОплатить = СтрТЧ.ОсталосьОплатить;
				ДокОбъект.СтатусКвитирования = СтрТЧ.СтатусКвитирования;
				
				ПозицияТекБлока = СтрНайти(ТекстФайла,СтрПоискаСледующийБлок,,,ТекБлок);
				ПозицияНачалаБлока = СтрНайти(ТекстФайла,СтрПоискаНачала,НаправлениеПоиска.СКонца,ПозицияТекБлока,1);
				
				ПозицияСледующегоБлока = СтрНайти(ТекстФайла,СтрПоискаСледующийБлок,НаправлениеПоиска.СНачала,,ТекБлок+1);
				Если ПозицияСледующегоБлока = 0 Тогда
					ПозицияСледующегоБлока = СтрНайти(ТекстФайла,СтрПоискаКонецФайла,НаправлениеПоиска.СНачала,,1);	
				КонецЕсли;
				
				ПозицияКонцаБлока = СтрНайти(ТекстФайла,СтрПоискаНачала,НаправлениеПоиска.СКонца,ПозицияСледующегоБлока,1)-1;
				
				СодержимоеФайла = СокрЛП(Сред(ТекстФайла,ПозицияНачалаБлока,ПозицияКонцаБлока-ПозицияНачалаБлока));
				ДокОбъект.СодержимоеФайла = СодержимоеФайла;
				
				МетаданныеОбъекта = ДокОбъект.Метаданные();
				
				ТекБлок = ТекБлок + 1;
				
				Попытка
					ПредставлениеНачисления = Строка(ДокОбъект);
					ДокОбъект.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения",Истина);
					ДокОбъект.ДополнительныеСвойства.Вставить("НеВыполнятьДействияПередЗаписью",Истина);
					ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
					НачислениеСсылка = ДокОбъект.Ссылка;
					ДокументИзменялся = Истина;
				Исключение
					
					ТекстОшибки = НСтр("ru='Системе не удалось записать загруженный объект %1 !!! По причине: %2'");
					ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ПредставлениеНачисления,ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
					ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
					ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("Обмен с ГИС ГМП/ИС РНИП/ИС УНП.Загрузка начисления из уведомления по подписке",УровеньЖурналаРегистрации.Ошибка,МетаданныеОбъекта,,ТекстОшибки);
					
					НачислениеСсылка = Неопределено;
					ДокОбъект = Неопределено;
					//в ИС РНИП может быть до 100 начислений в уведомлении, в ГИС ГМП - только одно
					Продолжить;
					
				КонецПопытки;
					
			Иначе
						
				Если СтрТЧ.СначалаОрганизации = Ложь
					И ВозможныДокументыПодведомственных = Истина Тогда
					//смотрим в первую очередь получателей - контрагентов АН только если в базе включена опция
					СначалаОрганизации = Ложь;
				КонецЕсли;
				
				ДанныеПолучателя = ОпределитьПолучателяИОрганизациюПоИННКПП(СтрТЧ.ИННПолучателя,СтрТЧ.КПППолучателя,СначалаОрганизации);
				ДокументИзменялся = Ложь;
				Если НачислениеСсылка<>Неопределено
						И СтрТЧ.ВидСобытияПоПодписке = "1" 
					ИЛИ НачислениеСсылка = Неопределено Тогда		
				
					Если ЗначениеЗаполнено(НачислениеСсылка) тогда
						ДокОбъект = НачислениеСсылка.ПолучитьОбъект();								
					Иначе
						
						Если ВозможныДокументыПодведомственных = Ложь Тогда
							ДокОбъект = Документы.КвитанцияНаОплатуГосуслуг.СоздатьДокумент();
						Иначе	
							Если ТипЗнч(ДанныеПолучателя.Получатель) = Тип("СправочникСсылка.Контрагенты") Тогда
								ДокОбъект = Документы.НачислениеОтПодведомственного.СоздатьДокумент();
								ДокОбъект.Получатель = ДанныеПолучателя.Получатель;
							Иначе
								ДокОбъект = Документы.КвитанцияНаОплатуГосуслуг.СоздатьДокумент();
							КонецЕсли;
						КонецЕсли;
						
					КонецЕсли;
					
					ДокОбъект.Организация = ДанныеПолучателя.Организация;
					ДокОбъект.Дата        = СтрТЧ.ДатаНачисления;//устанавливается дата начисления, т.к. она идет в выгрузку
					ПрошлыйИдентификатор = ДокОбъект.ОсновнойИдентификаторПлательщика; 
					ЗаполнитьЗначенияСвойств(ДокОбъект,СтрТЧ);
					Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.КвитанцияНаОплатуГосуслуг") Тогда
						Если ЗначениеЗаполнено(ДокОбъект.Плательщик)
							И ПрошлыйИдентификатор = ДокОбъект.ОсновнойИдентификаторПлательщика Тогда
							//плательщика не заполняем
						Иначе
							ДокОбъект.Плательщик = НайтиКонтрагентаПоИдентификатору20(ДокОбъект.ОсновнойИдентификаторПлательщика);
						КонецЕсли;
						ДокОбъект.ДополнительныеСвойства.Вставить("НеВыполнятьДействияПередЗаписью");
					КонецЕсли;	
					
					Если ЗначениеЗаполнено(СтрТЧ.КодУслуги) Тогда
						ВыборкаДетальныеЗаписи = ПолучитьНоменклатуруПоКоду(СтрТЧ.КодУслуги,10,ДокОбъект.Дата,НачПозицияНом);
						Если ВыборкаДетальныеЗаписи.Следующий() Тогда
							ДокОбъект.Номенклатура = ВыборкаДетальныеЗаписи.Номенклатура;
						КонецЕсли;
					КонецЕсли;
					
					МетаданныеОбъекта = ДокОбъект.Метаданные();
					
					ТекБлок = ТекБлок + 1;
					
					Попытка
						ПредставлениеНачисления = Строка(ДокОбъект);
						ДокОбъект.ДополнительныеСвойства.Вставить("ПропуститьПроверкуЗапретаИзменения",Истина);
						ДокОбъект.ДополнительныеСвойства.Вставить("НеВыполнятьДействияПередЗаписью",Истина);
						ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
						НачислениеСсылка = ДокОбъект.Ссылка;
						ДокументИзменялся = Истина;
					Исключение
						
						ТекстОшибки = НСтр("ru='Системе не удалось записать загруженный объект %1 !!! По причине: %2'");
						ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ПредставлениеНачисления,ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
						ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
						ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("Обмен с ГИС ГМП/ИС РНИП/ИС УНП.Загрузка начисления из уведомления по подписке",УровеньЖурналаРегистрации.Ошибка,МетаданныеОбъекта,,ТекстОшибки);
						
						НачислениеСсылка = Неопределено;
						ДокОбъект = Неопределено;
						//в ИС РНИП может быть до 100 начислений в уведомлении, в ГИС ГМП - только одно
						Продолжить;
						
					КонецПопытки;
				
				КонецЕсли;
				
				Если СтрТЧ.ВидКвитанции="3" Тогда
					НовыйСтатус = Перечисления.СтатусыИсполненияДокумента.Аннулирован;
				ИначеЕсли СтрТЧ.ОсталосьОплатить = 0
					И СтрТЧ.СуммаДокумента <> 0 Тогда
					НовыйСтатус = Перечисления.СтатусыИсполненияДокумента.Исполнен;
				Иначе
					НовыйСтатус = Перечисления.СтатусыИсполненияДокумента.НаИсполнении;
				КонецЕсли;
				
				Если СтрТЧ.ВидСобытияПоПодписке = "3" Тогда
					Если ЗначениеЗаполнено(НачислениеСсылка) Тогда
						//изменилась сумма / статус квитирования
						
						Запись = РегистрыСведений.СтатусыКвитированияНачислений.СоздатьМенеджерЗаписи();
						Запись.Начисление = НачислениеСсылка;
						Запись.ОстатокЗадолженности = СтрТЧ.ОсталосьОплатить;
						Запись.СтатусКвитирования = СтрТЧ.СтатусКвитирования;
						Запись.Записать();
								
					КонецЕсли;
				ИначеЕсли ЗначениеЗаполнено(СтрТЧ.СтатусКвитирования)
					И ЗначениеЗаполнено(НачислениеСсылка)
					И ДокументУжеЕсть = Ложь Тогда
					//создан новый документ
					
					Запись = РегистрыСведений.СтатусыКвитированияНачислений.СоздатьМенеджерЗаписи();
					Запись.Начисление = НачислениеСсылка;
					Запись.ОстатокЗадолженности = СтрТЧ.ОсталосьОплатить;
					Запись.СтатусКвитирования = СтрТЧ.СтатусКвитирования;
					Запись.Записать();
				
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(НачислениеСсылка) Тогда
				СтруктураРекв = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(НачислениеСсылка);
				Если СтруктураРекв.Статус <> Перечисления.СтатусыИсполненияДокумента.Исполнен
						И СтруктураРекв.Статус <> НовыйСтатус
					ИЛИ НовыйСтатус = Перечисления.СтатусыИсполненияДокумента.Аннулирован Тогда
					СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",НачислениеСсылка);
					СтруктураРекв.Вставить("Статус",НовыйСтатус);
					ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
				КонецЕсли;
				
				ЗарегистрироватьЗагрузкуДанных(ИдентификаторСообщенияСМЭВ,НачислениеСсылка,ЗапросКСМЭВ,ДатаОбменаЗапроса,ДокументИзменялся);
			КонецЕсли;
		КонецЕсли;
	
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

Процедура ОбработатьПолучениеКвитанцииНачисленияСПлатежомПоПодписке(ТекУчастник,ИдентификаторСообщенияСМЭВ,ТекстФайла,ЭтоОтветОтЭмулятора) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	Если ЭтоОтветОтЭмулятора Тогда
		//Только установим статус, что получили от эмулятора ответ.
		//Ответ либо приходит эталонный, либо не приходит вообще.
	    //УстановитьСтатусОбработкиСообщения(ИдентификаторСообщенияУчастника,Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ОбработанБезОшибок);
		
		УстановитьПривилегированныйРежим(Ложь);
		
		Возврат;	
	КонецЕсли;
	
	НастройкиУчастника = БиблиотекаФункцийОбменаПовтИсп.ПолучитьНастройкиОтправителя(ТекУчастник);
	
	ИмяФормата = "NoticeQuittance";
	ФорматИмпорта = Справочники.ФорматыОбменаБанкиКС.ПолучитьФорматПоВладельцуНаправлениюНаименованию(НастройкиУчастника.ВидОбмена,Перечисления.НаправлениеОбменаБанкиКС.Импорт,ИмяФормата);
	
	Если НЕ ЗначениеЗаполнено(ФорматИмпорта) Тогда
		Текст = Нстр("ru='Отсутствует формат импорта данных из сервиса с кодом ""%1""'");
		Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст,ИмяФормата);			
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);
		Возврат;
	КонецЕсли;	
		
	ОбработкаИмпорта = Обработки.ОбменВФорматахУФК_УФЭБС.Создать();
	Таблица = ОбработкаИмпорта.ЗагрузитьИзФайлаXML3(ТекстФайла,ФорматИмпорта,Документы.ЗаданиеНаИмпортДанныхБанкиКС.ПустаяСсылка());
	
	МассивКолонок = Новый Массив;
	МассивКолонок.Добавить("СуммаПлатежа");
	МассивКолонок.Добавить("БалансКвитанции");
	МассивКолонок.Добавить("СуммаНачисления");
	МассивКолонок.Добавить("СтатусКвитирования");
	
	ОписаниеТиповЧисло = Новый ОписаниеТипов("Число");
	ДобавитьКолонкиВТаблицу(Таблица,МассивКолонок,ОписаниеТиповЧисло);
	
	МассивКолонок = Новый Массив;
	МассивКолонок.Добавить("КодУчастникаПолучателя");
	МассивКолонок.Добавить("ДатаКвитирования");
	МассивКолонок.Добавить("Внешнее");
	МассивКолонок.Добавить("КвитанцияАннулирована");
	МассивКолонок.Добавить("ИдентификаторПлатежа");
	МассивКолонок.Добавить("УИН");
	
	ДобавитьКолонкиВТаблицу(Таблица,МассивКолонок);
	
	СтрПоискаНачала = "<";
	СтрПоискаСледующийБлок = "NoticeQuittance ";
	СтрПоискаКонецФайла = "ExportNoticeRequest>";
	
	ПозицияПевогоБлока = СтрНайти(ТекстФайла,СтрПоискаСледующийБлок);
	
	ТекБлок = 1;
	Для Каждого СтрТЧ Из Таблица Цикл
		Если ЗначениеЗаполнено(СтрТЧ.УИН) Тогда
			ЗаписьРС = РегистрыСведений.ДанныеОКвитированииГИСГМП.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(ЗаписьРС,СтрТЧ);
			
			ПозицияТекБлока = СтрНайти(ТекстФайла,СтрПоискаСледующийБлок,,,ТекБлок);
			ПозицияНачалаБлока = СтрНайти(ТекстФайла,СтрПоискаНачала,НаправлениеПоиска.СКонца,ПозицияТекБлока,1);
			
			ПозицияСледующегоБлока = СтрНайти(ТекстФайла,СтрПоискаСледующийБлок,НаправлениеПоиска.СНачала,,ТекБлок+1);
			Если ПозицияСледующегоБлока = 0 Тогда
				ПозицияСледующегоБлока = СтрНайти(ТекстФайла,СтрПоискаКонецФайла,НаправлениеПоиска.СНачала,,1);	
			КонецЕсли;
			
			ПозицияКонцаБлока = СтрНайти(ТекстФайла,СтрПоискаНачала,НаправлениеПоиска.СКонца,ПозицияСледующегоБлока,1)-1;
			
			СодержимоеФайла = СокрЛП(Сред(ТекстФайла,ПозицияНачалаБлока,ПозицияКонцаБлока-ПозицияНачалаБлока));
			
			ЗаписьРС.ТекстКвитанции = Новый ХранилищеЗначения(СодержимоеФайла,Новый СжатиеДанных(9));
			ЗаписьРС.Записать(Истина);
			
			ТекБлок = ТекБлок + 1;
		КонецЕсли;
	КонецЦикла;	
	
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

Процедура ДобавитьКолонкиВТаблицу(Таблица, МассивКолонок, ТипКолонок = Неопределено)
	Для Каждого ТекКолонка Из МассивКолонок Цикл
		Если Таблица.Колонки.Найти(ТекКолонка) = Неопределено Тогда
			Таблица.Колонки.Добавить(ТекКолонка,ТипКолонок);
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры

Процедура ОбработатьПолучениеНСИ(ИдентификаторСообщенияУчастника,ТекУчастник,ТекстФайла,ЭтоОтветОтЭмулятора) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ЭтоОтветОтЭмулятора Тогда		
		//Только установим статус, что получили от эмулятора ответ.
		//Ответ либо приходит эталонный, либо не приходит вообще.
	    УстановитьСтатусОбработкиСообщения(ИдентификаторСообщенияУчастника,Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ОбработанБезОшибок);
		
		УстановитьПривилегированныйРежим(Ложь);
		
		Возврат;	
	КонецЕсли;
	
	НастройкиУчастника = БиблиотекаФункцийОбменаПовтИсп.ПолучитьНастройкиОтправителя(ТекУчастник);
	
	ИмяФормата = "ExportNSIResponse";
	ФорматИмпорта = Справочники.ФорматыОбменаБанкиКС.ПолучитьФорматПоВладельцуНаправлениюНаименованию(НастройкиУчастника.ВидОбмена,Перечисления.НаправлениеОбменаБанкиКС.Импорт,ИмяФормата);
	
	Если НЕ ЗначениеЗаполнено(ФорматИмпорта) Тогда
		Текст = Нстр("ru='Отсутствует формат импорта данных из сервиса с кодом ""%1""'");
		Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст,ИмяФормата);			
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);
		Возврат;
	КонецЕсли;	
	ЗапросКСМЭВ = Неопределено;
	ИдЗапросаРС = Неопределено;
	ДатаОбменаЗапроса = Неопределено;
	
	ОпределитьДанныеЗапросаПоИдентификатору(ИдентификаторСообщенияУчастника,ДатаОбменаЗапроса,ЗапросКСМЭВ,ИдЗапросаРС);
	
	ОбработкаИмпорта = Обработки.ОбменВФорматахУФК_УФЭБС.Создать();
	Таблица = ОбработкаИмпорта.ЗагрузитьИзФайлаXML3(ТекстФайла,ФорматИмпорта,Документы.ЗаданиеНаИмпортДанныхБанкиКС.ПустаяСсылка());
		
	МассивКолонок = Новый Массив;
	МассивКолонок.Добавить("НаименованиеПолное");
	МассивКолонок.Добавить("ПолучательНаименование");//с фин.органом и номером счета
	МассивКолонок.Добавить("КорСчетБанка");
	МассивКолонок.Добавить("БИКБанка");
	МассивКолонок.Добавить("КодВидаНачисления");
	МассивКолонок.Добавить("КодВидаНачисленияВнешний");
	МассивКолонок.Добавить("УРНПосредника");
	МассивКолонок.Добавить("УРНУчастника");
	МассивКолонок.Добавить("НомерКазначейскогоСчета");
	МассивКолонок.Добавить("КБК");
	МассивКолонок.Добавить("УровеньБюджета");
	//МассивКолонок.Добавить("ОКТМО");
	МассивКолонок.Добавить("НазначениеПлатежа");
	МассивКолонок.Добавить("ПоказательОснования");
	МассивКолонок.Добавить("ПоказательПериода");
	МассивКолонок.Добавить("ТаможенныйПлатеж");
	МассивКолонок.Добавить("ПоказательНомера");
	МассивКолонок.Добавить("ПоказательДаты");
	
	МассивКолонок.Добавить("ИННПолучателя");
	МассивКолонок.Добавить("КодГлавыПолучателя");
	МассивКолонок.Добавить("КПППолучателя");
	МассивКолонок.Добавить("НаименованиеПолучателя");//сокращенное наименование контрагента-получателя
	МассивКолонок.Добавить("СтатусОрганизации");
	МассивКолонок.Добавить("ДатаОбновленияДанных");
	
	Для Каждого ТекКолонка Из МассивКолонок Цикл
		Если Таблица.Колонки.Найти(ТекКолонка) = Неопределено Тогда
			Таблица.Колонки.Добавить(ТекКолонка);
		КонецЕсли;
	КонецЦикла;
		
	ДлинаНаНоменклатуру = 10;
	НачПозицияНом = Метаданные.Справочники.Номенклатура.ДлинаКода - ДлинаНаНоменклатуру + 1;
		
	ОбщиеРеквизиты = "ИННПолучателя,КПППолучателя,НаименованиеПолучателя,УровеньБюджета,УРНУчастника";
	
	СтруктураОбщихРеквизитов = Новый Структура(ОбщиеРеквизиты);
	
	ДетальныеРеквизиты = "УРНПосредника,КодВидаНачисления,КодВидаНачисленияВнешний,НаименованиеПолное,НомерКазначейскогоСчета,КорСчетБанка,"
		+"НаименованиеБанка,БИКБанка,КБК,ПолучательНаименование,ПоказательОснования,НазначениеПлатежа,ПоказательПериода,ТаможенныйПлатеж,ПоказательДаты,ПоказательНомера";
	Для Каждого СтрТЧ Из Таблица Цикл
		Если ЗначениеЗаполнено(СтрТЧ.УРНУчастника) Тогда		
			ЗаполнитьЗначенияСвойств(СтруктураОбщихРеквизитов,СтрТЧ);	
		ИначеЕсли ЗначениеЗаполнено(СтрТЧ.КодВидаНачисления) Тогда
			
			СтруктураДетальныхРеквизитов = Новый Структура(ДетальныеРеквизиты);
			ЗаполнитьЗначенияСвойств(СтруктураДетальныхРеквизитов,СтрТЧ);
			
			ШаблонСсылка = ПолучитьШаблонРеквизитов(СтруктураОбщихРеквизитов.УРНУчастника,СтруктураДетальныхРеквизитов.КодВидаНачисления);
			
			Если ЗначениеЗаполнено(ШаблонСсылка) Тогда
				
				ТекОбъект = ШаблонСсылка.ПолучитьОбъект();
				Если ТекОбъект.ПометкаУдаления = Истина Тогда
					ТекОбъект.ПометкаУдаления = Ложь;
				КонецЕсли;
				
			Иначе
			
				ТекОбъект = Справочники.ШаблоныРеквизитовДляНачисленияПосредника.СоздатьЭлемент();
				
			КонецЕсли;
			
			ОбновлятьНаименование = Ложь;
			Если ЗначениеЗаполнено(ТекОбъект.Наименование)
				И СокрЛП(Лев(ТекОбъект.НаименованиеПолное,150)) = СокрЛП(ТекОбъект.Наименование) Тогда
				ОбновлятьНаименование = Истина;
				//если наименование было заполнено как полное наименование, а потом полное наименование изменилось,
				//то будем обновлять и обычное наименование
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(ТекОбъект,СтруктураОбщихРеквизитов);
			ЗаполнитьЗначенияСвойств(ТекОбъект,СтруктураДетальныхРеквизитов);
			Если СтрТЧ.ТаможенныйПлатеж = Истина Тогда
				ТекОбъект.ТаможенныйПлатеж = Истина;
			Иначе
				ТекОбъект.ТаможенныйПлатеж = Ложь;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ТекОбъект.Наименование)
				ИЛИ ОбновлятьНаименование Тогда
				ТекОбъект.Наименование = Лев(ТекОбъект.НаименованиеПолное,150);//если вдруг пользователь потом задаст свое, более информативное, то перезаписывать не будем
			КонецЕсли;
			
			КонтрагентДляЗапроса = БиблиотекаФункцийОбмена.ОпределитьКонтрагента(ТекОбъект.ИННПолучателя,ТекОбъект.КПППолучателя);
			Если ЗначениеЗаполнено(КонтрагентДляЗапроса) Тогда
				ТекОбъект.Контрагент = КонтрагентДляЗапроса;
			КонецЕсли;
			
			МетаданныеОбъекта = ТекОбъект.Метаданные();
			Попытка
				ПредставлениеЭлемента = Строка(ТекОбъект);
				
				ТекОбъект.Записать();
				ШаблонСсылка = ТекОбъект.Ссылка;
				ЭлементИзменялся = Истина;
			Исключение
				
				ТекстОшибки = НСтр("ru='Системе не удалось записать загруженный объект %1 !!! По причине: %2'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ПредставлениеЭлемента,ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
				ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("Обмен с ГИС ГМП/ИС РНИП/ИС УНП.Загрузка НСИ контрагента",УровеньЖурналаРегистрации.Ошибка,МетаданныеОбъекта,,ТекстОшибки);
								
				Продолжить;
				
			КонецПопытки;
						
			Если ЗначениеЗаполнено(ШаблонСсылка) Тогда				
				ЗарегистрироватьЗагрузкуДанных(ИдентификаторСообщенияУчастника,ШаблонСсылка,ЗапросКСМЭВ,ДатаОбменаЗапроса,ЭлементИзменялся);
			КонецЕсли;
		КонецЕсли;
	
	КонецЦикла;
	
	УстановитьСтатусОбработкиСообщения(ИдентификаторСообщенияУчастника,Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ОбработанБезОшибок);
	
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

Функция ПолучитьШаблонРеквизитов(УРНУчастника,КодВидаНачисления)
	
	Запрос = Новый Запрос;
	//упорядочить по пометке удаления - чтобы сначала не помеченные
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ШаблоныРеквизитовДляНачисленияПосредника.Ссылка КАК Ссылка,
		|	ШаблоныРеквизитовДляНачисленияПосредника.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Справочник.ШаблоныРеквизитовДляНачисленияПосредника КАК ШаблоныРеквизитовДляНачисленияПосредника
		|ГДЕ
		|	ШаблоныРеквизитовДляНачисленияПосредника.УРНУчастника = &УРНУчастника
		|	И ШаблоныРеквизитовДляНачисленияПосредника.КодВидаНачисления = &КодВидаНачисления
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПометкаУдаления";
	
	Запрос.УстановитьПараметр("КодВидаНачисления", КодВидаНачисления);
	Запрос.УстановитьПараметр("УРНУчастника", УРНУчастника);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура ОбработатьРезультатИмпортаНачисленийОтПосредника(ИдентификаторСообщенияУчастника,ТекУчастник,ТекстФайла,ЭтоОтветОтЭмулятора) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	//Выполняется в привилегированном режиме,
	//т.к. при передаче ГАНом начислений подведомственных,
	//документы могут быть не ГАНа, а подведомственного участника.
	
	Если ЭтоОтветОтЭмулятора Тогда
		//Только установим статус, что получили от эмулятора ответ.
		//Ответ либо приходит эталонный, либо не приходит вообще.
	    УстановитьСтатусОбработкиСообщения(ИдентификаторСообщенияУчастника,Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ОбработанБезОшибок);
		
		УстановитьПривилегированныйРежим(Ложь);
		
		Возврат;	
	КонецЕсли;
	
	НастройкиУчастника = БиблиотекаФункцийОбменаПовтИсп.ПолучитьНастройкиОтправителя(ТекУчастник);
	
	ФорматИмпорта = Справочники.ФорматыОбменаБанкиКС.ПолучитьФорматПоВладельцуНаправлениюНаименованию(НастройкиУчастника.ВидОбмена,Перечисления.НаправлениеОбменаБанкиКС.Импорт,"ChargeCreationResponse");
	
	Если НЕ ЗначениеЗаполнено(ФорматИмпорта) Тогда
		Текст = Нстр("ru='Отсутствует формат импорта данных из сервиса с кодом ""ChargeCreationResponse""'");			
		ОбщегоНазначения.СообщитьПользователю(Текст);
		Возврат;
	КонецЕсли;
		
	ОбработкаИмпорта = Обработки.ОбменВФорматахУФК_УФЭБС.Создать();
	ТаблицаИмпорта = ОбработкаИмпорта.ЗагрузитьИзФайлаXML3(ТекстФайла,ФорматИмпорта,Документы.ЗаданиеНаИмпортДанныхБанкиКС.ПустаяСсылка());

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДанныеИсходящихСообщенийСМЭВ3.Организация КАК Организация,
		|	ДанныеИсходящихСообщенийСМЭВ3.ИдентификаторСообщения КАК ИдентификаторСообщения,
		|	ДанныеИсходящихСообщенийСМЭВ3.ИдентификаторДанных КАК ИдентификаторДанных,
		|	ДанныеИсходящихСообщенийСМЭВ3.Данные КАК Данные
		|ИЗ
		|	РегистрСведений.ДанныеИсходящихСообщенийСМЭВ3 КАК ДанныеИсходящихСообщенийСМЭВ3
		|ГДЕ
		|	ДанныеИсходящихСообщенийСМЭВ3.ИдентификаторСообщения = &ИдентификаторСообщения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	СообщенияИмпортаДанныхВСМЭВ3.Организация КАК Организация,
		|	СообщенияИмпортаДанныхВСМЭВ3.ИдентификаторСообщения КАК ИдентификаторСообщения
		|ИЗ
		|	РегистрСведений.СообщенияИмпортаДанныхВСМЭВ3 КАК СообщенияИмпортаДанныхВСМЭВ3
		|ГДЕ
		|	СообщенияИмпортаДанныхВСМЭВ3.ИдентификаторСообщения = &ИдентификаторСообщения";
	
	Запрос.УстановитьПараметр("ИдентификаторСообщения", ИдентификаторСообщенияУчастника);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаДетальныеЗаписи = РезультатыЗапроса[0].Выбрать();
	
	ОбрабатываемыйДокумент = Неопределено;
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ОбрабатываемыйДокумент = ВыборкаДетальныеЗаписи.Данные;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ОбрабатываемыйДокумент) Тогда 
		Возврат;
	КонецЕсли;
	
	ДокОбъект = ОбрабатываемыйДокумент.ПолучитьОбъект();
	Если ДокОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	ЕстьОшибки = Ложь;
	
	МассивОшибок = Новый Массив;
	
	Если ТаблицаИмпорта.Колонки.Найти("УИН") = Неопределено Тогда
        ТаблицаИмпорта.Колонки.Добавить("УИН");
	КонецЕсли;
	
	Если ТаблицаИмпорта.Колонки.Найти("ВидНачисления") = Неопределено Тогда
        ТаблицаИмпорта.Колонки.Добавить("ВидНачисления");
	КонецЕсли;
	
	Для Каждого СтрТЧ Из ТаблицаИмпорта Цикл
		Если ЗначениеЗаполнено(СтрТЧ.УИН) Тогда
	   		ДокОбъект.УникальныйИдентификаторНачисления = СтрТЧ.УИН;
			ДокОбъект.РезультатИмпортаКод = "0";
			ДокОбъект.РезультатИмпортаОписание = "Успешно";
			
			Если ЗначениеЗаполнено(СтрТЧ.ВидНачисления) Тогда
				ДокОбъект.ВидКвитанции = СтрТЧ.ВидНачисления;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	 
	Если ЕстьОшибки Тогда
		УстанавливаемыйСтатус = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ОбработанЕстьОшибки;	 
	Иначе
		УстанавливаемыйСтатус = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ОбработанБезОшибок;
	КонецЕсли;
	
	ДокОбъект.СтатусОбработки = УстанавливаемыйСтатус;
	
	ДокОбъект.Записать();
	
	СтруктураРекв = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(ДокОбъект.Ссылка);
	Если СтруктураРекв.Статус = Перечисления.СтатусыИсполненияДокумента.ПереданВОбработку Тогда
		//Статус начисления меняется только если текущий статус - Передан в обработку
		СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",ДокОбъект.Ссылка);
		Если ДокОбъект.ВидКвитанции = 3 Тогда
			ТекСтатус = Перечисления.СтатусыИсполненияДокумента.Аннулирован;
		Иначе
			ТекСтатус = Перечисления.СтатусыИсполненияДокумента.НаИсполнении;
		КонецЕсли;
		СтруктураРекв.Вставить("Статус",ТекСтатус);
		ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);							
	КонецЕсли;
	
	ВыборкаСИД = РезультатыЗапроса[1].Выбрать();
	Если ВыборкаСИД.Следующий() Тогда
		ЗаписьСИД = РегистрыСведений.СообщенияИмпортаДанныхВСМЭВ3.СоздатьМенеджерЗаписи();
		ЗаписьСИД.Организация = ВыборкаСИД.Организация;
		ЗаписьСИД.ИдентификаторСообщения = ВыборкаСИД.ИдентификаторСообщения;
		ЗаписьСИД.Прочитать();
		Если ЗаписьСИД.Выбран() Тогда
			ЗаписьСИД.СтатусОтправки = УстанавливаемыйСтатус;
			ЗаписьСИД.ЕстьОшибка = ЕстьОшибки;
			ЗаписьСИД.РезультатОбработки = ?(ЕстьОшибки,"Коды ошибок: "+СтрСоединить(МассивОшибок,", "),"Начисление загружено успешно");
			ЗаписьСИД.Записать();
		КонецЕсли;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры


Процедура ЗаписатьОбработкуОтветаНаПолучениеДанных(ЗапросКСМЭВ, ИдЗапросаРС, КолДок, КоличествоВсего, НуженСледующийЗапрос, ТаблицаДляЗапросаНовыхДанных, ИдентификаторСообщенияУчастника, ДокументыСоздаются = Истина)
	
	Перем Выборка, ДокОбъект, ЗаписьРС, СтатусЗаписи, СтраницаРезультата, СтрТЧ, ТекстРезультата;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СообщенияИмпортаДанныхВСМЭВ3.Организация КАК Организация,
	               |	СообщенияИмпортаДанныхВСМЭВ3.ИдентификаторСообщения КАК ИдентификаторСообщения
	               |ИЗ
	               |	РегистрСведений.СообщенияИмпортаДанныхВСМЭВ3 КАК СообщенияИмпортаДанныхВСМЭВ3
	               |ГДЕ
	               |	СообщенияИмпортаДанныхВСМЭВ3.ИдентификаторСообщения = &ИдентификаторСообщения";
	
	Запрос.УстановитьПараметр("ИдентификаторСообщения", ИдентификаторСообщенияУчастника);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ФорматОбмена = Неопределено;
	
	УстанавливаемыйСтатус = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ОбработанБезОшибок;
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Запись = РегистрыСведений.СообщенияИмпортаДанныхВСМЭВ3.СоздатьМенеджерЗаписи();
		Запись.Организация = ВыборкаДетальныеЗаписи.Организация;
		Запись.ИдентификаторСообщения = ВыборкаДетальныеЗаписи.ИдентификаторСообщения;
		Запись.Прочитать();
		
		ФорматОбмена = Запись.ФорматОбмена;
		
		Запись.СтатусОтправки = УстанавливаемыйСтатус;
		
		Если ДокументыСоздаются = Истина Тогда
			ТекстРезультата = "Создано (изм.): %1 из %2";
			ТекстРезультата = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстРезультата,КолДок,КоличествоВсего);
			Запись.РезультатОбработки = ТекстРезультата;	
		КонецЕсли;
		
		Запись.Записать(Истина);
	КонецЕсли;
	
	//Общее количество загруженных данных определяется по разному для текущего ответа и для запроса в целом.
	//Для текущего ответа общее количество - это количество документов в текущем ответе.
	//Для запроса - это количество документов, которое было загружено этим запросом, т.к. если запрос был отправлен повторно,
	//то ранее могли уже быть загружены данные.
	
	Если ЗначениеЗаполнено(ЗапросКСМЭВ) Тогда
		
		ДокОбъект = ЗапросКСМЭВ.ПолучитьОбъект();
		ДокОбъект.СтатусОбработки = УстанавливаемыйСтатус;
		
		Если ДокументыСоздаются = Истина Тогда
			ДокОбъект.ЗагруженоДанных = ОпределитьКоличествоЗагруженныхДанных(ЗапросКСМЭВ);
			
			ТекстРезультата = "";
			Если ЗначениеЗаполнено(ДокОбъект.ЗагруженоДанных) Тогда
				ТекстРезультата = "Создано (изм.): %1 из %2";
				ТекстРезультата = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстРезультата,КолДок,ДокОбъект.ЗагруженоДанных);
			Иначе
				ТекстРезультата = "Данных нет";
			КонецЕсли;
			
			ДокОбъект.РезультатЗагрузки = ТекстРезультата;
		КонецЕсли;
		ДокОбъект.Записать();
		
		Если НуженСледующийЗапрос Тогда
			СтрТЧ = ТаблицаДляЗапросаНовыхДанных.Добавить();
			СтрТЧ.Объект = ЗапросКСМЭВ;
			СтрТЧ.ФорматОбмена = ФорматОбмена;
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(ИдЗапросаРС) Тогда
		//это запрос по настройкам РС
		
		Выборка = ПолучитьВыборкуВыполняемогоЗапросаПоИдентификатору(ИдЗапросаРС);
		
		//записать результат текущей записи
		Если Выборка.Следующий() Тогда
			
			//если уже ранее обработали этот ответ, но подтвердить не успели, то не повторяем запись
			Если Выборка.СтатусВыполняемогоЗапроса <> УстанавливаемыйСтатус Тогда
				ЗаписьРС = РегистрыСведений.ВыполняемыеЗапросыОчередиКГИСГМП.СоздатьМенеджерЗаписи();
				ЗаполнитьЗначенияСвойств(ЗаписьРС,Выборка);
				
				Если ДокументыСоздаются = Истина Тогда
					ТекстРезультата = "";
					Если ЗначениеЗаполнено(КоличествоВсего) Тогда
						ТекстРезультата = "Создано (изм.): %1 из %2";
						ТекстРезультата = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстРезультата,КолДок,КоличествоВсего);
					Иначе
						ТекстРезультата = "Данных нет";
					КонецЕсли;
					
					ЗаписьРС.РезультатОбработки = ТекстРезультата;
								
				КонецЕсли;
				
				ЗаписьРС.ДокументовВОтвете = КоличествоВсего;
				
				ЗаписьРС.СтатусВыполняемогоЗапроса = УстанавливаемыйСтатус;
				ЗаписьРС.НуженСледующийЗапрос = НуженСледующийЗапрос;
				ЗаписьРС.Записать();
				
				Если НуженСледующийЗапрос Тогда
					//создать новую запись 
					СтраницаРезультата = ЗаписьРС.СтраницаРезультата+1;
					СтатусЗаписи = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ВРаботе;
					СоздатьЗаписьВыполняемыеЗапросыКГИСГМП(ЗаписьРС,СтатусЗаписи,СтраницаРезультата);
				Иначе
					ПроверитьЗавершитьОбработкуДетальнойОчередиЗапросов(ЗаписьРС.Организация,ЗаписьРС.УИДНастройкиОбщегоЗапроса,ЗаписьРС.УИДНастройкиДетальногоЗапроса);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;

КонецПроцедуры


Функция ОпределитьКоличествоЗагруженныхДанных(ЗапросКСМЭВ)
	
	Запрос = Новый Запрос;
	ТипЗапроса = ТипЗнч(ЗапросКСМЭВ);
	Если ТипЗапроса = Тип("ДокументСсылка.ЗапросУНИФО") Тогда
		
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗагруженныеДанныеСМЭВ3.ЗагруженныйОбъект) КАК КоличествоЗагружено
			|ИЗ
			|	РегистрСведений.ЗагруженныеДанныеСМЭВ3 КАК ЗагруженныеДанныеСМЭВ3
			|ГДЕ
			|	ЗагруженныеДанныеСМЭВ3.ЗапросКСМЭВ = &ЗапросКСМЭВ";
		
	ИначеЕсли ТипЗапроса = Тип("УникальныйИдентификатор") Тогда
		
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗагруженныеДанныеПоЗапросамРегистраСМЭВ3.ЗагруженныйОбъект) КАК КоличествоЗагружено
			|ИЗ
			|	РегистрСведений.ЗагруженныеДанныеПоЗапросамРегистраСМЭВ3 КАК ЗагруженныеДанныеПоЗапросамРегистраСМЭВ3
			|ГДЕ
			|	ЗагруженныеДанныеПоЗапросамРегистраСМЭВ3.УИДВыполняемогоЗапросаКГИСГМП = &ЗапросКСМЭВ";
		
	Иначе 
		
		Возврат 0;
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ЗапросКСМЭВ", ЗапросКСМЭВ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.КоличествоЗагружено;
	Иначе
		Возврат 0;
	КонецЕсли;
		
КонецФункции

Процедура ОпределитьДанныеЗапросаПоИдентификатору(ИдентификаторСообщенияУчастника,ДатаОбменаЗапроса,ЗапросКСМЭВ,ИдЗапросаРС)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДанныеИсходящихСообщенийСМЭВ3.Данные КАК ЗапросКСМЭВ,
		|	ДанныеИсходящихСообщенийСМЭВ3.ДатаОбмена КАК ДатаОбменаЗапроса,
		|	ДанныеИсходящихСообщенийСМЭВ3.УИДВыполняемогоЗапросаКГИСГМП КАК УИДВыполняемогоЗапросаКГИСГМП
		|ИЗ
		|	РегистрСведений.ДанныеИсходящихСообщенийСМЭВ3 КАК ДанныеИсходящихСообщенийСМЭВ3
		|ГДЕ
		|	ДанныеИсходящихСообщенийСМЭВ3.ИдентификаторСообщения = &ИдентификаторСообщения";
	
	Запрос.УстановитьПараметр("ИдентификаторСообщения", ИдентификаторСообщенияУчастника);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ДатаОбменаЗапроса = ВыборкаДетальныеЗаписи.ДатаОбменаЗапроса;
		ЗапросКСМЭВ = ВыборкаДетальныеЗаписи.ЗапросКСМЭВ;
		ИдЗапросаРС = ВыборкаДетальныеЗаписи.УИДВыполняемогоЗапросаКГИСГМП;
	КонецЕсли;
		
КонецПроцедуры

Процедура ЗарегистрироватьЗагрузкуДанных(ИдентификаторСообщения,ЗагруженныйОбъект,ЗапросКСМЭВ,ДатаОбменаЗапроса,БылИзменен)
	
	Запись = РегистрыСведений.ЗагруженныеДанныеСМЭВ3.СоздатьМенеджерЗаписи();
	Запись.ЗапросКСМЭВ = ЗапросКСМЭВ;
	Запись.ЗагруженныйОбъект = ЗагруженныйОбъект;
	Запись.ИдентификаторСообщения = ИдентификаторСообщения;
	Запись.ДатаОбмена = ДатаОбменаЗапроса;
	Запись.БылИзменен = БылИзменен; //признак, что документ изменялся - создан новый или изменен существующий при загрузке ответа
	Запись.Записать();
	
КонецПроцедуры

Процедура ЗарегистрироватьЗагрузкуДанныхПоИд(ИдентификаторСообщения,ЗагруженныйОбъект,ИдЗапросаРС,ДатаОбменаЗапроса,БылИзменен)
	
	Запись = РегистрыСведений.ЗагруженныеДанныеПоЗапросамРегистраСМЭВ3.СоздатьМенеджерЗаписи();
	Запись.УИДВыполняемогоЗапросаКГИСГМП = ИдЗапросаРС;
	Запись.ЗагруженныйОбъект = ЗагруженныйОбъект;
	Запись.ИдентификаторСообщения = ИдентификаторСообщения;
	Запись.ДатаОбмена = ДатаОбменаЗапроса;
	Запись.БылИзменен = БылИзменен; //признак, что документ изменялся - создан новый или изменен существующий при загрузке ответа
	Запись.Записать();
	
КонецПроцедуры



Процедура ЗаписатьДокументПлатежа(ПлатежОбъект,Начисление)
	
	Если ПлатежОбъект <> Неопределено Тогда
		Если НЕ ЗначениеЗаполнено(Начисление) Тогда
			ЗаполнитьНоменклатуруИПлательщикаПлатежа20(ПлатежОбъект);//заполним без данных начисления
		КонецЕсли;
		Попытка
			ПредставлениеПлатежа = Строка(ПлатежОбъект);
			ПлатежОбъект.Записать();
			
			Если ЗначениеЗаполнено(Начисление) Тогда
				Запись = РегистрыСведений.СоответствиеНачисленийИПлатежей.СоздатьМенеджерЗаписи();
				Запись.Платеж = ПлатежОбъект.Ссылка;
				Запись.Прочитать();
				Если Запись.Выбран() 
					И Запись.Начисление = Начисление Тогда
					//Ничего не делаем, платеж уже сопоставлен с начислением
				Иначе
					Запись.Платеж = ПлатежОбъект.Ссылка;
					Запись.Начисление = Начисление;
					Запись.БанковскийИдентификаторПлатежаЗаполнен = ЗначениеЗаполнено(ПлатежОбъект.БанковскийИдентификаторПлатежа);
					Запись.Записать();
				КонецЕсли;
				ПроверитьИсполнениеКвитанции(Начисление);			
				
				ЗаполнитьНоменклатуруИПлательщикаПлатежа20(ПлатежОбъект);//заполним с учетом данных сопоставленного начисления, т.к.нужна ссылка на платеж
				ПлатежОбъект.Записать();//и запишем еще раз
			КонецЕсли;			
		Исключение
			
			ТекстОшибки = НСтр("ru='Системе не удалось записать загруженный объект %1 !!! По причине: %2'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ПредставлениеПлатежа,ОписаниеОшибки());
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
			
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОчиститьТабличныеЧасти(ТекОбъект)
	Для каждого ТабличнаяЧасть из ТекОбъект.Метаданные().ТабличныеЧасти цикл
		ТекОбъект[ТабличнаяЧасть.Имя].Очистить();
	КонецЦикла;	
КонецПроцедуры

Функция ОпределитьПолучателяИОрганизациюПоИННКПП(ИНН,КПП,СначалаОрганизации=Истина)

	Запрос = Новый Запрос;
	//добавим приоритет поиска организаций - в первую очередь ищем те, у которых есть настройка участника в регистре
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Организации.Ссылка КАК Получатель,
		|	Организации.Ссылка КАК Организация,
		|	ВЫБОР
		|		КОГДА &СначалаОрганизации
		|			ТОГДА ВЫБОР
		|					КОГДА НастройкаОрганизацийДляГИСГМП_УНП.Организация ЕСТЬ NULL
		|						ТОГДА 2
		|					ИНАЧЕ 1
		|				КОНЕЦ
		|		ИНАЧЕ ВЫБОР
		|				КОГДА НастройкаОрганизацийДляГИСГМП_УНП.Организация ЕСТЬ NULL
		|					ТОГДА 1
		|				ИНАЧЕ 2
		|			КОНЕЦ
		|	КОНЕЦ КАК ПорядокПолучателей
		|ИЗ
		|	Справочник.Организации КАК Организации
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкаОрганизацийДляГИСГМП_УНП КАК НастройкаОрганизацийДляГИСГМП_УНП
		|		ПО (НастройкаОрганизацийДляГИСГМП_УНП.Организация = Организации.Ссылка)
		|ГДЕ
		|	Организации.ПометкаУдаления = ЛОЖЬ
		|	И Организации.ИНН = &ИНН
		|	И Организации.КПП = &КПП
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Контрагенты.Ссылка,
		|	НастройкаОрганизацийДляГИСГМП_УНП.Организация,
		|	3
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкаОрганизацийДляГИСГМП_УНП КАК НастройкаОрганизацийДляГИСГМП_УНП
		|		ПО (НастройкаОрганизацийДляГИСГМП_УНП.Подведомственный = Контрагенты.Ссылка)
		|ГДЕ
		|	Контрагенты.ПометкаУдаления = ЛОЖЬ
		|	И Контрагенты.АдминистраторНачислений
		|	И Контрагенты.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
		|	И Контрагенты.ИНН = &ИНН
		|	И (Контрагенты.КПП = &КПП
		|			ИЛИ Контрагенты.КППИстория.КПП = &КПП)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПорядокПолучателей"  + ?(СначалаОрганизации," Возр"," Убыв");

	Запрос.УстановитьПараметр("ИНН", ИНН);
	Запрос.УстановитьПараметр("КПП", КПП);
	Запрос.УстановитьПараметр("СначалаОрганизации", СначалаОрганизации);

	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();
	
	СтруктураПолучателей = Новый Структура("Получатель,Организация");
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
		ЗаполнитьЗначенияСвойств(СтруктураПолучателей,ВыборкаДетальныеЗаписи);
		
	КонецЕсли;
	
	Возврат СтруктураПолучателей;

КонецФункции

Процедура ЗаполнитьНоменклатуруИПлательщикаПлатежа20(Платеж) Экспорт
	
	//начисление и проверка исполнения начисление выполняется в процедуре ЗаписатьДокументПлатежа
	//Платеж.ДополнительныеСвойства.Вставить("ПроверитьСтатусИсполнения",Истина);
	//Платеж.ДополнительныеСвойства.Вставить("УстановитьВСоответствиеНачисление",Истина);
	
	//Если это платеж подведомственному, то заполняем в другой процедуре
	Если ТипЗнч(Платеж) = Тип("ДокументОбъект.ПлатежПодведомственному") Тогда
		ЗаполнитьНоменклатуруИПлательщикаПлатежаПодведомственного20(Платеж);
		Возврат;
	КонецЕсли;
	Платеж.Плательщик = Неопределено;
	Платеж.Договор = Неопределено;
	Платеж.Учащийся = Неопределено;
	
	Платеж.Плательщик = НайтиКонтрагентаПоИдентификатору20(Платеж.ИдентификаторПлательщика);
	
	Найден = Ложь;          
	Платеж.Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
	ДеревоСтруктуры = Неопределено;
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КвитанцияНаОплатуГосуслуг.Ссылка,
		|	КвитанцияНаОплатуГосуслуг.Плательщик,
		|	КвитанцияНаОплатуГосуслуг.Номенклатура,
		|	КвитанцияНаОплатуГосуслуг.КодБКПлатежа,
		|	КвитанцияНаОплатуГосуслуг.КодОКАТО,
		|	ХарактеристикиГосуслугСрезПоследних.ЗначениеНастройки,
		|	КвитанцияНаОплатуГосуслуг.Договор,
		|	КвитанцияНаОплатуГосуслуг.Учащийся,
		|	2 КАК ПорядокСортировки
		|ИЗ
		|	Документ.КвитанцияНаОплатуГосуслуг КАК КвитанцияНаОплатуГосуслуг
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ХарактеристикиГосуслуг.СрезПоследних(&Дата, ) КАК ХарактеристикиГосуслугСрезПоследних
		|		ПО КвитанцияНаОплатуГосуслуг.Номенклатура = ХарактеристикиГосуслугСрезПоследних.Номенклатура
		|ГДЕ
		|	КвитанцияНаОплатуГосуслуг.УникальныйИдентификаторНачисления = &УникальныйИдентификаторНачисления
		|	И Подстрока(КвитанцияНаОплатуГосуслуг.УникальныйИдентификаторНачисления,2,1)<>"""" ";
	
	Если ЗначениеЗаполнено(Платеж.Ссылка) Тогда
		Запрос.Текст = Запрос.Текст +"
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СоответствиеНачисленийИПлатежей.Начисление,
		|	СоответствиеНачисленийИПлатежей.Начисление.Плательщик,
		|	СоответствиеНачисленийИПлатежей.Начисление.Номенклатура,
		|	СоответствиеНачисленийИПлатежей.Начисление.КодБКПлатежа,
		|	СоответствиеНачисленийИПлатежей.Начисление.КодОКАТО,
		|	ХарактеристикиГосуслугСрезПоследних.ЗначениеНастройки,
		|	СоответствиеНачисленийИПлатежей.Начисление.Договор,
		|	СоответствиеНачисленийИПлатежей.Начисление.Учащийся,
		|	1
		|ИЗ
		|	РегистрСведений.СоответствиеНачисленийИПлатежей КАК СоответствиеНачисленийИПлатежей
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ХарактеристикиГосуслуг.СрезПоследних(&Дата, ) КАК ХарактеристикиГосуслугСрезПоследних
		|		ПО СоответствиеНачисленийИПлатежей.Начисление.Номенклатура = ХарактеристикиГосуслугСрезПоследних.Номенклатура
		|ГДЕ
		|	СоответствиеНачисленийИПлатежей.Платеж = &Платеж 
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПорядокСортировки";
	КонецЕсли;
	
	Запрос.УстановитьПараметр("УникальныйИдентификаторНачисления", Платеж.УникальныйИдентификаторНачисления);
    Запрос.УстановитьПараметр("Дата", Платеж.Дата);
	Запрос.УстановитьПараметр("Платеж", Платеж.Ссылка);
	
	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();

	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Найден = Истина;
		//Если НЕ ЗначениеЗаполнено(Платеж.Плательщик) Тогда
		Платеж.Плательщик = ВыборкаДетальныеЗаписи.Плательщик;
		Платеж.Договор = ВыборкаДетальныеЗаписи.Договор;
		Платеж.Учащийся = ВыборкаДетальныеЗаписи.Учащийся;
		//КонецЕсли;
		Платеж.Номенклатура = ВыборкаДетальныеЗаписи.Номенклатура;
		Если Не ЗначениеЗаполнено(Платеж.КодБКПлатежа) Тогда
			Платеж.КодБКПлатежа = ВыборкаДетальныеЗаписи.КодБКПлатежа;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Платеж.КодОКАТО) Тогда
			Платеж.КодОКАТО = ВыборкаДетальныеЗаписи.КодОКАТО;
		КонецЕсли;

		Если ТипЗнч(ВыборкаДетальныеЗаписи.ЗначениеНастройки) = Тип("ХранилищеЗначения") Тогда
			ПолученноеЗначение = ВыборкаДетальныеЗаписи.ЗначениеНастройки.Получить();
			Если ТипЗнч(ПолученноеЗначение) = Тип("Структура") Тогда
				ДеревоСтруктуры = ПолученноеЗначение.ДополнительныеХарактеристикиНоменклатуры;
				ТаблицаИдн = ПолученноеЗначение.ТаблицаИдентификаторов;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
		
	//Ищем по коду услуги из AdditionalData
	Если Платеж.ДополнительныеДанные.Количество()>0 Тогда
		//Приведем к общему виду имена файлов - все в верхний регистр
		//ТаблицаДопДанных = Платеж.ДополнительныеДанные.Выгрузить();
		Для Каждого СтрДопДанных Из Платеж.ДополнительныеДанные Цикл
			СтрДопДанных.ИмяВФайле = ВРег(СтрДопДанных.ИмяВФайле);
		КонецЦикла;
	
		СтрокаДанных = Платеж.ДополнительныеДанные.Найти("SRV_CODE","ИмяВФайле");
		Если СтрокаДанных<>Неопределено Тогда
			СтрокаДанных.Представление = "Код гос. услуги";
			
			ДлинаНаНоменклатуру = 10;
			НачПозиция = Метаданные.Справочники.Номенклатура.ДлинаКода - ДлинаНаНоменклатуру + 1;
			ВыборкаДетальныеЗаписи = ПолучитьНоменклатуруПоКоду(СтрокаДанных.Значение, ДлинаНаНоменклатуру,Платеж.Дата, НачПозиция);
						
			Если ВыборкаДетальныеЗаписи.Следующий() Тогда
				Платеж.Номенклатура = ВыборкаДетальныеЗаписи.Номенклатура;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
		
	// Если есть доп. данные, для которых не нашли представление, заполним так, как они называются в файле.
	Для Каждого СтрТЧ Из Платеж.ДополнительныеДанные Цикл		
		Если НЕ ЗначениеЗаполнено(СтрТЧ.Представление) Тогда
			СтрТЧ.Представление = СтрТЧ.ИмяВФайле;
		КонецЕсли;
	КонецЦикла;
					
КонецПроцедуры

Процедура ЗаполнитьНоменклатуруИПлательщикаПлатежаПодведомственного20(Платеж) Экспорт
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НачислениеОтПодведомственного.Ссылка,
		|	НачислениеОтПодведомственного.ПлательщикНаименование,
		|	НачислениеОтПодведомственного.КодБКПлатежа,
		|	НачислениеОтПодведомственного.КодОКАТО,
		|	2 КАК ПорядокСортировки,
		|	НачислениеОтПодведомственного.НаименованиеУслуги
		|ИЗ
		|	Документ.НачислениеОтПодведомственного КАК НачислениеОтПодведомственного
		|ГДЕ
		|	НачислениеОтПодведомственного.УникальныйИдентификаторНачисления = &УникальныйИдентификаторНачисления
		|	И ПОДСТРОКА(НачислениеОтПодведомственного.УникальныйИдентификаторНачисления, 2, 1) <> """" ";
	
	Если ЗначениеЗаполнено(Платеж.Ссылка) Тогда
		Запрос.Текст = Запрос.Текст +"
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СоответствиеНачисленийИПлатежей.Начисление,
		|	СоответствиеНачисленийИПлатежей.Начисление.ПлательщикНаименование,
		|	СоответствиеНачисленийИПлатежей.Начисление.КодБКПлатежа,
		|	СоответствиеНачисленийИПлатежей.Начисление.КодОКАТО,
		|	1,
		|	СоответствиеНачисленийИПлатежей.Начисление.НаименованиеУслуги
		|ИЗ
		|	РегистрСведений.СоответствиеНачисленийИПлатежей КАК СоответствиеНачисленийИПлатежей
		|ГДЕ
		|	СоответствиеНачисленийИПлатежей.Платеж = &Платеж
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПорядокСортировки";
	КонецЕсли;
	
	Запрос.УстановитьПараметр("УникальныйИдентификаторНачисления", Платеж.УникальныйИдентификаторНачисления);
	Запрос.УстановитьПараметр("Платеж", Платеж.Ссылка);
	
	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();

	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Платеж.ПлательщикНаименование = ВыборкаДетальныеЗаписи.ПлательщикНаименование;
		Если Не ЗначениеЗаполнено(Платеж.КодБКПлатежа) Тогда
			Платеж.КодБКПлатежа = ВыборкаДетальныеЗаписи.КодБКПлатежа;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Платеж.КодОКАТО) Тогда
			Платеж.КодОКАТО = ВыборкаДетальныеЗаписи.КодОКАТО;
		КонецЕсли;
		Платеж.НаименованиеУслуги = ВыборкаДетальныеЗаписи.НаименованиеУслуги;
	КонецЕсли;
	
	// Если есть доп. данные, для которых не нашли представление, заполним так, как они называются в файле.
	Для Каждого СтрТЧ Из Платеж.ДополнительныеДанные Цикл		
		Если НЕ ЗначениеЗаполнено(СтрТЧ.Представление) Тогда
			СтрТЧ.Представление = СтрТЧ.ИмяВФайле;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция НайтиКонтрагентаПоИдентификатору20(КодИдентификатора,ВидАльтернативногоИдентификатора=Неопределено) Экспорт
		
	Контрагент = Неопределено;
	ДлинаКода = СтрДлина(КодИдентификатора);
	Если ДлинаКода <> 22 Тогда
		Возврат Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;
		
	//значит все нормально, это идентификатор контрагента версии форматов 2.0. 
	
	ВидКонтрагента = Лев(КодИдентификатора,1);// 1 - физ лицо, 2 - юр. лицо резидент, 3 - юр. лицо не резидент, 4 - ИП
	ВидИдентификатора = Сред(КодИдентификатора,2,2);
	
	Если ВидКонтрагента = "4"
		ИЛИ (ВидКонтрагента = "1" 
			И ВидИдентификатора = "21") Тогда
		//ИП или Физ лицо по ИНН
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Контрагенты.Ссылка
			|ИЗ
			|	Справочник.Контрагенты КАК Контрагенты
			|ГДЕ
			|	Контрагенты.ПометкаУдаления = ЛОЖЬ
			|	И Контрагенты.ИНН = &ИНН";
	
        Запрос.УстановитьПараметр("ИНН", Сред(КодИдентификатора,11));//с 11 по 22 символ - 12 символов
		
		Результат = Запрос.Выполнить();

		ВыборкаДетальныеЗаписи = Результат.Выбрать();

		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			Контрагент = ВыборкаДетальныеЗаписи.Ссылка;
		КонецЕсли;
	ИначеЕсли (ВидКонтрагента = "2"
				ИЛИ ВидКонтрагента = "3")
			И Сред(КодИдентификатора,14,9) = "000000000" Тогда
		//юр. лицо без КПП
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Контрагенты.Ссылка
			|ИЗ
			|	Справочник.Контрагенты КАК Контрагенты
			|ГДЕ
			|	Контрагенты.ПометкаУдаления = ЛОЖЬ
			|	И Контрагенты.ИНН = &ИНН";
	
        Запрос.УстановитьПараметр("ИНН", Сред(КодИдентификатора,4,10));
		
		Результат = Запрос.Выполнить();

		ВыборкаДетальныеЗаписи = Результат.Выбрать();

		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			Контрагент = ВыборкаДетальныеЗаписи.Ссылка;
		КонецЕсли;
	ИначеЕсли ВидКонтрагента = "2"
		ИЛИ (ВидКонтрагента = "3" 
			И Сред(КодИдентификатора,4,5) <> "00000") Тогда
		//Это Юр лицо ИНН+КПП
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Контрагенты.Ссылка
			|ИЗ
			|	Справочник.Контрагенты КАК Контрагенты
			|ГДЕ
			|	Контрагенты.КПП = &КПП
			|	И Контрагенты.ПометкаУдаления = ЛОЖЬ
			|	И Контрагенты.ИНН = &ИНН";
	
        Запрос.УстановитьПараметр("ИНН", Сред(КодИдентификатора,4,10));
		Запрос.УстановитьПараметр("КПП", Сред(КодИдентификатора,14,9));
		
		Результат = Запрос.Выполнить();

		ВыборкаДетальныеЗаписи = Результат.Выбрать();

		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			Контрагент = ВыборкаДетальныеЗаписи.Ссылка;
		КонецЕсли;
		
	ИначеЕсли ВидКонтрагента = "3" Тогда
					
		//Это Юр лицо, иностранная организация   "2"+КИО+КПП	        NNNNXXXXXC - шаблон ИНН, XXXXX - это КИО
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЮридическиеЛица КАК ЮридическиеЛица
		|		ПО Контрагенты.ЮридическоеФизическоеЛицо = ЮридическиеЛица.Ссылка
		|ГДЕ
		|	ЮридическиеЛица.КПП = &КПП
		|	И Контрагенты.ПометкаУдаления = ЛОЖЬ
		|	И ЮридическиеЛица.ПометкаУдаления = ЛОЖЬ
		|	И НЕ(ЮридическиеЛица.СтранаРегистрации = ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия)
		|				ИЛИ ЮридическиеЛица.СтранаРегистрации = ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка))
		|	И (ПОДСТРОКА(ЮридическиеЛица.ИНН, 5, 5) = &КИО
		|			ИЛИ ЮридическиеЛица.ИНН = &КИО)";
	
        Запрос.УстановитьПараметр("КИО", Сред(КодИдентификатора,9,5));
		Запрос.УстановитьПараметр("КПП", Сред(КодИдентификатора,14,9));
		
		Результат = Запрос.Выполнить();

		ВыборкаДетальныеЗаписи = Результат.Выбрать();

		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			Контрагент = ВыборкаДетальныеЗаписи.Ссылка;
		КонецЕсли;
		
	ИначеЕсли ВидКонтрагента = "1" Тогда
		//физлицо
		Если ВидИдентификатора = "14" Тогда
			//это снилс
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	ФизическиеЛица.Ссылка КАК ФизическоеЛицо,
				|	ФизическиеЛица.Наименование КАК НаименованиеФЛ,
				|	ЕСТЬNULL(Контрагенты.Ссылка, НЕОПРЕДЕЛЕНО) КАК Контрагент,
				|	ФизическиеЛица.ИНН КАК ИНН
				|ИЗ
				|	Справочник.ФизическиеЛица КАК ФизическиеЛица
				|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
				|		ПО (Контрагенты.ЮридическоеФизическоеЛицо = ФизическиеЛица.Ссылка)
				|ГДЕ
				|	ФизическиеЛица.СтраховойНомерПФР = &СтраховойНомерПФР
				|	И НЕ ФизическиеЛица.ПометкаУдаления";
				
			СНИЛС = "" + Сред(КодИдентификатора,12,3) + "-" + Сред(КодИдентификатора,15,3) + "-" + Сред(КодИдентификатора,18,3) + " " + Сред(КодИдентификатора,21,2);
			Запрос.УстановитьПараметр("СтраховойНомерПФР", СНИЛС);
			Результат = Запрос.Выполнить();

			ВыборкаДетальныеЗаписи = Результат.Выбрать();

			Если ВыборкаДетальныеЗаписи.Следующий() Тогда
				Контрагент = ВыборкаДетальныеЗаписи.Контрагент;
				Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
					НовыйКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();
					НовыйКонтрагент.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо;
					НовыйКонтрагент.ЮридическоеФизическоеЛицо = ВыборкаДетальныеЗаписи.ФизическоеЛицо;
					НовыйКонтрагент.Наименование = ВыборкаДетальныеЗаписи.НаименованиеФЛ;
					НовыйКонтрагент.ИНН = ВыборкаДетальныеЗаписи.ИНН;
					Попытка
						НовыйКонтрагент.Записать();
						Контрагент = НовыйКонтрагент.Ссылка;
					Исключение
						ОбщегоНазначения.СообщитьПользователю(НСтр("ru='"+ОписаниеОшибки()+"'"));
						Контрагент = Справочники.Контрагенты.ПустаяСсылка();
					КонецПопытки;
				КонецЕсли;
			КонецЕсли;
		
		Иначе
			// будем искать по сохраненному коду идентификатора плательщика в регистре
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	АльтернативныеИдентификаторыПолучателейГосуслуг.ФизическоеЛицо КАК ФизическоеЛицо,
			               |	АльтернативныеИдентификаторыПолучателейГосуслуг.АльтернативныйИдентификатор КАК АльтернативныйИдентификатор,
			               |	АльтернативныеИдентификаторыПолучателейГосуслуг.ФизическоеЛицо.Наименование КАК НаименованиеФЛ,
			               |	Контрагенты.Ссылка КАК Контрагент,
			               |	АльтернативныеИдентификаторыПолучателейГосуслуг.ФизическоеЛицо.ИНН КАК ФизическоеЛицоИНН
			               |ИЗ
			               |	РегистрСведений.АльтернативныеИдентификаторыПолучателейГосуслуг КАК АльтернативныеИдентификаторыПолучателейГосуслуг
			               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
			               |		ПО АльтернативныеИдентификаторыПолучателейГосуслуг.ФизическоеЛицо = Контрагенты.ЮридическоеФизическоеЛицо
			               |ГДЕ
			               |	АльтернативныеИдентификаторыПолучателейГосуслуг.АльтернативныйИдентификатор В(&КодыИД)
			               |	И НЕ АльтернативныеИдентификаторыПолучателейГосуслуг.ФизическоеЛицо.ПометкаУдаления
			               |	И ВЫБОР
			               |			КОГДА &ИспользоватьВидАльтИдн
			               |				ТОГДА АльтернативныеИдентификаторыПолучателейГосуслуг.ВидАльтернативногоИдентификатора = &ВидАльтИдн
			               |			ИНАЧЕ ИСТИНА
			               |		КОНЕЦ";
			
			КодыИД = Новый Массив;
			КодыИД.Добавить(КодИдентификатора);
			КодыИД.Добавить(Сред(КодИдентификатора,2,2)+"0"+Сред(КодИдентификатора,4)+"643");//старый формат идентификатора плательщика
			
			Запрос.УстановитьПараметр("КодыИД", КодыИД);
			Запрос.УстановитьПараметр("ВидАльтИдн",ВидАльтернативногоИдентификатора);
			Запрос.УстановитьПараметр("ИспользоватьВидАльтИдн",ЗначениеЗаполнено(ВидАльтернативногоИдентификатора));
			
			Результат = Запрос.Выполнить();
		
			ТЗАльтернативный = Результат.Выгрузить();
			Если ТЗАльтернативный.Количество()>0 Тогда
				НайденноеФизЛицо = ТЗАльтернативный[0].ФизическоеЛицо;
				Контрагент = ТЗАльтернативный[0].Контрагент;
				Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
					НовыйКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();
					НовыйКонтрагент.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо;
					НовыйКонтрагент.ЮридическоеФизическоеЛицо = НайденноеФизЛицо;
					НовыйКонтрагент.Наименование = ТЗАльтернативный[0].НаименованиеФЛ;
					НовыйКонтрагент.ИНН = ТЗАльтернативный[0].ФизическоеЛицоИНН;
					Попытка
						НовыйКонтрагент.Записать();
						Контрагент = НовыйКонтрагент.Ссылка;
					Исключение
						ОбщегоНазначения.СообщитьПользователю(НСтр("ru='"+ОписаниеОшибки()+"'"));
						Контрагент = Справочники.Контрагенты.ПустаяСсылка();
					КонецПопытки;
				КонецЕсли;

			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
				Запрос = Новый Запрос;
				Запрос.Текст = 
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ВидыДокументовФизическихЛиц.Ссылка КАК Ссылка
					|ПОМЕСТИТЬ ВидыДок
					|ИЗ
					|	Справочник.ВидыДокументовФизическихЛиц КАК ВидыДокументовФизическихЛиц
					|ГДЕ
					|	ВидыДокументовФизическихЛиц.КодФК = &КодФК
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ДокументыФизическихЛиц.Физлицо КАК Физлицо,
					|	ДокументыФизическихЛиц.Серия КАК Серия,
					|	ДокументыФизическихЛиц.Номер КАК Номер,
					|	Контрагенты.Ссылка КАК Контрагент
					|ИЗ
					|	ВидыДок КАК ВидыДок
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыФизическихЛиц КАК ДокументыФизическихЛиц
					|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
					|			ПО ДокументыФизическихЛиц.Физлицо = Контрагенты.ЮридическоеФизическоеЛицо
					|		ПО ВидыДок.Ссылка = ДокументыФизическихЛиц.ВидДокумента";
				
				Запрос.УстановитьПараметр("КодФК", ВидИдентификатора);
				
				РезультатЗапроса = Запрос.Выполнить();
				
				ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
				
				СерияНомерИзИдентификатора = Сред(КодИдентификатора,4,19); //с 4 по 22 символ - 19 символов
				СтрокаБуквЦифр = "0123456789АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯABCDEFGHIJKLMNOPQRSTUVWXYZ";
				СтрокаНулей = "00000000000000000000"; 
				Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
					ТекСерияНомер = ВРег(СокрЛП(ВыборкаДетальныеЗаписи.Серия)) + ВРег(СокрЛП(ВыборкаДетальныеЗаписи.Номер));
					ЛишниеСимволы = СтрСоединить(СтрРазделить(ТекСерияНомер,СтрокаБуквЦифр));
					ТекСерияНомер = СтрСоединить(СтрРазделить(ТекСерияНомер,ЛишниеСимволы,Ложь));
					Если НЕ ЗначениеЗаполнено(ТекСерияНомер) Тогда
						Продолжить;
					КонецЕсли;
					ТекСерияНомер = Прав(СтрокаНулей + ТекСерияНомер,19);
					Если ТекСерияНомер = СерияНомерИзИдентификатора Тогда
						Контрагент = ВыборкаДетальныеЗаписи.Контрагент;
						Прервать;
					КонецЕсли;
				КонецЦикла;	
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
	Если Контрагент = Неопределено Тогда // не нашли
		Контрагент = Справочники.Контрагенты.ПустаяСсылка(); 
	КонецЕсли;
	
	Возврат Контрагент;
	
КонецФункции

// Статус квитирования

Процедура ОбработатьРезультатПолученияСтатусаКвитирования(ИдентификаторСообщенияУчастника,ТекУчастник,ТекстФайла,ТаблицаДляЗапросаНовыхДанных,ЭтоОтветОтЭмулятора)
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ЭтоОтветОтЭмулятора Тогда
		//Только установим статус, что получили от эмулятора ответ.
		//Ответ либо приходит эталонный, либо не приходит вообще.
	    УстановитьСтатусОбработкиСообщения(ИдентификаторСообщенияУчастника,Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ОбработанБезОшибок);
		
		УстановитьПривилегированныйРежим(Ложь);
		
		Возврат;	
	КонецЕсли;
	
	НастройкиУчастника = БиблиотекаФункцийОбменаПовтИсп.ПолучитьНастройкиОтправителя(ТекУчастник);
	
	ФорматИмпорта = Справочники.ФорматыОбменаБанкиКС.ПолучитьФорматПоВладельцуНаправлениюНаименованию(НастройкиУчастника.ВидОбмена,Перечисления.НаправлениеОбменаБанкиКС.Импорт,"ExportChargesResponse");
	
	Если НЕ ЗначениеЗаполнено(ФорматИмпорта) Тогда
		Текст = Нстр("ru='Отсутствует формат импорта данных из сервиса с кодом ""ExportChargesResponse""'");			
		ОбщегоНазначения.СообщитьПользователю(Текст);
		Возврат;
	КонецЕсли;	
		
	ОбработкаИмпорта = Обработки.ОбменВФорматахУФК_УФЭБС.Создать();
	Таблица = ОбработкаИмпорта.ЗагрузитьИзФайлаXML3(ТекстФайла,ФорматИмпорта,Документы.ЗаданиеНаИмпортДанныхБанкиКС.ПустаяСсылка());
	
	Если Таблица.Колонки.Найти("hasMore") = Неопределено Тогда
		Таблица.Колонки.Добавить("hasMore",Новый ОписаниеТипов("Булево"));
	КонецЕсли;
	Если Таблица.Колонки.Найти("Начисление") = Неопределено Тогда
		Таблица.Колонки.Добавить("Начисление");
	КонецЕсли;
	Если Таблица.Колонки.Найти("СтатусКвитирования") = Неопределено Тогда
		Таблица.Колонки.Добавить("СтатусКвитирования");
	КонецЕсли;
	Если Таблица.Колонки.Найти("ОстатокЗадолженности") = Неопределено Тогда
		Таблица.Колонки.Добавить("ОстатокЗадолженности");
	КонецЕсли;
	Если Таблица.Колонки.Найти("УИН") = Неопределено Тогда
		Таблица.Колонки.Добавить("УИН");
	КонецЕсли;
	
	КолДок = 0;
	КоличествоВсего = 0;
	
	НуженСледующийЗапрос = Ложь;
	Для Каждого СтрТЧ Из Таблица Цикл
		НуженСледующийЗапрос = СтрТЧ.hasMore ИЛИ НуженСледующийЗапрос;
		Если ЗначениеЗаполнено(СтрТЧ.Начисление) 
			ИЛИ ЗначениеЗаполнено(СтрТЧ.УИН) Тогда
			
			КоличествоВсего = КоличествоВсего + 1;
			
			Если ЗначениеЗаполнено(СтрТЧ.Начисление) Тогда
				ТекНачисление = СтрТЧ.Начисление;
			Иначе
				ТекНачисление = БиблиотекаФункцийОбмена.ПолучитьНачислениеПоУИН(СтрТЧ.УИН);	
			КонецЕсли;
			
			Если Не ЗначениеЗаполнено(ТекНачисление) Тогда
				Продолжить;
			КонецЕсли;
			
			Запись = РегистрыСведений.СтатусыКвитированияНачислений.СоздатьМенеджерЗаписи();
			Запись.Начисление = ТекНачисление;
			Запись.СтатусКвитирования = СтрТЧ.СтатусКвитирования;
			Запись.ОстатокЗадолженности = СтрТЧ.ОстатокЗадолженности;
			Запись.Записать();
			
			Если Запись.СтатусКвитирования = 4 Тогда
				//сквитировано принудительно без платежа
				СтруктураРекв = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(ТекНачисление);
				Если СтруктураРекв.Статус <> Перечисления.СтатусыИсполненияДокумента.Исполнен Тогда
					СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",ТекНачисление);
					СтруктураРекв.Вставить("Статус",Перечисления.СтатусыИсполненияДокумента.Исполнен);
					ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ДатаОбменаЗапроса = Неопределено;
	ЗапросКСМЭВ = Неопределено;
	ИдЗапросаРС = Неопределено;
	
	ОпределитьДанныеЗапросаПоИдентификатору(ИдентификаторСообщенияУчастника,ДатаОбменаЗапроса,ЗапросКСМЭВ,ИдЗапросаРС);
	
	ЗаписатьОбработкуОтветаНаПолучениеДанных(ЗапросКСМЭВ, ИдЗапросаРС, КолДок, КоличествоВсего, НуженСледующийЗапрос, ТаблицаДляЗапросаНовыхДанных, ИдентификаторСообщенияУчастника, Ложь);
		
	УстановитьПривилегированныйРежим(Ложь);	
	
КонецПроцедуры

Процедура УстановитьСтатусОбработкиСообщения(ИдентификаторСообщенияУчастника,УстанавливаемыйСтатус,РезультатОбработки="")
	
	//Только установим статус обработки сообщения, отправленного в эмулятор
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СообщенияИмпортаДанныхВСМЭВ3.Организация КАК Организация,
	               |	СообщенияИмпортаДанныхВСМЭВ3.ИдентификаторСообщения КАК ИдентификаторСообщения
	               |ИЗ
	               |	РегистрСведений.СообщенияИмпортаДанныхВСМЭВ3 КАК СообщенияИмпортаДанныхВСМЭВ3
	               |ГДЕ
	               |	СообщенияИмпортаДанныхВСМЭВ3.ИдентификаторСообщения = &ИдентификаторСообщения";
	
	Запрос.УстановитьПараметр("ИдентификаторСообщения", ИдентификаторСообщенияУчастника);
	
	РезультатЗапроса = Запрос.Выполнить();
			
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Запись = РегистрыСведений.СообщенияИмпортаДанныхВСМЭВ3.СоздатьМенеджерЗаписи();
		Запись.Организация = ВыборкаДетальныеЗаписи.Организация;
		Запись.ИдентификаторСообщения = ВыборкаДетальныеЗаписи.ИдентификаторСообщения;
		Запись.Прочитать();
								
		Запись.СтатусОтправки = УстанавливаемыйСтатус;
		Запись.РезультатОбработки = РезультатОбработки;
		
		Запись.Записать(Истина);
	КонецЕсли;
	
КонецПроцедуры


// Обработка ошибок

Процедура ОбработатьРезультатАсинхроннойПроверки(СтруктураРезультата,ПолноеОписаниеОшибок)
	
	УстановитьПривилегированныйРежим(Истина);
	
	//Выполняется в привилегированном режиме,
	//т.к. при передаче ГАНом начислений подведомственных,
	//документы могут быть не ГАНа, а подведомственного участника.
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СообщенияИмпортаДанныхВСМЭВ3.Организация КАК Организация,
		|	СообщенияИмпортаДанныхВСМЭВ3.ИдентификаторСообщения КАК ИдентификаторСообщения
		|ИЗ
		|	РегистрСведений.СообщенияИмпортаДанныхВСМЭВ3 КАК СообщенияИмпортаДанныхВСМЭВ3
		|ГДЕ
		|	СообщенияИмпортаДанныхВСМЭВ3.ИдентификаторСообщения = &ИдентификаторСообщения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеИсходящихСообщенийСМЭВ3.ИдентификаторСообщения КАК ИдентификаторСообщения,
		|	ДанныеИсходящихСообщенийСМЭВ3.Данные КАК Данные,
		|	ДанныеИсходящихСообщенийСМЭВ3.УИДВыполняемогоЗапросаКГИСГМП КАК УИДВыполняемогоЗапросаКГИСГМП
		|ИЗ
		|	РегистрСведений.ДанныеИсходящихСообщенийСМЭВ3 КАК ДанныеИсходящихСообщенийСМЭВ3
		|ГДЕ
		|	ДанныеИсходящихСообщенийСМЭВ3.ИдентификаторСообщения = &ИдентификаторСообщения";
	
	Запрос.УстановитьПараметр("ИдентификаторСообщения", СтруктураРезультата.ИдентификаторСообщенияУчастника);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
				
	//Наиболее вероятный статус
	УстанавливаемыйСтатус = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.НеПрошелАсинхроннуюПроверку;
	
	Если СтруктураРезультата.Категория = "requestIsQueued"
		ИЛИ СтруктураРезультата.Категория = "requestIsAcceptedBySmev" Тогда
		//Сообщение находится в очереди асинхронной обработки / Сообщение помещено в очередь получателя (запрос или ответ)
		УстанавливаемыйСтатус = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ВОчереди;
		
	ИначеЕсли СтруктураРезультата.Категория = "requestIsRejectedBySmev" Тогда
		//Сообщение не прошло асинхронную обработку
		УстанавливаемыйСтатус = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.НеПрошелАсинхроннуюПроверку;
		
	ИначеЕсли СтруктураРезультата.Категория = "messageIsArchived" Тогда
		//Сообщение, получение которого не подтверждено получателем, переведено в архив
		УстанавливаемыйСтатус = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ПереведенВАрхив;
		
	ИначеЕсли СтруктураРезультата.Категория = "messageIsDelivered" Тогда
		//Сообщение получено получателем, т.е. получение сообщения подтверждено получателем
		УстанавливаемыйСтатус = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ПолученПолучателем;
		
	ИначеЕсли СтруктураРезультата.Категория = "underProcessing" Тогда
		//Сообщение находится в процессе обработки/ожидания получения ответа от ГИС ГМП
		УстанавливаемыйСтатус = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ВПроцессеОбработки;
		
	ИначеЕсли СтруктураРезультата.Категория = "cancelled" Тогда
		//истечении срока хранения сообщения, отправленного в адрес ИС
		УстанавливаемыйСтатус = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ИстекСрокХраненияСообщения;
		
	КонецЕсли;
	
	ВыборкаДетальныеЗаписи = РезультатыЗапроса[0].Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Запись = РегистрыСведений.СообщенияИмпортаДанныхВСМЭВ3.СоздатьМенеджерЗаписи();
		Запись.Организация = ВыборкаДетальныеЗаписи.Организация;
		Запись.ИдентификаторСообщения = ВыборкаДетальныеЗаписи.ИдентификаторСообщения;
		Запись.Прочитать();
		
		Запись.РезультатОбработки = ПолноеОписаниеОшибок;		
		Запись.СтатусОтправки = УстанавливаемыйСтатус;
		Если УстанавливаемыйСтатус = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.НеПрошелАсинхроннуюПроверку Тогда
			Запись.ЕстьОшибка = Истина;
		КонецЕсли;
		
		Запись.Записать(Истина);
	КонецЕсли;
		
	ВыборкаДетальныеЗаписи = РезультатыЗапроса[1].Выбрать();
	
	НовыйСтатус = Перечисления.СтатусыИсполненияДокумента.ВРаботе;
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		//у документов, отправляемых в СМЭВ должно быть обязательно поле СтатусОбработки, а у импортируемых данных еще и поле РезультатОбработкиОбщий
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Данные) Тогда
						
			ДокОбъект = ВыборкаДетальныеЗаписи.Данные.ПолучитьОбъект();
			
			Если ДокОбъект <> Неопределено Тогда
			
				ДокОбъект.СтатусОбработки = УстанавливаемыйСтатус;
				
				//т.к. один и тот же запрос может отправляться несколькими форматами сразу (внутренний и внешний - в ИС РНИП и в ГИС ГМП),
				//то результат обработки в документ заполнять не будем, будет только в регистре.
				Если ТипЗнч(ДокОбъект) <> Тип("ДокументОбъект.ЗапросУНИФО") Тогда
					ДокОбъект.РезультатОбработкиОбщий = ПолноеОписаниеОшибок;
				КонецЕсли;
				
				//Если это ошибка асинхронной обработки, то набольшая вероятность причины проблемы - в данных отправляемых документах пакета.
				//В этом случае, если текущий статус "Передан в обработку", то установим статус для документов "В работе".
				Если УстанавливаемыйСтатус = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.НеПрошелАсинхроннуюПроверку Тогда
					ИмяТЧ = "";
				    ИмяРеквизитаТЧ = "";
					Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПакетНачисленийГИСГМП") Тогда
						ИмяТЧ = "Начисления";
				        ИмяРеквизитаТЧ = "НачислениеСсылка";
					ИначеЕсли ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ПакетУведомленийОВозвратеГИСГМП") Тогда
						ИмяТЧ = "Возвраты";
				        ИмяРеквизитаТЧ = "ВозвратСсылка";					
					КонецЕсли;
					Если ЗначениеЗаполнено(ИмяТЧ) Тогда
						Для Каждого СтрТЧ Из ДокОбъект[ИмяТЧ] Цикл
							СтруктураРекв = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(СтрТЧ[ИмяРеквизитаТЧ]);
							Если СтруктураРекв.Статус = Перечисления.СтатусыИсполненияДокумента.ПереданВОбработку Тогда
								//Статус начисления меняется только если текущий статус - Передан в обработку
								СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",СтрТЧ[ИмяРеквизитаТЧ]);
								СтруктураРекв.Вставить("Статус",НовыйСтатус);
								ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);							
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;
				КонецЕсли;
				ДокОбъект.Записать();
				
				Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ЗапросУНИФО") Тогда
					//не удалось сквитировать, вернем признаки как было
					
					ТекущееЗначение = 2;//0 - нет, 1 - Да, 2 - запрос отправлен (прошлое значение Да), 3 - квитирование выполнено, 4 - запрос отправлен (прошлое значение Нет), 5 - сквитировать не удалось
					НовоеЗначение = 1;  //0 - нет, 1 - Да, 2 - запрос отправлен (прошлое значение Да), 3 - квитирование выполнено, 4 - запрос отправлен (прошлое значение Нет), 5 - сквитировать не удалось
		
					ИзменитьЗначениеТребованияКвитирования(ДокОбъект,ТекущееЗначение,НовоеЗначение);
					
					ТекущееЗначение = 4;//0 - нет, 1 - Да, 2 - запрос отправлен (прошлое значение Да), 3 - квитирование выполнено, 4 - запрос отправлен (прошлое значение Нет), 5 - сквитировать не удалось
					НовоеЗначение = 5;  //0 - нет, 1 - Да, 2 - запрос отправлен (прошлое значение Да), 3 - квитирование выполнено, 4 - запрос отправлен (прошлое значение Нет), 5 - сквитировать не удалось
		
					ИзменитьЗначениеТребованияКвитирования(ДокОбъект,ТекущееЗначение,НовоеЗначение);
					
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.УИДВыполняемогоЗапросаКГИСГМП) Тогда	
			
			Выборка = ПолучитьВыборкуВыполняемогоЗапросаПоИдентификатору(ВыборкаДетальныеЗаписи.УИДВыполняемогоЗапросаКГИСГМП);
		    //записать результат текущей записи
			Если Выборка.Следующий() Тогда
							
				//если уже ранее обработали этот ответ, но подтвердить не успели, то не повторяем запись
				Если Выборка.СтатусВыполняемогоЗапроса <> УстанавливаемыйСтатус Тогда
					ЗаписьРС = РегистрыСведений.ВыполняемыеЗапросыОчередиКГИСГМП.СоздатьМенеджерЗаписи();
					ЗаполнитьЗначенияСвойств(ЗаписьРС,Выборка);
					ЗаписьРС.СтатусВыполняемогоЗапроса = УстанавливаемыйСтатус;
					Если УстанавливаемыйСтатус = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.НеПрошелАсинхроннуюПроверку Тогда
						ЗаписьРС.ЕстьОшибка = Истина;
					КонецЕсли;
					
					Если ЗаписьРС.ЕстьОшибка Тогда
						ЗаписьРС.ТекстОшибки = ПолноеОписаниеОшибок;
                    Иначе
						ЗаписьРС.РезультатОбработки = ПолноеОписаниеОшибок;
					КонецЕсли;
					
					ЗаписьРС.Записать();
				
					//не создаем повторную запись, потому что не прошло проверку
					//создавать такую же запись, чтобы она тоже не прошла проверку смысла нет
					
					ПроверитьЗавершитьОбработкуДетальнойОчередиЗапросов(ЗаписьРС.Организация,ЗаписьРС.УИДНастройкиОбщегоЗапроса,ЗаписьРС.УИДНастройкиДетальногоЗапроса);
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура ОбработатьОшибкуСтатуса(ИдентификаторСообщенияУчастника,КодОшибки,ОписаниеОшибки)
	
	УстановитьПривилегированныйРежим(Истина);
	
	//Выполняется в привилегированном режиме,
	//т.к. при передаче ГАНом начислений подведомственных,
	//документы могут быть не ГАНа, а подведомственного участника.
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СообщенияИмпортаДанныхВСМЭВ3.Организация КАК Организация,
		|	СообщенияИмпортаДанныхВСМЭВ3.ИдентификаторСообщения КАК ИдентификаторСообщения
		|ИЗ
		|	РегистрСведений.СообщенияИмпортаДанныхВСМЭВ3 КАК СообщенияИмпортаДанныхВСМЭВ3
		|ГДЕ
		|	СообщенияИмпортаДанныхВСМЭВ3.ИдентификаторСообщения = &ИдентификаторСообщения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеИсходящихСообщенийСМЭВ3.ИдентификаторСообщения КАК ИдентификаторСообщения,
		|	ДанныеИсходящихСообщенийСМЭВ3.Данные КАК Данные,
		|	ДанныеИсходящихСообщенийСМЭВ3.УИДВыполняемогоЗапросаКГИСГМП КАК УИДВыполняемогоЗапросаКГИСГМП
		|ИЗ
		|	РегистрСведений.ДанныеИсходящихСообщенийСМЭВ3 КАК ДанныеИсходящихСообщенийСМЭВ3
		|ГДЕ
		|	ДанныеИсходящихСообщенийСМЭВ3.ИдентификаторСообщения = &ИдентификаторСообщения";
	
	Запрос.УстановитьПараметр("ИдентификаторСообщения", ИдентификаторСообщенияУчастника);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
		
	ПолноеОписаниеОшибок = "Код ошибки: " +КодОшибки+" Описание: "+ОписаниеОшибки;		
	
	УстанавливаемыйСтатус = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ОтклоненПолучателем;
	ВыборкаДетальныеЗаписи = РезультатыЗапроса[0].Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Запись = РегистрыСведений.СообщенияИмпортаДанныхВСМЭВ3.СоздатьМенеджерЗаписи();
		Запись.Организация = ВыборкаДетальныеЗаписи.Организация;
		Запись.ИдентификаторСообщения = ВыборкаДетальныеЗаписи.ИдентификаторСообщения;
		Запись.Прочитать();
		
		Запись.РезультатОбработки = ПолноеОписаниеОшибок;
		Запись.ЕстьОшибка = Истина;
		
		Запись.СтатусОтправки = УстанавливаемыйСтатус;
				
		Запись.Записать(Истина);
	КонецЕсли;
		
	ВыборкаДетальныеЗаписи = РезультатыЗапроса[1].Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		//у документов, отправляемых в СМЭВ должно быть обязательно поле СтатусОбработки, а у импортируемых данных еще и поле РезультатОбработкиОбщий
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Данные) Тогда		
			ДокОбъект = ВыборкаДетальныеЗаписи.Данные.ПолучитьОбъект();
			Если ДокОбъект <> Неопределено Тогда
				ДокОбъект.СтатусОбработки = УстанавливаемыйСтатус;
				//т.к. один и тот же запрос может отправляться несколькими форматами сразу (внутренний и внешний - в ИС РНИП и в ГИС ГМП),
				//то результат обработки в документ заполнять не будем, будет только в регистре.
				
				Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.НачислениеОтПосредникаГИСГМП") Тогда
					ДокОбъект.РезультатИмпортаКод = КодОшибки;
					ДокОбъект.РезультатИмпортаОписание = ОписаниеОшибки;
				ИначеЕсли ТипЗнч(ДокОбъект) <> Тип("ДокументОбъект.ЗапросУНИФО") Тогда
					ДокОбъект.РезультатОбработкиОбщий = ПолноеОписаниеОшибок;
				КонецЕсли;
				ДокОбъект.Записать();
				
				Если ТипЗнч(ВыборкаДетальныеЗаписи.Данные) = Тип("ДокументСсылка.НачислениеОтПосредникаГИСГМП") Тогда
					//отклонен документ, значит что-то в документе не так, установим статус в работе
					СтруктураРекв = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(ВыборкаДетальныеЗаписи.Данные);
					Если СтруктураРекв.Статус = Перечисления.СтатусыИсполненияДокумента.ПереданВОбработку Тогда
						//Статус начисления меняется только если текущий статус - Передан в обработку
						СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",ВыборкаДетальныеЗаписи.Данные);
						ТекСтатус = Перечисления.СтатусыИсполненияДокумента.ВРаботе;
						СтруктураРекв.Вставить("Статус",ТекСтатус);
						ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
					КонецЕсли;
				КонецЕсли;
				
				Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ЗапросУНИФО") Тогда
					//не удалось сквитировать, вернем признаки как было
					
					ТекущееЗначение = 2;//0 - нет, 1 - Да, 2 - запрос отправлен (прошлое значение Да), 3 - квитирование выполнено, 4 - запрос отправлен (прошлое значение Нет), 5 - сквитировать не удалось
					НовоеЗначение = 1;  //0 - нет, 1 - Да, 2 - запрос отправлен (прошлое значение Да), 3 - квитирование выполнено, 4 - запрос отправлен (прошлое значение Нет), 5 - сквитировать не удалось
		
					ИзменитьЗначениеТребованияКвитирования(ДокОбъект,ТекущееЗначение,НовоеЗначение);
					
					ТекущееЗначение = 4;//0 - нет, 1 - Да, 2 - запрос отправлен (прошлое значение Да), 3 - квитирование выполнено, 4 - запрос отправлен (прошлое значение Нет), 5 - сквитировать не удалось
					НовоеЗначение = 5;  //0 - нет, 1 - Да, 2 - запрос отправлен (прошлое значение Да), 3 - квитирование выполнено, 4 - запрос отправлен (прошлое значение Нет), 5 - сквитировать не удалось
		
					ИзменитьЗначениеТребованияКвитирования(ДокОбъект,ТекущееЗначение,НовоеЗначение);
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.УИДВыполняемогоЗапросаКГИСГМП) Тогда	
			Выборка = ПолучитьВыборкуВыполняемогоЗапросаПоИдентификатору(ВыборкаДетальныеЗаписи.УИДВыполняемогоЗапросаКГИСГМП);
			
			//записать результат текущей записи
			Если Выборка.Следующий() Тогда
				
				//если уже ранее обработали этот ответ, но подтвердить не успели, то не повторяем запись
				Если Выборка.СтатусВыполняемогоЗапроса <> УстанавливаемыйСтатус Тогда
					
					ЗаписьРС = РегистрыСведений.ВыполняемыеЗапросыОчередиКГИСГМП.СоздатьМенеджерЗаписи();
					ЗаполнитьЗначенияСвойств(ЗаписьРС,Выборка);
					ЗаписьРС.СтатусВыполняемогоЗапроса = УстанавливаемыйСтатус;
					ЗаписьРС.ЕстьОшибка = Истина;
					ЗаписьРС.ТекстОшибки = ПолноеОписаниеОшибок;
									
					ЗаписьРС.Записать();
					
					//1 - разовый сбой, повторить запрос
					//11 - в настройках запроса некорректная информация - повторять не надо
					//27, 31 - ошибки ЭП - повторять не имеет смысла
					//21 - незарегистрированный участник - повторять не имеет смысла
					//23 - участник не завершил тестирование или исключен - повторять не имеет смысла
					//30 - нет прав на этот запрос - повторять не имеет смысла 
					//102 - Блокирована возможность взаимодействия с ГИС ГМП через СМЭВ 3.Х - повторять не имеет смысла
					//234 - Контрольный разряд УИН имеет некорректное значение - повторять не имеет смысла
					
					//105 - Ответ по запрашиваемой странице был предоставлен ранее, при необходимости запросите данные через 10 минут
					//	Проверка, что ответ на запрашиваемую страницу был предоставлен в течение последних 10 минут.
					//	Если ранее предоставленный ответ не был обработан, необходимо запросить данные повторно, начиная с первой страницы, через 10 минут.
					
					//106 - запрос не по порядку. Запрос предыдущей страницы был более 10 минут назад.
					
					//Запрос участника будет успешно обрабатываться, если выполняются одновременно 3 
					//условия (за исключением запроса первой страницы):
					//1. Номер страницы в запросе больше ранее обработанной;
					//2. Запрос предыдущей страницы был обработан;
					//3. Время между запросами составило менее 10 минут.
					//Если участник запрашивает одну и ту же страницу повторно в течение 10 минут, то будет 
					//возвращен новый результат форматно-логического контроля «105» (Ответ по 
					//запрашиваемой странице был предоставлен ранее, при необходимости запросите данные 
					//через 10 минут).
					//Если разница во времени между запросом одной и последующей страницы составила более 
					//10 минут, то участнику будет возвращен новый результат форматно-логического контроля
					//«106» (Получение страниц по запросу должно осуществляться последовательно).
					//Если участник запрашивает страницы в произвольном порядке, то будет возвращен новый 
					//результат форматно-логического контроля «106» (Получение страниц по запросу должно 
					//осуществляться последовательно).
					
					НужнаПроверка = Истина;
					
					Если КодОшибки = "1" Тогда  
						//разовый сбой, повторить запрос
						//внутренняя ошибка "1" может возвращаться, если запрос сформирован за большой период
						//в этом случае рекомендуется уменьшать период запроса, а повторять запрос не имеет смысла
						//поэтому есть ресурс НомерПовтора, в нем указывается номер повтора запроса
						//повторяем запрос по коду ошибки "1" до 5 раз
						
						Если ЗаписьРС.НомерПовтора<5 Тогда
							
							НужнаПроверка = Ложь;
							
							СтраницаРезультата = ЗаписьРС.СтраницаРезультата;
							СтатусЗаписи = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ВРаботе;
							СоздатьЗаписьВыполняемыеЗапросыКГИСГМП(ЗаписьРС,СтатусЗаписи,СтраницаРезультата,Истина);
						КонецЕсли;
						
					ИначеЕсли КодОшибки = "105" Тогда 
						//ответ на запрос был менее 10 минут назад, ничего не делаем
						
					ИначеЕсли КодОшибки = "106" Тогда
						//не получилось запросить следующую страницу вовремя, создаем запись с 1 страницы
						
						НужнаПроверка = Ложь;
						
						СтраницаРезультата = 1;
						СтатусЗаписи = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.Запланирован;
						СоздатьЗаписьВыполняемыеЗапросыКГИСГМП(ЗаписьРС,СтатусЗаписи,СтраницаРезультата);
						
					КонецЕсли;
					
					Если НужнаПроверка Тогда
						ПроверитьЗавершитьОбработкуДетальнойОчередиЗапросов(ЗаписьРС.Организация,ЗаписьРС.УИДНастройкиОбщегоЗапроса,ЗаписьРС.УИДНастройкиДетальногоЗапроса);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;			 
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
		
	
КонецПроцедуры

Процедура ПроверитьЗавершитьОбработкуДетальнойОчередиЗапросов(Организация,УИДНастройкиОбщегоЗапроса,УИДНастройкиДетальногоЗапроса)
	
	УстановитьПривилегированныйРежим(Истина);
	
	//Мы должны посмотреть, есть ли по измерениям РС ОчередьЗапросовКГИСГМПДетальные записи в ВыполняемыеЗапросыОчередиКГИСГМП,
	//которые еще не обработаны, или которые обработаны с ошибкой по максимальному значению НомерПовтора.
	//Итого:
	//- если все обработаны, мы должны установить статус в записи ОчередьЗапросовКГИСГМПДетальные как обработан с учетом признака ошибки;
	//- если обработаны не все, ничего не делаем
	
	//статусы, означающие, что обработаны не все - ВРаботе, Запланирован, Отправлен
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВыполняемыеЗапросыОчередиКГИСГМП.СтраницаРезультата КАК СтраницаРезультата,
		|	ВыполняемыеЗапросыОчередиКГИСГМП.СтатусВыполняемогоЗапроса КАК СтатусВыполняемогоЗапроса,
		|	ВыполняемыеЗапросыОчередиКГИСГМП.ЕстьОшибка КАК ЕстьОшибка,
		|	ВыполняемыеЗапросыОчередиКГИСГМП.НомерПовтора КАК НомерПовтора
		|ПОМЕСТИТЬ ТабРезультатов
		|ИЗ
		|	РегистрСведений.ВыполняемыеЗапросыОчередиКГИСГМП КАК ВыполняемыеЗапросыОчередиКГИСГМП
		|ГДЕ
		|	ВыполняемыеЗапросыОчередиКГИСГМП.Организация = &Организация
		|	И ВыполняемыеЗапросыОчередиКГИСГМП.УИДНастройкиОбщегоЗапроса = &УИДНастройкиОбщегоЗапроса
		|	И ВыполняемыеЗапросыОчередиКГИСГМП.УИДНастройкиДетальногоЗапроса = &УИДНастройкиДетальногоЗапроса
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ТабРезультатов.СтатусВыполняемогоЗапроса В (&МассивСтатусовВОбработке)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) КАК ЕстьВыполняемыеЗапросы,
		|	МАКСИМУМ(ТабРезультатов.ЕстьОшибка) КАК ЕстьОшибка,
		|	МАКСИМУМ(НЕ ТабРезультатов.ЕстьОшибка) КАК ЕстьБезОшибки
		|ИЗ
		|	(ВЫБРАТЬ
		|		ТабРезультатов.СтраницаРезультата КАК СтраницаРезультата,
		|		МАКСИМУМ(ТабРезультатов.НомерПовтора) КАК НомерПовтора
		|	ИЗ
		|		ТабРезультатов КАК ТабРезультатов
		|	
		|	СГРУППИРОВАТЬ ПО
		|		ТабРезультатов.СтраницаРезультата) КАК СгруппированныеДанные
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТабРезультатов КАК ТабРезультатов
		|		ПО СгруппированныеДанные.СтраницаРезультата = ТабРезультатов.СтраницаРезультата
		|			И СгруппированныеДанные.НомерПовтора = ТабРезультатов.НомерПовтора";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("УИДНастройкиДетальногоЗапроса", УИДНастройкиДетальногоЗапроса);
	Запрос.УстановитьПараметр("УИДНастройкиОбщегоЗапроса", УИДНастройкиОбщегоЗапроса);
	
	МассивСтатусовВОбработке = Новый Массив;
	МассивСтатусовВОбработке.Добавить(Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ВРаботе);
	МассивСтатусовВОбработке.Добавить(Перечисления.РезультатыОтправкиСообщенийВСМЭВ.Запланирован);
	МассивСтатусовВОбработке.Добавить(Перечисления.РезультатыОтправкиСообщенийВСМЭВ.Отправлен);
	
	Запрос.УстановитьПараметр("МассивСтатусовВОбработке", МассивСтатусовВОбработке);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Если ВыборкаДетальныеЗаписи.ЕстьВыполняемыеЗапросы = Ложь Тогда
			ЗаписьРС = РегистрыСведений.ОчередьЗапросовКГИСГМПДетальные.СоздатьМенеджерЗаписи();
			ЗаписьРС.Организация = Организация;
			ЗаписьРС.УИДНастройкиОбщегоЗапроса = УИДНастройкиОбщегоЗапроса;
			ЗаписьРС.УИДНастройкиДетальногоЗапроса = УИДНастройкиДетальногоЗапроса;
			ЗаписьРС.Прочитать();
			
			Если ЗаписьРС.Выбран() Тогда
				УстанавливаемыйСтатус = Неопределено;
				Если ВыборкаДетальныеЗаписи.ЕстьОшибка = Ложь Тогда
					УстанавливаемыйСтатус = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ОбработанБезОшибок;	
				ИначеЕсли ВыборкаДетальныеЗаписи.ЕстьОшибка
					И ВыборкаДетальныеЗаписи.ЕстьБезОшибки Тогда 
					УстанавливаемыйСтатус = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ОбработанЕстьОшибки;
				ИначеЕсли ВыборкаДетальныеЗаписи.ЕстьОшибка
					И ВыборкаДетальныеЗаписи.ЕстьБезОшибки = Ложь Тогда 					
					УстанавливаемыйСтатус = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.Ошибка;					
				КонецЕсли;
				ЗаписьРС.СтатусДетальногоЗапроса = УстанавливаемыйСтатус;
				ЗаписьРС.ЕстьОшибка = ВыборкаДетальныеЗаписи.ЕстьОшибка;
				ЗаписьРС.Записать();
			КонецЕсли;
			
			ПроверитьЗавершитьОбработкуОбщейОчередиЗапросов(Организация,УИДНастройкиОбщегоЗапроса);
		КонецЕсли;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура ПроверитьЗавершитьОбработкуОбщейОчередиЗапросов(Организация,УИДНастройкиОбщегоЗапроса)
	
	УстановитьПривилегированныйРежим(Истина);

	//статусы, означающие, что обработаны не все - ВРаботе, Запланирован, Отправлен
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОчередьЗапросовКГИСГМПДетальные.СтатусДетальногоЗапроса КАК СтатусДетальногоЗапроса,
		|	ОчередьЗапросовКГИСГМПДетальные.ЕстьОшибка КАК ЕстьОшибка
		|ПОМЕСТИТЬ ТабДанные
		|ИЗ
		|	РегистрСведений.ОчередьЗапросовКГИСГМПДетальные КАК ОчередьЗапросовКГИСГМПДетальные
		|ГДЕ
		|	ОчередьЗапросовКГИСГМПДетальные.Организация = &Организация
		|	И ОчередьЗапросовКГИСГМПДетальные.УИДНастройкиОбщегоЗапроса = &УИДНастройкиОбщегоЗапроса
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ТабДанные.СтатусДетальногоЗапроса В (&МассивСтатусовВОбработке)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) КАК ЕстьВыполняемыеЗапросы,
		|	МАКСИМУМ(ТабДанные.ЕстьОшибка) КАК ЕстьОшибка,
		|	МАКСИМУМ(НЕ ТабДанные.ЕстьОшибка) КАК ЕстьБезОшибки
		|ИЗ
		|	ТабДанные КАК ТабДанные";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("УИДНастройкиОбщегоЗапроса", УИДНастройкиОбщегоЗапроса);
	
	МассивСтатусовВОбработке = Новый Массив;
	МассивСтатусовВОбработке.Добавить(Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ВРаботе);
	МассивСтатусовВОбработке.Добавить(Перечисления.РезультатыОтправкиСообщенийВСМЭВ.Запланирован);
	МассивСтатусовВОбработке.Добавить(Перечисления.РезультатыОтправкиСообщенийВСМЭВ.Отправлен);
	
	Запрос.УстановитьПараметр("МассивСтатусовВОбработке", МассивСтатусовВОбработке);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Если ВыборкаДетальныеЗаписи.ЕстьВыполняемыеЗапросы = Ложь Тогда
			ЗаписьРС = РегистрыСведений.ОчередьЗапросовКГИСГМПОбщие.СоздатьМенеджерЗаписи();
			ЗаписьРС.Организация = Организация;
			ЗаписьРС.УИДНастройкиОбщегоЗапроса = УИДНастройкиОбщегоЗапроса;
			ЗаписьРС.Прочитать();
			
			Если ЗаписьРС.Выбран() Тогда
								
				Если ВыборкаДетальныеЗаписи.ЕстьОшибка = Ложь Тогда
					УстанавливаемыйСтатус = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ОбработанБезОшибок;	
				ИначеЕсли ВыборкаДетальныеЗаписи.ЕстьОшибка
					И ВыборкаДетальныеЗаписи.ЕстьБезОшибки Тогда 
					УстанавливаемыйСтатус = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ОбработанЕстьОшибки;
				ИначеЕсли ВыборкаДетальныеЗаписи.ЕстьОшибка
					И ВыборкаДетальныеЗаписи.ЕстьБезОшибки = Ложь Тогда 					
					УстанавливаемыйСтатус = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.Ошибка;					
				КонецЕсли;
				ЗаписьРС.СтатусОбщегоЗапроса = УстанавливаемыйСтатус;
				ЗаписьРС.ЕстьОшибка = ВыборкаДетальныеЗаписи.ЕстьОшибка;
				ЗаписьРС.Записать();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры
	
Процедура ОбработатьОшибкуОтклонения(ИдентификаторСообщенияУчастника,ОписаниеОшибки)
	
	УстановитьПривилегированныйРежим(Истина);
	
	//Выполняется в привилегированном режиме,
	//т.к. при передаче ГАНом начислений подведомственных,
	//документы могут быть не ГАНа, а подведомственного участника.
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СообщенияИмпортаДанныхВСМЭВ3.Организация КАК Организация,
		|	СообщенияИмпортаДанныхВСМЭВ3.ИдентификаторСообщения КАК ИдентификаторСообщения
		|ИЗ
		|	РегистрСведений.СообщенияИмпортаДанныхВСМЭВ3 КАК СообщенияИмпортаДанныхВСМЭВ3
		|ГДЕ
		|	СообщенияИмпортаДанныхВСМЭВ3.ИдентификаторСообщения = &ИдентификаторСообщения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеИсходящихСообщенийСМЭВ3.ИдентификаторСообщения КАК ИдентификаторСообщения,
		|	ДанныеИсходящихСообщенийСМЭВ3.Данные КАК Данные,
		|	ДанныеИсходящихСообщенийСМЭВ3.УИДВыполняемогоЗапросаКГИСГМП КАК УИДВыполняемогоЗапросаКГИСГМП
		|ИЗ
		|	РегистрСведений.ДанныеИсходящихСообщенийСМЭВ3 КАК ДанныеИсходящихСообщенийСМЭВ3
		|ГДЕ
		|	ДанныеИсходящихСообщенийСМЭВ3.ИдентификаторСообщения = &ИдентификаторСообщения";
	
	Запрос.УстановитьПараметр("ИдентификаторСообщения", ИдентификаторСообщенияУчастника);
	
	ЕстьОшибка = Истина;
	УстанавливаемыйСтатус = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ОтклоненПолучателем;
	Если СтрНайти(ОписаниеОшибки,"NO_DATA")>0 Тогда
		//запрос обработан, просто данных в сервисе нет.
		ЕстьОшибка = Ложь;
		УстанавливаемыйСтатус = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ОбработанБезОшибок;
	КонецЕсли;
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
			
	ВыборкаДетальныеЗаписи = РезультатыЗапроса[0].Выбрать();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Запись = РегистрыСведений.СообщенияИмпортаДанныхВСМЭВ3.СоздатьМенеджерЗаписи();
		Запись.Организация = ВыборкаДетальныеЗаписи.Организация;
		Запись.ИдентификаторСообщения = ВыборкаДетальныеЗаписи.ИдентификаторСообщения;
		Запись.Прочитать();
		
		Запись.РезультатОбработки = ОписаниеОшибки;
		Запись.ЕстьОшибка = ЕстьОшибка;
		
		Запись.СтатусОтправки = УстанавливаемыйСтатус;
				
		Запись.Записать(Истина);
	КонецЕсли;
		
	ВыборкаДетальныеЗаписи = РезультатыЗапроса[1].Выбрать(); 
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		//у документов, отправляемых в СМЭВ должно быть обязательно поле СтатусОбработки, а у импортируемых данных еще и поле РезультатОбработкиОбщий
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Данные) Тогда		
			ДокОбъект = ВыборкаДетальныеЗаписи.Данные.ПолучитьОбъект();
			Если ДокОбъект <> Неопределено Тогда
				ДокОбъект.СтатусОбработки = УстанавливаемыйСтатус;
				//т.к. один и тот же запрос может отправляться несколькими форматами сразу (внутренний и внешний - в ИС РНИП и в ГИС ГМП),
				//то результат обработки в документ заполнять не будем, будет только в регистре.
				Если ТипЗнч(ДокОбъект) <> Тип("ДокументОбъект.ЗапросУНИФО") Тогда
					ДокОбъект.РезультатОбработкиОбщий = ОписаниеОшибки;
				Иначе
					Если ЕстьОшибка = Ложь Тогда
						//NO_DATA
						ДокОбъект.РезультатЗагрузки = Сред(ОписаниеОшибки,СтрНайти(ОписаниеОшибки,"NO_DATA"));
					КонецЕсли;
					
				КонецЕсли;
				ДокОбъект.Записать();
				
				Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.ЗапросУНИФО") Тогда
					//не удалось сквитировать, вернем признаки как было
					
					ТекущееЗначение = 2;//0 - нет, 1 - Да, 2 - запрос отправлен (прошлое значение Да), 3 - квитирование выполнено, 4 - запрос отправлен (прошлое значение Нет), 5 - сквитировать не удалось
					НовоеЗначение = 1;  //0 - нет, 1 - Да, 2 - запрос отправлен (прошлое значение Да), 3 - квитирование выполнено, 4 - запрос отправлен (прошлое значение Нет), 5 - сквитировать не удалось
		
					ИзменитьЗначениеТребованияКвитирования(ДокОбъект,ТекущееЗначение,НовоеЗначение);
					
					ТекущееЗначение = 4;//0 - нет, 1 - Да, 2 - запрос отправлен (прошлое значение Да), 3 - квитирование выполнено, 4 - запрос отправлен (прошлое значение Нет), 5 - сквитировать не удалось
					НовоеЗначение = 5;  //0 - нет, 1 - Да, 2 - запрос отправлен (прошлое значение Да), 3 - квитирование выполнено, 4 - запрос отправлен (прошлое значение Нет), 5 - сквитировать не удалось
		
					ИзменитьЗначениеТребованияКвитирования(ДокОбъект,ТекущееЗначение,НовоеЗначение);
				КонецЕсли;
				
			КонецЕсли;
		ИначеЕсли ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.УИДВыполняемогоЗапросаКГИСГМП) Тогда	
			Выборка = ПолучитьВыборкуВыполняемогоЗапросаПоИдентификатору(ВыборкаДетальныеЗаписи.УИДВыполняемогоЗапросаКГИСГМП);
		    //записать результат текущей записи
			Если Выборка.Следующий() Тогда
				
				//если уже ранее обработали этот ответ, но подтвердить не успели, то не повторяем запись
				Если Выборка.СтатусВыполняемогоЗапроса <> УстанавливаемыйСтатус Тогда
					
					ЗаписьРС = РегистрыСведений.ВыполняемыеЗапросыОчередиКГИСГМП.СоздатьМенеджерЗаписи();
					ЗаполнитьЗначенияСвойств(ЗаписьРС,Выборка);
					ЗаписьРС.СтатусВыполняемогоЗапроса = УстанавливаемыйСтатус;
					ЗаписьРС.ЕстьОшибка = ЕстьОшибка;
					
					Если ЕстьОшибка = Ложь Тогда
						//NO_DATA
						ЗаписьРС.РезультатОбработки = Сред(ОписаниеОшибки,СтрНайти(ОписаниеОшибки,"NO_DATA"));
					Иначе
						ЗаписьРС.ТекстОшибки = ОписаниеОшибки;
					КонецЕсли;
					
					ЗаписьРС.Записать();
					
					Если ЕстьОшибка Тогда
						//если возникла какая-то ошибка, надо создать новую запись с 1 страницы
						
						СтраницаРезультата = 1;
						СтатусЗаписи = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ВРаботе;
						СоздатьЗаписьВыполняемыеЗапросыКГИСГМП(ЗаписьРС,СтатусЗаписи,СтраницаРезультата);
					Иначе
						ПроверитьЗавершитьОбработкуДетальнойОчередиЗапросов(ЗаписьРС.Организация,ЗаписьРС.УИДНастройкиОбщегоЗапроса,ЗаписьРС.УИДНастройкиДетальногоЗапроса);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);	
	
КонецПроцедуры

// Служебные

Функция СообщениеОтправлноИзЭтойБазы(ИдентификаторСообщенияУчастника)
		
	Если НЕ ЗначениеЗаполнено(ИдентификаторСообщенияУчастника) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	//нужно ли проверять? если базу восстановили из бэкапа, то подтвердить получаемое сообщение не получится.
	//В ИС РНИП не реализована передача полученных сообщений в отдельную очередь, для подтверждения,
	//и пока не подтвердишь текущее сообщение, то и получить новое никогда не сможешь.
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СообщенияИмпортаДанныхВСМЭВ3.ИдентификаторСообщения КАК ИдентификаторСообщения
		|ИЗ
		|	РегистрСведений.СообщенияИмпортаДанныхВСМЭВ3 КАК СообщенияИмпортаДанныхВСМЭВ3
		|ГДЕ
		|	СообщенияИмпортаДанныхВСМЭВ3.ИдентификаторСообщения = &ИдентификаторСообщения";
	
	Запрос.УстановитьПараметр("ИдентификаторСообщения", ИдентификаторСообщенияУчастника);
	
	УстановитьПривилегированныйРежим(Истина);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	УстановитьПривилегированныйРежим(Истина);
	
	Возврат НЕ РезультатЗапроса.Пустой();
	
КонецФункции

Функция ИсходныйЗапросБылОтАдминистратораЗапросов(ИдентификаторСообщенияУчастника)
	
	//По умолчанию все сообщения считаются как сообщения от администратора начислений
	
	ЭтоБылАЗ = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СообщенияИмпортаДанныхВСМЭВ3.ТипУчастника, ЗНАЧЕНИЕ(Перечисление.ТипыУчастниковГИСГМП.АН)) КАК ТипУчастника
		|ИЗ
		|	РегистрСведений.СообщенияИмпортаДанныхВСМЭВ3 КАК СообщенияИмпортаДанныхВСМЭВ3
		|ГДЕ
		|	СообщенияИмпортаДанныхВСМЭВ3.ИдентификаторСообщения = &ИдентификаторСообщения";
	
	Запрос.УстановитьПараметр("ИдентификаторСообщения", ИдентификаторСообщенияУчастника);
	
	УстановитьПривилегированныйРежим(Истина);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	УстановитьПривилегированныйРежим(Истина);
	
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		ЭтоБылАЗ = (Выборка.ТипУчастника = Перечисления.ТипыУчастниковГИСГМП.АЗ);
	КонецЕсли;
	
	Возврат ЭтоБылАЗ;
	
КонецФункции

// Для ИС РНИП и ИС УНП

Функция ПолучитьПереченьГосУслугДляЭкспортаКаталога(ДокИлиМассив)Экспорт
		
	Запрос = Новый Запрос;
	МассивСсылок = Новый Массив;
	Если ТипЗнч(ДокИлиМассив) = Тип("ДокументСсылка.КаталогГосУслуг") Тогда
		МассивСсылок.Добавить(ДокИлиМассив);
	Иначе
		МассивСсылок = ДокИлиМассив;
	КонецЕсли;
	//Запрос.УстановитьПараметр("Ссылка",ДокументСсылка);
	Запрос.УстановитьПараметр("Организация",ОбщегоНазначения.ЗначениеРеквизитаОбъекта(МассивСсылок[0],"Организация"));
	//Запрос.УстановитьПараметр("ДатаДокумента",ДокументСсылка.Дата);
	Запрос.УстановитьПараметр("МассивСсылок",МассивСсылок);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	КаталогГосУслугГосУслуги.Номенклатура,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА КаталогГосУслугГосУслуги.ЛицевойСчет = ЗНАЧЕНИЕ(Справочник.ЛицевыеСчета.ПустаяСсылка)
		|				ТОГДА КаталогГосУслугГосУслуги.Ссылка.ЛицевойСчет
		|			ИНАЧЕ КаталогГосУслугГосУслуги.ЛицевойСчет
		|		КОНЕЦ) КАК ЛицевойСчет,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА КаталогГосУслугГосУслуги.ЛицевойСчет = ЗНАЧЕНИЕ(Справочник.ЛицевыеСчета.ПустаяСсылка)
		|				ТОГДА КаталогГосУслугГосУслуги.Ссылка.РеквизитыЛицевогоСчета
		|			ИНАЧЕ КаталогГосУслугГосУслуги.РеквизитыЛицевогоСчета
		|		КОНЕЦ) КАК РеквизитЛС,
		|	КаталогГосУслугГосУслуги.Дата,
		|	КаталогГосУслугГосУслуги.Ссылка
		|ПОМЕСТИТЬ ВремТаб
		|ИЗ
		|	Документ.КаталогГосУслуг.ГосУслуги КАК КаталогГосУслугГосУслуги
		|ГДЕ
		|	КаталогГосУслугГосУслуги.Ссылка В (&МассивСсылок)
		|
		|СГРУППИРОВАТЬ ПО
		|	КаталогГосУслугГосУслуги.Номенклатура,
		|	КаталогГосУслугГосУслуги.Дата,
		|	КаталогГосУслугГосУслуги.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВремТаб.Номенклатура,
		|	МАКСИМУМ(ВремТаб.Дата) КАК Дата,
		|	ВремТаб.Ссылка
		|ПОМЕСТИТЬ ТаблицаДаты
		|ИЗ
		|	ВремТаб КАК ВремТаб
		|
		|СГРУППИРОВАТЬ ПО
		|	ВремТаб.Номенклатура,
		|	ВремТаб.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаДаты.Номенклатура,
		|	ВремТаб.ЛицевойСчет,
		|	ВремТаб.РеквизитЛС,
		|	ТаблицаДаты.Ссылка
		|ПОМЕСТИТЬ ДанныеКаталога
		|ИЗ
		|	ТаблицаДаты КАК ТаблицаДаты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВремТаб КАК ВремТаб
		|		ПО ТаблицаДаты.Номенклатура = ВремТаб.Номенклатура
		|			И ТаблицаДаты.Дата = ВремТаб.Дата
		|			И ТаблицаДаты.Ссылка = ВремТаб.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВложенныйЗапрос.ССЫЛКАДОКУМЕНТА,
		|	ВложенныйЗапрос.Период,
		|	Выразить(""ПЕРЕЧЕНЬГОСУСЛУГ"" КАК СТРОКА(1000)) КАК ИмяТабЧасти,
		|	ВложенныйЗапрос.Активная,
		|	ВложенныйЗапрос.ЛицевойСчет,
		|	ВложенныйЗапрос.РеквизитЛС,
		|	ВложенныйЗапрос.Наименование,
		|	ВложенныйЗапрос.Код,
		|	ВложенныйЗапрос.НаименованиеПолное,
		|	ВложенныйЗапрос.Стоимость,
		|	ВложенныйЗапрос.КПС,
		|	ВложенныйЗапрос.НачалоДействияКПС,
		|	ВложенныйЗапрос.КЭК,
		|	ВложенныйЗапрос.НастройкаХарактеристик,
		|	ВложенныйЗапрос.ЗначениеНастройки,
		|	ВложенныйЗапрос.КодОКАТО,
		|	ВложенныйЗапрос.ОГРН,
		|	ВложенныйЗапрос.ИНН,
		|	ВложенныйЗапрос.КПП,
		|	&Организация Как Организация
		|ИЗ
		|	(";
	НомДок = 1;	
	Для Каждого ЭлМас Из МассивСсылок Цикл	
		БлокДокумента = " ВЫБРАТЬ
			|       &Ссылка КАК ССЫЛКАДОКУМЕНТА,
			|		ХарактеристикиГосуслугСрезПоследних.Период КАК Период,
			|		""true"" КАК Активная,
			|		ДанныеКаталога.ЛицевойСчет КАК ЛицевойСчет,
			|		ДанныеКаталога.РеквизитЛС КАК РеквизитЛС,
			|		ХарактеристикиГосуслугСрезПоследних.Номенклатура.Наименование КАК Наименование,
			|		ХарактеристикиГосуслугСрезПоследних.Номенклатура.Код КАК Код,
			|		ХарактеристикиГосуслугСрезПоследних.Номенклатура.НаименованиеПолное КАК НаименованиеПолное,
			|		ХарактеристикиГосуслугСрезПоследних.Стоимость КАК Стоимость,
			|		ХарактеристикиГосуслугСрезПоследних.КПС КАК КПС,
			|		ХарактеристикиГосуслугСрезПоследних.КПС.ДатаНачалаДействия КАК НачалоДействияКПС,
			|		ХарактеристикиГосуслугСрезПоследних.КЭК КАК КЭК,
			|		ХарактеристикиГосуслугСрезПоследних.НастройкаДополнительныхХарактеристикНоменклатуры КАК НастройкаХарактеристик,
			|		ХарактеристикиГосуслугСрезПоследних.ЗначениеНастройки КАК ЗначениеНастройки,
			|		ХарактеристикиГосуслугСрезПоследних.КодОКАТО КАК КодОКАТО,
			|		Организации.ОГРН КАК ОГРН,
			|		Организации.ИНН КАК ИНН,
			|		Организации.КПП КАК КПП
			|	ИЗ
			|		РегистрСведений.ХарактеристикиГосуслуг.СрезПоследних(
			|				&ДатаДокумента,
			|				Номенклатура В
			|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
			|						ДанныеКаталога.Номенклатура
			|					ИЗ
			|						ДанныеКаталога КАК ДанныеКаталога
			|					ГДЕ
			|						ДанныеКаталога.Ссылка = &Ссылка)) КАК ХарактеристикиГосуслугСрезПоследних
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
			|			ПО (Организации.Ссылка = &Организация)
			|			ЛЕВОЕ СОЕДИНЕНИЕ ДанныеКаталога КАК ДанныеКаталога
			|			ПО (ДанныеКаталога.Ссылка = &Ссылка) 
			|				И ХарактеристикиГосуслугСрезПоследних.Номенклатура = ДанныеКаталога.Номенклатура
			|";
		ТекБлокДокумента = БлокДокумента;
		ТекБлокДокумента = СтрЗаменить(ТекБлокДокумента,"&ДатаДокумента","&ДатаДокумента_"+НомДок);
		ТекБлокДокумента = СтрЗаменить(ТекБлокДокумента,"&Ссылка","&Ссылка_"+НомДок);
		Запрос.УстановитьПараметр("ДатаДокумента_"+НомДок,ЭлМас.Дата);
