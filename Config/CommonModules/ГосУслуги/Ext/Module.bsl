КонецФункции

Функция ПроверитьИдентификаторПлательщикаДляГИСГМП_2_00(Плательщик,ТаблицаИдентификаторов,Дата) Экспорт
	
	СтруктураОтвета = Новый Структура("Результат,Текст,ПолеПроблемы",Ложь,"","");
	
	Если НЕ ЗначениеЗаполнено(Плательщик) Тогда
		СтруктураОтвета.Текст = НСтр("ru='Не заполнен плательщик'");
		СтруктураОтвета.ПолеПроблемы = "Контрагент";
		Возврат СтруктураОтвета;
	КонецЕсли;
	
	Если ТипЗнч(ТаблицаИдентификаторов)<>Тип("ТаблицаЗначений") Тогда
		СтруктураОтвета.Текст = НСтр("ru='На текущую дату не задана настройка использования идентификаторов плательщика.'");
		СтруктураОтвета.ПолеПроблемы = "Номенклатура";
		Возврат СтруктураОтвета;
	КонецЕсли;
	
	Если ТаблицаИдентификаторов.Количество()=0 Тогда
		СтруктураОтвета.Текст = НСтр("ru='В используемой настройке использования идентификаторов плательщика, нет используемых видов идентификаторов.'");
		СтруктураОтвета.ПолеПроблемы = "Номенклатура";
		Возврат СтруктураОтвета;
	КонецЕсли;
	
	//У юр. лица может быть только единый идентификатор
	//Если это юр. лицо и единый идентификатор есть в таблице, то попробуем его сформировать
	Если ТаблицаИдентификаторов.Найти(Справочники.ВидыАльтернативныхИдентификаторовПолучателейГосуслуг.ПустаяСсылка(),"ВидАльтИдентификатора")<>Неопределено Тогда
		ТекИдентификатор = СформироватьЕдиныйИдентификатор_1_16(Плательщик, Ложь);
		Если ЗначениеЗаполнено(ТекИдентификатор) Тогда
			СтруктураОтвета.Результат = Истина;
		КонецЕсли;
	КонецЕсли;
	
	//Нельзя для юр лиц альтернативные идентификаторы
	Если Плательщик.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
		Возврат СтруктураОтвета;
	КонецЕсли;
	
    //Заполняем идентификатор по таблице.
		
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаИдентификаторов.ВидАльтИдентификатора,
		|	ТаблицаИдентификаторов.Префикс,
		|	ТаблицаИдентификаторов.Порядок
		|ПОМЕСТИТЬ ВремТаб
		|ИЗ
		|	&ТаблицаИдентификаторов КАК ТаблицаИдентификаторов
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВремТаб.ВидАльтИдентификатора,
		|	ВремТаб.Префикс,
		|	ВремТаб.Порядок КАК Порядок,
		|	ЕСТЬNULL(АльтернативныеИдентификаторыПолучателейГосуслуг.АльтернативныйИдентификатор, """") КАК АльтернативныйИдентификатор,		
		|	ЕСТЬNULL(ДокументыФизическихЛицСрезПоследних.Серия, """") КАК Серия,
		|	ЕСТЬNULL(ДокументыФизическихЛицСрезПоследних.Номер, """") КАК Номер
		|ИЗ
		|	ВремТаб КАК ВремТаб
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АльтернативныеИдентификаторыПолучателейГосуслуг КАК АльтернативныеИдентификаторыПолучателейГосуслуг
		|		ПО ВремТаб.ВидАльтИдентификатора = АльтернативныеИдентификаторыПолучателейГосуслуг.ВидАльтернативногоИдентификатора
		|			И (АльтернативныеИдентификаторыПолучателейГосуслуг.ФизическоеЛицо = &ФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыФизическихЛиц.СрезПоследних КАК ДокументыФизическихЛицСрезПоследних
		|		ПО ВремТаб.Префикс = ДокументыФизическихЛицСрезПоследних.ВидДокумента.КодФК
		|			И (ДокументыФизическихЛицСрезПоследних.Физлицо = &ФизЛицо)	
		|
		|УПОРЯДОЧИТЬ ПО
		|	Порядок";
		
	ФизЛицо = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Плательщик,"ЮридическоеФизическоеЛицо");
	
