										КонецЕсли;
									КонецЕсли;
									//Максимальная сумма
									Если ВРег(ВложСтрокаКомиссии.ИмяВФайле) = ВРег("MaxValue") Тогда
										НовСтр.Комиссии__МаксСум = ВложСтрокаКомиссии.ЗначениеПоля;
										НовСтр.Комиссии__МаксСум_Использовать = НЕ (ВложСтрокаКомиссии.Отключить ИЛИ ВложСтрокаКомиссии.ПолеОтключеноРодителем);
										Если НовСтр.Комиссии__МаксСум_Использовать Тогда
											Для Каждого СтрокаМаксСум Из ВложСтрокаКомиссии.Строки Цикл
												Если ВРег(СтрокаМаксСум.ИмяВФайле) = ВРег("@currency") Тогда
													НовСтр.Комиссии__МаксСум_Валюта = СтрокаМаксСум.ЗначениеПоля;
													НовСтр.Комиссии__МаксСум_Валюта_Использовать = НЕ (СтрокаМаксСум.Отключить ИЛИ СтрокаМаксСум.ПолеОтключеноРодителем);
												ИначеЕсли ВРег(СтрокаМаксСум.ИмяВФайле) = ВРег("@exponent") Тогда
													НовСтр.Комиссии__МаксСум_КоличествоДробных = СтрокаМаксСум.ЗначениеПоля;
													НовСтр.Комиссии__МаксСум_КоличествоДробных_Использовать = НЕ (СтрокаМаксСум.Отключить ИЛИ СтрокаМаксСум.ПолеОтключеноРодителем);
												КонецЕсли;										
											КонецЦикла;	
										КонецЕсли;
									КонецЕсли;
								КонецЦикла;
								н = н + 1;
							КонецЕсли;				
						КонецЦикла;
					КонецЕсли;	
				ИначеЕсли ВРег(СтрокаДерева.ИмяВФайле) = ВРег("Regions") Тогда
					//Обход регионов
					СтрокаТЧ.Регионы_Использовать = ПолеИспользуется(СтрокаДерева);
					
					Если СтрокаТЧ.Регионы_Использовать И НомерОбхода = 2 Тогда
						н = 1;
						Для Каждого ВложеннаяСтрока ИЗ СтрокаДерева.Строки Цикл
							НовСтр = ОбщаяТаблица.Добавить();//ТаблицаРегионов.Добавить();
							ЗаполнитьЗначенияСвойств(НовСтр,СтрокаТЧ);
							НовСтр.НомерСтроки = н;
							НовСтр.НомерСтроки_ГЛ = ""+СтрокаТЧ.НомерСтроки_ГЛ+"__"+Строка(СтрокаТЧ.НомерСтроки);
							НовСтр.ИмяТабЧасти = "РЕГИОНЫ";
							НовСтр.ИмяТабЧасти_ГЛ = "ПЕРЕЧЕНЬГОСУСЛУГ";
							Для Каждого СтрокаРегиона ИЗ ВложеннаяСтрока.Строки Цикл
								Если ВРег(ВложеннаяСтрока.ИмяВФайле) = ВРег("@id") Тогда 
									НовСтр.Регионы__ИДРегиона = ВложеннаяСтрока.ЗначениеПоля;
								ИначеЕсли ВРег(ВложеннаяСтрока.ИмяВФайле) = ВРег("@name") Тогда 
									НовСтр.Регионы__Наименование = ВложеннаяСтрока.ЗначениеПоля;
								КонецЕсли;
							КонецЦикла;
							н = н + 1;
						КонецЦикла;		
					КонецЕсли;
				Иначе
					
				КонецЕсли;
				
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

//Дополняем KBK и SRV_CODE
Процедура ДополнитьСтрокуСлужебнымиПараметрами(СтрокаТЧ, ПрефиксКодаГосУслуги, КодСистемыИнициатора,ВерсияФорматов)
	ОбщаяТаблица = СтрокаТЧ.Владелец();

	СтрокаТЧ.Параметры_Использовать = Истина;
	
	ОтборСтрок = Новый Структура("ИмяТабЧасти,ИмяТабЧасти_ГЛ,НомерСтроки_ГЛ,ССЫЛКАДОКУМЕНТА","ПАРАМЕТРЫ","ПЕРЕЧЕНЬГОСУСЛУГ",""+СтрокаТЧ.НомерСтроки_ГЛ+"__"+Строка(СтрокаТЧ.НомерСтроки),СтрокаТЧ.ССЫЛКАДОКУМЕНТА);
	МассивСтрок = ОбщаяТаблица.НайтиСтроки(ОтборСтрок);
	КоличествоСтрок = МассивСтрок.Количество();
	
	НомерСтроки_ГЛ = ""+СтрокаТЧ.НомерСтроки_ГЛ+"__"+Строка(СтрокаТЧ.НомерСтроки);
	//SRV_CODE 
	//Требуется передавать для авансовых услуг, даже не смотря на то, что в форматах обмена об этом нет ни слова.
		
	НовСтр = ОбщаяТаблица.Добавить();
	ЗаполнитьЗначенияСвойств(НовСтр,СтрокаТЧ);
	
	НовСтр.НомерСтроки = КоличествоСтрок+1;
	КоличествоСтрок = КоличествоСтрок + 1;
	НовСтр.НомерСтроки_ГЛ = НомерСтроки_ГЛ;
	НовСтр.ИмяТабЧасти = "ПАРАМЕТРЫ";
	НовСтр.ИмяТабЧасти_ГЛ = "ПЕРЕЧЕНЬГОСУСЛУГ";	
	
