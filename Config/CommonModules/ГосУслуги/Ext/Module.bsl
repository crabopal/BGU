				КонецЕсли;
			ИначеЕсли ВыборкаДетальныеЗаписи.Префикс = "14" Тогда
				СНИЛС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ФизЛицо,"СтраховойНомерПФР");
				СНИЛС = СтрЗаменить(СНИЛС,"-","");
