	РезультирующаяТаблица.Колонки.Добавить("Параметры__ПолеКомплексногоПараметра__ЗначениеПоУмолчанию_Использовать", Новый ОписаниеТипов("Булево"));
	РезультирующаяТаблица.Колонки.Добавить("Параметры__ПолеКомплексногоПараметра__ПереченьЗначений");             //AllowedValues
	РезультирующаяТаблица.Колонки.Добавить("Параметры__ПолеКомплексногоПараметра__ПереченьЗначений_Использовать", Новый ОписаниеТипов("Булево"));
	
	//Колонки ТЧ Параметры__ПереченьЗначений
	РезультирующаяТаблица.Колонки.Добавить("Параметры__ПереченьЗначений__НаименованиеЗначения"); //@label
	РезультирующаяТаблица.Колонки.Добавить("Параметры__ПереченьЗначений__НаименованиеЗначения_Использовать", Новый ОписаниеТипов("Булево"));
	РезультирующаяТаблица.Колонки.Добавить("Параметры__ПереченьЗначений__ЗначениеВыбрано");      //@isSelected
	РезультирующаяТаблица.Колонки.Добавить("Параметры__ПереченьЗначений__ЗначениеВыбрано_Использовать", Новый ОписаниеТипов("Булево"));
	РезультирующаяТаблица.Колонки.Добавить("Параметры__ПереченьЗначений__Значение");		     //@data

	//Колонки ТЧ Параметры__ПолеКомплексногоПараметра__ПереченьЗначений
	РезультирующаяТаблица.Колонки.Добавить("Параметры__ПолеКомплексногоПараметра__ПереченьЗначений__НаименованиеЗначения"); //@label
	РезультирующаяТаблица.Колонки.Добавить("Параметры__ПолеКомплексногоПараметра__ПереченьЗначений__НаименованиеЗначения_Использовать", Новый ОписаниеТипов("Булево"));
	РезультирующаяТаблица.Колонки.Добавить("Параметры__ПолеКомплексногоПараметра__ПереченьЗначений__ЗначениеВыбрано");      //@isSelected
	РезультирующаяТаблица.Колонки.Добавить("Параметры__ПолеКомплексногоПараметра__ПереченьЗначений__ЗначениеВыбрано_Использовать", Новый ОписаниеТипов("Булево"));
	РезультирующаяТаблица.Колонки.Добавить("Параметры__ПолеКомплексногоПараметра__ПереченьЗначений__Значение");		     //@data
	
	//РеквизитыПлательщика = Новый Структура("НомерСчетаПлательщика, НаименованиеБанкаПлательщика, БикБанкаПлательщика, СчетБанкаПлательщика", "СчетНомер", "Банк", "БИК", "КоррСчет");
	//ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(ДокументСсылка.ЛицевойСчет, ДокументСсылка.РеквизитыЛицевогоСчета, РеквизитыПлательщика);

	Массив = Новый Массив;
	Массив.Добавить("ПрефиксКодаГосУслуги");
	Массив.Добавить("КодСистемыИнициатора");
	ДанныеПараметров = Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПолучитьПараметрыНастройкиОбмена(Массив,ЗаданиеСсылка.НастройкаОбмена);
	ПрефиксКодаГосУслуги = ДанныеПараметров.Получить("ПрефиксКодаГосУслуги");
	КодСистемыИнициатора = ДанныеПараметров.Получить("КодСистемыИнициатора");
		
	КоличествоСтрок = РезультирующаяТаблица.Количество();
	
	ПредДок = Неопределено;
	ПорядковыйНомер = 1;
	ТекОрганизация = Справочники.Организации.ПустаяСсылка();
	ВерсияФорматов = "";
	Для Инд = 0 По КоличествоСтрок-1 Цикл
		Если РезультирующаяТаблица[Инд].ССЫЛКАДОКУМЕНТА <> ПредДок Тогда 
			ПорядковыйНомер = 1;
			ПредДок = РезультирующаяТаблица[Инд].ССЫЛКАДОКУМЕНТА;
			ТекОрганизация = РезультирующаяТаблица[Инд].Организация;
			ВерсияФорматов = БиблиотекаФункцийОбмена.ПолучитьЗначениеТребуемойНастройкиОрганизация(ТекОрганизация,ЗаданиеСсылка.ВидОбмена,"ВерсияФорматов");			
		КонецЕсли;
		РезультирующаяТаблица[Инд].НомерСтроки = ПорядковыйНомер;
		РезультирующаяТаблица[Инд].ПОЛЕСВЯЗИ   = Истина;
		
		РеквизитыПлательщика = Новый Структура("НомерСчетаПлательщика, НаименованиеБанкаПлательщика, БикБанкаПлательщика, СчетБанкаПлательщика", "СчетНомер", "Банк", "БИК", "КоррСчет");
		ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(РезультирующаяТаблица[Инд].ЛицевойСчет, РезультирующаяТаблица[Инд].РеквизитЛС, РеквизитыПлательщика);

		КПСКод = "";
		Если ТипЗнч(РезультирующаяТаблица[Инд].НачалоДействияКПС) = Тип("Дата") Тогда
			КПСКод = ПолучитьКодБК(ТекОрганизация,РезультирующаяТаблица[Инд].КПС,РезультирующаяТаблица[Инд].КЭК,РезультирующаяТаблица[Инд].НачалоДействияКПС,Неопределено,РезультирующаяТаблица[Инд].ЛицевойСчет);
		КонецЕсли;	
		РезультирующаяТаблица[Инд].КодКПС = КПСКод;
		
		РезультирующаяТаблица[Инд].СчетНомер = РеквизитыПлательщика.НомерСчетаПлательщика;
        РезультирующаяТаблица[Инд].Банк = РеквизитыПлательщика.НаименованиеБанкаПлательщика;
        РезультирующаяТаблица[Инд].БИК = РеквизитыПлательщика.БикБанкаПлательщика;
		РезультирующаяТаблица[Инд].КоррСчет = РеквизитыПлательщика.СчетБанкаПлательщика;
		
		ДополнитьСтрокуПоНастройке(РезультирующаяТаблица[Инд]);
		ДополнитьСтрокуСлужебнымиПараметрами(РезультирующаяТаблица[Инд],ПрефиксКодаГосУслуги,КодСистемыИнициатора,ВерсияФорматов);
				
		ПорядковыйНомер = ПорядковыйНомер + 1;       
	КонецЦикла;		
	
    Возврат РезультирующаяТаблица;
	

КонецФункции

Функция ПолучитьТаблицуПакетаНачислений(ПакетыНачислений) Экспорт
	
	МассивСсылок = Новый Массив;
	
	Если ТипЗнч(ПакетыНачислений) = Тип("ДокументСсылка.ПакетНачислений") Тогда
		МассивСсылок.Добавить(ПакетыНачислений);
	Иначе
		МассивСсылок = ПакетыНачислений;
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПакетНачисленийСоставПакета.Ссылка КАК ССЫЛКАДОКУМЕНТА,
		|	ПакетНачисленийСоставПакета.Начисление КАК Начисление,
		|	ПакетНачисленийСоставПакета.НомерСтроки,
		|	ПакетНачисленийСоставПакета.ИдСущности,
		|	КвитанцияНаОплатуГосуслугТаблицаИдентификаторов.ИмяВФайле,
		|	КвитанцияНаОплатуГосуслугТаблицаИдентификаторов.ПолеИдентификатор,
		|	КвитанцияНаОплатуГосуслугТаблицаИдентификаторов.Ссылка.Номенклатура.Код КАК КодНоменклатуры
		|ИЗ
		|	Документ.ПакетНачислений.СоставПакета КАК ПакетНачисленийСоставПакета
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КвитанцияНаОплатуГосуслуг.ТаблицаИдентификаторов КАК КвитанцияНаОплатуГосуслугТаблицаИдентификаторов
		|		ПО ПакетНачисленийСоставПакета.Начисление = КвитанцияНаОплатуГосуслугТаблицаИдентификаторов.Ссылка
		|ГДЕ
		|	ПакетНачисленийСоставПакета.Ссылка В(&МассивСсылок)
		|ИТОГИ ПО
		|	ССЫЛКАДОКУМЕНТА,
		|	Начисление";
	
	Запрос.УстановитьПараметр("МассивСсылок", МассивСсылок);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаПакетов = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	РезультирующаяТаблица = Новый ТаблицаЗначений;
	
	РезультирующаяТаблица.Колонки.Добавить("ССЫЛКАДОКУМЕНТА");
	РезультирующаяТаблица.Колонки.Добавить("НомерСтроки");
	РезультирующаяТаблица.Колонки.Добавить("ПОЛЕСВЯЗИ");
	РезультирующаяТаблица.Колонки.Добавить("ИмяТабЧасти");
	
	//Общие колонки для вложенных ТЧ
	РезультирующаяТаблица.Колонки.Добавить("НомерСтроки_ГЛ", Новый ОписаниеТипов("Строка",Новый КвалификаторыСтроки(1000)));
	РезультирующаяТаблица.Колонки.Добавить("ИмяТабЧасти_ГЛ", Новый ОписаниеТипов("Строка",Новый КвалификаторыСтроки(1000)));
	
	РезультирующаяТаблица.Колонки.Добавить("Начисление");
	РезультирующаяТаблица.Колонки.Добавить("ИдСущности");
	РезультирующаяТаблица.Колонки.Добавить("ИмяВФайле");
	РезультирующаяТаблица.Колонки.Добавить("ПолеИдентификатор");
	
	Пока ВыборкаПакетов.Следующий() Цикл
		ВыборкаНачислений = ВыборкаПакетов.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаНачислений.Следующий() Цикл
			НовСтр = РезультирующаяТаблица.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр,ВыборкаНачислений,"ССЫЛКАДОКУМЕНТА,Начисление");
			НовСтр.ПолеСвязи = Истина;
			НовСтр.ИмяТабЧасти = "НАЧИСЛЕНИЯ";
			ВыборкаДетальныеЗаписи = ВыборкаНачислений.Выбрать();
			НомСтр = 1;
			
			КодНоменклатуры = "";
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				НовСтр.НомерСтроки = ВыборкаДетальныеЗаписи.НомерСтроки;
				НовСтр.ИдСущности = ВыборкаДетальныеЗаписи.ИдСущности;
				
				КодНоменклатуры = ВыборкаДетальныеЗаписи.КодНоменклатуры;
				
				Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ПолеИдентификатор) Тогда
					Продолжить;
				КонецЕсли;
				
				Если ВыборкаДетальныеЗаписи.ИмяВФайле = "UnifiedPayerIdentifier"
					ИЛИ ВыборкаДетальныеЗаписи.ИмяВФайле = "AltPayerIdentifier" Тогда
					Продолжить;
				КонецЕсли;
				
				ДопСтр = РезультирующаяТаблица.Добавить();
				ЗаполнитьЗначенияСвойств(ДопСтр,НовСтр);
				ДопСтр.НомерСтроки_ГЛ = "__"+НовСтр.НомерСтроки;
				ДопСтр.ИмяТабЧасти_ГЛ = НовСтр.ИмяТабЧасти;
				ДопСтр.ИмяТабЧасти = "ТАБЛИЦАДОПДАННЫХ";
				ДопСтр.НомерСтроки = НомСтр;
				
				ЗаполнитьЗначенияСвойств(ДопСтр,ВыборкаДетальныеЗаписи,"ИмяВФайле,ПолеИдентификатор");
				
				НомСтр = НомСтр + 1;
			КонецЦикла;
			
			ДопСтр = РезультирующаяТаблица.Добавить();
			ЗаполнитьЗначенияСвойств(ДопСтр,НовСтр);
			ДопСтр.НомерСтроки_ГЛ = "__"+НовСтр.НомерСтроки;
			ДопСтр.ИмяТабЧасти_ГЛ = НовСтр.ИмяТабЧасти;
			ДопСтр.ИмяТабЧасти = "ТАБЛИЦАДОПДАННЫХ";
			ДопСтр.НомерСтроки = НомСтр;
				
			ДопСтр.ИмяВФайле = "SRV_CODE";
			ДопСтр.ПолеИдентификатор = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(Прав(КодНоменклатуры,10),10);

		КонецЦикла;
	КонецЦикла;
	
	Возврат РезультирующаяТаблица;			
	
КонецФункции

Процедура ДополнитьСтрокуПоНастройке(СтрокаТЧ)
	
	ОбщаяТаблица = СтрокаТЧ.Владелец();
	
	ПолученноеЗначение = СтрокаТЧ.ЗначениеНастройки.Получить();
	Если ТипЗнч(ПолученноеЗначение) = Тип("Структура") Тогда
		ДеревоСНастройкой = ПолученноеЗначение.ДополнительныеХарактеристикиНоменклатуры;
		// Используется 2 обхода, т.к. за 1 обход заполняются простые поля, относящиеся к СтрокаТЧ, 
		// за 2 обход создаются новые строки, относящиеся к вложенным ТЧ
		//
		Для НомерОбхода = 1 По 2 Цикл
			Для Каждого СтрокаДерева Из ДеревоСНастройкой.Строки Цикл
				Если ВРег(СтрокаДерева.ИмяВФайле) = ВРег("@isActive") И НомерОбхода = 1 Тогда
					СтрокаТЧ.УслугаАктивна = СтрокаДерева.ЗначениеПоля; 
				ИначеЕсли ВРег(СтрокаДерева.ИмяВФайле) = ВРег("ServiceCategory") И НомерОбхода = 1 Тогда
					//Обход категории
					Для Каждого ВложеннаяСтрока ИЗ СтрокаДерева.Строки Цикл
						Если ВРег(ВложеннаяСтрока.ИмяВФайле) = ВРег("@code") Тогда 
							СтрокаТЧ.КодКатегории = ВложеннаяСтрока.ЗначениеПоля;		
						ИначеЕсли ВРег(ВложеннаяСтрока.ИмяВФайле) = ВРег("@name") Тогда 
							СтрокаТЧ.ИмяКатегории = ВложеннаяСтрока.ЗначениеПоля; 
						КонецЕсли;	
					КонецЦикла;
					
				ИначеЕсли ВРег(СтрокаДерева.ИмяВФайле) = ВРег("PaymentParameters") Тогда	
					//Обход параметров
					СтрокаТЧ.Параметры_Использовать = ПолеИспользуется(СтрокаДерева);
									
					Если СтрокаТЧ.Параметры_Использовать И НомерОбхода = 2 Тогда
						н = 1;
						Для Каждого СтрокаПараметров Из СтрокаДерева.Строки Цикл
							Если НЕ ПолеИспользуется(СтрокаПараметров) Тогда
								Продолжить;
							КонецЕсли;
							Если ВРег(СтрокаПараметров.ИмяВФайле) = ВРег("DescriptionSimpleParameter")
								ИЛИ ВРег(СтрокаПараметров.ИмяВФайле) = ВРег("DescriptionComplexParameter") Тогда
								ЭтоПростойПараметр = Истина;
								Если ВРег(СтрокаПараметров.ИмяВФайле) = ВРег("DescriptionComplexParameter") Тогда
	                                ЭтоПростойПараметр = Ложь;
								КонецЕсли;
								
								НовСтр = ОбщаяТаблица.Добавить();//ТаблицаПараметров.Добавить();
								ЗаполнитьЗначенияСвойств(НовСтр,СтрокаТЧ);
								НовСтр.НомерСтроки = н;
								НовСтр.НомерСтроки_ГЛ = ""+СтрокаТЧ.НомерСтроки_ГЛ+"__"+Строка(СтрокаТЧ.НомерСтроки);
								НовСтр.ИмяТабЧасти = "ПАРАМЕТРЫ";
								НовСтр.ИмяТабЧасти_ГЛ = "ПЕРЕЧЕНЬГОСУСЛУГ";
								
								НовСтр.Параметры__Параметры_Простые = ЭтоПростойПараметр;
								НомерПолейКомпл = 1;
								
								Для Каждого ДетальнаяСтрока Из СтрокаПараметров.Строки Цикл
								
									Если ВРег(ДетальнаяСтрока.ИмяВФайле) = ВРег("@name") Тогда	
										НовСтр.Параметры__ИмяПараметра = ДетальнаяСтрока.ЗначениеПоля;	
									ИначеЕсли ВРег(ДетальнаяСтрока.ИмяВФайле) = ВРег("@label") Тогда
										НовСтр.Параметры__ПредставлениеПараметра = ДетальнаяСтрока.ЗначениеПоля;
									ИначеЕсли ВРег(ДетальнаяСтрока.ИмяВФайле) = ВРег("@required") Тогда
										НовСтр.Параметры__Обязательный = ДетальнаяСтрока.ЗначениеПоля;
										НовСтр.Параметры__Обязательный_Использовать = ПолеИспользуется(ДетальнаяСтрока);
									ИначеЕсли ВРег(ДетальнаяСтрока.ИмяВФайле) = ВРег("@readonly") Тогда
										НовСтр.Параметры__ТолькоЧтение = ДетальнаяСтрока.ЗначениеПоля;
										НовСтр.Параметры__ТолькоЧтение_Использовать = ПолеИспользуется(ДетальнаяСтрока);	
									ИначеЕсли ВРег(ДетальнаяСтрока.ИмяВФайле) = ВРег("@isId") Тогда
										НовСтр.Параметры__ЭтоИдентификатор = ДетальнаяСтрока.ЗначениеПоля;
										НовСтр.Параметры__ЭтоИдентификатор_Использовать = ПолеИспользуется(ДетальнаяСтрока);
