					НомерПриведенный = "";
					Для инд = 1 по СтрДлина(ВыборкаДетальныеЗаписи.Номер) Цикл
						ТекСимвол = ВРег(Сред(ВыборкаДетальныеЗаписи.Номер,инд,1));
						Если Найти(СтрокаБуквЦифр,ТекСимвол)>0 Тогда
							НомерПриведенный = НомерПриведенный+ТекСимвол;
						КонецЕсли;
					КонецЦикла;
					
					СерияПриведенная = "";
					Для инд = 1 по СтрДлина(ВыборкаДетальныеЗаписи.Серия) Цикл
						ТекСимвол = ВРег(Сред(ВыборкаДетальныеЗаписи.Серия,инд,1));
