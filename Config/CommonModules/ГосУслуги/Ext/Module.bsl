					ТекИдентификатор = "121"+ СтроковыеФункцииКлиентСервер.ДополнитьСтроку(ИНН,19);
					Прервать;
				КонецЕсли;
			ИначеЕсли ВыборкаДетальныеЗаписи.Префикс = "14" Тогда
				//это идентификатор по СНИЛС для формата 1.16.1
				СНИЛС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ФизЛицо,"СтраховойНомерПФР");
				СНИЛС = СтрЗаменить(СНИЛС,"-","");
				СНИЛС = СтрЗаменить(СНИЛС," ","");
				Если ЗначениеЗаполнено(СНИЛС) Тогда
					ТекИдентификатор = "14"+ СтроковыеФункцииКлиентСервер.ДополнитьСтроку(СНИЛС,19);
					Прервать;
				КонецЕсли;	
			Иначе
				//Если это не идентификатор по ИНН, то пробуем его сформировать по серии и номеру документа и коду страны
				Если (ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Серия) 
					ИЛИ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Номер)) 
					И ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Префикс) Тогда
					
					НомерПриведенный = "";
					Для инд = 1 по СтрДлина(ВыборкаДетальныеЗаписи.Номер) Цикл
						ТекСимвол = ВРег(Сред(ВыборкаДетальныеЗаписи.Номер,инд,1));
						Если Найти(СтрокаБуквЦифр,ТекСимвол)>0 Тогда
							НомерПриведенный = НомерПриведенный+ТекСимвол;
						КонецЕсли;
					КонецЦикла;
					
					СерияПриведенная = "";
					Для инд = 1 по СтрДлина(ВыборкаДетальныеЗаписи.Серия) Цикл
						ТекСимвол = ВРег(Сред(ВыборкаДетальныеЗаписи.Серия,инд,1));
						Если Найти(СтрокаБуквЦифр,ТекСимвол)>0 Тогда
							СерияПриведенная = СерияПриведенная+ТекСимвол;
						КонецЕсли;
					КонецЦикла;
					Если ЗначениеЗаполнено(НомерПриведенный) ИЛИ ЗначениеЗаполнено(СерияПриведенная) Тогда 
						ТекИдентификатор = ВыборкаДетальныеЗаписи.Префикс + СтроковыеФункцииКлиентСервер.ДополнитьСтроку(СерияПриведенная+НомерПриведенный,19);
						Прервать;
					КонецЕсли;
				КонецЕсли;
					
			КонецЕсли;
		КонецЕсли;
		
		//Если идентификатор ранее был задан, то присвоим его и на этом закончим.
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.АльтернативныйИдентификатор) Тогда
			ТекИдентификатор = ВыборкаДетальныеЗаписи.АльтернативныйИдентификатор;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
		
	Если ЗначениеЗаполнено(ТекИдентификатор) Тогда
		СтруктураОтвета.Результат = Истина;
	КонецЕсли;
	
	Если СтруктураОтвета.Результат = Ложь Тогда
		СтруктураОтвета.Текст = НСтр("ru='По имеющимся настройкам и данным не удалось сформировать идентификатор плательщика.'");
		СтруктураОтвета.ПолеПроблемы = "Контрагент";
	КонецЕсли;
	
    УстановитьПривилегированныйРежим(Ложь);
	Возврат СтруктураОтвета;
КонецФункции



Функция ПроверитьИдентификаторПлательщикаДляГИСГМП(Плательщик,ТаблицаИдентификаторов,Дата) Экспорт
	
	СтруктураОтвета = Новый Структура("Результат,Текст,ПолеПроблемы",Ложь,"","");
	
	Если НЕ ЗначениеЗаполнено(Плательщик) Тогда
		СтруктураОтвета.Текст = НСтр("ru='Не заполнен плательщик'");
		СтруктураОтвета.ПолеПроблемы = "Контрагент";
		Возврат СтруктураОтвета;
	КонецЕсли;
	
	Если ТипЗнч(ТаблицаИдентификаторов)<>Тип("ТаблицаЗначений") Тогда
		СтруктураОтвета.Текст = НСтр("ru='На текущую дату не задана настройка использования идентификаторов плательщика.'");
		СтруктураОтвета.ПолеПроблемы = "Номенклатура";
		Возврат СтруктураОтвета;
	КонецЕсли;
	
	Если ТаблицаИдентификаторов.Количество()=0 Тогда
		СтруктураОтвета.Текст = НСтр("ru='В используемой настройке использования идентификаторов плательщика, нет используемых видов идентификаторов.'");
		СтруктураОтвета.ПолеПроблемы = "Номенклатура";
		Возврат СтруктураОтвета;
	КонецЕсли;
	
	//У юр. лица может быть только единый идентификатор
	//Если это юр. лицо и единый идентификатор есть в таблице, то попробуем его сформировать
	Если Плательщик.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо
		И ТаблицаИдентификаторов.Найти(Справочники.ВидыАльтернативныхИдентификаторовПолучателейГосуслуг.ПустаяСсылка(),"ВидАльтИдентификатора")<>Неопределено Тогда
		ТекИдентификатор = СформироватьЕдиныйИдентификатор(Плательщик, Ложь);
		Если ЗначениеЗаполнено(ТекИдентификатор) Тогда
			СтруктураОтвета.Результат = Истина;
		КонецЕсли;
		Возврат СтруктураОтвета;
	КонецЕсли;
	
    //Заполняем идентификатор по таблице.
		
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаИдентификаторов.ВидАльтИдентификатора,
		|	ТаблицаИдентификаторов.Префикс,
		|	ТаблицаИдентификаторов.Порядок
		|ПОМЕСТИТЬ ВремТаб
		|ИЗ
		|	&ТаблицаИдентификаторов КАК ТаблицаИдентификаторов
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(ГражданствоФизическихЛицСрезПоследних.Страна.Код, ""643"") КАК КодСтраны
		|ИЗ
		|	РегистрСведений.ГражданствоФизическихЛиц.СрезПоследних(&Дата, ФизическоеЛицо = &ФизЛицо) КАК ГражданствоФизическихЛицСрезПоследних
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВремТаб.ВидАльтИдентификатора,
		|	ВремТаб.Префикс,
		|	ВремТаб.Порядок КАК Порядок,
		|	ЕСТЬNULL(АльтернативныеИдентификаторыПолучателейГосуслуг.АльтернативныйИдентификатор, """") КАК АльтернативныйИдентификатор,		
		|	ЕСТЬNULL(ДокументыФизическихЛицСрезПоследних.Серия, """") КАК Серия,
		|	ЕСТЬNULL(ДокументыФизическихЛицСрезПоследних.Номер, """") КАК Номер
		|ИЗ
		|	ВремТаб КАК ВремТаб
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АльтернативныеИдентификаторыПолучателейГосуслуг КАК АльтернативныеИдентификаторыПолучателейГосуслуг
		|		ПО ВремТаб.ВидАльтИдентификатора = АльтернативныеИдентификаторыПолучателейГосуслуг.ВидАльтернативногоИдентификатора
		|			И (АльтернативныеИдентификаторыПолучателейГосуслуг.ФизическоеЛицо = &ФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыФизическихЛиц.СрезПоследних КАК ДокументыФизическихЛицСрезПоследних
		|		ПО ВремТаб.Префикс = ДокументыФизическихЛицСрезПоследних.ВидДокумента.КодФК
		|			И (ДокументыФизическихЛицСрезПоследних.Физлицо = &ФизЛицо)	
		|
		|УПОРЯДОЧИТЬ ПО
		|	Порядок";
		
	ФизЛицо = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Плательщик,"ЮридическоеФизическоеЛицо");
	
	Запрос.УстановитьПараметр("ТаблицаИдентификаторов", ТаблицаИдентификаторов);
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Плательщик", Плательщик);
	Запрос.УстановитьПараметр("ФизЛицо", ФизЛицо);

	Результат = Запрос.ВыполнитьПакет();

	КодСтраны = "643";
	ВыборкаГражданства = Результат[1].Выбрать();
	Если ВыборкаГражданства.Следующий() Тогда
		КодСтраны = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(ВыборкаГражданства.КодСтраны,3);
	КонецЕсли;
		
	//По форматам 1.15 ИС РНИП и ГИС ГМП следующие виды документов имеют суффикс 643
	МассивКодовФК_643 = Новый Массив;
	МассивКодовФК_643.Добавить("01");
	МассивКодовФК_643.Добавить("02");
	МассивКодовФК_643.Добавить("03");
	МассивКодовФК_643.Добавить("04");
	МассивКодовФК_643.Добавить("05");
	МассивКодовФК_643.Добавить("06");
	МассивКодовФК_643.Добавить("07");
	
	МассивКодовФК_643.Добавить("09");
	МассивКодовФК_643.Добавить("10");
	МассивКодовФК_643.Добавить("11");
	МассивКодовФК_643.Добавить("12");
	МассивКодовФК_643.Добавить("13");
	
	МассивКодовФК_643.Добавить("21");
	МассивКодовФК_643.Добавить("22");
	МассивКодовФК_643.Добавить("23");
	МассивКодовФК_643.Добавить("24");
	
	ВыборкаДетальныеЗаписи = Результат[2].Выбрать();

	ВидНовогоАльтИдентификатора = Неопределено;
	ТекИдентификатор = "";
	
	СтрокаБуквЦифр = "0123456789АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯABCDEFGHIJKLMNOPQRSTUVWXYZ";
	
	//Обходим результат по приоритету
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ВидАльтИдентификатора) Тогда
			//это единый идентификатор
			ТекИдентификатор = СформироватьЕдиныйИдентификаторФизЛица(Плательщик,Ложь);
			Если ЗначениеЗаполнено(ТекИдентификатор) Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;
		
		//Если префикс не заполнен, самостоятельно сформировать не сможем
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Префикс) Тогда
			
			Попытка
				Если МассивКодовФК_643.Найти(ВыборкаДетальныеЗаписи.Префикс)<>Неопределено Тогда 
					ТекКодСтраны = "643";
				Иначе
					ТекКодСтраны = КодСтраны;
				КонецЕсли;
			Исключение
				ТекКодСтраны = КодСтраны;
			КонецПопытки;
			
			//Если это не идентификатор по ИНН, то пробуем его сформировать по серии и номеру документа и коду страны
			Если ВыборкаДетальныеЗаписи.Префикс <> "21" Тогда
				Если (ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Серия) 
					ИЛИ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Номер)) 
					И ЗначениеЗаполнено(ТекКодСтраны)
					И ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Префикс) Тогда
					
					НомерПриведенный = "";
					Для инд = 1 по СтрДлина(ВыборкаДетальныеЗаписи.Номер) Цикл
						ТекСимвол = ВРег(Сред(ВыборкаДетальныеЗаписи.Номер,инд,1));
						Если Найти(СтрокаБуквЦифр,ТекСимвол)>0 Тогда
							НомерПриведенный = НомерПриведенный+ТекСимвол;
						КонецЕсли;
					КонецЦикла;
					
					СерияПриведенная = "";
					Для инд = 1 по СтрДлина(ВыборкаДетальныеЗаписи.Серия) Цикл
						ТекСимвол = ВРег(Сред(ВыборкаДетальныеЗаписи.Серия,инд,1));
						Если Найти(СтрокаБуквЦифр,ТекСимвол)>0 Тогда
							СерияПриведенная = СерияПриведенная+ТекСимвол;
						КонецЕсли;
					КонецЦикла;
					Если ЗначениеЗаполнено(НомерПриведенный) ИЛИ ЗначениеЗаполнено(СерияПриведенная) Тогда 
						ТекИдентификатор = ВыборкаДетальныеЗаписи.Префикс + СтроковыеФункцииКлиентСервер.ДополнитьСтроку(СерияПриведенная+НомерПриведенный,20) + ТекКодСтраны;
						Прервать;
					КонецЕсли;
				КонецЕсли;
			Иначе
				//это идентификатор по ИНН
				ИНН = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ФизЛицо,"ИНН");
				Если ЗначениеЗаполнено(ИНН) И ЗначениеЗаполнено(ТекКодСтраны) Тогда
					ТекИдентификатор = "21"+ СтроковыеФункцииКлиентСервер.ДополнитьСтроку(ИНН,20) + ТекКодСтраны;
					Прервать;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		//Если идентификатор ранее был задан, то присвоим его и на этом закончим.
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.АльтернативныйИдентификатор) Тогда
			ТекИдентификатор = ВыборкаДетальныеЗаписи.АльтернативныйИдентификатор;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ТекИдентификатор) Тогда
		СтруктураОтвета.Результат = Истина;
	КонецЕсли;
	
	Если СтруктураОтвета.Результат = Ложь Тогда
		СтруктураОтвета.Текст = НСтр("ru='По имеющимся настройкам и данным не удалось сформировать идентификатор плательщика.'");
		СтруктураОтвета.ПолеПроблемы = "Контрагент";
	КонецЕсли;
	
    УстановитьПривилегированныйРежим(Ложь);
	Возврат СтруктураОтвета;
КонецФункции

Функция ПроверитьИдентификаторПлательщикаДляГИСГМП_1_16(Плательщик,ТаблицаИдентификаторов,Дата) Экспорт
	
	СтруктураОтвета = Новый Структура("Результат,Текст,ПолеПроблемы",Ложь,"","");
	
	Если НЕ ЗначениеЗаполнено(Плательщик) Тогда
		СтруктураОтвета.Текст = НСтр("ru='Не заполнен плательщик'");
		СтруктураОтвета.ПолеПроблемы = "Контрагент";
		Возврат СтруктураОтвета;
	КонецЕсли;
	
	Если ТипЗнч(ТаблицаИдентификаторов)<>Тип("ТаблицаЗначений") Тогда
		СтруктураОтвета.Текст = НСтр("ru='На текущую дату не задана настройка использования идентификаторов плательщика.'");
		СтруктураОтвета.ПолеПроблемы = "Номенклатура";
		Возврат СтруктураОтвета;
	КонецЕсли;
	
	Если ТаблицаИдентификаторов.Количество()=0 Тогда
		СтруктураОтвета.Текст = НСтр("ru='В используемой настройке использования идентификаторов плательщика, нет используемых видов идентификаторов.'");
		СтруктураОтвета.ПолеПроблемы = "Номенклатура";
		Возврат СтруктураОтвета;
	КонецЕсли;
	
	//У юр. лица может быть только единый идентификатор
	//Если это юр. лицо и единый идентификатор есть в таблице, то попробуем его сформировать
	Если ТаблицаИдентификаторов.Найти(Справочники.ВидыАльтернативныхИдентификаторовПолучателейГосуслуг.ПустаяСсылка(),"ВидАльтИдентификатора")<>Неопределено Тогда
		ТекИдентификатор = СформироватьЕдиныйИдентификатор_1_16(Плательщик, Ложь);
		Если ЗначениеЗаполнено(ТекИдентификатор) Тогда
			СтруктураОтвета.Результат = Истина;
		КонецЕсли;
	КонецЕсли;
	
	//Нельзя для юр лиц альтернативные идентификаторы
	Если Плательщик.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
		Возврат СтруктураОтвета;
	КонецЕсли;
	
    //Заполняем идентификатор по таблице.
		
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаИдентификаторов.ВидАльтИдентификатора,
		|	ТаблицаИдентификаторов.Префикс,
		|	ТаблицаИдентификаторов.Порядок
		|ПОМЕСТИТЬ ВремТаб
		|ИЗ
		|	&ТаблицаИдентификаторов КАК ТаблицаИдентификаторов
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(ГражданствоФизическихЛицСрезПоследних.Страна.Код, ""643"") КАК КодСтраны
		|ИЗ
		|	РегистрСведений.ГражданствоФизическихЛиц.СрезПоследних(&Дата, ФизическоеЛицо = &ФизЛицо) КАК ГражданствоФизическихЛицСрезПоследних
		|;
		|////////////////////////////////////////////////////////////////////////////////
