// Процедуры для группового формирования квитанций

Функция ПолучитьНалоговыеРеквизитыНачисленияДоходов(Ссылка, ИДСтроки) Экспорт
	
	ТаблицаВсехСтрок = ГосУслугиПовтИсп.ВернутьТаблицуНалоговыхРеквизитовПоДокументу(Ссылка);
	
	СтруктураВозвращаемыхДанных = Новый Структура("ПоказательДаты,ПоказательНомера,ПоказательОснования,ПоказательПериода,ПоказательТипа,СтатусСоставителя,КодБКПлатежа,КодОКАТО");
	
	ИскомаяСтрока = ТаблицаВсехСтрок.Найти(ИДСтроки, "ИДСтроки");
	
	Если ИскомаяСтрока<>Неопределено Тогда
		ЗаполнитьЗначенияСвойств(СтруктураВозвращаемыхДанных,ИскомаяСтрока);
	КонецЕсли;
	
	Возврат СтруктураВозвращаемыхДанных;
	
КонецФункции

Функция ПолучитьКПСКЭКПоТЧДокументаНачисления(Ссылка, ИДСтроки) Экспорт
	
	ТаблицаВсехСтрок = ГосУслугиПовтИсп.ВернутьТаблицуКПСКЭКПоДокументу(Ссылка);
	
	СтруктураВозвращаемыхДанных = Новый Структура("КПС,КЭК,НачалоДействияКПС");
	
	ИскомаяСтрока = ТаблицаВсехСтрок.Найти(ИДСтроки, "ИДСтроки");
	
	Если ИскомаяСтрока<>Неопределено Тогда
		ЗаполнитьЗначенияСвойств(СтруктураВозвращаемыхДанных,ИскомаяСтрока);
	КонецЕсли;
	
	Возврат СтруктураВозвращаемыхДанных;
	
КонецФункции

Функция ПолучитьКодБК(Организация, КПС = Неопределено, КЭК = Неопределено, ДатаНачалаКПС, ИФО = Неопределено, Лицевойсчет = Неопределено) Экспорт
	
	КодБК = "";
	
	Если НЕ ЗначениеЗаполнено(ДатаНачалаКПС) Тогда
		Возврат "";
	КонецЕсли;
	
	Если ДатаНачалаКПС < Дата(2016, 1, 1) Тогда
		
		Если ЗначениеЗаполнено(КЭК) Тогда
			КодБК = ?(ЗначениеЗаполнено(КПС), КПС.Код, "00000000000000000") + КЭК.Код;
		ИначеЕсли ЗначениеЗаполнено(КПС) Тогда
			КодБК = КПС.Код + "000";
		КонецЕсли;
		
		Возврат КодБК
		
	КонецЕсли;
	
	КодГлавы = Неопределено;
	КодКПС = Неопределено;
	
	Если ЗначениеЗаполнено(Лицевойсчет) И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Лицевойсчет, "НеВыводитьКодГлавы") = Истина Тогда
		КодГлавы = "000";
	КонецЕсли;
	
	Если КодГлавы = Неопределено И ЗначениеЗаполнено(ИФО) И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ИФО, "ИспользоватьРеквизитыИФО") = Истина Тогда
		Глава = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ИФО, "КодГлавыБК.Код"); 
		КодГлавы = ?(ЗначениеЗаполнено(Глава), Глава, "000");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(КодГлавы) Тогда
		Если ЗначениеЗаполнено(Организация) Тогда
			Глава = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "КодПоППП.Код"); 
			КодГлавы = ?(ЗначениеЗаполнено(Глава), Глава, "000");
		Иначе
			КодГлавы = "000";
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КПС) Тогда
		
		Если КПС.ВидПоказателя = ПредопределенноеЗначение("Перечисление.ВидыКБК.АУИБУ") Тогда
			Если ЗначениеЗаполнено(Лицевойсчет) Тогда
				
				РеквизитыЛС = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Лицевойсчет, "НеВыводитьРазделПодраздел,НеВыводитьАналитическийКод"); 
				
				Если РеквизитыЛС.НеВыводитьАналитическийКод = Истина Тогда
					АКод = "0000000000";
				Иначе
					АКод = Сред(КПС.Код, 5, 10);
				КонецЕсли;
				
				Если РеквизитыЛС.НеВыводитьРазделПодраздел = Истина Тогда
					РПКод = "0000";
				Иначе
					РПКод = Сред(КПС.Код, 1, 4);
				КонецЕсли;
				
				КодКПС = РПКод + АКод + Сред(КПС.Код, 15, 3);
				
			Иначе
				//Без настроек ЛС формируем по умолчанию без аналитического кода
				КодКПС = Сред(КПС.Код, 1, 4) + "0000000000" + Сред(КПС.Код, 15, 3);
			КонецЕсли;
		Иначе
			КодКПС = КПС.Код;
		КонецЕсли;
		
	Иначе
		КодКПС = "00000000000000000";
	КонецЕсли;
	
	Возврат КодГлавы + КодКПС;
	
КонецФункции	

