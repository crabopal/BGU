// Формирование идентификатора плательщика	

Функция ПолучитьНастройкуИспользуемыхИдентификаторов(Номенклатура,Дата) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НастройкаИспользованияИдентификаторовПлательщика.ВидАльтИдентификатора,
		|	НастройкаИспользованияИдентификаторовПлательщика.Порядок КАК Порядок,
		|	НастройкаИспользованияИдентификаторовПлательщика.ВидАльтИдентификатора.Префикс КАК Префикс
		|ИЗ
		|	РегистрСведений.НастройкаИспользованияИдентификаторовПлательщика КАК НастройкаИспользованияИдентификаторовПлательщика
		|ГДЕ
		|	НастройкаИспользованияИдентификаторовПлательщика.Использовать = ИСТИНА
		|	И НастройкаИспользованияИдентификаторовПлательщика.Номенклатура = &Номенклатура
		|	И НастройкаИспользованияИдентификаторовПлательщика.Период = &Дата
		|
		|УПОРЯДОЧИТЬ ПО
		|	Порядок";

	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);

	Результат = Запрос.Выполнить();
    Возврат Результат;
	
КонецФункции

#Область ФормированиеИдентификаторовПоФормату_1_15

//Параметры:
// ТаблицаИдентификаторов - ТаблицаЗначений;
//  Колонки: 
//   "ВидАльтИдентификатора" - ссылка на справочник ВидыАльтернативныхИдентификаторовПолучателейГосуслуг, если не заполнен, то единый идентификатор 
//   "Префикс" - префикс вида альтернативного идентификатора, если заполнен, то можно смотреть по РС ДокументыФизическихЛиц, с аналогичным префиксом у ВидаДокумента
//   "Порядок" - приоритет использования идентификаторов, чем меньше, тем главнее.
//
// Квитанция - ДокументОбъект.КвитанцияНаОплатуГосуслуг
//
Процедура ЗаполнитьИдентификаторПлательщикаДляГИСГМП(Квитанция,ТаблицаИдентификаторов,Дата = Неопределено) Экспорт
	
	НастройкиОрганизации = БиблиотекаФункцийОбмена.ПолучитьНастройкиОрганизации(Квитанция.Организация);
	Если НастройкиОрганизации.ВерсияФорматов = "2.00" Тогда
		//заполним идентификатор по форматам 2.00
		ЗаполнитьИдентификаторыПлательщикаДляГИСГМП_2_00(Квитанция,ТаблицаИдентификаторов,Дата);
		Возврат;
	ИначеЕсли НастройкиОрганизации.ВерсияФорматов = "1.16" Тогда
		//заполним идентификатор по форматам 1.16
		ЗаполнитьИдентификаторПлательщикаДляГИСГМП_1_16(Квитанция,ТаблицаИдентификаторов,Дата);
		Возврат;
	КонецЕсли;
	
	Плательщик = Квитанция.Плательщик;
	Если НЕ ЗначениеЗаполнено(Плательщик) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ТаблицаИдентификаторов)<>Тип("ТаблицаЗначений") Тогда
		Возврат;
	КонецЕсли;
	
	Если ТаблицаИдентификаторов.Количество()=0 Тогда
		Возврат;
	КонецЕсли;
	
	//У юр. лица может быть только единый идентификатор
	//Если это юр. лицо и единый идентификатор есть в таблице, то попробуем его сформировать
	Если Плательщик.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо
		И ТаблицаИдентификаторов.Найти(Справочники.ВидыАльтернативныхИдентификаторовПолучателейГосуслуг.ПустаяСсылка(),"ВидАльтИдентификатора")<>Неопределено Тогда
		Квитанция.ЕдиныйИдентификаторПлательщика = СформироватьЕдиныйИдентификатор(Плательщик, Ложь);
		Возврат;
	КонецЕсли;
	
    //Заполняем идентификатор по таблице.
	
	Если Дата=Неопределено Тогда
		Дата = Квитанция.Дата;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаИдентификаторов.ВидАльтИдентификатора,
		|	ТаблицаИдентификаторов.Префикс,
		|	ТаблицаИдентификаторов.Порядок
		|ПОМЕСТИТЬ ВремТаб
		|ИЗ
		|	&ТаблицаИдентификаторов КАК ТаблицаИдентификаторов
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(ГражданствоФизическихЛицСрезПоследних.Страна.Код, ""643"") КАК КодСтраны
		|ИЗ
		|	РегистрСведений.ГражданствоФизическихЛиц.СрезПоследних(&Дата, ФизическоеЛицо = &ФизЛицо) КАК ГражданствоФизическихЛицСрезПоследних
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВремТаб.ВидАльтИдентификатора,
		|	ВремТаб.Префикс,
		|	ВремТаб.Порядок КАК Порядок,
		|	ЕСТЬNULL(АльтернативныеИдентификаторыПолучателейГосуслуг.АльтернативныйИдентификатор, """") КАК АльтернативныйИдентификатор,		
		|	ЕСТЬNULL(ДокументыФизическихЛицСрезПоследних.Серия, """") КАК Серия,
		|	ЕСТЬNULL(ДокументыФизическихЛицСрезПоследних.Номер, """") КАК Номер
		|ИЗ
		|	ВремТаб КАК ВремТаб
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АльтернативныеИдентификаторыПолучателейГосуслуг КАК АльтернативныеИдентификаторыПолучателейГосуслуг
		|		ПО ВремТаб.ВидАльтИдентификатора = АльтернативныеИдентификаторыПолучателейГосуслуг.ВидАльтернативногоИдентификатора
		|			И (АльтернативныеИдентификаторыПолучателейГосуслуг.ФизическоеЛицо = &ФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыФизическихЛиц.СрезПоследних КАК ДокументыФизическихЛицСрезПоследних
		|		ПО ВремТаб.Префикс = ДокументыФизическихЛицСрезПоследних.ВидДокумента.КодФК
		|			И (ДокументыФизическихЛицСрезПоследних.Физлицо = &ФизЛицо)	
		|
		|УПОРЯДОЧИТЬ ПО
		|	Порядок";
		
	ФизЛицо = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Плательщик,"ЮридическоеФизическоеЛицо");
	
	Запрос.УстановитьПараметр("ТаблицаИдентификаторов", ТаблицаИдентификаторов);
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Плательщик", Плательщик);
	Запрос.УстановитьПараметр("ФизЛицо", ФизЛицо);

	Результат = Запрос.ВыполнитьПакет();

	КодСтраны = "643";
	ВыборкаГражданства = Результат[1].Выбрать();
	Если ВыборкаГражданства.Следующий() Тогда
		КодСтраны = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(ВыборкаГражданства.КодСтраны,3);
	КонецЕсли;
	
	//По форматам 1.15 ИС РНИП и ГИС ГМП следующие виды документов имеют суффикс 643
	МассивКодовФК_643 = Новый Массив;
	МассивКодовФК_643.Добавить("01");
	МассивКодовФК_643.Добавить("02");
	МассивКодовФК_643.Добавить("03");
	МассивКодовФК_643.Добавить("04");
	МассивКодовФК_643.Добавить("05");
	МассивКодовФК_643.Добавить("06");
	МассивКодовФК_643.Добавить("07");
	
	МассивКодовФК_643.Добавить("09");
	МассивКодовФК_643.Добавить("10");
	МассивКодовФК_643.Добавить("11");
	МассивКодовФК_643.Добавить("12");
	МассивКодовФК_643.Добавить("13");
	
	МассивКодовФК_643.Добавить("21");
	МассивКодовФК_643.Добавить("22");
	МассивКодовФК_643.Добавить("23");
	МассивКодовФК_643.Добавить("24");
	
	ВыборкаДетальныеЗаписи = Результат[2].Выбрать();

	ВидНовогоАльтИдентификатора = Неопределено;
	НовыйАльтИдентификатор = "";
	
	СтрокаБуквЦифр = "0123456789АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯABCDEFGHIJKLMNOPQRSTUVWXYZ";
	
	//Обходим результат по приоритету
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ВидАльтИдентификатора) Тогда
			//это единый идентификатор
			ТекИдентификатор = СформироватьЕдиныйИдентификаторФизЛица(Плательщик,Ложь);
			Если ЗначениеЗаполнено(ТекИдентификатор) Тогда
				Квитанция.ЕдиныйИдентификаторПлательщика = ТекИдентификатор;
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		//Если префикс не заполнен, самостоятельно сформировать не сможем
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Префикс) Тогда
			
			Попытка
				Если МассивКодовФК_643.Найти(ВыборкаДетальныеЗаписи.Префикс)<>Неопределено Тогда 
					ТекКодСтраны = "643";
				Иначе
					ТекКодСтраны = КодСтраны;
				КонецЕсли;
			Исключение
				ТекКодСтраны = КодСтраны;
			КонецПопытки;
			
			//Если это не идентификатор по ИНН, то пробуем его сформировать по серии и номеру документа и коду страны
			Если ВыборкаДетальныеЗаписи.Префикс <> "21" Тогда
				Если (ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Серия) 
					ИЛИ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Номер)) 
					И ЗначениеЗаполнено(ТекКодСтраны)
					И ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Префикс) Тогда
					
					НомерПриведенный = "";
					Для инд = 1 по СтрДлина(ВыборкаДетальныеЗаписи.Номер) Цикл
						ТекСимвол = ВРег(Сред(ВыборкаДетальныеЗаписи.Номер,инд,1));
						Если Найти(СтрокаБуквЦифр,ТекСимвол)>0 Тогда
							НомерПриведенный = НомерПриведенный+ТекСимвол;
						КонецЕсли;
					КонецЦикла;
					
					СерияПриведенная = "";
					Для инд = 1 по СтрДлина(ВыборкаДетальныеЗаписи.Серия) Цикл
						ТекСимвол = ВРег(Сред(ВыборкаДетальныеЗаписи.Серия,инд,1));
						Если Найти(СтрокаБуквЦифр,ТекСимвол)>0 Тогда
							СерияПриведенная = СерияПриведенная+ТекСимвол;
						КонецЕсли;
					КонецЦикла;
					Если ЗначениеЗаполнено(НомерПриведенный) ИЛИ ЗначениеЗаполнено(СерияПриведенная) Тогда 
						ВидНовогоАльтИдентификатора = ВыборкаДетальныеЗаписи.ВидАльтИдентификатора;
						НовыйАльтИдентификатор = ВыборкаДетальныеЗаписи.Префикс + СтроковыеФункцииКлиентСервер.ДополнитьСтроку(СерияПриведенная+НомерПриведенный,20) + ТекКодСтраны;
						Квитанция.АльтернативныйИдентификаторПлательщика = НовыйАльтИдентификатор;
						Прервать;
					КонецЕсли;
				КонецЕсли;
			Иначе
				//это идентификатор по ИНН
				ИНН = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ФизЛицо,"ИНН");
				Если ЗначениеЗаполнено(ИНН) И ЗначениеЗаполнено(ТекКодСтраны) Тогда
					ВидНовогоАльтИдентификатора = ВыборкаДетальныеЗаписи.ВидАльтИдентификатора;
					НовыйАльтИдентификатор = "21"+ СтроковыеФункцииКлиентСервер.ДополнитьСтроку(ИНН,20) + ТекКодСтраны;
					Квитанция.АльтернативныйИдентификаторПлательщика = НовыйАльтИдентификатор;
					Прервать;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.АльтернативныйИдентификатор) Тогда
			Квитанция.АльтернативныйИдентификаторПлательщика = ВыборкаДетальныеЗаписи.АльтернативныйИдентификатор;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ЗначениеЗаполнено(ВидНовогоАльтИдентификатора) 
		И ЗначениеЗаполнено(НовыйАльтИдентификатор) Тогда		
		НовЗапись = РегистрыСведений.АльтернативныеИдентификаторыПолучателейГосуслуг.СоздатьМенеджерЗаписи();
		НовЗапись.ФизическоеЛицо = ФизЛицо;
		НовЗапись.ВидАльтернативногоИдентификатора = ВидНовогоАльтИдентификатора;
		НовЗапись.АльтернативныйИдентификатор = НовыйАльтИдентификатор;
		НовЗапись.Записать();	
	КонецЕсли;
	
    УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

Функция ЗаполнитьОдинИдентификаторПлательщика(Плательщик,ВидИдентификатора,Дата) Экспорт
	
	СтруктураОтвета = Новый Структура("Результат,Текст,Идентификатор",Ложь,"","");
	
	Если НЕ ЗначениеЗаполнено(Плательщик) Тогда
		СтруктураОтвета.Текст = НСтр("ru='Не заполнен плательщик'");
		Возврат СтруктураОтвета;
	КонецЕсли;
	
	Если ВидИдентификатора = Справочники.ВидыАльтернативныхИдентификаторовПолучателейГосуслуг.ПустаяСсылка() Тогда
		ТекИдентификатор = СформироватьЕдиныйИдентификатор(Плательщик, Ложь);
		Если ЗначениеЗаполнено(ТекИдентификатор) Тогда
			СтруктураОтвета.Идентификатор = ТекИдентификатор;
			СтруктураОтвета.Результат = Истина;
		КонецЕсли;
		Возврат СтруктураОтвета;
	КонецЕсли;
	
	//Нельзя для юр лиц альтернативные идентификаторы
	Если Плательщик.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
		Возврат СтруктураОтвета;
	КонецЕсли;
	
    //Заполняем идентификатор по таблице.
		
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВидыАльтернативныхИдентификаторовПолучателейГосуслуг.Префикс,
		|	ВидыАльтернативныхИдентификаторовПолучателейГосуслуг.Ссылка КАК ВидАльтИдентификатора
		|ПОМЕСТИТЬ ВремТаб
		|ИЗ
		|	Справочник.ВидыАльтернативныхИдентификаторовПолучателейГосуслуг КАК ВидыАльтернативныхИдентификаторовПолучателейГосуслуг
		|ГДЕ
		|	ВидыАльтернативныхИдентификаторовПолучателейГосуслуг.Ссылка = &ВидИдентификатора
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(ГражданствоФизическихЛицСрезПоследних.Страна.Код, ""643"") КАК КодСтраны
		|ИЗ
		|	РегистрСведений.ГражданствоФизическихЛиц.СрезПоследних(&Дата, ФизическоеЛицо = &ФизЛицо) КАК ГражданствоФизическихЛицСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВремТаб.ВидАльтИдентификатора,
		|	ВремТаб.Префикс,
		|	ЕСТЬNULL(АльтернативныеИдентификаторыПолучателейГосуслуг.АльтернативныйИдентификатор, """") КАК АльтернативныйИдентификатор,
		|	ЕСТЬNULL(ДокументыФизическихЛицСрезПоследних.Серия, """") КАК Серия,
		|	ЕСТЬNULL(ДокументыФизическихЛицСрезПоследних.Номер, """") КАК Номер
		|ИЗ
		|	ВремТаб КАК ВремТаб
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АльтернативныеИдентификаторыПолучателейГосуслуг КАК АльтернативныеИдентификаторыПолучателейГосуслуг
		|		ПО ВремТаб.ВидАльтИдентификатора = АльтернативныеИдентификаторыПолучателейГосуслуг.ВидАльтернативногоИдентификатора
		|			И (АльтернативныеИдентификаторыПолучателейГосуслуг.ФизическоеЛицо = &ФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыФизическихЛиц.СрезПоследних КАК ДокументыФизическихЛицСрезПоследних
		|		ПО ВремТаб.Префикс = ДокументыФизическихЛицСрезПоследних.ВидДокумента.КодФК
		|			И (ДокументыФизическихЛицСрезПоследних.Физлицо = &ФизЛицо)";
		
	ФизЛицо = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Плательщик,"ЮридическоеФизическоеЛицо");
	
	Запрос.УстановитьПараметр("ВидИдентификатора", ВидИдентификатора);
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Плательщик", Плательщик);
	Запрос.УстановитьПараметр("ФизЛицо", ФизЛицо);

	Результат = Запрос.ВыполнитьПакет();

	КодСтраны = "643";
	ВыборкаГражданства = Результат[1].Выбрать();
	Если ВыборкаГражданства.Следующий() Тогда
		КодСтраны = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(ВыборкаГражданства.КодСтраны,3);
	КонецЕсли;
	
	//По форматам 1.15 ИС РНИП и ГИС ГМП следующие виды документов имеют суффикс 643	
	МассивКодовФК_643 = Новый Массив;
	МассивКодовФК_643.Добавить("01");
	МассивКодовФК_643.Добавить("02");
	МассивКодовФК_643.Добавить("03");
	МассивКодовФК_643.Добавить("04");
	МассивКодовФК_643.Добавить("05");
	МассивКодовФК_643.Добавить("06");
	МассивКодовФК_643.Добавить("07");
	
	МассивКодовФК_643.Добавить("09");
	МассивКодовФК_643.Добавить("10");
	МассивКодовФК_643.Добавить("11");
	МассивКодовФК_643.Добавить("12");
	МассивКодовФК_643.Добавить("13");
	
	МассивКодовФК_643.Добавить("21");
	МассивКодовФК_643.Добавить("22");
	МассивКодовФК_643.Добавить("23");
	МассивКодовФК_643.Добавить("24");
	
	ВыборкаДетальныеЗаписи = Результат[2].Выбрать();

	ТекИдентификатор = "";
	
	СтрокаБуквЦифр = "0123456789АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯABCDEFGHIJKLMNOPQRSTUVWXYZ";
	
	//Обходим результат по приоритету
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
		//Если префикс не заполнен, самостоятельно сформировать не сможем
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Префикс) Тогда
		
			Попытка
				Если МассивКодовФК_643.Найти(ВыборкаДетальныеЗаписи.Префикс)<>Неопределено Тогда 
					ТекКодСтраны = "643";
				Иначе
					ТекКодСтраны = КодСтраны;
				КонецЕсли;
			Исключение
				ТекКодСтраны = КодСтраны;
			КонецПопытки;
			
			//Если это не идентификатор по ИНН, то пробуем его сформировать по серии и номеру документа и коду страны
			Если ВыборкаДетальныеЗаписи.Префикс <> "21" Тогда
				Если (ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Серия) 
					ИЛИ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Номер)) 
					И ЗначениеЗаполнено(ТекКодСтраны)
					И ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Префикс) Тогда
					
					НомерПриведенный = "";
					Для инд = 1 по СтрДлина(ВыборкаДетальныеЗаписи.Номер) Цикл
						ТекСимвол = ВРег(Сред(ВыборкаДетальныеЗаписи.Номер,инд,1));
						Если Найти(СтрокаБуквЦифр,ТекСимвол)>0 Тогда
							НомерПриведенный = НомерПриведенный+ТекСимвол;
						КонецЕсли;
					КонецЦикла;
					
					СерияПриведенная = "";
					Для инд = 1 по СтрДлина(ВыборкаДетальныеЗаписи.Серия) Цикл
						ТекСимвол = ВРег(Сред(ВыборкаДетальныеЗаписи.Серия,инд,1));
						Если Найти(СтрокаБуквЦифр,ТекСимвол)>0 Тогда
							СерияПриведенная = СерияПриведенная+ТекСимвол;
						КонецЕсли;
					КонецЦикла;
					Если ЗначениеЗаполнено(НомерПриведенный) ИЛИ ЗначениеЗаполнено(СерияПриведенная) Тогда 
						ТекИдентификатор = ВыборкаДетальныеЗаписи.Префикс + СтроковыеФункцииКлиентСервер.ДополнитьСтроку(СерияПриведенная+НомерПриведенный,20) + ТекКодСтраны;
						СтруктураОтвета.Идентификатор = ТекИдентификатор;
						Прервать;
					КонецЕсли;
				КонецЕсли;
			Иначе
				//это идентификатор по ИНН
				ИНН = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ФизЛицо,"ИНН");
				Если ЗначениеЗаполнено(ИНН) И ЗначениеЗаполнено(ТекКодСтраны) Тогда
					ТекИдентификатор = "21"+ СтроковыеФункцииКлиентСервер.ДополнитьСтроку(ИНН,20) + ТекКодСтраны;
					СтруктураОтвета.Идентификатор = ТекИдентификатор;
					Прервать;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		//Если идентификатор ранее был задан, то присвоим его
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.АльтернативныйИдентификатор) Тогда
			ТекИдентификатор = ВыборкаДетальныеЗаписи.АльтернативныйИдентификатор;
			СтруктураОтвета.Идентификатор = ТекИдентификатор;
			Прервать;
		КонецЕсли;
			
	КонецЦикла;

	Если ЗначениеЗаполнено(ТекИдентификатор) Тогда
		СтруктураОтвета.Результат = Истина;
		НовЗапись = РегистрыСведений.АльтернативныеИдентификаторыПолучателейГосуслуг.СоздатьМенеджерЗаписи();
		НовЗапись.ФизическоеЛицо = ФизЛицо;
		НовЗапись.ВидАльтернативногоИдентификатора = ВидИдентификатора;
		НовЗапись.АльтернативныйИдентификатор = ТекИдентификатор;
		НовЗапись.Записать();
	КонецЕсли;	
		
    УстановитьПривилегированныйРежим(Ложь);
	Возврат СтруктураОтвета;
КонецФункции

Функция СформироватьЕдиныйИдентификаторФизЛица(ФизЛицоКонтрагент,ВыводитьСообщениеОбОшибках = Истина) Экспорт
	Если ТипЗнч(ФизЛицоКонтрагент) = Тип("СправочникСсылка.Контрагенты") Тогда
		ТекФизЛицо = ФизЛицоКонтрагент.ЮридическоеФизическоеЛицо;
	Иначе
		ТекФизЛицо = ФизЛицоКонтрагент;
	КонецЕсли;

	ТекстЗапроса = "ВЫБРАТЬ
	               |	ФизЛица.Ссылка,
	               |	ФизЛица.СтраховойНомерПФР КАК СНИЛС
	               |ИЗ
	               |	Справочник.ФизическиеЛица КАК ФизЛица
	               |ГДЕ
	               |	ФизЛица.Ссылка = &Ссылка";
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка",ТекФизЛицо);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	СНИЛС = Выборка.СНИЛС;
	СНИЛС = СтрЗаменить(СНИЛС,"-","");
	СНИЛС = СтрЗаменить(СНИЛС," ","");
	Если НЕ ЗначениеЗаполнено(СНИЛС) Тогда
		Если ВыводитьСообщениеОбОшибках Тогда
			ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Для %1 не удалось сформировать единый уникальный идентификатор. Не указан СНИЛС.'"),Выборка.Ссылка));
		КонецЕсли;	
		Возврат "";
	КонецЕсли;
	ЕИФЛ = "1" + СНИЛС;
	Возврат ЕИФЛ;
КонецФункции

//Формирование единого идентификатора юр лица по форматам 1.15
Функция СформироватьЕдиныйИдентификатор(Контрагент,ВыводитьСообщениеОбОшибках = Истина) Экспорт
	
	Если Контрагент.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
		 Возврат СформироватьЕдиныйИдентификаторФизЛица(Контрагент,ВыводитьСообщениеОбОшибках);
	КонецЕсли;
	 
	ТекстЗапроса = "
	|ВЫБРАТЬ
	|	ЮридическиеЛица.Ссылка,
	|	ЮридическиеЛица.ИНН,
	|	ЮридическиеЛица.КПП,
	|	ВЫБОР
	|		КОГДА НЕ(ЮридическиеЛица.СтранаРегистрации = ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия)
	|					ИЛИ ЮридическиеЛица.СтранаРегистрации = ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка))
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ИностраннаяОрганизация
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЮридическиеЛица КАК ЮридическиеЛица
	|		ПО Контрагенты.ЮридическоеФизическоеЛицо = ЮридическиеЛица.Ссылка
	|ГДЕ
	|	Контрагенты.Ссылка = &Ссылка";
				   
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка",Контрагент);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	ИННКИО = Выборка.ИНН;
	Если Выборка.ИностраннаяОрганизация Тогда
		ИННКИО = Сред(ИННКИО,5,5);
	КонецЕсли;
	КПП = Выборка.КПП;
			
	ИдентификаторЗаполнен = Истина;
	Если НЕ ЗначениеЗаполнено(ИННКИО) Тогда
		Если ВыводитьСообщениеОбОшибках Тогда	
			ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Для %1 не удалось сформировать единый уникальный идентификатор. Не указан ИНН.'"),Выборка.Ссылка));
		КонецЕсли;	
		ИдентификаторЗаполнен = Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(КПП) Тогда
		Если ВыводитьСообщениеОбОшибках Тогда
			ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Для %1 не удалось сформировать единый уникальный идентификатор. Не указан КПП.'"),Выборка.Ссылка));
		КонецЕсли;	
		ИдентификаторЗаполнен = Ложь;
	КонецЕсли;
	
	Если НЕ ИдентификаторЗаполнен Тогда 
		Возврат "";
	КонецЕсли;
	
	ЕИФЛ = ?(Выборка.ИностраннаяОрганизация,"3","2") + ИННКИО+КПП;
	Возврат ЕИФЛ;
	
КонецФункции

#КонецОбласти

#Область ФормированиеИдентификаторовПоФормату_1_16

//Параметры:
// ТаблицаИдентификаторов - ТаблицаЗначений;
//  Колонки: 
//   "ВидАльтИдентификатора" - ссылка на справочник ВидыАльтернативныхИдентификаторовПолучателейГосуслуг, если не заполнен, то единый идентификатор 
//   "Префикс" - префикс вида альтернативного идентификатора, если заполнен, то можно смотреть по РС ДокументыФизическихЛиц, с аналогичным префиксом у ВидаДокумента
//   "Порядок" - приоритет использования идентификаторов, чем меньше, тем главнее.
//
// Квитанция - ДокументОбъект.КвитанцияНаОплатуГосуслуг
//
Процедура ЗаполнитьИдентификаторПлательщикаДляГИСГМП_1_16(Квитанция,ТаблицаИдентификаторов,Дата = Неопределено) Экспорт
	
	Плательщик = Квитанция.Плательщик;
	Если НЕ ЗначениеЗаполнено(Плательщик) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ТаблицаИдентификаторов)<>Тип("ТаблицаЗначений") Тогда
		Возврат;
	КонецЕсли;
	
	Если ТаблицаИдентификаторов.Количество()=0 Тогда
		Возврат;
	КонецЕсли;
	
	//У юр. лица может быть только единый идентификатор
	//Если это юр. лицо и единый идентификатор есть в таблице, то попробуем его сформировать
	Если Плательщик.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо
		И ТаблицаИдентификаторов.Найти(Справочники.ВидыАльтернативныхИдентификаторовПолучателейГосуслуг.ПустаяСсылка(),"ВидАльтИдентификатора")<>Неопределено Тогда
		Квитанция.ЕдиныйИдентификаторПлательщика = СформироватьЕдиныйИдентификатор_1_16(Плательщик, Ложь);
		Возврат;
	КонецЕсли;
	
    //Заполняем идентификатор по таблице.
	
	Если Дата=Неопределено Тогда
		Дата = Квитанция.Дата;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаИдентификаторов.ВидАльтИдентификатора,
		|	ТаблицаИдентификаторов.Префикс,
		|	ТаблицаИдентификаторов.Порядок
		|ПОМЕСТИТЬ ВремТаб
		|ИЗ
		|	&ТаблицаИдентификаторов КАК ТаблицаИдентификаторов
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕСТЬNULL(ГражданствоФизическихЛицСрезПоследних.Страна.Код, ""643"") КАК КодСтраны
		|ИЗ
		|	РегистрСведений.ГражданствоФизическихЛиц.СрезПоследних(&Дата, ФизическоеЛицо = &ФизЛицо) КАК ГражданствоФизическихЛицСрезПоследних
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВремТаб.ВидАльтИдентификатора,
		|	ВремТаб.Префикс,
		|	ВремТаб.Порядок КАК Порядок,
		|	ЕСТЬNULL(АльтернативныеИдентификаторыПолучателейГосуслуг.АльтернативныйИдентификатор, """") КАК АльтернативныйИдентификатор,		
