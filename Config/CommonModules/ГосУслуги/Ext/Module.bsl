	НовСтр.Параметры__Обязательный = "true";
	НовСтр.Параметры__Обязательный_Использовать = "true";
	НовСтр.Параметры__ТолькоЧтение = "true";
	НовСтр.Параметры__ТолькоЧтение_Использовать = "true";
	НовСтр.Параметры__ЭтоИдентификатор_Использовать = "false";
   	НовСтр.Параметры__Видимость = "false";                    
	НовСтр.Параметры__Видимость_Использовать = "true";
	НовСтр.Параметры__ДляПоиска = "true";                   
    НовСтр.Параметры__ДляПоиска_Использовать = "true";
	НовСтр.Параметры__ДляПлатежа = "true";                    
    НовСтр.Параметры__ДляПлатежа_Использовать = "true";
	
	НовСтр.Параметры__Маска_Использовать = "false";
	Если ВерсияФорматов <> "1.16" И ВерсияФорматов <> "2.00" Тогда	
		ДлинаНаКодНоменклатуры = 20 - (СтрДлина(ПрефиксКодаГосУслуги) + СтрДлина(КодСистемыИнициатора));
		
		НовСтр.Параметры__ЗначениеПоУмолчанию = "" + Строка(ПрефиксКодаГосУслуги) + Строка(КодСистемыИнициатора) + СтроковыеФункцииКлиентСервер.ДополнитьСтроку(Прав(СтрокаТЧ.Код,ДлинаНаКодНоменклатуры),ДлинаНаКодНоменклатуры);                    
