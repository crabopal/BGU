Процедура ОбработатьРезультатЭкспортаКаталога(СтрокаТаблицыСообщенийОбмена,ДокументСсылка,Успешно,ЧитаемыйОтвет)
		
	УстановитьПривилегированныйРежим(Истина);
	//Выполняется в привилегированном режиме,
	//т.к. при передаче ГАНом начислений подведомственных,
	//документы могут быть не ГАНа, а подведомственного участника.
	
	ТекДокОбъект = ДокументСсылка.ПолучитьОбъект();
	
	Если ТекДокОбъект <> Неопределено Тогда
		
		Если Успешно = Истина Тогда
			ТекДокОбъект.СтатусОбработки = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ВОчереди;
			УстанавливаемыйСтатус = Перечисления.СтатусыИсполненияДокумента.ПереданВОбработку;
		Иначе
			//если пакет не приняли, вернем статус Подготовлен
			ТекДокОбъект.СтатусОбработки = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.НеПринятСМЭВ;
			УстанавливаемыйСтатус = Перечисления.СтатусыИсполненияДокумента.Подготовлен;
		КонецЕсли;
		
		//очистим результат предыдущего обмена
		ТекДокОбъект.РезультатОбработкиОбщий = "";
		ТекДокОбъект.РезультатИмпортаКод = "";
		ТекДокОбъект.РезультатИмпортаОписание = "";
				
		Если Успешно = Истина
			И СтрНайти(ЧитаемыйОтвет,"Result")>0 Тогда
			
			//При обмене с ИС УНП результат импорта каталога возвращается синхронно, в сообщении SendRequestResponse
			
			НастройкиУчастника = БиблиотекаФункцийОбменаПовтИсп.ПолучитьНастройкиОтправителя(ТекДокОбъект.Организация);
		
			ФорматИмпорта = Справочники.ФорматыОбменаБанкиКС.ПолучитьФорматПоВладельцуНаправлениюНаименованию(НастройкиУчастника.ВидОбмена,Перечисления.НаправлениеОбменаБанкиКС.Импорт,"ImportCatalogResponse");
			
			Если НЕ ЗначениеЗаполнено(ФорматИмпорта) Тогда
				Текст = Нстр("ru='Отсутствует формат импорта данных из сервиса с кодом ""ImportCatalogResponse""'");			
				ОбщегоНазначения.СообщитьПользователю(Текст);
				Возврат;
			КонецЕсли;
				
			ОбработкаИмпорта = Обработки.ОбменВФорматахУФК_УФЭБС.Создать();
			ТаблицаИмпорта = ОбработкаИмпорта.ЗагрузитьИзФайлаXML3(ЧитаемыйОтвет,ФорматИмпорта,Документы.ЗаданиеНаИмпортДанныхБанкиКС.ПустаяСсылка());
			
			Если ТаблицаИмпорта.Количество() > 0 Тогда
			
				ЕстьОшибки = Ложь;
				
				Если ТаблицаИмпорта.Колонки.Найти("КодОбработки") = Неопределено Тогда
			        ТаблицаИмпорта.Колонки.Добавить("КодОбработки");
				КонецЕсли;
				Если ТаблицаИмпорта.Колонки.Найти("ОписаниеОбработки") = Неопределено Тогда
			        ТаблицаИмпорта.Колонки.Добавить("ОписаниеОбработки");
				КонецЕсли;
				
				Для Каждого СтрТЧ Из ТаблицаИмпорта Цикл
					ТекДокОбъект.РезультатИмпортаКод = СтрТЧ.КодОбработки;
					ТекДокОбъект.РезультатИмпортаОписание = СтрТЧ.ОписаниеОбработки;
					Если СтрТЧ.КодОбработки <> "0" Тогда
						ЕстьОшибки = Истина;
					КонецЕсли;
				КонецЦикла;
					
				Если ЕстьОшибки Тогда
					СтатусОбработки = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ОбработанЕстьОшибки;
					УстанавливаемыйСтатус = Перечисления.СтатусыИсполненияДокумента.ВРаботе;
				Иначе
					СтатусОбработки = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ОбработанБезОшибок;
					УстанавливаемыйСтатус = Перечисления.СтатусыИсполненияДокумента.НаИсполнении;
				КонецЕсли;
				
				ТекДокОбъект.СтатусОбработки = СтатусОбработки;
				СтрокаТаблицыСообщенийОбмена.СтатусОтправки = СтатусОбработки;

			КонецЕсли;
		КонецЕсли;
		
		ТекДокОбъект.Записать();
		
		СтруктураРекв = Новый Структура;
		СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",ДокументСсылка);
		СтруктураРекв.Вставить("Статус",УстанавливаемыйСтатус);
		ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура ОбработатьРезультатЭкспортаЗапроса(ДокументСсылка,Успешно)
	
	УстановитьПривилегированныйРежим(Истина);
	//Выполняется в привилегированном режиме,
	//т.к. при передаче ГАНом начислений подведомственных,
	//документы могут быть не ГАНа, а подведомственного участника.
	
	ТекДокОбъект = ДокументСсылка.ПолучитьОбъект();
	
	Если ТекДокОбъект <> Неопределено Тогда
		Если Успешно = Истина Тогда
			ТекДокОбъект.СтатусОбработки = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ВОчереди;
			УстанавливаемыйСтатус = Перечисления.СтатусыИсполненияДокумента.ПереданВОбработку;
		Иначе
			//если пакет не приняли, вернем статус Подготовлен
			ТекДокОбъект.СтатусОбработки = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.НеПринятСМЭВ;
			УстанавливаемыйСтатус = Перечисления.СтатусыИсполненияДокумента.Подготовлен;
		КонецЕсли;
		
		//очистим результат предыдущего обмена
		ТекДокОбъект.РезультатЗагрузки = "";
		ТекДокОбъект.ЗагруженоДанных = 0;
			
		ТекДокОбъект.Записать();
		
		СтруктураРекв = Новый Структура;
		СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",ДокументСсылка);
		СтруктураРекв.Вставить("Статус",УстанавливаемыйСтатус);
		ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
		
		ТекущееЗначение = 1;//0 - нет, 1 - Да, 2 - запрос отправлен (прошлое значение Да), 3 - квитирование выполнено, 4 - запрос отправлен (прошлое значение Нет), 5 - сквитировать не удалось 
		НовоеЗначение = 2;  //0 - нет, 1 - Да, 2 - запрос отправлен (прошлое значение Да), 3 - квитирование выполнено, 4 - запрос отправлен (прошлое значение Нет), 5 - сквитировать не удалось
		
		ИзменитьЗначениеТребованияКвитирования(ТекДокОбъект,ТекущееЗначение,НовоеЗначение);
		
		МассивТекущихЗначений = Новый Массив;
		МассивТекущихЗначений.Добавить(0);//0 - нет, 1 - Да, 2 - запрос отправлен (прошлое значение Да), 3 - квитирование выполнено, 4 - запрос отправлен (прошлое значение Нет), 5 - сквитировать не удалось 
		МассивТекущихЗначений.Добавить(5);//0 - нет, 1 - Да, 2 - запрос отправлен (прошлое значение Да), 3 - квитирование выполнено, 4 - запрос отправлен (прошлое значение Нет), 5 - сквитировать не удалось 
		
		НовоеЗначение = 4;//0 - нет, 1 - Да, 2 - запрос отправлен (прошлое значение Да), 3 - квитирование выполнено, 4 - запрос отправлен (прошлое значение Нет), 5 - сквитировать не удалось 
		
		ИзменитьЗначениеТребованияКвитирования(ТекДокОбъект,МассивТекущихЗначений,НовоеЗначение);
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура ОбработатьРезультатЭкспортаЗапросаИзРС(ИдЗапросаРС,Успешно,СтроковоеОписаниеОшибки)
	
	УстановитьПривилегированныйРежим(Истина);
	//Выполняется в привилегированном режиме, т.к. обмен по всем организацяим может быть
	
	Выборка = ПолучитьВыборкуВыполняемогоЗапросаПоИдентификатору(ИдЗапросаРС);
	
	Если Выборка.Следующий() Тогда
		ЗаписьРС = РегистрыСведений.ВыполняемыеЗапросыОчередиКГИСГМП.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(ЗаписьРС,Выборка);
		
		ЗаписьРС.ДатаОбмена = ТекущаяДатаСеанса();
		
		Если Успешно = Истина Тогда			
			ЗаписьРС.СтатусВыполняемогоЗапроса = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.Отправлен;
		Иначе
			ЗаписьРС.СтатусВыполняемогоЗапроса = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.Ошибка;
			ЗаписьРС.ЕстьОшибка = Истина;
			ЗаписьРС.ТекстОшибки = СтроковоеОписаниеОшибки;
		КонецЕсли;
		ЗаписьРС.Записать();
		
		НужнаПроверка = Истина;
		
		Если Успешно = Ложь Тогда
			//если ошибка имеет смысл создавать новую запись запланированную с такой же настройкой, 
			//но запрашивать надо снова с 1 страницы, т.к. ГИС ГМП требует получение данных по порядку
			
			//пытаться будем до 5 раз, если за 5 раз не получилось, значит не стоит пытаться, иначе будет бесконечно
			Если ЗаписьРС.НомерПовтора<5 Тогда
				НужнаПроверка = Ложь;
				СтраницаРезультата = 1;
				СтатусЗаписи = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.Запланирован;
				СоздатьЗаписьВыполняемыеЗапросыКГИСГМП(ЗаписьРС,СтатусЗаписи,СтраницаРезультата,Истина);				
			КонецЕсли;
		КонецЕсли;
		
		Если НужнаПроверка Тогда
			ПроверитьЗавершитьОбработкуДетальнойОчередиЗапросов(ЗаписьРС.Организация,ЗаписьРС.УИДНастройкиОбщегоЗапроса,ЗаписьРС.УИДНастройкиДетальногоЗапроса);
		КонецЕсли;
	КонецЕсли;	
			
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Функция ПолучитьВыборкуВыполняемогоЗапросаПоИдентификатору(ИдЗапросаРС)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	*
		|ИЗ
		|	РегистрСведений.ВыполняемыеЗапросыОчередиКГИСГМП КАК ВыполняемыеЗапросыОчередиКГИСГМП
		|ГДЕ
		|	ВыполняемыеЗапросыОчередиКГИСГМП.УИДВыполняемогоЗапросаКГИСГМП = &УИДВыполняемогоЗапросаКГИСГМП";
	Запрос.УстановитьПараметр("УИДВыполняемогоЗапросаКГИСГМП",ИдЗапросаРС);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Возврат Выборка;
	
КонецФункции

Процедура СоздатьЗаписьВыполняемыеЗапросыКГИСГМП(ИсходнаяЗапись,Статус,СтраницаРезультата,ЭтоПовтор=Ложь)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ Первые 1
		|	Истина
		|ИЗ
		|	РегистрСведений.ВыполняемыеЗапросыОчередиКГИСГМП КАК ВыполняемыеЗапросыОчередиКГИСГМП
		|ГДЕ
		|	ВыполняемыеЗапросыОчередиКГИСГМП.Организация = &Организация
		|	И ВыполняемыеЗапросыОчередиКГИСГМП.УИДНастройкиОбщегоЗапроса = &УИДНастройкиОбщегоЗапроса
		|	И ВыполняемыеЗапросыОчередиКГИСГМП.УИДНастройкиДетальногоЗапроса = &УИДНастройкиДетальногоЗапроса
		|	И ВыполняемыеЗапросыОчередиКГИСГМП.СтатусВыполняемогоЗапроса = &СтатусВыполняемогоЗапроса";
	
	Запрос.УстановитьПараметр("Организация", ИсходнаяЗапись.Организация);
	Запрос.УстановитьПараметр("СтатусВыполняемогоЗапроса", Статус);
	Запрос.УстановитьПараметр("УИДНастройкиДетальногоЗапроса", ИсходнаяЗапись.УИДНастройкиДетальногоЗапроса);
	Запрос.УстановитьПараметр("УИДНастройкиОбщегоЗапроса", ИсходнаяЗапись.УИДНастройкиОбщегоЗапроса);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
	
		НоваяЗапись = РегистрыСведений.ВыполняемыеЗапросыОчередиКГИСГМП.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(НоваяЗапись,ИсходнаяЗапись,"Организация,УИДНастройкиОбщегоЗапроса,УИДНастройкиДетальногоЗапроса");
		НоваяЗапись.УИДВыполняемогоЗапросаКГИСГМП = Новый УникальныйИдентификатор;
		НоваяЗапись.СтатусВыполняемогоЗапроса = Статус;
		НоваяЗапись.СтраницаРезультата = СтраницаРезультата;
		НоваяЗапись.ДатаСоздания = ТекущаяДатаСеанса();
		
		Если ЭтоПовтор Тогда
			НоваяЗапись.НомерПовтора = ИсходнаяЗапись.НомерПовтора + 1;	
		КонецЕсли;
		
		НоваяЗапись.Записать();
		
	КонецЕсли;
	
КонецПроцедуры


Процедура ИзменитьЗначениеТребованияКвитирования(ТекДокОбъект,ТекущееЗначение,НовоеЗначение)
	
	Если ТекДокОбъект.ТипЗапрашиваемыхДанных = "DOACKNOWLEDGMENTREQUEST" 
		И ТекДокОбъект.КвитированиеБезПлатежа = Ложь Тогда//квитирование
		
		МассивПлатежей = Новый Массив;
		Для Каждого СтрТЧ Из ТекДокОбъект.ЗапрашиваемыеДанные Цикл
			Если ЗначениеЗаполнено(СтрТЧ.Источник) Тогда
				МассивПлатежей.Добавить(СтрТЧ.Источник);
			КонецЕсли;
		КонецЦикла;
		
		ИзменитьЗначениеТребованияКвитированияДляМассиваПлатежей(МассивПлатежей, ТекДокОбъект.Начисление, ТекущееЗначение, НовоеЗначение);

	КонецЕсли;
КонецПроцедуры

Процедура ИзменитьЗначениеТребованияКвитированияДляМассиваПлатежей(Знач МассивПлатежей, Знач Начисление, Знач ТекущееЗначение, Знач НовоеЗначение)
	
	Перем ВыборкаДетальныеЗаписи, ЗаписьРС, Запрос, РезультатЗапроса;
	
	//Порядок изменения статусов:
	// 1 - Да -> 2 - запрос отправлен (прошлое значение Да) -> 3 - квитирование выполнено                        : ошибок нет, квитирование выполнилось
	// 1 - Да -> 2 - запрос отправлен (прошлое значение Да) -> 1 - Да                                            : не удалось выполнить квитирование, статус установлен прежний
	// 0 - Нет -> 4 - запрос отправлен (прошлое значение Нет) -> 3 - квитирование выполнено                      : ошибок нет, квитирование выполнилось
	// 0 - Нет -> 4 - запрос отправлен (прошлое значение Нет) -> 5 - сквитировать не удалось                     : не удалось выполнить квитирование, установим статус, что запрос отправляли
	// 5 - сквитировать не удалось -> 4 - запрос отправлен (прошлое значение Нет) -> 3 - квитирование выполнено  : ошибок нет, квитирование выполнилось
	// 5 - сквитировать не удалось -> 4 - запрос отправлен (прошлое значение Нет) -> 5 - сквитировать не удалось : не удалось выполнить квитирование, установим статус, что запрос отправляли
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СоответствиеНачисленийИПлатежей.Платеж КАК Платеж,
	|	СоответствиеНачисленийИПлатежей.ТребуетсяКвитирование КАК ТребуетсяКвитирование,
	|	СоответствиеНачисленийИПлатежей.Начисление КАК Начисление
	|ИЗ
	|	РегистрСведений.СоответствиеНачисленийИПлатежей КАК СоответствиеНачисленийИПлатежей
	|ГДЕ
	|	СоответствиеНачисленийИПлатежей.Платеж В(&МассивПлатежей)
	|	И СоответствиеНачисленийИПлатежей.Начисление = &Начисление
	|	И СоответствиеНачисленийИПлатежей.ТребуетсяКвитирование В (&ТекущееЗначение)";
	
	Запрос.УстановитьПараметр("МассивПлатежей", МассивПлатежей);
	Запрос.УстановитьПараметр("Начисление", Начисление);
	Запрос.УстановитьПараметр("ТекущееЗначение",ТекущееЗначение); //Число или массив чисел: 0 - нет, 1 - Да, 2 - запрос отправлен (прошлое значение Да), 3 - квитирование выполнено, 4 - запрос отправлен (прошлое значение Нет), 5 - сквитировать не удалось
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗаписьРС = РегистрыСведений.СоответствиеНачисленийИПлатежей.СоздатьМенеджерЗаписи();
		ЗаписьРС.Платеж = ВыборкаДетальныеЗаписи.Платеж;
		ЗаписьРС.Прочитать();
		Если ЗаписьРС.Выбран() Тогда
			ЗаписьРС.ТребуетсяКвитирование = НовоеЗначение;//0 - нет, 1 - Да, 2 - запрос отправлен (прошлое значение Да), 3 - квитирование выполнено, 4 - запрос отправлен (прошлое значение Нет), 5 - сквитировать не удалось
			ЗаписьРС.Записать();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры



Процедура ОбработатьРезультатЭкспортаВозвратов(ПакетСсылка,Успешно)
	
	УстановитьПривилегированныйРежим(Истина);
	
	//Выполняется в привилегированном режиме,
	//т.к. при передаче ГАНом начислений подведомственных,
	//документы могут быть не ГАНа, а подведомственного участника.
	
	ТекДокОбъект = ПакетСсылка.ПолучитьОбъект();
	
	Если ТекДокОбъект <> Неопределено Тогда
		
		Если Успешно = Истина Тогда
			ТекДокОбъект.СтатусОбработки = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ВОчереди;
			УстанавливаемыйСтатус = Перечисления.СтатусыИсполненияДокумента.ПереданВОбработку;
		Иначе
			//если пакет не приняли, вернем статус Подготовлен
			ТекДокОбъект.СтатусОбработки = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.НеПринятСМЭВ;
			УстанавливаемыйСтатус = Перечисления.СтатусыИсполненияДокумента.Подготовлен;
		КонецЕсли;
		
		//очистим результат предыдущего обмена
		ТекДокОбъект.РезультатОбработкиОбщий = "";
		
		Для Каждого СтрокаТЧ Из ТекДокОбъект.Возвраты Цикл
		    //очистим результат предыдущего обмена
			СтрокаТЧ.РезультатИмпортаКод = "";
			СтрокаТЧ.РезультатИмпортаОписание = "";
			
			//Установим новый статус возвратам
			СтруктураРекв = Новый Структура;
			СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",СтрокаТЧ.ВозвратСсылка);
			СтруктураРекв.Вставить("Статус",УстанавливаемыйСтатус);
			ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
			
		КонецЦикла;
		
		ТекДокОбъект.Записать();
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры


Процедура УстановитьРезультатВыгрузкиВКаталог(ДокументСсылка)
	УстановитьПривилегированныйРежим(Истина);
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПакетНачисленийГИСГМП")
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПакетНачисленийГИСГМПОтПодведомственного") Тогда
		
		ТекДокОбъект = ДокументСсылка.ПолучитьОбъект();
		
		Если ТекДокОбъект <> Неопределено Тогда
			
			ТекДокОбъект.СтатусОбработки = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ВыгруженВКаталог;
			УстанавливаемыйСтатус = Перечисления.СтатусыИсполненияДокумента.НаИсполнении;
			
			//очистим результат предыдущего обмена
			ТекДокОбъект.РезультатОбработкиОбщий = "";
			
			Для Каждого СтрокаТЧ Из ТекДокОбъект.Начисления Цикл
			    //очистим результат предыдущего обмена
				СтрокаТЧ.РезультатИмпортаКод = "";
				СтрокаТЧ.РезультатИмпортаОписание = "";
				
				//Установим новый статус начислениям
				СтруктураРекв = Новый Структура;
				СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",СтрокаТЧ.НачислениеСсылка);
				СтруктураРекв.Вставить("Статус",УстанавливаемыйСтатус);
				ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
				
			КонецЦикла;
			
			ТекДокОбъект.Записать();
			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПакетУведомленийОВозвратеГИСГМП")
		ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ПакетУведомленийОВозвратеГИСГМПОтПодведомственного") Тогда
		
		ТекДокОбъект = ДокументСсылка.ПолучитьОбъект();
		
		Если ТекДокОбъект <> Неопределено Тогда
			
			ТекДокОбъект.СтатусОбработки = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ВыгруженВКаталог;
			УстанавливаемыйСтатус = Перечисления.СтатусыИсполненияДокумента.НаИсполнении;
			
			//очистим результат предыдущего обмена
			ТекДокОбъект.РезультатОбработкиОбщий = "";
			
			Для Каждого СтрокаТЧ Из ТекДокОбъект.Возвраты Цикл
			    //очистим результат предыдущего обмена
				СтрокаТЧ.РезультатИмпортаКод = "";
				СтрокаТЧ.РезультатИмпортаОписание = "";
				
				//Установим новый статус возвратам
				СтруктураРекв = Новый Структура;
				СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",СтрокаТЧ.ВозвратСсылка);
				СтруктураРекв.Вставить("Статус",УстанавливаемыйСтатус);
				ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
				
			КонецЦикла;
			
			ТекДокОбъект.Записать();
			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.КаталогГосУслуг") Тогда
		
		ТекДокОбъект = ДокументСсылка.ПолучитьОбъект();
		
		Если ТекДокОбъект <> Неопределено Тогда
			
			ТекДокОбъект.СтатусОбработки = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ВыгруженВКаталог;
			УстанавливаемыйСтатус = Перечисления.СтатусыИсполненияДокумента.НаИсполнении;

			//очистим результат предыдущего обмена
			ТекДокОбъект.РезультатОбработкиОбщий = "";
			ТекДокОбъект.РезультатИмпортаКод = "";
			ТекДокОбъект.РезультатИмпортаОписание = "";
			
			ТекДокОбъект.Записать();
		
			СтруктураРекв = Новый Структура;
			СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",ДокументСсылка);
			СтруктураРекв.Вставить("Статус",УстанавливаемыйСтатус);
			ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ЗапросУНИФО") Тогда
		ТекДокОбъект = ДокументСсылка.ПолучитьОбъект();
		
		Если ТекДокОбъект <> Неопределено Тогда
			
			ТекДокОбъект.СтатусОбработки = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ВыгруженВКаталог;
			УстанавливаемыйСтатус = Перечисления.СтатусыИсполненияДокумента.Исполнен;
			
			ТекДокОбъект.Записать();
		
			СтруктураРекв = Новый Структура;
			СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",ДокументСсылка);
			СтруктураРекв.Вставить("Статус",УстанавливаемыйСтатус);
			ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
			
		КонецЕсли;
		
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

//  ОбработатьРезультатИмпорта - это процедуры обработки ответа из сервиса с результатом обработки сообщений отправленных нами в сервис
//  Пример - отправили пакет начислений в сервис - при отправке пакета обрабатываем ответ как ОбработатьРезультатЭкспортаНачислений,
//	после того как запросили из сервиса результат обработки и получили ответ - обрабатываем его как ОбработатьРезультатИмпортаНачислений

Процедура ОбработатьРезультатИмпортаНачислений(ИдентификаторСообщенияУчастника,ТекУчастник,ТекстФайла,ЭтоОтветОтЭмулятора) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	//Выполняется в привилегированном режиме,
	//т.к. при передаче ГАНом начислений подведомственных,
	//документы могут быть не ГАНа, а подведомственного участника.
	
	Если ЭтоОтветОтЭмулятора Тогда
		//Только установим статус, что получили от эмулятора ответ.
		//Ответ либо приходит эталонный, либо не приходит вообще.
	    УстановитьСтатусОбработкиСообщения(ИдентификаторСообщенияУчастника,Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ОбработанБезОшибок);
		
		УстановитьПривилегированныйРежим(Ложь);
		
		Возврат;	
	КонецЕсли;
	
	НастройкиУчастника = БиблиотекаФункцийОбменаПовтИсп.ПолучитьНастройкиОтправителя(ТекУчастник);
	
	ФорматИмпорта = Справочники.ФорматыОбменаБанкиКС.ПолучитьФорматПоВладельцуНаправлениюНаименованию(НастройкиУчастника.ВидОбмена,Перечисления.НаправлениеОбменаБанкиКС.Импорт,"ImportChargesResponse");
	
	Если НЕ ЗначениеЗаполнено(ФорматИмпорта) Тогда
		Текст = Нстр("ru='Отсутствует формат импорта данных из сервиса с кодом ""ImportChargesResponse""'");			
		ОбщегоНазначения.СообщитьПользователю(Текст);
		Возврат;
	КонецЕсли;
		
	ОбработкаИмпорта = Обработки.ОбменВФорматахУФК_УФЭБС.Создать();
	ТаблицаИмпорта = ОбработкаИмпорта.ЗагрузитьИзФайлаXML3(ТекстФайла,ФорматИмпорта,Документы.ЗаданиеНаИмпортДанныхБанкиКС.ПустаяСсылка());

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДанныеИсходящихСообщенийСМЭВ3.Организация КАК Организация,
		|	ДанныеИсходящихСообщенийСМЭВ3.ИдентификаторСообщения КАК ИдентификаторСообщения,
		|	ДанныеИсходящихСообщенийСМЭВ3.ИдентификаторДанных КАК ИдентификаторДанных,
		|	ДанныеИсходящихСообщенийСМЭВ3.Данные КАК Данные
		|ИЗ
		|	РегистрСведений.ДанныеИсходящихСообщенийСМЭВ3 КАК ДанныеИсходящихСообщенийСМЭВ3
		|ГДЕ
		|	ДанныеИсходящихСообщенийСМЭВ3.ИдентификаторСообщения = &ИдентификаторСообщения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	СообщенияИмпортаДанныхВСМЭВ3.Организация КАК Организация,
		|	СообщенияИмпортаДанныхВСМЭВ3.ИдентификаторСообщения КАК ИдентификаторСообщения
		|ИЗ
		|	РегистрСведений.СообщенияИмпортаДанныхВСМЭВ3 КАК СообщенияИмпортаДанныхВСМЭВ3
		|ГДЕ
		|	СообщенияИмпортаДанныхВСМЭВ3.ИдентификаторСообщения = &ИдентификаторСообщения";
	
	Запрос.УстановитьПараметр("ИдентификаторСообщения", ИдентификаторСообщенияУчастника);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаДетальныеЗаписи = РезультатыЗапроса[0].Выбрать();
	
	ОбрабатываемыйДокумент = Неопределено;
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ОбрабатываемыйДокумент = ВыборкаДетальныеЗаписи.Данные;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ОбрабатываемыйДокумент) Тогда 
		Возврат;
	КонецЕсли;
	
	ДокОбъект = ОбрабатываемыйДокумент.ПолучитьОбъект();
	Если ДокОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоНачислениеОтПосредника =  (ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.НачислениеОтПосредникаГИСГМП"));
	
	Если НЕ ЭтоНачислениеОтПосредника Тогда
		ДокОбъект.РезультатОбработкиОбщий = "";
	КонецЕсли;
	
	ЕстьОшибки = Ложь;
	
	МассивОшибок = Новый Массив;
	
	Если ТаблицаИмпорта.Колонки.Найти("ИдНачисления") = Неопределено Тогда
        ТаблицаИмпорта.Колонки.Добавить("ИдНачисления");
	КонецЕсли;
	Если ТаблицаИмпорта.Колонки.Найти("КодОбработки") = Неопределено Тогда
        ТаблицаИмпорта.Колонки.Добавить("КодОбработки");
	КонецЕсли;
	Если ТаблицаИмпорта.Колонки.Найти("ОписаниеОбработки") = Неопределено Тогда
        ТаблицаИмпорта.Колонки.Добавить("ОписаниеОбработки");
	КонецЕсли;
	
	Для Каждого СтрТЧ Из ТаблицаИмпорта Цикл
		
		Если ЭтоНачислениеОтПосредника Тогда
			
			ДокОбъект.РезультатИмпортаКод = СтрТЧ.КодОбработки;
			ДокОбъект.РезультатИмпортаОписание = СтрТЧ.ОписаниеОбработки;
			Если СтрТЧ.КодОбработки <> "0" Тогда
				ЕстьОшибки = Истина;
				Если МассивОшибок.Найти(СтрТЧ.КодОбработки) = Неопределено Тогда
					МассивОшибок.Добавить(СтрТЧ.КодОбработки);
				КонецЕсли;
			КонецЕсли;
				
		Иначе
			СтрДок = ДокОбъект.Начисления.Найти(СтрТЧ.ИдНачисления,"ИД_Начисления");
			Если СтрДок<> Неопределено Тогда
							
				СтрДок.РезультатИмпортаКод = СтрТЧ.КодОбработки;
				СтрДок.РезультатИмпортаОписание = СтрТЧ.ОписаниеОбработки;
				Если СтрТЧ.КодОбработки <> "0" Тогда
					ЕстьОшибки = Истина;
					Если МассивОшибок.Найти(СтрТЧ.КодОбработки) = Неопределено Тогда
						МассивОшибок.Добавить(СтрТЧ.КодОбработки);
					КонецЕсли;
				КонецЕсли;
				
				СтруктураРекв = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(СтрДок.НачислениеСсылка);
				Если СтруктураРекв.Статус = Перечисления.СтатусыИсполненияДокумента.ПереданВОбработку Тогда
					//Статус начисления меняется только если текущий статус - Передан в обработку
					СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",СтрДок.НачислениеСсылка);
					Если СтрТЧ.КодОбработки = "0" Тогда
						
						Если СтрДок.ВидКвитанции=3 Тогда
							ТекСтатус = Перечисления.СтатусыИсполненияДокумента.Аннулирован;
						Иначе
							СтруктураРезультата = РегистрыСведений.СоответствиеНачисленийИПлатежей.ПолучитьСуммуКоличествоПлатежейПоНачислению(СтрДок.НачислениеСсылка);
							
							СуммаДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрДок.НачислениеСсылка,"СуммаДокумента"); //у предварительного начисления сумма = 0
							Если СтруктураРезультата.Сумма >= СуммаДокумента
								И СуммаДокумента <> 0 Тогда		
								ТекСтатус = Перечисления.СтатусыИсполненияДокумента.Исполнен;//для начисления уже могут быть платежи, если начисление создано по платежу
							Иначе
								ТекСтатус = Перечисления.СтатусыИсполненияДокумента.НаИсполнении;
							КонецЕсли;
						КонецЕсли;	
						
					Иначе
						ТекСтатус = Перечисления.СтатусыИсполненияДокумента.ВРаботе;
					КонецЕсли;
					СтруктураРекв.Вставить("Статус",ТекСтатус);
					ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);							
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	 
	Если ЕстьОшибки Тогда
		УстанавливаемыйСтатус = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ОбработанЕстьОшибки;	 
	Иначе
		УстанавливаемыйСтатус = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ОбработанБезОшибок;
	КонецЕсли;
	
	ДокОбъект.СтатусОбработки = УстанавливаемыйСтатус;
	
	ДокОбъект.Записать();
	
	Если ЭтоНачислениеОтПосредника Тогда
		СтруктураРекв = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(ДокОбъект.Ссылка);
		Если СтруктураРекв.Статус = Перечисления.СтатусыИсполненияДокумента.ПереданВОбработку Тогда
			//Статус начисления меняется только если текущий статус - Передан в обработку
			СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",ДокОбъект.Ссылка);
			Если ЕстьОшибки = Ложь Тогда
				
				Если ДокОбъект.ВидКвитанции=3 Тогда
					ТекСтатус = Перечисления.СтатусыИсполненияДокумента.Аннулирован;
				Иначе
					ТекСтатус = Перечисления.СтатусыИсполненияДокумента.НаИсполнении;
				КонецЕсли;	
				
			Иначе
				ТекСтатус = Перечисления.СтатусыИсполненияДокумента.ВРаботе;
			КонецЕсли;
			СтруктураРекв.Вставить("Статус",ТекСтатус);
			ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);							
		КонецЕсли;
	КонецЕсли;	
	
	ВыборкаСИД = РезультатыЗапроса[1].Выбрать();
	Если ВыборкаСИД.Следующий() Тогда
		ЗаписьСИД = РегистрыСведений.СообщенияИмпортаДанныхВСМЭВ3.СоздатьМенеджерЗаписи();
		ЗаписьСИД.Организация = ВыборкаСИД.Организация;
		ЗаписьСИД.ИдентификаторСообщения = ВыборкаСИД.ИдентификаторСообщения;
		ЗаписьСИД.Прочитать();
		Если ЗаписьСИД.Выбран() Тогда
			ЗаписьСИД.СтатусОтправки = УстанавливаемыйСтатус;
			ЗаписьСИД.ЕстьОшибка = ЕстьОшибки;
			ЗаписьСИД.РезультатОбработки = ?(ЕстьОшибки,"Коды ошибок: "+СтрСоединить(МассивОшибок,", "),"Начисления загружены успешно");
			ЗаписьСИД.Записать();
		КонецЕсли;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура ОбработатьРезультатИмпортаВозвратов(ИдентификаторСообщенияУчастника,ТекУчастник,ТекстФайла,ЭтоОтветОтЭмулятора)
	
	УстановитьПривилегированныйРежим(Истина);
	
	//Выполняется в привилегированном режиме,
	//т.к. при передаче ГАНом начислений подведомственных,
	//документы могут быть не ГАНа, а подведомственного участника.
	
	Если ЭтоОтветОтЭмулятора Тогда
		//Только установим статус, что получили от эмулятора ответ.
		//Ответ либо приходит эталонный, либо не приходит вообще.
	    УстановитьСтатусОбработкиСообщения(ИдентификаторСообщенияУчастника,Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ОбработанБезОшибок);
		
		УстановитьПривилегированныйРежим(Ложь);
		
		Возврат;	
	КонецЕсли;
	
	НастройкиУчастника = БиблиотекаФункцийОбменаПовтИсп.ПолучитьНастройкиОтправителя(ТекУчастник);
	
	ФорматИмпорта = Справочники.ФорматыОбменаБанкиКС.ПолучитьФорматПоВладельцуНаправлениюНаименованию(НастройкиУчастника.ВидОбмена,Перечисления.НаправлениеОбменаБанкиКС.Импорт,"ImportRefundsResponse");
	
	Если НЕ ЗначениеЗаполнено(ФорматИмпорта) Тогда
		Текст = Нстр("ru='Отсутствует формат импорта данных из сервиса с кодом ""ImportRefundsResponse""'");			
		ОбщегоНазначения.СообщитьПользователю(Текст);
		Возврат;
	КонецЕсли;
		
	ОбработкаИмпорта = Обработки.ОбменВФорматахУФК_УФЭБС.Создать();
	ТаблицаИмпорта = ОбработкаИмпорта.ЗагрузитьИзФайлаXML3(ТекстФайла,ФорматИмпорта,Документы.ЗаданиеНаИмпортДанныхБанкиКС.ПустаяСсылка());

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ Первые 1
		|	ДанныеИсходящихСообщенийСМЭВ3.Организация КАК Организация,
		|	ДанныеИсходящихСообщенийСМЭВ3.ИдентификаторСообщения КАК ИдентификаторСообщения,
		|	ДанныеИсходящихСообщенийСМЭВ3.ИдентификаторДанных КАК ИдентификаторДанных,
		|	ДанныеИсходящихСообщенийСМЭВ3.Данные КАК Данные
		|ИЗ
		|	РегистрСведений.ДанныеИсходящихСообщенийСМЭВ3 КАК ДанныеИсходящихСообщенийСМЭВ3
		|ГДЕ
		|	ДанныеИсходящихСообщенийСМЭВ3.ИдентификаторСообщения = &ИдентификаторСообщения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	СообщенияИмпортаДанныхВСМЭВ3.Организация КАК Организация,
		|	СообщенияИмпортаДанныхВСМЭВ3.ИдентификаторСообщения КАК ИдентификаторСообщения
		|ИЗ
		|	РегистрСведений.СообщенияИмпортаДанныхВСМЭВ3 КАК СообщенияИмпортаДанныхВСМЭВ3
		|ГДЕ
		|	СообщенияИмпортаДанныхВСМЭВ3.ИдентификаторСообщения = &ИдентификаторСообщения";
	
	Запрос.УстановитьПараметр("ИдентификаторСообщения", ИдентификаторСообщенияУчастника);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаДетальныеЗаписи = РезультатыЗапроса[0].Выбрать();
	
	ОбрабатываемыйДокумент = Неопределено;
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ОбрабатываемыйДокумент = ВыборкаДетальныеЗаписи.Данные;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ОбрабатываемыйДокумент) Тогда 
		Возврат;
	КонецЕсли;
	
	ДокОбъект = ОбрабатываемыйДокумент.ПолучитьОбъект();
	
	Если ДокОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДокОбъект.РезультатОбработкиОбщий = "";
	
	ЕстьОшибки = Ложь;
	МассивОшибок = Новый Массив;
	
	Если ТаблицаИмпорта.Колонки.Найти("ИД_Возврата") = Неопределено Тогда
        ТаблицаИмпорта.Колонки.Добавить("ИД_Возврата");
	КонецЕсли;
	Если ТаблицаИмпорта.Колонки.Найти("КодОбработки") = Неопределено Тогда
        ТаблицаИмпорта.Колонки.Добавить("КодОбработки");
	КонецЕсли;
	Если ТаблицаИмпорта.Колонки.Найти("ОписаниеОбработки") = Неопределено Тогда
        ТаблицаИмпорта.Колонки.Добавить("ОписаниеОбработки");
	КонецЕсли;
	
	Для Каждого СтрТЧ Из ТаблицаИмпорта Цикл
	
		СтрДок = ДокОбъект.Возвраты.Найти(СтрТЧ.ИдВозврата,"ИД_Возврата");
		Если СтрДок<> Неопределено Тогда
						
			СтрДок.РезультатИмпортаКод = СтрТЧ.КодОбработки;
			СтрДок.РезультатИмпортаОписание = СтрТЧ.ОписаниеОбработки;
			Если СтрТЧ.КодОбработки <> "0" Тогда
				ЕстьОшибки = Истина;
				Если МассивОшибок.Найти(СтрТЧ.КодОбработки) = Неопределено Тогда
					МассивОшибок.Добавить(СтрТЧ.КодОбработки);
				КонецЕсли;
			КонецЕсли;
			
			СтруктураРекв = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(СтрДок.ВозвратСсылка);
			Если СтруктураРекв.Статус = Перечисления.СтатусыИсполненияДокумента.ПереданВОбработку Тогда
				//Статус начисления меняется только если текущий статус - Передан в обработку
				СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",СтрДок.ВозвратСсылка);
				Если СтрТЧ.КодОбработки = "0" Тогда
					ТекСтатус = ?(СтрДок.ВидУведомления=3,Перечисления.СтатусыИсполненияДокумента.Аннулирован,Перечисления.СтатусыИсполненияДокумента.НаИсполнении);
				Иначе
					ТекСтатус = Перечисления.СтатусыИсполненияДокумента.ВРаботе;
				КонецЕсли;
				СтруктураРекв.Вставить("Статус",ТекСтатус);
				ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);							
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ЕстьОшибки Тогда
		УстанавливаемыйСтатус = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ОбработанЕстьОшибки;	 
	Иначе
		УстанавливаемыйСтатус = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ОбработанБезОшибок;
	КонецЕсли;
	
	ДокОбъект.СтатусОбработки = УстанавливаемыйСтатус;	
	
	ВыборкаСИД = РезультатыЗапроса[1].Выбрать();
	Если ВыборкаСИД.Следующий() Тогда
		ЗаписьСИД = РегистрыСведений.СообщенияИмпортаДанныхВСМЭВ3.СоздатьМенеджерЗаписи();
		ЗаписьСИД.Организация = ВыборкаСИД.Организация;
		ЗаписьСИД.ИдентификаторСообщения = ВыборкаСИД.ИдентификаторСообщения;
		ЗаписьСИД.Прочитать();
		Если ЗаписьСИД.Выбран() Тогда
			ЗаписьСИД.СтатусОтправки = УстанавливаемыйСтатус;
			ЗаписьСИД.ЕстьОшибка = ЕстьОшибки;
			ЗаписьСИД.РезультатОбработки = ?(ЕстьОшибки,"Коды ошибок: "+СтрСоединить(МассивОшибок,", "),"Возвраты загружены успешно");
			ЗаписьСИД.Записать();
		КонецЕсли;
	КонецЕсли;
	
	ДокОбъект.Записать();
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура ОбработатьРезультатИмпортаКаталога(ИдентификаторСообщенияУчастника,ТекУчастник,ТекстФайла,ЭтоОтветОтЭмулятора)
	
	УстановитьПривилегированныйРежим(Истина);
	
	//Выполняется в привилегированном режиме,
	//т.к. при передаче ГАНом начислений подведомственных,
	//документы могут быть не ГАНа, а подведомственного участника.
	
	Если ЭтоОтветОтЭмулятора Тогда
		//Только установим статус, что получили от эмулятора ответ.
		//Ответ либо приходит эталонный, либо не приходит вообще.
	    УстановитьСтатусОбработкиСообщения(ИдентификаторСообщенияУчастника,Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ОбработанБезОшибок);
		
		УстановитьПривилегированныйРежим(Ложь);
		
		Возврат;	
	КонецЕсли;
	
	НастройкиУчастника = БиблиотекаФункцийОбменаПовтИсп.ПолучитьНастройкиОтправителя(ТекУчастник);
	
	ФорматИмпорта = Справочники.ФорматыОбменаБанкиКС.ПолучитьФорматПоВладельцуНаправлениюНаименованию(НастройкиУчастника.ВидОбмена,Перечисления.НаправлениеОбменаБанкиКС.Импорт,"ImportCatalogResponse");
	
