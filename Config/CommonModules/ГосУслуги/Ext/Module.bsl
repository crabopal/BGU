	МассивКодовФК.Добавить("21");
	МассивКодовФК.Добавить("22");
	//23 - зарезервивовано	
	МассивКодовФК.Добавить("24");
	МассивКодовФК.Добавить("25");
	МассивКодовФК.Добавить("26");
	МассивКодовФК.Добавить("27");
	МассивКодовФК.Добавить("28");
	МассивКодовФК.Добавить("29");
	МассивКодовФК.Добавить("30");
	//31 - 99 зарезервивовано
	
	ВыборкаДетальныеЗаписи = Результат.Выбрать();

	ВидНовогоАльтИдентификатора = Неопределено;
	ТекИдентификатор = "";
	
	СтрокаБуквЦифр = "0123456789АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯABCDEFGHIJKLMNOPQRSTUVWXYZ";
	
	//Обходим результат по приоритету
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Префикс)
			И МассивКодовФК.Найти(ВыборкаДетальныеЗаписи.Префикс)=Неопределено Тогда
			//Нельзя использовать некоторые коды, они зарезервивованы
			Продолжить;
		КонецЕсли;
						
		//Если префикс не заполнен, самостоятельно сформировать не сможем
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Префикс) Тогда
					
			//Если это не идентификатор по ИНН, то пробуем его сформировать по серии и номеру документа и коду страны
			Если ВыборкаДетальныеЗаписи.Префикс = "21" Тогда
				
				//это идентификатор по ИНН
				ИНН = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ФизЛицо,"ИНН");
				Если ЗначениеЗаполнено(ИНН) Тогда
					ТекИдентификатор = "121"+ СтроковыеФункцииКлиентСервер.ДополнитьСтроку(ИНН,19);
