				СНИЛС = СтрЗаменить(СНИЛС," ","");
				Если ЗначениеЗаполнено(СНИЛС) И ЗначениеЗаполнено(ТекКодСтраны) Тогда
					
					ТекИдентификатор = "14"+ СтроковыеФункцииКлиентСервер.ДополнитьСтроку(СНИЛС,20) + ТекКодСтраны;
					СтруктураОтвета.Идентификатор = ТекИдентификатор; 
					Прервать;
				КонецЕсли;	
				
			Иначе
				//Если это не идентификатор по ИНН, то пробуем его сформировать по серии и номеру документа и коду страны
				Если (ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Серия) 
					ИЛИ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Номер)) 
					И ЗначениеЗаполнено(ТекКодСтраны)
					И ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Префикс) Тогда
					
					НомерПриведенный = "";
					Для инд = 1 по СтрДлина(ВыборкаДетальныеЗаписи.Номер) Цикл
						ТекСимвол = ВРег(Сред(ВыборкаДетальныеЗаписи.Номер,инд,1));
						Если Найти(СтрокаБуквЦифр,ТекСимвол)>0 Тогда
							НомерПриведенный = НомерПриведенный+ТекСимвол;
						КонецЕсли;
					КонецЦикла;
					
					СерияПриведенная = "";
					Для инд = 1 по СтрДлина(ВыборкаДетальныеЗаписи.Серия) Цикл
						ТекСимвол = ВРег(Сред(ВыборкаДетальныеЗаписи.Серия,инд,1));
						Если Найти(СтрокаБуквЦифр,ТекСимвол)>0 Тогда
							СерияПриведенная = СерияПриведенная+ТекСимвол;
						КонецЕсли;
					КонецЦикла;
					Если ЗначениеЗаполнено(НомерПриведенный) ИЛИ ЗначениеЗаполнено(СерияПриведенная) Тогда 
						ТекИдентификатор = ВыборкаДетальныеЗаписи.Префикс + СтроковыеФункцииКлиентСервер.ДополнитьСтроку(СерияПриведенная+НомерПриведенный,20) + ТекКодСтраны;
						СтруктураОтвета.Идентификатор = ТекИдентификатор;
						Прервать;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		//Если идентификатор ранее был задан, то присвоим его и на этом закончим.
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.АльтернативныйИдентификатор) Тогда
			ТекИдентификатор = ВыборкаДетальныеЗаписи.АльтернативныйИдентификатор;
			СтруктураОтвета.Идентификатор = ТекИдентификатор;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ЗначениеЗаполнено(ТекИдентификатор) Тогда
		СтруктураОтвета.Результат = Истина;
		НовЗапись = РегистрыСведений.АльтернативныеИдентификаторыПолучателейГосуслуг.СоздатьМенеджерЗаписи();
		НовЗапись.ФизическоеЛицо = ФизЛицо;
		НовЗапись.ВидАльтернативногоИдентификатора = ВидИдентификатора;
		НовЗапись.АльтернативныйИдентификатор = ТекИдентификатор;
		НовЗапись.Записать();
	КонецЕсли;	
		
    УстановитьПривилегированныйРежим(Ложь);
	Возврат СтруктураОтвета;
КонецФункции

Функция СформироватьЕдиныйИдентификаторИП(ФизЛицоКонтрагент,ВыводитьСообщениеОбОшибках = Истина) Экспорт
	
	Если ТипЗнч(ФизЛицоКонтрагент) = Тип("СправочникСсылка.Контрагенты") Тогда
		ТекФизЛицо = ФизЛицоКонтрагент.ЮридическоеФизическоеЛицо;
	Иначе
		ТекФизЛицо = ФизЛицоКонтрагент;
	КонецЕсли;

	ТекстЗапроса = "ВЫБРАТЬ
	               |	ФизЛица.Ссылка,
	               |	ФизЛица.ИНН КАК ИНН,
				   |	ФизЛица.ОГРНИП КАК ОГРНИП
	               |ИЗ
	               |	Справочник.ФизическиеЛица КАК ФизЛица
	               |ГДЕ
	               |	ФизЛица.Ссылка = &Ссылка";
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка",ТекФизЛицо);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Если ЗначениеЗаполнено(Выборка.ОГРНИП) И ЗначениеЗаполнено(Выборка.ИНН) Тогда
		Возврат "4"+Выборка.ИНН;
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

//Формирование единого идентификатора юр лица по форматам 1.16
Функция СформироватьЕдиныйИдентификатор_1_16(Контрагент,ВыводитьСообщениеОбОшибках = Истина) Экспорт
	
	Если Контрагент.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
		 Возврат СформироватьЕдиныйИдентификаторИП(Контрагент,ВыводитьСообщениеОбОшибках);
	КонецЕсли;
	 
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ЮридическиеЛица.Ссылка КАК Ссылка,
	               |	ЮридическиеЛица.ИНН КАК ИНН,
	               |	ЮридическиеЛица.КПП КАК КПП,
	               |	ВЫБОР
	               |		КОГДА НЕ ЮридическиеЛица.СтранаРегистрации В (ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия), ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка))
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК ИностраннаяОрганизация,
	               |	ЮридическиеЛица.НалоговыйНомер КАК НалоговыйНомер,
	               |	ЮридическиеЛица.СтранаРегистрации.Код КАК КодСтраны,
	               |	ЮридическиеЛица.СтранаРегистрации.КодАльфа2 КАК КодАльфа2
	               |ИЗ
	               |	Справочник.Контрагенты КАК Контрагенты
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЮридическиеЛица КАК ЮридическиеЛица
	               |		ПО Контрагенты.ЮридическоеФизическоеЛицо = ЮридическиеЛица.Ссылка
	               |ГДЕ
	               |	Контрагенты.Ссылка = &Ссылка";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка",Контрагент);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	ИНН = Выборка.ИНН;

	КПП = Выборка.КПП;
	
	НалоговыйНомер = СокрЛП(Выборка.НалоговыйНомер);
	КодАльфа2 = СокрЛП(Выборка.КодАльфа2);
	КодСтраны = СокрЛП(Выборка.КодСтраны);
			
	ИдентификаторЗаполнен = Истина;
	
	Если Выборка.ИностраннаяОрганизация Тогда
		Если НЕ ЗначениеЗаполнено(ИНН) 
			И НЕ ЗначениеЗаполнено(НалоговыйНомер) Тогда
			Если ВыводитьСообщениеОбОшибках Тогда	
				ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Для %1 не удалось сформировать идентификатор плательщика. Не указан ИНН или Налоговый номер.'"),Выборка.Ссылка));
			КонецЕсли;	
			ИдентификаторЗаполнен = Ложь;
		КонецЕсли;
		
		Если НЕ ИдентификаторЗаполнен Тогда 
			Возврат "";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИНН) Тогда
			ИННКПП = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(ИНН,10,"0","Слева")+СтроковыеФункцииКлиентСервер.ДополнитьСтроку(КПП,9,"0","Слева");
			ЕдиныйИдентификатор = "3" + ИННКПП;
		Иначе
			
			СтрокаБуквЦифр = "0123456789АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯABCDEFGHIJKLMNOPQRSTUVWXYZ";
			ЛишниеСимволы = СтрСоединить(СтрРазделить(НалоговыйНомер,СтрокаБуквЦифр,Ложь));
			Если ЗначениеЗаполнено(ЛишниеСимволы) Тогда
				НалоговыйНомер = СтрСоединить(СтрРазделить(НалоговыйНомер,ЛишниеСимволы,Ложь));	
			КонецЕсли;
			
			ЕдиныйИдентификатор = "3" + СтроковыеФункцииКлиентСервер.ДополнитьСтроку(НалоговыйНомер,14,"0","Слева")+КодАльфа2+КодСтраны;	
		КонецЕсли;
	
	Иначе
		Если НЕ ЗначениеЗаполнено(ИНН) Тогда
			Если ВыводитьСообщениеОбОшибках Тогда	
				ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Для %1 не удалось сформировать единый уникальный идентификатор. Не указан ИНН.'"),Выборка.Ссылка));
			КонецЕсли;	
			ИдентификаторЗаполнен = Ложь;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(КПП) Тогда
			Если ВыводитьСообщениеОбОшибках Тогда
				ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Для %1 не удалось сформировать единый уникальный идентификатор. Не указан КПП.'"),Выборка.Ссылка));
			КонецЕсли;	
			ИдентификаторЗаполнен = Ложь;
		КонецЕсли;
		
		Если НЕ ИдентификаторЗаполнен Тогда 
			Возврат "";
		КонецЕсли;
		
		ЕдиныйИдентификатор = "2" + ИНН+КПП;
	КонецЕсли;
	
	Возврат ЕдиныйИдентификатор;
	
КонецФункции

#КонецОбласти

#Область ФормированиеИдентификаторовПоФормату_2_00

Процедура ЗаполнитьИдентификаторыПлательщикаДляГИСГМП_2_00(Квитанция,ТаблицаИдентификаторов,Дата = Неопределено) Экспорт
	
	Плательщик = Квитанция.Плательщик;
	Если НЕ ЗначениеЗаполнено(Плательщик) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ТаблицаИдентификаторов)<>Тип("ТаблицаЗначений") Тогда
		Возврат;
	КонецЕсли;
	
	Если ТаблицаИдентификаторов.Количество()=0 Тогда
		Возврат;
	КонецЕсли;
	
	Квитанция.ОсновнойИдентификаторПлательщика = "";
	Квитанция.ДополнительныйИдентификаторПлательщика = "";
	
	//У юр. лица может быть только единый идентификатор
	Если Плательщик.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо
		ИЛИ (Плательщик.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо
			И ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Плательщик,"ЮридическоеФизическоеЛицо.ОГРНИП"))) Тогда
		//сначала проверим, что это юр. лицо.
		//Если это юр. лицо и единый идентификатор есть в таблице, то попробуем его сформировать
		Если ТаблицаИдентификаторов.Найти(Справочники.ВидыАльтернативныхИдентификаторовПолучателейГосуслуг.ПустаяСсылка(),"ВидАльтИдентификатора")<>Неопределено Тогда
		
			Квитанция.ОсновнойИдентификаторПлательщика = СформироватьОсновнойИдентификаторЮрЛица_2_00(Плательщик, Ложь);
			
			Если ЗначениеЗаполнено(Квитанция.ОсновнойИдентификаторПлательщика) Тогда
				
				Если Лев(Квитанция.ОсновнойИдентификаторПлательщика,1) = "1" Тогда
					//физлица
					Квитанция.АльтернативныйИдентификаторПлательщика = ПреобразоватьИдентификаторПлательщикаИз20В116(Квитанция.ОсновнойИдентификаторПлательщика);
				Иначе
					Квитанция.ЕдиныйИдентификаторПлательщика = ПреобразоватьИдентификаторПлательщикаИз20В116(Квитанция.ОсновнойИдентификаторПлательщика);
				КонецЕсли;			
				
			КонецЕсли;
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
    //Заполняем идентификаторы по таблице.
	
	Если Дата=Неопределено Тогда
		Дата = Квитанция.Дата;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаИдентификаторов.ВидАльтИдентификатора,
		|	ТаблицаИдентификаторов.Префикс,
		|	ТаблицаИдентификаторов.Порядок
		|ПОМЕСТИТЬ ВремТаб
		|ИЗ
		|	&ТаблицаИдентификаторов КАК ТаблицаИдентификаторов
		|;
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВремТаб.ВидАльтИдентификатора,
		|	ВремТаб.Префикс,
		|	ВремТаб.Порядок КАК Порядок,
		|	ЕСТЬNULL(АльтернативныеИдентификаторыПолучателейГосуслуг.АльтернативныйИдентификатор, """") КАК АльтернативныйИдентификатор,		
		|	ЕСТЬNULL(ДокументыФизическихЛицСрезПоследних.Серия, """") КАК Серия,
		|	ЕСТЬNULL(ДокументыФизическихЛицСрезПоследних.Номер, """") КАК Номер
		|ИЗ
		|	ВремТаб КАК ВремТаб
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АльтернативныеИдентификаторыПолучателейГосуслуг КАК АльтернативныеИдентификаторыПолучателейГосуслуг
		|		ПО ВремТаб.ВидАльтИдентификатора = АльтернативныеИдентификаторыПолучателейГосуслуг.ВидАльтернативногоИдентификатора
		|			И (АльтернативныеИдентификаторыПолучателейГосуслуг.ФизическоеЛицо = &ФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыФизическихЛиц.СрезПоследних КАК ДокументыФизическихЛицСрезПоследних
		|		ПО ВремТаб.Префикс = ДокументыФизическихЛицСрезПоследних.ВидДокумента.КодФК
		|			И (ДокументыФизическихЛицСрезПоследних.Физлицо = &ФизЛицо)	
		|
		|УПОРЯДОЧИТЬ ПО
		|	Порядок";
		
	ФизЛицо = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Плательщик,"ЮридическоеФизическоеЛицо");
	
	Запрос.УстановитьПараметр("ТаблицаИдентификаторов", ТаблицаИдентификаторов);
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Плательщик", Плательщик);
	Запрос.УстановитьПараметр("ФизЛицо", ФизЛицо);

	Результат = Запрос.Выполнить();
	
	//По форматам 2.00 ИС РНИП и ГИС ГМП следующие виды документов разрешены:
	МассивКодовФК = Новый Массив;
	МассивКодовФК.Добавить("01");
	МассивКодовФК.Добавить("02");
	МассивКодовФК.Добавить("03");
	МассивКодовФК.Добавить("04");
	МассивКодовФК.Добавить("05");
	МассивКодовФК.Добавить("06");
	МассивКодовФК.Добавить("07");
	МассивКодовФК.Добавить("08");
	МассивКодовФК.Добавить("09");
	МассивКодовФК.Добавить("10");
	МассивКодовФК.Добавить("11");
	МассивКодовФК.Добавить("12");
	МассивКодовФК.Добавить("13");
	МассивКодовФК.Добавить("14");
	МассивКодовФК.Добавить("15"); 
	//16-20 - зарезервировано
	
	МассивКодовФК.Добавить("21");
	МассивКодовФК.Добавить("22");
	//23 - зарезервивовано	
	МассивКодовФК.Добавить("24");
	МассивКодовФК.Добавить("25");
	МассивКодовФК.Добавить("26");
	МассивКодовФК.Добавить("27");
	МассивКодовФК.Добавить("28");
	МассивКодовФК.Добавить("29");
	МассивКодовФК.Добавить("30");
	//31 - 99 зарезервивовано
		
	ВыборкаДетальныеЗаписи = Результат.Выбрать();

	ВидНовогоАльтИдентификатора = Неопределено;
	НовыйАльтИдентификатор = "";
	
	СтрокаБуквЦифр = "0123456789АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯABCDEFGHIJKLMNOPQRSTUVWXYZ";
	
	//Обходим результат по приоритету
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Префикс)
			И МассивКодовФК.Найти(ВыборкаДетальныеЗаписи.Префикс)=Неопределено Тогда
			//Нельзя использовать некоторые коды, они зарезервивованы
			Продолжить;
		КонецЕсли;		
		
		//Если префикс не заполнен, самостоятельно сформировать не сможем
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Префикс) Тогда
			//"1" + Префикс + НомерСерия		
			
			Если ВыборкаДетальныеЗаписи.Префикс = "21" Тогда
				//это идентификатор по ИНН
				ИНН = СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ФизЛицо,"ИНН"));
				Если ЗначениеЗаполнено(ИНН) Тогда
					ВидНовогоАльтИдентификатора = ВыборкаДетальныеЗаписи.ВидАльтИдентификатора;
					НовыйАльтИдентификатор = "121"+ СтроковыеФункцииКлиентСервер.ДополнитьСтроку(ИНН,19);
					//Заполняем 2 идентификатора - основной и дополнительный.
					//Как заполнены оба - прерываемся
					ЗаписатьНовыйИдентификатор(ВидНовогоАльтИдентификатора,НовыйАльтИдентификатор,ФизЛицо);
					
					Если НЕ ЗначениеЗаполнено(Квитанция.ОсновнойИдентификаторПлательщика) Тогда
						Квитанция.ОсновнойИдентификаторПлательщика = НовыйАльтИдентификатор;
					ИначеЕсли НЕ ЗначениеЗаполнено(Квитанция.ДополнительныйИдентификаторПлательщика)
						И Квитанция.ОсновнойИдентификаторПлательщика <> НовыйАльтИдентификатор Тогда
						Квитанция.ДополнительныйИдентификаторПлательщика = НовыйАльтИдентификатор;
						Прервать;
					КонецЕсли;
					
				КонецЕсли;
			ИначеЕсли ВыборкаДетальныеЗаписи.Префикс = "14" Тогда
				//это идентификатор по СНИЛС
				СНИЛС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ФизЛицо,"СтраховойНомерПФР");
				СНИЛС = СтрЗаменить(СНИЛС,"-","");
				СНИЛС = СтрЗаменить(СНИЛС," ","");
				Если ЗначениеЗаполнено(СНИЛС) Тогда
					ВидНовогоАльтИдентификатора = ВыборкаДетальныеЗаписи.ВидАльтИдентификатора;
					НовыйАльтИдентификатор = "114"+ СтроковыеФункцииКлиентСервер.ДополнитьСтроку(СНИЛС,19);
					//Заполняем 2 идентификатора - основной и дополнительный.
					//Как заполнены оба - прерываемся
					ЗаписатьНовыйИдентификатор(ВидНовогоАльтИдентификатора,НовыйАльтИдентификатор,ФизЛицо);
					
					Если НЕ ЗначениеЗаполнено(Квитанция.ОсновнойИдентификаторПлательщика) Тогда
						Квитанция.ОсновнойИдентификаторПлательщика = НовыйАльтИдентификатор;
					ИначеЕсли НЕ ЗначениеЗаполнено(Квитанция.ДополнительныйИдентификаторПлательщика)
						И Квитанция.ОсновнойИдентификаторПлательщика <> НовыйАльтИдентификатор Тогда
						Квитанция.ДополнительныйИдентификаторПлательщика = НовыйАльтИдентификатор;
						Прервать;
					КонецЕсли;
				КонецЕсли;
			Иначе
				//Если это не идентификатор по ИНН, то пробуем его сформировать по серии и номеру документа и коду страны
				Если (ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Серия) 
					ИЛИ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Номер)) 
					И ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Префикс) Тогда
					
					НомерПриведенный = "";
					Для инд = 1 по СтрДлина(ВыборкаДетальныеЗаписи.Номер) Цикл
						ТекСимвол = ВРег(Сред(ВыборкаДетальныеЗаписи.Номер,инд,1));
						Если Найти(СтрокаБуквЦифр,ТекСимвол)>0 Тогда
							НомерПриведенный = НомерПриведенный+ТекСимвол;
						КонецЕсли;
					КонецЦикла;
					
					СерияПриведенная = "";
					Для инд = 1 по СтрДлина(ВыборкаДетальныеЗаписи.Серия) Цикл
						ТекСимвол = ВРег(Сред(ВыборкаДетальныеЗаписи.Серия,инд,1));
						Если Найти(СтрокаБуквЦифр,ТекСимвол)>0 Тогда
							СерияПриведенная = СерияПриведенная+ТекСимвол;
						КонецЕсли;
					КонецЦикла;
					Если ЗначениеЗаполнено(НомерПриведенный) ИЛИ ЗначениеЗаполнено(СерияПриведенная) Тогда 
						ВидНовогоАльтИдентификатора = ВыборкаДетальныеЗаписи.ВидАльтИдентификатора;
						НовыйАльтИдентификатор = "1" + ВыборкаДетальныеЗаписи.Префикс + СтроковыеФункцииКлиентСервер.ДополнитьСтроку(СерияПриведенная+НомерПриведенный,19);
						//Заполняем 2 идентификатора - основной и дополнительный.
						//Как заполнены оба - прерываемся
						ЗаписатьНовыйИдентификатор(ВидНовогоАльтИдентификатора,НовыйАльтИдентификатор,ФизЛицо);
						
						Если НЕ ЗначениеЗаполнено(Квитанция.ОсновнойИдентификаторПлательщика) Тогда
							Квитанция.ОсновнойИдентификаторПлательщика = НовыйАльтИдентификатор;
						ИначеЕсли НЕ ЗначениеЗаполнено(Квитанция.ДополнительныйИдентификаторПлательщика)
							И Квитанция.ОсновнойИдентификаторПлательщика <> НовыйАльтИдентификатор Тогда
							Квитанция.ДополнительныйИдентификаторПлательщика = НовыйАльтИдентификатор;
							Прервать;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;

			КонецЕсли;
		КонецЕсли;
		
		//Если идентификатор ранее был задан, то присвоим его
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.АльтернативныйИдентификатор) Тогда
			РанееЗаданныйИдентификатор = ПреобразоватьИдентификаторПлательщикаВФормат20(ВыборкаДетальныеЗаписи.АльтернативныйИдентификатор);
			Если НЕ ЗначениеЗаполнено(Квитанция.ОсновнойИдентификаторПлательщика) Тогда
				Квитанция.ОсновнойИдентификаторПлательщика = РанееЗаданныйИдентификатор;
			ИначеЕсли НЕ ЗначениеЗаполнено(Квитанция.ДополнительныйИдентификаторПлательщика)
				И Квитанция.ОсновнойИдентификаторПлательщика <> РанееЗаданныйИдентификатор Тогда
				Квитанция.ДополнительныйИдентификаторПлательщика = РанееЗаданныйИдентификатор;
				Прервать;
			КонецЕсли; 
		КонецЕсли;
	КонецЦикла;	
	
	//при заполнении идентификатора по формату 2.0, заполним идентификатор по формату 1.16 - т.к. пока действуют оба формата
	Если ЗначениеЗаполнено(Квитанция.ОсновнойИдентификаторПлательщика) Тогда
			
		Если Лев(Квитанция.ОсновнойИдентификаторПлательщика,1) = "1" Тогда
			//физлица
			Квитанция.АльтернативныйИдентификаторПлательщика = ПреобразоватьИдентификаторПлательщикаИз20В116(Квитанция.ОсновнойИдентификаторПлательщика);
		Иначе
			Квитанция.ЕдиныйИдентификаторПлательщика = ПреобразоватьИдентификаторПлательщикаИз20В116(Квитанция.ОсновнойИдентификаторПлательщика);
		КонецЕсли;			
		
	КонецЕсли;
		
    УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

Функция ЗаполнитьОдинИдентификаторПлательщика_2_00(Плательщик,ВидИдентификатора,Дата) Экспорт
	
	СтруктураОтвета = Новый Структура("Результат,Текст,Идентификатор",Ложь,"","");
	
	Если НЕ ЗначениеЗаполнено(Плательщик) Тогда
		СтруктураОтвета.Текст = НСтр("ru='Не заполнен плательщик'");
		Возврат СтруктураОтвета;
	КонецЕсли;
	
	Если ВидИдентификатора = Справочники.ВидыАльтернативныхИдентификаторовПолучателейГосуслуг.ПустаяСсылка() Тогда
		ТекИдентификатор = СформироватьОсновнойИдентификаторЮрЛица_2_00(Плательщик, Ложь);
		Если ЗначениеЗаполнено(ТекИдентификатор) Тогда
			СтруктураОтвета.Идентификатор = ТекИдентификатор;
			СтруктураОтвета.Результат = Истина;
		КонецЕсли;
		Возврат СтруктураОтвета;
	КонецЕсли;
	
	//Нельзя для юр лиц альтернативные идентификаторы
	Если Плательщик.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
		Возврат СтруктураОтвета;
	КонецЕсли;
	
    //Заполняем идентификатор по таблице.
		
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВидыАльтернативныхИдентификаторовПолучателейГосуслуг.Префикс,
		|	ВидыАльтернативныхИдентификаторовПолучателейГосуслуг.Ссылка КАК ВидАльтИдентификатора
		|ПОМЕСТИТЬ ВремТаб
		|ИЗ
		|	Справочник.ВидыАльтернативныхИдентификаторовПолучателейГосуслуг КАК ВидыАльтернативныхИдентификаторовПолучателейГосуслуг
		|ГДЕ
		|	ВидыАльтернативныхИдентификаторовПолучателейГосуслуг.Ссылка = &ВидИдентификатора
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВремТаб.ВидАльтИдентификатора,
		|	ВремТаб.Префикс,
		|	ЕСТЬNULL(АльтернативныеИдентификаторыПолучателейГосуслуг.АльтернативныйИдентификатор, """") КАК АльтернативныйИдентификатор,
		|	ЕСТЬNULL(ДокументыФизическихЛицСрезПоследних.Серия, """") КАК Серия,
		|	ЕСТЬNULL(ДокументыФизическихЛицСрезПоследних.Номер, """") КАК Номер
		|ИЗ
		|	ВремТаб КАК ВремТаб
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.АльтернативныеИдентификаторыПолучателейГосуслуг КАК АльтернативныеИдентификаторыПолучателейГосуслуг
		|		ПО ВремТаб.ВидАльтИдентификатора = АльтернативныеИдентификаторыПолучателейГосуслуг.ВидАльтернативногоИдентификатора
		|			И (АльтернативныеИдентификаторыПолучателейГосуслуг.ФизическоеЛицо = &ФизЛицо)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыФизическихЛиц.СрезПоследних КАК ДокументыФизическихЛицСрезПоследних
		|		ПО ВремТаб.Префикс = ДокументыФизическихЛицСрезПоследних.ВидДокумента.КодФК
		|			И (ДокументыФизическихЛицСрезПоследних.Физлицо = &ФизЛицо)";
		
	ФизЛицо = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Плательщик,"ЮридическоеФизическоеЛицо");
	
	Запрос.УстановитьПараметр("ВидИдентификатора", ВидИдентификатора);
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Плательщик", Плательщик);
	Запрос.УстановитьПараметр("ФизЛицо", ФизЛицо);

	Результат = Запрос.Выполнить();
	
	//По форматам 2.00 ИС РНИП и ГИС ГМП следующие виды документов разрешены:
	МассивКодовФК = Новый Массив;
	МассивКодовФК.Добавить("01");
	МассивКодовФК.Добавить("02");
	МассивКодовФК.Добавить("03");
	МассивКодовФК.Добавить("04");
	МассивКодовФК.Добавить("05");
	МассивКодовФК.Добавить("06");
	МассивКодовФК.Добавить("07");
	МассивКодовФК.Добавить("08");
	МассивКодовФК.Добавить("09");
	МассивКодовФК.Добавить("10");
	МассивКодовФК.Добавить("11");
	МассивКодовФК.Добавить("12");
	МассивКодовФК.Добавить("13");
	МассивКодовФК.Добавить("14");
	МассивКодовФК.Добавить("15"); 
	//16-20 - зарезервировано
	
	МассивКодовФК.Добавить("21");
	МассивКодовФК.Добавить("22");
	//23 - зарезервивовано	
	МассивКодовФК.Добавить("24");
	МассивКодовФК.Добавить("25");
	МассивКодовФК.Добавить("26");
	МассивКодовФК.Добавить("27");
	МассивКодовФК.Добавить("28");
	МассивКодовФК.Добавить("29");
	МассивКодовФК.Добавить("30");
	//31 - 99 зарезервивовано
	
	ВыборкаДетальныеЗаписи = Результат.Выбрать();

	ТекИдентификатор = "";
	
	СтрокаБуквЦифр = "0123456789АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯABCDEFGHIJKLMNOPQRSTUVWXYZ";
	
	//Обходим результат по приоритету
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Префикс)
			И МассивКодовФК.Найти(ВыборкаДетальныеЗаписи.Префикс)=Неопределено Тогда
			//Нельзя использовать некоторые коды, они зарезервивованы
			Продолжить;
		КонецЕсли;
					
		//Если префикс не заполнен, самостоятельно сформировать не сможем
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Префикс) Тогда
							
			Если ВыборкаДетальныеЗаписи.Префикс = "21" Тогда
				//это идентификатор по ИНН
				ИНН = СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ФизЛицо,"ИНН"));
				Если ЗначениеЗаполнено(ИНН) Тогда
					ТекИдентификатор = "121"+ СтроковыеФункцииКлиентСервер.ДополнитьСтроку(ИНН,19);
					СтруктураОтвета.Идентификатор = ТекИдентификатор;
					Прервать;
				КонецЕсли;
			ИначеЕсли ВыборкаДетальныеЗаписи.Префикс = "14" Тогда
				//это идентификатор по СНИЛС
				СНИЛС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ФизЛицо,"СтраховойНомерПФР");
				СНИЛС = СтрЗаменить(СНИЛС,"-","");
				СНИЛС = СтрЗаменить(СНИЛС," ","");
				Если ЗначениеЗаполнено(СНИЛС) Тогда
					
					ТекИдентификатор = "114"+ СтроковыеФункцииКлиентСервер.ДополнитьСтроку(СНИЛС,19);
					СтруктураОтвета.Идентификатор = ТекИдентификатор; 
					Прервать;
				КонецЕсли;	
				
			Иначе
				//Если это не идентификатор по ИНН, то пробуем его сформировать по серии и номеру документа
				Если (ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Серия) 
					ИЛИ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Номер)) 
					И ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Префикс) Тогда
					
					НомерПриведенный = "";
					Для инд = 1 по СтрДлина(ВыборкаДетальныеЗаписи.Номер) Цикл
						ТекСимвол = ВРег(Сред(ВыборкаДетальныеЗаписи.Номер,инд,1));
						Если Найти(СтрокаБуквЦифр,ТекСимвол)>0 Тогда
							НомерПриведенный = НомерПриведенный+ТекСимвол;
						КонецЕсли;
					КонецЦикла;
					
					СерияПриведенная = "";
					Для инд = 1 по СтрДлина(ВыборкаДетальныеЗаписи.Серия) Цикл
						ТекСимвол = ВРег(Сред(ВыборкаДетальныеЗаписи.Серия,инд,1));
						Если Найти(СтрокаБуквЦифр,ТекСимвол)>0 Тогда
							СерияПриведенная = СерияПриведенная+ТекСимвол;
						КонецЕсли;
					КонецЦикла;
					Если ЗначениеЗаполнено(НомерПриведенный) ИЛИ ЗначениеЗаполнено(СерияПриведенная) Тогда 
						ТекИдентификатор = "1"+ВыборкаДетальныеЗаписи.Префикс + СтроковыеФункцииКлиентСервер.ДополнитьСтроку(СерияПриведенная+НомерПриведенный,19);
						СтруктураОтвета.Идентификатор = ТекИдентификатор;
						Прервать;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		//Если идентификатор ранее был задан, то присвоим его и на этом закончим.
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.АльтернативныйИдентификатор) Тогда
			ТекИдентификатор = ПреобразоватьИдентификаторПлательщикаВФормат20(ВыборкаДетальныеЗаписи.АльтернативныйИдентификатор);
			СтруктураОтвета.Идентификатор = ТекИдентификатор;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ЗначениеЗаполнено(ТекИдентификатор) Тогда
		СтруктураОтвета.Результат = Истина;
		НовЗапись = РегистрыСведений.АльтернативныеИдентификаторыПолучателейГосуслуг.СоздатьМенеджерЗаписи();
		НовЗапись.ФизическоеЛицо = ФизЛицо;
		НовЗапись.ВидАльтернативногоИдентификатора = ВидИдентификатора;
		НовЗапись.АльтернативныйИдентификатор = ТекИдентификатор;
		НовЗапись.Записать();
	КонецЕсли;	
		
    УстановитьПривилегированныйРежим(Ложь);
	Возврат СтруктураОтвета;
КонецФункции


Процедура ЗаписатьНовыйИдентификатор(ВидНовогоИдентификатора,НовыйИдентификатор,ФизЛицо)
	Если ЗначениеЗаполнено(ВидНовогоИдентификатора) 
		И ЗначениеЗаполнено(НовыйИдентификатор) Тогда
		
		НовЗапись = РегистрыСведений.АльтернативныеИдентификаторыПолучателейГосуслуг.СоздатьМенеджерЗаписи();
		НовЗапись.ФизическоеЛицо = ФизЛицо;
		НовЗапись.ВидАльтернативногоИдентификатора = ВидНовогоИдентификатора;
		НовЗапись.АльтернативныйИдентификатор = НовыйИдентификатор;
		НовЗапись.Записать();
		
	КонецЕсли;
КонецПроцедуры

Функция СформироватьОсновнойИдентификаторИП(ФизЛицоКонтрагент,ВыводитьСообщениеОбОшибках = Истина) Экспорт
	
	Если ТипЗнч(ФизЛицоКонтрагент) = Тип("СправочникСсылка.Контрагенты") Тогда
		ТекФизЛицо = ФизЛицоКонтрагент.ЮридическоеФизическоеЛицо;
	Иначе
		ТекФизЛицо = ФизЛицоКонтрагент;
	КонецЕсли;

	ТекстЗапроса = "ВЫБРАТЬ
	               |	ФизЛица.Ссылка,
	               |	ФизЛица.ИНН КАК ИНН,
				   |	ФизЛица.ОГРНИП КАК ОГРНИП
	               |ИЗ
	               |	Справочник.ФизическиеЛица КАК ФизЛица
	               |ГДЕ
	               |	ФизЛица.Ссылка = &Ссылка";
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка",ТекФизЛицо);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	ИНН = СокрЛП(Выборка.ИНН);
	
	Если ЗначениеЗаполнено(Выборка.ОГРНИП) И ЗначениеЗаполнено(ИНН) Тогда
		Возврат "4"+СтроковыеФункцииКлиентСервер.ДополнитьСтроку(ИНН,21,"0","Слева");
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

//Формирование идентификатора юр лица по форматам 2.00
Функция СформироватьОсновнойИдентификаторЮрЛица_2_00(Контрагент,ВыводитьСообщениеОбОшибках = Истина) Экспорт
	
	Если Контрагент.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
		 Возврат СформироватьОсновнойИдентификаторИП(Контрагент,ВыводитьСообщениеОбОшибках);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЮридическиеЛица.Ссылка КАК Ссылка,
	               |	ЮридическиеЛица.ИНН КАК ИНН,
	               |	ЮридическиеЛица.КПП КАК КПП,
	               |	ВЫБОР
	               |		КОГДА НЕ ЮридическиеЛица.СтранаРегистрации В (&МассивСтран)
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК ИностраннаяОрганизация,
	               |	ЮридическиеЛица.НалоговыйНомер КАК НалоговыйНомер,
	               |	ЮридическиеЛица.СтранаРегистрации.КодАльфа2 КАК КодАльфа2,
	               |	ЮридическиеЛица.СтранаРегистрации.Код КАК КодСтраны
	               |ИЗ
	               |	Справочник.Контрагенты КАК Контрагенты
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЮридическиеЛица КАК ЮридическиеЛица
	               |		ПО Контрагенты.ЮридическоеФизическоеЛицо = ЮридическиеЛица.Ссылка
	               |ГДЕ
	               |	Контрагенты.Ссылка = &Ссылка";
	
	МассивСтран = Новый Массив;
	МассивСтран.Добавить(Справочники.СтраныМира.Россия);
	МассивСтран.Добавить(Справочники.СтраныМира.ПустаяСсылка());
	
	Запрос.УстановитьПараметр("МассивСтран",МассивСтран);
	Запрос.УстановитьПараметр("Ссылка",Контрагент);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	ИНН = СокрЛП(Выборка.ИНН);
	КПП = СокрЛП(Выборка.КПП);
	НалоговыйНомер = СокрЛП(Выборка.НалоговыйНомер);
	КодАльфа2 = СокрЛП(Выборка.КодАльфа2);
	КодСтраны = СокрЛП(Выборка.КодСтраны);
			
	ИдентификаторЗаполнен = Истина;
	
	Если Выборка.ИностраннаяОрганизация Тогда
		Если НЕ ЗначениеЗаполнено(ИНН) 
			И НЕ ЗначениеЗаполнено(НалоговыйНомер) Тогда
			Если ВыводитьСообщениеОбОшибках Тогда	
				ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Для %1 не удалось сформировать идентификатор плательщика. Не указан ИНН или Налоговый номер.'"),Выборка.Ссылка));
			КонецЕсли;	
			ИдентификаторЗаполнен = Ложь;
		КонецЕсли;
		
		Если НЕ ИдентификаторЗаполнен Тогда 
			Возврат "";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИНН) Тогда
			ИННКПП = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(ИНН,10,"0","Слева")+СтроковыеФункцииКлиентСервер.ДополнитьСтроку(КПП,9,"0","Слева");
			ТекИдентификатор = "300" + ИННКПП;
		Иначе
			
			СтрокаБуквЦифр = "0123456789АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯABCDEFGHIJKLMNOPQRSTUVWXYZ";
			ЛишниеСимволы = СтрСоединить(СтрРазделить(НалоговыйНомер,СтрокаБуквЦифр,Ложь));
			Если ЗначениеЗаполнено(ЛишниеСимволы) Тогда
				НалоговыйНомер = СтрСоединить(СтрРазделить(НалоговыйНомер,ЛишниеСимволы,Ложь));	
			КонецЕсли;
			
			ТекИдентификатор = "300" + СтроковыеФункцииКлиентСервер.ДополнитьСтроку(НалоговыйНомер,14,"0","Слева")+КодАльфа2+КодСтраны;	
		КонецЕсли;
			
	Иначе
		
		Если НЕ ЗначениеЗаполнено(ИНН) Тогда
			Если ВыводитьСообщениеОбОшибках Тогда	
				ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Для %1 не удалось сформировать идентификатор плательщика. Не указан ИНН.'"),Выборка.Ссылка));
			КонецЕсли;	
			ИдентификаторЗаполнен = Ложь;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(КПП) Тогда
			Если ВыводитьСообщениеОбОшибках Тогда
				ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Для %1 не удалось сформировать идентификатор плательщика. Не указан КПП.'"),Выборка.Ссылка));
			КонецЕсли;	
			ИдентификаторЗаполнен = Ложь;
		КонецЕсли;
			
		Если НЕ ИдентификаторЗаполнен Тогда 
			Возврат "";
		КонецЕсли;
		ИННКПП = ИНН+КПП;
		ТекИдентификатор = "2" + СтроковыеФункцииКлиентСервер.ДополнитьСтроку(ИННКПП,21,"0","Слева");
	КонецЕсли;
	
	Возврат ТекИдентификатор;
	
КонецФункции

#КонецОбласти

