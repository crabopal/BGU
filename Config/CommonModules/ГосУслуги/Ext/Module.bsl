		СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",ОбрабатываемыйДокумент);
		Если ДокОбъект.РезультатИмпортаКод = "0" Тогда
			ТекСтатус = Перечисления.СтатусыИсполненияДокумента.НаИсполнении;
		Иначе
			ТекСтатус = Перечисления.СтатусыИсполненияДокумента.ВРаботе;
		КонецЕсли;
		СтруктураРекв.Вставить("Статус",ТекСтатус);
		ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);							
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура ОбработатьРезультатИмпортаСертификата(ИдентификаторСообщенияУчастника,ТекУчастник,ТекстФайла,ЭтоОтветОтЭмулятора)
	
