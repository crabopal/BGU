			Запрос.Текст = Запрос.Текст + Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ "+Символы.ПС;
		КонецЕсли;
		Запрос.Текст = Запрос.Текст + ТекБлокДокумента;

		БлокУслуги = "ОБЪЕДИНИТЬ ВСЕ
