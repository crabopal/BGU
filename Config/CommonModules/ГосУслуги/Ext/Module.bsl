Функция СоздатьОбъектДляПодписиXML_xades() Экспорт
	//создаем объект
	Крипт = НовыйОбъектДляПодписи_xades(Истина);
	Если Крипт = Неопределено Тогда
		
		Если ПодключитьВК_xades(Истина) Тогда
			
			Крипт = НовыйОбъектДляПодписи_xades(Ложь);
			Если Крипт = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
						
		Иначе
			
			Возврат Неопределено;
			
		КонецЕсли;
		
	КонецЕсли;
	
	//Если подписывать нужно на сервере с ОС Linux, нужно установить путь к модулю криптографии.
	Если ОбщегоНазначения.ЭтоLinuxСервер() Тогда
		//из документации БСП - глава 5, электронные подписи - Установка приложений электронной подписи в клиент-серверном варианте работы
		//Для Linux:
        //	/opt/cprocsp/lib/amd64/libcapilite.so:/opt/cprocsp/lib/amd64/libcapi10.so:/opt/cprocsp/lib/amd64/libcapi20.so
        //Для MacOS:
		//	/opt/cprocsp/lib/libcapi10.dylib:/opt/cprocsp/lib/libcapi20.dylib:/opt/cprocsp/lib/libcapi10.4.dylib:/opt/cprocsp/lib/libcapi20.4.dylib
		ПутиПоУмолчанию = "/opt/cprocsp/lib/amd64/libcapilite.so:/opt/cprocsp/lib/amd64/libcapi10.so:/opt/cprocsp/lib/amd64/libcapi20.so";
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ПутиКПрограммамЭлектроннойПодписиИШифрованияНаСерверахLinux.Программа КАК Программа,
			|	ПутиКПрограммамЭлектроннойПодписиИШифрованияНаСерверахLinux.ПутьКПрограмме КАК ПутьКПрограмме
			|ИЗ
			|	РегистрСведений.ПутиКПрограммамЭлектроннойПодписиИШифрованияНаСерверахLinux КАК ПутиКПрограммамЭлектроннойПодписиИШифрованияНаСерверахLinux
			|ГДЕ
			|	ПутиКПрограммамЭлектроннойПодписиИШифрованияНаСерверахLinux.ИмяКомпьютера = &ИмяКомпьютера";
		
		Запрос.УстановитьПараметр("ИмяКомпьютера", ИмяКомпьютера());
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			МенеджерКриптографии = ЭлектроннаяПодпись.МенеджерКриптографии("",Ложь,"",ВыборкаДетальныеЗаписи.Программа);
			Если МенеджерКриптографии <> Неопределено Тогда
				Крипт.Криптопровайдер = ВыборкаДетальныеЗаписи.ПутьКПрограмме;
				Прервать;
			КонецЕсли;
			МенеджерКриптографии = Неопределено;
		КонецЦикла;
		//если не получилось заполнить по регистру, заполним по умолчанию
		Если Не ЗначениеЗаполнено(Крипт.Криптопровайдер) Тогда 
			Крипт.Криптопровайдер = ПутиПоУмолчанию;
		КонецЕсли;
	КонецЕсли;
	//
	
	Возврат Крипт;
	
КонецФункции

Функция НовыйОбъектДляПодписи_xades(ТихийРежим = Истина)
	
	Попытка
		
		Крипт = Новый("Addin.Xades2AddIn.Xades2AddIn");                //
		Возврат Крипт;
		
	Исключение
		
		Если НЕ ТихийРежим Тогда
			ТекстСообщения = НСтр("ru='Не удалось создать объект для подписи xml файлов в формате XadES-T.'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
		
		Возврат Неопределено;
		
	КонецПопытки;
	
КонецФункции


//

Функция ПолучитьДанныеПодготовкиСпискаЗаданий(СписокЗаданий,НастройкаОбмена) Экспорт
	
	СоответствиеДанных = Новый Соответствие;
	СоответствиеДанных.Вставить("НужнаПодготовка",Истина);
	
	МассивПараметров = Новый Массив;
	МассивПараметров.Добавить("ОтпечатокСущностей");
	МассивПараметров.Добавить("ОтпечатокЗаголовка");
	
	//Это на сервере
	СоответствиеПараметров = Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПолучитьПараметрыНастройкиОбмена(МассивПараметров,НастройкаОбмена);
	
	ОтпечатокПодписиСущностей = СоответствиеПараметров.Получить("ОтпечатокСущностей");
	
	ОтпечатокПодписиЗаголовка = СоответствиеПараметров.Получить("ОтпечатокЗаголовка");
	
	Если ОтпечатокПодписиСущностей <> Неопределено Тогда
		СоответствиеПараметров.Вставить("ОтпечатокСущностей",ОтпечатокПодписиСущностей);
	КонецЕсли;
	Если ОтпечатокПодписиЗаголовка <> Неопределено Тогда
		СоответствиеПараметров.Вставить("ОтпечатокЗаголовка",ОтпечатокПодписиЗаголовка);
	КонецЕсли;
	
	СоответствиеДанных.Вставить("СоответствиеПараметров",СоответствиеПараметров);
	
	Если ОтпечатокПодписиСущностей = Неопределено И ОтпечатокПодписиЗаголовка = Неопределено Тогда
		//В параметрах не указано, что необходимо что-то подписывать, значит и подписывать ничего не будем
		СоответствиеДанных.Вставить("НужнаПодготовка",Ложь);
		Возврат СоответствиеДанных;
	КонецЕсли;
	
	//Это на сервере
	СоответствиеЗаданийФайлам = Новый Соответствие;
	Для Каждого СтрокаСписка ИЗ СписокЗаданий Цикл
		
		ФайлыДляПереноса = Новый Массив;
		РаботаСФайлами.ЗаполнитьПрисоединенныеФайлыКОбъекту(СтрокаСписка.Значение,ФайлыДляПереноса);
		
		ФайлыДанных = Новый Соответствие;
		
		Для Каждого ФайлПереноса Из ФайлыДляПереноса Цикл
			
			ДанныеФайла = РаботаСФайлами.ДанныеФайла(ФайлПереноса);	
			ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
			ПолучитьИзВременногоХранилища(ДанныеФайла.СсылкаНаДвоичныеДанныеФайла).Записать(ИмяВременногоФайла);
						
			ТекстовыйФайл = Новый ЧтениеТекста(ИмяВременногоФайла, КодировкаТекста.UTF8);
			СодержимоеФайла = ТекстовыйФайл.Прочитать();
			
	        ФайлыДанных.Вставить(ФайлПереноса,СодержимоеФайла);
			
		    ТекстовыйФайл.Закрыть();
			УдалитьФайлы(ИмяВременногоФайла);

		КонецЦикла;
		СоответствиеЗаданийФайлам.Вставить(СтрокаСписка.Значение,ФайлыДанных);
	КонецЦикла;
	
	СоответствиеДанных.Вставить("ЗаданияИФайлы",СоответствиеЗаданийФайлам);
	
	Возврат СоответствиеДанных;
	
КонецФункции

Функция ПродолжениеПодготовкиФайлов(СоответствиеОбновленныхФайлов,СоответствиеРезультатовПодготовки, МассивНеПодписанных) Экспорт
	
	Если СоответствиеОбновленныхФайлов.Количество()>0 Тогда
		//Записать изменения
		ОбновитьПрисоединенныеФайлы(СоответствиеОбновленныхФайлов);
	КонецЕсли;
	ТаблицаЗначений = Новый ТаблицаЗначений;
	ТаблицаЗначений.Колонки.Добавить("ПолеФайла");
	ТаблицаЗначений.Колонки.Добавить("Ошибка");
	ЕстьОшибки = Ложь;
	
	
	
	Для Каждого ГлКлючИЗначение Из СоответствиеРезультатовПодготовки Цикл
		ЗаданиеСсылка = ГлКлючИЗначение.Ключ;
		СоответствиеОшибок = ГлКлючИЗначение.Значение;
		Если СоответствиеОшибок.Количество()>0 Тогда
			ЗаданиеОбъект = ЗаданиеСсылка.ПолучитьОбъект();
			НужноУдалитьФайлы = Ложь;
			Если МассивНеПодписанных.Найти(ЗаданиеСсылка)<> Неопределено Тогда
				НужноУдалитьФайлы = Истина;
			КонецЕсли;
			Для Каждого КлючИЗначение Из СоответствиеОшибок Цикл
				ДанныеФайла = РаботаСФайлами.ДанныеФайла(КлючИЗначение.Ключ);
				СтрокаТЧ = ЗаданиеОбъект.ОбъектыОбмена.Найти(ДанныеФайла.ИмяФайла,"ИмяФайлаВыгрузки");
				Если СтрокаТЧ<>Неопределено Тогда
					Если СтрокаТЧ.Описание = "Подробно..." Тогда
						ЕстьОшибки = Истина;
						ТаблицаОшибок = ЗначениеИзСтрокиВнутр(СтрокаТЧ.ОписаниеОшибки);
					Иначе
						ТаблицаОшибок = ТаблицаЗначений.Скопировать();
					КонецЕсли;
					НовСтр = ТаблицаОшибок.Добавить();
					НовСтр.ПолеФайла = "Ошибка подготовки файла к отправке";
					НовСтр.Ошибка = КлючИЗначение.Значение;
					СтрокаТЧ.Описание = "Подробно...";
					СтрокаТЧ.ОписаниеОшибки = ЗначениеВСтрокуВнутр(ТаблицаОшибок);
					ЕстьОшибки = Истина;
				КонецЕсли;
			КонецЦикла;
			Если НужноУдалитьФайлы Тогда
				ЗаданиеОбъект.УдалитьВсеПодчиненныйФайлы();
			КонецЕсли;
			ЗаданиеОбъект.Записать();

		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ЕстьОшибки;
	
КонецФункции

Функция ПродолжениеПодготовкиФайлов_1_16(СоответствиеРезультатовПодготовки) Экспорт
	
	ТаблицаЗначений = Новый ТаблицаЗначений;
	ТаблицаЗначений.Колонки.Добавить("ПолеФайла");
	ТаблицаЗначений.Колонки.Добавить("Ошибка");
	ЕстьОшибки = Ложь;
		
	Для Каждого ГлКлючИЗначение Из СоответствиеРезультатовПодготовки Цикл
		ЗаданиеСсылка = ГлКлючИЗначение.Ключ;
		СтруктураРезультата = ГлКлючИЗначение.Значение;
		Если СтруктураРезультата.Результат = Ложь Тогда
			ЗаданиеОбъект = ЗаданиеСсылка.ПолучитьОбъект();
			Если ЗначениеЗаполнено(СтруктураРезультата.ИмяФайла) Тогда
				ДанныеФайла = РаботаСФайлами.ДанныеФайла(СтруктураРезультата.ИмяФайла);
			    СтрокаТЧ = ЗаданиеОбъект.ОбъектыОбмена.Найти(ДанныеФайла.ИмяФайла,"ИмяФайлаВыгрузки");
			Иначе
				СтрокаТЧ = ЗаданиеОбъект.ОбъектыОбмена[0];
			КонецЕсли;
			Если СтрокаТЧ.Описание = "Подробно..." Тогда
				ТаблицаОшибок = ЗначениеИзСтрокиВнутр(СтрокаТЧ.ОписаниеОшибки);
			Иначе
				ТаблицаОшибок = ТаблицаЗначений.Скопировать();
			КонецЕсли;
			НовСтр = ТаблицаОшибок.Добавить();
			НовСтр.ПолеФайла = "Ошибка подготовки файла к отправке";
			НовСтр.Ошибка = СтруктураРезультата.ТекстОшибки;
			СтрокаТЧ.Описание = "Подробно...";
			СтрокаТЧ.ОписаниеОшибки = ЗначениеВСтрокуВнутр(ТаблицаОшибок);
					
			ЗаданиеОбъект.УдалитьВсеПодчиненныйФайлы();
			
			ЗаданиеОбъект.Записать();
			ЕстьОшибки = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ЕстьОшибки;
	
КонецФункции

Процедура ОбновитьПрисоединенныеФайлы(СоответствиеОбновляемыхФайлов) Экспорт
	
	Для Каждого КлючИЗначение Из СоответствиеОбновляемыхФайлов Цикл
	
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
		ТекстовыйФайл = Новый ЗаписьТекста(ИмяВременногоФайла,КодировкаТекста.UTF8);
		ТекстовыйФайл.Записать(КлючИЗначение.Значение);
		ТекстовыйФайл.Закрыть();
		ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВременногоФайла);
		ИнформацияОФайле = Новый Структура("АдресФайлаВоВременномХранилище,АдресВременногоХранилищаТекста");
		ИнформацияОФайле.АдресФайлаВоВременномХранилище = ПоместитьВоВременноеХранилище(ДвоичныеДанные);
		РаботаСФайлами.ОбновитьФайл(КлючИЗначение.Ключ,ИнформацияОФайле);
		УдалитьФайлы(ИмяВременногоФайла);	
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработатьОтветИзСервиса(ЗаданиеНаЭкспорт) Экспорт
	
	ТаблицаЗначений = Новый ТаблицаЗначений;
	ТаблицаЗначений.Колонки.Добавить("ПолеФайла");
	ТаблицаЗначений.Колонки.Добавить("Ошибка");
	
	Для Каждого СтрокаРезультата Из ЗаданиеНаЭкспорт.ОбъектыОбмена Цикл
		ЕстьОшибки = Ложь;
				
		Если СтрокаРезультата.Описание = "Подробно..." Тогда
			ЕстьОшибки = Истина;
			ТаблицаОшибок = ЗначениеИзСтрокиВнутр(СтрокаРезультата.ОписаниеОшибки);
		Иначе
			ТаблицаОшибок = ТаблицаЗначений.Скопировать();
		КонецЕсли;
		ОтветИзСервиса = СтрокаРезультата.ОтветWebСервиса.Получить();
		ОтветИзСервисаНижнийРегистр = НРег(ОтветИзСервиса);

		
		Поз = Найти(ОтветИзСервисаНижнийРегистр,НРег("RequestProcessResult"));
		Если Поз > 0 Тогда
			ЕстьОшибки = Истина;
			
			ПозНКодОшибки = Найти(ОтветИзСервисаНижнийРегистр,НРег("<ErrorCode>"))+11;
			ПозККодОшибки = Найти(ОтветИзСервисаНижнийРегистр,НРег("</ErrorCode>"));
			КодОшибки = Сред(ОтветИзСервиса,ПозНКодОшибки,ПозККодОшибки-ПозНКодОшибки);
				
			ПозНОписаниеОшибки = Найти(ОтветИзСервисаНижнийРегистр,НРег("<ErrorDescription>"))+18;
			ПозКОписаниеОшибки = Найти(ОтветИзСервисаНижнийРегистр,НРег("</ErrorDescription>"));
			ОписаниеОшибки = Сред(ОтветИзСервиса,ПозНОписаниеОшибки,ПозКОписаниеОшибки-ПозНОписаниеОшибки);
			
			НовСтр = ТаблицаОшибок.Добавить();  
			НовСтр.Ошибка = "Код ошибки " + КодОшибки + ", "+ОписаниеОшибки;
			СтрокаРезультата.Описание = "Подробно...";
			СтрокаРезультата.ОписаниеОшибки = ЗначениеВСтрокуВнутр(ТаблицаОшибок);
		КонецЕсли;
		
		Поз = Найти(ОтветИзСервисаНижнийРегистр,НРег("RequestProcessResult"));
		Если Поз > 0 Тогда
			ЕстьОшибки = Истина;
			
			ПозНКодОшибки = Найти(ОтветИзСервисаНижнийРегистр,НРег("<ErrorCode>"))+11;
			ПозККодОшибки = Найти(ОтветИзСервисаНижнийРегистр,НРег("</ErrorCode>"));
			КодОшибки = Сред(ОтветИзСервиса,ПозНКодОшибки,ПозККодОшибки-ПозНКодОшибки);
				
			ПозНОписаниеОшибки = Найти(ОтветИзСервисаНижнийРегистр,НРег("<ErrorDescription>"))+18;
			ПозКОписаниеОшибки = Найти(ОтветИзСервисаНижнийРегистр,НРег("</ErrorDescription>"));
			ОписаниеОшибки = Сред(ОтветИзСервиса,ПозНОписаниеОшибки,ПозКОписаниеОшибки-ПозНОписаниеОшибки);
			
			НовСтр = ТаблицаОшибок.Добавить();  
			НовСтр.Ошибка = "Код ошибки " + КодОшибки + ", "+ОписаниеОшибки;
			СтрокаРезультата.Описание = "Подробно...";
			СтрокаРезультата.ОписаниеОшибки = ЗначениеВСтрокуВнутр(ТаблицаОшибок);
		КонецЕсли;
		
		Поз = Найти(ОтветИзСервисаНижнийРегистр,НРег(":Fault>"));
		Если Поз > 0 Тогда
			ЕстьОшибки = Истина;
				
			ПозНОписаниеОшибки = Найти(ОтветИзСервисаНижнийРегистр,"<faultstring>")+13;
			ПозКОписаниеОшибки = Найти(ОтветИзСервисаНижнийРегистр,"</faultstring>");
			ОписаниеОшибки = Сред(ОтветИзСервиса,ПозНОписаниеОшибки,ПозКОписаниеОшибки-ПозНОписаниеОшибки);
			
			НовСтр = ТаблицаОшибок.Добавить();  
			НовСтр.Ошибка = ОписаниеОшибки;
			СтрокаРезультата.Описание = "Подробно...";
			СтрокаРезультата.ОписаниеОшибки = ЗначениеВСтрокуВнутр(ТаблицаОшибок);
		КонецЕсли;
		
		Если НЕ ЕстьОшибки Тогда
			СтрокаРезультата.Описание = "Операция успешна!";
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Документ " +СтрокаРезультата.Объект+ " отправлен успешно.'"));
        КонецЕсли;
	КонецЦикла; 
		
	//Попытка
	//	ЗаданиеНаЭкспорт.Записать(РежимЗаписиДокумента.Запись);
	//Исключение
	//	ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не удалось записать документ'"));
	//	Возврат;
	//КонецПопытки;
	
КонецПроцедуры

Процедура ОбработатьОтветИзСервиса_1_16(ЗаданиеНаЭкспорт,ТребуетсяЗапрос) Экспорт
	
	ТребуетсяЗапрос = Ложь;	
	НужноПерезаписывать = Ложь;
	НужноФормироватьЗаданиеНаИмпорт = Ложь;
	ФормироватьЗаданиеДляТекФайла = Ложь;
	
	Для Каждого СтрокаРезультата Из ЗаданиеНаЭкспорт.ОбъектыОбмена Цикл
		
		ТаблицаОшибок = ЭкспортФайлов.ПолучитьТаблицуОшибок(СтрокаРезультата);
		//ОтветИзСервиса = СтрокаРезультата.ОтветWebСервиса.Получить();
		ОтветИзСервиса = ЭкспортФайлов.РазобратьОтветИзСервиса(СтрокаРезультата.ОтветWebСервиса, ТаблицаОшибок);
		
		
		ТребуетсяЗапросДляТекФайла = Ложь;
		Для Каждого ДетальныйОтветИзСервиса Из ОтветИзСервиса Цикл
			ФормироватьЗаданиеДляТекФайла = Ложь;
			ТребуетсяЗапросДляТекФайла = Ложь;
			ОбработатьДетальныйОтветИзСервиса(СтрокаРезультата.Объект, ДетальныйОтветИзСервиса, ТаблицаОшибок,ФормироватьЗаданиеДляТекФайла,ТребуетсяЗапросДляТекФайла);
			НужноФормироватьЗаданиеНаИмпорт = НужноФормироватьЗаданиеНаИмпорт ИЛИ ФормироватьЗаданиеДляТекФайла;			
		КонецЦикла;
		
		ТребуетсяЗапрос = ТребуетсяЗапрос ИЛИ ТребуетсяЗапросДляТекФайла;	
				
		
		//ОбработатьДетальныйОтветИзСервиса(СтрокаРезультата.Объект, ОтветИзСервиса, ТаблицаОшибок,ФормироватьЗаданиеДляТекФайла);
		
		НужноФормироватьЗаданиеНаИмпорт = НужноФормироватьЗаданиеНаИмпорт ИЛИ ФормироватьЗаданиеДляТекФайла;
		
		Если ТаблицаОшибок.Количество() > 0 Тогда
			СтрокаРезультата.Описание = "Подробно...";
			СтрокаРезультата.ОписаниеОшибки = ЗначениеВСтрокуВнутр(ТаблицаОшибок);
		Иначе
			СтрокаРезультата.Описание = "Операция успешна!";
			//ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Документ " + СтрокаРезультата.Объект + " отправлен успешно.'"));
		КонецЕсли;	
			
		
	КонецЦикла;
	
	Если НужноФормироватьЗаданиеНаИмпорт Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Документ " + СтрокаРезультата.Объект + " отправлен успешно.'"));
		ЗаданиеНаИмпорт = Документы.ЗаданиеНаИмпортДанныхБанкиКС.СформироватьЗаданиеНаИмпорт(ЗаданиеНаЭкспорт,"",Истина);
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Создан документ " + ЗаданиеНаИмпорт + " для загрузки полученных данных.'"));
		ТекДок = ЗаданиеНаИмпорт.ПолучитьОбъект();
		МассивЗагруженныхДок = Документы.ЗаданиеНаИмпортДанныхБанкиКС.РаспределитьОбъектыПоУчреждениям(ТекДок);
	КонецЕсли;
КонецПроцедуры

Процедура ОбработатьДетальныйОтветИзСервиса(Документ, ОтветWebСервиса, ТаблицаОшибок,НуженИмпорт=Ложь,ТребуетсяЗапрос = Ложь) Экспорт
	
	Если ПустаяСтрока(ОтветWebСервиса.Ответ) Тогда
		ДобавитьОшибку(ТаблицаОшибок, "Сервис дал пустой ответ", ОтветWebСервиса.ИмяФайла);
		Возврат;
	КонецЕсли;
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ОтветWebСервиса.Ответ);
	
	ПостроительDOM = Новый ПостроительDOM;
	Попытка
		ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
	Исключение
		ДобавитьОшибку(ТаблицаОшибок, "Не удалось разобрать ответ", ОтветWebСервиса.ИмяФайла);
		Возврат;		
	КонецПопытки;
	
	//Ошибки СМЭВ:
	ОбъектСхемы = ДокументDOM.ПолучитьЭлементыПоИмени("Fault");
	
	Если ОбъектСхемы.Количество()>0 Тогда
		СтроковоеОписаниеОшибки = "Ошибка СМЭВ. Сообщение не дошло до сервиса.";
		
		УзелСтроковойОшибки = ОбъектСхемы[0].ПолучитьЭлементыПоИмени("faultstring");
		Если УзелСтроковойОшибки.Количество()>0 Тогда
			СтроковоеОписаниеОшибки = УзелСтроковойОшибки[0].ТекстовоеСодержимое;
		КонецЕсли;
		
		ДобавитьОшибку(ТаблицаОшибок, СтроковоеОписаниеОшибки, "СМЭВ вернул ошибку:");
		//нет смысла смотреть дальше
		Возврат;
	КонецЕсли;
	
	//Корректный ответ поставщика об обработке запроса:
	
	ОбъектСхемы = ДокументDOM.ПолучитьЭлементыПоИмени("Ticket");
	
	Если ОбъектСхемы.Количество()>0 Тогда
		ДанныеОбъекта = ОбъектСхемы[0].ПервыйДочерний;
		Если ДанныеОбъекта.ЛокальноеИмя = "RequestProcessResult" Тогда // это результат обработки запроса к системе
			КодРезультата = "";
			ОписаниеРезультата = "";
			ДанныеРезультата = "";
			Для Каждого ТекУзел Из ДанныеОбъекта.ДочерниеУзлы Цикл
				Если ТекУзел.ЛокальноеИмя = "ResultCode" Тогда
					КодРезультата = ТекУзел.ТекстовоеСодержимое; 
				ИначеЕсли ТекУзел.ЛокальноеИмя = "ResultDescription" Тогда
					ОписаниеРезультата = ТекУзел.ТекстовоеСодержимое;
				ИначеЕсли ТекУзел.ЛокальноеИмя = "ResultData" Тогда
					ДанныеРезультата = ТекУзел.ТекстовоеСодержимое;
				КонецЕсли;				
			КонецЦикла;
			
			Если ТипЗнч(Документ) = Тип("ДокументСсылка.ПакетНачислений") Тогда
				
				Если КодРезультата = "0" Тогда
					// Запрос успешно принят. Для пакета начислений в теге ResultData возвращается присвоенный ID пакета.
				
					ДокОбъект = Документ.ПолучитьОбъект();
					
					//Очищаем предыдущий результат обработки, если он был.
					ДокОбъект.РезультатОбработкиОбщий = "";
					Для Каждого СтрТЧ Из ДокОбъект.СоставПакета Цикл
						СтрТЧ.РезультатОбработки = "";			
					КонецЦикла;
					
					ДокОбъект.РегистрационныйНомер = ДанныеРезультата;
					ДокОбъект.СтатусПакета = 1; //в обработке
					
					//Тут имеет смысл изменить статус документов-начислений в т.ч.:
					//если КодРезультата = "0", то из статуса Подготовлен следует устанавливать статус - ПереданВОбработку.
					
					Для Каждого СтрТЧ Из ДокОбъект.СоставПакета Цикл
						СтруктураРекв = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(СтрТЧ.Начисление);
						Если СтруктураРекв.Статус <> Перечисления.СтатусыИсполненияДокумента.Исполнен
							И СтруктураРекв.Статус <> Перечисления.СтатусыИсполненияДокумента.НаИсполнении Тогда
							//Статус меняется только если начисление еще не исполнено/не обработано в другом пакете
							СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",СтрТЧ.Начисление);
							СтруктураРекв.Вставить("Статус",Перечисления.СтатусыИсполненияДокумента.ПереданВОбработку);
						
							ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
						КонецЕсли;
					КонецЦикла;
					
					ДокОбъект.Записать();
					ТекстСообщения = Нстр("ru='Документ """+Документ+""" отправлен успешно и принят в обработку.'");
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
				ИначеЕсли КодРезультата = "50" Тогда
					// пакет еще не обработан
					ТекстСообщения = Нстр("ru='Обработка документа """+Документ+""" не завершена. 
					|Следует повторить запрос через некоторое время.'");
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
				Иначе
					ДокОбъект = Документ.ПолучитьОбъект();
					
					//Очищаем предыдущий результат обработки, если он был.
					ДокОбъект.РезультатОбработкиОбщий = "Код ошибки = "+КодРезультата+", "+ОписаниеРезультата + ": " + ДанныеРезультата;
					
					ДокОбъект.Записать();
					
					ТекстСообщения = Нстр("ru='Документ """+Документ+""" не загружен, код ошибки = "+КодРезультата+", подробнее в документе.'");
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
					
					ДобавитьОшибку(ТаблицаОшибок,ОписаниеРезультата + ": " + ДанныеРезультата,"Код ошибки "+КодРезультата);					
				КонецЕсли;
			
				
			Иначе
				Если КодРезультата = "0" Тогда
					ТекстСообщения = Нстр("ru='Документ """+Документ+""" отправлен успешно.'");
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
				Иначе
					ДобавитьОшибку(ТаблицаОшибок,ОписаниеРезультата + ": " + ДанныеРезультата,"Код ошибки "+КодРезультата);
				КонецЕсли;
				
				
			КонецЕсли;
			
		ИначеЕсли ДанныеОбъекта.ЛокальноеИмя = "PackageProcessResult" Тогда 
			
			Если ТипЗнч(Документ) = Тип("ДокументСсылка.ПакетНачислений") Тогда
				// это результат обработки пакета начислений
				// тут нужно обрабатывать пакет начислений - и для каждого из начислений в пакете писать результат обработки и устанавливать статус
				ТекстСообщения = "Документ """+Документ+""" обработан.";
				
				ДокОбъект = Документ.ПолучитьОбъект();
				ДокОбъект.СтатусПакета = 2; //обработан
				
				ДокОбъект.РезультатОбработкиОбщий = "";
				
				Для Каждого СтрТЧ Из ДокОбъект.СоставПакета Цикл
					СтрТЧ.РезультатОбработки = "";			
				КонецЦикла;
				
				ЭлементыРезультата = ДанныеОбъекта.ПолучитьЭлементыПоИмени("EntityProcessResult");
				
				ЕстьОшибки = Ложь;
				МассивОшибок = Новый Массив;
				Для Каждого ЭлементРезультата Из ЭлементыРезультата Цикл
					ЭлементID = ЭлементРезультата.ПолучитьАтрибут("entityId");
					
					КодРезультата = "";
					ОписаниеРезультата = "";
					ДанныеРезультата = "";
					
					Для Каждого Д_Элемент Из ЭлементРезультата.ДочерниеУзлы Цикл
						Если Д_Элемент.ЛокальноеИмя = "ResultCode" Тогда
							КодРезультата = Д_Элемент.ТекстовоеСодержимое; 
						ИначеЕсли Д_Элемент.ЛокальноеИмя = "ResultDescription" Тогда
							ОписаниеРезультата = Д_Элемент.ТекстовоеСодержимое;
						ИначеЕсли Д_Элемент.ЛокальноеИмя = "ResultData" Тогда
							ДанныеРезультата = Д_Элемент.ТекстовоеСодержимое;
						КонецЕсли;	
						
					КонецЦикла;
					
					Если КодРезультата<>"0" Тогда
						ЕстьОшибки = Истина;
						Если МассивОшибок.Найти(КодРезультата) = Неопределено Тогда
							МассивОшибок.Добавить(КодРезультата);
						КонецЕсли;
					КонецЕсли;
					
					ТекРезультат = "Код = " + КодРезультата + ", " + ОписаниеРезультата + ?(ЗначениеЗаполнено(ДанныеРезультата),": "+ДанныеРезультата,"");
					СтрокаТЧ = ДокОбъект.СоставПакета.Найти(ЭлементID,"ИдСущности");
					
					Если СтрокаТЧ <> Неопределено Тогда
						СтрокаТЧ.РезультатОбработки = СтрокаТЧ.РезультатОбработки + ?(ЗначениеЗаполнено(СтрокаТЧ.РезультатОбработки),Символы.ПС,"") + ТекРезультат;
						
						//Тут имеет смысл изменить статус документов-начислений:
						//если КодРезультата = "0", то из статуса ПереданВОбработку следует устанавливать статус - НаИсполнении или Аннулировано (в зависимости от вида начисления),
						//если КодРезультата <>"0" (то есть ошибка обработки), то из статуса ПереданВОбработку следует устанавливать статус - Подготовлен? или может быть другой?
						
					
						СтруктураРекв = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(СтрокаТЧ.Начисление);
						Если СтруктураРекв.Статус = Перечисления.СтатусыИсполненияДокумента.ПереданВОбработку Тогда
							//Статус начисления меняется только если текущий статус - Передан в обработку 
							СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",СтрокаТЧ.Начисление);
							Если КодРезультата = "0" Тогда
								ТекСтатус = ?(СтрокаТЧ.ВидНачисления=3,Перечисления.СтатусыИсполненияДокумента.Аннулирован,Перечисления.СтатусыИсполненияДокумента.НаИсполнении);
							Иначе
								ТекСтатус = Перечисления.СтатусыИсполненияДокумента.Подготовлен;
							КонецЕсли;
							СтруктураРекв.Вставить("Статус",ТекСтатус);
							ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);							
						КонецЕсли;
					Иначе
						ДокОбъект.РезультатОбработкиОбщий = ДокОбъект.РезультатОбработкиОбщий + ?(ЗначениеЗаполнено(ДокОбъект.РезультатОбработкиОбщий),Символы.ПС,"") + ТекРезультат;					
					КонецЕсли;
				КонецЦикла;
				
				Если ЗначениеЗаполнено(ДокОбъект.РезультатОбработкиОбщий) Тогда
					ТекстСообщения = ТекстСообщения + Символы.ПС + "Результат: " + ДокОбъект.РезультатОбработкиОбщий;
				Иначе
					ТекстСообщения = ТекстСообщения + Символы.ПС + "Результат: " + ?(ЕстьОшибки,"Коды ошибок - "+СтрСоединить(МассивОшибок,", ")+". Подробнее - в пакете начислений.","Начисления загружены без ошибок.");
				КонецЕсли;
				
				ДокОбъект.Записать();
				
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			Иначе
				// это результат обработки запроса на импорт сертификата ЭП
				
				ТекстСообщения = "Документ """+Документ+""" обработан.";
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
				
				РезультатОбработки = "";
				
				ЭлементыРезультата = ДанныеОбъекта.ПолучитьЭлементыПоИмени("EntityProcessResult");
				
				Для Каждого ЭлементРезультата Из ЭлементыРезультата Цикл
					ЭлементID = ЭлементРезультата.ПолучитьАтрибут("entityId");
					
					КодРезультата = "";
					ОписаниеРезультата = "";
					ДанныеРезультата = "";
					
					Для Каждого Д_Элемент Из ЭлементРезультата.ДочерниеУзлы Цикл
						Если Д_Элемент.ЛокальноеИмя = "ResultCode" Тогда
							КодРезультата = Д_Элемент.ТекстовоеСодержимое; 
						ИначеЕсли Д_Элемент.ЛокальноеИмя = "ResultDescription" Тогда
							ОписаниеРезультата = Д_Элемент.ТекстовоеСодержимое;
						ИначеЕсли Д_Элемент.ЛокальноеИмя = "ResultData" Тогда
							ДанныеРезультата = Д_Элемент.ТекстовоеСодержимое;
						КонецЕсли;	
						
					КонецЦикла;
					ТекРезультат = "Результат обработки запроса участника """+ЭлементID+""": Код = " + КодРезультата + ", " + ОписаниеРезультата + ?(ЗначениеЗаполнено(ДанныеРезультата),": "+ДанныеРезультата,"");
					ОбщегоНазначения.СообщитьПользователю(ТекРезультат);
					
					Если КодРезультата = "0" Тогда  // писать ошибки, только если код результата <> 0. Пока пишем все
						Продолжить;
					КонецЕсли; 
					
					РезультатОбработки = РезультатОбработки + ?(ЗначениеЗаполнено(РезультатОбработки),Символы.ПС,"") + ТекРезультат;					
					ДобавитьОшибку(ТаблицаОшибок,РезультатОбработки,"Код ошибки "+КодРезультата);

				КонецЦикла;
				
			КонецЕсли;
			
			
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	//Еще может быть корректный ответ, содержащий запрашиваемые данные
	//следует проверять содержимое на наличие определенных узлов и если есть - создавать документ загрузки ответа из сервиса.
	//загружаемые элементы: "DoAcknowledgmentResponse", "ExportChargesResponse", "ExportPaymentsResponse", "ExportQuittanceResponse" , "ExportCatalogResponse" 
	
	//Если это квитирование без платежа, установим статус "Исполнен" квитируемому Начислению
	ОбъектСхемы = ДокументDOM.ПолучитьЭлементыПоИмени("DoAcknowledgmentResponse");
	Если ОбъектСхемы.Количество()>0 Тогда
		ДанныеОбъекта = ОбъектСхемы[0].ПервыйДочерний;//квитанции
		
		Для Каждого ТекКвитанция Из ДанныеОбъекта.ДочерниеУзлы Цикл //каждая квитанция
			УИН = "";
			ЭтоКвитированиеБезПлатежа = Ложь;
			
			СписокУзловУИН = ТекКвитанция.ПолучитьЭлементыПоИмени("SupplierBillID");
			Если СписокУзловУИН.Количество()>0 Тогда
				УИН = СписокУзловУИН[0].ТекстовоеСодержимое;
			КонецЕсли;
				
			СписокУзловИдПлатежей = ТекКвитанция.ПолучитьЭлементыПоИмени("SystemIdentifier");
			Если СписокУзловИдПлатежей.Количество()>0 Тогда
				ЭтоКвитированиеБезПлатежа = СписокУзловИдПлатежей[0].ТекстовоеСодержимое = "PaymentNotLoaded";
			КонецЕсли;
				
			Если ЭтоКвитированиеБезПлатежа И ЗначениеЗаполнено(УИН) Тогда
				ТекНачисление = БиблиотекаФункцийОбмена.ПолучитьНачислениеПоУИН(УИН);
				Если ЗначениеЗаполнено(ТекНачисление) Тогда
					СтруктураРекв = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(ТекНачисление);
					Если СтруктураРекв.Статус <> Перечисления.СтатусыИсполненияДокумента.Исполнен Тогда 
						СтруктураРекв.Вставить("Статус",Перечисления.СтатусыИсполненияДокумента.Исполнен);
						СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",ТекНачисление);
						ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Возврат;	
	КонецЕсли;
	
	МассивИскомыхУзлов = Новый Массив;
	МассивИскомыхУзлов.Добавить("PaymentInfo");	//ExportPaymentsResponse - ответ на запрос платежей, должны быть узлы PaymentInfo, содержащие данные платежей, если их нет - нет смысл создавать импорт
	МассивИскомыхУзлов.Добавить("ChargeInfo");  //ExportChargesResponse - ответ на запрос статусов начислений, должен быть узел Charges, а в нем узлы ChargeInfo, содержащие данные начислений и статусов кввитирования, если их нет - нет смысл создавать импорт 
	//МассивИскомыхУзлов.Добавить("DoAcknowledgmentResponse");//ответ на запрос квитирования - обрабатываем выше без платежа. 	
	//МассивИскомыхУзлов.Добавить("ExportQuittanceResponse"); //ответ на запрос квитанций - пока никак не обрабатываем
	//МассивИскомыхУзлов.Добавить("ExportCatalogResponse");   //ответ на запрос каталога - пока никак не обрабатываем
	
	Для Каждого ЭлМас Из МассивИскомыхУзлов Цикл
		ТекУзлы = ДокументDOM.ПолучитьЭлементыПоИмени(ЭлМас);	
		Если ТекУзлы.Количество()>0 Тогда
			ТребуетсяЗапрос = ТекУзлы[0].РодительскийУзел.ПолучитьАтрибут("hasMore")="true";
			НуженИмпорт = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьОшибку(ТаблицаОшибок, ТекстОшибки, ПолеФайла = "")
	
	Ошибка = ТаблицаОшибок.Добавить();
	Ошибка.ПолеФайла = ПолеФайла;
	Ошибка.Ошибка = ТекстОшибки;
	
КонецПроцедуры

/////////////////////////////////////////////////////////////////////////
// Подготовка следующей порции запросов к экспорту

Функция СформироватьФайлыДляПолученияСледующейПорцииДанных(ЗаданиеСсылка) Экспорт
	
	МассивФайлов = Новый Массив;
					
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Объект", ЗаданиеСсылка);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПрисоединенныеФайлы.Наименование КАК ИмяФайлаБезРасширения,
	               |	ПрисоединенныеФайлы.Ссылка,
	               |	ПрисоединенныеФайлы.Расширение,
	               |	ПрисоединенныеФайлы.Наименование + ""."" + ПрисоединенныеФайлы.Расширение КАК ИмяФайла
	               |ИЗ
	               |	Справочник.ЗаданиеНаЭкспортДанныхВБанкиКСПрисоединенныеФайлы КАК ПрисоединенныеФайлы
	               |ГДЕ
	               |	ПрисоединенныеФайлы.ПометкаУдаления = ЛОЖЬ
	               |	И ПрисоединенныеФайлы.ВладелецФайла = &Объект
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ПрисоединенныеФайлы.Наименование";
	РезультатЗапроса = Запрос.Выполнить();

	Выборка = РезультатЗапроса.Выбрать();

	СтрокаРазделения = ЭкспортФайлов.РазделительОтветов();

	МассивФайлов = Новый Массив;
	НужноЗаписатьЗадание = Ложь;

	ДокОбъект = ЗаданиеСсылка.ПолучитьОбъект();
	Для Каждого СтрТЧ Из ДокОбъект.ОбъектыОбмена Цикл
		Если ТипЗнч(СтрТЧ.Объект) <> Тип("ДокументСсылка.ЗапросУНИФО") Тогда
			Продолжить;
		КонецЕсли;
		
		ОтветИзСервиса = ЭкспортФайлов.РазобратьОтветИзСервиса(СтрТЧ.ОтветWebСервиса);			
		
		КоличествоОтветов = ОтветИзСервиса.Количество();
		Если КоличествоОтветов=0 Тогда
			Продолжить;
		КонецЕсли;
		
		ТекСтрока = ОтветИзСервиса[КоличествоОтветов-1];
		ТребуетсяЗапрос = НужноВыполнитьСледующийЗапрос(ОтветИзСервиса[КоличествоОтветов-1].Ответ);
		
		Если ТребуетсяЗапрос = Ложь Тогда
			Продолжить;
		КонецЕсли;
		
		Выборка.Сбросить();
		
		ТекИмяФайла = ТекСтрока.ИмяФайла;
		Если НЕ ЗначениеЗаполнено(ТекИмяФайла) Тогда
			ТекИмяФайла = СтрТЧ.ИмяФайлаВыгрузки;
			
			Если Выборка.НайтиСледующий(Новый Структура("ИмяФайла",ТекИмяФайла)) Тогда
			    Расширение = Выборка.Расширение;
				ИмяБезРасширения = Выборка.ИмяФайлаБезРасширения;
				
				ПолноеИмяФайла = ИмяБезРасширения + "_"+XMLСтрока(КоличествоОтветов) + "."+ Расширение;
				
				ТекОтвет = СтрТЧ.ОтветWebСервиса.Получить();
				ОтветВХранилище = СтрокаРазделения + ПолноеИмяФайла + Символы.ПС + ТекОтвет;
				СтрТЧ.ОтветWebСервиса = Новый ХранилищеЗначения(ОтветВХранилище,Новый СжатиеДанных(9));
				
				НужноЗаписатьЗадание = Истина;
				
				ДанныеФайла = РаботаСФайлами.ДанныеФайла(Выборка.Ссылка,,Истина);
				
				СтруктураДляОбновления = Новый Структура();
				СтруктураДляОбновления.Вставить("АдресФайлаВоВременномХранилище",ДанныеФайла.СсылкаНаДвоичныеДанныеФайла);
				СтруктураДляОбновления.Вставить("АдресВременногоХранилищаТекста","");
				СтруктураДляОбновления.Вставить("ИмяБезРасширения",ИмяБезРасширения + "_"+XMLСтрока(КоличествоОтветов));
										
				РаботаСФайлами.ОбновитьФайл(Выборка.Ссылка,СтруктураДляОбновления);
							
				ИмяНовогоФайла = ИмяБезРасширения + "_"+XMLСтрока(КоличествоОтветов+1);
				
				СкопироватьТекущийФайл(ДанныеФайла,ЗаданиеСсылка,ИмяНовогоФайла,Расширение,МассивФайлов);
				
			КонецЕсли;
		Иначе							
			
			Если Выборка.НайтиСледующий(Новый Структура("ИмяФайла",ТекИмяФайла)) Тогда
				
				ПозицияНачалаПрефикса = СтрНайти(Выборка.ИмяФайлаБезРасширения, "_", НаправлениеПоиска.СКонца);
				
				Если ПозицияНачалаПрефикса>0 Тогда
					НачалоИмени = Сред(Выборка.ИмяФайлаБезРасширения,1,ПозицияНачалаПрефикса-1);
					НомерФайла = Число(Сред(Выборка.ИмяФайлаБезРасширения,ПозицияНачалаПрефикса+1))+1;
					Расширение = Выборка.Расширение;
					
					ДанныеФайла = РаботаСФайлами.ДанныеФайла(Выборка.Ссылка,,Истина);
					
					ИмяНовогоФайла = НачалоИмени + "_"+XMLСтрока(НомерФайла);
					СкопироватьТекущийФайл(ДанныеФайла,ЗаданиеСсылка,ИмяНовогоФайла,Расширение,МассивФайлов);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если НужноЗаписатьЗадание = Истина Тогда
		ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;
	Если МассивФайлов.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;	
	
	Данные = ПолучитьДанныеПодготовки_1_16(ЗаданиеСсылка,МассивФайлов);
	Возврат Данные;
		
КонецФункции

Функция НужноВыполнитьСледующийЗапрос(ОтветWebСервиса) Экспорт
	
	Если ПустаяСтрока(ОтветWebСервиса) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ОтветWebСервиса);
	
	ПостроительDOM = Новый ПостроительDOM;
	Попытка
		ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
	Исключение
		//ДобавитьОшибку(ТаблицаОшибок, "Не удалось разобрать ответ", "");
		Возврат Ложь;		
	КонецПопытки;
		
	МассивИскомыхУзлов = Новый Массив;
	МассивИскомыхУзлов.Добавить("PaymentInfo");	//ExportPaymentsResponse - ответ на запрос платежей, должны быть узлы PaymentInfo, содержащие данные платежей, если их нет - нет смысл создавать импорт
	МассивИскомыхУзлов.Добавить("ChargeInfo");  //ExportChargesResponse - ответ на запрос статусов начислений, должен быть узел Charges, а в нем узлы ChargeInfo, содержащие данные начислений и статусов кввитирования, если их нет - нет смысл создавать импорт 
	//МассивИскомыхУзлов.Добавить("DoAcknowledgmentResponse");//ответ на запрос квитирования - надо тестировать, кажется, что никак не обработаем. 	
	//МассивИскомыхУзлов.Добавить("ExportQuittanceResponse"); //ответ на запрос квитанций - пока никак не обрабатываем
	//МассивИскомыхУзлов.Добавить("ExportCatalogResponse");   //ответ на запрос каталога - пока никак не обрабатываем
	ТребуетсяЗапрос = Ложь;
	Для Каждого ЭлМас Из МассивИскомыхУзлов Цикл
		ТекУзлы = ДокументDOM.ПолучитьЭлементыПоИмени(ЭлМас);	
		Если ТекУзлы.Количество()>0 Тогда
			ТребуетсяЗапрос = ТекУзлы[0].РодительскийУзел.ПолучитьАтрибут("hasMore")="true";
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТребуетсяЗапрос;
КонецФункции

Функция ИзменитьТекстЗапросаДанных(ТекстЗапроса)
	
	ИскомыйБлокНачало = "<ds:Signature";
	ИскомыйБлокКонец = "</ds:Signature>";
	ДлинаБлока = СтрДлина(ИскомыйБлокКонец);
	ПозицияПодписи = Найти(ТекстЗапроса,ИскомыйБлокНачало);
	Если ПозицияПодписи>0 Тогда
		ТекстЗапроса = Сред(ТекстЗапроса,1,ПозицияПодписи-1) + Сред(ТекстЗапроса,Найти(ТекстЗапроса,ИскомыйБлокКонец)+ДлинаБлока);
	КонецЕсли;
	
	ИскомыйБлокНачало = "<Signature ";
	ИскомыйБлокКонец = "</Signature>";
	ДлинаБлока = СтрДлина(ИскомыйБлокКонец);
	ПозицияПодписи = Найти(ТекстЗапроса,ИскомыйБлокНачало);
	Если ПозицияПодписи>0 Тогда
		ТекстЗапроса = Сред(ТекстЗапроса,1,ПозицияПодписи-1) + Сред(ТекстЗапроса,Найти(ТекстЗапроса,ИскомыйБлокКонец)+ДлинаБлока);
	КонецЕсли;
	
	
	//Нужно вставить или заменить строку с полем
	//<Paging xmlns="http://roskazna.ru/gisgmp/xsd/116/PGU_DataRequest" pageLength="100" pageNumber="2"/>
	//где pageNumber увеличить на 1, или, если строки нет, установить 2
	ПозицияНомераСтраницы = Найти(ТекстЗапроса,"pageNumber=""");
	ДлинаБлока = СтрДлина("pageNumber=""");
	
	Если ПозицияНомераСтраницы>0 Тогда
		НачалБлока = Сред(ТекстЗапроса,1,ПозицияНомераСтраницы+ДлинаБлока-1);
		
		СерединаКонецБлока = Сред(ТекстЗапроса,ПозицияНомераСтраницы+ДлинаБлока);
		
		ПозицияКонцаНомераСтраницы = Найти(СерединаКонецБлока,"""");
		
		НомерСтраницы = Сред(СерединаКонецБлока,1,ПозицияКонцаНомераСтраницы-1);
		КонецБлока = Сред(СерединаКонецБлока,ПозицияКонцаНомераСтраницы);
		
		ТекстЗапроса = НачалБлока + XMLСтрока(Число(НомерСтраницы)+1)+КонецБлока;
	Иначе
		ПозицияОкончанияЗапроса = Найти(ТекстЗапроса,"</ExportRequest>");
		СтрокаПорции = "<Paging xmlns=""http://roskazna.ru/gisgmp/xsd/116/PGU_DataRequest"" pageLength=""100"" pageNumber=""2""/>";
		ТекстЗапроса = Сред(ТекстЗапроса,1,ПозицияОкончанияЗапроса-1)+СтрокаПорции+Сред(ТекстЗапроса,ПозицияОкончанияЗапроса);
	КонецЕсли;	
	
	Возврат ТекстЗапроса;
	
КонецФункции

Процедура СкопироватьТекущийФайл(ДанныеФайла,ЗаданиеСсылка,ИмяНовогоФайла,Расширение,МассивФайлов)
			
	ДанныеХранилища = ПолучитьИзВременногоХранилища(ДанныеФайла.СсылкаНаДвоичныеДанныеФайла);
	
	Если ТипЗнч(ДанныеХранилища) = Тип("ДвоичныеДанные") Тогда
		ВременныйФайл = ПолучитьИмяВременногоФайла(Расширение);
		ДанныеХранилища.Записать(ВременныйФайл);
		ТекстовыйФайл = Новый ЧтениеТекста(ВременныйФайл);
		ТекстЗапроса = ТекстовыйФайл.Прочитать();
		ТекстовыйФайл = Неопределено;
		
		ТекстЗапроса = ИзменитьТекстЗапросаДанных(ТекстЗапроса);
										
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла(Расширение);
		ЗаписьТекста = Новый ЗаписьТекста(ИмяВременногоФайла);
		ЗаписьТекста.Записать(ТекстЗапроса);
		ЗаписьТекста = Неопределено;
		
		// помещаем созданный файл передачи в хранилище файлов
			
		ДвоичныеДанные 					= Новый ДвоичныеДанные(ИмяВременногоФайла);
		АдресФайлаВоВременномХранилище 	= ПоместитьВоВременноеХранилище(ДвоичныеДанные);
		
		СсылкаНаФайл = РаботаСФайлами.ДобавитьФайл(
			Новый Структура("ВладелецФайлов, ИмяБезРасширения, РасширениеБезТочки, Автор, ВремяИзмененияУниверсальное",  
			ЗаданиеСсылка, 
			ИмяНовогоФайла,
			Расширение,
			ПользователиКлиентСервер.ТекущийПользователь(),
			УниверсальноеВремя(ТекущаяДатаСеанса())),     
			АдресФайлаВоВременномХранилище);	

		//----------------------------------------------------
		
		МассивФайлов.Добавить(СсылкаНаФайл);
	КонецЕсли;
	
		
КонецПроцедуры


/////////////////////////////////////////////////////////////////////////
// Подготовка к экспорту - доформирование файла (при необходимости)

Процедура ВыполнитьДействияПослеФормированияФайла(Задание,МассивВыгружаемыхДокументов,Текст) Экспорт
	
	Если ТипЗнч(Задание) = Тип("Структура") Тогда 
		// Это формирование файла без документа ЗаданиеНаЭкспорт. 
		// Дополнительных действий не требуется.
		Возврат;
	КонецЕсли;
	
	ИскомоеВыражение = "<SignedCharge>Вставить_Подписанное_Начисление_";	
	Поз = Найти(Текст,ИскомоеВыражение);
	ДлинаВыражения = СтрДлина(ИскомоеВыражение);
	Если Поз = 0 Тогда
		// не нужно подставлять подписанные начисления
		Возврат;
	КонецЕсли;
	Пока Поз<>0 Цикл
		
		ГУИД = Сред(Текст,Поз+ДлинаВыражения,36);
		ЗаменяемоеВыражение = ИскомоеВыражение + ГУИД + "</SignedCharge>";
		ИскомыйУИД = Новый УникальныйИдентификатор(ГУИД);
		ТекНачисление = Документы.КвитанцияНаОплатуГосуслуг.ПолучитьСсылку(ИскомыйУИД);
		Если НЕ ОбщегоНазначения.СсылкаСуществует(ТекНачисление) Тогда
			ТекНачисление = Документы.НачислениеОтПодведомственного.НайтиПоИДНачисления("N_"+ГУИД);	
		КонецЕсли;
		
		ПодписанноеНачисление = "";
		Если ОбщегоНазначения.СсылкаСуществует(ТекНачисление) Тогда
			ПодписанноеНачисление = БиблиотекаФункцийОбмена.ПолучитьПодписанноеНачисление(ТекНачисление,Истина);	
		КонецЕсли;		
		
		Текст = СтрЗаменить(Текст,ЗаменяемоеВыражение,ПодписанноеНачисление);
		Поз = Найти(Текст,ИскомоеВыражение);
		
	КонецЦикла;
	
КонецПроцедуры




/////////////////////////////////////////////////////////////////////////
// Процедуры и функции для обмена с ГИС ГМП 2.0 и СМЭВ 3.0

Функция ПреобразоватьИдентификаторПлательщикаВФормат20(ИдентификаторСтрокой) Экспорт
	
	Если Не ЗначениеЗаполнено(ИдентификаторСтрокой) Тогда
		Возврат "";
	КонецЕсли;
	
	ДлинаИд = СтрДлина(ИдентификаторСтрокой);
	
	НовыйИдентификатор = "";
	
	Если ДлинаИд = 22 Тогда
		
		НовыйИдентификатор = ИдентификаторСтрокой;
	
	ИначеЕсли ДлинаИд = 25 Тогда
		//это идентификатор физлица
		//XXYYYYYYYYYYYYYYYYYYYYNNN - старый формат  
		//YYY - номер документа, дополненный нулями слева,
		//поэтому один крайний левый символ мы можем без проблем не брать, он всегда 0		
		
		КодДок = Лев(ИдентификаторСтрокой,2);
		
		НомерДок = Сред(ИдентификаторСтрокой,4,19);
		
		НовыйИдентификатор = "1"+КодДок+НомерДок;
		
	ИначеЕсли ДлинаИд <> 22 Тогда
		
		//это идентификатор юр лица 
		ТипИд = Лев(ИдентификаторСтрокой,1); // вид юр. лица
		НомерИд = Сред(ИдентификаторСтрокой,2); //номер документа ИНН + КПП или КИО + КПП или только ИНН
		НовыйИдентификатор = ТипИд + СтроковыеФункцииКлиентСервер.ДополнитьСтроку(НомерИд,21,"0","Слева");
		
	КонецЕсли;
	
	Возврат НовыйИдентификатор;
	
КонецФункции

Функция ПреобразоватьИдентификаторПлательщикаИз20В116(ИдентификаторСтрокой) Экспорт
	Если Не ЗначениеЗаполнено(ИдентификаторСтрокой) Тогда
		Возврат "";
	КонецЕсли;
	
	ДлинаИд = СтрДлина(ИдентификаторСтрокой);
	Если ДлинаИд <> 22 Тогда
		Возврат "";
	КонецЕсли;
	
	НовыйИдентификатор = "";
	
	ПервСимвол = Лев(ИдентификаторСтрокой,1);
	
	Если ПервСимвол = "1" Тогда
		//это идентификатор ФЛ
		
		НовыйИдентификатор = Сред(ИдентификаторСтрокой,2,2)+"0"+Сред(ИдентификаторСтрокой,4,19)+"643";
		
	ИначеЕсли ПервСимвол = "2"
		ИЛИ ПервСимвол = "3" Тогда
		//юр лицо
		
		НовыйИдентификатор = ПервСимвол+ Сред(ИдентификаторСтрокой,4,19);
		
	ИначеЕсли ПервСимвол = "4" Тогда
		//ИП
		
		НовыйИдентификатор = ПервСимвол+ Прав(ИдентификаторСтрокой,12);
		
	КонецЕсли;
	
	Возврат НовыйИдентификатор;
	
КонецФункции

Функция ПолучитьСоответствиеУчастников(Участник) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	НастройкаОрганизацийДляГИСГМП_УНП.Организация КАК Отправитель,
		|   НастройкаОрганизацийДляГИСГМП_УНП.Подведомственный
		|ИЗ
		|	РегистрСведений.НастройкаОрганизацийДляГИСГМП_УНП КАК НастройкаОрганизацийДляГИСГМП_УНП
		|ГДЕ
		|	НастройкаОрганизацийДляГИСГМП_УНП.Организация = &Участник
		|		ИЛИ НастройкаОрганизацийДляГИСГМП_УНП.Подведомственный = &Участник";
	
	Запрос.УстановитьПараметр("Участник", Участник);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
	СоответствиеУчастников = Новый Соответствие;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если СоответствиеУчастников[ВыборкаДетальныеЗаписи.Отправитель] = Неопределено Тогда
			СоответствиеУчастников.Вставить(ВыборкаДетальныеЗаписи.Отправитель,ВыборкаДетальныеЗаписи.Отправитель);
		КонецЕсли;
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Подведомственный) Тогда
			СоответствиеУчастников.Вставить(ВыборкаДетальныеЗаписи.Подведомственный,ВыборкаДетальныеЗаписи.Отправитель);		
		КонецЕсли;
	КонецЦикла;
		
	УстановитьПривилегированныйРежим(Ложь);
		
	Возврат СоответствиеУчастников;
	
КонецФункции

Функция ПолучитьНастройкиПодписиУчастников20(Участник) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	НастройкаОрганизацийДляГИСГМП_УНП.Организация КАК Организация
		|ПОМЕСТИТЬ ВремТаб
		|ИЗ
		|	РегистрСведений.НастройкаОрганизацийДляГИСГМП_УНП КАК НастройкаОрганизацийДляГИСГМП_УНП
		|ГДЕ
		|	(НастройкаОрганизацийДляГИСГМП_УНП.Организация = &Участник
		|			ИЛИ НастройкаОрганизацийДляГИСГМП_УНП.Подведомственный = &Участник)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НастройкаОтправителей.Организация КАК Организация,
		|	НастройкаОтправителей.Подведомственный КАК Подведомственный,
		|	НастройкаОтправителей.УРН КАК УРН,
		|	НастройкаОтправителей.КодУчастника КАК КодУчастника,
		|	НастройкаОтправителей.АдресTSA КАК АдресTSA,
		|	НастройкаОтправителей.РежимВзаимодействия КАК РежимВзаимодействия,
		|	НастройкаОтправителей.РежимПодписи КАК РежимПодписи,
		|	НастройкаОтправителей.СертификатЭПНачислений КАК СертификатЭПНачислений,
		|	НастройкаОтправителей.СертификатЭПНачислений.ДанныеСертификата КАК ДанныеСертификатаНачислений,
		|	НастройкаОтправителей.СертификатЭПСообщения КАК СертификатЭПСообщения,
		|	НастройкаОтправителей.СертификатЭПСообщения.ДанныеСертификата КАК ДанныеСертификатаСообщения,
		|	НастройкаОтправителей.ХранитьПарольЭПНачисления КАК ХранитьПарольЭПНачисления,
		|	НастройкаОтправителей.ХранитьПарольЭПСообщения КАК ХранитьПарольЭПСообщения,
		|	ЕстьNull(НастройкаОтправителей.СертификатЭПНачислений.Программа.ТипПрограммы,"""") КАК ТипПрограммыСертификатаНачислений,
		|	ЕстьNull(НастройкаОтправителей.СертификатЭПСообщения.Программа.ТипПрограммы,"""") КАК ТипПрограммыСертификатаСообщения,
		|	НастройкаОтправителей.СертификатЭПНачислений.Программа КАК ПрограммаСертификатаНачислений,
		|	НастройкаОтправителей.СертификатЭПСообщения.Программа КАК ПрограммаСертификатаСообщения 
		|ИЗ
		|	РегистрСведений.НастройкаОрганизацийДляГИСГМП_УНП КАК НастройкаОтправителей
		|ГДЕ
		|	(НастройкаОтправителей.Подведомственный = &Участник
		|			ИЛИ НастройкаОтправителей.Организация В
		|				(ВЫБРАТЬ
		|					ВремТаб.Организация КАК Организация
		|				ИЗ
		|					ВремТаб КАК ВремТаб))";
	
	Запрос.УстановитьПараметр("Участник", Участник);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаДетальныеЗаписи = РезультатыЗапроса[1].Выбрать();
	
	НастройкиУчастников = Новый Соответствие;
		
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Подведомственный) Тогда
			ТекУчастник = ВыборкаДетальныеЗаписи.Подведомственный;
		Иначе
			ТекУчастник = ВыборкаДетальныеЗаписи.Организация;
		КонецЕсли;
			
		СтруктураНастроек = Новый Структура("ПарольЭПНачисления,ПарольЭПСообщения,СертификатЭПНачислений,СертификатЭПСообщения,РежимПодписи,РежимВзаимодействия,
			|ТипПрограммыСертификатаНачислений,ТипПрограммыСертификатаСообщения,ПрограммаСертификатаНачислений,ПрограммаСертификатаСообщения","","");
		ЗаполнитьЗначенияСвойств(СтруктураНастроек,ВыборкаДетальныеЗаписи);
		Если ЗначениеЗаполнено(СтруктураНастроек.СертификатЭПНачислений) Тогда
			ДанныеСертификата = Base64Строка(ВыборкаДетальныеЗаписи.ДанныеСертификатаНачислений.Получить());
			ДанныеСертификата = СтрЗаменить(СтрЗаменить(ДанныеСертификата,Символы.ВК,""),Символы.ПС,"");
			СтруктураНастроек.Вставить("ДанныеСертификатаНачислений",ДанныеСертификата);
		Иначе
			СтруктураНастроек.Вставить("ДанныеСертификатаНачислений","");
		КонецЕсли;
		Если ЗначениеЗаполнено(СтруктураНастроек.СертификатЭПСообщения) Тогда
			ДанныеСертификата = Base64Строка(ВыборкаДетальныеЗаписи.ДанныеСертификатаСообщения.Получить());
			ДанныеСертификата = СтрЗаменить(СтрЗаменить(ДанныеСертификата,Символы.ВК,""),Символы.ПС,"");
			СтруктураНастроек.Вставить("ДанныеСертификатаСообщения",ДанныеСертификата);
		Иначе
			СтруктураНастроек.Вставить("ДанныеСертификатаСообщения","");
		КонецЕсли;
					
		СтруктураНастроек.Вставить("ХранитьПарольЭПНачисления",ВыборкаДетальныеЗаписи.ХранитьПарольЭПНачисления);
		СтруктураНастроек.Вставить("ХранитьПарольЭПСообщения",ВыборкаДетальныеЗаписи.ХранитьПарольЭПСообщения);
		
		Если ВыборкаДетальныеЗаписи.ХранитьПарольЭПНачисления 
			ИЛИ ВыборкаДетальныеЗаписи.ХранитьПарольЭПСообщения Тогда
			УстановитьПривилегированныйРежим(Истина);
			СтруктураПаролей = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ВыборкаДетальныеЗаписи.Организация,"ПарольЭПНачислений,ПарольЭПСообщения");
			УстановитьПривилегированныйРежим(Ложь);
			Если ВыборкаДетальныеЗаписи.ХранитьПарольЭПНачисления Тогда
				СтруктураНастроек.Вставить("ПарольЭПНачисления",?(ЗначениеЗаполнено(СтруктураПаролей.ПарольЭПНачислений),СтруктураПаролей.ПарольЭПНачислений,""));
			КонецЕсли;
			Если ВыборкаДетальныеЗаписи.ХранитьПарольЭПСообщения Тогда
				СтруктураНастроек.Вставить("ПарольЭПСообщения",?(ЗначениеЗаполнено(СтруктураПаролей.ПарольЭПСообщения),СтруктураПаролей.ПарольЭПСообщения,""));
			КонецЕсли;
		КонецЕсли;
		СтруктураНастроек.Вставить("Отправитель",ВыборкаДетальныеЗаписи.Организация);
		
		НастройкиУчастников.Вставить(ТекУчастник,СтруктураНастроек);
		
	КонецЦикла;
		
	УстановитьПривилегированныйРежим(Ложь);
		
	Возврат НастройкиУчастников;
	
КонецФункции

Процедура ПодписатьДанныеПоФорматуГИСГМП20НаСервере(Участник,ТЧДанных,ТекстОшибки,Знач ИмяУзлаПодписиСП="",Знач ИмяУзлаПодписиОВ="") Экспорт
	
	//Имя узла подписи СП может меняться - зависит от вида запроса, иногда может отсутствовать.
	
	//Внимание! 
	//Требования к формированию подписи для тега:
	//все используемые в данном теге и нижестоящих тегах пространства имен
	//должны быть объявлены в данном теге или нижестоящих.
	//При подписи не корневого узла, НЕДОПУСТИМО, чтобы в подписываемом узле использовались пространства имен,
	//объявленные выше.
	
	Если НЕ ЗначениеЗаполнено(ИмяУзлаПодписиСП)
		И НЕ ЗначениеЗаполнено(ИмяУзлаПодписиОВ) Тогда
		Возврат;
	КонецЕсли;
	
	ШаблонПодписиСП = "%ПодписьСП%";
	
	ШаблонПодписиОВ = "%ПодписьОВ%";
	
	НастройкиПодисиУчастников = ПолучитьНастройкиПодписиУчастников20(Участник);
	
	Попытка
		КомпонентаПодписи = ОбъектВнешнейКомпонентыExtraCryptoAPI();
	Исключение
		ТекстОшибки = НСтр("ru='Не удалось создать компоненту для формирования электронной подписи.
		|%1'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		Возврат;
	КонецПопытки;
	
	Для Каждого СтрокаТЧ ИЗ ТЧДанных Цикл
		
		ТекущийУчастник = СтрокаТЧ.ТекущийУчастник;
		
		НастройкиУчастника = НастройкиПодисиУчастников[ТекущийУчастник];
		Если НастройкиУчастника = Неопределено Тогда
			
			ТекстОшибки = "Для ""%1"" в настройках не заданы параметры подписи. Подпись не выполнена.";
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ТекущийУчастник);
			
			Возврат;
		КонецЕсли;
		
		СертификатНачисления = НастройкиУчастника.СертификатЭПНачислений;
		ДанныеСертификатаСущности = НастройкиУчастника.ДанныеСертификатаНачислений;
		ТекПарольУчастника = НастройкиУчастника.ПарольЭПНачисления;
		ТипПрограммыСертификата = НастройкиУчастника.ТипПрограммыСертификатаНачислений;
		
		СодержимоеФайла = СтрокаТЧ.СодержимоеФайла;
		ПозицияНачалаФайла = 1;
		Если СтрНачинаетсяС(СодержимоеФайла,"<?")  Тогда
			ПозицияНачалаФайла = СтрНайти(СодержимоеФайла,"?>")+2;
			СодержимоеФайла = СокрЛП(Сред(СодержимоеФайла,ПозицияНачалаФайла));
		КонецЕсли;
		
		//СодержимоеФайла = СокрЛП(СтрЗаменить(СодержимоеФайла,"<?xml version=""1.0"" encoding=""UTF-8""?>",""));
		
		//если это обмен с эмулятором, то нужно послать эталонные сообщения
		//эталонные сообщения будут не подписаны и нужно их подписать
		НужнаПодписьСП = СтрНайти(СодержимоеФайла,ШаблонПодписиСП)>0;
			
		Если НужнаПодписьСП Тогда
			//В некоторых системах агрегаторах требуется подписывать ЭП-СП для запросов (платежей, начислений, квитирования и тд.)
			//Если в формате есть ШаблонПодписиСП, то определим подписываемый узел
			
			Если НЕ ЗначениеЗаполнено(ИмяУзлаПодписиСП) Тогда
				
				Если СтрНайти(СодержимоеФайла,"ImportChargesRequest")>0 Тогда
					//Пакет начислений
					ИмяУзлаПодписиСП = "ImportChargesRequest";
										
				ИначеЕсли СтрНайти(СодержимоеФайла,"ImportRefundsRequest")>0 Тогда
				    //Пакет возвратов
					ИмяУзлаПодписиСП = "ImportRefundsRequest";
					
				ИначеЕсли СтрНайти(СодержимоеФайла,"ExportPaymentsRequest")>0 Тогда	
					//Запрос платежей
					ИмяУзлаПодписиСП = "ExportPaymentsRequest";
					
				ИначеЕсли СтрНайти(СодержимоеФайла,"ExportQuittancesRequest")>0 Тогда	
					//Запрос квитанций
					ИмяУзлаПодписиСП = "ExportQuittancesRequest";	
					
				ИначеЕсли СтрНайти(СодержимоеФайла,"ExportChargesRequest")>0 Тогда	
					//Запрос начислений и статусов квитирования
					ИмяУзлаПодписиСП = "ExportChargesRequest";
					
				ИначеЕсли СтрНайти(СодержимоеФайла,"ForcedAcknowledgementRequest")>0 Тогда	
					//Запрос на квитирование и отмену квитирования
					ИмяУзлаПодписиСП = "ForcedAcknowledgementRequest";
					
				ИначеЕсли СтрНайти(СодержимоеФайла,"ExportRefundsRequest")>0 Тогда	
					//Запрос возвратов
					ИмяУзлаПодписиСП = "ExportRefundsRequest";
					
				ИначеЕсли СтрНайти(СодержимоеФайла,"ImportCertificateRequest")>0 Тогда	
					//Передача сертификата ЭП
					ИмяУзлаПодписиСП = "ImportCertificateRequest";	
					
				КонецЕсли;
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ИмяУзлаПодписиСП)
				И НЕ ЗначениеЗаполнено(ДанныеСертификатаСущности) Тогда
				//подписывать надо, но сертификат не указан, возможно это косвенный участник
				//укажем, что подписывать будем сертификатом ЭП-ОВ
				Отправитель = НастройкиУчастника.Отправитель;
				НастройкиОтправителя = НастройкиПодисиУчастников[Отправитель];
				ДанныеСертификатаСущности = НастройкиОтправителя.ДанныеСертификатаСообщения;
				ТекПарольУчастника = НастройкиОтправителя.ПарольЭПСообщения;
				ТипПрограммыСертификата = НастройкиОтправителя.ТипПрограммыСертификатаСообщения;
				
			КонецЕсли;
			
		КонецЕсли;
					
		Если ЗначениеЗаполнено(ИмяУзлаПодписиСП) Тогда		
			
			Если НЕ ЗначениеЗаполнено(ДанныеСертификатаСущности) Тогда
				ТекстОшибки = НСтр("ru='Не удалось подписать сообщение.
				|Для участника ""%1"" не задан сертификат подписи начислений.'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ТекущийУчастник);

				Возврат;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ТипПрограммыСертификата) Тогда
				//попробуем автоматически определить
			    Попытка
					СвойстваКриптопровайдера = КомпонентаПодписи.ПолучитьСвойстваКриптопровайдера(ДанныеСертификатаСущности);
					ТекущийКриптопровайдер = ПрочитатьОтветКомпоненты(СвойстваКриптопровайдера);
					ТекТип = ТекущийКриптопровайдер["type"];
					Если ТекТип <> Неопределено Тогда
						ТипПрограммыСертификата = ТекТип;
						
						Если НастройкиУчастника.ДанныеСертификатаНачислений = ДанныеСертификатаСущности Тогда
							НастройкиУчастника.ТипПрограммыСертификатаНачислений = ТипПрограммыСертификата;
						ИначеЕсли НастройкиОтправителя.ДанныеСертификатаСообщения = ДанныеСертификатаСущности Тогда
							НастройкиОтправителя.ТипПрограммыСертификатаСообщения = ТипПрограммыСертификата;
						КонецЕсли;
					КонецЕсли;
				Исключение
					
					ТекстОшибки = НСтр("ru='Не удалось подписать сообщение.
						|Для участника ""%1"" в сертификате подписи начислений не указано приложение для подписи.
						|При автоматическом определении приложения возникла ошибка: %2'");
					ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ТекущийУчастник,
						ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				    Возврат;
				КонецПопытки;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ТипПрограммыСертификата) Тогда
				ТекстОшибки = НСтр("ru='Не удалось подписать сообщение.
				|Для участника ""%1"" в сертификате подписи начислений не указано приложение для подписи.'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ТекущийУчастник);

				Возврат;
			КонецЕсли;
			
			Попытка
				Подпись = ПодписатьДанныеПоФорматуГИСГМП20КомпонентойБСПНаСервере(КомпонентаПодписи,ДанныеСертификатаСущности,СодержимоеФайла,ИмяУзлаПодписиСП,ТекПарольУчастника,ТипПрограммыСертификата);	
				
				СодержимоеФайла = СтрЗаменить(СодержимоеФайла, ШаблонПодписиСП, Подпись);
				
				СтрокаТЧ.Подпись = Подпись;
				СтрокаТЧ.Сертификат = СертификатНачисления;
			Исключение
								
				ТекстОшибки = НСтр("ru='При формировании подписи СП возникла ошибка. Не удалось подписать %1.
						|%2'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ИмяУзлаПодписиСП,ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
												
				Возврат;					
			КонецПопытки;
						
			СтрокаТЧ.Подписано = Истина;
		КонецЕсли;
		
		//Имя узла подписи ОВ зависит от вида сообщения
		
		ТекИмяУзлаПодписиОВ = ИмяУзлаПодписиОВ;
		Если ТекИмяУзлаПодписиОВ = "Авто" Тогда
		
			Если СтрокаТЧ.ВидСообщения = Перечисления.ТипыЗапросовСМЭВ3.ИмпортДанныхВСМЭВ
				ИЛИ СтрокаТЧ.ВидСообщения = Перечисления.ТипыЗапросовСМЭВ3.ИмпортЗапросаДанныхОтПоставщика Тогда
				ТекИмяУзлаПодписиОВ = "SenderProvidedRequestData";//стандартный узел для подписи сообщений SendRequest
			ИначеЕсли СтрокаТЧ.ВидСообщения = Перечисления.ТипыЗапросовСМЭВ3.ЗапросДанныхИзОчередиСМЭВ Тогда //ТекущееДействие = "ЗапроситьДанныеИзОчередиОтветов"
				Если СтрНайти(СодержимоеФайла,"MessageTypeSelector")>0 Тогда
					//стандартный узел для подписи сообщений GetResponse
					//или запрос результата обработки по ID в ИС УНП
					ТекИмяУзлаПодписиОВ = "MessageTypeSelector";
				ИначеЕсли СтрНайти(СодержимоеФайла,"OriginalMessageID")>0 Тогда
					//это запрос результата обработки по ID в ИС РНИП
					ТекИмяУзлаПодписиОВ = "OriginalMessageID";
					
				КонецЕсли;
			ИначеЕсли СтрокаТЧ.ВидСообщения = Перечисления.ТипыЗапросовСМЭВ3.ПодтверждениеПолученияСообщенияСМЭВ Тогда //ТекущееДействие = "ПодтвердитьПолучениеСообщения"
				ТекИмяУзлаПодписиОВ = "AckTargetMessage";//стандартный узел для подписи сообщений Ack
			ИначеЕсли СтрокаТЧ.ВидСообщения = Перечисления.ТипыЗапросовСМЭВ3.ЗапросДанныхИзОчередиСтатусов Тогда //ТекущееДействие = "ЗапроситьДанныеИзОчередиСтатусов"
				ТекИмяУзлаПодписиОВ = "Timestamp";//стандартный узел для подписи сообщений GetStatus	
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекИмяУзлаПодписиОВ) 
			И ТекИмяУзлаПодписиОВ<>"Авто" Тогда
			
			Отправитель = НастройкиУчастника.Отправитель;
	
			НастройкиОтправителя = НастройкиПодисиУчастников[Отправитель];
						
			Если НастройкиОтправителя = Неопределено Тогда
				
				ТекстОшибки = "Для ""%1"" в настройках не заданы параметры подписи. Подпись не выполнена.";
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,Отправитель);
				
				Возврат;
			КонецЕсли;
			
			ДанныеСертификатаЗаголовка= НастройкиОтправителя.ДанныеСертификатаСообщения;
			ТипПрограммыСертификата = НастройкиОтправителя.ТипПрограммыСертификатаСообщения;
			
			Если НЕ ЗначениеЗаполнено(ДанныеСертификатаЗаголовка) Тогда
				ТекстОшибки = НСтр("ru='Не удалось подписать сообщение.
				|Для участника ""%1"" не задан сертификат подписи всего сообщения.'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,Отправитель);
				
				Возврат;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ТипПрограммыСертификата) Тогда
				//попробуем автоматически определить
			    Попытка
					СвойстваКриптопровайдера = КомпонентаПодписи.ПолучитьСвойстваКриптопровайдера(ДанныеСертификатаЗаголовка);
					ТекущийКриптопровайдер = ПрочитатьОтветКомпоненты(СвойстваКриптопровайдера);
					ТекТип = ТекущийКриптопровайдер["type"];
					Если ТекТип <> Неопределено Тогда
						ТипПрограммыСертификата = ТекТип;
						НастройкиОтправителя.ТипПрограммыСертификатаСообщения = ТипПрограммыСертификата;
					КонецЕсли;
				Исключение
					
					ТекстОшибки = НСтр("ru='Не удалось подписать сообщение.
						|Для участника ""%1"" в сертификате подписи всего сообщения не указано приложение для подписи.
						|При автоматическом определении приложения возникла ошибка: %2'");
					ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ТекущийУчастник,
						ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				    Возврат;
				КонецПопытки;
			КонецЕсли;
					
			Если НЕ ЗначениеЗаполнено(ТипПрограммыСертификата) Тогда
				ТекстОшибки = НСтр("ru='Не удалось подписать сообщение.
				|Для участника ""%1"" в сертификате подписи всего сообщения не указано приложение для подписи.'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ТекущийУчастник);

				Возврат;
			КонецЕсли;
			
			Попытка
				Подпись = ПодписатьДанныеПоФорматуГИСГМП20КомпонентойБСПНаСервере(КомпонентаПодписи,ДанныеСертификатаЗаголовка,СодержимоеФайла,ТекИмяУзлаПодписиОВ,НастройкиОтправителя.ПарольЭПСообщения,ТипПрограммыСертификата);	
			
				СодержимоеФайла = СтрЗаменить(СодержимоеФайла, ШаблонПодписиОВ, Подпись);
			Исключение
								
				ТекстОшибки = НСтр("ru='При формировании подписи ОВ возникла ошибка. Не удалось подписать %1.
						|%2'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ТекИмяУзлаПодписиОВ,ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));					
				
				Возврат;
			КонецПопытки;
			
			СтрокаТЧ.Подписано = Истина;		
		КонецЕсли;
		
		СтрокаТЧ.СодержимоеФайла = СодержимоеФайла;
		
	КонецЦикла;
	
	КомпонентаПодписи = Неопределено;
	
КонецПроцедуры

Функция ПодписатьПодтверждениеПолученияСообщенияНаСервереСКлиента(Участник, СодержимоеФайла, ТекстОшибки) Экспорт
	Возврат ПодписатьПодтверждениеПолученияСообщенияНаСервере(Участник, СодержимоеФайла, Неопределено, Неопределено, ТекстОшибки);	
КонецФункции

Функция ПодписатьПодтверждениеПолученияСообщенияНаСервере(Участник, СодержимоеФайла, НастройкиПодисиУчастников, КомпонентаПодписи, ТекстОшибки) Экспорт
	
	Если НастройкиПодисиУчастников = Неопределено Тогда
		НастройкиПодисиУчастников = ПолучитьНастройкиПодписиУчастников20(Участник);
		
		Если КомпонентаПодписи = Неопределено Тогда
			Попытка
				КомпонентаПодписи = ОбъектВнешнейКомпонентыExtraCryptoAPI();
			Исключение
				ТекстОшибки = НСтр("ru='Не удалось создать компоненту для формирования электронной подписи.
				|%1'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				
				Возврат Ложь;
			КонецПопытки;	
		КонецЕсли;
	КонецЕсли;
	
	ИмяУзлаПодписи = "AckTargetMessage";
	ШаблонПодписиОВ = "%ПодписьОВ%";	
	
	Отправитель = Участник;
	НастройкиОтправителя = НастройкиПодисиУчастников[Отправитель];
						
	Если НастройкиОтправителя = Неопределено Тогда
		
		ТекстОшибки = "Для ""%1"" в настройках не заданы параметры подписи. Подпись не выполнена.";
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,Отправитель);
		
		Возврат Ложь;
	КонецЕсли;
		
	ДанныеСертификатаЗаголовка= НастройкиОтправителя.ДанныеСертификатаСообщения;
	ТипПрограммыСертификата = НастройкиОтправителя.ТипПрограммыСертификатаСообщения;
	
	Если НЕ ЗначениеЗаполнено(ДанныеСертификатаЗаголовка) Тогда
		ТекстОшибки = НСтр("ru='Не удалось подписать сообщение.
		|Для участника ""%1"" не задан сертификат подписи всего сообщения.'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,Отправитель);
		
		Возврат Ложь;
	КонецЕсли;
		
	Если НЕ ЗначениеЗаполнено(ТипПрограммыСертификата) Тогда
		//попробуем автоматически определить
	    Попытка
			СвойстваКриптопровайдера = КомпонентаПодписи.ПолучитьСвойстваКриптопровайдера(ДанныеСертификатаЗаголовка);
			ТекущийКриптопровайдер = ПрочитатьОтветКомпоненты(СвойстваКриптопровайдера);
			ТекТип = ТекущийКриптопровайдер["type"];
			Если ТекТип <> Неопределено Тогда
				ТипПрограммыСертификата = ТекТип;
				НастройкиОтправителя.ТипПрограммыСертификатаСообщения = ТипПрограммыСертификата;
			КонецЕсли;
		Исключение
			
			ТекстОшибки = НСтр("ru='Не удалось подписать сообщение.
				|Для участника ""%1"" в сертификате подписи всего сообщения не указано приложение для подписи.
				|При автоматическом определении приложения возникла ошибка: %2'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,Отправитель,
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		    Возврат Ложь;
		КонецПопытки;
	КонецЕсли;
				
	Если НЕ ЗначениеЗаполнено(ТипПрограммыСертификата) Тогда
		ТекстОшибки = НСтр("ru='Не удалось подписать сообщение.
		|Для участника ""%1"" в сертификате подписи всего сообщения не указано приложение для подписи.'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,Отправитель);

		Возврат Ложь;
	КонецЕсли;
		
	Попытка
		Подпись = ПодписатьДанныеПоФорматуГИСГМП20КомпонентойБСПНаСервере(КомпонентаПодписи,ДанныеСертификатаЗаголовка,СодержимоеФайла,ИмяУзлаПодписи,НастройкиОтправителя.ПарольЭПСообщения,ТипПрограммыСертификата);	
	
		СодержимоеФайла = СтрЗаменить(СодержимоеФайла, ШаблонПодписиОВ, Подпись);
	Исключение
						
		ТекстОшибки = НСтр("ru='При формировании подписи ОВ возникла ошибка. Не удалось подписать %1.
				|%2'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ИмяУзлаПодписи,ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));					
		
		Возврат Ложь;
	КонецПопытки;
		
	Возврат Истина;
	
КонецФункции

Функция СформироватьШаблонСообщенияПодтверждения(Участник,ФорматПодтверждения) Экспорт
	
	НастройкиУчастника = БиблиотекаФункцийОбмена.ПолучитьНастройкиОрганизации(Участник);
			
	СтруктураДляФормирования = Новый Структура("КассовыйОрган");//не используется
	СтруктураДляФормирования.Вставить("Дата", ТекущаяДатаСеанса());
	СтруктураДляФормирования.Вставить("ВидОбмена", НастройкиУчастника.ВидОбмена);
	СтруктураДляФормирования.Вставить("НастройкаОбмена", НастройкиУчастника.НастройкаОбмена);
	СтруктураДляФормирования.Вставить("Организация", Участник);//отправляет и подтверждает всегда отправитель
	СтруктураДляФормирования.Вставить("Ссылка",Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПустаяСсылка());
	//СтруктураДляФормирования.Вставить("РезультатФормирования",Новый Соответствие);
	
	ОбщОбъектыОбмена = Новый ТаблицаЗначений;
	ОбщОбъектыОбмена.Колонки.Добавить("ОписаниеОшибки");
	ОбщОбъектыОбмена.Колонки.Добавить("ИмяФайлаВыгрузки");
	ОбщОбъектыОбмена.Колонки.Добавить("Формат");
	ОбщОбъектыОбмена.Колонки.Добавить("Объект");
	ОбщОбъектыОбмена.Колонки.Добавить("РезультатФормирования");
	
	НовСтр = ОбщОбъектыОбмена.Добавить();
	НовСтр.Объект = Документы.ЗапросУНИФО.ПустаяСсылка();
	НовСтр.Формат = ФорматПодтверждения;
	
	СтруктураДляФормирования.Вставить("ОбъектыОбмена",ОбщОбъектыОбмена);
	
	ФразаИдентификатор = "%ТутБудетИдентификаторСообщения%";
	
	ОбработкаФормирования = Обработки.ОбменВФорматахУФК_УФЭБС.Создать();
	ОбработкаФормирования.мОрганизация = Участник;
	ОбработкаФормирования.ОбменСЭмулятором = Ложь;
			
	ОбработкаФормирования.ИдентификаторСообщения = ФразаИдентификатор;
	ОбработкаФормирования.СоответствиеОбработанныхФорматов = Неопределено;
	ОбработкаФормирования.СформироватьФайлы(СтруктураДляФормирования);
	
	РезультатФормирования = "";
	ТаблицаОписанияОшибокСтрокой = "";
	Для Каждого СтрокаОбмена Из СтруктураДляФормирования.ОбъектыОбмена Цикл 
		РезультатФормирования = СтрокаОбмена.РезультатФормирования;
		ТаблицаОписанияОшибокСтрокой = СтрокаОбмена.ОписаниеОшибки;
	КонецЦикла;
	
	Возврат РезультатФормирования;
	
КонецФункции


Функция ПрочитатьОтветКомпоненты(Текст) Экспорт
	
	Попытка
		Результат = ОбщегоНазначения.JSONВЗначение(Текст);
	Исключение
		
		ИнформацияОбОшибке = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		
		ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Электронная подпись.Работа с компонентой.'",
				ОбщегоНазначения.КодОсновногоЯзыка()),
				УровеньЖурналаРегистрации.Ошибка,,,
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Не удалось прочитать ответ компоненты: %1
					|%2'"), Текст, ИнформацияОбОшибке));
		
		ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не удалось прочитать ответ компоненты: %1'"), ИнформацияОбОшибке);
		
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

Функция ПодписатьДанныеПоФорматуГИСГМП20КомпонентойБСПНаСервере(КомпонентаПодписиБСП,СертификатКриптографииBase64,СодержимоеФайла,ИмяУзлаПодписи,ТекПарольУчастника,ТипКриптопровайдера)
	
	///////////////////////////////////////////////////////////////////////////////////////////////////////////
	//Общая последовательность должна быть такой (на примере SendRequest):
	///////////////////////////////////////////////////////////////////////////////////////////////////////////
	//1. Каноникализация содержимого узла SenderProvidedRequestData;
	//2. Нормализация;
	//3. Расчет хэша;

	//4. Формирование ЭП-ОВ:
	//a. запись cодержимого хэша в CallerInformationSystemSignature\Signature\SignedInfo\Reference\DigestValue
	//b. каноникализация, нормализация элемента CallerInformationSystemSignature\Signature\SignedInfo
	//c. расчёт хэша элемента CallerInformationSystemSignature\Signature\SignedInfo
	//d. подпись хэша CallerInformationSystemSignature\Signature\SignedInfo
	//e. запись значения подписи в CallerInformationSystemSignature\Signature\SignatureValue
	//f. запись данных сертификата в CallerInformationSystemSignature\Signature\KeyInfo\X509Data\X509Certificate
	                   
	// Приводим значение сертификата к нужному виду
	//СертификатКриптографииBase64 = СтрЗаменить(СтрЗаменить(ДанныеСертификатаСущности, Символы.ПС, ""), Символы.ВК, "");
		
	ЭПКонвертXML = ГосУслугиКлиентСервер.ЭПКонвертXML();
	
	//В URI блока подписи подставляется значение атрибута Id подписываемомго узла, поэтому ожидается, что такой атрибут есть.
	ПозицияУзлаПодписи = СтрНайти(СодержимоеФайла,ИмяУзлаПодписи);
	ИмяИскомогоБлокаАтрибута = " Id=""";
	ДлинаБлокаИскомогоАтрибута = СтрДлина(ИмяИскомогоБлокаАтрибута);
	ПозицияIdНачало = СтрНайти(СодержимоеФайла,ИмяИскомогоБлокаАтрибута,,ПозицияУзлаПодписи);
	ПозицияIdКонец = СтрНайти(СодержимоеФайла,"""",,ПозицияIdНачало + ДлинаБлокаИскомогоАтрибута);
	
	ЗначениеURI = Сред(СодержимоеФайла,ПозицияIdНачало+ДлинаБлокаИскомогоАтрибута,ПозицияIdКонец-ПозицияIdНачало-ДлинаБлокаИскомогоАтрибута);
	
	ЭПКонвертXML = СтрЗаменить(ЭПКонвертXML, "%URI%", "#"+ЗначениеURI);
		   
	OID_Алгоритма = "1.2.643.7.1.1.2.2";//ИдентификаторАлгоритмаХеширования ГОСТ 2012/256  
	                   
	// Приводим текст подписной части Signature к канонической
	XPath_Signature = "(//. | //@* | //namespace::*)[ancestor-or-self::*[local-name()='Signature']]";
		
	ЭПКонвертXML = C14N(КомпонентаПодписиБСП, ЭПКонвертXML, XPath_Signature);
	ЭПКонвертXML = КанонизацияСМЭВ(КомпонентаПодписиБСП, ЭПКонвертXML);
	                   
	// 1. Приводим текст запроса, заключенный в тегах <ТекИмяУзлаПодписиОВ> к единой нормальной форме (канонизируем) по двум алгоритмам (C14N и СМЭВ)
	XPath_ИмяУзлаПодписи = "(//. | //@* | //namespace::*)[ancestor-or-self::*[local-name()='" + ИмяУзлаПодписи + "']]";
	КанонXML_ИмяУзлаПодписи = C14N(КомпонентаПодписиБСП, СодержимоеФайла, XPath_ИмяУзлаПодписи);
	// 2. Нормализация
	КанонXML_ИмяУзлаПодписи = КанонизацияСМЭВ(КомпонентаПодписиБСП, КанонXML_ИмяУзлаПодписи);
	
	//ТипКриптопровайдера - для КриптоПро = 80, берется из программы сертификата
	
	// 3. Хешируем наш запрос и помещаем значение в %DigestValue%
	АтрибутDigestValue = РезультатHash(КомпонентаПодписиБСП, КанонXML_ИмяУзлаПодписи, OID_Алгоритма, ТипКриптопровайдера);
	// 4.а
	ЭПКонвертXML = СтрЗаменить(ЭПКонвертXML, "%DigestValue%", АтрибутDigestValue);

	// 4.b Приводим текст запроса, заключенный в тегах <SignedInfo> к единой нормальной форме (канонизируем) по двум алгоритмам (C14N и СМЭВ)
	XPath_SignedInfo = "(//. | //@* | //namespace::*)[ancestor-or-self::*[local-name()='SignedInfo']]";
	Канон_SignedInfo = C14N(КомпонентаПодписиБСП, ЭПКонвертXML, XPath_SignedInfo);
	Канон_SignedInfo = КанонизацияСМЭВ(КомпонентаПодписиБСП, Канон_SignedInfo);

	// 4.c Хешируем SignedInfo
	ХэшSignedInfo = РезультатHash(КомпонентаПодписиБСП, Канон_SignedInfo, OID_Алгоритма, ТипКриптопровайдера);
	                   
	// 4.d Подписываем хэш <SignedInfo>.
	//АтрибутSignatureValue = КомпонентаКриптографии.Sign(ХэшSignedInfo, СертификатКриптографииBase64, ТекПарольУчастника);
	АтрибутSignatureValue = РезультатSign(КомпонентаПодписиБСП, Канон_SignedInfo, СертификатКриптографииBase64, ТекПарольУчастника);
	                   
	// 4.e запись значения подписи в CallerInformationSystemSignature\Signature\SignatureValue
	ЭПКонвертXML = СтрЗаменить(ЭПКонвертXML, "%SignatureValue%", АтрибутSignatureValue);
	                   
	// 4.f запись данных сертификата в CallerInformationSystemSignature\Signature\KeyInfo\X509Data\X509Certificate
	ЭПКонвертXML = СтрЗаменить(ЭПКонвертXML, "%BinarySecurityToken%", СертификатКриптографииBase64);
	
	Подпись = ЭПКонвертXML;
	
	Возврат Подпись;
КонецФункции

Функция ОбъектВнешнейКомпонентыExtraCryptoAPI()
	
	ОписаниеКомпоненты = ЭлектроннаяПодписьСлужебныйКлиентСервер.ОписаниеКомпоненты();
	ОбъектКомпоненты = ОбщегоНазначения.ПодключитьКомпонентуИзМакета(ОписаниеКомпоненты.ИмяОбъекта,
		ОписаниеКомпоненты.ПолноеИмяМакета);
	
	Если ОбъектКомпоненты = Неопределено Тогда
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не удалось подключить внешнюю компоненту %1.'"), ОписаниеКомпоненты.ИмяОбъекта);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	НастроитьКомпоненту(ОбъектКомпоненты);
	
	УстановитьПутьККриптопровайдеру(ОбъектКомпоненты);
	
	Возврат ОбъектКомпоненты;
	
КонецФункции

Процедура НастроитьКомпоненту(ОбъектКомпоненты)
	
	Попытка
		ОбъектКомпоненты.СоответствиеOID =
			ЭлектроннаяПодписьСлужебныйКлиентСервер.ИдентификаторыАлгоритмовХешированияИОткрытогоКлюча();
	Исключение
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не удалось установить свойство %1 компоненты %2 по причине:
				|%3'"), "СоответствиеOID", "ExtraCryptoAPI", ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;
	
КонецПроцедуры

Процедура УстановитьПутьККриптопровайдеру(ОбъектКомпоненты)
	
	Попытка
		
		//Если подписывать нужно на сервере с ОС Linux, нужно установить путь к модулю криптографии.
		Если ОбщегоНазначения.ЭтоLinuxСервер() Тогда
			//из документации БСП - глава 5, электронные подписи - Установка приложений электронной подписи в клиент-серверном варианте работы
			//Для Linux:
	        //	/opt/cprocsp/lib/amd64/libcapilite.so:/opt/cprocsp/lib/amd64/libcapi10.so:/opt/cprocsp/lib/amd64/libcapi20.so
	        //Для MacOS:
			//	/opt/cprocsp/lib/libcapi10.dylib:/opt/cprocsp/lib/libcapi20.dylib:/opt/cprocsp/lib/libcapi10.4.dylib:/opt/cprocsp/lib/libcapi20.4.dylib
			ПутиПоУмолчанию = "/opt/cprocsp/lib/amd64/libcapilite.so:/opt/cprocsp/lib/amd64/libcapi10.so:/opt/cprocsp/lib/amd64/libcapi20.so";
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	ПутиКПрограммамЭлектроннойПодписиИШифрованияНаСерверахLinux.Программа КАК Программа,
				|	ПутиКПрограммамЭлектроннойПодписиИШифрованияНаСерверахLinux.ПутьКПрограмме КАК ПутьКПрограмме
				|ИЗ
				|	РегистрСведений.ПутиКПрограммамЭлектроннойПодписиИШифрованияНаСерверахLinux КАК ПутиКПрограммамЭлектроннойПодписиИШифрованияНаСерверахLinux
				|ГДЕ
				|	ПутиКПрограммамЭлектроннойПодписиИШифрованияНаСерверахLinux.ИмяКомпьютера = &ИмяКомпьютера";
			
			Запрос.УстановитьПараметр("ИмяКомпьютера", ИмяКомпьютера());
			
			РезультатЗапроса = Запрос.Выполнить();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
				МенеджерКриптографии = ЭлектроннаяПодпись.МенеджерКриптографии("",Ложь,"",ВыборкаДетальныеЗаписи.Программа);
				Если МенеджерКриптографии <> Неопределено Тогда
					ОбъектКомпоненты.ПутьККриптопровайдеру = ВыборкаДетальныеЗаписи.ПутьКПрограмме;
					Прервать;
				КонецЕсли;
				МенеджерКриптографии = Неопределено;
			КонецЦикла;
			//если не получилось заполнить по регистру, заполним по умолчанию
			Если Не ЗначениеЗаполнено(ОбъектКомпоненты.ПутьККриптопровайдеру) Тогда 
				ОбъектКомпоненты.ПутьККриптопровайдеру = ПутиПоУмолчанию;
			КонецЕсли;
		КонецЕсли;
	Исключение
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не удалось установить свойство %1 компоненты %2 по причине:
				|%3'"), "ПутьККриптопровайдеру", "ExtraCryptoAPI", ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение ТекстОшибки;	
	КонецПопытки;
	
КонецПроцедуры

Функция КанонизацияСМЭВ(ОбъектКомпоненты, ТекстXML)
	
	Попытка
		КанонизированныйТекстXML = ОбъектКомпоненты.TransformSMEV(ТекстXML);
	Исключение
		ТекстОшибки = ЭлектроннаяПодписьСлужебныйКлиентСервер.ОшибкаВызоваМетодаКомпоненты("TransformSMEV",
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;
	
	Если КанонизированныйТекстXML = Неопределено Тогда
		ТекстОшибки = ЭлектроннаяПодписьСлужебныйКлиентСервер.ОшибкаВызоваМетодаКомпоненты("TransformSMEV",
			ОбъектКомпоненты.ПолучитьОшибку());
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Возврат КанонизированныйТекстXML;
	
КонецФункции

Функция C14N(ОбъектКомпоненты, КонвертXML, XPath)
	
	Попытка
		КанонизированныйТекстXML = ОбъектКомпоненты.C14N(КонвертXML, XPath);
	Исключение
		ТекстОшибки = ЭлектроннаяПодписьСлужебныйКлиентСервер.ОшибкаВызоваМетодаКомпоненты("C14N",
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;
	
	Если КанонизированныйТекстXML = Неопределено Тогда
		ТекстОшибки = ЭлектроннаяПодписьСлужебныйКлиентСервер.ОшибкаВызоваМетодаКомпоненты("C14N",
			ОбъектКомпоненты.ПолучитьОшибку());
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Возврат КанонизированныйТекстXML;
	
КонецФункции

Функция РезультатHash(ОбъектКомпоненты, КанонизированныйТекстXMLBody, OIDАлгоритмаХеширования, ТипКриптопровайдера)
	
	Попытка
		АтрибутDigestValue = ОбъектКомпоненты.Hash(
			КанонизированныйТекстXMLBody,
			OIDАлгоритмаХеширования,
			ТипКриптопровайдера);
	Исключение
		ТекстОшибки = ЭлектроннаяПодписьСлужебныйКлиентСервер.ОшибкаВызоваМетодаКомпоненты("Hash",
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;
	
	Если АтрибутDigestValue = Неопределено Тогда
		ТекстОшибки = ЭлектроннаяПодписьСлужебныйКлиентСервер.ОшибкаВызоваМетодаКомпоненты("Hash",
			ОбъектКомпоненты.ПолучитьОшибку());
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Возврат АтрибутDigestValue;
	
КонецФункции

Функция РезультатSign(ОбъектКомпоненты, КанонизированныйТекстXMLSignedInfo,
	СертификатКриптографииBase64, ПарольДоступаКЗакрытомуКлючу)
		
	Попытка
		АтрибутSignatureValue = ОбъектКомпоненты.Sign(
			КанонизированныйТекстXMLSignedInfo,
			СертификатКриптографииBase64,
			ПарольДоступаКЗакрытомуКлючу);
	Исключение
		ТекстОшибки = ЭлектроннаяПодписьСлужебныйКлиентСервер.ОшибкаВызоваМетодаКомпоненты("Sign",
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение ТекстОшибки;
	КонецПопытки;
	
	Если АтрибутSignatureValue = Неопределено Тогда
		ТекстОшибки = ЭлектроннаяПодписьСлужебныйКлиентСервер.ОшибкаВызоваМетодаКомпоненты("Sign",
			ОбъектКомпоненты.ПолучитьОшибку());
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
	Возврат АтрибутSignatureValue;
	
КонецФункции

Функция ОшибкаВызоваМетодаКомпоненты(ИмяМетода, ИнформацияОбОшибке) Экспорт
	
	Возврат СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Ошибка вызова метода %1 компоненты %2.'"), ИмяМетода, "ExtraCryptoAPI")
		+ Символы.ПС + ИнформацияОбОшибке;
	
КонецФункции

Функция ПолучитьНастройкиПрограммыСертификата(Программа) Экспорт
	
	СтруктураНастроек = Новый Структура("ИмяПрограммы,ТипПрограммы,АлгоритмПодписи,АлгоритмХеширования,АлгоритмШифрования");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПрограммыЭлектроннойПодписиИШифрования.ИмяПрограммы КАК ИмяПрограммы,
		|	ПрограммыЭлектроннойПодписиИШифрования.ТипПрограммы КАК ТипПрограммы,
		|	ПрограммыЭлектроннойПодписиИШифрования.АлгоритмПодписи КАК АлгоритмПодписи,
		|	ПрограммыЭлектроннойПодписиИШифрования.АлгоритмХеширования КАК АлгоритмХеширования,
		|	ПрограммыЭлектроннойПодписиИШифрования.АлгоритмШифрования КАК АлгоритмШифрования
		|ИЗ
		|	Справочник.ПрограммыЭлектроннойПодписиИШифрования КАК ПрограммыЭлектроннойПодписиИШифрования
		|ГДЕ
		|	ПрограммыЭлектроннойПодписиИШифрования.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Программа);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(СтруктураНастроек,ВыборкаДетальныеЗаписи);
	КонецЕсли;
	Возврат СтруктураНастроек;	
КонецФункции

// 
Процедура ОбработатьОтветыИзСервисаСМЭВ(ТаблицаСообщений, ТаблицаОбъектов, ТаблицаПодтвержденияПолученияСообщений,ТаблицаДляЗапросаНовыхДанных,ДополнительныеДанные) Экспорт
	
	Если ДополнительныеДанные = Неопределено Тогда
		ДополнительныеДанные = Новый Структура;
		ДополнительныеДанные.Вставить("ПолученоПлатежейВсего",0);
		ДополнительныеДанные.Вставить("ПолученоПлатежейНовых",0);
	КонецЕсли;
	
	
	МассивСтруктурДляОбработкиАсинхроннойПроверки = Новый Массив;
	
	Для Каждого СтрТЧ Из ТаблицаСообщений Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрТЧ.СтатусОтправки)
			ИЛИ СтрТЧ.СтатусОтправки = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.НеОтправлен Тогда
			//Обмен с сервисом не выполнялся
			Продолжить;
		КонецЕсли;
		
		Если СтрТЧ.СтатусОтправки = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ВыгруженВКаталог Тогда
			//СтрТЧ.ДатаОбмена = ТекущаяДатаСеанса();
			//Только установить статус отправки документу, и все
			МассивОбъектов = ТаблицаОбъектов.НайтиСтроки(Новый Структура("НомерПакета",СтрТЧ.НомерПакета));
			
			Для Каждого ТекСтрОбъекта Из МассивОбъектов Цикл
				
				Если НЕ ЗначениеЗаполнено(ТекСтрОбъекта.Объект) Тогда
					Продолжить;
				КонецЕсли;
				
				УстановитьРезультатВыгрузкиВКаталог(ТекСтрОбъекта.Объект);
				
			КонецЦикла;
				
			Продолжить;
		КонецЕсли;
		
		Если ПустаяСтрока(СтрТЧ.СообщениеОтвет) Тогда
			ДобавитьОшибку(СтрТЧ.ТаблицаОшибок, "Сервис дал пустой ответ", "");
			Возврат;
		КонецЕсли;
		
		ИскомыйУзел = "Envelope";
		
		Инд = 1;
		ЧитаемыйОтвет = СтрТЧ.СообщениеОтвет;
		ПозицияНачала = СтрНайти(СтрТЧ.СообщениеОтвет,"<");
		ПозицияОкончания = СтрНайти(СтрТЧ.СообщениеОтвет,">");
		
		Пока ПозицияНачала <> 0 И ПозицияОкончания<>0 Цикл
			
			ЧитаемыйБлок = Сред(СтрТЧ.СообщениеОтвет,ПозицияНачала,ПозицияОкончания-ПозицияНачала+1);
			Если СтрНайти(ЧитаемыйБлок,ИскомыйУзел)>0 Тогда
				ЧитаемыйОтвет = Сред(СтрТЧ.СообщениеОтвет,ПозицияНачала,СтрНайти(СтрТЧ.СообщениеОтвет,ИскомыйУзел+">")-ПозицияНачала+СтрДлина(ИскомыйУзел+">"));
				Прервать;
			Иначе
				Инд = Инд + 1;
			КонецЕсли;
			
			ПозицияНачала = СтрНайти(СтрТЧ.СообщениеОтвет,"<",,,Инд);
			ПозицияОкончания = СтрНайти(СтрТЧ.СообщениеОтвет,">",,,Инд);
			
		КонецЦикла;
		
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(ЧитаемыйОтвет);//СтрТЧ.СообщениеОтвет);
		
		ПостроительDOM = Новый ПостроительDOM;
		Попытка
			ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
		Исключение
			ДобавитьОшибку(СтрТЧ.ТаблицаОшибок, "Не удалось разобрать ответ", "");
			//Возврат;
			Продолжить;
		КонецПопытки;
		
		//Ошибки СМЭВ:
		ОбъектСхемы = ДокументDOM.ПолучитьЭлементыПоИмени("Fault");
		
		ЕстьОшибкиСМЭВ = Ложь;
		СтроковоеОписаниеОшибки = "";
		Если ОбъектСхемы.Количество()>0 Тогда
			
			ЕстьОшибкиСМЭВ = Истина;
			
			СтроковоеОписаниеОшибки = "Ошибка СМЭВ. Сообщение не дошло до сервиса.";
			ДобавитьОшибку(СтрТЧ.ТаблицаОшибок, СтроковоеОписаниеОшибки, "");
			
			УзелСтроковойОшибки = ОбъектСхемы[0].ПолучитьЭлементыПоИмени("faultstring");
			Если УзелСтроковойОшибки.Количество()>0 Тогда
				СтроковоеОписаниеОшибки = УзелСтроковойОшибки[0].ТекстовоеСодержимое;
			КонецЕсли;
			
			ДобавитьОшибку(СтрТЧ.ТаблицаОшибок, СтроковоеОписаниеОшибки, "Описание ошибки:");
			
			ДетальнаяИнформацияПоОшибке = ОбъектСхемы[0].ПолучитьЭлементыПоИмени("detail");
			Если ДетальнаяИнформацияПоОшибке.Количество()>0 Тогда
				ТекстИнф = ДетальнаяИнформацияПоОшибке[0].ТекстовоеСодержимое;
				ДобавитьОшибку(СтрТЧ.ТаблицаОшибок, ТекстИнф, "Детальная информация:");
			КонецЕсли;
			
			Если СтрТЧ.СтатусОтправки <> Перечисления.РезультатыОтправкиСообщенийВСМЭВ.Ошибка Тогда
				//если ранее не была установлена ошибка, то установим, что не принят 
				СтрТЧ.СтатусОтправки = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.НеПринятСМЭВ;
			КонецЕсли;
		КонецЕсли;
		
		Если СтрТЧ.ВидСообщения = Перечисления.ТипыЗапросовСМЭВ3.ИмпортДанныхВСМЭВ
			ИЛИ СтрТЧ.ВидСообщения = Перечисления.ТипыЗапросовСМЭВ3.ИмпортЗапросаДанныхОтПоставщика Тогда
			
			ТекРезультатУспешно = (ЕстьОшибкиСМЭВ = Ложь);
			
			МассивОбъектов = ТаблицаОбъектов.НайтиСтроки(Новый Структура("НомерПакета",СтрТЧ.НомерПакета));
			Для Каждого ТекСтрОбъекта Из МассивОбъектов Цикл
				ТипОбъекта = ТипЗнч(ТекСтрОбъекта.Объект);
				Если ТипОбъекта = Тип("ДокументСсылка.ПакетНачисленийГИСГМП")
					ИЛИ ТипОбъекта = Тип("ДокументСсылка.ПакетНачисленийГИСГМПОтПодведомственного") Тогда
					ОбработатьРезультатЭкспортаНачислений(ТекСтрОбъекта.Объект,ТекРезультатУспешно);
				ИначеЕсли ТипОбъекта = Тип("ДокументСсылка.НачислениеОтПосредникаГИСГМП") Тогда
					ОбработатьРезультатЭкспортаНачисленийОтПосредника(ТекСтрОбъекта.Объект,ТекРезультатУспешно);	
				ИначеЕсли ТипОбъекта = Тип("ДокументСсылка.ПодпискаНаУведомлениеГИСГМП") Тогда
					ОбработатьРезультатЭкспортаПодпискиНаУведомления(ТекСтрОбъекта.Объект,ТекРезультатУспешно);
				ИначеЕсли ТипОбъекта = Тип("ДокументСсылка.ПакетУведомленийОВозвратеГИСГМП")
					ИЛИ ТипОбъекта = Тип("ДокументСсылка.ПакетУведомленийОВозвратеГИСГМПОтПодведомственного") Тогда
					ОбработатьРезультатЭкспортаВозвратов(ТекСтрОбъекта.Объект,ТекРезультатУспешно);
				ИначеЕсли ТипОбъекта = Тип("ДокументСсылка.КаталогГосУслуг") Тогда
					ОбработатьРезультатЭкспортаКаталога(СтрТЧ,ТекСтрОбъекта.Объект,ТекРезультатУспешно,ЧитаемыйОтвет);
				ИначеЕсли ТипОбъекта = Тип("ДокументСсылка.ЗапросУНИФО")
					И ЗначениеЗаполнено(ТекСтрОбъекта.Объект) Тогда
					ОбработатьРезультатЭкспортаЗапроса(ТекСтрОбъекта.Объект,ТекРезультатУспешно);
				ИначеЕсли ТипОбъекта = Тип("УникальныйИдентификатор") Тогда
					//это запрос данных из ГИС ГМП по настройкам РС
					ОбработатьРезультатЭкспортаЗапросаИзРС(ТекСтрОбъекта.Объект,ТекРезультатУспешно,СтроковоеОписаниеОшибки);
				КонецЕсли;
			КонецЦикла;
			
			//Если это импорт данных/запроса, то это может быть экспорт в эмулятор.
			//Если в отправляемом сообщении содержится тег TestMessage, то это экспорт в эмулятор.
			//В этом случае получатель в сообщении - ответе должен быть Recipient/Mnemonic = "emu"
			Если СтрНайти(СтрТЧ.СодержимоеФайла,"TestMessage/>")>0 Тогда
				СтрТЧ.ОбменСЭмулятором = Истина;
			Иначе
				СтрТЧ.ОбменСЭмулятором = Ложь;				
			КонецЕсли;
			
			////если Recipient/Mnemonic = "emu" - это эмулятор
			//ОбъектПолучатель = ДокументDOM.ПолучитьЭлементыПоИмени("Recipient");
			//Если ОбъектПолучатель.Количество()>0 Тогда
			//	СтрТЧ.ОбменСЭмулятором = ВРЕГ(ОбъектПолучатель[0].ТекстовоеСодержимое) = "EMU";
			//КонецЕсли;
			
		КонецЕсли;
		
		Если ЕстьОшибкиСМЭВ Тогда
			//нет смысла смотреть дальше
			Продолжить;
			
		КонецЕсли;
			
		Если СтрТЧ.ВидСообщения = Перечисления.ТипыЗапросовСМЭВ3.ЗапросДанныхИзОчередиСМЭВ
			ИЛИ СтрТЧ.ВидСообщения = Перечисления.ТипыЗапросовСМЭВ3.ЗапросДанныхИзОчередиСтатусов Тогда
			
			ЭтоБылЗапросОтАЗ = Ложь;
			
			//Т.к. при запросе сообщений из очереди используется одно и тоже сообщение,
			//с одним идентификатором, то сделаем уникальный идентификатор,
			//который и будем использовать.
			СтрТЧ.ИдентификаторСообщения = Строка(Новый УникальныйИдентификатор);
			
			ИдентификаторСообщенияУчастника = "";
			
			ОбъектЗапросаОтвета = ДокументDOM.ПолучитьЭлементыПоИмени("GetRequestResponse");
			Если ОбъектЗапросаОтвета.Количество() Тогда
				//это GetRequestResponse - например, в таком формате приходит уведомление по подписке	
				//у него нет OriginalMessageId
				
			Иначе
				//это GetResponseResponse
				
				ОбъектИдентификатора = ДокументDOM.ПолучитьЭлементыПоИмени("OriginalMessageId");
				Если ОбъектИдентификатора.Количество()>0 Тогда
					ИдентификаторСообщенияУчастника = ОбъектИдентификатора[0].ТекстовоеСодержимое;
				КонецЕсли;
			
				//Т.к. очередь сообщений у участника одна, то в очереди могут быть сообщения от видов сведений,
				//с которыми реализован обмен в стороннем ПО.
				//Если в регистрах отправляемых сообщений будет найдено сообщение по ИдентификаторуСообщения,
				//то данное сообщение нужно обработать и отправить подтверждение о получении.
				//Если записи с таким идентификатором найдено не будет,
				//считаем, что это сообщение для стороннего ПО.
				//Обрабатывать и подтверждать такое сообщение не будем.
				Если НЕ СообщениеОтправлноИзЭтойБазы(ИдентификаторСообщенияУчастника) Тогда
					Продолжить;
				КонецЕсли;
				
				ЭтоБылЗапросОтАЗ = ИсходныйЗапросБылОтАдминистратораЗапросов(ИдентификаторСообщенияУчастника);
			КонецЕсли;
			
			//Ответ с результатом асинхронной проверки
			ОбъектСхемы = ДокументDOM.ПолучитьЭлементыПоИмени("SenderProvidedResponseData");
			Если ОбъектСхемы.Количество() = 0 Тогда
				ОбъектСхемы = ДокументDOM.ПолучитьЭлементыПоИмени("SenderProvidedRequestData");
			КонецЕсли;
			//ИдетификаторСообщенияСМЭВ = "";
			//ИдетификаторСообщенияУчастника = "";
			
			Если ОбъектСхемы.Количество()>0 Тогда
				СтруктураДанных = Новый Структура("ИдентификаторСообщенияСМЭВ,ИдентификаторСообщенияУчастника,Категория,Описание");
				СтруктураДанных.ИдентификаторСообщенияУчастника = ИдентификаторСообщенияУчастника;
				//ТаблицаОшибокОбр = Новый ТаблицаЗначений;
				//ТаблицаОшибокОбр.Колонки.Добавить("КодОшибки");
				//ТаблицаОшибокОбр.Колонки.Добавить("ОписаниеОшибки");
				//СтруктураДанных.Вставить("ТаблицаОшибокОбработки",ТаблицаОшибокОбр);
				
				//если сообщение уже подверждено, то в таблицу все равно добавляем, для последующего использования таблицы
				//при записи регистров обмена в форме обработки
				СтрокаТаблицыПодтвержденияСообщений = ТаблицаПодтвержденияПолученияСообщений.Добавить();
				СтрокаТаблицыПодтвержденияСообщений.ИдентификаторСообщенияУчастника = ИдентификаторСообщенияУчастника;
				СтрокаТаблицыПодтвержденияСообщений.ИдентификаторСообщенияЗапроса = СтрТЧ.ИдентификаторСообщения;
				СтрокаТаблицыПодтвержденияСообщений.Подтверждено = СтрТЧ.Подтверждено;
				ЭтоРезультатАсинхроннойПроверки = Ложь;
				
				ДанныеОбъекта = ОбъектСхемы[0];
				ЭлементИДСМЭВ = ДанныеОбъекта.ПолучитьЭлементыПоИмени("MessageID");
				Если ЭлементИДСМЭВ.Количество() > 0 Тогда
					СтрокаТаблицыПодтвержденияСообщений.ИдентификаторСообщенияСМЭВ = ЭлементИДСМЭВ[0].ТекстовоеСодержимое;																			
					СтруктураДанных.ИдентификаторСообщенияСМЭВ = ЭлементИДСМЭВ[0].ТекстовоеСодержимое;
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(СтрокаТаблицыПодтвержденияСообщений.ИдентификаторСообщенияСМЭВ) Тогда
					ТаблицаПодтвержденияПолученияСообщений.Удалить(СтрокаТаблицыПодтвержденияСообщений);
				КонецЕсли;
				
				//проверим, что это результат асинхронной проверки
				УзелАсинхПров = ДанныеОбъекта.ПолучитьЭлементыПоИмени("AsyncProcessingStatus");
				Если УзелАсинхПров.Количество()>0 Тогда
					ТекУзел = УзелАсинхПров[0];
					ТекстОшибки = "";
					Для Каждого ЭлАсПр Из ТекУзел.ДочерниеУзлы Цикл
						Если ЭлАсПр.ЛокальноеИмя = "OriginalMessageId" Тогда
							СтруктураДанных.ИдентификаторСообщенияУчастника = ЭлАсПр.ТекстовоеСодержимое;
						ИначеЕсли ЭлАсПр.ЛокальноеИмя = "StatusCategory" Тогда
							СтруктураДанных.Категория = ЭлАсПр.ТекстовоеСодержимое;
						ИначеЕсли ЭлАсПр.ЛокальноеИмя = "StatusDetails" Тогда
							СтруктураДанных.Описание = ЭлАсПр.ТекстовоеСодержимое;
						ИначеЕсли ЭлАсПр.ЛокальноеИмя = "SmevFault" Тогда
							
							ТекстОшибки = СтрЗаменить(ЭлАсПр.ТекстовоеСодержимое,": ",Символы.ПС);
															
						КонецЕсли;					
					КонецЦикла;
					
					ОбработатьРезультатАсинхроннойПроверки(СтруктураДанных,ТекстОшибки);
					Продолжить;
					
				КонецЕсли;
				
				//проверим, что это результат RequestStatus
				УзелRequestStatus = ДанныеОбъекта.ПолучитьЭлементыПоИмени("RequestStatus");
				Если УзелRequestStatus.Количество()>0 Тогда
					ТекУзел = УзелRequestStatus[0];
					КодОшибки = "";
					ОписаниеОшибки = "";
					Для Каждого ЭлОшибкиСтатуса Из ТекУзел.ДочерниеУзлы Цикл
						Если ЭлОшибкиСтатуса.ЛокальноеИмя = "StatusCode" Тогда
							КодОшибки = ЭлОшибкиСтатуса.ТекстовоеСодержимое;
						ИначеЕсли ЭлОшибкиСтатуса.ЛокальноеИмя = "StatusDescription" Тогда
							ОписаниеОшибки = ЭлОшибкиСтатуса.ТекстовоеСодержимое;
						КонецЕсли;
					КонецЦикла;
					ТекстОшибки = "Код ошибки = " + КодОшибки + ", " + ОписаниеОшибки;
					
					//Т.к. результат RequestStatus содержит ошибки обработки ранее отправленных документов,
					//то в таблицу ошибок отправляемого сообщения добавлять ошибки не будем.
					
					ОбработатьОшибкуСтатуса(ИдентификаторСообщенияУчастника,КодОшибки,ОписаниеОшибки);
					Продолжить;
				КонецЕсли;
				
				//проверим, что это результат RequestRejected
				УзлыRequestRejected = ДанныеОбъекта.ПолучитьЭлементыПоИмени("RequestRejected");
				Если УзлыRequestRejected.Количество()>0 Тогда
					МассивСообщений = Новый Массив;
					Для Каждого ТекВозврат Из УзлыRequestRejected Цикл
						КодПричиныОтклонения = "";
						ОписаниеПричиныОтклонения = "";
						Для Каждого ТекУзел Из ТекВозврат.ДочерниеУзлы Цикл
							Если ТекУзел.ЛокальноеИмя = "RejectionReasonDescription" Тогда
								ОписаниеПричиныОтклонения = ТекУзел.ТекстовоеСодержимое;
							ИначеЕсли ТекУзел.ЛокальноеИмя = "RejectionReasonCode" Тогда
								КодПричиныОтклонения = ТекУзел.ТекстовоеСодержимое;
							КонецЕсли;
						КонецЦикла;
						ТекстСообщения = "Код причины отклонения = %1, %2";
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,КодПричиныОтклонения,ОписаниеПричиныОтклонения);
						МассивСообщений.Добавить(ТекстСообщения);
					КонецЦикла;
					ТекстОшибки = СтрСоединить(МассивСообщений,Символы.ПС);
					
					ОбработатьОшибкуОтклонения(ИдентификаторСообщенияУчастника,ТекстОшибки);
					
					Продолжить;	
				КонецЕсли;
				
				//проверим, что это ответ с данными от поставщика MessagePrimaryContent
				УзелMessagePrimaryContent = ДанныеОбъекта.ПолучитьЭлементыПоИмени("MessagePrimaryContent");
				Если УзелMessagePrimaryContent.Количество()>0 Тогда
					ТекУзел = УзелMessagePrimaryContent[0];
										
					//это ответ от поставщика
					Если ТекУзел.ЕстьДочерниеУзлы() Тогда
						
						ЭтоОтветОтЭмулятора = Ложь;
						Если СтрНайти(ЧитаемыйОтвет,"Mnemonic>emu<")>0 Тогда
							ЭтоОтветОтЭмулятора = Истина;	
						КонецЕсли;
					
						УзелОтветаОтПоставщика = ТекУзел.ПервыйДочерний;
						//!!!Тут добавляются обработки для разбора ответа поставщика, для каждого вида сведений
						Если УзелОтветаОтПоставщика.ЛокальноеИмя = "ImportChargesResponse" Тогда
							//это обработка импорта начислений в сервис
							ОбработатьРезультатИмпортаНачислений(СтруктураДанных.ИдентификаторСообщенияУчастника,СтрТЧ.ТекущийУчастник,ЧитаемыйОтвет,ЭтоОтветОтЭмулятора);
							
						ИначеЕсли УзелОтветаОтПоставщика.ЛокальноеИмя = "ChargeCreationResponse" Тогда	
							
							ОбработатьРезультатИмпортаНачисленийОтПосредника(СтруктураДанных.ИдентификаторСообщенияУчастника,СтрТЧ.ТекущийУчастник,ЧитаемыйОтвет,ЭтоОтветОтЭмулятора);
							
						ИначеЕсли УзелОтветаОтПоставщика.ЛокальноеИмя = "ExportChargesResponse" Тогда
							
							//это обработка экспорта начислений из сервиса со статусом квитирования и оставшейся задолженности
							
							Если ЭтоБылЗапросОтАЗ = Ложь Тогда
								ОбработатьРезультатПолученияСтатусаКвитирования(СтруктураДанных.ИдентификаторСообщенияУчастника,СтрТЧ.ТекущийУчастник,ЧитаемыйОтвет,ТаблицаДляЗапросаНовыхДанных,ЭтоОтветОтЭмулятора);
							Иначе
								ОбработатьРезультатЗапросаНачислений_АЗ(СтруктураДанных.ИдентификаторСообщенияУчастника,СтрТЧ.ТекущийУчастник,ЧитаемыйОтвет,ТаблицаДляЗапросаНовыхДанных,ЭтоОтветОтЭмулятора);
							КонецЕсли;
							
						ИначеЕсли УзелОтветаОтПоставщика.ЛокальноеИмя = "ImportRefundsResponse" Тогда
							//это обработка импорта возвратов платежей в сервис
							ОбработатьРезультатИмпортаВозвратов(СтруктураДанных.ИдентификаторСообщенияУчастника,СтрТЧ.ТекущийУчастник,ЧитаемыйОтвет,ЭтоОтветОтЭмулятора);	
						ИначеЕсли УзелОтветаОтПоставщика.ЛокальноеИмя = "ImportCatalogResponse" Тогда
							//это обработка импорта каталога услуг в сервис
							ОбработатьРезультатИмпортаКаталога(СтруктураДанных.ИдентификаторСообщенияУчастника,СтрТЧ.ТекущийУчастник,ЧитаемыйОтвет,ЭтоОтветОтЭмулятора);
						ИначеЕсли УзелОтветаОтПоставщика.ЛокальноеИмя = "ImportCertificateResponse" Тогда
							//это обработка импорта сертификата в сервис
							ОбработатьРезультатИмпортаСертификата(СтруктураДанных.ИдентификаторСообщенияУчастника,СтрТЧ.ТекущийУчастник,ЧитаемыйОтвет,ЭтоОтветОтЭмулятора);
						ИначеЕсли УзелОтветаОтПоставщика.ЛокальноеИмя = "ForcedAcknowledgementResponse"
							ИЛИ УзелОтветаОтПоставщика.ЛокальноеИмя = "ExportQuittancesResponse" Тогда
							
							//это обработка запроса на квитирование, отмену квитирования - ForcedAcknowledgementResponse
							//или это запрос квитанции
							
							Если ЭтоБылЗапросОтАЗ = Ложь Тогда
								ОбработатьРезультатКвитирования(СтруктураДанных.ИдентификаторСообщенияУчастника,СтрТЧ.ТекущийУчастник,ЧитаемыйОтвет,УзелОтветаОтПоставщика.ЛокальноеИмя,ЭтоОтветОтЭмулятора);
							Иначе
								//у АЗ может быть запрос только "ExportQuittancesResponse"
							КонецЕсли;
							
						ИначеЕсли УзелОтветаОтПоставщика.ЛокальноеИмя = "ExportPaymentsResponse" Тогда
							
							//это обработка экспорта платежей из сервиса
							
							Если ЭтоБылЗапросОтАЗ = Ложь Тогда
								ОбработатьРезультатЗапросаПлатежей(СтруктураДанных.ИдентификаторСообщенияУчастника,СтрТЧ.ТекущийУчастник,ЧитаемыйОтвет,ТаблицаДляЗапросаНовыхДанных,ЭтоОтветОтЭмулятора,ДополнительныеДанные);
							Иначе
								ОбработатьРезультатЗапросаПлатежей_АЗ(СтруктураДанных.ИдентификаторСообщенияУчастника,СтрТЧ.ТекущийУчастник,ЧитаемыйОтвет,ТаблицаДляЗапросаНовыхДанных,ЭтоОтветОтЭмулятора,ДополнительныеДанные);
							КонецЕсли;
							
						ИначеЕсли УзелОтветаОтПоставщика.ЛокальноеИмя = "SubscriptionServiceResponse" Тогда
							Если СтрНайти(ЧитаемыйОтвет,"Subscriptions")>0 Тогда
								//это запрос доступных подписок
								ОбработатьРезультатЗапросаДоступныхПодписок(СтруктураДанных.ИдентификаторСообщенияУчастника,СтрТЧ.ТекущийУчастник,ЧитаемыйОтвет,ТаблицаДляЗапросаНовыхДанных,ЭтоОтветОтЭмулятора);
							ИначеЕсли СтрНайти(ЧитаемыйОтвет, "CreateSubscriptionResult")>0 Тогда
								//это создание/измение/удаление подписки
								ОбработатьРезультатЗапросаПодключенияПодписки(СтруктураДанных.ИдентификаторСообщенияУчастника,СтрТЧ.ТекущийУчастник,ЧитаемыйОтвет,ТаблицаДляЗапросаНовыхДанных,ЭтоОтветОтЭмулятора);
								
							Иначе
								//еще тут может быть один варинт - изменение версии 
								УстановитьСтатусОбработкиСообщения(СтруктураДанных.ИдентификаторСообщенияУчастника,Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ОбработанБезОшибок);		
							КонецЕсли;
							
						ИначеЕсли УзелОтветаОтПоставщика.ЛокальноеИмя = "ExportNoticeRequest" Тогда
							//первый дочерний это Destination, а потом уже идет узел уведомления
							Если УзелОтветаОтПоставщика.ПоследнийДочерний.ЛокальноеИмя = "NoticePayment" Тогда
								//платеж
								ОбработатьПолучениеПлатежаПоПодписке(СтрТЧ.ТекущийУчастник,СтруктураДанных.ИдентификаторСообщенияСМЭВ,ЧитаемыйОтвет,ЭтоОтветОтЭмулятора);
								
							ИначеЕсли УзелОтветаОтПоставщика.ПоследнийДочерний.ЛокальноеИмя = "NoticeCharge" Тогда
								//начисление
								ОбработатьПолучениеНачисленияПоПодписке(СтрТЧ.ТекущийУчастник,СтруктураДанных.ИдентификаторСообщенияСМЭВ,ЧитаемыйОтвет,ЭтоОтветОтЭмулятора);
								
							ИначеЕсли УзелОтветаОтПоставщика.ПоследнийДочерний.ЛокальноеИмя = "NoticeQuittance" Тогда
								//квитанция о квитировании начисления с платежом
								ОбработатьПолучениеКвитанцииНачисленияСПлатежомПоПодписке(СтрТЧ.ТекущийУчастник,СтруктураДанных.ИдентификаторСообщенияСМЭВ,ЧитаемыйОтвет,ЭтоОтветОтЭмулятора);
								
							Иначе
								//NoticeChargeExecutive - Уведомления о неуплате начисления в установленный законодательством срок
								//NoticeQuittance - Уведомления о формировании квитанции
								//NoticeRuling - Уведомление о поступившем извещении о постановлении
								//NoticeIncome - Уведомления о поступившем зачислении, уточнении или аннулировании зачисления
								//NoticeParticipant - Уведомление об изменении или регистрации косвенных участников взаимодействия
								//NoticeAcknowledgement - Уведомление о принудительном квитировании
								//NoticeRefund - Уведомление о поступившем возврате, уточнении или аннулировании возврата
								//NoticeClarification - Уведомление о поступлении уточнения  вида и принадлежности платежа
								
							КонецЕсли;
						ИначеЕсли УзелОтветаОтПоставщика.ЛокальноеИмя = "ExportNSIResponse" Тогда
							
							ОбработатьПолучениеНСИ(СтруктураДанных.ИдентификаторСообщенияУчастника,СтрТЧ.ТекущийУчастник,ЧитаемыйОтвет,ЭтоОтветОтЭмулятора);
							
						Иначе
							//Это запрос, ответ на который мы не обрабатываем, 
							//например запрос возврата для тестирования обмена.
							//В этом случае просто установим, что ответ получен.
							УстановитьСтатусОбработкиСообщения(СтруктураДанных.ИдентификаторСообщенияУчастника,Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ОбработанБезОшибок);	
						КонецЕсли;
					КонецЕсли;
					
					
					Продолжить;
					
				КонецЕсли;
							
					
			Иначе
				//это может быть ответ на запрос из очереди статусов - в версии 1.2 СМЭВ не используется
				//Из описания сервиса, цитата:
				//"Поскольку СМЭВ поколения 2 работает в режиме принудительной передачи ответов,
            	//функциональность "узнать статус запроса и получить ответ, если он готов" отсутствует."
        
				ОбъектСхемы = ДокументDOM.ПолучитьЭлементыПоИмени("AsyncProcessingStatus");
				
				Если ОбъектСхемы.Количество()>0 Тогда
					СтруктураДанных = Новый Структура("ИдентификаторСообщенияСМЭВ,ИдентификаторСообщенияУчастника,Категория,Описание");
					
					//если сообщение уже подверждено, то в таблицу все равно добавляем, для последующего использования таблицы
					//при записи регистров обмена в форме обработки
					СтрокаТаблицыПодтвержденияСообщений = ТаблицаПодтвержденияПолученияСообщений.Добавить();
					СтрокаТаблицыПодтвержденияСообщений.ИдентификаторСообщенияЗапроса = СтрТЧ.ИдентификаторСообщения;
					СтрокаТаблицыПодтвержденияСообщений.Подтверждено = СтрТЧ.Подтверждено;
					
					ЭтоРезультатАсинхроннойПроверки = Ложь;
					
					ДанныеОбъекта = ОбъектСхемы[0];
					ТекстОшибки = "";
					Для Каждого ТекУзел Из ДанныеОбъекта.ДочерниеУзлы Цикл
																	
						Если ТекУзел.ЛокальноеИмя = "OriginalMessageId" Тогда
							СтруктураДанных.ИдентификаторСообщенияУчастника = ТекУзел.ТекстовоеСодержимое;
						ИначеЕсли ТекУзел.ЛокальноеИмя = "StatusCategory" Тогда
							СтруктураДанных.Категория = ТекУзел.ТекстовоеСодержимое;
						ИначеЕсли ТекУзел.ЛокальноеИмя = "StatusDetails" Тогда
							СтруктураДанных.Описание = ТекУзел.ТекстовоеСодержимое;
						ИначеЕсли ТекУзел.ЛокальноеИмя = "SmevFault" Тогда
							ТекстОшибки = СтрЗаменить(ТекУзел.ТекстовоеСодержимое,": ",Символы.ПС);
						КонецЕсли;											
											
					КонецЦикла;
					
					СтрокаТаблицыПодтвержденияСообщений.ИдентификаторСообщенияУчастника = СтруктураДанных.ИдентификаторСообщенияУчастника;
					
					ОбработатьРезультатАсинхроннойПроверки(СтруктураДанных,ТекстОшибки);
					
					Если НЕ ЗначениеЗаполнено(СтрокаТаблицыПодтвержденияСообщений.ИдентификаторСообщенияУчастника) Тогда
						ТаблицаПодтвержденияПолученияСообщений.Удалить(СтрокаТаблицыПодтвержденияСообщений);						
					КонецЕсли;
					
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

//процедуры формирования записей регистров для формирования запросов к сервису

Функция ПараметрыДляФормированияЗаписейРегистровЗапросаКГИСГМП(ДатаНачалаОбщая,ДатаОкончанияОбщая,КоличествоЧасов,ТипЗапроса,ТипИдентификатораДанных,ТипУчастникаГИСГМП) Экспорт
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ДатаНачалаОбщая",ДатаНачалаОбщая);
	СтруктураПараметров.Вставить("ДатаОкончанияОбщая",ДатаОкончанияОбщая);
	СтруктураПараметров.Вставить("КоличествоЧасов",КоличествоЧасов);
	СтруктураПараметров.Вставить("ТипЗапроса",ТипЗапроса);
	СтруктураПараметров.Вставить("ТипИдентификатораДанных",ТипИдентификатораДанных);
	СтруктураПараметров.Вставить("ТипУчастникаГИСГМП",ТипУчастникаГИСГМП);
	СтруктураПараметров.Вставить("МассивУчастников",Новый Массив);
	СтруктураПараметров.Вставить("МассивОтборПоКБК",Новый Массив);
	СтруктураПараметров.Вставить("МассивОтборПоИдентификаторам",Новый Массив);
	Возврат СтруктураПараметров;
КонецФункции

Процедура СкопироватьЗапросИзРегистровЗапросаКГИСГМП(ИдентификаторОбщегоЗапроса, МассивФорматов, ЕстьОшибка = Ложь, ТекстОшибки = "") Экспорт
	
	ОшибкаСозданияЗапроса = Ложь;
	ТекстОшибки = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ОчередьЗапросовКГИСГМПОбщие.ТипУчастникаГИСГМП КАК ТипУчастникаГИСГМП,
		|	ОчередьЗапросовКГИСГМПОбщие.ТипЗапрашиваемыхДанных КАК ТипЗапрашиваемыхДанных,
		|	ОчередьЗапросовКГИСГМПОбщие.ДатаНачалаОбщая КАК ДатаНачалаОбщая,
		|	ОчередьЗапросовКГИСГМПОбщие.ДатаОкончанияОбщая КАК ДатаОкончанияОбщая,
		|	ОчередьЗапросовКГИСГМПОбщие.КоличествоЧасов КАК КоличествоЧасов,
		|	ОчередьЗапросовКГИСГМПОбщие.КоличествоУчастников КАК КоличествоУчастников,
		|	ОчередьЗапросовКГИСГМПОбщие.ОтборПоУчастникам КАК ОтборПоУчастникам,
		|	ОчередьЗапросовКГИСГМПОбщие.ОтборПоКБК КАК ОтборПоКБК,
		|	ОчередьЗапросовКГИСГМПОбщие.КоличествоКБК КАК КоличествоКБК,
		|	ОчередьЗапросовКГИСГМПОбщие.ОтборПоИдентификаторам КАК ОтборПоИдентификаторам,
		|	ОчередьЗапросовКГИСГМПОбщие.КоличествоИдентификаторов КАК КоличествоИдентификаторов,
		|	ОчередьЗапросовКГИСГМПОбщие.ТипИдентификатораДанных КАК ТипИдентификатораДанных,
		|	ОчередьЗапросовКГИСГМПОбщие.Организация КАК Организация
		|ИЗ
		|	РегистрСведений.ОчередьЗапросовКГИСГМПОбщие КАК ОчередьЗапросовКГИСГМПОбщие
		|ГДЕ
		|	ОчередьЗапросовКГИСГМПОбщие.УИДНастройкиОбщегоЗапроса = &УИДНастройкиОбщегоЗапроса
		|";
	
	Запрос.УстановитьПараметр("УИДНастройкиОбщегоЗапроса", ИдентификаторОбщегоЗапроса);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
		ТипУчастникаГИСГМП = ВыборкаДетальныеЗаписи.ТипУчастникаГИСГМП;
		ТекДатаНачала = ВыборкаДетальныеЗаписи.ДатаНачалаОбщая;
		ТекДатаОкончания = ВыборкаДетальныеЗаписи.ДатаОкончанияОбщая;
		КоличествоЧасов = ВыборкаДетальныеЗаписи.КоличествоЧасов;
		ТипЗапрашиваемыхДанных = ВыборкаДетальныеЗаписи.ТипЗапрашиваемыхДанных;
		ТипИдентификатораДанных = ВыборкаДетальныеЗаписи.ТипИдентификатораДанных;
		
		СтруктураПараметров = ГосУслуги.ПараметрыДляФормированияЗаписейРегистровЗапросаКГИСГМП(ТекДатаНачала,
			ТекДатаОкончания,КоличествоЧасов,ТипЗапрашиваемыхДанных,ТипИдентификатораДанных,ТипУчастникаГИСГМП);
			
		МассивИдентификаторов = ВыборкаДетальныеЗаписи.ОтборПоИдентификаторам.Получить();
		Если МассивИдентификаторов<>Неопределено Тогда
			СтруктураПараметров.МассивОтборПоИдентификаторам = МассивИдентификаторов;		
		КонецЕсли;
		
		МассивУчастников = ВыборкаДетальныеЗаписи.ОтборПоУчастникам.Получить();
		Если МассивУчастников<>Неопределено Тогда
			СтруктураПараметров.МассивУчастников = МассивУчастников;		
		КонецЕсли;
		
		МассивОтборПоКБК = ВыборкаДетальныеЗаписи.ОтборПоКБК.Получить();
		Если МассивОтборПоКБК<>Неопределено Тогда
			СтруктураПараметров.МассивОтборПоКБК = МассивОтборПоКБК;		
		КонецЕсли;
			
		ГосУслуги.СформироватьЗаписиРегистровЗапросаКГИСГМП(ВыборкаДетальныеЗаписи.Организация, СтруктураПараметров, МассивФорматов, ЕстьОшибка, ТекстОшибки);
		
	Иначе
		
		ТекстОшибки = "Не удалось получить настройки для копирования запроса";
		ЕстьОшибка = Истина;
	КонецЕсли;
		
	
КонецПроцедуры



Процедура СформироватьЗаписиРегистровЗапросаКГИСГМП(ОрганизацияУчастник, СтруктураПараметров, МассивФорматовЭкспорта, ЕстьОшибка = Ложь, ТекстОшибки = "") Экспорт
	
	НачатьТранзакцию();
	Попытка
		ИдентификаторОбщегоЗапроса = Новый УникальныйИдентификатор;
		МассивУчастников = СтруктураПараметров.МассивУчастников;
		
		Если МассивУчастников = Неопределено Тогда
			МассивУчастников = Новый Массив;
		КонецЕсли;
		
		КоличествоУч = МассивУчастников.Количество();
		
		МассивОтборПоКБК = СтруктураПараметров.МассивОтборПоКБК;
		Если МассивОтборПоКБК = Неопределено Тогда
			МассивОтборПоКБК = Новый Массив;
		КонецЕсли;
		КоличествоКБК = МассивОтборПоКБК.Количество();
		
		МассивОтборПоИдентификаторам = СтруктураПараметров.МассивОтборПоИдентификаторам;
		Если МассивОтборПоИдентификаторам = Неопределено Тогда
			МассивОтборПоИдентификаторам = Новый Массив;
		КонецЕсли;
		КоличествоИдентификаторов = МассивОтборПоИдентификаторам.Количество();
		
		ЗаписьРС = РегистрыСведений.ОчередьЗапросовКГИСГМПОбщие.СоздатьМенеджерЗаписи();
		ЗаписьРС.Организация = ОрганизацияУчастник;
		ЗаписьРС.УИДНастройкиОбщегоЗапроса = ИдентификаторОбщегоЗапроса;
		ЗаписьРС.ДатаСоздания = ТекущаяДатаСеанса();
		ЗаписьРС.ДатаНачалаОбщая = СтруктураПараметров.ДатаНачалаОбщая;
		ЗаписьРС.ДатаОкончанияОбщая = СтруктураПараметров.ДатаОкончанияОбщая;
		ЗаписьРС.ТипЗапрашиваемыхДанных = СтруктураПараметров.ТипЗапроса;
		ЗаписьРС.ТипУчастникаГИСГМП = СтруктураПараметров.ТипУчастникаГИСГМП;
		ЗаписьРС.ОтборПоУчастникам = Новый ХранилищеЗначения(МассивУчастников,Новый СжатиеДанных(9));
		ЗаписьРС.КоличествоУчастников = КоличествоУч;
		ЗаписьРС.ОтборПоКБК = Новый ХранилищеЗначения(МассивОтборПоКБК,Новый СжатиеДанных(9));
		ЗаписьРС.КоличествоКБК = КоличествоКБК;
		ЗаписьРС.ОтборПоИдентификаторам = Новый ХранилищеЗначения(МассивОтборПоИдентификаторам,Новый СжатиеДанных(9));
		ЗаписьРС.КоличествоИдентификаторов = КоличествоИдентификаторов;
		ЗаписьРС.ТипИдентификатораДанных = СтруктураПараметров.ТипИдентификатораДанных;
		ЗаписьРС.КоличествоЧасов = СтруктураПараметров.КоличествоЧасов;
		ЗаписьРС.Пользователь = Пользователи.АвторизованныйПользователь();
		ЗаписьРС.СтатусОбщегоЗапроса = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.Запланирован;
		ЗаписьРС.Записать();
		
		НастройкиУчастника = БиблиотекаФункцийОбмена.ПолучитьНастройкиОрганизации(ОрганизацияУчастник);
		
		
		ТекДатаНачала = СтруктураПараметров.ДатаНачалаОбщая;
		КонечнаяДата = СтруктураПараметров.ДатаОкончанияОбщая;
		
		Если ЗначениеЗаполнено(КонечнаяДата) Тогда
			КонечнаяДата = КонецДня(КонечнаяДата);
		КонецЕсли;
		
		//ТекДатаОкончания - первое значение даты окончания, если запрос будет разделен на периоды
		Если СтруктураПараметров.КоличествоЧасов = 0 Тогда
			ТекДатаОкончания = КонечнаяДата;
		Иначе
			ТекДатаОкончания = ТекДатаНачала + 3600*СтруктураПараметров.КоличествоЧасов-1;
			ТекДатаОкончания = Мин(ТекДатаОкончания,КонечнаяДата);
		КонецЕсли;
			
		ТаблицаСоответствияСообщений = Новый ТаблицаЗначений;
		ТаблицаСоответствияСообщений.Колонки.Добавить("ФорматОбмена");
		ТаблицаСоответствияСообщений.Колонки.Добавить("НомерЦиклаОтбораУчастников");
		ТаблицаСоответствияСообщений.Колонки.Добавить("НомерЦиклаОтбораКБК");
		ТаблицаСоответствияСообщений.Колонки.Добавить("НомерЦиклаОтбораИдентификаторов");
		ТаблицаСоответствияСообщений.Колонки.Добавить("ЭталонноеСообщение");
		ТаблицаСоответствияСообщений.Индексы.Добавить("ФорматОбмена,НомерЦиклаОтбораУчастников,НомерЦиклаОтбораКБК,НомерЦиклаОтбораИдентификаторов");	
		
		ОбработкаФормирования = Обработки.ОбменВФорматахУФК_УФЭБС.Создать();
		
		ФразаИдентификатор = "%ТутБудетИдентификаторСообщения%";
		ОбработкаФормирования.ИдентификаторСообщения = ФразаИдентификатор;
		ОбработкаФормирования.мОрганизация = ОрганизацияУчастник;	
		
		СтруктураДляФормирования = Новый Структура("КассовыйОрган");//выпилить?
		СтруктураДляФормирования.Вставить("Дата", ТекущаяДатаСеанса());
		СтруктураДляФормирования.Вставить("ВидОбмена", НастройкиУчастника.ВидОбмена);
		СтруктураДляФормирования.Вставить("НастройкаОбмена", НастройкиУчастника.НастройкаОбмена);
		СтруктураДляФормирования.Вставить("Организация", ОрганизацияУчастник);
		СтруктураДляФормирования.Вставить("Ссылка",Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПустаяСсылка());
		
		ОбщОбъектыОбмена = Новый ТаблицаЗначений;
		ОбщОбъектыОбмена.Колонки.Добавить("ОписаниеОшибки");
		ОбщОбъектыОбмена.Колонки.Добавить("ИмяФайлаВыгрузки");
		ОбщОбъектыОбмена.Колонки.Добавить("Формат");
		ОбщОбъектыОбмена.Колонки.Добавить("Объект");
		ОбщОбъектыОбмена.Колонки.Добавить("РезультатФормирования");
		
	    ТаблицаДат = ПолучитьТаблицуДат(ТекДатаНачала,ТекДатаОкончания,КонечнаяДата,СтруктураПараметров.КоличествоЧасов);
		
		ЦикловУч = 0;
		//максимальное количество участников в отборе - 10
		Если КоличествоУч >0 Тогда	
			Если КоличествоУч/10 = Цел(КоличествоУч/10) Тогда
				ЦикловУч = КоличествоУч/10-1;
			Иначе
				ЦикловУч = КоличествоУч/10;
			КонецЕсли;
		КонецЕсли;
		
		ЦикловКБК = 0;
		//максимальное количество КБК в отборе - 10
		Если КоличествоКБК >0 Тогда	
			Если КоличествоКБК/10 = Цел(КоличествоКБК/10) Тогда
				ЦикловКБК = КоличествоКБК/10-1;
			Иначе
				ЦикловКБК = КоличествоКБК/10;
			КонецЕсли;
		КонецЕсли;
		
		ЦикловИдентификаторов = 0;
		//максимальное количество Идентификаторов в отборе - 100
		Если КоличествоИдентификаторов >0 Тогда	
			Если КоличествоИдентификаторов/100 = Цел(КоличествоИдентификаторов/100) Тогда
				ЦикловИдентификаторов = КоличествоИдентификаторов/100-1;
			Иначе
				ЦикловИдентификаторов = КоличествоИдентификаторов/100;
			КонецЕсли;
		КонецЕсли;
		
		СоответствиеМассивовУчастников = Новый Соответствие;
		СоответствиеМассивовКБК = Новый Соответствие;
		СоответствиеМассивовИдентфикаторов = Новый Соответствие;
		
		Для ТекЦиклУч = 0 По ЦикловУч Цикл
			МассивПояснений = Новый Массив;
			СтрокаПоясненийУч = "";
			Если КоличествоУч>0 Тогда			
				СтрокаПоясненийУч = НСтр("ru='Участники %1-%2'");
				СтрокаПоясненийУч = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СтрокаПоясненийУч,ТекЦиклУч*10+1, Мин(ТекЦиклУч*10 + 10,КоличествоУч));
			КонецЕсли;
			
			ТекМассивУчастников = СоответствиеМассивовУчастников[ТекЦиклУч];
			Если ТекМассивУчастников = Неопределено Тогда
				ТекМассивУчастников = Новый Массив;
				Для Инд = ТекЦиклУч*10 По Мин(ТекЦиклУч*10 + 9,КоличествоУч-1) Цикл
					ТекМассивУчастников.Добавить(МассивУчастников[Инд]);
				КонецЦикла;
				СоответствиеМассивовУчастников.Вставить(ТекЦиклУч,ТекМассивУчастников);
			КонецЕсли;
			ТекКоличествоУчастников = ТекМассивУчастников.Количество();
			
			Для ТекЦиклКБК = 0 По ЦикловКБК Цикл
				СтрокаПоясненийКБК = "";
				Если КоличествоКБК>0 Тогда
					СтрокаПоясненийКБК = НСтр("ru='КБК %1-%2'");
					СтрокаПоясненийКБК = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СтрокаПоясненийКБК,ТекЦиклКБК*10+1, Мин(ТекЦиклКБК*10 + 10,КоличествоКБК));
				КонецЕсли;
				
				ТекМассивКБК = СоответствиеМассивовКБК[ТекЦиклКБК];
				Если ТекМассивКБК = Неопределено Тогда
					ТекМассивКБК = Новый Массив;
					Для Инд = ТекЦиклКБК*10 По Мин(ТекЦиклКБК*10 + 9,КоличествоКБК-1) Цикл
						ТекМассивКБК.Добавить(МассивОтборПоКБК[Инд]);
					КонецЦикла;
					СоответствиеМассивовКБК.Вставить(ТекЦиклКБК,ТекМассивКБК);
				КонецЕсли;
				ТекКоличествоКБК = ТекМассивКБК.Количество();
				
				Для ТекЦиклИдентификаторов = 0 По ЦикловИдентификаторов Цикл
				    СтрокаПоясненийИдентификаторов = "";
					Если КоличествоИдентификаторов>0 Тогда
						СтрокаПоясненийИдентификаторов = НСтр("ru='Идентификаторов %1-%2'");
						СтрокаПоясненийИдентификаторов = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СтрокаПоясненийИдентификаторов,ТекЦиклИдентификаторов*10+1, Мин(ТекЦиклИдентификаторов*10 + 10,ТекЦиклИдентификаторов));
					КонецЕсли;
					
					ТекМассивИдентификаторов = СоответствиеМассивовИдентфикаторов[ТекЦиклИдентификаторов];
					Если ТекМассивИдентификаторов = Неопределено Тогда
						ТекМассивИдентификаторов = Новый Массив;
						Для Инд = ТекЦиклИдентификаторов*10 По Мин(ТекЦиклИдентификаторов*10 + 9,КоличествоИдентификаторов-1) Цикл
							ТекМассивИдентификаторов.Добавить(МассивОтборПоИдентификаторам[Инд]);
						КонецЦикла;
						СоответствиеМассивовИдентфикаторов.Вставить(ТекЦиклИдентификаторов,ТекМассивИдентификаторов);
					КонецЕсли;
					ТекКоличествоИдентификаторов = ТекМассивИдентификаторов.Количество();	
					
					СтрокаПояснения = СформироватьСтрокуПоясненийПоОтборам(СтрокаПоясненийУч,СтрокаПоясненийКБК,СтрокаПоясненийИдентификаторов);
					 
					Для Каждого ТекФормат Из МассивФорматовЭкспорта Цикл
						
						Для Каждого СтрокаДат Из ТаблицаДат Цикл
						
							ЗаписьДетальная = РегистрыСведений.ОчередьЗапросовКГИСГМПДетальные.СоздатьМенеджерЗаписи();
							ЗаписьДетальная.Организация = ОрганизацияУчастник;
							ЗаписьДетальная.УИДНастройкиОбщегоЗапроса = ИдентификаторОбщегоЗапроса;
							ЗаписьДетальная.УИДНастройкиДетальногоЗапроса = Новый УникальныйИдентификатор;
							ЗаписьДетальная.ТипУчастникаГИСГМП = СтруктураПараметров.ТипУчастникаГИСГМП;
							ЗаписьДетальная.ДатаСоздания = ЗаписьРС.ДатаСоздания;
							ЗаписьДетальная.СтатусДетальногоЗапроса = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.Запланирован;
							ЗаписьДетальная.ДатаНачалаДетальная = СтрокаДат.ДатаНачала;
							ЗаписьДетальная.ДатаОкончанияДетальная = СтрокаДат.ДатаОкончания;
							ЗаписьДетальная.ТипЗапрашиваемыхДанных = СтруктураПараметров.ТипЗапроса;
							ЗаписьДетальная.ТипИдентификатораДанных = ЗаписьРС.ТипИдентификатораДанных;
														
							ЗаписьДетальная.ОтборПоУчастникам = Новый ХранилищеЗначения(ТекМассивУчастников,Новый СжатиеДанных(9));
							ЗаписьДетальная.КоличествоУчастников = ТекКоличествоУчастников;
							
							ЗаписьДетальная.ОтборПоКБК = Новый ХранилищеЗначения(ТекМассивКБК,Новый СжатиеДанных(9));
							ЗаписьДетальная.КоличествоКБК = ТекКоличествоКБК;
							
							ЗаписьДетальная.ОтборПоИдентификаторам = Новый ХранилищеЗначения(МассивОтборПоИдентификаторам,Новый СжатиеДанных(9));
							ЗаписьДетальная.КоличествоИдентификаторов = ТекКоличествоИдентификаторов;
							
							ЗаписьДетальная.ФорматОбмена = ТекФормат;
							ЗаписьДетальная.Пояснение = СтрокаПояснения;
							
							
							СтруктураПоиска = Новый Структура("ФорматОбмена,НомерЦиклаОтбораУчастников,НомерЦиклаОтбораКБК,НомерЦиклаОтбораИдентификаторов",
														ТекФормат,ТекЦиклУч,ТекЦиклКБК,ТекЦиклИдентификаторов);
							НайденныеСтроки = ТаблицаСоответствияСообщений.НайтиСтроки(СтруктураПоиска);
							Если НайденныеСтроки.Количество() = 0 Тогда
								СтрокаТЧ = ТаблицаСоответствияСообщений.Добавить();
								СтрокаТЧ.ФорматОбмена = ТекФормат;
								СтрокаТЧ.НомерЦиклаОтбораУчастников = ТекЦиклУч;
								СтрокаТЧ.НомерЦиклаОтбораКБК = ТекЦиклКБК;
								СтрокаТЧ.НомерЦиклаОтбораИдентификаторов = ТекЦиклИдентификаторов;
								
								ОбщОбъектыОбмена.Очистить();
								
								СтрокаОбмена = ОбщОбъектыОбмена.Добавить();
								СтрокаОбмена.Объект = Документы.ЗапросУНИФО.ПустаяСсылка();
								СтрокаОбмена.Формат = ТекФормат;
								
								ДополнительныеПараметрыФорматов = Новый Структура;
								ДополнительныеПараметрыФорматов.Вставить("КоличествоУчастников",ЗаписьДетальная.КоличествоУчастников);
								ДополнительныеПараметрыФорматов.Вставить("КоличествоКБК",ЗаписьДетальная.КоличествоКБК);
								ДополнительныеПараметрыФорматов.Вставить("КоличествоИдентификаторов",ЗаписьДетальная.КоличествоИдентификаторов);
								ДополнительныеПараметрыФорматов.Вставить("ТипИдентификатораДанных",ЗаписьДетальная.ТипИдентификатораДанных);
								ДополнительныеПараметрыФорматов.Вставить("ТипЗапрашиваемыхДанных",ЗаписьДетальная.ТипЗапрашиваемыхДанных);
								ДополнительныеПараметрыФорматов.Вставить("ТипУчастникаГИСГМП",ЗаписьДетальная.ТипУчастникаГИСГМП);
								ДополнительныеПараметрыФорматов.Вставить("ДатаНачалаЗаполнена",ЗначениеЗаполнено(ЗаписьДетальная.ДатаНачалаДетальная));
								ДополнительныеПараметрыФорматов.Вставить("ДатаОкончанияЗаполнена",ЗначениеЗаполнено(ЗаписьДетальная.ДатаОкончанияДетальная));
								
								ОбработкаФормирования.МассивОтбораПоУчастникам = ТекМассивУчастников;
								ОбработкаФормирования.МассивОтбораПоКБК = ТекМассивКБК;
								ОбработкаФормирования.МассивОтбораПоИдентификаторам = МассивОтборПоИдентификаторам;
								
								ОбработкаФормирования.ДополнительныеПараметрыЭкспорта = ДополнительныеПараметрыФорматов;
								СтруктураДляФормирования.Вставить("ОбъектыОбмена", ОбщОбъектыОбмена);
								
								ОбработкаФормирования.СоответствиеОбработанныхФорматов = Неопределено;
								ОбработкаФормирования.СформироватьФайлы(СтруктураДляФормирования);
								
								ТекРезультатФормирования = "";
								ТаблицаОписанияОшибокСтрокой = "";
								Для Каждого СтрокаОбмена Из СтруктураДляФормирования.ОбъектыОбмена Цикл 
									ТекРезультатФормирования = СтрокаОбмена.РезультатФормирования;
									ТаблицаОписанияОшибокСтрокой = СтрокаОбмена.ОписаниеОшибки;
								КонецЦикла;
								
							    СтрокаТЧ.ЭталонноеСообщение = ТекРезультатФормирования;
							Иначе
								СтрокаТЧ = НайденныеСтроки[0];						
							КонецЕсли;
							
							//тут заменяем даты - дату начала, дату окончания, как БиблиотекаФункцийОбмена.ВернутьУниверсальноеВремя() в формате Формат(Значение, "ДФ=yyyy-MM-ddTHH:mm:ssZ")
							//идентификатор сообщения и дату формирования (timestamp) - заполнять надо уже перед формированием подписи и отправкой

							ТекстСообщения = СтрокаТЧ.ЭталонноеСообщение;
							ТекстСообщения = СтрЗаменить(ТекстСообщения,"%ДатаНачала%",СтрокаДат.ДатаНачалаСтрокой);
							ТекстСообщения = СтрЗаменить(ТекстСообщения,"%ДатаОкончания%",СтрокаДат.ДатаОкончанияСтрокой);				
							
							ЗаписьДетальная.ЭталонноеСообщение = Новый ХранилищеЗначения(ТекстСообщения,Новый СжатиеДанных(9));
							
							ЗаписьДетальная.Записать();
							
							ЗаписьВыполняемыйЗапрос = РегистрыСведений.ВыполняемыеЗапросыОчередиКГИСГМП.СоздатьМенеджерЗаписи();
							ЗаписьВыполняемыйЗапрос.Организация = ОрганизацияУчастник;
							ЗаписьВыполняемыйЗапрос.УИДНастройкиОбщегоЗапроса = ЗаписьДетальная.УИДНастройкиОбщегоЗапроса;
							ЗаписьВыполняемыйЗапрос.УИДНастройкиДетальногоЗапроса = ЗаписьДетальная.УИДНастройкиДетальногоЗапроса;
							ЗаписьВыполняемыйЗапрос.УИДВыполняемогоЗапросаКГИСГМП = Новый УникальныйИдентификатор;
							ЗаписьВыполняемыйЗапрос.СтатусВыполняемогоЗапроса = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.Запланирован;
							ЗаписьВыполняемыйЗапрос.СтраницаРезультата = 1;
							ЗаписьВыполняемыйЗапрос.ДатаСоздания = ТекущаяДатаСеанса();
							ЗаписьВыполняемыйЗапрос.Записать();
						КонецЦикла;
					КонецЦикла;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЕстьОшибка = Истина;
		ТекстОшибки = НСтр("ru='При создании запроса к сервису по настройкам возникла ошибка: %1'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("Запрос к ГИС ГМП/ИС РНИП/ИС УНП",УровеньЖурналаРегистрации.Ошибка,Метаданные.Обработки.ОбменГИСГМП2,,ТекстОшибки);
	КонецПопытки;
КонецПроцедуры

Функция ПолучитьТаблицуДат(ТекДатаНачала,ТекДатаОкончания,КонечнаяДата,КоличествоЧасов)
	ТаблицаДат = Новый ТаблицаЗначений;
	ТаблицаДат.Колонки.Добавить("ДатаНачала");
	ТаблицаДат.Колонки.Добавить("ДатаНачалаСтрокой");
	ТаблицаДат.Колонки.Добавить("ДатаОкончания");
	ТаблицаДат.Колонки.Добавить("ДатаОкончанияСтрокой");
	
	Если ЗначениеЗаполнено(ТекДатаНачала) И ЗначениеЗаполнено(КонечнаяДата) Тогда
	
		Пока ТекДатаНачала<КонечнаяДата Цикл
			СтрокаДат = ТаблицаДат.Добавить();
			СтрокаДат.ДатаНачала = ТекДатаНачала;
			СтрокаДат.ДатаОкончания = ТекДатаОкончания;
			
			СтрокаДат.ДатаНачалаСтрокой = Формат(БиблиотекаФункцийОбмена.ВернутьУниверсальноеВремя(ТекДатаНачала),"ДФ=yyyy-MM-ddTHH:mm:ssZ");
			СтрокаДат.ДатаОкончанияСтрокой = Формат(БиблиотекаФункцийОбмена.ВернутьУниверсальноеВремя(ТекДатаОкончания),"ДФ=yyyy-MM-ddTHH:mm:ssZ");
			
			ТекДатаНачала = ТекДатаОкончания+1;
			
			ТекДатаОкончания = ТекДатаНачала + 3600*КоличествоЧасов-1;
			ТекДатаОкончания = Мин(ТекДатаОкончания,КонечнаяДата);
		КонецЦикла;
	Иначе
		//добавим одну строку
		СтрокаДат = ТаблицаДат.Добавить();
		СтрокаДат.ДатаНачала = ТекДатаНачала;
		СтрокаДат.ДатаОкончания = ТекДатаОкончания;
	КонецЕсли;
	
	Возврат ТаблицаДат;
КонецФункции

Функция СформироватьСтрокуПоясненийПоОтборам(СтрокаПоясненийУч,СтрокаПоясненийКБК,СтрокаПоясненийИдентификаторов)
	СтрокаПояснений = "";
	Массив = Новый Массив;
	Если ЗначениеЗаполнено(СтрокаПоясненийУч) Тогда
		Массив.Добавить(СтрокаПоясненийУч);
	КонецЕсли;
	Если ЗначениеЗаполнено(СтрокаПоясненийКБК) Тогда
		Массив.Добавить(СтрокаПоясненийКБК);
	КонецЕсли;
	Если ЗначениеЗаполнено(СтрокаПоясненийИдентификаторов) Тогда
		Массив.Добавить(СтрокаПоясненийИдентификаторов);
	КонецЕсли;
	Если Массив.Количество() Тогда
		СтрокаПояснений = "Отбор: " + СтрСоединить(Массив,", ");
	КонецЕсли;
	Возврат СтрокаПояснений;
КонецФункции

//  ОбработатьРезультатЭкспорта - это процедуры обработки сообщений при отправке данных (экспорте) из текущей базы в сервис

Процедура ОбработатьРезультатЭкспортаНачислений(ПакетСсылка,Успешно)
	
	УстановитьПривилегированныйРежим(Истина);
	//Выполняется в привилегированном режиме,
	//т.к. при передаче ГАНом начислений подведомственных,
	//документы могут быть не ГАНа, а подведомственного участника.
	
	ТекДокОбъект = ПакетСсылка.ПолучитьОбъект();
	
	Если ТекДокОбъект <> Неопределено Тогда
		
		Если Успешно = Истина Тогда
			ТекДокОбъект.СтатусОбработки = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.ВОчереди;
			УстанавливаемыйСтатус = Перечисления.СтатусыИсполненияДокумента.ПереданВОбработку;
		Иначе
			//если пакет не приняли, вернем статус Подготовлен
			ТекДокОбъект.СтатусОбработки = Перечисления.РезультатыОтправкиСообщенийВСМЭВ.НеПринятСМЭВ;
			УстанавливаемыйСтатус = Перечисления.СтатусыИсполненияДокумента.Подготовлен;
		КонецЕсли;
		
		//очистим результат предыдущего обмена
		ТекДокОбъект.РезультатОбработкиОбщий = "";
		
		Для Каждого СтрокаТЧ Из ТекДокОбъект.Начисления Цикл
		    //очистим результат предыдущего обмена
			СтрокаТЧ.РезультатИмпортаКод = "";
			СтрокаТЧ.РезультатИмпортаОписание = "";
			
			//Установим новый статус начислениям
			СтруктураРекв = Новый Структура;
			СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",СтрокаТЧ.НачислениеСсылка);
			СтруктураРекв.Вставить("Статус",УстанавливаемыйСтатус);
			ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
			
		КонецЦикла;
		
		ТекДокОбъект.Записать();
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

