					КонецЦикла;
					
					СерияПриведенная = "";
					Для инд = 1 по СтрДлина(ВыборкаДетальныеЗаписи.Серия) Цикл
						ТекСимвол = ВРег(Сред(ВыборкаДетальныеЗаписи.Серия,инд,1));
						Если Найти(СтрокаБуквЦифр,ТекСимвол)>0 Тогда
							СерияПриведенная = СерияПриведенная+ТекСимвол;
						КонецЕсли;
					КонецЦикла;
					Если ЗначениеЗаполнено(НомерПриведенный) ИЛИ ЗначениеЗаполнено(СерияПриведенная) Тогда 
						ТекИдентификатор = ВыборкаДетальныеЗаписи.Префикс + СтроковыеФункцииКлиентСервер.ДополнитьСтроку(СерияПриведенная+НомерПриведенный,19);
						Прервать;
					КонецЕсли;
				КонецЕсли;			
			КонецЕсли;
		КонецЕсли;
		
		//Если идентификатор ранее был задан, то присвоим его и на этом закончим.
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.АльтернативныйИдентификатор) Тогда
			ТекИдентификатор = ВыборкаДетальныеЗаписи.АльтернативныйИдентификатор;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ТекИдентификатор) Тогда
		СтруктураОтвета.Результат = Истина;
	КонецЕсли;
	
	Если СтруктураОтвета.Результат = Ложь Тогда
		СтруктураОтвета.Текст = НСтр("ru='По имеющимся настройкам и данным не удалось сформировать идентификатор плательщика.'");
		СтруктураОтвета.ПолеПроблемы = "Контрагент";
	КонецЕсли;
	
    УстановитьПривилегированныйРежим(Ложь);
	Возврат СтруктураОтвета;
КонецФункции


/////////////////////////////////////////////////////////////////////////
// Импорт платежей

// Возвращает ссылку на квитанцию, найденную по УИН
Функция НайтиКвитанциюПоУИН(УИН) Экспорт
	ИскомыйУИН = СокрЛП(УИН);
	Если НЕ ЗначениеЗаполнено(ИскомыйУИН) Тогда
		Возврат Документы.КвитанцияНаОплатуГосуслуг.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КвитанцияНаОплатуГосуслуг.Ссылка
		|ИЗ
		|	Документ.КвитанцияНаОплатуГосуслуг КАК КвитанцияНаОплатуГосуслуг
		|ГДЕ
		|	КвитанцияНаОплатуГосуслуг.УникальныйИдентификаторНачисления = &УникальныйИдентификаторНачисления
		|	И КвитанцияНаОплатуГосуслуг.ПометкаУдаления = ЛОЖЬ";

	Запрос.УстановитьПараметр("УникальныйИдентификаторНачисления", ИскомыйУИН);

	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();

	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;
	
	Возврат Документы.КвитанцияНаОплатуГосуслуг.ПустаяСсылка();
	
КонецФункции

Процедура ЗаполнитьНоменклатуруИПлательщикаПлатежа(Платеж) Экспорт
	
	Платеж.ДополнительныеСвойства.Вставить("ПроверитьСтатусИсполнения",Истина);
	Платеж.ДополнительныеСвойства.Вставить("УстановитьВСоответствиеНачисление",Истина);
	
	//Если это платеж подведомственному, то заполняем в другой процедуре
	Если ТипЗнч(Платеж) = Тип("ДокументОбъект.ПлатежПодведомственному") Тогда
		ЗаполнитьНоменклатуруИПлательщикаПлатежаПодведомственного(Платеж);
		Возврат;
	КонецЕсли;
	Платеж.Плательщик = Неопределено;
	Платеж.Договор = Неопределено;
	Платеж.Учащийся = Неопределено;
	
	Платеж.Плательщик = НайтиФизЛицоПоИдентификатору(Платеж.ИдентификаторПлательщика,Платеж.Дата);
	
	Найден = Ложь;          
	Платеж.Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
	ДеревоСтруктуры = Неопределено;
	//Если ЗначениеЗаполнено(Платеж.УникальныйИдентификаторНачисления) Тогда
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КвитанцияНаОплатуГосуслуг.Ссылка,
		|	КвитанцияНаОплатуГосуслуг.Плательщик,
		|	КвитанцияНаОплатуГосуслуг.Номенклатура,
		|	КвитанцияНаОплатуГосуслуг.КодБКПлатежа,
		|	КвитанцияНаОплатуГосуслуг.КодОКАТО,
		|	ХарактеристикиГосуслугСрезПоследних.ЗначениеНастройки,
		|	КвитанцияНаОплатуГосуслуг.Договор,
		|	КвитанцияНаОплатуГосуслуг.Учащийся,
		|	2 КАК ПорядокСортировки
		|ИЗ
		|	Документ.КвитанцияНаОплатуГосуслуг КАК КвитанцияНаОплатуГосуслуг
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ХарактеристикиГосуслуг.СрезПоследних(&Дата, ) КАК ХарактеристикиГосуслугСрезПоследних
		|		ПО КвитанцияНаОплатуГосуслуг.Номенклатура = ХарактеристикиГосуслугСрезПоследних.Номенклатура
		|ГДЕ
		|	КвитанцияНаОплатуГосуслуг.УникальныйИдентификаторНачисления = &УникальныйИдентификаторНачисления
		|	И Подстрока(КвитанцияНаОплатуГосуслуг.УникальныйИдентификаторНачисления,2,1)<>""""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СоответствиеНачисленийИПлатежей.Начисление,
		|	СоответствиеНачисленийИПлатежей.Начисление.Плательщик,
		|	СоответствиеНачисленийИПлатежей.Начисление.Номенклатура,
		|	СоответствиеНачисленийИПлатежей.Начисление.КодБКПлатежа,
		|	СоответствиеНачисленийИПлатежей.Начисление.КодОКАТО,
		|	ХарактеристикиГосуслугСрезПоследних.ЗначениеНастройки,
		|	СоответствиеНачисленийИПлатежей.Начисление.Договор,
		|	СоответствиеНачисленийИПлатежей.Начисление.Учащийся,
		|	1
		|ИЗ
		|	РегистрСведений.СоответствиеНачисленийИПлатежей КАК СоответствиеНачисленийИПлатежей
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ХарактеристикиГосуслуг.СрезПоследних(&Дата, ) КАК ХарактеристикиГосуслугСрезПоследних
		|		ПО СоответствиеНачисленийИПлатежей.Начисление.Номенклатура = ХарактеристикиГосуслугСрезПоследних.Номенклатура
		|ГДЕ
		|	СоответствиеНачисленийИПлатежей.Платеж = &Платеж
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПорядокСортировки";

	Запрос.УстановитьПараметр("УникальныйИдентификаторНачисления", Платеж.УникальныйИдентификаторНачисления);
    Запрос.УстановитьПараметр("Дата", Платеж.Дата);
	Запрос.УстановитьПараметр("Платеж", Платеж.Ссылка);
	
	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();

	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Найден = Истина;
		//Если НЕ ЗначениеЗаполнено(Платеж.Плательщик) Тогда
		Платеж.Плательщик = ВыборкаДетальныеЗаписи.Плательщик;
		Платеж.Договор = ВыборкаДетальныеЗаписи.Договор;
		Платеж.Учащийся = ВыборкаДетальныеЗаписи.Учащийся;
		//КонецЕсли;
		Платеж.Номенклатура = ВыборкаДетальныеЗаписи.Номенклатура;
		Если Не ЗначениеЗаполнено(Платеж.КодБКПлатежа) Тогда
			Платеж.КодБКПлатежа = ВыборкаДетальныеЗаписи.КодБКПлатежа;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Платеж.КодОКАТО) Тогда
			Платеж.КодОКАТО = ВыборкаДетальныеЗаписи.КодОКАТО;
		КонецЕсли;

		Если ТипЗнч(ВыборкаДетальныеЗаписи.ЗначениеНастройки) = Тип("ХранилищеЗначения") Тогда
			ПолученноеЗначение = ВыборкаДетальныеЗаписи.ЗначениеНастройки.Получить();
			Если ТипЗнч(ПолученноеЗначение) = Тип("Структура") Тогда
				ДеревоСтруктуры = ПолученноеЗначение.ДополнительныеХарактеристикиНоменклатуры;
				ТаблицаИдн = ПолученноеЗначение.ТаблицаИдентификаторов;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	
	//Ищем по коду услуги из AdditionalData
	Если Платеж.ДополнительныеДанные.Количество()>0 Тогда
		//Приведем к общему виду имена файлов - все в верхний регистр
		//ТаблицаДопДанных = Платеж.ДополнительныеДанные.Выгрузить();
		Для Каждого СтрДопДанных Из Платеж.ДополнительныеДанные Цикл
			СтрДопДанных.ИмяВФайле = ВРег(СтрДопДанных.ИмяВФайле);
		КонецЦикла;
	
		СтрокаДанных = Платеж.ДополнительныеДанные.Найти("SRV_CODE","ИмяВФайле");
		Если СтрокаДанных<>Неопределено Тогда
			СтрокаДанных.Представление = "Код гос. услуги";
			
			ДлинаНаНоменклатуру = 10;
			НачПозиция = Метаданные.Справочники.Номенклатура.ДлинаКода - ДлинаНаНоменклатуру + 1;
			ВыборкаДетальныеЗаписи = ПолучитьНоменклатуруПоКоду(СтрокаДанных.Значение, ДлинаНаНоменклатуру,Платеж.Дата, НачПозиция);
			
			//ВыборкаДетальныеЗаписи = Результат.Выбрать();
			
			Если ВыборкаДетальныеЗаписи.Следующий() Тогда
				Платеж.Номенклатура = ВыборкаДетальныеЗаписи.Номенклатура;
			
				Если ТипЗнч(ВыборкаДетальныеЗаписи.ЗначениеНастройки) = Тип("ХранилищеЗначения") Тогда
					ПолученноеЗначение = ВыборкаДетальныеЗаписи.ЗначениеНастройки.Получить();
					Если ТипЗнч(ПолученноеЗначение) = Тип("Структура") Тогда
						ТаблицаИдн = ПолученноеЗначение.ТаблицаИдентификаторов;
						ДеревоСтруктуры = ПолученноеЗначение.ДополнительныеХарактеристикиНоменклатуры;
						
						ЗаполнятьПлательщика = НЕ ЗначениеЗаполнено(Платеж.Плательщик);
						ЗаполнятьУчащегося = НЕ ЗначениеЗаполнено(Платеж.Учащийся);
						ЗаполнятьДоговор = Не ЗначениеЗаполнено(Платеж.Договор);
						
						//Если нам нужно что-нибудь заполнять, то попробуем это "что-нибудь" заполнить
						Если ЗаполнятьПлательщика ИЛИ ЗаполнятьУчащегося ИЛИ ЗаполнятьДоговор Тогда
							// тут надо добавить колонку - приоритета идентификаторов.
							// 1- единый
							// 2- альтернативный
							// 3- доп.альтернативный
							// 4- по реквизитам (а так же доп. реквизитам и сведениям) плательщика
							// 5-8 - на всякий случай...
							// 9- по ребенку, договору, студенту.
							// а так же привести колонку ИмяПоля к верхнему регистру
							
							ТаблицаИдн.Колонки.Добавить("Приоритет");
							Для Каждого СтрТч Из ТаблицаИдн Цикл
								Если СтрТч.ТипПоля = "ЕдиныйИдентификатор" Тогда
									СтрТч.Приоритет = 1;
								ИначеЕсли СтрТч.ТипПоля = "АльтернативныйИдентификатор" Тогда
									СтрТч.Приоритет = 2;
								ИначеЕсли СтрТч.ТипПоля = "ДопАльтИдентификатор" Тогда
									СтрТч.Приоритет = 3;
								ИначеЕсли СтрТч.ТипПоля = "СправочникСсылка.Контрагенты" Тогда
									СтрТч.Приоритет = 4;
								ИначеЕсли СтрТч.ТипПоля = "СправочникСсылка.Договоры" 
									ИЛИ СтрТч.ТипПоля = "СправочникСсылка.Дети" 
									ИЛИ СтрТч.ТипПоля = "СправочникСсылка.Студенты" Тогда
									СтрТч.Приоритет = 9;
								КонецЕсли;
								СтрТч.ИмяПоля = ВРег(СтрТч.ИмяПоля);
							КонецЦикла;
							ТаблицаИдн.Сортировать("Приоритет Возр");
							
							УжеИскалиФизЛицоПоИдентификатору = Ложь; //Т.к. процедура поиска по единому и альтернативному идентификатору в данный момент одна,
																	 //то и выполняем ее один раз.
							
							Для Каждого СтрокаТЧ Из ТаблицаИдн Цикл
									
								Если СтрокаТЧ.ТипПоля = "СправочникСсылка.Договоры"
									ИЛИ СтрокаТЧ.ТипПоля = "СправочникСсылка.Дети"
									ИЛИ СтрокаТЧ.ТипПоля = "СправочникСсылка.Студенты"
									ИЛИ СтрокаТЧ.ТипПоля = "СправочникСсылка.Контрагенты" Тогда	
									
									СтрокаДопДанных = Платеж.ДополнительныеДанные.Найти(СтрокаТЧ.ИмяПоля,"ИмяВФайле");
									Если СтрокаДопДанных = Неопределено Тогда 
										Продолжить;
									КонецЕсли;
									
									СтрокаДопДанных.Представление = СтрокаТЧ.Представление;
																	
									ИмяСпр = Сред(СтрокаТЧ.ТипПоля,18);
									
									ИмяРек = СтрокаТЧ.РеквизитИдентификатор;
									Попытка
										Если СтрокаТЧ.ТипПоля = "СправочникСсылка.Контрагенты" И ЗаполнятьПлательщика Тогда
											
											Выборка = ПолучитьВыборкуПоРеквизитуСправочника(ИмяСпр,ИмяРек,СтрокаДопДанных.Значение,Платеж.Организация,Платеж.Дата);
											
											Если Выборка.Следующий() Тогда
												
												Платеж.Плательщик = Выборка.Ссылка;
																
											КонецЕсли;
										ИначеЕсли СтрокаТЧ.ТипПоля = "СправочникСсылка.Договоры" И (ЗаполнятьПлательщика ИЛИ ЗаполнятьДоговор) Тогда
											
											Выборка = ПолучитьВыборкуПоРеквизитуСправочника(ИмяСпр,ИмяРек,СтрокаДопДанных.Значение,Платеж.Организация,Платеж.Дата);
											
											Если Выборка.Следующий() Тогда
												Если ЗаполнятьПлательщика Тогда
													Платеж.Плательщик = Выборка.Плательщик;
												КонецЕсли;
												Если ЗаполнятьДоговор Тогда
													Платеж.Договор = Выборка.Ссылка;
													ЗаполнятьДоговор = НЕ ЗначениеЗаполнено(Платеж.Договор);
												КонецЕсли;
				
											КонецЕсли;
										ИначеЕсли (СтрокаТЧ.ТипПоля = "СправочникСсылка.Дети"
											ИЛИ СтрокаТЧ.ТипПоля = "СправочникСсылка.Студенты") И (ЗаполнятьПлательщика ИЛИ ЗаполнятьУчащегося) Тогда
											
											Выборка = ПолучитьВыборкуПоРеквизитуСправочника(ИмяСпр,ИмяРек,СтрокаДопДанных.Значение,Платеж.Организация,Платеж.Дата);
											
											Если Выборка.Следующий() Тогда
												
												Если ЗаполнятьПлательщика Тогда
													Платеж.Плательщик = Выборка.Плательщик;
												КонецЕсли;
												
												Если ЗаполнятьУчащегося Тогда
													Платеж.Учащийся = Выборка.Ссылка;
													ЗаполнятьДоговор = НЕ ЗначениеЗаполнено(Платеж.Учащийся);
												КонецЕсли;
				
											КонецЕсли;
										КонецЕсли;
									Исключение
										
									КонецПопытки;
								ИначеЕсли ЗаполнятьПлательщика И НЕ УжеИскалиФизЛицоПоИдентификатору
									И (СтрокаТЧ.ТипПоля = "ЕдиныйИдентификатор" 
									ИЛИ СтрокаТЧ.ТипПоля = "АльтернативныйИдентификатор"
									ИЛИ СтрокаТЧ.ТипПоля = "ЕдиныйИдентификаторУчащегося"
									ИЛИ СтрокаТЧ.ТипПоля = "АльтернативныйИдентификаторУчащегося") Тогда
									
									ВидИдентификатора = Справочники.ВидыАльтернативныхИдентификаторовПолучателейГосуслуг.ПустаяСсылка();
									Если Найти(СтрокаТЧ.ТипПоля, "АльтернативныйИдентификатор")>0  Тогда
										ВидИдентификатора = СтрокаТЧ.РеквизитИдентификатор;	
									КонецЕсли;
									
	                                Платеж.Плательщик = НайтиФизЛицоПоИдентификатору(Платеж.ИдентификаторПлательщика,Платеж.Дата,ВидИдентификатора);
									УжеИскалиФизЛицоПоИдентификатору = Истина;
									
								ИначеЕсли ЗаполнятьПлательщика 
									И Найти(СтрокаТЧ.ТипПоля, "ДопАльтИдентификатор")>0 Тогда
									
									СтрокаДопДанных = Платеж.ДополнительныеДанные.Найти(СтрокаТЧ.ИмяПоля,"ИмяВФайле");
									Если СтрокаДопДанных = Неопределено Тогда 
										Продолжить;
									КонецЕсли;
									СтрокаДопДанных.Представление = СтрокаТЧ.Представление;
									
									Платеж.Плательщик = НайтиФизЛицоПоИдентификатору(СтрокаДопДанных.Значение,Платеж.Дата,СтрокаТЧ.РеквизитИдентификатор);

								КонецЕсли;
								
								ЗаполнятьПлательщика = НЕ ЗначениеЗаполнено(Платеж.Плательщик);

								//Если НЕ ЗаполнятьПлательщика И НЕ ЗаполнятьДоговор И НЕ ЗаполнятьУчащегося Тогда
								//	Прервать;
								//КонецЕсли;
							КонецЦикла;
							
						КонецЕсли;
						
						//Устанавливаем, нужно ли заполнение представлений
						НужноЗаполнитьПредстваления = Платеж.ДополнительныеДанные.НайтиСтроки(Новый Структура("Представление","")).Количество()>0;
											
						// Замена имени поля из Дополнительных данных на указанное наименнование
						//
						Если НужноЗаполнитьПредстваления 
							И ЗначениеЗаполнено(Платеж.Номенклатура) 
							И ДеревоСтруктуры<>Неопределено Тогда
							//Простые параметры
							Отбор = Новый Структура("ИмяВФайле","DescriptionSimpleParameter");
							СтрокиПростыхПараметров = ДеревоСтруктуры.Строки.НайтиСтроки(Отбор,Истина);
							Для Каждого СтрокаПростПар Из СтрокиПростыхПараметров Цикл
								Если СтрокаПростПар.ПолеОтключеноРодителем Тогда 
									Продолжить;
								КонецЕсли;
								ОтборПредставление = Новый Структура("ИмяВФайле","@label");
								СтрокаИмени = СтрокаПростПар.Строки.Найти("@name","ИмяВФайле",Ложь);
								СтрокаПредставления = СтрокаПростПар.Строки.Найти("@label","ИмяВФайле",Ложь);
								Если СтрокаИмени <> Неопределено И СтрокаПредставления <> Неопределено Тогда
									
									СтрокиДанных = Платеж.ДополнительныеДанные.НайтиСтроки(Новый Структура("ИмяВФайле,Представление",ВРег(СокрЛП(СтрокаИмени.ЗначениеПоля)),""));
									
									Если СтрокиДанных.Количество() = 0 Тогда 
										Продолжить;
									КонецЕсли;

									Для Каждого СтрТЧ Из СтрокиДанных Цикл
										СтрТЧ.Представление = СтрокаПредставления.ЗначениеПоля;	
									КонецЦикла;	
									Если Платеж.ДополнительныеДанные.НайтиСтроки(Новый Структура("Представление","")).Количество()=0 Тогда
										Прервать;
									КонецЕсли;
								КонецЕсли;
							КонецЦикла;
							//Комплексные параметры
							Отбор = Новый Структура("ИмяВФайле","DescriptionComplexParameter");
							СтрокиПростыхПараметров = ДеревоСтруктуры.Строки.НайтиСтроки(Отбор,Истина);
							Для Каждого СтрокаКомплПар Из СтрокиПростыхПараметров Цикл
								Если СтрокаКомплПар.ПолеОтключеноРодителем Тогда 
									Продолжить;
								КонецЕсли;
								ОтборПоля = Новый Структура("ИмяВФайле","Field");
								МассивСтрок = СтрокаКомплПар.Строки.НайтиСтроки(ОтборПоля);
								Для Каждого СтрокаПоля Из МассивСтрок Цикл
									СтрокаИмени = СтрокаПоля.Строки.Найти("@name","ИмяВФайле",Ложь);
									СтрокаПредставления = СтрокаПоля.Строки.Найти("@label","ИмяВФайле",Ложь);
									Если СтрокаИмени <> Неопределено И СтрокаПредставления <> Неопределено Тогда
										
										СтрокиДанных = Платеж.ДополнительныеДанные.НайтиСтроки(Новый Структура("ИмяВФайле,Представление",ВРег(СокрЛП(СтрокаИмени.ЗначениеПоля)),""));
									
										Если СтрокиДанных.Количество() = 0 Тогда 
											Продолжить;
										КонецЕсли;

										Для Каждого СтрТЧ Из СтрокиДанных Цикл
											СтрТЧ.Представление = СтрокаПредставления.ЗначениеПоля;	
										КонецЦикла;	
										Если Платеж.ДополнительныеДанные.НайтиСтроки(Новый Структура("Представление","")).Количество()=0 Тогда
											Прервать;
										КонецЕсли;
										
									КонецЕсли;
								КонецЦикла;
								Если Платеж.ДополнительныеДанные.НайтиСтроки(Новый Структура("Представление","")).Количество()=0 Тогда
									Прервать;
								КонецЕсли;
							КонецЦикла;
						КонецЕсли;
				
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
    	КонецЕсли;
	КонецЕсли;
	
	// Если есть доп. данные, для которых не нашли представление, заполним так, как они называются в файле.
	Для Каждого СтрТЧ Из Платеж.ДополнительныеДанные Цикл		
		Если НЕ ЗначениеЗаполнено(СтрТЧ.Представление) Тогда
			СтрТЧ.Представление = СтрТЧ.ИмяВФайле;
		КонецЕсли;
	КонецЦикла;
					
КонецПроцедуры

Функция ПолучитьНоменклатуруПоКоду(Знач КодНоменклатуры,Знач ДлинаНаНоменклатуру,Знач Дата, Знач НачПозиция) 
	Запрос = Новый Запрос;
	Если ДлинаНаНоменклатуру = 10 Тогда
		Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	ВложенныйЗапрос.Ссылка КАК Ссылка,
			|	ВложенныйЗапрос.КодПоиска
			|ПОМЕСТИТЬ ВремНоменклатура
			|ИЗ
			|	(ВЫБРАТЬ
			|		Номенклатура.Ссылка КАК Ссылка,
			|		ВЫБОР
			|			КОГДА (ВЫРАЗИТЬ(ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 10) КАК СТРОКА(10))) = (ВЫРАЗИТЬ(ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 0) КАК СТРОКА(10)))
			|				ТОГДА ""0000000000""
			|			КОГДА (ВЫРАЗИТЬ(ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 10) КАК СТРОКА(10))) = (ВЫРАЗИТЬ(ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 1) КАК СТРОКА(10)))
			|				ТОГДА ""000000000"" + ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 1)
			|			КОГДА (ВЫРАЗИТЬ(ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 10) КАК СТРОКА(10))) = (ВЫРАЗИТЬ(ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 2) КАК СТРОКА(10)))
			|				ТОГДА ""00000000"" + ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 2)
			|			КОГДА (ВЫРАЗИТЬ(ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 10) КАК СТРОКА(10))) = (ВЫРАЗИТЬ(ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 3) КАК СТРОКА(10)))
			|				ТОГДА ""0000000"" + ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 3)
			|			КОГДА (ВЫРАЗИТЬ(ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 10) КАК СТРОКА(10))) = (ВЫРАЗИТЬ(ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 4) КАК СТРОКА(10)))
			|				ТОГДА ""000000"" + ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 4)
			|			КОГДА (ВЫРАЗИТЬ(ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 10) КАК СТРОКА(10))) = (ВЫРАЗИТЬ(ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 5) КАК СТРОКА(10)))
			|				ТОГДА ""00000"" + ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 5)
			|			КОГДА (ВЫРАЗИТЬ(ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 10) КАК СТРОКА(10))) = (ВЫРАЗИТЬ(ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 6) КАК СТРОКА(10)))
			|				ТОГДА ""0000"" + ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 6)
			|			КОГДА (ВЫРАЗИТЬ(ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 10) КАК СТРОКА(10))) = (ВЫРАЗИТЬ(ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 7) КАК СТРОКА(10)))
			|				ТОГДА ""000"" + ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 7)
			|			КОГДА (ВЫРАЗИТЬ(ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 10) КАК СТРОКА(10))) = (ВЫРАЗИТЬ(ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 8) КАК СТРОКА(10)))
			|				ТОГДА ""00"" + ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 8)
			|			КОГДА (ВЫРАЗИТЬ(ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 10) КАК СТРОКА(10))) = (ВЫРАЗИТЬ(ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 9) КАК СТРОКА(10)))
			|				ТОГДА ""0"" + ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 9)
			|			ИНАЧЕ ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 10)
			|		КОНЕЦ КАК КодПоиска
			|	ИЗ
			|		Справочник.Номенклатура КАК Номенклатура
			|	ГДЕ
			|		Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Госуслуга)) КАК ВложенныйЗапрос
			|ГДЕ
			|	ВложенныйЗапрос.КодПоиска = &Код
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВремНоменклатура.Ссылка КАК Номенклатура,
			|	ХарактеристикиГосуслугСрезПоследних.ЗначениеНастройки
			|ИЗ
			|	ВремНоменклатура КАК ВремНоменклатура
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ХарактеристикиГосуслуг.СрезПоследних(&Дата, ) КАК ХарактеристикиГосуслугСрезПоследних
			|		ПО ВремНоменклатура.Ссылка = ХарактеристикиГосуслугСрезПоследних.Номенклатура";

	Иначе
		Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	ВложенныйЗапрос.Ссылка КАК Ссылка,
			|	ВложенныйЗапрос.КодПоиска
			|ПОМЕСТИТЬ ВремНоменклатура
			|ИЗ
			|	(ВЫБРАТЬ
			|		Номенклатура.Ссылка КАК Ссылка,
			|		ВЫБОР
			|			КОГДА (ВЫРАЗИТЬ(ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 9) КАК СТРОКА(9))) = (ВЫРАЗИТЬ(ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 0) КАК СТРОКА(9)))
			|				ТОГДА ""000000000""
			|			КОГДА (ВЫРАЗИТЬ(ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 9) КАК СТРОКА(9))) = (ВЫРАЗИТЬ(ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 1) КАК СТРОКА(9)))
			|				ТОГДА ""00000000"" + ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 1)
			|			КОГДА (ВЫРАЗИТЬ(ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 9) КАК СТРОКА(9))) = (ВЫРАЗИТЬ(ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 2) КАК СТРОКА(9)))
			|				ТОГДА ""0000000"" + ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 2)
			|			КОГДА (ВЫРАЗИТЬ(ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 9) КАК СТРОКА(9))) = (ВЫРАЗИТЬ(ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 3) КАК СТРОКА(9)))
			|				ТОГДА ""000000"" + ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 3)
			|			КОГДА (ВЫРАЗИТЬ(ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 9) КАК СТРОКА(9))) = (ВЫРАЗИТЬ(ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 4) КАК СТРОКА(9)))
			|				ТОГДА ""00000"" + ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 4)
			|			КОГДА (ВЫРАЗИТЬ(ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 9) КАК СТРОКА(9))) = (ВЫРАЗИТЬ(ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 5) КАК СТРОКА(9)))
			|				ТОГДА ""0000"" + ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 5)
			|			КОГДА (ВЫРАЗИТЬ(ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 9) КАК СТРОКА(9))) = (ВЫРАЗИТЬ(ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 6) КАК СТРОКА(9)))
			|				ТОГДА ""000"" + ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 6)
			|			КОГДА (ВЫРАЗИТЬ(ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 9) КАК СТРОКА(9))) = (ВЫРАЗИТЬ(ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 7) КАК СТРОКА(9)))
			|				ТОГДА ""00"" + ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 7)
			|			КОГДА (ВЫРАЗИТЬ(ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 9) КАК СТРОКА(9))) = (ВЫРАЗИТЬ(ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 8) КАК СТРОКА(9)))
			|				ТОГДА ""0"" + ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 8)
			|			ИНАЧЕ ПОДСТРОКА(Номенклатура.Код, &НачПозиция, 9)
			|		КОНЕЦ КАК КодПоиска
			|	ИЗ
			|		Справочник.Номенклатура КАК Номенклатура
			|	ГДЕ
			|		Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Госуслуга)) КАК ВложенныйЗапрос
			|ГДЕ
			|	ВложенныйЗапрос.КодПоиска = &Код
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ВремНоменклатура.Ссылка КАК Номенклатура,
			|	ХарактеристикиГосуслугСрезПоследних.ЗначениеНастройки
			|ИЗ
			|	ВремНоменклатура КАК ВремНоменклатура
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ХарактеристикиГосуслуг.СрезПоследних(&Дата, ) КАК ХарактеристикиГосуслугСрезПоследних
			|		ПО ВремНоменклатура.Ссылка = ХарактеристикиГосуслугСрезПоследних.Номенклатура";

	КонецЕсли;
	Запрос.УстановитьПараметр("Код", Сред(КодНоменклатуры,21 - ДлинаНаНоменклатуру));
	Запрос.УстановитьПараметр("НачПозиция", НачПозиция);
    Запрос.УстановитьПараметр("Дата", Дата);
	
	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();
	Если ВыборкаДетальныеЗаписи.Количество() = 0 И ДлинаНаНоменклатуру = 10 Тогда
		Возврат ПолучитьНоменклатуруПоКоду(КодНоменклатуры,ДлинаНаНоменклатуру-1,Дата, НачПозиция+1);
	Иначе
		Возврат ВыборкаДетальныеЗаписи;
	КонецЕсли;
КонецФункции

Процедура ЗаполнитьНоменклатуруИПлательщикаПлатежаПодведомственного(Платеж) Экспорт
	
	Платеж.Получатель = БиблиотекаФункцийОбмена.ОпределитьКонтрагентаАН(Платеж.ИННПолучателя,Платеж.КПППолучателя);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НачислениеОтПодведомственного.Ссылка,
		|	НачислениеОтПодведомственного.ПлательщикНаименование,
		|	НачислениеОтПодведомственного.КодБКПлатежа,
		|	НачислениеОтПодведомственного.КодОКАТО,
		|	2 КАК ПорядокСортировки,
		|	НачислениеОтПодведомственного.НаименованиеУслуги
		|ИЗ
		|	Документ.НачислениеОтПодведомственного КАК НачислениеОтПодведомственного
		|ГДЕ
		|	НачислениеОтПодведомственного.УникальныйИдентификаторНачисления = &УникальныйИдентификаторНачисления
		|	И ПОДСТРОКА(НачислениеОтПодведомственного.УникальныйИдентификаторНачисления, 2, 1) <> """"
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СоответствиеНачисленийИПлатежей.Начисление,
		|	СоответствиеНачисленийИПлатежей.Начисление.ПлательщикНаименование,
		|	СоответствиеНачисленийИПлатежей.Начисление.КодБКПлатежа,
		|	СоответствиеНачисленийИПлатежей.Начисление.КодОКАТО,
		|	1,
		|	СоответствиеНачисленийИПлатежей.Начисление.НаименованиеУслуги
		|ИЗ
		|	РегистрСведений.СоответствиеНачисленийИПлатежей КАК СоответствиеНачисленийИПлатежей
		|ГДЕ
		|	СоответствиеНачисленийИПлатежей.Платеж = &Платеж
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПорядокСортировки";

	Запрос.УстановитьПараметр("УникальныйИдентификаторНачисления", Платеж.УникальныйИдентификаторНачисления);
	Запрос.УстановитьПараметр("Платеж", Платеж.Ссылка);
	
	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();

	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Платеж.ПлательщикНаименование = ВыборкаДетальныеЗаписи.ПлательщикНаименование;
		Если Не ЗначениеЗаполнено(Платеж.КодБКПлатежа) Тогда
			Платеж.КодБКПлатежа = ВыборкаДетальныеЗаписи.КодБКПлатежа;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Платеж.КодОКАТО) Тогда
			Платеж.КодОКАТО = ВыборкаДетальныеЗаписи.КодОКАТО;
		КонецЕсли;
		Платеж.НаименованиеУслуги = ВыборкаДетальныеЗаписи.НаименованиеУслуги;
	КонецЕсли;
	
	// Если есть доп. данные, для которых не нашли представление, заполним так, как они называются в файле.
	Для Каждого СтрТЧ Из Платеж.ДополнительныеДанные Цикл		
		Если НЕ ЗначениеЗаполнено(СтрТЧ.Представление) Тогда
			СтрТЧ.Представление = СтрТЧ.ИмяВФайле;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция НайтиФизЛицоПоИдентификатору(КодИдентификатора,Дата=Неопределено,ВидАльтернативногоИдентификатора = Неопределено) Экспорт
	
	Если Дата = Неопределено Тогда
		Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Контрагент = Неопределено;
	ДлинаКода = СтрДлина(КодИдентификатора);
	Если ДлинаКода = 12 Тогда
		// КодИдентификатора - это СНИЛС (Единый идентификатор плательщика-физлица по форматам 1.15.0 ИС РНИП)
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	ФизическиеЛица.Ссылка КАК ФизическоеЛицо,
			|	ФизическиеЛица.Наименование КАК НаименованиеФЛ,
			|	ЕСТЬNULL(Контрагенты.Ссылка, НЕОПРЕДЕЛЕНО) КАК Контрагент
			|ИЗ
			|	Справочник.ФизическиеЛица КАК ФизическиеЛица
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
			|		ПО (Контрагенты.ЮридическоеФизическоеЛицо = ФизическиеЛица.Ссылка)
			|ГДЕ
			|	ФизическиеЛица.СтраховойНомерПФР = &СтраховойНомерПФР
			|	И НЕ ФизическиеЛица.ПометкаУдаления";
			
		СНИЛС = "" + Сред(КодИдентификатора,2,3) + "-" + Сред(КодИдентификатора,5,3) + "-" + Сред(КодИдентификатора,8,3) + " " + Сред(КодИдентификатора,11,2);
		Запрос.УстановитьПараметр("СтраховойНомерПФР", СНИЛС);
		Результат = Запрос.Выполнить();

		ВыборкаДетальныеЗаписи = Результат.Выбрать();

		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			Контрагент = ВыборкаДетальныеЗаписи.Контрагент;
			Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
				НовыйКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();
				НовыйКонтрагент.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо;
				НовыйКонтрагент.ЮридическоеФизическоеЛицо = ВыборкаДетальныеЗаписи.ФизическоеЛицо;
				НовыйКонтрагент.Наименование = ВыборкаДетальныеЗаписи.НаименованиеФЛ;
				Попытка
					НовыйКонтрагент.Записать();
					Контрагент = НовыйКонтрагент.Ссылка;
				Исключение
					ОбщегоНазначения.СообщитьПользователю(НСтр("ru='"+ОписаниеОшибки()+"'"));
					Контрагент = Справочники.Контрагенты.ПустаяСсылка();
				КонецПопытки;
			КонецЕсли;
			//НайденноеФизЛицо = ВыборкаДетальныеЗаписи.ФизическоеЛицо;
		КонецЕсли;
		
	ИначеЕсли ДлинаКода = 14 Тогда
		// КодИдентификатора - это единый идентификатор ИП по 1.16
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Контрагенты.Ссылка
			|ИЗ
			|	Справочник.Контрагенты КАК Контрагенты
			|ГДЕ
			|	Контрагенты.ПометкаУдаления = ЛОЖЬ
			|	И Контрагенты.ИНН = &ИНН";
	
        Запрос.УстановитьПараметр("ИНН", Сред(КодИдентификатора,2));
		
		Результат = Запрос.Выполнить();

		ВыборкаДетальныеЗаписи = Результат.Выбрать();

		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			Контрагент = ВыборкаДетальныеЗаписи.Ссылка;
		КонецЕсли;

	ИначеЕсли ДлинаКода = 25 Тогда
		// КодИдентификатора - это Альтернативный уникальный идентификатор плательщика по форматам 1.15.0 ИС РНИП
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	АльтернативныеИдентификаторыПолучателейГосуслуг.ФизическоеЛицо,
		               |	АльтернативныеИдентификаторыПолучателейГосуслуг.АльтернативныйИдентификатор,
		               |	АльтернативныеИдентификаторыПолучателейГосуслуг.ФизическоеЛицо.Наименование КАК НаименованиеФЛ,
		               |	Контрагенты.Ссылка КАК Контрагент
		               |ИЗ
		               |	РегистрСведений.АльтернативныеИдентификаторыПолучателейГосуслуг КАК АльтернативныеИдентификаторыПолучателейГосуслуг
		               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
		               |		ПО АльтернативныеИдентификаторыПолучателейГосуслуг.ФизическоеЛицо = Контрагенты.ЮридическоеФизическоеЛицо
		               |ГДЕ
		               |	АльтернативныеИдентификаторыПолучателейГосуслуг.АльтернативныйИдентификатор = &КодИдентификатора
		               |	И НЕ АльтернативныеИдентификаторыПолучателейГосуслуг.ФизическоеЛицо.ПометкаУдаления
		               |	И ВЫБОР
		               |			КОГДА &ИспользоватьВидАльтИдн
		               |				ТОГДА АльтернативныеИдентификаторыПолучателейГосуслуг.ВидАльтернативногоИдентификатора = &ВидАльтИдн
		               |			ИНАЧЕ ИСТИНА
		               |		КОНЕЦ";
		
		Запрос.УстановитьПараметр("КодИдентификатора", КодИдентификатора);
		Запрос.УстановитьПараметр("ВидАльтИдн",ВидАльтернативногоИдентификатора);
		Запрос.УстановитьПараметр("ИспользоватьВидАльтИдн",ЗначениеЗаполнено(ВидАльтернативногоИдентификатора));
        Запрос.УстановитьПараметр("Дата", Дата);
		
		Результат = Запрос.Выполнить();
	
		ТЗАльтернативный = Результат.Выгрузить();
		Если ТЗАльтернативный.Количество()>0 Тогда
			НайденноеФизЛицо = ТЗАльтернативный[0].ФизическоеЛицо;
			Контрагент = ТЗАльтернативный[0].Контрагент;
			Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
				НовыйКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();
				НовыйКонтрагент.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо;
				НовыйКонтрагент.ЮридическоеФизическоеЛицо = НайденноеФизЛицо;
				НовыйКонтрагент.Наименование = ТЗАльтернативный[0].НаименованиеФЛ;
				Попытка
					НовыйКонтрагент.Записать();
					Контрагент = НовыйКонтрагент.Ссылка;
				Исключение
					ОбщегоНазначения.СообщитьПользователю(НСтр("ru='"+ОписаниеОшибки()+"'"));
					Контрагент = Справочники.Контрагенты.ПустаяСсылка();
				КонецПопытки;
			КонецЕсли;

		КонецЕсли;
	ИначеЕсли ДлинаКода = 20 Тогда
		//Это Юр лицо   "2/3"+ИНН+КПП
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Контрагенты.Ссылка
			|ИЗ
			|	Справочник.Контрагенты КАК Контрагенты
			|ГДЕ
			|	Контрагенты.КПП = &КПП
			|	И Контрагенты.ПометкаУдаления = ЛОЖЬ
			|	И Контрагенты.ИНН = &ИНН";
	
        Запрос.УстановитьПараметр("ИНН", Сред(КодИдентификатора,2,10));
		Запрос.УстановитьПараметр("КПП", Сред(КодИдентификатора,12,9));
		
		Результат = Запрос.Выполнить();

		ВыборкаДетальныеЗаписи = Результат.Выбрать();

		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			Контрагент = ВыборкаДетальныеЗаписи.Ссылка;
		КонецЕсли;

	ИначеЕсли ДлинаКода = 15 Тогда
		//Это Юр лицо, иностранная организация   "2"+КИО+КПП	        NNNNXXXXXC - шаблон ИНН, XXXXX - это КИО
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Контрагенты.Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЮридическиеЛица КАК ЮридическиеЛица
		|		ПО Контрагенты.ЮридическоеФизическоеЛицо = ЮридическиеЛица.Ссылка
		|ГДЕ
		|	ЮридическиеЛица.КПП = &КПП
		|	И Контрагенты.ПометкаУдаления = ЛОЖЬ
		|	И ЮридическиеЛица.ПометкаУдаления = ЛОЖЬ
		|	И НЕ(ЮридическиеЛица.СтранаРегистрации = ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия)
		|				ИЛИ ЮридическиеЛица.СтранаРегистрации = ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка))
		|	И ПОДСТРОКА(ЮридическиеЛица.ИНН, 5, 5) = &КИО";
	
        Запрос.УстановитьПараметр("КИО", Сред(КодИдентификатора,2,5));
		Запрос.УстановитьПараметр("КПП", Сред(КодИдентификатора,7,9));
		
		Результат = Запрос.Выполнить();

		ВыборкаДетальныеЗаписи = Результат.Выбрать();

		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			Контрагент = ВыборкаДетальныеЗаписи.Ссылка;
		КонецЕсли;

	КонецЕсли;
	
	Если Контрагент = Неопределено Тогда // не нашли
		Контрагент = Справочники.Контрагенты.ПустаяСсылка(); 
	КонецЕсли;
	
	Возврат Контрагент;
	
КонецФункции

Процедура УстановитьВСоответствиеНачисление(Платеж) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СоответствиеНачисленийИПлатежей.Начисление
		|ИЗ
		|	РегистрСведений.СоответствиеНачисленийИПлатежей КАК СоответствиеНачисленийИПлатежей
		|ГДЕ
		|	СоответствиеНачисленийИПлатежей.Платеж = &Платеж
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КвитанцияНаОплатуГосуслуг.Ссылка КАК Ссылка,
		|   ПлатежВОплатуГосуслуг.БанковскийИдентификаторПлатежа КАК БанковскийИдентификаторПлатежа
		|ИЗ
		|	Документ.ПлатежВОплатуГосуслуг КАК ПлатежВОплатуГосуслуг
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КвитанцияНаОплатуГосуслуг КАК КвитанцияНаОплатуГосуслуг
		|		ПО ПлатежВОплатуГосуслуг.УникальныйИдентификаторНачисления = КвитанцияНаОплатуГосуслуг.УникальныйИдентификаторНачисления
		|			И (ПОДСТРОКА(ПлатежВОплатуГосуслуг.УникальныйИдентификаторНачисления, 2, 1) <> "" "")
		|			И ПлатежВОплатуГосуслуг.Организация = КвитанцияНаОплатуГосуслуг.Организация
		|ГДЕ
		|	КвитанцияНаОплатуГосуслуг.ПометкаУдаления = ЛОЖЬ
		|	И ПлатежВОплатуГосуслуг.Ссылка = &Платеж
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НачислениеОтПодведомственного.Ссылка КАК Ссылка,
		|   ПлатежПодведомственному.БанковскийИдентификаторПлатежа КАК БанковскийИдентификаторПлатежа
		|ИЗ
		|	Документ.ПлатежПодведомственному КАК ПлатежПодведомственному
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.НачислениеОтПодведомственного КАК НачислениеОтПодведомственного
		|		ПО ПлатежПодведомственному.УникальныйИдентификаторНачисления = НачислениеОтПодведомственного.УникальныйИдентификаторНачисления
		|			И (ПОДСТРОКА(ПлатежПодведомственному.УникальныйИдентификаторНачисления, 2, 1) <> "" "")
		|			И ПлатежПодведомственному.Организация = НачислениеОтПодведомственного.Организация
		|			И ПлатежПодведомственному.Получатель = НачислениеОтПодведомственного.Получатель
		|ГДЕ
		|	НачислениеОтПодведомственного.ПометкаУдаления = ЛОЖЬ
		|	И ПлатежПодведомственному.Ссылка = &Платеж";

	Запрос.УстановитьПараметр("Платеж", Платеж);

	Результаты = Запрос.ВыполнитьПакет();

	Если Результаты[0].Пустой() Тогда
		//Начисление не установлено
		Если ТипЗнч(Платеж) = Тип("ДокументСсылка.ПлатежВОплатуГосуслуг") Тогда
			Выборка = Результаты[1].Выбрать();
		Иначе
			Выборка = Результаты[2].Выбрать();
		КонецЕсли;
		
		Если Выборка.Следующий() Тогда
			Запись = РегистрыСведений.СоответствиеНачисленийИПлатежей.СоздатьМенеджерЗаписи();
			Запись.Платеж = Платеж;
			Запись.Начисление = Выборка.Ссылка;
			Запись.БанковскийИдентификаторПлатежаЗаполнен = ЗначениеЗаполнено(Выборка.БанковскийИдентификаторПлатежа);
			Запись.Записать();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Если по квитанции, получены платежи, на сумму равную или превышающие сумму квитанции,
// то квитанции устанавливается статус "Исполнен"
//
Процедура ПроверитьИсполнениеКвитанции(Начисление) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Начисление) Тогда
		Возврат ;
	КонецЕсли;

	СтруктураРезультата = РегистрыСведений.СоответствиеНачисленийИПлатежей.ПолучитьСуммуКоличествоПлатежейПоНачислению(Начисление);

	Если СтруктураРезультата.Сумма >= Начисление.СуммаДокумента Тогда	
		СтруктураРекв = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(Начисление);
		//Изменяем статус начисления на Исполнен только при текущем статусе = НаИсполнении,
		//т.к. прочие статусы: В работе, Подготовлен, Аннулирован и др. означают, что работа с документом не завершена,
		//и он должен быть отправлен в ГИС ГМП.
		//После успешной отправки документа, если платежи получены на полную сумму, ему автоматически будет установлен статус Исполнен.
		Если СтруктураРекв.Статус = Перечисления.СтатусыИсполненияДокумента.НаИсполнении Тогда
			СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",Начисление);
			СтруктураРекв.Вставить("Статус",Перечисления.СтатусыИсполненияДокумента.Исполнен);
			ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры


Функция ПолучитьВыборкуПоРеквизитуСправочника(ИмяСпр,ИмяРек,Код,Организация,Дата=Неопределено)
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Период", Дата);
	Запрос.УстановитьПараметр("Код", Код);
	
	Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ТекСпр.Ссылка 
		|";
		
	ТекстИсточника =	" ИЗ Справочник."+ИмяСпр+" КАК ТекСпр
		|" ;
	
	Если ИмяСпр = "Студенты" Тогда
		Текст = Текст + " ,	ВЫБОР
			|		КОГДА ЕСТЬNULL(РегистрСПлательщиком.Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
			|			ТОГДА ТекСпр.Контрагент
			|		ИНАЧЕ ЕСТЬNULL(РегистрСПлательщиком.Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
			|	КОНЕЦ КАК Плательщик ";
		ТекстИсточника = ТекстИсточника + " ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПлательщикиПоДоговоруОбразование.СрезПоследних(&Период, ) КАК РегистрСПлательщиком
			|		ПО (РегистрСПлательщиком.Студент = ТекСпр.Ссылка) ";
	ИначеЕсли ИмяСпр = "Дети" Тогда
		Текст = Текст + " ,	ВЫБОР
			|		КОГДА ЕСТЬNULL(РегистрСПлательщиком.Плательщик, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
			|			ТОГДА ТекСпр.Контрагент
			|		ИНАЧЕ ЕСТЬNULL(РегистрСПлательщиком.Плательщик, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
			|	КОНЕЦ КАК Плательщик ";
		ТекстИсточника = ТекстИсточника + " ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПлательщикиПоУслугамДДУ.СрезПоследних(&Период, ) КАК РегистрСПлательщиком
			|		ПО (РегистрСПлательщиком.Ребенок = ТекСпр.Ссылка) ";

	ИначеЕсли ИмяСпр = "Договоры" Тогда
		Текст = Текст + " , ТекСпр.Контрагент КАК Плательщик ";
	КонецЕсли;
	Текст = Текст + ТекстИсточника;	
			
	ИмяРеквизита = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ИмяРек, ".");
			
	ОбработкаДопРеквизита = Ложь;
	ОбработкаДопСведений = Ложь;
	ОбработкаХарактеристики = Ложь;
	ОбработкаУчетногоНомера = Ложь;
	Для каждого ТекИмяРеквизита Из ИмяРеквизита Цикл
		Если ТекИмяРеквизита = "ДополнительныеРеквизиты" Тогда
			
			ОбработкаДопРеквизита = Истина;
			
			Продолжить;
			
		ИначеЕсли ОбработкаДопРеквизита Тогда
			
			ИмяДопРеквизита = Сред(ТекИмяРеквизита,2,СтрДлина(ТекИмяРеквизита)-2);
			
			Попытка
				Свойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения[ИмяДопРеквизита];
			Исключение
				Свойство = Неопределено;
			КонецПопытки;
			
			Текст = Текст + " ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник."+ИмяСпр+".ДополнительныеРеквизиты КАК ДопРеквизиты 
							|	ПО ТекСпр.Ссылка = ДопРеквизиты.Ссылка И 
							| 	ВЫБОР КОГДА &ПоНаименованию
							|				ТОГДА ДопРеквизиты.Свойство.Наименование = &Наименование
							|			ИНАЧЕ ДопРеквизиты.Свойство = &Свойство
							|		КОНЕЦ
							|	И ВЫБОР
							|	КОГДА ДопРеквизиты.Значение ССЫЛКА Справочник.ЗначенияСвойствОбъектов
							|		ТОГДА ВЫРАЗИТЬ(ДопРеквизиты.Значение КАК Справочник.ЗначенияСвойствОбъектов).Наименование = &Код
							|	КОГДА ДопРеквизиты.Значение ССЫЛКА Справочник.ЗначенияСвойствОбъектовИерархия
							|		ТОГДА ВЫРАЗИТЬ(ДопРеквизиты.Значение КАК Справочник.ЗначенияСвойствОбъектовИерархия).Наименование = &Код
							|	КОГДА ТИПЗНАЧЕНИЯ(ДопРеквизиты.Значение) = ТИП(Строка)
							|		ТОГДА ДопРеквизиты.Значение = &Код
							|	ИНАЧЕ Ложь
							|	КОНЕЦ ";
		//|	ДопРеквизиты.Значение = &Код";
			Запрос.УстановитьПараметр("Наименование", ИмяДопРеквизита);
			Запрос.УстановитьПараметр("ПоНаименованию", НЕ ЗначениеЗаполнено(Свойство));
			Запрос.УстановитьПараметр("Свойство", Свойство);								
		ИначеЕсли ТекИмяРеквизита = "ДополнительныеСведения" Тогда
			ОбработкаДопСведений = Истина;
			Продолжить;
			
		ИначеЕсли ОбработкаДопСведений Тогда 
			
			ИмяДопРеквизита = Сред(ТекИмяРеквизита,2,СтрДлина(ТекИмяРеквизита)-2);
			
			Попытка
				Свойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения[ИмяДопРеквизита];
			Исключение
				Свойство = Неопределено;
			КонецПопытки;
			
			Текст = Текст + " ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ДополнительныеСведения КАК ДопСведения 
							|	ПО ТекСпр.Ссылка = ДопСведения.Объект И 
							| 	ВЫБОР КОГДА &ПоНаименованию
							|				ТОГДА ДопСведения.Свойство.Наименование = &Наименование
							|			ИНАЧЕ ДопСведения.Свойство = &Свойство
							|		КОНЕЦ
							|	И ВЫБОР
							|	КОГДА ДопСведения.Значение ССЫЛКА Справочник.ЗначенияСвойствОбъектов
							|		ТОГДА ВЫРАЗИТЬ(ДопСведения.Значение КАК Справочник.ЗначенияСвойствОбъектов).Наименование = &Код
							|	КОГДА ДопСведения.Значение ССЫЛКА Справочник.ЗначенияСвойствОбъектовИерархия
							|		ТОГДА ВЫРАЗИТЬ(ДопСведения.Значение КАК Справочник.ЗначенияСвойствОбъектовИерархия).Наименование = &Код
							|	КОГДА ТИПЗНАЧЕНИЯ(ДопСведения.Значение) = ТИП(Строка)
							|		ТОГДА ДопСведения.Значение = &Код
							|	ИНАЧЕ Ложь
							|	КОНЕЦ ";
							//|	И ДопСведения.Значение = &Код";
			Запрос.УстановитьПараметр("Наименование", ИмяДопРеквизита);
			Запрос.УстановитьПараметр("ПоНаименованию", НЕ ЗначениеЗаполнено(Свойство));
			Запрос.УстановитьПараметр("Свойство", Свойство);				
		ИначеЕсли ТекИмяРеквизита =  "ХарактеристикиОбязательства" Тогда
			ОбработкаХарактеристики = Истина;
			Продолжить;
			
		ИначеЕсли ОбработкаХарактеристики Тогда
							
			ИмяДопРеквизита = Сред(ТекИмяРеквизита,2,СтрДлина(ТекИмяРеквизита)-2);
			
			Попытка
				Свойство = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства[ИмяДопРеквизита];
			Исключение
				Свойство = Неопределено;
			КонецПопытки;
			
			Текст = Текст + " ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ХарактеристикиОбязательств.СрезПоследних(&Период,) КАК ХарактеристикиОбязательств 
							|	ПО ТекСпр.Ссылка = ХарактеристикиОбязательств.Договор И 
							| 	ВЫБОР КОГДА &ПоНаименованию
							|				ТОГДА ХарактеристикиОбязательств.ВидХарактеристики.Наименование = &Наименование
							|			ИНАЧЕ ХарактеристикиОбязательств.ВидХарактеристики = &Свойство
							|		КОНЕЦ
							|	И ХарактеристикиОбязательств.ЗначениеХарактеристики = &Код";
			Запрос.УстановитьПараметр("Наименование", ИмяДопРеквизита);
			Запрос.УстановитьПараметр("ПоНаименованию", НЕ ЗначениеЗаполнено(Свойство));
			Запрос.УстановитьПараметр("Свойство", Свойство);				
		ИначеЕсли ТекИмяРеквизита = "[УчетныйНомерОбязательства]" Тогда
			ОбработкаУчетногоНомера = Истина;
			
			Текст = Текст + " ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.УчетныеНомераОбязательств КАК УчетныеНомераОбязательств 
							|	ПО ТекСпр.Ссылка = УчетныеНомераОбязательств.Обязательство И УчетныеНомераОбязательств.УчетныйНомерОбязательства = &Код";
		Иначе
			//Ничего не делаем
		КонецЕсли;
		
	КонецЦикла;	
	Если ИмяСпр <> "Контрагенты" Тогда
		Если НЕ ОбработкаДопРеквизита И НЕ ОбработкаДопСведений И НЕ ОбработкаХарактеристики И НЕ ОбработкаУчетногоНомера Тогда
			Текст = Текст + " ГДЕ ТекСпр."+ИмяРек +" = &Код И ТекСпр.Организация = &Организация";
		Иначе
			Текст = Текст + " ГДЕ ТекСпр.Организация = &Организация";
		КонецЕсли;
		Запрос.УстановитьПараметр("Организация",Организация);
	Иначе
		Если НЕ ОбработкаДопРеквизита И НЕ ОбработкаДопСведений И НЕ ОбработкаХарактеристики И НЕ ОбработкаУчетногоНомера Тогда
			Текст = Текст + " ГДЕ ТекСпр."+ИмяРек +" = &Код";
		КонецЕсли;
	КонецЕсли;
	
	Запрос.Текст = Текст;
	
	Результат = Запрос.Выполнить();
	
    Выборка = Результат.Выбрать();
	Возврат Выборка;
КонецФункции

/////////////////////////////////////////////////////////////////////////
// Формирование таблицы для экспорта каталога услуг

// Функция возвращает таблицу значений, используемую в форматах обмена с ИС РНИП.
// Параметры:
//	- ДокументСсылка - ссылка на документ "КаталогГосУслуг", либо массив ссылок;
//	- ЗаданиеСсылка - ссылка на документ "ЗаданиеНаЭкспорт".
//
Функция ПолучитьПереченьГосУслугДляЭкспорта(ДокументСсылка,ЗаданиеСсылка)Экспорт
	
	МассивСсылок = Новый Массив;
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.КаталогГосУслуг") Тогда
		МассивСсылок.Добавить(ДокументСсылка);
	Иначе
		МассивСсылок = ДокументСсылка;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	//Запрос.УстановитьПараметр("Ссылка",ДокументСсылка);
	Запрос.УстановитьПараметр("Организация",ЗаданиеСсылка.Организация);
	//Запрос.УстановитьПараметр("ДатаДокумента",ДокументСсылка.Дата);
	Запрос.УстановитьПараметр("МассивСсылок",МассивСсылок);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	КаталогГосУслугГосУслуги.Номенклатура,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА КаталогГосУслугГосУслуги.ЛицевойСчет = ЗНАЧЕНИЕ(Справочник.ЛицевыеСчета.ПустаяСсылка)
		|				ТОГДА КаталогГосУслугГосУслуги.Ссылка.ЛицевойСчет
		|			ИНАЧЕ КаталогГосУслугГосУслуги.ЛицевойСчет
		|		КОНЕЦ) КАК ЛицевойСчет,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА КаталогГосУслугГосУслуги.ЛицевойСчет = ЗНАЧЕНИЕ(Справочник.ЛицевыеСчета.ПустаяСсылка)
		|				ТОГДА КаталогГосУслугГосУслуги.Ссылка.РеквизитыЛицевогоСчета
		|			ИНАЧЕ КаталогГосУслугГосУслуги.РеквизитыЛицевогоСчета
		|		КОНЕЦ) КАК РеквизитЛС,
		|	КаталогГосУслугГосУслуги.Дата,
		|	КаталогГосУслугГосУслуги.Ссылка
		|ПОМЕСТИТЬ ВремТаб
		|ИЗ
		|	Документ.КаталогГосУслуг.ГосУслуги КАК КаталогГосУслугГосУслуги
		|ГДЕ
		|	КаталогГосУслугГосУслуги.Ссылка В(&МассивСсылок)
		|
		|СГРУППИРОВАТЬ ПО
		|	КаталогГосУслугГосУслуги.Номенклатура,
		|	КаталогГосУслугГосУслуги.Дата,
		|	КаталогГосУслугГосУслуги.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВремТаб.Номенклатура,
		|	МАКСИМУМ(ВремТаб.Дата) КАК Дата,
		|	ВремТаб.Ссылка
		|ПОМЕСТИТЬ ТаблицаДаты
		|ИЗ
		|	ВремТаб КАК ВремТаб
		|
		|СГРУППИРОВАТЬ ПО
		|	ВремТаб.Номенклатура,
		|	ВремТаб.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаДаты.Номенклатура,
		|	ВремТаб.ЛицевойСчет,
		|	ВремТаб.РеквизитЛС,
		|	ТаблицаДаты.Ссылка
		|ПОМЕСТИТЬ ДанныеКаталога
		|ИЗ
		|	ТаблицаДаты КАК ТаблицаДаты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВремТаб КАК ВремТаб
		|		ПО ТаблицаДаты.Номенклатура = ВремТаб.Номенклатура
		|			И ТаблицаДаты.Дата = ВремТаб.Дата
		|			И ТаблицаДаты.Ссылка = ВремТаб.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВложенныйЗапрос.ССЫЛКАДОКУМЕНТА,
		|	ВложенныйЗапрос.Период,
		|	Выразить(""ПЕРЕЧЕНЬГОСУСЛУГ"" КАК СТРОКА(1000)) КАК ИмяТабЧасти,
		|	ВложенныйЗапрос.Активная,
		|	ВложенныйЗапрос.ЛицевойСчет,
		|	ВложенныйЗапрос.РеквизитЛС,
		|	ВложенныйЗапрос.Наименование,
		|	ВложенныйЗапрос.Код,
		|	ВложенныйЗапрос.НаименованиеПолное,
		|	ВложенныйЗапрос.Стоимость,
		|	ВложенныйЗапрос.КПС,
		|	ВложенныйЗапрос.НачалоДействияКПС,
		|	ВложенныйЗапрос.КЭК,
		|	ВложенныйЗапрос.НастройкаХарактеристик,
		|	ВложенныйЗапрос.ЗначениеНастройки,
		|	ВложенныйЗапрос.КодОКАТО,
		|	ВложенныйЗапрос.ОГРН,
		|	ВложенныйЗапрос.ИНН,
		|	ВложенныйЗапрос.КПП,
		|	&Организация Как Организация
		|ИЗ
		|	(";
	НомДок = 1;	
	Для Каждого ЭлМас Из МассивСсылок Цикл	
		БлокДокумента = " ВЫБРАТЬ
			|       &Ссылка КАК ССЫЛКАДОКУМЕНТА,
			|		ХарактеристикиГосуслугСрезПоследних.Период КАК Период,
			|		""true"" КАК Активная,
			|		ДанныеКаталога.ЛицевойСчет КАК ЛицевойСчет,
			|		ДанныеКаталога.РеквизитЛС КАК РеквизитЛС,
			|		ХарактеристикиГосуслугСрезПоследних.Номенклатура.Наименование КАК Наименование,
			|		ХарактеристикиГосуслугСрезПоследних.Номенклатура.Код КАК Код,
			|		ХарактеристикиГосуслугСрезПоследних.Номенклатура.НаименованиеПолное КАК НаименованиеПолное,
			|		ХарактеристикиГосуслугСрезПоследних.Стоимость КАК Стоимость,
			|		ХарактеристикиГосуслугСрезПоследних.КПС КАК КПС,
			|		ХарактеристикиГосуслугСрезПоследних.КПС.ДатаНачалаДействия КАК НачалоДействияКПС,
			|		ХарактеристикиГосуслугСрезПоследних.КЭК КАК КЭК,
			|		ХарактеристикиГосуслугСрезПоследних.НастройкаДополнительныхХарактеристикНоменклатуры КАК НастройкаХарактеристик,
			|		ХарактеристикиГосуслугСрезПоследних.ЗначениеНастройки КАК ЗначениеНастройки,
			|		ХарактеристикиГосуслугСрезПоследних.КодОКАТО КАК КодОКАТО,
			|		Организации.ОГРН КАК ОГРН,
			|		Организации.ИНН КАК ИНН,
			|		Организации.КПП КАК КПП
			|	ИЗ
			|		РегистрСведений.ХарактеристикиГосуслуг.СрезПоследних(
			|				&ДатаДокумента,
			|				Номенклатура В
			|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
			|						ДанныеКаталога.Номенклатура
			|					ИЗ
			|						ДанныеКаталога КАК ДанныеКаталога
			|					ГДЕ
			|						ДанныеКаталога.Ссылка = &Ссылка)) КАК ХарактеристикиГосуслугСрезПоследних
			|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
			|			ПО (Организации.Ссылка = &Организация)
			|			ЛЕВОЕ СОЕДИНЕНИЕ ДанныеКаталога КАК ДанныеКаталога
			|			ПО (ДанныеКаталога.Ссылка = &Ссылка) 
			|				И ХарактеристикиГосуслугСрезПоследних.Номенклатура = ДанныеКаталога.Номенклатура
			|";
		ТекБлокДокумента = БлокДокумента;
		ТекБлокДокумента = СтрЗаменить(ТекБлокДокумента,"&ДатаДокумента","&ДатаДокумента_"+НомДок);
		ТекБлокДокумента = СтрЗаменить(ТекБлокДокумента,"&Ссылка","&Ссылка_"+НомДок);
		Запрос.УстановитьПараметр("ДатаДокумента_"+НомДок,ЭлМас.Дата);
