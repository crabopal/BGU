
#Область СлужебныйПрограммныйИнтерфейс

// Обеспечение сотрудника имуществом.
// 
// Параметры:
//  СотрудникЦМО - СправочникСсылка.Сотрудники, СправочникСсылка.ЦМО -
// 
// Возвращаемое значение:
//  СправочникСсылка.ОбеспечениеСотрудниковИмуществом - Обеспечение сотрудника имуществом
Функция ОбеспечениеСотрудникаИмуществом(Знач СотрудникЦМО) Экспорт
	
	Если Не ЗначениеЗаполнено(СотрудникЦМО) Тогда
		Возврат Справочники.ОбеспечениеСотрудниковИмуществом.ПустаяСсылка();
	КонецЕсли;
	
	Если ТипЗнч(СотрудникЦМО) = Тип("СправочникСсылка.ЦМО") Тогда
		СотрудникЦМО = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СотрудникЦМО, "Сотрудник");
	КонецЕсли;
	
	Возврат УправлениеНФА.ОбеспечениеСотрудникаИмуществом(СотрудникЦМО);
	
КонецФункции

// Возвращает подраздение, к которому относится сотрудник ЦМО
//
// Параметры:
//  - ТекЦМО - СправочникСсылка.ЦМО - ЦМО подразделение сотрудника которого получаем
//  - ТекДата - Дата - Дата, на которую получаем данные
//
// Возвращаемое значение:
// СправочникСсылка.Подразделения - подразделение сотрудника
Функция ПодразделениеСотрудникаЦМО(ТекЦМО, ТекДата) Экспорт
	ДанныеСотрудника = Новый Структура("Подразделение");
	ДанныеСотрудника.Вставить("СсылкаНаОбъект", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекЦМО, "Сотрудник"));
	ДанныеСотрудника.Вставить("Период", ТекДата);
	Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
	
	Возврат ДанныеСотрудника.Подразделение;
КонецФункции	

Функция ЗначенияКПСКФОПоУмолчаниюДляСчета(Знач Организация, Знач ИФО, Знач СчетУчета, Знач ДатаЗначений, Знач КФО = Неопределено) Экспорт
	
	Возврат УправлениеНФА.ЗначенияКПСКФОПоУмолчаниюДляСчета(
	Организация,
	ИФО,
	СчетУчета,
	ДатаЗначений,
	КФО);
	
КонецФункции

#КонецОбласти