		|ПОМЕСТИТЬ ВремТаб
		|ИЗ
		|	РегистрСведений.НастройкаОрганизацийДляГИСГМП_УНП КАК НастройкаОрганизацийДляГИСГМП_УНП
		|ГДЕ
		|	(НастройкаОрганизацийДляГИСГМП_УНП.Организация = &Организация
		|				И НастройкаОрганизацийДляГИСГМП_УНП.Подведомственный = НЕОПРЕДЕЛЕНО
		|			ИЛИ НастройкаОрганизацийДляГИСГМП_УНП.Подведомственный = &Организация)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	НастройкаОрганизацийДляГИСГМП_УНП.ВидОбмена КАК ВидОбмена,
		|	НастройкаОрганизацийДляГИСГМП_УНП.ВерсияФорматов КАК ВерсияФорматов,
		|	НастройкаОрганизацийДляГИСГМП_УНП.УРН КАК УРН,
		|	НастройкаОрганизацийДляГИСГМП_УНП.КодУчастника КАК КодУчастника,
		|	НастройкаОрганизацийДляГИСГМП_УНП.АдресTSA КАК АдресTSA,
		|	НастройкаОрганизацийДляГИСГМП_УНП.ТипВзаимодействия КАК ТипВзаимодействия,
		|	НастройкаОрганизацийДляГИСГМП_УНП.РежимВзаимодействия КАК РежимВзаимодействия,
		|	НастройкаОрганизацийДляГИСГМП_УНП.РежимПодписи КАК РежимПодписи,
		|	НастройкаОрганизацийДляГИСГМП_УНП.РазмерПакетаНачислений КАК РазмерПакетаНачислений,
		|	НастройкаОрганизацийДляГИСГМП_УНП.ПолномочияУчастника КАК ПолномочияУчастника,
		|	НастройкаОрганизацийДляГИСГМП_УНП.СертификатЭПНачислений КАК СертификатЭПНачислений,
		|	НастройкаОрганизацийДляГИСГМП_УНП.СертификатЭПСообщения КАК СертификатЭПСообщения,
		|	НастройкаОрганизацийДляГИСГМП_УНП.ИмяИСУчастника КАК ИмяИСУчастника,
		|	НастройкаОрганизацийДляГИСГМП_УНП.КодИСУчастника КАК КодИСУчастника,
		|	НастройкаОрганизацийДляГИСГМП_УНП.НастройкаОбмена КАК НастройкаОбмена,
		|	НастройкаОрганизацийДляГИСГМП_УНП.НастройкаФорматов КАК НастройкаФорматов,
		|	НастройкаОрганизацийДляГИСГМП_УНП.УРНГАН КАК УРНГАН,
		|	НастройкаОрганизацийДляГИСГМП_УНП.ПолномочияУчастникаГАН КАК ПолномочияУчастникаГАН,
		|	НастройкаОрганизацийДляГИСГМП_УНП.ПолномочияУчастникаАЗ КАК ПолномочияУчастникаАЗ,
		|	НастройкаОрганизацийДляГИСГМП_УНП.ПолномочияУчастникаГАЗ КАК ПолномочияУчастникаГАЗ,
		|	НастройкаОрганизацийДляГИСГМП_УНП.КодМаршрутизации КАК КодМаршрутизации,
		|	НастройкаОрганизацийДляГИСГМП_УНП.ИдентификаторНоды КАК ИдентификаторНоды,
		|	НастройкаОрганизацийДляГИСГМП_УНП.ПолномочияУчастникаПосредникаНСИ КАК ПолномочияУчастникаПосредникаНСИ,
		|	НастройкаОрганизацийДляГИСГМП_УНП.ПолномочияУчастникаПосредникаНачисления КАК ПолномочияУчастникаПосредникаНачисления,
		|	НастройкаОрганизацийДляГИСГМП_УНП.ЭтоУчастникПосредник КАК ЭтоУчастникПосредник
		|ИЗ
		|	ВремТаб КАК ВремТаб
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкаОрганизацийДляГИСГМП_УНП КАК НастройкаОрганизацийДляГИСГМП_УНП
		|		ПО (НастройкаОрганизацийДляГИСГМП_УНП.Организация = ВремТаб.Организация)
		|			И (НастройкаОрганизацийДляГИСГМП_УНП.Подведомственный = НЕОПРЕДЕЛЕНО)";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТаблицаРезультата = РезультатЗапроса.Выгрузить();
	Если ТаблицаРезультата.Количество()>0 Тогда
		СтруктураРезультата = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаРезультата[0]);
	Иначе	
		СтруктураРезультата = Новый Структура;
		Для Каждого КолонкаТаблицы ИЗ ТаблицаРезультата.Колонки Цикл
			СтруктураРезультата.Вставить(КолонкаТаблицы.Имя,Неопределено);	
		КонецЦикла;
	КонецЕсли;

	//Если это организация, которая выполняет обмен с ГИС ГМП через ГАНа,
	//и ведет учет в другой базе, то в поле УРНГАН у нее должно быть значение УРН ГАНа,
	//через которого выполняется обмен.
	//В ином случае в УРНГАН присвоим значение УРН текущего участника отрпавителя,
	//т.к. это и будет УРН участника прямого взаимодействия.
	Если Не ЗначениеЗаполнено(СтруктураРезультата.УРНГАН) Тогда
		СтруктураРезультата.УРНГАН = СтруктураРезультата.УРН;
	КонецЕсли;
	
	//ПолномочияУчастникаГАН - аналогично УРНГАН
	Если Не ЗначениеЗаполнено(СтруктураРезультата.ПолномочияУчастникаГАН) Тогда
		СтруктураРезультата.ПолномочияУчастникаГАН = СтруктураРезультата.ПолномочияУчастника;
	КонецЕсли;
	
	//для ГАЗ аналогично
	Если Не ЗначениеЗаполнено(СтруктураРезультата.ПолномочияУчастникаГАЗ) Тогда
		СтруктураРезультата.ПолномочияУчастникаГАЗ = СтруктураРезультата.ПолномочияУчастникаАЗ;
	КонецЕсли;
	
	Возврат СтруктураРезультата;
	
КонецФункции


Функция ПолучитьПодписанноеНачисление(СсылкаНаДокумент) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПодписанныеНачисления.ПодписанноеНачисление
		|ИЗ
		|	РегистрСведений.ПодписанныеНачисления КАК ПодписанныеНачисления
		|ГДЕ
		|	ПодписанныеНачисления.Начисление = &Начисление";
	
	Запрос.УстановитьПараметр("Начисление", СсылкаНаДокумент);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	ТребуемыеДанные = "";	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ТребуемыеДанные = ВыборкаДетальныеЗаписи.ПодписанноеНачисление.Получить();
	КонецЕсли;
	
	Возврат ТребуемыеДанные;
	
КонецФункции

