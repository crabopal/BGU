Функция ЧастиФИО(ФизЛицо, НаДату) Экспорт
	Результат = Новый Структура("ФАМИЛИЯ, ИМЯ, ОТЧЕСТВО", "", "", "");
	
	ЗаписиФИО = РегистрыСведений.ФИОФизическихЛиц.СрезПоследних(НаДату, Новый Структура("ФизическоеЛицо", ФизЛицо));
	
	Если ЗаписиФИО.Количество() > 0 Тогда
		Стр = ЗаписиФИО[0];
		
		Результат.ФАМИЛИЯ 	= Стр.Фамилия;
		Результат.ИМЯ 		= Стр.Имя;
		Результат.ОТЧЕСТВО	= Стр.Отчество;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция СтруктураПараметровФайлаВыгрузкиКомпенсацииРодительскойПлаты(ДокументСсылка, ЗаданиеНаЭкспорт) Экспорт
	
	СтруктураПараметров = Новый Структура;
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "НастройкаВыгрузки, НомерРеестра");
	
	Настройка = РеквизитыДокумента.НастройкаВыгрузки;
	
	Если Не ЗначениеЗаполнено(Настройка) Тогда
		Возврат СтруктураПараметров;
	КонецЕсли;
	
	СтруктураПараметров.Вставить("БИК", Настройка.Банк.Код);
	СтруктураПараметров.Вставить("РасчетныйСчетОрганизации", Настройка.РасчетныйСчет);
	СтруктураПараметров.Вставить("НомерДоговора", Настройка.НомерДоговора);
	СтруктураПараметров.Вставить("ДатаДоговора", Настройка.ДатаДоговора);
	СтруктураПараметров.Вставить("ОтделениеБанка", Настройка.ОтделениеБанка);
	СтруктураПараметров.Вставить("ФилиалОтделенияБанка", Настройка.ФилиалОтделенияБанка);
	
	Организация = ЗаданиеНаЭкспорт.Организация;
	
	Если Настройка.ИспользоватьСокращенноеНаименованиеОрганизации Или Организация.ИспользоватьВПлатежныхДокументахСокращенноеНаименование Тогда
		СтруктураПараметров.Вставить("НаименованиеОрганизации", Организация.НаименованиеСокращенное);
	Иначе
		СтруктураПараметров.Вставить("НаименованиеОрганизации", Организация.НаименованиеПолное);
	КонецЕсли;
	
	СтруктураПараметров.Вставить("НомерРеестра", РеквизитыДокумента.НомерРеестра);
	СтруктураПараметров.Вставить("НомерРеестраДляИмениФайла", РеквизитыДокумента.НомерРеестра);
	
	Возврат СтруктураПараметров;
	
КонецФункции

