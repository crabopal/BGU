
Функция ПолучитьТабличнуюЧастьЗадания(Задание) Экспорт
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена.НомерСтроки,
	               |	ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена.Объект
	               |ИЗ
	               |	Документ.ЗаданиеНаЭкспортДанныхВБанкиКС.ОбъектыОбмена КАК ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена
	               |ГДЕ
	               |	ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена.Ссылка = &Задание";	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Задание",Задание.Ссылка);
	РезультатЗапроса = Запрос.Выполнить();
    Возврат РезультатЗапроса.Выгрузить();
КонецФункции	

Функция ПолучитьОбъектВоВременномХранилище() Экспорт
	Возврат ПоместитьВоВременноеХранилище(Неопределено);
КонецФункции	

Функция НайтиЛицевойСчетПоНомеру(НомерЛС, Организация, КассовыйОрган = "") Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НомерЛС",       НомерЛС);
	Запрос.УстановитьПараметр("КассовыйОрган", КассовыйОрган);
	
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ЛицевыеСчета.Ссылка				КАК ЛицевойСчет
	|ИЗ
	|	Справочник.ЛицевыеСчета			КАК ЛицевыеСчета";
	
	Если ЗначениеЗаполнено(КассовыйОрган) Тогда
		
		Запрос.Текст = Запрос.Текст+"
    |ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.РеквизитыЛицевыхСчетов  КАК РеквизитыЛицевыхСчетов
	|           ПО РеквизитыЛицевыхСчетов.Владелец = ЛицевыеСчета.Ссылка
	|              И РеквизитыЛицевыхСчетов.КассовыйОрган = &КассовыйОрган";
		
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст+"
	|ГДЕ
	|	ЛицевыеСчета.Код 				= &НомерЛС
	|	И ЛицевыеСчета.ПометкаУдаления 	= Ложь
	|";
	
	Если ЗначениеЗаполнено(Организация) Тогда
		Запрос.Текст = Запрос.Текст+"
		|	И ЛицевыеСчета.Владелец = &Организация";
		Запрос.УстановитьПараметр("Организация", Организация);
	КонецЕсли;
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат "";
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	Возврат Выборка.ЛицевойСчет;
	
КонецФункции

Функция ПолучитьРеквизитыПРДокумента(Объект) Экспорт       
	
	МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Объект.Ссылка);  
    Возврат	МенеджерОбъекта.ЗначенияРеквизитовДокумента(Объект)[0];
		
КонецФункции
	
Функция ПолучитьХарактеристикиОбязательства(Ссылка) Экспорт
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ЕСТЬNULL(ХарактеристикиОбязательствСрезПоследних.ВидХарактеристики, ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыХарактеристикОбязательства.ПустаяСсылка)) КАК ВидХарактеристики,
	               |	ЕСТЬNULL(ХарактеристикиОбязательствСрезПоследних.ЗначениеХарактеристики, """") КАК ЗначениеХарактеристики,
	               |	ЕСТЬNULL(ХарактеристикиОбязательствСрезПоследних.ВидХарактеристики.Код, """") КАК ВидХарактеристикиКод
	               |ИЗ
	               |	РегистрСведений.ХарактеристикиОбязательств.СрезПоследних КАК ХарактеристикиОбязательствСрезПоследних
				   |ГДЕ
	               |	ХарактеристикиОбязательствСрезПоследних.Договор = &Ссылка
	               |";
				   				   
	Запрос.Текст      = ТекстЗапроса;
	Если ТипЗнч(Ссылка) = Тип("СправочникСсылка.Договоры") Тогда
		Запрос.УстановитьПараметр("Ссылка", Ссылка);	
	Иначе
		Запрос.УстановитьПараметр("Ссылка", Ссылка.Договор);
	КонецЕсли;
	ТаблицаХарактеристикОбязательства = Запрос.Выполнить().Выгрузить();
				   
	СтруктураХарактеристик = Новый Структура("ГрифСекретности, ДатаОснованияЗаключенияКонтракта, ДатаАукциона, ДатаРегистрацииУполномоченнымОрганом, 
	|НаименованиеОснованияЗаключенияКонтракта, НомерОснованияЗаключенияКонтракта, НомерИзвещения, НомерРеестровойЗаписи, СпособРазмещенияЗаказа, 
	|СпособРазмещенияЗаказаКод, СтатусИсполненияГК, НаименованиеСудебногоОргана, ФормулаЦеныКонтракта, НомерРеестровойЗаписиРасторгнутогоКонтракта, 
	|РазмерОбеспеченияКонтракта, НомерЗаписиВРеестреБанковскихГарантий, ПериодичностьИсполненияКонтракта, ИКЗ, ИдентификаторКонтракта, ОснованиеНевключенияВРеестр,
	|ИнформацияОСанкционировании, НомерРеестровойЗаписиВРеестреКонтрактов, ИдентификаторЭтапа, КодВидаРеестра, ДатаУведомления, НомерУведомления, ТипИдентификатора,
	|ДатаПодписанияЗаказчиком, ИдентификаторЭтапа, ПунктПеречня");
	
	СтруктураХарактеристик.Вставить("ЭтоСекретныйДокумент", Ложь); // Для быстрого определения секретности документа
	
	Для каждого СтрокаХарактеристики Из ТаблицаХарактеристикОбязательства Цикл
		Если СтрокаХарактеристики.ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.ГрифСекретности Тогда
			
			Если СтрокаХарактеристики.ЗначениеХарактеристики = Перечисления.ПризнакСекретности.НеСекретно Тогда
				 СтруктураХарактеристик.ГрифСекретности = "0"
			ИначеЕсли СтрокаХарактеристики.ЗначениеХарактеристики = Перечисления.ПризнакСекретности.ДСП Тогда
				 СтруктураХарактеристик.ГрифСекретности = "1"
			ИначеЕсли СтрокаХарактеристики.ЗначениеХарактеристики = Перечисления.ПризнакСекретности.Секретно Тогда
				 СтруктураХарактеристик.ГрифСекретности = "2"
            ИначеЕсли СтрокаХарактеристики.ЗначениеХарактеристики = Перечисления.ПризнакСекретности.СовершенноСекретно Тогда
				 СтруктураХарактеристик.ГрифСекретности = "3"
        	КонецЕсли;				
			
		ИначеЕсли СтрокаХарактеристики.ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.ДатаОснованияЗаключенияКонтракта Тогда 
			СтруктураХарактеристик.ДатаОснованияЗаключенияКонтракта = СтрокаХарактеристики.ЗначениеХарактеристики;
			
		ИначеЕсли СтрокаХарактеристики.ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.ДатаАукциона Тогда 
			СтруктураХарактеристик.ДатаАукциона = СтрокаХарактеристики.ЗначениеХарактеристики;
			
		ИначеЕсли СтрокаХарактеристики.ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.ДатаРегистрацииУполномоченнымОрганом Тогда 
			СтруктураХарактеристик.ДатаРегистрацииУполномоченнымОрганом = СтрокаХарактеристики.ЗначениеХарактеристики;
			
		ИначеЕсли СтрокаХарактеристики.ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.НаименованиеОснованияЗаключенияКонтракта Тогда 
			СтруктураХарактеристик.НаименованиеОснованияЗаключенияКонтракта = СтрокаХарактеристики.ЗначениеХарактеристики;
			
		ИначеЕсли СтрокаХарактеристики.ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.НомерОснованияЗаключенияКонтракта Тогда 
			СтруктураХарактеристик.НомерОснованияЗаключенияКонтракта = СтрокаХарактеристики.ЗначениеХарактеристики;
			
		ИначеЕсли СтрокаХарактеристики.ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.НомерИзвещения Тогда 
			СтруктураХарактеристик.НомерИзвещения = СтрокаХарактеристики.ЗначениеХарактеристики;
			
		ИначеЕсли СтрокаХарактеристики.ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.НомерРеестровойЗаписи Тогда 
			СтруктураХарактеристик.НомерРеестровойЗаписи = СтрокаХарактеристики.ЗначениеХарактеристики;
			
		ИначеЕсли СтрокаХарактеристики.ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.ИдентификаторЭтапа Тогда 
			СтруктураХарактеристик.ИдентификаторЭтапа = СтрокаХарактеристики.ЗначениеХарактеристики;
				
		ИначеЕсли СтрокаХарактеристики.ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.ФормулаЦеныКонтракта Тогда 
			СтруктураХарактеристик.ФормулаЦеныКонтракта = СтрокаХарактеристики.ЗначениеХарактеристики;
			
		ИначеЕсли СтрокаХарактеристики.ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.НомерРеестровойЗаписиРасторгнутогоКонтракта Тогда 
			СтруктураХарактеристик.НомерРеестровойЗаписиРасторгнутогоКонтракта = СтрокаХарактеристики.ЗначениеХарактеристики;
			
		ИначеЕсли СтрокаХарактеристики.ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.ОснованиеНевключенияВРеестр Тогда 
			СтруктураХарактеристик.ОснованиеНевключенияВРеестр = СтрокаХарактеристики.ЗначениеХарактеристики;	
			
		ИначеЕсли СтрокаХарактеристики.ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.РазмерОбеспеченияКонтракта Тогда 
			СтруктураХарактеристик.РазмерОбеспеченияКонтракта = СтрокаХарактеристики.ЗначениеХарактеристики;
			
		ИначеЕсли СтрокаХарактеристики.ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.НомерЗаписиВРеестреБанковскихГарантий Тогда 
			СтруктураХарактеристик.НомерЗаписиВРеестреБанковскихГарантий = СтрокаХарактеристики.ЗначениеХарактеристики;	
			
		ИначеЕсли СтрокаХарактеристики.ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.ПунктПеречня Тогда 
			СтруктураХарактеристик.ПунктПеречня = СтрокаХарактеристики.ЗначениеХарактеристики;	
				
		ИначеЕсли СтрокаХарактеристики.ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.ПериодичностьИсполненияКонтракта Тогда 
			СтруктураХарактеристик.ПериодичностьИсполненияКонтракта = СтрокаХарактеристики.ЗначениеХарактеристики;	
			
		ИначеЕсли СтрокаХарактеристики.ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.ИКЗ Тогда 
			СтруктураХарактеристик.ИКЗ = СтрокаХарактеристики.ЗначениеХарактеристики;
			
		ИначеЕсли СтрокаХарактеристики.ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.НомерРеестровойЗаписиВРеестреКонтрактов Тогда 
			СтруктураХарактеристик.НомерРеестровойЗаписиВРеестреКонтрактов = СтрокаХарактеристики.ЗначениеХарактеристики;
			
		ИначеЕсли СтрокаХарактеристики.ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.ИдентификаторЭтапа Тогда 
			СтруктураХарактеристик.ИдентификаторЭтапа = СтрокаХарактеристики.ЗначениеХарактеристики;
			
		ИначеЕсли СтрокаХарактеристики.ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.КодВидаРеестра Тогда 
			СтруктураХарактеристик.КодВидаРеестра = СтрокаХарактеристики.ЗначениеХарактеристики;
			
		ИначеЕсли СтрокаХарактеристики.ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.ИдентификаторКонтракта Тогда 
			СтруктураХарактеристик.ИдентификаторКонтракта = СтрокаХарактеристики.ЗначениеХарактеристики;
			
		ИначеЕсли СтрокаХарактеристики.ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.НомерУведомления Тогда 
			СтруктураХарактеристик.НомерУведомления = СтрокаХарактеристики.ЗначениеХарактеристики;
			
		ИначеЕсли СтрокаХарактеристики.ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.ДатаУведомления Тогда 
			СтруктураХарактеристик.ДатаУведомления = СтрокаХарактеристики.ЗначениеХарактеристики;
			
		ИначеЕсли СтрокаХарактеристики.ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.ТипИдентификатора Тогда 
			СтруктураХарактеристик.ТипИдентификатора = ?(ЗначениеЗаполнено(СтрокаХарактеристики.ЗначениеХарактеристики), Лев(СтрокаХарактеристики.ЗначениеХарактеристики, 1), "");	
			
		ИначеЕсли СтрокаХарактеристики.ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.ДатаПодписанияЗаказчиком Тогда 
			СтруктураХарактеристик.ДатаПодписанияЗаказчиком = СтрокаХарактеристики.ЗначениеХарактеристики;	
			
		ИначеЕсли СтрокаХарактеристики.ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.СпособРазмещенияЗаказа Тогда 
			СтруктураХарактеристик.СпособРазмещенияЗаказа = СтрокаХарактеристики.ЗначениеХарактеристики;
			СтруктураХарактеристик.СпособРазмещенияЗаказаКод = СтрокаХарактеристики.ЗначениеХарактеристики.Код; 
			
		ИначеЕсли СтрокаХарактеристики.ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.СтатусИсполненияГК Тогда
			
			Если  СтрокаХарактеристики.ЗначениеХарактеристики = Перечисления.СтатусыИсполненияДоговоров.Завершен Тогда
				  СтруктураХарактеристик.СтатусИсполненияГК = "1";
			ИначеЕсли  СтрокаХарактеристики.ЗначениеХарактеристики = Перечисления.СтатусыИсполненияДоговоров.Аннулирован Тогда
				  СтруктураХарактеристик.СтатусИсполненияГК = "2";
			Иначе
				  СтруктураХарактеристик.СтатусИсполненияГК = "0";
		    КонецЕсли;
			
		ИначеЕсли СтрокаХарактеристики.ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.СудебныйОрган Тогда 
			СтруктураХарактеристик.НаименованиеСудебногоОргана = СтрокаХарактеристики.ЗначениеХарактеристики;
			
		ИначеЕсли СтрокаХарактеристики.ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.ИнформацияОСанкционировании Тогда
			
			Если  СтрокаХарактеристики.ЗначениеХарактеристики  Тогда
				  СтруктураХарактеристик.ИнформацияОСанкционировании = "Да";
			Иначе
				  СтруктураХарактеристик.ИнформацияОСанкционировании = "Нет";
		    КонецЕсли;		
			
		ИначеЕсли ЗначениеЗаполнено(СтрокаХарактеристики.ВидХарактеристикиКод) Тогда
			
			ДопустимыйКод = "";
			
			Для к = 1 По СтрДлина(СтрокаХарактеристики.ВидХарактеристикиКод) Цикл
				Если БухгалтерскиеОперацииКлиентСервер.РазрешенныйСимволСлова(КодСимвола(СтрокаХарактеристики.ВидХарактеристикиКод, к)) Тогда
					 ДопустимыйКод = ДопустимыйКод + Сред(СтрокаХарактеристики.ВидХарактеристикиКод, к, 1);
				КонецЕсли;
			КонецЦикла;	
			
			Если ЗначениеЗаполнено(ДопустимыйКод) И НЕ СтруктураХарактеристик.Свойство(ДопустимыйКод) Тогда
				СтруктураХарактеристик.Вставить(ДопустимыйКод, СтрокаХарактеристики.ЗначениеХарактеристики);
			КонецЕсли;
						
		КонецЕсли; 	
	КонецЦикла; 
	
	Возврат СтруктураХарактеристик;       
	
КонецФункции
	
Функция ПолучитьДанныеКонтрагента(Контрагент,Дата) Экспорт
	СтруктураОтвета = Новый Структура("Фамилия,Имя,Отчество","","","");
	
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Возврат СтруктураОтвета;
	КонецЕсли;
	
	Если ТипЗнч(Контрагент) <> Тип("СправочникСсылка.Контрагенты") Тогда
		Возврат СтруктураОтвета;
	КонецЕсли;
	
	ВидКонтрагента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Контрагент,"ВидКонтрагента",Истина);
	
	Если ВидКонтрагента <> Перечисления.ЮрФизЛицо.ФизЛицо Тогда
		Возврат СтруктураОтвета;
	КонецЕсли;
	
	ФиоФизЛица = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество", Контрагент, Дата);
	
	Справочники.Контрагенты.ПолучитьДанныеКонтрагента(ФиоФизЛица);
	
	СтруктураОтвета.Фамилия = ?(ЗначениеЗаполнено(ФиоФизЛица.Фамилия), ФиоФизЛица.Фамилия, "");
	СтруктураОтвета.Имя = ?(ЗначениеЗаполнено(ФиоФизЛица.Имя), ФиоФизЛица.Имя, "");
	СтруктураОтвета.Отчество = ?(ЗначениеЗаполнено(ФиоФизЛица.Отчество), ФиоФизЛица.Отчество, "");
		
	Возврат СтруктураОтвета;

	
КонецФункции

