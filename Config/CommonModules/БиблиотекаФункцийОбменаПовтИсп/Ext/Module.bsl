Функция ПолучитьЗначениеНастройкиПечатиПрефиксаНомераВидаДокумента(ИмяДокумента) Экспорт
	
	Обрезать = Ложь;
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НастройкиПечатиПрефиксаНомера.ОбрезатьПрефикс,
		|	НастройкиПечатиПрефиксаНомера.ВидДокумента,
		|	НастройкиПечатиПрефиксаНомера.ВидДокумента.Предопределенный КАК ВидДокументаПредопределенный
		|ИЗ
		|	РегистрСведений.НастройкиПечатиПрефиксаНомера КАК НастройкиПечатиПрефиксаНомера
		|ГДЕ
		|	(НастройкиПечатиПрефиксаНомера.ВидДокумента.Имя = &ИмяДокумента
		|			ИЛИ НастройкиПечатиПрефиксаНомера.ВидДокумента.Предопределенный)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВидДокументаПредопределенный";

	Запрос.УстановитьПараметр("ИмяДокумента", ИмяДокумента);

	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();
    //Первым в выборке будет запрашиваемый документ. Если настройки с данным документом нет, то будет общая настройка.
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Обрезать = ВыборкаДетальныеЗаписи.ОбрезатьПрефикс;		
	КонецЕсли;

	Возврат Обрезать;	
	
КонецФункции

