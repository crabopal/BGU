Функция ПолучитьАдресВФорматеРИ(Текст) Экспорт
	
	АдресРФИ = Новый Структура("Страна, КодСтраны, Индекс, Регион, КодРегиона, Район, Город, НаселенныйПункт, Улица, Дом, Строение, Корпус, Квартира, Представление, Текст",
								"","","","","","","","","","","","","","", Текст);
	
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат АдресРФИ;
	КонецЕсли;
		
	Адрес = РаботаСАдресами.ПредыдущаяСтруктураКонтактнойИнформацииXML(Текст);
	ЗаполнитьЗначенияСвойств(АдресРФИ, Адрес);
	Страна = УправлениеКонтактнойИнформацией.ДанныеКлассификатораСтранМираПоНаименованию(АдресРФИ.Страна);
	Если Страна <> Неопределено Тогда			
		АдресРФИ.КодСтраны = Страна.КодАльфа2;
	КонецЕсли;
	
	Если СтрДлина(АдресРФИ.КодРегиона) = 1 Тогда
		АдресРФИ.КодРегиона = "0" + АдресРФИ.КодРегиона;
	КонецЕсли;	
	
	АдресРФИ.Вставить("Корпус", ?(Адрес.ТипКорпуса = "Корпус", Адрес.Корпус, ""));
	АдресРФИ.Вставить("Строение", ?(Адрес.ТипКорпуса = "Строение", Адрес.Корпус, ""));	
	
	Возврат АдресРФИ;
	
КонецФункции

