Функция ПолучитьПрефиксДляГосуслугиИзШаблона(Организация,НомерСтроки) Экспорт
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ШаблоныИдентификаторовКвитанцийНаОплатуГосуслугСоставШаблона.Значение
		|ИЗ
		|	Справочник.ШаблоныИдентификаторовКвитанцийНаОплатуГосуслуг.СоставШаблона КАК ШаблоныИдентификаторовКвитанцийНаОплатуГосуслугСоставШаблона
		|ГДЕ
		|	ШаблоныИдентификаторовКвитанцийНаОплатуГосуслугСоставШаблона.Ссылка.Владелец = &Организация
		|	И ШаблоныИдентификаторовКвитанцийНаОплатуГосуслугСоставШаблона.Ссылка.ПометкаУдаления = ЛОЖЬ
		|	И ШаблоныИдентификаторовКвитанцийНаОплатуГосуслугСоставШаблона.НомерСтроки = &НомерСтроки";

	Запрос.УстановитьПараметр("НомерСтроки", НомерСтроки);
	Запрос.УстановитьПараметр("Организация", Организация);

	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();

	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Значение;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция СмещениеЧасовогоПояса(Знач ЧасовойПояс) Экспорт
	
	Если ЧасовойПояс = Неопределено Тогда
		ЧасовойПояс = ПолучитьЧасовойПоясИнформационнойБазы();
	КонецЕсли;
	
	Разница = СмещениеСтандартногоВремени(ЧасовойПояс);
	
	Если Разница = 0 Тогда
		Смещение = "";
	Иначе
		Смещение = ?(Разница >= 0, "+", "") + Формат(Цел(Разница / 3600), "ЧЦ=2; ЧН=; ЧВН=") + ":" + Формат(Разница - Цел(Разница / 60) * 60, "ЧЦ=2; ЧН=; ЧВН=");
	КонецЕсли;

	Возврат Смещение;
	
КонецФункции


