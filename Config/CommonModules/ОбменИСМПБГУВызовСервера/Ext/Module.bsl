
#Область ПрограммныйИнтерфейс

Функция ВыводИзОборотаКодовМаркировкиВСервисе(ПараметрыОтправкиДанных, АдресХранилища = Неопределено) Экспорт
	
	РезультатОперации = ОбменИСМПБГУКлиентСервер.НовыйРезультатОперацииСервиса();
	
	ПараметрыОперации = ОбменИСМПБГУКлиентСервер.НовыеПараметрыОперацииСервиса();
	
	НаименованиеОперации = ОбменИСМПБГУКлиентСервер.НаименованиеОперацииВыводИзОборотаКодовМаркировки();
	
	ПараметрыОперации.НаименованиеОперации = НаименованиеОперации;
	ПараметрыОперации.ИсходныеДанные = ПараметрыОтправкиДанных;
	ПараметрыОперации.Организация = ПараметрыОтправкиДанных.Организация;
	
	ОбменИСМПБГУ.ВыполнитьОперациюСервиса(ПараметрыОперации, РезультатОперации);
	
	Если АдресХранилища <> Неопределено Тогда
		ПоместитьВоВременноеХранилище(РезультатОперации, АдресХранилища);
	КонецЕсли;
	
	Возврат РезультатОперации;
	
КонецФункции

Функция ЗапроситьУстановитьКлючСессии(ПараметрыЗапроса, ПараметрыАвторизации, Подпись) Экспорт
	
	Возврат ОбменИСМПБГУ.ЗапроситьУстановитьКлючСессии(ПараметрыЗапроса, ПараметрыАвторизации, Подпись);
	
КонецФункции

Функция СодержимоеДокументаСервиса(ПараметрыЗапросаДанных, АдресХранилища = Неопределено) Экспорт
	
	РезультатОперации = ОбменИСМПБГУКлиентСервер.НовыйРезультатОперацииСервиса();
	
	ПараметрыОперации = ОбменИСМПБГУКлиентСервер.НовыеПараметрыОперацииСервиса();
	
	НаименованиеОперации = ОбменИСМПБГУКлиентСервер.НаименованиеОперацииСодержимоеДокумента();
	
	ПараметрыОперации.НаименованиеОперации = НаименованиеОперации;
	ПараметрыОперации.ИсходныеДанные = ПараметрыЗапросаДанных.Идентификатор;
	ПараметрыОперации.Организация = ПараметрыЗапросаДанных.Организация;
	
	ОбменИСМПБГУ.ВыполнитьОперациюСервиса(ПараметрыОперации, РезультатОперации);
	
	Если АдресХранилища <> Неопределено Тогда
		ПоместитьВоВременноеХранилище(РезультатОперации, АдресХранилища);
	КонецЕсли;
	
	Возврат РезультатОперации;
	
КонецФункции

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("ВыводИзОборотаКодовМаркировкиВСервисе", Истина);
	Методы.Вставить("СодержимоеДокументаСервиса", Истина);
КонецПроцедуры

#КонецОбласти
