#Область ПрограммныйИнтерфейс

// Вызывается при нажатии на гиперссылку или двойном щелчке на ячейке 
// табличного документа с описанием изменений системы (общий макет ОписаниеИзмененийСистемы).
//
// Параметры:
//   Область - ОбластьЯчеекТабличногоДокумента - область документа, на 
//             которой произошло нажатие.
//
Процедура ПриНажатииНаГиперссылкуВДокументеОписанияОбновлений(Знач Область) Экспорт
	
	Если Область.Имя = "И239ФЗ" Тогда
		
		ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку("http://publication.pravo.gov.ru/Document/View/0001202207140002?ysclid=l5qeqjy62o744467380"); 
		
	ИначеЕсли Область.Имя = "ИПроект03112022" Тогда
		
		ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку("https://minfin.gov.ru/ru/document/npa_projects?id_4=8116-o_vnesenii_izmenenii_v_prilozheniya__1_i__2_k_prikazu_ministerstva_finansov_rossiiskoi_federatsii_ot_1_dekabrya_2010_g.__157n_ob_utverzhdenii_edinogo_plana_schetov_bukhgalterskogo_ucheta_dlya_organov_gosudarstvennoi_vlasti_gosudarstvennykh_organov_organov_mestnogo_samoupravleniya_organov_upravleniya_gosudarstvennymi_vnebyudzhetnymi_fondami_gosudarstvennykh_akademii_nauk_gosudarstvennykh_munitsipalnykh_uchrezhdenii_i_instruktsii_po_ego_primeneniyu");
		
	ИначеЕсли Область.Имя = "И81409" Тогда   
		
		ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку("https://www.nalog.gov.ru/rn77/ens/");
		
	ИначеЕсли НЕ СтрНайти(Нрег(Область.Текст), "см. справку") = 0 
		ИЛИ НЕ СтрНайти(Нрег(Область.Текст), "см. в справке") = 0 Тогда
		
		ОткрытьСправку(СтрЗаменить(Область.Имя, "_", "."));
		
	КонецЕсли;	
	
	
КонецПроцедуры

