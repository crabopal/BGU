Функция ПолучитьЗначениеПоляСтрокиТЧДокумента(Ссылка,ИмяТЧ,ИмяКолонкиЗначения,ИмяКолонкиПоиска,ЗначениеПоиска,ЭтоДокумент = Истина) Экспорт
	ВидОбъекта = ?(ЭтоДокумент = Истина,"Документ","Справочник");
	
	ИскомоеЗначение = "";
	Попытка
		ИмяОбъекта = Ссылка.Метаданные().Имя;
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		|	ТЧДок.НомерСтроки КАК НомерСтроки,
		|	ЕстьNull(ТЧДок."+ИмяКолонкиЗначения+","""") КАК ИскомоеЗначение
		|ИЗ
		|	"+ВидОбъекта+"."+ИмяОбъекта+"."+ИмяТЧ+" КАК ТЧДок
		|ГДЕ
		|	ТЧДок.Ссылка = &Ссылка
		|	И ТЧДок."+ИмяКолонкиПоиска+" = &ЗначениеПоиска
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
		Запрос.УстановитьПараметр("Ссылка",Ссылка);
		Запрос.УстановитьПараметр("ЗначениеПоиска",ЗначениеПоиска);
