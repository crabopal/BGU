	Возврат БиблиотекаФункцийОбменаПовтИсп.СмещениеЧасовогоПояса(ЧасовойПояс);
	
КонецФункции

Функция ПреобразованиеСтрокиUTCВДату(Представление) Экспорт
	
	//Шаблон: [-]yyyy-mm-ddThh:mm:ss[.s+]{[Z][{+-}hh:mm]}
		
	Если Не ЗначениеЗаполнено(Представление) Тогда
		Возврат Дата('00010101');
	КонецЕсли;
	Если Найти(Представление, "T")<>0 Тогда		
		ДатаСтрокой = Сред(Представление, 1, Найти(Представление, "T") + 8);
	ИначеЕсли Сред(Представление,11,1) = " " Тогда
		ДатаСтрокой = Сред(Представление, 1, 19);
	КонецЕсли;
	ДатаСтрокой = Сред(СтрЗаменить(СтрЗаменить(СтрЗаменить(ДатаСтрокой, "-", ""), "T", ""), ":", ""), 1, 14);
	Попытка
		Результат = Дата(ДатаСтрокой);	
	Исключение
		Возврат Дата('00010101');
	КонецПопытки;
	
	ПоследнийСимвол = Сред(Представление, СтрДлина(Представление));
    СимволЧП = Сред(Представление, СтрДлина(Представление)-5, 1);
	
	Если ПоследнийСимвол = "Z" Или СимволЧП = "+" Или СимволЧП = "-" Тогда
		Если СимволЧП = "+" Или СимволЧП = "-" Тогда
			ЧасовойПояс = "GMT" + Сред(Представление, СтрДлина(Представление)-5);
			Результат = УниверсальноеВремя(Результат,ЧасовойПояс);
		КонецЕсли;
				
		ЧасовойПояс = ПолучитьЧасовойПоясИнформационнойБазы();
		Результат = МестноеВремя(Результат,ЧасовойПояс);
				
	КонецЕсли;	
		
	Возврат Результат;
	
КонецФункции

Функция Валюта(Значение, ВидКода) Экспорт
	
	ПустаяСсылка = Справочники.Валюты.ПустаяСсылка();
	
	Если ВидКода <> "Код" И ВидКода <> "Наименование" Тогда
		Возврат ПустаяСсылка;
	КонецЕсли;
	
	ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 1
	         |	Валюты.Ссылка
	         |ИЗ
	         |	Справочник.Валюты КАК Валюты
	         |ГДЕ
	         |	Валюты.%1 = &Значение";

	ТекстЗапроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстЗапроса, ВидКода);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Значение", Значение);
	Запрос.Текст = ТекстЗапроса;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат ПустаяСсылка;
	КонецЕсли;	
	
КонецФункции

Функция ЭлементСправочника(ИмяСправочника, Реквизиты, Параметр1 = Неопределено, Параметр2 = Неопределено, Параметр3 = Неопределено, Параметр4 = Неопределено, Параметр5 = Неопределено) Экспорт
	
	ТекстЗапроса = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Классификатор.Ссылка КАК Элемент
	|ИЗ
	|	Справочник." + ИмяСправочника + " КАК Классификатор";
		
	Условия = Новый Массив;
	МассивРеквизитов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Реквизиты);
	Сч = 1;
	Для Каждого Реквизит Из МассивРеквизитов Цикл
		Параметр = "Параметр" + Сч;
		Условия.Добавить("Классификатор." + Реквизит + " = &" + Параметр);
		Сч = Сч + 1;
	КонецЦикла;
	
	Если Условия.Количество() > 0 Тогда
		ТекстЗапроса = ТекстЗапроса + " ГДЕ " + СтрСоединить(Условия, " И ");
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	
	КолВоПараметров = МассивРеквизитов.Количество();
	
	Если КолВоПараметров > 0 Тогда
		Запрос.УстановитьПараметр("Параметр1", Параметр1);
	КонецЕсли;
	Если КолВоПараметров > 1 Тогда
		Запрос.УстановитьПараметр("Параметр2", Параметр2);
	КонецЕсли; 
	Если КолВоПараметров > 2 Тогда
		Запрос.УстановитьПараметр("Параметр3", Параметр3);
	КонецЕсли;	
	Если КолВоПараметров > 3 Тогда
		Запрос.УстановитьПараметр("Параметр4", Параметр4);
	КонецЕсли;	
	Если КолВоПараметров > 4 Тогда
		Запрос.УстановитьПараметр("Параметр5", Параметр5);
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Элемент;
	Иначе
		Результат = Справочники[ИмяСправочника].ПустаяСсылка();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


Функция АдресВФорматеРИ(Текст = "", Реквизит = Неопределено) Экспорт
		
	АдресРФИ = БиблиотекаФункцийОбменаПовтИсп.ПолучитьАдресВФорматеРИ(Текст);	
	
	Если Реквизит = Неопределено Тогда // Реквизит адреса не задан, возвращаем всю структуру адреса
		Возврат АдресРФИ;  
	Иначе                              // Реквизит адреса задан, возвращаем значение этого реквизита
		ЗначениеРеквизита = Неопределено;
		АдресРФИ.Свойство(Реквизит, ЗначениеРеквизита);
		Возврат ?(ЗначениеРеквизита = Неопределено, "", ЗначениеРеквизита);
	КонецЕсли;
	
КонецФункции

 // Не используется. Следует использовать функцию СтатусОбъектаУчетаИмущества
Функция СостояниеОбъектаРИ(Объект, Реквизит, ПоОбъектуУчета = Ложь) Экспорт
	
	Если Реквизит = "Статус" Тогда
		пОбъект = ?(ПоОбъектуУчета, Объект, Объект.ОбъектУчетаИмущества);
		Возврат СтатусОбъектаУчетаИмущества(пОбъект, ТекущаяДата());
	ИначеЕсли Реквизит = "Идентификатор" Тогда
		Возврат ?(ПоОбъектуУчета, Объект.Идентификатор, Объект.ОбъектУчетаИмущества.Идентификатор);		
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

Функция ЗначениеКлассификатораРИ(КодКлассификатора, КодЭлемента, ПоНаименованию = Ложь) Экспорт
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	Классификатор.Ссылка
	               |ИЗ
	               |	Справочник.ЗначенияРеквизитовСведенийОбИмуществе КАК Классификатор
	               |ГДЕ
	               |	Классификатор.Родитель.Код = &КодКлассификатора
	               |	И Классификатор.Код = &КодЭлемента
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Классификатор.ПометкаУдаления УБЫВ";
				   
	Если ПоНаименованию Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Классификатор.Код", "ВЫРАЗИТЬ(Классификатор.НаименованиеПолное КАК Строка(1000))");
	КонецЕсли;
		
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("КодКлассификатора", КодКлассификатора);
	Запрос.УстановитьПараметр("КодЭлемента", КодЭлемента);
					   
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Справочники.ЗначенияРеквизитовСведенийОбИмуществе.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

// Возвращает код статуса объекта учета имущества
