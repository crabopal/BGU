	ГУИД = Строка(ЗаданиеСсылка.УникальныйИдентификатор());
	ДописатьВМассивПовторногоИспользования(ИмяПараметра,Число,ГУИД);
	Возврат Число;
КонецФункции

Процедура ДописатьВМассивПовторногоИспользования(ИмяПараметра,Значение,ГУИД)
	МассивСтруктур = БухгалтерскиеОперацииПовтИсп.ПолучитьУказательНаОбъект(1,ГУИД);
	КоличествоЭлементов = МассивСтруктур.Количество();
	Если КоличествоЭлементов = 0 Тогда
		ТекСтруктура = Новый Структура("ЛицевойСчет,НачальныйОстаток,КонечныйОстаток");
		ТекСтруктура.Вставить(ИмяПараметра,Значение);
		МассивСтруктур.Добавить(ТекСтруктура);
	Иначе
		ПоследнийЭлемент = МассивСтруктур[КоличествоЭлементов-1];
		ЗначениеИзСтруктуры = Неопределено;
		Если ПоследнийЭлемент.Свойство(ИмяПараметра,ЗначениеИзСтруктуры) Тогда
			Если ЗначениеИзСтруктуры = Неопределено Тогда
				ПоследнийЭлемент.Вставить(ИмяПараметра,Значение);
			Иначе
				ТекСтруктура = Новый Структура("ЛицевойСчет,НачальныйОстаток,КонечныйОстаток");
				ТекСтруктура.Вставить(ИмяПараметра,Значение);
				МассивСтруктур.Добавить(ТекСтруктура);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

