// Возвращает ссылку на элемент заданного справочника
//
// Параметры:
// 		Значение 			- значение кода элемента
// 		ИмяКлассификатора 	- наименование справочника
// Возвращаемое значение:
// 		Тип: Либо ссылка на элемент заданного справочника, либо пустая строка (в случае неудачного поиска)
Функция ЗначениеКлассификатораПоКоду(Значение, ИмяКлассификатора)     ЭКСПОРТ
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Значение", 	Значение);
	
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Классификатор.Ссылка						КАК ЗначениеКлассификатора
	|ИЗ
	|	Справочник." + ИмяКлассификатора + " 		КАК Классификатор
	|ГДЕ
	|	Классификатор.Код 	= &Значение
	|";
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Возврат Результат.ЗначениеКлассификатора;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// Получает дату из банковской строки (в форматах УФЭБС)
// Параметры:
// 		Стр 			- Дата. [ГОСТ ИСО 8601-2001]. Формат CCYY-MM-DD
// Возвращаемое значение:
// 		Тип: Дата		- преобразованная дата из банковской строки
Функция ДатаИзБанковскойСтр(Стр, УказатьВремя = Ложь) ЭКСПОРТ
	
	Если НЕ ЗначениеЗаполнено(Стр) ИЛИ Стр = "0" Тогда
		Возврат "";
	КонецЕсли; 	
	
	Возврат Дата(Сред(Стр, 1, 4) + Сред(Стр, 6, 2) + Сред(Стр, 9, 2) + 
	            ?(УказатьВремя, Сред(Стр, 12, 2) + Сред(Стр, 15, 2) + Сред(Стр, 18, 2), "000000"));
	
КонецФункции

// Получает дату из строки в разных форматах
// Параметры:
// 		СтрокаДаты  	- строка с датой
// Возвращаемое значение:
// 		Тип: Дата		- преобразованная дата из строки
Функция ДатаИзСтрокиРазныхФорматов(СтрокаДаты) Экспорт
	
	Если НЕ ЗначениеЗаполнено(СтрокаДаты) Тогда
		Возврат Дата(1,1,1);
	КонецЕсли;
	
	Если ТипЗнч(СтрокаДаты) = Тип("Дата") Тогда
		Возврат СтрокаДаты;
	КонецЕсли;
	
	Результат = СокрЛП(СтрокаДаты);
	
	ДатаИзСтроки = ОбщегоНазначенияКлиентСервер.СтрокаВДату(Результат);
	Если ЗначениеЗаполнено(ДатаИзСтроки) Тогда
		Возврат ДатаИзСтроки;
	КонецЕсли;
	
	ПозицияЧасовогоПояса = СтрНайти(Результат, "+");
	Если ПозицияЧасовогоПояса <> 0 Тогда
		Результат = Лев(Результат, ПозицияЧасовогоПояса - 1);
		
		ДатаИзСтроки = ОбщегоНазначенияКлиентСервер.СтрокаВДату(Результат);
		Если ЗначениеЗаполнено(ДатаИзСтроки) Тогда
			Возврат ДатаИзСтроки;
		КонецЕсли;
	КонецЕсли;
	
	Префикс = "\/Date(";
	Постфикс = ")\/";
	НачалоПрефикса = СтрНайти(Результат, Префикс);
	Если НачалоПрефикса <> 0 Тогда
		ДлинаПрефикса = СтрДлина(Префикс);
		ЧисловаяДата = Сред(Результат, НачалоПрефикса + ДлинаПрефикса);
		
		КонецПрефикса = СтрНайти(Результат, Постфикс);
		Если КонецПрефикса > 0 Тогда
			ЧисловаяДата = Лев(ЧисловаяДата, КонецПрефикса - 1);
		КонецЕсли;
		
		Попытка
			Возврат '00010101000000' + Число(ЧисловаяДата) / 1000 + ('19700101000000' - '00010101000000');
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Результат = СтрЗаменить(Результат, "T", " "); // поддержка формата "2015-03-13T18:34:13", "2015-03-13T18:34:13Z"
	Результат = СтрЗаменить(Результат, "Z", "");
	
	Если СтрДлина(Результат) = 10 Тогда
		Результат = Результат + " 00:00:00";
		
	ИначеЕсли СтрДлина(Результат) = 16 Тогда
		Результат = Результат + ":00"
	КонецЕсли;
	
	Если (СтрДлина(Результат) = 19 ИЛИ (СтрДлина(Результат) >= 21 И СтрДлина(Результат) <= 23)) И Сред(Результат, 11, 1) = " " И
		(Сред(Результат, 14, 1) = ":" ИЛИ Сред(Результат, 14, 1) = ".") И (Сред(Результат, 17, 1) = ":" ИЛИ Сред(Результат, 17, 1) = ".") Тогда
		
		Если (Сред(Результат, 3, 1) = "." ИЛИ Сред(Результат, 3, 1) = "-") И (Сред(Результат, 6, 1) = "." ИЛИ Сред(Результат, 6, 1) = "-") Тогда
			Результат = Сред(Результат, 7, 4) + Сред(Результат, 4, 2) + Сред(Результат, 1, 2) + Сред(Результат, 12, 2) + Сред(Результат, 15, 2) + Сред(Результат, 18, 2);
			
		ИначеЕсли (Сред(Результат, 5, 1) = "." ИЛИ Сред(Результат, 5, 1) = "-") И (Сред(Результат, 8, 1) = "." ИЛИ Сред(Результат, 8, 1) = "-") Тогда
			Результат = Сред(Результат, 1, 4) + Сред(Результат, 6, 2) + Сред(Результат, 9, 2) + Сред(Результат, 12, 2) + Сред(Результат, 15, 2) + Сред(Результат, 18, 2);
		КонецЕсли;
	КонецЕсли;
	
	ДатаИзСтроки = ОбщегоНазначенияКлиентСервер.СтрокаВДату(Результат);
	Если ЗначениеЗаполнено(ДатаИзСтроки) Тогда
		Возврат ДатаИзСтроки;
	КонецЕсли;
	
	Возврат СтрокаДаты;
	
КонецФункции

// находит ПП по данным из ED206, регистрирует исполнение и печатных образ 
Функция ПодобратьППЗаписатьОбразУФЭБС(ПечатныйОбраз, ЗаданиеСсылка) ЭКСПОРТ
	
	НомерПП = СвойствоСтруктуры(ПечатныйОбраз, "НомерЭСисх"); 
	ДатаПП  = СвойствоСтруктуры(ПечатныйОбраз, "ДатаЭС");   
	Сумма   = Число(СвойствоСтруктуры(ПечатныйОбраз, "Сумма"))/100;   
	НомерЛС = СвойствоСтруктуры(ПечатныйОбраз, "НомерСчета");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НомерПП", 		НомерПП); 
	Запрос.УстановитьПараметр("ПолныйНомерПП",  ВосстановитьНомерДляИБ(ЗаданиеСсылка.Организация, НомерПП, "ПлатежноеПоручение"));
	Запрос.УстановитьПараметр("НачДатаПП", 		НачалоДня(ДатаПП));
	Запрос.УстановитьПараметр("КонДатаПП", 		КонецДня(ДатаПП));
	Запрос.УстановитьПараметр("Организация",	ЗаданиеСсылка.Организация);    
	Запрос.УстановитьПараметр("НомерЛС",	    НомерЛС); 
	Запрос.УстановитьПараметр("Сумма",	        Сумма);   
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1 
	               |	ПлатежноеПоручение.Ссылка КАК Ссылка
				   |ИЗ
	               |	Документ.ПлатежноеПоручение КАК ПлатежноеПоручение
	               |ГДЕ
	               |   (ПлатежноеПоручение.Номер = &НомерПП ИЛИ ПлатежноеПоручение.Номер = &ПолныйНомерПП)
	               |	И ПлатежноеПоручение.Дата >= &НачДатаПП
	               |	И ПлатежноеПоручение.Дата <= &КонДатаПП
	               |	И ПлатежноеПоручение.Организация = &Организация
				   |	И ПлатежноеПоручение.СуммаДокумента = &Сумма
				   |	И ПлатежноеПоручение.ЛицевойСчет.Код = &НомерЛС
				   |";
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		ПлатежныйДокумент = Результат.Ссылка;
	Иначе
		Возврат Документы.ПлатежноеПоручение.ПустаяСсылка();
	КонецЕсли;

    // создание массива первичных образов  
	
	СостояниеЗаявки = Новый Структура("ПервичныйОбразИРеквизиты, Статус, НомерПодтверждающегоДокумента, 
	|ДатаПодтверждающегоДокумента, ВидПодтверждающегоДокумента, ПлатежноРасчетныйДокумент, ДатаПроведения");

	СостояниеПлатежногоПорученияДо = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(ПлатежныйДокумент.Ссылка);

	МассивОбразов = "";

	Если ТипЗнч(СостояниеПлатежногоПорученияДо.ПервичныйОбразИРеквизиты) = Тип("ХранилищеЗначения") Тогда
		МассивОбразов = СостояниеПлатежногоПорученияДо.ПервичныйОбразИРеквизиты.Получить();
	КонецЕсли;

	Если ТипЗнч(МассивОбразов) <> Тип("Массив") Тогда
		МассивОбразов = Новый Массив; 
	Иначе
		МассивОбразов.Очистить();	
	КонецЕсли;

	Если ПечатныйОбраз <> Неопределено Тогда
		МассивОбразов.Добавить(ПечатныйОбраз);	
	КонецЕсли;

	СостояниеЗаявки.ПервичныйОбразИРеквизиты		= Новый ХранилищеЗначения(МассивОбразов);
	СостояниеЗаявки.Статус 							= Перечисления.СтатусыИсполненияДокумента.Исполнен;   

	СостояниеЗаявки.НомерПодтверждающегоДокумента	= СвойствоСтруктуры(ПечатныйОбраз, "НомерЭС");
	СостояниеЗаявки.ДатаПодтверждающегоДокумента	= СвойствоСтруктуры(ПечатныйОбраз, "ДатаЭС");

	СостояниеЗаявки.ВидПодтверждающегоДокумента     = "Подтверждение дебета ED206";
	СостояниеЗаявки.Вставить("ПлатежноРасчетныйДокумент", ПлатежныйДокумент.Ссылка);			
	СостояниеЗаявки.ДатаПроведения                  = СвойствоСтруктуры(ПечатныйОбраз, "ДатаСписания");
		
	ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СостояниеЗаявки);   
	
    Возврат ПлатежныйДокумент;
	
КонецФункции

// находит Заявку по данным из ED222, регистрирует исполнение и печатных образ 
Функция ПодобратьЗаявкуНДЗаписатьОбразУФЭБС(ПечатныйОбраз, ЗаданиеСсылка) ЭКСПОРТ
	
	Номер   = СвойствоСтруктуры(ПечатныйОбраз, "НомерЭПС"); 
	Дата    = СвойствоСтруктуры(ПечатныйОбраз, "ДатаЭПС");   
	Сумма   = Число(СвойствоСтруктуры(ПечатныйОбраз, "Сумма"))/100; 
	НомерБС = СвойствоСтруктуры(ПечатныйОбраз, "КоррСчет");  
	ДК      = СвойствоСтруктуры(ПечатныйОбраз, "Признак"); 
	
	ДК    = ?(ДК = "2", 1, 0);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Номер", 		  Номер); 
	Запрос.УстановитьПараметр("ПолныйНомер",  ВосстановитьНомерДляИБ(ЗаданиеСсылка.Организация, Номер, "ПлатежноеПоручение"));
	Запрос.УстановитьПараметр("НачДата", 	  НачалоДня(Дата));
	Запрос.УстановитьПараметр("КонДата", 	  КонецДня(Дата));
	Запрос.УстановитьПараметр("Организация",  ЗаданиеСсылка.Организация);     
	Запрос.УстановитьПараметр("Сумма",	      Сумма);  
	Запрос.УстановитьПараметр("НомерБС",	  НомерБС);  
	Запрос.УстановитьПараметр("ДК",	          ДК);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1 
	               |	ЗаявкаНаСдачуПолучениеНаличных.Ссылка КАК Ссылка
				   |ИЗ
	               |	Документ.ЗаявкаНаСдачуПолучениеНаличных КАК ЗаявкаНаСдачуПолучениеНаличных
	               |ГДЕ
	               |    (ЗаявкаНаСдачуПолучениеНаличных.Номер = &Номер ИЛИ ЗаявкаНаСдачуПолучениеНаличных.Номер = &ПолныйНомер)
	               |	И ЗаявкаНаСдачуПолучениеНаличных.Дата >= &НачДата
	               |	И ЗаявкаНаСдачуПолучениеНаличных.Дата <= &КонДата
	               |	И ЗаявкаНаСдачуПолучениеНаличных.Организация = &Организация  
				   |	И ЗаявкаНаСдачуПолучениеНаличных.БанковскийСчетОрганизации.Код = &НомерБС 
				   |    И ЗаявкаНаСдачуПолучениеНаличных.СдачаПолучение = &ДК
				   |	И ЗаявкаНаСдачуПолучениеНаличных.СуммаДокумента = &Сумма
				   |";
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		ЗаявкаНД = Результат.Ссылка;
	Иначе
		Возврат Документы.ЗаявкаНаСдачуПолучениеНаличных.ПустаяСсылка();
	КонецЕсли;

    // создание массива первичных образов  
	
	СостояниеЗаявки = Новый Структура("ПервичныйОбразИРеквизиты, Статус, НомерПодтверждающегоДокумента, 
	|ДатаПодтверждающегоДокумента, ВидПодтверждающегоДокумента, ПлатежноРасчетныйДокумент, ДатаПроведения");

	СостояниеЗаявкиДо = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(ЗаявкаНД.Ссылка);

	МассивОбразов = "";

	Если ТипЗнч(СостояниеЗаявкиДо.ПервичныйОбразИРеквизиты) = Тип("ХранилищеЗначения") Тогда
		МассивОбразов = СостояниеЗаявкиДо.ПервичныйОбразИРеквизиты.Получить();
	КонецЕсли;

	Если ТипЗнч(МассивОбразов) <> Тип("Массив") Тогда
		МассивОбразов = Новый Массив; 
	Иначе
		МассивОбразов.Очистить();	
	КонецЕсли;

	Если ПечатныйОбраз <> Неопределено Тогда
		МассивОбразов.Добавить(ПечатныйОбраз);	
	КонецЕсли;

	СостояниеЗаявки.ПервичныйОбразИРеквизиты		= Новый ХранилищеЗначения(МассивОбразов);
	СостояниеЗаявки.Статус 							= Перечисления.СтатусыИсполненияДокумента.Исполнен;   

	СостояниеЗаявки.НомерПодтверждающегоДокумента	= СвойствоСтруктуры(ПечатныйОбраз, "НомерЭС");
	СостояниеЗаявки.ДатаПодтверждающегоДокумента	= СвойствоСтруктуры(ПечатныйОбраз, "ДатаЭС");

	СостояниеЗаявки.ВидПодтверждающегоДокумента     = "Извещение о дебете/кредите для кассовых документов ED222";
	СостояниеЗаявки.Вставить("ПлатежноРасчетныйДокумент", ЗаявкаНД.Ссылка);			
	СостояниеЗаявки.ДатаПроведения                  = СвойствоСтруктуры(ПечатныйОбраз, "ДатаЭПС");
		
	ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СостояниеЗаявки);   
	
    Возврат ЗаявкаНД;
	
КонецФункции	


// находит платежное поручение или заявку на сдачу/получение н/д по параметрам
Функция ОпределитьПлатежныйДокументУФЭБС(СписокПараметровПП, ОбъектСсылка)  ЭКСПОРТ	
	Перем НомерПП, ДатаПП, ДК, Сумма;
	
	Если ТипЗнч(СписокПараметровПП) = Тип("Структура") Тогда
		СписокПараметровПП.Свойство("НомерПП", 		НомерПП);
		СписокПараметровПП.Свойство("ДатаПП", 		ДатаПП);
		СписокПараметровПП.Свойство("ДК", 			ДК);
		СписокПараметровПП.Свойство("Сумма", 	    Сумма);
	Иначе
		НомерПП			= СписокПараметровПП.Получить("НомерПП");
		ДатаПП			= СписокПараметровПП.Получить("ДатаПП");
		ДК				= СписокПараметровПП.Получить("ДК");  
		Сумма           = СписокПараметровПП.Получить("Сумма"); 
	КонецЕсли;
	 
	ДК    = ?(ДК = "2", 0, 1);
	
	// найти ПП или заявку по номеру и дате
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НомерПП", 		НомерПП); 
	Запрос.УстановитьПараметр("ПолныйНомерПП",  ВосстановитьНомерДляИБ(ОбъектСсылка.Организация, НомерПП, "ПлатежноеПоручение"));
	Запрос.УстановитьПараметр("НачДатаПП", 		НачалоДня(ДатаПП));
	Запрос.УстановитьПараметр("КонДатаПП", 		КонецДня(ДатаПП));
	Запрос.УстановитьПараметр("Организация",	ОбъектСсылка.Организация);
	Запрос.УстановитьПараметр("ЛицевойСчет",	ОбъектСсылка.ЛицевойСчет); 
	Запрос.УстановитьПараметр("Сумма",	        Сумма); 
	Запрос.УстановитьПараметр("ДК",	            ДК);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1 
	               |	ВложенныйЗапрос.Ссылка КАК ДокументСсылка,
				   |	ВЫБОР 
				   |       КОГДА ВложенныйЗапрос.Номер = &НомерПП 
				   |             ТОГДА ИСТИНА
				   |       ИНАЧЕ ЛОЖЬ
				   |    КОНЕЦ КАК СоответствуетНомеруИзФайла
				   |ИЗ  
				   |	(ВЫБРАТЬ
	               |	ПлатежноеПоручение.Ссылка КАК Ссылка,
				   |	ПлатежноеПоручение.Номер КАК Номер
	               |ИЗ
	               |	Документ.ПлатежноеПоручение КАК ПлатежноеПоручение
	               |ГДЕ
	               |   (ПлатежноеПоручение.Номер = &НомерПП ИЛИ ПлатежноеПоручение.Номер = &ПолныйНомерПП)
	               |	И ПлатежноеПоручение.Дата >= &НачДатаПП
	               |	И ПлатежноеПоручение.Дата <= &КонДатаПП
	               |	И ПлатежноеПоручение.Организация = &Организация
				   |	И ПлатежноеПоручение.СуммаДокумента = &Сумма
				   |    И &ДК = 0
				   |	И ПлатежноеПоручение.ЛицевойСчет = &ЛицевойСчет
				   |
				   |	ОБЪЕДИНИТЬ ВСЕ
                   |
	               |	ВЫБРАТЬ 
				   |	ЗаявкаНаСдачуПолучениеНаличных.Ссылка КАК Ссылка,
				   |	ЗаявкаНаСдачуПолучениеНаличных.Номер КАК Номер
				   |ИЗ
	               |	Документ.ЗаявкаНаСдачуПолучениеНаличных КАК ЗаявкаНаСдачуПолучениеНаличных
	               |ГДЕ
	               |   (ЗаявкаНаСдачуПолучениеНаличных.Номер = &НомерПП ИЛИ ЗаявкаНаСдачуПолучениеНаличных.Номер = &ПолныйНомерПП)
	               |	И ЗаявкаНаСдачуПолучениеНаличных.Дата >= &НачДатаПП
	               |	И ЗаявкаНаСдачуПолучениеНаличных.Дата <= &КонДатаПП
	               |	И ЗаявкаНаСдачуПолучениеНаличных.Организация = &Организация
				   |	И ЗаявкаНаСдачуПолучениеНаличных.СуммаДокумента = &Сумма
				   |    И ЗаявкаНаСдачуПолучениеНаличных.СдачаПолучение = &ДК) КАК ВложенныйЗапрос   
				   |    УПОРЯДОЧИТЬ ПО 
				   |        СоответствуетНомеруИзФайла УБЫВ
                   |";
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		ПлатежныйДокумент = Результат.ДокументСсылка;
	Иначе
		Возврат "";
	КонецЕсли;
	
	Возврат ПлатежныйДокумент;
	
КонецФункции	

// Создает нового значения заданного классификатора, по подготовленной структуре параметров, и возвращает ссылку на него
//
// Параметры:
// 		ОписаниеЗначения - структура заданного вида
// Возвращаемое значение:
// 		Тип: Ссылка на новый созданный элемент справочника
Функция СоздатьНовоеЗначениеКлассификатора(ОписаниеЗначения)     ЭКСПОРТ
	
	НаименованиеКлассификатора = "";
	
	Если НЕ ОписаниеЗначения.Свойство("НаименованиеКлассификатора", НаименованиеКлассификатора) Тогда
		Возврат "";
	КонецЕсли;
	
	Объект 						= Справочники[НаименованиеКлассификатора].СоздатьЭлемент();
	
	ЗначениеКода				= "";
	
	Если ОписаниеЗначения.Свойство("Код", ЗначениеКода) И ЗначениеЗаполнено(ЗначениеКода) Тогда
		Объект.Код	= ЗначениеКода;
	Иначе
		Возврат "";
	КонецЕсли;
	
	НаименованиеЭлемента 		= "";
	
	Если ОписаниеЗначения.Свойство("Наименование", НаименованиеЭлемента) Тогда
		Объект.НаименованиеПолное 	= НаименованиеЭлемента;
	КонецЕсли;
	
	ДатаНачалаДействия          = "";
	
	Если ОписаниеЗначения.Свойство("Дата", ДатаНачалаДействия) Тогда
		Объект.ДатаНачалаДействия 	= ?(ЗначениеЗаполнено(ДатаНачалаДействия), ДатаНачалаДействия, ТекущаяДатаСеанса()) ;
	КонецЕсли;

	Попытка
		Объект.Записать();
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции

