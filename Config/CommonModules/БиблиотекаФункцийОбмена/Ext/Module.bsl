КонецФункции   

//Определяет вид документа по коду
//
// Параметры:
// 		КодФК (Тип: Строка) - строковое представление кода вида документа физического лица
// Возвращаемое значение:
// 		Тип: СправочникСсылка.ВидыДокументовФизическихЛиц - ссылка на элемент справочника "ВидыДокументовФизическихЛиц
Функция НайтиВидДокументаПоКоду(КодФК) Экспорт
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	ВидыДокументовФизическихЛиц.Ссылка
	               |ИЗ
	               |	Справочник.ВидыДокументовФизическихЛиц КАК ВидыДокументовФизическихЛиц
	               |ГДЕ
	               |	ВидыДокументовФизическихЛиц.КодФК = &КодФК";     
	
	
	Запрос    = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("КодФК", КодФК); 
	
	Результат = Запрос.Выполнить().Выбрать(); 
	
	Если Результат.Следующий() Тогда
		Возврат  Результат.Ссылка;
	Иначе
		Возврат Справочники.ВидыДокументовФизическихЛиц.ПустаяСсылка();
	КонецЕсли;

	
КонецФункции	


Функция НайтиДокументПоGUID(ВидДокумента, GUID) Экспорт
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	СостояниеПлатежноРасчетныхДокументов.ПлатежноРасчетныйДокумент КАК Ссылка
	               |ИЗ
	               |	РегистрСведений.СостояниеПлатежноРасчетныхДокументов КАК СостояниеПлатежноРасчетныхДокументов
	               |ГДЕ
	               |	СостояниеПлатежноРасчетныхДокументов.GUIDКО = &GUIDКО
	               |	И ТИПЗНАЧЕНИЯ(СостояниеПлатежноРасчетныхДокументов.ПлатежноРасчетныйДокумент) = ТИП(Документ."+ВидДокумента+")";	
				   
	Запрос    = Новый Запрос(ТекстЗапроса);
	
	Запрос.УстановитьПараметр("GUIDКО", GUID);
	Результат = Запрос.Выполнить().Выбрать();
	Результат.Следующий();
	
	Возврат  Результат.Ссылка;
	
КонецФункции         

Функция НайтиДокументПоРеквизитуGUID(ВидДокумента, GUID) Экспорт
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	Документ.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ." + ВидДокумента + " КАК Документ
	               |ГДЕ
	               |	Документ.GUID = &GUID";	
				   
	Запрос    = Новый Запрос(ТекстЗапроса);
	
	Запрос.УстановитьПараметр("GUID", GUID);
	Результат = Запрос.Выполнить().Выбрать();
	Результат.Следующий();
	
	Возврат  Результат.Ссылка;
	
КонецФункции


Функция ЕстьЦифрыВСтроке(СтрокаДляАнализа) Экспорт
	
	Возврат (Найти(СтрокаДляАнализа, "0") + Найти(СтрокаДляАнализа, "1") + Найти(СтрокаДляАнализа, "2") + Найти(СтрокаДляАнализа, "3") +
	         Найти(СтрокаДляАнализа, "4") + Найти(СтрокаДляАнализа, "5") + Найти(СтрокаДляАнализа, "6") + Найти(СтрокаДляАнализа, "7") +
			 Найти(СтрокаДляАнализа, "8") + Найти(СтрокаДляАнализа, "9")) > 0
	
КонецФункции

Функция ОпределитьКонтрагента(ИНН, ЗНАЧ КПП = "", Наименование = "", ФИО = "", КодПоРПБС = "", ВидОбмена = "", ДанныеНовыхКонтрагентов = "")   ЭКСПОРТ
	
	ПорядокИмпортаКонтрагентов       = ?(ЗначениеЗаполнено(ВидОбмена), ВидОбмена.ПорядокИмпортаКонтрагентов, "");
	ПоискПоЧастиИмени                = ?(ЗначениеЗаполнено(ВидОбмена), ВидОбмена.ПоискПоЧастиНаименованияКонтрагента, Ложь);
	СоздаватьНовые                   = НЕ ЗначениеЗаполнено(ПорядокИмпортаКонтрагентов);
	
	//=================================================================================== 
	
	Если ПоискПоЧастиИмени И СтрНайти(Наименование, "//") > 0 Тогда
				
		СоставныеЧасти   = СтрРазделить(Наименование, "//", Ложь);
		
		Для каждого Разбираемаячасть Из СоставныеЧасти Цикл    
			
			Если Найти(Разбираемаячасть, ",") > 0 ИЛИ Найти(Нрег(Разбираемаячасть), "банк") > 0 
				    ИЛИ Найти(Нрег(Разбираемаячасть), "деньги") > 0 ИЛИ Найти(Нрег(Разбираемаячасть), "платеж") > 0 
					ИЛИ (ЕстьЦифрыВСтроке(Разбираемаячасть) И НЕ СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Разбираемаячасть)) Тогда
				    // платеж или адрес
				ИначеЕсли (СтрДлина(Разбираемаячасть) = 10 ИЛИ СтрДлина(Разбираемаячасть) = 12)
					И СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Разбираемаячасть) Тогда
					
					ИНН = Разбираемаячасть;					
					КПП = ?(СтрДлина(ИНН) = 12, "", КПП);
					
				ИначеЕсли СтрДлина(Разбираемаячасть) = 9
					И СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Разбираемаячасть) Тогда
					
					КПП = Разбираемаячасть;	
					
				ИначеЕсли НЕ СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Разбираемаячасть) Тогда
					
					Наименование = Разбираемаячасть;	
					
				КонецЕсли;   
				
		КонецЦикла;	
						
	КонецЕсли;
	
	//===================================================================================
	
	ПредполагаемыйКонтрагент         = Справочники.Контрагенты.ПустаяСсылка();
	
	Если НЕ(СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(ИНН,,Ложь)) ИЛИ СокрЛП(ИНН) = "0"  Тогда
		ИНН = "";
	КонецЕсли;	
	
	Если НЕ СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(КПП,,Ложь) ИЛИ СокрЛП(КПП) = "0" ИЛИ НЕ СтрДлина(КПП) = 9
		ИЛИ СтрДлина(ИНН) > 10 Тогда
		КПП = "";
	КонецЕсли;	
	
	НеЗаполненИНН                    = Ложь;
	
	Если НЕ ЗначениеЗаполнено(ИНН) Тогда
		 НеЗаполненИНН = Истина; 
	ИначеЕсли (СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(ИНН,,Ложь)) Тогда
		Если Число(ИНН) = 0 Тогда
			 НеЗаполненИНН = Истина; 
		КонецЕсли;
	КонецЕсли;
	
    НеЗаполненКПП                    = Ложь;
	
	Если НЕ ЗначениеЗаполнено(КПП) Тогда
		 НеЗаполненКПП = Истина; 
	ИначеЕсли (СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(КПП,,Ложь)) Тогда
		Если Число(КПП) = 0 Тогда
			 НеЗаполненКПП = Истина; 
		КонецЕсли;
	КонецЕсли;	
	
	ДлинаНаименования               = Метаданные.Справочники.Контрагенты.ДлинаНаименования;
	НаименованиеДляПоиска           = ?(ЗначениеЗаполнено(ФИО), ТРег(ФИО), ?(СтрДлина(Наименование) <= ДлинаНаименования, Наименование, Лев(Наименование, ДлинаНаименования)));

	Если Не ЗначениеЗаполнено(ФИО) И (Найти(ВРЕГ(НаименованиеДляПоиска), "ИП ") > 0 ИЛИ Найти(НРЕГ(НаименованиеДляПоиска), "предприниматель") > 0) Тогда  
		
		к = Найти(ВРЕГ(НаименованиеДляПоиска), "ИП ");  
	    м = Найти(НРЕГ(НаименованиеДляПоиска), "предприниматель");
		
		Если к>0 Тогда
			ФИО = Трег(СокрЛП(Сред(НаименованиеДляПоиска, к + 2)));
		ИначеЕсли м>0 Тогда
		    ФИО = Трег(СокрЛП(Сред(НаименованиеДляПоиска, м + 15)));	
		КонецЕсли;	
		  
	КонецЕсли;	
	
	Если  НеЗаполненИНН И НеЗаполненКПП И НЕ ЗначениеЗаполнено(НаименованиеДляПоиска) Тогда 
	//это пустой контрагент	
		Возврат ПредполагаемыйКонтрагент;
	КонецЕсли;	
	
	Если  НеЗаполненИНН И НеЗаполненКПП Тогда     
		
		Если ЗначениеЗаполнено(КодПоРПБС) Тогда
			
			текстЗапроса = "ВЫБРАТЬ
			               |	Контрагенты.Ссылка КАК Ссылка
			               |ИЗ
			               |	Справочник.Контрагенты КАК Контрагенты
			               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЮридическиеЛица КАК ЮридическиеЛица
			               |		ПО Контрагенты.ЮридическоеФизическоеЛицо = ЮридическиеЛица.Ссылка
			               |ГДЕ
			               |	ЮридическиеЛица.КодПоРПБС = &КодПоРПБС
			               |	И Контрагенты.ПометкаУдаления = ЛОЖЬ";
					   
					   
			Запрос = Новый Запрос(ТекстЗапроса);
			
			Запрос.УстановитьПараметр("КодПоРПБС",     КодПоРПБС);
						
			Результат = Запрос.Выполнить().Выбрать();
			
			Если Результат.Следующий() Тогда
				ПредполагаемыйКонтрагент = Результат.Ссылка;
			КонецЕсли;
				
		КонецЕсли;
		
	КонецЕсли;	
		
	Если НЕ НеЗаполненИНН Тогда	
				
		ЭлектронныеДокументыБГУ.СсылкаНаОбъектПоИННКПП("Контрагенты", ИНН, КПП, ПредполагаемыйКонтрагент, ТекущаяДатаСеанса());
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПредполагаемыйКонтрагент) И НеЗаполненИНН Тогда
		
		текстЗапроса = "ВЫБРАТЬ
		               |	Контрагенты.Ссылка КАК Ссылка
		               |ИЗ
		               |	Справочник.Контрагенты КАК Контрагенты
		               |ГДЕ
		               |	Контрагенты.Наименование В (&Наименование, &ФИО)
		               |	И Контрагенты.ПометкаУдаления = ЛОЖЬ";
					   
		
		
		Запрос = Новый Запрос(ТекстЗапроса);
		//обрезаем до 150, иначе не будет находиться ранее созданный контрагент по таким параметрам
		Запрос.УстановитьПараметр("Наименование",     СокрЛП(Лев(НаименованиеДляПоиска,150)));  
		Запрос.УстановитьПараметр("ФИО",              СокрЛП(Лев(?(ЗначениеЗаполнено(ФИО), ФИО, НаименованиеДляПоиска),150)));
				
		Результат = Запрос.Выполнить().Выбрать();
		
		Если Результат.Следующий() Тогда
			ПредполагаемыйКонтрагент = Результат.Ссылка;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПредполагаемыйКонтрагент) Тогда
		Возврат ПредполагаемыйКонтрагент;
	КонецЕсли;
		
	ЭтоФизлицо = (НеЗаполненИНН И ЗначениеЗаполнено(ФИО)) ИЛИ СтрДлина(ИНН) = 12;
	
	Если ТипЗнч(ДанныеНовыхКонтрагентов) = Тип("ТаблицаЗначений") И ПорядокИмпортаКонтрагентов = 1 Тогда 
		
		НовыйКонтрагент                   = ДанныеНовыхКонтрагентов.Добавить();
		НовыйКонтрагент.ИНН               = ИНН;
		НовыйКонтрагент.КПП               = КПП;
		НовыйКонтрагент.Наименование      = НаименованиеДляПоиска;
		НовыйКонтрагент.ЭтоФизическоеЛицо = ЭтоФизлицо;
		НовыйКонтрагент.КодПоРПБС         = КодПоРПБС;
		
		Возврат ПредполагаемыйКонтрагент;
		
	КонецЕсли;
	
	Если СоздаватьНовые Тогда    
		
		РеквизитыКонтрагента = Новый Структура;
		Если ЗначениеЗаполнено(ФИО)	Тогда
			ФИО = ТРег(ФИО);
			СтруктураФИО = ФизическиеЛицаКлиентСервер.ЧастиИмени(ФИО);
			РеквизитыКонтрагента.Вставить("Фамилия", СтруктураФИО.Фамилия);
			РеквизитыКонтрагента.Вставить("Имя", СтруктураФИО.Имя);		
			РеквизитыКонтрагента.Вставить("Отчество", СтруктураФИО.Отчество);
		КонецЕсли;	
		РеквизитыКонтрагента.Вставить("ИНН",                      ИНН);
		РеквизитыКонтрагента.Вставить("КПП",                      КПП);  
		РеквизитыКонтрагента.Вставить("Наименование",             ?(ЗначениеЗаполнено(ФИО), ФИО, НаименованиеДляПоиска));
		РеквизитыКонтрагента.Вставить("НаименованиеСокращенное",  ?(ЗначениеЗаполнено(ФИО), ФИО, НаименованиеДляПоиска));
		РеквизитыКонтрагента.Вставить("КодПоРПБС",                КодПоРПБС);
		  
		Если Найти(ВРЕГ(НаименованиеДляПоиска), "ИП ") > 0 ИЛИ Найти(НРЕГ(НаименованиеДляПоиска), "предприниматель") > 0 Тогда 
			 РеквизитыКонтрагента.Вставить("ТипКонтрагента",   Справочники.ТипыКонтрагентов.НайтиПоКоду("6"));
			 РеквизитыКонтрагента.Вставить("НаименованиеСокращенное",  ТРег(НаименованиеДляПоиска));
		 
	    ИначеЕсли СтрДлина(ИНН) > 10 Или НЕ ЗначениеЗаполнено(ИНН) Тогда  
			РеквизитыКонтрагента.Вставить("ТипКонтрагента",   Справочники.ТипыКонтрагентов.НайтиПоКоду("7"))		
		КонецЕсли;
				
		ЭлектронныеДокументыБГУ.СоздатьКонтрагентаПоРеквизитам(РеквизитыКонтрагента, ПредполагаемыйКонтрагент);
		
	КонецЕсли;
													  
	Возврат ПредполагаемыйКонтрагент;												  
	
КонецФункции

Функция КонтрагентПоРеквизиту(ИмяРеквизита, ЗначениеРеквизита) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
		Возврат Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;
	ТекстУсловия = "";
	ТекстЗапроса = "Выбрать Первые 1
					|Контрагенты.Ссылка Как Ссылка
					|ИЗ
					|Справочник.Контрагенты Как Контрагенты";
	Если Метаданные.Справочники.ЮридическиеЛица.Реквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
		ТекстЗапроса = ТекстЗапроса + "
					|Левое Соединение Справочник.ЮридическиеЛица КАК ЮридическиеЛица
					|По Контрагенты.ЮридическоеФизическоеЛицо = ЮридическиеЛица.Ссылка";
		ТекстУсловия = "ЮридическиеЛица."+ИмяРеквизита+" = &ЗначениеРеквизита";
	КонецЕсли;
	Если Метаданные.Справочники.ФизическиеЛица.Реквизиты.Найти(ИмяРеквизита) <> Неопределено Тогда
		ТекстЗапроса = ТекстЗапроса + "
					|Левое Соединение Справочник.ФизическиеЛица КАК ФизическиеЛица
					|По Контрагенты.ЮридическоеФизическоеЛицо = ФизическиеЛица.Ссылка";
		ТекстУсловия = ТекстУсловия + ?(ПустаяСтрока(ТекстУсловия), "", " или ")+"ФизическиеЛица."+ИмяРеквизита+" = &ЗначениеРеквизита";
	КонецЕсли;
	Если ПустаяСтрока(ТекстУсловия) Тогда
		Возврат Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса+"
							|Где "+ТекстУсловия);
	Запрос.УстановитьПараметр("ЗначениеРеквизита",	ЗначениеРеквизита);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Ссылка;
	
КонецФункции

// Процедура записывает номер бюджетного обязательства присвоенный ОФК, формат - выписка из лицевого счета ПБС  
// Параметры: ПринятоеБО - структура, создается с предопределенными полями в настройках формата 
Процедура ЗаписатьНомерБюджетногоОбязательства(ПринятоеБО) ЭКСПОРТ
	Если ТипЗнч(ПринятоеБО) <> Тип("Соответствие") тогда
		Возврат;
	КонецЕсли;
	СписокНеобходимыхРеквизитов = Новый Структура("НомерСсылкаБО,ДатаБО,ИДОФКБО,НомерОФКБО,СуммаБО,Сумма1БО,Сумма2БО");
	Для каждого Реквизит из СписокНеобходимыхРеквизитов цикл
		Если ПринятоеБО.Получить(Реквизит.Ключ) = НЕопределено тогда
			Возврат;
		КонецЕсли;	
	КонецЦикла;	
	Если ТипЗнч(ПринятоеБО.Получить("НомерСсылкаБО")) = Тип("Строка") и не ПустаяСтрока(ПринятоеБО.Получить("НомерСсылкаБО")) тогда
	    ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                   |	РегистрацияОбязательствИСведенийПоДоговорам.Договор
	                   |ИЗ
	                   |	Документ.РегистрацияОбязательствИСведенийПоДоговорам КАК РегистрацияОбязательствИСведенийПоДоговорам
	                   |ГДЕ
	                   |	РегистрацияОбязательствИСведенийПоДоговорам.Номер = &Номер
	                   |	И НАЧАЛОПЕРИОДА(РегистрацияОбязательствИСведенийПоДоговорам.Дата, ДЕНЬ) = &Дата
	                   |	И НЕ РегистрацияОбязательствИСведенийПоДоговорам.Договор В
	                   |				(ВЫБРАТЬ
	                   |					УНО.Обязательство
	                   |				ИЗ
	                   |					РегистрСведений.УчетныеНомераОбязательств КАК УНО)";
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Номер",ПринятоеБО.Получить("НомерСсылкаБО"));
		Запрос.УстановитьПараметр("Дата",ПринятоеБО.Получить("ДатаБО"));
//		Запрос.УстановитьПараметр("НомерОбязательства","");
		Результат = Запрос.Выполнить().Выбрать();
		Пока Результат.Следующий() цикл
			Запись = РегистрыСведений.УчетныеНомераОбязательств.СоздатьМенеджерЗаписи();
			Запись.Обязательство 	= Результат.Договор;
			Запись.УчетныйНомерОбязательства = ПринятоеБО.Получить("НомерОФКБО");
			Запись.Записать();
		КонецЦикла;	
	ИначеЕсли 	Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(ПринятоеБО.Получить("НомерСсылкаБО"))) тогда
		РеквизитыРегистрации = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(ПринятоеБО.Получить("НомерСсылкаБО"));
		Если ЗначениеЗаполнено(РеквизитыРегистрации.НомерОбязательства) тогда
			// Если ошибочно нашли документ у которого уже есть номер обязательства или в файле выписки что-то не так.
			Возврат;
		КонецЕсли;	
		Запись = РегистрыСведений.СостояниеПлатежноРасчетныхДокументов.СоздатьМенеджерЗаписи();
		Запись.ПлатежноРасчетныйДокумент 	= ПринятоеБО.Получить("НомерСсылкаБО");
		Для каждого Ресурс из Метаданные.РегистрыСведений.СостояниеПлатежноРасчетныхДокументов.Ресурсы цикл
			Попытка
				Запись[Ресурс.Имя]	= РеквизитыРегистрации[Ресурс.Имя];
			Исключение
			КонецПопытки;	
		КонецЦикла;
		Запись.ПервичныйОбразИРеквизиты = РеквизитыРегистрации.ПервичныйОбразИРеквизиты;
		Запись.НомерОбязательства = ПринятоеБО.Получить("НомерОФКБО");
		Запись.Записать();
		
	КонецЕсли;
КОнецПРоцедуры	

// Процедура записывает номер денежного обязательства присвоенный ОФК, формат - выписка из лицевого счета ПБС  
// Параметры: ПринятоеДО - структура, создается с предопределенными полями в настройках формата 
Процедура ЗаписатьНомерДенежногоОбязательства(ПринятоеДО, Организация, Казначейство) ЭКСПОРТ
	
	Если ТипЗнч(ПринятоеДО) <> Тип("Соответствие") тогда
		Возврат;
	КонецЕсли;
	
	СписокНеобходимыхРеквизитов = Новый Структура("НомерДокДО, ДатаДокДО, УчНомерДО");
	
	Для каждого Реквизит из СписокНеобходимыхРеквизитов цикл
		Если Не ЗначениеЗаполнено(ПринятоеДО.Получить(Реквизит.Ключ)) Тогда
			Возврат;
		КонецЕсли;	
	КонецЦикла;	
	
	НомерДО = ПринятоеДО.Получить("НомерДокДО");
	ДатаДО  = ПринятоеДО.Получить("ДатаДокДО");
	
    ТекстЗапроса = "ВЫБРАТЬ
				   |    СведенияОДенежномОбязательстве.Ссылка КАК СведенияДО
                   |ИЗ
                   |	Документ.СведенияОДенежномОбязательстве КАК СведенияОДенежномОбязательстве
                   |ГДЕ
                   |  ((СведенияОДенежномОбязательстве.Номер                       = &Номер) ИЛИ (СведенияОДенежномОбязательстве.Номер = &ПолныйНомер))
                   |	И СведенияОДенежномОбязательстве.Дата                     >= &ДатаНач 
				   |	И СведенияОДенежномОбязательстве.Дата                     <= &ДатаКон
                   |	И СведенияОДенежномОбязательстве.Организация               = &Организация
                   |	И СведенияОДенежномОбязательстве.ОрганКазначейства         = &Казначейство";
				   
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Номер",          НомерДО);
	Запрос.УстановитьПараметр("ПолныйНомер",    ВосстановитьНомерДляИБ(Организация, НомерДО, "СведенияОДенежномОбязательстве"));
	Запрос.УстановитьПараметр("ДатаНач",        НачалоДня(ДатаДО));
	Запрос.УстановитьПараметр("ДатаКон",        КонецДня(ДатаДО));
	Запрос.УстановитьПараметр("Организация",    Организация);
	Запрос.УстановитьПараметр("Казначейство",   Казначейство);

	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		СДО              = Результат.СведенияДО.ПолучитьОбъект();
		СДО.УчетныйНомер = ПринятоеДО.Получить("УчНомерДО");
		СДО.Записать();
	КонецЕсли;	 
	
КонецПроцедуры

// Функция получает уникальный идентификатор документа "Сведения о принятом бюджетном обязательстве"
// Идентификатор необходимо получить и записать в поле формата в случае если документ "Сведения о принятом бюджетном обязательстве" и докумен ЗКР
// по по договору указанному в сведениях одинаковый и удаговора нет номера бюджетного обязательства.
// Другими словами заявка на оплату обязательства отправляется в казначейство одновременно со сведениями о регистрации обязательства ПБС.
// Данная операция корректно отрабатывается если ЗКР и сведения отправляются одним документом "Задание на экспорт"
//
// Параметры:
//		ТаблицаВыгрузки 	- табличная часть объектов экспорта из документа "Задание на экспорт"
//		Договор 			- реквизит объекта ЗКР или Сведений 
//		НомерОбязательства  - контрольный параметр на выполнение функции
//		Объект				- обрабатывемый объект 
Функция УникальныйИдентификаторПринятогоБО(Задание, Договор, НомерОбязательства, ЛицевойСчет, Объект) экспорт
	Если не ЗначениеЗаполнено(НомерОбязательства) и ЗначениеЗаполнено(Договор)	тогда 
		ТекстЗапроса = "ВЫБРАТЬ
		               |	Задание.Объект КАК Объект
		               |ПОМЕСТИТЬ Сведения
		               |ИЗ
		               |	Документ.ЗаданиеНаЭкспортДанныхВБанкиКС.ОбъектыОбмена КАК Задание
		               |ГДЕ
		               |	ВЫБОР
		               |			КОГДА ТИПЗНАЧЕНИЯ(Задание.Объект) = ТИП(Документ.РегистрацияОбязательствИСведенийПоДоговорам)
		               |				ТОГДА ИСТИНА
		               |			ИНАЧЕ ЛОЖЬ
		               |		КОНЕЦ
		               |	И Задание.Ссылка = &Задание
					   |;					   
					   |";
		Если ТипЗнч(Объект) = Тип("ДокументСсылка.РегистрацияОбязательствИСведенийПоДоговорам") тогда		   
			// 	Порверка при вызове функции из документа "Сведения о принятом БО", на то что в пакете есть документ ЗКР
			//  если функция вызвается из ЗКР надобность в такой проверке отпадает.
			ТекстЗапроса = ТекстЗапроса +"
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	Задание.Объект
		               |ПОМЕСТИТЬ ЗКР
		               |ИЗ
		               |	Документ.ЗаданиеНаЭкспортДанныхВБанкиКС.ОбъектыОбмена КАК Задание
		               |ГДЕ
		               |	ВЫБОР
		               |			КОГДА ТИПЗНАЧЕНИЯ(Задание.Объект) = ТИП(Документ.ЗаявкаНаКассовыйРасход)
		               |				ТОГДА ИСТИНА
		               |			ИНАЧЕ ЛОЖЬ
		               |		КОНЕЦ
					   |	И Задание.Ссылка = &Задание
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	Задание.Объект
		               |ПОМЕСТИТЬ ЗКРСокращенная
		               |ИЗ
		               |	Документ.ЗаданиеНаЭкспортДанныхВБанкиКС.ОбъектыОбмена КАК Задание
		               |ГДЕ
		               |	ВЫБОР
		               |			КОГДА ТИПЗНАЧЕНИЯ(Задание.Объект) = ТИП(Документ.ЗаявкаНаКассовыйРасходСокращенная)
		               |				ТОГДА ИСТИНА
		               |			ИНАЧЕ ЛОЖЬ
		               |		КОНЕЦ
					   |	И Задание.Ссылка = &Задание
		               |;";
		КонецЕсли;			   
		ТекстЗапроса = ТекстЗапроса +"					   
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	Сведения.Объект
		               |ИЗ
		               |	Сведения КАК Сведения
		               |ГДЕ
		               |	ВЫРАЗИТЬ(Сведения.Объект КАК Документ.РегистрацияОбязательствИСведенийПоДоговорам).Договор = &Договор
		               |	И ВЫРАЗИТЬ(Сведения.Объект КАК Документ.РегистрацияОбязательствИСведенийПоДоговорам).ВидОбязательства = ЗНАЧЕНИЕ(Перечисление.ВидыПринятыхОбязательств.ПринятоеОбязательствоУчетПредмета)					   
		               |	И НЕ ВЫРАЗИТЬ(Сведения.Объект КАК Документ.РегистрацияОбязательствИСведенийПоДоговорам).Договор В 
		               |				(ВЫБРАТЬ
		               |					УчетныеНомера.Обязательство КАК Обязательство
		               |				ИЗ
		               |					РегистрСведений.УчетныеНомераОбязательств КАК УчетныеНомера
					   |				ГДЕ УчетныеНомера.Обязательство = &Договор)
					   |	И ВЫРАЗИТЬ(Сведения.Объект КАК Документ.РегистрацияОбязательствИСведенийПоДоговорам).ЛицевойСчет = &ЛицевойСчет";
		Если ТипЗнч(Объект) = Тип("ДокументСсылка.РегистрацияОбязательствИСведенийПоДоговорам") тогда		   
			// 	Порверка при вызове функции из документа "Сведения о принятом БО", на то что в пакет есть документ ЗКР
			//  если функция вызвается из ЗКР надобность в такой проверке отпадает.
			ТекстЗапроса = ТекстЗапроса +"
			           |    И Сведения.Объект = &ОбъектСсылка    
		               |	И (ВЫРАЗИТЬ(Сведения.Объект КАК Документ.РегистрацияОбязательствИСведенийПоДоговорам).Договор В
		               |				(ВЫБРАТЬ
		               |					ВЫРАЗИТЬ(ЗКР.Объект КАК Документ.ЗаявкаНаКассовыйРасход).Договор
		               |				ИЗ
		               |					ЗКР
					   |				ГДЕ ВЫРАЗИТЬ(ЗКР.Объект КАК Документ.ЗаявкаНаКассовыйРасход).ЛицевойСчет = &ЛицевойСчет)
		               |			ИЛИ ВЫРАЗИТЬ(Сведения.Объект КАК Документ.РегистрацияОбязательствИСведенийПоДоговорам).Договор В
		               |				(ВЫБРАТЬ
		               |					ВЫРАЗИТЬ(ЗКРСокращенная.Объект КАК Документ.ЗаявкаНаКассовыйРасходСокращенная).Договор
		               |				ИЗ
		               |					ЗКРСокращенная
					   |				ГДЕ ВЫРАЗИТЬ(ЗКРСокращенная.Объект КАК Документ.ЗаявкаНаКассовыйРасходСокращенная).ЛицевойСчет = &ЛицевойСчет))";
		КонецЕсли;			   
					   
		Запрос = Новый Запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("Договор",Договор);
		Запрос.УстановитьПараметр("ЛицевойСчет",ЛицевойСчет);
		Запрос.УстановитьПараметр("ОбъектСсылка",Объект.Ссылка);
		Запрос.УстановитьПараметр("Задание",Задание.Ссылка);
		РезультатЗапроса = Запрос.Выполнить().Выбрать();
		Пока РезультатЗапроса.Следующий() Цикл
			Возврат РезультатЗапроса["Объект"].Ссылка.УникальныйИдентификатор();
		КонецЦикла;	
	КонецЕсли;				   
	Возврат "";
КонецФункции	

Функция НомерСтрокиВЗаданииНаЭкспорт(Задание, Объект) экспорт
	ТЧЗадания = БиблиотекаФункцийОбменаПовтИсп.ПолучитьТабличнуюЧастьЗадания(Задание);
	НайденнаяСтрока = ТЧЗадания.Найти(Объект.Ссылка,"Объект");
	Если НайденнаяСтрока <> Неопределено Тогда
		Возврат НайденнаяСтрока.НомерСтроки;
	КонецЕсли;	
	Возврат "";	
КонецФункции	

Функция СоздатьСхемуПроверкиИменФайлов(МассивИменФайлов, ТипОбмена, Организация = Неопределено) Экспорт

	СхемаФормирования = Новый СхемаКомпоновкиДанных;
	ИсточникДанных = СхемаФормирования.ИсточникиДанных.Добавить();
	ИсточникДанных.Имя 					= "ИсточникДанных1";
	ИсточникДанных.ТипИсточникаДанных	= "Local";
	
	НаборДанных = СхемаФормирования.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
	НаборДанных.Имя 			= "ИменаФайлов";
	НаборДанных.ИмяОбъекта		= "ИменаФайлов";
	НаборДанных.ИсточникДанных 	= "ИсточникДанных1";
	
	ПолеНабора = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
	ПолеНабора.ПутьКДанным 	= "ИмяФайла";
	ПолеНабора.Поле			= "ИмяФайла";
	
	ТекГруппировка = СхемаФормирования.НастройкиПоУмолчанию.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ТекГруппировка.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	ОбщийМодульСКД.ДобавитьПолеГруппировкиКомпоновкиДанных(ТекГруппировка, "ИмяФайла");
	ТекГруппировка.ПараметрыВывода.УстановитьЗначениеПараметра("РасположениеИтогов", РасположениеИтоговКомпоновкиДанных.Нет);
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ТипыОбменаБанкиКСИмяФайлаПередачи.Ссылка,
	                      |	ТипыОбменаБанкиКСИмяФайлаПередачи.НомерСтроки КАК НомерСтроки,
	                      |	ТипыОбменаБанкиКСИмяФайлаПередачи.ИмяПараметра,
	                      |	ТипыОбменаБанкиКСИмяФайлаПередачи.ДлинаПараметра,  
						  |	ТипыОбменаБанкиКСИмяФайлаПередачи.ДлинаПараметраУсловная,
	                      |	ТипыОбменаБанкиКСИмяФайлаПередачи.Значение,
	                      |	ТипыОбменаБанкиКСИмяФайлаПередачи.Соответствие КАК ПроверяемаяКолонка
	                      |ИЗ
	                      |	Справочник.ТипыОбменаБанкиКС.ИмяФайлаПередачи КАК ТипыОбменаБанкиКСИмяФайлаПередачи
	                      |ГДЕ
	                      |	ТипыОбменаБанкиКСИмяФайлаПередачи.Ссылка = &ТипОбмена
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	НомерСтроки");

	Запрос.УстановитьПараметр("ТипОбмена", ТипОбмена);						  
	Выборка = Запрос.Выполнить().Выбрать();
	
	ДеньЗагрузки  = "";
	МесяцЗагрузки = "";
	РеквизитыДокумента = БухгалтерскийУчетПовтИсп.ПолучитьМассивРеквизитовОбъекта("Документы", "ЗаданиеНаИмпортДанныхБанкиКС");
	Для Счетчик=0 По РеквизитыДокумента.ВГраница() Цикл
		РеквизитыДокумента[Счетчик] = ВРЕГ(РеквизитыДокумента[Счетчик]);
	КонецЦикла;
	ТекПозицияСтр  = "0";
	СчетчикПолей   = 0;
	ПараметрыСхемы = Новый Соответствие;
	
	РазрешенныеОбщиеМодули 	= ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ВРЕГ("БиблиотекаФункцийОбмена"));
	ЗаменяемыеСлова			= ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ВРЕГ("Значение"));
	ЗаменяющиеСлова			= ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ВРЕГ("<ЗНАЧЕНИЕ>"));
	
	Пока Выборка.Следующий() Цикл  
		
		ДлинаПараметра = ?(ЗначениеЗаполнено(Выборка.ДлинаПараметраУсловная), Выборка.ДлинаПараметраУсловная, Строка(Выборка.ДлинаПараметра));
		
		Если ПустаяСтрока(Выборка.ПроверяемаяКолонка) Тогда
			ТекПозицияСтр = ТекПозицияСтр + " + " + Строка(Выборка.ДлинаПараметра);
			Продолжить;
		КонецЕсли;    
						
		ИспользованныеИменаРеквизитов = Новый Массив;
		ВыражениеПоля = ОбщийМодульСКД.ПреобразоватьВыражениеСКД(Выборка.ПроверяемаяКолонка, РазрешенныеОбщиеМодули, ЗаменяемыеСлова, ЗаменяющиеСлова, ИспользованныеИменаРеквизитов);
		Если ВРЕГ(Выборка.ПроверяемаяКолонка) = ВРЕГ("СвободныеПараметры.День") Тогда
			ДеньЗагрузки = "Подстрока(ИмяФайла, "+(ТекПозицияСтр + " + 1") + ", " + (ДлинаПараметра) + ")";	
		ИначеЕсли ВРЕГ(Выборка.ПроверяемаяКолонка) = ВРЕГ("СвободныеПараметры.Месяц") Тогда
			МесяцЗагрузки = "Подстрока(ИмяФайла, "+(ТекПозицияСтр  + " + 1") + ", " + (ДлинаПараметра) + ")";	
		Иначе
			
			Если Найти(ВыражениеПоля, "<ЗНАЧЕНИЕ>")>0 Тогда
				ВыражениеПоля = СтрЗаменить(ВыражениеПоля, "<ЗНАЧЕНИЕ>", "Подстрока(ИмяФайла, "+(ТекПозицияСтр  + " + 1") + ", " + (ДлинаПараметра) + ")");
			Иначе				
				ВыражениеПоля = "Подстрока(ИмяФайла, "+(ТекПозицияСтр  + " + 1") + ", " + (ДлинаПараметра) + ") = " + ВыражениеПоля;
			КонецЕсли;
			
			Для каждого ТекИмяРеквизита Из ИспользованныеИменаРеквизитов Цикл
				
				ТекИмяПараметра = ПараметрыСхемы[ТекИмяРеквизита];
				Если ТекИмяПараметра = Неопределено Тогда
					ТекИмяПараметра = "П"+ПараметрыСхемы.Количество();
					ПараметрыСхемы.Вставить(ТекИмяРеквизита, ТекИмяПараметра);
				КонецЕсли;
				ВыражениеПоля = СтрЗаменить(ВыражениеПоля, ТекИмяРеквизита, "&"+ТекИмяПараметра);				
			
			КонецЦикла; 
			
			СчетчикПолей = СчетчикПолей+1;
			ВычисляемоеПоле = СхемаФормирования.ВычисляемыеПоля.Добавить();
			ВычисляемоеПоле.ПутьКДанным = "Условие"+СчетчикПолей;
			ВычисляемоеПоле.Выражение = ВыражениеПоля;
			
			//Если НЕ Выборка.НеИспользовать Тогда
			
				ЭлементОтбора = СхемаФормирования.НастройкиПоУмолчанию.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
				ЭлементОтбора.ЛевоеЗначение		= Новый ПолеКомпоновкиДанных(ВычисляемоеПоле.ПутьКДанным);
				ЭлементОтбора.ПравоеЗначение 	= Истина;
				ЭлементОтбора.Использование 	= Истина;
			
			//КонецЕсли;
			
			ОбщийМодульСКД.ДобавитьПолеГруппировкиКомпоновкиДанных(ТекГруппировка, ВычисляемоеПоле.ПутьКДанным);
			
		КонецЕсли;
			
		ТекПозицияСтр = ТекПозицияСтр +  " + " + ДлинаПараметра;
		
	КонецЦикла;
	
	Если НЕ ПустаяСтрока(ДеньЗагрузки) И НЕ ПустаяСтрока(МесяцЗагрузки) Тогда
		// для проверки попадания в период используется функция ДеньИМесяцВПериоде(День, Месяц, ДатаОт, ДатаПо)
		РезультирующееВыражение = "БиблиотекаФункцийОбмена.ДеньИМесяцВПериоде("+ДеньЗагрузки+", "+МесяцЗагрузки+", &ДатаОт, &ДатаПо)";
		
		СчетчикПолей = СчетчикПолей+1;
		ВычисляемоеПоле = СхемаФормирования.ВычисляемыеПоля.Добавить();
		ВычисляемоеПоле.ПутьКДанным = "Условие"+СчетчикПолей;
		ВычисляемоеПоле.Выражение = РезультирующееВыражение;
		
		ЭлементОтбора = СхемаФормирования.НастройкиПоУмолчанию.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ВычисляемоеПоле.ПутьКДанным);
		ЭлементОтбора.ПравоеЗначение = Истина;
		ЭлементОтбора.Использование = Истина;
		
		ОбщийМодульСКД.ДобавитьПолеГруппировкиКомпоновкиДанных(ТекГруппировка, ВычисляемоеПоле.ПутьКДанным);		
		
		ПараметрСхемы = СхемаФормирования.Параметры.Добавить();
		ПараметрСхемы.Имя="ДатаОт";
		ПараметрСхемы.ТипЗначения = Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты(ЧастиДаты.Дата));
		ПараметрСхемы.Выражение = "&ДатаОт = НачалоПериода(&ДатаОт, ""День"")";
		ПараметрСхемы.ОграничениеИспользования = Истина;
		
		ПараметрСхемы = СхемаФормирования.Параметры.Добавить();
		ПараметрСхемы.Имя="ДатаПо";
		ПараметрСхемы.ТипЗначения = Новый ОписаниеТипов("Дата", Новый КвалификаторыДаты(ЧастиДаты.Дата));
		ПараметрСхемы.Выражение = "&ДатаПо = КонецПериода(&ДатаПо, ""День"")";
		ПараметрСхемы.ОграничениеИспользования = Истина;
	КонецЕсли;
	
	Для каждого ТекПараметр Из ПараметрыСхемы Цикл
	
		ПараметрСхемы                          = СхемаФормирования.Параметры.Добавить();
		ПараметрСхемы.Имя                      = ТекПараметр.Значение;
		ПараметрСхемы.ОграничениеИспользования = Истина;
		ПараметрСхемы.Заголовок                = ТекПараметр.Ключ;
	
	КонецЦикла; 
	
	ПараметрСхемы                          = СхемаФормирования.Параметры.Добавить();
	ПараметрСхемы.Имя                      = "Задание";
	ПараметрСхемы.ОграничениеИспользования = Истина;
	ПараметрСхемы.Заголовок                = "Задание";
	ПараметрСхемы.ДоступенСписокЗначений   = Ложь;        
	
	ПараметрСхемы                          = СхемаФормирования.Параметры.Добавить();
	ПараметрСхемы.Имя                      = "КодПоРПБС";
	ПараметрСхемы.ОграничениеИспользования = Истина;
	ПараметрСхемы.Заголовок                = "КодПоРПБС";
	ПараметрСхемы.ДоступенСписокЗначений   = Ложь;   
	
	Если СхемаФормирования.Параметры.Найти("ДатаОт") = Неопределено Тогда 
		ПараметрСхемы                          = СхемаФормирования.Параметры.Добавить();
		ПараметрСхемы.Имя                      = "ДатаОт";
		ПараметрСхемы.ОграничениеИспользования = Истина;
		ПараметрСхемы.Заголовок                = "ДатаОт";
		ПараметрСхемы.ДоступенСписокЗначений   = Ложь;   
	КонецЕсли;
	
	Если СхемаФормирования.Параметры.Найти("ДатаПо") = Неопределено Тогда
		ПараметрСхемы                          = СхемаФормирования.Параметры.Добавить();
		ПараметрСхемы.Имя                      = "ДатаПо";
		ПараметрСхемы.ОграничениеИспользования = Истина;
		ПараметрСхемы.Заголовок                = "ДатаПо";
		ПараметрСхемы.ДоступенСписокЗначений   = Ложь;  
	КонецЕсли;	
	
	Возврат СхемаФормирования;
	
КонецФункции // СоздатьСхемуПроверкиИменФайлов()

Функция ПроверитьМассивФайловПоПравилу(МассивИменФайлов, СхемаПроверки, ДокументЗадание) Экспорт
	
	Для каждого ТекПараметр Из СхемаПроверки.Параметры Цикл
	
		Если ТекПараметр.Имя = "ДатаОт" Тогда
			ТекПараметр.Значение = ДокументЗадание.ДатаНач;
		ИначеЕсли ТекПараметр.Имя = "ДатаПо" Тогда
			ТекПараметр.Значение = ДокументЗадание.ДатаКон;
		ИначеЕсли ТекПараметр.Имя = "Задание" Тогда
	        ТекПараметр.Значение = ДокументЗадание.Ссылка; 
		ИначеЕсли ТекПараметр.Имя = "КодПоРПБС" Тогда
	        ТекПараметр.Значение = ДокументЗадание.Организация.КодПоРПБС;	
		Иначе
			ТекПараметр.Значение = ЗначениеРеквизита(ДокументЗадание, ТекПараметр.Заголовок);
		КонецЕсли;
	
	КонецЦикла; 
	
	ИсточникиДанных = Новый Структура;
	ИсточникиДанных.Вставить("ИменаФайлов", Новый ТаблицаЗначений);
	ИсточникиДанных.ИменаФайлов.Колонки.Добавить("ИмяФайла", Новый ОписаниеТипов("Строка"));
	Для каждого ТекИмяФайла Из МассивИменФайлов Цикл
	
		ИсточникиДанных.ИменаФайлов.Добавить().ИмяФайла = ТекИмяФайла;	
	
	КонецЦикла; 
	
	Результат                         = Новый Массив;
	НастройкиСхемы                    = СхемаПроверки.НастройкиПоУмолчанию;
	
	КомпоновщикМакета                 = Новый КомпоновщикМакетаКомпоновкиДанных;
		
	МакетКомпоновки                   = КомпоновщикМакета.Выполнить(СхемаПроверки, НастройкиСхемы,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	ПроцессорКомпоновкиДанных         = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, ИсточникиДанных, ,Истина);
	ПроцессорВывода                   = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	Возврат ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных).ВыгрузитьКолонку("ИмяФайла");
	
КонецФункции

Функция ЗначениеРеквизита(Знач Элемент, Знач ИмяРеквизита) Экспорт
	Если ИмяРеквизита<>"" И (ТипЗнч(Элемент) = Тип("ДанныеФормыСтруктура") ИЛИ ЗначениеЗаполнено(Элемент)) Тогда
		ИмяРеквизита = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ИмяРеквизита, ".");
		Для каждого ТекИмяРеквизита Из ИмяРеквизита Цикл
			Если ТипЗнч(Элемент) = Тип("ДанныеФормыСтруктура") Тогда
				Элемент = Элемент[ТекИмяРеквизита];
			Иначе
				Элемент =  ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Элемент, ТекИмяРеквизита);//Элемент[ТекИмяРеквизита];
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ИмяРеквизита = "Наименование" Тогда
		Элемент = "";
	КонецЕсли;	
	Возврат Элемент;
КонецФункции

Функция ДеньИМесяцВПериоде(Знач День, Знач Месяц, ДатаОт, ДатаДо) Экспорт
	День = ПереводВДесятичнуюСистему(День, 36);
	
	Если ТипЗнч(День) <> Тип("Число") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Месяц = ПереводВДесятичнуюСистему(Месяц, 36);
	
	Если ТипЗнч(Месяц) <> Тип("Число") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Месяц > 12 Тогда
		Месяц = Месяц - 12;
	КонецЕсли;
	
	ЧислоДатаФайла = Месяц*100 + День;
	ЧислоДатаДо    = Месяц(ДатаДо)*100*(?(Год(ДатаОт)<Год(ДатаДо), 100, 1)) + День(ДатаДо);
	ЧислоДатаОт    = Месяц(ДатаОт)*100 + День(ДатаОт);

	Если (ЧислоДатаФайла >= ЧислоДатаОт) И (ЧислоДатаФайла <= ЧислоДатаДо) Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Функция СтрокаВЧисло(Знач Значение) Экспорт
	Если Значение = "" ИЛИ Значение=Неопределено Или Значение=NULL Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Если ТипЗнч(Значение) = Тип("Строка") Тогда
			Значение = СтрЗаменить(Значение, " ", "");
			Значение = СтрЗаменить(Значение, ",", ".");
		КонецЕсли;
		Возврат Число(Значение);
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

Функция СвойствоСтруктуры(Структура, Свойство)
	Перем Результат;		
	
	Если НЕ Структура.Свойство(Свойство, Результат) Тогда
		Результат = "";
	КонецЕсли;
	Возврат Результат;
	
КонецФункции

Функция ПрерватьЗагрузкуФайла(ТекстСообщения,
	Знач Параметр1,	Знач Параметр2 = Неопределено, Знач Параметр3 = Неопределено,
	Знач Параметр4 = Неопределено, Знач Параметр5 = Неопределено, Знач Параметр6 = Неопределено,
	Знач Параметр7 = Неопределено, Знач Параметр8 = Неопределено, Знач Параметр9 = Неопределено) Экспорт
	
	СтрокаИсключения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
																				Параметр1, Параметр2, Параметр3,
																				Параметр4, Параметр5, Параметр6,
																				Параметр7, Параметр8, Параметр9);
	ВызватьИсключение СтрокаИсключения;																				
КонецФункции

//  Функция получения реквизита шапки регламетированного отчета, только для отчета "Сведения о целевых субсидиях" и "Перечень целевых субсидий" (0501016, 0501015)
Функция УниверсальныйРегламентированныйОтчетПараметрыОтчета(ОбъектСсылка = Неопределено, ИмяЗапрашиваемогоПараметра)     ЭКСПОРТ
	
	Если НЕ ЗначениеЗаполнено(ИмяЗапрашиваемогоПараметра) Тогда
		Возврат "";
	КонецЕсли;
	
	Запрос       = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", 				ОбъектСсылка);
	Запрос.УстановитьПараметр("Код", 					ИмяЗапрашиваемогоПараметра);
	Запрос.Текст = "ВЫБРАТЬ
	               |	УниверсальныйРегламентированныйОтчетПараметрыОтчета.Значение КАК Значение
	               |ИЗ
	               |	Документ.УниверсальныйРегламентированныйОтчет.ПараметрыОтчета КАК УниверсальныйРегламентированныйОтчетПараметрыОтчета
	               |ГДЕ
	               |	УниверсальныйРегламентированныйОтчетПараметрыОтчета.Ссылка = &Ссылка
	               |	И УниверсальныйРегламентированныйОтчетПараметрыОтчета.Код = &Код
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ЗначенияДополнительныхРеквизитовОтчета.Значение
	               |ИЗ
	               |	РегистрСведений.ЗначенияДополнительныхРеквизитовОтчета КАК ЗначенияДополнительныхРеквизитовОтчета
	               |ГДЕ
	               |	ЗначенияДополнительныхРеквизитовОтчета.ЭкземплярОтчета = &Ссылка
	               |	И ЗначенияДополнительныхРеквизитовОтчета.ДополнительныйРеквизитОтчета.Код = &Код";
		
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда
		Возврат РезультатЗапроса.Значение;
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

//  Функция получения данных ячейки регламетированного отчета, только для отчета "Сведения о целевых субсидиях"
Функция УниверсальныйРегламентированныйОтчетПараметрыЯчеек(ОбъектСсылка = Неопределено, ИмяЗапрашиваемогоПараметра)     ЭКСПОРТ
	
	Если НЕ ЗначениеЗаполнено(ИмяЗапрашиваемогоПараметра) или НЕ ЗначениеЗаполнено(ОбъектСсылка) тогда
		Возврат "";
	КонецЕсли;
	
	ДокументОбъект = ОбъектСсылка.ПолучитьОбъект();
	ДокументОбъект.ИнициализироватьКонтекст();
	Если ДокументОбъект.Показатели.Свойство(ИмяЗапрашиваемогоПараметра) тогда
		Возврат ДокументОбъект.Показатели[ИмяЗапрашиваемогоПараметра];
	ИНаче
		Возврат "";
	КонецЕсли;
КонецФункции

// Возвращает контактное лицо организации с указанной ролью
//
// Параметры
//  Организация  - Справочник.Организации.
//                 организационная единица для которой определяется физлицо
//  Роль		 - Строка.
//                 Имя значения перечисления ОтветственныеЛицаОрганизаций
//
// Возвращаемое значение:
//   Справочник.Сотрудники
//
Функция ОтветственноеЛицоОрганизации(Организация, Роль, Дата = Неопределено) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОтветственныеЛицаОрганизацийСрезПоследних.ОтветственноеЛицо
	|ИЗ
	|	РегистрСведений.ОтветственныеЛицаОрганизаций.СрезПоследних(
	|			&Дата,
	|			Организация = &Организация
	|				И ВидОтветственногоЛица = &Роль) КАК ОтветственныеЛицаОрганизацийСрезПоследних";
	
	Если Дата = Неопределено Тогда
		Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Организация"	,Организация);
	Запрос.УстановитьПараметр("Роль"		,Перечисления.ОтветственныеЛицаОрганизаций[Роль]);
	Запрос.УстановитьПараметр("Дата"		,КонецДня(Дата));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ОтветственноеЛицо;
	Иначе
		Возврат Справочники.Сотрудники.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

//   Процедура возвращает должность сотрудника 
//   Входящие параметры:  Сотрудник - ссылка справочника сотрудники
//						  Дата - дата, дана на которую нужно получить должность
//   
Функция ПолучитьДолжностьСотрудника(Сотрудник, Дата) Экспорт
	
	Если ЗначениеЗаполнено(Сотрудник) Тогда
		
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Должность", Сотрудник, Дата);	
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника);
		Должность        = ДанныеСотрудника.Должность;
		
	КонецЕсли;
	
	Возврат Должность;
	
КонецФункции


Функция ПолучитьНаименованиеСУчетомИФО(Организация,ИФО=Неопределено) Экспорт
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") И ЗначениеЗаполнено(ИФО) Тогда
		Если ИФО.ИспользоватьРеквизитыИФО Тогда
			Возврат ЗначениеРеквизита(ИФО,"КодПоППП.НаименованиеПолное");
		КонецЕсли;
	КонецЕсли;
	ТекОрг = ОбщегоНазначенияБГУ.ГоловнаяОрганизация(Организация);
	Возврат ЗначениеРеквизита(ТекОрг,"КодПоППП.НаименованиеПолное");	
КонецФункции     

//определить сотрудника по ФИО и организации, к которой он принадлежит
Функция ПолучитьСотрудникаПоФИО(ФИО, Организация = "") Экспорт
	
	ПустаяСсылка = Справочники.Сотрудники.ПустаяСсылка();
	
	Если НЕ ЗначениеЗаполнено(ФИО) Тогда
		Возврат ПустаяСсылка;
	КонецЕсли;	
	
	Запрос = Новый Запрос;  	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	Сотрудники.Ссылка
	               |ИЗ
	               |	Справочник.Сотрудники КАК Сотрудники
	               |ГДЕ
	               |	Сотрудники.Наименование = &ФИО";
	
				   Если ЗначениеЗаполнено(Организация) Тогда 
					  	Запрос.Текст = Запрос.Текст +  "
						|	И (Сотрудники.Владелец = &Организация) 		
				        |";  
				   КонецЕсли;		
				   
	Запрос.УстановитьПараметр("ФИО", ФИО);	
	Если ЗначениеЗаполнено(Организация) Тогда 
		 Запрос.УстановитьПараметр("Организация", Организация);
	КонецЕсли;
	 
	Выборка = Запрос.Выполнить().Выбрать(); 
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат ПустаяСсылка;
	КонецЕсли;		
	
КонецФункции	


