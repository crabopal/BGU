// Возвращает ссылку на Раздел лицевой счет с заданными параметрами
//
// Параметры:
// 		ЛицевойСчет				 - ссылка на владельца (элемент справочника "Лицевые счета")
// 		КВД						 - заданное значение КВД (тип:ПеречислениеСсылка.КВД)
// 		ИсточникСредств			 - заданное значение Источника средств (тип: СправочникСсылка.ИсточникиСредств)
/// Возвращаемое значение:
// 		Тип: Либо ссылка на элемент РазделыЛицевыхСчетов, либо пустая строка (в случае неудачного поиска)
Функция ОпределитьРазделЛС(ЛицевойСчет, КВД, ИсточникСредств)     ЭКСПОРТ
	
	Если НЕ ЗначениеЗаполнено(ЛицевойСчет) Тогда
		Возврат "";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЛицевойСчет", 		ЛицевойСчет);
	Запрос.УстановитьПараметр("КВД", 				КВД);
	Запрос.УстановитьПараметр("ИсточникСредств", 	ИсточникСредств);
	
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	РазделыЛицевыхСчетов.Ссылка							КАК РазделЛС
	|ИЗ
	|	Справочник.РазделыЛицевыхСчетов 					КАК РазделыЛицевыхСчетов
	|ГДЕ
	|	РазделыЛицевыхСчетов.Владелец.Ссылка				= &ЛицевойСчет
	//|	И РазделыЛицевыхСчетов.КодВидаДеятельности.Ссылка 	= &КВД
	|	И РазделыЛицевыхСчетов.ИсточникСредств.Ссылка 		= &ИсточникСредств
	|	И РазделыЛицевыхСчетов.ПометкаУдаления 				= Ложь
	|";
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Возврат Результат.РазделЛС;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

//возвращает ссылку на КФО, который указан в разделах лс
//Параметры: 
//          ЛицевойСчет				 - ссылка на владельца (элемент справочника "Лицевые счета")
// если КФО несколько - то возвращает пустое значение

Функция КФОИспользуемыйВЛицевомСчете(ЛицевойСчет) ЭКСПОРТ
	
	Если НЕ ЗначениеЗаполнено(ЛицевойСчет) Тогда
		Возврат "";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЛицевойСчет", 		ЛицевойСчет);
		
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	РазделыЛицевыхСчетов.КФО							КАК КФО
	|ИЗ
	|	Справочник.РазделыЛицевыхСчетов.ДопустимыеКФО 	    КАК РазделыЛицевыхСчетов
	|ГДЕ
	|	РазделыЛицевыхСчетов.Ссылка.Владелец.Ссылка			= &ЛицевойСчет
	|	И РазделыЛицевыхСчетов.Ссылка.ПометкаУдаления 		= Ложь
	|   И РазделыЛицевыхСчетов.КФО                          <> ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка)
	|";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество() = 1 Тогда
		Возврат Результат[0].КФО;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

//возвращает ссылку на Источник средств, который указан в разделах лс
//Параметры: 
//          ЛицевойСчет				 - ссылка на владельца (элемент справочника "Лицевые счета")
