Функция НомерПопорядкуИзмененияГК(Ссылка) Экспорт
	
	Документ     = Ссылка.Основание;
	НппИзменения = 1;
	
	Если НЕ ЗначениеЗаполнено(Документ) Тогда
		 Возврат НппИзменения;
	КонецЕсли;
	
	Пока ЗначениеЗаполнено(Документ.Основание) Цикл
		 Документ     = Документ.Основание;
	     НппИзменения = НппИзменения + 1;
	КонецЦикла;
	 
	Возврат НппИзменения; 
	
КонецФункции

// Получает платежные реквизиты банка 
Функция ПлатежныеРеквизитыБанка(СчетКонтрагента, Реквизит, ВыводитьГород = Ложь) ЭКСПОРТ

	Если НЕ ЗначениеЗаполнено(СчетКонтрагента) Тогда
		Возврат "";
	КонецЕсли;
	
	РеквизитыКонтрагентаПоСчету = Новый Структура("КонтрагентБанковскийСчет, КонтрагентНаименованиеБанка, КонтрагентБИКБанка, КонтрагентКорСчетБанка, Город", "СчетНомер", "Банк", "БИК", "КоррСчет", "Город");
	ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(СчетКонтрагента, СчетКонтрагента, РеквизитыКонтрагентаПоСчету, , ВыводитьГород);	
	
    Результат = "";
	
	Если РеквизитыКонтрагентаПоСчету.Свойство(Реквизит, Результат) Тогда 
		Возврат Результат;
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

Функция ОпределитьРеквизитыЛицевогоСчета(ЛицевойСчет, КассовыйОрган = Неопределено)  ЭКСПОРТ
	
	Если НЕ ЗначениеЗаполнено(ЛицевойСчет) Тогда
		 Возврат "";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка",        ЛицевойСчет); 
	Запрос.УстановитьПараметр("КассовыйОрган", КассовыйОрган); 
	
	Запрос.Текст = "
    |ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РеквизитыЛицевыхСчетов.Ссылка.Ссылка КАК Реквизиты
	|ИЗ
	|	Справочник.РеквизитыЛицевыхСчетов КАК РеквизитыЛицевыхСчетов
	|ГДЕ
	|	РеквизитыЛицевыхСчетов.Владелец.Ссылка = &Ссылка
	|";  
	
	Если ЗначениеЗаполнено(КассовыйОрган) Тогда
		Запрос.Текст = Запрос.Текст + "
    	|   И РеквизитыЛицевыхСчетов.КассовыйОрган = &КассовыйОрган 
		|";	
	КонецЕсли;	
	
    ТаблицаРезультатов = Запрос.Выполнить().Выгрузить();
	
	Если ТаблицаРезультатов.Количество() = 1 Тогда		
		Возврат ТаблицаРезультатов[0].Реквизиты		
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ПлатежныеРеквизитыПолучателя(ЛицевойСчет, РеквизитыЛицевогоСчета, ТребуемыйРеквизит) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ЛицевойСчет)
		ИЛИ НЕ ЗначениеЗаполнено(РеквизитыЛицевогоСчета)
		ИЛИ НЕ ЗначениеЗаполнено(ТребуемыйРеквизит) Тогда
		Возврат "";
	КонецЕсли;
	
	РеквизитыПолучателя = БиблиотекаФункцийОбменаПовтИсп.ПолучитьПлатежныеРеквизитыПолучателя(ЛицевойСчет, РеквизитыЛицевогоСчета);
	
	Результат = "";
	
	Если РеквизитыПолучателя.Свойство(ТребуемыйРеквизит, Результат) Тогда 
		Возврат Результат;
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

// Получает данные контактной информации контрагента
Функция КонтактнаяИнформацияКонтрагента(Контгагент, ВидКИ) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Контрагент", Контгагент);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	КонтрагентыДокументов.Ссылка,
	               |	ЮридическиеЛицаКонтактнаяИнформация.Вид,
	               |	ЮридическиеЛицаКонтактнаяИнформация.Представление,
	               |	ЮридическиеЛицаКонтактнаяИнформация.ЗначенияПолей
	               |ИЗ
	               |	Справочник.Контрагенты КАК КонтрагентыДокументов
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЮридическиеЛица.КонтактнаяИнформация КАК ЮридическиеЛицаКонтактнаяИнформация
	               |		ПО КонтрагентыДокументов.ЮридическоеФизическоеЛицо = ЮридическиеЛицаКонтактнаяИнформация.Ссылка
	               |ГДЕ
	               |	КонтрагентыДокументов.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	               |	И КонтрагентыДокументов.Ссылка = &Контрагент
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	КонтрагентыДокументов.Ссылка,
	               |	ФизическиеЛицаКонтактнаяИнформация.Вид,
	               |	ФизическиеЛицаКонтактнаяИнформация.Представление,
	               |	ФизическиеЛицаКонтактнаяИнформация.ЗначенияПолей
	               |ИЗ
	               |	Справочник.Контрагенты КАК КонтрагентыДокументов
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица.КонтактнаяИнформация КАК ФизическиеЛицаКонтактнаяИнформация
	               |		ПО КонтрагентыДокументов.ЮридическоеФизическоеЛицо = ФизическиеЛицаКонтактнаяИнформация.Ссылка
	               |ГДЕ
	               |	КонтрагентыДокументов.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ФизЛицо)
	               |	И КонтрагентыДокументов.Ссылка = &Контрагент";
	   
	ТаблицаКонтактнойИнформации = Запрос.Выполнить().Выгрузить();
	 
	СтруктураКИ = Новый Структура("Телефон, Адрес, Страна, КодСтраны");
	
	Для каждого СтрокаКИ Из ТаблицаКонтактнойИнформации Цикл
		Если СтрокаКИ.Вид = Справочники.ВидыКонтактнойИнформации.АдресПоПропискеФизическиеЛица
		 ИЛИ СтрокаКИ.Вид = Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты Тогда
		 	СтруктураКИ.Адрес = СтрокаКИ.Представление;
			СтруктураКИ.Страна = "РОССИЯ";
			СтруктураКИ.КодСтраны = "643";
			СписокПолей = ПреобразоватьСтрокуВСписокПолей(СтрокаКИ.ЗначенияПолей);
			Для Каждого ЗначениеПоля Из СписокПолей Цикл
				Если ВРег(ЗначениеПоля.Представление) = "СТРАНА" Тогда
					СтруктураКИ.Страна = ЗначениеПоля.Значение;
				ИначеЕсли ВРег(ЗначениеПоля.Представление) = "КОДСТРАНЫ" Тогда
					СтруктураКИ.КодСтраны = ЗначениеПоля.Значение;
				КонецЕсли;
			КонецЦикла;

	 	ИначеЕсли СтрокаКИ.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонРабочийФизическиеЛица
		 		ИЛИ СтрокаКИ.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагенты ТОГДА
		 	СтруктураКИ.Телефон = СтрокаКИ.Представление;
			
		КонецЕсли; 
	КонецЦикла; 
		
    Результат = "";
	
	Если СтруктураКИ.Свойство(ВидКИ, Результат) Тогда 
		Возврат Результат;
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции 

// Получает данные контактной информации организации
Функция КонтактнаяИнформацияОрганизации(Организация, ВидКИ) Экспорт

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	КонтактнаяИнформация.Вид,
	               |	КонтактнаяИнформация.Представление,
	               |	КонтактнаяИнформация.ЗначенияПолей
	               |ИЗ
	               |	Справочник.Организации.КонтактнаяИнформация КАК КонтактнаяИнформация
	               |ГДЕ
	               |	КонтактнаяИнформация.Ссылка = &Организация";
				   
	ТаблицаКонтактнойИнформации = Запрос.Выполнить().Выгрузить();
	 
	СтруктураКИ = Новый Структура("Телефон, ЮрАдрес, ЮрСтрана, ЮрКодСтраны, ФактАдрес, ФактСтрана, ФактКодСтраны");
	
	Для каждого СтрокаКИ Из ТаблицаКонтактнойИнформации Цикл
		Если СтрокаКИ.Вид = Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации Тогда
		 	СтруктураКИ.ЮрАдрес = СтрокаКИ.Представление;
			СтруктураКИ.ЮрСтрана = "РОССИЯ";
			СтруктураКИ.ЮрКодСтраны = "643";
			СписокПолей = ПреобразоватьСтрокуВСписокПолей(СтрокаКИ.ЗначенияПолей);
			Для Каждого ЗначениеПоля Из СписокПолей Цикл
				Если ВРег(ЗначениеПоля.Представление) = "СТРАНА" Тогда
					СтруктураКИ.ЮрСтрана = ЗначениеПоля.Значение;
				ИначеЕсли ВРег(ЗначениеПоля.Представление) = "КОДСТРАНЫ" Тогда
					СтруктураКИ.ЮрКодСтраны = ЗначениеПоля.Значение;
				КонецЕсли;
			КонецЦикла;
        ИначеЕсли СтрокаКИ.Вид = Справочники.ВидыКонтактнойИнформации.ФактАдресОрганизации Тогда
		 	СтруктураКИ.ФактАдрес = СтрокаКИ.Представление;
			СтруктураКИ.ФактСтрана = "РОССИЯ";
			СтруктураКИ.ФактКодСтраны = "643";
			СписокПолей = ПреобразоватьСтрокуВСписокПолей(СтрокаКИ.ЗначенияПолей);
			Для Каждого ЗначениеПоля Из СписокПолей Цикл
				Если ВРег(ЗначениеПоля.Представление) = "СТРАНА" Тогда
					СтруктураКИ.ФактСтрана = ЗначениеПоля.Значение;
				ИначеЕсли ВРег(ЗначениеПоля.Представление) = "КОДСТРАНЫ" Тогда
					СтруктураКИ.ФактКодСтраны = ЗначениеПоля.Значение;
				КонецЕсли;
			КонецЦикла;
	 	ИначеЕсли СтрокаКИ.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации ТОГДА
		 	СтруктураКИ.Телефон = СтрокаКИ.Представление;			
		КонецЕсли; 
	КонецЦикла; 
		
    Результат = "";
	
	Если СтруктураКИ.Свойство(ВидКИ, Результат) Тогда 
		Возврат Результат;
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции

//Возвращает наименование контрагента
Функция НаименованиеКонтрагента(Контрагент) ЭКСПОРТ
	
	Если ТипЗнч(Контрагент.ЮридическоеФизическоеЛицо) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
		
	    ФиоФизЛица = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество", Контрагент, ТекущаяДатаСеанса());
			
		Справочники.Контрагенты.ПолучитьДанныеКонтрагента(ФиоФизЛица);
						
		Возврат ?(ЗначениеЗаполнено(ФиоФизЛица.Фамилия), ФиоФизЛица.Фамилия, "") + ?(ЗначениеЗаполнено(ФиоФизЛица.Имя), ФиоФизЛица.Имя, "") + ?(ЗначениеЗаполнено(ФиоФизЛица.Отчество), ФиоФизЛица.Отчество, "");
	
	ИначеЕсли ТипЗнч(Контрагент.ЮридическоеФизическоеЛицо) = Тип("СправочникСсылка.ЮридическиеЛица") Тогда
	
		Возврат Контрагент.ЮридическоеФизическоеЛицо.НаименованиеПолное;  
		
	Иначе
		
		Возврат Контрагент.Наименование;
	
	КонецЕсли; 	

КонецФункции

Функция ФамилияКонтрагента(Знач Контрагент,Знач Дата) Экспорт
	
	ТекДата = НачалоДня(Дата);
	
