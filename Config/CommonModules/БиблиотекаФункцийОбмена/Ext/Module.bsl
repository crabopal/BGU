// Возвращает ссылку на формат обмена Электронный бюджет
//		ТипОбмена  (тип: СправочникСсылка.КС_ТипыФорматов)              - тип форматов обмена
//		ПолноеИмяФайла(тип: Строка)                                     - путь к файлу передачи
//		НаправлениеОбмена(тип: ПеречислениеСсылка.КС_НаправлениеОбмена) - экспорт или импорт
//      СообщениеОбОшибке (тип: Строка)                                 - текст сообщения об ошибке 
// Возвращаемое значение:
//		Булево 
Функция ФорматЭБДляОбработкиФайла(Формат, ТипОбмена, ПолноеИмяФайла, НаправлениеОбмена = "", СообщениеОбОшибке = "")  Экспорт
	
	Текст = Новый ЧтениеТекста(ПолноеИмяФайла);
	Стр   = Текст.Прочитать();
	
	//ПозВидаДок   = Найти(Стр, "<documentType>EXP_InfBO</documentType>");
	//
	//Если ПозВидаДок = 0 Тогда
	//	СообщениеОбОшибке = НСтр("ru = 'В файле не указан обрабатываемый вид документа EXP_InfBO - Сведения о БО.'");
	//	Возврат Ложь;
	//КонецЕсли;	
	
	ПозВерсии   = Найти(Стр, "versionID=");
	
	Если ПозВерсии > 0 Тогда
		НомерВерсии = "BO_" + Сред(Стр, ПозВерсии + 11, 3);
	Иначе
		СообщениеОбОшибке = НСтр("ru = 'В файле отсутсвует информация о версии обмена: атрибут versionID элемента formular .'");
		Возврат Ложь;
	КонецЕсли;	
	
	Формат = ВернутьФорматПоМаркеру(НомерВерсии, ТипОбмена, НаправлениеОбмена);
	Если НЕ ЗначениеЗаполнено(Формат) Тогда
		СообщениеОбОшибке = НСтр("ru = 'Для импорта информации в системе отсутствует необходимый формат '") + НомерВерсии +  НСтр("ru = '.'");
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция УниверсальныйРегламентированныйОтчетПараметрыОтчетаТаблица226нИтоги(ОбъектСсылка = Неопределено) ЭКСПОРТ
	
	Таблица = УниверсальныйРегламентированныйОтчетПараметрыОтчетаТаблица226н(ОбъектСсылка); 	
    Таблица.Свернуть("Аналитика1, ИмяТабЧасти, ПОЛЕСВЯЗИ, ССЫЛКАДОКУМЕНТА", "стр100_гр8, стр100_гр9, стр100_гр10, стр100_гр11, стр100_гр12");
	
	Таблица.Колонки.Добавить("НомерСтроки");
	Инд = 1;
	
	Для каждого Строка Из Таблица Цикл
		Строка.ИмяТабЧасти = ВРег("ТЧИтогов");
		Строка.НомерСтроки = Инд;
		Инд                = Инд + 1;
	КонецЦикла;

	Возврат Таблица;
	
КонецФункции

Функция УстановитьДлинуЛ(Значение = "", Длина = 0) Экспорт
	
	Результат = Прав(Строка(Значение), Длина);
	
	Для Сч = СтрДлина(Результат) По Длина-1 Цикл
		Результат = "0" + Результат;
	КонецЦикла;	
	
	Возврат Результат;
	
КонецФункции

Функция УстановитьДлинуП(Значение = "", Длина = 0) Экспорт
	
	Результат = Лев(Строка(Значение), Длина);
	
	Для Сч = СтрДлина(Результат) По Длина-1 Цикл
		Результат = Результат + "0";
	КонецЦикла;	
	
	Возврат Результат;
	
КонецФункции

Функция КПСПоТекстовомуКодуБК(СтрКБК, ТипКБК, УточнениеКБК = Неопределено, ДатаЗначения, ИнформацияОбОшибке) Экспорт
	
	КПС = Неопределено;
	КБКСтрокой = Сред(СтрКБК, 4);
	
	КПС = Справочники.КлассификационныеПризнакиСчетов.НайтиКПС(КБКСтрокой, ТипКБК, НачалоГода(ДатаЗначения), ДатаЗначения, УточнениеКБК);
	
	Если НЕ ЗначениеЗаполнено(КПС) Тогда
		СтруктураКодаБК = "";
		Если БюджетнаяКлассификация.НайтиКомпонентыКБК(КБКСтрокой, ТипКБК,, ДатаЗначения, СтруктураКодаБК, УточнениеКБК) Тогда
			СтруктураКодаБКНов = Новый Структура(СтруктураКодаБК);
			СтруктураКодаБКНов.Вставить("ДатаНачалаДействия", НачалоГода(ДатаЗначения));
			СтруктураКодаБКНов.Вставить("ДатаОкончанияДействия", ДатаЗначения);
			СтруктураКодаБК = Новый ФиксированнаяСтруктура(СтруктураКодаБКНов);
			КПС = Справочники.КлассификационныеПризнакиСчетов.НайтиСоздатьКПСПоСтруктуреБК(СтруктураКодаБК, ТипКБК, Истина, УточнениеКБК);
		Иначе
			ТекстОшибки = НСтр("ru='Не удалось найти элементы БК для создания КПС с кодом %1. КПС не заполнен.'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,КБКСтрокой);
			ИнформацияОбОшибке = ИнформацияОбОшибке + "
			|" + ТекстОшибки;
		КонецЕсли;
	КонецЕсли;

	Возврат КПС;
	
КонецФункции 

Функция ОбъектФАИПКМИПоТекстовомуКоду(КодФАИПКМИ, Организация) Экспорт  
	
	ОбъектФАИПКМИ = Неопределено;
	
	Если ЗначениеЗаполнено(КодФАИПКМИ) Тогда 
		Если СтрДлина(КодФАИПКМИ) = 24 Тогда // Это КМИ 
			Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	МероприятияПоИнформатизации.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.МероприятияПоИнформатизации КАК МероприятияПоИнформатизации
			|ГДЕ
			|	МероприятияПоИнформатизации.Владелец = &Владелец
			|	И МероприятияПоИнформатизации.Код = &Код");
			Запрос.УстановитьПараметр("Владелец", Организация);
			Запрос.УстановитьПараметр("Код", КодФАИПКМИ);
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				ОбъектФАИПКМИ = Выборка.Ссылка; 
			КонецЕсли;	
		Иначе // Это ФАИП    
			Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ОсновныеСредства.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.ОсновныеСредства КАК ОсновныеСредства
			|ГДЕ
			|	ОсновныеСредства.Организация = &Организация
			|	И ОсновныеСредства.КодФАИП = &КодФАИП");
			
			Запрос.УстановитьПараметр("Организация", Организация);
			Запрос.УстановитьПараметр("КодФАИП", КодФАИПКМИ);
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				ОбъектФАИПКМИ = Выборка.Ссылка;	
			КонецЕсли;	
		КонецЕсли; 
	КонецЕсли; 
	
	Возврат ОбъектФАИПКМИ;
	
КонецФункции		
	
Функция КодБКПоНастройке(КПС, ЛицевойСчет) Экспорт   
	
	КодБК = "00000000000000000000";
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ЛицевыеСчета.НеВыводитьКодГлавы
	|			ТОГДА ""000""
	|		ИНАЧЕ ЕСТЬNULL(ЛицевыеСчета.Владелец.КодПоППП.Код, ""000"")
	|	КОНЕЦ КАК КодГлавы,
	|	ВЫБОР
	|		КОГДА КлассификационныеПризнакиСчетов.ВидПоказателя = ЗНАЧЕНИЕ(Перечисление.ВидыКБК.АУИБУ)
	|			ТОГДА ВЫБОР
	|					КОГДА ЛицевыеСчета.НеВыводитьРазделПодраздел
	|						ТОГДА ""0000""
	|					ИНАЧЕ ПОДСТРОКА(КлассификационныеПризнакиСчетов.Код, 1, 4)
	|				КОНЕЦ
	|		ИНАЧЕ ПОДСТРОКА(КлассификационныеПризнакиСчетов.Код, 1, 4)
	|	КОНЕЦ КАК КодПодраздела,
	|	ВЫБОР
	|		КОГДА КлассификационныеПризнакиСчетов.ВидПоказателя = ЗНАЧЕНИЕ(Перечисление.ВидыКБК.АУИБУ)
	|			ТОГДА ВЫБОР
	|					КОГДА ЛицевыеСчета.НеВыводитьАналитическийКод
	|						ТОГДА ""0000000000""
	|					ИНАЧЕ ПОДСТРОКА(КлассификационныеПризнакиСчетов.Код, 5, 10)
	|				КОНЕЦ
	|		ИНАЧЕ ПОДСТРОКА(КлассификационныеПризнакиСчетов.Код, 5, 10)
	|	КОНЕЦ КАК АналитическийКод,
	|	ПОДСТРОКА(КлассификационныеПризнакиСчетов.Код, 15, 3) КАК КВР
	|ИЗ
	|	Справочник.КлассификационныеПризнакиСчетов КАК КлассификационныеПризнакиСчетов,
	|	Справочник.ЛицевыеСчета КАК ЛицевыеСчета
	|ГДЕ
	|	ЛицевыеСчета.Ссылка = &ЛицевойСчет
	|	И КлассификационныеПризнакиСчетов.Ссылка = &КПС");
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	Запрос.УстановитьПараметр("КПС", КПС); 
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		КодБК = Выборка.КодГлавы + Выборка.КодПодраздела + Выборка.АналитическийКод + Выборка.КВР;
	КонецЕсли;
	
	Возврат КодБК;
	
КонецФункции	

