Функция КонтрагентФизЛицо(ИНН = "", КПП = "")
	
	Ответ = Истина;
	
	Если ЗначениеЗаполнено(ИНН) Тогда
		
		Если СтрДлина(СокрЛП(ИНН)) = 10 Тогда
			 Ответ = Ложь;
		КонецЕсли;
		 
	ИначеЕсли ЗначениеЗаполнено(КПП) Тогда
		
		Ответ = Ложь;
		
	КонецЕсли;
	
	Возврат Ответ;
	
