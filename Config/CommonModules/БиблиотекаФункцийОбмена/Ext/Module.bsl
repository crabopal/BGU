Функция ЕстьПлатежиПоКвитанции(Квитанция) Экспорт
	Если ЗначениеЗаполнено(Квитанция) Тогда 
		СтруктураОтвета = РегистрыСведений.СоответствиеНачисленийИПлатежей.ПолучитьСуммуКоличествоПлатежейПоНачислению(Квитанция);
		Возврат СтруктураОтвета.Количество>0;
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции

Функция ПолучитьСтатусДокумента(Квитанция) Экспорт
	Если ЗначениеЗаполнено(Квитанция) Тогда
		СтруктураРекв = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(Квитанция);
	    Возврат ?(ЗначениеЗаполнено(СтруктураРекв.Статус),СтруктураРекв.Статус,Перечисления.СтатусыИсполненияДокумента.ВРаботе);
	КонецЕсли;
	Возврат Перечисления.СтатусыИсполненияДокумента.ПустаяСсылка();
КонецФункции

Функция ПолучитьЗначениеДополнительногоРеквизитаСправочника(Ссылка,ИмяДопРеквизита,ТипОбъекта = Неопределено) Экспорт
	ИскомоеЗначение = "";
	
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат ИскомоеЗначение;
	КонецЕсли;
	
	Если ТипОбъекта = Неопределено Тогда
		ТипОбъекта = "Справочник";
	КонецЕсли;
	
	Имя = Ссылка.Метаданные().Имя;
	Свойство = Неопределено;
	Попытка
		Свойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения[ИмяДопРеквизита];
	Исключение
		Свойство = Неопределено;
	КонецПопытки;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ Первые 1
		|	СпрДополнительныеРеквизиты.Значение КАК ИскомоеЗначение
		|ИЗ
		|	"+ТипОбъекта+"."+Имя+".ДополнительныеРеквизиты КАК СпрДополнительныеРеквизиты
		|ГДЕ
		|	СпрДополнительныеРеквизиты.Ссылка = &Ссылка
		|	И ВЫБОР
		|			КОГДА &ПоНаименованию
		|				ТОГДА СпрДополнительныеРеквизиты.Свойство.Наименование = &Наименование
		|			ИНАЧЕ СпрДополнительныеРеквизиты.Свойство = &Свойство
		|		КОНЕЦ";
	Запрос.УстановитьПараметр("ПоНаименованию", НЕ ЗначениеЗаполнено(Свойство));
	Запрос.УстановитьПараметр("Свойство", Свойство);
	Запрос.УстановитьПараметр("Наименование", ИмяДопРеквизита);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Попытка
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
			ИскомоеЗначение = Выборка.ИскомоеЗначение;
		КонецЕсли;
	Исключение
		ИскомоеЗначение = "";
	КонецПопытки;
	
	Возврат ИскомоеЗначение;
КонецФункции

Функция ПолучитьЗначениеДополнительныхСведений(Ссылка,ИмяДопСведений) Экспорт
	ИскомоеЗначение = "";
	
	Имя = Ссылка.Метаданные().Имя;
	Свойство = Неопределено;
	Попытка
		Свойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения[ИмяДопСведений];
	Исключение
		Свойство = Неопределено;
	КонецПопытки;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ Первые 1
		|	ДополнительныеСведения.Значение КАК ИскомоеЗначение
		|ИЗ
		|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
		|ГДЕ
		|	ДополнительныеСведения.Объект = &Ссылка
		|	И ВЫБОР
		|			КОГДА &ПоНаименованию
		|				ТОГДА ДополнительныеСведения.Свойство.Наименование = &Наименование
		|			ИНАЧЕ ДополнительныеСведения.Свойство = &Свойство
		|		КОНЕЦ";
	Запрос.УстановитьПараметр("ПоНаименованию", НЕ ЗначениеЗаполнено(Свойство));
	Запрос.УстановитьПараметр("Свойство", Свойство);
	Запрос.УстановитьПараметр("Наименование", ИмяДопСведений);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Попытка
		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
