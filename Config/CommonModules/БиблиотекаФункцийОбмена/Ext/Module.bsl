// находит или создает новое значение кода цели
Функция НайтиКодЦели(Код, Наименование = "", СоздаватьНовые = Истина) ЭКСПОРТ
	
	Если НЕ ЗначениеЗаполнено(Код) Тогда
		Возврат "";
	КонецЕсли;
	
	КодЦели = Справочники.ВидыЦелевыхСредств.НайтиПоКоду(Код);
	
	Если КодЦели = Справочники.ВидыЦелевыхСредств.ПустаяСсылка() И СоздаватьНовые Тогда
		
		КодЦели              = Справочники.ВидыЦелевыхСредств.СоздатьЭлемент();
		
		КодЦели.Код          = Код;
	    КодЦели.Наименование = ?(ЗначениеЗаполнено(Наименование), Наименование, Код);
		
		Попытка
			КодЦели.Записать();
		Исключение
			Возврат "";
		КонецПопытки;
				
	КонецЕсли;
	
	Возврат КодЦели.Ссылка;
	
КонецФункции

