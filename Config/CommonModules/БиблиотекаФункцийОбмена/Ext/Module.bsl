Функция ПолучитьКоличествоСтрокВТЧ(Знач ДокументСсылка, Знач ИмяТЧ) Экспорт
	
	Количество = 0;
	Попытка
	    ИмяДок = ДокументСсылка.Метаданные().Имя;
		Если ДокументСсылка.Метаданные().ТабличныеЧасти.Найти(ИмяТЧ)<>Неопределено Тогда
		
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	МАКСИМУМ(ТекДок.НомерСтроки) КАК КоличествоСтрок
				|ИЗ
				|	Документ."+ИмяДок+"."+ИмяТЧ+" КАК ТекДок
				|ГДЕ
				|	ТекДок.Ссылка = &Ссылка";
			Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
		Иначе

			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	МАКСИМУМ(ЗначенияКолонокДополнительныхТабличныхЧастей.НомерСтрокиДокумента) КАК КоличествоСтрок
				|ИЗ
				|	РегистрСведений.ЗначенияКолонокДополнительныхТабличныхЧастей КАК ЗначенияКолонокДополнительныхТабличныхЧастей
				|ГДЕ
				|	ЗначенияКолонокДополнительныхТабличныхЧастей.Объект = &Ссылка
				|	И ЗначенияКолонокДополнительныхТабличныхЧастей.ТабличнаяЧасть.ИмяТабличнойЧасти = &ИмяТЧ
				|	И ЗначенияКолонокДополнительныхТабличныхЧастей.ТабличнаяЧасть.ПометкаУдаления = ЛОЖЬ";

			Запрос.УстановитьПараметр("ИмяТЧ", ИмяТЧ);
			Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
			
		КонецЕсли;
		
		Результат = Запрос.Выполнить();

		ВыборкаДетальныеЗаписи = Результат.Выбрать();

		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			Количество = ВыборкаДетальныеЗаписи.КоличествоСтрок;
		КонецЕсли;
		
	Исключение
		Количество = 0;
	КонецПопытки;
	
	Если ЗначениеЗаполнено(Количество) Тогда
		Возврат Количество;
	Иначе
		Возврат 0;
	КонецЕсли;
КонецФункции

Функция ПолучитьИтогПоКолонкеТЧ(Знач ДокументСсылка, Знач ИмяТЧ, Знач ИмяКолонки) Экспорт
	Итог = 0;
	Попытка
		ИмяДок = ДокументСсылка.Метаданные().Имя;
		
		ИзДокумента = Ложь;
		Если ДокументСсылка.Метаданные().ТабличныеЧасти.Найти(ИмяТЧ)<>Неопределено Тогда
			Если ДокументСсылка.Метаданные().ТабличныеЧасти[ИмяТЧ].Реквизиты.Найти(ИмяКолонки)<> Неопределено
				Или ВРег(ИмяКолонки) = "НОМЕРСТРОКИ" Тогда
				ИзДокумента = Истина;
			КонецЕсли;
		КонецЕсли;		
		Если ИзДокумента Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	СУММА(ТекДок."+ИмяКолонки+") КАК ИскомоеЗначение
				|ИЗ
				|	Документ."+ИмяДок+"."+ИмяТЧ+" КАК ТекДок
				|ГДЕ
				|	ТекДок.Ссылка = &Ссылка";

			Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
		Иначе
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	СУММА(ВЫРАЗИТЬ(ЗначенияКолонокДополнительныхТабличныхЧастей.Значение КАК ЧИСЛО(22, 4))) КАК ИскомоеЗначение
				|ИЗ
				|	РегистрСведений.ЗначенияКолонокДополнительныхТабличныхЧастей КАК ЗначенияКолонокДополнительныхТабличныхЧастей
				|ГДЕ
				|	ЗначенияКолонокДополнительныхТабличныхЧастей.Объект = &Ссылка
				|	И ЗначенияКолонокДополнительныхТабличныхЧастей.ТабличнаяЧасть.ИмяТабличнойЧасти = &ИмяТЧ
				|	И ЗначенияКолонокДополнительныхТабличныхЧастей.КолонкаТабличнойЧасти.ИмяКолонки = &ИмяКолонки
				|	И ЗначенияКолонокДополнительныхТабличныхЧастей.ТабличнаяЧасть.ПометкаУдаления = ЛОЖЬ
				|	И ЗначенияКолонокДополнительныхТабличныхЧастей.КолонкаТабличнойЧасти.ПометкаУдаления = ЛОЖЬ";

			Запрос.УстановитьПараметр("ИмяКолонки", ИмяКолонки);
			Запрос.УстановитьПараметр("ИмяТЧ", ИмяТЧ);
			Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
			
		КонецЕсли;
		Результат = Запрос.Выполнить();

		ВыборкаДетальныеЗаписи = Результат.Выбрать();

		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			Итог = ВыборкаДетальныеЗаписи.ИскомоеЗначение;
		КонецЕсли;

	Исключение
		Итог = 0;
	КонецПопытки;
	Возврат Итог;
КонецФункции

// Функция возвращает значение колонки табличной части документа в строке табличной части с указанным номером.
// Работает как с имеющимися, так и с дополнительными табличными частями.
//
Функция ПолучитьЗначениеКолонкиТЧПоНомеруСтроки(Знач ДокументСсылка, Знач ИмяТЧ, Знач ИмяКолонки,Знач НомерСтроки) Экспорт
	Значение = Неопределено;
	Если НомерСтроки = 0 Тогда
		НомерСтроки = 1;
	КонецЕсли;
	Попытка
		ИмяДок = ДокументСсылка.Метаданные().Имя;
		
		ИзДокумента = Ложь;
		Если ДокументСсылка.Метаданные().ТабличныеЧасти.Найти(ИмяТЧ)<>Неопределено Тогда
			Если ДокументСсылка.Метаданные().ТабличныеЧасти[ИмяТЧ].Реквизиты.Найти(ИмяКолонки)<> Неопределено
				Или ВРег(ИмяКолонки) = "НОМЕРСТРОКИ" Тогда
				ИзДокумента = Истина;
			КонецЕсли;
		КонецЕсли;
		Если ИзДокумента Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	ТекДок."+ИмяКолонки+" КАК ИскомоеЗначение
				|ИЗ
				|	Документ."+ИмяДок+"."+ИмяТЧ+" КАК ТекДок
				|ГДЕ
				|	ТекДок.Ссылка = &Ссылка
				|	И ТекДок.НомерСтроки = &НомерСтроки";

			Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	        Запрос.УстановитьПараметр("НомерСтроки", НомерСтроки);
		Иначе
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	ЗначенияКолонокДополнительныхТабличныхЧастей.Значение КАК ИскомоеЗначение
				|ИЗ
				|	РегистрСведений.ЗначенияКолонокДополнительныхТабличныхЧастей КАК ЗначенияКолонокДополнительныхТабличныхЧастей
				|ГДЕ
				|	ЗначенияКолонокДополнительныхТабличныхЧастей.Объект = &Ссылка
				|	И ЗначенияКолонокДополнительныхТабличныхЧастей.ТабличнаяЧасть.ИмяТабличнойЧасти = &ИмяТЧ
				|	И ЗначенияКолонокДополнительныхТабличныхЧастей.КолонкаТабличнойЧасти.ИмяКолонки = &ИмяКолонки
				|	И ЗначенияКолонокДополнительныхТабличныхЧастей.НомерСтрокиДокумента = &НомерСтроки
				|	И ЗначенияКолонокДополнительныхТабличныхЧастей.КолонкаТабличнойЧасти.ПометкаУдаления = ЛОЖЬ
				|	И ЗначенияКолонокДополнительныхТабличныхЧастей.ТабличнаяЧасть.ПометкаУдаления = ЛОЖЬ";

			Запрос.УстановитьПараметр("НомерСтроки", НомерСтроки);	
			Запрос.УстановитьПараметр("ИмяКолонки", ИмяКолонки);
			Запрос.УстановитьПараметр("ИмяТЧ", ИмяТЧ);
			Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
					
		КонецЕсли;
		
		Результат = Запрос.Выполнить();

		ВыборкаДетальныеЗаписи = Результат.Выбрать();

		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			Значение = ВыборкаДетальныеЗаписи.ИскомоеЗначение;
		КонецЕсли;

	Исключение
		Значение = Неопределено;
	КонецПопытки;
	Возврат Значение;
КонецФункции

// Функция возвращает таблицу значений, используемую в форматах обмена с ОФК.
// Параметры:
//	- Объект - ссылка на документ "ЗаявкаНаКассовыйРасходСокращенная", либо массив ссылок;
//	- ИмяТЧ - строка - имя табличной части, служебный реквизит, необходимый для форматов обмена.
//
Функция ФормированиеТаблицыОснованийДляСокращеннойЗКР(Знач Объект,Знач ИмяТЧ="") Экспорт
	
	МассивСсылок = Новый Массив;
	
	Если ТипЗнч(Объект) = Тип("ДокументСсылка.ЗаявкаНаКассовыйРасходСокращенная") Тогда
		МассивСсылок.Добавить(Объект);
	Иначе
		МассивСсылок = Объект;
	КонецЕсли;
	
	ТЗ = Новый ТаблицаЗначений;
	
	ТЗ.Колонки.Добавить("Основание");
	ТЗ.Колонки.Добавить("Вид");
	ТЗ.Колонки.Добавить("Номер");
	ТЗ.Колонки.Добавить("Дата");
	ТЗ.Колонки.Добавить("ИмяТабЧасти");
	ТЗ.Колонки.Добавить("НомерСтроки");
	ТЗ.Колонки.Добавить("ССЫЛКАДОКУМЕНТА");
	ТЗ.Колонки.Добавить("ПОЛЕСВЯЗИ");

	ИмяТЧ = ВРег(ИмяТЧ);

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаявкаНаКассовыйРасходСокращенная.Ссылка,
		|	ЗаявкаНаКассовыйРасходСокращенная.ДокументОснованиеВид,
		|	ЗаявкаНаКассовыйРасходСокращенная.ДокументОснованиеДата,
		|	ЗаявкаНаКассовыйРасходСокращенная.ДокументОснованиеНомер,
		|	ЗаявкаНаКассовыйРасходСокращенная.ОснованиеПлатежаВид,
		|	ЗаявкаНаКассовыйРасходСокращенная.ОснованиеПлатежаДата,
		|	ЗаявкаНаКассовыйРасходСокращенная.ОснованиеПлатежаНомер
		|ИЗ
		|	Документ.ЗаявкаНаКассовыйРасходСокращенная КАК ЗаявкаНаКассовыйРасходСокращенная
		|ГДЕ
		|	ЗаявкаНаКассовыйРасходСокращенная.Ссылка В(&МассивСсылок)";

	Запрос.УстановитьПараметр("МассивСсылок", МассивСсылок);

	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();
    
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ПорНомер = 1;
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ОснованиеПлатежаВид) ИЛИ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ОснованиеПлатежаНомер) ИЛИ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ОснованиеПлатежаДата) Тогда
		
			СтрокаТЗ      		 = ТЗ.Добавить();
			СтрокаТЗ.Основание	 = "1";
			СтрокаТЗ.Вид   		 = ВыборкаДетальныеЗаписи.ОснованиеПлатежаВид;
			СтрокаТЗ.Номер		 = ВыборкаДетальныеЗаписи.ОснованиеПлатежаНомер;
			СтрокаТЗ.Дата 		 = ВыборкаДетальныеЗаписи.ОснованиеПлатежаДата;
			СтрокаТЗ.ИмяТабЧасти = ИмяТЧ;
			СтрокаТЗ.НомерСтроки = ПорНомер;
			СтрокаТЗ.ССЫЛКАДОКУМЕНТА = ВыборкаДетальныеЗаписи.Ссылка;
			СтрокаТЗ.ПОЛЕСВЯЗИ   = Истина;
			
			ПорНомер = ПорНомер + 1;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ДокументОснованиеВид) ИЛИ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ДокументОснованиеНомер) ИЛИ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ДокументОснованиеДата) Тогда
			
			СтрокаТЗ	         = ТЗ.Добавить();
			СтрокаТЗ.Основание	 = "2";
			СтрокаТЗ.Вид  		 = ВыборкаДетальныеЗаписи.ДокументОснованиеВид;
			СтрокаТЗ.Номер		 = ВыборкаДетальныеЗаписи.ДокументОснованиеНомер;
			СтрокаТЗ.Дата 		 = ВыборкаДетальныеЗаписи.ДокументОснованиеДата;
			СтрокаТЗ.ИмяТабЧасти = ИмяТЧ;
			СтрокаТЗ.НомерСтроки = ПорНомер;
			СтрокаТЗ.ССЫЛКАДОКУМЕНТА = ВыборкаДетальныеЗаписи.Ссылка;
			СтрокаТЗ.ПОЛЕСВЯЗИ   = Истина;
		КонецЕсли;	
	КонецЦикла;
	
	Возврат ТЗ;
	
КонецФункции

Функция ПолучитьСтруктуруРПС(ДокументСсылка) Экспорт
	
	СтруктураРПС = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НастройкиИспользованияРПС.СтруктураРПС,
		|	1 КАК ПолеПорядка
		|ИЗ
		|	РегистрСведений.НастройкиИспользованияРПС КАК НастройкиИспользованияРПС
		|ГДЕ
		|	НастройкиИспользованияРПС.Организация = &Организация
		|	И ВЫБОР
		|			КОГДА &УчитыватьИФО
		|				ТОГДА НастройкиИспользованияРПС.ИФО = &ИФО
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	УчетнаяПолитикаОрганизацийСрезПоследних.СтруктураРПС,
		|	2
		|ИЗ
		|	РегистрСведений.УчетнаяПолитикаОрганизаций.СрезПоследних(&Дата, Организация = &Организация) КАК УчетнаяПолитикаОрганизацийСрезПоследних
		|ГДЕ
		|	УчетнаяПолитикаОрганизацийСрезПоследних.Организация = &Организация
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПолеПорядка";

	Запрос.УстановитьПараметр("ИФО", ДокументСсылка.ИФО);
	Запрос.УстановитьПараметр("Организация", ДокументСсылка.Организация);
	Запрос.УстановитьПараметр("Дата", ДокументСсылка.Дата);
	Запрос.УстановитьПараметр("УчитыватьИФО", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));

	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();

	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		СтруктураРПС = ВыборкаДетальныеЗаписи.СтруктураРПС;
	КонецЕсли;

	Возврат СтруктураРПС;
	
КонецФункции

