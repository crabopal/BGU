	               |		ВЫБОР
	               |			КОГДА ГОД(Внебюджет.Ссылка.Дата) = ГОД(Внебюджет.ПериодПлана.ДатаОкончания)
	               |					И МЕСЯЦ(Внебюджет.ПериодПлана.ДатаОкончания) = 8
	               |				ТОГДА Внебюджет.СуммаВВалюте
	               |			ИНАЧЕ 0
	               |		КОНЕЦ,
	               |		ВЫБОР
	               |			КОГДА ГОД(Внебюджет.Ссылка.Дата) = ГОД(Внебюджет.ПериодПлана.ДатаОкончания)
	               |					И МЕСЯЦ(Внебюджет.ПериодПлана.ДатаОкончания) = 9
	               |				ТОГДА Внебюджет.СуммаВВалюте
	               |			ИНАЧЕ 0
	               |		КОНЕЦ,
	               |		ВЫБОР
	               |			КОГДА ГОД(Внебюджет.Ссылка.Дата) = ГОД(Внебюджет.ПериодПлана.ДатаОкончания)
	               |					И МЕСЯЦ(Внебюджет.ПериодПлана.ДатаОкончания) = 10
	               |				ТОГДА Внебюджет.СуммаВВалюте
	               |			ИНАЧЕ 0
	               |		КОНЕЦ,
	               |		ВЫБОР
	               |			КОГДА ГОД(Внебюджет.Ссылка.Дата) = ГОД(Внебюджет.ПериодПлана.ДатаОкончания)
	               |					И МЕСЯЦ(Внебюджет.ПериодПлана.ДатаОкончания) = 11
	               |				ТОГДА Внебюджет.СуммаВВалюте
	               |			ИНАЧЕ 0
	               |		КОНЕЦ,
	               |		ВЫБОР
	               |			КОГДА ГОД(Внебюджет.Ссылка.Дата) = ГОД(Внебюджет.ПериодПлана.ДатаОкончания)
	               |					И МЕСЯЦ(Внебюджет.ПериодПлана.ДатаОкончания) = 12
	               |				ТОГДА Внебюджет.СуммаВВалюте
	               |			ИНАЧЕ 0
	               |		КОНЕЦ,
	               |		ВЫБОР
	               |			КОГДА ГОД(Внебюджет.Ссылка.Дата) = ГОД(Внебюджет.ПериодПлана.ДатаОкончания)
	               |				ТОГДА Внебюджет.СуммаВВалюте
	               |			ИНАЧЕ 0
	               |		КОНЕЦ,
	               |		ВЫБОР
	               |			КОГДА ГОД(Внебюджет.Ссылка.Дата) + 1 = ГОД(Внебюджет.ПериодПлана.ДатаОкончания)
	               |				ТОГДА Внебюджет.СуммаВВалюте
	               |			ИНАЧЕ 0
	               |		КОНЕЦ,
	               |		ВЫБОР
	               |			КОГДА ГОД(Внебюджет.Ссылка.Дата) + 2 = ГОД(Внебюджет.ПериодПлана.ДатаОкончания)
	               |				ТОГДА Внебюджет.СуммаВВалюте
	               |			ИНАЧЕ 0
	               |		КОНЕЦ,
	               |		ВЫБОР
	               |			КОГДА ГОД(Внебюджет.Ссылка.Дата) + 3 = ГОД(Внебюджет.ПериодПлана.ДатаОкончания)
	               |				ТОГДА Внебюджет.СуммаВВалюте
	               |			ИНАЧЕ 0
	               |		КОНЕЦ,
	               |		ВЫБОР
	               |			КОГДА ГОД(Внебюджет.Ссылка.Дата) + 4 = ГОД(Внебюджет.ПериодПлана.ДатаОкончания)
	               |				ТОГДА Внебюджет.СуммаВВалюте
	               |			ИНАЧЕ 0
	               |		КОНЕЦ,
	               |		ВЫБОР
	               |			КОГДА ГОД(Внебюджет.Ссылка.Дата) + 4 < ГОД(Внебюджет.ПериодПлана.ДатаОкончания)
	               |				ТОГДА Внебюджет.СуммаВВалюте
	               |			ИНАЧЕ 0
	               |		КОНЕЦ,
	               |		ВЫБОР
	               |			КОГДА Внебюджет.Номенклатура.НаименованиеПолное = """"
	               |				ТОГДА Внебюджет.Номенклатура.Наименование
	               |			ИНАЧЕ Внебюджет.Номенклатура.НаименованиеПолное
	               |		КОНЕЦ,
	               |		Внебюджет.Ссылка
	               |	ИЗ
	               |		Документ.РегистрацияОбязательствИСведенийПоДоговорам.РасшифровкаОбязательстваВнебюджет КАК Внебюджет
	               |	ГДЕ
	               |		Внебюджет.Ссылка В(&МассивСсылок)
	               |		И Внебюджет.Сумма <> 0) КАК РасшифровкаОбязательства
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	РасшифровкаОбязательства.КодБК,
	               |	РасшифровкаОбязательства.ВидБК,
	               |	РасшифровкаОбязательства.ИсточникСредств,
	               |	РасшифровкаОбязательства.ПредметКонтракта,
	               |	РасшифровкаОбязательства.Ссылка
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ССЫЛКАДОКУМЕНТА,
	               |	ИсточникСредств,
	               |	КодБК,
	               |	ВидБК,
	               |	РасшифровкаОбязательства.ПредметКонтракта";

	РезультирующаяТаблица = Запрос.Выполнить().Выгрузить();
	Если ДополнитьДляФормата Тогда
		РезультирующаяТаблица.Колонки.Добавить("НомерСтроки");
		РезультирующаяТаблица.Колонки.Добавить("ИмяТабЧасти");
		РезультирующаяТаблица.Колонки.Добавить("ПОЛЕСВЯЗИ");
		ПредДок = Неопределено;
		ПорядковыйНомер = 1;
		Для Каждого СтрТЧ Из РезультирующаяТаблица Цикл
			Если СтрТЧ.ССЫЛКАДОКУМЕНТА <> ПредДок Тогда 
				ПорядковыйНомер = 1;
				ПредДок = СтрТЧ.ССЫЛКАДОКУМЕНТА;
			КонецЕсли;
			СтрТЧ.НомерСтроки = ПорядковыйНомер;
			СтрТЧ.ИмяТабЧасти = ИмяТЧ;
			СтрТЧ.ПОЛЕСВЯЗИ = Истина;
			//РезультирующаяТаблица[Инд].ССЫЛКАДОКУМЕНТА = ОбъектСсылка;
			ПорядковыйНомер = ПорядковыйНомер + 1;
		КонецЦикла;		
	КонецЕсли;
	Возврат РезультирующаяТаблица;
		
КонецФункции

Функция ТаблицаТЧПлатежногоДокумента(знач ОбъектСсылка, ИмяТЧ = "РасшифровкаПлатежа", ИспользоватьДопКл = Ложь, ИспользоватьКодМероприятия = Ложь, ИспользоватьКЭК = Ложь, 
	                                 ИспользоватьАналитическийКод = Ложь, ИспользоватьКФО = Ложь, ИспользоватьКОСГУПолучателя = Ложь) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ОбъектСсылка) Тогда
		
		РезультирующаяТаблица = Новый ТаблицаЗначений;
		
		РезультирующаяТаблица.Колонки.Добавить("НомерПП");
		РезультирующаяТаблица.Колонки.Добавить("ИмяТабЧасти",    Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)));
		РезультирующаяТаблица.Колонки.Добавить("ПОЛЕСВЯЗИ");
		РезультирующаяТаблица.Колонки.Добавить("ССЫЛКАДОКУМЕНТА");
		
		Возврат РезультирующаяТаблица;
		
	КонецЕсли;
	
	МассивСсылок          			 = Новый Массив;
	
	Если ТипЗнч(ОбъектСсылка) = Тип("ДокументСсылка.РегистрацияОбязательствИСведенийПоДоговорам") ИЛИ
		ТипЗнч(ОбъектСсылка) <> Тип("Массив") Тогда
		МассивСсылок.Добавить(ОбъектСсылка);
	Иначе
		МассивСсылок 				 = ОбъектСсылка;
		ОбъектСсылка                 = МассивСсылок[0];
	КонецЕсли;
	
	ОсновнаяТаблица                  = ""; 	   
	
	МенеджерОбъекта                  = ОбщегоНазначения.МенеджерОбъектаПоСсылке(ОбъектСсылка);
	МассивТаблицДокументов           = МенеджерОбъекта.ЗначенияРеквизитовДокумента(МассивСсылок, ИспользоватьДопКл, ИспользоватьКодМероприятия, ИспользоватьКЭК, ИспользоватьАналитическийКод, ИспользоватьКФО, ИспользоватьКОСГУПолучателя);
		
	Для каждого Документ Из МассивТаблицДокументов Цикл
		
		РезультирующаяТаблица        = Документ[ИмяТЧ]; 
		
		РезультирующаяТаблица.Колонки.Добавить("НомерПП");
		РезультирующаяТаблица.Колонки.Добавить("ИмяТабЧасти",    Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)));
		РезультирующаяТаблица.Колонки.Добавить("ПОЛЕСВЯЗИ");
		РезультирующаяТаблица.Колонки.Добавить("ССЫЛКАДОКУМЕНТА");

		ПорядковыйНомер            = 1;
		
		Для Каждого СтрТаб Из РезультирующаяТаблица Цикл
			
			СтрТаб.ССЫЛКАДОКУМЕНТА = СтрТаб.Ссылка;
			СтрТаб.НомерСтроки     = ?(СтрТаб.НомерСтроки = 0, ПорядковыйНомер, СтрТаб.НомерСтроки);
			СтрТаб.НомерПП         = ПорядковыйНомер;
			СтрТаб.ИмяТабЧасти     = Врег(ИмяТЧ);
			СтрТаб.ПОЛЕСВЯЗИ       = Истина;
			ПорядковыйНомер        = ПорядковыйНомер + 1;
			
		КонецЦикла;
		
		Если НЕ ЗначениеЗаполнено(Основнаятаблица) Тогда
			ОсновнаяТаблица        = РезультирующаяТаблица;
		Иначе
			Для каждого СтрокаТаб Из РезультирующаяТаблица Цикл
				РабочаяСтрока      = ОсновнаяТаблица.Добавить();
				Для каждого КолонкаТаб Из РезультирующаяТаблица.Колонки Цикл
					РабочаяСтрока[КолонкаТаб.Имя] = СтрокаТаб[КолонкаТаб.Имя];
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ОсновнаяТаблица;
	
КонецФункции

Процедура ВыделитьИмяИСокращение(Имя, Сокращение)
	
	ПолноеИмя = СокрЛП(Имя);
	н         = 1;
	м         = 0;
	
	Пока н > 0 Цикл
		 м = м + н;
		 ПолноеИмя = Сред(ПолноеИмя, н + 1);
		 н = Найти(ПолноеИмя, " ");
	КонецЦикла;
	 
	Сокращение = СокрЛП(ПолноеИмя); 
	Имя        = СокрЛП(Лев(Имя, м));
	
КонецПроцедуры

