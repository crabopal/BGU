Функция НайтиОрганизациюПоИННКПП(ИНН, КПП) Экспорт

	Запрос = Новый Запрос;
	//Добавлена сортировка по наличию настройки участника ГИС ГМП
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Организации.Ссылка КАК Ссылка,
		|	ВЫБОР
		|		КОГДА НастройкаОрганизацийДляГИСГМП_УНП.Организация ЕСТЬ NULL
		|			ТОГДА 2
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК ПорядокОрганизаций
		|ИЗ
		|	Справочник.Организации КАК Организации
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкаОрганизацийДляГИСГМП_УНП КАК НастройкаОрганизацийДляГИСГМП_УНП
		|		ПО (НастройкаОрганизацийДляГИСГМП_УНП.Организация = Организации.Ссылка)
		|ГДЕ
		|	Организации.ИНН = &ИНН
		|	И Организации.КПП = &КПП
		|	И Организации.ПометкаУдаления = ЛОЖЬ
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПорядокОрганизаций";

	Запрос.УстановитьПараметр("ИНН", ИНН);
	Запрос.УстановитьПараметр("КПП", КПП);

	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();

	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
		
	КонецЕсли;
	
	Возврат Справочники.Организации.ПустаяСсылка();

КонецФункции

Функция ОпределитьКонтрагентаАН(ИНН, КПП) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.ПометкаУдаления = ЛОЖЬ
		|	И Контрагенты.АдминистраторНачислений
		|	И Контрагенты.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
		|	И Контрагенты.ИНН = &ИНН
		|	И (Контрагенты.КПП = &КПП
		|			ИЛИ Контрагенты.КППИстория.КПП = &КПП)";

	Запрос.УстановитьПараметр("ИНН", ИНН);
	Запрос.УстановитьПараметр("КПП", КПП);

	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();

	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
		
	КонецЕсли;
	
	Возврат Справочники.Контрагенты.ПустаяСсылка();

КонецФункции

