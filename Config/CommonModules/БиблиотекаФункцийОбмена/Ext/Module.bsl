Функция ПолучитьРеквизитКО(Договор, Реквизит, Дата = Неопределено) Экспорт
	
	Запрос       = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КазначейскоеОбеспечениеСрезПоследних.ОбъектФАИП,
	|	КазначейскоеОбеспечениеСрезПоследних.КПС,
	|	КазначейскоеОбеспечениеСрезПоследних.НомерКОО,
	|	КазначейскоеОбеспечениеСрезПоследних.ДатаКОО
	|ИЗ
	|	РегистрСведений.КазначейскоеОбеспечение.СрезПоследних(
	|			&Дата,
	|			Обязательство = &Договор
	|			) КАК КазначейскоеОбеспечениеСрезПоследних";
	
	Если Дата = Неопределено Тогда
		Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Договор"	,	Договор);
	Запрос.УстановитьПараметр("Дата"	,   КонецДня(Дата));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка[Реквизит];
	КонецЕсли;

КонецФункции

