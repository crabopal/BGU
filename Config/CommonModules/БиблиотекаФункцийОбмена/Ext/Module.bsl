    РеквизитыАдреса = Новый Структура;
	
	РеквизитыАдреса.Вставить("Индекс",                                  Индекс);
	РеквизитыАдреса.Вставить("НаименованиеНаселенногоПункта",           НаселенныйПунктИмя);
	РеквизитыАдреса.Вставить("ТипНаселенногоПункта",                    НаселенныйПунктВид);
