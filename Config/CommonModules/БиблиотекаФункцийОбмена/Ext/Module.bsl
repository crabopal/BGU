			ИначеЕсли НЕ ИспользоватьДопКл И ИспользоватьКодМероприятия Тогда
				ДетализацияПоКартам = ТаблицаРаспоряжения.ДетализированныеВыплаты.Скопировать(Новый Структура("Ссылка, КодБК, КодЦели, КЭК, КФО, КодМероприятия", 
			                      СтрокаИтогов.Ссылка, СтрокаИтогов.КодБК, СтрокаИтогов.КодЦели, СтрокаИтогов.КЭК, СтрокаИтогов.КФО, СтрокаИтогов.КодМероприятия));
			ИначеЕсли ИспользоватьДопКл И ИспользоватьКодМероприятия Тогда
				ДетализацияПоКартам = ТаблицаРаспоряжения.ДетализированныеВыплаты.Скопировать(Новый Структура("Ссылка, КодБК, КодЦели, КЭК, КФО, ДопКлассификация, КодМероприятия", 
			                      СтрокаИтогов.Ссылка, СтрокаИтогов.КодБК, СтрокаИтогов.КодЦели, СтрокаИтогов.КЭК, СтрокаИтогов.КФО, СтрокаИтогов.ДопКлассификация, СтрокаИтогов.КодМероприятия));
			Иначе
				ДетализацияПоКартам = ТаблицаРаспоряжения.ДетализированныеВыплаты.Скопировать(Новый Структура("Ссылка, КодБК, КодЦели, КЭК, КФО", 
			                      СтрокаИтогов.Ссылка, СтрокаИтогов.КодБК, СтрокаИтогов.КодЦели, СтрокаИтогов.КЭК, СтрокаИтогов.КФО));				  
			КонецЕсли;					  
			
			Для Каждого СтрокаРасшифровки Из ДетализацияПоКартам Цикл
			
				НомерПП                                  = НомерПП + 1;
				
				ЗаполнитьЗначенияСвойств(РезультирующаяТаблица.Добавить(), СтрокаРасшифровки);
				
				н                                        = РезультирующаяТаблица.Количество()-1;
				
				РезультирующаяТаблица[н].НомерПП       	 = НомерПП;
				
				РезультирующаяТаблица[н].ИмяТабЧасти   	 = ВРег("ДетальныеПоказателиПоКартам");
				РезультирующаяТаблица[н].НомерСтроки     = НомерПП;

				РезультирующаяТаблица[н].ИмяТабЧасти_Гл	 = ВРег("ИтоговыеСуммыВыплат");
				РезультирующаяТаблица[н].НомерСтроки_Гл  = "__"+Строка(НомСтроки);
				
				РезультирующаяТаблица[н].ПОЛЕСВЯЗИ       = ИСТИНА;

			КонецЦикла;		
					
		КонецЦикла;  
		
	КонецЦикла;	
					
	РезультирующаяТаблица.Колонки["Ссылка"].Имя = "ССЫЛКАДОКУМЕНТА";
	
	Возврат РезультирующаяТаблица;		
	
