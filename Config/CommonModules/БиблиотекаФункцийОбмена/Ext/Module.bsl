	РеквизитыАдреса.Вставить("КонтрагентОКТМОАдреса", 					Корреспонденты.ОКТМОИзАдреса(АдресXML));
	
	Возврат РеквизитыАдреса;
			
КонецФункции

Функция ПолучитьРеквизитыШапкиСоглашения(знач ОбъектСсылка, ИмяРеквизита) Экспорт
	
	МассивСсылок          			 = Новый Массив;
	ПараметрыПечати       			 = Новый Структура;
	
	Если ТипЗнч(ОбъектСсылка) = Тип("ДокументСсылка.РегистрацияОбязательствИСведенийПоДоговорам") Тогда
		МассивСсылок.Добавить(ОбъектСсылка);
	Иначе
		МассивСсылок 				 = ОбъектСсылка;
		ОбъектСсылка                 = МассивСсылок[0];
	КонецЕсли;

	ДеревоДанных      	             = РаботаСОбязательствами.ПолучитьДанныеДляИнформацииОСглашенияхНаСубсидии(ПараметрыПечати, МассивСсылок);	
	ДанныеОШапке                     = ДеревоДанных.РезультатПоШапке.Выгрузить();

	Если Найти("Индекс, НаименованиеНаселенногоПункта, ТипНаселенногоПункта, ТипИмяУличнойСети, Дом", ИмяРеквизита) > 0 Тогда
		Возврат ПолучитьРеквизитыАдреса(ДанныеОШапке[0].ЗначенияПолейАдреса)[ИмяРеквизита];    	
	ИначеЕсли ИмяРеквизита = "ОКТМОАдреса" Тогда
		Возврат Корреспонденты.ОКТМОИзАдреса(ДанныеОШапке[0].ЗначенияПолейАдреса);
	Иначе	
		Возврат ДанныеОШапке[0][ИмяРеквизита]; 
	КонецЕсли;
	
КонецФункции

