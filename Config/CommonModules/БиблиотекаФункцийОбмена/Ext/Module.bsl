// Объект - выписка из л.с.
Процедура ПреобразоватьОстаткиВыпискиИзЛС_УФЭБС(Объект)Экспорт
	
	КоличествоСтрок = Объект.Остатки.Количество(); 
	Если КоличествоСтрок>1 Тогда
		ПоследняяСтрокаОстатков = Объект.Остатки[КоличествоСтрок-1];
		ПредПоследняяСтрокаОстатков = Объект.Остатки[КоличествоСтрок-2];
		Если ПредПоследняяСтрокаОстатков.Показатель = Перечисления.ПоказателиНаЛицевыхСчетах.ОстатокСредствНаСчете Тогда
			ПредПоследняяСтрокаОстатков.ОстатокНаНачалоДня = ПоследняяСтрокаОстатков.ОстатокНаНачалоДня; 
			Если ЗначениеЗаполнено(ПоследняяСтрокаОстатков.ОстатокНаКонецДня) Тогда
				ПредПоследняяСтрокаОстатков.ОстатокНаКонецДня = ПоследняяСтрокаОстатков.ОстатокНаКонецДня;
			КонецЕсли;
			Объект.Остатки.Удалить(ПоследняяСтрокаОстатков);              
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ОпределитьКассовыйОрганОФКИзНастройкиОбмена(Задание) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Задание) Тогда
		Возврат "";
	КонецЕсли;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Имя", "ОФК");
	ПараметрыОФК    = Задание.НастройкаОбмена.Параметры.НайтиСтроки(ПараметрыОтбора);
	
	Если ПараметрыОФК.Количество()>0 Тогда
		
		Кассовый_Орган = ПараметрыОФК[0].Значение;
		
		Если ЗначениеЗаполнено(Кассовый_Орган) И ТипЗнч(Кассовый_Орган) = Тип("СправочникСсылка.Казначейства") Тогда
			Возврат Кассовый_Орган;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Задание.КассовыйОрган;

КонецФункции

Функция НаименованиеБанкаПоНастройкеОбмена(Наименование, Город, Задание) Экспорт
		
	Если НЕ ЗначениеЗаполнено(Наименование) Тогда
		Возврат "";
	КонецЕсли;  
	
	Если НЕ ЗначениеЗаполнено(Задание) Тогда  
	//функция вызывается из блока проверки перед выгрузкой	
		Возврат Наименование   
	КонецЕсли; 
	
	ПараметрыОтбора   = Новый Структура;
	ПараметрыОтбора.Вставить("Имя", "ЗапятаяВНаименованииБанка");
	ПараметрыИмяБанка = Задание.НастройкаОбмена.Параметры.НайтиСтроки(ПараметрыОтбора);
	
	Если ПараметрыИмяБанка.Количество()>0 Тогда
		
		УказыватьЗапятую = ПараметрыИмяБанка[0].Значение;
		
		Если  ТипЗнч(УказыватьЗапятую) = Тип("Булево") И ЗначениеЗаполнено(Город) И УказыватьЗапятую Тогда
			Возврат СтрЗаменить(Наименование, " " + СокрЛП(Город), ", " + СокрЛП(Город));
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Наименование;

КонецФункции	

Функция УчитыватьПереданныеПолномочияПриОбмене(Задание) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Задание) Тогда
		Возврат Ложь;
	КонецЕсли;	
	
    ПараметрыОтбора              = Новый Структура;
	ПараметрыОтбора.Вставить("Имя", "УчитыватьПереданныеПолномочия");	
	НастройкиПоПолномочиям       = Задание.НастройкаОбмена.Параметры.НайтиСтроки(ПараметрыОтбора);
	
	УчитываПереданныеПолномочия  = Ложь;
	
	Если НастройкиПоПолномочиям.Количество() > 0 Тогда
		
		УчитываПереданныеПолномочия = Истина;
		БратьизНастройкиПП = НастройкиПоПолномочиям[0].Значение;
		
		Если ЗначениеЗаполнено(БратьизНастройкиПП) И ТипЗнч(БратьизНастройкиПП) = Тип("Булево") Тогда
			Если НЕ БратьизНастройкиПП Тогда
				 УчитываПереданныеПолномочия = Ложь;
			КонецЕсли
		КонецЕсли;
		
    КонецЕсли;		
	
	Возврат УчитываПереданныеПолномочия;
	
КонецФункции   

Функция ИспользоватьКодКлиентаИзНастройкиОбмена(Задание) Экспорт
	
    ПараметрыОтбора        = Новый Структура;
	ПараметрыОтбора.Вставить("Имя", "ПолучатьДанныеИзНастроекЛС");	
	ПараметрыЛС            = Задание.НастройкаОбмена.Параметры.НайтиСтроки(ПараметрыОтбора);
	
	ПолучитьКодИзНастройки = Ложь;
	
	Если ПараметрыЛС.Количество() > 0 Тогда
		
		ПолучитьКодИзНастройки = Истина;
		БратьНастройкиИзЛС = ПараметрыЛС[0].Значение;
		
		Если ЗначениеЗаполнено(БратьНастройкиИзЛС) И ТипЗнч(БратьНастройкиИзЛС) = Тип("Булево") Тогда
			Если НЕ БратьНастройкиИзЛС Тогда
				 ПолучитьКодИзНастройки = Ложь;
			КонецЕсли
		КонецЕсли;
		
    КонецЕсли;		
	
	Возврат ПолучитьКодИзНастройки;
	
КонецФункции   

Функция ОпределитьКодКлиентаИзНастройкиОбмена(Задание, Объект) Экспорт      
	
	Если НЕ ЗначениеЗаполнено(Объект) Тогда
		Возврат "";
	КонецЕсли;
	
	Если НЕ ОбщегоНазначения.ЕстьРеквизитОбъекта("ЛицевойСчет", Объект.Метаданные()) 
		ИЛИ НЕ ЗначениеЗаполнено(Объект.ЛицевойСчет) Тогда  
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Организация", Объект.Метаданные())
			И ЗначениеЗаполнено(Объект.Организация) Тогда
			
		    РеквизитыВыбраннойОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Организация, "УчетПереданныхПолномочий, ПолучательПолномочий");
			Если РеквизитыВыбраннойОрганизации.УчетПереданныхПолномочий И ЗначениеЗаполнено(РеквизитыВыбраннойОрганизации.ПолучательПолномочий)
				И УчитыватьПереданныеПолномочияПриОбмене(Задание) Тогда
				Возврат ЗначениеРеквизитаОбъекта(РеквизитыВыбраннойОрганизации.ПолучательПолномочий, "КодПоРПБС");   
			Иначе
				Возврат ЗначениеРеквизитаОбъекта(Объект, "Организация.КодПоРПБС");
			КонецЕсли;		   	
			
		Иначе
			Возврат ""
		КонецЕсли; 
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Задание) Тогда   // для проверок
		Возврат ЗначениеРеквизитаОбъекта(Объект, "ЛицевойСчет.Владелец.КодПоРПБС");
	КонецЕсли;
	
	Если ИспользоватьКодКлиентаИзНастройкиОбмена(Задание) И ЗначениеРеквизитаОбъекта(Объект, "ЛицевойСчет.ИспользоватьДляСчетаУчетныйНомер") Тогда
		
		Возврат ЗначениеРеквизитаОбъекта(Объект, "ЛицевойСчет.КодПоРПБС");
				
	Иначе
		
	    Организация = ЗначениеРеквизитаОбъекта(Объект, "ЛицевойСчет.Владелец");
		Если ЗначениеЗаполнено(Организация) Тогда
			РеквизитыВыбраннойОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Организация, "УчетПереданныхПолномочий, ПолучательПолномочий");
			Если РеквизитыВыбраннойОрганизации.УчетПереданныхПолномочий И ЗначениеЗаполнено(РеквизитыВыбраннойОрганизации.ПолучательПолномочий)
				  И УчитыватьПереданныеПолномочияПриОбмене(Задание) Тогда
				Возврат ЗначениеРеквизитаОбъекта(РеквизитыВыбраннойОрганизации.ПолучательПолномочий, "КодПоРПБС");   
			Иначе
				Возврат ЗначениеРеквизитаОбъекта(Объект, "ЛицевойСчет.Владелец.КодПоРПБС");
			КонецЕсли;
		Иначе
			Возврат "";
		КонецЕсли;
			
	КонецЕсли;

КонецФункции

Функция КодКлиентаСоотвествуетОрганизации(Значение, Организация, Задание)  Экспорт
	
	Если НЕ ИспользоватьКодКлиентаИзНастройкиОбмена(Задание) Тогда       
		
		РеквизитыВыбраннойОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Организация, "УчетПереданныхПолномочий, ПолучательПолномочий");
		Если РеквизитыВыбраннойОрганизации.УчетПереданныхПолномочий И ЗначениеЗаполнено(РеквизитыВыбраннойОрганизации.ПолучательПолномочий)
			  И УчитыватьПереданныеПолномочияПриОбмене(Задание) Тогда  
			  
			КодПоРПБСПолучателя = ЗначениеРеквизитаОбъекта(РеквизитыВыбраннойОрганизации.ПолучательПолномочий, "КодПоРПБС");  
			
			Если БиблиотекаФункцийОбмена.Стр_Длина(КодПоРПБСПолучателя) = 5 Тогда
				Возврат Значение = "000" + КодПоРПБСПолучателя;
			Иначе
				Возврат Значение = КодПоРПБСПолучателя;
			КонецЕсли;

		КонецЕсли;	
		
		Если БиблиотекаФункцийОбмена.Стр_Длина(Организация.КодПоРПБС) = 5 Тогда
			Возврат Значение = "000" + Организация.КодПоРПБС;
		Иначе
			Возврат Значение = Организация.КодПоРПБС;
		КонецЕсли;
	Иначе
		
		Если (Значение = "000" + Организация.КодПоРПБС) ИЛИ (Значение = Организация.КодПоРПБС) Тогда
			Возврат Истина;
		КонецЕсли;		
			
		Запрос = Новый Запрос;	
		
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЛицевыеСчета.Ссылка КАК Ссылка
		               |ИЗ
		               |	Справочник.ЛицевыеСчета КАК ЛицевыеСчета
		               |ГДЕ
		               |	ЛицевыеСчета.Владелец = &Организация
		               |	И ((ЛицевыеСчета.КодПоРПБС = &Значение) ИЛИ (""000"" + ЛицевыеСчета.КодПоРПБС = &Значение))";
			
	    Запрос.УстановитьПараметр("Организация", Организация);
		Запрос.УстановитьПараметр("Значение",    Значение);

	    Возврат  Запрос.Выполнить().Выбрать().Следующий();
		
	КонецЕсли;
	
КонецФункции

Функция ДатаФайлаПопадаетВЗаданныйПериод(Значение, ДатаОт, ДатаПо)  Экспорт   
	
	ДатаФайла = Дата(Лев(Значение, 8));  
		
	Возврат (ДатаОт <= ДатаФайла) И (ДатаФайла <= ДатаПо);
	
КонецФункции	

Функция ПолучитьУИН_base64(Значение, ИмяПоля) Экспорт
	
	ДвоичныеДанные 		= Base64Значение(Значение);
	
	ИмяВременногоФайла	= ПолучитьИмяВременногоФайла();
	ДвоичныеДанные.Записать(ИмяВременногоФайла);
	ТекстовыйФайл 		= Новый ЧтениеТекста(ИмяВременногоФайла, КодировкаТекста.UTF8);
	СодержимоеФайлаУИН	= ТекстовыйФайл.Прочитать();
	ТекстовыйФайл.Закрыть();
	
	ЧтениеXML 			= Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(СодержимоеФайлаУИН);
	
	ПутьПравилаОбработки = "";
				
	Пока ЧтениеXML.Прочитать() Цикл
		// Обработка узла XML           	
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
	
			ПутьПравилаОбработки = ПутьПравилаОбработки + "/" + ЧтениеXML.Имя;
			ПутьПравилаОбработки_БезИменИАтрибутов = ПолучитьПутьПравилаОбработкиБезПространстваИмен(ПутьПравилаОбработки);
			Если ЧтениеXML.КоличествоАтрибутов() > 0 Тогда
				Пока ЧтениеXML.ПрочитатьАтрибут() Цикл
					
					ПолеСтроки	 = ЧтениеXML.Значение;
					Если ИмяПоля = ПутьПравилаОбработки + "/@" + ЧтениеXML.Имя Тогда
						Возврат ПолеСтроки;
					ИначеЕсли ИмяПоля = ПутьПравилаОбработки_БезИменИАтрибутов + "/@" + ЧтениеXML.Имя Тогда
						Возврат ПолеСтроки;
					КонецЕсли;						
				КонецЦикла;
			КонецЕсли;
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда
					
			ПолеСтроки	 = ЧтениеXML.Значение;
			Если ИмяПоля = ПутьПравилаОбработки Тогда
				Возврат ПолеСтроки;
			ИначеЕсли ИмяПоля = ПутьПравилаОбработки_БезИменИАтрибутов Тогда
				Возврат ПолеСтроки;			
			КонецЕсли;			
			
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			
			позУзла = Найти(ПутьПравилаОбработки+ "/", "/"+ЧтениеXML.Имя+ "/");
			Если позУзла >= 1 Тогда
				ПутьПравилаОбработки = Лев(ПутьПравилаОбработки, позУзла - 1);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;	
	
	Возврат Неопределено;	
	
КонецФункции

Функция ПолучитьНачислениеПоУИН(УИН,ИскатьНачисленияПосредника = Ложь) Экспорт
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КвитанцияНаОплатуГосуслуг.Ссылка
		|ИЗ
		|	Документ.КвитанцияНаОплатуГосуслуг КАК КвитанцияНаОплатуГосуслуг
		|ГДЕ
		|	КвитанцияНаОплатуГосуслуг.УникальныйИдентификаторНачисления = &УИН
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НачислениеОтПодведомственного.Ссылка
		|ИЗ
		|	Документ.НачислениеОтПодведомственного КАК НачислениеОтПодведомственного
		|ГДЕ
		|	НачислениеОтПодведомственного.УникальныйИдентификаторНачисления = &УИН";
	
	Если ИскатьНачисленияПосредника = Истина Тогда
		Запрос.Текст = Запрос.Текст + "
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НачислениеОтПосредникаГИСГМП.Ссылка
		|ИЗ
		|	Документ.НачислениеОтПосредникаГИСГМП КАК НачислениеОтПосредникаГИСГМП
		|ГДЕ
		|	НачислениеОтПосредникаГИСГМП.УникальныйИдентификаторНачисления = &УИН";
	КонецЕсли;	
	
	Запрос.УстановитьПараметр("УИН", УИН);

	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();

	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ПолучитьПутьПравилаОбработкиБезПространстваИмен(Знач ПутьПравилаОбработки) Экспорт
	
	Если СтрНайти(ПутьПравилаОбработки,":")=0 Тогда
		//Если нет двоеточия, значит и пространства имен нет, возвращаем исходное значение
		Возврат ПутьПравилаОбработки;	
	КонецЕсли;
	
	МассивБлоков = СтрРазделить(ПутьПравилаОбработки,"/",Истина);
	Для Инд = 0 По МассивБлоков.ВГраница() Цикл

 		ТекБлок = МассивБлоков[Инд];
		Если СтрНайти(ТекБлок,":")>0 Тогда
			ЭтоАтрибут = СтрНачинаетсяС(ТекБлок,"@");
			МассивЧастей = СтрРазделить(ТекБлок,":",Ложь);
			ТекБлок = ?(ЭтоАтрибут,"@","")+МассивЧастей[1];// первая часть это пространство имен
            МассивБлоков[Инд] = ТекБлок;
		Иначе
			Продолжить;
		КонецЕсли;
	КонецЦикла;
	ПутьПравилаОбработки_БезПространстваИмен = СтрСоединить(МассивБлоков,"/");
	Возврат ПутьПравилаОбработки_БезПространстваИмен;
	
КонецФункции


Функция ПолучитьЗначенияИзXML(ВидОбмена,ПроизвольныеПараметры,СоответствиеИмя) Экспорт
	
	Если ВидОбмена.ТипФайлаПередачи <> Перечисления.ТипыФайловПередачиДляОбмена.XML Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		КодировкаТекстаФайла	= КодировкаТекста[ВидОбмена.КодировкаТекстаФайла]
	Исключение
		КодировкаТекстаФайла    = ВидОбмена.КодировкаТекстаФайла;
	КонецПопытки;
	
	СоответствиеРеквизитов = ПроизвольныеПараметры.Получить(СоответствиеИмя);
	Если ТипЗнч(СоответствиеРеквизитов)=Тип("Соответствие") Тогда
		КоличествоРеквизитов = СоответствиеРеквизитов.Количество();
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	ЧтениеXML 			= Новый ЧтениеXML;
	Попытка
	ЧтениеXML.УстановитьСтроку(ПроизвольныеПараметры.Получить("ТекстФайла"));
	Исключение
		Возврат Неопределено;
	КонецПопытки;;
	ПутьПравилаОбработки = "";
	СтруктураРеквизитов = Новый Структура;
	
	Пока ЧтениеXML.Прочитать() Цикл
		// Обработка узла XML
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			
			ПутьПравилаОбработки = ПутьПравилаОбработки + "/" + ЧтениеXML.Имя;
			ПутьПравилаОбработки_БезПространстваИменИАтрибутов = ПолучитьПутьПравилаОбработкиБезПространстваИмен(ПутьПравилаОбработки);

			Если ЧтениеXML.КоличествоАтрибутов() > 0 Тогда
				Пока ЧтениеXML.ПрочитатьАтрибут() Цикл
					
					ПолеСтроки	 = ЧтениеXML.Значение;
					
					Результат = СоответствиеРеквизитов.Получить(ПутьПравилаОбработки + "/@" + ЧтениеXML.Имя);
					
					Если ЗначениеЗаполнено(Результат) Тогда
						СтруктураРеквизитов.Вставить(Результат,ПолеСтроки);
						Если КоличествоРеквизитов = СтруктураРеквизитов.Количество() Тогда
							Прервать;
						КонецЕсли;
					ИначеЕсли Найти(ПутьПравилаОбработки,":")>0 Тогда
						
						Результат = СоответствиеРеквизитов.Получить(ПутьПравилаОбработки_БезПространстваИменИАтрибутов + "/@" + ЧтениеXML.Имя);
	                    Если ЗначениеЗаполнено(Результат) Тогда
							СтруктураРеквизитов.Вставить(Результат,ПолеСтроки);
							Если КоличествоРеквизитов = СтруктураРеквизитов.Количество() Тогда
								Прервать;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
						
				КонецЦикла
			КонецЕсли
			
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда
			
			ПолеСтроки	 = ЧтениеXML.Значение;
			
			Результат = СоответствиеРеквизитов.Получить(ПутьПравилаОбработки);
	
			Если ЗначениеЗаполнено(Результат) Тогда
				СтруктураРеквизитов.Вставить(Результат,ПолеСтроки);
				Если КоличествоРеквизитов = СтруктураРеквизитов.Количество() Тогда
					Прервать;
				КонецЕсли;
			ИначеЕсли Найти(ПутьПравилаОбработки,":")>0 Тогда
				ПутьПравилаОбработки_БезПространстваИменИАтрибутов = ПолучитьПутьПравилаОбработкиБезПространстваИмен(ПутьПравилаОбработки);
				
				Результат = СоответствиеРеквизитов.Получить(ПутьПравилаОбработки_БезПространстваИменИАтрибутов);
                Если ЗначениеЗаполнено(Результат) Тогда
					СтруктураРеквизитов.Вставить(Результат,ПолеСтроки);
					Если КоличествоРеквизитов = СтруктураРеквизитов.Количество() Тогда
						Прервать;
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			
			позУзла = Найти(ПутьПравилаОбработки+ "/", "/"+ЧтениеXML.Имя+ "/");
			Если позУзла >= 1 Тогда
				ПутьПравилаОбработки = Лев(ПутьПравилаОбработки, позУзла - 1);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
    ЧтениеXML.Закрыть();
    Возврат СтруктураРеквизитов;
КонецФункции

Функция НайтиДокументПоРеквизитам(ИмяДокумента,ВидОбмена,ПроизвольныеПараметры) Экспорт
	
	СтруктураРеквизитов = ПолучитьЗначенияИзXML(ВидОбмена,ПроизвольныеПараметры,"СоответствиеРеквизитов"); 
	
	Если ТипЗнч(СтруктураРеквизитов)<>Тип("Структура") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
		"ВЫБРАТЬ Первые 1
		|	Док.Ссылка
		|ИЗ
		|	Документ."+ИмяДокумента+" КАК Док
		|ГДЕ
		|	Док.ПометкаУдаления = Ложь";
		
	Для Каждого КлючИЗначение Из СтруктураРеквизитов Цикл
		ТекстЗапроса = ТекстЗапроса + " И Док."+ КлючИЗначение.Ключ +"=&"+ КлючИЗначение.Ключ;
		Запрос.УстановитьПараметр(КлючИЗначение.Ключ,КлючИЗначение.Значение);
		
	КонецЦикла;
	Запрос.Текст = ТекстЗапроса;
	Попытка
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

Процедура СохранитьЗначениеРеквизита(ИмяПараметра,Значение,ПроизвольныеПараметры) Экспорт
	РеквизитыДокумента = ПроизвольныеПараметры.Получить("РеквизитыДокумента");
	Если ТипЗнч(РеквизитыДокумента) <> Тип("Структура") Тогда
		РеквизитыДокумента = Новый Структура;
	КонецЕсли;
	РеквизитыДокумента.Вставить(ИмяПараметра,Значение);
	ПроизвольныеПараметры.Вставить("РеквизитыДокумента",РеквизитыДокумента);
КонецПроцедуры

Процедура ЗаполнитьСохраненнымиЗначениямиРеквизитов(Объект,ПроизвольныеПараметры) Экспорт
	РеквизитыДокумента = ПроизвольныеПараметры.Получить("РеквизитыДокумента");
	Если ТипЗнч(РеквизитыДокумента) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(Объект,РеквизитыДокумента);	       
	КонецЕсли;
КонецПроцедуры

Функция ТипДокументаПоФормату(Формат) Экспорт	
	
	Если ЗначениеЗаполнено(Формат) Тогда
		ИмяФормата = Формат.ИдентификаторОбъекта.Имя;
		Если ИмяФормата = "КвитанцияНаОплатуГосуслуг" Тогда
			Возврат "01";
		ИначеЕсли ИмяФормата = "ПлатежВОплатуГосуслуг" Тогда
			Возврат "02";
		ИначеЕсли ИмяФормата = "ЗапросУНИФО" Тогда
			Возврат "05";
		ИначеЕсли ИмяФормата = "КаталогГосУслуг" Тогда
			Возврат "08";
		ИначеЕсли ИмяФормата = "ПакетНачислений" Тогда
			Возврат "09";
		ИначеЕсли ИмяФормата = "НачислениеОтПодведомственного" Тогда
			Возврат "10";
		КонецЕсли;
	КонецЕсли;
	Возврат "00";
	
КонецФункции

