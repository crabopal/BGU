	//Если АнализКлассификатора.ДанныеВыбора.Количество() = 1 Тогда
	//	
	//	ЗначениеНаселенногоПункта          = АнализКлассификатора.ДанныеВыбора[0].Значение.Значение;
	//	КодКлассификатораНаселенногоПункта = ЗначениеНаселенногоПункта.Код;
	//	ЭтоГород                           = НЕ ЗначениеЗаполнено(ЗначениеНаселенногоПункта.СписокРеквизитов.НаселенныйПункт.Наименование);
	//	НаселенныйПунктИмя                 = ?(ЭтоГород, ЗначениеНаселенногоПункта.СписокРеквизитов.Город.Наименование,
	//	                                      ЗначениеНаселенногоПункта.СписокРеквизитов.НаселенныйПункт.Наименование);
	//	НаселенныйПунктВид                 = ?(ЭтоГород, ЗначениеНаселенногоПункта.СписокРеквизитов.Город.Заголовок,
	//	                                      ЗначениеНаселенногоПункта.СписокРеквизитов.НаселенныйПункт.Заголовок);	
