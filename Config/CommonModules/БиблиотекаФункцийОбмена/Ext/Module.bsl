Функция ТаблицаИсточниковСредствВР(знач МассивСсылок) Экспорт
	
	РезультирующаяТаблица = Новый ТаблицаЗначений;
		 
	РезультирующаяТаблица.Колонки.Добавить("НомерПП");
	РезультирующаяТаблица.Колонки.Добавить("КодНПА");
	РезультирующаяТаблица.Колонки.Добавить("КодСредств");
	РезультирующаяТаблица.Колонки.Добавить("Примечание");
	
	РезультирующаяТаблица.Колонки.Добавить("ССЫЛКАДОКУМЕНТА");
	РезультирующаяТаблица.Колонки.Добавить("НомерСтроки");
	РезультирующаяТаблица.Колонки.Добавить("ИмяТабЧасти",       Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)));
	РезультирующаяТаблица.Колонки.Добавить("ПОЛЕСВЯЗИ");
	
	Если НЕ ЗначениеЗаполнено(МассивСсылок) Тогда		 
		 Возврат РезультирующаяТаблица;	 
	КонецЕсли;	

	ДанныеСведенийВР        = ПлатежноРасчетныеДокументы.ЗначенияРеквизитовСведенияОбОперацияхСоСредствамиВР(МассивСсылок);
	
	Для каждого СтруктураДанных Из ДанныеСведенийВР Цикл
		
		НомерПП = 0;
		
		Для Каждого Стр Из СтруктураДанных.Список Цикл
			
			Строка = РезультирующаяТаблица.Добавить();
			ЗаполнитьЗначенияСвойств(Строка, Стр);
			
			 НомерПП                = НомерПП + 1;
				 
			 Строка.НомерПП         = НомерПП;
			 Строка.НомерСтроки     = НомерПП;
			 Строка.ССЫЛКАДОКУМЕНТА = Стр.Ссылка;
			 Строка.ИмяТабЧасти     = "ИСТОЧНИКИ";
			 Строка.ПОЛЕСВЯЗИ       = Истина;
		
		КонецЦикла;
		
	КонецЦикла;	
	
	Возврат  РезультирующаяТаблица;
	
КонецФункции

Функция ТаблицаДокументовОснований(знач МассивСсылок) Экспорт
	
	РезультирующаяТаблица = Новый ТаблицаЗначений;
		 
	РезультирующаяТаблица.Колонки.Добавить("НомерПП");
	РезультирующаяТаблица.Колонки.Добавить("ДокументОснованиеВид");
    РезультирующаяТаблица.Колонки.Добавить("ДокументОснованиеДата");
    РезультирующаяТаблица.Колонки.Добавить("ДокументОснованиеНомер"); 
	РезультирующаяТаблица.Колонки.Добавить("ДокументОснованиеСумма"); 
	РезультирующаяТаблица.Колонки.Добавить("GUIDРасчетногоДокумента"); 
	 
	РезультирующаяТаблица.Колонки.Добавить("ССЫЛКАДОКУМЕНТА");
	РезультирующаяТаблица.Колонки.Добавить("НомерСтроки");
	РезультирующаяТаблица.Колонки.Добавить("ИмяТабЧасти",       Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)));
	РезультирующаяТаблица.Колонки.Добавить("ПОЛЕСВЯЗИ");
	
	Если НЕ ЗначениеЗаполнено(МассивСсылок) Тогда		 
		 Возврат РезультирующаяТаблица;	 
	КонецЕсли;	
	
	ДанныеЗВ        = ПлатежноРасчетныеДокументы.ЗначенияРеквизитовЗаявкаНаВозврат(МассивСсылок); 
	ОсновнаяТаблица = "";
	
	Для каждого Заявка Из ДанныеЗВ Цикл
			
		Если Заявка.ВыводитьРаздел_2_Таб Тогда
			
			 РезультирующаяТаблица =  Заявка.ДокументыОснования;
			 
			 РезультирующаяТаблица.Колонки.Добавить("НомерПП");
			 РезультирующаяТаблица.Колонки.Добавить("ССЫЛКАДОКУМЕНТА");
			 РезультирующаяТаблица.Колонки.Добавить("НомерСтроки");
			 РезультирующаяТаблица.Колонки.Добавить("ИмяТабЧасти",       Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)));
			 РезультирующаяТаблица.Колонки.Добавить("ПОЛЕСВЯЗИ");
			 
			 НомерПП = 0;
			 
			 Для каждого Строка Из РезультирующаяТаблица Цикл
				 
				 НомерПП                = НомерПП + 1;
				 
				 Строка.НомерПП         = НомерПП;
				 Строка.НомерСтроки     = НомерПП;
				 Строка.ССЫЛКАДОКУМЕНТА = Строка.Ссылка;
				 Строка.ИмяТабЧасти     = "ДОКУМЕНТЫОСНОВАНИЯ";
				 Строка.ПОЛЕСВЯЗИ       = Истина;
				
			 КонецЦикла;
			 
			 Если НЕ ЗначениеЗаполнено(Основнаятаблица) Тогда
				ОсновнаяТаблица        = РезультирующаяТаблица;
		     Иначе
				Для каждого СтрокаТаб Из РезультирующаяТаблица Цикл
					РабочаяСтрока      = ОсновнаяТаблица.Добавить();
					Для каждого КолонкаТаб Из РезультирующаяТаблица.Колонки Цикл
						РабочаяСтрока[КолонкаТаб.Имя] = СтрокаТаб[КолонкаТаб.Имя];
					КонецЦикла;
				КонецЦикла;
			КонецЕсли;

					
		 КонецЕсли;
	КонецЦикла;
	
	Возврат ?(ОсновнаяТаблица = "", РезультирующаяТаблица, ОсновнаяТаблица);
	
КонецФункции

Функция ТаблицаРеквизитовПодтверждающихДокументов(знач МассивСсылок) Экспорт
	
	Если НЕ ЗначениеЗаполнено(МассивСсылок) Тогда
		
		 РезультирующаяТаблица = Новый ТаблицаЗначений;
		 
		 РезультирующаяТаблица.Колонки.Добавить("НомерПП");
		 РезультирующаяТаблица.Колонки.Добавить("ДатаДокумента");
         РезультирующаяТаблица.Колонки.Добавить("НомерДокумента");
         РезультирующаяТаблица.Колонки.Добавить("НаименованиеДокумента"); 
		 
		 РезультирующаяТаблица.Колонки.Добавить("ССЫЛКАДОКУМЕНТА");
		 РезультирующаяТаблица.Колонки.Добавить("НомерСтроки");
		 РезультирующаяТаблица.Колонки.Добавить("ИмяТабЧасти",       Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)));
		 РезультирующаяТаблица.Колонки.Добавить("ПОЛЕСВЯЗИ");
	 
		 Возврат РезультирующаяТаблица;
		 
	КонецЕсли;	
	 
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("МассивСсылок",     МассивСсылок);
	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ДоговорыДокументыОснования.Дата      КАК ДатаДокумента,
	|	ДоговорыДокументыОснования.Номер     КАК НомерДокумента,
	|	ДоговорыДокументыОснования.НаименованиеДокумента,
	|   Документы.Ссылка                     КАК ССЫЛКАДОКУМЕНТА,
	|   ""ДОКУМЕНТЫОСНОВАНИЯ""               КАК ИмяТабЧасти,
	|   ИСТИНА                               КАК ПОЛЕСВЯЗИ,
	|   ВЫРАЗИТЬ(ДоговорыДокументыОснования.НомерСтроки КАК ЧИСЛО(3,0)) КАК НомерПП,
	|   ВЫРАЗИТЬ(ДоговорыДокументыОснования.НомерСтроки КАК ЧИСЛО(3,0)) КАК НомерСтроки
	|ИЗ
	|   Документ.РегистрацияОбязательствИСведенийПоДоговорам КАК Документы 
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Договоры.ДокументыОснования КАК ДоговорыДокументыОснования	
	|   ПО Документы.Договор = ДоговорыДокументыОснования.Ссылка            
	|
	|ГДЕ
	|	Документы.Ссылка В (&МассивСсылок)
	|";
	
	РезультирующаяТаблица = Запрос.Выполнить().Выгрузить();
	
	Возврат РезультирующаяТаблица;
	
КонецФункции

Функция ТаблицаКонтрагентовСоглашения(знач ОбъектСсылка) Экспорт
	
	// формируем пустую таблицу для построения формата в СКД
	Если НЕ ЗначениеЗаполнено(ОбъектСсылка) Тогда
		
		РезультирующаяТаблица = Новый ТаблицаЗначений;
		
		РезультирующаяТаблица.Колонки.Добавить("КонтрагентНаименованиеПолное");
		РезультирующаяТаблица.Колонки.Добавить("КонтрагентНаименованиеСокращенное");
		РезультирующаяТаблица.Колонки.Добавить("КонтрагентКодКОПФ");
		РезультирующаяТаблица.Колонки.Добавить("КонтрагентИНН");
		РезультирующаяТаблица.Колонки.Добавить("КонтрагентКПП");
		РезультирующаяТаблица.Колонки.Добавить("КонтрагентДатаРегистрации");
				
		РезультирующаяТаблица.Колонки.Добавить("КонтрагентСубъектФедерацииКод");
	    РезультирующаяТаблица.Колонки.Добавить("КонтрагентСубъектФедерацииНаименование");
	    РезультирующаяТаблица.Колонки.Добавить("Индекс");
	    РезультирующаяТаблица.Колонки.Добавить("ТипНаселенногоПункта");
		РезультирующаяТаблица.Колонки.Добавить("НаименованиеНаселенногоПункта");
        РезультирующаяТаблица.Колонки.Добавить("КонтрагентОКТМОАдреса");
		РезультирующаяТаблица.Колонки.Добавить("ТипИмяУличнойСети");
		РезультирующаяТаблица.Колонки.Добавить("Дом");
		
		РезультирующаяТаблица.Колонки.Добавить("НаименованиеБюджета");
		РезультирующаяТаблица.Колонки.Добавить("КодБюджета");
		
		РезультирующаяТаблица.Колонки.Добавить("НомерПП");
		РезультирующаяТаблица.Колонки.Добавить("ССЫЛКАДОКУМЕНТА");
		РезультирующаяТаблица.Колонки.Добавить("НомерСтроки");
		РезультирующаяТаблица.Колонки.Добавить("ИмяТабЧасти",    Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)));
		РезультирующаяТаблица.Колонки.Добавить("ПОЛЕСВЯЗИ");
		
		РезультирующаяТаблица.Колонки.Добавить("НомерСтроки_ГЛ", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)));
		РезультирующаяТаблица.Колонки.Добавить("ИмяТабЧасти_ГЛ", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)));
		
		Возврат РезультирующаяТаблица;
		
	КонецЕсли;
	
	//*******************************************************
	
	НомерСтроки                      = 0;
	НомерСтрокиПП                    = 0;
	
	ПараметрыПечати       			 = Новый Структура;
	РезультирующаяТаблица 			 = Новый ТаблицаЗначений;
	
	МассивСсылок          			 = Новый Массив;
	
	Если ТипЗнч(ОбъектСсылка) = Тип("ДокументСсылка.РегистрацияОбязательствИСведенийПоДоговорам") Тогда
		МассивСсылок.Добавить(ОбъектСсылка);
	Иначе
		МассивСсылок 				 = ОбъектСсылка;
		ОбъектСсылка                 = МассивСсылок[0];
	КонецЕсли;

	ДеревоДанных      	             = РаботаСОбязательствами.ПолучитьДанныеДляИнформацииОСглашенияхНаСубсидии(ПараметрыПечати, МассивСсылок);	
	ДанныеОКонтрагентах              = ДеревоДанных.Контрагенты.Выгрузить();
	
	Для Каждого Колонка Из ДанныеОКонтрагентах.Колонки Цикл
		РезультирующаяТаблица.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	РезультирующаяТаблица.Колонки.Добавить("Индекс");
    РезультирующаяТаблица.Колонки.Добавить("ТипНаселенногоПункта");
	РезультирующаяТаблица.Колонки.Добавить("НаименованиеНаселенногоПункта");
	РезультирующаяТаблица.Колонки.Добавить("ТипИмяУличнойСети");
	РезультирующаяТаблица.Колонки.Добавить("Дом");
	
	РезультирующаяТаблица.Колонки.Добавить("НаименованиеБюджета");
	РезультирующаяТаблица.Колонки.Добавить("КодБюджета");
	
	РезультирующаяТаблица.Колонки.Добавить("НомерПП");
	РезультирующаяТаблица.Колонки.Добавить("НомерСтроки");
	РезультирующаяТаблица.Колонки.Добавить("ИмяТабЧасти",    Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)));
	РезультирующаяТаблица.Колонки.Добавить("ПОЛЕСВЯЗИ");
	
	РезультирующаяТаблица.Колонки.Добавить("НомерСтроки_ГЛ", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)));
	РезультирующаяТаблица.Колонки.Добавить("ИмяТабЧасти_ГЛ", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)));

    НомерОбъекта = 0;
	
	Пока НомерОбъекта < МассивСсылок.Количество() Цикл
		
		ОбъектСсылка                    = МассивСсылок[НомерОбъекта];
		
		СтруктураПоиска                 = Новый Структура("Ссылка", ОбъектСсылка);
    	ТаблицаКонтрагентов             = ДанныеОКонтрагентах.НайтиСтроки(СтруктураПоиска);
		
		Для каждого СтрКонтр Из ТаблицаКонтрагентов Цикл
			
			СтрокаРезультирующейТаблицы = РезультирующаяТаблица.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаРезультирующейТаблицы, СтрКонтр);
			НомерСтроки                                      = НомерСтроки + 1;
			
			СтрокаРезультирующейТаблицы.ИмяТабЧасти		     = ВРег("Контрагенты");
			СтрокаРезультирующейТаблицы.НомерСтроки       	 = НомерСтроки;
			СтрокаРезультирующейТаблицы.ПОЛЕСВЯЗИ            = ИСТИНА;
			
			Если ТипЗнч(СтрокаРезультирующейТаблицы.Контрагент.ЮридическоеФизическоеЛицо) =  Тип("СправочникСсылка.ЮридическиеЛица") Тогда
				Если ЗначениеЗаполнено(СтрокаРезультирующейТаблицы.Контрагент.ЮридическоеФизическоеЛицо.Бюджет) Тогда
					СтрокаРезультирующейТаблицы.НаименованиеБюджета = СтрокаРезультирующейТаблицы.Контрагент.ЮридическоеФизическоеЛицо.Бюджет.НаименованиеПолное;
					СтрокаРезультирующейТаблицы.КодБюджета          = СтрокаРезультирующейТаблицы.Контрагент.ЮридическоеФизическоеЛицо.Бюджет.Код;
				КонецЕсли;
			КонецЕсли;
			
			//*******************************************************************
			
			Если (СтрДлина(СтрКонтр.КонтрагентИНН) = 10) И (ЗначениеЗаполнено(СтрКонтр.КонтрагентЗначенияПолейАдреса)) Тогда
				
				СтрокаРезультирующейТаблицы                  = РезультирующаяТаблица.Добавить();
				НомерСтрокиПП                                = НомерСтрокиПП + 1;
				ЗаполнитьЗначенияСвойств(СтрокаРезультирующейТаблицы, СтрКонтр);
			
				РеквизитыАдресаКонтрагента = ПолучитьРеквизитыАдреса(СтрКонтр.КонтрагентЗначенияПолейАдреса);
				ЗаполнитьЗначенияСвойств(СтрокаРезультирующейТаблицы, РеквизитыАдресаКонтрагента);	
								
				СтрокаРезультирующейТаблицы.НомерПП       	 = НомерСтрокиПП;
						
				СтрокаРезультирующейТаблицы.ИмяТабЧасти   	 = ВРег("Адрес");
				СтрокаРезультирующейТаблицы.НомерСтроки      = НомерСтрокиПП;

				СтрокаРезультирующейТаблицы.ИмяТабЧасти_Гл	 = ВРег("Контрагенты");
				СтрокаРезультирующейТаблицы.НомерСтроки_Гл   = "__"+Строка(НомерСтроки);
				
				СтрокаРезультирующейТаблицы.ПОЛЕСВЯЗИ        = ИСТИНА;
				
			КонецЕсли;

			
		КонецЦикла;
		
		НомерОбъекта                    = НомерОбъекта + 1;
		НомерСтроки                     = 0;

	КонецЦикла;
	
	РезультирующаяТаблица.Колонки["Ссылка"].Имя = "ССЫЛКАДОКУМЕНТА";
	
	Возврат РезультирующаяТаблица;

КонецФункции

// Функция возвращает таблицу значений, используемую в форматах обмена с ОФК.
Функция ТаблицаКонтрагентовОбязательства(знач ОбъектСсылка, НомерФормы = "") Экспорт
	
	// формируем пустую таблицу для построения формата в СКД
	Если НЕ ЗначениеЗаполнено(ОбъектСсылка) Тогда
		
		РезультирующаяТаблица = Новый ТаблицаЗначений;
		
		РезультирующаяТаблица.Колонки.Добавить("КонтрагентНаименование");
		РезультирующаяТаблица.Колонки.Добавить("Контрагент");
		РезультирующаяТаблица.Колонки.Добавить("КонстрагентИНН");
		РезультирующаяТаблица.Колонки.Добавить("КонтрагентКПП");
		РезультирующаяТаблица.Колонки.Добавить("СчетКонтрагента");
		РезультирующаяТаблица.Колонки.Добавить("КонтрагентСтатус");
		
		РезультирующаяТаблица.Колонки.Добавить("КонтрагентБИКБанка");
		РезультирующаяТаблица.Колонки.Добавить("КонтрагентБанковскийсчет");
	    РезультирующаяТаблица.Колонки.Добавить("КонтрагентКорСчетБанка");
		РезультирующаяТаблица.Колонки.Добавить("КонтрагентНаименованиеБанка");
		
		РезультирующаяТаблица.Колонки.Добавить("Адрес");
	    РезультирующаяТаблица.Колонки.Добавить("КодСтраны");
	    РезультирующаяТаблица.Колонки.Добавить("Страна");
	    РезультирующаяТаблица.Колонки.Добавить("Телефон");
		
		РезультирующаяТаблица.Колонки.Добавить("НомерПП");
		РезультирующаяТаблица.Колонки.Добавить("ССЫЛКАДОКУМЕНТА");
		РезультирующаяТаблица.Колонки.Добавить("НомерСтроки");
		РезультирующаяТаблица.Колонки.Добавить("ИмяТабЧасти",       Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)));
		РезультирующаяТаблица.Колонки.Добавить("ПОЛЕСВЯЗИ");
		
		Возврат РезультирующаяТаблица;
		
	КонецЕсли;
	
	//*******************************************************
	
	НомерСтроки                      = 0;
	
	ПараметрыПечати       			 = Новый Структура;
	РезультирующаяТаблица 			 = Новый ТаблицаЗначений;
	
	МассивСсылок          			 = Новый Массив;
	
	Если ТипЗнч(ОбъектСсылка) = Тип("ДокументСсылка.РегистрацияОбязательствИСведенийПоДоговорам") Тогда
		МассивСсылок.Добавить(ОбъектСсылка);
	Иначе
		МассивСсылок 				 = ОбъектСсылка;
		ОбъектСсылка                 = МассивСсылок[0];
	КонецЕсли;

	
	Если НомерФормы = "0506101" Тогда
		ДеревоДанныхПоБО 		     = РаботаСОбязательствами.ПолучитьДанныеДляПечатнойФормы0506101(ПараметрыПечати, МассивСсылок);	
		ДанныеОКонтрагентах          = ДеревоДанныхПоБО.Контрагенты.Выгрузить();
	Иначе	
		Если (ОбъектСсылка.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ПринятоеОбязательствоУчетПредмета) Тогда
			//сведения о принятом БО
			ДеревоДанныхПоБО 		     = РаботаСОбязательствами.ПолучитьДанныеДляПечатнойФормы0531702_151н(ПараметрыПечати, МассивСсылок);		
		Иначе
			//внесение изменений в БО
			ДеревоДанныхПоБО 			 = РаботаСОбязательствами.ПолучитьДанныеДляПечатнойФормы0531705_151н(ПараметрыПечати, МассивСсылок);		
		КонецЕсли;
		
		ДанныеОКонтрагентах              = ДеревоДанныхПоБО.Контрагенты.Выгрузить();
	    ДанныеКонтактнойИнформации 		 = ДеревоДанныхПоБО.КонтактнаяИнформация.Выгрузить();
	КонецЕсли;
		
	//СтруктураПоиска                  = Новый Структура("Ссылка", ОбъектСсылка);
	//ТаблицаКонтрагентовОбязательства = ДанныеОКонтрагентах.НайтиСтроки(СтруктураПоиска);
	
	Для Каждого Колонка Из ДанныеОКонтрагентах.Колонки Цикл
		РезультирующаяТаблица.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
	КонецЦикла;
	
	РезультирующаяТаблица.Колонки.Добавить("НомерПП");
	РезультирующаяТаблица.Колонки.Добавить("НомерСтроки");
	РезультирующаяТаблица.Колонки.Добавить("ИмяТабЧасти",    Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)));
	РезультирующаяТаблица.Колонки.Добавить("ПОЛЕСВЯЗИ");
		
	РезультирующаяТаблица.Колонки.Добавить("КонтрагентБИКБанка");
	РезультирующаяТаблица.Колонки.Добавить("КонтрагентБанковскийсчет");
    РезультирующаяТаблица.Колонки.Добавить("КонтрагентКорСчетБанка");
	РезультирующаяТаблица.Колонки.Добавить("КонтрагентНаименованиеБанка");
	
	РезультирующаяТаблица.Колонки.Добавить("Адрес");
    РезультирующаяТаблица.Колонки.Добавить("КодСтраны");
    РезультирующаяТаблица.Колонки.Добавить("Страна");
    РезультирующаяТаблица.Колонки.Добавить("Телефон");
	
	НомерОбъекта = 0;
	
	Пока НомерОбъекта < МассивСсылок.Количество() Цикл
		
		ОбъектСсылка                    = МассивСсылок[НомерОбъекта];
		
		СтруктураПоиска                 = Новый Структура("Ссылка", ОбъектСсылка);
    	ТаблицаКонтрагентов             = ДанныеОКонтрагентах.НайтиСтроки(СтруктураПоиска);
		
		Для каждого СтрКонтр Из ТаблицаКонтрагентов Цикл
			
			РеквизитыКонтрагентаПоСчету = Новый Структура("КонтрагентБанковскийСчет, КонтрагентНаименованиеБанка, КонтрагентБИКБанка, КонтрагентКорСчетБанка", "СчетНомер", "Банк", "БИК", "КоррСчет");
			ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(СтрКонтр.СчетКонтрагента, СтрКонтр.СчетКонтрагента, РеквизитыКонтрагентаПоСчету, , Истина);	
			
			СтрокаРезультирующейТаблицы = РезультирующаяТаблица.Добавить();
			НомерСтроки                 = НомерСтроки + 1;

			
