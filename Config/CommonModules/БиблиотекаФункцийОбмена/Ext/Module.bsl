// Преобразует строку в файле передачи в дату 
// Параметры - Значение - Строка(10) или Строка(8),
//			строковое представление даты в формате "ДД.ММ.ГГГГ"
//			или "ДДММГГГГ"  
// Возвращаемое значение - Дата
//
Функция ПреобразованиеСтрокиВДату(Значение) ЭКСПОРТ
	
	Если ТипЗнч(Значение) = Тип("Дата") Тогда		
		Возврат Значение;	
	КонецЕсли;  
	
	СтрокаДаты = СтрЗаменить(Значение, ".", ""); 
	
	Если НЕ ЗначениеЗаполнено(СтрокаДаты) 
		ИЛИ НЕ СтрДлина(СтрокаДаты) = 8
		ИЛИ НЕ СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(СтрокаДаты) Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;   
	
	Возврат Дата(Число(Прав(СтрокаДаты,4)), Число(Сред(СтрокаДаты, 3, 2)), Число(Лев(СтрокаДаты, 2)));
	
КонецФункции

// Устарело. Следует использовать ПреобразованиеСтрокиВДату
// Оставлена т.к. может применяться в настройках формата обмена
//
Функция ПребразованиеСтрокиВДату(Значение) ЭКСПОРТ
	
	Возврат ПреобразованиеСтрокиВДату(Значение);
	
КонецФункции

// преобразует числовое представление вида КБК в ссылку на соответствующее перечисление
//
// Параметры:
// 		Значение				 - числовое представление типа КБК заданного вида: "10" - расходы; "31" - КИВФ; "32" - КИВнФ
/// Возвращаемое значение:
// 		Тип: Либо ссылка на элемент перечисления "Виды КБК", либо пустая строка (в случае неудачного поиска)
Функция ПолучитьВидКБК(Значение) ЭКСПОРТ
	
	Если СокрЛП(Значение) = "10" 		Тогда
		Возврат Перечисления.ВидыКБК.КРБ;
	ИначеЕсли СокрЛП(Значение) = "20" 		Тогда
		Возврат Перечисления.ВидыКБК.КДБ;
	ИначеЕсли СокрЛП(Значение) = "31" 	Тогда
		Возврат Перечисления.ВидыКБК.КИФ;
	ИначеЕсли СокрЛП(Значение) = "32" 	Тогда
		Возврат Перечисления.ВидыКБК.КИФ;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// находит КБК по его 17-значному коду (наименование)
//
// Параметры:
// 		ПрефиксСчета				 - префикс счета, строка (20)
// 		ВидКБК						 - перечисление ссылка "Виды КБК"
// 		СоздаватьНовые				 - флаг, разрешающий создавать новые элементы КПС в ИБ (булево), по умолчанию ЛОЖЬ
/// Возвращаемое значение:
// 		Тип: Либо ссылка на элемент справочника КБК, либо пустая строка (в случае неудачного поиска)
Функция НайтиКБКПоНаименованию(ПрефиксСчета, ВидКБК = Неопределено, СоздаватьНовые = Ложь, ЭтоАУБУ = Ложь, ЭтоКазенное = Ложь, ДатаКБК = Неопределено)     ЭКСПОРТ
	
	Если НЕ ЗначениеЗаполнено(ПрефиксСчета) Тогда       
		Возврат "";
	КонецЕсли;
	
	Если ДатаКБК = Неопределено Тогда
		ДатаКБК = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПрефиксСчета", 	СокрЛП(ПрефиксСчета));
	Запрос.УстановитьПараметр("ВидКБК", 		ВидКБК);
	Запрос.УстановитьПараметр("ДатаКБК", 		ДатаКБК);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ 
	               |	КБК.Ссылка КАК элементКБК,
				   |    КБК.ВидПоказателя
	               |ИЗ
	               |	Справочник.КлассификационныеПризнакиСчетов КАК КБК
	               |ГДЕ 
				   |";
				   
	Если ВидКБК <> Неопределено Тогда	   		   
		Запрос.Текст = Запрос.Текст  + "			   
				   |	(КБК.ВидПоказателя = &ВидКБК ИЛИ КБК.УточнениеПоказателя.Ссылка = &ВидКБК
				   |			ИЛИ КБК.ВидПоказателя = ЗНАЧЕНИЕ(Перечисление.ВидыКБК.Произвольный)
				   |            ИЛИ &ВидКБК В (НЕОПРЕДЕЛЕНО, Значение(Перечисление.ВидыКБК.ПустаяСсылка), NULL, """")) 
	               |				И "
	КонецЕсли;
			   
	Запрос.Текст = Запрос.Текст  + "			   
				   |                КБК.Код = &ПрефиксСчета
	               |				И КБК.ПометкаУдаления = ЛОЖЬ
				   |				И КБК.ДатаНачалаДействия <= &ДатаКБК
				   |				И КБК.ДатаОкончанияДействия >= &ДатаКБК
				   |УПОРЯДОЧИТЬ ПО
				   |    КБК.ВидПоказателя";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если (Результат.Количество() = 1) И НЕ(ЭтоКазенное И Результат[0].ВидПоказателя = Перечисления.ВидыКБК.АУИБУ) Тогда
		Возврат Результат[0].элементКБК;
	ИначеЕсли Результат.Количество() > 1 Тогда
		Если ЭтоАУБУ Тогда
			Возврат ?(Результат[0].ВидПоказателя = Перечисления.ВидыКБК.АУИБУ, Результат[0].элементКБК, Результат[1].элементКБК)
		Иначе
			Возврат ?(Результат[0].ВидПоказателя = Перечисления.ВидыКБК.АУИБУ, Результат[1].элементКБК, Результат[0].элементКБК)
		КонецЕсли
	Иначе	
		ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(
															НСтр("ru='КПС с кодом [ПрефиксСчета] отсутствует в информационной базе!'"),
															Новый Структура("ПрефиксСчета", СокрЛП(ПрефиксСчета))));
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// находит описание заданного Платежного поручения в структуре
Функция НайтиОписаниеППВСтруктуре(Структура, GUIDВып, НомерЛС, ДатаВыписки, GUIDПП)     ЭКСПОРТ
	
	СтрокаВыписки = "";
	
	Структура.Сортировать("GUIDВыписки Возр");
	
	Если НЕ((GUIDВып = "") ИЛИ (Структура[Структура.Количество()-1].GUIDВыписки = "" )) Тогда
		СтрокаВыписки	= Структура.Найти(GUIDВып, "GUIDВыписки");    
		Если СтрокаВыписки = Неопределено Тогда
			СтрокаВыписки	= Структура.Найти(Врег(GUIDВып), "GUIDВыписки");
		КонецЕсли; 
		Если СтрокаВыписки = Неопределено Тогда
			СтрокаВыписки	= Структура.Найти(Нрег(GUIDВып), "GUIDВыписки");
		КонецЕсли;
		Если СтрокаВыписки = Неопределено Тогда
			Возврат "";
		КонецЕсли;
	КонецЕсли;
	
	Если СтрокаВыписки = "" Тогда
		РезультатСтроки = Структура.НайтиСтроки(Новый Структура("НомерЛС, ДатаВыписки", НомерЛС, ДатаВыписки));
		
		Если РезультатСтроки.Количество()>0 Тогда
			СтрокаВыписки = РезультатСтроки[0];
		Иначе
			Возврат "";
		КонецЕсли;
	КонецЕсли;
	
	СтрокаПП = СтрокаВыписки.СписокПП.Найти(GUIDПП, "GUID");  
	
	Если СтрокаПП = Неопределено Тогда
		СтрокаПП = СтрокаВыписки.СписокПП.Найти(Врег(GUIDПП), "GUID");
	КонецЕсли;
	
	Если СтрокаПП = Неопределено Тогда
		СтрокаПП = СтрокаВыписки.СписокПП.Найти(Нрег(GUIDПП), "GUID");
	КонецЕсли;
	
	Если СтрокаПП = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат СтрокаПП;
	
КонецФункции

// устанавливает первичный печатный образ для заявки
// Параметры:
// 		ЗаявкаСсылка				 - ссылка на Заявку, для которой необходимо заполнить реквизит "Первичный образ и реквизиты ОФК"
// 		Структура					 - ТЗ, заданного вида с информацией о ПП из банка
// 		GUIDВып						 - уникальный идентификатор, по которому определяется выписка в структуре
// 		ДатаВыписки					 - дата, на которую оформлена выписка
// 		GUIDПП						 - уникальный идентификатор Платежного поручения, на основании которого необходимо оформить Кассовое поступление
Процедура ЗаписатьОбразПервичногоДокументаЗаявки(ЗаявкаСсылка, Структура, GUIDВып, ДатаВыписки, GUIDПП, ПроизвольныеПараметры = Неопределено)     ЭКСПОРТ
	
	Если ПроизвольныеПараметры = Неопределено Тогда
		ПроизвольныеПараметры = Новый Соответствие;
	КонецЕсли;   
	
	УЗаявкиЕстьПервичныйОбраз = Ложь;
	
	СостояниеВыписки = Неопределено;
	Если Структура.Количество() > 0 Тогда
		
		Если ТипЗнч(GUIDВып) = Тип("Строка") тогда 
			СтрокаПП = НайтиОписаниеППВСтруктуре(Структура, GUIDВып, ЗаявкаСсылка.ЛицевойСчет, ДатаВыписки, GUIDПП);	
		Иначе	
			СостояниеВыписки = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(GUIDВып);
			СтрокаПП = НайтиОписаниеППВСтруктуре(Структура, СостояниеВыписки.GUIDКО, ЗаявкаСсылка.ЛицевойСчет, ДатаВыписки, GUIDПП);	
		КонецЕсли;			
		
		Если НЕ (СтрокаПП = "") Тогда
			
			Если ТипЗнч(СостояниеВыписки) <> Тип("Структура") и ТипЗнч(GUIDВып) = Тип("Строка") тогда
				ВыпискаСсылка	 = НайтиДокументПоGUID("ВыпискаИзЛицевогоСчета",GUIDВып);
				СостояниеВыписки = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(ВыпискаСсылка);
			КонецЕсли;
			// Возможна ситуация если ЗКР ранее был присвоен номер БО ОФК, тогда он будет уничтожен. Надо менять.
			
			СостояниеЗаявки = Новый Структура;
	
			Для каждого КлючЗначение из СостояниеВыписки цикл
				СостояниеЗаявки.Вставить(КлючЗначение.Ключ,КлючЗначение.Значение);
			КонецЦикла;	
			
			// создание массива первичных образов
			СостояниеЗаявкиДо = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(ЗаявкаСсылка);
			
			МассивОбразов = "";
			
			Если ТипЗнч(СостояниеЗаявкиДо.ПервичныйОбразИРеквизиты) = Тип("ХранилищеЗначения") Тогда
				МассивОбразов = СостояниеЗаявкиДо.ПервичныйОбразИРеквизиты.Получить();
			КонецЕсли;
			
			Если ТипЗнч(МассивОбразов) <> Тип("Массив") Тогда
				МассивОбразов = Новый Массив;
			КонецЕсли;
			
			Для Каждого СтруктураПараметров Из  МассивОбразов Цикл
				Если (СтруктураПараметров = Неопределено ИЛИ ТипЗнч(СтруктураПараметров) <> Тип("Структура")) ИЛИ
				//сохраненный ранее образ неопределенной структуры	
			    (НЕ СтрокаПП.ПечатныйОбраз.Свойство("ОФКGUID") ИЛИ НЕ СтруктураПараметров.Свойство("ОФКGUID")) ИЛИ
				//сохраненный ранее образ не содержит GUID	
				(СтрокаПП.ПечатныйОбраз.ОФКGUID = СтруктураПараметров.ОФКGUID) Тогда
				//сохраненный образ соотвествует этому документу	
					МассивОбразов.Очистить();
				КонецЕсли;
			КонецЦикла;
			
			Если СтрокаПП.ПечатныйОбраз <> Неопределено Тогда
				МассивОбразов.Добавить(СтрокаПП.ПечатныйОбраз);	
			КонецЕсли;

			СостояниеЗаявки.ПервичныйОбразИРеквизиты		= Новый ХранилищеЗначения(МассивОбразов);
			СостояниеЗаявки.GUIDКО 							= GUIDПП;
			СостояниеЗаявки.Статус 							= перечисления.СтатусыИсполненияДокумента.Исполнен;
			Если ПроизвольныеПараметры["НомерПодтверждающегоДокумента"] <> Неопределено Тогда
				СостояниеЗаявки.НомерПодтверждающегоДокумента	= ПроизвольныеПараметры["НомерПодтверждающегоДокумента"];
			Иначе 
				СостояниеЗаявки.НомерПодтверждающегоДокумента	= СвойствоСтруктуры(СтрокаПП.ПечатныйОбраз, "НомерДокумента");
			КонецЕсли;
			Если ПроизвольныеПараметры["ДатаПодтверждающегоДокумента"] <> Неопределено Тогда
				СостояниеЗаявки.ДатаПодтверждающегоДокумента	= ПроизвольныеПараметры["ДатаПодтверждающегоДокумента"];
			Иначе
				СостояниеЗаявки.ДатаПодтверждающегоДокумента	= ПреобразованиеСтрокиВДату(СвойствоСтруктуры(СтрокаПП.ПечатныйОбраз, "ДатаДокумента"));
			КонецЕсли;
			Если ПроизвольныеПараметры["ВидПодтверждающегоДокумента"] <> Неопределено Тогда
				СостояниеЗаявки.ВидПодтверждающегоДокумента = ПроизвольныеПараметры["ВидПодтверждающегоДокумента"];
		    ИначеЕсли ЗначениеЗаполнено(СтрокаПП.ИмяДок) Тогда
		        СостояниеЗаявки.ВидПодтверждающегоДокумента   = СтрокаПП.ИмяДок;
			Иначе
				СостояниеЗаявки.ВидПодтверждающегоДокумента = ПлатежноРасчетныеДокументы.ОпределитьВидПодтверждающегоДокумента(СтрокаПП.ПечатныйОбраз["ВидОперации"]);
			КонецЕсли;
			
			СостояниеЗаявки.Вставить("ПлатежноРасчетныйДокумент",ЗаявкаСсылка);
			Если ТипЗнч(СтрокаПП.СписокСтрокПП) = Тип("ТаблицаЗначений") И СтрокаПП.СписокСтрокПП.Количество()>0 Тогда
				СостояниеЗаявки.НомерОбязательства = СтрокаПП.СписокСтрокПП[0].НомерБО;
			КонецЕсли;
			
			Если НачалоДня(ЗаявкаСсылка.Дата) = НачалоДня(ДатаВыписки) Тогда
			    СостояниеЗаявки.ДатаПроведения = ЗаявкаСсылка.Дата;
			Иначе
				СостояниеЗаявки.ДатаПроведения = ДатаВыписки;
			КонецЕсли;
				
			ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СостояниеЗаявки);  
			УЗаявкиЕстьПервичныйОбраз = Истина;
					
		КонецЕсли;
		
	КонецЕсли; 
	
	Если НЕ УЗаявкиЕстьПервичныйОбраз Тогда     
		
		СостояниеЗаявки = Новый Структура;
		
		// создание массива первичных образов
		СостояниеЗаявкиДо = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(ЗаявкаСсылка);
		
		Для каждого КлючЗначение из СостояниеЗаявкиДо цикл
			СостояниеЗаявки.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЦикла;	

		СостояниеЗаявки.Статус 	= перечисления.СтатусыИсполненияДокумента.Исполнен; 
		СостояниеЗаявки.Вставить("ПлатежноРасчетныйДокумент", ЗаявкаСсылка);
		
		Если ПроизвольныеПараметры["НомерПодтверждающегоДокумента"] <> Неопределено Тогда
			СостояниеЗаявки.НомерПодтверждающегоДокумента	= ПроизвольныеПараметры["НомерПодтверждающегоДокумента"];
		КонецЕсли;
		Если ПроизвольныеПараметры["ДатаПодтверждающегоДокумента"] <> Неопределено Тогда
			СостояниеЗаявки.ДатаПодтверждающегоДокумента	= ПроизвольныеПараметры["ДатаПодтверждающегоДокумента"];
		КонецЕсли;
		Если ПроизвольныеПараметры["ВидПодтверждающегоДокумента"] <> Неопределено Тогда
			СостояниеЗаявки.ВидПодтверждающегоДокумента = ПроизвольныеПараметры["ВидПодтверждающегоДокумента"];
		КонецЕсли;
		
		Если НачалоДня(ЗаявкаСсылка.Дата) = НачалоДня(ДатаВыписки) Тогда
		    СостояниеЗаявки.ДатаПроведения = ЗаявкаСсылка.Дата;
		Иначе
			СостояниеЗаявки.ДатаПроведения = ДатаВыписки;
		КонецЕсли;
			
		ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СостояниеЗаявки);  
		
	КонецЕсли;
	
КонецПроцедуры

// находит/создает счет для контрагента по заданным параметрам
Функция ОпределитьСчетКонтрагента(Владелец, НомерСчета, БИКБанка = "", НаименованиеБанка = "", КорСчетБанка = "", 
	                              СоздаватьЭлементы = Истина, КодТОФК = "", НаименованиеТОФК = "")     ЭКСПОРТ
	
	Если НомерСчета = "" Тогда
		Возврат "";
	КонецЕсли;
	
	СчетКонтрагента = Справочники.БанковскиеИКазначейскиеСчета.НайтиПоКоду(НомерСчета,,, Владелец);
	
	Если НЕ ЗначениеЗаполнено(СчетКонтрагента) Тогда
		
		Если СоздаватьЭлементы Тогда
			
			СчетКонтрагента					 = Справочники.БанковскиеИКазначейскиеСчета.СоздатьЭлемент();
			СчетКонтрагента.Владелец		 = Владелец;
			СчетКонтрагента.Код				 = НомерСчета;
			
			Если СтрДлина(НомерСчета) = 11 Тогда
				
				СчетКонтрагента.ТипЛицевогоСчета = Перечисления.ТипыЛицевыхСчетов.Казначейский;
				СчетКонтрагента.Наименование	 = "Лицевой счет";
				
				Если ЗначениеЗаполнено(КодТОФК) Тогда
					
					Казначейство = Справочники.Казначейства.НайтиПоКоду(КодТОФК);
					
					Если Казначейство.Пустая() Тогда
						
						Казначейство                    = Справочники.Казначейства.СоздатьЭлемент();
						
						Казначейство.Код                = КодТОФК;
						Казначейство.Наименование       = НаименованиеТОФК;
						Казначейство.НаименованиеПолное = НаименованиеТОФК;
						
						Казначейство.Записать();
						
					КонецЕсли;
					
					СчетКонтрагента.КассовыйОрган = Казначейство.Ссылка;
					
				КонецЕсли;
				
			Иначе
				СчетКонтрагента.ТипЛицевогоСчета = Перечисления.ТипыЛицевыхСчетов.Банковский;
				СчетКонтрагента.Наименование	 = "Расчетный счет";
				
				Если ЗначениеЗаполнено(БИКБанка) Тогда
					
					Банк	= Справочники.Банки.НайтиПоКоду(БИКБанка);
					
					Если Банк.Пустая() Тогда
						
						Банк = Справочники.КлассификаторБанков.НайтиПоКоду(БИКБанка); 
						
						Если НЕ Банк.Пустая() Тогда 
							
							МассивБанковИзКлассификатора = Новый Массив;
							МассивБанковИзКлассификатора.Добавить(Банк);
							МассивБанков         = РаботаСБанкамиБГУ.ПодобратьБанкИзКлассификатора(МассивБанковИзКлассификатора);
							
							Банк                 = МассивБанков[МассивБанков.Количество() - 1]
							
						Иначе
							Банк				 = Справочники.Банки.СоздатьЭлемент();
							
							Банк.Код			 = БИКБанка;
							Банк.Наименование	 = НаименованиеБанка;
							Банк.КоррСчет		 = КорСчетБанка;
							Банк.РучноеИзменение = 1;
							
							Банк.Записать();
							
						КонецЕсли;
					КонецЕсли;
					
					СчетКонтрагента.КассовыйОрган	 = Банк.Ссылка;
					
				КонецЕсли;
			
			КонецЕсли;	
				
			Попытка
				СчетКонтрагента.Записать();
			Исключение
				Возврат "";
			КонецПопытки;
			
			Возврат СчетКонтрагента.Ссылка;
			
		КонецЕсли;
	Иначе
		Возврат СчетКонтрагента;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ОпределитьАУБУ(Организация, НаДату)  ЭКСПОРТ
	
	Если (НЕ ЗначениеЗаполнено(Организация)) ИЛИ (НЕ ЗначениеЗаполнено(НаДату)) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	НастройкиСтруктурРПС.ТипКПС,
    |	НастройкиСтруктурРПС.КФО
	|ИЗ
	|	РегистрСведений.НастройкиСтруктурРПС КАК НастройкиСтруктурРПС
	|ГДЕ
	|	(НастройкиСтруктурРПС.СтруктураРПС = &СтруктураРПС) И
	|  ((НастройкиСтруктурРПС.КФО = &КФОБюджет) ИЛИ (НастройкиСтруктурРПС.ТипКПС = &ТипКБКАУБУ))");
	
	Запрос.УстановитьПараметр("СтруктураРПС", БухгалтерскийУчетПовтИсп.ТекущаяСтруктураРПС(Организация, , НаДату)); 
    Запрос.УстановитьПараметр("КФОБюджет",    Перечисления.КВД.Бюджет); 
	Запрос.УстановитьПараметр("ТипКБКАУБУ",   Перечисления.ТипыАналитическихПризнаков.КлассификацияАУБУ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Если Выборка.КФО = Перечисления.КВД.Бюджет Тогда
			Возврат Ложь;
		ИначеЕсли Выборка.ТипКПС = Перечисления.ТипыАналитическихПризнаков.КлассификацияАУБУ Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ложь;

КонецФункции

Функция ОпределитьРасшифровку(Структура, ОбъектСсылка, GUIDПП, СуммаПоступления, ДатаДок = "", НомерДок = "") ЭКСПОРТ
	
	Если Структура.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	СостояниеВыписки = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(ОбъектСсылка);
	
	Если НЕ ЗначениеЗаполнено(ДатаДок) ИЛИ НЕ ЗначениеЗаполнено(НомерДок) Тогда 
		
		СтрокаПП         = НайтиОписаниеППВСтруктуре(Структура, СостояниеВыписки.GUIDКО, ОбъектСсылка.ЛицевойСчет.Код, ОбъектСсылка.ДатаВыписки, GUIDПП);
	
		Если СтрокаПП    = "" Тогда
			Возврат "";
		КонецЕсли; 
		
		Если НЕ ЗначениеЗаполнено(СтрокаПП.ДатаДок) ИЛИ НЕ ЗначениеЗаполнено(СтрокаПП.НомерДок) ИЛИ НЕ ЗначениеЗаполнено(СтрокаПП.ИмяДок)  Тогда
			Возврат "";
		КонецЕсли; 
		
		Если  Найти(ВРЕГ(СтрокаПП.ИмяДок), "РАСШИФРОВКА") = Неопределено  Тогда   
			Возврат "";
		КонецЕсли;
		
		ДатаДок  = СтрокаПП.ДатаДок; 
		НомерДок = СтрокаПП.НомерДок;
		
	КонецЕсли;  
						
	Запрос   = Новый Запрос;
	
	Запрос.УстановитьПараметр("НомерЛС", 		СокрЛП(ОбъектСсылка.ЛицевойСчет.Код));
	Запрос.УстановитьПараметр("ПолныйНомерДок", ВосстановитьНомерДляИБ(ОбъектСсылка.Организация, НомерДок, "ПлатежноеПоручение"));
	Запрос.УстановитьПараметр("НомерДок",       НомерДок);
	Запрос.УстановитьПараметр("ДатаДокНач", 	НачалоДня(ДатаДок));
	Запрос.УстановитьПараметр("ДатаДокКон", 	КонецДня(ДатаДок));
	Запрос.УстановитьПараметр("СуммаДокумента", СуммаПоступления);


    Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	           |	РасшифровкаСредств.Ссылка КАК ДокументСсылка
               |	ИЗ
               |		Документ.РасшифровкаВнесенныхЧерезБанкоматСредств КАК РасшифровкаСредств
			   |	ГДЕ
			   |	   (РасшифровкаСредств.Номер = &НомерДок  ИЛИ  РасшифровкаСредств.Номер = &ПолныйНомерДок)
			   |		И РасшифровкаСредств.СуммаДокумента = &СуммаДокумента
			   |		И РасшифровкаСредств.ЛицевойСчет.Код = &НомерЛС
			   |		И РасшифровкаСредств.Дата >= &ДатаДокНач
			   |		И РасшифровкаСредств.Дата <= &ДатаДокКон
			   |";
			 
			 
	Результат = Запрос.Выполнить().Выбрать();

	Если Результат.Следующий() Тогда
		Возврат Результат.ДокументСсылка;
	КонецЕсли;
			
	Возврат "";
	
КонецФункции

Функция СоздатьКассовоеВыбытиеНаОснованииЗаявленияНаАккредитив(НомерКОО, СуммаСписания, ДатаВыписки) ЭКСПОРТ
	
	Если Не ЗначениеЗаполнено(НомерКОО) Тогда
		Возврат "";
	КонецЕсли;
	
	Запрос   = Новый Запрос;
			
	Запрос.УстановитьПараметр("НомерКОО", НомерКОО);

    Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
                   |	ЗаявлениеНаВыдачуКазначейскогоАккредитива.Ссылка КАК Ссылка
                   |ИЗ
                   |	Документ.ЗаявлениеНаВыдачуКазначейскогоАккредитива КАК ЗаявлениеНаВыдачуКазначейскогоАккредитива
                   |ГДЕ
                   |	ЗаявлениеНаВыдачуКазначейскогоАккредитива.НомерАккредитива = &НомерКОО
                   |	И ЗаявлениеНаВыдачуКазначейскогоАккредитива.Проведен = Истина
				   |УПОРЯДОЧИТЬ ПО
				   |    ЗаявлениеНаВыдачуКазначейскогоАккредитива.Дата  УБЫВ
				   |";
					 				 
	Результат = Запрос.Выполнить().Выбрать();

	Если Результат.Следующий() Тогда
		
		КассовоеВыбытие                = Документы.КассовоеВыбытие.СоздатьДокумент();
		Попытка
			КассовоеВыбытие.Заполнить(Результат.Ссылка);
		Исключение
			Возврат "";
		КонецПопытки;
		
		КассовоеВыбытие.Дата			      = КонецДня(ДатаВыписки);
		КассовоеВыбытие.СуммаДокумента        = СуммаСписания;
		КассовоеВыбытие.СуммаДокументаВВалюте = СуммаСписания;
		
		Если КассовоеВыбытие.РасшифровкаПлатежа.Количество() > 0 Тогда
			 КассовоеВыбытие.РасшифровкаПлатежа[0].СуммаВал = СуммаСписания;
			 КассовоеВыбытие.РасшифровкаПлатежа[0].Сумма    = СуммаСписания;
		КонецЕсли;
		
		Попытка
			КассовоеВыбытие.Записать();
		Исключение
			Возврат "";
		КонецПопытки;
		
		Возврат КассовоеВыбытие.Ссылка;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ОпределитьКассовоеПоступлениеПоДаннымВходящегоДокумента(Номер, Дата, ЛицевойСчет, Организация) 
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |КассовоеПоступление.Ссылка КАК ссылка
				   | ИЗ Документ.КассовоеПоступление КАК КассовоеПоступление 
				   |    ГДЕ КассовоеПоступление.НомерПервичногоДокумента = &Номер
				   |        И КассовоеПоступление.ДатаПервичногоДокумента = &Дата
				   |        И КассовоеПоступление.ЛицевойСчет = &ЛицевойСчет
				   |        И КассовоеПоступление.Организация = &Организация
				   |";	
				   
	Запрос    = Новый Запрос(ТекстЗапроса);
	
	Запрос.УстановитьПараметр("Номер",       Номер); 
	Запрос.УстановитьПараметр("Дата",        Дата);
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Результат = Запрос.Выполнить().Выбрать();
	Результат.Следующий();
	
	Возврат  Результат.Ссылка;

КонецФункции	

Функция СоздатьКассовоеПоступлениеНаОснованииПечатногоОбразаПП(ПечатныйОбраз, Задание, ДанныеНовыхКонтрагентов = Неопределено) ЭКСПОРТ
	
	ЛицевойСчет               = НайтиЛицевойСчетПоНомеру(СвойствоСтруктуры(ПечатныйОбраз, "НомерСчетаПолучателя"));
	КассовоеПоступлениеСсылка = ОпределитьКассовоеПоступлениеПоДаннымВходящегоДокумента(СвойствоСтруктуры(ПечатныйОбраз, "НомерДокумента"),
	                            ПреобразованиеСтрокиВДату(СвойствоСтруктуры(ПечатныйОбраз, "ДатаДокумента")), ЛицевойСчет, Задание.Организация);     
	СуммаПоступления          = Число(СвойствоСтруктуры(ПечатныйОбраз, "СуммаДокумента"))/100; 
	
	Если ЗначениеЗаполнено(КассовоеПоступлениеСсылка) Тогда 
		
		Если Задание.ВидОбмена.ОтменаПовторнойЗагрузкиПроведенныхДокументов И КассовоеПоступлениеСсылка.Проведен Тогда     
			
			Сообщение    = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(НСтр("ru='Документ [Документ] был загружен ранее и проведен. Он останется без изменений.'"),
																									Новый Структура("Документ", 
																													КассовоеПоступлениеСсылка));
			ОбщегоНазначения.СообщитьПользователю(Сообщение);
		
			Возврат КассовоеПоступлениеСсылка;
		КонецЕсли;
					
		КассовоеПоступление = КассовоеПоступлениеСсылка.ПолучитьОбъект();
		КассовоеПоступление.РасшифровкаПлатежа.Очистить(); 
	Иначе
		КассовоеПоступление = Документы.КассовоеПоступление.СоздатьДокумент();
	КонецЕсли;   
	
	КассовоеПоступление.Организация         = Задание.Организация;   
	КассовоеПоступление.ЛицевойСчет         = ЛицевойСчет;
	КассовоеПоступление.НазначениеПлатежа 	= СвойствоСтруктуры(ПечатныйОбраз, "НазначениеПлатежа"); 
	КассовоеПоступление.Дата				= ?(ЗначениеЗаполнено(СвойствоСтруктуры(ПечатныйОбраз, "ДатаДокумента")), ПреобразованиеСтрокиВДату(СвойствоСтруктуры(ПечатныйОбраз, "ДатаДокумента")), ТекущаяДата());
    КассовоеПоступление.СуммаДокумента		= СуммаПоступления;
	
	КассовоеПоступление.ВалютаДокумента				 = Константы.ВалютаРегламентированногоУчета.Получить();
	КассовоеПоступление.СуммаДокументаВВалюте		 = СуммаПоступления;
	КассовоеПоступление.Курс						 = 1;
	КассовоеПоступление.Кратность					 = 1;   
	
	Строка							                 = КассовоеПоступление.РасшифровкаПлатежа.Добавить();  
	Строка.Сумма                                     = СуммаПоступления;
    Строка.СуммаВал					                 = СуммаПоступления;
	
	КассовоеПоступление.Плательщик				     = ОпределитьКонтрагента(СвойствоСтруктуры(ПечатныйОбраз, "ИННПлательщика"), СвойствоСтруктуры(ПечатныйОбраз, "КПППлательщика"), СвойствоСтруктуры(ПечатныйОбраз, "ТекстПлательщика"),,, Задание.ВидОбмена, ДанныеНовыхКонтрагентов);

	КассовоеПоступление.ВидПервичногоДокумента       = "Платежное поручение";
	КассовоеПоступление.НомерПервичногоДокумента	 = СвойствоСтруктуры(ПечатныйОбраз, "НомерДокумента");
	КассовоеПоступление.ДатаПервичногоДокумента	     = ПреобразованиеСтрокиВДату(СвойствоСтруктуры(ПечатныйОбраз, "ДатаДокумента"));   
	
	КассовоеПоступление.Контрагент		             = КассовоеПоступление.Плательщик;
	КассовоеПоступление.СчетКонтрагента              = ОпределитьСчетКонтрагента(КассовоеПоступление.Контрагент, 
																СвойствоСтруктуры(ПечатныйОбраз, "НомерСчетаПлательщика"), 
									  							СвойствоСтруктуры(ПечатныйОбраз, "БИКБанкаПлательщика"),
																СвойствоСтруктуры(ПечатныйОбраз, "НаименованиеБанкаПлательщика"), 
									  							СвойствоСтруктуры(ПечатныйОбраз, "СчетБанкаПлательщика"));

		
	Попытка
		КассовоеПоступление.Записать();
	Исключение
		Возврат "";
	КонецПопытки;
	
	СостояниеКассовоеПоступление = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(КассовоеПоступление.Ссылка);		
	
	СостояниеКассовоеПоступление.ПервичныйОбразИРеквизиты	= Новый ХранилищеЗначения(ПечатныйОбраз);
	СостояниеКассовоеПоступление.Статус 					= Перечисления.СтатусыИсполненияДокумента.Исполнен;
	СостояниеКассовоеПоступление.Вставить("ПлатежноРасчетныйДокумент",КассовоеПоступление.Ссылка);
	
	СостояниеКассовоеПоступление.НомерПодтверждающегоДокумента	= КассовоеПоступление.НомерПервичногоДокумента;
	СостояниеКассовоеПоступление.ДатаПодтверждающегоДокумента	= КассовоеПоступление.ДатаПервичногоДокумента;
	СостояниеКассовоеПоступление.ВидПодтверждающегоДокумента    = КассовоеПоступление.ВидПервичногоДокумента;
		
	ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СостояниеКассовоеПоступление);
	
	Возврат КассовоеПоступление.Ссылка;
	
КонецФункции	

// создает Документ КассовоеПоступление по заданным параметрам
// Параметры:
// 		Структура					 - ТЗ, заданного вида с информацией о ПП из банка
// 		ОбъектСсылка				 - Ссылка на выписку, в состав которой должно войти данное Кассовое поступление
// 		GUIDПП						 - уникальный идентификатор Платежного поручения, на основании которого необходимо оформить Кассовое поступление
// 		КВД							 - ссылка на значение перечисления КВД;
// 		ИсточникСредств				 - ссылка на предопределенное значение справочника Источники средств
// 		СуммаПоступления			 - сумма документа КассовоеПоступление
/// Возвращаемое значение:
// 		Тип: Либо ссылка на документ КассовоеПоступление, либо пустая строка (в случае неудачного поиска)
Функция СоздатьКассовоеПоступление(Структура, ОбъектСсылка, GUIDПП, КВД, ИсточникСредств, СуммаПоступления, ПроизвольныеПараметры = Неопределено, ВидОбмена = Неопределено, ДанныеНовыхКонтрагентов = Неопределено)     ЭКСПОРТ

	Если Структура.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	СостояниеВыписки           = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(ОбъектСсылка);
	СтрокаПП                   = НайтиОписаниеППВСтруктуре(Структура, СостояниеВыписки.GUIDКО, ОбъектСсылка.ЛицевойСчет.Код, ОбъектСсылка.ДатаВыписки, GUIDПП);
		
	Если СтрокаПП = "" Тогда
		Возврат "";
	КонецЕсли;                                             
	
	Если ПроизвольныеПараметры = Неопределено Тогда
		ПроизвольныеПараметры = Новый Соответствие;
	КонецЕсли;                              
	
	Если СтрокаПП.СписокСтрокПП.Количество() = 0 Тогда   
		
		СтрокаСпискаПП = СтрокаПП.СписокСтрокПП.Добавить(); 
		
		Если (ПроизвольныеПараметры["КБК"] <> Неопределено) Тогда
			СтрокаСпискаПП.КБК = ПроизвольныеПараметры["КБК"];
		КонецЕсли;
		
		Если (ПроизвольныеПараметры["КодЦели"] <> Неопределено) Тогда
			СтрокаСпискаПП.КодЦели = ПроизвольныеПараметры["КодЦели"];
		КонецЕсли;
		
		Если (ПроизвольныеПараметры["СуммаПоступления"] <> Неопределено) Тогда
			СтрокаСпискаПП.Сумма = ПроизвольныеПараметры["СуммаПоступления"];
		КонецЕсли;
		
	КонецЕсли;
	
	ПечатныйОбраз = СтрокаПП.ПечатныйОбраз;
	
	КассовоеПоступлениеСсылка = НайтиДокументПоGUID("КассовоеПоступление", GUIDПП);
	
	Если ЗначениеЗаполнено(КассовоеПоступлениеСсылка) Тогда    
		
		Если ЗначениеЗаполнено(ВидОбмена) Тогда
			Если ВидОбмена.ОтменаПовторнойЗагрузкиПроведенныхДокументов И КассовоеПоступлениеСсылка.Проведен Тогда 
				
				Сообщение    = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(НСтр("ru='Документ [Документ] был загружен ранее и проведен. Он останется без изменений.'"),
																									Новый Структура("Документ", 
																													КассовоеПоступлениеСсылка));
				ОбщегоНазначения.СообщитьПользователю(Сообщение);
				
				Возврат КассовоеПоступлениеСсылка;
			КонецЕсли;
		КонецЕсли;	
		
		КассовоеПоступление = КассовоеПоступлениеСсылка.ПолучитьОбъект();
		КассовоеПоступление.РасшифровкаПлатежа.Очистить(); 
	Иначе
		КассовоеПоступление = Документы.КассовоеПоступление.СоздатьДокумент();
	КонецЕсли;
	
	КассовоеПоступление.Дата						 = ?(КонецДня(ОбъектСсылка.ДатаВыписки) = КонецДня(ТекущаяДата()), ТекущаяДата(), КонецДня(ОбъектСсылка.ДатаВыписки));
	КассовоеПоступление.Организация					 = ОбъектСсылка.Организация;
	
	КассовоеПоступление.ЛицевойСчет					 = ОбъектСсылка.ЛицевойСчет;
	КассовоеПоступление.СуммаДокумента				 = СуммаПоступления;
	
	Если ЗначениеЗаполнено(ПечатныйОбраз) Тогда 
		
		КассовоеПоступление.НомерПервичногоДокумента	 = ?(ЗначениеЗаполнено(СвойствоСтруктуры(ПечатныйОбраз, "НомерДокумента")), СвойствоСтруктуры(ПечатныйОбраз, "НомерДокумента"), СвойствоСтруктуры(ПечатныйОбраз, "НомерДок"));
		КассовоеПоступление.ДатаПервичногоДокумента		 = ?(ЗначениеЗаполнено(СвойствоСтруктуры(ПечатныйОбраз, "ДатаДокумента")), ПреобразованиеСтрокиВДату(СвойствоСтруктуры(ПечатныйОбраз, "ДатаДокумента")), СвойствоСтруктуры(ПечатныйОбраз, "ДатаДок"));
		
		КассовоеПоступление.НазначениеПлатежа 			 = СвойствоСтруктуры(ПечатныйОбраз, "НазначениеПлатежа");  
		
		Если НЕ ЗначениеЗаполнено(КассовоеПоступление.НазначениеПлатежа) Тогда  
			//если есть реквизиты Уведомления об уточнении вида и принадлежности платежа
			Если ТипЗнч(СвойствоСтруктуры(ПечатныйОбраз, "ИзмененныеРеквизиты")) = Тип("Массив") Тогда
			
				Если ПечатныйОбраз.ИзмененныеРеквизиты.Количество() > 0  Тогда
					 КассовоеПоступление.НазначениеПлатежа = СвойствоСтруктуры(ПечатныйОбраз.ИзмененныеРеквизиты[0], "НазначениеПлатежа");
				КонецЕсли;

			ИначеЕсли ТипЗнч(СвойствоСтруктуры(ПечатныйОбраз, "РеквизитыПлатежногоДокумента")) = Тип("Массив") Тогда
			
				Если ПечатныйОбраз.РеквизитыПлатежногоДокумента.Количество() > 0  Тогда
					 КассовоеПоступление.НазначениеПлатежа = СвойствоСтруктуры(ПечатныйОбраз.РеквизитыПлатежногоДокумента[0], "НазначениеПлатежа");
				 КонецЕсли;   
				 
			КонецЕсли;	 
			
		КонецЕсли;	
			
		КассовоеПоступление.ИдентификаторПлатежа         = СвойствоСтруктуры(ПечатныйОбраз, "ИдентификаторПлатежа");
		
		Если СвойствоСтруктуры(ПечатныйОбраз, "ВидОперации") = "ZR" Тогда   // данные от внебанковских операций, где клиент является плательщиком для нас
			
			КассовоеПоступление.Плательщик				     = ОпределитьКонтрагента(,, СвойствоСтруктуры(ПечатныйОбраз, "НаименованиеКлиента"),, СвойствоСтруктуры(ПечатныйОбраз, "КодРПБС"), ВидОбмена, ДанныеНовыхКонтрагентов);
			
			Если НЕ ЗначениеЗаполнено(КассовоеПоступление.Плательщик) И ТипЗнч(ДанныеНовыхКонтрагентов) = Тип("ТаблицаЗначений") Тогда
				Если ДанныеНовыхКонтрагентов.Количество() > 0 И НЕ ЗначениеЗаполнено(ДанныеНовыхКонтрагентов[ДанныеНовыхКонтрагентов.Количество() - 1].ДокументСсылка) Тогда
					 ДанныеНовыхКонтрагентов[ДанныеНовыхКонтрагентов.Количество()-1].ДокументСсылка     = КассовоеПоступление.Ссылка;
					 ДанныеНовыхКонтрагентов[ДанныеНовыхКонтрагентов.Количество()-1].ИмяРеквизита       = "Плательщик";
					 
					 КонтрагентПовтор = ДанныеНовыхКонтрагентов.Добавить();
					 ЗаполнитьЗначенияСвойств(КонтрагентПовтор, ДанныеНовыхКонтрагентов[ДанныеНовыхКонтрагентов.Количество() - 2]);
					 КонтрагентПовтор.ИмяРеквизита = "Контрагент";
				КонецЕсли;
			КонецЕсли;
		
			КассовоеПоступление.Контрагент		             = КассовоеПоступление.Плательщик;
			Если ЗначениеЗаполнено(КассовоеПоступление.Контрагент) Тогда
				КассовоеПоступление.СчетКонтрагента          = ОпределитьСчетКонтрагента(КассовоеПоступление.Контрагент, 
																		СвойствоСтруктуры(ПечатныйОбраз, "НомерЛС"),,,,,
																		СвойствоСтруктуры(ПечатныйОбраз, "КОФК"),
																		СвойствоСтруктуры(ПечатныйОбраз, "НаименованиеОФК"));
			КонецЕсли;
			
		Иначе  //не ЗКР
			КассовоеПоступление.Плательщик				     = ОпределитьКонтрагента(СвойствоСтруктуры(ПечатныйОбраз, "ИННПлательщика"),СвойствоСтруктуры(ПечатныйОбраз, "КПППлательщика"), СвойствоСтруктуры(ПечатныйОбраз, "ТекстПлательщика"),,, ВидОбмена, ДанныеНовыхКонтрагентов);
			
			Если НЕ ЗначениеЗаполнено(КассовоеПоступление.Плательщик) И ТипЗнч(ДанныеНовыхКонтрагентов) = Тип("ТаблицаЗначений") Тогда
				Если ДанныеНовыхКонтрагентов.Количество() > 0 И НЕ ЗначениеЗаполнено(ДанныеНовыхКонтрагентов[ДанныеНовыхКонтрагентов.Количество() - 1].ДокументСсылка) Тогда
					 ДанныеНовыхКонтрагентов[ДанныеНовыхКонтрагентов.Количество()-1].ДокументСсылка     = КассовоеПоступление.Ссылка;
					 ДанныеНовыхКонтрагентов[ДанныеНовыхКонтрагентов.Количество()-1].ИмяРеквизита       = "Плательщик";
					 
					 КонтрагентПовтор = ДанныеНовыхКонтрагентов.Добавить();
					 ЗаполнитьЗначенияСвойств(КонтрагентПовтор, ДанныеНовыхКонтрагентов[ДанныеНовыхКонтрагентов.Количество() - 2]);
					 КонтрагентПовтор.ИмяРеквизита = "Контрагент";
				КонецЕсли;
			КонецЕсли;
			
			КассовоеПоступление.Контрагент		             = КассовоеПоступление.Плательщик;
			КассовоеПоступление.СчетКонтрагента              = ОпределитьСчетКонтрагента(КассовоеПоступление.Контрагент, 
																		СвойствоСтруктуры(ПечатныйОбраз, "НомерСчетаПлательщика"), 
											  							СвойствоСтруктуры(ПечатныйОбраз, "БИКБанкаПлательщика"),
																		СвойствоСтруктуры(ПечатныйОбраз, "НаименованиеБанкаПлательщика"), 
											  							СвойствоСтруктуры(ПечатныйОбраз, "СчетБанкаПлательщика"));
	 	КонецЕсли;	
		
	Иначе
		
		КассовоеПоступление.НомерПервичногоДокумента	 = ?(ЗначениеЗаполнено(СтрокаПП.НомерДок), СтрокаПП.НомерДок, "");
		КассовоеПоступление.ДатаПервичногоДокумента		 = ?(ЗначениеЗаполнено(СтрокаПП.ДатаДок),  СтрокаПП.ДатаДок,  "");
		
	КонецЕсли;
	
	Если ПроизвольныеПараметры["ВидПодтверждающегоДокумента"] <> Неопределено Тогда
		КассовоеПоступление.ВидПервичногоДокумента   = ПроизвольныеПараметры["ВидПодтверждающегоДокумента"];
	ИначеЕсли ЗначениеЗаполнено(СтрокаПП.ИмяДок) Тогда
		КассовоеПоступление.ВидПервичногоДокумента   = СтрокаПП.ИмяДок;
	Иначе
		КассовоеПоступление.ВидПервичногоДокумента   = ПлатежноРасчетныеДокументы.ОпределитьВидПодтверждающегоДокумента(СтрокаПП.ПечатныйОбраз["ВидОперации"]);
		Если НЕ ЗначениеЗаполнено(КассовоеПоступление.ВидПервичногоДокумента) Тогда
             КассовоеПоступление.ВидПервичногоДокумента   = ?(ЗначениеЗаполнено(ТипДокументаПоКоду(СтрокаПП.ПечатныйОбраз["ВидОперации"])), Метаданные.Документы[ТипДокументаПоКоду(СтрокаПП.ПечатныйОбраз["ВидОперации"])].Синоним, "Платежный документ");
		КонецЕсли;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ПроизвольныеПараметры["Валюта"]) И ЗначениеЗаполнено(ПроизвольныеПараметры["Курс"]) И
		 ЗначениеЗаполнено(ПроизвольныеПараметры["СуммаВРублях"]) Тогда
		 
		КассовоеПоступление.ВалютаДокумента				 = ПроизвольныеПараметры["Валюта"];
		КассовоеПоступление.СуммаДокументаВВалюте		 = СуммаПоступления;
		КассовоеПоступление.СуммаДокумента               = ПроизвольныеПараметры["СуммаВРублях"];
		КассовоеПоступление.Курс						 = ПроизвольныеПараметры["Курс"];
		КассовоеПоступление.Кратность					 = 1; 
		
		Параметры2 = Новый Структура("Валюта, Курс, Кратность", Константы.ВалютаРегламентированногоУчета.Получить(), 1, 1);
		Параметры1 = Новый Структура("Валюта, Курс, Кратность", КассовоеПоступление.ВалютаДокумента, КассовоеПоступление.Курс, КассовоеПоступление.Кратность);
		 
	Иначе
	
		КассовоеПоступление.ВалютаДокумента				 = Константы.ВалютаРегламентированногоУчета.Получить();
		КассовоеПоступление.СуммаДокументаВВалюте		 = СуммаПоступления;
		КассовоеПоступление.Курс						 = 1;
		КассовоеПоступление.Кратность					 = 1;
		
	КонецЕсли;      
	
	ЭтоАУБУ                                          = ОпределитьАУБУ(КассовоеПоступление.Организация, КассовоеПоступление.Дата);
		
	//-------------------------
	
	Для Каждого СтрокаПоступления Из СтрокаПП.СписокСтрокПП Цикл    
		
		Если НЕ ЗначениеЗаполнено(СтрокаПоступления.КБК) Тогда
			СтрокаПоступления.КБК = ПроизвольныеПараметры["КБК"];
        КонецЕсли;
		
		Строка							  = КассовоеПоступление.РасшифровкаПлатежа.Добавить();
		
		Если ЗначениеЗаполнено(СтрокаПоступления.Кредит) Тогда
			СтрокаПоступления.КБК         = Лев(СтрокаПоступления.Кредит, 17) + Прав(СтрокаПоступления.Кредит, 3);
			Если Сред(СтрокаПоступления.Кредит, 18, 1) = "1" Тогда
				КВД                       = Перечисления.КВД.Бюджет;
			ИначеЕсли Сред(СтрокаПоступления.Кредит, 18, 1) = "6" Тогда
				КВД                       = Перечисления.КВД.СубсидииНаГосзадание;
			КонецЕсли;
		КонецЕсли;
		
		Если КассовоеПоступление.ВалютаДокумента <> Константы.ВалютаРегламентированногоУчета.Получить() Тогда
		     Строка.Сумма			      = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(СтрокаПоступления.Сумма, Параметры1, Параметры2);
		Иначе
			 Строка.Сумма		    	  = СтрокаПоступления.Сумма;
		КонецЕсли;
		 
		Строка.СуммаВал					  = СтрокаПоступления.Сумма;
		
		Если КассовоеПоступление.Дата < Дата(2016, 1, 1) Тогда 
			Строка.КБКНазначениеПлатежа   = НайтиКБКПоНаименованию(Лев(СтрокаПоступления.КБК, 17), СтрокаПоступления.ТипКБК, , ЭтоАУБУ, , КассовоеПоступление.Дата);
			Строка.КОСГУНазначениеПлатежа = ЗначениеКлассификатораПоКоду(Прав(СтрокаПоступления.КБК, 3), "КОСГУ");
		Иначе
			Строка.КБКНазначениеПлатежа   = НайтиКБКПоНаименованию(Прав(СтрокаПоступления.КБК, 17), СтрокаПоступления.ТипКБК, , ЭтоАУБУ, , КассовоеПоступление.Дата);
			Строка.КОСГУНазначениеПлатежа = ЗначениеКлассификатораПоКоду("000", "КОСГУ");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(КВД) Тогда
			Строка.КФО                    = КВД;
		Иначе
			Строка.КФО                    = КФОИспользуемыйВЛицевомСчете(КассовоеПоступление.ЛицевойСчет);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИсточникСредств) Тогда
			Строка.ИсточникСредств	      = ИсточникСредств;
		Иначе
			Строка.ИсточникСредств        = ИсточникСредствИспользуемыйВЛицевомСчете(КассовоеПоступление.ЛицевойСчет);
		КонецЕсли;

		Строка.Контрагент				  = КассовоеПоступление.Контрагент;  
		Строка.Примечание                 = СтрокаПоступления.Операция;
		Строка.КодЦели                    = НайтиКодЦели(СтрокаПоступления.КодЦели, "Загружен при импорте Выписки № " + ОбъектСсылка.Номер);
		
		//код пришел из Выписки для средств во временном распоряжении
		Если (НЕ ЗначениеЗаполнено(Строка.КодЦели)) И (ПроизвольныеПараметры["КодЦели"] <> Неопределено) Тогда
			Строка.КодЦели                = НайтиКодЦели(ПроизвольныеПараметры["КодЦели"], "Загружен при импорте Выписки № " + ОбъектСсылка.Номер);
		КонецЕсли;
		
		Если (Лев(КассовоеПоступление.ЛицевойСчет.Код, 2) = "04") И ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров") Тогда
			Строка.ВидРасчетов            = Перечисления.ВидыРасчетовПоЗаймам.ОсновнойДолг;
		КонецЕсли;   
		
		Если СтрокаПП.СписокСтрокПП.Колонки.Найти("Примечание") <> Неопределено Тогда
			 Строка.Примечание            = СтрокаПоступления.Примечание;
		КонецЕсли;	
		//есть данные по контрагентам в строках
		Если СтрокаПП.СписокСтрокПП.Колонки.Найти("ИНН") <> Неопределено Тогда
			Строка.Контрагент             = ОпределитьКонтрагента(СтрокаПоступления.ИНН, СтрокаПоступления.КПП, СтрокаПоступления.Наименование, СтрокаПоступления.ФИО,, ВидОбмена, ДанныеНовыхКонтрагентов);
        КонецЕсли;
		
	КонецЦикла;
	
	Попытка
		КассовоеПоступление.Записать();
	Исключение
		Возврат "";
	КонецПопытки;
	
	СостояниеКассовоеПоступление = Новый Структура;
	
	Для каждого КлючЗначение из СостояниеВыписки цикл
		СостояниеКассовоеПоступление.Вставить(КлючЗначение.Ключ,КлючЗначение.Значение);
	КонецЦикла;	
	
	СостояниеКассовоеПоступление.ПервичныйОбразИРеквизиты	= Новый ХранилищеЗначения(СтрокаПП.ПечатныйОбраз);
	СостояниеКассовоеПоступление.GUIDКО 					= GUIDПП;
	СостояниеКассовоеПоступление.Статус 					= перечисления.СтатусыИсполненияДокумента.Исполнен;
	СостояниеКассовоеПоступление.Вставить("ПлатежноРасчетныйДокумент",КассовоеПоступление.Ссылка);
	
	СостояниеКассовоеПоступление.НомерПодтверждающегоДокумента	= КассовоеПоступление.НомерПервичногоДокумента;
	СостояниеКассовоеПоступление.ДатаПодтверждающегоДокумента	= КассовоеПоступление.ДатаПервичногоДокумента;
	СостояниеКассовоеПоступление.ВидПодтверждающегоДокумента    = КассовоеПоступление.ВидПервичногоДокумента;
		
	ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СостояниеКассовоеПоступление);
	
	Возврат КассовоеПоступление.Ссылка;
	
КонецФункции

// помечает на удаление платежные поручения, не вошедшие в выписку
Процедура УдалениеПлатежекВнеВыписки(НачалоИнтервала, КонецИнтервала, Выписка)     ЭКСПОРТ
	
	Выписка.Записать();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Выписка", 		Выписка.Ссылка);

	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ВыпискаИзЛицевогоСчета.ДокументыДвижений.(
	|		ИсполняющийДокумент КАК ПлатежноеПоручение
	|	)
	|ИЗ
	|	Документ.ВыпискаИзЛицевогоСчета КАК ВыпискаИзЛицевогоСчета
	|ГДЕ
	|	ВыпискаИзЛицевогоСчета.Ссылка = &Выписка
	|";
	
	ПлатежкиВВыписке = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.Прямой);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНач", 		НачалоДня(НачалоИнтервала));
	Запрос.УстановитьПараметр("ДатаКон", 		КонецДня(КонецИнтервала));
	Запрос.УстановитьПараметр("РасчетныйСчет", 	Выписка.ЛицевойСчет);
	Запрос.УстановитьПараметр("Организация", 	Выписка.Организация);
		
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ПлатежноеПоручение.Ссылка   КАК Документ   
	|ИЗ
	|	Документ.ПлатежноеПоручение КАК ПлатежноеПоручение
	|ГДЕ
	|	ПлатежноеПоручение.Организация        = &Организация
	|	И ПлатежноеПоручение.ПометкаУдаления = Ложь
	|	И (ПлатежноеПоручение.Дата >= &ДатаНач) И (ПлатежноеПоручение.Дата <= &ДатаКон)
	|	И ПлатежноеПоручение.ЛицевойСчет = &РасчетныйСчет
	|";
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		Если ПлатежкиВВыписке[0].ДокументыДвижений.Найти(Результат.Документ) = Неопределено Тогда
			 Результат.Документ.ПолучитьОбъект().УстановитьПометкуУдаления(Истина);
			 Сообщить("Документ " + Результат.Документ + " помечен на удаление");
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция СоздатьПП(ПроизвольныеПараметры, ОбъектСсылка)     ЭКСПОРТ
	Перем ПолучательИНН;
	Перем ПолучательКПП;
	Перем Получатель;
	Перем ДатаДвижения;

	Если ТипЗнч(ПроизвольныеПараметры) = Тип("Структура") Тогда
		ПроизвольныеПараметры.Свойство("ПолучательИНН",	ПолучательИНН);
		ПроизвольныеПараметры.Свойство("ПолучательКПП",	ПолучательКПП);
		ПроизвольныеПараметры.Свойство("Получатель",	Получатель);
		ПроизвольныеПараметры.Свойство("ДатаДвижения",	ДатаДвижения);
	Иначе
		ПолучательИНН 	= ПроизвольныеПараметры.Получить("ПолучательИНН");	
		ПолучательКПП 	= ПроизвольныеПараметры.Получить("ПолучательКПП");	
		Получатель 		= ПроизвольныеПараметры.Получить("Получатель");
		ДатаДвижения	= ПроизвольныеПараметры.Получить("ДатаДвижения");
	КонецЕсли;

	ПлатежноеПоручение = Документы.ПлатежноеПоручение.СоздатьДокумент();
	
	ПлатежноеПоручение.Дата			   = КонецДня(ОбъектСсылка.ДатаВыписки);
	ПлатежноеПоручение.Организация	   = ОбъектСсылка.Организация;
	ПлатежноеПоручение.ЛицевойСчет	   = ОбъектСсылка.ЛицевойСчет;
	
	ПлатежноеПоручение.Контрагент      = ОпределитьКонтрагента(ПолучательИНН, ПолучательКПП, Получатель);
	
	Если НЕ ЗначениеЗаполнено(ПлатежноеПоручение.Контрагент) Тогда
		
		ПлатежноеПоручение.Контрагент  = 	СоздатьКонтрагентаПоОписанию(Новый Структура("ИНН, КПП, Наименование, ЭтоФизическоеЛицо", 
																						ПолучательИНН, 
																						ПолучательКПП, 
																						Получатель, 
																						КонтрагентФизЛицо(ПолучательИНН, ПолучательКПП)));
		
	КонецЕсли;

	ПлатежноеПоручение = ЗаполнитьПП(ПлатежноеПоручение, ПроизвольныеПараметры).Ссылка;
	
	СтруктураРекв = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(ПлатежноеПоручение.Ссылка);
	СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",ПлатежноеПоручение.Ссылка);
	СтруктураРекв.Вставить("Статус",Перечисления.СтатусыИсполненияДокумента.НаИсполнении);
	СтруктураРекв.Вставить("ДатаПроведения",ДатаДвижения);
	ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);


	Возврат ПлатежноеПоручение
	
КонецФункции

Функция ЗаполнитьПП(ПлатежноеПоручение, ПроизвольныеПараметры)
	Перем ПолучательБИК;
	Перем НазначениеПлатежа;
	Перем СуммаДок;
	Перем ВидПлатежа;
	Перем Очередность;
	Перем Получатель;
	Перем ПолучательИНН;
	Перем ПолучательКПП;
	Перем ПолучательРасчСчет;
	Перем ПолучательИмяБанка;
	Перем ПолучательКорСчет;
	Перем Плательщик;
	Перем ПлательщикРасчСчет;
	Перем ПлательщикИмяБанка;
	Перем ПлательщикБИК;
	Перем ПлательщикКорСчет;
	Перем ПоказательОснования;
	Перем ПоказательПериода;
	Перем ПоказательТипа;
	Перем ПоказательНомера;
	Перем ПоказательДаты;
	
	Если ТипЗнч(ПроизвольныеПараметры) = Тип("Структура") Тогда
		ПроизвольныеПараметры.Свойство("ПолучательБИК",			ПолучательБИК);
		ПроизвольныеПараметры.Свойство("НазначениеПлатежа",		НазначениеПлатежа);
		ПроизвольныеПараметры.Свойство("СуммаДок",				СуммаДок);
		ПроизвольныеПараметры.Свойство("ВидПлатежа",			ВидПлатежа);
		ПроизвольныеПараметры.Свойство("Очередность",			Очередность);
		ПроизвольныеПараметры.Свойство("Получатель",			Получатель);
		ПроизвольныеПараметры.Свойство("ПолучательИНН",			ПолучательИНН);
		ПроизвольныеПараметры.Свойство("ПолучательКПП",			ПолучательКПП);
		ПроизвольныеПараметры.Свойство("ПолучательРасчСчет",	ПолучательРасчСчет);
		ПроизвольныеПараметры.Свойство("ПолучательИмяБанка",	ПолучательИмяБанка);
		ПроизвольныеПараметры.Свойство("ПолучательКорСчет",		ПолучательКорСчет);
		ПроизвольныеПараметры.Свойство("Плательщик",			Плательщик);
		ПроизвольныеПараметры.Свойство("ПлательщикРасчСчет",	ПлательщикРасчСчет);
		ПроизвольныеПараметры.Свойство("ПлательщикИмяБанка",	ПлательщикИмяБанка);
		ПроизвольныеПараметры.Свойство("ПлательщикБИК",			ПлательщикБИК);
		ПроизвольныеПараметры.Свойство("ПлательщикКорСчет",		ПлательщикКорСчет);
		ПроизвольныеПараметры.Свойство("ПоказательОснования",	ПоказательОснования);
		ПроизвольныеПараметры.Свойство("ПоказательПериода",		ПоказательПериода);
		ПроизвольныеПараметры.Свойство("ПоказательТипа",		ПоказательТипа);
		ПроизвольныеПараметры.Свойство("ПоказательНомера",		ПоказательНомера);
		ПроизвольныеПараметры.Свойство("ПоказательДаты",		ПоказательДаты);
	Иначе
		ПолучательБИК 		= ПроизвольныеПараметры.Получить("ПолучательБИК");	
		НазначениеПлатежа 	= ПроизвольныеПараметры.Получить("НазначениеПлатежа");	
		СуммаДок 			= ПроизвольныеПараметры.Получить("СуммаДок");	
		ВидПлатежа 			= ПроизвольныеПараметры.Получить("ВидПлатежа");	
		Очередность 		= ПроизвольныеПараметры.Получить("Очередность");	
		Получатель 			= ПроизвольныеПараметры.Получить("Получатель");	
		ПолучательИНН 		= ПроизвольныеПараметры.Получить("ПолучательИНН");	
		ПолучательКПП 		= ПроизвольныеПараметры.Получить("ПолучательКПП");	
		ПолучательРасчСчет 	= ПроизвольныеПараметры.Получить("ПолучательРасчСчет");	
		ПолучательИмяБанка 	= ПроизвольныеПараметры.Получить("ПолучательИмяБанка");	
		ПолучательКорСчет 	= ПроизвольныеПараметры.Получить("ПолучательКорСчет");	
		Плательщик 			= ПроизвольныеПараметры.Получить("Плательщик");	
		ПлательщикРасчСчет 	= ПроизвольныеПараметры.Получить("ПлательщикРасчСчет");	
		ПлательщикИмяБанка 	= ПроизвольныеПараметры.Получить("ПлательщикИмяБанка");	
		ПлательщикБИК 		= ПроизвольныеПараметры.Получить("ПлательщикБИК");	
		ПлательщикКорСчет 	= ПроизвольныеПараметры.Получить("ПлательщикКорСчет");	
		ПоказательОснования	= ПроизвольныеПараметры.Получить("ПоказательОснования");	
		ПоказательПериода 	= ПроизвольныеПараметры.Получить("ПоказательПериода");	
		ПоказательТипа 		= ПроизвольныеПараметры.Получить("ПоказательТипа");	
		ПоказательНомера 	= ПроизвольныеПараметры.Получить("ПоказательНомера");	
		ПоказательДаты 		= ПроизвольныеПараметры.Получить("ПоказательДаты");	
	КонецЕсли;
	
	ПлатежноеПоручение.Контрагент		= ОпределитьКонтрагента(ПолучательИНН, ПолучательКПП, Получатель);
	
	ПлатежноеПоручение.СчетКонтрагента  = ОпределитьСчетКонтрагента(	ПлатежноеПоручение.Контрагент, 
																		ПолучательРасчСчет, 
																	  	ПолучательБИК, 
																		ПолучательИмяБанка, 
																	  	ПолучательКорСчет);
	
	ПлатежноеПоручение.НазначениеПлатежа  			= НазначениеПлатежа;
	ПлатежноеПоручение.СуммаДокумента       		= СуммаДок;
	
	ПлатежноеПоручение.ВидПлатежа					= ВидПлатежа;
	ПлатежноеПоручение.ОчередностьПлатежа			= Очередность;
	
	ПлатежноеПоручение.КонтрагентНаименование       = Получатель;
	ПлатежноеПоручение.КонтрагентИНН			    = ПолучательИНН;
	ПлатежноеПоручение.КонтрагентКПП			    = ПолучательКПП;
	ПлатежноеПоручение.КонтрагентБанковскийСчет	    = ПолучательРасчСчет;
	ПлатежноеПоручение.КонтрагентНаименованиеБанка	= ПолучательИмяБанка;
	ПлатежноеПоручение.КонтрагентКорСчетБанка		= ПолучательКорСчет;
	
	ПлатежноеПоручение.ПлательщикНаименование		= Плательщик;
	ПлатежноеПоручение.ПлательщикБанковскийСчет		= ПлательщикРасчСчет;
    ПлатежноеПоручение.ПлательщикНаименованиеБанка	= ПлательщикИмяБанка;
	ПлатежноеПоручение.ПлательщикБИКБанка			= ПлательщикБИК;
	ПлатежноеПоручение.ПлательщикКорСчетБанка		= ПлательщикКорСчет;
	
	ПлатежноеПоручение.ПоказательОснования			= ПоказательОснования;
	ПлатежноеПоручение.ПоказательПериода			= ПоказательПериода;
	ПлатежноеПоручение.ПоказательТипа				= ПоказательТипа;
	ПлатежноеПоручение.ПоказательНомера				= ПоказательНомера;
	ПлатежноеПоручение.ПоказательДаты				= ПоказательДаты;
	
	ПлатежноеПоручение.Записать();
	Возврат ПлатежноеПоручение;
	
КонецФункции

Функция СоздатьПлатежноеТребование(ПроизвольныеПараметры, ОбъектСсылка)     ЭКСПОРТ
	Перем ПолучательИНН;
	Перем ПолучательКПП;
	Перем Получатель;
	
	Если ТипЗнч(ПроизвольныеПараметры) = Тип("Структура") Тогда
		ПроизвольныеПараметры.Свойство("ПолучательИНН",	ПолучательИНН);
		ПроизвольныеПараметры.Свойство("ПолучательКПП",	ПолучательКПП);
		ПроизвольныеПараметры.Свойство("Получатель",	Получатель);
	Иначе
		ПолучательИНН 	= ПроизвольныеПараметры.Получить("ПолучательИНН");	
		ПолучательКПП 	= ПроизвольныеПараметры.Получить("ПолучательКПП");	
		Получатель 		= ПроизвольныеПараметры.Получить("Получатель");	
	КонецЕсли;

	ПлатежноеТребование = Документы.ПлатежноеТребование.СоздатьДокумент();
	
	ПлатежноеТребование.Дата		= КонецДня(ОбъектСсылка.ДатаВыписки);
	ПлатежноеТребование.Организация	= ОбъектСсылка.Организация;
	ПлатежноеТребование.ЛицевойСчет	= ОбъектСсылка.ЛицевойСчет;
	
	ПлатежноеТребование.Контрагент  = ОпределитьКонтрагента(ПолучательИНН, ПолучательКПП, Получатель);
	
	Если НЕ ЗначениеЗаполнено(ПлатежноеТребование.Контрагент) Тогда
		
		ПлатежноеТребование.Контрагент = 	СоздатьКонтрагентаПоОписанию(Новый Структура("ИНН, КПП, Наименование, ЭтоФизическоеЛицо", 
																						ПолучательИНН, 
																						ПолучательКПП, 
																						Получатель, 
																						КонтрагентФизЛицо(ПолучательИНН, ПолучательКПП)));
		
	КонецЕсли;

	ПлатежноеТребование = ЗаполнитьПлатежноеТребование(ПлатежноеТребование, ПроизвольныеПараметры).Ссылка;
	
	Возврат ПлатежноеТребование;
	
КонецФункции

Функция ЗаполнитьПлатежноеТребование(ПлатежноеТребование, ПроизвольныеПараметры)
	Перем ПолучательБИК;
	Перем НазначениеПлатежа;
	Перем СуммаДок;
	Перем ВидПлатежа;
	Перем Очередность;
	Перем Получатель;
	Перем ПолучательИНН;
	Перем ПолучательКПП;
	Перем ПолучательРасчСчет;
	Перем ПолучательИмяБанка;
	Перем ПолучательКорСчет;
	
	Если ТипЗнч(ПроизвольныеПараметры) = Тип("Структура") Тогда
		ПроизвольныеПараметры.Свойство("ПолучательБИК",			ПолучательБИК);
		ПроизвольныеПараметры.Свойство("НазначениеПлатежа",		НазначениеПлатежа);
		ПроизвольныеПараметры.Свойство("СуммаДок",				СуммаДок);
		ПроизвольныеПараметры.Свойство("ВидПлатежа",			ВидПлатежа);
		ПроизвольныеПараметры.Свойство("Очередность",			Очередность);
		ПроизвольныеПараметры.Свойство("Получатель",			Получатель);
		ПроизвольныеПараметры.Свойство("ПолучательИНН",			ПолучательИНН);
		ПроизвольныеПараметры.Свойство("ПолучательКПП",			ПолучательКПП);
		ПроизвольныеПараметры.Свойство("ПолучательРасчСчет",	ПолучательРасчСчет);
		ПроизвольныеПараметры.Свойство("ПолучательИмяБанка",	ПолучательИмяБанка);
		ПроизвольныеПараметры.Свойство("ПолучательКорСчет",		ПолучательКорСчет);
	Иначе
		ПолучательБИК 		= ПроизвольныеПараметры.Получить("ПолучательБИК");	
		НазначениеПлатежа 	= ПроизвольныеПараметры.Получить("НазначениеПлатежа");	
		СуммаДок 			= ПроизвольныеПараметры.Получить("СуммаДок");	
		ВидПлатежа 			= ПроизвольныеПараметры.Получить("ВидПлатежа");	
		Очередность 		= ПроизвольныеПараметры.Получить("Очередность");	
		Получатель 			= ПроизвольныеПараметры.Получить("Получатель");	
		ПолучательИНН 		= ПроизвольныеПараметры.Получить("ПолучательИНН");	
		ПолучательКПП 		= ПроизвольныеПараметры.Получить("ПолучательКПП");	
		ПолучательРасчСчет 	= ПроизвольныеПараметры.Получить("ПолучательРасчСчет");	
		ПолучательИмяБанка 	= ПроизвольныеПараметры.Получить("ПолучательИмяБанка");	
		ПолучательКорСчет 	= ПроизвольныеПараметры.Получить("ПолучательКорСчет");	
	КонецЕсли;
	
	ПлатежноеТребование.Контрагент		= ОпределитьКонтрагента(ПолучательИНН, ПолучательКПП, Получатель);
	
	ПлатежноеТребование.СчетКонтрагента  = ОпределитьСчетКонтрагента(	ПлатежноеТребование.Контрагент, 
																		ПолучательРасчСчет, 
																	  	ПолучательБИК, 
																		ПолучательИмяБанка, 
																	  	ПолучательКорСчет);
	
	ПлатежноеТребование.НазначениеПлатежа  			= НазначениеПлатежа;
	ПлатежноеТребование.СуммаДокумента       		= СуммаДок;
	
	ПлатежноеТребование.ВидПлатежа					= ВидПлатежа;
	ПлатежноеТребование.ОчередностьПлатежа			= Очередность;
	
	ПлатежноеТребование.КонтрагентНаименование      = Получатель;
	ПлатежноеТребование.КонтрагентИНН			    = ПолучательИНН;
	ПлатежноеТребование.КонтрагентКПП			    = ПолучательКПП;
	ПлатежноеТребование.КонтрагентБанковскийСчет    = ПолучательРасчСчет;
	ПлатежноеТребование.КонтрагентНаименованиеБанка	= ПолучательИмяБанка;
	ПлатежноеТребование.КонтрагентКорСчетБанка		= ПолучательКорСчет;
	
	ПлатежноеТребование.Записать();
	Возврат ПлатежноеТребование;
	
КонецФункции

Функция ОпределитьДокументДвиженияСозданныйРанее(ВидДокумента, ПроизвольныеПараметры, ОбъектСсылка, Контрагент = "")
	
	Перем НомерДок;
	Перем ДатаДок;
			
	Если ТипЗнч(ПроизвольныеПараметры) = Тип("Структура") Тогда
		ПроизвольныеПараметры.Свойство("НомерДок", 	  НомерДок);
		ПроизвольныеПараметры.Свойство("ДатаДок", 	  ДатаДок);
	Иначе
		НомерДок 	= ПроизвольныеПараметры.Получить("НомерДок");
		ДатаДок 	= ПроизвольныеПараметры.Получить("ДатаДок");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НомерДок) ИЛИ НЕ ЗначениеЗаполнено(ДатаДок) Тогда
		Возврат "";
	КонецЕсли;
				
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НомерЛС", 		СокрЛП(ОбъектСсылка.ЛицевойСчет.Код));
	Запрос.УстановитьПараметр("Организация", 	ОбъектСсылка.Организация);
	Запрос.УстановитьПараметр("ДатаДок",        ДатаДок);
	Запрос.УстановитьПараметр("НомерДок", 		НомерДок);
	Запрос.УстановитьПараметр("ДатаДокНач", 	НачалоДня(ОбъектСсылка.ДатаВыписки));
	Запрос.УстановитьПараметр("ДатаДокКон", 	КонецДня(ОбъектСсылка.ДатаВыписки));
	Запрос.УстановитьПараметр("Контрагент", 	Контрагент);

	
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ВложенныйЗапрос.Ссылка						КАК ДокументСсылка
	|ИЗ
	|	(ВЫБРАТЬ
	|		ДокументДвижения.Ссылка 			    КАК Ссылка
	|	ИЗ
	|		Документ."+ВидДокумента+" КАК ДокументДвижения
	|	ГДЕ
	|	   (ДокументДвижения.НомерПервичногоДокумента = &НомерДок  И  ДокументДвижения.ДатаПервичногоДокумента = &ДатаДок) 
	|		И ДокументДвижения.ЛицевойСчет.Код 	= &НомерЛС
	|       И ДокументДвижения.Организация = &Организация
	|		И (ДокументДвижения.Дата >= &ДатаДокНач) И (ДокументДвижения.Дата <= &ДатаДокКон)
	|       И ДокументДвижения.ПометкаУдаления = Ложь";
	
	Если ЗначениеЗаполнено(Контрагент) Тогда
		
		Запрос.Текст = Запрос.Текст +  "
	|       И ДокументДвижения.Контрагент = &Контрагент" 
		
    КонецЕсли;

    Запрос.Текст = Запрос.Текст +  "
	
    |
	|	 ) КАК ВложенныйЗапрос
	|	
	|";
	
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		
		Для каждого ДокументЗагруженныйВЭтойСессии Из ОбъектСсылка.ДокументыДвижений Цикл
			Если Результат.ДокументСсылка = ДокументЗагруженныйВЭтойСессии.ИсполняющийДокумент Тогда
				Возврат "";
			КонецЕсли;
		КонецЦикла;
		
		Возврат Результат.ДокументСсылка
	КонецЕсли;

	Возврат "";
	
КонецФункции

// создает кассовое поступление на основании данных ПП
Функция КассовоеПоступлениеПоПП(ПроизвольныеПараметры, ОбъектСсылка, ОпределитьДокументПоступления = Ложь, НеСоздаватьЗагруженныйРанее = Ложь, ВидОбмена = Неопределено, ДанныеНовыхКонтрагентов = Неопределено)     ЭКСПОРТ
	
	Перем СуммаДок;
	Перем НомерДок;
	Перем ДатаДок;
	Перем ВидДокумента;
	Перем НазначениеПлатежа;
	Перем ПлательщикИНН;
	Перем ПлательщикКПП;
	Перем Плательщик;
	Перем ПлательщикРасчСчет;
	Перем ПлательщикБИК;
	Перем ПлательщикИмяБанка;
	Перем ПлательщикКорСчет;
	Перем ДатаДвижения;
	Перем ИдентификаторПлатежа;
	
	Если ТипЗнч(ПроизвольныеПараметры) = Тип("Структура") Тогда
		ПроизвольныеПараметры.Свойство("СуммаДок",				СуммаДок);
		ПроизвольныеПараметры.Свойство("НомерДок",				НомерДок);
		ПроизвольныеПараметры.Свойство("ДатаДок",				ДатаДок);
		ПроизвольныеПараметры.Свойство("ВидДокумента",			ВидДокумента);
		ПроизвольныеПараметры.Свойство("НазначениеПлатежа",		НазначениеПлатежа);
		ПроизвольныеПараметры.Свойство("ПлательщикИНН",			ПлательщикИНН);
		ПроизвольныеПараметры.Свойство("ПлательщикКПП",			ПлательщикКПП);
		ПроизвольныеПараметры.Свойство("Плательщик",			Плательщик);
		ПроизвольныеПараметры.Свойство("ПлательщикРасчСчет",	ПлательщикРасчСчет);
		ПроизвольныеПараметры.Свойство("ПлательщикБИК",			ПлательщикБИК);
		ПроизвольныеПараметры.Свойство("ПлательщикИмяБанка",	ПлательщикИмяБанка);
		ПроизвольныеПараметры.Свойство("ПлательщикКорСчет",		ПлательщикКорСчет);
		ПроизвольныеПараметры.Свойство("ДатаДвижения",			ДатаДвижения);
		ПроизвольныеПараметры.Свойство("ИдентификаторПлатежа",	ИдентификаторПлатежа);
	Иначе
		СуммаДок 			= ПроизвольныеПараметры.Получить("СуммаДок");	
		НомерДок 			= ПроизвольныеПараметры.Получить("НомерДок");	
		ДатаДок 			= ПроизвольныеПараметры.Получить("ДатаДок");
		ВидДокумента        = ПроизвольныеПараметры.Получить("ВидДокумента");
		НазначениеПлатежа 	= ПроизвольныеПараметры.Получить("НазначениеПлатежа");	
		ПлательщикИНН 		= ПроизвольныеПараметры.Получить("ПлательщикИНН");	
		ПлательщикКПП 		= ПроизвольныеПараметры.Получить("ПлательщикКПП");	
		Плательщик 			= ПроизвольныеПараметры.Получить("Плательщик");	
		ПлательщикРасчСчет 	= ПроизвольныеПараметры.Получить("ПлательщикРасчСчет");	
		ПлательщикБИК 		= ПроизвольныеПараметры.Получить("ПлательщикБИК");	
		ПлательщикИмяБанка	= ПроизвольныеПараметры.Получить("ПлательщикИмяБанка");	
		ПлательщикКорСчет 	= ПроизвольныеПараметры.Получить("ПлательщикКорСчет");
		ДатаДвижения 		= ПроизвольныеПараметры.Получить("ДатаДвижения");
		ИдентификаторПлатежа= ПроизвольныеПараметры.Получить("ИдентификаторПлатежа");
	КонецЕсли;
	
	Если ОпределитьДокументПоступления Тогда
		ОпределитьДокументПоступления(ПроизвольныеПараметры, ОбъектСсылка);
	КонецЕсли;
	
	КассовоеПоступление = "";
	Контрагент          = ОпределитьКонтрагента(ПлательщикИНН, ПлательщикКПП, Плательщик, , , ВидОбмена, ДанныеНовыхКонтрагентов);
	
	Если НеСоздаватьЗагруженныйРанее Тогда
		 КассовоеПоступление = ОпределитьДокументДвиженияСозданныйРанее("КассовоеПоступление", ПроизвольныеПараметры, ОбъектСсылка, Контрагент);
		 Если ТипЗнч(КассовоеПоступление) = Тип("ДокументСсылка.КассовоеПоступление") Тогда
			 Если КассовоеПоступление.Проведен Тогда
				 Возврат КассовоеПоступление.Ссылка
			 КонецЕсли;
			 КассовоеПоступление = КассовоеПоступление.ПолучитьОбъект();
			 КассовоеПоступление.РасшифровкаПлатежа.Очистить();
		 КонецЕсли;
	КонецЕсли;
		
	Если КассовоеПоступление = ""  Тогда	
		КассовоеПоступление = Документы.КассовоеПоступление.СоздатьДокумент();
	КонецЕсли;
	
	КассовоеПоступление.Дата						 = ?(КонецДня(ОбъектСсылка.ДатаВыписки) = КонецДня(ТекущаяДата()), ТекущаяДата(), КонецДня(ОбъектСсылка.ДатаВыписки));
	КассовоеПоступление.Организация					 = ОбъектСсылка.Организация;
	
	КассовоеПоступление.ЛицевойСчет					 = ОбъектСсылка.ЛицевойСчет;
	КассовоеПоступление.СуммаДокумента				 = СуммаДок;
	
	КассовоеПоступление.НомерПервичногоДокумента	 = НомерДок;
	КассовоеПоступление.ДатаПервичногоДокумента		 = ДатаДок;
	КассовоеПоступление.ВидПервичногоДокумента       = ВидДокумента;
	
	КассовоеПоступление.НазначениеПлатежа 			 = НазначениеПлатежа;
	
	КассовоеПоступление.ВалютаДокумента				 = Константы.ВалютаРегламентированногоУчета.Получить();
	КассовоеПоступление.СуммаДокументаВВалюте		 = СуммаДок;
	КассовоеПоступление.Курс						 = 1;
	КассовоеПоступление.Кратность					 = 1;
	
    КассовоеПоступление.ИдентификаторПлатежа         = ИдентификаторПлатежа;	
	
	КассовоеПоступление.Плательщик				     = Контрагент;
	
	
	//Если НЕ ЗначениеЗаполнено(КассовоеПоступление.Плательщик) Тогда
	//	
	//	КассовоеПоступление.Плательщик = 	СоздатьКонтрагентаПоОписанию(Новый Структура("ИНН, КПП, Наименование, ЭтоФизическоеЛицо", ПлательщикИНН, 
	//										ПлательщикКПП, Плательщик, КонтрагентФизЛицо(ПлательщикИНН, ПлательщикКПП)));
	//	
	//КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(КассовоеПоступление.Плательщик) И ТипЗнч(ДанныеНовыхКонтрагентов) = Тип("ТаблицаЗначений") Тогда
		Если ДанныеНовыхКонтрагентов.Количество() > 0 И НЕ ЗначениеЗаполнено(ДанныеНовыхКонтрагентов[ДанныеНовыхКонтрагентов.Количество() - 1].ДокументСсылка) Тогда
			 ДанныеНовыхКонтрагентов[ДанныеНовыхКонтрагентов.Количество()-1].ДокументСсылка     = КассовоеПоступление.Ссылка;
			 ДанныеНовыхКонтрагентов[ДанныеНовыхКонтрагентов.Количество()-1].ИмяРеквизита       = "Плательщик";
			 
			 КонтрагентПовтор = ДанныеНовыхКонтрагентов.Добавить();
			 ЗаполнитьЗначенияСвойств(КонтрагентПовтор, ДанныеНовыхКонтрагентов[ДанныеНовыхКонтрагентов.Количество() - 2]);
			 КонтрагентПовтор.ИмяРеквизита = "Контрагент";
		КонецЕсли;
	КонецЕсли;
	
	КассовоеПоступление.Контрагент		= КассовоеПоступление.Плательщик;
	КассовоеПоступление.СчетКонтрагента = ОпределитьСчетКонтрагента(КассовоеПоступление.Контрагент, ПлательщикРасчСчет, 
										  ПлательщикБИК, ПлательщикИмяБанка, 
										  ПлательщикКорСчет);
	
	
	//-------------------------
	
	Строка							 = КассовоеПоступление.РасшифровкаПлатежа.Добавить();
	Строка.Сумма					 = СуммаДок;
	Строка.СуммаВал					 = СуммаДок;
					
	Попытка
		КассовоеПоступление.Записать();
		СтруктураРекв = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(КассовоеПоступление.Ссылка);
		СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",КассовоеПоступление.Ссылка);
		СтруктураРекв.Вставить("Статус",Перечисления.СтатусыИсполненияДокумента.НаИсполнении);
		СтруктураРекв.Вставить("ДатаПроведения",ДатаДвижения);
		ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);

	Исключение
		Возврат "";
	КонецПопытки;
	
	Возврат КассовоеПоступление.Ссылка;	
	
КонецФункции

// создает кассовое выбытие в случае, если ПП в ИБ не найдено
Функция КассовоеВыбытиеПоПП(ПроизвольныеПараметры, ОбъектСсылка, НеСоздаватьЗагруженныйРанее = Ложь, ВидОбмена = Неопределено, ДанныеНовыхКонтрагентов = Неопределено)     ЭКСПОРТ
	
	Перем СуммаДок;
	Перем НомерДок;
	Перем ДатаДок;
	Перем ВидДокумента;
	Перем НазначениеПлатежа;
	Перем ПолучательИНН;
	Перем ПолучательКПП;
	Перем Получатель;
	Перем ПолучательРасчСчет;
	Перем ПолучательБИК;
	Перем ПолучательИмяБанка;
	Перем ПолучательКорСчет;
	Перем ДатаДвижения;
		
	Если ТипЗнч(ПроизвольныеПараметры) = Тип("Структура") Тогда
		ПроизвольныеПараметры.Свойство("СуммаДок",				СуммаДок);
		ПроизвольныеПараметры.Свойство("НомерДок",				НомерДок);
		ПроизвольныеПараметры.Свойство("ДатаДок",				ДатаДок);
		ПроизвольныеПараметры.Свойство("ВидДокумента",	        ВидДокумента);
		ПроизвольныеПараметры.Свойство("НазначениеПлатежа",		НазначениеПлатежа);
		ПроизвольныеПараметры.Свойство("ПолучательИНН",			ПолучательИНН);
		ПроизвольныеПараметры.Свойство("ПолучательКПП",			ПолучательКПП);
		ПроизвольныеПараметры.Свойство("Получатель",			Получатель);
		ПроизвольныеПараметры.Свойство("ПолучательРасчСчет",	ПолучательРасчСчет);
		ПроизвольныеПараметры.Свойство("ПолучательБИК",			ПолучательБИК);
		ПроизвольныеПараметры.Свойство("ПолучательИмяБанка",	ПолучательИмяБанка);
		ПроизвольныеПараметры.Свойство("ПолучательКорСчет",		ПолучательКорСчет);
		ПроизвольныеПараметры.Свойство("ДатаДвижения",			ДатаДвижения);
	Иначе
		СуммаДок 			= ПроизвольныеПараметры.Получить("СуммаДок");	
		НомерДок 			= ПроизвольныеПараметры.Получить("НомерДок");	
		ДатаДок 			= ПроизвольныеПараметры.Получить("ДатаДок");	
		ВидДокумента        = ПроизвольныеПараметры.Получить("ВидДокумента");
		НазначениеПлатежа	= ПроизвольныеПараметры.Получить("НазначениеПлатежа");	
		ПолучательИНН		= ПроизвольныеПараметры.Получить("ПолучательИНН");	
		ПолучательКПП 		= ПроизвольныеПараметры.Получить("ПолучательКПП");	
		Получатель 			= ПроизвольныеПараметры.Получить("Получатель");	
		ПолучательРасчСчет	= ПроизвольныеПараметры.Получить("ПолучательРасчСчет");	
		ПолучательБИК		= ПроизвольныеПараметры.Получить("ПолучательБИК");	
		ПолучательИмяБанка	= ПроизвольныеПараметры.Получить("ПолучательИмяБанка");	
		ПолучательКорСчет	= ПроизвольныеПараметры.Получить("ПолучательКорСчет");
		ДатаДвижения		= ПроизвольныеПараметры.Получить("ДатаДвижения");
	КонецЕсли;
	
	КассовоеВыбытие = "";
	Контрагент      = ОпределитьКонтрагента(ПолучательИНН, ПолучательКПП, Получатель, , , ВидОбмена, ДанныеНовыхКонтрагентов);
	
	Если НеСоздаватьЗагруженныйРанее Тогда
		 КассовоеВыбытие = ОпределитьДокументДвиженияСозданныйРанее("КассовоеВыбытие", ПроизвольныеПараметры, ОбъектСсылка, Контрагент);
		 Если ТипЗнч(КассовоеВыбытие) = Тип("ДокументСсылка.КассовоеВыбытие") Тогда
			 Если КассовоеВыбытие.Проведен Тогда
				 Возврат КассовоеВыбытие.Ссылка
			 КонецЕсли;
			 КассовоеВыбытие = КассовоеВыбытие.ПолучитьОбъект();
			 КассовоеВыбытие.РасшифровкаПлатежа.Очистить();
		 КонецЕсли;
	КонецЕсли;
		
	Если КассовоеВыбытие = ""  Тогда	
		КассовоеВыбытие = Документы.КассовоеВыбытие.СоздатьДокумент();
	КонецЕсли;
	
	КассовоеВыбытие.Дата						= КонецДня(ОбъектСсылка.ДатаВыписки);
	КассовоеВыбытие.Организация					= ОбъектСсылка.Организация;
	КассовоеВыбытие.ЛицевойСчет					= ОбъектСсылка.ЛицевойСчет;
	КассовоеВыбытие.СуммаДокумента				= СуммаДок;
	
	КассовоеВыбытие.НомерПервичногоДокумента	= НомерДок;
	КассовоеВыбытие.ДатаПервичногоДокумента		= ДатаДок;
	КассовоеВыбытие.ВидПервичногоДокумента      = ВидДокумента;
	
	КассовоеВыбытие.НазначениеПлатежа 		 	= НазначениеПлатежа;
	
	КассовоеВыбытие.ВалютаДокумента				 = Константы.ВалютаРегламентированногоУчета.Получить();
	КассовоеВыбытие.СуммаДокументаВВалюте		 = СуммаДок;
	КассовоеВыбытие.Курс						 = 1;
	КассовоеВыбытие.Кратность					 = 1;
	
	КассовоеВыбытие.ПолучательПлатежа	         = Контрагент;

	
	//Если НЕ ЗначениеЗаполнено(КассовоеВыбытие.ПолучательПлатежа) Тогда
	//	
	//	КассовоеВыбытие.ПолучательПлатежа	 = СоздатьКонтрагентаПоОписанию(Новый Структура("ИНН, КПП, Наименование, ЭтоФизическоеЛицо",
	//																						ПолучательИНН, 
	//																						ПолучательКПП, 
	//																						Получатель,
	//																						КонтрагентФизЛицо(ПолучательИНН, ПолучательКПП)));
	//	
	//КонецЕсли;    
	
	Если НЕ ЗначениеЗаполнено(КассовоеВыбытие.ПолучательПлатежа) И ТипЗнч(ДанныеНовыхКонтрагентов) = Тип("ТаблицаЗначений") Тогда
		Если ДанныеНовыхКонтрагентов.Количество() > 0 И НЕ ЗначениеЗаполнено(ДанныеНовыхКонтрагентов[ДанныеНовыхКонтрагентов.Количество() - 1].ДокументСсылка) Тогда
			 ДанныеНовыхКонтрагентов[ДанныеНовыхКонтрагентов.Количество()-1].ДокументСсылка     = КассовоеВыбытие.Ссылка;
			 ДанныеНовыхКонтрагентов[ДанныеНовыхКонтрагентов.Количество()-1].ИмяРеквизита       = "ПолучательПлатежа";
			 
			 КонтрагентПовтор              = ДанныеНовыхКонтрагентов.Добавить();
			 ЗаполнитьЗначенияСвойств(КонтрагентПовтор, ДанныеНовыхКонтрагентов[ДанныеНовыхКонтрагентов.Количество() - 2]);
			 КонтрагентПовтор.ИмяРеквизита = "Контрагент";
		КонецЕсли;
	КонецЕсли;
	
	КассовоеВыбытие.Контрагент		= КассовоеВыбытие.ПолучательПлатежа;
	КассовоеВыбытие.СчетКонтрагента = ОпределитьСчетКонтрагента(КассовоеВыбытие.Контрагент, 
																ПолучательРасчСчет, 
									  							ПолучательБИК,
																ПолучательИмяБанка, 
									  							ПолучательКорСчет);
	
	//-------------------------
		
	Строка							 = КассовоеВыбытие.РасшифровкаПлатежа.Добавить();
	Строка.Сумма					 = СуммаДок;
	Строка.СуммаВал					 = СуммаДок;	
	
	Попытка
		КассовоеВыбытие.Записать();
		
		СтруктураРекв = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(КассовоеВыбытие.Ссылка);
		СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",КассовоеВыбытие.Ссылка);
		СтруктураРекв.Вставить("Статус",Перечисления.СтатусыИсполненияДокумента.НаИсполнении);
		СтруктураРекв.Вставить("ДатаПроведения",ДатаДвижения);
		ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);

	Исключение
		Возврат "";
	КонецПопытки;
	
	Возврат КассовоеВыбытие.Ссылка;
	
КонецФункции

Функция ОпределитьДоговор(Организация, Контрагент, СчетКонтрагента, НомерДоговора, ДатаДоговора) ЭКСПОРТ
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Организация", 	    Организация);
	Запрос.УстановитьПараметр("Контрагент", 	    Контрагент);
	Запрос.УстановитьПараметр("СчетКонтрагента", 	СчетКонтрагента);
	Запрос.УстановитьПараметр("НомерДоговора", 	    НомерДоговора);
	Запрос.УстановитьПараметр("ДатаДоговора", 	    ДатаДоговора);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	Договоры.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.Договоры КАК Договоры
	               |ГДЕ
	               |	Договоры.ПометкаУдаления = Ложь
	               |	И Договоры.Организация = &Организация
	               |	И Договоры.Контрагент = &Контрагент
	               |	И Договоры.СчетКонтрагента = &СчетКонтрагента
	               |	И Договоры.НомерДоговора = &НомерДоговора
	               |	И Договоры.ДатаДоговора = &ДатаДоговора";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество() > 0 Тогда
		Возврат  Результат[0].Ссылка;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция СоздатьКассовоеВыбытиеНаОснованииРСКП(РСКПСсылка, ОбъектСсылка, Структура = Неопределено, GUIDПП = "", ПроизвольныеПараметры = Неопределено) ЭКСПОРТ
	
	Если НЕ ЗначениеЗаполнено(РСКПСсылка) Тогда
		Возврат "";
	КонецЕсли;
	
	КассовоеВыбытиеСсылка = "";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументОснование", 	РСКПСсылка);
	
	Запрос.Текст = "ВЫБРАТЬ
	             |	КассовоеВыбытие.Ссылка КАК Ссылка
	             |ИЗ
	             |	Документ.КассовоеВыбытие КАК КассовоеВыбытие
	             |ГДЕ
	             |	КассовоеВыбытие.ДокументОснование = &ДокументОснование"; 
				 
				 
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда  
         КассовоеВыбытиеСсылка = Результат.Ссылка
	КонецЕсли;
	 
	Если ЗначениеЗаполнено(КассовоеВыбытиеСсылка) тогда
		КассовоеВыбытие = КассовоеВыбытиеСсылка.ПолучитьОбъект();
		КассовоеВыбытие.РасшифровкаПлатежа.Очистить();  
	Иначе
		КассовоеВыбытие = Документы.КассовоеВыбытие.СоздатьДокумент();
	КонецЕсли;
	
	КассовоеВыбытие.Дата = ?(КонецДня(ОбъектСсылка.ДатаВыписки) = КонецДня(ТекущаяДата()), ТекущаяДата(), КонецДня(ОбъектСсылка.ДатаВыписки));
	
	КассовоеВыбытие.Заполнить(РСКПСсылка);  
	
	СтрокаПП = "";
	
	Если ЗначениеЗаполнено(Структура) И ЗначениеЗаполнено(GUIDПП) Тогда
		СостояниеВыписки = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(ОбъектСсылка);
		
		СтрокаПП = НайтиОписаниеППВСтруктуре(Структура, СостояниеВыписки.GUIDКО, ОбъектСсылка.ЛицевойСчет.Код, ОбъектСсылка.ДатаВыписки, GUIDПП);
		
	КонецЕсли;
	
	Если СтрокаПП <> "" Тогда   
	//есть возможность записать данные первичного документа	   
	
	    Если ПроизвольныеПараметры = Неопределено Тогда
			ПроизвольныеПараметры = Новый Соответствие;
		КонецЕсли;
	
	    ПечатныйОбраз = СтрокаПП.ПечатныйОбраз;

		КассовоеВыбытие.НомерПервичногоДокумента	 = ?(ЗначениеЗаполнено(СвойствоСтруктуры(ПечатныйОбраз, "НомерДокумента")), СвойствоСтруктуры(ПечатныйОбраз, "НомерДокумента"), СвойствоСтруктуры(ПечатныйОбраз, "НомерДок"));
		КассовоеВыбытие.ДатаПервичногоДокумента		 = ПреобразованиеСтрокиВДату(?(ЗначениеЗаполнено(СвойствоСтруктуры(ПечатныйОбраз, "ДатаДокумента")), СвойствоСтруктуры(ПечатныйОбраз, "ДатаДокумента"), СвойствоСтруктуры(ПечатныйОбраз, "ДатаДок")));
		Если ПроизвольныеПараметры["ВидПодтверждающегоДокумента"] <> Неопределено Тогда
			КассовоеВыбытие.ВидПервичногоДокумента   = ПроизвольныеПараметры["ВидПодтверждающегоДокумента"];
		Иначе
			КассовоеВыбытие.ВидПервичногоДокумента   = ПлатежноРасчетныеДокументы.ОпределитьВидПодтверждающегоДокумента(СтрокаПП.ПечатныйОбраз["ВидОперации"]);
			Если НЕ ЗначениеЗаполнено(КассовоеВыбытие.ВидПервичногоДокумента) Тогда
	             КассовоеВыбытие.ВидПервичногоДокумента   = ?(ЗначениеЗаполнено(ТипДокументаПоКоду(СтрокаПП.ПечатныйОбраз["ВидОперации"])), Метаданные.Документы[ТипДокументаПоКоду(СтрокаПП.ПечатныйОбраз["ВидОперации"])].Синоним, "Платежный документ");
			КонецЕсли;
		КонецЕсли;

	КонецЕсли;
	
	Попытка
		КассовоеВыбытие.Записать();
	Исключение
		Возврат "";
	КонецПопытки;    
	
	Если СтрокаПП <> "" Тогда   
	//есть возможность записать данные первичного документа	   
		
		СостояниеКассовоеВыбытие = Новый Структура;
		
		Для каждого КлючЗначение из СостояниеВыписки цикл
			СостояниеКассовоеВыбытие.Вставить(КлючЗначение.Ключ,КлючЗначение.Значение);
		КонецЦикла;	
		
		СостояниеКассовоеВыбытие.ПервичныйОбразИРеквизиты	= Новый ХранилищеЗначения(СтрокаПП.ПечатныйОбраз);
		СостояниеКассовоеВыбытие.GUIDКО 					= GUIDПП;
		СостояниеКассовоеВыбытие.Статус 					= перечисления.СтатусыИсполненияДокумента.Исполнен;
		СостояниеКассовоеВыбытие.Вставить("ПлатежноРасчетныйДокумент",КассовоеВыбытие.Ссылка);
		
		СостояниеКассовоеВыбытие.НомерПодтверждающегоДокумента	= КассовоеВыбытие.НомерПервичногоДокумента;
		СостояниеКассовоеВыбытие.ДатаПодтверждающегоДокумента	= КассовоеВыбытие.ДатаПервичногоДокумента;
		СостояниеКассовоеВыбытие.ВидПодтверждающегоДокумента    = КассовоеВыбытие.ВидПервичногоДокумента;
			
		ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СостояниеКассовоеВыбытие);
			
	КонецЕсли;
		
    Возврат КассовоеВыбытие.Ссылка;
	
КонецФункции	

// создает Документ КассовоеВыбытие по заданным параметрам
// Параметры:
// 		Структура					 - ТЗ, заданного вида с информацией о ПП из банка
// 		ОбъектСсылка				 - Ссылка на выписку, в состав которой должно войти данное Кассовое поступление
// 		GUIDПП						 - уникальный идентификатор Платежного поручения, на основании которого необходимо оформить Кассовое поступление
// 		КВД							 - ссылка на значение перечисления КВД;
// 		ИсточникСредств				 - ссылка на предопределенное значение справочника Источники средств
// 		СуммаВыбытия			 - сумма документа КассовоеВыбытие
/// Возвращаемое значение:
// 		Тип: Либо ссылка на документ КассовоеВыбытие, либо пустая строка (в случае неудачного поиска)
Функция СоздатьКассовоеВыбытие(Структура, ОбъектСсылка, GUIDПП, КВД, ИсточникСредств, СуммаВыбытия, ПроизвольныеПараметры = Неопределено, ВидОбмена = Неопределено, ДанныеНовыхКонтрагентов = Неопределено)     ЭКСПОРТ

	Если Структура.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	СостояниеВыписки = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(ОбъектСсылка);
	
	СтрокаПП = НайтиОписаниеППВСтруктуре(Структура, СостояниеВыписки.GUIDКО, ОбъектСсылка.ЛицевойСчет.Код, ОбъектСсылка.ДатаВыписки, GUIDПП);
	
	Если СтрокаПП = "" Тогда
		Возврат "";
	КонецЕсли;
	
	Если ПроизвольныеПараметры = Неопределено Тогда
		ПроизвольныеПараметры = Новый Соответствие;
	КонецЕсли;   
	
	Если СтрокаПП.СписокСтрокПП.Количество() = 0 Тогда   
		
		СтрокаСпискаПП = СтрокаПП.СписокСтрокПП.Добавить(); 
		
		Если (ПроизвольныеПараметры["КБК"] <> Неопределено) Тогда
			СтрокаСпискаПП.КБК = ПроизвольныеПараметры["КБК"];
		КонецЕсли;
		
		Если (ПроизвольныеПараметры["КодЦели"] <> Неопределено) Тогда
			СтрокаСпискаПП.КодЦели = ПроизвольныеПараметры["КодЦели"];
		КонецЕсли;
		
		Если (ПроизвольныеПараметры["СуммаСписания"] <> Неопределено) Тогда
			СтрокаСпискаПП.Сумма = ПроизвольныеПараметры["СуммаСписания"];
		КонецЕсли;
		
	КонецЕсли;
	
	КассовоеВыбытиеСсылка = НайтиДокументПоGUID("КассовоеВыбытие",GUIDПП);
	
	Если ЗначениеЗаполнено(КассовоеВыбытиеСсылка) Тогда    
		
		Если ЗначениеЗаполнено(ВидОбмена) Тогда
			Если ВидОбмена.ОтменаПовторнойЗагрузкиПроведенныхДокументов И КассовоеВыбытиеСсылка.Проведен Тогда  
				
				Сообщение    = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(НСтр("ru='Документ [Документ] был загружен ранее и проведен. Он останется без изменений.'"),
																									Новый Структура("Документ", 
																													КассовоеВыбытиеСсылка));
				ОбщегоНазначения.СообщитьПользователю(Сообщение);
	
				Возврат КассовоеВыбытиеСсылка;
			КонецЕсли;
		КонецЕсли;	
		
		КассовоеВыбытие = КассовоеВыбытиеСсылка.ПолучитьОбъект();
		КассовоеВыбытие.РасшифровкаПлатежа.Очистить(); 
	Иначе
		КассовоеВыбытие = Документы.КассовоеВыбытие.СоздатьДокумент();
	КонецЕсли;
	
	ПечатныйОбраз = СтрокаПП.ПечатныйОбраз;
	
	КассовоеВыбытие.Дата						 = ?(КонецДня(ОбъектСсылка.ДатаВыписки) = КонецДня(ТекущаяДата()), ТекущаяДата(), КонецДня(ОбъектСсылка.ДатаВыписки));
	КассовоеВыбытие.Организация					 = ОбъектСсылка.Организация;
	КассовоеВыбытие.ЛицевойСчет					 = ОбъектСсылка.ЛицевойСчет;
	КассовоеВыбытие.СуммаДокумента				 = СуммаВыбытия;
	КассовоеВыбытие.НомерПервичногоДокумента	 = ?(ЗначениеЗаполнено(СвойствоСтруктуры(ПечатныйОбраз, "НомерДокумента")), СвойствоСтруктуры(ПечатныйОбраз, "НомерДокумента"), СвойствоСтруктуры(ПечатныйОбраз, "НомерДок"));
	КассовоеВыбытие.ДатаПервичногоДокумента		 = ПреобразованиеСтрокиВДату(?(ЗначениеЗаполнено(СвойствоСтруктуры(ПечатныйОбраз, "ДатаДокумента")), СвойствоСтруктуры(ПечатныйОбраз, "ДатаДокумента"), СвойствоСтруктуры(ПечатныйОбраз, "ДатаДок")));
	Если ПроизвольныеПараметры["ВидПодтверждающегоДокумента"] <> Неопределено Тогда
		КассовоеВыбытие.ВидПервичногоДокумента   = ПроизвольныеПараметры["ВидПодтверждающегоДокумента"];
	Иначе
		КассовоеВыбытие.ВидПервичногоДокумента   = ПлатежноРасчетныеДокументы.ОпределитьВидПодтверждающегоДокумента(СтрокаПП.ПечатныйОбраз["ВидОперации"]);
		Если НЕ ЗначениеЗаполнено(КассовоеВыбытие.ВидПервичногоДокумента) Тогда
             КассовоеВыбытие.ВидПервичногоДокумента   = ?(ЗначениеЗаполнено(ТипДокументаПоКоду(СтрокаПП.ПечатныйОбраз["ВидОперации"])), Метаданные.Документы[ТипДокументаПоКоду(СтрокаПП.ПечатныйОбраз["ВидОперации"])].Синоним, "Платежный документ");
		КонецЕсли;
	КонецЕсли;

	КассовоеВыбытие.НазначениеПлатежа 			 = СвойствоСтруктуры(ПечатныйОбраз, "НазначениеПлатежа");
	
	Если ЗначениеЗаполнено(ПроизвольныеПараметры["Валюта"]) И ЗначениеЗаполнено(ПроизвольныеПараметры["Курс"]) И
		 ЗначениеЗаполнено(ПроизвольныеПараметры["СуммаВРублях"]) Тогда
		 
		КассовоеВыбытие.ВалютаДокумента				 = ПроизвольныеПараметры["Валюта"];
		КассовоеВыбытие.СуммаДокументаВВалюте		 = СуммаВыбытия;
		КассовоеВыбытие.СуммаДокумента               = ПроизвольныеПараметры["СуммаВРублях"];
		КассовоеВыбытие.Курс						 = ПроизвольныеПараметры["Курс"];
		КассовоеВыбытие.Кратность					 = 1; 
		
		Параметры2 = Новый Структура("Валюта, Курс, Кратность", Константы.ВалютаРегламентированногоУчета.Получить(), 1, 1);
		Параметры1 = Новый Структура("Валюта, Курс, Кратность", КассовоеВыбытие.ВалютаДокумента, КассовоеВыбытие.Курс, КассовоеВыбытие.Кратность);
		 
	Иначе
	
		КассовоеВыбытие.ВалютаДокумента				 = Константы.ВалютаРегламентированногоУчета.Получить();
		КассовоеВыбытие.СуммаДокументаВВалюте		 = СуммаВыбытия;
		КассовоеВыбытие.Курс						 = 1;
		КассовоеВыбытие.Кратность					 = 1;
		
	КонецЕсли;      
	
	ЭтоАУБУ                                      = ОпределитьАУБУ(КассовоеВыбытие.Организация, КассовоеВыбытие.Дата);
	
	КассовоеВыбытие.ПолучательПлатежа	         = ОпределитьКонтрагента(СвойствоСтруктуры(ПечатныйОбраз, "ИННПолучателя"),СвойствоСтруктуры(ПечатныйОбраз, "КПППолучателя"), СвойствоСтруктуры(ПечатныйОбраз, "ТекстПолучателя"), , , ВидОбмена, ДанныеНовыхКонтрагентов); 
	
	Если НЕ ЗначениеЗаполнено(КассовоеВыбытие.ПолучательПлатежа) И ТипЗнч(ДанныеНовыхКонтрагентов) = Тип("ТаблицаЗначений") Тогда
		Если ДанныеНовыхКонтрагентов.Количество() > 0 И НЕ ЗначениеЗаполнено(ДанныеНовыхКонтрагентов[ДанныеНовыхКонтрагентов.Количество() - 1].ДокументСсылка) Тогда
			 ДанныеНовыхКонтрагентов[ДанныеНовыхКонтрагентов.Количество()-1].ДокументСсылка     = КассовоеВыбытие.Ссылка;
			 ДанныеНовыхКонтрагентов[ДанныеНовыхКонтрагентов.Количество()-1].ИмяРеквизита       = "ПолучательПлатежа";
			 
			 КонтрагентПовтор              = ДанныеНовыхКонтрагентов.Добавить();
			 ЗаполнитьЗначенияСвойств(КонтрагентПовтор, ДанныеНовыхКонтрагентов[ДанныеНовыхКонтрагентов.Количество() - 2]);
			 КонтрагентПовтор.ИмяРеквизита = "Контрагент";
		КонецЕсли;
	КонецЕсли;
	
	КассовоеВыбытие.Контрагент		= КассовоеВыбытие.ПолучательПлатежа;
	КассовоеВыбытие.СчетКонтрагента = ОпределитьСчетКонтрагента(КассовоеВыбытие.Контрагент, 
																СвойствоСтруктуры(ПечатныйОбраз, "НомерСчетаПолучателя"), 
									  							СвойствоСтруктуры(ПечатныйОбраз, "БИКБанкаПолучателя"),
																СвойствоСтруктуры(ПечатныйОбраз, "НаименованиеБанкаПолучателя"), 
									  							СвойствоСтруктуры(ПечатныйОбраз, "СчетБанкаПолучателя"));
	
	
	//-------------------------
	
	Для Каждого строкаВыбытия Из СтрокаПП.СписокСтрокПП Цикл
		Строка							 = КассовоеВыбытие.РасшифровкаПлатежа.Добавить();
		Если КассовоеВыбытие.ВалютаДокумента <> Константы.ВалютаРегламентированногоУчета.Получить() Тогда
		     Строка.Сумма			     = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(строкаВыбытия.Сумма, Параметры1, Параметры2);
		Иначе
			 Строка.Сумма		    	 = строкаВыбытия.Сумма;
		КонецЕсли;
		Строка.СуммаВал					 = строкаВыбытия.Сумма;
		Если КассовоеВыбытие.Дата < Дата(2016, 1, 1) Тогда 
			Строка.КБКНазначениеПлатежа   = НайтиКБКПоНаименованию(Лев(строкаВыбытия.КБК, 17), строкаВыбытия.ТипКБК, , ЭтоАУБУ, , КассовоеВыбытие.Дата);
			Строка.КОСГУНазначениеПлатежа = ЗначениеКлассификатораПоКоду(Прав(строкаВыбытия.КБК, 3), "КОСГУ");
		Иначе
			Строка.КБКНазначениеПлатежа   = НайтиКБКПоНаименованию(Прав(строкаВыбытия.КБК, 17), строкаВыбытия.ТипКБК, , ЭтоАУБУ, , КассовоеВыбытие.Дата);
			Строка.КОСГУНазначениеПлатежа = ЗначениеКлассификатораПоКоду("000", "КОСГУ");
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(КВД) Тогда
			Строка.КФО                    = КВД;
		Иначе
			Строка.КФО                    = КФОИспользуемыйВЛицевомСчете(КассовоеВыбытие.ЛицевойСчет);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИсточникСредств) Тогда
			Строка.ИсточникСредств	      = ИсточникСредств;
		Иначе
			Строка.ИсточникСредств        = ИсточникСредствИспользуемыйВЛицевомСчете(КассовоеВыбытие.ЛицевойСчет);
		КонецЕсли;
				
		КодЦели                           = ?(ЗначениеЗаполнено(строкаВыбытия.КодЦели), строкаВыбытия.КодЦели, ПроизвольныеПараметры["КодЦели"]);
		//код цели указан либо в файле расшифровки BD либо в файле Выписки
		Если ЗначениеЗаполнено(КодЦели) Тогда
			
			Если (КВД = Перечисления.КВД.ВременноеРаспоряжение) И (СтрДлина(КодЦели) = 25)  Тогда
				
				 Попытка
				 	Строка.НаправлениеРасходованияВР = Перечисления.НаправленияРасходованияВР["_" + Прав(КодЦели, 2)];
				 Исключение
				 КонецПопытки;
				 
				 КодЦели = Лев(КодЦели, 23);
				 
			КонецЕсли;
			
			Строка.КодЦели                = НайтиКодЦели(КодЦели, "Загружен при импорте Выписки № " + ОбъектСсылка.Номер);
			
		КонецЕсли;
				
	КонецЦикла;
	
	Попытка
		КассовоеВыбытие.Записать();
	Исключение
		Возврат "";
	КонецПопытки;
	
	
	СостояниеКассовоеВыбытие = Новый Структура;
	
	Для каждого КлючЗначение из СостояниеВыписки цикл
		СостояниеКассовоеВыбытие.Вставить(КлючЗначение.Ключ,КлючЗначение.Значение);
	КонецЦикла;	
	
	СостояниеКассовоеВыбытие.ПервичныйОбразИРеквизиты	= Новый ХранилищеЗначения(СтрокаПП.ПечатныйОбраз);
	СостояниеКассовоеВыбытие.GUIDКО 					= GUIDПП;
	СостояниеКассовоеВыбытие.Статус 					= перечисления.СтатусыИсполненияДокумента.Исполнен;
	СостояниеКассовоеВыбытие.Вставить("ПлатежноРасчетныйДокумент", КассовоеВыбытие.Ссылка);
	
	СостояниеКассовоеВыбытие.НомерПодтверждающегоДокумента	= КассовоеВыбытие.НомерПервичногоДокумента;
	СостояниеКассовоеВыбытие.ДатаПодтверждающегоДокумента	= КассовоеВыбытие.ДатаПервичногоДокумента;
	СостояниеКассовоеВыбытие.ВидПодтверждающегоДокумента    = КассовоеВыбытие.ВидПервичногоДокумента;     
	
	СостояниеКассовоеВыбытие.ДатаПроведения                 = ?(КонецДня(ОбъектСсылка.ДатаВыписки) = КонецДня(КассовоеВыбытие.Дата), КассовоеВыбытие.Дата, КонецДня(ОбъектСсылка.ДатаВыписки));
		
	ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СостояниеКассовоеВыбытие);
	
	Возврат КассовоеВыбытие.Ссылка;
	
КонецФункции

// находит в ИБ документ Бюджетные данные по Признакам первичного документа
Функция ОпределитьДокументЗадающийБюджетныеДанные(НомерЛС, НомерДок, ДатаДок, GUID = "")     ЭКСПОРТ
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НомерЛС", 		НомерЛС);
	Запрос.УстановитьПараметр("НомерДок", 		НомерДок);
	Запрос.УстановитьПараметр("ДатаДокНач", 	НачалоДня(ДатаДок));
	Запрос.УстановитьПараметр("ДатаДокКон", 	КонецДня(ДатаДок));
	Запрос.УстановитьПараметр("GUIDДок", 		GUID);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	БюджетныеДанные.Ссылка КАК ДокументСсылка
	               |ИЗ
	               |	Документ.БюджетныеДанные КАК БюджетныеДанные
	               |ГДЕ
	               |	БюджетныеДанные.ЛицевойСчет.Код = &НомерЛС
	               |	И БюджетныеДанные.НомерПервичногоДокумента = &НомерДок
	               |	И БюджетныеДанные.ДатаПервичногоДокумента <= &ДатаДокКон
	               |	И БюджетныеДанные.ДатаПервичногоДокумента >= &ДатаДокНач";
				   
// Нужно добавить поиск по GUID ОФК				   
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Возврат Результат.ДокументСсылка;
	КонецЕсли;
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	               |	РасходноеРасписание.Ссылка КАК ДокументСсылка
	               |ИЗ
	               |	Документ.РасходноеРасписание КАК РасходноеРасписание
	               |ГДЕ
	               |	РасходноеРасписание.Номер = &НомерДок
	               |	И РасходноеРасписание.Дата <= &ДатаДокКон
	               |	И РасходноеРасписание.Дата >= &ДатаДокНач
	               |	И РасходноеРасписание.ЛицевойСчет.Код = &НомерЛС";
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Возврат Результат.ДокументСсылка;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ОпределитьПлатежноеПоручение(НомерЛС, Организация, ПроизвольныеПараметры)     ЭКСПОРТ
	
	Перем НомерДок;
	Перем ДатаДок;
	Перем СуммаДок;
	Перем ПолучательИНН;
	Перем ПолучательРасчСчет;
	Перем ДатаДвижения;     
	Перем ДатаКвитанции;
	
	Если ТипЗнч(ПроизвольныеПараметры) = Тип("Структура") Тогда
		ПроизвольныеПараметры.Свойство("НомерДок", 				НомерДок);
		ПроизвольныеПараметры.Свойство("ДатаДок", 				ДатаДок);
		ПроизвольныеПараметры.Свойство("СуммаДок", 				СуммаДок);
		ПроизвольныеПараметры.Свойство("ПолучательИНН", 		ПолучательИНН);
		ПроизвольныеПараметры.Свойство("ПолучательРасчСчет",	ПолучательРасчСчет);
		ПроизвольныеПараметры.Свойство("ДатаДвижения",			ДатаДвижения);  
		ПроизвольныеПараметры.Свойство("ДатаКвитанции",			ДатаКвитанции);
	Иначе
		НомерДок 			= ПроизвольныеПараметры.Получить("НомерДок");
		ДатаДок 			= ПроизвольныеПараметры.Получить("ДатаДок");
		СуммаДок 			= ПроизвольныеПараметры.Получить("СуммаДок");
		ПолучательИНН 		= ПроизвольныеПараметры.Получить("ПолучательИНН");
		ПолучательРасчСчет	= ПроизвольныеПараметры.Получить("ПолучательРасчСчет");
		ДатаДвижения		= ПроизвольныеПараметры.Получить("ДатаДвижения"); 
		ДатаКвитанции       = ПроизвольныеПараметры.Получить("ДатаКвитанции"); 
	КонецЕсли;
		
	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НомерЛС", 		НомерЛС);
	Запрос.УстановитьПараметр("ПолныйНомерДок", ВосстановитьНомерДляИБ(Организация, НомерДок,"ПлатежноеПоручение"));
	Запрос.УстановитьПараметр("НомерДок", 		НомерДок);
	Запрос.УстановитьПараметр("ДатаДокНач", 	НачалоДня(ДатаДок));
	Запрос.УстановитьПараметр("ДатаДокКон", 	КонецДня(ДатаДок));
	//Запрос.УстановитьПараметр("СуммаДокумента", ПроизвольныеПараметры.Получить("СуммаДок"));
	
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ВложенныйЗапрос.Ссылка						КАК ДокументСсылка
	|ИЗ
	|	(ВЫБРАТЬ
	|		ПлатежноеПоручение.Ссылка 					КАК Ссылка
	|	ИЗ
	|		Документ.ПлатежноеПоручение КАК ПлатежноеПоручение
	|	ГДЕ
	|	   (ПлатежноеПоручение.Номер = &НомерДок  ИЛИ  ПлатежноеПоручение.Номер = &ПолныйНомерДок)
	//|		И ПлатежноеПоручение.СуммаДокумента 	= &СуммаДокумента 
	|		И ПлатежноеПоручение.ЛицевойСчет.Код 	= &НомерЛС
	|		И (ПлатежноеПоручение.Дата >= &ДатаДокНач) И (ПлатежноеПоручение.Дата <= &ДатаДокКон)
	|	
	|	 ) КАК ВложенныйЗапрос
	|	
	|";
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		
		ПлатежноеПоручение = Результат.ДокументСсылка.ПолучитьОбъект();
		
		ЕстьИзменения = Ложь;
	   	// проверка на наличие изменений
		
		ДанныеКонтрагента = Новый Структура("СсылкаНаОбъект, ИНН", Результат.ДокументСсылка.Контрагент);
		
		Справочники.Контрагенты.ПолучитьДанныеКонтрагента(ДанныеКонтрагента);
		
		Если (ПлатежноеПоручение.СуммаДокумента <> СуммаДок) 
			 ИЛИ (ДанныеКонтрагента.ИНН) <> ПолучательИНН 
			 ИЛИ (СокрЛП(ПлатежноеПоручение.СчетКонтрагента.Код) <> СокрЛП(ПолучательРасчСчет)) Тогда
			 
			 ЕстьИзменения = Истина;
			 
		КонецЕсли;                              
		//------------------------------
		Если ЕстьИзменения Тогда
			 ПлатежноеПоручение = ЗаполнитьПП(ПлатежноеПоручение, ПроизвольныеПараметры).Ссылка;
			 ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Изменен документ " + ПлатежноеПоручение+"'"));
		Иначе
			 ПлатежноеПоручение = Результат.ДокументСсылка;
		КонецЕсли;
		
		СтруктураРекв = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(ПлатежноеПоручение.Ссылка); 
		
		СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",    ПлатежноеПоручение.Ссылка);
		СтруктураРекв.Вставить("Статус",                       Перечисления.СтатусыИсполненияДокумента.Исполнен); 
		СтруктураРекв.Вставить("ДатаПроведения",               ДатаДвижения);  
		СтруктураРекв.Вставить("ДатаПодтверждающегоДокумента", ДатаКвитанции);    
		СтруктураРекв.Вставить("ВидПодтверждающегоДокумента",  "Квитанция");
		
		ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);

		Возврат ПлатежноеПоручение;
	КонецЕсли;

	Возврат "";
	
КонецФункции

Процедура ОпределитьДокументПоступления(ПроизвольныеПараметры,Объект)     ЭКСПОРТ
	
	Перем ВидДокумента;
	Перем НомерДок;
	Перем ДатаДок;
	Перем СуммаДок;
	Перем ПлательщикИНН;
	Перем ПлательщикРасчСчет;
	Перем ДатаДвижения;
	
	Если ТипЗнч(ПроизвольныеПараметры) = Тип("Структура") Тогда
		ПроизвольныеПараметры.Свойство("ВидДокумента", 		ВидДокумента);
		ПроизвольныеПараметры.Свойство("НомерДок", 			НомерДок);
		ПроизвольныеПараметры.Свойство("ДатаДок", 			ДатаДок);
		ПроизвольныеПараметры.Свойство("СуммаДок", 			СуммаДок);
		ПроизвольныеПараметры.Свойство("ПлательщикИНН", 	ПлательщикИНН);
		ПроизвольныеПараметры.Свойство("ПлательщикРасчСчет",ПлательщикРасчСчет);
		ПроизвольныеПараметры.Свойство("ДатаДвижения",ДатаДвижения);
	Иначе
		ВидДокумента 		= ПроизвольныеПараметры.Получить("ВидДокумента");
		НомерДок 			= ПроизвольныеПараметры.Получить("НомерДок");
		ДатаДок 			= ПроизвольныеПараметры.Получить("ДатаДок");
		СуммаДок 			= ПроизвольныеПараметры.Получить("СуммаДок");
		ПлательщикИНН 		= ПроизвольныеПараметры.Получить("ПлательщикИНН");
		ПлательщикРасчСчет	= ПроизвольныеПараметры.Получить("ПлательщикРасчСчет");
		ДатаДвижения	= ПроизвольныеПараметры.Получить("ДатаДвижения");

	КонецЕсли;
		
	Если ВидДокумента = "Платежное требование" Тогда
		ВидДокумента = "ПлатежноеТребование";
	ИначеЕсли ВидДокумента = "Инкассовое поручение" Тогда
		ВидДокумента = "ИнкассовоеПоручение";
	Иначе
		//не известный вид документа, ничего не делаем
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НомерЛС", 		Объект.ЛицевойСчет.Код);
	Запрос.УстановитьПараметр("ПолныйНомерДок", ВосстановитьНомерДляИБ(Объект.Организация, НомерДок, ВидДокумента));
	Запрос.УстановитьПараметр("НомерДок", 		НомерДок);
	Запрос.УстановитьПараметр("ДатаДокНач", 	НачалоДня(ДатаДок));
	Запрос.УстановитьПараметр("ДатаДокКон", 	КонецДня(ДатаДок));
	//Запрос.УстановитьПараметр("СуммаДокумента", ПроизвольныеПараметры.Получить("СуммаДок"));
	
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ВложенныйЗапрос.Ссылка						КАК ДокументСсылка
	|ИЗ
	|	(ВЫБРАТЬ
	|		ПлатежноеПоручение.Ссылка 					КАК Ссылка
	|	ИЗ
	|		Документ."+ВидДокумента+" КАК ПлатежноеПоручение
	|	ГДЕ
	|	   (ПлатежноеПоручение.Номер = &НомерДок  ИЛИ  ПлатежноеПоручение.Номер = &ПолныйНомерДок)
	//|		И ПлатежноеПоручение.СуммаДокумента 	= &СуммаДокумента 
	|		И ПлатежноеПоручение.ЛицевойСчет.Код 	= &НомерЛС
	|		И (ПлатежноеПоручение.Дата >= &ДатаДокНач) И (ПлатежноеПоручение.Дата <= &ДатаДокКон)
	|	
	|	 ) КАК ВложенныйЗапрос
	|	
	|";
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		
		ДокументОбъект = Результат.ДокументСсылка.ПолучитьОбъект();
		
		ЕстьИзменения = Ложь;
		
		ДанныеКонтрагента = Новый Структура("СсылкаНаОбъект, ИНН", Результат.ДокументСсылка.Контрагент);
		
		Справочники.Контрагенты.ПолучитьДанныеКонтрагента(ДанныеКонтрагента);
		
		
		// проверка на наличие изменений
		Если (ДокументОбъект.СуммаДокумента <> СуммаДок)     
			 ИЛИ (ДанныеКонтрагента.ИНН <> ПлательщикИНН) 
			 ИЛИ (СокрЛП(ДокументОбъект.СчетКонтрагента.Код) <> СокрЛП(ПлательщикРасчСчет)) Тогда
			 
			 ЕстьИзменения = Истина;
			 
		КонецЕсли;
		
		Если ЕстьИзменения Тогда
			 ДокументОбъект = ЗаполнитьИП_ПТ(ДокументОбъект, ПроизвольныеПараметры).Ссылка;
			 ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Изменен документ " + ДокументОбъект+"'"));
		Иначе
			 ДокументОбъект = Результат.ДокументСсылка;
		КонецЕсли;
		
		СтруктураРекв = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(ДокументОбъект.Ссылка);  
		
		СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",       ДокументОбъект.Ссылка);
		СтруктураРекв.Вставить("Статус",                          Перечисления.СтатусыИсполненияДокумента.Исполнен);
		СтруктураРекв.Вставить("ДатаПроведения",                  ДатаДвижения);   
		
		ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);

		Возврат;
	КонецЕсли;

	Возврат;
	
КонецПроцедуры

Функция ЗаполнитьИП_ПТ(ДокументОбъект, ПроизвольныеПараметры)
	Перем ПолучательБИК;
	Перем НазначениеПлатежа;
	Перем СуммаДок;
	Перем ВидПлатежа;
	Перем Очередность;
	Перем Получатель;
