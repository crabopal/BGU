Функция ПолучитьАльтернативныйИдентификатор(ДокументСсылка) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КвитанцияНаОплатуГосуслугТаблицаИдентификаторов.НомерСтроки КАК НомерСтроки,
		|	КвитанцияНаОплатуГосуслугТаблицаИдентификаторов.ПолеИдентификатор,
		|	КвитанцияНаОплатуГосуслугТаблицаИдентификаторов.Ссылка.АльтернативныйИдентификаторПлательщика КАК АльтИд
		|ИЗ
		|	Документ.КвитанцияНаОплатуГосуслуг.ТаблицаИдентификаторов КАК КвитанцияНаОплатуГосуслугТаблицаИдентификаторов
		|ГДЕ
		|	КвитанцияНаОплатуГосуслугТаблицаИдентификаторов.Ссылка = &Ссылка
		|	И КвитанцияНаОплатуГосуслугТаблицаИдентификаторов.ИмяВФайле = ""AltPayerIdentifier""
		|	И КвитанцияНаОплатуГосуслугТаблицаИдентификаторов.ТипПоля В(&МассивИспользуемыхТипов)
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки УБЫВ";

	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	МассивИспользуемыхТипов = Новый Массив;
	МассивИспользуемыхТипов.Добавить("ДопАльтИдентификатор_Ребенок");
	МассивИспользуемыхТипов.Добавить("ДопАльтИдентификатор_Учащийся");
	МассивИспользуемыхТипов.Добавить("ДопАльтИдентификатор");
	
	Запрос.УстановитьПараметр("МассивИспользуемыхТипов", МассивИспользуемыхТипов);
	
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ТекЗначение = СокрЛП(Выборка.ПолеИдентификатор);
		
		Если ЗначениеЗаполнено(ТекЗначение) Тогда
			Возврат ТекЗначение;
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции

Функция ПроверитьПоРегулярномуВыражению(Знач Значение,РегулярноеВыражение,ПустоеРазрешено=Ложь,ИгнорироватьРегистр = Ложь) Экспорт
	
	Если ПустоеРазрешено = Истина
		И НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Истина;
	КонецЕсли;
	
	ПроверяемоеЗначение = Значение;
	Если ТипЗнч(ПроверяемоеЗначение) <> Тип("Строка") Тогда
		ПроверяемоеЗначение = "";
	КонецЕсли;
	
	Результат = СтрПодобнаПоРегулярномуВыражению(ПроверяемоеЗначение,РегулярноеВыражение,ИгнорироватьРегистр,Ложь);
		
	Возврат Результат;
КонецФункции

Функция ЗначенияРавны(ЗначениеПервое, ЗначениеВторое) Экспорт
	
	Результат = Ложь;
	Попытка
		Результат = (ЗначениеПервое = ЗначениеВторое);
	Исключение
		//значения сравнить нельзя
		Результат = Ложь;
	КонецПопытки;
	
	Возврат Результат;
КонецФункции

Функция ТаблицаОтбораПоУчастникам(МассивУчастников) Экспорт
	ТаблицаОтбора = Новый ТаблицаЗначений;
	ТаблицаОтбора.Колонки.Добавить("Участник");
	ТаблицаОтбора.Колонки.Добавить("ССЫЛКАДОКУМЕНТА");
	ТаблицаОтбора.Колонки.Добавить("НомерСтроки");
	ТаблицаОтбора.Колонки.Добавить("ИмяТабЧасти",       Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)));
	ТаблицаОтбора.Колонки.Добавить("ПОЛЕСВЯЗИ");
	
	Если ТипЗнч(МассивУчастников)<>Тип("Массив") Тогда
		Возврат ТаблицаОтбора;
	КонецЕсли;
	
	СсылкаДокумента = Документы.ЗапросУНИФО.ПустаяСсылка();
	
	НомерСтроки = 1;
	Для Каждого ТекЭлемент Из МассивУчастников Цикл
		НовСтр = ТаблицаОтбора.Добавить();
		НовСтр.Участник = ТекЭлемент;
		НовСтр.ССЫЛКАДОКУМЕНТА = СсылкаДокумента;
		НовСтр.НомерСтроки = НомерСтроки;
		НовСтр.ИмяТабЧасти = "ТАБЛИЦАУЧАСТНИКОВ";
		НовСтр.ПОЛЕСВЯЗИ = ИСТИНА;
		
		НомерСтроки = НомерСтроки + 1;
		
	КонецЦикла;
	
	Возврат ТаблицаОтбора;
КонецФункции

