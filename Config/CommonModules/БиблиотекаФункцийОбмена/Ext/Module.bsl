Функция КодБюджета(ВсеОбъекты,Задание) ЭКСПОРТ
	
	Количество = ВсеОбъекты.Количество();
	
	Если Количество = 0 Тогда
		Объект = Задание;
	Иначе
		Объект = ВсеОбъекты[Количество-1].Значение;
	КонецЕсли;
	
	Если Документы.ТипВсеСсылки().СодержитТИп(ТипЗнч(Объект)) Тогда //это документ
		
		ЗапросТекстШапка  = "ВЫБРАТЬ";
		ЗапросТекстПодвал = " ";
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ИФО", Объект.Метаданные()) 
			И ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
			ЗапросТекстШапка  = ЗапросТекстШапка +"
			|	ВЫБОР
			|		КОГДА Объект.ИФО.ИспользоватьРеквизитыИФО
			|			ТОГДА Объект.ИФО.Бюджет.Код
			|				ИНАЧЕ "; 
			
			ЗапросТекстПодвал = " КОНЕЦ "
		КонецЕсли;
		  
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ЛицевойСчет", Объект.Метаданные()) Тогда
			ЗапросТекстШапка  = ЗапросТекстШапка +"
			|	Объект.ЛицевойСчет.Владелец.Бюджет.Код";
		ИначеЕсли ОбщегоНазначения.ЕстьРеквизитОбъекта("Организация", Объект.Метаданные()) Тогда	 
			ЗапросТекстШапка  = ЗапросТекстШапка +"
			|	Объект.Организация.Бюджет.Код ";
		Иначе	
            ЗапросТекстШапка  = ЗапросТекстШапка +"
			|	""00000000""";
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = ЗапросТекстШапка + ЗапросТекстПодвал + "КАК ЭлементБюджета
		|ИЗ
		|	Документ." + Объект.Метаданные().Имя + " КАК Объект
		|ГДЕ
		|	Объект.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", Объект);
		
		Попытка 
			Выборка = Запрос.Выполнить().Выбрать();
		Исключение
			Возврат "00000000";
		КонецПопытки;	
		
		Если Выборка.Следующий() Тогда
			
			Если НЕ ЗначениеЗаполнено(Выборка.ЭлементБюджета) Тогда
				Возврат "00000000";
			Иначе
				Возврат СтроковыеФункцииКлиентСервер.ДополнитьСтроку(Прав(Выборка.ЭлементБюджета, 8), 8, "0");
			КонецЕсли;
			
		Иначе
			Возврат "00000000";
		КонецЕсли;	
		
	КонецЕсли;
КонецФункции

// Возвращает значение рабочего телефона контрагента
Функция ПолучитьРабТелефонКонтрагент(Ссылка) Экспорт
		
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтактнаяИнформация.Представление
	|ИЗ
	|	Справочник." + Ссылка.Метаданные().Имя + ".КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	(КонтактнаяИнформация.Ссылка = &Ссылка)
	|	И (КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон))
	|	И (КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонРабочийФизическиеЛица))";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
		
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Представление;
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

// Формирует строку всех возможных счетов
Функция ВернутьСтрокуВсехСчетов(Задание)     ЭКСПОРТ
	
	к				 = 1;
	СтрокаСчетов	 = "";
	
	Для каждого СтрокаЗадания из Задание.ОбъектыОбмена Цикл
		
		СтСтрокаСчетов = СтрокаСчетов;
		
		Если к > 1 Тогда
			СтрокаСчетов = СтрокаСчетов + "РасчСчет="
		КонецЕсли;
		
		Попытка
			
			Если Найти(СтрокаСчетов, СтрокаЗадания.Объект.ПлательщикБанковскийСчет) > 0 Тогда
				СтрокаСчетов = СтСтрокаСчетов;
				Продолжить;
			КонецЕсли;
			
			СтрокаСчетов = СтрокаСчетов + СтрокаЗадания.Объект.ПлательщикБанковскийСчет;
			
		Исключение
			СтрокаСчетов = СтСтрокаСчетов;
			Продолжить;
		КонецПопытки;
		
		Если к < Задание.ОбъектыОбмена.Количество() Тогда
			СтрокаСчетов = СтрокаСчетов + Символы.ПС;
		КонецЕсли;
		
		к = к + 1;
		
	КонецЦикла;
	
	Возврат СтрокаСчетов;
	
КонецФункции

// Заменяет служебные символы в значении поля файла передачи на аналоги
// (это необходимо для корректной обработки информации из подготовленного файла передачи)
//
// Параметры:
//		СтрокаНаВходе (Тип: строка) - поле передачи, содержащее служебные символы.
// Возвращаемое значение:
//		Тип: строка - поле передачи с замененными служебными символами.
Функция УдалениеСлужебныхСимволов(СтрокаНаВходе)     ЭКСПОРТ
	
	СтрокаНаВыходе = Строка(СтрокаНаВходе);
	
	СтрокаНаВыходе = СтрЗаменить(СтрокаНаВыходе, Символы.ПС,   " ");
	СтрокаНаВыходе = СтрЗаменить(СтрокаНаВыходе, Символы.Таб,  " ");
	СтрокаНаВыходе = СтрЗаменить(СтрокаНаВыходе, Символы.ВК,   " ");
	СтрокаНаВыходе = СтрЗаменить(СтрокаНаВыходе, Символы.ВТаб, " ");
	СтрокаНаВыходе = СтрЗаменить(СтрокаНаВыходе, Символы.НПП,  " ");
	СтрокаНаВыходе = СтрЗаменить(СтрокаНаВыходе, Символы.ПФ,   " ");

	
	СтрокаНаВыходе = СтрЗаменить(СтрокаНаВыходе, "|", "/");
	СтрокаНаВыходе = СтрЗаменить(СтрокаНаВыходе, "«", """");
    СтрокаНаВыходе = СтрЗаменить(СтрокаНаВыходе, "»", """");
	СтрокаНаВыходе = СтрЗаменить(СтрокаНаВыходе, "-", "-");
		
	Возврат СтрокаНаВыходе;
	
КонецФункции

// Переводит число, заданное в 10-чной системе счисления, в нужную систему счисления
//
// Параметры:
//		ЧислоНаВходе (Тип: Число) - Число которое нужно перевести из 10-чной в заданную систему счисления;
//		Основание (Тип: Число)    - Основание системы счисления
//		Длина (Тип: Число)        - Длинна возвращаемой строки
// Возвращаемое значение:
//		Тип: Строка - число в заданной системе счисления в форме строки заданной длинны
Функция ПереводИзДесятичнойСистемы(Знач ЧислоНаВходе = 0, Основание = 36, Длина)     ЭКСПОРТ

	Если Основание <= 0 Тогда
		Возврат("")
	КонецЕсли;
	
	ЧислоНаВходе = Число(ЧислоНаВходе);
	
	Если ЧислоНаВходе <= 0 Тогда
		Возврат("0")
	КонецЕсли;
	
	ЧислоНаВходе  = Цел(ЧислоНаВходе);
	Результат     = "";
	
	Пока ЧислоНаВходе > 0 Цикл
		
		Результат     = Сред("0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ", ЧислоНаВходе%Основание + 1, 1) + Результат;
		ЧислоНаВходе  = Цел(ЧислоНаВходе/Основание);
		
	КонецЦикла;
	
	Результат = Строка(Результат);
	
	Пока СтрДлина(Результат) < Длина Цикл
		
		Результат = "0" + Результат;
		
	КонецЦикла;
	
	Возврат Результат;

КонецФункции

// Переводит число, заданное в n-нной системе счисления, в 10-чную систему счисления
//
// Параметры:
// 		ЧислоНаВходе (Тип: Строка) - Строковое представления числа в n-нной системе счисления;
// 		Основание (Тип: Число)     - Основание (n) для системы счисления, из которой переводим значение
// Возвращаемое значение:
// 		Тип: Число  - Число в десятичной системе счисления
Функция ПереводВДесятичнуюСистему(Знач ЧислоНаВходе = "0", Основание = 36) Экспорт
	
	Если Основание <= 0 Тогда
		Возврат(0)
	КонецЕсли;
	
	ЧислоНаВходе = Врег(СокрЛП(ЧислоНаВходе));
	
	Если ЧислоНаВходе = "0" Тогда
		Возврат(0)
	КонецЕсли;
	
	Результат = 0;
	Длина     = СтрДлина(ЧислоНаВходе);
	
	Для Х = 1 По Длина Цикл
		
		М = 1;
		Для У = 1 По Длина-Х Цикл
			М = М*Основание
		КонецЦикла;
		Результат = Результат+(Найти("0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ", Сред(ЧислоНаВходе, Х, 1))-1)*М;
		
	КонецЦикла;
	
	Возврат Окр(Результат);
	
КонецФункции

// Переводит значение дня в десятичную систему и сохраняет его
//
// Параметры:
// 		Значение (тип: Строка) - день формирования файла в 36-ричной системе счисления
// Возвращаемое значение:
// 		Истина
Функция СохранитьЗначениеДня(Значение, СоответствиеПеременных)     ЭКСПОРТ
	
	День = ПереводВДесятичнуюСистему(Значение, 36);
	
	Если ТипЗнч(День) <> Тип("Число") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СоответствиеПеременных.Вставить("ДеньФайлаПередачи", День);
	
	Возврат Истина;
	
КонецФункции

// Переводит значение дня в десятичную систему и сохраняет его
//
// Параметры:
// 		Значение (тип: Строка) - день формирования файла в 36-ричной системе счисления
// Возвращаемое значение:
// 		Истина
Функция СохранитьЗначениеМесяца(Значение, СоответствиеПеременных)     ЭКСПОРТ
	
	Месяц = ПереводВДесятичнуюСистему(Значение, 36);
	
	Если ТипЗнч(Месяц) <> Тип("Число") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	СоответствиеПеременных.Вставить("МесяцФайлаПередачи", Месяц);
	
	Возврат Истина;
	
КонецФункции


// Сохраняет значение заданного произвольного параметра
Функция СохранитьЗначениеПроизвольногоПараметра(СписокПроизвольныхПараметров, ИмяПараметра, Значение)     Экспорт
	
	СписокПроизвольныхПараметров.Вставить(ИмяПараметра, Значение);
	
	Возврат Значение;
	
КонецФункции

// Возвращает название типа документа по заданному коду
//
Функция ТипДокументаПоКоду(КодДокумента)
	
	ТипДокумента   = "";
	
	Если КодДокумента = "ZA" Тогда
		ТипДокумента  = "ЗапросНаАннулированиеЗаявки"
	ИначеЕсли КодДокумента = "UF" Тогда
		ТипДокумента  = "УведомлениеОбУточненииВидаИПринадлежностиПлатежа"
	ИначеЕсли КодДокумента = "ZV" Тогда
		ТипДокумента  = "ЗаявкаНаВозврат"
	ИначеЕсли КодДокумента = "ZR" Тогда
		ТипДокумента  = "ЗаявкаНаКассовыйРасход"
	ИначеЕсли КодДокумента = "ZN" Тогда
		ТипДокумента  = "ЗаявкаНаНаличные"
	КонецЕсли;
	
	Возврат ТипДокумента;
	
КонецФункции

// Ищет документ по предопределенным параметрам
Функция НайтиДокументКлиентаВпротоколе(Значение, СписокПроизвольныхПараметров)     Экспорт
	
	ДатаДокумента   = Дата(Число(Прав(Значение,4)), Число(Сред(Значение, 4, 2)), Число(Лев(Значение, 2)));
	
	КодДокумента    = СписокПроизвольныхПараметров.Получить("КодДокумента");
	НомерДокумента  = СписокПроизвольныхПараметров.Получить("НомерДокумента");
	ИДДокумента     = СписокПроизвольныхПараметров.Получить("ИДДокумента");
	
	ТипДокумента    = ТипДокументаПоКоду(КодДокумента);
	ДокументКлиента = "";
	
	Если ЗначениеЗаполнено(ТипДокумента) И ЗначениеЗаполнено(ДатаДокумента) И ЗначениеЗаполнено(НомерДокумента) Тогда
		
		Запрос = Новый Запрос;
		
		Запрос.УстановитьПараметр("НачДата", НачалоДня(ДатаДокумента));
		Запрос.УстановитьПараметр("КонДата", КонецДня(ДатаДокумента));
		
		Запрос.Текст = "
		|ВЫБРАТЬ
		|	Док.Номер                     КАК НомерДокумента,
		|	Док.Ссылка                    КАК ДокументСсылка
		|ИЗ
		|	Документ." + ТипДокумента + " КАК Док
		|ГДЕ
		|	(Док.Дата МЕЖДУ &НачДата И &КонДата)
		|	И (Док.ПометкаУдаления = Ложь)
		|";
		
		Результат = Запрос.Выполнить().Выбрать();
		
		Пока Результат.Следующий() Цикл
			
			Если Прав(Результат.НомерДокумента, СтрДлина(НомерДокумента)) = НомерДокумента Тогда
				
				ДокументКлиента = Результат.ДокументСсылка;
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	СписокПроизвольныхПараметров.Вставить("ДокументКлиента", ДокументКлиента);
	Возврат ДатаДокумента;
	
КонецФункции

// Проверяет соответствие даты файла передачи установленному временному диапазону
//
// Параметры:
// 		ЗначениеМес  (тип: Строка) - день формирования файла в 36-ричной системе счисления
//		ДатаОт, ДатаДо (тип: Дата) - даты, задающие временной интервал
// Возвращаемое значение:
// 		Булево (Истина - дата файла входит в указанные временные рамки,
// 				Ложь   - дата файла не соответствует указанному временному периоду)
Функция ФайлВУстановленномПериоде(ЗначениеМес, ДатаОт, ДатаДо, СоответствиеПеременных,ЭтоМесяц = Истина)     ЭКСПОРТ
	
	Если ЭтоМесяц Тогда
		МесФайла       = ПереводВДесятичнуюСистему(ЗначениеМес, 36);
		
		Если ТипЗнч(МесФайла) <> Тип("Число") Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Если МесФайла > 12 Тогда
			МесФайла = МесФайла - 12;
		КонецЕсли;
		
		ДеньФайла      = СоответствиеПеременных.Получить("ДеньФайлаПередачи");
		
		Если ТипЗнч(ДеньФайла) <> Тип("Число") Тогда
			Возврат Ложь;
		КонецЕсли;
	Иначе
		МесФайла = СоответствиеПеременных.Получить("МесяцФайлаПередачи");
		
		Если ТипЗнч(МесФайла) <> Тип("Число") Тогда
			Возврат Ложь;
		КонецЕсли;

		Если МесФайла > 12 Тогда
			МесФайла = МесФайла - 12;
		КонецЕсли;
		
		ДеньФайла      = ПереводВДесятичнуюСистему(ЗначениеМес, 36);
			
		Если ТипЗнч(ДеньФайла) <> Тип("Число") Тогда
			Возврат Ложь;
		КонецЕсли;

	КонецЕсли;
	
	ЧислоДатаФайла = МесФайла*100 + ДеньФайла;
	ЧислоДатаДо    = Месяц(ДатаДо)*100 + День(ДатаДо);
	ЧислоДатаОт    = Месяц(ДатаОт)*100 + День(ДатаОт);

	Если (ЧислоДатаФайла >= ЧислоДатаОт) И (ЧислоДатаФайла <= ЧислоДатаДо) Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

// Проверяет наличие в ИБ формата для импорта выписки в форматах систем Клиента Банка
Функция ФорматИмпортаВыпискиКБ(Формат, НомерФормата, ВидОбмена)     ЭКСПОРТ
	
	Формат = Справочники.ФорматыОбменаБанкиКС.НайтиПоНаименованию(НомерФормата, Истина, , ВидОбмена);
	
	Если НЕ(ЗначениеЗаполнено(Формат)) Тогда
		 Возврат Ложь;
	КонецЕсли;
	 
	Возврат Истина;
	
КонецФункции

// Проверяет наличие формата в ИБ, с помощью которого должен производиться обмен
//		ТипОбмена  (тип: СправочникСсылка.КС_ТипыФорматов)              - тип форматов обмена
//		ПолноеИмяФайла(тип: Строка)                                     - путь к файлу передачи
//		НаправлениеОбмена(тип: ПеречислениеСсылка.КС_НаправлениеОбмена) - экспорт или импорт
// Возвращаемое значение:
//		Булево 
Функция ПроверкаНаличияФорматаПоМаркеруОФК(Формат, ТипОбмена, ПолноеИмяФайла, НаправлениеОбмена = "", СообщениеОбОшибке = "")   

	//устанавливаем маркер
	Маркер    = "";
	
	Текст = Новый ЧтениеТекста(ПолноеИмяФайла);
	Стр   = Текст.ПрочитатьСтроку();
	
	Маркер = Сред(Стр, Найти(Стр, "TX"), 10);
	
	Если Лев(Маркер, 2) <> "TX" Тогда
		СообщениеОбОшибке = НСтр("ru = 'Формат файла не соотвествует требованиям обмена с ОФК/УФК'");
		Возврат Ложь;
	КонецЕсли;
	
	//--------------------
		
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ВидОбмена",        ТипОбмена);
	Запрос.УстановитьПараметр("НаправлениеОбмена", НаправлениеОбмена);
	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	Форматы.Наименование    КАК НаименованиеФормата,
	|	Форматы.Ссылка          КАК Формат
	|ИЗ
	|	Справочник.ФорматыОбменаБанкиКС    КАК Форматы
	|ГДЕ
	|	Форматы.Владелец.Ссылка            = &ВидОбмена
	|	И Форматы.НаправлениеОбмена.Ссылка = &НаправлениеОбмена
	|";
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		Если Лев(Результат.НаименованиеФормата, 10) = Маркер Тогда
			Формат = Результат.Формат;
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	СообщениеОбОшибке = НСтр("ru = 'В системе отсутствует формат '") + Маркер;
	Возврат Ложь;
	
КонецФункции

// Проверяет наличие формата в ИБ, с помощью которого должен производиться обмен
//		ТипОбмена  (тип: СправочникСсылка.КС_ТипыФорматов)              - тип форматов обмена
//		ПолноеИмяФайла(тип: Строка)                                     - путь к файлу передачи
//		НаправлениеОбмена(тип: ПеречислениеСсылка.КС_НаправлениеОбмена) - экспорт или импорт
// Возвращаемое значение:
//		Булево 
Функция ПроверкаНаличияФорматаПоМаркеруОФКЭБ(Формат, ТипОбмена, ПолноеИмяФайла, НаправлениеОбмена = "", СообщениеОбОшибке = "", ИмяФайла)   

	//устанавливаем маркер
	Маркер    = ""; 
	
	НачальнаяПозиция     = 1; 
	СтрокаИдентификатора = ?(СтрДлина(ИмяФайла) > (НачальнаяПозиция + 36), Сред(ИмяФайла, НачальнаяПозиция, 36), "");
	
	Пока НЕ СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(СтрокаИдентификатора) И (НачальнаяПозиция <> 0) Цикл
		
		НачальнаяПозиция = СтрНайти(ИмяФайла, "_", , НачальнаяПозиция);   
		
		Если НачальнаяПозиция <> 0 Тогда
			 НачальнаяПозиция     = НачальнаяПозиция + 1; 
			 СтрокаИдентификатора = ?(СтрДлина(ИмяФайла) > (НачальнаяПозиция + 36), Сред(ИмяФайла, НачальнаяПозиция, 36), "");  
		КонецЕсли;	
		
	КонецЦикла;	 
	
	Если (НачальнаяПозиция <> 0) И СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(СтрокаИдентификатора) Тогда
		
		НачальнаяПозиция = СтрНайти(ИмяФайла, "_", , НачальнаяПозиция);   
		
		Если НачальнаяПозиция <> Неопределено Тогда
			 НачальнаяПозиция     = НачальнаяПозиция + 1;  
			 Маркер               = Сред(ИмяФайла, НачальнаяПозиция, СтрДлина(ИмяФайла) - НачальнаяПозиция - 3); 
        КонецЕсли;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(Маркер) Тогда 
		СообщениеОбОшибке = НСтр("ru = 'По имени файла не удалось определить маркер формата'");
		Возврат Ложь;
	КонецЕсли;
	
	Текст = Новый ЧтениеТекста(ПолноеИмяФайла);
	Стр   = Текст.ПрочитатьСтроку();
	Стр   = Сред(Стр, Найти(Нрег(Стр), "encoding")); //иначе найдет версию xml
	
	ПозВерсии   = макс(Найти(Врег(Стр), "VERSIONID="), Найти(Врег(Стр), "VERSION=")); //если вписан в одной строке с параметрами xml без перехода строки
	
	Пока (ПозВерсии = 0) И Стр <> Неопределено Цикл
		Стр   = Текст.ПрочитатьСтроку();
		ПозВерсии   =  макс(Найти(Врег(Стр), "VERSIONID="), Найти(Врег(Стр), "VERSION="));
		//для выписок и расчетных документов разные атрибуты для задаия версии
	КонецЦикла;
	
	Если ПозВерсии > 0 Тогда
		Если Сред(Врег(Стр), ПозВерсии + 7, 2) = "ID" Тогда 
			НомерВерсии = Сред(Стр, ПозВерсии + 11, ?(Сред(Стр, ПозВерсии + 14, 1) = """", 3, 4));
		Иначе
			НомерВерсии = Сред(Стр, ПозВерсии + 9,  ?(Сред(Стр, ПозВерсии + 12, 1) = """", 3, 4));
		КонецЕсли;
	КонецЕсли;
		
	Если ПозВерсии = 0 Тогда 
		СообщениеОбОшибке = НСтр("ru = 'В файле отсутсвует информация о версии обмена: атрибут version или versionID'");
		Возврат Ложь;
	КонецЕсли;
	
	Формат = ВернутьФорматПоМаркеру(Маркер + " " + НомерВерсии, ТипОбмена, НаправлениеОбмена);
	Если НЕ ЗначениеЗаполнено(Формат) Тогда
		СообщениеОбОшибке = НСтр("ru = 'Для импорта информации в системе отсутствует необходимый формат '") + Маркер + " " + НомерВерсии +  НСтр("ru = '.'");
		Возврат Ложь;
	КонецЕсли;
		
    Возврат Истина;
	
КонецФункции

// Проверяет наличие формата в ИБ, с помощью которого должен производиться обмен
//		ТипОбмена  (тип: СправочникСсылка.КС_ТипыФорматов)              - тип форматов обмена
//		ПолноеИмяФайла(тип: Строка)                                     - путь к файлу передачи
//		НаправлениеОбмена(тип: ПеречислениеСсылка.КС_НаправлениеОбмена) - экспорт или импорт
// Возвращаемое значение:
//		Булево 
Функция ФорматКлиентБанкДляОбработкиФайла(Формат, ТипОбмена, ПолноеИмяФайла, НаправлениеОбмена = "", СообщениеОбОшибке = "")
	
	Текст       = Новый ЧтениеТекста(ПолноеИмяФайла, ТипОбмена.КодировкаТекстаФайла);
	Стр         = Текст.ПрочитатьСтроку();
	НомерВерсии = "i_1.03";

	Если Стр <> "1CClientBankExchange" Тогда
		СообщениеОбОшибке = НСтр("ru = 'Формат файла не соотвествует требованиям обмена с системами клиента банка.");
		Возврат Ложь;
	КонецЕсли;
	
	Пока (НРег(Лев(Стр, 13)) <> "версияформата") И (Стр <> Неопределено) Цикл
		 Стр   = Текст.ПрочитатьСтроку();
	КонецЦикла;
	
	Если НРег(Лев(Стр, 13)) = "версияформата" Тогда	
		НомерВерсии = "i_" + Сред(СокрЛП(Стр), 15);	
	КонецЕсли;
	 
	
	// на данный момент формат импорта один - поэтому получаем его без доп. признаков
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ВидОбмена",         ТипОбмена);
	Запрос.УстановитьПараметр("НаправлениеОбмена", НаправлениеОбмена);
	Запрос.УстановитьПараметр("НомерВерсии",       НомерВерсии);
	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	Форматы.Наименование    КАК НаименованиеФормата,
	|	Форматы.Ссылка          КАК Формат
	|ИЗ
	|	Справочник.ФорматыОбменаБанкиКС    КАК Форматы
	|ГДЕ
	|	Форматы.Владелец.Ссылка            = &ВидОбмена
	|	И Форматы.НаправлениеОбмена.Ссылка = &НаправлениеОбмена
	|   И Форматы.Наименование             = &НомерВерсии
	|";
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		Формат = Результат.Формат;
		Возврат Истина;
	КонецЦикла;
	
	СообщениеОбОшибке = НСтр("ru = 'В системе отсутствуют форматы импорта для обмена с клиентом банка.'");
	Возврат Ложь;
	
КонецФункции

// Проверяет наличие формата в ИБ, с помощью которого должен производиться обмен по форматам УФЭБС
//		ПолноеИмяФайла(тип: Строка)                                     - путь к файлу передачи
//		ТипОбмена  (тип: СправочникСсылка.КС_ТипыФорматов)              - тип форматов обмена
// Возвращаемое значение:
//		Булево 
Функция ФорматУФЭБСДляОбработкиФайла(Формат, ПолноеИмяФайла, ТипОбмена, НаправлениеОбмена = Неопределено, СообщениеОбОшибке = "")   
	
	//устанавливаем маркер
	Маркер         = "";
	номерУзла      = 0;   
	
	ПостроительDOM = Новый ПостроительDOM;
	
	ЧтениеXML      = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ПолноеИмяФайла);  
	
	ДокументDOM             = ПостроительDOM.Прочитать(ЧтениеXML);  
	ЗакодированноеСообщение = ДокументDOM.ПолучитьЭлементыПоИмени("Object");
	
	Если ЗакодированноеСообщение.Количество() > 0 Тогда  
		
		СодержимоеСообщения = Base64Значение(ЗакодированноеСообщение[0].ТекстовоеСодержимое); 
		
		Если ЗначениеЗаполнено(СодержимоеСообщения) Тогда
		
			ВременныйФайл       = ПолучитьИмяВременногоФайла();
	        СодержимоеСообщения.Записать(ВременныйФайл);      
					
			Попытка
				КодировкаТекстаФайла	= КодировкаТекста[ТипОбмена.КодировкаТекстаФайла]
			Исключение
				КодировкаТекстаФайла    = ТипОбмена.КодировкаТекстаФайла;
			КонецПопытки;
			
			Чтение              = Новый ЧтениеТекста(ВременныйФайл, КодировкаТекстаФайла);
	        СодержимоеСообщения = Чтение.Прочитать();
			
			Если ЗначениеЗаполнено(СодержимоеСообщения) Тогда
				ЧтениеXML.УстановитьСтроку(СодержимоеСообщения);
			КонецЕсли;
			
			Чтение.Закрыть();
			УдалитьФайлы(ВременныйФайл);   
			
		КонецЕсли;	
		
	Иначе
		
		ЧтениеXML.Закрыть();
		ЧтениеXML.ОткрытьФайл(ПолноеИмяФайла); 
		
	КонецЕсли;  
	
	Маркеры = Новый Массив;
	
	Попытка
		Пока ЧтениеXML.Прочитать() Цикл
			
			Если (Найти(ЧтениеXML.Имя, "ED") > 0) 
				 И Маркеры.Найти(ЧтениеXML.ЛокальноеИмя + ?(номерУзла = 0, " (НОП)", " (МОП)")) = Неопределено  Тогда
				Маркеры.Добавить(ЧтениеXML.ЛокальноеИмя + ?(номерУзла = 0, " (НОП)", " (МОП)"));
			КонецЕсли;
			
			номерУзла = номерУзла + 1;
			
		КонецЦикла;
	Исключение
		// если выбран не XML файл
		СообщениеОбОшибке = НСтр("ru = 'Файл не является файлом импорта для обмена с банковскими системами по УФЭБС.'");
		ЧтениеXML.Закрыть();
		Возврат Ложь;
	КонецПопытки;
	
	Если Маркеры.Количество() = 0 Тогда
		СообщениеОбОшибке = НСтр("ru = 'Файл неверного формата.'");
		Возврат Ложь;
	КонецЕсли;
	
	Если НаправлениеОбмена = Неопределено Тогда
		НаправлениеОбмена = Перечисления.НаправлениеОбменаБанкиКС.Импорт;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ВидОбмена",          ТипОбмена);
	Запрос.УстановитьПараметр("НаправлениеОбмена",  НаправлениеОбмена); 
	Запрос.УстановитьПараметр("МассивНаименований", Маркеры);
	
	Запрос.Текст = "ВЫБРАТЬ 
				   |    МАКСИМУМ(Форматы.ДатаДействия) КАК ДатаДействия,
				   |    СОКРЛП(Форматы.Наименование) КАК Наименование
				   |ПОМЕСТИТЬ ФорматыАктуальные
	               |ИЗ
	               |	Справочник.ФорматыОбменаБанкиКС КАК Форматы
	               |ГДЕ
	               |	Форматы.Владелец.Ссылка = &ВидОбмена 
				   |    И (СОКРЛП(Форматы.Наименование) В (&МассивНаименований))
	               |	И Форматы.НаправлениеОбмена.Ссылка = &НаправлениеОбмена
				   |СГРУППИРОВАТЬ ПО
				   |    СОКРЛП(Форматы.Наименование);
				   |///////////////////////////////////////////////////
				   |ВЫБРАТЬ  
				   |   Форматы.Ссылка  КАК Формат
				   |ИЗ
	               |	Справочник.ФорматыОбменаБанкиКС КАК Форматы  
				   |    ПРАВОЕ СОЕДИНЕНИЕ ФорматыАктуальные
				   |    ПО  Форматы.ДатаДействия = ФорматыАктуальные.ДатаДействия
				   |    И СОКРЛП(Форматы.Наименование) = ФорматыАктуальные.Наименование
				   |ГДЕ
	               |	Форматы.Владелец.Ссылка = &ВидОбмена 
				   |    И (СОКРЛП(Форматы.Наименование) В (&МассивНаименований))
	               |	И Форматы.НаправлениеОбмена.Ссылка = &НаправлениеОбмена
				   |    ";
	
	Результат = Запрос.ВыполнитьПакет();
	Формат = Результат[1].Выгрузить().ВыгрузитьКолонку("Формат");
	
	Если Формат.Количество()>0 Тогда 		
		Возврат Истина;
	КонецЕсли;
	
	Для каждого Маркер Из Маркеры Цикл
		СообщениеОбОшибке = НСтр("ru = 'В системе отсутсвует формат '") + Маркер +  НСтр("ru = '.'");    
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

//  Находит искомый формат по заданному маркеру
//		Маркер(тип: Строка)                                             - маркер искомого формата
//		ТипОбмена  (тип: СправочникСсылка.КС_ТипыФорматов)              - тип форматов обмена
//		НаправлениеОбмена(тип: ПеречислениеСсылка.КС_НаправлениеОбмена) - экспорт или импорт
//  Возвращаемое значение:
//		Формат (тип: СправочникСсылка.ФорматыОбменаБанкиКС)             - найденный формат по заданному маркеру
Функция ВернутьФорматПоМаркеру(Маркер, ТипОбмена, НаправлениеОбмена) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ТипФормата",        ТипОбмена);
	Запрос.УстановитьПараметр("НаправлениеОбмена", НаправлениеОбмена);
	Запрос.УстановитьПараметр("Маркер",            Маркер);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	КС_Форматы.Ссылка КАК Формат
	               |ИЗ
	               |	Справочник.ФорматыОбменаБанкиКС КАК КС_Форматы
	               |ГДЕ
	               |	КС_Форматы.Владелец.Ссылка     = &ТипФормата
	               |	И КС_Форматы.НаправлениеОбмена = &НаправлениеОбмена
	               |	И КС_Форматы.Наименование ПОДОБНО &Маркер";
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Возврат Результат.Формат;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// Возвращает ссылку на формат обмена с системой ПУД ЭБ заданной версии (версия в тексте файла)
//		ТипОбмена  (тип: СправочникСсылка.КС_ТипыФорматов)              - тип форматов обмена
//		ПолноеИмяФайла(тип: Строка)                                     - путь к файлу передачи 
//      ИмяФайла(тип: Строка)                                           - имя файла передачи
//		НаправлениеОбмена(тип: ПеречислениеСсылка.КС_НаправлениеОбмена) - экспорт или импорт
//      СообщениеОбОшибке (тип: Строка)                                 - текст сообщения об ошибке 
// Возвращаемое значение:
//		Булево 
Функция ПроверкаНаличияФорматаПоМаркеруПУД(Формат, ТипОбмена, ПолноеИмяФайла, ИмяФайла, НаправлениеОбмена = "", СообщениеОбОшибке = "")  
	
	//устанавливаем маркер
	Маркер    = "";
	
	Текст = Новый ЧтениеТекста(ПолноеИмяФайла);
	Стр   = Текст.Прочитать();
	
	ПозВерсии   = Найти(НРег(Стр), "versionid=");
	
	Если ПозВерсии > 0 Тогда
		НомерВерсии = Сред(Стр, ПозВерсии + 11, ?(Сред(Стр, ПозВерсии + 14, 1) = """", 3, 4));
	КонецЕсли;
		
	Если ПозВерсии = 0 Тогда 
		СообщениеОбОшибке = НСтр("ru = 'В файле отсутсвует информация о версии обмена: атрибут VersionID корневого элемента'");
		Возврат Ложь;
	КонецЕсли; 
	
	ПозРазделителя = СтрНайти(ИмяФайла, "_"); 
	ПозРасширения  = СтрНайти(НРег(ИмяФайла), ".xml");
	
	Если (СтрНайти(ВРег(ИмяФайла), ".AB") > 0) ИЛИ (СтрНайти(ВРег(ИмяФайла), ".AC") > 0) Тогда
		Маркер = Сред(ИмяФайла, 17, 2);  
	ИначеЕсли (ПозРазделителя > 0) ИЛИ (ПозРасширения > 0) Тогда 
		Маркер = Сред(ИмяФайла, ПозРазделителя + 1, ПозРасширения - ПозРазделителя - 1);
	КонецЕсли;
	
	Формат = ВернутьФорматПоМаркеру(Маркер + " " + НомерВерсии, ТипОбмена, НаправлениеОбмена);
	Если НЕ ЗначениеЗаполнено(Формат) Тогда
		СообщениеОбОшибке = НСтр("ru = 'Для импорта информации в системе отсутствует необходимый формат '") + Маркер + " "  + НомерВерсии +  НСтр("ru = '.'");
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Возвращает ссылку на формат обмена с системой АЦК-финансы заданной версии (версия в тексте файла)
//		ТипОбмена  (тип: СправочникСсылка.КС_ТипыФорматов)              - тип форматов обмена
//		ПолноеИмяФайла(тип: Строка)                                     - путь к файлу передачи
//		НаправлениеОбмена(тип: ПеречислениеСсылка.КС_НаправлениеОбмена) - экспорт или импорт
//      СообщениеОбОшибке (тип: Строка)                                 - текст сообщения об ошибке 
// Возвращаемое значение:
//		Булево 
Функция ФорматАЦКДляОбработкиФайла(Формат, ТипОбмена, ПолноеИмяФайла, НаправлениеОбмена = "", СообщениеОбОшибке = "")  
	
	//устанавливаем маркер
	Маркер    = "";
	
	Текст = Новый ЧтениеТекста(ПолноеИмяФайла);
	Стр   = Текст.Прочитать();
	
	ПозВерсии   = ?(Найти(Стр, "WTFORMAT VERSION=") > 0, Найти(Стр, "WTFORMAT VERSION="), Найти(Стр, "DOCUMENTCLASS_ID="));
	
	Если ПозВерсии > 0 Тогда
		НомерВерсии = Сред(Стр, ПозВерсии + 18, ?(Сред(Стр, ПозВерсии + 21, 1) = """", 3, 4));
	КонецЕсли;
		
	Если ПозВерсии = 0 Тогда 
		СообщениеОбОшибке = НСтр("ru = 'В файле отсутсвует информация о версии обмена: атрибут VERSION элемента WTFORMAT.'");
		Возврат Ложь;
	КонецЕсли;
	
	Если Найти(Стр, "DOCAZKREQUEST")> 0 Тогда
		
		Если Найти(Стр, "CHECKPAY=""1""") > 0 Тогда
			Формат = ВернутьФорматПоМаркеру("ЗН " + НомерВерсии, ТипОбмена, НаправлениеОбмена);
			Если НЕ ЗначениеЗаполнено(Формат) Тогда
				СообщениеОбОшибке = НСтр("ru = 'Для импорта информации в системе отсутствует необходимый формат ЗН '") + НомерВерсии +  НСтр("ru = '.'");
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
		
		Если Найти(Стр, "CHECKPAY=""0""") > 0 Тогда
			Формат = ВернутьФорматПоМаркеру("ЗКР " + НомерВерсии, ТипОбмена, НаправлениеОбмена);
			Если НЕ ЗначениеЗаполнено(Формат) Тогда
				СообщениеОбОшибке = НСтр("ru = 'Для импорта информации в системе отсутствует необходимый формат ЗКР '") + НомерВерсии +  НСтр("ru = '.'");
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
		
		Возврат Истина;
		
	ИначеЕсли Найти(Стр, "STATEMENTSDOCS")> 0 Тогда
		
		Формат = ВернутьФорматПоМаркеру("ВЫП " + НомерВерсии, ТипОбмена, НаправлениеОбмена);
		Если НЕ ЗначениеЗаполнено(Формат) Тогда
			СообщениеОбОшибке = НСтр("ru = 'Для импорта информации в системе отсутствует необходимый формат ВЫП '") + НомерВерсии +  НСтр("ru = '.'");
			Возврат Ложь;
		КонецЕсли;
		
		Возврат Истина;
		
	ИначеЕсли Найти(Стр, "STATEMENTLIST")> 0 Тогда
		
		Формат = ВернутьФорматПоМаркеру("ВЫП " + НомерВерсии, ТипОбмена, НаправлениеОбмена);
		Если НЕ ЗначениеЗаполнено(Формат) Тогда
			СообщениеОбОшибке = НСтр("ru = 'Для импорта информации в системе отсутствует необходимый формат ВЫП '") + НомерВерсии +  НСтр("ru = '.'");
			Возврат Ложь;
		КонецЕсли;
		
		Возврат Истина;
		
	ИначеЕсли 	Найти(Стр, "DOCAZKAUBUCASHREQUEST")> 0 Тогда
		Формат = ВернутьФорматПоМаркеру("ЗКРАУ " + НомерВерсии, ТипОбмена, НаправлениеОбмена);
		Если НЕ ЗначениеЗаполнено(Формат) Тогда
			СообщениеОбОшибке = НСтр("ru = 'Для импорта информации в системе отсутствует необходимый формат ЗКРАУ '") + НомерВерсии +  НСтр("ru = '.'");
			Возврат Ложь;
		КонецЕсли;
		
		Возврат Истина;
		
	Иначе
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

// Возвращает ссылку на формат обмена Платежного поручения на общую сумму с реестром заданной версии (версия в тексте файла)
//		ТипОбмена  (тип: СправочникСсылка.КС_ТипыФорматов)              - тип форматов обмена
//		ПолноеИмяФайла(тип: Строка)                                     - путь к файлу передачи
//		НаправлениеОбмена(тип: ПеречислениеСсылка.КС_НаправлениеОбмена) - экспорт или импорт
//      СообщениеОбОшибке (тип: Строка)                                 - текст сообщения об ошибке 
// Возвращаемое значение:
//		Булево 
Функция ФорматРеестраППДляОбработкиФайла(Формат, ТипОбмена, ПолноеИмяФайла, НаправлениеОбмена = "", СообщениеОбОшибке = "")
	
	Текст = Новый ЧтениеТекста(ПолноеИмяФайла);
	Стр   = Текст.Прочитать();
	
	ПозВидаДок   = Найти(Стр, "<DocTypeCode>RPP</DocTypeCode>");
	
	Если ПозВидаДок = 0 Тогда
		СообщениеОбОшибке = НСтр("ru = 'В файле не указан обрабатываемый вид документа RPP - Платежное поручение на общую сумму с реестром.'");
		Возврат Ложь;
	КонецЕсли;	
	
	ПозВерсии   = Найти(Стр, "versionID=");
	
	Если ПозВерсии > 0 Тогда
		НомерВерсии = Сред(Стр, ПозВерсии + 11, 3);
	Иначе
		СообщениеОбОшибке = НСтр("ru = 'В файле отсутсвует информация о версии обмена: атрибут versionID элемента ProcessRegPayOrder .'");
		Возврат Ложь;
	КонецЕсли;	
	
	Формат = ВернутьФорматПоМаркеру(НомерВерсии, ТипОбмена, НаправлениеОбмена);
	Если НЕ ЗначениеЗаполнено(Формат) Тогда
		СообщениеОбОшибке = НСтр("ru = 'Для импорта информации в системе отсутствует необходимый формат '") + НомерВерсии +  НСтр("ru = '.'");
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции     

// Возвращает ссылку на формат импорта для обменов "Обмен с электронным бюджетом" (версия в тексте файла)
//		ТипОбмена  (тип: СправочникСсылка.КС_ТипыФорматов)              - тип форматов обмена
//		ПолноеИмяФайла(тип: Строка)                                     - путь к файлу передачи
//		НаправлениеОбмена(тип: ПеречислениеСсылка.КС_НаправлениеОбмена) - экспорт или импорт
//      СообщениеОбОшибке (тип: Строка)                                 - текст сообщения об ошибке 
// Возвращаемое значение:
//		Булево 
Функция ФорматИмпортаОбменаЭБ(Формат, ТипОбмена, ПолноеИмяФайла, НаправлениеОбмена = "", СообщениеОбОшибке = "") 
	
	Текст = Новый ЧтениеТекста(ПолноеИмяФайла);
	Стр   = Текст.Прочитать();
	
	ПозВидаДок   = Найти(Стр, "<documentType>Inf_OrderMir</documentType>");
	
	Если ПозВидаДок = 0 Тогда
		СообщениеОбОшибке = НСтр("ru = 'В файле не указан обрабатываемый вид документа Inf_OrderMir - Извещение об исполнении распоряжения о перечислении денежных средств на банковские карты «Мир» физических лиц.'");
		Возврат Ложь;
	КонецЕсли;	
	
	ПозВерсии   = Найти(Стр, "versionID=");
	
	Если ПозВерсии > 0 Тогда
		НомерВерсии = Сред(Стр, ПозВерсии + 11, 3);
	Иначе
		СообщениеОбОшибке = НСтр("ru = 'В файле отсутсвует информация о версии обмена: атрибут versionID элемента formular.'");
		Возврат Ложь;
	КонецЕсли;	
	
	Формат = ВернутьФорматПоМаркеру("IM_" + НомерВерсии, ТипОбмена, НаправлениеОбмена);
	Если НЕ ЗначениеЗаполнено(Формат) Тогда
		СообщениеОбОшибке = НСтр("ru = 'Для импорта информации в системе отсутствует необходимый формат '") + НомерВерсии +  НСтр("ru = '.'");
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;
	 
КонецФункции	

Функция ФорматРФИДляОбработкиФайла(Формат, ТипОбмена, ПолноеИмяФайла, НаправлениеОбмена = "", СообщениеОбОшибке = "") Экспорт
	
	Возврат Ложь;
	
КонецФункции
//возвращает ссылку на формат импорта для Обмена с ЭБ НУБП
Функция ФорматИмпортаЭБНУБПДляОбработкиФайла(Формат, ТипОбмена, ПолноеИмяФайла, НаправлениеОбмена = "", СообщениеОбОшибке = "") 
	
	//устанавливаем маркер
	Маркер      = "";
	
	Текст       = Новый ЧтениеТекста(ПолноеИмяФайла);
	Стр         = Текст.Прочитать();
	
	ПозМаркера  = Найти(Врег(Стр), "TSE_");
	
	Если ПозМаркера = 0 Тогда 
		СообщениеОбОшибке = НСтр("ru = 'В файле отсутсвует информация о системном имени документа'");
		Возврат Ложь;
	КонецЕсли;

	Маркер      = Сред(Стр, ПозМаркера, 21);
	Стр         = Сред(Стр, ПозМаркера); //обрезаем строку, так как иначе будет искать версию xml
	
	ПозВерсии   = Найти(Врег(Стр), "VERSION=");
	
	Если ПозВерсии > 0 Тогда
		НомерВерсии = Сред(Стр, ПозВерсии + 9, ?(Сред(Стр, ПозВерсии + 12, 1) = """", 3, 4));
	КонецЕсли;
		
	Если ПозВерсии = 0 Тогда 
		СообщениеОбОшибке = НСтр("ru = 'В файле отсутсвует информация о версии обмена: атрибут VERSION'");
		Возврат Ложь;
	КонецЕсли;
	
	Формат = ВернутьФорматПоМаркеру(Маркер + " (" + НомерВерсии + ")", ТипОбмена, НаправлениеОбмена);
	Если НЕ ЗначениеЗаполнено(Формат) Тогда
		СообщениеОбОшибке = НСтр("ru = 'Для импорта информации в системе отсутствует необходимый формат '") + Маркер + " (" + НомерВерсии + ")" +  НСтр("ru = '.'");
		Возврат Ложь;
	КонецЕсли;
		
    Возврат Истина;
	
КонецФункции

//Пытается определить подходящий формат для импортирования информации из указанного файла
//		ТипОбмена  (тип: СправочникСсылка.КС_ТипыФорматов)              - тип форматов обмена
//		ПолноеИмяФайла(тип: Строка)                                     - путь к файлу передачи
//		НаправлениеОбмена(тип: ПеречислениеСсылка.КС_НаправлениеОбмена) - экспорт или импорт
//      СообщениеОбОшибке (тип: Строка)                                 - текст сообщения об ошибке 
// Возвращаемое значение:
//		Булево 
Функция ВСистемеЕстьФорматДляИмпортируемогоФайла(Формат, ТипОбмена, ПолноеИмяФайла, СообщениеОбОшибке = "", НаправлениеОбмена = Неопределено, ИмяФайла = "") Экспорт
	
	Если НЕ ЗначениеЗаполнено(НаправлениеОбмена) Тогда
		НаправлениеОбмена = Перечисления.НаправлениеОбменаБанкиКС.Импорт;
	КонецЕсли;
	
	// сначала пытаемся найти формат согласно его типу обмена (по признаку "Представление в номере" типа обмена)
	Если      ТипОбмена.ПредставлениеВНомереВерсии = "TX"  Тогда // Обмен с ОФК/УФК
		Возврат ПроверкаНаличияФорматаПоМаркеруОФК(Формат, ТипОбмена, ПолноеИмяФайла, НаправлениеОбмена, СообщениеОбОшибке);
	ИначеЕсли ТипОбмена.ПредставлениеВНомереВерсии = "TXL" Тогда // Обмен с ОФК/УФК в Электронном бюджете
		Возврат ПроверкаНаличияФорматаПоМаркеруОФКЭБ(Формат, ТипОбмена, ПолноеИмяФайла, НаправлениеОбмена, СообщениеОбОшибке, ИмяФайла);
	ИначеЕсли ТипОбмена.ПредставлениеВНомереВерсии = "RMS" Тогда // Обмен с ПУД ЭБ
		Возврат ПроверкаНаличияФорматаПоМаркеруПУД(Формат, ТипОбмена, ПолноеИмяФайла, ИмяФайла, НаправлениеОбмена, СообщениеОбОшибке);
	ИначеЕсли ТипОбмена.ПредставлениеВНомереВерсии = "NBP" Тогда // Обмен с Электронным бюджетом НУБП
		Возврат ФорматИмпортаЭБНУБПДляОбработкиФайла(Формат, ТипОбмена, ПолноеИмяФайла, НаправлениеОбмена, СообщениеОбОшибке);
	ИначеЕсли ТипОбмена.ПредставлениеВНомереВерсии = "KB"  Тогда // Обмен с клиентом банка
		Возврат ФорматКлиентБанкДляОбработкиФайла(Формат, ТипОбмена, ПолноеИмяФайла, НаправлениеОбмена, СообщениеОбОшибке);
	ИначеЕсли ТипОбмена.ПредставлениеВНомереВерсии = "UFBS" Тогда // Обмен с системами по УФЭБС
	    Возврат ФорматУФЭБСДляОбработкиФайла(Формат, ПолноеИмяФайла, ТипОбмена, НаправлениеОбмена, СообщениеОбОшибке);
	ИначеЕсли ТипОбмена.ПредставлениеВНомереВерсии = "MS"   Тогда // Обмен с УФК г. Москвы	
		СообщениеОбОшибке = НСтр("ru = 'Форматы импорта для данного типа обмена отсутствуют.'");
		Возврат Ложь;
	ИначеЕсли ТипОбмена.ПредставлениеВНомереВерсии = "UNFO" Тогда // Обмен УНИФО
		Возврат ФорматПоТипуДокумента_УНИФО(Формат, ТипОбмена, "01", СообщениеОбОшибке);
	ИначеЕсли ТипОбмена.ПредставлениеВНомереВерсии = "AZK"  Тогда // Обмен c АЦК-системами	
		Возврат ФорматАЦКДляОбработкиФайла(Формат, ТипОбмена, ПолноеИмяФайла, НаправлениеОбмена, СообщениеОбОшибке);
	ИначеЕсли ТипОбмена.ПредставлениеВНомереВерсии = "RPP"  Тогда // Обмен с ОФК (ПП с реестром)	
		Возврат ФорматРеестраППДляОбработкиФайла(Формат, ТипОбмена, ПолноеИмяФайла, НаправлениеОбмена, СообщениеОбОшибке);
	ИначеЕсли ТипОбмена.ПредставлениеВНомереВерсии = "EB"  Тогда // Обмен с электронным бюджетом	
		Возврат ФорматИмпортаОбменаЭБ(Формат, ТипОбмена, ПолноеИмяФайла, НаправлениеОбмена, СообщениеОбОшибке);			
	ИначеЕсли ТипОбмена.ПредставлениеВНомереВерсии = "RFI"  Тогда // Обмен c реестром федерального имущества	
		Возврат ФорматРФИДляОбработкиФайла(Формат, ТипОбмена, ПолноеИмяФайла, НаправлениеОбмена, СообщениеОбОшибке);		
	Иначе // не можем однозначно определить тип формата (старые комплекты поставок), поэтому ищем всеми возможными способами	
		Возврат ПроверкаНаличияФорматаПоМаркеруОФК(Формат, ТипОбмена, ПолноеИмяФайла, НаправлениеОбмена)
		    ИЛИ ФорматКлиентБанкДляОбработкиФайла(Формат, ТипОбмена, ПолноеИмяФайла, НаправлениеОбмена)
		    ИЛИ ФорматУФЭБСДляОбработкиФайла(Формат, ПолноеИмяФайла, ТипОбмена, НаправлениеОбмена)
			ИЛИ ФорматПоТипуДокумента_УНИФО(Формат, ТипОбмена, "01")
			ИЛИ ФорматАЦКДляОбработкиФайла(Формат, ТипОбмена, ПолноеИмяФайла, НаправлениеОбмена)
	КонецЕсли;	
		
КонецФункции

// Возвращает номер п/п файла передачи за дату передачи
//
// Параметры:
// 		Организация (Тип: СправочникСсылка.Организации) - учреждение, по которому формируется задание;
// 		ДатаВыгрузки (Тип: Дата)                       - дата формирования задания
// 		ТекФормат(Тип: СправочникСсылка.КС_Форматы)    - выгружаемый формат
// 		ТабЧасть                                       - ссылка на табличную часть задания
// Возвращаемое значение:
// 		Тип: Число - номер по порядку формируемого файла передачи за текущую дату
Функция НомерФайлаЗаДату(Организация, ДатаВыгрузки, ТекФормат, Задание,ТабЧасть = Неопределено)     ЭКСПОРТ
	
	ПоФорматам = Ложь;
	Номер      = 0;
	
	//вызов функции был не из Задания на экспорт
	Если НЕ ЗначениеЗаполнено(Задание) Тогда 
		Возврат "1";
	КонецЕсли;	
		
	Если ТекФормат.ФорматВОтдельномФайле Тогда
		ПоФорматам = Истина;
	КонецЕсли;
	
	Если ТипЗнч(ТабЧасть) = Тип("РезультатЗапроса") Тогда
		ТабЧасть = ТабЧасть.Выгрузить();
	Иначе
		ТабЧасть = ТабЧасть.Скопировать(); 
	КонецЕсли;
	
	ТабЧасть.Сортировать("Формат, Объект");
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Организация",    Организация);
	Запрос.УстановитьПараметр("ВидОбмена",      ТекФормат.Владелец);
	Запрос.УстановитьПараметр("ФорматИмя",      ТекФормат.Наименование);
	Запрос.УстановитьПараметр("НачОперДня",     НачалоДня(ДатаВыгрузки));
	Запрос.УстановитьПараметр("КонОперДня",     КонецДня(ДатаВыгрузки));
	Запрос.УстановитьПараметр("Ссылка",    		Задание);
	
	Если ПоФорматам Тогда  
		
		Если ТекФормат.ОбъектВОдномФайле = 0 Тогда   //каждый объект в отдельном файле
	
			Запрос.Текст = "
			
			|ВЫБРАТЬ 
			|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ТЧ.Объект)							    КАК КоличествоПозиций
			|ИЗ
			|	Документ.ЗаданиеНаЭкспортДанныхВБанкиКС.ОбъектыОбмена		КАК ТЧ
			|ГДЕ
			|	(ТЧ.Ссылка <> &Ссылка) И (ТЧ.Ссылка.Дата <= &КонОперДня) И (ТЧ.Ссылка.Дата >= &НачОперДня) И
			|	(ТЧ.Ссылка.Организация = &Организация) И (ТЧ.Формат.Наименование = &ФорматИмя) 
			|   И (ТЧ.Ссылка.ПометкаУдаления = Ложь)
			|";
			
		Иначе
			//все объекты формата в одном файле   
			Запрос.Текст = "     
				
			|ВЫБРАТЬ 
			|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ТЧ.Ссылка)							    КАК КоличествоПозиций   
			|ИЗ
			|	Документ.ЗаданиеНаЭкспортДанныхВБанкиКС.ОбъектыОбмена		КАК ТЧ
			|ГДЕ
			|	(ТЧ.Ссылка <> &Ссылка) И (ТЧ.Ссылка.Дата <= &КонОперДня) И (ТЧ.Ссылка.Дата >= &НачОперДня) И
			|	(ТЧ.Ссылка.Организация = &Организация) И (ТЧ.Формат.Наименование = &ФорматИмя)   
			|   И (ТЧ.Ссылка.ПометкаУдаления = Ложь)
			|";
			
		КонецЕсли;
			
	Иначе
		
		Запрос.Текст = "
		
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(Док.Ссылка)						КАК КоличествоПозиций
		|ИЗ
		|	Документ.ЗаданиеНаЭкспортДанныхВБанкиКС 	КАК Док
		|ГДЕ
		|	(ТЧ.Ссылка <> &Ссылка) И (Док.Дата <= &КонОперДня) И (Док.Дата >= &НачОперДня) И
		|	(Док.Организация = &Организация) И (Док.ВидОбмена = &ВидОбмена) 
		|   И (ТЧ.Ссылка.ПометкаУдаления = Ложь)
		|";

		
	КонецЕсли;
	
	РезультатыЗапроса = Запрос.Выполнить().Выбрать();
	РезультатыЗапроса.Следующий();
	
	Если ЗначениеЗаполнено(РезультатыЗапроса) Тогда
		Номер = Число(РезультатыЗапроса.КоличествоПозиций);
	КонецЕсли;
	
	КолВоДопПозций = 1;
	СписокФорматов = Новый Соответствие;
	//ТекФормат.ОдинОбъектВОдномФайле
	Если ПоФорматам И ЗначениеЗаполнено(ТабЧасть)Тогда
		
		Если ТекФормат.ОбъектВОдномФайле = 0 Тогда
			Для Каждого Строка Из ТабЧасть Цикл
				
				Если (Строка.Формат = ТекФормат) И ЗначениеЗаполнено(Строка.ИмяФайлаВыгрузки) Тогда
					КолВоДопПозций  = КолВоДопПозций + 1;
				КонецЕсли;
				
			КонецЦикла;
		ИначеЕсли ТекФормат.ОбъектВОдномФайле = 1 Тогда
			Для Каждого Строка Из ТабЧасть Цикл
				
				Если (Строка.Формат.Наименование = ТекФормат.Наименование) И ЗначениеЗаполнено(Строка.ИмяФайлаВыгрузки) Тогда
					Если (Строка.Формат <> ТекФормат) Тогда
						КолВоДопПозций  = КолВоДопПозций + 1;
					КонецЕсли;				  
					Если СписокФорматов.Получить(ТекФормат) = Неопределено Тогда
						СписокФорматов.Вставить(ТекФормат, КолВоДопПозций);
					Иначе
						КолВоДопПозций = СписокФорматов.Получить(ТекФормат);
					КонецЕсли;
				КонецЕсли;
				
			КонецЦикла;				
        КонецЕсли;
		
	КонецЕсли;
	
	Номер = Номер + КолВоДопПозций;
	
	Возврат Номер;
	
КонецФункции

Функция НовыйУникальныйИдентификатор(ПеременнаяОбмена = "0")     ЭКСПОРТ
	
	УИ =   Новый УникальныйИдентификатор;
	
	Если НЕ(ПеременнаяОбмена = "0") Тогда
		ПоместитьВоВременноеХранилище(УИ, БиблиотекаФункцийОбменаПовтИсп.ПолучитьОбъектВоВременномХранилище());
	КонецЕсли;
	
	Возврат УИ;
	
КонецФункции

Функция ПолучитьПеременнуюОбмена()  ЭКСПОРТ
	
	Возврат ПолучитьИзВременногоХранилища(БиблиотекаФункцийОбменаПовтИсп.ПолучитьОбъектВоВременномХранилище());
	
КонецФункции

Функция ПолучитьGUIDСтрокой() ЭКСПОРТ
	Возврат Строка(Новый УникальныйИдентификатор);	
КонецФункции 

// Возвращает символ передаваемого вида КБК
//
// Параметры:
// 		ВидБК(Тип: ПеречислениеСсылка.ВидыКБК) - вид КБК, для которого нужно вернуть символ
// Возвращаемое значение:
// 		Тип: Число - Символ, соответствующий заданному виду КБК
Функция СимволВидаКБК(ВидКБК, КодБК = "")     ЭКСПОРТ
	
	Если ТипЗнч(ВидКБК) = Тип("СправочникСсылка.КлассификационныеПризнакиСчетов") Тогда	
		ВидКБК = ВидКБК.ВидПоказателя;	
	КонецЕсли;
	
	Если ВидКБК = Перечисления.ВидыКБК.КРБ Тогда
		Возврат "10";
	ИначеЕсли ВидКБК = Перечисления.ВидыКБК.КДБ Тогда
		Возврат "20";
	ИначеЕсли ВидКБК = Перечисления.ВидыКБК.КИФ Тогда
		Если Лев(КодБК, 2) = "02" Тогда
			Возврат "32";
	    Иначе
			Возврат "31";
		КонецЕсли;	
	КонецЕсли;

	Возврат "";
	
КонецФункции

// Возвращает значение запрашиваемого параметра (ИмяПараметра) у элемента (ссылка на объект)
// справочника "Сотрудники" (Сотрудник) на указанную дату (ДатаЗапроса)
//
// Параметры:
// 		Сотрудник (Тип: СправочникСсылка.Сотрудники) - ссылка на сотрудника, по которому необходимо
//		получить информацию;
// 		ДатаЗапроса (Тип: Дата) - дата, на которую необходимо получить данные;
// 		ИмяПараметра (Тип: Строка) - Имя реквизита, который необходимо получить
// Возвращаемое значение:
// 		Тип: Произвольный - значение заданного реквизита
Функция ДанныеСотрудника(Сотрудник, Дата, ИмяПараметра)     ЭКСПОРТ
	
	СтруктураПараметров = ПлатежноРасчетныеДокументыПовтИсп.ПолучитьДанныеСотрудника(Сотрудник, Дата);
	
	Возврат СтруктураПараметров[ИмяПараметра];
	
КонецФункции

// Возвращает значение запрашиваемого параметра (ИмяПараметра) у элемента (ссылка на объект)
// справочника "Сотрудники" (Сотрудник) на указанную дату (ДатаЗапроса)
//
// Параметры:
// 		Сотрудник (Тип: СправочникСсылка.Сотрудники) - ссылка на сотрудника, по которому необходимо
//		получить информацию;
// 		ДатаЗапроса (Тип: Дата) - дата, на которую необходимо получить данные;
// 		ИмяПараметра (Тип: Строка) - Имя реквизита, который необходимо получить
// Возвращаемое значение:
// 		Тип: Произвольный - значение заданного реквизита
Функция ДанныеУЛСотрудника(Сотрудник, Дата, ИмяПараметра)     ЭКСПОРТ
	
	СтруктураПараметров = ПлатежноРасчетныеДокументыПовтИсп.ПолучитьДанныеСотрудника(Сотрудник, Дата);
	
	Если ИмяПараметра = "СерияНомер" Тогда
		Результат = СокрЛП(СтруктураПараметров.Серия) + " " + СокрЛП(СтруктураПараметров.Номер);
	Иначе
		Результат = СтруктураПараметров[ИмяПараметра];
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Возвращает значение кассового символа для Заявки на наличные
// Параметры:
//      ЗаявкаСсылка(Тип: Документссылка.ЗаявканаНаличные) - ссылка на документ, кассовый символ которого необходимо получить
// Возвращаемое значение:
//      Тип: Строка - значение кассового символа  
Функция ПолучитьКассовыйСимвол(ЗаявкаСсылка)  Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ЗаявкаСсылка);
	
	Запрос.Текст = "
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗаявкаНаНаличныеКассовыеСимволы.КассовыйСимвол.Код     КАК КассовыйСимвол
	|ИЗ
	|	Документ.ЗаявкаНаНаличные.КассовыеСимволы КАК ЗаявкаНаНаличныеКассовыеСимволы
	|ГДЕ
	|	ЗаявкаНаНаличныеКассовыеСимволы.Ссылка = &Ссылка
	|";
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		 Возврат Результат.КассовыйСимвол;
	Иначе
		 Возврат "";
	КонецЕсли;
	
КонецФункции

// Возвращает символ вида платежа по строковому представлению вида платежа (ВидПлатежа)
//
// Параметры:
// 		ВидПлатежа (Тип: Строка) - значение вида платежа, заданное строкой
// Возвращаемое значение:
// 		Тип: Число - числовое представление вида платежа
Функция СимволВидаПлатежа(ВидПлатежа)     ЭКСПОРТ
	
	Если СокрЛП(Нрег(ВидПлатежа))      = "почтой" Тогда
		Возврат 1
	ИначеЕсли СокрЛП(Нрег(ВидПлатежа)) = "телеграфом" Тогда
		Возврат 2
	ИначеЕсли СокрЛП(Нрег(ВидПлатежа)) = "электронно" Тогда
		Возврат 3
	ИначеЕсли СокрЛП(Нрег(ВидПлатежа)) = "срочно" Тогда
		Возврат 4
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

// Исправлено РСКП
// Возвращает вида платежа строкой по числовому представлению вида платежа (ВидПлатежа)
//
// Параметры:
// 		ВидПлатежа (Тип: Строка) - значение вида платежа, заданное числом
// Возвращаемое значение:
// 		Тип: Строка - строковое представление вида платежа
Функция СтрокаВидаПлатежа(ВидПлатежа) Экспорт  
	
	Если СокрЛП(Строка(ВидПлатежа)) = "1" Тогда 
		Возврат "Почтой";   
	ИначеЕсли СокрЛП(Строка(ВидПлатежа)) = "2" Тогда 
		Возврат "Телеграфом"; 
	ИначеЕсли СокрЛП(Строка(ВидПлатежа)) = "3" Тогда 
		Возврат "Электронно";	
	ИначеЕсли СокрЛП(Строка(ВидПлатежа)) = "4" Тогда 
		Возврат "Срочно";	
	КонецЕсли;
	
	Возврат "";
	
КонецФункции    

// Возвращает представление (маркер) типа документа
// документ - передаваемый параметр
//
// Параметры:
// 		Док (Тип: ДокументСсылка) - документ, вид которого необходимо определить
// Возвращаемое значение:
// 		Тип: Строка - маркер (строковое представление) заданного документа
//
// Форматы альбома 32.0:
//ZN - Заявка на получение денежных средств, перечисляемых на карту;
//ZR - Заявка на кассовый расход;
//ZK - Сводная заявка на кассовый расход (для уплаты налогов);
//ZV - Заявка на возврат;
//ZS - Заявка на получение наличных денег;
//ZZ - Консолидированная заявка;
//PP - Платежное поручение;
//RN - Расшифровка сумм неиспользованных (внесен-ных через банкомат или пункт выдачи наличных денежных средств) средств;
//DM - Распоряжение о пере-числении денежных средств на банковские кар-ты «Мир» физических лиц;
//ZP - Заявка для обеспече-ния наличными денежными средствами;
//OC - Объявление на взнос наличных денег;
//UF - Уведомление об уточ-нении вида и принадлежно-сти платежа;
//UK - Уведомление об уточ-нении операций клиента;
//UN - Уведомление об уточ-нении вида и принадлежно-сти платежа, решениях о зачете излишне уплаченных (взысканных) сумм налогов и сборов, пеней, штрафов, а также подлежащих возме-щению сумм налогов и сбо-ров;
//UM - Уведомление о регио-нальном зачете излишне уплаченных (взысканных) сумм налогов и сборов, страховых взносов, пеней, штрафов по ним.
//
Функция ТипДокумента(Док)     ЭКСПОРТ
	
	Рез = "";
	
	Если (ТипЗнч(Док) = Тип("ДокументСсылка.ЗаявкаНаКассовыйРасход")) 
		ИЛИ (ТипЗнч(Док) = Тип("ДокументСсылка.ЗаявкаНаКассовыйРасходСокращенная")) Тогда
		Рез = "ZR";
	ИначеЕсли ТипЗнч(Док) = Тип("ДокументСсылка.ЗаявкаНаНаличные") Тогда
		Рез = "ZS";
	ИначеЕсли ТипЗнч(Док) = Тип("ДокументСсылка.ЗаявкаНаВозврат") Тогда
		Рез = "ZV";
	ИначеЕсли ТипЗнч(Док) = Тип("ДокументСсылка.ПлатежноеПоручение") Тогда
		Рез = "PP";
	ИначеЕсли ТипЗнч(Док) = Тип("ДокументСсылка.ЗаявкаНаНаличныеБанковскаяКарта") Тогда
		Рез = "ZN";
	ИначеЕсли ТипЗнч(Док) = Тип("ДокументСсылка.РасшифровкаВнесенныхЧерезБанкоматСредств") Тогда
		Рез = "RN";
	// добавлено 26.01.2022	
	ИначеЕсли ТипЗнч(Док) = Тип("ДокументСсылка.СводнаяЗаявкаНаКассовыйРасход") Тогда
		Рез = "ZK";
	ИначеЕсли ТипЗнч(Док) = Тип("ДокументСсылка.РаспоряжениеОПеречисленииНаКартыМир") Тогда
		Рез = "DM";
	ИначеЕсли ТипЗнч(Док) = Тип("ДокументСсылка.УведомлениеОбУточненииВидаИПринадлежностиПлатежа") Тогда
		Рез = "UF";
	ИначеЕсли ТипЗнч(Док) = Тип("ДокументСсылка.УведомлениеОбУточненииОперацийКлиента") Тогда
		Рез = "UK";
	КонецЕсли;
	
	Возврат Рез;
	
КонецФункции

// при прямом задании признака в формате BH все документы расшифровки прописываются как документы одного вида
Функция ВозвратПризнакаДокумента(Значение)     ЭКСПОРТ
		
	Если Значение = "1" ИЛИ Значение = "2" Тогда //тип ЗКР - обязательный реквизит
		Возврат "ZR"
	ИначеЕсли Значение = "01" Тогда  //вид операции ПП
		Возврат "01"
	ИначеЕсли Значение = "" ИЛИ СтрДлина(Значение) = 10 Тогда   //дата
		Возврат "ZV"
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// Возвращает значение заданной характеристики (ИмяХарактеристики) из рег.св. ХарактеристикиОбязательств
//
// Параметры:
// 		
// Возвращаемое значение:
// 		Тип:
Функция ПолучитьХарактеристикиОбязательств(ОбъектСсылка = Неопределено, ИмяХарактеристики, ДатаЗначения, ПолучатьКодСпособаРазмещения = Истина)     ЭКСПОРТ
	
	Попытка
		Характеристика = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства[ИмяХарактеристики];
	Исключение
		Возврат "";
	КонецПопытки;
	
	Запрос       = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", 				ОбъектСсылка);
	Запрос.УстановитьПараметр("ВидХарактеристики",		Характеристика);
	Запрос.УстановитьПараметр("Период",					КонецДня(ДатаЗначения));
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ХарактеристикиОбязательствСрезПоследних.ВидХарактеристики КАК ВидХарактеристики,
	|	ХарактеристикиОбязательствСрезПоследних.ЗначениеХарактеристики КАК ЗначениеХарактеристики
	|ИЗ
	|	РегистрСведений.ХарактеристикиОбязательств КАК ХарактеристикиОбязательствСрезПоследних
	|ГДЕ
	|	ХарактеристикиОбязательствСрезПоследних.Договор = &Ссылка
	|	И ХарактеристикиОбязательствСрезПоследних.ВидХарактеристики = &ВидХарактеристики";
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда
		Возврат ?(Характеристика = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.СпособРазмещенияЗаказа И ПолучатьКодСпособаРазмещения, РезультатЗапроса.ЗначениеХарактеристики.Код,РезультатЗапроса.ЗначениеХарактеристики);
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

Функция ПолучитьХарактеристикуОбязательста(ОбъектСсылка = Неопределено, ИмяХарактеристики, Дата) ЭКСПОРТ
	
	Попытка
		Характеристика = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства[ИмяХарактеристики];
	Исключение
		Характеристика = Неопределено;
	КонецПопытки;
	
	Запрос       = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", 				ОбъектСсылка);
	Запрос.УстановитьПараметр("ВидХарактеристики",		Характеристика);
	Запрос.УстановитьПараметр("Период",					Дата);
	Запрос.УстановитьПараметр("ПоНаименованию",			НЕ ЗначениеЗаполнено(Характеристика));
	Запрос.УстановитьПараметр("Наименование",			ИмяХарактеристики);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ХарактеристикиОбязательствСрезПоследних.ВидХарактеристики КАК ВидХарактеристики,
	|	ХарактеристикиОбязательствСрезПоследних.ЗначениеХарактеристики КАК ЗначениеХарактеристики
	|ИЗ
	|	РегистрСведений.ХарактеристикиОбязательств.СрезПоследних(&Период, ) КАК ХарактеристикиОбязательствСрезПоследних
	|ГДЕ
	|	ХарактеристикиОбязательствСрезПоследних.Договор = &Ссылка
	|	И ВЫБОР
	|			КОГДА &ПоНаименованию
	|				ТОГДА ХарактеристикиОбязательствСрезПоследних.ВидХарактеристики.Наименование = &Наименование
	|			ИНАЧЕ ХарактеристикиОбязательствСрезПоследних.ВидХарактеристики = &ВидХарактеристики
	|		КОНЕЦ";
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда
		Возврат РезультатЗапроса.ЗначениеХарактеристики;
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

Функция ПолучитьДанныеДоговора(Договор, ИмяЗапрашиваемогоПараметра)     ЭКСПОРТ
	
	Если НЕ ЗначениеЗаполнено(ИмяЗапрашиваемогоПараметра) Тогда
		Возврат "";
	КонецЕсли;
	
	Запрос       = Новый Запрос;
	Запрос.УстановитьПараметр("Договор", 				Договор);
	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	СрокиИсполненияИСуммыОбязательствСрезПоследних." + ИмяЗапрашиваемогоПараметра + "		    КАК Параметр
	|ИЗ
	|	РегистрСведений.СрокиИсполненияИСуммыОбязательств.СрезПоследних(, Обязательство = &Договор) КАК СрокиИсполненияИСуммыОбязательствСрезПоследних
	|";
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда
		Возврат РезультатЗапроса.Параметр;
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

// Возвращает нужное сведение о договоре ГК
//
// Параметры:
// 		
// Возвращаемое значение:
// 		Тип:
Функция ПолучитьСведенияОДоговореГК(ОбъектСсылка = Неопределено, ИмяЗапрашиваемогоПараметра)     ЭКСПОРТ
	
	Если НЕ ЗначениеЗаполнено(ИмяЗапрашиваемогоПараметра) Тогда
		Возврат "";
	КонецЕсли;
	
	Запрос       = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", 				ОбъектСсылка);
	
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	СрокИсполненияИСуммаДоговоровСрезПоследних." + ИмяЗапрашиваемогоПараметра + "			КАК Параметр
	|ИЗ
	|	РегистрСведений.СрокИсполненияИСуммаДоговоров.СрезПоследних(, Регистратор = &Ссылка) 	КАК СрокИсполненияИСуммаДоговоровСрезПоследних
	|";
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда
		Если ИмяЗапрашиваемогоПараметра = "ВалютаРасчетов" Тогда
			
			ЗначениеРезультата = РезультатЗапроса.Параметр;
			Если ЗначениеЗаполнено(ЗначениеРезультата) Тогда
				Возврат ЗначениеРезультата.Код;
			Иначе
				Возврат "643";
			КонецЕсли;
			
		Иначе
			Возврат РезультатЗапроса.Параметр;
		КонецЕсли;
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

// Возвращает таблицу с годами, по которым проходит финансирование
//
// Параметры:
// 		
// Возвращаемое значение:
// 		Тип:
Функция ПолучитьТаблицуЛетФинансирования(ОбъектСсылка = Неопределено, КолЛет)
	
	Запрос       = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", 				ОбъектСсылка);
	
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ " + КолЛет + "
	|ГОД(ПланФинансированияОбязательствСрезПоследних.КлючАналитики.ПериодПлана.ДатаОкончания)					КАК ГОДФИН
	|
	|ИЗ
	|	РегистрСведений.ПланФинансированияОбязательств.СрезПоследних(, Регистратор = &Ссылка) 	КАК ПланФинансированияОбязательствСрезПоследних
	|УПОРЯДОЧИТЬ ПО
	|	ГОДФИН
	|";
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Возврат РезультатЗапроса;
	
КонецФункции

// Определяет номер года по порядку в графике финенсирования
//
// Параметры:
// 		
// Возвращаемое значение:
// 		Тип:
Функция ОпрделитьНомерГода(ОбъектСсылка, Год)
	
	Таб    = ПолучитьТаблицуЛетФинансирования(ОбъектСсылка, 9);
	
	Строка = Таб.Найти(Год, "ГОДФИН");
	Если Строка <> Неопределено Тогда
		Возврат Таб.Индекс(Строка) + 1;
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

// Возвращает значение года финансирования по его номеру по порядку
//
// Параметры:
// 		
// Возвращаемое значение:
// 		Тип:
Функция ГодФинансированияКонтракта(ОбъектСсылка = Неопределено, НомерГода)     ЭКСПОРТ
	
	Если НЕ ЗначениеЗаполнено(НомерГода) Тогда
		Возврат "";
	КонецЕсли;
	
	ТабЛет = ПолучитьТаблицуЛетФинансирования(ОбъектСсылка, НомерГода);
	
	Если ТабЛет.Количество() = НомерГода Тогда
		Возврат Прав(Строка(ТабЛет[НомерГода - 1].ГОДФИН), 2);
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

// Возвращает таблицу с информацией о поставщике
//
// Параметры:
// 		
// Возвращаемое значение:
// 		Тип:
Функция ТаблицаСведенийОПоставщике(ОбъектСсылка = Неопределено)    ЭКСПОРТ
	
	РезультирующаяТаблица = Новый ТаблицаЗначений;
	
	РезультирующаяТаблица.Колонки.Добавить("НаименованиеПоставщика");
	РезультирующаяТаблица.Колонки.Добавить("НаименованиеСтраны");
	РезультирующаяТаблица.Колонки.Добавить("КодОКСМ");
	РезультирующаяТаблица.Колонки.Добавить("АдресПоставщика");
	РезультирующаяТаблица.Колонки.Добавить("ИНН");
	РезультирующаяТаблица.Колонки.Добавить("КПП");
	РезультирующаяТаблица.Колонки.Добавить("Статус");
	РезультирующаяТаблица.Колонки.Добавить("Телефон");
	Возврат РезультирующаяТаблица;
		
КонецФункции

// Возвращает номер строки связанной табличной части
//
// Параметры:
// 		
// Возвращаемое значение:
// 		Тип:
Функция НомерСтрокиПоКлючу(Ключ, ТабЧасть)    ЭКСПОРТ
	
	МассивСтрок = ТабЧасть.НайтиСтроки(Новый Структура("КлючСтроки", Ключ));
	
	Если МассивСтрок.Количество() > 0 Тогда
		Возврат МассивСтрок[0].НомерСтроки;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

// Возвращает таблицу с информацией о пунктах ген.разрешения и источниках и направлениях использования
//
// Параметры:
// 		
// Возвращаемое значение:
// 		Тип:
