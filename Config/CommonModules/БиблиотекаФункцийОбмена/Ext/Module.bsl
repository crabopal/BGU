// Создает нового контрагента, по подготовленной структуре параметров, и возвращает ссылку на него
//
// Параметры:
// 		ОписаниеКонтрагента - структура заданного вида
// Возвращаемое значение:
// 		Тип: Ссылка на новый созданный элемент справочника Контрагенты
Функция СоздатьКонтрагентаПоОписанию(ОписаниеКонтрагента)     ЭКСПОРТ
	
	Объект 					= Справочники.Контрагенты.СоздатьЭлемент();
	НаименованиеКонтрагента = "";
	
	Если ОписаниеКонтрагента.Свойство("Наименование", НаименованиеКонтрагента) Тогда
		Объект.Наименование 		= НаименованиеКонтрагента;
	КонецЕсли;
	ИНН = "";
	ОписаниеКонтрагента.Свойство("ИНН", ИНН);	
	КПП = "";
	ОписаниеКонтрагента.Свойство("КПП", КПП);
	КодРПБС = "";
	ОписаниеКонтрагента.Свойство("КодПоРПБС", КодРПБС);
	
	ФЛ = "";
	Если НЕ ОписаниеКонтрагента.Свойство("ЭтоФизическоеЛицо", ФЛ) Тогда
		ФЛ = Ложь;
	КонецЕсли;
	
	Если ФЛ Тогда
		Объект.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо;
		Объект.ЮридическоеФизическоеЛицо = СоздатьЮрФизЛицо(НаименованиеКонтрагента, ИНН ,"ФизическиеЛица");
	Иначе
		Объект.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо;
		Объект.ЮридическоеФизическоеЛицо = СоздатьЮрФизЛицо(НаименованиеКонтрагента, ИНН ,"ЮридическиеЛица", КПП, КодРПБС);
	КонецЕсли;
	
	Объект.ИНН = ИНН;
	Объект.КПП = КПП;
	
	Попытка
		Объект.Записать();
	Исключение
		Возврат "";
	КонецПопытки;
	
	Возврат Объект.Ссылка;
	
КонецФункции

// проверяет заполнение КПП
