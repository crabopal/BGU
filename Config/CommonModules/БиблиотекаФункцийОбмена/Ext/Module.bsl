Функция ТаблицаИдентификаторовПолученныхСообщений(МассивИдентификаторовСообщений) Экспорт
	ТаблицаИдентификаторов = Новый ТаблицаЗначений;
	ТаблицаИдентификаторов.Колонки.Добавить("ИдСообщения",ОбщегоНазначения.ОписаниеТипаСтрока(50));
	ТаблицаИдентификаторов.Колонки.Добавить("ССЫЛКАДОКУМЕНТА");
	ТаблицаИдентификаторов.Колонки.Добавить("НомерСтроки");
	ТаблицаИдентификаторов.Колонки.Добавить("ИмяТабЧасти",       Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)));
	ТаблицаИдентификаторов.Колонки.Добавить("ПОЛЕСВЯЗИ");
	
	Если ТипЗнч(МассивИдентификаторовСообщений)<>Тип("Массив") Тогда
		Возврат ТаблицаИдентификаторов;
	КонецЕсли;
	
	СсылкаДокумента = Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПустаяСсылка();
	
	НомерСтроки = 1;
	Для Каждого ТекИд Из МассивИдентификаторовСообщений Цикл
		НовСтр = ТаблицаИдентификаторов.Добавить();
		НовСтр.ИдСообщения = ТекИд;
		НовСтр.ССЫЛКАДОКУМЕНТА = СсылкаДокумента;
		НовСтр.НомерСтроки = НомерСтроки;
		НовСтр.ИмяТабЧасти = "ТАБЛИЦАИДЕНТИФИКАТОРОВ";
		НовСтр.ПОЛЕСВЯЗИ = ИСТИНА;
		
		НомерСтроки = НомерСтроки + 1;
		
	КонецЦикла;
	
	Возврат ТаблицаИдентификаторов;
КонецФункции	
