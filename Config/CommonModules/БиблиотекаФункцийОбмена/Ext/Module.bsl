Функция ВернутьСтрокуДляНазначенияПлатежа(НазначениеПлатежа,НомерСтрокиНП,УвеличиватьНП = Истина) Экспорт
	ИсходныйНомерСтрокиНП = НомерСтрокиНП;
	ТекНазначениеПлатежа = НазначениеПлатежа;
	НомерСимволаНачала = 0;
	Инд = 2;
	Пока Инд <= НомерСтрокиНП Цикл
		ТекНомер = Найти(ТекНазначениеПлатежа,Символы.ПС);
		Если ТекНомер > 0 Тогда
			ТекВозвращаемоеЗначение = Сред(ТекНазначениеПлатежа,НомерСимволаНачала,ТекНомер-1);
			Если УвеличиватьНП Тогда
				Если СтрДлина(ТекНазначениеПлатежа)>ТекНомер И СокрЛП(ТекВозвращаемоеЗначение) = "" Тогда
					НомерСтрокиНП = НомерСтрокиНП+1;
				КонецЕсли;
			КонецЕсли;
			НомерСимволаНачала = ТекНомер;
			ТекНазначениеПлатежа = Сред(ТекНазначениеПлатежа,НомерСимволаНачала+1);
		Иначе
			Возврат "";
		КонецЕсли;
		Инд = Инд + 1;
	КонецЦикла;
	Если ИсходныйНомерСтрокиНП = 6 Тогда
		//Это последняя строка, возвращаем всю оставшуюся строку
		Возврат ТекНазначениеПлатежа;
	Иначе	
		НомерСимволаКонца = Найти(ТекНазначениеПлатежа,Символы.ПС);
		Если НомерСимволаКонца>0 Тогда
			ВозвращаемоеЗначение = Сред(ТекНазначениеПлатежа,1,НомерСимволаКонца-1);
			Если СтрДлина(ТекНазначениеПлатежа)>НомерСимволаКонца И СокрЛП(ВозвращаемоеЗначение) = "" Тогда
				Возврат ВернутьСтрокуДляНазначенияПлатежа(НазначениеПлатежа,НомерСтрокиНП+1,Ложь);		
			Иначе				
				ТекНазначениеПлатежа = ВозвращаемоеЗначение;
			КонецЕсли;
		КонецЕсли;
		Возврат ТекНазначениеПлатежа;
	КонецЕсли;	
	
КонецФункции

Функция ПреобразоватьСтрокуВСписокПолей(СтрокаПолей)
	
	Результат = Новый СписокЗначений;
	ПоследнийЭлемент = Неопределено;
	
	Для Сч = 1 По СтрЧислоСтрок(СтрокаПолей) Цикл
		Стр = СтрПолучитьСтроку(СтрокаПолей, Сч);
		Если Лев(Стр, 1) = Символы.Таб Тогда
			Если ПоследнийЭлемент <> Неопределено Тогда
				ПоследнийЭлемент.Значение = ПоследнийЭлемент.Значение + Символы.ПС + Сред(Стр, 2);
			КонецЕсли;
		Иначе
			Поз = Найти(Стр, "=");
			Если Поз <> 0 Тогда
				ПоследнийЭлемент = Результат.Добавить(Сред(Стр, Поз+1), Лев(Стр, Поз-1));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

