		ПроизвольныеПараметры.Свойство("ПолучательИНН",			ПолучательИНН);
		ПроизвольныеПараметры.Свойство("ПолучательКПП",			ПолучательКПП);
		ПроизвольныеПараметры.Свойство("ПолучательРасчСчет",	ПолучательРасчСчет);
		ПроизвольныеПараметры.Свойство("ПолучательИмяБанка",	ПолучательИмяБанка);
		ПроизвольныеПараметры.Свойство("ПолучательКорСчет",		ПолучательКорСчет);
		ПроизвольныеПараметры.Свойство("Плательщик",			Плательщик);
		ПроизвольныеПараметры.Свойство("ПлательщикИНН",			ПлательщикИНН);
		ПроизвольныеПараметры.Свойство("ПлательщикКПП",			ПлательщикКПП);
		ПроизвольныеПараметры.Свойство("ПлательщикРасчСчет",	ПлательщикРасчСчет);
		ПроизвольныеПараметры.Свойство("ПлательщикИмяБанка",	ПлательщикИмяБанка);
		ПроизвольныеПараметры.Свойство("ПлательщикБИК",			ПлательщикБИК);
		ПроизвольныеПараметры.Свойство("ПлательщикКорСчет",		ПлательщикКорСчет);
		ПроизвольныеПараметры.Свойство("ПоказательОснования",	ПоказательОснования);
		ПроизвольныеПараметры.Свойство("ПоказательПериода",		ПоказательПериода);
		ПроизвольныеПараметры.Свойство("ПоказательТипа",		ПоказательТипа);
		ПроизвольныеПараметры.Свойство("ПоказательНомера",		ПоказательНомера);
		ПроизвольныеПараметры.Свойство("ПоказательДаты",		ПоказательДаты);
	Иначе
		ПолучательБИК 		= ПроизвольныеПараметры.Получить("ПолучательБИК");	
		НазначениеПлатежа 	= ПроизвольныеПараметры.Получить("НазначениеПлатежа");	
		СуммаДок 			= ПроизвольныеПараметры.Получить("СуммаДок");	
		ВидПлатежа 			= ПроизвольныеПараметры.Получить("ВидПлатежа");	
		Очередность 		= ПроизвольныеПараметры.Получить("Очередность");	
		Получатель 			= ПроизвольныеПараметры.Получить("Получатель");	
		ПолучательИНН 		= ПроизвольныеПараметры.Получить("ПолучательИНН");	
		ПолучательКПП 		= ПроизвольныеПараметры.Получить("ПолучательКПП");	
		ПолучательРасчСчет 	= ПроизвольныеПараметры.Получить("ПолучательРасчСчет");	
		ПолучательИмяБанка 	= ПроизвольныеПараметры.Получить("ПолучательИмяБанка");	
		ПолучательКорСчет 	= ПроизвольныеПараметры.Получить("ПолучательКорСчет");	
		Плательщик 			= ПроизвольныеПараметры.Получить("Плательщик");	
		ПлательщикИНН		= ПроизвольныеПараметры.Получить("ПлательщикИНН");
		ПлательщикКПП		= ПроизвольныеПараметры.Получить("ПлательщикКПП");
		ПлательщикРасчСчет 	= ПроизвольныеПараметры.Получить("ПлательщикРасчСчет");	
		ПлательщикИмяБанка 	= ПроизвольныеПараметры.Получить("ПлательщикИмяБанка");	
		ПлательщикБИК 		= ПроизвольныеПараметры.Получить("ПлательщикБИК");	
		ПлательщикКорСчет 	= ПроизвольныеПараметры.Получить("ПлательщикКорСчет");	
		ПоказательОснования	= ПроизвольныеПараметры.Получить("ПоказательОснования");	
		ПоказательПериода 	= ПроизвольныеПараметры.Получить("ПоказательПериода");	
		ПоказательТипа 		= ПроизвольныеПараметры.Получить("ПоказательТипа");	
		ПоказательНомера 	= ПроизвольныеПараметры.Получить("ПоказательНомера");	
		ПоказательДаты 		= ПроизвольныеПараметры.Получить("ПоказательДаты");	
	КонецЕсли;
                                      
	ДокументОбъект.Контрагент		= ОпределитьКонтрагента(ПлательщикИНН, ПлательщикКПП, Плательщик);
	
	ДокументОбъект.СчетКонтрагента  = ОпределитьСчетКонтрагента(ДокументОбъект.Контрагент, 
																		ПлательщикРасчСчет, 
																	  	ПлательщикБИК, 
																		ПлательщикИмяБанка, 
																	  	ПлательщикКорСчет);
	
	ДокументОбъект.НазначениеПлатежа  		    = НазначениеПлатежа;
	ДокументОбъект.СуммаДокумента       		= СуммаДок;
	
	ДокументОбъект.ВидПлатежа					= ВидПлатежа;
	ДокументОбъект.ОчередностьПлатежа			= Очередность;
	
	ДокументОбъект.ПолучательНаименование       = Получатель;
	ДокументОбъект.ИННПолучателя			    = ПолучательИНН;
	ДокументОбъект.КПППолучателя			    = ПолучательКПП;
	ДокументОбъект.ПолучательБанковскийСчет		= ПолучательРасчСчет;
	ДокументОбъект.ПолучательНаименованиеБанка	= ПолучательИмяБанка;
	ДокументОбъект.ПолучательКорСчетБанка		= ПолучательКорСчет;
	
	ДокументОбъект.КонтрагентНаименование		= Плательщик;
	ДокументОбъект.КонтрагентБанковскийСчет		= ПлательщикРасчСчет;
    ДокументОбъект.КонтрагентНаименованиеБанка	= ПлательщикИмяБанка;
	ДокументОбъект.КонтрагентБИКБанка			= ПлательщикБИК;
	ДокументОбъект.КонтрагентКорСчетБанка		= ПлательщикКорСчет;
	Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ИнкассовоеПоручение") Тогда
		ДокументОбъект.ПоказательОснования		= ПоказательОснования;
		ДокументОбъект.ПоказательПериода		= ПоказательПериода;
		ДокументОбъект.ПоказательТипа			= ПоказательТипа;
		ДокументОбъект.ПоказательНомера			= ПоказательНомера;
		ДокументОбъект.ПоказательДаты			= ПоказательДаты;
	КонецЕсли; 
	
	ДокументОбъект.Записать();
	Возврат ДокументОбъект;
	
КонецФункции

// Находит Заявление по заданным параметрам
Функция ОпределитьЗаялениеИнВал(Организация, НомерЛС, НомерДок,  ДатаДок)  ЭКСПОРТ
	
	Если НЕ ЗначениеЗаполнено(НомерДок) ИЛИ НЕ ЗначениеЗаполнено(ДатаДок) Тогда
		 Возврат "";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НомерЛС", 		СокрЛП(НомерЛС));
	Запрос.УстановитьПараметр("ПолныйНомерДок", ВосстановитьНомерДляИБ(Организация, НомерДок, "ЗаявлениеНаПроведениеОперацийСИностраннойВалютой"));
	Запрос.УстановитьПараметр("НомерДок",       НомерДок);
	Запрос.УстановитьПараметр("ДатаДокНач", 	НачалоДня(ДатаДок));
	Запрос.УстановитьПараметр("ДатаДокКон", 	КонецДня(ДатаДок));
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
   |        Заявление.Ссылка КАК ДокументСсылка
   |	ИЗ
   |		Документ.ЗаявлениеНаПроведениеОперацийСИностраннойВалютой КАК Заявление
   |	ГДЕ
   |	   (Заявление.Номер = &НомерДок  ИЛИ  Заявление.Номер = &ПолныйНомерДок)
   |		И Заявление.ЛицевойСчет.Код = &НомерЛС
   |		И Заявление.Дата >= &ДатаДокНач
   |		И Заявление.Дата <= &ДатаДокКон
   |";
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Возврат Результат.ДокументСсылка;
	КонецЕсли;

	Возврат "";
	
КонецФункции
																									       

// Находит Заявку по заданным параметрам
Функция ОпределитьЗаявку(Организация, НомерЛС, НомерДок, ДатаДок, СуммаДокумента, GUID = "")     ЭКСПОРТ
	
	Если ЗначениеЗаполнено(GUID) Тогда  
		
	     Запрос = Новый Запрос;
	     Запрос.УстановитьПараметр("GUID", GUID);
		 
		 Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ 
	               |	ВложенныйЗапрос.Ссылка КАК ДокументСсылка
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		УведомлениеОбУточненииВидаИПринадлежностиПлатежа.Ссылка
				   |	ИЗ
	               |		Документ.УведомлениеОбУточненииВидаИПринадлежностиПлатежа КАК УведомлениеОбУточненииВидаИПринадлежностиПлатежа
	               |	ГДЕ
	               |	   (УведомлениеОбУточненииВидаИПринадлежностиПлатежа.GUID = &GUID)) КАК ВложенныйЗапрос   
				   |"; 
		 
		 Результат = Запрос.Выполнить().Выбрать();
	
		 Если Результат.Следующий() Тогда  
			
			 Возврат Результат.ДокументСсылка; 
				
		 КонецЕсли;
		 
	КонецЕсли;
	
	ЭтоСводнаяЗКР = Ложь;
	
	Если НЕ ЗначениеЗаполнено(НомерДок) ИЛИ НЕ ЗначениеЗаполнено(ДатаДок) Тогда
		 Возврат "";
	КонецЕсли;
	
	Если Найти(НомерДок, "@") > 0 Тогда
		 ЭтоСводнаяЗКР = Истина;
		 НомерДок      = Лев(НомерДок, Найти(НомерДок, "@") - 1);  
		 НомерДок      = СтрЗаменить(СтрЗаменить(НомерДок, "[", ""), "]", "");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НомерЛС", 		СокрЛП(НомерЛС));
	Запрос.УстановитьПараметр("ПолныйНомерДок", ВосстановитьНомерДляИБ(Организация, НомерДок, "ПлатежноеПоручение"));
	Запрос.УстановитьПараметр("НомерДок",       НомерДок);
	Запрос.УстановитьПараметр("ДатаДокНач", 	НачалоДня(ДатаДок));
	Запрос.УстановитьПараметр("ДатаДокКон", 	КонецДня(ДатаДок));
	Запрос.УстановитьПараметр("СуммаДокумента", СуммаДокумента);   
	
	Если ЭтоСводнаяЗКР Тогда
          Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		           |	ВложенныйЗапрос.Ссылка КАК ДокументСсылка				   
	               |ИЗ
	               |	   (ВЫБРАТЬ
	               |		ЗаявкаНаКассовыйРасход.Ссылка,
	               |		ЗаявкаНаКассовыйРасход.Номер,
	               |		ЗаявкаНаКассовыйРасход.Дата,
	             //  |		ЗаявкаНаКассовыйРасход.СуммаДокумента,
	               |		ЗаявкаНаКассовыйРасход.ЛицевойСчет.Код КАК ЛицевойСчетКод
	               |	ИЗ
	               |		Документ.СводнаяЗаявкаНаКассовыйРасход КАК ЗаявкаНаКассовыйРасход
	               |	ГДЕ
	               |	   (ЗаявкаНаКассовыйРасход.Номер = &НомерДок  ИЛИ  ЗаявкаНаКассовыйРасход.Номер = &ПолныйНомерДок)
	             //  |		И ЗаявкаНаКассовыйРасход.СуммаДокумента = &СуммаДокумента
	               |		И ЗаявкаНаКассовыйРасход.ЛицевойСчет.Код = &НомерЛС
	               |		И ЗаявкаНаКассовыйРасход.Дата >= &ДатаДокНач
	               |		И ЗаявкаНаКассовыйРасход.Дата <= &ДатаДокКон) КАК ВложенныйЗапрос";

	
	Иначе Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ 
	               |	ВложенныйЗапрос.Ссылка КАК ДокументСсылка,
				   |	ВЫБОР 
				   |       КОГДА ВложенныйЗапрос.Номер = &НомерДок 
				   |             ТОГДА ИСТИНА
				   |       ИНАЧЕ ЛОЖЬ
				   |    КОНЕЦ КАК СоответствуетНомеруИзФайла
	               |ИЗ  
				   |	(ВЫБРАТЬ
	               |		ЗаявкаНаВозврат.Ссылка КАК Ссылка,
	               |		ЗаявкаНаВозврат.Номер КАК Номер,
	               |		ЗаявкаНаВозврат.Дата КАК Дата,
	               |		ЗаявкаНаВозврат.СуммаДокументаВВалюте КАК СуммаДокументаВВалюте,
	               |		ЗаявкаНаВозврат.ЛицевойСчет.Код КАК ЛицевойСчетКод
	               |	ИЗ
	               |		Документ.ЗаявкаНаВозврат КАК ЗаявкаНаВозврат
	               |	ГДЕ
	               |	   (ЗаявкаНаВозврат.Номер = &НомерДок  ИЛИ  ЗаявкаНаВозврат.Номер = &ПолныйНомерДок)
	               |		И ЗаявкаНаВозврат.СуммаДокументаВВалюте = &СуммаДокумента
	               |		И ЗаявкаНаВозврат.ЛицевойСчет.Код = &НомерЛС
	               |		И ЗаявкаНаВозврат.Дата >= &ДатаДокНач
	               |		И ЗаявкаНаВозврат.Дата <= &ДатаДокКон
				   |
				   |	ОБЪЕДИНИТЬ ВСЕ
                   |
	               |	ВЫБРАТЬ
	               |		ЗаявкаНаКассовыйРасход.Ссылка,
	               |		ЗаявкаНаКассовыйРасход.Номер,
	               |		ЗаявкаНаКассовыйРасход.Дата,
				   |		ЗаявкаНаКассовыйРасход.СуммаДокумента,
	               |		ЗаявкаНаКассовыйРасход.ЛицевойСчет.Код КАК ЛицевойСчетКод
	               |	ИЗ
	               |		Документ.СводнаяЗаявкаНаКассовыйРасход КАК ЗаявкаНаКассовыйРасход
	               |	ГДЕ
	               |	   (ЗаявкаНаКассовыйРасход.Номер = &НомерДок  ИЛИ  ЗаявкаНаКассовыйРасход.Номер = &ПолныйНомерДок)
	               |		И ЗаявкаНаКассовыйРасход.ЛицевойСчет.Код = &НомерЛС
	               |		И ЗаявкаНаКассовыйРасход.Дата >= &ДатаДокНач
	               |		И ЗаявкаНаКассовыйРасход.Дата <= &ДатаДокКон
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		ЗаявкаНаКассовыйРасход.Ссылка,
	               |		ЗаявкаНаКассовыйРасход.Номер,
	               |		ЗаявкаНаКассовыйРасход.Дата,
	               |		ЗаявкаНаКассовыйРасход.СуммаДокументаВВалюте,
	               |		ЗаявкаНаКассовыйРасход.ЛицевойСчет.Код
	               |	ИЗ
	               |		Документ.ЗаявкаНаКассовыйРасход КАК ЗаявкаНаКассовыйРасход
	               |	ГДЕ
	               |	   (ЗаявкаНаКассовыйРасход.Номер = &НомерДок  ИЛИ  ЗаявкаНаКассовыйРасход.Номер = &ПолныйНомерДок)
	       //        |		И ЗаявкаНаКассовыйРасход.СуммаДокументаВВалюте = &СуммаДокумента
	               |		И ЗаявкаНаКассовыйРасход.ЛицевойСчет.Код = &НомерЛС
	               |		И ЗаявкаНаКассовыйРасход.Дата >= &ДатаДокНач
	               |		И ЗаявкаНаКассовыйРасход.Дата <= &ДатаДокКон
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		ЗаявкаНаКассовыйРасходСокр.Ссылка,
	               |		ЗаявкаНаКассовыйРасходСокр.Номер,
	               |		ЗаявкаНаКассовыйРасходСокр.Дата,
	               |		ЗаявкаНаКассовыйРасходСокр.СуммаДокумента,
	               |		ЗаявкаНаКассовыйРасходСокр.ЛицевойСчет.Код
	               |	ИЗ
	               |		Документ.ЗаявкаНаКассовыйРасходСокращенная КАК ЗаявкаНаКассовыйРасходСокр
	               |	ГДЕ
	               |	   (ЗаявкаНаКассовыйРасходСокр.Номер = &НомерДок  ИЛИ  ЗаявкаНаКассовыйРасходСокр.Номер = &ПолныйНомерДок)
	               |		И ЗаявкаНаКассовыйРасходСокр.СуммаДокумента = &СуммаДокумента
	               |		И ЗаявкаНаКассовыйРасходСокр.ЛицевойСчет.Код = &НомерЛС
	               |		И ЗаявкаНаКассовыйРасходСокр.Дата >= &ДатаДокНач
	               |		И ЗаявкаНаКассовыйРасходСокр.Дата <= &ДатаДокКон
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		ПлатежноеПоручение.Ссылка,
	               |		ПлатежноеПоручение.Номер,
	               |		ПлатежноеПоручение.Дата,
	               |		ПлатежноеПоручение.СуммаДокумента,
	               |		ПлатежноеПоручение.ЛицевойСчет.Код
	               |	ИЗ
	               |		Документ.ПлатежноеПоручение КАК ПлатежноеПоручение
	               |	ГДЕ
	               |	   (ПлатежноеПоручение.Номер = &НомерДок  ИЛИ  ПлатежноеПоручение.Номер = &ПолныйНомерДок)
	      //         |		И ПлатежноеПоручение.СуммаДокумента = &СуммаДокумента
	               |		И ПлатежноеПоручение.ЛицевойСчет.Код = &НомерЛС
	               |		И ПлатежноеПоручение.Дата >= &ДатаДокНач
	               |		И ПлатежноеПоручение.Дата <= &ДатаДокКон
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		ЗаявкаНаНаличные.Ссылка,
	               |		ЗаявкаНаНаличные.Номер,
	               |		ЗаявкаНаНаличные.Дата,
	               |		ЗаявкаНаНаличные.СуммаДокумента,
	               |		ЗаявкаНаНаличные.ЛицевойСчет.Код
	               |	ИЗ
	               |		Документ.ЗаявкаНаНаличные КАК ЗаявкаНаНаличные
	               |	ГДЕ
	               |	   (ЗаявкаНаНаличные.Номер = &НомерДок  ИЛИ  ЗаявкаНаНаличные.Номер = &ПолныйНомерДок)
	               |		И ЗаявкаНаНаличные.СуммаДокумента = &СуммаДокумента
	               |		И ЗаявкаНаНаличные.ЛицевойСчет.Код = &НомерЛС
	               |		И ЗаявкаНаНаличные.Дата >= &ДатаДокНач
	               |		И ЗаявкаНаНаличные.Дата <= &ДатаДокКон
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		ЗаявкаНаНаличные.Ссылка,
	               |		ЗаявкаНаНаличные.Номер,
	               |		ЗаявкаНаНаличные.Дата,
	               |		ЗаявкаНаНаличные.СуммаДокумента,
	               |		ЗаявкаНаНаличные.ЛицевойСчет.Код
	               |	ИЗ
	               |		Документ.ЗаявкаНаНаличныеБанковскаяКарта КАК ЗаявкаНаНаличные
	               |	ГДЕ
	               |	   (ЗаявкаНаНаличные.Номер = &НомерДок  ИЛИ  ЗаявкаНаНаличные.Номер = &ПолныйНомерДок)
	               |		И ЗаявкаНаНаличные.СуммаДокумента = &СуммаДокумента
	               |		И ЗаявкаНаНаличные.ЛицевойСчет.Код = &НомерЛС
	               |		И ЗаявкаНаНаличные.Дата >= &ДатаДокНач
	               |		И ЗаявкаНаНаличные.Дата <= &ДатаДокКон
				   |
				   |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		ВнешнееРСКП.Ссылка,
	               |		ВнешнееРСКП.Номер,
	               |		ВнешнееРСКП.Дата,
	               |		ВнешнееРСКП.СуммаДокумента,
	               |		ВнешнееРСКП.ЛицевойСчет.Код
	               |	ИЗ
	               |		Документ.ВнешнееРСКП КАК ВнешнееРСКП
	               |	ГДЕ
	               |	   (ВнешнееРСКП.Номер = &НомерДок  ИЛИ  ВнешнееРСКП.Номер = &ПолныйНомерДок)
	               |		И ВнешнееРСКП.СуммаДокумента = &СуммаДокумента
	               |		И ВнешнееРСКП.ЛицевойСчет.Код = &НомерЛС
	               |		И ВнешнееРСКП.Дата >= &ДатаДокНач
	               |		И ВнешнееРСКП.Дата <= &ДатаДокКон     
				   |     
				   |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		УведомлениеОбУточненииВидаИПринадлежностиПлатежа.Ссылка,
	               |		УведомлениеОбУточненииВидаИПринадлежностиПлатежа.Номер,
	               |		УведомлениеОбУточненииВидаИПринадлежностиПлатежа.Дата,
	               |		УведомлениеОбУточненииВидаИПринадлежностиПлатежа.СуммаДокумента,
	               |		УведомлениеОбУточненииВидаИПринадлежностиПлатежа.ЛицевойСчет.Код
	               |	ИЗ
	               |		Документ.УведомлениеОбУточненииВидаИПринадлежностиПлатежа КАК УведомлениеОбУточненииВидаИПринадлежностиПлатежа
	               |	ГДЕ
	               |	   (УведомлениеОбУточненииВидаИПринадлежностиПлатежа.Номер = &НомерДок  ИЛИ  
				   |		УведомлениеОбУточненииВидаИПринадлежностиПлатежа.Номер = &ПолныйНомерДок ИЛИ
				   |	    УведомлениеОбУточненииВидаИПринадлежностиПлатежа.ВнешнийНомер = &НомерДок)
	           //    |		И УведомлениеОбУточненииВидаИПринадлежностиПлатежа.СуммаДокумента = &СуммаДокумента
	               |		И УведомлениеОбУточненииВидаИПринадлежностиПлатежа.ЛицевойСчет.Код = &НомерЛС
	               |		И ((УведомлениеОбУточненииВидаИПринадлежностиПлатежа.Дата >= &ДатаДокНач
	               |		И УведомлениеОбУточненииВидаИПринадлежностиПлатежа.Дата <= &ДатаДокКон) ИЛИ  
				   |		(УведомлениеОбУточненииВидаИПринадлежностиПлатежа.ВнешняяДата >= &ДатаДокНач
	               |		И УведомлениеОбУточненииВидаИПринадлежностиПлатежа.ВнешняяДата <= &ДатаДокКон)) 
				   |
				   |	ОБЪЕДИНИТЬ ВСЕ
				   |	
				   |	ВЫБРАТЬ
				   |		РаспоряжениеОПеречисленииНаКартыМир.Ссылка,
				   |		РаспоряжениеОПеречисленииНаКартыМир.Номер,
				   |		РаспоряжениеОПеречисленииНаКартыМир.Дата,
				   |		РаспоряжениеОПеречисленииНаКартыМир.СуммаДокумента,
				   |		РаспоряжениеОПеречисленииНаКартыМир.ЛицевойСчет.Код
				   |	ИЗ
				   |		Документ.РаспоряжениеОПеречисленииНаКартыМир КАК РаспоряжениеОПеречисленииНаКартыМир
				   |	ГДЕ
				   |	   (РаспоряжениеОПеречисленииНаКартыМир.Номер = &НомерДок  ИЛИ  РаспоряжениеОПеречисленииНаКартыМир.Номер = &ПолныйНомерДок)
			//	   |		И РаспоряжениеОПеречисленииНаКартыМир.СуммаДокумента = &СуммаДокумента
				   |		И РаспоряжениеОПеречисленииНаКартыМир.ЛицевойСчет.Код = &НомерЛС
				   |		И РаспоряжениеОПеречисленииНаКартыМир.Дата >= &ДатаДокНач
				   |		И РаспоряжениеОПеречисленииНаКартыМир.Дата <= &ДатаДокКон)  КАК ВложенныйЗапрос   
				   |    УПОРЯДОЧИТЬ ПО 
				   |        СоответствуетНомеруИзФайла УБЫВ
				   |";
				   
	КонецЕсли;
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда  
		
		Возврат Результат.ДокументСсылка; 
			
	КонецЕсли;

	Возврат "";
	
КонецФункции

// Возвращает код значения дополнительного классификатора
//
// Параметры:
//  ДопКлассификация (СправочникСсылка.ДополнительнаяБюджетнаяКлассификация) - дополнительная классификация
//  КодКлассификатора (строка) - код вида дополнительного классификатора для поиска значения
//
Функция КодЗначенияПоДополнительномуКлассификатору(ДопКлассификация, КодКлассификатора) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ХарактеристикиДополнительнойБюджетнойКлассификации.ЗначениеДопКлассификатора.Код 	КАК КодЗначения
	|ИЗ
	|	РегистрСведений.ХарактеристикиДополнительнойБюджетнойКлассификации 					КАК ХарактеристикиДополнительнойБюджетнойКлассификации
	|ГДЕ
	|	ХарактеристикиДополнительнойБюджетнойКлассификации.ДополнительнаяБюджетнаяКлассификация	 = &ДополнительнаяБюджетнаяКлассификация
	|	И ХарактеристикиДополнительнойБюджетнойКлассификации.ВидДопКлассификатора.Код			 = &КодКлассификатора";
	
	Запрос.УстановитьПараметр("ДополнительнаяБюджетнаяКлассификация", ДопКлассификация);
	Запрос.УстановитьПараметр("КодКлассификатора", КодКлассификатора);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат СокрЛП(Выборка.КодЗначения);
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

//Возвращает значение УИС для заданного учреждения
