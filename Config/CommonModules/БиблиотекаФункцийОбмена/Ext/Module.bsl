//Выгрузка в ГИИС ЭБ
Функция ТаблицаБухПроводокИсходящегоИзвещенияГИИСЭБ(ДокументСсылка) Экспорт
	
	ТаблицаРеквизитовТЧ = Новый ТаблицаЗначений;
	ТаблицаРеквизитовТЧ.Колонки.Добавить("ССЫЛКАДОКУМЕНТА");
	ТаблицаРеквизитовТЧ.Колонки.Добавить("НомерСтроки");
	ТаблицаРеквизитовТЧ.Колонки.Добавить("ИмяТабЧасти",  Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)));
	ТаблицаРеквизитовТЧ.Колонки.Добавить("ПОЛЕСВЯЗИ");
	ТаблицаРеквизитовТЧ.Колонки.Добавить("Запись");
	ТаблицаРеквизитовТЧ.Колонки.Добавить("КБК_Дт_О");
	ТаблицаРеквизитовТЧ.Колонки.Добавить("КВД_Дт_О");
	ТаблицаРеквизитовТЧ.Колонки.Добавить("Код_счета_Дт_О");
	ТаблицаРеквизитовТЧ.Колонки.Добавить("КОСГУ_Дт_О");
	ТаблицаРеквизитовТЧ.Колонки.Добавить("КБК_Кт_О");
	ТаблицаРеквизитовТЧ.Колонки.Добавить("КВД_Кт_О");
	ТаблицаРеквизитовТЧ.Колонки.Добавить("Код_счета_Кт_О");
	ТаблицаРеквизитовТЧ.Колонки.Добавить("КОСГУ_Кт_О");
	ТаблицаРеквизитовТЧ.Колонки.Добавить("СуммаДт");
	ТаблицаРеквизитовТЧ.Колонки.Добавить("СуммаКт");    
	
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат ТаблицаРеквизитовТЧ;
	КонецЕсли;
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ИзвещениеИсходящее") И
			ТипЗнч(ДокументСсылка) <> Тип("Массив") Тогда
		Документ = ДокументСсылка;
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("Массив") Тогда 
		Документ = ДокументСсылка[0];
	Иначе
		Возврат ТаблицаРеквизитовТЧ; 
	КонецЕсли;
	
	МассивВидовИзвещенияСПередаваемымиПроводками = Новый Массив;
	МассивВидовИзвещенияСПередаваемымиПроводками.Добавить(Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаНФАПоставщика);
	МассивВидовИзвещенияСПередаваемымиПроводками.Добавить(Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаТребований);
	МассивВидовИзвещенияСПередаваемымиПроводками.Добавить(Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаОбязательств);
	МассивВидовИзвещенияСПередаваемымиПроводками.Добавить(Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаФинансовыхВложений);
	МассивВидовИзвещенияСПередаваемымиПроводками.Добавить(Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаВложенийВФинансовыеАктивы);
	МассивВидовИзвещенияСПередаваемымиПроводками.Добавить(Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаРБП);
	МассивВидовИзвещенияСПередаваемымиПроводками.Добавить(Перечисления.ВидыОперацийИсходящееИзвещение.НачислениеДохода);
	МассивВидовИзвещенияСПередаваемымиПроводками.Добавить(Перечисления.ВидыОперацийИсходящееИзвещение.РасчетыПоМБТ);
	
	СписокСчетов26 = БухгалтерскийУчет.СписокСчетов("26");
	СчетМЦК = БухгалтерскийУчет.СчетПоКоду("МЦК");	
	СчетаИсключения	= БухгалтерскийУчет.СписокСчетов("104.00,Н02,ОЦИ, МЦК");
	
	НомерСтроки = 1;
	
	Если МассивВидовИзвещенияСПередаваемымиПроводками.Найти(Документ.ВидИзвещения) <> Неопределено Тогда
		
		Если Документ.ПередаваемыеПроводки.Количество() = 0 Тогда
			ОбщегоНазначения.СообщитьПользователю("Документ пуст.");
		Иначе
			Для Каждого СтрокаТЧ Из Документ.ПередаваемыеПроводки Цикл
				
				СвойстваСчетаДт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаТЧ.СчетДт);
				СвойстваСчетаКт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаТЧ.СчетКт);
								
				Если СчетМЦК = СтрокаТЧ.СчетДт ИЛИ СчетМЦК = СтрокаТЧ.СчетДт 
					ИЛИ СписокСчетов26.Найти(СтрокаТЧ.СчетДт) <> Неопределено Или СписокСчетов26.Найти(СтрокаТЧ.СчетКт) <> Неопределено
					ИЛИ СвойстваСчетаДт.Забалансовый ИЛИ СвойстваСчетаКт.Забалансовый Тогда
					Продолжить;
				КонецЕсли;
							
				НоваяСтрока = ТаблицаРеквизитовТЧ.Добавить();
				НоваяСтрока.Запись 			= УдалениеСлужебныхСимволов(СтрокаТЧ.Содержание); 
				НоваяСтрока.КБК_Дт_О 		= СтрокаТЧ.КПСДт; 
				НоваяСтрока.КВД_Дт_О 		= СтрокаТЧ.КФО; 
				НоваяСтрока.Код_счета_Дт_О 	= СтрЗаменить(СтрокаТЧ.СчетДт.Код, ".", ""); 
				НоваяСтрока.КОСГУ_Дт_О 		= СтрокаТЧ.КЭКДт; 
				НоваяСтрока.КБК_Кт_О		= СтрокаТЧ.КПСКт; 
				НоваяСтрока.КВД_Кт_О 		= СтрокаТЧ.КФО; 
				НоваяСтрока.Код_счета_Кт_О 	= СтрЗаменить(СтрокаТЧ.СчетКт.Код, ".", ""); 
				НоваяСтрока.КОСГУ_Кт_О 		= СтрокаТЧ.КЭККт;
				НоваяСтрока.СуммаДт 		= СтрокаТЧ.Сумма; 
				НоваяСтрока.СуммаКт 		= СтрокаТЧ.Сумма;

				НоваяСтрока.ССЫЛКАДОКУМЕНТА = Документ;
				НоваяСтрока.НомерСтроки 	= НомерСтроки;
				НоваяСтрока.ИмяТабЧасти 	= ВРег("ТаблицаБухПроводок");
				НоваяСтрока.ПОЛЕСВЯЗИ 		= ИСТИНА;
				
				НомерСтроки = НомерСтроки + 1;

			КонецЦикла;	
		КонецЕсли;	
	Иначе
		
		Если Документ.ДокументыПередачи.Количество() = 0 Тогда
			ОбщегоНазначения.СообщитьПользователю("Документ пуст.");
		Иначе
			Для Каждого СтрокаТЧ Из Документ.ДокументыПередачи Цикл	
				
				РегистрБухгалтерииВыборка = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.ВыбратьПоРегистратору(СтрокаТЧ.ДокументПередачи);
				Пока РегистрБухгалтерииВыборка.Следующий() Цикл
					
					СвойстваСчетаДт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(РегистрБухгалтерииВыборка.СчетДт);
					СвойстваСчетаКт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(РегистрБухгалтерииВыборка.СчетКт);
					
					Если СчетаИсключения.Найти(РегистрБухгалтерииВыборка.СчетКт) <> Неопределено  ИЛИ СчетМЦК = РегистрБухгалтерииВыборка.СчетДт
						Или СписокСчетов26.Найти(РегистрБухгалтерииВыборка.СчетДт) <> Неопределено Или СписокСчетов26.Найти(РегистрБухгалтерииВыборка.СчетКт) <> Неопределено
						ИЛИ СвойстваСчетаДт.Забалансовый ИЛИ СвойстваСчетаКт.Забалансовый Тогда
						Продолжить;
					КонецЕсли;
					
					НоваяСтрока = ТаблицаРеквизитовТЧ.Добавить();
					НоваяСтрока.Запись 			= УдалениеСлужебныхСимволов(РегистрБухгалтерииВыборка.Содержание); 
					НоваяСтрока.КБК_Дт_О 		= РегистрБухгалтерииВыборка.КПСДт; 
					НоваяСтрока.КВД_Дт_О 		= РегистрБухгалтерииВыборка.КФО; 
				    НоваяСтрока.Код_счета_Дт_О 	= СтрЗаменить(РегистрБухгалтерииВыборка.СчетДт.Код, ".", ""); 
					НоваяСтрока.КОСГУ_Дт_О 		= РегистрБухгалтерииВыборка.КЭКДт; 
					НоваяСтрока.КБК_Кт_О		= РегистрБухгалтерииВыборка.КПСКт; 
					НоваяСтрока.КВД_Кт_О 		= РегистрБухгалтерииВыборка.КФО; 
					НоваяСтрока.Код_счета_Кт_О 	= СтрЗаменить(РегистрБухгалтерииВыборка.СчетКт.Код, ".", ""); 
					НоваяСтрока.КОСГУ_Кт_О 		= РегистрБухгалтерииВыборка.КЭККт;
					НоваяСтрока.СуммаДт 		= РегистрБухгалтерииВыборка.Сумма; 
					НоваяСтрока.СуммаКт 		= РегистрБухгалтерииВыборка.Сумма;
					
					НоваяСтрока.ССЫЛКАДОКУМЕНТА = Документ;
					НоваяСтрока.НомерСтроки 	= НомерСтроки;
					НоваяСтрока.ИмяТабЧасти		= ВРег("ТаблицаБухгалтерскихПроводок");
					НоваяСтрока.ПОЛЕСВЯЗИ 		= ИСТИНА;
				
					НомерСтроки = НомерСтроки + 1;
					
				КонецЦикла;
			КонецЦикла;  
		КонецЕсли;
	КонецЕсли;	
	
	Возврат ТаблицаРеквизитовТЧ;
	
КонецФункции

функция ТаблицаБухОборотовИсходящегоИзвещенияГИИСЭБ(ДокументСсылка) Экспорт

	ТЗДляОборотовВЖурнале = ТаблицаБухПроводокИсходящегоИзвещенияГИИСЭБ(ДокументСсылка);
	ТЗДляОборотовВЖурнале.Свернуть("КБК_Дт_О, КВД_Дт_О, Код_счета_Дт_О, КОСГУ_Дт_О, КБК_Кт_О, КВД_Кт_О, Код_счета_Кт_О, КОСГУ_Кт_О", "СуммаДт, СуммаКт");
		
	ТЗДляОборотовВЖурнале.Колонки.Добавить("ССЫЛКАДОКУМЕНТА");
	ТЗДляОборотовВЖурнале.Колонки.Добавить("НомерПП");
	ТЗДляОборотовВЖурнале.Колонки.Добавить("НомерСтроки");
	ТЗДляОборотовВЖурнале.Колонки.Добавить("ИмяТабЧасти",       Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)));
	ТЗДляОборотовВЖурнале.Колонки.Добавить("ПОЛЕСВЯЗИ");
	
	НомерСтроки = 1;
	Для каждого СтрокаТЧ Из ТЗДляОборотовВЖурнале Цикл
		
		 СтрокаТЧ.ССЫЛКАДОКУМЕНТА 	= ДокументСсылка[0];
		 СтрокаТЧ.НомерСтроки 		= НомерСтроки;
		 СтрокаТЧ.НомерПП 			= НомерСтроки;
		 СтрокаТЧ.ИмяТабЧасти 		= ВРег("ТаблицаОборотыБухгалтерскихПроводок");
		 СтрокаТЧ.ПОЛЕСВЯЗИ 		= Истина; 
		 
		 НомерСтроки = НомерСтроки + 1;
		 
	КонецЦикла;
	
	Возврат ТЗДляОборотовВЖурнале;
	
КонецФункции
