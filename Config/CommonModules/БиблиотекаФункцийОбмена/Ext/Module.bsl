// Возвращает номер документа с восстановленными префиксами и лидируещими нулями
Функция ВосстановитьНомерДляИБ(Организация, знач Номер, ИмяДокумента = "ПлатежноеПоручение") ЭКСПОРТ
	
	ДлинаНомера = Документы[ИмяДокумента].ПустаяСсылка().Метаданные().ДлинаНомера;
	// если номер документа уже полный и, скорее всего, не обрезался ранее
	//Если СтрДлина(Номер) = ДлинаНомера Тогда
	//	Возврат Номер;
	//КонецЕсли;
	// убираем возможные лишние префиксы, неотносящиеся к ИБ
	Номер                     = НомерБезПрефиксовИЛидирующихНулей(Номер);
	
	ПрефиксИнформационнойБазы = "";
	ПрефиксОрганизации        = "";		
	ПрефиксИнформационнойБазы = ОбменДаннымиСервер.ПрефиксИнформационнойБазы();		
	ПрефиксИнформационнойБазы = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(ПрефиксИнформационнойБазы, 2);							
	ПрефиксОрганизации        = ПолучитьФункциональнуюОпцию("ПрефиксыОрганизаций", Новый Структура("Организация", Организация));
			
	// если задана пустая ссылка на организацию
	Если ПрефиксОрганизации   = Ложь Тогда
		ПрефиксОрганизации    = "";			
	КонецЕсли;
					
	ПрефиксОрганизации = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(ПрефиксОрганизации, 2);			
	ОсновнойПрефикс    = ПрефиксОрганизации + ПрефиксИнформационнойБазы;	
	Разделитель        = "-";	
	Префикс            = ОсновнойПрефикс + Разделитель + Префикс;
	ОбщийПрефикс       = Префикс;
	
	Пока СтрДлина(ОбщийПрефикс + Номер) < ДлинаНомера Цикл
		ОбщийПрефикс = ОбщийПрефикс + "0";	
	КонецЦикла;
	
	Результат          = ОбщийПрефикс + Номер;
	
	Возврат Результат;
	
КонецФункции

