			НовСтр.стр100_гр1 = ?(ЗначениеЗаполнено(СтрТаб.Аналитика1),СоответствиеРеквизитов[СтрТаб.Аналитика1].НаименованиеПолное,"");
			НовСтр.стр100_гр2 = ?(ЗначениеЗаполнено(СтрТаб.Аналитика1),СоответствиеРеквизитов[СтрТаб.Аналитика1].Код,"");
			НовСтр.стр100_гр3 = ?(ЗначениеЗаполнено(СтрТаб.Аналитика2),СтрТаб.Аналитика2,"000")
				+?(ЗначениеЗаполнено(СтрТаб.Аналитика3),СтрТаб.Аналитика3,"0000")
				+?(ЗначениеЗаполнено(СтрТаб.Аналитика4),СтрТаб.Аналитика4,"00000")
				+?(ЗначениеЗаполнено(СтрТаб.Аналитика5),СтрТаб.Аналитика5,"00000")
				+?(ЗначениеЗаполнено(СтрТаб.Аналитика6),СтрТаб.Аналитика6,"000");
			
			НовСтр.стр100_гр4 = СтрТаб.стр100_гр4;
			НовСтр.стр100_гр5 = СтрТаб.стр100_гр5;
			НовСтр.стр100_гр6 = СтрТаб.стр100_гр6;
			НовСтр.стр100_гр7 = СтрТаб.стр100_гр7;
			
			НовСтр.НомерСтроки = Инд+1;
			НовСтр.ИмяТабЧасти = ИмяТЧ;
			НовСтр.ПОЛЕСВЯЗИ = Истина;
			НовСтр.ССЫЛКАДОКУМЕНТА = ЭлементМассива;
		КонецЦикла;		
		
	КонецЦикла;

	Возврат Таблица;
КонецФункции

Функция УниверсальныйРегламентированныйОтчетПолучитьПараметрОтчета(ОбъектСсылка,ИмяПараметра,ЗначениеПоУмолчанию=Неопределено) ЭКСПОРТ
	Если НЕ ЗначениеЗаполнено(ОбъектСсылка)
		ИЛИ НЕ ЗначениеЗаполнено(ИмяПараметра) Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	ЗначениеПараметра = ЗначениеПоУмолчанию;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	УниверсальныйРегламентированныйОтчетПараметрыОтчета.Значение КАК Значение
		|ИЗ
		|	Документ.УниверсальныйРегламентированныйОтчет.ПараметрыОтчета КАК УниверсальныйРегламентированныйОтчетПараметрыОтчета
		|ГДЕ
		|	УниверсальныйРегламентированныйОтчетПараметрыОтчета.Ссылка = &Ссылка
		|	И УниверсальныйРегламентированныйОтчетПараметрыОтчета.Код = &Код";
	
	Запрос.УстановитьПараметр("Код", ИмяПараметра);
	Запрос.УстановитьПараметр("Ссылка", ОбъектСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ЗначениеПараметра = ВыборкаДетальныеЗаписи.Значение;
	КонецЕсли;
	
    Возврат ЗначениеПараметра;
КонецФункции

// Функция возвращает таблицу значений, используемую в форматах обмена с ОФК.
// Параметры:
//	- ОбъектСсылка - ссылка на документ "РегистрацияОбязательствИСведенийПоДоговорам", либо массив ссылок;
//	- ИмяТЧ - строка - имя табличной части, служебный реквизит, необходимый для форматов обмена;
//	- ДополнитьДляФормата - булево - признак добавления в таблицу значений служебных колонок.
//
Функция ТаблицаРасшифровкиОбязательства(ОбъектСсылка = Неопределено,Знач ИмяТЧ = Неопределено, ДополнитьДляФормата = Неопределено)    ЭКСПОРТ
	
	Если ИмяТЧ = Неопределено Тогда
		ИмяТЧ = "";
	КонецЕсли;
	
	ИмяТЧ = ВРег(ИмяТЧ);
	Если ДополнитьДляФормата = Неопределено Тогда
		ДополнитьДляФормата = Ложь;
	КонецЕсли;
	
	МассивСсылок = Новый Массив;
	
	Если ТипЗнч(ОбъектСсылка) = Тип("ДокументСсылка.РегистрацияОбязательствИСведенийПоДоговорам") Тогда
		МассивСсылок.Добавить(ОбъектСсылка);
	Иначе
		МассивСсылок = ОбъектСсылка;
	КонецЕсли;

	
	Запрос       = Новый Запрос;
	Запрос.УстановитьПараметр("МассивСсылок", МассивСсылок);
	//Запрос.УстановитьПараметр("ИмяТЧ",  ИмяТЧ);
