Функция ФорматПеречисление(Значение, Разделитель, ВключатьПустые, ФорматнаяСтрока) Экспорт  
	
	ИтоговаяСтрока = "";
	МассивЗначений = СтрРазделить(Значение, Разделитель, ВключатьПустые);
	
	Для к = 0 По МассивЗначений.Количество() - 1 Цикл       
		
		Попытка 
			ЗначениеВМассиве = Число(СтрЗаменить(МассивЗначений[к], "-", "."));
	    Исключение
		    Продолжить
	    КонецПопытки;
		
	    ИтоговаяСтрока = ИтоговаяСтрока + Формат(ЗначениеВМассиве, ФорматнаяСтрока) + ?(к <> МассивЗначений.Количество() - 1, Разделитель, "")	
	КонецЦикла;
	
	Возврат ИтоговаяСтрока;
	
КонецФункции

