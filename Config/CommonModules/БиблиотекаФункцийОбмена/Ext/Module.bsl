		 РезультирующаяТаблица.Колонки.Добавить("ПОЛЕСВЯЗИ");
	 
		 Если ПоФАИП Тогда

			РезультирующаяТаблица.Колонки.Добавить("НомерСтроки_ГЛ", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)));
			РезультирующаяТаблица.Колонки.Добавить("ИмяТабЧасти_ГЛ", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)));
					
		 КонецЕсли;

		 Возврат РезультирующаяТаблица;
		 
	КонецЕсли;
	//*******************************************************
	
	НомСтроки                       = 0;
	
	ПараметрыПечати       			= Новый Структура;
	РезультирующаяТаблица 			= Новый ТаблицаЗначений;
	
	МассивСсылок          			= Новый Массив;
	
	Если ТипЗнч(ОбъектСсылка) = Тип("ДокументСсылка.РегистрацияОбязательствИСведенийПоДоговорам") Тогда
		МассивСсылок.Добавить(ОбъектСсылка);
	Иначе
		МассивСсылок 				= ОбъектСсылка;
		ОбъектСсылка                = МассивСсылок[0];
	КонецЕсли;
	
	Если НомерФормы = "0506101" Тогда
		Если ОбъектСсылка.Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии Тогда
			ДеревоДанныхПоБО           = РаботаСОбязательствами.ПолучитьДанныеДляИнформацииОСглашенияхНаСубсидии(ПараметрыПечати, МассивСсылок);
		Иначе
			ДеревоДанныхПоБО 		   = РаботаСОбязательствами.ПолучитьДанныеДляПечатнойФормы0506101(ПараметрыПечати, МассивСсылок)
		КонецЕсли;
	Иначе	
		Если (ОбъектСсылка.ВидОбязательства = Перечисления.ВидыПринятыхОбязательств.ПринятоеОбязательствоУчетПредмета) Тогда
			//сведения о принятом БО
			ДеревоДанныхПоБО 		    = РаботаСОбязательствами.ПолучитьДанныеДляПечатнойФормы0531702_151н(ПараметрыПечати, МассивСсылок);		
		ИначеЕсли ОбъектСсылка.Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии Тогда
			ДеревоДанныхПоБО            = РаботаСОбязательствами.ПолучитьДанныеДляИнформацииОСглашенияхНаСубсидии(ПараметрыПечати, МассивСсылок);
		Иначе
			//внесение изменений в БО
			ДеревоДанныхПоБО 			= РаботаСОбязательствами.ПолучитьДанныеДляПечатнойФормы0531705_151н(ПараметрыПечати, МассивСсылок);		
		КонецЕсли;
	КонецЕсли;
	
	ДанныеРасшифровкиОбязательства  = ДеревоДанныхПоБО.РасшифровкаОбязательства.Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	СтруктураПоиска                 = Новый Структура("Ссылка", ОбъектСсылка);
    ТаблицаРасшифровкиБОПоСсылке    = ДанныеРасшифровкиОбязательства.Строки.НайтиСтроки(СтруктураПоиска);

	Если ТаблицаРасшифровкиБОПоСсылке.Количество() > 0 Тогда
	
		ТаблицаРасшифровкиОбязательства = ТаблицаРасшифровкиБОПоСсылке[0];
		
		Если (НомерФормы = "0506101") И (ОбъектСсылка.Договор.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии) Тогда
			ТаблицаРасшифровкиОбязательства.Владелец().Колонки["КодЦели"].Имя = "АналитическийКод";
		КонецЕсли;
		
		Для Каждого Колонка Из ТаблицаРасшифровкиОбязательства.Владелец().Колонки Цикл
	        РезультирующаяТаблица.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
		КонецЦикла;
		
	Иначе
		
		РезультирующаяТаблица.Колонки.Добавить("Ссылка");
		
	КонецЕсли;
	
	РезультирующаяТаблица.Колонки.Добавить("НомерПП");
	РезультирующаяТаблица.Колонки.Добавить("НомерСтроки");
	РезультирующаяТаблица.Колонки.Добавить("ИмяТабЧасти",    Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)));
	РезультирующаяТаблица.Колонки.Добавить("ПОЛЕСВЯЗИ");
	
	Если ПоФАИП Тогда
		
		РезультирующаяТаблица.Колонки.Добавить("НомерСтроки_ГЛ", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)));
		РезультирующаяТаблица.Колонки.Добавить("ИмяТабЧасти_ГЛ", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)));
			
	КонецЕсли;
	
	НомерОбъекта = 0;
	
	Пока НомерОбъекта < МассивСсылок.Количество() Цикл
		
		ОбъектСсылка                    = МассивСсылок[НомерОбъекта];
		
		СтруктураПоиска                 = Новый Структура("Ссылка", ОбъектСсылка);
    	ТаблицаРасшифровкиБОПоСсылке    = ДанныеРасшифровкиОбязательства.Строки.НайтиСтроки(СтруктураПоиска);
		
		Если ТаблицаРасшифровкиБОПоСсылке.Количество() = 0 Тогда
			НомерОбъекта                = НомерОбъекта + 1;
			Продолжить;
        КонецЕсли; 
		
		ТаблицаРасшифровкиОбязательства = ТаблицаРасшифровкиБОПоСсылке[0];
		
		НомерПП                         = НомерПП151н[НомерОбъекта].НомерПП;
	
		Для Каждого СтрокаРасшифровкиИтогПоФАИП Из ТаблицаРасшифровкиОбязательства.Строки Цикл
			
			Если (НЕ ПоФАИП И НЕ ЗначениеЗаполнено(СтрокаРасшифровкиИтогПоФАИП.КодФАИП)) 
				ИЛИ (ПоФАИП И Детально) Тогда
				 				
				Для Каждого СтрокаРасшифровки Из СтрокаРасшифровкиИтогПоФАИП.Строки Цикл
				
					НомерПП = НомерПП + 1;
					
					ЗаполнитьЗначенияСвойств(РезультирующаяТаблица.Добавить(), СтрокаРасшифровки);
					
					н                                       = РезультирующаяТаблица.Количество()-1;
					
					РезультирующаяТаблица[н].НомерПП     	= НомерПП;
					РезультирующаяТаблица[н].ИмяТабЧасти 	= ВРег("РасшифровкаОбязательства");
					РезультирующаяТаблица[н].НомерСтроки    = НомерПП;
					РезультирующаяТаблица[н].ПОЛЕСВЯЗИ      = ИСТИНА;
				
				КонецЦикла;	
				
				Продолжить;
				
			КонецЕсли;	
				
			Если ПоФАИП И ЗначениеЗаполнено(СтрокаРасшифровкиИтогПоФАИП.КодФАИП) Тогда
				
				НомСтроки                                    = НомСтроки + 1;
				
				ЗаполнитьЗначенияСвойств(РезультирующаяТаблица.Добавить(), СтрокаРасшифровкиИтогПоФАИП);
				
				н                                            = РезультирующаяТаблица.Количество()-1;
				
				РезультирующаяТаблица[н].ИмяТабЧасти		 = ВРег("ИтоговыеПоказателиПоФАИП");
				РезультирующаяТаблица[н].НомерСтроки       	 = НомСтроки;
				РезультирующаяТаблица[н].ПОЛЕСВЯЗИ           = ИСТИНА;
				
				ПоследняяИтоговаяСтрока                      = н;
				
				Для Каждого СтрокаРасшифровки Из СтрокаРасшифровкиИтогПоФАИП.Строки Цикл
				
					НомерПП                                  = НомерПП + 1;
					
					ЗаполнитьЗначенияСвойств(РезультирующаяТаблица.Добавить(), СтрокаРасшифровки);
					
					н                                        = РезультирующаяТаблица.Количество()-1;
					
					РезультирующаяТаблица[н].НомерПП       	 = НомерПП;
					
					РезультирующаяТаблица[н].ИмяТабЧасти   	 = ВРег("ДетальныеПоказателиПоФАИП");
					РезультирующаяТаблица[н].НомерСтроки     = НомерПП;

					РезультирующаяТаблица[н].ИмяТабЧасти_Гл	 = ВРег("ИтоговыеПоказателиПоФАИП");
					РезультирующаяТаблица[н].НомерСтроки_Гл  = "__"+Строка(НомСтроки);
					
					РезультирующаяТаблица[н].ПОЛЕСВЯЗИ       = ИСТИНА;

				КонецЦикла;	
				
				РезультирующаяТаблица[ПоследняяитоговаяСтрока].НаименованиеОбъектаФАИП = РезультирующаяТаблица[н].НаименованиеОбъектаФАИП; 
				
	        КонецЕсли;
						
		КонецЦикла; 
		
		НомСтроки                                            = 0;  
		НомерПП151н[НомерОбъекта].НомерПП                    = НомерПП;
		НомерОбъекта                                         = НомерОбъекта + 1;
		
	КонецЦикла;
	
	РезультирующаяТаблица.Колонки["Ссылка"].Имя = "ССЫЛКАДОКУМЕНТА";
	
	Возврат РезультирующаяТаблица;

КонецФункции

// Возвращает таблицу с информацией по финансированию бюджета
//
// Параметры:
//	- ОбъектСсылка - ссылка на документ "РегистрацияОбязательствИСведенийПоДоговорам", либо массив ссылок;
//	- ИмяТЧ - строка - имя табличной части, служебный реквизит, необходимый для форматов обмена;
//	- ДополнитьДляФормата - булево - признак добавления в таблицу значений служебных колонок.
//
// Возвращаемое значение:
// 		Тип:  ТаблицаЗначений
//
Функция ТаблицаСредствБюджетаДляГК(Знач ОбъектСсылка = Неопределено,Знач ИмяТЧ = Неопределено, ДополнитьДляФормата = Неопределено)    ЭКСПОРТ
	
	Если ИмяТЧ = Неопределено Тогда
		ИмяТЧ = "";
	КонецЕсли;
	
	ИмяТЧ = ВРег(ИмяТЧ);
	Если ДополнитьДляФормата = Неопределено Тогда
		ДополнитьДляФормата = Ложь;
	КонецЕсли;

	МассивСсылок = Новый Массив;
	
	Если ТипЗнч(ОбъектСсылка) = Тип("ДокументСсылка.РегистрацияОбязательствИСведенийПоДоговорам") Тогда
		МассивСсылок.Добавить(ОбъектСсылка);
	Иначе
		МассивСсылок = ОбъектСсылка;
	КонецЕсли;
	
	Запрос       = Новый Запрос;
	Запрос.УстановитьПараметр("МассивСсылок", 			МассивСсылок);
	Запрос.УстановитьПараметр("КВД", 					Перечисления.КВД.Бюджет);
	Запрос.УстановитьПараметр("ВидКБКРасходы", 			Перечисления.ВидыКБК.КРБ);
	//Запрос.УстановитьПараметр("ИмяТЧ", 				ИмяТЧ);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ГОД(ПланФинансированияОбязательствСрезПоследних.КлючАналитики.ПериодПлана.ДатаОкончания) КАК ГОДФИН,
	               |	ПланФинансированияОбязательствСрезПоследних.КлючАналитики.КЭК.Код КАК КОСГУ,
	               |	ПланФинансированияОбязательствСрезПоследних.Сумма КАК Сумма,
	               |	ПланФинансированияОбязательствСрезПоследних.КлючАналитики.КПС КАК КБК,
	               |	ВЫБОР
	               |		КОГДА ПланФинансированияОбязательствСрезПоследних.КлючАналитики.КПС.ВидПоказателя = &ВидКБКРасходы
	               |			ТОГДА """"
	               |		ИНАЧЕ ""1""
	               |	КОНЕЦ КАК ПРИМЕЧАНИЕ,
	               |	ПланФинансированияОбязательствСрезПоследних.Регистратор КАК ССЫЛКАДОКУМЕНТА
	               |ИЗ
	               |	РегистрСведений.ПланФинансированияОбязательств.СрезПоследних(, Регистратор В (&МассивСсылок)) КАК ПланФинансированияОбязательствСрезПоследних
	               |ГДЕ
	               |	ПланФинансированияОбязательствСрезПоследних.КлючАналитики.КФО = &КВД
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ССЫЛКАДОКУМЕНТА";
	
	РезультирующаяТаблица = Запрос.Выполнить().Выгрузить();

	РезультирующаяТаблица.Колонки.Добавить("Раздел");
	РезультирующаяТаблица.Колонки.Добавить("ПодРаздел");
	РезультирующаяТаблица.Колонки.Добавить("ВидРасхода");
	
	РезультирующаяТаблица.Колонки.Добавить("год1");
	РезультирующаяТаблица.Колонки.Добавить("год2");
	РезультирующаяТаблица.Колонки.Добавить("год3");
	РезультирующаяТаблица.Колонки.Добавить("год4");
	РезультирующаяТаблица.Колонки.Добавить("год5");
	РезультирующаяТаблица.Колонки.Добавить("год6");
	РезультирующаяТаблица.Колонки.Добавить("год7");
	РезультирующаяТаблица.Колонки.Добавить("год8");
	РезультирующаяТаблица.Колонки.Добавить("год9");
	
	Для к  = 0 По РезультирующаяТаблица.Количество() - 1 Цикл
		Строка    = РезультирующаяТаблица[к];
		НомерГода = ОпрделитьНомерГода(ОбъектСсылка, Строка.ГОДФИН);
		
		Если ЗначениеЗаполнено(НомерГода) Тогда
			РезультирующаяТаблица[к]["год" + НомерГода] = Строка.Сумма;
		КонецЕсли;
		
		Если Строка.КБК.ВидКБК = Перечисления.ВидыКБК.КРБ Тогда
			
			РезультирующаяТаблица[к]["Раздел"]     = Лев(Строка.КБК.Классификатор, 4);
			РезультирующаяТаблица[к]["ПодРаздел"]  = Строка.КБК.ЦелеваяСтатья;
			РезультирующаяТаблица[к]["ВидРасхода"] = Строка.КБК.ВидРасхода;
			
		КонецЕсли;
		
	КонецЦикла;
		
	РезультирующаяТаблица.Свернуть("Раздел, Подраздел, ВидРасхода, КОСГУ, ПРИМЕЧАНИЕ, ССЫЛКАДОКУМЕНТА", "год1, год2, год3, год4, год5, год6, год7, год8, год9");
	
	РезультирующаяТаблица.Сортировать("ССЫЛКАДОКУМЕНТА");
	
	Если ДополнитьДляФормата Тогда
		РезультирующаяТаблица.Колонки.Добавить("НомерСтроки");
		РезультирующаяТаблица.Колонки.Добавить("ИмяТабЧасти");
		РезультирующаяТаблица.Колонки.Добавить("ПОЛЕСВЯЗИ");
		ПредДок = Неопределено;
		ПорядковыйНомер = 1;
		Для Каждого СтрТЧ Из РезультирующаяТаблица Цикл
			Если СтрТЧ.ССЫЛКАДОКУМЕНТА <> ПредДок Тогда 
				ПорядковыйНомер = 1;
				ПредДок = СтрТЧ.ССЫЛКАДОКУМЕНТА;
			КонецЕсли;
			СтрТЧ.НомерСтроки = ПорядковыйНомер;
			СтрТЧ.ИмяТабЧасти = ИмяТЧ;
			СтрТЧ.ПОЛЕСВЯЗИ   = Истина;
			//РезультирующаяТаблица[Инд].ССЫЛКАДОКУМЕНТА = ОбъектСсылка;
			ПорядковыйНомер = ПорядковыйНомер + 1;
		КонецЦикла;		
	КонецЕсли;
	
	Возврат РезультирующаяТаблица;
	
КонецФункции

// Возвращает таблицу с информацией по финансированию внебюджета
//
// Параметры:
//	- ОбъектСсылка - ссылка на документ "РегистрацияОбязательствИСведенийПоДоговорам", либо массив ссылок;
//	- ИмяТЧ - строка - имя табличной части, служебный реквизит, необходимый для форматов обмена;
//	- ДополнитьДляФормата - булево - признак добавления в таблицу значений служебных колонок.
//
// Возвращаемое значение:
// 		Тип: ТаблицаЗначений
//
Функция ТаблицаСредствВнебюджетаДляГК(Знач ОбъектСсылка = Неопределено,Знач ИмяТЧ = Неопределено, ДополнитьДляФормата = Неопределено)    ЭКСПОРТ
	
	Если ИмяТЧ = Неопределено Тогда
		ИмяТЧ = "";
	КонецЕсли;
	
	ИмяТЧ = ВРег(ИмяТЧ);
	Если ДополнитьДляФормата = Неопределено Тогда
		ДополнитьДляФормата = Ложь;
	КонецЕсли;
	
	МассивСсылок = Новый Массив;
	
	Если ТипЗнч(ОбъектСсылка) = Тип("ДокументСсылка.РегистрацияОбязательствИСведенийПоДоговорам") Тогда
		МассивСсылок.Добавить(ОбъектСсылка);
	Иначе
		МассивСсылок = ОбъектСсылка;
	КонецЕсли;
	
	Запрос       = Новый Запрос;
	Запрос.УстановитьПараметр("МассивСсылок", 			МассивСсылок);
	Запрос.УстановитьПараметр("КВД", 					Перечисления.КВД.Внебюджет);
	Запрос.УстановитьПараметр("ВидКБКРасходы", 			Перечисления.ВидыКБК.КРБ);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ГОД(ПланФинансированияОбязательствСрезПоследних.КлючАналитики.ПериодПлана.ДатаОкончания) КАК ГОДФИН,
	               |	ПланФинансированияОбязательствСрезПоследних.КлючАналитики.КЭК.Код КАК КОСГУ,
	               |	ПланФинансированияОбязательствСрезПоследних.Сумма КАК Сумма,
	               |	ВЫБОР
	               |		КОГДА ПланФинансированияОбязательствСрезПоследних.КлючАналитики.КПС.ВидПоказателя = &ВидКБКРасходы
	               |			ТОГДА """"
	               |		ИНАЧЕ ""1""
	               |	КОНЕЦ КАК ПРИМЕЧАНИЕ,
	               |	ПланФинансированияОбязательствСрезПоследних.Регистратор КАК ССЫЛКАДОКУМЕНТА
	               |ИЗ
	               |	РегистрСведений.ПланФинансированияОбязательств.СрезПоследних(, Регистратор В (&МассивСсылок)) КАК ПланФинансированияОбязательствСрезПоследних
	               |ГДЕ
	               |	ПланФинансированияОбязательствСрезПоследних.КлючАналитики.КФО = &КВД
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ССЫЛКАДОКУМЕНТА";
	
	РезультирующаяТаблица = Запрос.Выполнить().Выгрузить();

	РезультирующаяТаблица.Колонки.Добавить("год1");
	РезультирующаяТаблица.Колонки.Добавить("год2");
	РезультирующаяТаблица.Колонки.Добавить("год3");
	РезультирующаяТаблица.Колонки.Добавить("год4");
	РезультирующаяТаблица.Колонки.Добавить("год5");
	РезультирующаяТаблица.Колонки.Добавить("год6");
	РезультирующаяТаблица.Колонки.Добавить("год7");
	РезультирующаяТаблица.Колонки.Добавить("год8");
	РезультирующаяТаблица.Колонки.Добавить("год9");
	
	Для к  = 0 По РезультирующаяТаблица.Количество() - 1 Цикл
		Строка    = РезультирующаяТаблица[к];
		НомерГода = ОпрделитьНомерГода(ОбъектСсылка, Строка.ГОДФИН);
		
		Если ЗначениеЗаполнено(НомерГода) Тогда
			РезультирующаяТаблица[к]["год" + НомерГода] = Строка.Сумма;
		КонецЕсли;
		
	КонецЦикла;
	
	РезультирующаяТаблица.Свернуть("КОСГУ, ПРИМЕЧАНИЕ, ССЫЛКАДОКУМЕНТА", "год1, год2, год3, год4, год5, год6, год7, год8, год9");
	
	РезультирующаяТаблица.Сортировать("ССЫЛКАДОКУМЕНТА");
	
	Если ДополнитьДляФормата Тогда
		РезультирующаяТаблица.Колонки.Добавить("НомерСтроки");
		РезультирующаяТаблица.Колонки.Добавить("ИмяТабЧасти");
		РезультирующаяТаблица.Колонки.Добавить("ПОЛЕСВЯЗИ");
		//РезультирующаяТаблица.Колонки.Добавить("ССЫЛКАДОКУМЕНТА");
		ПредДок = Неопределено;
		ПорядковыйНомер = 1;
		Для Каждого СтрТЧ Из РезультирующаяТаблица Цикл
			Если СтрТЧ.ССЫЛКАДОКУМЕНТА <> ПредДок Тогда 
				ПорядковыйНомер = 1;
				ПредДок = СтрТЧ.ССЫЛКАДОКУМЕНТА;
			КонецЕсли;
			СтрТЧ.НомерСтроки = ПорядковыйНомер;
			СтрТЧ.ИмяТабЧасти = ИмяТЧ;
			СтрТЧ.ПОЛЕСВЯЗИ   = Истина;
			//РезультирующаяТаблица[Инд].ССЫЛКАДОКУМЕНТА = ОбъектСсылка;
			ПорядковыйНомер = ПорядковыйНомер + 1;
		КонецЦикла;		
	КонецЕсли;
	
	Возврат РезультирующаяТаблица;
	
КонецФункции

// Возвращает таблицу с информацией о предмете контракта
//
// Параметры:
//	- ОбъектСсылка - ссылка на документ "РегистрацияОбязательствИСведенийПоДоговорам", либо массив ссылок;
//	- ИмяТЧ - строка - имя табличной части, служебный реквизит, необходимый для форматов обмена;
//	- ДополнитьДляФормата - булево - признак добавления в таблицу значений служебных колонок.
//
// Возвращаемое значение:
// 		Тип: ТаблицаЗначений
//
Функция ТаблицаСредствПредметКонтракта(ОбъектСсылка = Неопределено,Знач ИмяТЧ = Неопределено, ДополнитьДляФормата = Неопределено)    ЭКСПОРТ
	
	Если ИмяТЧ = Неопределено Тогда
		ИмяТЧ = "";
	КонецЕсли;
	
	ИмяТЧ = ВРег(ИмяТЧ);
	Если ДополнитьДляФормата = Неопределено Тогда
		ДополнитьДляФормата = Ложь;
	КонецЕсли;
	
	МассивСсылок = Новый Массив;
	
	Если ТипЗнч(ОбъектСсылка) = Тип("ДокументСсылка.РегистрацияОбязательствИСведенийПоДоговорам") Тогда
		МассивСсылок.Добавить(ОбъектСсылка);
	Иначе
		МассивСсылок = ОбъектСсылка;
	КонецЕсли;
	
	Запрос       = Новый Запрос;
	Запрос.УстановитьПараметр("МассивСсылок", 	МассивСсылок);
	
	ОграничениеПоДате = Ложь;
	
	МаскимальныйГод   = ГодФинансированияКонтракта(ОбъектСсылка , 9);
	
	Если ЗначениеЗаполнено(МаскимальныйГод) Тогда
		ОграничениеПоДате      = Истина;
		МаксСрокФинансирования = Дата(Число("20" + (Число(МаскимальныйГод) + 1)), 1, 1);
		
		Запрос.УстановитьПараметр("МаксСрокФинансирования", 				МаксСрокФинансирования);
	КонецЕсли;
	ДополнениеЗапроса = "";
	ДополнениеСвертки = "";
	Если ДополнитьДляФормата Тогда
		ДополнениеЗапроса = "ПланФинансированияОбязательствСрезПоследних.КлючАналитики.ЕдиницаИзмерения КАК ЕдиницаИзмерения,";
	    ДополнениеСвертки = ",ЕдиницаИзмерения"
	КонецЕсли;
	
	Запрос.Текст = "
	|ВЫБРАТЬ 
	|	ПланФинансированияОбязательствСрезПоследних.Регистратор									КАК ССЫЛКАДОКУМЕНТА
	|	ВЫБОР
	|		КОГДА ПланФинансированияОбязательствСрезПоследних.КлючАналитики.Номенклатура.НаименованиеПолное = """"
	|			ТОГДА ПланФинансированияОбязательствСрезПоследних.КлючАналитики.Номенклатура.Наименование
	|		ИНАЧЕ ПланФинансированияОбязательствСрезПоследних.КлючАналитики.Номенклатура.НаименованиеПолное
	|	КОНЕЦ 																					КАК Номенклатура,
	|	"+ДополнениеЗапроса+"
	|	ПланФинансированияОбязательствСрезПоследних.КлючАналитики.ЕдиницаИзмерения.Наименование КАК ЕДИЗМ,
	|	ПланФинансированияОбязательствСрезПоследних.ОКП 										КАК ОКП,
	|	ПланФинансированияОбязательствСрезПоследних.Количество									КАК Количество,
	|	ПланФинансированияОбязательствСрезПоследних.Сумма										КАК Сумма
	|ИЗ
	|	РегистрСведений.ПланФинансированияОбязательств.СрезПоследних(, Регистратор В (&МассивСсылок)) 	КАК ПланФинансированияОбязательствСрезПоследних
	|";
	
	Если ОграничениеПоДате Тогда
		Запрос.Текст = Запрос.Текст  + "
		|ГДЕ
		|	ПланФинансированияОбязательствСрезПоследних.ПериодПлана.ДатаОкончания < &МаксСрокФинансирования
		|";
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст  + "
		|УПОРЯДОЧИТЬ ПО
	    |	ССЫЛКАДОКУМЕНТА";
	
	
	РезультирующаяТаблица = Запрос.Выполнить().Выгрузить();
	
	РезультирующаяТаблица.Свернуть("Номенклатура, ЕДИЗМ, ОКП, ССЫЛКАДОКУМЕНТА"+ДополнениеСвертки, "Количество, Сумма");
	
	РезультирующаяТаблица.Сортировать("ССЫЛКАДОКУМЕНТА");
	
	Если ДополнитьДляФормата Тогда
		РезультирующаяТаблица.Колонки.Добавить("НомерСтроки");
		РезультирующаяТаблица.Колонки.Добавить("ИмяТабЧасти");
		РезультирующаяТаблица.Колонки.Добавить("ПОЛЕСВЯЗИ");
		//РезультирующаяТаблица.Колонки.Добавить("ССЫЛКАДОКУМЕНТА");
		ПредДок = Неопределено;
		ПорядковыйНомер = 1;
		Для Каждого СтрТЧ Из РезультирующаяТаблица Цикл
			Если СтрТЧ.ССЫЛКАДОКУМЕНТА <> ПредДок Тогда 
				ПорядковыйНомер = 1;
				ПредДок = СтрТЧ.ССЫЛКАДОКУМЕНТА;
			КонецЕсли;
			СтрТЧ.НомерСтроки = ПорядковыйНомер;
			СтрТЧ.ИмяТабЧасти = ИмяТЧ;
			СтрТЧ.ПОЛЕСВЯЗИ   = Истина;
			//РезультирующаяТаблица[Инд].ССЫЛКАДОКУМЕНТА = ОбъектСсылка;
			ПорядковыйНомер = ПорядковыйНомер + 1;
		КонецЦикла;		
	КонецЕсли;
	
	Возврат РезультирующаяТаблица;
	
КонецФункции

