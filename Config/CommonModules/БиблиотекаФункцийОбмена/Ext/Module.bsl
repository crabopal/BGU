			РезультирующаяТаблица[н].НомерСтроки       	 = НомСтроки;
			РезультирующаяТаблица[н].ПОЛЕСВЯЗИ           = ИСТИНА;   
			
			ДетализацияПоКартам = Новый ТаблицаЗначений;
			
			Если ИспользоватьДопКл И НЕ ИспользоватьКодМероприятия Тогда
				ДетализацияПоКартам = ТаблицаРаспоряжения.ДетализированныеВыплаты.Скопировать(Новый Структура("Ссылка, КодБК, КодЦели, КЭК, КФО, ДопКлассификация", 
