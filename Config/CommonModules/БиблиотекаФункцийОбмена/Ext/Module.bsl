Процедура ПолучитьТаблицуРаскрытия(ДокументОбъект, ТаблицаРаскрытия, НаименованиеГрафы)
	
	ГруппаРаскрытия      = Справочники.ГруппыРаскрытия.НайтиПоКоду(НаименованиеГрафы, , , ДокументОбъект.ВидОтчета); // получили ссылку на группу раскрытия по владельцу
	ТаблицаРаскрытияВып  = ДокументОбъект.ПолучитьТаблицуРаскрытия(ГруппаРаскрытия); // Все строки таблицы	
		
	Для каждого Колонка Из ТаблицаРаскрытияВып.Колонки Цикл
		
		Если Найти(Колонка.Имя, Прав(НаименованиеГрафы, 3)) <> Неопределено Тогда
			 Колонка.Имя = СтрЗаменить(Колонка.Имя, Прав(НаименованиеГрафы, 3), "100")
		КонецЕсли;
	
	КонецЦикла;
	
	Для каждого СтрокаВып Из ТаблицаРаскрытияВып Цикл
		Строка = ТаблицаРаскрытия.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, СтрокаВып);
		Строка.стр100_гр9      = "";
		Строка.ИмяГруппировки  = "101";
	КонецЦикла;		
		
КонецПроцедуры

