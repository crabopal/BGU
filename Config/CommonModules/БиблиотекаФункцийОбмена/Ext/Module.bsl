// Новые процедуры и функции для БГУ2

// Получает значение уровня бюджета из номера лицевого счета
//
// Параметры:
// 		Объект (Тип: Строка) - строковое представление номера лицевого счета, 
//		      или ДокументСсылка из которого необходимо вычислить уровень бюджета
// Возвращаемое значение:
// 		Тип: Строка - номер, обозначающий уровень бюджета
// 		Уровень бюджета принимает следующие значения:
// 1 - «федеральный бюджет», 
// 2 - «бюджет субъекта Российской Федерации», 
// 3 - «местный бюджет», 
// 4 - «бюджет Государственного внебюджетного фонда», 
// 5 - «бюджет территориального государственного внебюджетного фонда)»,
// 6 - «средства юридического лица (его обособленного подразделения), не 
//     являющегося в соответствии с Бюджетным кодексом Российской Федерации 
//     получателем средств федерального бюджета, кассовое обслуживание которого 
//     осуществляется органами Федерального казначейства в случаях, установленных 
//     законодательством Российской Федерации, а также средства бюджетного 
//     учреждения (автономного учреждения)».
//
Функция УровеньБюджета(Объект)     ЭКСПОРТ
	
	Если  ТипЗнч(Объект) = Тип("Строка") Тогда
		Возврат Сред(Строка(Объект), 5, 1);
	КонецЕсли;
	
	Если Документы.ТипВсеСсылки().СодержитТИп(ТипЗнч(Объект)) Тогда //это документ
		
		ЗапросТекстШапка  = "ВЫБРАТЬ";
		ЗапросТекстПодвал = " ";
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ИФО", Объект.Метаданные()) 
			И ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
			ЗапросТекстШапка  = ЗапросТекстШапка +"
			|	ВЫБОР
			|		КОГДА Объект.ИФО.ИспользоватьРеквизитыИФО
			|			ТОГДА Объект.ИФО.Бюджет.Элемент.Код
			|				ИНАЧЕ "; 
			
			ЗапросТекстПодвал = " КОНЕЦ "
		КонецЕсли;
		  
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ЛицевойСчет", Объект.Метаданные()) Тогда
			ЗапросТекстШапка  = ЗапросТекстШапка +"
			|	Объект.ЛицевойСчет.Владелец.Бюджет.Элемент.Код";
		ИначеЕсли ОбщегоНазначения.ЕстьРеквизитОбъекта("Организация", Объект.Метаданные()) Тогда	 
			ЗапросТекстШапка  = ЗапросТекстШапка +"
			|	Объект.Организация.Бюджет.Элемент.Код ";
		Иначе	
            ЗапросТекстШапка  = ЗапросТекстШапка +"
			|	""00""";
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = ЗапросТекстШапка + ЗапросТекстПодвал + "КАК ЭлементБюджета
		|ИЗ
		|	Документ." + Объект.Метаданные().Имя + " КАК Объект
		|ГДЕ
		|	Объект.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", Объект);
		
		Попытка 
			Выборка = Запрос.Выполнить().Выбрать();
		Исключение
			Возврат "0";
		КонецПопытки;	
		
		Если Выборка.Следующий() Тогда
			
			Если НЕ ЗначениеЗаполнено(Выборка.ЭлементБюджета) Тогда
				Возврат "6";
			КонецЕсли;
			
			Если Выборка.ЭлементБюджета = "01" Тогда
				Возврат "1";
			ИначеЕсли Выборка.ЭлементБюджета = "02" Тогда
				Возврат "2";
	        ИначеЕсли Найти("03, 04, 05, 10", Выборка.ЭлементБюджета) > 0 Тогда
				Возврат "3";
			ИначеЕсли Выборка.ЭлементБюджета = "09" Тогда
				Возврат "5";
			ИначеЕсли Найти("06, 07, 08", Выборка.ЭлементБюджета) > 0 Тогда
				Возврат "4";
	        Иначе
				Возврат "6";    //- «средства юридического лица, а также средства бюджетного учреждения (автономного учреждения)».
			КонецЕсли;	
		Иначе
			Возврат "0";
		КонецЕсли;	
		
	КонецЕсли;
КонецФункции

// Получает наменование бюджета
//
// Параметры:
// 		Объект (Тип: ДокументСсылка) 
// Возвращаемое значение:
// 		Тип: Строка - Наименование бюджета, определяемое 
//                    по правилам для вывода в печатой форме.
//     
Функция НаименованиеБюджета(Объект) ЭКСПОРТ
	
	Если Документы.ТипВсеСсылки().СодержитТИп(ТипЗнч(Объект)) Тогда //это документ
		
		ЗапросТекстШапка  = "ВЫБРАТЬ";
		ЗапросТекстПодвал = " ";
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ЛицевойСчет", Объект.Метаданные()) Тогда
			ЗапросТекстШапка  = ЗапросТекстШапка +"
			|	ВЫБОР
			|		КОГДА Объект.ЛицевойСчет.НеВыводитьНаименованиеБюджета
			|       	ТОГДА """"
			|       ИНАЧЕ "; 
			
			ЗапросТекстПодвал = "
			|	Объект.ЛицевойСчет.Владелец.Бюджет.НаименованиеПолное
			|	КОНЕЦ "
		КонецЕсли;
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Баланс", Объект.Метаданные()) Тогда
			ЗапросТекстШапка  = ЗапросТекстШапка +"
			|	ВЫБОР
			|		КОГДА Объект.Баланс.ИспользоватьРеквизитыИФО
			|			ТОГДА Объект.Баланс.Бюджет.НаименованиеПолное
			|				ИНАЧЕ "; 
			
			ЗапросТекстПодвал = ЗапросТекстПодвал + "
			| 	КОНЕЦ "
		КонецЕсли;
		
		Если НЕ ОбщегоНазначения.ЕстьРеквизитОбъекта("ЛицевойСчет", Объект.Метаданные())
			И ОбщегоНазначения.ЕстьРеквизитОбъекта("Организация", Объект.Метаданные()) Тогда	 
			ЗапросТекстШапка  = ЗапросТекстШапка +"
			|	Объект.Организация.Бюджет.НаименованиеПолное ";
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = ЗапросТекстШапка + ЗапросТекстПодвал + " КАК НаименованиеБюджета
		|ИЗ
		|	Документ." + Объект.Метаданные().Имя + " КАК Объект
		|ГДЕ
		|	Объект.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", Объект);
		
		Попытка 
			Выборка = Запрос.Выполнить().Выбрать();
		Исключение
			Возврат "";
		КонецПопытки;	
		
		Если Выборка.Следующий() Тогда
			Возврат Выборка.НаименованиеБюджета
		Иначе
			Возврат "";
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции

//Получает наименование и ОКПО финансового органа
//
// Параметры:
// 		Объект   (Тип: ДокументСсылка),
//      Реквизит (Тип: Строка: "Наименование" или "КодОКПО"),
// Возвращаемое значение:
// 		Тип: Строка - Наименование Финансового органа или ОКПО, определяемое 
//                    по правилам для вывода в печатой форме.
//     
Функция РеквизитыФинансовогоОргана(Объект, Реквизит) Экспорт
	
	Если Документы.ТипВсеСсылки().СодержитТИп(ТипЗнч(Объект)) Тогда //это документ
		
		ЗапросТекстШапка  = "ВЫБРАТЬ";
		ЗапросТекстПодвал = " ";
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ЛицевойСчет", Объект.Метаданные()) Тогда
			ЗапросТекстПодвал = "
			|	Объект.ЛицевойСчет.Владелец.Бюджет." + Реквизит  + "ФинансовогоОргана  КАК Результат
			|	"
		КонецЕсли;
		
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта("Баланс", Объект.Метаданные()) Тогда
			ЗапросТекстШапка  = ЗапросТекстШапка +"
			|	ВЫБОР
			|		КОГДА Объект.Баланс.ИспользоватьРеквизитыИФО
			|			ТОГДА Объект.Баланс.Бюджет." + Реквизит  + "ФинансовогоОргана  КАК Результат
			|				ИНАЧЕ 
			| 	    КОНЕЦ "; 
			
		КонецЕсли;
		
		Если НЕ ОбщегоНазначения.ЕстьРеквизитОбъекта("ЛицевойСчет", Объект.Метаданные())
			И ОбщегоНазначения.ЕстьРеквизитОбъекта("Организация", Объект.Метаданные()) Тогда	 
			ЗапросТекстШапка  = ЗапросТекстШапка +"
			|	Объект.Организация.Бюджет." + Реквизит  + "ФинансовогоОргана КАК Результат";
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = ЗапросТекстШапка + ЗапросТекстПодвал + " 
		|ИЗ
		|	Документ." + Объект.Метаданные().Имя + " КАК Объект
		|ГДЕ
		|	Объект.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", Объект);
		
		Попытка 
			Выборка = Запрос.Выполнить().Выбрать();
		Исключение
			Возврат "";
		КонецПопытки;	
		
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Результат
		Иначе
			Возврат "";
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции

//получает реквизит шапки обязательства (печатная форма 0506101)
Функция ПолучитьРеквизитШапкиОбязательства(ОбъектСсылка, Реквизит, НомерФормы) Экспорт
	
	МассивСсылок          			 = Новый Массив;
	ПараметрыПечати       			 = Новый Структура;
	Результат                        = "";
	
	Если ТипЗнч(ОбъектСсылка) = Тип("ДокументСсылка.РегистрацияОбязательствИСведенийПоДоговорам") Тогда
		МассивСсылок.Добавить(ОбъектСсылка);
	Иначе
		МассивСсылок 				 = ОбъектСсылка;
		ОбъектСсылка                 = МассивСсылок[0];
	КонецЕсли;
	
    Если НомерФормы = "0506101" Тогда
		ДеревоДанныхПоБО 		     = РаботаСОбязательствами.ПолучитьДанныеДляПечатнойФормы0506101(ПараметрыПечати, МассивСсылок);	
		Результат                    = ДеревоДанныхПоБО.РезультатПоШапке.Выгрузить()[0][Реквизит];
	КонецЕсли;   
	
	Если НомерФормы = "ГК_17н2026" Тогда
		ДеревоДанныхПоБО 		     = РаботаСОбязательствами.ПолучитьДанныеДляПечатнойФормыСведенияГК_17н2026(ПараметрыПечати, МассивСсылок);	
		Результат                    = ДеревоДанныхПоБО.РезультатПоШапке.Выгрузить()[0][Реквизит];
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Получает реквизит шапки платежно-расчетного документа, к которому нельзя обратиться напрямую
Функция ПолучитьРеквизитШапкиПРДокумента(Объект, Реквизит) Экспорт
		
	Возврат БиблиотекаФункцийОбменаПовтИсп.ПолучитьРеквизитыПРДокумента(Объект)[Реквизит];	

КонецФункции // ПолучитьРеквизитШапкиРасчетноПлатежногоДокумента(Объект, Реквизит)()

// Получает реквизит табличной части платежно-расчетного документа, к которому нельзя обратиться напрямую
Функция ПолучитьРеквизитТабЧастиПРДокумента(Объект, ИмяТЧ, НомерСтроки, Реквизит) Экспорт
	
	Если (НомерСтроки <> 0) И НЕ ЗначениеЗаполнено(НомерСтроки) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат БиблиотекаФункцийОбменаПовтИсп.ПолучитьРеквизитыПРДокумента(Объект)[ИмяТЧ][НомерСтроки][Реквизит];	

КонецФункции // ПолучитьРеквизитШапкиРасчетноПлатежногоДокумента(Объект, Реквизит)()

// Получает реквизит договора, к которому нельзя обратиться напрямую
Функция ПолучитьХарактеристикиОбязательства(Ссылка, Реквизит) Экспорт
	
	Если БиблиотекаФункцийОбменаПовтИсп.ПолучитьХарактеристикиОбязательства(Ссылка).Свойство(Реквизит) Тогда 
		Возврат БиблиотекаФункцийОбменаПовтИсп.ПолучитьХарактеристикиОбязательства(Ссылка)[Реквизит]
	Иначе
		Возврат ""
	КонецЕсли;
	
КонецФункции

