	Иначе
		МассивСсылок 				= ОбъектСсылка;
		ОбъектСсылка                = МассивСсылок[0];
	КонецЕсли;
	
	ДанныеДляПечати                 = РаботаСОбязательствами.ПолучитьДанныеДляПечатнойФормыСведенияОПрекращении18н(ПараметрыПечати, МассивСсылок);
	
	ТаблицаИсполнения     			= ДанныеДляПечати.Исполнение.Выгрузить();
	ТаблицаОплаты 		    		= ДанныеДляПечати.Оплата.Выгрузить();
	
	МаксСтрок                       = Макс(ТаблицаИсполнения.Количество(), ТаблицаОплаты.Количество());
	
	Если ОбъектСсылка.ЭтоРасторжение ИЛИ (ТаблицаИсполнения.Количество() = 0) Тогда
		
		 Возврат РезультирующаяТаблица;
		
	КонецЕсли;
	 
	НомерСтроки                     = 0; 
	НомерПоследнегоИсполнения       = 0;
	СсылкаНаДокумент                = "";
	НачатьСИндОпл                   = 0;
			
	Для Инд = 0 По ТаблицаИсполнения.Количество() - 1 Цикл
				
		 ЗаполнитьЗначенияСвойств(РезультирующаяТаблица.Добавить(), ТаблицаИсполнения[Инд]);
		 
		 н       = РезультирующаяТаблица.Количество()-1;
				
		 РезультирующаяТаблица[н].НомерПП     	   = Инд + 1;
		 РезультирующаяТаблица[н].ИмяТабЧасти 	   = ВРег("Исполнение");
		 РезультирующаяТаблица[н].НомерСтроки      = Инд + 1;
		 РезультирующаяТаблица[н].ПОЛЕСВЯЗИ        = ИСТИНА;
		 РезультирующаяТаблица[н].ССЫЛКАДОКУМЕНТА  = ТаблицаИсполнения[Инд].Ссылка;  
		 
		 НомерПоследнегоИсполнения                 = НомерПоследнегоИсполнения + 1;
						 		 
		 
		 Для ИндОпл = НачатьСИндОпл По ТаблицаОплаты.Количество() - 1 Цикл
			 
			 Если ТаблицаИсполнения[Инд].Ссылка <> ТаблицаОплаты[ИндОпл].Ссылка  Тогда
				  Продолжить;
			 КонецЕсли;
			 
			 ЗаполнитьЗначенияСвойств(РезультирующаяТаблица.Добавить(), ТаблицаОплаты[ИндОпл]);
			 
			  Если  СсылкаНаДокумент <> ТаблицаОплаты[ИндОпл].Ссылка Тогда
				//для нового документа новая нумерация строк 
			 	НомерПоследнегоИсполнения              = 1;
				СсылкаНаДокумент                       = ТаблицаОплаты[ИндОпл].Ссылка;
				НомерСтроки                            = 0;
				
			 КонецЕсли;
			 
			 НомерСтроки                               = НомерСтроки + 1;
			 
			 н                                         = РезультирующаяТаблица.Количество()-1;
					
			 РезультирующаяТаблица[н].НомерПП          = НомерСтроки;
			
			 РезультирующаяТаблица[н].ИмяТабЧасти      = ВРег("Оплата");
			 РезультирующаяТаблица[н].НомерСтроки      = НомерСтроки;

			 РезультирующаяТаблица[н].ИмяТабЧасти_Гл	 = ВРег("Исполнение");
			 РезультирующаяТаблица[н].НомерСтроки_Гл   = "__"+Строка(НомерПоследнегоИсполнения);
			
			 РезультирующаяТаблица[н].ПОЛЕСВЯЗИ        = ИСТИНА;
			 РезультирующаяТаблица[н].ССЫЛКАДОКУМЕНТА  = ТаблицаОплаты[ИндОпл].Ссылка;
			 
			 НачатьСИндОпл = ИндОпл + 1;
			 
			 Если Инд < (ТаблицаИсполнения.Количество() - 1) И ТаблицаИсполнения[Инд+1].Ссылка = ТаблицаОплаты[ИндОпл].Ссылка Тогда
				 Прервать;
			 КонецЕсли;
		 
         КонецЦикла; 		 
		
	КонецЦикла;
	
	Возврат РезультирующаяТаблица; 
		
КонецФункции

// Функция возвращает таблицу значений, используемую в форматах обмена с ОФК.
Функция ТаблицаКодовЗаявления(знач ОбъектСсылка, ВидБК, ИмяТЧ) Экспорт
	
	РезультирующаяТаблица = Новый ТаблицаЗначений;	
		
	// формируем пустую таблицу для построения формата в СКД
	Если (НЕ ЗначениеЗаполнено(ОбъектСсылка)) И (НЕ ЗначениеЗаполнено(ВидБК)) Тогда
				 
		 РезультирующаяТаблица.Колонки.Добавить("НомерСтроки");
		 
		 РезультирующаяТаблица.Колонки.Добавить("Глава");
         РезультирующаяТаблица.Колонки.Добавить("КодБК");
		 РезультирующаяТаблица.Колонки.Добавить("Сумма");
        		 
		 РезультирующаяТаблица.Колонки.Добавить("ССЫЛКАДОКУМЕНТА");
		 
		 РезультирующаяТаблица.Колонки.Добавить("НомерПП");
	     РезультирующаяТаблица.Колонки.Добавить("ИмяТабЧасти",       Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)));
	     РезультирующаяТаблица.Колонки.Добавить("ПОЛЕСВЯЗИ");
		 		 
		 Возврат РезультирующаяТаблица;
		 
	КонецЕсли;	
	 
	Запрос = Новый Запрос;
	
	МассивСсылок          			= Новый Массив;
	
	Если ТипЗнч(ОбъектСсылка) = Тип("ДокументСсылка.ЗаявлениеНаПроведениеОперацийСИностраннойВалютой") Тогда
		МассивСсылок.Добавить(ОбъектСсылка);
	Иначе
		МассивСсылок 				= ОбъектСсылка;
		ОбъектСсылка                = МассивСсылок[0];
	КонецЕсли;	
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивСсылок);
	Запрос.УстановитьПараметр("ВидБК",          ВидБК);	
	Запрос.УстановитьПараметр("ИмяТЧ",          ИмяТЧ);

	Запрос.Текст =
	
	"ВЫБРАТЬ
	|	ЗаявлениеРасшифровкаПлатежа.Ссылка КАК СсылкаДокумента,
	|	ЗаявлениеРасшифровкаПлатежа.НомерСтроки КАК НомерСтроки,
	|	ЗаявлениеРасшифровкаПлатежа.НомерСтроки КАК НомерПП,
	|	ЗаявлениеРасшифровкаПлатежа.КБКНазначениеПлатежа.Код КАК КодБК,
	|	ВЫБОР
	|		КОГДА ЗаявлениеРасшифровкаПлатежа.Ссылка.ЛицевойСчет.НеВыводитьКодГлавы
	|			ТОГДА """"
	|		ИНАЧЕ ЗаявлениеРасшифровкаПлатежа.Ссылка.ЛицевойСчет.Владелец.КодПоППП.Код
	|	КОНЕЦ КАК Глава,
	|	ИСТИНА КАК ПолеСвязи,
	|   &ИмяТЧ КАК ИмяТабЧасти, 
	|	ЗаявлениеРасшифровкаПлатежа.Сумма КАК Сумма
	|ИЗ
	|	Документ.ЗаявлениеНаПроведениеОперацийСИностраннойВалютой.РасшифровкаПлатежа КАК ЗаявлениеРасшифровкаПлатежа
	|ГДЕ
	|	ЗаявлениеРасшифровкаПлатежа.Ссылка В(&МассивОбъектов) И
	|   ЗаявлениеРасшифровкаПлатежа.КБКНазначениеПлатежа.ВидПоказателя = &ВидБК
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки ";
	
    РезультирующаяТаблица = Запрос.Выполнить().Выгрузить();	 
		
	Возврат РезультирующаяТаблица; 
	
КонецФункции

// Функция возвращает таблицу значений, используемую в форматах обмена с ОФК.
Функция ТаблицаРасшифровкиПодтвержденияДО(знач ОбъектСсылка) Экспорт
	
    РезультирующаяТаблица = Новый ТаблицаЗначений;	
		
	// формируем пустую таблицу для построения формата в СКД
	Если НЕ ЗначениеЗаполнено(ОбъектСсылка) Тогда
				 
		 РезультирующаяТаблица.Колонки.Добавить("НомерСтроки");
		 РезультирующаяТаблица.Колонки.Добавить("КодФАИП");
         РезультирующаяТаблица.Колонки.Добавить("ВидСредств");
		 РезультирующаяТаблица.Колонки.Добавить("КодБК");
         РезультирующаяТаблица.Колонки.Добавить("АналитическийКод");
         РезультирующаяТаблица.Колонки.Добавить("СуммаВал");
         РезультирующаяТаблица.Колонки.Добавить("КодВал");
		 РезультирующаяТаблица.Колонки.Добавить("СуммаРуб");
		 РезультирующаяТаблица.Колонки.Добавить("СуммаАванс");
		 
		 РезультирующаяТаблица.Колонки.Добавить("ССЫЛКАДОКУМЕНТА");
		 
		 РезультирующаяТаблица.Колонки.Добавить("НомерПП");
	     РезультирующаяТаблица.Колонки.Добавить("ИмяТабЧасти",       Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)));
	     РезультирующаяТаблица.Колонки.Добавить("ПОЛЕСВЯЗИ");
		 		 
		 Возврат РезультирующаяТаблица;
		 
	КонецЕсли;	
	
	НомСтроки                       = 0;	
	МассивСсылок          			= Новый Массив;
	
	Если ТипЗнч(ОбъектСсылка) = Тип("ДокументСсылка.СведенияОДенежномОбязательстве") Тогда
		МассивСсылок.Добавить(ОбъектСсылка);
	Иначе
		МассивСсылок 				= ОбъектСсылка;
		ОбъектСсылка                = МассивСсылок[0];
	КонецЕсли;
	
	МассивДокументов = ПлатежноРасчетныеДокументы.ЗначенияРеквизитовСведенияОДенежномОбязательстве(МассивСсылок);
	
	Если МассивДокументов.Количество() > 0 Тогда 
		РезультирующаяТаблица = МассивДокументов[0].РасшифровкаДокумента;
		Для к = 1 По МассивДокументов.Количество() - 1 Цикл
			ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(МассивДокументов[к].РасшифровкаДокумента, РезультирующаяТаблица)
        КонецЦикла;
	Иначе
		РезультирующаяТаблица.Колонки.Добавить("Ссылка");
	КонецЕсли;
	
	РезультирующаяТаблица.Колонки.Добавить("НомерПП");
	РезультирующаяТаблица.Колонки.Добавить("ИмяТабЧасти",       Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)));
	РезультирующаяТаблица.Колонки.Добавить("ПОЛЕСВЯЗИ");
	
	Для каждого Строка ИЗ РезультирующаяТаблица Цикл
		Строка.НомерПП     = Строка.НомерСтроки;
		Строка.ПолеСвязи   = Истина;
		Строка.ИмяТабЧасти = ВРег("Расшифровка");
	КонецЦикла;
	
	РезультирующаяТаблица.Колонки["Ссылка"].Имя      = "ССЫЛКАДОКУМЕНТА";
	
	Возврат РезультирующаяТаблица;
	
КонецФункции

// Функция возвращает таблицу значений, используемую в форматах обмена с ОФК.
Функция ТаблицаРасшифровкиРаспоряженияМИР(знач ОбъектСсылка, ИспользоватьДопКл, ИспользоватьКодМероприятия, ИспользоватьКЭК, ИспользоватьКФО) Экспорт
	
	РезультирующаяТаблица 			= Новый ТаблицаЗначений;
	
	РезультирующаяТаблица.Колонки.Добавить("НомерПП");

	РезультирующаяТаблица.Колонки.Добавить("ИмяТабЧасти",    Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)));
	РезультирующаяТаблица.Колонки.Добавить("ПОЛЕСВЯЗИ");
	
	РезультирующаяТаблица.Колонки.Добавить("КодБК");
	РезультирующаяТаблица.Колонки.Добавить("КодЦели");   
	
	РезультирующаяТаблица.Колонки.Добавить("ЕстьВложенныеКБК");
	
	РезультирующаяТаблица.Колонки.Добавить("НомерСтроки_ГЛ", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)));
	РезультирующаяТаблица.Колонки.Добавить("ИмяТабЧасти_ГЛ", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)));

	
	// возвращаем пустую таблицу для построения формата в СКД
	Если НЕ ЗначениеЗаполнено(ОбъектСсылка) Тогда
									
		Возврат РезультирующаяТаблица;
		 
	КонецЕсли;
	//*******************************************************
	
	МассивСсылок          			= Новый Массив;
	
	Если ТипЗнч(ОбъектСсылка) = Тип("ДокументСсылка.РаспоряжениеОПеречисленииНаКартыМир") Тогда
		МассивСсылок.Добавить(ОбъектСсылка);
	Иначе
		МассивСсылок 				= ОбъектСсылка;
		ОбъектСсылка                = МассивСсылок[0];
	КонецЕсли;

	МассивДанныхДокументов          = ПлатежноРасчетныеДокументы.ЗначенияРеквизитовРаспоряжениеОПеречисленииНаКартыМир(МассивСсылок, ИспользоватьДопКл, 
	                                                                                      ИспользоватьКодМероприятия, ИспользоватьКЭК, ИспользоватьКФО);
	
	Для к = 0 по МассивДанныхДокументов.Количество()-1 Цикл 
		
		НомСтроки                       = 0;	
	    НомерПП                         = 0;
		
		ТаблицаРаспоряжения             = МассивДанныхДокументов[к];
		
		Если к = 0 Тогда
			Для Каждого Колонка Из ТаблицаРаспоряжения.ИнформацияОВыплатах.Колонки Цикл
			    РезультирующаяТаблица.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
			КонецЦикла;	  
		КонецЕсли;	
		
		Если к = 0 Тогда
			Для Каждого Колонка Из ТаблицаРаспоряжения.ИтоговыеСуммыВыплат.Колонки Цикл  
				Если РезультирующаяТаблица.Колонки.Найти(Колонка.Имя) = Неопределено Тогда
			        РезультирующаяТаблица.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);  
				КонецЕсли;	
			КонецЦикла;	
		КонецЕсли;	

		Для Каждого СтрокаИнформации Из ТаблицаРаспоряжения.ИнформацияОВыплатах Цикл
							
			НомСтроки                                    = НомСтроки + 1;
			
			ЗаполнитьЗначенияСвойств(РезультирующаяТаблица.Добавить(), СтрокаИнформации);
			
			н                                            = РезультирующаяТаблица.Количество()-1;
			
			РезультирующаяТаблица[н].ИмяТабЧасти		 = ВРег("ИнформацияОВыплатах");
			РезультирующаяТаблица[н].НомерСтроки       	 = НомСтроки;
			РезультирующаяТаблица[н].ПОЛЕСВЯЗИ           = ИСТИНА;   
			
			РезультирующаяТаблица[н].ЕстьВложенныеКБК    = (СтрокаИнформации.РасшифровкаПоБК.Количество() > 0);
			
			ПоследняяИтоговаяСтрока                      = н;
			
			//Если НЕ ОбъектСсылка.ЛицевойСчет.НеВыводитьКБК Тогда
				Для Каждого СтрокаРасшифровки Из СтрокаИнформации.РасшифровкаПоБК Цикл
				
					НомерПП                                  = НомерПП + 1;
					
					ЗаполнитьЗначенияСвойств(РезультирующаяТаблица.Добавить(), СтрокаРасшифровки);
					
					н                                        = РезультирующаяТаблица.Количество()-1;
					
					РезультирующаяТаблица[н].НомерПП       	 = НомерПП;
					
					РезультирующаяТаблица[н].ИмяТабЧасти   	 = ВРег("ДетальныеПоказателиПоКПС");
					РезультирующаяТаблица[н].НомерСтроки     = НомерПП;

					РезультирующаяТаблица[н].ИмяТабЧасти_Гл	 = ВРег("ИнформацияОВыплатах");
					РезультирующаяТаблица[н].НомерСтроки_Гл  = "__"+Строка(НомСтроки);
					
					РезультирующаяТаблица[н].ПОЛЕСВЯЗИ       = ИСТИНА;

				КонецЦикла;		
			  //КонецЕсли;
		КонецЦикла;		
		
	КонецЦикла;	
		
	РезультирующаяТаблица.Колонки["Ссылка"].Имя = "ССЫЛКАДОКУМЕНТА";
	
	Возврат РезультирующаяТаблица;		
	
КонецФункции

// Функция возвращает таблицу значений, используемую в форматах обмена с ОФК.
Функция ТаблицаИтоговРаспоряженияМИР(знач ОбъектСсылка, ИспользоватьДопКл, ИспользоватьКодМероприятия, ИспользоватьКЭК, ИспользоватьКФО) Экспорт
	
	РезультирующаяТаблица 			= Новый ТаблицаЗначений;

	РезультирующаяТаблица.Колонки.Добавить("НомерСтроки");
	РезультирующаяТаблица.Колонки.Добавить("НомерПП");

	РезультирующаяТаблица.Колонки.Добавить("ИмяТабЧасти",    Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)));
	РезультирующаяТаблица.Колонки.Добавить("ПОЛЕСВЯЗИ");
	
	РезультирующаяТаблица.Колонки.Добавить("КодБК");
	РезультирующаяТаблица.Колонки.Добавить("КодЦели");
	
	РезультирующаяТаблица.Колонки.Добавить("НомерСтроки_ГЛ", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)));
	РезультирующаяТаблица.Колонки.Добавить("ИмяТабЧасти_ГЛ", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(1000)));

	
	// возвращаем пустую таблицу для построения формата в СКД
	Если НЕ ЗначениеЗаполнено(ОбъектСсылка) Тогда
									
		Возврат РезультирующаяТаблица;
		 
	КонецЕсли;
	//******************************************************* 
				
	МассивСсылок          			= Новый Массив;
	
	Если ТипЗнч(ОбъектСсылка) = Тип("ДокументСсылка.РаспоряжениеОПеречисленииНаКартыМир") Тогда
		МассивСсылок.Добавить(ОбъектСсылка);
	Иначе
		МассивСсылок 				= ОбъектСсылка;
		ОбъектСсылка                = МассивСсылок[0];
	КонецЕсли; 
		
	МассивДанныхДокументов          = ПлатежноРасчетныеДокументы.ЗначенияРеквизитовРаспоряжениеОПеречисленииНаКартыМир(МассивСсылок, ИспользоватьДопКл, 
	                                                                                      ИспользоватьКодМероприятия, ИспользоватьКЭК, ИспользоватьКФО);
	
	Для к = 0 По МассивДанныхДокументов.Количество() - 1 Цикл 
		
		НомСтроки                       = 0;	
	    НомерПП                         = 0;
	
		ТаблицаРаспоряжения             = МассивДанныхДокументов[к];
		
		Если к = 0 Тогда
			Для Каждого Колонка Из ТаблицаРаспоряжения.ИтоговыеСуммыВыплат.Колонки Цикл  
				Если РезультирующаяТаблица.Колонки.Найти(Колонка.Имя) = Неопределено Тогда
			        РезультирующаяТаблица.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);  
				КонецЕсли;	
			КонецЦикла;	
		КонецЕсли;		
				
		Для Каждого СтрокаИтогов Из ТаблицаРаспоряжения.ИтоговыеСуммыВыплат Цикл
							
			НомСтроки                                    = НомСтроки + 1;
			
			ЗаполнитьЗначенияСвойств(РезультирующаяТаблица.Добавить(), СтрокаИтогов);
			
			н                                            = РезультирующаяТаблица.Количество()-1;
			
			РезультирующаяТаблица[н].ИмяТабЧасти		 = ВРег("ИтоговыеСуммыВыплат");
			РезультирующаяТаблица[н].НомерСтроки       	 = НомСтроки;
			РезультирующаяТаблица[н].ПОЛЕСВЯЗИ           = ИСТИНА;
				
		КонецЦикла; 
		
	КонецЦикла;	
			
	РезультирующаяТаблица.Колонки["Ссылка"].Имя = "ССЫЛКАДОКУМЕНТА";
	
	Возврат РезультирующаяТаблица;		
	
КонецФункции  

