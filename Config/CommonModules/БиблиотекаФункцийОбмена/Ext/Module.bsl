#Область ПроцедурыИФункцииВыгрузкиПеречисленийФизическимЛицамВБанк

// Функция возвращает часть ФИО физического лица
// Параметры:
//	- Контрагент - СправочникСсылка.ФизическиеЛица, СправочникСсылка.Контрагенты, СправочникСсылка.Дети или строка вида "Фамилия Имя Отчество"
//	- ЧастьФИО - строковое представление той части ФИО, которую требуется получить, например: "Фамилия" (в любом регистре)
//	- НаДату - дата, на которую требуется получить значение ФИО
//
Функция ЧастиФИО(Контрагент, ЧастьФИО, НаДату) Экспорт
	Если Не ЗначениеЗаполнено(Контрагент) Или Не ЗначениеЗаполнено(ЧастьФИО) Тогда
		Возврат "";
	КонецЕсли;
	
	Если ТипЗнч(Контрагент) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
		ФизЛицо = Контрагент;
	ИначеЕсли ТипЗнч(Контрагент) = Тип("СправочникСсылка.Контрагенты") Тогда
		Если Контрагент.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
			Возврат "";
		Иначе
			ФизЛицо = Контрагент.ЮридическоеФизическоеЛицо;
		КонецЕсли;
	ИначеЕсли ТипЗнч(Контрагент) = Тип("СправочникСсылка.Дети") Тогда
		ФизЛицо = Контрагент.Контрагент.ЮридическоеФизическоеЛицо;
	ИначеЕсли ТипЗнч(Контрагент) = Тип("СправочникСсылка.Сотрудники") Тогда
		ФизЛицо = Контрагент.Контрагент.ЮридическоеФизическоеЛицо;
	ИначеЕсли ТипЗнч(Контрагент) = Тип("Строка") Тогда
		МассивФИО = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Контрагент, " ");
		
		Если ВРег(ЧастьФИО) = "ФАМИЛИЯ" Тогда
			Возврат ?(МассивФИО.Количество() >=1, МассивФИО[0], "");
		ИначеЕсли ВРег(ЧастьФИО) = "ИМЯ" Тогда
			Возврат ?(МассивФИО.Количество() >=2, МассивФИО[1], "");
		ИначеЕсли ВРег(ЧастьФИО) = "ОТЧЕСТВО" Тогда
			Возврат ?(МассивФИО.Количество() > 2, МассивФИО[2], "");
		Иначе
			Возврат "";
		КонецЕсли;
	Иначе
		Возврат "";
	КонецЕсли;
	
	СтруктураФИО = БиблиотекаФункцийОбменаПовтИсп.ЧастиФИО(ФизЛицо, НаДату);
	
	Возврат СтруктураФИО[ВРег(ЧастьФИО)];
КонецФункции

Функция ПолучитьПараметрФайлаВыгрузкиКомпенсацииРодительскойПлаты(ДокументСсылка, ЗаданиеНаЭкспорт, ИмяПараметра = "") Экспорт
	Если Не ЗначениеЗаполнено(ИмяПараметра) Тогда
		Возврат "";
	КонецЕсли;
	
	СтруктураПараметров = БиблиотекаФункцийОбменаПовтИсп.СтруктураПараметровФайлаВыгрузкиКомпенсацииРодительскойПлаты(ДокументСсылка, ЗаданиеНаЭкспорт);
	
	ПараметрВыгрузки = Неопределено;
	
	Если ИмяПараметра = "ИмяФайла"
		И СтруктураПараметров.Свойство("ОтделениеБанка")
		И СтруктураПараметров.Свойство("НомерРеестраДляИмениФайла") Тогда
		ПараметрВыгрузки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("%1%2z",
			СтроковыеФункцииКлиентСервер.ДополнитьСтроку(СтруктураПараметров.ОтделениеБанка, 4),
			Прав(СтроковыеФункцииКлиентСервер.ДополнитьСтроку(СтруктураПараметров.НомерРеестраДляИмениФайла, 3), 3));
	Иначе
		СтруктураПараметров.Свойство(ИмяПараметра, ПараметрВыгрузки);
	КонецЕсли;
	
	Если ПараметрВыгрузки <> Неопределено Тогда
		Возврат ПараметрВыгрузки;
	Иначе
		Возврат "";
	КонецЕсли;
КонецФункции

