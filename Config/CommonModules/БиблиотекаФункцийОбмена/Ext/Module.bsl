Функция СоздатьЮрФизЛицо(Наименование, ИНН, ИмяСправочника, КПП = неопределено, КодРПБС = неопределено)
	
	ЮрФизЛицо              = Справочники[ИмяСправочника].СоздатьЭлемент();
	ЮрФизЛицо.ИНН          = ИНН;
	ЮрФизЛицо.Наименование = Наименование;
		
	Если ЗначениеЗаполнено(КПП) или ЗначениеЗаполнено(КодРПБС) Тогда        
		
		ЮрФизЛицо.КПП                = КПП;
		ЮрФизЛицо.НаименованиеПолное = Наименование;
		ЮрФизЛицо.КодПоРПБС          = КодРПБС;
		
	КонецЕсли;
	
	Попытка
		
		ЮрФизЛицо.Записать();
		
		Если ИмяСправочника = "ФизическиеЛица" Тогда
		
			МассивФИО = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Наименование, " ");
		
			Если МассивФИО.Количество() > 0 Тогда
				
				НоваяЗапись                = РегистрыСведений.ФИОФизическихЛиц.СоздатьМенеджерЗаписи();
				НоваяЗапись.Период         = '19800101';
				НоваяЗапись.ФизическоеЛицо = ЮрФизЛицо.Ссылка;
				НоваяЗапись.Фамилия        = МассивФИО[0];
				
				Если МассивФИО.Количество() > 1 Тогда
					НоваяЗапись.Имя      = МассивФИО[1];
				КонецЕсли;
				
				Если МассивФИО.Количество() > 2 Тогда
					НоваяЗапись.Отчество = МассивФИО[2];
				КонецЕсли;
				
				НоваяЗапись.Записать(Ложь);
			КонецЕсли;

		КонецЕсли;	
						
	Исключение	
		Возврат Справочники[ИмяСправочника].ПустаяСсылка();
	КонецПопытки;
	
	Возврат ЮрФизЛицо.Ссылка;
	
КонецФункции	
 

