	Возврат БиблиотекаФункцийОбменаПовтИсп.СтатусОбъектаУчетаИмущества(Объект, НаДату);
	
КонецФункции

// Есть альтернатива - ИдентификаторЗапроса
Функция ПолучитьКартуПоИдентификатору(Идентификатор) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	СостояниеКартРеестраИмущества.Карта
	               |ИЗ
	               |	РегистрСведений.СостояниеКартРеестраИмущества КАК СостояниеКартРеестраИмущества
	               |ГДЕ
	               |	СостояниеКартРеестраИмущества.Идентификатор = &Идентификатор";
				   
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);			   
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат ?(Выборка.Следующий(), Выборка.Карта, Документы.РегистрацияСведенийОбИмуществе.ПустаяСсылка());
	
КонецФункции

Функция ИдентификаторЗапроса(Ключ, ИдПоКарте = Истина) Экспорт

	ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	СостояниеКартРеестраИмущества.[Значение] КАК Значение
	               |ИЗ
	               |	РегистрСведений.СостояниеКартРеестраИмущества КАК СостояниеКартРеестраИмущества
	               |ГДЕ
	               |	СостояниеКартРеестраИмущества.[Ключ] = &Ключ";
				   
	Если ИдПоКарте Тогда
		ВставляемыеЗначения = Новый Структура("Значение,Ключ", "Идентификатор", "Карта");			   
		ПустоеЗначение = "";
	Иначе
		ВставляемыеЗначения = Новый Структура("Значение,Ключ", "Карта", "Идентификатор");
		ПустоеЗначение = Документы.РегистрацияСведенийОбИмуществе.ПустаяСсылка();
	КонецЕсли;
	
	ТекстЗапроса = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ТекстЗапроса, ВставляемыеЗначения);
				   
	Запрос = Новый Запрос(ТекстЗапроса);				   
	Запрос.УстановитьПараметр("Ключ", Ключ);			   
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат ?(Выборка.Следующий(), Выборка.Значение, ПустоеЗначение);
	
КонецФункции

Функция ОсновноеСредствоПоИнвентарномуНомеру(Организация, ИнвентарныйНомер) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ИнвентарныеНомераОС.ОС
	               |ИЗ
	               |	Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	               |ГДЕ
	               |	ИнвентарныеНомераОС.ОС.Организация = &Организация
	               |	И ИнвентарныеНомераОС.Код = &Код";
				   
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Код", ИнвентарныйНомер);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Возврат ?(Выборка.Следующий(), Выборка.ОС, Справочники.ОсновныеСредства.ПустаяСсылка());
	
КонецФункции


