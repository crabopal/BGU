
#Область ПрограммныйИнтерфейс

// См. СозданиеНаОснованииПереопределяемый.ПриОпределенииОбъектовСКомандамиСозданияНаОсновании.
//
Процедура ПриОпределенииОбъектовСКомандамиСозданияНаОсновании(Объекты) Экспорт
	
	Объекты.Добавить(Метаданные.Документы.НачислениеКонтрагентамГИСГМП);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ПроцессыОбработкиДокументов") Тогда
		МодульПроцессыОбработкиДокументов = ОбщегоНазначения.ОбщийМодуль("ПроцессыОбработкиДокументов");
		МодульПроцессыОбработкиДокументов.ПриОпределенииОбъектовСКомандамиСозданияНаОсновании(Объекты);
	КонецЕсли;
	
КонецПроцедуры

// Согласованные настройки для формы ввода нескольких документов на основании одного.
Функция ОбработатьПараметрыВводаНаОсновании(ПараметрыВводаНаОсновании) Экспорт
	
	Перем ЗначениеПараметра;
	
	ДокументОснованиеСсылка	= ПараметрыВводаНаОсновании["ДокументОснованиеСсылка"];
	УникальныйИдентификатор	= ПараметрыВводаНаОсновании["УникальныйИдентификатор"];
	
	// Дозаполняем параметры
	ИмяДокументаОснования = ДокументОснованиеСсылка.Метаданные().Имя;
	ПараметрыВводаНаОсновании.Вставить("ИмяДокументаОснования", ИмяДокументаОснования);
	
	// Разбиваем данные документа-основания на порции для создания новых документов
	Данные = ПолучитьДанныеНовыхДокументов(ПараметрыВводаНаОсновании);
	
	// разделяем сохраняемые данные на 2 группы:
	//	- таблица Отметки для открытия и работы формы Отметки
	//		Сохраняется по отдельному адресу.
	//	- данные каждого нового документа
	//		Сохраняется по индивидуальному адресу.
	//		Количество адресов равно количеству новых документов.
	//		Нужно для того, чтобы при заполнении этого документа в будущем считывать из хранилища
	//		только необходимые данные.
	//		А не весь результат (потенциально большой),
	//		в том числе и для создания совсем других документов.
	
	АдресТаблицыОтметки = ПоместитьВоВременноеХранилище(Данные["ТаблицаОтметки"], УникальныйИдентификатор);
	
	// Значения для реквизитов типовой операции возвращаем отдельно в явном виде,
	// чтобы можно было передать структуру значений в контексте клиента при открытии формы.
	//
	// Этим обусловлено составление и передача на клиента
	// структуры с полным перечислением всех допустимых видов документов
	// и заполненными реквизитами типовых операций для КАЖДОГО конкретного нового документа.
	ПередаваемыеДанные = Новый Структура();
	Для Каждого ЭлементДанные Из Данные["ДанныеНовыхДокументов"] Цикл
		ВидДокумента = ЭлементДанные.Ключ;
		
		СтруктураДанных = Новый Структура("
			|ИмяТаблицыНовый,
			|ТиповаяОперация,
			|ЗначенияРеквизитовТиповойОперации");
		
		ЗаполнитьЗначенияСвойств(СтруктураДанных, ЭлементДанные.Значение);
		
		// Сохраняем данные для заполнения шапки и табличной части каждого конкретного документа
		// по индивидуальному адресу
		ТаблицаДанныеДокументов	= ЭлементДанные.Значение["ТаблицаДанныеДокументов"];
		СохраняемоеЗначение	= Новый Структура();
		Для Каждого Колонка Из ТаблицаДанныеДокументов.Колонки Цикл
			СохраняемоеЗначение.Вставить(Колонка.Имя);
		КонецЦикла;
		
		АдресаДанныхДляНовыхДокументов = Новый Массив();
		
		Для Каждого СтрокаТаблицы Из ТаблицаДанныеДокументов Цикл
			ЗаполнитьЗначенияСвойств(СохраняемоеЗначение, СтрокаТаблицы);
			
			НовыйАдрес = ПоместитьВоВременноеХранилище(Новый ФиксированнаяСтруктура(СохраняемоеЗначение), УникальныйИдентификатор);
			
			АдресаДанныхДляНовыхДокументов.Добавить(НовыйАдрес);
		КонецЦикла;
		
		СтруктураДанных.Вставить("АдресаДанныхДляНовыхДокументов", АдресаДанныхДляНовыхДокументов);
		
		ПередаваемыеДанные.Вставить(ВидДокумента, СтруктураДанных);
	КонецЦикла;
	
	// Параметры оповещения о закрытии формы ввода нескольких документов на основании одного
	ПараметрыОповещения = Новый Структура();
	ПараметрыОповещения.Вставить("ДокументОснованиеСсылка",		ДокументОснованиеСсылка);
	ПараметрыОповещения.Вставить("ПередаваемыеДанные",			ПередаваемыеДанные);
	
	// Параметры формы ввода нескольких документов на основании одного
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("АдресТаблицыОтметки",			АдресТаблицыОтметки);
	ПараметрыФормы.Вставить("СинонимыВидовДокументов",		Данные["СинонимыВидовДокументов"]);
	ПараметрыФормы.Вставить("ИменаКолонокТиповойОперации",	Данные["ИменаКолонокТиповойОперации"]);
	
	// Параметры формы, которые могут быть заданы в команде
	ПробрасываемыеПараметры = Новый Структура("
		|ВидДокумента,
		|ДокументОснованиеСсылка,
		|РазрешитьОтметкуСуществующихДокументов,
		|СвойстваКолонок,
		|ИменаСкрываемыхКолонок,
		|ИмяКолонкиВидДокумента,
		|ИмяКолонкиДокСсылка");
	ЗаполнитьЗначенияСвойств(ПробрасываемыеПараметры, ПараметрыВводаНаОсновании);
	Для Каждого Параметр Из ПробрасываемыеПараметры Цикл
		Если НЕ Параметр.Значение = Неопределено Тогда
			ПараметрыФормы.Вставить(Параметр.Ключ, Параметр.Значение);
		КонецЕсли;
	КонецЦикла;
	
	РезультатОбработки = Новый Структура();
	РезультатОбработки.Вставить("ПараметрыОповещения",			ПараметрыОповещения);
	РезультатОбработки.Вставить("ПараметрыФормы",				ПараметрыФормы);
	РезультатОбработки.Вставить("КоличествоНовыхДокументов",	Данные["КоличествоНовыхДокументов"]);
	
	Возврат РезультатОбработки;
	
КонецФункции

Процедура ЗаполнитьНовыйДокумент(ЗаполняемыйДокумент, ДанныеЗаполнения) Экспорт
	
	// Читаем данные
	ДанныеМеханизма = ДанныеЗаполнения["ДанныеМеханизмаВводаНаОсновании"];
	АдресДанныхДляНовогоДокумента	= ДанныеМеханизма["АдресДанныхДляНовогоДокумента"];
	ВидДокумента					= ДанныеМеханизма["ВидДокумента"];
	ИмяТаблицыНовый					= ДанныеМеханизма["ИмяТаблицыНовый"];
	ДанныеНовогоДокумента			= ПолучитьИзВременногоХранилища(АдресДанныхДляНовогоДокумента);
	
	// Заполняем реквизиты шапки
	ЗаполнитьЗначенияСвойств(ЗаполняемыйДокумент, ДанныеНовогоДокумента);
	
	// Заполняем табличную часть
	Если ЗначениеЗаполнено(ИмяТаблицыНовый) Тогда
		ЗаполняемыйДокумент[ИмяТаблицыНовый].Загрузить(ДанныеНовогоДокумента[ИмяТаблицыНовый]);
	КонецЕсли;
	
КонецПроцедуры

//---
// Форма ввода нескольких документов на основании одного
//---

Процедура ДобавитьСвязьРеквизитов(СвязиРеквизитов, Знач ИмяРеквизитаДокументаОснования, Знач ИмяРеквизитаНовогоДокумента) Экспорт
	
	Если НЕ (ТипЗнч(СвязиРеквизитов) = Тип("Соответствие")) Тогда
		СвязиРеквизитов = Новый Соответствие();
	КонецЕсли;
	
	УжеЗаданноеЗначение = СвязиРеквизитов.Получить(ИмяРеквизитаДокументаОснования);
	Если УжеЗаданноеЗначение = Неопределено Тогда
		ЗаписываемоеЗначение = ИмяРеквизитаНовогоДокумента;
	Иначе
		ЗаписываемоеЗначение = УжеЗаданноеЗначение + "," + ИмяРеквизитаНовогоДокумента;
	КонецЕсли;
	
	СвязиРеквизитов.Вставить(ИмяРеквизитаДокументаОснования, ЗаписываемоеЗначение);
	
КонецПроцедуры

Процедура ДобавитьКолонкуТаблицыОтметки(КолонкиТаблицыОтметки, ИмяКолонки, ИмяРеквизитаШапкиНовогоДокумента = "") Экспорт
	
	Если НЕ ТипЗнч(КолонкиТаблицыОтметки) = Тип("Структура") Тогда
		КолонкиТаблицыОтметки = Новый Структура();
	КонецЕсли;
	
	КолонкиТаблицыОтметки.Вставить(ИмяКолонки, ИмяРеквизитаШапкиНовогоДокумента);
	
КонецПроцедуры

Процедура ДобавитьНастройкиМеханизмаДляВидаДокументов(ЗаполняемыеНастройки, ВидДокумента,
	СвязиРеквизитов, ТиповаяОперацияСсылка, РеквизитыТиповойОперации,
	КолонкиТаблицыОтметки) Экспорт
	
	// Входные проверки
	
	Если ЗаполняемыеНастройки = Неопределено Тогда
		ЗаполняемыеНастройки = ПолучитьПустыеНастройкиМеханизма();
	КонецЕсли;
	
	Если НЕ (ТипЗнч(СвязиРеквизитов) = Тип("Соответствие")) Тогда
		СвязиРеквизитов = Новый Соответствие();
	КонецЕсли;
	Если НЕ ТипЗнч(РеквизитыТиповойОперации) = Тип("Массив") Тогда
		РеквизитыТиповойОперации = Новый Массив();
	КонецЕсли;
	Если НЕ ТипЗнч(КолонкиТаблицыОтметки) = Тип("Структура") Тогда
		КолонкиТаблицыОтметки = Новый Структура();
	КонецЕсли;
	
	РазбивкаДанных = Новый Структура();
	РазбивкаДанных.Вставить("СвязиРеквизитов",			СвязиРеквизитов);
	РазбивкаДанных.Вставить("ТиповаяОперация",			ТиповаяОперацияСсылка);
	РазбивкаДанных.Вставить("РеквизитыТиповойОперации",	РеквизитыТиповойОперации);
	
	ЗаполняемыеНастройки["РазбивкаДанных"].Вставить(ВидДокумента, РазбивкаДанных);
	ЗаполняемыеНастройки["ТаблицаОтметки"]["Колонки"].Вставить(ВидДокумента, КолонкиТаблицыОтметки);
	
	СвязиРеквизитов				= Неопределено;
	ТиповаяОперацияСсылка		= Неопределено;
	РеквизитыТиповойОперации	= Неопределено;
	КолонкиТаблицыОтметки		= Неопределено;
	
КонецПроцедуры

Процедура ДобавитьОбщиеНастройкиМеханизма(ЗаполняемыеНастройки, РеквизитыТиповойОперацииОснование, ЗаголовкиКолонок) Экспорт
	
	Если ЗаполняемыеНастройки = Неопределено Тогда
		ЗаполняемыеНастройки = ПолучитьПустыеНастройкиМеханизма();
	КонецЕсли;
	
	Если РеквизитыТиповойОперацииОснование = Неопределено Тогда
		РеквизитыТиповойОперацииОснование = Новый Массив();
	КонецЕсли;
	
	Если ЗаголовкиКолонок = Неопределено Тогда
		ЗаголовкиКолонок = Новый Структура();
	КонецЕсли;
	
	ЗаполняемыеНастройки["РеквизитыТиповойОперацииОснование"]	= РеквизитыТиповойОперацииОснование;
	ЗаполняемыеНастройки["ТаблицаОтметки"]["ЗаголовкиКолонок"]	= ЗаголовкиКолонок;
	
	ЗаголовкиКолонок	= Неопределено;
	
КонецПроцедуры

//---
// Форма списка документов, введенных на основании
//---

// Согласованные настройки для формы списка документов, введенных на основании.
Функция ОбработатьНастройкиФормыСписка(НастройкиФормыСписка) Экспорт
	
	Перем МассивФлажков;
	
	ОбработанныеНастройкиФормыСписка = Новый Структура();
	
	// Полный список колонок
	ОбработанныеНастройкиФормыСписка.Вставить("СинонимыВидовДокументов");
	ОбработанныеНастройкиФормыСписка.Вставить("СтруктураОписаниеКолонок");
	ПолноеОписаниеКолонок = СоставитьПолноеОписаниеКолонок(НастройкиФормыСписка);
	ЗаполнитьЗначенияСвойств(ОбработанныеНастройкиФормыСписка, ПолноеОписаниеКолонок);
	
	// Согласованные настройки флажков
	ОбработанныеНастройкиФормыСписка.Вставить("ИспользуемыеВидыДокументов");
	ОбработанныеНастройкиФормыСписка.Вставить("ИспользуемыеФлажки");
	ОбработанныеНастройкиФормыСписка.Вставить("ПараметрыЗапроса");
	ОбработанныеНастройкиФормыСписка.Вставить("СвязьВидДокументаИмяПараметра");
	ОбработанныеНастройкиФлажков = ОбработатьНастройкиФлажков(ПолноеОписаниеКолонок, НастройкиФормыСписка);
	ЗаполнитьЗначенияСвойств(ОбработанныеНастройкиФормыСписка, ОбработанныеНастройкиФлажков);
	
	// Текст запроса для динамического списка
	СоставитьТекстЗапросаДинамическогоСписка(ОбработанныеНастройкиФормыСписка);
	
	Возврат ОбработанныеНастройкиФормыСписка;
	
КонецФункции

Процедура ДобавитьКолонкуСпискаДокументов(ТаблицаОписаниеКолонок, Знач ВидДокумента, Знач ИмяКолонки, Знач ЗаголовокКолонки = "", Знач ВыражениеВТекстеЗапроса = "") Экспорт
	
	СоздатьТаблицу = НЕ (ТипЗнч(ТаблицаОписаниеКолонок) = Тип("ТаблицаЗначений"));
	
	Если СоздатьТаблицу Тогда
		ТипСтрока = Новый ОписаниеТипов("Строка");
		
		ТаблицаОписаниеКолонок = Новый ТаблицаЗначений();
		ТаблицаОписаниеКолонок.Колонки.Добавить("ВидДокумента",	ТипСтрока);
		ТаблицаОписаниеКолонок.Колонки.Добавить("Имя",			ТипСтрока);
		ТаблицаОписаниеКолонок.Колонки.Добавить("Заголовок",	ТипСтрока);
		ТаблицаОписаниеКолонок.Колонки.Добавить("Выражение",	ТипСтрока);
	КонецЕсли;
	
	НоваяСтрока = ТаблицаОписаниеКолонок.Добавить();
	НоваяСтрока["ВидДокумента"]	= ВидДокумента;
	НоваяСтрока["Имя"]			= ИмяКолонки;
	НоваяСтрока["Заголовок"]	= ЗаголовокКолонки;
	НоваяСтрока["Выражение"]	= ВыражениеВТекстеЗапроса;
	
КонецПроцедуры

Процедура ДобавитьФлажок(МассивФлажков, Знач ВидыДокументов = Неопределено, Знач ЗаголовокФлажка = Неопределено) Экспорт
	
	СоздатьМассив = НЕ (ТипЗнч(МассивФлажков) = Тип("Массив"));
	
	Если СоздатьМассив Тогда
		МассивФлажков = Новый Массив();
	КонецЕсли;
	
	Если ТипЗнч(ВидыДокументов) = Тип("Строка") Тогда
		МассивВидыДокументов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(ВидыДокументов);
	ИначеЕсли ТипЗнч(ВидыДокументов) = Тип("Массив") Тогда
		МассивВидыДокументов = ВидыДокументов;
	ИначеЕсли ВидыДокументов = Неопределено Тогда
		МассивВидыДокументов = Новый Массив();
	Иначе
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(ЗаголовокФлажка) Тогда
		ЗаголовокФлажка = НСтр("ru='<заголовок не указан>'");
	КонецЕсли;
	
	ОписаниеФлажка = Новый Структура();
	ОписаниеФлажка.Вставить("Заголовок",		ЗаголовокФлажка);
	ОписаниеФлажка.Вставить("ВидыДокументов",	МассивВидыДокументов);
	
	МассивФлажков.Добавить(ОписаниеФлажка);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Структура настроек механизма Ввода нескольких документов на основании одного
// (задается в модуле менеджера документа-основания)
//
//	РазбивкаДанных			- Структура
//		<ВидДокумента1>		- Структура
//			СвязиРеквизитов				- Соответствие
//				<ИмяРеквизитаОснования> : <ИмяРеквизитаНовогоДокумента>
//				...
//			ТиповаяОперация				- Справочник ссылка
//			РеквизитыТиповойОперации	- Массив
//				<ИмяРеквизита>	- Строка
//				...
//		<ВидДокумента2>
//			СвязиРеквизитов				- Соответствие
//			ТиповаяОперация				- Справочник ссылка
//			РеквизитыТиповойОперации	- Структура
//		...
//		<ВидДокументаN>
//			СвязиРеквизитов				- Соответствие
//			ТиповаяОперация				- Справочник ссылка
//			РеквизитыТиповойОперации	- Структура
//	ТаблицаОтметки			- Структура
//		Колонки				- Структура
//			<ВидДокумента1>	- Соответствие
//				<ИмяКолонки1> : <ИмяРеквизитаШапкиНовогоДокумента1>
//				<ИмяКолонки2> : <ИмяРеквизитаШапкиНовогоДокумента2>
//				...
//			<ВидДокумента2> = Описание колонок (Соответствие)
//			...
//			<ВидДокументаN> = Описание колонок (Соответствие)
//		ЗаголовкиКолонок	- Структура
//			<ИмяКолонки1> = Заголовок колонки (Строка)
//			<ИмяКолонки2> = Заголовок колонки (Строка)
//			...
//			<ИмяКолонкиM> = Заголовок колонки (Строка)
//	РеквизитыТиповойОперацииОснование	- Массив
//		<ИмяРеквизита1>	- Строка
//		<ИмяРеквизита2>	- Строка
//		...
//		<ИмяРеквизитаК>	- Строка
Функция ПолучитьПустыеНастройкиМеханизма()
	
	РазбивкаДанных = Новый Структура();
	
	Колонки				= Новый Структура();
	ЗаголовкиКолонок	= Новый Структура();
	ТаблицаОтметки = Новый Структура();
	ТаблицаОтметки.Вставить("Колонки",			Колонки);
	ТаблицаОтметки.Вставить("ЗаголовкиКолонок",	ЗаголовкиКолонок);
	
	РеквизитыТиповойОперацииОснование = Новый Массив();
	
	ПустыеНастройкиМеханизма = Новый Структура();
	ПустыеНастройкиМеханизма.Вставить("РазбивкаДанных",						РазбивкаДанных);
	ПустыеНастройкиМеханизма.Вставить("ТаблицаОтметки",						ТаблицаОтметки);
	ПустыеНастройкиМеханизма.Вставить("РеквизитыТиповойОперацииОснование",	РеквизитыТиповойОперацииОснование);
	
	Возврат ПустыеНастройкиМеханизма;
	
КонецФункции

// Результат работы механизма - разбивка на новые документы, таблица Отметки.
//
// Возвращаемое значение	- Структура	- содержит ключи
//
//	ТаблицаОтметки				- Таблица значений
//	ИменаКолонокТиповойОперации	- Массив
//	ДанныеНовыхДокументов		- Структура
//		<ВидДокумента1>			- Структура
//			ТаблицаДанныеДокументов				- Таблица значений
//			РеквизитыШапкиНовый					- Массив имен
//			ИмяТаблицыНовый						- Строка
//			ТиповаяОперация						- Справочник ссылка (из настроек механизма)
//			РеквизитыТиповойОперации			- Массив имен (из настроек механизма)
//			ЗначенияРеквизитовТиповойОперации	- Массив структур
//				<ИмяРеквизита1> : Значение реквизита типовой операции
//				...
//		<ВидДокумента2>			- Структура
//			...
//		...
//	СинонимыВидовДокументов		- Список значений
//		<ВидДокумента1> : Синоним вида документов
//		...
Функция ПолучитьДанныеНовыхДокументов(ПараметрыВводаНаОсновании)
	
	Перем ОснованиеСтруктура;
	
	ИмяДокументаОснования = ПараметрыВводаНаОсновании["ИмяДокументаОснования"];
	
	// Настройки механизма
	НастройкиМеханизма = Документы[ИмяДокументаОснования].ВводНаОсновании_НастройкиМеханизма(ПараметрыВводаНаОсновании);
	
	// Имена используемых реквизитов документа-основания (шапка и таблица)
	ИспользуемыеРеквизитыШапкиДокументаОснования = ПолучитьИменаИспользуемыхРеквизитовДокументаОснования(НастройкиМеханизма);
	ИмяТаблицыОснование				= ПараметрыВводаНаОсновании["ИмяТабличнойЧастиДокументаОснования"];
	ИменаРеквизитовОснованияШапка	= ИспользуемыеРеквизитыШапкиДокументаОснования["РеквизитыШапкиСтрокой"];
	ИменаРеквизитовОснованияВсе		= ИменаРеквизитовОснованияШапка + "," + ИмяТаблицыОснование;
	
	// Считываем используемые данные документа-основания (шапка и таблица)
	ЗапросДанныеОснования = Новый Запрос();
	ЗапросДанныеОснования.УстановитьПараметр("ДокументСсылка", ПараметрыВводаНаОсновании["ДокументОснованиеСсылка"]);
	ЗапросДанныеОснования.Текст = "
	|ВЫБРАТЬ
	|	" + ИменаРеквизитовОснованияВсе + "
	|ИЗ
	|	Документ." + ИмяДокументаОснования + "
	|ГДЕ
	|	Ссылка = &ДокументСсылка
	|;";
	Попытка
		ДанныеОснования = ЗапросДанныеОснования.Выполнить().Выгрузить()[0];
	Исключение
		ТекстСообщения = НСтр("ru='Указан несуществующий реквизит документа-основания в настройках механизма ввода на основании
			|
			|'")
			+ ОписаниеОшибки();
		ВызватьИсключение ТекстСообщения;
	КонецПопытки;
	
	ОснованиеСтруктура = Новый Структура(ИменаРеквизитовОснованияВсе);
	ЗаполнитьЗначенияСвойств(ОснованиеСтруктура, ДанныеОснования);
	
	// Планируемые к созданию виды документов
	ВидДокументаЗаданВКолонке = НЕ ЗначениеЗаполнено(ПараметрыВводаНаОсновании["ВидДокумента"]);
	Если ВидДокументаЗаданВКолонке Тогда
		ИмяКолонкиВидДокумента = ПараметрыВводаНаОсновании["ИмяКолонкиВидДокумента"];
		
		ЕстьКолонкаВидДокумента = НЕ (ОснованиеСтруктура[ИмяТаблицыОснование].Колонки.Найти(ИмяКолонкиВидДокумента) = Неопределено);
		Если НЕ ЕстьКолонкаВидДокумента Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='Не определен вид создаваемых документов.
					|Отсутствует колонка %1 в табличной части %2'"),
				ИмяКолонкиВидДокумента,
				ИмяТаблицыОснование);
			ВызватьИсключение ТекстСообщения;
		КонецЕсли;
		
		ТаблицаВидыДокументов = ОснованиеСтруктура[ИмяТаблицыОснование].Скопировать();
		ТаблицаВидыДокументов.Свернуть(ИмяКолонкиВидДокумента);
		ИспользуемыеВидыДокументов = ТаблицаВидыДокументов.ВыгрузитьКолонку(ИмяКолонкиВидДокумента);
	Иначе
		ИспользуемыеВидыДокументов = Новый Массив();
		ИспользуемыеВидыДокументов.Добавить(ПараметрыВводаНаОсновании["ВидДокумента"]);
	КонецЕсли;
	
	Для Каждого ВидДокумента Из ИспользуемыеВидыДокументов Цикл
		ВидДокументаОжидаемый = НастройкиМеханизма["РазбивкаДанных"].Свойство(ВидДокумента);
		Если НЕ ВидДокументаОжидаемый Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru='Указан неподдерживаемый вид документа %1
					|В настройках ввода на основании такой вид документов не задан'"),
				ВидДокумента);
			ВызватьИсключение ТекстСообщения;
		КонецЕсли;
	КонецЦикла;
	
	// Используемые колонки таблицы "Отметки"
	ИспользуемыеКолонокиТаблицыОтметки = ПолучитьИменаКолонокТаблицыОтметки(НастройкиМеханизма, ИспользуемыеВидыДокументов);
	Документы[ИмяДокументаОснования].ВводНаОсновании_Переопределяемый_КолонкиТаблицыОтметки(ПараметрыВводаНаОсновании, ИспользуемыеКолонокиТаблицыОтметки);
	
	ПринадлежностьКолонок = ОпределитьПринадлежностьКолонок(
		НастройкиМеханизма,
		ИспользуемыеКолонокиТаблицыОтметки,
		ИспользуемыеВидыДокументов);
	
	ПрефиксыИменКолонок = Новый Структура();
	ПрефиксыИменКолонок.Вставить("Шапка",			"");
	ПрефиксыИменКолонок.Вставить("ТиповаяОперация",	"Операция_");
	
	// Создаем таблицу "Отметки"
	ТаблицаОтметки = ПолучитьПустуюТаблицуОтметки(НастройкиМеханизма, ПринадлежностьКолонок, ПрефиксыИменКолонок);
	ОбозначениеНесколькихЗначений = НСтр("ru='<таблица>'");
	
	// Получаем данные для новых документов
	// и заполняем таблицу "Отметки"
	ДанныеНовыхДокументов		= Новый Структура();
	ИменаКолонокТиповойОперации	= Новый Массив();
	СинонимыВидовДокументов		= Новый СписокЗначений();
	КоличествоНовыхДокументов	= 0;
	Для Каждого ВидДокумента Из ИспользуемыеВидыДокументов Цикл
		Если НЕ ЗначениеЗаполнено(ВидДокумента) Тогда
			Продолжить;
		КонецЕсли;
		
		ТиповаяОперация				= НастройкиМеханизма["РазбивкаДанных"][ВидДокумента]["ТиповаяОперация"];
		РеквизитыТиповойОперации	= НастройкиМеханизма["РазбивкаДанных"][ВидДокумента]["РеквизитыТиповойОперации"];
		
		СинонимыВидовДокументов.Добавить(ВидДокумента, Метаданные.Документы[ВидДокумента].Синоним);
		
		// Часть строк таблицы основания, которые попадают в новый документ текущего вида
		Если ВидДокументаЗаданВКолонке Тогда
			Поиск = Новый Структура("ВидДокумента", ВидДокумента);
			МассивСтрок = ОснованиеСтруктура[ИмяТаблицыОснование].НайтиСтроки(Поиск);
			ЧастьТаблицыОснование = ОснованиеСтруктура[ИмяТаблицыОснование].Скопировать(МассивСтрок);
		Иначе
			ЧастьТаблицыОснование = ОснованиеСтруктура[ИмяТаблицыОснование];
		КонецЕсли;
		ЧастьОснованияСтруктура = Новый Структура(ИменаРеквизитовОснованияШапка);
		ЗаполнитьЗначенияСвойств(ЧастьОснованияСтруктура, ОснованиеСтруктура);
		ЧастьОснованияСтруктура.Вставить(ИмяТаблицыОснование, ЧастьТаблицыОснование);
		
		// Данные для новых документов текущего вида
		ДанныеДляНовыхДокументов	= ПреобразоватьВДокументыДругогоВида(НастройкиМеханизма, ЧастьОснованияСтруктура, ВидДокумента);
		ТаблицаДанныеДокументов		= ДанныеДляНовыхДокументов["ТаблицаДанныеДокументов"];
		
		КоличествоНовыхДокументов = КоличествоНовыхДокументов + ТаблицаДанныеДокументов.Количество();
		
		// Типовая операция
		ЗначенияРеквизитовТиповойОперации = Новый Массив();
		РеквизитыТиповойОперацииСтрока = СтрСоединить(РеквизитыТиповойОперации, ",");
		ИдентификаторДокумента	= Справочники.ИдентификаторыОбъектовМетаданных.НайтиПоРеквизиту("ПолноеИмя", "Документ." + ВидДокумента);
		Организация				= ОснованиеСтруктура["Организация"];
		РеквизитыТиповойОперацииПоУмолчанию = БухгалтерскиеОперацииСервер.РеквизитыТиповойОперацииПоУмолчанию(ИдентификаторДокумента, ТиповаяОперация, Организация);
		
		// Таблица "Отметки" для текущего вида документов
		ТаблицаОтметкиТекущийВид = ТаблицаОтметки.СкопироватьКолонки();
		Для Каждого СтрокаТаблицы Из ТаблицаДанныеДокументов Цикл
			НоваяСтрока = ТаблицаОтметкиТекущийВид.Добавить();
			НоваяСтрока["ВидДокумента"] = ВидДокумента;
			Для Каждого Элем Из НастройкиМеханизма["ТаблицаОтметки"]["Колонки"][ВидДокумента] Цикл
				ИмяКолонки				= Элем.Ключ;
				ИмяРеквизита			= Элем.Значение;
				
				КолонкаИспользуется = НЕ (ИспользуемыеКолонокиТаблицыОтметки.Найти(ИмяКолонки) = Неопределено);
				Если НЕ КолонкаИспользуется Тогда
					Продолжить;
				КонецЕсли;
				
				ПринадлежностьКолонки	= ПринадлежностьКолонок[ИмяКолонки];
				МестоВДокументе			= ПринадлежностьКолонки[ВидДокумента];
				
				Если ЗначениеЗаполнено(ИмяРеквизита) Тогда
					ЭтоРеквизитШапки = НЕ (ДанныеДляНовыхДокументов["РеквизитыШапкиНовый"].Найти(ИмяРеквизита) = Неопределено);
					Если ЭтоРеквизитШапки Тогда
						ЗначениеЯчейки = СтрокаТаблицы[ИмяРеквизита];
					Иначе
						ЗначениеЯчейки = "";
					КонецЕсли;
				Иначе
					ЗначениеЯчейки = ОбозначениеНесколькихЗначений;
				КонецЕсли;
				
				Если МестоВДокументе["Шапка"] Тогда
					ИмяЗаполняемойКолонки = ПрефиксыИменКолонок["Шапка"] + ИмяКолонки;
					НоваяСтрока[ИмяЗаполняемойКолонки] = ЗначениеЯчейки;
				КонецЕсли;
				
				Если МестоВДокументе["ТиповаяОперация"] Тогда
					ИмяЗаполняемойКолонки = ПрефиксыИменКолонок["ТиповаяОперация"] + ИмяКолонки;
					НоваяСтрока[ИмяЗаполняемойКолонки] = ЗначениеЯчейки;
					
					КолонкаДобавлена = НЕ (ИменаКолонокТиповойОперации.Найти(ИмяЗаполняемойКолонки) = Неопределено);
					Если НЕ КолонкаДобавлена Тогда
						ИменаКолонокТиповойОперации.Добавить(ИмяЗаполняемойКолонки)
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
			// Типовая операция
			// К явно устанавливаемым реквизитам добавляем значения по умолчанию
			ЗначенияДопРеквизитов = Новый Структура(РеквизитыТиповойОперацииСтрока);
			ЗаполнитьЗначенияСвойств(ЗначенияДопРеквизитов, СтрокаТаблицы);
			Для Каждого ЭлементРеквизит Из РеквизитыТиповойОперацииПоУмолчанию Цикл
				ЗначенияДопРеквизитов.Вставить(ЭлементРеквизит.Ключ, ЭлементРеквизит.Значение);
			КонецЦикла;
			ЗначенияРеквизитовТиповойОперации.Добавить(ЗначенияДопРеквизитов);
		КонецЦикла;
		
		// Поиск уже существующих документов текущего вида
		Если ПараметрыВводаНаОсновании["ИскатьСуществующиеДокументы"]
			И ТаблицаОтметкиТекущийВид.Количество() > 0 Тогда
			ЗаполнитьКолонкуДокСсылка(
				ТаблицаОтметкиТекущийВид,
				ДанныеДляНовыхДокументов,
				ВидДокумента,
				РеквизитыТиповойОперации);
		КонецЕсли;
		
		// Таблица "Отметки"
		Для Каждого СтрокаТаблицы Из ТаблицаОтметкиТекущийВид Цикл
			НоваяСтрока = ТаблицаОтметки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		КонецЦикла;
		
		// Искомые сведения для текущего вида документов
		ДанныеТекущегоВидаДокументов = Новый Структура();
		ДанныеТекущегоВидаДокументов.Вставить("ТаблицаДанныеДокументов",	ТаблицаДанныеДокументов);
		ДанныеТекущегоВидаДокументов.Вставить("РеквизитыШапкиНовый",		ДанныеДляНовыхДокументов["РеквизитыШапкиНовый"]);
		ДанныеТекущегоВидаДокументов.Вставить("ИмяТаблицыНовый",			ДанныеДляНовыхДокументов["ИмяТаблицыНовый"]);
		ДанныеТекущегоВидаДокументов.Вставить("ТиповаяОперация",			ТиповаяОперация);
		ДанныеТекущегоВидаДокументов.Вставить("РеквизитыТиповойОперации",	РеквизитыТиповойОперации);
		// Значения для реквизитов типовой операции возвращаем отдельно в явном виде,
		// чтобы можно было передать структуру значений в контексте клиента при открытии формы
		ДанныеТекущегоВидаДокументов.Вставить("ЗначенияРеквизитовТиповойОперации",	ЗначенияРеквизитовТиповойОперации);
		
		ДанныеНовыхДокументов.Вставить(ВидДокумента, ДанныеТекущегоВидаДокументов);
	КонецЦикла;
	
	Результат = Новый Структура();
	Результат.Вставить("ТаблицаОтметки",				ТаблицаОтметки);
	Результат.Вставить("ИменаКолонокТиповойОперации",	ИменаКолонокТиповойОперации);
	Результат.Вставить("ДанныеНовыхДокументов",			ДанныеНовыхДокументов);
	Результат.Вставить("СинонимыВидовДокументов",		СинонимыВидовДокументов);
	Результат.Вставить("КоличествоНовыхДокументов",		КоличествоНовыхДокументов);
	
	Возврат Результат;
	
КонецФункции

// Преобразует данные одного документа (основания) в данные документа(ов) другого одного вида.
//
// Параметры:
//	ДокументОснованиеСтруктура	- Структура	- содержит данные документа-основания
//									(шапку и табличную часть)
//	СвязиРеквизитов		- Соответствие	- связи (по именам) реквизитов
//		документа-основания с реквизитами новых документов.
//		Допустимо указывать имена реквизитов как шапки, так и табличной части,
//		в произвольном сочетании.
//		Но табличную часть можно указывать только одну (для основания и для новых документов).
//		Например:
//			Основание					Новые документы
//			("Организация", 			"Организация")
//			("КФО",						"Материалы.КФО")
//			("Недостачи.ЦМО",			"Материалы.ЦМО, ЦМО")  <-Можно указывать несколько реквизитов
//			("Недостачи.Номенклатура",	"Материалы.Номенклатура")
//
// 		Указывать дубли имен реквизитов документа-основания нельзя.
//		А дубли реквизитов новых документов - допустимы.
//		В этом случае имена разделяются запятой.
//
// Возврат:
//	Структура	- результат разбиения данных документа-основания.
//	Ключи:
//		ТаблицаДанныеДокументов	- Таблица значений	- данные для новых документов.
//							Каждая строка содержит данные для одного нового документа.
//							Колонки таблицы соответствуют реквизитам шапки и табличной части
//							новых документов (определяется из соответствия).
//		РеквизитыШапкиНовый		- Массив	- имена реквизитов шапки новых документов
//							(определяется из соответствия, если там указаны реквизиты шапки).
//		ИмяТаблицыНовый			- Строка	- имя табличной части новых документов
//							(определяется из соответствия, если там указаны реквизиты табличной части).
Функция ПреобразоватьВДокументыДругогоВида(НастройкиМеханизма, ДокументОснованиеСтруктура, ВидДокумента)
	
	Перем	ТаблицаОснование;
	
	// Используемые сокращения:
	//	Основание	- документ-основание
	//	Новый		- новый документ, создаваемый на основании
	
	СвязиРеквизитов = НастройкиМеханизма["РазбивкаДанных"][ВидДокумента]["СвязиРеквизитов"];
	
	ДетальныеНастройкиРазбиения = ПолучитьДетальныеНастройкиРазбиения(ДокументОснованиеСтруктура, СвязиРеквизитов);
	
	Если ДетальныеНастройкиРазбиения.Свойство("Ошибка") Тогда
		ВызватьИсключение ДетальныеНастройкиРазбиения["Ошибка"];
		Возврат Неопределено;
	КонецЕсли;
	
	// Возвращаемое значение
	Результат = Новый Структура();
	
	ТаблицаДанныеДокументов = ДетальныеНастройкиРазбиения["ПустаяТаблицаДанныеДокументов"];
	
	Если ДетальныеНастройкиРазбиения["ИспользуетсяТаблицаОснование"] Тогда
		ТаблицаОснование = ДокументОснованиеСтруктура[ДетальныеНастройкиРазбиения["ИмяТаблицыОснование"]];
	КонецЕсли;
	РеквизитыГруппировкиОснование	= ДетальныеНастройкиРазбиения["РеквизитыГруппировкиОснование"];
	
	Если РеквизитыГруппировкиОснование.Количество() = 0 Тогда
		// Получается единственный новый документ
		
		ДанныеНовогоДокумента = ПреобразоватьВОдинДокументДругогоВида(ДокументОснованиеСтруктура, ДетальныеНастройкиРазбиения, ТаблицаОснование);
		НоваяСтрока = ТаблицаДанныеДокументов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеНовогоДокумента["Реквизиты"]);
		Для Каждого ТабличнаяЧасть Из ДанныеНовогоДокумента["ТабличныеЧасти"] Цикл
			НоваяСтрока[ТабличнаяЧасть.Ключ] = ТабличнаяЧасть.Значение;
		КонецЦикла;
		
	Иначе
		// Получается несколько новых документов
		
		РеквизитыГруппировкиОснованиеСтрока = СтрСоединить(РеквизитыГруппировкиОснование, ",");
		ТаблицаОснованиеГруппировки = ТаблицаОснование.Скопировать();
		ТаблицаОснованиеГруппировки.Свернуть(РеквизитыГруппировкиОснованиеСтрока);
		
		Поиск = Новый Структура(РеквизитыГруппировкиОснованиеСтрока);
		Для Каждого СтрокаГруппировки Из ТаблицаОснованиеГруппировки Цикл
			ЗаполнитьЗначенияСвойств(Поиск, СтрокаГруппировки);
			ВыгружаемыеСтрокиОснование = ТаблицаОснование.НайтиСтроки(Поиск);
			
			ДанныеНовогоДокумента = ПреобразоватьВОдинДокументДругогоВида(ДокументОснованиеСтруктура, ДетальныеНастройкиРазбиения, ВыгружаемыеСтрокиОснование);
			НоваяСтрока = ТаблицаДанныеДокументов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеНовогоДокумента["Реквизиты"]);
			Для Каждого ТабличнаяЧасть Из ДанныеНовогоДокумента["ТабличныеЧасти"] Цикл
				НоваяСтрока[ТабличнаяЧасть.Ключ] = ТабличнаяЧасть.Значение;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	Результат.Вставить("ТаблицаДанныеДокументов",	ТаблицаДанныеДокументов);
	Результат.Вставить("РеквизитыШапкиНовый",		ДетальныеНастройкиРазбиения["РеквизитыШапкиНовый"]);
	Результат.Вставить("ИмяТаблицыНовый",			ДетальныеНастройкиРазбиения["ИмяТаблицыНовый"]);

	Возврат Результат;
	
КонецФункции

Функция ПреобразоватьВОдинДокументДругогоВида(ДокументОснованиеСтруктура, ДетальныеНастройкиРазбиения, ВыгружаемыеСтрокиОснование = Неопределено)
	
	Перем	ТаблицаНовый;
	
	// Возвращаемое значение
	Данные			= Новый Структура();
	Реквизиты		= Новый Структура();
	ТабличныеЧасти	= Новый Структура();
	
	Если ДетальныеНастройкиРазбиения["ИспользуетсяТаблицаНовый"] Тогда
		ТаблицаНовый = ДетальныеНастройкиРазбиения["ПустаяТаблицаНовый"].СкопироватьКолонки();
	КонецЕсли;
	
	// Шапка нового документа
	Для Каждого СоответствиеРеквизитов Из ДетальныеНастройкиРазбиения["СоответствиеРеквизитовШапкаШапка"] Цикл
		Реквизиты.Вставить(СоответствиеРеквизитов.Значение, ДокументОснованиеСтруктура[СоответствиеРеквизитов.Ключ]);
	КонецЦикла;
	Если ДетальныеНастройкиРазбиения["ИспользуетсяТаблицаОснование"] Тогда
		Для Каждого СоответствиеРеквизитов Из ДетальныеНастройкиРазбиения["СоответствиеРеквизитовТаблицаШапка"] Цикл
			Реквизиты.Вставить(СоответствиеРеквизитов.Значение, ВыгружаемыеСтрокиОснование[0][СоответствиеРеквизитов.Ключ]);
		КонецЦикла;
	КонецЕсли;
	
	// Таблица нового документа
	Если ДетальныеНастройкиРазбиения["ИспользуетсяТаблицаНовый"] Тогда
		Если ДетальныеНастройкиРазбиения["ИспользуетсяТаблицаОснование"] Тогда
			Для Каждого СтрокаТаблицы Из ВыгружаемыеСтрокиОснование Цикл
				НоваяСтрока = ТаблицаНовый.Добавить();
				
				Для Каждого СоответствиеРеквизитов Из ДетальныеНастройкиРазбиения["СоответствиеРеквизитовШапкаТаблица"] Цикл
					НоваяСтрока[СоответствиеРеквизитов.Значение] = ДокументОснованиеСтруктура[СоответствиеРеквизитов.Ключ];
				КонецЦикла;
				Для Каждого СоответствиеРеквизитов Из ДетальныеНастройкиРазбиения["СоответствиеРеквизитовТаблицаТаблица"] Цикл
					НоваяСтрока[СоответствиеРеквизитов.Значение] = СтрокаТаблицы[СоответствиеРеквизитов.Ключ];
				КонецЦикла;
			КонецЦикла;
		Иначе
			НоваяСтрока = ТаблицаНовый.Добавить();
			
			Для Каждого СоответствиеРеквизитов Из ДетальныеНастройкиРазбиения["СоответствиеРеквизитовШапкаТаблица"] Цикл
				НоваяСтрока[СоответствиеРеквизитов.Значение] = ДокументОснованиеСтруктура[СоответствиеРеквизитов.Ключ];
			КонецЦикла;
			
		КонецЕсли;
	КонецЕсли;
	
	Если ДетальныеНастройкиРазбиения["ИспользуетсяТаблицаНовый"] Тогда
		ТабличныеЧасти.Вставить(ДетальныеНастройкиРазбиения["ИмяТаблицыНовый"], ТаблицаНовый);
	КонецЕсли;
	
	Данные.Вставить("Реквизиты",		Реквизиты);
	Данные.Вставить("ТабличныеЧасти",	ТабличныеЧасти);
	
	Возврат Данные;
	
КонецФункции

Функция ПолучитьДетальныеНастройкиРазбиения(ДокументОснованиеСтруктура, СвязиРеквизитов)
	
	Перем	ИмяТаблицыОснование,
			ИмяТаблицыНовый;
			
	Результат = Новый Структура();
	
	ТипСтрока		= Новый ОписаниеТипов("Строка");
	ТипБулево		= Новый ОписаниеТипов("Булево");
	
	ТаблицаСоответствиеРеквизитов = Новый ТаблицаЗначений();
	ТаблицаСоответствиеРеквизитов.Колонки.Добавить("ИмяРеквизитаОснование",				ТипСтрока);
	ТаблицаСоответствиеРеквизитов.Колонки.Добавить("ЭтоРеквизитТаблицыОснование",		ТипБулево);
	ТаблицаСоответствиеРеквизитов.Колонки.Добавить("ЭтоРеквизитГруппировкиОснование",	ТипБулево);
	ТаблицаСоответствиеРеквизитов.Колонки.Добавить("ИмяТаблицыОснование",				ТипСтрока);
	ТаблицаСоответствиеРеквизитов.Колонки.Добавить("ИмяРеквизитаНовый",					ТипСтрока);
	ТаблицаСоответствиеРеквизитов.Колонки.Добавить("ЭтоРеквизитТаблицыНовый",			ТипБулево);
	ТаблицаСоответствиеРеквизитов.Колонки.Добавить("ИмяТаблицыНовый",					ТипСтрока);
	
	РеквизитыГруппировкиОснование			= Новый Массив();
	СоответствиеРеквизитовШапкаШапка		= Новый Соответствие();
	СоответствиеРеквизитовШапкаТаблица		= Новый Соответствие();
	СоответствиеРеквизитовТаблицаШапка		= Новый Соответствие();
	СоответствиеРеквизитовТаблицаТаблица	= Новый Соответствие();
	
	// Заполняем таблицу настроек
	Для Каждого Элемент Из СвязиРеквизитов Цикл
		
		// В соответствии может быть указано несколько реквизитов нового документа
		ПолныеИменаРеквизитовНовый = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(Элемент.Значение, ", 	");
		
		Для Каждого ПолноеИмяРеквизитаНовый Из ПолныеИменаРеквизитовНовый Цикл
			ИменаРеквизитовОснование	= ВыделитьИменаРеквизитов(Элемент.Ключ);
			ИменаРеквизитовНовый		= ВыделитьИменаРеквизитов(ПолноеИмяРеквизитаНовый);
			
			// Нельзя дважды указывать один и тот же реквизит нового документа
			Поиск = Новый Структура();
			Поиск.Вставить("ИмяРеквизитаНовый",			ИменаРеквизитовНовый["ИмяРеквизита"]);
			Поиск.Вставить("ЭтоРеквизитТаблицыНовый",	ИменаРеквизитовНовый["ЭтоРеквизитТаблицы"]);
			Поиск.Вставить("ИмяТаблицыНовый",			ИменаРеквизитовНовый["ИмяТаблицы"]);
			Если ТаблицаСоответствиеРеквизитов.НайтиСтроки(Поиск).Количество() > 0 Тогда
				ПолноеИмяРеквизита = ?(ИменаРеквизитовНовый["ЭтоРеквизитТаблицы"],
					ИменаРеквизитовНовый["ИмяТаблицы"] + "." + ИменаРеквизитовНовый["ИмяРеквизита"],
					ИменаРеквизитовНовый["ИмяРеквизита"]);
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru='Повторно указан реквизит нового документа (%1)'"),
					ПолноеИмяРеквизита);
				Результат.Вставить("Ошибка", ТекстСообщения);
				// Выходим
				Возврат Результат;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ИменаРеквизитовОснование["ИмяТаблицы"]) Тогда
				ИмяТаблицыОснование	= ИменаРеквизитовОснование["ИмяТаблицы"];
			КонецЕсли;
			Если ЗначениеЗаполнено(ИменаРеквизитовНовый["ИмяТаблицы"]) Тогда
				ИмяТаблицыНовый		= ИменаРеквизитовНовый["ИмяТаблицы"];
			КонецЕсли;
			
			Если		НЕ ИменаРеквизитовОснование["ЭтоРеквизитТаблицы"] И НЕ ИменаРеквизитовНовый["ЭтоРеквизитТаблицы"] Тогда
				СоответствиеРеквизитовШапкаШапка.Вставить(ИменаРеквизитовОснование["ИмяРеквизита"], ИменаРеквизитовНовый["ИмяРеквизита"]);
				ЭтоРеквизитГруппировкиОснование = Ложь;
				
			ИначеЕсли	НЕ ИменаРеквизитовОснование["ЭтоРеквизитТаблицы"] И ИменаРеквизитовНовый["ЭтоРеквизитТаблицы"] Тогда
				СоответствиеРеквизитовШапкаТаблица.Вставить(ИменаРеквизитовОснование["ИмяРеквизита"], ИменаРеквизитовНовый["ИмяРеквизита"]);
				ЭтоРеквизитГруппировкиОснование = Ложь;
				
			ИначеЕсли	ИменаРеквизитовОснование["ЭтоРеквизитТаблицы"] И НЕ ИменаРеквизитовНовый["ЭтоРеквизитТаблицы"] Тогда
				СоответствиеРеквизитовТаблицаШапка.Вставить(ИменаРеквизитовОснование["ИмяРеквизита"], ИменаРеквизитовНовый["ИмяРеквизита"]);
				РеквизитыГруппировкиОснование.Добавить(ИменаРеквизитовОснование["ИмяРеквизита"]);
				ЭтоРеквизитГруппировкиОснование = Истина;
				
			ИначеЕсли	ИменаРеквизитовОснование["ЭтоРеквизитТаблицы"] И ИменаРеквизитовНовый["ЭтоРеквизитТаблицы"] Тогда
				СоответствиеРеквизитовТаблицаТаблица.Вставить(ИменаРеквизитовОснование["ИмяРеквизита"], ИменаРеквизитовНовый["ИмяРеквизита"]);
				ЭтоРеквизитГруппировкиОснование = Ложь;
				
			КонецЕсли;
			
			НоваяСтрока = ТаблицаСоответствиеРеквизитов.Добавить();
			НоваяСтрока["ИмяРеквизитаОснование"]			= ИменаРеквизитовОснование["ИмяРеквизита"];
			НоваяСтрока["ЭтоРеквизитТаблицыОснование"]		= ИменаРеквизитовОснование["ЭтоРеквизитТаблицы"];
			НоваяСтрока["ИмяТаблицыОснование"]				= ИмяТаблицыОснование;
			НоваяСтрока["ЭтоРеквизитГруппировкиОснование"]	= ЭтоРеквизитГруппировкиОснование;
			НоваяСтрока["ИмяРеквизитаНовый"]				= ИменаРеквизитовНовый["ИмяРеквизита"];
			НоваяСтрока["ЭтоРеквизитТаблицыНовый"]			= ИменаРеквизитовНовый["ЭтоРеквизитТаблицы"];
			НоваяСтрока["ИмяТаблицыНовый"]					= ИмяТаблицыНовый;
		КонецЦикла;
		
	КонецЦикла;
	
	// Задаем типы колонок таблицы нового документа
	ПустаяТаблицаНовый = Новый ТаблицаЗначений();
	Если ЗначениеЗаполнено(ИмяТаблицыНовый) Тогда
		Если ЗначениеЗаполнено(ИмяТаблицыОснование) Тогда
			ТаблицаОснование = ДокументОснованиеСтруктура[ИмяТаблицыОснование];
		КонецЕсли;
		
		Поиск = Новый Структура("ЭтоРеквизитТаблицыНовый", Истина);
		МассивСтрок = ТаблицаСоответствиеРеквизитов.НайтиСтроки(Поиск);
		Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
			ИмяРеквизитаОснование = СтрокаТаблицы["ИмяРеквизитаОснование"];
			Если СтрокаТаблицы["ЭтоРеквизитТаблицыОснование"] Тогда
				ТипКолонки = ТаблицаОснование.Колонки.Найти(ИмяРеквизитаОснование).ТипЗначения;
			Иначе
				МассивТипов = Новый Массив();
				МассивТипов.Добавить(ТипЗнч(ДокументОснованиеСтруктура[ИмяРеквизитаОснование]));
				ТипКолонки = Новый ОписаниеТипов(МассивТипов);
			КонецЕсли;
			
			ПустаяТаблицаНовый.Колонки.Добавить(СтрокаТаблицы["ИмяРеквизитаНовый"], ТипКолонки);
		КонецЦикла;
	КонецЕсли;
	
	// Задаем типы колонок таблицы с данными новых документов
	ПустаяТаблицаДанныеДокументов = Новый ТаблицаЗначений();
	Если ЗначениеЗаполнено(ИмяТаблицыОснование) Тогда
		ТаблицаОснование = ДокументОснованиеСтруктура[ИмяТаблицыОснование];
	КонецЕсли;
	Поиск = Новый Структура("ЭтоРеквизитТаблицыНовый", Ложь);
	МассивСтрок = ТаблицаСоответствиеРеквизитов.НайтиСтроки(Поиск);
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		ИмяРеквизитаОснование = СтрокаТаблицы["ИмяРеквизитаОснование"];
		Если СтрокаТаблицы["ЭтоРеквизитТаблицыОснование"] Тогда
			ТипКолонки = ТаблицаОснование.Колонки.Найти(ИмяРеквизитаОснование).ТипЗначения;
		Иначе
			МассивТипов = Новый Массив();
			МассивТипов.Добавить(ТипЗнч(ДокументОснованиеСтруктура[ИмяРеквизитаОснование]));
			ТипКолонки = Новый ОписаниеТипов(МассивТипов);
		КонецЕсли;
		ПустаяТаблицаДанныеДокументов.Колонки.Добавить(СтрокаТаблицы["ИмяРеквизитаНовый"], ТипКолонки);
	КонецЦикла;
	// Добавляем колонки для табличной части
	Если ЗначениеЗаполнено(ИмяТаблицыНовый) Тогда
		ПустаяТаблицаДанныеДокументов.Колонки.Добавить(ИмяТаблицыНовый, Новый ОписаниеТипов("ТаблицаЗначений"));
	КонецЕсли;
	
	Поиск = Новый Структура("ЭтоРеквизитТаблицыНовый", Ложь);
	РеквизитыШапкиНовый = ТаблицаСоответствиеРеквизитов.Скопировать(
		ТаблицаСоответствиеРеквизитов.НайтиСтроки(Поиск), "ИмяРеквизитаНовый").ВыгрузитьКолонку("ИмяРеквизитаНовый");
	
	//Результат.Вставить("ТаблицаСоответствиеРеквизитов",	ТаблицаСоответствиеРеквизитов);
	
	Результат.Вставить("ИмяТаблицыОснование",			ИмяТаблицыОснование);
	Результат.Вставить("ИмяТаблицыНовый",				ИмяТаблицыНовый);
	Результат.Вставить("ИспользуетсяТаблицаОснование",	ЗначениеЗаполнено(ИмяТаблицыОснование));
	Результат.Вставить("РеквизитыГруппировкиОснование",	РеквизитыГруппировкиОснование);
	Результат.Вставить("ИспользуетсяТаблицаНовый",		ЗначениеЗаполнено(ИмяТаблицыНовый));
	Результат.Вставить("ПустаяТаблицаНовый",			ПустаяТаблицаНовый);
	Результат.Вставить("ПустаяТаблицаДанныеДокументов",	ПустаяТаблицаДанныеДокументов);
	
	Результат.Вставить("РеквизитыШапкиНовый",					РеквизитыШапкиНовый);
	Результат.Вставить("СоответствиеРеквизитовШапкаШапка",		СоответствиеРеквизитовШапкаШапка);
	Результат.Вставить("СоответствиеРеквизитовШапкаТаблица",	СоответствиеРеквизитовШапкаТаблица);
	Результат.Вставить("СоответствиеРеквизитовТаблицаШапка",	СоответствиеРеквизитовТаблицаШапка);
	Результат.Вставить("СоответствиеРеквизитовТаблицаТаблица",	СоответствиеРеквизитовТаблицаТаблица);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьИменаИспользуемыхРеквизитовДокументаОснования(НастройкиМеханизма, ИспользуемыеВидыДокументов = Неопределено)
	
	ВсеРеквизиты			= Новый Массив();
	ВсеРеквизитыСтрокой		= "";
	РеквизитыШапки			= Новый Массив();
	РеквизитыШапкиСтрокой	= "";
	
	ПроверятьВидДокумента = НЕ (ИспользуемыеВидыДокументов = Неопределено);
	
	Для Каждого Элем Из НастройкиМеханизма["РазбивкаДанных"] Цикл
		ВидДокумента			= Элем.Ключ;
		СвязиРеквизитов	= Элем.Значение["СвязиРеквизитов"];

		Если ПроверятьВидДокумента Тогда
			ВидДокументаИспользуется = НЕ (ИспользуемыеВидыДокументов.Найти(ВидДокумента) = Неопределено);
		Иначе
			ВидДокументаИспользуется = Истина;
		КонецЕсли;
		
		Если ВидДокументаИспользуется Тогда
			Для Каждого ЭлемСоответствие Из СвязиРеквизитов Цикл
				ИменаРеквизитов = ВыделитьИменаРеквизитов(ЭлемСоответствие.Ключ);
				
				Если ИменаРеквизитов["ЭтоРеквизитТаблицы"] Тогда
					ИмяРеквизита = ИменаРеквизитов["ИмяТаблицы"] + "." + ИменаРеквизитов["ИмяРеквизита"];
					РеквизитУчтен = НЕ (ВсеРеквизиты.Найти(ИмяРеквизита) = Неопределено);
					
					Если НЕ РеквизитУчтен Тогда
						ВсеРеквизиты.Добавить(ИмяРеквизита);
						ВсеРеквизитыСтрокой = ?(ЗначениеЗаполнено(ВсеРеквизитыСтрокой), ВсеРеквизитыСтрокой + ",", "")
							+ ИмяРеквизита;
					КонецЕсли;
				Иначе
					ИмяРеквизита = ИменаРеквизитов["ИмяРеквизита"];
					РеквизитУчтен = НЕ (ВсеРеквизиты.Найти(ИмяРеквизита) = Неопределено);
					
					Если НЕ РеквизитУчтен Тогда
						ВсеРеквизиты.Добавить(ИмяРеквизита);
						ВсеРеквизитыСтрокой = ?(ЗначениеЗаполнено(ВсеРеквизитыСтрокой), ВсеРеквизитыСтрокой+ ",", "")
							+ ИмяРеквизита;
						
						РеквизитыШапки.Добавить(ИмяРеквизита);
						РеквизитыШапкиСтрокой = ?(ЗначениеЗаполнено(РеквизитыШапкиСтрокой), РеквизитыШапкиСтрокой+ ",", "")
							+ ИмяРеквизита;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Результат = Новый Структура();
	Результат.Вставить("ВсеРеквизиты",			ВсеРеквизиты);
	Результат.Вставить("ВсеРеквизитыСтрокой",	ВсеРеквизитыСтрокой);
	Результат.Вставить("РеквизитыШапки",		РеквизитыШапки);
	Результат.Вставить("РеквизитыШапкиСтрокой",	РеквизитыШапкиСтрокой);
	
	Возврат Результат;
	
КонецФункции

Функция ВыделитьИменаРеквизитов(ПолноеИмяРеквизита)
	
	инд = Найти(ПолноеИмяРеквизита, ".");
	Если инд > 0 Тогда
		ЭтоРеквизитТаблицы	= Истина;
		ИмяРеквизита		= Сред(ПолноеИмяРеквизита, инд + 1);
		ИмяТаблицы			= Лев(ПолноеИмяРеквизита, инд - 1);
	Иначе
		ЭтоРеквизитТаблицы	= Ложь;
		ИмяРеквизита		= ПолноеИмяРеквизита;
		ИмяТаблицы			= "";
	КонецЕсли;
	
	Результат = Новый Структура();
	Результат.Вставить("ИмяРеквизита",			ИмяРеквизита);
	Результат.Вставить("ЭтоРеквизитТаблицы",	ЭтоРеквизитТаблицы);
	Результат.Вставить("ИмяТаблицы",			ИмяТаблицы);
	
	Возврат Результат;
	
КонецФункции

Функция ОпределитьПринадлежностьКолонок(НастройкиМеханизма,
										ИспользуемыеКолонокиТаблицыОтметки,
										ИспользуемыеВидыДокументов)
	Перем МестоВДокументе;
	
	// Настраиваем состав колонок таблицы "Отметки" следующим образом.
	// Относим каждую колонку либо к реквизитам шапки, либо к реквизитам типовой операции, либо к обоим группам.
	// Принадлежность колонки определяется реквизитами, которые выводятся в ней.
	// Если есть реквизиты, принадлежащие шапке документа, то колонка выводится в группе "Шапка".
	// Если есть реквизиты, принадлежащие типовой операции, то колонка выводится в группе "Типовая операция".
	// Если в одной колонке настроен вывод как реквизитов шапки, так и типовой операции,
	// то используем 2 одноименные колонки, одну в группе "Шапка", вторую в группе "Типовая операция".
	ПринадлежностьКолонок = Новый Соответствие();
	
	Для Каждого ВидДокумента Из ИспользуемыеВидыДокументов Цикл
		СоответствиеКолонкиРеквизиты	= НастройкиМеханизма["ТаблицаОтметки"]["Колонки"][ВидДокумента];
		СвязиРеквизитов					= НастройкиМеханизма["РазбивкаДанных"][ВидДокумента];
		
		МассивРеквизитовТиповыхОпераций	= Новый Массив();
		МассивРеквизитовШапки			= Новый Массив();
		
		Для Каждого ИмяКолонки Из ИспользуемыеКолонокиТаблицыОтметки Цикл
			ПринадлежностьКолонки = ПринадлежностьКолонок[ИмяКолонки];
			Если ПринадлежностьКолонки = Неопределено Тогда
				ПринадлежностьКолонки = Новый Структура();
				ПринадлежностьКолонки.Вставить("Шапка",				Ложь);
				ПринадлежностьКолонки.Вставить("ТиповаяОперация",	Ложь);
			КонецЕсли;
			
			МестоВДокументе = Новый Структура();
			МестоВДокументе.Вставить("Шапка",			Ложь);
			МестоВДокументе.Вставить("ТиповаяОперация",	Ложь);
			
			ПолноеИмяРеквизитаНовыйДокумент	= СоответствиеКолонкиРеквизиты[ИмяКолонки];
			
			ЭтоРеквизитТиповойОперации = НЕ (СвязиРеквизитов["РеквизитыТиповойОперации"].Найти(ПолноеИмяРеквизитаНовыйДокумент) = Неопределено);
			Если ЭтоРеквизитТиповойОперации Тогда
				ИмяРеквизитаПринадлежностиКолонки = "ТиповаяОперация";
			Иначе
				ИмяРеквизитаПринадлежностиКолонки = "Шапка";
			КонецЕсли;
			МестоВДокументе.Вставить(ИмяРеквизитаПринадлежностиКолонки, Истина);
			
			ПринадлежностьКолонки.Вставить(ВидДокумента, МестоВДокументе);
			ПринадлежностьКолонки.Вставить(ИмяРеквизитаПринадлежностиКолонки, Истина);
			ПринадлежностьКолонок.Вставить(ИмяКолонки, ПринадлежностьКолонки);
		КонецЦикла;
	КонецЦикла;
	
	Возврат ПринадлежностьКолонок;
	
КонецФункции

Функция ПолучитьПустуюТаблицуОтметки(НастройкиМеханизма, ПринадлежностьКолонок, ПрефиксыИменКолонок)
	
	Перем ЗаголовокКолонки;
	
	ТаблицаОтметки	= Новый ТаблицаЗначений();
	ТипКолонки		= Новый ОписаниеТипов("Строка");
	
	// Служебные фиксированные колонки
	ТаблицаОтметки.Колонки.Добавить("ДокСсылка");
	ТаблицаОтметки.Колонки.Добавить("ВидДокумента", ТипКолонки);
	
	// Колонки, определенные для видов документов
	Для Каждого Элем Из ПринадлежностьКолонок Цикл
		ИмяКолонки				= Элем.Ключ;
		ПринадлежностьКолонки	= Элем.Значение;
		Если НЕ НастройкиМеханизма["ТаблицаОтметки"]["ЗаголовкиКолонок"].Свойство(ИмяКолонки, ЗаголовокКолонки) Тогда
			ЗаголовокКолонки = ИмяКолонки;
		КонецЕсли;
		
		Если ПринадлежностьКолонки["Шапка"] Тогда
			НовоеИмяКолонки = ПрефиксыИменКолонок["Шапка"] + ИмяКолонки;
			ТаблицаОтметки.Колонки.Добавить(НовоеИмяКолонки, ТипКолонки, ЗаголовокКолонки);
		КонецЕсли;
		
		Если ПринадлежностьКолонки["ТиповаяОперация"] Тогда
			НовоеИмяКолонки = ПрефиксыИменКолонок["ТиповаяОперация"] + ИмяКолонки;
			ТаблицаОтметки.Колонки.Добавить(НовоеИмяКолонки, ТипКолонки, ЗаголовокКолонки);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТаблицаОтметки;
	
КонецФункции

Функция ПолучитьИменаКолонокТаблицыОтметки(НастройкиМеханизма, ИспользуемыеВидыДокументов = Неопределено)
	
	ИменаКолонок = Новый Массив();
	
	ПроверятьВидДокумента = НЕ (ИспользуемыеВидыДокументов = Неопределено);
	
	Для Каждого Элем Из НастройкиМеханизма["ТаблицаОтметки"]["Колонки"] Цикл
		ВидДокумента	= Элем.Ключ;
		ОписаниеКолонок	= Элем.Значение;
		
		Если ПроверятьВидДокумента Тогда
			ВидДокументаИспользуется = НЕ (ИспользуемыеВидыДокументов.Найти(ВидДокумента) = Неопределено);
		Иначе
			ВидДокументаИспользуется = Истина;
		КонецЕсли;
		
		Если ВидДокументаИспользуется Тогда
			Для Каждого ЭлементКолонка Из ОписаниеКолонок Цикл
				ИмяКолонки = ЭлементКолонка.Ключ;
				
				КолонкаДобавлена = НЕ (ИменаКолонок.Найти(ИмяКолонки) = Неопределено);
				Если НЕ КолонкаДобавлена Тогда
					ИменаКолонок.Добавить(ИмяКолонки);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ИменаКолонок;
	
КонецФункции

Процедура ЗаполнитьКолонкуДокСсылка(ТаблицаОтметки, ДанныеДляНовыхДокументов, ВидДокумента, РеквизитыТиповойОперации);
	
	ТаблицаДанныеДокументов	= ДанныеДляНовыхДокументов["ТаблицаДанныеДокументов"];
	РеквизитыШапкиНовый		= ДанныеДляНовыхДокументов["РеквизитыШапкиНовый"];
	ОбщегоНазначенияБГУ.ПронумероватьТаблицуЗначений(ТаблицаДанныеДокументов, "НомерСтроки");
	
	// Разделим реквизиты текущего вида документа на реквизиты шапки документа и типовой операции
	РеквизитыДокумента			= Новый Массив(); // считаем, что всегда будет хотя бы один реквизит документа
	Для Каждого ИмяРеквизита Из РеквизитыШапкиНовый Цикл
		Если РеквизитыТиповойОперации.Найти(ИмяРеквизита) = Неопределено Тогда
			РеквизитыДокумента.Добавить(ИмяРеквизита);
		КонецЕсли;
	КонецЦикла;
	
	// Настраиваем запрос
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ТЗ", ТаблицаДанныеДокументов);
	
	ТекстЗапроса_ВыбратьИзТЗ				= "";
	ТекстЗапроса_Выбрать0					= "";
	ТекстЗапроса_Соединение0				= "";
	ТекстЗапроса_ИндексироватьПо0			= "";
	ТекстЗапроса_ВыбратьА0					= "";
	ТекстЗапроса_СоединениеА1				= "";
	ТекстЗапроса_СгруппироватьПоБ0			= "";
	
	// Все реквизиты шапки (и документа, и типовой операции)
	Для Каждого ИмяРеквизита Из РеквизитыШапкиНовый Цикл
		ТекстЗапроса_ВыбратьИзТЗ = ТекстЗапроса_ВыбратьИзТЗ
			+ ?(ЗначениеЗаполнено(ТекстЗапроса_ВыбратьИзТЗ),
				",
				|	",
				"")
			+ "ТЗ." + ИмяРеквизита + "	КАК " + ИмяРеквизита;
		
		ТекстЗапроса_Выбрать0	= ТекстЗапроса_Выбрать0
			+ ?(ЗначениеЗаполнено(ТекстЗапроса_Выбрать0),
				",
				|	",
				"")
			+ "РеквизитыШапки." + ИмяРеквизита;
			
		ТекстЗапроса_ИндексироватьПо0 = ТекстЗапроса_ИндексироватьПо0
			+ ?(ЗначениеЗаполнено(ТекстЗапроса_ИндексироватьПо0),
				",
				|	",
				"")
			+ "ТЗ." + ИмяРеквизита;
			
		ТекстЗапроса_СгруппироватьПоБ0 = ТекстЗапроса_СгруппироватьПоБ0
			+ ?(ЗначениеЗаполнено(ТекстЗапроса_СгруппироватьПоБ0),
				",
				|	",
				"")
			+ "РеквизитыШапкиИДатыПоследнихДокументов." + ИмяРеквизита;
	КонецЦикла;
	
	// Только реквизиты документа
	Для Каждого ИмяРеквизита Из РеквизитыДокумента Цикл
		ТекстЗапроса_Соединение0	= ТекстЗапроса_Соединение0
			+ ?(ЗначениеЗаполнено(ТекстЗапроса_Соединение0),
				"
				|		И ",
				"")
			+ "РеквизитыШапки." + ИмяРеквизита + " = Док." + ИмяРеквизита;
	КонецЦикла;
	
	ТекстЗапроса = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. (Подготовка) Все реквизиты шапки (и документа, и операции)
	|//
	|ВЫБРАТЬ
	|	ТЗ.НомерСтроки	КАК НомерСтроки,
	|	<ВыбратьИзТЗ>
	|ПОМЕСТИТЬ
	|	РеквизитыШапки
	|ИЗ
	|	&ТЗ	КАК ТЗ
	|ИНДЕКСИРОВАТЬ ПО
	|	ТЗ.НомерСтроки,
	|	<ИндексироватьПо0>
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Уже существующие документы, найденные по совпадению реквизитов документа
	|//		Возможно наличие нескольких документов с совпадающими реквизитами
	|ВЫБРАТЬ
	|	РеквизитыШапки.НомерСтроки	КАК НомерСтроки,
	|	Док.Ссылка					КАК _ДокСсылка,
	|	Док.Дата					КАК _ДокДата,
	|	<Выбрать0>
	|ПОМЕСТИТЬ
	|	ДокументыНайденныеПоРеквизитамДокумента
	|ИЗ
	|	РеквизитыШапки
	|	ЛЕВОЕ СОЕДИНЕНИЕ	Документ.<ВидДокумента>	КАК Док
	|		ПО	<Соединение0>
	|ГДЕ
	|	НЕ Док.ПометкаУдаления
	|ИНДЕКСИРОВАТЬ ПО
	|	РеквизитыШапки.НомерСтроки,
	|	<Выбрать0>
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Даты самых последних документов из уже существующих
	|//
	|ВЫБРАТЬ
	|	РеквизитыШапки.*,
	|	МАКСИМУМ(ДокументыНайденныеПоРеквизитамДокумента._ДокДата)	КАК _ДокДата
	|ПОМЕСТИТЬ
	|	РеквизитыШапкиИДатыПоследнихДокументов
	|ИЗ
	|	РеквизитыШапки
	|	ЛЕВОЕ СОЕДИНЕНИЕ	ДокументыНайденныеПоРеквизитамДокумента
	|		ПО	РеквизитыШапки.НомерСтроки = ДокументыНайденныеПоРеквизитамДокумента.НомерСтроки
	|СГРУППИРОВАТЬ ПО
	|	РеквизитыШапки.НомерСтроки,
	|	<Выбрать0> //РеквизитыШапки.*
	|ИНДЕКСИРОВАТЬ ПО
	|	РеквизитыШапки.НомерСтроки
	|;
	|";
	
	Если РеквизитыТиповойОперации.Количество() > 0 Тогда
		// Есть реквизиты, принадлежащие типовой операции.
		// Добавляем поиск документов по ним.
		
		ЗапросПоиск.УстановитьПараметр("РеквизитыТиповойОперации", РеквизитыТиповойОперации);
		
		Для Каждого ИмяРеквизита Из РеквизитыТиповойОперации Цикл
			ТекстЗапроса_ВыбратьА0 = ТекстЗапроса_ВыбратьА0
				+ ?(ЗначениеЗаполнено(ТекстЗапроса_ВыбратьА0),
					",
					|	",
					"")
				+ "МАКСИМУМ(ВЫБОР
				|	КОГДА РеквизитыОпераций.РеквизитОперации.ИмяДляФормулы = """ + ИмяРеквизита + """ ТОГДА
				|		РеквизитыОпераций.Значение
				|	ИНАЧЕ
				|		NULL
				|КОНЕЦ)	КАК " + ИмяРеквизита;
				
			ТекстЗапроса_СоединениеА1 = ТекстЗапроса_СоединениеА1
				+ ?(ЗначениеЗаполнено(ТекстЗапроса_СоединениеА1),
					"	И	
					|	",
					"")
				+ "РеквизитыШапкиИДатыПоследнихДокументов." + ИмяРеквизита + " = РеквизитыТиповыхОпераций." + ИмяРеквизита;
		КонецЦикла;
		
		ТекстЗапроса = ТекстЗапроса + "
		|////////////////////////////////////////////////////////////////////////////////
		|// [А0]. Значения реквизитов типовых операций уже существующих документов
		|//
		|ВЫБРАТЬ
		|	ДокументыНайденныеПоРеквизитамДокумента._ДокСсылка	КАК _ДокСсылка,
		|	<ВыбратьА0>
		|ПОМЕСТИТЬ
		|	РеквизитыТиповыхОпераций
		|ИЗ
		|	ДокументыНайденныеПоРеквизитамДокумента
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	РегистрСведений.ЗначенияДополнительныхРеквизитовОпераций	КАК РеквизитыОпераций
		|		ПО	ДокументыНайденныеПоРеквизитамДокумента._ДокСсылка = РеквизитыОпераций.Объект
		|		И	РеквизитыОпераций.РеквизитОперации.ИмяДляФормулы В (&РеквизитыТиповойОперации)
		|СГРУППИРОВАТЬ ПО
		|	ДокументыНайденныеПоРеквизитамДокумента._ДокСсылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|// [А1]. Уже существующие документы
		|//		(Финальная таблица)
		|ВЫБРАТЬ
		|	РеквизитыШапкиИДатыПоследнихДокументов.*,
		|	МАКСИМУМ(РеквизитыТиповыхОпераций._ДокСсылка)	КАК _ДокСсылка
		|ИЗ
		|	РеквизитыШапкиИДатыПоследнихДокументов
		|	ЛЕВОЕ СОЕДИНЕНИЕ	РеквизитыТиповыхОпераций
		|		ПО 	<СоединениеА1> // РеквизитыОперации
		|СГРУППИРОВАТЬ ПО
		|	РеквизитыШапкиИДатыПоследнихДокументов.НомерСтроки,
		|	РеквизитыШапкиИДатыПоследнихДокументов._ДокДата,
		|	<СгруппироватьПоА1> //РеквизитыШапкиИДатыПоследнихДокументов.*
		|УПОРЯДОЧИТЬ ПО
		|	РеквизитыШапкиИДатыПоследнихДокументов.НомерСтроки
		|;
		|";
		
	Иначе
		// Нет реквизитов, принадлежащих типовой операции.
		
		ТекстЗапроса = ТекстЗапроса + "
		|////////////////////////////////////////////////////////////////////////////////
		|// [Б0]. Уже существующие документы
		|//		(Финальная таблица)
		|ВЫБРАТЬ
		|	РеквизитыШапкиИДатыПоследнихДокументов.*,
		|	МАКСИМУМ(ДокументыНайденныеПоРеквизитамДокумента._ДокСсылка)	КАК _ДокСсылка
		|ИЗ
		|	РеквизитыШапкиИДатыПоследнихДокументов
		|	ЛЕВОЕ СОЕДИНЕНИЕ	ДокументыНайденныеПоРеквизитамДокумента
		|		ПО	РеквизитыШапкиИДатыПоследнихДокументов.НомерСтроки = ДокументыНайденныеПоРеквизитамДокумента.НомерСтроки
		|СГРУППИРОВАТЬ ПО
		|	<СгруппироватьПоБ0>, //РеквизитыШапкиИДатыПоследнихДокументов.*
		|	РеквизитыШапкиИДатыПоследнихДокументов.НомерСтроки,
		|	РеквизитыШапкиИДатыПоследнихДокументов._ДокДата
		|УПОРЯДОЧИТЬ ПО
		|	РеквизитыШапкиИДатыПоследнихДокументов.НомерСтроки
		|;
		|";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<ВыбратьИзТЗ>",		ТекстЗапроса_ВыбратьИзТЗ);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<ВидДокумента>",		ВидДокумента);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<Соединение0>",		ТекстЗапроса_Соединение0);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<ИндексироватьПо0>",	ТекстЗапроса_ИндексироватьПо0);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<Выбрать0>",			ТекстЗапроса_Выбрать0);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<ВыбратьА0>",			ТекстЗапроса_ВыбратьА0);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<СоединениеА1>",		ТекстЗапроса_СоединениеА1);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<СгруппироватьПоА1>",	ТекстЗапроса_СгруппироватьПоБ0);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "<СгруппироватьПоБ0>",	ТекстЗапроса_СгруппироватьПоБ0);
	
	ЗапросПоиск.Текст = ТекстЗапроса;
	МассивДокСсылка = ЗапросПоиск.Выполнить().Выгрузить().ВыгрузитьКолонку("_ДокСсылка");
	
	ТаблицаОтметки.ЗагрузитьКолонку(МассивДокСсылка, "ДокСсылка");
	
КонецПроцедуры


// Формирует описание колонок, которое полностью определяет заголовки и выражения каждой колонки.
// К колонкам, явно указанным в передаваемой таблице, добавляются фиксированные (общие) колонки:
//	Номер, Дата, Проведен, ПометкаУдаления, Комментарий
//
// Возвращаемое значение:
//	Структура	- содержит настройки каждой колонки, упоминаемой в переданной таблице
//	ИмяКолонки1
//		Заголовок колонки
//		(далее идут настройки для каждого вида документов из списка)
//		ВидДокумента1 - Выражение для текста запроса
//		ВидДокумента2 - Выражение для текста запроса
//		...
//		ВидДокументаN - Выражение для текста запроса
//			
//	ИмяКолонки2
//		Заголовок колонки
//		(далее идут настройки для каждого вида документов из списка)
//		ВидДокумента1 - Выражение для текста запроса
//		ВидДокумента2 - Выражение для текста запроса
//		...
//		ВидДокументаN - Выражение для текста запроса
//	и т.д.
Функция СоставитьПолноеОписаниеКолонок(НастройкиФормыСписка)
	
	Перем	ОписаниеКолонки,
			ВыражениеКолонки,
			ВыражениеФиксированнойКолонки;
	
	ТаблицаОписаниеКолонок = НастройкиФормыСписка["ТаблицаОписаниеКолонок"];
	
	// Фиксированные (общие) колонки, добавляемые к общему списку колонок
	//								Имя колонки			Выражение для текста запроса (обязательно заполненное)
	ФиксированныеКолонки = Новый Структура();
	ФиксированныеКолонки.Вставить("Номер",				"Номер");
	ФиксированныеКолонки.Вставить("Дата",				"Дата");
	ФиксированныеКолонки.Вставить("Проведен",			"Проведен");
	ФиксированныеКолонки.Вставить("ПометкаУдаления",	"ПометкаУдаления");
	ФиксированныеКолонки.Вставить("Ссылка",				"Ссылка");
	ФиксированныеКолонки.Вставить("Комментарий",		"ВЫРАЗИТЬ(Комментарий	КАК СТРОКА(200))");
	
	ВыражениеОтсутствующейКолонки = """-"""; //"НЕОПРЕДЕЛЕНО";
	
	СинонимыВидовДокументов		= Новый СписокЗначений();
	СтруктураОписаниеКолонок	= Новый Структура();
	
	Для Каждого СтрокаТаблицы Из ТаблицаОписаниеКолонок Цикл
		ВидДокумента		= СтрокаТаблицы["ВидДокумента"];
		ИмяКолонки			= СтрокаТаблицы["Имя"];
		ЗаголовокКолонки	= СтрокаТаблицы["Заголовок"];
		ВыражениеКолонки	= СтрокаТаблицы["Выражение"];
		
		// Обязательные для заполнения поля
		Если ПустаяСтрока(ВидДокумента) ИЛИ ПустаяСтрока(ИмяКолонки) Тогда
			Продолжить;
		КонецЕсли;
		
		// Синоним вида документа
		ЭлементСписка = СинонимыВидовДокументов.НайтиПоЗначению(ВидДокумента);
		Если ЭлементСписка = Неопределено Тогда
			Попытка
				СинонимВидаДокумента = Метаданные.Документы[ВидДокумента].Синоним;
				СинонимыВидовДокументов.Добавить(ВидДокумента, СинонимВидаДокумента);
			Исключение
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru='Указан неподдерживаемый вид документа %1'"),
					ВидДокумента);
				ВызватьИсключение ТекстСообщения;
			КонецПопытки;
		КонецЕсли;
		
		// Уже имеющиеся настройки колонки
		Если НЕ СтруктураОписаниеКолонок.Свойство(ИмяКолонки, ОписаниеКолонки) Тогда
			ОписаниеКолонки = Новый Структура();
			ОписаниеКолонки.Вставить("Заголовок",	"");
		КонецЕсли;
		
		Если ПустаяСтрока(ОписаниеКолонки["Заголовок"]) Тогда
			ОписаниеКолонки.Вставить("Заголовок",	ЗаголовокКолонки);
		КонецЕсли;
		
		ОписаниеКолонки.Вставить(ВидДокумента,	ВыражениеКолонки);
		
		СтруктураОписаниеКолонок.Вставить(ИмяКолонки, ОписаниеКолонки);
	КонецЦикла;
	
	// Донастраиваем выражения колонок
	// Явно указанное выражение колонки переопределяет стандартное выражение фиксированной колонки,
	// если колонка является фиксированной
	Для Каждого ЭлементСписка Из СинонимыВидовДокументов Цикл
		ВидДокумента = ЭлементСписка.Значение;
		
		Для Каждого ЭлементОписание Из СтруктураОписаниеКолонок Цикл
			ИмяКолонки		= ЭлементОписание.Ключ;
			ОписаниеКолонки	= ЭлементОписание.Значение;
			
			КолонкаУказанаДляВидаДокумента = ОписаниеКолонки.Свойство(ВидДокумента, ВыражениеКолонки);
			
			ЭтоФиксированнаяКолонка = ФиксированныеКолонки.Свойство(ИмяКолонки, ВыражениеФиксированнойКолонки);
			
			ИспользоватьВыражениеФиксированнойКолонки = ЭтоФиксированнаяКолонка И НЕ КолонкаУказанаДляВидаДокумента;
			
			Если ИспользоватьВыражениеФиксированнойКолонки Тогда
				ВыражениеКолонки = ВыражениеФиксированнойКолонки;
				
			ИначеЕсли КолонкаУказанаДляВидаДокумента Тогда
				Если ПустаяСтрока(ВыражениеКолонки) Тогда
					ВыражениеКолонки = ВидДокумента + "." + ИмяКолонки;
				КонецЕсли;
				
			Иначе
				ВыражениеКолонки = ВыражениеОтсутствующейКолонки;
				
			КонецЕсли;
			ОписаниеКолонки.Вставить(ВидДокумента, ВыражениеКолонки);
		КонецЦикла;
	КонецЦикла;
	
	// Добавляем фиксированные колонки
	Для Каждого ЭлементКолонка Из ФиксированныеКолонки Цикл
		ИмяКолонки			= ЭлементКолонка.Ключ;
		ВыражениеКолонки	= ЭлементКолонка.Значение;
		
		ЭтаКолонкаДобавлена = СтруктураОписаниеКолонок.Свойство(ИмяКолонки);
		Если НЕ ЭтаКолонкаДобавлена Тогда
			// Эта фиксированная колонка не переопределена ни для одного вида документов
			// Добавляем новую колонку
			ОписаниеКолонки = Новый Структура();
			ОписаниеКолонки.Вставить("Заголовок", ИмяКолонки);
			Для Каждого ЭлементСписка Из СинонимыВидовДокументов Цикл
				ВидДокумента = ЭлементСписка.Значение;
				ОписаниеКолонки.Вставить(ВидДокумента,	ВыражениеКолонки);
			КонецЦикла;
			СтруктураОписаниеКолонок.Вставить(ИмяКолонки, ОписаниеКолонки);
		КонецЕсли;
	КонецЦикла;
	
	// Донастраиваем заголовки колонок
	Для Каждого ЭлементОписание Из СтруктураОписаниеКолонок Цикл
		ИмяКолонки		= ЭлементОписание.Ключ;
		ОписаниеКолонки	= ЭлементОписание.Значение;
		
		Если ПустаяСтрока(ОписаниеКолонки["Заголовок"]) Тогда
			ОписаниеКолонки["Заголовок"] = ИмяКолонки;
		КонецЕсли;
	КонецЦикла;
	
	ОписаниеКолонок = Новый Структура();
	ОписаниеКолонок.Вставить("СтруктураОписаниеКолонок",	СтруктураОписаниеКолонок);
	ОписаниеКолонок.Вставить("СинонимыВидовДокументов",	СинонимыВидовДокументов);
	
	Возврат ОписаниеКолонок;
	
КонецФункции

Функция ОбработатьНастройкиФлажков(ПолноеОписаниеКолонок, Знач НастройкиФормыСписка)
	
	Перем	МассивФлажков,
			ИменаФлажков;
	
	СтруктураОписаниеКолонок	= ПолноеОписаниеКолонок["СтруктураОписаниеКолонок"];
	СинонимыВидовДокументов		= ПолноеОписаниеКолонок["СинонимыВидовДокументов"];
	
	// Опциональный параметр МассивФлажков
	НастройкиФормыСписка.Свойство("МассивФлажков", МассивФлажков);
	Если НЕ ТипЗнч(МассивФлажков) = Тип("Массив") Тогда
		МассивФлажков = Новый Массив();
	КонецЕсли;
	
	// Связь
	// ключ		- Вид документа
	// значение	- Имена флажков, структура вместо массива - для более легкого исключения дублей
	СвязьВидДокументаФлажки			= Новый Структура();
	
	СвязьВидДокументаИмяПараметра	= Новый Структура();
	ПараметрыЗапроса				= Новый Массив();
	
	// Исключим из настроек флажков те виды документов,
	// которые не упомянуты в описании колонок
	ИспользуемыеВидыДокументов	= Новый Структура(); // структура вместо массива - для более легкого исключения дублей
	ИспользуемыеФлажки			= Новый Массив();
	НомерФлажка = 0;
	Если МассивФлажков.Количество() > 0 Тогда
		Для Каждого ЭлементОписание Из МассивФлажков Цикл
			НомерФлажка		= НомерФлажка + 1;
			ИмяФлажка		= "Флажок" + Формат(НомерФлажка, "ЧГ=0");
			ВидыДокументов	= ЭлементОписание["ВидыДокументов"];
			Заголовок		= ЭлементОписание["Заголовок"];
			
			ЯвныеСогласованныеВидыДокументовФлажка = Новый Структура(); // структура вместо массива - для более легкого исключения дублей
			
			Если ВидыДокументов.Количество() > 0 Тогда
				Для Каждого ВидДокумента Из ВидыДокументов Цикл
					ВидДокументаПоддерживается = НЕ (СинонимыВидовДокументов.НайтиПоЗначению(ВидДокумента) = Неопределено);
					
					Если ВидДокументаПоддерживается Тогда
						ЯвныеСогласованныеВидыДокументовФлажка.Вставить(ВидДокумента);
						
						Если НЕ СвязьВидДокументаФлажки.Свойство(ВидДокумента, ИменаФлажков) Тогда
							ИменаФлажков = Новый Структура();
						КонецЕсли;
						ИменаФлажков.Вставить(ИмяФлажка);
						СвязьВидДокументаФлажки.Вставить(ВидДокумента, ИменаФлажков);
					Иначе
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
							НСтр("ru='Форма списка документов, введенных на основании
								|
								|Ошибка в настройках формы:
								|	один из флажков привязан к виду документов
								|	""%1"",
								|	который отсутствует в описании колонок
								|
								|Открытие формы отменено'"),
							ВидДокумента);
						ВызватьИсключение ТекстСообщения;
					КонецЕсли;
				КонецЦикла;
			Иначе
				// Флажок не связан явно ни с одним из видов документов.
				// Это означает выбор всех видов документов,
				// определенных в текущей области выборки.
				// Если далее область выборки видов документов сузится,
				// то потребуется удалить исключеные виды документов из связи.
				Для Каждого ЭлементСиноним Из СинонимыВидовДокументов Цикл
					ВидДокумента = ЭлементСиноним.Значение;
					Если НЕ СвязьВидДокументаФлажки.Свойство(ВидДокумента, ИменаФлажков) Тогда
						ИменаФлажков = Новый Структура();
					КонецЕсли;
					ИменаФлажков.Вставить(ИмяФлажка);
					СвязьВидДокументаФлажки.Вставить(ВидДокумента, ИменаФлажков);
				КонецЦикла;
				
			КонецЕсли;
			
			Если ВидыДокументов.Количество() > 0 И ЯвныеСогласованныеВидыДокументовФлажка.Количество() = 0 Тогда
				// Флажок не привязан ни к одному из используемых видов документов.
				// Но такой флажок не обозначает привязки ко всем видам документов из области выборки.
				// В принципе, его можно вообще не выводить и не использовать (удалить),
				// т.к. его значение ни на что не влияет.
				
				// Игнорируем, не считаем ошибкой
			КонецЕсли;
			
			// Общий список используемых видов документов
			Для Каждого Элем Из ЯвныеСогласованныеВидыДокументовФлажка Цикл
				ВидДокумента = Элем.Ключ;
				ИспользуемыеВидыДокументов.Вставить(ВидДокумента);
			КонецЦикла;
			
			ОписаниеФлажка = Новый Структура();
			ОписаниеФлажка.Вставить("Имя",			ИмяФлажка);
			ОписаниеФлажка.Вставить("Заголовок",	Заголовок);
			
			ИспользуемыеФлажки.Добавить(ОписаниеФлажка);
		КонецЦикла;
	КонецЕсли;
	
	ОбластьВыборкиЭтоОписаниеКолонок = (ИспользуемыеВидыДокументов.Количество() = 0);
	
	Если ОбластьВыборкиЭтоОписаниеКолонок Тогда
		// Варианты 1, 3
		
		// Завершаем настройку используемых видов документов.
		ИспользуемыеВидыДокументов = СинонимыВидовДокументов.ВыгрузитьЗначения();
		
		// Завершаем настройку параметров запроса.
		// Используем всего один параметр
		ИменаФлажков = Новый Массив();
		Для Каждого ЭлементФлажок Из ИспользуемыеФлажки Цикл
			ИменаФлажков.Добавить(ЭлементФлажок["Имя"]);
		КонецЦикла;
		
		ИмяПараметра = "ДокументОснованиеСсылка";
		
		ПараметрЗапроса = Новый Структура();
		ПараметрЗапроса.Вставить("ИмяПараметра",	ИмяПараметра);
		ПараметрЗапроса.Вставить("ИменаФлажков",	ИменаФлажков);
		
		ПараметрыЗапроса.Добавить(Новый ФиксированнаяСтруктура(ПараметрЗапроса));
		
		// Завершаем настройку связи.
		Для Каждого ВидДокумента Из ИспользуемыеВидыДокументов Цикл
			СвязьВидДокументаИмяПараметра.Вставить(ВидДокумента, ИмяПараметра);
		КонецЦикла;
	Иначе
		// Вариант 2
		
		// Завершаем настройку связи.
		// Удаляем исключаемые виды документов из-за возможного сужения
		// области выборки видов документов.
		УдаляемыеВидыДокументов = Новый Массив();
		Для Каждого ЭлементСвязь Из СвязьВидДокументаФлажки Цикл
			ВидДокумента = ЭлементСвязь.Ключ;
			ВидДокументаИсключен = НЕ ИспользуемыеВидыДокументов.Свойство(ВидДокумента);
			Если ВидДокументаИсключен Тогда
				УдаляемыеВидыДокументов.Добавить(ВидДокумента);
			КонецЕсли;
		КонецЦикла;
		Для Каждого ВидДокумента Из УдаляемыеВидыДокументов Цикл
			СвязьВидДокументаФлажки.Удалить(ВидДокумента);
		КонецЦикла;
	
		// Завершаем настройку используемых видов документов.
		// Преобразуем значение из структуры в массив (для удобства дальнейшего использования)
		ВремМассив = Новый Массив();
		Для Каждого Элем Из ИспользуемыеВидыДокументов Цикл
			ВремМассив.Добавить(Элем.Ключ);
		КонецЦикла;
		ИспользуемыеВидыДокументов = ВремМассив;
		
		// Завершаем настройку параметров запроса.
		// Используем несколько параметров, по количеству используемых видов документов
		Для Каждого ВидДокумента Из ИспользуемыеВидыДокументов Цикл
			СвязьВидДокументаФлажки.Свойство(ВидДокумента, ИменаФлажков);
			
			// Преобразуем значение из структуры в массив (для удобства дальнейшего использования)
			ВремМассив = Новый Массив();
			Для Каждого Элем Из ИменаФлажков Цикл
				ВремМассив.Добавить(Элем.Ключ);
			КонецЦикла;
			
			ИмяПараметра = "ДокументОснованиеСсылка_" + ВидДокумента;
			
			ПараметрЗапроса = Новый Структура();
			ПараметрЗапроса.Вставить("ИмяПараметра",	ИмяПараметра);
			ПараметрЗапроса.Вставить("ИменаФлажков",	ВремМассив);
			
			ПараметрыЗапроса.Добавить(Новый ФиксированнаяСтруктура(ПараметрЗапроса));
			
			СвязьВидДокументаИмяПараметра.Вставить(ВидДокумента, ИмяПараметра);
		КонецЦикла;
	КонецЕсли;
	
	ОбработанныеНастройкиФлажков = Новый Структура();
	ОбработанныеНастройкиФлажков.Вставить("ИспользуемыеВидыДокументов",		ИспользуемыеВидыДокументов);
	ОбработанныеНастройкиФлажков.Вставить("ИспользуемыеФлажки",				ИспользуемыеФлажки);
	ОбработанныеНастройкиФлажков.Вставить("ПараметрыЗапроса",				Новый ФиксированныйМассив(ПараметрыЗапроса));
	ОбработанныеНастройкиФлажков.Вставить("СвязьВидДокументаИмяПараметра",	СвязьВидДокументаИмяПараметра);
	
	Возврат ОбработанныеНастройкиФлажков;
	
КонецФункции

Процедура СоставитьТекстЗапросаДинамическогоСписка(ОбработанныеНастройкиФормыСписка)
	
	СтруктураОписаниеКолонок		= ОбработанныеНастройкиФормыСписка["СтруктураОписаниеКолонок"];
	СинонимыВидовДокументов			= ОбработанныеНастройкиФормыСписка["СинонимыВидовДокументов"];
	ИспользуемыеВидыДокументов		= ОбработанныеНастройкиФормыСписка["ИспользуемыеВидыДокументов"];
	СвязьВидДокументаИмяПараметра	= ОбработанныеНастройкиФормыСписка["СвязьВидДокументаИмяПараметра"];
	
	ТекстШаблонВыбратьДокументыВсехВидов = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВидДокумента			КАК ВидДокумента,
	|	СинонимВидаДокумента	КАК СинонимВидаДокумента,
	|	[СписокКолонок],
	|	ВЫБОР
	|		КОГДА ПометкаУдаления ТОГДА
	|			1	// картинка 'Документ помечен на удаление'
	|		ИНАЧЕ
	|			ВЫБОР
	|				КОГДА Проведен ТОГДА
	|					0	// картинка 'Документ проведен'
	|				ИНАЧЕ
	|					2	// картинка 'Документ не проведен'
	|			КОНЕЦ
	|		
	|	КОНЕЦ					КАК ИндексКартинки
	|ИЗ
	|	([ОбъединениеВыборок])	КАК ВТ";
	
	ТекстШаблонВыбратьДокументыОдногоВида = "
	|ВЫБРАТЬ
	|	""[ВидДокумента]""			КАК ВидДокумента,
	|	""[СинонимВидаДокумента]""	КАК СинонимВидаДокумента,
	|	[ВыраженияКолонок]
	|ИЗ
	|	Документ.[ВидДокумента]	КАК [ВидДокумента]
	|ГДЕ
	|	ДокументОснование = &[ИмяПараметра]";
	
	ТекстПереводСтроки = "
	|";
	
	ТекстОбъединить = "
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|";
	
	ТекстОбъединениеВыборок = "";
	
	Для Каждого ВидДокумента Из ИспользуемыеВидыДокументов Цикл
		ЭлементСиноним = СинонимыВидовДокументов.НайтиПоЗначению(ВидДокумента);
		СинонимВидаДокумента = ?(ЭлементСиноним = Неопределено, ВидДокумента, ЭлементСиноним.Представление);
		
		ТекстСписокКолонок		= "";
		ТекстВыраженияКолонок	= "";
		
		Для Каждого ЭлементОписание Из СтруктураОписаниеКолонок Цикл
			ИмяКолонки			= ЭлементОписание.Ключ;
			ОписаниеКолонки		= ЭлементОписание.Значение;
			ВыражениеКолонки	= ОписаниеКолонки[ВидДокумента];
			
			ТекстВыбратьИмя			= ИмяКолонки + "	КАК " + ИмяКолонки;
			ТекстСписокКолонок		= ТекстСписокКолонок
				+ ?(ЗначениеЗаполнено(ТекстСписокКолонок), "," + ТекстПереводСтроки + "	", "")
				+ ТекстВыбратьИмя;
			
			ТекстВыбратьВыражение	= ВыражениеКолонки + "	КАК " + ИмяКолонки;
			ТекстВыраженияКолонок	= ТекстВыраженияКолонок
				+ ?(ЗначениеЗаполнено(ТекстВыраженияКолонок), "," + ТекстПереводСтроки + "	", "")
				+ ТекстВыбратьВыражение;
		КонецЦикла;
		
		ИмяПараметра = СвязьВидДокументаИмяПараметра[ВидДокумента];
		
		ВставляемыеЗначения = Новый Структура();
		ВставляемыеЗначения.Вставить("ВидДокумента",			ВидДокумента);
		ВставляемыеЗначения.Вставить("СинонимВидаДокумента",	СинонимВидаДокумента);
		ВставляемыеЗначения.Вставить("ВыраженияКолонок",		ТекстВыраженияКолонок);
		ВставляемыеЗначения.Вставить("ИмяПараметра",			ИмяПараметра);
		ТекстВыбратьДокументыОдногоВида = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(
			ТекстШаблонВыбратьДокументыОдногоВида,
			ВставляемыеЗначения);
			
		ТекстОбъединениеВыборок = ТекстОбъединениеВыборок
			+ ?(ЗначениеЗаполнено(ТекстОбъединениеВыборок), ТекстОбъединить, "")
			+ ТекстВыбратьДокументыОдногоВида;
	КонецЦикла;
	
	ВставляемыеЗначения = Новый Структура();
	ВставляемыеЗначения.Вставить("СписокКолонок",		ТекстСписокКолонок);
	ВставляемыеЗначения.Вставить("ОбъединениеВыборок",	ТекстОбъединениеВыборок);
	ТекстЗапроса = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(
		ТекстШаблонВыбратьДокументыВсехВидов,
		ВставляемыеЗначения);
	
	ОбработанныеНастройкиФормыСписка.Вставить("ТекстЗапроса", ТекстЗапроса);
	
КонецПроцедуры

#КонецОбласти
