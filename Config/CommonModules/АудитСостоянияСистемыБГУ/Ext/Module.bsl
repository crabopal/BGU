Функция СформироватьТаблицуСчет_ВидКБК() Экспорт
	
	ТаблицаНастроек = Новый ТаблицаЗначений;
	ТаблицаНастроек.Колонки.Добавить("КодСчета", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(10)));
	ТаблицаНастроек.Колонки.Добавить("ВидКБК", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыКБК"));
	
	УстановитьПривилегированныйРежим(Истина);
	ДанныеСчетов = ПланыСчетов.ЕПСБУ.ПолучитьДанныеСчетов(,"Код,ВидыКПС");
	УстановитьПривилегированныйРежим(Ложь);
	
	Для Каждого ДанныеСчета Из ДанныеСчетов Цикл
		Для Каждого ВидКПС Из ДанныеСчета.ВидыКПС Цикл
			НоваяСтрока = ТаблицаНастроек.Добавить();
			НоваяСтрока.КодСчета = ДанныеСчета.Код;
			НоваяСтрока.ВидКБК = ВидКПС;
		КонецЦикла;
	КонецЦикла;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Таб.КодСчета,
	|	Таб.ВидКБК
	|ПОМЕСТИТЬ ТабНастроек
	|ИЗ
	|	&ТаблицаНастроек КАК Таб
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕПСБУ.Ссылка КАК Счет,
	|	ТабНастроек.ВидКБК
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТабНастроек КАК ТабНастроек
	|		ПО (ПОДСТРОКА(ЕПСБУ.Код, 1, 6) = ТабНастроек.КодСчета)
	|ГДЕ
	|	НЕ ЕПСБУ.ЭлементГруппа";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ТаблицаНастроек", ТаблицаНастроек);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция СформироватьТаблицыКОСГУ_Счет(ПроверкаРегистраБухгалтерии = Истина, НаДату = Неопределено) Экспорт
	
	ТаблицаНастроекКОСГУ = Новый ТаблицаЗначений;
	ТаблицаНастроекКОСГУ.Колонки.Добавить("КодСчета", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(6)));
	ТаблицаНастроекКОСГУ.Колонки.Добавить("КОСГУ", Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ТаблицаНастроекКОСГУ.Колонки.Добавить("ДатаНачалаДействия", Новый ОписаниеТипов("Дата"));
	ТаблицаНастроекКОСГУ.Колонки.Добавить("ДатаОкончанияДействия", Новый ОписаниеТипов("Дата"));
	
	ТаблицаНастроекКОСГУДт = Новый ТаблицаЗначений;
	ТаблицаНастроекКОСГУДт.Колонки.Добавить("КодСчета", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(6)));
	ТаблицаНастроекКОСГУДт.Колонки.Добавить("КОСГУДт", Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ТаблицаНастроекКОСГУДт.Колонки.Добавить("ДатаНачалаДействия", Новый ОписаниеТипов("Дата"));
	ТаблицаНастроекКОСГУДт.Колонки.Добавить("ДатаОкончанияДействия", Новый ОписаниеТипов("Дата"));
	
	ТаблицаНастроекКОСГУКт = Новый ТаблицаЗначений;
	ТаблицаНастроекКОСГУКт.Колонки.Добавить("КодСчета", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(6)));
	ТаблицаНастроекКОСГУКт.Колонки.Добавить("КОСГУКт", Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ТаблицаНастроекКОСГУКт.Колонки.Добавить("ДатаНачалаДействия", Новый ОписаниеТипов("Дата"));
	ТаблицаНастроекКОСГУКт.Колонки.Добавить("ДатаОкончанияДействия", Новый ОписаниеТипов("Дата"));
	
	УстановитьПривилегированныйРежим(Истина);
	ДанныеСчетов = ПланыСчетов.ЕПСБУ.ПолучитьДанныеСчетов(,"ДатаНачалаДействия,ДатаОкончанияДействия,КОСГУДт,КОСГУКт,ВидыКЭК");
	УстановитьПривилегированныйРежим(Ложь);
	
	Для Каждого ДанныеСчета Из ДанныеСчетов Цикл
		
		Для Каждого СтрокаКЭК Из ДанныеСчета.ВидыКЭК Цикл
			НоваяСтрока = ТаблицаНастроекКОСГУ.Добавить();
			НоваяСтрока.КодСчета 				= ДанныеСчета.Код;
			НоваяСтрока.КОСГУ 					= СтрокаКЭК.КЭК;
			НоваяСтрока.ДатаНачалаДействия 		= ДанныеСчета.ДатаНачалаДействия;
			НоваяСтрока.ДатаОкончанияДействия 	= ДанныеСчета.ДатаОкончанияДействия;
		КонецЦикла;
		
		Если НЕ ДанныеСчета.КОСГУДт.Пустая() Тогда
			НоваяСтрока = ТаблицаНастроекКОСГУДт.Добавить();
			НоваяСтрока.КодСчета 				= ДанныеСчета.Код;
			НоваяСтрока.КОСГУДт 				= ДанныеСчета.КОСГУДт;
			НоваяСтрока.ДатаНачалаДействия 		= ДанныеСчета.ДатаНачалаДействия;
			НоваяСтрока.ДатаОкончанияДействия 	= ДанныеСчета.ДатаОкончанияДействия;
		КонецЕсли;
		
		Если НЕ ДанныеСчета.КОСГУКт.Пустая() Тогда
			НоваяСтрока = ТаблицаНастроекКОСГУКт.Добавить();
			НоваяСтрока.КодСчета 				= ДанныеСчета.Код;
			НоваяСтрока.КОСГУКт 				= ДанныеСчета.КОСГУКт;
			НоваяСтрока.ДатаНачалаДействия 		= ДанныеСчета.ДатаНачалаДействия;
			НоваяСтрока.ДатаОкончанияДействия 	= ДанныеСчета.ДатаОкончанияДействия;
		КонецЕсли;
		
		// при проверке РБ для счетов группы 104 добавим КОСГУДт/Кт 410 и 420, использовавшиеся до 01.01.2018, для совместимости
		Если ЗначениеЗаполнено(НаДату) И НаДату < Дата(2018, 1, 1)
			И ПроверкаРегистраБухгалтерии И Лев(ДанныеСчета.Код, 3) = "104" Тогда
			
			Если ДанныеСчета.Код = "104.29" ИЛИ ДанныеСчета.Код = "104.39" Тогда
				КОСГУОборотное = БухгалтерскийУчетПовтИсп.КЭКПоКоду("420");
			Иначе
				КОСГУОборотное = БухгалтерскийУчетПовтИсп.КЭКПоКоду("410");
			КонецЕсли;
			
			НоваяСтрока = ТаблицаНастроекКОСГУ.Добавить();
			НоваяСтрока.КодСчета 				= ДанныеСчета.Код;
			НоваяСтрока.КОСГУ 					= КОСГУОборотное;
			НоваяСтрока.ДатаНачалаДействия 		= ДанныеСчета.ДатаНачалаДействия;
			НоваяСтрока.ДатаОкончанияДействия 	= ДанныеСчета.ДатаОкончанияДействия;
			
			НоваяСтрока = ТаблицаНастроекКОСГУДт.Добавить();
			НоваяСтрока.КодСчета 				= ДанныеСчета.Код;
			НоваяСтрока.КОСГУДт 				= КОСГУОборотное;
			НоваяСтрока.ДатаНачалаДействия 		= ДанныеСчета.ДатаНачалаДействия;
			НоваяСтрока.ДатаОкончанияДействия 	= ДанныеСчета.ДатаОкончанияДействия;
			
			НоваяСтрока = ТаблицаНастроекКОСГУКт.Добавить();
			НоваяСтрока.КодСчета 				= ДанныеСчета.Код;
			НоваяСтрока.КОСГУКт 				= КОСГУОборотное;
			НоваяСтрока.ДатаНачалаДействия 		= ДанныеСчета.ДатаНачалаДействия;
			НоваяСтрока.ДатаОкончанияДействия 	= ДанныеСчета.ДатаОкончанияДействия;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(НаДату) И НаДату < Дата(2021, 1, 1)
			И ПроверкаРегистраБухгалтерии И Лев(ДанныеСчета.Код, 6) = "304.03" Тогда
			
			КОСГУДт = БухгалтерскийУчетПовтИсп.КЭКПоКоду("830");
			КОСГУКт = БухгалтерскийУчетПовтИсп.КЭКПоКоду("730");
			
			НоваяСтрока = ТаблицаНастроекКОСГУ.Добавить();
			НоваяСтрока.КодСчета 				= ДанныеСчета.Код;
			НоваяСтрока.КОСГУ 					= КОСГУДт;
			НоваяСтрока.ДатаНачалаДействия 		= ДанныеСчета.ДатаНачалаДействия;
			НоваяСтрока.ДатаОкончанияДействия 	= ДанныеСчета.ДатаОкончанияДействия;
			
			НоваяСтрока = ТаблицаНастроекКОСГУ.Добавить();
			НоваяСтрока.КодСчета 				= ДанныеСчета.Код;
			НоваяСтрока.КОСГУ 					= КОСГУКт;
			НоваяСтрока.ДатаНачалаДействия 		= ДанныеСчета.ДатаНачалаДействия;
			НоваяСтрока.ДатаОкончанияДействия 	= ДанныеСчета.ДатаОкончанияДействия;
			
			НоваяСтрока = ТаблицаНастроекКОСГУДт.Добавить();
			НоваяСтрока.КодСчета 				= ДанныеСчета.Код;
			НоваяСтрока.КОСГУДт 				= КОСГУДт;
			НоваяСтрока.ДатаНачалаДействия 		= ДанныеСчета.ДатаНачалаДействия;
			НоваяСтрока.ДатаОкончанияДействия 	= ДанныеСчета.ДатаОкончанияДействия;
			
			НоваяСтрока = ТаблицаНастроекКОСГУКт.Добавить();
			НоваяСтрока.КодСчета 				= ДанныеСчета.Код;
			НоваяСтрока.КОСГУКт 				= КОСГУКт;
			НоваяСтрока.ДатаНачалаДействия 		= ДанныеСчета.ДатаНачалаДействия;
			НоваяСтрока.ДатаОкончанияДействия 	= ДанныеСчета.ДатаОкончанияДействия;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаНастроекКОСГУ.Свернуть("КодСчета,КОСГУ,ДатаНачалаДействия,ДатаОкончанияДействия");
	ТаблицаНастроекКОСГУДт.Свернуть("КодСчета,КОСГУДт,ДатаНачалаДействия,ДатаОкончанияДействия");
	ТаблицаНастроекКОСГУКт.Свернуть("КодСчета,КОСГУКт,ДатаНачалаДействия,ДатаОкончанияДействия");
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Таб.КодСчета КАК КодСчета,
	|	Таб.ДатаНачалаДействия КАК ДатаНачалаДействия,
	|	Таб.ДатаОкончанияДействия КАК ДатаОкончанияДействия,
	|	Таб.КОСГУ КАК КОСГУ
	|ПОМЕСТИТЬ ВнешняяТаблицаНастроекКОСГУ
	|ИЗ
	|	&ТаблицаНастроекКОСГУ КАК Таб
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Таб.КодСчета КАК КодСчета,
	|	Таб.ДатаНачалаДействия КАК ДатаНачалаДействия,
	|	Таб.ДатаОкончанияДействия КАК ДатаОкончанияДействия,
	|	Таб.КОСГУДт КАК КОСГУДт
	|ПОМЕСТИТЬ ВнешняяТаблицаНастроекКОСГУДт
	|ИЗ
	|	&ТаблицаНастроекКОСГУДт КАК Таб
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Таб.КодСчета КАК КодСчета,
	|	Таб.ДатаНачалаДействия КАК ДатаНачалаДействия,
	|	Таб.ДатаОкончанияДействия КАК ДатаОкончанияДействия,
	|	Таб.КОСГУКт КАК КОСГУКт
	|ПОМЕСТИТЬ ВнешняяТаблицаНастроекКОСГУКт
	|ИЗ
	|	&ТаблицаНастроекКОСГУКт КАК Таб
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КОСГУ.Ссылка КАК Ссылка,
	|	КОСГУ.Родитель КАК Родитель
	|ПОМЕСТИТЬ СпрКОСГУ
	|ИЗ
	|	Справочник.КОСГУ КАК КОСГУ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	КОСГУ.Ссылка,
	|	КОСГУ2.Родитель
	|ИЗ
	|	Справочник.КОСГУ КАК КОСГУ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КОСГУ КАК КОСГУ2
	|		ПО КОСГУ.Родитель = КОСГУ2.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Таб.КодСчета КАК КодСчета,
	|	Таб.ДатаНачалаДействия КАК ДатаНачалаДействия,
	|	Таб.ДатаОкончанияДействия КАК ДатаОкончанияДействия,
	|	Таб.КОСГУ КАК КОСГУ
	|ПОМЕСТИТЬ ТаблицаНастроекКОСГУ
	|ИЗ
	|	ВнешняяТаблицаНастроекКОСГУ КАК Таб";
	
	// при проверке РБ включаем в разрешенные записи также подчиненные КОСГУ
	Если ПроверкаРегистраБухгалтерии Тогда
	ТекстЗапроса = ТекстЗапроса + "
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Таб.КодСчета,
	|	Таб.ДатаНачалаДействия КАК ДатаНачалаДействия,
	|	Таб.ДатаОкончанияДействия КАК ДатаОкончанияДействия,
	|	СпрКОСГУ.Ссылка
	|ИЗ
	|	ВнешняяТаблицаНастроекКОСГУ КАК Таб
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СпрКОСГУ КАК СпрКОСГУ
	|		ПО Таб.КОСГУ = СпрКОСГУ.Родитель";
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + "
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Таб.КодСчета КАК КодСчета,
	|	Таб.ДатаНачалаДействия КАК ДатаНачалаДействия,
	|	Таб.ДатаОкончанияДействия КАК ДатаОкончанияДействия,
	|	Таб.КОСГУДт КАК КОСГУДт
	|ПОМЕСТИТЬ ТаблицаНастроекКОСГУДт
	|ИЗ
	|	ВнешняяТаблицаНастроекКОСГУДт КАК Таб";
	
	// при проверке РБ включаем в разрешенные записи также подчиненные КОСГУ
	Если ПроверкаРегистраБухгалтерии Тогда
	ТекстЗапроса = ТекстЗапроса + "
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Таб.КодСчета,
	|	Таб.ДатаНачалаДействия,
	|	Таб.ДатаОкончанияДействия,
	|	СпрКОСГУ.Ссылка
	|ИЗ
	|	ВнешняяТаблицаНастроекКОСГУДт КАК Таб
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СпрКОСГУ КАК СпрКОСГУ
	|		ПО Таб.КОСГУДт = СпрКОСГУ.Родитель";
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + "
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Таб.КодСчета КАК КодСчета,
	|	Таб.ДатаНачалаДействия КАК ДатаНачалаДействия,
	|	Таб.ДатаОкончанияДействия КАК ДатаОкончанияДействия,
	|	Таб.КОСГУКт КАК КОСГУКт
	|ПОМЕСТИТЬ ТаблицаНастроекКОСГУКт
	|ИЗ
	|	ВнешняяТаблицаНастроекКОСГУКт КАК Таб";
	
	// при проверке РБ включаем в разрешенные записи также подчиненные КОСГУ
	Если ПроверкаРегистраБухгалтерии Тогда
	ТекстЗапроса = ТекстЗапроса + "
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Таб.КодСчета,
	|	Таб.ДатаНачалаДействия,
	|	Таб.ДатаОкончанияДействия,
	|	СпрКОСГУ.Ссылка
	|ИЗ
	|	ВнешняяТаблицаНастроекКОСГУКт КАК Таб
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СпрКОСГУ КАК СпрКОСГУ
	|		ПО Таб.КОСГУКт = СпрКОСГУ.Родитель";
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + "
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ЕПСБУ.Ссылка КАК Счет,
	|	ТабНастроек.КОСГУ КАК КОСГУ
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаНастроекКОСГУ КАК ТабНастроек
	|		ПО (ПОДСТРОКА(ЕПСБУ.Код, 1, 6) = ТабНастроек.КодСчета
	|			И ЕПСБУ.ДатаНачалаДействия = ТабНастроек.ДатаНачалаДействия
	|			И ЕПСБУ.ДатаОкончанияДействия = ТабНастроек.ДатаОкончанияДействия)
	|ГДЕ
	|	ЕПСБУ.УчетПоКЭК
	|	И НЕ ЕПСБУ.ЭлементГруппа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ЕПСБУ.Ссылка КАК Счет,
	|	ТабНастроек.КОСГУДт КАК КОСГУДт
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаНастроекКОСГУДт КАК ТабНастроек
	|		ПО (ПОДСТРОКА(ЕПСБУ.Код, 1, 6) = ТабНастроек.КодСчета
	|			И ЕПСБУ.ДатаНачалаДействия = ТабНастроек.ДатаНачалаДействия
	|			И ЕПСБУ.ДатаОкончанияДействия = ТабНастроек.ДатаОкончанияДействия)
	|ГДЕ
	|	ЕПСБУ.УчетПоКЭК
	|	И НЕ ЕПСБУ.ЭлементГруппа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ЕПСБУ.Ссылка КАК Счет,
	|	ТабНастроек.КОСГУКт КАК КОСГУКт
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаНастроекКОСГУКт КАК ТабНастроек
	|		ПО (ПОДСТРОКА(ЕПСБУ.Код, 1, 6) = ТабНастроек.КодСчета
	|			И ЕПСБУ.ДатаНачалаДействия = ТабНастроек.ДатаНачалаДействия
	|			И ЕПСБУ.ДатаОкончанияДействия = ТабНастроек.ДатаОкончанияДействия)
	|ГДЕ
	|	ЕПСБУ.УчетПоКЭК
	|	И НЕ ЕПСБУ.ЭлементГруппа";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ТаблицаНастроекКОСГУ", ТаблицаНастроекКОСГУ);
	Запрос.УстановитьПараметр("ТаблицаНастроекКОСГУДт", ТаблицаНастроекКОСГУДт);
	Запрос.УстановитьПараметр("ТаблицаНастроекКОСГУКт", ТаблицаНастроекКОСГУКт);
	
	Результат = Запрос.ВыполнитьПакет();
	ВсегоРезультатов = Результат.Количество();
	
	Возврат Новый Структура("ТаблицаСчетКОСГУ, ТаблицаСчетКОСГУДт, ТаблицаСчетКОСГУКт",
							Результат[ВсегоРезультатов-3].Выгрузить(),
							Результат[ВсегоРезультатов-2].Выгрузить(),
							Результат[ВсегоРезультатов-1].Выгрузить())
	
КонецФункции

Функция СформироватьТаблицуСчетДоходовРасходов_КОСГУ() Экспорт
	
	ТаблицаДоп = Новый ТаблицаЗначений;
	ТаблицаДоп.Колонки.Добавить("СчетКод", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(6)));
	ТаблицаДоп.Колонки.Добавить("КОСГУКод", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(3)));
	ТаблицаДоп.Колонки.Добавить("ДатаНачалаДействия", Новый ОписаниеТипов("Дата"));
	ТаблицаДоп.Колонки.Добавить("ДатаОкончанияДействия", Новый ОписаниеТипов("Дата"));
	
	УстановитьПривилегированныйРежим(Истина);
	Макет = РегистрыСведений.СоответствияАналитическихСчетовКЭК.ПолучитьМакет("НастройкиСоответствия");
	УстановитьПривилегированныйРежим(Ложь);
	
	СпСчетов = Макет.ПолучитьОбласть("Счета");
	КолВоСчетов = СпСчетов.ВысотаТаблицы + 1; // добавляем область "Неформат"
	
	Для а = 1 По КолВоСчетов Цикл
		Если а = КолВоСчетов Тогда
			ИмяОбластиСчета = "Неформат";
		Иначе
			ИмяОбластиСчета = "Сч"+СпСчетов.ПолучитьОбласть(а, 1).ТекущаяОбласть.Текст;
		КонецЕсли;
		СпНастроек = Макет.ПолучитьОбласть(ИмяОбластиСчета);
		Для б = 1 По СпНастроек.ВысотаТаблицы Цикл
			НоваяСтрока = ТаблицаДоп.Добавить();
			НоваяСтрока.СчетКод = СпНастроек.ПолучитьОбласть(б, 1).ТекущаяОбласть.Текст;
			НоваяСтрока.КОСГУКод = СпНастроек.ПолучитьОбласть(б, 4).ТекущаяОбласть.Текст;
			ДатаСтрокой = СпНастроек.ПолучитьОбласть(б, 2).ТекущаяОбласть.Текст;
			Если ЗначениеЗаполнено(ДатаСтрокой) Тогда
				НоваяСтрока.ДатаНачалаДействия = Дата(Сред(ДатаСтрокой, 7, 4) + Сред(ДатаСтрокой, 4, 2) + Лев(ДатаСтрокой, 2));
			Иначе
				НоваяСтрока.ДатаНачалаДействия = '00010101';
			КонецЕсли;
			ДатаСтрокой = СпНастроек.ПолучитьОбласть(б, 3).ТекущаяОбласть.Текст;
			Если ЗначениеЗаполнено(ДатаСтрокой) Тогда
				НоваяСтрока.ДатаОкончанияДействия = Дата(Сред(ДатаСтрокой, 7, 4) + Сред(ДатаСтрокой, 4, 2) + Лев(ДатаСтрокой, 2));
			Иначе
				НоваяСтрока.ДатаОкончанияДействия = '00010101';
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Таб.СчетКод КАК СчетКод,
	|	Таб.КОСГУКод КАК КОСГУКод,
	|	Таб.ДатаНачалаДействия КАК ДатаНачалаДействия,
	|	Таб.ДатаОкончанияДействия КАК ДатаОкончанияДействия
	|ПОМЕСТИТЬ ТабСчет_КОСГУ
	|ИЗ
	|	&ТаблицаДоп КАК Таб
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕПСБУ.Ссылка КАК СчетСсылка,
	|	КОСГУ.Ссылка КАК КОСГУСсылка
	|ПОМЕСТИТЬ ТабСчет_КОСГУСсылки
	|ИЗ
	|	ТабСчет_КОСГУ КАК ТабСчет_КОСГУ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КОСГУ КАК КОСГУ
	|		ПО ТабСчет_КОСГУ.КОСГУКод = КОСГУ.Код
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ПО ТабСчет_КОСГУ.СчетКод = ЕПСБУ.Код
	|			И ТабСчет_КОСГУ.ДатаНачалаДействия = ЕПСБУ.ДатаНачалаДействия
	|			И ТабСчет_КОСГУ.ДатаОкончанияДействия = ЕПСБУ.ДатаОкончанияДействия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Таб.СчетСсылка КАК СчетСсылка,
	|	Таб.КОСГУСсылка КАК КОСГУСсылка
	|ПОМЕСТИТЬ ТабСчет_КОСГУСсылкиПодчиненные
	|ИЗ
	|	ТабСчет_КОСГУСсылки КАК Таб
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Таб.СчетСсылка,
	|	КОСГУ.Ссылка
	|ИЗ
	|	ТабСчет_КОСГУСсылки КАК Таб
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КОСГУ КАК КОСГУ
	|		ПО (Таб.КОСГУСсылка = КОСГУ.Родитель
	|				ИЛИ Таб.КОСГУСсылка = КОСГУ.Родитель.Родитель)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕПСБУ.Ссылка КАК Счет,
	|	ЕПСБУ.Родитель КАК Родитель1,
	|	ЕПСБУ.Родитель.Родитель КАК Родитель2
	|ПОМЕСТИТЬ ТабСчетов
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Ссылка В ИЕРАРХИИ
	|			(ВЫБРАТЬ
	|				Таб.СчетСсылка
	|			ИЗ
	|				ТабСчет_КОСГУСсылки КАК Таб)
	|	И НЕ ЕПСБУ.ЭлементГруппа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабСчетов.Счет КАК Счет,
	|	ТабСчет_КОСГУСсылкиПодчиненные.КОСГУСсылка КАК КОСГУ
	|ИЗ
	|	ТабСчетов КАК ТабСчетов
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТабСчет_КОСГУСсылкиПодчиненные КАК ТабСчет_КОСГУСсылкиПодчиненные
	|		ПО (ТабСчетов.Счет = ТабСчет_КОСГУСсылкиПодчиненные.СчетСсылка
	|				ИЛИ ТабСчетов.Родитель1 = ТабСчет_КОСГУСсылкиПодчиненные.СчетСсылка
	|				ИЛИ ТабСчетов.Родитель2 = ТабСчет_КОСГУСсылкиПодчиненные.СчетСсылка)";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ТаблицаДоп", ТаблицаДоп);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция СформироватьТаблицуКодовСчетовБУиАналитКодовВидовПоступленийВыбытий(НаДату) Экспорт
	
	ВидыКБКИзЭБ = Новый Соответствие;
	ВидыКБКИзЭБ.Вставить("Классификация расходов бюджета", Перечисления.ВидыКБК.КРБ);
	ВидыКБКИзЭБ.Вставить("Классификация доходов бюджета", Перечисления.ВидыКБК.КДБ);
	ВидыКБКИзЭБ.Вставить("Классификация источников внутреннего финансирования дефицитов бюджетов", Перечисления.ВидыКБК.КИФ);  
	ВидыКБКИзЭБ.Вставить("гКБК", Перечисления.ВидыКБК.гКБК);
	
	ПеречислениеКВД = Перечисления.КВД;
	
	ТаблицаДоп = Новый ТаблицаЗначений;
	ТаблицаДоп.Колонки.Добавить("Счет", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаДоп.Колонки.Добавить("АналитКодБК", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(3)));
	ТаблицаДоп.Колонки.Добавить("КФО", Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ТаблицаДоп.Колонки.Добавить("ВидПоказателя", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыКБК"));
	ТаблицаДоп.Колонки.Добавить("КЭК", Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ТаблицаДоп.Колонки.Добавить("ДатаНачала", Новый ОписаниеТипов("Дата"));
	ТаблицаДоп.Колонки.Добавить("ДатаОкончания", Новый ОписаниеТипов("Дата"));
	
	УстановитьПривилегированныйРежим(Истина);
	Макет = Обработки.АудитСостоянияСистемыБГУ.ПолучитьМакет("СоответствиеКодовСчетовИВидовДоходовРасходов");
	УстановитьПривилегированныйРежим(Ложь);
	
	ПодчиненныеКОСГУ = Новый Соответствие;
	
	КоличествоСтрок = Макет.ВысотаТаблицы;
	Для ТекСтрока = 5 По КоличествоСтрок Цикл
		
		НомерСтроки = Формат(ТекСтрока, "ЧГ=");
		
		// Ниже пустой строки указаны комментарии по изменению оригинальной таблицы - выход из цикла
		Если Макет.Область("R"+НомерСтроки+"C1").Текст = "" Тогда
			Прервать;
		КонецЕсли;
		
		ВидКБК = ВидыКБКИзЭБ[Макет.Область("R"+НомерСтроки+"C6").Текст];
		
		ЧастиДатыНачала = СтрРазделить(Макет.Область("R"+НомерСтроки+"C7").Текст, ".", Ложь);
		Если ЧастиДатыНачала.Количество() = 0 Тогда
			ДатаНачала = Дата(1,1,1);
		Иначе
			ДатаНачала = Дата(ЧастиДатыНачала[2], ЧастиДатыНачала[1], ЧастиДатыНачала[0]);
		КонецЕсли;
		
		ЧастиДатыОкончания = СтрРазделить(Макет.Область("R"+НомерСтроки+"C8").Текст, ".", Ложь);
		Если ЧастиДатыОкончания.Количество() = 0 Тогда
			ДатаОкончания = НаДату;
		Иначе
			ДатаОкончания = Дата(ЧастиДатыОкончания[2], ЧастиДатыОкончания[1], ЧастиДатыОкончания[0]);
		КонецЕсли;
		
		КодСчета = Макет.Область("R"+НомерСтроки+"C3").Текст;
		КодСчета = Лев(КодСчета, 3) + "." + Прав(КодСчета, 2);
		Счет = БухгалтерскийУчет.СчетПоКоду(КодСчета, ДатаОкончания);
		
		Если Счет.Пустая() Тогда
			Продолжить;
		КонецЕсли;
		
		АналитКодБК = Макет.Область("R"+НомерСтроки+"C2").Текст;
		
		МассивКФО = СтрРазделить(Макет.Область("R"+НомерСтроки+"C4").Текст, ",");
		МассивКОСГУ = СтрРазделить(Макет.Область("R"+НомерСтроки+"C5").Текст, ",");
		
		// Если КОСГУ = 000 и он в списке один, то добавляем допустимые оборотные КОСГУ (если применимо к счету)
		Если МассивКОСГУ.ВГраница() = 0 И МассивКОСГУ[0] = "000"
			И БухгалтерскийУчетПовтИсп.СчетаСОборотнымКЭК().Найти(Счет) <> Неопределено Тогда
			Для Каждого ДопустимыйКЭК ИЗ БухгалтерскийУчетПовтИсп.ДопустимыеКЭКСчета(Счет) Цикл
				МассивКОСГУ.Добавить(ДопустимыйКЭК.Код);
			КонецЦикла;
		КонецЕсли;
		
		Для Каждого КОСГУ Из МассивКОСГУ Цикл
			Если КОСГУ = "000" Тогда
				Продолжить;
			ИначеЕсли ПодчиненныеКОСГУ.Получить(КОСГУ) = Неопределено Тогда
				Выборка = Справочники.КОСГУ.ВыбратьИерархически(БухгалтерскийУчетПовтИсп.КЭКПоКоду(КОСГУ));
				МассивПодчиненныхКОСГУ = Новый Массив;
				Пока Выборка.Следующий() Цикл
					МассивПодчиненныхКОСГУ.Добавить(Выборка.Ссылка);
				КонецЦикла;
				ПодчиненныеКОСГУ.Вставить(КОСГУ, МассивПодчиненныхКОСГУ);
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого КФО Из МассивКФО Цикл
			КФОСсылка = ПеречислениеКВД.Получить(КФО-1);
			Для Каждого КОСГУ Из МассивКОСГУ Цикл
				
				НоваяСтрока = ТаблицаДоп.Добавить();
				НоваяСтрока.Счет = Счет;
				НоваяСтрока.АналитКодБК = АналитКодБК;
				НоваяСтрока.КФО = КФОСсылка;
				НоваяСтрока.ВидПоказателя = ВидКБК;
				НоваяСтрока.КЭК = БухгалтерскийУчетПовтИсп.КЭКПоКоду(КОСГУ);
				НоваяСтрока.ДатаНачала = ДатаНачала;
				НоваяСтрока.ДатаОкончания = ДатаОкончания;
				
				МассивПодчиненныхКОСГУ = ПодчиненныеКОСГУ.Получить(КОСГУ);
				Если МассивПодчиненныхКОСГУ = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Для Каждого ПодчиненныйКОСГУ Из МассивПодчиненныхКОСГУ Цикл
					НоваяСтрока = ТаблицаДоп.Добавить();
					НоваяСтрока.Счет = Счет;
					НоваяСтрока.АналитКодБК = АналитКодБК;
					НоваяСтрока.КФО = КФОСсылка;
					НоваяСтрока.ВидПоказателя = ВидКБК;
					НоваяСтрока.КЭК = ПодчиненныйКОСГУ;
					НоваяСтрока.ДатаНачала = ДатаНачала;
					НоваяСтрока.ДатаОкончания = ДатаОкончания;
				КонецЦикла;
				
			КонецЦикла;
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТаблицаДоп;
	
КонецФункции

Функция СформироватьТаблицуКВР_КОСГУ() Экспорт
	
	ТаблицаДоп = Новый ТаблицаЗначений;
	ТаблицаДоп.Колонки.Добавить("КВРКод", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(3)));
	ТаблицаДоп.Колонки.Добавить("КОСГУКод", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(3)));
	
	УстановитьПривилегированныйРежим(Истина);
	Макет = Обработки.АудитСостоянияСистемыБГУ.ПолучитьМакет("СоответствиеВидовРасходовКРБиКОСГУ");
	УстановитьПривилегированныйРежим(Ложь);
	
	КоличествоСтрок = Макет.ВысотаТаблицы;
	Для ТекСтрока = 2 По КоличествоСтрок Цикл
		НоваяСтрока = ТаблицаДоп.Добавить();
		НоваяСтрока.КВРКод = Макет.Область("R"+ТекСтрока+"C1").Текст;
		НоваяСтрока.КОСГУКод = Макет.Область("R"+ТекСтрока+"C2").Текст;
	КонецЦикла;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Таб.КВРКод КАК КВРКод,
	|	Таб.КОСГУКод КАК КОСГУКод
	|ПОМЕСТИТЬ ТабКВР_КОСГУ
	|ИЗ
	|	&ТаблицаДоп КАК Таб
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОСГУ.Ссылка КАК Ссылка,
	|	КОСГУ.Код КАК Код,
	|	КОСГУ.Родитель КАК Родитель,
	|	КОСГУ.Родитель.Код КАК РодительКод,
	|	КОСГУ.Родитель.Родитель.Код КАК РодительРодительКод
	|ПОМЕСТИТЬ СпрКОСГУ
	|ИЗ
	|	Справочник.КОСГУ КАК КОСГУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТабКВР_КОСГУ.КВРКод КАК КВРКод,
	|	СпрКОСГУ.Ссылка КАК КОСГУ
	|ИЗ
	|	ТабКВР_КОСГУ КАК ТабКВР_КОСГУ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СпрКОСГУ КАК СпрКОСГУ
	|		ПО ТабКВР_КОСГУ.КОСГУКод = СпрКОСГУ.Код
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТабКВР_КОСГУ.КВРКод,
	|	СпрКОСГУ.Ссылка
	|ИЗ
	|	ТабКВР_КОСГУ КАК ТабКВР_КОСГУ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СпрКОСГУ КАК СпрКОСГУ
	|		ПО ТабКВР_КОСГУ.КОСГУКод = СпрКОСГУ.РодительКод
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТабКВР_КОСГУ.КВРКод,
	|	СпрКОСГУ.Ссылка
	|ИЗ
	|	ТабКВР_КОСГУ КАК ТабКВР_КОСГУ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СпрКОСГУ КАК СпрКОСГУ
	|		ПО ТабКВР_КОСГУ.КОСГУКод = СпрКОСГУ.РодительРодительКод";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ТаблицаДоп", ТаблицаДоп);
	мТаблицаКВР_КОСГУ = Запрос.Выполнить().Выгрузить();
	
	Возврат мТаблицаКВР_КОСГУ;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("ЗарегистрироватьПроверкиСостоянияСистемы");
