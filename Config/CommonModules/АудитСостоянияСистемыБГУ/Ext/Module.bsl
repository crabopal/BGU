#Область ПрограммныйИнтерфейс

// Метод предназначен для описания алгоритма выполнения прикладной
// проверки состояния аудита системы.
//
// Параметры:
//	ИдентификаторПроверки - Строка - Строка, указанная при регистрации проверки, 
//		см. АудитСостоянияСистемы.ЗарегистрироватьПроверкуСостоянияСистемы.
//	Выполнена - Булево - если прикладная проверка выполнена, 
//		следует установить значение Истина.
//	ОписаниеПроблем - Таблица значений - предназначена для заполнения информации о выявленных проблемах.
//	 	* Представление - Строка - пользовательское представление проблемы,
//		* Объекты - Массив - Массив объектов информационной базы, однозначно идентифицирующих проблему.
//		* Важность - ПеречислениеСсылка.ВажностьПроблемыУчета,
//		* ДополнительнаяИнформация - ХранилищеЗначения - произвольные сведения, связанные с проблемой,
//
Процедура ВыполнитьПроверкуСостоянияСистемы(ИдентификаторПроверки, Выполнена, ОписаниеПроблем, ЗначенияДопПараметров) Экспорт
	
	МенеджерОбработки = Обработки.АудитСостоянияСистемыБГУ;
	Если ИдентификаторПроверки = "ПроверкаКорректностиКорреспонденцийСчетов" Тогда
		МенеджерОбработки.ПроверкаКорректностиКорреспонденцийСчетов(Выполнена, ОписаниеПроблем, ЗначенияДопПараметров);
	ИначеЕсли ИдентификаторПроверки = "ПроверкаПустыхСубконто" Тогда
		МенеджерОбработки.ПроверкаПустыхСубконто(Выполнена, ОписаниеПроблем, ЗначенияДопПараметров);
	ИначеЕсли ИдентификаторПроверки = "ПроверкаХарактеристикДвижения" Тогда
		МенеджерОбработки.ПроверкаХарактеристикДвижения(Выполнена, ОписаниеПроблем, ЗначенияДопПараметров);
	ИначеЕсли ИдентификаторПроверки = "ПроверкаНаличияСчетаВРПС" Тогда
		МенеджерОбработки.ПроверкаНаличияСчетаВРПС(Выполнена, ОписаниеПроблем, ЗначенияДопПараметров);
	ИначеЕсли ИдентификаторПроверки = "ПроверкаКЭККорреспонденцийОборотовИОстатков" Тогда
		МенеджерОбработки.ПроверкаКЭККорреспонденцийОборотовИОстатков(Выполнена, ОписаниеПроблем, ЗначенияДопПараметров);
	ИначеЕсли ИдентификаторПроверки = "ПроверкаСоответствияКЭКпоДоходамРасходам" Тогда
		МенеджерОбработки.ПроверкаСоответствияКЭКпоДоходамРасходам(Выполнена, ОписаниеПроблем, ЗначенияДопПараметров);
	ИначеЕсли ИдентификаторПроверки = "ПроверкаПоКЭКОборотовСчета21003" Тогда
		МенеджерОбработки.ПроверкаПоКЭКОборотовСчета21003(Выполнена, ОписаниеПроблем, ЗначенияДопПараметров);
	ИначеЕсли ИдентификаторПроверки = "ПроверкаСоответствияВидовРасходовКРБиКОСГУ" Тогда
		МенеджерОбработки.ПроверкаСоответствияВидовРасходовКРБиКОСГУ(Выполнена, ОписаниеПроблем, ЗначенияДопПараметров);
	ИначеЕсли ИдентификаторПроверки = "ПроверкаКодовСчетовБУИАналитКодовВидовПостВыб" Тогда
		МенеджерОбработки.ПроверкаКодовСчетовБУИАналитКодовВидовПостВыб(Выполнена, ОписаниеПроблем, ЗначенияДопПараметров);
	ИначеЕсли ИдентификаторПроверки = "ПроверкаОстатковПоСчетамЕПСБУ" Тогда
		МенеджерОбработки.ПроверкаОстатковПоСчетамЕПСБУ(Выполнена, ОписаниеПроблем, ЗначенияДопПараметров);
	ИначеЕсли ИдентификаторПроверки = "ПроверкаСпециальныхСчетов" Тогда
		МенеджерОбработки.ПроверкаСпециальныхСчетов(Выполнена, ОписаниеПроблем, ЗначенияДопПараметров);
	ИначеЕсли ИдентификаторПроверки = "СравнениеОборотовДСиЗабалансовыхСчетов17_18" Тогда
		МенеджерОбработки.СравнениеОборотовДСиЗабалансовыхСчетов17_18(Выполнена, ОписаниеПроблем, ЗначенияДопПараметров);
	ИначеЕсли ИдентификаторПроверки = "ПроверкаУстаревшихСчетов" Тогда
		МенеджерОбработки.ПроверкаУстаревшихСчетов(Выполнена, ОписаниеПроблем, ЗначенияДопПараметров);
	ИначеЕсли ИдентификаторПроверки = "ПроверкаОборотовВнеДействияУчетнойПолитики" Тогда
		МенеджерОбработки.ПроверкаОборотовВнеДействияУчетнойПолитики(Выполнена, ОписаниеПроблем, ЗначенияДопПараметров);
	ИначеЕсли ИдентификаторПроверки = "ПроверкаЛБОНазначенияОбязательстваИсполнение" Тогда
		МенеджерОбработки.ПроверкаЛБОНазначенияОбязательстваИсполнение(Выполнена, ОписаниеПроблем, ЗначенияДопПараметров);
	ИначеЕсли ИдентификаторПроверки = "ПроверкаРегистровУчетаНФА" Тогда
		МенеджерОбработки.ПроверкаРегистровУчетаНФА(Выполнена, ОписаниеПроблем, ЗначенияДопПараметров);
	ИначеЕсли ИдентификаторПроверки = "ПроверкаРегистровУчетаНФАЗабаланс" Тогда
		МенеджерОбработки.ПроверкаРегистровУчетаНФАЗабаланс(Выполнена, ОписаниеПроблем, ЗначенияДопПараметров);
	ИначеЕсли ИдентификаторПроверки = "ПроверкаИнвентарныхНомеров" Тогда
		МенеджерОбработки.ПроверкаИнвентарныхНомеров(Выполнена, ОписаниеПроблем, ЗначенияДопПараметров);
	ИначеЕсли ИдентификаторПроверки = "НалоговаяБазаИмущества" Тогда
		МенеджерОбработки.НалоговаяБазаИмущества(Выполнена, ОписаниеПроблем, ЗначенияДопПараметров);
	ИначеЕсли ИдентификаторПроверки = "ПроверкаКЭКпоДебетуИКредиту" Тогда
		МенеджерОбработки.ПроверкаКЭКпоДебетуИКредиту(Выполнена, ОписаниеПроблем, ЗначенияДопПараметров);
	ИначеЕсли ИдентификаторПроверки = "ПроверкаДопустимыхКЭК" Тогда
		МенеджерОбработки.ПроверкаДопустимыхКЭК(Выполнена, ОписаниеПроблем, ЗначенияДопПараметров);
	ИначеЕсли ИдентификаторПроверки = "ПроверкаСправочникаКЭК" Тогда
		МенеджерОбработки.ПроверкаСправочникаКЭК(Выполнена, ОписаниеПроблем, ЗначенияДопПараметров);
	ИначеЕсли ИдентификаторПроверки = "ПроверкаПланаСчетовЕПСБУ" Тогда
		МенеджерОбработки.ПроверкаПланаСчетовЕПСБУ(Выполнена, ОписаниеПроблем, ЗначенияДопПараметров);
	ИначеЕсли ИдентификаторПроверки = "ПроверкаПризнаковУчетаСчетовБУиНУ" Тогда
		МенеджерОбработки.ПроверкаПризнаковУчетаСчетовБУиНУ(Выполнена, ОписаниеПроблем, ЗначенияДопПараметров);
	ИначеЕсли ИдентификаторПроверки = "ПроверкаВидаКПСКорреспонденций" Тогда
		МенеджерОбработки.ПроверкаВидаКПСКорреспонденций(Выполнена, ОписаниеПроблем, ЗначенияДопПараметров);
	Иначе
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Неизвестный вид проверки: %1'"), ИдентификаторПроверки);
	КонецЕсли;
	
КонецПроцедуры

Процедура СоздатьГруппыПроверок() Экспорт
	
	Если Справочники.ПроверкиСостоянияСистемы.НайтиПоКоду("ИспользованиеСчетовИСубконто") = Справочники.ПроверкиСостоянияСистемы.ПустаяСсылка() Тогда
		
		НоваяГруппа = Справочники.ПроверкиСостоянияСистемы.СоздатьГруппу();
		НоваяГруппа.Код = "ИспользованиеСчетовИСубконто";
		НоваяГруппа.Наименование = "Использование счетов и субконто";
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(НоваяГруппа);
		
	КонецЕсли;
	
	Если Справочники.ПроверкиСостоянияСистемы.НайтиПоКоду("ИспользованиеБюджетныхКлассификаторов") = Справочники.ПроверкиСостоянияСистемы.ПустаяСсылка() Тогда
		
		НоваяГруппа = Справочники.ПроверкиСостоянияСистемы.СоздатьГруппу();
		НоваяГруппа.Код = "ИспользованиеБюджетныхКлассификаторов";
		НоваяГруппа.Наименование = "Использование бюджетных классификаторов";
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(НоваяГруппа);
		
	КонецЕсли;
	
	Если Справочники.ПроверкиСостоянияСистемы.НайтиПоКоду("ОстаткиИОборотыПоСчетам") = Справочники.ПроверкиСостоянияСистемы.ПустаяСсылка() Тогда
		
		НоваяГруппа = Справочники.ПроверкиСостоянияСистемы.СоздатьГруппу();
		НоваяГруппа.Код = "ОстаткиИОборотыПоСчетам";
		НоваяГруппа.Наименование = "Остатки и обороты по счетам";
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(НоваяГруппа);
		
	КонецЕсли;
	
	Если Справочники.ПроверкиСостоянияСистемы.НайтиПоКоду("ИсполнениеБюджетаПФХД") = Справочники.ПроверкиСостоянияСистемы.ПустаяСсылка() Тогда
		
		НоваяГруппа = Справочники.ПроверкиСостоянияСистемы.СоздатьГруппу();
		НоваяГруппа.Код = "ИсполнениеБюджетаПФХД";
		НоваяГруппа.Наименование = "Исполнение бюджета / плана ФХД";
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(НоваяГруппа);
		
	КонецЕсли;
	
	Если Справочники.ПроверкиСостоянияСистемы.НайтиПоКоду("УчетНФА") = Справочники.ПроверкиСостоянияСистемы.ПустаяСсылка() Тогда
		
		НоваяГруппа = Справочники.ПроверкиСостоянияСистемы.СоздатьГруппу();
		НоваяГруппа.Код = "УчетНФА";
		НоваяГруппа.Наименование = "Учет нефинансовых активов";
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(НоваяГруппа);
		
	КонецЕсли;
	
	Если Справочники.ПроверкиСостоянияСистемы.НайтиПоКоду("НастройкиПланаСчетов") = Справочники.ПроверкиСостоянияСистемы.ПустаяСсылка() Тогда
		
		НоваяГруппа = Справочники.ПроверкиСостоянияСистемы.СоздатьГруппу();
		НоваяГруппа.Код = "НастройкиПланаСчетов";
		НоваяГруппа.Наименование = "Настройки плана счетов";
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(НоваяГруппа);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗарегистрироватьПроверкиСостоянияСистемы() Экспорт
	
	ОписаниеДополнительныхПараметров = АудитСостоянияСистемы.ТаблицаДополнительныхПараметровПроверки();
	
	НовыйПараметр = ОписаниеДополнительныхПараметров.Добавить();
	НовыйПараметр.ТипПараметра 					= "СтандартныйПериод";
	НовыйПараметр.ИмяПараметра 					= "Период";
	НовыйПараметр.Заголовок 					= "Период";
	НовыйПараметр.ЗначениеПоУмолчанию 			= Новый СтандартныйПериод(ВариантСтандартногоПериода.СНачалаЭтогоГода);
	НовыйПараметр.ИспользуетсяДляАвтопроверки 	= Истина;
	
	НовыйПараметр = ОписаниеДополнительныхПараметров.Добавить();
	НовыйПараметр.ТипПараметра 					= "СправочникСсылка.Организации";
	НовыйПараметр.ИмяПараметра 					= "Организация";
	НовыйПараметр.Заголовок 					= "Организация";
	НовыйПараметр.ЗначениеПоУмолчанию 			= ПредопределенноеЗначение("Справочник.Организации.ПустаяСсылка");
	
	ПараметрыРегистрации = АудитСостоянияСистемы.СтруктураПараметровПроверкиСостоянияСистемы();
	
	ПараметрыРегистрации.Вставить("Идентификатор", "ПроверкаКорректностиКорреспонденцийСчетов");
	ПараметрыРегистрации.Вставить("Название", НСтр("ru = 'Некорректные корреспонденции счетов'"));
	ПараметрыРегистрации.Вставить("Комментарий", НСтр("ru = 'Проверка проводок на наличие корреспонденций, не согласующихся с корректными корреспонденциями счетов.'"));
	ПараметрыРегистрации.Вставить("Важность", ПредопределенноеЗначение("Перечисление.ВажностьПроблемыУчета.Информация"));
	ПараметрыРегистрации.Вставить("Группа", "ИспользованиеСчетовИСубконто");
	ПараметрыРегистрации.Вставить("ОписаниеДополнительныхПараметров", ОписаниеДополнительныхПараметров);
	ПараметрыРегистрации.Вставить("Используется", Ложь);
	
	АудитСостоянияСистемы.ЗарегистрироватьПроверкуСостоянияСистемы(ПараметрыРегистрации);
	
	ПараметрыРегистрации.Вставить("Идентификатор", "ПроверкаПустыхСубконто");
	ПараметрыРегистрации.Вставить("Название", НСтр("ru = 'Пустые субконто'"));
	ПараметрыРегистрации.Вставить("Комментарий", НСтр("ru = 'Проверка проводок на наличие счетов с незаполненными субконто.
												|Проверка производится только тех субконто, которые не могут иметь пустого значения.'"));
	ПараметрыРегистрации.Вставить("Важность", ПредопределенноеЗначение("Перечисление.ВажностьПроблемыУчета.Информация"));
	ПараметрыРегистрации.Вставить("Группа", "ИспользованиеСчетовИСубконто");
	ПараметрыРегистрации.Вставить("ОписаниеДополнительныхПараметров", ОписаниеДополнительныхПараметров);
	ПараметрыРегистрации.Вставить("Используется", Ложь);
	
	АудитСостоянияСистемы.ЗарегистрироватьПроверкуСостоянияСистемы(ПараметрыРегистрации); 
	
	ПараметрыРегистрации.Вставить("Идентификатор", "ПроверкаНаличияСчетаВРПС");
	ПараметрыРегистрации.Вставить("Название", НСтр("ru = 'Наличие счетов в РПС'"));
	ПараметрыРегистрации.Вставить("Комментарий", НСтр("ru = 'Проверка проводок на наличие счетов, отсутствующих в Рабочем плане счетов.'"));
	ПараметрыРегистрации.Вставить("Важность", ПредопределенноеЗначение("Перечисление.ВажностьПроблемыУчета.Предупреждение"));
	ПараметрыРегистрации.Вставить("Группа", "ИспользованиеСчетовИСубконто");
	ПараметрыРегистрации.Вставить("ОписаниеДополнительныхПараметров", ОписаниеДополнительныхПараметров);
	ПараметрыРегистрации.Вставить("Используется", Ложь);
	
	АудитСостоянияСистемы.ЗарегистрироватьПроверкуСостоянияСистемы(ПараметрыРегистрации);
	
	ПараметрыРегистрации.Вставить("Идентификатор", "ПроверкаХарактеристикДвижения");
	ПараметрыРегистрации.Вставить("Название", НСтр("ru = 'Характеристики движения'"));
	ПараметрыРегистрации.Вставить("Комментарий", НСтр("ru = 'Проверка проводок на корректность заполнения характеристик движения по дебету/кредиту:
												|- проверка заполненности характеристики движения к счетам 201 и 210.03 значением целевого КЭК (используется при заполнения формы 0503123)'"));
	ПараметрыРегистрации.Вставить("Важность", ПредопределенноеЗначение("Перечисление.ВажностьПроблемыУчета.Предупреждение"));
	ПараметрыРегистрации.Вставить("Группа", "ИспользованиеСчетовИСубконто");
	ПараметрыРегистрации.Вставить("ОписаниеДополнительныхПараметров", ОписаниеДополнительныхПараметров);
	ПараметрыРегистрации.Вставить("Используется", Ложь);
	
	АудитСостоянияСистемы.ЗарегистрироватьПроверкуСостоянияСистемы(ПараметрыРегистрации);
	
	ПараметрыРегистрации.Вставить("Идентификатор", "ПроверкаВидаКПСКорреспонденций");
	ПараметрыРегистрации.Вставить("Название", НСтр("ru = 'Виды КПС корреспонденций'"));
	ПараметрыРегистрации.Вставить("Комментарий", НСтр("ru = 'Проверка проводок и остатков на начало периода на соответствие счетов виду КПС, а также поиск счетов с незаполненным КПС.
												|Проверка производится только в рамках источников средств (ИФО и КФО), по которым на рабочих счетах используется бюджетная классификация.'"));
	ПараметрыРегистрации.Вставить("Важность", ПредопределенноеЗначение("Перечисление.ВажностьПроблемыУчета.Предупреждение"));
	ПараметрыРегистрации.Вставить("Группа", "ИспользованиеБюджетныхКлассификаторов");
	ПараметрыРегистрации.Вставить("ОписаниеДополнительныхПараметров", ОписаниеДополнительныхПараметров);
