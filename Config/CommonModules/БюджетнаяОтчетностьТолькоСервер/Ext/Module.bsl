Процедура ИнициализироватьБланкОтчетаПриНеобходимости(БланкСсылка) Экспорт
	
	Если Не ЗначениеЗаполнено(БланкСсылка) Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	//выполняется в серверной процедуре, 
	//т.к. в клиент-серверной базе, в обычном приложении иначе не установится привилегированный режим
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("БланкОтчета", БланкСсылка);
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	БланкиОтчетовМакетРаскрытий.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Справочник.БланкиОтчетов.МакетРаскрытий КАК БланкиОтчетовМакетРаскрытий
	|ГДЕ
	|	БланкиОтчетовМакетРаскрытий.Ссылка = &БланкОтчета";
	
	НужнаИнициализацияБланка = Запрос.Выполнить().Пустой();
			
	Если НужнаИнициализацияБланка Тогда
		
		//инициализация макетов
		Попытка
					
			ТекОбъектБланкОтчета = БланкСсылка.ПолучитьОбъект();
			ТекОбъектБланкОтчета.Заблокировать();
			
			ТекОбъектБланкОтчета.СформироватьОсновныеМакетыСтраницБланка();
			
			ТекОбъектБланкОтчета.ОбменДанными.Загрузка = Истина;
			ТекОбъектБланкОтчета.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов",Истина);//чтобы можно было записывать в РИБе
			
			ТекОбъектБланкОтчета.Записать();
			
			УстановитьПривилегированныйРежим(Ложь);
		Исключение
			
			ВызватьИсключение НСтр("ru = 'Не удалось обновить макет раскрытий в бланке отчета. Рекомендуется вручную открыть и записать бланк отчета
			|'") + ДиагностикаСлужебный.ПолучитьТекстОшибки(ИнформацияОбОшибке());
		КонецПопытки;
			
	КонецЕсли;		
	
КонецПроцедуры