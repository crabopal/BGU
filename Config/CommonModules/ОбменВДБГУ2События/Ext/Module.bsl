#Область ПрограммныйИнтерфейс

// Обработка правил регистрации.
// 
// Параметры:
//  Источник - ПланСчетовОбъект.ЕПСБУ, СправочникОбъект.СтатьиАналитикиВещевогоДовольствия, СправочникОбъект.ОперацииУчетаВещевогоДовольствия, СправочникОбъект.ЦМО, СправочникОбъект.МестаХранения, СправочникОбъект.Подразделения, СправочникОбъект.ПостоянноДействующиеКомиссии - Источник
//  Отказ - Булево - Отказ
Процедура ОбменВДБГУ2ЗарегистрироватьИзменениеПередЗаписью(Источник, Отказ) Экспорт
	
	ОбменДаннымиСобытия.МеханизмРегистрацииОбъектовПередЗаписью("ОбменВДБГУ2", Источник, Отказ);
	
КонецПроцедуры

// Обработка правил регистрации.
// 
// Параметры:
//  Источник - РегистрСведенийНаборЗаписей.СоставКомиссийОрганизаций - Источник
//  Отказ - Булево - Отказ
//  Замещение - Булево - Замещение
Процедура ОбменВДБГУ2ЗарегистрироватьИзменениеНабораЗаписейПередЗаписью(Источник, Отказ, Замещение) Экспорт
	
	ОбменДаннымиСобытия.МеханизмРегистрацииОбъектовПередЗаписьюРегистра("ОбменВДБГУ2", Источник, Отказ, Замещение);
	
КонецПроцедуры

// Обработка правил регистрации.
// 
// Параметры:
//  Источник - ПланСчетовОбъект.ЕПСБУ, СправочникОбъект.СтатьиАналитикиВещевогоДовольствия, СправочникОбъект.ОперацииУчетаВещевогоДовольствия, СправочникОбъект.ЦМО, СправочникОбъект.МестаХранения, СправочникОбъект.Подразделения, СправочникОбъект.ПостоянноДействующиеКомиссии - Источник
//  Отказ - Булево - Отказ
Процедура ОбменВДБГУ2ЗарегистрироватьУдалениеПередУдалением(Источник, Отказ) Экспорт
	
	ОбменДаннымиСобытия.МеханизмРегистрацииОбъектовПередУдалением("ОбменВДБГУ2", Источник, Отказ);
	
КонецПроцедуры

// Обмен ВДБГУ2 при записи загруженного документа.
// 
// Параметры:
//  Источник - ДокументОбъект
//  Отказ - Булево
Процедура ОбменВДБГУ2ПриЗаписиЗагруженногоДокумента(Источник, Отказ) Экспорт
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьСинхронизациюСВД") Тогда
		Возврат;
	КонецЕсли;

	Если Источник.ДополнительныеСвойства.Свойство("НеРегистрироватьОбъектыЗагруженныеИзВД")
			И Источник.ДополнительныеСвойства.НеРегистрироватьОбъектыЗагруженныеИзВД = Истина Тогда
		Возврат;
	КонецЕсли;

	Если Не ОбменДаннымиВД.ДокументЗагруженИзВД(Источник.Ссылка) Тогда
		Возврат;
	КонецЕсли;

	РегистрыСведений.ОбъектыЗагруженныеИзВД.ОбновитьЗапись(Источник);	
	
КонецПроцедуры

#КонецОбласти