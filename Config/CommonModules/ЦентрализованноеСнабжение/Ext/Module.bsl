//  Форма - ФормаКлиентскогоПриложения:
//   * ВсеДопустимыеКорреспонденции - см. ЦентрализованноеСнабжениеКлиентСервер.ПустаяДопустимаяКорреспонденция
//   * СвойстваИспользуемыхСчетов - ДанныеФормыКоллекция:
//     ** Счет - ПланСчетовСсылка.ЕПСБУ -
Процедура УстановитьСвойстваИспользуемыхСчетовВФорму(Форма)

	Форма.СвойстваИспользуемыхСчетов.Очистить();
	СвойстваИспользуемыхСчетов = ТаблицаСвойстваИспользуемыхСчетов();
	УстановитьСвойстваИспользуемыхСчетов(СвойстваИспользуемыхСчетов, Форма.ВсеДопустимыеКорреспонденции);
	Форма.СвойстваИспользуемыхСчетов.Загрузить(СвойстваИспользуемыхСчетов);
	
КонецПроцедуры

// Заполнить исходящее извещение по входящему.
// 
// Параметры:
//  Объект - ДокументОбъект.ИзвещениеИсходящее - 
//  Основание - ДокументСсылка.ИзвещениеВходящее -
Процедура ЗаполнитьИсходящееИзвещениеПоВходящему(Объект, Основание)

	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Основание,
		"Организация, Поставщик, Договор, Отправитель, ТипЭлектронногоИзвещения, ВидИзвещения, ПояснениеМБТ");
	Объект.Дата = ОбщегоНазначения.ТекущаяДатаПользователя();
	Объект.Организация = ЗначенияРеквизитов.Организация;
	Объект.ВходящееИзвещение        = Основание;
	Объект.Получатель               = ЗначенияРеквизитов.Отправитель;
	Объект.Поставщик                = ЗначенияРеквизитов.Поставщик;
	Объект.Договор                  = ЗначенияРеквизитов.Договор;
	
	Параметры = Новый Структура;
	ЭДП = Новый ТаблицаЗначений;
	ЭлектронныеДокументыБГУ.ЗаполнитьСписокЭлектронныхДокументовПоставщикаПоИзвещению(Основание, ЭДП);
	Параметры.Вставить("ЭДП", ЭДП);
	
	Объект.ТипЭлектронногоИзвещения = ТипОтветногоЭлектронногоИзвещения(ЗначенияРеквизитов.ТипЭлектронногоИзвещения, Параметры);
	Объект.ВидИзвещения             = ВидИзвещенияПоТипуЭлектронногоИзвещения(Объект.ТипЭлектронногоИзвещения);
	Если Не ЗначениеЗаполнено(Объект.ВидИзвещения) Тогда
		Объект.ВидИзвещения = ВидОтветногоИзвещения(ЗначенияРеквизитов.ВидИзвещения, "Исходящее");
	КонецЕсли;
	
	Если Объект.ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПолучениеРасчетовПоМБТ Тогда
		Объект.ПояснениеМБТ = ЗначенияРеквизитов.ПояснениеМБТ;
		НоваяСтрока = Объект.ДокументыПередачи.Добавить();
		НоваяСтрока.ДокументПередачи = Объект.ВходящееИзвещение;
	КонецЕсли;
	
	Если Объект.ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПолучениеНФАПоставщика
		Или Объект.ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПолучениеНФАСоСклада
		Или Объект.ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ОтПолучателя_ПодтверждениеПолученияГрузополучателемНФАОтПоставщикаРезервЭДО
		Или Объект.ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПолучениеБСО Тогда
		
		ЗаполнитьПриложенияИзЭДО(Объект, Основание);
		
	ИначеЕсли Объект.ВидИзвещения <> Перечисления.ВидыОперацийИсходящееИзвещение.ПолучениеВложенийВФинансовыеАктивы
		И Объект.ВидИзвещения <> Перечисления.ВидыОперацийИсходящееИзвещение.ПолучениеФинансовыхВложений Тогда
	
		ДанныеЭДИзвещения = ЭлектронныеДокументыБГУ.СведенияЭДИзвещенияПоДокументу(Основание, Истина);
		
		Если ДанныеЭДИзвещения <> Неопределено Тогда
			Если Объект.ВидИзвещения <> Перечисления.ВидыОперацийИсходящееИзвещение.ОтПолучателя_ПодтверждениеПолученияГрузополучателемНФАОтПоставщикаРезервЭДО
					И Объект.ВидИзвещения <> Перечисления.ВидыОперацийИсходящееИзвещение.ОтПолучателя_ПодтверждениеПолученияГрузополучателемНФАОтПоставщикаЭДО
					И Объект.ВидИзвещения <> Перечисления.ВидыОперацийИсходящееИзвещение.ОтПолучателя_ОтражениеВУчетеРазделенияЗемельныхУчастковЭДО Тогда
				ЗаполнитьПроводкиИсходящегоИзвещенияПоПроводкамЭДО(Объект, ДанныеЭДИзвещения);
			КонецЕсли;
		КонецЕсли;
		
		Если Объект.ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаПодтвержденияРасчетовПоПоставкамНФА
				Или Объект.ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаПодтвержденияУточненияРасчетовПоПоставкамНФА
				Или Объект.ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ОтПолучателя_ОтражениеВУчетеРазделенияЗемельныхУчастковЭДО
				Или Объект.ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ОтПолучателя_ПодтверждениеПолученияГрузополучателемНФАОтПоставщикаЭДО Тогда
			Объект.Приложения.Загрузить(ПриложенияВходящегоИзвещения(Основание));
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ПриложенияВходящегоИзвещения(Извещение)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИзвещениеВходящееПриложения.НомерСтроки КАК НомерСтроки,
	|	ИзвещениеВходящееПриложения.ВидДокумента,
	|	ИзвещениеВходящееПриложения.НомерДокумента,
	|	ИзвещениеВходящееПриложения.ДатаДокумента
	|ИЗ
	|	Документ.ИзвещениеВходящее.Приложения КАК ИзвещениеВходящееПриложения
	|ГДЕ
	|	ИзвещениеВходящееПриложения.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	Запрос.УстановитьПараметр("Ссылка", Извещение);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Процедура ЗаполнитьПриложенияИзЭДО(Объект, Основание)
	ДанныеДокументов = ЭлектронныеДокументыБГУ.ЗаполнитьПриложенияПоИзвещению(Основание); // Структура

	ДанныеЭДВходящегоИзвещения = ЭлектронныеДокументыБГУ.СведенияЭДИзвещенияПоДокументу(Основание);

	//@skip-check property-return-type
	Если ДанныеЭДВходящегоИзвещения.ЕстьПередачаЭлектроннымАктом Тогда
		ДокументыПоступленияОтКонтрагента = ЭлектронныеДокументыБГУ.ДокументыПоступленияНФАОтКонтрагента(Основание, ДанныеЭДВходящегоИзвещения);
		Для Каждого ТекСтрока Из ДокументыПоступленияОтКонтрагента Цикл
			НоваяСтрока = Объект.Приложения.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		КонецЦикла;	
    Иначе
		Объект.Приложения.Загрузить(ДанныеДокументов.ЭДП);
		Для каждого ТекСтрока Из ДанныеДокументов.АктыПриемкиПоЭДП Цикл
			НоваяСтрока = Объект.Приложения.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			НоваяСтрока.НомерДокумента = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(
				ТекСтрока.ДокументПриложения, ТекСтрока.ДокументПриложения.Номер);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

// Заполнить проводки исходящего извещения по проводкам ЭДО.
// 
// Параметры:
//  Объект - ДокументОбъект.ИзвещениеИсходящее, ДокументОбъект.ИзвещениеВходящее - Объект
//  ДанныеЭДИзвещения - Структура:
//   * ТаблицаПроводок - ТаблицаЗначений:
//     ** пДебетСчетОтправитель - Строка -
//     ** пКредитСчетОтправитель - Строка -
Процедура ЗаполнитьПроводкиИсходящегоИзвещенияПоПроводкамЭДО(Объект, ДанныеЭДИзвещения)
	
	ТаблицаПроводок = ДанныеЭДИзвещения.ТаблицаПроводок;
	Если ТаблицаПроводок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоОтветноеИзвещениеЧерез40160(Объект.ВидИзвещения) Тогда
		ТаблицаПроводок = УстановитьКорреспонденциюПоставкиЧерез40160(ТаблицаПроводок);
	КонецЕсли;
	
	ТаблицаКодовРабочихСчетов = Новый ТаблицаЗначений;
	ТаблицаКодовРабочихСчетов.Колонки.Добавить("КодРабочегоСчета",
		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(30, ДопустимаяДлина.Переменная)));
	ТаблицаКодовРабочихСчетов.Колонки.Добавить("КодКПС",
		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(17, ДопустимаяДлина.Фиксированная)));
	ТаблицаКодовРабочихСчетов.Колонки.Добавить("КодСчета",
		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(6, ДопустимаяДлина.Фиксированная)));
	ТаблицаКодовРабочихСчетов.Колонки.Добавить("КФО",
		Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ТаблицаКодовРабочихСчетов.Колонки.Добавить("КодКЭК",
		Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(3, ДопустимаяДлина.Фиксированная)));
	
	ВсеКВД = Новый Соответствие;
	Для Каждого Значение Из Метаданные.Перечисления.КВД.ЗначенияПеречисления Цикл
		ВсеКВД.Вставить(Значение.Синоним, Перечисления.КВД[Значение.Имя]);
	КонецЦикла;
	
	ДобавленныеКоды = Новый Соответствие;
	
	Для Каждого Строка Из ТаблицаПроводок Цикл
		Если ДобавленныеКоды.Получить(Строка.пДебетСчетОтправитель) = Неопределено Тогда
			ДобавитьКодРабочегоСчетаВТаблицуКодов(ТаблицаКодовРабочихСчетов, Строка.пДебетСчетОтправитель, ВсеКВД);
			ДобавленныеКоды.Вставить(Строка.пДебетСчетОтправитель, Истина);
		КонецЕсли;
		Если ДобавленныеКоды.Получить(Строка.пКредитСчетОтправитель) = Неопределено Тогда
			ДобавитьКодРабочегоСчетаВТаблицуКодов(ТаблицаКодовРабочихСчетов, Строка.пКредитСчетОтправитель, ВсеКВД);
			ДобавленныеКоды.Вставить(Строка.пДебетСчетОтправитель, Истина);
		КонецЕсли;
	КонецЦикла;
	
	КодыСчетов = ТаблицаКодовРабочихСчетов.ВыгрузитьКолонку("КодСчета");
	СсылкиСчетов = БухгалтерскийУчет.СписокСчетов(КодыСчетов, Объект.Дата, Истина, Объект.Организация);
	КФОДокумента = ТаблицаКодовРабочихСчетов.ВыгрузитьКолонку("КФО");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаКодовРабочихСчетов.КодРабочегоСчета,
	|	ТаблицаКодовРабочихСчетов.КодКПС,
	|	ТаблицаКодовРабочихСчетов.КФО,
	|	ТаблицаКодовРабочихСчетов.КодСчета,
	|	ТаблицаКодовРабочихСчетов.КодКЭК
	|ПОМЕСТИТЬ ТаблицаКодовРабочихСчетов
	|ИЗ
	|	&ТаблицаКодовРабочихСчетов КАК ТаблицаКодовРабочихСчетов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка,
	|	ЕПСБУ.Код КАК Код
	|ПОМЕСТИТЬ ВозможныеСчета
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Код В
	|			(ВЫБРАТЬ
	|				ТаблицаКодовРабочихСчетов.КодСчета
	|			ИЗ
	|				ТаблицаКодовРабочихСчетов КАК ТаблицаКодовРабочихСчетов)
	|	И (ЕПСБУ.ДатаНачалаДействия = ДАТАВРЕМЯ(1, 1, 1)
	|		ИЛИ ЕПСБУ.ДатаНачалаДействия < &Период)
	|	И (ЕПСБУ.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
	|		ИЛИ ЕПСБУ.ДатаОкончанияДействия >= &Период)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РабочиеСчетаСрезПоследних.КФО КАК КФО,
	|	РабочиеСчетаСрезПоследних.Счет КАК Счет,
	|	РабочиеСчетаСрезПоследних.КПС КАК КПС
	|ПОМЕСТИТЬ ВТРабочиеСчета
	|ИЗ
	|	РегистрСведений.РабочиеСчета.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ИФО = &ИФО
	|				И Счет В
	|					(ВЫБРАТЬ
	|						ВозможныеСчета.Ссылка
	|					ИЗ
	|						ВозможныеСчета КАК ВозможныеСчета)
	|				И КФО В
	|					(ВЫБРАТЬ
	|						ТаблицаКодовРабочихСчетов.КФО
	|					ИЗ
	|						ТаблицаКодовРабочихСчетов КАК ТаблицаКодовРабочихСчетов)) КАК РабочиеСчетаСрезПоследних
	|ГДЕ
	|	РабочиеСчетаСрезПоследних.Актуален
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТРабочиеСчета.КФО КАК КФО,
	|	ВТРабочиеСчета.Счет КАК Счет,
	|	ВТРабочиеСчета.Счет.Код КАК СчетКод,
	|	ВТРабочиеСчета.КПС КАК КПС,
	|	ВТРабочиеСчета.КПС.Код КАК КодКПС,
	|	ВТРабочиеСчета.Счет.КОСГУДт КАК СчетКОСГУДт,
	|	ВТРабочиеСчета.Счет.КОСГУКт КАК СчетКОСГУКт
	|ПОМЕСТИТЬ ВТРабочиеСчетаСКодами
	|ИЗ
	|	ВТРабочиеСчета КАК ВТРабочиеСчета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОСГУ.Код КАК Код,
	|	МАКСИМУМ(КОСГУ.Ссылка) КАК Ссылка
	|ПОМЕСТИТЬ ВТКОСГУ
	|ИЗ
	|	Справочник.КОСГУ КАК КОСГУ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаКодовРабочихСчетов КАК ТаблицаКодовРабочихСчетов
	|		ПО КОСГУ.Код = ТаблицаКодовРабочихСчетов.КодКЭК
	|
	|СГРУППИРОВАТЬ ПО
	|	КОСГУ.Код
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаКодовРабочихСчетов.КодРабочегоСчета КАК КодРабочегоСчета,
	|	ТаблицаКодовРабочихСчетов.КФО КАК КФО,
	|	ЕСТЬNULL(ВТРабочиеСчетаСКодами.Счет, ВозможныеСчета.Ссылка) КАК Счет,
	|	ВТРабочиеСчетаСКодами.КПС КАК КПС,
	|	ВТКОСГУ.Ссылка КАК КЭК,
	|	ВТРабочиеСчетаСКодами.СчетКОСГУДт КАК СчетКОСГУДт,
	|	ВТРабочиеСчетаСКодами.СчетКОСГУКт КАК СчетКОСГУКт
	|ИЗ
	|	ТаблицаКодовРабочихСчетов КАК ТаблицаКодовРабочихСчетов
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТРабочиеСчетаСКодами КАК ВТРабочиеСчетаСКодами
	|		ПО (ТаблицаКодовРабочихСчетов.КодКПС = ВТРабочиеСчетаСКодами.КодКПС)
	|			И (ТаблицаКодовРабочихСчетов.КФО = ВТРабочиеСчетаСКодами.КФО)
	|			И (ТаблицаКодовРабочихСчетов.КодСчета = ВТРабочиеСчетаСКодами.СчетКод)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТКОСГУ КАК ВТКОСГУ
	|		ПО (ТаблицаКодовРабочихСчетов.КодКЭК = ВТКОСГУ.Код)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВозможныеСчета КАК ВозможныеСчета
	|		ПО ТаблицаКодовРабочихСчетов.КодСчета = ВозможныеСчета.Код";
	Запрос.УстановитьПараметр("ТаблицаКодовРабочихСчетов", ТаблицаКодовРабочихСчетов);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ИФО", Объект.ИФО);
	Запрос.УстановитьПараметр("Счета", СсылкиСчетов);
	Запрос.УстановитьПараметр("Период", Объект.Дата);
	Запрос.УстановитьПараметр("КФО", КФОДокумента);
	
	ИспользуемыеСчета = Новый ТаблицаЗначений;
	ИспользуемыеСчета.Колонки.Добавить("КодРабочегоСчета", Новый ОписаниеТипов("Строка"));
	ИспользуемыеСчета.Колонки.Добавить("КФО", Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	ИспользуемыеСчета.Колонки.Добавить("Счет", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ИспользуемыеСчета.Колонки.Добавить("КПС", Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ИспользуемыеСчета.Колонки.Добавить("КЭК", Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ИспользуемыеСчета.Колонки.Добавить("СчетКОСГУДт", Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	ИспользуемыеСчета.Колонки.Добавить("СчетКОСГУКт", Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ИспользуемыеСчета.Добавить(), Выборка);
	КонецЦикла;
	ИспользуемыеСчета.Индексы.Добавить("КодРабочегоСчета");
	
	ДопустимыеКорреспонденции = ДопустимыеКорреспонденцииПоВидуОперацииИзвещение(Объект.ВидИзвещения);
	Если ДопустимыеКорреспонденции = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ДопустимыеКорреспонденции.СчетаДт = ПолучитьСсылкиДопустимыхСчетов(Объект, ДопустимыеКорреспонденции.СчетаДт);
	ДопустимыеКорреспонденции.СчетаКт = ПолучитьСсылкиДопустимыхСчетов(Объект, ДопустимыеКорреспонденции.СчетаКт);
	СвойстваИспользуемыхСчетов = ТаблицаСвойстваИспользуемыхСчетов();
	УстановитьСвойстваИспользуемыхСчетов(СвойстваИспользуемыхСчетов, ДопустимыеКорреспонденции);
	ПараметрыОбразец = ЦентрализованноеСнабжениеКлиентСервер.УстановитьЗначенияСубконтоДтКт_Параметры();
	ЦентрализованноеСнабжениеКлиентСервер.СкопироватьСвойстваСчетовИзФормы(СвойстваИспользуемыхСчетов, ПараметрыОбразец);
	
	Для Каждого ПередаваемаяПроводка Из ТаблицаПроводок Цикл
		
		НоваяСтрока = Объект.ПередаваемыеПроводки.Добавить();
		ЗаполнитьРабочийСчет(ПередаваемаяПроводка, НоваяСтрока, ИспользуемыеСчета, Объект, "Дт");
		ПараметрыПодстановки = ЦентрализованноеСнабжениеКлиентСервер.УстановитьЗначенияСубконтоДтКт_Параметры();
		ПараметрыПодстановки.ДтКт = "Дт";
		ПараметрыПодстановки.Объект = Объект;
		ПараметрыПодстановки.ДопустимыеКорреспонденции = ДопустимыеКорреспонденции;
		ПараметрыПодстановки.СвойстваСчетов = ПараметрыОбразец.СвойстваСчетов;
		ЦентрализованноеСнабжениеКлиентСервер.ЗаполнитьПараметрыПодстановкиСубконтоИсходящееИзвещение(ПараметрыПодстановки, Объект);
		ЦентрализованноеСнабжениеКлиентСервер.ПодставитьЗначенияСубконтоВСтрокуИсходящееИзвещение(НоваяСтрока, ПараметрыПодстановки);
		ЦентрализованноеСнабжениеКлиентСервер.УстановитьДетальныйКЭКВСтрокеДокумента(Объект, НоваяСтрока, "Дт");

		ЗаполнитьРабочийСчет(ПередаваемаяПроводка, НоваяСтрока, ИспользуемыеСчета, Объект, "Кт");
		ПараметрыПодстановки = ЦентрализованноеСнабжениеКлиентСервер.УстановитьЗначенияСубконтоДтКт_Параметры();
		ПараметрыПодстановки.ДтКт = "Кт";
		ПараметрыПодстановки.Объект = Объект;
		ПараметрыПодстановки.ДопустимыеКорреспонденции = ДопустимыеКорреспонденции;
		ПараметрыПодстановки.СвойстваСчетов = ПараметрыОбразец.СвойстваСчетов;
		ЦентрализованноеСнабжениеКлиентСервер.ЗаполнитьПараметрыПодстановкиСубконтоИсходящееИзвещение(ПараметрыПодстановки, Объект);
		ЦентрализованноеСнабжениеКлиентСервер.ПодставитьЗначенияСубконтоВСтрокуИсходящееИзвещение(НоваяСтрока, ПараметрыПодстановки);
		ЦентрализованноеСнабжениеКлиентСервер.УстановитьДетальныйКЭКВСтрокеДокумента(Объект, НоваяСтрока, "Кт");
		
		НоваяСтрока.Сумма = ПередаваемаяПроводка.пСуммаОтправитель;
		НоваяСтрока.Содержание = ПередаваемаяПроводка.пСодержание;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ЭтоОтветноеИзвещениеЧерез40160(ВидИзвещения)
	Возврат ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаПодтвержденияРасчетовПоПоставкамНФА
		Или ВидИзвещения = Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаПодтвержденияУточненияРасчетовПоПоставкамНФА;
КонецФункции
 
// Установить корреспонденцию поставки через40160.
// 
// Параметры:
//  ТаблицаПроводок - ТаблицаЗначений - Таблица проводок:
// * пСодержание - Строка - 
// * пСуммаОтправитель - Число - 
// * пДебетСчетОтправитель - Строка - 
// * пКредитСчетОтправитель - Строка - 
// * пДебетСчетПолучатель - Строка - 
// * пКредитСчетПолучатель - Строка - 
// * пСуммаПолучатель - Число - 
// * пНомерПроводки - Число - 
// * СчетДт - Строка - 
// * СчетКт - Строка - 
// * Сумма - Число - 
// * ВидСправочникаНоменклатуры - Строка - 
// * GUIDНоменклатуры - Строка - 
// * GUIDНоменклатурыОтправителя - Строка - 
// * GUIDИнвентарногоНомера - Строка - 
// * ИнвентарныйНомер - Строка - 
// * ИнвентарныйНомерУОтправителя - Строка - 
// 
// Возвращаемое значение:
//  ТаблицаЗначений:
// * пСодержание - Строка - 
// * пСуммаОтправитель - Число - 
// * пДебетСчетОтправитель - Строка - 
// * пКредитСчетОтправитель - Строка - 
// * пДебетСчетПолучатель - Строка - 
// * пКредитСчетПолучатель - Строка - 
// * пСуммаПолучатель - Число - 
// * пНомерПроводки - Число - 
// * СчетДт - Строка - 
// * СчетКт - Строка - 
// * Сумма - Число - 
// * ВидСправочникаНоменклатуры - Строка - 
// * GUIDНоменклатуры - Строка - 
// * GUIDНоменклатурыОтправителя - Строка - 
// * GUIDИнвентарногоНомера - Строка - 
// * ИнвентарныйНомер - Строка - 
// * ИнвентарныйНомерУОтправителя - Строка - 
Функция УстановитьКорреспонденциюПоставкиЧерез40160(ТаблицаПроводок)
	НоваяТаблицаПроводок = ТаблицаПроводок.Скопировать();
	Для Каждого Проводка Из НоваяТаблицаПроводок Цикл
		Если (Проводка.ВидСправочникаНоменклатуры = "ОсновныеСредства"
					Или Проводка.ВидСправочникаНоменклатуры = "Номенклатура")
				И (СтрНачинаетсяС(Проводка.СчетКт, "304")
					Или СтрНачинаетсяС(Проводка.СчетКт, "401")) Тогда
			Проводка.пДебетСчетОтправитель = СтрЗаменить(Проводка.пДебетСчетОтправитель, Проводка.СчетДт, "401.60");
		КонецЕсли; 
	КонецЦикла;
	Возврат НоваяТаблицаПроводок;
КонецФункции

// Заполнить рабочий счет.
// 
// Параметры:
//  ПередаваемаяПроводка - СтрокаТаблицыЗначений - Передаваемая проводка:
// * пСодержание - Строка -
// * пСуммаОтправитель - Число -
// * пДебетСчетОтправитель - Строка -
// * пКредитСчетОтправитель - Строка -
// * пДебетСчетПолучатель - Строка -
// * пКредитСчетПолучатель - Строка -
// * пСуммаПолучатель - Число -
//  Строка - ДокументТабличнаяЧастьСтрока.ИзвещениеИсходящее.ПередаваемыеПроводки - Строка
//  ИспользуемыеСчета - ТаблицаЗначений - Используемые счета:
// * КодРабочегоСчета - Строка -
// * КФО - ПеречислениеСсылка.КВД -
// * Счет - ПланСчетовСсылка.ЕПСБУ -
// * КПС - СправочникСсылка.КлассификационныеПризнакиСчетов -
// * КЭК - СправочникСсылка.КОСГУ -
// * СчетКОСГУДт - СправочникСсылка.КОСГУ -
// * СчетКОСГУКт - СправочникСсылка.КОСГУ -
//  Объект - ДокументОбъект.ИзвещениеИсходящее, ДокументОбъект.ИзвещениеВходящее - Объект
//  ДтКт - Строка - Дт кт
Процедура ЗаполнитьРабочийСчет(ПередаваемаяПроводка, Строка, ИспользуемыеСчета, Объект, ДтКт)

	Если ДтКт = "Дт" Тогда
		ИмяКолонки = "пКредитСчетОтправитель";
	Иначе
		ИмяКолонки = "пДебетСчетОтправитель";
	КонецЕсли;
	КодРабочегоСчета = ПередаваемаяПроводка[ИмяКолонки]; // Строка
	Отбор = Новый Структура("КодРабочегоСчета", КодРабочегоСчета);
	РабочиеСчета = ИспользуемыеСчета.НайтиСтроки(Отбор);
		
	Если РабочиеСчета.Количество() > 0 Тогда
		РабочийСчет = РабочиеСчета[0];
		Строка.КФО = РабочийСчет.КФО;
		Строка["Счет" + ДтКт] = РабочийСчет.Счет;
		Строка["КЭК" + ДтКт] = РабочийСчет.КЭК;
		Если РабочиеСчета.Количество() = 1 Тогда
			Строка["КПС" + ДтКт] = РабочийСчет.КПС;
		КонецЕсли;
		ЗаполнитьКЭКПоУмолчанию(Строка, Объект, ДтКт);
	КонецЕсли;
	
КонецПроцедуры

// Заполнить КЭКПо умолчанию.
// 
// Параметры:
//  Строка - ДокументТабличнаяЧастьСтрока.ИзвещениеИсходящее.ПередаваемыеПроводки - Строка
//  Объект - ДокументОбъект.ИзвещениеИсходящее, ДокументОбъект.ИзвещениеВходящее - Объект
//  ДтКт - Строка - Дт кт
Процедура ЗаполнитьКЭКПоУмолчанию(Строка, Объект, ДтКт)
	Перем Счет; // ПланСчетовСсылка.ЕПСБУ
	ПараметрыКЭК = БухгалтерскийУчетКлиентСервер.ПараметрыРасчетаКЭКПроводки();
	ПараметрыКЭК.Дата = Объект.Дата;
	ПараметрыКЭК.ИФО = Объект.ИФО;
	ПараметрыКЭК.КФО = Строка.КФО;
	ПараметрыКЭК.Организация = Объект.Организация;
	ЗаполнитьСубконтоВПараметрахКЭК(ПараметрыКЭК, Строка, ДтКт, 1);
	ЗаполнитьСубконтоВПараметрахКЭК(ПараметрыКЭК, Строка, ДтКт, 2);
	ЗаполнитьСубконтоВПараметрахКЭК(ПараметрыКЭК, Строка, ДтКт, 3);
	Счет = Строка["Счет" + ДтКт]; // ПланСчетовСсылка.ЕПСБУ
	ПараметрыКЭК.Счет = Счет;
	ПараметрыКЭК.ДтКт = ДтКт;
	
	КЭК = БухгалтерскийУчет.КЭКПроводки(ПараметрыКЭК);
	
	Если ЗначениеЗаполнено(КЭК) Тогда
		Строка["КЭК" + ДтКт] = КЭК;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСубконтоВПараметрахКЭК(ПараметрыКЭК, Строка, ДтКт, НомерСубконто)
	Перем ЗначениеСубконто; // Характеристика.ВидыСубконто
	ЗначениеСубконто = Строка["Субконто" + ДтКт + НомерСубконто]; // Характеристика.ВидыСубконто
	ПараметрыКЭК.Субконто1 = ЗначениеСубконто;
КонецПроцедуры

// Добавить код рабочего счета в таблицу кодов.
// 
// Параметры:
//  ТаблицаКодовРабочихСчетов - ТаблицаЗначений - Таблица кодов рабочих счетов:
// * КодРабочегоСчета - Строка -
// * КодКПС - Строка -
// * КодСчета - Строка -
// * КФО - ПеречислениеСсылка.КВД -
// * КодКЭК - Строка -
//  КодРабочегоСчета - Строка - Код рабочего счета
//  ВсеКВД - Соответствие из ПеречислениеСсылка.КВД:
//   * Ключ - Строка - синоним перечисления
//   * Значение - ПеречислениеСсылка.КВД -
Процедура ДобавитьКодРабочегоСчетаВТаблицуКодов(ТаблицаКодовРабочихСчетов, КодРабочегоСчета, ВсеКВД)
	
	Если ЗначениеЗаполнено(КодРабочегоСчета) Тогда
		ЧастиКодаСчета = СтрРазделить(КодРабочегоСчета, ".");
		КФО = ВсеКВД.Получить(ЧастиКодаСчета[1]); // ПеречислениеСсылка.КВД
		
		НоваяСтрока = ТаблицаКодовРабочихСчетов.Добавить();
		НоваяСтрока.КодРабочегоСчета = КодРабочегоСчета;
		НоваяСтрока.КодКПС = ЧастиКодаСчета[0];
		НоваяСтрока.КФО = КФО;
		Если ЧастиКодаСчета.Количество() > 2 Тогда
			ЧастиСчета = Новый Массив; // Массив из Строка
			Для Индекс = 2 По ЧастиКодаСчета.ВГраница() - 1 Цикл
				ЧастиСчета.Добавить(ЧастиКодаСчета[Индекс]);
			КонецЦикла;
			НоваяСтрока.КодСчета = СтрСоединить(ЧастиСчета, ".");
			НоваяСтрока.КодКЭК = ЧастиКодаСчета[ЧастиКодаСчета.ВГраница()];
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ВидОтветногоИзвещения(ВидИзвещения, ТипИзвещения)
	
	Если ВидИзвещения = Перечисления.ВидыОперацийВходящееИзвещение.ПолучениеФА Тогда
		Возврат Перечисления.ВидыОперацийИсходящееИзвещение.ПолучениеТребований;
	ИначеЕсли ВидИзвещения = Перечисления.ВидыОперацийВходящееИзвещение.ПолучениеОбязательств Тогда
		Возврат Перечисления.ВидыОперацийИсходящееИзвещение.ПолучениеОбязательств;
	ИначеЕсли ВидИзвещения = Перечисления.ВидыОперацийВходящееИзвещение.НачислениеДохода Тогда
		Возврат Перечисления.ВидыОперацийИсходящееИзвещение.ПолучениеДохода;
	ИначеЕсли ВидИзвещения = Перечисления.ВидыОперацийВходящееИзвещение.РасчетыПоМБТ Тогда
		Возврат Перечисления.ВидыОперацийИсходящееИзвещение.ПолучениеРасчетовПоМБТ;
	ИначеЕсли ВидИзвещения = Перечисления.ВидыОперацийВходящееИзвещение.ПолучениеНФА Тогда
		Возврат Перечисления.ВидыОперацийИсходящееИзвещение.ПолучениеНФАСоСклада;
	ИначеЕсли ВидИзвещения = Перечисления.ВидыОперацийВходящееИзвещение.ПолучениеРасчетовПоПоставкамНФА Тогда
		Возврат Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаПодтвержденияРасчетовПоПоставкамНФА;
	ИначеЕсли ВидИзвещения = Перечисления.ВидыОперацийВходящееИзвещение.ПолучениеУточненияРасчетовПоПоставкамНФА Тогда
		Возврат Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаПодтвержденияУточненияРасчетовПоПоставкамНФА;
	ИначеЕсли ВидИзвещения = Перечисления.ВидыОперацийВходящееИзвещение.ОтПолучателя_ПолучениеГрузополучателемНФАОтПоставщикаЭДО Тогда
		Возврат Перечисления.ВидыОперацийИсходящееИзвещение.ОтПолучателя_ПодтверждениеПолученияГрузополучателемНФАОтПоставщикаЭДО;
	ИначеЕсли ВидИзвещения = Перечисления.ВидыОперацийВходящееИзвещение.ОтПолучателя_ПередачаСведенийОРазделенииЗемельныхУчастковОПУИЭДО Тогда
		Возврат Перечисления.ВидыОперацийИсходящееИзвещение.ОтПолучателя_ОтражениеВУчетеРазделенияЗемельныхУчастковЭДО;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

// Соответствия видов исходящих и типов электронных извещений.
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Соответствия видов исходящих и типов электронных извещений:
// * ВидИзвещения - ПеречислениеСсылка.ВидыОперацийИсходящееИзвещение -
// * ТипЭлектронногоИзвещения - Число -
// * ОтветныйВидИзвещения - ПеречислениеСсылка.ВидыОперацийИсходящееИзвещение -
Функция СоответствияВидовИсходящихИТиповЭлектронныхИзвещений(Параметры = Неопределено)
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ВидИзвещения", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыОперацийИсходящееИзвещение"));
	Таблица.Колонки.Добавить("ТипЭлектронногоИзвещения", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("ОтветныйВидИзвещения", Новый ОписаниеТипов("ПеречислениеСсылка.ВидыОперацийИсходящееИзвещение"));

	ТипОтветногоИзвещенияЗаказчикаНФАСтандартный = Истина;
	Если НЕ Параметры = Неопределено Тогда
		Если Параметры.Свойство("ЭДП") Тогда
			ВсеЭДПИзвещения = Параметры.ЭДП;
			Для Каждого ЭДПИзвещения Из ВсеЭДПИзвещения Цикл
				ЭДП = ЭДПИзвещения.Ссылка;
				Если ЗначениеЗаполнено(ЭДП) Тогда
					Реквизиты = "НеОтражаетсяВУчете";
					СтруктураДанныхЭДП = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭДП, Реквизиты);
					Если СтруктураДанныхЭДП.НеОтражаетсяВУчете Тогда
						ТипОтветногоИзвещенияЗаказчикаНФАСтандартный = Ложь;
						Прервать;
					КонецЕсли;	
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Если ТипОтветногоИзвещенияЗаказчикаНФАСтандартный Тогда
