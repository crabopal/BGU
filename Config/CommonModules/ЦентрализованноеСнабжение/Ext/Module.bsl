	"<table border=""1"" cellspacing=""0"">
	|<thead bgcolor=""lightgray""><tr>
	|<th>Счета Дт</th>
	|<th>Счета Кт</th>
	|</tr></thead>
	|<tbody valign=""top"" >
	|<tr>
	|<td>[СчетаДт]</td>
	|<td>[СчетаКт]</td>
	|</tr>
	|</tbody>
	|</table>";
	
КонецФункции

// Установить условное оформление таблицы проводки.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения
Процедура УстановитьУсловноеОформлениеТаблицыПроводки(Форма) Экспорт
	ВсеЭлементыУО = Форма.УсловноеОформление.Элементы;
	
	// Счет Дт Учет по подразделениям
	ЭлементУО = ВсеЭлементыУО.Добавить();
	ЭлементУО.Использование = Истина;
	УстановитьОформлениеНеиспользуемоеПоле(ЭлементУО.Оформление);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементУО.Отбор,
		"Объект.ПередаваемыеПроводки.СчетДтУчетПоПодразделениям", Ложь);
	ДобавитьПолеУсловногоОформления(ЭлементУО.Поля, "ПередаваемыеПроводкиПодразделениеДт");
	
	// Счет Кт Учет по подразделениям
	ЭлементУО = ВсеЭлементыУО.Добавить();
	ЭлементУО.Использование = Истина;
	УстановитьОформлениеНеиспользуемоеПоле(ЭлементУО.Оформление);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементУО.Отбор,
		"Объект.ПередаваемыеПроводки.СчетКтУчетПоПодразделениям", Ложь);
	ДобавитьПолеУсловногоОформления(ЭлементУО.Поля, "ПередаваемыеПроводкиПодразделениеКт");
	
	// Субокнто Дт 1
	ЭлементУО = ВсеЭлементыУО.Добавить();
	ЭлементУО.Использование = Истина;
	УстановитьОформлениеНеиспользуемоеПоле(ЭлементУО.Оформление);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементУО.Отбор,
		"Объект.ПередаваемыеПроводки.СчетДтКоличествоСубконто", 1, ВидСравненияКомпоновкиДанных.Меньше);
	ДобавитьПолеУсловногоОформления(ЭлементУО.Поля, "ПередаваемыеПроводкиСубконтоДт1");
	
	// Субокнто Дт 2
	ЭлементУО = ВсеЭлементыУО.Добавить();
	ЭлементУО.Использование = Истина;
	УстановитьОформлениеНеиспользуемоеПоле(ЭлементУО.Оформление);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементУО.Отбор,
		"Объект.ПередаваемыеПроводки.СчетДтКоличествоСубконто", 2, ВидСравненияКомпоновкиДанных.Меньше);
	ДобавитьПолеУсловногоОформления(ЭлементУО.Поля, "ПередаваемыеПроводкиСубконтоДт2");
	
	// Субокнто Дт 3
	ЭлементУО = ВсеЭлементыУО.Добавить();
	ЭлементУО.Использование = Истина;
	УстановитьОформлениеНеиспользуемоеПоле(ЭлементУО.Оформление);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементУО.Отбор,
		"Объект.ПередаваемыеПроводки.СчетДтКоличествоСубконто", 3, ВидСравненияКомпоновкиДанных.Меньше);
	ДобавитьПолеУсловногоОформления(ЭлементУО.Поля, "ПередаваемыеПроводкиСубконтоДт3");
	
	// Субокнто Кт 1
	ЭлементУО = ВсеЭлементыУО.Добавить();
	ЭлементУО.Использование = Истина;
	УстановитьОформлениеНеиспользуемоеПоле(ЭлементУО.Оформление);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементУО.Отбор,
		"Объект.ПередаваемыеПроводки.СчетКтКоличествоСубконто", 1, ВидСравненияКомпоновкиДанных.Меньше);
	ДобавитьПолеУсловногоОформления(ЭлементУО.Поля, "ПередаваемыеПроводкиСубконтоКт1");
	
	// Субокнто Кт 2
	ЭлементУО = ВсеЭлементыУО.Добавить();
	ЭлементУО.Использование = Истина;
	УстановитьОформлениеНеиспользуемоеПоле(ЭлементУО.Оформление);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементУО.Отбор,
		"Объект.ПередаваемыеПроводки.СчетКтКоличествоСубконто", 2, ВидСравненияКомпоновкиДанных.Меньше);
	ДобавитьПолеУсловногоОформления(ЭлементУО.Поля, "ПередаваемыеПроводкиСубконтоКт2");
	
	// Субокнто Кт 3
	ЭлементУО = ВсеЭлементыУО.Добавить();
	ЭлементУО.Использование = Истина;
	УстановитьОформлениеНеиспользуемоеПоле(ЭлементУО.Оформление);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементУО.Отбор,
		"Объект.ПередаваемыеПроводки.СчетКтКоличествоСубконто", 3, ВидСравненияКомпоновкиДанных.Меньше);
	ДобавитьПолеУсловногоОформления(ЭлементУО.Поля, "ПередаваемыеПроводкиСубконтоКт3");
	
	// КПС Дт
	ЭлементУО = ВсеЭлементыУО.Добавить();
	ЭлементУО.Использование = Истина;
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
