//  ИмяПоля - Строка
Процедура ДобавитьПолеУсловногоОформления(Поля, ИмяПоля)
	Поле = Поля.Элементы.Добавить();
	Поле.Использование = Истина;
	Поле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
