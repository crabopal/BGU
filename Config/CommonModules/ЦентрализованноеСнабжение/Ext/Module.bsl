// Тип ответного электронного извещения.
// 
// Параметры:
//  ТипЭлектронногоИзвещения - Число -
// 
// Возвращаемое значение:
// Число 
Функция ТипОтветногоЭлектронногоИзвещения(ТипЭлектронногоИзвещения, Параметры) Экспорт
	
	ТипыИзвещений = Новый Соответствие;
	ТипыИзвещений.Вставить(1, 2);
	ТипыИзвещений.Вставить(3, 4);
	ТипыИзвещений.Вставить(5, 6);
	ТипыИзвещений.Вставить(7, 8);
	ТипыИзвещений.Вставить(9, 10);
	ТипыИзвещений.Вставить(11, 12);
	ТипыИзвещений.Вставить(13, 14);
	ТипыИзвещений.Вставить(15, 16);
	ТипыИзвещений.Вставить(17, 18);
	ТипыИзвещений.Вставить(19, 20);
	ТипыИзвещений.Вставить(21, 22);
	ТипыИзвещений.Вставить(23, 24);
	ТипыИзвещений.Вставить(25, 26);

	ТипыИзвещений.Вставить(27, 28);
	
	ТипОтветногоИзвещенияЗаказчикаНФАСтандартный = Истина;
	Если НЕ Параметры = Неопределено Тогда
		Если Параметры.Свойство("ЭДП") Тогда
			ВсеЭДПИзвещения = Параметры.ЭДП;
			Для Каждого ЭДПИзвещения Из ВсеЭДПИзвещения Цикл
				ЭДП = ЭДПИзвещения.Ссылка;
				Если ЗначениеЗаполнено(ЭДП) Тогда
					Реквизиты = "НеОтражаетсяВУчете";
					СтруктураДанныхЭДП = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЭДП, Реквизиты);
					Если СтруктураДанныхЭДП.НеОтражаетсяВУчете Тогда
						ТипОтветногоИзвещенияЗаказчикаНФАСтандартный = Ложь;
						Прервать;
					КонецЕсли;	
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Если ТипОтветногоИзвещенияЗаказчикаНФАСтандартный Тогда
		ТипыИзвещений.Вставить(29, 30);
	Иначе
		ТипыИзвещений.Вставить(29, 32);
	Конецесли;
	
	ТипОтветногоИзвещения = ТипыИзвещений.Получить(ТипЭлектронногоИзвещения);
	Если ТипОтветногоИзвещения <> Неопределено Тогда
		Возврат ТипОтветногоИзвещения;
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

Функция ВидИзвещенияПоТипуЭлектронногоИзвещения(ТипЭлектронногоИзвещения) Экспорт
	Для Каждого СоответствиеТипов Из ТипыЭлектронныхИзвещений() Цикл
