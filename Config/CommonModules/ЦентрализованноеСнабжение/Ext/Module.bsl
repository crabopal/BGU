//@strict-types

#Область ПрограммныйИнтерфейс

// Заполнить исходящее извещение по входящему.
// 
// Параметры:
//  Объект - ДокументОбъект.ИзвещениеИсходящее - 
//  Основание - ДокументСсылка.ИзвещениеВходящее -
Процедура ЗаполнитьИсходящееИзвещениеПоОснованию(Объект, Основание) Экспорт
	
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.ИзвещениеВходящее") Тогда
		ЗаполнитьИсходящееИзвещениеПоВходящему(Объект, Основание);
	КонецЕсли;
	
КонецПроцедуры

// Тип исходящего электронного извещения.
// 
// Параметры:
//  ВидИзвещения - ПеречислениеСсылка.ВидыОперацийИсходящееИзвещение
// 
// Возвращаемое значение:
//  Число - Тип исходящего электронного извещения
Функция ТипИсходящегоЭлектронногоИзвещения(ВидИзвещения, Параметры) Экспорт
	
	СтрокаВидаИзвещения = СоответствияВидовИсходящихИТиповЭлектронныхИзвещений(Параметры).Найти(ВидИзвещения, "ВидИзвещения");
	Если СтрокаВидаИзвещения <> Неопределено Тогда
		Возврат СтрокаВидаИзвещения.ТипЭлектронногоИзвещения;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

// Инициализировать допустимые корреспонденции.
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения:
//  * Объект - ДанныеФормыСтруктура:
//    ** ВидИзвещения - ПеречислениеСсылка.ВидыОперацийВходящееИзвещение, ПеречислениеСсылка.ВидыОперацийИсходящееИзвещение -
//  * ВсеДопустимыеКорреспонденции - ФиксированнаяСтруктура
Процедура ИнициализироватьДопустимыеКорреспонденции(Форма) Экспорт
	
	Объект = Форма.Объект;
	ДопустимыеКодыСчетов = ДопустимыеКорреспонденцииПоВидуОперацииИзвещение(Объект.ВидИзвещения);
	ДопустимыеКорреспонденции = ЦентрализованноеСнабжениеКлиентСервер.ПустаяДопустимаяКорреспонденция();
	Если ЗначениеЗаполнено(ДопустимыеКодыСчетов) Тогда
		ДопустимыеКорреспонденции.СчетаДт = ПолучитьСсылкиДопустимыхСчетов(Объект, ДопустимыеКодыСчетов.СчетаДт);
		ДопустимыеКорреспонденции.СчетаКт = ПолучитьСсылкиДопустимыхСчетов(Объект, ДопустимыеКодыСчетов.СчетаКт);
	КонецЕсли;

	Форма.ВсеДопустимыеКорреспонденции = ОбщегоНазначения.ФиксированныеДанные(ДопустимыеКорреспонденции);
	
	УстановитьСвойстваИспользуемыхСчетовВФорму(Форма);
	
КонецПроцедуры

// Проверяет, что выбранные счета можно выбрать интерактивно. Если нет, то очищает выбранный счет.
// Необходимо вызывать после изменения даты с переходом через дату изменения учетной политики, т.к. могут измениться
// сроки действия счетов с одинаковым кодом.
//
// Параметры:
//  Форма	 - ФормаКлиентскогоПриложения - 
//
Процедура ПерезаполнитьСчетаПередаваемыхПроводок(Форма) Экспорт
	Объект = Форма.Объект;
	Если Объект.ПередаваемыеПроводки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ВсеКорреспонденции = Форма.ВсеДопустимыеКорреспонденции; // см. ЦентрализованноеСнабжениеКлиентСервер.ПустаяДопустимаяКорреспонденция
	
	СчетаДт = Новый Соответствие;
	Для Каждого СчетДт Из ВсеКорреспонденции.СчетаДт Цикл
		СчетаДт.Вставить(СчетДт, Истина);
	КонецЦикла;

	СчетаКт = Новый Соответствие;
	Для Каждого СчетКт Из ВсеКорреспонденции.СчетаКт Цикл
		СчетаКт.Вставить(СчетКт, Истина);
	КонецЦикла;
	
	Для Каждого Проводка Из Объект.ПередаваемыеПроводки Цикл
		Если ЗначениеЗаполнено(Проводка.СчетДт) Тогда
			Если СчетаДт.Получить(Проводка.СчетДт) = Неопределено Тогда
				Проводка.СчетДт = Неопределено;
				Проводка.КПСДт = Неопределено;
				Проводка.КЭКДт = Неопределено;
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(Проводка.СчетКт) Тогда
			Если СчетаКт.Получить(Проводка.СчетКт) = Неопределено Тогда
				Проводка.СчетКт = Неопределено;
				Проводка.КПСКт = Неопределено;
				Проводка.КЭККт = Неопределено;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Допустимые корреспонденции по виду операции извещение.
// 
// Параметры:
//  ВидОперации - ПеречислениеСсылка.ВидыОперацийИсходящееИзвещение, ПеречислениеСсылка.ВидыОперацийВходящееИзвещение -
// 
// Возвращаемое значение:
// - Неопределено
//  -см. ЦентрализованноеСнабжениеКлиентСервер.ПустаяДопустимаяКорреспонденция
Функция ДопустимыеКорреспонденцииПоВидуОперацииИзвещение(ВидОперации) Экспорт
	
	// Исходящее извещение
	Если ВидОперации = Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаНФАПоставщика Тогда
		Возврат ДопустимыеКорреспонденцииИсходящиеПередачаНФАПоставщика();
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаТребований Тогда
		Возврат ДопустимыеКорреспонденцииИсходящиеПередачаТребований();
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийИсходящееИзвещение.НачислениеДохода Тогда
		Возврат ДопустимыеКорреспонденцииИсходящиеНачислениеДохода();
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаОбязательств Тогда
		Возврат ДопустимыеКорреспонденцииИсходящиеПередачаОбязательств();
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаФинансовыхВложений Тогда
		Возврат ДопустимыеКорреспонденцииИсходящиеПередачаФинансовыхВложений();
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаВложенийВФинансовыеАктивы Тогда
		Возврат ДопустимыеКорреспонденцииИсходящиеПередачаВложенийВФинансовыеАктивы();
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийИсходящееИзвещение.РасчетыПоМБТ Тогда
		Возврат ДопустимыеКорреспонденцииИсходящиеРасчетыПоМБТ();
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаРБП Тогда
		Возврат ДопустимыеКорреспонденцииИсходящиеПередачаРБП();
		
	// Входящее извещение
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийВходящееИзвещение.НачислениеДохода Тогда
		Возврат ДопустимыеКорреспонденцииВходящиеНачислениеДохода();
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийВходящееИзвещение.ПолучениеДохода Тогда
		Возврат ДопустимыеКорреспонденцииВходящиеПолучениеДохода();
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийВходящееИзвещение.ПолучениеФА Тогда
		Возврат ДопустимыеКорреспонденцииВходящиеПолучениеФА();
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийВходящееИзвещение.ПолучениеОбязательств Тогда
		Возврат ДопустимыеКорреспонденцииВходящиеПолучениеОбязательств();
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийВходящееИзвещение.РасчетыПоМБТ Тогда
		Возврат ДопустимыеКорреспонденцииВходящиеРасчетыПоМБТ();
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийВходящееИзвещение.ПолучениеРБП Тогда
		Возврат ДопустимыеКорреспонденцииВходящиеПолучениеРБП();
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийВходящееИзвещение.ПолучениеРасчетовПоПоставкамНФА Тогда
		Возврат ДопустимыеКорреспонденцииВходящиеПолучениеРасчетовПоПоставкамНФА();
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийВходящееИзвещение.ПолучениеУточненияРасчетовПоПоставкамНФА Тогда
		Возврат ДопустимыеКорреспонденцииВходящиеПолучениеУточненияРасчетовПоПоставкамНФА();
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийВходящееИзвещение.ОтПолучателя_ПолучениеГрузополучателемНФАОтПоставщикаРезерв Тогда
		Возврат ДопустимыеКорреспонденцииВходящиеОтПолучателя_ПолучениеГрузополучателемНФАОтПоставщикаРезерв();
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийВходящееИзвещение.ОтПолучателя_ПолучениеГрузополучателемНФАОтПоставщика Тогда
		Возврат ДопустимыеКорреспонденцииВходящиеОтПолучателя_ПолучениеГрузополучателемНФАОтПоставщика();
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийВходящееИзвещение.ОтПолучателя_ПолучениеСведенийОРазделенииЗемельныхУчастковОПУИ Тогда
		Возврат ДопустимыеКорреспонденцииВходящиеОтПолучателя_ПолучениеСведенийОРазделенииЗемельныхУчастковОПУИ();
		
	// Ответное исходящее извещение: операции входящего извещения
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийИсходящееИзвещение.ПолучениеТребований Тогда
		Возврат ДопустимыеКорреспонденцииПоВидуОперацииИзвещение(Перечисления.ВидыОперацийВходящееИзвещение.ПолучениеФА);
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийИсходящееИзвещение.ПолучениеОбязательств Тогда
		Возврат ДопустимыеКорреспонденцииПоВидуОперацииИзвещение(Перечисления.ВидыОперацийВходящееИзвещение.ПолучениеОбязательств);
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийИсходящееИзвещение.ПолучениеДохода Тогда
		Возврат ДопустимыеКорреспонденцииПоВидуОперацииИзвещение(Перечисления.ВидыОперацийВходящееИзвещение.НачислениеДохода);
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийИсходящееИзвещение.ПолучениеРасчетовПоМБТ Тогда
		Возврат ДопустимыеКорреспонденцииПоВидуОперацииИзвещение(Перечисления.ВидыОперацийВходящееИзвещение.РасчетыПоМБТ);
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаПодтвержденияРасчетовПоПоставкамНФА Тогда
		Возврат ДопустимыеКорреспонденцииПоВидуОперацииИзвещение(Перечисления.ВидыОперацийВходящееИзвещение.ПолучениеРасчетовПоПоставкамНФА);
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийИсходящееИзвещение.ПередачаПодтвержденияУточненияРасчетовПоПоставкамНФА Тогда
		Возврат ДопустимыеКорреспонденцииПоВидуОперацииИзвещение(Перечисления.ВидыОперацийВходящееИзвещение.ПолучениеУточненияРасчетовПоПоставкамНФА);

	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийИсходящееИзвещение.ОтПолучателя_ПодтверждениеПолученияГрузополучателемНФАОтПоставщикаРезервЭДО Тогда
		Возврат ДопустимыеКорреспонденцииПоВидуОперацииИзвещение(Перечисления.ВидыОперацийВходящееИзвещение.ОтПолучателя_ПолучениеГрузополучателемНФАОтПоставщикаРезерв);
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийИсходящееИзвещение.ОтПолучателя_ПодтверждениеПолученияГрузополучателемНФАОтПоставщикаЭДО Тогда
		Возврат ДопустимыеКорреспонденцииПоВидуОперацииИзвещение(Перечисления.ВидыОперацийВходящееИзвещение.ОтПолучателя_ПолучениеГрузополучателемНФАОтПоставщика);
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийИсходящееИзвещение.ОтПолучателя_ОтражениеВУчетеРазделенияЗемельныхУчастковЭДО Тогда
		Возврат ДопустимыеКорреспонденцииПоВидуОперацииИзвещение(Перечисления.ВидыОперацийВходящееИзвещение.ОтПолучателя_ПолучениеСведенийОРазделенииЗемельныхУчастковОПУИ);

	// Неожиданный вид операции или проверка конкретного вида извещения
	Иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

// Виды ответных операций исходящее извещение.
// 
// Возвращаемое значение:
//  Соответствие из ПеречислениеСсылка.ВидыОперацийИсходящееИзвещение:
//   * Ключ - ПеречислениеСсылка.ВидыОперацийИсходящееИзвещение - ответный вид извещения
//   * Значение - ПеречислениеСсылка.ВидыОперацийИсходящееИзвещение - первичный вид извещения
Функция ВидыОтветныхОперацийИсходящееИзвещение() Экспорт
	Результат = Новый Соответствие;
	Для Каждого Строка Из СоответствияВидовИсходящихИТиповЭлектронныхИзвещений() Цикл
		Если ЗначениеЗаполнено(Строка.ОтветныйВидИзвещения) Тогда
			Результат.Вставить(Строка.ОтветныйВидИзвещения, Строка.ВидИзвещения);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Получить ссылки допустимых счетов.
// 
// Параметры:
//  Объект - ДокументОбъект.ИзвещениеИсходящее
//         - ДанныеФормыСтруктура - Объект:
// * ВидИзвещения - ПеречислениеСсылка.ВидыОперацийВходящееИзвещение, ПеречислениеСсылка.ВидыОперацийИсходящееИзвещение -
// * Дата - Дата
//  КодыСчетов - Массив из Строка - Коды счетов
// 
// Возвращаемое значение:
//  Массив из ПланСчетовСсылка.ЕПСБУ- Получить ссылки допустимых счетов
Функция ПолучитьСсылкиДопустимыхСчетов(Объект, КодыСчетов) Экспорт
	Если ЗначениеЗаполнено(Объект.Дата) Тогда
		ДатаСчетов = Объект.Дата;
	Иначе
		ДатаСчетов = ТекущаяДатаСеанса();
	КонецЕсли;
	ПараметрыВыбора = Новый Структура;
	ПараметрыВыбора.Вставить("НаДату", ДатаСчетов);
	ПараметрыВыбора.Вставить("Организация", Объект.Организация);
	ПараметрыВыбора.Вставить("ИФО", Объект.ИФО);
	ПараметрыВыбора.Вставить("ВыборГруппИЭлементов", ИспользованиеГруппИЭлементов.Элементы);
	
	ПараметрыВыбора.Вставить("ОграниченияСписокСчетов", КодыСчетов);
	ПараметрыВыбора.Вставить("НеОграничиватьКоличествоСчетов", Истина);
	
	ДанныеВыбора = ПолучитьДанныеВыбора(Тип("ПланСчетовСсылка.ЕПСБУ"), ПараметрыВыбора);
	
	Результат = Новый Массив;
	Для Каждого ДопустимыйСчет Из ДанныеВыбора Цикл
		ЗначениеВыбора = ДопустимыйСчет.Значение;
		Если ТипЗнч(ЗначениеВыбора) = Тип("Структура") Тогда
			Результат.Добавить(ЗначениеВыбора.Значение);
		Иначе
			Результат.Добавить(ЗначениеВыбора);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Установить свойства используемых счетов.
// 
// Параметры:
//  СвойстваИспользуемыхСчетов - ТаблицаЗначений:
//   * Счет - ПланСчетовСсылка.ЕПСБУ
//  ДопустимыеКорреспонденции - см. ЦентрализованноеСнабжениеКлиентСервер.ПустаяДопустимаяКорреспонденция
Процедура УстановитьСвойстваИспользуемыхСчетов(СвойстваИспользуемыхСчетов, ДопустимыеКорреспонденции) Экспорт
	Если ДопустимыеКорреспонденции = Неопределено
		Или (ДопустимыеКорреспонденции.СчетаДт.Количество() = 0 И ДопустимыеКорреспонденции.СчетаКт.Количество() = 0) Тогда
		Возврат;
	КонецЕсли;
	
	КодыСчетов = Новый Массив;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(КодыСчетов, ДопустимыеКорреспонденции.СчетаДт);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(КодыСчетов, ДопустимыеКорреспонденции.СчетаКт);
	
	ДанныеСчетов = СвойстваСчетов(КодыСчетов);
	Для Каждого ТекущийСчет Из ДанныеСчетов Цикл
		НоваяСтрока = СвойстваИспользуемыхСчетов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущийСчет);
		НоваяСтрока.Счет = ТекущийСчет.Ссылка;
	КонецЦикла;
КонецПроцедуры

Функция ТаблицаСвойстваИспользуемыхСчетов() Экспорт
