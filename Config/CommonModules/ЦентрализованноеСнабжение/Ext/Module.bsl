// Свойства счетов.
// 
// Параметры:
//  КодыСчетов - Массив из ПланСчетовСсылка.ЕПСБУ
// 
// Возвращаемое значение:
//  Массив из см. ЦентрализованноеСнабжениеКлиентСервер.СтруктураСвойствСчета
Функция СвойстваСчетов(КодыСчетов)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка,
	|	ЕПСБУ.Код,
	|	ЕПСБУ.УчетПоПодразделениям,
	|	ЕПСБУ.УчетПоПодразделениям И НЕ ЕПСБУ.РазрешитьНеУказыватьПодразделение КАК УчетПоПодразделениямОбязательный,
	|	ЕПСБУ.УчетПоКПС,
	|	ЕПСБУ.УчетПоКЭК,
	|	ЕСТЬNULL(ВидыСубконто3.НомерСтроки, ЕстьNULL(ВидыСубконто2.НомерСтроки, ЕстьNULL(ВидыСубконто1.НомерСтроки, 0))) КАК
	|		КоличествоСубконто,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВидыСубконто1.ВидСубконто, ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка)) В
	|			(ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Контрагенты),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.КорреспондентыПоВнутреннимРасчетам))
	|			ТОГДА 1
	|		КОГДА ЕСТЬNULL(ВидыСубконто2.ВидСубконто, ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка)) В
	|			(ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Контрагенты),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.КорреспондентыПоВнутреннимРасчетам))
	|			ТОГДА 2
	|		КОГДА ЕСТЬNULL(ВидыСубконто3.ВидСубконто, ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка)) В
	|			(ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Контрагенты),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.КорреспондентыПоВнутреннимРасчетам))
	|			ТОГДА 3
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК НомерСубконтоКонтрагенты,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВидыСубконто1.ВидСубконто,
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка)) = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Договоры)
	|			ТОГДА 1
	|		КОГДА ЕСТЬNULL(ВидыСубконто2.ВидСубконто,
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка)) = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Договоры)
	|			ТОГДА 2
	|		КОГДА ЕСТЬNULL(ВидыСубконто3.ВидСубконто,
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка)) = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Договоры)
	|			ТОГДА 3
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК НомерСубконтоДоговоры,
	|	ЕПСБУ.Родитель.Код КАК Родитель1,
	|	ЕПСБУ.Родитель.Родитель.Код КАК Родитель2,
	|	ЕПСБУ.Родитель.Родитель.Родитель.Код КАК Родитель3
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ВидыСубконто1
	|		ПО ЕПСБУ.Ссылка = ВидыСубконто1.Ссылка
	|		И ВидыСубконто1.НомерСтроки = 1
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ВидыСубконто2
	|		ПО ЕПСБУ.Ссылка = ВидыСубконто2.Ссылка
	|		И ВидыСубконто2.НомерСтроки = 2
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ВидыСубконто3
	|		ПО ЕПСБУ.Ссылка = ВидыСубконто3.Ссылка
	|		И ВидыСубконто3.НомерСтроки = 3
	|ГДЕ
