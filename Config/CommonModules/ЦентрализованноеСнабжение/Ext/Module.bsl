// 
// Параметры:
//  Форма - см. Перечисление.ВидыОперацийВходящееИзвещение.Форма.ФормаВыбора
//        - см. Перечисление.ВидыОперацийИсходящееИзвещение.Форма.ФормаВыбора2
Процедура УстановитьУсловноеОформлениеСпискаВидовИзвещений(Форма) Экспорт
	Элемент = Форма.УсловноеОформление.Элементы.Добавить();
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Использование = Истина;
	Поле.Поле = Новый ПолеКомпоновкиДанных("СписокПредставление");
