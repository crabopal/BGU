		ВидСравненияКомпоновкиДанных.Заполнено);
	Элемент.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);

	Элемент = Форма.УсловноеОформление.Элементы.Добавить();
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Использование = Истина;
	Поле.Поле = Новый ПолеКомпоновкиДанных("СписокСсылка");
	Поле = Элемент.Поля.Элементы.Добавить();
	Поле.Использование = Истина;
	Поле.Поле = Новый ПолеКомпоновкиДанных("СписокОтступ");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(Элемент.Отбор, "Список.Ссылка",
		ВидСравненияКомпоновкиДанных.НеЗаполнено);
	Элемент.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
КонецПроцедуры

// Заполнить список видов извещений.
// 
// Параметры:
//  Форма - см. Перечисление.ВидыОперацийВходящееИзвещение.Форма.ФормаВыбора
//        - см. Перечисление.ВидыОперацийИсходящееИзвещение.Форма.ФормаВыбора
//  ЗначениеПеречисления - ПеречислениеСсылка.ВидыОперацийВходящееИзвещение
//                       - ПеречислениеСсылка.ВидыОперацийИсходящееИзвещение
Процедура ЗаполнитьСписокВидовИзвещений(Форма, ЗначениеПеречисления) Экспорт
	Форма.СписокВсеВиды.Очистить();
	
	ВидыОпераций = ЦентрализованноеСнабжениеПовтИсп.КлассификацияВидовОпераций(ЗначениеПеречисления);
	
	Для Каждого Операция Из ВидыОпераций Цикл
		НоваяСтрока = Форма.СписокВсеВиды.Добавить();
		НоваяСтрока.Ссылка = Операция.ВидИзвещения;
		НоваяСтрока.Представление = Строка(Операция.ВидИзвещения);
		НоваяСтрока.ДокументооборотОтОтправителя = Операция.СоСтороныОтправителя;
		НоваяСтрока.ДокументооборотОтПолучателя = Операция.СоСтороныПолучателя;
		НоваяСтрока.КлассическийДО = Операция.Классический;
		НоваяСтрока.ЭДО = Операция.ЭДО;
		НоваяСтрока.ПервоеИзвещение = Истина;
		НоваяСтрока.ВтороеИзвещение = Ложь;
		НоваяСтрока.Описание = ОписаниеВидаИзвещения(НоваяСтрока.Ссылка, НоваяСтрока.КлассическийДО, НоваяСтрока.ЭДО, НоваяСтрока.ПервоеИзвещение, НоваяСтрока.ВтороеИзвещение);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОписаниеВидаИзвещения(ВидИзвещения, КлассическийДО, ЭДО, ПервоеИзвещение, ВтороеИзвещение)
	
	ТекстОписания = ШаблонОписания(КлассическийДО, ЭДО);
	
	ДопустимыеКорреспонденции = ДопустимыеКорреспонденцииПоВидуОперацииИзвещение(ВидИзвещения);
	
	ПояснениеЭДО = "";
	ПояснениеКлассическийДО = "";
	Если ТипЗнч(ВидИзвещения) = Тип("ПеречислениеСсылка.ВидыОперацийВходящееИзвещение") Тогда
		Если ЭДО Тогда
			Если ПервоеИзвещение Тогда
				ПояснениеЭДО =
				"<div>Регистрация получения извещения.</div>";
				Если ДопустимыеКорреспонденции = Неопределено Тогда
					ПояснениеЭДО = ПояснениеЭДО + "
					|<div>Проводки формируются учетными документами, которые прикрепляются
					|к ответному <strong>Исходящему извещению</strong>.</div>";
				Иначе
					ПояснениеЭДО = ПояснениеЭДО + "
					|<div>Проводки формируются ответным <strong>Исходящим извещением</strong>.</div>";
				КонецЕсли;
			ИначеЕсли ВтороеИзвещение Тогда
				ПояснениеЭДО =
				"<div>Регистрация получения ответного извещения.</div>
				|<div>Проводки не формируются.</div>";
			КонецЕсли;
		КонецЕсли;
		Если КлассическийДО Или ДопустимыеКорреспонденции <> Неопределено Тогда
			Если ДопустимыеКорреспонденции = Неопределено Тогда
				ПояснениеКлассическийДО = ОписаниеБезКорреспонденций();
			Иначе
				ПояснениеКлассическийДО = ОписаниеКорреспонденции();
				ПараметрыВставки = Новый Структура("СчетаДт, СчетаКт",
					СтрСоединить(ДопустимыеКорреспонденции.СчетаДт, ",<br/>"),
					СтрСоединить(ДопустимыеКорреспонденции.СчетаКт, ",<br/>"));
				ПояснениеКлассическийДО = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(
					ПояснениеКлассическийДО, ПараметрыВставки);
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ВидИзвещения) = Тип("ПеречислениеСсылка.ВидыОперацийИсходящееИзвещение") Тогда
		ОписаниеКорреспонденции = ОписаниеКорреспонденции();
		Если ЭДО Тогда
			Если ПервоеИзвещение Тогда
				ПояснениеЭДО =
				"<div>Формируются проводки стороны, начинающей документооборот</div>";
				Если ДопустимыеКорреспонденции = Неопределено Тогда
					ПояснениеЭДО = ПояснениеЭДО + "
					|" + ОписаниеБезКорреспонденций();
				КонецЕсли;
			ИначеЕсли ВтороеИзвещение Тогда
				ПояснениеЭДО =
				"<div><strong>Формируются проводки отражения в учете входящего извещения.</strong></div>";
				Если Не КлассическийДО Тогда
					ПараметрыВставки = Новый Структура("СчетаДт, СчетаКт",
						СтрСоединить(ДопустимыеКорреспонденции.СчетаДт, ",<br/>"),
						СтрСоединить(ДопустимыеКорреспонденции.СчетаКт, ",<br/>"));
					ПояснениеЭДО = ПояснениеЭДО
						+ СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(
							ОписаниеКорреспонденции,
							ПараметрыВставки);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если КлассическийДО Тогда
			Если ДопустимыеКорреспонденции = Неопределено Тогда
				ПояснениеКлассическийДО = ОписаниеБезКорреспонденций();
			Иначе
				ПараметрыВставки = Новый Структура("СчетаДт, СчетаКт",
					СтрСоединить(ДопустимыеКорреспонденции.СчетаДт, ",<br/>"),
					СтрСоединить(ДопустимыеКорреспонденции.СчетаКт, ",<br/>"));
				ПояснениеКлассическийДО = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(
					ОписаниеКорреспонденции, ПараметрыВставки);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	ТекстОписания = СтрЗаменить(ТекстОписания, "[ПояснениеЭДО]", ПояснениеЭДО);
	ТекстОписания = СтрЗаменить(ТекстОписания, "[ДопустимыеКорреспонденции]", ПояснениеКлассическийДО);
	ТекстОписания = СтрЗаменить(ТекстОписания, "[ИмяПеречисления]", Строка(ВидИзвещения));
	Возврат ТекстОписания;
	
КонецФункции

Функция ШаблонОписания(КлассическийДО, ЭДО)
	ТекстШаблона =
	"<html>
	|<head></head>
	|<body>
	|<h3>[ИмяПеречисления]</h3>";
	Если ЭДО Тогда
		ТекстШаблона = ТекстШаблона + "
		|<h4>При использовании ЭДО</h4>
		|[ПояснениеЭДО]";
	КонецЕсли;
	Если КлассическийДО Тогда
		ТекстШаблона = ТекстШаблона + "
		|<h4>Без использования ЭДО</h4>
		|<div>
		|<span>Допустимые корреспонденции:</span>
		|</div>
		|[ДопустимыеКорреспонденции]";
	КонецЕсли;
	ТекстШаблона = ТекстШаблона + "
	|</body>
	|</html>";
	Возврат ТекстШаблона;
КонецФункции

Функция ОписаниеБезКорреспонденций()
	Возврат
	"<div>
	|<span>Проводки формируются учетными документами</span>
	|</div>";
КонецФункции

Функция ОписаниеКорреспонденции()
