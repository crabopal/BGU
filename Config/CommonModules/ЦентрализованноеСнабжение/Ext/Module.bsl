	Результат.Колонки.Добавить("НомерСубконтоКонтрагенты", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("УчетПоКПС", Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("УчетПоКЭК", Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("УчетПоПодразделениям", Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("УчетПоПодразделениямОбязательный", Новый ОписаниеТипов("Булево"));
	Возврат Результат;
КонецФункции

