////////////////////////////////////////////////////////////////////////////////
// Подсистема «Аудит состояния системы».
// 
////////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Предназначен для регистрации и обновления в системе прикладной проверки аудита состояния системы.
//
// Параметры:
//  ПараметрыРегистрации - Структура с ключами:
// 	Идентификатор - строка, макс. длина 50 симв., прикладной идентификатор проверки,
//		должен удовлетворять требованиям уникальности в пределах системы.
//		Если проверка с таким идентификатором уже зарегистрирована в системе,
//		то произойдет обновление ее свойств.
//	Название - строка, макс. длина 150 симв., пользовательское представление проверки.
//  Важность - ПеречислениеСсылка.ВажностьПроблемыУчета
//	РасписаниеВыполнения - РасписаниеРегламентногоЗадания, расписание выполнения
//		проверки по умолчанию.
//	Группа, строка, код группы проверок
//  Используется, булево, признак выполенния прверки автоматически регламентным заданием
//  ОписаниеДополнительныхПараметров - таблица значений, описание колонок 
//      таблицы см. в функции ТаблицаДополнительныхПараметровПроверки()
//  
//
Процедура ЗарегистрироватьПроверкуСостоянияСистемы(ПараметрыРегистрации) Экспорт
	
	ПроверкаСсылка = ПроверкаПоИдентификатору(ПараметрыРегистрации.Идентификатор);
	Если ПроверкаСсылка = Справочники.ПроверкиСостоянияСистемы.ПустаяСсылка() Тогда
		ПроверкаОбъект = Справочники.ПроверкиСостоянияСистемы.СоздатьЭлемент();
	Иначе
		ПроверкаОбъект = ПроверкаСсылка.ПолучитьОбъект();
	КонецЕсли;
	
	ПроверкаОбъект.Код 			= ПараметрыРегистрации.Идентификатор;
	ПроверкаОбъект.Наименование = ПараметрыРегистрации.Название;
	ПроверкаОбъект.Комментарий	= ПараметрыРегистрации.Комментарий;
	ПроверкаОбъект.Важность 	= ПараметрыРегистрации.Важность;
	ПроверкаОбъект.Используется = ПараметрыРегистрации.Используется;
	ПроверкаОбъект.ОписаниеДополнительныхПараметров = Новый ХранилищеЗначения(ПараметрыРегистрации.ОписаниеДополнительныхПараметров);
	
	//Дополнительные параметры автоматического выполнения проверки
	Если ТипЗнч(ПараметрыРегистрации.ОписаниеДополнительныхПараметров) = Тип("ТаблицаЗначений") Тогда
		МассивПараметров = ПараметрыРегистрации.ОписаниеДополнительныхПараметров.НайтиСтроки(Новый Структура("ИспользуетсяДляАвтопроверки", Истина));
		ПараметрыАвтопроверки = Новый Структура;
		Для Каждого ЗначениеПараметра Из МассивПараметров Цикл
			ПараметрыАвтопроверки.Вставить(ЗначениеПараметра.ИмяПараметра, ЗначениеПараметра.ЗначениеПоУмолчанию);
		КонецЦикла;
		
		ПроверкаОбъект.ДополнительныеПараметрыАвтопроверки = Новый ХранилищеЗначения(ПараметрыАвтопроверки);
 
	КонецЕсли;	
	
	ПроверкаОбъект.ДополнительныеСвойства.Вставить("РасписаниеВыполнения", 	ПараметрыРегистрации.РасписаниеВыполнения);
	
	Если НЕ ПараметрыРегистрации.Группа = Неопределено Тогда
		ПроверкаОбъект.Родитель = ПроверкаПоИдентификатору(ПараметрыРегистрации.Группа);
	КонецЕсли;	
	 	
	Попытка
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ПроверкаОбъект);
	Исключение
		ПредставлениеОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Ошибка при попытке зарегистрировать проверку %1: %2'"), ПараметрыРегистрации.Название, ИнформацияОбОшибке());
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	КонецПопытки;
	
КонецПроцедуры

// Выполнение проверки состояния системы.
// Метод выполняет проверку с указанным идентификатором, регистрирует выявленные проблемы.
// Актуализирует сведения о ранее зарегистрированных проблемах.
//
// Параметры:
//	ИдентификаторПроверки - строка, указанная при регистрации проверки, 
//		см. ЗарегистрироватьПроверкуСостоянияСистемы.
//
Процедура ВыполнитьПроверкуСостоянияСистемы(ИдентификаторПроверки, ЗначенияДопПараметров = Неопределено) Экспорт
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания();
	
	Проверка = Справочники.ПроверкиСостоянияСистемы.НайтиПоКоду(ИдентификаторПроверки);
	Если Проверка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Определить структуру запрашиваемых результатов.
	ПроверкаВыполнена = Ложь;
	
	ВыявленныеПроблемы = Новый ТаблицаЗначений;
	ВыявленныеПроблемы.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	ВыявленныеПроблемы.Колонки.Добавить("Важность", Новый ОписаниеТипов("ПеречислениеСсылка.ВажностьПроблемыУчета"));
	ВыявленныеПроблемы.Колонки.Добавить("ДополнительнаяИнформация");
	ВыявленныеПроблемы.Колонки.Добавить("Объекты", Новый ОписаниеТипов("Массив"));
	ВыявленныеПроблемы.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	
	// Запросить результаты - выполнить проверку.
	АудитСостоянияСистемыПереопределяемый.ВыполнитьПроверкуСостоянияСистемы(ИдентификаторПроверки, ПроверкаВыполнена, ВыявленныеПроблемы, ЗначенияДопПараметров);
	
	// Интерпретировать результаты.
	Если Не ПроверкаВыполнена Тогда
		// Проверка не выполнялась
		Возврат;
	КонецЕсли;
	
	КоличествоПроблем = ВыявленныеПроблемы.Количество();
	
	ИнформацияОПроверке = ЗначенияДопПараметров.ИнформацияОПроверке;
	
	// Регистрируем факт выполнения проверки.
	НоваяЗапись = РегистрыСведений.ВыполнениеПроверокСостоянияСистемы.СоздатьМенеджерЗаписи();
	НоваяЗапись.Проверка = Проверка;
	НоваяЗапись.ДатаВыполнения = ТекущаяДатаСеанса();
	НоваяЗапись.ВыявленыПроблемы = КоличествоПроблем;
	НоваяЗапись.ИнформацияОПроверке = ИнформацияОПроверке;
	НоваяЗапись.Записать();
	
	// Добавим запись в журнал регистрации.
	Если КоличествоПроблем > 0 Тогда
		КомментарийСобытия = НСтр("ru = 'Проверка «%1» завершена, выявлено проблем %2.'");
	Иначе
		КомментарийСобытия = НСтр("ru = 'Проверка «%1» завершена успешно, проблем не выявлено.'");
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации(
		АудитСостоянияСистемыКлиентСервер.ИмяСобытияЖурналаРегистрации(), 
		УровеньЖурналаРегистрации.Информация, 
		Метаданные.Справочники.ПроверкиСостоянияСистемы, 
		Проверка, 
		СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(КомментарийСобытия, Проверка, КоличествоПроблем));
	
	// Регистрируем выявленные проблемы:
	// - среди ранее зарегистрированных проблем нужно выявить те, которые по-прежнему есть в описании,
	// - остальные удалить, 
	// - добавить те, которых пока не зарегистрировано
	
	// Выявленные проблемы, преобразуем в таблицу, где для каждого объекта сделана отдельная строка.
	ТаблицаВыявленныхПроблем = Новый ТаблицаЗначений;
	ТаблицаВыявленныхПроблем.Колонки.Добавить("Проверка", Новый ОписаниеТипов("СправочникСсылка.ПроверкиСостоянияСистемы"));
	ТаблицаВыявленныхПроблем.Колонки.Добавить("Проблема", Новый ОписаниеТипов("УникальныйИдентификатор"));
	ТаблицаВыявленныхПроблем.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	ТаблицаВыявленныхПроблем.Колонки.Добавить("Важность", Новый ОписаниеТипов("ПеречислениеСсылка.ВажностьПроблемыУчета"));
	ТаблицаВыявленныхПроблем.Колонки.Добавить("Объект", ОписаниеТиповЛюбойСсылки());
	ТаблицаВыявленныхПроблем.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	
	// Дополнительную информацию отдельно запоминаем по проблемам для дальнейшей записи.
	ДополнительнаяИнформация = Новый Соответствие;
	
	Для Каждого ОписаниеПроблемы Из ВыявленныеПроблемы Цикл
		Проблема = Новый УникальныйИдентификатор;
		Для Каждого Объект Из ОписаниеПроблемы.Объекты Цикл
			НоваяСтрока = ТаблицаВыявленныхПроблем.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ОписаниеПроблемы);
			НоваяСтрока.Проблема 	= Проблема;
			НоваяСтрока.Проверка 	= Проверка;
			НоваяСтрока.Объект 		= Объект;
		КонецЦикла;
		ДополнительнаяИнформация.Вставить(Проблема, Новый ХранилищеЗначения(ОписаниеПроблемы.ДополнительнаяИнформация));
	КонецЦикла;
	
	ТаблицаОписанийПроблем = ТаблицаВыявленныхПроблем.Скопировать(,"Проверка, Проблема, Представление, Важность, Организация");
	ТаблицаОписанийПроблем.Свернуть("Проверка, Проблема, Представление, Важность, Организация");
	
	// Необходимо обновить данные регистров в том числе по организации, интерпретация следующая:
	// - если организация передана, то перезаписываем ее и пустую.
	// (пустая организация означает проверку, не относящуюся к конкретной организаци).
	// - если организация не передана, то перезаписываем все организации из регистра проблем,
	// доступные пользователю, а также пустую
	Если ЗначенияДопПараметров.Свойство("Организация") И ЗначениеЗаполнено(ЗначенияДопПараметров.Организация) Тогда
		Организации = Новый Массив;
		Организации.Добавить(ЗначенияДопПараметров.Организация);
		Организации.Добавить(Справочники.Организации.ПустаяСсылка());
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ПроблемыСостоянияСистемы.Организация КАК Организация,
		|	МАКСИМУМ(ПроблемыСостоянияСистемы.Важность) КАК Важность
		|ИЗ
		|	РегистрСведений.ПроблемыСостоянияСистемы КАК ПроблемыСостоянияСистемы
		|
		|СГРУППИРОВАТЬ ПО
		|	ПроблемыСостоянияСистемы.Организация";
		Организации = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Организация");
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(
			Организации, ВыявленныеПроблемы.ВыгрузитьКолонку("Организация"), Истина);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(
			Организации, ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Справочники.Организации.ПустаяСсылка()), Истина);
	КонецЕсли;
	
	ПроблемыНабор = РегистрыСведений.ПроблемыСостоянияСистемы.СоздатьНаборЗаписей();
	ПроблемыНабор.Отбор.Проверка.Установить(Проверка);
	
	ОбъектыНабор = РегистрыСведений.ОбъектыПроблемСостоянияСистемы.СоздатьНаборЗаписей();
	ОбъектыНабор.Отбор.Проверка.Установить(Проверка);
	
	Для Каждого Организация Из Организации Цикл
		
		ПроблемыНабор.Отбор.Организация.Установить(Организация);
		ОбъектыНабор.Отбор.Организация.Установить(Организация);
		
		МассивОписанийПроблем = ТаблицаОписанийПроблем.НайтиСтроки(Новый Структура("Организация",Организация));
		
		Для Каждого ОписаниеПроблемы Из МассивОписанийПроблем Цикл
			СтрокаПроблемы = ПроблемыНабор.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаПроблемы, ОписаниеПроблемы);
			СтрокаПроблемы.ДополнительнаяИнформация = ДополнительнаяИнформация[ОписаниеПроблемы.Проблема];
		КонецЦикла;
		
		МассивВыявленныхПроблем = ТаблицаВыявленныхПроблем.НайтиСтроки(Новый Структура("Организация",Организация));
		
		Для Каждого ВыявленнаяПроблема Из МассивВыявленныхПроблем Цикл
			СтрокаОбъекты = ОбъектыНабор.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаОбъекты, ВыявленнаяПроблема);
		КонецЦикла;
		
		ПроблемыНабор.Записать();
		ОбъектыНабор.Записать();
		
		ПроблемыНабор.Очистить();
		ОбъектыНабор.Очистить();
		
	КонецЦикла;
	
КонецПроцедуры

// Метод предназначен для включения/выключения автоматического выполнения проверки.
//
// Параметры:
//	Идентификатор - строка, указанная при регистрации проверки, 
//		см. ЗарегистрироватьПроверкуСостоянияСистемы.
//	Использование - булево, если Истина - проверка используется автоматически.
//
Процедура УстановитьИспользованиеПроверкиСостоянияСистемы(Идентификатор, Использование) Экспорт
	
	ПроверкаСсылка = Справочники.ПроверкиСостоянияСистемы.НайтиПоКоду(Идентификатор);
	Если ПроверкаСсылка = Неопределено Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Проверка с идентификатором %1 в системе не зарегистрирована.'"), Идентификатор);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ПроверкаОбъект = ПроверкаСсылка.ПолучитьОбъект();
	ПроверкаОбъект.Используется = Использование;
	ПроверкаОбъект.Записать();
	
КонецПроцедуры

// Возвращает пустую таблицу описания дополнительных параметров проверки
//
Функция ТаблицаДополнительныхПараметровПроверки() Экспорт
	
	ТаблицаПараметров = Новый ТаблицаЗначений;
	ТаблицаПараметров.Колонки.Добавить("ТипПараметра", 					Новый ОписаниеТипов("Строка"));
	ТаблицаПараметров.Колонки.Добавить("ИмяПараметра", 					Новый ОписаниеТипов("Строка"));
	ТаблицаПараметров.Колонки.Добавить("Заголовок", 					Новый ОписаниеТипов("Строка"));
	ТаблицаПараметров.Колонки.Добавить("Обязательный", 					Новый ОписаниеТипов("Булево"));
	ТаблицаПараметров.Колонки.Добавить("ИспользуетсяДляАвтопроверки", 	Новый ОписаниеТипов("Булево"));
	ТаблицаПараметров.Колонки.Добавить("ЗначениеПоУмолчанию");
	
	Возврат ТаблицаПараметров;
	
КонецФункции	

// Возвращает структуру параметров проверки состояния системы
//
Функция СтруктураПараметровПроверкиСостоянияСистемы() Экспорт
	
	СтруктураПараметров = Новый Структура;
	
	СтруктураПараметров.Вставить("Идентификатор");
	СтруктураПараметров.Вставить("Название");
	СтруктураПараметров.Вставить("Важность", ПредопределенноеЗначение("Перечисление.ВажностьПроблемыУчета.Ошибка"));
	СтруктураПараметров.Вставить("РасписаниеВыполнения", Неопределено);
	СтруктураПараметров.Вставить("Группа", Неопределено);
	СтруктураПараметров.Вставить("Используется", Истина);
	СтруктураПараметров.Вставить("ОписаниеДополнительныхПараметров", Неопределено);
	
	Возврат СтруктураПараметров;
	
КонецФункции	

// Выполнение проверки состояния системы общим регламентным заданием "ПроверкаСостоянияСистемы".
// Метод выполняет проверки из справочника "ПроверкиСостоянияСистемы" с установленным признаком "Используется"
// и с незаданным отдельным расписанием
//
// Параметры:
//	ИдентификаторПроверки - строка, указанная при регистрации проверки, 
//		см. ЗарегистрироватьПроверкуСостоянияСистемы.
//
Процедура ВыполнитьПроверкиСостоянияСистемы(ИдентификаторПроверки = Неопределено) Экспорт
	
	ОбщегоНазначения.ПриНачалеВыполненияРегламентногоЗадания();
	
	Если ПустаяСтрока(ИмяПользователя()) Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	
	ИмяСобытия = НСтр("ru = 'Проверка ведения учета.'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка());
	
	ЗаписьЖурналаРегистрации(
		ИмяСобытия,
		УровеньЖурналаРегистрации.Информация,
		,
		,
		НСтр("ru = 'Начата регламентная проверка ведения учета (технологический анализ).'"));
	
	Если ЗначениеЗаполнено(ИдентификаторПроверки) Тогда
		ИдентификаторыПроверок = Новый Массив;
		ИдентификаторыПроверок.Добавить(ИдентификаторПроверки);
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ПроверкиСостоянияСистемы.Код
		|ИЗ
		|	Справочник.ПроверкиСостоянияСистемы КАК ПроверкиСостоянияСистемы
		|ГДЕ
		|	ПроверкиСостоянияСистемы.Используется
		|	И НЕ ПроверкиСостоянияСистемы.ПоОтдельномуРасписанию";
		
		ИдентификаторыПроверок = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Код");
		
	КонецЕсли;
	
	Для Каждого ИдентификаторПроверки Из ИдентификаторыПроверок Цикл
		ВыполнитьПроверкуСостоянияСистемы(ИдентификаторПроверки);
	КонецЦикла;
	
	ЗаписьЖурналаРегистрации(
		ИмяСобытия,
		УровеньЖурналаРегистрации.Информация,
		,
		,
		НСтр("ru = 'Завершена регламентная проверка ведения учета (технологический анализ).'"));
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Предназначен для получение ссылки на элемент справочника 
//	ПроверкиСостоянияСистемы по идентификатору проверки.
//
// Параметры:
//	Идентификатор - строка, указанная при регистрации проверки, 
//		см. ЗарегистрироватьПроверкуСостоянияСистемы.
//
// Возвращаемое значение - ссылка на элемент справочника проверок.
//
Функция ПроверкаПоИдентификатору(Идентификатор) Экспорт
	
	Возврат Справочники.ПроверкиСостоянияСистемы.НайтиПоКоду(Идентификатор);
	
КонецФункции

// Метод предназначен для получения произвольных сведений, связанных с проблемой, 
//	указанных при выявлении проблемы в момент проверки.
//
// Параметры:
//	Проблема - уникальный идентификатор проблемы.
//
// Возвращаемое значение - значение произвольного типа 
//	или Неопределено, если проблема не найдена.
//
Функция ДополнительнаяИнформацияПоПроблеме(Проблема) Экспорт
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	Проблемы.ДополнительнаяИнформация
	|ИЗ
	|	РегистрСведений.ПроблемыСостоянияСистемы КАК Проблемы
	|ГДЕ
	|	Проблемы.Проблема = &Проблема";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Проблема", Проблема);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ДополнительнаяИнформация.Получить();
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОписаниеТиповЛюбойСсылки()
	
	ЛюбаяСсылка = Новый Массив;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ЛюбаяСсылка, Справочники.ТипВсеСсылки().Типы());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ЛюбаяСсылка, Документы.ТипВсеСсылки().Типы());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ЛюбаяСсылка, БизнесПроцессы.ТипВсеСсылки().Типы());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ЛюбаяСсылка, ПланыВидовХарактеристик.ТипВсеСсылки().Типы());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ЛюбаяСсылка, ПланыСчетов.ТипВсеСсылки().Типы());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ЛюбаяСсылка, ПланыВидовРасчета.ТипВсеСсылки().Типы());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ЛюбаяСсылка, Задачи.ТипВсеСсылки().Типы());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ЛюбаяСсылка, ПланыОбмена.ТипВсеСсылки().Типы());
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ЛюбаяСсылка, Перечисления.ТипВсеСсылки().Типы());
	
	Возврат Новый ОписаниеТипов(ЛюбаяСсылка);
	
КонецФункции

Функция РезультатПроверкиВДлительнойОперации(Форма, МассивПроверок, ЗначенияДопПараметров = Неопределено) Экспорт
	
	СтруктураПараметров = Новый Структура("МассивПроверок, ЗначенияДопПараметров", МассивПроверок, ЗначенияДопПараметров);
	
	НаименованиеЗадания = НСтр("ru = 'Проверка ведения учета'");
	
	Результат = ДлительныеОперации.ЗапуститьВыполнениеВФоне(
		Форма.УникальныйИдентификатор,
		"АудитСостоянияСистемы.ВыполнитьПроверки",
		СтруктураПараметров,
		НаименованиеЗадания);
	
	Форма.АдресХранилища = Результат.АдресХранилища;
		
	Возврат Результат;
	
КонецФункции

Процедура ВыполнитьПроверки(Параметры, АдресХранилища) Экспорт
	
	ИдентификаторыПроверок = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(Параметры.МассивПроверок, "Код");
	
	ЗначенияДопПараметров = Неопределено;
	Параметры.Свойство("ЗначенияДопПараметров", ЗначенияДопПараметров);
	ЗначенияДопПараметровСоответствие = ЗначенияДопПараметров;
	
	Для Каждого КлючИЗначение Из ИдентификаторыПроверок Цикл
		Если ТипЗнч(ЗначенияДопПараметровСоответствие) = Тип("Соответствие") Тогда
			ЗначенияДопПараметров = ЗначенияДопПараметровСоответствие.Получить(КлючИЗначение.Значение);
		КонецЕсли;
		ВыполнитьПроверкуСостоянияСистемы(КлючИЗначение.Значение, ЗначенияДопПараметров);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
