// Получает значение поля по ключу в карте данных
//
// Параметры:
//  АдресКартыДанных - Карта данных для поиска
//  СтрокаРесурса - Имя поля ресурса, значение которого возвращается
//  ЗначениеПоУмолчанию - значение возвращаемое если строка не найдена
//  СтрокаИзмерений - Строка имен полей с разделителями "," определяющая ключ поиска
//  Значение1 - Значение первого измерения
//  ...
//  Значение10 - Значение десятого измерения
//
// Возвращаемое значение:
//  Значение ресурса, если строка найдена по ключу "Строка ресурса"
//  ЗначениеПоУмолчанию - если строка с указанным ключем не найдена
//
Функция НайтиВКартеДанных(АдресКартыДанных, СтрокаРесурса, ЗначениеПоУмолчанию = Неопределено, СтрокаИзмерений, Значение1 = Неопределено,
								Значение2 = Неопределено, Значение3 = Неопределено, Значение4 = Неопределено, Значение5 = Неопределено,
								Значение6 = Неопределено, Значение7 = Неопределено, Значение8 = Неопределено, Значение9 = Неопределено, Значение10 = Неопределено) Экспорт
								
	Перем КартаДанных;
	Перем ПараметрыПоиска;
	Перем МассивИзмерений;
	Перем НайденныеСтроки;
	Перем НайденноеЗначение;
	
	КартаДанных = ЗаполнениеОтчетностиСерверПовтИсп.ПолучитьИзВременногоХранилищаПовтИсп(АдресКартыДанных);
	
	Если ТипЗнч(КартаДанных) <> Тип("ТаблицаЗначений") Тогда
		
		ТекстОшибки = НСтр("ru = 'Не удалось получить значение карты данных при вычислении значения вычисляемого поля'");
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	ПараметрыПоиска = Новый Структура;
	
	МассивИзмерений = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаИзмерений);
	КоличествоИзмерений = ?(МассивИзмерений.Количество() > 10, 10, МассивИзмерений.Количество());
	
	СтруктураЗИ = Новый Структура("Значение1,Значение2,Значение3,Значение4,Значение5,Значение6,Значение7,Значение8,Значение9,Значение10",
		Значение1,Значение2,Значение3,Значение4,Значение5,Значение6,Значение7,Значение8,Значение9,Значение10);							
	
	Для ном = 1 По КоличествоИзмерений Цикл
		
		ПараметрыПоиска.Вставить(МассивИзмерений[ном - 1], СтруктураЗИ["Значение"+ном]);
		
	КонецЦикла;
	
	НайденныеСтроки = КартаДанных.НайтиСтроки(ПараметрыПоиска);
	
	НайденноеЗначение = ЗначениеПоУмолчанию;
	
	Если НайденныеСтроки.Количество() > 0 Тогда
		
		НайденноеЗначение = НайденныеСтроки[0][СтрокаРесурса];
		
	КонецЕсли;
	
	Возврат НайденноеЗначение;
	
КонецФункции

// Получает таблицу плана счетов в которой каждому счету соответствует родительский счет с учетом всей иерархии
//
// Параметры:
//  Нет
//
// Возвращаемое значение:
//  Таблица значений с колонками:
//     Ссылка - Ссылка на счет
//     Родитель - Ссылка на родительский счет, если счет первого уровня, то ссылка на счет
//
Функция ПолучитьИерархиюПланаСчетов() Экспорт
	
	Возврат ЗаполнениеОтчетностиСервер.ПолучитьИерархиюПланаСчетов();
	
КонецФункции

