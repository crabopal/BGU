// Получает массив вызовов общих модулей для данной конфигурации
// Вызовы вида: <ИмяОбщегоМодуля> + "."
//
// Параметры:
//  Сервер, ВнешнееСоединение, ВызовСервера, КлиентОбычноеПриложение,
//  КлиентУправляемоеПриложение, Глобальный, Привилегированный,
//  ПовторноеИспользованиеВозвращаемыхЗначений - флаги общего модуля
//
// Возвращаемое значение:
//  Массив вызовов
//
Функция ПолучитьВызовыОбщихМодулей(Знач Сервер = Неопределено,
								   Знач ВнешнееСоединение = Неопределено, 
								   Знач ВызовСервера = Неопределено, 
								   Знач КлиентОбычноеПриложение = Неопределено, 
								   Знач КлиентУправляемоеПриложение = Неопределено, 
								   Знач Глобальный = Неопределено, 
								   Знач Привилегированный = Неопределено, 
								   Знач ПовторноеИспользованиеВозвращаемыхЗначений = Неопределено,
								   ТолькоЗапрещенные = Ложь) Экспорт
	
	МассивВызовов = Новый Массив;
	
	РазрешенныеМодули = ПолучитьРазрешенныеВызовыОбщихМодулей();
	
	Для каждого ОбщийМодуль Из Метаданные.ОбщиеМодули Цикл
		
		ВключатьВВыборку = Истина;
		
		Если ТипЗнч(Сервер) = Тип("Булево") И ОбщийМодуль.Сервер <> Сервер Тогда
			ВключатьВВыборку = Ложь;
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(ВнешнееСоединение) = Тип("Булево") И ОбщийМодуль.ВнешнееСоединение <> ВнешнееСоединение Тогда
			ВключатьВВыборку = Ложь;
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(ВызовСервера) = Тип("Булево") И ОбщийМодуль.ВызовСервера <> ВызовСервера Тогда
			ВключатьВВыборку = Ложь;
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(КлиентОбычноеПриложение) = Тип("Булево") И ОбщийМодуль.КлиентОбычноеПриложение <> КлиентОбычноеПриложение Тогда
			ВключатьВВыборку = Ложь;
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(КлиентУправляемоеПриложение) = Тип("Булево") И ОбщийМодуль.КлиентУправляемоеПриложение <> КлиентУправляемоеПриложение Тогда
			ВключатьВВыборку = Ложь;
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(Глобальный) = Тип("Булево") И ОбщийМодуль.Глобальный <> Глобальный Тогда
			ВключатьВВыборку = Ложь;
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(Привилегированный) = Тип("Булево") И ОбщийМодуль.Привилегированный <> Привилегированный Тогда
			ВключатьВВыборку = Ложь;
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(ПовторноеИспользованиеВозвращаемыхЗначений) = Тип("Булево") И ОбщийМодуль.ПовторноеИспользованиеВозвращаемыхЗначений <> ПовторноеИспользованиеВозвращаемыхЗначений Тогда
			ВключатьВВыборку = Ложь;
			Продолжить;
		КонецЕсли;
		
		Если ТолькоЗапрещенные = Истина Тогда
			
			Если РазрешенныеМодули.Найти(НРег(ОбщийМодуль.Имя)+".") <> Неопределено Тогда
				ВключатьВВыборку = Ложь;
				Продолжить;
			КонецЕсли;
			
		КонецЕсли;
		
		Если ВключатьВВыборку Тогда
			МассивВызовов.Добавить(НРег(ОбщийМодуль.Имя)+".");
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МассивВызовов;
	
КонецФункции

функция ПолучитьРазрешенныеВызовыОбщихМодулей() Экспорт 
	
	Результат = Новый Массив;
	
	Результат.Добавить(НРег("ЗаполнениеОтчетности."));
	Результат.Добавить(НРег("СтроковыеФункцииКлиентСервер."));
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьМинимальнуюДлинуВызова() Экспорт
	
	ВызовыОМ = ЗаполнениеОтчетностиСерверПовтИсп.ПолучитьВызовыОбщихМодулей();	
	
	МинимальнаяДлинаВызова = 1000;
	
	Для каждого ТекстВызова Из ВызовыОМ Цикл
			
		МинимальнаяДлинаВызова = Мин(МинимальнаяДлинаВызова, СтрДлина(ТекстВызова));
		
	КонецЦикла;
	
	Если МинимальнаяДлинаВызова = 1000 Тогда
		МинимальнаяДлинаВызова = 1;
	КонецЕсли;
	
	Возврат МинимальнаяДлинаВызова;
	
КонецФункции

// Получает дерево функций для вычисляемых полей и массив разрешенных вызовов общих модулей из шаблона
//
// Параметры:
//  ИмяМакета - Макет содержащий описание методов в виде DOM-модели
//
// Возвращаемое значение:
//  Структура содержащая ДеревоМетодов и МассивРазрешенныхВызовов
//
Функция ПолучитьДеревоМетодов(ИмяМакета) Экспорт
	
	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипЧисло = Новый ОписаниеТипов("Число");
	
	ДеревоЗначений = Новый ДеревоЗначений;
	
	ДеревоЗначений.Колонки.Добавить("Наименование",ТипСтрока,"Наименование");
	ДеревоЗначений.Колонки.Добавить("Шаблон",ТипСтрока,"Шаблон");
	ДеревоЗначений.Колонки.Добавить("Подсказка",ТипСтрока,"Подсказка");
	ДеревоЗначений.Колонки.Добавить("Уровень",ТипЧисло,"Уровень");
	
	МассивРазрешенныхВызовов = Новый Массив;
	
	ТекстСправки = Справочники.ПравилаЗаполнения.ПолучитьМакет(ИмяМакета).ПолучитьТекст();
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ТекстСправки);
	
	ПостроительDOM = Новый ПостроительDOM;
	ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
	
	Для каждого Раздел Из ДокументDOM.ПервыйДочерний.ДочерниеУзлы Цикл
		
		СтрокаДереваРаздел = ДеревоЗначений.Строки.Добавить();
		СтрокаДереваРаздел.Наименование = Раздел.Атрибуты.ПолучитьИменованныйЭлемент("Заголовок").Значение;
		СтрокаДереваРаздел.Уровень = 0;
		
		Для каждого Подраздел Из Раздел.ДочерниеУзлы Цикл
			
			СтрокаДереваПодраздел = СтрокаДереваРаздел.Строки.Добавить();
			СтрокаДереваПодраздел.Наименование = Подраздел.Атрибуты.ПолучитьИменованныйЭлемент("Заголовок").Значение;
			СтрокаДереваПодраздел.Уровень = 0;
			
			Для каждого Метод Из Подраздел.ДочерниеУзлы Цикл
				
				СтрокаДереваМетод = СтрокаДереваПодраздел.Строки.Добавить();
				СтрокаДереваМетод.Наименование = Метод.Атрибуты.ПолучитьИменованныйЭлемент("Имя").Значение;
				СтрокаДереваМетод.Шаблон = Метод.Атрибуты.ПолучитьИменованныйЭлемент("Шаблон").Значение;
				СтрокаДереваМетод.Подсказка = Метод.ПервыйДочерний.ТекстовоеСодержимое;
				СтрокаДереваМетод.Уровень = 3;
				
				Если СтрокаДереваРаздел.Наименование = "Функции общих модулей" Тогда
					
					ТекстВызова = СтрокаДереваМетод.Шаблон;
					Поз = Найти(ТекстВызова,"(");
					
					Если Поз <> 0 Тогда
						ПолноеИмяМетода = СокрЛП(Сред(СтрокаДереваМетод.Шаблон,1,Поз-1));
						Если НЕ ПустаяСтрока(ПолноеИмяМетода) Тогда
							МассивРазрешенныхВызовов.Добавить(НРег(ПолноеИмяМетода));
						КонецЕсли;
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("ДеревоМетодов", ДеревоЗначений);
	СтруктураВозврата.Вставить("МассивРазрешенныхВызовов", МассивРазрешенныхВызовов);
	
	Возврат СтруктураВозврата;
	
КонецФункции

// Получает из хранилища значений карту данных по адресу
//
// Параметры:
//  АдресХранилища - Строка, содержащая адрес во временном хранилище
//
// Возвращаемое значение:
//  Значение полученное из временного хранилища
//
Функция ПолучитьИзВременногоХранилищаПовтИсп(АдресХранилища) Экспорт
	
	Если ЭтоАдресВременногоХранилища(АдресХранилища) Тогда
		
		Возврат ПолучитьИзВременногоХранилища(АдресХранилища);
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;
	
КонецФункции // ПолучитьИзВременногоХранилищаПовтИсп()

// Получает имя объекта метаданных по типу переданного значения
//
// Параметры:
//  Значение - значение, для которого надо получить имя объекта метаданных
//           - Допустимы только примитивные типы, ссылки, Структура или Неопределено
//
// Возвращаемое значение:
//  Строка, имя объекта метаданных
//
Функция ПолучитьИмяОбъектаМетаданных(Знач Значение) Экспорт
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("Неопределено") Тогда
		
		Возврат "";
		
	Иначе
		
		ИмяОбъекта = ЗаполнениеОтчетности.ВернутьСтрокуТипаПоТипу(ТипЗначения,"Запрос");
		
		Поз = Найти(ИмяОбъекта, ".");
		Если Поз = 0 Тогда
			
			Возврат ИмяОбъекта;
			
		Иначе
			
			Возврат Сред(ИмяОбъекта, Поз + 1);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции

// Получает таблицу колонок указанного вида отчета с опциональным отбором по типу
//
// Параметры:
//  ВидОтчета - Ссылка на вид отчета
//  ТипЗначения - Тип значения показателя
//	ГруппаРаскрытия - Группа раскрытия, в которой нужно найти колонку
//
// Возвращаемое значение:
//  Таблица значений, содержащая колонки вида отчета с полями: Код, Представление, ПорядковыйНомер
//
Функция ПолучитьКолонкиВидаОтчета(Знач ВидОтчета, Знач ТипЗначения = Неопределено, Знач ГруппаРаскрытия = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	КолонкиОтчетов.Код,
		|	КолонкиОтчетов.Представление,
		|	КолонкиОтчетов.ПорядковыйНомер
		|ИЗ
		|	Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КолонкиОтчетов КАК КолонкиОтчетов
		|		ПО ПоказателиОтчетов.Колонка = КолонкиОтчетов.Ссылка
		|			И (ПоказателиОтчетов.Владелец = &ВидОтчета)
		|			%1
		|			%2
		|
		|УПОРЯДОЧИТЬ ПО
		|	КолонкиОтчетов.ПорядковыйНомер,
		|	КолонкиОтчетов.Код";
		
	УсловиеТипЗначения = "";	
	Если НЕ ТипЗначения = Неопределено Тогда
		
		Запрос.УстановитьПараметр("ТипЗначения", ТипЗначения);
		УсловиеТипЗначения = "И (ПоказателиОтчетов.ТипЗначения = &ТипЗначения)";
		
	КонецЕсли;
	
	УсловиеГруппаРаскрытия = "";
	Если НЕ ГруппаРаскрытия = Неопределено Тогда
		
		Запрос.УстановитьПараметр("ГруппаРаскрытия", ГруппаРаскрытия);
		УсловиеГруппаРаскрытия = "И (ПоказателиОтчетов.ГруппаРаскрытия = &ГруппаРаскрытия)";
		
	КонецЕсли;
	
	Запрос.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Запрос.Текст, УсловиеТипЗначения, УсловиеГруппаРаскрытия);
	
	Запрос.УстановитьПараметр("ВидОтчета", ВидОтчета);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

// Получает таблицу настроек расшифровки стандартными отчетами
//
// Параметры:
//  Нет
//
// Возвращаемое значение:
//  Таблица значений, содержащая настройки для расшифровки
//
Функция ПолучитьНастройкиРасшифровки() Экспорт
	
	Макет = Обработки.ОбработкаДанныхОтчетности.ПолучитьМакет("СтандартныеОтчетыДляРасшифровки");
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(Макет.ПолучитьТекст());
	
	ТаблицаДанных = СериализаторXDTO.ПрочитатьXML(ЧтениеXML, Тип("ТаблицаЗначений"));
	Если ТипЗнч(ТаблицаДанных) = Тип("ТаблицаЗначений") Тогда
		
		Возврат ТаблицаДанных;
		
	Иначе
		
		Возврат Новый ТаблицаЗначений;
		
	КонецЕсли;
	
КонецФункции

// Получает синоним макета шаблона запроса по его имени
//
// нужно помнить что в Макете возвращается ссылка на скд в озу а не новое значение   
// Параметры:
//  ВидТаблицы - Строка, имя макета
//
// Возвращаемое значение:
//  Строка, синоним макета
//
Функция ПолучитьИнформациюОВидеТаблицы(ВидТаблицы) Экспорт
	
	Результат = Новый Структура("Имя,Представление,ПолноеИмяМакета");
	
	ВидыТаблиц = ЗаполнениеОтчетностиСерверПовтИсп.ПолучитьВидыТаблиц();
	ОписаниеТаблицы = ВидыТаблиц.Получить(ВидТаблицы);
	
	Если ОписаниеТаблицы = Неопределено Тогда 
		Шаблон = НСтр(
		"ru = 'В системе отсутствует макет СКД для таблицы ""%1"".'");
		Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, ВидТаблицы);
		
		ВызватьИсключение Сообщение;
	КонецЕсли;
	
	Результат.Имя = ВидТаблицы;
	ЗаполнитьЗначенияСвойств(Результат,ОписаниеТаблицы,"Представление,ПолноеИмяМакета");
	
	Возврат Новый ФиксированнаяСтруктура(Результат); 
	
КонецФункции

// Получает список доступных типов данных доступных для общих параметров правила заполнения
//
// Параметры:
//  Нет
//
// Возвращаемое значение:
//  Список значение - содержит доступные типы данных
//
Функция ПолучитьСписокДоступныхТиповДанных() Экспорт
	
	ТипСтрока = Новый ОписаниеТипов("Строка", ,
				Новый КвалификаторыСтроки(150, ДопустимаяДлина.Переменная));
	
	СписокВыбора = Новый СписокЗначений;
	СписокВыбора.ТипЗначения = ТипСтрока;
	
	СписокВыбора.Добавить("Булево");
	СписокВыбора.Добавить("Дата");
	СписокВыбора.Добавить("Строка");
	СписокВыбора.Добавить("Число");
	
	// Заполняем все типы из плана видов характеристик "АналитикаОтчетов"
	// Значения данных типов будут созданы автоматически при обмене правилами
	Для каждого Тип Из Метаданные.ПланыВидовХарактеристик.АналитикаОтчетов.Тип.Типы() Цикл
		
		ТипСтрокой = ЗаполнениеОтчетности.ВернутьСтрокуТипаПоТипу(Тип, "Запрос");
		
		Если СписокВыбора.НайтиПоЗначению(ТипСтрокой) = Неопределено Тогда
			
			СписокВыбора.Добавить(ТипСтрокой, Строка(Тип));
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Заполняем все типы перечислений
	// Значения данных типов будут созданы автоматически при обмене правилами
	Для каждого ОбъектМД Из Метаданные.Перечисления Цикл
		
		ТипСтрокой = "Перечисление."+ОбъектМД.Имя;
		
		Если СписокВыбора.НайтиПоЗначению(ТипСтрокой) = Неопределено Тогда
			
			СписокВыбора.Добавить(ТипСтрокой, ОбъектМД.Синоним);
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Добавляем необходимые типы (список может дополняться)
	// Значения данных типов будут созданы автоматически при обмене правилами
	МассивДополнительныхТипов = Новый Массив;
	
	ЗаполнениеОтчетностиСерверПереопределяемый.ДополнитьСписокДоступныхТиповДанных(МассивДополнительныхТипов);
	//МассивДополнительныхТипов.Добавить(Тип("СправочникСсылка.РазделыЛицевыхСчетов"));
	
	Для каждого ДополнительныйТип Из МассивДополнительныхТипов Цикл
		
		ТипСтрокой = ЗаполнениеОтчетности.ВернутьСтрокуТипаПоТипу(ДополнительныйТип, "Запрос");
		
		ОбъектМД = Метаданные.НайтиПоТипу(ДополнительныйТип);
		Если ОбъектМД = Неопределено Тогда
			
			Поз = Найти(ТипСтрокой,".");
			Если Поз = 0 Тогда
				ИмяОбъекта = ТипСтрокой;
			Иначе
				ИмяОбъекта = Сред(ТипСтрокой, Поз + 1);
			КонецЕсли;
			
			Представление = БюджетнаяОтчетностьКлиентСервер.Синоним(ИмяОбъекта);
			
		Иначе
			
			Представление = ОбъектМД.Синоним;
			
		КонецЕсли;
		
		Если СписокВыбора.НайтиПоЗначению(ТипСтрокой) = Неопределено Тогда
			
			СписокВыбора.Добавить(ТипСтрокой, Представление);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СписокВыбора;
	
КонецФункции

// Получает методы дополнительной обработки доступные для применения в правилах заполнения
//
// Параметры:
//  Нет
//
// Возвращаемое значение:
//  ТаблицаМетодов - Таблица значений, содержащая описание методов дополнительной обработки.
//	Колонки:
//		ИмяМетода - Строка
//		Представление - Строка
//		Параметры - Строка, перечисление имен параметров разделенных символом ","
//		ХранимыеПараметры - таблица значений, описавает параметры метода, необходима для выполнения функций обмена
//
Функция ПолучитьСписокМетодовДополнительнойОбработки() Экспорт
	
	ОбработкаОбъект = Обработки.ОбработкаДанныхОтчетности.Создать();
	Возврат ОбработкаОбъект.ПолучитьМетодыДополнительнойОбработки();
	
КонецФункции

// Получает таблицу соответствия видов субконто
//
// Параметры:
//  Нет
//
// Возвращаемое значение:
//  Таблица значений
//
Функция ПолучитьТаблицуСоответствияВидовСубконто() Экспорт
	
	Макет = Обработки.ОбработкаДанныхОтчетности.ПолучитьМакет("ТаблицаСоответствияВидовСубконто");
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(Макет.ПолучитьТекст());
	БуферОбмена = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
	
	ТаблицаМакета = СериализаторXDTO.ПрочитатьXDTO(БуферОбмена);
	ТаблицаМакета.Индексы.Добавить("ИмяПредопределенногоБГУ1");
	
	Возврат ТаблицаМакета;
	
КонецФункции

