		ДокументОбъект.Записать(РежимЗаписи);
		
		//Формирование состояния акта
		Если ТипАкта = ТипАктаОтветногоПринимающейСтороны()	Тогда
			ИсходящийАкт = ДокументОбъект.ДокументОснование;
			Реквизиты = "ДокументОснование";
			ЗначенияРеквизитовИсходящегоАкта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ИсходящийАкт, Реквизиты);
			ДокументПередачиНФА = ЗначенияРеквизитовИсходящегоАкта.ДокументОснование;
			
			Если ЗначениеЗаполнено(ДокументПередачиНФА) Тогда
				СостояниеЭДОАкта = Перечисления.СостоянияДокументовАктовЭДОБГУ.ПолученОтветныйАкт;
				НаборЗаписей = РегистрыСведений.СостоянияПоДокументамАктовЭДОБГУ.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.СсылкаНаОбъект.Установить(ДокументПередачиНФА);
				НаборЗаписей.Записывать = Истина;
				Запись = НаборЗаписей.Добавить();
				Запись.СсылкаНаОбъект = ДокументПередачиНФА;
				Запись.СостояниеЭДО = СостояниеЭДОАкта;
				НаборЗаписей.Записать(Истина);
			КонецЕсли;
		КонецЕсли;	
	Исключение
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Заполнение документа на основе ЭД. %1'"), Текст)
			+ Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ВыполнитьЗаписьСобытияПоЭДВЖурналРегистрации(ТекстСообщения,
			2, УровеньЖурналаРегистрации.Ошибка, ДокументОбъект.Метаданные(), СсылкаНаВладельца);
		ВызватьИсключение(Текст);
	КонецПопытки;
	#КонецОбласти	
	
КонецПроцедуры

Функция ТаблицаСозданнойНоменклатурыНФАПоАкту(Организация, GUIDНоменклатурыОтправителя) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОсновныеСредства.Ссылка КАК Ссылка,
	               |	ОсновныеСредства.GUIDНоменклатурыОтправителя КАК GUIDНоменклатурыУОтправителя
	               |ИЗ
	               |	Справочник.ОсновныеСредства КАК ОсновныеСредства
	               |ГДЕ
	               |	ОсновныеСредства.GUIDНоменклатурыОтправителя В(&GUIDНоменклатурыОтправителя)
	               |	И ОсновныеСредства.Организация = &Организация
	               |	И ОсновныеСредства.ПометкаУдаления = ЛОЖЬ
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	Номенклатура.Ссылка,
	               |	Номенклатура.GUIDНоменклатурыОтправителя
	               |ИЗ
	               |	Справочник.Номенклатура КАК Номенклатура
	               |ГДЕ
	               |	Номенклатура.GUIDНоменклатурыОтправителя В(&GUIDНоменклатурыОтправителя)
	               |	И Номенклатура.ПометкаУдаления = ЛОЖЬ";

	Запрос.УстановитьПараметр("GUIDНоменклатурыОтправителя", GUIDНоменклатурыОтправителя);
	Запрос.УстановитьПараметр("Организация", Организация);
	Результат = Запрос.Выполнить().Выгрузить();

	Возврат Результат;
КонецФункции	

Функция ТаблицаСведенийТехДокументацииДрагМатериаловПоАкту(Организация, GUIDНоменклатурыОтправителя) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОсновныеСредства.Ссылка КАК Ссылка,
	               |	ОсновныеСредства.GUIDНоменклатурыОтправителя КАК GUIDНоменклатурыУОтправителя
	               |ПОМЕСТИТЬ НоменклатураНФА
	               |ИЗ
	               |	Справочник.ОсновныеСредства КАК ОсновныеСредства
	               |ГДЕ
	               |	ОсновныеСредства.GUIDНоменклатурыОтправителя В(&GUIDНоменклатурыОтправителя)
	               |	И ОсновныеСредства.Организация = &Организация
	               |	И ОсновныеСредства.ПометкаУдаления = ЛОЖЬ
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	Номенклатура.Ссылка,
	               |	Номенклатура.GUIDНоменклатурыОтправителя
	               |ИЗ
	               |	Справочник.Номенклатура КАК Номенклатура
	               |ГДЕ
	               |	Номенклатура.GUIDНоменклатурыОтправителя В(&GUIDНоменклатурыОтправителя)
	               |	И Номенклатура.ПометкаУдаления = ЛОЖЬ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	НоменклатураНФА.Ссылка КАК Ссылка,
	               |	НоменклатураНФА.GUIDНоменклатурыУОтправителя КАК GUIDНоменклатурыУОтправителя,
	               |	ДрагМатериалыВОбъектахНФАПоТехДокументации.Ссылка КАК ТехДокументацияПоДрагМатериалам
	               |ИЗ
	               |	НоменклатураНФА КАК НоменклатураНФА
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДрагМатериалыВОбъектахНФАПоТехДокументации КАК ДрагМатериалыВОбъектахНФАПоТехДокументации
	               |		ПО НоменклатураНФА.Ссылка = ДрагМатериалыВОбъектахНФАПоТехДокументации.ОбъектНФА";

	Запрос.УстановитьПараметр("GUIDНоменклатурыОтправителя", GUIDНоменклатурыОтправителя);
	Запрос.УстановитьПараметр("Организация", Организация);
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
КонецФункции	

