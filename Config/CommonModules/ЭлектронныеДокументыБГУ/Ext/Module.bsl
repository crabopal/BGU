// Заполнение документов ИБ по данным электронных документов

Функция ПодготовитьСтруктуруДляСчетНаОплатуОтпоставщика(СтрокаДляЗагрузки, ДеревоРазбора)
	
	ДанныеДляОбъекта = Новый Структура;
	ДанныеЗаполненияШапки = Новый Структура;
	Для Каждого СтрокаРеквизита Из СтрокаДляЗагрузки.Строки Цикл
		Если СтрокаРеквизита.Строки.Количество() = 0 Тогда
			Реквизит = ПолучитьЗначениеРеквизитаДерева(СтрокаРеквизита, СтрокаРеквизита.Реквизит, Истина, ДеревоРазбора);
			Если ЗначениеЗаполнено(Реквизит) Тогда
				ДанныеЗаполненияШапки.Вставить(СтрокаРеквизита.Реквизит, Реквизит);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ДанныеЗаполненияШапки.Вставить("НомерПервичногоДокумента", ПолучитьЗначениеРеквизитаДерева(СтрокаДляЗагрузки, "Номер"));
	ДанныеЗаполненияШапки.Вставить("ДатаПервичногоДокумента",  ПолучитьЗначениеРеквизитаДерева(СтрокаДляЗагрузки, "Дата"));
	ДанныеЗаполненияШапки.Вставить("ВидПервичногоДокумента",  "Счет на оплату");
	ДанныеЗаполненияШапки.Вставить("НазначениеПлатежа", ПолучитьЗначениеРеквизитаДерева(СтрокаДляЗагрузки, "НазначениеПлатежа"));
	
	ДанныеДляОбъекта.Вставить("Шапка",  ДанныеЗаполненияШапки);
	
	Возврат ДанныеДляОбъекта;
	
КонецФункции

Функция ПодготовитьСтруктуруДляПоступлениеУслугРабот(СтрокаДляЗагрузки, ДеревоРазбора)
	
	ТипыДокументов = ОбменСКонтрагентами.ТипыДокументов();
	
	ДанныеДляОбъекта = Новый Структура;
	ДанныеЗаполненияШапки = Новый Структура;
	СтрокаДереваДопДанных = ДеревоРазбора.Строки.Найти("ДеревоДопДанных", "Реквизит", Истина);
	Если СтрокаДереваДопДанных <> Неопределено И ТипЗнч(СтрокаДереваДопДанных.ЗначениеРеквизита) = Тип("ДеревоЗначений") Тогда
		ДеревоДопДанных = СтрокаДереваДопДанных.ЗначениеРеквизита;
	КонецЕсли;
	ТЗ = Документы.ПоступлениеУслугРабот.ПустаяСсылка().УслугиИРаботы.ВыгрузитьКолонки();
	Если СтрокаДляЗагрузки.ВидЭД = ТипыДокументов.АктВыполненныхРабот Тогда
		Для Каждого СтрокаРеквизита Из СтрокаДляЗагрузки.Строки Цикл
			Если СтрокаРеквизита.Реквизит = "СписокОписаний" Тогда
				СтрокаРеквизитаОписанийРабот = ПолучитьЗначениеРеквизитаДерева(СтрокаРеквизита, СтрокаРеквизита.Реквизит, Истина, ДеревоРазбора);
				Для Каждого СтрокаРеквизитаОписания Из СтрокаРеквизитаОписанийРабот.Строки Цикл
					Если СтрокаРеквизитаОписания.Строки.Количество() = 0 Тогда
						Реквизит = ПолучитьЗначениеРеквизитаДерева(СтрокаРеквизитаОписания, СтрокаРеквизитаОписания.Реквизит, Истина, ДеревоРазбора);
						Если ЗначениеЗаполнено(Реквизит) Тогда
							ДанныеЗаполненияШапки.Вставить(СтрокаРеквизитаОписания.Реквизит, Реквизит);
						КонецЕсли;
					Иначе
						ЗаполнитьСтрокуТЧ_ПУР(ТЗ, СтрокаРеквизитаОписания.Строки, ДеревоРазбора, ДанныеЗаполненияШапки.Контрагент);
					КонецЕсли;
					
				КонецЦикла;
			Иначе
				Если СтрокаРеквизита.Строки.Количество() = 0 Тогда
					Реквизит = ПолучитьЗначениеРеквизитаДерева(СтрокаРеквизита, СтрокаРеквизита.Реквизит, Истина, ДеревоРазбора);
					Если ЗначениеЗаполнено(Реквизит) Тогда
						ДанныеЗаполненияШапки.Вставить(СтрокаРеквизита.Реквизит, Реквизит);
					КонецЕсли;
				Иначе
					ЗаполнитьСтрокуТЧ_ПУР(ТЗ, СтрокаРеквизита.Строки, ДеревоРазбора, ДанныеЗаполненияШапки.Контрагент);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	Иначе
		Для Каждого СтрокаРеквизита Из СтрокаДляЗагрузки.Строки Цикл
			Если СтрокаРеквизита.Строки.Количество() = 0 Тогда
				Реквизит = ПолучитьЗначениеРеквизитаДерева(СтрокаРеквизита, СтрокаРеквизита.Реквизит, Истина, ДеревоРазбора);
				Если ЗначениеЗаполнено(Реквизит) Тогда
					ДанныеЗаполненияШапки.Вставить(СтрокаРеквизита.Реквизит, Реквизит);
				КонецЕсли;
			Иначе
				ЗаполнитьСтрокуТЧ_ПУР(ТЗ, СтрокаРеквизита.Строки, ДеревоРазбора, ДанныеЗаполненияШапки.Контрагент);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	СкопироватьЗначениеСтруктуры(ДанныеЗаполненияШапки, "Организация", "Организация");
	СкопироватьЗначениеСтруктуры(ДанныеЗаполненияШапки, "Валюта", "ВалютаДокумента");
	
	Если ДанныеЗаполненияШапки.Свойство("Валюта") Тогда 
		СтруктураВалюты    = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ДанныеЗаполненияШапки.Валюта, КонецДня(ДанныеЗаполненияШапки.Дата));
		ДанныеЗаполненияШапки.Вставить("КурсВзаиморасчетов", СтруктураВалюты.Курс);
		ДанныеЗаполненияШапки.Вставить("КратностьВзаиморасчетов", СтруктураВалюты.Кратность);
	Иначе
		ВалютаРегУчета = Константы.ВалютаРегламентированногоУчета.Получить();
		ДанныеЗаполненияШапки.Вставить("Валюта", ВалютаРегУчета);
		ДанныеЗаполненияШапки.Вставить("КурсВзаиморасчетов", 1);
		ДанныеЗаполненияШапки.Вставить("КратностьВзаиморасчетов", 1);
	КонецЕсли;	
	
	ДанныеЗаполненияШапки.Вставить("ВидПервичногоДокумента", "Акт об оказании услуг");
	ДанныеЗаполненияШапки.Вставить("НомерПервичногоДокумента", ПолучитьЗначениеРеквизитаДерева(СтрокаДляЗагрузки, "Номер"));
	ДанныеЗаполненияШапки.Вставить("ДатаПервичногоДокумента",  ПолучитьЗначениеРеквизитаДерева(СтрокаДляЗагрузки, "Дата"));
	
	Для Каждого Строка Из ТЗ Цикл
		Если НЕ ЗначениеЗаполнено(Строка.СтавкаНДС) Тогда
			Если ЗначениеЗаполнено(Строка.СуммаНДС) 
				И ЗначениеЗаполнено(Строка.Сумма) Тогда
				//Определим ставку НДС расчетным путем
				ЗначениеСтавки = ОКР(Строка.СуммаНДС / (Строка.Сумма),2);
				Строка.СтавкаНДС = ПолучитьСтавкуНДСПеречислением(ЗначениеСтавки);
			КонецЕсли;
		КонецЕсли;
		Строка.Всего = Строка.Сумма + Строка.СуммаНДС;
	КонецЦикла;

	ДанныеДляОбъекта.Вставить("Шапка",  ДанныеЗаполненияШапки);
	ДанныеДляОбъекта.Вставить("Услуги", ТЗ);
	
	Возврат ДанныеДляОбъекта;
	
КонецФункции

Функция ПодготовитьСтруктуруДляПоступленияТоваровУслуг(СтрокаДляЗагрузки, ДеревоРазбора)
	
	ДанныеДляОбъекта = Новый Структура;
	ДанныеЗаполненияШапки = Новый Структура;
	ТЗ = Документы.ЭлектронныйДокументПоставщика.ПустаяСсылка().СписокНоменклатуры.ВыгрузитьКолонки();
	Для Каждого СтрокаРеквизита Из СтрокаДляЗагрузки.Строки Цикл
		Если СтрокаРеквизита.Строки.Количество() = 0 Тогда
			Реквизит = ПолучитьЗначениеРеквизитаДерева(СтрокаРеквизита, СтрокаРеквизита.Реквизит, Истина, ДеревоРазбора);
			Если ЗначениеЗаполнено(Реквизит) Тогда
				ДанныеЗаполненияШапки.Вставить(СтрокаРеквизита.Реквизит, Реквизит);
			КонецЕсли;
		Иначе
			ЗаполнитьСтрокуТЧ_МЗ_Покупка(ТЗ, СтрокаРеквизита.Строки, ДеревоРазбора, ДанныеЗаполненияШапки.Контрагент);
		КонецЕсли;
	КонецЦикла;
	
	ДанныеЗаполненияШапки.Вставить("НомерПервичногоДокумента", ПолучитьЗначениеРеквизитаДерева(СтрокаДляЗагрузки, "Номер"));
	ДанныеЗаполненияШапки.Вставить("ДатаПервичногоДокумента",  ПолучитьЗначениеРеквизитаДерева(СтрокаДляЗагрузки, "Дата"));
	ДанныеЗаполненияШапки.Вставить("ВидПервичногоДокумента",  ПолучитьЗначениеРеквизитаДерева(СтрокаДляЗагрузки, "Накладная ""ТОРГ-12"""));
	
	ДанныеЗаполненияШапки.Вставить("ТипФорматаЭД",  1);
	
	ДанныеДляОбъекта.Вставить("Шапка",  ДанныеЗаполненияШапки);
	ДанныеДляОбъекта.Вставить("Товары", ТЗ);
	
	Возврат ДанныеДляОбъекта;
	
КонецФункции

Функция ПодготовитьСтруктуруДляСчетФактуры(СтрокаДляЗагрузки, ДеревоРазбора)
	
	ТипыДокументов = ОбменСКонтрагентами.ТипыДокументов();
	
	ДанныеОбъекта         = Новый Структура;
	ДанныеЗаполненияШапки = Новый Структура;
	
	ВидОперации = "Реализация";
	СтрокаНомерИсправления     = СтрокаДляЗагрузки.Строки.Найти("НомерИсправления", "Реквизит");
	Если СтрокаНомерИсправления <> Неопределено И ЗначениеЗаполнено(СтрокаНомерИсправления.ЗначениеРеквизита) Тогда
		Если СтрокаДляЗагрузки.ВидЭД = ТипыДокументов.КорректировочныйСчетФактура Тогда
			ВидОперации = "ИсправлениеКорректировки";
		Иначе	
			ВидОперации = "ИсправлениеРеализации";
		КонецЕсли;	
	ИначеЕсли СтрокаДляЗагрузки.ВидЭД = ТипыДокументов.КорректировочныйСчетФактура Тогда
		ВидОперации = "Корректировка";
	КонецЕсли;	
	
	ДеревоДопДанных = Неопределено;
	СтрокаДереваДопДанных = ДеревоРазбора.Строки.Найти("ДеревоДопДанных", "Реквизит", Истина);
	Если СтрокаДереваДопДанных <> Неопределено И ТипЗнч(СтрокаДереваДопДанных.ЗначениеРеквизита) = Тип("ДеревоЗначений") Тогда
		ДеревоДопДанных = СтрокаДереваДопДанных.ЗначениеРеквизита;
	КонецЕсли;
	
	ТаблицаОснований = Новый ТаблицаЗначений;
	ТаблицаОснований.Колонки.Добавить("ДокументОснование");
	
	Для Каждого СтрокаРеквизита Из СтрокаДляЗагрузки.Строки Цикл
		Если СтрокаРеквизита.Строки.Количество() = 0 Тогда
			Если СтрокаРеквизита.Реквизит = "Контрагент" ИЛИ СтрокаРеквизита.Реквизит = "Организация" Тогда
				Реквизит = ПолучитьЗначениеРеквизитаДерева(СтрокаРеквизита, СтрокаРеквизита.Реквизит, Истина, ДеревоРазбора);
			Иначе	
				Реквизит = ПолучитьЗначениеРеквизитаДерева(СтрокаРеквизита, СтрокаРеквизита.Реквизит, Истина);
			КонецЕсли;	
			Если ЗначениеЗаполнено(Реквизит) Тогда
				ДанныеЗаполненияШапки.Вставить(СтрокаРеквизита.Реквизит, Реквизит);
			КонецЕсли;
		Иначе
			Если СтрокаРеквизита.Реквизит = "ДокументыОснования" Тогда
				Для Каждого Строка Из СтрокаРеквизита.Строки Цикл
					Если ТипЗнч(Строка.СсылкаНаОбъект) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда
						ДанныеЗаполненияШапки.Вставить("ЭДПоставщика", Строка.СсылкаНаОбъект);
					Иначе	
						СтрокаТаблицы = ТаблицаОснований.Добавить();
						СтрокаТаблицы.ДокументОснование = Строка.СсылкаНаОбъект;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// Соберем данные табличной части
	Если ВидОперации = "Реализация" Тогда
		ТЗ = Неопределено;
		Если СобратьТЧДляСФ(ТЗ, ДеревоРазбора, ВидОперации) Тогда
			ДанныеОбъекта.Вставить("Товары", ТЗ);
		КонецЕсли;	
	Иначе	
		ТЗ = Неопределено;
		Если СобратьТЧДляИсправительныхСФ(ТЗ, ДеревоРазбора, ВидОперации) Тогда
			ДанныеОбъекта.Вставить("Товары", ТЗ);
		КонецЕсли;	
	КонецЕсли;
	
	ДанныеЗаполненияШапки.Вставить("ВидЭД", СтрокаДляЗагрузки.ВидЭД);
	ДанныеЗаполненияШапки.Вставить("ДокументыОснования", ТаблицаОснований);
	ДанныеЗаполненияШапки.Вставить("ДатаПолучения", ТекущаяДатаСеанса());
	
	Если ВидОперации = "ИсправлениеРеализации" ИЛИ ВидОперации = "ИсправлениеКорректировки" Тогда
		ДанныеЗаполненияШапки.Вставить("Исправление", Истина);
	ИначеЕсли ВидОперации = "Корректировка" Тогда
		ДанныеЗаполненияШапки.Вставить("Корректировочный", Истина);
	КонецЕсли;	
	
	ВалКод = ПолучитьЗначениеРеквизитаДерева(СтрокаДляЗагрузки, "ВалКод");
	Если НЕ ВалКод = "643" Тогда
		ДанныеЗаполненияШапки.Вставить("ВИностраннойВалюте", Истина);
	КонецЕсли;
	
	Валюта = Справочники.Валюты.ПустаяСсылка();
	НайтиСсылкуНаОбъект("Валюты", Валюта, ВалКод);
	
	ДанныеЗаполненияШапки.Вставить("Валюта", Валюта);
	
	ДанныеОбъекта.Вставить("Шапка", ДанныеЗаполненияШапки);
	
	Возврат ДанныеОбъекта;
	
КонецФункции

// Поиск и создание счетов-фактур полученных
//
Функция ЗаполнитьСчетФактуру(СсылкаНаВладельца, ДанныеДляЗагрузки, Записывать, Текст, ДокументОбъект)
	ВозвращаемоеЗначение = Неопределено;
	
	Шапка  = ДанныеДляЗагрузки.Шапка;
	Товары = ДанныеДляЗагрузки.Товары;
	
	РежимЗаписи = РежимЗаписиДокумента.Запись;
	Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
		ДокументОбъект = СсылкаНаВладельца.ПолучитьОбъект();
		Если ДокументОбъект.Проведен Тогда 
			Текст = НСтр("ru = 'Операция возможна только для непроведенных документов!'");
		КонецЕсли;
	Иначе
		УстановитьПривилегированныйРежим(истина);
		ДокументОбъект = Документы.СчетФактураПолученный.СоздатьДокумент();
		ДокументОбъект.Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(ДокументОбъект, Шапка,,"Номер, Дата");
	ДокументОбъект.ОбменДанными.Загрузка = Истина;
	
	ДокументОбъект.КодВидаОперации = "01";
	ДокументОбъект.ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.Покупка;
	ДокументОбъект.КодСпособаВыставления = 2; //Электронный способ
	
	ДокументОбъект.ДополнительныеСвойства.Вставить("ЕстьСоглашение", Истина);
	
	ДокументОбъект.Организация = Шапка.Организация;
	
	ДокументОбъект.НомерПервичногоДокумента = Шапка.Номер;
	ДокументОбъект.ДатаПервичногоДокумента = Шапка.Дата;
	ДокументОбъект.ВидПервичногоДокумента = "Счет-фактура";
	
	Если Шапка.Свойство("ДокументыОснования") И ЗначениеЗаполнено(Шапка.ДокументыОснования) Тогда
		Для каждого ТекДокОснование Из Шапка.ДокументыОснования Цикл
			Если ТипЗнч(ТекДокОснование.ДокументОснование) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда
				ДокументОбъект.ЭДПоставщика = ТекДокОснование.ДокументОснование;
			Иначе	
				НоваяСтрокаДок = ДокументОбъект.ДокументыОснования.Добавить();
				НоваяСтрокаДок.ДокументОснование = ТекДокОснование.ДокументОснование;
			КонецЕсли;	
		КонецЦикла;	
		//ДокументОбъект.ДокументыОснования.Загрузить(Шапка.ДокументыОснования);
	КонецЕсли;
	
	// Заполним табличную часть
	ТабЧасть = ДокументОбъект.СоставНФА;
	ТабЧасть.Очистить();
	Для каждого СтрокаТовары из Товары Цикл
		ТекТЧ = ТабЧасть.Добавить();
		
		ЗаполнитьЗначенияСвойств(ТекТЧ, СтрокаТовары);
	КонецЦикла;	
	
	ДокументОбъект.ДополнительныеСвойства.Вставить("ПроцессыОбработкиДокументов_ЗаписатьБезПроверкиОбменДаннымиЗагрузка", Истина);
	Если Записывать Тогда
		Если НЕ ЗначениеЗаполнено(ДокументОбъект.Номер) Тогда
			ДокументОбъект.УстановитьНовыйНомер();
		КонецЕсли;
		ДокументОбъект.Записать(РежимЗаписи);
		ВозвращаемоеЗначение = ДокументОбъект.Ссылка;
	Иначе
		ВозвращаемоеЗначение = ДокументОбъект;
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
КонецФункции

