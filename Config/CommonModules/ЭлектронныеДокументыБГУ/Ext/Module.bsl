	СоответствиеРеквизитовОбъекта.Вставить("МЗ_Реализация.Контрагент", "НакладнаяНаРеализациюТорг12.Контрагент");
	
	СоответствиеРеквизитовОбъекта.Вставить("СчетФактураИсправительныйВыданныйВМетаданных",       "ИсправительныйСчетФактураВыданный");
