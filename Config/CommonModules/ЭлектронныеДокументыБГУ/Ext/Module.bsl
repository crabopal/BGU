								КонецЕсли;	
								
							ИначеЕсли ТипСправочника = НСтр("ru = 'Номенклатура'") Тогда
								НоваяСтрока = ДокументОбъектАктПриемки.Материалы.Добавить();	
								НоваяСтрока.Сумма = ЧислоИзСтрокиЭД(СтрокаТаблицыXDTOСписокНоменклатуры.Сумма);
								НоваяСтрока.СуммаПоДокументам = ЧислоИзСтрокиЭД(СтрокаТаблицыXDTOСписокНоменклатуры.СуммаПоДокументам);
								НоваяСтрока.Цена = ЧислоИзСтрокиЭД(СтрокаТаблицыXDTOСписокНоменклатуры.Цена);
								НоваяСтрока.ЦенаПоДокументам = ЧислоИзСтрокиЭД(СтрокаТаблицыXDTOСписокНоменклатуры.ЦенаПоДокументам);
								НоваяСтрока.Количество = ЧислоИзСтрокиЭД(СтрокаТаблицыXDTOСписокНоменклатуры.Количество);
