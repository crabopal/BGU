					Сообщение       = Новый СообщениеПользователю();
					Сообщение.Текст = ТекстСообщения;
					Сообщение.Сообщить();
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(ДанныеСотрудника.Должность) Тогда
					Отказ = Истина;
					
					ТекстСообщения  = НСтр("ru='В документе %ДокументПоставщика% на закладке ""Дополнительно"" в форме по ссылке ""Сведения для электронного УПД"" не указаны необходимы данные (должность) для ответственного за передачу лица!'");
