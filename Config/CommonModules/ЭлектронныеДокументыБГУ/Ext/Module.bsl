//                                    - УПД.
//   * ВариантыЗаполненияПолей - Структура - пользовательские настройки для заполнения полей:
//    ** ТоварКод - Строка - значение из списка, заданного в ПриОпределенииВариантовЗаполненияПолейЭлектронныхДокументов
//                           для идентификатора "УПД_ТоварКод".
//  Данные - ДеревоЗначений - данные для заполнения электронного документа. Строится по макету 
//                            см. Обработка.ОбменСКонтрагентами.Макет.УПД_ИнформацияПродавца_2019. Выходной параметр.
//  Описание - Структура - дополнительная информация о документе. Выходной параметр.
//   * Основания - Массив из ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО - ссылки на дополнительные объекты-основания
//                 электронного документа помимо указанного в параметре "Основание".
//  Отказ - Булево - признак отказа от дальнейшего формирования электронного документа.
//                   Информационное сообщение пользователю необходимо формировать самостоятельно.
//
Процедура ЗаполнитьДанныеУПД2019_ИнформацияПродавца(Знач Основание, Знач Настройки, Данные, Описание, Отказ) Экспорт
	
	ВсеВидыДокументов = ОбменСКонтрагентами.ТипыДокументов();
	ТипДокумента = Настройки.ТипДокумента;
	
	СтруктураЭД = ОбщегоНазначения.СкопироватьРекурсивно(Настройки, Ложь);
	
	ДокументУПД = Основание;
	
	Если ТипДокумента = ВсеВидыДокументов.УПД Тогда
		СтруктураЭД.Вставить("Функция", "СЧФДОП");
		ЗаполнитьДанныеДляУПДИнформацияПродавцаФНС_2019(ДокументУПД, СтруктураЭД, Данные, Отказ);
		
		Если ТипЗнч(Основание) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
			Описание.Основания.Добавить(Основание.ДокументОснование);
		Иначе
			СчетФактура = НайтиПодчиненныйСчетФактуруВыданный(ДокументУПД);
			Если ЗначениеЗаполнено(СчетФактура) Тогда
				Описание.Основания.Добавить(СчетФактура);
			КонецЕсли;
		КонецЕсли;	
	ИначеЕсли ТипДокумента = ВсеВидыДокументов.СчетФактура Тогда
		СтруктураЭД.Вставить("Функция", "СЧФ");
		ЗаполнитьДанныеДляСЧФИнформацияПродавцаФНС_2019(ДокументУПД, СтруктураЭД, Данные, Отказ);
	Иначе
		СтруктураЭД.Вставить("Функция", "ДОП");
		ЗаполнитьДанныеДляДОПИнформацияПродавцаФНС_2019(ДокументУПД, СтруктураЭД, Данные, Отказ);
	КонецЕсли;
	
	ФункцияУПД = СтруктураЭД.Функция;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(Данные, "Функция", ФункцияУПД);
	
КонецПроцедуры

