Функция ДанныеОрганизацииДляЗаявки(Организация, ДатаСведений) Экспорт
	СвойстваОрганизации = Новый Структура("НаименованиеПолное, ИНН, КПП, ОГРН, КодНалоговогоОргана");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Организация);
	Запрос.УстановитьПараметр("Период", ДатаСведений);
    Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
                   |	Организации.Код КАК КодВСистеме,
                   |	Организации.Наименование КАК Наименование,
                   |	Организации.НаименованиеПолное КАК НаименованиеПолное,
                   |	Организации.НаименованиеСокращенное КАК НаименованиеСокращенное,
                   |	Организации.ИНН КАК ИНН,
                   |	Организации.КПП КАК КПП,
                   |	Организации.РегистрацияВНалоговомОргане.Код КАК КодНалоговогоОргана,
                   |	Организации.ОГРН КАК ОГРН
                   |ИЗ
                   |	Справочник.Организации КАК Организации
                   |ГДЕ
                   |	Организации.Ссылка = &Ссылка";
				   
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СвойстваОрганизации.НаименованиеПолное = Выборка.НаименованиеПолное;
		СвойстваОрганизации.ИНН = Выборка.ИНН;
		СвойстваОрганизации.КПП = Выборка.КПП;
		СвойстваОрганизации.ОГРН = Выборка.ОГРН;
		СвойстваОрганизации.КодНалоговогоОргана = Выборка.КодНалоговогоОргана;
	КонецЦикла;
	
	Возврат СвойстваОрганизации;			   
КонецФункции	

