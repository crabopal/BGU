#Область ПолучениеДанных

Процедура ПодготовитьДанныеДокументаУПД_5_03(СсылкаНаОбъект, СтруктураЭД, ДанныеДокумента, ДопДанныеДокумента)
	
	МенеджерДокумента = ОбщегоНазначения.МенеджерОбъектаПоСсылке(СсылкаНаОбъект);
	
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		ДанныеДляЭД = МенеджерДокумента.ПодготовитьДанныеДляЭД(СсылкаНаОбъект, СтруктураЭД.Функция = "СЧФДОП");
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный") Тогда
		ДанныеДляЭД = МенеджерДокумента.ПодготовитьДанныеДляЭД(СсылкаНаОбъект,, СтруктураЭД.Функция = "СЧФДОП");
		
	Иначе
		ДанныеДляЭД = МенеджерДокумента.ПодготовитьДанныеДляЭД(СсылкаНаОбъект);
	КонецЕсли;
	
	ПривестиДанныеДляЭДКОжидаемойСтруктуреУПД_5_03(СсылкаНаОбъект, ДанныеДляЭД, ДанныеДокумента, ДопДанныеДокумента);
	
КонецПроцедуры

Процедура ПодготовитьДопДанныеДокументаУПД_5_03(СсылкаНаОбъект, СтруктураЭД, ДанныеДокумента, ДопДанныеДокумента, СведенияДляУПДСтатус1)
	
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.АктОбОказанииУслуг")
		Или ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ЭлектронныйПередаточныйДокументУслугиРаботы") Тогда
		НомерДокумента = НомерДляПечати(СсылкаНаОбъект, ДанныеДокумента.Шапка.НомерАкта);
		ДатаДокумента = ДанныеДокумента.Шапка.ДатаАкта;
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		НомерДокумента = ДопДанныеДокумента.НомерСФДляВыводаВРегистрыУчета.Номер;
		ДатаДокумента = ДанныеДокумента.Шапка.Дата;
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный") Тогда
		НомерДокумента = ДопДанныеДокумента.НомерСФДляВыводаВРегистрыУчета.Номер;
		ДатаДокумента = ДанныеДокумента.Шапка.ДатаСчетаФактуры;
		
	Иначе
		НомерДокумента = НомерДляПечати(СсылкаНаОбъект, ДанныеДокумента.Шапка.Номер);
		ДатаДокумента = ДанныеДокумента.Шапка.Дата;
	КонецЕсли;
	
	ДопДанныеДокумента.НомерДокумента = НомерДокумента;
	ДопДанныеДокумента.ДатаДокумента = ДатаДокумента;
	
	ДопДанныеДокумента.ЭтоАвансовыйСчетФактура = ЭтоАвансовыйСчетФактура(СсылкаНаОбъект, Истина);
	
	ДопДанныеДокумента.СведенияДляУПДСтатус1 = СведенияДляУПДСтатус1;
	
	ЗаполнитьРасчетныеСчетаУПД(ДопДанныеДокумента.РасчетныеСчета, СведенияДляУПДСтатус1.ПервичныйДокументПередачи.Ссылка);
	
	Если Не ДопДанныеДокумента.ЭтоАвансовыйСчетФактура Тогда
		ДопДанныеДокумента.ОписаниеФактаПередачи = ОпределитьОписаниеФактаПередачиУПД_5_03(ДанныеДокумента, СсылкаНаОбъект, СведенияДляУПДСтатус1);
	КонецЕсли;
	
	// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	ЭлектронноеАктированиеБГУ.ЗаполнитьДанныеЭлектронногоАктированияУПД_5_03(ДопДанныеДокумента, ДанныеДокумента.Шапка);
	// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	
КонецПроцедуры

Функция НовыйСтруктураДанныеДокументаУПД_5_03()
	
	Возврат Новый Структура("
		|Шапка,
		|ТабЧастьНФА,
		|ТабЧастьПРД,
		|ТабЧастьМаркировкаТоваров,
		|ТабЧастьДокументыОбОтгрузке,
		|ТабЧастьСчетаФактурыНаАванс");
	
КонецФункции

Функция НовыйСтруктураДопДанныеДокументаУПД_5_03()
	
	Возврат Новый Структура("
		|НомерДокумента,
		|ДатаДокумента,
		|ЭтоАвансовыйСчетФактура,
		|СтороныСделки,
		|НомерСФДляВыводаВРегистрыУчета,
		|ДокументыОбОтгрузке,
		|СведенияДляУПДСтатус1,
		|РасчетныеСчета,
		|ОписаниеФактаПередачи,
		|ДанныеЕИС");
	
КонецФункции

Процедура ПривестиДанныеДляЭДКОжидаемойСтруктуреУПД_5_03(СсылкаНаОбъект, ДанныеДляЭД, ДанныеДокумента, ДопДанныеДокумента)
	
	ТипДокумента = ТипЗнч(СсылкаНаОбъект);
	
	Если ТипДокумента = Тип("ДокументСсылка.АктОбОказанииУслуг") Тогда
		ПривестиДанныеДляЭДКОжидаемойСтруктуре_АктОбОказанииУслуг_УПД_5_03(СсылкаНаОбъект, ДанныеДляЭД, ДанныеДокумента, ДопДанныеДокумента);
	
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.НакладнаяНаОтпускМ15") Тогда
		ПривестиДанныеДляЭДКОжидаемойСтруктуре_НакладнаяНаОтпускМ15_УПД_5_03(СсылкаНаОбъект, ДанныеДляЭД, ДанныеДокумента, ДопДанныеДокумента);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12") Тогда
		ПривестиДанныеДляЭДКОжидаемойСтруктуре_НакладнаяНаРеализациюТорг12_УПД_5_03(СсылкаНаОбъект, ДанныеДляЭД, ДанныеДокумента, ДопДанныеДокумента);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ПередачаОбъектовИК") Тогда
		ПривестиДанныеДляЭДКОжидаемойСтруктуре_ПередачаОбъектовИК_УПД_5_03(СсылкаНаОбъект, ДанныеДляЭД, ДанныеДокумента, ДопДанныеДокумента);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ПередачаОбъектовОС") Тогда
		ПривестиДанныеДляЭДКОжидаемойСтруктуре_ПередачаОбъектовОС_УПД_5_03(СсылкаНаОбъект, ДанныеДляЭД, ДанныеДокумента, ДопДанныеДокумента);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ЭлектронныйПередаточныйДокументУслугиРаботы") Тогда
		ПривестиДанныеДляЭДКОжидаемойСтруктуре_ЭлектронныйПередаточныйДокументУслугиРаботы_УПД_5_03(СсылкаНаОбъект, ДанныеДляЭД, ДанныеДокумента, ДопДанныеДокумента);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ОтчетКомитенту") Тогда
		ПривестиДанныеДляЭДКОжидаемойСтруктуре_ОтчетКомитенту_УПД_5_03(СсылкаНаОбъект, ДанныеДляЭД, ДанныеДокумента, ДопДанныеДокумента);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		ПривестиДанныеДляЭДКОжидаемойСтруктуре_СчетФактураВыданный_УПД_5_03(СсылкаНаОбъект, ДанныеДляЭД, ДанныеДокумента, ДопДанныеДокумента);
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный") Тогда
		ПривестиДанныеДляЭДКОжидаемойСтруктуре_ИсправительныйСчетФактураВыданный_УПД_5_03(СсылкаНаОбъект, ДанныеДляЭД, ДанныеДокумента, ДопДанныеДокумента);
		
	Иначе
		ВызватьИсключение СтрШаблон(
			НСтр("ru='Передан документ неожидаемого типа ""%1"" в процедуру формирования Информации продавца формата 5.03'"),
			ТипДокумента);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПривестиДанныеДляЭДКОжидаемойСтруктуре_АктОбОказанииУслуг_УПД_5_03(СсылкаНаОбъект, ДанныеДляЭД, ДанныеДокумента, ДопДанныеДокумента)
	
	ДанныеДокумента.Шапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ДанныеДляЭД.Шапка[0]);
	ДанныеДокумента.ТабЧастьНФА = ДанныеДляЭД.ТабЧасть;
	
	ДопДанныеДокумента.СтороныСделки = УчетНДС.ОпределитьПоСсылкеПродавцаПокупателяГрузоотправителяГрузополучателя(СсылкаНаОбъект);
	
КонецПроцедуры

Процедура ПривестиДанныеДляЭДКОжидаемойСтруктуре_НакладнаяНаОтпускМ15_УПД_5_03(СсылкаНаОбъект, ДанныеДляЭД, ДанныеДокумента, ДопДанныеДокумента)
	
	ДанныеДокумента.Шапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ДанныеДляЭД[0].Выгрузить()[0]);
	ДанныеДокумента.ТабЧастьНФА = ДанныеДляЭД[1].Выгрузить();
	ДанныеДокумента.ТабЧастьМаркировкаТоваров = ДанныеДляЭД[2].Выгрузить();
	
	ЗаменитьПустуюСтавкуНаБезНДСУПД_5_03(ДанныеДокумента);
	
	ТаблицаСведенияПрослеживаемости = ДанныеДляЭД[3].Выгрузить();
	
	ДобавитьПоказателиПрослеживаемостиВТабЧастьНФАУПД_5_03(ДанныеДокумента, ТаблицаСведенияПрослеживаемости);
	
	ДопДанныеДокумента.СтороныСделки = УчетНДС.ОпределитьПоСсылкеПродавцаПокупателяГрузоотправителяГрузополучателя(СсылкаНаОбъект);
	
КонецПроцедуры

Процедура ПривестиДанныеДляЭДКОжидаемойСтруктуре_НакладнаяНаРеализациюТорг12_УПД_5_03(СсылкаНаОбъект, ДанныеДляЭД, ДанныеДокумента, ДопДанныеДокумента)
	
	ДанныеДокумента.Шапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ДанныеДляЭД[0].Выгрузить()[0]);
	ДанныеДокумента.ТабЧастьНФА = ДанныеДляЭД[1].Выгрузить();
	ДанныеДокумента.ТабЧастьМаркировкаТоваров = ДанныеДляЭД[2].Выгрузить();
	
	ТаблицаСведенияПрослеживаемости = ДанныеДляЭД[3].Выгрузить();
	
	ДобавитьПоказателиПрослеживаемостиВТабЧастьНФАУПД_5_03(ДанныеДокумента, ТаблицаСведенияПрослеживаемости);
	
	ДопДанныеДокумента.СтороныСделки = УчетНДС.ОпределитьПоСсылкеПродавцаПокупателяГрузоотправителяГрузополучателя(СсылкаНаОбъект);
	
КонецПроцедуры

Процедура ПривестиДанныеДляЭДКОжидаемойСтруктуре_ПередачаОбъектовИК_УПД_5_03(СсылкаНаОбъект, ДанныеДляЭД, ДанныеДокумента, ДопДанныеДокумента)
	
	ДанныеДокумента.Шапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ДанныеДляЭД[0].Выгрузить()[0]);
	ДанныеДокумента.ТабЧастьНФА = ДанныеДляЭД[1].Выгрузить();
	ДанныеДокумента.ТабЧастьМаркировкаТоваров = ДанныеДляЭД[2].Выгрузить();
	
	ТаблицаСведенияПрослеживаемости = ДанныеДляЭД[3].Выгрузить();
	
	ДобавитьПоказателиПрослеживаемостиВТабЧастьНФАУПД_5_03(ДанныеДокумента, ТаблицаСведенияПрослеживаемости);
	
	ДопДанныеДокумента.СтороныСделки = УчетНДС.ОпределитьПоСсылкеПродавцаПокупателяГрузоотправителяГрузополучателя(СсылкаНаОбъект);
	
КонецПроцедуры

Процедура ПривестиДанныеДляЭДКОжидаемойСтруктуре_ПередачаОбъектовОС_УПД_5_03(СсылкаНаОбъект, ДанныеДляЭД, ДанныеДокумента, ДопДанныеДокумента)
	
	ДанныеДокумента.Шапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ДанныеДляЭД[0].Выгрузить()[0]);
	ДанныеДокумента.ТабЧастьНФА = ДанныеДляЭД[1].Выгрузить();
	ДанныеДокумента.ТабЧастьМаркировкаТоваров = ДанныеДляЭД[2].Выгрузить();
	
	ТаблицаСведенияПрослеживаемости = ДанныеДляЭД[3].Выгрузить();
	
	ДобавитьПоказателиПрослеживаемостиВТабЧастьНФАУПД_5_03(ДанныеДокумента, ТаблицаСведенияПрослеживаемости);
	
	ДопДанныеДокумента.СтороныСделки = УчетНДС.ОпределитьПоСсылкеПродавцаПокупателяГрузоотправителяГрузополучателя(СсылкаНаОбъект);
	
КонецПроцедуры

Процедура ПривестиДанныеДляЭДКОжидаемойСтруктуре_ЭлектронныйПередаточныйДокументУслугиРаботы_УПД_5_03(СсылкаНаОбъект, ДанныеДляЭД, ДанныеДокумента, ДопДанныеДокумента)
	
	ДанныеДокумента.Шапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ДанныеДляЭД.Шапка[0]);
	ДанныеДокумента.ТабЧастьНФА = ДанныеДляЭД.ТабЧасть;
	
	ОчиститьЦенуОтНДС_УПД_5_03(ДанныеДокумента.ТабЧастьНФА);
	
	ДопДанныеДокумента.СтороныСделки = УчетНДС.ОпределитьПоСсылкеПродавцаПокупателяГрузоотправителяГрузополучателя(СсылкаНаОбъект);
	
КонецПроцедуры

Процедура ПривестиДанныеДляЭДКОжидаемойСтруктуре_СчетФактураВыданный_УПД_5_03(СсылкаНаОбъект, ДанныеДляЭД, ДанныеДокумента, ДопДанныеДокумента)
	
	ЗаполнитьЗначенияСвойств(ДанныеДокумента, ДанныеДляЭД);
	
	ДанныеДокумента.Шапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ДанныеДляЭД.Шапка[0]);
	
	ДопДанныеДокумента.СтороныСделки					= ДанныеДляЭД.СтороныСделки;
	ДопДанныеДокумента.НомерСФДляВыводаВРегистрыУчета	= ДанныеДляЭД.НомерДокумента;
	ДопДанныеДокумента.ДокументыОбОтгрузке				= ДанныеДляЭД.ДокументыОбОтгрузке;
	
КонецПроцедуры

Процедура ПривестиДанныеДляЭДКОжидаемойСтруктуре_ИсправительныйСчетФактураВыданный_УПД_5_03(СсылкаНаОбъект, ДанныеДляЭД, ДанныеДокумента, ДопДанныеДокумента)
	
	ЗаполнитьЗначенияСвойств(ДанныеДокумента, ДанныеДляЭД);
	
	ДанныеДокумента.Шапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ДанныеДляЭД.Шапка[0]);
	
	ДопДанныеДокумента.СтороныСделки					= ДанныеДляЭД.СтороныСделки;
	ДопДанныеДокумента.НомерСФДляВыводаВРегистрыУчета	= ДанныеДляЭД.НомерДокумента;
	ДопДанныеДокумента.ДокументыОбОтгрузке				= ДанныеДляЭД.ДокументыОбОтгрузке;
	
КонецПроцедуры

Функция ПолучитьОбщиеПараметрыЗаполненияИнформацииПродавцаУПД_5_03(СсылкаНаОбъект, СтруктураЭД, ДеревоЭД, СведенияДляУПДСтатус1)
	
	ДанныеДокумента = НовыйСтруктураДанныеДокументаУПД_5_03();
	
	ДопДанныеДокумента = НовыйСтруктураДопДанныеДокументаУПД_5_03();
	
	ПодготовитьДанныеДокументаУПД_5_03(СсылкаНаОбъект, СтруктураЭД, ДанныеДокумента, ДопДанныеДокумента);
	
	ПодготовитьДопДанныеДокументаУПД_5_03(СсылкаНаОбъект, СтруктураЭД, ДанныеДокумента, ДопДанныеДокумента, СведенияДляУПДСтатус1);
	
	ОбщиеПараметры = Новый Структура("
		|СсылкаНаОбъект,
		|СтруктураЭД,
		|ДеревоЭД,
		|ДанныеДокумента,
		|ДопДанныеДокумента,
		|ДополнительныеПараметры");
	
	ОбщиеПараметры.СсылкаНаОбъект		= СсылкаНаОбъект;
	ОбщиеПараметры.СтруктураЭД			= СтруктураЭД;
	ОбщиеПараметры.ДеревоЭД				= ДеревоЭД;
	ОбщиеПараметры.ДанныеДокумента		= ДанныеДокумента;
	ОбщиеПараметры.ДопДанныеДокумента	= ДопДанныеДокумента;
	
	ОбщиеПараметры.ДополнительныеПараметры = Новый Структура("
		// Заполнение СведенияОСчетеФактуре
		|ПутьЭлементаУчастника,
		|ДанныеЛица,
		|ДанныеЛицаПродавца,
		// Заполнение СведенияОбОтгруженныхПозициях
		|НеобходимоЗаполнениеДанныхЭДОПродавцаДляГосНужд,
		|ТаблицаТоваров,
		|ТолькоУслуги,
		|ВестиУчетПрослеживаемыхТоваров,
		|СтранаРоссия,
		|ЭтоСФАвансовый,
		|ЭтоСФШкурыЛом,
		|ЭтоСФНалоговыйАгентПункты2и3,
		|ПоискМаркировки,
		|ЭтоПризнакУслуги,
		|НомерСтроки,
		|ЕдИзмШт,
		// Настройки формирования ЭД
		|ЭтоФункцияСЧФ,
		|ЭтоФункцияДОП,
		|ЭтоФункцияСЧФДОП,
		|ЭтоФункцияСвРК,
		|ЭтоФункцияСвЗК,
		|ЭтоУПД,
		|ОписанияРеквизитовДокументов");
	
	ОбщиеПараметры.ДополнительныеПараметры.НеобходимоЗаполнениеДанныхЭДОПродавцаДляГосНужд = ВидимостьДанныхЭДОПродавцаДляГосНужд(
		ОбщиеПараметры.ДанныеДокумента.Шапка.Контрагент,
		ОбщиеПараметры.ДанныеДокумента.Шапка.Организация);
	
	ОбщиеПараметры.ДополнительныеПараметры.ВестиУчетПрослеживаемыхТоваров = ПолучитьФункциональнуюОпцию("ВестиУчетПрослеживаемыхТоваров");
	
	ОбщиеПараметры.ДополнительныеПараметры.СтранаРоссия = Справочники.СтраныМира.Россия;
	
	ОбщиеПараметры.ДополнительныеПараметры.ЕдИзмШт = Справочники.КлассификаторЕдиницИзмерения.ПолучитьЕдиницуИзмеренияПоУмолчанию();
	
	ЗаполнитьПризнакиСФУПД_5_03(ОбщиеПараметры);
	
	ОбщиеПараметры.ДополнительныеПараметры.ПоискМаркировки = Новый Структура("ИдентификаторСтроки");
	
	ОбщиеПараметры.ДополнительныеПараметры.ЭтоФункцияСЧФ = (СтруктураЭД.Функция = "СЧФ");
	ОбщиеПараметры.ДополнительныеПараметры.ЭтоФункцияДОП = (СтруктураЭД.Функция = "ДОП");
	ОбщиеПараметры.ДополнительныеПараметры.ЭтоФункцияСЧФДОП = (СтруктураЭД.Функция = "СЧФДОП");
	ОбщиеПараметры.ДополнительныеПараметры.ЭтоФункцияСвРК = (СтруктураЭД.Функция = "СвРК");
	ОбщиеПараметры.ДополнительныеПараметры.ЭтоФункцияСвЗК = (СтруктураЭД.Функция = "СвЗК");
	ОбщиеПараметры.ДополнительныеПараметры.ЭтоУПД = (СтруктураЭД.Функция = "СЧФДОП" Или СтруктураЭД.Функция = "ДОП");
	
	ОбщиеПараметры.ДополнительныеПараметры.ОписанияРеквизитовДокументов = ПолучитьОписанияРеквизитовДокументовУПД_5_03(ОбщиеПараметры);
	
	ОбщиеПараметры.ДополнительныеПараметры.ТолькоУслуги = ТолькоУслугиПоТаблицеНФАУПД_5_03(
		ОбщиеПараметры.ДанныеДокумента.ТабЧастьНФА,
		ОбщиеПараметры.ДополнительныеПараметры.ОписанияРеквизитовДокументов);
	
	Возврат ОбщиеПараметры;
	
КонецФункции

Процедура ЗаполнитьПризнакиСФУПД_5_03(ОбщиеПараметры)
	
	ЭтоСФАвансовый = Ложь;
	ЭтоСФШкурыЛом = Ложь;
	ЭтоСФНалоговыйАгентПункты2и3 = Ложь;
	
	Если ТипЗнч(ОбщиеПараметры.СсылкаНаОбъект) = Тип("ДокументСсылка.СчетФактураВыданный")
		Или ТипЗнч(ОбщиеПараметры.СсылкаНаОбъект) = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный") Тогда
		
		ПричинаНалогообложения = ОбщиеПараметры.ДанныеДокумента.Шапка.ПричинаНалогообложения;
		
		ЭтоСФАвансовый = УчетНДСПовтИсп.Аванс(ПричинаНалогообложения);
		ЭтоСФШкурыЛом = УчетНДСПовтИсп.ШкурыЛом(ПричинаНалогообложения);
		ЭтоСФНалоговыйАгентПункты2и3 = ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.ПокупкаУНерезидентаНалоговыйАгент
			Или ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.ПокупкаНалоговыйАгент;
	КонецЕсли;
	
	ОбщиеПараметры.ДополнительныеПараметры.ЭтоСФАвансовый = ЭтоСФАвансовый;
	ОбщиеПараметры.ДополнительныеПараметры.ЭтоСФШкурыЛом = ЭтоСФШкурыЛом;
	ОбщиеПараметры.ДополнительныеПараметры.ЭтоСФНалоговыйАгентПункты2и3 = ЭтоСФНалоговыйАгентПункты2и3;
	
КонецПроцедуры

Функция ОпределитьСведенияДляУПДСтатус1УПД_5_03(СсылкаНаОбъект)
	
	Перем ПервичныйДокументПередачиСсылка;
	
	СведенияДляУПДСтатус1 = Новый Структура("
		|ДокументСчетаФактуры,
		|ПервичныйДокументПередачи");
	
	ДокументСчетаФактуры = Новый Структура("
		|Найден,
		|Ссылка,
		|ЭтоСФАвансовый");
	
	ДокументСчетаФактуры.Найден = Ложь;
	ДокументСчетаФактуры.ЭтоСФАвансовый = Ложь;
	
	ПервичныйДокументПередачи = Новый Структура("
		|Найден,
		|Ссылка,
		|ЕстьРеквизитыДокументаДляЗаполненияОтветственногоЗаПередачу");
	
	ПервичныйДокументПередачи.Найден = Ложь;
	ПервичныйДокументПередачи.ЕстьРеквизитыДокументаДляЗаполненияОтветственногоЗаПередачу = Ложь;
	
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СчетФактураВыданный")
		Или ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный") Тогда
		ДокументСчетаФактуры.Найден = Истина;
		ДокументСчетаФактуры.Ссылка = СсылкаНаОбъект;
		
		// Ищем первичный документ передачи.
		ПервичныйДокументПередачиСсылка = ПолучитьПервичныйДокументПередачиДляСчетаФактуры(СсылкаНаОбъект);
	Иначе
		ПервичныйДокументПередачиСсылка = СсылкаНаОбъект;
		
		// Ищем документ счета-фактуры.
		СчетФактура = НайтиПодчиненныйСчетФактуруВыданный(СсылкаНаОбъект);
		
		Если Не ЗначениеЗаполнено(СчетФактура) Тогда
			СчетФактура = НайтиПодчиненныйИсправительныйСчетФактуруВыданный(СсылкаНаОбъект);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СчетФактура) Тогда
			ДокументСчетаФактуры.Найден = Истина;
			ДокументСчетаФактуры.Ссылка = СчетФактура;
		КонецЕсли;
	КонецЕсли;
	
	Если ДокументСчетаФактуры.Найден Тогда
		ПричинаНалогообложения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСчетаФактуры.Ссылка, "ПричинаНалогообложения");
		
		ДокументСчетаФактуры.ЭтоСФАвансовый = УчетНДСПовтИсп.Аванс(ПричинаНалогообложения);
	КонецЕсли;
	
	СведенияДляУПДСтатус1.ДокументСчетаФактуры = ДокументСчетаФактуры;
	СведенияДляУПДСтатус1.ПервичныйДокументПередачи = ПолучитьОписаниеПервичногоДокументаПередачиУПД_5_03(ПервичныйДокументПередачиСсылка);
	
	Возврат СведенияДляУПДСтатус1;
	
КонецФункции

Функция ТолькоУслугиПоТаблицеНФАУПД_5_03(ТабЧастьНФА, ОписанияРеквизитовДокументов)
	
	ОписаниеРеквизитовДокумента = ОписанияРеквизитовДокументов.СсылкаНаОбъект;
	
	Для Каждого СтрокаТаблицы Из ТабЧастьНФА Цикл
		Номенклатура = СтрокаТаблицы[ОписаниеРеквизитовДокумента.ИменаКолонокТабЧастиНФА.НФА];
		
		Признак = ПризнакТовараЕдиногоДокумента(Номенклатура);
		
		Если Не ПризнакУслуги(Признак) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция ПолучитьОписаниеПервичногоДокументаПередачиУПД_5_03(ДокументСсылка)
	
	ПервичныйДокументПередачи = Новый Структура("
		|Найден,
		|Ссылка,
		|ЕстьРеквизитыДокументаДляЗаполненияОтветственногоЗаПередачу");
	
	ПервичныйДокументПередачи.ЕстьРеквизитыДокументаДляЗаполненияОтветственногоЗаПередачу = Ложь;
	
	Найден = ЗначениеЗаполнено(ДокументСсылка);
	
	ПервичныйДокументПередачи.Найден = Найден;
	ПервичныйДокументПередачи.Ссылка = ДокументСсылка;
	
	Если Найден Тогда
		ПервичныйДокументПередачи.ЕстьРеквизитыДокументаДляЗаполненияОтветственногоЗаПередачу =
			ЕстьРеквизитыДокументаДляЗаполненияОтветственногоЗаПередачу(ДокументСсылка);
	КонецЕсли;
	
	Возврат ПервичныйДокументПередачи;
	
КонецФункции

Функция ОпределитьОписаниеФактаПередачиУПД_5_03(ДанныеДокумента, СсылкаНаОбъект, СведенияДляУПДСтатус1);
	
	ПервичныйДокументПередачи = СведенияДляУПДСтатус1.ПервичныйДокументПередачи;
	
	ОписаниеФактаПередачи = Новый Структура("
		|ПервичныйДокументПередачи,
		|ПередачаСостоялась,
		|РеквизитыПередачи");
	
	ОписаниеФактаПередачи.ПервичныйДокументПередачи = ПервичныйДокументПередачи;
	
	ИменаРеквизитовПередачи = "ОтветственныйПередалТРУВид, ОтветственныйПередалТРУДолжность, 
		|ОтветственныйПередалТРУИныеСведения, ОтветственныйПередалТРУ, ОтветственныйПередалТРУДоверенность, ОтветственныйПередалТРУОснованиеПолномочий,
		|ОтветственныйПередалТРУКонтрагент, ОтветственныйПередалТРУДокументПолномочий, ДатаПередачиТРУ, ТРУПереданы";
	
	ОписаниеФактаПередачи.ПередачаСостоялась = Ложь;
	ОписаниеФактаПередачи.РеквизитыПередачи = Новый Структура(ИменаРеквизитовПередачи);
	
	Если Не ПервичныйДокументПередачи.ЕстьРеквизитыДокументаДляЗаполненияОтветственногоЗаПередачу Тогда
		Возврат ОписаниеФактаПередачи;
	КонецЕсли;
	
	Если СсылкаНаОбъект = ПервичныйДокументПередачи.Ссылка Тогда
		РеквизитыПередачи = ДанныеДокумента.Шапка;
	Иначе
		РеквизитыПередачи = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПервичныйДокументПередачи.Ссылка, ИменаРеквизитовПередачи);
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ОписаниеФактаПередачи.РеквизитыПередачи, РеквизитыПередачи);
	
	ОписаниеФактаПередачи.ПередачаСостоялась = РеквизитыПередачи.ТРУПереданы И ЗначениеЗаполнено(РеквизитыПередачи.ДатаПередачиТРУ);
	
	Возврат ОписаниеФактаПередачи;
	
КонецФункции

Процедура ДобавитьПоказателиПрослеживаемостиВТабЧастьНФАУПД_5_03(ДанныеДокумента, ТаблицаСведенияПрослеживаемости)
	
	// Применяется только для первичных документов передачи.
	// Для счетов-фактур показатели прослеживаемости уже заполнены в данных документа.
	
	ДанныеДокумента.ТабЧастьНФА.Колонки.Добавить("СведенияОПрослеживаемости", Новый ОписаниеТипов("ТаблицаЗначений"));
	
	КэшСведенийПрослеживаемости = ПолучитьКэшСведенийПрослеживаемостиУПД_5_03(ДанныеДокумента, ТаблицаСведенияПрослеживаемости);
	
	ПоискНоменклатуры = Новый Структура("Номенклатура");
	ПоискИдентификатораСтроки = Новый Структура("ИдентификаторСтроки");
	
	ПустаяЕдИзмПрослеж = Новый Структура("ЕдиницаИзмеренияПрослежКод,ЕдиницаИзмеренияПрослежНаименование");
	
	Для Каждого СтрокаТаблицыНФА Из ДанныеДокумента.ТабЧастьНФА Цикл
		СтрокаТаблицыНФА.СведенияОПрослеживаемости = УчетНДС.ПолучитьПустуюТаблицуСведенияОПрослеживаемостиУПД();
		
		ЗаполнитьЗначенияСвойств(ПоискНоменклатуры, СтрокаТаблицыНФА);
		
		МассивСтрок = КэшСведенийПрослеживаемости.ЕдиницыИзмеренияПрослеж.НайтиСтроки(ПоискНоменклатуры);
		
		Если МассивСтрок.Количество() > 0 Тогда
			СвойстваЕдиницыИзмеренияПрослеж = МассивСтрок[0];
		Иначе
			СвойстваЕдиницыИзмеренияПрослеж = ПустаяЕдИзмПрослеж;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ПоискИдентификатораСтроки, СтрокаТаблицыНФА);
		
		МассивСтрокПрослеживаемости = ТаблицаСведенияПрослеживаемости.НайтиСтроки(ПоискИдентификатораСтроки);
		
		Для Каждого СтрокаТаблицыПрослеживаемости Из МассивСтрокПрослеживаемости Цикл
			КодРНПТ = КэшСведенийПрослеживаемости.КодыРНПТ.Получить(СтрокаТаблицыПрослеживаемости.РНПТ);
			
			Если Не ЗначениеЗаполнено(КодРНПТ) Тогда
				Продолжить;
			КонецЕсли;
			
			ЦенаПрослеж = ?(СтрокаТаблицыНФА.Количество <> 0,
				СтрокаТаблицыНФА.СуммаБезНДС / СтрокаТаблицыНФА.Количество,
				СтрокаТаблицыНФА.Цена);
			
			НоваяСтрока = СтрокаТаблицыНФА.СведенияОПрослеживаемости.Добавить();
			
			НоваяСтрока["НомерСтроки"]					= СтрокаТаблицыНФА.СведенияОПрослеживаемости.Количество();
			НоваяСтрока["НомерТовара"]					= СокрЛП(КодРНПТ);
			НоваяСтрока["ЕдиницаИзмеренияКод"]			= СвойстваЕдиницыИзмеренияПрослеж.ЕдиницаИзмеренияПрослежКод;
			НоваяСтрока["ЕдиницаИзмеренияНаименование"]	= СвойстваЕдиницыИзмеренияПрослеж.ЕдиницаИзмеренияПрослежНаименование;
			НоваяСтрока["КоличествоУчетное"]			= СтрокаТаблицыПрослеживаемости.Количество;
			НоваяСтрока["Количество"]					= СтрокаТаблицыПрослеживаемости.КоличествоПрослеживаемости;
			НоваяСтрока["СтоимостьБезНДС"]				= Окр(ЦенаПрослеж * СтрокаТаблицыПрослеживаемости.КоличествоПрослеживаемости, 2);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьКэшСведенийПрослеживаемостиУПД_5_03(ДанныеДокумента, ТаблицаСведенияПрослеживаемости)
	
	ВремТаблица = ТаблицаСведенияПрослеживаемости.Скопировать(, "РНПТ");
	ВремТаблица.Свернуть("РНПТ");
	МассивРНПТ = ВремТаблица.ВыгрузитьКолонку("РНПТ");
	
	КодыРНПТ = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(МассивРНПТ, "Код");
	
	ВремТаблица = ДанныеДокумента.ТабЧастьНФА.Скопировать(, "Номенклатура");
	ВремТаблица.Свернуть("Номенклатура");
	МассивНоменклатуры = ВремТаблица.ВыгрузитьКолонку("Номенклатура");
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатуры);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ
	|	КодыТНВЭДНоменклатуры.Ссылка				КАК Номенклатура,
	|	КлассификаторЕдиницИзмерения.Ссылка			КАК ЕдиницаИзмеренияПрослеж,
	|	КлассификаторЕдиницИзмерения.Код			КАК ЕдиницаИзмеренияПрослежКод,
	|	КлассификаторЕдиницИзмерения.Наименование	КАК ЕдиницаИзмеренияПрослежНаименование
	|ИЗ
	|	(ВЫБРАТЬ
	|		Ссылка КАК Ссылка,
	|		КодТНВЭД КАК КодТНВЭД
	|	ИЗ
	|		Справочник.Номенклатура КАК Номенклатура
	|	ГДЕ
	|		Ссылка В (&МассивНоменклатуры)	
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		Ссылка,
	|		КодТНВЭД
	|	ИЗ
	|		Справочник.ОсновныеСредства
	|	ГДЕ
	|		Ссылка В (&МассивНоменклатуры)) КАК КодыТНВЭДНоменклатуры
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КлассификаторТНВЭД КАК КлассификаторТНВЭД
	|		ПО КодыТНВЭДНоменклатуры.КодТНВЭД = КлассификаторТНВЭД.Ссылка
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КлассификаторЕдиницИзмерения КАК КлассификаторЕдиницИзмерения
	|		ПО КлассификаторТНВЭД.ЕдиницаИзмерения = КлассификаторЕдиницИзмерения.Ссылка";
	
	УстановитьПривилегированныйРежим(Истина);
	ТаблицаЕдиницыИзмеренияПрослеж = ЗапросПоиск.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	КэшСведенийПрослеживаемости = Новый Структура("
		|КодыРНПТ,
		|ЕдиницыИзмеренияПрослеж");
	
	КэшСведенийПрослеживаемости.КодыРНПТ = КодыРНПТ;
	КэшСведенийПрослеживаемости.ЕдиницыИзмеренияПрослеж = ТаблицаЕдиницыИзмеренияПрослеж;
	
	Возврат КэшСведенийПрослеживаемости;
	
КонецФункции

Процедура НастроитьФормированиеУниверсальногоДокумента(СтрокаПараметров, Источник, ЭтоСсылка, ЗначенияРеквизитов)
	
	ВариантыФормирования = ОбменСКонтрагентами.ВариантыФормированияУниверсальныхДокументов();
	
	Если ЭтоАвансовыйСчетФактура(Источник, ЭтоСсылка)
		Или ЭтоСчетФактураКомитентаПеревыставленный(Источник, ЭтоСсылка) Тогда
		
		СтрокаПараметров.ФормированиеУниверсальногоДокумента = ВариантыФормирования.Запрещено;
		
	ИначеЕсли Не НастройкиЭДО.ЕстьНастройкиОтправки(ЗначенияРеквизитов.Организация, ЗначенияРеквизитов.Контрагент)
		И УПДФормироватьСтатус1ПриОтсутствииНастройкиЭДО(ЗначенияРеквизитов.Организация) Тогда
		
		СтрокаПараметров.ФормированиеУниверсальногоДокумента = ВариантыФормирования.Обязательно;
	КонецЕсли;
	
КонецПроцедуры

Функция ЭтоСчетФактураКомитентаПеревыставленный(Источник, ЭтоСсылка)
	
	Ссылка = ?(ЭтоСсылка, Источник, Источник.Ссылка);
	
	Если ТипЗнч(Ссылка) <> Тип("ДокументСсылка.СчетФактураВыданный")
		И ТипЗнч(Ссылка) <> Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Реквизиты = "ПричинаНалогообложения";
	
	Если ЭтоСсылка Тогда
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, Реквизиты);
	Иначе
		ЗначенияРеквизитов = Новый Структура(Реквизиты);
		ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, Источник);
	КонецЕсли;
	
	ПричинаНалогообложения = ЗначенияРеквизитов.ПричинаНалогообложения;
	
	Возврат ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.СчетФактураКомитентаНаАванс
		Или ПричинаНалогообложения = Перечисления.ПричиныНалогообложенияНДС.СчетФактураКомитентаНаРеализацию;
	
КонецФункции

Функция ЭтоАвансовыйСчетФактура(Источник, ЭтоСсылка)
	
	Ссылка = ?(ЭтоСсылка, Источник, Источник.Ссылка);
	
	Если ТипЗнч(Ссылка) <> Тип("ДокументСсылка.СчетФактураВыданный")
		И ТипЗнч(Ссылка) <> Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Реквизиты = "ПричинаНалогообложения";
	
	Если ЭтоСсылка Тогда
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, Реквизиты);
	Иначе
		ЗначенияРеквизитов = Новый Структура(Реквизиты);
		ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, Источник);
	КонецЕсли;
	
	Возврат УчетНДСПовтИсп.Аванс(ЗначенияРеквизитов.ПричинаНалогообложения);
	
КонецФункции

Процедура ПроверитьВозможностьФормированияУПДСтатуса1_УПД2025(Знач СсылкаНаОбъект, Знач СведенияДляУПДСтатус1, Описание, Отказ)
	
	Перем ВторойДокументПары;
	
	// Для возможности формирования УПД статуса 1 необходимы два документа: реализации и счета-фактуры.
	// Формирование УПД для авансового счета-фактуры не предусмотрено законодательством.
	
	ОбщийЗаголовокСообщений = НСтр("ru='УПД не может быть сформирован.'");
	
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.СчетФактураВыданный")
		Или ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный") Тогда
		
		// Здесь счет-фактура может быть только отгрузочным, а авансовым быть не может.
		// Для авансового счета-фактуры вместо УПД будет сформирован обычный счет-фактура.
		Если Не СведенияДляУПДСтатус1.ПервичныйДокументПередачи.Найден Тогда
			Отказ = Истина;
			ТекстСообщения = СтрШаблон(НСтр("ru='%1 Для счета-фактуры %2 не указан первичный документ передачи.'"), ОбщийЗаголовокСообщений, СсылкаНаОбъект);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, СсылкаНаОбъект,, "Объект.ДокументОснование");
			Возврат;
		КонецЕсли;
		
		ВторойДокументПары = СведенияДляУПДСтатус1.ПервичныйДокументПередачи.Ссылка;
		
	Иначе
		Если Не СведенияДляУПДСтатус1.ДокументСчетаФактуры.Найден Тогда
			Отказ = Истина;
			ТекстСообщения = СтрШаблон(НСтр("ru='%1 По документу %2 счет-фактура не выписан.'"), ОбщийЗаголовокСообщений, СсылкаНаОбъект);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, СсылкаНаОбъект);
			Возврат;
		КонецЕсли;
		
		Если СведенияДляУПДСтатус1.ДокументСчетаФактуры.ЭтоСФАвансовый Тогда
			Отказ = Истина;
			ТекстСообщения = СтрШаблон(НСтр("ru='%1 Подчиненный счет-фактура %2 является авансовым, УПД не применяется.'"), ОбщийЗаголовокСообщений, СсылкаНаОбъект);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, СведенияДляУПДСтатус1.ДокументСчетаФактуры.Ссылка);
			Возврат;
		КонецЕсли;
		
		ВторойДокументПары = СведенияДляУПДСтатус1.ДокументСчетаФактуры.Ссылка;
	КонецЕсли;
	
	Описание.Основания.Добавить(ВторойДокументПары);
	
КонецПроцедуры

Процедура ЗаменитьПустуюСтавкуНаБезНДСУПД_5_03(ДанныеДокумента)
	
	СтавкаБезНДС = Перечисления.СтавкиНДС.БезНДС;
	
	Для Каждого СтрокаТаблицы Из ДанныеДокумента.ТабЧастьНФА Цикл
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.СтавкаНДС) Тогда
			СтрокаТаблицы.СтавкаНДС = СтавкаБезНДС;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ОчиститьЦенуОтНДС_УПД_5_03(ТабЧастьНФА)
	
	Для Каждого СтрокаТаблицы Из ТабЧастьНФА Цикл
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.Цена) Или Не ЗначениеЗаполнено(СтрокаТаблицы.СуммаНДС) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.Количество) Тогда
			СуммаБезНДСРасчет = Окр(СтрокаТаблицы.Количество * СтрокаТаблицы.Цена, 2);
			
			Разница = (СуммаБезНДСРасчет - СтрокаТаблицы.СуммаБезНДС);
			
			Расхождение = Макс(Разница, -Разница);
			
			Если Расхождение > 0.01 Тогда
				Если СтрокаТаблицы.Количество = 1 Тогда
					СтрокаТаблицы.Цена = СтрокаТаблицы.СуммаБезНДС;
				Иначе
					СтрокаТаблицы.Цена = Окр(СтрокаТаблицы.СуммаБезНДС / СтрокаТаблицы.Количество, 2);
				КонецЕсли;
			КонецЕсли;
			
		ИначеЕсли СтрокаТаблицы.Цена > СтрокаТаблицы.СуммаБезНДС Тогда
			СтрокаТаблицы.Цена = СтрокаТаблицы.СуммаБезНДС;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПривестиДанныеДляЭДКОжидаемойСтруктуре_ОтчетКомитенту_УПД_5_03(СсылкаНаОбъект, ДанныеДляЭД, ДанныеДокумента, ДопДанныеДокумента)
	
	ДанныеДокумента.Шапка = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ДанныеДляЭД.Шапка[0]);
	ДанныеДокумента.ТабЧастьНФА = ДанныеДляЭД.ТабЧасть;
	
	ДопДанныеДокумента.СтороныСделки = УчетНДС.ОпределитьПоСсылкеПродавцаПокупателяГрузоотправителяГрузополучателя(СсылкаНаОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область Настройки

Функция ПолучитьОписанияРеквизитовДокументовУПД_5_03(ОбщиеПараметры)
	
	ОписанияРеквизитовДокументов = Новый Структура("
		|ПервичныйДокументПередачи,
		|СчетФактура,
		|СсылкаНаОбъект");
		
	Если ОбщиеПараметры.ДопДанныеДокумента.ОписаниеФактаПередачи <> Неопределено Тогда
		ОписанияРеквизитовДокументов.ПервичныйДокументПередачи = ПолучитьОписаниеРеквизитовПервичногоДокументаПередачиУПД_5_03(ОбщиеПараметры);
	КонецЕсли;
	
	ОписанияРеквизитовДокументов.СчетФактура = ПолучитьОписаниеРеквизитовСчетаФактурыУПД_5_03(ОбщиеПараметры);
	
	Если ТипЗнч(ОбщиеПараметры.СсылкаНаОбъект) = Тип("ДокументСсылка.СчетФактураВыданный")
		Или ТипЗнч(ОбщиеПараметры.СсылкаНаОбъект) = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный") Тогда
		СсылкаНаОбъект = ОписанияРеквизитовДокументов.СчетФактура;
	Иначе
		СсылкаНаОбъект = ОписанияРеквизитовДокументов.ПервичныйДокументПередачи;
	КонецЕсли;
	
	ОписанияРеквизитовДокументов.СсылкаНаОбъект = СсылкаНаОбъект;
	
	Возврат ОписанияРеквизитовДокументов;
	
КонецФункции

Функция ПолучитьОписаниеРеквизитовПервичногоДокументаПередачиУПД_5_03(ОбщиеПараметры)
	
	ОписаниеРеквизитовДокумента = НовыйОписаниеРеквизитовДокументаУПД_5_03();
	
	ТипПервичногоДокументаПередачи = ТипЗнч(ОбщиеПараметры.ДопДанныеДокумента.ОписаниеФактаПередачи.ПервичныйДокументПередачи.Ссылка);
	
	// Имена реквизитов, отличные от значений по умолчанию.
	Если ТипПервичногоДокументаПередачи = Тип("ДокументСсылка.АктОбОказанииУслуг") Тогда
		ОписаниеРеквизитовДокумента.ПутьКТабЧастиНФА = "Объект.УслугиОказанные";
		ОписаниеРеквизитовДокумента.ИменаКолонокТабЧастиНФА.НФА = "Номенклатура";
		ОписаниеРеквизитовДокумента.ИменаКолонокТабЧастиНФА.СодержаниеУслуги = "Описание";
		
	ИначеЕсли ТипПервичногоДокументаПередачи = Тип("ДокументСсылка.НакладнаяНаОтпускМ15") Тогда
		ОписаниеРеквизитовДокумента.ПутьКТабЧастиНФА = "Объект.Материалы";
		ОписаниеРеквизитовДокумента.ИменаКолонокТабЧастиНФА.НФА = "Номенклатура";
		ОписаниеРеквизитовДокумента.ИменаКолонокТабЧастиНФА.ЕдиницаИзмеренияКод = "БазоваяЕдиницаКод";
		ОписаниеРеквизитовДокумента.ИменаКолонокТабЧастиНФА.СодержаниеУслуги = "";
		
	ИначеЕсли ТипПервичногоДокументаПередачи = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12") Тогда
		ОписаниеРеквизитовДокумента.ПутьКТабЧастиНФА = "Объект.Номенклатура";
		ОписаниеРеквизитовДокумента.ИменаКолонокТабЧастиНФА.НФА = "Номенклатура";
		ОписаниеРеквизитовДокумента.ИменаКолонокТабЧастиНФА.ЕдиницаИзмеренияКод = "БазоваяЕдиницаКод";
		ОписаниеРеквизитовДокумента.ИменаКолонокТабЧастиНФА.СодержаниеУслуги = "";
		
	ИначеЕсли ТипПервичногоДокументаПередачи = Тип("ДокументСсылка.ПередачаОбъектовИК") Тогда
		ОписаниеРеквизитовДокумента.ПутьКТабЧастиНФА = "Объект.ОсновныеСредства";
		ОписаниеРеквизитовДокумента.ИменаКолонокТабЧастиНФА.НФА = "Номенклатура";
		ОписаниеРеквизитовДокумента.ИменаКолонокТабЧастиНФА.ЕдиницаИзмеренияКод = "БазоваяЕдиницаКод";
		ОписаниеРеквизитовДокумента.ИменаКолонокТабЧастиНФА.СодержаниеУслуги = "";
		
	ИначеЕсли ТипПервичногоДокументаПередачи = Тип("ДокументСсылка.ПередачаОбъектовОС") Тогда
		ОписаниеРеквизитовДокумента.ПутьКТабЧастиНФА = "Объект.ОсновныеСредства";
		ОписаниеРеквизитовДокумента.ИменаКолонокТабЧастиНФА.НФА = "Номенклатура";
		ОписаниеРеквизитовДокумента.ИменаКолонокТабЧастиНФА.ЕдиницаИзмеренияКод = "БазоваяЕдиницаКод";
		ОписаниеРеквизитовДокумента.ИменаКолонокТабЧастиНФА.СодержаниеУслуги = "";
		
	ИначеЕсли ТипПервичногоДокументаПередачи = Тип("ДокументСсылка.ЭлектронныйПередаточныйДокументУслугиРаботы") Тогда
		ОписаниеРеквизитовДокумента.ПутьКТабЧастиНФА = "СписокНоменклатуры";
