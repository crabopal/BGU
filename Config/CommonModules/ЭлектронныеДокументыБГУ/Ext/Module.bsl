			СтрокаПередаваемыйОбъект.Вставить("СуммаАмортизации", ТекСтрока.СуммаНачисленнойАмортизации);
			СтрокаПередаваемыйОбъект.Вставить("СуммаОбесценения", ТекСтрока.СуммаНачисленногоОбесценения);
			СтрокаПередаваемыйОбъект.Вставить("GUIDНоменклатуры", ТекСтрока.GUIDНоменклатуры);
			СтрокаПередаваемыйОбъект.Вставить("НаименованиеНФА", ТекСтрока.ПолноеНаимНоменклатуры);
			СтрокаПередаваемыйОбъект.Вставить("Количество", ТекСтрока.Количество);
			СтрокаПередаваемыйОбъект.Вставить("Сведения", ТекСтрока.ИныеСведения);
			СтрокаПередаваемыйОбъект.Вставить("GUIDИнвентарногоНомера", ТекСтрока.GUIDИнвентарногоНомера);
			
			ОбластьР1Строка.Параметры.Заполнить(СтрокаПередаваемыйОбъект);
			
			ТабличныйДокумент.Вывести(ОбластьР1Строка);
			
			Количество			= Количество		+ СтрокаПередаваемыйОбъект.Количество;
			Сумма				= Сумма				+ СтрокаПередаваемыйОбъект.Сумма;
			СуммаВложений		= СуммаВложений		+ СтрокаПередаваемыйОбъект.СуммаВложений;
			СуммаАмортизации	= СуммаАмортизации	+ СтрокаПередаваемыйОбъект.СуммаАмортизации;
			СуммаОбесценения	= СуммаОбесценения	+ СтрокаПередаваемыйОбъект.СуммаОбесценения;
		КонецЦикла;
		
		ОбластьР1Подвал.Параметры.Заполнить(Новый Структура("Количество,Сумма,СуммаВложений,СуммаАмортизации,СуммаОбесценения",
			Количество, Сумма, СуммаВложений, СуммаАмортизации, СуммаОбесценения));
		ТабличныйДокумент.Вывести(ОбластьР1Подвал);
		
		// Раздел 2
		
		ТабличныйДокумент.Вывести(ОбластьР2Шапка);
		НомерПоПорядку = 1;  
		СтрокаНачало = ТабличныйДокумент.ВысотаТаблицы + 1; 
		НаимХарактеристикиНФА = "";

		Для Каждого ТекХарактеристика Из СведенияАктаПередачиНФА.ИндивидуальныеХарактеристикиОбъектовНФА Цикл
			
			СтрокаХарактеристик = Новый Структура;
			Если Число(ТекХарактеристика.КодСтроки) = 1 Тогда
				СтрокаХарактеристик.Вставить("НомерСтроки", Число(НомерПоПорядку));
			Иначе	
				СтрокаХарактеристик.Вставить("НомерСтроки", Число(ТекХарактеристика.КодСтроки));
			КонецЕсли;
			СтрокаХарактеристик.Вставить("НаименованиеНФА", ТекХарактеристика.ПолноеНаимНоменклатуры);
			СтрокаХарактеристик.Вставить("Адрес", ТекХарактеристика.АдресМестоположениеОбъекта);
			СтрокаХарактеристик.Вставить("Назначение", ТекХарактеристика.НазначениеОбъекта);
			СтрокаХарактеристик.Вставить("Драгметалл", ТекХарактеристика.ДрагоценныйМатериал);
			СтрокаХарактеристик.Вставить("Деталь", ТекХарактеристика.Деталь);
			СтрокаХарактеристик.Вставить("КодЕИ", ТекХарактеристика.ЕдИзмКод);
			СтрокаХарактеристик.Вставить("НаименованиеЕИ", ТекХарактеристика.ЕдИзмНаим);
			СтрокаХарактеристик.Вставить("Количество", ТекХарактеристика.Количество);
			СтрокаХарактеристик.Вставить("Характеристика", ТекХарактеристика.ПризнакХарактеристикаНаименование);
			СтрокаХарактеристик.Вставить("ЗначениеХарактеристики", ТекХарактеристика.ПризнакХарактеристикаЗначение);
			
			Если НЕ ЗначениеЗаполнено(СтрокаХарактеристик.НаименованиеНФА) Тогда
				СтрокаХарактеристик.НомерСтроки = "";
			КонецЕсли;
			
			Если СтрокаХарактеристик.НаименованиеНФА = НаимХарактеристикиНФА Тогда
				СтрокаХарактеристик.НомерСтроки = "";
				СтрокаХарактеристик.НаименованиеНФА = "";
			Иначе
				НаимХарактеристикиНФА = СтрокаХарактеристик.НаименованиеНФА;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ТекХарактеристика.ДрагоценныйМатериал) Тогда
				СтрокаХарактеристик.Количество = "";
			КонецЕсли;	
			
			Если ЗначениеЗаполнено(СтрокаХарактеристик.НаименованиеНФА) Тогда 
				СтрокаКонец = ТабличныйДокумент.ВысотаТаблицы;

				Если СтрокаНачало < СтрокаКонец Тогда
					ТабличныйДокумент.Область(СтрокаНачало, 1, СтрокаКонец, 1).Объединить();
					ТабличныйДокумент.Область(СтрокаНачало, 2, СтрокаКонец, 4).Объединить();
					ТабличныйДокумент.Область(СтрокаНачало, 5, СтрокаКонец, 6).Объединить();
					ТабличныйДокумент.Область(СтрокаНачало, 7, СтрокаКонец, 9).Объединить();
				КонецЕсли;	

				СтрокаНачало = СтрокаКонец + 1;
			КонецЕсли;
			
			НомерПоПорядку = НомерПоПорядку + 1;
			
			ОбластьР2Строка.Параметры.Заполнить(СтрокаХарактеристик);
			
			ПараметрыСтроки = Новый Структура;
			Если ЗначениеЗаполнено(СтрокаХарактеристик.НомерСтроки) И Число(СтрокаХарактеристик.НомерСтроки) < 1000 Тогда
				ПараметрыСтроки.Вставить("НомерСтроки", Формат(СтрокаХарактеристик.НомерСтроки, "ЧЦ=3; ЧВН="));
			Иначе
				ПараметрыСтроки.Вставить("НомерСтроки", Формат(СтрокаХарактеристик.НомерСтроки, "ЧГ=0"));
			КонецЕсли;
			ОбластьР2Строка.Параметры.Заполнить(ПараметрыСтроки);
			ТабличныйДокумент.Вывести(ОбластьР2Строка);
		КонецЦикла;
		
		СтрокаКонец = ТабличныйДокумент.ВысотаТаблицы;
		Если СтрокаНачало < СтрокаКонец Тогда
			ТабличныйДокумент.Область(СтрокаНачало, 1, СтрокаКонец, 1).Объединить();
			ТабличныйДокумент.Область(СтрокаНачало, 2, СтрокаКонец, 4).Объединить();
			ТабличныйДокумент.Область(СтрокаНачало, 5, СтрокаКонец, 6).Объединить();
			ТабличныйДокумент.Область(СтрокаНачало, 7, СтрокаКонец, 9).Объединить();
		КонецЕсли;  
		
		// Раздел 3
		
		ТабличныйДокумент.Вывести(ОбластьР3Шапка);
		НомерПоПорядку = 1;
		Для Каждого ТекОграничение Из СведенияАктаПередачиНФА.СведенияОбОграниченияхОбременениях Цикл
			
			СтрокаОграничения = Новый Структура;
			Если Число(ТекОграничение.КодСтроки) = 1 Тогда
				СтрокаОграничения.Вставить("НомерСтроки", Число(НомерПоПорядку));
			Иначе	
				СтрокаОграничения.Вставить("НомерСтроки", Число(ТекОграничение.КодСтроки));
			КонецЕсли;
			СтрокаОграничения.Вставить("НаименованиеНФА", ТекОграничение.ПолноеНаимНоменклатуры);
			СтрокаОграничения.Вставить("ЕдИзмОграничения", ТекОграничение.ЕдИзмОграничения);
			СтрокаОграничения.Вставить("ЗначениеОграничения", ТекОграничение.ЗначениеОграничения);
			СтрокаОграничения.Вставить("РегистрацияНомер", ТекОграничение.НомерДокументаОснованияРегистрации);
			СтрокаОграничения.Вставить("РегистрацияДата", ТекОграничение.ДатаДокументаОснованияРегистрации);
			СтрокаОграничения.Вставить("ВидОграничения", ТекОграничение.ВидОграничения);
			СтрокаОграничения.Вставить("НачалоОграничения", ТекОграничение.ДатаНачалаОграничения);
			СтрокаОграничения.Вставить("ОкончаниеОграничения", ТекОграничение.ДатаОкончанияОграничения);
			СтрокаОграничения.Вставить("СрокОграничения", ТекОграничение.СрокОграничения);
			СтрокаОграничения.Вставить("ПлатаЗаЕдОграничения", ТекОграничение.ЦенаПлатыЗаЕдиницу);
			СтрокаОграничения.Вставить("СуммаПлатыЗаОграничение", ТекОграничение.СуммаПлатыЗаВесьСрок);
			СтрокаОграничения.Вставить("СуммаПлатыЗаОграничениеЗаМесяц", ТекОграничение.СуммаПлатыЗаМесяц);
			СтрокаОграничения.Вставить("НомерДокументаОграничения", ТекОграничение.НомерДокументаОснования);
			СтрокаОграничения.Вставить("ДатаДокументаОграничения", ТекОграничение.ДатаДокументаОснования);
			СтрокаОграничения.Вставить("ВидДокументаОграничения", ТекОграничение.ВидДокументаОснования);
			СтрокаОграничения.Вставить("НомерКартыОграничения", ТекОграничение.НомерКарты);
			
			GUIDКонтрагента = ТекОграничение.GUIDКонтрагента;
			
			СведенияСвязанногоКонтрагента = СведенияСвязанногоКонтрагентаАктаПередачиНФА(ВходящийАкт, GUIDКонтрагента);
			СтрокаОграничения.Вставить("НаименованиеКонтрагентаОграничения", СведенияСвязанногоКонтрагента.НаименованиеКонтрагента);
			Если ЗначениеЗаполнено(СведенияСвязанногоКонтрагента.ОГРН) Тогда
				СтрокаОграничения.Вставить("ОГРНКонтрагентаОграничения", СведенияСвязанногоКонтрагента.ОГРН);
			Иначе
				СтрокаОграничения.Вставить("ОГРНКонтрагентаОграничения", СведенияСвязанногоКонтрагента.ОГРНИП);
			КонецЕсли;
			СтрокаОграничения.Вставить("ИННКонтрагентаОграничения", СведенияСвязанногоКонтрагента.ИНН);
			СтрокаОграничения.Вставить("КППКонтрагентаОграничения", СведенияСвязанногоКонтрагента.КПП);
			СтрокаОграничения.Вставить("ОКОПФКонтрагентаОграничения", СведенияСвязанногоКонтрагента.КодПоОКОПФ);
			СтрокаОграничения.Вставить("КИСЭКонтрагентаОграничения", СведенияСвязанногоКонтрагента.КодПоКИСЭ);

			НомерПоПорядку = НомерПоПорядку + 1;
			
			ОбластьР3Строка.Параметры.Заполнить(СтрокаОграничения);
			ТабличныйДокумент.Вывести(ОбластьР3Строка);
		КонецЦикла;
		
		СведенияИсполнителя = Новый Структура;
		СведенияИсполнителя.Вставить("ДолжностьНаименование", СведенияАктаПередачиНФА.ИсполнительОтправителя.Должность);
		СведенияИсполнителя.Вставить("ФИО", ИнициалыФамилияПоСтруктуреФИО(СведенияАктаПередачиНФА.ИсполнительОтправителя));
		СведенияИсполнителя.Вставить("НомерТелефона", СведенияАктаПередачиНФА.ИсполнительОтправителя.Телефон);
		СведенияИсполнителя.Вставить("ЭлектроннаяПочта", СведенияАктаПередачиНФА.ИсполнительОтправителя.ЭлектронныйАдрес);
		ОбластьИсполнитель1.Параметры.Заполнить(СведенияИсполнителя);
		
		ТабличныйДокумент.Вывести(ОбластьПустаяСтрока);
		ТабличныйДокумент.Вывести(ОбластьИсполнитель1);
		ТабличныйДокумент.Вывести(ОбластьПустаяСтрока);
		
		// Раздел 4
		
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		ТабличныйДокумент.Вывести(ОбластьР4Шапка);

		ДанныеОПринятыхНФА = ВыборкаДокументов.ПринятыеОбъектыНФА;
		
		Для Каждого ТекОбъектНФА Из СведенияАктаПередачиНФА.СведенияОПринятыхОбъектахНФА Цикл
			СтрокаПринимаемыйОбъект = Новый Структура;
			СтрокаПринимаемыйОбъект.Вставить("НаименованиеНФА", ТекОбъектНФА.ПолноеНаимНоменклатуры);
			
			Количество = 0;
			АналитическаяГруппа = "";
			ВидИмущества = "";
			АмортизационнаяГруппа = "";
			МетодНачисленияАмортизации = "";
			ДатаОкончанияАмортизации = Дата(1,1,1);
			СрокПолезногоИспользования = 0;
			СуммаФактКапВложений = 0;
			БалансоваяСтоимость = 0;
			СуммаНормыАмортизации = 0;
			
			ПараметрыОтбора = Новый Структура;
			Если ЗначениеЗаполнено(ТекОбъектНФА.GUIDНоменклатуры) Тогда
				ПараметрыОтбора.Вставить("GUIDНоменклатурыУОтправителя", ТекОбъектНФА.GUIDНоменклатуры);
			КонецЕсли;
			ПараметрыОтбора.Вставить("НомерСтроки", Число(ТекОбъектНФА.КодСтроки));
			НайденныеСтроки = ДанныеОПринятыхНФА.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество()>0 Тогда
				Если НайденныеСтроки.Количество()>1 Тогда
					ДанныеЗаполнены = Ложь;
					Для Каждого ТекСтрокаДанных Из НайденныеСтроки Цикл
						Если ЗначениеЗаполнено(ТекСтрокаДанных.НФА) Тогда
							Если СокрЛП(ТекСтрокаДанных.НФА.УникальныйИдентификатор()) = СокрЛП(ТекОбъектНФА.GUIDНоменклатурыПолучателя) Тогда
								АналитическаяГруппа = ТекСтрокаДанных.АналитическаяГруппа;
								Количество = ТекСтрокаДанных.Количество;
								СуммаФактКапВложений = ТекСтрокаДанных.СуммаВложений;
								БалансоваяСтоимость = ТекСтрокаДанных.Сумма;
								ВидИмущества = ТекСтрокаДанных.ВидИмущества;
								ДанныеЗаполнены = Истина;
								Прервать;
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
					Если НЕ ДанныеЗаполнены Тогда
						АналитическаяГруппа = НайденныеСтроки[0].АналитическаяГруппа;
						Количество = НайденныеСтроки[0].Количество;
						СуммаФактКапВложений = НайденныеСтроки[0].СуммаВложений;
						БалансоваяСтоимость = НайденныеСтроки[0].Сумма;
						ВидИмущества = НайденныеСтроки[0].ВидИмущества;
					КонецЕсли;	
				Иначе	
					АналитическаяГруппа = НайденныеСтроки[0].АналитическаяГруппа;
					Количество = НайденныеСтроки[0].Количество;
					СуммаФактКапВложений = НайденныеСтроки[0].СуммаВложений;
					БалансоваяСтоимость = НайденныеСтроки[0].Сумма;
					ВидИмущества = НайденныеСтроки[0].ВидИмущества;
				КонецЕсли;
			КонецЕсли;
			СтрокаПринимаемыйОбъект.Вставить("Количество", Количество); 
			СтрокаПринимаемыйОбъект.Вставить("АналитическаяГруппа", АналитическаяГруппа); 
			СтрокаПринимаемыйОбъект.Вставить("ВидИмущества", ВидИмущества); 
			СтрокаПринимаемыйОбъект.Вставить("СуммаВложений", СуммаФактКапВложений); 
			СтрокаПринимаемыйОбъект.Вставить("Сумма", БалансоваяСтоимость);
			СтрокаПринимаемыйОбъект.Вставить("АмортизационнаяГруппа", АмортизационнаяГруппа);
			СтрокаПринимаемыйОбъект.Вставить("МетодАмортизации", МетодНачисленияАмортизации);
			СтрокаПринимаемыйОбъект.Вставить("НормаАмортизации", СуммаНормыАмортизации);

			НомерСтроки = Число(ТекОбъектНФА.КодСтроки);
			Если НомерСтроки < 1000 Тогда
				СтрокаПринимаемыйОбъект.Вставить("НомерСтроки", Формат(НомерСтроки, "ЧЦ=3; ЧВН="));
			Иначе
				СтрокаПринимаемыйОбъект.Вставить("НомерСтроки", Формат(НомерСтроки, "ЧГ=0"));
			КонецЕсли;
			
			СтрокаПринимаемыйОбъект.Вставить("ДатаОкончанияАмортизации", ДатаОкончанияАмортизации); 
			СтрокаПринимаемыйОбъект.Вставить("СрокПолезногоИспользования", СрокПолезногоИспользования); 
			
			ОбластьР4Строка.Параметры.Заполнить(СтрокаПринимаемыйОбъект);
			ТабличныйДокумент.Вывести(ОбластьР4Строка);
		КонецЦикла;
		
		// Приложения
		Сч = 0;
		ТабличныйДокумент.Вывести(ОбластьПустаяСтрока);
		Если СведенияАктаПередачиНФА.ФайлыПриложений.Количество() > 0 Тогда
			Для Каждого ТекФайл Из СведенияАктаПередачиНФА.ФайлыПриложений Цикл
				Если Сч = 0 Тогда
					ТабличныйДокумент.Вывести(ОбластьПустаяСтрока);
				КонецЕсли;
				Сч = Сч + 1;
				
				ДанныеОПриложенномФайле = Новый Структура;
				ДанныеОПриложенномФайле.Вставить("Номер", Сч);
				ДанныеОПриложенномФайле.Вставить("Описание", ?(ЗначениеЗаполнено(ТекФайл.НаименованиеДокументаФайла),
					ТекФайл.НаименованиеДокументаФайла, СокрЛП(ТекФайл.ВидСведений)));
				ДанныеОПриложенномФайле.Вставить("ИмяФайла", ТекФайл.ИмяФайла);
				
				ОбластьПриложение.Параметры.Заполнить(ДанныеОПриложенномФайле);
				ТабличныйДокумент.Вывести(ОбластьПриложение);
			КонецЦикла;
		КонецЕсли;

		// Приложения Отправителя
		Если ВыборкаДокументов.ФайлыАктаЭДО.Количество() > 0 Тогда
			Для Каждого ТекФайл Из ВыборкаДокументов.ФайлыАктаЭДО Цикл
				Если Сч = 0 Тогда
					ТабличныйДокумент.Вывести(ОбластьПустаяСтрока);
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ТекФайл.ИмяФайла) Тогда
					Сч = Сч + 1;
					
					ДанныеОПриложенномФайле = Новый Структура;
					ДанныеОПриложенномФайле.Вставить("Номер", Сч);
					ДанныеОПриложенномФайле.Вставить("Описание", ?(ЗначениеЗаполнено(ТекФайл.Описание),
						ТекФайл.НаименованиеДокументаФайла, СокрЛП(ТекФайл.ВидСведений)));
					ДанныеОПриложенномФайле.Вставить("ИмяФайла", ТекФайл.ИмяФайла);
					
					ОбластьПриложение.Параметры.Заполнить(ДанныеОПриложенномФайле);
					ТабличныйДокумент.Вывести(ОбластьПриложение);
				КонецЕсли;	
			КонецЦикла;
		КонецЕсли;	
		
		// ЦМО
		ПараметрыЦМО = Новый Структура;
		
		ПараметрыЦМО.Вставить("НаименованиеДолжностиСдал"	, СведенияАктаПередачиНФА.СдалОбъектыСоСтороныОтправителя.Должность);
		ПараметрыЦМО.Вставить("ДолжностьСдал"				, "");
		ПараметрыЦМО.Вставить("ФИОСдал"						, ИнициалыФамилияПоСтруктуреФИО(СведенияАктаПередачиНФА.СдалОбъектыСоСтороныОтправителя));
		ПараметрыЦМО.Вставить("Сдал"						, "");
		ПараметрыЦМО.Вставить("НаименованиеДолжностиПринял"	, СведенияАктаПередачиНФА.ПринялСоСтороныПолучателя.Должность);
		ПараметрыЦМО.Вставить("ДолжностьПринял"				, "");
		ПараметрыЦМО.Вставить("ФИОПринял"					, ИнициалыФамилияПоСтруктуреФИО(СведенияАктаПередачиНФА.ПринялСоСтороныПолучателя));
		ПараметрыЦМО.Вставить("Принял"						, "");
		
		ОбластьЦМО.Параметры.Заполнить(ПараметрыЦМО);
		ТабличныйДокумент.Вывести(ОбластьЦМО);
		
		// Комиссия
		
		// Председатель
		Отбор = Новый Структура("Председатель", Истина);
		СтрокиПредседатель = ВыборкаДокументов.СоставКомиссии.НайтиСтроки(Отбор);
		ДанныеПредседателя = Новый Структура("Должность,НаименованиеДолжности,Сотрудник,ФИО");
		Для Каждого Председатель Из СтрокиПредседатель Цикл
			ЗаполнитьЗначенияСвойств(ДанныеПредседателя, Председатель);
			ОбластьКомиссияП.Параметры.Заполнить(ДанныеПредседателя);
		КонецЦикла;
		ТабличныйДокумент.Вывести(ОбластьКомиссияП);
		
		// Члены комиссии
		Отбор = Новый Структура("Председатель", Ложь);
		СтрокиЧленыКомиссии = ВыборкаДокументов.СоставКомиссии.НайтиСтроки(Отбор);
		ПерваяСтрока = Истина;
		ДанныеЧК = Новый Структура("Должность,НаименованиеДолжности,Сотрудник,ФИО,Заголовок");
		Для Каждого ЧленКомиссии Из СтрокиЧленыКомиссии Цикл
			ЗаполнитьЗначенияСвойств(ДанныеЧК, ЧленКомиссии);
			ДанныеЧК.Заголовок = ?(ПерваяСтрока, НСтр("ru = 'Члены комиссии:'"), "");
			ОбластьКомиссияС.Параметры.Заполнить(ДанныеЧК);
			ТабличныйДокумент.Вывести(ОбластьКомиссияС);
			ПерваяСтрока = Ложь;
		КонецЦикла;
		
		// Исполнитель получателя
		СведенияИсполнителяПолучателя = Новый Структура;
		СведенияИсполнителяПолучателя.Вставить("ДолжностьНаименование", СведенияАктаПередачиНФА.ИсполнительПолучателя.Должность);
		СведенияИсполнителяПолучателя.Вставить("ФИО", ИнициалыФамилияПоСтруктуреФИО(СведенияАктаПередачиНФА.ИсполнительПолучателя));
		СведенияИсполнителяПолучателя.Вставить("НомерТелефона", СведенияАктаПередачиНФА.ИсполнительПолучателя.Телефон);
		СведенияИсполнителяПолучателя.Вставить("ЭлектроннаяПочта", СведенияАктаПередачиНФА.ИсполнительПолучателя.ЭлектронныйАдрес);
		
		ОбластьИсполнитель2.Параметры.Заполнить(СведенияИсполнителяПолучателя);
		ТабличныйДокумент.Вывести(ОбластьИсполнитель2);
		
		// В табличном документе зададим имя области, в которую был
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент,
			НомерСтрокиНачало, ОбъектыПечати, ВыборкаДокументов.Ссылка);
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция НапечататьОтветный0510448(МассивОбъектов, ОбъектыПечати, ДанныеДляПечати) Экспорт

	МетодыНачисления = Новый Соответствие;
	МетодыНачисления.Вставить(1, "");
	МетодыНачисления.Вставить(2, "100 %");
	МетодыНачисления.Вставить(3, "Линейный");
	МетодыНачисления.Вставить(4, "Уменьш. остатка");
	МетодыНачисления.Вставить(5, "От выработки");
	
	ТабличныйДокумент						= Новый ТабличныйДокумент;
	ТабличныйДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.АвтоМасштаб			= Истина;
	ТабличныйДокумент.ИмяПараметровПечати	= "ПараметрыПечати_Акт0510448";
	ТабличныйДокумент.ТолькоПросмотр		= Истина;
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ПФ_MXL_Акт0510448");
	
	ОбластьРуководитель	= Макет.ПолучитьОбласть("Руководитель");
	ОбластьШапка1		= Макет.ПолучитьОбласть("Шапка1");
	ОбластьОтправитель	= Макет.ПолучитьОбласть("Отправитель");
	ОбластьПолучатель	= Макет.ПолучитьОбласть("Получатель");
	ОбластьШапка2		= Макет.ПолучитьОбласть("Шапка2");
	ОбластьР1Шапка		= Макет.ПолучитьОбласть("Раздел1_Шапка");
	ОбластьР1Строка		= Макет.ПолучитьОбласть("Раздел1_Строка");
	ОбластьР1Подвал		= Макет.ПолучитьОбласть("Раздел1_Подвал");
	ОбластьР2Шапка		= Макет.ПолучитьОбласть("Раздел2_Шапка");
	ОбластьР2Строка		= Макет.ПолучитьОбласть("Раздел2_Строка");
	ОбластьР3Шапка		= Макет.ПолучитьОбласть("Раздел3_Шапка");
	ОбластьР3Строка		= Макет.ПолучитьОбласть("Раздел3_Строка");
	ОбластьР4Шапка		= Макет.ПолучитьОбласть("Раздел4_Шапка");
	ОбластьР4Строка		= Макет.ПолучитьОбласть("Раздел4_Строка");
	ОбластьПустаяСтрока	= Макет.ПолучитьОбласть("ПустаяСтрока");
	ОбластьПриложение	= Макет.ПолучитьОбласть("Приложение");
	ОбластьЦМО			= Макет.ПолучитьОбласть("ЦМО");
	ОбластьКомиссияП	= Макет.ПолучитьОбласть("Комиссия_Председатель");
	ОбластьКомиссияС	= Макет.ПолучитьОбласть("Комиссия_Строка");
	ОбластьИсполнитель1	= Макет.ПолучитьОбласть("Исполнитель");
	ОбластьИсполнитель2	= Макет.ПолучитьОбласть("Исполнитель");
	
	ДанныеПечатиОбщие = УправлениеПечатьюБГУ.ОбщиеСведенияДокументовДляПечати(МассивОбъектов);
	
	ПервыйДокумент = Истина;
	Для Каждого ВыборкаДокументов Из ДанныеДляПечати Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		Если НЕ ВыборкаДокументов.НФАПереданыЭлектроннымАктом Тогда
			Продолжить;
		КонецЕсли;	
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		ДокументПринятияКУчету = ВыборкаДокументов.Ссылка;
		ДанныеПечатиОбщиеДокумента = ДанныеПечатиОбщие.Получить(ДокументПринятияКУчету);
		Реквизиты = "ДокументОснование";
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументПринятияКУчету, Реквизиты);
		ВходящийАкт = ЗначенияРеквизитов.ДокументОснование;
		
		СведенияАктаПередачиНФА = СведенияЭДАктаПередачиНФАПоДокументу(ВходящийАкт);
		Если СведенияАктаПередачиНФА = Неопределено Тогда
			Продолжить;
		Иначе	
			ДополнитьСведенияАктаПередачиНФАСведенияПолучателя(СведенияАктаПередачиНФА, ДанныеПечатиОбщиеДокумента, ДокументПринятияКУчету, ВыборкаДокументов);
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		Организация = ВыборкаДокументов.Организация;
		ДатаАкта = ВыборкаДокументов.ДатаАкта;
		ДокументУчета = ВыборкаДокументов.Ссылка;
		ЭтоИмуществоКазны = Ложь;
		НачислятьАмортизациюИмуществаКазны = Истина;
		Если ТипЗнч(ДокументУчета) = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовИК")
			ИЛИ ТипЗнч(ДокументУчета) = Тип("ДокументСсылка.ПоступлениеОСИК") Тогда
			ЭтоИмуществоКазны = Истина;
			УчетнаяПолитика = Справочники.Организации.ПолучитьУчетнуюПолитику(Организация, ДатаАкта);
			НачислятьАмортизациюИмуществаКазны = УчетнаяПолитика.НачислятьАмортизациюИмуществаКазны;
		КонецЕсли;
		
		//Руководители		
		
		ПараметрыРуководитель = Новый Структура;
		ПараметрыРуководитель.Вставить("ФИООтправителя", ИнициалыФамилияПоСтруктуреФИО(СведенияАктаПередачиНФА.РуководительОтправителя));
		ПараметрыРуководитель.Вставить("ФИОПолучателя", ИнициалыФамилияПоСтруктуреФИО(СведенияАктаПередачиНФА.РуководительПолучателя));
		
		ОбластьРуководитель.Параметры.Заполнить(ПараметрыРуководитель);
		ТабличныйДокумент.Вывести(ОбластьРуководитель);
		
		// Шапка
		
		ПараметрыШапки = Новый Структура;
		ПараметрыШапки.Вставить("НомерАкта", СведенияАктаПередачиНФА.ОбщиеРеквизитыДокумента.Номер);
		ПараметрыШапки.Вставить("ДатаАкта", СведенияАктаПередачиНФА.ОбщиеРеквизитыДокумента.Дата);
		
		ОбластьШапка1.Параметры.Заполнить(ПараметрыШапки);
		ТабличныйДокумент.Вывести(ОбластьШапка1);

		//Отправитель
		
		ПараметрыКонтрагента = Новый Структура;
		ПараметрыКонтрагента.Вставить("НаименованиеКонтрагента"					, СведенияАктаПередачиНФА.ДанныеОтправителя.Наим);
		ПараметрыКонтрагента.Вставить("Контрагент"								, ВыборкаДокументов.Контрагент);
		ПараметрыКонтрагента.Вставить("КодРПБС"									, СведенияАктаПередачиНФА.ДанныеОтправителя.ЮЛ.КодПоРПБС);
		ПараметрыКонтрагента.Вставить("НаименованиеОбособленногоПодразделения"	, СведенияАктаПередачиНФА.ОбособленноеПодразделениеОтправителя.Наим);
		ПараметрыКонтрагента.Вставить("КодРПБСПодр"								, СведенияАктаПередачиНФА.ОбособленноеПодразделениеОтправителя.КодПоРПБС);
		ПараметрыКонтрагента.Вставить("НаименованиеСтруктурногоПодразделения"	, СведенияАктаПередачиНФА.СтруктурноеПодразделениеОтправителя.Наим);
		ПараметрыКонтрагента.Вставить("Учредитель"								, СведенияАктаПередачиНФА.УчредительОтправителя.Наим);
		ПараметрыКонтрагента.Вставить("ГлаваБК"									, СведенияАктаПередачиНФА.ДанныеОтправителя.ЮЛ.КодПоБК);
		ПараметрыКонтрагента.Вставить("БюджетНаименование"						, СведенияАктаПередачиНФА.БюджетОтправителя.Наим);
		ПараметрыКонтрагента.Вставить("ОКТМО"									, СведенияАктаПередачиНФА.БюджетОтправителя.КодОКТМО);
		
		ОбластьОтправитель.Параметры.Заполнить(ПараметрыКонтрагента);
		ТабличныйДокумент.Вывести(ОбластьОтправитель);
		
		//Получатель
		
		ПараметрыОрганизации = Новый Структура;
		ПараметрыОрганизации.Вставить("НаименованиеКонтрагента"	                , СведенияАктаПередачиНФА.ДанныеПолучателя.Наим);
		ПараметрыОрганизации.Вставить("Контрагент"								, ДанныеПечатиОбщиеДокумента.Организация);
		ПараметрыОрганизации.Вставить("КодРПБС"									, СведенияАктаПередачиНФА.ДанныеПолучателя.ЮЛ.КодПоРПБС);
		ПараметрыОрганизации.Вставить("НаименованиеОбособленногоПодразделения"	, СведенияАктаПередачиНФА.ОбособленноеПодразделениеПолучателя.Наим);
		ПараметрыОрганизации.Вставить("ОбособленноеПодразделение"				, ДанныеПечатиОбщиеДокумента.ОбособленноеПодразделение);
		ПараметрыОрганизации.Вставить("КодРПБСПодр"								, СведенияАктаПередачиНФА.ОбособленноеПодразделениеПолучателя.КодПоРПБС);
		ПараметрыОрганизации.Вставить("НаименованиеСтруктурногоПодразделения"	, СведенияАктаПередачиНФА.СтруктурноеПодразделениеПолучателя.Наим);
		ПараметрыОрганизации.Вставить("СтруктурноеПодразделение"				, ДанныеПечатиОбщиеДокумента.СтруктурноеПодразделение);
		ПараметрыОрганизации.Вставить("Учредитель"								, СведенияАктаПередачиНФА.УчредительПолучателя.Наим);
		ПараметрыОрганизации.Вставить("ГлаваБК"									, СведенияАктаПередачиНФА.ДанныеПолучателя.ЮЛ.КодПоБК);
		ПараметрыОрганизации.Вставить("БюджетНаименование"						, СведенияАктаПередачиНФА.БюджетПолучателя.Наим);
		ПараметрыОрганизации.Вставить("ОКТМО"									, СведенияАктаПередачиНФА.БюджетПолучателя.КодОКТМО);

		ОбластьПолучатель.Параметры.Заполнить(ПараметрыОрганизации);
		ТабличныйДокумент.Вывести(ОбластьПолучатель);

		ПараметрыШапки2 = Новый Структура;
		ПараметрыШапки2.Вставить("ВидИмущества", СведенияАктаПередачиНФА.ОбщиеРеквизитыДокумента.ВидИмущества);
		ПараметрыШапки2.Вставить("АналитическаяГруппа", СведенияАктаПередачиНФА.ОбщиеРеквизитыДокумента.АналитическаяГруппа);
		ПараметрыШапки2.Вставить("НаименованиеОснования", СведенияАктаПередачиНФА.ДокументОснование.Наим);
		ПараметрыШапки2.Вставить("НомерОснования", СведенияАктаПередачиНФА.ДокументОснование.Номер);
		ПараметрыШапки2.Вставить("ДатаОснования", СведенияАктаПередачиНФА.ДокументОснование.Дата);
		ПараметрыШапки2.Вставить("НаименованиеПриказа", СведенияАктаПередачиНФА.ДокументОснованиеОСозданииКомиссии.Наим);
		ПараметрыШапки2.Вставить("НомерПриказа", СведенияАктаПередачиНФА.ДокументОснованиеОСозданииКомиссии.Номер);
		ПараметрыШапки2.Вставить("ДатаПриказа", СведенияАктаПередачиНФА.ДокументОснованиеОСозданииКомиссии.Дата);
		
		ОбластьШапка2.Параметры.Заполнить(ПараметрыШапки2);
		ТабличныйДокумент.Вывести(ОбластьШапка2);
		
		// Раздел 1
		
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		ТабличныйДокумент.Вывести(ОбластьР1Шапка);
		
		Количество			= 0;
		Сумма				= 0;
		СуммаВложений		= 0;
		СуммаАмортизации	= 0;
		СуммаОбесценения	= 0;
		
		Для Каждого ТекСтрока Из СведенияАктаПередачиНФА.СведенияОПередаваемыхОбъектахНФА Цикл
			СтрокаПередаваемыйОбъект = Новый Структура;
			СтрокаПередаваемыйОбъект.Вставить("КодОбъекта", ТекСтрока.ИдентификационныйНомерОбъекта);
			СтрокаПередаваемыйОбъект.Вставить("КодГруппы", ТекСтрока.ИдентификационныйНомерГруппы);
			СтрокаПередаваемыйОбъект.Вставить("ИнвентарныйНомер", ТекСтрока.ИнвентарныйНомер);
			СтрокаПередаваемыйОбъект.Вставить("РеестровыйНомер", ТекСтрока.РеестровыйНомер);
			СтрокаПередаваемыйОбъект.Вставить("ЗаводскойНомер", ТекСтрока.ЗаводскойНомер);
			СтрокаПередаваемыйОбъект.Вставить("НомерПаспорта", ТекСтрока.НомерПаспорта);
			СтрокаПередаваемыйОбъект.Вставить("ИнойНомер", ТекСтрока.ИнойНомер);
			СтрокаПередаваемыйОбъект.Вставить("ДатаВыпуска", ТекСтрока.ДатаВыпуска);
			СтрокаПередаваемыйОбъект.Вставить("ДатаВводаВЭксплуатацию", ТекСтрока.ДатаВводаВЭксплуатацию);
			СтрокаПередаваемыйОбъект.Вставить("СуммаВложений", ТекСтрока.СуммаФактКапВложений);
			СтрокаПередаваемыйОбъект.Вставить("Цена", ТекСтрока.ЦенаЗаЕдиницу);
			СтрокаПередаваемыйОбъект.Вставить("Сумма", ТекСтрока.БалансоваяСтоимость);
			СтрокаПередаваемыйОбъект.Вставить("СрокЭксплуатации", ТекСтрока.ФактическийСрокЭксплуатации);
			СтрокаПередаваемыйОбъект.Вставить("АмортизационнаяГруппа", ТекСтрока.КодАмортизационнойГруппы);
			
			Метод = "";
			Если ЗначениеЗаполнено(ТекСтрока.МетодНачисленияАмортизации) Тогда
				Метод = МетодыНачисления[Число(ТекСтрока.МетодНачисленияАмортизации)];
			КонецЕсли;
			СтрокаПередаваемыйОбъект.Вставить("МетодАмортизации", Метод);
			
			НомерСтроки = Число(ТекСтрока.КодСтроки);
			Если НомерСтроки < 1000 Тогда
				СтрокаПередаваемыйОбъект.Вставить("НомерСтроки", Формат(НомерСтроки, "ЧЦ=3; ЧВН="));
			Иначе
				СтрокаПередаваемыйОбъект.Вставить("НомерСтроки", Формат(НомерСтроки, "ЧГ=0"));
			КонецЕсли;
			
			СтрокаПередаваемыйОбъект.Вставить("ДатаОкончанияАмортизации", ТекСтрока.ДатаОкончанияНачисленияАмортизации);
			СтрокаПередаваемыйОбъект.Вставить("СрокПолезногоИспользования", ТекСтрока.СрокПолезногоИспользования);
			СтрокаПередаваемыйОбъект.Вставить("СуммаАмортизации", ТекСтрока.СуммаНачисленнойАмортизации);
			СтрокаПередаваемыйОбъект.Вставить("СуммаОбесценения", ТекСтрока.СуммаНачисленногоОбесценения);
			СтрокаПередаваемыйОбъект.Вставить("GUIDНоменклатуры", ТекСтрока.GUIDНоменклатуры);
			СтрокаПередаваемыйОбъект.Вставить("НаименованиеНФА", ТекСтрока.ПолноеНаимНоменклатуры);
			СтрокаПередаваемыйОбъект.Вставить("Количество", ТекСтрока.Количество);
			СтрокаПередаваемыйОбъект.Вставить("Сведения", ТекСтрока.ИныеСведения);
			СтрокаПередаваемыйОбъект.Вставить("GUIDИнвентарногоНомера", ТекСтрока.GUIDИнвентарногоНомера);
			
			ОбластьР1Строка.Параметры.Заполнить(СтрокаПередаваемыйОбъект);
			
			ТабличныйДокумент.Вывести(ОбластьР1Строка);
			
			Количество			= Количество		+ СтрокаПередаваемыйОбъект.Количество;
			Сумма				= Сумма				+ СтрокаПередаваемыйОбъект.Сумма;
			СуммаВложений		= СуммаВложений		+ СтрокаПередаваемыйОбъект.СуммаВложений;
			СуммаАмортизации	= СуммаАмортизации	+ СтрокаПередаваемыйОбъект.СуммаАмортизации;
			СуммаОбесценения	= СуммаОбесценения	+ СтрокаПередаваемыйОбъект.СуммаОбесценения;
		КонецЦикла;
		
		ОбластьР1Подвал.Параметры.Заполнить(Новый Структура("Количество,Сумма,СуммаВложений,СуммаАмортизации,СуммаОбесценения",
			Количество, Сумма, СуммаВложений, СуммаАмортизации, СуммаОбесценения));
		ТабличныйДокумент.Вывести(ОбластьР1Подвал);
		
		// Раздел 2
		
		ТабличныйДокумент.Вывести(ОбластьР2Шапка);
		НомерПоПорядку = 1;
		СтрокаНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		Для Каждого ТекХарактеристика Из СведенияАктаПередачиНФА.ИндивидуальныеХарактеристикиОбъектовНФА Цикл
			
			СтрокаХарактеристик = Новый Структура;
			Если Число(ТекХарактеристика.КодСтроки) = 1 Тогда
				СтрокаХарактеристик.Вставить("НомерСтроки", Число(НомерПоПорядку));
			Иначе	
				СтрокаХарактеристик.Вставить("НомерСтроки", Число(ТекХарактеристика.КодСтроки));
			КонецЕсли;
			СтрокаХарактеристик.Вставить("НаименованиеНФА", ТекХарактеристика.ПолноеНаимНоменклатуры);
			СтрокаХарактеристик.Вставить("Адрес", ТекХарактеристика.АдресМестоположениеОбъекта);
			СтрокаХарактеристик.Вставить("Назначение", ТекХарактеристика.НазначениеОбъекта);
			СтрокаХарактеристик.Вставить("Драгметалл", ТекХарактеристика.ДрагоценныйМатериал);
			СтрокаХарактеристик.Вставить("Деталь", ТекХарактеристика.Деталь);
			СтрокаХарактеристик.Вставить("КодЕИ", ТекХарактеристика.ЕдИзмКод);
			СтрокаХарактеристик.Вставить("НаименованиеЕИ", ТекХарактеристика.ЕдИзмНаим);
			СтрокаХарактеристик.Вставить("Количество", ТекХарактеристика.Количество);
			СтрокаХарактеристик.Вставить("Характеристика", ТекХарактеристика.ПризнакХарактеристикаНаименование);
			СтрокаХарактеристик.Вставить("ЗначениеХарактеристики", ТекХарактеристика.ПризнакХарактеристикаЗначение);
			
			Если НЕ ЗначениеЗаполнено(СтрокаХарактеристик.НаименованиеНФА) Тогда
				СтрокаХарактеристик.НомерСтроки = "";
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(ТекХарактеристика.ДрагоценныйМатериал) Тогда
				СтрокаХарактеристик.Количество = "";
			КонецЕсли;	
			
			Если ЗначениеЗаполнено(СтрокаХарактеристик.НаименованиеНФА) Тогда 
				СтрокаКонец = ТабличныйДокумент.ВысотаТаблицы;

				Если СтрокаНачало < СтрокаКонец Тогда
					ТабличныйДокумент.Область(СтрокаНачало, 1, СтрокаКонец, 1).Объединить();
					ТабличныйДокумент.Область(СтрокаНачало, 2, СтрокаКонец, 4).Объединить();
					ТабличныйДокумент.Область(СтрокаНачало, 5, СтрокаКонец, 6).Объединить();
					ТабличныйДокумент.Область(СтрокаНачало, 7, СтрокаКонец, 9).Объединить();
				КонецЕсли;	

				СтрокаНачало = СтрокаКонец + 1;
			КонецЕсли;

			НомерПоПорядку = НомерПоПорядку + 1;
			
			ОбластьР2Строка.Параметры.Заполнить(СтрокаХарактеристик);
			
			ПараметрыСтроки = Новый Структура;
			Если ЗначениеЗаполнено(СтрокаХарактеристик.НомерСтроки) И Число(СтрокаХарактеристик.НомерСтроки) < 1000 Тогда
				ПараметрыСтроки.Вставить("НомерСтроки", Формат(СтрокаХарактеристик.НомерСтроки, "ЧЦ=3; ЧВН="));
			Иначе
				ПараметрыСтроки.Вставить("НомерСтроки", Формат(СтрокаХарактеристик.НомерСтроки, "ЧГ=0"));
			КонецЕсли;
			ОбластьР2Строка.Параметры.Заполнить(ПараметрыСтроки);
			ТабличныйДокумент.Вывести(ОбластьР2Строка);
		КонецЦикла;
		
		СтрокаКонец = ТабличныйДокумент.ВысотаТаблицы;
		Если СтрокаНачало < СтрокаКонец Тогда
			ТабличныйДокумент.Область(СтрокаНачало, 1, СтрокаКонец, 1).Объединить();
			ТабличныйДокумент.Область(СтрокаНачало, 2, СтрокаКонец, 4).Объединить();
			ТабличныйДокумент.Область(СтрокаНачало, 5, СтрокаКонец, 6).Объединить();
			ТабличныйДокумент.Область(СтрокаНачало, 7, СтрокаКонец, 9).Объединить();
		КонецЕсли;
		
		// Раздел 3
		
		ТабличныйДокумент.Вывести(ОбластьР3Шапка);
		НомерПоПорядку = 1;
		Для Каждого ТекОграничение Из СведенияАктаПередачиНФА.СведенияОбОграниченияхОбременениях Цикл
			
			СтрокаОграничения = Новый Структура;
			Если Число(ТекОграничение.КодСтроки) = 1 Тогда
				СтрокаОграничения.Вставить("НомерСтроки", Число(НомерПоПорядку));
			Иначе	
				СтрокаОграничения.Вставить("НомерСтроки", Число(ТекОграничение.КодСтроки));
			КонецЕсли;
			
			СтрокаОграничения.Вставить("НаименованиеНФА", ТекОграничение.ПолноеНаимНоменклатуры);
			СтрокаОграничения.Вставить("ЕдИзмОграничения", ТекОграничение.ЕдИзмОграничения);
			СтрокаОграничения.Вставить("ЗначениеОграничения", ТекОграничение.ЗначениеОграничения);
			СтрокаОграничения.Вставить("РегистрацияНомер", ТекОграничение.НомерДокументаОснованияРегистрации);
			СтрокаОграничения.Вставить("РегистрацияДата", ТекОграничение.ДатаДокументаОснованияРегистрации);
			СтрокаОграничения.Вставить("ВидОграничения", ТекОграничение.ВидОграничения);
			СтрокаОграничения.Вставить("НачалоОграничения", ТекОграничение.ДатаНачалаОграничения);
			СтрокаОграничения.Вставить("ОкончаниеОграничения", ТекОграничение.ДатаОкончанияОграничения);
			СтрокаОграничения.Вставить("СрокОграничения", ТекОграничение.СрокОграничения);
			СтрокаОграничения.Вставить("ПлатаЗаЕдОграничения", ТекОграничение.ЦенаПлатыЗаЕдиницу);
			СтрокаОграничения.Вставить("СуммаПлатыЗаОграничение", ТекОграничение.СуммаПлатыЗаВесьСрок);
			СтрокаОграничения.Вставить("СуммаПлатыЗаОграничениеЗаМесяц", ТекОграничение.СуммаПлатыЗаМесяц);
			СтрокаОграничения.Вставить("НомерДокументаОграничения", ТекОграничение.НомерДокументаОснования);
			СтрокаОграничения.Вставить("ДатаДокументаОграничения", ТекОграничение.ДатаДокументаОснования);
			СтрокаОграничения.Вставить("ВидДокументаОграничения", ТекОграничение.ВидДокументаОснования);
			СтрокаОграничения.Вставить("НомерКартыОграничения", ТекОграничение.НомерКарты);
			
			GUIDКонтрагента = ТекОграничение.GUIDКонтрагента;
			
			СведенияСвязанногоКонтрагента = СведенияСвязанногоКонтрагентаАктаПередачиНФА(ВходящийАкт, GUIDКонтрагента);
			СтрокаОграничения.Вставить("НаименованиеКонтрагентаОграничения", СведенияСвязанногоКонтрагента.НаименованиеКонтрагента);
			Если ЗначениеЗаполнено(СведенияСвязанногоКонтрагента.ОГРН) Тогда
				СтрокаОграничения.Вставить("ОГРНКонтрагентаОграничения", СведенияСвязанногоКонтрагента.ОГРН);
			Иначе
				СтрокаОграничения.Вставить("ОГРНКонтрагентаОграничения", СведенияСвязанногоКонтрагента.ОГРНИП);
			КонецЕсли;
			СтрокаОграничения.Вставить("ИННКонтрагентаОграничения", СведенияСвязанногоКонтрагента.ИНН);
			СтрокаОграничения.Вставить("КППКонтрагентаОграничения", СведенияСвязанногоКонтрагента.КПП);
			СтрокаОграничения.Вставить("ОКОПФКонтрагентаОграничения", СведенияСвязанногоКонтрагента.КодПоОКОПФ);
			СтрокаОграничения.Вставить("КИСЭКонтрагентаОграничения", СведенияСвязанногоКонтрагента.КодПоКИСЭ);
			
			НомерПоПорядку = НомерПоПорядку + 1;
			
			ОбластьР3Строка.Параметры.Заполнить(СтрокаОграничения);
			ТабличныйДокумент.Вывести(ОбластьР3Строка);
		КонецЦикла;
		
		СведенияИсполнителя = Новый Структура;
		СведенияИсполнителя.Вставить("ДолжностьНаименование", СведенияАктаПередачиНФА.ИсполнительОтправителя.Должность);
		СведенияИсполнителя.Вставить("ФИО", ИнициалыФамилияПоСтруктуреФИО(СведенияАктаПередачиНФА.ИсполнительОтправителя));
		СведенияИсполнителя.Вставить("НомерТелефона", СведенияАктаПередачиНФА.ИсполнительОтправителя.Телефон);
		СведенияИсполнителя.Вставить("ЭлектроннаяПочта", СведенияАктаПередачиНФА.ИсполнительОтправителя.ЭлектронныйАдрес);
		ОбластьИсполнитель1.Параметры.Заполнить(СведенияИсполнителя);
		
		ТабличныйДокумент.Вывести(ОбластьПустаяСтрока);
		ТабличныйДокумент.Вывести(ОбластьИсполнитель1);
		ТабличныйДокумент.Вывести(ОбластьПустаяСтрока);
		
		// Раздел 4
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		ТабличныйДокумент.Вывести(ОбластьР4Шапка);
		
		Если ТипЗнч(ДокументУчета) = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовОС") Тогда
			
			Реквизиты = "ВидИмуществаВТабличнойЧасти,ВидИмущества";
			РеквизитыШапкиДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументПринятияКУчету, Реквизиты);
			
			ВидИмуществаВТабличнойЧасти = РеквизитыШапкиДокумента.ВидИмуществаВТабличнойЧасти;
			ВидИмуществаВШапке = ?(НЕ ВидИмуществаВТабличнойЧасти,
				РеквизитыШапкиДокумента.ВидИмущества, "");
				
			ПредставленияВидаИмущества = Новый Соответствие;
			ПредставленияВидаИмущества.Вставить(Перечисления.ВидыИмущества.НедвижимоеИмущество	, "недвижимость");
			ПредставленияВидаИмущества.Вставить(Перечисления.ВидыИмущества.ДвижимоеОсобоЦенное	, "особо ценное");
			ПредставленияВидаИмущества.Вставить(Перечисления.ВидыИмущества.ИноеДвижимое			, "иное движимое");
				
			ПредставлениеВидаИмуществаИзШапки = ПредставленияВидаИмущества.Получить(ВидИмуществаВШапке);
			Если ПредставлениеВидаИмуществаИзШапки = Неопределено Тогда
				ПредставлениеВидаИмуществаИзШапки = ВидИмуществаВШапке;
			КонецЕсли;
		КонецЕсли;
		
		Для Каждого ТекОбъектНФА Из СведенияАктаПередачиНФА.СведенияОПринятыхОбъектахНФА Цикл
			
			СтрокаПринимаемыйОбъект = Новый Структура;
			
			СтрокаПринимаемыйОбъект.Вставить("НаименованиеНФА", ТекОбъектНФА.ПолноеНаимНоменклатуры); 
			СтрокаПринимаемыйОбъект.Вставить("Количество", ТекОбъектНФА.Количество); 
			СтрокаПринимаемыйОбъект.Вставить("АналитическаяГруппа", ТекОбъектНФА.АналитическаяГруппа); 
			Если ТипЗнч(ДокументУчета) = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовОС") 
					И НЕ ВидИмуществаВТабличнойЧасти Тогда
                ВидИмущества = ПредставлениеВидаИмуществаИзШапки;
			Иначе
				ВидИмущества = ТекОбъектНФА.ВидИмущества;
			КонецЕсли;
			СтрокаПринимаемыйОбъект.Вставить("ВидИмущества", ВидИмущества);  
			СтрокаПринимаемыйОбъект.Вставить("СуммаВложений", ТекОбъектНФА.СуммаФактКапВложений); 
			СтрокаПринимаемыйОбъект.Вставить("Сумма", ТекОбъектНФА.БалансоваяСтоимость); 
			
			АмортизационнаяГруппа = ТекОбъектНФА.АмортизационнаяГруппа;
			НормаАмортизации = ТекОбъектНФА.СуммаНормыАмортизации;
			Метод = "";
			Если ЗначениеЗаполнено(ТекОбъектНФА.МетодНачисленияАмортизации) Тогда
				Метод = МетодыНачисления[Число(ТекОбъектНФА.МетодНачисленияАмортизации)];
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(Метод) Тогда
				НормаАмортизации = "";
			КонецЕсли;
			ДатаОкончанияНачисленияАмортизации = ТекОбъектНФА.ДатаОкончанияНачисленияАмортизации;
			СрокПолезногоИспользования = ТекОбъектНФА.СрокПолезногоИспользования;
			
			Если ЭтоИмуществоКазны И Не НачислятьАмортизациюИмуществаКазны Тогда
				НормаАмортизации = "";
				АмортизационнаяГруппа = "";
				Метод = "";
				ДатаОкончанияНачисленияАмортизации = "";
				СрокПолезногоИспользования = "";
			КонецЕсли;
			
			СтрокаПринимаемыйОбъект.Вставить("АмортизационнаяГруппа", АмортизационнаяГруппа);
			СтрокаПринимаемыйОбъект.Вставить("НормаАмортизации", НормаАмортизации); 
			
			НомерСтроки = Число(ТекОбъектНФА.КодСтроки);
			Если НомерСтроки < 1000 Тогда
				СтрокаПринимаемыйОбъект.Вставить("НомерСтроки", Формат(НомерСтроки, "ЧЦ=3; ЧВН="));
			Иначе
				СтрокаПринимаемыйОбъект.Вставить("НомерСтроки", Формат(НомерСтроки, "ЧГ=0"));
			КонецЕсли;
			
			СтрокаПринимаемыйОбъект.Вставить("МетодАмортизации", Метод); 
			СтрокаПринимаемыйОбъект.Вставить("ДатаОкончанияАмортизации", ДатаОкончанияНачисленияАмортизации); 
			СтрокаПринимаемыйОбъект.Вставить("СрокПолезногоИспользования", СрокПолезногоИспользования); 
			
			ОбластьР4Строка.Параметры.Заполнить(СтрокаПринимаемыйОбъект);
			ТабличныйДокумент.Вывести(ОбластьР4Строка);
		КонецЦикла;
		
		// Приложения
		
		Сч = 0;
		ТабличныйДокумент.Вывести(ОбластьПустаяСтрока);
		Если СведенияАктаПередачиНФА.ФайлыПриложений.Количество() > 0 Тогда
			Для Каждого ТекФайл Из СведенияАктаПередачиНФА.ФайлыПриложений Цикл
				Если Сч = 0 Тогда
					ТабличныйДокумент.Вывести(ОбластьПустаяСтрока);
				КонецЕсли;
				Сч = Сч + 1;
				
				ДанныеОПриложенномФайле = Новый Структура;
				ДанныеОПриложенномФайле.Вставить("Номер", Сч);
				ДанныеОПриложенномФайле.Вставить("Описание", ?(ЗначениеЗаполнено(ТекФайл.НаименованиеДокументаФайла),
					ТекФайл.НаименованиеДокументаФайла, СокрЛП(ТекФайл.ВидСведений)));
				ДанныеОПриложенномФайле.Вставить("ИмяФайла", ТекФайл.ИмяФайла);
				
				ОбластьПриложение.Параметры.Заполнить(ДанныеОПриложенномФайле);
				ТабличныйДокумент.Вывести(ОбластьПриложение);
			КонецЦикла;
		КонецЕсли;
		
		// Приложения Отправителя
		Если ВыборкаДокументов.Файлы.Количество() > 0 Тогда
			Для Каждого ТекФайл Из ВыборкаДокументов.Файлы Цикл
				Если Сч = 0 Тогда
					ТабличныйДокумент.Вывести(ОбластьПустаяСтрока);
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ТекФайл.ИмяФайла) Тогда
					Сч = Сч + 1;
					
					ДанныеОПриложенномФайле = Новый Структура;
					ДанныеОПриложенномФайле.Вставить("Номер", Сч);
					ДанныеОПриложенномФайле.Вставить("Описание", ?(ЗначениеЗаполнено(ТекФайл.Описание),
						ТекФайл.НаименованиеДокументаФайла, СокрЛП(ТекФайл.ВидСведений)));
					ДанныеОПриложенномФайле.Вставить("ИмяФайла", ТекФайл.ИмяФайла);
					
					ОбластьПриложение.Параметры.Заполнить(ДанныеОПриложенномФайле);
					ТабличныйДокумент.Вывести(ОбластьПриложение);
				КонецЕсли;	
			КонецЦикла;
		КонецЕсли;	
		
		
		// ЦМО
		ПараметрыЦМО			= Новый Структура;
		
		ПараметрыЦМО.Вставить("НаименованиеДолжностиСдал"	, СведенияАктаПередачиНФА.СдалОбъектыСоСтороныОтправителя.Должность);
		ПараметрыЦМО.Вставить("ДолжностьСдал"				, "");
		ПараметрыЦМО.Вставить("ФИОСдал"						, ИнициалыФамилияПоСтруктуреФИО(СведенияАктаПередачиНФА.СдалОбъектыСоСтороныОтправителя));
		ПараметрыЦМО.Вставить("Сдал"						, "");
		ПараметрыЦМО.Вставить("НаименованиеДолжностиПринял"	, СведенияАктаПередачиНФА.ПринялСоСтороныПолучателя.Должность);
		ПараметрыЦМО.Вставить("ДолжностьПринял"				, "");
		ПараметрыЦМО.Вставить("ФИОПринял"					, ИнициалыФамилияПоСтруктуреФИО(СведенияАктаПередачиНФА.ПринялСоСтороныПолучателя));
		ПараметрыЦМО.Вставить("Принял"						, "");
		
		ОбластьЦМО.Параметры.Заполнить(ПараметрыЦМО);
		ТабличныйДокумент.Вывести(ОбластьЦМО);
		
		// Комиссия
		
		// Председатель
		Отбор = Новый Структура("Председатель", Истина);
		СтрокиПредседатель = ВыборкаДокументов.СоставКомиссии.НайтиСтроки(Отбор);
		ДанныеПредседателя = Новый Структура("Должность,НаименованиеДолжности,Сотрудник,ФИО");
		Для Каждого Председатель Из СтрокиПредседатель Цикл
			ЗаполнитьЗначенияСвойств(ДанныеПредседателя, Председатель);
			ОбластьКомиссияП.Параметры.Заполнить(ДанныеПредседателя);
		КонецЦикла;
		ТабличныйДокумент.Вывести(ОбластьКомиссияП);
		
		// Члены комиссии
		Отбор = Новый Структура("Председатель", Ложь);
		СтрокиЧленыКомиссии = ВыборкаДокументов.СоставКомиссии.НайтиСтроки(Отбор);
		ПерваяСтрока = Истина;
		ДанныеЧК = Новый Структура("Должность,НаименованиеДолжности,Сотрудник,ФИО,Заголовок");
		Для Каждого ЧленКомиссии Из СтрокиЧленыКомиссии Цикл
			ЗаполнитьЗначенияСвойств(ДанныеЧК, ЧленКомиссии);
			ДанныеЧК.Заголовок = ?(ПерваяСтрока, НСтр("ru = 'Члены комиссии:'"), "");
			ОбластьКомиссияС.Параметры.Заполнить(ДанныеЧК);
			ТабличныйДокумент.Вывести(ОбластьКомиссияС);
			ПерваяСтрока = Ложь;
		КонецЦикла;
		
		// Исполнитель получателя
		СведенияИсполнителяПолучателя = Новый Структура;
		СведенияИсполнителяПолучателя.Вставить("ДолжностьНаименование", СведенияАктаПередачиНФА.ИсполнительПолучателя.Должность);
		СведенияИсполнителяПолучателя.Вставить("ФИО", ИнициалыФамилияПоСтруктуреФИО(СведенияАктаПередачиНФА.ИсполнительПолучателя));
		СведенияИсполнителяПолучателя.Вставить("НомерТелефона", СведенияАктаПередачиНФА.ИсполнительПолучателя.Телефон);
		СведенияИсполнителяПолучателя.Вставить("ЭлектроннаяПочта", СведенияАктаПередачиНФА.ИсполнительПолучателя.ЭлектронныйАдрес);
		
		ОбластьИсполнитель2.Параметры.Заполнить(СведенияИсполнителяПолучателя);
		ТабличныйДокумент.Вывести(ОбластьИсполнитель2);
		
		// В табличном документе зададим имя области, в которую был
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент,
			НомерСтрокиНачало, ОбъектыПечати, ВыборкаДокументов.Ссылка);
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ФИОПоОтдельности(ФИО) Экспорт
	
	Возврат ФизическиеЛицаКлиентСервер.ЧастиИмени(ФИО);
	
КонецФункции	

Функция ФИОПоСтруктуре(ФИО) Экспорт
	Результат = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = '%1 %2 %3'"),
		ФИО.Фамилия,
		ФИО.Имя, 
		ФИО.Отчество);
	
	Возврат Результат;
КонецФункции

Функция ИнициалыФамилияПоСтруктуреФИО(ФИО) Экспорт
	ФИОПолное = ФИОПоСтруктуре(ФИО);
	Возврат КорреспондентыКлиентСервер.ФИО(ФИОПолное, Истина, , Истина, Истина);	
КонецФункции

Процедура ДополнитьСведенияАктаПередачиНФАСведенияПолучателя(СведенияЭДАктаПередачиНФА, ДанныеПечатиОбщие, ДокументПринятияКУчету, ДанныеДокументаУчета) Экспорт
	
	Если ЗначениеЗаполнено(ДанныеПечатиОбщие.ОбособленноеПодразделение) Тогда
		Реквизиты = "НаименованиеПолное, КодПоРПБС, Код";
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеПечатиОбщие.ОбособленноеПодразделение, Реквизиты);
		
		СведенияЭДАктаПередачиНФА.ОбособленноеПодразделениеПолучателя.Наим = ЗначенияРеквизитов.НаименованиеПолное;
		СведенияЭДАктаПередачиНФА.ОбособленноеПодразделениеПолучателя.Код = ЗначенияРеквизитов.Код;
		СведенияЭДАктаПередачиНФА.ОбособленноеПодразделениеПолучателя.КодПоРПБС = ЗначенияРеквизитов.КодПоРПБС;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеПечатиОбщие.СтруктурноеПодразделение) Тогда
		Реквизиты = "НаименованиеПолное, Код";
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеПечатиОбщие.СтруктурноеПодразделение, Реквизиты);
		
		СведенияЭДАктаПередачиНФА.СтруктурноеПодразделениеПолучателя.Наим = ЗначенияРеквизитов.НаименованиеПолное;
		СведенияЭДАктаПередачиНФА.СтруктурноеПодразделениеПолучателя.Код = ЗначенияРеквизитов.Код;
	КонецЕсли;
	
	СведенияЭДАктаПередачиНФА.УчредительПолучателя.Наим = ДанныеПечатиОбщие.Учредитель;
	Если ЗначениеЗаполнено(ДанныеПечатиОбщие.Учредитель) Тогда
		СведенияЭДАктаПередачиНФА.УчредительПолучателя.КодГлаваПоБК = ДанныеПечатиОбщие.ГлаваБК;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеПечатиОбщие.НаименованиеОбособленногоПодразделения) Тогда
		СведенияЭДАктаПередачиНФА.ОбособленноеПодразделениеПолучателя.Наим = ДанныеПечатиОбщие.НаименованиеОбособленногоПодразделения;
	КонецЕсли;	
	
	СведенияЭДАктаПередачиНФА.БюджетПолучателя.Наим = ДанныеПечатиОбщие.БюджетНаименование;
	СведенияЭДАктаПередачиНФА.БюджетПолучателя.КодОКТМО = ДанныеПечатиОбщие.ОКТМО;
	
	СведенияЭДАктаПередачиНФА.ДанныеПолучателя.Наим = ДанныеПечатиОбщие.НаименованиеОрганизации;
	СведенияЭДАктаПередачиНФА.ДанныеПолучателя.ЮЛ.Наим = ДанныеПечатиОбщие.НаименованиеОрганизации;
	СведенияЭДАктаПередачиНФА.ДанныеПолучателя.ЮЛ.ИНН = ДанныеПечатиОбщие.ИНН;
	СведенияЭДАктаПередачиНФА.ДанныеПолучателя.ЮЛ.КПП = ДанныеПечатиОбщие.КПП;
	СведенияЭДАктаПередачиНФА.ДанныеПолучателя.ЮЛ.КодПоБК = ДанныеПечатиОбщие.ГлаваБК;
	СведенияЭДАктаПередачиНФА.ДанныеПолучателя.ЮЛ.КодПоРПБС = ДанныеПечатиОбщие.КодРПБС;
	СведенияЭДАктаПередачиНФА.ДанныеПолучателя.Адрес.Наим = ДанныеПечатиОбщие.ЮридическийАдресОрганизации;
	
	ДанныеРуководителя = Справочники.Сотрудники.ДанныеСотрудника(ДанныеДокументаУчета.Руководитель, "Фамилия, Имя, Отчество, Должность");
	СведенияЭДАктаПередачиНФА.РуководительПолучателя.Фамилия = ДанныеРуководителя.Фамилия;
	СведенияЭДАктаПередачиНФА.РуководительПолучателя.Имя = ДанныеРуководителя.Имя;
	СведенияЭДАктаПередачиНФА.РуководительПолучателя.Отчество = ДанныеРуководителя.Отчество;
	СведенияЭДАктаПередачиНФА.РуководительПолучателя.Должность = СокрЛП(ДанныеРуководителя.Должность);

	ДанныеСотрудника = Справочники.Сотрудники.ДанныеСотрудника(ДанныеДокументаУчета.Сотрудник, "Фамилия, Имя, Отчество, Должность");
	СведенияЭДАктаПередачиНФА.ПринялСоСтороныПолучателя.Фамилия = ДанныеСотрудника.Фамилия;
	СведенияЭДАктаПередачиНФА.ПринялСоСтороныПолучателя.Имя = ДанныеСотрудника.Имя;
	СведенияЭДАктаПередачиНФА.ПринялСоСтороныПолучателя.Отчество = ДанныеСотрудника.Отчество;
	СведенияЭДАктаПередачиНФА.ПринялСоСтороныПолучателя.Должность = СокрЛП(ДанныеСотрудника.Должность);

	ОтветственныйФИО = ФИОПоОтдельности(ДанныеПечатиОбщие.ОтветственныйФИО);
	ФамилияОтветственного = ОтветственныйФИО.Фамилия;
	ИмяОтветственного = ОтветственныйФИО.Имя;
	ОтчествоОтветственного = ОтветственныйФИО.Отчество;
	
	СведенияЭДАктаПередачиНФА.ИсполнительПолучателя.Фамилия = ФамилияОтветственного;
	СведенияЭДАктаПередачиНФА.ИсполнительПолучателя.Имя = ИмяОтветственного;
	СведенияЭДАктаПередачиНФА.ИсполнительПолучателя.Отчество = ОтчествоОтветственного;
	СведенияЭДАктаПередачиНФА.ИсполнительПолучателя.Должность = ДанныеПечатиОбщие.ОтветственныйДолжность;
	СведенияЭДАктаПередачиНФА.ИсполнительПолучателя.Телефон = ДанныеПечатиОбщие.ОтветственныйТелефон;
	СведенияЭДАктаПередачиНФА.ИсполнительПолучателя.ЭлектронныйАдрес = ДанныеПечатиОбщие.ОтветственныйЭлПочта;

	//Документ о создании комиссии
	СведенияЭДАктаПередачиНФА.ДокументОснованиеОСозданииКомиссии.Наим = ДанныеДокументаУчета.НаименованиеПриказа;
	СведенияЭДАктаПередачиНФА.ДокументОснованиеОСозданииКомиссии.Номер = ДанныеДокументаУчета.НомерПриказа;
	СведенияЭДАктаПередачиНФА.ДокументОснованиеОСозданииКомиссии.Дата = ДанныеДокументаУчета.ДатаПриказа;
	
	// Председатель
	Отбор = Новый Структура("Председатель", Истина);
	СтрокиПредседатель = ДанныеДокументаУчета.СоставКомиссии.НайтиСтроки(Отбор);
	Для Каждого Председатель Из СтрокиПредседатель Цикл
		Если ЗначениеЗаполнено(Председатель.ОсобыеОтметки) Тогда
			ФИОПоОтдельности = ФИОПоОтдельности(Председатель.ОсобыеОтметки);
	    	СведенияЭДАктаПередачиНФА.ПредседательКомиссииПолучателя.Фамилия = ФИОПоОтдельности.Фамилия;
	    	СведенияЭДАктаПередачиНФА.ПредседательКомиссииПолучателя.Имя = ФИОПоОтдельности.Имя;
	    	СведенияЭДАктаПередачиНФА.ПредседательКомиссииПолучателя.Отчество = ФИОПоОтдельности.Отчество;
	    	СведенияЭДАктаПередачиНФА.ПредседательКомиссииПолучателя.Должность = Председатель.НаименованиеДолжности;
		Иначе	
			ФИОПоОтдельности = ФИОПоОтдельности(Председатель.ФИО);
	    	СведенияЭДАктаПередачиНФА.ПредседательКомиссииПолучателя.Фамилия = ФИОПоОтдельности.Фамилия;
	    	СведенияЭДАктаПередачиНФА.ПредседательКомиссииПолучателя.Имя = ФИОПоОтдельности.Имя;
	    	СведенияЭДАктаПередачиНФА.ПредседательКомиссииПолучателя.Отчество = ФИОПоОтдельности.Отчество;
	    	СведенияЭДАктаПередачиНФА.ПредседательКомиссииПолучателя.Должность = Председатель.НаименованиеДолжности;
		КонецЕсли;
	КонецЦикла;
	
	// Члены комиссии
	Отбор = Новый Структура("Председатель", Ложь);
	СтрокиЧленыКомиссии = ДанныеДокументаУчета.СоставКомиссии.НайтиСтроки(Отбор);
	НомерПоПорядку = 0;
	Для Каждого ЧленКомиссии Из СтрокиЧленыКомиссии Цикл
		НомерПоПорядку = НомерПоПорядку + 1;
		НоваяСтрока = СведенияЭДАктаПередачиНФА.ЧленыКомиссииПолучателя.Добавить();
		Если ЗначениеЗаполнено(ЧленКомиссии.ОсобыеОтметки) Тогда
			ФИОПоОтдельности = ФИОПоОтдельности(ЧленКомиссии.ОсобыеОтметки);
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ФИОПоОтдельности);
			НоваяСтрока.Должность = ЧленКомиссии.НаименованиеДолжности;
			НоваяСтрока.НомерПоПорядку = НомерПоПорядку;
		Иначе	
			ФИОПоОтдельности = ФИОПоОтдельности(ЧленКомиссии.ФИО);
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ФИОПоОтдельности);
			НоваяСтрока.Должность = ЧленКомиссии.НаименованиеДолжности;
			НоваяСтрока.НомерПоПорядку = НомерПоПорядку;
		Конецесли;
	КонецЦикла;
	
	//СведенияОПринятыхОбъектахНФА
	Если СведенияЭДАктаПередачиНФА.СведенияОПринятыхОбъектахНФА.Колонки.Найти("КодСчетаУчета") = Неопределено Тогда
		СведенияЭДАктаПередачиНФА.СведенияОПринятыхОбъектахНФА.Колонки.Добавить("GUIDНоменклатурыПолучателя", Новый ОписаниеТипов("Строка"));
		СведенияЭДАктаПередачиНФА.СведенияОПринятыхОбъектахНФА.Колонки.Добавить("GUIDИнвНомераПолучателя", Новый ОписаниеТипов("Строка"));
		СведенияЭДАктаПередачиНФА.СведенияОПринятыхОбъектахНФА.Колонки.Добавить("КПС", Новый ОписаниеТипов("Строка"));
		СведенияЭДАктаПередачиНФА.СведенияОПринятыхОбъектахНФА.Колонки.Добавить("КодСчетаУчета", Новый ОписаниеТипов("Строка"));
		СведенияЭДАктаПередачиНФА.СведенияОПринятыхОбъектахНФА.Колонки.Добавить("КФО", Новый ОписаниеТипов("Строка"));
		СведенияЭДАктаПередачиНФА.СведенияОПринятыхОбъектахНФА.Колонки.Добавить("ЕдИзмКод", Новый ОписаниеТипов("Строка"));
		СведенияЭДАктаПередачиНФА.СведенияОПринятыхОбъектахНФА.Колонки.Добавить("ЕдИзмНаим", Новый ОписаниеТипов("Строка"));
	КонецЕсли;	
	
	Для Каждого ТекСтрока Из ДанныеДокументаУчета.ПринятыеОбъектыНФА Цикл
		НоваяСтрока = СведенияЭДАктаПередачиНФА.СведенияОПринятыхОбъектахНФА.Добавить();
		НоваяСтрока.АмортизационнаяГруппа = ТекСтрока.АмортизационнаяГруппа;
		НоваяСтрока.АналитическаяГруппа = ТекСтрока.АналитическаяГруппа;
		НоваяСтрока.ВидИмущества = ТекСтрока.ВидИмущества;
		НоваяСтрока.ПолноеНаимНоменклатуры = ТекСтрока.НаименованиеНФА;
		
		НоваяСтрока.GUIDНоменклатурыПолучателя = Строка(ТекСтрока.НФА.УникальныйИдентификатор());
		
		Реквизиты = "GUIDНоменклатурыОтправителя";
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекСтрока.НФА, Реквизиты);
		
		GUIDНоменклатурыОтправителя = ЗначенияРеквизитов.GUIDНоменклатурыОтправителя;
		
		НоваяСтрока.GUIDНоменклатуры = GUIDНоменклатурыОтправителя;
		НоваяСтрока.Количество = ТекСтрока.Количество;
		
		НоваяСтрока.СуммаНормыАмортизации = ТекСтрока.НормаАмортизации;
		НоваяСтрока.МетодНачисленияАмортизации = ТекСтрока.ПорядокНачисления;
		НоваяСтрока.ДатаОкончанияНачисленияАмортизации = ТекСтрока.ДатаОкончанияАмортизации;
		НоваяСтрока.СрокПолезногоИспользования = ТекСтрока.СрокПолезногоИспользования;
		
		НоваяСтрока.СуммаФактКапВложений = ТекСтрока.СуммаВложений;
		НоваяСтрока.БалансоваяСтоимость = ТекСтрока.Сумма;
		
		GUIDИнвентарногоНомераУОтправителя = "";
		Если ЗначениеЗаполнено(ТекСтрока.ИнвентарныйНомерСсылка) Тогда
			НоваяСтрока.GUIDИнвНомераПолучателя = Строка(ТекСтрока.ИнвентарныйНомерСсылка.УникальныйИдентификатор());
			
			Реквизиты = "Код, ИнвентарныйНомерУОтправителя, GUIDИнвентарногоНомераУОтправителя";
			ЗначенияРеквизитовИнвНомера = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекСтрока.ИнвентарныйНомерСсылка, Реквизиты);
			
			GUIDИнвентарногоНомераУОтправителя = ЗначенияРеквизитовИнвНомера.GUIDИнвентарногоНомераУОтправителя;
			
			НоваяСтрока.ИнвентарныйНомер = СокрЛП(ЗначенияРеквизитовИнвНомера.Код);
			НоваяСтрока.ИнвентарныйНомерУОтправителя = ЗначенияРеквизитовИнвНомера.ИнвентарныйНомерУОтправителя;
			НоваяСтрока.GUIDИнвентарногоНомера = GUIDИнвентарногоНомераУОтправителя;
		КонецЕсли;
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("GUIDНоменклатуры", GUIDНоменклатурыОтправителя);
		ПараметрыОтбора.Вставить("GUIDИнвентарногоНомера", GUIDИнвентарногоНомераУОтправителя);
		ТаблицаНФА = СведенияЭДАктаПередачиНФА.СведенияОПередаваемыхОбъектахНФА;
		НайденныеСтроки = ТаблицаНФА.НайтиСтроки(ПараметрыОтбора);
		Если НайденныеСтроки.Количество()>0 Тогда
			НоваяСтрока.КодСтроки = НайденныеСтроки[0].КодСтроки;
		Иначе
			НоваяСтрока.КодСтроки = Строка(ТекСтрока.НомерСтроки);
		КонецЕсли;	
		
	КонецЦикла;	
	
КонецПроцедуры	

Функция СведенияЭДАктаПередачиНФА(СтруктураПараметров, СпособОбработки = "", НастройкаЭДО = Неопределено) Экспорт
	Результат = СведенияЭлектронногоАктаПередачиНФА();
	НаправленияДокументов = ОбменСКонтрагентами.НаправленияДокументов();
	
	ДеревоРазбора = ДеревоЭлектронногоДокументаБЭД.ИнициализироватьДеревоРазбора();
	
	Если НЕ СтруктураПараметров.Свойство("ФайлДанных") Тогда
		Возврат СтруктураПараметров;
	КонецЕсли;
	
	Если СтруктураПараметров.Свойство("ДокументыУчета") Тогда
		ДокументыУчета = СтруктураПараметров.ДокументыУчета;
	Иначе
		ДокументыУчета = Неопределено;
	КонецЕсли;
	
	ОшибкаЗаписи = Ложь;
	ВремФайл = ПолучитьИмяВременногоФайла("xml");
	ДвоичныеДанныеФайла = СтруктураПараметров.ФайлДанных;
	ДвоичныеДанныеФайла.Записать(ВремФайл);
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("ПрикладнойТипДокумента", Перечисления.ПрикладныеВидыЭлектронныхДокументовБГУ.АктОПриемеПередачеОбъектовНФА);
	
	СтруктураПодписей = Неопределено;
	ПараметрыЗаполнения.Вставить("ЭлектронныеПодписи", Новый Массив);
	ПараметрыЗаполнения.Вставить("СкрыватьДопДанные", Ложь);
	ПараметрыЗаполнения.Вставить("ЭлектронныеПодписи", СтруктураПараметров.ЭлектронныеПодписи);
	ПараметрыЗаполнения.Вставить("ЗаполнятьСодержимоеФайлов", СтруктураПараметров.ЗаполнятьСодержимоеФайлов);
	
	ПолучитьСведенияИзФайлаПрикладногоЭлектронногоДокумента(ДвоичныеДанныеФайла, ПараметрыЗаполнения, Результат);	
	
	РаботаСФайламиБЭД.УдалитьВременныеФайлы(ВремФайл);
	
	Возврат Результат;
КонецФункции	

Функция СведенияЭДАктаПередачиНФАПоДокументу(ДокументСсылка) Экспорт
	Перем ЭД;

	Результат = Неопределено;
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Результат;	
	КонецЕсли;	
	
	ЭД = ЭлектронныйДокументБЭДПоДокументуУчета(ДокументСсылка);
	
	СведенияЭД = СведенияОбЭлектронномДокументе(ЭД);
	Если НЕ СведенияЭД.Актуальный Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если НЕ СведенияЭД.ОписаниеВидаДокумента.ТипДокумента = Перечисления.ТипыДокументовЭДО.Прикладной Тогда
		Возврат Результат;
	КонецЕсли;	
	
	УстановитьПривилегированныйРежим(Истина);
	
	ФайлДанных = ПолучитьДанныеЭДДляАктаПередачиНФА(ЭД);
	Если НЕ ЗначениеЗаполнено(ФайлДанных) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ДокументыУчета = Новый Массив;
	ДокументыУчета.Добавить(ДокументСсылка);
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ДокументыУчета", ДокументыУчета);
	
	СтруктураПараметров.Вставить("ФайлДанных",  ФайлДанных);
	СтруктураПараметров.Вставить("ЭлектронныеПодписи", СведенияЭД.Подписи);
	СтруктураПараметров.Вставить("ЗаполнятьСодержимоеФайлов",  Ложь);
	
	Результат = СведенияЭДАктаПередачиНФА(СтруктураПараметров);
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
КонецФункции

