Функция СведенияПредставленияВнутреннегоЭДПОД(ДокументУчета, ИдентификаторПечати, ДатаИсходящегоДокумента, НомерИсходящегоДокумента, Расширение)

	Результат = Новый Структура;
	КодВидаСведений = 0;
	ТекстовоеСодержимое = "";
	ИмяПриложенногоФайла = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Акт о приеме-передаче объектов НФА от %1 N %2.%3'"), ДатаИсходящегоДокумента, НомерИсходящегоДокумента, Расширение);
	
	
	Если Расширение = "MXL" Тогда
		ТипФайлаТабДок = ТипФайлаТабличногоДокумента.MXL;
		КодВидаСведений = 1;
	ИначеЕсли Расширение = "PDF" Тогда
		ТипФайлаТабДок = ТипФайлаТабличногоДокумента.PDF_A_3;
		КодВидаСведений = 2;
	КонецЕсли;	

	Если КодВидаСведений = 0 Тогда
		Результат.Вставить("ТекстовоеСодержимое", ТекстовоеСодержимое);
		Результат.Вставить("ИмяПриложенногоФайла", ИмяПриложенногоФайла);
		Результат.Вставить("КодВидаСведений", КодВидаСведений);
	Возврат Результат;
		
	КонецЕсли;	
	
	ДвоичныеДанные = ДвоичныеДанныеПредставленияДокументаПОД(ДокументУчета, ИдентификаторПечати, ТипФайлаТабДок);
	
	ТекстовоеСодержимое = Base64Строка(ДвоичныеДанные);
	
	Результат.Вставить("ТекстовоеСодержимое", ТекстовоеСодержимое);
	Результат.Вставить("ИмяПриложенногоФайла", ИмяПриложенногоФайла);
	Результат.Вставить("КодВидаСведений", КодВидаСведений);

	Возврат Результат;
КонецФункции

Функция ОтветныйАктПоИсходящемуАкту(ИсходящийАкт) Экспорт
	Результат = Документы.ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий.ПустаяСсылка();
	НекорректныеСостоянияЭДО = Новый Массив;
	НекорректныеСостоянияЭДО.Добавить(Перечисления.СостоянияДокументовЭДО.ОжидаетсяИсправление);
	НекорректныеСостоянияЭДО.Добавить(Перечисления.СостоянияДокументовЭДО.ОжидаетсяПодтверждениеАннулирования);
	НекорректныеСостоянияЭДО.Добавить(Перечисления.СостоянияДокументовЭДО.Аннулирован);
	НекорректныеСостоянияЭДО.Добавить(Перечисления.СостоянияДокументовЭДО.ЗакрытПринудительно);
	НекорректныеСостоянияЭДО.Добавить(Перечисления.СостоянияДокументовЭДО.ЗакрытСОтклонением);
	НекорректныеСостоянияЭДО.Добавить(Перечисления.СостоянияДокументовЭДО.ЗакрытСОтклонениемПриглашения);
	НекорректныеСостоянияЭДО.Добавить(Перечисления.СостоянияДокументовЭДО.ЗакрытСОшибкойПередачи);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий.Ссылка КАК Ссылка,
	               |	СостоянияПоОбъектамУчетаЭДО.СостояниеЭДО КАК СостояниеЭДО
	               |ИЗ
	               |	Документ.ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий КАК ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияПоОбъектамУчетаЭДО КАК СостоянияПоОбъектамУчетаЭДО
	               |		ПО ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий.Ссылка = СостоянияПоОбъектамУчетаЭДО.СсылкаНаОбъект
	               |ГДЕ
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий.ДокументОснование = &ДокументОснование
	               |	И ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий.ДокументОснование.ПометкаУдаления = ЛОЖЬ
	               |	И НЕ СостоянияПоОбъектамУчетаЭДО.СостояниеЭДО В (&НекорректныеСостоянияЭДО)
	               |	И ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("ДокументОснование", ИсходящийАкт);

	Запрос.УстановитьПараметр("НекорректныеСостоянияЭДО", НекорректныеСостоянияЭДО);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

Функция ЭтоДокументПринятияКУчетуДляВходящегоАкта0510448(УчетныйДокумент)
	Результат = Ложь;
	Если ТипЗнч(УчетныйДокумент) = Тип("ДокументСсылка.ПоступлениеИК")
		ИЛИ ТипЗнч(УчетныйДокумент) = Тип("ДокументСсылка.ПоступлениеМЗ")
		ИЛИ ТипЗнч(УчетныйДокумент) = Тип("ДокументСсылка.ПрочееОтражениеЭлектронногоДокументаВУчете")
		ИЛИ ТипЗнч(УчетныйДокумент) = Тип("ДокументСсылка.ПоступлениеОС")
		ИЛИ ТипЗнч(УчетныйДокумент) = Тип("ДокументСсылка.ПоступлениеОСИК")
		ИЛИ ТипЗнч(УчетныйДокумент) = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовИК")
		ИЛИ ТипЗнч(УчетныйДокумент) = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовОС") Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(УчетныйДокумент, "ДокументОснование");		
			Если ТипЗнч(ЗначенияРеквизитов.ДокументОснование) = Тип("ДокументСсылка.ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий") Тогда
				Результат = Истина;
			КонецЕсли;	
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

