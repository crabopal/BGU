	Результат.Колонки.Добавить("СрокДействияПоследнейМеткиВремени", );
	Результат.Колонки.Добавить("Сертификат", );
	Результат.Колонки.Добавить("МашиночитаемаяДоверенность", Новый ОписаниеТипов("СправочникСсылка.МашиночитаемыеДоверенности"));
	Результат.Колонки.Добавить("РезультатПроверкиПодписиПоМЧД", );
	
	Возврат Результат;
КонецФункции	

Функция СписокЭлектронныхПодписей(Объект)
	
	ЭлектронныеПодписи = ВнутреннийЭДО.УстановленныеПодписи(Объект);
	
	Для Каждого ЭлектроннаяПодписьФайла Из ЭлектронныеПодписи Цикл
		
		ЭлектроннаяПодписьФайла.Вставить("Объект", Объект);
		
		АдресПодписи = ПоместитьВоВременноеХранилище(ЭлектроннаяПодписьФайла.Подпись, );
		ЭлектроннаяПодписьФайла.Вставить("АдресПодписи", АдресПодписи);
		
		АдресСертификата = ПоместитьВоВременноеХранилище(ЭлектроннаяПодписьФайла.Сертификат, );
		ЭлектроннаяПодписьФайла.Вставить("АдресСертификата", АдресСертификата);
		
	КонецЦикла;
	
	Возврат ЭлектронныеПодписи;
	
КонецФункции

Процедура ЗаполнитьСписокПодписей(ЭлектронныеПодписи, ОсновнойФайл, Организация) Экспорт
	
	ЭлектронныеПодписи.Очистить();
	
	МассивЭП = СписокЭлектронныхПодписей(ОсновнойФайл);
	
	НомерСтроки = 0;
	
	Для Каждого ЭП Из МассивЭП Цикл
		
		НомерСтроки = НомерСтроки + 1;
		
		НоваяСтрока = ЭлектронныеПодписи.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ЭП);
		НоваяСтрока.НомерСтроки = НомерСтроки;
		НоваяСтрока.Организация = ?(ЗначениеЗаполнено(ЭП.Организация), ЭП.Организация, Организация);
		
		Если НоваяСтрока.ПростаяПодпись Тогда
			НоваяСтрока.КартинкаЭП = 1;
			НоваяСтрока.КомуВыданСертификат = СтрШаблон(НСтр("ru = '%1, %2, %3'"),
				ЭП.ВладелецПодписи, Организация, ЭП.Должность);
		Иначе
			НоваяСтрока.КартинкаЭП = 0;
		КонецЕсли;
		
		ЗаполнитьСтатусПодписи(НоваяСтрока);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСтатусПодписи(СтрокаПодписи)
	
	Если Не ЗначениеЗаполнено(СтрокаПодписи.ДатаПроверкиПодписи) Тогда
		СтрокаПодписи.Статус = "";
	ИначеЕсли НЕ СтрокаПодписи.ПодписьВерна Тогда
		СтрокаПодписи.Статус = НСтр("ru = 'Неверна'");
	Иначе
		СтрокаПодписи.Статус = НСтр("ru = 'Верна'");
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьКонтрагентаВТаблицуКонтрагентовАкта(СвязанныеКонтрагенты, Контрагент, GUIDКонтрагента)
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Контрагент", Контрагент);
	НайденныеСтроки = СвязанныеКонтрагенты.НайтиСтроки(ПараметрыОтбора);
	Если НайденныеСтроки.Количество() = 0 И ТипЗнч(Контрагент) = Тип("СправочникСсылка.Контрагенты") Тогда
		НоваяСтрока = СвязанныеКонтрагенты.Добавить();
		НоваяСтрока.Контрагент = Контрагент;
		НоваяСтрока.GUIDКонтрагента = GUIDКонтрагента;

		Реквизиты = "ИНН, КПП, ЮридическоеФизическоеЛицо, ТипКонтрагента, ВидКонтрагента";
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Контрагент, Реквизиты);
		
		ЮридическоеФизическоеЛицо = ЗначенияРеквизитов.ЮридическоеФизическоеЛицо;
		
		НоваяСтрока.ИНН = ЗначенияРеквизитов.ИНН;
		НоваяСтрока.КПП = ЗначенияРеквизитов.КПП;
		НоваяСтрока.Наим = СокрЛП(ЮридическоеФизическоеЛицо);
        НоваяСтрока.КодВида = ЗначенияРеквизитов.ВидКонтрагента;
        НоваяСтрока.КодТипа = ЗначенияРеквизитов.ТипКонтрагента.Код;
		
		Если ТипЗнч(ЮридическоеФизическоеЛицо) = Тип("СправочникСсылка.ЮридическиеЛица") Тогда
			Реквизиты = "ОГРН, Наименование, НаименованиеПолное";
			ЗначенияРеквизитовЮЛ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЮридическоеФизическоеЛицо, Реквизиты);
			НоваяСтрока.ОГРН = ЗначенияРеквизитовЮЛ.ОГРН;
			НоваяСтрока.Наим = ЗначенияРеквизитовЮЛ.Наименование;
			НоваяСтрока.НаименованиеПолное = ЗначенияРеквизитовЮЛ.НаименованиеПолное;
			
		ИначеЕсли ТипЗнч(ЮридическоеФизическоеЛицо) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
			Реквизиты = "Наименование, ОГРНИП";
			ЗначенияРеквизитовФЛ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЮридическоеФизическоеЛицо, Реквизиты);
			НоваяСтрока.ОГРНИП = ЗначенияРеквизитовФЛ.ОГРНИП;
			НоваяСтрока.Наим = ЗначенияРеквизитовФЛ.Наименование;
		КонецЕсли;
	ИначеЕсли НайденныеСтроки.Количество() = 0 И ТипЗнч(Контрагент) = Тип("СправочникСсылка.Организации") Тогда 
		НоваяСтрока = СвязанныеКонтрагенты.Добавить();
		НоваяСтрока.Контрагент = Контрагент;
		НоваяСтрока.GUIDКонтрагента = GUIDКонтрагента;

		Реквизиты = "ИНН, КПП, ОГРН, Наименование, НаименованиеПолное";
		ЗначенияРеквизитовОрг = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Контрагент, Реквизиты);	
		
		НоваяСтрока.ИНН = ЗначенияРеквизитовОрг.ИНН;
		НоваяСтрока.КПП = ЗначенияРеквизитовОрг.КПП;
		НоваяСтрока.Наим = ЗначенияРеквизитовОрг.Наименование; 
		НоваяСтрока.ОГРН = ЗначенияРеквизитовОрг.ОГРН; 
		НоваяСтрока.НаименованиеПолное	= ЗначенияРеквизитовОрг.НаименованиеПолное;
		
	КонецЕсли;	
КонецПроцедуры	

Функция ПолучитьМассивТиповЗначенийДополнительныхСведенийНФА(СвойствоТипЗнч)
	
	МассивТипов = Новый Массив;
	МассивПредставленийТиповЗнач = СтрРазделить(СвойствоТипЗнч,",");
	
	Для Каждого ТекЭлемент Из МассивПредставленийТиповЗнач Цикл 
		
		СвойствоТипЗначения = ПолучитьОписаниеТиповЗначенийДополнительныхСведенийНФА(СокрЛП(ТекЭлемент));
		
		Если СвойствоТипЗначения = Неопределено Тогда 
			Продолжить;	
		КонецЕсли;
		
		МассивТипов.Добавить(ТИП(СвойствоТипЗначения));	
		
	КонецЦикла;

	Возврат МассивТипов;

КонецФункции  

Функция ПолучитьОписаниеТиповЗначенийДополнительныхСведенийНФА(СвойствоТипЗначения)
	
	Если СвойствоТипЗначения = "Булево" Тогда 
		
		ОписаниеТипаЗнч	= "Булево"; 
		
	ИначеЕсли СвойствоТипЗначения = "Дата" Тогда 
		
		ОписаниеТипаЗнч	= "Дата"; 
		
	ИначеЕсли СвойствоТипЗначения = "Строка" Тогда
		
		ОписаниеТипаЗнч	= "Строка";
		
	ИначеЕсли СвойствоТипЗначения = "Число" Тогда
		
		ОписаниеТипаЗнч	= "Число";
		
	ИначеЕсли СвойствоТипЗначения = "Договор или иное обязательство" Тогда
		
		ОписаниеТипаЗнч	= "СправочникСсылка.Договоры";
		
	ИначеЕсли СвойствоТипЗначения = "Должность" Тогда
		
		ОписаниеТипаЗнч	= "СправочникСсылка.Должности";
		
	ИначеЕсли СвойствоТипЗначения = "Дополнительное значение" Тогда 
		
		ОписаниеТипаЗнч = "СправочникСсылка.ЗначенияСвойствОбъектов";
		
	ИначеЕсли СвойствоТипЗначения = "Дополнительное значение (иерархия)" Тогда 
		
		ОписаниеТипаЗнч = "СправочникСсылка.ЗначенияСвойствОбъектовИерархия";

	ИначеЕсли СвойствоТипЗначения = "Мероприятия" Тогда
		
		ОписаниеТипаЗнч	= "СправочникСсылка.Мероприятия";
		
	ИначеЕсли СвойствоТипЗначения = "Направление деятельности" Тогда
		
		ОписаниеТипаЗнч	= "СправочникСсылка.НаправленияДеятельности";
		
	ИначеЕсли СвойствоТипЗначения = "Номенклатура" Тогда
		
		ОписаниеТипаЗнч	= "СправочникСсылка.Номенклатура"; 
		
	ИначеЕсли СвойствоТипЗначения = "ОПФ" Тогда 
		
		ОписаниеТипаЗнч = "СправочникСсылка.ОбщероссийскийКлассификаторОрганизационноПравовыхФорм";	
		
	ИначеЕсли СвойствоТипЗначения = "Организация" Тогда
		
		ОписаниеТипаЗнч	= "СправочникСсылка.Организации";	
		
	ИначеЕсли СвойствоТипЗначения = "Основное средство" Тогда
		
		ОписаниеТипаЗнч	= "СправочникСсылка.ОсновныеСредства";	
		
	ИначеЕсли СвойствоТипЗначения = "Отчетный период" Тогда
		
		ОписаниеТипаЗнч	= "СправочникСсылка.Периоды"; 
			
	ИначеЕсли СвойствоТипЗначения = "Подразделение" Тогда
		
		ОписаниеТипаЗнч	= "СправочникСсылка.Подразделения";
		
	ИначеЕсли СвойствоТипЗначения = "Пользователь" Тогда
		
		ОписаниеТипаЗнч	= "СправочникСсылка.Пользователи";
	
	ИначеЕсли СвойствоТипЗначения = "Сотрудник" Тогда
		
		ОписаниеТипаЗнч	= "СправочникСсылка.Сотрудники";
				
	ИначеЕсли СвойствоТипЗначения = "Страна мира" Тогда
		
		ОписаниеТипаЗнч	= "СправочникСсылка.СтраныМира";
	
	ИначеЕсли СвойствоТипЗначения = "Субъект РФ" Тогда
		
		ОписаниеТипаЗнч	= "СправочникСсылка.СубъектыРФ";
		
	Иначе	
		
		ОписаниеТипаЗнч	= Неопределено;
		
	КонецЕсли;

	Возврат ОписаниеТипаЗнч;

КонецФункции

Функция ЗаполнитьЗначенияДополнительныхСведенийНФА(СвойствоНФА, СтрокаТаблицы, Организация, Контрагент)
	
	Если СтрокаТаблицы.ТипЗначения = "Булево" Тогда 
		 
		Если СтрокаТаблицы.Представление = "Истина" ИЛИ СтрокаТаблицы.Представление = "Да" Тогда
			Значение = Истина;	
		Иначе		
			Значение = Ложь;	
		КонецЕсли;
		
		ЗначениеЗаписи	= Значение; 
		
