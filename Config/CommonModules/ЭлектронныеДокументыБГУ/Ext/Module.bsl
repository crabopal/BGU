	МассивДокументовДляЭДО.Добавить("ИсправительныйСчетФактураВыданный");
	МассивДокументовДляЭДО.Добавить("СчетФактураПолученный");
	МассивДокументовДляЭДО.Добавить("КорректировочныйСчетФактураПолученный");
	МассивДокументовДляЭДО.Добавить("НакладнаяНаРеализациюТорг12");
	МассивДокументовДляЭДО.Добавить("НакладнаяНаОтпускМ15");
	МассивДокументовДляЭДО.Добавить("ПередачаОбъектовОС");
