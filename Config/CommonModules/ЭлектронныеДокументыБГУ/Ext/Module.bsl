	|		ИНАЧЕ ВЫРАЗИТЬ(РеквизитыЛицевыхСчетов.КассовыйОрган КАК Справочник.Банки).Код
	|	КОНЕЦ КАК БИК,
	|	ВЫБОР
	|		КОГДА ВЫРАЗИТЬ(РеквизитыЛицевыхСчетов.Владелец КАК Справочник.ЛицевыеСчета).ТипЛицевогоСчета = ЗНАЧЕНИЕ(Перечисление.ТипыЛицевыхСчетов.Казначейский)
	|			ТОГДА ВЫРАЗИТЬ(РеквизитыЛицевыхСчетов.Владелец КАК Справочник.ЛицевыеСчета).Код
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК НомерЛицевогоСчета,
	|	ВЫБОР
	|		КОГДА ВЫРАЗИТЬ(РеквизитыЛицевыхСчетов.Владелец КАК Справочник.ЛицевыеСчета).ТипЛицевогоСчета = ЗНАЧЕНИЕ(Перечисление.ТипыЛицевыхСчетов.Казначейский)
	|			ТОГДА ВЫРАЗИТЬ(РеквизитыЛицевыхСчетов.КассовыйОрган КАК Справочник.Казначейства).Код
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК КассовыйОрганКод,
	|	ВЫБОР
	|		КОГДА ВЫРАЗИТЬ(РеквизитыЛицевыхСчетов.Владелец КАК Справочник.ЛицевыеСчета).ТипЛицевогоСчета = ЗНАЧЕНИЕ(Перечисление.ТипыЛицевыхСчетов.Казначейский)
	|			ТОГДА ВЫРАЗИТЬ(РеквизитыЛицевыхСчетов.КассовыйОрган КАК Справочник.Казначейства).Наименование
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК КассовыйОрганНаименование,
	|	ВЫБОР
	|		КОГДА ВЫРАЗИТЬ(РеквизитыЛицевыхСчетов.Владелец КАК Справочник.ЛицевыеСчета).ТипЛицевогоСчета = ЗНАЧЕНИЕ(Перечисление.ТипыЛицевыхСчетов.Казначейский)
	|			ТОГДА ВЫРАЗИТЬ(РеквизитыЛицевыхСчетов.КассовыйОрган КАК Справочник.Казначейства).НаименованиеПолное
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК КассовыйОрганНаименованиеПолное,
	|	ВЫБОР
	|		КОГДА ВЫРАЗИТЬ(РеквизитыЛицевыхСчетов.Владелец КАК Справочник.ЛицевыеСчета).ТипЛицевогоСчета = ЗНАЧЕНИЕ(Перечисление.ТипыЛицевыхСчетов.Казначейский)
	|			ТОГДА ВЫРАЗИТЬ(РеквизитыЛицевыхСчетов.КассовыйОрган КАК Справочник.Казначейства).ИНН
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК КассовыйОрганИНН,
	|	ВЫБОР
	|		КОГДА ВЫРАЗИТЬ(РеквизитыЛицевыхСчетов.Владелец КАК Справочник.ЛицевыеСчета).ТипЛицевогоСчета = ЗНАЧЕНИЕ(Перечисление.ТипыЛицевыхСчетов.Казначейский)
	|			ТОГДА ВЫРАЗИТЬ(РеквизитыЛицевыхСчетов.КассовыйОрган КАК Справочник.Казначейства).КПП
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК КассовыйОрганКПП
	|ИЗ
	|	Справочник.РеквизитыЛицевыхСчетов КАК РеквизитыЛицевыхСчетов
	|ГДЕ
	|	РеквизитыЛицевыхСчетов.Владелец.Владелец = &Владелец
	|	И РеквизитыЛицевыхСчетов.ПометкаУдаления = ЛОЖЬ
	|	И РеквизитыЛицевыхСчетов.Владелец.ПометкаУдаления = ЛОЖЬ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Тип";
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
КонецФункции	

Функция АдресЭлектроннойПочтыКонтрагента(Контрагент) Экспорт
	
	АдресЭП = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КонтрагентыКонтактнаяИнформация.АдресЭП
	               |ИЗ
	               |	Справочник.Контрагенты.КонтактнаяИнформация КАК КонтрагентыКонтактнаяИнформация
	               |ГДЕ
	               |	КонтрагентыКонтактнаяИнформация.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Контрагент);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		АдресЭП = Выборка.АдресЭП;
	КонецЦикла;	
	
	Возврат АдресЭП;
	
КонецФункции

Процедура ДанныеСвидетельстваОРегистрацииИП(ИП, Сведения) Экспорт
	
	Сведения = "";
	
	Если ТипЗнч(ИП) = Тип("СправочникСсылка.Контрагенты") Тогда
		ЮрФизЛицо = ИП.ЮридическоеФизическоеЛицо;
		Если ТипЗнч(ЮрФизЛицо) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
			Если НЕ(ЮрФизЛицо.СвидетельствоСерияНомер = "") Тогда
				Сведения = СокрЛП(ЮрФизЛицо.СвидетельствоСерияНомер)+" от "+Формат(ЮрФизЛицо.СвидетельствоДата,"ДЛФ=D");
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры

Процедура СписокОперацийВидаЭД(ВидЭД,СписокСпособовОбработки) Экспорт
	
	ТипыДокументов = ОбменСКонтрагентами.ТипыДокументов();
	
	Если ВидЭД = ТипыДокументов.АктВыполненныхРабот Тогда
		
		СписокСпособовОбработки.Добавить("ПоступлениеУслугРабот", НСтр("ru = 'Поступление услуг, работ'"), Истина);
		
	ИначеЕсли ВидЭД = ТипыДокументов.ТоварнаяНакладная Тогда
		
		СписокСпособовОбработки.Добавить("ЭлектронныйДокументПоставщика", НСтр("ru = 'Поступление товаров, работ, услуг и прочего (Электронный документ поставщика)'"), Истина);
		
	ИначеЕсли ВидЭД = ТипыДокументов.КорректировочныйСчетФактура
		Или ВидЭД = ТипыДокументов.СоглашениеОбИзмененииСтоимости Тогда
		
		СписокСпособовОбработки.Добавить("КорректировочныйСчетФактураПолученный", НСтр("ru = 'Корректировочный счет-фактура полученный'"),Истина);
		
	ИначеЕсли ВидЭД = ТипыДокументов.СчетФактура Тогда
		
		СписокСпособовОбработки.Добавить("СчетФактураПолученный", НСтр("ru = 'Счет-фактура полученный'"), Истина);
		
	ИначеЕсли ВидЭД = ТипыДокументов.СчетНаОплату Тогда
		
		СписокСпособовОбработки.Добавить("СчетНаОплатуОтПоставщика", НСтр("ru = 'Счет на оплату от поставщика'"), Истина);
		
	ИначеЕсли ВидЭД = ТипыДокументов.ОтветНаЗаказ Тогда
		
		СписокСпособовОбработки.Добавить("СчетНаОплатуОтПоставщика", НСтр("ru = 'Счет на оплату от поставщика'"), Истина);
		
	ИначеЕсли ВидЭД = ТипыДокументов.АктОРасхождениях Тогда
		
		СписокСпособовОбработки.Добавить("АктОРасхожденияхПолученный", НСтр("ru = 'Акт о расхождениях (полученный)'"), Истина);
		
	ИначеЕсли ВидЭД = ТипыДокументов.АктНаПередачуПрав Тогда
		
		СписокСпособовОбработки.Добавить("ЭлектронныйДокументПоставщика", НСтр("ru = 'Поступление товаров, работ, услуг и прочего (Электронный документ поставщика)'"), Истина);
		
	КонецЕсли;
	
КонецПроцедуры	

