Функция ПолучитьОписаниеРеквизитовСчетаФактурыУПД_5_03(ОбщиеПараметры)
	
	ОписаниеРеквизитовДокумента = НовыйОписаниеРеквизитовДокументаУПД_5_03();
	
	ОписаниеРеквизитовДокумента.ПутьКТабЧастиНФА = "Объект.СоставНФА";
	
	ТипСчетаФактуры = ТипЗнч(ОбщиеПараметры.СсылкаНаОбъект);
	
	// Имена реквизитов, отличные от значений по умолчанию.
	Если ТипСчетаФактуры = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		ОписаниеРеквизитовДокумента.ИменаРеквизитовШапки.ВалютаНаименование = "ВалютаНаименованиеПолное";
		ОписаниеРеквизитовДокумента.ИменаРеквизитовШапки.Курс = "ВалютаКурс";
		
	ИначеЕсли ТипСчетаФактуры = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный") Тогда
		ОписаниеРеквизитовДокумента.ИменаРеквизитовШапки.ВалютаНаименование = "НаименованиеВалюты";
		ОписаниеРеквизитовДокумента.ИменаРеквизитовШапки.ВалютаКод = "КодВалюты";
	КонецЕсли;
	
	Возврат ОписаниеРеквизитовДокумента;
	
КонецФункции

Функция	НовыйОписаниеРеквизитовДокументаУПД_5_03()
	
	ОписаниеРеквизитовДокумента = Новый Структура("ПутьКТабЧастиНФА,ИменаРеквизитовШапки,ИменаКолонокТабЧастиНФА");
	
	// Значения по умолчанию.
	ИменаРеквизитовШапки = Новый Структура();
	ИменаРеквизитовШапки.Вставить("ВалютаНаименование",	"ВалютаНаименование");
	ИменаРеквизитовШапки.Вставить("ВалютаКод",			"ВалютаКод");
	ИменаРеквизитовШапки.Вставить("Курс",				"Курс");
	
	ОписаниеРеквизитовДокумента.ИменаРеквизитовШапки = ИменаРеквизитовШапки;
	
	// Значения по умолчанию.
	ИменаКолонокТабЧастиНФА = Новый Структура();
	ИменаКолонокТабЧастиНФА.Вставить("НФА",								"НФА");
	ИменаКолонокТабЧастиНФА.Вставить("Всего",							"Всего");
	ИменаКолонокТабЧастиНФА.Вставить("РНПТ",							"РНПТ");
	ИменаКолонокТабЧастиНФА.Вставить("ЕдиницаИзмеренияКод",				"ЕдиницаИзмеренияКод");
	ИменаКолонокТабЧастиНФА.Вставить("ЕдиницаИзмеренияНаименование",	"ЕдиницаИзмеренияНаименование");
	ИменаКолонокТабЧастиНФА.Вставить("СодержаниеУслуги",				"СодержаниеУслуги");
	
	ОписаниеРеквизитовДокумента.ИменаКолонокТабЧастиНФА = ИменаКолонокТабЧастиНФА;
	
	Возврат ОписаниеРеквизитовДокумента;
	
КонецФункции

Процедура НастроитьСтатусФормируемогоУПДПриВыгрузкеВФайлУПД_5_03(СтрокаПараметров, Организация, Контрагент)
	
	Если НастройкиЭДО.ЕстьНастройкиОтправки(Организация, Контрагент) Тогда
		Возврат; // Применяется настройка электронного обмена с контрагентом.
	КонецЕсли;
	
	Если УПДФормироватьСтатус1ПриОтсутствииНастройкиЭДО(Организация) Тогда
		Возврат; // УПД статуса 1 формируется по умолчанию.
	КонецЕсли;
	
	// Такая настройка воспринимается БЭД как указание формировать УПД статуса 2.
	СтрокаПараметров.ФормированиеУниверсальногоДокумента = ОбменСКонтрагентами.ВариантыФормированияУниверсальныхДокументов().Запрещено;
	
КонецПроцедуры

