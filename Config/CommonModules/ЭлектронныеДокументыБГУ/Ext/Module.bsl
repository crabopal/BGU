				ДокументОбъект.УстановитьНовыйНомер();
			КонецЕсли;
			ДокументОбъект.Записать(РежимЗаписи);
			ВозвращаемоеЗначение = ДокументОбъект.Ссылка;
		Иначе // если функция вызвана из формы "Обработки.ЭлектронныеДокументы.ФормаЗагрузкиПросмотраЭД"
			ВозвращаемоеЗначение = ДокументОбъект;
		КонецЕсли;
	Исключение
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Заполнение документа на основе ЭД. %1'"), Текст);
		ЗаписьЖурналаРегистрации(ТекстСообщения, УровеньЖурналаРегистрации.Ошибка, ДокументОбъект.Метаданные(), СсылкаНаВладельца,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение(Текст);
	КонецПопытки;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// Поиск и создание счетов-фактур полученных и исправительных счетов-фактур полученных
//
Функция НайтиСоздатьСчетФактуру(СтрокаДляЗагрузки, ДеревоРазбора, СсылкаНаВладельца = Неопределено, Записывать = Истина)
	Перем Текст, ДокументОбъект;
	
	ВозвращаемоеЗначение = Неопределено;
	
	ДанныеДляЗагрузки = ПодготовитьСтруктуруДляСчетФактуры(СтрокаДляЗагрузки, ДеревоРазбора);
	
	Попытка
		Если ДанныеДляЗагрузки.Шапка.Свойство("Исправление") И ДанныеДляЗагрузки.Шапка.Исправление Тогда
			ВозвращаемоеЗначение = ЗаполнитьИсправительныйСчетФактуру(СсылкаНаВладельца, ДанныеДляЗагрузки, Записывать, Текст, ДокументОбъект);
		ИначеЕсли ДанныеДляЗагрузки.Шапка.Свойство("Корректировочный") И ДанныеДляЗагрузки.Шапка.Корректировочный Тогда
			ВозвращаемоеЗначение = ЗаполнитьКорректировочныйСчетФактуру(СсылкаНаВладельца, ДанныеДляЗагрузки, Записывать, Текст, ДокументОбъект);
		Иначе	
			ВозвращаемоеЗначение = ЗаполнитьСчетФактуру(СсылкаНаВладельца, ДанныеДляЗагрузки, Записывать, Текст, ДокументОбъект);
		КонецЕсли;	
	Исключение
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Заполнение документа на основе ЭД. %1'"), Текст);
		ЗаписьЖурналаРегистрации(ТекстСообщения, УровеньЖурналаРегистрации.Ошибка, ДокументОбъект.Метаданные(), СсылкаНаВладельца,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение(Текст);
	КонецПопытки;
	
	Возврат ВозвращаемоеЗначение;

КонецФункции

// Поиск и создание документа "Счет на оплату от поставщика"
//
Функция НайтиСоздатьСчетНаОплатуОтПоставщика(СтрокаДляЗагрузки, ДеревоРазбора, СсылкаНаВладельца = Неопределено, Записывать = Истина, ПараметрыДляОтраженияВУчете = Неопределено)
	
	ВозвращаемоеЗначение = Неопределено;
	
	ДанныеДляЗагрузки = ПодготовитьСтруктуруДляСчетНаОплатуОтПоставщика(СтрокаДляЗагрузки, ДеревоРазбора);
	
	Если ДанныеДляЗагрузки.Свойство("Шапка") Тогда
		ДанныеЗаполнения = ДанныеДляЗагрузки.Шапка;
	КонецЕсли;
	
	РежимЗаписи = РежимЗаписиДокумента.Запись;
	Попытка
		Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
			ДокументОбъект = СсылкаНаВладельца.ПолучитьОбъект();
			Если ДокументОбъект.Проведен Тогда
				Текст = НСтр("ru = 'Операция возможна только для непроведенных документов!'");
			КонецЕсли;
		Иначе
			УстановитьПривилегированныйРежим(Истина);
			ДокументОбъект = Документы.СчетНаОплатуОтПоставщика.СоздатьДокумент();
			ДокументОбъект.Дата = ТекущаяДатаСеанса();
			ДокументОбъект.Заполнить(ДанныеЗаполнения);
		КонецЕсли;
		
		ДокументОбъект.ТипФорматаЭД = 0;
		
		Если ДанныеЗаполнения.Свойство("Организация") Тогда
			ДокументОбъект.Организация = ДанныеЗаполнения.Организация;
		КонецЕсли;	
		Если ДанныеЗаполнения.Свойство("СуммаИтог") Тогда
			ДокументОбъект.СуммаДокумента = ДанныеЗаполнения.СуммаИтог;
		КонецЕсли;	
		Если ДанныеЗаполнения.Свойство("СуммаНалогаИтог") Тогда
			ДокументОбъект.СуммаНалогаИтог = ДанныеЗаполнения.СуммаНалогаИтог;
		КонецЕсли;	
		Если ДанныеЗаполнения.Свойство("ЦенаВключаетНДС") Тогда
			ДанныеЗаполнения.ЦенаВключаетНДС = ДанныеЗаполнения.ЦенаВключаетНДС;
		КонецЕсли;	
		Если ДанныеЗаполнения.Свойство("Валюта") Тогда
			ДокументОбъект.ВалютаДокумента = ДанныеЗаполнения.Валюта;
		КонецЕсли;	
		Если ДанныеЗаполнения.Свойство("НазначениеПлатежа") Тогда
			ДокументОбъект.НазначениеПлатежа = ДанныеЗаполнения.НазначениеПлатежа;
		КонецЕсли;
		
		ПерезаполнениеЗначенийРеквизитовШапки(ДокументОбъект, ДанныеЗаполнения);
		
		ДокументОбъект.ОбменДанными.Загрузка = Истина;
		ДокументОбъект.ДополнительныеСвойства.Вставить("ЕстьСоглашение", Истина);
		ДокументОбъект.ДополнительныеСвойства.Вставить("ПроцессыОбработкиДокументов_ЗаписатьБезПроверкиОбменДаннымиЗагрузка", Истина);
		Если Записывать Тогда
			Если НЕ ЗначениеЗаполнено(ДокументОбъект.Номер) Тогда
				ДокументОбъект.УстановитьНовыйНомер();
			КонецЕсли;
			ДокументОбъект.Записать(РежимЗаписи);
			ВозвращаемоеЗначение = ДокументОбъект.Ссылка;
		Иначе // если функция вызвана из формы "Обработки.ЭлектронныеДокументы.ФормаЗагрузкиПросмотраЭД"
			ВозвращаемоеЗначение = ДокументОбъект;
		КонецЕсли;
	Исключение
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Заполнение документа на основе ЭД. %1'"), Текст);
		ЗаписьЖурналаРегистрации(ТекстСообщения, УровеньЖурналаРегистрации.Ошибка, ДокументОбъект.Метаданные(), СсылкаНаВладельца,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение(Текст);
	КонецПопытки;
	
	Если ЗначениеЗаполнено(ПараметрыДляОтраженияВУчете) Тогда
		ЗаписатьПрисоединенныеФайлыКДокументуЧерезСервисShare(ДокументОбъект.Ссылка, ПараметрыДляОтраженияВУчете);
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

// Заполняет данные грузополучателя и грузоотправителя
//
// Участник - ссылка на организацию (Контрагенты, Организации)
// ВидУчастника - Строка. "Исполнитель", "Заказчик" и т.п. Наименование ветки в дереве данных
Процедура ЗаполнитьДанныеГрузополучателяГрузоотправителя(Участник, ВидУчастника, ДатаДанных, ДеревоДанных, ПараметрыУчастниковСФ = Неопределено)
	
	Если ПараметрыУчастниковСФ = Неопределено Тогда
		Если НЕ ЗначениеЗаполнено(Участник) Тогда
			Если ВидУчастника = "Грузоотправитель" Тогда
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОГрузоотправителе.ОнЖе", Истина);
			КонецЕсли;
			
			Возврат;
		КонецЕсли;
	Иначе
		Если ВидУчастника = "Грузоотправитель" Тогда
			Если СокрЛП(ПараметрыУчастниковСФ.Продавец.Наименование) = СокрЛП(ПараметрыУчастниковСФ.Грузоотправитель.Наименование) Тогда
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОГрузоотправителе.ОнЖе", Истина);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Префикс = "";
	Если ВидУчастника = "Грузоотправитель" Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОГрузоотправителе.Грузоотправитель", Истина);
		Префикс = "СведенияОГрузоотправителе.";
	КонецЕсли;	
	
	СведенияОбУчастнике = Новый Структура;
	ПолучитьДанныеЮрФизЛица(Участник, СведенияОбУчастнике, ДатаДанных);
	
	Если СведенияОбУчастнике.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
		Если ПараметрыУчастниковСФ = Неопределено Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Префикс + ВидУчастника + ".Наименование.НаименованиеОрганизации", СведенияОбУчастнике.ОфициальноеНаименование);
		Иначе
			Если ВидУчастника = "Грузоотправитель" Тогда
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Префикс + ВидУчастника + ".Наименование.НаименованиеОрганизации", ПараметрыУчастниковСФ.Грузоотправитель.Наименование);
			Иначе	
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Префикс + ВидУчастника + ".Наименование.НаименованиеОрганизации", ПараметрыУчастниковСФ.Грузополучатель.Наименование);
			КонецЕсли;
		КонецЕсли;
	Иначе	
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Префикс + ВидУчастника + ".Наименование.ФИОИП.Фамилия", СведенияОбУчастнике.Фамилия);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Префикс + ВидУчастника + ".Наименование.ФИОИП.Имя", СведенияОбУчастнике.Имя);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Префикс + ВидУчастника + ".Наименование.ФИОИП.Отчество", СведенияОбУчастнике.Отчество);
	КонецЕсли;	
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Участник", Участник);
	
	Если ПараметрыУчастниковСФ = Неопределено Тогда
		АдресУчастникаСтрокой = "";
		ПолучитьАдресСтруктурой(СтруктураПараметров, "Участник", "Юр");
		АдресУчастника = СтруктураПараметров.СтруктураАдреса;
		АдресУчастникаСтрокой = СтруктураПараметров.СтруктураАдреса.АдрТекст;
		АдресВСвободнойФорме = АдресЮридическийУКонтрагентаВСвободнойФорме(Участник);
		
		Если ЗначениеЗаполнено(АдресВСвободнойФорме.АдресТекст) Тогда
			АдресУчастника = АдресВСвободнойФорме;
			
			ТипАдреса = "Произвольный";
			СтруктураПараметров.Вставить("ТипАдреса", ТипАдреса);
					
			ТекВидУчастника = Префикс + ВидУчастника;
			ЗаполнитьАдресВДереве(ДеревоДанных, АдресУчастника, СтруктураПараметров.ТипАдреса, ТекВидУчастника);
		Иначе	
			Если ЗначениеЗаполнено(АдресУчастникаСтрокой) Тогда
				Если (СтрДлина(АдресУчастника.Кварт)>20) ИЛИ (СтрДлина(АдресУчастника.Корпус)>20) Тогда
					ТипАдреса = "Произвольный";
					СтруктураПараметров.Вставить("ТипАдреса", ТипАдреса);
					
					ТекВидУчастника = Префикс + ВидУчастника;
					ЗаполнитьАдресВДереве(ДеревоДанных, АдресУчастника, СтруктураПараметров.ТипАдреса, ТекВидУчастника);
				Иначе	
					ТипАдреса = "Структурированный";
					СтруктураПараметров.Вставить("ТипАдреса", ТипАдреса);
					
					ТекВидУчастника = Префикс + ВидУчастника;
					ЗаполнитьАдресВДереве(ДеревоДанных, АдресУчастника, СтруктураПараметров.ТипАдреса, ТекВидУчастника);
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;
	Иначе	
		АдресУчастника = "";
		
		ТипАдреса = "Произвольный";
		СтруктураПараметров.Вставить("ТипАдреса", ТипАдреса);
		
		ТекВидУчастника = Префикс + ВидУчастника;
		ЗаполнитьАдресВДереве(ДеревоДанных, АдресУчастника, СтруктураПараметров.ТипАдреса, ТекВидУчастника);
	КонецЕсли;	
КонецПроцедуры	

