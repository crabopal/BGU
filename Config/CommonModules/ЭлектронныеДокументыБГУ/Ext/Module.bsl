Процедура ОбработкаЗаполненияЭТрН(ДокументОбъект, ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка) Экспорт
	Если НЕ ЗначениеЗаполнено(ДанныеЗаполнения) Тогда
		Возврат;
	КонецЕсли; 

	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12")
		ИЛИ ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ПередачаОбъектовОС") Тогда
		ЗаполнитьЗначенияСвойств(ДокументОбъект, ЭлектронныеДокументыБГУВызовСервера.ДанныеЗаполненияЭТрН(ДанныеЗаполнения));
		
		НоваяСтрока = ДокументОбъект.ДокументыОснования.Добавить();
		НоваяСтрока.ДокументОснование = ДанныеЗаполнения;
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(ДокументОбъект, ДанныеЗаполнения);
	КонецЕсли; 
	
КонецПроцедуры

