		ТЗ.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
		
		ТЗ.Колонки.Добавить("СуммаУменьшение", Новый ОписаниеТипов("Число"));
		ТЗ.Колонки.Добавить("СуммаУвеличение", Новый ОписаниеТипов("Число"));
		
		ТЗ.Колонки.Добавить("СуммаНДСУменьшение", Новый ОписаниеТипов("Число"));
		ТЗ.Колонки.Добавить("СуммаНДСУвеличение", Новый ОписаниеТипов("Число"));
		
		ТЗ.Колонки.Добавить("ВсегоУвеличение", Новый ОписаниеТипов("Число"));
		ТЗ.Колонки.Добавить("ВсегоУменьшение", Новый ОписаниеТипов("Число"));
		
		ТЗ.Колонки.Добавить("СуммаНДСДоИзменения", Новый ОписаниеТипов("Число"));
		ТЗ.Колонки.Добавить("СуммаНДС", Новый ОписаниеТипов("Число"));
		
		ТЗ.Колонки.Добавить("ВсегоДоИзменения", Новый ОписаниеТипов("Число"));
		ТЗ.Колонки.Добавить("Всего", Новый ОписаниеТипов("Число"));
		
		ТЗ.Колонки.Добавить("Счет30304");
		ТЗ.Колонки.Добавить("НДСКВычету");
		
		ТЗ.Колонки.Добавить("ВсегоУвеличение", Новый ОписаниеТипов("Число"));
		ТЗ.Колонки.Добавить("ВсегоУменьшение", Новый ОписаниеТипов("Число"));
		ТЗ.Колонки.Добавить("СуммаНДСкВычету", Новый ОписаниеТипов("Число"));
		ТЗ.Колонки.Добавить("СуммаНДСкВосстановлению", Новый ОписаниеТипов("Число"));
		ТЗ.Колонки.Добавить("СтавкаНДС");
		
		Для каждого СтрокаТЧ из МассивСтрок Цикл
			НоваяСтрока = ТЗ.Добавить();
			Для каждого СтрокаРеквизита из СтрокаТЧ.Строки Цикл
				Если СтрокаРеквизита.Реквизит = "НомСтр" Тогда
					НоваяСтрока.НомерСтроки = СтрокаРеквизита.ЗначениеРеквизита;
				ИначеЕсли СтрокаРеквизита.Реквизит = "ИД" Тогда
					Номенклатура = НайтиСсылкуНаНоменклатуруПоИдентификаторуНоменклатурыПоставщика(СтрокаРеквизита.ЗначениеРеквизита);
				ИначеЕсли СтрокаРеквизита.Реквизит = "ОКЕИ_ТовПосле" Тогда
					НоваяСтрока.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду(СтрокаРеквизита.ЗначениеРеквизита);
				ИначеЕсли СтрокаРеквизита.Реквизит = "КолТовПосле" Тогда
					НоваяСтрока.Количество = СтрокаРеквизита.ЗначениеРеквизита;
				ИначеЕсли СтрокаРеквизита.Реквизит = "СтТовБезНДСПослеИзм" Тогда
					НоваяСтрока.Сумма = СтрокаРеквизита.ЗначениеРеквизита;
				ИначеЕсли СтрокаРеквизита.Реквизит = "СтТовБезНДСДоИзм" Тогда
					НоваяСтрока.СуммаДоИзменения = СтрокаРеквизита.ЗначениеРеквизита;
				ИначеЕсли СтрокаРеквизита.Реквизит = "СумНДСДо" Тогда
