Процедура ПолучитьСведенияИзФайлаПрикладногоЭлектронногоДокумента(ДанныеФайла, ПараметрыЗаполнения, ДанныеДокумента) Экспорт
	Если ПараметрыЗаполнения.ПрикладнойТипДокумента 
		 = Перечисления.ПрикладныеВидыЭлектронныхДокументовБГУ.Извещение Тогда 
		ПространствоИменФормата = "ON_BGU_IZV";
		ПолучитьСведенияИзФайлаПрикладногоЭлектронногоДокументаИзвещения(ДанныеФайла, ПараметрыЗаполнения, ДанныеДокумента, ПространствоИменФормата);
	ИначеЕсли ПараметрыЗаполнения.ПрикладнойТипДокумента 
		 = Перечисления.ПрикладныеВидыЭлектронныхДокументовБГУ.АктОПриемеПередачеОбъектовНФА Тогда 
		ПространствоИменФормата = ПространствоИменФорматаАктаОПриемеПередачеНФА0510448();
		ПолучитьСведенияИзФайлаПрикладногоЭлектронногоДокументаАктаОПриемеПередачеНФА(ДанныеФайла, ПараметрыЗаполнения, ДанныеДокумента, ПространствоИменФормата);
	Иначе	
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПолучитьСведенияИзФайлаПрикладногоЭлектронногоДокументаИзвещения(ДанныеФайла, ПараметрыЗаполнения, ДанныеДокумента, ПространствоИменФормата) Экспорт
	ТипПрикладногоДокумента = "";
	ЗаполнятьСодержимоеФайлов = ПараметрыЗаполнения.ЗаполнятьСодержимоеФайлов;
	
	Поток = ДанныеФайла.ОткрытьПотокДляЧтения();
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьПоток(Поток);
	
	ПостроительDOM = Новый ПостроительDOM;
	ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
	ЧтениеXML.Закрыть();
	Поток.Закрыть();
	
	ДокументDOM.ЭлементДокумента.УстановитьСоответствиеПространстваИмен("", ПространствоИменФормата);
	
	Поток = Новый ПотокВПамяти;
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьПоток(Поток);
	
	ЗаписьDOM = Новый ЗаписьDOM;
	ЗаписьDOM.Записать(ДокументDOM, ЗаписьXML);
	ЗаписьXML.Закрыть();
	
	Поток.Перейти(0, ПозицияВПотоке.Начало);
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьПоток(Поток);
	
	ФайлXDTO = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML, ФабрикаXDTO.Тип(ПространствоИменФормата, "Файл"));
	
	ЧтениеXML.Закрыть();
	Поток.Закрыть();
	
	ДокументXDTO = ФайлXDTO.Документ;
	
	ТипИзвещения = Число(ДокументXDTO.ТипИзвещения);
	
	ДанныеДокумента.Вставить("ЭлектронныеПодписи", ПараметрыЗаполнения.ЭлектронныеПодписи);	
	
	Если (ПараметрыЗаполнения.ПрикладнойТипДокумента = Перечисления.ПрикладныеВидыЭлектронныхДокументовБГУ.Извещение) Тогда
		
		ДатаДокумента = СтроковыеФункцииКлиентСервер.СтрокаВДату(ДокументXDTO.Дата);
		
		СтруктураДанныхЗаголовка = Новый Структура;
		СтруктураДанныхЗаголовка.Вставить("Номер", ДокументXDTO.Номер);
		СтруктураДанныхЗаголовка.Вставить("Дата", ДатаДокумента);
		Если ОтправительИзвещенияЯвляетсяПолучателемОбъектовПередачи(ТипИзвещения) Тогда
			СтруктураДанныхЗаголовка.Вставить("пНаименованиеПолучатель", ДокументXDTO.Отправитель[0].Наим);
			СтруктураДанныхЗаголовка.Вставить("ИННПолучатель", ДокументXDTO.Отправитель[0].СвЮЛ.ИНН);
			СтруктураДанныхЗаголовка.Вставить("КПППолучатель", ДокументXDTO.Отправитель[0].СвЮЛ.КПП);
			СтруктураДанныхЗаголовка.Вставить("пКодОКПОПолучатель", ДокументXDTO.Отправитель[0].СвЮЛ.ОКПО);
			СтруктураДанныхЗаголовка.Вставить("пКодГлавыПолучатель", ДокументXDTO.Отправитель[0].СвЮЛ.КодПоБК);
			
			СтруктураДанныхЗаголовка.Вставить("пНаименованиеОтправитель", ДокументXDTO.Получатель[0].Наим);
			СтруктураДанныхЗаголовка.Вставить("ИННОтправитель", ДокументXDTO.Получатель[0].СвЮЛ.ИНН);
			СтруктураДанныхЗаголовка.Вставить("КППОтправитель", ДокументXDTO.Получатель[0].СвЮЛ.КПП);
			СтруктураДанныхЗаголовка.Вставить("пКодОКПООтправитель", ДокументXDTO.Получатель[0].СвЮЛ.ОКПО);
			СтруктураДанныхЗаголовка.Вставить("пКодГлавыОтправитель", ДокументXDTO.Получатель[0].СвЮЛ.КодПоБК);
		Иначе	
			СтруктураДанныхЗаголовка.Вставить("пНаименованиеОтправитель", ДокументXDTO.Отправитель[0].Наим);
			СтруктураДанныхЗаголовка.Вставить("ИННОтправитель", ДокументXDTO.Отправитель[0].СвЮЛ.ИНН);
			СтруктураДанныхЗаголовка.Вставить("КППОтправитель", ДокументXDTO.Отправитель[0].СвЮЛ.КПП);
			СтруктураДанныхЗаголовка.Вставить("пКодОКПООтправитель", ДокументXDTO.Отправитель[0].СвЮЛ.ОКПО);
			СтруктураДанныхЗаголовка.Вставить("пКодГлавыОтправитель", ДокументXDTO.Отправитель[0].СвЮЛ.КодПоБК);
			
			СтруктураДанныхЗаголовка.Вставить("пНаименованиеПолучатель", ДокументXDTO.Получатель[0].Наим);
			СтруктураДанныхЗаголовка.Вставить("ИННПолучатель", ДокументXDTO.Получатель[0].СвЮЛ.ИНН);
			СтруктураДанныхЗаголовка.Вставить("КПППолучатель", ДокументXDTO.Получатель[0].СвЮЛ.КПП);
			СтруктураДанныхЗаголовка.Вставить("пКодОКПОПолучатель", ДокументXDTO.Получатель[0].СвЮЛ.ОКПО);
			СтруктураДанныхЗаголовка.Вставить("пКодГлавыПолучатель", ДокументXDTO.Получатель[0].СвЮЛ.КодПоБК);
		КонецЕсли;
		
		СтруктураДанныхЗаголовка.Вставить("ИННОтправительДляПроверки", ДокументXDTO.Отправитель[0].СвЮЛ.ИНН);
		СтруктураДанныхЗаголовка.Вставить("ИННПолучательДляПроверки", ДокументXDTO.Получатель[0].СвЮЛ.ИНН);
		СтруктураДанныхЗаголовка.Вставить("ТипИзвещения", ТипИзвещения);
		
		Если ОтправительИзвещенияЯвляетсяПолучателемОбъектовПередачи(ТипИзвещения, Истина) Тогда
			Если ОтправительИзвещенияЯвляетсяПолучателемОбъектовПередачи(ТипИзвещения) Тогда
				СтруктураДанныхЗаголовка.Вставить("ИННПолучатель", ДокументXDTO.Отправитель[0].СвЮЛ.КодПоРПБС);
				СтруктураДанныхЗаголовка.Вставить("ИННОтправитель", ДокументXDTO.Получатель[0].СвЮЛ.КодПоРПБС);
			ИначеЕсли ОтправительОтветногоИзвещенияЯвляетсяОтправителемОбъектовПередачи(ТипИзвещения, Истина) Тогда
				СтруктураДанныхЗаголовка.Вставить("ИННОтправитель", ДокументXDTO.Отправитель[0].СвЮЛ.КодПоРПБС);
				СтруктураДанныхЗаголовка.Вставить("ИННПолучатель", ДокументXDTO.Получатель[0].СвЮЛ.КодПоРПБС);
			КонецЕсли;
		КонецЕсли;
		
		ДанныеДокумента.ДанныеЗаголовка = СтруктураДанныхЗаголовка;
		
		Если ЗначениеЗаполнено(ДокументXDTO.Пояснение) Тогда
			СтруктураДанныхПояснения = Новый Структура;
			СтруктураДанныхПояснения.Вставить("ПояснениеМБТ", ДокументXDTO.Пояснение);
			
			ДанныеДокумента.ДанныеПояснения = СтруктураДанныхПояснения;
		КонецЕсли;
		
		ОборотыВЖурналОпераций = Новый ТаблицаЗначений;
		ОборотыВЖурналОпераций.Колонки.Добавить("пДебетСчетОтправитель", Новый ОписаниеТипов("Строка"));
		ОборотыВЖурналОпераций.Колонки.Добавить("пКредитСчетОтправитель", Новый ОписаниеТипов("Строка"));
		ОборотыВЖурналОпераций.Колонки.Добавить("пДебетСчетПолучатель", Новый ОписаниеТипов("Строка"));
		ОборотыВЖурналОпераций.Колонки.Добавить("пКредитСчетПолучатель", Новый ОписаниеТипов("Строка"));
		ОборотыВЖурналОпераций.Колонки.Добавить("пСуммаОтправитель", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
		ОборотыВЖурналОпераций.Колонки.Добавить("пСуммаПолучатель", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
		
		НомерПоПорядку = 0;
		пИтогоСумма = 0;
		Для Каждого СтрокаТаблицыXDTO Из ДокументXDTO.Таблица[0].ПередаваемыеПроводки Цикл
			НомерПоПорядку = НомерПоПорядку + 1;
			НомерПоПорядкуИзЭД = 0;
			Если ЗначениеЗаполнено(СтрокаТаблицыXDTO.НомерПоПорядку) Тогда
				НомерПоПорядкуИзЭД = Число(СтрокаТаблицыXDTO.НомерПоПорядку);
			КонецЕсли;
			
			ДобавитьПроводкуИзвещения(ДанныеДокумента.ТаблицаПроводок, ОборотыВЖурналОпераций,
				СтрокаТаблицыXDTO, пИтогоСумма, , , ТипИзвещения, ?(НомерПоПорядкуИзЭД = 0, НомерПоПорядку, НомерПоПорядкуИзЭД),
				ПараметрыЗаполнения.СодержаниеБезНомераПроводки);
		КонецЦикла;
		
		ОборотыВЖурналОпераций.Свернуть("пДебетСчетОтправитель, пКредитСчетОтправитель, пДебетСчетПолучатель, пКредитСчетПолучатель", "пСуммаОтправитель, пСуммаПолучатель");
		
		ДанныеДокумента.ТаблицаОборотыВЖурналОпераций = ОборотыВЖурналОпераций;
		
		РекомендуемыеПроводкиОбороты = Новый ТаблицаЗначений;
		РекомендуемыеПроводкиОбороты.Колонки.Добавить("пДебетСчетОтправитель", Новый ОписаниеТипов("Строка"));
		РекомендуемыеПроводкиОбороты.Колонки.Добавить("пКредитСчетОтправитель", Новый ОписаниеТипов("Строка"));
		РекомендуемыеПроводкиОбороты.Колонки.Добавить("пДебетСчетПолучатель", Новый ОписаниеТипов("Строка"));
		РекомендуемыеПроводкиОбороты.Колонки.Добавить("пКредитСчетПолучатель", Новый ОписаниеТипов("Строка"));
		РекомендуемыеПроводкиОбороты.Колонки.Добавить("пСуммаОтправитель", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
		РекомендуемыеПроводкиОбороты.Колонки.Добавить("пСуммаПолучатель", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
		
		пИтогоРекомендуемаяСумма = 0;
		Для Каждого СтрокаТаблицыРекПроводокXDTO Из ДокументXDTO.Таблица[0].РекомендуемыеПроводки Цикл
			НомерПоПорядкуИзЭД = Число(СтрокаТаблицыРекПроводокXDTO.НомерПоПорядку);
			
			ДобавитьРекомендуемуюПроводкуИзвещения(ДанныеДокумента.ТаблицаРекомендуемыхПроводок, РекомендуемыеПроводкиОбороты,
				СтрокаТаблицыРекПроводокXDTO, пИтогоРекомендуемаяСумма, ТипИзвещения, НомерПоПорядкуИзЭД);
		КонецЦикла;	
		
		ДанныеДокумента.ТаблицаРекомендуемыеОборотыВЖурналОпераций = РекомендуемыеПроводкиОбороты;
		
		СтруктураОбластьМакетаПодвал = Новый Структура("пФИОРуководительОтправитель,пФИОБухгалтерОтправитель,пКоличествоПриложений, 
		|ФИОИсполнительОтправитель, ДолжностьИсполнительОтправитель, ТелефонИсполнительОтправитель, ЭлАдресИсполнительОтправитель,
		| пФИОРуководительПолучатель, пФИОБухгалтерПолучатель, ФИОИсполнительПолучатель, ДолжностьИсполнительПолучатель,
		| ТелефонИсполнительПолучатель, ЭлАдресИсполнительПолучатель");
		
		пКоличествоПриложений = Строка(ДокументXDTO.КоличествоПриложДок);
		СтруктураОбластьМакетаПодвал.пКоличествоПриложений = ?(пКоличествоПриложений = "0", "", пКоличествоПриложений);
		
		ФамилияРуководитель = ДокументXDTO.Получить("Руководитель/Фамилия");
		ИмяРуководитель = ДокументXDTO.Получить("Руководитель/Имя");
		ОтчествоРуководитель = ДокументXDTO.Получить("Руководитель/Отчество");
		пФИОРуководитель = "";
		Если ЗначениеЗаполнено(ИмяРуководитель) Тогда
			пФИОРуководитель = Сред(ИмяРуководитель, 1, 1)+".";		
		КонецЕсли;	
		Если ЗначениеЗаполнено(ОтчествоРуководитель) Тогда
			пФИОРуководитель = пФИОРуководитель + " " + Сред(ОтчествоРуководитель, 1, 1)+".";
		КонецЕсли;	
		Если ЗначениеЗаполнено(ФамилияРуководитель) Тогда
			пФИОРуководитель = пФИОРуководитель + " " + ФамилияРуководитель;
		КонецЕсли;
		
		Если ОтправительИзвещенияЯвляетсяПолучателемОбъектовПередачи(ТипИзвещения) Тогда
			СтруктураОбластьМакетаПодвал.пФИОРуководительПолучатель = пФИОРуководитель;
		Иначе
			СтруктураОбластьМакетаПодвал.пФИОРуководительОтправитель = пФИОРуководитель;
		КонецЕсли;
		
		ФамилияБухгалтер = ДокументXDTO.Получить("ГлавныйБухгалтер/Фамилия");
		ИмяБухгалтер = ДокументXDTO.Получить("ГлавныйБухгалтер/Имя");
		ОтчествоБухгалтер = ДокументXDTO.Получить("ГлавныйБухгалтер/Отчество");
		пФИОБухгалтер = "";
		Если ЗначениеЗаполнено(ИмяБухгалтер) Тогда
			пФИОБухгалтер = Сред(ИмяБухгалтер, 1, 1)+".";		
		КонецЕсли;	
		Если ЗначениеЗаполнено(ОтчествоБухгалтер) Тогда
			пФИОБухгалтер = пФИОБухгалтер + " " + Сред(ОтчествоБухгалтер, 1, 1)+".";
		КонецЕсли;	
		Если ЗначениеЗаполнено(ФамилияБухгалтер) Тогда
			пФИОБухгалтер = пФИОБухгалтер + " " + ФамилияБухгалтер;
		КонецЕсли;
		
		Если ОтправительИзвещенияЯвляетсяПолучателемОбъектовПередачи(ТипИзвещения) Тогда
			СтруктураОбластьМакетаПодвал.пФИОБухгалтерПолучатель = пФИОБухгалтер;
		Иначе	
			СтруктураОбластьМакетаПодвал.пФИОБухгалтерОтправитель = пФИОБухгалтер;
		КонецЕсли;
		
		ДолжностьИсполнитель = ДокументXDTO.Получить("Исполнитель/Должность");
		ФамилияИсполнитель = ДокументXDTO.Получить("Исполнитель/Фамилия");
		ИмяИсполнитель = ДокументXDTO.Получить("Исполнитель/Имя");
		ОтчествоИсполнитель = ДокументXDTO.Получить("Исполнитель/Отчество");
		
		КонтактыИсполнителя = ДокументXDTO.Получить("Исполнитель/Контакт");
		Если КонтактыИсполнителя = Неопределено Тогда
			ЭлектронныйАдресИсполнитель = "";
			ТелефонИсполнитель = "";
		Иначе	
			ЭлектронныйАдресИсполнитель = ДокументXDTO.Получить("Исполнитель/Контакт/ЭлектронныйАдрес");
			ТелефонИсполнитель = ДокументXDTO.Получить("Исполнитель/Контакт/Телефон");
		КонецЕсли;
		
		ФИОИсполнитель = "";
		Если ЗначениеЗаполнено(ИмяИсполнитель) Тогда
			ФИОИсполнитель = Сред(ИмяИсполнитель, 1, 1)+".";		
		КонецЕсли;	
		Если ЗначениеЗаполнено(ОтчествоИсполнитель) Тогда
			ФИОИсполнитель = ФИОИсполнитель + " " + Сред(ОтчествоИсполнитель, 1, 1)+".";
		КонецЕсли;	
		Если ЗначениеЗаполнено(ФамилияИсполнитель) Тогда
			ФИОИсполнитель = ФИОИсполнитель + " " + ФамилияИсполнитель;
		КонецЕсли;
		
		Если ОтправительИзвещенияЯвляетсяПолучателемОбъектовПередачи(ТипИзвещения) Тогда
			СтруктураОбластьМакетаПодвал.ФИОИсполнительПолучатель = ДолжностьИсполнитель;
			СтруктураОбластьМакетаПодвал.ФИОИсполнительПолучатель = ФИОИсполнитель;
			СтруктураОбластьМакетаПодвал.ЭлАдресИсполнительПолучатель = ЭлектронныйАдресИсполнитель;
			СтруктураОбластьМакетаПодвал.ТелефонИсполнительПолучатель = ТелефонИсполнитель;
		Иначе	
			СтруктураОбластьМакетаПодвал.ДолжностьИсполнительОтправитель = ДолжностьИсполнитель;
			СтруктураОбластьМакетаПодвал.ФИОИсполнительОтправитель = ФИОИсполнитель;
			СтруктураОбластьМакетаПодвал.ЭлАдресИсполнительОтправитель = ЭлектронныйАдресИсполнитель;
			СтруктураОбластьМакетаПодвал.ТелефонИсполнительОтправитель = ТелефонИсполнитель;
		КонецЕсли;	
		
		ДанныеДокумента.ДанныеПодвал = СтруктураОбластьМакетаПодвал;
		
		ЕстьПередачаЭлектроннымАктом = Ложь;
		
		//документы поставщика/передачи
		ТаблицаДанныеДокументыПоставщика = ПустыеДанныеФорматаЭлектронногоИзвещения("ДокументПоставщика");
		
		Для Каждого СтрокаДокументыПоставщика Из ДокументXDTO.ДокументыПоставщика Цикл
			ТаблицаДанныеНоменклатурыДокументовПоставщика = ПустыеДанныеФорматаЭлектронногоИзвещения("НоменклатураДокументаПоставщика");
			
			ТаблицаСведенияОПрослеживаемости = ПустыеДанныеФорматаЭлектронногоИзвещения("СведенияОПрослеживаемостиДокументаПоставщика"); 
			
			НовыйДок = ТаблицаДанныеДокументыПоставщика.Добавить();
			ЗаполнитьЗначенияСвойств(НовыйДок, СтрокаДокументыПоставщика);
			НовыйДок.ДатаДокумента = СтроковыеФункцииКлиентСервер.СтрокаВДату(СтрокаДокументыПоставщика.Дата);
			НовыйДок.НомерДокумента = СокрЛП(СтрокаДокументыПоставщика.Номер);
			Если НЕ ЗначениеЗаполнено(НовыйДок.НФАПереданыЭлектроннымАктом) Тогда
				НовыйДок.НФАПереданыЭлектроннымАктом = Ложь;
			КонецЕсли;
			
			Если НовыйДок.НФАПереданыЭлектроннымАктом Тогда 
				ЕстьПередачаЭлектроннымАктом = Истина;
			КонецЕсли;
			
			СуммаДокумента = 0;
			Если ЗначениеЗаполнено(СтрокаДокументыПоставщика.СуммаДокумента) Тогда
				СуммаДокумента = Число(СтрокаДокументыПоставщика.СуммаДокумента);
			КонецЕсли;
			НовыйДок.СуммаДокумента = СуммаДокумента;
			
			Для Каждого СтрокаНоменклатурыПоставщика Из СтрокаДокументыПоставщика.СписокНоменклатурыПоставщика Цикл
				НоваяНоменклатура = ТаблицаДанныеНоменклатурыДокументовПоставщика.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяНоменклатура, СтрокаНоменклатурыПоставщика);
				
				Если ЗначениеЗаполнено(СтрокаНоменклатурыПоставщика.ДатаВводаВЭксплуатацию) Тогда
					ДатаВводаВЭксплуатацию = СтроковыеФункцииКлиентСервер.СтрокаВДату(СтрокаНоменклатурыПоставщика.ДатаВводаВЭксплуатацию);
				Иначе
					ДатаВводаВЭксплуатацию = Дата(1,1,1);
				КонецЕсли;
				
				НоваяНоменклатура.ДатаВводаВЭксплуатацию = ДатаВводаВЭксплуатацию;
				
				НоваяНоменклатура.СтавкаНДС = ПолучитьСтавкуНДСПеречислением(СтрокаНоменклатурыПоставщика.СтавкаНДС);
				ПрослеживаемыйТовар = ?(СтрокаНоменклатурыПоставщика.ПрослеживаемыйТовар = "Да", Истина, Ложь);
				НоваяНоменклатура.ПрослеживаемыйТовар = ПрослеживаемыйТовар;
				ГрупповойУчет = ?(СтрокаНоменклатурыПоставщика.ГрупповойУчет = "Да", Истина, Ложь);
				НоваяНоменклатура.ГрупповойУчет = ГрупповойУчет;

				Количество = 0;
				Если ЗначениеЗаполнено(СтрокаНоменклатурыПоставщика.Количество) Тогда
					Количество = Число(СтрокаНоменклатурыПоставщика.Количество);
				КонецЕсли;	
				НоваяНоменклатура.Количество = Количество;

				Цена = 0;
				Если ЗначениеЗаполнено(СтрокаНоменклатурыПоставщика.Цена) Тогда
					Цена = Число(СтрокаНоменклатурыПоставщика.Цена);
				КонецЕсли;	
				НоваяНоменклатура.Цена = Цена;

				СуммаНДС = 0;
				Если ЗначениеЗаполнено(СтрокаНоменклатурыПоставщика.СуммаНДС) Тогда
					СуммаНДС = Число(СтрокаНоменклатурыПоставщика.СуммаНДС);
				КонецЕсли;	
				НоваяНоменклатура.СуммаНДС = СуммаНДС;
				
				Всего = 0;
				Если ЗначениеЗаполнено(СтрокаНоменклатурыПоставщика.Всего) Тогда
					Всего = Число(СтрокаНоменклатурыПоставщика.Всего);
				КонецЕсли;	
				НоваяНоменклатура.Всего = Всего;

				СуммаАмортизации = 0;
				Если ЗначениеЗаполнено(СтрокаНоменклатурыПоставщика.СуммаАмортизации) Тогда
					СуммаАмортизации = Число(СтрокаНоменклатурыПоставщика.СуммаАмортизации);
				КонецЕсли;	
				НоваяНоменклатура.СуммаАмортизации = СуммаАмортизации;
				
				СуммаОбесценения = 0;
				Если ЗначениеЗаполнено(СтрокаНоменклатурыПоставщика.СуммаОбесценения) Тогда
					СуммаОбесценения = Число(СтрокаНоменклатурыПоставщика.СуммаОбесценения);
				КонецЕсли;	
				НоваяНоменклатура.СуммаОбесценения = СуммаОбесценения;
			КонецЦикла;
			
			Если ЗначениеЗаполнено(СтрокаДокументыПоставщика.СведенияОПрослеживаемости) Тогда
				Для Каждого СтрокаСведенийОПрослеживаемости Из СтрокаДокументыПоставщика.СведенияОПрослеживаемости Цикл
					НовыеСведенияОПрослеживаемости = ТаблицаСведенияОПрослеживаемости.Добавить();
					ЗаполнитьЗначенияСвойств(НовыеСведенияоПрослеживаемости, СтрокаСведенийОПрослеживаемости);
					
					КоличествоУчетное = 0;
					Если ЗначениеЗаполнено(СтрокаСведенийОПрослеживаемости.КоличествоУчетное) Тогда
						КоличествоУчетное = Число(СтрокаСведенийОПрослеживаемости.КоличествоУчетное);
					КонецЕсли;
					НовыеСведенияОПрослеживаемости.КоличествоУчетное = КоличествоУчетное;
					
					Количество = 0;
					Если ЗначениеЗаполнено(СтрокаСведенийОПрослеживаемости.Количество) Тогда
						Количество = Число(СтрокаСведенийОПрослеживаемости.Количество);
					КонецЕсли;
					НовыеСведенияОПрослеживаемости.Количество = Количество;

					Сумма = 0;
					Если ЗначениеЗаполнено(СтрокаСведенийОПрослеживаемости.Сумма) Тогда
						Сумма = Число(СтрокаСведенийОПрослеживаемости.Сумма);
					КонецЕсли;
					НовыеСведенияОПрослеживаемости.Сумма = Сумма;
				КонецЦикла;
			КонецЕсли;
			НовыйДок.НоменклатураДокумента = ТаблицаДанныеНоменклатурыДокументовПоставщика;
			НовыйДок.СведенияОПрослеживаемости = ТаблицаСведенияОПрослеживаемости;
		КонецЦикла;
		ДанныеДокумента.Вставить("ДокументыПередачиОтПоставщика", ТаблицаДанныеДокументыПоставщика);	
		ДанныеДокумента.Вставить("ЕстьПередачаЭлектроннымАктом", ЕстьПередачаЭлектроннымАктом);	
		
		Для Каждого СтрокаТаблицыXDTO Из ДокументXDTO.Таблица[0].ФайлыПриложений Цикл
			НоваяСтрока = ДанныеДокумента.ФайлыПриложений.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицыXDTO);
			НоваяСтрока.ВидСведений = ВидСведенийИзвещения(СтрокаТаблицыXDTO.КодВидаСведений);
			Если ЗаполнятьСодержимоеФайлов Тогда
				НоваяСтрока.СодержимоеФайла = СтрокаТаблицыXDTO.СодержимоеФайла;
			КонецЕсли;	
		КонецЦикла;
		
		//доп.сведения
		Если НЕ ПараметрыЗаполнения.СкрыватьДопДанные Тогда
			ЕстьСписокДокументовПоставщика = Ложь;
			ЕстьСписокНФА = Ложь;
			
			Если ТипЗнч(ДокументXDTO.Таблица[0].Приложения) = Тип("СписокXDTO") Тогда
				Если ДокументXDTO.Таблица[0].Приложения.Количество()>0 Тогда
					ЕстьСписокДокументовПоставщика = Истина;
				КонецЕсли;	
			КонецЕсли;	
			Если ТипЗнч(ДокументXDTO.Таблица[0].ПередаваемаяНоменклатура) = Тип("СписокXDTO") Тогда
				Если ДокументXDTO.Таблица[0].ПередаваемаяНоменклатура.Количество()>0 Тогда
					ЕстьСписокНФА = Истина;
				КонецЕсли;	
			КонецЕсли;	
			
			Если ЕстьСписокДокументовПоставщика Тогда
				сч = 0;
				Для Каждого СтрокаТаблицыДокументовXDTO Из ДокументXDTO.Таблица[0].Приложения Цикл
					сч = сч + 1;
					СтруктураОбластьМакетаСтрокаПриложения = Новый Структура;
					СтруктураОбластьМакетаСтрокаПриложения.Вставить("НомерПриложения", Строка(сч));
					СтруктураОбластьМакетаСтрокаПриложения.Вставить("НаименованиеДокПриложения", СтрокаТаблицыДокументовXDTO.ВидДокумента);
					СтруктураОбластьМакетаСтрокаПриложения.Вставить("НомерДокПриложения", СтрокаТаблицыДокументовXDTO.Номер);
					СтруктураОбластьМакетаСтрокаПриложения.Вставить("ДатаДокПриложения", СтрокаТаблицыДокументовXDTO.Дата);
					
					НовПриложение = ДанныеДокумента.ТаблицаДанныеПриложения.Добавить();
					ЗаполнитьЗначенияСвойств(НовПриложение, СтруктураОбластьМакетаСтрокаПриложения);
				КонецЦикла;
			КонецЕсли;
			
			Если ЕстьСписокНФА Тогда
				сч = 0;
				Для Каждого СтрокаТаблицыНФАXDTO Из ДокументXDTO.Таблица[0].ПередаваемаяНоменклатура Цикл
					сч = сч + 1;
					СтруктураОбластьМакетаСтрокаСписокНФА = Новый Структура;
					СтруктураОбластьМакетаСтрокаСписокНФА.Вставить("НомерНФА", Строка(сч));
					НаименованиеНФАИЕдиница = "";
					Если ЗначениеЗаполнено(СтрокаТаблицыНФАXDTO.ЕдИзмНаим) Тогда
						НаименованиеНФАИЕдИзм = СтрокаТаблицыНФАXDTO.ПолноеНаимНоменклатуры + ", " + СтрокаТаблицыНФАXDTO.ЕдИзмНаим;
					Иначе
						НаименованиеНФАИЕдИзм = СтрокаТаблицыНФАXDTO.ПолноеНаимНоменклатуры;
					КонецЕсли;	
					СтруктураОбластьМакетаСтрокаСписокНФА.Вставить("НаименованиеНФА", НаименованиеНФАИЕдИзм);
					СтруктураОбластьМакетаСтрокаСписокНФА.Вставить("КоличествоНФА", СтрокаТаблицыНФАXDTO.Количество);
					СтруктураОбластьМакетаСтрокаСписокНФА.Вставить("СуммаНФА", СтрокаТаблицыНФАXDTO.Сумма);
					СтруктураОбластьМакетаСтрокаСписокНФА.Вставить("ТипНФА", СтрокаТаблицыНФАXDTO.ТипСправочника);
					СтруктураОбластьМакетаСтрокаСписокНФА.Вставить("GUIDИнвентарногоНомера", СтрокаТаблицыНФАXDTO.GUIDИнвентарногоНомера);
					СтруктураОбластьМакетаСтрокаСписокНФА.Вставить("GUIDНоменклатуры", СтрокаТаблицыНФАXDTO.GUIDНоменклатуры);
					СтруктураОбластьМакетаСтрокаСписокНФА.Вставить("GUIDНоменклатурыОтправителя", СтрокаТаблицыНФАXDTO.GUIDНоменклатурыОтправителя);
					СтруктураОбластьМакетаСтрокаСписокНФА.Вставить("ИнвентарныйНомерУОтправителя", СтрокаТаблицыНФАXDTO.ИнвентарныйНомерУОтправителя);
					
					НовНоменклатура = ДанныеДокумента.ТаблицаНоменклатуры.Добавить();
					ЗаполнитьЗначенияСвойств(НовНоменклатура, СтруктураОбластьМакетаСтрокаСписокНФА);
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	
	КонецЕсли;	
КонецПроцедуры

Процедура ДобавитьПроводкуИзвещения(ТаблицаПроводок, ОборотыВЖурналОпераций, ПередаваемыеПроводки, 
	пИтогоСумма, ИзвещениеПолучателя = Ложь, пИтогоСуммаПолучателя = 0, ТипИзвещения, НомерПоПорядку = 0, 
	СодержаниеБезНомераПроводки = Ложь)
	
	ПредставлениеСчетаДт = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1.%2.%3.%4'"),
		ПередаваемыеПроводки.КПСДт, ПередаваемыеПроводки.КФО, ПередаваемыеПроводки.СчетДт, ПередаваемыеПроводки.КЭКДт);
	
