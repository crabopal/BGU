// Выполняется при поиске номенклатуры информационной базы по идентификатору.
// Если при формировании электронного документа для сопоставления номенклатуры заполняется идентификатор без использования
// автоматической генерации с помощью библиотеки, то в данном методе необходимо описать алгоритм обратного получения данных
// информационной базы из идентификатора.
//
// Параметры:
//  Идентификатор - Строка - идентификатор, по которому нужно определить номенклатуру ИБ.
//  НоменклатураИБ - Структура - результаты поиска номенклатуры ИБ по идентификатору.
//                               См. ОбменСКонтрагентамиКлиентСервер.НоваяНоменклатураИнформационнойБазы.
Процедура ПриПоискеНоменклатурыПоИдентификатору(Знач Идентификатор, НоменклатураИБ) Экспорт
	
КонецПроцедуры

// Создает номенклатуру информационной базы по данным контрагента.
//
// Параметры:
//  НаборНоменклатурыКонтрагентов - Массив - данные контрагента для заполнения нового элемента. 
//                                      См. СопоставлениеНоменклатурыКонтрагентовКлиентСервер.
//  Результат - Массив - результат создания номенклатуры. Элементы представлены структурой:
//   * НоменклатураКонтрагента - Структура - номенклатура контрагента, по которой создавалась номенклатура ИБ (элемент параметра НаборНоменклатурыКонтрагентов)
//   * НоменклатураИБ - Структура - созданная номенклатура ИБ. См. ОбменСКонтрагентамиКлиентСервер.НоваяНоменклатураИнформационнойБазы.
//
Процедура ПриСозданииНоменклатурыПоДаннымКонтрагента(Знач НаборНоменклатурыКонтрагентов, Результат) Экспорт
	
	Если НаборНоменклатурыКонтрагентов.Количество()>0 Тогда
		СтруктураНоменклатуры = Новый Структура;
		СтруктураНоменклатурыИБ = Новый Структура;
		
		НоваяНоменклатура = Справочники.Номенклатура.СоздатьЭлемент();
		НоваяНоменклатура.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.ПрочиеМЗ;
		НоваяНоменклатура.Наименование = НаборНоменклатурыКонтрагентов[0].Наименование;
		НоваяНоменклатура.НаименованиеПолное = НаборНоменклатурыКонтрагентов[0].Наименование;
		НоваяНоменклатура.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.НайтиПоНаименованию(НаборНоменклатурыКонтрагентов[0].ЕдиницаИзмерения);
		НоваяНоменклатура.Записать();
		
		СтруктураНоменклатуры.Вставить("НоменклатураКонтрагента", НаборНоменклатурыКонтрагентов[0]);
		
		СтруктураНоменклатурыИБ.Вставить("Номенклатура", НоваяНоменклатура.Ссылка);
		СтруктураНоменклатурыИБ.Вставить("Характеристика", "");
		СтруктураНоменклатурыИБ.Вставить("Упаковка", "");
		
		СтруктураНоменклатуры.Вставить("НоменклатураИБ", СтруктураНоменклатурыИБ);
		
		Результат.Добавить(СтруктураНоменклатуры);
	КонецЕсли;
	
КонецПроцедуры
	
// См. ОбменСКонтрагентамиПереопределяемый.ПриПолученииОписанияОснованияЭлектронногоДокумента.
Процедура ПриПолученииОписанияОснованияЭлектронногоДокумента(ОснованиеОбъект, Описание, СтандартнаяОбработка) Экспорт
	
	ТипОснования = ТипЗнч(ОснованиеОбъект);
	Если ТипОснования = Тип("ДокументОбъект.СчетФактураВыданный") Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Описание.Организация = ОснованиеОбъект.Организация;
		Описание.Контрагент  = ОснованиеОбъект.Контрагент;
		Описание.Дата  = ОснованиеОбъект.Дата;
		Описание.Номер = ОснованиеОбъект.Номер;
		Описание.СуммаДокумента = ОснованиеОбъект.СуммаДокумента;
		Описание.Вид = СтрШаблон(НСтр("ru = '%1 (%2)'"),
			ОснованиеОбъект.ВидЦенности, ОснованиеОбъект.ПричинаНалогообложения);
	ИначеЕсли ТипОснования = Тип("ДокументОбъект.КорректировочныйСчетФактураВыданный") Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Описание.Организация = ОснованиеОбъект.Организация;
		Описание.Контрагент  = ОснованиеОбъект.Контрагент;
		Описание.Дата  = ОснованиеОбъект.Дата;
		Описание.Номер = ОснованиеОбъект.Номер;
		Если ОснованиеОбъект.ВсегоУвеличение > 0 Тогда
			Описание.СуммаДокумента = ОснованиеОбъект.ВсегоУвеличение;
		Иначе
			Описание.СуммаДокумента = ОснованиеОбъект.ВсегоУменьшение;
		КонецЕсли;
		Описание.Вид = СтрШаблон(НСтр("ru = '%1 (%2)'"),
			ОснованиеОбъект.ВидЦенности, ОснованиеОбъект.ПричинаНалогообложения);
		
	ИначеЕсли ТипОснования = Тип("ДокументОбъект.ИсправительныйСчетФактураВыданный") Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Описание.Организация = ОснованиеОбъект.Организация;
		Описание.Контрагент  = ОснованиеОбъект.Контрагент;
		Описание.Дата  = ОснованиеОбъект.Дата;
		Описание.Номер = ОснованиеОбъект.Номер;
		Описание.СуммаДокумента = ОснованиеОбъект.СуммаДокумента;
		Описание.Вид = СтрШаблон(НСтр("ru = '%1 (%2)'"),
			ОснованиеОбъект.ВидЦенности, ОснованиеОбъект.ПричинаНалогообложения);
	ИначеЕсли ТипОснования = Тип("ДокументОбъект.АктОРасхождениях") Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Описание.Организация = ОснованиеОбъект.Организация;
		Описание.Контрагент  = ОснованиеОбъект.Контрагент;
		Описание.Дата = ОснованиеОбъект.Дата;
		Описание.Номер = ОснованиеОбъект.Номер;
		Описание.СуммаДокумента = ОснованиеОбъект.СуммаДокумента;
		
	ИначеЕсли ТипОснования = Тип("ДокументОбъект.АктСверкиВзаиморасчетов") 
		Или ТипОснования = Тип("ДокументСсылка.АктСверкиВзаиморасчетов") Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Описание.Организация = ОснованиеОбъект.Организация;
		Описание.Контрагент  = ОснованиеОбъект.Контрагент;
		Описание.Дата = ОснованиеОбъект.Дата;
		Описание.Номер = ОснованиеОбъект.Номер;
		
	ИначеЕсли ТипОснования = Тип("СправочникОбъект.Договоры") 
		Или ТипОснования = Тип("СправочникСсылка.Договоры") Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Описание.Организация = ОснованиеОбъект.Организация;
		Описание.Контрагент  = ОснованиеОбъект.Контрагент;
		Описание.Дата = ОснованиеОбъект.ДатаДоговора;
		Описание.Номер = ОснованиеОбъект.НомерДоговора;
		
		ПараметрыДоговораДляЭДО = ПараметрыДоговораДляЭДО(ОснованиеОбъект.Ссылка);
		
		Если ЗначениеЗаполнено(ПараметрыДоговораДляЭДО) Тогда
			Описание.СуммаДокумента = ПараметрыДоговораДляЭДО.Сумма;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

Функция ФИОФЛ(ФЛ, ДатаСведений = Неопределено)
	Если ДатаСведений = Неопределено Тогда
		ДатаСведений = НачалоДня(ТекущаяДата());
	КонецЕсли;	
	
	Результат = Новый Структура;
	Результат.Вставить("Фамилия", "");
	Результат.Вставить("Имя", "");
	Результат.Вставить("Отчество", "");
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ФИОФизическихЛицСрезПоследних.Фамилия,
	|	ФИОФизическихЛицСрезПоследних.Имя,
	|	ФИОФизическихЛицСрезПоследних.Отчество
	|ИЗ
	|	РегистрСведений.ФИОФизическихЛиц.СрезПоследних(&Дата, ФизическоеЛицо = &ФизлицоСсылка) КАК ФИОФизическихЛицСрезПоследних");
	
	Запрос.УстановитьПараметр("Дата", ДатаСведений);
	Запрос.УстановитьПараметр("ФизлицоСсылка", ФЛ);
	
	ВыборкаФЛ = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаФЛ.Следующий() Тогда
		
		Результат.Фамилия = ВыборкаФЛ.Фамилия;
		Результат.Имя = ВыборкаФЛ.Имя;
		Результат.Отчество = ВыборкаФЛ.Отчество;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

Функция АдресЮридическийУКонтрагентаВСвободнойФорме(Контрагент)
	Результат = Новый Структура("КодСтраны, АдресТекст, АдрТекст, ТипАдреса", "", "", "", "");
	ВидАдреса = Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты;
	Если ТипЗнч(Контрагент) = Тип("СправочникСсылка.Организации") Тогда
		ВидАдреса = Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации;
	ИначеЕсли ТипЗнч(Контрагент) = Тип("СправочникСсылка.Контрагенты") Тогда
		Если Контрагент.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
			ВидАдреса = Справочники.ВидыКонтактнойИнформации.АдресПоПропискеФизическиеЛица;
		КонецЕсли;	
	КонецЕсли;	
	Результат.АдресТекст = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Контрагент, ВидАдреса);
	Результат.АдрТекст = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Контрагент, ВидАдреса);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	КонтрагентыКонтактнаяИнформация.Представление КАК Представление,
	               |	КонтрагентыКонтактнаяИнформация.Ссылка КАК Ссылка,
	               |	КонтрагентыКонтактнаяИнформация.Значение КАК Значение,
	               |	КонтрагентыКонтактнаяИнформация.Тип КАК Тип,
	               |	КонтрагентыКонтактнаяИнформация.Вид КАК Вид
	               |ИЗ
	               |	Справочник.Контрагенты.КонтактнаяИнформация КАК КонтрагентыКонтактнаяИнформация
	               |ГДЕ
	               |	КонтрагентыКонтактнаяИнформация.Ссылка = &Ссылка
	               |	И КонтрагентыКонтактнаяИнформация.Вид = &ВидКонтакта
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ОрганизацииКонтактнаяИнформация.Представление,
	               |	ОрганизацииКонтактнаяИнформация.Ссылка,
	               |	ОрганизацииКонтактнаяИнформация.Значение,
	               |	ОрганизацииКонтактнаяИнформация.Тип,
	               |	ОрганизацииКонтактнаяИнформация.Вид
	               |ИЗ
	               |	Справочник.Организации.КонтактнаяИнформация КАК ОрганизацииКонтактнаяИнформация
	               |ГДЕ
	               |	ОрганизацииКонтактнаяИнформация.Ссылка = &Ссылка
	               |	И ОрганизацииКонтактнаяИнформация.Вид = &ВидКонтакта";
	
	Запрос.УстановитьПараметр("Ссылка", Контрагент);
	Запрос.УстановитьПараметр("ВидКонтакта", ВидАдреса);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЮридическийАдресКонтрагента = Выборка.Значение;
		СтруктураЮридическогоАдреса = РаботаСАдресами.СведенияОбАдресе(ЮридическийАдресКонтрагента);
		Если СтруктураЮридическогоАдреса.ТипАдреса = "ВСвободнойФорме" Тогда
			Результат.КодСтраны = СтруктураЮридическогоАдреса.КодСтраны;
			Результат.АдресТекст = Выборка.Представление;
			Результат.АдрТекст = Выборка.Представление;
		КонецЕсли;	
		Результат.ТипАдреса = СтруктураЮридическогоАдреса.ТипАдреса;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Результат.КодСтраны) Тогда
		Результат.КодСтраны = "643";
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

Функция ОпределитьСчетФактуруПолученый(ДокументОбъект, Организация, НомерСчетаФактуры, ДатаСчетаФактуры, КорректировочныйСчетФактура = Истина)
