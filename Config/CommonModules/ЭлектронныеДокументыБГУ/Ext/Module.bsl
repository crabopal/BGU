		СведенияПредставленияВнутреннегоЭД = СведенияПредставленияВнутреннегоЭДПОД(ДокументУчета, ИдентификаторПечати, ДатаИсходящегоДокумента, НомерИсходящегоДокумента, Расширение);
	Иначе
		СведенияПредставленияВнутреннегоЭД = СведенияПредставленияВнутреннегоЭД(Шапка.Организация, ВнутреннийЭД, ДатаИсходящегоДокумента, НомерИсходящегоДокумента, Расширение);
	КонецЕсли;
	СтрокаТаблицыXDTO = СоздатьОбъектXDTO(ТаблицаXDTO, "ФайлыПредставленияАкта");
	СтрокаТаблицыXDTO.Установить("ИмяФайла", СведенияПредставленияВнутреннегоЭД.ИмяПриложенногоФайла);
	СтрокаТаблицыXDTO.Установить("КодВидаСведений", СведенияПредставленияВнутреннегоЭД.КодВидаСведений);
	СтрокаТаблицыXDTO.Установить("СодержимоеФайла", XMLСтрока(СведенияПредставленияВнутреннегоЭД.ТекстовоеСодержимое));
	
	ТаблицаXDTO.ФайлыПредставленияАкта.Добавить(СтрокаТаблицыXDTO);
		
	ДокументXDTO.ТабличныеСведения.Добавить(ТаблицаXDTO);
	
	ДокументXDTO.Установить("Пояснение", Шапка.Пояснение);
	
КонецПроцедуры

Функция НоменклатураПолучателяАкта0510448(Организация, НоменклатураОтправителя) Экспорт
	УстановитьПривилегированныйРежим(Истина);

	Результат = Справочники.Номенклатура.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СопоставлениеНоменклатурыБГУ.СоответствующаяНоменклатура КАК СоответствующаяНоменклатура
	|ИЗ
	|	РегистрСведений.СопоставлениеНоменклатурыБГУ КАК СопоставлениеНоменклатурыБГУ
	|ГДЕ
	|	СопоставлениеНоменклатурыБГУ.Организация = &Организация
	|	И СопоставлениеНоменклатурыБГУ.Номенклатура = &Номенклатура
	|	И СопоставлениеНоменклатурыБГУ.КодВидаСопоставления = &КодВидаСопоставления";
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Номенклатура", НоменклатураОтправителя);
	Запрос.УстановитьПараметр("КодВидаСопоставления", 1);
    Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.СоответствующаяНоменклатура;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Процедура КодВидаПередачиНФАДляАкта0510448(ДатаСведений, Организация, Контрагент, ПараметрыУчастников, Результат, ТекстОшибки) Экспорт
	
	Реквизиты = "ТипКонтрагента";
	ЗначенияРеквизитовКонтрагента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Контрагент, Реквизиты);
	ТипКонтрагента = ЗначенияРеквизитовКонтрагента.ТипКонтрагента;

	Реквизиты = "Код";
	ЗначенияРеквизитовТипаКонтрагента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТипКонтрагента, Реквизиты);

	Если НЕ ЗначениеЗаполнено(ЗначенияРеквизитовТипаКонтрагента.Код) Тогда
		Результат = "";
		ТекстОшибки = НСтр("ru='Не определен тип контрагента.'");
		
		Возврат;
	КонецЕсли;
	
	КодТипаКонтрагента = Число(ЗначенияРеквизитовТипаКонтрагента.Код);
	Если КодТипаКонтрагента > 2 Тогда
		Результат = "";
		ТекстОшибки = НСтр("ru='Тип контрагента должен быть ""1 - Участник бюджетного процесса"" 
		|или ""2 - Государственное (муниципальное) бюджетное (автономное) учреждение"".'");
		
		Возврат;
	КонецЕсли;

	ЗначенияРеквизитовУчетнойПолитики = Справочники.Организации.ПолучитьУчетнуюПолитику(
		Организация, ДатаСведений);
	
	ВидУчреждения = 0;
	Если ЗначенияРеквизитовУчетнойПолитики.ЭтоКазенноеУчреждение Тогда
		ВидУчреждения = 1; //КУ
	ИначеЕсли ЗначенияРеквизитовУчетнойПолитики.ЭтоАвтономноеУчреждение Тогда
		ВидУчреждения = 2; //АУ БУ
	ИначеЕсли ЗначенияРеквизитовУчетнойПолитики.ЭтоБюджетноеУчреждение Тогда
		ВидУчреждения = 2; //АУ БУ
	КонецЕсли;
	
	Если ВидУчреждения = 0 Тогда
		Результат = "";
		ТекстОшибки = НСтр("ru='Не определен вид учреждения (казенное/бюджетное/автономное).'");
		
		Возврат;
	КонецЕсли;	
	
	Если СокрЛП(ПараметрыУчастников.ОтправительИНН) = СокрЛП(ПараметрыУчастников.ПолучательИНН) Тогда
		РазличияИНН = 0;
	Иначе
		РазличияИНН = 1;
	КонецЕсли;	
	
	Если СокрЛП(ПараметрыУчастников.ОтправительГлава) = СокрЛП(ПараметрыУчастников.ПолучательГлава) Тогда
		РазличияГлава = 0;
	Иначе
		РазличияГлава = 1;
	КонецЕсли;	
	
	Если СокрЛП(ПараметрыУчастников.ОтправительБюджет) = СокрЛП(ПараметрыУчастников.ПолучательБюджет) Тогда
		РазличияБюджет = 0;
	Иначе
		РазличияБюджет = 1;
	КонецЕсли;	
	
	Если ВидУчреждения = 1 Тогда
		Если КодТипаКонтрагента = 1 Тогда
			Если РазличияГлава = 0 И РазличияБюджет = 0 И РазличияИНН = 0 Тогда			//3
				//КВНРК	КУ	Юр. лицо	1 - Участник бюджетного процесса	0	0	0	304.04
				Результат = "КВНРК";
			ИначеЕсли РазличияГлава = 0 И РазличияБюджет = 0 И РазличияИНН = 1 Тогда	//4   
				//КВВРК	КУ	Юр. лицо	1 - Участник бюджетного процесса	0	0	1	304.04
				Результат = "КВВРК";
			ИначеЕсли РазличияГлава = 1 И РазличияБюджет = 0 И РазличияИНН = 1 Тогда	//5   
				//КВБРК	КУ	Юр. лицо	1 - Участник бюджетного процесса	1	0	1	401.10
				Результат = "КВБРК";
			ИначеЕсли РазличияГлава = 1 И РазличияБюджет = 1 И РазличияИНН = 1 Тогда	//6   
				//КМБРК	КУ	Юр. лицо	1 - Участник бюджетного процесса	1	1	1	401.10
				Результат = "КМБРК";
			КонецЕсли;	
		ИначеЕсли КодТипаКонтрагента = 2 Тогда
			Если РазличияГлава = 0 И РазличияБюджет = 0 И РазличияИНН = 1 Тогда			//7
				//КВВРБ	КУ	Юр. лицо	2 - Государственное (муниципальное) бюджетное (автономное) учреждение	0	0	1	401.10
				Результат = "КВВРБ";
			ИначеЕсли РазличияГлава = 1 И РазличияБюджет = 0 И РазличияИНН = 1 Тогда	//8
				//КВБРБ	КУ	Юр. лицо	2 - Государственное (муниципальное) бюджетное (автономное) учреждение	1	0	1	401.10
				Результат = "КВБРБ";
			ИначеЕсли РазличияГлава = 1 И РазличияБюджет = 1 И РазличияИНН = 1 Тогда    //9
				//КМБРБ	КУ	Юр. лицо	2 - Государственное (муниципальное) бюджетное (автономное) учреждение	1	1	1	401.10
				Результат = "КМБРБ";
			КонецЕсли;
		КонецЕсли;	
	ИначеЕсли ВидУчреждения = 2 Тогда
		Если КодТипаКонтрагента = 2 Тогда
			Если РазличияГлава = 0 И РазличияБюджет = 0 И РазличияИНН = 0 Тогда			//10
				//БВНРБ	АУ БУ	Юр. лицо	2 - Государственное (муниципальное) бюджетное (автономное) учреждение	0	0	0	304.04
				Результат = "БВНРБ";
			ИначеЕсли РазличияГлава = 0 И РазличияБюджет = 0 И РазличияИНН = 1 Тогда	//11
				//БВВРБ	АУ БУ	Юр. лицо	2 - Государственное (муниципальное) бюджетное (автономное) учреждение	0	0	1	401.10
				Результат = "БВВРБ";
			ИначеЕсли РазличияГлава = 1 И РазличияБюджет = 0 И РазличияИНН = 1 Тогда	//13
				//БВБРБ	АУ БУ	Юр. лицо	2 - Государственное (муниципальное) бюджетное (автономное) учреждение	1	0	1	401.10
				Результат = "БВБРБ";
			ИначеЕсли РазличияГлава = 0 И РазличияБюджет = 0 И РазличияИНН = 1 Тогда	//15
				//БМБРБ	АУ БУ	Юр. лицо	2 - Государственное (муниципальное) бюджетное (автономное) учреждение	1	1	1	401.10
				Результат = "БМБРБ";
			КонецЕсли;
		ИначеЕсли КодТипаКонтрагента = 1 Тогда	
			Если РазличияГлава = 0 И РазличияБюджет = 0 И РазличияИНН = 1 Тогда			//12
				//БВВРК	АУ БУ	Юр. лицо	1 - Участник бюджетного процесса	0	0	1	401.10
				Результат = "БВВРК";
			ИначеЕсли РазличияГлава = 1 И РазличияБюджет = 0 И РазличияИНН = 1 Тогда	//14
				//БВБРК	АУ БУ	Юр. лицо	1 - Участник бюджетного процесса	1	0	1	401.10
				Результат = "БВБРК";
			ИначеЕсли РазличияГлава = 1 И РазличияБюджет = 1 И РазличияИНН = 1 Тогда	//16
				//БМБРК	АУ БУ	Юр. лицо	1 - Участник бюджетного процесса	1	1	1	401.10
				Результат = "БМБРК";
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры

Процедура ЗаполнитьСведенияОбУчетныхДанныхДляОтветногоАкта(ДокументПринятияКУчету, СведенияОбУчетныхДанных)

	Запрос = Новый Запрос;
	Если ТипЗнч(ДокументПринятияКУчету) = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовОС") Тогда     
    	ТекстЗапроса = "ВЫБРАТЬ
    	               |	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ПринятиеКУчетуОбъектовОСОсновныеСредства.ОсновноеСредство) КАК ИдентификаторОбъектаНФА,
