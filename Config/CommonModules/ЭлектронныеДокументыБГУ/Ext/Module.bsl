// Формирование данных для электронных документов

// Работа с деревом данных ФНС

// Подготавливает данные для электронного документа типа Торг12 титул продавца.
//
// Параметры:
//  СсылкаНаОбъект - документСсылка - ссылка на объект информационной базы,
//  по которому необходимо создать электронный документ.
//  СтруктураЭД - структура - структура данных для формирования электронного документа.
//  ДеревоДанных - дерево значений, дерево данных заполнения электронного документа.
//
Процедура ЗаполнитьДанныеПоТорг12ПродавецФНС(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ = Ложь) Экспорт
	НетЗамечанийКДокументу = Документы[СсылкаНаОбъект.Метаданные().Имя].ПредварительныйКонтрольДанныхДляЭД(СсылкаНаОбъект);
	
	Если НЕ НетЗамечанийКДокументу Тогда
		ОписаниеОшибки = НСтр("ru='Вышеуказанные ошибки препятствуют формированию электронного документа.
		|По этой причине и прочие данные документа не будут выгружены в ЭД.
		|После заполнения указанных реквизитов повторите попытку формирования электронного документа.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки);
		Отказ = Истина;
		Возврат;
	КонецЕсли;	
	
	ВалютаРегУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	ДанныеДляПечати = Документы[СсылкаНаОбъект.Метаданные().Имя].ПодготовитьДанныеДляЭД(СсылкаНаОбъект);
	
	ТипДокументаОснованияЭД = 1; //НакладнаяНаРеализациюТорг12
	Если ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ПередачаОбъектовОС") Тогда
		ТипДокументаОснованияЭД = 2;
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ПередачаОбъектовИК") Тогда
		ТипДокументаОснованияЭД = 3;
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.НакладнаяНаОтпускМ15") Тогда
		ТипДокументаОснованияЭД = 4;
	КонецЕсли;	
	
	РеквизитыШапки = ДанныеДляПечати[0].Выбрать();
	ТабличнаяЧасть = ДанныеДляПечати[1].Выгрузить();
	ТабличнаяЧасть.Колонки.Добавить("Сопоставление", Новый ОписаниеТипов("Структура"));

	ДобавитьИДНоменклатурыВТаблицу(ТабличнаяЧасть);
	
	Для каждого ТекСтр Из ТабличнаяЧасть Цикл
		ТекСтр.БазоваяЕдиницаКод = СокрЛП(ТекСтр.БазоваяЕдиницаКод);
	КонецЦикла;	
	
	РеквизитыШапки.Следующий();
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерТоварнойНакладной", НомерДляПечати(СсылкаНаОбъект, РеквизитыШапки.Номер));
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаТоварнойНакладной",  РеквизитыШапки.Дата);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснования", РеквизитыШапки.ДокументОснование);
	
	ДокументыОснования = Новый ТаблицаЗначений;
	ДокументыОснования.Колонки.Добавить("ДокОснованиеНаименование");
	ДокументыОснования.Колонки.Добавить("ДокОснованиеНомер");
	ДокументыОснования.Колонки.Добавить("ДокОснованиеДата");
	
	СтрокаДокументыОснования = ДокументыОснования.Добавить();
	СтрокаДокументыОснования.ДокОснованиеНаименование = РеквизитыШапки.ДокументОснованиеНаименование;
	СтрокаДокументыОснования.ДокОснованиеНомер = РеквизитыШапки.ДокументОснованиеНомер;
	СтрокаДокументыОснования.ДокОснованиеДата = РеквизитыШапки.ДокументОснованиеДата;
	
	// Обработка ошибки через механизм сообщений пользователю.
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ДокументыОснования,
		"ДокОснованиеДата", , ,
		НСтр("ru = 'Не заполнена дата договора для реквизита ""Договор"".'"));
	
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ДокументыОснования, "Основание");
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВидОперации", Перечисления.ВидыОперацийЭД.ПродажаКомиссия);
	Если Не ЗначениеЗаполнено(РеквизитыШапки.Валюта) Тогда
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
			"Объект.ВалютаДокумента");
	Иначе
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(РеквизитыШапки.Валюта, 
			"Объект.Код");
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаКод", РеквизитыШапки.ВалютаКод, ПараметрыОбработкиОшибок);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаНаименование", РеквизитыШапки.ВалютаНаименование, ПараметрыОбработкиОшибок);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВсегоПоНакладной.МассаНетто", ТабличнаяЧасть.Итог("МассаНетто"));
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВсегоПоНакладной.СуммаБезНДС", ТабличнаяЧасть.Итог("СуммаБезНДС"));
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВсегоПоНакладной.СуммаНДС", ТабличнаяЧасть.Итог("СуммаНДС"));
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВсегоПоНакладной.СуммаСНДС", ТабличнаяЧасть.Итог("СуммаСНДС"));
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументСделкиНаименование", РеквизитыШапки.ДокументОснованиеНаименование);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументСделкиНомер", РеквизитыШапки.ДокументОснованиеНомер);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументСделкиДата", РеквизитыШапки.ДокументОснованиеДата);
	
	Грузоотправитель = ?(ЗначениеЗаполнено(РеквизитыШапки.Грузоотправитель), РеквизитыШапки.Грузоотправитель, РеквизитыШапки.Организация);
	СчетГрузоотправителя = ?(ЗначениеЗаполнено(РеквизитыШапки.СчетГрузоотправителя), РеквизитыШапки.СчетГрузоотправителя, РеквизитыШапки.РеквизитыЛицевогоСчета);
	ЛСГрузоотправителя = ?(Грузоотправитель = РеквизитыШапки.Организация, РеквизитыШапки.ЛицевойСчет, Неопределено);
	
	Грузополучатель = ?(ЗначениеЗаполнено(РеквизитыШапки.Грузополучатель), РеквизитыШапки.Грузополучатель, РеквизитыШапки.Контрагент);
	СчетГрузополучателя = ?(ЗначениеЗаполнено(РеквизитыШапки.СчетГрузополучателя), РеквизитыШапки.СчетГрузополучателя, РеквизитыШапки.СчетПлательщика);
	
	ЗаполнитьДанныеУчастника(Грузоотправитель, "Грузоотправитель", РеквизитыШапки.Дата, ДеревоДанных, 
							 ЛСГрузоотправителя, СчетГрузоотправителя);
	ЗаполнитьДанныеУчастника(Грузополучатель, "Грузополучатель", РеквизитыШапки.Дата, ДеревоДанных,  
							СчетГрузополучателя);
	ЗаполнитьДанныеУчастника(РеквизитыШапки.Организация, "Поставщик", РеквизитыШапки.Дата, ДеревоДанных, 
							РеквизитыШапки.ЛицевойСчет, РеквизитыШапки.РеквизитыЛицевогоСчета);
							
	КонтрагентГоловнаяОрганизация = Справочники.Контрагенты.ПустаяСсылка();
	КонтрагентГоловнаяОрганизацияПредставление = "";
	КонтрагентГоловнаяОрганизацияИНН = "";
	Если РеквизитыШапки.КонтрагентОбособленноеПодразделение И ЗначениеЗаполнено(РеквизитыШапки.КонтрагентГоловнаяОрганизация) Тогда
		КонтрагентГоловнаяОрганизация = РеквизитыШапки.КонтрагентГоловнаяОрганизация;
		КонтрагентГоловнаяОрганизацияПредставление = РеквизитыШапки.КонтрагентГоловнаяОрганизацияПредставление;
		КонтрагентГоловнаяОрганизацияИНН = РеквизитыШапки.КонтрагентГоловнаяОрганизацияИНН;
	КонецЕсли;
							
	ЗаполнитьДанныеУчастника(РеквизитыШапки.Контрагент, "Плательщик", РеквизитыШапки.Дата, ДеревоДанных, РеквизитыШапки.СчетПлательщика,,,,,, 
		КонтрагентГоловнаяОрганизация, КонтрагентГоловнаяОрганизацияПредставление, КонтрагентГоловнаяОрганизацияИНН);
	
	СведенияОСоставителе = Новый Структура;
	ПолучитьДанныеЮрФизЛица(РеквизитыШапки.Организация, СведенияОСоставителе);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"НаименованиеСоставителяДокумента", СведенияОСоставителе.ПолноеНаименование);
							
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияПоОтпускуГруза.ДатаОтпуска", РеквизитыШапки.Дата);
							
	ТабличнаяЧасть.Колонки.Добавить("ДопДанныеПодписанные");
	ТабличнаяЧасть.Колонки.Добавить("ДопДанныеНеПодписанные");
	ТабличнаяЧасть.Колонки.Добавить("СтавкаНДСЧислом");
	Для Каждого СтрокаТовары Из ТабличнаяЧасть Цикл
		СтрокаТовары.СтавкаНДСЧислом = УчетНДСКлиентСервер.ПолучитьМножительСтавки(СтрокаТовары.СтавкаНДС,, Истина, Истина);
		
		Сопоставление = Новый Структура;
		Сопоставление.Вставить("Наименование", СтрокаТовары.НаименованиеНоменклатуры);
		Сопоставление.Вставить("ЕдиницаИзмерения", СтрокаТовары.ЕдиницаИзмеренияНаименование);
		Сопоставление.Вставить("Артикул", "");
		
		ХарактеристикаНаименование = "";
		Сопоставление.Вставить("Характеристика", ХарактеристикаНаименование);
		ШтрихкодыТовара = "";
		Сопоставление.Вставить("Штрихкод", ШтрихкодыТовара);
		УпаковкаИБ = "";
		
		Сопоставление.Вставить("НоменклатураИБ", СтрокаТовары.Номенклатура);
		Сопоставление.Вставить("ХарактеристикаИБ", ХарактеристикаНаименование);
		Сопоставление.Вставить("УпаковкаИБ", УпаковкаИБ);
		
		СтрокаТовары.Сопоставление = Сопоставление;
		
	КонецЦикла;
	
	// Обработка ошибки через механизм сообщений пользователю.
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТабличнаяЧасть,
		"НаименованиеНоменклатуры", , ,
		НСтр("ru = 'Не указано наименование товара в табличной части.'"));
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТабличнаяЧасть,
		"Количество", , , 
		НСтр("ru = 'Не указано количество товара в табличной части.'"));
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТабличнаяЧасть,
		"Цена", , ,
		НСтр("ru = 'Не указана цена товара в табличной части.'"));
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТабличнаяЧасть,
		"СуммаБезНДС", , ,
		НСтр("ru = 'Не указана сумма товара в табличной части.'"));
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТабличнаяЧасть,
		"СуммаНДС", , ,
		НСтр("ru = 'Не указана ставка НДС товара в табличной части.'"));
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТабличнаяЧасть,
		"СуммаСНДС", , ,
		НСтр("ru = 'Не указана сумма НДС товара в табличной части.'"));
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТабличнаяЧасть,
		"ЕдиницаИзмеренияНаименование", , ,
		НСтр("ru = 'Не заполнена наименование единицы измерения товара в табличной части.'"));
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТабличнаяЧасть,
		"БазоваяЕдиницаКод", , ,
		НСтр("ru = 'Не заполнен код единицы измерения товара в табличной части.'"));
	
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТабличнаяЧасть, "ТаблицаТоваров");

КонецПроцедуры

// Подготавливает данные для электронного документа типа Торг12 титул покупателя.
//
// Параметры:
//  СсылкаНаЭД   - Ссылка на ЭД, по которому необходимо сформировать электронный документ,
//  СтруктураЭД - Структура, структура данных для формирования электронного документа.
//  ДеревоДанных - дерево значений, дерево данных заполнения электронного документа.
//
Процедура ЗаполнитьДанныеПоТорг12ПокупательФНС(СсылкаНаЭД, ДеревоДанных, Отказ = Ложь) Экспорт
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаПолученияГруза", ТекущаяДатаСеанса());
	
КонецПроцедуры

Функция ПодготовитьТаблицуДанныхДоговора(Знач Наименование, Знач Номер, Знач Дата)
	
	ТаблицаДанныхДоговора = Новый ТаблицаЗначений;
	ТаблицаДанныхДоговора.Колонки.Добавить("ДокОснованиеНаименование");
	ТаблицаДанныхДоговора.Колонки.Добавить("ДокОснованиеНомер");
	ТаблицаДанныхДоговора.Колонки.Добавить("ДокОснованиеДата");
	
	Если Не ЗначениеЗаполнено(Наименование) Тогда
		Возврат ТаблицаДанныхДоговора; // возвращаем пустую таблицу
	КонецЕсли;
	
	НоваяСтрока = ТаблицаДанныхДоговора.Добавить();
	НоваяСтрока.ДокОснованиеНаименование = Наименование;
	НоваяСтрока.ДокОснованиеНомер        = Номер;
	НоваяСтрока.ДокОснованиеДата         = Дата;
	
	Возврат ТаблицаДанныхДоговора;
	
КонецФункции

// Подготавливает данные титула исполнителя для электронного документа типа Акт выполненных работ
// формата 5.01.
//
// Параметры:
//  СсылкаНаОбъект - ДокументСсылка, ссылка на объект информационной базы, по которому необходимо создать электронный документ.
//  СтруктураЭД - Структура, структура данных для формирования электронного документа.
//  ДеревоДанных - дерево значений, дерево данных заполнения электронного документа.
//
Процедура ЗаполнитьДанныеПоАкт501ИсполнительФНС(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ = Ложь) Экспорт
	НетЗамечанийКДокументу = Документы[СсылкаНаОбъект.Метаданные().Имя].ПредварительныйКонтрольДанныхДляЭД(СсылкаНаОбъект);
	
	Если НЕ НетЗамечанийКДокументу Тогда
		ОписаниеОшибки = НСтр("ru='Вышеуказанные ошибки препятствуют формированию электронного документа.
		|По этой причине и прочие данные документа не будут выгружены в ЭД.
		|После заполнения указанных реквизитов повторите попытку формирования электронного документа.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки);
		Отказ = Истина;
		Возврат;
	КонецЕсли;	
	
	ДанныеДляЭД = Документы[СсылкаНаОбъект.Метаданные().Имя].ПодготовитьДанныеДляЭД(СсылкаНаОбъект);
	Если ДанныеДляЭД.Шапка.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	
	
	Шапка    = ДанныеДляЭД.Шапка[0];
	ТабличнаяЧасть = ДанныеДляЭД.ТабЧасть;
	ТабличнаяЧасть.Колонки.Добавить("Сопоставление", Новый ОписаниеТипов("Структура"));
	
	ДобавитьИДНоменклатурыВТаблицу(ТабличнаяЧасть);
	
	ОрганизацияСоставитель = Шапка.Организация;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерАкта", НомерДляПечати(СсылкаНаОбъект, Шапка.НомерАкта));
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаАкта",  Шапка.ДатаАкта);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВидОперации", Шапка.ВидОперации);
	
	НаименованиеПервичногоДокумента = НаименованиеЭлектронногоАктаОбОказанииУслуг(Шапка.Организация);
	Если НЕ ЗначениеЗаполнено(НаименованиеПервичногоДокумента) Тогда
		НаименованиеПервичногоДокумента = НСтр("ru = 'Акт об оказании услуг'");
	КонецЕсли;
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НаименованиеПервичногоДокумента", НаименованиеПервичногоДокумента);
	
	ДанныеОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Шапка.Договор,
		"НомерДоговора, ДатаДоговора, ВидОбязательства");
	Основания = ПодготовитьТаблицуДанныхДоговора(
		ДанныеОснования.ВидОбязательства,
		ДанныеОснования.НомерДоговора,
		ДанныеОснования.ДатаДоговора);
		
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(Основания, "ДокОснованиеДата",,,
			НСтр("ru = 'Необходимо указать дату договора.'"));
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, Основания, "Основание");
	
	Если Не ЗначениеЗаполнено(Шапка.Валюта) Тогда
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
			"Объект.ВалютаДокумента");
	Иначе
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(Шапка.Валюта, 
			"Объект.Код");
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаКод", Шапка.ВалютаКод, ПараметрыОбработкиОшибок);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаНаименование", Шапка.ВалютаНаименование, ПараметрыОбработкиОшибок);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснования", Шапка.ДокументОснование);
	
	ТекстЗаголовка = "Мы, нижеподписавшиеся, представитель ИСПОЛНИТЕЛЯ, с одной стороны и представитель ЗАКАЗЧИКА с другой"
		+ " стороны, составили настоящий акт в том, что ИСПОЛНИТЕЛЬ выполнил, а ЗАКАЗЧИК принял следующие работы (услуги).";
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "Заголовок", ТекстЗаголовка);
	
	ЗаполнитьДанныеУчастника(Шапка.Организация, "Исполнитель", Шапка.ДатаАкта, ДеревоДанных);
	
	КонтрагентГоловнаяОрганизация = Справочники.Контрагенты.ПустаяСсылка();
	КонтрагентГоловнаяОрганизацияПредставление = "";
	КонтрагентГоловнаяОрганизацияИНН = "";
	Если Шапка.КонтрагентОбособленноеПодразделение И ЗначениеЗаполнено(Шапка.КонтрагентГоловнаяОрганизация) Тогда
		КонтрагентГоловнаяОрганизация = Шапка.КонтрагентГоловнаяОрганизация;
		КонтрагентГоловнаяОрганизацияПредставление = Шапка.КонтрагентГоловнаяОрганизацияПредставление;
		КонтрагентГоловнаяОрганизацияИНН = Шапка.КонтрагентГоловнаяОрганизацияИНН;
	КонецЕсли;
	
	ЗаполнитьДанныеУчастника(Шапка.Контрагент, "Заказчик", Шапка.ДатаАкта, ДеревоДанных,,,,,,, 
		КонтрагентГоловнаяОрганизация, КонтрагентГоловнаяОрганизацияПредставление, КонтрагентГоловнаяОрганизацияИНН);
	
	СведенияОСоставителе = Новый Структура;
	ПолучитьДанныеЮрФизЛица(Шапка.Организация, СведенияОСоставителе);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"НаименованиеСоставителяДокумента", СведенияОСоставителе.ПолноеНаименование);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияПоВыполнениюУслуг.ДатаИсполнения", Шапка.ДатаАкта);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ОписаниеУслуги.НачалоРабот", Шапка.ДатаАкта);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ОписаниеУслуги.КонецРабот", Шапка.ДатаАкта);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ОписаниеУслуги.СуммаБезНДСИтого", ТабличнаяЧасть.Итог("СуммаБезНДС"));
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ОписаниеУслуги.СуммаНДСИтого", ТабличнаяЧасть.Итог("СуммаНДС"));
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ОписаниеУслуги.СуммаСНДСИтого", ТабличнаяЧасть.Итог("СуммаСНДС"));
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументСделкиНаименование", Шапка.ДокументОснованиеНаименование);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументСделкиНомер", Шапка.ДокументОснованиеНомер);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументСделкиДата", Шапка.ДокументОснованиеДата);
	
	ТабличнаяЧасть.Колонки.Добавить("ДопДанныеПодписанные");
	Для Каждого СтрокаУслуги Из ТабличнаяЧасть Цикл
		Если ЗначениеЗаполнено(СтрокаУслуги.Описание) Тогда
			Если СтрДлина(СтрокаУслуги.Описание)>1000 Тогда
				Если НЕ ЗначениеЗаполнено(СтрокаУслуги.НаименованиеНоменклатуры) Тогда
					СтрокаУслуги.ТоварНаименование = СтрокаУслуги.НаименованиеЭлементаНоменклатуры;
					СтрокаУслуги.НаименованиеНоменклатуры = СтрокаУслуги.НаименованиеЭлементаНоменклатуры;
				КонецЕсли;	
			Иначе
				СтрокаУслуги.ТоварНаименование = СтрокаУслуги.Описание;
				СтрокаУслуги.НаименованиеНоменклатуры = СтрокаУслуги.Описание;
			КонецЕсли;
		КонецЕсли;
		
		СтрокаУслуги.Цена = СтрокаУслуги.ЦенаАктаВыполненныхРабот;
		
		СтрокаУслуги.ЕдиницаИзмеренияКод = СокрЛП(СтрокаУслуги.ЕдиницаИзмеренияКод);

		Сопоставление = Новый Структура;
		Сопоставление.Вставить("Наименование", СтрокаУслуги.НаименованиеНоменклатуры);
		Сопоставление.Вставить("ЕдиницаИзмерения", СтрокаУслуги.ЕдиницаИзмеренияНаименование);
		Сопоставление.Вставить("Артикул", "");
		
		ХарактеристикаНаименование = "";
		Сопоставление.Вставить("Характеристика", ХарактеристикаНаименование);
		ШтрихкодыТовара = "";
		Сопоставление.Вставить("Штрихкод", ШтрихкодыТовара);
		УпаковкаИБ = "";
		
		Сопоставление.Вставить("НоменклатураИБ", СтрокаУслуги.Номенклатура);
		Сопоставление.Вставить("ХарактеристикаИБ", ХарактеристикаНаименование);
		Сопоставление.Вставить("УпаковкаИБ", УпаковкаИБ);
		СтрокаУслуги.Сопоставление = Сопоставление;
		
	КонецЦикла;
	
	// Обработка ошибки через механизм сообщений пользователю.
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТабличнаяЧасть,
		"НаименованиеНоменклатуры", , ,
		НСтр("ru = 'Не указано наименование услуги в табличной части.'"));
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТабличнаяЧасть,
		"Количество", , ,
		НСтр("ru = 'Не указано количество услуги в табличной части.'"));
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТабличнаяЧасть,
		"Цена", , ,
		НСтр("ru = 'Не указана цена услуги в табличной части.'"));
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТабличнаяЧасть,
		"СуммаБезНДС", , ,
		НСтр("ru = 'Не указана сумма услуги в табличной части.'"));
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТабличнаяЧасть,
		"СуммаНДС", , ,
		НСтр("ru = 'Не указана сумма НДС услуги в табличной части.'"));
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТабличнаяЧасть,
		"СуммаСНДС", , ,
		НСтр("ru = 'Не указана сумма с НДС услуги в табличной части.'"));
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТабличнаяЧасть,
		"ЕдиницаИзмеренияНаименование", , ,
		НСтр("ru = 'Не заполнена наименование единицы измерения услуги в табличной части.'"));
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТабличнаяЧасть,
		"ЕдиницаИзмеренияКод", , ,
		НСтр("ru = 'Не заполнен код единицы измерения услуги в табличной части.'"));
	
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТабличнаяЧасть, "ТаблицаУслуг");
	
КонецПроцедуры

// Подготавливает данные титула заказчика для электронного документа типа Акт выполненных работ
// формата 5.01.
//
// Параметры:
//  СсылкаНаЭД   - Ссылка на ЭД, по которому необходимо сформировать электронный документ,
//  СтруктураЭД - Структура, структура данных для формирования электронного документа.
//  ДеревоДанных - дерево значений, дерево данных заполнения электронного документа.
//
Процедура ЗаполнитьДанныеПоАкт501ЗаказчикФНС(СсылкаНаЭД, ДеревоДанных, Отказ = Ложь) Экспорт
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияПоВыполнениюУслуг.ДатаЗаказа", ТекущаяДатаСеанса());
	
КонецПроцедуры

// Подготавливает данные для электронного документа типа Счет-Фактура.
//
// Параметры:
//  СсылкаНаОбъект - документСсылка - ссылка на объект информационной базы,
//  по которому необходимо создать электронный документ.
//  СтруктураЭД - структура - структура данных для формирования электронного документа.
//  ДеревоДанных - дерево значений, дерево данных заполнения электронного документа.
//
Процедура ЗаполнитьДанныеПоСчетуФактуреФНС(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ = Ложь) Экспорт
	
	Если    ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный")	
		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументОбъект.ИсправительныйСчетФактураПолученный") Тогда
			
		ПодготовитьДанныеПоИсправительномуСчетуФактуре(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ);
	Иначе
		
		ПодготовитьДанныеПоСчетуФактуре(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ)
	КонецЕсли;

КонецПроцедуры

// Подготавливает данные для электронного документа типа Корректировочный Счет-Фактура.
//
// Параметры:
//  СсылкаНаОбъект - документСсылка - ссылка на объект информационной базы,
//  по которому необходимо создать электронный документ.
//  СтруктураЭД - структура - структура данных для формирования электронного документа.
//  ДеревоДанных - дерево значений, дерево данных заполнения электронного документа.
//
Процедура ЗаполнитьДанныеПоКорректировочномуСчетуФактуреФНС(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ = Ложь) Экспорт
	
	Если    ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный")	
		ИЛИ ТипЗнч(СсылкаНаОбъект) = Тип("ДокументОбъект.ИсправительныйСчетФактураПолученный") Тогда
			
		ПодготовитьДанныеПоИсправительномуСчетуФактуре_Корректировка(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ);
	Иначе
		
		ПодготовитьДанныеПоКорректировочномуСчетуФактуре(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ)
	КонецЕсли;

КонецПроцедуры

// Заполняет данные для электронного документа типа СоглашениеОбИзмененииСтоимостиОтправитель.
//
// Параметры:
//  СсылкаНаОбъект - ДокументСсылка, ссылка на объект информационной базы, по которому необходимо создать электронный документ.
//  СтруктураЭД - Структура, структура данных для формирования электронного документа.
//  ДеревоДанных - дерево значений, дерево данных заполнения электронного документа.
//
Процедура ЗаполнитьДанныеПоКорректировочномуДокументу(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ = Ложь) Экспорт
	
	

КонецПроцедуры

// Подготавливает данные для электронного документа типа СоглашениеОбИзмененииСтоимостиПолучатель.
//
// Параметры:
//  СсылкаНаЭД   - Ссылка на ЭД, по которому необходимо сформировать электронный документ,
//  СтруктураЭД - Структура, структура данных для формирования электронного документа.
//  ДеревоДанных - дерево значений, дерево данных заполнения электронного документа.
//
Процедура ЗаполнитьДанныеПоКорректировочномуДокументуПолучатель(СсылкаНаЭД, СтруктураЭД, ДеревоДанных, Отказ = Ложь) Экспорт
	
	
	
КонецПроцедуры

// Подготавливает данные для электронного документа типа Счет формата CML 2.
//
// Параметры:
//  СсылкаНаОбъект - ДокументСсылка, ссылка на объект информационной базы, по которому необходимо создать электронный документ.
//  СтруктураЭД - Структура, структура данных для формирования электронного документа.
//  Дерево документа - дерево значений - дерево значений, соответствующее макету СчетНаОплату обработки ЭлектронныеДокументы.
//
Процедура ЗаполнитьДанныеПоСчету(СсылкаНаОбъект, ДеревоДокумента, Отказ = Ложь) Экспорт
	НетЗамечанийКДокументу = Документы["СчетНаОплату"].ПредварительныйКонтрольДанныхДляЭД(СсылкаНаОбъект);
	
	Если НЕ НетЗамечанийКДокументу Тогда
		ОписаниеОшибки = НСтр("ru='Вышеуказанные ошибки препятствуют формированию электронного документа.
		|По этой причине и прочие данные документа не будут выгружены в ЭД.
		|После заполнения указанных реквизитов повторите попытку формирования электронного документа.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки);
		Отказ = Истина;
		Возврат;
	КонецЕсли;	
	
	ДанныеДокИБ = Документы["СчетНаОплату"].ПодготовитьДанныеДляЭД(СсылкаНаОбъект);
	РеквизитыШапки = ДанныеДокИБ[0].Выбрать();
	ТабличнаяЧасть = ДанныеДокИБ[1].Выгрузить();
	ДобавитьИДНоменклатурыВТаблицу(ТабличнаяЧасть);
	
	РеквизитыШапки.Следующий();
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "Номер", НомерДляПечати(СсылкаНаОбъект, РеквизитыШапки.Номер));
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "Дата", РеквизитыШапки.Дата);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "НазначениеПлатежа", РеквизитыШапки.НазначениеПлатежа);
	
	Валюта = "";
	Если ЗначениеЗаполнено(РеквизитыШапки.Валюта) Тогда
		Валюта = РеквизитыШапки.Валюта.Наименование;
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(Валюта) Тогда
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
			"Объект.ВалютаДокумента");
	Иначе
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(РеквизитыШапки.Валюта, 
			"Объект.Код");
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "Валюта", Валюта, ПараметрыОбработкиОшибок);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "Курс", РеквизитыШапки.Курс);
	
	Если ЗначениеЗаполнено(РеквизитыШапки.СчетПокупателя) Тогда
		ЗаполнитьДанныеУчастникаСчетаНаОплату(РеквизитыШапки.Покупатель, "Покупатель", РеквизитыШапки.Дата, ДеревоДокумента, 
								РеквизитыШапки.СчетПокупателя);
	Иначе
	 	ПлательщикГоловнаяОрганизация = Справочники.Контрагенты.ПустаяСсылка();
		ПлательщикГоловнаяОрганизацияПредставление = "";
		ПлательщикГоловнаяОрганизацияИНН = "";
		Если РеквизитыШапки.ПлательщикОбособленноеПодразделение И ЗначениеЗаполнено(РеквизитыШапки.ПлательщикГоловнаяОрганизация) Тогда
			ПлательщикГоловнаяОрганизация = РеквизитыШапки.ПлательщикГоловнаяОрганизация;
			ПлательщикГоловнаяОрганизацияПредставление = РеквизитыШапки.ПлательщикГоловнаяОрганизацияПредставление;
			ПлательщикГоловнаяОрганизацияИНН = РеквизитыШапки.ПлательщикГоловнаяОрганизацияИНН;
		КонецЕсли;
		
		ЗаполнитьДанныеУчастникаСчетаНаОплату(РеквизитыШапки.Покупатель, "Покупатель", РеквизитыШапки.Дата, ДеревоДокумента,
		,, ПлательщикГоловнаяОрганизация, ПлательщикГоловнаяОрганизацияПредставление, ПлательщикГоловнаяОрганизацияИНН);
	КонецЕсли;						
	ЗаполнитьДанныеУчастникаСчетаНаОплату(РеквизитыШапки.Продавец, "Продавец", РеквизитыШапки.Дата, ДеревоДокумента, 
							РеквизитыШапки.ЛицевойСчетПродавца, РеквизитыШапки.РеквизитыЛицевогоСчетаПродавца);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "ИтогоПоДокументу.Сумма", ТабличнаяЧасть.Итог("Сумма"));
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "ИтогоПоДокументу.СуммаСкидки", 0);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "ИтогоПоДокументу.СуммаБезСкидки", ТабличнаяЧасть.Итог("Сумма"));
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "ИтогоПоДокументу.СуммаНДС", ТабличнаяЧасть.Итог("СуммаНДС"));
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "ИтогоПоДокументу.ЦенаВключаетНДС", РеквизитыШапки.СуммаВключаетНДС);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "СрокПлатежа", РеквизитыШапки.СрокОплаты);
	
	Если РеквизитыШапки.СуммаВключаетНДС Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "Сумма", ТабличнаяЧасть.Итог("Сумма"));
	Иначе	
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "Сумма", ТабличнаяЧасть.Итог("Сумма") + ТабличнаяЧасть.Итог("СуммаНДС"));
	КонецЕсли;
	
	Для каждого ТекСтрока Из ТабличнаяЧасть Цикл
		Если РеквизитыШапки.НеЗаполнятьЦеныВЭлектронномДокументе Тогда
			ТекСтрока.Цена = 0;
		КонецЕсли;	
		Если ЗначениеЗаполнено(ТекСтрока.Содержание) Тогда
			ТекСтрока.Наименование = ТекСтрока.Содержание;
			ТекСтрока.Описание = ТекСтрока.Содержание;
		КонецЕсли;
	КонецЦикла;	
	
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДокумента, ТабличнаяЧасть, "Товары");
	
	СуммаПредставление = "";
	ФорматСумм(РеквизитыШапки.СуммаДокумента, СуммаПредставление, РеквизитыШапки.Валюта);
	
	ИтоговаяСтрока = СтрШаблон(НСтр("ru='Всего наименований %1, на сумму %2'"),
		ТабличнаяЧасть.Количество(), СуммаПредставление);

	ИтоговаяСтрока = ИтоговаяСтрока + Символы.ПС + РаботаСКурсамиВалют.СформироватьСуммуПрописью(РеквизитыШапки.СуммаДокумента, РеквизитыШапки.Валюта);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "ИтогиПрописью", ИтоговаяСтрока);
	
	РеквизитыПродавца = Новый Структура("ИННПолучателя, КПППолучателя, ТекстПолучателя, НомерСчетаПолучателя, 
										|НаименованиеБанкаПолучателя, БикБанкаПолучателя, СчетБанкаПолучателя", 
										"ИНН", "КПП", "Корреспондент", "СчетНомер", "Банк", "БИК", "КоррСчет");
    ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(РеквизитыШапки.ЛицевойСчетПродавца, 
										РеквизитыШапки.РеквизитыЛицевогоСчетаПродавца, РеквизитыПродавца, Истина);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "РасчетныйСчет.НомерСчета", РеквизитыПродавца.НомерСчетаПолучателя);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "РасчетныйСчет.Банк.БИК", РеквизитыПродавца.БикБанкаПолучателя);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "РасчетныйСчет.Банк.СчетКорреспондентский", РеквизитыПродавца.СчетБанкаПолучателя);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "РасчетныйСчет.Банк.Наименование", РеквизитыПродавца.НаименованиеБанкаПолучателя);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "Комментарий", РеквизитыШапки.Комментарий);
	
	//Дополнительные данные счета на оплату
	РеквизитыПолучателя = Новый Структура("ИННПолучателя, КПППолучателя, ТекстПолучателя, НомерСчетаПолучателя, НаименованиеБанкаПолучателя, БикБанкаПолучателя, СчетБанкаПолучателя", "ИНН", "КПП", "Корреспондент", "СчетНомер", "Банк", "БИК", "КоррСчет");
	ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(РеквизитыШапки.ЛицевойСчетПродавца, РеквизитыШапки.РеквизитыЛицевогоСчетаПродавца, РеквизитыПолучателя, Истина);
	НаименованиеПолучателяПлатежа = РеквизитыПолучателя.ТекстПолучателя;
	
	КПС = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = '%1%2%3'"), РеквизитыШапки.КодГлавы, РеквизитыШапки.КодКПС, РеквизитыШапки.КодАналитикиКПС);
	ОКТМО = РеквизитыШапки.КодОКАТО;
	
	ДопДанныеСчетаНаОплату = Новый Структура;
	ДопДанныеСчетаНаОплату.Вставить("НаименованиеПолучателяПлатежа", НаименованиеПолучателяПлатежа);

	Если Не ПустаяСтрока(КПС) Тогда
		ДопДанныеСчетаНаОплату.Вставить("КПС", КПС);
	КонецЕсли;

	Если Не ПустаяСтрока(ОКТМО) Тогда
		ДопДанныеСчетаНаОплату.Вставить("ОКТМО", ОКТМО);
	КонецЕсли;

	ЭлектронноеВзаимодействие.ДобавитьДопДанныеВДерево(ДеревоДокумента, ДопДанныеСчетаНаОплату, Истина);
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Поиск и создание документов

//см. ОбменСКонтрагентамиПереопределяемый.СохранитьДанныеОбъектаВБД
//Устарела. Следует использовать ОбменСКонтрагентамиПереопределяемый.ПриОтраженииВУчетеДокументаCML
//
Процедура СохранитьДанныеОбъектаВБД(СтрокаДляЗагрузки, ДеревоРазбора, ПараметрыОбработки, НайденныйОбъект, ПараметрыДляОтраженияВУчете = Неопределено) Экспорт
	
	ТипыДокументов = ОбменСКонтрагентами.ТипыДокументов();
	
	Записывать = ПараметрыОбработки.Записывать;
	СсылкаНаВладельца = ПараметрыОбработки.СсылкаНаВладельца;
	
	Если СтрокаДляЗагрузки.ВидЭД = ТипыДокументов.ТоварнаяНакладная
		ИЛИ СтрокаДляЗагрузки.ВидЭД = ТипыДокументов.АктНаПередачуПрав Тогда

		НайденныйОбъект = НайтиСоздатьПоступлениеМЗ(СтрокаДляЗагрузки, ДеревоРазбора, СсылкаНаВладельца, Записывать);
		
	ИначеЕсли СтрокаДляЗагрузки.ВидЭД = ТипыДокументов.АктВыполненныхРабот Тогда

		НайденныйОбъект = НайтиСоздатьПоступлениеУслугРабот(СтрокаДляЗагрузки, ДеревоРазбора, СсылкаНаВладельца, Записывать);
		
	ИначеЕсли СтрокаДляЗагрузки.ВидЭД = ТипыДокументов.СчетФактура
			ИЛИ СтрокаДляЗагрузки.ВидЭД = ТипыДокументов.КорректировочныйСчетФактура Тогда
		
		НайденныйОбъект = НайтиСоздатьСчетФактуру(СтрокаДляЗагрузки, ДеревоРазбора, СсылкаНаВладельца, Записывать);
		
	ИначеЕсли СтрокаДляЗагрузки.ВидЭД = ТипыДокументов.СчетНаОплату Тогда

		НайденныйОбъект = НайтиСоздатьСчетНаОплатуОтПоставщика(СтрокаДляЗагрузки, ДеревоРазбора, СсылкаНаВладельца, Записывать, ПараметрыДляОтраженияВУчете);
		
	ИначеЕсли СтрокаДляЗагрузки.ВидЭД = ТипыДокументов.ОтветНаЗаказ Тогда

		НайденныйОбъект = НайтиСоздатьСчетНаОплатуОтПоставщикаКакОтветНаЗаказ(СтрокаДляЗагрузки, ДеревоРазбора, СсылкаНаВладельца, Записывать, ПараметрыДляОтраженияВУчете);
		
	ИначеЕсли СтрокаДляЗагрузки.ВидЭД = ТипыДокументов.РеквизитыОрганизации Тогда
		
		НайденныйОбъект = НовыйКонтрагент(СтрокаДляЗагрузки, ДеревоРазбора, СсылкаНаВладельца)
		
	КонецЕсли;
	
КонецПроцедуры

//см. ОбменСКонтрагентамиПереопределяемый.ПриОтраженииВУчетеДокументаCML
//
Процедура ПриОтраженииВУчетеДокументаCML(РезультатОтраженияВУчете, Знач ДанныеЭлектронногоДокумента,
	Знач ПараметрыДляОтраженияВУчете) Экспорт

	ТипыДокументов = ОбменСКонтрагентами.ТипыДокументов();
	ТипДокумента = ПараметрыДляОтраженияВУчете.ПараметрыЭлектронногоДокумента.ТипДокумента;
	
	ПараметрыПоФорматуДокумента = ПараметрыДляОтраженияВУчете.ПараметрыПоФорматуДокумента;
	ДеревоРазбора = ПараметрыПоФорматуДокумента.ДеревоСсылокНаОбъекты;
	
	СсылкаНаВладельца = Неопределено;
	Если ЗначениеЗаполнено(РезультатОтраженияВУчете.ДокументыУчета) Тогда
		СсылкаНаВладельца = РезультатОтраженияВУчете.ДокументыУчета[0];
	КонецЕсли;
	
	НайденныйОбъект = Неопределено;
	Если ТипДокумента = ТипыДокументов.ТоварнаяНакладная
		ИЛИ ТипДокумента = ТипыДокументов.АктНаПередачуПрав Тогда
		
		НайденныйОбъект = НайтиСоздатьПоступлениеМЗ(ДанныеЭлектронногоДокумента, ДеревоРазбора, СсылкаНаВладельца);

	ИначеЕсли ТипДокумента = ТипыДокументов.АктВыполненныхРабот Тогда

		НайденныйОбъект = НайтиСоздатьПоступлениеУслугРабот(ДанныеЭлектронногоДокумента, ДеревоРазбора, СсылкаНаВладельца);
		
	ИначеЕсли (ТипДокумента = ТипыДокументов.СчетФактура
		ИЛИ ТипДокумента = ТипыДокументов.КорректировочныйСчетФактура) Тогда
		
		НайденныйОбъект = НайтиСоздатьСчетФактуру(ДанныеЭлектронногоДокумента, ДеревоРазбора, СсылкаНаВладельца);
		
	ИначеЕсли ТипДокумента = ТипыДокументов.РеквизитыОрганизации Тогда
		
		НайденныйОбъект = НовыйКонтрагент(ДанныеЭлектронногоДокумента, ДеревоРазбора, СсылкаНаВладельца);
		
	ИначеЕсли ТипДокумента = ТипыДокументов.ОтветНаЗаказ Тогда
	
		НайденныйОбъект = НайтиСоздатьСчетНаОплатуОтПоставщикаКакОтветНаЗаказ(ДанныеЭлектронногоДокумента, ДеревоРазбора, СсылкаНаВладельца, ,ПараметрыДляОтраженияВУчете);

	ИначеЕсли ТипДокумента = ТипыДокументов.СчетНаОплату Тогда
		
		НайденныйОбъект = НайтиСоздатьСчетНаОплатуОтПоставщика(ДанныеЭлектронногоДокумента, ДеревоРазбора, СсылкаНаВладельца, , ПараметрыДляОтраженияВУчете);

	КонецЕсли;
	
	Если ЗначениеЗаполнено(НайденныйОбъект) Тогда
		РезультатОтраженияВУчете.ДокументыУчета = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(НайденныйОбъект);
	КонецЕсли;
	
КонецПроцедуры

//см. ОбменСКонтрагентамиПереопределяемый.ПриОтраженииВУчетеДокументаПередачаРезультатовРабот
//
Процедура ПриОтраженииВУчетеДокументаПередачаРезультатовРабот(РезультатОтраженияВУчете, Знач ДанныеЭлектронногоДокумента,
	Знач ПараметрыДляОтраженияВУчете) Экспорт

	СсылкаНаВладельца = Неопределено;
	Если ЗначениеЗаполнено(РезультатОтраженияВУчете.ДокументыУчета) Тогда
		СсылкаНаВладельца = РезультатОтраженияВУчете.ДокументыУчета[0];
	КонецЕсли;
	ОписаниеОшибки = "";

	НайтиСоздатьДокументПередачаТоваров(ДанныеЭлектронногоДокумента, СсылкаНаВладельца, ПараметрыДляОтраженияВУчете.СпособОбработки, ОписаниеОшибки);
	
	Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
		РезультатОтраженияВУчете.ДокументыУчета = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СсылкаНаВладельца);
	КонецЕсли;
	Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
		РезультатОтраженияВУчете.ОписаниеОшибки	= РезультатОтраженияВУчете;
	КонецЕсли;	
	
КонецПроцедуры

//см. ОбменСКонтрагентамиПереопределяемый.ПриОтраженииВУчетеДокументаПередачаТоваров
//
Процедура ПриОтраженииВУчетеДокументаПередачаТоваров(РезультатОтраженияВУчете, Знач ДанныеЭлектронногоДокумента,
	Знач ПараметрыДляОтраженияВУчете) Экспорт

	СсылкаНаВладельца = Неопределено;
	Если ЗначениеЗаполнено(РезультатОтраженияВУчете.ДокументыУчета) Тогда
		СсылкаНаВладельца = РезультатОтраженияВУчете.ДокументыУчета[0];
	КонецЕсли;
	ОписаниеОшибки = "";

	НайтиСоздатьДокументПередачаРезультатовРабот(ДанныеЭлектронногоДокумента, СсылкаНаВладельца, ПараметрыДляОтраженияВУчете.СпособОбработки, ОписаниеОшибки);
	
	Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
		РезультатОтраженияВУчете.ДокументыУчета = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СсылкаНаВладельца);
	КонецЕсли;
	Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
		РезультатОтраженияВУчете.ОписаниеОшибки	= РезультатОтраженияВУчете;
	КонецЕсли;	
	
КонецПроцедуры

