				СтрокаТаблицыАдресовXDTO.Установить("ВидИнформации", Строка(НайденныеСтроки[0].Вид));
				СтрокаТаблицыАдресовXDTO.Установить("Значение", XMLстрока(НайденныеСтроки[0].Значение));
				СтрокаТаблицыАдресовXDTO.Установить("ЗначенияПолей", XMLстрока(НайденныеСтроки[0].ЗначенияПолей));

				ТаблицаXDTO.КонтактнаяИнформацияОбъектов.Добавить(СтрокаТаблицыАдресовXDTO);
			КонецЕсли;
		КонецЕсли;	
		СтрокаТаблицыXDTO.Установить("МестонахождениеОбъектаДоПередачи", Местонахождение);
		СтрокаТаблицыXDTO.Установить("АдресОбъектаДоПередачи", АдресОбъектаМЦДоПередачи);
		
		//Добавить новые данные структуры
		Если ЗначениеЗаполнено(СтрокаТаблицы.Изготовитель) Тогда
			Если ИзготовителиНФА.Найти(СтрокаТаблицы.Изготовитель) = Неопределено Тогда
				ИзготовителиНФА.Добавить(СтрокаТаблицы.Изготовитель);
			КонецЕсли;
			
			GUIDИзготовителя = Строка(СтрокаТаблицы.Изготовитель.УникальныйИдентификатор());
			СтрокаТаблицыXDTO.Установить("GUIDИзготовителя", GUIDИзготовителя);
		Иначе
			СтрокаТаблицыXDTO.Установить("GUIDИзготовителя", "");
		КонецЕсли;
		
		ТаблицаXDTO.МЦКапвложенийСДрагМатериалами.Добавить(СтрокаТаблицыXDTO);
		
	КонецЦикла;
	
	//СведенияОПрослеживаемости
	
	Для Каждого СтрокаТаблицы Из СведенияОПрослеживаемости Цикл
		НоменклатураКомплектующее = СтрокаТаблицы.Комплектующее;
		ЕдИзмКод = "";
		ЕдИзмНаим = "";
		GUIDНоменклатурыКомплектующее = "";
		
		СтрокаТаблицыXDTO = СоздатьОбъектXDTO(ТаблицаXDTO, "СведенияОПрослеживаемости");
		
		Если ЗначениеЗаполнено(НоменклатураКомплектующее) Тогда
			GUIDНоменклатурыКомплектующее = XMLстрока(НоменклатураКомплектующее.УникальныйИдентификатор());
		КонецЕсли;
		СтрокаТаблицыXDTO.Установить("ИдентификаторСтроки", XMLстрока(СтрокаТаблицы.ИдентификаторСтроки));
		СтрокаТаблицыXDTO.Установить("GUIDНоменклатурыКомплектующее", GUIDНоменклатурыКомплектующее);
		СтрокаТаблицыXDTO.Установить("ПолноеНаимНоменклатурыКомплектующее", XMLстрока(СтрокаТаблицы.ПолноеНаименованиеНФАКомплектующее)); 
		СтрокаТаблицыXDTO.Установить("НаимНоменклатурыКомплектующее", XMLстрока(СтрокаТаблицы.НаименованиеНФАКомплектующее));
		
		РНПТ = "";
		GUIDНоменклатурыСписка = "";
		ПолноеНаимНоменклатуры = "";
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ИдентификаторСтроки", СтрокаТаблицы.ИдентификаторСтроки);
		НайденныеСтроки = ТаблицаНФА.НайтиСтроки(ПараметрыОтбора);
		Если НайденныеСтроки.Количество()>0 Тогда
			НайденнаяНоменклатура = НайденныеСтроки[0].ОсновноеСредство;
			ЕдИзм = НайденныеСтроки[0].ЕдиницаИзмерения;
			
			Если ЗначениеЗаполнено(НайденнаяНоменклатура) Тогда
				GUIDНоменклатурыСписка = XMLстрока(НайденнаяНоменклатура.УникальныйИдентификатор());
				
				ДанныеНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НайденнаяНоменклатура, "НаименованиеПолное");
				ПолноеНаимНоменклатуры = ДанныеНоменклатуры.НаименованиеПолное;
				
				ДанныеЕдИзм = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЕдИзм, "Код, Наименование");
				ЕдИзмКод = СокрЛП(ДанныеЕдИзм.Код);
				ЕдИзмНаим = СокрЛП(ДанныеЕдИзм.Наименование);
			КонецЕсли;
		КонецЕсли;							
			
		Если ЗначениеЗаполнено(СтрокаТаблицы.РНПТ) Тогда
			ДанныеРНПТ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаТаблицы.РНПТ, "Код");
			РНПТ = ДанныеРНПТ.Код;
		КонецЕсли;
		СтрокаТаблицыXDTO.Установить("РНПТ", XMLстрока(РНПТ));
		
		СтрокаТаблицыXDTO.Установить("GUIDНоменклатуры", GUIDНоменклатурыСписка);
		СтрокаТаблицыXDTO.Установить("ПолноеНаимНоменклатуры", ПолноеНаимНоменклатуры);
		
		СтрокаТаблицыXDTO.Установить("ЕдИзмКод", ЕдИзмКод);
		СтрокаТаблицыXDTO.Установить("ЕдИзмНаим", ЕдИзмНаим);
		СтрокаТаблицыXDTO.Установить("Количество", СтрокаТаблицы.КоличествоПрослеживаемости);
		СтрокаТаблицыXDTO.Установить("КоличествоУчетное", СтрокаТаблицы.Количество);
		
		Если ЗначениеЗаполнено(НоменклатураКомплектующее) Тогда
			РеквизитыКомплектующего = "ВидНФА, ТипНФА"; 
			ТипСправочникаКомплектующее = "ОсновныеСредства";
			Если ТипЗнч(НоменклатураКомплектующее) = Тип("СправочникСсылка.Номенклатура") Тогда
				РеквизитыКомплектующего = "ТипНоменклатуры"; 
				ТипСправочникаКомплектующее = "Номенклатура";
			КонецЕсли;	
			
			СвойстваКомплектующего = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НоменклатураКомплектующее, РеквизитыКомплектующего);
			
			СтрокаТаблицыXDTO.Установить("ТипСправочникаКомплектующее", XMLстрока(ТипСправочникаКомплектующее)); 
			
			Если ТипСправочникаКомплектующее = "Номенклатура" Тогда
				СтрокаТаблицыXDTO.Установить("ТипНоменклатурыКомплектующее", XMLстрока(СвойстваКомплектующего.ТипНоменклатуры));
			Иначе
				СтрокаТаблицыXDTO.Установить("ВидНФАКомплектующее", XMLстрока(СвойстваКомплектующего.ВидНФА));
				СтрокаТаблицыXDTO.Установить("ТипНФАКомплектующее", XMLстрока(СвойстваКомплектующего.ТипНФА));
			КонецЕсли;
		КонецЕсли;
		
		ТаблицаXDTO.СведенияОПрослеживаемости.Добавить(СтрокаТаблицыXDTO);
		
	КонецЦикла;
	
	//ТаблицаПаспортныеДанные
	
	Для Каждого СтрокаТаблицы Из ТаблицаПаспортныеДанные Цикл
		Номенклатура = СтрокаТаблицы.ОсновноеСредство;
		ИнвентарныйНомер = СтрокаТаблицы.ИнвентарныйНомер;
		
		СтрокаТаблицыXDTO = СоздатьОбъектXDTO(ТаблицаXDTO, "СведенияПТС");
		СтрокаТаблицыXDTO.Установить("ИнвентарныйНомер", Строка(ИнвентарныйНомер));
		
		GUIDИнвентарногоНомера = "";
		Если ЗначениеЗаполнено(ИнвентарныйНомер) Тогда
			GUIDИнвентарногоНомера = Строка(ИнвентарныйНомер.УникальныйИдентификатор());
		КонецЕсли;
		СтрокаТаблицыXDTO.Установить("GUIDИнвентарногоНомера", GUIDИнвентарногоНомера);
		
		СтрокаТаблицыXDTO.Установить("GUIDНоменклатуры", Строка(Номенклатура.УникальныйИдентификатор()));
		СтрокаТаблицыXDTO.Установить("СерияНомер", XMLстрока(СтрокаТаблицы.СерияНомер));
		СтрокаТаблицыXDTO.Установить("ИдентификационныйНомер", XMLстрока(СтрокаТаблицы.ИдентификационныйНомер));
		СтрокаТаблицыXDTO.Установить("Марка", XMLстрока(СтрокаТаблицы.Марка));
		СтрокаТаблицыXDTO.Установить("Модель", XMLстрока(СтрокаТаблицы.Модель));
		СтрокаТаблицыXDTO.Установить("Тип", XMLстрока(СтрокаТаблицы.Тип));
		СтрокаТаблицыXDTO.Установить("МодельДвигателя", XMLстрока(СтрокаТаблицы.ДвигательМодель));
		СтрокаТаблицыXDTO.Установить("НомерДвигателя", XMLстрока(СтрокаТаблицы.ДвигательНомер));
		СтрокаТаблицыXDTO.Установить("НомерШасси", XMLстрока(СтрокаТаблицы.НомерШасси));
		СтрокаТаблицыXDTO.Установить("НомерКузова", XMLстрока(СтрокаТаблицы.НомерКузова));
		СтрокаТаблицыXDTO.Установить("ЭкологическийКласс", СтрокаТаблицы.ЭкологическийКласс);
		СтрокаТаблицыXDTO.Установить("Масса", СтрокаТаблицы.Масса);
		СтрокаТаблицыXDTO.Установить("ГаражныйНомер", XMLстрока(СтрокаТаблицы.ГаражныйНомер));
		СтрокаТаблицыXDTO.Установить("Грузоподъемность", XMLстрока(СтрокаТаблицы.Грузоподъемность));
		СтрокаТаблицыXDTO.Установить("Колонна", XMLстрока(СтрокаТаблицы.Колонна));
		СтрокаТаблицыXDTO.Установить("РегистрационныйЗнак", XMLстрока(СтрокаТаблицы.РегистрационныйЗнак));
		
		ТаблицаXDTO.СведенияПТС.Добавить(СтрокаТаблицыXDTO);
		
	КонецЦикла;
	
	//ТаблицаПаспортныеДанныеДрагМатериалы
	
	Для Каждого ТекСтрока Из ТаблицаПаспортныеДанныеДрагМатериалы Цикл
		Номенклатура = ТекСтрока.ОбъектНФА;
		
		ПаспортныеДанныеДрагМатериалыXDTO = СоздатьОбъектXDTO(ДокументXDTO, "СведенияТехДокументацииОСодержанииДрагМатериалов");
		ПаспортныеДанныеДрагМатериалыXDTO.Установить("ВидДокумента", ТекСтрока.Основание);
		НаименованиеДокумента = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru='%1 от %2 № %3'"), СокрЛП(ТекСтрока.Основание), Формат(ТекСтрока.ДатаОснования,  "ДФ=dd.MM.yyyy"), СокрЛП(ТекСтрока.НомерОснования));
		
		ПаспортныеДанныеДрагМатериалыXDTO.Установить("Наим", НаименованиеДокумента);
		ПаспортныеДанныеДрагМатериалыXDTO.Установить("Дата", ТекСтрока.ДатаОснования);
		ПаспортныеДанныеДрагМатериалыXDTO.Установить("Номер", ТекСтрока.НомерОснования);
		
		ПаспортныеДанныеДрагМатериалыXDTO.Установить("GUIDНоменклатуры", XMLстрока(Номенклатура.УникальныйИдентификатор()));
		ПаспортныеДанныеДрагМатериалыXDTO.Установить("ПолноеНаимНоменклатуры", XMLстрока(ТекСтрока.ПолноеНаименованиеНФА));
		
		Если ТипЗнч(Номенклатура) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
			ПаспортныеДанныеДрагМатериалыXDTO.Установить("ТипСправочника", НСтр("ru = 'ОсновныеСредства'"));
		Иначе
			ПаспортныеДанныеДрагМатериалыXDTO.Установить("ТипСправочника", НСтр("ru = 'Номенклатура'"));
		КонецЕсли;
		
		ДрагМатериалы = ТекСтрока.Ссылка.ДрагМатериалы.Выгрузить();
		
		Для Каждого ТекДрагМатериал Из ДрагМатериалы Цикл
			СтрокаСпискаДрагМатериаловXDTO = СоздатьОбъектXDTO(ПаспортныеДанныеДрагМатериалыXDTO, "СодержаниеДрагМатериалов");
			
			GUIDНоменклатурыДетали = "";
			НаимНоменклатурыДетали = "";
			ПолноеНаимНоменклатурыДетали = "";
			ТипНоменклатурыДетали = Перечисления.ТипыНоменклатуры.ПрочиеМЗ;
			Деталь = ТекДрагМатериал.Деталь;
			Если ЗначениеЗаполнено(Деталь) Тогда
				GUIDНоменклатурыДетали = Деталь.УникальныйИдентификатор();
				
				РеквизитыДетали = "Наименование, НаименованиеПолное, ТипНоменклатуры";
				ЗначенияРеквизитовДетали = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Деталь, РеквизитыДетали);
				НаимНоменклатурыДетали = ЗначенияРеквизитовДетали.Наименование;
				ПолноеНаимНоменклатурыДетали = ЗначенияРеквизитовДетали.НаименованиеПолное;
				ТипНоменклатурыДетали = ЗначенияРеквизитовДетали.ТипНоменклатуры;
			КонецЕсли;	
			СтрокаСпискаДрагМатериаловXDTO.Установить("GUIDНоменклатурыДетали", XMLстрока(GUIDНоменклатурыДетали));
			СтрокаСпискаДрагМатериаловXDTO.Установить("НаимНоменклатурыДетали", XMLстрока(НаимНоменклатурыДетали));
			СтрокаСпискаДрагМатериаловXDTO.Установить("ПолноеНаимНоменклатурыДетали", XMLстрока(ПолноеНаимНоменклатурыДетали));
			СтрокаСпискаДрагМатериаловXDTO.Установить("ТипНоменклатурыДетали", XMLстрока(ТипНоменклатурыДетали));
			
			НаимВидаДрагМатериала = "";
			КодВидаДрагМатериала = "";
			ВидДрагМатериала = ТекДрагМатериал.ВидДрагМатериала;
			Если ЗначениеЗаполнено(ВидДрагМатериала) Тогда
				РеквизитыВидДрагМатериала = "Наименование, Код";
				ЗначенияРеквизитовВидаДрагМатериала = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВидДрагМатериала, РеквизитыВидДрагМатериала);
				НаимВидаДрагМатериала = ЗначенияРеквизитовВидаДрагМатериала.Наименование;
				КодВидаДрагМатериала = ЗначенияРеквизитовВидаДрагМатериала.Код;
			КонецЕсли;	
			СтрокаСпискаДрагМатериаловXDTO.Установить("ПолноеНаимВидаДрагоценногоМатериала", XMLстрока(НаимВидаДрагМатериала));
			СтрокаСпискаДрагМатериаловXDTO.Установить("КодВидаДрагоценногоМатериала", XMLстрока(КодВидаДрагМатериала));
			
			ЕдИзмНаим = "";
			ЕдИзмКод = "";
			ЕдИзм = ТекДрагМатериал.ЕдИзм;
			Если ЗначениеЗаполнено(ЕдИзм) Тогда
				РеквизитыЕдИзм = "Наименование, Код";
				ЗначенияРеквизитовЕдИзм = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЕдИзм, РеквизитыЕдИзм);
				ЕдИзмНаим = ЗначенияРеквизитовЕдИзм.Наименование;
				ЕдИзмКод = ЗначенияРеквизитовЕдИзм.Код;
			КонецЕсли;	
			СтрокаСпискаДрагМатериаловXDTO.Установить("ЕдИзмНаим", XMLстрока(ЕдИзмНаим));
			СтрокаСпискаДрагМатериаловXDTO.Установить("ЕдИзмКод", XMLстрока(ЕдИзмКод));
			
			СтрокаСпискаДрагМатериаловXDTO.Установить("МассаВДетали", ТекДрагМатериал.МассаДМВДетали);
			СтрокаСпискаДрагМатериаловXDTO.Установить("МассаЛигатурнаяДетали", ТекДрагМатериал.ЛигатурнаяМассаДетали);
			СтрокаСпискаДрагМатериаловXDTO.Установить("КоличествоВДетали", ТекДрагМатериал.КоличествоДМВДетали);
			СтрокаСпискаДрагМатериаловXDTO.Установить("КоличествоДеталей", ТекДрагМатериал.КоличествоДеталей);
			СтрокаСпискаДрагМатериаловXDTO.Установить("Масса", ТекДрагМатериал.МассаДМ);
			СтрокаСпискаДрагМатериаловXDTO.Установить("Количество", ТекДрагМатериал.КоличествоДМ);
			СтрокаСпискаДрагМатериаловXDTO.Установить("ЛигатурнаяМасса", ТекДрагМатериал.ЛигатурнаяМасса);
			
			ПаспортныеДанныеДрагМатериалыXDTO.СодержаниеДрагМатериалов.Добавить(СтрокаСпискаДрагМатериаловXDTO);
		КонецЦикла;	
		
		ДокументXDTO.СведенияТехДокументацииОСодержанииДрагМатериалов.Добавить(ПаспортныеДанныеДрагМатериалыXDTO);
		
	КонецЦикла;
	
	//СведенияКадастровогоУчета
	
	Для Каждого СтрокаТаблицы Из СведенияКадастровогоУчета Цикл
		Номенклатура = СтрокаТаблицы.ОсновноеСредство;
		ИнвентарныйНомер = СтрокаТаблицы.ИнвентарныйНомер;
		
		СтрокаТаблицыXDTO = СоздатьОбъектXDTO(ТаблицаXDTO, "СведенияКадастровогоУчета");
		СтрокаТаблицыXDTO.Установить("ИнвентарныйНомер", Строка(ИнвентарныйНомер));
		
