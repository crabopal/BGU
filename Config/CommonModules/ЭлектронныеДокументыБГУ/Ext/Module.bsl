Процедура ЗаполнитьРегистрационныеДанныеОрганизации(Организация, ДанныеОрганизации) Экспорт
	Если ТипЗнч(Организация) = Тип("СправочникСсылка.Контрагенты") Тогда
		СвойстваОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Организация, 
				"Наименование, НаименованиеСокращенное, ИНН, КПП, ЮридическоеФизическоеЛицо");
		
		ИНН = СвойстваОрганизации.ИНН;
		КПП = СвойстваОрганизации.КПП;
		НаименованиеПолное = "";
		ОГРН = "";
		Если ЗначениеЗаполнено(СвойстваОрганизации.ЮридическоеФизическоеЛицо) Тогда
			Если ТипЗнч(СвойстваОрганизации.ЮридическоеФизическоеЛицо) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
				СтруктураДанныхЮЛ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СвойстваОрганизации.ЮридическоеФизическоеЛицо, "Наименование, ОГРНИП");
				ОГРН = СтруктураДанныхЮЛ.ОГРНИП;
				НаименованиеПолное = СтруктураДанныхЮЛ.Наименование;
			Иначе	
				СтруктураДанныхЮЛ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СвойстваОрганизации.ЮридическоеФизическоеЛицо, "НаименованиеПолное, ОГРН");
				ОГРН = СтруктураДанныхЮЛ.ОГРН;
				НаименованиеПолное = СтруктураДанныхЮЛ.НаименованиеПолное;
			КонецЕсли;
		КонецЕсли;	
		ДанныеОрганизации.Вставить("Наименование"   , ?(ЗначениеЗаполнено(СвойстваОрганизации.НаименованиеСокращенное), СвойстваОрганизации.НаименованиеСокращенное, НаименованиеПолное));
		ДанныеОрганизации.Вставить("ИНН"            , ИНН);
		ДанныеОрганизации.Вставить("КПП"            , КПП);
		ДанныеОрганизации.Вставить("ОГРН"           , ОГРН);
		
		Возврат
	КонецЕсли;	
	
	СвойстваОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Организация, 
			"Наименование, НаименованиеПолное, НаименованиеСокращенное, ИНН, КПП, ОГРН, КодНалоговогоОргана");
	
	ДанныеОрганизации.Вставить("ОрганизацияСсылка", Организация);
	
	ДанныеОрганизации.Вставить("Наименование"   , ?(ЗначениеЗаполнено(СвойстваОрганизации.НаименованиеСокращенное), СвойстваОрганизации.НаименованиеСокращенное, СвойстваОрганизации.НаименованиеПолное));
	ДанныеОрганизации.Вставить("ИНН"            , СвойстваОрганизации.ИНН);
	ДанныеОрганизации.Вставить("КПП"            , СвойстваОрганизации.КПП);
	ДанныеОрганизации.Вставить("ОГРН"           , СвойстваОрганизации.ОГРН);
	ДанныеОрганизации.Вставить("КодИМНС"        , СвойстваОрганизации.КодНалоговогоОргана);
	
	ДанныеОрганизации.Вставить("ЮрФизЛицо"      , "ЮрЛицо");
	
	Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации("Руководитель", Организация, ТекущаяДата(),);
	
	ДанныеОрганизации.Вставить("Фамилия" , Руководитель.ОтветственноеЛицоФамилия);
	ДанныеОрганизации.Вставить("Имя"     , Руководитель.ОтветственноеЛицоИмя);
	ДанныеОрганизации.Вставить("Отчество", Руководитель.ОтветственноеЛицоОтчество);
	ДанныеОрганизации.Вставить("Должность", Руководитель.ДолжностьПредставление);
	
	ВидКонтактнойИнформации = Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации;
	
	ДанныеОрганизации.Вставить("Индекс"         , "");
	ДанныеОрганизации.Вставить("Регион"         , "");
	ДанныеОрганизации.Вставить("КодРегиона"     , "");
	ДанныеОрганизации.Вставить("Район"          , "");
	ДанныеОрганизации.Вставить("Город"          , "");
	ДанныеОрганизации.Вставить("НаселенныйПункт", "");
	ДанныеОрганизации.Вставить("Улица"          , "");
	ДанныеОрганизации.Вставить("Дом"            , "");
	ДанныеОрганизации.Вставить("Корпус"         , "");
	ДанныеОрганизации.Вставить("Квартира"       , "");
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КонтактнаяИнформация.Значение
	|ИЗ
	|	Справочник.Организации.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Ссылка = &Ссылка
	|	И КонтактнаяИнформация.Вид = &Вид";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", Организация);
	Запрос.УстановитьПараметр("Вид",    ВидКонтактнойИнформации);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		АдресСтруктурой = РаботаСАдресами.СведенияОбАдресе(Выборка.Значение);
		Если АдресСтруктурой.Свойство("Индекс") Тогда
			ДанныеОрганизации.Индекс = АдресСтруктурой.Индекс;
		КонецЕсли;
		Если АдресСтруктурой.Свойство("Регион") Тогда
			ДанныеОрганизации.Регион = АдресСтруктурой.Регион;
		КонецЕсли;
		Если АдресСтруктурой.Свойство("КодРегиона") Тогда
			ДанныеОрганизации.КодРегиона = АдресСтруктурой.КодРегиона;
		КонецЕсли;
		Если АдресСтруктурой.Свойство("Район") Тогда
			ДанныеОрганизации.Район = АдресСтруктурой.Район;
		КонецЕсли;
		Если АдресСтруктурой.Свойство("Город") Тогда
			ДанныеОрганизации.Город = АдресСтруктурой.Город;
		КонецЕсли;
		Если АдресСтруктурой.Свойство("НаселенныйПункт") Тогда
			ДанныеОрганизации.НаселенныйПункт = АдресСтруктурой.НаселенныйПункт;
		КонецЕсли;
		Если АдресСтруктурой.Свойство("Улица") Тогда
			ДанныеОрганизации.Улица = АдресСтруктурой.Улица;
		КонецЕсли;
		Если АдресСтруктурой.Свойство("Здание") И ЗначениеЗаполнено(АдресСтруктурой.Здание) Тогда
			ДанныеОрганизации.Дом = АдресСтруктурой.Здание.Номер;
		КонецЕсли;
		Если АдресСтруктурой.Свойство("Корпуса") И ЗначениеЗаполнено(АдресСтруктурой.Корпуса) Тогда
			ДанныеОрганизации.Корпус = АдресСтруктурой.Корпуса[0].Номер;
		КонецЕсли;
		Если АдресСтруктурой.Свойство("Помещения") И ЗначениеЗаполнено(АдресСтруктурой.Помещения) Тогда
			ДанныеОрганизации.Квартира = АдресСтруктурой.Помещения[0].Номер;
		КонецЕсли;
		
	КонецЕсли;
	
	ТаблицаКИ = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Организация,,,Ложь);
	
	Для Каждого СтрокаТаблицыКИ Из ТаблицаКИ Цикл
		
		Если СтрокаТаблицыКИ.Вид = Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации Тогда
			
			ДанныеОрганизации.Вставить("АдресXML", СтрокаТаблицыКИ.ЗначенияПолей);
			
		КонецЕсли;
	КонецЦикла;		
	
	ТелефонОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Организация, Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации);
	
	ДанныеОрганизации.Вставить("Телефон", ТелефонОрганизации);
	
КонецПроцедуры

Процедура ПередЗаписьюВладельцаЭлектронногоДокумента(Объект, ИзменилисьКлючевыеРеквизиты, Знач СостояниеЭлектронногоДокумента, ПодлежитОбменуЭД, ТребуетсяКонтрольАктуальности, Отказ) Экспорт

	//Для ЭПД проверки не нужны
	Если ЭтоЭлектронныеПеревозочныеДокументы(Объект) Тогда
		Возврат;
	КонецЕсли;
	
	Если ДляДокументаНеСоздаватьЭД(Объект) Тогда
		ПодлежитОбменуЭД = Ложь;
		Возврат;
	КонецЕсли;
	
	Если НЕ ДляДокументаНеобходимоФормироватьУПД(Объект) Тогда
		ПодлежитОбменуЭД = Ложь;
		Возврат;
	КонецЕсли;
	
	Если Объект.ДополнительныеСвойства.Свойство("ИзменилисьКлючевыеРеквизиты")
		И Объект.ДополнительныеСвойства.ИзменилисьКлючевыеРеквизиты Тогда
		ИзменилисьКлючевыеРеквизиты = Истина;
		Возврат;
	КонецЕсли;
	
	Если ИзмененыКлючевыеРеквизитыОбъекта(Объект) Тогда
		ИзменилисьКлючевыеРеквизиты = Истина;
	КонецЕсли;
	
	Объект.ДополнительныеСвойства.Вставить("ИзменилисьКлючевыеРеквизиты", ИзменилисьКлючевыеРеквизиты);
	
	ДокументПроведен = Неопределено;
	Если Объект.ДополнительныеСвойства.Свойство("ДокументПроведен", ДокументПроведен) Тогда
		Если Не ДокументПроведен 
			И (СостояниеЭлектронногоДокумента = Перечисления.СостоянияДокументовЭДО.НеСформирован
			ИЛИ Не ЗначениеЗаполнено(СостояниеЭлектронногоДокумента)) Тогда
			ПодлежитОбменуЭД = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	// Если это внутренний электронный документ, то он не подлежит обмену БЭД
	Если ВнутренниеЭлектронныеДокументыБГУ.ЭтоВнутреннийДокументЭДО(ТипЗнч(Объект.Ссылка)) Тогда
		ТребуетсяКонтрольАктуальности = Ложь;
		Если Объект.ЭтоНовый() Тогда
			ПодлежитОбменуЭД = Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписьюВладельцаЭлектронногоДокументаЭлементСправочника(Объект, ИзменилисьКлючевыеРеквизиты,
	Знач СостояниеЭлектронногоДокумента, ПодлежитОбменуЭД, ТребуетсяКонтрольАктуальности, Отказ) Экспорт

	Если Объект.ДополнительныеСвойства.Свойство("ИзменилисьКлючевыеРеквизиты")
		И Объект.ДополнительныеСвойства.ИзменилисьКлючевыеРеквизиты Тогда
		ИзменилисьКлючевыеРеквизиты = Истина;
		Возврат;
	КонецЕсли;
	
	Если ИзмененыКлючевыеРеквизитыОбъекта(Объект) Тогда
		ИзменилисьКлючевыеРеквизиты = Истина;
	КонецЕсли;
	
	Объект.ДополнительныеСвойства.Вставить("ИзменилисьКлючевыеРеквизиты", ИзменилисьКлючевыеРеквизиты);
	
	Если НЕ ДляДокументаНеобходимоФормироватьЭлектронныйДоговор(Объект) Тогда
		ПодлежитОбменуЭД = Истина;
		Возврат;
	КонецЕсли;	
	
КонецПроцедуры

// Сравнивает значения ключевых реквизитов объекта с данными информационной базы.
//
// Параметры:
//  Объект - ДокументОбъект - владелец электронного документа.
//
// Возвращаемое значение:
//  Булево - Истина, если значения реквизитов различаются.
//
Функция ИзмененыКлючевыеРеквизитыОбъекта(Объект) Экспорт
	
	МетаданныеОбъекта = Объект.Метаданные();
	ИмяОбъекта = МетаданныеОбъекта.ПолноеИмя();
	
	СтруктураКлючевыхРеквизитов = Новый Структура;
	
	Если ИмяОбъекта = "Документ.НакладнаяНаРеализациюТорг12" Тогда
		СтрокаРеквизитовОбъекта = ("Дата, Номер, Организация, Контрагент, ВалютаДокумента");
		СтруктураКлючевыхРеквизитов.Вставить("Шапка", СтрокаРеквизитовОбъекта);
		
		СтрокаРеквизитовОбъекта = ("Количество, Номенклатура, Цена, Всего");
		СтруктураКлючевыхРеквизитов.Вставить("Номенклатура", СтрокаРеквизитовОбъекта);
		СтрокаРеквизитовОбъекта = ("Количество, Номенклатура, Сумма");
		СтруктураКлючевыхРеквизитов.Вставить("ВозвратнаяТара", СтрокаРеквизитовОбъекта);
		
	ИначеЕсли ИмяОбъекта = "Документ.НакладнаяНаОтпускМ15" Тогда
		СтрокаРеквизитовОбъекта = ("Дата, Номер, Организация, Контрагент, ВалютаДокумента");
		СтруктураКлючевыхРеквизитов.Вставить("Шапка", СтрокаРеквизитовОбъекта);
		
		СтрокаРеквизитовОбъекта = ("Количество, Номенклатура, Цена, Всего");
		СтруктураКлючевыхРеквизитов.Вставить("Материалы", СтрокаРеквизитовОбъекта);

	ИначеЕсли ИмяОбъекта = "Документ.ПередачаОбъектовОС" Тогда
		СтрокаРеквизитовОбъекта = ("Дата, Номер, Организация, Контрагент, ВалютаДокумента");
		СтруктураКлючевыхРеквизитов.Вставить("Шапка", СтрокаРеквизитовОбъекта);
		
		СтрокаРеквизитовОбъекта = ("Количество, ОсновноеСредство, ЦенаПродажи, Всего");
		СтруктураКлючевыхРеквизитов.Вставить("ОсновныеСредства", СтрокаРеквизитовОбъекта);
		
	ИначеЕсли ИмяОбъекта = "Документ.ПередачаОбъектовИК" Тогда
		СтрокаРеквизитовОбъекта = ("Дата, Номер, Организация, Контрагент, ВалютаДокумента");
		СтруктураКлючевыхРеквизитов.Вставить("Шапка", СтрокаРеквизитовОбъекта);
		
		СтрокаРеквизитовОбъекта = ("Количество, ОсновноеСредство, ЦенаПродажи, Всего");
		СтруктураКлючевыхРеквизитов.Вставить("ОсновныеСредства", СтрокаРеквизитовОбъекта);

	ИначеЕсли ИмяОбъекта = "Документ.ЭлектронныйДокументПоставщика" Тогда
		СтрокаРеквизитовОбъекта = ("Дата, Номер, Организация, Контрагент, ВалютаДокумента");
		СтруктураКлючевыхРеквизитов.Вставить("Шапка", СтрокаРеквизитовОбъекта);
		
		СтрокаРеквизитовОбъекта = ("Номенклатура, Количество, Всего");
		СтруктураКлючевыхРеквизитов.Вставить("СписокНоменклатуры", СтрокаРеквизитовОбъекта);
		
	ИначеЕсли ИмяОбъекта = "Документ.АктОбОказанииУслуг" Тогда
		СтрокаРеквизитовОбъекта = ("Дата, Номер, Организация, Контрагент, ВалютаДокумента");
		СтруктураКлючевыхРеквизитов.Вставить("Шапка", СтрокаРеквизитовОбъекта);
		
		СтрокаРеквизитовОбъекта = ("Количество, Номенклатура, СодержаниеУслуги, Цена, Всего");
		СтруктураКлючевыхРеквизитов.Вставить("УслугиОказанные", СтрокаРеквизитовОбъекта);
		
	ИначеЕсли ИмяОбъекта = "Документ.ПоступлениеУслугРабот" Тогда
		СтрокаРеквизитовОбъекта = ("Дата, Номер, Организация, Контрагент, ВалютаДокумента");
		СтруктураКлючевыхРеквизитов.Вставить("Шапка", СтрокаРеквизитовОбъекта);
		
		СтрокаРеквизитовОбъекта = ("Количество, Номенклатура, Содержание, Всего");
		СтруктураКлючевыхРеквизитов.Вставить("УслугиИРаботы", СтрокаРеквизитовОбъекта);
		
	ИначеЕсли ИмяОбъекта = "Документ.СчетНаОплату" Тогда
		СтрокаРеквизитовОбъекта = ("Дата, Номер, Организация, Контрагент, ВалютаДокумента");
		СтруктураКлючевыхРеквизитов.Вставить("Шапка", СтрокаРеквизитовОбъекта);
		
		СтрокаРеквизитовОбъекта = ("Количество, Номенклатура, Цена, Всего");
		СтруктураКлючевыхРеквизитов.Вставить("Материалы", СтрокаРеквизитовОбъекта);
		СтруктураКлючевыхРеквизитов.Вставить("Услуги", СтрокаРеквизитовОбъекта);
		СтрокаРеквизитовОбъекта = ("Количество, ОС, Цена, Всего");
		СтруктураКлючевыхРеквизитов.Вставить("ОсновныеСредства", СтрокаРеквизитовОбъекта);
		СтрокаРеквизитовОбъекта = ("Количество, Номенклатура, Цена, Сумма");
		СтруктураКлючевыхРеквизитов.Вставить("ВозвратнаяТара", СтрокаРеквизитовОбъекта);
		
	ИначеЕсли ИмяОбъекта = "Документ.СчетНаОплатуОтПоставщика" Тогда
		СтрокаРеквизитовОбъекта = ("Дата, Номер, Организация, Контрагент, ВалютаДокумента");
		СтруктураКлючевыхРеквизитов.Вставить("Шапка", СтрокаРеквизитовОбъекта);
		
	ИначеЕсли ИмяОбъекта = "Документ.СчетФактураВыданный" Тогда
		СтрокаРеквизитовОбъекта = ("Дата, Номер, Организация, Контрагент, СуммаДокумента");
		СтруктураКлючевыхРеквизитов.Вставить("Шапка", СтрокаРеквизитовОбъекта);
		
	ИначеЕсли ИмяОбъекта = "Документ.ИсправительныйСчетФактураВыданный" Тогда
		СтрокаРеквизитовОбъекта = ("Дата, Номер, Организация, Контрагент");
		СтруктураКлючевыхРеквизитов.Вставить("Шапка", СтрокаРеквизитовОбъекта);
		
	ИначеЕсли ИмяОбъекта = "Документ.СчетФактураПолученный" Тогда
		СтрокаРеквизитовОбъекта = ("Дата, Номер, Организация, Контрагент, СуммаДокумента");
		СтруктураКлючевыхРеквизитов.Вставить("Шапка", СтрокаРеквизитовОбъекта);
		
	ИначеЕсли ИмяОбъекта = "Документ.ИсправительныйСчетФактураПолученный" Тогда
		СтрокаРеквизитовОбъекта = ("Дата, Номер, Организация, Контрагент");
		СтруктураКлючевыхРеквизитов.Вставить("Шапка", СтрокаРеквизитовОбъекта);
		
	ИначеЕсли ИмяОбъекта = "Документ.КорректировочныйСчетФактураВыданный" Тогда
		СтрокаРеквизитовОбъекта = ("Дата, Номер, Организация, Контрагент");
		СтруктураКлючевыхРеквизитов.Вставить("Шапка", СтрокаРеквизитовОбъекта);
		
	ИначеЕсли ИмяОбъекта = "Документ.КорректировочныйСчетФактураПолученный" Тогда
		СтрокаРеквизитовОбъекта = ("Дата, Номер, Организация, Контрагент");
		СтруктураКлючевыхРеквизитов.Вставить("Шапка", СтрокаРеквизитовОбъекта);
		
	ИначеЕсли ИмяОбъекта = "Документ.ЭлектронныйПередаточныйДокументУслугиРаботы" Тогда
		СтрокаРеквизитовОбъекта = ("Дата, Номер, Организация, Контрагент");
		СтруктураКлючевыхРеквизитов.Вставить("Шапка", СтрокаРеквизитовОбъекта);
		
	ИначеЕсли ИмяОбъекта = "Документ.АктСверкиВзаиморасчетов" Тогда
		СтрокаРеквизитовОбъекта = ("Дата, Номер, Организация, Контрагент, ВалютаДокумента, ЭтоЭлектронныйДокумент, ЭтоДокументКонтрагента, НомерВходящегоДокумента, ДатаВходящегоДокумента, ДатаНачала, ДатаОкончания");
		СтруктураКлючевыхРеквизитов.Вставить("Шапка", СтрокаРеквизитовОбъекта);
	ИначеЕсли ИмяОбъекта = "Справочник.Договоры" Тогда
		СтрокаРеквизитовОбъекта = "ДатаДоговора,
			|НомерДоговора, Организация, Контрагент";
		СтруктураКлючевыхРеквизитов.Вставить("Шапка", СтрокаРеквизитовОбъекта);	
	КонецЕсли;
	
	Возврат ИзмененыРеквизитыОбъекта(Объект, СтруктураКлючевыхРеквизитов);
	
КонецФункции

Функция ИзмененыРеквизитыОбъекта(Знач Объект, Знач Реквизиты)
	
	МетаданныеОбъекта = Объект.Метаданные();
	
	ТаблицаРеквизитов = ТаблицаРеквизитовОбъектов();
	
	ТекущийПорядок = -50;
	Для Каждого Реквизит Из Реквизиты Цикл
		
		СтрокаРеквизитов = ТаблицаРеквизитов.Добавить();
		СтрокаРеквизитов.Порядок  = ТекущийПорядок;
		СтрокаРеквизитов.ИмяОбъекта = МетаданныеОбъекта.ПолноеИмя();
		СтрокаРеквизитов.ИмяТабличнойЧасти = ?(Реквизит.Ключ = "Шапка", "", Реквизит.Ключ);
		СтрокаРеквизитов.РеквизитыОбъекта = Реквизит.Значение;
		СтрокаРеквизитов.СтруктураРеквизитовОбъекта = Новый Структура(Реквизит.Значение);
		ТекущийПорядок = ТекущийПорядок + 100;
		
	КонецЦикла;
	
	ТаблицаРеквизитов.Сортировать("Порядок Возр");
	
	Для Каждого СтрокаРеквизитов Из ТаблицаРеквизитов Цикл
		
		ЕстьИзмененияВерсийОбъектов = ОпределитьИзмененияВерсийОбъекта(Объект, СтрокаРеквизитов);
		
		Если ЕстьИзмененияВерсийОбъектов Тогда
			Возврат Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ТаблицаРеквизитовОбъектов()
	
	ТаблицаРеквизитов = Новый ТаблицаЗначений;
	
	Колонки = ТаблицаРеквизитов.Колонки;
	Колонки.Добавить("Порядок",                    Новый ОписаниеТипов("Число"));
	Колонки.Добавить("ИмяОбъекта",                 Новый ОписаниеТипов("Строка"));
	Колонки.Добавить("ИмяТабличнойЧасти",          Новый ОписаниеТипов("Строка"));
	Колонки.Добавить("РеквизитыОбъекта",           Новый ОписаниеТипов("Строка"));
	Колонки.Добавить("СтруктураРеквизитовОбъекта", Новый ОписаниеТипов("Структура"));
	
	ТаблицаРеквизитов.Индексы.Добавить("ИмяОбъекта");
	
	Возврат ТаблицаРеквизитов;
	
КонецФункции

Функция ОпределитьИзмененияВерсийОбъекта(Объект, СтрокаТаблицыРеквизитовРегистрации)
	
	Если ПустаяСтрока(СтрокаТаблицыРеквизитовРегистрации.ИмяТабличнойЧасти) Тогда
		
		ТаблицаРеквизитовРегистрацииВерсияОбъектаДоИзменения = РеквизитыРегистрацииШапкиДоИзменения(Объект,
			СтрокаТаблицыРеквизитовРегистрации);
		ТаблицаРеквизитовРегистрацииВерсияОбъектаПослеИзменения = РеквизитыРегистрацииШапкиПослеИзменения(
			Объект, СтрокаТаблицыРеквизитовРегистрации);
	Иначе
		
		ТаблицаРеквизитовРегистрацииВерсияОбъектаДоИзменения = РеквизитыРегистрацииТабличнойЧастиДоИзменения(
			Объект, СтрокаТаблицыРеквизитовРегистрации);
		ТаблицаРеквизитовРегистрацииВерсияОбъектаПослеИзменения = РеквизитыРегистрацииТабличнойЧастиПослеИзменения(
			Объект, СтрокаТаблицыРеквизитовРегистрации);
	КонецЕсли;
	
	Возврат НЕ ТаблицыРеквизитовОбъектовОдинаковые(ТаблицаРеквизитовРегистрацииВерсияОбъектаДоИзменения,
												   ТаблицаРеквизитовРегистрацииВерсияОбъектаПослеИзменения,
												   СтрокаТаблицыРеквизитовРегистрации.РеквизитыОбъекта);
	
КонецФункции

// Проверяет переданные таблицы реквизитов на совпадения.
//
// Параметры:
//  Таблица1 - ТаблицаЗначений - первая таблица проверки, реквизиты, которые надо проверить на совпадение.
//  Таблица2 - ТаблицаЗначений - вторая таблица проверки.
//  РеквизитыОбъекта - Строка - реквизиты, перечисленные через запятую.
//  ДопПараметры - Структура - структура дополнительных параметров, по которым надо проводить сравнение.
//
Функция ТаблицыРеквизитовОбъектовОдинаковые(Таблица1, Таблица2, РеквизитыОбъекта, ДопПараметры = Неопределено)
	
	ДобавитьИтераторТаблице(Таблица1, +1);
	ДобавитьИтераторТаблице(Таблица2, -1);
	
	ТаблицаРезультат = Таблица1.Скопировать();
	
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(Таблица2, ТаблицаРезультат);
	
	ТаблицаРезультат.Свернуть(РеквизитыОбъекта, "ИтераторТаблицыРеквизитовОбъекта");
	
	КоличествоОдинаковыхСтрок = ТаблицаРезультат.НайтиСтроки(Новый Структура("ИтераторТаблицыРеквизитовОбъекта", 0)).Количество();
	
	КоличествоСтрокТаблицы = ТаблицаРезультат.Количество();
	ПризнакСовпадения = КоличествоОдинаковыхСтрок = КоличествоСтрокТаблицы;
	
	Если НЕ ПризнакСовпадения И ЗначениеЗаполнено(ДопПараметры) Тогда
		Если ДопПараметры.Свойство("ИмяТабличнойЧасти") Тогда
			ИмяТабличнойЧасти = ДопПараметры.ИмяТабличнойЧасти;
		КонецЕсли;
		Если ДопПараметры.Свойство("СтрокаДереваСравнения") Тогда
			СтрокаДереваСравнения = ДопПараметры.СтрокаДереваСравнения;
		КонецЕсли;
		
		Если ИмяТабличнойЧасти = "Шапка" Тогда
			
			НовСтрокаДереваМесто = СтрокаДереваСравнения.Строки.Добавить();
			НовСтрокаДереваМесто.Место = НСтр("ru ='Реквизиты шапки'");
			Для Каждого ТекСтрокаТаб1 Из Таблица1 Цикл
				Для Каждого ТекКолонка Из Таблица1.Колонки Цикл
					ИмяКолонки = ТекКолонка.Имя;
					Если ИмяКолонки = "ИтераторТаблицыРеквизитовОбъекта" Тогда
						Продолжить;
					КонецЕсли;
					НайденнаяСтрокаТаб2 = Таблица2.Найти( - ТекСтрокаТаб1.ИтераторТаблицыРеквизитовОбъекта,
						"ИтераторТаблицыРеквизитовОбъекта");
					Если НЕ ЗначениеЗаполнено(НайденнаяСтрокаТаб2) 
						ИЛИ	НайденнаяСтрокаТаб2[ИмяКолонки] = ТекСтрокаТаб1[ИмяКолонки] Тогда
						Продолжить;
					КонецЕсли;
					НовСтрокаДереваРеквизита = НовСтрокаДереваМесто.Строки.Добавить();
					НовСтрокаДереваРеквизита.Реквизит  = ИмяКолонки;
					НовСтрокаДереваЗнч            = НовСтрокаДереваРеквизита.Строки.Добавить();
					НовСтрокаДереваЗнч.ЗначениеБД = ТекСтрокаТаб1[ИмяКолонки];
					НовСтрокаДереваЗнч.ЗначениеЭД = НайденнаяСтрокаТаб2[ИмяКолонки];
					
				КонецЦикла;
			КонецЦикла;
		Иначе
			НовСтрокаДереваМесто = СтрокаДереваСравнения.Строки.Добавить();
			НовСтрокаДереваМесто.Место = СтрШаблон(НСтр("ru ='Табличная часть <%1>'"), ИмяТабличнойЧасти);
			НовСтрокаДереваРеквизита = НовСтрокаДереваМесто.Строки.Добавить();
			НовСтрокаДереваРеквизита.Реквизит = "<Изменена>";
		КонецЕсли;
	КонецЕсли;
	
	Возврат ПризнакСовпадения;
	
КонецФункции

Процедура ДобавитьИтераторТаблице(Таблица, ЗначениеИтератора)
	
	Таблица.Колонки.Добавить("ИтераторТаблицыРеквизитовОбъекта");
	Таблица.ЗаполнитьЗначения(ЗначениеИтератора, "ИтераторТаблицыРеквизитовОбъекта");
	
КонецПроцедуры

Функция РеквизитыРегистрацииТабличнойЧастиПослеИзменения(Объект, СтрокаТаблицыРеквизитовРегистрации)
	
	ТаблицаРеквизитовРегистрации = Объект[СтрокаТаблицыРеквизитовРегистрации.ИмяТабличнойЧасти].Выгрузить(,
		СтрокаТаблицыРеквизитовРегистрации.РеквизитыОбъекта);
		
	Возврат ТаблицаРеквизитовРегистрации;
	
КонецФункции

Функция РеквизитыРегистрацииТабличнойЧастиДоИзменения(Объект, СтрокаТаблицыРеквизитовРегистрации)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ "+ СтрокаТаблицыРеквизитовРегистрации.РеквизитыОбъекта + " ИЗ "
	+ СтрокаТаблицыРеквизитовРегистрации.ИмяОбъекта + "." + СтрокаТаблицыРеквизитовРегистрации.ИмяТабличнойЧасти
	+ " КАК ТекущийОбъектИмяТабличнойЧасти
	|ГДЕ
	|	ТекущийОбъектИмяТабличнойЧасти.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	
	Возврат Запрос.Выполнить().Выгрузить();
		
КонецФункции

Функция РеквизитыРегистрацииШапкиПослеИзменения(Объект, СтрокаТаблицыРеквизитовРегистрации)
	
	ТаблицаРеквизитовРегистрации = Новый ТаблицаЗначений;
	
	СтруктураРеквизитовРегистрации = СтрокаТаблицыРеквизитовРегистрации.СтруктураРеквизитовОбъекта;
	Для Каждого РеквизитРегистрации Из СтруктураРеквизитовРегистрации Цикл
		ТаблицаРеквизитовРегистрации.Колонки.Добавить(РеквизитРегистрации.Ключ);
	КонецЦикла;
	
	СтрокаТаблицы = ТаблицаРеквизитовРегистрации.Добавить();
	Для Каждого РеквизитРегистрации Из СтруктураРеквизитовРегистрации Цикл
		
		СтрокаТаблицы[РеквизитРегистрации.Ключ] = Объект[РеквизитРегистрации.Ключ];
	КонецЦикла;
	
	Возврат ТаблицаРеквизитовРегистрации;
	
КонецФункции

Функция РеквизитыРегистрацииШапкиДоИзменения(Объект, СтрокаТаблицыРеквизитовРегистрации)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ " + СтрокаТаблицыРеквизитовРегистрации.РеквизитыОбъекта + " ИЗ "
	+ СтрокаТаблицыРеквизитовРегистрации.ИмяОбъекта + " КАК ТекущийОбъект
	|ГДЕ
	|	ТекущийОбъект.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	
	Возврат Запрос.Выполнить().Выгрузить();
		
КонецФункции

Функция СравнитьДанныеОбъекта(ДанныеЭД, ДокументУчета, БезСообщенийОбОтсутствииРасхождений, СпособОбработки = "", НастройкаЭДО = Неопределено) Экспорт
	
	ДокументыУчета = Неопределено;
	
	ДеревоДанныхЭД = ДанныеЭД.ДанныеОтправителя.Содержание;
	
	Если СтрНачинаетсяС(ДанныеЭД.ДанныеОтправителя.Формат, "ON_NSCHFDOPPR_1_997_01_05_03") Тогда
		СравнитьСчетФактуруИЭДУПД_5_03(ДеревоДанныхЭД, ДокументУчета, , СпособОбработки, , БезСообщенийОбОтсутствииРасхождений);
	Иначе
		ФорматСчетаФактуры = 2019;
		СравнитьСчетФактуруИЭД(ДеревоДанныхЭД, ДокументУчета, , СпособОбработки, , БезСообщенийОбОтсутствииРасхождений, ФорматСчетаФактуры);
	КонецЕсли;
	
	ДокументыУчета = Новый Массив;
	ДокументыУчета.Добавить(ДокументУчета);
	
	Возврат ДокументыУчета;
	
КонецФункции

Процедура СравнитьСчетФактуруИЭД(ДеревоДанных, СсылкаНаВладельца = Неопределено, Записывать = Истина, СпособОбработки = "", ВидПервичногоДокумента = "", БезСообщенийОбОтсутствииРасхождений, ФорматСчетаФактуры) Экспорт
	
	Если ТипСчетФактурыУПД(ДеревоДанных) = "ИсправлениеРеализации" Тогда
		Возврат;
	ИначеЕсли ТипСчетФактурыУПД(ДеревоДанных) = "ИсправлениеКорректировки" Тогда	
		Возврат;
	КонецЕсли;	
		
	ДанныеЗаполненияШапки = Новый Структура;
	ДанныеЗаполненияШапки.Вставить("ЭДПоставщика", Документы.ЭлектронныйДокументПоставщика.ПустаяСсылка());
	
	ДокументыОснованияСчетаФактуры = ЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияСчетаФактуры");
	
	ТаблицаОснований = Новый ТаблицаЗначений;
	ТаблицаОснований = Документы.СчетФактураПолученный.ПустаяСсылка().ДокументыОснования.ВыгрузитьКолонки();
	Если ЗначениеЗаполнено(ДокументыОснованияСчетаФактуры) Тогда
		Для Каждого ДокументОснования Из ДокументыОснованияСчетаФактуры Цикл
			Если ТипЗнч(ДокументОснования) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда
				ДанныеЗаполненияШапки.ЭДПоставщика = ДокументОснования;
			Иначе	
				СтрокаТаблицы = ТаблицаОснований.Добавить();
				СтрокаТаблицы.ДокументОснование = ДокументОснования;
			КонецЕсли;	
			
		КонецЦикла;
	КонецЕсли;
	ТаблицаОснований.Свернуть("ДокументОснование");
	
	Если ТаблицаОснований.Количество() = 0 Тогда
		ТекстоваяИнформация = ДеревоДанных.Строки.Найти("ДопДанныеДокументаОтгрузки.ТекстоваяИнформация", "ПолныйПуть", Истина);
		ВидДокументаОснования = "";
		НомерДокументаОснования = "";
		ДатаДокументаОснования = Дата(1,1,1);
		Если ТекстоваяИнформация <> Неопределено Тогда
			Для Каждого СтрокаТекстовойИнформации Из ТекстоваяИнформация.Строки Цикл
				Если ЗначениеРеквизитаВДереве(СтрокаТекстовойИнформации, 
							"ДопДанныеДокументаОтгрузки.ТекстоваяИнформация.НомерСтроки.Идентификатор") = "ВидДокументаОснования" Тогда
					ВидДокументаОснования = ЗначениеРеквизитаВДереве(СтрокаТекстовойИнформации,
							"ДопДанныеДокументаОтгрузки.ТекстоваяИнформация.НомерСтроки.Значение");
				КонецЕсли;
				Если ЗначениеРеквизитаВДереве(СтрокаТекстовойИнформации, 
							"ДопДанныеДокументаОтгрузки.ТекстоваяИнформация.НомерСтроки.Идентификатор") = "НомерДокументаОснования" Тогда
					НомерПервичногоДокумента = ЗначениеРеквизитаВДереве(СтрокаТекстовойИнформации,
							"ДопДанныеДокументаОтгрузки.ТекстоваяИнформация.НомерСтроки.Значение");
				КонецЕсли;
				Если ЗначениеРеквизитаВДереве(СтрокаТекстовойИнформации, 
							"ДопДанныеДокументаОтгрузки.ТекстоваяИнформация.НомерСтроки.Идентификатор") = "ДатаДокументаОснования" Тогда
					ДатаПервичногоДокумента = ЗначениеРеквизитаВДереве(СтрокаТекстовойИнформации,
							"ДопДанныеДокументаОтгрузки.ТекстоваяИнформация.НомерСтроки.Значение");
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;	
	ДанныеЗаполненияШапки.Вставить("ДокументыОснования", ТаблицаОснований);
	
	ДанныеЗаполненияШапки.Вставить("ДатаПолучения", ТекущаяДатаСеанса());
	
	НомерДокумента = ЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента");
	ДатаДокумента = ЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаДокумента");
	
	ВалКод = ЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаКод");
	Если НЕ ВалКод = "643" Тогда
		ДанныеЗаполненияШапки.Вставить("ВИностраннойВалюте", Истина);
	КонецЕсли;
	Валюта = Справочники.Валюты.ПустаяСсылка();
	НайтиСсылкуНаОбъект("Валюты", Валюта, ВалКод);
	ДанныеЗаполненияШапки.Вставить("ВалютаДокумента", Валюта);
	
	Контрагент = Справочники.Контрагенты.ПустаяСсылка();
	Если ФорматСчетаФактуры = 2019 Тогда
		СведенияОПродавце = ДеревоДанных.Строки.Найти("СведенияОПродавце", "ПолныйПуть");
		ОсновнаяСтрокаПродавца = Неопределено;
		Для каждого СтрокаПродавца Из СведенияОПродавце.Строки Цикл
			Контрагент = КонтрагентПоДаннымЭД(СтрокаПродавца, "СведенияОПродавце.НомерСтроки");
			ОсновнаяСтрокаПродавца = СтрокаПродавца;
			Прервать;
		КонецЦикла;
	Иначе	
		// Сведения о поставщике.
		ИННПоставщика = ""; КПППоставщика = "";
		ВидУчастника = "СведенияОПродавце";
		Если ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ЮЛ" Тогда
			
			ИННПоставщика = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.ИНН");
			КПППоставщика = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.КПП");
			ПредставлениеПоставщика = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.НаименованиеОрганизации");
			
		ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ФЛ" Тогда
			
			ИННПоставщика = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.ИНН");
			Фамилия = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Фамилия");
			Имя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Имя");
			Отчество = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Отчество");
			
			ПредставлениеПоставщика = Фамилия + " " + Имя + " " + Отчество; 
		ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ИП" Тогда
			
			ИННПоставщика = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИП.ИНН");
			
		ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ИЛ" Тогда
			
			ПредставлениеПоставщика = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИЛ.НаименованиеОрганизации");
		КонецЕсли;
		
		СсылкаНаОбъектПоИННКПП("Контрагенты", ИННПоставщика, КПППоставщика, Контрагент);
	КонецЕсли;	
	ДанныеЗаполненияШапки.Вставить("Контрагент", Контрагент);
	
	// Сведения о покупателе.
	Организация = Справочники.Организации.ПустаяСсылка();
	Если ФорматСчетаФактуры = 2019 Тогда
		СведенияОПокупателе = ДеревоДанных.Строки.Найти("СведенияОПокупателе", "ПолныйПуть");
		Для каждого СтрокаПокупателя Из СведенияОПокупателе.Строки Цикл
			Организация = ОрганизацияПоДаннымЭД(СтрокаПокупателя, "СведенияОПокупателе.НомерСтроки");
			Прервать;
		КонецЦикла;
	Иначе	
		ИННПокупателя = ""; КПППокупателя = "";
		ВидУчастника = "СведенияОПокупателе";
		Если ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ЮЛ" Тогда
			
			ИННПокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.ИНН");
			КПППокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.КПП");
			ПредставлениеПокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.НаименованиеОрганизации");
			
		ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ФЛ" Тогда
			
			ИННПокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.ИНН");
			Фамилия = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Фамилия");
			Имя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Имя");
			Отчество = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Отчество");
			
			ПредставлениеПокупателя = Фамилия + " " + Имя + " " + Отчество; 
		ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ИП" Тогда
			
			ИННПокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИП.ИНН");
			
		ИначеЕсли ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ИЛ" Тогда
			
			ПредставлениеПокупателя = ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИЛ.НаименованиеОрганизации");
		КонецЕсли;
		
		Организация = Справочники.Организации.ПустаяСсылка();
		СсылкаНаОбъектПоИННКПП("Организации", ИННПокупателя, КПППокупателя, Организация);
	КонецЕсли;
	ДанныеЗаполненияШапки.Вставить("Организация", Организация);
	
	// Поиск и заполнения договора контрагента.
	Договор = Справочники.Договоры.ПустаяСсылка();
	ОснованияОтгрузки = ДеревоДанных.Строки.Найти("ОснованиеОтгрузкиТоваров", "ПолныйПуть");
	Если Не ОснованияОтгрузки = Неопределено Тогда
		ДоговорНайден = Ложь;
		Для Каждого СтрокаОснованиеОтгрузки Из ОснованияОтгрузки.Строки Цикл
			ДоговорНомер = ЗначениеРеквизитаВДереве(СтрокаОснованиеОтгрузки, "ОснованиеОтгрузкиТоваров.НомерСтроки.ДокументНомер");
			Если ЗначениеЗаполнено(ДоговорНомер) Тогда
				
				ДоговорДата = ДатаИзСтроки(ЗначениеРеквизитаВДереве(
					СтрокаОснованиеОтгрузки, 
					"ОснованиеОтгрузкиТоваров.НомерСтроки.ДокументДата"));
				
				СвойстваДоговора = Новый Структура("НомерДоговора, ДатаДоговора, Владелец, Организация", ДоговорНомер, ДоговорДата, Контрагент, Организация);
				
				Договор = Справочники.Договоры.ПустаяСсылка();
				НайтиСсылкуНаОбъект("ДоговорыКонтрагентов", Договор, , СвойстваДоговора);
				Если ЗначениеЗаполнено(Договор) Тогда
					ДоговорНайден = Истина;
				КонецЕсли;	
			КонецЕсли;
			Если ДоговорНайден Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Договор) И ЗначениеЗаполнено(ДанныеЗаполненияШапки.ЭДПоставщика) Тогда
		Договор = ДанныеЗаполненияШапки.ЭДПоставщика.Договор;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Договор) Тогда
		Договор = ДоговорПоНастройкеЭДО(Контрагент, Организация);
	КонецЕсли;

	ДанныеЗаполненияШапки.Вставить("Договор", Договор);
	
	ДанныеЗаполненияШапки.Вставить("СуммаДокумента", ЗначениеРеквизитаВДереве(ДеревоДанных,
		"ВсегоКОплате.ВсегоСтоимостьТоваровСНалогом"));
	
	ВидСчетаФактуры = ЗначениеРеквизитаВДереве(ДеревоДанных, "ВидСчетаФактуры");
	Если ВидСчетаФактуры = "Авансовый" Тогда
		ДанныеЗаполненияШапки.Вставить("КодВидаОперации", "02");
		ДанныеЗаполненияШапки.Вставить("ПричинаНалогообложения", Перечисления.ПричиныНалогообложенияНДС.АвансВыданный);
		ВидЦенности = Перечисления.ВидыЦенностейНДС.Аванс;
	Иначе
		ДанныеЗаполненияШапки.Вставить("КодВидаОперации", "01");
		ДанныеЗаполненияШапки.Вставить("ПричинаНалогообложения", Перечисления.ПричиныНалогообложенияНДС.Покупка);
	КонецЕсли;	
		
	ДанныеЗаполненияШапки.Вставить("КодСпособаВыставления", 2);
	ДанныеЗаполненияШапки.Вставить("НомерПервичногоДокумента", НомерДокумента);
	ДанныеЗаполненияШапки.Вставить("ДатаПервичногоДокумента", ДатаДокумента);
	Если ВидПервичногоДокумента = "" Тогда
		ВидПервичногоДокумента = НСтр("ru = 'Счет-фактура'"); 	
	КонецЕсли;	
	ДанныеЗаполненияШапки.Вставить("ВидПервичногоДокумента", ВидПервичногоДокумента);
	
	СведенияОТоварах = ДеревоДанных.Строки.Найти("СведенияОТоварах", "ПолныйПуть").Строки;
	Если ЗначениеЗаполнено(СведенияОТоварах) Тогда
		ТаблицаТоваров = Документы.СчетФактураПолученный.ПустаяСсылка().СоставНФА.ВыгрузитьКолонки();

		Для Каждого ТекТовар Из СведенияОТоварах Цикл
			СтрокаТаблицы = ТаблицаТоваров.Добавить();
			
			ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка();
			НайтиСсылкуНаОбъект("ЕдиницыИзмерения", ЕдиницаИзмерения, 
				ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.ЕдиницаИзмеренияКод"));

			СтрокаТаблицы.ЕдиницаИзмерения = ЕдиницаИзмерения;
			СтрокаТаблицы.Количество = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.Количество");
			СтрокаТаблицы.Сумма = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.СтоимостьТоваровБезНалога");
			
			СтавкаНДС = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.НалоговаяСтавка");
			
			Если СтавкаНДС = "НДС исчисляется налоговым агентом" Тогда
				СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;	
			КонецЕсли;	
			
			СтрокаТаблицы.СтавкаНДС = СтавкаНДС;
			СтрокаТаблицы.СуммаНДС = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.СуммаНалога");
			СтрокаТаблицы.Всего = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.СтоимостьТоваровСНалогом");
			
			// Заполним номенклатуру поставщика
			
		КонецЦикла;
	КонецЕсли;
	ДанныеЗаполненияШапки.Вставить("СоставНФА", ТаблицаТоваров);
	
	СуммаПоЭД = ТаблицаТоваров.Итог("Сумма");
	ВсегоПоЭД = ТаблицаТоваров.Итог("Всего");
	КоличествоПоЭД = ТаблицаТоваров.Итог("Количество");
	СуммаНДСПоЭД = ТаблицаТоваров.Итог("СуммаНДС");
	
	ТаблицаТоваров.Свернуть("СтавкаНДС", "СуммаНДС");
	
	СуммаПоДокументу = СсылкаНаВладельца.СоставНФА.Итог("Сумма");
	ВсегоПоДокументу = СсылкаНаВладельца.СоставНФА.Итог("Всего");
	КоличествоПоДокументу = СсылкаНаВладельца.СоставНФА.Итог("Количество");
	СуммаНДСПоДокументу = СсылкаНаВладельца.СоставНФА.Итог("СуммаНДС");
	
	ТаблицаТоваровПоДокументу = СсылкаНаВладельца.СоставНФА.Выгрузить();
	ТаблицаТоваровПоДокументу.Свернуть("СтавкаНДС", "СуммаНДС");
	
	МассивОшибок = Новый Массив;
	
	Если СуммаПоЭД <> СуммаПоДокументу Тогда
		ШаблонТекстаОшибки = НСтр("ru = 'Итоговая сумма %1 %2 не равна итоговой сумме в электронном документе %3 %4.'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонТекстаОшибки, Формат(СуммаПоДокументу, "ЧЦ=17; ЧДЦ=2"), Строка(СсылкаНаВладельца.ВалютаДокумента), Формат(СуммаПоЭД, "ЧЦ=17; ЧДЦ=2"), Строка(Валюта));
		МассивОшибок.Добавить(ТекстОшибки);	
	КонецЕсли;	
	
	Если ВсегоПоЭД <> ВсегоПоДокументу Тогда
		ШаблонТекстаОшибки = НСтр("ru = 'Итоговая сумма в графе ""Всего"" %1 %2 не равна итоговой сумме в графе ""Всего"" в электронном документе %3 %4.'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонТекстаОшибки, Формат(ВсегоПоДокументу, "ЧЦ=17; ЧДЦ=2"), Строка(СсылкаНаВладельца.ВалютаДокумента), Формат(ВсегоПоЭД, "ЧЦ=17; ЧДЦ=2"), Строка(Валюта));
		МассивОшибок.Добавить(ТекстОшибки);	
	КонецЕсли;
	
	Если СуммаНДСПоЭД <> СуммаНДСПоДокументу Тогда
		ШаблонТекстаОшибки = НСтр("ru = 'Итоговая сумма НДС %1 %2 не равна итоговой сумме НДС в электронном документе %3 %4.'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонТекстаОшибки, Формат(СуммаНДСПоДокументу, "ЧЦ=17; ЧДЦ=2"), Строка(СсылкаНаВладельца.ВалютаДокумента), Формат(СуммаНДСПоЭД, "ЧЦ=17; ЧДЦ=2"), Строка(Валюта));
		МассивОшибок.Добавить(ТекстОшибки);	
	КонецЕсли;
	
	Если КоличествоПоЭД <> КоличествоПоДокументу Тогда
		ШаблонТекстаОшибки = НСтр("ru = 'Итоговое количество %1 не равно итоговому количеству в электронном документе %2.'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонТекстаОшибки, Формат(КоличествоПоДокументу, "ЧЦ=15; ЧДЦ=3"), Формат(КоличествоПоЭД, "ЧЦ=15; ЧДЦ=3"));
		МассивОшибок.Добавить(ТекстОшибки);	
	КонецЕсли;	
	
	Если МассивОшибок.Количество()>0 Тогда
		ШаблонТекстаОшибки = НСтр("ru = 'При сравнении данных документа и электронного документа ЭДО найдено %1 %2 в списке ""Товары, работы, услуги"":'");
		КоличествоРасхождений = МассивОшибок.Количество();
		ТекстСловоРасхождение = НСтр("ru = 'расхождения'");
		Если КоличествоРасхождений = 1 Тогда
			ТекстСловоРасхождение = НСтр("ru = 'расхождение'");
		КонецЕсли;	
		ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонТекстаОшибки, Формат(КоличествоРасхождений, "ЧЦ=15; ЧДЦ=0"), ТекстСловоРасхождение);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки);
		
		Для каждого ТекОшибка Из МассивОшибок Цикл 
			ОписаниеОшибки = ТекОшибка;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки);
		КонецЦикла;
		
		ШаблонТекстаСообщения = НСтр("ru = 'Для просмотра представления электронного документа ЭДО можно воспользоваться командой ""Просмотреть электронный документ"" в подменю ""ЭДО"".'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ШаблонТекстаСообщения);
		
	Иначе
		Если НЕ БезСообщенийОбОтсутствииРасхождений Тогда
			ШаблонТекстаСообщения = НСтр("ru = 'При сравнении данных документа и электронного документа ЭДО расхождений не найдено.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ШаблонТекстаСообщения);
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

#Область НовыеМетодыБЭД1_4_1_20

// Заполняет форму номенклатуру по данным контрагента.
//
// Параметры:
//  НоменклатураКонтрагента - Структура - данные контрагента для заполнения формы номенклатуры.
//                                        См. СопоставлениеНоменклатурыКонтрагентовКлиентСервер.
//  Форма - УправляемаяФорма, Форма - форма номенклатуры, которую нужно заполнить.
//
Процедура ПриЗаполненииФормыНоменклатурыПоДаннымКонтрагента(Знач НоменклатураКонтрагента, Форма) Экспорт
	
	Форма.Объект.Наименование = НоменклатураКонтрагента.Наименование;
		
	Если ЗначениеЗаполнено(НоменклатураКонтрагента.Характеристика) Тогда
		
		Форма.Объект.Наименование = Форма.Объект.Наименование 
			+ " (" + НоменклатураКонтрагента.Характеристика + ")";
		
	КонецЕсли;
	
	Форма.Объект.НоменклатурныйНомер = НоменклатураКонтрагента.Артикул;
	
	Если ТипЗнч(НоменклатураКонтрагента) = Тип("СправочникСсылка.Номенклатура") Тогда
		Если ЗначениеЗаполнено(НоменклатураКонтрагента.ЕдиницаИзмерения) Тогда
			Форма.Объект.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.НайтиПоНаименованию(НоменклатураКонтрагента.ЕдиницаИзмерения, Истина);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Заполняет форму характеристики по данным контрагента.
//
