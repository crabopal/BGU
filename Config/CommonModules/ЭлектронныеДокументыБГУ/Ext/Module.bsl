// См. ОбменСКонтрагентамиПереопределяемый.ЗначениеНаименованияДанныхСопоставленияНоменклатурыБЭД
Процедура ЗначениеНаименованияДанныхСопоставленияНоменклатурыБЭД(Знач СсылкаНаОбъект, ЗначениеНаименования) Экспорт
	
	НаименованиеРеквизита = НаименованиеРеквизитаСопоставленияНоменклатурыБЭД(ТипЗнч(СсылкаНаОбъект));
	
	Если НаименованиеРеквизита = Неопределено Тогда
		Возврат;
	КонецЕсли;
		
	ЗначениеНаименования = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаНаОбъект, НаименованиеРеквизита);
	
КонецПроцедуры

Функция НаименованиеРеквизитаСопоставленияНоменклатурыБЭД(ТипОбъекта)
	
	Если ТипОбъекта = Тип("СправочникСсылка.Номенклатура") Тогда
		Возврат "НаименованиеПолное";
	ИначеЕсли ТипОбъекта = Тип("СправочникСсылка.ОсновныеСредства") Тогда
		Возврат "НаименованиеПолное";
	ИначеЕсли ТипОбъекта = Тип("СправочникСсылка.ДенежныеДокументы") Тогда
		Возврат "Наименование";
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

// См. ОбменСКонтрагентамиПереопределяемый.ЗначенияНаименованийДанныхСопоставленияНоменклатурыБЭД
Процедура ЗначенияНаименованийДанныхСопоставленияНоменклатурыБЭД(Знач НаборСсылокНаОбъекты, СоответствиеЗначенийНаименований) Экспорт
	
	СоответствиеЗначенийНаименований = Новый Соответствие;
	Объекты                          = ТаблицаОбъектов(НаборСсылокНаОбъекты);
	Запрос                           = Новый Запрос(ТекстЗапросаНаименований());
	
	Запрос.УстановитьПараметр("Объекты", Объекты);
	
	Результат = Запрос.Выполнить();
	Выборка   = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СоответствиеЗначенийНаименований.Вставить(Выборка.Ссылка, Выборка.Наименование);
	КонецЦикла;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ОпределитьНаименованиеТипаОбъектаСопоставленияНоменклатурыБЭД
Процедура ОпределитьНаименованиеТипаОбъектаСопоставленияНоменклатурыБЭД(Знач СсылкаНаОбъект, НаименованиеТипаОбъекта) Экспорт

	ТипСсылкиНаОбъект = ТипЗнч(СсылкаНаОбъект);
	Если ТипСсылкиНаОбъект = Тип("СправочникСсылка.Номенклатура") Тогда
		НаименованиеТипаОбъекта = "Номенклатура";
	ИначеЕсли ТипСсылкиНаОбъект = Тип("СправочникСсылка.ОсновныеСредства") Тогда
		НаименованиеТипаОбъекта = "Номенклатура";
	ИначеЕсли ТипСсылкиНаОбъект = Тип("СправочникСсылка.ДенежныеДокументы") Тогда
		НаименованиеТипаОбъекта = "Номенклатура";
	КонецЕсли;
	
КонецПроцедуры

Процедура ТекстЗапросаПоискаВариантовСопоставленияУпаковкиНоменклатурыБЭД(ТекстЗапроса) Экспорт
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ЕдиницыИзмерения.Ссылка КАК УпаковкаИБ,
	               |	ТаблицаНоменклатуры.ИдентификаторУпаковки КАК ИдентификаторУпаковки,
	               |	ТаблицаНоменклатуры.НоменклатураИБ КАК НоменклатураИБ
	               |ИЗ
	               |	ТаблицаНоменклатуры КАК ТаблицаНоменклатуры
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КлассификаторЕдиницИзмерения КАК ЕдиницыИзмерения
	               |		ПО ТаблицаНоменклатуры.ЕдиницаИзмеренияКод = ЕдиницыИзмерения.Код
	               |ГДЕ
	               |	ТаблицаНоменклатуры.ЕдиницаИзмеренияКод <> """"
	               |
	               |ОБЪЕДИНИТЬ
	               |
	               |ВЫБРАТЬ
	               |	ЕдиницыИзмерения.Ссылка,
	               |	ТаблицаНоменклатуры.ИдентификаторУпаковки,
	               |	ТаблицаНоменклатуры.НоменклатураИБ
	               |ИЗ
	               |	ТаблицаНоменклатуры КАК ТаблицаНоменклатуры
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КлассификаторЕдиницИзмерения КАК ЕдиницыИзмерения
	               |		ПО ТаблицаНоменклатуры.ЕдиницаИзмерения = ЕдиницыИзмерения.НаименованиеПолное
	               |ГДЕ
	               |	ТаблицаНоменклатуры.ЕдиницаИзмерения <> """"
	               |
	               |ОБЪЕДИНИТЬ
	               |
	               |ВЫБРАТЬ
	               |	ЕдиницыИзмерения.Ссылка,
	               |	ТаблицаНоменклатуры.ИдентификаторУпаковки,
	               |	ТаблицаНоменклатуры.НоменклатураИБ
	               |ИЗ
	               |	ТаблицаНоменклатуры КАК ТаблицаНоменклатуры
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КлассификаторЕдиницИзмерения КАК ЕдиницыИзмерения
	               |		ПО ТаблицаНоменклатуры.ЕдиницаИзмерения = ЕдиницыИзмерения.Наименование
	               |ГДЕ
	               |	ТаблицаНоменклатуры.ЕдиницаИзмерения <> """"";
	

КонецПроцедуры

// Определяет, включать ли функциональную опцию "Использовать внутренние документы" при обновлении.
//
// Параметры:
//   Включать - Булево - если Истина, функциональная опция будет включена.
//
// Пример:
//  Включать = Истина;
//
Процедура ВключатьФункциональнуюОпциюИспользоватьВнутренниеДокументыЭДО(Включать) Экспорт
	
	Если Включать Тогда
		Если ИспользуетсяПОД() Тогда
			Включать = ЛОЖЬ;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Получает сведения физического лица по переданному пользователю ИБ.
//
// Параметры:
//  Пользователь - ОпределяемыйТип.Пользователь - пользователь ИБ.
//  СведенияФизЛица - Структура - данные физического лица:
//   * ИмяПолное - Строка - полное имя физического лица пользователя, неапример "Иванов Иван Иванович" .
//   * Должность - Строка - занимаемая должность.
//
Процедура СведенияФизЛицаПользователя(Пользователь, Организация, СведенияФизЛица) Экспорт
	Если ЗначениеЗаполнено(Организация) Тогда
		ТекущаяОрганизация = Организация;
	Иначе	
		ТекущаяОрганизация = ОбщегоназначенияБГУ.ТекущаяОрганизация();
	КонецЕсли;
	
	Если ТипЗнч(Пользователь) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
		ФЛ = Пользователь;
	Иначе	
		ФЛ = Пользователь.ФизическоеЛицо;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ФЛ) Тогда
	 	Данные = ФИОФЛ(ФЛ);
		Фамилия = Данные.Фамилия;
		Имя = Данные.Имя;
		Отчество = Данные.Отчество;
		
		Должность = "";
		СотрудникОтветственныйИсполнитель = ПолучитьОтветственногоИсполнителяДляФизЛица(ФЛ, ТекущаяОрганизация);
		Если ЗначениеЗаполнено(СотрудникОтветственныйИсполнитель) Тогда
			Должность = Справочники.Сотрудники.ПолучитьСвойствоСотрудника(СотрудникОтветственныйИсполнитель, "Должность");
		КонецЕсли;	
		
		СведенияФизЛица.ИмяПолное = Фамилия + " " + Имя + " " + Отчество; 
		СведенияФизЛица.Должность = Должность;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьОтветственногоИсполнителяДляФизЛица(ФизЛицо, Организация) Экспорт
	
	Запрос = Новый Запрос("
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ФизЛица.Ссылка
	|ПОМЕСТИТЬ ФизЛицо
	|ИЗ
	|	Справочник.ФизическиеЛица КАК ФизЛица
	|ГДЕ
	|	ФизЛица.Ссылка = &ФизЛицо
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Сотрудники.Ссылка
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	Сотрудники.Контрагент.ЮридическоеФизическоеЛицо В
	|			(ВЫБРАТЬ
	|				ФизЛицо.Ссылка
	|			ИЗ
	|				ФизЛицо КАК ФизЛицо)
	|	И Сотрудники.Владелец = &Организация");
	
	Запрос.УстановитьПараметр("ФизЛицо", ФизЛицо);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат ПредопределенноеЗначение("Справочник.Сотрудники.ПустаяСсылка");
	
КонецФункции	

// Определяет объекты конфигурации, в модулях менеджеров которых размещена процедура ДобавитьКомандыПечати,
// формирующая список команд печати, предоставляемых этим объектом.
// Синтаксис процедуры ДобавитьКомандыПечати см. в документации к подсистеме.
//
// Параметры:
//  СписокОбъектов - Массив - менеджеры объектов с процедурой ДобавитьКомандыПечати.
//
Процедура ПриОпределенииОбъектовСКомандамиПечати(СписокОбъектов) Экспорт

	ВнутренниеЭлектронныеДокументыБГУ.ПриОпределенииОбъектовСКомандамиПечати(СписокОбъектов);
	
КонецПроцедуры	

Функция ТаблицаОбъектов(НаборСсылокНаОбъекты)
	
	Объекты = Новый ТаблицаЗначений;
	Объекты.Колонки.Добавить("Объект", Метаданные.ОпределяемыеТипы.НоменклатураБЭД.Тип);
	Для Каждого Ссылка Из НаборСсылокНаОбъекты Цикл
		Объекты.Добавить().Объект = Ссылка;
	КонецЦикла;
	
	Возврат Объекты;
	
КонецФункции

Функция ТекстЗапросаНаименований()
	
	Возврат "ВЫБРАТЬ
	|	Объекты.Объект КАК Ссылка
	|ПОМЕСТИТЬ втОбъекты
	|ИЗ
	|	&Объекты КАК Объекты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаСправочника.Ссылка КАК Ссылка,
	|	ТаблицаСправочника.НаименованиеПолное КАК Наименование
	|ИЗ
	|	Справочник.Номенклатура КАК ТаблицаСправочника
	|ГДЕ
	|	ИСТИНА В
	|			(ВЫБРАТЬ ПЕРВЫЕ 1
	|				ИСТИНА
	|			ИЗ
	|				втОбъекты
	|			ГДЕ
	|				втОбъекты.Ссылка = ТаблицаСправочника.Ссылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаСправочника.Ссылка,
	|	ТаблицаСправочника.НаименованиеПолное
	|ИЗ
	|	Справочник.ОсновныеСредства КАК ТаблицаСправочника
	|ГДЕ
	|	ИСТИНА В
	|			(ВЫБРАТЬ ПЕРВЫЕ 1
	|				ИСТИНА
	|			ИЗ
	|				втОбъекты
	|			ГДЕ
	|				втОбъекты.Ссылка = ТаблицаСправочника.Ссылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаСправочника.Ссылка,
	|	ТаблицаСправочника.Наименование
	|ИЗ
	|	Справочник.ДенежныеДокументы КАК ТаблицаСправочника
	|ГДЕ
	|	ИСТИНА В
	|			(ВЫБРАТЬ ПЕРВЫЕ 1
	|				ИСТИНА
	|			ИЗ
	|				втОбъекты
	|			ГДЕ
	|				втОбъекты.Ссылка = ТаблицаСправочника.Ссылка)";
	
КонецФункции

#КонецОбласти

#Область ЭлектронныеДокументыДляСписаниеДоходовБудущихПериодов

Функция НайтиПередаточныйДокументЭДПоИдентификаторуЭД(ИдентификаторЭД, КонтрагентЭД, ДоговорЭД, Основание = Неопределено) Экспорт
	Результат = документы.ЭлектронныйПередаточныйДокументУслугиРаботы.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Если ЗначениеЗаполнено(ИдентификаторЭД) Тогда
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЭлектронныйПередаточныйДокументУслугиРаботыИдентификаторыСтрокДокументаОснования.Ссылка КАК Ссылка
		               |ИЗ
		               |	Документ.ЭлектронныйПередаточныйДокументУслугиРаботы.ИдентификаторыСтрокДокументаОснования КАК ЭлектронныйПередаточныйДокументУслугиРаботыИдентификаторыСтрокДокументаОснования
		               |ГДЕ
		               |	ЭлектронныйПередаточныйДокументУслугиРаботыИдентификаторыСтрокДокументаОснования.ИдентификаторЭД = &ИдентификаторЭД
		               |	И ЭлектронныйПередаточныйДокументУслугиРаботыИдентификаторыСтрокДокументаОснования.Ссылка.Контрагент = &КонтрагентЭД
		               |	И ЭлектронныйПередаточныйДокументУслугиРаботыИдентификаторыСтрокДокументаОснования.Ссылка.Договор = &ДоговорЭД";
	Иначе
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЭлектронныйПередаточныйДокументУслугиРаботыИдентификаторыСтрокДокументаОснования.Ссылка КАК Ссылка
		               |ИЗ
		               |	Документ.ЭлектронныйПередаточныйДокументУслугиРаботы.ИдентификаторыСтрокДокументаОснования КАК ЭлектронныйПередаточныйДокументУслугиРаботыИдентификаторыСтрокДокументаОснования
		               |ГДЕ
		               |	ЭлектронныйПередаточныйДокументУслугиРаботыИдентификаторыСтрокДокументаОснования.Ссылка.Контрагент = &КонтрагентЭД
		               |	И ЭлектронныйПередаточныйДокументУслугиРаботыИдентификаторыСтрокДокументаОснования.Ссылка.Договор = &ДоговорЭД
		               |	И ЭлектронныйПередаточныйДокументУслугиРаботыИдентификаторыСтрокДокументаОснования.Ссылка.ДокументОснование = &ДокументОснование";
	КонецЕсли;
	Запрос.УстановитьПараметр("ДокументОснование", Основание);
	Запрос.УстановитьПараметр("ИдентификаторЭД", ИдентификаторЭД);
	Запрос.УстановитьПараметр("КонтрагентЭД", КонтрагентЭД);
	Запрос.УстановитьПараметр("ДоговорЭД", ДоговорЭД);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

Функция НайтиПередаточныйДокументЭДПоКонтрагентуИДоговору(ДокументОснованиеЭД, КонтрагентЭД, ДоговорЭД) Экспорт
	Результат = документы.ЭлектронныйПередаточныйДокументУслугиРаботы.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЭлектронныйПередаточныйДокументУслугиРаботыИдентификаторыСтрокДокументаОснования.Ссылка КАК Ссылка
