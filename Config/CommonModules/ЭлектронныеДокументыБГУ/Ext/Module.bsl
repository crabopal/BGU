#Область РеквизитыПередачиТРУ

Процедура УстановитьРеквизитыПередачиТРУПоУмолчанию(ФормаСведенияЭлектронногоУПДПоставщика, ДатаСеанса = Неопределено) Экспорт
	
	Если ДатаСеанса <> Неопределено Тогда
		ДатаПередачиТРУ = ДатаСеанса;
	Иначе
		ДатаПередачиТРУ = ФормаСведенияЭлектронногоУПДПоставщика.ДатаСведений;
	КонецЕсли;
	
	ДатаПередачиТРУ = НачалоДня(ДатаПередачиТРУ);
	
	РеквизитыПередачи = НовыйРеквизитыПередачиТРУ();
	
	РеквизитыПередачи.ОтветственныйПередалТРУВид	= 0; // 0 = Работник организации продавца
	РеквизитыПередачи.ОтветственныйПередалТРУ		= ПолучитьОтветственныйПередалТРУПоУмолчанию(ФормаСведенияЭлектронногоУПДПоставщика, ДатаПередачиТРУ);
	РеквизитыПередачи.ДатаПередачиТРУ				= ДатаПередачиТРУ;
	РеквизитыПередачи.ТРУПереданы					= Истина;
	
	ЗаполнитьЗначенияСвойств(ФормаСведенияЭлектронногоУПДПоставщика, РеквизитыПередачи);
	
КонецПроцедуры

Процедура ОчиститьРеквизитыПередачиТРУ(ФормаСведенияЭлектронногоУПДПоставщика) Экспорт
	
	РеквизитыПередачи = НовыйРеквизитыПередачиТРУ();
	
	ЗаполнитьЗначенияСвойств(ФормаСведенияЭлектронногоУПДПоставщика, РеквизитыПередачи);
	
КонецПроцедуры

Функция НовыйРеквизитыПередачиТРУ()
	
	РеквизитыПередачи = Новый Структура();
	РеквизитыПередачи.Вставить("ОтветственныйПередалТРУВид",	0);
	РеквизитыПередачи.Вставить("ОтветственныйПередалТРУ",		Справочники.Сотрудники.ПустаяСсылка());
	РеквизитыПередачи.Вставить("ДатаПередачиТРУ",				'00010101');
	РеквизитыПередачи.Вставить("ТРУПереданы",					Ложь);
	
	Возврат РеквизитыПередачи;
	
КонецФункции

Функция ПолучитьОтветственныйПередалТРУПоУмолчанию(ФормаСведенияЭлектронногоУПДПоставщика, ДатаПередачиТРУ)
	
	ДокументОснование = ФормаСведенияЭлектронногоУПДПоставщика.ДокументОснование;
	
	Если ДокументОснование = Неопределено Тогда
		Возврат Справочники.Сотрудники.ПустаяСсылка();
	КонецЕсли;
	
	ПолноеИмя = ОбщегоНазначения.ИмяТаблицыПоСсылке(ДокументОснование);
	
	ЗначенияРеквизитов = РегистрыСведений.ЗначениеРеквизитовПоУмолчанию.ЗначенияРеквизитовОбъектаПоУмолчанию(
		ДатаПередачиТРУ, ПолноеИмя, "ОтветственныйПередалТРУ");
	
	Если ЗначенияРеквизитов.Свойство("ОтветственныйПередалТРУ") И ЗначениеЗаполнено(ЗначенияРеквизитов.ОтветственныйПередалТРУ) Тогда
		Возврат ЗначенияРеквизитов.ОтветственныйПередалТРУ;
	КонецЕсли;
	
	ТипДокумента = ТипЗнч(ДокументОснование);
	
	Если ТипДокумента = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12") Тогда
		Отпустил = ФормаСведенияЭлектронногоУПДПоставщика.Отпустил;
		
		Если ЗначениеЗаполнено(Отпустил) Тогда
			Возврат Отпустил;
		КонецЕсли;
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.НакладнаяНаОтпускМ15")
		Или ТипДокумента = Тип("ДокументСсылка.ПередачаОбъектовИК")
		Или ТипДокумента = Тип("ДокументСсылка.ПередачаОбъектовОС") Тогда
		
		ОтветственныйИсполнитель = ФормаСведенияЭлектронногоУПДПоставщика.ОтветственныйИсполнитель;
		
		Если ЗначениеЗаполнено(ОтветственныйИсполнитель) Тогда
			Возврат ОтветственныйИсполнитель;
		КонецЕсли;
	КонецЕсли;
	
	Ответственный = ФормаСведенияЭлектронногоУПДПоставщика.Ответственный;
	
	Возврат ЗаполнениеРеквизитовОбъектов.ПолучитьОтветственногоИсполнителя(Ответственный, ФормаСведенияЭлектронногоУПДПоставщика.Организация, ПолноеИмя);
	
КонецФункции

#КонецОбласти

Функция ОсновнойЭлектронныйДокументОбъектаУчета(Знач ОбъектУчета) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОбъектыУчетаДокументовЭДО.ЭлектронныйДокумент КАК ЭлектронныйДокумент,
	|	ОбъектыУчетаДокументовЭДО.ЭлектронныйДокумент.ВидДокумента КАК ВидДокумента,
	|	ОбъектыУчетаДокументовЭДО.ЭлектронныйДокумент.Организация КАК Организация
	|ПОМЕСТИТЬ ДанныеДокументовОбъектаУчета
	|ИЗ
	|	РегистрСведений.ОбъектыУчетаДокументовЭДО КАК ОбъектыУчетаДокументовЭДО
	|ГДЕ
	|	ОбъектыУчетаДокументовЭДО.ОбъектУчета = &ОбъектУчета
	|	И ОбъектыУчетаДокументовЭДО.Актуальный";
	
	Запрос.УстановитьПараметр("ОбъектУчета", ОбъектУчета);
	
	ПоляТаблицы = 
		"	ДанныеДокументовОбъектаУчета.ЭлектронныйДокумент КАК ЭлектронныйДокумент";
	ИмяТаблицы = 
		"	ДанныеДокументовОбъектаУчета КАК ДанныеДокументовОбъектаУчета";
	
	ПоляКлючаНастройки = НастройкиЭДО.НовоеОписаниеПолейКлючаНастройкиВнутреннегоЭДО();
	ПоляКлючаНастройки.Организация = "ДанныеДокументовОбъектаУчета.Организация";
	ПоляКлючаНастройки.ВидВнутреннегоДокумента = "ДанныеДокументовОбъектаУчета.ВидДокумента";
	
	ТекстЗапросаСНастройками = НастройкиЭДО.ТекстЗапросаДополнениеНастройкамиВнутреннегоЭДО(ИмяТаблицы, ПоляТаблицы, ПоляКлючаНастройки);
	
	ТекстыЗапросов = Новый Массив;
	ТекстыЗапросов.Добавить(Запрос.Текст);
	ТекстыЗапросов.Добавить(ТекстЗапросаСНастройками);
	
	Запрос.Текст = СтрСоединить(ТекстыЗапросов, ОбщегоНазначения.РазделительПакетаЗапросов());
	
	Выборка = Запрос.Выполнить().Выгрузить();
	
	Сч = Выборка.Количество() - 1;
	Пока Сч >= 0 Цикл
		ЭлектронныйДокумент = Выборка[Сч].ЭлектронныйДокумент;
		НаименованиеВидаДокумента = СокрЛП(ЭлектронныйДокумент.ВидДокумента);
		Если СтрНайти(НаименованиеВидаДокумента, "Прочее") > 0 Тогда
			Сч = Сч - 1;
			Продолжить;
		Иначе
			Возврат ЭлектронныйДокумент;
		КонецЕсли;
		Сч = Сч - 1;
	КонецЦикла;	
	
	Возврат Неопределено;
	
КонецФункции

Процедура ЗаполнитьДанныеУчастникаСчетаНаОплатуДляФорматаФНС_1_01(Участник,
								ВидУчастника, 
								ДатаДанных, 
								ДеревоДанных, 
								ЛицевойСчет = Неопределено, 
								РеквизитыЛицевогоСчета = Неопределено,
								ГоловнаяОрганизация = Неопределено,
								СтруктурноеПодразделение = Неопределено,
								НаименованиеПолучателяПлатежа = "") Экспорт
	
									
	Если НЕ ЗначениеЗаполнено(Участник) Тогда
		Возврат;
	КонецЕсли;
	
	Контрагент = Участник;
	ДатаСведений = ТекущаяДатаСеанса();
	АдресУчастника = Новый Структура;

	СведенияОбУчастнике = Новый Структура;
	ПолучитьДанныеЮрФизЛица(Участник, СведенияОбУчастнике, ДатаДанных, Ложь);
	
	Если СведенияОбУчастнике.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
		ИННУчастника = СведенияОбУчастнике.ИНН;
		КППУчастника = СведенияОбУчастнике.КПП;
		ОГРНУчастника = СведенияОбУчастнике.ОГРН;
		НаименованиеУчастника = СведенияОбУчастнике.ОфициальноеНаименование;
			
		Если ВидУчастника = "Продавец" ИЛИ ВидУчастника = "ПолучательДенежныхСредств" Тогда
			Если ЗначениеЗаполнено(ЛицевойСчет) Тогда
				Если ТипЗнч(ЛицевойСчет) = Тип("СправочникСсылка.ЛицевыеСчета") Тогда
					РеквизитыПолучателя = Новый Структура("ИННПолучателя, КПППолучателя, ТекстПолучателя, НомерСчетаПолучателя, НаименованиеБанкаПолучателя, БикБанкаПолучателя, СчетБанкаПолучателя", "ИНН", "КПП", "Корреспондент", "СчетНомер", "Банк", "БИК", "КоррСчет");
					
					ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(ЛицевойСчет, РеквизитыЛицевогоСчета, РеквизитыПолучателя, Истина);
					ДанныеОрганизации = Новый Структура;
					ЗаполнитьРегистрационныеДанныеОрганизации(Участник, ДанныеОрганизации);

					НаименованиеУчастника = ДанныеОрганизации.Наименование;
					ИННУчастника = РеквизитыПолучателя.ИННПолучателя;
					КППУчастника = РеквизитыПолучателя.КПППолучателя;
					
					Если ВидУчастника = "ПолучательДенежныхСредств" Тогда
						НаименованиеПолучателяПлатежа = РеквизитыПолучателя.ТекстПолучателя;
					КонецЕсли;
				КонецЕсли;	
			КонецЕсли;
		ИначеЕсли ВидУчастника = "Плательщик" ИЛИ ВидУчастника = "Покупатель" Тогда
			Если ЗначениеЗаполнено(ГоловнаяОрганизация) Тогда
				ПолучитьДанныеЮрФизЛица(ГоловнаяОрганизация, СведенияОбУчастнике, ДатаДанных, Ложь);
				
				ИННУчастника = СведенияОбУчастнике.ИНН;
				КППУчастника = СведенияОбУчастнике.КПП;
				ОГРНУчастника = СведенияОбУчастнике.ОГРН;
				НаименованиеУчастника = СведенияОбУчастнике.ОфициальноеНаименование;
			КонецЕсли;
		КонецЕсли;
		
		Если СведенияОбУчастнике.СтранаРегистрации = Справочники.СтраныМира.Россия Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.ИНН", ИННУчастника);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.КПП", КППУчастника);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.ОГРН", ОГРНУчастника);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.НаименованиеОрганизации", НаименованиеУчастника);
		Иначе
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
				ВидУчастника + ".ТипУчастника.ИЛ.НаименованиеОрганизации", СведенияОбУчастнике.ПолноеНаименование);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
				ВидУчастника + ".ТипУчастника.ИЛ.ИдентификаторОрганизации", СведенияОбУчастнике.НалоговыйНомерВСтранеРегистрации);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
				ВидУчастника + ".ТипУчастника.ИЛ.ОКСМ", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СведенияОбУчастнике.СтранаРегистрации, "Код"));
		КонецЕсли;
	Иначе
		Если СведенияОбУчастнике.ИП Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИП.ИНН", СведенияОбУчастнике.ИНН);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИП.ОГРН", СведенияОбУчастнике.ОГРНИП);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИП.ФИО.Фамилия", СведенияОбУчастнике.Фамилия);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИП.ФИО.Имя", СведенияОбУчастнике.Имя);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИП.ФИО.Отчество", СведенияОбУчастнике.Отчество);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИП.СвидетельствоГосударственнойРегистрации", СведенияОбУчастнике.СвидетельствоСерияНомер);
		Иначе
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.ИНН", СведенияОбУчастнике.ИНН);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.ФИО.Фамилия", СведенияОбУчастнике.Фамилия);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.ФИО.Имя", СведенияОбУчастнике.Имя);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.ФИО.Отчество", СведенияОбУчастнике.Отчество);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.СНИЛС", СведенияОбУчастнике.СНИЛС);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.ИдентификаторИностранногоФизЛица", СведенияОбУчастнике.НалоговыйНомерВСтранеРегистрации);
		КонецЕсли;
	КонецЕсли;	
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить(ВидУчастника, Контрагент);
	АдресУчастника = "";
	ПолучитьАдресСтруктурой(СтруктураПараметров, ВидУчастника, "Юр");
	АдресУчастника = СтруктураПараметров.СтруктураАдреса;
	
	АдресУчастника.Удалить("АдресРФ");
	АдресУчастника.Удалить("КодСтр");
	АдресУчастника.Удалить("КодСтраны");
	АдресУчастника.Удалить("АдрТекст");
	АдресУчастника.Удалить("АдресТекст");
	АдресУчастника.Удалить("Регион");
	АдресУчастника.Удалить("КодРегион");
	АдресУчастника.Удалить("НаселПункт");
	АдресУчастника.Удалить("Кварт");
	АдресУчастника.Удалить("КодГАР");
	Для Каждого Элемент Из АдресУчастника Цикл
		Если Элемент.Ключ = "НаименованиеРегиона" Тогда
			Продолжить;
		КонецЕсли;	
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ВидУчастника + ".Адрес.АдресРФ." + Элемент.Ключ, Элемент.Значение);
	КонецЦикла;	
	
	// Контактные данные
	Если ЗначениеЗаполнено(СведенияОбУчастнике.Телефоны) Тогда
		Телефоны = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
			ДеревоДанных, ВидУчастника + ".КонтактныеСведения.Телефоны");
		НоваяСтрока = Телефоны.Добавить();	
		НоваяСтрока.Телефон = СведенияОбУчастнике.Телефоны;
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(
			ДеревоДанных, Телефоны, ВидУчастника + ".КонтактныеСведения.Телефоны");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СведенияОбУчастнике.ЭлектроннаяПочта) Тогда
		АдресаЭлектроннойПочты = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
			ДеревоДанных, ВидУчастника + ".КонтактныеСведения.ЭлектронныеПочты");
		НоваяСтрока = АдресаЭлектроннойПочты.Добавить();	
		НоваяСтрока.ЭлектроннаяПочта = СведенияОбУчастнике.ЭлектроннаяПочта;
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(
			ДеревоДанных, АдресаЭлектроннойПочты, ВидУчастника + ".КонтактныеСведения.ЭлектронныеПочты");
	КонецЕсли;
	
	Если ЛицевойСчет <> Неопределено Тогда
		
		ЗаполнитьРеквизитыЛицевогоСчета(ЛицевойСчет, РеквизитыЛицевогоСчета);
		
		РасчетныеРеквизиты = Новый Структура("ИННПолучателя, КПППолучателя, ТекстПолучателя, НомерСчетаПолучателя, НаименованиеБанкаПолучателя, БикБанкаПолучателя, СчетБанкаПолучателя",
			"ИНН", "КПП", "Корреспондент", "СчетНомер", "Банк", "БИК", "КоррСчет");
	    ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(ЛицевойСчет, РеквизитыЛицевогоСчета, РасчетныеРеквизиты);
		
		ТекстБанка = "";
		НомерСчета = "";
		ТекстБанка = РасчетныеРеквизиты.НаименованиеБанкаПолучателя;
		Если НЕ ЗначениеЗаполнено(РеквизитыЛицевогоСчета) Тогда
			РасчетныеРеквизиты.НомерСчетаПолучателя = СокрЛП(ЛицевойСчет.Код);
			Если ТипЗнч(ЛицевойСчет) = Тип("СправочникСсылка.БанковскиеИКазначейскиеСчета") Тогда
				Если ТипЗнч(ЛицевойСчет.КассовыйОрган) = Тип("СправочникСсылка.Банки") Тогда
					ТекстБанка = ЛицевойСчет.КассовыйОрган.Наименование;
					РасчетныеРеквизиты.БикБанкаПолучателя = СокрЛП(ЛицевойСчет.КассовыйОрган.Код);
					НомерСчета = СокрЛП(РасчетныеРеквизиты.НомерСчетаПолучателя);
				ИначеЕсли ТипЗнч(ЛицевойСчет.КассовыйОрган) = Тип("СправочникСсылка.Казначейства") Тогда	
					ТекстБанка = ЛицевойСчет.СчетКазначейства.КассовыйОрган.Наименование + " " + ЛицевойСчет.СчетКазначейства.КассовыйОрган.Город + ", Казначейство: " +
					ЛицевойСчет.КассовыйОрган.Наименование + " ("+ЛицевойСчет.Владелец.НаименованиеСокращенное+", л/с "+ СокрЛП(ЛицевойСчет.Код)+")";
					РасчетныеРеквизиты.БикБанкаПолучателя = ЛицевойСчет.СчетКазначейства.КассовыйОрган.Код;
					НомерСчета = СокрЛП(ЛицевойСчет.СчетКазначейства.Код);
				КонецЕсли;
			КонецЕсли;
		Иначе
			ТекстБанка = РасчетныеРеквизиты.НаименованиеБанкаПолучателя;
			РасчетныеРеквизиты.БикБанкаПолучателя = РасчетныеРеквизиты.БикБанкаПолучателя;
			НомерСчета = РасчетныеРеквизиты.НомерСчетаПолучателя;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(РасчетныеРеквизиты.СчетБанкаПолучателя) Тогда
			РасчетныеРеквизиты.СчетБанкаПолучателя = "00000000000000000000";
		КонецЕсли;
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".БанковскиеРеквизиты.НомерСчета", НомерСчета);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".БанковскиеРеквизиты.НаименованиеБанка", ТекстБанка);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".БанковскиеРеквизиты.БИКБанка", РасчетныеРеквизиты.БикБанкаПолучателя);

		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".БанковскиеРеквизиты.ИННБанка", РасчетныеРеквизиты.ИННПолучателя);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".БанковскиеРеквизиты.КППБанка", РасчетныеРеквизиты.КПППолучателя);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".БанковскиеРеквизиты.КорреспондентскийСчетБанка", РасчетныеРеквизиты.СчетБанкаПолучателя);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".БанковскиеРеквизиты.РасчетныйСчет", НомерСчета);
	КонецЕсли;	

	// Подразделение и ОКПО
	Если СведенияОбУчастнике.Свойство("КодПоОКПО") И ЗначениеЗаполнено(СведенияОбУчастнике.КодОКПО) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ВидУчастника + ".КодОКПО", СведенияОбУчастнике.КодОКПО);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктурноеПодразделение) Тогда
		ДанныеПодразделения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтруктурноеПодразделение, "Наименование, НаименованиеПолное");
		
		НаименованиеПодразделения = ДанныеПодразделения.Наименование;
		Если ЗначениеЗаполнено(ДанныеПодразделения.НаименованиеПолное) Тогда
			НаименованиеПодразделения = ДанныеПодразделения.НаименованиеПолное;
		КонецЕсли;	
				
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ВидУчастника + ".СтруктурноеПодразделение", НаименованиеПодразделения);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьДанныеУчастникаСчетаНаОплатуДляФорматаФНС_5_01(Участник,
								ВидУчастника, 
								ДатаДанных, 
								ДеревоДанных, 
								ЛицевойСчет = Неопределено, 
								РеквизитыЛицевогоСчета = Неопределено,
								ГоловнаяОрганизация = Неопределено,
								СтруктурноеПодразделение = Неопределено,
								НаименованиеПолучателяПлатежа = "") Экспорт
	
									
	Если НЕ ЗначениеЗаполнено(Участник) Тогда
		Возврат;
	КонецЕсли;
	
	Контрагент = Участник;
	ДатаСведений = ТекущаяДатаСеанса();
	АдресУчастника = Новый Структура;

	СведенияОбУчастнике = Новый Структура;
	ПолучитьДанныеЮрФизЛица(Участник, СведенияОбУчастнике, ДатаДанных, Ложь);
	
	Если СведенияОбУчастнике.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
		ИННУчастника = СведенияОбУчастнике.ИНН;
		КППУчастника = СведенияОбУчастнике.КПП;
		ОГРНУчастника = СведенияОбУчастнике.ОГРН;
		НаименованиеУчастника = СведенияОбУчастнике.ОфициальноеНаименование;
			
		Если ВидУчастника = "Продавец" ИЛИ ВидУчастника = "ПолучательДенежныхСредств" Тогда
			Если ЗначениеЗаполнено(ЛицевойСчет) Тогда
				Если ТипЗнч(ЛицевойСчет) = Тип("СправочникСсылка.ЛицевыеСчета") Тогда
					РеквизитыПолучателя = Новый Структура("ИННПолучателя, КПППолучателя, ТекстПолучателя, НомерСчетаПолучателя, НаименованиеБанкаПолучателя, БикБанкаПолучателя, СчетБанкаПолучателя", "ИНН", "КПП", "Корреспондент", "СчетНомер", "Банк", "БИК", "КоррСчет");
					
					ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(ЛицевойСчет, РеквизитыЛицевогоСчета, РеквизитыПолучателя, Истина);
					ДанныеОрганизации = Новый Структура;
					ЗаполнитьРегистрационныеДанныеОрганизации(Участник, ДанныеОрганизации);

					НаименованиеУчастника = ДанныеОрганизации.Наименование;
					ИННУчастника = РеквизитыПолучателя.ИННПолучателя;
					КППУчастника = РеквизитыПолучателя.КПППолучателя;
					
					Если ВидУчастника = "ПолучательДенежныхСредств" Тогда
						НаименованиеПолучателяПлатежа = РеквизитыПолучателя.ТекстПолучателя;
					КонецЕсли;
				КонецЕсли;	
			КонецЕсли;
		ИначеЕсли ВидУчастника = "Плательщик" ИЛИ ВидУчастника = "Покупатель" Тогда
			Если ЗначениеЗаполнено(ГоловнаяОрганизация) Тогда
				ПолучитьДанныеЮрФизЛица(ГоловнаяОрганизация, СведенияОбУчастнике, ДатаДанных, Ложь);
				
				ИННУчастника = СведенияОбУчастнике.ИНН;
				КППУчастника = СведенияОбУчастнике.КПП;
				ОГРНУчастника = СведенияОбУчастнике.ОГРН;
				НаименованиеУчастника = СведенияОбУчастнике.ОфициальноеНаименование;
			КонецЕсли;
		КонецЕсли;
		
		Если СведенияОбУчастнике.СтранаРегистрации = Справочники.СтраныМира.Россия Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.ИНН", ИННУчастника);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.КПП", КППУчастника);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.ОГРН", ОГРНУчастника);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.НаименованиеОрганизации", НаименованиеУчастника);
		Иначе
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
				ВидУчастника + ".ТипУчастника.ИЛ.НаименованиеОрганизации", СведенияОбУчастнике.ПолноеНаименование);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
				ВидУчастника + ".ТипУчастника.ИЛ.ИдентификаторОрганизации", СведенияОбУчастнике.НалоговыйНомерВСтранеРегистрации);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
				ВидУчастника + ".ТипУчастника.ИЛ.ОКСМ", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СведенияОбУчастнике.СтранаРегистрации, "Код"));
		КонецЕсли;
	Иначе
		Если СведенияОбУчастнике.ИП Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИП.ИНН", СведенияОбУчастнике.ИНН);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИП.ОГРН", СведенияОбУчастнике.ОГРНИП);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИП.ФИО.Фамилия", СведенияОбУчастнике.Фамилия);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИП.ФИО.Имя", СведенияОбУчастнике.Имя);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИП.ФИО.Отчество", СведенияОбУчастнике.Отчество);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИП.СвидетельствоГосударственнойРегистрации", СведенияОбУчастнике.СвидетельствоСерияНомер);
		Иначе
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.ИНН", СведенияОбУчастнике.ИНН);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.ФИО.Фамилия", СведенияОбУчастнике.Фамилия);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.ФИО.Имя", СведенияОбУчастнике.Имя);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.ФИО.Отчество", СведенияОбУчастнике.Отчество);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.СНИЛС", СведенияОбУчастнике.СНИЛС);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.ИдентификаторИностранногоФизЛица", СведенияОбУчастнике.НалоговыйНомерВСтранеРегистрации);
		КонецЕсли;
	КонецЕсли;	
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить(ВидУчастника, Контрагент);
	АдресУчастника = "";
	ПолучитьАдресСтруктурой(СтруктураПараметров, ВидУчастника, "Юр");
	АдресУчастника = СтруктураПараметров.СтруктураАдреса;
	
	АдресУчастника.Удалить("АдресРФ");
	АдресУчастника.Удалить("КодСтр");
	АдресУчастника.Удалить("КодСтраны");
	АдресУчастника.Удалить("АдрТекст");
	АдресУчастника.Удалить("АдресТекст");
	АдресУчастника.Удалить("Регион");
	АдресУчастника.Удалить("КодРегион");
	АдресУчастника.Удалить("НаселПункт");
	АдресУчастника.Удалить("Кварт");
	АдресУчастника.Удалить("КодГАР");
	Для Каждого Элемент Из АдресУчастника Цикл
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ВидУчастника + ".Адрес.ТипАдреса.АдресРФ." + Элемент.Ключ, Элемент.Значение);
	КонецЦикла;	
	
	// Контактные данные
	Если ЗначениеЗаполнено(СведенияОбУчастнике.Телефоны) Тогда
		Телефоны = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
			ДеревоДанных, ВидУчастника + ".КонтактныеСведения.Телефоны");
		НоваяСтрока = Телефоны.Добавить();	
		НоваяСтрока.Телефон = СведенияОбУчастнике.Телефоны;
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(
			ДеревоДанных, Телефоны, ВидУчастника + ".КонтактныеСведения.Телефоны");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СведенияОбУчастнике.ЭлектроннаяПочта) Тогда
		АдресаЭлектроннойПочты = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
			ДеревоДанных, ВидУчастника + ".КонтактныеСведения.ЭлектронныеПочты");
		НоваяСтрока = АдресаЭлектроннойПочты.Добавить();	
		НоваяСтрока.ЭлектроннаяПочта = СведенияОбУчастнике.ЭлектроннаяПочта;
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(
			ДеревоДанных, АдресаЭлектроннойПочты, ВидУчастника + ".КонтактныеСведения.ЭлектронныеПочты");
	КонецЕсли;
	
	Если ЛицевойСчет <> Неопределено Тогда
		
		ЗаполнитьРеквизитыЛицевогоСчета(ЛицевойСчет, РеквизитыЛицевогоСчета);
		
		РасчетныеРеквизиты = Новый Структура("ИННПолучателя, КПППолучателя, ТекстПолучателя, НомерСчетаПолучателя, НаименованиеБанкаПолучателя, БикБанкаПолучателя, СчетБанкаПолучателя",
			"ИНН", "КПП", "Корреспондент", "СчетНомер", "Банк", "БИК", "КоррСчет");
	    ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(ЛицевойСчет, РеквизитыЛицевогоСчета, РасчетныеРеквизиты);
		
		ТекстБанка = "";
		НомерСчета = "";
		ТекстБанка = РасчетныеРеквизиты.НаименованиеБанкаПолучателя;
		Если НЕ ЗначениеЗаполнено(РеквизитыЛицевогоСчета) Тогда
			РасчетныеРеквизиты.НомерСчетаПолучателя = СокрЛП(ЛицевойСчет.Код);
			Если ТипЗнч(ЛицевойСчет) = Тип("СправочникСсылка.БанковскиеИКазначейскиеСчета") Тогда
				Если ТипЗнч(ЛицевойСчет.КассовыйОрган) = Тип("СправочникСсылка.Банки") Тогда
					ТекстБанка = ЛицевойСчет.КассовыйОрган.Наименование;
					РасчетныеРеквизиты.БикБанкаПолучателя = СокрЛП(ЛицевойСчет.КассовыйОрган.Код);
					НомерСчета = СокрЛП(РасчетныеРеквизиты.НомерСчетаПолучателя);
				ИначеЕсли ТипЗнч(ЛицевойСчет.КассовыйОрган) = Тип("СправочникСсылка.Казначейства") Тогда	
					ТекстБанка = ЛицевойСчет.СчетКазначейства.КассовыйОрган.Наименование + " " + ЛицевойСчет.СчетКазначейства.КассовыйОрган.Город + ", Казначейство: " +
					ЛицевойСчет.КассовыйОрган.Наименование + " ("+ЛицевойСчет.Владелец.НаименованиеСокращенное+", л/с "+ СокрЛП(ЛицевойСчет.Код)+")";
					РасчетныеРеквизиты.БикБанкаПолучателя = ЛицевойСчет.СчетКазначейства.КассовыйОрган.Код;
					НомерСчета = СокрЛП(ЛицевойСчет.СчетКазначейства.Код);
				КонецЕсли;
			КонецЕсли;
		Иначе
			ТекстБанка = РасчетныеРеквизиты.НаименованиеБанкаПолучателя;
			РасчетныеРеквизиты.БикБанкаПолучателя = РасчетныеРеквизиты.БикБанкаПолучателя;
			НомерСчета = РасчетныеРеквизиты.НомерСчетаПолучателя;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(РасчетныеРеквизиты.СчетБанкаПолучателя) Тогда
			РасчетныеРеквизиты.СчетБанкаПолучателя = "00000000000000000000";
		КонецЕсли;
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".БанковскиеРеквизиты.НомерСчета", НомерСчета);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".БанковскиеРеквизиты.НаименованиеБанка", ТекстБанка);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".БанковскиеРеквизиты.БанкБИК", РасчетныеРеквизиты.БикБанкаПолучателя);

		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".БанковскиеРеквизиты.БанкИНН", РасчетныеРеквизиты.ИННПолучателя);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".БанковскиеРеквизиты.БанкКПП", РасчетныеРеквизиты.КПППолучателя);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".БанковскиеРеквизиты.КорреспондентскийСчетБанка", РасчетныеРеквизиты.СчетБанкаПолучателя);
	КонецЕсли;	

	// Подразделение и ОКПО
	Если СведенияОбУчастнике.Свойство("КодПоОКПО") И ЗначениеЗаполнено(СведенияОбУчастнике.КодОКПО) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ВидУчастника + ".КодОКПО", СведенияОбУчастнике.КодОКПО);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктурноеПодразделение) Тогда
		ДанныеПодразделения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтруктурноеПодразделение, "Наименование, НаименованиеПолное");
		
		НаименованиеПодразделения = ДанныеПодразделения.Наименование;
		Если ЗначениеЗаполнено(ДанныеПодразделения.НаименованиеПолное) Тогда
			НаименованиеПодразделения = ДанныеПодразделения.НаименованиеПолное;
		КонецЕсли;	
				
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ВидУчастника + ".СтруктурноеПодразделение", НаименованиеПодразделения);
	КонецЕсли;
	
КонецПроцедуры

#Область СчетНаОплату_5_01

// Подготавливает данные для электронного документа вида "Счет на оплату"
//
// Параметры:
//  Основание - ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО - основание для электронного документа.
//  Настройки - ФиксированнаяСтруктура - настройки заполнения данных:
//   * ТипДокумента - Произвольный - ожидаемый вид документа. Доступные значения представлены следующими свойствами
//                                   результата функции см. ОбменСКонтрагентами.ТипыДокументов:
//                                    - СчетНаОплату.
//  Данные - ДеревоЗначений - данные для заполнения электронного документа. Строится по макету 
//                            см. Обработка.ОбменСКонтрагентами.Макет.СчетНаОплату_5_01. Выходной параметр.
//  Описание - Структура - дополнительная информация о документе. Выходной параметр.
//   * Основания - Массив из ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО - ссылки на дополнительные объекты-основания
//                 электронного документа помимо указанного в параметре "Основание".
//  Отказ - Булево - признак отказа от дальнейшего формирования электронного документа.
//                   Информационное сообщение пользователю необходимо формировать самостоятельно.
//
Процедура ЗаполнитьДанныеПоСчетуНаОплату_5_01(Основание, Настройки, Данные, Описание, Отказ) Экспорт

	СсылкаНаОбъект = Основание;
	ДеревоДокумента = Данные;
	
	НетЗамечанийКДокументу = Документы.СчетНаОплату.ПредварительныйКонтрольДанныхДляЭД(СсылкаНаОбъект, "ФНС501");
	
	Если НЕ НетЗамечанийКДокументу Тогда
		ОписаниеОшибки = НСтр("ru='Вышеуказанные ошибки препятствуют формированию электронного документа.
		|По этой причине и прочие данные документа не будут выгружены в ЭД.
		|После заполнения указанных реквизитов повторите попытку формирования электронного документа.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки);
		Отказ = Истина;
		Возврат;
	КонецЕсли;	
	
	ДанныеДокИБ = Документы.СчетНаОплату.ПодготовитьДанныеДляЭД(СсылкаНаОбъект, "ФНС501");
	РеквизитыШапки = ДанныеДокИБ[0].Выбрать();
	ТабличнаяЧасть = ДанныеДокИБ[1].Выгрузить();
	ДобавитьИДНоменклатурыВТаблицу(ТабличнаяЧасть);
	
	РеквизитыШапки.Следующий();

	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "Функция", РеквизитыШапки.Функция);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "НомерДокумента", НомерДляПечати(СсылкаНаОбъект, РеквизитыШапки.Номер));
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "ДатаДокумента", РеквизитыШапки.Дата);

	//Продавец
	ЗаполнитьДанныеУчастникаСчетаНаОплатуДляФорматаФНС_5_01(РеквизитыШапки.Продавец, "Продавец", РеквизитыШапки.Дата, ДеревоДокумента, 
		РеквизитыШапки.ЛицевойСчетПродавца, РеквизитыШапки.РеквизитыЛицевогоСчетаПродавца, , РеквизитыШапки.ПодразделениеПродавца);
	
	//ПолучательДенежныхСредств
	НаименованиеПолучателяПлатежа = "";
	Если ЗначениеЗаполнено(РеквизитыШапки.ПолучательДенежныхСредств) Тогда
		ЗаполнитьДанныеУчастникаСчетаНаОплатуДляФорматаФНС_5_01(РеквизитыШапки.ПолучательДенежныхСредств, "ПолучательДенежныхСредств", РеквизитыШапки.Дата, ДеревоДокумента,
								РеквизитыШапки.ЛицевойСчетПолучателяДенежныхСредств, РеквизитыШапки.РеквизитыЛицевогоСчетаПолучателяДенежныхСредств,,,НаименованиеПолучателяПлатежа);
	Иначе
		ЗаполнитьДанныеУчастникаСчетаНаОплатуДляФорматаФНС_5_01(РеквизитыШапки.Продавец, "ПолучательДенежныхСредств", РеквизитыШапки.Дата, ДеревоДокумента, 
								РеквизитыШапки.ЛицевойСчетПродавца, РеквизитыШапки.РеквизитыЛицевогоСчетаПродавца,,,НаименованиеПолучателяПлатежа);
	КонецЕсли;
	
	//Плательщик
	Если ЗначениеЗаполнено(РеквизитыШапки.СчетПлательщика) Тогда
		ЗаполнитьДанныеУчастникаСчетаНаОплатуДляФорматаФНС_5_01(РеквизитыШапки.Плательщик, "Плательщик", РеквизитыШапки.Дата, ДеревоДокумента, 
							РеквизитыШапки.СчетПлательщика, );
	Иначе
	 	ПлательщикГоловнаяОрганизация = Справочники.Контрагенты.ПустаяСсылка();
		Если РеквизитыШапки.ПлательщикОбособленноеПодразделение И ЗначениеЗаполнено(РеквизитыШапки.ПлательщикГоловнаяОрганизация) Тогда
			ПлательщикГоловнаяОрганизация = РеквизитыШапки.ПлательщикГоловнаяОрганизация;
		КонецЕсли;
		
		ЗаполнитьДанныеУчастникаСчетаНаОплатуДляФорматаФНС_5_01(РеквизитыШапки.Плательщик, "Плательщик", РеквизитыШапки.Дата, ДеревоДокумента, 
							, ПлательщикГоловнаяОрганизация);
	КонецЕсли;
							
	//Покупатель
	ЗаполнитьДанныеУчастникаСчетаНаОплатуДляФорматаФНС_5_01(РеквизитыШапки.Покупатель, "Покупатель", РеквизитыШапки.Дата, ДеревоДокумента,,);
	
	//Грузоотправитель
	Если ЗначениеЗаполнено(РеквизитыШапки.Грузоотправитель) Тогда
		ЗаполнитьДанныеУчастникаСчетаНаОплатуДляФорматаФНС_5_01(РеквизитыШапки.Грузоотправитель, "Грузоотправитель", РеквизитыШапки.Дата, ДеревоДокумента,,);
	КонецЕсли;
	
	//Грузополучатель
	Если ЗначениеЗаполнено(РеквизитыШапки.Грузополучатель) Тогда
		ЗаполнитьДанныеУчастникаСчетаНаОплатуДляФорматаФНС_5_01(РеквизитыШапки.Грузополучатель, "Грузополучатель", РеквизитыШапки.Дата, ДеревоДокумента,,);
	КонецЕсли;
	
	ВсегоНаименований = ТабличнаяЧасть.Количество();
 	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "ВсегоНаименований", ВсегоНаименований);
	
	// Основание
	Если ЗначениеЗаполнено(РеквизитыШапки.Договор) Тогда
		ДанныеДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыШапки.Договор, "ВидОбязательства, НомерДоговора, ДатаДоговора");
		
		Основание = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ДеревоДокумента, "Основания.НомерСтроки.Основание");	
		Основание.НаименованиеДокумента = ДанныеДоговора.ВидОбязательства;
		Основание.НомерДокумента = ?(ЗначениеЗаполнено(ДанныеДоговора.НомерДоговора), ДанныеДоговора.НомерДоговора, "Без номера");
		Основание.ДатаДокумента = ДанныеДоговора.ДатаДоговора;
		Основание.ИдентификаторДокумента = РеквизитыШапки.ИдентификаторГосКонтракта;
		
		Основания = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ДеревоДокумента, "Основания");
		НоваяСтрока = Основания.Добавить();
		НоваяСтрока.Основание = Основание;
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДокумента, Основания, "Основания");
		
	КонецЕсли;
	
	// Таблица документа
	
	Путь = "ТаблицаТоваров.НомерСтроки.";
	
	СтруктураДанныхСуммаНДС = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ДеревоДокумента, Путь + "СуммаНДС");
	СтруктураДанныхСуммаНДСБезСкидки = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ДеревоДокумента, Путь + "СуммаНДСБезСкидки");
	СтруктураДанныхНалоговаяСтавка = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ДеревоДокумента, Путь + "НалоговаяСтавка");
	СтруктураДанныхСкидка = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ДеревоДокумента, Путь + "Скидка");
	СтруктураДанныхДополнительныеСведения = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ДеревоДокумента, Путь + "ДополнительныеСведения");
	СтруктураДанныхСопоставление = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ДеревоДокумента, Путь + "Сопоставление");
	
	НДСУчтеноВСумме = РеквизитыШапки.СуммаВключаетНДС;
	ДокументБезНДС = Истина;
	ИтогоСуммаНДС = 0;
	ТаблицаТоваров = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ДеревоДокумента, "ТаблицаТоваров");
	Для Каждого ТекСтрока Из ТабличнаяЧасть Цикл
		СтрокаТоваров = ТаблицаТоваров.Добавить();
		СтрокаТоваров.Наименование                 	= ТекСтрока.Наименование;
		Если ЗначениеЗаполнено(ТекСтрока.Содержание) Тогда
			СтрокаТоваров.Наименование = ТекСтрока.Содержание;
		КонецЕсли;
		
		СтрокаТоваров.Количество                   	= ТекСтрока.Количество;
		СтрокаТоваров.КодЕдиницыИзмерения          	= СокрЛП(ТекСтрока.БазоваяЕдиницаКод);
		СтрокаТоваров.НаименованиеЕдиницыИзмерения 	= СокрЛП(ТекСтрока.БазоваяЕдиницаНаименование);

		СтрокаТоваров.НалоговаяСтавка = ОбщегоНазначения.СкопироватьРекурсивно(СтруктураДанныхНалоговаяСтавка);
		СтрокаТоваров.СуммаНДС = ОбщегоНазначения.СкопироватьРекурсивно(СтруктураДанныхСуммаНДС);
		СтрокаТоваров.СуммаНДСБезСкидки = ОбщегоНазначения.СкопироватьРекурсивно(СтруктураДанныхСуммаНДСБезСкидки);
		СтрокаТоваров.ДополнительныеСведения = ОбщегоНазначения.СкопироватьРекурсивно(СтруктураДанныхДополнительныеСведения);
		СтрокаТоваров.Сопоставление = ОбщегоНазначения.СкопироватьРекурсивно(СтруктураДанныхСопоставление);
		
		СтрокаТоваров.НалоговаяСтавка.Вставить("СтавкаНДС", ТекСтрока.СтавкаНДС);
		
		СтрокаТоваров.ЦенаЗаЕдиницуИзмерения		= ТекСтрока.Цена;
		СтрокаТоваров.СтоимостьБезНДС 				= ТекСтрока.Всего - ТекСтрока.СуммаНДС;
		СтрокаТоваров.СтоимостьСНДС 				= ТекСтрока.Всего;
		
		Если ТекСтрока.Скидка <> 0 Тогда
			СтрокаТоваров.Скидка = ОбщегоНазначения.СкопироватьРекурсивно(СтруктураДанныхСкидка);
			СтрокаТоваров.Скидка.Вставить("СуммаСкидки", ТекСтрока.Скидка);
			
			СтрокаТоваров.ЦенаБезСкидки = ТекСтрока.ЦенаБезСкидок;
			Сумма_БезСкидки = СтрокаТоваров.ЦенаБезСкидки * СтрокаТоваров.Количество;
			СтрокаТоваров.СтоимостьБезНДСБезСкидки = Окр(Сумма_БезСкидки, 2);
			СтрокаТоваров.СтоимостьСНДСБезСкидки = Окр(Сумма_БезСкидки, 2);
			СтрокаТоваров.СуммаНДСБезСкидки.Вставить("СуммаНалога", 0);
		Иначе
			СтрокаТоваров.ЦенаБезСкидки = СтрокаТоваров.ЦенаЗаЕдиницуИзмерения;
			СтрокаТоваров.СтоимостьБезНДСБезСкидки = СтрокаТоваров.СтоимостьБезНДС;
			СтрокаТоваров.СтоимостьСНДСБезСкидки = СтрокаТоваров.СтоимостьСНДС;
		КонецЕсли;	
		
		Если ТекСтрока.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС Тогда
			СтрокаТоваров.СуммаНДС.Вставить("БезНДС", "без НДС");
		Иначе	
			СтрокаТоваров.СуммаНДС.Вставить("СуммаНалога", ТекСтрока.СуммаНДС);
		КонецЕсли;
		ИтогоСуммаНДС = ИтогоСуммаНДС + ТекСтрока.СуммаНДС;	
		
		Если ТекСтрока.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС Тогда
			СтрокаТоваров.СуммаНДСБезСкидки.Вставить("БезНДС", "без НДС");
		Иначе
			СтрокаТоваров.СуммаНДСБезСкидки.Вставить("СуммаНалога", ТекСтрока.СуммаНДС);
		КонецЕсли;
		
		Если РеквизитыШапки.НеЗаполнятьЦеныВЭлектронномДокументе Тогда
			СтрокаТоваров.ЦенаЗаЕдиницуИзмерения = 0;
			СтрокаТоваров.ЦенаБезСкидки = 0;
		КонецЕсли;	

		Если ЗначениеЗаполнено(ТекСтрока.СтранаПроисхождения) Тогда
			СтранаПроисхождения = ТекСтрока.СтранаПроисхождения;
		Иначе
			СтранаПроисхождения = Справочники.СтраныМира.Россия;
		КонецЕсли;	
		
		ДанныеСтраны = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтранаПроисхождения, "Код, Наименование");
		
		СтрокаТоваров.ДополнительныеСведения.Вставить("Признак", ТекСтрока.Признак);
		СтрокаТоваров.ДополнительныеСведения.Вставить("КодСтраныПроисхождения", СокрЛП(ДанныеСтраны.Код));
		СтрокаТоваров.ДополнительныеСведения.Вставить("НаименованиеСтраныПроисхождения", ДанныеСтраны.Наименование);
		СтрокаТоваров.ДополнительныеСведения.Вставить("АртикулТовара", СокрЛП(ТекСтрока.Артикул));
		СтрокаТоваров.ДополнительныеСведения.Вставить("КодТовара", СокрЛП(ТекСтрока.КодТовара));
		СтрокаТоваров.ДополнительныеСведения.Вставить("КодКаталога", СокрЛП(ТекСтрока.КодКаталога));
		СтрокаТоваров.ДополнительныеСведения.Вставить("КодВидаТовара", СокрЛП(ТекСтрока.КодВидаТовара));
		
		СтрокаТоваров.Сопоставление.Вставить("Наименование", СтрокаТоваров.Наименование);
		СтрокаТоваров.Сопоставление.Вставить("ЕдиницаИзмерения", СтрокаТоваров.НаименованиеЕдиницыИзмерения);
		СтрокаТоваров.Сопоставление.Вставить("ЕдиницаИзмеренияКод", СтрокаТоваров.КодЕдиницыИзмерения);
		СтрокаТоваров.Сопоставление.Вставить("НоменклатураИБ", ТекСтрока.Номенклатура);
		
	КонецЦикла;
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДокумента, ТаблицаТоваров, "ТаблицаТоваров");
	
	// Всего к оплате.
	ВсегоКОплате = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ДеревоДокумента, "ВсегоКОплате");
	ВсегоКОплате.СтоимостьБезНДС = ТабличнаяЧасть.Итог("Всего") - ТабличнаяЧасть.Итог("СуммаНДС");
	ВсегоКОплате.СтоимостьСНДС = ТабличнаяЧасть.Итог("Всего");
	ВсегоКОплате.СуммаСкидки = ТабличнаяЧасть.Итог("Скидка");
	Если ИтогоСуммаНДС > 0 Тогда
		ВсегоКОплате.СуммаНалога.Вставить("СуммаНалога", ИтогоСуммаНДС); 
	Иначе
		ВсегоКОплате.СуммаНалога.Вставить("СуммаНалога", ИтогоСуммаНДС); 
		ВсегоКОплате.СуммаНалога.Вставить("БезНДС", "без НДС"); 
	КонецЕсли;
	ЭлектронноеВзаимодействие.ЗагрузитьСтруктуруВГруппуДерева(ДеревоДокумента, ВсегоКОплате, "ВсегоКОплате");
	
	// Денежная единица
	ДанныеВалюты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыШапки.Валюта, "Код, Наименование");
	
	ДенежнаяЕдиница = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ДеревоДокумента, "ДенежнаяЕдиница");
	ДенежнаяЕдиница.НаименованиеВалюты		= СокрЛП(ДанныеВалюты.Наименование);
	ДенежнаяЕдиница.КодВалюты.Код     	    = СокрЛП(ДанныеВалюты.Код);
	ДенежнаяЕдиница.КурсВалюты.Курс   	    = РеквизитыШапки.Курс;
	
	ЭлектронноеВзаимодействие.ЗагрузитьСтруктуруВГруппуДерева(ДеревоДокумента, ДенежнаяЕдиница, "ДенежнаяЕдиница");
	
	// Дополнительные сведения
	ДополнительныеСведения = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ДеревоДокумента, "ДополнительныеСведения");
	
	Если ЗначениеЗаполнено(РеквизитыШапки.СрокОплаты) Тогда
		ДополнительныеСведения.ОграничениеПоДатеОплаты = РеквизитыШапки.СрокОплаты;
	КонецЕсли;
	ДополнительныеСведения.НазначениеПлатежа = РеквизитыШапки.НазначениеПлатежа;
	
	ДополнительныеСведения.Вставить("НаименованиеПолучателяПлатежа", НаименованиеПолучателяПлатежа);
	
	КПС = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = '%1%2%3'"), РеквизитыШапки.КодГлавы, РеквизитыШапки.КодКПС, РеквизитыШапки.КодАналитикиКПС);
	ОКТМО = РеквизитыШапки.КодОКАТО;
	
	Если Не ПустаяСтрока(КПС) Тогда
		ДополнительныеСведения.Вставить("КПС", КПС);
	КонецЕсли;

	Если Не ПустаяСтрока(ОКТМО) Тогда
		ДополнительныеСведения.Вставить("ОКТМО", ОКТМО);
	КонецЕсли;

	ЭлектронноеВзаимодействие.ЗагрузитьСтруктуруВГруппуДерева(ДеревоДокумента, ДополнительныеСведения, "ДополнительныеСведения");
	
КонецПроцедуры

//См. ОбменСКонтрагентамиПереопределяемый.ПриОтраженииВУчетеДокументаСчетНаОплату_5_01
Процедура ПриОтраженииВУчетеДокументаСчетНаОплату_5_01(РезультатОтраженияВУчете, Знач ДанныеЭлектронногоДокумента,
	Знач ПараметрыДляОтраженияВУчете) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	Записывать = Истина;
	
	Данные = Новый Структура;
	Для каждого СтрокаДерева Из ДанныеЭлектронногоДокумента.Строки Цикл
		Путь = СтрокаДерева.ПолныйПуть;
		ДанныеСтроки = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ДанныеЭлектронногоДокумента, Путь);
		Данные.Вставить(Путь, ДанныеСтроки);
	КонецЦикла;
		
	РежимЗаписи = РежимЗаписиДокумента.Запись;
	СсылкаНаВладельца = РезультатОтраженияВУчете.ДокументыУчета[0];
	Попытка
		Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
			ДокументОбъект = СсылкаНаВладельца.ПолучитьОбъект();
			Если ДокументОбъект.Проведен Тогда
				Текст = НСтр("ru = 'Операция возможна только для непроведенных документов!'");
			КонецЕсли;
		Иначе
			ДокументОбъект = Документы.СчетНаОплатуОтПоставщика.СоздатьДокумент();
			ДокументОбъект.Дата = ТекущаяДатаСеанса();
			ДокументОбъект.Ответственный = Пользователи.ТекущийПользователь();
			
			ФункцияСчета = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДанныеЭлектронногоДокумента, "Функция");
			Если ФункцияСчета = "1" Тогда
				ДокументОбъект.ЭтоСчетОферта = Истина;
			КонецЕсли;
		КонецЕсли;
		
		ДокументОбъект.ТипФорматаЭД = 3;
		
		// Шапка.	
		ДокументОбъект.Организация = ОрганизацияПоДаннымЭД(ДанныеЭлектронногоДокумента, "Покупатель");
		ДокументОбъект.Контрагент  = КонтрагентПоДаннымЭД(ДанныеЭлектронногоДокумента, "Продавец");

		//Договор
		Основания = Данные.Основания;
		Если Основания.Количество() > 0 Тогда
			Договор = Справочники.Договоры.ПустаяСсылка();
			
			НомерДоговора = Основания[0].Основание.НомерДокумента;
			ДатаДоговора = Основания[0].Основание.ДатаДокумента;
			
			Владелец = ДокументОбъект.Контрагент;
			Если  ЗначениеЗаполнено(Владелец) Тогда
				ДополнительныеРеквизиты = Новый Структура("НомерДоговора, ДатаДоговора, Владелец, Организация",
					НомерДоговора, ДатаДоговора, Владелец, ДокументОбъект.Организация); 
				НайтиСсылкуНаОбъект("ДоговорыКонтрагентов", Договор, , ДополнительныеРеквизиты);
			КонецЕсли;
			
			ДокументОбъект.Договор = Договор;
			ДокументОбъект.ИдентификаторГосКонтракта = Основания[0].Основание.ИдентификаторДокумента;
		КонецЕсли;	
		
		ДокументОбъект.ПолучательДенежныхСредств = КонтрагентПоДаннымЭД(ДанныеЭлектронногоДокумента, "ПолучательДенежныхСредств");
		ДокументОбъект.Плательщик  = КонтрагентПоДаннымЭД(ДанныеЭлектронногоДокумента, "Плательщик");
		
		ДокументОбъект.Грузоотправитель = КонтрагентПоДаннымЭД(ДанныеЭлектронногоДокумента, "Грузоотправитель");
		ДокументОбъект.Грузополучатель  = КонтрагентПоДаннымЭД(ДанныеЭлектронногоДокумента, "Грузополучатель");
		
		ДокументОбъект.ВидПервичногоДокумента = "Счет на оплату";
		ДокументОбъект.НомерПервичногоДокумента = Данные.НомерДокумента;
		ДокументОбъект.ДатаПервичногоДокумента = Данные.ДатаДокумента;
		
		ДокументОбъект.ВалютаДокумента = ОбщегоНазначенияБЭД.НайтиСсылку("Валюты", Данные.ДенежнаяЕдиница.КодВалюты.Код);
		Если Не ЗначениеЗаполнено(ДокументОбъект.ВалютаДокумента) Тогда
			ДокументОбъект.ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
		КонецЕсли;	
		
		ДокументОбъект.СуммаДокумента = Данные.ВсегоКОплате.СтоимостьСНДС;
		Если Данные.ВсегоКОплате.СуммаНалога.СуммаНалога > 0 Тогда
			ДокументОбъект.СуммаНалогаИтог = Данные.ВсегоКОплате.СуммаНалога.СуммаНалога;
			ДокументОбъект.ЦенаВключаетНДС = Истина;
		КонецЕсли;	
		
		ДополнительныеСведения = Данные.ДополнительныеСведения;
		ДокументОбъект.СрокОплаты = ДополнительныеСведения.ОграничениеПоДатеОплаты;
		ДокументОбъект.НазначениеПлатежа = ДополнительныеСведения.НазначениеПлатежа;
		
		ДокументОбъект.ОбменДанными.Загрузка = Истина;
		ДокументОбъект.ДополнительныеСвойства.Вставить("ЕстьСоглашение", Истина);
		ДокументОбъект.ДополнительныеСвойства.Вставить("ПроцессыОбработкиДокументов_ЗаписатьБезПроверкиОбменДаннымиЗагрузка", Истина);
		Если Записывать Тогда
			Если НЕ ЗначениеЗаполнено(ДокументОбъект.Номер) Тогда
				ДокументОбъект.УстановитьНовыйНомер();
			КонецЕсли;
			ДокументОбъект.Записать(РежимЗаписи);
			СсылкаНаВладельца = ДокументОбъект.Ссылка;
		Иначе // если функция вызвана из формы "Обработки.ЭлектронныеДокументы.ФормаЗагрузкиПросмотраЭД"
			СсылкаНаВладельца = ДокументОбъект;
		КонецЕсли;

		РезультатОтраженияВУчете.ДокументыУчета = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СсылкаНаВладельца);
		
	Исключение
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Заполнение документа на основе ЭД. %1'"), Текст);
		ЗаписьЖурналаРегистрации(ТекстСообщения, УровеньЖурналаРегистрации.Ошибка, ДокументОбъект.Метаданные(), СсылкаНаВладельца,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение(Текст);
	КонецПопытки;
	
КонецПроцедуры

// Поиск и создание учетного документа при отражении в учете документа Счет на оплату.
// Тестовый формат ФНС.
//
// Параметры:
//  ДеревоДанных		 - ДеревоЗначений - данные электронного документа в виде заполненного макета 
//                         см. Обработка.ОбменСКонтрагентами.Макет.СчетНаОплату_5_01.
//  СсылкаНаВладельца     - ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО - ссылка на документ учета, если он уже
//                         прикреплен к электронному документу.
//  СпособОбработки		 - Строка - способ сохранения данных в информационной базе, выбранный пользователем. Передается 
//                         значение элемента списка значений, заданного в см. ОбменСКонтрагентамиПереопределяемый.СписокОперацийТипаЭД
//  ОписаниеОшибки       - Строка - описание ошибки создания учетного документа. Может быть выведена пользователю.
//
Процедура НайтиСоздатьСчетНаОплату_5_01(ДеревоДанных, СсылкаНаВладельца = Неопределено, СпособОбработки = "", ОписаниеОшибки = "") Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	Записывать = Истина;
	Данные = Новый Структура;
	Для каждого СтрокаДерева Из ДеревоДанных.Строки Цикл
		Путь = СтрокаДерева.ПолныйПуть;
		ДанныеСтроки = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ДеревоДанных, Путь);
		Данные.Вставить(Путь, ДанныеСтроки);
	КонецЦикла;
	
	
	РежимЗаписи = РежимЗаписиДокумента.Запись;
	Попытка
		Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
			ДокументОбъект = СсылкаНаВладельца.ПолучитьОбъект();
			Если ДокументОбъект.Проведен Тогда
				Текст = НСтр("ru = 'Операция возможна только для непроведенных документов!'");
			КонецЕсли;
		Иначе
			ДокументОбъект = Документы.СчетНаОплатуОтПоставщика.СоздатьДокумент();
			ДокументОбъект.Дата = ТекущаяДатаСеанса();
			ДокументОбъект.Ответственный = Пользователи.ТекущийПользователь();
		КонецЕсли;
		
		ДокументОбъект.ТипФорматаЭД = 3;
		
		// Шапка.	
		ДокументОбъект.Организация = ОрганизацияПоДаннымЭД(ДеревоДанных, "Покупатель");
		ДокументОбъект.Контрагент  = КонтрагентПоДаннымЭД(ДеревоДанных, "Продавец");

		//Договор
		Основания = Данные.Основания;
		Если Основания.Количество() > 0 Тогда
			Договор = Справочники.Договоры.ПустаяСсылка();
			
			НомерДоговора = Основания[0].Основание.НомерДокумента;
			ДатаДоговора = Основания[0].Основание.ДатаДокумента;
			
			Владелец = ДокументОбъект.Контрагент;
			Если  ЗначениеЗаполнено(Владелец) Тогда
				ДополнительныеРеквизиты = Новый Структура("НомерДоговора, ДатаДоговора, Владелец, Организация",
					НомерДоговора, ДатаДоговора, Владелец, ДокументОбъект.Организация); 
				НайтиСсылкуНаОбъект("ДоговорыКонтрагентов", Договор, , ДополнительныеРеквизиты);
			КонецЕсли;
			
			ДокументОбъект.Договор = Договор;
			ДокументОбъект.ИдентификаторГосКонтракта = Основания[0].Основание.ИдентификаторДокумента;
		КонецЕсли;	
		
		ДокументОбъект.ПолучательДенежныхСредств = КонтрагентПоДаннымЭД(ДеревоДанных, "ПолучательДенежныхСредств");
		ДокументОбъект.Плательщик  = КонтрагентПоДаннымЭД(ДеревоДанных, "Плательщик");
		
		ДокументОбъект.Грузоотправитель = КонтрагентПоДаннымЭД(ДеревоДанных, "Грузоотправитель");
		ДокументОбъект.Грузополучатель  = КонтрагентПоДаннымЭД(ДеревоДанных, "Грузополучатель");
		
		ДокументОбъект.ВидПервичногоДокумента = "Счет на оплату";
		ДокументОбъект.НомерПервичногоДокумента = Данные.НомерДокумента;
		ДокументОбъект.ДатаПервичногоДокумента = Данные.ДатаДокумента;
		
		ДокументОбъект.ВалютаДокумента = ОбщегоНазначенияБЭД.НайтиСсылку("Валюты", Данные.ДенежнаяЕдиница.КодВалюты.Код);
		Если Не ЗначениеЗаполнено(ДокументОбъект.ВалютаДокумента) Тогда
			ДокументОбъект.ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
		КонецЕсли;	
		
		ДокументОбъект.СуммаДокумента = Данные.ВсегоКОплате.СтоимостьСНДС;
		Если Данные.ВсегоКОплате.СуммаНалога.СуммаНалога > 0 Тогда
			ДокументОбъект.СуммаНалогаИтог = Данные.ВсегоКОплате.СуммаНалога.СуммаНалога;
			ДокументОбъект.ЦенаВключаетНДС = Истина;
		КонецЕсли;	
		
		ДополнительныеСведения = Данные.ДополнительныеСведения;
		ДокументОбъект.СрокОплаты = ДополнительныеСведения.ОграничениеПоДатеОплаты;
		ДокументОбъект.НазначениеПлатежа = ДополнительныеСведения.НазначениеПлатежа;
		
		ДокументОбъект.ОбменДанными.Загрузка = Истина;
		ДокументОбъект.ДополнительныеСвойства.Вставить("ЕстьСоглашение", Истина);
		ДокументОбъект.ДополнительныеСвойства.Вставить("ПроцессыОбработкиДокументов_ЗаписатьБезПроверкиОбменДаннымиЗагрузка", Истина);
		Если Записывать Тогда
			Если НЕ ЗначениеЗаполнено(ДокументОбъект.Номер) Тогда
				ДокументОбъект.УстановитьНовыйНомер();
			КонецЕсли;
			ДокументОбъект.Записать(РежимЗаписи);
			СсылкаНаВладельца = ДокументОбъект.Ссылка;
		Иначе // если функция вызвана из формы "Обработки.ЭлектронныеДокументы.ФормаЗагрузкиПросмотраЭД"
			СсылкаНаВладельца = ДокументОбъект;
		КонецЕсли;
		
	Исключение
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Заполнение документа на основе ЭД. %1'"), Текст);
		ЗаписьЖурналаРегистрации(ТекстСообщения, УровеньЖурналаРегистрации.Ошибка, ДокументОбъект.Метаданные(), СсылкаНаВладельца,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение(Текст);
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область СопоставлениеНоменклатурыДополнительныеВарианты

Процедура ПодобратьВариантыСопоставленияПоНатуральнымКлючам(ТаблицаНоменклатурыКонтрагентов, ДополнительныеПараметры) Экспорт
	
	//Сопоставление лекарственных препаратов по МНН
	ПодобратьВариантыСопоставленияПоДополнительномуНаименованию(ТаблицаНоменклатурыКонтрагентов);
	
КонецПроцедуры

Процедура ПодобратьВариантыСопоставленияПоДополнительномуНаименованию(ТаблицаНоменклатурыКонтрагентов)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаНоменклатурыКонтрагентов", ТаблицаНоменклатурыКонтрагентов);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаНоменклатурыКонтрагентов.Наименование КАК Наименование
	|ПОМЕСТИТЬ ТаблицаДополнительныхНаименований
	|ИЗ
	|	&ТаблицаНоменклатурыКонтрагентов КАК ТаблицаНоменклатурыКонтрагентов
	|ГДЕ
	|	ТаблицаНоменклатурыКонтрагентов.НоменклатураИБ = НЕОПРЕДЕЛЕНО
	|	И ТаблицаНоменклатурыКонтрагентов.Наименование <> """"
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Наименование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаДополнительныхНаименований.Наименование КАК Наименование,
	|	Номенклатура.Ссылка КАК НоменклатураИБ,
	|	Номенклатура.ЕдиницаИзмерения КАК УпаковкаИБ
	|ИЗ
	|	ТаблицаДополнительныхНаименований КАК ТаблицаДополнительныхНаименований
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК Номенклатура
	|		ПО ((ВЫРАЗИТЬ(ТаблицаДополнительныхНаименований.Наименование КАК СТРОКА(1000))) = (ВЫРАЗИТЬ(Номенклатура.НаименованиеДополнительное КАК СТРОКА(1000))))
	|			И (НЕ Номенклатура.ПометкаУдаления)
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаДополнительныхНаименований.Наименование,
	|	Номенклатура.Ссылка,
	|	Номенклатура.ЕдиницаИзмерения";
	
	ТаблицаНоменклатурыПоДополнительнымНаименованиям = Запрос.Выполнить().Выгрузить();
	
	ТаблицаНоменклатурыКонтрагентов.Индексы.Добавить("Наименование, НоменклатураИБ");
	
	Для Каждого ТекСтрокаНоменклатуры Из ТаблицаНоменклатурыКонтрагентов Цикл
		Отбор = Новый Структура;
		Отбор.Вставить("Наименование", ТекСтрокаНоменклатуры.Наименование);
		НайденныеСтроки = ТаблицаНоменклатурыПоДополнительнымНаименованиям.НайтиСтроки(Отбор);
		Для Каждого Строка Из НайденныеСтроки Цикл
			
			ВариантСопоставления = СопоставлениеНоменклатурыКонтрагентовСлужебный.НовыйВариантСопоставленияНоменклатурыБЭД();
			ВариантСопоставления.НоменклатураИБ      = Строка.НоменклатураИБ;
			ВариантСопоставления.ПриоритетныйВариант = Истина;
			ВариантСопоставления.АртикулСопоставлен  = Ложь;
			СопоставлениеНоменклатурыКонтрагентовСлужебный.ЗаполнитьВариантСопоставленияНоменклатуры(ВариантСопоставления, 
				ТекСтрокаНоменклатуры.ВариантыСопоставленияНоменклатурыБЭД, Строка.НоменклатураИБ);
			
		КонецЦикла;
	КонецЦикла;	
КонецПроцедуры

#КонецОбласти

#Область СопоставлениеНоменклатурыКонтрольНаименований

Функция ЕстьРазличияВНоменклатуреПоставщикаИОрганизации(ИдентификаторНоменклатурыПоставщика, Номенклатура) Экспорт
	Результат = Ложь;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	НоменклатураКонтрагентовБЭД.Наименование КАК НаименованиеПоставщика,
	               |	НоменклатураКонтрагентовБЭД.Номенклатура КАК НоменклатураСопоставления
	               |ИЗ
	               |	РегистрСведений.НоменклатураКонтрагентовБЭД КАК НоменклатураКонтрагентовБЭД
	               |ГДЕ
	               |	НоменклатураКонтрагентовБЭД.Идентификатор = &ИдентификаторНоменклатуры";
    Запрос.УстановитьПараметр("ИдентификаторНоменклатуры", ИдентификаторНоменклатурыПоставщика);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		НоменклатураСовпадает = Истина;
		
		Если ТипЗнч(Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
			Реквизиты = "НаименованиеПолное";
			ЗначенияРеквизитовНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, Реквизиты);
			
			Если СокрЛП(ЗначенияРеквизитовНоменклатуры.НаименованиеПолное) = СокрЛП(Выборка.НаименованиеПоставщика) Тогда
				НоменклатураСовпадает = Истина;
			Иначе	
				НоменклатураСовпадает = Ложь;
			КонецЕсли;	
		ИначеЕсли ТипЗнч(Номенклатура) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
			Реквизиты = "НаименованиеПолное";
			ЗначенияРеквизитовНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, Реквизиты);
			Если СокрЛП(ЗначенияРеквизитовНоменклатуры.НаименованиеПолное) = СокрЛП(Выборка.НаименованиеПоставщика) Тогда
				НоменклатураСовпадает = Истина;
			Иначе	
				НоменклатураСовпадает = Ложь;
			КонецЕсли;	
		Иначе
			Если НЕ СокрЛП(Номенклатура) = СокрЛП(Выборка.НаименованиеПоставщика) Тогда
				НоменклатураСовпадает = Ложь;
			КонецЕсли;	
		КонецЕсли;
		Результат = НЕ НоменклатураСовпадает;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

Функция РазличающаясяНоменклатураКонтрагентаИОрганизации(ЭлектронныйДокументПоставщикаСсылка) Экспорт
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("НомерСтроки");
	Результат.Колонки.Добавить("Номенклатура");
	Результат.Колонки.Добавить("НаименованиеНоменклатурыКонтрагента");
	Результат.Колонки.Добавить("ПредставлениеНоменклатуры");
	Результат.Колонки.Добавить("ПолноеНаименованиеНоменклатуры");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Ссылка.Контрагент КАК Контрагент,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Номенклатура КАК Номенклатура,
	               |	ПРЕДСТАВЛЕНИЕ(ЭлектронныйДокументПоставщикаСписокНоменклатуры.Номенклатура) КАК ПредставлениеНоменклатуры,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.ИдентификаторПоставщика КАК ИдентификаторПоставщика,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.НомерСтроки КАК НомерСтроки
	               |ПОМЕСТИТЬ НоменклатураЭДП
	               |ИЗ
	               |	Документ.ЭлектронныйДокументПоставщика.СписокНоменклатуры КАК ЭлектронныйДокументПоставщикаСписокНоменклатуры
	               |ГДЕ
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Ссылка = &Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	НоменклатураЭДП.Номенклатура КАК Номенклатура,
	               |	НоменклатураЭДП.ПредставлениеНоменклатуры КАК ПредставлениеНоменклатуры,
	               |	НоменклатураЭДП.ИдентификаторПоставщика КАК ИдентификаторПоставщика,
	               |	НоменклатураКонтрагентовБЭД.Наименование КАК НаименованиеНоменклатурыКонтрагента,
	               |	НоменклатураКонтрагентовБЭД.Номенклатура КАК НоменклатураСопоставления,
	               |	ВЫБОР
	               |		КОГДА ТИПЗНАЧЕНИЯ(НоменклатураЭДП.Номенклатура) = ТИП(Справочник.ДенежныеДокументы)
	               |			ТОГДА НоменклатураЭДП.ПредставлениеНоменклатуры
	               |		ИНАЧЕ НоменклатураЭДП.Номенклатура.НаименованиеПолное
	               |	КОНЕЦ КАК ПолноеНаименованиеНоменклатуры,
	               |	НоменклатураЭДП.НомерСтроки КАК НомерСтроки
	               |ИЗ
	               |	НоменклатураЭДП КАК НоменклатураЭДП
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НоменклатураКонтрагентовБЭД КАК НоменклатураКонтрагентовБЭД
	               |		ПО НоменклатураЭДП.Контрагент = НоменклатураКонтрагентовБЭД.Владелец
	               |			И НоменклатураЭДП.ИдентификаторПоставщика = НоменклатураКонтрагентовБЭД.Идентификатор";
    Запрос.УстановитьПараметр("Ссылка", ЭлектронныйДокументПоставщикаСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоменклатураСовпадает = Истина;
		НаименованиеНоменклатурыКонтрагента = "";
		Если ЗначениеЗаполнено(Выборка.ИдентификаторПоставщика) Тогда
			Если ЗначениеЗаполнено(Выборка.НаименованиеНоменклатурыКонтрагента) Тогда
				НаименованиеНоменклатурыКонтрагента = СокрЛП(Выборка.НаименованиеНоменклатурыКонтрагента);
			Иначе
				НаименованиеНоменклатурыКонтрагента = СокрЛП(Выборка.ПредставлениеНоменклатуры);
			КонецЕсли;
			Если ТипЗнч(Выборка.Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
				Если СокрЛП(Выборка.ПолноеНаименованиеНоменклатуры) = НаименованиеНоменклатурыКонтрагента Тогда
					НоменклатураСовпадает = Истина;
				Иначе	
					НоменклатураСовпадает = Ложь;
				КонецЕсли;	
			ИначеЕсли ТипЗнч(Выборка.Номенклатура) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
				Если СокрЛП(Выборка.ПолноеНаименованиеНоменклатуры) = НаименованиеНоменклатурыКонтрагента Тогда
					НоменклатураСовпадает = Истина;
				Иначе	
					НоменклатураСовпадает = Ложь;
				КонецЕсли;	
			Иначе
				Если НЕ СокрЛП(Выборка.ПредставлениеНоменклатуры) = НаименованиеНоменклатурыКонтрагента Тогда
					НоменклатураСовпадает = Ложь;
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;	
		
		Если НЕ НоменклатураСовпадает Тогда
			НоваяСтрока = Результат.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат Результат;
КонецФункции

Функция ТекстСообщенияОРазличающейсяНоменклатуре(ЭДП, РазличающаясяНоменклатураКонтрагентаИОрганизации) Экспорт
	СтрокиСРазличиями = СписокНомеровСтрокРазличающейсяНоменклатурыТекстом(РазличающаясяНоменклатураКонтрагентаИОрганизации);
	Результат = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='У документа %1 есть отличия в наименовании номенклатуры контрагента и организации.
	|%2'"), ЭДП, СтрокиСРазличиями);
	
	Возврат Результат;
КонецФункции

Функция СписокНомеровСтрокРазличающейсяНоменклатурыТекстом(ДанныеОРазличиях) Экспорт
	Результат = "";

	Если ДанныеОРазличиях.Количество() = 0 Тогда
		Возврат Результат; 
	КонецЕсли;
	
	СписокСтрок = "";                                          
	СчетчикСтрок = 0;
	Для Каждого ТекСтрока Из ДанныеОРазличиях Цикл
		СчетчикСтрок = СчетчикСтрок + 1;
		СписокСтрок = СписокСтрок + СокрЛП(ТекСтрока.НомерСтроки);
		Если ДанныеОРазличиях.Количество() > 1 И ДанныеОРазличиях.Количество() <> СчетчикСтрок Тогда
			СписокСтрок = СписокСтрок + ", ";
		КонецЕсли;	
	КонецЦикла;
	
	Если ДанныеОРазличиях.Количество() = 1 Тогда
		Результат = СтрШаблон(НСтр("ru = 'Необходимо сверить наименование номенклатуры в строке %1, указать номенклатуру с корректным полным наименованием, записать документ и повторить операцию.'"), СписокСтрок);
	Иначе
		Результат = СтрШаблон(НСтр("ru = 'Необходимо сверить наименование номенклатуры в строках %1, указать номенклатуру с корректным полным наименованием, записать документ и повторить операцию.'"), СписокСтрок);
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

#КонецОбласти

#Область СвязьВнутреннегоИВнешнегоЭДО

Функция ТекстЗапросаЭлектронныхДокументовСФайламиОбъектаУчета() Экспорт
	
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ОбъектыУчетаДокументовЭДО.ЭлектронныйДокумент КАК ЭлектронныйДокумент,
		|	ОбъектыУчетаДокументовЭДО.ОбъектУчета КАК ОбъектУчета,
		|	ОбъектыУчетаДокументовЭДО.СпособОбработки КАК СпособОбработки,
		|	ОбъектыУчетаДокументовЭДО.Актуальный КАК Актуальный,
		|	СостоянияДокументовЭДО.Состояние КАК СостояниеЭДО,
		|	ОбъектыУчетаДокументовЭДО.ЭлектронныйДокумент.Дата КАК ЭлектронныйДокументДата,
		|	ОбъектыУчетаДокументовЭДО.ЭлектронныйДокумент.Комментарий КАК ЭлектронныйДокументКомментарий
		|ПОМЕСТИТЬ ЭлектронныеДокументы
		|ИЗ
		|	РегистрСведений.ОбъектыУчетаДокументовЭДО КАК ОбъектыУчетаДокументовЭДО
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияДокументовЭДО КАК СостоянияДокументовЭДО
		|		ПО (СостоянияДокументовЭДО.ЭлектронныйДокумент = ОбъектыУчетаДокументовЭДО.ЭлектронныйДокумент)
		|ГДЕ
		|	ОбъектыУчетаДокументовЭДО.ОбъектУчета В(&ОбъектУчета)
		|	И СостоянияДокументовЭДО.Состояние В(&СостоянияЗавершения)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СообщениеЭДО.ЭлектронныйДокумент КАК ЭлектронныйДокумент,
		|	ЭлектронныеДокументы.ОбъектУчета КАК ОбъектУчета,
		|	ЭлектронныеДокументы.ЭлектронныйДокументДата КАК ЭлектронныйДокументДата,
		|	ПрисоединенныеФайлы.Ссылка КАК ФайлЭД,
		|	ПрисоединенныеФайлы.Размер КАК Размер,
		|	ПрисоединенныеФайлы.Расширение КАК Расширение,
		|	ЭлектронныеДокументы.СостояниеЭДО КАК СостояниеЭДО
		|ИЗ
		|	ЭлектронныеДокументы КАК ЭлектронныеДокументы
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СообщениеЭДО КАК СообщениеЭДО
		|		ПО ЭлектронныеДокументы.ЭлектронныйДокумент = СообщениеЭДО.ЭлектронныйДокумент
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СообщениеЭДОПрисоединенныеФайлы КАК ПрисоединенныеФайлы
		|		ПО (СообщениеЭДО.ОсновнойФайл = ПрисоединенныеФайлы.Ссылка)
		|ГДЕ
		|	ЭлектронныеДокументы.Актуальный = ИСТИНА
		|	И СообщениеЭДО.ТипЭлементаРегламента = ЗНАЧЕНИЕ(Перечисление.ТипыЭлементовРегламентаЭДО.ИнформацияОтправителя)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЭлектронныйДокументДата УБЫВ";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ПолучитьЭлектронныеДокументыБЭДПоУчетномуДокументу(СсылкаНаОбъектИсточник) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОбъектыУчетаДокументовЭДО.ЭлектронныйДокумент КАК ЭлектронныйДокумент,
	               |	ОбъектыУчетаДокументовЭДО.ОбъектУчета КАК ОбъектУчета,
	               |	ОбъектыУчетаДокументовЭДО.СпособОбработки КАК СпособОбработки,
	               |	ОбъектыУчетаДокументовЭДО.Актуальный КАК Актуальный,
	               |	СостоянияДокументовЭДО.Состояние КАК СостояниеЭДО,
	               |	ОбъектыУчетаДокументовЭДО.ЭлектронныйДокумент.Дата КАК ЭлектронныйДокументДата
	               |ПОМЕСТИТЬ ЭлектронныеДокументы
	               |ИЗ
	               |	РегистрСведений.ОбъектыУчетаДокументовЭДО КАК ОбъектыУчетаДокументовЭДО
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияДокументовЭДО КАК СостоянияДокументовЭДО
	               |		ПО (СостоянияДокументовЭДО.ЭлектронныйДокумент = ОбъектыУчетаДокументовЭДО.ЭлектронныйДокумент)
	               |ГДЕ
	               |	ОбъектыУчетаДокументовЭДО.ОбъектУчета В(&ОбъектУчета)
				   |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СообщениеЭДО.ЭлектронныйДокумент КАК ЭлектронныйДокумент,
	               |	ЭлектронныеДокументы.ОбъектУчета КАК ОбъектУчета,
	               |	ЭлектронныеДокументы.СостояниеЭДО КАК СостояниеЭДО
	               |ИЗ
	               |	ЭлектронныеДокументы КАК ЭлектронныеДокументы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СообщениеЭДО КАК СообщениеЭДО
	               |		ПО ЭлектронныеДокументы.ЭлектронныйДокумент = СообщениеЭДО.ЭлектронныйДокумент
	               |ГДЕ
	               |	ЭлектронныеДокументы.Актуальный = ИСТИНА
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЭлектронныеДокументы.ЭлектронныйДокументДата УБЫВ";
	
	
	Запрос.УстановитьПараметр("ОбъектУчета", СсылкаНаОбъектИсточник);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ВнешниеПроизвольныеЭлектронныеДокументыУчетногоДокумента(УчетныйДокумент) Экспорт
	СостоянияЗавершения = Новый Массив;
	СостоянияЗавершения.Добавить(Перечисления.СостоянияДокументовЭДО.ОбменЗавершен);

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаЭлектронныхДокументовСФайламиОбъектаУчета();
	Запрос.УстановитьПараметр("ОбъектУчета", УчетныйДокумент);
	Запрос.УстановитьПараметр("СостоянияЗавершения", СостоянияЗавершения);
	
	Результат = Запрос.Выполнить().Выгрузить();

	Возврат Результат;
КонецФункции

Функция ВсеВнешниеПроизвольныеЭлектронныеДокументыУчетногоДокумента(УчетныйДокумент) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СостоянияДокументовЭДО.Ссылка КАК Ссылка
	               |ИЗ
	               |	Перечисление.СостоянияДокументовЭДО КАК СостоянияДокументовЭДО";
	
	ВсеСостояния = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаЭлектронныхДокументовСФайламиОбъектаУчета();
	Запрос.УстановитьПараметр("ОбъектУчета", УчетныйДокумент);
	Запрос.УстановитьПараметр("СостоянияЗавершения", ВсеСостояния);
	
	Результат = Запрос.Выполнить().Выгрузить();

	Возврат Результат;
КонецФункции

Функция ВсеВнешниеПроизвольныеЭлектронныеДокументыВнутреннегоДокумента(ВнутреннийЭД) Экспорт
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ЭлектронныйДокумент");
	Результат.Колонки.Добавить("ТипФайлаФормуляра");
	Результат.Колонки.Добавить("СостояниеЭДО");
	
	РеквизитыДокументов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВнутреннийЭД, "УчетныйДокумент");
	
	ПроизвольныеЭД = ВсеВнешниеПроизвольныеЭлектронныеДокументыУчетногоДокумента(РеквизитыДокументов.УчетныйДокумент);

	GUIDВнутреннегоЭД = Строка(ВнутреннийЭД.УникальныйИдентификатор());
	
	Для Каждого ТекСтрока Из ПроизвольныеЭД Цикл
		ИмяФайла = Строка(ТекСтрока.ФайлЭД);
		GUIDДокумента = Сред(ИмяФайла, 1, 36);
		Если GUIDДокумента = GUIDВнутреннегоЭД Тогда
			СтрокаТипаДокумента = Сред(ИмяФайла, 38, 1);
			ПередачаОригинала = Ложь;
			Если СтрокаТипаДокумента = "1" Тогда
				ПередачаОригинала = Истина;
			КонецЕсли;
			
			НоваяСтрока = Результат.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			НоваяСтрока.ТипФайлаФормуляра = ?(ПередачаОригинала, 1, 2);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции
	
Процедура СозданиеНовогоПредставленияФормуляраPDF(Организация, ВнутреннийЭД, УчетныйДокумент, ОсновнойФайл, ОсновнойФайлPDF, ПредставлениеФормуляраФайлPDF, НеСоздаватьФайлPDF) Экспорт

	УстановитьПривилегированныйРежим(Истина);

	ПараметрыДанных = РаботаСФайламиКлиентСервер.ПараметрыДанныхФайла();
	ПараметрыДанных.ВызыватьИсключение = Ложь;

	ДанныеФайла = РаботаСФайлами.ДанныеФайла(ОсновнойФайл, ПараметрыДанных);
	
	ИмяФайла = ДанныеФайла.ИмяФайла;
	Если ТипЗнч(УчетныйДокумент) = Тип("ДокументСсылка.РегистрУчета") Тогда
		РеквизитыДокументов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(УчетныйДокумент, "ВидРегистра, НачалоПериода, КонецПериода");
			
		Если ЗначениеЗаполнено(РеквизитыДокументов.НачалоПериода) И ЗначениеЗаполнено(РеквизитыДокументов.КонецПериода) Тогда
			ИмяБезРасширения = СтрШаблон("%1 (%2-%3)    ", РеквизитыДокументов.ВидРегистра, 
				Формат(РеквизитыДокументов.НачалоПериода, "ДФ=dd.MM.yyyy"), Формат(РеквизитыДокументов.КонецПериода, "ДФ=dd.MM.yyyy"));
		ИначеЕсли ЗначениеЗаполнено(РеквизитыДокументов.НачалоПериода) Тогда
			ИмяБезРасширения = СтрШаблон("%1 (%2)    ", РеквизитыДокументов.ВидРегистра, Формат(РеквизитыДокументов.НачалоПериода, "ДФ=dd.MM.yyyy"));
		ИначеЕсли ЗначениеЗаполнено(РеквизитыДокументов.КонецПериода) Тогда
			ИмяБезРасширения = СтрШаблон("%1 (%2)    ", РеквизитыДокументов.ВидРегистра, Формат(РеквизитыДокументов.КонецПериода, "ДФ=dd.MM.yyyy"));
		Иначе
			ИмяБезРасширения = СтрШаблон("%1    ", РеквизитыДокументов.ВидРегистра);
		КонецЕсли;	
			
		ИмяБезРасширения = СтрЗаменить(ИмяБезРасширения, " ", "_");
		ИмяФайла = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(ИмяБезРасширения, "_");
	КонецЕсли;	
	
	ИмяФайлаБезРасширения = Сред(ИмяФайла, 1, СтрДлина(ИмяФайла) - 4);
	ИмяВременногоКаталога = ФайловаяСистема.СоздатьВременныйКаталог();
	
	ИмяПодкаталога = ИмяВременногоКаталога;
	
	ИмяФайлаPDFБезРасширения = Сред(ИмяФайла, 1, СтрДлина(ИмяФайла) - 4) + " (формуляр)";
	ПолноеИмяФайлаPDF = ИмяПодкаталога + ИмяФайлаPDFБезРасширения + ".pdf";

	ИмяФайлаPDFПредставленияФормуляраБезРасширения = Сред(ИмяФайла, 1, СтрДлина(ИмяФайла) - 4) + " (копия)";
	ПолноеИмяФайлаПредставленияФормуляраPDF = ИмяПодкаталога + ИмяФайлаPDFПредставленияФормуляраБезРасширения + ".pdf";
	
	ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(ДанныеФайла.СсылкаНаДвоичныеДанныеФайла);
	
	Если ДвоичныеДанныеФайла = Неопределено Тогда
		НеСоздаватьФайлPDF = Истина;
		Возврат;
	КонецЕсли;

	//Представление (копия)
	ЭлектронныеПодписиКопии = НовыйСписокЭлектронныхПодписейВнутреннегоЭД();
	ЗаполнитьСписокПодписей(ЭлектронныеПодписиКопии, ОсновнойФайл, Организация);
	
	СохраненныйТабличныйДокументПредставленияФормуляра = ВнутреннийЭДО.ТабличныйДокументИзДвоичныхДанныхАрхива(ДвоичныеДанныеФайла);

	//Отступ чтобы штампы не накладывались на представление документа
	МакетШтампов = УправлениеПечатью.МакетПечатнойФормы("Документ.ВнутреннийЭлектронныйДокумент.ПФ_MXL_ШтампПЭП");
	ОбластьМакета = МакетШтампов.ПолучитьОбласть("Отступ");
	СохраненныйТабличныйДокументПредставленияФормуляра.Вывести(ОбластьМакета);
	
	ДобавитьШтампыЭлектронныхПодписейВнутреннегоЭДО(СохраненныйТабличныйДокументПредставленияФормуляра, ЭлектронныеПодписиКопии, Организация);
	
	СохраненныйТабличныйДокументПредставленияФормуляра.АвтоМасштаб = Истина;
	СохраненныйТабличныйДокументПредставленияФормуляра.Записать(ПолноеИмяФайлаПредставленияФормуляраPDF, ТипФайлаТабличногоДокумента.PDF_A_3);
	
	ДвоичныеДанныеФайлаПредставленияФормуляраPDF = Новый ДвоичныеДанные(ПолноеИмяФайлаПредставленияФормуляраPDF);
	
	ПараметрыФайла = РаботаСФайлами.ПараметрыДобавленияФайла();
	ПараметрыФайла.Автор = Пользователи.ТекущийПользователь();
	ПараметрыФайла.ВладелецФайлов = ВнутреннийЭД;
	ПараметрыФайла.ИмяБезРасширения = ИмяФайлаPDFПредставленияФормуляраБезРасширения+ ".pdf";
	ПараметрыФайла.Служебный = Ложь;
	
	ИдентификаторФормы = Новый УникальныйИдентификатор;
	АдресФайлаПредставленияФормуляраPDF = ПоместитьВоВременноеХранилище(ДвоичныеДанныеФайлаПредставленияФормуляраPDF, ИдентификаторФормы);
	
	ПредставлениеФормуляраФайлPDF = РаботаСФайлами.ДобавитьФайл(ПараметрыФайла, АдресФайлаПредставленияФормуляраPDF);

	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура КопияФормуляраВнешнийЭлектронныйДокументФайла(ВнутреннийЭД, ПараметрыФормы) Экспорт
	
	РеквизитыДокументов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВнутреннийЭД, "Организация, ОсновнойФайл, ОсновнойФайлPDF, ПредставлениеФормуляраФайлPDF, УчетныйДокумент");
	ОсновнойФайлПустой = Справочники.ВнутреннийЭлектронныйДокументПрисоединенныеФайлы.ПустаяСсылка();

	Если НЕ ЗначениеЗаполнено(РеквизитыДокументов.ПредставлениеФормуляраФайлPDF) Тогда
		//создание новой копии формуляра
		УстановитьПривилегированныйРежим(Истина);
		
		ОсновнойФайлКопииФормуляраPDF = ОсновнойФайлПустой;
		ПредставлениеФормуляраФайлPDF = ОсновнойФайлПустой;
		УчетныйДокумент = РеквизитыДокументов.УчетныйДокумент;
		Организация = РеквизитыДокументов.Организация;
		СозданиеНовогоПредставленияФормуляраPDF(Организация, ВнутреннийЭД, УчетныйДокумент, РеквизитыДокументов.ОсновнойФайл, ОсновнойФайлКопииФормуляраPDF, ПредставлениеФормуляраФайлPDF, Ложь);
	Иначе
		ПредставлениеФормуляраФайлPDF = РеквизитыДокументов.ПредставлениеФормуляраФайлPDF; 
	КонецЕсли;	
	
	ПараметрыДанных = РаботаСФайламиКлиентСервер.ПараметрыДанныхФайла();
	ПараметрыДанных.ВызыватьИсключение = Ложь;
	
	ОсновнойФайлPDF = ПредставлениеФормуляраФайлPDF;
	ДанныеФайлаPDF = Неопределено;

	Если ЗначениеЗаполнено(ОсновнойФайлPDF) Тогда
		ДанныеФайлаPDF = РаботаСФайлами.ДанныеФайла(ПредставлениеФормуляраФайлPDF, ПараметрыДанных);
		ИмяФайлаБезРасширения = Сред(ДанныеФайлаPDF.ИмяФайла, 1, СтрДлина(ДанныеФайлаPDF.ИмяФайла) - 4);
	Иначе
		//Файл представления в формате PDF отсутствует
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Файл копии формуляра в формате PDF для %1 отсутствует.'"), ВнутреннийЭД);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		
		Возврат;
	КонецЕсли;
	
	ДвоичныеДанныеФайлаPDF = ПолучитьИзВременногоХранилища(ДанныеФайлаPDF.СсылкаНаДвоичныеДанныеФайла);
	Если НЕ ДвоичныеДанныеФайлаPDF = Неопределено Тогда
		
		GUIDВнутреннегоЭД = ВнутреннийЭД.УникальныйИдентификатор();
		ШаблонИмениФайла = "%1_2_%2";
		НовоеИмяФайла = СтрШаблон(ШаблонИмениФайла, GUIDВнутреннегоЭД, ИмяФайлаБезРасширения);
		ОграничениеДлиныИмениФайла = 130;
		Если СтрДлина(НовоеИмяФайла) > ОграничениеДлиныИмениФайла Тогда
			ИмяФайлаБезРасширения = Сред(НовоеИмяФайла, 1, ОграничениеДлиныИмениФайла);
		Иначе
			ИмяФайлаБезРасширения = Сред(НовоеИмяФайла, 1, СтрДлина(НовоеИмяФайла) - 4);
		КонецЕсли;
		
		ПараметрыФормы.Вставить("ДвоичныеДанныеФайла", ДвоичныеДанныеФайлаPDF);
		ПараметрыФормы.Вставить("НаименованиеФайла", ИмяФайлаБезРасширения);
		ПараметрыФормы.Вставить("Расширение", "pdf");
		ПараметрыФормы.Вставить("Уникальность", Истина);
		ПараметрыФормы.Вставить("Основание", РеквизитыДокументов.УчетныйДокумент);
	КонецЕсли;
КонецПроцедуры

Процедура ВнешнийЭлектронныйДокументФайла(ВнутреннийЭД, ПараметрыФормы) Экспорт
	РеквизитыДокументов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВнутреннийЭД, "ОсновнойФайл, ОсновнойФайлPDF, УчетныйДокумент");
	
	ПараметрыДанных = РаботаСФайламиКлиентСервер.ПараметрыДанныхФайла();
	ПараметрыДанных.ВызыватьИсключение = Ложь;
	
	ДанныеФайла = РаботаСФайлами.ДанныеФайла(РеквизитыДокументов.ОсновнойФайл, ПараметрыДанных);
	
	ОсновнойФайлPDF = РеквизитыДокументов.ОсновнойФайлPDF;
	ДанныеФайлаPDF = Неопределено;

	ДвоичныеДанныеФайла = ПолучитьИзВременногоХранилища(ДанныеФайла.СсылкаНаДвоичныеДанныеФайла);
	
	Если ДвоичныеДанныеФайла = Неопределено Тогда
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Документ %1 не содержит файлов. Возможно, он помечен на удаление'"), ВнутреннийЭД);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОсновнойФайлPDF) Тогда
		ДанныеФайлаPDF = РаботаСФайлами.ДанныеФайла(ОсновнойФайлPDF, ПараметрыДанных);
		ИмяФайлаБезРасширения = Сред(ДанныеФайлаPDF.ИмяФайла, 1, СтрДлина(ДанныеФайлаPDF.ИмяФайла) - 4);
	Иначе
		//Файл в формате PDF отсутствует
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Файл формуляра в формате PDF для %1 отсутствует.
		|Вероятно, эта возможность появилась в более поздней версии программы, по сравнению с той, 
		|где был подписан внутренний электронный документ.
		|Для формирования файла формуляра в формате PDF следует аннулировать старый электронный документ, 
		|сформировать и подписать новый внутренний электронный документ и повторить попытку, если это необходимо.'"), ВнутреннийЭД);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОсновнойФайлPDF) Тогда
		ДвоичныеДанныеФайлаPDF = ПолучитьИзВременногоХранилища(ДанныеФайлаPDF.СсылкаНаДвоичныеДанныеФайла);
		Если НЕ ДвоичныеДанныеФайлаPDF = Неопределено Тогда
			
			GUIDВнутреннегоЭД = ВнутреннийЭД.УникальныйИдентификатор();
			ШаблонИмениФайла = "%1_1_%2";
			НовоеИмяФайла = СтрШаблон(ШаблонИмениФайла, GUIDВнутреннегоЭД, ИмяФайлаБезРасширения);
			ОграничениеДлиныИмениФайла = 130;
			Если СтрДлина(НовоеИмяФайла) > ОграничениеДлиныИмениФайла Тогда
				ИмяФайлаБезРасширения = Сред(НовоеИмяФайла, 1, ОграничениеДлиныИмениФайла);
			Иначе
				ИмяФайлаБезРасширения = Сред(НовоеИмяФайла, 1, СтрДлина(НовоеИмяФайла) - 4);;
			КонецЕсли;
			
			ПараметрыФормы.Вставить("ДвоичныеДанныеФайла", ДвоичныеДанныеФайлаPDF);
			ПараметрыФормы.Вставить("НаименованиеФайла", ИмяФайлаБезРасширения);
			ПараметрыФормы.Вставить("Расширение", "pdf");
			ПараметрыФормы.Вставить("Уникальность", Истина);
			ПараметрыФормы.Вставить("Основание", РеквизитыДокументов.УчетныйДокумент);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Функция ЭлектронныеПодписиВнешнегоЭДСвязанногоСВнутреннимЭД(ВнутреннийЭД) Экспорт
	
	Результат = Новый Массив;
	ЭтоОригиналФормуляра = Ложь;

	УстановитьПривилегированныйРежим(Истина);
	
	РеквизитыДокументов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВнутреннийЭД, "УчетныйДокумент");
	
	ЭлектронныеДокументыВнешнегоЭДО = ВсеВнешниеПроизвольныеЭлектронныеДокументыВнутреннегоДокумента(ВнутреннийЭД);
	
	Для Каждого ТекСтрока Из ЭлектронныеДокументыВнешнегоЭДО Цикл
		ЭтоОригиналФормуляра = ?(ТекСтрока.ТипФайлаФормуляра = 1, Истина, Ложь);
		Если ТекСтрока.ЭлектронныйДокумент.ТипРегламента = Перечисления.ТипыРегламентовЭДО.Неформализованный Тогда 
			Если ТекСтрока.СостояниеЭДО = Перечисления.СостоянияДокументовЭДО.ОбменЗавершен Тогда
				ЭлектронныеПодписиЭД = СведенияОПодписяхВнешнегоЭлектронногоДокумента(ТекСтрока.ЭлектронныйДокумент);
				
				Для Каждого ТекПодпись Из ЭлектронныеПодписиЭД Цикл
					ТекПодпись.Вставить("ЭтоОригиналФормуляра", ЭтоОригиналФормуляра);
				КонецЦикла;
				
				ОбщегоНазначенияКлиентСервер.ДополнитьМассив(Результат, ЭлектронныеПодписиЭД, Истина);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции		

Функция СведенияОПодписяхВнешнегоЭлектронногоДокумента(ЭлектронныйДокумент) Экспорт

	Результат  = Новый Массив;

	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СообщениеЭДО.Ссылка КАК СообщениеЭДО
		|ИЗ
		|	Документ.СообщениеЭДО КАК СообщениеЭДО
		|ГДЕ
		|	СообщениеЭДО.ЭлектронныйДокумент = &ЭлектронныйДокумент
		|	И СообщениеЭДО.ТипЭлементаРегламента В(&ТипыЭлементовРегламента)";
	
	ТипыЭлементовРегламента = Новый Массив;
	ТипыЭлементовРегламента.Добавить(Перечисления.ТипыЭлементовРегламентаЭДО.ИнформацияОтправителя);
	ТипыЭлементовРегламента.Добавить(Перечисления.ТипыЭлементовРегламентаЭДО.ИнформацияПолучателя);
	
	Запрос.УстановитьПараметр("ЭлектронныйДокумент", ЭлектронныйДокумент);
	Запрос.УстановитьПараметр("ТипыЭлементовРегламента", ТипыЭлементовРегламента);
	РезультатыЗапроса = Запрос.Выполнить();
	
	ВыборкаСообщений = РезультатыЗапроса.Выбрать();

	ВсеПодписи = Новый Массив;
	Пока ВыборкаСообщений.Следующий() Цикл
		КоллекцияПодписейСУчетомМЧД = 
			ЭлектронныеДокументыЭДО.УстановленныеПодписиСУчетомДоверенностей(ВыборкаСообщений.СообщениеЭДО);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ВсеПодписи, КоллекцияПодписейСУчетомМЧД, Истина);
	КонецЦикла;
	
	Для Каждого Подпись Из ВсеПодписи Цикл
		ДанныеПодписи = Подпись;
		ДанныеПодписи.Вставить("Организация", "");
		ДанныеПодписи.Вставить("ИНН", "");
		ДанныеПодписи.Вставить("НомерСертификата", "");
		ДанныеПодписи.Вставить("ВладелецСертификата", "");
		ДанныеПодписи.Вставить("СрокДействия", "");
		
		ДанныеПодписи.НомерСертификата = ДанныеПодписи.СвойстваПодписи.ХешПодписи;
		ДанныеПодписи.ВладелецСертификата = ДанныеПодписи.СвойстваПодписи.Владелец;

		Сертификат = Новый СертификатКриптографии(Подпись.СвойстваПодписи.Сертификат.Получить());
		ДанныеПодписи.СрокДействия = СтрШаблон(НСтр("ru='с %1 по %2'"),
			Формат(Сертификат.ДатаНачала, "ДФ=dd.MM.yyyy"), 
			Формат(Сертификат.ДатаОкончания, "ДФ=dd.MM.yyyy"));
		
		Если ДанныеПодписи.ЭтоПодписьПоДоверенности Тогда
			Если НЕ Подпись.СвойстваДоверенности = Неопределено	Тогда
				ДанныеПодписи.Организация = Подпись.СвойстваДоверенности.Доверитель;
				ДанныеПодписи.ИНН = Подпись.СвойстваДоверенности.ДоверительИНН;
				Владелец = ДанныеПодписи.СвойстваПодписи.Владелец;
				
				Если ЗначениеЗаполнено(ДанныеПодписи.СвойстваДоверенности) Тогда
					Если ЗначениеЗаполнено(ДанныеПодписи.СвойстваДоверенности.НомерДоверенности) Тогда
						ОтметкаМЧД = СтрШаблон(НСтр("ru='по доверенности %1, от %2, действует: с %3 по %4'"),
						ДанныеПодписи.СвойстваДоверенности.НомерДоверенности, ДанныеПодписи.СвойстваДоверенности.Доверитель,
						Формат(ДанныеПодписи.СвойстваДоверенности.ДатаВыдачи, "ДФ=dd.MM.yyyy"),
						Формат(ДанныеПодписи.СвойстваДоверенности.ДатаОкончания, "ДФ=dd.MM.yyyy"));
						
						ВладелецИзШтампа = ДанныеПодписи.СвойстваПодписи.Владелец;
						ВладелецИСведенияМЧД = СтрШаблон(НСтр("ru='%1, %2'"), ВладелецИзШтампа, ОтметкаМЧД);
						ДанныеПодписи.ВладелецСертификата = ВладелецИСведенияМЧД;
					КонецЕсли;	
				КонецЕсли;
			КонецЕсли;
		Иначе
			Если Сертификат.Субъект.Свойство("OID1_2_643_3_131_1_1") Тогда
				Если СтрДлина(Сертификат.Субъект.OID1_2_643_3_131_1_1) = 12 Тогда
					ИННИзСертификата = Сертификат.Субъект.OID1_2_643_3_131_1_1;
					Если Сертификат.Субъект.Свойство("OID1_2_643_100_4") Тогда
						ИННИзСертификата = Сертификат.Субъект.OID1_2_643_100_4;
					КонецЕсли;	
				Иначе
					ИННИзСертификата = Сертификат.Субъект.OID1_2_643_3_131_1_1;
				КонецЕсли;
			ИначеЕсли Сертификат.Субъект.Свойство("OID1_2_643_100_4") Тогда
				ИННИзСертификата = Сертификат.Субъект.OID1_2_643_100_4;
			КонецЕсли;
			
			Если Сред(ИННИзСертификата, 1, 2) = "00" Тогда
				ИННИзСертификата = Сред(ИННИзСертификата, 3);
			КонецЕсли;
			
			ДанныеПодписи.ИНН = ИННИзСертификата;
			
			Если Сертификат.Субъект.Свойство("CN") Тогда
				ДанныеПодписи.Организация = Сертификат.Субъект.CN;
			Иначе
				Если Сертификат.Субъект.Свойство("OID2_5_4_3") Тогда
					ДанныеПодписи.Организация = Сертификат.Субъект.OID2_5_4_3;
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;	
		
		Результат.Добавить(ДанныеПодписи);
	КонецЦикла;
	
	Возврат Результат;

КонецФункции

Процедура ДобавитьШтампыЭлектронныхПодписейВнешнегоЭД(ТабличныйДокументЭД, ЭлектронныеПодписиВнешнегоЭД, Организация, ВыводитьДатуПодписи = Истина, ВыводитьШтампыТолькоКонтрагента = Истина) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	МакетЭПКонтрагента = УправлениеПечатью.МакетПечатнойФормы("Документ.ВнутреннийЭлектронныйДокумент.ПФ_MXL_ШтампЭЦПКонтрагента");
	
	Штамп = Новый ТабличныйДокумент;
	ПараметрыПечатиЭД = Новый Структура;
	Счетчик = 0;
	
	ЕстьШтампыЭП = Ложь;
	ШиринаДокумента = ШиринаТабличногоДокументаВСимволах(ТабличныйДокументЭД);
	ШиринаШтампа = 0;
	КоличествоШтамповВРяду = 0;
	ВывелиШтамповВРяду = 0;

	Для Каждого Подпись Из ЭлектронныеПодписиВнешнегоЭД Цикл
		Счетчик = Счетчик + 1;
		
		Если Подпись.ЭтоОригиналФормуляра Тогда
			ОбластьШтамп = МакетЭПКонтрагента.ПолучитьОбласть("ОбластьСтрокШтамп|ШтампОдинарный");
		Иначе
			ОбластьШтамп = МакетЭПКонтрагента.ПолучитьОбласть("ОбластьСтрокШтампКопии|ШтампОдинарный");
		КонецЕсли;

		ОбластьШтамп.Параметры.Заполнить(Подпись);
		Если ВыводитьДатуПодписи Тогда
			ЗначенияПараметров = Новый Структура;
			ЗначенияПараметров.Вставить("ДатаПодписи", Подпись.СвойстваПодписи.ДатаПодписи);
			
			ОбластьШтамп.Параметры.Заполнить(ЗначенияПараметров);
		КонецЕсли;
		
		ВывестиШтамп = Ложь;
		Если ВыводитьШтампыТолькоКонтрагента Тогда
			Если НЕ ЭтоОрганизацияОтправительПоИНН(Подпись, Организация) Тогда
				ВывестиШтамп = Истина;
			КонецЕсли;
		Иначе
			ВывестиШтамп = Истина;
		КонецЕсли;
		
		Если ВывестиШтамп Тогда
			ЕстьШтампыЭП = Истина;
			
			Если ВывелиШтамповВРяду = 0 Тогда
				ОбщегоНазначенияБЭД.ВывестиОбластьВТабличныйДокумент(Штамп, ОбластьШтамп, "ШтампЭП" + Счетчик);
				
				ШиринаШтампа = ШиринаТабличногоДокументаВСимволах(ОбластьШтамп);
				КоличествоШтамповВРяду = Цел(ШиринаДокумента/ШиринаШтампа);
				ВывелиШтамповВРяду = ВывелиШтамповВРяду + 1;
			Иначе
				Если ВывелиШтамповВРяду <= КоличествоШтамповВРяду Тогда
					ОбщегоНазначенияБЭД.ПрисоединитьОбластьКТабличномуДокументу(Штамп, ОбластьШтамп, "ШтампЭП" + Счетчик);
					ВывелиШтамповВРяду = ВывелиШтамповВРяду + 1;
				КонецЕсли;
				Если ВывелиШтамповВРяду = КоличествоШтамповВРяду Тогда
					ВывелиШтамповВРяду = 0;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
	
	Если ЕстьШтампыЭП Тогда
		Штамп.Область().СоздатьФорматСтрок();
		ОбщегоНазначенияБЭД.ВывестиОбластьВТабличныйДокумент(ТабличныйДокументЭД, Штамп, "ШтампыВнешнихЭП");
		Штамп.Очистить();
	КонецЕсли;
КонецПроцедуры

Функция ЭтоОрганизацияОтправительПоИНН(Подпись, Организация) Экспорт
	Результат = Ложь;

	РеквизитыОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Организация, "ИНН");
	
	Если СокрЛП(Подпись.ИНН) = СокрЛП(РеквизитыОрганизации.ИНН) Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область ФайлыЭлектронногоИзвещения

Функция ДанныеФайловПрисоединенныхКДокументуИзвещения(СсылкаНаДокумент) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ПриложенныеФайлыДляЭДОБГУ.ДокументЭД КАК ДокументЭД,
	|	ПриложенныеФайлыДляЭДОБГУ.ПрисоединенныйФайл КАК ПрисоединенныйФайл,
	|	ПриложенныеФайлыДляЭДОБГУ.НаименованиеДокументаФайла КАК НаименованиеДокументаФайла,
	|	ПриложенныеФайлыДляЭДОБГУ.ВидСведений КАК ВидСведений
	|ИЗ
	|	РегистрСведений.ПриложенныеФайлыДляЭДОБГУ КАК ПриложенныеФайлыДляЭДОБГУ
	|ГДЕ
	|	ПриложенныеФайлыДляЭДОБГУ.ДокументЭД = &ДокументЭД";
		
	Запрос.УстановитьПараметр("ДокументЭД", СсылкаНаДокумент);
	Выборка = Запрос.Выполнить().Выгрузить();
	
	Возврат Выборка;
	
КонецФункции

Функция НовыеПараметрыДополнительныхСведенийЭлектронногоИзвещения0504805() Экспорт
	КодыДополнительныхКоманд = Новый Массив;

	Результат = Новый Структура;
	Результат.Вставить("Ссылка", Метаданные.ОпределяемыеТипы.ОснованияЭлектронныхДокументовЭДОБГУ.Тип);
	Результат.Вставить("Организация", Справочники.Организации.ПустаяСсылка());
	Результат.Вставить("ДатаСведений", Дата(1,1,1));
	Результат.Вставить("КодыДополнительныхКоманд", КодыДополнительныхКоманд);
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьТекстПроДопСведенияДляЭлектронногоИзвещенияПоФорме0504805(Форма, ТекстСведений)  Экспорт
	КоличествоФайлов = 0;
	ТекстНадписиДопСведенияЭлектронногоИзвещения = НСтр("ru='<не указаны>'");
	
	Если ЗначениеЗаполнено(ТекстСведений) Тогда
		ТекстНадписиДопСведенияЭлектронногоИзвещения = ТекстСведений;
	Иначе
		ДокументПередачи = Форма["Объект"].Ссылка;
		ТаблицаФайлов = ДанныеФайловПрисоединенныхКДокументуИзвещения(ДокументПередачи);
		КоличествоФайлов = ТаблицаФайлов.Количество();
			
		Если КоличествоФайлов > 0 Тогда
			Если КоличествоФайлов = 1 Тогда
				ТекстНадписиДопСведенияЭлектронногоИзвещения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru='Приложен %1 файл'"), КоличествоФайлов);
			ИначеЕсли (КоличествоФайлов > 1) И (КоличествоФайлов < 5) Тогда
				ТекстНадписиДопСведенияЭлектронногоИзвещения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru='Приложено %1 файла'"), КоличествоФайлов);
