Функция АдресИзДереваДанныхПоТипу(ДеревоДанных, НачалоПутиАдреса, ТипАдресаПоставщика)
	Результат  = "";
	
	Если ТипАдресаПоставщика = "АдресРФ" Тогда
		Индекс = ЗначениеРеквизитаВДереве(ДеревоДанных, НачалоПутиАдреса + ".АдресРФ.Индекс");
		КодРегиона = ЗначениеРеквизитаВДереве(ДеревоДанных, НачалоПутиАдреса + ".АдресРФ.КодРегиона");
		Регион = ?(КодРегиона = Неопределено, "", РегламентированнаяОтчетностьВызовСервера.ПолучитьНазваниеРегионаПоКоду(КодРегиона));
		Район = ЗначениеРеквизитаВДереве(ДеревоДанных, НачалоПутиАдреса + ".АдресРФ.Район");	
		Город = ЗначениеРеквизитаВДереве(ДеревоДанных, НачалоПутиАдреса + ".АдресРФ.Город");	
		НаселенныйПункт = ЗначениеРеквизитаВДереве(ДеревоДанных, НачалоПутиАдреса + ".АдресРФ.НаселенныйПункт");	
		Улица = ЗначениеРеквизитаВДереве(ДеревоДанных, НачалоПутиАдреса + ".АдресРФ.Улица");	
		Дом = ЗначениеРеквизитаВДереве(ДеревоДанных, НачалоПутиАдреса + ".АдресРФ.Дом");	
		Корпус = ЗначениеРеквизитаВДереве(ДеревоДанных, НачалоПутиАдреса + ".АдресРФ.Корпус");	
		Квартира = ЗначениеРеквизитаВДереве(ДеревоДанных, НачалоПутиАдреса + ".АдресРФ.Квартира");
		
		Если ЗначениеЗаполнено(Индекс) Тогда
			Результат = Результат + Индекс + ", ";
		КонецЕсли;	
		Если ЗначениеЗаполнено(Регион) Тогда
			Результат = Результат + Регион + ", ";
		КонецЕсли;	
		Если ЗначениеЗаполнено(Район) Тогда
			Результат = Результат + Район + ", ";
		КонецЕсли;	
		Если ЗначениеЗаполнено(Город) Тогда
			Результат = Результат + Город + ", ";
		КонецЕсли;	
		Если ЗначениеЗаполнено(НаселенныйПункт) Тогда
			Результат = Результат + НаселенныйПункт + ", ";
		КонецЕсли;	
		Если ЗначениеЗаполнено(Улица) Тогда
			Результат = Результат + Улица + ", ";
		КонецЕсли;	
		Если ЗначениеЗаполнено(Дом) Тогда
			Результат = Результат + Дом + ", ";
		КонецЕсли;	
		Если ЗначениеЗаполнено(Корпус) Тогда
			Результат = Результат + Корпус + ", ";
		КонецЕсли;	
		Если ЗначениеЗаполнено(Квартира) Тогда
			Результат = Результат + Квартира + ", ";
		КонецЕсли;	
		
		Если Сред(Результат, СтрДлина(Результат)-1) = ", " Тогда
			Результат = Сред(Результат, 1, СтрДлина(Результат)-2);
		КонецЕсли;	
	ИначеЕсли ТипАдресаПоставщика = "АдресИнформация" Тогда
		Результат = ЗначениеРеквизитаВДереве(ДеревоДанных, НачалоПутиАдреса + ".АдресИнформация.АдресТекст");	
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

Процедура ДозаполнитьСторноИсправительногоСчетаФактурыПолученного(ТаблицаТоваровРаботУслуг, СчетФактураПолученный, ИсправлениеСФ)
	Если (ИсправлениеСФ = "СФ") И ЗначениеЗаполнено(СчетФактураПолученный) Тогда
		ТаблицаТоваровИзДокументаСчетаФактуры = ТаблицаТоваровИзДокументаСчетаФактуры(СчетФактураПолученный);	
		
		Для каждого ТекСтрока Из ТаблицаТоваровРаботУслуг Цикл
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("НФАДоИзменения", ТекСтрока.НФА);
			ТипНФА = 0;
			Если ТипЗнч(ТекСтрока.НФА) = Тип("СправочникСсылка.Номенклатура") Тогда
				ТипНФА = 2;
			ИначеЕсли ТипЗнч(ТекСтрока.НФА) = Тип("СправочникСсылка.ОсновныеСредства") Тогда	
				ТипНФА = 1;
			КонецЕсли;	
			ПараметрыОтбора.Вставить("ТипНФА", ТипНФА);
			НайденныеСтроки = ТаблицаТоваровИзДокументаСчетаФактуры.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество()>0 Тогда
				ЗаполнитьЗначенияСвойств(ТекСтрока, НайденныеСтроки[0]);
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;
КонецПроцедуры	

Функция ТаблицаТоваровИзДокументаСчетаФактуры(СчетФактураПолученный)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СчетФактураПолученныйСоставНФА.НФА КАК НФАДоИзменения,
	               |	СчетФактураПолученныйСоставНФА.ЕдиницаИзмерения КАК ЕдиницаИзмеренияДоИзменения,
	               |	СчетФактураПолученныйСоставНФА.Количество КАК КоличествоДоИзменения,
	               |	СчетФактураПолученныйСоставНФА.Сумма КАК СуммаДоИзменения,
	               |	СчетФактураПолученныйСоставНФА.СтавкаНДС КАК СтавкаНДСДоИзменения,
	               |	СчетФактураПолученныйСоставНФА.СуммаНДС КАК СуммаНДСДоИзменения,
	               |	СчетФактураПолученныйСоставНФА.Всего КАК ВсегоДоИзменения,
	               |	СчетФактураПолученныйСоставНФА.КПСВычетКт КАК КПСВычетКт,
	               |	СчетФактураПолученныйСоставНФА.КФО КАК КФО,
	               |	СчетФактураПолученныйСоставНФА.Счет30304 КАК Счет30304,
	               |	СчетФактураПолученныйСоставНФА.ДокументОснование КАК ДокументОснование,
	               |	СчетФактураПолученныйСоставНФА.СчетВычетКт КАК СчетВычетКт,
	               |	ВЫБОР
	               |		КОГДА ТИПЗНАЧЕНИЯ(СчетФактураПолученныйСоставНФА.НФА) = &ТипНоменклатура
	               |			ТОГДА 2
	               |		ИНАЧЕ ВЫБОР
	               |				КОГДА ТИПЗНАЧЕНИЯ(СчетФактураПолученныйСоставНФА.НФА) = &ТипОС
	               |					ТОГДА 1
	               |				ИНАЧЕ 0
	               |			КОНЕЦ
	               |	КОНЕЦ КАК ТипНФА
	               |ИЗ
	               |	Документ.СчетФактураПолученный.СоставНФА КАК СчетФактураПолученныйСоставНФА
	               |ГДЕ
	               |	СчетФактураПолученныйСоставНФА.Ссылка = &Ссылка
	               |	И СчетФактураПолученныйСоставНФА.Ссылка.ПометкаУдаления = ЛОЖЬ
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ИсправительныйСчетФактураПолученныйСоставНФА.НФА,
	               |	ИсправительныйСчетФактураПолученныйСоставНФА.ЕдиницаИзмерения,
	               |	ИсправительныйСчетФактураПолученныйСоставНФА.Количество,
	               |	ИсправительныйСчетФактураПолученныйСоставНФА.Сумма,
	               |	ИсправительныйСчетФактураПолученныйСоставНФА.СтавкаНДС,
	               |	ИсправительныйСчетФактураПолученныйСоставНФА.СуммаНДС,
	               |	ИсправительныйСчетФактураПолученныйСоставНФА.Всего,
	               |	ИсправительныйСчетФактураПолученныйСоставНФА.КПСВычетКт,
	               |	ИсправительныйСчетФактураПолученныйСоставНФА.КФО,
	               |	ИсправительныйСчетФактураПолученныйСоставНФА.Счет30304,
	               |	ЕСТЬNULL(ИсправительныйСчетФактураПолученныйСоставНФА.ДокументОснование, """"),
	               |	ИсправительныйСчетФактураПолученныйСоставНФА.СчетВычетКт,
	               |	ВЫБОР
	               |		КОГДА ТИПЗНАЧЕНИЯ(ИсправительныйСчетФактураПолученныйСоставНФА.НФА) = &ТипНоменклатура
	               |			ТОГДА 2
	               |		ИНАЧЕ ВЫБОР
	               |				КОГДА ТИПЗНАЧЕНИЯ(ИсправительныйСчетФактураПолученныйСоставНФА.НФА) = &ТипОС
	               |					ТОГДА 1
	               |				ИНАЧЕ 0
	               |			КОНЕЦ
	               |	КОНЕЦ
	               |ИЗ
	               |	Документ.ИсправительныйСчетФактураПолученный.СоставНФА КАК ИсправительныйСчетФактураПолученныйСоставНФА
	               |ГДЕ
	               |	ИсправительныйСчетФактураПолученныйСоставНФА.Ссылка = &Ссылка
	               |	И ИсправительныйСчетФактураПолученныйСоставНФА.Ссылка.ПометкаУдаления = ЛОЖЬ
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	КорректировочныйСчетФактураПолученныйСоставНФА.НФА,
	               |	КорректировочныйСчетФактураПолученныйСоставНФА.ЕдиницаИзмерения,
	               |	КорректировочныйСчетФактураПолученныйСоставНФА.Количество,
	               |	КорректировочныйСчетФактураПолученныйСоставНФА.Сумма,
	               |	КорректировочныйСчетФактураПолученныйСоставНФА.СтавкаНДС,
	               |	КорректировочныйСчетФактураПолученныйСоставНФА.СуммаНДС,
	               |	КорректировочныйСчетФактураПолученныйСоставНФА.Всего,
	               |	КорректировочныйСчетФактураПолученныйСоставНФА.КПСВычетКт,
	               |	КорректировочныйСчетФактураПолученныйСоставНФА.КФО,
	               |	КорректировочныйСчетФактураПолученныйСоставНФА.Счет30304,
	               |	ЕСТЬNULL(КорректировочныйСчетФактураПолученныйСоставНФА.ДокументОснование, """"),
	               |	КорректировочныйСчетФактураПолученныйСоставНФА.СчетВычетКт,
	               |	ВЫБОР
	               |		КОГДА ТИПЗНАЧЕНИЯ(КорректировочныйСчетФактураПолученныйСоставНФА.НФА) = &ТипНоменклатура
	               |			ТОГДА 2
	               |		ИНАЧЕ ВЫБОР
	               |				КОГДА ТИПЗНАЧЕНИЯ(КорректировочныйСчетФактураПолученныйСоставНФА.НФА) = &ТипОС
	               |					ТОГДА 1
	               |				ИНАЧЕ 0
	               |			КОНЕЦ
	               |	КОНЕЦ
	               |ИЗ
	               |	Документ.КорректировочныйСчетФактураПолученный.СоставНФА КАК КорректировочныйСчетФактураПолученныйСоставНФА
	               |ГДЕ
	               |	КорректировочныйСчетФактураПолученныйСоставНФА.Ссылка = &Ссылка
	               |	И КорректировочныйСчетФактураПолученныйСоставНФА.Ссылка.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("Ссылка", СчетФактураПолученный);
	Запрос.УстановитьПараметр("ТипНоменклатура", Тип("СправочникСсылка.Номенклатура"));
	Запрос.УстановитьПараметр("ТипОС", Тип("СправочникСсылка.ОсновныеСредства"));
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции	

Функция ИдентификаторГосКонтрактаГОЗ(Договор)
	Результат = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ЕСТЬNULL(ВЫРАЗИТЬ(Договоры.ОтдельныйСчетДляРасчетовПоГОЗ КАК Справочник.ЛицевыеСчета).ГосударственныйКонтрактПоГОЗ.Код, """") КАК ИдентификаторГосКонтрактаГОЗ
	               |ИЗ
	               |	Справочник.Договоры КАК Договоры
	               |ГДЕ
	               |	Договоры.Ссылка = &Договор";
	Запрос.УстановитьПараметр("Договор", Договор);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат = Выборка.ИдентификаторГосКонтрактаГОЗ;
	КонецЦикла;	
	
	Возврат Результат; 
КонецФункции

#Область АктОРасхождениях

Функция НайтиАктОРасхожденияхПоОснованию(Знач ДокументОснование, Знач СсылкаНаАкт = Неопределено) Экспорт
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	АктОРасхождениях.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.АктОРасхождениях КАК АктОРасхождениях
	               |ГДЕ
	               |	АктОРасхождениях.ДокументОснование = &ДокументОснование
	               |	И НЕ АктОРасхождениях.Ссылка В (&СсылкаНаАкт)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	АктОРасхождениях.Дата УБЫВ";
	
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	Запрос.УстановитьПараметр("СсылкаНаАкт", СсылкаНаАкт);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьДанныеАктОРасхождениях_ДополнительныеСведения(Знач Основание, Данные, Отказ) Экспорт
	
	СтруктураДанных = Документы[Основание.Метаданные().Имя].ПолучитьДанныеДляЭД(Основание);
		
	ВыборкаШапка = СтруктураДанных.ВыборкаШапка;
	ВыборкаШапка.Следующий();
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(Данные, "ФормированиеДополнительныхСведений", ВыборкаШапка.ФормированиеДополнительныхСведений); 
	
	ТекстОшибки = "";
	Если Не ЗначениеЗаполнено(ВыборкаШапка.СодержаниеДополнительныхСведений) Тогда
		ТекстОшибки = НСтр("ru = 'Содержание итогов приемки: значение не заполнено'");
	КонецЕсли;
	
	ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			ВыборкаШапка.Ссылка, "Объект.СодержаниеДополнительныхСведений",,,,ТекстОшибки);
			
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(Данные, "СодержаниеДополнительныхСведений", 
		ВыборкаШапка.СодержаниеДополнительныхСведений, ПараметрыОбработкиОшибок);
	
	РеквизитыОбъекта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Основание, "Организация, Организация.НаименованиеПолное");
	
	Если ЗначениеЗаполнено(РеквизитыОбъекта.Организация) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			Данные, "СоставительДокументаНаименование", РеквизитыОбъекта.ОрганизацияНаименованиеПолное);
	Иначе
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Заполните поле ""Организация"" в документе %1'"), Основание);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Основание, "Организация",, Отказ); 
	КонецЕсли;
	
КонецПроцедуры

Функция СписокЗначенийВариантовФормированияДополнительныхСведений() Экспорт

	Результат = Новый СписокЗначений;
	Результат.Добавить("1", НСтр("ru = '1. К документу дополнительные сведения не формируются'"));
	Результат.Добавить("2", НСтр("ru = '2. К документу формируются дополнительные сведения об оприходовании ценностей покупателем (в том числе на склад), подписанные ответственным лицом покупателя (уполномоченным покупателем лицом)'"));
	Результат.Добавить("3", НСтр("ru = '3. К документу формируются дополнительные сведения о его утверждении, подписанные ответственным лицом покупателя (уполномоченным покупателем лицом)'"));
	Результат.Добавить("4", НСтр("ru = '4. К документу формируются иные дополнительные сведения, подписанные ответственным лицом покупателя (уполномоченным покупателем лицом)'"));  
	Результат.Добавить("5", НСтр("ru = '5. К документу формируются дополнительные сведения о согласии (несогласии) с результатами приемки, подписанные ответственным лицом со стороны продавца (уполномоченным продавцом лицом)'"));  
	Результат.Добавить("6", НСтр("ru = '6. К документу формируются иные дополнительные сведения, подписанные ответственным лицом со стороны продавца (уполномоченным продавцом лицом)'"));  
	Результат.Добавить("7", НСтр("ru = '7. К документу формируются дополнительные сведения о согласии (несогласии) с результатами приемки, подписанные ответственным лицом со стороны перевозчика (уполномоченным перевозчиком лицом)'"));  
	Результат.Добавить("8", НСтр("ru = '8. К документу формируются иные дополнительные сведения, подписанные ответственным лицом со стороны перевозчика (уполномоченным перевозчиком лицом)'"));  
		
	Возврат Результат;
	
КонецФункции

Функция ОписаниеВариантаФормированияДополнительныхСведений(Вариант) Экспорт
	Результат = "";
	
	Если НЕ ЗначениеЗаполнено(Вариант) Тогда
		Возврат Результат;	
	КонецЕсли;	
	
	СписокВариантов = СписокЗначенийВариантовФормированияДополнительныхСведений();
	
	Результат = СписокВариантов.НайтиПоЗначению(Вариант);
	
	Возврат Результат; 
КонецФункции

#КонецОбласти

#Область НоменклатураКонтрагентов

// Заполняет представление номенклатуры контрагента в источнике, 
// используя полученные из него данные о владельце номенклатуры и ее идентификаторе.
//
// Параметры:
//  Источник - Произвольный - объект (или данные формы), в котором нужно заполнить представление номенклатуры контрагента.
//  ПутьКВладельцу - Строка - путь к свойству источника, содержащему информацию о владельце номенклатуры.
//  ПутьКТаблице - Строка - путь к свойству источника, содержащему таблицу с номенклатурой контрагента.
//  ПутьКИдентификатору - Строка - путь к полю таблицы (ПутьКТаблице), содержащему идентификатор номенклатуры контрагента.
//  ПутьКПредставлению - Строка - путь к полю таблицы (ПутьКТаблице), в которое нужно поместить представление номенклатуры контрагента.
//
// Пример:
//  ОбменСКонтрагентамиКЭДО.ЗаполнитьПредставлениеНоменклатурыКонтрагентовВИсточнике(
//		Объект, "Контрагент", "Товары", "ИдентификаторПоставщика", "НаименованиеПоставщика");
//
Процедура ЗаполнитьПредставлениеНоменклатурыКонтрагентовВИсточнике(Источник, ПутьКВладельцу, ПутьКТаблице, ПутьКИдентификатору, ПутьКПредставлению) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	Если Источник[ПутьКТаблице].Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	НаборНоменклатурыКонтрагентов = Новый Массив;
	Для Каждого СтрокаТаблицы Из Источник[ПутьКТаблице] Цикл
		
		НоменклатураКонтрагента = СопоставлениеНоменклатурыКонтрагентовКлиентСервер.НоваяНоменклатураКонтрагента(
			Источник[ПутьКВладельцу], СтрокаТаблицы[ПутьКИдентификатору]);
			
		НаборНоменклатурыКонтрагентов.Добавить(НоменклатураКонтрагента);
		
	КонецЦикла;
	
	Отбор = Новый Структура("НоменклатураКонтрагента", НаборНоменклатурыКонтрагентов);
	Сопоставление = СопоставлениеНоменклатурыКонтрагентов.НайтиСоответствиеНоменклатуры(Отбор);
	
	Для Каждого СтрокаТаблицы Из Источник[ПутьКТаблице] Цикл
		
		Для Каждого Элемент Из Сопоставление Цикл
			
			Если СтрокаТаблицы[ПутьКИдентификатору] <> Элемент.НоменклатураКонтрагента.Идентификатор Тогда
				Продолжить;
			КонецЕсли;
			
			Представление = ПредставлениеНоменклатурыКонтрагента(Элемент.НоменклатураКонтрагента);
			СтрокаТаблицы[ПутьКПредставлению] = Представление;
			Прервать;
			
		КонецЦикла;
		
		Если ЗначениеЗаполнено(СтрокаТаблицы[ПутьКИдентификатору]) И Не ЗначениеЗаполнено(СтрокаТаблицы[ПутьКПредставлению]) Тогда
			СтрокаТаблицы[ПутьКПредставлению] = СтрокаТаблицы[ПутьКИдентификатору];
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Возвращает представление номенклатуры контрагента.
//
// Параметры:
//  НоменклатураКонтрагента - Структура - номенклатура контрагента. См. СопоставлениеНоменклатурыКонтрагентовКлиентСервер
//
// Возвращаемое значение:
//  Строка - представление номенклатуры контрагента.
//
Функция ПредставлениеНоменклатурыКонтрагента(НоменклатураКонтрагента) Экспорт
	
	Представление = НоменклатураКонтрагента.Наименование;
	Если ЗначениеЗаполнено(НоменклатураКонтрагента.Характеристика) Тогда
		Представление = Представление + ", " + НоменклатураКонтрагента.Характеристика;
	КонецЕсли;
	Если ЗначениеЗаполнено(НоменклатураКонтрагента.ЕдиницаИзмерения) Тогда
		Представление = Представление + ", " + НоменклатураКонтрагента.ЕдиницаИзмерения;
	КонецЕсли;
	
	Возврат Представление;
	
КонецФункции

// Заполняет идентификатор и представление номенклатуры контрагента в строке источника,
// используя полученные из нее данные о номенклатуре информационной базы.
//
// Параметры:
//  Источник - Произвольный - объект (или данные формы), которому принадлежит заполняемая строка таблицы.
//  СтрокаИсточника - Произвольный - строка таблицы (ДанныеФормыЭлементКоллекции), в котором нужно заполнить данные номенклатуры контрагента.
//  ПутьКВладельцу - Строка - путь к свойству источника, содержащему информацию о владельце номенклатуры.
//  ПутьКИдентификатору - Строка - путь к полю строки (СтрокаИсточника), в которое нужно поместить идентификатор номенклатуры контрагента.
//  ПутьКПредставлению - Строка - путь к полю строки (СтрокаИсточника), в которое нужно поместить представление номенклатуры контрагента.
//
// Пример:
//  ОбменСКонтрагентамиКЭДО.ЗаполнитьИдентификаторКонтрагентаВСтрокеИсточника(
//		Объект, СтрокаТовара, "Контрагент", "ИдентификаторПоставщика", "НаименованиеПоставщика");
//
Процедура ЗаполнитьИдентификаторКонтрагентаВСтрокеИсточника(Источник, СтрокаИсточника, ПутьКВладельцу, ПутьКИдентификатору, ПутьКПредставлению) Экспорт
	
	НоменклатураИБ = СопоставлениеНоменклатурыКонтрагентовКлиентСервер.НоваяНоменклатураИнформационнойБазы(
		СтрокаИсточника.Номенклатура, , СтрокаИсточника.ЕдиницаИзмерения);
		
	Отбор = Новый Структура("Владелец,НоменклатураИБ", Источник[ПутьКВладельцу], НоменклатураИБ);
	Сопоставление = СопоставлениеНоменклатурыКонтрагентов.НайтиСоответствиеНоменклатуры(Отбор);
	
	Если Сопоставление.Количество() = 1 Тогда
		Элемент = Сопоставление[0];
		СтрокаИсточника[ПутьКИдентификатору] = Элемент.НоменклатураКонтрагента.Идентификатор;
		Представление = ПредставлениеНоменклатурыКонтрагента(Элемент.НоменклатураКонтрагента);
		СтрокаИсточника[ПутьКПредставлению] = Представление;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

// Кэширует значения колонок "НомерСтроки, НаименованиеПоставщика" из коллекции данных.
//
// Параметры:
//  КоллекцияДанных - ДанныеФормыКоллекция - Таблица, из которой кэшируются значения колонок.
//  Кэш - Структура - объект, в котором кэшируются данные.
//
Процедура КэшироватьНаименованиеНоменклатурыПоставщика(КоллекцияДанных, Кэш) Экспорт
	
	ДанныеКэша = КоллекцияДанных.Выгрузить(,"НомерСтроки, НаименованиеПоставщика");
	Кэш.Вставить("НаименованиеНоменклатурыПоставщика", ДанныеКэша);
	
КонецПроцедуры

// Восстанавливает из кэша значения колонок "НомерСтроки, НаименованиеПоставщика" в коллекцию данных.
//
// Параметры:
//  КоллекцияДанных - ДанныеФормыКоллекция - Таблица, из которой кэшируются значения колонок.
//  Кэш - Структура - объект, в котором кэшируются данные.
//
Процедура ВосстановитьНаименованиеНоменклатурыПоставщика(КоллекцияДанных, Кэш) Экспорт
	
	ДанныеКэша = Неопределено;
	Если Кэш.Свойство("НаименованиеНоменклатурыПоставщика", ДанныеКэша) Тогда
		Для Каждого СтрокаКоллекции Из КоллекцияДанных Цикл
			СтрокаКоллекции.НаименованиеПоставщика = ДанныеКэша[СтрокаКоллекции.НомерСтроки - 1].НаименованиеПоставщика;
		КонецЦикла;
		Кэш.Удалить("НаименованиеНоменклатурыПоставщика");
	КонецЕсли;
	
КонецПроцедуры

// Получает реквизиты номенклатуры и значение признака "ХарактеристикиИспользуются".
//
// Параметры:
//  СсылкаНаОбъект - СправочникСсылка.Номенклатура - объект, значения реквизитов которого необходимо получить.
//  Реквизиты - Строка - имена реквизитов, перечисленные через запятую.
//
// Возвращаемое значение:
//  Структура - содержит имена (ключи) и значения затребованных реквизитов.
//     Если используются характеристики, то дополнительно содержит
//     значение признака "ХарактеристикиИспользуются".
//
Функция РеквизитыНоменклатурыПриИзменении(СсылкаНаОбъект, Знач Реквизиты = "") Экспорт
	
	Результат = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОбъект, Реквизиты);
	
	Возврат Результат;
	
КонецФункции

// Заполняет дополнительные свойства объекта для анализа в событиях подсистемы ЭлектронноеВзаимодействие.
// Вызывать только из события ПередЗаписью модуля объекта (не из подписок).
//
// Параметры:
//  Источник - ДокументОбъект, СправочникОбъект - записываемый объект.
//  Отказ - булево - признак отказа от записи.
//  РежимЗаписи - РежимЗаписиДокумента - текущий режим записи документа (для документов).
//              - Неопределено - если Источник не является документом.
//  РежимПроведения - РежимПроведенияДокумента  - текущий режим проведения (для документов).
//                  - Неопределено - если Источник не является документом.
//
Процедура ПередЗаписьюОснованияЭлектронногоДокумента(Источник, Отказ, РежимЗаписи = Неопределено, РежимПроведения = Неопределено) Экспорт
	
	МетаданныеОбъекта = Источник.Метаданные();
	
	Если ОбщегоНазначения.ЭтоДокумент(МетаданныеОбъекта) Тогда
		
		Если МетаданныеОбъекта.Проведение = Метаданные.СвойстваОбъектов.Проведение.Разрешить Тогда
			
			ДокументПроведен = (РежимЗаписи = РежимЗаписиДокумента.Проведение)
				ИЛИ (РежимЗаписи = РежимЗаписиДокумента.Запись И Источник.Проведен);
				
			Источник.ДополнительныеСвойства.Вставить("ДокументПроведен", ДокументПроведен);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Функция СписокАдресовУчастников(Организация, Участники, НаименованияУчастников = Неопределено) Экспорт
	СписокАдресов = Новый СписокЗначений;
	ФактическийАдресОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Организация,
														Справочники.ВидыКонтактнойИнформации.ФактАдресОрганизации);
														
	Если НЕ ЗначениеЗаполнено(ФактическийАдресОрганизации) Тогда 													
		ФактическийАдресОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Организация,
														Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);
	КонецЕсли;
													
	СписокАдресов.Добавить(НСтр("ru='Организация (факт. адрес): '")+АдресБезИндекса(ФактическийАдресОрганизации));
	
	сч = 0;
	Для Каждого ТекСтрока Из Участники Цикл
		сч = сч + 1;
		Если ЗначениеЗаполнено(ТекСтрока) Тогда
			ФактическийАдресУчастника = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ТекСтрока.ЮридическоеФизическоеЛицо,
				Справочники.ВидыКонтактнойИнформации.ФактическийАдресКонтрагенты);
			
			Если ЗначениеЗаполнено(ФактическийАдресУчастника) Тогда
				АдресБезИндекса = АдресБезИндекса(ФактическийАдресУчастника);
				Если НаименованияУчастников<>Неопределено Тогда
					АдресБезИндекса = НаименованияУчастников[сч]+НСтр("ru=' (факт. адрес): '")+АдресБезИндекса;
				КонецЕсли;	
				СписокАдресов.Добавить(АдресБезИндекса);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
	
	Возврат СписокАдресов; 
КонецФункции

Функция АдресБезИндекса(Адрес)
	СтрокаАдреса = СокрЛП(Адрес);
	Результат = СтрокаАдреса;
	Если СтрДлина(СтрокаАдреса)>6 Тогда
		Если (КодСимвола(СтрокаАдреса, 1) > 47)И(КодСимвола(СтрокаАдреса, 1) < 58) И			
			 (КодСимвола(СтрокаАдреса, 2) > 47)И(КодСимвола(СтрокаАдреса, 2) < 58) И
			 (КодСимвола(СтрокаАдреса, 3) > 47)И(КодСимвола(СтрокаАдреса, 3) < 58) И
			 (КодСимвола(СтрокаАдреса, 4) > 47)И(КодСимвола(СтрокаАдреса, 4) < 58) И
			 (КодСимвола(СтрокаАдреса, 5) > 47)И(КодСимвола(СтрокаАдреса, 5) < 58) И
			 (КодСимвола(СтрокаАдреса, 6) > 47)И(КодСимвола(СтрокаАдреса, 6) < 58) Тогда
			Результат = СокрЛП(Сред(СтрокаАдреса, 8));
		КонецЕсли;	
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

// См. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьДанныеДляАктОРасхождениях.
Процедура ЗаполнитьДанныеДляАктОРасхождениях(Знач СсылкаНаОбъект, Знач СтруктураЭД, ДеревоДанных, Отказ) Экспорт
	
	НетЗамечанийКДокументу = Документы["АктОРасхождениях"].ПредварительныйКонтрольДанныхДляЭД(СсылкаНаОбъект);
	
	Если НЕ НетЗамечанийКДокументу Тогда
		ОписаниеОшибки = НСтр("ru='Вышеуказанные ошибки препятствуют формированию электронного документа.
		|По этой причине и прочие данные документа не будут выгружены в ЭД.
		|После заполнения указанных реквизитов повторите попытку формирования электронного документа.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки);
		Отказ = Истина;
		Возврат;
	КонецЕсли;	
	
	ДанныеДляЭД = Документы[СсылкаНаОбъект.Метаданные().Имя].ПодготовитьДанныеДляЭД(СсылкаНаОбъект);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыШапки = ДанныеДляЭД.Шапка[0];
	Товары = ДанныеДляЭД.Товары;
	
	Сертификаты = ДанныеДляЭД.Сертификаты;
	ТранспортныеДокументы = ДанныеДляЭД.ТранспортныеДокументы;
	ПрилагаемыеДокументы = ДанныеДляЭД.ПрилагаемыеДокументы;
	
	КодыМаркировкиПоДокументам = ДанныеДляЭД.КодыМаркировкиПоДокументам;
	КодыМаркировкиПоФакту = ДанныеДляЭД.КодыМаркировкиПоФакту;
	КодыМаркировкиБрак = ДанныеДляЭД.КодыМаркировкиБрак;
	КодыМаркировкиБой = ДанныеДляЭД.КодыМаркировкиБой;
	КодыМаркировкиНедостача = ДанныеДляЭД.КодыМаркировкиНедостача;
	КодыМаркировкиИзлишки = ДанныеДляЭД.КодыМаркировкиИзлишки;
	
	ИмяФормы = "Документ.АктОРасхождениях.ФормаОбъекта";
	
	ДатаДанных = РеквизитыШапки.Дата;
	
	// Наименование документа
	НаименованиеДокумента = НСтр("ru = 'Акт об установленном расхождении по количеству и качеству при приемке товарно-материальных ценностей'");
	Если ЗначениеЗаполнено(РеквизитыШапки.НаименованиеЭлектронногоДокумента) Тогда
		НаименованиеДокумента = РеквизитыШапки.НаименованиеЭлектронногоДокумента;
	КонецЕсли;	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НаименованиеДокумента", НаименованиеДокумента);
	
	// Обстоятельства составления.
	ОбстоятельстваСоставления = РеквизитыШапки.ОбстоятельстваСоставленияДокумента;
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
		ДеревоДанных, "ОбстоятельстваСоставленияДокумента", ОбстоятельстваСоставления);
	
	// Обстоятельства использования.
	ОбстоятельстваИспользования = РеквизитыШапки.ОбстоятельстваИспользованияДокументаПерваяЧастьКода + РеквизитыШапки.ОбстоятельстваИспользованияДокументаВтораяЧастьКода;
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
		ДеревоДанных, "ОбстоятельстваИспользованияДокумента", ОбстоятельстваИспользования);
		
		
	// Исправление.
	Если ЗначениеЗаполнено(РеквизитыШапки.НомерИсправления) Тогда
		Если ЗначениеЗаполнено(РеквизитыШапки.ИсправляемыйДокумент) Тогда
			// Номер документа.
			НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(СсылкаНаОбъект, "ИсправляемыйДокумент");
			ПараметрыФормы = Новый Структура("Ключ", СсылкаНаОбъект);
			ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
				СсылкаНаОбъект, "Объект.ИсправляемыйДокумент", НавигационнаяСсылка, ИмяФормы, ПараметрыФормы);
				
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
				ДеревоДанных, "НомерДокумента", НомерДляПечати(РеквизитыШапки.ИсправляемыйДокумент, РеквизитыШапки.ИсправляемыйДокумент.Номер), ПараметрыОбработкиОшибок);
				
			// Дата документа.
			НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(СсылкаНаОбъект, "ИсправляемыйДокумент");
			ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
				СсылкаНаОбъект, "Объект.ИсправляемыйДокумент", НавигационнаяСсылка, ИмяФормы, ПараметрыФормы);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
				ДеревоДанных, "ДатаДокумента", РеквизитыШапки.ИсправляемыйДокумент.Дата, ПараметрыОбработкиОшибок);
		КонецЕсли;	
		
		// Номер исправления.
		НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(СсылкаНаОбъект, "НомерИсправления");
		ПараметрыФормы = Новый Структура("Ключ", СсылкаНаОбъект);
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.НомерИсправления", НавигационнаяСсылка, ИмяФормы, ПараметрыФормы);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, "НомерИсправления", РеквизитыШапки.НомерИсправления, ПараметрыОбработкиОшибок);
		// Дата исправления.
		НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(СсылкаНаОбъект, "Дата");
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.Дата", НавигационнаяСсылка, ИмяФормы, ПараметрыФормы);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, "ДатаИсправления", РеквизитыШапки.Дата, ПараметрыОбработкиОшибок);
		// Исправляемый документ.
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, "ИсправляемыйДокумент", РеквизитыШапки.ИсправляемыйДокумент);
	Иначе		
		// Номер документа.
		НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(СсылкаНаОбъект, "Номер");
		ПараметрыФормы = Новый Структура("Ключ", СсылкаНаОбъект);
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.Номер", НавигационнаяСсылка, ИмяФормы, ПараметрыФормы);
			
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, "НомерДокумента", НомерДляПечати(РеквизитыШапки.Ссылка, РеквизитыШапки.Номер), ПараметрыОбработкиОшибок);
			
		// Дата документа.
		НавигационнаяСсылка = ПолучитьНавигационнуюСсылку(СсылкаНаОбъект, "Дата");
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.Дата", НавигационнаяСсылка, ИмяФормы, ПараметрыФормы);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, "ДатаДокумента", РеквизитыШапки.Дата, ПараметрыОбработкиОшибок);
	КонецЕсли;
	
	// Идентификатор гос. контракта.
	Если ЗначениеЗаполнено(РеквизитыШапки.ИдентификаторГосКонтракта) Тогда
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			СсылкаНаОбъект, "Объект.ИдентификаторГосКонтракта");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, "ИдентификаторГосКонтракта", РеквизитыШапки.ИдентификаторГосКонтракта, ПараметрыОбработкиОшибок);
	КонецЕсли;
	
	//Покупатель
	Если ЗначениеЗаполнено(РеквизитыШапки.Организация) Тогда
		ЗаполнитьДанныеУчастникаАктаОРасхождениях(РеквизитыШапки.Организация, "Покупатель", РеквизитыШапки.Дата, ДеревоДанных);
	КонецЕсли;
	
	//Составитель - другой контрагент (например, подведомственное учреждение) или само учреждение
	Если ЗначениеЗаполнено(РеквизитыШапки.Составитель) Тогда
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			РеквизитыШапки.Ссылка, "Объект.Составитель");
		Участник = РеквизитыШапки.Составитель;
	Иначе
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			РеквизитыШапки.Ссылка, "Объект.Организация");
		Участник = РеквизитыШапки.Организация;
	КонецЕсли;	
	СведенияОбУчастнике = Новый Структура;
	ПолучитьДанныеЮрФизЛица(Участник, СведенияОбУчастнике, ДатаДанных, Ложь);
	
	СоставительДокументаНаименование = СведенияОбУчастнике.НаименованиеПолное
		+ ?(ЗначениеЗаполнено(СведенияОбУчастнике.КПП),
		СтрШаблон(НСтр("ru = ', ИНН/КПП %1/%2'"), СведенияОбУчастнике.ИНН, СведенияОбУчастнике.КПП),
		СтрШаблон(НСтр("ru = ', ИНН %1'"), СведенияОбУчастнике.ИНН));
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
		ДеревоДанных, "СоставительДокументаНаименование", СоставительДокументаНаименование, ПараметрыОбработкиОшибок);
			
	Если ЗначениеЗаполнено(РеквизитыШапки.ОснованиеЗаполненияСоставителем) Тогда
		ОснованиеЗаполненияСоставителем = СокрЛП(РеквизитыШапки.ДоверенностьНаименование) + " " + СокрЛП(РеквизитыШапки.ДоверенностьНомер) + " от " + Формат(РеквизитыШапки.ДоверенностьДата, "ДФ=dd.MM.yyyy");
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			РеквизитыШапки.Ссылка, "Объект.ОснованиеЗаполненияСоставителем");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, "СоставительДокументаДоверенность", ОснованиеЗаполненияСоставителем, ПараметрыОбработкиОшибок);
	КонецЕсли;	
	
	// Продавец.
	Участник = Неопределено;
	Если ЗначениеЗаполнено(РеквизитыШапки.Контрагент) Тогда
		Участник = РеквизитыШапки.Контрагент;
		ЗаполнитьДанныеУчастникаАктаОРасхождениях(Участник, "Продавец", ДатаДанных, ДеревоДанных);
	Иначе
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			РеквизитыШапки.Ссылка, "Объект.Контрагент");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, "Продавец", Участник, ПараметрыОбработкиОшибок);
	КонецЕсли;
	
	// Грузоотправитель.
	Участник = Неопределено;
	Если ЗначениеЗаполнено(РеквизитыШапки.Грузоотправитель) Тогда
		Участник = РеквизитыШапки.Грузоотправитель;
		ЗаполнитьДанныеУчастникаАктаОРасхождениях(Участник, "Грузоотправитель", ДатаДанных, ДеревоДанных);
	КонецЕсли;
	
	// Грузополучатель.
	Участник = Неопределено;
	Если ЗначениеЗаполнено(РеквизитыШапки.Грузополучатель) Тогда
		Участник = РеквизитыШапки.Грузополучатель;
		ЗаполнитьДанныеУчастникаАктаОРасхождениях(Участник, "Грузополучатель", ДатаДанных, ДеревоДанных);
	КонецЕсли;
	
	// Страховая компания.
	Участник = Неопределено;
	Если ЗначениеЗаполнено(РеквизитыШапки.СтраховаяКомпания) Тогда
		Участник = РеквизитыШапки.СтраховаяКомпания;
		ЗаполнитьДанныеУчастникаАктаОРасхождениях(Участник, "СтраховаяКомпания", ДатаДанных, ДеревоДанных);
	КонецЕсли;
	
	// Сведения об осмотре груза.
	ОбщийПуть = "СведенияОбОсмотреГруза.";
	Если ЗначениеЗаполнено(РеквизитыШапки.ДатаОсмотраГруза) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, ОбщийПуть + "ДатаОсмотра", РеквизитыШапки.ДатаОсмотраГруза);
	КонецЕсли;
	Если ЗначениеЗаполнено(РеквизитыШапки.МестоСоставления) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, ОбщийПуть + "МестоСоставленияДокумента", РеквизитыШапки.МестоСоставления);
	КонецЕсли;
	Если ЗначениеЗаполнено(РеквизитыШапки.ВремяНачалаПриемки) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, ОбщийПуть + "ВремяПриемкиНачало", РеквизитыШапки.ВремяНачалаПриемки);
	КонецЕсли;
	Если ЗначениеЗаполнено(РеквизитыШапки.ВремяОкончанияПриемки) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, ОбщийПуть + "ВремяПриемкиОкончание", РеквизитыШапки.ВремяОкончанияПриемки);
	КонецЕсли;
	Если ЗначениеЗаполнено(РеквизитыШапки.ДатаОтправленияТоваров) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, ОбщийПуть + "ДатаОтправки", РеквизитыШапки.ДатаОтправленияТоваров);
	КонецЕсли;
	
	//  СертификатыСоответствия.
	ВыборкаСертификатыСоответствия = Сертификаты;
	НаборСертификатов = Новый Массив;
	Для каждого ТекСтрока Из Сертификаты Цикл
		НаборСертификатов.Добавить(ТекСтрока.НомерСертификата);
	КонецЦикла;
	Если ЗначениеЗаполнено(НаборСертификатов) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, ОбщийПуть + "СертификатыСоответствия", НаборСертификатов);
	КонецЕсли;
	
	//  Сопроводительный документ.
	СопроводительныйДокументНаименование = ?(ЗначениеЗаполнено(РеквизитыШапки.СопроводительныйДокументНаименование),
		РеквизитыШапки.СопроводительныйДокументНаименование, "БСД");
	СопроводительныйДокументНомер = ?(ЗначениеЗаполнено(РеквизитыШапки.СопроводительныйДокументНомер),
		РеквизитыШапки.СопроводительныйДокументНомер, "б/н");
	СопроводительныйДокументДата = ?(ЗначениеЗаполнено(РеквизитыШапки.СопроводительныйДокументДата),
		РеквизитыШапки.СопроводительныйДокументДата, "");
	Если ЗначениеЗаполнено(СопроводительныйДокументНаименование) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, ОбщийПуть + "СопроводительныйДокумент.Наименование", СопроводительныйДокументНаименование);
	КонецЕсли;
	Если ЗначениеЗаполнено(СопроводительныйДокументНомер) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, ОбщийПуть + "СопроводительныйДокумент.Номер", СопроводительныйДокументНомер);
	КонецЕсли;
	Если ЗначениеЗаполнено(СопроводительныйДокументДата) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, ОбщийПуть + "СопроводительныйДокумент.Дата", СопроводительныйДокументДата);
	КонецЕсли;
	
	// Сведения по транспортным документам.
	СведенияПоТранспортнымДокументам = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
		ДеревоДанных, "СведенияПоТранспортнымДокументам");
	Для каждого ТекСтрока Из ТранспортныеДокументы Цикл
		НоваяСтрока = СведенияПоТранспортнымДокументам.Добавить();
		НоваяСтрока.ОтметкаОбОпломбировании = ТекСтрока.ОтметкаОбОпломбировании;
		НоваяСтрока.ВидУпаковки = ТекСтрока.ВидУпаковки;
		НоваяСтрока.Количество = ТекСтрока.Количество;
		НоваяСтрока.НаименованиеГруза = ТекСтрока.НаименованиеГруза;
		НоваяСтрока.ЕдиницаИзмеренияКод = ТекСтрока.ЕдиницаИзмеренияКод;
		НоваяСтрока.ЕдиницаИзмеренияНаименование = ТекСтрока.ЕдиницаИзмеренияНаименование;
		НоваяСтрока.МассаОтправленияБрутто = ТекСтрока.МассаОтправленияБрутто;
		НоваяСтрока.МассаОтправленияНетто = ТекСтрока.МассаОтправленияНетто;
		НоваяСтрока.МассаПрибытияБрутто = ТекСтрока.МассаПрибытияБрутто;
		НоваяСтрока.МассаПрибытияНетто = ТекСтрока.МассаПрибытияНетто;
		Если ЗначениеЗаполнено(ТекСтрока.ОтметкиОтправителя) Тогда
			НоваяСтрока.ДополнительныеДанные = Новый Соответствие;
			НоваяСтрока.ДополнительныеДанные.Вставить(НСтр("ru = 'Особые отметки отправителя'"), ТекСтрока.ОтметкиОтправителя);
		КонецЕсли;
	КонецЦикла;
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, СведенияПоТранспортнымДокументам, "СведенияПоТранспортнымДокументам");
	
	// Сведения о времени приемки.
	ОбщийПуть = "СведенияОВремениПриемки.";
	Если ЗначениеЗаполнено(РеквизитыШапки.ДатаПрибытияВПунктНазначения) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, ОбщийПуть + "ДатаПрибытияВПунктНазначения", РеквизитыШапки.ДатаПрибытияВПунктНазначения);
	КонецЕсли;
	Если ЗначениеЗаполнено(РеквизитыШапки.ДатаПрибытияВПунктНазначения) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, ОбщийПуть + "ДатаВыдачиОрганизациейТранспорта", РеквизитыШапки.ДатаВыдачиОрганизациейТранспорта);
	КонецЕсли;
	Если ЗначениеЗаполнено(РеквизитыШапки.ДатаПрибытияВПунктНазначения) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, ОбщийПуть + "ДатаВскрытияТранспортныхСредств", РеквизитыШапки.ДатаВскрытияТранспортныхСредств);
	КонецЕсли;
	Если ЗначениеЗаполнено(РеквизитыШапки.ДатаПрибытияВПунктНазначения) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, ОбщийПуть + "ДатаДоставкиНаСкладПолучателя", РеквизитыШапки.ДатаДоставкиНаСкладПолучателя);
	КонецЕсли;
	
	// Обстоятельства приемки.
	ОбщийПуть = "ОбстоятельстваПриемки.";
	Если ЗначениеЗаполнено(РеквизитыШапки.УсловияХраненияТоваровНаСкладеПолучателя) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, ОбщийПуть + "УсловияХраненияТоваровНаСкладеПолучателя", РеквизитыШапки.УсловияХраненияТоваровНаСкладеПолучателя);
	КонецЕсли;
	Если ЗначениеЗаполнено(РеквизитыШапки.СостояниеТарыУпаковки) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, ОбщийПуть + "СостояниеТарыУпаковки", РеквизитыШапки.СостояниеТарыУпаковки);
	КонецЕсли;
	Если ЗначениеЗаполнено(РеквизитыШапки.ТипОпределенияКоличества) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, ОбщийПуть + "ТипОпределенияКоличества", РеквизитыШапки.ТипОпределенияКоличества);
	КонецЕсли;
	Если ЗначениеЗаполнено(РеквизитыШапки.ДополнительныеСведенияПриемки) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, ОбщийПуть + "ДополнительныеСведения", РеквизитыШапки.ДополнительныеСведенияПриемки);
	КонецЕсли;
	
	//Перевозчик
	Участник = Неопределено;
	Если ЗначениеЗаполнено(РеквизитыШапки.Перевозчик) Тогда
		Участник = РеквизитыШапки.Перевозчик;
		ЗаполнитьДанныеУчастникаАктаОРасхождениях(Участник, ОбщийПуть + "Перевозчик", ДатаДанных, ДеревоДанных);
	КонецЕсли;
	
	//  Транспортный документ.
	ТранспортныйДокументНаименование = ?(ЗначениеЗаполнено(РеквизитыШапки.ТранспортныйДокументНаименование),
		РеквизитыШапки.ТранспортныйДокументНаименование, "БСД");
	ТранспортныйДокументНомер = ?(ЗначениеЗаполнено(РеквизитыШапки.ТранспортныйДокументНомер),
		РеквизитыШапки.ТранспортныйДокументНомер, "б/н");
	ТранспортныйДокументДата = ?(ЗначениеЗаполнено(РеквизитыШапки.ТранспортныйДокументДата),
		РеквизитыШапки.ТранспортныйДокументДата, "");
	Если ЗначениеЗаполнено(ТранспортныйДокументНаименование) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, ОбщийПуть + "ТранспортныйДокумент.Наименование", ТранспортныйДокументНаименование);
	КонецЕсли;
	Если ЗначениеЗаполнено(ТранспортныйДокументНомер) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, ОбщийПуть + "ТранспортныйДокумент.Номер", ТранспортныйДокументНомер);
	КонецЕсли;
	Если ЗначениеЗаполнено(ТранспортныйДокументДата) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, ОбщийПуть + "ТранспортныйДокумент.Дата", ТранспортныйДокументДата);
	КонецЕсли;
	
	//Ответственное за приемку лицо
	ДатаПолученияТоваров = ДатаДанных;
		
	Если РеквизитыШапки.ОтветственныйПринялТоварыВид = 0 Тогда
		ВидЛица = "РаботникОрганизацииПокупателя";
		Сотрудник = РеквизитыШапки.ОтветственныйПринялТовары;
		
		ДанныеСотрудника = Новый Структура("Фамилия, Имя, Отчество, Должность");
		ДанныеСотрудника.Вставить("СсылкаНаОбъект",	Сотрудник);
		ДанныеСотрудника.Вставить("Период",			ДатаПолученияТоваров);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		
		Если НЕ ЗначениеЗаполнено(РеквизитыШапки.ОтветственныйПринялТовары) Тогда
			Отказ = Истина;
			
			ТекстСообщения  = НСтр("ru='В документе %АктОРасхождениях% на закладке ""Приемка"" не заполнен реквизит ""Ответственное лицо""!'");
			ТекстСообщения  = СтрЗаменить(ТекстСообщения,"%АктОРасхождениях%", РеквизитыШапки.Ссылка);
			Сообщение       = Новый СообщениеПользователю();
			Сообщение.Текст = ТекстСообщения;
			Сообщение.Сообщить();
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ДанныеСотрудника.Должность) Тогда
			Отказ = Истина;
			
			ТекстСообщения  = НСтр("ru='В документе %АктОРасхождениях% на закладке ""Приемка"" не указаны необходимы данные (должность) для ответственного за приемку лица!'");
			ТекстСообщения  = СтрЗаменить(ТекстСообщения,"%АктОРасхождениях%", РеквизитыШапки.Ссылка);
			Сообщение       = Новый СообщениеПользователю();
			Сообщение.Текст = ТекстСообщения;
			Сообщение.Сообщить();
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(РеквизитыШапки.ОтветственныйПринялТоварыОснованиеПолномочий) Тогда
			Отказ = Истина;
			
			ТекстСообщения  = НСтр("ru='В документе %АктОРасхождениях% на закладке ""Приемка"" не указаны необходимы данные (основания полномочий) для ответственного за приемку лица!'");
			ТекстСообщения  = СтрЗаменить(ТекстСообщения,"%АктОРасхождениях%", РеквизитыШапки.Ссылка);
			Сообщение       = Новый СообщениеПользователю();
			Сообщение.Текст = ТекстСообщения;
			Сообщение.Сообщить();
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ДанныеСотрудника.Фамилия) Тогда
			Отказ = Истина;
			
			ТекстСообщения  = НСтр("ru='В документе %АктОРасхождениях% на закладке ""Приемка"" не указаны необходимы данные (фамилия) для ответственного за приемку лица!'");
			ТекстСообщения  = СтрЗаменить(ТекстСообщения,"%АктОРасхождениях%", РеквизитыШапки.Ссылка);
			Сообщение       = Новый СообщениеПользователю();
			Сообщение.Текст = ТекстСообщения;
			Сообщение.Сообщить();
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ДанныеСотрудника.Имя) Тогда
			Отказ = Истина;
			
			ТекстСообщения  = НСтр("ru='В документе %АктОРасхождениях% на закладке ""Приемка"" не указаны необходимы данные (имя) для ответственного за приемку лица!'");
			ТекстСообщения  = СтрЗаменить(ТекстСообщения,"%АктОРасхождениях%", РеквизитыШапки.Ссылка);
			Сообщение       = Новый СообщениеПользователю();
			Сообщение.Текст = ТекстСообщения;
			Сообщение.Сообщить();
		КонецЕсли;
		
