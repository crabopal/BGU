Функция КонтрагентПоДаннымУчастника(ДанныеУчастника, ВызватьИсключениеПриОшибке = Ложь)
	
	Перем ИНН, КПП, Контрагент, ОписаниеОшибки;
	
	ТипУчастника = ДанныеУчастника.ТипУчастника;
	
	Если ТипУчастника.Свойство("ЮЛ") Тогда
		ИНН = ТипУчастника.ЮЛ.ИНН;
		КПП = ТипУчастника.ЮЛ.КПП;
		Запрос = Новый Запрос();
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	Контрагенты.Ссылка
			|ИЗ
			|	Справочник.Контрагенты КАК Контрагенты
			|ГДЕ
			|	Контрагенты.ИНН = &ИНН
			|	И Контрагенты.КПП = &КПП
			|	И НЕ Контрагенты.ПометкаУдаления";
		Запрос.УстановитьПараметр("ИНН", ИНН);
		Запрос.УстановитьПараметр("КПП", КПП);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Контрагент = Выборка.Ссылка;
		КонецЕсли;
		
		ОписаниеОшибки = СтрШаблон(НСтр("ru = 'контрагент с ИНН/КПП %1/%2 не найден'"), ИНН, КПП);
		
	ИначеЕсли ТипУчастника.Свойство("ИП") Тогда
		ИНН = ТипУчастника.ИП.ИНН;
		Запрос = Новый Запрос();
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	Контрагенты.Ссылка
			|ИЗ
			|	Справочник.Контрагенты КАК Контрагенты
			|ГДЕ
			|	Контрагенты.ИНН = &ИНН
			|	И НЕ Контрагенты.ПометкаУдаления";
		Запрос.УстановитьПараметр("ИНН", ИНН);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Контрагент = Выборка.Ссылка;
		КонецЕсли;
		
		ОписаниеОшибки = СтрШаблон(НСтр("ru = 'контрагент с ИНН %1 не найден'"), ИНН);
		
	ИначеЕсли ТипУчастника.Свойство("ИЛ") Тогда
		НаименованиеПолное = ТипУчастника.ИЛ.НаименованиеОрганизации;
		Если ЗначениеЗаполнено(НаименованиеПолное) Тогда
			Запрос = Новый Запрос();
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
				|	Контрагенты.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.Контрагенты КАК Контрагенты
				|ГДЕ
				|	Контрагенты.НаименованиеСокращенное = &НаименованиеПолное
				|	И НЕ Контрагенты.ПометкаУдаления";
			Запрос.УстановитьПараметр("НаименованиеПолное", НаименованиеПолное);
			
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Контрагент = Выборка.Ссылка;
			КонецЕсли;
		КонецЕсли;
		
		ОписаниеОшибки = СтрШаблон(НСтр("ru = 'контрагент с наименованием ""%1"" не найден'"), НаименованиеПолное);
		
	ИначеЕсли ТипУчастника.Свойство("ФЛ") Тогда
		ИНН = ТипУчастника.ФЛ.ИНН;
		
		ФИО = ТипУчастника.ФЛ.ФИО;
		
		Фамилия  = ФИО.Фамилия;
		Имя      = ФИО.Имя;
		Отчество = ФИО.Отчество;
		
		ЭлементыИмени = Новый Массив;
		Если ЗначениеЗаполнено(Фамилия) Тогда
			ЭлементыИмени.Добавить(Фамилия);
		КонецЕсли;
		Если ЗначениеЗаполнено(Имя) Тогда
			ЭлементыИмени.Добавить(Имя);
		КонецЕсли;
		Если ЗначениеЗаполнено(Отчество) Тогда
			ЭлементыИмени.Добавить(Отчество);
		КонецЕсли;
		ПолноеНаименование = СтрСоединить(ЭлементыИмени, " ");
		
		Если ЗначениеЗаполнено(ИНН) Или ЗначениеЗаполнено(НаименованиеПолное) Тогда 
			Запрос = Новый Запрос();
			Запрос.Текст = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
				|	Контрагенты.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.Контрагенты КАК Контрагенты
				|ГДЕ
				|	Контрагенты.ИНН = &ИНН";
			Если ЗначениеЗаполнено(ИНН) Тогда
				Запрос.УстановитьПараметр("ИНН", ИНН);
				
				ОписаниеОшибки = СтрШаблон(НСтр("ru = 'контрагент с ИНН %1 не найден'"), ИНН);
			Иначе
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "Контрагенты.ИНН = &ИНН", "Контрагенты.Наименование = &НаименованиеПолное");
				Запрос.УстановитьПараметр("НаименованиеПолное", ПолноеНаименование);
				
				ОписаниеОшибки = СтрШаблон(НСтр("ru = 'контрагент с наименованием ""%1"" не найден'"), ПолноеНаименование);
			КонецЕсли;
			
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Контрагент = Выборка.Ссылка;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// Если контрагент не найден, то вызываем исключение и не создаем документ ИБ на основании ЭД.
	Если Не ЗначениеЗаполнено(Контрагент) И ВызватьИсключениеПриОшибке Тогда
		ОписаниеОшибки = СтрШаблон(НСтр("ru = 'Не удалось создать документ, %1'"), ОписаниеОшибки);
		
		ВызватьИсключение ОписаниеОшибки;
	КонецЕсли;
	
	Возврат Контрагент;
	
КонецФункции

Функция ОрганизацияПоДаннымУчастника(ДанныеУчастника)
	
	Перем ИНН, КПП, Организация;
	
	ТипУчастника = ДанныеУчастника.ТипУчастника;
	
	Если ТипУчастника.Свойство("ЮЛ") Тогда
		ИНН = ТипУчастника.ЮЛ.ИНН;
		КПП = ТипУчастника.ЮЛ.КПП;
		
		СсылкаНаОбъектПоИННКПП("Организации", ИНН, КПП, Организация);
	КонецЕсли;
	
	// Если организация не найдена, то вызываем исключение и не создаем документ ИБ на основании ЭД.
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Если ЗначениеЗаполнено(КПП) Тогда
			Шаблон = НСтр("ru = 'Не удалось создать документ, организация с ИНН/КПП %1/%2 не найдена'");
			ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, ИНН, КПП);
		Иначе
			Шаблон = НСтр("ru = 'Не удалось создать документ, организация с ИНН %1 не найдена'");
			ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, ИНН);
		КонецЕсли;
		
		ВызватьИсключение ОписаниеОшибки;
	КонецЕсли;
	
	Возврат Организация;
	
КонецФункции

Функция НайтиСсылкуНаНоменклатуруПоставщикаПоИдентификатору(Идентификатор, Контрагент, ТипВозвращаемогоЗначения = "Номенклатура")
	
	Результат = Неопределено;
	
	Если ЗначениеЗаполнено(Контрагент) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	НоменклатураКонтрагентовБЭД.Номенклатура КАК Номенклатура,
		               |	НоменклатураКонтрагентовБЭД.Номенклатура КАК Ссылка
		               |ИЗ
		               |	РегистрСведений.НоменклатураКонтрагентовБЭД КАК НоменклатураКонтрагентовБЭД
		               |ГДЕ
		               |	НоменклатураКонтрагентовБЭД.Идентификатор = &Идентификатор
		               |	И НоменклатураКонтрагентовБЭД.Владелец = &Контрагент";
		
		Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	НоменклатураКонтрагентовБЭД.Номенклатура КАК Номенклатура,
		               |	НоменклатураКонтрагентовБЭД.Номенклатура КАК Ссылка
		               |ИЗ
		               |	РегистрСведений.НоменклатураКонтрагентовБЭД КАК НоменклатураКонтрагентовБЭД
		               |ГДЕ
		               |	НоменклатураКонтрагентовБЭД.Идентификатор = &Идентификатор";
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если ТипВозвращаемогоЗначения = "Номенклатура" Тогда
			Результат = Выборка.Номенклатура;
		Иначе
			Результат = Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СтавкаНДССтрокой(СтавкаНДС)
	Результат = "";
	Если СтавкаНДС = Перечисления.СтавкиНДС.НДС0 Тогда
		Результат = "0";
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС10 Тогда
		Результат = "10";
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС18 Тогда
		Результат = "20";
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС20 Тогда
		Результат = "20";
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС22 Тогда
		Результат = "22";
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС10_110 Тогда
		Результат = "10/110";
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС18_118 Тогда
		Результат = "20/120";
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС20_120 Тогда
		Результат = "20/120";
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС22_122 Тогда
		Результат = "22/122";
		
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС5 Тогда
		Результат = "5";
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС5_105 Тогда
		Результат = "5/105";
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС7 Тогда
		Результат = "7";
	ИначеЕсли СтавкаНДС = Перечисления.СтавкиНДС.НДС7_107 Тогда
		Результат = "7/107";
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

Функция СтавкаНДСИзСтроки(СтавкаНДС)
	Результат = Перечисления.СтавкиНДС.БезНДС;
	
	Если СтавкаНДС = "0" Тогда
		Результат = Перечисления.СтавкиНДС.НДС0;
	ИначеЕсли СтавкаНДС = "10" Тогда
		Результат = Перечисления.СтавкиНДС.НДС10;
	ИначеЕсли СтавкаНДС = "20" Тогда
		Результат = Перечисления.СтавкиНДС.НДС20;
	ИначеЕсли СтавкаНДС = "22" Тогда
		Результат = Перечисления.СтавкиНДС.НДС22;
	ИначеЕсли СтавкаНДС = "10/110" Тогда
		Результат = Перечисления.СтавкиНДС.НДС10_110;
	ИначеЕсли СтавкаНДС = "20/120" Тогда
		Результат = Перечисления.СтавкиНДС.НДС20_120;
	ИначеЕсли СтавкаНДС = "22/122" Тогда
		Результат = Перечисления.СтавкиНДС.НДС22_122;
		
	ИначеЕсли СтавкаНДС = "5" Тогда
		Результат = Перечисления.СтавкиНДС.НДС5;
	ИначеЕсли СтавкаНДС = "5/105" Тогда
		Результат = Перечисления.СтавкиНДС.НДС5_105;
	ИначеЕсли СтавкаНДС = "7" Тогда
		Результат = Перечисления.СтавкиНДС.НДС7;
	ИначеЕсли СтавкаНДС = "7/107" Тогда
		Результат = Перечисления.СтавкиНДС.НДС7_107;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция ОпределитьПоСсылкеПродавцаПокупателяГрузоотправителяГрузополучателя(ДокументСсылка) Экспорт
	
	// Применяется только для устаревших форматов
	
	Результат =  УчетНДС.ОпределитьПоСсылкеПродавцаПокупателяГрузоотправителяГрузополучателя(ДокументСсылка);
	
	ЮрФизЛицо = ДокументСсылка.Организация;
	ДанныеОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЮрФизЛицо, "ГоловнаяОрганизация, НаименованиеПолное, ИНН, КПП");
	
	ГоловнаяОрганизация = ДанныеОрганизации.ГоловнаяОрганизация;
	Если ЗначениеЗаполнено(ГоловнаяОрганизация) Тогда
		Результат.Вставить("ИННГрузоотправителя", ДанныеОрганизации.ИНН);
		Результат.Вставить("КППГрузоотправителя", ДанныеОрганизации.КПП);
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

Процедура ЗаполнитьТаблицуТоваровУПД(ТаблицаТоваров, ТолькоУслуги, Знач ТаблицаНФА, Знач СчетФактураШкурыЛом)
	
	СтавкаНДСИсчисляетсяНалоговымАгентом = УчетНДСКлиентСервер.ТекстСтавкиНДСИсчисляетсяНалоговымАгентом();
	
	ТаблицаТоваров = СоздатьТаблицуТоваровУПД();
	
	ТолькоУслуги = Истина;
			
	НомерСтроки = 1;
	
	Для Каждого ТекСтрока из ТаблицаНФА Цикл
		НомерСтроки = НомерСтроки + 1;
		
		НалоговаяСтавка = ?(СчетФактураШкурыЛом, СтавкаНДСИсчисляетсяНалоговымАгентом, ТекСтрока.СтавкаНДС);
		
		НоваяСтрока = ТаблицаТоваров.Добавить();
		
		НоваяСтрока.НомерСтроки = НомерСтроки;
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока, "ЕдиницаИзмеренияНаименование,ЕдиницаИзмеренияКод");
		
		Если ТипЗнч(ТекСтрока.НФА) = Тип("СправочникСсылка.Номенклатура") Тогда
			НоваяСтрока.ТоварИдентификатор = ТекСтрока.НФА.УникальныйИдентификатор();
			НоваяСтрока.ТоварНаименование  = ТекСтрока.НФА.НаименованиеПолное;
			НоваяСтрока.ТоварКод           = ТекСтрока.НФА.Код;
			
			Признак = ПризнакТовараЕдиногоДокумента(ТекСтрока.НФА);
			
			Если НЕ ПризнакУслуги(Признак) Тогда
				Если ЗначениеЗаполнено(ТекСтрока.НФА.СтранаПроисхождения) Тогда
					СведенияОТаможеннойДекларации = Новый ТаблицаЗначений;
					СведенияОТаможеннойДекларации.Колонки.Добавить("СтранаПроисхожденияКод", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(3)));
					СведенияОТаможеннойДекларации.Колонки.Добавить("ТаможеннаяДекларацияНомер", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(29)));
					СтрокаТД = СведенияОТаможеннойДекларации.Добавить();
					СтранаПроисхожденияКод = ?(ЗначениеЗаполнено(ТекСтрока.НФА.СтранаПроисхождения), ТекСтрока.НФА.СтранаПроисхождения.Код, "");
					СтрокаТД.СтранаПроисхожденияКод = СтранаПроисхожденияКод;
					СтрокаТД.ТаможеннаяДекларацияНомер = ?(ЗначениеЗаполнено(ТекСтрока.НФА.НомерГТД), ТекСтрока.НФА.НомерГТД.Код, "");
					Если НЕ (СтранаПроисхожденияКод = "") Тогда
						НоваяСтрока.СведенияОТаможеннойДекларации = СведенияОТаможеннойДекларации;
						НоваяСтрока.СтранаПроисхожденияНаименование = ?(ЗначениеЗаполнено(ТекСтрока.НФА.СтранаПроисхождения), ТекСтрока.НФА.СтранаПроисхождения.Наименование, "");
						НоваяСтрока.СтранаПроисхожденияКод = ?(ЗначениеЗаполнено(ТекСтрока.НФА.СтранаПроисхождения), ТекСтрока.НФА.СтранаПроисхождения.Код, "");
					КонецЕсли;
				КонецЕсли;	
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(ТекСтрока.НФА) = Тип("СправочникСсылка.ОсновныеСредства") Тогда	
			НоваяСтрока.ТоварИдентификатор = ТекСтрока.НФА.УникальныйИдентификатор();
			НоваяСтрока.ТоварНаименование  = ТекСтрока.НФА.НаименованиеПолное;
			НоваяСтрока.ТоварКод           = ТекСтрока.НФА.Код;
			
		Иначе
			НоваяСтрока.ТоварНаименование  = ТекСтрока.НФА;
			НоваяСтрока.ТоварКод           = "";
		КонецЕсли;
		
		Номенклатура = ТекСтрока.НФА;
		
		НоваяСтрока.Признак = ПризнакТовараЕдиногоДокумента(ТекСтрока.НФА);
		
		НоваяСтрока.Количество					= ТекСтрока.Количество;
		НоваяСтрока.ЦенаЗаЕдиницуИзмерения		= ТекСтрока.Цена ;
		НоваяСтрока.СтоимостьТоваровБезНалога	= ТекСтрока.Всего - ТекСтрока.СуммаНДС;
		НоваяСтрока.СтоимостьТоваровСНалогом   	= ТекСтрока.Всего;
		НоваяСтрока.СуммаНалога                	= ТекСтрока.СуммаНДС;
		НоваяСтрока.НалоговаяСтавка				= ТекСтрока.СтавкаНДС;
		
		НоваяСтрока.СуммаАкциза					= 0;
		
		Если ТолькоУслуги И (НЕ ПризнакУслуги(НоваяСтрока.Признак)) Тогда
			ТолькоУслуги = Ложь;
		КонецЕсли;
		
		//	Сопоставление	
		//		Идентификатор
		//		Наименование
		//		Характеристика
		//		ЕдиницаИзмерения
		//		ЕдиницаИзмеренияКод
		//		Артикул
		//		СтавкаНДС
		//		Штрихкод
		//		НоменклатураИБ
		//		ХарактеристикаИБ
		//		УпаковкаИБ
		
		Сопоставление = Новый Структура();
		
		Сопоставление.Вставить("Наименование",			НоваяСтрока.ТоварНаименование);
		Сопоставление.Вставить("ЕдиницаИзмерения",		НоваяСтрока.ЕдиницаИзмеренияНаименование);
		Сопоставление.Вставить("ЕдиницаИзмеренияКод",	НоваяСтрока.ЕдиницаИзмеренияКод);
		Сопоставление.Вставить("НоменклатураИБ",		ТекСтрока.НФА);
		
		НоваяСтрока.Сопоставление = Сопоставление;
	КонецЦикла;	
	
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаТоваров,
		"Количество", , ,
		НСтр("ru = 'Не указано количество в табличной части.'"));
		
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаТоваров,
		"ЕдиницаИзмеренияНаименование", , ,
		НСтр("ru = 'Не указано наименование единицы измерения в табличной части.'"));
		
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаТоваров,
		"ЕдиницаИзмеренияКод", , ,
		НСтр("ru = 'Не указан код единицы измерения в табличной части.'"));
		
КонецПроцедуры

Функция НовыйПараметрыЗаполнитьТаблицуТоваровУПД_2019()
	
	Параметры = Новый Структура("
		|ТаблицаНФА,
		|ТолькоУслуги,
		|ДанныеКодовМаркировки,
		|НеобходимоЗаполнениеДанныхЭДОПродавцаДляГосНужд,
		|ДанныеАктированияЕИС");
	
	Параметры.Вставить("СчетФактураНаАванс", Ложь);
	Параметры.Вставить("СчетФактураШкурыЛом", Ложь);
	Параметры.Вставить("ВестиУчетПрослеживаемыхТоваров", ПолучитьФункциональнуюОпцию("ВестиУчетПрослеживаемыхТоваров"));
	Параметры.Вставить("СтранаРоссия", Справочники.СтраныМира.Россия);
	
	Возврат Параметры;
	
КонецФункции

Процедура ЗаполнитьТаблицуТоваровУПД_2019(ТаблицаТоваров, Параметры, ДополнительныеПараметрыДокументаРеализации = Неопределено)
	
	ТаблицаНФА			= Параметры.ТаблицаНФА;
	СчетФактураНаАванс	= Параметры.СчетФактураНаАванс;
	СчетФактураШкурыЛом	= Параметры.СчетФактураШкурыЛом;
	ДанныеКодовМаркировки							= Параметры.ДанныеКодовМаркировки;
	НеобходимоЗаполнениеДанныхЭДОПродавцаДляГосНужд	= Параметры.НеобходимоЗаполнениеДанныхЭДОПродавцаДляГосНужд;
	ДанныеАктированияЕИС							= Параметры.ДанныеАктированияЕИС;
	
	ЗаполняемУПДСтатус2 = (ДополнительныеПараметрыДокументаРеализации <> Неопределено);
	
	СтавкаНДСИсчисляетсяНалоговымАгентом = УчетНДСКлиентСервер.ТекстСтавкиНДСИсчисляетсяНалоговымАгентом();
	
	ЕдИзмШт = Справочники.КлассификаторЕдиницИзмерения.ПолучитьЕдиницуИзмеренияПоУмолчанию();
	
	ЕстьКолонкаСтранаПроисхождения = (ТаблицаНФА.Колонки.Найти("СтранаПроисхождения") <> Неопределено);
	
	ТаблицаТоваров = СоздатьТаблицуТоваровУПД();
	
	НомерСтроки = 0;
	
	ТолькоУслуги = Истина;
	
	ЕстьСведенияОСуммеАкцизов = Истина;
	Если ТаблицаНФА.Колонки.Найти("СуммаАкциза") = Неопределено Тогда
		ЕстьСведенияОСуммеАкцизов = Ложь;
	КонецЕсли;	
	
	Для Каждого ТекСтрока Из ТаблицаНФА Цикл
		НомерСтроки = НомерСтроки + 1;
		
		НоваяСтрока = ТаблицаТоваров.Добавить();
		
		НоваяСтрока.НомерСтроки = НомерСтроки;
		НоваяСтрока.ИдентификаторСтроки = ТекСтрока.ИдентификаторСтроки;
		
		Номенклатура = ?(ЗаполняемУПДСтатус2, ТекСтрока.Номенклатура, ТекСтрока.НФА);
		
		НалоговаяСтавка = ?(СчетФактураШкурыЛом, СтавкаНДСИсчисляетсяНалоговымАгентом, ТекСтрока.СтавкаНДС);
		
		Признак = ПризнакТовараЕдиногоДокумента(Номенклатура);
		
		ЭтоПризнакУслуги = ПризнакУслуги(Признак);
		
		Если НЕ ЭтоПризнакУслуги Тогда
			ТолькоУслуги = Ложь;
		КонецЕсли;
		
		Если ЗаполняемУПДСтатус2 Тогда
			Если ПустаяСтрока(ТекСтрока.БазоваяЕдиницаКод) Тогда
				Если ТипЗнч(Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
					// Берем значение ед. измерения из карточки номенклатуры
					ЕдиницаИзмерения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "ЕдиницаИзмерения");
				ИначеЕсли ТипЗнч(Номенклатура) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
					ЕдиницаИзмерения = ЕдИзмШт;
				Иначе
					ЕдиницаИзмерения = Неопределено;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
					РеквизитыЕдиницыИзмерения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЕдиницаИзмерения, "Наименование, Код");
					НоваяСтрока.ЕдиницаИзмеренияКод          = СокрЛП(РеквизитыЕдиницыИзмерения.Код);
					НоваяСтрока.ЕдиницаИзмеренияНаименование = СокрЛП(РеквизитыЕдиницыИзмерения.Наименование);
				КонецЕсли;
			Иначе
				НоваяСтрока.ЕдиницаИзмеренияКод          = СокрЛП(ТекСтрока.БазоваяЕдиницаКод);
				НоваяСтрока.ЕдиницаИзмеренияНаименование = СокрЛП(ТекСтрока.ЕдиницаИзмерения);
			КонецЕсли;
		Иначе
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока, "ЕдиницаИзмеренияНаименование,ЕдиницаИзмеренияКод");
		КонецЕсли;
		
		Если ТипЗнч(Номенклатура) = Тип("СправочникСсылка.Номенклатура") Или ТипЗнч(Номенклатура) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
			ИменаРеквизитов = "КодКаталога, КодПоКТРУ, НаименованиеПолное, Код, КодТНВЭД, СтранаПроисхождения, ПрослеживаемыйТовар";
			
			Если ТипЗнч(Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
				ИменаРеквизитов = ИменаРеквизитов + ",НомерГТД";
			КонецЕсли;
			
			ДанныеНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, ИменаРеквизитов);
			
			ПрослеживаемыйТовар = ДанныеНоменклатуры.ПрослеживаемыйТовар;
			
			НоваяСтрока.ТоварИдентификатор 	= Номенклатура.УникальныйИдентификатор();
			НоваяСтрока.ТоварНаименование  	= ДанныеНоменклатуры.НаименованиеПолное;
			НоваяСтрока.ТоварКод           	= ДанныеНоменклатуры.Код;
			НоваяСтрока.КодВидаТовара		= Строка(ДанныеНоменклатуры.КодТНВЭД);
			
			Если НеобходимоЗаполнениеДанныхЭДОПродавцаДляГосНужд Тогда
				НоваяСтрока.ТоварКод	= ДанныеНоменклатуры.КодПоКТРУ;
				НоваяСтрока.КодКаталога	= ДанныеНоменклатуры.КодКаталога;
			КонецЕсли;	
			
			Если Не ЭтоПризнакУслуги Тогда
				СтранаПроисхождения = ?(ЕстьКолонкаСтранаПроисхождения, ТекСтрока.СтранаПроисхождения, ДанныеНоменклатуры.СтранаПроисхождения);
				
				РеквизитыСтраныПроисхождения = Новый Структура("Наименование, Код", "", "");
				
				Если ЗначениеЗаполнено(СтранаПроисхождения) Тогда
					ЗаполнитьЗначенияСвойств(РеквизитыСтраныПроисхождения, ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтранаПроисхождения, "Наименование, Код"));
				КонецЕсли;
				
				СтранаПроисхожденияКод = СокрЛП(РеквизитыСтраныПроисхождения.Код);
				
				НоваяСтрока.СтранаПроисхожденияНаименование	= РеквизитыСтраныПроисхождения.Наименование;
				НоваяСтрока.СтранаПроисхожденияКод			= СтранаПроисхожденияКод;
				
				Если Параметры.ВестиУчетПрослеживаемыхТоваров И ПрослеживаемыйТовар Тогда
					ТаможеннаяДекларацияНомер = "Прослеж";
					
				ИначеЕсли ДанныеНоменклатуры.Свойство("НомерГТД") И ЗначениеЗаполнено(ДанныеНоменклатуры.НомерГТД) Тогда
					ДанныеГТД = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеНоменклатуры.НомерГТД, "Код");
					
					ТаможеннаяДекларацияНомер = СокрЛП(ДанныеГТД.Код);
				Иначе
					ТаможеннаяДекларацияНомер = Неопределено;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(СтранаПроисхожденияКод) Или ЗначениеЗаполнено(ТаможеннаяДекларацияНомер) Тогда
					СведенияОТаможеннойДекларации = СоздатьТаблицуСведенияОТаможеннойДекларацииУПД_2019();
					
					// Приказ ФНС России от 19.12.2018 N ММВ-7-15/820@
					// Сведения о таможенной декларации
					// При осуществлении закупок для обеспечения государственных и муниципальных нужд может заполняться для любой страны происхождения
					НоваяСтрокаТД = СведенияОТаможеннойДекларации.Добавить();
					
					Если СтранаПроисхождения <> Параметры.СтранаРоссия Или НеобходимоЗаполнениеДанныхЭДОПродавцаДляГосНужд Тогда
						// Приказ ФНС России от 19.12.2018 N ММВ-7-15/820@
						// Цифровой код страны происхождения товара (Графа 10 счета-фактуры)
						// В общем случае заполняется в отношении товаров, страной происхождения которых не является Российская Федерация
						// (кроме случаев осуществления закупок для обеспечения государственных и муниципальных нужд)
						НоваяСтрокаТД.СтранаПроисхожденияКод = СтранаПроисхожденияКод;
					КонецЕсли;
					
					НоваяСтрокаТД.ТаможеннаяДекларацияНомер	= ТаможеннаяДекларацияНомер;
					
					НоваяСтрока.СведенияОТаможеннойДекларации = СведенияОТаможеннойДекларации;
				КонецЕсли;
			КонецЕсли;
			
			СведенияОбъемноСортовогоУчетаМаркированныхТоваров = ТекСтрока.СведенияОбъемноСортовогоУчетаМаркированныхТоваров;
			
			Если ДанныеКодовМаркировки <> Неопределено Или ЗначениеЗаполнено(СведенияОбъемноСортовогоУчетаМаркированныхТоваров) Тогда
				СсылкаНаОбъект = ДанныеКодовМаркировки.СсылкаНаОбъект;
				ТаблицаКодовМаркировки = ДанныеКодовМаркировки.ТаблицаКодовМаркировки;
				НоваяСтрока.ИдентификаторСтроки = ТекСтрока.ИдентификаторСтроки;
				ЗаполнитьРеквизитыМаркировкиВСтрокеТоваров_2019(НоваяСтрока, ТаблицаКодовМаркировки, СсылкаНаОбъект.Ссылка, ,СведенияОбъемноСортовогоУчетаМаркированныхТоваров);
			КонецЕсли;
			
		Иначе
			НоваяСтрока.ТоварНаименование  = Номенклатура;
			НоваяСтрока.ТоварКод           = "";
			
			ПрослеживаемыйТовар = Ложь;
		КонецЕсли;
		
		Если Не ЗаполняемУПДСтатус2 И ЗначениеЗаполнено(ТекСтрока.СодержаниеУслуги) Тогда
			НоваяСтрока.ТоварНаименование  = ТекСтрока.СодержаниеУслуги;
		КонецЕсли;
		
		Если ЗаполняемУПДСтатус2 Тогда
			НоваяСтрока.Признак = ТекСтрока.Признак;
			НоваяСтрока.ПризнакДополнительнаяИнформация = ТекСтрока.ПризнакДополнительнаяИнформация;
		Иначе
			НоваяСтрока.Признак = Признак;
			НоваяСтрока.ПризнакДополнительнаяИнформация = ПризнакТарыЕдиногоДокумента(Номенклатура);
		КонецЕсли;
		
		Если ЗаполняемУПДСтатус2 Тогда
			Всего = ТекСтрока.СуммаСНДС;
		Иначе
			Всего = ТекСтрока.Всего;
		КонецЕсли;
		
		НоваяСтрока.Количество					= ТекСтрока.Количество;
		НоваяСтрока.ЦенаЗаЕдиницуИзмерения		= ТекСтрока.Цена;
		НоваяСтрока.СтоимостьТоваровБезНалога	= Всего - ТекСтрока.СуммаНДС;
		НоваяСтрока.СтоимостьТоваровСНалогом   	= Всего;
		НоваяСтрока.СуммаНалога                	= ТекСтрока.СуммаНДС;
		НоваяСтрока.НалоговаяСтавка				= НалоговаяСтавка;
		Если ЕстьСведенияОСуммеАкцизов Тогда
			НоваяСтрока.СуммаАкциза             = ТекСтрока.СуммаАкциза;
		Иначе
			НоваяСтрока.СуммаАкциза             = 0;
		КонецЕсли;
		
		Если СчетФактураНаАванс Тогда
			ОчищающаяСтруктура = Новый Структура("
				|Количество,
				|ЦенаЗаЕдиницуИзмерения,
				|СтоимостьТоваровБезНалога,
				|ЕдиницаИзмеренияНаименование,
				|ЕдиницаИзмеренияКод,
				|КодВидаТовара,
				|ТоварКод");
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ОчищающаяСтруктура);
		КонецЕсли;
		
		Если СчетФактураШкурыЛом Тогда
			ОчищающаяСтруктура = Новый Структура("
				|СуммаНалога,
				|СтоимостьТоваровСНалогом");
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ОчищающаяСтруктура);
		КонецЕсли;
		
		//	Сопоставление	
		//		Идентификатор
		//		Наименование
		//		Характеристика
		//		ЕдиницаИзмерения
		//		ЕдиницаИзмеренияКод
		//		Артикул
		//		СтавкаНДС
		//		Штрихкод
		//		НоменклатураИБ
		//		ХарактеристикаИБ
		//		УпаковкаИБ	
		
		Сопоставление = Новый Структура();
		
		Если ТипЗнч(Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
			Сопоставление.Вставить("Наименование",			НоваяСтрока.ТоварНаименование);
			Сопоставление.Вставить("ЕдиницаИзмерения",		НоваяСтрока.ЕдиницаИзмеренияНаименование);
			Сопоставление.Вставить("ЕдиницаИзмеренияКод",	НоваяСтрока.ЕдиницаИзмеренияКод);
			Сопоставление.Вставить("НоменклатураИБ",		Номенклатура);
		КонецЕсли;
		
		НоваяСтрока.Сопоставление = Сопоставление;
		
		// Прослеживаемость
		Если Параметры.ВестиУчетПрослеживаемыхТоваров И ПрослеживаемыйТовар Тогда
			Если ЗаполняемУПДСтатус2 Тогда
				ЗаполнитьСведенияОПрослеживаемостиВСтрокеТоваровПоТорг12ПродавецУПД_2019(НоваяСтрока, Номенклатура, ДополнительныеПараметрыДокументаРеализации);
			Иначе
				НоваяСтрока.СведенияОПрослеживаемости = ТекСтрока.СведенияОПрослеживаемости;
			КонецЕсли;
		КонецЕсли;
		// Прослеживаемость
		
		// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
		Если ЗначениеЗаполнено(ДанныеАктированияЕИС) Тогда
			Если ДанныеАктированияЕИС.ЕстьЭлектронноеАктирование Тогда
				
				НоваяСтрока.ИдентификаторСтроки = ТекСтрока.ИдентификаторСтроки;
				ЭлектронноеАктированиеБГУ.ЗаполнитьДанныеПоСтрокеТоваровУПД_2019(
					НоваяСтрока, ТекСтрока, ДанныеАктированияЕИС, ДанныеАктированияЕИС.ДанныеПриложенияЕИС);
			КонецЕсли;
		КонецЕсли;
		// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
		
	КонецЦикла;
	
	Параметры.ТолькоУслуги = ТолькоУслуги;
	
	//ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаТоваров,
	//	"Количество", , ,
	//	НСтр("ru = 'Не указано количество в табличной части.'"));
	//	
	//ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаТоваров,
	//	"ЕдиницаИзмеренияНаименование", , ,
	//	НСтр("ru = 'Не указано наименование единицы измерения в табличной части.'"));
	//	
	//ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаТоваров,
	//	"ЕдиницаИзмеренияКод", , ,
	//	НСтр("ru = 'Не указан код единицы измерения в табличной части.'"));
	
КонецПроцедуры

Процедура ЗаполнитьТаблицуТоваровУКД(ТаблицаТоваров, ТолькоУслуги, Знач ТаблицаНФА, Знач СчетФактураШкурыЛом)
	
	СтавкаНДСИсчисляетсяНалоговымАгентом = УчетНДСКлиентСервер.ТекстСтавкиНДСИсчисляетсяНалоговымАгентом();
	
	ТаблицаТоваров = СоздатьТаблицуТоваровДляКорректировкиУКД();
	
	ТолькоУслуги = Истина;
			
	НомерСтроки = 0;
	
	Для Каждого ТекСтрока Из ТаблицаНФА Цикл
		НомерСтроки = НомерСтроки + 1;
		
		НалоговаяСтавкаДоИзменения = ?(СчетФактураШкурыЛом, СтавкаНДСИсчисляетсяНалоговымАгентом, ТекСтрока.СтавкаНДСДоИзменения);
		НалоговаяСтавка = ?(СчетФактураШкурыЛом, СтавкаНДСИсчисляетсяНалоговымАгентом, ТекСтрока.СтавкаНДС);
		
		НоваяСтрока = ТаблицаТоваров.Добавить();
		
		НоваяСтрока.НомерСтроки	= НомерСтроки;
		
		Признак = "1";
		
		Если ТипЗнч(ТекСтрока.НФА) = Тип("СправочникСсылка.Номенклатура") Тогда
			НоваяСтрока.ТоварИдентификатор						= ТекСтрока.НФА.УникальныйИдентификатор();
			НоваяСтрока.ТоварНаименование						= ТекСтрока.НФА.НаименованиеПолное;
			
			Признак = ПризнакТовараЕдиногоДокумента(ТекСтрока.НФА);
			
		ИначеЕсли ТипЗнч(ТекСтрока.НФА) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
			НоваяСтрока.ТоварИдентификатор						= ТекСтрока.НФА.УникальныйИдентификатор();
			НоваяСтрока.ТоварНаименование						= ТекСтрока.НФА.НаименованиеПолное;
			
		Иначе
			НоваяСтрока.ТоварНаименование						= ТекСтрока.НФА;
			
		КонецЕсли;
		
		НоваяСтрока.ЕдиницаИзмеренияКодДоКорректировки			= СокрЛП(ТекСтрока.ЕдиницаИзмеренияКод);
		НоваяСтрока.ЕдиницаИзмеренияКод							= СокрЛП(ТекСтрока.ЕдиницаИзмеренияКод);
		
		НоваяСтрока.КоличествоДоКорректировки					= ТекСтрока.КоличествоДоИзменения;
		НоваяСтрока.Количество									= ТекСтрока.Количество;
		
		НоваяСтрока.ЦенаЗаЕдиницуИзмеренияДоКорректировки		= ТекСтрока.ЦенаДоИзменения;
		НоваяСтрока.ЦенаЗаЕдиницуИзмерения						= ТекСтрока.Цена;
		
		НоваяСтрока.СтоимостьТоваровБезНалогаДоКорректировки	= ТекСтрока.СуммаДоИзменения;
		НоваяСтрока.СтоимостьТоваровБезНалога					= ТекСтрока.Сумма;
		
		НоваяСтрока.СтоимостьТоваровБезНалогаУвеличение			= ТекСтрока.СуммаУвеличение;
		НоваяСтрока.СтоимостьТоваровБезНалогаУменьшение			= ТекСтрока.СуммаУменьшение;
		
		НоваяСтрока.НалоговаяСтавкаДоКорректировки				= НалоговаяСтавкаДоИзменения;
		НоваяСтрока.НалоговаяСтавка								= НалоговаяСтавка;
		
		НоваяСтрока.СуммаНалогаДоКорректировки					= ТекСтрока.СуммаНДСДоИзменения;
		НоваяСтрока.СуммаНалога									= ТекСтрока.СуммаНДС;
		
		НоваяСтрока.СуммаНалогаУвеличение						= ТекСтрока.СуммаНДСУвеличение;
		НоваяСтрока.СуммаНалогаУменьшение						= ТекСтрока.СуммаНДСУменьшение;
		
		НоваяСтрока.СтоимостьТоваровСНалогомДоКорректировки		= ТекСтрока.ВсегоДоИзменения;
		НоваяСтрока.СтоимостьТоваровСНалогом					= ТекСтрока.Всего;
		
		НоваяСтрока.СтоимостьТоваровСНалогомУвеличение			= ТекСтрока.ВсегоУвеличение;
		НоваяСтрока.СтоимостьТоваровСНалогомУменьшение			= ТекСтрока.ВсегоУменьшение;
		
		НоваяСтрока.СуммаАкцизаДоКорректировки					= 0;
		НоваяСтрока.СуммаАкциза									= 0;
		
		Если ТолькоУслуги И (НЕ ПризнакУслуги(Признак)) Тогда
			ТолькоУслуги = Ложь;
		КонецЕсли;
		
		Если СчетФактураШкурыЛом Тогда
			ОчищающаяСтруктура = Новый Структура("
				|СуммаНалогаДоКорректировки,
				|СуммаНалога,
				|СтоимостьТоваровСНалогомДоКорректировки,
				|СтоимостьТоваровСНалогом,
				|СуммаНалогаУвеличение,
				|СуммаНалогаУменьшение,
				|СтоимостьТоваровСНалогомУвеличение,
				|СтоимостьТоваровСНалогомУменьшение");
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ОчищающаяСтруктура);
		КонецЕсли;
		
		//	Сопоставление	
		//		Идентификатор
		//		Наименование
		//		Характеристика
		//		ЕдиницаИзмерения
		//		ЕдиницаИзмеренияКод
		//		Артикул
		//		СтавкаНДС
		//		Штрихкод
		//		НоменклатураИБ
		//		ХарактеристикаИБ
		//		УпаковкаИБ
		
		Сопоставление = Новый Структура();
		
		Сопоставление.Вставить("Наименование",			НоваяСтрока.ТоварНаименование);
		Сопоставление.Вставить("ЕдиницаИзмерения",		ТекСтрока.ЕдиницаИзмеренияНаименование);
		Сопоставление.Вставить("ЕдиницаИзмеренияКод",	ТекСтрока.ЕдиницаИзмеренияКод);
		Сопоставление.Вставить("НоменклатураИБ",		ТекСтрока.НФА);
		
		НоваяСтрока.Сопоставление = Сопоставление;
		
	КонецЦикла;
	
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаТоваров,
		"Количество", , ,
		НСтр("ru = 'Не указано количество в табличной части.'"));
		
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаТоваров,
		"ЕдиницаИзмеренияКодДоКорректировки", , ,
		НСтр("ru = 'Не указан код единицы измерения до корректировки в табличной части.'"));
		
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаТоваров,
		"ЕдиницаИзмеренияКод", , ,
		НСтр("ru = 'Не указан код единицы измерения в табличной части.'"));
	
КонецПроцедуры

Процедура ЗаполнитьРасчетныеСчетаУПД(РасчетныеСчета, Торг12Ссылка)
	
	Продавец			= Справочники.РеквизитыЛицевыхСчетов.ПустаяСсылка();
	Покупатель			= Справочники.БанковскиеИКазначейскиеСчета.ПустаяСсылка();
	Грузоотправитель	= Справочники.БанковскиеИКазначейскиеСчета.ПустаяСсылка();
	Грузополучатель		= Справочники.БанковскиеИКазначейскиеСчета.ПустаяСсылка();
	
	Если ЗначениеЗаполнено(Торг12Ссылка) Тогда
		Если ТипЗнч(Торг12Ссылка) = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12")
			ИЛИ ТипЗнч(Торг12Ссылка) = Тип("ДокументСсылка.НакладнаяНаОтпускМ15") 
			ИЛИ ТипЗнч(Торг12Ссылка) = Тип("ДокументСсылка.ПередачаОбъектовОС") 
			ИЛИ ТипЗнч(Торг12Ссылка) = Тип("ДокументСсылка.ПередачаОбъектовИК") Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Торг12Ссылка,
				"РеквизитыЛицевогоСчета,РасчетныйСчетКонтрагента,РасчетныйСчетГрузополучателя,РасчетныйСчетГрузоотправителя");
			
			Продавец			= ЗначенияРеквизитов.РеквизитыЛицевогоСчета;	
			Покупатель			= ЗначенияРеквизитов.РасчетныйСчетКонтрагента;
			Грузоотправитель	= ЗначенияРеквизитов.РасчетныйСчетГрузоотправителя;
			Грузополучатель		= ЗначенияРеквизитов.РасчетныйСчетГрузополучателя;
			
		ИначеЕсли ТипЗнч(Торг12Ссылка) = Тип("ДокументСсылка.АктОбОказанииУслуг") Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Торг12Ссылка,
				"РеквизитыЛицевогоСчета,РасчетныйСчетКонтрагента");
			
			Продавец	= ЗначенияРеквизитов.РеквизитыЛицевогоСчета;	
			Покупатель	= ЗначенияРеквизитов.РасчетныйСчетКонтрагента;
		КонецЕсли;
	КонецЕсли;
	
	РасчетныеСчета = Новый Структура();
	РасчетныеСчета.Вставить("Продавец",			Продавец);
	РасчетныеСчета.Вставить("Покупатель",		Покупатель);
	РасчетныеСчета.Вставить("Грузоотправитель",	Грузоотправитель);
	РасчетныеСчета.Вставить("Грузополучатель",	Грузополучатель);
	
КонецПроцедуры

Процедура ЗаполнитьТаблицуПлатежныхДокументовУПД(ПлатежныеДокументы, Знач ТаблицаПРД)
	
	ПлатежныеДокументы = Новый ТаблицаЗначений();
	ПлатежныеДокументы.Колонки.Добавить("НомерПРД",	Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(30)));
	ПлатежныеДокументы.Колонки.Добавить("ДатаПРД",	Новый ОписаниеТипов("Дата"));
	
	Для Каждого СтрокаТаблицы Из ТаблицаПРД Цикл
		НоваяСтрока = ПлатежныеДокументы.Добавить();
		
		НоваяСтрока.НомерПРД	= СтрокаТаблицы.НомерДокумента;
		НоваяСтрока.ДатаПРД		= СтрокаТаблицы.ДатаДокумента;
	КонецЦикла;
	
КонецПроцедуры

Функция ВидимостьДанныхЭДОПродавцаДляГосНужд(Контрагент, Организация = Неопределено) Экспорт
	Результат = Ложь;
	
	Если ЗначениеЗаполнено(Организация) Тогда
		Если НеЗаполнятьСведенияОПродажеДляГосНужд(Организация) Тогда
			Возврат Результат;
		КонецЕсли;	
	КонецЕсли;
	
	ДанныеКонтрагента = ОбщегоНазначенияБГУ.ПолучитьЗначенияРеквизитов(Контрагент, "ТипКонтрагента");
	
	Если ДанныеКонтрагента.ТипКонтрагента = Справочники.ТипыКонтрагентов.НайтиПоКоду("1") ИЛИ
		ДанныеКонтрагента.ТипКонтрагента = Справочники.ТипыКонтрагентов.НайтиПоКоду("2") ИЛИ
		ДанныеКонтрагента.ТипКонтрагента = Справочники.ТипыКонтрагентов.НайтиПоКоду("3") Тогда
		
		Результат = Истина;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

Функция ДанныеЭДОПродавцаДляГосНужд(Договор) Экспорт
	
	Результат = ОбщегоНазначенияБГУ.ПолучитьЗначенияРеквизитов(Договор, "КПСПродавца, КодЦелиПродавца, СчетКонтрагента");
	
	Возврат Результат;
КонецФункции

Функция ДанныеДляЭДПродавцаДляГосНужд(ДокументРеализации) Экспорт
	
	Результат = Новый Структура("
		|ДатаГосКонтракта,
		|НомерГосКонтракта,
		|НомерЛицевогоСчетаПродавца,
		|КодБюджетнойКлассификацииПродавца,
		|КодЦели,
		|КазначействоПродавцаКод,
		|КазначействоПродавцаНаименование");
	
	КазначействоПродавцаКодПоЛС = "";
	КазначействоПродавцаНаименованиеПоЛС = "";
				
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ДокументРеализации, "Договор") Тогда
		Договор = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументРеализации, "Договор");
		
		Если ТипЗнч(Договор) = Тип("СправочникСсылка.Договоры") Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, "ДатаДоговора,НомерДоговора");
			
			Результат.Вставить("ДатаГосКонтракта", ЗначенияРеквизитов.ДатаДоговора);
			Результат.Вставить("НомерГосКонтракта", ЗначенияРеквизитов.НомерДоговора);
		ИначеЕсли ТипЗнч(ДокументРеализации) = Тип("ДокументСсылка.КассовоеПоступление") Тогда	
			Если ДокументРеализации.РасшифровкаПлатежа.Количество() > 0 Тогда
				Договор = ДокументРеализации.РасшифровкаПлатежа[0].Договор;
				
				Если ЗначениеЗаполнено(Договор) Тогда
					ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, "ДатаДоговора,НомерДоговора");
					
					Результат.Вставить("ДатаГосКонтракта", ЗначенияРеквизитов.ДатаДоговора);
					Результат.Вставить("НомерГосКонтракта", ЗначенияРеквизитов.НомерДоговора);
				КонецЕсли;
				
				ЛицевойСчет = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументРеализации, "ЛицевойСчет");
				
				ЗапросСведенийДляКассовогоПоступления = Новый Запрос;
				ЗапросСведенийДляКассовогоПоступления.Текст = "ВЫБРАТЬ
				                                              |	РеквизитыЛицевыхСчетов.СчетКазначейства КАК СчетКазначейства,
				                                              |	ВЫРАЗИТЬ(ВЫРАЗИТЬ(РеквизитыЛицевыхСчетов.СчетКазначейства КАК Справочник.БанковскиеИКазначейскиеСчета).Владелец КАК Справочник.Казначейства).Код КАК КазначействоПродавцаКод,
				                                              |	ВЫРАЗИТЬ(ВЫРАЗИТЬ(РеквизитыЛицевыхСчетов.СчетКазначейства КАК Справочник.БанковскиеИКазначейскиеСчета).Владелец КАК Справочник.Казначейства).НаименованиеПолное КАК КазначействоПродавцаНаименование
				                                              |ИЗ
				                                              |	Справочник.РеквизитыЛицевыхСчетов КАК РеквизитыЛицевыхСчетов
				                                              |ГДЕ
				                                              |	РеквизитыЛицевыхСчетов.Владелец = &ЛицевойСчет
				                                              |	И РеквизитыЛицевыхСчетов.ПометкаУдаления = ЛОЖЬ
															  |	И ЕСТЬNULL(РеквизитыЛицевыхСчетов.СчетКазначейства, 0) <> 0";
				
				ЗапросСведенийДляКассовогоПоступления.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
				ВыборкаКазначейства = ЗапросСведенийДляКассовогоПоступления.Выполнить().Выбрать();
				
				Пока ВыборкаКазначейства.Следующий() Цикл
					КазначействоПродавцаКодПоЛС = ВыборкаКазначейства.КазначействоПродавцаКод;
					КазначействоПродавцаНаименованиеПоЛС = ВыборкаКазначейства.КазначействоПродавцаНаименование;
				КонецЦикла;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(АктОбОказанииУслуг.КодЦелиПродавца КАК Справочник.ВидыЦелевыхСредств).Код КАК КодЦели,
	               |	ВЫРАЗИТЬ(АктОбОказанииУслуг.Договор КАК Справочник.Договоры).ДатаДоговора КАК ДатаГосКонтракта,
	               |	ВЫРАЗИТЬ(АктОбОказанииУслуг.Договор КАК Справочник.Договоры).НомерДоговора КАК НомерГосКонтракта,
	               |	ВЫРАЗИТЬ(ВЫРАЗИТЬ(АктОбОказанииУслуг.РеквизитыЛицевогоСчета КАК Справочник.РеквизитыЛицевыхСчетов).Владелец КАК Справочник.ЛицевыеСчета).Код КАК НомерЛицевогоСчетаПродавца,
	               |	ВЫРАЗИТЬ(ВЫРАЗИТЬ(ВЫРАЗИТЬ(АктОбОказанииУслуг.РеквизитыЛицевогоСчета КАК Справочник.РеквизитыЛицевыхСчетов).СчетКазначейства КАК Справочник.БанковскиеИКазначейскиеСчета).Владелец КАК Справочник.Казначейства).Код КАК КазначействоПродавцаКод,
	               |	ВЫРАЗИТЬ(ВЫРАЗИТЬ(ВЫРАЗИТЬ(АктОбОказанииУслуг.РеквизитыЛицевогоСчета КАК Справочник.РеквизитыЛицевыхСчетов).СчетКазначейства КАК Справочник.БанковскиеИКазначейскиеСчета).Владелец КАК Справочник.Казначейства).НаименованиеПолное КАК КазначействоПродавцаНаименование,
	               |	АктОбОказанииУслуг.Организация КАК Организация,
	               |	АктОбОказанииУслуг.ИФО КАК ИФО,
	               |	ВЫРАЗИТЬ(АктОбОказанииУслуг.КПСПродавца КАК Справочник.КлассификационныеПризнакиСчетов).ДатаНачалаДействия КАК ДатаНачалаДействия,
	               |	ВЫРАЗИТЬ(АктОбОказанииУслуг.РеквизитыЛицевогоСчета КАК Справочник.РеквизитыЛицевыхСчетов).Владелец КАК ЛицевойСчет,
	               |	АктОбОказанииУслуг.КПСПродавца КАК КПСПродавца
	               |ИЗ
	               |	Документ.АктОбОказанииУслуг КАК АктОбОказанииУслуг
	               |ГДЕ
	               |	АктОбОказанииУслуг.Ссылка = &Ссылка
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(НакладнаяНаРеализациюТорг12.КодЦелиПродавца КАК Справочник.ВидыЦелевыхСредств).Код,
	               |	ВЫРАЗИТЬ(НакладнаяНаРеализациюТорг12.Договор КАК Справочник.Договоры).ДатаДоговора,
	               |	ВЫРАЗИТЬ(НакладнаяНаРеализациюТорг12.Договор КАК Справочник.Договоры).НомерДоговора,
	               |	ВЫРАЗИТЬ(ВЫРАЗИТЬ(НакладнаяНаРеализациюТорг12.РеквизитыЛицевогоСчета КАК Справочник.РеквизитыЛицевыхСчетов).Владелец КАК Справочник.ЛицевыеСчета).Код,
	               |	ВЫРАЗИТЬ(ВЫРАЗИТЬ(ВЫРАЗИТЬ(НакладнаяНаРеализациюТорг12.РеквизитыЛицевогоСчета КАК Справочник.РеквизитыЛицевыхСчетов).СчетКазначейства КАК Справочник.БанковскиеИКазначейскиеСчета).Владелец КАК Справочник.Казначейства).Код,
	               |	ВЫРАЗИТЬ(ВЫРАЗИТЬ(ВЫРАЗИТЬ(НакладнаяНаРеализациюТорг12.РеквизитыЛицевогоСчета КАК Справочник.РеквизитыЛицевыхСчетов).СчетКазначейства КАК Справочник.БанковскиеИКазначейскиеСчета).Владелец КАК Справочник.Казначейства).НаименованиеПолное,
	               |	НакладнаяНаРеализациюТорг12.Организация,
	               |	НакладнаяНаРеализациюТорг12.ИФО,
	               |	ВЫРАЗИТЬ(НакладнаяНаРеализациюТорг12.КПСПродавца КАК Справочник.КлассификационныеПризнакиСчетов).ДатаНачалаДействия,
	               |	ВЫРАЗИТЬ(НакладнаяНаРеализациюТорг12.РеквизитыЛицевогоСчета КАК Справочник.РеквизитыЛицевыхСчетов).Владелец,
