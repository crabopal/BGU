Процедура ЗаполнитьСведенияОЛицеПринявшемТоварыУПД_5_03(ДеревоДанных, СведенияПриемки)
	
	НачалоПути = "СодержаниеФХЖ.СведенияОПринятииТоваров.СведенияОЛицеПринявшемТовары";
	
	ДатаПолученияТоваров = СведенияПриемки.ДатаПолученияТоваров;
	
	Если СведенияПриемки.ОтветственныйПринялТоварыВид = 0 Тогда
		Путь = НачалоПути + ".РаботникОрганизацииПокупателя";
		
		Сотрудник = СведенияПриемки.ОтветственныйПринялТовары;
		
		ДанныеСотрудника = Новый Структура("Фамилия, Имя, Отчество, Должность");
		ДанныеСотрудника.Вставить("СсылкаНаОбъект",	Сотрудник);
		ДанныеСотрудника.Вставить("Период",			ДатаПолученияТоваров);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		
		Если ПроверитьЗаполнениеРаботникОрганизацииПокупателяУПД_5_03(СведенияПриемки, ДанныеСотрудника) Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + ".Должность", Строка(ДанныеСотрудника.Должность));
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + ".ИныеСведения", СведенияПриемки.ОтветственныйПринялТоварыИныеСведения);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + ".ФИО.Фамилия", ДанныеСотрудника.Фамилия);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + ".ФИО.Имя", ДанныеСотрудника.Имя);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + ".ФИО.Отчество", ДанныеСотрудника.Отчество);
		КонецЕсли;
		
	ИначеЕсли СведенияПриемки.ОтветственныйПринялТоварыВид = 1 Тогда
		Путь = НачалоПути + ".ИноеЛицо.ПредставительОрганизации";
		
		КонтрагентПринявшегоЛица = СведенияПриемки.ОтветственныйПринялТоварыКонтрагент;
		
		ДанныеКонтрагентаПредставителя = Новый Структура;
		ДанныеКонтрагентаПредставителя.Вставить("СсылкаНаОбъект", КонтрагентПринявшегоЛица);
		ДанныеКонтрагентаПредставителя.Вставить("Период", ДатаПолученияТоваров);
		ДанныеКонтрагентаПредставителя.Вставить("ИНН");
		ДанныеКонтрагентаПредставителя.Вставить("КПП");
		ДанныеКонтрагентаПредставителя.Вставить("НаименованиеПолное");
		НаименованиеКонтрагентаСокращенное = КонтрагентПринявшегоЛица.НаименованиеСокращенное;
		
		Справочники.Контрагенты.ПолучитьДанныеКонтрагента(ДанныеКонтрагентаПредставителя);
		
		НаименованиеКонтрагентаПредставителя = ?(Значениезаполнено(НаименованиеКонтрагентаСокращенное), 
			НаименованиеКонтрагентаСокращенное,
			ДанныеКонтрагентаПредставителя.НаименованиеПолное);
		
		ДанныеФЛ = ФИОФЛ(СведенияПриемки.ОтветственныйПринялТовары, ДатаПолученияТоваров);
		
		Если ПроверитьЗаполнениеИноеЛицоПредставительОрганизацииУПД_5_03(СведенияПриемки, ДанныеФЛ, НаименованиеКонтрагентаПредставителя) Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + ".Должность", Строка(СведенияПриемки.ОтветственныйПринялТоварыДолжность));
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + ".ИныеСведения", СведенияПриемки.ОтветственныйПринялТоварыИныеСведения);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + ".НаименованиеОрганизации", НаименованиеКонтрагентаПредставителя);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + ".ДоверенностьНаПринятие", Строка(СведенияПриемки.ОтветственныйПринялТоварыДоверенность));
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + ".ОснованиеПолномочий", СведенияПриемки.ОтветственныйПринялТоварыОснованиеПолномочий);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + ".ФИО.Фамилия", ДанныеФЛ.Фамилия);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + ".ФИО.Имя", ДанныеФЛ.Имя);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + ".ФИО.Отчество", ДанныеФЛ.Отчество);
		КонецЕсли;
		
	ИначеЕсли СведенияПриемки.ОтветственныйПринялТоварыВид = 2 Тогда
		Путь = НачалоПути + ".ИноеЛицо.ФЛ";
		
		ДанныеФЛ = ФИОФЛ(СведенияПриемки.ОтветственныйПринялТовары, ДатаПолученияТоваров);
		
		Если ПроверитьЗаполнениеИноеЛицоФЛУПД_5_03(СведенияПриемки, ДанныеФЛ) Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + ".ИныеСведения", СведенияПриемки.ОтветственныйПринялТоварыИныеСведения);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + ".ДоверенностьНаПринятие", Строка(СведенияПриемки.ОтветственныйПринялТоварыДоверенность));
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + ".ФИО.Фамилия", ДанныеФЛ.Фамилия);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + ".ФИО.Имя", ДанныеФЛ.Имя);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + ".ФИО.Отчество", ДанныеФЛ.Отчество);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

