// Подготавливает данные для электронного документа типа УКД (информация продавца).
//
// Параметры:
//  СсылкаНаОбъект - ДокументСсылка - ссылка на объект информационной базы, по которому необходимо
//                                    создать электронный документ.
//  СтруктураЭД - Структура - структура данных для формирования электронного документа.
//  ДеревоДанных - ДеревоЗначений - дерево данных заполнения электронного документа.
//
Процедура ЗаполнитьДанныеДляКСЧФИнформацияПродавцаФНС_2019(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ = Ложь) Экспорт
	
	ТипДокумента = ТипЗнч(СсылкаНаОбъект);
	
	Если ТипДокумента = Тип("ДокументСсылка.КорректировочныйСчетФактураВыданный") Тогда
		ПодготовитьДанныеПоКорректировочномуСчетуФактуреУКД_2019(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ);
		
	ИначеЕсли ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный") Тогда
		ПодготовитьДанныеПоИсправительномуСчетуФактуре_КорректировкаУКД_2019(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ);
		
	Иначе
		ШаблонСообщения = НСтр("ru = 'Для %1 универсальный передаточный документ не применяется.'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, СсылкаНаОбъект);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

// Подготавливает данные для электронного документа типа ИсправительныйСчетФактураВыданный,
// исправляющего корректировочный счет-фактуру.
//
// Параметры:
//  СсылкаНаОбъект - ДокументСсылка, ссылка на объект информационной базы, по которому необходимо создать электронный документ.
//  СтруктураЭД - Структура, структура данных для формирования электронного документа.
//
Процедура ПодготовитьДанныеПоИсправительномуСчетуФактуреУПД_2019(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ = Ложь, ЭтоУПД)
	
	НетЗамечанийКДокументу = Документы["ИсправительныйСчетФактураВыданный"].ПредварительныйКонтрольДанныхДляЭД(СсылкаНаОбъект);
	
	Если НЕ НетЗамечанийКДокументу Тогда
		ОписаниеОшибки = НСтр("ru='Вышеуказанные ошибки препятствуют формированию электронного документа.
		|По этой причине и прочие данные документа не будут выгружены в ЭД.
		|После заполнения указанных реквизитов повторите попытку формирования электронного документа.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки);
		Отказ = Истина;
		Возврат;
	КонецЕсли;	
	
	ДанныеДокумента = Документы.ИсправительныйСчетФактураВыданный.ПодготовитьДанныеДляЭД(СсылкаНаОбъект,, ЭтоУПД);
	
	ТаблицаСФ	= ДанныеДокумента["Шапка"];
	ТаблицаНФА	= ДанныеДокумента["ТабЧастьНФА"];
	ТаблицаПРД	= ДанныеДокумента["ТабЧастьПРД"];
	
	СтороныСделки	= ДанныеДокумента["СтороныСделки"];
	НомерДокумента	= ДанныеДокумента["НомерДокумента"];
	
	// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	Контракт = ЭлектронноеАктированиеЕИС.ГосударственныйКонтрактДоговора(ТаблицаСФ[0].Договор);
	ЕстьЭлектронноеАктирование = ЭлектронноеАктированиеЕИС.ИспользоватьЭлектронноеАктированиеВЕИС()
		И ЗначениеЗаполнено(Контракт)
		И ЭлектронноеАктированиеЕИС.ОбменПоОрганизацииВключен(ТаблицаСФ[0].Организация);
	ДанныеДокумента.Вставить("ЕстьЭлектронноеАктирование", ЕстьЭлектронноеАктирование);
	// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	
	НеобходимоЗаполнениеДанныхЭДОПродавцаДляГосНужд = Ложь;
	
	Для Каждого РеквизитыИСФ Из ТаблицаСФ Цикл
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СсылкаСчетаФактуры", СсылкаНаОбъект);
		
		Если Не ЗначениеЗаполнено(РеквизитыИСФ.КодВалюты) Тогда
			ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
				"Объект.ВалютаДокумента");
		Иначе
			ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект.ВалютаДокумента, 
				"Объект.Код");
		КонецЕсли;
		
		ВидОперации = Перечисления.ВидыОперацийЭД.Исправление;
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВидОперации", ВидОперации);
		
		ВидСчетаФактуры = "Реализация";
		
		СчетФактураНаАванс = УчетНДСПовтИсп.Аванс(РеквизитыИСФ.ПричинаНалогообложения);
		
		СчетФактураШкурыЛом = УчетНДСПовтИсп.ШкурыЛом(РеквизитыИСФ.ПричинаНалогообложения);
		
		// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
		Если ЕстьЭлектронноеАктирование Тогда
			ЭлектронноеАктированиеБГУ.ЗаполнитьДанныеЭлектронногоАктирования(ДанныеДокумента, РеквизитыИСФ);
		КонецЕсли;
		// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
		
		// Строка 5а счета-фактуры
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументОбОтгрузке", ДанныеДокумента.ДокументыОбОтгрузке.Строка5а);
		
		// Документы подтверждения отгрузки
		ДокументыПодтвержденияОтгрузки = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
			ДеревоДанных, "ДокументыПодтвержденияОтгрузки");
			
		Для Каждого СтрокаТаблицы Из ДанныеДокумента.ДокументыОбОтгрузке.Таблица Цикл
			НоваяСтрока = ДокументыПодтвержденияОтгрузки.Добавить();
			
			НоваяСтрока.Наименование	= СтрокаТаблицы.НаименованиеДокумента;
			НоваяСтрока.Номер			= СтрокаТаблицы.НомерДокумента;
			НоваяСтрока.Дата			= СтрокаТаблицы.ДатаДокумента;
		КонецЦикла;
		
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ДокументыПодтвержденияОтгрузки, "ДокументыПодтвержденияОтгрузки");
		
		ОбстоятельстваФормированияСФ = ?(СчетФактураНаАванс, "2", "1");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ДополнительныеСведенияОбУчастниках.ОбстоятельстваФормированияСФ", ОбстоятельстваФормированияСФ, ПараметрыОбработкиОшибок);
		
		Если СтруктураЭД.Функция = "СЧФДОП" Тогда // УПД СФ + первичка СЧФДОПУПД
			Если СчетФактураНаАванс Тогда 
				ВидСчетаФактуры = "Авансовый";
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СодержаниеОперации", 
					НСтр("ru = 'Регистрация исправления счет-фактуры на аванс'"));
				Иначе
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СодержаниеОперации", 
					НСтр("ru = 'Регистрация исправления счет-фактуры'"));
			КонецЕсли;
		КонецЕсли;	
		
		МассивДокОснований = Новый Массив;
		ДокументОснование = РеквизитыИСФ.ДокументОснование;
		Если ЗначениеЗаполнено(ДокументОснование) Тогда
			МассивДокОснований.Добавить(ДокументОснование);
			
			Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
				
				НеобходимоЗаполнениеДанныхЭДОПродавцаДляГосНужд = ВидимостьДанныхЭДОПродавцаДляГосНужд(ДокументОснование.Контрагент, ДокументОснование.Организация);
				Если НеобходимоЗаполнениеДанныхЭДОПродавцаДляГосНужд Тогда
					ДанныеДляЭДПродавцаДляГосНужд = ДанныеДляЭДПродавцаДляГосНужд(ДокументОснование.ДокументОснование);
					ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
						"ДополнительныеСведенияОбУчастниках.ЗакупкаДляГосударственныхНужд.ДатаГосКонтракта", ДанныеДляЭДПродавцаДляГосНужд.ДатаГосКонтракта);
					ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
						"ДополнительныеСведенияОбУчастниках.ЗакупкаДляГосударственныхНужд.НомерГосКонтракта", ДанныеДляЭДПродавцаДляГосНужд.НомерГосКонтракта);
					ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
						"ДополнительныеСведенияОбУчастниках.ЗакупкаДляГосударственныхНужд.НомерЛицевогоСчетаПродавца", ДанныеДляЭДПродавцаДляГосНужд.НомерЛицевогоСчетаПродавца);
					ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
						"ДополнительныеСведенияОбУчастниках.ЗакупкаДляГосударственныхНужд.КодБюджетнойКлассификацииПродавца", ДанныеДляЭДПродавцаДляГосНужд.КодБюджетнойКлассификацииПродавца);
					ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
						"ДополнительныеСведенияОбУчастниках.ЗакупкаДляГосударственныхНужд.КодЦели", ДанныеДляЭДПродавцаДляГосНужд.КодЦели);
					ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
						"ДополнительныеСведенияОбУчастниках.ЗакупкаДляГосударственныхНужд.КазначействоПродавцаКод", ДанныеДляЭДПродавцаДляГосНужд.КазначействоПродавцаКод);
					ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
						"ДополнительныеСведенияОбУчастниках.ЗакупкаДляГосударственныхНужд.КазначействоПродавцаНаименование", ДанныеДляЭДПродавцаДляГосНужд.КазначействоПродавцаНаименование);
				КонецЕсли;
			
			КонецЕсли;
				
		КонецЕсли;
		
		// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
		ЭтоЭлектронноеАктированиеЕИС = Ложь;
		Если ДанныеДокумента.Свойство("ДанныеЭлектронногоАктирования") Тогда
			ЭтоЭлектронноеАктированиеЕИС = Истина;
			ДанныеЭлектронногоАктирования = ДанныеДокумента.ДанныеЭлектронногоАктирования;
			ДанныеПриложенияЕИС = ЭлектронноеАктированиеЕИС.НовыеДанныеПриложенияКТитулуПродавцаУПД();
			ЭлектронноеАктированиеБГУ.ЗаполнитьДанныеДереваДляЭлектронногоАктированияЕИС(ДеревоДанных,
				ДанныеЭлектронногоАктирования,
				ДанныеДокумента.Шапка[0],
				ДанныеПриложенияЕИС,
				Ложь);
		КонецЕсли;
		// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияСчетаФактуры", МассивДокОснований);
		
		ОснованиеОтгрузкиТоваров = Новый ТаблицаЗначений;
		ОснованиеОтгрузкиТоваров.Колонки.Добавить("ДокументНаименование");
		ОснованиеОтгрузкиТоваров.Колонки.Добавить("ДокументНомер");
		ОснованиеОтгрузкиТоваров.Колонки.Добавить("ДокументДата");
		ОснованиеОтгрузкиТоваров.Колонки.Добавить("ДокументДопСведения");
		
		Если ЗначениеЗаполнено(РеквизитыИСФ.Договор)	 Тогда
			НоваяСтрока = ОснованиеОтгрузкиТоваров.Добавить();
			НоваяСтрока.ДокументНаименование = РеквизитыИСФ.Договор.ВидОбязательства;
			НоваяСтрока.ДокументНомер = РеквизитыИСФ.Договор.НомерДоговора;
			НоваяСтрока.ДокументДата = НачалоДня(РеквизитыИСФ.Договор.ДатаДоговора);
		КонецЕсли;
		
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ОснованиеОтгрузкиТоваров,
			"ДокументДата", , ,
			НСтр("ru = 'Не заполнена дата договора для реквизита ""Договор"".'"));
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ОснованиеОтгрузкиТоваров, "ОснованиеОтгрузкиТоваров");
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента", НомерДляПечати(СсылкаНаОбъект, НомерДокумента.Номер));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаДокумента", РеквизитыИСФ.ДатаСчетаФактуры);
		
		НомерИсправления = РеквизитыИСФ.НомерИсправления;
		Если ЗначениеЗаполнено(НомерИсправления) Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсправления", НомерИсправления);
		КонецЕсли;
		
		ДатаИсправления = РеквизитыИСФ.ДатаИсправления;
		Если ЗначениеЗаполнено(ДатаИсправления) Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаИсправления", ДатаИсправления);
		КонецЕсли;
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаКод", РеквизитыИСФ.КодВалюты, ПараметрыОбработкиОшибок);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ДополнительныеСведенияОбУчастниках.ИдентификаторГосКонтракта", РеквизитыИСФ.ИдентификаторГосКонтракта);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ДополнительныеСведенияОбУчастниках.ВалютаНаименование", РеквизитыИСФ.ВалютаПредставление);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ДополнительныеСведенияОбУчастниках.ВалютаКурс", РеквизитыИСФ.Курс);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВидСчетаФактуры", ВидСчетаФактуры(РеквизитыИСФ.ПричинаНалогообложения));
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"СоставительДокументаНаименование", РеквизитыИСФ.Организация.НаименованиеПолное);
		
		// Расчетные счета
		Торг12Ссылка = ?(ЗначениеЗаполнено(ДокументОснование),
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснование, "ДокументОснование"),
			Неопределено);
		РасчетныеСчета = Неопределено;
		ЗаполнитьРасчетныеСчетаУПД(РасчетныеСчета, Торг12Ссылка);
		
		// Продавец
		ЗаполнитьДанныеУчастникаУПД_2019(
			ДеревоДанных,
			"СведенияОПродавце",
			"СведенияОбУчастнике",
			СтороныСделки.Продавец.Ссылка,
			РеквизитыИСФ.ДатаИсправления,
			Истина,
			РасчетныеСчета.Продавец,
			СтороныСделки,
			,
			ДанныеЭлектронногоАктирования);
		
		// Покупатель
		ЗаполнитьДанныеУчастникаУПД_2019(
			ДеревоДанных,
			"СведенияОПокупателе",
			"СведенияОбУчастнике",
			СтороныСделки.Покупатель.Ссылка,
			РеквизитыИСФ.ДатаИсправления,
			Истина,
			РасчетныеСчета.Покупатель,
			СтороныСделки,
			,
			ДанныеЭлектронногоАктирования);
			
		Если ЭтоЭлектронноеАктированиеЕИС Тогда
			// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
			СоставительДокумента = ЭлектронноеАктированиеБГУ.СоставительДокумента(СтороныСделки.Продавец.Ссылка);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
				"СоставительДокументаНаименование", СоставительДокумента);
			// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
		Иначе
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СоставительДокументаНаименование", РеквизитыИСФ.Организация.НаименованиеПолное);
		КонецЕсли;
			
		// Грузоотправитель
		ОнЖе = СтороныСделки.Грузоотправитель.СовпадаетСПродавцом;
		
		Если ОнЖе Тогда
			ТаблицаГрузоотправителей = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
				ДеревоДанных, "СведенияОГрузоотправителе");
				
			ТаблицаГрузоотправителей.Колонки.Добавить("СведенияОбУчастнике");
			
			ТаблицаГрузоотправителей.Добавить().ОнЖе = ОнЖе;
			
			ДобавитьОбработкуОшибокВТаблицуУчастниковУПД_2019(ТаблицаГрузоотправителей, "Грузоотправитель");
			
			ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаГрузоотправителей, "СведенияОГрузоотправителе");
		Иначе	
			ЗаполнитьДанныеУчастникаГрузооборотаУПД_2019(
				ДеревоДанных,
				"СведенияОГрузоотправителе",
				"СведенияОбУчастнике",
				СтороныСделки.Грузоотправитель.Ссылка,
				РеквизитыИСФ.ДатаИсправления,
				Истина,
				РасчетныеСчета.Грузоотправитель,
				ОнЖе,
				СтороныСделки);
		КонецЕсли;	
		
		// Грузополучатель
		ЗаполнитьДанныеУчастникаГрузооборотаУПД_2019(
			ДеревоДанных,
			"СведенияОГрузополучателе",
			"СведенияОбУчастнике",
			СтороныСделки.Грузополучатель.Ссылка,
			РеквизитыИСФ.ДатаИсправления,
			Истина,
			РасчетныеСчета.Грузополучатель,
			,
			СтороныСделки,
			ДанныеЭлектронногоАктирования);
		
		// Таблица ПРД
		ПлатежныеДокументы = Неопределено;
		ЗаполнитьТаблицуПлатежныхДокументовУПД(ПлатежныеДокументы, ТаблицаПРД);
		
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ПлатежныеДокументы, "ПлатежноРасчетныеДокументы");
		
		// Таблица НФА
		ТаблицаТоваров = Неопределено;
		ТолькоУслуги = Неопределено;
		
		ДанныеАктированияДокументаРеализации = Новый Структура;
		ДанныеАктированияДокументаРеализации.Вставить("ЕстьЭлектронноеАктирование", ЕстьЭлектронноеАктирование);
		Если ЕстьЭлектронноеАктирование Тогда
			Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
				ДокументОснованиеРеализация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснование, "ДокументОснование");
			Иначе	
				ДокументОснованиеРеализация = ДокументОснование;
			КонецЕсли;	
			Если ЗначениеЗаполнено(ДокументОснование) Тогда
				ТаблицаАктированияДокументаРеализации = ДокументОснованиеРеализация.ДанныеДляАктированияЕИС.Выгрузить();
				ДанныеАктированияДокументаРеализации.Вставить("ДанныеШапки", ДанныеДокумента.Шапка[0]);
				ДанныеАктированияДокументаРеализации.Вставить("СсылкаНаОбъект", СсылкаНаОбъект);
				ДанныеАктированияДокументаРеализации.Вставить("ДанныеЭлектронногоАктирования", ДанныеДокумента.ДанныеЭлектронногоАктирования);
				ДанныеАктированияДокументаРеализации.Вставить("ДанныеПриложенияЕИС", ДанныеПриложенияЕИС);
				ДанныеАктированияДокументаРеализации.Вставить("ТаблицаАктирования", ТаблицаАктированияДокументаРеализации);
			КонецЕсли;
		КонецЕсли;	
		
		Параметры = НовыйПараметрыЗаполнитьТаблицуТоваровУПД_2019();
		Параметры.ТолькоУслуги			= ТолькоУслуги;
		Параметры.ТаблицаНФА			= ТаблицаНФА;
		Параметры.СчетФактураНаАванс	= СчетФактураНаАванс;
		Параметры.СчетФактураШкурыЛом	= СчетФактураШкурыЛом;
		Параметры.НеобходимоЗаполнениеДанныхЭДОПродавцаДляГосНужд	= НеобходимоЗаполнениеДанныхЭДОПродавцаДляГосНужд;
		Параметры.ДанныеАктированияЕИС								= ДанныеАктированияДокументаРеализации;
		
		ЗаполнитьТаблицуТоваровУПД_2019(ТаблицаТоваров, Параметры);
		
		ТолькоУслуги = Параметры.ТолькоУслуги;
		
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаТоваров, "СведенияОТоварах");
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ТолькоУслуги", ТолькоУслуги);
		
		ТекстОшибки = НСтр("ru = 'Возникла ошибка при заполнении страны происхождения в сведениях по ГТД. Возможные причины:
		|	- не заполнена колонка ""Страна происхождения""
		|	- указанной страны нет в классификаторе стран мира'");
		ЭлектронноеВзаимодействие.ДобавитьВРеквизитОбработкуОшибки(ДеревоДанных,
			"СведенияОТоварах.НомерСтроки.СведенияОТаможеннойДекларации.НомерСтроки.СтранаПроисхожденияКод", ТекстОшибки);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ВсегоКОплате.ВсегоСтоимостьТоваровБезНалога", ТаблицаТоваров.Итог("СтоимостьТоваровБезНалога"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ВсегоКОплате.ВсегоСтоимостьТоваровСНалогом", ТаблицаТоваров.Итог("СтоимостьТоваровСНалогом"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ВсегоКОплате.ВсегоСуммаНалога", ТаблицаТоваров.Итог("СуммаНалога"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ВсегоКОплате.ВсегоКоличество", ТаблицаТоваров.Итог("Количество"));
	КонецЦикла;
	
КонецПроцедуры	

// Подготавливает данные для электронного документа типа СчетФактураВыданный.
//
// Параметры:
//  СсылкаНаОбъект - ДокументСсылка, ссылка на объект информационной базы, по которому необходимо создать электронный документ.
//  СтруктураЭД - Структура, структура данных для формирования электронного документа.
//
Процедура ПодготовитьДанныеПоСчетуФактуреУПД_2019(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ = Ложь, ЭтоУПД)
	НетЗамечанийКДокументу = Документы["СчетФактураВыданный"].ПредварительныйКонтрольДанныхДляЭД(СсылкаНаОбъект);
	
	Если НЕ НетЗамечанийКДокументу Тогда
		ОписаниеОшибки = НСтр("ru='Вышеуказанные ошибки препятствуют формированию электронного документа.
		|По этой причине и прочие данные документа не будут выгружены в ЭД.
		|После заполнения указанных реквизитов повторите попытку формирования электронного документа.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки);
		Отказ = Истина;
		Возврат;
	КонецЕсли;	
	
	ДанныеДокумента = Документы.СчетФактураВыданный.ПодготовитьДанныеДляЭД(СсылкаНаОбъект, ЭтоУПД);
	
	ТаблицаСФ	= ДанныеДокумента["Шапка"];
	ТаблицаНФА	= ДанныеДокумента["ТабЧастьНФА"];
	ТаблицаПРД	= ДанныеДокумента["ТабЧастьПРД"];
	ТаблицаКодовМаркировки = ДанныеДокумента["ТабЧастьМаркировкаТоваров"];
	
	СтороныСделки	= ДанныеДокумента["СтороныСделки"];
	НомерДокумента	= ДанныеДокумента["НомерДокумента"];
	
	// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	Контракт = ЭлектронноеАктированиеЕИС.ГосударственныйКонтрактДоговора(ДанныеДокумента.Шапка[0].Договор);
	ЕстьЭлектронноеАктирование = ЭлектронноеАктированиеЕИС.ИспользоватьЭлектронноеАктированиеВЕИС()
		И ЗначениеЗаполнено(Контракт)
		И ЭлектронноеАктированиеЕИС.ОбменПоОрганизацииВключен(ДанныеДокумента.Шапка[0].Организация);
	ДанныеДокумента.Вставить("ЕстьЭлектронноеАктирование", ЕстьЭлектронноеАктирование);
	// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	
	Для Каждого РеквизитыСФ Из ТаблицаСФ Цикл
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СсылкаСчетаФактуры", СсылкаНаОбъект);
		
		Если Не ЗначениеЗаполнено(РеквизитыСФ.ВалютаКод) Тогда
			ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
				"Объект.ВалютаДокумента");
		Иначе
			ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект.ВалютаДокумента, 
				"Объект.Код");
		КонецЕсли;
		
		ДокументОснование = РеквизитыСФ.ДокументОснование;
		Если ТипЗнч(РеквизитыСФ.ДокументОснование) = Тип("ДокументСсылка.СписаниеДоходовБудущихПериодов") 
		ИЛИ (ТипЗнч(РеквизитыСФ.ДокументОснование) = Тип("ДокументСсылка.НачислениеЗаУслугиОбразования"))  
		ИЛИ (ТипЗнч(РеквизитыСФ.ДокументОснование) = Тип("ДокументСсылка.НачислениеРодительскойПлаты"))  
		ИЛИ (ТипЗнч(РеквизитыСФ.ДокументОснование) = Тип("ДокументСсылка.НачислениеСтудентамЗаПрочиеУслуги"))  
			ИЛИ ТипЗнч(РеквизитыСФ.ДокументОснование) = Тип("ДокументСсылка.НачислениеДоходов") Тогда
			ДокументОснование = РеквизитыСФ.ДокументОснованиеЭДО;
		КонецЕсли;	
		
		ВидСчетаФактуры = "Реализация";
		
		СчетФактураНаАванс = УчетНДСПовтИсп.Аванс(РеквизитыСФ.ПричинаНалогообложения);
		
		СчетФактураШкурыЛом = УчетНДСПовтИсп.ШкурыЛом(РеквизитыСФ.ПричинаНалогообложения);		
		
		ОбстоятельстваФормированияСФ = ?(СчетФактураНаАванс, "2", "1");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"ДополнительныеСведенияОбУчастниках.ОбстоятельстваФормированияСФ", ОбстоятельстваФормированияСФ, ПараметрыОбработкиОшибок);
		
		Если СтруктураЭД.Функция = "СЧФДОП" Тогда // УПД СФ + первичка СЧФДОПУПД
			Если СчетФактураНаАванс Тогда 
				ВидСчетаФактуры = "Авансовый";
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СодержаниеОперации", 
					НСтр("ru = 'Регистрация счет-фактуры на аванс'"));
				Иначе
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СодержаниеОперации", 
					НСтр("ru = 'Регистрация счет-фактуры'"));
			КонецЕсли;
		КонецЕсли;
		
		//доп. данные маркировки
		Если РеквизитыСФ.СведенияОВыбытииМаркированныхТоваров > 0 Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОВыбытииМаркированныхТоваров",  РеквизитыСФ.СведенияОВыбытииМаркированныхТоваров);
		КонецЕсли;
		
		// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
		Если ЕстьЭлектронноеАктирование Тогда
			ЭлектронноеАктированиеБГУ.ЗаполнитьДанныеЭлектронногоАктирования(ДанныеДокумента, РеквизитыСФ);
		КонецЕсли;
		// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
		
		// Строка 5а счета-фактуры
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументОбОтгрузке", ДанныеДокумента.ДокументыОбОтгрузке.Строка5а);
		
		// Документы подтверждения отгрузки
		ДокументыПодтвержденияОтгрузки = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
			ДеревоДанных, "ДокументыПодтвержденияОтгрузки");
			
		Для Каждого СтрокаТаблицы Из ДанныеДокумента.ДокументыОбОтгрузке.Таблица Цикл
			НоваяСтрока = ДокументыПодтвержденияОтгрузки.Добавить();
			
			НоваяСтрока.Наименование	= СтрокаТаблицы.НаименованиеДокумента;
			НоваяСтрока.Номер			= СтрокаТаблицы.НомерДокумента;
			НоваяСтрока.Дата			= СтрокаТаблицы.ДатаДокумента;
		КонецЦикла;
		
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ДокументыПодтвержденияОтгрузки, "ДокументыПодтвержденияОтгрузки");
		
		// Информация продавца об обстоятельствах закупок для государственных и муниципальных нужд.
		
		// Основание уступки денежного требования.
		
		// Фактор
		НеобходимоЗаполнениеДанныхЭДОПродавцаДляГосНужд = Ложь;
		
		МассивДокОснований = Новый Массив;
		Если ЗначениеЗаполнено(ДокументОснование) Тогда
			МассивДокОснований.Добавить(ДокументОснование);
			
			ТекстоваяИнформация = Новый ТаблицаЗначений;
			ТекстоваяИнформация.Колонки.Добавить("Идентификатор", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(50)));
			ТекстоваяИнформация.Колонки.Добавить("Значение", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(30)));
			
			НоваяСтрока = ТекстоваяИнформация.Добавить();
			НоваяСтрока.Идентификатор = "ВидДокументаОснования";
			Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.АктОбОказанииУслуг") Тогда
				НоваяСтрока.Значение = НСтр("ru = 'АктОбОказанииУслуг'");
			ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12") Тогда
				НоваяСтрока.Значение = НСтр("ru = 'НакладнаяНаРеализациюТорг12'");
			ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.НакладнаяНаОтпускМ15") Тогда
				НоваяСтрока.Значение = НСтр("ru = 'НакладнаяНаОтпускМ15'");
			ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПередачаОбъектовОС") Тогда
				НоваяСтрока.Значение = НСтр("ru = 'ПередачаОбъектовОС'");
			ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПередачаОбъектовИК") Тогда
				НоваяСтрока.Значение = НСтр("ru = 'ПередачаОбъектовИК'");
			Иначе
				НоваяСтрока.Значение = НСтр("ru = 'ДокументАванса'");
			КонецЕсли;	
			
			НоваяСтрока = ТекстоваяИнформация.Добавить();
			НоваяСтрока.Идентификатор = НСтр("ru = 'НомерДокументаОснования'");
			НоваяСтрока.Значение = СокрЛП(ДокументОснование.Номер);

			НоваяСтрока = ТекстоваяИнформация.Добавить();
			НоваяСтрока.Идентификатор = НСтр("ru = 'ДатаДокументаОснования'");
			НоваяСтрока.Значение = Формат(ДокументОснование.Дата, "ДФ=dd.MM.yyyy");
			
			ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТекстоваяИнформация, "ДопДанныеДокументаОтгрузки.ТекстоваяИнформация");
			
			//Ответственный передал ТРУ
			Если ЕстьРеквизитыДокументаДляЗаполненияОтветственногоЗаПередачу(ДокументОснование) Тогда
				РеквизитыШапки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, "ОтветственныйПередалТРУВид, ОтветственныйПередалТРУДолжность, 
					|ОтветственныйПередалТРУИныеСведения, ОтветственныйПередалТРУ, ОтветственныйПередалТРУДоверенность, ОтветственныйПередалТРУОснованиеПолномочий,
					|ОтветственныйПередалТРУКонтрагент, ДатаПередачиТРУ, ТРУПереданы");
				
				РеквизитыШапки.Вставить("Ссылка", ДокументОснование);
			
				ДатаПередачиТРУ = РеквизитыШапки.ДатаПередачиТРУ;
				
				Если РеквизитыШапки.ТРУПереданы Тогда
					ДатаПолученияТоваров = РеквизитыШапки.ДатаПередачиТРУ;
					
					Если РеквизитыШапки.ОтветственныйПередалТРУВид = 0 Тогда
						ВидЛица = "РаботникОрганизацииПродавца";
						Сотрудник = РеквизитыШапки.ОтветственныйПередалТРУ;
						
						ДанныеСотрудника = Новый Структура("Фамилия, Имя, Отчество, Должность");
						ДанныеСотрудника.Вставить("СсылкаНаОбъект",	Сотрудник);
						ДанныеСотрудника.Вставить("Период",			ДатаПередачиТРУ);
						Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
						
						Если НЕ ЗначениеЗаполнено(РеквизитыШапки.ОтветственныйПередалТРУ) Тогда
							Отказ = Истина;
							
							ТекстСообщения  = НСтр("ru='В документе %ДокументПоставщика% на закладке ""Дополнительно"" в форме по ссылке ""Сведения для электронного УПД"" не заполнен реквизит ""Ответственное лицо""!'");
							ТекстСообщения  = СтрЗаменить(ТекстСообщения,"%ДокументПоставщика%", РеквизитыШапки.Ссылка);
							Сообщение       = Новый СообщениеПользователю();
							Сообщение.Текст = ТекстСообщения;
							Сообщение.Сообщить();
						КонецЕсли;
						Если НЕ ЗначениеЗаполнено(ДанныеСотрудника.Должность) Тогда
							Отказ = Истина;
							
							ТекстСообщения  = НСтр("ru='В документе %ДокументПоставщика% на закладке ""Дополнительно"" в форме по ссылке ""Сведения для электронного УПД"" не указаны необходимы данные (должность) для ответственного за передачу лица!'");
							ТекстСообщения  = СтрЗаменить(ТекстСообщения,"%ДокументПоставщика%", РеквизитыШапки.Ссылка);
							Сообщение       = Новый СообщениеПользователю();
							Сообщение.Текст = ТекстСообщения;
							Сообщение.Сообщить();
						КонецЕсли;
						Если НЕ ЗначениеЗаполнено(РеквизитыШапки.ОтветственныйПередалТРУОснованиеПолномочий) Тогда
							Отказ = Истина;
							
							ТекстСообщения  = НСтр("ru='В документе %ДокументПоставщика% на закладке ""Дополнительно"" в форме по ссылке ""Сведения для электронного УПД"" не указаны необходимы данные (основания полномочий) для ответственного за передачу лица!'");
							ТекстСообщения  = СтрЗаменить(ТекстСообщения,"%ДокументПоставщика%", РеквизитыШапки.Ссылка);
							Сообщение       = Новый СообщениеПользователю();
							Сообщение.Текст = ТекстСообщения;
							Сообщение.Сообщить();
						КонецЕсли;
						Если НЕ ЗначениеЗаполнено(ДанныеСотрудника.Фамилия) Тогда
							Отказ = Истина;
							
							ТекстСообщения  = НСтр("ru='В документе %ДокументПоставщика% на закладке ""Дополнительно"" в форме по ссылке ""Сведения для электронного УПД"" не указаны необходимы данные (фамилия) для ответственного за передачу лица!'");
							ТекстСообщения  = СтрЗаменить(ТекстСообщения,"%ДокументПоставщика%", РеквизитыШапки.Ссылка);
							Сообщение       = Новый СообщениеПользователю();
							Сообщение.Текст = ТекстСообщения;
							Сообщение.Сообщить();
						КонецЕсли;
						Если НЕ ЗначениеЗаполнено(ДанныеСотрудника.Имя) Тогда
							Отказ = Истина;
							
							ТекстСообщения  = НСтр("ru='В документе %ДокументПоставщика% на закладке ""Дополнительно"" в форме по ссылке ""Сведения для электронного УПД"" не указаны необходимы данные (имя) для ответственного за передачу лица!'");
							ТекстСообщения  = СтрЗаменить(ТекстСообщения,"%ДокументПоставщика%", РеквизитыШапки.Ссылка);
							Сообщение       = Новый СообщениеПользователю();
							Сообщение.Текст = ТекстСообщения;
							Сообщение.Сообщить();
						КонецЕсли;
						
						Если НЕ Отказ Тогда
							ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОЛицеПередавшемТовары." + ВидЛица + ".Должность", Строка(ДанныеСотрудника.Должность));
							ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОЛицеПередавшемТовары." + ВидЛица + ".ИныеСведения", РеквизитыШапки.ОтветственныйПередалТРУИныеСведения);
							ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОЛицеПередавшемТовары." + ВидЛица + ".ОснованиеПолномочий", РеквизитыШапки.ОтветственныйПередалТРУОснованиеПолномочий);
							ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОЛицеПередавшемТовары." + ВидЛица + ".Фамилия", ДанныеСотрудника.Фамилия);
							ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОЛицеПередавшемТовары." + ВидЛица + ".Имя", ДанныеСотрудника.Имя);
							ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОЛицеПередавшемТовары." + ВидЛица + ".Отчество", ДанныеСотрудника.Отчество);
						КонецЕсли;	
					ИначеЕсли РеквизитыШапки.ОтветственныйПередалТРУВид = 1 Тогда
						ВидЛица = "ИноеЛицо";
						ПодвидЛица = "ПредставительОрганизации";
						
						КонтрагентПередавшегоЛица = РеквизитыШапки.ОтветственныйПередалТРУКонтрагент;
						
						ДанныеКонтрагентаПредставителя = Новый Структура;
						ДанныеКонтрагентаПредставителя.Вставить("СсылкаНаОбъект", КонтрагентПередавшегоЛица);
						ДанныеКонтрагентаПредставителя.Вставить("Период", ДатаПередачиТРУ);
						ДанныеКонтрагентаПредставителя.Вставить("ИНН");
						ДанныеКонтрагентаПредставителя.Вставить("КПП");
						ДанныеКонтрагентаПредставителя.Вставить("НаименованиеПолное");
						НаименованиеКонтрагентаСокращенное = КонтрагентПередавшегоЛица.НаименованиеСокращенное;
						
						Справочники.Контрагенты.ПолучитьДанныеКонтрагента(ДанныеКонтрагентаПредставителя);
						
						НаименованиеКонтрагентаПредставителя = ?(Значениезаполнено(НаименованиеКонтрагентаСокращенное), 
							НаименованиеКонтрагентаСокращенное,
							ДанныеКонтрагентаПредставителя.НаименованиеПолное);
						
						ДанныеФЛ = ФИОФЛ(РеквизитыШапки.ОтветственныйПередалТРУ, ДатаПередачиТРУ);
						
						Если НЕ ЗначениеЗаполнено(РеквизитыШапки.ОтветственныйПередалТРУ) Тогда
							Отказ = Истина;
							
							ТекстСообщения  = НСтр("ru='В документе %ДокументПоставщика% на закладке ""Дополнительно"" в форме по ссылке ""Сведения для электронного УПД"" не заполнен реквизит ""Ответственное лицо""!'");
