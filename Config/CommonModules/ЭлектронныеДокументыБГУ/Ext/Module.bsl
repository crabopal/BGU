Процедура НайтиСоздатьУПДДокументОПередачеУслугРабот_2019(ДеревоДанных, СсылкаНаВладельца = Неопределено, Записывать = Истина, ВидПервичногоДокумента = "")
	РежимЗаписи = РежимЗаписиДокумента.Запись;
	Попытка
		Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
			ДокументОбъект = СсылкаНаВладельца.ПолучитьОбъект();
			Если ДокументОбъект.Проведен Тогда
				Текст = НСтр("ru = 'Операция возможна только для непроведенных документов!'");
			КонецЕсли;
		Иначе
			УстановитьПривилегированныйРежим(Истина);
			ДокументОбъект = Документы.ПоступлениеУслугРабот.СоздатьДокумент();
			ДокументОбъект.Дата = ТекущаяДатаСеанса();
		КонецЕсли;
		ДокументОбъект.ОбменДанными.Загрузка = Истина;
		
		Если НЕ ТипЗнч(ДокументОбъект.Ссылка) = Тип("ДокументСсылка.ПоступлениеУслугРабот") Тогда
			Возврат;
		КонецЕсли;	
		
		НайтиСсылкуНаОбъект("Валюты", ДокументОбъект.ВалютаДокумента,
			ЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаКод"));
		ВидОперации = ЗначениеРеквизитаВДереве(ДеревоДанных, "ВидОперации");
		Если Не ЗначениеЗаполнено(ВидОперации) Тогда
			ВидОперации = Перечисления.ВидыОперацийЭД.ПродажаКомиссия;
		КонецЕсли;
		
		ДопТекстоваяИнформация = ДеревоДанных.Строки.Найти("ДопДанныеДокументаОтгрузки.ТекстоваяИнформация", "ПолныйПуть", Истина);
		Если ДопТекстоваяИнформация <> Неопределено Тогда
			Для Каждого СтрокаТекстовойИнформации Из ДопТекстоваяИнформация.Строки Цикл
				Если ЗначениеРеквизитаВДереве(СтрокаТекстовойИнформации, 
						"ДопДанныеДокументаОтгрузки.ТекстоваяИнформация.НомерСтроки.Идентификатор") = "ИдентификаторДокументаОснования" Тогда
					ИдентификаторДокументаОснованияЭДО = ЗначениеРеквизитаВДереве(СтрокаТекстовойИнформации,
						"ДопДанныеДокументаОтгрузки.ТекстоваяИнформация.НомерСтроки.Значение", Ложь);
					Если ЗначениеЗаполнено(ИдентификаторДокументаОснованияЭДО) Тогда
						ДокументОбъект.ИдентификаторДокументаОснованияЭДО = ИдентификаторДокументаОснованияЭДО;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;	
		КонецЕсли;
		
		// Сведения о поставщике.
		
		//2019
		СведенияОПродавце = ДеревоДанных.Строки.Найти("СведенияОПродавце", "ПолныйПуть");
		СведенияОПокупателе = ДеревоДанных.Строки.Найти("СведенияОПокупателе", "ПолныйПуть");
		ТекстОшибки = "";
		Если СведенияОПродавце.Строки.Количество() > 1 Тогда
			ТекстОшибки = НСтр("ru = 'загрузка сведений о нескольких продавцах не поддерживается.'");
		КонецЕсли;
		Если СведенияОПокупателе.Строки.Количество() > 1 Тогда
			ТекстОшибки = ?(ЗначениеЗаполнено(ТекстОшибки),ТекстОшибки+",","") + НСтр("ru = 'загрузка сведений о нескольких покупателях не поддерживается.'");
		КонецЕсли;
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			ДокументОбъект.Комментарий = НСтр("ru = 'Ошибка загрузки электронного документа: '") + ТекстОшибки;
		КонецЕсли;	
		
		ОсновнаяСтрокаПродавца = Неопределено;
		Для каждого СтрокаПродавца Из СведенияОПродавце.Строки Цикл
			ДокументОбъект.Контрагент = КонтрагентПоДаннымЭД(СтрокаПродавца, "СведенияОПродавце.НомерСтроки");
			ОсновнаяСтрокаПродавца = СтрокаПродавца;
			Прервать;
		КонецЦикла;
		Для каждого СтрокаПокупателя Из СведенияОПокупателе.Строки Цикл
			ДокументОбъект.Организация = ОрганизацияПоДаннымЭД(СтрокаПокупателя, "СведенияОПокупателе.НомерСтроки");
			Прервать;
		КонецЦикла;
		
		// Поиск и заполнения договора контрагента.
		ОснованияОтгрузки = ДеревоДанных.Строки.Найти("ОснованиеОтгрузкиТоваров", "ПолныйПуть");
		Если Не ОснованияОтгрузки = Неопределено Тогда
			ДоговорНайден = Ложь;
			Для Каждого СтрокаОснованиеОтгрузки Из ОснованияОтгрузки.Строки Цикл
				ДоговорНомер = ЗначениеРеквизитаВДереве(СтрокаОснованиеОтгрузки, "ОснованиеОтгрузкиТоваров.НомерСтроки.ДокументНомер");
				Если ЗначениеЗаполнено(ДоговорНомер) Тогда
					
					ДоговорДата = ДатаИзСтроки(ЗначениеРеквизитаВДереве(
						СтрокаОснованиеОтгрузки, 
						"ОснованиеОтгрузкиТоваров.НомерСтроки.ДокументДата"));
					
					СвойстваДоговора = Новый Структура("НомерДоговора, ДатаДоговора, Владелец, Организация", ДоговорНомер, ДоговорДата, ДокументОбъект.Контрагент, ДокументОбъект.Организация);
					
					Договор = Справочники.Договоры.ПустаяСсылка();
					НайтиСсылкуНаОбъект("ДоговорыКонтрагентов", Договор, , СвойстваДоговора);
					
					Если ЗначениеЗаполнено(Договор) Тогда
						ДокументОбъект.Договор = Договор;
						ДоговорНайден = Истина;
					КонецЕсли;
				КонецЕсли;
				Если ДоговорНайден Тогда
					Прервать;
				КонецЕсли;	
			КонецЦикла;
		КонецЕсли;
		
		Договор = ДоговорПоНастройкеЭДО(ДокументОбъект.Контрагент, ДокументОбъект.Организация);
		
		Если НЕ ЗначениеЗаполнено(ДокументОбъект.Договор) Тогда
			ДокументОбъект.Договор = Договор;
		КонецЕсли;	
		
		ДокументОбъект.СпособЗачетаАванса = Перечисления.СпособыЗачетаАвансов.Автоматически;
		
		НомерДокумента = ЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента");
		ДатаДокумента = ЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаДокумента");
		Если ВидПервичногоДокумента = "" Тогда
			ДокументОбъект.ВидПервичногоДокумента = "Акт об оказании услуг";
		Иначе	
			ДокументОбъект.ВидПервичногоДокумента = "Универсальный передаточный документ";
		КонецЕсли;
		ДокументОбъект.НомерПервичногоДокумента = НомерДокумента;
		ДокументОбъект.ДатаПервичногоДокумента = ДатаДокумента;
		
		ДокументОбъект.УслугиИРаботы.Очистить();
		ДокументОбъект.ЗачетАвансов.Очистить();
			
		// Сведения таблицы.
		СтрокаТаблицаТоваров = ДеревоДанных.Строки.Найти("СведенияОТоварах", "ПолныйПуть");
		Для Каждого Товар Из СтрокаТаблицаТоваров.Строки Цикл
			
			НоваяСтрока = ДокументОбъект.УслугиИРаботы.Добавить();
			
			// Обязательные реквизиты:
			СтавкаНДС = ЗначениеРеквизитаВДереве(Товар, "СведенияОТоварах.НомерСтроки.НалоговаяСтавка");
			
			Если СтавкаНДС = "НДС исчисляется налоговым агентом" Тогда
				СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;	
			КонецЕсли;	
			
			НоваяСтрока.СтавкаНДС = СтавкаНДС;
			НоваяСтрока.СуммаНДС = ЗначениеРеквизитаВДереве(Товар, "СведенияОТоварах.НомерСтроки.СуммаНалога");
			НоваяСтрока.Всего = ЗначениеРеквизитаВДереве(Товар, "СведенияОТоварах.НомерСтроки.СтоимостьТоваровСНалогом");
				
			// Необязательные реквизиты:
			НайтиСсылкуНаОбъект("ЕдиницыИзмерения", НоваяСтрока.ЕдиницаИзмерения,
				ЗначениеРеквизитаВДереве(Товар, "СведенияОТоварах.НомерСтроки.ЕдиницаИзмеренияКод"));
			НоваяСтрока.Количество = ЗначениеРеквизитаВДереве(Товар, "СведенияОТоварах.НомерСтроки.Количество");
			НоваяСтрока.Сумма = ЗначениеРеквизитаВДереве(Товар, "СведенияОТоварах.НомерСтроки.СтоимостьТоваровБезНалога");
			
			// Сопоставление
			СведенияОТоваре = Товар;
			
			Сопоставление = СведенияОТоваре.Строки.Найти(
				"СведенияОТоварах.НомерСтроки.Сопоставление", "ПолныйПуть", Истина);
			Если Сопоставление <> Неопределено Тогда
				
				Идентификатор = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.Идентификатор");
				Если ЗначениеЗаполнено(Идентификатор) Тогда
					НоваяСтрока.ИдентификаторПоставщика = Идентификатор;
				КонецЕсли;
				
				Номенклатура = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.НоменклатураИБ");
				Если ЗначениеЗаполнено(Номенклатура) Тогда
					НоваяСтрока.Номенклатура = Номенклатура;
				КонецЕсли;
				
				ЕдиницаИзмерения = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.УпаковкаИБ");
				Если ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
					НоваяСтрока.ЕдиницаИзмерения = ЕдиницаИзмерения;
				КонецЕсли;
				
			КонецЕсли;
			
			// Заполним номенклатуру поставщика
			
		КонецЦикла;
		
		ДокументОбъект.СуммаДокумента = ЗначениеРеквизитаВДереве(ДеревоДанных,
			"ВсегоКОплате.ВсегоСтоимостьТоваровСНалогом");
		
		ДокументОбъект.ДополнительныеСвойства.Вставить("ЕстьСоглашение", Истина);
		ДокументОбъект.ДополнительныеСвойства.Вставить("ПроцессыОбработкиДокументов_ЗаписатьБезПроверкиОбменДаннымиЗагрузка", Истина);
		Если Записывать Тогда
			Если НЕ ЗначениеЗаполнено(ДокументОбъект.Номер) Тогда
				ДокументОбъект.УстановитьНовыйНомер();
			КонецЕсли;
			ДокументОбъект.Записать(РежимЗаписи);
			СсылкаНаВладельца = ДокументОбъект.Ссылка;
		Иначе // если функция вызвана из формы "Обработки.ОбменСКонтрагентами.ФормаЗагрузкиПросмотраЭД"
			СсылкаНаВладельца = ДокументОбъект;
		КонецЕсли;
		
	Исключение
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Заполнение документа на основе ЭД. %1'"), Текст)
			+ Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ВыполнитьЗаписьСобытияПоЭДВЖурналРегистрации(ТекстСообщения,
			2, УровеньЖурналаРегистрации.Ошибка, ДокументОбъект.Метаданные(), СсылкаНаВладельца);
		ВызватьИсключение(Текст);
	КонецПопытки;
	
КонецПроцедуры

Процедура НайтиСоздатьУПДДокументОПередачеТоваров_2019(ДеревоДанных, СсылкаНаВладельца = Неопределено, Записывать = Истина, ВидПервичногоДокумента = "")
	
	РежимЗаписи = РежимЗаписиДокумента.Запись;
	Попытка
		Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
			ДокументОбъект = СсылкаНаВладельца.ПолучитьОбъект();
			Если ДокументОбъект.Проведен Тогда
				Текст = НСтр("ru = 'Операция возможна только для непроведенных документов!'");
			КонецЕсли;
		Иначе
			УстановитьПривилегированныйРежим(Истина);
			ДокументОбъект = Документы.ЭлектронныйДокументПоставщика.СоздатьДокумент();
			ДокументОбъект.Дата = ТекущаяДатаСеанса();
		КонецЕсли;
		ДокументОбъект.ОбменДанными.Загрузка = Истина;
		
		ДокументИзЕИС = ЭлектронныйДокументИзЕИС(ДеревоДанных);
		ДокументОбъект.ЗагруженИзЕИС = ДокументИзЕИС;
		Если ДокументИзЕИС Тогда
			Если АктОПриемкеВыполненныхРаботИзЕИС(ДеревоДанных)	Тогда
				ВидПервичногоДокумента = НСтр("ru = 'Акт о приемке выполненных работ'");
			КонецЕсли;	
		КонецЕсли;	
		
		ТаблицаИдентификаторовНоменклатурыЕИС = Новый ТаблицаЗначений;
		Если ДокументИзЕИС Тогда
			ДанныеПриложенияЕИС = ЗначениеРеквизитаВДереве(ДеревоДанных, "ДанныеЭлектронногоАктированияЕИС.ДанныеПриложения", Ложь);
			Если ТипЗнч(ДанныеПриложенияЕИС) = Тип("Структура") Тогда
				ТаблицаИдентификаторовНоменклатурыЕИС = ДанныеПриложенияЕИС.ТаблицаИдентификаторовНоменклатуры;
			КонецЕсли;
		КонецЕсли;	
		
		НайтиСсылкуНаОбъект("Валюты", ДокументОбъект.ВалютаДокумента,
			ЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаКод"));
		ВидОперации = ЗначениеРеквизитаВДереве(ДеревоДанных, "ВидОперации");
		Если Не ЗначениеЗаполнено(ВидОперации) Тогда
			ВидОперации = Перечисления.ВидыОперацийЭД.ПродажаКомиссия;
		КонецЕсли;
		
		ДокументОбъект.ТипФорматаЭД = 0;		
		
		ДопТекстоваяИнформация = ДеревоДанных.Строки.Найти("ДопДанныеДокументаОтгрузки.ТекстоваяИнформация", "ПолныйПуть", Истина);
		Если ДопТекстоваяИнформация <> Неопределено Тогда
			Для Каждого СтрокаТекстовойИнформации Из ДопТекстоваяИнформация.Строки Цикл
				Если ЗначениеРеквизитаВДереве(СтрокаТекстовойИнформации, 
						"ДопДанныеДокументаОтгрузки.ТекстоваяИнформация.НомерСтроки.Идентификатор") = "ИдентификаторДокументаОснования" Тогда
					ИдентификаторДокументаОснованияЭДО = ЗначениеРеквизитаВДереве(СтрокаТекстовойИнформации,
						"ДопДанныеДокументаОтгрузки.ТекстоваяИнформация.НомерСтроки.Значение");
					Если ЗначениеЗаполнено(ИдентификаторДокументаОснованияЭДО) Тогда
						ДокументОбъект.ИдентификаторДокументаОснованияЭДО = ИдентификаторДокументаОснованияЭДО;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;	
		КонецЕсли;
		
		// Сведения о поставщике.
		
		//2019
		СведенияОПродавце = ДеревоДанных.Строки.Найти("СведенияОПродавце", "ПолныйПуть");
		СведенияОПокупателе = ДеревоДанных.Строки.Найти("СведенияОПокупателе", "ПолныйПуть");
		СведенияОГрузополучателе = ДеревоДанных.Строки.Найти("СведенияОГрузополучателе", "ПолныйПуть");
		ТекстОшибки = "";
		Если СведенияОПродавце.Строки.Количество() > 1 Тогда
			ТекстОшибки = НСтр("ru = 'загрузка сведений о нескольких продавцах не поддерживается.'");
		КонецЕсли;
		Если СведенияОПокупателе.Строки.Количество() > 1 Тогда
			ТекстОшибки = ?(ЗначениеЗаполнено(ТекстОшибки), ТекстОшибки+",", "") + НСтр("ru = 'загрузка сведений о нескольких покупателях не поддерживается.'");
		КонецЕсли;
		Если СведенияОГрузополучателе.Строки.Количество() > 1 Тогда
			ТекстОшибки = ?(ЗначениеЗаполнено(ТекстОшибки), ТекстОшибки+",", "") + НСтр("ru = 'загрузка сведений о нескольких грузополучателях не поддерживается.'");
		КонецЕсли;
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			ДокументОбъект.Комментарий = НСтр("ru = 'Ошибка загрузки электронного документа: '") + ТекстОшибки;
		КонецЕсли;	
		
		ОсновнаяСтрокаПродавца = Неопределено;
		Для каждого СтрокаПродавца Из СведенияОПродавце.Строки Цикл
			ДокументОбъект.Контрагент = КонтрагентПоДаннымЭД(СтрокаПродавца, "СведенияОПродавце.НомерСтроки");
			ОсновнаяСтрокаПродавца = СтрокаПродавца;
			Прервать;
		КонецЦикла;
		Для каждого СтрокаГрузополучателя Из СведенияОГрузополучателе.Строки Цикл
			ДокументОбъект.Грузополучатель = КонтрагентПоДаннымЭД(СтрокаГрузополучателя, "СведенияОГрузополучателе.НомерСтроки");
			Прервать;
		КонецЦикла;
		Для каждого СтрокаПокупателя Из СведенияОПокупателе.Строки Цикл
			ДокументОбъект.Организация = ОрганизацияПоДаннымЭД(СтрокаПокупателя, "СведенияОПокупателе.НомерСтроки");
			Прервать;
		КонецЦикла;
		
		// Поиск и заполнения договора контрагента.
		Договор = Справочники.Договоры.ПустаяСсылка();
		ОснованияОтгрузки = ДеревоДанных.Строки.Найти("ОснованиеОтгрузкиТоваров", "ПолныйПуть");
		Если Не ОснованияОтгрузки = Неопределено Тогда
			ДоговорНайден = Ложь;
			Для Каждого СтрокаОснованиеОтгрузки Из ОснованияОтгрузки.Строки Цикл
				ДоговорНомер = ЗначениеРеквизитаВДереве(СтрокаОснованиеОтгрузки, "ОснованиеОтгрузкиТоваров.НомерСтроки.ДокументНомер");
				Если ЗначениеЗаполнено(ДоговорНомер) Тогда
					
					ДоговорДата = ДатаИзСтроки(ЗначениеРеквизитаВДереве(
						СтрокаОснованиеОтгрузки, 
						"ОснованиеОтгрузкиТоваров.НомерСтроки.ДокументДата"));
					
					СвойстваДоговора = Новый Структура("НомерДоговора, ДатаДоговора, Владелец, Организация", ДоговорНомер, ДоговорДата, ДокументОбъект.Контрагент, ДокументОбъект.Организация);
					
					Договор = Справочники.Договоры.ПустаяСсылка();
					НайтиСсылкуНаОбъект("ДоговорыКонтрагентов", Договор, , СвойстваДоговора);
					Если ЗначениеЗаполнено(Договор) Тогда
						ДоговорНайден = Истина;
					КонецЕсли;	
				КонецЕсли;
				Если ДоговорНайден Тогда 
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Договор) Тогда
			Договор = ДоговорПоНастройкеЭДО(ДокументОбъект.Контрагент, ДокументОбъект.Организация);
		КонецЕсли;
		
		ДокументОбъект.Договор = Договор;
		
		НомерДокумента = ЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента");
		ДатаДокумента = ЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаДокумента");
		
		Если ЗначениеЗаполнено(ВидПервичногоДокумента) Тогда
			ДокументОбъект.ВидПервичногоДокумента = ВидПервичногоДокумента;
		Иначе	
			ДокументОбъект.ВидПервичногоДокумента = "Универсальный передаточный документ";
		КонецЕсли;
		ДокументОбъект.НомерПервичногоДокумента = НомерДокумента;
		ДокументОбъект.ДатаПервичногоДокумента = ДатаДокумента;
		
		ДокументОбъект.СписокНоменклатуры.Очистить();
		ДокументОбъект.СведенияПрослеживаемости.Очистить();
		ДокументОбъект.КодыУпаковокМаркируемойПродукции.Очистить();
		
		// Сведения таблицы.
		НомерПоПорядку = 0;
		СтрокаТаблицаТоваров = ДеревоДанных.Строки.Найти("СведенияОТоварах", "ПолныйПуть");
		Для Каждого Товар Из СтрокаТаблицаТоваров.Строки Цикл
			НомерПоПорядку = НомерПоПорядку + 1;
			
			ЭтоВозвратнаяТара = Ложь;
			Признак = ЗначениеРеквизитаВДереве(Товар, "СведенияОТоварах.НомерСтроки.Признак");
			ПризнакДополнительнаяИнформация = ЗначениеРеквизитаВДереве(Товар, "СведенияОТоварах.НомерСтроки.ПризнакДополнительнаяИнформация");
			
			Если Признак = "3" Тогда
				//услуги (признак БП)
				НоваяСтрока = ДокументОбъект.СписокНоменклатуры.Добавить();
				НоваяСтрока.ПризнакНоменклатуры = Признак;
			ИначеЕсли Признак = "4" Тогда
				//ПО (признак БП)
				НоваяСтрока = ДокументОбъект.СписокНоменклатуры.Добавить();
				НоваяСтрока.ПризнакНоменклатуры = Признак;
			ИначеЕсли (Признак = "1" И ПризнакДополнительнаяИнформация = "ВТ") Тогда
				//Возвратная тара 
				ЭтоВозвратнаяТара = Истина;
				НоваяСтрока = ДокументОбъект.СписокНоменклатуры.Добавить();
				НоваяСтрока.ПризнакНоменклатуры = "1ВТ";
			Иначе
				НоваяСтрока = ДокументОбъект.СписокНоменклатуры.Добавить();
				НоваяСтрока.ПризнакНоменклатуры = Признак;
			КонецЕсли;
			
			// Обязательные реквизиты:
			СтавкаНДС = ЗначениеРеквизитаВДереве(Товар, "СведенияОТоварах.НомерСтроки.НалоговаяСтавка");
			
			Если СтавкаНДС = "НДС исчисляется налоговым агентом" Тогда
				СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;	
			КонецЕсли;	
			
			НоваяСтрока.СтавкаНДС = СтавкаНДС;
			НоваяСтрока.СуммаНДС = ЗначениеРеквизитаВДереве(Товар, "СведенияОТоварах.НомерСтроки.СуммаНалога");
			НоваяСтрока.Всего = ЗначениеРеквизитаВДереве(Товар, "СведенияОТоварах.НомерСтроки.СтоимостьТоваровСНалогом");
			
			// Необязательные реквизиты:
			ЕдиницаИзмеренияКод = ЗначениеРеквизитаВДереве(Товар, "СведенияОТоварах.НомерСтроки.ЕдиницаИзмеренияКод");
			НайтиСсылкуНаОбъект("ЕдиницыИзмерения", НоваяСтрока.ЕдиницаИзмерения, ЕдиницаИзмеренияКод);
			НоваяСтрока.ЕдиницаИзмеренияКод = ЕдиницаИзмеренияКод;
			
			НоваяСтрока.Количество = ЗначениеРеквизитаВДереве(Товар, "СведенияОТоварах.НомерСтроки.Количество");
			НоваяСтрока.Сумма = ЗначениеРеквизитаВДереве(Товар, "СведенияОТоварах.НомерСтроки.СтоимостьТоваровБезНалога");
			
			Если (НоваяСтрока.Количество = 0) ИЛИ (НоваяСтрока.Количество = Неопределено) Тогда
				НоваяСтрока.Количество = 1;
				Если (НоваяСтрока.Цена = 0) ИЛИ (НоваяСтрока.Цена = Неопределено) Тогда
					НоваяСтрока.Цена = НоваяСтрока.Сумма;
				КонецЕсли;	
			Иначе	
				НоваяСтрока.Цена = НоваяСтрока.Сумма/НоваяСтрока.Количество;
			КонецЕсли;
			
			ЭлектронныеДокументыБГУКлиентСервер.ЗаполнитьИдентификаторСтроки(НоваяСтрока);
			ЗаполнитьКодыМаркировкиИзДереваЭлектронногоДокумента(ДокументОбъект, НоваяСтрока, Товар);
			ЗаполнитьНомераПрослеживаемостиИзДереваЭлектронногоДокумента(ДокументОбъект, НоваяСтрока, Товар);
			
			
			КодВидаТовара = ЗначениеРеквизитаВДереве(Товар, "СведенияОТоварах.НомерСтроки.КодВидаТовара");
			НоваяСтрока.КодВидаТовара = КодВидаТовара;
			
			ТаблицаДеклараций = ЗначениеРеквизитаВДереве(Товар, "СведенияОТоварах.НомерСтроки.СведенияОТаможеннойДекларации");
			
			СтранаПроисхожденияКод = "";
			ТаблицаДеклараций = Товар.Строки.Найти("СведенияОТоварах.НомерСтроки.СведенияОТаможеннойДекларации", "ПолныйПуть");
			Для Каждого Декларация Из ТаблицаДеклараций.Строки Цикл
				СтранаПроисхожденияКод = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(Декларация,"СведенияОТоварах.НомерСтроки.СведенияОТаможеннойДекларации.НомерСтроки.СтранаПроисхожденияКод");	
				Если ЗначениеЗаполнено(СтранаПроисхожденияКод) Тогда
					НайденнаяСсылкаСтрана = Справочники.СтраныМира.НайтиПоКоду(СтранаПроисхожденияКод);
					Если НЕ НайденнаяСсылкаСтрана = Справочники.СтраныМира.ПустаяСсылка() Тогда
						НоваяСтрока.СтранаПроисхождения = НайденнаяСсылкаСтрана;
					КонецЕсли;	
				КонецЕсли;	
			КонецЦикла;	
			
			Если НЕ ЗначениеЗаполнено(НоваяСтрока.СтранаПроисхождения) Тогда
				СтранаПроисхожденияНаименование = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(Товар,
					"СведенияОТоварах.НомерСтроки.СтранаПроисхожденияНаименование");
				Если ЗначениеЗаполнено(СтранаПроисхожденияНаименование) Тогда
					НайденнаяСсылкаСтрана = Справочники.СтраныМира.НайтиПоНаименованию(СтранаПроисхожденияНаименование);
					Если НЕ НайденнаяСсылкаСтрана = Справочники.СтраныМира.ПустаяСсылка() Тогда
						НоваяСтрока.СтранаПроисхождения = НайденнаяСсылкаСтрана;
					КонецЕсли;	
				КонецЕсли;
			КонецЕсли;
			
			// Сопоставление
			СведенияОТоваре = Товар;
			
			Сопоставление = СведенияОТоваре.Строки.Найти(
				"СведенияОТоварах.НомерСтроки.Сопоставление", "ПолныйПуть", Истина);
			Если Сопоставление <> Неопределено Тогда
				
				Идентификатор = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.Идентификатор");
				Если ЗначениеЗаполнено(Идентификатор) Тогда
					НоваяСтрока.ИдентификаторПоставщика = Идентификатор;
				КонецЕсли;
				
				Номенклатура = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.НоменклатураИБ");
				Если ЗначениеЗаполнено(Номенклатура) Тогда
					НоваяСтрока.Номенклатура = Номенклатура;
				КонецЕсли;
				
				ЕдиницаИзмерения = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.УпаковкаИБ");
				Если ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
					НоваяСтрока.ЕдиницаИзмерения = ЕдиницаИзмерения;
				КонецЕсли;
				
			КонецЕсли;
			
			Если ДокументИзЕИС Тогда
				Если НЕ ТаблицаИдентификаторовНоменклатурыЕИС = Неопределено Тогда
					ПараметрыОтбора = Новый Структура;
					ПараметрыОтбора.Вставить("НомерСтроки", НомерПоПорядку);
					
					НайденныеСтроки = ТаблицаИдентификаторовНоменклатурыЕИС.НайтиСтроки(ПараметрыОтбора);
					Если НайденныеСтроки.Количество()>0 Тогда
						НоваяСтрока.ИдентификаторНоменклатурыЕИС = НайденныеСтроки[0].Идентификатор;
						НоваяСтрока.ВнешнийИдентификаторЕИС = НайденныеСтроки[0].ВнешнийИдентификатор;
						НоваяСтрока.ТехническийИдентификаторЕИС = Формат(НайденныеСтроки[0].ТехническийИдентификатор,"ЧГ=");
					КонецЕсли;	
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		ДокументОбъект.СуммаДокумента = ЗначениеРеквизитаВДереве(ДеревоДанных,
			"ВсегоКОплате.ВсегоСтоимостьТоваровСНалогом");

		ДокументОбъект.СведенияОВыбытииМаркированныхТоваров = ЗначениеРеквизитаВДереве(ДеревоДанных,
			"СведенияОВыбытииМаркированныхТоваров");
		
		//Запись реквизитов прослеживаемости в справочники
		Для Каждого ТекНоменклатура Из ДокументОбъект.СписокНоменклатуры Цикл
			Если ТекНоменклатура.ПрослеживаемыйТовар Тогда
				НоменклатураСпискаСсылка = ТекНоменклатура.Номенклатура;
				Если ЗначениеЗаполнено(НоменклатураСпискаСсылка) Тогда
					Если ТипЗнч(НоменклатураСпискаСсылка) = Тип("СправочникСсылка.Номенклатура")
						ИЛИ ТипЗнч(НоменклатураСпискаСсылка) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
						НоменклатураСпискаОбъект = НоменклатураСпискаСсылка.ПолучитьОбъект();
						НоменклатураСпискаОбъект.ПрослеживаемыйТовар = Истина;
						Если ЗначениеЗаполнено(ТекНоменклатура.КодВидаТовара) Тогда
							КодТНВЭД = Справочники.КлассификаторТНВЭД.НайтиПоКоду(ТекНоменклатура.КодВидаТовара);
							НоменклатураСпискаОбъект.КодТНВЭД = КодТНВЭД;
						КонецЕсли;
						НоменклатураСпискаОбъект.СтранаПроисхождения = ТекНоменклатура.СтранаПроисхождения;
						
						НоменклатураСпискаОбъект.Записать();
					КонецЕсли;
				КонецЕсли;	
			КонецЕсли;	
		КонецЦикла;	
		
		ДокументОбъект.ДополнительныеСвойства.Вставить("ЕстьСоглашение", Истина);
		ДокументОбъект.ДополнительныеСвойства.Вставить("ПроцессыОбработкиДокументов_ЗаписатьБезПроверкиОбменДаннымиЗагрузка", Истина);
		Если Записывать Тогда
			Если НЕ ЗначениеЗаполнено(ДокументОбъект.Номер) Тогда
				ДокументОбъект.УстановитьНовыйНомер();
			КонецЕсли;
			ДокументОбъект.Записать(РежимЗаписи);
			СсылкаНаВладельца = ДокументОбъект.Ссылка;
		Иначе // если функция вызвана из формы "Обработки.ОбменСКонтрагентами.ФормаЗагрузкиПросмотраЭД"
			СсылкаНаВладельца = ДокументОбъект;
		КонецЕсли;
		
		//ЭПД
		ПроверитьУстановитьСвязьЭТрН(СсылкаНаВладельца);
		
		//Заполнение документа-основания 
		МассивДокОснований = Новый Массив;
		Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
			МассивДокОснований.Добавить(СсылкаНаВладельца);
		КонецЕсли;
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияСчетаФактуры", МассивДокОснований);
		
	Исключение
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Заполнение документа на основе ЭД. %1'"), Текст)
			+ Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ВыполнитьЗаписьСобытияПоЭДВЖурналРегистрации(ТекстСообщения,
			2, УровеньЖурналаРегистрации.Ошибка, ДокументОбъект.Метаданные(), СсылкаНаВладельца);
		ВызватьИсключение(Текст);
	КонецПопытки;
	
КонецПроцедуры

Процедура НайтиСоздатьУПДИсправительныйСчетФактуру_2019(ДеревоДанных, СсылкаНаВладельца = Неопределено, Записывать = Истина, ИсправлениеСФ = "СФ")  Экспорт

	ДанныеЗаполненияШапки = Новый Структура;
	
	ДанныеЗаполненияШапки.Вставить("ДатаПолучения", ТекущаяДатаСеанса());
	
	НомерДок = ЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента");
	ДатаДок = ЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаДокумента");
	
	ДанныеЗаполненияШапки.Вставить("НомерСчетаФактуры", НомерДок);
	ДанныеЗаполненияШапки.Вставить("ДатаСчетаФактуры", ДатаДок);
	
	ДанныеЗаполненияШапки.Вставить("НомерИсправления", ЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсправления"));
	ДанныеЗаполненияШапки.Вставить("ДатаИсправления", ЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаИсправления"));
	
	ДанныеЗаполненияШапки.Вставить("НомерИсходногоДокумента",
		ЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента"));
	ДанныеЗаполненияШапки.Вставить("ДатаИсходногоДокумента",
		ЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаДокумента"));
	
	ВалКод = ЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаКод");
	Если НЕ ВалКод = "643" Тогда
		ДанныеЗаполненияШапки.Вставить("ВИностраннойВалюте", Истина);
	КонецЕсли;
	Валюта = Справочники.Валюты.ПустаяСсылка();
	НайтиСсылкуНаОбъект("Валюты", Валюта, ВалКод);
	ДанныеЗаполненияШапки.Вставить("ВалютаДокумента", Валюта);
	
	// Сведения о поставщике.
	
	//2019
	СведенияОПродавце = ДеревоДанных.Строки.Найти("СведенияОПродавце", "ПолныйПуть");
	СведенияОПокупателе = ДеревоДанных.Строки.Найти("СведенияОПокупателе", "ПолныйПуть");
	ТекстОшибки = "";
	Если СведенияОПродавце.Строки.Количество() > 1 Тогда
		ТекстОшибки = НСтр("ru = 'загрузка сведений о нескольких продавцах не поддерживается.'");
	КонецЕсли;
	Если СведенияОПокупателе.Строки.Количество() > 1 Тогда
		ТекстОшибки = ?(ЗначениеЗаполнено(ТекстОшибки),ТекстОшибки+",","") + НСтр("ru = 'загрузка сведений о нескольких покупателях не поддерживается.'");
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Комментарий = НСтр("ru = 'Ошибка загрузки электронного документа: '") + ТекстОшибки;
		ДанныеЗаполненияШапки.Вставить("Комментарий", Комментарий);
	КонецЕсли;	
	
	Контрагент = Справочники.Контрагенты.ПустаяСсылка();
	ОсновнаяСтрокаПродавца = Неопределено;
	Для каждого СтрокаПродавца Из СведенияОПродавце.Строки Цикл
		Контрагент = КонтрагентПоДаннымЭД(СтрокаПродавца, "СведенияОПродавце.НомерСтроки");
		ОсновнаяСтрокаПродавца = СтрокаПродавца;
		Прервать;
	КонецЦикла;
	ДанныеЗаполненияШапки.Вставить("Контрагент", Контрагент);
	Организация = Справочники.Организации.ПустаяСсылка();
	Для каждого СтрокаПокупателя Из СведенияОПокупателе.Строки Цикл
		Организация = ОрганизацияПоДаннымЭД(СтрокаПокупателя, "СведенияОПокупателе.НомерСтроки");
		Прервать;
	КонецЦикла;
	ДанныеЗаполненияШапки.Вставить("Организация", Организация);
	
	// Поиск и заполнения договора контрагента.
	Договор = Справочники.Договоры.ПустаяСсылка();
	
	ОснованияОтгрузки = ДеревоДанных.Строки.Найти("ОснованиеОтгрузкиТоваров", "ПолныйПуть");
	Если Не ОснованияОтгрузки = Неопределено Тогда
		ДоговорНайден = Ложь;
		Для Каждого СтрокаОснованиеОтгрузки Из ОснованияОтгрузки.Строки Цикл
			ДоговорНомер = ЗначениеРеквизитаВДереве(СтрокаОснованиеОтгрузки, "ОснованиеОтгрузкиТоваров.НомерСтроки.ДокументНомер");
			Если ЗначениеЗаполнено(ДоговорНомер) Тогда
				
				ДоговорДата = ДатаИзСтроки(ЗначениеРеквизитаВДереве(
					СтрокаОснованиеОтгрузки, 
					"ОснованиеОтгрузкиТоваров.НомерСтроки.ДокументДата"));
				
				СвойстваДоговора = Новый Структура("НомерДоговора, ДатаДоговора, Владелец, Организация", ДоговорНомер, ДоговорДата, Контрагент, Организация);
				
				Договор = Справочники.Договоры.ПустаяСсылка();
				НайтиСсылкуНаОбъект("ДоговорыКонтрагентов", Договор, , СвойстваДоговора);
				Если ЗначениеЗаполнено(Договор) Тогда
					ДоговорНайден = Истина;
				КонецЕсли;	
			КонецЕсли;
			Если ДоговорНайден Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(Договор) Тогда
		Договор = ДоговорПоНастройкеЭДО(Контрагент, Организация);
	КонецЕсли;
	
	ДанныеЗаполненияШапки.Вставить("Договор", Договор);
	
	ДанныеЗаполненияШапки.Вставить("СуммаДокумента", ЗначениеРеквизитаВДереве(ДеревоДанных,
		"ВсегоКОплате.ВсегоСтоимостьТоваровСНалогом"));
	ДанныеЗаполненияШапки.Вставить("СуммаНДС", ЗначениеРеквизитаВДереве(ДеревоДанных,
		"ВсегоКОплате.ВсегоСуммаНалога"));
	
	ВидСчетаФактуры = ЗначениеРеквизитаВДереве(ДеревоДанных, "ВидСчетаФактуры");
	Если ВидСчетаФактуры = "Авансовый" Тогда
		ДанныеЗаполненияШапки.Вставить("КодВидаОперации", "02");
		ДанныеЗаполненияШапки.Вставить("ПричинаНалогообложения", Перечисления.ПричиныНалогообложенияНДС.АвансВыданный);
	Иначе
		ДанныеЗаполненияШапки.Вставить("КодВидаОперации", "01");
		ДанныеЗаполненияШапки.Вставить("ПричинаНалогообложения", Перечисления.ПричиныНалогообложенияНДС.Покупка);
	КонецЕсли;	
		
	ДанныеЗаполненияШапки.Вставить("КодСпособаВыставления", 2);
	
	СведенияОТоварах = ДеревоДанных.Строки.Найти("СведенияОТоварах", "ПолныйПуть").Строки;
	
	Если ЗначениеЗаполнено(СведенияОТоварах) Тогда
		ТаблицаТоваров = Документы.ИсправительныйСчетФактураПолученный.ПустаяСсылка().СоставНФА.ВыгрузитьКолонки();
		Для Каждого ТекТовар Из СведенияОТоварах Цикл
			СтрокаТаблицы = ТаблицаТоваров.Добавить();
			Если ИсправлениеСФ = "СФ" Тогда
				ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка();
				НайтиСсылкуНаОбъект("ЕдиницыИзмерения", ЕдиницаИзмерения,
					ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.ЕдиницаИзмеренияКод"));
				СтрокаТаблицы.ЕдиницаИзмерения = ЕдиницаИзмерения;
				СтрокаТаблицы.Количество = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.Количество");
				СтрокаТаблицы.Сумма = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.СтоимостьТоваровБезНалога");
				
				СтавкаНДС = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.НалоговаяСтавка");
				
				Если СтавкаНДС = "НДС исчисляется налоговым агентом" Тогда
					СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;	
				КонецЕсли;	
				
				СтрокаТаблицы.СтавкаНДС = СтавкаНДС;
				СтрокаТаблицы.СуммаНДС = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.СуммаНалога");
				СтрокаТаблицы.Всего = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.СтоимостьТоваровСНалогом");
				
				СтрокаТаблицы.СуммаАкциза = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.СуммаАкциза");
			Иначе
				ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка();
				НайтиСсылкуНаОбъект("ЕдиницыИзмерения", ЕдиницаИзмерения,
					ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.ЕдиницаИзмеренияКод"));
				
				СтрокаТаблицы.ЕдиницаИзмерения = ЕдиницаИзмерения;
				СтрокаТаблицы.КоличествоДоКорректировки = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.КоличествоДоКорректировки");
				СтрокаТаблицы.КоличествоДоИзменения = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.Количество");
				СтрокаТаблицы.СуммаДоКорректировки = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.СтоимостьТоваровБезНалогаДоКорректировки");
				СтрокаТаблицы.Сумма = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.СтоимостьТоваровБезНалога");
				СтрокаТаблицы.СтавкаНДСДоКорректировки = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.НалоговаяСтавкаДоКорректировки");
				
				СтавкаНДС = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.НалоговаяСтавка");
				
				Если СтавкаНДС = "НДС исчисляется налоговым агентом" Тогда
					СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;	
				КонецЕсли;	
				
				СтрокаТаблицы.СтавкаНДС = СтавкаНДС;
				СтрокаТаблицы.СуммаНДСДоКорректировки = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.СуммаНалогаДоКорректировки");
				СтрокаТаблицы.СуммаНДС = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.СуммаНалога");
				СтрокаТаблицы.ВсегоДоКорректировки = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.СтоимостьТоваровСНалогомДоКорректировки");
				СтрокаТаблицы.Всего = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.СтоимостьТоваровСНалогом");
				
				СтрокаТаблицы.СуммаАкцизаДоКорректировки	= ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.СуммаАкцизаДоКорректировки");
				СтрокаТаблицы.СуммаАкциза					= ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.СуммаАкциза");
				СтрокаТаблицы.СуммаАкцизаУвеличение			= ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.СуммаАкцизаУвеличение");
				СтрокаТаблицы.СуммаАкцизаУменьшение			= ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.СуммаАкцизаУменьшение");
			КонецЕсли;
			
			// Сопоставление
			СведенияОТоваре = ТекТовар;
			
			Сопоставление = СведенияОТоваре.Строки.Найти(
				"СведенияОТоварах.НомерСтроки.Сопоставление", "ПолныйПуть", Истина);
			Если Сопоставление <> Неопределено Тогда
				
				Идентификатор = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.Идентификатор");
				Если ЗначениеЗаполнено(Идентификатор) Тогда
					ИдентификаторПоставщика = Идентификатор;
				КонецЕсли;
				
				Номенклатура = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.НоменклатураИБ");
				Если ЗначениеЗаполнено(Номенклатура) Тогда
					СтрокаТаблицы.НФА = Номенклатура;
				КонецЕсли;
				
				ЕдиницаИзмерения = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.УпаковкаИБ");
				Если ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
					СтрокаТаблицы.ЕдиницаИзмерения = ЕдиницаИзмерения;
				КонецЕсли;
				
			КонецЕсли;
			
			// Заполним номенклатуру поставщика
		КонецЦикла;
	КонецЕсли;
	ДанныеЗаполненияШапки.Вставить("СоставНФА", ТаблицаТоваров);
	
	РежимЗаписи = РежимЗаписиДокумента.Запись;
	Попытка
		Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
			ДокументОбъект = СсылкаНаВладельца.ПолучитьОбъект();
			Если ДокументОбъект.Проведен Тогда 
				Текст = НСтр("ru = 'Операция возможна только для непроведенных документов!'");
			КонецЕсли;
		Иначе
			УстановитьПривилегированныйРежим(истина);
			ДокументОбъект = Документы.ИсправительныйСчетФактураПолученный.СоздатьДокумент();
			ДокументОбъект.Дата = ТекущаяДатаСеанса();
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(ДокументОбъект, ДанныеЗаполненияШапки);
		ДокументОбъект.ОбменДанными.Загрузка = Истина;
		ДокументОбъект.ДополнительныеСвойства.Вставить("ЕстьСоглашение", Истина);
		
		СчетФактураПолученный = ОпределитьСчетФактуруПолученый(ДокументОбъект,
			ДанныеЗаполненияШапки.Организация, 
			ДанныеЗаполненияШапки.НомерИсходногоДокумента,
			ДанныеЗаполненияШапки.ДатаИсходногоДокумента);
			
		Если ЗначениеЗаполнено(СчетФактураПолученный) Тогда
			ДокументОбъект.ДокументОснование = СчетФактураПолученный;
			ДокументОбъект.Договор = СчетФактураПолученный.Договор;
			ДокументОбъект.ИсправляемыйДокумент = СчетФактураПолученный;
			Если ТипЗнч(СчетФактураПолученный) = Тип("ДокументСсылка.ИсправительныйСчетФактураПолученный") Тогда
				ДокументОбъект.ИсправляемыйДокумент = СчетФактураПолученный.ИсправляемыйДокумент;
				ДатаИсправляемогоСчетаФактуры = ДокументОбъект.ИсправляемыйДокумент.Дата;
			ИначеЕсли ТипЗнч(СчетФактураПолученный) = Тип("ДокументСсылка.КорректировочныйСчетФактураПолученный") Тогда
				ДатаИсправляемогоСчетаФактуры = СчетФактураПолученный.ИсправляемыйДокумент.Дата;
			ИначеЕсли ТипЗнч(СчетФактураПолученный) = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
				ДатаИсправляемогоСчетаФактуры = СчетФактураПолученный.Дата;
			КонецЕсли;	
			ДокументОбъект.ПричинаНалогообложения = СчетФактураПолученный.ПричинаНалогообложения;
			ДокументОбъект.ВариантРегистрации = Перечисления.ВариантыРегистрацииДляКорректирующихСФ.ВКнигеПродажПокупок;
			НачалоКварталаДляДокумента = НачалоКвартала(ДокументОбъект.Дата);
			Если ДатаИсправляемогоСчетаФактуры < НачалоКварталаДляДокумента Тогда
				ДокументОбъект.ВариантРегистрации = Перечисления.ВариантыРегистрацииДляКорректирующихСФ.ВДопЛистахКнигПродажПокупок;
				ДокументОбъект.КорректируемыйПериод = ДатаИсправляемогоСчетаФактуры;
			КонецЕсли;	
		КонецЕсли;		
		
		ДокументОбъект.СоставНФА.Очистить();
		Если ДанныеЗаполненияШапки.Свойство("СоставНФА") И ЗначениеЗаполнено(ДанныеЗаполненияШапки.СоставНФА) Тогда
			ДозаполнитьСторноИсправительногоСчетаФактурыПолученного(ДанныеЗаполненияШапки.СоставНФА, СчетФактураПолученный, ИсправлениеСФ);
			ДокументОбъект.СоставНФА.Загрузить(ДанныеЗаполненияШапки.СоставНФА);
		КонецЕсли;
		
		ДокументОбъект.ДополнительныеСвойства.Вставить("ПроцессыОбработкиДокументов_ЗаписатьБезПроверкиОбменДаннымиЗагрузка", Истина);
		Если Записывать Тогда
			Если НЕ ЗначениеЗаполнено(ДокументОбъект.Номер) Тогда
				ДокументОбъект.УстановитьНовыйНомер();
			КонецЕсли;
			ДокументОбъект.Записать(РежимЗаписи);
			СсылкаНаВладельца = ДокументОбъект.Ссылка;
		Иначе
			СсылкаНаВладельца = ДокументОбъект;
		КонецЕсли;
	Исключение
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Заполнение документа на основе ЭД. %1'"), Текст)
			+ Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ВыполнитьЗаписьСобытияПоЭДВЖурналРегистрации(ТекстСообщения,
			2, УровеньЖурналаРегистрации.Ошибка, ДокументОбъект.Метаданные(), СсылкаНаВладельца);
		ВызватьИсключение(Текст);
	КонецПопытки;
	
КонецПроцедуры	

Функция ОрганизацияПоДаннымЭД(ДеревоДанных, ВидУчастника, ОписаниеОшибки = "")
	
	Организация = Неопределено;
	Если ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника") = "ЮЛ" Тогда
		ИНН = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.ИНН");
		КПП = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.КПП");
		
		СсылкаНаОбъектПоИННКПП("Организации", ИНН, КПП, Организация);
		
