Функция ОтветноеИзвещениеПоИсходящемуИзвещению(ИсходящееИзвещение) Экспорт
	Результат = Документы.ИзвещениеВходящее.ПустаяСсылка();
	НекорректныеСостоянияЭДО = Новый Массив;
	НекорректныеСостоянияЭДО.Добавить(Перечисления.СостоянияДокументовЭДО.ОжидаетсяИсправление);
	НекорректныеСостоянияЭДО.Добавить(Перечисления.СостоянияДокументовЭДО.ОжидаетсяПодтверждениеАннулирования);
	НекорректныеСостоянияЭДО.Добавить(Перечисления.СостоянияДокументовЭДО.Аннулирован);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИзвещениеВходящее.Ссылка КАК Ссылка,
	               |	СостоянияПоОбъектамУчетаЭДО.СостояниеЭДО КАК СостояниеЭДО
	               |ИЗ
	               |	Документ.ИзвещениеВходящее КАК ИзвещениеВходящее
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияПоОбъектамУчетаЭДО КАК СостоянияПоОбъектамУчетаЭДО
	               |		ПО ИзвещениеВходящее.Ссылка = СостоянияПоОбъектамУчетаЭДО.СсылкаНаОбъект
	               |ГДЕ
	               |	ИзвещениеВходящее.ДокументОснование = &ДокументОснование
	               |	И ИзвещениеВходящее.ДокументОснование.ПометкаУдаления = ЛОЖЬ
	               |	И НЕ СостоянияПоОбъектамУчетаЭДО.СостояниеЭДО В (&НекорректныеСостоянияЭДО)";
	Запрос.УстановитьПараметр("ДокументОснование", ИсходящееИзвещение);

	Запрос.УстановитьПараметр("НекорректныеСостоянияЭДО", НекорректныеСостоянияЭДО);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

