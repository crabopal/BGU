Функция ШтампВизуализацииПростойЭлектроннойПодписиВнутреннегоЭДО(Свойства, ТекстОтметки = "", ЛоготипОрганизации = Неопределено)
	
	Если Константы.ОтображатьДатуПодписанияВШтампеВизуализацииПЭП.Получить() = Истина 
		И ОтображатьДатуПодписанияПоОрганизации(Свойства.Организация) = Истина Тогда
		Штамп = УправлениеПечатью.МакетПечатнойФормы("Документ.ВнутреннийЭлектронныйДокумент.ПФ_MXL_ШтампПЭПсДатой");
	Иначе
		Штамп = УправлениеПечатью.МакетПечатнойФормы("Документ.ВнутреннийЭлектронныйДокумент.ПФ_MXL_ШтампПЭП");
	КонецЕсли;
	
	ПараметрыШтампа = Новый Структура;
	ПараметрыШтампа.Вставить("ВладелецПодписи", Свойства.ВладелецПодписи);
	ПараметрыШтампа.Вставить("Организация", Свойства.Организация);
	ПараметрыШтампа.Вставить("Должность", Свойства.Должность);
	ПараметрыШтампа.Вставить("ДатаПодписи", Свойства.ДатаПодписи);
	ПараметрыШтампа.Вставить("УстановившийПодпись", Свойства.УстановившийПодпись);
	ПараметрыШтампа.Вставить("ТекстОтметки", ТекстОтметки);
	
	ЗаполнитьЗначенияСвойств(Штамп.Параметры, ПараметрыШтампа);
	
	Если ЛоготипОрганизации <> Неопределено Тогда
		Штамп.Области.Картинка.Картинка = ЛоготипОрганизации;
	КонецЕсли;
	
	Возврат Штамп;
	
КонецФункции

Процедура ДобавитьШтампыЭлектронныхПодписейВнутреннегоЭДО(ТабличныйДокумент, ЭлектронныеПодписиДляШтампа, Организация) Экспорт
	
	Если ЭлектронныеПодписиДляШтампа.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыШтампа = Новый Структура;
	ПараметрыШтампа.Вставить("ТекстОтметки", "");
	ПараметрыШтампа.Вставить("Логотип");
	
	Штампы = Новый Массив;
	Для Каждого Подпись Из ЭлектронныеПодписиДляШтампа Цикл
		
		МодульРаботаСФайламиПереопределяемый = ОбщегоНазначения.ОбщийМодуль("РаботаСФайламиПереопределяемый");
		
		Если Подпись.ПростаяПодпись = Истина Тогда
			
			Если НЕ ЗначениеЗаполнено(Подпись.Организация) Тогда
				Подпись.Вставить("Организация", Организация);
			КонецЕсли;
			
			МодульРаботаСФайламиПереопределяемый.ПриПечатиФайлаСоШтампом(ПараметрыШтампа, Неопределено);
			
			Штамп = ШтампВизуализацииПростойЭлектроннойПодписиВнутреннегоЭДО(Подпись, ПараметрыШтампа.ТекстОтметки, ПараметрыШтампа.Логотип);
			
		Иначе
			
			Если ЗначениеЗаполнено(Подпись.Сертификат) Тогда
				СертификатКриптографии = Новый СертификатКриптографии(Подпись.Сертификат);
			Иначе
				СертификатКриптографии = Новый СертификатКриптографии(ПолучитьИзВременногоХранилища(Подпись.АдресСертификата));
			КонецЕсли;
			
			МодульРаботаСФайламиПереопределяемый.ПриПечатиФайлаСоШтампом(ПараметрыШтампа, СертификатКриптографии);
			
			СвойстваПодписи = ЭлектроннаяПодписьКлиентСервер.НовыеСвойстваПодписи();
			ЗаполнитьЗначенияСвойств(СвойстваПодписи, Подпись);
			СвойстваПодписи.Сертификат = СертификатКриптографии;
			
			Если НЕ ЗначениеЗаполнено(СвойстваПодписи.РезультатПроверкиПодписиПоМЧД) Тогда
				СвойстваПодписи = СертификатКриптографии;
			КонецЕсли;

			Штамп = ЭлектроннаяПодпись.ШтампВизуализацииЭлектроннойПодписи(СвойстваПодписи,
				Подпись.ДатаПодписи, ПараметрыШтампа.ТекстОтметки, ПараметрыШтампа.Логотип);
				
			Если Константы.ОтображатьДатуПодписанияВШтампеВизуализацииПЭП.Получить() = Истина
				И ОтображатьДатуПодписанияПоОрганизации(Организация) Тогда
				Штамп.Область(3,3,3,3).Заполнение = ТипЗаполненияОбластиТабличногоДокумента.Параметр;
				Штамп.Область(3,3,3,3).Параметр = "ДатаПодписи";
				Штамп.Область(3,3,3,3).ВертикальноеПоложение = ВертикальноеПоложение.Верх;
				Штамп.Параметры.ДатаПодписи = Подпись.ДатаПодписи;
			КонецЕсли;
			
			Штамп.Области.Штамп.ЦветРамки  = Новый Цвет(0, 0, 0);
			Штамп.Области.Штамп.ЦветТекста = ЦветаСтиля.ЦветТекстаПоля.ПолучитьАбсолютный();
			
		КонецЕсли;
		
		Штампы.Добавить(Штамп);
		
	КонецЦикла;
	
	// необходимо удалить вертикальный разрыв страницы, если он есть, а после добавления штампов добавить обратно,
	// иначе возникает лишний вертикальный разрыв и документ печатается с лишней областью (например, в Отчете кассира)
	КолонкаСВертикальнымРазделителем = 0;
	Для Сч = 1 По ТабличныйДокумент.ШиринаТаблицы Цикл
		ОбластьЯчеек = ТабличныйДокумент.Область(,Сч,,Сч);
		Если ОбластьЯчеек.КонецСтраницы Тогда
			ОбластьЯчеек.КонецСтраницы = Ложь;
			КолонкаСВертикальнымРазделителем = Сч;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ЭлектроннаяПодпись.ДобавитьШтампыВТабличныйДокумент(ТабличныйДокумент, Штампы);
	
	Если КолонкаСВертикальнымРазделителем > 0 Тогда
		ТабличныйДокумент.Область(,КолонкаСВертикальнымРазделителем,,КолонкаСВертикальнымРазделителем).КонецСтраницы = Истина;
	КонецЕсли;
	
КонецПроцедуры

Функция ОтображатьДатуПодписанияПоОрганизации(Организация = Неопределено) Экспорт
	
	ОтображатьДатуПодписанияВШтампеЭП = Истина;
	
	Если ЗначениеЗаполнено(Организация) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ИсключенияОтображенияДатыПодписанияВШтампе.Организация КАК Организация
			|ИЗ
			|	РегистрСведений.ИсключенияОтображенияДатыПодписанияВШтампе КАК ИсключенияОтображенияДатыПодписанияВШтампе
			|ГДЕ
			|	ИсключенияОтображенияДатыПодписанияВШтампе.Организация = &Организация";
		
		Запрос.УстановитьПараметр("Организация", Организация);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если НЕ РезультатЗапроса.Пустой() Тогда
			ОтображатьДатуПодписанияВШтампеЭП = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ОтображатьДатуПодписанияВШтампеЭП;
	
КонецФункции

Функция КодВидаСведенийАктаПриемаПередачиНФА(ВидСведений)
	Результат = 0;
	
	Если ВидСведений = Перечисления.ВидыСведенийПриложенийАктаПриемаПередачиНФА.ВыпискаИзРеестраИмуществаОбОбъекте Тогда
		Результат = 1;
	ИначеЕсли ВидСведений = Перечисления.ВидыСведенийПриложенийАктаПриемаПередачиНФА.ВыпискаИзЕГРН Тогда
		Результат = 2;
	ИначеЕсли ВидСведений = Перечисления.ВидыСведенийПриложенийАктаПриемаПередачиНФА.КопииИнвентарныхКарточек Тогда
		Результат = 3;
	ИначеЕсли ВидСведений = Перечисления.ВидыСведенийПриложенийАктаПриемаПередачиНФА.КопииКарточекКапитальныхВложений Тогда
		Результат = 4;
	ИначеЕсли ВидСведений = Перечисления.ВидыСведенийПриложенийАктаПриемаПередачиНФА.ПрочиеДокументы Тогда
		Результат = 999;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

Функция ВидСведенийАктаПриемаПередачиНФА(КодВидаСведений)
	Результат = Перечисления.ВидыСведенийПриложенийАктаПриемаПередачиНФА.ПустаяСсылка();
	
	Если КодВидаСведений = 1 Тогда
		Результат = Перечисления.ВидыСведенийПриложенийАктаПриемаПередачиНФА.ВыпискаИзРеестраИмуществаОбОбъекте;
	ИначеЕсли КодВидаСведений = 2 Тогда
		Результат = Перечисления.ВидыСведенийПриложенийАктаПриемаПередачиНФА.ВыпискаИзЕГРН;
	ИначеЕсли КодВидаСведений = 3 Тогда
		Результат = Перечисления.ВидыСведенийПриложенийАктаПриемаПередачиНФА.КопииИнвентарныхКарточек;
	ИначеЕсли КодВидаСведений = 4 Тогда
		Результат = Перечисления.ВидыСведенийПриложенийАктаПриемаПередачиНФА.КопииКарточекКапитальныхВложений;
	ИначеЕсли КодВидаСведений = 999 Тогда
		Результат = Перечисления.ВидыСведенийПриложенийАктаПриемаПередачиНФА.ПрочиеДокументы;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

Функция ДвоичныеДанныеЭлектронногоДокумента(ДокументСсылка, АдресОсновногоФайла = Неопределено) Экспорт
	
	Если ДокументСсылка.Пустая() Тогда
		Возврат ПолучитьИзВременногоХранилища(АдресОсновногоФайла);
	Иначе
		Возврат РаботаСФайлами.ДвоичныеДанныеФайла(ДокументСсылка.ОсновнойФайл, Ложь);
	КонецЕсли;
	
КонецФункции

Функция АдресТабличногоДокументаПредставленияЭД(ВнутреннийЭД, Организация) Экспорт
	ДвоичныеДанные = ДвоичныеДанныеЭлектронногоДокумента(ВнутреннийЭД);
	
	ЭлектронныеПодписи = НовыйСписокЭлектронныхПодписейВнутреннегоЭД();
	ЗаполнитьСписокПодписей(ЭлектронныеПодписи, ВнутреннийЭД.ОсновнойФайл, Организация);

	ТабличныйДокументОсновной = ВнутреннийЭДО.ТабличныйДокументИзДвоичныхДанныхАрхива(ДвоичныеДанные);
	
	АдресТабличногоДокумента = ПоместитьВоВременноеХранилище(ТабличныйДокументОсновной);

	//Отступ чтобы штампы не накладывались на представление документа
	МакетШтампов = УправлениеПечатью.МакетПечатнойФормы("Документ.ВнутреннийЭлектронныйДокумент.ПФ_MXL_ШтампПЭП");
	ОбластьМакета = МакетШтампов.ПолучитьОбласть("Отступ");
	ТабличныйДокументОсновной.Вывести(ОбластьМакета);
	
	ДобавитьШтампыЭлектронныхПодписейВнутреннегоЭДО(ТабличныйДокументОсновной, ЭлектронныеПодписи, Организация);
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("mxl");
	ТабличныйДокументОсновной.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.MXL);
	
	Результат = ПоместитьВоВременноеХранилище(ТабличныйДокументОсновной);
	
	Попытка
		УдалитьФайлы(ИмяВременногоФайла);
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Удаление временного MXL файла'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,,,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
	КонецПопытки;
	
	Возврат Результат;
КонецФункции

Функция АдресТабличногоДокументаПредставленияЭДПОД(ДокументУчета, ИдентификаторПечати) Экспорт
	ДвоичныеДанные = ДвоичныеДанныеПредставленияДокументаПОД(ДокументУчета, ИдентификаторПечати, ТипФайлаТабличногоДокумента.MXL);
	ТабличныйДокумент = ТабличныйДокументИзДвоичныхДанных(ДвоичныеДанные);
			
	Результат = ПоместитьВоВременноеХранилище(ТабличныйДокумент);
	
	Возврат Результат;
КонецФункции

Функция НовыйСписокЭлектронныхПодписейВнутреннегоЭД() Экспорт
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ДатаПодписи", );
	Результат.Колонки.Добавить("Статус", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(500)));
	Результат.Колонки.Добавить("Объект", );
	Результат.Колонки.Добавить("АдресПодписи", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Отпечаток", Новый ОписаниеТипов("Строка"));
