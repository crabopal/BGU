	               |
	               |ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(ИсправительныйСчетФактураПолученный.Договор КАК Справочник.Договоры).НомерДоговора,
	               |	ВЫРАЗИТЬ(ИсправительныйСчетФактураПолученный.Договор КАК Справочник.Договоры).ДатаДоговора,
	               |	ИсправительныйСчетФактураПолученный.Ссылка
	               |ИЗ
	               |	Документ.ИсправительныйСчетФактураПолученный КАК ИсправительныйСчетФактураПолученный
	               |ГДЕ
	               |	ИсправительныйСчетФактураПолученный.Ссылка В(&МассивСсылок)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(КорректировочныйСчетФактураВыданный.Договор КАК Справочник.Договоры).НомерДоговора,
	               |	ВЫРАЗИТЬ(КорректировочныйСчетФактураВыданный.Договор КАК Справочник.Договоры).ДатаДоговора,
	               |	КорректировочныйСчетФактураВыданный.Ссылка
	               |ИЗ
	               |	Документ.КорректировочныйСчетФактураВыданный КАК КорректировочныйСчетФактураВыданный
	               |ГДЕ
	               |	КорректировочныйСчетФактураВыданный.Ссылка В(&МассивСсылок)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(КорректировочныйСчетФактураПолученный.Договор КАК Справочник.Договоры).НомерДоговора,
	               |	ВЫРАЗИТЬ(КорректировочныйСчетФактураПолученный.Договор КАК Справочник.Договоры).ДатаДоговора,
	               |	КорректировочныйСчетФактураПолученный.Ссылка
	               |ИЗ
	               |	Документ.КорректировочныйСчетФактураПолученный КАК КорректировочныйСчетФактураПолученный
	               |ГДЕ
	               |	КорректировочныйСчетФактураПолученный.Ссылка В(&МассивСсылок)";
	
	
	Запрос.УстановитьПараметр("МассивСсылок",МассивСсылок); 
	
	Соответствие = Новый Соответствие;
	Для Каждого Ссылка Из МассивСсылок Цикл
		
		Соответствие.Вставить(Ссылка,Новый Структура("НомерДоговора, ДатаДоговора","",'00010101'));
		
	КонецЦикла;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Соответствие.Вставить(Выборка.Ссылка, Новый Структура("НомерДоговора, ДатаДоговора",Выборка.НомерДоговора,Выборка.ДатаДоговора));
		
	КонецЦикла;
	
	ВозвращаемоеСоответствие = Соответствие;
КонецПроцедуры

Функция СчетКонтрагента(Владелец, НомерСчета) Экспорт
	Результат = Справочники.БанковскиеИКазначейскиеСчета.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Если ЗначениеЗаполнено(Владелец) Тогда
		ТекстЗапроса = "ВЫБРАТЬ
		               |	БанковскиеИКазначейскиеСчета.Ссылка
		               |ИЗ
		               |	Справочник.БанковскиеИКазначейскиеСчета КАК БанковскиеИКазначейскиеСчета
		               |ГДЕ
		               |	БанковскиеИКазначейскиеСчета.Владелец = &Контрагент
		               |	И БанковскиеИКазначейскиеСчета.Код = &НомерСчета";
	Иначе
		ТекстЗапроса = "ВЫБРАТЬ
		               |	БанковскиеИКазначейскиеСчета.Ссылка
		               |ИЗ
		               |	Справочник.БанковскиеИКазначейскиеСчета КАК БанковскиеИКазначейскиеСчета
		               |ГДЕ
		               |	БанковскиеИКазначейскиеСчета.Код = &НомерСчета";
	Конецесли;	
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("Контрагент", Владелец); 			   
	Запрос.УстановитьПараметр("НомерСчета", НомерСчета); 			   
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

Функция СчетОрганизации(Владелец, НомерСчета) Экспорт
	Результат = Справочники.ЛицевыеСчета.ПустаяСсылка();
	Запрос = Новый Запрос;
	
	Если ЗначениеЗаполнено(Владелец) Тогда
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЛицевыеСчета.Ссылка КАК Ссылка
		               |ИЗ
		               |	Справочник.ЛицевыеСчета КАК ЛицевыеСчета
		               |ГДЕ
		               |	ЛицевыеСчета.Владелец = &Организация
		               |	И ЛицевыеСчета.Код = &НомерСчета
		               |	И ЛицевыеСчета.ПометкаУдаления = ЛОЖЬ";
		Запрос.УстановитьПараметр("Организация", Владелец); 			   
	Иначе
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЛицевыеСчета.Ссылка КАК Ссылка
		               |ИЗ
		               |	Справочник.ЛицевыеСчета КАК ЛицевыеСчета
		               |ГДЕ
		               |	ЛицевыеСчета.Код = &НомерСчета
		               |	И ЛицевыеСчета.ПометкаУдаления = ЛОЖЬ";
	КонецЕсли;
	Запрос.УстановитьПараметр("НомерСчета", НомерСчета); 			   
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

