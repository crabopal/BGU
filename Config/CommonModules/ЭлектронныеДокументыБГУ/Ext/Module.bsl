Процедура ЗаполнитьТекстПроДопСведенияДляЭлектронногоУПД(Форма, КлючевойДопРеквизит = Неопределено)  Экспорт
	
	ТекстНадписиДопСведенияЭлектронногоУПД = НСтр("ru='<не указаны>'");
	РасчетныйСчет = Справочники.ЛицевыеСчета.ПустаяСсылка();
	
	Если КлючевойДопРеквизит = Неопределено Тогда
		ДокументРеализации = Форма["Объект"].Ссылка;
		РеквизитыДокументРеализации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			ДокументРеализации, 
			"РеквизитыЛицевогоСчета");
		
		РасчетныйСчет = РеквизитыДокументРеализации.РеквизитыЛицевогоСчета;
	Иначе
		Если ЗначениеЗаполнено(КлючевойДопРеквизит) Тогда
			РасчетныйСчет = КлючевойДопРеквизит;
		КонецЕсли;	
	КонецЕсли;
		
	Если ЗначениеЗаполнено(РасчетныйСчет) Тогда
		ТекстНадписиДопСведенияЭлектронногоУПД = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='р/с в %1'"), СокрЛП(РасчетныйСчет));
	КонецЕсли;	

	Форма.НадписьДопСведенияЭлектронногоУПД = ТекстНадписиДопСведенияЭлектронногоУПД;
КонецПроцедуры

