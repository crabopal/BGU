		Если ЗначениеЗаполнено(СопроводительныйДокумент.Номер) Тогда
			ДокументОснование = НайтиРеализациюТоваровУслугДляАктаОРасхождениях(ДокументОбъект.Организация, СопроводительныйДокумент.Номер, СопроводительныйДокумент.Дата, Контрагент);
			Если ЗначениеЗаполнено(ДокументОснование) Тогда
				ДокументОбъект.ДокументОснование = ДокументОснование.ДокументОснование;
				РеквизитыОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, "ВалютаДокумента, Договор", Истина);
				ДокументОбъект.ВалютаДокумента = РеквизитыОснования.ВалютаДокумента;
				ДокументОбъект.Договор = РеквизитыОснования.Договор;
			КонецЕсли;
		КонецЕсли;
		
		ДокументОбъект.СопроводительныйДокументНаименование = СопроводительныйДокумент.Наименование;
		ДокументОбъект.СопроводительныйДокументНомер = СопроводительныйДокумент.Номер;
		ДокументОбъект.СопроводительныйДокументДата = СопроводительныйДокумент.Дата;
		
		ТранспортныйДокумент = Данные.ОбстоятельстваПриемки.ТранспортныйДокумент;
		ДокументОбъект.ТранспортныйДокументНаименование = ТранспортныйДокумент.Наименование;
		ДокументОбъект.ТранспортныйДокументНомер = ТранспортныйДокумент.Номер;
		ДокументОбъект.ТранспортныйДокументДата = ТранспортныйДокумент.Дата;
		
		// Сертификаты соответствия.
		ДокументОбъект.СертификатыСоответствия.Очистить();
		Сертификаты = Данные.СведенияОбОсмотреГруза.СертификатыСоответствия;
		Если ТипЗнч(Сертификаты) = Тип("Массив") Тогда
			Для каждого Номер Из Сертификаты Цикл
				ДокументОбъект.СертификатыСоответствия.Добавить().НомерСертификата = Номер;
			КонецЦикла;
		КонецЕсли;
		
		//Итоги приемки
		ДокументОбъект.ФормированиеДополнительныхСведений = Данные.ФормированиеДополнительныхСведений;
		
		// Прилагаемые документы.
		ДокументОбъект.ПрилагаемыеДокументы.Очистить();
		Для каждого СтрокаДокумента Из Данные.ПрилагаемыеДокументы Цикл
			НоваяСтрока = ДокументОбъект.ПрилагаемыеДокументы.Добавить();
			НоваяСтрока.ВидДокумента = СтрокаДокумента.Наименование;
			НоваяСтрока.НомерДокумента = СтрокаДокумента.Номер;
			НоваяСтрока.ДатаДокумента = СтрокаДокумента.Дата;
		КонецЦикла;
		
		// СведенияПоТранспортнымДокументам
		ДокументОбъект.СведенияПоТранспортнымДокументам.Очистить();
		Для каждого СтрокаДокумента Из Данные.СведенияПоТранспортнымДокументам Цикл
			НоваяСтрока = ДокументОбъект.СведенияПоТранспортнымДокументам.Добавить();
			НоваяСтрока.ОтметкаОбОпломбировании = СтрокаДокумента.ОтметкаОбОпломбировании;
			НоваяСтрока.ВидУпаковки = СтрокаДокумента.ВидУпаковки;
			НоваяСтрока.Количество = СтрокаДокумента.Количество;
			НоваяСтрока.НаименованиеГруза = СтрокаДокумента.НаименованиеГруза;
			НоваяСтрока.ЕдиницаИзмеренияКод = СтрокаДокумента.ЕдиницаИзмеренияКод;
			НоваяСтрока.ЕдиницыИзмеренияНаименование = СтрокаДокумента.ЕдиницаИзмеренияНаименование;
			
			ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка();
			НайтиСсылкуНаОбъект("ЕдиницыИзмерения", ЕдиницаИзмерения, СтрокаДокумента.ЕдиницаИзмеренияКод);
			
			НоваяСтрока.ЕдиницаИзмерения = ЕдиницаИзмерения;
			НоваяСтрока.МассаОтправленияБрутто = СтрокаДокумента.МассаОтправленияБрутто;
			НоваяСтрока.МассаОтправленияНетто = СтрокаДокумента.МассаОтправленияНетто;
			НоваяСтрока.МассаПрибытияБрутто = СтрокаДокумента.МассаПрибытияБрутто;
			НоваяСтрока.МассаПрибытияНетто = СтрокаДокумента.МассаПрибытияНетто;
			
			Если ТипЗнч(СтрокаДокумента.ДополнительныеДанные) = Тип("Соответствие") Тогда
				Для каждого КлючЗначение Из СтрокаДокумента.ДополнительныеДанные Цикл
					НоваяСтрока.ОтметкиОтправителя = НоваяСтрока.ОтметкиОтправителя + " " + КлючЗначение.Значение;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		
		// Сведения таблицы.
		СуммаДокумента = 0;
		КоличествоДокумента = 0;
		СуммаДокументаПоДокументам = 0;
		КоличествоДокументаПоДокументам = 0;
		
		ДокументОбъект.СписокНоменклатуры.Очистить();
		
		СтрокаТаблицаТоваров = ДеревоДанных.Строки.Найти("РезультатыПриемки", "ПолныйПуть");
		Для Каждого Товар Из СтрокаТаблицаТоваров.Строки Цикл
			НоваяСтрока = ДокументОбъект.СписокНоменклатуры.Добавить();
			
			ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка();
			ЕдиницыИзмеренияКод = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(Товар, "РезультатыПриемки.НомерСтроки.ЕдиницаИзмеренияКод");
			ЕдиницыИзмеренияНаименование = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(Товар, "РезультатыПриемки.НомерСтроки.ЕдиницаИзмеренияНаименование");
			
			НайтиСсылкуНаОбъект("ЕдиницыИзмерения", ЕдиницаИзмерения, ЕдиницыИзмеренияКод);
			НоваяСтрока.ЕдиницаИзмерения = ЕдиницаИзмерения;	
			НоваяСтрока.ЕдиницаИзмеренияКод = ЕдиницыИзмеренияКод;
			НоваяСтрока.ЕдиницыИзмеренияНаименование = ЕдиницыИзмеренияНаименование;
			
			НоваяСтрока.НаименованиеТовара = ЗначениеРеквизитаВДереве(Товар, "РезультатыПриемки.НомерСтроки.Товар.Наименование");
			НоваяСтрока.АртикулТовара = ЗначениеРеквизитаВДереве(Товар, "РезультатыПриемки.НомерСтроки.Товар.Артикул");
			НоваяСтрока.КодТовара = ЗначениеРеквизитаВДереве(Товар, "РезультатыПриемки.НомерСтроки.Товар.Код");
			НоваяСтрока.ПаспортТовара = ЗначениеРеквизитаВДереве(Товар, "РезультатыПриемки.НомерСтроки.Товар.Паспорт");
			НоваяСтрока.ХарактеристикаТовара = ЗначениеРеквизитаВДереве(Товар, "РезультатыПриемки.НомерСтроки.Товар.Характеристика");
			НоваяСтрока.СортТовара = ЗначениеРеквизитаВДереве(Товар, "РезультатыПриемки.НомерСтроки.Товар.Сорт");
			
			//По документам
			НоваяСтрока.КоличествоПоДокументам = ЗначениеРеквизитаВДереве(Товар, "РезультатыПриемки.НомерСтроки.ПоДокументу.Количество");
			НоваяСтрока.ЦенаПоДокументам = ЗначениеРеквизитаВДереве(Товар, "РезультатыПриемки.НомерСтроки.ПоДокументу.Цена");
			НоваяСтрока.СуммаПоДокументам = НоваяСтрока.КоличествоПоДокументам * НоваяСтрока.ЦенаПоДокументам;
			
			НоваяСтрока.СтавкаНДСПоДокументам = ЗначениеРеквизитаВДереве(Товар, "РезультатыПриемки.НомерСтроки.ПоДокументу.СтавкаНДС");
			НоваяСтрока.ВсегоПоДокументам = ЗначениеРеквизитаВДереве(Товар, "РезультатыПриемки.НомерСтроки.ПоДокументу.СуммаСНДС");
			НоваяСтрока.СуммаНДСПоДокументам = ЗначениеРеквизитаВДереве(Товар, "РезультатыПриемки.НомерСтроки.ПоДокументу.СуммаНДС");
			
			СуммаДокументаПоДокументам = СуммаДокументаПоДокументам + НоваяСтрока.ВсегоПоДокументам;
			КоличествоДокументаПоДокументам = КоличествоДокументаПоДокументам + НоваяСтрока.КоличествоПоДокументам;
			
			//По факту
			НоваяСтрока.КоличествоПоФакту = ЗначениеРеквизитаВДереве(Товар, "РезультатыПриемки.НомерСтроки.ПоФакту.Количество");
			НоваяСтрока.ЦенаПоФакту = ЗначениеРеквизитаВДереве(Товар, "РезультатыПриемки.НомерСтроки.ПоФакту.Цена");
			НоваяСтрока.СуммаПоФакту = НоваяСтрока.КоличествоПоФакту * НоваяСтрока.ЦенаПоФакту;
			
			НоваяСтрока.СтавкаНДСПоФакту = ЗначениеРеквизитаВДереве(Товар, "РезультатыПриемки.НомерСтроки.ПоФакту.СтавкаНДС");
			НоваяСтрока.ВсегоПоФакту = ЗначениеРеквизитаВДереве(Товар, "РезультатыПриемки.НомерСтроки.ПоФакту.СуммаСНДС");
			НоваяСтрока.СуммаНДСПоФакту = ЗначениеРеквизитаВДереве(Товар, "РезультатыПриемки.НомерСтроки.ПоФакту.СуммаНДС");
			
			СуммаДокумента = СуммаДокумента + НоваяСтрока.ВсегоПоФакту;
			КоличествоДокумента = КоличествоДокумента + НоваяСтрока.КоличествоПоФакту;
			
			НоваяСтрока.КоличествоБрак = ЗначениеРеквизитаВДереве(Товар, "РезультатыПриемки.НомерСтроки.Брак.Количество");
			НоваяСтрока.ПояснениеБрак = ЗначениеРеквизитаВДереве(Товар, "РезультатыПриемки.НомерСтроки.Брак.Пояснение");
			
			НоваяСтрока.КоличествоБой = ЗначениеРеквизитаВДереве(Товар, "РезультатыПриемки.НомерСтроки.Бой.Количество");
			НоваяСтрока.ПояснениеБой = ЗначениеРеквизитаВДереве(Товар, "РезультатыПриемки.НомерСтроки.Бой.Пояснение");
			
			НоваяСтрока.КоличествоНедостача = ЗначениеРеквизитаВДереве(Товар, "РезультатыПриемки.НомерСтроки.Недостача.Количество");
			НоваяСтрока.ПояснениеНедостача = ЗначениеРеквизитаВДереве(Товар, "РезультатыПриемки.НомерСтроки.Недостача.Пояснение");
			
			НоваяСтрока.КоличествоИзлишки = ЗначениеРеквизитаВДереве(Товар, "РезультатыПриемки.НомерСтроки.Излишки.Количество");
			НоваяСтрока.ПояснениеИзлишки = ЗначениеРеквизитаВДереве(Товар, "РезультатыПриемки.НомерСтроки.Излишки.Пояснение");
			
			НоваяСтрока.ЦеновыеОтклоненияЦена = ЗначениеРеквизитаВДереве(Товар, "РезультатыПриемки.НомерСтроки.ЦеновыеОтклонения.Цена");
			НоваяСтрока.ЦеновыеОтклоненияСуммаНДС = ЗначениеРеквизитаВДереве(Товар, "РезультатыПриемки.НомерСтроки.ЦеновыеОтклонения.СуммаНДС");
			НоваяСтрока.ЦеновыеОтклоненияВсего = ЗначениеРеквизитаВДереве(Товар, "РезультатыПриемки.НомерСтроки.ЦеновыеОтклонения.СуммаСНДС");
			НоваяСтрока.ЦеновыеОтклоненияПояснение = ЗначениеРеквизитаВДереве(Товар, "РезультатыПриемки.НомерСтроки.ЦеновыеОтклонения.Пояснение");
						
			НоваяСтрока.ИнформацияОРасхождениях = ЗначениеРеквизитаВДереве(Товар, "РезультатыПриемки.НомерСтроки.ИнформацияОРасхождениях");
			
			Номенклатура = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(Товар,
				"РезультатыПриемки.НомерСтроки.Сопоставление.НоменклатураИБ");
			Если ЗначениеЗаполнено(Номенклатура) Тогда
				НоваяСтрока.Номенклатура = Номенклатура;
			КонецЕсли;			
			
		КонецЦикла;
		
		ДокументОбъект.СуммаДокумента = СуммаДокумента;
		ДокументОбъект.СуммаРасхождений = СуммаДокументаПоДокументам - СуммаДокумента;
		ДокументОбъект.КоличествоРасхождения = КоличествоДокументаПоДокументам - КоличествоДокумента;
		
		ДокументОбъект.ДополнительныеСвойства.Вставить("ПроцессыОбработкиДокументов_ЗаписатьБезПроверкиОбменДаннымиЗагрузка", Истина);
		Если Записывать Тогда
			Если НЕ ЗначениеЗаполнено(ДокументОбъект.Номер) Тогда
				ДокументОбъект.УстановитьНовыйНомер();
			КонецЕсли;
			ДокументОбъект.Записать(РежимЗаписи);
			ДокументУчета = ДокументОбъект.Ссылка;
		Иначе // если функция вызвана из формы "Обработки.ОбменСКонтрагентами.ФормаЗагрузкиПросмотраЭД"
			ДокументУчета = ДокументОбъект;
		КонецЕсли;
	Исключение
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Заполнение документа на основе ЭД. %1'"), Текст)
			+ Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ВыполнитьЗаписьСобытияПоЭДВЖурналРегистрации(ТекстСообщения,
			2, УровеньЖурналаРегистрации.Ошибка, ДокументОбъект.Метаданные(), СсылкаНаВладельца);
		ВызватьИсключение(Текст);
	КонецПопытки;

КонецПроцедуры

Функция НайтиРеализациюТоваровУслугДляАктаОРасхождениях(Организация, НомерДокумента, ДатаДокумента, Контрагент)
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Если ЗначениеЗаполнено(Контрагент) Тогда
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	СчетФактураВыданный.Организация КАК Организация,
		|	СчетФактураВыданный.Номер КАК Номер,
		|	СчетФактураВыданный.Дата КАК Дата,
		|	0 КАК Приоритет,
		|	СчетФактураВыданный.Ссылка КАК Ссылка,
		|	"""" КАК НомерДляПечати,
		|	СчетФактураВыданный.ДокументОснование КАК ДокументОснование
		|ПОМЕСТИТЬ СчетаФактурыВыданные
		|ИЗ
		|	Документ.СчетФактураВыданный КАК СчетФактураВыданный
		|ГДЕ
		|	СчетФактураВыданный.Организация = &Организация
		|	И НАЧАЛОПЕРИОДА(СчетФактураВыданный.Дата, ДЕНЬ) = &ДатаДокумента
		|	И СчетФактураВыданный.Контрагент = &Контрагент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	АктОбОказанииУслуг.Организация КАК Организация,
		|	АктОбОказанииУслуг.Номер КАК Номер,
		|	АктОбОказанииУслуг.Дата КАК Дата,
		|	1 КАК Приоритет,
		|	АктОбОказанииУслуг.Ссылка КАК Ссылка,
		|	"""" КАК НомерДляПечати,
		|	АктОбОказанииУслуг.Ссылка КАК ДокументОснование
		|ПОМЕСТИТЬ АктыОбОказанииУслуг
		|ИЗ
		|	Документ.АктОбОказанииУслуг КАК АктОбОказанииУслуг
		|ГДЕ
		|	АктОбОказанииУслуг.Организация = &Организация
		|	И НАЧАЛОПЕРИОДА(АктОбОказанииУслуг.Дата, ДЕНЬ) = &ДатаДокумента
		|	И АктОбОказанииУслуг.Контрагент = &Контрагент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЭлектронныйПередаточныйДокументУслугиРаботы.Организация КАК Организация,
		|	ЭлектронныйПередаточныйДокументУслугиРаботы.Номер КАК Номер,
		|	ЭлектронныйПередаточныйДокументУслугиРаботы.Дата КАК Дата,
		|	1 КАК Приоритет,
		|	ЭлектронныйПередаточныйДокументУслугиРаботы.Ссылка КАК Ссылка,
		|	"""" КАК НомерДляПечати,
		|	ЭлектронныйПередаточныйДокументУслугиРаботы.Ссылка КАК ДокументОснование
