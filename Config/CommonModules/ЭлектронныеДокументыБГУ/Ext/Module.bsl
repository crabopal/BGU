	               |	НастройкиЭДОБГУ.ОтветственныйПередалТРУИныеСведения КАК ОтветственныйПередалТРУИныеСведения,
	               |	НастройкиЭДОБГУ.ОтветственныйПередалТРУ КАК ОтветственныйПередалТРУ,
	               |	НастройкиЭДОБГУ.ОтветственныйПередалТРУДоверенность КАК ОтветственныйПередалТРУДоверенность,
	               |	НастройкиЭДОБГУ.ОтветственныйПередалТРУКонтрагент КАК ОтветственныйПередалТРУКонтрагент,
	               |	НастройкиЭДОБГУ.ОтветственныйПередалТРУДокументПолномочий КАК ОтветственныйПередалТРУДокументПолномочий
				   |ИЗ
	               |	РегистрСведений.НастройкиЭДОБГУ КАК НастройкиЭДОБГУ
	               |ГДЕ
	               |	НастройкиЭДОБГУ.Организация = &Организация
	               |	И НастройкиЭДОБГУ.УПДЗаполнятьСведенияОЛицеОтветственномЗаПередачу";
	Запрос.УстановитьПараметр("Организация", Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		Результат = Новый Структура;
		Результат.Вставить("ОтветственныйПередалТРУВид", 					Выборка.ОтветственныйПередалТРУВид); 
		Результат.Вставить("ОтветственныйПередалТРУДолжность", 				Выборка.ОтветственныйПередалТРУДолжность);
        Результат.Вставить("ОтветственныйПередалТРУИныеСведения", 			Выборка.ОтветственныйПередалТРУИныеСведения);
        Результат.Вставить("ОтветственныйПередалТРУ", 						Выборка.ОтветственныйПередалТРУ);
        Результат.Вставить("ОтветственныйПередалТРУДоверенность", 			Выборка.ОтветственныйПередалТРУДоверенность);
		Результат.Вставить("ОтветственныйПередалТРУКонтрагент", 			Выборка.ОтветственныйПередалТРУКонтрагент);
		Результат.Вставить("ОтветственныйПередалТРУДокументПолномочий", 	Выборка.ОтветственныйПередалТРУДокументПолномочий);

	КонецЕсли;	
	
	Возврат Результат; 
	
КонецФункции 

Функция ИспользоватьНоменклатуруПолучателяВОтветномАктеОПриемеПередачеНФА(Организация) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Результат = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	НастройкиЭДОБГУ.ИспользоватьНоменклатуруПолучателяВОтветномАктеОПриемеПередачеНФА КАК ИспользоватьНоменклатуруПолучателя
	               |ИЗ
	               |	РегистрСведений.НастройкиЭДОБГУ КАК НастройкиЭДОБГУ
	               |ГДЕ
	               |	НастройкиЭДОБГУ.Организация = &Организация";
	Запрос.УстановитьПараметр("Организация", Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.ИспользоватьНоменклатуруПолучателя;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

