Функция ТипАктаОтветногоПринимающейСтороны() Экспорт
	Возврат 2;
КонецФункции	

Процедура ЗаполнитьСведенияУчастникаАктаОПриемеПередачеНФА(ДокументXDTO, Участник, КемВыступает, ДанныеИзвещения = Неопределено)
	
	Если НЕ ЗначениеЗаполнено(Участник) Тогда
		УчастникXDTO = СоздатьОбъектXDTO(ДокументXDTO, КемВыступает);
		Если ДанныеИзвещения = Неопределено Тогда
			УчастникXDTO.Установить("Наим", "");
			
			РегистрационныеСведенияXDTO = СоздатьОбъектXDTO(УчастникXDTO, "СвЮЛ");
			РегистрационныеСведенияXDTO.Установить("Наим", "");
			РегистрационныеСведенияXDTO.Установить("ИНН",  "");
			РегистрационныеСведенияXDTO.Установить("КПП",  "");
			РегистрационныеСведенияXDTO.Установить("ОКПО",  "");
			РегистрационныеСведенияXDTO.Установить("КодПоБК",  "");
			РегистрационныеСведенияXDTO.Установить("КодПоРПБС",  "");
			УчастникXDTO.Установить("СвЮЛ", РегистрационныеСведенияXDTO);
			КонтактXDTO = СоздатьОбъектXDTO(УчастникXDTO, "Контакт");
			КонтактXDTO.Установить("Телефон", "");
			АдресXDTO = СоздатьОбъектXDTO(УчастникXDTO, "Адрес");
			АдресXDTO.Установить("Наим", "");
			
		Иначе
			УчастникXDTO.Установить("Наим", ДанныеИзвещения.НаименованиеОрганизации);
			Если СтрДлина(СокрЛП(ДанныеИзвещения.ИНН)) = 12 Тогда
				РегистрационныеСведенияXDTO = СоздатьОбъектXDTO(УчастникXDTO, "СвФЛ");
				РегистрационныеСведенияXDTO.Установить("Наим", ДанныеИзвещения.НаименованиеОрганизации);
				РегистрационныеСведенияXDTO.Установить("ИНН",  ДанныеИзвещения.ИНН);
				УчастникXDTO.Установить("СвФЛ", РегистрационныеСведенияXDTO);
			Иначе	
				РегистрационныеСведенияXDTO = СоздатьОбъектXDTO(УчастникXDTO, "СвЮЛ");
				РегистрационныеСведенияXDTO.Установить("Наим", ДанныеИзвещения.НаименованиеОрганизации);
				РегистрационныеСведенияXDTO.Установить("ИНН",  ДанныеИзвещения.ИНН);
				РегистрационныеСведенияXDTO.Установить("КПП",  ДанныеИзвещения.КПП);
				РегистрационныеСведенияXDTO.Установить("ОКПО",  ДанныеИзвещения.ОКПО);
				РегистрационныеСведенияXDTO.Установить("КодПоБК",  ДанныеИзвещения.КодПоБК);
				РегистрационныеСведенияXDTO.Установить("КодПоРПБС",  ДанныеИзвещения.КодПоРПБС);
				УчастникXDTO.Установить("СвЮЛ", РегистрационныеСведенияXDTO);
			КонецЕсли;
			
			КонтактXDTO = СоздатьОбъектXDTO(УчастникXDTO, "Контакт");
			КонтактXDTO.Установить("Телефон", "");
			АдресXDTO = СоздатьОбъектXDTO(УчастникXDTO, "Адрес");
			АдресXDTO.Установить("Наим", "");
		КонецЕсли;
		
		ДокументXDTO[КемВыступает].Добавить(УчастникXDTO);
		
		Возврат;
	КонецЕсли;	
	
	СведенияОбУчастнике = Неопределено; 
	ПолучитьДанныеЮрФизЛица(Участник, СведенияОбУчастнике);
	
	Если НЕ ДанныеИзвещения = Неопределено Тогда
		СведенияОбУчастнике.ПолноеНаименование = ДанныеИзвещения.НаименованиеОрганизации;	
	КонецЕсли;	
	УчастникXDTO = СоздатьОбъектXDTO(ДокументXDTO, КемВыступает);
	УчастникXDTO.Установить("Наим", СведенияОбУчастнике.ПолноеНаименование);
	
	ЭтоЮрЛицо = Ложь;
	Если ТипЗнч(Участник) = Тип("СправочникСсылка.Организации") Тогда
		ЭтоЮрЛицо = Истина;
	Иначе
		Если Участник.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
			ЭтоЮрЛицо = Истина;
		КонецЕсли;	
	КонецЕсли;	
	
	Если ЭтоЮрЛицо Тогда
		РегистрационныеСведенияXDTO = СоздатьОбъектXDTO(УчастникXDTO, "СвЮЛ");
		Если НЕ ДанныеИзвещения = Неопределено Тогда
			СведенияОбУчастнике.ИНН = ДанныеИзвещения.ИНН;
			СведенияОбУчастнике.КПП = ДанныеИзвещения.КПП;
			СведенияОбУчастнике.КодОКПО = ДанныеИзвещения.ОКПО;
			КодПоБК = ДанныеИзвещения.КодПоБК;
		Иначе
			КодПоБК = СведенияОбУчастнике.КодПоППП.Код;
		КонецЕсли;	
		РегистрационныеСведенияXDTO.Установить("Наим", СведенияОбУчастнике.ПолноеНаименование);
		РегистрационныеСведенияXDTO.Установить("ИНН",  СведенияОбУчастнике.ИНН);
		РегистрационныеСведенияXDTO.Установить("КПП",  СведенияОбУчастнике.КПП);
		РегистрационныеСведенияXDTO.Установить("ОКПО",  СведенияОбУчастнике.КодОКПО);
		РегистрационныеСведенияXDTO.Установить("КодПоБК",  КодПоБК);
		РегистрационныеСведенияXDTO.Установить("КодПоРПБС",  СведенияОбУчастнике.КодПоРПБС);
		
		УчастникXDTO.Установить("СвЮЛ", РегистрационныеСведенияXDTO);
	Иначе
		РегистрационныеСведенияXDTO = СоздатьОбъектXDTO(УчастникXDTO, "СвФЛ");
		СвойствоСведений = РегистрационныеСведенияXDTO.Свойства().Получить("Наим");
		Если ЗначениеЗаполнено(СвойствоСведений) Тогда
			РегистрационныеСведенияXDTO.Установить("Наим", СведенияОбУчастнике.ПолноеНаименование);
		КонецЕсли;
		РегистрационныеСведенияXDTO.Установить("Фамилия",  СведенияОбУчастнике.Фамилия);
		РегистрационныеСведенияXDTO.Установить("Имя",      СведенияОбУчастнике.Имя);
		РегистрационныеСведенияXDTO.Установить("Отчество", СведенияОбУчастнике.Отчество);
		РегистрационныеСведенияXDTO.Установить("ИНН",      СведенияОбУчастнике.ИНН);
		УчастникXDTO.Установить("СвФЛ", РегистрационныеСведенияXDTO);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СведенияОбУчастнике.Телефоны) Тогда
		КонтактXDTO = СоздатьОбъектXDTO(УчастникXDTO, "Контакт");
		КонтактXDTO.Установить("Телефон", СведенияОбУчастнике.Телефоны);
		УчастникXDTO.Установить("Контакт", КонтактXDTO);
	КонецЕсли;
	
	Если СведенияОбУчастнике.Свойство("ЮридическийАдрес") Тогда
		Если ЗначениеЗаполнено(СведенияОбУчастнике.ЮридическийАдрес) Тогда
			АдресXDTO = СоздатьОбъектXDTO(УчастникXDTO, "Адрес");
			АдресXDTO.Установить("Наим", СведенияОбУчастнике.ЮридическийАдрес);
			АдресXDTO.Установить("Тип", "ЮридическийАдрес");
			УчастникXDTO.Адрес.Добавить(АдресXDTO);
		КонецЕсли;
	ИначеЕсли СведенияОбУчастнике.Свойство("АдресРегистрации") Тогда
		АдресXDTO = СоздатьОбъектXDTO(УчастникXDTO, "Адрес");
		АдресXDTO.Установить("Наим", СведенияОбУчастнике.АдресРегистрации);
		АдресXDTO.Установить("Тип", "АдресРегистрации");
		УчастникXDTO.Адрес.Добавить(АдресXDTO);
	КонецЕсли;	
	
	ДокументXDTO[КемВыступает].Добавить(УчастникXDTO);
	
КонецПроцедуры

Процедура ЗаполнитьСведенияОДолжностномЛицеАктаОПриемеПередачеНФА(ДокументXDTO, ДолжностноеЛицо, КемВыступает, Организация = Неопределено, ДолжностьЛица = "")
	
	Должность = "";
	Фамилия = "";
	Имя = "";
	Отчество = "";
	Телефон = "";
	ЭлектронныйАдрес = "";
	
	Если ТипЗнч(ДолжностноеЛицо) = Тип("СправочникСсылка.Сотрудники") Тогда
		Данные = Новый Структура("СсылкаНаОбъект, Должность, Фамилия, Имя, Отчество, ТелефонРабочийФизическиеЛица, EmailФизическиеЛица",
			ДолжностноеЛицо, Должность, Фамилия, Имя, Отчество, Телефон, ЭлектронныйАдрес);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(Данные, Ложь, Истина);
		Фамилия = Данные.Фамилия;
		Имя = Данные.Имя;
		Отчество = Данные.Отчество;
		Должность = Данные.Должность;
		Телефон = Данные.ТелефонРабочийФизическиеЛица;
		ЭлектронныйАдрес = Данные.EmailФизическиеЛица;
	ИначеЕсли ТипЗнч(ДолжностноеЛицо) = Тип("СправочникСсылка.Пользователи") Тогда	
		Данные = ФИОФЛ(ДолжностноеЛицо.ФизическоеЛицо);
		Фамилия = Данные.Фамилия;
		Имя = Данные.Имя;
		Отчество = Данные.Отчество;
		
		СотрудникОтветственныйИсполнитель = ЗаполнениеРеквизитовОбъектов.ПолучитьОтветственногоИсполнителя(ДолжностноеЛицо, Организация);
		Если ЗначениеЗаполнено(СотрудникОтветственныйИсполнитель) Тогда
			Должность = Справочники.Сотрудники.ПолучитьСвойствоСотрудника(СотрудникОтветственныйИсполнитель, "Должность");
			
			Данные = Новый Структура("СсылкаНаОбъект, Должность, Фамилия, Имя, Отчество, ТелефонРабочийФизическиеЛица, EmailФизическиеЛица",
				СотрудникОтветственныйИсполнитель, Должность, Фамилия, Имя, Отчество, Телефон, ЭлектронныйАдрес);
			Справочники.Сотрудники.ПолучитьДанныеСотрудника(Данные, Ложь, Истина);
			
			Телефон = Данные.ТелефонРабочийФизическиеЛица;
			ЭлектронныйАдрес = Данные.EmailФизическиеЛица;
		КонецЕсли;	
	ИначеЕсли ТипЗнч(ДолжностноеЛицо) = Тип("Структура") Тогда	
		Фамилия = ДолжностноеЛицо.Фамилия;
		Имя = ДолжностноеЛицо.Имя;
		Отчество = ДолжностноеЛицо.Отчество;
		Должность = ДолжностноеЛицо.Должность;
	ИначеЕсли ТипЗнч(ДолжностноеЛицо) = Тип("СправочникСсылка.ФизическиеЛица") Тогда	
		Данные = ФИОФЛ(ДолжностноеЛицо);
		Фамилия = Данные.Фамилия;
		Имя = Данные.Имя;
		Отчество = Данные.Отчество;
		Должность = ДолжностьЛица;
	КонецЕсли;
	
	
	ДолжностноеЛицоXDTO = СоздатьОбъектXDTO(ДокументXDTO, КемВыступает);
	ДолжностноеЛицоXDTO.Установить("Должность", Строка(Должность));
	ДолжностноеЛицоXDTO.Установить("Фамилия", Строка(Фамилия));
	ДолжностноеЛицоXDTO.Установить("Имя", Строка(Имя));
	ДолжностноеЛицоXDTO.Установить("Отчество", Строка(Отчество));
	
	Если НЕ (КемВыступает = "РуководительОтправителя"
		ИЛИ КемВыступает = "РуководительПолучателя") Тогда
		КонтактXDTO = СоздатьОбъектXDTO(ДолжностноеЛицоXDTO, "Контакт");
		Если ЗначениеЗаполнено(Телефон) Тогда
			КонтактXDTO.Установить("Телефон", Строка(Телефон));
		КонецЕсли;
		Если ЗначениеЗаполнено(ЭлектронныйАдрес) Тогда
			КонтактXDTO.Установить("ЭлектронныйАдрес", Строка(ЭлектронныйАдрес));
		КонецЕсли;
		ДолжностноеЛицоXDTO.Установить("Контакт", КонтактXDTO);
	КонецЕсли;	
	
	ДокументXDTO[КемВыступает] = ДолжностноеЛицоXDTO;
	
КонецПроцедуры

Процедура ОбработкаИсходящегоЭлектронногоАктаОПриемеПередачеОбъектовНФА(ФайлXDTO, ДокументXDTO, ПараметрыФормирования, РезультатФормирования, СтруктураДанных, Отказ = Ложь)
	ПервичныйДокументаАкта = ПервичныеДокументыБГУКлиентСервер.ПервичныйДокумент("АктПриемаПередачи0510448");
	Реквизиты = "ВидПервичногоДокумента";
	ЗначенияРеквизитовПУД = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПервичныйДокументаАкта, Реквизиты);
	
	НаименованиеДокумента = ЗначенияРеквизитовПУД.ВидПервичногоДокумента;
	ВнутреннийКодФормата = "1.0.0.10";
	
	ДатаНеОпределена = Дата(1,1,1);

	ИспользуетсяПОД = ИспользуетсяПОД();	
	
	Если СтруктураДанных.ТипАкта = ТипАктаПередающейСтороны() Тогда
		ДокументУчета = СтруктураДанных.ДанныеАкта.Ссылка;
	Иначе	
		ДокументУчета = СтруктураДанных.ДокументОснование;
	КонецЕсли;
	
	МассивОбъектов = Новый Массив;
	МассивОбъектов.Добавить(ДокументУчета);
	ДанныеПечатнойФормыАкта = УправлениеПечатьюБГУ.ОбщиеСведенияДокументовДляПечати(МассивОбъектов);
	ДанныеПечатнойФормыАктаПоДокументу = ДанныеПечатнойФормыАкта.Получить(ДокументУчета); 
	
	Шапка = СтруктураДанных.ШапкаАкта;
	ДанныеАкта = СтруктураДанных.ДанныеАкта;
	ТаблицаНФА = СтруктураДанных.ТаблицаНФА;
	ТаблицаПаспортныеДанные = СтруктураДанных.ТаблицаПаспортныеДанные;
	ТаблицаПаспортныеДанныеДрагМатериалы = СтруктураДанных.ТаблицаПаспортныеДанныеДрагМатериалы;
	АдресаОбъектовНФА = СтруктураДанных.АдресаОбъектовНФА;
	ТаблицаДанныеДрагМатериалы = СтруктураДанных.ТаблицаДанныеДрагМатериалы;
	СведенияОПрослеживаемости = СтруктураДанных.СведенияОПрослеживаемости;
	СведенияКадастровогоУчета = СтруктураДанных.СведенияКадастровогоУчета;
	ОграниченияПоИнвентарнымОбъектам = СтруктураДанных.ОграниченияПоИнвентарнымОбъектам;
	МЦОбъектовНФАСДрагМатериалами = СтруктураДанных.МЦОбъектовНФАСДрагМатериалами;
	
	ПередаватьДополнительныеРеквизитыОбъектовНФА = ПередаватьДополнительныеРеквизитыОбъектовНФА(Шапка.Организация); 
	ПередаватьДополнительныеСведенияОбъектовНФА  = ПередаватьДополнительныеСведенияОбъектовНФА(Шапка.Организация);
	Если ПередаватьДополнительныеСведенияОбъектовНФА ИЛИ ПередаватьДополнительныеРеквизитыОбъектовНФА Тогда
		ДополнительныеСведенияИРеквизитыОбъектовНФА = СтруктураДанных.ДополнительныеСведенияИРеквизитыОбъектовНФА; 
	КонецЕсли;
	
	ФайлыАкта = СтруктураДанных.ФайлыАкта;
	ДолжностныеЛица = СтруктураДанных.ДолжностныеЛица;
	
	ИзготовителиНФА = Новый Массив;
	
	ПараметрыФормирования.ДатаФормирования = Шапка.Дата;
	РезультатФормирования.ДатаДокументаОтправителя = Шапка.Дата;

	Если ИспользуетсяПОД Тогда
		Реквизиты = "Номер, Дата";
		ЗначенияРеквизитовВнЭДО = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументУчета, Реквизиты);

		НомерИсходящегоДокумента = НомерДляПечати(ДокументУчета, ЗначенияРеквизитовВнЭДО.Номер);
		ДатаИсходящегоДокумента = ЗначенияРеквизитовВнЭДО.Дата;
		
		GUIDВнутреннегоЭлектронногоДокумента = "";
	Иначе	
		ВнутреннийЭД = СтруктураДанных.СведенияВнутреннегоЭДО;
		
		Если НЕ ЗначениеЗаполнено(ВнутреннийЭД) Тогда
			ШаблонСообщения = НСтр("ru = 'Внутренний электронный документ ""%1"" не найден.'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, НаименованиеДокумента);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			
			Отказ = Истина;
			
			Возврат;
		КонецЕсли;
		
		Реквизиты = "НомерДокумента, ДатаДокумента";
		ЗначенияРеквизитовВнЭДО = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВнутреннийЭД, Реквизиты);
		
		НомерИсходящегоДокумента = ЗначенияРеквизитовВнЭДО.НомерДокумента;
		ДатаИсходящегоДокумента = ЗначенияРеквизитовВнЭДО.ДатаДокумента;
		
		GUIDВнутреннегоЭлектронногоДокумента = Строка(ВнутреннийЭД.УникальныйИдентификатор());
	КонецЕсли;	
	ДокументXDTO.Установить("GUIDВнутреннегоЭлектронногоДокумента", GUIDВнутреннегоЭлектронногоДокумента);
	
