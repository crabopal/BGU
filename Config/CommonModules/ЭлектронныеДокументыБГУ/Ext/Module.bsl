	               |	ПередачаОбъектовИК.ИФО,
	               |	ВЫРАЗИТЬ(ПередачаОбъектовИК.КПСПродавца КАК Справочник.КлассификационныеПризнакиСчетов).ДатаНачалаДействия,
	               |	ВЫРАЗИТЬ(ПередачаОбъектовИК.РеквизитыЛицевогоСчета КАК Справочник.РеквизитыЛицевыхСчетов).Владелец,
	               |	ПередачаОбъектовИК.КПСПродавца
	               |ИЗ
	               |	Документ.ПередачаОбъектовИК КАК ПередачаОбъектовИК
	               |ГДЕ
	               |	ПередачаОбъектовИК.Ссылка = &Ссылка
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(НакладнаяНаОтпускМ15.КодЦелиПродавца КАК Справочник.ВидыЦелевыхСредств).Код,
	               |	ВЫРАЗИТЬ(НакладнаяНаОтпускМ15.Договор КАК Справочник.Договоры).ДатаДоговора,
	               |	ВЫРАЗИТЬ(НакладнаяНаОтпускМ15.Договор КАК Справочник.Договоры).НомерДоговора,
	               |	ВЫРАЗИТЬ(ВЫРАЗИТЬ(НакладнаяНаОтпускМ15.РеквизитыЛицевогоСчета КАК Справочник.РеквизитыЛицевыхСчетов).Владелец КАК Справочник.ЛицевыеСчета).Код,
	               |	ВЫРАЗИТЬ(ВЫРАЗИТЬ(ВЫРАЗИТЬ(НакладнаяНаОтпускМ15.РеквизитыЛицевогоСчета КАК Справочник.РеквизитыЛицевыхСчетов).СчетКазначейства КАК Справочник.БанковскиеИКазначейскиеСчета).Владелец КАК Справочник.Казначейства).Код,
	               |	ВЫРАЗИТЬ(ВЫРАЗИТЬ(ВЫРАЗИТЬ(НакладнаяНаОтпускМ15.РеквизитыЛицевогоСчета КАК Справочник.РеквизитыЛицевыхСчетов).СчетКазначейства КАК Справочник.БанковскиеИКазначейскиеСчета).Владелец КАК Справочник.Казначейства).НаименованиеПолное,
	               |	НакладнаяНаОтпускМ15.Организация,
	               |	НакладнаяНаОтпускМ15.ИФО,
	               |	ВЫРАЗИТЬ(НакладнаяНаОтпускМ15.КПСПродавца КАК Справочник.КлассификационныеПризнакиСчетов).ДатаНачалаДействия,
	               |	ВЫРАЗИТЬ(НакладнаяНаОтпускМ15.РеквизитыЛицевогоСчета КАК Справочник.РеквизитыЛицевыхСчетов).Владелец,
	               |	НакладнаяНаОтпускМ15.КПСПродавца
	               |ИЗ
	               |	Документ.НакладнаяНаОтпускМ15 КАК НакладнаяНаОтпускМ15
	               |ГДЕ
	               |	НакладнаяНаОтпускМ15.Ссылка = &Ссылка
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(КассовоеПоступлениеРасшифровкаПлатежа.КодЦели КАК Справочник.ВидыЦелевыхСредств).Код,
	               |	ВЫРАЗИТЬ(КассовоеПоступлениеРасшифровкаПлатежа.Договор КАК Справочник.Договоры).ДатаДоговора,
	               |	ВЫРАЗИТЬ(КассовоеПоступлениеРасшифровкаПлатежа.Договор КАК Справочник.Договоры).НомерДоговора,
	               |	ВЫРАЗИТЬ(КассовоеПоступлениеРасшифровкаПлатежа.Ссылка.ЛицевойСчет КАК Справочник.ЛицевыеСчета).Код,
	               |	&КазначействоПродавцаКодПоЛС,
	               |	&КазначействоПродавцаНаименованиеПоЛС,
	               |	КассовоеПоступлениеРасшифровкаПлатежа.Ссылка.Организация,
	               |	КассовоеПоступлениеРасшифровкаПлатежа.Ссылка.ИФО,
	               |	ВЫРАЗИТЬ(КассовоеПоступлениеРасшифровкаПлатежа.КБКНазначениеПлатежа КАК Справочник.КлассификационныеПризнакиСчетов).ДатаНачалаДействия,
	               |	КассовоеПоступлениеРасшифровкаПлатежа.Ссылка.ЛицевойСчет,
	               |	КассовоеПоступлениеРасшифровкаПлатежа.КБКНазначениеПлатежа
	               |ИЗ
	               |	Документ.КассовоеПоступление.РасшифровкаПлатежа КАК КассовоеПоступлениеРасшифровкаПлатежа
	               |ГДЕ
	               |	КассовоеПоступлениеРасшифровкаПлатежа.Ссылка = &Ссылка
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(ЭлектронныйПередаточныйДокументУслугиРаботы.КодЦелиПродавца КАК Справочник.ВидыЦелевыхСредств).Код,
	               |	ВЫРАЗИТЬ(ЭлектронныйПередаточныйДокументУслугиРаботы.Договор КАК Справочник.Договоры).ДатаДоговора,
	               |	ВЫРАЗИТЬ(ЭлектронныйПередаточныйДокументУслугиРаботы.Договор КАК Справочник.Договоры).НомерДоговора,
	               |	ВЫРАЗИТЬ(ВЫРАЗИТЬ(ЭлектронныйПередаточныйДокументУслугиРаботы.РеквизитыЛицевогоСчета КАК Справочник.РеквизитыЛицевыхСчетов).Владелец КАК Справочник.ЛицевыеСчета).Код,
	               |	ВЫРАЗИТЬ(ВЫРАЗИТЬ(ВЫРАЗИТЬ(ЭлектронныйПередаточныйДокументУслугиРаботы.РеквизитыЛицевогоСчета КАК Справочник.РеквизитыЛицевыхСчетов).СчетКазначейства КАК Справочник.БанковскиеИКазначейскиеСчета).Владелец КАК Справочник.Казначейства).Код,
	               |	ВЫРАЗИТЬ(ВЫРАЗИТЬ(ВЫРАЗИТЬ(ЭлектронныйПередаточныйДокументУслугиРаботы.РеквизитыЛицевогоСчета КАК Справочник.РеквизитыЛицевыхСчетов).СчетКазначейства КАК Справочник.БанковскиеИКазначейскиеСчета).Владелец КАК Справочник.Казначейства).НаименованиеПолное,
	               |	ЭлектронныйПередаточныйДокументУслугиРаботы.Организация,
	               |	ЭлектронныйПередаточныйДокументУслугиРаботы.ДокументОснование.ИФО,
	               |	ВЫРАЗИТЬ(ЭлектронныйПередаточныйДокументУслугиРаботы.КПСПродавца КАК Справочник.КлассификационныеПризнакиСчетов).ДатаНачалаДействия,
	               |	ВЫРАЗИТЬ(ЭлектронныйПередаточныйДокументУслугиРаботы.РеквизитыЛицевогоСчета КАК Справочник.РеквизитыЛицевыхСчетов).Владелец,
	               |	ЭлектронныйПередаточныйДокументУслугиРаботы.КПСПродавца
	               |ИЗ
	               |	Документ.ЭлектронныйПередаточныйДокументУслугиРаботы КАК ЭлектронныйПередаточныйДокументУслугиРаботы
	               |ГДЕ
	               |	ЭлектронныйПередаточныйДокументУслугиРаботы.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ДокументРеализации);
	Запрос.УстановитьПараметр("КазначействоПродавцаКодПоЛС", КазначействоПродавцаКодПоЛС);
	Запрос.УстановитьПараметр("КазначействоПродавцаНаименованиеПоЛС", КазначействоПродавцаНаименованиеПоЛС);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		КБКПродавца = ГосУслуги.ПолучитьКодБК(Выборка.Организация, Выборка.КПСПродавца, , Выборка.ДатаНачалаДействия, Выборка.ИФО, Выборка.ЛицевойСчет); 
		
		Результат.Вставить("КодБюджетнойКлассификацииПродавца", КБКПродавца);
		Результат.Вставить("КодЦели", СокрЛП(Выборка.КодЦели));
		Результат.Вставить("ДатаГосКонтракта", Выборка.ДатаГосКонтракта);
		Результат.Вставить("НомерГосКонтракта", Выборка.НомерГосКонтракта);
		Результат.Вставить("НомерЛицевогоСчетаПродавца", СокрЛП(Выборка.НомерЛицевогоСчетаПродавца));
		Результат.Вставить("КазначействоПродавцаКод", СокрЛП(Выборка.КазначействоПродавцаКод));
		Результат.Вставить("КазначействоПродавцаНаименование", СокрЛП(Выборка.КазначействоПродавцаНаименование));
	КонецЦикла;	
	
	Возврат Результат;
КонецФункции

Функция ПолучитьАдресКЛАДР(Коллекция)
	
	АдресКЛАДР = Новый Структура("
		|Индекс,
		|КодРегиона,
		|Район,
		|Город,
		|НаселенныйПункт,
		|Улица,
		|Дом,
		|Корпус,
		|Квартира");
	
	ЗаполнитьЗначенияСвойств(АдресКЛАДР, Коллекция);
	
	СокращенияОбъектов = СокращенияОбъектовАдресацииАдресаРФ();
	
	АдресКЛАДР.Район = ПредставлениеЭлементаАдреса(Коллекция.РайонТипКраткий, Коллекция.Район, СокращенияОбъектов);
	
	АдресКЛАДР.Город = ПредставлениеЭлементаАдреса(Коллекция.ГородТипКраткий, Коллекция.Город, СокращенияОбъектов);
	
	АдресКЛАДР.НаселенныйПункт = ПредставлениеЭлементаАдреса(Коллекция.НаселенныйПунктТипКраткий, Коллекция.НаселенныйПункт, СокращенияОбъектов);
	
	АдресКЛАДР.Улица = ПредставлениеЭлементаАдреса(Коллекция.УлицаТипКраткий, Коллекция.Улица, СокращенияОбъектов);
	
	Территория = ПредставлениеЭлементаАдреса(Коллекция.ТерриторияТипКраткий, Коллекция.Территория, СокращенияОбъектов);
	
	Если ЗначениеЗаполнено(Территория) Тогда
		Если ЗначениеЗаполнено(АдресКЛАДР.Улица) Тогда
			АдресКЛАДР.Улица = Территория + ", " + АдресКЛАДР.Улица;
		Иначе
			АдресКЛАДР.НаселенныйПункт = АдресКЛАДР.НаселенныйПункт
				+ ?(ЗначениеЗаполнено(АдресКЛАДР.НаселенныйПункт), ", ", "")
				+ Территория;
		КонецЕсли;
	КонецЕсли;
	
	// Дом
	
	Дом = "";
	
	Если Коллекция.Свойство("Здание") Тогда
		Если Коллекция.Здание.Количество() > 0 Тогда
			Дом = ПредставлениеЭлементаАдреса(Коллекция.Здание.ТипЗдания, Коллекция.Здание.Номер, СокращенияОбъектов);
		КонецЕсли;
	КонецЕсли;
	
	АдресКЛАДР.Вставить("Дом", Дом);
	
	НомерЗемельногоУчастка = Коллекция.НомерЗемельногоУчастка;
	
	Если ЗначениеЗаполнено(НомерЗемельногоУчастка) Тогда
		НомерЗемельногоУчастка = "з/у " + НомерЗемельногоУчастка;
		
		Если ЗначениеЗаполнено(АдресКЛАДР.Дом) Тогда
			АдресКЛАДР.Дом = НомерЗемельногоУчастка + ", " + АдресКЛАДР.Дом;
		Иначе
			АдресКЛАДР.Улица = АдресКЛАДР.Улица
				+ ?(ЗначениеЗаполнено(АдресКЛАДР.Улица), ", ", "")
				+ НомерЗемельногоУчастка;
		КонецЕсли;
	КонецЕсли;
	
	// Корпус
	
	ВремМассив = Новый Массив();
	
	Если Коллекция.Свойство("Корпуса") Тогда
		Для Каждого Корпус Из Коллекция.Корпуса Цикл
			ВремМассив.Добавить(ПредставлениеЭлементаАдреса(Корпус.ТипКорпуса, Корпус.Номер, СокращенияОбъектов));
		КонецЦикла;
	КонецЕсли;
	
	Корпус = СтрСоединить(ВремМассив, ", ");
	
	АдресКЛАДР.Вставить("Корпус", Корпус);
	
	// Квартира
	
	ВремМассив = Новый Массив();
	
	Если Коллекция.Свойство("Помещения") Тогда
		Для Каждого Помещение Из Коллекция.Помещения Цикл
			ВремМассив.Добавить(ПредставлениеЭлементаАдреса(Помещение.ТипПомещения, Помещение.Номер, СокращенияОбъектов));
		КонецЦикла;
	КонецЕсли;
	
	Квартира = СтрСоединить(ВремМассив, ", ");
	
	АдресКЛАДР.Вставить("Квартира", Квартира);
	
	Возврат АдресКЛАДР;
	
КонецФункции

Функция СокращенияОбъектовАдресацииАдресаРФ()
	
	// Приводит оригинальные сокращения к нижнему регистру строк
	
	ОригинальныеСокращенияОбъектов = РаботаСАдресами.СокращенияОбъектовАдресацииАдресаРФ();
	
	СокращенияОбъектов = Новый Соответствие();
	
	Для Каждого ОригинальноеСокращение Из ОригинальныеСокращенияОбъектов Цикл
		
		СокращенияОбъектов.Вставить(НРег(ОригинальноеСокращение.Ключ), НРег(ОригинальноеСокращение.Значение));
		
	КонецЦикла;
	
	Возврат СокращенияОбъектов;
	
КонецФункции

Функция ПредставлениеЭлементаАдреса(Знач ТипЭлемента, Знач ЗначениеЭлемента, Знач СокращенияОбъектов)
	
	// СокращенияОбъектов должны содержать строки в нижнем регистре, поскольку на это рассчитывает поиск
	
	Если НЕ ЗначениеЗаполнено(ЗначениеЭлемента) Тогда
		Возврат "";
	КонецЕсли;
	
	Сокращение = "";
	
	Если ЗначениеЗаполнено(ТипЭлемента) Тогда
		Сокращение = СокращенияОбъектов.Получить(НРег(Строка(ТипЭлемента)));
		
		Если Сокращение = Неопределено Тогда
			Сокращение = НРег(Строка(ТипЭлемента));
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(ЗначениеЭлемента) = Тип("Число") Тогда
		ПредставлениеЗначения = Формат(ЗначениеЭлемента, "ЧГ=0");
	Иначе
		ПредставлениеЗначения = ЗначениеЭлемента;
	КонецЕсли;
	
	Возврат ?(ЗначениеЗаполнено(Сокращение), Сокращение + " ", "") + ПредставлениеЗначения;
	
КонецФункции

Функция ФорматПоВидуДокумента(Контрагент, Организация, ВидДокумента) Экспорт
	Результат = "";
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ЗначениеЗаполнено(Контрагент) И ЗначениеЗаполнено(Организация) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
					"ВЫБРАТЬ ПЕРВЫЕ 1
					|	НастройкиОтправкиЭлектронныхДокументов.ВерсияФормата КАК ВерсияФормата
					|ИЗ
					|	РегистрСведений.НастройкиОтправкиЭлектронныхДокументовПоВидам КАК НастройкиОтправкиЭлектронныхДокументов
					|ГДЕ
					|	НастройкиОтправкиЭлектронныхДокументов.Получатель = &Контрагент
					|	И НастройкиОтправкиЭлектронныхДокументов.Отправитель = &Организация
					|	И НЕ НастройкиОтправкиЭлектронныхДокументов.ИдентификаторПолучателя = """"
					|	И НастройкиОтправкиЭлектронныхДокументов.ВидДокумента = &ВидДокумента";
		
		Запрос.УстановитьПараметр("Организация", Организация);
		Запрос.УстановитьПараметр("Контрагент", Контрагент);
		Запрос.УстановитьПараметр("ВидДокумента", ВидДокумента);
		РезультатЗапроса = Запрос.Выполнить().Выгрузить();
		
		Если РезультатЗапроса.Количество() > 0 Тогда
			Результат = РезультатЗапроса[0].ВерсияФормата;
		КонецЕсли;	
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция ФорматЭДСчетНаОплату(ВерсияФормата) Экспорт
	Результат = 0;
	Если СтрНайти(ВерсияФормата, "CML") > 0 Тогда
		Результат = 0;
	ИначеЕсли СтрНайти(ВерсияФормата, "ON_CHETOP") > 0 Тогда
		Результат = 2;
	КонецЕсли;	
		
	Возврат Результат;
КонецФункции

Функция ДляДокументаНеСоздаватьЭД(ДокументУчета)
	Результат = Ложь;

	Если (ТипЗнч(ДокументУчета) = Тип("ДокументОбъект.АктПриемкиТоваровРаботУслуг")
			ИЛИ ТипЗнч(ДокументУчета) = Тип("ДокументОбъект.АктСверкиВзаиморасчетов")) Тогда

		Результат = НЕ ДокументУчета.ЭтоЭлектронныйДокумент;
	КонецЕсли;
		
	Возврат Результат;
КонецФункции

Функция ДляДокументаНеобходимоФормироватьУПД(ДокументУчета)
	Результат = Истина;
	
	Если ТипЗнч(ДокументУчета) = Тип("ДокументОбъект.НакладнаяНаРеализациюТорг12")
		ИЛИ ТипЗнч(ДокументУчета) = Тип("ДокументОбъект.НакладнаяНаОтпускМ15")
		ИЛИ ТипЗнч(ДокументУчета) = Тип("ДокументОбъект.ПередачаОбъектовОС")
		ИЛИ ТипЗнч(ДокументУчета) = Тип("ДокументОбъект.ПередачаОбъектовИК") Тогда

		Результат = Ложь;
		
		Если ЗначениеЗаполнено(ДокументУчета.РеквизитыЛицевогоСчета) Тогда
			Результат = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция ДляДокументаНеобходимоФормироватьЭлектронныйДоговор(ДокументУчета)
	Результат = Истина;
	
	Если ТипЗнч(ДокументУчета) = Тип("СправочникОбъект.Договоры") Тогда
		
		Результат = Ложь;
		
		Если ДокументУчета.ЭтоЭлектронныйДокумент Тогда
			Результат = Истина;
		КонецЕсли;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область ПрикладныеЭлектронныеДокументы

// См. ОбменСКонтрагентамиПереопределяемый.ПриОпределенииПрикладныхТиповЭлектронныхДокументов.
Процедура ПриОпределенииПрикладныхТиповЭлектронныхДокументов(ВидыЭлектронныхДокументов) Экспорт
	
	ВидыЭлектронныхДокументов.Добавить(Перечисления.ПрикладныеВидыЭлектронныхДокументовБГУ.Извещение);
	ВидыЭлектронныхДокументов.Добавить(Перечисления.ПрикладныеВидыЭлектронныхДокументовБГУ.АктОПриемеПередачеОбъектовНФА);
	
КонецПроцедуры
	
// См. ОбменСКонтрагентамиПереопределяемый.ПриОпределенииСведенийОПрикладныхФорматах.
Процедура ПриОпределенииСведенийОПрикладныхФорматах(ТаблицаФорматов) Экспорт
	
	ВерсияФормата = ТаблицаФорматов.Добавить();
	ВерсияФормата.ПрикладнойТипДокумента = 
		Перечисления.ПрикладныеВидыЭлектронныхДокументовБГУ.Извещение;
	ВерсияФормата.ИдентификаторФормата = "Извещение 1.0";
	ВерсияФормата.ПредставлениеФормата = НСтр("ru = 'Извещение 1.0'");

	ВерсияФормата = ТаблицаФорматов.Добавить();
	ВерсияФормата.ПрикладнойТипДокумента = 
		Перечисления.ПрикладныеВидыЭлектронныхДокументовБГУ.АктОПриемеПередачеОбъектовНФА;
	ВерсияФормата.ИдентификаторФормата = "Акт о приеме-передаче объектов НФА 1.0";
	ВерсияФормата.ПредставлениеФормата = НСтр("ru = 'Акт о приеме-передаче объектов НФА 1.0'");
	
КонецПроцедуры

// Определяет настройки регламента электронного документооборота для прикладных видов электронных документов.
//
// Параметры:
//  Настройки - Структура - 
//     * ТребуетсяИзвещениеОПолучении - Булево - По данному признаку, на стороне получателя определяется необходимость отправки извещения о получении.
//     * ТребуетсяОтветнаяПодпись     - Булево - По данному признаку, на стороне получателя определяется, требуется ответное подписание документа.
//     * РедактироватьПодпись         - Булево - Признак редактирования параметра "Подписывать документ" в форме настроек регламента ЭДО.
//     * РедактироватьИзвещение       - Булево - Признак редактирования параметра "Ожидать извещение о получении" в форме настроек регламента ЭДО.
//     * РедактироватьОтветнуюПодпись - Булево - Признак редактирования параметра "Ожидать ответную подпись" в форме настроек регламента ЭДО.
//  ВидЭлектронногоДокумента - ОпределяемыйТип.ПрикладныеВидыЭлектронныхДокументов - Ссылка на прикладной вид электронного документа.
//  ВерсияФормата            - Строка - Текстовый идентификатор формата соответствующего прикладного вида электронного документа.
//  СтандартнаяОбработка     - Булево - Признак использования настроек регламента по умолчанию.
//          Если Ложь, то используются данные из параметра Настройки. По умолчанию Истина.
//
Процедура ПриОпределенииНастроекРегламентаЭДО(Настройки, ТипЭлектронногоДокумента, ВерсияФормата, СтандартнаяОбработка) Экспорт
	
	Если ТипЭлектронногоДокумента =
		Перечисления.ПрикладныеВидыЭлектронныхДокументовБГУ.Извещение Тогда
		
		СтандартнаяОбработка = Ложь;
		Настройки.Вставить("ТребуетсяИзвещениеОПолучении", Истина);
		Настройки.Вставить("ТребуетсяОтветнаяПодпись",     Истина);
		Настройки.Вставить("РедактироватьПодпись",         Ложь);
		Настройки.Вставить("РедактироватьИзвещение",       Истина);
		Настройки.Вставить("РедактироватьОтветнуюПодпись", Ложь);
		
	ИначеЕсли ТипЭлектронногоДокумента =
		Перечисления.ПрикладныеВидыЭлектронныхДокументовБГУ.АктОПриемеПередачеОбъектовНФА Тогда

		СтандартнаяОбработка = Ложь;
		Настройки.Вставить("ТребуетсяИзвещениеОПолучении", Истина);
		Настройки.Вставить("ТребуетсяОтветнаяПодпись",     Истина);
		Настройки.Вставить("РедактироватьПодпись",         Ложь);
		Настройки.Вставить("РедактироватьИзвещение",       Истина);
		Настройки.Вставить("РедактироватьОтветнуюПодпись", Ложь);
		
	КонецЕсли;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПриОпределенииТиповУчетныхДокументовПоВидуПрикладногоЭлектронногоДокумента.
Процедура ПриОпределенииТиповУчетныхДокументовПоПрикладномуВидуЭлектронногоДокумента(ТипЭлектронногоДокумента, ТипыУчетныхДокументов) Экспорт
	
	Если ТипЭлектронногоДокумента = 
		Перечисления.ПрикладныеВидыЭлектронныхДокументовБГУ.Извещение Тогда
		ИзвещениеВходящееПустаяСсылка = Документы.ИзвещениеВходящее.ПустаяСсылка();
		ТипыУчетныхДокументов.Добавить(ИзвещениеВходящееПустаяСсылка, ИзвещениеВходящееПустаяСсылка.Метаданные().Представление());
		
	ИначеЕсли ТипЭлектронногоДокумента = 
		Перечисления.ПрикладныеВидыЭлектронныхДокументовБГУ.АктОПриемеПередачеОбъектовНФА Тогда

		ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийПустаяСсылка = Документы.ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий.ПустаяСсылка();
		ТипыУчетныхДокументов.Добавить(ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийПустаяСсылка, 
			ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийПустаяСсылка.Метаданные().Представление());
		
	КонецЕсли;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПриОпределенииСоответствияИсходящихПрикладныхВидовДокументамУчета.
Процедура ПриОпределенииСоответствияИсходящихПрикладныхВидовДокументамУчета(СоответствиеВидовДокументам) Экспорт 
	
	СоответствиеВидовДокументам.Вставить(Перечисления.ПрикладныеВидыЭлектронныхДокументовБГУ.Извещение,
		НСтр("ru = 'Извещение'"));
	СоответствиеВидовДокументам.Вставить(Перечисления.ПрикладныеВидыЭлектронныхДокументовБГУ.АктОПриемеПередачеОбъектовНФА,
		НСтр("ru = 'Акт о приеме-передаче объектов НФА'"));
		
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПриОпределенииСпособовОбработкиПрикладногоВидаЭлектронногоДокумента.
Процедура ПриОпределенииСпособовОбработкиПрикладногоВидаЭлектронногоДокумента(ТипЭлектронногоДокумента, СпособыОбработки) Экспорт
	
	Если ТипЭлектронногоДокумента = 
		Перечисления.ПрикладныеВидыЭлектронныхДокументовБГУ.Извещение Тогда
		
		СпособыОбработки.Добавить("ИзвещениеВходящее",
			НСтр("ru = 'Извещение'"), Истина);
			
	ИначеЕсли ТипЭлектронногоДокумента = 
		Перечисления.ПрикладныеВидыЭлектронныхДокументовБГУ.АктОПриемеПередачеОбъектовНФА Тогда
		
		СпособыОбработки.Добавить("ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий",
			НСтр("ru = 'Акт о приеме-передаче объектов НФА'"), Истина);
	КонецЕсли;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПриОпределенииСпособовОбработкиПрикладногоВидаЭлектронногоДокумента.
Процедура ПриОпределенииСоставаКомандЭДООснованияПрикладногоЭлектронногоДокумента(СоставКомандЭДО) Экспорт
	
	СоставКомандЭДО.Исходящие.Добавить("Документ.ИзвещениеИсходящее");
	СоставКомандЭДО.Входящие.Добавить("Документ.ИзвещениеВходящее");

	СоставКомандЭДО.Исходящие.Добавить("Документ.ЭлектронныйАктОПриемеПередачеОбъектовНФАИсходящий");
	СоставКомандЭДО.Входящие.Добавить("Документ.ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий");
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПриОпределенииПараметровПрикладногоЭлектронногоДокументаПоИсточнику.
Процедура ПриОпределенииПараметровПрикладногоЭлектронногоДокументаПоИсточнику(Источник, Параметры) Экспорт
	
	ТипИсточника = ТипЗнч(Источник);
	ЭтоСсылка = ОбщегоНазначения.ЭтоСсылка(ТипИсточника);
	
	Если ТипИсточника = Тип("ДокументСсылка.ИзвещениеВходящее")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.ИзвещениеВходящее") Тогда
		
		Реквизиты = "Организация, Отправитель, Поставщик, Договор, ВидИзвещения, ТипЭлектронногоИзвещения";
		
		Если ЭтоСсылка Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, Реквизиты);
		Иначе
			ЗначенияРеквизитов = Новый Структура(Реквизиты);
			ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, Источник);
		КонецЕсли;
		
		Параметры.Вставить("Поставщик");
		Параметры.Вставить("ТипЭлектронногоИзвещения");
		
		Параметры.ПрикладнойТипДокумента = 
			Перечисления.ПрикладныеВидыЭлектронныхДокументовБГУ.Извещение;
		Параметры.Входящий          					= Истина;
		Параметры.Организация       					= ЗначенияРеквизитов.Организация;
		Параметры.Контрагент       						= ЗначенияРеквизитов.Отправитель;
		Параметры.ДоговорКонтрагента					= ЗначенияРеквизитов.Договор;
		Параметры.Поставщик       						= ЗначенияРеквизитов.Поставщик;
		Параметры.ТипЭлектронногоИзвещения       		= ЗначенияРеквизитов.ТипЭлектронногоИзвещения;
		
	ИначеЕсли ТипИсточника = Тип("ДокументСсылка.ИзвещениеИсходящее")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.ИзвещениеИсходящее") Тогда
		
		Реквизиты = "Организация, Получатель, Поставщик, Договор, ВидИзвещения, ТипЭлектронногоИзвещения";
		
		Если ЭтоСсылка Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, Реквизиты);
		Иначе
			ЗначенияРеквизитов = Новый Структура(Реквизиты);
			ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, Источник);
		КонецЕсли;
		
		Параметры.Вставить("Поставщик");
		Параметры.Вставить("ТипЭлектронногоИзвещения");
		
		Параметры.ПрикладнойТипДокумента = 
			Перечисления.ПрикладныеВидыЭлектронныхДокументовБГУ.Извещение;
		Параметры.Входящий          					= Ложь;
		Параметры.Организация       					= ЗначенияРеквизитов.Организация;
		Параметры.Контрагент       						= ЗначенияРеквизитов.Получатель;
		Параметры.ДоговорКонтрагента					= ЗначенияРеквизитов.Договор;
		Параметры.Поставщик       						= ЗначенияРеквизитов.Поставщик;
		Параметры.ТипЭлектронногоИзвещения       		= ЗначенияРеквизитов.ТипЭлектронногоИзвещения;
		
	ИначеЕсли ТипИсточника = Тип("ДокументСсылка.ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий") Тогда
		
		Реквизиты = "Организация, Контрагент, Договор, ТипЭлектронногоАкта";
		
		Если ЭтоСсылка Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, Реквизиты);
		Иначе
			ЗначенияРеквизитов = Новый Структура(Реквизиты);
			ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, Источник);
		КонецЕсли;
		
		Параметры.Вставить("ТипЭлектронногоАкта");
		
		Параметры.ПрикладнойТипДокумента = 
			Перечисления.ПрикладныеВидыЭлектронныхДокументовБГУ.АктОПриемеПередачеОбъектовНФА;
		Параметры.Входящий          					= Истина;
		Параметры.Организация       					= ЗначенияРеквизитов.Организация;
		Параметры.Контрагент       						= ЗначенияРеквизитов.Контрагент;
		Параметры.ДоговорКонтрагента					= ЗначенияРеквизитов.Договор;
		Параметры.ТипЭлектронногоАкта       			= ЗначенияРеквизитов.ТипЭлектронногоАкта;
		
	ИначеЕсли ТипИсточника = Тип("ДокументСсылка.ЭлектронныйАктОПриемеПередачеОбъектовНФАИсходящий")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.ЭлектронныйАктОПриемеПередачеОбъектовНФАИсходящий") Тогда
		
		Реквизиты = "Организация, Контрагент, Договор, ТипЭлектронногоАкта";
		
		Если ЭтоСсылка Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, Реквизиты);
		Иначе
			ЗначенияРеквизитов = Новый Структура(Реквизиты);
			ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, Источник);
		КонецЕсли;
		
		Параметры.Вставить("ТипЭлектронногоАкта");
		
		Параметры.ПрикладнойТипДокумента = 
			Перечисления.ПрикладныеВидыЭлектронныхДокументовБГУ.АктОПриемеПередачеОбъектовНФА;
		Параметры.Входящий          					= Ложь;
		Параметры.Организация       					= ЗначенияРеквизитов.Организация;
		Параметры.Контрагент       						= ЗначенияРеквизитов.Контрагент;
		Параметры.ДоговорКонтрагента					= ЗначенияРеквизитов.Договор;
		Параметры.ТипЭлектронногоАкта		       		= ЗначенияРеквизитов.ТипЭлектронногоАкта;

	КонецЕсли;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПриПолученииОписанияОснованияПрикладногоЭлектронногоДокумента.
Процедура ПриПолученииОписанияОснованияПрикладногоЭлектронногоДокумента(ОснованиеОбъект, Описание, СтандартнаяОбработка) Экспорт
	
	ТипОснования = ТипЗнч(ОснованиеОбъект);
	Если ТипОснования = Тип("ДокументОбъект.ИзвещениеИсходящее") Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Описание.Организация = ОснованиеОбъект.Организация;
		Описание.Получатель  = ОснованиеОбъект.Получатель;
		Описание.ДатаВходящегоДокумента  = ОснованиеОбъект.Дата;
		Описание.НомерВходящегоДокумента = ОснованиеОбъект.Номер;
		Описание.Вид = ОснованиеОбъект.Метаданные().Синоним;
		
	ИначеЕсли ТипОснования = Тип("ДокументОбъект.ЭлектронныйАктОПриемеПередачеОбъектовНФАИсходящий") Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Описание.Организация = ОснованиеОбъект.Организация;
		Описание.Получатель  = ОснованиеОбъект.Контрагент;
		Описание.ДатаПервичногоДокумента  = ОснованиеОбъект.Дата;
		Описание.НомерПервичногоДокумента = ОснованиеОбъект.Номер;
		Описание.Вид = ОснованиеОбъект.Метаданные().Синоним;
		
	КонецЕсли;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ОпределитьПараметрыФайлаПрикладногоЭлектронногоДокумента.
Процедура ПриОпределенииПараметровФайлаПрикладногоЭлектронногоДокумента(ДанныеФайла, РасширениеФайла, Параметры) Экспорт
	
	Если РасширениеФайла <> "xml" Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		Поток = ДанныеФайла.ОткрытьПотокДляЧтения();
		
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.ОткрытьПоток(Поток);
		
		Если ЧтениеXML.Прочитать() И ЧтениеXML.Имя = "Файл" Тогда
			Если ЧтениеXML.ПолучитьАтрибут("ИдФорм") = "ЭДОБГУИзвещение" Тогда
			
				Параметры.ТипЭлектронногоДокумента = Перечисления.ПрикладныеВидыЭлектронныхДокументовБГУ.Извещение;
				Параметры.НаименованиеДокументаОтправителя = Метаданные.Документы.ИзвещениеИсходящее.Синоним;
				
				Если ЧтениеXML.Прочитать() И ЧтениеXML.Имя = "Документ" Тогда
					Параметры.НомерДокументаОтправителя = ЧтениеXML.ПолучитьАтрибут("Номер");
					Параметры.ДатаДокументаОтправителя  = СтроковыеФункцииКлиентСервер.СтрокаВДату(ЧтениеXML.ПолучитьАтрибут("Дата"));
				КонецЕсли;
			ИначеЕсли ЧтениеXML.ПолучитьАтрибут("ИдФорм") = "ЭДОБГУАктОПриемеПередачеОбъектовНФА" Тогда
			
				Параметры.ТипЭлектронногоДокумента = Перечисления.ПрикладныеВидыЭлектронныхДокументовБГУ.АктОПриемеПередачеОбъектовНФА;
				Параметры.НаименованиеДокументаОтправителя = Метаданные.Документы.ЭлектронныйАктОПриемеПередачеОбъектовНФАИсходящий.Синоним;
				
				Если ЧтениеXML.Прочитать() И ЧтениеXML.Имя = "Документ" Тогда
					Параметры.НомерДокументаОтправителя = ЧтениеXML.ПолучитьАтрибут("Номер");
					Параметры.ДатаДокументаОтправителя  = СтроковыеФункцииКлиентСервер.СтрокаВДату(ЧтениеXML.ПолучитьАтрибут("Дата"));
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;
		
		ЧтениеXML.Закрыть();
		Поток.Закрыть();
	Исключение
	КонецПопытки;
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПриСозданииОбъектовУчетаИзФайлаПрикладногоЭлектронногоДокумента.
Процедура ПриСозданииОбъектовУчетаИзФайлаПрикладногоЭлектронногоДокумента(ПараметрыФайлаЭлектронногоДокумента, СсылкиНаОбъекты) Экспорт
	ТипПрикладногоДокумента = "";
	ПространствоИменФормата = "";
	
	Если ПараметрыФайлаЭлектронногоДокумента.СпособОбработки = "ИзвещениеВходящее" Тогда // СпособОбработки см. СписокОперацийВидаЭД.
		ТипПрикладногоДокумента = "ИзвещениеВходящее";
		ПространствоИменФормата = "ON_BGU_IZV";
	ИначеЕсли ПараметрыФайлаЭлектронногоДокумента.СпособОбработки = "ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий" Тогда // СпособОбработки см. СписокОперацийВидаЭД.
		ТипПрикладногоДокумента = "ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий";
		ПространствоИменФормата = ПространствоИменФорматаАктаОПриемеПередачеНФА0510448();
	Иначе	
		Возврат;
	КонецЕсли;
	
	Поток = ПараметрыФайлаЭлектронногоДокумента.ДанныеФайла.ОткрытьПотокДляЧтения();
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьПоток(Поток);
	
	ПостроительDOM = Новый ПостроительDOM;
	ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
	ЧтениеXML.Закрыть();
	Поток.Закрыть();
	
	ДокументDOM.ЭлементДокумента.УстановитьСоответствиеПространстваИмен("", ПространствоИменФормата);
	
	Поток = Новый ПотокВПамяти;
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьПоток(Поток);
	
	ЗаписьDOM = Новый ЗаписьDOM;
	ЗаписьDOM.Записать(ДокументDOM, ЗаписьXML);
	ЗаписьXML.Закрыть();
	
	Поток.Перейти(0, ПозицияВПотоке.Начало);
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьПоток(Поток);
	
	ФайлXDTO = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML, ФабрикаXDTO.Тип(ПространствоИменФормата, "Файл"));
	
	ЧтениеXML.Закрыть();
	Поток.Закрыть();
	
	ДокументXDTO = ФайлXDTO.Документ;
	
	ДатаЭД = СтроковыеФункцииКлиентСервер.СтрокаВДату(ДокументXDTO.Дата);
	Если ЗначениеЗаполнено(ДатаЭД) Тогда
		ДатаСведений = ДатаЭД;
	Иначе	
		ДатаСведений = ТекущаяДатаСеанса();
	КонецЕсли;

	РежимЗаписи = РежимЗаписиДокумента.Запись;

	Если ТипПрикладногоДокумента = "ИзвещениеВходящее" Тогда
		ОбработкаВходящегоЭлектронногоИзвещения(СсылкиНаОбъекты, ДокументXDTO, РежимЗаписи, ДатаСведений);
	ИначеЕсли ТипПрикладногоДокумента = "ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий" Тогда
		ОбработкаВходящегоЭлектронногоАктаОПриемеПередачеОбъектовНФА(СсылкиНаОбъекты, ДокументXDTO, РежимЗаписи, ДатаСведений);
	КонецЕсли;	
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.СформироватьФайлПрикладногоЭлектронногоДокумента.
Процедура ПриФормированииФайлаПрикладногоЭлектронногоДокумента(ПараметрыФормирования, РезультатФормирования, Отказ) Экспорт
	ВидыЭлектронныхДокументов = Новый Массив;
	ПриОпределенииПрикладныхТиповЭлектронныхДокументов(ВидыЭлектронныхДокументов);
	
	Если ВидыЭлектронныхДокументов.Найти(ПараметрыФормирования.ТипЭлектронногоДокумента) = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	Если (ПараметрыФормирования.ТипЭлектронногоДокумента =
		Перечисления.ПрикладныеВидыЭлектронныхДокументовБГУ.Извещение) Тогда
		
		НетЗамечанийКДокументу = Документы.ИзвещениеИсходящее.ПредварительныйКонтрольДанныхДляЭД(ПараметрыФормирования.СсылкаНаОбъект);
		
		Если НЕ НетЗамечанийКДокументу Тогда
			ОписаниеОшибки = НСтр("ru='Вышеуказанные ошибки препятствуют формированию электронного документа.
			|По этой причине и прочие данные документа не будут выгружены в ЭД.
			|После заполнения указанных реквизитов повторите попытку формирования электронного документа.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки);
			Отказ = Истина;
			Возврат;
		КонецЕсли;	
		
		// Подготовка данных.
		СтруктураДанных = Документы.ИзвещениеИсходящее.ПодготовитьДанныеДляЭД(ПараметрыФормирования.СсылкаНаОбъект);
		ВыборкаШапки = СтруктураДанных.Шапка;
		ВыборкаШапки.Следующий();
		
		ИмяФайла = СтрШаблон("ON_BGU_IZV_%1_%2_%3_%4",
			ПараметрыФормирования.ИдентификаторОрганизации,
			ПараметрыФормирования.ИдентификаторКонтрагента,
			Формат(ВыборкаШапки.Дата, "ДФ=yyyyMMdd"),
			ПараметрыФормирования.ИдентификаторФайла);
		
		// формирование электронного документа.
		ФайлXDTO = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("ON_BGU_IZV", "Файл"));
		
		ФайлXDTO.Установить("ИдФайл", ИмяФайла);
		ФайлXDTO.Установить("ВерсФорм", "1.00");
		ФайлXDTO.Установить("ИдФорм", "ЭДОБГУИзвещение");
		
		ДокументXDTO = СоздатьОбъектXDTO(ФайлXDTO, "Документ");
		НомерИсходящегоДокумента = РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоИмениДокумента("ИзвещениеИсходящее",
			ВыборкаШапки.Номер);
		
		ОбработкаИсходящегоЭлектронногоИзвещения(ФайлXDTO, ДокументXDTO, ПараметрыФормирования, РезультатФормирования, ВыборкаШапки, СтруктураДанных, НомерИсходящегоДокумента); 
		
		ФайлXDTO.Установить("Документ", ДокументXDTO);
		
		ФайлXDTO.Проверить();
		
		ПотокВПамяти = Новый ПотокВПамяти;
		
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.ОткрытьПоток(ПотокВПамяти);
		ФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ФайлXDTO);
		ЗаписьXML.Закрыть();
		
		ПотокВПамяти.Перейти(0, ПозицияВПотоке.Начало);
		
		ЧтениеТекста = Новый ЧтениеТекста(ПотокВПамяти, КодировкаТекста.UTF8);
		Текст = ЧтениеТекста.Прочитать();
		ЧтениеТекста.Закрыть();
		ПотокВПамяти.Закрыть();
		
		Текст = СтрЗаменить(Текст, "xmlns=""ON_BGU_IZV""", "");
	
	ИначеЕсли (ПараметрыФормирования.ТипЭлектронногоДокумента =
		Перечисления.ПрикладныеВидыЭлектронныхДокументовБГУ.АктОПриемеПередачеОбъектовНФА) Тогда
		
		НетЗамечанийКДокументу = Документы.ЭлектронныйАктОПриемеПередачеОбъектовНФАИсходящий.ПредварительныйКонтрольДанныхДляЭД(ПараметрыФормирования.СсылкаНаОбъект);
		
		Если НЕ НетЗамечанийКДокументу Тогда
			ОписаниеОшибки = НСтр("ru='Вышеуказанные ошибки препятствуют формированию электронного документа.
			|По этой причине и прочие данные документа не будут выгружены в ЭД.
			|После заполнения указанных реквизитов повторите попытку формирования электронного документа.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки);
			Отказ = Истина;
			Возврат;
		КонецЕсли;	
		
		// Подготовка данных.
		СтруктураДанных = Документы.ЭлектронныйАктОПриемеПередачеОбъектовНФАИсходящий.ПодготовитьДанныеДляЭД(ПараметрыФормирования.СсылкаНаОбъект);
		
		ДатаАкта = Дата(1,1,1);
		Если СтруктураДанных.ТипАкта = ТипАктаПередающейСтороны() Тогда
			ДатаАкта = СтруктураДанных.ШапкаАкта.Дата;
		ИначеЕсли СтруктураДанных.ТипАкта = ТипАктаОтветногоПринимающейСтороны() Тогда
			ДатаАкта = СтруктураДанных.СведенияАктаПередачиНФА.ОбщиеРеквизитыДокумента.Дата;
		Иначе
			Возврат;
		КонецЕсли;	
		
		ИмяФайла = СтрШаблон("ON_BGU_ACT_NFA_448_%1_%2_%3_%4",
			ПараметрыФормирования.ИдентификаторОрганизации,
			ПараметрыФормирования.ИдентификаторКонтрагента,
			Формат(ДатаАкта, "ДФ=yyyyMMdd"),
			ПараметрыФормирования.ИдентификаторФайла);
		
		// формирование электронного документа.
		ФайлXDTO = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип(ПространствоИменФорматаАктаОПриемеПередачеНФА0510448(), "Файл"));
		
		ФайлXDTO.Установить("ИдФайл", ИмяФайла);
		ФайлXDTO.Установить("ВерсФорм", "1.00");
		ФайлXDTO.Установить("ИдФорм", "ЭДОБГУАктОПриемеПередачеОбъектовНФА");
		
		ДокументXDTO = СоздатьОбъектXDTO(ФайлXDTO, "Документ");
		
		Если СтруктураДанных.ТипАкта = ТипАктаПередающейСтороны() Тогда
			ОбработкаИсходящегоЭлектронногоАктаОПриемеПередачеОбъектовНФА(ФайлXDTO, ДокументXDTO, ПараметрыФормирования, РезультатФормирования, СтруктураДанных, Отказ); 
		Иначе
			ОбработкаОтветногоИсходящегоЭлектронногоАктаОПриемеПередачеОбъектовНФА(ФайлXDTO, ДокументXDTO, ПараметрыФормирования, РезультатФормирования, СтруктураДанных, Отказ); 
		КонецЕсли;
		
		Если Отказ Тогда
			Возврат;
		КонецЕсли;	
		
		ФайлXDTO.Установить("Документ", ДокументXDTO);
		
		ФайлXDTO.Проверить();
		
		ПотокВПамяти = Новый ПотокВПамяти;
		
		ЗаписьXML = Новый ЗаписьXML;
		ЗаписьXML.ОткрытьПоток(ПотокВПамяти);
		ФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ФайлXDTO);
		ЗаписьXML.Закрыть();
		
		ПотокВПамяти.Перейти(0, ПозицияВПотоке.Начало);
		
		ЧтениеТекста = Новый ЧтениеТекста(ПотокВПамяти, КодировкаТекста.UTF8);
		Текст = ЧтениеТекста.Прочитать();
		ЧтениеТекста.Закрыть();
		ПотокВПамяти.Закрыть();
		
		Текст = СтрЗаменить(Текст, "xmlns=""ON_BGU_ACT_NFA_448""", "");
		
	КонецЕсли;	
	
	ПотокВПамяти = Новый ПотокВПамяти;
	
	ЗаписьТекста = Новый ЗаписьТекста(ПотокВПамяти, КодировкаТекста.UTF8);
	ЗаписьТекста.Записать(Текст);
	ЗаписьТекста.Закрыть();
	
	// Заполнение сведений о сформированном электронном документе.
	РезультатФормирования.ДанныеФайла = ПотокВПамяти.ЗакрытьИПолучитьДвоичныеДанные();
	РезультатФормирования.ИмяФайла    = ИмяФайла;
	РезультатФормирования.Расширение  = "xml";
	РезультатФормирования.НомерДокументаОтправителя = НомерИсходящегоДокумента;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьТабличныйДокументПрикладногоЭлектронногоДокумента.
Процедура ПриЗаполненииТабличногоДокументаИзФайлаПрикладногоЭлектронногоДокумента(ТабличныйДокумент, ДанныеФайла, ПараметрыЗаполнения) Экспорт
	ТипПрикладногоДокумента = "";
	ПространствоИменФормата = "";
	КодПрикладногоДокумента = 0;
	
	Если ПараметрыЗаполнения.ВидЭлектронногоДокумента 
		 = Перечисления.ПрикладныеВидыЭлектронныхДокументовБГУ.Извещение Тогда 
		ПространствоИменФормата = "ON_BGU_IZV";
		КодПрикладногоДокумента = 1;
	ИначеЕсли ПараметрыЗаполнения.ВидЭлектронногоДокумента 
		 = Перечисления.ПрикладныеВидыЭлектронныхДокументовБГУ.АктОПриемеПередачеОбъектовНФА Тогда 
		ПространствоИменФормата = ПространствоИменФорматаАктаОПриемеПередачеНФА0510448();
		КодПрикладногоДокумента = 2;
	Иначе	
		Возврат;
	КонецЕсли;
	
	Поток = ДанныеФайла.ОткрытьПотокДляЧтения();
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьПоток(Поток);
	
	ПостроительDOM = Новый ПостроительDOM;
	ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
	ЧтениеXML.Закрыть();
	Поток.Закрыть();
	
	ДокументDOM.ЭлементДокумента.УстановитьСоответствиеПространстваИмен("", ПространствоИменФормата);
	
	Поток = Новый ПотокВПамяти;
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьПоток(Поток);
	
	ЗаписьDOM = Новый ЗаписьDOM;
	ЗаписьDOM.Записать(ДокументDOM, ЗаписьXML);
	ЗаписьXML.Закрыть();
	
	Поток.Перейти(0, ПозицияВПотоке.Начало);
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьПоток(Поток);
	
	ФайлXDTO = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML, ФабрикаXDTO.Тип(ПространствоИменФормата, "Файл"));
	
	ЧтениеXML.Закрыть();
	Поток.Закрыть();
	
	ДокументXDTO = ФайлXDTO.Документ;
	
	Если КодПрикладногоДокумента = 1 Тогда
		СформироватьТабличныйДокументДляЭлектронногоИзвещения(ДокументXDTO, ПараметрыЗаполнения, ТабличныйДокумент);
	ИначеЕсли КодПрикладногоДокумента = 2 Тогда
		СформироватьТабличныйДокументДляЭлектронногоАктаОПриемеПередачеОбъектовНФА(ДокументXDTO, ПараметрыЗаполнения, ТабличныйДокумент);
	КонецЕсли;	
КонецПроцедуры

Функция СоздатьОбъектXDTO(ОбъектXDTO, ИмяСвойства)
	
	ТипОбъектаXDTO = ОбъектXDTO.Свойства().Получить(ИмяСвойства).Тип;
	Возврат ФабрикаXDTO.Создать(ТипОбъектаXDTO);
	
КонецФункции

Процедура НапечататьПроводку(ОбластьМакетаСтрока, ОборотыВЖурналОпераций, ПередаваемыеПроводки, пИтогоСумма, ТабличныйДокумент, ИзвещениеПолучателя = Ложь, пИтогоСуммаПолучателя = 0, ТипИзвещения, НомерПоПорядку = 0)
	
	ПредставлениеСчетаДт = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1.%2.%3.%4'"),
		ПередаваемыеПроводки.КПСДт, ПередаваемыеПроводки.КФО, ПередаваемыеПроводки.СчетДт, ПередаваемыеПроводки.КЭКДт);
	
	ПредставлениеСчетаКт = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1.%2.%3.%4'"),
		ПередаваемыеПроводки.КПСКт, ПередаваемыеПроводки.КФО, ПередаваемыеПроводки.СчетКт, ПередаваемыеПроводки.КЭККт);
		
	Если ПередаваемыеПроводки.СчетДт = "" Тогда
		ПредставлениеСчетаДт = "";
	Иначе
		Если (Сред(ПредставлениеСчетаДт,1,1)=".") Тогда
			ПредставлениеСчетаДт = Сред(ПредставлениеСчетаДт, 2);
		КонецЕсли;
		Если (Сред(ПредставлениеСчетаДт, СтрДлина(ПредставлениеСчетаДт),1)=".") Тогда
			ПредставлениеСчетаДт = Сред(ПредставлениеСчетаДт, 1, СтрДлина(ПредставлениеСчетаДт)-1);
		КонецЕсли;
	КонецЕсли;		
		
	Если ПередаваемыеПроводки.СчетКт = "" Тогда
		ПредставлениеСчетаКт = "";	
	Иначе
		Если (Сред(ПредставлениеСчетаКт,1,1)=".") Тогда
			ПредставлениеСчетаКт = Сред(ПредставлениеСчетаКт, 2);
		КонецЕсли;
		Если (Сред(ПредставлениеСчетаКт, СтрДлина(ПредставлениеСчетаКт),1)=".") Тогда
			ПредставлениеСчетаКт = Сред(ПредставлениеСчетаКт, 1, СтрДлина(ПредставлениеСчетаКт)-1);
		КонецЕсли;
	КонецЕсли;		
	
	СтруктураОбластьМакетаСтрока = Новый Структура("пСодержание,пСуммаОтправитель,пДебетСчетОтправитель,пКредитСчетОтправитель,
		|пДебетСчетПолучатель,пКредитСчетПолучатель,пСуммаПолучатель");
	
	Если ПередаваемыеПроводки.НомерПоПорядку = Неопределено Тогда
		Содержание = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1. %2'"),
				НомерПоПорядку, ПередаваемыеПроводки.Содержание);			
	Иначе
		Содержание = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1. %2'"),
				ПередаваемыеПроводки.НомерПоПорядку, ПередаваемыеПроводки.Содержание);			
	КонецЕсли;	
	
	Сумма = 0;
	Если ЗначениеЗаполнено(ПередаваемыеПроводки.Сумма) Тогда
		Сумма = Число(ПередаваемыеПроводки.Сумма);
	КонецЕсли;
	СуммаПолучателя = 0;
	Если ЗначениеЗаполнено(ПередаваемыеПроводки.СуммаПолучателя) Тогда
		СуммаПолучателя = Число(ПередаваемыеПроводки.СуммаПолучателя);
	КонецЕсли;
	
	Если ОтправительИзвещенияЯвляетсяПолучателемОбъектовПередачи(ТипИзвещения) Тогда
		СтруктураОбластьМакетаСтрока.пСодержание			= Содержание;
		СтруктураОбластьМакетаСтрока.пСуммаПолучатель		= Сумма;
		СтруктураОбластьМакетаСтрока.пДебетСчетПолучатель	= ПредставлениеСчетаДт;
		СтруктураОбластьМакетаСтрока.пКредитСчетПолучатель	= ПредставлениеСчетаКт;
		Если ИзвещениеПолучателя Тогда
			СтруктураОбластьМакетаСтрока.пДебетСчетОтправитель	= ПередаваемыеПроводки.СчетУчетаДтПолучателя;
			СтруктураОбластьМакетаСтрока.пКредитСчетОтправитель	= ПередаваемыеПроводки.СчетУчетаКтПолучателя;
			СтруктураОбластьМакетаСтрока.пСуммаОтправитель		= СуммаПолучателя;
		КонецЕсли;
	Иначе	
		СтруктураОбластьМакетаСтрока.пСодержание			= Содержание;
		СтруктураОбластьМакетаСтрока.пСуммаОтправитель		= Сумма;
		СтруктураОбластьМакетаСтрока.пДебетСчетОтправитель	= ПредставлениеСчетаДт;
		СтруктураОбластьМакетаСтрока.пКредитСчетОтправитель	= ПредставлениеСчетаКт;
		Если ИзвещениеПолучателя Тогда
			СтруктураОбластьМакетаСтрока.пДебетСчетПолучатель	= ПередаваемыеПроводки.СчетУчетаДтПолучателя;
			СтруктураОбластьМакетаСтрока.пКредитСчетПолучатель	= ПередаваемыеПроводки.СчетУчетаКтПолучателя;
			СтруктураОбластьМакетаСтрока.пСуммаПолучатель		= СуммаПолучателя;
		КонецЕсли;
	КонецЕсли;
	ОбластьМакетаСтрока.Параметры.Заполнить(СтруктураОбластьМакетаСтрока);
	
	ТабличныйДокумент.Вывести(ОбластьМакетаСтрока);
	
	пИтогоСумма = пИтогоСумма + Сумма;
	НовОборот = ОборотыВЖурналОпераций.Добавить();
	
	Если ОтправительИзвещенияЯвляетсяПолучателемОбъектовПередачи(ТипИзвещения) Тогда
		НовОборот.пДебетСчетПолучатель	= ПредставлениеСчетаДт;
		НовОборот.пКредитСчетПолучатель	= ПредставлениеСчетаКт;
		НовОборот.пСуммаПолучатель		= Сумма;
		Если ИзвещениеПолучателя Тогда
			пИтогоСуммаПолучателя = пИтогоСуммаПолучателя + СуммаПолучателя;
			НовОборот.пДебетСчетОтправитель		= ПередаваемыеПроводки.СчетУчетаДтПолучателя;
			НовОборот.пКредитСчетОтправитель	= ПередаваемыеПроводки.СчетУчетаКтПолучателя;
			НовОборот.пСуммаОтправитель			= СуммаПолучателя;
		КонецЕсли;
	Иначе	
		НовОборот.пДебетСчетОтправитель		= ПредставлениеСчетаДт;
		НовОборот.пКредитСчетОтправитель	= ПредставлениеСчетаКт;
		НовОборот.пСуммаОтправитель			= Сумма;
		Если ИзвещениеПолучателя Тогда
			пИтогоСуммаПолучателя = пИтогоСуммаПолучателя + СуммаПолучателя;
			НовОборот.пДебетСчетПолучатель	= ПередаваемыеПроводки.СчетУчетаДтПолучателя;
			НовОборот.пКредитСчетПолучатель	= ПередаваемыеПроводки.СчетУчетаКтПолучателя;
			НовОборот.пСуммаПолучатель	= СуммаПолучателя;
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

Функция ДатаВводаВЭксплуатацию(ОсновноеСредство, ИнвентарныйНомер, Организация, Период) Экспорт
	ДатаВводаВЭксплуатацию = '00010101';
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ОсновноеСредство", ОсновноеСредство);
	Запрос.УстановитьПараметр("ИнвентарныйНомер", ИнвентарныйНомер);	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СобытияОССрезПервых.ДатаСобытия КАК ДатаСобытия
	|ИЗ
	|	РегистрСведений.СобытияОС.СрезПервых(
	|			,
	|			Организация = &Организация
	|				И ОсновноеСредство = &ОсновноеСредство
	|				И ИнвНомер = &ИнвентарныйНомер
	|				И Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВводВЭксплуатацию)) КАК СобытияОССрезПервых";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ДатаВводаВЭксплуатацию = Выборка.ДатаСобытия;	
	КонецЕсли;
	
	Возврат ДатаВводаВЭксплуатацию;
	
КонецФункции

Функция ДатаВходящегоИзвещенияЭДП(ДанныеЗаполнения) Экспорт
	
	Если ЗначениеЗаполнено(ДанныеЗаполнения.Извещение) Тогда
		ДатаИзвещения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеЗаполнения.Извещение, "Дата");
	Иначе
		ДатаИзвещения = ДанныеЗаполнения.Дата;
		Если НЕ ЗначениеЗаполнено(ДатаИзвещения) Тогда
			ДатаИзвещения = ТекущаяДатаСеанса();
		КонецЕсли;	
	КонецЕсли;
	
	Возврат ДатаИзвещения;
КонецФункции	

Функция ЭтоРанееСписаныйОбъектОС(ОсновноеСредство, ДатаСведений) Экспорт
	Результат = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СобытияОССрезПоследних.Событие КАК Событие,
	               |	СобытияОССрезПоследних.ДатаСобытия КАК ДатаСобытия
	               |ИЗ
	               |	РегистрСведений.СобытияОС.СрезПоследних(
	               |			&ДатаСведений,
	               |			ОсновноеСредство = &ОсновноеСредство
	               |				И Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Списание)) КАК СобытияОССрезПоследних
	               |ГДЕ
	               |	СобытияОССрезПоследних.ДатаСобытия <> ДАТАВРЕМЯ(1, 1, 1)";
	Запрос.УстановитьПараметр("ОсновноеСредство", ОсновноеСредство);
	Запрос.УстановитьПараметр("ДатаСведений", ДатаСведений);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Истина;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

Процедура СформироватьТабличныйДокументДляЭлектронногоИзвещения(ДокументXDTO, ПараметрыЗаполнения, ТабличныйДокумент)

	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.Автомасштаб = Истина;

	ТипИзвещения = Число(ДокументXDTO.ТипИзвещения);
	
	Если ОтправительИзвещенияЯвляетсяПолучателемОбъектовПередачи(ТипИзвещения) Тогда
		ВременныйМассивЭлектронныхПодписей = Новый Массив;
		КоличествоПодписей = ПараметрыЗаполнения.ЭлектронныеПодписи.Количество();
		Пока КоличествоПодписей > 0 Цикл
			ПараметрыЗаполнения.ЭлектронныеПодписи[КоличествоПодписей-1].ОтветнаяПодпись = 
				НЕ ПараметрыЗаполнения.ЭлектронныеПодписи[КоличествоПодписей-1].ОтветнаяПодпись;
			ВременныйМассивЭлектронныхПодписей.Добавить(ПараметрыЗаполнения.ЭлектронныеПодписи[КоличествоПодписей-1]);
			КоличествоПодписей = КоличествоПодписей - 1;
		КонецЦикла;
		ПараметрыЗаполнения.ЭлектронныеПодписи.Очистить();
		Для Каждого Подпись Из ВременныйМассивЭлектронныхПодписей Цикл
		    ПараметрыЗаполнения.ЭлектронныеПодписи.Добавить(Подпись);
		КонецЦикла;
	КонецЕсли;
	
	Макет = Документы.ИзвещениеИсходящее.ПолучитьМакет("ПФ_MXL_Извещение0504805_103н");
	ОбластьМакетаЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	ОбластьМакетаШапка     = Макет.ПолучитьОбласть("Шапка");
	ОбластьМакетаСтрока    = Макет.ПолучитьОбласть("Строка");
	ОбластьМакетаИтого     = Макет.ПолучитьОбласть("Итого");
	ОбластьМакетаПодвал    = Макет.ПолучитьОбласть("ПодвалЭД");
	ОбластьМакетаПояснение = Макет.ПолучитьОбласть("ПояснениеМБТ");
	
	ОбластьМакетаВерх    = Макет.ПолучитьОбласть("Верх");
	ОбластьМакетаСтрока1 = Макет.ПолучитьОбласть("Строка1");
	ОбластьМакетаНиз     = Макет.ПолучитьОбласть("Низ");
	
	ОбластьМакетаЗаголовокДопСведения = Макет.ПолучитьОбласть("ЗаголовокДопСведения");
	ОбластьМакетаЗаголовокПриложения = Макет.ПолучитьОбласть("ЗаголовокПриложения");
	ОбластьМакетаШапкаПриложения = Макет.ПолучитьОбласть("ШапкаПриложения");
	ОбластьМакетаСтрокаПриложения = Макет.ПолучитьОбласть("СтрокаПриложения");
	
	ОбластьМакетаЗаголовокПриложенияФайлы = Макет.ПолучитьОбласть("ЗаголовокПриложенияФайлы");
	ОбластьМакетаШапкаПриложенияФайлы = Макет.ПолучитьОбласть("ШапкаПриложенияФайлы");
	ОбластьМакетаСтрокаПриложенияФайлы = Макет.ПолучитьОбласть("СтрокаПриложенияФайлы");
	
	ОбластьМакетаЗаголовокСписокНФА = Макет.ПолучитьОбласть("ЗаголовокСписокНФА");
	ОбластьМакетаШапкаСписокНФА = Макет.ПолучитьОбласть("ШапкаСписокНФА");
	ОбластьМакетаСтрокаСписокНФА = Макет.ПолучитьОбласть("СтрокаСписокНФА");
	ОбластьМакетаЗаголовокПрослеживаемость = Макет.ПолучитьОбласть("ЗаголовокПрослеживаемость");
	ОбластьМакетаШапкаПрослеживаемость = Макет.ПолучитьОбласть("ШапкаПрослеживаемость");
	ОбластьМакетаСтрокаПрослеживаемость = Макет.ПолучитьОбласть("СтрокаПрослеживаемость");
	
	Если (ПараметрыЗаполнения.ВидЭлектронногоДокумента = Перечисления.ПрикладныеВидыЭлектронныхДокументовБГУ.Извещение) Тогда
		
		ДатаДокумента = СтроковыеФункцииКлиентСервер.СтрокаВДату(ДокументXDTO.Дата);
		
		СтруктураДанныхЗаголовка = Новый Структура;
		СтруктураДанныхЗаголовка.Вставить("Номер", ДокументXDTO.Номер);
		СтруктураДанныхЗаголовка.Вставить("Дата", ДатаДокумента);
		СтруктураДанныхЗаголовка.Вставить("пНаименованиеОтправитель", ДокументXDTO.Отправитель[0].Наим);
		СтруктураДанныхЗаголовка.Вставить("ИННОтправитель", ДокументXDTO.Отправитель[0].СвЮЛ.ИНН);
		СтруктураДанныхЗаголовка.Вставить("КППОтправитель", ДокументXDTO.Отправитель[0].СвЮЛ.КПП);
		СтруктураДанныхЗаголовка.Вставить("пКодОКПООтправитель", ДокументXDTO.Отправитель[0].СвЮЛ.ОКПО);
		СтруктураДанныхЗаголовка.Вставить("пКодГлавыОтправитель", ДокументXDTO.Отправитель[0].СвЮЛ.КодПоБК);
		СтруктураДанныхЗаголовка.Вставить("пНаименованиеПолучатель", ДокументXDTO.Получатель[0].Наим);
		СтруктураДанныхЗаголовка.Вставить("ИННПолучатель", ДокументXDTO.Получатель[0].СвЮЛ.ИНН);
		СтруктураДанныхЗаголовка.Вставить("КПППолучатель", ДокументXDTO.Получатель[0].СвЮЛ.КПП);
		СтруктураДанныхЗаголовка.Вставить("пКодОКПОПолучатель", ДокументXDTO.Получатель[0].СвЮЛ.ОКПО);
		СтруктураДанныхЗаголовка.Вставить("пКодГлавыПолучатель", ДокументXDTO.Получатель[0].СвЮЛ.КодПоБК);
		
		Если ОтправительИзвещенияЯвляетсяПолучателемОбъектовПередачи(ТипИзвещения) Тогда
			Если ОтправительИзвещенияЯвляетсяПолучателемОбъектовПередачи(ТипИзвещения, Истина) Тогда
				СтруктураДанныхЗаголовка = Новый Структура;
				СтруктураДанныхЗаголовка.Вставить("Номер", ДокументXDTO.Номер);
				СтруктураДанныхЗаголовка.Вставить("Дата", ДатаДокумента);
				СтруктураДанныхЗаголовка.Вставить("пНаименованиеОтправитель", ДокументXDTO.Получатель[0].Наим);
				СтруктураДанныхЗаголовка.Вставить("ИННОтправитель", ДокументXDTO.Получатель[0].СвЮЛ.КодПоРПБС);
				СтруктураДанныхЗаголовка.Вставить("КППОтправитель", ДокументXDTO.Получатель[0].СвЮЛ.КПП);
				СтруктураДанныхЗаголовка.Вставить("пКодОКПООтправитель", ДокументXDTO.Получатель[0].СвЮЛ.ОКПО);
				СтруктураДанныхЗаголовка.Вставить("пКодГлавыОтправитель", ДокументXDTO.Получатель[0].СвЮЛ.КодПоБК);
				СтруктураДанныхЗаголовка.Вставить("пНаименованиеПолучатель", ДокументXDTO.Отправитель[0].Наим);
				СтруктураДанныхЗаголовка.Вставить("ИННПолучатель", ДокументXDTO.Отправитель[0].СвЮЛ.КодПоРПБС);
				СтруктураДанныхЗаголовка.Вставить("КПППолучатель", ДокументXDTO.Отправитель[0].СвЮЛ.КПП);
				СтруктураДанныхЗаголовка.Вставить("пКодОКПОПолучатель", ДокументXDTO.Отправитель[0].СвЮЛ.ОКПО);
