	ДокументОбъект.КодВидаОперации = "01";
	ДокументОбъект.КодСпособаВыставления = 2; //Электронный способ
	ДокументОбъект.Организация = Шапка.Организация;
	
	
	ДокументОбъект.НомерСчетаФактуры = Шапка.НомерСчетаФактуры;
	ДокументОбъект.ДатаСчетаФактуры  = Шапка.ДатаСчетаФактуры;
	
	ДокументОбъект.НомерПервичногоДокумента = Шапка.Номер;
	ДокументОбъект.ДатаПервичногоДокумента  = Шапка.Дата;
	
	Если Шапка.Свойство("ДокументыОснования") И ЗначениеЗаполнено(Шапка.ДокументыОснования) Тогда
		ДокументОснование = Шапка.ДокументыОснования[0].ДокументОснование;
		ДокументОбъект.ДокументОснование = ДокументОснование;
		ДокументОбъект.ПричинаНалогообложения = ДокументОснование.ПричинаНалогообложения;
	КонецЕсли;
	
	// Заполним табличную часть
	ТабЧасть = ДокументОбъект.СоставНФА;
	ТабЧасть.Очистить();
	Для каждого СтрокаТовары из Товары Цикл
		ТекТЧ = ТабЧасть.Добавить();
		
		ЗаполнитьЗначенияСвойств(ТекТЧ, СтрокаТовары);
	КонецЦикла;	
	
	ДокументОбъект.ДополнительныеСвойства.Вставить("ПроцессыОбработкиДокументов_ЗаписатьБезПроверкиОбменДаннымиЗагрузка", Истина);
	Если Записывать Тогда
		Если НЕ ЗначениеЗаполнено(ДокументОбъект.Номер) Тогда
			ДокументОбъект.УстановитьНовыйНомер();
		КонецЕсли;
		ДокументОбъект.Записать(РежимЗаписи);
		ВозвращаемоеЗначение = ДокументОбъект.Ссылка;
	Иначе
		ВозвращаемоеЗначение = ДокументОбъект;
	КонецЕсли;
	
	Возврат(ВозвращаемоеЗначение);
КонецФункции

// Заполняет строку для документа "Поступление услуг, работ" по данным
// электронного документа
Процедура ЗаполнитьСтрокуТЧ_ПУР(ТЗ, ДанныеЗаполнения, ДеревоРазбора, Контрагент)
	
	НовСтрока = ТЗ.Добавить();
	
	ТоварНаименование = "";
	Для Каждого ТекСтрока Из ДанныеЗаполнения Цикл
		ИмяРеквизитаВБД = ТекСтрока.Реквизит;
		Если ИмяРеквизитаВБД = "Наименование" Тогда
			ТоварНаименование = ПолучитьЗначениеРеквизитаДерева(ТекСтрока, ТекСтрока.Реквизит, Истина, ДеревоРазбора);
			Продолжить;
		ИначеЕсли ИмяРеквизитаВБД = "СуммаСНДС" Тогда
			ИмяРеквизитаВБД = "Всего";
		ИначеЕсли ИмяРеквизитаВБД = "Сумма" Тогда
			ИмяРеквизитаВБД = "Сумма";
		ИначеЕсли ИмяРеквизитаВБД = "Описание" Тогда
			ИмяРеквизитаВБД = "Содержание";
		ИначеЕсли ИмяРеквизитаВБД = "ЕдиницаИзмеренияКод" Тогда
			ИмяРеквизитаВБД = "ЕдиницаИзмерения";
		ИначеЕсли ТекСтрока.Реквизит = "ИД" Тогда
			ИД = ПолучитьЗначениеРеквизитаДерева(ТекСтрока, ТекСтрока.Реквизит, Истина, ДеревоРазбора);
		ИначеЕсли ТЗ.Колонки.Найти(ИмяРеквизитаВБД) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НайденноеЗначение = ПолучитьЗначениеРеквизитаДерева(ТекСтрока, ТекСтрока.Реквизит, Истина, ДеревоРазбора);
		Если ТекСтрока.Реквизит = "ЕдиницаИзмеренияКод" Тогда
			НовСтрока[ИмяРеквизитаВБД] = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду(НайденноеЗначение);
		Иначе
			НовСтрока[ИмяРеквизитаВБД] = НайденноеЗначение;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Заполняет строку для документа "Поступление МЗ (М-4)" по данным
// электронного документа
Процедура ЗаполнитьСтрокуТЧ_МЗ_Покупка(ТЗ, ДанныеЗаполнения, ДеревоРазбора, Контрагент)
	
	ЭтоВозвратнаяТара = Ложь;
	Для Каждого ТекСтрока Из ДанныеЗаполнения Цикл
		ИмяРеквизитаВБД = ТекСтрока.Реквизит;
		ЗначениеРеквизитаВБД = ТекСтрока.ЗначениеРеквизита;
		Если ИмяРеквизитаВБД = "ТаблицаДокумента" Тогда
			Если ЗначениеРеквизитаВБД = "ВозвратнаяТара" Тогда
				ЭтоВозвратнаяТара = Истина;
			КонецЕсли;	
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	НовСтрока = ТЗ.Добавить();
	
	ТоварНаименование = "";
	Для Каждого ТекСтрока Из ДанныеЗаполнения Цикл
		ИмяРеквизитаВБД = ТекСтрока.Реквизит;
		КоличествоМест = 0;
		Коэффициент = 0;
		Если ИмяРеквизитаВБД = "Наименование" Тогда
			ТоварНаименование = ПолучитьЗначениеРеквизитаДерева(ТекСтрока, ТекСтрока.Реквизит, Истина, ДеревоРазбора);
			Продолжить;
		ИначеЕсли ИмяРеквизитаВБД = "СуммаСНДС" Тогда
			ИмяРеквизитаВБД = "Всего";
		ИначеЕсли ИмяРеквизитаВБД = "СуммаБезНДС" Тогда
			ИмяРеквизитаВБД = "Сумма";
		ИначеЕсли ИмяРеквизитаВБД = "Цена" Тогда
			ИмяРеквизитаВБД = "Цена";
			НовСтрока[ИмяРеквизитаВБД] = ТекСтрока.ЗначениеРеквизита;
		ИначеЕсли ИмяРеквизитаВБД = "ЕдиницаИзмеренияКод" Тогда
			ИмяРеквизитаВБД = "ЕдиницаИзмерения";
		ИначеЕсли ИмяРеквизитаВБД = "ИД" Тогда
			ИД = ПолучитьЗначениеРеквизитаДерева(ТекСтрока, ТекСтрока.Реквизит, Истина, ДеревоРазбора);
			Продолжить;
		ИначеЕсли ТЗ.Колонки.Найти(ИмяРеквизитаВБД) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НайденноеЗначение = ПолучитьЗначениеРеквизитаДерева(ТекСтрока, ТекСтрока.Реквизит, Истина, ДеревоРазбора);
		Если ТекСтрока.Реквизит = "ЕдиницаИзмеренияКод" Тогда
			НовСтрока.ЕдиницаИзмеренияКод = НайденноеЗначение; 
			НовСтрока[ИмяРеквизитаВБД] = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду(НайденноеЗначение);
		ИначеЕсли ИмяРеквизитаВБД = "МассаНетто" Тогда
			ИмяРеквизитаВБД = "Количество";
			НовСтрока[ИмяРеквизитаВБД] = ТекСтрока.ЗначениеРеквизита;
		Иначе	
			НовСтрока[ИмяРеквизитаВБД] = НайденноеЗначение;
		КонецЕсли;
		Если ЭтоВозвратнаяТара Тогда
			НовСтрока.ПризнакНоменклатуры = "ВТ";
		КонецЕсли;
	КонецЦикла;
	
	Если (НовСтрока.Количество = 0) ИЛИ (НовСтрока.Количество = Неопределено) Тогда
		НовСтрока.Количество = 1;
	КонецЕсли;	
	Если (НовСтрока.Цена = 0) ИЛИ (НовСтрока.Цена = Неопределено) Тогда
		НовСтрока.Цена = НовСтрока.Всего;
	КонецЕсли;	
	
КонецПроцедуры

Функция СобратьТЧДляИсправительныхСФ(ТЗ, ДеревоРазбора, ВидОперации)
	СтруктураПоиска = Новый Структура("Реквизит", "СтрокаТЧ");
	МассивСтрок = ДеревоРазбора.Строки.НайтиСтроки(СтруктураПоиска, Истина);
	Если МассивСтрок.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;	
	
	ТЗ = Новый ТаблицаЗначений;
	Если ВидОперации = "ИсправлениеРеализации" Тогда
		ТЗ.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
		ТЗ.Колонки.Добавить("НФА");
		ТЗ.Колонки.Добавить("ЕдиницаИзмерения");
		ТЗ.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
		ТЗ.Колонки.Добавить("СуммаДоИзменения", Новый ОписаниеТипов("Число"));
		ТЗ.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
		
		ТЗ.Колонки.Добавить("СуммаУменьшение", Новый ОписаниеТипов("Число"));
		ТЗ.Колонки.Добавить("СуммаУвеличение", Новый ОписаниеТипов("Число"));
		
		ТЗ.Колонки.Добавить("СуммаНДСУменьшение", Новый ОписаниеТипов("Число"));
		ТЗ.Колонки.Добавить("СуммаНДСУвеличение", Новый ОписаниеТипов("Число"));
		
		ТЗ.Колонки.Добавить("ВсегоУвеличение", Новый ОписаниеТипов("Число"));
		ТЗ.Колонки.Добавить("ВсегоУменьшение", Новый ОписаниеТипов("Число"));
		
		ТЗ.Колонки.Добавить("СуммаНДСДоИзменения", Новый ОписаниеТипов("Число"));
		ТЗ.Колонки.Добавить("СуммаНДС", Новый ОписаниеТипов("Число"));
		
		ТЗ.Колонки.Добавить("ВсегоДоИзменения", Новый ОписаниеТипов("Число"));
		ТЗ.Колонки.Добавить("Всего", Новый ОписаниеТипов("Число"));
		
		ТЗ.Колонки.Добавить("Счет30304");
		ТЗ.Колонки.Добавить("НДСКВычету");
		ТЗ.Колонки.Добавить("СтавкаНДС");
		
		Для каждого СтрокаТЧ из МассивСтрок Цикл
			НоваяСтрока = ТЗ.Добавить();
			Для каждого СтрокаРеквизита из СтрокаТЧ.Строки Цикл
				Если СтрокаРеквизита.Реквизит = "НомСтр" Тогда
					НоваяСтрока.НомерСтроки = СтрокаРеквизита.ЗначениеРеквизита;
				ИначеЕсли СтрокаРеквизита.Реквизит = "ИД" Тогда
					Номенклатура = НайтиСсылкуНаНоменклатуруПоИдентификаторуНоменклатурыПоставщика(СтрокаРеквизита.ЗначениеРеквизита);
				ИначеЕсли СтрокаРеквизита.Реквизит = "ОКЕИ_Тов" Тогда
					НоваяСтрока.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду(СтрокаРеквизита.ЗначениеРеквизита);
				ИначеЕсли СтрокаРеквизита.Реквизит = "КолТов" Тогда
					НоваяСтрока.Количество = СтрокаРеквизита.ЗначениеРеквизита;
				ИначеЕсли СтрокаРеквизита.Реквизит = "СтТовБезНДС" Тогда
					НоваяСтрока.Сумма = СтрокаРеквизита.ЗначениеРеквизита;
				ИначеЕсли СтрокаРеквизита.Реквизит = "СумНДС" Тогда
					НоваяСтрока.СуммаНДС = СтрокаРеквизита.ЗначениеРеквизита;
				ИначеЕсли СтрокаРеквизита.Реквизит = "СтТовУчНал" Тогда
					НоваяСтрока.Всего = СтрокаРеквизита.ЗначениеРеквизита;
				ИначеЕсли СтрокаРеквизита.Реквизит = "НалСтВел" Тогда
					НоваяСтрока.СтавкаНДС = ПолучитьСтавкуНДСПеречислением(СтрокаРеквизита.ЗначениеРеквизита);
				ИначеЕсли СтрокаРеквизита.Реквизит = "НаимТов" Тогда
					НоваяСтрока.НФА = ?(ЗначениеЗаполнено(Номенклатура),Номенклатура,СтрокаРеквизита.ЗначениеРеквизита);
				КонецЕсли;	
			КонецЦикла;
			
			РазницаСуммы = НоваяСтрока.Сумма - НоваяСтрока.СуммаДоИзменения;
			Если РазницаСуммы > 0 Тогда
				НоваяСтрока.СуммаУвеличение = РазницаСуммы;
				НоваяСтрока.СуммаУменьшение = 0;
			Иначе
				НоваяСтрока.СуммаУменьшение = (-1)*РазницаСуммы;
				НоваяСтрока.СуммаУвеличение = 0;
			КонецЕсли;
			
			РазницаСуммыНДС = НоваяСтрока.СуммаНДС - НоваяСтрока.СуммаНДСДоИзменения;
			
			Если РазницаСуммыНДС > 0 Тогда
				НоваяСтрока.СуммаНДСУвеличение = РазницаСуммыНДС;
				НоваяСтрока.СуммаНДСУменьшение = 0;
				НоваяСтрока.НДСКВычету = Истина;
				НоваяСтрока.Счет30304 = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("303.04");
			Иначе
				НоваяСтрока.СуммаНДСУменьшение = (-1)*РазницаСуммыНДС;
				НоваяСтрока.СуммаНДСУвеличение = 0;
			КонецЕсли;
			
			РазницаСуммыВсего = НоваяСтрока.Всего - НоваяСтрока.ВсегоДоИзменения;
			Если РазницаСуммыВсего > 0 Тогда
				НоваяСтрока.ВсегоУвеличение = РазницаСуммыВсего;
				НоваяСтрока.ВсегоУменьшение = 0;
			Иначе
				НоваяСтрока.ВсегоУменьшение = (-1)*РазницаСуммыВсего;
				НоваяСтрока.ВсегоУвеличение = 0;
			КонецЕсли;
			
		КонецЦикла;	
		
	Иначе	//корректировка
		ТЗ.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
		ТЗ.Колонки.Добавить("НФА");
