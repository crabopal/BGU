    	ТекстЗапроса = "ВЫБРАТЬ
    	               |	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ПринятиеКУчетуОбъектовИКОсновныеСредства.ОсновноеСредство) КАК ИдентификаторОбъектаНФА,
    	               |	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ПринятиеКУчетуОбъектовИКОсновныеСредства.ИнвентарныйНомер) КАК ИдентификаторИнвНомер,
    	               |	ПРЕДСТАВЛЕНИЕ(ПринятиеКУчетуОбъектовИКОсновныеСредства.СчетУчетаОС) КАК СчетУчета,
    	               |	ПРЕДСТАВЛЕНИЕ(ПринятиеКУчетуОбъектовИКОсновныеСредства.КПС) КАК КПС,
    	               |	ПРЕДСТАВЛЕНИЕ(ПринятиеКУчетуОбъектовИКОсновныеСредства.Ссылка.КФО) КАК КФО,
    	               |	"""" КАК ЕдИзмКод,
    	               |	"""" КАК ЕдИзмНаим
    	               |ИЗ
    	               |	Документ.ПринятиеКУчетуОбъектовИК.ОсновныеСредства КАК ПринятиеКУчетуОбъектовИКОсновныеСредства
    	               |ГДЕ
    	               |	ПринятиеКУчетуОбъектовИКОсновныеСредства.Ссылка = &Ссылка";
	ИначеЕсли ТипЗнч(ДокументПринятияКУчету) = Тип("ДокументСсылка.ПоступлениеМЗ") Тогда
		ТекстЗапроса = "ВЫБРАТЬ
		               |	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ПоступлениеМЗМатериалы.Номенклатура) КАК ИдентификаторОбъектаНФА,
		               |	"""" КАК ИдентификаторИнвНомер,
		               |	ВЫБОР
		               |		КОГДА ПоступлениеМЗМатериалы.СчетУчета = &ПустойСчетУчета
		               |			ТОГДА ПРЕДСТАВЛЕНИЕ(ПоступлениеМЗМатериалы.Ссылка.СчетУчета)
		               |		ИНАЧЕ ПРЕДСТАВЛЕНИЕ(ПоступлениеМЗМатериалы.СчетУчета)
		               |	КОНЕЦ КАК СчетУчета,
		               |	ПРЕДСТАВЛЕНИЕ(ПоступлениеМЗМатериалы.КПС) КАК КПС,
		               |	ПРЕДСТАВЛЕНИЕ(ПоступлениеМЗМатериалы.КФО) КАК КФО,
		               |	ВЫРАЗИТЬ(ПоступлениеМЗМатериалы.ЕдиницаИзмерения КАК Справочник.КлассификаторЕдиницИзмерения).Код КАК ЕдИзмКод,
		               |	ВЫРАЗИТЬ(ПоступлениеМЗМатериалы.ЕдиницаИзмерения КАК Справочник.КлассификаторЕдиницИзмерения).Наименование КАК ЕдИзмНаим
