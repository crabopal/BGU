						ТекстСообщения  = НСтр("ru='В документе %ДокументПоставщика% на закладке ""Дополнительно"" в форме по ссылке ""Сведения для электронного УПД"" не указаны необходимы данные (фамилия) для ответственного за передачу лица!'");
						ТекстСообщения  = СтрЗаменить(ТекстСообщения,"%ДокументПоставщика%", РеквизитыШапки.Ссылка);
						Сообщение       = Новый СообщениеПользователю();
						Сообщение.Текст = ТекстСообщения;
						Сообщение.Сообщить();
					КонецЕсли;
					Если НЕ ЗначениеЗаполнено(ДанныеФЛ.Имя) Тогда
						Отказ = Истина;
						
						ТекстСообщения  = НСтр("ru='В документе %ДокументПоставщика% на закладке ""Дополнительно"" в форме по ссылке ""Сведения для электронного УПД"" не указаны необходимы данные (имя) для ответственного за передачу лица!'");
						ТекстСообщения  = СтрЗаменить(ТекстСообщения,"%ДокументПоставщика%", РеквизитыШапки.Ссылка);
						Сообщение       = Новый СообщениеПользователю();
						Сообщение.Текст = ТекстСообщения;
						Сообщение.Сообщить();
					КонецЕсли;
					
					Если НЕ Отказ Тогда
						ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОЛицеПередавшемТовары." + ВидЛица + "." + ПодвидЛица + ".ИныеСведения", РеквизитыШапки.ОтветственныйПередалТРУИныеСведения);
						ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОЛицеПередавшемТовары." + ВидЛица + "." + ПодвидЛица + ".ДоверенностьНаОтгрузку", Строка(РеквизитыШапки.ОтветственныйПередалТРУДоверенность));
						ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОЛицеПередавшемТовары." + ВидЛица + "." + ПодвидЛица + ".Фамилия", ДанныеФЛ.Фамилия);
						ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОЛицеПередавшемТовары." + ВидЛица + "." + ПодвидЛица + ".Имя", ДанныеФЛ.Имя);
						ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОЛицеПередавшемТовары." + ВидЛица + "." + ПодвидЛица + ".Отчество", ДанныеФЛ.Отчество);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;	
		
		НеобходимоЗаполнениеДанныхЭДОПродавцаДляГосНужд = ВидимостьДанныхЭДОПродавцаДляГосНужд(РеквизитыШапки.Контрагент, РеквизитыШапки.Организация);
		Если НеобходимоЗаполнениеДанныхЭДОПродавцаДляГосНужд Тогда
			ДанныеДляЭДПродавцаДляГосНужд = ДанныеДляЭДПродавцаДляГосНужд(СсылкаНаОбъект);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
				"ДополнительныеСведенияОбУчастниках.ЗакупкаДляГосударственныхНужд.ДатаГосКонтракта", ДанныеДляЭДПродавцаДляГосНужд.ДатаГосКонтракта);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
				"ДополнительныеСведенияОбУчастниках.ЗакупкаДляГосударственныхНужд.НомерГосКонтракта", ДанныеДляЭДПродавцаДляГосНужд.НомерГосКонтракта);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
				"ДополнительныеСведенияОбУчастниках.ЗакупкаДляГосударственныхНужд.НомерЛицевогоСчетаПродавца", ДанныеДляЭДПродавцаДляГосНужд.НомерЛицевогоСчетаПродавца);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
				"ДополнительныеСведенияОбУчастниках.ЗакупкаДляГосударственныхНужд.КодБюджетнойКлассификацииПродавца", ДанныеДляЭДПродавцаДляГосНужд.КодБюджетнойКлассификацииПродавца);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
				"ДополнительныеСведенияОбУчастниках.ЗакупкаДляГосударственныхНужд.КодЦели", ДанныеДляЭДПродавцаДляГосНужд.КодЦели);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
				"ДополнительныеСведенияОбУчастниках.ЗакупкаДляГосударственныхНужд.КазначействоПродавцаКод", ДанныеДляЭДПродавцаДляГосНужд.КазначействоПродавцаКод);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
				"ДополнительныеСведенияОбУчастниках.ЗакупкаДляГосударственныхНужд.КазначействоПродавцаНаименование", ДанныеДляЭДПродавцаДляГосНужд.КазначействоПродавцаНаименование);
		КонецЕсли;	
		
		// Таблица НФА
		ТаблицаТоваров = Неопределено;
		
		Параметры = НовыйПараметрыЗаполнитьТаблицуТоваровУПД_2019();
		Параметры.ТаблицаНФА										= ТабличнаяЧасть;
		Параметры.НеобходимоЗаполнениеДанныхЭДОПродавцаДляГосНужд	= НеобходимоЗаполнениеДанныхЭДОПродавцаДляГосНужд;
		Параметры.ДанныеАктированияЕИС								= ДанныеАктированияДокументаРеализации;
		
		Если ЗначениеЗаполнено(РеквизитыШапки.Договор) Тогда
			ТипДоговораНДС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РеквизитыШапки.Договор, "ТипДоговораНДС");
			
			Если ТипДоговораНДС = Перечисления.ТипыДоговоровДляНДС.РеализацияЛомаШкур Тогда
				Параметры.СчетФактураШкурыЛом = Истина;
			КонецЕсли;
		КонецЕсли;
		
		ЗаполнитьТаблицуТоваровУПД_2019(ТаблицаТоваров, Параметры, ДополнительныеПараметрыДокументаРеализации);
		
		ТолькоУслуги = Параметры.ТолькоУслуги;
		
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаТоваров,
			"Количество", "Количество", "Количество", 
			НСтр("ru = 'Не указано количество товара в табличной части.'"));
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаТоваров,
			"ЕдиницаИзмеренияНаименование", "ЕдиницаИзмеренияНаименование", "ЕдиницаИзмерения", 
			НСтр("ru = 'Не заполнена наименование единицы измерения в справочнике ""Номенклатура"".'"));
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаТоваров,
			"ЕдиницаИзмеренияКод", "ЕдиницаИзмеренияКод", "ЕдиницаИзмерения", 
			НСтр("ru = 'Не заполнен код единицы измерения в справочнике ""Номенклатура"".'"));
		
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаТоваров, "СведенияОТоварах");
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ТолькоУслуги", ТолькоУслуги);

		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ВсегоКОплате.ВсегоСтоимостьТоваровБезНалога", ТаблицаТоваров.Итог("СтоимостьТоваровБезНалога"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ВсегоКОплате.ВсегоСтоимостьТоваровСНалогом", ТаблицаТоваров.Итог("СтоимостьТоваровСНалогом"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ВсегоКОплате.ВсегоСуммаНалога", ТаблицаТоваров.Итог("СуммаНалога"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ВсегоКОплате.ВсегоКоличество", ТаблицаТоваров.Итог("Количество"));
		
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВидОперации", Перечисления.ВидыОперацийЭД.ПродажаКомиссия);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СодержаниеОперации", НСтр("ru = 'Товары переданы.'"));
	
	Если Не ЗначениеЗаполнено(РеквизитыШапки.Валюта) Тогда
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
			"Объект.ВалютаДокумента");
	Иначе
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(РеквизитыШапки.Валюта, 
			"Объект.Код");
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаКод", РеквизитыШапки.ВалютаКод, ПараметрыОбработкиОшибок);
	
	ОснованиеОтгрузкиТоваров = Новый ТаблицаЗначений;
	ОснованиеОтгрузкиТоваров.Колонки.Добавить("ДокументНаименование");
	ОснованиеОтгрузкиТоваров.Колонки.Добавить("ДокументНомер");
	ОснованиеОтгрузкиТоваров.Колонки.Добавить("ДокументДата");
	ОснованиеОтгрузкиТоваров.Колонки.Добавить("ДокументДопСведения");
	
	Если ЗначениеЗаполнено(РеквизитыШапки.ДокументОснованиеДата)
		ИЛИ ЗначениеЗаполнено(РеквизитыШапки.ДокументОснованиеНомер) Тогда
		НоваяСтрока = ОснованиеОтгрузкиТоваров.Добавить();
		НоваяСтрока.ДокументНаименование = РеквизитыШапки.ДокументОснованиеНаименование;
		НоваяСтрока.ДокументНомер = РеквизитыШапки.ДокументОснованиеНомер;
		НоваяСтрока.ДокументДата = НачалоДня(РеквизитыШапки.ДокументОснованиеДата);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РеквизитыШапки.ДокументОснование) И ТипЗнч(РеквизитыШапки.ДокументОснование) = Тип("ДокументСсылка.СчетНаОплату") Тогда
		ЗначенияРеквизитовОснованияПередачи = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыШапки.ДокументОснование, "Номер, Дата");

		НомерОснованияПередачи = РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоИмениДокумента("СчетНаОплату",
					ЗначенияРеквизитовОснованияПередачи.Номер);

		НоваяСтрока = ОснованиеОтгрузкиТоваров.Добавить();
		НоваяСтрока.ДокументНаименование = НСтр("ru = 'Счет на оплату'");
		НоваяСтрока.ДокументНомер = НомерОснованияПередачи;
		НоваяСтрока.ДокументДата = ЗначенияРеквизитовОснованияПередачи.Дата;
	КонецЕсли;	
	
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ОснованиеОтгрузкиТоваров,
		"ДокументДата", "ДокументДата", "Объект.Договор.ДатаДоговора", 
		НСтр("ru = 'Не заполнена дата договора для реквизита ""Договор"".'"));
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ОснованиеОтгрузкиТоваров, "ОснованиеОтгрузкиТоваров");
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОТранспортировке", "");
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ИныеСведенияОбОтгрузке", "");
	
	ТранспортнаяНакладная = Новый ТаблицаЗначений;
	ТранспортнаяНакладная.Колонки.Добавить("ТранспортнаяНакладнаяНомер");
	ТранспортнаяНакладная.Колонки.Добавить("ТранспортнаяНакладнаяДата");
	
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТранспортнаяНакладная, "ТранспортнаяНакладная");
	
КонецПроцедуры

Процедура ЗаполнитьДанныеПоАкт501ИсполнительУПД_2019(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ = Ложь) Экспорт
	НетЗамечанийКДокументу = Документы[СсылкаНаОбъект.Метаданные().Имя].ПредварительныйКонтрольДанныхДляЭД(СсылкаНаОбъект);
	
	Если НЕ НетЗамечанийКДокументу Тогда
		ОписаниеОшибки = НСтр("ru='Вышеуказанные ошибки препятствуют формированию электронного документа.
		|По этой причине и прочие данные документа не будут выгружены в ЭД.
		|После заполнения указанных реквизитов повторите попытку формирования электронного документа.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки);
		Отказ = Истина;
		Возврат;
	КонецЕсли;	
	
	ДанныеДляЭД = Документы[СсылкаНаОбъект.Метаданные().Имя].ПодготовитьДанныеДляЭД(СсылкаНаОбъект);
	Если ДанныеДляЭД.Шапка.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	
	
	РеквизитыШапки    = ДанныеДляЭД.Шапка[0];
	ТабличнаяЧасть = ДанныеДляЭД.ТабЧасть;

	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента", НомерДляПечати(СсылкаНаОбъект, РеквизитыШапки.НомерАкта));
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаДокумента",  РеквизитыШапки.ДатаАкта);

	// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	Контракт = ЭлектронноеАктированиеЕИС.ГосударственныйКонтрактДоговора(РеквизитыШапки.Договор);
	ЕстьЭлектронноеАктирование = ЭлектронноеАктированиеЕИС.ИспользоватьЭлектронноеАктированиеВЕИС()
		И ЗначениеЗаполнено(Контракт)
		И ЭлектронноеАктированиеЕИС.ОбменПоОрганизацииВключен(РеквизитыШапки.Организация);
	ДанныеДляЭД.Вставить("ЕстьЭлектронноеАктирование", ЕстьЭлектронноеАктирование);
	// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВидОперации", Перечисления.ВидыОперацийЭД.ПродажаКомиссия);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СодержаниеОперации", НСтр("ru = 'Услуги оказаны в полном объеме.'"));

	ИдентификаторГосКонтракта = ИдентификаторГосКонтрактаГОЗ(РеквизитыШапки.Договор);
		
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ДополнительныеСведенияОбУчастниках.ИдентификаторГосКонтракта", ИдентификаторГосКонтракта);
	
	Если Не ЗначениеЗаполнено(РеквизитыШапки.Валюта) Тогда
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
			"Объект.ВалютаДокумента");
	Иначе
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(РеквизитыШапки.Валюта, 
			"Объект.Код");
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаКод", РеквизитыШапки.ВалютаКод, ПараметрыОбработкиОшибок);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаОтгрузкиТоваров", РеквизитыШапки.ДатаАкта);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияДокументаОтгрузки", РеквизитыШапки.ДокументОснование);
	
	// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	Если ЕстьЭлектронноеАктирование Тогда
