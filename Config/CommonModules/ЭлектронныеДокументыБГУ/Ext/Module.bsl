		ЗаполнитьРеквизитыМаркировкиВСтрокеТоваровАктаОРасхождениях_2020(ТекСтрока, НоваяСтрока, КодыМаркировкиБой, СсылкаНаОбъект, "Бой");
		
		Сумма = Окр(ТекСтрока.КоличествоНедостача * ТекСтрока.ЦенаПоДокументам, 2);
		СуммаНДС = Окр(Сумма * КоэффициентСтавкиНДС, 2);
		СуммаСНДС = Сумма + СуммаНДС;
		НоваяСтрока.Недостача = Новый Структура;
		НоваяСтрока.Недостача.Вставить("Количество", ТекСтрока.КоличествоНедостача);
		НоваяСтрока.Недостача.Вставить("СуммаНДС", СуммаНДС);
		НоваяСтрока.Недостача.Вставить("СуммаСНДС", СуммаСНДС);
		НоваяСтрока.Недостача.Вставить("Пояснение", ТекСтрока.ПояснениеНедостача);
		
		ЗаполнитьРеквизитыМаркировкиВСтрокеТоваровАктаОРасхождениях_2020(ТекСтрока, НоваяСтрока, КодыМаркировкиНедостача, СсылкаНаОбъект, "Недостача");
		
		Сумма = Окр(ТекСтрока.КоличествоИзлишки * ТекСтрока.ЦенаПоДокументам, 2);
		СуммаНДС = Окр(Сумма * КоэффициентСтавкиНДС, 2);
		СуммаСНДС = Сумма + СуммаНДС;
		НоваяСтрока.Излишки = Новый Структура;
		НоваяСтрока.Излишки.Вставить("Количество", ТекСтрока.КоличествоИзлишки);
		НоваяСтрока.Излишки.Вставить("СуммаНДС", СуммаНДС);
		НоваяСтрока.Излишки.Вставить("СуммаСНДС", СуммаСНДС);
		НоваяСтрока.Излишки.Вставить("Пояснение", ТекСтрока.ПояснениеИзлишки);
		
		ЗаполнитьРеквизитыМаркировкиВСтрокеТоваровАктаОРасхождениях_2020(ТекСтрока, НоваяСтрока, КодыМаркировкиИзлишки, СсылкаНаОбъект, "Излишки");
		
		Если ЗначениеЗаполнено(ТекСтрока.ЦеновыеОтклоненияВсего)Тогда
			НоваяСтрока.ЦеновыеОтклонения = Новый Структура;
			НоваяСтрока.ЦеновыеОтклонения.Вставить("Цена", ТекСтрока.ЦеновыеОтклоненияЦена);
			НоваяСтрока.ЦеновыеОтклонения.Вставить("СуммаНДС", ТекСтрока.ЦеновыеОтклоненияСуммаНДС);
			НоваяСтрока.ЦеновыеОтклонения.Вставить("СуммаСНДС", ТекСтрока.ЦеновыеОтклоненияВсего);
			НоваяСтрока.ЦеновыеОтклонения.Вставить("Пояснение", ТекСтрока.ЦеновыеОтклоненияПояснение);
		КонецЕсли;
		
		// Сопоставление.
		Сопоставление = Новый Структура;
		Если ЗначениеЗаполнено(ТекСтрока.ИдентификаторПоставщика) Тогда
			Сопоставление.Вставить("Идентификатор", ТекСтрока.ИдентификаторПоставщика);
		КонецЕсли;
		Сопоставление.Вставить("НоменклатураИБ", ТекСтрока.Номенклатура);
		Сопоставление.Вставить("ХарактеристикаИБ", "");
		Сопоставление.Вставить("УпаковкаИБ", "");
		
		Сопоставление.Вставить("Наименование", ТекСтрока.НаименованиеТовара);
		Сопоставление.Вставить("Характеристика", ТекСтрока.ХарактеристикаТовара);
		Сопоставление.Вставить("ЕдиницаИзмерения", ТекСтрока.ЕдиницаИзмеренияНаименование);
		Сопоставление.Вставить("ЕдиницаИзмеренияКод", ТекСтрока.ЕдиницаИзмеренияКод);
		Сопоставление.Вставить("Артикул", ТекСтрока.АртикулТовара);
		Сопоставление.Вставить("СтавкаНДС", ТекСтрока.СтавкаНДСПоДокументам);
		
		НоваяСтрока.Сопоставление = Сопоставление;
		
	КонецЦикла;
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, РезультатыПриемки, "РезультатыПриемки");

	//Итоги приемки
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, "ФормированиеДополнительныхСведений", РеквизитыШапки.ФормированиеДополнительныхСведений);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(
			ДеревоДанных, "СодержаниеДополнительныхСведений", РеквизитыШапки.СодержаниеДополнительныхСведений);
	
	// Прилагаемые документы.
	ПрилагаемыеДокументыАкта = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
		ДеревоДанных, "ПрилагаемыеДокументы");
	Для каждого ТекСтрока Из ПрилагаемыеДокументы Цикл
		НоваяСтрока = ПрилагаемыеДокументыАкта.Добавить();
		НоваяСтрока.Наименование = ТекСтрока.ВидДокумента;
		НоваяСтрока.Номер = ТекСтрока.НомерДокумента;
		НоваяСтрока.Дата = ТекСтрока.ДатаДокумента;
	КонецЦикла;
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ПрилагаемыеДокументыАкта, "ПрилагаемыеДокументы");
	
КонецПроцедуры

// Функция возвращает значение ставки НДС.
//
// Параметры:
//  СтавкаНДС - ПеречислениеСсылка.СтавкиНДС - ставка НДС.
//
// Возвращаемое значение:
//  Число - значение ставки.
//
Функция ПолучитьСтавкуНДСЧислом(СтавкаНДС) Экспорт
	
	Возврат УчетНДСКлиентСервер.ПолучитьМножительСтавки(СтавкаНДС,, Истина);
	
КонецФункции


// Заполняет данные участника
//
// Участник - ссылка на организацию (Контрагенты, Организации)
// ВидУчастника - Строка. "Исполнитель", "Заказчик" и т.п. Наименование ветки в дереве данных
// ЭтоСчетФактура - Булево - Признак  того, что нужно анализировать наличие головной организации, т.е. это
//							признак, что имеет значение филиал это или нет. Необходимо, пока, только для
//							счетов-фактур исходящих.
Процедура ЗаполнитьДанныеУчастникаАктаОРасхождениях(Участник, 
								ВидУчастника, 
								ДатаДанных, 
								ДеревоДанных, 
								ЛицевойСчет = Неопределено, 
								РеквизитыЛицевогоСчета = Неопределено) Экспорт
								
	Если НЕ ЗначениеЗаполнено(Участник) Тогда
		Возврат;
	КонецЕсли;
	
	СведенияОбУчастнике = Новый Структура;
	ПолучитьДанныеЮрФизЛица(Участник, СведенияОбУчастнике, ДатаДанных, Ложь);
	
	Если СведенияОбУчастнике.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.ИНН", СведенияОбУчастнике.ИНН);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.КПП", СведенияОбУчастнике.КПП);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.НаименованиеОрганизации", СведенияОбУчастнике.ОфициальноеНаименование);
	Иначе
		Если ЗначениеЗаполнено(Участник.ЮридическоеФизическоеЛицо.ОГРНИП) ИЛИ ЗначениеЗаполнено(Участник.ЮридическоеФизическоеЛицо.СвидетельствоСерияНомер) Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИП.ИНН", СведенияОбУчастнике.ИНН);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИП.Фамилия", СведенияОбУчастнике.Фамилия);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИП.Имя", СведенияОбУчастнике.Имя);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИП.Отчество", СведенияОбУчастнике.Отчество);
		Иначе
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.ИНН", СведенияОбУчастнике.ИНН);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Фамилия", СведенияОбУчастнике.Фамилия);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Имя", СведенияОбУчастнике.Имя);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Отчество", СведенияОбУчастнике.Отчество);
		КонецЕсли;
	КонецЕсли;	

	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Участник", Участник);
	АдресУчастника = "";
	ПолучитьАдресСтруктурой(СтруктураПараметров, "Участник", "Юр");
	АдресУчастника = СтруктураПараметров.СтруктураАдреса;
	АдресУчастникаСтрокой = СтруктураПараметров.СтруктураАдреса.АдрТекст;
	АдресВСвободнойФорме = АдресЮридическийУКонтрагентаВСвободнойФорме(Участник);
	
	Если АдресВСвободнойФорме.ТипАдреса = "Муниципальный" Тогда
		АдресВСвободнойФорме.АдресТекст = АдресУчастникаСтрокой;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(АдресВСвободнойФорме.АдресТекст) Тогда
		КодСтраны = АдресВСвободнойФорме.КодСтраны;
		АдресТекст = АдресВСвободнойФорме.АдресТекст;
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".Адрес.АдресИнформация.КодСтраны", КодСтраны);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".Адрес.АдресИнформация.АдресТекст", АдресТекст);
	Иначе
		Если ТипЗнч(АдресУчастника) = Тип("Структура") Тогда
			Если (СтрДлина(АдресУчастника.Кварт)>20) ИЛИ (СтрДлина(АдресУчастника.Корпус)>20) Тогда
				КодСтраны = АдресУчастника.КодСтр;
				АдресТекст = АдресУчастникаСтрокой;
				
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".Адрес.АдресИнформация.КодСтраны", КодСтраны);
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".Адрес.АдресИнформация.АдресТекст", АдресТекст);
			Иначе
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".Адрес.АдресРФ.Индекс", АдресУчастника.Индекс);
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".Адрес.АдресРФ.КодРегиона", АдресУчастника.КодРегиона);
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".Адрес.АдресРФ.Район", АдресУчастника.Район);
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".Адрес.АдресРФ.Город", АдресУчастника.Город);
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".Адрес.АдресРФ.НаселенныйПункт", АдресУчастника.НаселенныйПункт);
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".Адрес.АдресРФ.Улица", АдресУчастника.Улица);
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".Адрес.АдресРФ.Дом", АдресУчастника.Дом);
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".Адрес.АдресРФ.Корпус", АдресУчастника.Корпус);
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".Адрес.АдресРФ.Квартира", АдресУчастника.Квартира);
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
	
	Если СведенияОбУчастнике.Свойство("Телефоны") Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".КонтактныеСведения.Телефон", СведенияОбУчастнике.Телефоны);
	КонецЕсли;	
	Если СведенияОбУчастнике.Свойство("ЭлектроннаяПочта") Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".КонтактныеСведения.ЭлектроннаяПочта", СведенияОбУчастнике.ЭлектроннаяПочта);
	КонецЕсли;	
	
	Если ЛицевойСчет <> Неопределено Тогда
		
		ЗаполнитьРеквизитыЛицевогоСчета(ЛицевойСчет, РеквизитыЛицевогоСчета);
		
		РасчетныеРеквизиты = Новый Структура("ИННПолучателя, КПППолучателя, ТекстПолучателя, НомерСчетаПолучателя, НаименованиеБанкаПолучателя, БикБанкаПолучателя, СчетБанкаПолучателя", "ИНН", "КПП", "Корреспондент", "СчетНомер", "Банк", "БИК", "КоррСчет");
	    ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(ЛицевойСчет, РеквизитыЛицевогоСчета, РасчетныеРеквизиты);
		
		ТекстБанка = "";
		НомерСчета = "";
		ТекстБанка = РасчетныеРеквизиты.НаименованиеБанкаПолучателя;
		Если НЕ ЗначениеЗаполнено(РеквизитыЛицевогоСчета) Тогда
			РасчетныеРеквизиты.НомерСчетаПолучателя = СокрЛП(ЛицевойСчет.Код);
			Если ТипЗнч(ЛицевойСчет) = Тип("СправочникСсылка.БанковскиеИКазначейскиеСчета") Тогда
				Если ТипЗнч(ЛицевойСчет.КассовыйОрган) = Тип("СправочникСсылка.Банки") Тогда
					ТекстБанка = ЛицевойСчет.КассовыйОрган.Наименование;
					РасчетныеРеквизиты.БикБанкаПолучателя = СокрЛП(ЛицевойСчет.КассовыйОрган.Код);
					НомерСчета = СокрЛП(РасчетныеРеквизиты.НомерСчетаПолучателя);
				ИначеЕсли ТипЗнч(ЛицевойСчет.КассовыйОрган) = Тип("СправочникСсылка.Казначейства") Тогда	
					ТекстБанка = ЛицевойСчет.СчетКазначейства.КассовыйОрган.Наименование + " " + ЛицевойСчет.СчетКазначейства.КассовыйОрган.Город + ", Казначейство: " +
					ЛицевойСчет.КассовыйОрган.Наименование + " ("+ЛицевойСчет.Владелец.НаименованиеСокращенное+", л/с "+ СокрЛП(ЛицевойСчет.Код)+")";
					РасчетныеРеквизиты.БикБанкаПолучателя = ЛицевойСчет.СчетКазначейства.КассовыйОрган.Код;
					НомерСчета = СокрЛП(ЛицевойСчет.СчетКазначейства.Код);
				КонецЕсли;
			КонецЕсли;
		Иначе
			ТекстБанка = РасчетныеРеквизиты.НаименованиеБанкаПолучателя;
			РасчетныеРеквизиты.БикБанкаПолучателя = РасчетныеРеквизиты.БикБанкаПолучателя;
			НомерСчета = РасчетныеРеквизиты.НомерСчетаПолучателя;
		КонецЕсли;	
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".БанковскийСчет.НомерСчета", НомерСчета);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".БанковскийСчет.НаимБанк", ТекстБанка);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".БанковскийСчет.БИК", РасчетныеРеквизиты.БикБанкаПолучателя);
	КонецЕсли;	
КонецПроцедуры	

