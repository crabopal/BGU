		               |	ЭлектронныйДокументПоставщика.ДатаПервичногоДокумента КАК ДатаДокумента,
		               |	ЭлектронныйДокументПоставщика.НомерПервичногоДокумента КАК НомерДокумента,
		               |	ЭлектронныйДокументПоставщика.ВидПервичногоДокумента КАК ВидДокумента
		               |ИЗ
		               |	Документ.ЭлектронныйДокументПоставщика КАК ЭлектронныйДокументПоставщика
		               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТДанные КАК ВТДанные
		               |		ПО ЭлектронныйДокументПоставщика.Организация = ВТДанные.Организация
		               |			И ЭлектронныйДокументПоставщика.Контрагент = ВТДанные.Контрагент
		               |			И ЭлектронныйДокументПоставщика.ДатаПервичногоДокумента = ВТДанные.ДатаПервичногоДокумента
		               |ГДЕ
		               |	ЭлектронныйДокументПоставщика.ПометкаУдаления = ЛОЖЬ
		               |	И ЭлектронныйДокументПоставщика.Организация = &Организация
		               |	И ЭлектронныйДокументПоставщика.Контрагент = &Контрагент";
		Запрос.УстановитьПараметр("Данные", ПараметрыПоискаДляДокументовПередачи);
		Запрос.УстановитьПараметр("Организация", Организация);
		Запрос.УстановитьПараметр("Контрагент", Контрагент);
		ДанныеПриложенийДляДокументовПередачи = Запрос.Выполнить().Выгрузить();
		
		Для Каждого ТекСтрока Из ДанныеПриложенийДляДокументовПередачи Цикл
			НоваяСтрока = ДанныеПриложенийДляЭлектронныхАктов0510448.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		КонецЦикла;
		
		Для Каждого ТекСтрока Из ДанныеЭДВходящегоИзвещения.ДокументыПередачиОтПоставщика Цикл
			Если НЕ ТекСтрока.НФАПереданыЭлектроннымАктом Тогда
				НоваяСтрокаРезультата = Результат.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаРезультата, ТекСтрока); 
				
				Для Каждого ТекСтрокаПоиска Из ДанныеПриложенийДляДокументовПередачи Цикл
					Если ТекСтрока.ДатаДокумента = ТекСтрокаПоиска.ДатаДокумента Тогда
						Если Врег(СокрЛП(ТекСтрока.НомерДокумента)) = Врег(СокрЛП(ТекСтрокаПоиска.НомерДокумента)) Тогда
							НоваяСтрокаРезультата.ДокументПриложения = ТекСтрокаПоиска.ДокументПриложения;
						КонецЕсли;	
					КонецЕсли;	
				КонецЦикла;	
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;
КонецФункции	

