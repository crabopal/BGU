КонецПроцедуры

Функция СведенияЭДИзвещения(СтруктураПараметров, СпособОбработки = "", НастройкаЭДО = Неопределено) Экспорт
	Результат = СведенияЭлектронногоИзвещения();
	НаправленияДокументов = ОбменСКонтрагентами.НаправленияДокументов();
	
	ДеревоРазбора = ДеревоЭлектронногоДокументаБЭД.ИнициализироватьДеревоРазбора();
	
	Если НЕ СтруктураПараметров.Свойство("ФайлДанных") Тогда
		Возврат СтруктураПараметров;
	КонецЕсли;
	
	Если СтруктураПараметров.Свойство("ДокументыУчета") Тогда
		ДокументыУчета = СтруктураПараметров.ДокументыУчета;
	Иначе
		ДокументыУчета = Неопределено;
	КонецЕсли;
	
	ОшибкаЗаписи = Ложь;
	ВремФайл = ПолучитьИмяВременногоФайла("xml");
	ДвоичныеДанныеФайла = СтруктураПараметров.ФайлДанных;
	ДвоичныеДанныеФайла.Записать(ВремФайл);
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("ПрикладнойТипДокумента", Перечисления.ПрикладныеВидыЭлектронныхДокументовБГУ.Извещение);
	
	СтруктураПодписей = Неопределено;
	ПараметрыЗаполнения.Вставить("ЭлектронныеПодписи", Новый Массив);
	ПараметрыЗаполнения.Вставить("СкрыватьДопДанные", Ложь);
	ПараметрыЗаполнения.Вставить("ЭлектронныеПодписи", СтруктураПараметров.ЭлектронныеПодписи);
	ПараметрыЗаполнения.Вставить("СодержаниеБезНомераПроводки", СтруктураПараметров.СодержаниеБезНомераПроводки);
	ПараметрыЗаполнения.Вставить("ЗаполнятьСодержимоеФайлов", СтруктураПараметров.ЗаполнятьСодержимоеФайлов);
	
	ПолучитьСведенияИзФайлаПрикладногоЭлектронногоДокумента(ДвоичныеДанныеФайла, ПараметрыЗаполнения, Результат);	
	
	РаботаСФайламиБЭД.УдалитьВременныеФайлы(ВремФайл);
	
	Возврат Результат;
КонецФункции	

Функция СведенияЭДИзвещенияПоДокументу(ДокументСсылка, СодержаниеБезНомераПроводки = Ложь) Экспорт
	Перем ЭД;

	Результат = Неопределено;
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Результат;	
	КонецЕсли;	
	
	ЭД = ЭлектронныйДокументБЭДПоДокументуУчета(ДокументСсылка);
	
	СведенияЭД = СведенияОбЭлектронномДокументе(ЭД);
	Если НЕ СведенияЭД.Актуальный Тогда
		Возврат Результат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	ФайлДанных = ПолучитьДанныеЭДДляИзвещения(ЭД);
	Если НЕ ЗначениеЗаполнено(ФайлДанных) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ДокументыУчета = Новый Массив;
	ДокументыУчета.Добавить(ДокументСсылка);
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ДокументыУчета", ДокументыУчета);
	
	СтруктураПараметров.Вставить("ФайлДанных",  ФайлДанных);
	СтруктураПараметров.Вставить("ЭлектронныеПодписи", СведенияЭД.Подписи);
	СтруктураПараметров.Вставить("СодержаниеБезНомераПроводки", СодержаниеБезНомераПроводки);
	СтруктураПараметров.Вставить("ЗаполнятьСодержимоеФайлов",  Ложь);
	
	Результат = СведенияЭДИзвещения(СтруктураПараметров);
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
КонецФункции

Функция СведенияЭДИзвещенияСФайламиПоДокументу(ДокументСсылка, СодержаниеБезНомераПроводки = Ложь) Экспорт
	Перем ЭД;

	Результат = Неопределено;
	
	Если НЕ ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Результат;	
	КонецЕсли;	
	
	ЭД = ЭлектронныйДокументБЭДПоДокументуУчета(ДокументСсылка);
	
	СведенияЭД = СведенияОбЭлектронномДокументе(ЭД);
	Если НЕ СведенияЭД.Актуальный Тогда
		Возврат Результат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	ФайлДанных = ПолучитьДанныеЭДДляИзвещения(ЭД);
	Если НЕ ЗначениеЗаполнено(ФайлДанных) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ДокументыУчета = Новый Массив;
	ДокументыУчета.Добавить(ДокументСсылка);
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ДокументыУчета", ДокументыУчета);
	
	СтруктураПараметров.Вставить("ФайлДанных",  ФайлДанных);
	СтруктураПараметров.Вставить("ЭлектронныеПодписи", СведенияЭД.Подписи);
	СтруктураПараметров.Вставить("СодержаниеБезНомераПроводки", СодержаниеБезНомераПроводки);
	СтруктураПараметров.Вставить("ЗаполнятьСодержимоеФайлов",  Истина);
	
	Результат = СведенияЭДИзвещения(СтруктураПараметров);
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
КонецФункции


Функция ЭлектронныйДокументБЭДПоДокументуУчета(ДокументУчета)
	Результат = Неопределено;

	ЭДПоДокументуУчета = ОсновнойЭлектронныйДокументОбъектаУчета(ДокументУчета);
	
	Если НЕ ЗначениеЗаполнено(ЭДПоДокументуУчета) Тогда
		ЭДПоДокументуУчета = ДокументУчета;
	КонецЕсли;	
	
	РезультатЭДО = ОбменСКонтрагентами.СтатусДокументооборота(ЭДПоДокументуУчета);
	
	Если ТипЗнч(РезультатЭДО) = Тип("Структура") Тогда
		ЭД = РезультатЭДО.ЭлектронныйДокумент;
		Если ЗначениеЗаполнено(ЭД) Тогда
			Результат = ЭД;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция ПолучитьДанныеЭДДляИзвещения(ЭлектронныйДокумент)
	Подписи = Новый ТаблицаЗначений;
	Подписи.Колонки.Добавить("Сертификат");
	Подписи.Колонки.Добавить("ПодписьВерна");
	Подписи.Колонки.Добавить("ДатаПодписи");
	Подписи.Колонки.Добавить("КомуВыданСертификат");
	
	Результат = Новый Структура;
	Результат.Вставить("Сообщение",  Неопределено);
	Результат.Вставить("Файл",  Неопределено);
	Результат.Вставить("Подписи",  Подписи);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СообщениеЭДО.ОсновнойФайл КАК ПрисоединенныйФайл
		|ИЗ
		|	Документ.СообщениеЭДО КАК СообщениеЭДО
		|ГДЕ
		|	СообщениеЭДО.ЭлектронныйДокумент = &ЭлектронныйДокумент
		|	И СообщениеЭДО.ТипЭлементаРегламента В(&ТипыЭлементовРегламента)
		|
		|УПОРЯДОЧИТЬ ПО
		|	СообщениеЭДО.Дата УБЫВ";
		
	Запрос.УстановитьПараметр("ЭлектронныйДокумент", ЭлектронныйДокумент);
	
	ТипыЭлементовРегламента = Новый Массив;
	ТипыЭлементовРегламента.Добавить(Перечисления.ТипыЭлементовРегламентаЭДО.ИнформацияОтправителя);
	Запрос.УстановитьПараметр("ТипыЭлементовРегламента", ТипыЭлементовРегламента);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Результат;
	КонецЕсли;
	
	СведенияЭД = РезультатЗапроса.Выгрузить();
	
	ПрисоединенныеФайлы = СведенияЭД.ВыгрузитьКолонку("ПрисоединенныйФайл");
	
	ДвоичныеДанныеФайлов = РаботаСФайлами.ДвоичныеДанныеФайлов(ПрисоединенныеФайлы);
	
	Если ТипЗнч(ДвоичныеДанныеФайлов) = Тип("Соответствие") Тогда
		Для Каждого ТекЗначение Из ДвоичныеДанныеФайлов Цикл
			Результат = ТекЗначение.Значение;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция ЭтоВходящийЭДО(ЭлектронныйДокумент)
	Возврат ТипЗнч(ЭлектронныйДокумент) = Тип("ДокументСсылка.ЭлектронныйДокументВходящийЭДО");
КонецФункции

Функция СведенияОбЭлектронномДокументе(ЭлектронныйДокумент) Экспорт
	
	Подписи = Новый ТаблицаЗначений;
	Подписи.Колонки.Добавить("Подписант", Новый ОписаниеТипов("СправочникСсылка.Пользователи"));
	Подписи.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	Подписи.Колонки.Добавить("Владелец", Новый ОписаниеТипов("Строка",
		Новый КвалификаторыСтроки(255, ДопустимаяДлина.Переменная)));
	//Доп.данные	
	Подписи.Колонки.Добавить("Сертификат");
	Подписи.Колонки.Добавить("ПодписьВерна");
	Подписи.Колонки.Добавить("ДатаПодписи");
	Подписи.Колонки.Добавить("КомуВыданСертификат");
		
	Сведения = Новый Структура;
	
	Сведения.Вставить("ОписаниеВидаДокумента", Новый Структура);
	Сведения.ОписаниеВидаДокумента.Вставить("ТипДокумента", Перечисления.ТипыДокументовЭДО.ПустаяСсылка());
	Сведения.ОписаниеВидаДокумента.Вставить("ПрикладнойТипДокумента", Неопределено);
	Сведения.ОписаниеВидаДокумента.Вставить("ИдентификаторКомандыПечати", "");
	
	Сведения.Вставить("Подписи", Подписи);
	Сведения.Вставить("ОбъектыУчета", Новый Массив);
	Сведения.Вставить("Актуальный", Ложь);
	Сведения.Вставить("СодержитМаркируемыеТовары", Ложь);
	
	Сведения.Вставить("Сообщения", Новый Структура);
	Сведения.Сообщения.Вставить("ДанныеОтправителя", Новый Структура);
	Сведения.Сообщения.ДанныеОтправителя.Вставить("ИмяФайлаБезРасширения", "");
	Сведения.Сообщения.ДанныеОтправителя.Вставить("Расширение", "");
	Сведения.Сообщения.Вставить("ДанныеПолучателя", Новый Структура);
	Сведения.Сообщения.ДанныеПолучателя.Вставить("ИмяФайлаБезРасширения", "");
	Сведения.Сообщения.ДанныеПолучателя.Вставить("Расширение", "");
	
	ТекстыЗапросов = Новый Массив;
	
	Если ЭтоВходящийЭДО(ЭлектронныйДокумент) Тогда
		ТекстыЗапросов.Добавить(
			"ВЫБРАТЬ
			|	ВидыДокументовЭДО.ТипДокумента КАК ТипДокумента,
			|	ВидыДокументовЭДО.ПрикладнойТипДокумента КАК ПрикладнойТипДокумента,
			|	ВидыДокументовЭДО.ИдентификаторКомандыПечати КАК ИдентификаторКомандыПечати,
			|	ЗНАЧЕНИЕ(Перечисление.ВидыЭлектронныхПодписей.УсиленнаяКвалифицированная) КАК ВидПодписи,
			|	ЭлектронныйДокументВходящийЭДО.СодержитМаркируемыеТовары КАК СодержитМаркируемыеТовары
			|ИЗ
			|	Документ.ЭлектронныйДокументВходящийЭДО КАК ЭлектронныйДокументВходящийЭДО
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыДокументовЭДО КАК ВидыДокументовЭДО
			|		ПО ЭлектронныйДокументВходящийЭДО.ВидДокумента = ВидыДокументовЭДО.Ссылка
			|		И ЭлектронныйДокументВходящийЭДО.Ссылка = &ЭлектронныйДокумент");
	Иначе
		ТекстыЗапросов.Добавить(
			"ВЫБРАТЬ
			|	ВидыДокументовЭДО.ТипДокумента КАК ТипДокумента,
			|	ВидыДокументовЭДО.ПрикладнойТипДокумента КАК ПрикладнойТипДокумента,
			|	ВидыДокументовЭДО.ИдентификаторКомандыПечати КАК ИдентификаторКомандыПечати,
			|	ЭлектронныйДокументИсходящийЭДО.ВидПодписи КАК ВидПодписи,
			|	ЭлектронныйДокументИсходящийЭДО.СодержитМаркируемыеТовары КАК СодержитМаркируемыеТовары
			|ИЗ
			|	Документ.ЭлектронныйДокументИсходящийЭДО КАК ЭлектронныйДокументИсходящийЭДО
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыДокументовЭДО КАК ВидыДокументовЭДО
			|		ПО ЭлектронныйДокументИсходящийЭДО.ВидДокумента = ВидыДокументовЭДО.Ссылка
			|		И ЭлектронныйДокументИсходящийЭДО.Ссылка = &ЭлектронныйДокумент");
	КонецЕсли;
	
	ТекстыЗапросов.Добавить(ИнтеграцияЭДО.ТекстЗапросаОбъектовУчетаЭлектронныхДокументов());
	
	ТекстыЗапросов.Добавить(
		"ВЫБРАТЬ
		|	СообщениеЭДО.ОсновнойФайл КАК Ссылка,
		|	СообщениеЭДО.ОсновнойФайл.ПолноеИмяФайла КАК ПолноеИмяФайла,
		|	СообщениеЭДО.ТипЭлементаРегламента
		|ИЗ
		|	Документ.СообщениеЭДО КАК СообщениеЭДО
		|ГДЕ
		|	СообщениеЭДО.ЭлектронныйДокумент = &ЭлектронныйДокумент
		|	И СообщениеЭДО.ТипЭлементаРегламента В (&ТипыЭлементовРегламента)");
	
	ТипыЭлементовРегламента = Новый Массив;
	ТипыЭлементовРегламента.Добавить(Перечисления.ТипыЭлементовРегламентаЭДО.ИнформацияОтправителя);
	ТипыЭлементовРегламента.Добавить(Перечисления.ТипыЭлементовРегламентаЭДО.ИнформацияПолучателя);
	
	Запрос = Новый Запрос;
	Запрос.Текст = СтрСоединить(ТекстыЗапросов, ОбщегоНазначения.РазделительПакетаЗапросов());
	Запрос.УстановитьПараметр("ЭлектронныйДокумент", ЭлектронныйДокумент);
	Запрос.УстановитьПараметр("ТипыЭлементовРегламента", ТипыЭлементовРегламента);
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	Если РезультатыЗапроса[0].Пустой() Тогда
		Возврат Сведения;
	КонецЕсли;
	
	ВыборкаОписанияВида = РезультатыЗапроса[0].Выбрать();
	ВыборкаОписанияВида.Следующий();
	ЗаполнитьЗначенияСвойств(Сведения.ОписаниеВидаДокумента, ВыборкаОписанияВида);
	ЗаполнитьЗначенияСвойств(Сведения, ВыборкаОписанияВида);
	
	ВыборкаОбъектовУчета = РезультатыЗапроса[1].Выбрать();
	Пока ВыборкаОбъектовУчета.Следующий() Цикл
		Сведения.ОбъектыУчета.Добавить(ВыборкаОбъектовУчета.ОбъектУчета);
		Если ВыборкаОбъектовУчета.Актуальный Тогда
			Сведения.Актуальный = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Сведения.Актуальный = Не РезультатыЗапроса[1].Пустой();
	
	ВыборкаФайлов = РезультатыЗапроса[2].Выбрать();
	Пока ВыборкаФайлов.Следующий() Цикл
		Если ВыборкаОписанияВида.ВидПодписи = Перечисления.ВидыЭлектронныхПодписей.Простая Тогда
			ПростыеПодписи = УстановленныеПростыеПодписи(ВыборкаФайлов.Ссылка);
			Для Каждого СвойстваПодписи Из ПростыеПодписи Цикл
				СтрокаПодписи = Сведения.Подписи.Добавить();
				СтрокаПодписи.Подписант = СвойстваПодписи.УстановившийПодпись;
				СтрокаПодписи.Дата = СвойстваПодписи.ДатаПодписи;
				СтрокаПодписи.Владелец = СвойстваПодписи.ВладелецПодписи;
			КонецЦикла;
		Иначе
			ЭлектронныеПодписи = ЭлектроннаяПодпись.УстановленныеПодписи(ВыборкаФайлов.Ссылка);
			Для Каждого СвойстваПодписи Из ЭлектронныеПодписи Цикл
				СтрокаПодписи = Сведения.Подписи.Добавить();
				СтрокаПодписи.Подписант = СвойстваПодписи.УстановившийПодпись;
				СтрокаПодписи.Дата = СвойстваПодписи.ДатаПодписи;
				СтрокаПодписи.Владелец = СвойстваПодписи.КомуВыданСертификат;
				
				СтрокаПодписи.Сертификат = СвойстваПодписи.Сертификат;
				СтрокаПодписи.КомуВыданСертификат = СвойстваПодписи.КомуВыданСертификат;
				СтрокаПодписи.ПодписьВерна = СвойстваПодписи.ПодписьВерна;
				СтрокаПодписи.ДатаПодписи = СвойстваПодписи.ДатаПодписи;
				
			КонецЦикла;
		КонецЕсли;
		
		// Заполним сведения о сообщениях
		Если ВыборкаФайлов.ТипЭлементаРегламента = Перечисления.ТипыЭлементовРегламентаЭДО.ИнформацияОтправителя Тогда
			ТипЭлементаРегламента = "ДанныеОтправителя";
		Иначе
			ТипЭлементаРегламента = "ДанныеПолучателя";			
		КонецЕсли;
		
		СведенияОИмениФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ВыборкаФайлов.ПолноеИмяФайла);
		ЭлементСведений = Сведения.Сообщения[ТипЭлементаРегламента]; 
		ЭлементСведений.ИмяФайлаБезРасширения = СведенияОИмениФайла.ИмяБезРасширения;
		ЭлементСведений.Расширение = ОбщегоНазначенияКлиентСервер.РасширениеБезТочки(СведенияОИмениФайла.Расширение);
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(Сведения.Сообщения.ДанныеПолучателя.ИмяФайлаБезРасширения) Тогда
		Сведения.Сообщения.ДанныеПолучателя = Неопределено;
	КонецЕсли;
	
	Возврат Сведения;
	
КонецФункции

Функция УстановленныеПростыеПодписи(Ссылка)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПростыеЭлектронныеПодписи.ПорядковыйНомер КАК ПорядковыйНомер,
		|	ПростыеЭлектронныеПодписи.ДатаПодписи КАК ДатаПодписи,
		|	ПростыеЭлектронныеПодписи.ВладелецПодписи КАК ВладелецПодписи,
		|	ПростыеЭлектронныеПодписи.Должность КАК Должность,
		|	ПростыеЭлектронныеПодписи.Пользователь КАК УстановившийПодпись
		|ИЗ
		|	РегистрСведений.ПростыеЭлектронныеПодписи КАК ПростыеЭлектронныеПодписи
		|ГДЕ
		|	ПростыеЭлектронныеПодписи.ПодписанныйОбъект = &Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПорядковыйНомер";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция ШиринаТабличногоДокументаВСимволах(ТабличныйДокумент) Экспорт
	
	ШиринаВСимволах = 0;
	Для н = 1 По ТабличныйДокумент.ШиринаТаблицы Цикл
		
		ШаблонАдресаОбласти = "R%1C%2";
		АдресОбласти = СтрШаблон(ШаблонАдресаОбласти, Формат(ТабличныйДокумент.ВысотаТаблицы - 1,"ЧГ="), н);
		Область = ТабличныйДокумент.Область(АдресОбласти);
		ШиринаВСимволах = ШиринаВСимволах + Область.ШиринаКолонки;
		
	КонецЦикла;
	
	Возврат ШиринаВСимволах;
	
КонецФункции

Процедура ЗаполнитьОбластьШтампа(Область, Подпись) Экспорт
	Если ЗначениеЗаполнено(Подпись.Сертификат) Тогда
		Сертификат = Новый СертификатКриптографии(Подпись.Сертификат.Получить());
		
		Шаблон = НСтр("ru='с %1 по %2'");
		СрокДействия = СтрШаблон(Шаблон, Сертификат.ДатаНачала, Сертификат.ДатаОкончания);
		
		ОтметкаВерна   = НСтр("ru='Подпись верна'");
		ОтметкаНеВерна = НСтр("ru='Подпись не верна'");
		ТекстОтметки = ?(Подпись.ПодписьВерна, ОтметкаВерна, ОтметкаНеВерна);
		
		ЗначенияПараметров = Новый Структура;
		ЗначенияПараметров.Вставить("ДатаПодписи",         Подпись.ДатаПодписи);
		ЗначенияПараметров.Вставить("Организация",         Сертификат.Субъект.CN);
		ЗначенияПараметров.Вставить("НомерСертификата",    Сертификат.СерийныйНомер);
		ЗначенияПараметров.Вставить("ВыдалСертификат",     Сертификат.Издатель.CN);
		ЗначенияПараметров.Вставить("ВладелецСертификата", Подпись.КомуВыданСертификат);
		ЗначенияПараметров.Вставить("СрокДействия",        СрокДействия);
		ЗначенияПараметров.Вставить("ТекстОтметки",        ТекстОтметки);
		
		Область.Параметры.Заполнить(ЗначенияПараметров);
	КонецЕсли;	
КонецПроцедуры

Процедура ДобавитьШтампыЭлектронныхПодписей(ТабличныйДокумент, ПодписиОтправителя, ПодписиПолучателя, ПараметрыПечати, ТипИзвещения) Экспорт
	ВсегоПодписей = ПодписиОтправителя.Количество();
	Если ПодписиПолучателя.Количество() > ВсегоПодписей Тогда
		ВсегоПодписей = ПодписиПолучателя.Количество();
	КонецЕсли;	
	
	// Штамп электронной подписи.
	Штамп = Новый ТабличныйДокумент;

	МакетЭПБГУ = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет.ШтампВнешнегоЭДОБГУ");
	
	МакетЭП = Обработки.КриптографияБЭД.ПолучитьМакет(
		СтрШаблон("ШтампЭП_%1", ОбщегоНазначения.КодОсновногоЯзыка()));
	МакетЭП.КодЯзыка = Метаданные.Языки.Русский.КодЯзыка;
	
	Подписи = Новый ТаблицаЗначений;
	Подписи.Колонки.Добавить("Подписант", Новый ОписаниеТипов("СправочникСсылка.Пользователи"));
	Подписи.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	Подписи.Колонки.Добавить("Владелец", Новый ОписаниеТипов("Строка",
		Новый КвалификаторыСтроки(255, ДопустимаяДлина.Переменная)));
	Подписи.Колонки.Добавить("Сертификат");
	Подписи.Колонки.Добавить("ПодписьВерна");
	Подписи.Колонки.Добавить("ДатаПодписи");
	Подписи.Колонки.Добавить("КомуВыданСертификат");
	
	Для н = 0 По ВсегоПодписей-1 Цикл
		Счетчик = 0;
		Подписи.Очистить();
		
		Если н < ПодписиОтправителя.Количество() Тогда
			НовПодпись = Подписи.Добавить();
			ЗаполнитьЗначенияСвойств(НовПодпись, ПодписиОтправителя[н]);
		Иначе
			НовПодпись = Подписи.Добавить();
		КонецЕсли;	
		
		Если н < ПодписиПолучателя.Количество() Тогда
			НовПодпись = Подписи.Добавить();
			ЗаполнитьЗначенияСвойств(НовПодпись, ПодписиПолучателя[н]);
		Иначе
			НовПодпись = Подписи.Добавить();
		КонецЕсли;	
		
		Для Каждого Подпись Из Подписи Цикл
			Счетчик = Счетчик + 1;
			ОбластьШтамп = МакетЭП.ПолучитьОбласть("ШтампОдинарныйСтрока|ШтампОдинарный");
			ОбластьШтампПустой = МакетЭП.ПолучитьОбласть("ШтампОдинарныйСтрока|ШтампОдинарныйРазделитель");
			Если ЗначениеЗаполнено(Подпись.Сертификат) Тогда
				ЗаполнитьОбластьШтампа(ОбластьШтамп, Подпись);
				
				Если Счетчик = 1 Тогда
					ОбщегоНазначенияБЭД.ВывестиОбластьВТабличныйДокумент(Штамп, ОбластьШтамп, "ШтампЭП" + Счетчик);
				Иначе
					
					// Определим ширину табличного документа, чтобы правильно разнести штампы, если их 2.
					Если ПараметрыПечати.Свойство("ШиринаДокумента") Тогда
						ШиринаДокумента = ПараметрыПечати.ШиринаДокумента;
					Иначе
						ШиринаДокумента = ШиринаТабличногоДокументаВСимволах(ТабличныйДокумент);
					КонецЕсли;
					
					ШиринаШтампа = ШиринаТабличногоДокументаВСимволах(ОбластьШтамп);
					ШиринаРазделителя = ШиринаДокумента - ШиринаШтампа * 2;
					
					Если ШиринаРазделителя > 0 Тогда
						Разделитель = МакетЭП.ПолучитьОбласть("ШтампОдинарныйСтрока|ШтампОдинарныйРазделитель");
						Разделитель.Область().ШиринаКолонки = ШиринаРазделителя;
						ОбщегоНазначенияБЭД.ПрисоединитьОбластьКТабличномуДокументу(Штамп, Разделитель, "Разделитель");
					КонецЕсли;
				
					ОбщегоНазначенияБЭД.ПрисоединитьОбластьКТабличномуДокументу(Штамп, ОбластьШтамп, "ШтампЭП" + Счетчик);
					
				КонецЕсли;
				
			Иначе
				ОбластьШтампПустойБГУ = МакетЭПБГУ.ПолучитьОбласть("ШтампОдинарныйПустойСтрока|ШтампОдинарный");
				ОбщегоНазначенияБЭД.ВывестиОбластьВТабличныйДокумент(Штамп, ОбластьШтампПустойБГУ, "ШтампЭП" + Счетчик);
			КонецЕсли;	
		
		КонецЦикла;
	
		Штамп.Область().СоздатьФорматСтрок();
		ОбщегоНазначенияБЭД.ВывестиОбластьВТабличныйДокумент(ТабличныйДокумент, Штамп, "ШтампЭП");
		Штамп.Очистить();
	КонецЦикла;	
	
	// Конец Штамп электронной подписи.
КонецПроцедуры	

Функция ПользовательСотрудника(Сотрудник) Экспорт
	Результат = Справочники.Пользователи.ПустаяСсылка();
	
	СтруктураДанныхСотрудника = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Сотрудник, "Контрагент");
	СтруктураДанныхКонтрагента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтруктураДанныхСотрудника.Контрагент, "ИНН");
	
	ИННСотрудника = СокрЛП(СтруктураДанныхКонтрагента.ИНН);
	
	Если ЗначениеЗаполнено(ИННСотрудника) Тогда
		
		УстановитьПривилегированныйРежим(Истина);
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 1
		               |	Пользователи.Ссылка КАК Пользователь,
		               |	Пользователи.ФизическоеЛицо КАК ФизическоеЛицо
		               |ИЗ
		               |	Справочник.Пользователи КАК Пользователи
		               |ГДЕ
		               |	НЕ Пользователи.ФизическоеЛицо = ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
		               |	И ВЫРАЗИТЬ(Пользователи.ФизическоеЛицо КАК Справочник.ФизическиеЛица).ИНН = &ИННСотрудника";
		Запрос.УстановитьПараметр("ИННСотрудника", ИННСотрудника);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Результат = Выборка.Пользователь;		
		КонецЕсли;	
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция КоличествоПриложенийКИзвещению(Приложения)
	Результат = 0;
	
	МассивПриложений = Новый Массив;
	
	Для Каждого ТекСтрока Из Приложения Цикл
		Если ЗначениеЗаполнено(ТекСтрока.ВидДокумента) Тогда
			ШаблонДокумента = НСтр("ru = '%1 %2 %3'");
			НаименованиеДокумента = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонДокумента, ТекСтрока.ВидДокумента, ТекСтрока.НомерДокумента, ТекСтрока.ДатаДокумента);
			
			Если МассивПриложений.Найти(НаименованиеДокумента) = Неопределено Тогда
				МассивПриложений.Добавить(НаименованиеДокумента);
			КонецЕсли;	
			
		КонецЕсли;
	КонецЦикла;
	
	Результат = МассивПриложений.Количество();
	
	Возврат Результат;
КонецФункции

Функция ДляВходящегоИзвещенияЕстьЭДП(ВходящееИзвещение) Экспорт
	Результат = Ложь;
	
	Если НЕ ЗначениеЗаполнено(ВходящееИзвещение) Тогда
		Возврат Результат;
	КонецЕсли;	
	
	ЭДП = Новый ТаблицаЗначений;
	
	ЗаполнитьСписокЭлектронныхДокументовПоставщикаПоИзвещению(ВходящееИзвещение, ЭДП);
	
	Если ЭДП.Количество() > 0 Тогда
		Результат = Истина;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции
	
Функция ДокументПоставкиПоИдентификаторуОснованияСчетаФактуры(ИдентификаторОснования)
	Результат = "";
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторОснования) Тогда
		Возврат Результат;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	         |	ПоступлениеУслугРабот.Ссылка КАК Ссылка
	         |ИЗ
	         |	Документ.ПоступлениеУслугРабот КАК ПоступлениеУслугРабот
	         |ГДЕ
	         |	ПоступлениеУслугРабот.ИдентификаторДокументаОснованияЭДО = &ИдентификаторДокументаОснованияЭДО
	         |
	         |ОБЪЕДИНИТЬ ВСЕ
	         |
	         |ВЫБРАТЬ
	         |	ЭлектронныйДокументПоставщика.Ссылка
	         |ИЗ
	         |	Документ.ЭлектронныйДокументПоставщика КАК ЭлектронныйДокументПоставщика
	         |ГДЕ
	         |	ЭлектронныйДокументПоставщика.ИдентификаторДокументаОснованияЭДО = &ИдентификаторДокументаОснованияЭДО";
	Запрос.УстановитьПараметр("ИдентификаторДокументаОснованияЭДО", ИдентификаторОснования);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

Функция НомерПроводкиПоСодержанию(Содержание) Экспорт
	Результат = 0;
	НомерПроводки = "";
	ПозицияТочки = Найти(Содержание, ".");
	Если ПозицияТочки > 0 Тогда
		НомерПроводки = Сред(Содержание, 0, ПозицияТочки-1);
		Результат = Число(НомерПроводки);
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции	

Функция АктПриемкиСодержитРасхождения(АктПриемки) Экспорт
	Результат = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	АктПриемкиМ7Материалы.Ссылка КАК Ссылка,
	               |	АктПриемкиМ7Материалы.КоличествоПоДокументам - АктПриемкиМ7Материалы.Количество КАК РасхожденияКоличества,
	               |	АктПриемкиМ7Материалы.СуммаПоДокументам - АктПриемкиМ7Материалы.Сумма КАК РасхожденияСуммы
	               |ИЗ
	               |	Документ.АктПриемкиМ7.Материалы КАК АктПриемкиМ7Материалы
	               |ГДЕ
	               |	АктПриемкиМ7Материалы.Ссылка = &АктПриемкиСсылка
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	АктПриемкиМ7ОсновныеСредства.Ссылка,
	               |	АктПриемкиМ7ОсновныеСредства.КоличествоПоДокументам - АктПриемкиМ7ОсновныеСредства.Количество,
	               |	АктПриемкиМ7ОсновныеСредства.СуммаПоДокументам - АктПриемкиМ7ОсновныеСредства.Сумма
	               |ИЗ
	               |	Документ.АктПриемкиМ7.ОсновныеСредства КАК АктПриемкиМ7ОсновныеСредства
	               |ГДЕ
	               |	АктПриемкиМ7ОсновныеСредства.Ссылка = &АктПриемкиСсылка
	               |ИТОГИ
	               |	СУММА(РасхожденияКоличества),
	               |	СУММА(РасхожденияСуммы)
	               |ПО
	               |	Ссылка";
	Запрос.УстановитьПараметр("АктПриемкиСсылка", АктПриемки);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Если Выборка.РасхожденияКоличества <> 0 ИЛИ Выборка.РасхожденияСуммы <> 0 Тогда
			Результат = Истина;
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

Функция GUIDДокументаПоставщикаУОтправителяЭДП(АктПриемки)
	Результат = "";
	ДокОснованиеАкта = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(АктПриемки, "ДокументОснование");
	
	Если ТипЗнч(ДокОснованиеАкта) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда
		Результат = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокОснованиеАкта, "GUIDДокументаПоставщикаУОтправителя");
	ИначеЕсли ТипЗнч(ДокОснованиеАкта) = Тип("ДокументСсылка.ПоступлениеМЗ") Тогда
		ДокументОснованиеПоступления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокОснованиеАкта, "ДокументОснование");
		Результат = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОснованиеПоступления, "GUIDДокументаПоставщикаУОтправителя");
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

Функция СведенияИнвентарногоНомераНФАПоСОдержаниюПроводки(ИнвентарныеНомераОСОрганизации, Содержание)
    Результат = Новый Структура;

	ИнвентарныйНомер = Справочники.ИнвентарныеНомераОС.ПустаяСсылка();
	GUIDИнвентарногоНомера = "";
	ИнвентарныйНомерКод = "";
	ИнвентарныйНомерУОтправителя = "";
	СтрокиПоиска = "инв. №:";
	
	ПозицияНачала = СтрНайти(Содержание, СтрокиПоиска);
	СтрДлинаСтрокиПоиска = СтрДлина(СтрокиПоиска);
	Если ПозицияНачала > 0 Тогда
		ПозицияОкончания = СтрНайти(Содержание, ",", , ПозицияНачала);
		Если ПозицияОкончания > 0 Тогда
			ИнвентарныйНомерКод = СокрЛП(Сред(Содержание, ПозицияНачала + СтрДлинаСтрокиПоиска, ПозицияОкончания - ПозицияНачала - СтрДлинаСтрокиПоиска));
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеЗаполнено(ИнвентарныйНомерКод) Тогда
		Если ИнвентарныеНомераОСОрганизации.Количество() > 0 Тогда
			
			Если ИнвентарныеНомераОСОрганизации[ИнвентарныйНомерКод] <> Неопределено Тогда
				ИнвентарныйНомер = ИнвентарныеНомераОСОрганизации[ИнвентарныйНомерКод];
				Если ЗначениеЗаполнено(ИнвентарныйНомер) Тогда
					GUIDИнвентарногоНомера = Строка(ИнвентарныйНомер.УникальныйИдентификатор());
					
					СтруктураДанныхИнвНомераОС = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ИнвентарныйНомер, "GUIDИнвентарногоНомераУОтправителя");
					Если ЗначениеЗаполнено(СтруктураДанныхИнвНомераОС.GUIDИнвентарногоНомераУОтправителя) Тогда
						ИнвентарныйНомерУОтправителя = СтруктураДанныхИнвНомераОС.GUIDИнвентарногоНомераУОтправителя;
					КонецЕсли;	
				КонецЕсли;
			КонецЕсли;	
			
		КонецЕсли;	
	КонецЕсли;	
	
	Результат.Вставить("ИнвентарныйНомер", ИнвентарныйНомерКод);
	Результат.Вставить("GUIDИнвентарногоНомера", GUIDИнвентарногоНомера);
	Результат.Вставить("ИнвентарныйНомерУОтправителя", ИнвентарныйНомерУОтправителя);

	Возврат Результат;
КонецФункции

Функция ИнвентарныеНомераОСОрганизации(Организация)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИнвентарныеНомераОС.Ссылка КАК Ссылка,
	               |	ИнвентарныеНомераОС.ОС КАК ОС,
	               |	ИнвентарныеНомераОС.Код КАК Код
	               |ИЗ
	               |	Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	               |ГДЕ
	               |	ИнвентарныеНомераОС.Владелец = &Организация
	               |	И ИнвентарныеНомераОС.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("Организация", Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	Результат = Новый Соответствие;
	Пока Выборка.Следующий() Цикл 
		Если Результат[Выборка.Код] = Неопределено Тогда
			
			Результат.Вставить(Выборка.Код, Выборка.Ссылка);	
			
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

Функция НоменклатураСGUIDОтправителя()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Номенклатура.Ссылка КАК Ссылка,
	               |	Номенклатура.GUIDНоменклатурыОтправителя КАК GUIDНоменклатурыОтправителя
	               |ИЗ
	               |	Справочник.Номенклатура КАК Номенклатура
	               |ГДЕ
	               |	Номенклатура.ПометкаУдаления = ЛОЖЬ
	               |	И ДЛИНАСТРОКИ(Номенклатура.GUIDНоменклатурыОтправителя) > 0";
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
КонецФункции

Функция ОсновныеСредстваСGUIDОтправителя(Организация)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ОсновныеСредства.Ссылка КАК Ссылка,
	               |	ОсновныеСредства.GUIDНоменклатурыОтправителя КАК GUIDНоменклатурыОтправителя
	               |ИЗ
	               |	Справочник.ОсновныеСредства КАК ОсновныеСредства
	               |ГДЕ
	               |	ОсновныеСредства.ПометкаУдаления = ЛОЖЬ
	               |	И ОсновныеСредства.Организация = &Организация
				   |	И ДЛИНАСТРОКИ(ОсновныеСредства.GUIDНоменклатурыОтправителя) > 0";
	Запрос.УстановитьПараметр("Организация", Организация);
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
КонецФункции

Функция ОтправительИзвещенияЯвляетсяПолучателемОбъектовПередачи(ТипИзвещения, РПБСВместоИНН = Ложь)
	Результат = Ложь;

	Если (ТипИзвещения = 19 ИЛИ ТипИзвещения = 23 ИЛИ ТипИзвещения = 25 ИЛИ ТипИзвещения = 27 ИЛИ ТипИзвещения = 29) Тогда
		Результат = Истина;
	КонецЕсли;
	
	Если РПБСВместоИНН И Результат Тогда
		Если НЕ (ТипИзвещения = 19) Тогда
			Результат = Ложь;
		КонецЕсли;	
	КонецЕсли;	

	Возврат Результат;
КонецФункции	

Функция ОтправительОтветногоИзвещенияЯвляетсяОтправителемОбъектовПередачи(ТипИзвещения, РПБСВместоИНН = Ложь)
	Результат = Ложь;

	Если (ТипИзвещения = 20 ИЛИ ТипИзвещения = 24 ИЛИ ТипИзвещения = 26 ИЛИ ТипИзвещения = 28 ИЛИ ТипИзвещения = 30 ИЛИ ТипИзвещения = 32) Тогда
		Результат = Истина;
	КонецЕсли;
	
	Если РПБСВместоИНН И Результат Тогда
		Если НЕ (ТипИзвещения = 20) Тогда
			Результат = Ложь;
		КонецЕсли;	
	КонецЕсли;	

	Возврат Результат;
КонецФункции

Процедура ЗаменитьДанныеОтправителяНаДанныеПолучателя(ДанныеЭДИзвещения) Экспорт
	
	ДанныеЭДИзвещения.ДанныеПодвал.ДолжностьИсполнительОтправитель = ДанныеЭДИзвещения.ДанныеПодвал.ДолжностьИсполнительПолучатель;
	ДанныеЭДИзвещения.ДанныеПодвал.ДолжностьИсполнительПолучатель = "";
	ДанныеЭДИзвещения.ДанныеПодвал.ТелефонИсполнительОтправитель = ДанныеЭДИзвещения.ДанныеПодвал.ТелефонИсполнительПолучатель;
	ДанныеЭДИзвещения.ДанныеПодвал.ТелефонИсполнительПолучатель = "";
	ДанныеЭДИзвещения.ДанныеПодвал.ФИОИсполнительОтправитель = ДанныеЭДИзвещения.ДанныеПодвал.ФИОИсполнительПолучатель;
	ДанныеЭДИзвещения.ДанныеПодвал.ФИОИсполнительПолучатель = "";
	ДанныеЭДИзвещения.ДанныеПодвал.ЭлАдресИсполнительОтправитель = ДанныеЭДИзвещения.ДанныеПодвал.ЭлАдресИсполнительПолучатель;
	ДанныеЭДИзвещения.ДанныеПодвал.ЭлАдресИсполнительПолучатель = "";
	ДанныеЭДИзвещения.ДанныеПодвал.пФИОБухгалтерОтправитель = ДанныеЭДИзвещения.ДанныеПодвал.пФИОБухгалтерПолучатель;
	ДанныеЭДИзвещения.ДанныеПодвал.пФИОБухгалтерПолучатель = "";
	ДанныеЭДИзвещения.ДанныеПодвал.пФИОРуководительОтправитель = ДанныеЭДИзвещения.ДанныеПодвал.пФИОРуководительПолучатель;
	ДанныеЭДИзвещения.ДанныеПодвал.пФИОРуководительПолучатель = "";
	
	Для Каждого ТекСтрока Из ДанныеЭДИзвещения.ТаблицаОборотыВЖурналОпераций Цикл;
		ТекСтрока.пДебетСчетОтправитель = ТекСтрока.пДебетСчетПолучатель;
		ТекСтрока.пКредитСчетОтправитель = ТекСтрока.пКредитСчетПолучатель;
		ТекСтрока.пСуммаОтправитель = ТекСтрока.пСуммаПолучатель;
	КонецЦикла;	
	
	Для Каждого ТекСтрока Из ДанныеЭДИзвещения.ТаблицаПроводок Цикл;
		ТекСтрока.пДебетСчетОтправитель = ТекСтрока.пДебетСчетПолучатель;
		ТекСтрока.пКредитСчетОтправитель = ТекСтрока.пКредитСчетПолучатель;
		ТекСтрока.пСуммаОтправитель = ТекСтрока.пСуммаПолучатель;
		ТекСтрока.пДебетСчетПолучатель = "";
		ТекСтрока.пКредитСчетПолучатель = "";
		ТекСтрока.пСуммаПолучатель = "";
	КонецЦикла;	

	Для Каждого ТекСтрока Из ДанныеЭДИзвещения.ТаблицаРекомендуемыеОборотыВЖурналОпераций Цикл;
		ТекСтрока.пДебетСчетОтправитель = ТекСтрока.пДебетСчетПолучатель;
		ТекСтрока.пКредитСчетОтправитель = ТекСтрока.пКредитСчетПолучатель;
		ТекСтрока.пСуммаОтправитель = ТекСтрока.пСуммаПолучатель;
	КонецЦикла;	
	
	Для Каждого ТекСтрока Из ДанныеЭДИзвещения.ТаблицаРекомендуемыхПроводок Цикл;
		ТекСтрока.пДебетСчетОтправитель = ТекСтрока.пДебетСчетПолучатель;
		ТекСтрока.пКредитСчетОтправитель = ТекСтрока.пКредитСчетПолучатель;
		ТекСтрока.пСуммаОтправитель = ТекСтрока.пСуммаПолучатель;
		ТекСтрока.пДебетСчетПолучатель = "";
		ТекСтрока.пКредитСчетПолучатель = "";
		ТекСтрока.пСуммаПолучатель = "";
	КонецЦикла;	
	
КонецПроцедуры	

Процедура ЗаполнитьСведенияДокументовПоставщиковПоДокументамПоступления(СтруктураДанных, ВыборкаШапки, ПараметрыФормирования, ТипФорматаЭДП, ДокументXDTO, ДокументПриложения)
	НомерПередачиПоПорядку = 1;
	ВалютаДокументаПоУмолчанию = Константы.ВалютаРегламентированногоУчета.Получить();
	ТипЭлектронногоИзвещения = ВыборкаШапки.ТипЭлектронногоИзвещения;
	Если (ТипФорматаЭДП = 9) Тогда
		СтруктураДанныхДокументаПоступления = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументПриложения,
			"ВидПервичногоДокумента, ДатаПервичногоДокумента, НомерПервичногоДокумента, СуммаДокумента, ВалютаДокумента");
		ВидДокумента = СтруктураДанныхДокументаПоступления.ВидПервичногоДокумента;
		ДатаДокумента = Формат(СтруктураДанныхДокументаПоступления.ДатаПервичногоДокумента, "ДФ=dd.MM.yyyy");
		НомерДокумента = СтруктураДанныхДокументаПоступления.НомерПервичногоДокумента;
		НаименованиеДокументаПоставщика = СокрЛП(ВидДокумента) + " от " + ДатаДокумента + " № " 
			+ СокрЛП(НомерДокумента);
		СуммаДокумента = СтруктураДанныхДокументаПоступления.СуммаДокумента;	
		ВалютаДокумента = СтруктураДанныхДокументаПоступления.ВалютаДокумента;
		Если НЕ ЗначениеЗаполнено(ВалютаДокумента) Тогда
			ВалютаДокумента = ВалютаДокументаПоУмолчанию;
		КонецЕсли;	
		
		ДокументПоставщикаXDTO = СоздатьОбъектXDTO(ДокументXDTO, "ДокументыПоставщика");
		
		ДокументПоставщикаXDTO.Установить("ВидДокумента", ВидДокумента);
		Если ЗначениеЗаполнено(ДатаДокумента) Тогда
			ДокументПоставщикаXDTO.Установить("Дата", ДатаДокумента);
		КонецЕсли;
		ДокументПоставщикаXDTO.Установить("Номер", НомерДокумента);
		
		ДокументПоставщикаXDTO.Установить("Наим", НаименованиеДокументаПоставщика);
		
		Если ТипЭлектронногоИзвещения = 23 Тогда
			ДокументПоставщикаXDTO.СведенияПолучателяНФА = Истина;
		КонецЕсли;	
		
		ЭлектронныйДокументПоставщика = ДокументПриложения;

		ДокументПередачиПоставщика = Новый ТаблицаЗначений;
		ДокументПередачиПоставщика.Колонки.Добавить("ДокументПередачи", СтруктураДанных.ДокументыПередачи.Колонки.ДокументПередачи.ТипЗначения);
		ДокументПередачиПоставщика.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
		НоваяСтрокаДок = ДокументПередачиПоставщика.Добавить();
		НоваяСтрокаДок.НомерСтроки = НомерПередачиПоПорядку;
		НоваяСтрокаДок.ДокументПередачи = ЭлектронныйДокументПоставщика;
		ПередаваемыеПроводкиДокументаПоставщика = ПроводкиПоДокументамПередачи(ДокументПередачиПоставщика, ПараметрыФормирования.СсылкаНаОбъект);
		
		ДокументПоставщикаXDTO.Установить("СуммаДокумента", СуммаДокумента);
		ДокументПоставщикаXDTO.Установить("GUIDДокумента", Строка(ЭлектронныйДокументПоставщика.УникальныйИдентификатор()));
		ДокументПоставщикаXDTO.Установить("ТипФорматаЭД", Формат(ТипФорматаЭДП,"ЧЦ=10"));
		ДокументПоставщикаXDTO.Установить("СуммаВключаетНДС", ?(ЭлектронныйДокументПоставщика.СуммаВключаетНДС,"Да","Нет"));
		
		Если ЗначениеЗаполнено(ВалютаДокумента) Тогда
			ДокументПоставщикаXDTO.Установить("ВалютаКод", ВалютаДокумента.Код);
			ДокументПоставщикаXDTO.Установить("ВалютаНаим", СокрЛП(ВалютаДокумента));
		КонецЕсли;
		
		СписокНоменклатурыCИдентификаторами = Новый ТаблицаЗначений;
		СписокНоменклатурыCИдентификаторами.Колонки.Добавить("Номенклатура");
		СписокНоменклатурыCИдентификаторами.Колонки.Добавить("ИдентификаторСтроки", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(36)));
		СписокНоменклатурыCИдентификаторами.Колонки.Добавить("ЕдиницаИзмерения", Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"));
		
		Для Каждого ТекНоменклатура Из ЭлектронныйДокументПоставщика.Материалы Цикл
			
			ДанныеПроводок = ДанныеДляНоменклатурыИзПередаваемыхПроводок(ПередаваемыеПроводкиДокументаПоставщика, ТекНоменклатура);
			
			Номенклатура = ТекНоменклатура.Номенклатура;
			
			ЗначенияРеквизитовНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, "GUIDНоменклатурыОтправителя");
			
			СтрокаСпискаНоменклатурыXDTO = СоздатьОбъектXDTO(ДокументПоставщикаXDTO, "СписокНоменклатурыПоставщика");
			СтрокаСпискаНоменклатурыXDTO.Установить("GUIDНоменклатуры", Строка(Номенклатура.УникальныйИдентификатор()));
			СтрокаСпискаНоменклатурыXDTO.Установить("GUIDНоменклатурыОтправителя", Строка(ЗначенияРеквизитовНоменклатуры.GUIDНоменклатурыОтправителя));
			
			НоваяНоменклатураИGUID = СписокНоменклатурыCИдентификаторами.Добавить();
			НоваяНоменклатураИGUID.Номенклатура = Номенклатура;
			НоваяНоменклатураИGUID.ИдентификаторСтроки = ТекНоменклатура.ИдентификаторСтроки;
			НоваяНоменклатураИGUID.ЕдиницаИзмерения = Штуки();
			
			СтрокаСпискаНоменклатурыXDTO.Установить("НаимНоменклатуры", Номенклатура.Наименование);
			СтрокаСпискаНоменклатурыXDTO.Установить("ПолноеНаимНоменклатуры", Номенклатура.НаименованиеПолное);
			СтрокаСпискаНоменклатурыXDTO.Установить("СтавкаНДС", СтавкаНДССтрокой(ТекНоменклатура.СтавкаНДС));
			РодительскаяГруппа = ТекНоменклатура.Номенклатура.Родитель;
			СтрокаСпискаНоменклатурыXDTO.Установить("ГруппаСправочника", СокрЛП(РодительскаяГруппа));
			СтрокаСпискаНоменклатурыXDTO.Установить("НоменклатурныйНомер", Номенклатура.НоменклатурныйНомер);
			ПризнакНоменклатуры = НСтр("ru = '1МЗ'");
			СтрокаСпискаНоменклатурыXDTO.Установить("ПризнакНоменклатуры", ПризнакНоменклатуры);
			
			Цена = 0;
			Сумма = 0;
			СуммаНДС = 0;
			Всего = 0;
			Если ДанныеПроводок.Цена = 0 Тогда
				Если ТекНоменклатура.Количество <> 0 Тогда
					Цена = ТекНоменклатура.Всего / ТекНоменклатура.Количество;
				КонецЕсли;
			Иначе
				Цена = ДанныеПроводок.Цена;
			КонецЕсли;	
			Если ДанныеПроводок.Сумма = 0 Тогда
				Сумма = ТекНоменклатура.Сумма;
			Иначе
				Сумма = ДанныеПроводок.Сумма;
			КонецЕсли;	
			Если ДанныеПроводок.СуммаНДС = 0 Тогда
				СуммаНДС = ТекНоменклатура.СуммаНДС;
			Иначе
				СуммаНДС = ДанныеПроводок.СуммаНДС;
			КонецЕсли;	
			Если ДанныеПроводок.Всего = 0 Тогда
				Всего = ТекНоменклатура.Всего;
			Иначе
				Всего = ДанныеПроводок.Всего;
			КонецЕсли;	
				
			СтрокаСпискаНоменклатурыXDTO.Установить("Цена", Формат(Цена, "ЧЦ=17; ЧДЦ=2"));
			СтрокаСпискаНоменклатурыXDTO.Установить("Сумма", Формат(Сумма, "ЧЦ=17; ЧДЦ=2"));
			СтрокаСпискаНоменклатурыXDTO.Установить("Количество", Формат(ТекНоменклатура.Количество, "ЧЦ=17; ЧДЦ=3"));
			СтрокаСпискаНоменклатурыXDTO.Установить("СуммаНДС", Формат(СуммаНДС, "ЧЦ=17; ЧДЦ=2"));
			СтрокаСпискаНоменклатурыXDTO.Установить("Всего", Формат(Всего, "ЧЦ=17; ЧДЦ=2"));
			
			Если ТипЗнч(ТекНоменклатура.Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
				СтрокаСпискаНоменклатурыXDTO.Установить("ТипСправочника", НСтр("ru = 'Номенклатура'"));
				Если ЗначениеЗаполнено(Номенклатура.ЕдиницаИзмерения) Тогда
					ЕдиницаИзмерения = Номенклатура.ЕдиницаИзмерения;
					СтрокаСпискаНоменклатурыXDTO.Установить("ЕдИзмКод", ЕдиницаИзмерения.Код);
					СтрокаСпискаНоменклатурыXDTO.Установить("ЕдИзмНаим", ЕдиницаИзмерения.Наименование);
					НоваяНоменклатураИGUID.ЕдиницаИзмерения = ЕдиницаИзмерения;
				Иначе	
