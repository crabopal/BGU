	               |			ТОГДА НачислениеДоходовНачисления.Сумма
	               |		ИНАЧЕ НачислениеДоходовНачисления.Сумма + НачислениеДоходовНачисления.СуммаНДС
	               |	КОНЕЦ,
	               |	&РегламентированнаяВалюта,
	               |	НачислениеДоходовНачисления.Ссылка.Дата,
	               |	НачислениеДоходовНачисления.Ссылка.Дата,
	               |	НачислениеДоходовНачисления.Ссылка.Номер,
	               |	НачислениеДоходовНачисления.Ссылка,
	               |	НачислениеДоходовНачисления.НомерСтроки,
	               |	НачислениеДоходовНачисления.Ссылка,
	               |	ВЫРАЗИТЬ(ВЫРАЗИТЬ(НачислениеДоходовНачисления.НачислениеЗаУслугу КАК Справочник.НачисленияСтудентамЗаПрочиеУслуги).Номенклатура КАК Справочник.Номенклатура).КодКаталога,
	               |	ВЫРАЗИТЬ(ВЫРАЗИТЬ(НачислениеДоходовНачисления.НачислениеЗаУслугу КАК Справочник.НачисленияСтудентамЗаПрочиеУслуги).Номенклатура КАК Справочник.Номенклатура).КодПоКТРУ,
	               |	ВЫРАЗИТЬ(ВЫРАЗИТЬ(НачислениеДоходовНачисления.НачислениеЗаУслугу КАК Справочник.НачисленияСтудентамЗаПрочиеУслуги).Номенклатура КАК Справочник.Номенклатура).КодТНВЭД,
	               |	1,
	               |	ВЫРАЗИТЬ(НачислениеДоходовНачисления.Контрагент КАК Справочник.Контрагенты).ОбособленноеПодразделение,
	               |	ВЫРАЗИТЬ(НачислениеДоходовНачисления.Контрагент КАК Справочник.Контрагенты).ГоловнаяОрганизация,
	               |	ВЫБОР
	               |		КОГДА НачислениеДоходовНачисления.Контрагент.ОбособленноеПодразделение = ИСТИНА
	               |			ТОГДА ВЫБОР
	               |					КОГДА НачислениеДоходовНачисления.Контрагент.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	               |						ТОГДА """"
	               |					КОГДА НЕ НачислениеДоходовНачисления.Контрагент.ГоловнаяОрганизация.НаименованиеСокращенное = """"
	               |						ТОГДА НачислениеДоходовНачисления.Контрагент.ГоловнаяОрганизация.НаименованиеСокращенное
	               |					КОГДА НачислениеДоходовНачисления.Контрагент.ГоловнаяОрганизация.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	               |							И НЕ НачислениеДоходовНачисления.Контрагент.ГоловнаяОрганизация.ЮридическоеФизическоеЛицо.НаименованиеПолное = """"
	               |						ТОГДА ВЫРАЗИТЬ(НачислениеДоходовНачисления.Контрагент.ГоловнаяОрганизация.ЮридическоеФизическоеЛицо.НаименованиеПолное КАК СТРОКА(1000))
	               |					ИНАЧЕ НачислениеДоходовНачисления.Контрагент.ГоловнаяОрганизация.Наименование
	               |				КОНЕЦ
	               |		ИНАЧЕ """"
	               |	КОНЕЦ,
	               |	ВЫБОР
	               |		КОГДА НачислениеДоходовНачисления.Контрагент.ОбособленноеПодразделение = ИСТИНА
	               |			ТОГДА ВЫБОР
	               |					КОГДА НачислениеДоходовНачисления.Контрагент.ГоловнаяОрганизация = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	               |						ТОГДА """"
	               |					ИНАЧЕ НачислениеДоходовНачисления.Контрагент.ГоловнаяОрганизация.ЮридическоеФизическоеЛицо.ИНН
	               |				КОНЕЦ
	               |		ИНАЧЕ """"
	               |	КОНЕЦ,
	               |	"""",
	               |	&ОтветственныйПередалТРУВид,
	               |	&ОтветственныйПередалТРУДолжность,
	               |	&ОтветственныйПередалТРУИныеСведения,
	               |	&ОтветственныйПередалТРУ,
	               |	&ОтветственныйПередалТРУДоверенность,
	               |	&ОтветственныйПередалТРУОснованиеПолномочий,
	               |	&ОтветственныйПередалТРУКонтрагент,
	               |	&ДатаПередачиТРУ,
	               |	&ТРУПереданы
	               |ИЗ
	               |	Документ.НачислениеСтудентамЗаПрочиеУслуги.Начисления КАК НачислениеДоходовНачисления
	               |ГДЕ
	               |	НачислениеДоходовНачисления.Ссылка = &Ссылка
	               |	И НачислениеДоходовНачисления.ИдентификаторЭД В(&ПереченьИдентификаторовЭД)";
	               
	
	Запрос = Новый Запрос(ТекстЗапроса);			   
	Запрос.УстановитьПараметр("Ссылка", СтруктураДанных.ДокументОснование);	
	Запрос.УстановитьПараметр("ПереченьИдентификаторовЭД", ПереченьИдентификаторовЭД);
	Запрос.УстановитьПараметр("СсылкаНаПередаточныйДокумент", СсылкаНаПередаточныйДокумент);
	Запрос.УстановитьПараметр("РегламентированнаяВалюта", ВалютаРегУчета);
	Запрос.УстановитьПараметр("ОтветственныйПередалТРУВид", ДанныеПередающегоТРУЛица.ОтветственныйПередалТРУВид);
	Запрос.УстановитьПараметр("ОтветственныйПередалТРУДолжность", ДанныеПередающегоТРУЛица.ОтветственныйПередалТРУДолжность);
	Запрос.УстановитьПараметр("ОтветственныйПередалТРУИныеСведения", ДанныеПередающегоТРУЛица.ОтветственныйПередалТРУИныеСведения);
	Запрос.УстановитьПараметр("ОтветственныйПередалТРУ", ДанныеПередающегоТРУЛица.ОтветственныйПередалТРУ);
	Запрос.УстановитьПараметр("ОтветственныйПередалТРУДоверенность", ДанныеПередающегоТРУЛица.ОтветственныйПередалТРУДоверенность);
	Запрос.УстановитьПараметр("ОтветственныйПередалТРУОснованиеПолномочий", ДанныеПередающегоТРУЛица.ОтветственныйПередалТРУОснованиеПолномочий);
	Запрос.УстановитьПараметр("ОтветственныйПередалТРУКонтрагент", ДанныеПередающегоТРУЛица.ОтветственныйПередалТРУКонтрагент);
	Запрос.УстановитьПараметр("ДатаПередачиТРУ", ДанныеПередающегоТРУЛица.ДатаПередачиТРУ);
	Запрос.УстановитьПараметр("ТРУПереданы", ДанныеПередающегоТРУЛица.ТРУПереданы);
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	Шапка = МассивРезультатов[0].Выгрузить();
	
	ОписаниеСтроки = Новый ОписаниеТипов("Строка");
	ОписаниеСуммы = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2));
	ОписаниеКоличества = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 3));

	Шапка.Колонки.Добавить("НомерАкта", ОписаниеСтроки);
	
	СписокНоменклатуры = Новый ТаблицаЗначений;
	СписокНоменклатуры.Колонки.Добавить("НомерСтроки", ОписаниеСтроки);
	СписокНоменклатуры.Колонки.Добавить("НаименованиеНоменклатуры", ОписаниеСтроки);
	СписокНоменклатуры.Колонки.Добавить("ТоварНаименование", ОписаниеСтроки);
	СписокНоменклатуры.Колонки.Добавить("КодТовара", ОписаниеСтроки);
	СписокНоменклатуры.Колонки.Добавить("ЕдиницаИзмеренияНаименование", ОписаниеСтроки);
	СписокНоменклатуры.Колонки.Добавить("ЕдиницаИзмеренияКод", ОписаниеСтроки);
	СписокНоменклатуры.Колонки.Добавить("Количество", ОписаниеКоличества);
	СписокНоменклатуры.Колонки.Добавить("Цена", ОписаниеСуммы);
	СписокНоменклатуры.Колонки.Добавить("ЦенаАктаВыполненныхРабот", ОписаниеСуммы);
	СписокНоменклатуры.Колонки.Добавить("Сумма", ОписаниеСуммы);
	СписокНоменклатуры.Колонки.Добавить("Всего", ОписаниеСуммы);
	СписокНоменклатуры.Колонки.Добавить("СуммаБезНДС", ОписаниеСуммы);
	СписокНоменклатуры.Колонки.Добавить("СуммаНДС", ОписаниеСуммы);
	СписокНоменклатуры.Колонки.Добавить("СуммаСНДС", ОписаниеСуммы);
	СписокНоменклатуры.Колонки.Добавить("Описание", ОписаниеСтроки);
	СписокНоменклатуры.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	СписокНоменклатуры.Колонки.Добавить("СтавкаНДС");
	СписокНоменклатуры.Колонки.Добавить("СодержаниеУслуги", ОписаниеСтроки);
	СписокНоменклатуры.Колонки.Добавить("КодКаталога", ОписаниеСтроки);
	СписокНоменклатуры.Колонки.Добавить("КодПоКТРУ", ОписаниеСтроки);
	СписокНоменклатуры.Колонки.Добавить("КодТНВЭД", ОписаниеСтроки);
	
	Для каждого ТекСтрока Из Шапка Цикл
		НомерАкта = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ТекСтрока.Ссылка, ТекСтрока.Номер) + "/" + СокрЛП(ТекСтрока.НомерСтроки);
		ТекСтрока.НомерАкта = НомерАкта;
		
		СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекСтрока.Номенклатура, "Наименование,
			|НаименованиеПолное, ЕдиницаИзмерения, НоменклатурныйНомер, Код");
		НаименованиеНоменклатуры = ?(ЗначениеЗаполнено(СтруктураДанных.НаименованиеПолное), СтруктураДанных.НаименованиеПолное,
			СтруктураДанных.Наименование);
		СодержаниеУслуги = НаименованиеНоменклатуры +
					", " + Формат(ТекСтрока.Дата, "ДФ=""ММММ гггг 'г.'"""); // Добавляем месяц.
		Если ЗначениеЗаполнено(ТекСтрока.СодержаниеУслуги) Тогда
			СодержаниеУслуги = ТекСтрока.СодержаниеУслуги;
		КонецЕсли;	
		
		СтруктураДанныхЕдИзм = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтруктураДанных.ЕдиницаИзмерения, "Наименование, Код");
		
		ЦенаСНДСОкр = ?(ТекСтрока.Количество = 0,
			ТекСтрока.Всего,
			Окр(ТекСтрока.Всего / ТекСтрока.Количество, 2));
			
		НоваяСтрока = СписокНоменклатуры.Добавить();
		НоваяСтрока.НомерСтроки = 1;
		НоваяСтрока.НаименованиеНоменклатуры = СодержаниеУслуги;
		НоваяСтрока.ТоварНаименование = СодержаниеУслуги;
		НоваяСтрока.КодТовара = ?(ЗначениеЗаполнено(СтруктураДанных.НоменклатурныйНомер), СтруктураДанных.НоменклатурныйНомер, СтруктураДанных.Код);
		НоваяСтрока.ЕдиницаИзмеренияНаименование = СтруктураДанныхЕдИзм.Наименование;
		НоваяСтрока.ЕдиницаИзмеренияКод = СтруктураДанныхЕдИзм.Код;
		НоваяСтрока.Количество = ТекСтрока.Количество;
		НоваяСтрока.Цена = ЦенаСНДСОкр;
		НоваяСтрока.ЦенаАктаВыполненныхРабот = ЦенаСНДСОкр;
		НоваяСтрока.СуммаБезНДС = ТекСтрока.Всего - ТекСтрока.СуммаНДС;
		НоваяСтрока.СуммаНДС = ТекСтрока.СуммаНДС;
		НоваяСтрока.СуммаСНДС = ТекСтрока.Всего;
		НоваяСтрока.Описание = СодержаниеУслуги;
		НоваяСтрока.Номенклатура = ТекСтрока.Номенклатура;
		НоваяСтрока.СтавкаНДС = ТекСтрока.СтавкаНДС;
		НоваяСтрока.Сумма = НоваяСтрока.СуммаБезНДС;
		НоваяСтрока.Всего = ТекСтрока.Всего;
		НоваяСтрока.СодержаниеУслуги = СодержаниеУслуги;
	КонецЦикла;
	
	Структура = Новый Структура("Шапка, СписокНоменклатуры, ТабЧасть",
		Шапка,
		СписокНоменклатуры,
		СписокНоменклатуры);
	
	Возврат Структура;
	
КонецФункции	

Функция ДанныеРебенкаДляЭДО(Ребенок, ДоговорРебенка) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("КонтрагентЭДО", Справочники.Контрагенты.ПустаяСсылка());
	Результат.Вставить("ДоговорКонтрагентаЭДО", Справочники.Договоры.ПустаяСсылка());
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПлательщикиПоДДУЭДО.КонтрагентЭДО КАК КонтрагентЭДО,
	               |	ПлательщикиПоДДУЭДО.ДоговорКонтрагентаЭДО КАК ДоговорКонтрагентаЭДО
	               |ИЗ
	               |	РегистрСведений.ПлательщикиПоДДУЭДО КАК ПлательщикиПоДДУЭДО
	               |ГДЕ
	               |	ПлательщикиПоДДУЭДО.Ребенок = &Ребенок
	               |	И ПлательщикиПоДДУЭДО.Договор = &Договор";
	
	Запрос.УстановитьПараметр("Ребенок", Ребенок);
	Запрос.УстановитьПараметр("Договор", ДоговорРебенка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.КонтрагентЭДО = Выборка.КонтрагентЭДО;
		Результат.ДоговорКонтрагентаЭДО = Выборка.ДоговорКонтрагентаЭДО;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

#КонецОбласти

// Заполняет данные участника для счета на оплату
//
// Участник - ссылка на организацию (Контрагенты, Организации)
// ВидУчастника - Строка. "Исполнитель", "Заказчик" и т.п. Наименование ветки в дереве данных
Процедура ЗаполнитьДанныеУчастникаСчетаНаОплату(Участник, 
								ВидУчастника, 
								ДатаДанных, 
								ДеревоДанных, 
								ЛицевойСчет = Неопределено, 
								РеквизитыЛицевогоСчета = Неопределено,
								ГоловнаяОрганизация = Неопределено,
								ГоловнаяОрганизацияНаименование = "",
								ГоловнаяОрганизацияИНН = "") Экспорт
								
	Если НЕ ЗначениеЗаполнено(Участник) Тогда
		Возврат;
	КонецЕсли;
	
	Контрагент = Участник;
	
	СведенияОбУчастнике = Новый Структура;
	ПолучитьДанныеЮрФизЛица(Участник, СведенияОбУчастнике, ДатаДанных, Ложь);
	
	Если СведенияОбУчастнике.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
		ИННУчастника = СведенияОбУчастнике.ИНН;
		КППУчастника = СведенияОбУчастнике.КПП;
		НаименованиеУчастника = СведенияОбУчастнике.ОфициальноеНаименование;
		Если ВидУчастника = "Продавец" Тогда
			Если ЗначениеЗаполнено(ЛицевойСчет) Тогда
				РеквизитыПолучателя = Новый Структура("ИННПолучателя, КПППолучателя, ТекстПолучателя, НомерСчетаПолучателя, НаименованиеБанкаПолучателя, БикБанкаПолучателя, СчетБанкаПолучателя", "ИНН", "КПП", "Корреспондент", "СчетНомер", "Банк", "БИК", "КоррСчет");
				ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(ЛицевойСчет, РеквизитыЛицевогоСчета, РеквизитыПолучателя, Истина);
				ДанныеОрганизации = Новый Структура;
				ЗаполнитьРегистрационныеДанныеОрганизации(Участник, ДанныеОрганизации);

				НаименованиеУчастника = ДанныеОрганизации.Наименование;
				ИННУчастника = РеквизитыПолучателя.ИННПолучателя;
				КППУчастника = РеквизитыПолучателя.КПППолучателя;
			КонецЕсли;
		ИначеЕсли ВидУчастника = "Покупатель" Тогда
			Если ЗначениеЗаполнено(ГоловнаяОрганизация) Тогда
				НаименованиеУчастника = ГоловнаяОрганизацияНаименование;
				ИННУчастника = ГоловнаяОрганизацияИНН;
				Контрагент = ГоловнаяОрганизация;
			КонецЕсли;	
		КонецЕсли;
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.ИНН", ИННУчастника);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.КПП", КППУчастника);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.НаименованиеОрганизации", НаименованиеУчастника);
	Иначе
		Если ЗначениеЗаполнено(Участник.ЮридическоеФизическоеЛицо.ОГРНИП) ИЛИ ЗначениеЗаполнено(Участник.ЮридическоеФизическоеЛицо.СвидетельствоСерияНомер) Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.ИНН", СведенияОбУчастнике.ИНН);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Фамилия", СведенияОбУчастнике.Фамилия);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Имя", СведенияОбУчастнике.Имя);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Отчество", СведенияОбУчастнике.Отчество);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.ПолноеНаименование", Участник.НаименованиеСокращенное);
		Иначе
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.ИНН", СведенияОбУчастнике.ИНН);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Фамилия", СведенияОбУчастнике.Фамилия);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Имя", СведенияОбУчастнике.Имя);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Отчество", СведенияОбУчастнике.Отчество);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.ПолноеНаименование", СведенияОбУчастнике.ПолноеНаименование);
		КонецЕсли;
	КонецЕсли;	

	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Участник", Контрагент);
	АдресУчастника = "";
	ПолучитьАдресСтруктурой(СтруктураПараметров, "Участник", "Юр");
	АдресУчастника = СтруктураПараметров.СтруктураАдреса;
	АдресУчастникаСтрокой = СтруктураПараметров.СтруктураАдреса.АдрТекст;
	АдресВСвободнойФорме = АдресЮридическийУКонтрагентаВСвободнойФорме(Контрагент);
	
	Если АдресВСвободнойФорме.ТипАдреса = "Муниципальный" Тогда
		АдресВСвободнойФорме.АдресТекст = АдресУчастникаСтрокой;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(АдресВСвободнойФорме.АдресТекст) Тогда
		АдресУчастника = АдресВСвободнойФорме;
		
		ТипАдреса = "Произвольный";
		СтруктураПараметров.Вставить("ТипАдреса", ТипАдреса);
		ПолныйПуть = ВидУчастника + ".Адрес.Структурированный";
		ЗаполнитьАдресВДереве(ДеревоДанных, АдресУчастника, СтруктураПараметров.ТипАдреса, ВидУчастника);
	Иначе	
		Если ЗначениеЗаполнено(АдресУчастникаСтрокой) Тогда
			Если (СтрДлина(АдресУчастника.Кварт)>20) ИЛИ (СтрДлина(АдресУчастника.Корпус)>20) Тогда
				ТипАдреса = "Произвольный";
				СтруктураПараметров.Вставить("ТипАдреса", ТипАдреса);
				ПолныйПуть = ВидУчастника + ".Адрес.Структурированный";
				ЗаполнитьАдресВДереве(ДеревоДанных, АдресУчастника, СтруктураПараметров.ТипАдреса, ВидУчастника);
			Иначе	
				ПолныйПуть = ВидУчастника + ".Адрес.Структурированный";
				Если ЭлектронноеВзаимодействие.СуществуетРеквизитВДереве(ДеревоДанных, ПолныйПуть) Тогда
					ТипАдреса = ?(АдресУчастника.АдресРФ, "Структурированный", "Иностранный");
				Иначе
					ТипАдреса = "Произвольный";
				КонецЕсли;
				СтруктураПараметров.Вставить("ТипАдреса", ТипАдреса);
				
				ЗаполнитьАдресВДереве(ДеревоДанных, АдресУчастника, СтруктураПараметров.ТипАдреса, ВидУчастника);
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;	
		
	Если ЛицевойСчет <> Неопределено Тогда
		
		ЗаполнитьРеквизитыЛицевогоСчета(ЛицевойСчет, РеквизитыЛицевогоСчета);
		
		РасчетныеРеквизиты = Новый Структура("ИННПолучателя, КПППолучателя, ТекстПолучателя, НомерСчетаПолучателя, НаименованиеБанкаПолучателя, БикБанкаПолучателя, СчетБанкаПолучателя", "ИНН", "КПП", "Корреспондент", "СчетНомер", "Банк", "БИК", "КоррСчет");
	    ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(ЛицевойСчет, РеквизитыЛицевогоСчета, РасчетныеРеквизиты);
		
		ТекстБанка = "";
		НомерСчета = "";
		ТекстБанка = РасчетныеРеквизиты.НаименованиеБанкаПолучателя;
		Если НЕ ЗначениеЗаполнено(РеквизитыЛицевогоСчета) Тогда
			РасчетныеРеквизиты.НомерСчетаПолучателя = СокрЛП(ЛицевойСчет.Код);
			Если ТипЗнч(ЛицевойСчет) = Тип("СправочникСсылка.БанковскиеИКазначейскиеСчета") Тогда
				КассовыйОрган = ЛицевойСчет.КассовыйОрган;
				Если ТипЗнч(КассовыйОрган) = Тип("СправочникСсылка.Банки") Тогда
					ТекстБанка = ЛицевойСчет.КассовыйОрган.Наименование;
					РасчетныеРеквизиты.БикБанкаПолучателя = СокрЛП(ЛицевойСчет.КассовыйОрган.Код);
					НомерСчета = СокрЛП(РасчетныеРеквизиты.НомерСчетаПолучателя);
				ИначеЕсли ТипЗнч(КассовыйОрган) = Тип("СправочникСсылка.Казначейства") Тогда
					СчетКазначейства = ЛицевойСчет.СчетКазначейства;
					КассовыйОрган = СчетКазначейства.КассовыйОрган;
					
					Если ТипЗнч(КассовыйОрган) = Тип("СправочникСсылка.Банки") Тогда
						ТекстБанка =КассовыйОрган.Наименование + " " + КассовыйОрган.Город + ", Казначейство: " +
							ЛицевойСчет.КассовыйОрган.Наименование + " ("+ЛицевойСчет.Владелец.НаименованиеСокращенное+", л/с "+ СокрЛП(ЛицевойСчет.Код)+")";
					Иначе
						ТекстБанка =КассовыйОрган.Наименование + " " + ", Казначейство: " +
							ЛицевойСчет.КассовыйОрган.Наименование + " ("+ЛицевойСчет.Владелец.НаименованиеСокращенное+", л/с "+ СокрЛП(ЛицевойСчет.Код)+")";
					КонецЕсли;
					РасчетныеРеквизиты.БикБанкаПолучателя = ЛицевойСчет.СчетКазначейства.КассовыйОрган.Код;
					НомерСчета = СокрЛП(ЛицевойСчет.СчетКазначейства.Код);
				КонецЕсли;
			КонецЕсли;
		Иначе
			ТекстБанка = РасчетныеРеквизиты.НаименованиеБанкаПолучателя;
			РасчетныеРеквизиты.БикБанкаПолучателя = РасчетныеРеквизиты.БикБанкаПолучателя;
			НомерСчета = РасчетныеРеквизиты.НомерСчетаПолучателя;
		КонецЕсли;
		
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".БанковскийСчет.НомерСчета", НомерСчета);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".БанковскийСчет.НаимБанк", ТекстБанка);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".БанковскийСчет.БИК", РасчетныеРеквизиты.БикБанкаПолучателя);
	КонецЕсли;	
КонецПроцедуры	

