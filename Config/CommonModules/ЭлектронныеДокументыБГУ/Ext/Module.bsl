		               |ГДЕ
		               |	ПоступлениеМЗМатериалы.Ссылка = &Ссылка";
		
	ИначеЕсли ТипЗнч(ДокументПринятияКУчету) = Тип("ДокументСсылка.ПрочееОтражениеЭлектронногоДокументаВУчете") Тогда
		ТекстЗапроса = "ВЫБРАТЬ
		               |	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ПоступлениеМЗМатериалы.НФА) КАК ИдентификаторОбъектаНФА,
		               |	"""" КАК ИдентификаторИнвНомер,
		               |	ПРЕДСТАВЛЕНИЕ(ПоступлениеМЗМатериалы.СчетУчета) КАК СчетУчета,
		               |	ПРЕДСТАВЛЕНИЕ(ПоступлениеМЗМатериалы.КПС) КАК КПС,
		               |	ПРЕДСТАВЛЕНИЕ(ПоступлениеМЗМатериалы.КФО) КАК КФО,
		               |	ПоступлениеМЗМатериалы.ЕдИзмКод КАК ЕдИзмКод,
		               |	ПоступлениеМЗМатериалы.ЕдИзмНаим КАК ЕдИзмНаим
		               |ИЗ
		               |	Документ.ПрочееОтражениеЭлектронногоДокументаВУчете.СведенияОПринятыхОбъектахНФА КАК ПоступлениеМЗМатериалы
		               |ГДЕ
		               |	ПоступлениеМЗМатериалы.Ссылка = &Ссылка";
		
	ИначеЕсли ТипЗнч(ДокументПринятияКУчету) = Тип("ДокументСсылка.ПоступлениеОС") Тогда	
		ТекстЗапроса = "ВЫБРАТЬ
		               |	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ПоступлениеОСКапВложения.ВнеоборотныйАктив) КАК ИдентификаторОбъектаНФА,
		               |	"""" КАК ИдентификаторИнвНомер,
		               |	ПРЕДСТАВЛЕНИЕ(ПоступлениеОСКапВложения.СчетУчета) КАК СчетУчета,
		               |	ПРЕДСТАВЛЕНИЕ(ПоступлениеОСКапВложения.КПС) КАК КПС,
		               |	ПРЕДСТАВЛЕНИЕ(ПоступлениеОСКапВложения.КФО) КАК КФО,
    	               |	"""" КАК ЕдИзмКод,
    	               |	"""" КАК ЕдИзмНаим
		               |ИЗ
		               |	Документ.ПоступлениеОС.КапВложения КАК ПоступлениеОСКапВложения
		               |ГДЕ
		               |	ПоступлениеОСКапВложения.Ссылка = &Ссылка";
	ИначеЕсли ТипЗнч(ДокументПринятияКУчету) = Тип("ДокументСсылка.ПоступлениеОСИК") Тогда
