Функция ПользователиПоСотруднику(Сотрудник) Экспорт
	Результат = Новый Массив;
	
	ДанныеСотрудника = ОбщегоНазначенияБГУ.ПолучитьЗначенияРеквизитов(Сотрудник, "Контрагент");
	Контрагент = ДанныеСотрудника.Контрагент;
	Если ЗначениеЗаполнено(Контрагент) Тогда
		ДанныеКонтрагента = ОбщегоНазначенияБГУ.ПолучитьЗначенияРеквизитов(Контрагент, "ЮридическоеФизическоеЛицо");
		ФизЛицо = ДанныеКонтрагента.ЮридическоеФизическоеЛицо;
		
		Если ЗначениеЗаполнено(ФизЛицо) Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	Пользователи.Ссылка КАК Ссылка
			               |ИЗ
			               |	Справочник.Пользователи КАК Пользователи
			               |ГДЕ
			               |	Пользователи.ФизическоеЛицо = &ФизическоеЛицо";
			Запрос.УстановитьПараметр("ФизическоеЛицо", ФизЛицо);
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				Результат.Добавить(Выборка.Ссылка);
			КонецЦикла;	
		КонецЕсли;
	КонецЕсли;

	Возврат Результат;
КонецФункции	

Функция НаличиеПодписиСотрудникаДляВнутреннегоДокументаАктаПриемаПередачи0510448(ДокументУчета, Сотрудник) Экспорт
	Результат = Ложь;
	
	ПользователиПоСотруднику = ПользователиПоСотруднику(Сотрудник);

	ВнутреннийЭД = ЭлектронныеДокументыБГУ.ВнутреннийЭДАктПриемаПередачи0510448(ДокументУчета);
	Если ЗначениеЗаполнено(ВнутреннийЭД) Тогда
		ЭлектронныеПодписиДляШтампа = ВнутреннийЭДО.УстановленныеПодписи(ВнутреннийЭД.ОсновнойФайл);
		Для Каждого ТекПользователь Из ПользователиПоСотруднику Цикл
			РезультатДляПользователя = НаличиеПодписиПользователяДляВнутреннегоДокумента(ЭлектронныеПодписиДляШтампа, ТекПользователь);	
			Если РезультатДляПользователя Тогда
				Результат = Истина;
				Прервать;
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

Функция НаличиеПодписиПользователяДляВнутреннегоДокумента(ЭлектронныеПодписиДляШтампа, Пользователь) Экспорт

	Результат = Ложь;
	
	ПользователиУстановившиеПодпись = Новый ТаблицаЗначений;
	ПользователиУстановившиеПодпись.Колонки.Добавить("УстановившийПодпись", Новый ОписаниеТипов("СправочникСсылка.Пользователи"));
	Для Каждого ТекСтрока Из ЭлектронныеПодписиДляШтампа Цикл
		НоваяСтрока = ПользователиУстановившиеПодпись.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
	КонецЦикла;	
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("УстановившийПодпись", Пользователь);
	НайденныеСтроки = ПользователиУстановившиеПодпись.НайтиСтроки(ПараметрыОтбора);
	Если НайденныеСтроки.Количество() > 0 Тогда
		Результат = Истина;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

Функция ЕстьПодписьСотрудникаДляВнутреннегоЭД(ДокументУчета, ИдентификаторПечатнойФормы, Сотрудник) Экспорт
	Результат = Ложь;
	
	ИспользуетсяПОД = ИспользуетсяПОД();
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ИспользуетсяПОД Тогда
		МодульПроцессыОбработкиДокументовПереопределяемый = ОбщегоНазначения.ОбщийМодуль("ПроцессыОбработкиДокументовПереопределяемый");
		Результат = МодульПроцессыОбработкиДокументовПереопределяемый.НаличиеПодписиСотрудникаДляМакетаПечатнойФормыДокумента(ДокументУчета, ИдентификаторПечатнойФормы, Сотрудник);
	Иначе	
		//ПРОФ
		ИспользоватьВнутреннийЭДО = Константы.ИспользоватьВнутренниеДокументыЭДО.Получить();

		Если ИспользоватьВнутреннийЭДО Тогда
			ВнутреннийЭД = Документы.ВнутреннийЭлектронныйДокумент.ПустаяСсылка();
		    Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	ВнутреннийЭлектронныйДокумент.Ссылка КАК Ссылка,
			               |	ВнутреннийЭлектронныйДокумент.ВидДокумента КАК ВидДокумента,
			               |	ВнутреннийЭлектронныйДокумент.ДатаДокумента КАК ДатаДокумента,
			               |	ВнутреннийЭлектронныйДокумент.НомерДокумента КАК НомерДокумента,
			               |	ВнутреннийЭлектронныйДокумент.ИдентификаторКомандыПечати КАК ИдентификаторКомандыПечати
			               |ИЗ
			               |	Документ.ВнутреннийЭлектронныйДокумент КАК ВнутреннийЭлектронныйДокумент
			               |ГДЕ
			               |	ВнутреннийЭлектронныйДокумент.УчетныйДокумент = &ДокументУчета
			               |	И ВнутреннийЭлектронныйДокумент.ПометкаУдаления = ЛОЖЬ";
			Запрос.УстановитьПараметр("ДокументУчета", ДокументУчета);
			Выборка = Запрос.Выполнить().Выбрать();
			
			Пока Выборка.Следующий() Цикл
				Если СокрЛП(Выборка.ИдентификаторКомандыПечати) = СокрЛП(ИдентификаторПечатнойФормы) Тогда
						
					СостояниеЭлектронногоДокумента = ВнутреннийЭДО.СостояниеЭлектронногоДокумента(Выборка.Ссылка);
					
					Если СостояниеЭлектронногоДокумента.Состояние = Перечисления.СостоянияДокументовВнутреннегоЭДО.Завершен Тогда
						Результат = Истина;
						Прервать;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		Иначе
			Результат = Истина;
		КонецЕсли;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Результат;
КонецФункции

