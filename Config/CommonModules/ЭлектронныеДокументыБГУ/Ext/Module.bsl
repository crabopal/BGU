#Область ПрограммныйИнтерфейс

// См. ОбменСКонтрагентамиПереопределяемый.ПриОпределенииИспользуемыхТиповЭлектронныхДокументов.
Процедура ПриОпределенииИспользуемыхТиповЭлектронныхДокументов(АктуальныеТипы) Экспорт
	
	ТипыДокументов = ОбменСКонтрагентами.ТипыДокументов();

	// Для обмена по форматам ФНС.
	ОбменСКонтрагентами.ДобавитьИспользуемыйТипДокумента(АктуальныеТипы, ТипыДокументов.ТоварнаяНакладная);
	ОбменСКонтрагентами.ДобавитьИспользуемыйТипДокумента(АктуальныеТипы, ТипыДокументов.АктВыполненныхРабот);
	ОбменСКонтрагентами.ДобавитьИспользуемыйТипДокумента(АктуальныеТипы, ТипыДокументов.СчетФактура);
	ОбменСКонтрагентами.ДобавитьИспользуемыйТипДокумента(АктуальныеТипы, ТипыДокументов.КорректировочныйСчетФактура);
	ОбменСКонтрагентами.ДобавитьИспользуемыйТипДокумента(АктуальныеТипы, ТипыДокументов.АктНаПередачуПрав, Истина, Ложь);
	ОбменСКонтрагентами.ДобавитьИспользуемыйТипДокумента(АктуальныеТипы, ТипыДокументов.УПД);
	ОбменСКонтрагентами.ДобавитьИспользуемыйТипДокумента(АктуальныеТипы, ТипыДокументов.УКД);
	ОбменСКонтрагентами.ДобавитьИспользуемыйТипДокумента(АктуальныеТипы, ТипыДокументов.АктОРасхождениях);
	ОбменСКонтрагентами.ДобавитьИспользуемыйТипДокумента(АктуальныеТипы, ТипыДокументов.АктСверкиВзаиморасчетов);
	ОбменСКонтрагентами.ДобавитьИспользуемыйТипДокумента(АктуальныеТипы, ТипыДокументов.АктПриемкиСтроительныхРаботУслуг, Истина, Ложь);
	ОбменСКонтрагентами.ДобавитьИспользуемыйТипДокумента(АктуальныеТипы, ТипыДокументов.ДоговорныйДокумент);
	
	// Для обмена по форматам CML 2.
	ОбменСКонтрагентами.ДобавитьИспользуемыйТипДокумента(АктуальныеТипы, ТипыДокументов.ОтветНаЗаказ, Истина, Ложь);
	ОбменСКонтрагентами.ДобавитьИспользуемыйТипДокумента(АктуальныеТипы, ТипыДокументов.СчетНаОплату);
	ОбменСКонтрагентами.ДобавитьИспользуемыйТипДокумента(АктуальныеТипы, ТипыДокументов.СчетОферта);
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьПараметрыЭДПоИсточнику.
Процедура ЗаполнитьПараметрыЭДПоИсточнику(Источник, ПараметрыЭлектронногоДокумента) Экспорт
	
	ТипыДокументов        = ОбменСКонтрагентами.ТипыДокументов();
	НаправленияДокументов = ОбменСКонтрагентами.НаправленияДокументов();
	
	ТипИсточника = ТипЗнч(Источник);
	ЭтоСсылка = ОбщегоНазначения.ЭтоСсылка(ТипИсточника);
	
	Если ТипИсточника = Тип("ДокументСсылка.АктОбОказанииУслуг")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.АктОбОказанииУслуг")
		Или ТипИсточника = Тип("ДокументСсылка.ОтчетКомитенту")
		Или ТипИсточника = Тип("ДокументОбъект.ОтчетКомитенту") Тогда
		
		Реквизиты = "Организация, Контрагент, Договор";
		
		Если ЭтоСсылка Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, Реквизиты);
		Иначе
			ЗначенияРеквизитов = Новый Структура(Реквизиты);
			ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, Источник);
		КонецЕсли;
		
		Тип = ТипыДокументов.АктВыполненныхРабот;
		
		СтрокаПараметров = ПараметрыЭлектронногоДокумента.Добавить();
		
		СтрокаПараметров.Тип                = Тип;
		СтрокаПараметров.Направление        = НаправленияДокументов.Исходящий;
		СтрокаПараметров.Организация        = ЗначенияРеквизитов.Организация;
		СтрокаПараметров.Контрагент         = ЗначенияРеквизитов.Контрагент;
		СтрокаПараметров.ДоговорКонтрагента = ЗначенияРеквизитов.Договор;
		
		НастроитьСтатусФормируемогоУПДПриВыгрузкеВФайлУПД_5_03(СтрокаПараметров, ЗначенияРеквизитов.Организация, ЗначенияРеквизитов.Контрагент);
		
	ИначеЕсли ТипИсточника = Тип("ДокументСсылка.ПоступлениеУслугРабот")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.ПоступлениеУслугРабот") Тогда
		
		Реквизиты = "Организация, Контрагент, Договор";
		
		Если ЭтоСсылка Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, Реквизиты);
		Иначе
			ЗначенияРеквизитов = Новый Структура(Реквизиты);
			ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, Источник);
		КонецЕсли;
		
		Тип = ТипыДокументов.АктВыполненныхРабот;
		
		СтрокаПараметров = ПараметрыЭлектронногоДокумента.Добавить();
		
		СтрокаПараметров.Тип                = Тип;
		СтрокаПараметров.Направление        = НаправленияДокументов.Входящий;
		СтрокаПараметров.Организация        = ЗначенияРеквизитов.Организация;
		СтрокаПараметров.Контрагент         = ЗначенияРеквизитов.Контрагент;
		СтрокаПараметров.ДоговорКонтрагента = ЗначенияРеквизитов.Договор;
		
	ИначеЕсли ТипИсточника = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.НакладнаяНаРеализациюТорг12") 
		ИЛИ ТипИсточника = Тип("ДокументСсылка.НакладнаяНаОтпускМ15")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.НакладнаяНаОтпускМ15") 
		ИЛИ ТипИсточника = Тип("ДокументСсылка.ПередачаОбъектовОС")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.ПередачаОбъектовОС") 
		ИЛИ ТипИсточника = Тип("ДокументСсылка.ПередачаОбъектовИК")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.ПередачаОбъектовИК") Тогда
		
		Реквизиты = "Организация, Контрагент, Договор";
		
		Если ЭтоСсылка Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, Реквизиты);
		Иначе
			ЗначенияРеквизитов = Новый Структура(Реквизиты);
			ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, Источник);
		КонецЕсли;
		
		Тип = ТипыДокументов.ТоварнаяНакладная;
		
		СтрокаПараметров = ПараметрыЭлектронногоДокумента.Добавить();
		
		СтрокаПараметров.Тип                = Тип;
		СтрокаПараметров.Направление        = НаправленияДокументов.Исходящий;
		СтрокаПараметров.Организация        = ЗначенияРеквизитов.Организация;
		СтрокаПараметров.Контрагент         = ЗначенияРеквизитов.Контрагент;
		СтрокаПараметров.ДоговорКонтрагента = ЗначенияРеквизитов.Договор;
		
		НастроитьСтатусФормируемогоУПДПриВыгрузкеВФайлУПД_5_03(СтрокаПараметров, ЗначенияРеквизитов.Организация, ЗначенияРеквизитов.Контрагент);
		
	ИначеЕсли ТипИсточника = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.ЭлектронныйДокументПоставщика") Тогда
		
		Реквизиты = "Организация, Контрагент, Договор, ТипФорматаЭД";
		
		Если ЭтоСсылка Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, Реквизиты);
		Иначе
			ЗначенияРеквизитов = Новый Структура(Реквизиты);
			ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, Источник);
		КонецЕсли;
		
		Тип = ТипыДокументов.ТоварнаяНакладная;
		Если ЗначенияРеквизитов.ТипФорматаЭД = 6 Тогда
			Тип = ТипыДокументов.АктПриемкиСтроительныхРаботУслуг;
		КонецЕсли;	
		
		СтрокаПараметров = ПараметрыЭлектронногоДокумента.Добавить();
		
		СтрокаПараметров.Тип                = Тип;
		СтрокаПараметров.Направление        = НаправленияДокументов.Входящий;
		СтрокаПараметров.Организация        = ЗначенияРеквизитов.Организация;
		СтрокаПараметров.Контрагент         = ЗначенияРеквизитов.Контрагент;
		СтрокаПараметров.ДоговорКонтрагента = ЗначенияРеквизитов.Договор;
		
	ИначеЕсли ТипИсточника = Тип("ДокументСсылка.СчетФактураВыданный")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.СчетФактураВыданный") Тогда

		Реквизиты = "Организация, Контрагент, Договор";
		
		Если ЭтоСсылка Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, Реквизиты);
		Иначе
			ЗначенияРеквизитов = Новый Структура(Реквизиты);
			ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, Источник);
		КонецЕсли;
		
		Тип = ТипыДокументов.СчетФактура;
		
		СтрокаПараметров = ПараметрыЭлектронногоДокумента.Добавить();
		
		СтрокаПараметров.Тип                = Тип;
		СтрокаПараметров.Направление        = НаправленияДокументов.Исходящий;
		СтрокаПараметров.Организация        = ЗначенияРеквизитов.Организация;
		СтрокаПараметров.Контрагент         = ЗначенияРеквизитов.Контрагент;
		СтрокаПараметров.ДоговорКонтрагента = ЗначенияРеквизитов.Договор;
		
		НастроитьФормированиеУниверсальногоДокумента(СтрокаПараметров, Источник, ЭтоСсылка, ЗначенияРеквизитов);
		
	ИначеЕсли ТипИсточника = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.ИсправительныйСчетФактураВыданный") Тогда
		
		Реквизиты = "Организация, Контрагент, Договор, ИсправляемыйДокумент";
		
		Если ЭтоСсылка Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, Реквизиты);
			
			ИсправляемыйДокумент = ЗначенияРеквизитов.ИсправляемыйДокумент;
		Иначе
			ЗначенияРеквизитов = Новый Структура(Реквизиты);
			ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, Источник);
			
			Если ТипИсточника = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный") Тогда
				ИсправляемыйДокумент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Источник, "ИсправляемыйДокумент");
			Иначе	
				ИсправляемыйДокумент = Источник.ИсправляемыйДокумент;
			КонецЕсли;	
		КонецЕсли;
		
		Если ТипЗнч(ИсправляемыйДокумент) = Тип("ДокументСсылка.КорректировочныйСчетФактураВыданный") Тогда
			Тип = ТипыДокументов.КорректировочныйСчетФактура;
		Иначе	
			Тип = ТипыДокументов.СчетФактура;
		КонецЕсли;	
		
		СтрокаПараметров = ПараметрыЭлектронногоДокумента.Добавить();
		
		СтрокаПараметров.Тип                = Тип;
		СтрокаПараметров.Направление        = НаправленияДокументов.Исходящий;
		СтрокаПараметров.Организация        = ЗначенияРеквизитов.Организация;
		СтрокаПараметров.Контрагент         = ЗначенияРеквизитов.Контрагент;
		СтрокаПараметров.ДоговорКонтрагента = ЗначенияРеквизитов.Договор;
		
		НастроитьФормированиеУниверсальногоДокумента(СтрокаПараметров, Источник, ЭтоСсылка, ЗначенияРеквизитов);
		
	ИначеЕсли ТипИсточника = Тип("ДокументСсылка.СчетФактураПолученный")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.СчетФактураПолученный") Тогда

		Реквизиты = "Организация, Контрагент, Договор";
		
		Если ЭтоСсылка Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, Реквизиты);
		Иначе
			ЗначенияРеквизитов = Новый Структура(Реквизиты);
			ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, Источник);
		КонецЕсли;
		
		Тип = ТипыДокументов.СчетФактура;
		
		СтрокаПараметров = ПараметрыЭлектронногоДокумента.Добавить();
		
		СтрокаПараметров.Тип                = Тип;
		СтрокаПараметров.Направление        = НаправленияДокументов.Входящий;
		СтрокаПараметров.Организация        = ЗначенияРеквизитов.Организация;
		СтрокаПараметров.Контрагент         = ЗначенияРеквизитов.Контрагент;
		СтрокаПараметров.ДоговорКонтрагента = ЗначенияРеквизитов.Договор;
		
	ИначеЕсли ТипИсточника = Тип("ДокументСсылка.ИсправительныйСчетФактураПолученный")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.ИсправительныйСчетФактураПолученный") Тогда

		Реквизиты = "Организация, Контрагент, Договор";
		
		Если ЭтоСсылка Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, Реквизиты);
		Иначе
			ЗначенияРеквизитов = Новый Структура(Реквизиты);
			ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, Источник);
		КонецЕсли;
		
		Тип = ТипыДокументов.СчетФактура;
		
		СтрокаПараметров = ПараметрыЭлектронногоДокумента.Добавить();
		
		СтрокаПараметров.Тип                = Тип;
		СтрокаПараметров.Направление        = НаправленияДокументов.Входящий;
		СтрокаПараметров.Организация        = ЗначенияРеквизитов.Организация;
		СтрокаПараметров.Контрагент         = ЗначенияРеквизитов.Контрагент;
		СтрокаПараметров.ДоговорКонтрагента = ЗначенияРеквизитов.Договор;
		
	ИначеЕсли ТипИсточника = Тип("ДокументСсылка.СчетНаОплату")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.СчетНаОплату") Тогда


		Реквизиты = "Организация, Контрагент, Договор, ЭтоСчетОферта";
		
		Если ЭтоСсылка Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, Реквизиты);
		Иначе
			ЗначенияРеквизитов = Новый Структура(Реквизиты);
			ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, Источник);
		КонецЕсли;
		
		Тип = ТипыДокументов.СчетНаОплату;
		Если ЗначениеЗаполнено(ЗначенияРеквизитов.ЭтоСчетОферта) Тогда
			Если ЗначенияРеквизитов.ЭтоСчетОферта Тогда
				Тип = ТипыДокументов.СчетОферта;
			КонецЕсли;	
		КонецЕсли;	
		
		СтрокаПараметров = ПараметрыЭлектронногоДокумента.Добавить();
		
		СтрокаПараметров.Тип                = Тип;
		СтрокаПараметров.Направление        = НаправленияДокументов.Исходящий;
		СтрокаПараметров.Организация        = ЗначенияРеквизитов.Организация;
		СтрокаПараметров.Контрагент         = ЗначенияРеквизитов.Контрагент;
		СтрокаПараметров.ДоговорКонтрагента = ЗначенияРеквизитов.Договор;
		
	ИначеЕсли ТипИсточника = Тип("ДокументСсылка.СчетНаОплатуОтПоставщика")
		ИЛИ ТипИсточника = Тип("ДокументОбъект.СчетНаОплатуОтПоставщика") Тогда

		Реквизиты = "Организация, Контрагент, Договор";
		
		Если ЭтоСсылка Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Источник, Реквизиты);
		Иначе
			ЗначенияРеквизитов = Новый Структура(Реквизиты);
			ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, Источник);
		КонецЕсли;
		
		Если Источник.ТипФорматаЭД = 1 Тогда
			Тип = ТипыДокументов.ОтветНаЗаказ;
		Иначе	
			Тип = ТипыДокументов.СчетНаОплату;
		КонецЕсли;
		
