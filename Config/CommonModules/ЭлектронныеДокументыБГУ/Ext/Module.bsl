#Область Прослеживаемость

Процедура ЗаполнитьСведенияОПрослеживаемостиВСтрокеТоваровПоТорг12ПродавецУПД_2019(СтрокаТовара, Номенклатура, ДополнительныеПараметрыДокументаРеализации);
	
	ТаблицаНомеровПрослеживаемости	= ДополнительныеПараметрыДокументаРеализации.ТаблицаНомеровПрослеживаемости;
	КодыРНПТ						= ДополнительныеПараметрыДокументаРеализации.КодыРНПТ;
	ЕдиницыИзмеренияПрослеж			= ДополнительныеПараметрыДокументаРеализации.ЕдиницыИзмеренияПрослеж;
	
	Таблица = УчетНДС.ПолучитьПустуюТаблицуСведенияОПрослеживаемостиУПД();
	
	Поиск = Новый Структура("ИдентификаторСтроки", СтрокаТовара.ИдентификаторСтроки);
	
	МассивСтрокНомеровПрослеживаемости = ТаблицаНомеровПрослеживаемости.НайтиСтроки(Поиск);
	
	Поиск = Новый Структура("Номенклатура", Номенклатура);
	
	Для Каждого СтрокаТаблицы Из МассивСтрокНомеровПрослеживаемости Цикл
		КодРНПТ = КодыРНПТ.Получить(СтрокаТаблицы.РНПТ);
		
		Если Не ЗначениеЗаполнено(КодРНПТ) Тогда
			Продолжить;
		КонецЕсли;
		
		МассивСтрокЕдиницыИзмеренияПрослеж = ЕдиницыИзмеренияПрослеж.НайтиСтроки(Поиск);
		
		Если СтрокаТовара.Количество <> 0 Тогда
			ЦенаПрослеж = СтрокаТовара.СтоимостьТоваровБезНалога / СтрокаТовара.Количество;
		Иначе
			ЦенаПрослеж = СтрокаТовара.ЦенаЗаЕдиницуИзмерения;
		КонецЕсли;
		
		НоваяСтрока = Таблица.Добавить();
		НоваяСтрока.НомерСтроки		= Таблица.Количество();
		НоваяСтрока.НомерТовара		= СокрЛП(КодРНПТ);
		
		Если МассивСтрокЕдиницыИзмеренияПрослеж.Количество() > 0 Тогда
			СтрокаТаблицыЕдИзм = МассивСтрокЕдиницыИзмеренияПрослеж[0];
			
			НоваяСтрока.ЕдиницаИзмеренияКод				= СокрЛП(СтрокаТаблицыЕдИзм.ЕдиницаИзмеренияПрослежКод);
			НоваяСтрока.ЕдиницаИзмеренияНаименование	= СокрЛП(СтрокаТаблицыЕдИзм.ЕдиницаИзмеренияПрослежНаименование);
		КонецЕсли;
		
		НоваяСтрока.КоличествоУчетное	= СтрокаТаблицы.Количество;
		НоваяСтрока.Количество			= СтрокаТаблицы.КоличествоПрослеживаемости;
		НоваяСтрока.СтоимостьБезНДС		= Окр(ЦенаПрослеж * СтрокаТаблицы.КоличествоПрослеживаемости, 2);
	КонецЦикла;
	
	СтрокаТовара.СведенияОПрослеживаемости = Таблица;
	
КонецПроцедуры

Процедура ДобавитьКэшСведенийОПрослеживаемостиПоТорг12ПродавецУПД_2019(ДополнительныеПараметрыДокументаРеализации, ТабличнаяЧастьТоваров)
	
	ТаблицаНомеровПрослеживаемости = ДополнительныеПараметрыДокументаРеализации.ТаблицаНомеровПрослеживаемости;
	
	ВремТаблица = ТаблицаНомеровПрослеживаемости.Скопировать(, "РНПТ");
	ВремТаблица.Свернуть("РНПТ");
	МассивРНПТ = ВремТаблица.ВыгрузитьКолонку("РНПТ");
	
	ДополнительныеПараметрыДокументаРеализации.Вставить("КодыРНПТ", ОбщегоНазначения.ЗначениеРеквизитаОбъектов(МассивРНПТ, "Код"));
	
	ВремТаблица = ТабличнаяЧастьТоваров.Скопировать(, "Номенклатура");
	ВремТаблица.Свернуть("Номенклатура");
	МассивНоменклатуры = ВремТаблица.ВыгрузитьКолонку("Номенклатура");
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивНоменклатуры", МассивНоменклатуры);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ
	|	КодыТНВЭДНоменклатуры.Ссылка				КАК Номенклатура,
	|	КлассификаторЕдиницИзмерения.Ссылка			КАК ЕдиницаИзмеренияПрослеж,
	|	КлассификаторЕдиницИзмерения.Код			КАК ЕдиницаИзмеренияПрослежКод,
	|	КлассификаторЕдиницИзмерения.Наименование	КАК ЕдиницаИзмеренияПрослежНаименование
	|ИЗ
	|	(ВЫБРАТЬ
	|		Ссылка КАК Ссылка,
	|		КодТНВЭД КАК КодТНВЭД
	|	ИЗ
	|		Справочник.Номенклатура КАК Номенклатура
	|	ГДЕ
	|		Ссылка В (&МассивНоменклатуры)	
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		Ссылка,
	|		КодТНВЭД
	|	ИЗ
	|		Справочник.ОсновныеСредства
	|	ГДЕ
	|		Ссылка В (&МассивНоменклатуры)) КАК КодыТНВЭДНоменклатуры
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КлассификаторТНВЭД КАК КлассификаторТНВЭД
	|		ПО КодыТНВЭДНоменклатуры.КодТНВЭД = КлассификаторТНВЭД.Ссылка
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КлассификаторЕдиницИзмерения КАК КлассификаторЕдиницИзмерения
	|		ПО КлассификаторТНВЭД.ЕдиницаИзмерения = КлассификаторЕдиницИзмерения.Ссылка";
	
	ДополнительныеПараметрыДокументаРеализации.Вставить("ЕдиницыИзмеренияПрослеж", ЗапросПоиск.Выполнить().Выгрузить());
	
КонецПроцедуры

Процедура ЗаполнитьНомераПрослеживаемостиИзДереваЭлектронногоДокумента(ДокументОбъект, СтрокаТоваров, СтрокаТоваровДерева)
	
	ТаблицаДокумента = ДокументОбъект.СведенияПрослеживаемости;
	КодыУпаковок = СтрокаТоваровДерева.Строки.Найти(
		"СведенияОТоварах.НомерСтроки.СведенияОПрослеживаемости", "ПолныйПуть", Истина);
	Если КодыУпаковок <> Неопределено И ЗначениеЗаполнено(КодыУпаковок.Значение) Тогда
		Для Каждого СтрокаКодаУпаковки Из КодыУпаковок.Строки Цикл
			СтрокаТоваров.ПрослеживаемыйТовар = Истина;
			
			СтрокаНовойУпаковки = ТаблицаДокумента.Добавить();
			НомерУпаковки = СокрЛП(ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаКодаУпаковки,
				"СведенияОТоварах.НомерСтроки.СведенияОПрослеживаемости.НомерСтроки.НомерТовара"));
			СтрокаНовойУпаковки.ИдентификаторСтроки = СтрокаТоваров.ИдентификаторСтроки;
			
			НомерУпаковки = СокрЛП(ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаКодаУпаковки,
				"СведенияОТоварах.НомерСтроки.СведенияОПрослеживаемости.НомерСтроки.НомерТовара"));
			ЕдиницаИзмеренияКод = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаКодаУпаковки,
				"СведенияОТоварах.НомерСтроки.СведенияОПрослеживаемости.НомерСтроки.ЕдиницаИзмеренияКод");
			Количество = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаКодаУпаковки,
				"СведенияОТоварах.НомерСтроки.СведенияОПрослеживаемости.НомерСтроки.Количество");
			КоличествоУчетное = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаКодаУпаковки,
				"СведенияОТоварах.НомерСтроки.СведенияОПрослеживаемости.НомерСтроки.КоличествоУчетное");
			СтоимостьБезНДС = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаКодаУпаковки,
				"СведенияОТоварах.НомерСтроки.СведенияОПрослеживаемости.НомерСтроки.СтоимостьБезНДС");
				
			СтрокаНовойУпаковки.Количество = ?(КоличествоУчетное <> Неопределено, Число(КоличествоУчетное), Число(Количество));	
			СтрокаНовойУпаковки.КоличествоПрослеживаемости = Число(Количество);
			СтрокаНовойУпаковки.СуммаБезНДС = СтоимостьБезНДС;
			
			Если ЗначениеЗаполнено(НомерУпаковки) Тогда
				НайденнаяСсылка = Справочники.НомераГТД.НайтиПоКоду(НомерУпаковки);
				Если НайденнаяСсылка = Справочники.НомераГТД.ПустаяСсылка() Тогда
					НоваяСсылка = Справочники.НомераГТД.СоздатьЭлемент();
					НоваяСсылка.Код = НомерУпаковки;
					НоваяСсылка.Записать();
					
					НайденнаяСсылка = Справочники.НомераГТД.НайтиПоКоду(НомерУпаковки);
				КонецЕсли;
				СтрокаНовойУпаковки.РНПТ = НайденнаяСсылка;
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;	
	
КонецПроцедуры	

Процедура ЗаполнитьДопДанныеПрослеживаемостиВТаблицеНФА(ДокументОснование, ТаблицаНФА)
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ПередачаОбъектовОС") Тогда
		ТаблицаНФА.Колонки.Добавить("СтранаПроисхождения", Новый ОписаниеТипов("СправочникСсылка.СтраныМира"));
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	Таб.НФА КАК Номенклатура
		               |ПОМЕСТИТЬ ВТДанные
		               |ИЗ
		               |	&Данные КАК Таб
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ПередачаОбъектовОСОсновныеСредства.ОсновноеСредство КАК Номенклатура,
		               |	ПередачаОбъектовОСОсновныеСредства.СтранаПроисхождения КАК СтранаПроисхождения
		               |ПОМЕСТИТЬ НоменклатураОснования
		               |ИЗ
		               |	Документ.ПередачаОбъектовОС.ОсновныеСредства КАК ПередачаОбъектовОСОсновныеСредства
		               |ГДЕ
		               |	ПередачаОбъектовОСОсновныеСредства.Ссылка = &ДокументОснование
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ВТДанные.Номенклатура КАК Номенклатура,
		               |	НоменклатураОснования.СтранаПроисхождения КАК СтранаПроисхождения
		               |ИЗ
		               |	ВТДанные КАК ВТДанные
		               |		ЛЕВОЕ СОЕДИНЕНИЕ НоменклатураОснования КАК НоменклатураОснования
		               |		ПО ВТДанные.Номенклатура = НоменклатураОснования.Номенклатура";
		Запрос.УстановитьПараметр("Данные", ТаблицаНФА);
		Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
		ТаблицаСоответствия = Запрос.Выполнить().Выгрузить();
		
		Для Каждого ТекСтрока Из ТаблицаНФА Цикл
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("Номенклатура", ТекСтрока.НФА);
			
			НайденныеСтроки = ТаблицаСоответствия.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество()>0 Тогда
				ТекСтрока.СтранаПроисхождения = НайденныеСтроки[0].СтранаПроисхождения;	
			КонецЕсли;
		КонецЦикла;	
		
	ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12") Тогда
		ТаблицаНФА.Колонки.Добавить("СтранаПроисхождения", Новый ОписаниеТипов("СправочникСсылка.СтраныМира"));
		
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	Таб.НФА КАК Номенклатура
		               |ПОМЕСТИТЬ ВТДанные
		               |ИЗ
		               |	&Данные КАК Таб
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	НакладнаяНаРеализациюТорг12Номенклатура.Номенклатура КАК Номенклатура,
		               |	НакладнаяНаРеализациюТорг12Номенклатура.СтранаПроисхождения КАК СтранаПроисхождения
		               |ПОМЕСТИТЬ НоменклатураОснования
		               |ИЗ
		               |	Документ.НакладнаяНаРеализациюТорг12.Номенклатура КАК НакладнаяНаРеализациюТорг12Номенклатура
		               |ГДЕ
		               |	НакладнаяНаРеализациюТорг12Номенклатура.Ссылка = &ДокументОснование
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ВТДанные.Номенклатура КАК Номенклатура,
		               |	НоменклатураОснования.СтранаПроисхождения КАК СтранаПроисхождения
		               |ИЗ
		               |	ВТДанные КАК ВТДанные
		               |		ЛЕВОЕ СОЕДИНЕНИЕ НоменклатураОснования КАК НоменклатураОснования
		               |		ПО ВТДанные.Номенклатура = НоменклатураОснования.Номенклатура";
		Запрос.УстановитьПараметр("Данные", ТаблицаНФА);
		Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
		ТаблицаСоответствия = Запрос.Выполнить().Выгрузить();
		
		Для Каждого ТекСтрока Из ТаблицаНФА Цикл
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("Номенклатура", ТекСтрока.НФА);
			
			НайденныеСтроки = ТаблицаСоответствия.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество()>0 Тогда
				ТекСтрока.СтранаПроисхождения = НайденныеСтроки[0].СтранаПроисхождения;	
			КонецЕсли;
		КонецЦикла;	
		
	ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.НакладнаяНаОтпускМ15") Тогда
		ТаблицаНФА.Колонки.Добавить("СтранаПроисхождения", Новый ОписаниеТипов("СправочникСсылка.СтраныМира"));
		
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	Таб.НФА КАК Номенклатура
		               |ПОМЕСТИТЬ ВТДанные
		               |ИЗ
		               |	&Данные КАК Таб
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	НакладнаяНаОтпускМ15Материалы.Номенклатура КАК Номенклатура,
		               |	НакладнаяНаОтпускМ15Материалы.СтранаПроисхождения КАК СтранаПроисхождения
		               |ПОМЕСТИТЬ НоменклатураОснования
		               |ИЗ
		               |	Документ.НакладнаяНаОтпускМ15.Материалы КАК НакладнаяНаОтпускМ15Материалы
		               |ГДЕ
		               |	НакладнаяНаОтпускМ15Материалы.Ссылка = &ДокументОснование
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ВТДанные.Номенклатура КАК Номенклатура,
		               |	НоменклатураОснования.СтранаПроисхождения КАК СтранаПроисхождения
		               |ИЗ
		               |	ВТДанные КАК ВТДанные
		               |		ЛЕВОЕ СОЕДИНЕНИЕ НоменклатураОснования КАК НоменклатураОснования
		               |		ПО ВТДанные.Номенклатура = НоменклатураОснования.Номенклатура";
		Запрос.УстановитьПараметр("Данные", ТаблицаНФА);
		Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
		ТаблицаСоответствия = Запрос.Выполнить().Выгрузить();
		
		Для Каждого ТекСтрока Из ТаблицаНФА Цикл
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("Номенклатура", ТекСтрока.НФА);
			
			НайденныеСтроки = ТаблицаСоответствия.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество()>0 Тогда
				ТекСтрока.СтранаПроисхождения = НайденныеСтроки[0].СтранаПроисхождения;	
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;	
КонецПроцедуры	

#КонецОбласти

#Область ОбменСЛКЗаказчикаЕИС

Функция ЭлектронныйДокументИзЕИС(ДеревоДанных)
	Результат = Ложь;
	
	ДокументЕИС = ДеревоЭлектронногоДокументаБЭД.ЗначениеРеквизитаВДереве(ДеревоДанных,
					"ДанныеЭлектронногоАктированияЕИС");
	Если НЕ ДокументЕИС = Неопределено Тогда
		Если ДокументЕИС Тогда
			Результат = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция АктОПриемкеВыполненныхРаботИзЕИС(ДеревоДанных)
	Результат = Ложь;
	
	СведенияОТоварахЕИС = ДеревоЭлектронногоДокументаБЭД.ЗначениеРеквизитаВДереве(ДеревоДанных,"ДанныеЭлектронногоАктированияЕИС.ДанныеПриложения").СведенияОТоварах;
	Если ТипЗнч(СведенияОТоварахЕИС) = Тип("Структура") Тогда
		ОтраслеваяСпециализация = СведенияОТоварахЕИС.ОтраслеваяСпециализация;
		Если ОтраслеваяСпециализация = Неопределено Тогда
			Результат = Ложь;
		Иначе
			Если ОтраслеваяСпециализация = "1" Тогда
				Результат = Истина;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Процедура ЗаполнитьПоЭДДокументаПриемкиЕИС(СсылкаНаДокумент, ДокументОснование) Экспорт
	Если НЕ ЗначениеЗаполнено(ДокументОснование) Тогда
		Возврат;
	КонецЕсли;	
	
	СсылкаНаДокумент.РасхожденияДляОбъектовЗакупки.Очистить();
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	АктПриемкиВходящийЕИСТРУОбъектовЗакупки.НомерСтроки КАК НомерСтроки,
	               |	АктПриемкиВходящийЕИСТРУОбъектовЗакупки.Идентификатор КАК Идентификатор,
	               |	АктПриемкиВходящийЕИСТРУОбъектовЗакупки.ВнешнийИдентификатор КАК ВнешнийИдентификатор,
	               |	АктПриемкиВходящийЕИСТРУОбъектовЗакупки.ВнутреннийИдентификаторЕИС КАК ВнутреннийИдентификаторЕИС,
	               |	АктПриемкиВходящийЕИСТРУОбъектовЗакупки.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	АктПриемкиВходящийЕИСТРУОбъектовЗакупки.ЕдиницаИзмеренияНаименование КАК ЕдиницаИзмеренияНаименование,
	               |	АктПриемкиВходящийЕИСТРУОбъектовЗакупки.КодТовараДляЕИС КАК КодТовараДляЕИС,
	               |	АктПриемкиВходящийЕИСТРУОбъектовЗакупки.Наименование КАК Наименование,
	               |	АктПриемкиВходящийЕИСТРУОбъектовЗакупки.Количество КАК Количество,
	               |	АктПриемкиВходящийЕИСТРУОбъектовЗакупки.Всего КАК Всего,
	               |	АктПриемкиВходящийЕИСТРУОбъектовЗакупки.ОбъемРаботыУслуги КАК ОбъемРаботыУслуги
	               |ИЗ
	               |	Документ.АктПриемкиВходящийЕИС.ТРУОбъектовЗакупки КАК АктПриемкиВходящийЕИСТРУОбъектовЗакупки
	               |ГДЕ
	               |	АктПриемкиВходящийЕИСТРУОбъектовЗакупки.Ссылка = &ДокументОПриемке";
	Запрос.УстановитьПараметр("ДокументОПриемке", ДокументОснование);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		НоваяСтрока = СсылкаНаДокумент.РасхожденияДляОбъектовЗакупки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.ПризнакПринятияТРУ = Истина;
	КонецЕсли;	
	
	РезультатЭДО = ОбменСКонтрагентами.СтатусДокументооборота(ДокументОснование);
	Организация = СсылкаНаДокумент.Организация;
	Контрагент = СсылкаНаДокумент.Контрагент;
	
	Если ДокументОснование.ЭтоКорректировка Тогда
		СсылкаНаДокумент.ДатаСогласования = ДокументОснование.Дата;
	КонецЕсли;	
	
	Если ТипЗнч(РезультатЭДО) = Тип("Структура") Тогда
		ЭД = РезультатЭДО.ЭлектронныйДокумент;
		Если ЗначениеЗаполнено(ЭД) Тогда
			
			ДанныеЭД = ОбменСКонтрагентами.ДанныеЭлектронногоДокумента(ЭД);
			
			Если ТипЗнч(ДанныеЭД.ДанныеОтправителя.Содержание) = Тип("ДеревоЗначений") Тогда
				ДеревоДанных = ДанныеЭД.ДанныеОтправителя.Содержание;
				ФункцияЭД = ЗначениеРеквизитаВДереве(ДеревоДанных, "Функция");
				НаименованиеДокументаОтправителя = ЗначениеРеквизитаВДереве(ДеревоДанных, "НаименованиеДокументаОтправителя");
				Договор = Справочники.Договоры.ПустаяСсылка();
				СуммаДокумента = 0;
				Если ФункцияЭД = "СЧФДОП" Тогда
					СсылкаНаДокумент.ЭтоКорректировка = Ложь;
					СуммаДокумента = ЗначениеРеквизитаВДереве(ДеревоДанных, "ВсегоКОплате.ВсегоСтоимостьТоваровСНалогом");
					
					ОснованияОтгрузки = ДеревоДанных.Строки.Найти("ОснованиеОтгрузкиТоваров", "ПолныйПуть");
					ДоговорНайден = Ложь;
					Если Не ОснованияОтгрузки = Неопределено Тогда
						Для Каждого СтрокаОснованиеОтгрузки Из ОснованияОтгрузки.Строки Цикл
							ДоговорНомер = ЗначениеРеквизитаВДереве(СтрокаОснованиеОтгрузки, "ОснованиеОтгрузкиТоваров.НомерСтроки.ДокументНомер");
							Если ЗначениеЗаполнено(ДоговорНомер) Тогда
								ДоговорНайден = Истина;
								
								ДоговорДата = ДатаИзСтроки(ЗначениеРеквизитаВДереве(СтрокаОснованиеОтгрузки, 
									"ОснованиеОтгрузкиТоваров.НомерСтроки.ДокументДата"));
								
								СвойстваДоговора = Новый Структура("НомерДоговора, ДатаДоговора, Владелец, Организация", ДоговорНомер, ДоговорДата, Контрагент, Организация);
								
								НайтиСсылкуНаОбъект("ДоговорыКонтрагентов", Договор, , СвойстваДоговора);
							КонецЕсли;
							Если ДоговорНайден Тогда
								Прервать;
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;
					
				ИначеЕсли ФункцияЭД = "КСЧФДИС" Тогда
					СсылкаНаДокумент.ЭтоКорректировка = Истина;
					СуммаДокументаУвеличение = ЗначениеРеквизитаВДереве(ДеревоДанных, "ВсегоИзмененияСтоимости.ВсегоСтоимостьТоваровСНалогомУвеличение");
					СуммаДокументаУменьшение = ЗначениеРеквизитаВДереве(ДеревоДанных, "ВсегоИзмененияСтоимости.ВсегоСтоимостьТоваровСНалогомУменьшение");
					Если СуммаДокументаУвеличение = 0 Тогда
						СуммаДокумента = (-1)*СуммаДокументаУменьшение;
					Иначе
						СуммаДокумента = СуммаДокументаУвеличение;
					КонецЕсли;	
					
					ОснованияОтгрузки = ДеревоДанных.Строки.Найти("ОснованиеКорректировки", "ПолныйПуть");
					Если Не ОснованияОтгрузки = Неопределено Тогда
						Для Каждого СтрокаОснованиеОтгрузки Из ОснованияОтгрузки.Строки Цикл
							ДоговорНомер = ЗначениеРеквизитаВДереве(СтрокаОснованиеОтгрузки, "ОснованиеКорректировки.НомерСтроки.ДокументНомер");
							Если ЗначениеЗаполнено(ДоговорНомер) Тогда
								
								ДоговорДата = ДатаИзСтроки(ЗначениеРеквизитаВДереве(СтрокаОснованиеОтгрузки, 
									"ОснованиеКорректировки.НомерСтроки.ДокументДата"));
								
								СвойстваДоговора = Новый Структура("НомерДоговора, ДатаДоговора, Владелец, Организация", ДоговорНомер, ДоговорДата, Контрагент, Организация);
								
								НайтиСсылкуНаОбъект("ДоговорыКонтрагентов", Договор, , СвойстваДоговора);
							КонецЕсли;
							Прервать;
						КонецЦикла;
					КонецЕсли;
					
					ИсходныеДокументыКорректировки = ДеревоДанных.Строки.Найти("ИсходныеДокументы", "ПолныйПуть");
					Если Не ИсходныеДокументыКорректировки = Неопределено Тогда
						СсылкаНаДокумент.ИсходныеДокументы.Очистить();
						Для Каждого СтрокаИсходныйДокумент Из ИсходныеДокументыКорректировки.Строки Цикл
							ИсходныйДокументНомер = ЗначениеРеквизитаВДереве(СтрокаИсходныйДокумент, "ИсходныеДокументы.НомерСтроки.НомерИсходногоДокумента");
							ИсходныйДокументДата = ЗначениеРеквизитаВДереве(СтрокаИсходныйДокумент, "ИсходныеДокументы.НомерСтроки.ДатаИсходногоДокумента");
							
							НоваяСтрока = СсылкаНаДокумент.ИсходныеДокументы.Добавить();
							НоваяСтрока.НомерИсходногоДокумента = ИсходныйДокументНомер;
							НоваяСтрока.ДатаИсходногоДокумента = ИсходныйДокументДата;
						КонецЦикла;
					КонецЕсли;
				КонецЕсли;
				
				СсылкаНаДокумент.НаименованиеДокументаОтправителя = НаименованиеДокументаОтправителя;
				СсылкаНаДокумент.Договор = Договор;
				СсылкаНаДокумент.СуммаДокумента = СуммаДокумента;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры

Функция ДатаПоследнейЭлектроннойПодписиЭД(ДокументУчета) Экспорт
	Результат = Дата(1,1,1);
	
	ЭлектронныйДокумент = ЭлектронныйДокументБЭДПоДокументуУчета(ДокументУчета);
	
	Если ЗначениеЗаполнено(ЭлектронныйДокумент) Тогда
		СведенияЭД = СведенияОбЭлектронномДокументе(ЭлектронныйДокумент);
		
		Если ЗначениеЗаполнено(СведенияЭД) Тогда
			ДатаПодписи = Дата(1,1,1);
			Если СведенияЭД.Подписи.Количество() = 1 Тогда
				Возврат Результат;
			КонецЕсли;	
			Для Каждого ТекСтрока Из СведенияЭД.Подписи Цикл
				Если ЗначениеЗаполнено(ДатаПодписи) Тогда
					Если ТекСтрока.ДатаПодписи > ДатаПодписи Тогда
						Результат = ТекСтрока.ДатаПодписи;
					Иначе
						Результат = ДатаПодписи;
					КонецЕсли;
				Иначе
					ДатаПодписи = ТекСтрока.ДатаПодписи; 
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;	
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция ДатаОтгрузкиДокументаПоУПД(ДокументУчета) Экспорт
	
	ДатаОтгрузки = Дата(1,1,1);
	
	ЭлектронныйДокумент = ЭлектронныйДокументБЭДПоДокументуУчета(ДокументУчета);
	Если НЕ ЗначениеЗаполнено(ЭлектронныйДокумент) Тогда
		Возврат ДатаОтгрузки;
	КонецЕсли;
	
	ДанныеВходящегоЭД = ОбменСКонтрагентами.ДанныеЭлектронногоДокумента(ЭлектронныйДокумент);
	
	Если ЗначениеЗаполнено(ДанныеВходящегоЭД.ДанныеОтправителя) И ТипЗнч(ДанныеВходящегоЭД.ДанныеОтправителя.Содержание) = Тип("ДеревоЗначений") 
		И ЭлектронныйДокумент.ВидДокумента.ТипДокумента = Перечисления.ТипыДокументовЭДО.УПД Тогда
			ДеревоДанных = ДанныеВходящегоЭД.ДанныеОтправителя.Содержание;
			ДанныеЭД = ДанныеВходящегоЭД(ДеревоДанных); 
			
			Если ДанныеЭД.Свойство("СведенияОПередаче") Тогда
				СведенияОПередачеЭД = ДанныеЭД.СведенияОПередаче;
				Если СведенияОПередачеЭД.Свойство("Операция") 
					И СведенияОПередачеЭД.Операция.Свойство("ДатаОтгрузки") Тогда
					ДатаОтгрузки = СведенияОПередачеЭД.Операция.ДатаОтгрузки; 
				КонецЕсли;
			КонецЕсли;	
	КонецЕсли;
	
	Возврат ДатаОтгрузки;
	
КонецФункции

#КонецОбласти

Функция Штуки() Экспорт
	
	Возврат Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду(796);
	
КонецФункции

#Область МЧД

// Получает данные о физическом лице по ссылке.
//
// Параметры:
//  ФизЛицо - СправочникСсылка - ссылка на элемент справочника, по которому получаются данные.
//  Сведения - см. ЭлектронноеВзаимодействие.СтруктураДанныхФизЛица
//
Процедура ПолучитьДанныеФизЛица(ФизЛицо, Сведения) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ФизЛицо) Тогда
		Возврат
	КонецЕсли;
	
	Сведения.Ссылка = ФизЛицо;
	
	Реквизиты = "ДатаРождения, ИНН, СтраховойНомерПФР, Наименование, Пол, МестоРождения";
	
	СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ФизЛицо, Реквизиты);
	
	СтруктураФИО = ФизическиеЛицаКлиентСервер.ЧастиИмени(СтруктураДанных.Наименование);
	
	Сведения.ФИО		= СтруктураДанных.Наименование;
	Сведения.Фамилия  	= СтруктураФИО.Фамилия;
	Сведения.Имя 		= СтруктураФИО.Имя;		
	Сведения.Отчество 	= СтруктураФИО.Отчество;
	
	Сведения.Гражданство = Справочники.ФизическиеЛица.ГражданствоФизЛица(ФизЛицо);
	
	СтруктураДанных.Свойство("ДатаРождения", Сведения.ДатаРождения);
	СтруктураДанных.Свойство("ИНН", Сведения.ИНН);
	СтруктураДанных.Свойство("СтраховойНомерПФР", Сведения.СтраховойНомерПФР);
	СтруктураДанных.Свойство("Пол", Сведения.Пол);
	СтруктураДанных.Свойство("МестоРождения", Сведения.МестоРождения);
	
КонецПроцедуры

// Получает ссылку на физическое лицо по сведениям.
// 
// Параметры:
//  СведенияФизЛица - структура:
//  	* ИНН - строка
// 
// Возвращаемое значение:
//  - СправочникСсылка.ФизическиеЛица
//  - Неопределено - если не элемент не найден в ИБ.
//
Функция ПолучитьФизЛицоМЧД(СведенияФизЛица) Экспорт
	
	Если  НЕ ЗначениеЗаполнено(СведенияФизЛица.ИНН) Тогда
		Возврат Неопределено;
	КонецЕсли;	
	
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ФизическиеЛица.Ссылка
	|ИЗ
	|	Справочник.ФизическиеЛица КАК ФизическиеЛица
	|ГДЕ
	|	ФизическиеЛица.ИНН = &ИНН";

	Запрос.УстановитьПараметр("ИНН", СведенияФизЛица.ИНН);

	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;	
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

// Получает удостоверения личности физического лица.
// 
// Параметры:
//  ФизЛицо - СправочникСсылка.ФизическиеЛица - ссылка на элемент справочника, по которому получаются данные.
//  Сведения - Структура:
//		* ВидДокумнта 		- СправочникСсылка.ВидыДокументовФизическихЛиц	 
//		* Серия 			- строка
//		* Номер 			- строка
//		* ДатаВыдачи		- дата
//		* КемВыдан			- строка
//		* КодПодразделения	- строка
//
Функция ПолучитьДокументыФизЛица(ФизЛицо, Сведения) Экспорт
	
	МенеджерЗаписи = РегистрыСведений.ДокументыФизическихЛиц.СоздатьМенеджерЗаписи();
	
	// Ищем последнюю запись
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	РегистрСведений.Период,
	|	РегистрСведений.Физлицо,
	|	РегистрСведений.ВидДокумента
	|ИЗ
	|	РегистрСведений.ДокументыФизическихЛиц КАК РегистрСведений
	|ГДЕ
	|	РегистрСведений.Физлицо = &ВедущийОбъект
	|	И РегистрСведений.ЯвляетсяДокументомУдостоверяющимЛичность
	|
	|УПОРЯДОЧИТЬ ПО
	|	РегистрСведений.Период УБЫВ";
	Запрос.УстановитьПараметр("ВедущийОбъект", ФизЛицо);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, Выборка);
		МенеджерЗаписи.Прочитать();
		
	КонецЕсли;
	
	Возврат МенеджерЗаписи;
	
КонецФункции

// Получить типы организации представителя МЧД.
// 
// Параметры:
//  Типы - массив
Процедура ПолучитьТипыОрганизацииПредставителяМЧД(Типы) Экспорт
	
	Типы.Добавить(Тип("СправочникСсылка.Контрагенты"));
	Типы.Добавить(Тип("СправочникСсылка.Организации"));
	
КонецПроцедуры

// Получить ссылку на организацию-представителя МЧД.
// 
// Параметры:
//  СведенияЮрЛица - структура:
// 		* ИНН 	- строка
// 		* КПП 	- строка
// 		* ОГРН 	- строка
// 
// Возвращаемое значение:
// 	СправочникСсылка - ссылка на элемент справочника, Неопределено
//  
Функция ПолучитьОрганизациюМЧД(СведенияЮрЛица) Экспорт
	
	Если  НЕ ЗначениеЗаполнено(СведенияЮрЛица.ИНН) Тогда
		Возврат Неопределено;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Организации.Ссылка КАК Организация,
	|	NULL КАК Контрагент
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.ИНН = &ИНН
	|	И Организации.КПП = &КПП
	|	И Организации.ОГРН = &ОГРН
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	NULL,
	|	Контрагенты.Ссылка КАК ССЫЛКА
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	Контрагенты.ИНН = &ИНН
	|	И Контрагенты.КПП = &КПП";

	Запрос.УстановитьПараметр("ИНН", 	СведенияЮрЛица.ИНН);
	Запрос.УстановитьПараметр("КПП", 	СведенияЮрЛица.КПП);
	Запрос.УстановитьПараметр("ОГРН", 	СведенияЮрЛица.ОГРН);

	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Если ЗначениеЗаполнено(Выборка.Контрагент) Тогда
			Возврат Выборка.Контрагент;	
		Иначе
			Возврат Выборка.Организация;	
		КонецЕсли;	
	КонецЕсли;

	Возврат Неопределено;
	
КонецФункции

// См. МашиночитаемыеДоверенностиПереопределяемый.ПриИзмененииДанныеФизЛица
Процедура ПриИзмененииДанныеФизЛица(ФизЛицо, Сведения) Экспорт
	
	ФИО = "";
	Фамилия = "";
	Имя = "";
	Отчество = "";
	
	ДатаСведений = ТекущаяДатаСеанса();
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ФИОФизическихЛицСрезПоследних.Фамилия,
	|	ФИОФизическихЛицСрезПоследних.Имя,
	|	ФИОФизическихЛицСрезПоследних.Отчество
	|ИЗ
	|	РегистрСведений.ФИОФизическихЛиц.СрезПоследних(&ДатаСведений, ФизическоеЛицо = &ФизлицоСсылка) КАК ФИОФизическихЛицСрезПоследних");
	
	Запрос.УстановитьПараметр("ДатаСведений", ДатаСведений);
	Запрос.УстановитьПараметр("ФизлицоСсылка", ФизЛицо);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Фамилия = Выборка.Фамилия;
		Имя = Выборка.Имя;
		Отчество = Выборка.Отчество;
		
		ФИО = Выборка.Фамилия + " " + Выборка.Имя + " " + Выборка.Отчество;
	КонецЕсли;
	
	Гражданство = Справочники.ФизическиеЛица.ГражданствоФизЛица(ФизЛицо, ДатаСведений);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ФизическиеЛица.ДатаРождения КАК ДатаРождения,
	|	ФизическиеЛица.ИНН КАК ИНН,
	|	ФизическиеЛица.МестоРождения КАК МестоРождения,
	|	ФизическиеЛица.Пол КАК Пол,
	|	ФизическиеЛица.СтраховойНомерПФР КАК СтраховойНомерПФР,
	|	ФизическиеЛица.Наименование КАК Наименование,
	|	&ФИО КАК ФИО,
	|	&Фамилия КАК Фамилия,
	|	&Имя КАК Имя,
	|	&Отчество КАК Отчество,
	|	&Гражданство КАК Гражданство
	|ИЗ
	|	Справочник.ФизическиеЛица КАК ФизическиеЛица
	|ГДЕ
	|	ФизическиеЛица.Ссылка = &Физлицо
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ДокументыФизическихЛиц.Серия КАК Серия,
	|	ДокументыФизическихЛиц.Номер КАК Номер,
	|	ДокументыФизическихЛиц.ДатаВыдачи КАК ДатаВыдачи,
	|	ДокументыФизическихЛиц.КемВыдан КАК КемВыдан,
	|	ДокументыФизическихЛиц.КодПодразделения КАК КодПодразделения,
	|	ВидыДокументовФизическихЛиц.КодФНС КАК КодФНС
	|ИЗ
	|	РегистрСведений.ДокументыФизическихЛиц КАК ДокументыФизическихЛиц
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыДокументовФизическихЛиц КАК ВидыДокументовФизическихЛиц
	|		ПО ДокументыФизическихЛиц.ВидДокумента = ВидыДокументовФизическихЛиц.Ссылка
	|ГДЕ
	|	ДокументыФизическихЛиц.Физлицо = &Физлицо
	|	И ДокументыФизическихЛиц.ЯвляетсяДокументомУдостоверяющимЛичность = ИСТИНА
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДокументыФизическихЛиц.Период УБЫВ";
	Запрос.УстановитьПараметр("ФизЛицо", ФизЛицо);
	Запрос.УстановитьПараметр("ФИО", ФИО);
	Запрос.УстановитьПараметр("Фамилия", Фамилия);
	Запрос.УстановитьПараметр("Имя", Имя);
	Запрос.УстановитьПараметр("Отчество", Отчество);
	Запрос.УстановитьПараметр("Гражданство", Гражданство);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ПервыйПакет = РезультатЗапроса[0].Выбрать();
	ВторойПакет = РезультатЗапроса[1].Выбрать();
	
	ПервыйПакет.Следующий();
	ВторойПакет.Следующий();
	
	ЗаполнитьЗначенияСвойств(Сведения, ПервыйПакет);
	ЗаполнитьЗначенияСвойств(Сведения, ВторойПакет);
	
КонецПроцедуры

