	               |	СписаниеОбъектовИКОсновныеСредства.ОсновноеСредство,
	               |	СписаниеОбъектовИКОсновныеСредства.Количество,
	               |	ВЫБОР
	               |		КОГДА СписаниеОбъектовИКОсновныеСредства.Количество = 0
	               |			ТОГДА СписаниеОбъектовИКОсновныеСредства.Сумма
	               |		ИНАЧЕ СписаниеОбъектовИКОсновныеСредства.Сумма / СписаниеОбъектовИКОсновныеСредства.Количество
	               |	КОНЕЦ,
	               |	СписаниеОбъектовИКОсновныеСредства.Сумма,
	               |	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка),
	               |	СписаниеОбъектовИКОсновныеСредства.Сумма,
	               |	0,
	               |	""1ЗУ"",
	               |	ЗНАЧЕНИЕ(Перечисление.КВД.Бюджет),
	               |	СписаниеОбъектовИКОсновныеСредства.СчетУчета,
	               |	СписаниеОбъектовИКОсновныеСредства.ИнвентарныйНомер,
	               |	СведенияКадастровогоУчетаСрезПоследних.КадастровыйНомер,
	               |	ИСТИНА
	               |ИЗ
	               |	Документ.СписаниеОбъектовИК.ОсновныеСредства КАК СписаниеОбъектовИКОсновныеСредства
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СведенияКадастровогоУчета.СрезПоследних КАК СведенияКадастровогоУчетаСрезПоследних
	               |		ПО СписаниеОбъектовИКОсновныеСредства.ОсновноеСредство = СведенияКадастровогоУчетаСрезПоследних.ОсновноеСредство
	               |			И СписаниеОбъектовИКОсновныеСредства.ИнвентарныйНомер = СведенияКадастровогоУчетаСрезПоследних.ИнвентарныйНомер
	               |ГДЕ
	               |	СписаниеОбъектовИКОсновныеСредства.Ссылка В(&ДокументыСписания)";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
КонецФункции

Функция ПолучитьДокументОснованиеАктаРасхождений(УникальныйИдентификатор, НайденноеИсходящееИзвещение)
	Результат = Неопределено;
	
	Если ЗначениеЗаполнено(НайденноеИсходящееИзвещение) Тогда
		Для каждого ТекДокПередачи Из НайденноеИсходящееИзвещение.ДокументыПередачи Цикл
			Если Строка(ТекДокПередачи.ДокументПередачи.УникальныйИдентификатор()) = УникальныйИдентификатор Тогда
				Результат = ТекДокПередачи.ДокументПередачи;
				Прервать;
			КонецЕсли;	
			
		КонецЦикла;	
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция ЭтоЧетноеЧисло(ПроверяемоеЧисло)
	Если ПроверяемоеЧисло = 0 Тогда
		Возврат Ложь;
	КонецЕсли;	
	
	Результат = ПроверяемоеЧисло%2=0;
	
	Возврат Результат;
КонецФункции	

// См. ОбменСКонтрагентамиПереопределяемый.ПолучитьЗапросКонструктораДополнительныхПолейШапки.
Процедура ПолучитьЗапросКонструктораДополнительныхПолейШапки(Параметры, ТекстЗапроса) Экспорт
	
	ТипыДокументов = ОбменСКонтрагентами.ТипыДокументов();
	
	Если (Параметры.ИспользоватьУПД И Параметры.ТипДокумента = ТипыДокументов.СчетФактура)
		ИЛИ Параметры.ТипДокумента = ТипыДокументов.УПД
		ИЛИ Параметры.ТипДокумента = ТипыДокументов.УКД
		ИЛИ (Параметры.ИспользоватьУКД И Параметры.ТипДокумента = ТипыДокументов.КорректировочныйСчетФактура) Тогда
		
		ТекстЗапроса = ЗапросКонструктораДополнительныхПолейШапкиУПД();
	
	ИначеЕсли Параметры.ТипДокумента = ТипыДокументов.СчетФактура
		ИЛИ Параметры.ТипДокумента = ТипыДокументов.КорректировочныйСчетФактура Тогда
		
		ТекстЗапроса = ЗапросКонструктораДополнительныхПолейШапкиСчетаФактуры();
		
	ИначеЕсли Параметры.ТипДокумента = ТипыДокументов.ТоварнаяНакладная
		ИЛИ Параметры.ТипДокумента = ТипыДокументов.АктВыполненныхРабот
		ИЛИ Параметры.ТипДокумента = ТипыДокументов.АктНаПередачуПрав
		ИЛИ Параметры.ТипДокумента = ТипыДокументов.СоглашениеОбИзмененииСтоимости Тогда
		
		ТекстЗапроса = ЗапросКонструктораДополнительныхПолейШапкиПервичногоДокумента();
		
	КонецЕсли;
	
КонецПроцедуры

