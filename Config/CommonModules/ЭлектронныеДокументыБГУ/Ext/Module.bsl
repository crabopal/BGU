						Если ЕстьСведенияОПрослеживаемости Тогда
							Для Каждого ТекСтрокаНом Из ДокументОбъектЭДП.СписокНоменклатуры Цикл
								ПараметрыОтбора = Новый Структура;
								ПараметрыОтбора.Вставить("ИдентификаторСтроки", ТекСтрокаНом.ИдентификаторСтроки);
								НайденныеСтроки = ДокументОбъектЭДП.СведенияПрослеживаемости.НайтиСтроки(ПараметрыОтбора);
								
								Если НайденныеСтроки.Количество()>0 Тогда
									ТекСтрокаНом.ПрослеживаемыйТовар = Истина;
								Иначе
									ТекСтрокаНом.ПрослеживаемыйТовар = Ложь;
								КонецЕсли;	
							КонецЦикла;	
						КонецЕсли;	
						
						ДокументОбъектЭДП.Записать(РежимЗаписи);
						
						СсылкаНаВладельца = ДокументОбъектЭДП.Ссылка;
					КонецЦикла;	
				КонецЕсли;
			Исключение
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Заполнение документов ""Электронный документ поставщика"" на основе ЭД. %1'"), Текст)
					+ Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ВыполнитьЗаписьСобытияПоЭДВЖурналРегистрации(ТекстСообщения,
					2, УровеньЖурналаРегистрации.Ошибка, ДокументОбъект.Метаданные(), СсылкаНаВладельца);
				ВызватьИсключение(Текст);
			КонецПопытки;
			
			//Заполнение списка НФА
			Если ЕстьНезаполненныеНФА Тогда
				Попытка
					Для каждого ТекСтрока Из ДокументОбъект.ОсновныеСредства Цикл
						Если НЕ ЗначениеЗаполнено(ТекСтрока.ОсновноеСредство) Тогда
							НоменклатураОтправителяЭД = НоменклатураОтправителяЭД(Отправитель, ТекСтрока.ИдентификаторПоставщика);
							ТекСтрока.ОсновноеСредство = НоменклатураОтправителяЭД;
						КонецЕсли;
					КонецЦикла;	
					Для каждого ТекСтрока Из ДокументОбъект.Материалы Цикл
						Если НЕ ЗначениеЗаполнено(ТекСтрока.Номенклатура) Тогда
							НоменклатураОтправителяЭД = НоменклатураОтправителяЭД(Отправитель, ТекСтрока.ИдентификаторПоставщика);
							ТекСтрока.Номенклатура = НоменклатураОтправителяЭД;
						КонецЕсли;
					КонецЦикла;	
					Для каждого ТекСтрока Из ДокументОбъект.ВозвратнаяТара Цикл
						Если НЕ ЗначениеЗаполнено(ТекСтрока.Номенклатура) Тогда
							НоменклатураОтправителяЭД = НоменклатураОтправителяЭД(Отправитель, ТекСтрока.ИдентификаторПоставщика);
							ТекСтрока.Номенклатура = НоменклатураОтправителяЭД;
						КонецЕсли;
					КонецЦикла;	
					
					ДокументОбъект.ДополнительныеСвойства.Вставить("ПроцессыОбработкиДокументов_ЗаписатьБезПроверкиОбменДаннымиЗагрузка", Истина);
					Если НЕ ЗначениеЗаполнено(ДокументОбъект.Номер) Тогда
						ДокументОбъект.УстановитьНовыйНомер();
					КонецЕсли;
					ДокументОбъект.Записать(РежимЗаписи);
					
					СсылкаНаВладельца = ДокументОбъект.Ссылка;
				Исключение
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'Заполнение номенклатуры извещения документа на основе ЭД. %1'"), Текст)
						+ Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
					ВыполнитьЗаписьСобытияПоЭДВЖурналРегистрации(ТекстСообщения,
						2, УровеньЖурналаРегистрации.Ошибка, ДокументОбъект.Метаданные(), СсылкаНаВладельца);
					ВызватьИсключение(Текст);
				КонецПопытки;
			КонецЕсли;
		#КонецОбласти
		КонецЕсли;
	
		Если (ТипИзвещения = 2) ИЛИ (ТипИзвещения = 4)  Тогда
		#Область СозданиеАктовОРасхождении
			Попытка
				Если ЗначениеЗаполнено(ДокументОбъект.Ссылка) Тогда
					Для Каждого СтрокаТаблицыXDTOАктОПриемке Из ДокументXDTO.АктыОрасхожденияхПриПриемке Цикл
						УстановитьПривилегированныйРежим(Истина);
						
						GUIDДокумента = СтрокаТаблицыXDTOАктОПриемке.GUIDДокумента;
						
						НайденныйДокумент = АктОПриемкеПоGUIDДокумента(GUIDДокумента);
						
						Если ЗначениеЗаполнено(НайденныйДокумент) Тогда
							ДокументОбъектАктПриемки = НайденныйДокумент.ПолучитьОбъект();
							ДокументОбъектАктПриемки.GUIDВходящегоДокумента = GUIDДокумента;
						Иначе
							ДокументОбъектАктПриемки = Документы.АктПриемкиМ7.СоздатьДокумент();
							ДокументОбъектАктПриемки.УстановитьНовыйНомер();
							ДокументОбъектАктПриемки.Ответственный = Пользователи.ТекущийПользователь();
						КонецЕсли;
						
						ДокументОбъектАктПриемки.ОбменДанными.Загрузка = Истина;
						ДокументОбъектАктПриемки.Материалы.Очистить();
						ДокументОбъектАктПриемки.ОсновныеСредства.Очистить();
						ДокументОбъектАктПриемки.СоставКонтейнеров.Очистить();
						ДокументОбъектАктПриемки.СоставКомиссии.Очистить();
						ДокументОбъектАктПриемки.СоставПриложения.Очистить();
						
						ДокументОбъектАктПриемки.Организация = Организация;
						ДокументОбъектАктПриемки.GUIDВходящегоДокумента = GUIDДокумента;
						
						ДатаАктаПриемки = СтроковыеФункцииКлиентСервер.СтрокаВДату(СтрокаТаблицыXDTOАктОПриемке.Дата);
						ДокументОбъектАктПриемки.Дата = ДатаАктаПриемки;
						
						ДокументОбъектАктПриемки.НомерВходящегоДокумента = СтрокаТаблицыXDTOАктОПриемке.Номер;
						ДокументОбъектАктПриемки.ДатаВходящегоДокумента = ДатаАктаПриемки;
						ДокументОбъектАктПриемки.ВидВходящегоДокумента = СтрокаТаблицыXDTOАктОПриемке.ВидДокумента;
						
						GUIDДокументаПоставщика = СтрокаТаблицыXDTOАктОПриемке.GUIDДокументаПоставщика;
						Если ЗначениеЗаполнено(GUIDДокументаПоставщика) Тогда
							Если (ТипИзвещения = 4) Тогда
								ЭДПОснованиеАкта = ПолучитьДокументОснованиеАктаРасхождений(GUIDДокументаПоставщика, НайденноеИсходящееИзвещение);
							ИначеЕсли (ТипИзвещения = 2) Тогда
								ЭДПОснованиеАкта = Документы.ЭлектронныйДокументПоставщика.ПолучитьСсылку(Новый УникальныйИдентификатор(GUIDДокументаПоставщика)); 
							КонецЕсли;
							Если ЗначениеЗаполнено(ЭДПОснованиеАкта) Тогда
								ДокументОбъектАктПриемки.ДокументОснование = ЭДПОснованиеАкта;
							КонецЕсли;	
						КонецЕсли;
						
						ДокументОбъектАктПриемки.Грузополучатель = ДокументОбъект.Отправитель;
						ДокументОбъектАктПриемки.Контрагент = ДокументОбъект.Поставщик;
						ДокументОбъектАктПриемки.Договор = ДокументОбъект.Договор;
						ДокументОбъектАктПриемки.Грузоотправитель = ДокументОбъект.Поставщик;
						
						Для Каждого СтрокаТаблицыXDTOСтраховыеКомпании Из СтрокаТаблицыXDTOАктОПриемке.СтраховыеКомпании Цикл
							НаименованиеСтраховойКомпании = СтрокаТаблицыXDTOСтраховыеКомпании.СвЮЛ.Наим;
							ИННСтраховойКомпании = СтрокаТаблицыXDTOСтраховыеКомпании.СвЮЛ.ИНН;
							КППСтраховойКомпании = СтрокаТаблицыXDTOСтраховыеКомпании.СвЮЛ.КПП;
							ОКПОСтраховойКомпании = СтрокаТаблицыXDTOСтраховыеКомпании.СвЮЛ.ОКПО;
							
							СтраховаяКомпания = Справочники.Контрагенты.ПустаяСсылка();
							Если ЗначениеЗаполнено(ИННСтраховойКомпании) Тогда
								ДополнительныеРеквизиты = Новый Структура("ИНН, КПП", ИННСтраховойКомпании, КППСтраховойКомпании); 
								НайтиСсылкуНаОбъект("Контрагенты", СтраховаяКомпания, , ДополнительныеРеквизиты);
							КонецЕсли;
							
							Если ЗначениеЗаполнено(СтраховаяКомпания) Тогда
								ДокументОбъектАктПриемки.СтраховаяКомпания = СтраховаяКомпания;
							Иначе	
									ШаблонСообщения = НСтр("ru = 'В справочнике ""Контрагенты"" не найдена страховая компания %1 с ИНН %2 и КПП %3.'");
								ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, НаименованиеСтраховойКомпании,
									ИННСтраховойКомпании, КППСтраховойКомпании);
								ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
							КонецЕсли;	
							
							Прервать;
						КонецЦикла;	
						
						ДокументОбъектАктПриемки.МестоСоставления = СтрокаТаблицыXDTOАктОПриемке.МестоСоставления;
						ДокументОбъектАктПриемки.УсловияХранения = СтрокаТаблицыXDTOАктОПриемке.УсловияХранения;
						ДокументОбъектАктПриемки.СостояниеТары = СтрокаТаблицыXDTOАктОПриемке.СостояниеТары;
						ДокументОбъектАктПриемки.МетодОпределенияНедостачи = СтрокаТаблицыXDTOАктОПриемке.МетодОпределенияНедостачи;
						ДокументОбъектАктПриемки.ДругиеДанные = СтрокаТаблицыXDTOАктОПриемке.ДругиеДанные;
						ДокументОбъектАктПриемки.ЗаключениеКомиссии = СтрокаТаблицыXDTOАктОПриемке.ЗаключениеКомиссии;
						
						Если ЗначениеЗаполнено(СтрокаТаблицыXDTOАктОПриемке.ДатаОприходования) Тогда
