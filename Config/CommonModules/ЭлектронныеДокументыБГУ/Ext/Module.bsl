		Если (Сред(ПредставлениеСчетаКт, СтрДлина(ПредставлениеСчетаКт),1)=".") Тогда
			ПредставлениеСчетаКт = Сред(ПредставлениеСчетаКт, 1, СтрДлина(ПредставлениеСчетаКт)-1);
		КонецЕсли;
	КонецЕсли;
	
	СтруктураОбластьМакетаСтрока = Новый Структура("пСодержание,пСодержаниеБезНомера,пСуммаОтправитель,пДебетСчетОтправитель,пКредитСчетОтправитель,
		|пДебетСчетПолучатель,пКредитСчетПолучатель,пСуммаПолучатель,пНомерПроводкиОтправителя");
	
	СодержаниеБезНомера = ПередаваемыеРекомендуемыеПроводки.Содержание;			
	Содержание = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1. %2'"),
				ПередаваемыеРекомендуемыеПроводки.НомерПоПорядку, ПередаваемыеРекомендуемыеПроводки.Содержание);			
	
	СтруктураОбластьМакетаСтрока.пСодержаниеБезНомера = СодержаниеБезНомера;
