					СтрокаСпискаНоменклатурыXDTO.Установить("КодОКОФ", XMLстрока(СтруктураОКОФ.Код));
				Иначе
					СтрокаСпискаНоменклатурыXDTO.Установить("КодОКОФ", XMLстрока(ПустоеЗначениеРеквизита));
				КонецЕсли;
				
				Если (ТипФорматаЭДП = 11) Тогда
					НоваяНоменклатураИGUID = СписокНоменклатурыCИдентификаторами.Добавить();
					НоваяНоменклатураИGUID.Номенклатура = Номенклатура;
					НоваяНоменклатураИGUID.ИдентификаторСтроки = ТекНоменклатура.ИдентификаторСтроки;
					НоваяНоменклатураИGUID.ЕдиницаИзмерения = Штуки();
					
					Если ЗначениеЗаполнено(ТекНоменклатура.СтранаПроисхождения) Тогда
						СтранаПроисхождения = ТекНоменклатура.СтранаПроисхождения;
						
						ДанныеСтраны = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтранаПроисхождения, "Код, Наименование");
						
						СтрокаСпискаНоменклатурыXDTO.Установить("СтранаПроисхожденияКод", ДанныеСтраны.Код);
						СтрокаСпискаНоменклатурыXDTO.Установить("СтранаПроисхождения", ДанныеСтраны.Наименование);
					КонецЕсли;
					
					Если ЗначениеЗаполнено(Номенклатура.КодТНВЭД) Тогда
						НомерТНВЭД = Номенклатура.КодТНВЭД;
						СтрокаСпискаНоменклатурыXDTO.Установить("ТНВЭД", СокрЛП(НомерТНВЭД.Код));
					Иначе	
						СтрокаСпискаНоменклатурыXDTO.Установить("ТНВЭД", "");
					КонецЕсли;

					Если ЗначениеЗаполнено(Номенклатура.ОКП) Тогда
						НомерОКП = Номенклатура.ОКП;
						СтрокаСпискаНоменклатурыXDTO.Установить("КодОКДП", СокрЛП(НомерОКП.Код));
					Иначе	
						СтрокаСпискаНоменклатурыXDTO.Установить("КодОКДП", "");
					КонецЕсли;

					Если Номенклатура.ПрослеживаемыйТовар Тогда
						СтрокаСпискаНоменклатурыXDTO.Установить("ПрослеживаемыйТовар", XMLстрока(НСтр("ru = 'Да'")));
					Иначе
						СтрокаСпискаНоменклатурыXDTO.Установить("ПрослеживаемыйТовар", XMLстрока(НСтр("ru = 'Нет'")));
					КонецЕсли;
					
					СтрокаСпискаНоменклатурыXDTO.Установить("ИдентификаторСтроки", ТекНоменклатура.ИдентификаторСтроки);
				Иначе	
					СтрокаСпискаНоменклатурыXDTO.Установить("ИдентификаторСтроки", "");
				КонецЕсли;
				
				Если ЗначениеЗаполнено(СтруктураСведенияОС.АмортизационнаяГруппа) Тогда
					СтрокаСпискаНоменклатурыXDTO.Установить("АмортизационнаяГруппа", XMLстрока(СтруктураСведенияОС.АмортизационнаяГруппа));
				Иначе
					СтрокаСпискаНоменклатурыXDTO.Установить("АмортизационнаяГруппа", XMLстрока(ПустоеЗначениеРеквизита));
				КонецЕсли;
				
				Если СтруктураСведенияОС.ГрупповойУчет Тогда
					СтрокаСпискаНоменклатурыXDTO.Установить("ГрупповойУчет", XMLстрока(НСтр("ru = 'Да'")));
				Иначе
					СтрокаСпискаНоменклатурыXDTO.Установить("ГрупповойУчет", XMLстрока(НСтр("ru = 'Нет'")));
				КонецЕсли;
		
				СтрокаСпискаНоменклатурыXDTO.Установить("Назначение", XMLстрока(СтруктураСведенияОС.Назначение));
				СтрокаСпискаНоменклатурыXDTO.Установить("Сведения", XMLстрока(СтруктураСведенияОС.Сведения));
				Если ЗначениеЗаполнено(СтруктураСведенияОС.ИзготовительОС) Тогда
					СтруктураИзготовительОС = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтруктураСведенияОС.ИзготовительОС, "КодОКПО,НаименованиеПолное");

					СтрокаСпискаНоменклатурыXDTO.Установить("Изготовитель", XMLстрока(СтруктураИзготовительОС.НаименованиеПолное));
					СтрокаСпискаНоменклатурыXDTO.Установить("ИзготовительОКПО", XMLстрока(СтруктураИзготовительОС.КодОКПО));
				Иначе
					СтрокаСпискаНоменклатурыXDTO.Установить("Изготовитель", XMLстрока(ПустоеЗначениеРеквизита));
					СтрокаСпискаНоменклатурыXDTO.Установить("ИзготовительОКПО", XMLстрока(ПустоеЗначениеРеквизита));
				КонецЕсли;
				
				СтрокаСпискаНоменклатурыXDTO.Установить("ИнвентарныйНомер", "");
				СтрокаСпискаНоменклатурыXDTO.Установить("GUIDИнвентарногоНомера", "");
				СтрокаСпискаНоменклатурыXDTO.Установить("ИнвентарныйНомерУОтправителя", "");
				
				Если ЗначениеЗаполнено(ТекНоменклатура.СчетУчета) Тогда
					СтруктураСчетУчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекНоменклатура.СчетУчета, "Код");
					СтрокаСпискаНоменклатурыXDTO.Установить("СчетУчета", XMLстрока(СтруктураСчетУчета.Код));
				Иначе
					СтрокаСпискаНоменклатурыXDTO.Установить("СчетУчета", XMLстрока(ПустоеЗначениеРеквизита));
				КонецЕсли;
				
				СтрокаСпискаНоменклатурыXDTO.Установить("СуммаАмортизации", Формат(ТекНоменклатура.СуммаАмортизации, "ЧЦ=15; ЧДЦ=2"));
				СтрокаСпискаНоменклатурыXDTO.Установить("СуммаОбесценения", Формат(ТекНоменклатура.СуммаОбесценения, "ЧЦ=15; ЧДЦ=2"));
				
				СтрокаСпискаНоменклатурыXDTO.Установить("ДатаВводаВЭксплуатацию", XMLстрока(ПустоеЗначениеРеквизита));
			КонецЕсли;	
			
			ДокументПоставщикаXDTO.СписокНоменклатурыПоставщика.Добавить(СтрокаСпискаНоменклатурыXDTO);
		КонецЦикла;
		
		//Сведения о прослеживаемости
		Если (ТипФорматаЭДП = 11) Тогда
			Для каждого ТекДанные Из ЭлектронныйДокументПоставщика.СведенияПрослеживаемости Цикл
				СтрокаСпискаПрослеживаемостиXDTO = СоздатьОбъектXDTO(ДокументПоставщикаXDTO, "СведенияОПрослеживаемости");
				
				ПараметрыОтбора = Новый Структура;
				ПараметрыОтбора.Вставить("ИдентификаторСтроки", ТекДанные.ИдентификаторСтроки);
				НайденныеСтроки = СписокНоменклатурыCИдентификаторами.НайтиСтроки(ПараметрыОтбора);
				
				GUIDНоменклатурыСписка = "";
				ЕдИзмКод = "";
				ЕдИзмНаим = "";
				ПолноеНаимНоменклатуры = "";
				
				Если НайденныеСтроки.Количество()>0 Тогда
					НайденнаяНоменклатура = НайденныеСтроки[0].Номенклатура;
					ЕдИзм = НайденныеСтроки[0].ЕдиницаИзмерения;
					
					Если ЗначениеЗаполнено(НайденнаяНоменклатура) Тогда
						GUIDНоменклатурыСписка = Строка(НайденнаяНоменклатура.УникальныйИдентификатор());
						
						ДанныеНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НайденнаяНоменклатура, "НаименованиеПолное");
						ПолноеНаимНоменклатуры = ДанныеНоменклатуры.НаименованиеПолное;
						
						ДанныеЕдИзм = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЕдИзм, "Код, Наименование");
						ЕдИзмКод = СокрЛП(ДанныеЕдИзм.Код);
						ЕдИзмНаим = СокрЛП(ДанныеЕдИзм.Наименование);
					КонецЕсли;
				КонецЕсли;							
				СтрокаСпискаПрослеживаемостиXDTO.Установить("GUIDНоменклатуры", GUIDНоменклатурыСписка);
				СтрокаСпискаПрослеживаемостиXDTO.Установить("ПолноеНаимНоменклатуры", ПолноеНаимНоменклатуры);
				
				РНПТ = "";
				Если ЗначениеЗаполнено(ТекДанные.РНПТ) Тогда
					ДанныеРНПТ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекДанные.РНПТ, "Код");
					РНПТ = ДанныеРНПТ.Код;
				КонецЕсли;
				СтрокаСпискаПрослеживаемостиXDTO.Установить("РНПТ", СокрЛП(РНПТ));
				СтрокаСпискаПрослеживаемостиXDTO.Установить("КоличествоУчетное", ТекДанные.Количество);
				СтрокаСпискаПрослеживаемостиXDTO.Установить("Количество", ТекДанные.КоличествоПрослеживаемости);
				СтрокаСпискаПрослеживаемостиXDTO.Установить("Сумма", ТекДанные.СуммаБезНДС);
				СтрокаСпискаПрослеживаемостиXDTO.Установить("ЕдИзмКод", ЕдИзмКод);
				СтрокаСпискаПрослеживаемостиXDTO.Установить("ЕдИзмНаим", ЕдИзмНаим);
				СтрокаСпискаПрослеживаемостиXDTO.Установить("ИдентификаторСтроки", СокрЛП(ТекДанные.ИдентификаторСтроки));
				
				ДокументПоставщикаXDTO.СведенияОПрослеживаемости.Добавить(СтрокаСпискаПрослеживаемостиXDTO);
			КонецЦикла;
		КонецЕсли;	
		
		ДокументXDTO.ДокументыПоставщика.Добавить(ДокументПоставщикаXDTO);
		
	КонецЕсли;
КонецПроцедуры	

Функция ВыбывшиеЗемельныеУчастки(Организация, КадастровыеНомера, ДатаСведений)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СведенияКадастровогоУчетаСрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	               |	СведенияКадастровогоУчетаСрезПоследних.ИнвентарныйНомер КАК ИнвентарныйНомер,
	               |	СведенияКадастровогоУчетаСрезПоследних.КадастровыйНомер КАК КадастровыйНомер,
	               |	1 КАК Приоритет
	               |ИЗ
	               |	РегистрСведений.СведенияКадастровогоУчета.СрезПоследних(&ДатаСведений, Организация = &Организация) КАК СведенияКадастровогоУчетаСрезПоследних
	               |ГДЕ
	               |	СведенияКадастровогоУчетаСрезПоследних.КадастровыйНомер В(&КадастровыеНомера)
	               |	И НЕ СведенияКадастровогоУчетаСрезПоследних.ИнвентарныйНомер = &ПустойИнвентарныйНомер
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	СведенияКадастровогоУчетаСрезПоследних.ОсновноеСредство,
	               |	СведенияКадастровогоУчетаСрезПоследних.ИнвентарныйНомер,
	               |	СведенияКадастровогоУчетаСрезПоследних.КадастровыйНомер,
	               |	2
	               |ИЗ
	               |	РегистрСведений.СведенияКадастровогоУчета.СрезПоследних КАК СведенияКадастровогоУчетаСрезПоследних
	               |ГДЕ
	               |	СведенияКадастровогоУчетаСрезПоследних.КадастровыйНомер В(&КадастровыеНомера)
	               |	И СведенияКадастровогоУчетаСрезПоследних.ИнвентарныйНомер = &ПустойИнвентарныйНомер
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Приоритет";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ДатаСведений", ДатаСведений);
	Запрос.УстановитьПараметр("КадастровыеНомера", КадастровыеНомера);
	Запрос.УстановитьПараметр("ПустойИнвентарныйНомер", Справочники.ИнвентарныеНомераОС.ПустаяСсылка());
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
КонецФункции	

Функция ЗемельныйУчастокПоКадастровомуНомеру(Организация, КадастровыеСведения, КадастровыйНомер)
	Результат = Новый Структура;
	Результат.Вставить("ОсновноеСредство", Справочники.ОсновныеСредства.ПустаяСсылка());
	Результат.Вставить("ИнвентарныйНомер", Справочники.ИнвентарныеНомераОС.ПустаяСсылка());

	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("КадастровыйНомер", КадастровыйНомер);
	
	НайденныеСтроки = КадастровыеСведения.НайтиСтроки(ПараметрыОтбора);
	Если НайденныеСтроки.Количество()>0 Тогда
		Результат.ОсновноеСредство = НайденныеСтроки[0].ОсновноеСредство;
		Результат.ИнвентарныйНомер = НайденныеСтроки[0].ИнвентарныйНомер;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

Функция НовыйИнвентарныйНомерЗУ(Организация, ОсновноеСредство, GUIDИнвентарногоНомера, СведенияНовогоНомера)
	УстановитьПривилегированныйРежим(Истина);

	Результат = Справочники.ИнвентарныеНомераОС.ПустаяСсылка();
	
	ДанныеИнвентарногоНомера = Новый Структура;
	ДанныеИнвентарногоНомера.Вставить("Дата"				, Дата(1,1,1));
	ДанныеИнвентарногоНомера.Вставить("КФО"				, "");
	ДанныеИнвентарногоНомера.Вставить("КПС"				, "");
	ДанныеИнвентарногоНомера.Вставить("СчетУчета"			, "");
	ДанныеИнвентарногоНомера.Вставить("ИФО"				, "");
	ДанныеИнвентарногоНомера.Вставить("ОсновноеСредство"	, ОсновноеСредство);
	
	ДанныеИнвентарногоНомера.Вставить("ИнвентарныйНомерУОтправителя"	, СведенияНовогоНомера.ИнвентарныйНомерОтправителя);
	ДанныеИнвентарногоНомера.Вставить("GUIDИнвентарногоНомераУОтправителя", GUIDИнвентарногоНомера);
	
	ДанныеИнвентарногоНомера.Вставить("РеестровыйНомер"	, "");
	ДанныеИнвентарногоНомера.Вставить("ЗаводскойНомер"	, "");
	ДанныеИнвентарногоНомера.Вставить("НомерПаспорта"	, "");
	ДанныеИнвентарногоНомера.Вставить("ИнойНомер"	, "");
	ДанныеИнвентарногоНомера.Вставить("ДатаВыпуска"	, Дата(1,1,1));
	
	Префикс = "";
	ДанныеИнвентарногоНомера.Вставить("Префикс"				, Префикс);
	ПоследнийНомер = Справочники.ИнвентарныеНомераОС.ПоследнийНомер(Организация, );
	ДлинаНомера = СтрДлина(ПоследнийНомер);
	ДанныеИнвентарногоНомера.Вставить("ДлинаНомера"			, ДлинаНомера);
	ДанныеИнвентарногоНомера.Вставить("БезУчетаПрефикса"	, Истина);
	
	Если НЕ СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(ПоследнийНомер) Тогда
		ДлинаПоследнегоНомера = СтрДлина(ПоследнийНомер);
		Для н = 1 По ДлинаПоследнегоНомера Цикл
			ВременныйПоследнийНомер = Прав(ПоследнийНомер, н);
			Если НЕ СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(ВременныйПоследнийНомер) Тогда
				Префикс = Лев(ПоследнийНомер, ДлинаПоследнегоНомера - н + 1);
				ПоследнийНомер = Прав(ПоследнийНомер, н - 1);
				ДанныеИнвентарногоНомера.БезУчетаПрефикса = Ложь;
				ДанныеИнвентарногоНомера.Префикс = Префикс;
				ДанныеИнвентарногоНомера.ДлинаНомера = СтрДлина(ПоследнийНомер);
				
				Прервать;
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;	
		
	ПорядковыйНомер = ?(ЗначениеЗаполнено(ПоследнийНомер), Число(ПоследнийНомер), 0) + 1;
	
	ДанныеИнвентарногоНомера.Вставить("ПорядковыйНомер", ПорядковыйНомер);

	ИнвНомерКод = ДанныеИнвентарногоНомера.Префикс + Формат(
		ДанныеИнвентарногоНомера.ПорядковыйНомер, "ЧВН=; ЧГ=; ЧЦ=" + ДанныеИнвентарногоНомера.ДлинаНомера);
		
	НовыйОбъектИнвНомер = Справочники.ИнвентарныеНомераОС.СоздатьЭлемент();
	НовыйОбъектИнвНомер.Владелец		= Организация;
	НовыйОбъектИнвНомер.ОС				= ОсновноеСредство;
	НовыйОбъектИнвНомер.Код				= ИнвНомерКод;
	НовыйОбъектИнвНомер.ЗаводскойНомер	= ДанныеИнвентарногоНомера.ЗаводскойНомер;
	НовыйОбъектИнвНомер.РеестровыйНомер	= ДанныеИнвентарногоНомера.РеестровыйНомер;
	НовыйОбъектИнвНомер.НомерПаспорта	= ДанныеИнвентарногоНомера.НомерПаспорта;
	НовыйОбъектИнвНомер.ИнойНомер	= ДанныеИнвентарногоНомера.ИнойНомер;
	НовыйОбъектИнвНомер.ДатаВыпуска	= ДанныеИнвентарногоНомера.ДатаВыпуска;
	НовыйОбъектИнвНомер.ИнвентарныйНомерУОтправителя = ДанныеИнвентарногоНомера.ИнвентарныйНомерУОтправителя;
	НовыйОбъектИнвНомер.GUIDИнвентарногоНомераУОтправителя = ДанныеИнвентарногоНомера.GUIDИнвентарногоНомераУОтправителя;
	
	Отказ = Ложь;
	ТекстОшибки = СтрШаблон(НСтр("ru='Создание инвентарного номера для %1.'"), ОсновноеСредство);
	ЗаписатьОбъект(НовыйОбъектИнвНомер, ТекстОшибки, Отказ);
	
	Если НЕ Отказ Тогда
		Результат = НовыйОбъектИнвНомер.Ссылка;
		Если ЗначениеЗаполнено(Результат) Тогда
			НаборЗаписей = РегистрыСведений.СведенияКадастровогоУчета.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Организация.Установить(Организация);
			НаборЗаписей.Отбор.ОсновноеСредство.Установить(ОсновноеСредство);
			НаборЗаписей.Отбор.ИнвентарныйНомер.Установить(Результат);
			НаборЗаписей.Прочитать();
			
			Если НаборЗаписей.Количество() = 0 Тогда
				НоваяЗапись = РегистрыСведений.СведенияКадастровогоУчета.СоздатьМенеджерЗаписи();
				НоваяЗапись.Организация = Организация;
				НоваяЗапись.ОсновноеСредство = ОсновноеСредство;
				НоваяЗапись.ИнвентарныйНомер = Результат;
				НоваяЗапись.ВидОбъектаНедвижимости = Перечисления.ВидыОбъектовНедвижимости.ЗемельныйУчасток;
				НоваяЗапись.КадастровыйНомер = СведенияНовогоНомера.КадастровыйНомер;
				НоваяЗапись.Период = '19800101';
				НоваяЗапись.Записать(Ложь);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
	
	Возврат Результат;

КонецФункции

Процедура ЗаписатьОбъект(ЗаписываемыйОбъект, ТекстСообщенияЖР, Отказ)
	
	Попытка
		ЗаписываемыйОбъект.Записать();
	Исключение
		ОписаниеОшибки = ИнформацияОбОшибке();
		
		ОтменитьТранзакцию();
		
		МетаданныеОбъекта = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(
			ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(ЗаписываемыйОбъект)));
		
		ЗаписьЖурналаРегистрации(ТекстСообщенияЖР,
								УровеньЖурналаРегистрации.Ошибка,
								МетаданныеОбъекта,
								,
								ПодробноеПредставлениеОшибки(ОписаниеОшибки));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(КраткоеПредставлениеОшибки(ОписаниеОшибки));
		Отказ = Истина;
	КонецПопытки;
	
КонецПроцедуры

