	МассивДокументовДляЭДО.Добавить("СчетНаОплатуОтПоставщика");
	МассивДокументовДляЭДО.Добавить("ЭлектронныйПередаточныйДокументУслугиРаботы");
	
	ПроверитьНаличиеРеквизитов = Новый Массив();
	ПроверитьНаличиеРеквизитов.Добавить("СуммаДокумента");
	
	Для каждого ТекИмяДокумента из МассивДокументовДляЭДО Цикл
		РеквизитыДокумента = Метаданные.Документы[ТекИмяДокумента].Реквизиты;
		
		Для Каждого ПроверяемыйРеквизит Из ПроверитьНаличиеРеквизитов Цикл
			Если РеквизитыДокумента.Найти(ПроверяемыйРеквизит) = Неопределено Тогда
				СоответствиеРеквизитовОбъекта.Вставить(ТекИмяДокумента + "." + ПроверяемыйРеквизит, "");
			КонецЕсли;	
		КонецЦикла;
	КонецЦикла;	
	
