	Запрос.УстановитьПараметр("ДоговорЭД", ДоговорЭД);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

Функция ЗначениеНастройкиСоздаватьПередаточныеДокументыПоКонтрагентуИДоговору(ДокументОснование) Экспорт
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.СписаниеДоходовБудущихПериодов") Тогда
		Результат = Ложь;
	ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.НачислениеДоходов") 
		ИЛИ (ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.НачислениеЗаУслугиОбразования"))  
		ИЛИ (ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.НачислениеРодительскойПлаты"))  
		ИЛИ (ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.НачислениеСтудентамЗаПрочиеУслуги")) Тогда  
		Результат = Истина;
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

Функция НомерПередаточногоДокументаЭД(СсылкаНаДокументОснование, РеквизитыДокумента, СоздаватьЭлектронныеПередаточныеДокументыДляКонтрагентаИДоговора) Экспорт
	
	Результат = "";
	
	СписокИдентификаторовЭДПередаточныхДокументов = СписокНомеровПередаточныхДокументов(СсылкаНаДокументОснование);
	
	Если СоздаватьЭлектронныеПередаточныеДокументыДляКонтрагентаИДоговора Тогда
		СписокИдентификаторовЭДПередаточныхДокументов.Свернуть("ИдентификаторЭД");
	КонецЕсли;	
	
	НомерДокументаПоПорядку = 0;
	Для каждого ТекСтрока Из СписокИдентификаторовЭДПередаточныхДокументов Цикл
		НомерДокументаПоПорядку = НомерДокументаПоПорядку + 1;
		
		Если НЕ СоздаватьЭлектронныеПередаточныеДокументыДляКонтрагентаИДоговора Тогда
			Если ТекСтрока.ИдентификаторЭД = РеквизитыДокумента.ИдентификаторЭД Тогда
				Прервать;	
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;	
	
	Результат = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(СсылкаНаДокументОснование, СсылкаНаДокументОснование.Номер) + "/" + СокрЛП(НомерДокументаПоПорядку);
	
	Возврат Результат;
	
КонецФункции

Функция СписокНомеровПередаточныхДокументов(СсылкаНаДокументОснование)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	СписаниеДоходовБудущихПериодовДоходыБудущихПериодов.НомерСтроки КАК НомерСтроки,
	               |	СписаниеДоходовБудущихПериодовДоходыБудущихПериодов.ИдентификаторЭД КАК ИдентификаторЭД
	               |ИЗ
	               |	Документ.СписаниеДоходовБудущихПериодов.ДоходыБудущихПериодов КАК СписаниеДоходовБудущихПериодовДоходыБудущихПериодов
	               |ГДЕ
	               |	СписаниеДоходовБудущихПериодовДоходыБудущихПериодов.Ссылка = &Ссылка
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	НачислениеДоходовНачисления.НомерСтроки,
	               |	НачислениеДоходовНачисления.ИдентификаторЭД
	               |ИЗ
	               |	Документ.НачислениеДоходов.Начисления КАК НачислениеДоходовНачисления
	               |ГДЕ
	               |	НачислениеДоходовНачисления.Ссылка = &Ссылка
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	НачислениеЗаУслугиОбразованияНачисления.НомерСтроки,
	               |	НачислениеЗаУслугиОбразованияНачисления.ИдентификаторЭД
	               |ИЗ
	               |	Документ.НачислениеЗаУслугиОбразования.Начисления КАК НачислениеЗаУслугиОбразованияНачисления
	               |ГДЕ
	               |	НачислениеЗаУслугиОбразованияНачисления.Ссылка = &Ссылка
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	НачислениеРодительскойПлатыНачисления.НомерСтроки,
	               |	НачислениеРодительскойПлатыНачисления.ИдентификаторЭД
	               |ИЗ
	               |	Документ.НачислениеРодительскойПлаты.Начисления КАК НачислениеРодительскойПлатыНачисления
	               |ГДЕ
	               |	НачислениеРодительскойПлатыНачисления.Ссылка = &Ссылка
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.НомерСтроки,
	               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.ИдентификаторЭД
	               |ИЗ
	               |	Документ.НачислениеСтудентамЗаПрочиеУслуги.Начисления КАК НачислениеСтудентамЗаПрочиеУслугиНачисления
	               |ГДЕ
	               |	НачислениеСтудентамЗаПрочиеУслугиНачисления.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаДокументОснование);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции	

Функция ДанныеПередаточногоДокумента(СсылкаНаПередаточныйДокумент, ПереченьИдентификаторовЭД) Экспорт

	ВалютаРегУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаПередаточныйДокумент, "ДокументОснование");

	ДанныеПередающегоТРУЛица = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаПередаточныйДокумент, 
		"ОтветственныйПередалТРУВид, ОтветственныйПередалТРУДолжность, ОтветственныйПередалТРУИныеСведения, ОтветственныйПередалТРУ,
		|ОтветственныйПередалТРУДоверенность, ОтветственныйПередалТРУОснованиеПолномочий, ОтветственныйПередалТРУКонтрагент, ДатаПередачиТРУ, ТРУПереданы");
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	СписаниеДоходовБудущихПериодовДоходыБудущихПериодов.Ссылка.Организация КАК Организация,
	               |	ЗНАЧЕНИЕ(Перечисление.ВидыОперацийЭД.ПродажаКомиссия) КАК ВидОперации,
	               |	СписаниеДоходовБудущихПериодовДоходыБудущихПериодов.Контрагент КАК Контрагент,
	               |	СписаниеДоходовБудущихПериодовДоходыБудущихПериодов.Договор КАК Договор,
	               |	ВЫРАЗИТЬ(СписаниеДоходовБудущихПериодовДоходыБудущихПериодов.Договор КАК Справочник.Договоры).НомерДоговора КАК ДокументОснованиеНомер,
	               |	ВЫРАЗИТЬ(СписаниеДоходовБудущихПериодовДоходыБудущихПериодов.Договор КАК Справочник.Договоры).ДатаДоговора КАК ДокументОснованиеДата,
	               |	ВЫРАЗИТЬ(СписаниеДоходовБудущихПериодовДоходыБудущихПериодов.Договор КАК Справочник.Договоры).ВидОбязательства КАК ДокументОснованиеНаименование,
	               |	ВЫРАЗИТЬ(&РегламентированнаяВалюта КАК Справочник.Валюты).Код КАК ВалютаКод,
	               |	ВЫРАЗИТЬ(&РегламентированнаяВалюта КАК Справочник.Валюты).Наименование КАК ВалютаНаименование,
	               |	СписаниеДоходовБудущихПериодовДоходыБудущихПериодов.Номенклатура КАК Номенклатура,
	               |	СписаниеДоходовБудущихПериодовДоходыБудущихПериодов.СтавкаНДС КАК СтавкаНДС,
	               |	СписаниеДоходовБудущихПериодовДоходыБудущихПериодов.СуммаНДС КАК СуммаНДС,
	               |	СписаниеДоходовБудущихПериодовДоходыБудущихПериодов.Всего КАК Всего,
	               |	&РегламентированнаяВалюта КАК Валюта,
	               |	СписаниеДоходовБудущихПериодовДоходыБудущихПериодов.Ссылка.Дата КАК Дата,
	               |	СписаниеДоходовБудущихПериодовДоходыБудущихПериодов.Ссылка.Дата КАК ДатаАкта,
	               |	СписаниеДоходовБудущихПериодовДоходыБудущихПериодов.Ссылка.Номер КАК Номер,
	               |	СписаниеДоходовБудущихПериодовДоходыБудущихПериодов.Ссылка КАК Ссылка,
	               |	СписаниеДоходовБудущихПериодовДоходыБудущихПериодов.НомерСтроки КАК НомерСтроки,
	               |	СписаниеДоходовБудущихПериодовДоходыБудущихПериодов.Ссылка КАК ДокументОснование,
	               |	ВЫРАЗИТЬ(СписаниеДоходовБудущихПериодовДоходыБудущихПериодов.Номенклатура КАК Справочник.Номенклатура).КодКаталога КАК КодКаталога,
	               |	ВЫРАЗИТЬ(СписаниеДоходовБудущихПериодовДоходыБудущихПериодов.Номенклатура КАК Справочник.Номенклатура).КодПоКТРУ КАК КодПоКТРУ,
	               |	ВЫРАЗИТЬ(СписаниеДоходовБудущихПериодовДоходыБудущихПериодов.Номенклатура КАК Справочник.Номенклатура).КодТНВЭД КАК КодТНВЭД,
	               |	1 КАК Количество,
	               |	ВЫРАЗИТЬ(СписаниеДоходовБудущихПериодовДоходыБудущихПериодов.Контрагент КАК Справочник.Контрагенты).ОбособленноеПодразделение КАК КонтрагентОбособленноеПодразделение,
	               |	ВЫРАЗИТЬ(СписаниеДоходовБудущихПериодовДоходыБудущихПериодов.Контрагент КАК Справочник.Контрагенты).ГоловнаяОрганизация КАК КонтрагентГоловнаяОрганизация,
	               |	ВЫБОР
	               |		КОГДА СписаниеДоходовБудущихПериодовДоходыБудущихПериодов.Контрагент.ОбособленноеПодразделение = ИСТИНА
	               |			ТОГДА ВЫБОР
