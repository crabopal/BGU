Процедура ЗаполнитьТекстПроДопСведенияДляЭлектронногоАктаПоФорме0510448(Форма, ТекстСведений)  Экспорт
	КоличествоФайлов = 0;
	ТекстНадписиДопСведенияЭлектронногоАкта = НСтр("ru='<не указаны>'");
	
	Если ЗначениеЗаполнено(ТекстСведений) Тогда
		ТекстНадписиДопСведенияЭлектронногоАкта = ТекстСведений;
	Иначе
		ДокументПередачи = Форма["Объект"].Ссылка;
		ТаблицаФайлов = ДанныеФайловПрисоединенныхКДокументуАктаПередачиНФА(ДокументПередачи);
		КоличествоФайлов = ТаблицаФайлов.Количество();
			
		Если КоличествоФайлов > 0 Тогда
			Если КоличествоФайлов = 1 Тогда
				ТекстНадписиДопСведенияЭлектронногоАкта = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru='Приложен %1 файл'"), КоличествоФайлов);
			ИначеЕсли (КоличествоФайлов > 1) И (КоличествоФайлов < 5) Тогда
				ТекстНадписиДопСведенияЭлектронногоАкта = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru='Приложено %1 файла'"), КоличествоФайлов);
			Иначе	
				ТекстНадписиДопСведенияЭлектронногоАкта = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru='Приложено %1 файлов'"), КоличествоФайлов);
			КонецЕсли;		
		КонецЕсли;	
	КонецЕсли;

	Форма.НадписьДопСведенияЭлектронногоАктаПоФорме0510448 = ТекстНадписиДопСведенияЭлектронногоАкта;
КонецПроцедуры

Функция НайтиИсходящийЭлектронныйАктОПриемеПередачеНФАПоДокументу(ДокументОснование) Экспорт
	
	НекорректныеСостоянияЭДО = Новый Массив;
	НекорректныеСостоянияЭДО.Добавить(Перечисления.СостоянияДокументовЭДО.ТребуетсяУточнение);
	НекорректныеСостоянияЭДО.Добавить(Перечисления.СостоянияДокументовЭДО.Аннулирован);
	НекорректныеСостоянияЭДО.Добавить(Перечисления.СостоянияДокументовЭДО.ЗакрытПринудительно);
	НекорректныеСостоянияЭДО.Добавить(Перечисления.СостоянияДокументовЭДО.ЗакрытСОшибкойПередачи);
	
	Результат = Документы.ЭлектронныйАктОПриемеПередачеОбъектовНФАИсходящий.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЭлектронныйАктОПриемеПередачеОбъектовНФАИсходящий.Ссылка КАК Ссылка,
	|	СостоянияПоОбъектамУчетаЭДО.СостояниеЭДО КАК СостояниеЭДО
	|ИЗ
	|	Документ.ЭлектронныйАктОПриемеПередачеОбъектовНФАИсходящий КАК ЭлектронныйАктОПриемеПередачеОбъектовНФАИсходящий
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияПоОбъектамУчетаЭДО КАК СостоянияПоОбъектамУчетаЭДО
	|		ПО ЭлектронныйАктОПриемеПередачеОбъектовНФАИсходящий.Ссылка = СостоянияПоОбъектамУчетаЭДО.СсылкаНаОбъект
	|ГДЕ
	|	ЭлектронныйАктОПриемеПередачеОбъектовНФАИсходящий.ДокументОснование = &ДокументОснование
    |	И НЕ СостоянияПоОбъектамУчетаЭДО.СостояниеЭДО В (&НекорректныеСостоянияЭДО)
	|	И ЭлектронныйАктОПриемеПередачеОбъектовНФАИсходящий.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	Запрос.УстановитьПараметр("НекорректныеСостоянияЭДО", НекорректныеСостоянияЭДО);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат = Выборка.Ссылка;
	КонецЦикла;	
	
    Возврат Результат;
КонецФункции

Процедура ПриЗаписиДокументаУчетаПоступленияДляВходящегоАктаПередачиНФА(Источник, Отказ) Экспорт
	
	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Источник.ДокументОснование) Тогда 
		Если ТипЗнч(Источник.ДокументОснование) = Тип("ДокументСсылка.ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий") Тогда
			УстановитьПривилегированныйРежим(Истина);

			ДокументПоступленияНФА = Источник.Ссылка;
			СостояниеЭДОАкта = Перечисления.СостоянияДокументовАктовЭДОБГУ.ПолученВходящийАкт;
			УАктаЕстьПометкаУдаления = Ложь;
			Если ДокументПоступленияНФА.ПометкаУдаления Тогда
				СостояниеЭДОАкта = Перечисления.СостоянияДокументовАктовЭДОБГУ.ПустаяСсылка();
				УАктаЕстьПометкаУдаления = Истина;
			КонецЕсли;
			ТекущееСостояниеЭДО = СостояниеОбменаЭлектроннымиАктамиОПриемеПередачеНФА(ДокументПоступленияНФА);
			НеИзменятьСостояниеЭДО = Ложь;
			Если ТекущееСостояниеЭДО = Перечисления.СостоянияДокументовАктовЭДОБГУ.ОбменЗавершен
				ИЛИ ТекущееСостояниеЭДО = Перечисления.СостоянияДокументовАктовЭДОБГУ.ПодготовленОтветныйАкт Тогда
				НеИзменятьСостояниеЭДО = Истина;
			КонецЕсли;
			
			Если НЕ НеИзменятьСостояниеЭДО И УАктаЕстьПометкаУдаления Тогда
				НаборЗаписей = РегистрыСведений.СостоянияПоДокументамАктовЭДОБГУ.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.СсылкаНаОбъект.Установить(ДокументПоступленияНФА);
				НаборЗаписей.Записать(Истина);
			КонецЕсли;	
			
			Если НЕ НеИзменятьСостояниеЭДО И ЗначениеЗаполнено(СостояниеЭДОАкта) И НЕ УАктаЕстьПометкаУдаления Тогда
				НаборЗаписей = РегистрыСведений.СостоянияПоДокументамАктовЭДОБГУ.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.СсылкаНаОбъект.Установить(ДокументПоступленияНФА);
				Запись = НаборЗаписей.Добавить();
				Запись.СсылкаНаОбъект = ДокументПоступленияНФА;
				Запись.СостояниеЭДО = СостояниеЭДОАкта;
				НаборЗаписей.Записать(Истина);
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция СторонаОбменаЭлектроннымиАктамиОПриемеПередачеНФА(ДокументУчетаНФА) Экспорт
	Результат = 0;
	
	Если ЗначениеЗаполнено(ДокументУчетаНФА) Тогда
		Если ТипЗнч(ДокументУчетаНФА) = Тип("ДокументСсылка.ПередачаОбъектовОС")
			ИЛИ ТипЗнч(ДокументУчетаНФА) = Тип("ДокументСсылка.ПередачаОбъектовИК")
			ИЛИ ТипЗнч(ДокументУчетаНФА) = Тип("ДокументСсылка.НакладнаяНаОтпускИК")
			ИЛИ ТипЗнч(ДокументУчетаНФА) = Тип("ДокументСсылка.НакладнаяНаОтпускМ15") Тогда
			Результат = 1; //Отправитель НФА
		ИначеЕсли ТипЗнч(ДокументУчетаНФА) = Тип("ДокументСсылка.ПоступлениеОС")
			ИЛИ ТипЗнч(ДокументУчетаНФА) = Тип("ДокументСсылка.ПоступлениеОСИК")
			ИЛИ ТипЗнч(ДокументУчетаНФА) = Тип("ДокументСсылка.ПоступлениеМЗ")
			ИЛИ ТипЗнч(ДокументУчетаНФА) = Тип("ДокументСсылка.ПрочееОтражениеЭлектронногоДокументаВУчете")
			ИЛИ ТипЗнч(ДокументУчетаНФА) = Тип("ДокументСсылка.ПоступлениеИК")
			ИЛИ ТипЗнч(ДокументУчетаНФА) = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовОС")
			ИЛИ ТипЗнч(ДокументУчетаНФА) = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовИК") Тогда
			Результат = 2; //Получатель НФА
		Конецесли;	
	Конецесли;
	
	Возврат Результат;	
КонецФункции

Функция СостояниеОбменаЭлектроннымиАктамиОПриемеПередачеНФА(ДокументУчетаНФА) Экспорт
	УстановитьПривилегированныйРежим(Истина);

	Результат = Перечисления.СостоянияДокументовАктовЭДОБГУ.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СостоянияПоДокументамАктовЭДОБГУ.СостояниеЭДО КАК СостояниеЭДО
	               |ИЗ
	               |	РегистрСведений.СостоянияПоДокументамАктовЭДОБГУ КАК СостоянияПоДокументамАктовЭДОБГУ
	               |ГДЕ
	               |	СостоянияПоДокументамАктовЭДОБГУ.СсылкаНаОбъект = &СсылкаНаОбъект";
	Запрос.УстановитьПараметр("СсылкаНаОбъект", ДокументУчетаНФА);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.СостояниеЭДО;
	КонецЕсли;	
	
	Возврат Результат;	
КонецФункции

Процедура ЗаполнитьСостояниеЭДОАктаПоФорме0510448(ДокументУчетаНФА, ДекорацияСостояниеЭДОБГУ) Экспорт
	СостояниеЭДОАктаПоФорме0510448 = СостояниеОбменаЭлектроннымиАктамиОПриемеПередачеНФА(ДокументУчетаНФА);
	Если ЗначениеЗаполнено(СостояниеЭДОАктаПоФорме0510448) Тогда
		ДекорацияСостояниеЭДОБГУ.Заголовок = СокрЛП(СостояниеЭДОАктаПоФорме0510448);
	Иначе
		ДекорацияСостояниеЭДОБГУ.Заголовок = "Не начат";
	КонецЕсли;	
КонецПроцедуры

Процедура ПослеЗавершенияВнешнегоЭДО(ЭлектронныйДокумент) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	СведенияЭД = СведенияОбЭлектронномДокументе(ЭлектронныйДокумент);
	
	СтатусЭД = Неопределено;
	СтруктураСтатусаЭД = ОбменСКонтрагентами.СтатусДокументооборота(ЭлектронныйДокумент);
	Если ТипЗнч(СтруктураСтатусаЭД) = Тип("Структура") Тогда
		СтатусЭД = СтруктураСтатусаЭД.Статус;
	КонецЕсли;
	
	Если СведенияЭД.ОписаниеВидаДокумента.ТипДокумента = Перечисления.ТипыДокументовЭДО.Прикладной
		И (СтатусЭД = "Завершен" ИЛИ СтатусЭД = "Утвержден") Тогда
		Если СведенияЭД.ОписаниеВидаДокумента.ПрикладнойТипДокумента = 
			Перечисления.ПрикладныеВидыЭлектронныхДокументовБГУ.АктОПриемеПередачеОбъектовНФА Тогда
			Если СведенияЭД.ОбъектыУчета.Количество()>0 Тогда
				ДокументСсылка = СведенияЭД.ОбъектыУчета[0];
				Если ЗначениеЗаполнено(ДокументСсылка) Тогда
					Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий") Тогда
						Реквизиты = "ТипЭлектронногоАкта, ДокументОснование";
						ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, Реквизиты);
						Если ЗначенияРеквизитов.ТипЭлектронногоАкта = 2 Тогда
							РеквизитыИсходящегоАкта = "ДокументОснование";
							ЗначенияРеквизитовИсходящегоАкта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЗначенияРеквизитов.ДокументОснование, РеквизитыИсходящегоАкта);
							
							ДокументПередачиНФА = ЗначенияРеквизитовИсходящегоАкта.ДокументОснование;
							
							Если ЗначениеЗаполнено(ДокументПередачиНФА) Тогда
								СостояниеЭДО = Перечисления.СостоянияДокументовАктовЭДОБГУ.ОбменЗавершен;
								
								НаборЗаписей = РегистрыСведений.СостоянияПоДокументамАктовЭДОБГУ.СоздатьНаборЗаписей();
								НаборЗаписей.Отбор.СсылкаНаОбъект.Установить(ДокументПередачиНФА);
								Запись = НаборЗаписей.Добавить();
								Запись.СсылкаНаОбъект = ДокументПередачиНФА;
								Запись.СостояниеЭДО = СостояниеЭДО;
								НаборЗаписей.Записать(Истина);
							КонецЕсли;
						КонецЕсли;	
					ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ЭлектронныйАктОПриемеПередачеОбъектовНФАИсходящий") Тогда
						Реквизиты = "ТипЭлектронногоАкта, ДокументОснование";
						ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, Реквизиты);
						Если ЗначенияРеквизитов.ТипЭлектронногоАкта = 2 Тогда
							ДокументПередачиНФА = ЗначенияРеквизитов.ДокументОснование;
							
							Если ЗначениеЗаполнено(ДокументПередачиНФА) Тогда
								СостояниеЭДО = Перечисления.СостоянияДокументовАктовЭДОБГУ.ОбменЗавершен;
								
								НаборЗаписей = РегистрыСведений.СостоянияПоДокументамАктовЭДОБГУ.СоздатьНаборЗаписей();
								НаборЗаписей.Отбор.СсылкаНаОбъект.Установить(ДокументПередачиНФА);
								Запись = НаборЗаписей.Добавить();
								Запись.СсылкаНаОбъект = ДокументПередачиНФА;
								Запись.СостояниеЭДО = СостояниеЭДО;
								НаборЗаписей.Записать(Истина);
							КонецЕсли;	
						КонецЕсли;
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;
    КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ВнутренниеЭДИнвентаризации

Функция ЕстьВнутреннийЭДРаспискиДляДокументаРасписки(ДокументРасписки) Экспорт
	Результат = Ложь;
	
	ИспользуетсяПОД = ИспользуетсяПОД();
	
	УстановитьПривилегированныйРежим(Истина);
	
	Если ИспользуетсяПОД Тогда
		МодульПроцессыОбработкиДокументов = ОбщегоНазначения.ОбщийМодуль("ПроцессыОбработкиДокументов");
		ИдентификаторПечатнойФормы = НСтр("ru='Расписка'");
		Результат = МодульПроцессыОбработкиДокументов.ДляПечатнойФормыДокументаУчетаЕстьЗавершенныйВнутреннийЭД(ДокументРасписки, ИдентификаторПечатнойФормы);
	Иначе	
		//ПРОФ
		ИспользоватьВнутреннийЭДО = Константы.ИспользоватьВнутренниеДокументыЭДО.Получить();

		Если ИспользоватьВнутреннийЭДО Тогда
		    ВнутреннийЭД = ВнутренниеЭлектронныеДокументыБГУ.ВнутреннийЭДРаспискиИнвентаризации(ДокументРасписки);
			Если ЗначениеЗаполнено(ВнутреннийЭД) Тогда
				СостояниеЭлектронногоДокумента = ВнутреннийЭДО.СостояниеЭлектронногоДокумента(ВнутреннийЭД);
				
				Если СостояниеЭлектронногоДокумента.Состояние = Перечисления.СостоянияДокументовВнутреннегоЭДО.Завершен Тогда
					Результат = Истина;
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;	
    КонецЕсли;

	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ИнтеграцияССервисом1СShare

// См. ИнтеграцияShareПереопределяемый.КонтактныеЛицаСНомеромТелефона
Процедура КонтактныеЛицаСНомеромТелефона(Знач Контрагент, КонтактнаяИнформация) Экспорт
	
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтрагентыКонтактнаяИнформация.Ссылка КАК Ссылка,
	|	КонтрагентыКонтактнаяИнформация.НомерТелефона КАК НомерТелефона
	|ИЗ
	|	Справочник.Контрагенты.КонтактнаяИнформация КАК КонтрагентыКонтактнаяИнформация
	|ГДЕ
	|	КонтрагентыКонтактнаяИнформация.Ссылка = &Владелец
	|	И КонтрагентыКонтактнаяИнформация.Тип = &Тип
	|	И КонтрагентыКонтактнаяИнформация.Вид В (&ВидыКонтактаКонтрагента)
	|	И НЕ КонтрагентыКонтактнаяИнформация.Ссылка.ПометкаУдаления";
	
	ТипКонтакта                = Перечисления.ТипыКонтактнойИнформации.Телефон;
	
	ВидыТелефоновКонтрагента = Новый Массив;
	ВидыТелефоновКонтрагента.Добавить(Справочники.ВидыКонтактнойИнформации["ТелефонКонтрагенты"].Ссылка);
	ВидыТелефоновКонтрагента.Добавить(Справочники.ВидыКонтактнойИнформации["ТелефонДомашнийФизическиеЛица"].Ссылка);
	ВидыТелефоновКонтрагента.Добавить(Справочники.ВидыКонтактнойИнформации["ТелефонРабочийФизическиеЛица"].Ссылка);
	
	ВидыКонтактаКонтрагента     = ВидыТелефоновКонтрагента;

	Запрос.УстановитьПараметр("Владелец", Контрагент);
	Запрос.УстановитьПараметр("Тип"                       , ТипКонтакта);
	Запрос.УстановитьПараметр("ВидыКонтактаКонтрагента"    , ВидыКонтактаКонтрагента);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Контакт = ИнтеграцияShareКлиентСервер.НовыйКонтактнаяИнформация();
		Контакт.ВладелецКонтакта      = Выборка.Ссылка;
		Контакт.НомерТелефонаБезКодов = БезКодаСтраныРФ(Выборка.НомерТелефона);
		
		КонтактнаяИнформация.Добавить(Контакт);
	КонецЦикла;
	
КонецПроцедуры

// См. ИнтеграцияShareПереопределяемый.ПриОпределенииСоставаКомандShare
Процедура ПриОпределенииСоставаКомандShare(СоставКоманд) Экспорт
	
	СоставКоманд.Исходящие.Добавить(Метаданные.Документы.СчетНаОплату.ПолноеИмя());
	СоставКоманд.Входящие.Добавить(Метаданные.Документы.СчетНаОплатуОтПоставщика.ПолноеИмя());

	СоставКоманд.Исходящие.Добавить(Метаданные.Документы.АктОбОказанииУслуг.ПолноеИмя());
	СоставКоманд.Исходящие.Добавить(Метаданные.Документы.НакладнаяНаРеализациюТорг12.ПолноеИмя());
	СоставКоманд.Исходящие.Добавить(Метаданные.Документы.НакладнаяНаОтпускМ15.ПолноеИмя());
	СоставКоманд.Исходящие.Добавить(Метаданные.Документы.ПередачаОбъектовИК.ПолноеИмя());
	СоставКоманд.Исходящие.Добавить(Метаданные.Документы.ПередачаОбъектовОС.ПолноеИмя());
	СоставКоманд.Исходящие.Добавить(Метаданные.Документы.ЭлектронныйПередаточныйДокументУслугиРаботы.ПолноеИмя());
	СоставКоманд.Входящие.Добавить(Метаданные.Документы.ЭлектронныйДокументПоставщика.ПолноеИмя());

	СоставКоманд.Исходящие.Добавить(Метаданные.Документы.АктСверкиВзаиморасчетов.ПолноеИмя());
	СоставКоманд.Входящие.Добавить(Метаданные.Документы.АктСверкиВзаиморасчетов.ПолноеИмя());

КонецПроцедуры

Функция БезКодаСтраныРФ(НомерТелефона)
	Результат = НомерТелефона;
	Если СтрДлина(НомерТелефона) > 0 Тогда
		Если Сред(НомерТелефона,1,1) = "7" Тогда
			Результат = Сред(НомерТелефона, 2);
		КонецЕсли;	
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

// См. ИнтеграцияShareПереопределяемый.ЗаполнитьНастройкиФормированияДокумента
Процедура ЗаполнитьНастройкиФормированияДокумента(СсылкаНаДокумент, НастройкиФормирования) Экспорт
	
	ПоддерживаемыеФорматыЭДО = ФорматыЭДО.ПоддерживаемыеФорматы();
	ТипыДокументов           = ОбменСКонтрагентами.ТипыДокументов();
	НаправленияДокументов    = ОбменСКонтрагентами.НаправленияДокументов();
	
	ТипИсточника = ТипЗнч(СсылкаНаДокумент);

	Если ТипИсточника = Тип("ДокументСсылка.СчетНаОплату") Тогда
		
		Реквизиты = "Организация, Контрагент, Договор";
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаДокумент, Реквизиты);
		
		НастройкиФормирования.ТипДокумента       = ТипыДокументов.СчетНаОплату;
		НастройкиФормирования.Формат             = ПоддерживаемыеФорматыЭДО.CML208;
		НастройкиФормирования.Направление        = НаправленияДокументов.Исходящий;
		НастройкиФормирования.Организация        = ЗначенияРеквизитов.Организация;
		НастройкиФормирования.Контрагент         = ЗначенияРеквизитов.Контрагент;
		НастройкиФормирования.ДоговорКонтрагента = ЗначенияРеквизитов.Договор;
		
	ИначеЕсли ТипИсточника = Тип("ДокументСсылка.АктСверкиВзаиморасчетов") Тогда
		
		Реквизиты = "Организация, Контрагент, ЭтоДокументКонтрагента";
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаДокумент, Реквизиты);
		
		НастройкиФормирования.ТипДокумента = ТипыДокументов.АктСверкиВзаиморасчетов;
		НастройкиФормирования.Формат       = ПоддерживаемыеФорматыЭДО.ФНС.АктСверкиВзаиморасчетов.ИнформацияОтправителя;
		НастройкиФормирования.Направление  = ?(ЗначенияРеквизитов.ЭтоДокументКонтрагента = Истина,
			НаправленияДокументов.Входящий, НаправленияДокументов.Исходящий);
		НастройкиФормирования.Организация  = ЗначенияРеквизитов.Организация;
		НастройкиФормирования.Контрагент   = ЗначенияРеквизитов.Контрагент;
		НастройкиФормирования.ЭтоФорматФНС = Истина;
		
	ИначеЕсли ТипИсточника = Тип("ДокументСсылка.АктОбОказанииУслуг")
		ИЛИ ТипИсточника = Тип("ДокументСсылка.ЭлектронныйПередаточныйДокументУслугиРаботы") Тогда
		ТипДокумента = ТипыДокументов.АктВыполненныхРабот;

		Реквизиты = "Организация, Контрагент, Договор";
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаДокумент, Реквизиты);
		
		ФорматТипаДокумента = ПоддерживаемыеФорматыЭДО.ФНС.УПД_5_03.ИнформацияПродавца;

		НастройкиФормирования.Направление        = НаправленияДокументов.Исходящий;
		НастройкиФормирования.Организация        = ЗначенияРеквизитов.Организация;
		НастройкиФормирования.Контрагент         = ЗначенияРеквизитов.Контрагент;
		НастройкиФормирования.ДоговорКонтрагента = ЗначенияРеквизитов.Договор;
		НастройкиФормирования.ТипДокумента = ТипДокумента;
		НастройкиФормирования.Формат       = ФорматТипаДокумента;
		НастройкиФормирования.ЭтоФорматФНС = Истина;
	ИначеЕсли ТипИсточника = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12") 
		ИЛИ ТипИсточника = Тип("ДокументСсылка.НакладнаяНаОтпускМ15")
		ИЛИ ТипИсточника = Тип("ДокументСсылка.ПередачаОбъектовИК")
		ИЛИ ТипИсточника = Тип("ДокументСсылка.ПередачаОбъектовОС") Тогда
		ТипДокумента = ТипыДокументов.ТоварнаяНакладная;

		Реквизиты = "Организация, Контрагент, Договор";
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаДокумент, Реквизиты);
		
		ФорматТипаДокумента = ПоддерживаемыеФорматыЭДО.ФНС.УПД_5_03.ИнформацияПродавца;

		НастройкиФормирования.Направление        = НаправленияДокументов.Исходящий;
		НастройкиФормирования.Организация        = ЗначенияРеквизитов.Организация;
		НастройкиФормирования.Контрагент         = ЗначенияРеквизитов.Контрагент;
		НастройкиФормирования.ДоговорКонтрагента = ЗначенияРеквизитов.Договор;
		НастройкиФормирования.ТипДокумента = ТипДокумента;
		НастройкиФормирования.Формат       = ФорматТипаДокумента;
		НастройкиФормирования.ЭтоФорматФНС = Истина;
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область АктПриемкиВыполненныхСтроительныхРабот

// см. ОбменСКонтрагентамиПереопределяемый.ЗаполнитьДанныеАктОПриемкеВыполненныхРаботВСтроительстве_ИнформацияЗаказчика
//
Процедура ЗаполнитьДанныеАктОПриемкеВыполненныхРаботВСтроительстве_ИнформацияЗаказчика(СсылкаНаОбъект, КонструкторЭД, Отказ) Экспорт
	
	ДанныеДляОтветногоТитула = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОбъект[0], 
		"Организация.НаименованиеПолное, 
		|ИнформацияЗаказчикаСтроительстваСодержание, 
		|ИнформацияЗаказчикаСтроительстваДатаРешения,
		|ИнформацияЗаказчикаСтроительстваКодОперации,
		|ИнформацияЗаказчикаСтроительстваКодРешения");
	
	ИнформацияЗаказчика = КонструкторЭД.ИнформацияЗаказчика();
	ИнформацияЗаказчика.Составитель = ДанныеДляОтветногоТитула.ОрганизацияНаименованиеПолное;
	ИнформацияЗаказчика.ДляГосИМуниципальныхНужд = Истина;
	
	ИнформацияЗаказчика.Содержание = ДанныеДляОтветногоТитула.ИнформацияЗаказчикаСтроительстваСодержание;
	
	ИнформацияЗаказчика.ДатаРешения = ДанныеДляОтветногоТитула.ИнформацияЗаказчикаСтроительстваДатаРешения;
	
	ИнформацияЗаказчика.КодОперации = ДанныеДляОтветногоТитула.ИнформацияЗаказчикаСтроительстваКодОперации;
	ИнформацияЗаказчика.РешениеПоПредоставленнымРасчетам = КонструкторЭД.НовоеРешениеПоПредоставленнымРасчетам();
	ИнформацияЗаказчика.РешениеПоПредоставленнымРасчетам.КодРешения =
		ДанныеДляОтветногоТитула.ИнформацияЗаказчикаСтроительстваКодРешения;
	
КонецПроцедуры

// см. ОбменСКонтрагентамиПереопределяемый.ПриОтраженииВУчетеДокументаАктОПриемкеСтроительныхРаботУслуг
Процедура ПриОтраженииВУчетеДокументаАктОПриемкеСтроительныхРаботУслуг(РезультатОтраженияВУчете, Знач ДанныеЭлектронногоДокумента,
	Знач ПараметрыДляОтраженияВУчете) Экспорт
	
	ДокументУчета = РезультатОтраженияВУчете.ДокументыУчета[0];

	ДанныеДляЗаполнения = ПодготовитьДанныеПоВходящемуАктуОПриемкеСтроительныхРабот(ДанныеЭлектронногоДокумента, РезультатОтраженияВУчете.ОписаниеОшибки);
	ЗаполнитьДокументПоАктуВыполненныхСтроительныхРабот(ДокументУчета, ДанныеДляЗаполнения, Истина, , РезультатОтраженияВУчете.ОписаниеОшибки);

	РезультатОтраженияВУчете.ДокументыУчета = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ДокументУчета);
	
КонецПроцедуры

// см. ОбменСКонтрагентамиПереопределяемый.НайтиСоздатьАктОПриемкеСтроительныхРаботУслуг
//
Процедура НайтиСоздатьАктОПриемкеСтроительныхРаботУслуг(КонструкторЭД, ДокументУчета, СпособОбработки, ОписаниеОшибки) Экспорт
	
	ДанныеДляЗаполнения = ПодготовитьДанныеПоВходящемуАктуОПриемкеСтроительныхРабот(КонструкторЭД, ОписаниеОшибки);
	ЗаполнитьДокументПоАктуВыполненныхСтроительныхРабот(ДокументУчета, ДанныеДляЗаполнения, Истина, СпособОбработки, ОписаниеОшибки);
	
КонецПроцедуры

Процедура ПриОпределенииТаблицАктаОПриемкиСтроительныхРаботУслугКСопоставленияНоменклатуры(ТаблицыКСопоставлению,
	ДоступныеТаблицы) Экспорт

	ТаблицыКСопоставлению.Добавить(ДоступныеТаблицы.Разделы);
	
КонецПроцедуры

Процедура ЗаполнитьДокументПоАктуВыполненныхСтроительныхРабот(СсылкаНаВладельца, ДанныеДокумента, Записывать = Истина, СпособОбработки = Неопределено, ОписаниеОшибки = "")
	
	Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
		Возврат;
	КонецЕсли;
	
	РежимЗаписи = РежимЗаписиДокумента.Запись;
	Попытка
		Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
			ДокументОбъект = СсылкаНаВладельца.ПолучитьОбъект();
			Если ДокументОбъект.Проведен Тогда
				Текст = НСтр("ru = 'Операция возможна только для непроведенных документов!'");
			КонецЕсли;
		Иначе
			УстановитьПривилегированныйРежим(Истина);
			ДокументОбъект = Документы.ЭлектронныйДокументПоставщика.СоздатьДокумент();
			ДокументОбъект.Дата = ТекущаяДатаСеанса();
		КонецЕсли;
		ДокументОбъект.ОбменДанными.Загрузка = Истина;
		
		ДанныеТабличныхЧастей = ДанныеДокумента.ДанныеТабличныхЧастей;
		Шапка = ДанныеДокумента.Шапка;

		ДокументОбъект.Организация = Шапка.Организация;
		ДокументОбъект.НомерПервичногоДокумента = Шапка.НомерВходящегоДокумента;
		ДокументОбъект.ДатаПервичногоДокумента = Шапка.ДатаВходящегоДокумента;
		ДокументОбъект.ВидПервичногоДокумента = НСтр("ru = 'Акт о приемке выполненных работ в строительстве'");
		
		ДокументОбъект.ТипФорматаЭД = 6;

		ДокументОбъект.НачалоРабот = Шапка.НачалоРабот;
		ДокументОбъект.ОкончаниеРабот = Шапка.ОкончаниеРабот;
		ДокументОбъект.ОбъектСтроительства = Шапка.ОбъектСтроительства;
		ДокументОбъект.Контрагент = Шапка.Контрагент;
		
		ЕстьНастройкиЭДО = ВидимостьЭлементовЭДО(Шапка.Контрагент, Шапка.Организация);
		ДокументИзЕИС = Ложь;
		Если НЕ ЕстьНастройкиЭДО Тогда
			ДокументИзЕИС = Истина;
		КонецЕсли;	
		ДокументОбъект.ЗагруженИзЕИС = ДокументИзЕИС;
		
		ДокументОбъект.ВалютаДокумента = Шапка.ВалютаДокумента;
		
		ДатаДоговора = Шапка.ДатаДоговора;
		НомерДоговора = Шапка.НомерДоговора;
		НаименованиеДоговора = Шапка.НаименованиеДоговора;
		
		Если ЗначениеЗаполнено(ДатаДоговора) И ЗначениеЗаполнено(Шапка.Контрагент) Тогда
			Договор = Справочники.Договоры.ПустаяСсылка();
			ДополнительныеРеквизиты = Новый Структура("НомерДоговора, ДатаДоговора, Владелец, Организация",
				НомерДоговора, ДатаДоговора, Шапка.Контрагент, Шапка.Организация); 
			НайтиСсылкуНаОбъект("ДоговорыКонтрагентов", Договор, , ДополнительныеРеквизиты);
			
			Если НЕ ЗначениеЗаполнено(Договор) Тогда
				ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком;
				ДополнительныеРеквизиты.Вставить("ВидДоговора", ВидДоговора);
				ДополнительныеРеквизиты.Вставить("НаименованиеДоговора", НаименованиеДоговора);
				СоздатьДоговорПоРеквизитам(ДополнительныеРеквизиты, Договор);
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(Договор) Тогда
				ШаблонСообщения = НСтр("ru = 'В справочнике ""Договоры"" не найден договор контрагента %1.'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, НаименованиеДоговора);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			КонецЕсли;	
			
			ДокументОбъект.Договор = Договор;
		КонецЕсли;	
		
		ДокументОбъект.СписокНоменклатуры.Очистить();
		Для Каждого ТекСтрока Из ДанныеТабличныхЧастей.СписокНоменклатуры Цикл
			СтрокаТЧ = ДокументОбъект.СписокНоменклатуры.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТЧ, ТекСтрока);
		КонецЦикла;
		ДокументОбъект.СуммаДокумента = ДокументОбъект.СписокНоменклатуры.Итог("Всего");
		
		//Значения титула заказчика по умолчанию
		КодыОпераций = КодыОперации();
		КодыРешений = КодыРешенияПоПредоставленнымРасчетам();
		
		ДокументОбъект.ИнформацияЗаказчикаСтроительстваСодержание = НСтр("ru = 'Результаты работ приняты без претензий'");
		ДокументОбъект.ИнформацияЗаказчикаСтроительстваДатаРешения = ТекущаяДатаСеанса();
		ДокументОбъект.ИнформацияЗаказчикаСтроительстваКодОперации = КодыОпераций.ПринятоБезЗамечаний;
		ДокументОбъект.ИнформацияЗаказчикаСтроительстваКодРешения = КодыРешений.СверкаНеПредусмотрена;
		
		ДокументОбъект.ДополнительныеСвойства.Вставить("ЕстьСоглашение", Истина);
		ДокументОбъект.ДополнительныеСвойства.Вставить("ПроцессыОбработкиДокументов_ЗаписатьБезПроверкиОбменДаннымиЗагрузка", Истина);
		Если Записывать Тогда
			Если НЕ ЗначениеЗаполнено(ДокументОбъект.Номер) Тогда
				ДокументОбъект.УстановитьНовыйНомер();
			КонецЕсли;
			
			ДокументОбъект.Записать(РежимЗаписи);
			СсылкаНаВладельца = ДокументОбъект.Ссылка;
		Иначе // если функция вызвана из формы "Обработки.ОбменСКонтрагентами.ФормаЗагрузкиПросмотраЭД"
			СсылкаНаВладельца = ДокументОбъект;
		КонецЕсли;
		
		//ЭПД
		ПроверитьУстановитьСвязьЭТрН(СсылкаНаВладельца);
		
	Исключение
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Заполнение документа на основе ЭД. %1'"), Текст)
			+ Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ВыполнитьЗаписьСобытияПоЭДВЖурналРегистрации(ТекстСообщения,
			2, УровеньЖурналаРегистрации.Ошибка, ДокументОбъект.Метаданные(), СсылкаНаВладельца);
		ВызватьИсключение(Текст);
	КонецПопытки;
	
КонецПроцедуры

// Возвращаемое значение:
//  ФиксированнаяСтруктура:
// * Отказ - Строка
// * ПринятоБезЗамечаний - Строка
// * ПринятоСБезвозмезднымУстранениемНедостатков - Строка
// * ПринятоСУменьшениемСтоимостиДоговора - Строка
// * ПринятоСВозмещениемРасходов - Строка
//
Функция КодыОперации() Экспорт
	Типы = Новый Структура;
	Типы.Вставить("Отказ", "0");
	Типы.Вставить("ПринятоБезЗамечаний", "1");
	Типы.Вставить("ПринятоСБезвозмезднымУстранениемНедостатков", "2");
	Типы.Вставить("ПринятоСУменьшениемСтоимостиДоговора", "4");
	Типы.Вставить("ПринятоСВозмещениемРасходов", "5");
	Возврат Новый ФиксированнаяСтруктура(Типы);
КонецФункции

// Возвращаемое значение:
//  ФиксированнаяСтруктура:
// * Согласен - Строка
// * СогласенСДопУдержанием - Строка
// * НеСогласен - Строка
// * РасчетыНеСверялись - Строка
// * СверкаНеПредусмотрена - Строка
//
Функция КодыРешенияПоПредоставленнымРасчетам() Экспорт
	Типы = Новый Структура;
	Типы.Вставить("Согласен", "С представленными подрядчиком сведениями о расчетах согласен");
	Типы.Вставить("СогласенСДопУдержанием", "С представленными подрядчиком сведениями о расчетах согласен, "
		+ "есть информация о дополнительных удержаниях заказчиком в соответствии с "
		+ "законодательством о контрактной системе в сфере закупок товаров, работ, "
		+ "услуг для обеспечения государственных и муниципальных нужд");
	Типы.Вставить("НеСогласен", "С представленными подрядчиком сведениями о расчетах не согласен");
	Типы.Вставить("РасчетыНеСверялись",
		"Представленные подрядчиком сведения о расчетах по договору на момент приемки работ не сверялись");
	Типы.Вставить("СверкаНеПредусмотрена", "Условиями договора строительного подряда сверка расчетов по договору "
		+ "непосредственно в акте о приемке выполненных работ не предусмотрена");
	Возврат Новый ФиксированнаяСтруктура(Типы);
КонецФункции

Функция ПодготовитьДанныеПоВходящемуАктуОПриемкеСтроительныхРабот(КонструкторЭД, ОписаниеОшибки)
	
	ИнформацияПодрядчика = КонструкторЭД.ИнформацияПодрядчика();
	
	ДанныеОбъекта = Новый Структура;
	
	ДанныеТабличныхЧастей = НовыйДанныеТабличныхЧастейЭлектронногоДокументаПоставщика();
	
	ВалютаЭД = ИнформацияПодрядчика.Валюта;
	Валюта = ОбщегоНазначенияБЭД.НайтиСсылку("Валюты",	ВалютаЭД.Код);
	ДанныеОбъекта.Вставить("ВалютаДокумента",			Валюта);
	ДанныеОбъекта.Вставить("КурсВзаиморасчетов",		ВалютаЭД.Курс);
	ДанныеОбъекта.Вставить("КратностьВзаиморасчетов",	1);

	ДанныеОбъекта.Вставить("ГосНомерДоговора",			ИнформацияПодрядчика.ДоговорПодряда.ГосНомер);
	ДанныеОбъекта.Вставить("ДатаДоговора",				ИнформацияПодрядчика.ДоговорПодряда.Дата);
	ДанныеОбъекта.Вставить("НомерДоговора",				ИнформацияПодрядчика.ДоговорПодряда.Номер);
	ДанныеОбъекта.Вставить("НаименованиеДоговора",		ИнформацияПодрядчика.ДоговорПодряда.Наименование);

	ДанныеОбъекта.Вставить("ОбъектСтроительства",		ИнформацияПодрядчика.Стройка);
	ДанныеОбъекта.Вставить("НачалоРабот",				ИнформацияПодрядчика.НачалоРабот);
	ДанныеОбъекта.Вставить("ОкончаниеРабот",			ИнформацияПодрядчика.ОкончаниеРабот);
	
	ДанныеОбъекта.Вставить("СуммаВключаетНДС",			Ложь);
	ДанныеОбъекта.Вставить("Корректировка",				Ложь);
	
	ДанныеОбъекта.Вставить("НомерВходящегоДокумента",	ИнформацияПодрядчика.НомерАкта);
	ДанныеОбъекта.Вставить("ДатаВходящегоДокумента",	ИнформацияПодрядчика.ДатаАкта);
	ДанныеОбъекта.Вставить("Исправление",				Ложь);
	
	НайтиОрганизациюПоДаннымАктаОПриемкеРабот(ДанныеОбъекта, ИнформацияПодрядчика, ОписаниеОшибки);
	
	ДанныеОбъекта.Вставить("Контрагент",				КонтрагентПоДаннымАктаОПриемкеРабот(ИнформацияПодрядчика));
	ДанныеОбъекта.Вставить("ПередачаТовараКомитентом",	Ложь);
	
	НастройкиДокумента = ИнформацияПодрядчика.НастройкиДокумента;
	НДСТолькоВИтогах = (НастройкиДокумента.СпособРасчетаНДС = КонструкторЭД.СпособыРасчетаНДС().ТолькоВИтогах);
	
	ТаблицаРаспределения = РаспределенныйНДСПоРазделам(ИнформацияПодрядчика.ВыполненныеРаботы,
		ИнформацияПодрядчика.Итоги, НДСТолькоВИтогах);
	Индекс = 0;
	Если АктПриемкиСодержитРазделы(ИнформацияПодрядчика.ВыполненныеРаботы) Тогда
		Для Каждого СтрокаРаботы Из ИнформацияПодрядчика.ВыполненныеРаботы Цикл	
			НайденныеСтроки = ТаблицаРаспределения.НайтиСтроки(Новый Структура("ИндексРаздела", Индекс));
			Если ЗначениеЗаполнено(НайденныеСтроки) Тогда
				Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
					НоваяСтрока = ДанныеТабличныхЧастей.СписокНоменклатуры.Добавить();
					НоваяСтрока.Номенклатура	= СтрокаРаботы.Сопоставление.Номенклатура;
					НоваяСтрока.Сумма			= НайденнаяСтрока.Сумма;
					НоваяСтрока.СуммаНДС		= НайденнаяСтрока.СуммаНДС;
					НоваяСтрока.СтавкаНДС		= ПолучитьСтавкуНДСПеречислением(НайденнаяСтрока.СтавкаНДС);
					НоваяСтрока.Содержание		= СтрокаРаботы.Наименование;
					
					НоваяСтрока.Количество		= 1;
					НоваяСтрока.Цена			= НоваяСтрока.Сумма;
					НоваяСтрока.Всего			= НоваяСтрока.Сумма;
				КонецЦикла;
			Иначе
				НоваяСтрока = ДанныеТабличныхЧастей.СписокНоменклатуры.Добавить();
				НоваяСтрока.Номенклатура = СтрокаРаботы.Сопоставление.Номенклатура;
				НоваяСтрока.Сумма        = СтрокаРаботы.Сумма;
				НоваяСтрока.СуммаНДС     = СтрокаРаботы.СуммаНДС;
				НоваяСтрока.Содержание   = СтрокаРаботы.Наименование;
				
				НоваяСтрока.Количество		= 1;
				НоваяСтрока.Цена			= НоваяСтрока.Сумма;
				НоваяСтрока.Всего			= НоваяСтрока.Сумма;
			КонецЕсли;
			Индекс = Индекс + 1;
		КонецЦикла;
	Иначе // ЭД не содержит в табличной части разделов, только расшифровка по работам и материалам
		Для Каждого СтрокаТаблицы Из ТаблицаРаспределения Цикл
			НоваяСтрока = ДанныеТабличныхЧастей.СписокНоменклатуры.Добавить();
			НоваяСтрока.Сумма      = СтрокаТаблицы.Сумма;
			НоваяСтрока.СуммаНДС   = СтрокаТаблицы.СуммаНДС;
			НоваяСтрока.СтавкаНДС  = ПолучитьСтавкуНДСПеречислением(СтрокаТаблицы.СтавкаНДС);
			НоваяСтрока.Содержание = НСтр("ru = 'Строительные работы'");
			
			НоваяСтрока.Количество		= 1;
			НоваяСтрока.Цена			= НоваяСтрока.Сумма;
			НоваяСтрока.Всего			= НоваяСтрока.Сумма;
		КонецЦикла;
	КонецЕсли;
	ДанныеДляЗаполнения = Новый Структура();
	ДанныеДляЗаполнения.Вставить("Шапка",                 ДанныеОбъекта);
	ДанныеДляЗаполнения.Вставить("ДанныеТабличныхЧастей", ДанныеТабличныхЧастей);
	
	Возврат ДанныеДляЗаполнения;
	
КонецФункции

Функция НовыйДанныеТабличныхЧастейЭлектронногоДокументаПоставщика()
	
	Результат = Новый Структура;
	
	ПоступлениеТоваровУслуг = Документы.ЭлектронныйДокументПоставщика.ПустаяСсылка();
	Результат.Вставить("СписокНоменклатуры",       		 	ПоступлениеТоваровУслуг.СписокНоменклатуры.ВыгрузитьКолонки());
	Результат.Вставить("ГосЗакупкиДенежныеОбязательства",	ПоступлениеТоваровУслуг.ГосЗакупкиДенежныеОбязательства.ВыгрузитьКолонки());
	Результат.Вставить("КодыУпаковокМаркируемойПродукции",  ПоступлениеТоваровУслуг.КодыУпаковокМаркируемойПродукции.ВыгрузитьКолонки());
	Результат.Вставить("СведенияПрослеживаемости", ПоступлениеТоваровУслуг.СведенияПрослеживаемости.ВыгрузитьКолонки());
	
	Возврат Результат;
	
КонецФункции

Функция РаспределенныйНДСПоРазделам(ДанныеТабличнойЧасти, Итоги, НДСТолькоВИтогах)
	
	ТаблицаРаспределения = Новый ТаблицаЗначений;
	ТаблицаРаспределения.Колонки.Добавить("ИндексРаздела");
	ТаблицаРаспределения.Колонки.Добавить("СтавкаНДС");
	ТаблицаРаспределения.Колонки.Добавить("Сумма");
	ТаблицаРаспределения.Колонки.Добавить("СуммаНДС");
	
	СуммаНДСВРазбивкеПоСтавкам = Итоги.ОтчетныйПериод.НалогиПоСтавкам;
	
	ИндексРаздела = 0;
	Если АктПриемкиСодержитРазделы(ДанныеТабличнойЧасти) Тогда
		Для Каждого Раздел Из ДанныеТабличнойЧасти Цикл
			Для Каждого ВыполненнаяРабота Из Раздел.ВыполненныеРаботы Цикл
				СтрокаРаспределения = ТаблицаРаспределения.Добавить();
				СтрокаРаспределения.ИндексРаздела = ИндексРаздела;
				СтрокаРаспределения.СтавкаНДС     = ВыполненнаяРабота.СтавкаНДС;
				СтрокаРаспределения.Сумма         = ВыполненнаяРабота.Сумма;
				СтрокаРаспределения.СуммаНДС      = ВыполненнаяРабота.СуммаНДС;
			КонецЦикла;
			ИндексРаздела = ИндексРаздела + 1;
		КонецЦикла;
	Иначе
		Для Каждого ВыполненнаяРабота Из ДанныеТабличнойЧасти Цикл
			СтрокаРаспределения = ТаблицаРаспределения.Добавить();
			СтрокаРаспределения.ИндексРаздела = ИндексРаздела;
			СтрокаРаспределения.СтавкаНДС     = ВыполненнаяРабота.СтавкаНДС;
			СтрокаРаспределения.Сумма         = ВыполненнаяРабота.Сумма;
			СтрокаРаспределения.СуммаНДС      = ВыполненнаяРабота.СуммаНДС;
		КонецЦикла;
	КонецЕсли;
	ТаблицаРаспределения.Свернуть("ИндексРаздела, СтавкаНДС", "Сумма, СуммаНДС");
	
	Если НДСТолькоВИтогах Тогда
		Для Каждого ЭлементСоответствия Из СуммаНДСВРазбивкеПоСтавкам Цикл
			НайденныеСтроки = ТаблицаРаспределения.НайтиСтроки(Новый Структура("СтавкаНДС", ЭлементСоответствия.Ключ));
			Коэффициенты = Новый Массив;
			Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				Коэффициенты.Добавить(НайденнаяСтрока.Сумма);
			КонецЦикла;
			РаспределенныеСуммы = ОбщегоНазначенияКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
				ЭлементСоответствия.Значение.Сумма, Коэффициенты, 2);
			Если ЗначениеЗаполнено(РаспределенныеСуммы) Тогда
				Для Индекс = 0 По РаспределенныеСуммы.ВГраница() Цикл
					НайденныеСтроки[Индекс].СуммаНДС = РаспределенныеСуммы[Индекс];
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат ТаблицаРаспределения;
	
КонецФункции

Функция АктПриемкиСодержитРазделы(ВыполненныеРаботы)
	
	Если ЗначениеЗаполнено(ВыполненныеРаботы)
			И ТипЗнч(ВыполненныеРаботы[0]) = Тип("ОбработкаТабличнаяЧастьСтрока.ФорматАктПриемкиСтроительныхРаботИнформацияПодрядчикаЭДО.ДанныеРазделов") Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Процедура НайтиОрганизациюПоДаннымАктаОПриемкеРабот(ДанныеОбъекта, ДанныеЭД, ОписаниеОшибки = "")

	Организация = Справочники.Организации.ПустаяСсылка();
	
	ДанныеЗаказчика = ДанныеЭД.Заказчик.СведенияОЛице;
	ИНН = ДанныеЗаказчика.ИНН;
	КПП = ДанныеЗаказчика.КПП;
	
	СсылкаНаОбъектПоИННКПП("Организации", ИНН, КПП, Организация);
	
	// Если организация не найдена, то вызываем исключение и не создаем документ ИБ на основании ЭД.
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Если ЗначениеЗаполнено(КПП) Тогда
			Шаблон = НСтр("ru = 'Не удалось создать документ, организация с ИНН/КПП %1/%2 не найдена'");
			ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, ИНН, КПП);
		Иначе
			Шаблон = НСтр("ru = 'Не удалось создать документ, организация с ИНН %1 не найдена'");
			ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, ИНН);
		КонецЕсли;
		
		Возврат;
	КонецЕсли;
	
	ДанныеОбъекта.Вставить("Организация", Организация);
	
КонецПроцедуры

Функция КонтрагентПоДаннымАктаОПриемкеРабот(ДанныеЭД)
	
	Контрагент = Справочники.Контрагенты.ПустаяСсылка();

	ДанныеПодрядчикаИзЭД = ДанныеЭД.Подрядчик.СведенияОЛице;
	ДанныеПодрядчика = Новый Структура;
	ДанныеПодрядчика.Вставить("ИНН", "");
	ДанныеПодрядчика.Вставить("КПП", "");
	
	ЗаполнитьЗначенияСвойств(ДанныеПодрядчика, ДанныеПодрядчикаИзЭД);
	
	ИНН = ДанныеПодрядчика.ИНН;
	КПП = ДанныеПодрядчика.КПП;
	
	СсылкаНаОбъектПоИННКПП("Контрагенты", ИНН, КПП, Контрагент);
	
	Возврат Контрагент;
	
КонецФункции

Функция СуммаДокументаПоДаннымБУ(ДокументУчета) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт КАК СчетДт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.КПСДт КАК КПСДт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.КЭКДт КАК КЭКДт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.КФО КАК КФО,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт КАК СчетКт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.КПСКт КАК КПСКт,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.КЭККт КАК КЭККт,
	               |	СУММА(ЖурналПроводокЕПСБУДвиженияССубконто.Сумма) КАК Сумма,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор КАК Регистратор,
	               |	ЖурналПроводокЕПСБУДвиженияССубконто.Содержание КАК Содержание,
	               |	ВЫБОР
	               |		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства)
	               |			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт1 КАК Справочник.ОсновныеСредства)
	               |		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства)
	               |			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт2 КАК Справочник.ОсновныеСредства)
	               |		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства)
	               |			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт3 КАК Справочник.ОсновныеСредства)
	               |		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства)
	               |			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1 КАК Справочник.ОсновныеСредства)
	               |		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства)
	               |			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт2 КАК Справочник.ОсновныеСредства)
	               |		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства)
	               |			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт3 КАК Справочник.ОсновныеСредства)
	               |		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	               |			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт1 КАК Справочник.Номенклатура)
	               |		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	               |			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт2 КАК Справочник.Номенклатура)
	               |		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоДт3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	               |			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт3 КАК Справочник.Номенклатура)
	               |		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	               |			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1 КАК Справочник.Номенклатура)
	               |		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	               |			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт2 КАК Справочник.Номенклатура)
	               |		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.ВидСубконтоКт3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	               |			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт3 КАК Справочник.Номенклатура)
	               |		ИНАЧЕ НЕОПРЕДЕЛЕНО
	               |	КОНЕЦ КАК УникальноеПолеСвертки
	               |ИЗ
	               |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	               |			,
	               |			,
	               |			Регистратор В (&ДокументУчета)
	               |				И НЕ СчетКт В (&СчетаАмортизации)
	               |				И НЕ СчетКт В (&СчетаОбесценения)
