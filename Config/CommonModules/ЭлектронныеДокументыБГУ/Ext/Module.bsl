		               |
		               |ВЫБРАТЬ
		               |	ИсправительныйСчетФактураПолученный.Ссылка,
		               |	ИсправительныйСчетФактураПолученный.Дата
		               |ИЗ
		               |	Документ.ИсправительныйСчетФактураПолученный КАК ИсправительныйСчетФактураПолученный
		               |ГДЕ
		               |	ИсправительныйСчетФактураПолученный.Организация = &Организация
		               |	И ИсправительныйСчетФактураПолученный.НомерСчетаФактуры = &НомерСчетаФактуры
		               |	И ИсправительныйСчетФактураПолученный.ДатаСчетаФактуры МЕЖДУ &ДатаСчетаФактурыНачалоПериода И &ДатаСчетаФактурыКонецПериода
		               |	И НЕ ИсправительныйСчетФактураПолученный.Ссылка = &СсылкаНаДокумент
		               |	И ИсправительныйСчетФактураПолученный.Дата < &ДоДаты
		               |
		               |ОБЪЕДИНИТЬ ВСЕ
		               |
		               |ВЫБРАТЬ
		               |	КорректировочныйСчетФактураПолученный.Ссылка,
		               |	КорректировочныйСчетФактураПолученный.Дата
		               |ИЗ
		               |	Документ.КорректировочныйСчетФактураПолученный КАК КорректировочныйСчетФактураПолученный
		               |ГДЕ
		               |	КорректировочныйСчетФактураПолученный.Организация = &Организация
		               |	И КорректировочныйСчетФактураПолученный.НомерСчетаФактуры = &НомерСчетаФактуры
		               |	И КорректировочныйСчетФактураПолученный.ДатаСчетаФактуры МЕЖДУ &ДатаСчетаФактурыНачалоПериода И &ДатаСчетаФактурыКонецПериода
		               |	И &КорректировочныйСчетФактура
		               |	И НЕ КорректировочныйСчетФактураПолученный.Ссылка = &СсылкаНаДокумент
		               |	И КорректировочныйСчетФактураПолученный.Дата < &ДоДаты
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	ДатаСчетаФактуры УБЫВ";
		
		Запрос.УстановитьПараметр("ДатаСчетаФактурыНачалоПериода", НачалоГода(ДокументОбъект.Дата));
		Запрос.УстановитьПараметр("ДатаСчетаФактурыКонецПериода", КонецДня(ДокументОбъект.Дата));
	Иначе
		ТекстЗапроса = "ВЫБРАТЬ
	               |	СчетФактураПолученный.Ссылка КАК Ссылка,
	               |	СчетФактураПолученный.Дата КАК ДатаСчетаФактуры
	               |ИЗ
	               |	Документ.СчетФактураПолученный КАК СчетФактураПолученный
	               |ГДЕ
	               |	СчетФактураПолученный.Организация = &Организация
	               |	И СчетФактураПолученный.НомерПервичногоДокумента = &НомерСчетаФактуры
	               |	И СчетФактураПолученный.ДатаПервичногоДокумента = &ДатаСчетаФактуры
	               |	И НЕ СчетФактураПолученный.Ссылка = &СсылкаНаДокумент
	               |	И СчетФактураПолученный.Дата < &ДоДаты
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ИсправительныйСчетФактураПолученный.Ссылка,
	               |	ИсправительныйСчетФактураПолученный.Дата
	               |ИЗ
	               |	Документ.ИсправительныйСчетФактураПолученный КАК ИсправительныйСчетФактураПолученный
	               |ГДЕ
	               |	ИсправительныйСчетФактураПолученный.Организация = &Организация
	               |	И ИсправительныйСчетФактураПолученный.НомерСчетаФактуры = &НомерСчетаФактуры
	               |	И ИсправительныйСчетФактураПолученный.ДатаСчетаФактуры = &ДатаСчетаФактуры
	               |	И НЕ ИсправительныйСчетФактураПолученный.Ссылка = &СсылкаНаДокумент
	               |	И ИсправительныйСчетФактураПолученный.Дата < &ДоДаты
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	КорректировочныйСчетФактураПолученный.Ссылка,
	               |	КорректировочныйСчетФактураПолученный.Дата
	               |ИЗ
	               |	Документ.КорректировочныйСчетФактураПолученный КАК КорректировочныйСчетФактураПолученный
	               |ГДЕ
	               |	КорректировочныйСчетФактураПолученный.Организация = &Организация
	               |	И КорректировочныйСчетФактураПолученный.НомерСчетаФактуры = &НомерСчетаФактуры
	               |	И КорректировочныйСчетФактураПолученный.ДатаСчетаФактуры = &ДатаСчетаФактуры
	               |	И &КорректировочныйСчетФактура
	               |	И НЕ КорректировочныйСчетФактураПолученный.Ссылка = &СсылкаНаДокумент
	               |	И КорректировочныйСчетФактураПолученный.Дата < &ДоДаты
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДатаСчетаФактуры УБЫВ";
		
		Запрос.УстановитьПараметр("ДатаСчетаФактуры", ДатаСчетаФактуры);
	КонецЕсли;	
	
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("НомерСчетаФактуры", НомерСчетаФактуры);
