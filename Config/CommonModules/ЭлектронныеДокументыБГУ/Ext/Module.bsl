#Область ЭДОтветНаЗаказ

// Поиск и создание документа "Счет на оплату от поставщика"
//
Функция НайтиСоздатьСчетНаОплатуОтПоставщикаКакОтветНаЗаказ(СтрокаДляЗагрузки, ДеревоРазбора, СсылкаНаВладельца = Неопределено, Записывать = Истина, ПараметрыДляОтраженияВУчете = Неопределено)
	
	ВозвращаемоеЗначение = Неопределено;
	
	ДанныеДляЗагрузки = ПодготовитьСтруктуруДляСчетНаОплатуОтПоставщикаОтветНаЗаказ(СтрокаДляЗагрузки, ДеревоРазбора);
	
	Если ДанныеДляЗагрузки.Свойство("Шапка") Тогда
		ДанныеЗаполнения = ДанныеДляЗагрузки.Шапка;
	КонецЕсли;
	
	РежимЗаписи = РежимЗаписиДокумента.Запись;
	Попытка
		Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
			ДокументОбъект = СсылкаНаВладельца.ПолучитьОбъект();
			Если ДокументОбъект.Проведен Тогда
				Текст = НСтр("ru = 'Операция возможна только для непроведенных документов!'");
			КонецЕсли;
		Иначе
			УстановитьПривилегированныйРежим(Истина);
			ДокументОбъект = Документы.СчетНаОплатуОтПоставщика.СоздатьДокумент();
			ДокументОбъект.Дата = ТекущаяДатаСеанса();
			ДокументОбъект.Заполнить(ДанныеЗаполнения);
		КонецЕсли;
		
		ДокументОбъект.ТипФорматаЭД = 1;
		
		Если ДанныеЗаполнения.Свойство("Организация") Тогда
			ДокументОбъект.Организация = ДанныеЗаполнения.Организация;
		КонецЕсли;	
		Если ДанныеЗаполнения.Свойство("СуммаИтог") Тогда
			ДокументОбъект.СуммаДокумента = ДанныеЗаполнения.СуммаИтог;
		КонецЕсли;	
		Если ДанныеЗаполнения.Свойство("СуммаНалогаИтог") Тогда
			ДокументОбъект.СуммаНалогаИтог = ДанныеЗаполнения.СуммаНалогаИтог;
		КонецЕсли;	
		Если ДанныеЗаполнения.Свойство("ЦенаВключаетНДС") Тогда
			ДанныеЗаполнения.ЦенаВключаетНДС = ДанныеЗаполнения.ЦенаВключаетНДС;
		КонецЕсли;	
		Если ДанныеЗаполнения.Свойство("Валюта") Тогда
			ДокументОбъект.ВалютаДокумента = ДанныеЗаполнения.Валюта;
		КонецЕсли;
		Если ДанныеЗаполнения.Свойство("НазначениеПлатежа") Тогда
			ДокументОбъект.НазначениеПлатежа = ДанныеЗаполнения.НазначениеПлатежа;
		КонецЕсли;
		
		ПерезаполнениеЗначенийРеквизитовШапки(ДокументОбъект, ДанныеЗаполнения);
		
		ДокументОбъект.ОбменДанными.Загрузка = Истина;
		ДокументОбъект.ДополнительныеСвойства.Вставить("ЕстьСоглашение", Истина);
		ДокументОбъект.ДополнительныеСвойства.Вставить("ПроцессыОбработкиДокументов_ЗаписатьБезПроверкиОбменДаннымиЗагрузка", Истина);
		Если Записывать ТОгда
			Если НЕ ЗначениеЗаполнено(ДокументОбъект.Номер) Тогда
				ДокументОбъект.УстановитьНовыйНомер();
			КонецЕсли;
			ДокументОбъект.Записать(РежимЗаписи);
			ВозвращаемоеЗначение = ДокументОбъект.Ссылка;
		Иначе // если функция вызвана из формы "Обработки.ЭлектронныеДокументы.ФормаЗагрузкиПросмотраЭД"
			ВозвращаемоеЗначение = ДокументОбъект;
		КонецЕсли;
	Исключение
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Заполнение документа на основе ЭД. %1'"), Текст);
		ЗаписьЖурналаРегистрации(ТекстСообщения, УровеньЖурналаРегистрации.Ошибка, ДокументОбъект.Метаданные(), СсылкаНаВладельца,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение(Текст);
	КонецПопытки;

	Если ЗначениеЗаполнено(ПараметрыДляОтраженияВУчете) Тогда
		ЗаписатьПрисоединенныеФайлыКДокументуЧерезСервисShare(ДокументОбъект.Ссылка, ПараметрыДляОтраженияВУчете);
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

Функция ПодготовитьСтруктуруДляСчетНаОплатуОтПоставщикаОтветНаЗаказ(СтрокаДляЗагрузки, ДеревоРазбора)
	
	ДанныеДляОбъекта = Новый Структура;
	ДанныеЗаполненияШапки = Новый Структура;
	Для Каждого СтрокаРеквизита Из СтрокаДляЗагрузки.Строки Цикл
		Если СтрокаРеквизита.Строки.Количество() = 0 Тогда
			Реквизит = ПолучитьЗначениеРеквизитаДерева(СтрокаРеквизита, СтрокаРеквизита.Реквизит, Истина, ДеревоРазбора);
			Если ЗначениеЗаполнено(Реквизит) Тогда
				ДанныеЗаполненияШапки.Вставить(СтрокаРеквизита.Реквизит, Реквизит);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ДанныеЗаполненияШапки.Вставить("НомерПервичногоДокумента", ПолучитьЗначениеРеквизитаДерева(СтрокаДляЗагрузки, "Номер"));
	ДанныеЗаполненияШапки.Вставить("ДатаПервичногоДокумента",  ПолучитьЗначениеРеквизитаДерева(СтрокаДляЗагрузки, "Дата"));
	ДанныеЗаполненияШапки.Вставить("ВидПервичногоДокумента",  "Счет на оплату по заказу");
	ДанныеЗаполненияШапки.Вставить("НазначениеПлатежа", ПолучитьЗначениеРеквизитаДерева(СтрокаДляЗагрузки, "НазначениеПлатежа"));
	
	ДанныеДляОбъекта.Вставить("Шапка",  ДанныеЗаполненияШапки);
	
	Возврат ДанныеДляОбъекта;
	
КонецФункции

#КонецОбласти

#Область ИнтеграцияСервиса1СНоменклатура

// Параметры:
//  ДанныеСервиса - ТаблицаЗначений - колонки:
//    * Номенклатура                - ОпределяемыйТип.НоменклатураРаботаСНоменклатурой - ссылка на номенклатуру.
//    * Характеристика              - ОпределяемыйТип.ХарактеристикаРаботаСНоменклатурой - ссылка на характеристику.
//    * ИдентификаторНоменклатуры   - Строка - идентификатор номенклатуры.
//    * ИдентификаторХарактеристики - Строка - идентификатор характеристики.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки:
//    * Номенклатура                - ОпределяемыйТип.НоменклатураБЭД - ссылка на номенклатуру.
//    * Характеристика              - ОпределяемыйТип.ХарактеристикаНоменклатурыБЭД - ссылка на характеристику.
//    * ИдентификаторНоменклатуры   - Строка - идентификатор номенклатуры.
//    * ИдентификаторХарактеристики - Строка - идентификатор характеристики.
Функция УточнениеПоискаНоменклатурыСервиса(ДанныеСервиса) Экспорт
	Если ДанныеСервиса = Неопределено Тогда
		Возврат ДанныеСервиса;
	КонецЕсли;
	
	ТекущаяОрганизация = ОбщегоназначенияБГУ.ТекущаяОрганизация();
	
	ОрганизацииЗапроса = Новый Массив;
	ОрганизацииЗапроса.Добавить(Справочники.Организации.ПустаяСсылка());
	ОрганизацииЗапроса.Добавить(ТекущаяОрганизация);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Таб.Номенклатура КАК НоменклатураСервиса,
	               |	Таб.Характеристика КАК Характеристика,
	               |	Таб.ИдентификаторНоменклатуры КАК ИдентификаторНоменклатуры,
	               |	Таб.ИдентификаторХарактеристики КАК ИдентификаторХарактеристики
	               |ПОМЕСТИТЬ ДанныеНоменклатурыСервиса
	               |ИЗ
	               |	&ДанныеСервиса КАК Таб
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	НастройкаСоответствияНоменклатуреСервиса.Номенклатура КАК Номенклатура,
	               |	ВЫРАЗИТЬ(НастройкаСоответствияНоменклатуреСервиса.НоменклатураЕдиногоКаталогаТоваровИУслуг КАК Справочник.ЕдиныйКаталогОписанийТоваровИУслуг).НоменклатураКаталога КАК НоменклатураСервиса
	               |ПОМЕСТИТЬ ДанныеЕдиногоКаталогаНоменклатуры
	               |ИЗ
	               |	РегистрСведений.НастройкаСоответствияНоменклатуреСервиса КАК НастройкаСоответствияНоменклатуреСервиса
	               |ГДЕ
	               |	НастройкаСоответствияНоменклатуреСервиса.Организация В (&ОрганизацииЗапроса)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДанныеЕдиногоКаталогаНоменклатуры.Номенклатура КАК Номенклатура,
	               |	ДанныеНоменклатурыСервиса.Характеристика КАК Характеристика,
	               |	ДанныеНоменклатурыСервиса.ИдентификаторНоменклатуры КАК ИдентификаторНоменклатуры,
	               |	ДанныеНоменклатурыСервиса.ИдентификаторХарактеристики КАК ИдентификаторХарактеристики
	               |ИЗ
	               |	ДанныеНоменклатурыСервиса КАК ДанныеНоменклатурыСервиса
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ДанныеЕдиногоКаталогаНоменклатуры КАК ДанныеЕдиногоКаталогаНоменклатуры
	               |		ПО ДанныеНоменклатурыСервиса.НоменклатураСервиса = ДанныеЕдиногоКаталогаНоменклатуры.НоменклатураСервиса";
	
	Запрос.УстановитьПараметр("ОрганизацииЗапроса", ОрганизацииЗапроса);
	Запрос.УстановитьПараметр("ДанныеСервиса", ДанныеСервиса);
	ДанныеСервиса = Запрос.Выполнить().Выгрузить();
	
	Возврат ДанныеСервиса;
КонецФункции	

#КонецОбласти

#Область РеквизитыМаркировки

// Заполняет представление указанных в документе кодов маркировки в колонке "Маркируемые упаковки" табличной части.
//
// Параметры:
//  ВладелецКоллекции - ДанныеФормыСтруктура - объект документа-владельца формы, либо сама форма.
//     Форма указывается в том случае, если таблица-коллекция является реквизитом формы, а не объекта.
//  ИмяКоллекции      - Строка - имя табличной части, в которой заполняется реквизит "МаркируемыеУпаковки".
//     Таблица должна содержать колонки: "НомерСтроки, ИдентификаторСтроки, МаркируемыеУпаковки". 
//
Процедура ЗаполнитьРеквизитыМаркировки(ВладелецКоллекции, ИмяКоллекции = "Номенклатура") Экспорт
	
	КоллекцияДанных = ВладелецКоллекции[ИмяКоллекции];
	
	Для Каждого СтрокаКоллекции Из КоллекцияДанных Цикл
		Если ИмяКоллекции = "СоставНФА" Тогда
			ИмяПоляНоменклатура = "НФА";
		ИначеЕсли ИмяКоллекции = "ОсновныеСредства" Тогда
			ИмяПоляНоменклатура = "ОсновноеСредство";
		ИначеЕсли ИмяКоллекции = "Номенклатура" ИЛИ ИмяКоллекции = "Материалы" Тогда
			ИмяПоляНоменклатура = "Номенклатура";
			СтрокаКоллекции.МаркируемыйТоварОбъемноСортовогоУчета = ЭлектронныеДокументыБГУВызовСервера.ЭтоМаркируемыйТоварОбъемноСортовогоУчета(СтрокаКоллекции[ИмяПоляНоменклатура]);
		КонецЕсли;	
			
		СтрокаКоллекции.МаркируемыйТовар = ЭлектронныеДокументыБГУВызовСервера.ЭтоМаркируемыйТовар(СтрокаКоллекции[ИмяПоляНоменклатура]);
		
		Если ЗначениеЗаполнено(СтрокаКоллекции.ИдентификаторСтроки) Тогда
			ПараметрыОтбораУпаковок = Новый Структура("ИдентификаторСтроки", СтрокаКоллекции.ИдентификаторСтроки);
			
			КодыУпаковок = ВладелецКоллекции.КодыУпаковокМаркируемойПродукции.Выгрузить(ПараметрыОтбораУпаковок, "НомерУпаковки").ВыгрузитьКолонку("НомерУпаковки");
			
			СтрокаКоллекции.КодыУпаковокМаркируемойПродукции.ЗагрузитьЗначения(КодыУпаковок);
			
			СтрокаКоллекции.МаркируемыеУпаковки = ЭлектронныеДокументыБГУКлиентСервер.ПредставлениеКодовМаркировки(КодыУпаковок);
			
			ТипыУпаковок = ВладелецКоллекции.КодыУпаковокМаркируемойПродукции.Выгрузить(ПараметрыОтбораУпаковок, "ТипУпаковки").ВыгрузитьКолонку("ТипУпаковки");
			
			СтрокаКоллекции.ТипыУпаковокМаркируемойПродукции.ЗагрузитьЗначения(ТипыУпаковок);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Кэширует значения колонок "НомерСтроки, МаркируемыеУпаковки" из коллекции данных.
//
// Параметры:
//  КоллекцияДанных - ДанныеФормыКоллекция, ТаблицаЗначений - Таблица, из которой кэшируются значения колонок.
//  Кэш - Структура - объект, в котором кэшируются данные.
//
Процедура КэшироватьРеквизитыМаркировки(КоллекцияДанных, Кэш) Экспорт
	
	РеквизитыМаркировки = КоллекцияДанных.Выгрузить(, КэшируемыеРеквизитыМаркировки());
	Кэш.Вставить("РеквизитыМаркировки", РеквизитыМаркировки);
	
КонецПроцедуры

// Восстанавливает из кэша значения колонок "НомерСтроки, МаркируемыеУпаковки" в коллекцию данных.
//
// Параметры:
//  КоллекцияДанных - ДанныеФормыКоллекция, ТаблицаЗначений - таблица, из которой кэшируются значения колонок.
//  Кэш - Структура - объект, в котором кэшируются данные.
//
Процедура ВосстановитьРеквизитыМаркировки(КоллекцияДанных, Кэш) Экспорт
	
	КэшируемыеРеквизиты = КэшируемыеРеквизитыМаркировки();
	
	РеквизитыМаркировки = Неопределено;
	Если Кэш.Свойство("РеквизитыМаркировки", РеквизитыМаркировки) Тогда
		Для Каждого СтрокаКоллекции Из КоллекцияДанных Цикл
			СтрокаКэша = РеквизитыМаркировки[СтрокаКоллекции.НомерСтроки-1];
			
			ЗаполнитьЗначенияСвойств(СтрокаКоллекции, СтрокаКэша, КэшируемыеРеквизиты);
		КонецЦикла;
		Кэш.Удалить("РеквизитыМаркировки");
	КонецЕсли;
	
КонецПроцедуры

// Сохраняет данные по маркировке в документе, извлекая их из данных формы.
//
// Параметры:
//  КоллекцияДанных		 - ДанныеФормыКоллекция, ТаблицаЗначений - таблица, из которой будут получены данные по маркировке.
//  ЗаписываемыйОбъект	 - ДокументОбъект - объект документа, в котором хранятся сведения по маркировке.
//
Процедура СохранитьКодыМаркировки(КоллекцияДанных, ЗаписываемыйОбъект) Экспорт
	
	НовыеКодыУпаковок = ТаблицаКодовМаркировкиПоТаблицеТоваров(КоллекцияДанных, ЗаписываемыйОбъект,
		"КодыУпаковокМаркируемойПродукции", "ТипыУпаковокМаркируемойПродукции");
	ОбновитьКодыМаркировкиВОбъекте(НовыеКодыУпаковок, ЗаписываемыйОбъект,
		"КодыУпаковокМаркируемойПродукции");

КонецПроцедуры

// Заполняет идентификаторы строк товаров перед записью объекта документа.
//
// Параметры:
//  Объект					 - ДокументОбъект - объект документа, в котором хранятся сведения по маркировке.
//  ТаблицыСИдентификаторами - Строка - имена таблиц, хранящих идентификаторы строк, перечисленные через запятую.
//
Процедура ИдентификаторыСтрокПередЗаписьюОбъекта(Объект, ТаблицыСИдентификаторами = "Товары") Экспорт
	
	ИменаТаблиц = СтрРазделить(ТаблицыСИдентификаторами, ",");
	ПараметрыПоиска = Новый Структура("ИдентификаторСтроки", "");
	
	Для Каждого ИмяТаблицы Из ИменаТаблиц Цикл
		Таблица = Объект[ИмяТаблицы];
		
		СтрокиСПустымиИдентификаторами = Таблица.НайтиСтроки(ПараметрыПоиска);
		Для Каждого СтрокаТаблицы Из СтрокиСПустымиИдентификаторами Цикл
			ЭлектронныеДокументыБГУКлиентСервер.ЗаполнитьИдентификаторСтроки(СтрокаТаблицы);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Функция ТаблицаКодовМаркировкиПоТаблицеТоваров(КоллекцияДанных, Объект, ИмяТаблицыКодов, ИмяТаблицыТипов)
	
	ТаблицаКодов = Объект[ИмяТаблицыКодов].Выгрузить();
	ТаблицаКодов.Очистить();
	
	Если ИмяТаблицыКодов = "КодыУпаковокМаркируемойПродукцииПоДокументам" Тогда
		ИмяТаблицыКодов = "КодыУпаковокМаркируемойПродукции";
	КонецЕсли;	
	
	Для Каждого СтрокаКоллекции Из КоллекцияДанных Цикл
		НомерСтроки = 1;
				Для Каждого ЭлементСписка Из СтрокаКоллекции[ИмяТаблицыКодов] Цикл
			НоваяСтрока = ТаблицаКодов.Добавить();
			НоваяСтрока.ИдентификаторСтроки = СтрокаКоллекции.ИдентификаторСтроки;
			НоваяСтрока.НомерУпаковки       = ЭлементСписка.Значение;
			НоваяСтрока.ТипУпаковки 		= СтрокаКоллекции[ИмяТаблицыТипов][НомерСтроки-1];
			НоваяСтрока.НомерСтроки         = НомерСтроки;
			
			НомерСтроки = НомерСтроки + 1;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ТаблицаКодов;

КонецФункции

Функция КэшируемыеРеквизитыМаркировки()

	Возврат "МаркируемыеУпаковки, МаркируемыйТовар, КодыУпаковокМаркируемойПродукции, ТипыУпаковокМаркируемойПродукции";

КонецФункции

Процедура ОбновитьКодыМаркировкиВОбъекте(ТаблицаАктуальныхКодов, Объект, ИмяТаблицыКодов)
	
	Объект.КодыУпаковокМаркируемойПродукции.Загрузить(ТаблицаАктуальныхКодов);

КонецПроцедуры

// Заполняет в таблице товаров сведения по маркировке.
//
// Параметры:
//  СтрокаТовара			- СтрокаТаблицыЗначений - строка выгруженной таблицы документа. Должна обязательно содержать колонки:
//                             * НомерСтрокиИсходногоДокумента - Число - номер строки таблицы товаров документа, для которого заполняются данные.
//                             * СведенияОМаркировке - Произвольный - в данную колонку будет записана структура сведений по маркировке.
//  ТаблицаКодовДокумента	- ТаблицаЗначений - содержит сведения об упаковках. Должна обязательно содержать колонки:
//                             * ИдентификаторСтроки - Строка - идентификатор строки.
//                             * НомерУпаковки - Строка - код маркировки.
//  Документ				- ДокументСсылка - ссылка на документ, для которого заполняются данные.
//
Процедура ЗаполнитьРеквизитыМаркировкиВСтрокеТоваров_2019(СтрокаТовара, ТаблицаКодовДокумента, Документ, НаименованиеТЧ = "Номенклатура", СведенияОбъемноСортовогоУчетаМаркированныхТоваров)

	Если НаименованиеТЧ = "СоставНФА" Тогда
		ПутьКДаннымДляОшибки = СтрШаблон("Объект.СоставНФА[%1].МаркируемыеУпаковки", СтрокаТовара.НомерСтроки - 1);
	Иначе	
		ПутьКДаннымДляОшибки = СтрШаблон("Объект.Номенклатура[%1].МаркируемыеУпаковки", СтрокаТовара.НомерСтроки - 1);
	КонецЕсли;
	
	ТаблицаКодов = Новый ТаблицаЗначений;
	ТаблицаКодов.Колонки.Добавить("Код");
	
	ТаблицаКодовИндивидуальнойУпаковки = Новый ТаблицаЗначений;
	ТаблицаКодовИндивидуальнойУпаковки.Колонки.Добавить("Код");
	
	ТаблицаКодовТранспортнойУпаковки = Новый ТаблицаЗначений;
	ТаблицаКодовТранспортнойУпаковки.Колонки.Добавить("Код");
	
	СведенияОМаркировке = Новый Структура;
	СведенияОМаркировке.Вставить("ИндивидуальныеУпаковки", ТаблицаКодовИндивидуальнойУпаковки);
	СведенияОМаркировке.Вставить("ТранспортныеУпаковки", ТаблицаКодовТранспортнойУпаковки);
	СтрокаТовара.СведенияОМаркировке = СведенияОМаркировке;
	
	ПараметрыПоиска = Новый Структура("ИдентификаторСтроки", СтрокаТовара.ИдентификаторСтроки);
	
	СтрокиУпаковок = ТаблицаКодовДокумента.НайтиСтроки(ПараметрыПоиска);
	Для Каждого СтрокаУпаковки Из СтрокиУпаковок Цикл
		Если СтрокаУпаковки.ТипУпаковки = НСтр("ru = 'Транспортная упаковка'") Тогда
			НоваяСтрока = ТаблицаКодовТранспортнойУпаковки.Добавить();
			НоваяСтрока.Код = СокрЛП(СтрокаУпаковки.НомерУпаковки);
		Иначе	
			НоваяСтрока = ТаблицаКодовИндивидуальнойУпаковки.Добавить();
			НоваяСтрока.Код = СокрЛП(СтрокаУпаковки.НомерУпаковки);
		КонецЕсли;	
		НоваяСтрока = ТаблицаКодов.Добавить();
		НоваяСтрока.Код = СокрЛП(СтрокаУпаковки.НомерУпаковки);
	КонецЦикла;
	
	Если (СтрокиУпаковок.Количество() = 0) И ЗначениеЗаполнено(СведенияОбъемноСортовогоУчетаМаркированныхТоваров) Тогда
		ДанныеОбъемноСортовогоУчетаДляУПД = СтрЗаменить(СведенияОбъемноСортовогоУчетаМаркированныхТоваров,")","");
		ДанныеОбъемноСортовогоУчетаДляУПД = СтрЗаменить(ДанныеОбъемноСортовогоУчетаДляУПД,"(","");
		
		НоваяСтрока = ТаблицаКодовИндивидуальнойУпаковки.Добавить();
		НоваяСтрока.Код = СокрЛП(ДанныеОбъемноСортовогоУчетаДляУПД);

		НоваяСтрока = ТаблицаКодов.Добавить();
		НоваяСтрока.Код = СокрЛП(ДанныеОбъемноСортовогоУчетаДляУПД);
	КонецЕсли;	
	
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаКодов,
		"Код", Документ, ПутьКДаннымДляОшибки);
	
КонецПроцедуры

Процедура ЗаполнитьРеквизитыМаркировкиВСтрокеТоваровАктаОРасхождениях_2020(ТекущаяСтрокаТоваров, СтрокаТовара, ТаблицаКодовДокумента, Документ, НаименованиеМаркируемыеУпаковки = "ПоДокументу")
	ТаблицаКодов = Новый ТаблицаЗначений;
	ТаблицаКодов.Колонки.Добавить("Код");
	
	ТаблицаКодовИндивидуальнойУпаковки = Новый ТаблицаЗначений;
	ТаблицаКодовИндивидуальнойУпаковки.Колонки.Добавить("Код");
	
	ТаблицаКодовТранспортнойУпаковки = Новый ТаблицаЗначений;
	ТаблицаКодовТранспортнойУпаковки.Колонки.Добавить("Код");
	
	Если ЗначениеЗаполнено(ТекущаяСтрокаТоваров.ИдентификаторСтроки) Тогда
		ПараметрыПоиска = Новый Структура("ИдентификаторСтроки", ТекущаяСтрокаТоваров.ИдентификаторСтроки);
		
		СтрокиУпаковок = ТаблицаКодовДокумента.НайтиСтроки(ПараметрыПоиска);
		Для Каждого СтрокаУпаковки Из СтрокиУпаковок Цикл
			Если СтрокаУпаковки.ТипУпаковки = НСтр("ru = 'Транспортная упаковка'") Тогда
				НоваяСтрока = ТаблицаКодовТранспортнойУпаковки.Добавить();
				НоваяСтрока.Код = СокрЛП(СтрокаУпаковки.НомерУпаковки);
			Иначе	
				НоваяСтрока = ТаблицаКодовИндивидуальнойУпаковки.Добавить();
				НоваяСтрока.Код = СокрЛП(СтрокаУпаковки.НомерУпаковки);
			КонецЕсли;	
			НоваяСтрока = ТаблицаКодов.Добавить();
			НоваяСтрока.Код = СокрЛП(СтрокаУпаковки.НомерУпаковки);
		КонецЦикла;
		
		СведенияОМаркировке = Новый Структура;
		СведенияОМаркировке.Вставить("ИндивидуальныеУпаковки", ТаблицаКодовИндивидуальнойУпаковки);
		СведенияОМаркировке.Вставить("ТранспортныеУпаковки", ТаблицаКодовТранспортнойУпаковки);
		
		Если НаименованиеМаркируемыеУпаковки = "ПоДокументу" Тогда
			ПутьКДаннымДляОшибки = СтрШаблон("Объект.СписокНоменклатуры[%1].МаркируемыеУпаковки", ТекущаяСтрокаТоваров.НомерСтроки - 1);
			СтрокаТовара.ПоДокументу.Вставить("Маркировка", Новый ОписаниеТипов("Структура"));
			СтрокаТовара.ПоДокументу.Маркировка = СведенияОМаркировке;
		ИначеЕсли НаименованиеМаркируемыеУпаковки = "ПоФакту" Тогда
			ПутьКДаннымДляОшибки = СтрШаблон("Объект.СписокНоменклатуры[%1].МаркируемыеУпаковкиПоФакту", ТекущаяСтрокаТоваров.НомерСтроки - 1);
			СтрокаТовара.ПоФакту.Вставить("Маркировка", Новый ОписаниеТипов("Структура"));
			СтрокаТовара.ПоФакту.Маркировка = СведенияОМаркировке;
		ИначеЕсли НаименованиеМаркируемыеУпаковки = "Брак" Тогда
			ПутьКДаннымДляОшибки = СтрШаблон("Объект.СписокНоменклатуры[%1].МаркируемыеУпаковкиБрак", ТекущаяСтрокаТоваров.НомерСтроки - 1);
			СтрокаТовара.Брак.Вставить("Маркировка", Новый ОписаниеТипов("Структура"));
			СтрокаТовара.Брак.Маркировка = СведенияОМаркировке;
		ИначеЕсли НаименованиеМаркируемыеУпаковки = "Бой" Тогда
			ПутьКДаннымДляОшибки = СтрШаблон("Объект.СписокНоменклатуры[%1].МаркируемыеУпаковкиБой", ТекущаяСтрокаТоваров.НомерСтроки - 1);
			СтрокаТовара.Бой.Вставить("Маркировка", Новый ОписаниеТипов("Структура"));
			СтрокаТовара.Бой.Маркировка = СведенияОМаркировке;
		ИначеЕсли НаименованиеМаркируемыеУпаковки = "Недостача" Тогда
			ПутьКДаннымДляОшибки = СтрШаблон("Объект.СписокНоменклатуры[%1].МаркируемыеУпаковкиНедостача", ТекущаяСтрокаТоваров.НомерСтроки - 1);
			СтрокаТовара.Недостача.Вставить("Маркировка", Новый ОписаниеТипов("Структура"));
			СтрокаТовара.Недостача.Маркировка = СведенияОМаркировке;
		ИначеЕсли НаименованиеМаркируемыеУпаковки = "Излишки" Тогда
			ПутьКДаннымДляОшибки = СтрШаблон("Объект.СписокНоменклатуры[%1].МаркируемыеУпаковкиИзлишки", ТекущаяСтрокаТоваров.НомерСтроки - 1);
			СтрокаТовара.Излишки.Вставить("Маркировка", Новый ОписаниеТипов("Структура"));
			СтрокаТовара.Излишки.Маркировка = СведенияОМаркировке;
		Иначе	
			ПутьКДаннымДляОшибки = СтрШаблон("Объект.СписокНоменклатуры[%1].МаркируемыеУпаковки", ТекущаяСтрокаТоваров.НомерСтроки - 1);
			СтрокаТовара.ПоДокументу.Вставить("Маркировка", Новый ОписаниеТипов("Структура"));
			СтрокаТовара.ПоДокументу.Маркировка = СведенияОМаркировке;
		КонецЕсли;
		
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаКодов, "Код", Документ, ПутьКДаннымДляОшибки);
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьЗаполнениеДанныхМаркировкиВТаблицеМатериалов(Объект, ИмяТаблицы, ПредставлениеТаблицы, НаименованиеПоляНоменклатуры, Результат) Экспорт
	Результат = Истина;
	Отказ = Ложь;

	Если НЕ ЭлектронныеДокументыБГУ.ИспользованиеМаркировки(Объект.Организация) Тогда
		Возврат;
	КонецЕсли;	
	
	Если ЭлектронныеДокументыБГУ.ИспользованиеОбъемноСортовойУчетМаркированныхТоваров(Объект.Организация) Тогда
		Возврат;
	КонецЕсли;	
	
	ТекстСообщения = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(НСтр("ru = 'Не заполнены коды маркировки в строке %1 списка ""[ПредставлениеТаблицы]""'"),
																			Новый Структура("ПредставлениеТаблицы", ПредставлениеТаблицы));
	ТекстСообщенияОНоменклатуре = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(НСтр("ru = 'Заполнены коды маркировки, но не указан вид маркировки в реквизите ""Вид контроля продукции"" 
																			|у номенклатуры строки %1 списка ""[ПредставлениеТаблицы]""'"),
																			Новый Структура("ПредставлениеТаблицы", ПредставлениеТаблицы));
	Для каждого ТекСтрока Из Объект[ИмяТаблицы] Цикл
		
		Номенклатура = ТекСтрока[НаименованиеПоляНоменклатуры];
		
		Если ТипЗнч(Номенклатура) <> Тип("СправочникСсылка.Номенклатура") И ТипЗнч(Номенклатура) <> Тип("СправочникСсылка.ОсновныеСредства") Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Номенклатура) Тогда
			ПараметрыПоиска = Новый Структура("ИдентификаторСтроки", ТекСтрока.ИдентификаторСтроки);
				
			СтрокиУпаковок = Объект["КодыУпаковокМаркируемойПродукции"].НайтиСтроки(ПараметрыПоиска);
			Если ЗначениеЗаполнено(Номенклатура.ВидМаркируемойПродукции) Тогда
				Если СтрокиУпаковок.Количество() = 0 Тогда
					Результат = Ложь;
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
																								ТекстСообщения, ТекСтрока.НомерСтроки),
																		,"Объект." + ИмяТаблицы + "[" + (ТекСтрока.НомерСтроки - 1) + "].МаркируемыеУпаковки",
																		,Отказ);
				КонецЕсли;
			Иначе
				Если СтрокиУпаковок.Количество() > 0 Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
																								ТекстСообщенияОНоменклатуре, ТекСтрока.НомерСтроки),
																		,"Объект." + ИмяТаблицы + "[" + (ТекСтрока.НомерСтроки - 1) + СтрЗаменить("].Номенклатура", "Номенклатура", НаименованиеПоляНоменклатуры),
																		,Отказ);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	
	КонецЦикла; 
КонецПроцедуры

Функция ПолучитьМаркируемыеТовары(СписокНоменклатуры) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Номенклатура.Ссылка КАК Номенклатура
	               |ИЗ
	               |	Справочник.Номенклатура КАК Номенклатура
	               |ГДЕ
	               |	Номенклатура.Ссылка В(&Номенклатура)
	               |	И НЕ Номенклатура.ВидМаркируемойПродукции = ЗНАЧЕНИЕ(Перечисление.ВидыМаркируемойПродукции.ПустаяСсылка)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ОсновныеСредства.Ссылка
	               |ИЗ
	               |	Справочник.ОсновныеСредства КАК ОсновныеСредства
	               |ГДЕ
	               |	ОсновныеСредства.Ссылка В (&Номенклатура)
	               |	И НЕ ОсновныеСредства.ВидМаркируемойПродукции = ЗНАЧЕНИЕ(Перечисление.ВидыМаркируемойПродукции.ПустаяСсылка)";
	Запрос.УстановитьПараметр("Номенклатура", СписокНоменклатуры);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Возврат РезультатЗапроса;
	
КонецФункции

Функция ВидыМаркировкиОбъемноСортовогоУчета() Экспорт
	
	ВидыМаркировкиОбъемноСортовогоУчета = Новый Массив;
	ВидыМаркировкиОбъемноСортовогоУчета.Добавить(Перечисления.ВидыМаркируемойПродукции.МолочнаяПродукция);
	ВидыМаркировкиОбъемноСортовогоУчета.Добавить(Перечисления.ВидыМаркируемойПродукции.УпакованнаяВода);

	Возврат ВидыМаркировкиОбъемноСортовогоУчета;
	
КонецФункции	

Функция ПолучитьМаркируемыеТоварыОбъемноСортовогоУчета(СписокНоменклатуры) Экспорт 
	
	ВидыМаркировкиОбъемноСортовогоУчета = ВидыМаркировкиОбъемноСортовогоУчета();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Номенклатура.Ссылка КАК Номенклатура
	               |ИЗ
	               |	Справочник.Номенклатура КАК Номенклатура
	               |ГДЕ
	               |	Номенклатура.Ссылка В(&Номенклатура)
	               |	И Номенклатура.ВидМаркируемойПродукции В (&ВидыМаркировкиОбъемноСортовогоУчета)";
	Запрос.УстановитьПараметр("Номенклатура", СписокНоменклатуры);
	Запрос.УстановитьПараметр("ВидыМаркировкиОбъемноСортовогоУчета", ВидыМаркировкиОбъемноСортовогоУчета);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Возврат РезультатЗапроса;
	
КонецФункции

Процедура ДобавитьУсловноеОформление_КолонкаМаркируемыйТовар(Форма, ИмяЭлементаТаблица = "Номенклатура", ИспользуетсявМаркировкаОбъемноСортовогоУчета = Ложь) Экспорт
	
	УсловноеОформление = Форма.УсловноеОформление;
	
	//---
	// 1. Немаркируемый товар - надпись "Не используется"
	//---
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = "Немаркируемый товар - надпись ""Не используется""";
	
	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект." + ИмяЭлементаТаблица + ".МаркируемыйТовар");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Ложь;
	
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект." + ИмяЭлементаТаблица + ".МаркируемыеУпаковки");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "Не используется");
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяЭлементаТаблица + "МаркируемыеУпаковки");
	
	
	//---
	// 2. Немаркируемый товар, но указаны маркировки - выделение маркировок цветом
	//---
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = "Немаркируемый товар, но указаны маркировки - выделение маркировок цветом";
	
	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект." + ИмяЭлементаТаблица + ".МаркируемыйТовар");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Ложь;
	
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект." + ИмяЭлементаТаблица + ".МаркируемыеУпаковки");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ПоясняющийПроблемуТекст);
	
	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяЭлементаТаблица + "МаркируемыеУпаковки");
	
	
	//---
	// 3. Маркируемый товар, не указаны маркировки - надпись <...>
	//---
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = "Маркируемый товар, не указаны маркировки - надпись <...>";
	
	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект." + ИмяЭлементаТаблица + ".МаркируемыйТовар");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Истина;
	
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект." + ИмяЭлементаТаблица + ".МаркируемыеУпаковки");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	// Оформление
	Если НЕ ИспользуетсявМаркировкаОбъемноСортовогоУчета Тогда
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ПоясняющийПроблемуТекст);
	КонецЕсли;
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "<...>");
	
	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяЭлементаТаблица + "МаркируемыеУпаковки");
	
КонецПроцедуры

Функция ОпределитьВидимостьЭлементовМаркировки(ДокументОбъект) Экспорт
	
	ВидимостьЭлементовМаркировки = ЭлектронныеДокументыБГУ.ИспользованиеМаркировки(ДокументОбъект.Организация);
	
	Если ДокументОбъект.КодыУпаковокМаркируемойПродукции.Количество() > 0 Тогда
		ВидимостьЭлементовМаркировки = Истина;
	КонецЕсли;
	
	Возврат ВидимостьЭлементовМаркировки;
	
КонецФункции

Процедура ИнициализироватьФормуМаркировкаУпаковки(Форма, ИмяРеквизитаТаблица, ВставитьКолонкуПередЭлементом, СтраницаМаркируемаяУпаковка) Экспорт
	
	// Инициализация формы заключается в добавлении новых реквизитов формы и элементов формы.
	
	ИмяПроверяемогоРеквизита = "КодыУпаковокМаркируемойПродукции";
	
	КоллекцияРеквизитов = Форма.ПолучитьРеквизиты();
	
	Для Каждого Реквизит Из КоллекцияРеквизитов Цикл
		Если Реквизит.Имя = ИмяПроверяемогоРеквизита Тогда
			// Инициализация уже выполнена ранее
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	ДобавитьРеквизитыФормыМаркировкаУпаковки(Форма, ИмяРеквизитаТаблица);
	
	ДобавитьЭлементыФормыМаркировкаУпаковки(Форма, ИмяРеквизитаТаблица, ВставитьКолонкуПередЭлементом, СтраницаМаркируемаяУпаковка);
	
КонецПроцедуры

Процедура ДобавитьРеквизитыФормыМаркировкаУпаковки(Форма, ИмяРеквизитаТаблица)
	
	ТипСтрока255 = Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(255));
	ТипСтрока36 = Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(36));
	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипБулево = Новый ОписаниеТипов("Булево");
	ТипСписокЗначений = Новый ОписаниеТипов("СписокЗначений");
	
	ДобавляемыеРеквизиты = Новый Массив();
	
	// 1) КодыУпаковокМаркируемойПродукции	(таблица значений)
	//		НомерУпаковки		(строка 255)
	//		ИдентификаторСтроки	(строка 36)
	//		ТипУпаковки			(строка 255)
	
	ИмяНовойТаблицы = "КодыУпаковокМаркируемойПродукции";
	НовыйРеквизит = Новый РеквизитФормы(ИмяНовойТаблицы, Новый ОписаниеТипов("ТаблицаЗначений"));
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	
	НовыйРеквизит = Новый РеквизитФормы("НомерУпаковки", ТипСтрока255, ИмяНовойТаблицы);
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	
	НовыйРеквизит = Новый РеквизитФормы("ИдентификаторСтроки", ТипСтрока36, ИмяНовойТаблицы);
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	
	НовыйРеквизит = Новый РеквизитФормы("ТипУпаковки", ТипСтрока255, ИмяНовойТаблицы);
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	
	// 2) Объект.<Таблица>.МаркируемыеУпаковки	(строка)
	//	ВЫВОДИТСЯ НА ФОРМУ
	
	НовыйРеквизит = Новый РеквизитФормы("МаркируемыеУпаковки", ТипСтрока, "Объект." + ИмяРеквизитаТаблица);
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	
	//3) Объект.<Таблица>.МаркируемыйТовар (булево)

	НовыйРеквизит = Новый РеквизитФормы("МаркируемыйТовар", ТипБулево, "Объект." + ИмяРеквизитаТаблица);
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	
	//4) Объект.<Таблица>.КодыУпаковокМаркируемойПродукции (список значений)

	НовыйРеквизит = Новый РеквизитФормы("КодыУпаковокМаркируемойПродукции", ТипСписокЗначений, "Объект." + ИмяРеквизитаТаблица);
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	
	//5) Объект.<Таблица>.ТипыУпаковокМаркируемойПродукции (список значений)
	
	НовыйРеквизит = Новый РеквизитФормы("ТипыУпаковокМаркируемойПродукции", ТипСписокЗначений, "Объект." + ИмяРеквизитаТаблица);
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	
	Форма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
КонецПроцедуры

Процедура ДобавитьЭлементыФормыМаркировкаУпаковки(Форма, ИмяРеквизитаТаблица, ВставитьКолонкуПередЭлементом, СтраницаМаркируемаяУпаковка)
	
	// 1) Колонка <Таблица>МаркируемыеУпаковки
	
	НовыйЭлемент = Форма.Элементы.Вставить(
		ИмяРеквизитаТаблица + "МаркируемыеУпаковки",
		Тип("ПолеФормы"),
		Форма.Элементы[ИмяРеквизитаТаблица],
		Форма.Элементы[ВставитьКолонкуПередЭлементом]);
		
	НовыйЭлемент.Вид					= ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.Заголовок				= "Маркируемые упаковки";
	НовыйЭлемент.ПутьКДанным			= "Объект." + ИмяРеквизитаТаблица + ".МаркируемыеУпаковки";
	НовыйЭлемент.КнопкаВыбора 			= Истина;
	НовыйЭлемент.ЦветТекста				= ЦветаСтиля.ГиперссылкаЦвет;
	НовыйЭлемент.ГиперссылкаЯчейки		= Истина;
	НовыйЭлемент.ПропускатьПриВводе		= Истина;
	НовыйЭлемент.РедактированиеТекста	= Ложь;
	
	// Обработчики событий
	НовыйЭлемент.УстановитьДействие("НачалоВыбора", "Подключаемый_КолонкаМаркируемыеУпаковки_НачалоВыбора");
	
	// 2) Страница <СтраницаМаркируемаяУпаковка>
	ЭлементСтраницы = Форма.Элементы[СтраницаМаркируемаяУпаковка];
	ЭлементСтраницы.Заголовок = НСтр("ru='Маркируемые упаковки'");
	ЭлементСтраницы.ПутьКДаннымЗаголовка = "Объект.КодыУпаковокМаркируемойПродукции.КоличествоСтрок";
	ЭлементСтраницы.Подсказка = "";
	
	// 3) Таблица КодыУпаковокМаркируемойПродукции
	ИмяТаблицыМаркируемыеУпаковки = "КодыУпаковокМаркируемойПродукции";
	
	НовыйЭлементТаблица = Форма.Элементы.Добавить(
		ИмяТаблицыМаркируемыеУпаковки,
		Тип("ТаблицаФормы"),
		ЭлементСтраницы);
		
	НовыйЭлементТаблица.ПутьКДанным = "Объект.КодыУпаковокМаркируемойПродукции";
	НовыйЭлементТаблица.ТолькоПросмотр = Истина;
	НовыйЭлементТаблица.РасширеннаяПодсказка.Заголовок = НСтр("ru='Заполняется автоматически при записи документа на основании сведений из табличной части Товаров, работ, услуг'");
	НовыйЭлементТаблица.РасширеннаяПодсказка.АвтоМаксимальнаяШирина = Ложь;
	НовыйЭлементТаблица.ОтображениеПодсказки = ОтображениеПодсказки.ОтображатьСверху;
	НовыйЭлементТаблица.КоманднаяПанель.Видимость = Ложь;
	
	НовыйЭлемент = Форма.Элементы.Добавить(
		ИмяТаблицыМаркируемыеУпаковки + "НомерСтроки",
		Тип("ПолеФормы"),
		НовыйЭлементТаблица);
	НовыйЭлемент.Вид			= ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным	= "Объект.КодыУпаковокМаркируемойПродукции.НомерСтроки";
	НовыйЭлемент.Ширина			= 4;
	
	НовыйЭлемент = Форма.Элементы.Добавить(
		ИмяТаблицыМаркируемыеУпаковки + "НомерУпаковки",
		Тип("ПолеФормы"),
		НовыйЭлементТаблица);
	НовыйЭлемент.Вид			= ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным	= "Объект.КодыУпаковокМаркируемойПродукции.НомерУпаковки";
	НовыйЭлемент.Ширина			= 10;
	
	НовыйЭлемент = Форма.Элементы.Добавить(
		ИмяТаблицыМаркируемыеУпаковки + "ТипУпаковки",
		Тип("ПолеФормы"),
		НовыйЭлементТаблица);
	НовыйЭлемент.Вид			= ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным	= "Объект.КодыУпаковокМаркируемойПродукции.ТипУпаковки";
	НовыйЭлемент.Ширина			= 10;
	
	НовыйЭлемент = Форма.Элементы.Добавить(
		ИмяТаблицыМаркируемыеУпаковки + "ИдентификаторСтроки",
		Тип("ПолеФормы"),
		НовыйЭлементТаблица);
	НовыйЭлемент.Вид			= ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.ПутьКДанным	= "Объект.КодыУпаковокМаркируемойПродукции.ИдентификаторСтроки";
	НовыйЭлемент.Ширина			= 20;
	
КонецПроцедуры

// Заполняет коды маркировки в документе из дерева электронного документа.
//
// Параметры:
//  ДокументОбъект				 - ДокументОбъект - объект заполняемого документа.
//  СтрокаТоваров				 - СтрокаТабличнойЧасти - строка таблицы товаров документа.
//  СтрокаТоваровДерева			 - СтрокаДереваЗначений - строка товаров дерева электронного документа.
//  ЭтоИндивидуальныеУпаковки	 - Булево - Истина, если нужно заполнить индивидуальные упаковки,
//                                          Ложь, если нужно заполнить транспортные упаковки.
//
Процедура ЗаполнитьКодыМаркировкиИзДереваЭлектронногоДокумента(ДокументОбъект, СтрокаТоваров, СтрокаТоваровДерева)
	
	ИмяТаблицыУпаковокДерева = "ИндивидуальныеУпаковки";
	ТаблицаДокумента = ДокументОбъект.КодыУпаковокМаркируемойПродукции;
	
	КодыУпаковок = СтрокаТоваровДерева.Строки.Найти(
		"СведенияОТоварах.НомерСтроки.СведенияОМаркировке." + ИмяТаблицыУпаковокДерева, "ПолныйПуть", Истина);
	Если КодыУпаковок <> Неопределено И ЗначениеЗаполнено(КодыУпаковок.Значение) Тогда
		Для Каждого СтрокаКодаУпаковки Из КодыУпаковок.Строки Цикл
			СтрокаНовойУпаковки = ТаблицаДокумента.Добавить();
			СтрокаНовойУпаковки.ИдентификаторСтроки = СтрокаТоваров.ИдентификаторСтроки;
			
			ПутьКНомеруУпаковки = СтрШаблон("СведенияОТоварах.НомерСтроки.СведенияОМаркировке.%1.НомерСтроки.Код",
				ИмяТаблицыУпаковокДерева);
			СтрокаНовойУпаковки.НомерУпаковки       = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаКодаУпаковки,
				ПутьКНомеруУпаковки);
			СтрокаНовойУпаковки.ТипУпаковки = НСтр("ru = 'Индивидуальная упаковка'");	
		КонецЦикла;
	КонецЕсли;
	
	ИмяТаблицыУпаковокДерева = "ТранспортныеУпаковки";
	ТаблицаДокумента = ДокументОбъект.КодыУпаковокМаркируемойПродукции;
	
	КодыУпаковок = СтрокаТоваровДерева.Строки.Найти(
		"СведенияОТоварах.НомерСтроки.СведенияОМаркировке." + ИмяТаблицыУпаковокДерева, "ПолныйПуть", Истина);
	Если КодыУпаковок <> Неопределено И ЗначениеЗаполнено(КодыУпаковок.Значение) Тогда
		Для Каждого СтрокаКодаУпаковки Из КодыУпаковок.Строки Цикл
			СтрокаНовойУпаковки = ТаблицаДокумента.Добавить();
			СтрокаНовойУпаковки.ИдентификаторСтроки = СтрокаТоваров.ИдентификаторСтроки;
			
			ПутьКНомеруУпаковки = СтрШаблон("СведенияОТоварах.НомерСтроки.СведенияОМаркировке.%1.НомерСтроки.Код",
				ИмяТаблицыУпаковокДерева);
			СтрокаНовойУпаковки.НомерУпаковки       = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаКодаУпаковки,
				ПутьКНомеруУпаковки);
			СтрокаНовойУпаковки.ТипУпаковки = НСтр("ru = 'Транспортная упаковка'");	
		КонецЦикла;
	КонецЕсли;

	ИмяТаблицыУпаковокДерева = "КонтрольныеИдентификационныеЗнаки";
	ТаблицаДокумента = ДокументОбъект.КодыУпаковокМаркируемойПродукции;
	
	КодыУпаковок = СтрокаТоваровДерева.Строки.Найти(
		"СведенияОТоварах.НомерСтроки.СведенияОМаркировке." + ИмяТаблицыУпаковокДерева, "ПолныйПуть", Истина);
	Если КодыУпаковок <> Неопределено И ЗначениеЗаполнено(КодыУпаковок.Значение) Тогда
		Для Каждого СтрокаКодаУпаковки Из КодыУпаковок.Строки Цикл
			СтрокаНовойУпаковки = ТаблицаДокумента.Добавить();
			СтрокаНовойУпаковки.ИдентификаторСтроки = СтрокаТоваров.ИдентификаторСтроки;
			
			ПутьКНомеруУпаковки = СтрШаблон("СведенияОТоварах.НомерСтроки.СведенияОМаркировке.%1.НомерСтроки.Код",
				ИмяТаблицыУпаковокДерева);
			СтрокаНовойУпаковки.НомерУпаковки       = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СтрокаКодаУпаковки,
				ПутьКНомеруУпаковки);
			СтрокаНовойУпаковки.ТипУпаковки = НСтр("ru = 'КИЗ'");	
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область РеквизитыМаркировкиАктаОРасхождениях

// Заполняет представление указанных в документе кодов маркировки в колонке "Маркируемые упаковки" табличной части.
//
// Параметры:
//  ВладелецКоллекции - ДанныеФормыСтруктура - объект документа-владельца формы, либо сама форма.
//     Форма указывается в том случае, если таблица-коллекция является реквизитом формы, а не объекта.
//  ИмяКоллекции      - Строка - имя табличной части, в которой заполняется реквизит "МаркируемыеУпаковки".
//     Таблица должна содержать колонки: "НомерСтроки, ИдентификаторСтроки, МаркируемыеУпаковки". 
//
Процедура ЗаполнитьРеквизитыМаркировкиАктаОРасхождениях(ВладелецКоллекции, ИмяКоллекции = "СписокНоменклатуры") Экспорт
	
	КоллекцияДанных = ВладелецКоллекции[ИмяКоллекции];
	
	Для Каждого СтрокаКоллекции Из КоллекцияДанных Цикл
		ИмяПоляНоменклатура = "Номенклатура";
		
		МаркируемыйТовар = ЭлектронныеДокументыБГУВызовСервера.ЭтоМаркируемыйТовар(СтрокаКоллекции[ИмяПоляНоменклатура]);
		
		СтрокаКоллекции.МаркируемыйТовар = МаркируемыйТовар;
		СтрокаКоллекции.МаркируемыйТоварПоФакту = МаркируемыйТовар;
		СтрокаКоллекции.МаркируемыйТоварБрак = МаркируемыйТовар;
		СтрокаКоллекции.МаркируемыйТоварБой = МаркируемыйТовар;
		СтрокаКоллекции.МаркируемыйТоварНедостача = МаркируемыйТовар;
		СтрокаКоллекции.МаркируемыйТоварИзлишки = МаркируемыйТовар;
		
		Если ЗначениеЗаполнено(СтрокаКоллекции.ИдентификаторСтроки) Тогда
