Функция НайтиАктПриемкиПоДокументу(ДокументОснование) Экспорт
	Результат = Документы.ЭлектронныйДокументПоставщика.ПустаяСсылка();
	
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	АктПриемкиМ7.Ссылка КАК Ссылка
		               |ИЗ
		               |	Документ.АктПриемкиМ7 КАК АктПриемкиМ7
		               |ГДЕ
		               |	АктПриемкиМ7.ДокументОснование = &ЭлектронныйДокументПоставщика
		               |	И АктПриемкиМ7.ПометкаУдаления = ЛОЖЬ
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	АктПриемкиМ7.Дата УБЫВ";
		Запрос.УстановитьПараметр("ЭлектронныйДокументПоставщика", ДокументОснование);

		РезультатЗапроса = Запрос.Выполнить();
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат = Выборка.Ссылка;
		КонецЦикла;	
	КонецЕсли;
	
    Возврат Результат;
КонецФункции

Функция ЗаполнитьПриложенияПоИзвещению(ДокументВходящееИзвещение) Экспорт
	Запрос = Новый Запрос;	
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("Извещение", ДокументВходящееИзвещение);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЭлектронныйДокументПоставщика.Ссылка КАК ЭлектронныйДокументПоставщика,
	               |	ЭлектронныйДокументПоставщика.ВидПервичногоДокумента КАК ВидДокумента,
	               |	ЭлектронныйДокументПоставщика.НомерПервичногоДокумента КАК НомерДокумента,
	               |	ЭлектронныйДокументПоставщика.ДатаПервичногоДокумента КАК ДатаДокумента
	               |ПОМЕСТИТЬ ЭДП
	               |ИЗ
	               |	Документ.ЭлектронныйДокументПоставщика КАК ЭлектронныйДокументПоставщика
	               |ГДЕ
	               |	ЭлектронныйДокументПоставщика.Извещение = &Извещение
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЭДП.ЭлектронныйДокументПоставщика КАК ДокументПриложения,
	               |	ЭДП.ВидДокумента КАК ВидДокумента,
	               |	ЭДП.ДатаДокумента КАК ДатаДокумента,
	               |	ЭДП.НомерДокумента КАК НомерДокумента
	               |ИЗ
	               |	ЭДП КАК ЭДП
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЭДП.ЭлектронныйДокументПоставщика КАК ЭДП,
	               |	АктПриемкиМ7.Ссылка КАК ДокументПриложения,
	               |	""Акт приемки"" КАК ВидДокумента,
	               |	АктПриемкиМ7.Дата КАК ДатаДокумента,
	               |	АктПриемкиМ7.Номер КАК НомерДокумента
	               |ПОМЕСТИТЬ АктыПриемкиЭДП
	               |ИЗ
	               |	ЭДП КАК ЭДП
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.АктПриемкиМ7 КАК АктПриемкиМ7
	               |		ПО ЭДП.ЭлектронныйДокументПоставщика = АктПриемкиМ7.ДокументОснование
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	АктыПриемкиЭДП.ЭДП КАК ЭДП,
	               |	АктыПриемкиЭДП.ДокументПриложения КАК ДокументПриложения,
	               |	АктыПриемкиЭДП.ВидДокумента КАК ВидДокумента,
	               |	АктыПриемкиЭДП.ДатаДокумента КАК ДатаДокумента,
	               |	АктыПриемкиЭДП.НомерДокумента КАК НомерДокумента
	               |ИЗ
	               |	АктыПриемкиЭДП КАК АктыПриемкиЭДП
	               |ГДЕ
	               |	НЕ АктыПриемкиЭДП.ДокументПриложения = ЗНАЧЕНИЕ(Документ.АктПриемкиМ7.ПустаяСсылка)";
	
	Результат = Запрос.ВыполнитьПакет();
	ЭДП = Результат[1].Выгрузить();
	АктыПриемкиПоЭДП = Результат[3].Выгрузить();
	
	Результат = Новый Структура("ЭДП, АктыПриемкиПоЭДП", ЭДП, АктыПриемкиПоЭДП);
	
	Возврат Результат;
КонецФункции

Функция ЧислоИзСтрокиЭД(ЗначениеСтрокиЭД)
	Если ЗначениеЗаполнено(ЗначениеСтрокиЭД) Тогда
		Результат = Число(ЗначениеСтрокиЭД);
	Иначе
		Результат = 0;
	КонецЕсли;

	Возврат Результат;
КонецФункции	

Функция НоменклатураОтправителяЭД(Отправитель, ИдентификаторОтправителя) Экспорт
	Результат = Справочники.Номенклатура.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	НоменклатураКонтрагентовБЭД.Номенклатура КАК Номенклатура
	               |ИЗ
	               |	РегистрСведений.НоменклатураКонтрагентовБЭД КАК НоменклатураКонтрагентовБЭД
	               |ГДЕ
	               |	НоменклатураКонтрагентовБЭД.Владелец = &Владелец
	               |	И НоменклатураКонтрагентовБЭД.Идентификатор = &Идентификатор";
	
	Запрос.УстановитьПараметр("Владелец" , Отправитель);
	Запрос.УстановитьПараметр("Идентификатор" , ?(Найти(ИдентификаторОтправителя,"##")>0, ИдентификаторОтправителя, ИдентификаторОтправителя+"##"));
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Номенклатура;
	КонецЕсли;
	
	Возврат Результат;	
КонецФункции	

