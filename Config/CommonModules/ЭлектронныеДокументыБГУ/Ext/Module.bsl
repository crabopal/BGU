					НоваяНоменклатураНФА.GUIDНоменклатурыОтправителя = ТекСтрока.GUIDНоменклатурыУОтправителя;
				Иначе
					НоваяНоменклатураНФА = Номенклатура.ПолучитьОбъект();
				КонецЕсли; 
				
				НоваяНоменклатураНФА.Наименование = ТекСтрока.НаименованиеНоменклатурыНФА;
				НоваяНоменклатураНФА.НаименованиеПолное = ТекСтрока.НаименованиеНФА;
				НоваяНоменклатураНФА.НоменклатурныйНомер = ТекСтрока.НоменклатурныйНомерУОтправителя;  
				НоваяНоменклатураНФА.ТипНоменклатуры = ЭлектронныеДокументыБГУ.ПолучитьСсылкуНаЗначениеПеречисления("ТипыНоменклатуры", ТекСтрока.ТипНоменклатуры);
				
				Если ЗначениеЗаполнено(ТекСтрока.ЕдИзмКод) Тогда
					ЕдИзм = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду(ТекСтрока.ЕдИзмКод);
					НоваяНоменклатураНФА.ЕдиницаИзмерения = ЕдИзм;
				КонецЕсли; 
				
				КодОКДП = Справочники.ОбщероссийскийКлассификаторПродукции.НайтиПоКоду(ТекСтрока.КодОКПД);									
				КодТНВЭД = Справочники.КлассификаторТНВЭД.НайтиПоКоду(ТекСтрока.КодТНВЭД);									
				
				НоваяНоменклатураНФА.ОКП = КодОКДП;
				НоваяНоменклатураНФА.КодТНВЭД = КодТНВЭД;
				
				СтранаПроисхожденияКод = ТекСтрока.КодСтраныПроисхождения;
				СтранаПроисхожденияСсылка = Справочники.СтраныМира.НайтиПоКоду(СтранаПроисхожденияКод);
				НоваяНоменклатураНФА.СтранаПроисхождения = СтранаПроисхожденияСсылка;
				НоваяНоменклатураНФА.ПрослеживаемыйТовар = ТекСтрока.ПрослеживаемыйТовар;
				
				НоваяНоменклатураНФА.МожетСодержатьДрагМатериалы = ТекСтрока.МожетСодержатьДрагМатериалы;
				
				НоваяНоменклатураНФА.КодЕКПС = ТекСтрока.КодЕКПС;
				
				НоваяНоменклатураНФА.ВидМаркируемойПродукции = ТекСтрока.ВидМаркируемойПродукции;
				НоваяНоменклатураНФА.КодКаталога = ТекСтрока.КодКаталога;
				НоваяНоменклатураНФА.КодПоКТРУ = ТекСтрока.КодПоКТРУ;
				НоваяНоменклатураНФА.ИзготовительОС = ТекСтрока.Изготовитель;
				
				Попытка
					НоваяНоменклатураНФА.Записать();
				Исключение
					ШаблонСообщения = Нстр("ru='Не удалось записать номенклатуру %1, по причине:'");
					ТекстСообщения = СтрШаблон(ШаблонСообщения, ТекСтрока.НаименованиеНФА);
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения + Символы.ПС + ОписаниеОшибки());
				КонецПопытки;
				
				Номенклатура = НоваяНоменклатураНФА.Ссылка;
				
				ТекСтрока.НФА = Номенклатура;
				
			КонецЕсли;	
			
		КонецЦикла;
		
		//Создание МЦ кап. вложений с драгоценными материалами
		
		МассивМЦКапВложений = Новый Массив;
		
		Для Каждого СтрокаТаблицыXDTO Из ДокументXDTO.ТабличныеСведения[0].МЦКапвложенийСДрагМатериалами Цикл
			
			ИндексМЦОбъектаВложений = МассивМЦКапВложений.Найти(СтрокаТаблицыXDTO.GUIDНоменклатуры);
			Если ИндексМЦОбъектаВложений = Неопределено Тогда
				                                                                                                                         
				ПараметрыОтбораКИОС = Новый Структура;                                                                                  
				ПараметрыОтбораКИОС.Вставить("ВидОбъекта", ?(СтрокаТаблицыXDTO.ТипСправочникаНФА = "Основное средство", "ОсновныеСредства", "Номенклатура"));
				ПараметрыОтбораКИОС.Вставить("GUIDОбъекта", СтрокаТаблицыXDTO.GUIDНоменклатуры);
				
				КонтактнаяИнформация = ДокументОбъект.КонтактнаяИнформацияОбъектов.НайтиСтроки(ПараметрыОтбораКИОС); 
				
				ПараметрыОтбора = Новый Структура;
				ПараметрыОтбора.Вставить("GUIDИзготовителя", СтрокаТаблицыXDTO.GUIDИзготовителя);
				НайденныеСтроки = ДокументОбъект.ИзготовителиНФА.НайтиСтроки(ПараметрыОтбора);
				Если НайденныеСтроки.Количество()>0 Тогда
					Изготовитель = НайденныеСтроки[0].Изготовитель;
				КонецЕсли;
				
			 	ЗаполнитьСведенияМЦКапВложения(СтрокаТаблицыXDTO, Организация, КонтактнаяИнформация, Изготовитель);
				МассивМЦКапВложений.Добавить(СтрокаТаблицыXDTO.GUIDНоменклатуры);
			КонецЕсли; 
		КонецЦикла;
		
		//Создание СвойствоДополнительныхСведенийНФА   
		КоллекцияСвойствДокументаXDTO = ДокументXDTO.ТабличныеСведения[0].Свойства();
		ТаблицаНоменклатурыНФА = ТаблицаСозданнойНоменклатурыНФАПоАкту(Организация, ВсеGUIDНоменклатурыОтправителя);
		Если НЕ КоллекцияСвойствДокументаXDTO.Получить("СвойстваДополнительныхСведенийНФА") = Неопределено Тогда 
		
			СвязанныеДополнительныеСвойстваНФА = Новый ТаблицаЗначений;
			СвязанныеДополнительныеСвойстваНФА.Колонки.Добавить("ДополнительныеРеквизитыИСведения", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения"));
			СвязанныеДополнительныеСвойстваНФА.Колонки.Добавить("GUIDДополнительныхСведений");
			СвязанныеДополнительныеСвойстваНФА.Колонки.Добавить("ЭтоДополнительноеСведение");
			
			ЗагружатьДополнительныеРеквизитыОбъектовНФА = ЗагружатьДополнительныеРеквизитыОбъектовНФА(Организация); 
			ЗагружатьДополнительныеСведенияОбъектовНФА  = ЗагружатьДополнительныеСведенияОбъектовНФА(Организация);
			
			ЗагружатьТолькоСуществующиеДополнительныеСведения 	= 
					ЗагружатьДополнительныеСведенияОбъектовНФА И ЗагружатьТолькоСуществующиеДополнительныеСведенияОбъектовНФА(Организация);  
					
			ЗагружатьТолькоСуществующиеДополнительныеРеквизиты = 
					ЗагружатьДополнительныеРеквизитыОбъектовНФА И ЗагружатьТолькоСуществующиеДополнительныеРеквизитыОбъектовНФА(Организация); 

			Если ЗагружатьДополнительныеСведенияОбъектовНФА ИЛИ ЗагружатьДополнительныеРеквизитыОбъектовНФА Тогда
				
				Для Каждого СтрокаТаблицыXDTO Из ДокументXDTO.ТабличныеСведения[0].СвойстваДополнительныхСведенийНФА Цикл
					
					Если (СтрокаТаблицыXDTO.ЭтоДополнительноеСведение И НЕ ЗагружатьДополнительныеСведенияОбъектовНФА) 
									ИЛИ (НЕ СтрокаТаблицыXDTO.ЭтоДополнительноеСведение И НЕ ЗагружатьДополнительныеРеквизитыОбъектовНФА) Тогда 
						Продолжить;
					КонецЕсли;
					
					НайденнаяСтрокаНоменклатурыНФА = ТаблицаНоменклатурыНФА.Найти(СтрокаТаблицыXDTO.GUIDНоменклатуры); 
					Если НЕ ЗначениеЗаполнено(НайденнаяСтрокаНоменклатурыНФА) Тогда
						Продолжить;
					КонецЕсли;	
					НоменклатураНФА = НайденнаяСтрокаНоменклатурыНФА.Ссылка;
					
					ДополнительныеРеквизитыИСведения = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоРеквизиту("ИдентификаторДляФормул", СтрокаТаблицыXDTO.ИдентификаторДляФормул);
					
					Если НЕ ЗначениеЗаполнено(ДополнительныеРеквизитыИСведения) И ((СтрокаТаблицыXDTO.ЭтоДополнительноеСведение И ЗагружатьТолькоСуществующиеДополнительныеСведения) 
									ИЛИ (НЕ СтрокаТаблицыXDTO.ЭтоДополнительноеСведение И ЗагружатьТолькоСуществующиеДополнительныеРеквизиты)) Тогда
						
							Продолжить;
					КонецЕсли;
					
					Если НЕ ЗначениеЗаполнено(ДополнительныеРеквизитыИСведения) Тогда 
						
						Если НЕ ЗначениеЗаполнено(СтрокаТаблицыXDTO.НаименованиеНабораСвойств) Тогда 
							Продолжить;	
						КонецЕсли;
						
						НовоеСвойствоНФА = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.СоздатьЭлемент();
						
						НовоеСвойствоНФА.Наименование 			= СтрокаТаблицыXDTO.Наименование;
						НовоеСвойствоНФА.Заголовок 				= СтрокаТаблицыXDTO.Заголовок;
						НовоеСвойствоНФА.Имя 					= СтрокаТаблицыXDTO.ИмяСведений;
						НовоеСвойствоНФА.ИдентификаторДляФормул = СтрокаТаблицыXDTO.ИдентификаторДляФормул;
						
						МассивТиповЗначений = ПолучитьМассивТиповЗначенийДополнительныхСведенийНФА(СтрокаТаблицыXDTO.ТипЗначения); 
						Если МассивТиповЗначений.Количество() = 0 Тогда
							Продолжить;
						КонецЕсли;
						НовоеСвойствоНФА.ТипЗначения 					    = Новый ОписаниеТипов(МассивТиповЗначений);   
						
						НовоеСвойствоНФА.Виден 								= СтрокаТаблицыXDTO.Виден;
						НовоеСвойствоНФА.ВыводитьВВидеГиперссылки 			= СтрокаТаблицыXDTO.ВыводитьВВидеГиперссылки;
						НовоеСвойствоНФА.ДополнительныеЗначенияИспользуются = СтрокаТаблицыXDTO.ДополнительныеЗначенияИспользуются;
						НовоеСвойствоНФА.ДополнительныеЗначенияСВесом 		= СтрокаТаблицыXDTO.ДополнительныеЗначенияСВесом;
						НовоеСвойствоНФА.Доступен 							= СтрокаТаблицыXDTO.Доступен;
						НовоеСвойствоНФА.ЗаполнятьОбязательно 				= СтрокаТаблицыXDTO.ЗаполнятьОбязательно; 
						НовоеСвойствоНФА.ЭтоДополнительноеСведение 			= СтрокаТаблицыXDTO.ЭтоДополнительноеСведение; 
						НовоеСвойствоНФА.МногострочноеПолеВвода             = СтрокаТаблицыXDTO.МногострочноеПолеВвода;
						
						Попытка
							НовоеСвойствоНФА.Записать();
						Исключение
							ШаблонСообщения = Нстр("ru='Не удалось записать дополнительное свойство %1, по причине:'");
							ТекстСообщения = СтрШаблон(ШаблонСообщения, СтрокаТаблицыXDTO.Наименование);
							ОбщегоНазначения.СообщитьПользователю(ТекстСообщения + Символы.ПС + ОписаниеОшибки());
						КонецПопытки; 
						
						ДополнительныеРеквизитыИСведения = НовоеСвойствоНФА.Ссылка; 
						
					КонецЕсли;	
						
					Если Не ЗначениеЗаполнено(ДополнительныеРеквизитыИСведения.НаборСвойств) 
												И ЗначениеЗаполнено(СтрокаТаблицыXDTO.НаименованиеНабораСвойств) Тогда 
						
						НаборСвойств = Справочники.НаборыДополнительныхРеквизитовИСведений.НайтиПоНаименованию(СтрокаТаблицыXDTO.НаименованиеНабораСвойств); 
						
						ОбъектНаборСвойств = НаборСвойств.ПолучитьОбъект();
						
						Если СтрокаТаблицыXDTO.ЭтоДополнительноеСведение Тогда
							СтрокаНабораСвойств = ОбъектНаборСвойств.ДополнительныеСведения.Добавить();
						Иначе
							СтрокаНабораСвойств = ОбъектНаборСвойств.ДополнительныеРеквизиты.Добавить();
						КонецЕсли;
						
						СтрокаНабораСвойств.Свойство = ДополнительныеРеквизитыИСведения;
						СтрокаНабораСвойств.ИмяПредопределенногоНабора = СтрокаТаблицыXDTO.ИмяПредопределенногоНабораСвойств;
						ОбъектНаборСвойств.Записать(); 
						
						Попытка
							ОбъектНаборСвойств.Записать();
						Исключение
							ШаблонСообщения = Нстр("ru='Не удалось добавить дополнительное свойство %1 в группу, по причине:'");
							ТекстСообщения = СтрШаблон(ШаблонСообщения, СтрокаТаблицыXDTO.Наименование);
							ОбщегоНазначения.СообщитьПользователю(ТекстСообщения + Символы.ПС + ОписаниеОшибки());
						КонецПопытки; 
					КонецЕсли;
					
					ПараметрыОтбора = Новый Структура;
					ПараметрыОтбора.Вставить("ДополнительныеРеквизитыИСведения", ДополнительныеРеквизитыИСведения);
					НайденныеСтроки = СвязанныеДополнительныеСвойстваНФА.НайтиСтроки(ПараметрыОтбора);
					Если НайденныеСтроки.Количество() = 0 Тогда
						
						НоваяСтрока = СвязанныеДополнительныеСвойстваНФА.Добавить();
						НоваяСтрока.ДополнительныеРеквизитыИСведения 	= ДополнительныеРеквизитыИСведения;
						НоваяСтрока.GUIDДополнительныхСведений			= СтрокаТаблицыXDTO.GUIDДополнительныхСведений;
						НоваяСтрока.ЭтоДополнительноеСведение 			= СтрокаТаблицыXDTO.ЭтоДополнительноеСведение;
						
					КонецЕсли;
				КонецЦикла;       
			КонецЕсли;
			
			//Заполнить ЗначенияДополнительныхСведенийНФА
					                              
			Если ЗагружатьДополнительныеСведенияОбъектовНФА ИЛИ ЗагружатьДополнительныеРеквизитыОбъектовНФА Тогда
				
				Для Каждого СтрокаТаблицыXDTO Из ДокументXDTO.ТабличныеСведения[0].ЗначенияДополнительныхСведенийНФА Цикл
					
					НайденнаяСтрокаНоменклатурыНФА 			= ТаблицаНоменклатурыНФА.Найти(СтрокаТаблицыXDTO.GUIDНоменклатуры); 
					НайденнаяСтрокаДопРеквизитовИСведений 	= СвязанныеДополнительныеСвойстваНФА.Найти(СтрокаТаблицыXDTO.GUIDДополнительныхСведений, "GUIDДополнительныхСведений");
					
					Если НЕ ЗначениеЗаполнено(НайденнаяСтрокаНоменклатурыНФА) ИЛИ НЕ ЗначениеЗаполнено(НайденнаяСтрокаДопРеквизитовИСведений) Тогда
						Продолжить;
					КонецЕсли;	
					НоменклатураНФА = НайденнаяСтрокаНоменклатурыНФА.Ссылка;
					ДополнительныеРеквизитыИСведения = НайденнаяСтрокаДопРеквизитовИСведений.ДополнительныеРеквизитыИСведения;
					КонтрагентЗначения =  ДокументОбъект.СвязанныеКонтрагенты.Найти(СтрокаТаблицыXDTO.GUIDКонтрагента, "GUIDКонтрагента");
					
					Если КонтрагентЗначения <> Неопределено Тогда 
						Если Организация.ИНН = КонтрагентЗначения.ИНН И Организация.КПП = КонтрагентЗначения.КПП Тогда
							Контрагент = Отправитель; 
						Иначе
							Контрагент = КонтрагентЗначения;
						КонецЕсли;
					КонецЕсли;
					
					ЗначениеДопСвойствНФА = ЗаполнитьЗначенияДополнительныхСведенийНФА(ДополнительныеРеквизитыИСведения, СтрокаТаблицыXDTO, Организация, Контрагент);
					
					Если НЕ ЗначениеЗаполнено(ЗначениеДопСвойствНФА) Тогда
						Продолжить;
					КонецЕсли;
					
					Если НайденнаяСтрокаДопРеквизитовИСведений.ЭтоДополнительноеСведение Тогда
						ОбъектНФА = РегистрыСведений.ДополнительныеСведения.СоздатьНаборЗаписей();
						ОбъектНФА.Записывать = Истина;   
						ОбъектНФА.Отбор.Объект.Установить(НоменклатураНФА);
						ОбъектНФА.Отбор.Свойство.Установить(ДополнительныеРеквизитыИСведения); 
						ОбъектНФА.Прочитать();
						
						Если  ОбъектНФА.Количество() > 0 Тогда
							НоваяЗаписьДополнительныхСвойствНФА = ОбъектНФА.Получить(0);
						Иначе
							НоваяЗаписьДополнительныхСвойствНФА = ОбъектНФА.Добавить();
							НоваяЗаписьДополнительныхСвойствНФА.Объект 	 = НоменклатураНФА;
							НоваяЗаписьДополнительныхСвойствНФА.Свойство = ДополнительныеРеквизитыИСведения;
						КонецЕсли; 
					Иначе                                                    
						
						ОбъектНФА = НоменклатураНФА.ПолучитьОбъект();
						НайтиСтрокуДополнительныхРеквизитов = ОбъектНФА.ДополнительныеРеквизиты.Найти(ДополнительныеРеквизитыИСведения);
						Если ЗначениеЗаполнено(НайтиСтрокуДополнительныхРеквизитов) Тогда
							НоваяЗаписьДополнительныхСвойствНФА = НайтиСтрокуДополнительныхРеквизитов;
						Иначе 
