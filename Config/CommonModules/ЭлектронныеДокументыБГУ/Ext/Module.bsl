#КонецОбласти

Функция ДанныеСубконтоПроводки(СубконтоПроводки, Получатель = Неопределено)

	Результат = Новый Структура;
	Результат.Вставить("GUIDНоменклатурыОтправителя", "");
	Результат.Вставить("ЗначениеСубконтоСтрока", "");
	Результат.Вставить("ЗначениеСубконто", "");
	Результат.Вставить("ТипСубконто", "");
	Результат.Вставить("ПолноеИмяСубконто", "");
	Результат.Вставить("GUIDСубконто", "");
	
	Если ЗначениеЗаполнено(СубконтоПроводки) Тогда
		Результат.ЗначениеСубконто = СубконтоПроводки;
		Результат.ТипСубконто = Строка(ТипЗнч(Результат.ЗначениеСубконто));
		Результат.ЗначениеСубконтоСтрока = Строка(Результат.ЗначениеСубконто);
		ОбъектМД = Метаданные.НайтиПоТипу(ТипЗнч(Результат.ЗначениеСубконто));
		Результат.ПолноеИмяСубконто = ОбъектМД.ПолноеИмя();
		Если СтрНайти(Результат.ПолноеИмяСубконто, "Перечисление.") = 0 Тогда
			Результат.GUIDСубконто = Строка(Результат.ЗначениеСубконто.УникальныйИдентификатор());
		КонецЕсли;
		
		Если ТипЗнч(Результат.ЗначениеСубконто) = Тип("СправочникСсылка.Номенклатура")
			ИЛИ ТипЗнч(Результат.ЗначениеСубконто) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
			СтруктураДанныхНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Результат.ЗначениеСубконто, "GUIDНоменклатурыОтправителя");
			GUIDНоменклатурыОтправителя = СтруктураДанныхНоменклатуры.GUIDНоменклатурыОтправителя;
			
			Если НЕ ЗначениеЗаполнено(GUIDНоменклатурыОтправителя) Тогда
				Если ЗначениеЗаполнено(Получатель) Тогда
					GUIDНоменклатурыСтр = ИдентификаторНоменклатурыОтправителяЭД(Получатель, Результат.ЗначениеСубконто);
					Результат.GUIDНоменклатурыОтправителя = СтрЗаменить(GUIDНоменклатурыСтр, "#", "");
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;
			
	Возврат Результат;
КонецФункции	

Процедура ОбработкаВходящегоЭлектронногоИзвещения(СсылкиНаОбъекты, ДокументXDTO, РежимЗаписи, ДатаСведений)
		
		#Область СозданиеИзвещенияВходящего
		ЕстьНезаполненныеНФА = Ложь;
		
		Попытка
			Если ЗначениеЗаполнено(СсылкиНаОбъекты) Тогда
				ДокументОбъект = СсылкиНаОбъекты[0].ПолучитьОбъект();
				Если ДокументОбъект.Проведен Тогда
					Текст = НСтр("ru = 'Операция возможна только для непроведенных документов!'");
				КонецЕсли;
			Иначе
				УстановитьПривилегированныйРежим(Истина);
				
				ДокументОбъект = Документы.ИзвещениеВходящее.СоздатьДокумент();
				ДокументОбъект.Дата = ДатаСведений;
				ДокументОбъект.Ответственный = Пользователи.ТекущийПользователь();
				
			КонецЕсли;
			ДокументОбъект.ОбменДанными.Загрузка = Истина;
			ДокументОбъект.ОсновныеСредства.Очистить();
			ДокументОбъект.Материалы.Очистить();
			ДокументОбъект.ВозвратнаяТара.Очистить();
			ДокументОбъект.ДокументыПолучателя.Очистить();
			ДокументОбъект.СопоставлениеПроводок.Очистить();
			ДокументОбъект.РекомендуемыеПроводки.Очистить();
			
			ВидИсходящегоИзвещения = ПолучитьСсылкуНаЗначениеПеречисления("ВидыОперацийИсходящееИзвещение", ДокументXDTO.ВидИзвещения);
			ВидВходящегоИзвещения = ВидОперацииВходящееИзвещениеПоВидуОперацииИсходящегоИзвещения(ВидИсходящегоИзвещения);
			
			ДокументОбъект.ВидИзвещения = ВидВходящегоИзвещения;
			
			ДокументОбъект.СуммаДокумента = ЧислоИзСтрокиЭД(ДокументXDTO.СуммаДокумента);
			
			ДокументОбъект.НомерВходящегоДокумента = ДокументXDTO.Номер;
			ДокументОбъект.ДатаВходящегоДокумента = СтроковыеФункцииКлиентСервер.СтрокаВДату(ДокументXDTO.Дата);
			
			ТипИзвещения = ЧислоИзСтрокиЭД(ДокументXDTO.ТипИзвещения);
			ДокументОбъект.ТипЭлектронногоИзвещения = ТипИзвещения;
			
			ПояснениеМБТ = ДокументXDTO.Пояснение;
			ДокументОбъект.ПояснениеМБТ = ПояснениеМБТ;
			
			НайденноеИсходящееИзвещение = Документы.ИзвещениеИсходящее.ПустаяСсылка();
			Если НЕ ЭтоЧетноеЧисло(ТипИзвещения) Тогда
				ДокументОбъект.GUIDВходящегоДокумента = ДокументXDTO.GUIDИзвещения;
			ИначеЕсли ЭтоЧетноеЧисло(ТипИзвещения) Тогда
				GUIDВходящегоИзвещения = ДокументXDTO.GUIDВходящегоИзвещения;
				Если ЗначениеЗаполнено(GUIDВходящегоИзвещения) Тогда
					ДокументОбъект.GUIDВходящегоДокумента = GUIDВходящегоИзвещения;
					НайденноеИсходящееИзвещение = Документы.ИзвещениеИсходящее.ПолучитьСсылку(Новый УникальныйИдентификатор(GUIDВходящегоИзвещения)); 
					ДокументОбъект.ДокументОснование = НайденноеИсходящееИзвещение;
				КонецЕсли;
			КонецЕсли;
		
			НаименованиеПолучателя = ДокументXDTO.Получатель[0].СвЮЛ.Наим;
			ИННПолучателя = ДокументXDTO.Получатель[0].СвЮЛ.ИНН;
			КПППолучателя = ДокументXDTO.Получатель[0].СвЮЛ.КПП;
			ОКПОПолучателя = ДокументXDTO.Получатель[0].СвЮЛ.ОКПО;
			КодПоБКПолучателя = ДокументXDTO.Получатель[0].СвЮЛ.КодПоБК;
			
			Получатель = Справочники.Организации.ПустаяСсылка();
					
			Если ЗначениеЗаполнено(ДокументОбъект.ДокументОснование) И ТипЗнч(ДокументОбъект.ДокументОснование) = Тип("ДокументСсылка.ИзвещениеИсходящее") Тогда
				Получатель = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументОбъект.ДокументОснование, "Организация");
			Иначе	
				Если ЗначениеЗаполнено(ИННПолучателя) Тогда
					ДополнительныеРеквизиты = Новый Структура("ИНН, КПП", ИННПолучателя, КПППолучателя); 
					НайтиСсылкуНаОбъект("Организации", Получатель, , ДополнительныеРеквизиты);
				КонецЕсли;
			КонецЕсли;
			
			Организация = Получатель;
			
			СчетУчета221 = БухгалтерскийУчет.СчетПоКоду("22.1", ДатаСведений, Организация);
			СчетУчета222 = БухгалтерскийУчет.СчетПоКоду("22.2", ДатаСведений, Организация);
			СчетУчета051 = БухгалтерскийУчет.СчетПоКоду("05.1", ДатаСведений, Организация);
			СчетУчета052 = БухгалтерскийУчет.СчетПоКоду("05.2", ДатаСведений, Организация);
			
			Если ЗначениеЗаполнено(Получатель) Тогда
				ДокументОбъект.Организация = Получатель;
			Иначе	
					ШаблонСообщения = НСтр("ru = 'В справочнике ""Организации"" не найден получатель %1 с ИНН %2 и КПП %3.'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, НаименованиеПолучателя,
					ИННПолучателя, КПППолучателя);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			КонецЕсли;	
			
			НаименованиеОтправителя = ДокументXDTO.Отправитель[0].СвЮЛ.Наим;
			ИННОтправителя = ДокументXDTO.Отправитель[0].СвЮЛ.ИНН;
			КППОтправителя = ДокументXDTO.Отправитель[0].СвЮЛ.КПП;
			ОКПООтправителя = ДокументXDTO.Отправитель[0].СвЮЛ.ОКПО;
			КодПоБКОтправителя = ДокументXDTO.Отправитель[0].СвЮЛ.КодПоБК;
			
			Отправитель = Справочники.Контрагенты.ПустаяСсылка();
			Если ЗначениеЗаполнено(ИННОтправителя) Тогда
				ДополнительныеРеквизиты = Новый Структура("ИНН, КПП", ИННОтправителя, КППОтправителя); 
				НайтиСсылкуНаОбъект("Контрагенты", Отправитель, , ДополнительныеРеквизиты);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Отправитель) Тогда
				ДокументОбъект.Отправитель = Отправитель;
			Иначе	
					ШаблонСообщения = НСтр("ru = 'В справочнике ""Контрагенты"" не найден отправитель %1 с ИНН %2 и КПП %3.'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, НаименованиеОтправителя,
					ИННОтправителя, КППОтправителя);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			КонецЕсли;	
			
			НаименованиеПоставщика = "";
			ИННПоставщика = "";
			КПППоставщика = "";
			ОКПОПоставщика = "";
			КодПоБКПоставщика = "";
			НомерДоговора = "";
			ДатаДоговора = Дата(1,1,1);
			НаименованиеДоговора = "";
			
			ЕстьПоставщик = Ложь;
			Если ДокументXDTO.Поставщик[0].СвЮЛ <> Неопределено Тогда
				Если ДокументXDTO.Поставщик[0].СвЮЛ.ИНН <> Неопределено Тогда
					Если ЗначениеЗаполнено(ДокументXDTO.Поставщик[0].СвЮЛ.ИНН) Тогда 
						ЕстьПоставщик = Истина;
						НаименованиеПоставщика = ДокументXDTO.Поставщик[0].СвЮЛ.Наим;
						ИННПоставщика = ДокументXDTO.Поставщик[0].СвЮЛ.ИНН;
						КПППоставщика = ДокументXDTO.Поставщик[0].СвЮЛ.КПП;
						ОКПОПоставщика = ДокументXDTO.Поставщик[0].СвЮЛ.ОКПО;
						КодПоБКПоставщика = ДокументXDTO.Поставщик[0].СвЮЛ.КодПоБК;
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли ДокументXDTO.Поставщик[0].СвФЛ <> Неопределено Тогда		
				Если ДокументXDTO.Поставщик[0].СвФЛ.ИНН <> Неопределено Тогда
					ЕстьПоставщик = Истина;
					НаименованиеПоставщика = СокрЛП(ДокументXDTO.Поставщик[0].СвФЛ.Фамилия + " " + ДокументXDTO.Поставщик[0].СвФЛ.Имя + " " + ДокументXDTO.Поставщик[0].СвФЛ.Отчество);
					ИННПоставщика = ДокументXDTO.Поставщик[0].СвФЛ.ИНН;
					КПППоставщика = "";
					ОКПОПоставщика = "";
					КодПоБКПоставщика = "";
				КонецЕсли;
			КонецЕсли;
			
			Если ЕстьПоставщик Тогда
				Поставщик = Справочники.Контрагенты.ПустаяСсылка();
				Если ЗначениеЗаполнено(ИННПоставщика) Тогда
					ДополнительныеРеквизиты = Новый Структура("ИНН, КПП, Наименование", ИННПоставщика, КПППоставщика, НаименованиеПоставщика); 
					НайтиСсылкуНаОбъект("Контрагенты", Поставщик, , ДополнительныеРеквизиты);
				КонецЕсли;
				
				Если ЗначениеЗаполнено(Поставщик) Тогда
					ДокументОбъект.Поставщик = Поставщик;
				Иначе	
					ШаблонСообщения = НСтр("ru = 'В справочнике ""Контрагенты"" не найден поставщик %1 с ИНН %2 и КПП %3.'");
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, НаименованиеПоставщика,
						ИННПоставщика, КПППоставщика);
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				КонецЕсли;
				
				Договор = Справочники.Договоры.ПустаяСсылка();
				Если ДокументXDTO.Договор.Наим <> Неопределено Тогда
					НаименованиеДоговора = ДокументXDTO.Договор.Наим;
					НомерДоговора = ДокументXDTO.Договор.Номер;
					ДатаДоговора  = СтроковыеФункцииКлиентСервер.СтрокаВДату(ДокументXDTO.Договор.Дата);
					
					Если ЗначениеЗаполнено(ДатаДоговора) Тогда
						ДополнительныеРеквизиты = Новый Структура("НомерДоговора, ДатаДоговора, Владелец, Организация",
							НомерДоговора, ДатаДоговора, Поставщик, Получатель); 
						НайтиСсылкуНаОбъект("ДоговорыКонтрагентов", Договор, , ДополнительныеРеквизиты);
						
						Если НЕ ЗначениеЗаполнено(Договор) Тогда
							ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком;
							ДополнительныеРеквизиты.Вставить("ВидДоговора", ВидДоговора);
							ДополнительныеРеквизиты.Вставить("НаименованиеДоговора", НаименованиеДоговора);
							СоздатьДоговорПоРеквизитам(ДополнительныеРеквизиты, Договор);
						КонецЕсли;
						
						Если НЕ ЗначениеЗаполнено(Договор) Тогда
							ШаблонСообщения = НСтр("ru = 'В справочнике ""Договоры"" не найден договор поставщика %1.'");
							ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, НаименованиеДоговора);
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
						КонецЕсли;	
						
						ДокументОбъект.Договор = Договор;
					КонецЕсли;	
				КонецЕсли;
			КонецЕсли;
			
			ДокументОбъект.Материалы.Очистить();
			ДокументОбъект.ОсновныеСредства.Очистить();
			ДокументОбъект.ВозвратнаяТара.Очистить();
			ДокументОбъект.Приложения.Очистить();
			ДокументОбъект.ЗемельныеУчастки.Очистить();
			
			ЕстьНезаполненныеНФА = Ложь;
			Если ТипИзвещения <> 3 Тогда
				ВыбывшиеЗемельныеУчастки = Новый ТаблицаЗначений;
				Если (ТипИзвещения = 27) Тогда
					Для Каждого СтрокаТаблицыXDTO Из ДокументXDTO.Таблица[0].ПередаваемаяНоменклатура Цикл
						КадастровыеНомераВыбывшихУчастков = Новый Массив;
						Выбыло = СтрокаТаблицыXDTO.Списано;
						Если Выбыло Тогда
							КадастровыйНомер = СтрокаТаблицыXDTO.КадастровыйНомер;
							КадастровыеНомераВыбывшихУчастков.Добавить(КадастровыйНомер);
						КонецЕсли;	
					КонецЦикла;
					ВыбывшиеЗемельныеУчастки = ВыбывшиеЗемельныеУчастки(Организация, КадастровыеНомераВыбывшихУчастков, ДатаСведений);
				КонецЕсли;	
				
				Для Каждого СтрокаТаблицыXDTO Из ДокументXDTO.Таблица[0].ПередаваемаяНоменклатура Цикл
					ПризнакНоменклатуры = СтрокаТаблицыXDTO.ПризнакНоменклатуры;
					Если ПризнакНоменклатуры = "1ОС" Тогда
						Если ЗначениеЗаполнено(СтрокаТаблицыXDTO.GUIDНоменклатуры) Тогда
							НоменклатураОтправителяЭД = Справочники.ОсновныеСредства.ПустаяСсылка();
							НоваяСтрокаИзвещения = ДокументОбъект.ОсновныеСредства.Добавить();
							НоваяСтрокаИзвещения.ИдентификаторПоставщика = СтрокаТаблицыXDTO.GUIDНоменклатуры;
							НоваяСтрокаИзвещения.НаименованиеПоставщика = СтрокаТаблицыXDTO.ПолноеНаимНоменклатуры;
							Если (ТипИзвещения = 1) ИЛИ (ТипИзвещения = 3) Тогда
								НоменклатураОтправителяЭД = НоменклатураОтправителяЭД(Отправитель, НоваяСтрокаИзвещения.ИдентификаторПоставщика);
								Если НЕ Значениезаполнено(НоменклатураОтправителяЭД) Тогда
									ЕстьНезаполненныеНФА = Истина;
								КонецЕсли;	
								СчетУчета = СчетУчета221;
							ИначеЕсли (ТипИзвещения = 2) ИЛИ (ТипИзвещения = 4) Тогда
								Если ЗначениеЗаполнено(СтрокаТаблицыXDTO.GUIDНоменклатурыОтправителя) Тогда
									НоменклатураОтправителяЭД = Справочники.ОсновныеСредства.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрЗаменить(СтрокаТаблицыXDTO.GUIDНоменклатурыОтправителя,"##",""))); 
								Иначе
									НоменклатураОтправителяЭД = Справочники.ОсновныеСредства.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрЗаменить(НоваяСтрокаИзвещения.ИдентификаторПоставщика,"##",""))); 
								КонецЕсли;
								СчетУчета = СчетУчета051;
							Иначе	
								СчетУчета = БухгалтерскийУчет.СчетПоКоду(СтрокаТаблицыXDTO.КодСчетаУчета, ДатаСведений, Организация);
							КонецЕсли;
							НоваяСтрокаИзвещения.ОсновноеСредство = НоменклатураОтправителяЭД;
							НоваяСтрокаИзвещения.Количество = ЧислоИзСтрокиЭД(СтрокаТаблицыXDTO.Количество);
							НоваяСтрокаИзвещения.Сумма = ЧислоИзСтрокиЭД(СтрокаТаблицыXDTO.Сумма);
							НоваяСтрокаИзвещения.СчетУчета = СчетУчета;
							СтрКФО = СтрокаТаблицыXDTO.КФО;
							НоваяСтрокаИзвещения.КФО = ПолучитьСсылкуНаЗначениеПеречисления("КВД", СтрКФО);
						КонецЕсли;	
					ИначеЕсли ПризнакНоменклатуры = "1МЗ" Тогда
						Если ЗначениеЗаполнено(СтрокаТаблицыXDTO.GUIDНоменклатуры) Тогда
							НоменклатураОтправителяЭД = Справочники.Номенклатура.ПустаяСсылка();
							НоваяСтрокаИзвещения = ДокументОбъект.Материалы.Добавить();
							НоваяСтрокаИзвещения.ИдентификаторПоставщика = СтрокаТаблицыXDTO.GUIDНоменклатуры;
							НоваяСтрокаИзвещения.НаименованиеПоставщика = СтрокаТаблицыXDTO.ПолноеНаимНоменклатуры;
							Если (ТипИзвещения = 1) ИЛИ (ТипИзвещения = 3) Тогда
								НоменклатураОтправителяЭД = НоменклатураОтправителяЭД(Отправитель, НоваяСтрокаИзвещения.ИдентификаторПоставщика);
								Если НЕ Значениезаполнено(НоменклатураОтправителяЭД) Тогда
									ЕстьНезаполненныеНФА = Истина;
								КонецЕсли;	
								СчетУчета = СчетУчета222;
							ИначеЕсли (ТипИзвещения = 2) ИЛИ (ТипИзвещения = 4) Тогда
								Если ЗначениеЗаполнено(СтрокаТаблицыXDTO.GUIDНоменклатурыОтправителя) Тогда
									НоменклатураОтправителяЭД = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрЗаменить(СтрокаТаблицыXDTO.GUIDНоменклатурыОтправителя,"##",""))); 
								Иначе
									НоменклатураОтправителяЭД = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрЗаменить(НоваяСтрокаИзвещения.ИдентификаторПоставщика,"##",""))); 
								КонецЕсли;
								СчетУчета = СчетУчета052;
							КонецЕсли;
							НоваяСтрокаИзвещения.Номенклатура = НоменклатураОтправителяЭД;
							НоваяСтрокаИзвещения.Количество = ЧислоИзСтрокиЭД(СтрокаТаблицыXDTO.Количество);
							НоваяСтрокаИзвещения.Сумма = ЧислоИзСтрокиЭД(СтрокаТаблицыXDTO.Сумма);
							НоваяСтрокаИзвещения.СчетУчета = СчетУчета;
							СтрКФО = СтрокаТаблицыXDTO.КФО;
							НоваяСтрокаИзвещения.КФО = ПолучитьСсылкуНаЗначениеПеречисления("КВД", СтрКФО);
						КонецЕсли;	
					ИначеЕсли ПризнакНоменклатуры = "1ВТ" Тогда
						Если ЗначениеЗаполнено(СтрокаТаблицыXDTO.GUIDНоменклатуры) Тогда
							НоменклатураОтправителяЭД = Справочники.Номенклатура.ПустаяСсылка();
							НоваяСтрокаИзвещения = ДокументОбъект.ВозвратнаяТара.Добавить();
							НоваяСтрокаИзвещения.ИдентификаторПоставщика = СтрокаТаблицыXDTO.GUIDНоменклатуры;
							НоваяСтрокаИзвещения.НаименованиеПоставщика = СтрокаТаблицыXDTO.ПолноеНаимНоменклатуры;
							Если (ТипИзвещения = 1) ИЛИ (ТипИзвещения = 3) Тогда
								НоменклатураОтправителяЭД = НоменклатураОтправителяЭД(Отправитель, НоваяСтрокаИзвещения.ИдентификаторПоставщика);
								Если НЕ Значениезаполнено(НоменклатураОтправителяЭД) Тогда
									ЕстьНезаполненныеНФА = Истина;
								КонецЕсли;	
								СчетУчета = СчетУчета222;
							ИначеЕсли (ТипИзвещения = 2) ИЛИ (ТипИзвещения = 4) Тогда
								Если ЗначениеЗаполнено(СтрокаТаблицыXDTO.GUIDНоменклатурыОтправителя) Тогда
									НоменклатураОтправителяЭД = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрЗаменить(СтрокаТаблицыXDTO.GUIDНоменклатурыОтправителя,"##",""))); 
								Иначе
									НоменклатураОтправителяЭД = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрЗаменить(НоваяСтрокаИзвещения.ИдентификаторПоставщика,"##",""))); 
								КонецЕсли;
								СчетУчета = СчетУчета052;
							КонецЕсли;
							НоваяСтрокаИзвещения.Номенклатура = НоменклатураОтправителяЭД;
							НоваяСтрокаИзвещения.Количество = ЧислоИзСтрокиЭД(СтрокаТаблицыXDTO.Количество);
							НоваяСтрокаИзвещения.Сумма = ЧислоИзСтрокиЭД(СтрокаТаблицыXDTO.Сумма);
							НоваяСтрокаИзвещения.СчетУчета = СчетУчета;
							СтрКФО = СтрокаТаблицыXDTO.КФО;
							НоваяСтрокаИзвещения.КФО = ПолучитьСсылкуНаЗначениеПеречисления("КВД", СтрКФО);
						КонецЕсли;
					ИначеЕсли ПризнакНоменклатуры = "1ЗУ" Тогда
						Если (ТипИзвещения = 27) Тогда
							НоменклатураОтправителяЭД = Справочники.ОсновныеСредства.ПустаяСсылка();
							НоваяСтрокаИзвещения = ДокументОбъект.ЗемельныеУчастки.Добавить();
							Выбыло = СтрокаТаблицыXDTO.Списано;
							НоваяСтрокаИзвещения.Выбыло = Выбыло;
							НоваяСтрокаИзвещения.Наименование = СтрокаТаблицыXDTO.НаимНоменклатуры;
							НоваяСтрокаИзвещения.ПолноеНаименование = СтрокаТаблицыXDTO.ПолноеНаимНоменклатуры;
							НоваяСтрокаИзвещения.ИнвентарныйНомерСтрокой = СтрокаТаблицыXDTO.ИнвентарныйНомер;
							НоваяСтрокаИзвещения.КадастровыйНомер = СтрокаТаблицыXDTO.КадастровыйНомер;
							
							Если Выбыло Тогда
								//Поиск по кадастровому номеру
								ЗемельныйУчасток = ЗемельныйУчастокПоКадастровомуНомеру(Организация, ВыбывшиеЗемельныеУчастки, СтрокаТаблицыXDTO.КадастровыйНомер);
								НоменклатураОтправителяЭД = ЗемельныйУчасток.ОсновноеСредство;
								ИнвентарныйНомер = ЗемельныйУчасток.ИнвентарныйНомер;
							Иначе
