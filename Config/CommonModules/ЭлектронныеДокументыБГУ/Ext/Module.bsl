Функция СведенияСвязанногоКонтрагентаАктаПередачиНФА(ВходящийАкт, GUIDКонтрагента) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("ИНН", "");
	Результат.Вставить("КПП", "");
	Результат.Вставить("ОГРН", "");
	Результат.Вставить("ОГРНИП", "");
	Результат.Вставить("КодПоКИСЭ", "");
	Результат.Вставить("КодПоОКОПФ", "");
	Результат.Вставить("НаименованиеКонтрагента", "");
	Результат.Вставить("КодВида", "");
	Результат.Вставить("КодТипа", "");
	Результат.Вставить("ПолноеНаименованиеКонтрагента", "");
	
	ПараметрыОтбораКонтрагента = Новый Структура;
	ПараметрыОтбораКонтрагента.Вставить("GUIDКонтрагента", GUIDКонтрагента);
	НайденныеСтрокиКонтрагента = ВходящийАкт.СвязанныеКонтрагенты.НайтиСтроки(ПараметрыОтбораКонтрагента);
	Если НайденныеСтрокиКонтрагента.Количество()>0 Тогда
		ЗаполнитьЗначенияСвойств(Результат, НайденныеСтрокиКонтрагента[0]); 
	КонецЕсли;
	
	Возврат Результат; 
КонецФункции	

Функция ДанныеФайловПрисоединенныхКДокументуАктаПередачиНФА(СсылкаНаДокумент) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ПриложенныеФайлыДляЭДОБГУ.ДокументЭД КАК ДокументЭД,
	|	ПриложенныеФайлыДляЭДОБГУ.ПрисоединенныйФайл КАК ПрисоединенныйФайл,
	|	ПриложенныеФайлыДляЭДОБГУ.НаименованиеДокументаФайла КАК НаименованиеДокументаФайла,
	|	ПриложенныеФайлыДляЭДОБГУ.ВидСведений КАК ВидСведений
	|ИЗ
	|	РегистрСведений.ПриложенныеФайлыДляЭДОБГУ КАК ПриложенныеФайлыДляЭДОБГУ
	|ГДЕ
	|	ПриложенныеФайлыДляЭДОБГУ.ДокументЭД = &ДокументЭД";
		
	Запрос.УстановитьПараметр("ДокументЭД", СсылкаНаДокумент);
	Выборка = Запрос.Выполнить().Выгрузить();
	
	Возврат Выборка;
	
КонецФункции

Функция НоменклатураДляКомплектующего(Организация, СведенияОКомплектующем, ГруппаНовогоЭлементаОС, ГруппаНовогоЭлементаМЗ)
	Результат = Справочники.Номенклатура.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Если СведенияОКомплектующем.ТипСправочника = "ОсновныеСредства" Тогда
		Запрос.Текст = "ВЫБРАТЬ
		               |	ОсновныеСредства.Ссылка КАК Ссылка
		               |ИЗ
		               |	Справочник.ОсновныеСредства КАК ОсновныеСредства
		               |ГДЕ
		               |	ОсновныеСредства.Организация = &Организация
		               |	И ОсновныеСредства.GUIDНоменклатурыОтправителя = &GUIDНоменклатурыОтправителя";
		Запрос.УстановитьПараметр("Организация", Организация);
		Запрос.УстановитьПараметр("GUIDНоменклатурыОтправителя", СведенияОКомплектующем.GUIDНоменклатуры);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Результат = Выборка.Ссылка;
		Иначе
			НоваяНоменклатураНФА = Справочники.ОсновныеСредства.СоздатьЭлемент();
			НоваяНоменклатураНФА.Наименование = СведенияОКомплектующем.Наименование;
			НоваяНоменклатураНФА.НаименованиеПолное = СведенияОКомплектующем.НаименованиеПолное;
	
			НоваяНоменклатураНФА.Родитель = ГруппаНовогоЭлементаОС;
			НоваяНоменклатураНФА.Организация = Организация;
			НоваяНоменклатураНФА.GUIDНоменклатурыОтправителя = СведенияОКомплектующем.GUIDНоменклатуры;
			НоваяНоменклатураНФА.ВидНФА = ПолучитьСсылкуНаЗначениеПеречисления("ВидыНФА", СведенияОКомплектующем.ВидНФА);
			НоваяНоменклатураНФА.ТипНФА = ПолучитьСсылкуНаЗначениеПеречисления("ТипыНФА", СведенияОКомплектующем.ТипНФА);

			Попытка
				НоваяНоменклатураНФА.Записать();
				Результат = НоваяНоменклатураНФА.Ссылка;
			Исключение
				ШаблонСообщения = Нстр("ru='Не удалось записать комплектующее для сведений о прослеживаемости (основное средство) %1, по причине:'");
				ТекстСообщения = СтрШаблон(ШаблонСообщения, СведенияОКомплектующем.НаименованиеПолное);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения + Символы.ПС + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
	Иначе
		Запрос.Текст = "ВЫБРАТЬ
		               |	Номенклатура.Ссылка КАК Ссылка
		               |ИЗ
		               |	Справочник.Номенклатура КАК Номенклатура
		               |ГДЕ
		               |	Номенклатура.GUIDНоменклатурыОтправителя = &GUIDНоменклатурыОтправителя";
		Запрос.УстановитьПараметр("GUIDНоменклатурыОтправителя", СведенияОКомплектующем.GUIDНоменклатуры);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Результат = Выборка.Ссылка;
		Иначе
			НоваяНоменклатураНФА = Справочники.Номенклатура.СоздатьЭлемент();
			НоваяНоменклатураНФА.Наименование = СведенияОКомплектующем.Наименование;
			НоваяНоменклатураНФА.НаименованиеПолное = СведенияОКомплектующем.НаименованиеПолное;
			
			НоваяНоменклатураНФА.Родитель = ГруппаНовогоЭлементаМЗ;
			НоваяНоменклатураНФА.GUIDНоменклатурыОтправителя = СведенияОКомплектующем.GUIDНоменклатуры;
			НоваяНоменклатураНФА.ТипНоменклатуры = ЭлектронныеДокументыБГУ.ПолучитьСсылкуНаЗначениеПеречисления("ТипыНоменклатуры", СведенияОКомплектующем.ТипНоменклатуры);

			Попытка
				НоваяНоменклатураНФА.Записать();
				Результат = НоваяНоменклатураНФА.Ссылка;
			Исключение
				ШаблонСообщения = Нстр("ru='Не удалось записать комплектующее для сведений о прослеживаемости (номенклатуру) %1, по причине:'");
				ТекстСообщения = СтрШаблон(ШаблонСообщения, СведенияОКомплектующем.НаименованиеПолное);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения + Символы.ПС + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;	
	
	Возврат Результат;	
КонецФункции	

Функция ВидДрагМатериала(КодДМ, НаименованиеДМ) Экспорт
	Результат = Справочники.ДрагМеталлы.ПустаяСсылка();
	
	Результат = Справочники.ДрагМеталлы.НайтиПоКоду(КодДМ);
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		Результат = Справочники.ДрагМеталлы.НайтиПоНаименованию(НаименованиеДМ);
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

Функция НаименованиеДанныхОДрагМатериалахПоПаспортуДляОбъектаНФА(ИтогиДрагМатериалов) Экспорт
	Результат = "";
		
	ШаблонСтрокиОбщий = НСтр("ru = '%1 %2'");
	ШаблонСтроки = НСтр("ru = '%1: %2 %3'");
	ШаблонСтрокиСКоличеством = НСтр("ru = '%1: %2 %3: %4 шт. '");
	ИтогиДрагМатериалов.Свернуть("ВидДрагМатериала, ЕдИзм", "МассаДМ, КоличествоДМ");
	Для Каждого ТекСтрока Из ИтогиДрагМатериалов Цикл
		ЕдИзм = "<без ед.>";
		Если ЗначениеЗаполнено(ТекСтрока.ЕдИзм) Тогда
			ЕдИзм = ТекСтрока.ЕдИзм;
		КонецЕсли;
		Если ЗначениеЗаполнено(ТекСтрока.КоличествоДМ) Тогда
			НаименованиеСтрока = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСтрокиСКоличеством,
				Нрег(ТекСтрока.ВидДрагМатериала), ТекСтрока.МассаДМ, ЕдИзм, ТекСтрока.КоличествоДМ);
		Иначе	
			НаименованиеСтрока = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСтроки,
				Нрег(ТекСтрока.ВидДрагМатериала), ТекСтрока.МассаДМ, ЕдИзм);
		КонецЕсли;	
		Результат = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСтрокиОбщий, 
			Результат, НаименованиеСтрока);
	КонецЦикла;
	
	Возврат СокрЛП(Результат);	
КонецФункции

Функция ВнутреннийЭДПодписан(ДокументУчета) Экспорт
	Результат = Истина;
	
	Если НЕ ИспользуетсяПОД() Тогда
		//ПРОФ
		ВнутреннийЭД = ВнутреннийЭДАктПриемаПередачи0510448(ДокументУчета);
		Если НЕ ЗначениеЗаполнено(ВнутреннийЭД) Тогда
			Результат = Ложь;
		Иначе	
			СостояниеЭлектронногоДокумента = ВнутреннийЭДО.СостояниеЭлектронногоДокумента(ВнутреннийЭД);
			
			Если НЕ СостояниеЭлектронногоДокумента.Состояние = Перечисления.СостоянияДокументовВнутреннегоЭДО.Завершен Тогда
				Результат = Ложь;
			КонецЕсли;	
		КонецЕсли;	
		
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

Функция СведенияОбЭлектронныхПодписях(ДокументУчета, ИмяМакета = "АктПриемаПередачи0510448") Экспорт
	
	МассивОбъектовДляПечати = Новый Массив;
	МассивОбъектовДляПечати.Добавить(ДокументУчета);
	
	ЭлектронныеПодписиВнутреннегоЭД = Новый ТаблицаЗначений;
	ЭлектронныеПодписиВнутреннегоЭД.Колонки.Добавить("ПростаяПодпись", Новый ОписаниеТипов("Булево"));
	ЭлектронныеПодписиВнутреннегоЭД.Колонки.Добавить("ДатаПодписи", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	ЭлектронныеПодписиВнутреннегоЭД.Колонки.Добавить("КомуВыданСертификат", Новый ОписаниеТипов("Строка"));
	ЭлектронныеПодписиВнутреннегоЭД.Колонки.Добавить("НаименованиеОрганизации", Новый ОписаниеТипов("Строка"));
	ЭлектронныеПодписиВнутреннегоЭД.Колонки.Добавить("Должность", Новый ОписаниеТипов("Строка"));
	ЭлектронныеПодписиВнутреннегоЭД.Колонки.Добавить("ПодписьВерна", Новый ОписаниеТипов("Булево"));
	ЭлектронныеПодписиВнутреннегоЭД.Колонки.Добавить("Владелец", Новый ОписаниеТипов("Строка"));
	ЭлектронныеПодписиВнутреннегоЭД.Колонки.Добавить("СерийныйНомерСертификата", Новый ОписаниеТипов("Строка"));
	ЭлектронныеПодписиВнутреннегоЭД.Колонки.Добавить("ДатаНачалаСертификата", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	ЭлектронныеПодписиВнутреннегоЭД.Колонки.Добавить("ДатаОкончанияСертификата", Новый ОписаниеТипов("Дата", , , Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	ЭлектронныеПодписиВнутреннегоЭД.Колонки.Добавить("Пользователь", Новый ОписаниеТипов("Строка"));
	ЭлектронныеПодписиВнутреннегоЭД.Колонки.Добавить("МашиночитаемаяДоверенность", Новый ОписаниеТипов("СправочникСсылка.МашиночитаемыеДоверенности"));
	ЭлектронныеПодписиВнутреннегоЭД.Колонки.Добавить("РезультатПроверкиПодписиПоМЧД", );
	
	Если ИспользуетсяПОД() Тогда
		//КОРП
		МодульПроцессыОбработкиДокументов = ОбщегоНазначения.ОбщийМодуль("ПроцессыОбработкиДокументов");
		
		ШаблоныОбъектов = Новый Соответствие;
		Для Каждого Ссылка Из МассивОбъектовДляПечати Цикл
			Шаблон = МодульПроцессыОбработкиДокументов.ШаблонИСтатусДокумента(Ссылка).Шаблон;
			Если Шаблон = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ШаблоныОбъектов.Вставить(Ссылка, Шаблон);
		КонецЦикла;
		
		Если ШаблоныОбъектов.Количество() = 0 Тогда
			Возврат ЭлектронныеПодписиВнутреннегоЭД;
		КонецЕсли;
		
		Для Каждого Ссылка Из МассивОбъектовДляПечати Цикл
			ЭлектронныеПодписиДляШтампа = МодульПроцессыОбработкиДокументов.УстановленныеПодписиДляШтампа(Ссылка, ШаблоныОбъектов[Ссылка], ИмяМакета);
			ЗаполнитьСведенияОбЭлектронныхПодписях(ЭлектронныеПодписиДляШтампа, ЭлектронныеПодписиВнутреннегоЭД);
		КонецЦикла;
	Иначе
		//ПРОФ
		ВнутреннийЭД = ЭлектронныеДокументыБГУ.ВнутреннийЭДАктПриемаПередачи0510448(ДокументУчета);
		Если ЗначениеЗаполнено(ВнутреннийЭД) Тогда
			ЭлектронныеПодписиДляШтампа = ВнутреннийЭДО.УстановленныеПодписи(ВнутреннийЭД.ОсновнойФайл);
			ЗаполнитьСведенияОбЭлектронныхПодписях(ЭлектронныеПодписиДляШтампа, ЭлектронныеПодписиВнутреннегоЭД);
		КонецЕсли;
	КонецЕсли;	

	Возврат ЭлектронныеПодписиВнутреннегоЭД;
КонецФункции

Процедура ЗаполнитьСведенияОбЭлектронныхПодписях(ЭлектронныеПодписиДляШтампа, ЭлектронныеПодписиВнутреннегоЭД)
	Для Каждого Подпись Из ЭлектронныеПодписиДляШтампа Цикл
		ЭтоПростаяПодпись = Ложь;
		НоваяСтрока = ЭлектронныеПодписиВнутреннегоЭД.Добавить();
		Если Подпись.Свойство("ПростаяПодпись") Тогда
			Если ЗначениеЗаполнено(Подпись.ПростаяПодпись) Тогда
				ЭтоПростаяПодпись = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если ЭтоПростаяПодпись Тогда
			НоваяСтрока.ПростаяПодпись = Истина;
			НоваяСтрока.ПодписьВерна = Истина;
			НоваяСтрока.ДатаПодписи = Подпись.ДатаПодписи;
			НоваяСтрока.КомуВыданСертификат = Подпись.КомуВыданСертификат;
			НоваяСтрока.Должность = Подпись.Должность;
			
			ДанныеОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Подпись.Организация, "НаименованиеПолное, НаименованиеСокращенное");
			НаименованиеОрганизации = ?(ЗначениеЗаполнено(ДанныеОрганизации.НаименованиеПолное), ДанныеОрганизации.НаименованиеПолное, ДанныеОрганизации.НаименованиеСокращенное);
			НоваяСтрока.НаименованиеОрганизации = НаименованиеОрганизации;

			НоваяСтрока.Владелец = Подпись.ВладелецПодписи;
			НоваяСтрока.СерийныйНомерСертификата = "";
			НоваяСтрока.Пользователь = Строка(Подпись.УстановившийПодпись);
		Иначе
			НоваяСтрока.ПростаяПодпись = Ложь;
			НоваяСтрока.ДатаПодписи = Подпись.ДатаПодписи;
			НоваяСтрока.КомуВыданСертификат = Подпись.КомуВыданСертификат;
			НоваяСтрока.НаименованиеОрганизации = "";
			НоваяСтрока.ПодписьВерна = Подпись.ПодписьВерна;
			
			Если Подпись.Свойство("МашиночитаемаяДоверенность") Тогда 
				НоваяСтрока.МашиночитаемаяДоверенность = Подпись.МашиночитаемаяДоверенность;
				НоваяСтрока.РезультатПроверкиПодписиПоМЧД = Подпись.РезультатПроверкиПодписиПоМЧД;
			КонецЕсли;
			
			НоваяСтрока.Пользователь = Подпись.УстановившийПодпись;
			
			Если ТипЗнч(Подпись.Сертификат) = Тип("ХранилищеЗначения") Тогда
				Сертификат = Новый СертификатКриптографии(Подпись.Сертификат.Получить());
			Иначе
				Сертификат = Новый СертификатКриптографии(Подпись.Сертификат);
			КонецЕсли;	

			НоваяСтрока.ДатаНачалаСертификата  = Сертификат.ДатаНачала;
			НоваяСтрока.ДатаОкончанияСертификата  = Сертификат.ДатаОкончания;
			
			СвойстваСубъекта = ЭлектроннаяПодписьКлиентСервер.СвойстваСубъектаСертификата(Сертификат);
			Если СвойстваСубъекта.Свойство("Должность") Тогда		
				ФИО = СокрЛП(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1 %2 %3'"),
						СвойстваСубъекта.Фамилия, СвойстваСубъекта.Имя, СвойстваСубъекта.Отчество));
			Иначе
				ФИО = "";		
			КонецЕсли;			
						
			Если СвойстваСубъекта.Свойство("Должность") Тогда		
				Должность = СвойстваСубъекта.Должность;
			Иначе
				Должность = "";
			КонецЕсли;

			НоваяСтрока.СерийныйНомерСертификата  = Сертификат.СерийныйНомер;
			НоваяСтрока.Владелец = ФИО;
			НоваяСтрока.Должность = Должность;
		КонецЕсли;	
	КонецЦикла;	

КонецПроцедуры

Функция СведенияПредставленияВнутреннегоЭД(Организация, ВнутреннийЭД, ДатаИсходящегоДокумента, НомерИсходящегоДокумента, Расширение)
	
	КодВидаСведений = 0;
	Если Расширение = "MXL" Тогда
		ТипФайлаТабДок = ТипФайлаТабличногоДокумента.MXL;
		КодВидаСведений = 1;
	ИначеЕсли Расширение = "PDF" Тогда
		ТипФайлаТабДок = ТипФайлаТабличногоДокумента.PDF_A_3;
		КодВидаСведений = 2;
	КонецЕсли;	
	
	ДвоичныеДанные = ДвоичныеДанныеЭлектронногоДокумента(ВнутреннийЭД);
	
	ЭлектронныеПодписи = НовыйСписокЭлектронныхПодписейВнутреннегоЭД();
	ЗаполнитьСписокПодписей(ЭлектронныеПодписи, ВнутреннийЭД.ОсновнойФайл, Организация);
	
	АдресОсновногоФайла = ПоместитьВоВременноеХранилище(ДвоичныеДанные);
	
	ТабличныйДокументОсновной = ВнутреннийЭДО.ТабличныйДокументИзДвоичныхДанныхАрхива(ДвоичныеДанные);
	
	АдресТабличногоДокумента = ПоместитьВоВременноеХранилище(ТабличныйДокументОсновной);
	
	//Отступ чтобы штампы не накладывались на представление документа
	МакетШтампов = УправлениеПечатью.МакетПечатнойФормы("Документ.ВнутреннийЭлектронныйДокумент.ПФ_MXL_ШтампПЭП");
	ОбластьМакета = МакетШтампов.ПолучитьОбласть("Отступ");
	ТабличныйДокументОсновной.Вывести(ОбластьМакета);
	
	ДобавитьШтампыЭлектронныхПодписейВнутреннегоЭДО(ТабличныйДокументОсновной, ЭлектронныеПодписи, Организация);
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла(Расширение);
	ТабличныйДокументОсновной.Записать(ИмяВременногоФайла, ТипФайлаТабДок);
	
	ДвоичныеДанные = Новый ДвоичныеДанные(ИмяВременногоФайла);
	
	Попытка
		УдалитьФайлы(ИмяВременногоФайла);
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ШаблонТекста = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Удаление временного %1 файла'", ОбщегоНазначения.КодОсновногоЯзыка()),
			Расширение);
		
		ЗаписьЖурналаРегистрации(ШаблонТекста,
			УровеньЖурналаРегистрации.Ошибка,,,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Удаление временного MXL файла'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,,,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
			
	КонецПопытки;
	
	ТекстовоеСодержимое = Base64Строка(ДвоичныеДанные);
	ИмяПриложенногоФайла = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Акт о приеме-передаче объектов НФА от %1 N %2.%3'"), ДатаИсходящегоДокумента, НомерИсходящегоДокумента, Расширение);
	
	Результат = Новый Структура;
	Результат.Вставить("ТекстовоеСодержимое", ТекстовоеСодержимое);
	Результат.Вставить("ИмяПриложенногоФайла", ИмяПриложенногоФайла);
	Результат.Вставить("КодВидаСведений", КодВидаСведений);
	
	Возврат Результат;
