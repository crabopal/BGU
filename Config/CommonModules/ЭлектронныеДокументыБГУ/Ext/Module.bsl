// См. ОбменСКонтрагентамиПереопределяемый.СпособыОтраженияВУчетеТипаЭлектронногоДокумента.
Процедура СпособыОтраженияВУчетеТипаЭлектронногоДокумента(ТипДокумента, СписокСпособовОбработки) Экспорт 
	
	ТипыДокументов = ОбменСКонтрагентами.ТипыДокументов();
	
	Если ТипДокумента = ТипыДокументов.АктВыполненныхРабот Тогда
		
		СписокСпособовОбработки.Добавить("ПоступлениеУслугРабот", НСтр("ru = 'Поступление услуг, работ'"), Истина);
		
	ИначеЕсли ТипДокумента = ТипыДокументов.АктНаПередачуПрав Тогда
		
		СписокСпособовОбработки.Добавить("ЭлектронныйДокументПоставщика", НСтр("ru = 'Поступление товаров, работ, услуг и прочего (Электронный документ поставщика)'"), Истина);
		
	ИначеЕсли ТипДокумента = ТипыДокументов.ТоварнаяНакладная Тогда
		
		СписокСпособовОбработки.Добавить("ЭлектронныйДокументПоставщика", НСтр("ru = 'Поступление товаров, работ, услуг и прочего (Электронный документ поставщика)'"), Истина);
		
	ИначеЕсли ТипДокумента = ТипыДокументов.КорректировочныйСчетФактура
		ИЛИ ТипДокумента = ТипыДокументов.СоглашениеОбИзмененииСтоимости Тогда
		
		СписокСпособовОбработки.Добавить("КорректировочныйСчетФактураПолученный", НСтр("ru = 'Корректировочный счет-фактура полученный'"),Истина);
		
	ИначеЕсли ТипДокумента = ТипыДокументов.СчетФактура Тогда
		
		СписокСпособовОбработки.Добавить("СчетФактураПолученный", НСтр("ru = 'Счет-фактура полученный'"), Истина);
		
	ИначеЕсли ТипДокумента = ТипыДокументов.СчетНаОплату Тогда
		
		СписокСпособовОбработки.Добавить("СчетНаОплатуОтПоставщика", НСтр("ru = 'Счет на оплату от поставщика'"), Истина);
		
	ИначеЕсли ТипДокумента = ТипыДокументов.ОтветНаЗаказ Тогда
		
		СписокСпособовОбработки.Добавить("СчетНаОплатуОтПоставщика", НСтр("ru = 'Счет на оплату от поставщика'"), Истина);
		
	ИначеЕсли ТипДокумента = ТипыДокументов.СчетОферта Тогда
		
		СписокСпособовОбработки.Добавить("СчетНаОплатуОтПоставщика", НСтр("ru = 'Счет на оплату от поставщика'"), Истина);
		
	ИначеЕсли ТипДокумента = ТипыДокументов.АктОРасхождениях Тогда
		
		СписокСпособовОбработки.Добавить("АктОРасхожденияхПолученный", НСтр("ru = 'Акт о расхождениях (полученный)'"), Истина);

	ИначеЕсли ТипДокумента = ТипыДокументов.АктСверкиВзаиморасчетов Тогда

		СписокСпособовОбработки.Добавить("АктСверкиВзаиморасчетов", НСтр("ru = 'Акт сверки расчетов с контрагентом'"), Истина);

	ИначеЕсли ТипДокумента = ТипыДокументов.АктПриемкиСтроительныхРаботУслуг Тогда

		СписокСпособовОбработки.Добавить("ЭлектронныйДокументПоставщика", НСтр("ru = 'Приемка выполненных строительных работ (Электронный документ поставщика)'"), Истина);

	ИначеЕсли ТипДокумента = ТипыДокументов.ДоговорныйДокумент Тогда
	
		СписокСпособовОбработки.Добавить("Договоры", НСтр("ru = 'Договор'"), Истина);
		
	КонецЕсли;
	
КонецПроцедуры

// См. ОбменСКонтрагентамиПереопределяемый.ПриПроверкеВозможностиСозданияУчетногоДокумента.
