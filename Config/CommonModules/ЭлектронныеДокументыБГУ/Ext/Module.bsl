		               |	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ПоступлениеОСИККапВложения.ВнеоборотныйАктив) КАК ИдентификаторОбъектаНФА,
		               |	"""" КАК ИдентификаторИнвНомер,
		               |	ПРЕДСТАВЛЕНИЕ(ПоступлениеОСИККапВложения.СчетУчета) КАК СчетУчета,
		               |	ПРЕДСТАВЛЕНИЕ(ПоступлениеОСИККапВложения.КПС) КАК КПС,
		               |	ПРЕДСТАВЛЕНИЕ(ПоступлениеОСИККапВложения.КФО) КАК КФО,
    	               |	"""" КАК ЕдИзмКод,
    	               |	"""" КАК ЕдИзмНаим
		               |ИЗ
		               |	Документ.ПоступлениеОСИК.КапВложения КАК ПоступлениеОСИККапВложения";
	ИначеЕсли ТипЗнч(ДокументПринятияКУчету) = Тип("ДокументСсылка.ПоступлениеИК") Тогда
		ТекстЗапроса = "ВЫБРАТЬ
		               |	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ПоступлениеМЗМатериалы.Номенклатура) КАК ИдентификаторОбъектаНФА,
		               |	"""" КАК ИдентификаторИнвНомер,
		               |	ВЫБОР
		               |		КОГДА ПоступлениеМЗМатериалы.СчетУчета = &ПустойСчетУчета
		               |			ТОГДА ПРЕДСТАВЛЕНИЕ(ПоступлениеМЗМатериалы.Ссылка.СчетУчета)
		               |		ИНАЧЕ ПРЕДСТАВЛЕНИЕ(ПоступлениеМЗМатериалы.СчетУчета)
		               |	КОНЕЦ КАК СчетУчета,
		               |	ПРЕДСТАВЛЕНИЕ(ПоступлениеМЗМатериалы.КПС) КАК КПС,
		               |	""1"" КАК КФО,
		               |	ВЫРАЗИТЬ(ПоступлениеМЗМатериалы.ЕдиницаИзмерения КАК Справочник.КлассификаторЕдиницИзмерения).Код КАК ЕдИзмКод,
		               |	ВЫРАЗИТЬ(ПоступлениеМЗМатериалы.ЕдиницаИзмерения КАК Справочник.КлассификаторЕдиницИзмерения).Наименование КАК ЕдИзмНаим
		               |ИЗ
		               |	Документ.ПоступлениеИК.Материалы КАК ПоступлениеМЗМатериалы
		               |ГДЕ
		               |	ПоступлениеМЗМатериалы.Ссылка = &Ссылка";
	КонецЕсли;	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", ДокументПринятияКУчету);
	Запрос.УстановитьПараметр("ПустойСчетУчета", ПланыСчетов.ЕПСБУ.ПустаяСсылка());
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ИдентификаторПоискаНФА = СтрШаблон("%1%2", Выборка.ИдентификаторОбъектаНФА, Выборка.ИдентификаторИнвНомер);

		СведенияОбУчетныхДанныхДляНФА = Новый Структура;
		СведенияОбУчетныхДанныхДляНФА.Вставить("КодСчетаУчета", Выборка.СчетУчета);
		СведенияОбУчетныхДанныхДляНФА.Вставить("КПС", Выборка.КПС);
		СведенияОбУчетныхДанныхДляНФА.Вставить("КФО", Выборка.КФО);
		СведенияОбУчетныхДанныхДляНФА.Вставить("ЕдИзмКод", Выборка.ЕдИзмКод);
		СведенияОбУчетныхДанныхДляНФА.Вставить("ЕдИзмНаим", Выборка.ЕдИзмНаим);
		
		СведенияОбУчетныхДанных.Вставить(ИдентификаторПоискаНФА, СведенияОбУчетныхДанныхДляНФА);
	КонецЦикла;	
	
КонецПроцедуры	

Процедура ОбработкаОтветногоИсходящегоЭлектронногоАктаОПриемеПередачеОбъектовНФА(ФайлXDTO, ДокументXDTO, ПараметрыФормирования, РезультатФормирования, СтруктураДанных, Отказ = Ложь)
	ПервичныйДокументаАкта = ПервичныеДокументыБГУКлиентСервер.ПервичныйДокумент("АктПриемаПередачи0510448");
	Реквизиты = "ВидПервичногоДокумента";
	ЗначенияРеквизитовПУД = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПервичныйДокументаАкта, Реквизиты);
	
	НаименованиеДокументаАкта = ЗначенияРеквизитовПУД.ВидПервичногоДокумента;

	НаименованиеДокумента = СтрШаблон(НСтр("ru='Ответный %1'"), НаименованиеДокументаАкта);
	ВнутреннийКодФормата = "1.0.0.9";
	
	ИспользуетсяПОД = ИспользуетсяПОД();	

	Если ИспользуетсяПОД Тогда
		GUIDВнутреннегоЭлектронногоДокумента = "";
	Иначе
		ВнутреннийЭД = СтруктураДанных.СведенияВнутреннегоЭДО;
		Если НЕ ЗначениеЗаполнено(ВнутреннийЭД) Тогда
			ШаблонСообщения = НСтр("ru = 'Внутренний электронный документ ""%1"" не найден.'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, НаименованиеДокумента);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			
			Отказ = Истина;
			
			Возврат;
		КонецЕсли;
		GUIDВнутреннегоЭлектронногоДокумента = Строка(ВнутреннийЭД.УникальныйИдентификатор());
	КонецЕсли;	
	ДокументXDTO.Установить("GUIDВнутреннегоЭлектронногоДокумента", GUIDВнутреннегоЭлектронногоДокумента);
	
	СведенияАктаПередачиНФА = СтруктураДанных.СведенияАктаПередачиНФА;
	ДокументПринятияКУчету = СтруктураДанных.ДокументПринятияКУчету;
	ФайлыАкта = СтруктураДанных.ФайлыАкта;
	
	ВидИмуществаПолучателя = "";
	КодВидаИмуществаПолучателя = "";
	
	КодВидаОперации = "";
	КодВидаИмущества = "";
	ОбщийКодСчетаУчета = "";
	
	СведенияОбУчетныхДанных = Новый Соответствие;
	
	ЗаполнитьСведенияОбУчетныхДанныхДляОтветногоАкта(ДокументПринятияКУчету, СведенияОбУчетныхДанных);
	
	Если ТипЗнч(ДокументПринятияКУчету) = Тип("ДокументСсылка.ПрочееОтражениеЭлектронногоДокументаВУчете") Тогда
		Если ДокументПринятияКУчету.ДокументыОтраженияВУчетеДляАктаОПриемеПередаче.Количество() > 0 Тогда
			ОсновнойДокументПринятияКУчету = ДокументПринятияКУчету.ДокументыОтраженияВУчетеДляАктаОПриемеПередаче[0].ДокументОтражения;
			ЗначенияРеквизитовДокументаПринятияКУчету = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОсновнойДокументПринятияКУчету, "ВидПоступленияМЗ, СчетУчета");
			
			ОбщийКодСчетаУчета = Строка(ЗначенияРеквизитовДокументаПринятияКУчету.СчетУчета);

			Если СтрНайти(ОбщийКодСчетаУчета, "106.00") > 0 Тогда
				ВидИмуществаПолучателя = НСтр("ru='вложения в нефинансовые активы'");
				КодВидаИмуществаПолучателя = НСтр("ru='ВложенияВНФА'");
				КодВидаОперации = НСтр("ru='УчетКапвложений'");
			Иначе	
				ВидПоступления = ЗначенияРеквизитовДокументаПринятияКУчету.ВидПоступленияМЗ;
				КодВидаОперации = ВидПоступления.Метаданные().ЗначенияПеречисления[Перечисления[ВидПоступления.Метаданные().Имя].Индекс(ВидПоступления)].Имя;
				ВидИмуществаПолучателя = Перечисления.ВидыИмущества.ИноеДвижимое;
				КодВидаИмуществаПолучателя = ВидИмуществаПолучателя.Метаданные().ЗначенияПеречисления[Перечисления[ВидИмуществаПолучателя.Метаданные().Имя].Индекс(ВидИмуществаПолучателя)].Имя;
				ВидИмуществаПолучателя = НСтр("ru='иное движимое'");
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДокументПринятияКУчету) = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовОС") Тогда     
		ЗначенияРеквизитовДокументаПринятияКУчету = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументПринятияКУчету, "ВидПоступления, ВидИмущества, ВидИмуществаВТабличнойЧасти");
		ВидПоступления = ЗначенияРеквизитовДокументаПринятияКУчету.ВидПоступления;
        ВидИмуществаПолучателя = ЗначенияРеквизитовДокументаПринятияКУчету.ВидИмущества;
		ВидИмуществаВТабличнойЧасти = ЗначенияРеквизитовДокументаПринятияКУчету.ВидИмуществаВТабличнойЧасти;
		Если ВидИмуществаВТабличнойЧасти Тогда
			// если используется флаг "Вид имущества в табличной части", то будет использоваться вид имущества получателя
			КодВидаИмуществаУОтправителя = СтруктураДанных.ВходящийАкт.КодВидаИмуществаУОтправителя;
			ВидИмуществаПолучателя = ПолучитьСсылкуНаЗначениеПеречисления("ВидыИмущества", КодВидаИмуществаУОтправителя, Истина); 
		КонецЕсли;

		КодВидаИмуществаПолучателя = ВидИмуществаПолучателя.Метаданные().ЗначенияПеречисления[Перечисления[ВидИмуществаПолучателя.Метаданные().Имя].Индекс(ВидИмуществаПолучателя)].Имя;

		КодВидаОперации = ВидПоступления.Метаданные().ЗначенияПеречисления[Перечисления[ВидПоступления.Метаданные().Имя].Индекс(ВидПоступления)].Имя;
	ИначеЕсли ТипЗнч(ДокументПринятияКУчету) = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовИК") Тогда     
		ЗначенияРеквизитовДокументаПринятияКУчету = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументПринятияКУчету, "ВидПоступления, ВидИмущества");
		ВидПоступления = ЗначенияРеквизитовДокументаПринятияКУчету.ВидПоступления;
        ВидИмуществаПолучателя = ЗначенияРеквизитовДокументаПринятияКУчету.ВидИмущества;
		КодВидаИмуществаПолучателя = ВидИмуществаПолучателя.Метаданные().ЗначенияПеречисления[Перечисления[ВидИмуществаПолучателя.Метаданные().Имя].Индекс(ВидИмуществаПолучателя)].Имя;

		КодВидаОперации = ВидПоступления.Метаданные().ЗначенияПеречисления[Перечисления[ВидПоступления.Метаданные().Имя].Индекс(ВидПоступления)].Имя;
	ИначеЕсли ТипЗнч(ДокументПринятияКУчету) = Тип("ДокументСсылка.ПоступлениеМЗ") Тогда
		ЗначенияРеквизитовДокументаПринятияКУчету = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументПринятияКУчету, "ВидПоступленияМЗ, СчетУчета");
		
		ОбщийКодСчетаУчета = Строка(ЗначенияРеквизитовДокументаПринятияКУчету.СчетУчета);

		Если СтрНайти(ОбщийКодСчетаУчета, "106.00") > 0 Тогда
			ВидИмуществаПолучателя = НСтр("ru='вложения в нефинансовые активы'");
			КодВидаИмуществаПолучателя = НСтр("ru='ВложенияВНФА'");
			КодВидаОперации = НСтр("ru='УчетКапвложений'");
		Иначе	
			ВидПоступления = ЗначенияРеквизитовДокументаПринятияКУчету.ВидПоступленияМЗ;
			КодВидаОперации = ВидПоступления.Метаданные().ЗначенияПеречисления[Перечисления[ВидПоступления.Метаданные().Имя].Индекс(ВидПоступления)].Имя;
			ВидИмуществаПолучателя = Перечисления.ВидыИмущества.ИноеДвижимое;
			КодВидаИмуществаПолучателя = ВидИмуществаПолучателя.Метаданные().ЗначенияПеречисления[Перечисления[ВидИмуществаПолучателя.Метаданные().Имя].Индекс(ВидИмуществаПолучателя)].Имя;
			ВидИмуществаПолучателя = НСтр("ru='иное движимое'");
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДокументПринятияКУчету) = Тип("ДокументСсылка.ПоступлениеОС") Тогда	
		ВидИмуществаПолучателя = НСтр("ru='вложения в нефинансовые активы'");
		КодВидаИмуществаПолучателя = НСтр("ru='ВложенияВНФА'");
		КодВидаОперации = НСтр("ru='УчетКапвложений'");
		
	ИначеЕсли ТипЗнч(ДокументПринятияКУчету) = Тип("ДокументСсылка.ПоступлениеОСИК") Тогда	
		ВидИмуществаПолучателя = НСтр("ru='вложения в нефинансовые активы казны'");
		КодВидаИмуществаПолучателя = НСтр("ru='ВложенияВНФАКазны'");
		КодВидаОперации = НСтр("ru='УчетКапвложений'");
		
	ИначеЕсли ТипЗнч(ДокументПринятияКУчету) = Тип("ДокументСсылка.ПоступлениеИК") Тогда
		ВидИмуществаПолучателя = Перечисления.ВидыИмущества.Казна;
		КодВидаИмуществаПолучателя = ВидИмуществаПолучателя.Метаданные().ЗначенияПеречисления[Перечисления[ВидИмуществаПолучателя.Метаданные().Имя].Индекс(ВидИмуществаПолучателя)].Имя;
		Реквизиты = "СчетУчета";
		ЗначенияРеквизитовДокументаПринятияКУчету = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументПринятияКУчету, Реквизиты);
		
		Если ЗначениеЗаполнено(ЗначенияРеквизитовДокументаПринятияКУчету.СчетУчета) Тогда
			ОбщийКодСчетаУчета = Строка(ЗначенияРеквизитовДокументаПринятияКУчету.СчетУчета.Код);
			
			Если ОбщийКодСчетаУчета = "106.50" Тогда
				ВидИмуществаПолучателя = НСтр("ru = 'вложения в нефинансовые активы казны'");;
				КодВидаИмуществаПолучателя = НСтр("ru='ВложенияВНФАКазны'");
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;	
	
	ВходящийАктПередачиНФА = СтруктураДанных.ВходящийАкт;
	ЗначенияРеквизитовАктаПередачиНФА = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВходящийАктПередачиНФА, "Дата, Организация, GUIDВходящегоДокумента, 
	|НомерПервичногоДокумента, ДатаПервичногоДокумента");

	НомерИсходящегоДокумента = ЗначенияРеквизитовАктаПередачиНФА.НомерПервичногоДокумента;
	ДатаИсходящегоДокумента = ЗначенияРеквизитовАктаПередачиНФА.ДатаПервичногоДокумента;
	
	GUIDВходящегоАкта = ЗначенияРеквизитовАктаПередачиНФА.GUIDВходящегоДокумента;
	ДокументXDTO.Установить("GUIDВходящегоАкта", GUIDВходящегоАкта);
	ДокументXDTO.Установить("НомерВходящегоАкта", НомерИсходящегоДокумента);
	ДокументXDTO.Установить("ДатаВходящегоАкта", ДатаИсходящегоДокумента);

	ДокументXDTO.Установить("ТипАкта", СтруктураДанных.ТипАкта);
	
	ДокументXDTO.Установить("Номер", НомерИсходящегоДокумента);
	ДокументXDTO.Установить("Дата",  ДатаИсходящегоДокумента);
	ДокументXDTO.Установить("Наим",  НаименованиеДокумента);
	ДокументXDTO.Установить("СуммаДокумента", СтруктураДанных.СуммаДокумента);
	
	КоличествоПриложДок = ФайлыАкта.Количество();
	ДокументXDTO.Установить("КоличествоПриложДок", КоличествоПриложДок);

	ДокументXDTO.Установить("КФО", СведенияАктаПередачиНФА.ОбщиеРеквизитыДокумента.КФО);

	ТипДокументаОснования = ДокументПринятияКУчету.Метаданные().Имя;
	ДокументXDTO.Установить("ТипДокументаОснования", ТипДокументаОснования);
	
	ДокументXDTO.Установить("КодВалюты", СведенияАктаПередачиНФА.ОбщиеРеквизитыДокумента.КодВалюты);
	
	ДокументXDTO.Установить("ВидИмущества", Строка(ВидИмуществаПолучателя));
	АналитическаяГруппа = СведенияАктаПередачиНФА.ОбщиеРеквизитыДокумента.АналитическаяГруппа;
	ДокументXDTO.Установить("АналитическаяГруппа", АналитическаяГруппа);
	
	ДокументXDTO.Установить("КодВидаОперации", КодВидаОперации);
	
	ДокументXDTO.Установить("КодВидаИмущества", КодВидаИмуществаПолучателя);
	
	КоличествоПриложДок = ФайлыАкта.Количество();
	ДокументXDTO.Установить("КоличествоПриложДок", КоличествоПриложДок);

	ЗаполнитьСведенияУчастникаАктаОПриемеПередачеНФА(ДокументXDTO, СтруктураДанных.Организация, "Получатель");
	ЗаполнитьСведенияУчастникаАктаОПриемеПередачеНФА(ДокументXDTO, СтруктураДанных.Контрагент, "Отправитель");
	
	ДоговорXDTO = СоздатьОбъектXDTO(ДокументXDTO, "Договор");
	ДоговорXDTO.Установить("Наим", СведенияАктаПередачиНФА.ДоговорОтправителя.Наим);
	ДоговорXDTO.Установить("Дата", СведенияАктаПередачиНФА.ДоговорОтправителя.Дата);
	ДоговорXDTO.Установить("Номер", СведенияАктаПередачиНФА.ДоговорОтправителя.Номер);
	ДокументXDTO.Установить("Договор", ДоговорXDTO);
	
	КодЕдиницыИзмерения = "383";
	ДокументXDTO.Установить("КодЕдиницыИзмерения", КодЕдиницыИзмерения);

