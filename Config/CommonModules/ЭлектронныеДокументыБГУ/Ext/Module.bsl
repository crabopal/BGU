								НоваяСтрока.КоличествоНедостачи = ЧислоИзСтрокиЭД(СтрокаТаблицыXDTOСписокНоменклатуры.КоличествоНедостачи);
								НоваяСтрока.КоличествоПоДокументам = ЧислоИзСтрокиЭД(СтрокаТаблицыXDTOСписокНоменклатуры.КоличествоПоДокументам);
								НоваяСтрока.НомерПаспорта = СтрокаТаблицыXDTOСписокНоменклатуры.НомерПаспорта;
								
								ЕдИзмКод = СтрокаТаблицыXDTOСписокНоменклатуры.ЕдИзмКод;
								ЕдИзмНаим = СтрокаТаблицыXDTOСписокНоменклатуры.ЕдИзмНаим;
								ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка();
								НайтиСсылкуНаОбъект("ЕдиницыИзмерения", ЕдиницаИзмерения, ЕдИзмКод);
								НоваяСтрока.ЕдиницаИзмерения = ЕдиницаИзмерения;
								
								GUIDНоменклатуры = СтрокаТаблицыXDTOСписокНоменклатуры.GUIDНоменклатуры;
								Если ЗначениеЗаполнено(GUIDНоменклатуры) Тогда
									НоваяСтрока.Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(GUIDНоменклатуры));
								КонецЕсли;	
							КонецЕсли;
						КонецЦикла;
						
						Для Каждого СтрокаТаблицыXDTOСоставКонтейнеров Из СтрокаТаблицыXDTOАктОПриемке.СоставКонтейнеров Цикл
							НоваяСтрока = ДокументОбъектАктПриемки.СоставКонтейнеров.Добавить();

							ЕдИзмКод = СтрокаТаблицыXDTOСоставКонтейнеров.ЕдИзмКод;
							ЕдИзмНаим = СтрокаТаблицыXDTOСоставКонтейнеров.ЕдИзмНаим;
							ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка();
							НайтиСсылкуНаОбъект("ЕдиницыИзмерения", ЕдиницаИзмерения, ЕдИзмКод);
							НоваяСтрока.ЕдиницаИзмерения = ЕдиницаИзмерения;
							
							НоваяСтрока.ОтметкаОпломбирования = СтрокаТаблицыXDTOСоставКонтейнеров.ОтметкаОпломбирования;
							НоваяСтрока.ВидУпаковки = СтрокаТаблицыXDTOСоставКонтейнеров.ВидУпаковки;
							НоваяСтрока.НомераКонтейнеров = СтрокаТаблицыXDTOСоставКонтейнеров.НомераКонтейнеров;
							НоваяСтрока.ОсобыеОтметки = СтрокаТаблицыXDTOСоставКонтейнеров.ОсобыеОтметки;
							
							НоваяСтрока.КоличествоМест = ЧислоИзСтрокиЭД(СтрокаТаблицыXDTOСоставКонтейнеров.КоличествоМест);
							НоваяСтрока.МассаГрузаОтправитель = ЧислоИзСтрокиЭД(СтрокаТаблицыXDTOСоставКонтейнеров.МассаГрузаОтправитель);
							НоваяСтрока.МассаГрузаДороги = ЧислоИзСтрокиЭД(СтрокаТаблицыXDTOСоставКонтейнеров.МассаГрузаДороги);
						КонецЦикла;
						
						Для Каждого СтрокаТаблицыXDTOСоставКомиссии Из СтрокаТаблицыXDTOАктОПриемке.СоставКомиссии Цикл
							НоваяСтрока = ДокументОбъектАктПриемки.СоставКомиссии.Добавить();
							НоваяСтрока.ДолжностьЧленаКомиссии = СтрокаТаблицыXDTOСоставКомиссии.Должность;
							НоваяСтрока.ФамилияЧленаКомиссии = СтрокаТаблицыXDTOСоставКомиссии.Фамилия;
							НоваяСтрока.ИмяЧленаКомиссии = СтрокаТаблицыXDTOСоставКомиссии.Имя;
							НоваяСтрока.ОтчествоЧленаКомиссии = СтрокаТаблицыXDTOСоставКомиссии.Отчество;
							НоваяСтрока.Председатель = ?(СокрЛП(СтрокаТаблицыXDTOСоставКомиссии.Председатель) = "Да", Истина, Ложь);
						КонецЦикла;
						
						Для Каждого СтрокаТаблицыXDTOСоставПриложения Из СтрокаТаблицыXDTOАктОПриемке.СоставПриложения Цикл
							НоваяСтрока = ДокументОбъектАктПриемки.СоставПриложения.Добавить();
							НоваяСтрока.ВидПриложения = СтрокаТаблицыXDTOСоставПриложения.ВидПриложения;
							НоваяСтрока.НомерДокумента = СтрокаТаблицыXDTOСоставПриложения.НомерДокумента;
							Если ЗначениеЗаполнено(СтрокаТаблицыXDTOСоставПриложения.ДатаДокумента) Тогда
								НоваяСтрока.ДатаДокумента = СтроковыеФункцииКлиентСервер.СтрокаВДату(СтрокаТаблицыXDTOСоставПриложения.ДатаДокумента);
							КонецЕсли;
						КонецЦикла;
						
						ДокументОбъектАктПриемки.Записать(РежимЗаписи);
						
						НовыйДокументПолучателя = ДокументОбъект.ДокументыПолучателя.Добавить();
						НовыйДокументПолучателя.АктПриемки = ДокументОбъектАктПриемки.Ссылка;
						НовыйДокументПолучателя.ДокументПоставщика = ДокументОбъектАктПриемки.ДокументОснование;
						
						СсылкаНаВладельца = ДокументОбъектАктПриемки.Ссылка;
					КонецЦикла;
					
					Если ДокументОбъект.ДокументыПолучателя.Количество()>0 Тогда
						ДокументОбъект.ДополнительныеСвойства.Вставить("ПроцессыОбработкиДокументов_ЗаписатьБезПроверкиОбменДаннымиЗагрузка", Истина);
						Если НЕ ЗначениеЗаполнено(ДокументОбъект.Номер) Тогда
							ДокументОбъект.УстановитьНовыйНомер();
						КонецЕсли;
						ДокументОбъект.Записать(РежимЗаписи);
					КонецЕсли;
				КонецЕсли;
			Исключение
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Заполнение документов ""Акт о расхождениях при приемке"" на основе ЭД. %1'"), Текст)
					+ Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ВыполнитьЗаписьСобытияПоЭДВЖурналРегистрации(ТекстСообщения,
					2, УровеньЖурналаРегистрации.Ошибка, ДокументОбъект.Метаданные(), СсылкаНаВладельца);
				ВызватьИсключение(Текст);
			КонецПопытки;
			
		#КонецОбласти
		КонецЕсли;
		
КонецПроцедуры	

Процедура ОбработкаИсходящегоЭлектронногоИзвещения(ФайлXDTO, ДокументXDTO, ПараметрыФормирования, РезультатФормирования, ВыборкаШапки, СтруктураДанных, НомерИсходящегоДокумента)

		ВнутреннийКодФормата = "1.0.0.12";
	
		ПараметрыФормирования.ДатаФормирования = ВыборкаШапки.Дата;
		РезультатФормирования.ДатаДокументаОтправителя = ВыборкаШапки.Дата;
		
		ДокументXDTO.Установить("Номер", НомерИсходящегоДокумента);
		ДокументXDTO.Установить("Дата",  Формат(ВыборкаШапки.Дата, "ДФ=dd.MM.yyyy"));
		ВидИзвещения = ВыборкаШапки.ВидИзвещения;
		ДокументXDTO.Установить("ВидИзвещения",
			ВидИзвещения.Метаданные().ЗначенияПеречисления[Перечисления[ВидИзвещения.Метаданные().Имя].Индекс(ВидИзвещения)].Имя);
		ДокументXDTO.Установить("СуммаДокумента", Формат(ВыборкаШапки.СуммаДокумента, "ЧДЦ=2; ЧРД=.; ЧГ=0"));
		
		Если Значениезаполнено(ВыборкаШапки.ПояснениеМБТ) Тогда
			ДокументXDTO.Установить("Пояснение", СокрЛП(ВыборкаШапки.ПояснениеМБТ));
		Иначе
			ДокументXDTO.Установить("Пояснение", "");
		КонецЕсли;
		
		ЭтоИсправлениеОшибок = Ложь;
		Если ВыборкаШапки.ИсправлениеОшибок = Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода
				Или ВыборкаШапки.ИсправлениеОшибок = Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода Тогда
			ЭтоИсправлениеОшибок = Истина;
		КонецЕсли;
		ПроводкиДокументаУчета = СтруктураДанных.ПроводкиДокументаУчета;
		
		ФайлыИзвещения = СтруктураДанных.ФайлыИзвещения;
		
		ДокументXDTO.Установить("GUIDИзвещения", Строка(ПараметрыФормирования.СсылкаНаОбъект.УникальныйИдентификатор()));
		ТипИзвещения = ВыборкаШапки.ТипЭлектронногоИзвещения;
		ДокументXDTO.Установить("ТипИзвещения", ТипИзвещения);
		Если (ТипИзвещения = 2) ИЛИ (ТипИзвещения = 4) 
			ИЛИ (ТипИзвещения = 6) ИЛИ (ТипИзвещения = 8)
			ИЛИ (ТипИзвещения = 10) ИЛИ (ТипИзвещения = 12)
			ИЛИ (ТипИзвещения = 14) ИЛИ (ТипИзвещения = 16)
			ИЛИ (ТипИзвещения = 18) ИЛИ (ТипИзвещения = 20)
			ИЛИ (ТипИзвещения = 22) ИЛИ (ТипИзвещения = 24)
			ИЛИ (ТипИзвещения = 26) ИЛИ (ТипИзвещения = 32)
			ИЛИ (ТипИзвещения = 28) ИЛИ (ТипИзвещения = 30) Тогда
			ВходящееИзвещение = ВыборкаШапки.ВходящееИзвещение;
			ЗначенияРеквизитовИзвещения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВходящееИзвещение, "Дата, Организация, GUIDВходящегоДокумента, 
			|НомерВходящегоДокумента, ДатаВходящегоДокумента");
			GUIDВходящегоДокумента = ЗначенияРеквизитовИзвещения.GUIDВходящегоДокумента;
			ДокументXDTO.Установить("GUIDВходящегоИзвещения", GUIDВходящегоДокумента);
			ДокументXDTO.Установить("НомерВходящегоИзвещения", ЗначенияРеквизитовИзвещения.НомерВходящегоДокумента);
			ДокументXDTO.Установить("ДатаВходящегоИзвещения",  Формат(ЗначенияРеквизитовИзвещения.ДатаВходящегоДокумента, "ДФ=dd.MM.yyyy"));
		КонецЕсли;	
		
		ЗаполнитьСведенияУчастникаИзвещения(ДокументXDTO, ВыборкаШапки.Организация, "Отправитель");
		
		ЗаполнитьСведенияУчастникаИзвещения(ДокументXDTO, ВыборкаШапки.Получатель, "Получатель");
		ЗаполнитьСведенияУчастникаИзвещения(ДокументXDTO, ВыборкаШапки.Поставщик, "Поставщик");
		
		ОснованиеXDTO = СоздатьОбъектXDTO(ДокументXDTO, "Договор");
		Если ЗначениеЗаполнено(ВыборкаШапки.Договор) Тогда
			ОснованиеXDTO.Установить("Наим", ВыборкаШапки.ДоговорНаименование);
			ОснованиеXDTO.Установить("Номер", ВыборкаШапки.ДоговорНомер);
			Если ЗначениеЗаполнено(ВыборкаШапки.ДоговорДата) Тогда
				ОснованиеXDTO.Установить("Дата", Формат(ВыборкаШапки.ДоговорДата, "ДФ=dd.MM.yyyy"));
			Иначе
				ОснованиеXDTO.Установить("Дата", "");
			КонецЕсли;
		Иначе
			ОснованиеXDTO.Установить("Наим", "");
			ОснованиеXDTO.Установить("Номер", "");
			ОснованиеXDTO.Установить("Дата", "");
		КонецЕсли;
		ДокументXDTO.Установить("Договор", ОснованиеXDTO);
		
		ТаблицаXDTO = СоздатьОбъектXDTO(ДокументXDTO, "Таблица");
		
		//Полная версия формата
		СтрокаТаблицыXDTO = СоздатьОбъектXDTO(ТаблицаXDTO, "ДопСведенияИзвещения");
		СтрокаТаблицыXDTO.Установить("Идентиф", "Код формата");
		СтрокаТаблицыXDTO.Установить("Значен", ВнутреннийКодФормата);
		ТаблицаXDTO.ДопСведенияИзвещения.Добавить(СтрокаТаблицыXDTO);

		#Область ПередачаПередаваемыеПроводки
		
		ПередаваемыеПроводки = СтруктураДанных.ПередаваемыеПроводки;
		
		Если ЭтоИсправлениеОшибок Тогда
			ПередаваемыеПроводки = ПроводкиДокументаУчета;
		КонецЕсли;	
		
		ДокументыПередачи = СтруктураДанных.ДокументыПередачи;
		ДокументыПринятияКУчетуОС = Новый Массив;
		ДокументыСписанияОС = Новый Массив;
		
		Если (ТипИзвещения = 3) ИЛИ (ТипИзвещения = 5)
			ИЛИ (ТипИзвещения = 7) 
			ИЛИ (ТипИзвещения = 15)
			ИЛИ (ТипИзвещения = 16)
			ИЛИ (ТипИзвещения = 17)
			ИЛИ (ТипИзвещения = 18)
			ИЛИ (ТипИзвещения = 20) 
			ИЛИ (ТипИзвещения = 22) 
			ИЛИ (ТипИзвещения = 25) Тогда
			ПередаваемыеПроводки = ПроводкиПоДокументамПередачи(ДокументыПередачи, ПараметрыФормирования.СсылкаНаОбъект);
		ИначеЕсли (ТипИзвещения = 23) ИЛИ (ТипИзвещения = 29) Тогда
			ПередаваемыеПроводки = ПроводкиПоДокументамПоступления(ДокументыПередачи, ПараметрыФормирования.СсылкаНаОбъект);
		ИначеЕсли (ТипИзвещения = 27) Тогда
			ДокументыПередачиЗУ = ДокументыПередачи.Скопировать();
			ДокументыПередачиЗУ.Очистить();
			
			НомерСтроки = 0;
			Для Каждого ТекДокументПередачи Из ДокументыПередачи Цикл
				Если ТипЗнч(ТекДокументПередачи.ДокументПередачи) = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовОС")
					ИЛИ ТипЗнч(ТекДокументПередачи.ДокументПередачи) = Тип("ДокументСсылка.ПринятиеКУчетуОбъектовИК") Тогда
					ДокументыПринятияКУчетуОС.Добавить(ТекДокументПередачи.ДокументПередачи);

					НовыйДок = ДокументыПередачиЗУ.Добавить();
					НовыйДок.ДокументПередачи = ТекДокументПередачи.ДокументПередачи;
					НомерСтроки = НомерСтроки + 1;
					НовыйДок.НомерСтроки = НомерСтроки;
				ИначеЕсли ТипЗнч(ТекДокументПередачи.ДокументПередачи) = Тип("ДокументСсылка.СписаниеОбъектовОС")
					ИЛИ ТипЗнч(ТекДокументПередачи.ДокументПередачи) = Тип("ДокументСсылка.СписаниеОбъектовИК") Тогда
					ДокументыСписанияОС.Добавить(ТекДокументПередачи.ДокументПередачи);
					
					НовыйДок = ДокументыПередачиЗУ.Добавить();
					НовыйДок.ДокументПередачи = ТекДокументПередачи.ДокументПередачи;
					НомерСтроки = НомерСтроки + 1;
					НовыйДок.НомерСтроки = НомерСтроки;
				КонецЕсли;	
			КонецЦикла;	
			ПередаваемыеПроводки = ПроводкиПоДокументамПоступления(ДокументыПередачиЗУ, ПараметрыФормирования.СсылкаНаОбъект);
		КонецЕсли;
		
		ИнвентарныеНомераОСОрганизации = Новый Соответствие;
		Если (ТипИзвещения = 1) ИЛИ (ТипИзвещения = 3) ИЛИ (ТипИзвещения = 2) ИЛИ (ТипИзвещения = 4) Тогда
			ИнвентарныеНомераОСОрганизации = ИнвентарныеНомераОСОрганизации(ВыборкаШапки.Организация);
		КонецЕсли;	
		
		НомерПоПорядку = 0;
		Для Каждого СтрокаТаблицы Из ПередаваемыеПроводки Цикл
			НомерПоПорядку = НомерПоПорядку + 1;
			
			СтрокаТаблицыXDTO = СоздатьОбъектXDTO(ТаблицаXDTO, "ПередаваемыеПроводки");
			СтрокаТаблицыXDTO.Установить("НомерПоПорядку", НомерПоПорядку);
			СтрокаТаблицыXDTO.Установить("Содержание", СтрокаТаблицы.Содержание);
			СтрокаТаблицыXDTO.Установить("Сумма",  Формат(СтрокаТаблицы.Сумма, "ЧДЦ=2; ЧРД=.; ЧГ=0"));
			СтрокаТаблицыXDTO.Установить("КФО", Строка(СтрокаТаблицы.КФО));
			СтрокаТаблицыXDTO.Установить("СчетДт", ?(ЗначениеЗаполнено(СтрокаТаблицы.СчетДт), СтрокаТаблицы.СчетДт.Код, ""));
			СтрокаТаблицыXDTO.Установить("КПСДт", ?(ЗначениеЗаполнено(СтрокаТаблицы.КПСДт), СтрокаТаблицы.КПСДт.Код, ""));
			СтрокаТаблицыXDTO.Установить("КЭКДт", ?(ЗначениеЗаполнено(СтрокаТаблицы.КЭКДт), СтрокаТаблицы.КЭКДт.Код, ""));
			
			//Субконто Дт 1
			ДанныеСубконто = ДанныеСубконтоПроводки(СтрокаТаблицы.СубконтоДт1, ВыборкаШапки.Получатель);
			
			GUIDНоменклатурыОтправителя = ДанныеСубконто.GUIDНоменклатурыОтправителя;
			
			СтрокаТаблицыXDTO.Установить("СубконтоДт1", ДанныеСубконто.ЗначениеСубконтоСтрока);
			СтрокаТаблицыXDTO.Установить("ТипСубконтоДт1", ДанныеСубконто.ТипСубконто);
			СтрокаТаблицыXDTO.Установить("ПолноеИмяСубконтоДт1", ДанныеСубконто.ПолноеИмяСубконто);
			СтрокаТаблицыXDTO.Установить("GUIDСубконтоДт1", ДанныеСубконто.GUIDСубконто);
			
			//Субконто Дт 2
			ДанныеСубконто = ДанныеСубконтоПроводки(СтрокаТаблицы.СубконтоДт2);
			
			СтрокаТаблицыXDTO.Установить("СубконтоДт2", ДанныеСубконто.ЗначениеСубконтоСтрока);
			СтрокаТаблицыXDTO.Установить("ТипСубконтоДт2", ДанныеСубконто.ТипСубконто);
			СтрокаТаблицыXDTO.Установить("ПолноеИмяСубконтоДт2", ДанныеСубконто.ПолноеИмяСубконто);
			СтрокаТаблицыXDTO.Установить("GUIDСубконтоДт2", ДанныеСубконто.GUIDСубконто);
			
			//Субконто Дт 3
			ДанныеСубконто = ДанныеСубконтоПроводки(СтрокаТаблицы.СубконтоДт3);
			
			СтрокаТаблицыXDTO.Установить("СубконтоДт3", ДанныеСубконто.ЗначениеСубконтоСтрока);
			СтрокаТаблицыXDTO.Установить("ТипСубконтоДт3", ДанныеСубконто.ТипСубконто);
			СтрокаТаблицыXDTO.Установить("ПолноеИмяСубконтоДт3", ДанныеСубконто.ПолноеИмяСубконто);
			СтрокаТаблицыXDTO.Установить("GUIDСубконтоДт3", ДанныеСубконто.GUIDСубконто);
				
			СтрокаТаблицыXDTO.Установить("СчетКт", ?(ЗначениеЗаполнено(СтрокаТаблицы.СчетКт), СтрокаТаблицы.СчетКт.Код, ""));
			СтрокаТаблицыXDTO.Установить("КПСКт", ?(ЗначениеЗаполнено(СтрокаТаблицы.КПСКт), СтрокаТаблицы.КПСКт.Код, ""));
			СтрокаТаблицыXDTO.Установить("КЭККт", ?(ЗначениеЗаполнено(СтрокаТаблицы.КЭККт), СтрокаТаблицы.КЭККт.Код, ""));
			
			//Субконто Кт 1
			ДанныеСубконто = ДанныеСубконтоПроводки(СтрокаТаблицы.СубконтоКт1, ВыборкаШапки.Получатель);
			
			GUIDНоменклатурыОтправителя = ДанныеСубконто.GUIDНоменклатурыОтправителя;
			
			СтрокаТаблицыXDTO.Установить("СубконтоКт1", ДанныеСубконто.ЗначениеСубконтоСтрока);
			СтрокаТаблицыXDTO.Установить("ТипСубконтоКт1", ДанныеСубконто.ТипСубконто);
			СтрокаТаблицыXDTO.Установить("ПолноеИмяСубконтоКт1", ДанныеСубконто.ПолноеИмяСубконто);
			СтрокаТаблицыXDTO.Установить("GUIDСубконтоКт1", ДанныеСубконто.GUIDСубконто);

			//Субконто Кт 2
			ДанныеСубконто = ДанныеСубконтоПроводки(СтрокаТаблицы.СубконтоКт2, ВыборкаШапки.Получатель);
			
			СтрокаТаблицыXDTO.Установить("СубконтоКт2", ДанныеСубконто.ЗначениеСубконтоСтрока);
			СтрокаТаблицыXDTO.Установить("ТипСубконтоКт2", ДанныеСубконто.ТипСубконто);
			СтрокаТаблицыXDTO.Установить("ПолноеИмяСубконтоКт2", ДанныеСубконто.ПолноеИмяСубконто);
			СтрокаТаблицыXDTO.Установить("GUIDСубконтоКт2", ДанныеСубконто.GUIDСубконто);
			
			//Субконто Кт 3
			ДанныеСубконто = ДанныеСубконтоПроводки(СтрокаТаблицы.СубконтоКт3, ВыборкаШапки.Получатель);
			
			СтрокаТаблицыXDTO.Установить("СубконтоКт3", ДанныеСубконто.ЗначениеСубконтоСтрока);
			СтрокаТаблицыXDTO.Установить("ТипСубконтоКт3", ДанныеСубконто.ТипСубконто);
			СтрокаТаблицыXDTO.Установить("ПолноеИмяСубконтоКт3", ДанныеСубконто.ПолноеИмяСубконто);
			СтрокаТаблицыXDTO.Установить("GUIDСубконтоКт3", ДанныеСубконто.GUIDСубконто);
			
			СтрокаТаблицыXDTO.Установить("GUIDНоменклатурыОтправителя", GUIDНоменклатурыОтправителя);
			
			GUIDИнвентарногоНомера = "";
			ИнвентарныйНомер = "";
			ИнвентарныйНомерУОтправителя = "";
			Если ИнвентарныеНомераОСОрганизации.Количество() > 0 Тогда
				СведенияИнвентарногоНомераНФА = СведенияИнвентарногоНомераНФАПоСОдержаниюПроводки(ИнвентарныеНомераОСОрганизации, СтрокаТаблицы.Содержание);
				GUIDИнвентарногоНомера = СведенияИнвентарногоНомераНФА.GUIDИнвентарногоНомера;
				ИнвентарныйНомер = СведенияИнвентарногоНомераНФА.ИнвентарныйНомер;
				ИнвентарныйНомерУОтправителя = СведенияИнвентарногоНомераНФА.ИнвентарныйНомерУОтправителя;
			КонецЕсли;
			СтрокаТаблицыXDTO.GUIDИнвентарногоНомера = GUIDИнвентарногоНомера;
			СтрокаТаблицыXDTO.ИнвентарныйНомер = ИнвентарныйНомер;
			СтрокаТаблицыXDTO.ИнвентарныйНомерУОтправителя = ИнвентарныйНомерУОтправителя;
			
			ТаблицаXDTO.ПередаваемыеПроводки.Добавить(СтрокаТаблицыXDTO);
		КонецЦикла;
		
		#КонецОбласти
		
		//СопоставлениеПроводок
		СопоставлениеПроводок = ПараметрыФормирования.СсылкаНаОбъект.СопоставлениеПроводок.Выгрузить();
		Для Каждого СтрокаТаблицы Из СопоставлениеПроводок Цикл
			СтрокаТаблицыXDTO = СоздатьОбъектXDTO(ТаблицаXDTO, "СопоставлениеПроводок");
			СтрокаТаблицыXDTO.Установить("НомераПроводокОтправителя", СтрокаТаблицы.НомераПроводокОтправителя);
			СтрокаТаблицыXDTO.Установить("НомераПроводокПолучателя", СтрокаТаблицы.НомераПроводокПолучателя);
			СтрокаТаблицыXDTO.Установить("КомментарийСопоставления", СтрокаТаблицы.КомментарийСопоставления);
			ТаблицаXDTO.СопоставлениеПроводок.Добавить(СтрокаТаблицыXDTO);
		КонецЦикла;
		
		//Рекомендуемые проводки
		РекомендуемыеПроводки = ПараметрыФормирования.СсылкаНаОбъект.РекомендуемыеПроводки.Выгрузить();
		Для Каждого СтрокаТаблицы Из РекомендуемыеПроводки Цикл
			СтрокаТаблицыXDTO = СоздатьОбъектXDTO(ТаблицаXDTO, "РекомендуемыеПроводки");
			СтрокаТаблицыXDTO.Установить("КФО", СтрокаТаблицы.КФО);
			СтрокаТаблицыXDTO.Установить("СчетДт", СтрокаТаблицы.СчетДт);
			СтрокаТаблицыXDTO.Установить("КПСДт", СтрокаТаблицы.КПСДт);
			СтрокаТаблицыXDTO.Установить("КЭКДт", СтрокаТаблицы.КЭКДт);
			СтрокаТаблицыXDTO.Установить("СчетКт", СтрокаТаблицы.СчетКт);
			СтрокаТаблицыXDTO.Установить("КПСКт", СтрокаТаблицы.КПСКт);
			СтрокаТаблицыXDTO.Установить("КЭККт", СтрокаТаблицы.КЭККт);
			СтрокаТаблицыXDTO.Установить("Сумма", СокрЛП(СтрокаТаблицы.Сумма));
			СтрокаТаблицыXDTO.Установить("Содержание", СтрокаТаблицы.Содержание);
			СтрокаТаблицыXDTO.Установить("НомераПроводокОтправителя", СтрокаТаблицы.НомераПроводокОтправителя);
			СтрокаТаблицыXDTO.Установить("НомерПоПорядку", СтрокаТаблицы.НомерСтроки);
			ТаблицаXDTO.РекомендуемыеПроводки.Добавить(СтрокаТаблицыXDTO);
		КонецЦикла;

		//ФайлыИзвещения
		
		Для Каждого ТекСтрока Из ФайлыИзвещения Цикл
			ВидСведений = ТекСтрока.ВидСведений;
			ПрисоединенныйФайл = ТекСтрока.ПрисоединенныйФайл;
			
			Если НЕ ЗначениеЗаполнено(ПрисоединенныйФайл) Тогда
				Продолжить;
			КонецЕсли;	
			
			Если ЭтоАдресВременногоХранилища(ПрисоединенныйФайл.Ссылка) Тогда
				ДвоичныеДанные = ПолучитьИзВременногоХранилища(ПрисоединенныйФайл.Ссылка);
				Расширение     =  ПрисоединенныйФайл.Расширение;
			Иначе
				ДанныеФайла = РаботаСФайлами.ДанныеФайла(ПрисоединенныйФайл.Ссылка);
				ДвоичныеДанные = ПолучитьИзВременногоХранилища(ДанныеФайла.СсылкаНаДвоичныеДанныеФайла);
				Расширение     = ДанныеФайла.Расширение;
			КонецЕсли;
			ТекстовоеСодержимое = Base64Строка(ДвоичныеДанные);
			
			ИмяПриложенногоФайла = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru='%1.%2'"), ПрисоединенныйФайл.Наименование, ПрисоединенныйФайл.Расширение);
			
			СтрокаТаблицыXDTO = СоздатьОбъектXDTO(ТаблицаXDTO, "ФайлыПриложений");
			
			СтрокаТаблицыXDTO.Установить("ИмяФайла", ИмяПриложенногоФайла);
			СтрокаТаблицыXDTO.Установить("НаименованиеДокумента", ТекСтрока.НаименованиеДокументаФайла);
			СтрокаТаблицыXDTO.Установить("КодВидаСведений", КодВидаСведенийИзвещения(ВидСведений));
			СтрокаТаблицыXDTO.Установить("СодержимоеФайла", XMLСтрока(ТекстовоеСодержимое));
			
			ТаблицаXDTO.ФайлыПриложений.Добавить(СтрокаТаблицыXDTO);
		КонецЦикла;
		
		//Приложения
		Приложения = СтруктураДанных.Приложения;
		
		#Область ПередачаПриложения
		
		МассивПриложений = Новый Массив;
		
		Для каждого ТекСтрока Из Приложения Цикл
			Если ЗначениеЗаполнено(ТекСтрока.ВидДокумента) Тогда
				ШаблонДокумента = НСтр("ru = '%1 %2 %3'");
				НаименованиеДокумента = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонДокумента, ТекСтрока.ВидДокумента, ТекСтрока.НомерДокумента, ТекСтрока.ДатаДокумента);
				
				Если МассивПриложений.Найти(НаименованиеДокумента) = Неопределено Тогда
					МассивПриложений.Добавить(НаименованиеДокумента);
				
					СтрокаТаблицыXDTO = СоздатьОбъектXDTO(ТаблицаXDTO, "Приложения");
					СтрокаТаблицыXDTO.Установить("ВидДокумента", ТекСтрока.ВидДокумента);
					СтрокаТаблицыXDTO.Установить("Номер",  ТекСтрока.НомерДокумента);
					СтрокаТаблицыXDTO.Установить("Дата", Формат(ТекСтрока.ДатаДокумента, "ДФ=dd.MM.yyyy"));
					СтрокаТаблицыXDTO.Установить("Наим", ТекСтрока.ВидДокумента + " № "+СокрЛП(ТекСтрока.НомерДокумента) + " от " + Формат(ТекСтрока.ДатаДокумента, "ДФ=dd.MM.yyyy"));
					ТаблицаXDTO.Приложения.Добавить(СтрокаТаблицыXDTO);
				КонецЕсли;	
			КонецЕсли;
		КонецЦикла;
		
		#КонецОбласти
		
		#Область ПередачаСписокНоменклатуры
		
		ПередаваемаяНоменклатура = СтруктураДанных.ПередаваемаяНоменклатура;
		
		Если (ТипИзвещения = 3) ИЛИ (ТипИзвещения = 25)  Тогда
			ПередаваемаяНоменклатура = ПередаваемыеНФАПоДокументамПередачи(ДокументыПередачи);
		ИначеЕсли (ТипИзвещения = 23) ИЛИ (ТипИзвещения = 29) Тогда
			ПередаваемаяНоменклатура = ПередаваемыеНФАПоДокументамПоступления(ДокументыПередачи);
		ИначеЕсли (ТипИзвещения = 27) Тогда
			ПередаваемаяНоменклатура = ПередаваемыеЗУПоДокументам(ДокументыПринятияКУчетуОС, ДокументыСписанияОС);
		КонецЕсли;	
			
		Для Каждого СтрокаТаблицы Из ПередаваемаяНоменклатура Цикл
			СтрокаТаблицыXDTO = СоздатьОбъектXDTO(ТаблицаXDTO, "ПередаваемаяНоменклатура");
			Номенклатура = СтрокаТаблицы.Номенклатура;
			
			НаименованиеНоменклатуры = "";
			ПолноеНаимНоменклатуры = "";
			НоменклатурныйНомер = "";
			GUIDНоменклатуры = "";
			ЕдИзмКод = "";
			ЕдИзмНаим = "";
			ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка();
			GUIDНоменклатурыОтправителя = "";
			Если ЗначениеЗаполнено(Номенклатура) Тогда
				Если ТипЗнч(Номенклатура) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
					ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, "Наименование, НаименованиеПолное, НоменклатурныйНомер, GUIDНоменклатурыОтправителя");
					ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка();
				ИначеЕсли ТипЗнч(Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда	
					ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, "Наименование, НаименованиеПолное, НоменклатурныйНомер, ЕдиницаИзмерения, GUIDНоменклатурыОтправителя");
					ЕдиницаИзмерения = ЗначенияРеквизитов.ЕдиницаИзмерения;
				КонецЕсли;
				
				GUIDНоменклатурыОтправителя = ЗначенияРеквизитов.GUIDНоменклатурыОтправителя;
				Если НЕ ЗначениеЗаполнено(GUIDНоменклатурыОтправителя) Тогда
					GUIDНоменклатурыСтр = ИдентификаторНоменклатурыОтправителяЭД(ВыборкаШапки.Получатель, Номенклатура);
					GUIDНоменклатурыОтправителя = СтрЗаменить(GUIDНоменклатурыСтр, "#", "");
				КонецЕсли;
				
				НаименованиеНоменклатуры = ЗначенияРеквизитов.Наименование;
				ПолноеНаимНоменклатуры = ЗначенияРеквизитов.НаименованиеПолное;				
				НоменклатурныйНомер = ЗначенияРеквизитов.НоменклатурныйНомер;
				GUIDНоменклатуры = XMLстрока(Номенклатура.УникальныйИдентификатор())
			КонецЕсли;
			Если СтрокаТаблицы.ПризнакНоменклатуры = "1ОС"
				ИЛИ СтрокаТаблицы.ПризнакНоменклатуры = "1ЗУ" Тогда
				ТипСправочника = НСтр("ru = 'ОсновныеСредства'");
			ИначеЕсли СтрокаТаблицы.ПризнакНоменклатуры = "1МЗ"
				ИЛИ СтрокаТаблицы.ПризнакНоменклатуры = "1ВТ" Тогда
				ТипСправочника = НСтр("ru = 'Номенклатура'");
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
				ЕдИзмКод = ЕдиницаИзмерения.Код;
				ЕдИзмНаим = ЕдиницаИзмерения.Наименование;
			Иначе
				ЕдИзмКод = "";
				ЕдИзмНаим = "";
			КонецЕсли;
			
			СтрокаТаблицыXDTO.Установить("GUIDНоменклатуры", GUIDНоменклатуры);
			СтрокаТаблицыXDTO.Установить("GUIDНоменклатурыОтправителя", GUIDНоменклатурыОтправителя);
			СтрокаТаблицыXDTO.Установить("НаимНоменклатуры", НаименованиеНоменклатуры);
			СтрокаТаблицыXDTO.Установить("ПолноеНаимНоменклатуры", ПолноеНаимНоменклатуры);
			СтрокаТаблицыXDTO.Установить("НоменклатурныйНомер", НоменклатурныйНомер);
			СтрокаТаблицыXDTO.Установить("ТипСправочника", ТипСправочника);
			СтрокаТаблицыXDTO.Установить("ЕдИзмКод", ЕдИзмКод);
			СтрокаТаблицыXDTO.Установить("ЕдИзмНаим", ЕдИзмНаим);
			СтрокаТаблицыXDTO.Установить("Количество",  Формат(СтрокаТаблицы.Количество, "ЧДЦ=3; ЧРД=.; ЧГ=0"));
			СтрокаТаблицыXDTO.Установить("Сумма",  Формат(СтрокаТаблицы.Сумма, "ЧДЦ=2; ЧРД=.; ЧГ=0"));
			СтрокаТаблицыXDTO.Установить("КФО", XMLстрока(СтрокаТаблицы.КФО));
			КодСчетаУчета = "";
			Если ТипЗнч(СтрокаТаблицы.СчетУчета) = Тип("Строка") Тогда
				КодСчетаУчета = СтрокаТаблицы.СчетУчета;
			Иначе
				КодСчетаУчета = ?(ЗначениеЗаполнено(СтрокаТаблицы.СчетУчета), СтрокаТаблицы.СчетУчета.Код, "");
			КонецЕсли;	
			СтрокаТаблицыXDTO.Установить("КодСчетаУчета", КодСчетаУчета);
			СтрокаТаблицыXDTO.Установить("ПризнакНоменклатуры", СтрокаТаблицы.ПризнакНоменклатуры);

			GUIDИнвентарногоНомера = "";
			ИнвентарныйНомер = "";
			ИнвентарныйНомерУОтправителя = "";
			Если ЗначениеЗаполнено(СтрокаТаблицы.ИнвентарныйНомер) Тогда
				GUIDИнвентарногоНомера = Строка(СтрокаТаблицы.ИнвентарныйНомер.УникальныйИдентификатор());
				СтруктураДанныхИнвНомераОС = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаТаблицы.ИнвентарныйНомер, "Код, GUIDИнвентарногоНомераУОтправителя");
				ИнвентарныйНомер = СтруктураДанныхИнвНомераОС.Код;
				Если ЗначениеЗаполнено(СтруктураДанныхИнвНомераОС.GUIDИнвентарногоНомераУОтправителя) Тогда
					ИнвентарныйНомерУОтправителя = СтруктураДанныхИнвНомераОС.GUIDИнвентарногоНомераУОтправителя;
				КонецЕсли;	
			КонецЕсли;
			СтрокаТаблицыXDTO.GUIDИнвентарногоНомера = GUIDИнвентарногоНомера;
			СтрокаТаблицыXDTO.ИнвентарныйНомер = ИнвентарныйНомер;
			СтрокаТаблицыXDTO.ИнвентарныйНомерУОтправителя = ИнвентарныйНомерУОтправителя;
			
			Если ТипИзвещения = 27 Тогда
				СтрокаТаблицыXDTO.КадастровыйНомер = СтрокаТаблицы.КадастровыйНомер;
				СтрокаТаблицыXDTO.Списано = СтрокаТаблицы.Списано;
			КонецЕсли;	
			
			ТаблицаXDTO.ПередаваемаяНоменклатура.Добавить(СтрокаТаблицыXDTO);
		КонецЦикла;
		
		ДокументXDTO.Таблица.Добавить(ТаблицаXDTO);
			
		#КонецОбласти
		
		ЗаполнитьСведенияОДолжностномЛицеИзвещения(ДокументXDTO, ВыборкаШапки.Руководитель, "Руководитель", ВыборкаШапки.Организация);
		ЗаполнитьСведенияОДолжностномЛицеИзвещения(ДокументXDTO, ВыборкаШапки.ГлавныйБухгалтер, "ГлавныйБухгалтер", ВыборкаШапки.Организация);
		ЗаполнитьСведенияОДолжностномЛицеИзвещения(ДокументXDTO, ВыборкаШапки.Ответственный, "Исполнитель", ВыборкаШапки.Организация);
		
		ЗаполнитьСведенияОДолжностномЛицеИзвещения(ДокументXDTO, "", "РуководительПолучателя", ВыборкаШапки.Организация);
		ЗаполнитьСведенияОДолжностномЛицеИзвещения(ДокументXDTO, "", "ГлавныйБухгалтерПолучателя", ВыборкаШапки.Организация);
		ЗаполнитьСведенияОДолжностномЛицеИзвещения(ДокументXDTO, "", "ИсполнительПолучателя", ВыборкаШапки.Организация);

		КоличествоПриложДок = КоличествоПриложенийКИзвещению(Приложения);
		Если КоличествоПриложДок <> 0 Тогда
			ДокументXDTO.Установить("КоличествоПриложДок", КоличествоПриложДок);
		Иначе	
			ДокументXDTO.Установить("КоличествоПриложДок", СтруктураДанных.ФайлыИзвещения.Количество());
		КонецЕсли;	
		
		НомерПередачиПоПорядку = 0;
		Для каждого ТекСтрока Из ДокументыПередачи Цикл
			НомерПередачиПоПорядку =  НомерПередачиПоПорядку + 1;
			ДокументПриложения = ТекСтрока.ДокументПередачи;
			Если ЗначениеЗаполнено(ДокументПриложения) Тогда
				ТипФорматаЭДП = 0;
				Если ТипЗнч(ДокументПриложения) = Тип("ДокументСсылка.НакладнаяНаОтпускМ15") Тогда
					ТипФорматаЭДП = 3;
				ИначеЕсли ТипЗнч(ДокументПриложения) = Тип("ДокументСсылка.НакладнаяНаОтпускИК") Тогда
					ТипФорматаЭДП = 6;
				ИначеЕсли ТипЗнч(ДокументПриложения) = Тип("ДокументСсылка.ПередачаОбъектовОС") Тогда
					ТипФорматаЭДП = 7;
				ИначеЕсли ТипЗнч(ДокументПриложения) = Тип("ДокументСсылка.ПередачаОбъектовИК") Тогда
					ТипФорматаЭДП = 8;
				ИначеЕсли ТипЗнч(ДокументПриложения) = Тип("ДокументСсылка.ПоступлениеМЗ") Тогда
					ТипФорматаЭДП = 9;
				ИначеЕсли ТипЗнч(ДокументПриложения) = Тип("ДокументСсылка.ПоступлениеИК") Тогда
					ТипФорматаЭДП = 10;
				ИначеЕсли ТипЗнч(ДокументПриложения) = Тип("ДокументСсылка.ПоступлениеОС") Тогда
					ТипФорматаЭДП = 11;
				ИначеЕсли ТипЗнч(ДокументПриложения) = Тип("ДокументСсылка.ПоступлениеОСИК") Тогда
					ТипФорматаЭДП = 12;
				КонецЕсли;
				
				Если (ТипФорматаЭДП >= 9) ИЛИ (ТипФорматаЭДП <= 12) Тогда
					ЗаполнитьСведенияДокументовПоставщиковПоДокументамПоступления(СтруктураДанных, ВыборкаШапки, ПараметрыФормирования, ТипФорматаЭДП, ДокументXDTO, ДокументПриложения);
				КонецЕсли;
				
				Если (ТипФорматаЭДП = 3) ИЛИ (ТипФорматаЭДП = 6) Тогда
					ДокументПоставщикаXDTO = СоздатьОбъектXDTO(ДокументXDTO, "ДокументыПоставщика");

					ВидДокумента = НСтр("ru = 'Накладная на отпуск материалов (материальных ценностей) на сторону'");
					ДатаДокумента = Формат(ДокументПриложения.Дата, "ДФ=dd.MM.yyyy");
					НомерДокумента = ДокументПриложения.Номер;

					НФАПоДокументуПереданыЭлектроннымАктом = НФАПоДокументуПереданыЭлектроннымАктом(ДокументПриложения);
					ДокументПоставщикаXDTO.НФАПереданыЭлектроннымАктом = НФАПоДокументуПереданыЭлектроннымАктом;
					ДокументПоставщикаXDTO.СведенияПолучателяНФА = Ложь;
					
					Если НФАПоДокументуПереданыЭлектроннымАктом Тогда
						ВидДокумента = НСтр("ru = 'Акт о приеме-передаче объектов нефинансовых активов'");
					КонецЕсли;
					
					Если (ТипИзвещения = 25) Тогда
						ДокументПоставщикаXDTO.СведенияПолучателяНФА = Истина;
					КонецЕсли;	
					
					ДокументПоставщикаXDTO.Установить("ВидДокумента", ВидДокумента);
					ДокументПоставщикаXDTO.Установить("Дата", ДатаДокумента);
					ДокументПоставщикаXDTO.Установить("Номер", НомерДокумента);

					НаименованиеДокументаПоставщика = СокрЛП(ВидДокумента) + " от " + ДатаДокумента + " № " 
						+ СокрЛП(НомерДокумента);
					ДокументПоставщикаXDTO.Установить("Наим", НаименованиеДокументаПоставщика);
					
					ЭлектронныйДокументПоставщика = ДокументПриложения;
					
					ДокументПередачиПоставщика = Новый ТаблицаЗначений;
					ДокументПередачиПоставщика.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число"));
					ДокументПередачиПоставщика.Колонки.Добавить("ДокументПередачи", СтруктураДанных.ДокументыПередачи.Колонки.ДокументПередачи.ТипЗначения);
					НоваяСтрокаДок = ДокументПередачиПоставщика.Добавить();
					НоваяСтрокаДок.НомерСтроки = НомерПередачиПоПорядку;
					НоваяСтрокаДок.ДокументПередачи = ЭлектронныйДокументПоставщика;
					ПередаваемыеПроводкиДокументаПоставщика = ПроводкиПоДокументамПередачи(ДокументПередачиПоставщика, ПараметрыФормирования.СсылкаНаОбъект);
					
					ДокументПоставщикаXDTO.Установить("СуммаДокумента", ПередаваемыеПроводкиДокументаПоставщика.Итог("Сумма"));
					ДокументПоставщикаXDTO.Установить("GUIDДокумента", Строка(ЭлектронныйДокументПоставщика.УникальныйИдентификатор()));
					ДокументПоставщикаXDTO.Установить("ТипФорматаЭД", Формат(ТипФорматаЭДП,"ЧЦ=10"));
					ДокументПоставщикаXDTO.Установить("СуммаВключаетНДС", ?(ЭлектронныйДокументПоставщика.СуммаВключаетНДС,"Да","Нет"));
					Если ТипФорматаЭДП = 3 Тогда
						ВалютаДокумента = ЭлектронныйДокументПоставщика.ВалютаДокумента;
					Иначе
						ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
					КонецЕсли;	
					
					Если ЗначениеЗаполнено(ВалютаДокумента) Тогда
						ДокументПоставщикаXDTO.Установить("ВалютаКод", ВалютаДокумента.Код);
						ДокументПоставщикаXDTO.Установить("ВалютаНаим", СокрЛП(ВалютаДокумента));
					КонецЕсли;
					
					Перевозчик = ЭлектронныйДокументПоставщика.Перевозчик;
					Если ЗначениеЗаполнено(Перевозчик) Тогда
						СведенияОбУчастнике = Неопределено; 
						ПолучитьДанныеЮрФизЛица(Перевозчик, СведенияОбУчастнике);
						
						СтрокаСпискаКонтрагентовXDTO = СоздатьОбъектXDTO(ДокументПоставщикаXDTO, "Контрагенты");
						СтрокаСпискаКонтрагентовXDTO.Установить("Наим", СведенияОбУчастнике.ПолноеНаименование);
						СтрокаСпискаКонтрагентовXDTO.Установить("ВидУчастника", "Перевозчик");
						
						РегистрационныеСведенияXDTO = СоздатьОбъектXDTO(СтрокаСпискаКонтрагентовXDTO, "СвЮЛ");
						РегистрационныеСведенияXDTO.Установить("Наим", СведенияОбУчастнике.ПолноеНаименование);
						РегистрационныеСведенияXDTO.Установить("ИНН",  СведенияОбУчастнике.ИНН);
						РегистрационныеСведенияXDTO.Установить("КПП",  СведенияОбУчастнике.КПП);
						РегистрационныеСведенияXDTO.Установить("ОКПО",  СведенияОбУчастнике.КодОКПО);
						РегистрационныеСведенияXDTO.Установить("КодПоБК",  "");
						СтрокаСпискаКонтрагентовXDTO.Установить("СвЮЛ", РегистрационныеСведенияXDTO);
						
						Если ЗначениеЗаполнено(СведенияОбУчастнике.Телефоны) Тогда
							КонтактXDTO = СоздатьОбъектXDTO(СтрокаСпискаКонтрагентовXDTO, "Контакт");
							КонтактXDTO.Установить("Телефон", СведенияОбУчастнике.Телефоны);
							СтрокаСпискаКонтрагентовXDTO.Установить("Контакт", КонтактXDTO);
						КонецЕсли;
						
						Если ЗначениеЗаполнено(СведенияОбУчастнике.ЮридическийАдрес) Тогда
							АдресXDTO = СоздатьОбъектXDTO(СтрокаСпискаКонтрагентовXDTO, "Адрес");
							АдресXDTO.Установить("Наим", СведенияОбУчастнике.ЮридическийАдрес);
							АдресXDTO.Установить("Тип", "ЮридическийАдрес");
							СтрокаСпискаКонтрагентовXDTO.Адрес.Добавить(АдресXDTO);
						КонецЕсли;							
						ДокументПоставщикаXDTO.Контрагенты.Добавить(СтрокаСпискаКонтрагентовXDTO);
						
					КонецЕсли;
					
					СписокНоменклатурыCИдентификаторами = Новый ТаблицаЗначений;
					СписокНоменклатурыCИдентификаторами.Колонки.Добавить("Номенклатура");
					СписокНоменклатурыCИдентификаторами.Колонки.Добавить("ИдентификаторСтроки", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(36)));
					СписокНоменклатурыCИдентификаторами.Колонки.Добавить("ЕдиницаИзмерения", Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"));
					
					Если (ТипФорматаЭДП = 3) Тогда
						Для каждого ТекНоменклатура Из ЭлектронныйДокументПоставщика.Материалы Цикл
							
							ДанныеПроводок = ДанныеДляНоменклатурыИзПередаваемыхПроводок(ПередаваемыеПроводкиДокументаПоставщика, ТекНоменклатура);
							
							Номенклатура = ТекНоменклатура.Номенклатура;
							
							ЗначенияРеквизитовНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, "GUIDНоменклатурыОтправителя");
							
							СтрокаСпискаНоменклатурыXDTO = СоздатьОбъектXDTO(ДокументПоставщикаXDTO, "СписокНоменклатурыПоставщика");
							СтрокаСпискаНоменклатурыXDTO.Установить("GUIDНоменклатуры", Строка(Номенклатура.УникальныйИдентификатор()));
							СтрокаСпискаНоменклатурыXDTO.Установить("GUIDНоменклатурыОтправителя", Строка(ЗначенияРеквизитовНоменклатуры.GUIDНоменклатурыОтправителя));
							
							НоваяНоменклатураИGUID = СписокНоменклатурыCИдентификаторами.Добавить();
							НоваяНоменклатураИGUID.Номенклатура = Номенклатура;
							НоваяНоменклатураИGUID.ИдентификаторСтроки = ТекНоменклатура.ИдентификаторСтроки;
							НоваяНоменклатураИGUID.ЕдиницаИзмерения = Штуки();
							
							СтрокаСпискаНоменклатурыXDTO.Установить("НаимНоменклатуры", Номенклатура.Наименование);
							СтрокаСпискаНоменклатурыXDTO.Установить("ПолноеНаимНоменклатуры", Номенклатура.НаименованиеПолное);
							СтрокаСпискаНоменклатурыXDTO.Установить("СтавкаНДС", СтавкаНДССтрокой(ТекНоменклатура.СтавкаНДС));
							РодительскаяГруппа = ТекНоменклатура.Номенклатура.Родитель;
							СтрокаСпискаНоменклатурыXDTO.Установить("ГруппаСправочника", СокрЛП(РодительскаяГруппа));
							СтрокаСпискаНоменклатурыXDTO.Установить("НоменклатурныйНомер", Номенклатура.НоменклатурныйНомер);
							ПризнакНоменклатуры = НСтр("ru = '1МЗ'");
							СтрокаСпискаНоменклатурыXDTO.Установить("ПризнакНоменклатуры", ПризнакНоменклатуры);
							
							СтрокаСпискаНоменклатурыXDTO.Установить("Цена", Формат(ДанныеПроводок.Цена, "ЧЦ=17; ЧДЦ=2"));
							СтрокаСпискаНоменклатурыXDTO.Установить("Сумма", Формат(ДанныеПроводок.Сумма, "ЧЦ=17; ЧДЦ=2"));
							СтрокаСпискаНоменклатурыXDTO.Установить("Количество", Формат(ТекНоменклатура.Количество, "ЧЦ=17; ЧДЦ=3"));
							СтрокаСпискаНоменклатурыXDTO.Установить("СуммаНДС", Формат(ДанныеПроводок.СуммаНДС, "ЧЦ=17; ЧДЦ=2"));
							СтрокаСпискаНоменклатурыXDTO.Установить("Всего", Формат(ДанныеПроводок.Всего, "ЧЦ=17; ЧДЦ=2"));
							
							Если ТипЗнч(ТекНоменклатура.Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
								СтрокаСпискаНоменклатурыXDTO.Установить("ТипСправочника", НСтр("ru = 'Номенклатура'"));
								Если ЗначениеЗаполнено(Номенклатура.ЕдиницаИзмерения) Тогда
									ЕдиницаИзмерения = Номенклатура.ЕдиницаИзмерения;
									СтрокаСпискаНоменклатурыXDTO.Установить("ЕдИзмКод", ЕдиницаИзмерения.Код);
									СтрокаСпискаНоменклатурыXDTO.Установить("ЕдИзмНаим", ЕдиницаИзмерения.Наименование);
									НоваяНоменклатураИGUID.ЕдиницаИзмерения = ЕдиницаИзмерения;
								Иначе	
									СтрокаСпискаНоменклатурыXDTO.Установить("ЕдИзмКод", "");
									СтрокаСпискаНоменклатурыXDTO.Установить("ЕдИзмНаим", "");
								КонецЕсли;
								
								СтрокаСпискаНоменклатурыXDTO.Установить("ТипНоменклатуры", XMLстрока(Номенклатура.ТипНоменклатуры));
								
								Если ЗначениеЗаполнено(Номенклатура.СтранаПроисхождения) Тогда
									СтранаПроисхождения = Номенклатура.СтранаПроисхождения;
									СтрокаСпискаНоменклатурыXDTO.Установить("СтранаПроисхожденияКод", СтранаПроисхождения.Код);
									СтрокаСпискаНоменклатурыXDTO.Установить("СтранаПроисхождения", СтранаПроисхождения.Наименование);
								Иначе	
