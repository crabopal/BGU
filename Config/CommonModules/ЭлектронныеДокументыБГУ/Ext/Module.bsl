Функция ДоговорКонтрагентаПоРеквизитам(РеквизитыДоговора) Экспорт
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Договоры.Ссылка КАК Договор
	|ИЗ
	|	Справочник.Договоры КАК Договоры
	|ГДЕ
	|	Договоры.НомерДоговора = &НомерДоговора
	|	И Договоры.ДатаДоговора = &ДатаДоговора
	|	И Договоры.Контрагент = &Контрагент";
	
	Если РеквизитыДоговора.Свойство("Организация") Тогда
		ТекстЗапроса = ТекстЗапроса + " И Договоры.Организация = &Организация";
		Запрос.УстановитьПараметр("Организация", РеквизитыДоговора.Организация);
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("Контрагент", РеквизитыДоговора.Владелец);
	Запрос.УстановитьПараметр("НомерДоговора", РеквизитыДоговора.НомерДоговора);
	Запрос.УстановитьПараметр("ДатаДоговора", РеквизитыДоговора.ДатаДоговора);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.Договор;
	
КонецФункции

Функция ДанныеДляНоменклатурыИзПередаваемыхПроводок(ПередаваемыеПроводки, ДанныеОтбораНоменклатуры) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Цена", 0);
	Результат.Вставить("СтавкаНДС", Перечисления.СтавкиНДС.ПустаяСсылка());
	Результат.Вставить("СуммаНДС", 0);
	Результат.Вставить("Сумма", 0);
	Результат.Вставить("Всего", 0);
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("СубконтоКт1", ДанныеОтбораНоменклатуры.Номенклатура);
	ПараметрыОтбора.Вставить("СчетКт", ДанныеОтбораНоменклатуры.СчетУчета);
	Если ЗначениеЗаполнено(ДанныеОтбораНоменклатуры.КПС) Тогда
		ПараметрыОтбора.Вставить("КПСКт", ДанныеОтбораНоменклатуры.КПС);
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеОтбораНоменклатуры.КЭК) Тогда
		ПараметрыОтбора.Вставить("КЭККт", ДанныеОтбораНоменклатуры.КЭК);
	КонецЕсли;
	ПараметрыОтбора.Вставить("Количество", ДанныеОтбораНоменклатуры.Количество);
	НайденныеСтроки = ПередаваемыеПроводки.НайтиСтроки(ПараметрыОтбора);
	
	Если НайденныеСтроки.Количество()>0 Тогда
		Количество = ДанныеОтбораНоменклатуры.Количество;
		Цена = НайденныеСтроки[0].Сумма / Количество;
		Результат.Цена = Цена;
		Результат.Сумма = НайденныеСтроки[0].Сумма;
		Результат.Всего = НайденныеСтроки[0].Сумма;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

