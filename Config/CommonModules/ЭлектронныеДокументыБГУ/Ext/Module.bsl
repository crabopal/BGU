			ОбособленноеПодразделениеКПП = ДанныеКонтрагента.КПП;
			ЗаполнитьДанныеУчастникаУПД_2019(ДеревоДанных, "СведенияОПокупателе", "СведенияОбУчастнике", 
				КонтрагентГоловнаяОрганизация, РеквизитыШапки.ДатаАкта, Ложь,,, ОбособленноеПодразделениеКПП, ДанныеЭлектронногоАктирования);
