		Сопоставление = ТекТовар.Сопоставление;
		
		Если Сопоставление <> Неопределено Тогда
			Если ЗначениеЗаполнено(Сопоставление.Идентификатор) Тогда
				СтрокаТаблицы.ИдентификаторПоставщика = Сопоставление.Идентификатор;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Сопоставление.НоменклатураИБ) Тогда
				СтрокаТаблицы.НФА = Сопоставление.НоменклатураИБ;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Сопоставление.УпаковкаИБ) Тогда
				СтрокаТаблицы.ЕдиницаИзмерения = Сопоставление.УпаковкаИБ;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ДанныеЗаполненияШапки.Вставить("СоставНФА", ТаблицаТоваров);
	
	ДобавитьКомментарийПриНаличииОшибокУПД_5_03(ДанныеЗаполненияШапки, СписокОшибок);
	
	РежимЗаписи = РежимЗаписиДокумента.Запись;
	Попытка
		Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
			ДокументОбъект = СсылкаНаВладельца.ПолучитьОбъект();
			Если ДокументОбъект.Проведен Тогда 
				Текст = НСтр("ru = 'Операция возможна только для непроведенных документов!'");
			КонецЕсли;
		Иначе
			УстановитьПривилегированныйРежим(истина);
			ДокументОбъект = Документы.ИсправительныйСчетФактураПолученный.СоздатьДокумент();
			ДокументОбъект.Дата = ТекущаяДатаСеанса();
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(ДокументОбъект, ДанныеЗаполненияШапки);
		ДокументОбъект.ОбменДанными.Загрузка = Истина;
		ДокументОбъект.ДополнительныеСвойства.Вставить("ЕстьСоглашение", Истина);
		
		СчетФактураПолученный = ОпределитьСчетФактуруПолученый(ДокументОбъект,
			ДанныеЗаполненияШапки.Организация, 
			ДанныеЗаполненияШапки.НомерИсходногоДокумента,
			ДанныеЗаполненияШапки.ДатаИсходногоДокумента);
			
		Если ЗначениеЗаполнено(СчетФактураПолученный) Тогда
			ДокументОбъект.ДокументОснование = СчетФактураПолученный;
			ДокументОбъект.Договор = СчетФактураПолученный.Договор;
			ДокументОбъект.ИсправляемыйДокумент = СчетФактураПолученный;
			Если ТипЗнч(СчетФактураПолученный) = Тип("ДокументСсылка.ИсправительныйСчетФактураПолученный") Тогда
				ДокументОбъект.ИсправляемыйДокумент = СчетФактураПолученный.ИсправляемыйДокумент;
				ДатаИсправляемогоСчетаФактуры = ДокументОбъект.ИсправляемыйДокумент.Дата;
			ИначеЕсли ТипЗнч(СчетФактураПолученный) = Тип("ДокументСсылка.КорректировочныйСчетФактураПолученный") Тогда
				ДатаИсправляемогоСчетаФактуры = СчетФактураПолученный.ИсправляемыйДокумент.Дата;
			ИначеЕсли ТипЗнч(СчетФактураПолученный) = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
				ДатаИсправляемогоСчетаФактуры = СчетФактураПолученный.Дата;
			КонецЕсли;	
			ДокументОбъект.ПричинаНалогообложения = СчетФактураПолученный.ПричинаНалогообложения;
			ДокументОбъект.ВариантРегистрации = Перечисления.ВариантыРегистрацииДляКорректирующихСФ.ВКнигеПродажПокупок;
			НачалоКварталаДляДокумента = НачалоКвартала(ДокументОбъект.Дата);
			Если ДатаИсправляемогоСчетаФактуры < НачалоКварталаДляДокумента Тогда
				ДокументОбъект.ВариантРегистрации = Перечисления.ВариантыРегистрацииДляКорректирующихСФ.ВДопЛистахКнигПродажПокупок;
				ДокументОбъект.КорректируемыйПериод = ДатаИсправляемогоСчетаФактуры;
			КонецЕсли;	
		КонецЕсли;		
		
		ДокументОбъект.СоставНФА.Очистить();
		Если ДанныеЗаполненияШапки.Свойство("СоставНФА") И ЗначениеЗаполнено(ДанныеЗаполненияШапки.СоставНФА) Тогда
			ДозаполнитьСторноИсправительногоСчетаФактурыПолученного(ДанныеЗаполненияШапки.СоставНФА, СчетФактураПолученный, "СФ");
			ДокументОбъект.СоставНФА.Загрузить(ДанныеЗаполненияШапки.СоставНФА);
		КонецЕсли;
		
		ДокументОбъект.ДополнительныеСвойства.Вставить("ПроцессыОбработкиДокументов_ЗаписатьБезПроверкиОбменДаннымиЗагрузка", Истина);
		Если Записывать Тогда
			Если НЕ ЗначениеЗаполнено(ДокументОбъект.Номер) Тогда
				ДокументОбъект.УстановитьНовыйНомер();
			КонецЕсли;
			ДокументОбъект.Записать(РежимЗаписи);
			СсылкаНаВладельца = ДокументОбъект.Ссылка;
		Иначе
			СсылкаНаВладельца = ДокументОбъект;
		КонецЕсли;
	Исключение
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Заполнение документа на основе ЭД. %1'"), Текст)
			+ Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ВыполнитьЗаписьСобытияПоЭДВЖурналРегистрации(ТекстСообщения,
			2, УровеньЖурналаРегистрации.Ошибка, ДокументОбъект.Метаданные(), СсылкаНаВладельца);
		ВызватьИсключение(Текст);
	КонецПопытки;
	
КонецПроцедуры	

Процедура СравнитьСчетФактуруИЭДУПД_5_03(ДеревоДанных, СсылкаНаВладельца = Неопределено, Записывать = Истина, СпособОбработки = "", ВидПервичногоДокумента = "", БезСообщенийОбОтсутствииРасхождений)
	
	Исправление = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ДеревоДанных, "СведенияОСчетеФактуре.Исправление");
	
	Если ЗначениеЗаполнено(Исправление.НомерИсправления) Или ЗначениеЗаполнено(Исправление.ДатаИсправления) Тогда
		Возврат;
	КонецЕсли;
	
	ВалютаКодЭД = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ДеревоДанных, "СведенияОСчетеФактуре.Валюта.Код");
	
	ВалютаЭД = Неопределено;
	НайтиСсылкуНаОбъект("Валюты", ВалютаЭД, ВалютаКодЭД);
	ВалютаЭД = Строка(ВалютаЭД);
	
	ТаблицаТоваровЭД = ПолучитьТаблицуТоваровЭДДляСравненияУПД_5_03(ДеревоДанных);
	
	СуммаПоЭД = ТаблицаТоваровЭД.Итог("Сумма");
	ВсегоПоЭД = ТаблицаТоваровЭД.Итог("Всего");
	КоличествоПоЭД = ТаблицаТоваровЭД.Итог("Количество");
	СуммаНДСПоЭД = ТаблицаТоваровЭД.Итог("СуммаНДС");
	
	ТаблицаТоваровПоДокументу = СсылкаНаВладельца.СоставНФА.Выгрузить();
	
	СуммаПоДокументу = ТаблицаТоваровПоДокументу.Итог("Сумма");
	ВсегоПоДокументу = ТаблицаТоваровПоДокументу.Итог("Всего");
	КоличествоПоДокументу = ТаблицаТоваровПоДокументу.Итог("Количество");
	СуммаНДСПоДокументу = ТаблицаТоваровПоДокументу.Итог("СуммаНДС");
	
	МассивОшибок = Новый Массив;
	
	Если СуммаПоЭД <> СуммаПоДокументу Тогда
		ШаблонТекстаОшибки = НСтр("ru = 'Итоговая сумма %1 %2 не равна итоговой сумме в электронном документе %3 %4.'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонТекстаОшибки, Формат(СуммаПоДокументу, "ЧЦ=17; ЧДЦ=2"), Строка(СсылкаНаВладельца.ВалютаДокумента), Формат(СуммаПоЭД, "ЧЦ=17; ЧДЦ=2"), ВалютаЭД);
		МассивОшибок.Добавить(ТекстОшибки);	
	КонецЕсли;	
	
	Если ВсегоПоЭД <> ВсегоПоДокументу Тогда
		ШаблонТекстаОшибки = НСтр("ru = 'Итоговая сумма в графе ""Всего"" %1 %2 не равна итоговой сумме в графе ""Всего"" в электронном документе %3 %4.'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонТекстаОшибки, Формат(ВсегоПоДокументу, "ЧЦ=17; ЧДЦ=2"), Строка(СсылкаНаВладельца.ВалютаДокумента), Формат(ВсегоПоЭД, "ЧЦ=17; ЧДЦ=2"), ВалютаЭД);
		МассивОшибок.Добавить(ТекстОшибки);	
	КонецЕсли;
	
	Если СуммаНДСПоЭД <> СуммаНДСПоДокументу Тогда
		ШаблонТекстаОшибки = НСтр("ru = 'Итоговая сумма НДС %1 %2 не равна итоговой сумме НДС в электронном документе %3 %4.'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонТекстаОшибки, Формат(СуммаНДСПоДокументу, "ЧЦ=17; ЧДЦ=2"), Строка(СсылкаНаВладельца.ВалютаДокумента), Формат(СуммаНДСПоЭД, "ЧЦ=17; ЧДЦ=2"), ВалютаЭД);
		МассивОшибок.Добавить(ТекстОшибки);	
	КонецЕсли;
	
	Если КоличествоПоЭД <> КоличествоПоДокументу Тогда
		ШаблонТекстаОшибки = НСтр("ru = 'Итоговое количество %1 не равно итоговому количеству в электронном документе %2.'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонТекстаОшибки, Формат(КоличествоПоДокументу, "ЧЦ=15; ЧДЦ=3"), Формат(КоличествоПоЭД, "ЧЦ=15; ЧДЦ=3"));
		МассивОшибок.Добавить(ТекстОшибки);	
	КонецЕсли;	
	
	Если МассивОшибок.Количество() > 0 Тогда
		ШаблонТекстаОшибки = НСтр("ru = 'При сравнении данных документа и электронного документа ЭДО найдено %1 %2 в списке ""Товары, работы, услуги"":'");
		КоличествоРасхождений = МассивОшибок.Количество();
		ТекстСловоРасхождение = НСтр("ru = 'расхождения'");
		Если КоличествоРасхождений = 1 Тогда
			ТекстСловоРасхождение = НСтр("ru = 'расхождение'");
		КонецЕсли;	
		ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонТекстаОшибки, Формат(КоличествоРасхождений, "ЧЦ=15; ЧДЦ=0"), ТекстСловоРасхождение);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки, СсылкаНаВладельца);
		
		Для Каждого ТекОшибка Из МассивОшибок Цикл
			ОписаниеОшибки = ТекОшибка;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки, СсылкаНаВладельца);
		КонецЦикла;
		
		ШаблонТекстаСообщения = НСтр("ru = 'Для просмотра представления электронного документа ЭДО можно воспользоваться командой ""Просмотреть электронный документ"" в подменю ""ЭДО"".'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ШаблонТекстаСообщения, СсылкаНаВладельца);
		
	Иначе
		Если Не БезСообщенийОбОтсутствииРасхождений Тогда
			ШаблонТекстаСообщения = НСтр("ru = 'При сравнении данных документа и электронного документа ЭДО расхождений не найдено.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ШаблонТекстаСообщения, СсылкаНаВладельца);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьТаблицуТоваровЭДДляСравненияУПД_5_03(ДеревоДанных)
	
	// Возвращает таблицу заполненную сведениям ЭД, но с составом колонок как в документе счета-фактуры.
	
	ТаблицаТоваров = Документы.СчетФактураПолученный.ПустаяСсылка().СоставНФА.ВыгрузитьКолонки("Количество,Сумма,СуммаНДС,Всего");
	
	ТаблицаТоваровЭД = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ДеревоДанных, "ТаблицаСчетаФактуры.СведенияОбОтгруженныхПозициях");
	
	Для Каждого СтрокаТаблицы Из ТаблицаТоваровЭД Цикл
		НоваяСтрока = ТаблицаТоваров.Добавить();
		
		НоваяСтрока.Количество	= СтрокаТаблицы.Количество;
		НоваяСтрока.Сумма		= СтрокаТаблицы.СтоимостьБезНалога;
		НоваяСтрока.СуммаНДС	= СтрокаТаблицы.СуммаНалога.Сумма;
		НоваяСтрока.Всего		= СтрокаТаблицы.СтоимостьСНалогом;
	КонецЦикла;
	
	Возврат ТаблицаТоваров;
	
КонецФункции

Процедура ЗаполнитьКодыМаркировкиИзДереваЭлектронногоДокументаУПД_5_03(ДокументОбъект, СтрокаТаблицыТоваров, СтрокаТаблицыЭД)
	
	// В программе поддерживаются только типы упаковки "Индивидуальная упаковка" и "Транспортная упаковка".
	// Отдельного типа упаковки для контрольных знаков не предусмотрено.
	
	ТипыУпаковок = Новый Структура();
	ТипыУпаковок.Вставить("Индивидуальная", "Индивидуальная упаковка");
	ТипыУпаковок.Вставить("Транспортная", "Транспортная упаковка");
	
	ТаблицаДокумента = ДокументОбъект.КодыУпаковокМаркируемойПродукции;
	
	Для Каждого СтрокаМаркировки Из СтрокаТаблицыЭД.СведенияОМаркировке Цикл
		Если ТипЗнч(СтрокаМаркировки.Идентификатор) = Тип("Структура") Тогда
			Если СтрокаМаркировки.Идентификатор.Свойство("КонтрольныеЗнаки") Тогда
				// Контрольные знаки, пока они не поддерживаются, отражаем как обычную транспортную упаковку.
				
				Для Каждого СтрокаУпаковки Из СтрокаМаркировки.Идентификатор.КонтрольныеЗнаки Цикл
					НоваяСтрока = ТаблицаДокумента.Добавить();
					
					НоваяСтрока.НомерУпаковки		= СтрокаУпаковки.КонтрольныйЗнак;
					НоваяСтрока.ИдентификаторСтроки	= СтрокаТаблицыТоваров.ИдентификаторСтроки;
					НоваяСтрока.ТипУпаковки			= ТипыУпаковок.Транспортная;
				КонецЦикла;
				
				Продолжить;
				
			ИначеЕсли СтрокаМаркировки.Идентификатор.Свойство("ИдентификаторыУпаковок") Тогда
				// Индивидуальная упаковка со всех строк собрана в одной таблице и записана в одной строке маркировки.
				
				Для Каждого СтрокаУпаковки Из СтрокаМаркировки.Идентификатор.ИдентификаторыУпаковок Цикл
					НоваяСтрока = ТаблицаДокумента.Добавить();
					
					НоваяСтрока.НомерУпаковки		= СтрокаУпаковки.ИдентификаторУпаковки;
					НоваяСтрока.ИдентификаторСтроки	= СтрокаТаблицыТоваров.ИдентификаторСтроки;
					НоваяСтрока.ТипУпаковки			= ТипыУпаковок.Индивидуальная;
				КонецЦикла;
				
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаМаркировки.ИдентификаторУпаковки) И Не ЗначениеЗаполнено(СтрокаТаблицыЭД.ГТИН) Тогда 
			// Транспортная упаковка.
			НоваяСтрока = ТаблицаДокумента.Добавить();
			
			НоваяСтрока.НомерУпаковки		= СтрокаМаркировки.ИдентификаторУпаковки;
			НоваяСтрока.ИдентификаторСтроки	= СтрокаТаблицыТоваров.ИдентификаторСтроки;
			НоваяСтрока.ТипУпаковки			= ТипыУпаковок.Транспортная;         
		КонецЕсли;
	КонецЦикла;  
	
	Если ЗначениеЗаполнено(СтрокаТаблицыЭД.ГТИН) Тогда 
		НоваяСтрока = ТаблицаДокумента.Добавить();
		НоваяСтрока.НомерУпаковки		= ЭлектронноеВзаимодействиеИСМП.СформироватьКодОСУПоКоличествуИGTIN(СтрокаТаблицыЭД.ГТИН, СтрокаТаблицыЭД.Количество);
		НоваяСтрока.ИдентификаторСтроки	= СтрокаТаблицыТоваров.ИдентификаторСтроки;
		НоваяСтрока.ТипУпаковки			= ТипыУпаковок.Транспортная;	
	КонецЕсли;	
	
КонецПроцедуры

Процедура ДозаполнитьКодыМаркировкиИзДереваЭлектронногоДокументаУПД_5_03(ДеревоДанных, ДокументОбъект)
	
	ТипыУпаковок = Новый Структура();
	ТипыУпаковок.Вставить("Индивидуальная", "Индивидуальная упаковка");
	ТипыУпаковок.Вставить("Транспортная", "Транспортная упаковка");
	
	Путь = "ТаблицаСчетаФактуры.СведенияОбОтгруженныхПозициях";
	СведенияОТоварах = ДеревоДанных.Строки.Найти(Путь, "ПолныйПуть", Истина);
	
	Для Каждого СведенияОТоваре Из СведенияОТоварах.Строки Цикл
		СведенияОМаркировке = СведенияОТоваре.Строки.Найти(Путь + ".НомерСтроки.СведенияОМаркировке", "ПолныйПуть", Истина);
		Если ЗначениеЗаполнено(СведенияОМаркировке.Значение) Тогда
			ПутьМаркировки = Путь + ".НомерСтроки.СведенияОМаркировке.НомерСтроки";
		    Для Каждого ТекущаяМаркировка Из СведенияОМаркировке.Строки Цикл
    			КонтрольныеЗнаки = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
					ТекущаяМаркировка, ПутьМаркировки + ".Идентификатор.КонтрольныеЗнаки");
				ИдентификаторыУпаковок = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
					ТекущаяМаркировка, ПутьМаркировки + ".Идентификатор.ИдентификаторыУпаковок");
					Для Каждого КодМаркировки Из КонтрольныеЗнаки Цикл 
						НоваяСтрока = ДокументОбъект.КодыУпаковокМаркируемойПродукции.Добавить();
						НоваяСтрока.НомерУпаковки		= КодМаркировки.КонтрольныйЗнак;
						НоваяСтрока.ИдентификаторСтроки	= ДокументОбъект.СписокНоменклатуры[СведенияОТоваре.Значение - 1].ИдентификаторСтроки;
						НоваяСтрока.ТипУпаковки			= ТипыУпаковок.Транспортная; 
					КонецЦикла;	
			КонецЦикла;	
		КонецЕсли; 
	КонецЦикла;	
	
КонецПроцедуры

Процедура ЗаполнитьНомераПрослеживаемостиИзДереваЭлектронногоДокументаУПД_5_03(ДокументОбъект, СтрокаТаблицыТоваров, СтрокаТаблицыЭД)
	
	ТаблицаДокумента = ДокументОбъект.СведенияПрослеживаемости;
	
	Для Каждого СтрокаПрослеживаемости Из СтрокаТаблицыЭД.СведенияОПрослеживаемости Цикл
		СтрокаТаблицыТоваров.ПрослеживаемыйТовар = Истина;
		
		НомерТовара						= СтрокаПрослеживаемости.НомерТовара;
		ЕдиницаИзмеренияКод				= СтрокаПрослеживаемости.ЕдиницаИзмеренияКод;
		ЕдиницаИзмеренияНаименование	= СтрокаПрослеживаемости.ЕдиницаИзмеренияНаименование;
		Количество						= СтрокаПрослеживаемости.Количество;
		КоличествоУчетное				= СтрокаПрослеживаемости.КоличествоУчетное;
		СтоимостьБезНДС					= СтрокаПрослеживаемости.СтоимостьБезНДС;
		
		НоваяСтрока = ТаблицаДокумента.Добавить();
		
		НоваяСтрока.ИдентификаторСтроки = СтрокаТаблицыТоваров.ИдентификаторСтроки;
		НоваяСтрока.Количество = ?(КоличествоУчетное <> Неопределено, Число(КоличествоУчетное), Число(Количество));	
		НоваяСтрока.КоличествоПрослеживаемости = Число(Количество);
		НоваяСтрока.СуммаБезНДС = СтоимостьБезНДС;
		
		Если ЗначениеЗаполнено(НомерТовара) Тогда
			НайденнаяСсылка = Справочники.НомераГТД.НайтиПоКоду(НомерТовара);
			Если НайденнаяСсылка = Справочники.НомераГТД.ПустаяСсылка() Тогда
				НоваяСсылка = Справочники.НомераГТД.СоздатьЭлемент();
				НоваяСсылка.Код = НомерТовара;
				НоваяСсылка.Записать();
				
				НайденнаяСсылка = Справочники.НомераГТД.НайтиПоКоду(НомерТовара);
			КонецЕсли;
			НоваяСтрока.РНПТ = НайденнаяСсылка;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры	

