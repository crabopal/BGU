	СоответствиеРеквизитовОбъекта.Вставить("СчетФактураКорректировочныйВыданныйВМетаданных",       "КорректировочныйСчетФактураВыданный");
	СоответствиеРеквизитовОбъекта.Вставить("СчетФактураКорректировочныйПолученныйВМетаданных",     "КорректировочныйСчетФактураПолученный");
	
	СоответствиеРеквизитовОбъекта.Вставить("НомерДоговораКонтрагента",             "НомерДоговора");
	СоответствиеРеквизитовОбъекта.Вставить("ДатаДоговораКонтрагента",              "ДатаДоговора");
	СоответствиеРеквизитовОбъекта.Вставить("ВладелецДоговораКонтрагента",          "Контрагент");
	
	МассивДокументовДляЭДО = Новый Массив;
	МассивДокументовДляЭДО.Добавить("АктОбОказанииУслуг");
	МассивДокументовДляЭДО.Добавить("КорректировочныйСчетФактураВыданный");
