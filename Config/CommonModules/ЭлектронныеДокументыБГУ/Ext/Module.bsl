		ОписаниеРеквизитовДокумента.ИменаКолонокТабЧастиНФА.НФА = "Номенклатура";
		ОписаниеРеквизитовДокумента.ИменаКолонокТабЧастиНФА.ЕдиницаИзмеренияКод = "";
		ОписаниеРеквизитовДокумента.ИменаКолонокТабЧастиНФА.ЕдиницаИзмеренияНаименование = "";
	КонецЕсли;
	
