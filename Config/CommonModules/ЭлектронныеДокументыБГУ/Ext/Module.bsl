					ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОЛицеПринявшемТовары." + ВидЛица + "." + ПодвидЛица + ".Имя", ДанныеФЛ.Имя);
					ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОЛицеПринявшемТовары." + ВидЛица + "." + ПодвидЛица + ".Отчество", ДанныеФЛ.Отчество);
				КонецЕсли;
			КонецЕсли;
			
			СоставительДокумента = ?(ЗначениеЗаполнено(Выборка.ОрганизацияКПП),
				СтрШаблон(НСтр("ru = '%1, ИНН/КПП %2/%3'"),
					Выборка.ОрганизацияНаименованиеПолное, Выборка.ОрганизацияИНН, Выборка.ОрганизацияКПП),
				СтрШаблон(НСтр("ru = '%1, ИНН %2'"),
					Выборка.ОрганизацияНаименованиеПолное, Выборка.ОрганизацияИНН));
					
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
				"СоставительДокументаНаименование", СоставительДокумента);
			
		КонецЕсли;	
		
	ИначеЕсли НЕ РезультатыЗапроса[1].Пустой() Тогда
		
		Выборка = РезультатыЗапроса[1].Выбрать();
		Выборка.Следующий();
		
		ДатаПолученияТоваров = Выборка.Дата;
		
		СоставительДокумента = ?(ЗначениеЗаполнено(Выборка.ОрганизацияКПП),
			СтрШаблон(НСтр("ru = '%1, ИНН/КПП %2/%3'"),
				Выборка.ОрганизацияНаименованиеПолное, Выборка.ОрганизацияИНН, Выборка.ОрганизацияКПП),
			СтрШаблон(НСтр("ru = '%1, ИНН %2'"),
				Выборка.ОрганизацияНаименованиеПолное, Выборка.ОрганизацияИНН));
				
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"СоставительДокументаНаименование", СоставительДокумента);
	
	КонецЕсли;
	
	КодИтога = "1";
	СодержаниеОперации = НСтр("ru = 'Товары (работы, услуги, права) приняты без расхождений (претензий)'");
	Если НЕ Выборка = Неопределено Тогда
		РеквизитыЭДП = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Выборка.Ссылка, "РезультатПриемки");
		Если РеквизитыЭДП.РезультатПриемки = 2 Тогда
			КодИтога = "3";
			СодержаниеОперации = НСтр("ru = 'Товары (работы, услуги, права) не приняты'");
		КонецЕсли;	
		
		АктОРасхождениях = НайтиАктОРасхожденияхПоОснованию(Выборка.Ссылка);
		Если ЗначениеЗаполнено(АктОРасхождениях) Тогда
			РеквизитыАкта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(АктОРасхождениях, "Проведен, Номер, Дата, ВидДокументаРасхождений, ОбстоятельстваСоставленияДокумента,  
			|ОбстоятельстваИспользованияДокументаПерваяЧастьКода, ОбстоятельстваИспользованияДокументаВтораяЧастьКода, НаименованиеЭлектронногоДокумента");
			НаименованиеДокументаАктаОРасхождениях = НСтр("ru = 'Акт об установленном расхождении по количеству и качеству при приемке товарно-материальных ценностей'");
			Если ЗначениеЗаполнено(РеквизитыАкта.НаименованиеЭлектронногоДокумента) Тогда
				НаименованиеДокументаАктаОРасхождениях = РеквизитыАкта.НаименованиеЭлектронногоДокумента;
			КонецЕсли;	
			Если РеквизитыАкта.Проведен Тогда
				Если КодИтога = "1" Тогда
					КодИтога = "2";
					СодержаниеОперации = НСтр("ru = 'Товары (работы, услуги, права) приняты с расхождениями (претензией)'");
				КонецЕсли;
				Путь = "СведенияОПринятииТоваров.ДокументОРасхождениях.";
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + "Наименование", НаименованиеДокументаАктаОРасхождениях);
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + "Вид", ?(РеквизитыАкта.ВидДокументаРасхождений = 1, "3", "2"));
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + "Номер", НомерДляПечати(АктОРасхождениях, РеквизитыАкта.Номер));
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + "Дата", РеквизитыАкта.Дата);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОПринятииТоваров.ДатаПолученияТоваров", ДатаПолученияТоваров);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОПринятииТоваров.СодержаниеОперации", СодержаниеОперации);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "СведенияОПринятииТоваров.КодИтога", КодИтога);
	
	Если НЕ РезультатыЗапроса[2].Пустой() Тогда
		Выборка = РезультатыЗапроса[2].Выбрать();
		Выборка.Следующий();
		
		ДатаСведений = Выборка.Дата;
		ДоговорКонтрагента = Выборка.Договор;
		ОрганизацияПокупатель = Выборка.Организация;
		НомерБюджетногоОбязательстваПокупателя = РаботаСОбязательствами.ПолучитьУчетныйНомерОбязательства(ДоговорКонтрагента);
		НеЗаполнятьСведенияУПДОЗакупкеДляГосНужд = НеЗаполнятьСведенияУПДОЗакупкеДляГосНужд(ОрганизацияПокупатель);
		
		Если ЗначениеЗаполнено(НомерБюджетногоОбязательстваПокупателя) И (НеЗаполнятьСведенияУПДОЗакупкеДляГосНужд = Ложь) Тогда
			НаименованиеИКЗ =  ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.ИКЗ.Наименование;
			КодЗакупки = РаботаСОбязательствами.ЗначениеХарактеристикиОбязательства(ДоговорКонтрагента, КонецДня(ДатаСведений), НаименованиеИКЗ);
			
			СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОрганизацияПокупатель, "Бюджет, КодОКТМО, КодПоРПБС");
			НомерРеестровойЗаписиПокупателя = СтруктураДанных.КодПоРПБС;
			КодОКТМОПокупателя = СтруктураДанных.КодОКТМО;
			Если ЗначениеЗаполнено(Выборка.ГосЗакупкаКодОКТМОПокупателя) Тогда
				КодОКТМОПокупателя = Выборка.ГосЗакупкаКодОКТМОПокупателя;
			КонецЕсли;
			Если ЗначениеЗаполнено(Выборка.ОрганизацияППП) Тогда
				КодППП = Выборка.ОрганизацияППП.Код;
			Иначе
				КодППП = "";
			КонецЕсли;
			
			Бюджет = СтруктураДанных.Бюджет;
			
			СтруктураДанныхБюджет = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Бюджет, "НаименованиеФинансовогоОргана");
			НаименованиеФинансовогоОрганаПокупателя = СтруктураДанныхБюджет.НаименованиеФинансовогоОргана;
			
			РеквизитыЛицевогоСчета = Выборка.ГосЗакупкаРеквизитыЛицевогоСчетаПокупателя;
			
			Если ЗначениеЗаполнено(РеквизитыЛицевогоСчета) Тогда
				СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыЛицевогоСчета, "КассовыйОрган, Владелец");
				Казначейство = СтруктураДанных.КассовыйОрган;
				СтруктураДанныхКазначейства = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Казначейство, "НаименованиеПолное, Код");
				ЛицевойСчет = СтруктураДанных.Владелец;
				СтруктураДанныхЛицевогоСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЛицевойСчет, "КодПоРПБС, Код, ИспользоватьДляСчетаУчетныйНомер");
				НомерЛицевогоСчетаПокупателя = СтруктураДанныхЛицевогоСчета.Код;
				КодПоРПБСЛицевогоСчета = СтруктураДанныхЛицевогоСчета.КодПоРПБС;
				ИспользоватьДляСчетаУчетныйНомер = СтруктураДанныхЛицевогоСчета.ИспользоватьДляСчетаУчетныйНомер;
				Если ИспользоватьДляСчетаУчетныйНомер И ЗначениеЗаполнено(КодПоРПБСЛицевогоСчета) Тогда
					НомерРеестровойЗаписиПокупателя = КодПоРПБСЛицевогоСчета;
				КонецЕсли;	
				
				КазначействоПокупателяКод = СтруктураДанныхКазначейства.Код;
				КазначействоПокупателяНаименование = СтруктураДанныхКазначейства.НаименованиеПолное;
			Иначе
				Отказ = Истина;
				
				ТекстСообщения  = НСтр("ru='В документе %ДокументПоставщика% на закладке ""Закупка для государственных нужд"" не указаны необходимы данные (Реквизиты лицевого счета) для организации-покупателя!'");
				ТекстСообщения  = СтрЗаменить(ТекстСообщения,"%ДокументПоставщика%", Выборка.Ссылка);
				Сообщение       = Новый СообщениеПользователю();
				Сообщение.Текст = ТекстСообщения;
				Сообщение.Сообщить();
				
				Возврат
			КонецЕсли;
			
			ГосЗакупка = Новый Структура;
			ГосЗакупка.Вставить("КодЗакупки", КодЗакупки);
			ГосЗакупка.Вставить("НомерЛицевогоСчетаПокупателя", СокрЛП(НомерЛицевогоСчетаПокупателя));
			ГосЗакупка.Вставить("НаименованиеФинансовогоОрганаПокупателя", НаименованиеФинансовогоОрганаПокупателя);
			ГосЗакупка.Вставить("НомерРеестровойЗаписиПокупателя", НомерРеестровойЗаписиПокупателя);
			ГосЗакупка.Вставить("НомерБюджетногоОбязательстваПокупателя", НомерБюджетногоОбязательстваПокупателя);
			ГосЗакупка.Вставить("КазначействоПокупателяКод", СокрЛП(КазначействоПокупателяКод));
			ГосЗакупка.Вставить("КазначействоПокупателяНаименование", КазначействоПокупателяНаименование);
			ГосЗакупка.Вставить("ОКТМОПокупателя", КодОКТМОПокупателя);
			ГосЗакупка.Вставить("ОКТМОМестаПоставки", Выборка.ГосЗакупкаКодОКТМОМестаПоставки);
			ГосЗакупка.Вставить("ПредельнаяДатаОплаты", Выборка.ГосЗакупкаПредельнаяДатаОплаты);
			ГосЗакупка.Вставить("НомерДенежногоОбязательства", Выборка.ГосЗакупкаНомерДенежногоОбязательства);
			ГосЗакупка.Вставить("ОчередностьПлатежа", Строка(Выборка.ГосЗакупкаОчередностьПлатежа));
			ГосЗакупка.Вставить("ВидПлатежа", Выборка.ГосЗакупкаВидПлатежа);
			Путь = "ЗакупкаДляГосударственныхНужд.";
			ГосЗакупкаЗаполнена = Ложь;
			Для каждого КлючЗначение Из ГосЗакупка Цикл
				Если ЗначениеЗаполнено(КлючЗначение.Значение) Тогда
					ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + КлючЗначение.Ключ, КлючЗначение.Значение);
					ГосЗакупкаЗаполнена = Истина;
				КонецЕсли;
			КонецЦикла;
			ДенежныеОбязательства = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ДеревоДанных, Путь + "ДенежныеОбязательства");
			
			ВыборкаОбязательств = Выборка.ГосЗакупкиДенежныеОбязательства.Выбрать();
			Пока ВыборкаОбязательств.Следующий() Цикл
				СтрокаОбязательства = ДенежныеОбязательства.Добавить();
				СтрокаОбязательства.НомерСтрокиИнформацииПродавца = ВыборкаОбязательств.НомерСтроки;
				
				ОбъектФАИП = ВыборкаОбязательств.ОбъектФАИП;
				ДанныеОбъектаФАИП = ДанныеОбъектаФАИП(ОбъектФАИП);
				КодОбъектаФАИП = ДанныеОбъектаФАИП.КодФАИП;
				
				СтрокаОбязательства.КодОбъектаФАИП = КодОбъектаФАИП;
				
				СтруктураДанныхИсточник = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВыборкаОбязательств.ИсточникСредств, "Код");
				КодИсточникаСредствГосЗакупок = СтруктураДанныхИсточник.Код;
				
				СтруктураДанныхКПС = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВыборкаОбязательств.КПС, "Код");
				КодБюджетнойКлассификации = СокрЛП(СтруктураДанныхКПС.Код);
				
				СтруктураДанныхЦели = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВыборкаОбязательств.КодЦели, "Код");
				КодЦели = СокрЛП(СтруктураДанныхЦели.Код);
				
				СтрокаОбязательства.ВидСредств = КодИсточникаСредствГосЗакупок(КодИсточникаСредствГосЗакупок);
				СтрокаОбязательства.КодБюджетнойКлассификации = КодППП+КодБюджетнойКлассификации;
				СтрокаОбязательства.КодЦели = КодЦели;
				СтрокаОбязательства.СуммаАванса = ВыборкаОбязательств.СуммаАванса;
			КонецЦикла;
			Если ЗначениеЗаполнено(ДенежныеОбязательства) Тогда
				ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ДенежныеОбязательства, Путь + "ДенежныеОбязательства");
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;	
	
КонецПроцедуры

Функция КодИсточникаСредствГосЗакупок(Знач КодИсточник)
	
	Результат = Неопределено;
	
	ИсточникЧислом = Число(КодИсточник);
	Результат = Строка(ИсточникЧислом);
	
	Возврат Результат;
	
КонецФункции

Функция ДанныеОбъектаФАИП(ОбъектФАИП)
	КодФАИП = "";
	
	Если ЗначениеЗаполнено(ОбъектФАИП) Тогда
		Если ТипЗнч(ОбъектФАИП) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
			СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОбъектФАИП, "КодФАИП");
			КодФАИП = СтруктураДанных.КодФАИП;
		ИначеЕсли ТипЗнч(ОбъектФАИП) = Тип("СправочникСсылка.МероприятияПоИнформатизации") Тогда
			СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОбъектФАИП, "Код");
			КодФАИП = СтруктураДанных.Код;
		КонецЕсли;
	КонецЕсли;
	
	РезультатСтруктураДанных = Новый Структура;
	РезультатСтруктураДанных.Вставить("КодФАИП", КодФАИП);
	
	Возврат РезультатСтруктураДанных;
КонецФункции

// Сохраняет данные из электронного документа в объекты ИБ (УПД версии 2019).
//
// Параметры:
//  ДеревоДанных - ДеревоЗначений - структура параметров документа ИБ.
//  СсылкиНаВладельцев - Массив - документы информационной базы, созданные ранее по входящему электронному документу.
//  СпособОбработки - Структура - способы сохранения данных в информационной базе.
//     * ПервичныйДокумент - Строка - способ сохранения первичного документа.
//     * СчетФактура       - Строка - способ сохранения счета-фактуры.
//  ОписаниеОшибки - Строка - описание ошибки создания учетного документа.
//
Процедура НайтиСоздатьУниверсальныйПередаточныйДокумент_2019(ДеревоДанных, СсылкиНаВладельцев = Неопределено, СпособОбработки = Неопределено, ОписаниеОшибки = "") Экспорт
	
	Записывать = Истина;
	ВидПервичногоДокумента = НСтр("ru = 'Универсальный передаточный документ'");
	
	ПервичныйДокумент = Неопределено;
	СчетФактура = Неопределено;
	
	СпособОбработкиПервичногоДокумента = "";
	СпособОбработкиСчетаФактуры = "";
	
	Если ЗначениеЗаполнено(СпособОбработки) И ТипЗнч(СпособОбработки) = Тип("Структура") Тогда
		
		Если СпособОбработки.Свойство("ПервичныйДокумент") Тогда
			СпособОбработкиПервичногоДокумента = СпособОбработки.ПервичныйДокумент;
		КонецЕсли;
		
		Если СпособОбработки.Свойство("СчетФактура") Тогда
			СпособОбработкиСчетаФактуры = СпособОбработки.СчетФактура;
		КонецЕсли;
		
	КонецЕсли;	
	
	Если СсылкиНаВладельцев <> Неопределено Тогда
		Для каждого Строка Из СсылкиНаВладельцев Цикл
			Если ТипЗнч(Строка) = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
				СчетФактура = Строка;
			Иначе
				ПервичныйДокумент = Строка;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ФункцияУПД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "Функция");
	ДокументыУчета = Новый Массив;
	
	Если ФункцияУПД = "ДОП" Или ФункцияУПД = "СЧФДОП" Тогда
		НайтиСоздатьУПДДокументОПередаче_2019(ДеревоДанных, ПервичныйДокумент, Записывать, СпособОбработки, ОписаниеОшибки, ВидПервичногоДокумента);
		Если ПервичныйДокумент <> Неопределено Тогда
			ДокументыУчета.Добавить(ПервичныйДокумент);
		КонецЕсли;
	КонецЕсли;
	
	// Заполним основание в СФ.
	ДокументыОснованияСчетаФактуры = ЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияСчетаФактуры");
	Если ЗначениеЗаполнено(ДокументыОснованияСчетаФактуры) И ТипЗнч(ДокументыОснованияСчетаФактуры) = Тип("Массив") Тогда
		Если ДокументыОснованияСчетаФактуры.Количество()>0 Тогда
			ПервичныйДокумент = ДокументыОснованияСчетаФактуры[0];
		КонецЕсли;
	КонецЕсли;
	ДокументыОснованияСчетаФактуры = Новый Массив;
	ДокументыОснованияСчетаФактуры.Добавить(ПервичныйДокумент);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияСчетаФактуры", ДокументыОснованияСчетаФактуры);
	
	Если ФункцияУПД = "СЧФ" Или ФункцияУПД = "СЧФДОП" Тогда
		НайтиСоздатьУПДСчетФактуру_2019(ДеревоДанных, СчетФактура, СпособОбработки, ОписаниеОшибки, Записывать, ВидПервичногоДокумента);
		ДокументыУчета.Добавить(СчетФактура);
	КонецЕсли;
	
	СсылкиНаВладельцев = ДокументыУчета;
	
КонецПроцедуры

// Сохраняет данные из электронного документа в объекты ИБ (УПД-ДОП версии 2019).
//
// Параметры:
//  ДеревоДанных - ДеревоЗначений - структура параметров документа ИБ.
//  СсылкаНаВладельца - Ссылка - ссылка на объект ИБ, владельца электронного документа.
//  Записывать - Булево - признак необходимости записывать объект ИБ.
//  СпособОбработки - Строка - способ сохранения данных в информационной базе.
//  ОписаниеОшибки - Строка - описание ошибки создания учетного документа.
//
Процедура НайтиСоздатьУПДДокументОПередаче_2019(ДеревоДанных, СсылкаНаВладельца = Неопределено, Записывать =Истина, СпособОбработки = "", ОписаниеОшибки = "", ВидПервичногоДокумента = "") Экспорт
	
	ТолькоУслуги = ТолькоУслугиПоСведениямОТоварах(ДеревоДанных);
	ДокументИзЕИС = ЭлектронныйДокументИзЕИС(ДеревоДанных);
	
	Если ТолькоУслуги И НЕ ДокументИзЕИС Тогда
		НайтиСоздатьУПДДокументОПередачеУслугРабот_2019(ДеревоДанных, СсылкаНаВладельца, Записывать, ВидПервичногоДокумента);	
	Иначе
		НайтиСоздатьУПДДокументОПередачеТоваров_2019(ДеревоДанных, СсылкаНаВладельца, Записывать, ВидПервичногоДокумента);
	КонецЕсли;	
	
КонецПроцедуры

// Сохраняет данные из электронного документа в объекты ИБ (УПД-СЧФ версия 2019).
//
// Параметры:
//  ДеревоДанных - ДеревоЗначений - структура параметров документа ИБ.
//  СсылкаНаВладельца - Ссылка - ссылка на объект ИБ, владельца электронного документа.
//  СпособОбработки - Строка - способ сохранения данных в информационной базе.
//  ОписаниеОшибки - Строка - описание ошибки создания учетного документа.
//
Процедура НайтиСоздатьУПДСчетФактуру_2019(ДеревоДанных, СсылкаНаВладельца = Неопределено, СпособОбработки = "", ОписаниеОшибки = "", Записывать =Истина, ВидПервичногоДокумента = "") Экспорт
	Если ТипСчетФактурыУПД(ДеревоДанных) = "ИсправлениеРеализации" Тогда
		НайтиСоздатьУПДИсправительныйСчетФактуру_2019(ДеревоДанных, СсылкаНаВладельца, Записывать);
		Возврат;
	ИначеЕсли ТипСчетФактурыУПД(ДеревоДанных) = "ИсправлениеКорректировки" Тогда	
		НайтиСоздатьУПДИсправительныйСчетФактуру_2019(ДеревоДанных, СсылкаНаВладельца, Записывать, "Корректировка");
		Возврат;
	КонецЕсли;	
		
	ДанныеЗаполненияШапки = Новый Структура;
	ДанныеЗаполненияШапки.Вставить("ЭДПоставщика", Документы.ЭлектронныйДокументПоставщика.ПустаяСсылка());
	
	ДокументыОснованияСчетаФактуры = ЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияСчетаФактуры");
	
	ИдентификаторДокументаОснования = "";
	ТаблицаОснований = Новый ТаблицаЗначений;
	ТаблицаОснований = Документы.СчетФактураПолученный.ПустаяСсылка().ДокументыОснования.ВыгрузитьКолонки();
	Если ЗначениеЗаполнено(ДокументыОснованияСчетаФактуры) Тогда
		Для Каждого ДокументОснования Из ДокументыОснованияСчетаФактуры Цикл
			Если ТипЗнч(ДокументОснования) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда
				ДанныеЗаполненияШапки.ЭДПоставщика = ДокументОснования;
			Иначе	
				СтрокаТаблицы = ТаблицаОснований.Добавить();
				СтрокаТаблицы.ДокументОснование = ДокументОснования;
			КонецЕсли;	
			
		КонецЦикла;
	Иначе
		ДопТекстоваяИнформация = ДеревоДанных.Строки.Найти("ДопДанныеСчетаФактуры.ТекстоваяИнформация", "ПолныйПуть", Истина);
		Если ДопТекстоваяИнформация <> Неопределено Тогда
			Для Каждого СтрокаТекстовойИнформации Из ДопТекстоваяИнформация.Строки Цикл
				Если ЗначениеРеквизитаВДереве(СтрокаТекстовойИнформации, 
						"ДопДанныеСчетаФактуры.ТекстоваяИнформация.НомерСтроки.Идентификатор") = "ИдентификаторДокументаОснования" Тогда
					ИдентификаторДокументаОснования = ЗначениеРеквизитаВДереве(СтрокаТекстовойИнформации,
						"ДопДанныеСчетаФактуры.ТекстоваяИнформация.НомерСтроки.Значение", Ложь);
				КонецЕсли;
			КонецЦикла;	
		КонецЕсли;
	КонецЕсли;
	
	ДокументПоставкиПоИдентификаторуОснованияСчетаФактуры = "";
	Если ЗначениеЗаполнено(ИдентификаторДокументаОснования) Тогда
		ДокументПоставкиПоИдентификаторуОснованияСчетаФактуры = ДокументПоставкиПоИдентификаторуОснованияСчетаФактуры(ИдентификаторДокументаОснования);
		Если ЗначениеЗаполнено(ДокументПоставкиПоИдентификаторуОснованияСчетаФактуры) Тогда
			Если ТипЗнч(ДокументПоставкиПоИдентификаторуОснованияСчетаФактуры) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда
				Если НЕ ЗначениеЗаполнено(ДанныеЗаполненияШапки.ЭДПоставщика) Тогда
					ДанныеЗаполненияШапки.ЭДПоставщика = ДокументПоставкиПоИдентификаторуОснованияСчетаФактуры;
				КонецЕсли;	
			Иначе	
				СтрокаТаблицы = ТаблицаОснований.Добавить();
				СтрокаТаблицы.ДокументОснование = ДокументПоставкиПоИдентификаторуОснованияСчетаФактуры;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
	
	ТаблицаОснований.Свернуть("ДокументОснование");
	
	Если ТаблицаОснований.Количество() = 0 Тогда
		ТекстоваяИнформация = ДеревоДанных.Строки.Найти("ДопДанныеДокументаОтгрузки.ТекстоваяИнформация", "ПолныйПуть", Истина);
		ВидДокументаОснования = "";
		НомерДокументаОснования = "";
		ДатаДокументаОснования = Дата(1,1,1);
		Если ТекстоваяИнформация <> Неопределено Тогда
			Для Каждого СтрокаТекстовойИнформации Из ТекстоваяИнформация.Строки Цикл
				Если ЗначениеРеквизитаВДереве(СтрокаТекстовойИнформации, 
							"ДопДанныеДокументаОтгрузки.ТекстоваяИнформация.НомерСтроки.Идентификатор") = "ВидДокументаОснования" Тогда
					ВидДокументаОснования = ЗначениеРеквизитаВДереве(СтрокаТекстовойИнформации,
							"ДопДанныеДокументаОтгрузки.ТекстоваяИнформация.НомерСтроки.Значение");
				КонецЕсли;
				Если ЗначениеРеквизитаВДереве(СтрокаТекстовойИнформации, 
							"ДопДанныеДокументаОтгрузки.ТекстоваяИнформация.НомерСтроки.Идентификатор") = "НомерДокументаОснования" Тогда
					НомерПервичногоДокумента = ЗначениеРеквизитаВДереве(СтрокаТекстовойИнформации,
							"ДопДанныеДокументаОтгрузки.ТекстоваяИнформация.НомерСтроки.Значение");
				КонецЕсли;
				Если ЗначениеРеквизитаВДереве(СтрокаТекстовойИнформации, 
							"ДопДанныеДокументаОтгрузки.ТекстоваяИнформация.НомерСтроки.Идентификатор") = "ДатаДокументаОснования" Тогда
					ДатаПервичногоДокумента = ЗначениеРеквизитаВДереве(СтрокаТекстовойИнформации,
							"ДопДанныеДокументаОтгрузки.ТекстоваяИнформация.НомерСтроки.Значение");
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;	
	ДанныеЗаполненияШапки.Вставить("ДокументыОснования", ТаблицаОснований);
	
	ДанныеЗаполненияШапки.Вставить("ДатаПолучения", ТекущаяДатаСеанса());
	
	НомерДокумента = ЗначениеРеквизитаВДереве(ДеревоДанных, "НомерДокумента");
	ДатаДокумента = ЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаДокумента");
	
	ВалКод = ЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаКод");
	Если НЕ ВалКод = "643" Тогда
		ДанныеЗаполненияШапки.Вставить("ВИностраннойВалюте", Истина);
	КонецЕсли;
	Валюта = Справочники.Валюты.ПустаяСсылка();
	НайтиСсылкуНаОбъект("Валюты", Валюта, ВалКод);
	ДанныеЗаполненияШапки.Вставить("ВалютаДокумента", Валюта);
	
	// Сведения о поставщике.
	//2019
	СведенияОПродавце = ДеревоДанных.Строки.Найти("СведенияОПродавце", "ПолныйПуть");
	СведенияОПокупателе = ДеревоДанных.Строки.Найти("СведенияОПокупателе", "ПолныйПуть");
	ТекстОшибки = "";
	Если СведенияОПродавце.Строки.Количество() > 1 Тогда
		ТекстОшибки = НСтр("ru = 'загрузка сведений о нескольких продавцах не поддерживается.'");
	КонецЕсли;
	Если СведенияОПокупателе.Строки.Количество() > 1 Тогда
		ТекстОшибки = ?(ЗначениеЗаполнено(ТекстОшибки),ТекстОшибки+",","") + НСтр("ru = 'загрузка сведений о нескольких покупателях не поддерживается.'");
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Комментарий = НСтр("ru = 'Ошибка загрузки электронного документа: '") + ТекстОшибки;
		ДанныеЗаполненияШапки.Вставить("Комментарий", Комментарий);
	КонецЕсли;	
	
	Контрагент = Справочники.Контрагенты.ПустаяСсылка();
	ОсновнаяСтрокаПродавца = Неопределено;
	Для каждого СтрокаПродавца Из СведенияОПродавце.Строки Цикл
		Контрагент = КонтрагентПоДаннымЭД(СтрокаПродавца, "СведенияОПродавце.НомерСтроки");
		ОсновнаяСтрокаПродавца = СтрокаПродавца;
		Прервать;
	КонецЦикла;
	ДанныеЗаполненияШапки.Вставить("Контрагент", Контрагент);
	Организация = Справочники.Организации.ПустаяСсылка();
	Для каждого СтрокаПокупателя Из СведенияОПокупателе.Строки Цикл
		Организация = ОрганизацияПоДаннымЭД(СтрокаПокупателя, "СведенияОПокупателе.НомерСтроки");
		Прервать;
	КонецЦикла;
	ДанныеЗаполненияШапки.Вставить("Организация", Организация);
	
	// Поиск и заполнения договора контрагента.
	Договор = Справочники.Договоры.ПустаяСсылка();
	ОснованияОтгрузки = ДеревоДанных.Строки.Найти("ОснованиеОтгрузкиТоваров", "ПолныйПуть");
	Если Не ОснованияОтгрузки = Неопределено Тогда
		ДоговорНайден = Ложь;
		Для Каждого СтрокаОснованиеОтгрузки Из ОснованияОтгрузки.Строки Цикл
			ДоговорНомер = ЗначениеРеквизитаВДереве(СтрокаОснованиеОтгрузки, "ОснованиеОтгрузкиТоваров.НомерСтроки.ДокументНомер");
			Если ЗначениеЗаполнено(ДоговорНомер) Тогда
				
				ДоговорДата = ДатаИзСтроки(ЗначениеРеквизитаВДереве(
					СтрокаОснованиеОтгрузки, 
					"ОснованиеОтгрузкиТоваров.НомерСтроки.ДокументДата"));
				
				СвойстваДоговора = Новый Структура("НомерДоговора, ДатаДоговора, Владелец, Организация", ДоговорНомер, ДоговорДата, Контрагент, Организация);
				
				Договор = Справочники.Договоры.ПустаяСсылка();
				НайтиСсылкуНаОбъект("ДоговорыКонтрагентов", Договор, , СвойстваДоговора);
				Если ЗначениеЗаполнено(Договор) Тогда
					ДоговорНайден = Истина;
				КонецЕсли;	
			КонецЕсли;
			Если ДоговорНайден Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Договор) Тогда
		Если ЗначениеЗаполнено(ДокументПоставкиПоИдентификаторуОснованияСчетаФактуры) Тогда
			РеквизитыДокументаОснования = "Договор";
			ЗначенияРеквизитовДокументаОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
				ДокументПоставкиПоИдентификаторуОснованияСчетаФактуры,
				РеквизитыДокументаОснования);
			Договор = ЗначенияРеквизитовДокументаОснования.Договор;
		КонецЕсли;	
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(Договор) Тогда
		Договор = ДоговорПоНастройкеЭДО(Контрагент, Организация);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Договор) И ЗначениеЗаполнено(ДанныеЗаполненияШапки.ЭДПоставщика) Тогда
		Договор = ДанныеЗаполненияШапки.ЭДПоставщика.Договор;
	КонецЕсли;	

	ДанныеЗаполненияШапки.Вставить("Договор", Договор);
	ДанныеЗаполненияШапки.Вставить("ДоговорКонтрагента", Договор);
	
	ДанныеЗаполненияШапки.Вставить("СуммаДокумента", ЗначениеРеквизитаВДереве(ДеревоДанных,
		"ВсегоКОплате.ВсегоСтоимостьТоваровСНалогом"));
	
	ВидСчетаФактуры = ЗначениеРеквизитаВДереве(ДеревоДанных, "ВидСчетаФактуры");
	Если ВидСчетаФактуры = "Авансовый" Тогда
		ДанныеЗаполненияШапки.Вставить("КодВидаОперации", "02");
		ДанныеЗаполненияШапки.Вставить("ПричинаНалогообложения", Перечисления.ПричиныНалогообложенияНДС.АвансВыданный);
		ВидЦенности = Перечисления.ВидыЦенностейНДС.Аванс;
	Иначе
		ДанныеЗаполненияШапки.Вставить("КодВидаОперации", "01");
		ДанныеЗаполненияШапки.Вставить("ПричинаНалогообложения", Перечисления.ПричиныНалогообложенияНДС.Покупка);
	КонецЕсли;	
		
	ДанныеЗаполненияШапки.Вставить("КодСпособаВыставления", 2);
	ДанныеЗаполненияШапки.Вставить("НомерПервичногоДокумента", НомерДокумента);
	ДанныеЗаполненияШапки.Вставить("ДатаПервичногоДокумента", ДатаДокумента);
	Если ВидПервичногоДокумента = "" Тогда
		ВидПервичногоДокумента = НСтр("ru = 'Счет-фактура'"); 	
	КонецЕсли;	
	ДанныеЗаполненияШапки.Вставить("ВидПервичногоДокумента", ВидПервичногоДокумента);
	
	СведенияОТоварах = ДеревоДанных.Строки.Найти("СведенияОТоварах", "ПолныйПуть").Строки;
	Если ЗначениеЗаполнено(СведенияОТоварах) Тогда
		ТаблицаТоваров = Документы.СчетФактураПолученный.ПустаяСсылка().СоставНФА.ВыгрузитьКолонки();

		Для Каждого ТекТовар Из СведенияОТоварах Цикл
			СтрокаТаблицы = ТаблицаТоваров.Добавить();
			
			ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка();
			НайтиСсылкуНаОбъект("ЕдиницыИзмерения", ЕдиницаИзмерения, 
				ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.ЕдиницаИзмеренияКод"));

			СтрокаТаблицы.ЕдиницаИзмерения = ЕдиницаИзмерения;
			СтрокаТаблицы.Количество = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.Количество");
			СтрокаТаблицы.Сумма = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.СтоимостьТоваровБезНалога");
			
			СтавкаНДС = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.НалоговаяСтавка");
			
			Если СтавкаНДС = "НДС исчисляется налоговым агентом" Тогда
				СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;	
			КонецЕсли;	
			
			СтрокаТаблицы.СтавкаНДС = СтавкаНДС;
			СтрокаТаблицы.СуммаНДС = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.СуммаНалога");
			СтрокаТаблицы.Всего = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.СтоимостьТоваровСНалогом");
			
			СтрокаТаблицы.СуммаАкциза = ЗначениеРеквизитаВДереве(ТекТовар, "СведенияОТоварах.НомерСтроки.СуммаАкциза");
			
			// Сопоставление
			СведенияОТоваре = ТекТовар;
			
			Сопоставление = СведенияОТоваре.Строки.Найти(
				"СведенияОТоварах.НомерСтроки.Сопоставление", "ПолныйПуть", Истина);
			Если Сопоставление <> Неопределено Тогда
				
				Идентификатор = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.Идентификатор");
				Если ЗначениеЗаполнено(Идентификатор) Тогда
					СтрокаТаблицы.ИдентификаторПоставщика = Идентификатор;
				КонецЕсли;
				
				Номенклатура = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.НоменклатураИБ");
				Если ЗначениеЗаполнено(Номенклатура) Тогда
					СтрокаТаблицы.НФА = Номенклатура;
				КонецЕсли;
				
				ЕдиницаИзмерения = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(СведенияОТоваре,
					"СведенияОТоварах.НомерСтроки.Сопоставление.УпаковкаИБ");
				Если ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
					СтрокаТаблицы.ЕдиницаИзмерения = ЕдиницаИзмерения;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	ДанныеЗаполненияШапки.Вставить("СоставНФА", ТаблицаТоваров);
	
	РежимЗаписи = РежимЗаписиДокумента.Запись;
	Попытка
		Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
			ДокументОбъект = СсылкаНаВладельца.ПолучитьОбъект();
			Если ДокументОбъект.Проведен Тогда 
				Текст = НСтр("ru = 'Операция возможна только для непроведенных документов!'");
			КонецЕсли;
		Иначе
			УстановитьПривилегированныйРежим(Истина);
			ДокументОбъект = Документы.СчетФактураПолученный.СоздатьДокумент();
			ДокументОбъект.Дата = ТекущаяДатаСеанса();
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(ДокументОбъект, ДанныеЗаполненияШапки);
		ДокументОбъект.ОбменДанными.Загрузка = Истина;
		ДокументОбъект.ДополнительныеСвойства.Вставить("ЕстьСоглашение", Истина);
		
		ДокументОбъект.ДокументыОснования.Очистить();
		ДокументОбъект.СоставНФА.Очистить();
		
		Если ДанныеЗаполненияШапки.Свойство("ДокументыОснования") И ЗначениеЗаполнено(ДанныеЗаполненияШапки.ДокументыОснования) Тогда
			Для каждого ТекДокОснование Из ДанныеЗаполненияШапки.ДокументыОснования Цикл
				Если ТипЗнч(ТекДокОснование.ДокументОснование) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда
					ДокументОбъект.ЭДПоставщика = ТекДокОснование.ДокументОснование;
				Иначе	
					НоваяСтрокаДок = ДокументОбъект.ДокументыОснования.Добавить();
					НоваяСтрокаДок.ДокументОснование = ТекДокОснование.ДокументОснование;
				КонецЕсли;	
			КонецЦикла;
			//ДокументОбъект.ДокументыОснования.Загрузить(ДанныеЗаполненияШапки.ДокументыОснования);
		КонецЕсли;
		
		Если ДанныеЗаполненияШапки.Свойство("СоставНФА") И ЗначениеЗаполнено(ДанныеЗаполненияШапки.СоставНФА) Тогда
			ДокументОбъект.СоставНФА.Загрузить(ДанныеЗаполненияШапки.СоставНФА);
		КонецЕсли;
		
		Для Каждого ТекСтрока Из ДокументОбъект.ДокументыОснования Цикл
			Если ТипЗнч(ТекСтрока.ДокументОснование) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда
				ДокументОбъект.ВидЦенности = Перечисления.ВидыЦенностейНДС.Материалы;	
			ИначеЕсли ТипЗнч(ТекСтрока.ДокументОснование) = Тип("ДокументСсылка.ПоступлениеУслугРабот") Тогда
				ДокументОбъект.ВидЦенности = Перечисления.ВидыЦенностейНДС.Услуги;	
			КонецЕсли;	
		КонецЦикла;	
		
		ДокументОбъект.СуммаНДС = ДокументОбъект.СоставНФА.Итог("СуммаНДС");
		
		ДокументОбъект.ДополнительныеСвойства.Вставить("ПроцессыОбработкиДокументов_ЗаписатьБезПроверкиОбменДаннымиЗагрузка", Истина);
		Если Записывать Тогда
			Если НЕ ЗначениеЗаполнено(ДокументОбъект.Номер) Тогда
				ДокументОбъект.УстановитьНовыйНомер();
			КонецЕсли;
			ДокументОбъект.Записать(РежимЗаписи);
			СсылкаНаВладельца = ДокументОбъект.Ссылка;
		Иначе
			СсылкаНаВладельца = ДокументОбъект;
		КонецЕсли;
	Исключение
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Заполнение документа на основе ЭД. %1'"), Текст)
			+ Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ВыполнитьЗаписьСобытияПоЭДВЖурналРегистрации(ТекстСообщения,
			2, УровеньЖурналаРегистрации.Ошибка, ДокументОбъект.Метаданные(), СсылкаНаВладельца);
		ВызватьИсключение(Текст);
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

