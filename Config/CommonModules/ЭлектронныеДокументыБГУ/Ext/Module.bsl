		ЗначениеФункции = "СЧФДОП";
		
		ПроверитьВозможностьФормированияУПДСтатуса1_УПД2025(СсылкаНаОбъект, СведенияДляУПДСтатус1, Описание, Отказ);
		
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		
		// УПД статуса 1 заполняем по документу счета-фактуры,
		// даже если начали формирование ЭД по первичному документу передачи.
		СсылкаНаОбъект = СведенияДляУПДСтатус1.ДокументСчетаФактуры.Ссылка;
		
	ИначеЕсли ТипДокумента = ВсеВидыДокументов.СчетФактура Тогда
		ЗначениеФункции = "СЧФ";
	Иначе
		ЗначениеФункции = "ДОП";
	КонецЕсли;
	
	СтруктураЭД = ОбщегоНазначения.СкопироватьРекурсивно(Настройки, Ложь);
	СтруктураЭД.Вставить("Функция", ЗначениеФункции);
	
	ОбщиеПараметры = ПолучитьОбщиеПараметрыЗаполненияИнформацииПродавцаУПД_5_03(СсылкаНаОбъект, СтруктураЭД, Данные, СведенияДляУПДСтатус1);
	
	ЗаполнитьСведенияОСчетеФактуреУПД_5_03(ОбщиеПараметры);
	
	ЗаполнитьТаблицуСчетаФактурыУПД_5_03(ОбщиеПараметры);
	
	ЗаполнитьСведенияОПередачеУПД_5_03(ОбщиеПараметры);
	
	// Шапку заполняем в самом конце, когда появились все необходимые для этого данные
	// (полностью проанализирована и заполнена таблица товаров).
	ЗаполнитьШапкуДокументаУПД_5_03(ОбщиеПараметры);
	
	// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	Если ОбщиеПараметры.ДопДанныеДокумента.ДанныеЕИС.ЕстьЭлектронноеАктирование Тогда
		ЭлектронноеАктированиеБГУ.ЗаполнитьДанныеДереваДляЭлектронногоАктированияЕИСУПД_5_03(ОбщиеПараметры);
	КонецЕсли;
	// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ОбщиеПараметры.СсылкаНаОбъект, "ИдентификаторФИАС")
		И ЗначениеЗаполнено(ОбщиеПараметры.СсылкаНаОбъект.ИдентификаторФИАС) Тогда
		
		Если ОбщиеПараметры.ДопДанныеДокумента.СтороныСделки.Грузополучатель.СовпадаетСПокупателем Тогда
			ПутьЭлементаТаблицы = "СведенияОСчетеФактуре.СведенияОГрузополучателях";
			ТаблицаСведенияОГрузополучателях = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД, ПутьЭлементаТаблицы);
			НоваяСтрока = ТаблицаСведенияОГрузополучателях.Добавить();
			НоваяСтрока.Грузополучатель = ПолучитьДанныеУчастникаУПД_5_03("Покупатель", ОбщиеПараметры);
			ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ОбщиеПараметры.ДеревоЭД, ТаблицаСведенияОГрузополучателях, ПутьЭлементаТаблицы);
		КонецЕсли;
		
		ИнтеграцияИСБГУ.ЗаполнитьДанныеМОДУПД_5_03(ОбщиеПараметры);	
	КонецЕсли;
		
КонецПроцедуры

// Подготавливает данные для электронного документа УПД (информация покупателя) по приказу ФНС № ЕД-7-26/1032@.
//
// Параметры:
//  Основания - Массив Из ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО - основания электронного документа.
//  Данные - ДеревоЗначений - данные для заполнения электронного документа. Строится по макету 
//                            см. Обработка.ОбменСКонтрагентами.Макет.УПД_ИнформацияПокупателя_5_02. Выходной параметр.
//  Отказ - Булево - признак отказа от дальнейшего формирования электронного документа.
//                   Информационное сообщение пользователю необходимо формировать самостоятельно.
//
Процедура ЗаполнитьДанныеУПД_5_03_ИнформацияПокупателя(Знач Основания, Данные, Отказ) Экспорт
	
	ДеревоДанных = Данные;
	
	Если ТипЗнч(Основания) <> Тип("Массив") Тогда
		Основания = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Основания);
	КонецЕсли;
	
	// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	ОснованияЕИС = Новый Массив;
	Для Каждого Основание Из Основания Цикл
		Если ТипЗнч(Основание) = Тип("ДокументСсылка.РезультатыРассмотренияДокументаПриемкиЕИС") Тогда
			ОснованияЕИС.Добавить(Основание);
		КонецЕсли;
	КонецЦикла;
	Если ОснованияЕИС.Количество() > 0 Тогда
		ЭлектронноеАктированиеБГУ.ЗаполнитьДанныеДляУПДИнформацииПокупателяЕИСУПД_5_03(ОснованияЕИС, ДеревоДанных, Отказ);
		Возврат;
	КонецЕсли;	
	// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	
	ОрганизацияСоставитель = Справочники.Организации.ПустаяСсылка();
	
	ЭтоПоступлениеУслугРабот = Ложь;
	Если Основания.Количество() = 0 Тогда
		ЕдинственнаяОрганизация(ОрганизацияСоставитель);
	Иначе	
		Для каждого ТекСтрока Из Основания Цикл
			ОрганизацияСоставитель = ТекСтрока.Организация;
			Если ТипЗнч(ТекСтрока) = Тип("ДокументСсылка.ПоступлениеУслугРабот") Тогда
				ЭтоПоступлениеУслугРабот = Истина;
				Прервать;
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;
	
	СведенияОПокупателе = Новый Структура;
	Если ЗначениеЗаполнено(ОрганизацияСоставитель) Тогда
		ПолучитьДанныеЮрФизЛица(ОрганизацияСоставитель, СведенияОПокупателе);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"СоставительДокументаНаименование", СведенияОПокупателе.ПолноеНаименование);
	Иначе
		Отказ = Истина;
		
		ТекстСообщения  = НСтр("ru='Чтобы утвердить, подписать и отправить ответную часть электронного документа необходимо сопоставить номенклатуру, создать или подобрать документы отражения в учете.
		|Для этого необходимо перейти по ссылке в колонке ""Отражение в учете"" списка.'");
		Сообщение       = Новый СообщениеПользователю();
		Сообщение.Текст = ТекстСообщения;
		Сообщение.Сообщить();
		
		Возврат;
	КонецЕсли;
	
	РезультатыЗапроса = ПрочитатьСведенияПриемкиУПД_5_03(Основания, ЭтоПоступлениеУслугРабот);
	
	ТаблицаСведенияПриемки = РезультатыЗапроса[0].Выгрузить();
	ТаблицаОрганизацияСФ = РезультатыЗапроса[1].Выгрузить();
	ТаблицаЗакупкаДляГосНужд = РезультатыЗапроса[2].Выгрузить();
	
	СведенияПриемки = Неопределено;
	Если ТаблицаСведенияПриемки.Количество() > 0 Тогда
		СведенияПриемки = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаСведенияПриемки[0]);
	КонецЕсли;
	
	ОрганизацияСФ = Неопределено;
	Если ТаблицаОрганизацияСФ.Количество() > 0 Тогда
		ОрганизацияСФ = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаОрганизацияСФ[0]);
	КонецЕсли;
	
	ЗакупкаДляГосНужд = Неопределено;
	Если ТаблицаЗакупкаДляГосНужд.Количество() > 0 Тогда
		ЗакупкаДляГосНужд = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаЗакупкаДляГосНужд[0]);
	КонецЕсли;
	
	ДатаПолученияТоваров = ТекущаяДатаСеанса();
	
	Если СведенияПриемки <> Неопределено Тогда
		// Найден документ приемки.
		ДатаПолученияТоваров = СведенияПриемки.Дата;
		
		Если СведенияПриемки.ТоварыПриняты Тогда
			ДатаПолученияТоваров = СведенияПриемки.ДатаПолученияТоваров;
			
			ЗаполнитьСведенияОЛицеПринявшемТоварыУПД_5_03(ДеревоДанных, СведенияПриемки);
			
			СоставительДокумента = ?(ЗначениеЗаполнено(СведенияПриемки.ОрганизацияКПП),
				СтрШаблон(НСтр("ru = '%1, ИНН/КПП %2/%3'"),
					СведенияПриемки.ОрганизацияНаименованиеПолное, СведенияПриемки.ОрганизацияИНН, СведенияПриемки.ОрганизацияКПП),
				СтрШаблон(НСтр("ru = '%1, ИНН %2'"),
					СведенияПриемки.ОрганизацияНаименованиеПолное, СведенияПриемки.ОрганизацияИНН));
					
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
				"СоставительДокументаНаименование", СоставительДокумента);
		КонецЕсли;	
		
	ИначеЕсли ОрганизацияСФ <> Неопределено Тогда
		// Документ приемки не найден, но найден счет-фактура.
		ДатаПолученияТоваров = ОрганизацияСФ.Дата;
		
		СоставительДокумента = ?(ЗначениеЗаполнено(ОрганизацияСФ.ОрганизацияКПП),
			СтрШаблон(НСтр("ru = '%1, ИНН/КПП %2/%3'"),
				ОрганизацияСФ.ОрганизацияНаименованиеПолное, ОрганизацияСФ.ОрганизацияИНН, ОрганизацияСФ.ОрганизацияКПП),
			СтрШаблон(НСтр("ru = '%1, ИНН %2'"),
				ОрганизацияСФ.ОрганизацияНаименованиеПолное, ОрганизацияСФ.ОрганизацияИНН));
				
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"СоставительДокументаНаименование", СоставительДокумента);
	КонецЕсли;
	
	КодИтога = "1";
	СодержаниеОперации = НСтр("ru = 'Товары (работы, услуги, права) приняты без расхождений (претензий)'");
	Если СведенияПриемки <> Неопределено Тогда
		РеквизитыЭДП = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СведенияПриемки.Ссылка, "РезультатПриемки");
		Если РеквизитыЭДП.РезультатПриемки = 2 Тогда
			КодИтога = "3";
			СодержаниеОперации = НСтр("ru = 'Товары (работы, услуги, права) не приняты'");
		КонецЕсли;	
		
		АктОРасхождениях = НайтиАктОРасхожденияхПоОснованию(СведенияПриемки.Ссылка);
		Если ЗначениеЗаполнено(АктОРасхождениях) Тогда
			РеквизитыАкта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(АктОРасхождениях, "Проведен, Номер, Дата, ВидДокументаРасхождений, ОбстоятельстваСоставленияДокумента,  
			|ОбстоятельстваИспользованияДокументаПерваяЧастьКода, ОбстоятельстваИспользованияДокументаВтораяЧастьКода, НаименованиеЭлектронногоДокумента");
			НаименованиеДокументаАктаОРасхождениях = НСтр("ru = 'Акт об установленном расхождении по количеству и качеству при приемке товарно-материальных ценностей'");
			Если ЗначениеЗаполнено(РеквизитыАкта.НаименованиеЭлектронногоДокумента) Тогда
				НаименованиеДокументаАктаОРасхождениях = РеквизитыАкта.НаименованиеЭлектронногоДокумента;
			КонецЕсли;	
			Если РеквизитыАкта.Проведен Тогда
				Если КодИтога = "1" Тогда
					КодИтога = "2";
					СодержаниеОперации = НСтр("ru = 'Товары (работы, услуги, права) приняты с расхождениями (претензией)'");
				КонецЕсли;
				Путь = "СодержаниеФХЖ.СведенияОПринятииТоваров.ДокументОРасхождениях";
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + ".НаименованиеДокумента", НаименованиеДокументаАктаОРасхождениях);
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + ".НомерДокумента", НомерДляПечати(АктОРасхождениях, РеквизитыАкта.Номер));
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + ".ДатаДокумента", РеквизитыАкта.Дата);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	НачалоПути = "СодержаниеФХЖ.СведенияОПринятииТоваров";
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, НачалоПути + ".ДатаПолученияТоваров", ДатаПолученияТоваров);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, НачалоПути + ".СодержаниеОперации", СодержаниеОперации);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, НачалоПути + ".КодИтога", КодИтога);
	
	Если ЗакупкаДляГосНужд <> Неопределено Тогда
		ЗаполнитьЗакупкаДляГосударственныхНуждУПД_5_03(ДеревоДанных, ЗакупкаДляГосНужд, Отказ);
	КонецЕсли;
	
КонецПроцедуры

// Поиск и создание учетных документов при отражении в учете документа УПД (информация продавца). Вызывается для УПД всех
// возможных функций (СЧФ, СЧФДОП, ДОП). Формат по приказу ЕД-7-26/1032@.
//
// Параметры:
//  ДеревоДанных		 - ДеревоЗначений - данные электронного документа в виде заполненного макета 
//                         см. Обработка.ОбменСКонтрагентами.Макет.УПД_ИнформацияПродавца_2019
//  СсылкиНаВладельцев	 - Массив Из ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО - ссылки на документы учета, если они уже
//                         прикреплены к электронному документу.
//  СпособОбработки		 - Структура - способы сохранения данных в информационной базе, выбранные пользователем. 
//     * ПервичныйДокумент - Строка - способ сохранения первичного документа.
//     * СчетФактура       - Строка - способ сохранения счета-фактуры.
//  ОписаниеОшибки       - Строка - описание ошибки создания учетного документа. Может быть выведена пользователю.
//
Процедура НайтиСоздатьУниверсальныйПередаточныйДокумент_5_03(ДеревоДанных, СсылкиНаВладельцев = Неопределено, СпособОбработки = Неопределено, ОписаниеОшибки = "") Экспорт
	
	Записывать = Истина;
	ВидПервичногоДокумента = НСтр("ru = 'Универсальный передаточный документ'");
	
	ПервичныйДокумент = Неопределено;
	СчетФактура = Неопределено;
	
	СпособОбработкиПервичногоДокумента = "";
	СпособОбработкиСчетаФактуры = "";
	
	Если ЗначениеЗаполнено(СпособОбработки) И ТипЗнч(СпособОбработки) = Тип("Структура") Тогда
		Если СпособОбработки.Свойство("ПервичныйДокумент") Тогда
			СпособОбработкиПервичногоДокумента = СпособОбработки.ПервичныйДокумент;
		КонецЕсли;
		
		Если СпособОбработки.Свойство("СчетФактура") Тогда
			СпособОбработкиСчетаФактуры = СпособОбработки.СчетФактура;
		КонецЕсли;
	КонецЕсли;
	
	Если СсылкиНаВладельцев <> Неопределено Тогда
		Для каждого Строка Из СсылкиНаВладельцев Цикл
			Если ТипЗнч(Строка) = Тип("ДокументСсылка.СчетФактураПолученный") Тогда
				СчетФактура = Строка;
			Иначе
				ПервичныйДокумент = Строка;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	ФункцияУПД = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "Функция");
	ДокументыУчета = Новый Массив;
	
	Если ФункцияУПД = "ДОП" Или ФункцияУПД = "СЧФДОП" Тогда
		НайтиСоздатьДокументОПередачеУПД_5_03(ДеревоДанных, ПервичныйДокумент, Записывать, СпособОбработки, ОписаниеОшибки, ВидПервичногоДокумента);
		Если ПервичныйДокумент <> Неопределено Тогда
			ДокументыУчета.Добавить(ПервичныйДокумент);
		КонецЕсли;
	КонецЕсли;
	
	// Заполним основание в СФ.
	ДокументыОснованияСчетаФактуры = ЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияСчетаФактуры");
	Если ЗначениеЗаполнено(ДокументыОснованияСчетаФактуры) И ТипЗнч(ДокументыОснованияСчетаФактуры) = Тип("Массив") Тогда
		Если ДокументыОснованияСчетаФактуры.Количество()>0 Тогда
			ПервичныйДокумент = ДокументыОснованияСчетаФактуры[0];
		КонецЕсли;
	КонецЕсли;
	ДокументыОснованияСчетаФактуры = Новый Массив;
	ДокументыОснованияСчетаФактуры.Добавить(ПервичныйДокумент);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияСчетаФактуры", ДокументыОснованияСчетаФактуры);
	
	Если ФункцияУПД = "СЧФ" Или ФункцияУПД = "СЧФДОП" Тогда
		НайтиСоздатьСчетФактуруУПД_5_03(ДеревоДанных, СчетФактура, СпособОбработки, ОписаниеОшибки, Записывать, ВидПервичногоДокумента);
		ДокументыУчета.Добавить(СчетФактура);
	КонецЕсли;
	
	СсылкиНаВладельцев = ДокументыУчета;
	
КонецПроцедуры

#Область ИнформацияПродавца

#Область Заполнение_ШапкаУПД

Процедура ЗаполнитьШапкуДокументаУПД_5_03(ОбщиеПараметры)
	
	Если ОбщиеПараметры.ДанныеДокумента.Шапка.Свойство("СведенияОВыбытииМаркированныхТоваров") Тогда
		СведенияОВыбытииМаркированныхТоваров = ОбщиеПараметры.ДанныеДокумента.Шапка.СведенияОВыбытииМаркированныхТоваров;
		
		Если ЗначениеЗаполнено(СведенияОВыбытииМаркированныхТоваров) Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ОбщиеПараметры.ДеревоЭД, "СведенияОВыбытииМаркированныхТоваров", СведенияОВыбытииМаркированныхТоваров);
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОбщиеПараметры.ДанныеДокумента.Шапка.ДокументОснование) Тогда
		МассивСсылок = Новый Массив();
		МассивСсылок.Добавить(ОбщиеПараметры.ДанныеДокумента.Шапка.ДокументОснование);
		
		Если ОбщиеПараметры.ДополнительныеПараметры.ЭтоФункцияСЧФ
			Или ОбщиеПараметры.ДополнительныеПараметры.ЭтоФункцияСЧФДОП Тогда
			ИмяЭлемента = "ДокументыОснованияСчетаФактуры";
		Иначе
			ИмяЭлемента = "ДокументыОснованияДокументаОтгрузки";
		КонецЕсли;
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ОбщиеПараметры.ДеревоЭД, ИмяЭлемента, МассивСсылок);
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ОбщиеПараметры.ДеревоЭД, "СсылкаСчетаФактуры", ОбщиеПараметры.СсылкаНаОбъект);
	
	Если ОбщиеПараметры.ДополнительныеПараметры.ЭтоФункцияСЧФДОП
		Или ОбщиеПараметры.ДополнительныеПараметры.ЭтоФункцияДОП Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ОбщиеПараметры.ДеревоЭД, "ИныеСведенияОбОтгрузке",
			ОбщиеПараметры.ДопДанныеДокумента.ОписаниеФактаПередачи.РеквизитыПередачи.ОтветственныйПередалТРУИныеСведения);
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ОбщиеПараметры.ДеревоЭД, "ТолькоУслуги", ОбщиеПараметры.ДополнительныеПараметры.ТолькоУслуги);
	
	Если ОбщиеПараметры.ДополнительныеПараметры.ЭтоФункцияСЧФ Тогда
		ВидСчетаФактуры = ?(УчетНДСПовтИсп.Аванс(ОбщиеПараметры.ДанныеДокумента.Шапка.ПричинаНалогообложения), "Авансовый", "Реализация");
	Иначе
		ВидСчетаФактуры = "Реализация";
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ОбщиеПараметры.ДеревоЭД, "ВидСчетаФактуры", ВидСчетаФактуры);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ОбщиеПараметры.ДеревоЭД, "Функция", ОбщиеПараметры.СтруктураЭД.Функция);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ОбщиеПараметры.ДеревоЭД, "СоставительДокументаНаименование", ОбщиеПараметры.СтруктураЭД.Отправитель.НаименованиеПолное);
	
КонецПроцедуры

#КонецОбласти

#Область Заполнение_СведенияОСчетеФактуре

Процедура ЗаполнитьСведенияОСчетеФактуреУПД_5_03(ОбщиеПараметры)
	
	ДанныеДокумента		= ОбщиеПараметры.ДанныеДокумента;
	ДопДанныеДокумента	= ОбщиеПараметры.ДопДанныеДокумента;
	Шапка				= ОбщиеПараметры.ДанныеДокумента.Шапка;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ОбщиеПараметры.ДеревоЭД, "СведенияОСчетеФактуре.НомерДокумента", ДопДанныеДокумента.НомерДокумента);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ОбщиеПараметры.ДеревоЭД, "СведенияОСчетеФактуре.ДатаДокумента", ДопДанныеДокумента.ДатаДокумента);
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Шапка, "НомерИсправления")
		И ЗначениеЗаполнено(Шапка.НомерИсправления) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ОбщиеПараметры.ДеревоЭД, "СведенияОСчетеФактуре.Исправление.НомерИсправления", Шапка.НомерИсправления);
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Шапка, "ДатаИсправления")
		И ЗначениеЗаполнено(Шапка.ДатаИсправления) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ОбщиеПараметры.ДеревоЭД, "СведенияОСчетеФактуре.Исправление.ДатаИсправления", Шапка.ДатаИсправления);
	КонецЕсли;
	
	ЗаполнитьСведенияОПродавцахУПД_5_03(ОбщиеПараметры);
	
	ЗаполнитьСведенияОПокупателяхУПД_5_03(ОбщиеПараметры);
	
	ЗаполнитьСведенияОГрузоотправителяхУПД_5_03(ОбщиеПараметры);
	
	ЗаполнитьСведенияОГрузополучателяхУПД_5_03(ОбщиеПараметры);
	
	ЗаполнитьСведенияОПлатежноРасчетныхДокументахУПД_5_03(ОбщиеПараметры);
	
	Если ОбщиеПараметры.ДополнительныеПараметры.ЭтоФункцияСЧФ Или ОбщиеПараметры.ДополнительныеПараметры.ЭтоФункцияСЧФДОП Тогда
		ЗаполнитьДокументыОбОтгрузкеУПД_5_03(ОбщиеПараметры);
	КонецЕсли;
	
	ЗаполнитьВалютуУПД_5_03(ОбщиеПараметры);
	
	ЗаполнитьДополнительныеСведенияОбУчастникахУПД_5_03(ОбщиеПараметры);
	
КонецПроцедуры

Процедура ЗаполнитьСведенияОПродавцахУПД_5_03(ОбщиеПараметры)
	
	ПутьЭлементаТаблицы = "СведенияОСчетеФактуре.СведенияОПродавцах";
	
	ТаблицаСведенияОПродавцах = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД, ПутьЭлементаТаблицы);
	
	НоваяСтрока = ТаблицаСведенияОПродавцах.Добавить();
	
	НоваяСтрока.Продавец = ПолучитьДанныеУчастникаУПД_5_03("Продавец", ОбщиеПараметры);
	
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ОбщиеПараметры.ДеревоЭД, ТаблицаСведенияОПродавцах, ПутьЭлементаТаблицы);
	
КонецПроцедуры

Процедура ЗаполнитьСведенияОПокупателяхУПД_5_03(ОбщиеПараметры)
	
	ПутьЭлементаТаблицы = "СведенияОСчетеФактуре.СведенияОПокупателях";
	
	ТаблицаСведенияОПокупателях = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД, ПутьЭлементаТаблицы);
	
	НоваяСтрока = ТаблицаСведенияОПокупателях.Добавить();
	
	НоваяСтрока.Покупатель = ПолучитьДанныеУчастникаУПД_5_03("Покупатель", ОбщиеПараметры);
	
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ОбщиеПараметры.ДеревоЭД, ТаблицаСведенияОПокупателях, ПутьЭлементаТаблицы);
	
КонецПроцедуры

Процедура ЗаполнитьСведенияОГрузоотправителяхУПД_5_03(ОбщиеПараметры)
	
	Если ОбщиеПараметры.ДополнительныеПараметры.ТолькоУслуги
		Или ОбщиеПараметры.ДополнительныеПараметры.ЭтоСФАвансовый
		Или ОбщиеПараметры.ДополнительныеПараметры.ЭтоСФНалоговыйАгентПункты2и3 Тогда
		Возврат;
	КонецЕсли;
	
	ПутьЭлементаТаблицы = "СведенияОСчетеФактуре.СведенияОГрузоотправителях";
	
	ТаблицаСведенияОГрузоотправителях = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД, ПутьЭлементаТаблицы);
	
	НоваяСтрока = ТаблицаСведенияОГрузоотправителях.Добавить();
	
	Если ОбщиеПараметры.ДопДанныеДокумента.СтороныСделки.Грузоотправитель.СовпадаетСПродавцом Тогда
		ИмяЭлемента = "ОнЖе";
		ЗначениеЭлемента = Истина;
	Иначе
		ИмяЭлемента = "Грузоотправитель";
		ЗначениеЭлемента = ПолучитьДанныеУчастникаУПД_5_03("Грузоотправитель", ОбщиеПараметры);
	КонецЕсли;
	
	НоваяСтрока[ИмяЭлемента] = ЗначениеЭлемента;
	
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ОбщиеПараметры.ДеревоЭД, ТаблицаСведенияОГрузоотправителях, ПутьЭлементаТаблицы);
	
КонецПроцедуры
	
Процедура ЗаполнитьСведенияОГрузополучателяхУПД_5_03(ОбщиеПараметры)
	
	Если ОбщиеПараметры.ДополнительныеПараметры.ТолькоУслуги
		Или ОбщиеПараметры.ДополнительныеПараметры.ЭтоСФАвансовый
		Или ОбщиеПараметры.ДополнительныеПараметры.ЭтоСФНалоговыйАгентПункты2и3 Тогда
		Возврат;
	КонецЕсли;
	
	Если ОбщиеПараметры.ДопДанныеДокумента.СтороныСделки.Грузополучатель.СовпадаетСПокупателем Тогда
		Возврат;
	КонецЕсли;
	
	ПутьЭлементаТаблицы = "СведенияОСчетеФактуре.СведенияОГрузополучателях";
	
	ТаблицаСведенияОГрузополучателях = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД, ПутьЭлементаТаблицы);
	
	НоваяСтрока = ТаблицаСведенияОГрузополучателях.Добавить();
	
	НоваяСтрока.Грузополучатель = ПолучитьДанныеУчастникаУПД_5_03("Грузополучатель", ОбщиеПараметры);
	
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ОбщиеПараметры.ДеревоЭД, ТаблицаСведенияОГрузополучателях, ПутьЭлементаТаблицы);
	
КонецПроцедуры

Процедура ЗаполнитьСведенияОПлатежноРасчетныхДокументахУПД_5_03(ОбщиеПараметры)
	
	ПутьЭлементаТаблицы = "СведенияОСчетеФактуре.СведенияОПлатежноРасчетныхДокументах";
	
	Если ОбщиеПараметры.ДанныеДокумента.ТабЧастьПРД = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаПРД = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД, ПутьЭлементаТаблицы);
	
	Для Каждого СтрокаТаблицы Из ОбщиеПараметры.ДанныеДокумента.ТабЧастьПРД Цикл
		НоваяСтрока = ТаблицаПРД.Добавить();
		
		НоваяСтрока.Номер = СтрокаТаблицы.НомерДокумента;
		НоваяСтрока.Дата = СтрокаТаблицы.ДатаДокумента;
	КонецЦикла;
	
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ОбщиеПараметры.ДеревоЭД, ТаблицаПРД, ПутьЭлементаТаблицы);
	
КонецПроцедуры

Процедура ЗаполнитьДокументыОбОтгрузкеУПД_5_03(ОбщиеПараметры)
	
	ПутьЭлементаТаблицы = "СведенияОСчетеФактуре.ДокументыОбОтгрузке";
	
	ТаблицаДокументыОбОтгрузке = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД, ПутьЭлементаТаблицы);
	
	Для Каждого СтрокаТаблицы Из ОбщиеПараметры.ДопДанныеДокумента.ДокументыОбОтгрузке.Таблица Цикл
		МассивДанныхСоставителей = Новый Массив();
		МассивДанныхСоставителей.Добавить(ОбщиеПараметры.ДополнительныеПараметры.ДанныеЛицаПродавца);
		
		ТаблицаСоставителиДокумента = ПолучитьТаблицуСоставителиДокументаУПД_5_03(
			ПутьЭлементаТаблицы + ".НомерСтроки.ДокументОбОтгрузке.СоставителиДокумента",
			МассивДанныхСоставителей, ОбщиеПараметры);
			
		ГруппаРеквизитыДокумента = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД, ПутьЭлементаТаблицы + ".НомерСтроки.ДокументОбОтгрузке");
		
		ЗаполнитьЗначенияСвойств(ГруппаРеквизитыДокумента, СтрокаТаблицы, "НаименованиеДокумента,НомерДокумента,ДатаДокумента");
		
		ГруппаРеквизитыДокумента.СоставителиДокумента = ТаблицаСоставителиДокумента;
		
		НоваяСтрока = ТаблицаДокументыОбОтгрузке.Добавить();
		
		НоваяСтрока.ДокументОбОтгрузке = ГруппаРеквизитыДокумента;
	КонецЦикла;
	
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ОбщиеПараметры.ДеревоЭД, ТаблицаДокументыОбОтгрузке, ПутьЭлементаТаблицы);
	
КонецПроцедуры

Процедура ЗаполнитьВалютуУПД_5_03(ОбщиеПараметры)
	
	ПутьЭлементаГруппы = "СведенияОСчетеФактуре.Валюта";
	
	Шапка = ОбщиеПараметры.ДанныеДокумента.Шапка;
	
	ИменаРеквизитовШапки = ОбщиеПараметры.ДополнительныеПараметры.ОписанияРеквизитовДокументов.СсылкаНаОбъект.ИменаРеквизитовШапки;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ОбщиеПараметры.ДеревоЭД, ПутьЭлементаГруппы + ".Код",
		Шапка[ИменаРеквизитовШапки.ВалютаКод]);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ОбщиеПараметры.ДеревоЭД, ПутьЭлементаГруппы + ".Наименование",
		Шапка[ИменаРеквизитовШапки.ВалютаНаименование]);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ОбщиеПараметры.ДеревоЭД, ПутьЭлементаГруппы + ".Курс",
		?(ЗначениеЗаполнено(ИменаРеквизитовШапки.Курс), Шапка[ИменаРеквизитовШапки.Курс], 1));
	
КонецПроцедуры
	
Процедура ЗаполнитьДополнительныеСведенияОбУчастникахУПД_5_03(ОбщиеПараметры)
	
	ЗаполнитьШапкуДополнительныхСведенийОбУчастникахУПД_5_03(ОбщиеПараметры);
	
	Если ОбщиеПараметры.ДополнительныеПараметры.ЭтоФункцияСЧФ
		Или ОбщиеПараметры.ДополнительныеПараметры.ЭтоФункцияСЧФДОП Тогда
		ЗаполнитьСчетаФактурыНаАвансСтрока5бУПД_5_03(ОбщиеПараметры);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьШапкуДополнительныхСведенийОбУчастникахУПД_5_03(ОбщиеПараметры)
	
	НачалоПути = "СведенияОСчетеФактуре.ДополнительныеСведенияОбУчастниках";
	
	Шапка = ОбщиеПараметры.ДанныеДокумента.Шапка;
	
	// ИдентификаторГосКонтракта
	
	ИдентификаторГосКонтракта = Неопределено;
	
	Если Шапка.Свойство("ИдентификаторГосКонтракта") Тогда
		ИдентификаторГосКонтракта = Шапка.ИдентификаторГосКонтракта;
		
	ИначеЕсли Шапка.Свойство("Договор") И ЗначениеЗаполнено(Шапка.Договор) Тогда
		ИдентификаторГосКонтракта = ИдентификаторГосКонтрактаГОЗ(Шапка.Договор);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИдентификаторГосКонтракта) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ОбщиеПараметры.ДеревоЭД, НачалоПути + ".ИдентификаторГосКонтракта", ИдентификаторГосКонтракта);
	КонецЕсли;
	
	// ОбстоятельстваФормированияСФ
	
	Если ОбщиеПараметры.ДополнительныеПараметры.ЭтоФункцияСЧФ Тогда
		ОбстоятельстваФормированияСФ = "1";
		
		Если ОбщиеПараметры.ДополнительныеПараметры.ЭтоСФАвансовый Тогда
			ОбстоятельстваФормированияСФ = "2";
			
		ИначеЕсли ОбщиеПараметры.ДополнительныеПараметры.ЭтоСФНалоговыйАгентПункты2и3 Тогда
			ОбстоятельстваФормированияСФ = "4";
			
		ИначеЕсли ОбщиеПараметры.ДополнительныеПараметры.ЭтоСФШкурыЛом Тогда
			ОбстоятельстваФормированияСФ = "5";
		КонецЕсли;
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ОбщиеПараметры.ДеревоЭД, НачалоПути + ".ОбстоятельстваФормированияСФ", ОбстоятельстваФормированияСФ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСчетаФактурыНаАвансСтрока5бУПД_5_03(ОбщиеПараметры)
	
	ПутьЭлементаТаблицы = "СведенияОСчетеФактуре.ДополнительныеСведенияОбУчастниках.АвансовыеСчетаФактуры";
	
	ТаблицаАвансовыеСчетаФактуры = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
		ОбщиеПараметры.ДеревоЭД, ПутьЭлементаТаблицы);
	
	Для Каждого СтрокаТаблицы Из ОбщиеПараметры.ДанныеДокумента.ТабЧастьСчетаФактурыНаАванс Цикл
		НоваяСтрока = ТаблицаАвансовыеСчетаФактуры.Добавить();
		
		НоваяСтрока.НомерДокумента = СтрокаТаблицы.Номер;
		НоваяСтрока.ДатаДокумента = СтрокаТаблицы.Дата;
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.НомерИсправления) Или ЗначениеЗаполнено(СтрокаТаблицы.ДатаИсправления) Тогда
			НоваяСтрока.НомерИсправительногоДокумента = Формат(СтрокаТаблицы.НомерИсправления, "ЧГ=");
			НоваяСтрока.ДатаИсправительногоДокумента = СтрокаТаблицы.ДатаИсправления;
		КонецЕсли;
	КонецЦикла;
	
	Если ТаблицаАвансовыеСчетаФактуры.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ОбщиеПараметры.ДеревоЭД, ТаблицаАвансовыеСчетаФактуры, ПутьЭлементаТаблицы);
	
КонецПроцедуры

Функция ПолучитьДанныеУчастникаУПД_5_03(ОбозначениеУчастника, ОбщиеПараметры)
	
	Перем ПутьЭлемента, ДанныеЛица, ЗначениеСвойства;
	
	Если ОбозначениеУчастника = "Продавец" Тогда
		ПутьЭлементаУчастника = "СведенияОСчетеФактуре.СведенияОПродавцах.НомерСтроки.Продавец";
		
	ИначеЕсли ОбозначениеУчастника = "Покупатель" Тогда
		ПутьЭлементаУчастника = "СведенияОСчетеФактуре.СведенияОПокупателях.НомерСтроки.Покупатель";
		
	ИначеЕсли ОбозначениеУчастника = "Грузоотправитель" Тогда
		ПутьЭлементаУчастника = "СведенияОСчетеФактуре.СведенияОГрузоотправителях.НомерСтроки.Грузоотправитель";
		
	ИначеЕсли ОбозначениеУчастника = "Грузополучатель" Тогда
		ПутьЭлементаУчастника = "СведенияОСчетеФактуре.СведенияОГрузополучателях.НомерСтроки.Грузополучатель";
		
	Иначе
		ТекстСообщения = СтрШаблон(НСтр("ru='Передано неподдерживаемое значение ""%1"" параметра ОбозначениеУчастника в функцию ПолучитьДанныеУчастникаУПД_5_03()'"), ОбозначениеУчастника);
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;
	
	ОбщиеПараметры.ДополнительныеПараметры.ПутьЭлементаУчастника = ПутьЭлементаУчастника;
	
	СтруктураУчастника = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД, ПутьЭлементаУчастника);
	
	УчастникСсылка = ОбщиеПараметры.ДопДанныеДокумента.СтороныСделки[ОбозначениеУчастника].Ссылка;
	
	ПолучитьДанныеЮрФизЛица(УчастникСсылка, ДанныеЛица, ОбщиеПараметры.ДопДанныеДокумента.ДатаДокумента);
	
	ОбщиеПараметры.ДополнительныеПараметры.ДанныеЛица = ДанныеЛица;
	
	Если ОбозначениеУчастника = "Продавец" Тогда
		ОбщиеПараметры.ДополнительныеПараметры.ДанныеЛицаПродавца = ДанныеЛица;
	КонецЕсли;
	
	Если ДанныеЛица.Свойство("КодПоОКПО", ЗначениеСвойства) И ЗначениеЗаполнено(ЗначениеСвойства) Тогда
		СтруктураУчастника.КодОКПО = ЗначениеСвойства;
	КонецЕсли;
	
	Если ДанныеЛица.Свойство("КодКОПФ", ЗначениеСвойства) И ЗначениеЗаполнено(ЗначениеСвойства) Тогда
		Свойства = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЗначениеСвойства, "Код,НаименованиеПолное");
		
		СтруктураУчастника.КодОПФ = Свойства.Код;
		СтруктураУчастника.НаименованиеОПФ = Свойства.НаименованиеПолное;
	КонецЕсли;
	
	ЗаполнитьТипУчастникаУПД_5_03(СтруктураУчастника, ОбозначениеУчастника, ДанныеЛица, ОбщиеПараметры);
	
	ЗаполнитьАдресУчастникаУПД_5_03(СтруктураУчастника, ОбозначениеУчастника, ДанныеЛица, ОбщиеПараметры);
	
	ЗаполнитьБанковскиеРеквизитыУчастникаУПД_5_03(СтруктураУчастника, ОбозначениеУчастника, ДанныеЛица, ОбщиеПараметры);
	
	ЗаполнитьКонтактныеСведенияУчастникаУПД_5_03(СтруктураУчастника, ОбозначениеУчастника, ДанныеЛица, ОбщиеПараметры);
	
	// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	Если ОбщиеПараметры.ДопДанныеДокумента.ДанныеЕИС.ЕстьЭлектронноеАктирование Тогда
		ЭлектронноеАктированиеБГУ.ЗаполнитьДанныеУчастникаЕИСУПД_5_03(СтруктураУчастника, ОбозначениеУчастника, ДанныеЛица, ОбщиеПараметры);
	КонецЕсли;
	// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	
	Возврат СтруктураУчастника;
	
КонецФункции

Процедура ЗаполнитьТипУчастникаУПД_5_03(СтруктураУчастника, ОбозначениеУчастника, ДанныеЛица, ОбщиеПараметры)
	
	Перем СтранаРегистрации, ЗначениеСвойства;
	
	ПутьЭлементаУчастника = ОбщиеПараметры.ДополнительныеПараметры.ПутьЭлементаУчастника;
	
	СторонаСделки = ОбщиеПараметры.ДопДанныеДокумента.СтороныСделки[ОбозначениеУчастника];
	
	ОбновляемыеСвойства = Новый Структура();
	ОбновляемыеСвойства.Вставить("ИНН", СторонаСделки.ИНН);
	Если СторонаСделки.Свойство("КПП") Тогда
		ОбновляемыеСвойства.Вставить("КПП", СторонаСделки.КПП);
	КонецЕсли;	
	ОбновляемыеСвойства.Вставить("ОфициальноеНаименование", СторонаСделки.Наименование);
	
	ЗаполнитьЗначенияСвойств(ДанныеЛица, ОбновляемыеСвойства);
	
	ДанныеЛица.Свойство("СтранаРегистрации", СтранаРегистрации);
	
	Если Не ЗначениеЗаполнено(СтранаРегистрации) Тогда
		СтранаРегистрации = Справочники.СтраныМира.Россия;
	КонецЕсли;
	
	Если СтранаРегистрации <> Справочники.СтраныМира.Россия Тогда
		ИмяЭлемента = "ИЛ";
		
		ПутьЭлемента = ПутьЭлементаУчастника + ".ТипУчастника." + ИмяЭлемента;
		ЭлементТипаУчастника = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД, ПутьЭлемента);
		
		Если ДанныеЛица.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
			Cтатус = "ИО"; // ИО - иностранная организация
		Иначе
			Cтатус = "ИГ"; // ИГ - иностранный гражданин
		КонецЕсли;
		
		Свойства = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтранаРегистрации, "Код,НаименованиеПолное");
		
		ЭлементТипаУчастника.Статус = Cтатус;
		ЭлементТипаУчастника.КодСтраны = Свойства.Код;
		ЭлементТипаУчастника.НаименованиеСтраны = Свойства.НаименованиеПолное;
		ЭлементТипаУчастника.НаименованиеОрганизации = ДанныеЛица.ОфициальноеНаименование;
		ЭлементТипаУчастника.ИныеСведения = "1"; // Элемент обязателен при отсутствии <ИдентификаторОрганизацииИлиГражданина>
		
	ИначеЕсли ДанныеЛица.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
		ИмяЭлемента = "ЮЛ";
		
		ПутьЭлемента = ПутьЭлементаУчастника + ".ТипУчастника." + ИмяЭлемента;
		ЭлементТипаУчастника = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД, ПутьЭлемента);
		
		НаименованиеОрганизации = ДанныеЛица.ОфициальноеНаименование;
		
		ЭлементТипаУчастника.НаименованиеОрганизации = НаименованиеОрганизации;
		ЭлементТипаУчастника.ИНН = ДанныеЛица.ИНН;
		ЭлементТипаУчастника.КПП = ДанныеЛица.КПП;
		
	ИначеЕсли ДанныеЛица.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
		
		Если ДанныеЛица.ИП Тогда
			ИмяЭлемента = "ИП";
			
			ПутьЭлемента = ПутьЭлементаУчастника + ".ТипУчастника." + ИмяЭлемента;
			ЭлементТипаУчастника = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД, ПутьЭлемента);
			
			ЭлементТипаУчастника.ИНН = ДанныеЛица.ИНН;
			
			Если ЗначениеЗаполнено(ДанныеЛица.СвидетельствоСерияНомер) Тогда
				ПредставлениеНомера = ДанныеЛица.СвидетельствоСерияНомер;
			Иначе
				ПредставлениеНомера = "--";
			КонецЕсли;
			Если ЗначениеЗаполнено(ДанныеЛица.СвидетельствоДата) Тогда
				ПредставлениеДаты = Формат(ДанныеЛица.СвидетельствоДата, "ДФ=dd.MM.yyyy");
			Иначе
				ПредставлениеДаты = "--";
			КонецЕсли;
			СвидетельствоОГосРегистрации = СтрШаблон("%1 от %2", ПредставлениеНомера, ПредставлениеДаты);
			
			ЭлементТипаУчастника.СвидетельствоОГосРегистрации = СвидетельствоОГосРегистрации;
			
			ЭлементТипаУчастника.ОГРН = ДанныеЛица.ОГРНИП;
			ЭлементТипаУчастника.ДатаОГРН = ДанныеЛица.ДатаРегистрации;
			
			ЭлементТипаУчастника.ФИО.Фамилия = ДанныеЛица.Фамилия;
			ЭлементТипаУчастника.ФИО.Имя = ДанныеЛица.Имя;
			ЭлементТипаУчастника.ФИО.Отчество = ДанныеЛица.Отчество;
		Иначе
			ИмяЭлемента = "ФЛ";
			
			ПутьЭлемента = ПутьЭлементаУчастника + ".ТипУчастника." + ИмяЭлемента;
			ЭлементТипаУчастника = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД, ПутьЭлемента);
			
			ЭлементТипаУчастника.ИНН = ДанныеЛица.ИНН;
			ЭлементТипаУчастника.ФИО.Фамилия = ДанныеЛица.Фамилия;
			ЭлементТипаУчастника.ФИО.Имя = ДанныеЛица.Имя;
			ЭлементТипаУчастника.ФИО.Отчество = ДанныеЛица.Отчество;
		КонецЕсли;	
	КонецЕсли;
	
	ТипУчастника = Новый Структура(ИмяЭлемента, ЭлементТипаУчастника);
	
	СтруктураУчастника.ТипУчастника = ТипУчастника;
	
КонецПроцедуры

Процедура ЗаполнитьАдресУчастникаУПД_5_03(СтруктураУчастника, ОбозначениеУчастника, ДанныеЛица, ОбщиеПараметры)
	
	ПутьЭлементаУчастника = ОбщиеПараметры.ДополнительныеПараметры.ПутьЭлементаУчастника;
	
	УчастникСсылка = ОбщиеПараметры.ДопДанныеДокумента.СтороныСделки[ОбозначениеУчастника].Ссылка;
	
	ИмяЭлемента = "АвтоматическиЗаполняемый";
	
	ЭлементАдреса		= ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД, ПутьЭлементаУчастника + ".Адрес");
	ЭлементТипАдреса	= ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД, ПутьЭлементаУчастника + ".Адрес.ТипАдреса." + ИмяЭлемента);
	
	Если ДанныеЛица.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
		ВидАдреса = Справочники.ВидыКонтактнойИнформации.АдресПоПропискеФизическиеЛица;
		
	Иначе
		Если ТипЗнч(УчастникСсылка) = Тип("СправочникСсылка.Организации") Тогда
			ВидАдреса = Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации;
			
		Иначе
			ВидАдреса = Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты;
		КонецЕсли;
	КонецЕсли;
	
	ЭлементТипАдреса.ОбъектКонтактнойИнформации = УчастникСсылка;
	ЭлементТипАдреса.ВидКонтактнойИнформации = ОбщиеПараметры.ДопДанныеДокумента.СтороныСделки[ОбозначениеУчастника].Адрес.ВидКонтактнойИнформации;
	
	ТипАдреса = Новый Структура(ИмяЭлемента, ЭлементТипАдреса);
	
	ЭлементАдреса.ТипАдреса = ТипАдреса;
	
	СтруктураУчастника.Адрес = ЭлементАдреса;
	
КонецПроцедуры

Процедура ЗаполнитьБанковскиеРеквизитыУчастникаУПД_5_03(СтруктураУчастника, ОбозначениеУчастника, ДанныеЛица, ОбщиеПараметры)
	
	ПутьЭлементаУчастника = ОбщиеПараметры.ДополнительныеПараметры.ПутьЭлементаУчастника;
	
	ЭлементБанковскиеРеквизиты = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД, ПутьЭлементаУчастника + ".БанковскиеРеквизиты");
	
	РасчетныйСчет = ОбщиеПараметры.ДопДанныеДокумента.РасчетныеСчета[ОбозначениеУчастника];
	
	БанковскиеРеквизиты = ПолучитьБанковскиеРеквизитыУчастникаУПД_2019(РасчетныйСчет);
	
	ЗаполнитьЗначенияСвойств(ЭлементБанковскиеРеквизиты, БанковскиеРеквизиты);
	
	СтруктураУчастника.БанковскиеРеквизиты = ЭлементБанковскиеРеквизиты;
	
КонецПроцедуры

Процедура ЗаполнитьКонтактныеСведенияУчастникаУПД_5_03(СтруктураУчастника, ОбозначениеУчастника, ДанныеЛица, ОбщиеПараметры)
	
	Перем ЗначениеСвойства;
	
	ПутьЭлементаУчастника	= ОбщиеПараметры.ДополнительныеПараметры.ПутьЭлементаУчастника;
	ДанныеЛица				= ОбщиеПараметры.ДополнительныеПараметры.ДанныеЛица;
	
	ГруппаКонтактныеСведения = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД, ПутьЭлементаУчастника + ".КонтактныеСведения");
	
	ТаблицаТелефоны = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД, ПутьЭлементаУчастника + ".КонтактныеСведения.Телефоны");
	
	ТаблицаЭлектронныеПочты = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД, ПутьЭлементаУчастника + ".КонтактныеСведения.ЭлектронныеПочты");
	
	Если ДанныеЛица.Свойство("Телефоны", ЗначениеСвойства) И ЗначениеЗаполнено(ЗначениеСвойства) Тогда
		НоваяСтрока = ТаблицаТелефоны.Добавить();
		
		НоваяСтрока.Телефон = ЗначениеСвойства;
	КонецЕсли;
	
	Если ДанныеЛица.Свойство("ЭлектроннаяПочта", ЗначениеСвойства) И ЗначениеЗаполнено(ЗначениеСвойства) Тогда
		НоваяСтрока = ТаблицаЭлектронныеПочты.Добавить();
		
		НоваяСтрока.ЭлектроннаяПочта = ЗначениеСвойства;
	КонецЕсли;
	
	ГруппаКонтактныеСведения.Телефоны			= ТаблицаТелефоны;
	ГруппаКонтактныеСведения.ЭлектронныеПочты	= ТаблицаЭлектронныеПочты;
	
	СтруктураУчастника.КонтактныеСведения = ГруппаКонтактныеСведения;
	
КонецПроцедуры

Функция ПолучитьТаблицуСоставителиДокументаУПД_5_03(ПутьЭлементаТаблицы, МассивДанныхСоставителей, ОбщиеПараметры)
	
	ТаблицаСоставителиДокумента = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД, ПутьЭлементаТаблицы);
	
	Для Каждого ДанныеЛица Из МассивДанныхСоставителей Цикл
		СоставительДокумента = ПолучитьСтруктуруСоставителяДокументаУПД_5_03(
			ПутьЭлементаТаблицы + ".НомерСтроки.СоставительДокумента",
			ДанныеЛица,
			ОбщиеПараметры);
		
		НоваяСтрока = ТаблицаСоставителиДокумента.Добавить();
		
		НоваяСтрока.СоставительДокумента = СоставительДокумента;
	КонецЦикла;
	
	Возврат ТаблицаСоставителиДокумента;
		
КонецФункции

Функция ПолучитьСтруктуруСоставителяДокументаУПД_5_03(ПутьЭлементаСоставительДокумента, ДанныеЛица, ОбщиеПараметры)
	
	Перем СтранаРегистрации;
	
	// ДанныеЛица - Структура - Рузультат работы процедуры ПолучитьДанныеЮрФизЛица().
	
	ЭлементСоставительДокумента = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД, ПутьЭлементаСоставительДокумента);
	
	ДанныеЛица.Свойство("СтранаРегистрации", СтранаРегистрации);
	
	Если Не ЗначениеЗаполнено(СтранаРегистрации) Тогда
		СтранаРегистрации = Справочники.СтраныМира.Россия;
	КонецЕсли;
	
	Если СтранаРегистрации <> Справочники.СтраныМира.Россия Тогда
		ИмяЭлемента = "ИностраннаяОрганизация";
		
		ПутьЭлемента = ПутьЭлементаСоставительДокумента + "." + ИмяЭлемента;
		ЭлементТипаСоставителя = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД, ПутьЭлемента);
		
		Если ДанныеЛица.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
			Cтатус = "ИО"; // ИО - иностранная организация
		Иначе
			Cтатус = "ИГ"; // ИГ - иностранный гражданин
		КонецЕсли;
		
		Свойства = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтранаРегистрации, "Код,НаименованиеПолное");
		
		ЭлементТипаСоставителя.Статус = Cтатус;
		ЭлементТипаСоставителя.КодСтраны = Свойства.Код;
		ЭлементТипаСоставителя.НаименованиеСтраны = Свойства.НаименованиеПолное;
		ЭлементТипаСоставителя.НаименованиеОрганизации = ДанныеЛица.ОфициальноеНаименование;
		ЭлементТипаСоставителя.ИныеСведения = "1"; // Элемент обязателен при отсутствии <ИдентификаторОрганизацииИлиГражданина>
		
	ИначеЕсли ДанныеЛица.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
		ИмяЭлемента = "ИННОрганизации";
		
		ПутьЭлемента = ПутьЭлементаСоставительДокумента + "." + ИмяЭлемента;
		ЭлементТипаСоставителя = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД, ПутьЭлемента);
		
		ЭлементТипаСоставителя.ИНН = ДанныеЛица.ИНН;
		
	ИначеЕсли ДанныеЛица.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
		ИмяЭлемента = "ИННФизическогоЛица";
		
		ПутьЭлемента = ПутьЭлементаСоставительДокумента + "." + ИмяЭлемента;
		ЭлементТипаСоставителя = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД, ПутьЭлемента);
		
		ЭлементТипаСоставителя.ИНН = ДанныеЛица.ИНН;
	КонецЕсли;
	
	Возврат Новый Структура(ИмяЭлемента, ЭлементТипаСоставителя);
	
КонецФункции

#КонецОбласти

#Область Заполнение_ТаблицаСчетаФактуры

Процедура ЗаполнитьТаблицуСчетаФактурыУПД_5_03(ОбщиеПараметры)
	
	ЗаполнитьТаблицуСведенияОбОтгруженныхПозицияхУПД_5_03(ОбщиеПараметры);
	
	ЗаполнитьВсегоКОплатеУПД_5_03(ОбщиеПараметры);
	
КонецПроцедуры

Процедура ЗаполнитьТаблицуСведенияОбОтгруженныхПозицияхУПД_5_03(ОбщиеПараметры)
	
	ПутьЭлементаТаблицы = "ТаблицаСчетаФактуры.СведенияОбОтгруженныхПозициях";
	
	ТаблицаТоваров = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД, ПутьЭлементаТаблицы);
	
	// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	ТаблицаТоваров.Колонки.Добавить("ИдентификаторСтрокиГосконтрактаЕИС");
	ТаблицаТоваров.Колонки.Добавить("ИдентификаторМестаПоставкиЕИС");
	// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	
	ТаблицаНФА = ОбщиеПараметры.ДанныеДокумента.ТабЧастьНФА;
	
	// Текст такой ставки должен совпадать с ЭлектронныеДокументы.ЗаполнитьСоответствиеСтавокНДС().
	СтавкаНДСИсчисляетсяНалоговымАгентом = УчетНДСКлиентСервер.ТекстСтавкиНДСИсчисляетсяНалоговымАгентом();
	
	ЕстьКолонкаСтранаПроисхождения	= (ТаблицаНФА.Колонки.Найти("СтранаПроисхождения") <> Неопределено);
	ЕстьКолонкаСуммаАкциза			= (ТаблицаНФА.Колонки.Найти("СуммаАкциза") <> Неопределено);
	ЕстьКолонкаПризнак				= (ТаблицаНФА.Колонки.Найти("Признак") <> Неопределено);
	
	ТолькоУслуги = Истина;
	
	НомерСтроки = 0;
	
	ОписаниеРеквизитовДокумента = ОбщиеПараметры.ДополнительныеПараметры.ОписанияРеквизитовДокументов.СсылкаНаОбъект;
	
	ЕстьКолонкаСодержаниеУслуги = ЗначениеЗаполнено(ОписаниеРеквизитовДокумента.ИменаКолонокТабЧастиНФА.СодержаниеУслуги);
	
	Для Каждого СтрокаТаблицыНФА Из ТаблицаНФА Цикл
		НомерСтроки = НомерСтроки + 1;
		
		Номенклатура = СтрокаТаблицыНФА[ОписаниеРеквизитовДокумента.ИменаКолонокТабЧастиНФА.НФА];
		
		ДанныеНоменклатуры = ПрочитатьДанныеНоменклатурыУПД_5_03(Номенклатура);
		
		Признак = ПризнакТовараЕдиногоДокумента(Номенклатура);
		ЭтоПризнакУслуги = ПризнакУслуги(Признак);
		
		ДанныеСтраныПроисхождения = ПрочитатьДанныеСтраныПроисхожденияУПД_5_03(СтрокаТаблицыНФА, ДанныеНоменклатуры, ЕстьКолонкаСтранаПроисхождения, ЭтоПризнакУслуги);
		
		Если Не ЭтоПризнакУслуги Тогда
			ТолькоУслуги = Ложь;
		КонецЕсли;
		
		ОбщиеПараметры.ДополнительныеПараметры.ЭтоПризнакУслуги = ЭтоПризнакУслуги;
		
		ОбщиеПараметры.ДополнительныеПараметры.НомерСтроки = НомерСтроки;
		
		НоваяСтрока = ТаблицаТоваров.Добавить();
		
		Если ЕстьКолонкаСодержаниеУслуги И ЗначениеЗаполнено(СтрокаТаблицыНФА[ОписаниеРеквизитовДокумента.ИменаКолонокТабЧастиНФА.СодержаниеУслуги]) Тогда
			Наименование = СтрокаТаблицыНФА[ОписаниеРеквизитовДокумента.ИменаКолонокТабЧастиНФА.СодержаниеУслуги];
			
		ИначеЕсли ЗначениеЗаполнено(ДанныеНоменклатуры.НаименованиеПолное) Тогда
			Наименование = ДанныеНоменклатуры.НаименованиеПолное;
			
		Иначе
			Наименование = Строка(Номенклатура);
		КонецЕсли;
		
		НоваяСтрока.Наименование = Наименование;
		
		Если Не ОбщиеПараметры.ДополнительныеПараметры.ЭтоСФАвансовый Тогда
			ЗаполнитьЕдиницуИзмеренияУПД_5_03(НоваяСтрока, СтрокаТаблицыНФА, ДанныеНоменклатуры, ОбщиеПараметры);
		КонецЕсли;
		
		НалоговаяСтавка = ?(ОбщиеПараметры.ДополнительныеПараметры.ЭтоСФШкурыЛом, СтавкаНДСИсчисляетсяНалоговымАгентом, СтрокаТаблицыНФА.СтавкаНДС);
		
		СтоимостьСНалогом	= СтрокаТаблицыНФА[ОписаниеРеквизитовДокумента.ИменаКолонокТабЧастиНФА.Всего];
		СуммаНалога			= СтрокаТаблицыНФА.СуммаНДС;
		Количество			= СтрокаТаблицыНФА.Количество;
		Цена				= СтрокаТаблицыНФА.Цена;
		СтоимостьБезНалога	= СтоимостьСНалогом - СуммаНалога;
		
		Если ОбщиеПараметры.ДополнительныеПараметры.ЭтоСФАвансовый Тогда
			Количество = 0;
			Цена = 0;
			СтоимостьБезНалога = 0;
		КонецЕсли;
		
		Если ОбщиеПараметры.ДополнительныеПараметры.ЭтоСФШкурыЛом Тогда
			СтоимостьСНалогом = 0;
			СуммаНалога = 0;
		КонецЕсли;
		
		НоваяСтрока.Количество			= Количество;
		НоваяСтрока.Цена				= Цена;
		НоваяСтрока.СтоимостьБезНалога	= СтоимостьБезНалога;
		НоваяСтрока.НалоговаяСтавка		= НалоговаяСтавка;
		НоваяСтрока.СтоимостьСНалогом   = СтоимостьСНалогом;
		
		Если Не ОбщиеПараметры.ДополнительныеПараметры.ЭтоСФАвансовый И Не ЭтоПризнакУслуги И ДанныеНоменклатуры <> Неопределено Тогда
			ЗаполнитьСведенияОДекларацииУПД_5_03(НоваяСтрока, ДанныеНоменклатуры, ДанныеСтраныПроисхождения, ОбщиеПараметры);
		КонецЕсли;
		
		НоваяСтрока.Признак				= ?(ЕстьКолонкаПризнак, СтрокаТаблицыНФА.Признак, Признак);
		НоваяСтрока.ИнформацияОПризнаке	= ?(ЕстьКолонкаПризнак, СтрокаТаблицыНФА.ПризнакДополнительнаяИнформация, ПризнакТарыЕдиногоДокумента(Номенклатура));
		
		Если ЗначениеЗаполнено(ДанныеСтраныПроисхождения.Наименование) Тогда
			ЗаполнитьСтраныПроисхожденияУПД_5_03(НоваяСтрока, ДанныеСтраныПроисхождения.Наименование, ОбщиеПараметры);
		КонецЕсли;
		
		НоваяСтрока.Код = СокрЛП(ДанныеНоменклатуры.Код);
		НоваяСтрока.КодВидаТовара = Строка(ДанныеНоменклатуры.КодТНВЭД);
		НоваяСтрока.ГТИН = ДанныеНоменклатуры.КодGTIN;
		
		Если ОбщиеПараметры.ДополнительныеПараметры.НеобходимоЗаполнениеДанныхЭДОПродавцаДляГосНужд Тогда
			НоваяСтрока.Код = ДанныеНоменклатуры.КодПоКТРУ;
			НоваяСтрока.КодКаталога = ДанныеНоменклатуры.КодКаталога;
		КонецЕсли;
		
		Если ОбщиеПараметры.ДополнительныеПараметры.ВестиУчетПрослеживаемыхТоваров
			И Не ОбщиеПараметры.ДополнительныеПараметры.ЭтоСФАвансовый И Не ЭтоПризнакУслуги Тогда
			ЗаполнитьСведенияОПрослеживаемостиУПД_5_03(НоваяСтрока, СтрокаТаблицыНФА, ОбщиеПараметры);
		КонецЕсли;
		
		Если ОбщиеПараметры.ДанныеДокумента.ТабЧастьМаркировкаТоваров <> Неопределено Тогда
			ЗаполнитьСведенияОМаркировкеУПД_5_03(НоваяСтрока, СтрокаТаблицыНФА, ОбщиеПараметры);
		КонецЕсли;
		
		Если Не ОбщиеПараметры.ДополнительныеПараметры.ЭтоСФАвансовый Тогда
			ЗаполнитьСуммуАкцизаУПД_5_03(НоваяСтрока, СтрокаТаблицыНФА, ЕстьКолонкаСуммаАкциза, ОбщиеПараметры);
		КонецЕсли;
		
		НоваяСтрока.СуммаНалога = ПолучитьСтруктуруСуммаНалогаУПД_5_03(СуммаНалога, НалоговаяСтавка);
		
		НоваяСтрока.ДокументОснование = ОбщиеПараметры.ДанныеДокумента.Шапка.ДокументОснование;
		
		ЗаполнитьСопоставлениеУПД_5_03(НоваяСтрока, Номенклатура, ОбщиеПараметры);
		
		// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
		Если ОбщиеПараметры.ДопДанныеДокумента.ДанныеЕИС.ЕстьЭлектронноеАктирование Тогда
			ЭлектронноеАктированиеБГУ.ЗаполнитьДанныеПоСтрокеТоваровУПД_5_03(НоваяСтрока, СтрокаТаблицыНФА, ОбщиеПараметры);
		КонецЕсли;
		// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
		
		// Обработка ошибки через механизм сообщений пользователю.
		ДобавитьОписаниеОшибокЗаполнения_СтрокаТаблицыТоваровУПД_5_03(ОбщиеПараметры, ПутьЭлементаТаблицы, НоваяСтрока, Номенклатура);
	КонецЦикла;
	
	ОбщиеПараметры.ДополнительныеПараметры.ТаблицаТоваров = ТаблицаТоваров;
	ОбщиеПараметры.ДополнительныеПараметры.ТолькоУслуги = ТолькоУслуги;
	
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ОбщиеПараметры.ДеревоЭД, ТаблицаТоваров, ПутьЭлементаТаблицы);
	
КонецПроцедуры

Процедура ЗаполнитьЕдиницуИзмеренияУПД_5_03(СтрокаТаблицыТоваров, СтрокаТаблицыНФА, ДанныеНоменклатуры, ОбщиеПараметры)
	
	ИменаКолонокТабЧастиНФА = ОбщиеПараметры.ДополнительныеПараметры.ОписанияРеквизитовДокументов.СсылкаНаОбъект.ИменаКолонокТабЧастиНФА;
	
	Если ЗначениеЗаполнено(ИменаКолонокТабЧастиНФА.ЕдиницаИзмеренияКод)
		И ЗначениеЗаполнено(ИменаКолонокТабЧастиНФА.ЕдиницаИзмеренияНаименование) Тогда
		
		ЕдиницаИзмеренияКод				= СтрокаТаблицыНФА[ИменаКолонокТабЧастиНФА.ЕдиницаИзмеренияКод];
    	ЕдиницаИзмеренияНаименование	= СтрокаТаблицыНФА[ИменаКолонокТабЧастиНФА.ЕдиницаИзмеренияНаименование];
		
	Иначе
		ЕдиницаИзмеренияКод				= "";
		ЕдиницаИзмеренияНаименование	= "";
		
		Номенклатура = СтрокаТаблицыНФА[ИменаКолонокТабЧастиНФА.НФА];
		
		Если ТипЗнч(Номенклатура) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
			ЕдиницаИзмерения = ОбщиеПараметры.ЕдИзмШт;
		Иначе
			ЕдиницаИзмерения = ДанныеНоменклатуры.ЕдиницаИзмерения;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЕдиницаИзмерения, "Наименование, Код");
			
			ЕдиницаИзмеренияКод				= ЗначенияРеквизитов.Код;
			ЕдиницаИзмеренияНаименование	= ЗначенияРеквизитов.Наименование;
		КонецЕсли;
	КонецЕсли;
	
	СтрокаТаблицыТоваров.ЕдиницаИзмеренияКод          = СокрЛП(ЕдиницаИзмеренияКод);
	СтрокаТаблицыТоваров.ЕдиницаИзмеренияНаименование = СокрЛП(ЕдиницаИзмеренияНаименование);
	
КонецПроцедуры

Процедура ЗаполнитьСведенияОДекларацииУПД_5_03(СтрокаТаблицыТоваров, ДанныеНоменклатуры, ДанныеСтраныПроисхождения, ОбщиеПараметры)
	
	// СведенияОДекларации (Файл.Документ.ТаблСчФакт.СведТов.СвДТ)
	// При осуществлении закупок для обеспечения государственных и муниципальных нужд может заполняться для любой страны происхождения
	
	Если (ДанныеСтраныПроисхождения.ЭтоСтранаЕАЭС Или ДанныеСтраныПроисхождения.ЭтоСтранаРоссия)
		И Не ОбщиеПараметры.ДополнительныеПараметры.НеобходимоЗаполнениеДанныхЭДОПродавцаДляГосНужд Тогда
		Возврат;
	КонецЕсли;
	
	// НомерДекларации (Файл.Документ.ТаблСчФакт.СведТов.СвДТ.НомерДТ)
	// При <Функция> = СЧФ | СЧФДОП элемент обязателен, кроме случая, когда <СпОбстФСЧФ> = 2 или в отношении товаров,
	// страной происхождения которых не являются государства - члены Евразийского экономического союза.
	// В отношении товаров, подлежащих прослеживаемости, указывается "Прослеж"
	
	НомерДекларации = Неопределено;
	
	Если ОбщиеПараметры.ДополнительныеПараметры.ВестиУчетПрослеживаемыхТоваров И ДанныеНоменклатуры.ПрослеживаемыйТовар = Истина Тогда
		НомерДекларации = "Прослеж";
		
	ИначеЕсли ЗначениеЗаполнено(ДанныеНоменклатуры.НомерГТД) Тогда
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеНоменклатуры.НомерГТД, "Код");
		
		НомерДекларации = СокрЛП(ЗначенияРеквизитов.Код);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НомерДекларации) Тогда
		Возврат;
	КонецЕсли;
	
	// КодСтраны (Файл.Документ.ТаблСчФакт.СведТов.СвДТ.КодПроисх)
	// В общем случае заполняется в отношении товаров, страной происхождения которых не является Российская Федерация
	// (кроме случаев осуществления закупок для обеспечения государственных и муниципальных нужд).
	// При <Функция> = СЧФ | СЧФДОП элемент обязателен, кроме случая, когда <СпОбстФСЧФ> = 2
	
	КодСтраны = ДанныеСтраныПроисхождения.Код;
	
	ТаблицаСведенияОДекларации = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД, "ТаблицаСчетаФактуры.СведенияОбОтгруженныхПозициях.НомерСтроки.СведенияОДекларации");
	
	НоваяСтрока = ТаблицаСведенияОДекларации.Добавить();
	НоваяСтрока.КодСтраны		= КодСтраны;
	НоваяСтрока.НомерДекларации	= НомерДекларации;
	
	СтрокаТаблицыТоваров.СведенияОДекларации = ТаблицаСведенияОДекларации;
	
КонецПроцедуры

Процедура ЗаполнитьСтраныПроисхожденияУПД_5_03(СтрокаТаблицыТоваров, НаименованиеСтраны, ОбщиеПараметры)
	
	ТаблицаСтраныПроисхождения = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД, "ТаблицаСчетаФактуры.СведенияОбОтгруженныхПозициях.НомерСтроки.СтраныПроисхождения");
	
	НоваяСтрока = ТаблицаСтраныПроисхождения.Добавить();
	
	НоваяСтрока.СтранаПроисхождения = НаименованиеСтраны;
	
	СтрокаТаблицыТоваров.СтраныПроисхождения = ТаблицаСтраныПроисхождения;
	
КонецПроцедуры

Процедура ЗаполнитьСведенияОПрослеживаемостиУПД_5_03(СтрокаТаблицыТовары, СтрокаТаблицыНФА, ОбщиеПараметры)
	
	ПутьЭлемента = "ТаблицаСчетаФактуры.СведенияОбОтгруженныхПозициях.НомерСтроки.СведенияОПрослеживаемости";
	
	ТаблицаСведенияОПрослеживаемости = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД, ПутьЭлемента);
	
	Для Каждого СтрокаТаблицы Из СтрокаТаблицыНФА.СведенияОПрослеживаемости Цикл
		НоваяСтрока = ТаблицаСведенияОПрослеживаемости.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы,
			"НомерТовара,ЕдиницаИзмеренияКод,ЕдиницаИзмеренияНаименование,Количество,СтоимостьБезНДС,КоличествоУчетное");
		
		НоваяСтрока.ЕдиницаИзмеренияКод = СокрЛП(НоваяСтрока.ЕдиницаИзмеренияКод);
	КонецЦикла;
	
	// Обработка ошибки через механизм сообщений пользователю.
	ИменаКолонок = СтрРазделить("НомерТовара,ЕдиницаИзмеренияКод,ЕдиницаИзмеренияНаименование,Количество,СтоимостьБезНДС", ", ", Ложь);
	
	ОписаниеРеквизитовДокумента = ОбщиеПараметры.ДополнительныеПараметры.ОписанияРеквизитовДокументов.ПервичныйДокументПередачи;
	
	ПутьКДанным = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ОписаниеРеквизитовДокумента.ПутьКТабЧастиНФА,
		ОбщиеПараметры.ДополнительныеПараметры.НомерСтроки, ОписаниеРеквизитовДокумента.ИменаКолонокТабЧастиНФА.РНПТ);
		
	Для Каждого ИмяКолонки Из ИменаКолонок Цикл
		ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(ТаблицаСведенияОПрослеживаемости,
			ИмяКолонки, ОбщиеПараметры.ДопДанныеДокумента.ОписаниеФактаПередачи.ПервичныйДокументПередачи.Ссылка, ПутьКДанным);
	КонецЦикла;
	
	СтрокаТаблицыТовары.СведенияОПрослеживаемости = ТаблицаСведенияОПрослеживаемости;
	
КонецПроцедуры

Процедура ЗаполнитьСведенияОМаркировкеУПД_5_03(СтрокаТаблицыТовары, СтрокаТаблицыНФА, ОбщиеПараметры)
	
	// В программе поддерживаются только типы упаковки "Индивидуальная упаковка" и "Транспортная упаковка".
	// Отдельного типа упаковки для контрольных знаков не предусмотрено.
	
	ПутьТаблицыСведенияОМаркировке = "ТаблицаСчетаФактуры.СведенияОбОтгруженныхПозициях.НомерСтроки.СведенияОМаркировке";
	
	ТаблицаСведенияОМаркировке = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД, ПутьТаблицыСведенияОМаркировке);
	
	// Тип упаковки "Индивидуальная упаковка".
	ТаблицаИндивидуальнаяУпаковка = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД,
		ПутьТаблицыСведенияОМаркировке + ".НомерСтроки.Идентификатор.ИдентификаторыУпаковок");
	
	// Для контрольных знаков в программе не предусмотрен специальный тип упаковки.
	// В настоящий момент времени эта таблица не заполняется.
	ТаблицаКонтрольныеЗнаки = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД,
		ПутьТаблицыСведенияОМаркировке + ".НомерСтроки.Идентификатор.КонтрольныеЗнаки");
	
	ПоискМаркировки = ОбщиеПараметры.ДополнительныеПараметры.ПоискМаркировки;
	
	ПоискМаркировки.ИдентификаторСтроки = СтрокаТаблицыНФА.ИдентификаторСтроки;
	
	ТабЧастьМаркировкаТоваров = ОбщиеПараметры.ДанныеДокумента.ТабЧастьМаркировкаТоваров;
	
	МассивСтрок = ТабЧастьМаркировкаТоваров.НайтиСтроки(ПоискМаркировки);
	
	КлассификацияУпаковок = КлассифицироватьТипыУпаковокУПД_5_03(МассивСтрок);
	
	// Индивидуальную упаковку со всех строк собираем в одну таблицу и записываем в одну строку маркировки.
	Если КлассификацияУпаковок.ИндивидуальнаяУпаковка.Количество() > 0 Тогда
		НоваяСтрока = ТаблицаСведенияОМаркировке.Добавить();
		
		Для Каждого ИндексСтроки Из КлассификацияУпаковок.ИндивидуальнаяУпаковка Цикл
			СтрокаУпаковки = МассивСтрок[ИндексСтроки];
			
			НомерУпаковки = СокрЛП(СтрокаУпаковки.НомерУпаковки);
			
			НоваяСтрокаУпаковки = ТаблицаИндивидуальнаяУпаковка.Добавить();
			НоваяСтрокаУпаковки.ИдентификаторУпаковки = НомерУпаковки;
		КонецЦикла;
		
		НоваяСтрока.Идентификатор = Новый Структура();
		НоваяСтрока.Идентификатор.Вставить("ИдентификаторыУпаковок", ТаблицаИндивидуальнаяУпаковка);
	КонецЕсли;
	
	// Иные типы упаковок записываем по одной в отдельные строки маркировки.
	Для Каждого ИндексСтроки Из КлассификацияУпаковок.ИнаяУпаковка Цикл
		СтрокаУпаковки = МассивСтрок[ИндексСтроки];
		
		НомерУпаковки = СокрЛП(СтрокаУпаковки.НомерУпаковки);
		
		НоваяСтрока = ТаблицаСведенияОМаркировке.Добавить();
		НоваяСтрока.ИдентификаторУпаковки = НомерУпаковки;
	КонецЦикла;
	
	Если МассивСтрок.Количество() = 0 И ЗначениеЗаполнено(СтрокаТаблицыНФА.СведенияОбъемноСортовогоУчетаМаркированныхТоваров) Тогда
		Сведения = СтрЗаменить(СтрокаТаблицыНФА.СведенияОбъемноСортовогоУчетаМаркированныхТоваров, ")", "");
		Сведения = СтрЗаменить(Сведения, "(", "");
		
		НоваяСтрока = ТаблицаСведенияОМаркировке.Добавить();
		
		НоваяСтрока.ИдентификаторУпаковки = СокрЛП(Сведения);
	КонецЕсли;	
	
	Если ТаблицаСведенияОМаркировке.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаТаблицыТовары.СведенияОМаркировке = ТаблицаСведенияОМаркировке;
	
КонецПроцедуры

Функция КлассифицироватьТипыУпаковокУПД_5_03(МассивСтрокМаркировки)
	
	ИндивидуальнаяУпаковка = Новый Массив();
	ИнаяУпаковка = Новый Массив();
	
	ИндексСтроки = 0;
	
	Для Каждого СтрокаМаркировки Из МассивСтрокМаркировки Цикл
		Если СтрокаМаркировки.ТипУпаковки = "Индивидуальная упаковка" Тогда
			ИндивидуальнаяУпаковка.Добавить(ИндексСтроки);
		Иначе
			// "Транспортная упаковка" или любой иной тип упаковки.
			ИнаяУпаковка.Добавить(ИндексСтроки);
		КонецЕсли;
		
		ИндексСтроки = ИндексСтроки + 1;
	КонецЦикла;
	
	КлассификацияУпаковок = Новый Структура();
	КлассификацияУпаковок.Вставить("ИндивидуальнаяУпаковка", ИндивидуальнаяУпаковка);
	КлассификацияУпаковок.Вставить("ИнаяУпаковка", ИнаяУпаковка);
	
	Возврат КлассификацияУпаковок;
	
КонецФункции

Процедура ЗаполнитьСуммуАкцизаУПД_5_03(НоваяСтрока, СтрокаТаблицыНФА, ЕстьКолонкаСуммаАкциза, ОбщиеПараметры)
	
	СтруктураСуммаАкциза = Новый Структура();
	
	Если ЕстьКолонкаСуммаАкциза И ЗначениеЗаполнено(СтрокаТаблицыНФА.СуммаАкциза) Тогда
		СтруктураСуммаАкциза.Вставить("Сумма", СтрокаТаблицыНФА.СуммаАкциза);
	Иначе
		// Принимает значение: без акциза
		СтруктураСуммаАкциза.Вставить("БезАкциза", Истина);
	КонецЕсли;
	
	НоваяСтрока.СуммаАкциза = СтруктураСуммаАкциза;
	
КонецПроцедуры

Процедура ЗаполнитьСопоставлениеУПД_5_03(НоваяСтрока, Номенклатура, ОбщиеПараметры)
	
	Если Не ЗначениеЗаполнено(Номенклатура) Или ТипЗнч(Номенклатура) <> Тип("СправочникСсылка.Номенклатура") Тогда
		Возврат;
	КонецЕсли;
	
	ГруппаСопоставление = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД, "ТаблицаСчетаФактуры.СведенияОбОтгруженныхПозициях.НомерСтроки.Сопоставление");
	
	ГруппаСопоставление.Вставить("Наименование",		НоваяСтрока.Наименование);
	ГруппаСопоставление.Вставить("ЕдиницаИзмерения",	НоваяСтрока.ЕдиницаИзмеренияНаименование);
	ГруппаСопоставление.Вставить("ЕдиницаИзмеренияКод",	НоваяСтрока.ЕдиницаИзмеренияКод);
	ГруппаСопоставление.Вставить("НоменклатураИБ",		Номенклатура);
	
	НоваяСтрока.Сопоставление = ГруппаСопоставление;
	
КонецПроцедуры

Процедура ЗаполнитьВсегоКОплатеУПД_5_03(ОбщиеПараметры)
	
	НачалоПути = "ТаблицаСчетаФактуры.ВсегоКОплате";
	
	ТаблицаТоваров = ОбщиеПараметры.ДополнительныеПараметры.ТаблицаТоваров;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ОбщиеПараметры.ДеревоЭД, НачалоПути + ".СтоимостьБезНалога", ТаблицаТоваров.Итог("СтоимостьБезНалога"));
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ОбщиеПараметры.ДеревоЭД, НачалоПути + ".СтоимостьСНалогом", ТаблицаТоваров.Итог("СтоимостьСНалогом"));
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ОбщиеПараметры.ДеревоЭД, НачалоПути + ".Количество", ТаблицаТоваров.Итог("Количество"));
	
	СуммаНалога = ПолучитьСтруктуруСуммаНалогаВсегоУПД_5_03(ТаблицаТоваров);
	
	ЭлектронноеВзаимодействие.ЗагрузитьСтруктуруВГруппуДерева(ОбщиеПараметры.ДеревоЭД, СуммаНалога, НачалоПути + ".СуммаНалога");
	
КонецПроцедуры

Функция ПрочитатьДанныеНоменклатурыУПД_5_03(Номенклатура)
	
	ИменаРеквизитов = СтрРазделить("ЕдиницаИзмерения,КодКаталога,КодПоКТРУ,НаименованиеПолное,Код,КодТНВЭД,СтранаПроисхождения,ПрослеживаемыйТовар,НомерГТД,КодGTIN", ", ", Ложь);
	
	ДанныеНоменклатуры = Новый Структура(СтрСоединить(ИменаРеквизитов, ","));
	
	Если Не ЗначениеЗаполнено(Номенклатура) Или ТипЗнч(Номенклатура) = Тип("Строка") Тогда
		ИменаРеквизитов.Очистить();
		
	ИначеЕсли ТипЗнч(Номенклатура) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
		// Отсутствуют некоторые реквизиты
		ИменаРеквизитов.Удалить(ИменаРеквизитов.Найти("ЕдиницаИзмерения"));
		ИменаРеквизитов.Удалить(ИменаРеквизитов.Найти("НомерГТД"));
		ИменаРеквизитов.Удалить(ИменаРеквизитов.Найти("КодGTIN"));
	КонецЕсли;
	
	Если ИменаРеквизитов.Количество() > 0 Тогда
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, ИменаРеквизитов);
		
		ЗаполнитьЗначенияСвойств(ДанныеНоменклатуры, ЗначенияРеквизитов);
	КонецЕсли;
	
	Возврат ДанныеНоменклатуры;
	
КонецФункции

Функция ПрочитатьДанныеСтраныПроисхожденияУПД_5_03(СтрокаТаблицыНФА, ДанныеНоменклатуры, ЕстьКолонкаСтранаПроисхождения, ЭтоПризнакУслуги)
	
	ДанныеСтраныПроисхождения = Новый Структура("
		|Наименование,
		|Код,
		|ЭтоСтранаРоссия,
		|ЭтоСтранаЕАЭС");
	
	Если ЭтоПризнакУслуги Тогда
		СтранаПроисхождения = Неопределено;
	Иначе
		СтранаПроисхождения = ?(ЕстьКолонкаСтранаПроисхождения,
			СтрокаТаблицыНФА.СтранаПроисхождения,
			ДанныеНоменклатуры.СтранаПроисхождения);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтранаПроисхождения) Тогда
		ЗаполнитьЗначенияСвойств(ДанныеСтраныПроисхождения, ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтранаПроисхождения, "Наименование,Код"));
		
		ДанныеСтраныПроисхождения.ЭтоСтранаРоссия = (СтранаПроисхождения = Справочники.СтраныМира.Россия);
		ДанныеСтраныПроисхождения.ЭтоСтранаЕАЭС = ОбщегоНазначенияБГУ.ГосударствоЧленТаможенногоСоюза(СтранаПроисхождения);
	Иначе
		ДанныеСтраныПроисхождения.Наименование = "";
		ДанныеСтраныПроисхождения.Код = "";
		ДанныеСтраныПроисхождения.ЭтоСтранаРоссия = Ложь;
		ДанныеСтраныПроисхождения.ЭтоСтранаЕАЭС = Ложь;
	КонецЕсли;
	
	Возврат ДанныеСтраныПроисхождения;
	
КонецФункции

Функция ПолучитьСтруктуруСуммаНалогаУПД_5_03(СуммаНДС, НалоговаяСтавка)
	
	СтруктураСуммаНалога = Новый Структура();
	
	Если НалоговаяСтавка = Перечисления.СтавкиНДС.БезНДС И Не ЗначениеЗаполнено(СуммаНДС) Тогда
		СтруктураСуммаНалога.Вставить("БезНДС", Истина);
	Иначе
		СтруктураСуммаНалога.Вставить("Сумма", СуммаНДС);
	КонецЕсли;
	
	Возврат СтруктураСуммаНалога;
	
КонецФункции

Функция ПолучитьСтруктуруСуммаНалогаВсегоУПД_5_03(ТаблицаТоваров)
	
	СтавкаБезНДС = Перечисления.СтавкиНДС.БезНДС;
	
	СуммаНДС = 0;
	
	СчетчикСтрокБезНДС = 0;
	
	Для Каждого СтрокаТаблицы Из ТаблицаТоваров Цикл
		Если СтрокаТаблицы.НалоговаяСтавка = СтавкаБезНДС Тогда
			СчетчикСтрокБезНДС = СчетчикСтрокБезНДС + 1;
		КонецЕсли;
		
		Если СтрокаТаблицы.СуммаНалога.Свойство("БезНДС") И СтрокаТаблицы.СуммаНалога.БезНДС = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		СуммаНДС = СуммаНДС + СтрокаТаблицы.СуммаНалога.Сумма;
	КонецЦикла;
	
	НалоговаяСтавка = Неопределено;
	
	Если СчетчикСтрокБезНДС = ТаблицаТоваров.Количество() Тогда
		НалоговаяСтавка = СтавкаБезНДС;
	КонецЕсли;
	
	Возврат ПолучитьСтруктуруСуммаНалогаУПД_5_03(СуммаНДС, НалоговаяСтавка);
	
КонецФункции

#КонецОбласти

#Область Заполнение_СведенияОПередаче

Процедура ЗаполнитьСведенияОПередачеУПД_5_03(ОбщиеПараметры)
	
	ЗаполнитьОперациюУПД_5_03(ОбщиеПараметры);
	
КонецПроцедуры

Процедура ЗаполнитьОперациюУПД_5_03(ОбщиеПараметры)
	
	НачалоПути = "СведенияОПередаче.Операция";
	
	ЗаполнитьСодержаниеОперацииУПД_5_03(ОбщиеПараметры);
	
	ТипОбъекта = ТипЗнч(ОбщиеПараметры.СсылкаНаОбъект);
	
	Если ТипОбъекта = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный") Тогда
		ВидОперации = Строка(Перечисления.ВидыОперацийЭД.Исправление);
	Иначе
		ВидОперации = Строка(Перечисления.ВидыОперацийЭД.ПродажаКомиссия);
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ОбщиеПараметры.ДеревоЭД, НачалоПути + ".ВидОперации", ВидОперации);
	
	Если (ОбщиеПараметры.ДополнительныеПараметры.ЭтоФункцияСЧФДОП Или ОбщиеПараметры.ДополнительныеПараметры.ЭтоФункцияДОП)
		И Не ОбщиеПараметры.ДополнительныеПараметры.ЭтоСФАвансовый Тогда
		ЗаполнитьДатуОтгрузкиУПД_5_03(ОбщиеПараметры);
		
		ЗаполнитьОснованиеОтгрузкиПередачиУПД_5_03(ОбщиеПараметры);
		
		ЗаполнитьЛицоОтветственноеЗаПередачуУПД_5_03(ОбщиеПараметры);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьСодержаниеОперацииУПД_5_03(ОбщиеПараметры)
	
	ТипОбъекта = ТипЗнч(ОбщиеПараметры.СсылкаНаОбъект);
	
	Если ТипОбъекта = Тип("ДокументСсылка.АктОбОказанииУслуг")
		Или ОбщиеПараметры.ДополнительныеПараметры.ТолькоУслуги Тогда
		СодержаниеОперации = НСтр("ru='Услуги оказаны в полном объеме'");
		
	ИначеЕсли ТипОбъекта = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный") Тогда
		СодержаниеОперации = ?(ОбщиеПараметры.ДополнительныеПараметры.ЭтоСФАвансовый,
			НСтр("ru='Исправлен авансовый счет-фактура'"),
			НСтр("ru='Исправлен счет-фактура на реализацию'"));
		
	ИначеЕсли ТипОбъекта = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		СодержаниеОперации = ?(ОбщиеПараметры.ДополнительныеПараметры.ЭтоСФАвансовый,
			НСтр("ru='Выставлен авансовый счет-фактура'"),
			НСтр("ru='Выставлен счет-фактура на реализацию'"));
			
	Иначе
		СодержаниеОперации = НСтр("ru='Товары переданы'");
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ОбщиеПараметры.ДеревоЭД, "СведенияОПередаче.Операция.СодержаниеОперации", СодержаниеОперации);
	
КонецПроцедуры

Процедура ЗаполнитьДатуОтгрузкиУПД_5_03(ОбщиеПараметры)
	
	ПутьЭлемента = "СведенияОПередаче.Операция.ДатаОтгрузки";
	
	ОписаниеФактаПередачи = ОбщиеПараметры.ДопДанныеДокумента.ОписаниеФактаПередачи;
	РеквизитыПередачи = ОписаниеФактаПередачи.РеквизитыПередачи;
	
	Если ОписаниеФактаПередачи.ПередачаСостоялась Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ОбщиеПараметры.ДеревоЭД, ПутьЭлемента, РеквизитыПередачи.ДатаПередачиТРУ);
	КонецЕсли;
	
	ДобавитьОписаниеОшибокЗаполнения_ДатаОтгрузкиУПД_5_03(ОбщиеПараметры, ПутьЭлемента);
	
КонецПроцедуры

Процедура ЗаполнитьОснованиеОтгрузкиПередачиУПД_5_03(ОбщиеПараметры)
	
	ТаблицаДокументов = ПолучитьТаблицуДокументыОснованияОтгрузкиПередачиУПД_5_03(ОбщиеПараметры);
	
	Если ТаблицаДокументов.Количество() > 0 Тогда
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ОбщиеПараметры.ДеревоЭД, ТаблицаДокументов,
			"СведенияОПередаче.Операция.ОснованиеОтгрузкиПередачи.ДокументыОснования");
	Иначе
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ОбщиеПараметры.ДеревоЭД,
			"СведенияОПередаче.Операция.ОснованиеОтгрузкиПередачи.БезДокументаОснования", Истина);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьТаблицуДокументыОснованияОтгрузкиПередачиУПД_5_03(ОбщиеПараметры)
	
	ТаблицаДокументов = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД,
		"СведенияОПередаче.Операция.ОснованиеОтгрузкиПередачи.ДокументыОснования");
	
	ПутьГруппыДокументОснование = "СведенияОПередаче.Операция.ОснованиеОтгрузкиПередачи.ДокументыОснования.НомерСтроки.ДокументОснование";
	
	ТипОбъекта = ТипЗнч(ОбщиеПараметры.СсылкаНаОбъект);
	
	// Договор.
	
	СвойстваДоговора = Новый Структура("ВидОбязательства,НомерДоговора,ДатаДоговора");
	
	Если ТипОбъекта = Тип("ДокументСсылка.СчетФактураВыданный") Или ТипОбъекта = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный") Тогда
		Договор = ОбщиеПараметры.ДанныеДокумента.Шапка.Договор;
		
		Если ЗначениеЗаполнено(Договор) Тогда
			СвойстваДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, "ВидОбязательства,НомерДоговора,ДатаДоговора");
		КонецЕсли;
	Иначе
		СвойстваДоговора.ВидОбязательства	= ОбщиеПараметры.ДанныеДокумента.Шапка.ДокументОснованиеНаименование;
		СвойстваДоговора.НомерДоговора		= ОбщиеПараметры.ДанныеДокумента.Шапка.ДокументОснованиеНомер;
		СвойстваДоговора.ДатаДоговора		= ОбщиеПараметры.ДанныеДокумента.Шапка.ДокументОснованиеДата;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СвойстваДоговора.ВидОбязательства)
		Или ЗначениеЗаполнено(СвойстваДоговора.НомерДоговора)
		Или ЗначениеЗаполнено(СвойстваДоговора.ДатаДоговора) Тогда
		
		ГруппаДокументОснование = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД, ПутьГруппыДокументОснование);
		
		ГруппаДокументОснование.НаименованиеДокумента	= СвойстваДоговора.ВидОбязательства;
		ГруппаДокументОснование.НомерДокумента			= СвойстваДоговора.НомерДоговора;
		ГруппаДокументОснование.ДатаДокумента			= СвойстваДоговора.ДатаДоговора;
		
		НоваяСтрока = ТаблицаДокументов.Добавить();
		
		НоваяСтрока.ДокументОснование = ГруппаДокументОснование;
	КонецЕсли;
	
	// Счет на оплату.
	
	СчетНаОплату = Неопределено;
	
	Если ТипОбъекта = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		СчетНаОплату = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбщиеПараметры.СсылкаНаОбъект, "СчетНаОплату");
		
	ИначеЕсли ТипОбъекта = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный") Тогда
		ИсправляемыйДокумент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбщиеПараметры.СсылкаНаОбъект, "ИсправляемыйДокумент");
		
		Если ЗначениеЗаполнено(ИсправляемыйДокумент) Тогда
			ПервоначальныйСчетФактура = УчетНДС.ПолучитьПервоначальныйСчетФактуруВыданный(ИсправляемыйДокумент);
			
			Если ЗначениеЗаполнено(ПервоначальныйСчетФактура) Тогда
				СчетНаОплату = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПервоначальныйСчетФактура, "СчетНаОплату");
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ТипОбъекта = Тип("ДокументСсылка.АктОбОказанииУслуг")
		Или ТипОбъекта = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12")
		Или ТипОбъекта = Тип("ДокументСсылка.НакладнаяНаОтпускМ15") Тогда
		
		ДокументОснование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбщиеПараметры.СсылкаНаОбъект, "ДокументОснование");
		
		Если ЗначениеЗаполнено(ДокументОснование) И ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.СчетНаОплату") Тогда
			СчетНаОплату = ДокументОснование;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СчетНаОплату) Тогда
		СвойстваСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СчетНаОплату, "Номер, Дата");
		
		НомерСчета = РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоИмениДокумента("СчетНаОплату", СвойстваСчета.Номер);
		
		ГруппаДокументОснование = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД, ПутьГруппыДокументОснование);
		
		ГруппаДокументОснование.НаименованиеДокумента	= НСтр("ru='Счет на оплату'");
		ГруппаДокументОснование.НомерДокумента			= НомерСчета;
		ГруппаДокументОснование.ДатаДокумента			= СвойстваСчета.Дата;
		
		НоваяСтрока = ТаблицаДокументов.Добавить();
		
		НоваяСтрока.ДокументОснование = ГруппаДокументОснование;
	КонецЕсли;
	
	Возврат ТаблицаДокументов;
	
КонецФункции

Процедура ЗаполнитьЛицоОтветственноеЗаПередачуУПД_5_03(ОбщиеПараметры)
	
	НачалоПути = "СведенияОПередаче.Операция.ЛицоОтветственноеЗаПередачу";
	
	ОписаниеФактаПередачи = ОбщиеПараметры.ДопДанныеДокумента.ОписаниеФактаПередачи;
	РеквизитыПередачи = ОписаниеФактаПередачи.РеквизитыПередачи;
	
	Если Не ОписаниеФактаПередачи.ПередачаСостоялась Тогда
		// Не удалось определить первичный документ передачи,
		// или в документе не указываются сведения о передаче,
		// или не указана дата передачи.
		Возврат;
	КонецЕсли;
	
	Если РеквизитыПередачи.ОтветственныйПередалТРУВид = 0 Тогда
		ИмяЭлемента = "РаботникПродавца";
		
		ПутьЭлемента = НачалоПути + "." + ИмяЭлемента;
		
		ОтветственныйПередалТРУ = РеквизитыПередачи.ОтветственныйПередалТРУ;
		
		ДанныеЛица = Новый Структура("Фамилия,Имя,Отчество,Должность");
		
		Если ЗначениеЗаполнено(ОтветственныйПередалТРУ) И ТипЗнч(ОтветственныйПередалТРУ) = Тип("СправочникСсылка.Сотрудники") Тогда
			ДанныеЛица.Вставить("СсылкаНаОбъект",	ОтветственныйПередалТРУ);
			ДанныеЛица.Вставить("Период",			РеквизитыПередачи.ДатаПередачиТРУ);
			
			Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеЛица, Истина);
			
			ДанныеЛица.Должность = Строка(ДанныеЛица.Должность);
			
		ИначеЕсли ЗначениеЗаполнено(ОтветственныйПередалТРУ) И ТипЗнч(ОтветственныйПередалТРУ) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
			ЗаполнитьЗначенияСвойств(ДанныеЛица, ФИОФЛ(ОтветственныйПередалТРУ, РеквизитыПередачи.ДатаПередачиТРУ));
			
			ДанныеЛица.Должность = "";
		КонецЕсли;
		
		ГруппаФИО = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД, ПутьЭлемента + ".ФИО");
		
		ЗаполнитьЗначенияСвойств(ГруппаФИО, ДанныеЛица, "Фамилия,Имя,Отчество");
		
		ЭлектронноеВзаимодействие.ЗагрузитьСтруктуруВГруппуДерева(ОбщиеПараметры.ДеревоЭД, ГруппаФИО, ПутьЭлемента + ".ФИО");
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ОбщиеПараметры.ДеревоЭД, ПутьЭлемента + ".Должность", ДанныеЛица.Должность);
		
		// Обработка ошибки через механизм сообщений пользователю.
		ДобавитьОписаниеОшибокЗаполнения_ЛицоОтветственноеЗаПередачуВид0УПД_5_03(ОбщиеПараметры, ПутьЭлемента);
		
	ИначеЕсли РеквизитыПередачи.ОтветственныйПередалТРУВид = 1 Тогда
		ИмяЭлемента = "ИноеЛицо";
		ИмяСубЭлемента = "ПредставительОрганизации";
		
		ПутьСубЭлемента = НачалоПути + "." + ИмяЭлемента + "." + ИмяСубЭлемента;
		
		КонтрагентПередавшегоЛица = РеквизитыПередачи.ОтветственныйПередалТРУКонтрагент;
		
		ДанныеКонтрагентаПредставителя = Новый Структура;
		ДанныеКонтрагентаПредставителя.Вставить("СсылкаНаОбъект", КонтрагентПередавшегоЛица);
		ДанныеКонтрагентаПредставителя.Вставить("Период", РеквизитыПередачи.ДатаПередачиТРУ);
		ДанныеКонтрагентаПредставителя.Вставить("ИНН");
		ДанныеКонтрагентаПредставителя.Вставить("КПП");
		ДанныеКонтрагентаПредставителя.Вставить("НаименованиеПолное");
		НаименованиеКонтрагентаСокращенное = КонтрагентПередавшегоЛица.НаименованиеСокращенное;
		
		Справочники.Контрагенты.ПолучитьДанныеКонтрагента(ДанныеКонтрагентаПредставителя);
		
		НаименованиеКонтрагентаПредставителя = ?(Значениезаполнено(НаименованиеКонтрагентаСокращенное), 
			НаименованиеКонтрагентаСокращенное,
			ДанныеКонтрагентаПредставителя.НаименованиеПолное);
		
		ДанныеФЛ = ФИОФЛ(РеквизитыПередачи.ОтветственныйПередалТРУ, РеквизитыПередачи.ДатаПередачиТРУ);
		
		ГруппаФИО = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД, ПутьСубЭлемента + ".ФИО");
		
		ГруппаФИО.Фамилия	= ДанныеФЛ.Фамилия;
		ГруппаФИО.Имя		= ДанныеФЛ.Имя;
		ГруппаФИО.Отчество	= ДанныеФЛ.Отчество;
		
		ГруппаПредставительОрганизации = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД, ПутьСубЭлемента);
		
		ГруппаПредставительОрганизации.Должность				= РеквизитыПередачи.ОтветственныйПередалТРУДолжность;
		ГруппаПредставительОрганизации.НаименованиеОрганизации	= НаименованиеКонтрагентаПредставителя;
		ГруппаПредставительОрганизации.ИНН						= ДанныеКонтрагентаПредставителя.ИНН;
		ГруппаПредставительОрганизации.ФИО						= ГруппаФИО;
		ГруппаПредставительОрганизации.ИныеСведения				= РеквизитыПередачи.ОтветственныйПередалТРУИныеСведения;
		
		// Доверенность.
		Если ЗначениеЗаполнено(РеквизитыПередачи.ОтветственныйПередалТРУДоверенность) Тогда
			ЗаполнитьОснованиеДоверияОтгрузкиУПД_5_03(
				ГруппаПредставительОрганизации.ОснованиеДоверияОтгрузки,
				ПутьСубЭлемента + ".ОснованиеДоверияОтгрузки",
				РеквизитыПередачи,
				ОбщиеПараметры);
		Иначе
			ГруппаПредставительОрганизации.Удалить("ОснованиеДоверияОтгрузки");
		КонецЕсли;
		
		// Основание полномочий.
		Если ЗначениеЗаполнено(РеквизитыПередачи.ОтветственныйПередалТРУДокументПолномочий) Тогда
			ЗаполнитьОснованиеПолномочийПредставителяУПД_5_03(
				ГруппаПредставительОрганизации.ОснованиеПолномочийПредставителя,
				ПутьСубЭлемента + ".ОснованиеПолномочийПредставителя",
				РеквизитыПередачи,
				ОбщиеПараметры);
		Иначе
			ГруппаПредставительОрганизации.Удалить("ОснованиеПолномочийПредставителя");
		КонецЕсли;
		
		// Обработка ошибки через механизм сообщений пользователю.
		ДобавитьОписаниеОшибокЗаполнения_ЛицоОтветственноеЗаПередачуВид1УПД_5_03(ОбщиеПараметры, ПутьСубЭлемента);
		
		ЭлектронноеВзаимодействие.ЗагрузитьСтруктуруВГруппуДерева(ОбщиеПараметры.ДеревоЭД, ГруппаПредставительОрганизации, ПутьСубЭлемента);
		
	ИначеЕсли РеквизитыПередачи.ОтветственныйПередалТРУВид = 2 Тогда
		ИмяЭлемента = "ИноеЛицо";
		ИмяСубЭлемента = "ФизическоеЛицо";
		
		ПутьСубЭлемента = НачалоПути + "." + ИмяЭлемента + "." + ИмяСубЭлемента;
		
		ОтветственныйПередалТРУ = РеквизитыПередачи.ОтветственныйПередалТРУ;
		
		ДанныеЛица = Новый Структура("Фамилия,Имя,Отчество,Должность,ИНН");
		
		Если ЗначениеЗаполнено(ОтветственныйПередалТРУ) И ТипЗнч(ОтветственныйПередалТРУ) = Тип("СправочникСсылка.Сотрудники") Тогда
			ДанныеЛица.Вставить("СсылкаНаОбъект",	ОтветственныйПередалТРУ);
			ДанныеЛица.Вставить("Период",			РеквизитыПередачи.ДатаПередачиТРУ);
			
			Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеЛица, Истина);
			
			ДанныеЛица.Должность = Строка(ДанныеЛица.Должность);
			
		ИначеЕсли ЗначениеЗаполнено(ОтветственныйПередалТРУ) И ТипЗнч(ОтветственныйПередалТРУ) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
			ЗаполнитьЗначенияСвойств(ДанныеЛица, ФИОФЛ(ОтветственныйПередалТРУ, РеквизитыПередачи.ДатаПередачиТРУ));
			
			ДанныеЛица.Должность = "";
		КонецЕсли;
		
		ГруппаФИО = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД, ПутьСубЭлемента + ".ФИО");
		
		ГруппаФИО.Фамилия	= ДанныеЛица.Фамилия;
		ГруппаФИО.Имя		= ДанныеЛица.Имя;
		ГруппаФИО.Отчество	= ДанныеЛица.Отчество;
		
		ГруппаФизическоеЛицо = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД, ПутьСубЭлемента);
		
		ГруппаФизическоеЛицо.ИНН			= ДанныеЛица.ИНН;
		ГруппаФизическоеЛицо.ФИО			= ГруппаФИО;
		ГруппаФизическоеЛицо.ИныеСведения	= РеквизитыПередачи.ОтветственныйПередалТРУИныеСведения;
		
		// Доверенность.
		Если ЗначениеЗаполнено(РеквизитыПередачи.ОтветственныйПередалТРУДоверенность) Тогда
			ЗаполнитьОснованиеДоверияОтгрузкиУПД_5_03(
				ГруппаФизическоеЛицо.ОснованиеДоверияОтгрузки,
				ПутьСубЭлемента + ".ОснованиеДоверияОтгрузки",
				РеквизитыПередачи,
				ОбщиеПараметры);
		Иначе
			ГруппаФизическоеЛицо.Удалить("ОснованиеДоверияОтгрузки");
		КонецЕсли;
		
		// Обработка ошибки через механизм сообщений пользователю.
		ДобавитьОписаниеОшибокЗаполнения_ЛицоОтветственноеЗаПередачуВид2УПД_5_03(ОбщиеПараметры, ПутьСубЭлемента);
		
		ЭлектронноеВзаимодействие.ЗагрузитьСтруктуруВГруппуДерева(ОбщиеПараметры.ДеревоЭД, ГруппаФизическоеЛицо, ПутьСубЭлемента);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьПервичныйДокументПередачиДляСчетаФактуры(ДокументСсылка)
	
	Если Не ЗначениеЗаполнено(ДокументСсылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "ДокументОснование,ДокументОснованиеЭДО");
		
		Если ЗначениеЗаполнено(ЗначенияРеквизитов.ДокументОснованиеЭДО) Тогда
			Возврат ЗначенияРеквизитов.ДокументОснованиеЭДО;
		ИначеЕсли ЗначениеЗаполнено(ЗначенияРеквизитов.ДокументОснование) Тогда
			Возврат ЗначенияРеквизитов.ДокументОснование;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный")
		Или ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.КорректировочныйСчетФактураВыданный") Тогда
		ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "ДокументКорректировки,ДокументОснование");
		
		Если ЗначениеЗаполнено(ЗначенияРеквизитов.ДокументКорректировки) Тогда
			Возврат ЗначенияРеквизитов.ДокументКорректировки;
		КонецЕсли;
		
		Возврат ПолучитьПервичныйДокументПередачиДляСчетаФактуры(ЗначенияРеквизитов.ДокументОснование);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

#Область ОписаниеОшибокЗаполнения

Процедура ДобавитьОписаниеОшибокЗаполнения_СтрокаТаблицыТоваровУПД_5_03(ОбщиеПараметры, ПутьЭлементаТаблицы, НоваяСтрока, Номенклатура)
	
	ОписаниеРеквизитовДокумента = ОбщиеПараметры.ДополнительныеПараметры.ОписанияРеквизитовДокументов.СсылкаНаОбъект;
	
	Если ТипЗнч(Номенклатура) = Тип("СправочникСсылка.Номенклатура") Или ТипЗнч(Номенклатура) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
		КлючДанных = Номенклатура;
		
		ПутьКДанным = "Объект.КодКаталога";
	Иначе
		КлючДанных = ОбщиеПараметры.СсылкаНаОбъект;
		
		ПутьКДанным = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ОписаниеРеквизитовДокумента.ПутьКТабЧастиНФА,
			ОбщиеПараметры.ДополнительныеПараметры.НомерСтроки, ОписаниеРеквизитовДокумента.ИменаКолонокТабЧастиНФА.НФА);
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ДобавитьВТаблицуОбработкуОшибкиЧерезСообщениеПользователю(НоваяСтрока,
		"КодКаталога", КлючДанных, ПутьКДанным);
	
КонецПроцедуры

Процедура ДобавитьОписаниеОшибокЗаполнения_ДатаОтгрузкиУПД_5_03(ОбщиеПараметры, ПутьЭлемента)
	
	ОписаниеФактаПередачи = ОбщиеПараметры.ДопДанныеДокумента.ОписаниеФактаПередачи;
	
	ПервичныйДокументПередачи = ОписаниеФактаПередачи.ПервичныйДокументПередачи;
	
	Если Не ПервичныйДокументПередачи.Найден Тогда
		ТекстСообщения = СтрШаблон(НСтр("ru='Не найден документ отгрузки с указанной датой передачи товара (%1)'"), ПутьЭлемента);
		
		ДокументСсылка = ОбщиеПараметры.СсылкаНаОбъект;
		ПутьКДанным = Неопределено;
		
	ИначеЕсли Не ПервичныйДокументПередачи.ЕстьРеквизитыДокументаДляЗаполненияОтветственногоЗаПередачу Тогда
		ТекстСообщения = СтрШаблон(НСтр("ru='В документе отгрузки %1 не предусмотрен реквизит для указания даты передачи товара (%2)'"),
			Строка(ПервичныйДокументПередачи.Ссылка), ПутьЭлемента);
			
		ДокументСсылка = ПервичныйДокументПередачи.Ссылка;
		ПутьКДанным = Неопределено;
		
	ИначеЕсли Не ОписаниеФактаПередачи.ПередачаСостоялась Тогда
		ТекстСообщения = СтрШаблон(НСтр("ru='В документе отгрузки %1 не заполнена дата передачи товара (%2)'"),
			Строка(ПервичныйДокументПередачи.Ссылка), ПутьЭлемента);
			
		ДокументСсылка = ПервичныйДокументПередачи.Ссылка;
		ПутьКДанным = "НадписьДопСведенияЭлектронногоУПД";
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ДобавитьВРеквизитОбработкуОшибки(ОбщиеПараметры.ДеревоЭД, ПутьЭлемента,
		ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(ДокументСсылка, ПутьКДанным,,,, ТекстСообщения));
	
КонецПроцедуры

Процедура ДобавитьОписаниеОшибокЗаполнения_ЛицоОтветственноеЗаПередачуВид0УПД_5_03(ОбщиеПараметры, ПутьЭлемента)
	
	ОписаниеФактаПередачи = ОбщиеПараметры.ДопДанныеДокумента.ОписаниеФактаПередачи;
	РеквизитыПередачи = ОписаниеФактаПередачи.РеквизитыПередачи;
	
	ДокументСсылка = ОбщиеПараметры.ДопДанныеДокумента.ОписаниеФактаПередачи.ПервичныйДокументПередачи.Ссылка;
	
	ИменаПолей = "Должность,Фамилия,Имя";
	
	ПутиКДанным = Новый Структура(ИменаПолей);
	ТекстыСообщений = Новый Структура(ИменаПолей);
	
	ОтветственныйПередалТРУ = РеквизитыПередачи.ОтветственныйПередалТРУ;
	
	Если ЗначениеЗаполнено(ОтветственныйПередалТРУ) Тогда
		КлючДанных = ОтветственныйПередалТРУ;
		
		ПутиКДанным.Должность = "ДанныеСотрудников.Должность";
		ПутиКДанным.Фамилия = "Объект.Наименование";
		ПутиКДанным.Имя = "Объект.Наименование";
		
		ТекстыСообщений.Должность = СтрШаблон(НСтр("ru='Не заполнена должность работника продавца (%1)'"), ПутьЭлемента);
		ТекстыСообщений.Фамилия = СтрШаблон(НСтр("ru='Не заполнена фамилия работника продавца (%1)'"), ПутьЭлемента);
		ТекстыСообщений.Имя = СтрШаблон(НСтр("ru='Не заполнено имя работника продавца (%1)'"), ПутьЭлемента);
	Иначе
		КлючДанных = ДокументСсылка;
		
		ПутиКДанным.Должность = "НадписьДопСведенияЭлектронногоУПД";
		ПутиКДанным.Фамилия = "НадписьДопСведенияЭлектронногоУПД";
		ПутиКДанным.Имя = "НадписьДопСведенияЭлектронногоУПД";
		
		ТекстСообщения = СтрШаблон(НСтр("ru='Не заполнено ответственное лицо продавца (%1)'"), ПутьЭлемента);
		
		ТекстыСообщений.Должность = ТекстСообщения;
		ТекстыСообщений.Фамилия = ТекстСообщения;
		ТекстыСообщений.Имя = ТекстСообщения;
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ДобавитьВРеквизитОбработкуОшибки(ОбщиеПараметры.ДеревоЭД, ПутьЭлемента + ".Должность",
		ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(КлючДанных, ПутиКДанным.Должность,,,, ТекстыСообщений.Должность));
		
	ЭлектронноеВзаимодействие.ДобавитьВРеквизитОбработкуОшибки(ОбщиеПараметры.ДеревоЭД, ПутьЭлемента + ".ФИО.Фамилия",
		ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(КлючДанных, ПутиКДанным.Фамилия,,,, ТекстыСообщений.Фамилия));
		
	ЭлектронноеВзаимодействие.ДобавитьВРеквизитОбработкуОшибки(ОбщиеПараметры.ДеревоЭД, ПутьЭлемента + ".ФИО.Имя",
		ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(КлючДанных, ПутиКДанным.Имя,,,, ТекстыСообщений.Имя));
		
КонецПроцедуры

Процедура ДобавитьОписаниеОшибокЗаполнения_ЛицоОтветственноеЗаПередачуВид1УПД_5_03(ОбщиеПараметры, ПутьСубЭлемента)
	
	КлючДанных = ОбщиеПараметры.ДопДанныеДокумента.ОписаниеФактаПередачи.ПервичныйДокументПередачи.Ссылка;
	
	ПутьКДанным = "НадписьДопСведенияЭлектронногоУПД";
	
	ЭлектронноеВзаимодействие.ДобавитьВРеквизитОбработкуОшибки(ОбщиеПараметры.ДеревоЭД, ПутьСубЭлемента + ".Должность",
		ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(КлючДанных, ПутьКДанным,,,,
			СтрШаблон(НСтр("ru='Не заполнена должность работника продавца (%1)'"), ПутьСубЭлемента)));
		
	ЭлектронноеВзаимодействие.ДобавитьВРеквизитОбработкуОшибки(ОбщиеПараметры.ДеревоЭД, ПутьСубЭлемента + ".ФИО.Фамилия",
		ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(КлючДанных, ПутьКДанным,,,,
			СтрШаблон(НСтр("ru='Не заполнена фамилия работника продавца (%1)'"), ПутьСубЭлемента)));
		
	ЭлектронноеВзаимодействие.ДобавитьВРеквизитОбработкуОшибки(ОбщиеПараметры.ДеревоЭД, ПутьСубЭлемента + ".ФИО.Имя",
		ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(КлючДанных, ПутьКДанным,,,,
			СтрШаблон(НСтр("ru='Не заполнено имя работника продавца (%1)'"), ПутьСубЭлемента)));
		
	ЭлектронноеВзаимодействие.ДобавитьВРеквизитОбработкуОшибки(ОбщиеПараметры.ДеревоЭД, ПутьСубЭлемента + ".НаименованиеОрганизации",
		ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(КлючДанных, ПутьКДанным,,,,
			СтрШаблон(НСтр("ru='Не заполнено организация представителя (%1)'"), ПутьСубЭлемента)));
	
КонецПроцедуры

Процедура ДобавитьОписаниеОшибокЗаполнения_ЛицоОтветственноеЗаПередачуВид2УПД_5_03(ОбщиеПараметры, ПутьСубЭлемента)
	
	КлючДанных = ОбщиеПараметры.ДопДанныеДокумента.ОписаниеФактаПередачи.ПервичныйДокументПередачи.Ссылка;
	
	ПутьКДанным = "НадписьДопСведенияЭлектронногоУПД";
	
	ЭлектронноеВзаимодействие.ДобавитьВРеквизитОбработкуОшибки(ОбщиеПараметры.ДеревоЭД, ПутьСубЭлемента + ".ФИО.Фамилия",
		ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(КлючДанных, ПутьКДанным,,,,
			СтрШаблон(НСтр("ru='Не заполнена фамилия работника продавца (%1)'"), ПутьСубЭлемента)));
		
	ЭлектронноеВзаимодействие.ДобавитьВРеквизитОбработкуОшибки(ОбщиеПараметры.ДеревоЭД, ПутьСубЭлемента + ".ФИО.Имя",
		ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(КлючДанных, ПутьКДанным,,,,
			СтрШаблон(НСтр("ru='Не заполнено имя работника продавца (%1)'"), ПутьСубЭлемента)));
	
КонецПроцедуры

#КонецОбласти



Процедура ЗаполнитьОснованиеДоверияОтгрузкиУПД_5_03(ОснованиеДоверияОтгрузки, ПутьЭлемента, РеквизитыПередачи, ОбщиеПараметры)
	
	Договор = РеквизитыПередачи.ОтветственныйПередалТРУДоверенность;
	
	СвойстваДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, "ВидОбязательства,НомерДоговора,ДатаДоговора");
	
	ОснованиеДоверияОтгрузки = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД, ПутьЭлемента);
	
	ОснованиеДоверияОтгрузки.НаименованиеДокумента	= СвойстваДоговора.ВидОбязательства;
	ОснованиеДоверияОтгрузки.НомерДокумента			= СвойстваДоговора.НомерДоговора;
	ОснованиеДоверияОтгрузки.ДатаДокумента			= СвойстваДоговора.ДатаДоговора;
	
	// Обработка ошибки через механизм сообщений пользователю.
	ТекстСообщения = СтрШаблон(НСтр("ru='Не заполнено наименование доверенности на отгрузку товаров (%1)'"), ПутьЭлемента);
	ЭлектронноеВзаимодействие.ДобавитьВРеквизитОбработкуОшибки(ОбщиеПараметры.ДеревоЭД, ПутьЭлемента + ".НаименованиеДокумента",
		ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(Договор, "Объект.ВидОбязательства",,,, ТекстСообщения));
	
	ТекстСообщения = СтрШаблон(НСтр("ru='Не заполнен номер доверенности на отгрузку товаров (%1)'"), ПутьЭлемента);
	ЭлектронноеВзаимодействие.ДобавитьВРеквизитОбработкуОшибки(ОбщиеПараметры.ДеревоЭД, ПутьЭлемента + ".НомерДокумента",
		ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(Договор, "Объект.НомерДоговора",,,, ТекстСообщения));
		
	ТекстСообщения = СтрШаблон(НСтр("ru='Не заполнена дата доверенности на отгрузку товаров (%1)'"), ПутьЭлемента);
	ЭлектронноеВзаимодействие.ДобавитьВРеквизитОбработкуОшибки(ОбщиеПараметры.ДеревоЭД, ПутьЭлемента + ".ДатаДокумента",
		ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(Договор, "Объект.ДатаДоговора",,,, ТекстСообщения));
	
КонецПроцедуры

Процедура ЗаполнитьОснованиеПолномочийПредставителяУПД_5_03(ОснованиеПолномочийПредставителя, ПутьЭлемента, РеквизитыПередачи, ОбщиеПараметры)
	
	Договор = РеквизитыПередачи.ОтветственныйПередалТРУДокументПолномочий;
	
	СвойстваДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Договор, "ВидОбязательства,НомерДоговора,ДатаДоговора");
	
	ОснованиеПолномочийПредставителя = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ОбщиеПараметры.ДеревоЭД, ПутьЭлемента);
	
	ОснованиеПолномочийПредставителя.НаименованиеДокумента	= СвойстваДоговора.ВидОбязательства;
	ОснованиеПолномочийПредставителя.НомерДокумента			= СвойстваДоговора.НомерДоговора;
	ОснованиеПолномочийПредставителя.ДатаДокумента			= СвойстваДоговора.ДатаДоговора;
	
	// Обработка ошибки через механизм сообщений пользователю.
	ТекстСообщения = СтрШаблон(НСтр("ru='Не заполнено наименование основания полномочий представителя организации на отгрузку товаров (%1)'"), ПутьЭлемента);
	
	ДокументСсылка = ОбщиеПараметры.ДопДанныеДокумента.ОписаниеФактаПередачи.ПервичныйДокументПередачи.Ссылка;
	
	ЭлектронноеВзаимодействие.ДобавитьВРеквизитОбработкуОшибки(ОбщиеПараметры.ДеревоЭД, ПутьЭлемента + ".НаименованиеДокумента",
		ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(ДокументСсылка, "НадписьДопСведенияЭлектронногоУПД",,,, ТекстСообщения));
		
КонецПроцедуры

