Функция ПолучитьСсылкуВалютыУПД_5_03(ДанныеЭД)
	
	Перем Валюта;
	
	НайтиСсылкуНаОбъект("Валюты", Валюта, ДанныеЭД.СведенияОСчетеФактуре.Валюта.Код);
	
	Если Валюта = Неопределено Тогда
		Валюта = Справочники.Валюты.ПустаяСсылка();
	КонецЕсли;
	
	Возврат Валюта;
	
КонецФункции

Функция ПолучитьСсылкиСторонСделкиУПД_5_03(Знач ДанныеЭД, СписокОшибок)
	
	СведенияОПродавцах			= ДанныеЭД.СведенияОСчетеФактуре.СведенияОПродавцах;
	СведенияОПокупателях		= ДанныеЭД.СведенияОСчетеФактуре.СведенияОПокупателях;
	СведенияОГрузоотправителях	= ДанныеЭД.СведенияОСчетеФактуре.СведенияОГрузоотправителях;
	СведенияОГрузополучателях	= ДанныеЭД.СведенияОСчетеФактуре.СведенияОГрузополучателях;
	
	Если СведенияОПродавцах.Количество() > 1 Тогда
		СписокОшибок.Добавить(НСтр("ru='загрузка сведений о нескольких продавцах не поддерживается.'"));
	КонецЕсли;
	
	Если СведенияОПокупателях.Количество() > 1 Тогда
		СписокОшибок.Добавить(НСтр("ru='загрузка сведений о нескольких покупателях не поддерживается.'"));
	КонецЕсли;
	
	Если СведенияОГрузоотправителях.Количество() > 1 Тогда
		СписокОшибок.Добавить(НСтр("ru='загрузка сведений о нескольких грузоотправителях не поддерживается.'"));
	КонецЕсли;
	
	Если СведенияОГрузополучателях.Количество() > 1 Тогда
		СписокОшибок.Добавить(НСтр("ru='загрузка сведений о нескольких грузополучателях не поддерживается.'"));
	КонецЕсли;
	
	СсылкиСторонСделки = Новый Структура("Организация,Контрагент,Грузоотправитель,Грузополучатель");
	
	Если СведенияОПродавцах.Количество() > 0 Тогда
		СсылкиСторонСделки.Контрагент = КонтрагентПоДаннымУчастника(СведенияОПродавцах[0].Продавец, Истина);
	КонецЕсли;
	
	Если СведенияОПокупателях.Количество() > 0 Тогда
		СсылкиСторонСделки.Организация = ОрганизацияПоДаннымУчастника(СведенияОПокупателях[0].Покупатель);
	КонецЕсли;
	
	Если СведенияОГрузоотправителях.Количество() > 0 Тогда
		// Грузоотправителя заполняем только если он отличается от продавца (контрагента).
		СведенияОГрузоотправителе = СведенияОГрузоотправителях[0];
		
		Если СведенияОГрузоотправителе.ОнЖе = Ложь Тогда
			Грузоотправитель = КонтрагентПоДаннымУчастника(СведенияОГрузоотправителе.Грузоотправитель);
			
			Если ЗначениеЗаполнено(Грузоотправитель)
				И ЗначениеЗаполнено(СсылкиСторонСделки.Контрагент)
				И Грузоотправитель <> СсылкиСторонСделки.Контрагент Тогда
				СсылкиСторонСделки.Грузоотправитель = Грузоотправитель;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если СведенияОГрузополучателях.Количество() > 0 Тогда
		// Грузополучателя заполняем только если он отличается от покупателя (организации).
		Грузополучатель = КонтрагентПоДаннымУчастника(СведенияОГрузополучателях[0].Грузополучатель);
		
		Если ЗначениеЗаполнено(Грузополучатель)
			И ЗначениеЗаполнено(СсылкиСторонСделки.Организация)
			И Грузополучатель <> СсылкиСторонСделки.Организация Тогда
			СсылкиСторонСделки.Грузополучатель = Грузополучатель;
		КонецЕсли;
	КонецЕсли;
	
	Возврат СсылкиСторонСделки;
	
КонецФункции

Функция ПолучитьСсылкуДоговораУПД_5_03(ДанныеЭД, Организация, Контрагент, ЭДПоставщика = Неопределено)
	
	Перем Договор;
	
	ОснованиеОтгрузкиПередачи = ДанныеЭД.СведенияОПередаче.Операция.ОснованиеОтгрузкиПередачи;
	
	Для Каждого СтрокаТаблицы Из ОснованиеОтгрузкиПередачи.ДокументыОснования Цикл
		НаименованиеДокумента	= СтрокаТаблицы.ДокументОснование.НаименованиеДокумента;
		НомерДокумента			= СтрокаТаблицы.ДокументОснование.НомерДокумента;
		ДатаДокумента			= СтрокаТаблицы.ДокументОснование.ДатаДокумента;
		
		Если ЗначениеЗаполнено(НомерДокумента) Тогда
			СвойстваДоговора = Новый Структура("НомерДоговора, ДатаДоговора, Владелец, Организация", НомерДокумента, ДатаДокумента, Контрагент, Организация);
			
			НайтиСсылкуНаОбъект("ДоговорыКонтрагентов", Договор, , СвойстваДоговора);
			
			Если ЗначениеЗаполнено(Договор) Тогда
				Возврат Договор;
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;
	
	//Если Не ЗначениеЗаполнено(Договор) Тогда
	//	Если ЗначениеЗаполнено(ДокументПоставкиПоИдентификаторуОснованияСчетаФактуры) Тогда
	//		РеквизитыДокументаОснования = "Договор";
	//		ЗначенияРеквизитовДокументаОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
	//			ДокументПоставкиПоИдентификаторуОснованияСчетаФактуры,
	//			РеквизитыДокументаОснования);
	//		Договор = ЗначенияРеквизитовДокументаОснования.Договор;
	//	КонецЕсли;
	//КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Договор) Тогда
		Договор = ДоговорПоНастройкеЭДО(Контрагент, Организация);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Договор) И ЭДПоставщика <> Неопределено Тогда
		Договор = ЭДПоставщика.Договор;
	КонецЕсли;
	
	Возврат Договор;
	
КонецФункции

Функция ПолучитьТаблицуОснованийСчетаФактурыУПД_5_03(Знач ДеревоДанных, ЭДПоставщика)
	
	ДокументыОснованияСчетаФактуры = ЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияСчетаФактуры");
	
	ИдентификаторДокументаОснования = "";
	ТаблицаОснований = Новый ТаблицаЗначений;
	ТаблицаОснований = Документы.СчетФактураПолученный.ПустаяСсылка().ДокументыОснования.ВыгрузитьКолонки();
	Если ЗначениеЗаполнено(ДокументыОснованияСчетаФактуры) Тогда
		Для Каждого ДокументОснования Из ДокументыОснованияСчетаФактуры Цикл
			Если ТипЗнч(ДокументОснования) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда
				ЭДПоставщика = ДокументОснования;
			Иначе	
				СтрокаТаблицы = ТаблицаОснований.Добавить();
				СтрокаТаблицы.ДокументОснование = ДокументОснования;
			КонецЕсли;	
			
		КонецЦикла;
	Иначе
		ДопТекстоваяИнформация = ДеревоДанных.Строки.Найти("ДопДанныеСчетаФактуры.ТекстоваяИнформация", "ПолныйПуть", Истина);
		Если ДопТекстоваяИнформация <> Неопределено Тогда
			Для Каждого СтрокаТекстовойИнформации Из ДопТекстоваяИнформация.Строки Цикл
				Если ЗначениеРеквизитаВДереве(СтрокаТекстовойИнформации, 
						"ДопДанныеСчетаФактуры.ТекстоваяИнформация.НомерСтроки.Идентификатор") = "ИдентификаторДокументаОснования" Тогда
					ИдентификаторДокументаОснования = ЗначениеРеквизитаВДереве(СтрокаТекстовойИнформации,
						"ДопДанныеСчетаФактуры.ТекстоваяИнформация.НомерСтроки.Значение", Ложь);
				КонецЕсли;
			КонецЦикла;	
		КонецЕсли;
	КонецЕсли;
	
	ДокументПоставкиПоИдентификаторуОснованияСчетаФактуры = "";
	Если ЗначениеЗаполнено(ИдентификаторДокументаОснования) Тогда
		ДокументПоставкиПоИдентификаторуОснованияСчетаФактуры = ДокументПоставкиПоИдентификаторуОснованияСчетаФактуры(ИдентификаторДокументаОснования);
		Если ЗначениеЗаполнено(ДокументПоставкиПоИдентификаторуОснованияСчетаФактуры) Тогда
			Если ТипЗнч(ДокументПоставкиПоИдентификаторуОснованияСчетаФактуры) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда
				Если НЕ ЗначениеЗаполнено(ЭДПоставщика) Тогда
					ЭДПоставщика = ДокументПоставкиПоИдентификаторуОснованияСчетаФактуры;
				КонецЕсли;	
			Иначе	
				СтрокаТаблицы = ТаблицаОснований.Добавить();
				СтрокаТаблицы.ДокументОснование = ДокументПоставкиПоИдентификаторуОснованияСчетаФактуры;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
	
	ТаблицаОснований.Свернуть("ДокументОснование");
	
	Возврат ТаблицаОснований;
	
КонецФункции

Процедура ДобавитьКомментарийПриНаличииОшибокУПД_5_03(Приемник, СписокОшибок)
	
	Если СписокОшибок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоОшибок = СписокОшибок.Количество();
	
	ТекстОшибок = СтрСоединить(СписокОшибок, ";");
	
	Если КоличествоОшибок = 1 Тогда
		ТекстШаблон = НСтр("ru='Ошибка загрузки электронного документа: %1'");
	Иначе
		ТекстШаблон = НСтр("ru='Ошибки загрузки электронного документа: %1'");
	КонецЕсли;
	
	Комментарий = СтрШаблон(ТекстШаблон, ТекстОшибок);
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Приемник, "Комментарий") Тогда
		Приемник.Комментарий = Комментарий;
		
	ИначеЕсли ТипЗнч(Приемник) = Тип("Структура") Тогда
		Приемник.Вставить("Комментарий", Комментарий);
	КонецЕсли;
	
КонецПроцедуры

Функция ТолькоУслугиПоСведениямОТоварахУПД_5_03(ДанныеЭД, Организация)
	
	Для Каждого СтрокаТаблицы Из ДанныеЭД.ТаблицаСчетаФактуры.СведенияОбОтгруженныхПозициях Цикл
		Если Не ПризнакУслуги(СтрокаТаблицы.Признак) Тогда
			Возврат Ложь;	
		КонецЕсли;	
	КонецЦикла;
	
	ТолькоУслуги = Истина;
	
	Если ЗначениеЗаполнено(Организация) Тогда
		ТолькоУслуги = НЕ ИспользоватьЭДПДляОтраженияВУчетеПоставкиУслугРабот(Организация);
	КонецЕсли;
	
	Возврат ТолькоУслуги;
	
КонецФункции

Функция ПредставлениеАдресногоЭлементаПоСоставляющим(ПервыйЭлемент = "", ВторойЭлемент = "", ТретийЭлемент = "")

	МассивСоставляющих = Новый Массив;
	Если ЗначениеЗаполнено(ПервыйЭлемент) Тогда
		МассивСоставляющих.Добавить(ПервыйЭлемент);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВторойЭлемент) Тогда
		МассивСоставляющих.Добавить(ВторойЭлемент);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТретийЭлемент) Тогда
		МассивСоставляющих.Добавить(ТретийЭлемент);
	КонецЕсли;
	
	Возврат СтрСоединить(МассивСоставляющих, " ");

КонецФункции

