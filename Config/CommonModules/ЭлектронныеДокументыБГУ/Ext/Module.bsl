Функция ПредставлениеСчетаУчетаИзвещения(КПС, КФО, СчетУчета, КЭК) Экспорт
	Результат = "";
	
	Если ЗначениеЗаполнено(СчетУчета) Тогда
		Результат = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1.%2.%3.%4'"),
			КПС, КФО, СчетУчета, КЭК);
			
		Если Лев(Результат, 1) = "." Тогда
			Результат = Сред(Результат, 2);		
		КонецЕсли;		
				
	КонецЕсли;
		
	Возврат Результат;
КонецФункции

Функция ПредставлениеПроводкиИзвещения(КФО, КПСДт, СчетУчетаДт, КЭКДт, КПСКт, СчетУчетаКт, КЭККт) Экспорт
	Результат = "";
	
	ПредставлениеСчетаДт = ПредставлениеСчетаУчетаИзвещения(КПСДт, КФО, СчетУчетаДт, КЭКДт);
	
	ПредставлениеСчетаКт = ПредставлениеСчетаУчетаИзвещения(КПСКт, КФО, СчетУчетаКт, КЭККт);
	
	Если ЗначениеЗаполнено(ПредставлениеСчетаДт) И ЗначениеЗаполнено(ПредставлениеСчетаКт) Тогда
		Результат = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Дт %1 - Кт %2'"),
				ПредставлениеСчетаДт, ПредставлениеСчетаКт);			
	ИначеЕсли ЗначениеЗаполнено(ПредставлениеСчетаДт) Тогда
		Результат = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Дт %1'"),
				ПредставлениеСчетаДт);			
	ИначеЕсли ЗначениеЗаполнено(ПредставлениеСчетаКт) Тогда
		Результат = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Кт %1'"),
				ПредставлениеСчетаКт);			
	КонецЕсли;
			
	Возврат Результат;
КонецФункции

Функция ПредставлениеПроводкиИзвещенияДляСтроки(ТекСтрока) Экспорт
	
	Результат = ПредставлениеПроводкиИзвещения(ТекСтрока.КФО, ТекСтрока.КПСДт, ТекСтрока.СчетДт, ТекСтрока.КЭКДт,
		ТекСтрока.КПСКт, ТекСтрока.СчетКт, ТекСтрока.КЭККт);
	
	Возврат Результат;
КонецФункции
	
