Процедура ЗаполнитьЗакупкаДляГосударственныхНуждУПД_5_03(ДеревоДанных, Выборка, Отказ)
	
	ДатаСведений = Выборка.Дата;
	ДоговорКонтрагента = Выборка.Договор;
	ОрганизацияПокупатель = Выборка.Организация;
	
	НомерБюджетногоОбязательстваПокупателя = РаботаСОбязательствами.ПолучитьУчетныйНомерОбязательства(ДоговорКонтрагента);
	НеЗаполнятьСведенияУПДОЗакупкеДляГосНужд = НеЗаполнятьСведенияУПДОЗакупкеДляГосНужд(ОрганизацияПокупатель);
	
	Если Не ЗначениеЗаполнено(НомерБюджетногоОбязательстваПокупателя) Или НеЗаполнятьСведенияУПДОЗакупкеДляГосНужд = Истина Тогда
		Возврат;
	КонецЕсли;
	
	НаименованиеИКЗ =  ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.ИКЗ.Наименование;
	КодЗакупки = РаботаСОбязательствами.ЗначениеХарактеристикиОбязательства(ДоговорКонтрагента, КонецДня(ДатаСведений), НаименованиеИКЗ);
	
	СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОрганизацияПокупатель, "Бюджет, КодОКТМО, КодПоРПБС");
	НомерРеестровойЗаписиПокупателя = СтруктураДанных.КодПоРПБС;
	КодОКТМОПокупателя = СтруктураДанных.КодОКТМО;
	Если ЗначениеЗаполнено(Выборка.ГосЗакупкаКодОКТМОПокупателя) Тогда
		КодОКТМОПокупателя = Выборка.ГосЗакупкаКодОКТМОПокупателя;
	КонецЕсли;
	Если ЗначениеЗаполнено(Выборка.ОрганизацияППП) Тогда
		КодППП = Выборка.ОрганизацияППП.Код;
	Иначе
		КодППП = "";
	КонецЕсли;
	
	Бюджет = СтруктураДанных.Бюджет;
	
	СтруктураДанныхБюджет = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Бюджет, "НаименованиеФинансовогоОргана");
	НаименованиеФинансовогоОрганаПокупателя = СтруктураДанныхБюджет.НаименованиеФинансовогоОргана;
	
	РеквизитыЛицевогоСчета = Выборка.ГосЗакупкаРеквизитыЛицевогоСчетаПокупателя;
	
	Если ЗначениеЗаполнено(РеквизитыЛицевогоСчета) Тогда
		СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыЛицевогоСчета, "КассовыйОрган, Владелец");
		Казначейство = СтруктураДанных.КассовыйОрган;
		СтруктураДанныхКазначейства = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Казначейство, "НаименованиеПолное, Код");
		ЛицевойСчет = СтруктураДанных.Владелец;
		СтруктураДанныхЛицевогоСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЛицевойСчет, "КодПоРПБС, Код, ИспользоватьДляСчетаУчетныйНомер");
		НомерЛицевогоСчетаПокупателя = СтруктураДанныхЛицевогоСчета.Код;
		КодПоРПБСЛицевогоСчета = СтруктураДанныхЛицевогоСчета.КодПоРПБС;
		ИспользоватьДляСчетаУчетныйНомер = СтруктураДанныхЛицевогоСчета.ИспользоватьДляСчетаУчетныйНомер;
		Если ИспользоватьДляСчетаУчетныйНомер И ЗначениеЗаполнено(КодПоРПБСЛицевогоСчета) Тогда
			НомерРеестровойЗаписиПокупателя = КодПоРПБСЛицевогоСчета;
		КонецЕсли;	
		
		КазначействоПокупателяКод = СтруктураДанныхКазначейства.Код;
		КазначействоПокупателяНаименование = СтруктураДанныхКазначейства.НаименованиеПолное;
	Иначе
		Отказ = Истина;
		
		ТекстСообщения  = НСтр("ru='В документе %ДокументПоставщика% на закладке ""Закупка для государственных нужд"" не указаны необходимы данные (Реквизиты лицевого счета) для организации-покупателя!'");
		ТекстСообщения  = СтрЗаменить(ТекстСообщения,"%ДокументПоставщика%", Выборка.Ссылка);
		Сообщение       = Новый СообщениеПользователю();
		Сообщение.Текст = ТекстСообщения;
		Сообщение.Сообщить();
		
		Возврат
	КонецЕсли;
	
	ГосЗакупка = Новый Структура;
	ГосЗакупка.Вставить("КодЗакупки", КодЗакупки);
	ГосЗакупка.Вставить("НомерЛицевогоСчетаПокупателя", СокрЛП(НомерЛицевогоСчетаПокупателя));
	ГосЗакупка.Вставить("НаименованиеФинансовогоОрганаПокупателя", НаименованиеФинансовогоОрганаПокупателя);
	ГосЗакупка.Вставить("НомерРеестровойЗаписиПокупателя", НомерРеестровойЗаписиПокупателя);
	ГосЗакупка.Вставить("НомерБюджетногоОбязательстваПокупателя", НомерБюджетногоОбязательстваПокупателя);
	ГосЗакупка.Вставить("КазначействоПокупателяКод", СокрЛП(КазначействоПокупателяКод));
	ГосЗакупка.Вставить("КазначействоПокупателяНаименование", КазначействоПокупателяНаименование);
	ГосЗакупка.Вставить("ОКТМОПокупателя", КодОКТМОПокупателя);
	ГосЗакупка.Вставить("ОКТМОМестаПоставки", Выборка.ГосЗакупкаКодОКТМОМестаПоставки);
	ГосЗакупка.Вставить("ПредельнаяДатаОплаты", Выборка.ГосЗакупкаПредельнаяДатаОплаты);
	ГосЗакупка.Вставить("НомерДенежногоОбязательства", Выборка.ГосЗакупкаНомерДенежногоОбязательства);
	ГосЗакупка.Вставить("ОчередностьПлатежа", Строка(Выборка.ГосЗакупкаОчередностьПлатежа));
	ГосЗакупка.Вставить("ВидПлатежа", Выборка.ГосЗакупкаВидПлатежа);
	Путь = "ЗакупкаДляГосударственныхНужд.";
	ГосЗакупкаЗаполнена = Ложь;
	Для Каждого КлючЗначение Из ГосЗакупка Цикл
		Если ЗначениеЗаполнено(КлючЗначение.Значение) Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, Путь + КлючЗначение.Ключ, КлючЗначение.Значение);
			ГосЗакупкаЗаполнена = Истина;
		КонецЕсли;
	КонецЦикла;
	
	ДенежныеОбязательства = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ДеревоДанных, Путь + "ДенежныеОбязательства");
	
	Для Каждого ВыборкаОбязательств Из Выборка.ГосЗакупкиДенежныеОбязательства Цикл
		СтрокаОбязательства = ДенежныеОбязательства.Добавить();
		СтрокаОбязательства.НомерСтрокиИнформацииПродавца = ВыборкаОбязательств.НомерСтроки;
		
		ОбъектФАИП = ВыборкаОбязательств.ОбъектФАИП;
		ДанныеОбъектаФАИП = ДанныеОбъектаФАИП(ОбъектФАИП);
		КодОбъектаФАИП = ДанныеОбъектаФАИП.КодФАИП;
		
		СтрокаОбязательства.КодОбъектаФАИП = КодОбъектаФАИП;
		
		СтруктураДанныхИсточник = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВыборкаОбязательств.ИсточникСредств, "Код");
		КодИсточникаСредствГосЗакупок = СтруктураДанныхИсточник.Код;
		
		СтруктураДанныхКПС = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВыборкаОбязательств.КПС, "Код");
		КодБюджетнойКлассификации = СокрЛП(СтруктураДанныхКПС.Код);
		
		СтруктураДанныхЦели = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВыборкаОбязательств.КодЦели, "Код");
		КодЦели = СокрЛП(СтруктураДанныхЦели.Код);
		
		СтрокаОбязательства.ВидСредств = КодИсточникаСредствГосЗакупок(КодИсточникаСредствГосЗакупок);
		СтрокаОбязательства.КодБюджетнойКлассификации = КодППП+КодБюджетнойКлассификации;
		СтрокаОбязательства.КодЦели = КодЦели;
		СтрокаОбязательства.СуммаАванса = ВыборкаОбязательств.СуммаАванса;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ДенежныеОбязательства) Тогда
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ДенежныеОбязательства, Путь + "ДенежныеОбязательства");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область НайтиСоздать

Процедура НайтиСоздатьДокументОПередачеУПД_5_03(ДеревоДанных, СсылкаНаВладельца = Неопределено, Записывать =Истина, СпособОбработки = "", ОписаниеОшибки = "", ВидПервичногоДокумента = "")
	
	ДанныеЭД = ДанныеВходящегоЭД(ДеревоДанных);
	
	СписокОшибок = Новый Массив();
	
	СсылкиСторонСделки = ПолучитьСсылкиСторонСделкиУПД_5_03(ДанныеЭД, СписокОшибок);
	
	ТолькоУслуги = ТолькоУслугиПоСведениямОТоварахУПД_5_03(ДанныеЭД, СсылкиСторонСделки.Организация);
	ДокументИзЕИС = ЭлектронныйДокументИзЕИС(ДеревоДанных);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ДанныеЭД", ДанныеЭД);
	ДополнительныеПараметры.Вставить("СсылкиСторонСделки", СсылкиСторонСделки);
	ДополнительныеПараметры.Вставить("СписокОшибок", СписокОшибок);
	ДополнительныеПараметры.Вставить("ТолькоУслуги", ТолькоУслуги);
	ДополнительныеПараметры.Вставить("ДокументИзЕИС", ДокументИзЕИС);
	
	Если ТолькоУслуги И НЕ ДокументИзЕИС Тогда
		НайтиСоздатьДокументОПередачеУслугРаботУПД_5_03(ДеревоДанных, СсылкаНаВладельца, Записывать, ВидПервичногоДокумента, ДополнительныеПараметры);	
	Иначе
		НайтиСоздатьДокументОПередачеТоваровУПД_5_03(ДеревоДанных, СсылкаНаВладельца, Записывать, ВидПервичногоДокумента, ДополнительныеПараметры);
	КонецЕсли;	
	
КонецПроцедуры

Процедура НайтиСоздатьДокументОПередачеУслугРаботУПД_5_03(ДеревоДанных, СсылкаНаВладельца = Неопределено, Записывать = Истина, ВидПервичногоДокумента = "", ДополнительныеПараметры)
	
	ДанныеЭД = ДополнительныеПараметры.ДанныеЭД;
	СсылкиСторонСделки = ДополнительныеПараметры.СсылкиСторонСделки;
	
	РежимЗаписи = РежимЗаписиДокумента.Запись;
	Попытка
		Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
			ДокументОбъект = СсылкаНаВладельца.ПолучитьОбъект();
			Если ДокументОбъект.Проведен Тогда
				Текст = НСтр("ru = 'Операция возможна только для непроведенных документов!'");
			КонецЕсли;
		Иначе
			УстановитьПривилегированныйРежим(Истина);
			ДокументОбъект = Документы.ПоступлениеУслугРабот.СоздатьДокумент();
			ДокументОбъект.Дата = ТекущаяДатаСеанса();
		КонецЕсли;
		ДокументОбъект.ОбменДанными.Загрузка = Истина;
		
		Если НЕ ТипЗнч(ДокументОбъект.Ссылка) = Тип("ДокументСсылка.ПоступлениеУслугРабот") Тогда
			Возврат;
		КонецЕсли;	
		
		ДокументОбъект.ВалютаДокумента = ПолучитьСсылкуВалютыУПД_5_03(ДанныеЭД);
		
		//*** ???
		//ДопТекстоваяИнформация = ДеревоДанных.Строки.Найти("ДопДанныеДокументаОтгрузки.ТекстоваяИнформация", "ПолныйПуть", Истина);
		//Если ДопТекстоваяИнформация <> Неопределено Тогда
		//	Для Каждого СтрокаТекстовойИнформации Из ДопТекстоваяИнформация.Строки Цикл
		//		Если ЗначениеРеквизитаВДереве(СтрокаТекстовойИнформации, 
		//				"ДопДанныеДокументаОтгрузки.ТекстоваяИнформация.НомерСтроки.Идентификатор") = "ИдентификаторДокументаОснования" Тогда
		//			ИдентификаторДокументаОснованияЭДО = ЗначениеРеквизитаВДереве(СтрокаТекстовойИнформации,
		//				"ДопДанныеДокументаОтгрузки.ТекстоваяИнформация.НомерСтроки.Значение", Ложь);
		//			Если ЗначениеЗаполнено(ИдентификаторДокументаОснованияЭДО) Тогда
		//				ДокументОбъект.ИдентификаторДокументаОснованияЭДО = ИдентификаторДокументаОснованияЭДО;
		//			КонецЕсли;
		//		КонецЕсли;
		//	КонецЦикла;	
		//КонецЕсли;
		
		// Сведения о поставщике.
		
		Организация = СсылкиСторонСделки.Организация;
		Контрагент = СсылкиСторонСделки.Контрагент;
		
		ДобавитьКомментарийПриНаличииОшибокУПД_5_03(ДокументОбъект, ДополнительныеПараметры.СписокОшибок);
		
		ДокументОбъект.Контрагент = Контрагент;
		ДокументОбъект.Организация = Организация;
		
		Договор = ПолучитьСсылкуДоговораУПД_5_03(ДанныеЭД, Организация, Контрагент);
		
		ДокументОбъект.Договор = Договор;
		
		ДокументОбъект.СпособЗачетаАванса = Перечисления.СпособыЗачетаАвансов.Автоматически;
		
		Если ВидПервичногоДокумента = "" Тогда
			ДокументОбъект.ВидПервичногоДокумента = "Акт об оказании услуг";
		Иначе	
			ДокументОбъект.ВидПервичногоДокумента = "Универсальный передаточный документ";
		КонецЕсли;
		ДокументОбъект.НомерПервичногоДокумента = ДанныеЭД.СведенияОСчетеФактуре.НомерДокумента;
		ДокументОбъект.ДатаПервичногоДокумента = ДанныеЭД.СведенияОСчетеФактуре.ДатаДокумента;
		
		Если ДанныеЭД.Свойство("СведенияОПередаче")
				И ДокументОбъект.ВидПервичногоДокумента = "Универсальный передаточный документ" 
				И ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ЭлектронныйДокументПоставщика") Тогда
			СведенияОПередачеЭД = ДанныеЭД.СведенияОПередаче; 
			Если СведенияОПередачеЭД.Свойство("Операция") 
					И СведенияОПередачеЭД.Операция.Свойство("ДатаОтгрузки") Тогда
				ДокументОбъект.ДатаОтгрузки = СведенияОПередачеЭД.Операция.ДатаОтгрузки;   
			КонецЕсли;
		КонецЕсли;
		
		ДокументОбъект.УслугиИРаботы.Очистить();
		ДокументОбъект.ЗачетАвансов.Очистить();
			
		// Сведения таблицы.
		СведенияОТоварах = ДанныеЭД.ТаблицаСчетаФактуры.СведенияОбОтгруженныхПозициях;
		
		Для Каждого Товар Из СведенияОТоварах Цикл
			НоваяСтрока = ДокументОбъект.УслугиИРаботы.Добавить();
			
			// Обязательные реквизиты:
			СтавкаНДС = Товар.НалоговаяСтавка;
			
			Если СтавкаНДС = "НДС исчисляется налоговым агентом" Тогда
				СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;	
			КонецЕсли;	
			
			НоваяСтрока.СтавкаНДС = СтавкаНДС;
			НоваяСтрока.СуммаНДС = Товар.СуммаНалога.Сумма;
			НоваяСтрока.Всего = Товар.СтоимостьСНалогом;
				
			// Необязательные реквизиты:
			НайтиСсылкуНаОбъект("ЕдиницыИзмерения", НоваяСтрока.ЕдиницаИзмерения, Товар.ЕдиницаИзмеренияКод);
			НоваяСтрока.Количество = Товар.Количество;
			НоваяСтрока.Сумма = Товар.СтоимостьБезНалога;
			
			Сопоставление = Товар.Сопоставление;
			
			Если Сопоставление <> Неопределено Тогда
				Если ЗначениеЗаполнено(Сопоставление.Идентификатор) Тогда
					НоваяСтрока.ИдентификаторПоставщика = Сопоставление.Идентификатор;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(Сопоставление.НоменклатураИБ) Тогда
					НоваяСтрока.Номенклатура = Сопоставление.НоменклатураИБ;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(Сопоставление.УпаковкаИБ) Тогда
					НоваяСтрока.ЕдиницаИзмерения = Сопоставление.УпаковкаИБ;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		ДокументОбъект.СуммаДокумента = ДанныеЭД.ТаблицаСчетаФактуры.ВсегоКОплате.СтоимостьСНалогом;
		
		ДокументОбъект.ДополнительныеСвойства.Вставить("ЕстьСоглашение", Истина);
		ДокументОбъект.ДополнительныеСвойства.Вставить("ПроцессыОбработкиДокументов_ЗаписатьБезПроверкиОбменДаннымиЗагрузка", Истина);
		Если Записывать Тогда
			Если НЕ ЗначениеЗаполнено(ДокументОбъект.Номер) Тогда
				ДокументОбъект.УстановитьНовыйНомер();
			КонецЕсли;
			ДокументОбъект.Записать(РежимЗаписи);
			СсылкаНаВладельца = ДокументОбъект.Ссылка;
		Иначе // если функция вызвана из формы "Обработки.ОбменСКонтрагентами.ФормаЗагрузкиПросмотраЭД"
			СсылкаНаВладельца = ДокументОбъект;
		КонецЕсли;
		
	Исключение
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Заполнение документа на основе ЭД. %1'"), Текст)
			+ Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ВыполнитьЗаписьСобытияПоЭДВЖурналРегистрации(ТекстСообщения,
			2, УровеньЖурналаРегистрации.Ошибка, ДокументОбъект.Метаданные(), СсылкаНаВладельца);
		ВызватьИсключение(Текст);
	КонецПопытки;
	
КонецПроцедуры

Процедура НайтиСоздатьДокументОПередачеТоваровУПД_5_03(ДеревоДанных, СсылкаНаВладельца = Неопределено, Записывать = Истина, ВидПервичногоДокумента = "", ДополнительныеПараметры)
	
	ДанныеЭД = ДополнительныеПараметры.ДанныеЭД;
	СсылкиСторонСделки = ДополнительныеПараметры.СсылкиСторонСделки;
	СписокОшибок = ДополнительныеПараметры.СписокОшибок;
	ТолькоУслуги = ДополнительныеПараметры.ТолькоУслуги;
	ДокументИзЕИС = ДополнительныеПараметры.ДокументИзЕИС;
	
	РежимЗаписи = РежимЗаписиДокумента.Запись;
	Попытка
		Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
			ДокументОбъект = СсылкаНаВладельца.ПолучитьОбъект();
			Если ДокументОбъект.Проведен Тогда
				Текст = НСтр("ru = 'Операция возможна только для непроведенных документов!'");
			КонецЕсли;
		Иначе
			УстановитьПривилегированныйРежим(Истина);
			ДокументОбъект = Документы.ЭлектронныйДокументПоставщика.СоздатьДокумент();
			ДокументОбъект.Дата = ТекущаяДатаСеанса();
		КонецЕсли;
		ДокументОбъект.ОбменДанными.Загрузка = Истина;
		
		ДокументОбъект.ЗагруженИзЕИС = ДокументИзЕИС;
		Если ДокументИзЕИС Тогда
			Если АктОПриемкеВыполненныхРаботИзЕИС(ДеревоДанных)	Тогда
				ВидПервичногоДокумента = НСтр("ru = 'Акт о приемке выполненных работ'");
			КонецЕсли;	
		КонецЕсли;	
		
		ТаблицаИдентификаторовНоменклатурыЕИС = Новый ТаблицаЗначений;
		Если ДокументИзЕИС Тогда
			ДанныеПриложенияЕИС = ЗначениеРеквизитаВДереве(ДеревоДанных, "ДанныеЭлектронногоАктированияЕИС.ДанныеПриложения", Ложь);
			Если ТипЗнч(ДанныеПриложенияЕИС) = Тип("Структура") Тогда
				ТаблицаИдентификаторовНоменклатурыЕИС = ДанныеПриложенияЕИС.ТаблицаИдентификаторовНоменклатуры;
			КонецЕсли;
		КонецЕсли;	
		
		ДокументОбъект.ВалютаДокумента = ПолучитьСсылкуВалютыУПД_5_03(ДанныеЭД);
		
		ДокументОбъект.ТипФорматаЭД = 0;		
		
		ДопТекстоваяИнформация = ДеревоДанных.Строки.Найти("ДопДанныеДокументаОтгрузки.ТекстоваяИнформация", "ПолныйПуть", Истина);
		Если ДопТекстоваяИнформация <> Неопределено Тогда
			Для Каждого СтрокаТекстовойИнформации Из ДопТекстоваяИнформация.Строки Цикл
				Если ЗначениеРеквизитаВДереве(СтрокаТекстовойИнформации, 
						"ДопДанныеДокументаОтгрузки.ТекстоваяИнформация.НомерСтроки.Идентификатор") = "ИдентификаторДокументаОснования" Тогда
					ИдентификаторДокументаОснованияЭДО = ЗначениеРеквизитаВДереве(СтрокаТекстовойИнформации,
						"ДопДанныеДокументаОтгрузки.ТекстоваяИнформация.НомерСтроки.Значение");
					Если ЗначениеЗаполнено(ИдентификаторДокументаОснованияЭДО) Тогда
						ДокументОбъект.ИдентификаторДокументаОснованияЭДО = ИдентификаторДокументаОснованияЭДО;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;	
		КонецЕсли;
		
		// Сведения о поставщике.
		
		Организация = СсылкиСторонСделки.Организация;
		Контрагент = СсылкиСторонСделки.Контрагент;
		Грузополучатель = СсылкиСторонСделки.Грузополучатель;
		
		ДобавитьКомментарийПриНаличииОшибокУПД_5_03(ДокументОбъект, ДополнительныеПараметры.СписокОшибок);
		
		ДокументОбъект.Организация = Организация;
		ДокументОбъект.Контрагент = Контрагент;
		ДокументОбъект.Грузополучатель = Грузополучатель;
		
		ДокументОбъект.Договор = ПолучитьСсылкуДоговораУПД_5_03(ДанныеЭД, Организация, Контрагент);;
		
		Если ЗначениеЗаполнено(ВидПервичногоДокумента) Тогда
			ДокументОбъект.ВидПервичногоДокумента = ВидПервичногоДокумента;
		Иначе	
			ДокументОбъект.ВидПервичногоДокумента = "Универсальный передаточный документ";
		КонецЕсли;
		ДокументОбъект.НомерПервичногоДокумента = ДанныеЭД.СведенияОСчетеФактуре.НомерДокумента;
		ДокументОбъект.ДатаПервичногоДокумента = ДанныеЭД.СведенияОСчетеФактуре.ДатаДокумента;
		
		Если ДанныеЭД.Свойство("СведенияОПередаче")
				И ДокументОбъект.ВидПервичногоДокумента = "Универсальный передаточный документ" 
				И ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ЭлектронныйДокументПоставщика") Тогда
			СведенияОПередачеЭД = ДанныеЭД.СведенияОПередаче;   
			Если СведенияОПередачеЭД.Свойство("Операция") 
					И СведенияОПередачеЭД.Операция.Свойство("ДатаОтгрузки") Тогда
				ДокументОбъект.ДатаОтгрузки = СведенияОПередачеЭД.Операция.ДатаОтгрузки;   
			КонецЕсли;
		КонецЕсли;
		
		ДокументОбъект.СписокНоменклатуры.Очистить();
		ДокументОбъект.СведенияПрослеживаемости.Очистить();
		ДокументОбъект.КодыУпаковокМаркируемойПродукции.Очистить();
		
		// Сведения таблицы.
		СведенияОТоварах = ДанныеЭД.ТаблицаСчетаФактуры.СведенияОбОтгруженныхПозициях;
		
		НомерПоПорядку = 0;
		
		Для Каждого Товар Из СведенияОТоварах Цикл
			НомерПоПорядку = НомерПоПорядку + 1;
			
			ЭтоВозвратнаяТара = Ложь;
			Признак = Товар.Признак;
			ПризнакДополнительнаяИнформация = Товар.ИнформацияОПризнаке;
			
			Если Признак = "3" Тогда
				//услуги (признак БП)
				НоваяСтрока = ДокументОбъект.СписокНоменклатуры.Добавить();
				НоваяСтрока.ПризнакНоменклатуры = Признак;
			ИначеЕсли Признак = "4" Тогда
				//ПО (признак БП)
				НоваяСтрока = ДокументОбъект.СписокНоменклатуры.Добавить();
				НоваяСтрока.ПризнакНоменклатуры = Признак;
			ИначеЕсли (Признак = "1" И ПризнакДополнительнаяИнформация = "ВТ") Тогда
				//Возвратная тара 
				ЭтоВозвратнаяТара = Истина;
				НоваяСтрока = ДокументОбъект.СписокНоменклатуры.Добавить();
				НоваяСтрока.ПризнакНоменклатуры = "1ВТ";
			Иначе
				НоваяСтрока = ДокументОбъект.СписокНоменклатуры.Добавить();
				НоваяСтрока.ПризнакНоменклатуры = Признак;
			КонецЕсли;
			
			// Обязательные реквизиты:
			СтавкаНДС = Товар.НалоговаяСтавка;
			
			Если СтавкаНДС = "НДС исчисляется налоговым агентом" Тогда
				СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;	
			КонецЕсли;	
			
			НоваяСтрока.СтавкаНДС = СтавкаНДС;
			НоваяСтрока.СуммаНДС = Товар.СуммаНалога.Сумма;
			НоваяСтрока.Всего = Товар.СтоимостьСНалогом;
			
			// Необязательные реквизиты:
			ЕдиницаИзмеренияКод = Товар.ЕдиницаИзмеренияКод;
			НайтиСсылкуНаОбъект("ЕдиницыИзмерения", НоваяСтрока.ЕдиницаИзмерения, ЕдиницаИзмеренияКод);
			НоваяСтрока.ЕдиницаИзмеренияКод = ЕдиницаИзмеренияКод;
			
			НоваяСтрока.Количество = Товар.Количество;
			НоваяСтрока.Сумма = Товар.СтоимостьБезНалога;
			
			Если (НоваяСтрока.Количество = 0) ИЛИ (НоваяСтрока.Количество = Неопределено) Тогда
				НоваяСтрока.Количество = 1;
				Если (НоваяСтрока.Цена = 0) ИЛИ (НоваяСтрока.Цена = Неопределено) Тогда
					НоваяСтрока.Цена = НоваяСтрока.Сумма;
				КонецЕсли;	
			Иначе	
				НоваяСтрока.Цена = НоваяСтрока.Сумма/НоваяСтрока.Количество;
			КонецЕсли;
			
			ЭлектронныеДокументыБГУКлиентСервер.ЗаполнитьИдентификаторСтроки(НоваяСтрока);
			ЗаполнитьКодыМаркировкиИзДереваЭлектронногоДокументаУПД_5_03(ДокументОбъект, НоваяСтрока, Товар);
			ЗаполнитьНомераПрослеживаемостиИзДереваЭлектронногоДокументаУПД_5_03(ДокументОбъект, НоваяСтрока, Товар);
			
			НоваяСтрока.КодВидаТовара = Товар.КодВидаТовара;
			
			Для Каждого СтрокаСтраны Из Товар.СтраныПроисхождения Цикл
				СтранаПроисхождения = Справочники.СтраныМира.НайтиПоНаименованию(СтрокаСтраны.СтранаПроисхождения);
				
				Если ЗначениеЗаполнено(СтранаПроисхождения) Тогда
					НоваяСтрока.СтранаПроисхождения = СтранаПроисхождения;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			// Сопоставление
			Сопоставление = Товар.Сопоставление;
			
			Если Сопоставление <> Неопределено Тогда
				Если ЗначениеЗаполнено(Сопоставление.Идентификатор) Тогда
					НоваяСтрока.ИдентификаторПоставщика = Сопоставление.Идентификатор;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(Сопоставление.НоменклатураИБ) Тогда
					НоваяСтрока.Номенклатура = Сопоставление.НоменклатураИБ;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(Сопоставление.УпаковкаИБ) Тогда
					НоваяСтрока.ЕдиницаИзмерения = Сопоставление.УпаковкаИБ;
				КонецЕсли;
			КонецЕсли;
			
			Если ДокументИзЕИС Тогда
				Если НЕ ТаблицаИдентификаторовНоменклатурыЕИС = Неопределено Тогда
					ПараметрыОтбора = Новый Структура;
					ПараметрыОтбора.Вставить("НомерСтроки", НомерПоПорядку);
					
					НайденныеСтроки = ТаблицаИдентификаторовНоменклатурыЕИС.НайтиСтроки(ПараметрыОтбора);
					Если НайденныеСтроки.Количество()>0 Тогда
						НоваяСтрока.ИдентификаторНоменклатурыЕИС = НайденныеСтроки[0].Идентификатор;
						НоваяСтрока.ВнешнийИдентификаторЕИС = НайденныеСтроки[0].ВнешнийИдентификатор;
						НоваяСтрока.ТехническийИдентификаторЕИС = Формат(НайденныеСтроки[0].ТехническийИдентификатор,"ЧГ=");
					КонецЕсли;	
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		ДокументОбъект.СуммаДокумента = ДанныеЭД.ТаблицаСчетаФактуры.ВсегоКОплате.СтоимостьСНалогом;

		ДокументОбъект.СведенияОВыбытииМаркированныхТоваров = ДанныеЭД.СведенияОВыбытииМаркированныхТоваров;
		ДозаполнитьКодыМаркировкиИзДереваЭлектронногоДокументаУПД_5_03(ДеревоДанных, ДокументОбъект);
		
		//Запись реквизитов прослеживаемости в справочники
		Для Каждого ТекНоменклатура Из ДокументОбъект.СписокНоменклатуры Цикл
			Если ТекНоменклатура.ПрослеживаемыйТовар Тогда
				НоменклатураСпискаСсылка = ТекНоменклатура.Номенклатура;
				Если ЗначениеЗаполнено(НоменклатураСпискаСсылка) Тогда
					Если ТипЗнч(НоменклатураСпискаСсылка) = Тип("СправочникСсылка.Номенклатура")
						ИЛИ ТипЗнч(НоменклатураСпискаСсылка) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
						НоменклатураСпискаОбъект = НоменклатураСпискаСсылка.ПолучитьОбъект();
						НоменклатураСпискаОбъект.ПрослеживаемыйТовар = Истина;
						Если ЗначениеЗаполнено(ТекНоменклатура.КодВидаТовара) Тогда
							КодТНВЭД = Справочники.КлассификаторТНВЭД.НайтиПоКоду(ТекНоменклатура.КодВидаТовара);
							НоменклатураСпискаОбъект.КодТНВЭД = КодТНВЭД;
						КонецЕсли;
						НоменклатураСпискаОбъект.СтранаПроисхождения = ТекНоменклатура.СтранаПроисхождения;
						
						НоменклатураСпискаОбъект.Записать();
					КонецЕсли;
				КонецЕсли;	
			КонецЕсли;	
		КонецЦикла;	
		
		ДокументОбъект.ДополнительныеСвойства.Вставить("ЕстьСоглашение", Истина);
		ДокументОбъект.ДополнительныеСвойства.Вставить("ПроцессыОбработкиДокументов_ЗаписатьБезПроверкиОбменДаннымиЗагрузка", Истина);
		Если Записывать Тогда
			Если НЕ ЗначениеЗаполнено(ДокументОбъект.Номер) Тогда
				ДокументОбъект.УстановитьНовыйНомер();
			КонецЕсли;
			ДокументОбъект.Записать(РежимЗаписи);
			СсылкаНаВладельца = ДокументОбъект.Ссылка;
		Иначе // если функция вызвана из формы "Обработки.ОбменСКонтрагентами.ФормаЗагрузкиПросмотраЭД"
			СсылкаНаВладельца = ДокументОбъект;
		КонецЕсли;
		
		//ЭПД
		ПроверитьУстановитьСвязьЭТрН(СсылкаНаВладельца);
		
		//Заполнение документа-основания 
		МассивДокОснований = Новый Массив;
		Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
			МассивДокОснований.Добавить(СсылкаНаВладельца);
		КонецЕсли;
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснованияСчетаФактуры", МассивДокОснований);
		
	Исключение
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Заполнение документа на основе ЭД. %1'"), Текст)
			+ Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ВыполнитьЗаписьСобытияПоЭДВЖурналРегистрации(ТекстСообщения,
			2, УровеньЖурналаРегистрации.Ошибка, ДокументОбъект.Метаданные(), СсылкаНаВладельца);
		ВызватьИсключение(Текст);
	КонецПопытки;
	
КонецПроцедуры

Процедура НайтиСоздатьСчетФактуруУПД_5_03(ДеревоДанных, СсылкаНаВладельца = Неопределено, СпособОбработки = "", ОписаниеОшибки = "", Записывать =Истина, ВидПервичногоДокумента = "")
	
	ДанныеЭД = ДанныеВходящегоЭД(ДеревоДанных);
	
	Если ЗначениеЗаполнено(ДанныеЭД.СведенияОСчетеФактуре.Исправление.НомерИсправления)
		Или ЗначениеЗаполнено(ДанныеЭД.СведенияОСчетеФактуре.Исправление.ДатаИсправления) Тогда
		
		НайтиСоздатьИсправительныйСчетФактуруУПД_5_03(ДанныеЭД, СсылкаНаВладельца, СпособОбработки, ОписаниеОшибки, Записывать, ВидПервичногоДокумента);
		Возврат;
	КонецЕсли;
	
	СписокОшибок = Новый Массив();
	
	ДанныеЗаполненияШапки = Новый Структура;
	
	ЭДПоставщика = Документы.ЭлектронныйДокументПоставщика.ПустаяСсылка();
	
	ТаблицаОснований = ПолучитьТаблицуОснованийСчетаФактурыУПД_5_03(ДеревоДанных, ЭДПоставщика);
	
	ДанныеЗаполненияШапки.Вставить("ЭДПоставщика", ЭДПоставщика);
	
	ДанныеЗаполненияШапки.Вставить("ДокументыОснования", ТаблицаОснований);
	
	ДанныеЗаполненияШапки.Вставить("ДатаПолучения", ТекущаяДатаСеанса());
	
	НомерДокумента = ДанныеЭД.СведенияОСчетеФактуре.НомерДокумента;
	ДатаДокумента = ДанныеЭД.СведенияОСчетеФактуре.ДатаДокумента;
	
	ДанныеЗаполненияШапки.Вставить("ВалютаДокумента", ПолучитьСсылкуВалютыУПД_5_03(ДанныеЭД));
	
	СсылкиСторонСделки = ПолучитьСсылкиСторонСделкиУПД_5_03(ДанныеЭД, СписокОшибок);
	
	Организация = СсылкиСторонСделки.Организация;
	Контрагент = СсылкиСторонСделки.Контрагент;
	
	ДанныеЗаполненияШапки.Вставить("Организация", СсылкиСторонСделки.Организация);
	ДанныеЗаполненияШапки.Вставить("Контрагент", СсылкиСторонСделки.Контрагент);
	ДанныеЗаполненияШапки.Вставить("Грузоотправитель", СсылкиСторонСделки.Грузоотправитель);
	ДанныеЗаполненияШапки.Вставить("Грузополучатель", СсылкиСторонСделки.Грузополучатель);
	
	Договор = ПолучитьСсылкуДоговораУПД_5_03(ДанныеЭД, Организация, Контрагент);
	
	Если Не ЗначениеЗаполнено(Договор) И ЗначениеЗаполнено(ЭДПоставщика) Тогда
		Договор = ЭДПоставщика.Договор;
	КонецЕсли;
	
	ДанныеЗаполненияШапки.Вставить("Договор", Договор);
	ДанныеЗаполненияШапки.Вставить("ДоговорКонтрагента", Договор);
	
	ДанныеЗаполненияШапки.Вставить("СуммаДокумента", ДанныеЭД.ТаблицаСчетаФактуры.ВсегоКОплате.СтоимостьСНалогом);
	
	ВидСчетаФактуры = ДанныеЭД.ВидСчетаФактуры;
	
	Если ВидСчетаФактуры = "Авансовый" Тогда
		ДанныеЗаполненияШапки.Вставить("КодВидаОперации", "02");
		ДанныеЗаполненияШапки.Вставить("ПричинаНалогообложения", Перечисления.ПричиныНалогообложенияНДС.АвансВыданный);
		ВидЦенности = Перечисления.ВидыЦенностейНДС.Аванс;
	Иначе
		ДанныеЗаполненияШапки.Вставить("КодВидаОперации", "01");
		ДанныеЗаполненияШапки.Вставить("ПричинаНалогообложения", Перечисления.ПричиныНалогообложенияНДС.Покупка);
	КонецЕсли;	
		
	ДанныеЗаполненияШапки.Вставить("КодСпособаВыставления", 2);
	ДанныеЗаполненияШапки.Вставить("НомерПервичногоДокумента", НомерДокумента);
	ДанныеЗаполненияШапки.Вставить("ДатаПервичногоДокумента", ДатаДокумента);
	Если ВидПервичногоДокумента = "" Тогда
		ВидПервичногоДокумента = НСтр("ru = 'Счет-фактура'"); 	
	КонецЕсли;	
	ДанныеЗаполненияШапки.Вставить("ВидПервичногоДокумента", ВидПервичногоДокумента);
	
	ТаблицаТоваров = Документы.СчетФактураПолученный.ПустаяСсылка().СоставНФА.ВыгрузитьКолонки();
	
	СведенияОТоварах = ДанныеЭД.ТаблицаСчетаФактуры.СведенияОбОтгруженныхПозициях;
	
	Для Каждого ТекТовар Из СведенияОТоварах Цикл
		СтрокаТаблицы = ТаблицаТоваров.Добавить();
		
		СтрокаТаблицы.НФА = ТекТовар.Наименование;
		
		ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка();
		НайтиСсылкуНаОбъект("ЕдиницыИзмерения", ЕдиницаИзмерения, ТекТовар.ЕдиницаИзмеренияКод);

		СтрокаТаблицы.ЕдиницаИзмерения = ЕдиницаИзмерения;
		СтрокаТаблицы.Количество = ТекТовар.Количество;
		СтрокаТаблицы.Сумма = ТекТовар.СтоимостьБезНалога;
		
		СтавкаНДС = ТекТовар.НалоговаяСтавка;
		
		Если СтавкаНДС = "НДС исчисляется налоговым агентом" Тогда
			СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;	
		КонецЕсли;	
		
		СтрокаТаблицы.СтавкаНДС = СтавкаНДС;
		СтрокаТаблицы.СуммаНДС = ТекТовар.СуммаНалога.Сумма;
		СтрокаТаблицы.Всего = ТекТовар.СтоимостьСНалогом;
		
		СтрокаТаблицы.СуммаАкциза = ТекТовар.СуммаАкциза.Сумма;
		
		Сопоставление = ТекТовар.Сопоставление;
		
		Если Сопоставление <> Неопределено Тогда
			Если ЗначениеЗаполнено(Сопоставление.Идентификатор) Тогда
				СтрокаТаблицы.ИдентификаторПоставщика = Сопоставление.Идентификатор;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Сопоставление.НоменклатураИБ) Тогда
				СтрокаТаблицы.НФА = Сопоставление.НоменклатураИБ;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Сопоставление.УпаковкаИБ) Тогда
				СтрокаТаблицы.ЕдиницаИзмерения = Сопоставление.УпаковкаИБ;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ДанныеЗаполненияШапки.Вставить("СоставНФА", ТаблицаТоваров);
	
	ДобавитьКомментарийПриНаличииОшибокУПД_5_03(ДанныеЗаполненияШапки, СписокОшибок);
	
	РежимЗаписи = РежимЗаписиДокумента.Запись;
	Попытка
		Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
			ДокументОбъект = СсылкаНаВладельца.ПолучитьОбъект();
			Если ДокументОбъект.Проведен Тогда 
				Текст = НСтр("ru = 'Операция возможна только для непроведенных документов!'");
			КонецЕсли;
		Иначе
			УстановитьПривилегированныйРежим(Истина);
			ДокументОбъект = Документы.СчетФактураПолученный.СоздатьДокумент();
			ДокументОбъект.Дата = ТекущаяДатаСеанса();
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(ДокументОбъект, ДанныеЗаполненияШапки);
		ДокументОбъект.ОбменДанными.Загрузка = Истина;
		ДокументОбъект.ДополнительныеСвойства.Вставить("ЕстьСоглашение", Истина);
		
		ДокументОбъект.ПлатежноРасчетныеДокументы.Очистить();
		ДокументОбъект.СоставНФА.Очистить();
		
		Если ДанныеЗаполненияШапки.Свойство("ДокументыОснования") И ЗначениеЗаполнено(ДанныеЗаполненияШапки.ДокументыОснования) Тогда
			Для каждого ТекДокОснование Из ДанныеЗаполненияШапки.ДокументыОснования Цикл
				Если ТипЗнч(ТекДокОснование.ДокументОснование) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда
					ДокументОбъект.ЭДПоставщика = ТекДокОснование.ДокументОснование;
				Иначе	
					НоваяСтрокаДок = ДокументОбъект.ДокументыОснования.Добавить();
					НоваяСтрокаДок.ДокументОснование = ТекДокОснование.ДокументОснование;
				КонецЕсли;	
			КонецЦикла;
		КонецЕсли;
		
		Если ДанныеЗаполненияШапки.Свойство("СоставНФА") И ЗначениеЗаполнено(ДанныеЗаполненияШапки.СоставНФА) Тогда
			ДокументОбъект.СоставНФА.Загрузить(ДанныеЗаполненияШапки.СоставНФА);
		КонецЕсли;
		
		Для Каждого ТекСтрока Из ДокументОбъект.ДокументыОснования Цикл
			Если ТипЗнч(ТекСтрока.ДокументОснование) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда
				ДокументОбъект.ВидЦенности = Перечисления.ВидыЦенностейНДС.Материалы;	
			ИначеЕсли ТипЗнч(ТекСтрока.ДокументОснование) = Тип("ДокументСсылка.ПоступлениеУслугРабот") Тогда
				ДокументОбъект.ВидЦенности = Перечисления.ВидыЦенностейНДС.Услуги;	
			КонецЕсли;	
		КонецЦикла;	
		
		ДокументОбъект.СуммаНДС = ДокументОбъект.СоставНФА.Итог("СуммаНДС");
		
		ДокументОбъект.ДополнительныеСвойства.Вставить("ПроцессыОбработкиДокументов_ЗаписатьБезПроверкиОбменДаннымиЗагрузка", Истина);
		Если Записывать Тогда
			Если НЕ ЗначениеЗаполнено(ДокументОбъект.Номер) Тогда
				ДокументОбъект.УстановитьНовыйНомер();
			КонецЕсли;
			ДокументОбъект.Записать(РежимЗаписи);
			
			СсылкаНаВладельца = ДокументОбъект.Ссылка;
		Иначе
			СсылкаНаВладельца = ДокументОбъект;
		КонецЕсли;
	Исключение
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Заполнение документа на основе ЭД. %1'"), Текст)
			+ Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ВыполнитьЗаписьСобытияПоЭДВЖурналРегистрации(ТекстСообщения,
			2, УровеньЖурналаРегистрации.Ошибка, ДокументОбъект.Метаданные(), СсылкаНаВладельца);
		ВызватьИсключение(Текст);
	КонецПопытки;
	
КонецПроцедуры

