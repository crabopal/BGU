Функция РеквизитыЭТрН(Основание) Экспорт
	
	РеквизитыФормы = Новый Структура;
	РеквизитыФормы.Вставить("ЭлектроннаяТранспортнаяНакладная", Документы.ЭлектроннаяТранспортнаяНакладная.ПустаяСсылка());
	РеквизитыФормы.Вставить("СостояниеЭТрН",                    ""); 
	
	Если ЗначениеЗаполнено(Основание) Тогда
		Запрос = Новый Запрос;
		
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЭлектроннаяТранспортнаяНакладнаяДокументыОснования.Ссылка КАК ЭлектроннаяТранспортнаяНакладная,
		|	ЭлектроннаяТранспортнаяНакладная.Дата КАК Дата
		|ИЗ
		|	Документ.ЭлектроннаяТранспортнаяНакладная.ДокументыОснования КАК ЭлектроннаяТранспортнаяНакладнаяДокументыОснования
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭлектроннаяТранспортнаяНакладная КАК ЭлектроннаяТранспортнаяНакладная
		|		ПО ЭлектроннаяТранспортнаяНакладнаяДокументыОснования.Ссылка = ЭлектроннаяТранспортнаяНакладная.Ссылка 
		|ГДЕ
		|	ЭлектроннаяТранспортнаяНакладнаяДокументыОснования.ДокументОснование = &ДокументОснование
		|	И НЕ ЭлектроннаяТранспортнаяНакладная.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата УБЫВ";
		
		Запрос.УстановитьПараметр("ДокументОснование", Основание);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			РеквизитыФормы.ЭлектроннаяТранспортнаяНакладная = Выборка.ЭлектроннаяТранспортнаяНакладная;
		КонецЕсли;
	КонецЕсли; 
	
	РеквизитыФормы.СостояниеЭТрН = СостояниеЭТрН(РеквизитыФормы.ЭлектроннаяТранспортнаяНакладная, Основание);
	
	Возврат РеквизитыФормы;
	
КонецФункции

Функция СостояниеЭТрН(ЭлектроннаяТранспортнаяНакладная, Основание) Экспорт 
	
	Если ЗначениеЗаполнено(ЭлектроннаяТранспортнаяНакладная) Тогда
		РеквизитыОбъекта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			ЭлектроннаяТранспортнаяНакладная, 
			"ТитулГрузоотправителяТранспортнаяНакладнаяНомер, ТитулГрузоотправителяТранспортнаяНакладнаяДата, ТекущийШаг");
			
		СостояниеЭТрН = СтрШаблон("%1 от %2 (%3)", 
			ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(РеквизитыОбъекта.ТитулГрузоотправителяТранспортнаяНакладнаяНомер), 
			ФОрмат(РеквизитыОбъекта.ТитулГрузоотправителяТранспортнаяНакладнаяДата, "ДФ=dd.MM.yyyy"), РеквизитыОбъекта.ТекущийШаг);
	ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12")
		ИЛИ ТипЗнч(Основание) = Тип("ДокументСсылка.ПередачаОбъектовОС") Тогда
		СостояниеЭТрН = НСтр("ru = 'Создать документ'");
	Иначе
		СостояниеЭТрН = НСтр("ru = 'Выбрать документ'");
	КонецЕсли;
	
	Возврат СостояниеЭТрН;
	
КонецФункции

Процедура ДополнительныеКомандыЭДО_ФормаДокумента(Форма) Экспорт
	
	Элементы = Форма.Элементы;
	Объект   = Форма.Объект;

	МестоРазмещенияКомандПоУмолчанию = Элементы.Найти("КомандыЭДО");
	Если МестоРазмещенияКомандПоУмолчанию <> Неопределено Тогда
		Если Форма.Команды.Найти("СоздатьЭлектроннуюТранспортнуюНакладную") <> Неопределено Тогда
			НовыйЭлемент            = Форма.Элементы.Добавить("СоздатьЭлектроннуюТранспортнуюНакладную", Тип("КнопкаФормы"), МестоРазмещенияКомандПоУмолчанию);
			НовыйЭлемент.Вид        = ВидКнопкиФормы.КнопкаКоманднойПанели;
			НовыйЭлемент.ИмяКоманды = "СоздатьЭлектроннуюТранспортнуюНакладную";
		КонецЕсли; 
	КонецЕсли
КонецПроцедуры

Процедура ДобавитьВЭПДЭлементыБГУ(Форма, ГруппаЭлементовВИнтерфейсе = "ГруппаШапка") Экспорт

	Элементы = Форма.Элементы;
	МестоРазмещенияКомандПоУмолчанию = Элементы.Найти(ГруппаЭлементовВИнтерфейсе);
	Если МестоРазмещенияКомандПоУмолчанию <> Неопределено Тогда
		Если Форма.Команды.Найти("ЗаполнитьПоСведениямИзБГУ") <> Неопределено Тогда
			НовыйЭлемент            = Форма.Элементы.Добавить("ЗаполнитьПоСведениямИзБГУ", Тип("КнопкаФормы"), МестоРазмещенияКомандПоУмолчанию);
			НовыйЭлемент.Вид        = ВидКнопкиФормы.КнопкаКоманднойПанели;
			НовыйЭлемент.ИмяКоманды = "ЗаполнитьПоСведениямИзБГУ";
		КонецЕсли; 
	КонецЕсли
	
КонецПроцедуры

Функция СведенияДляЭПДИзБГУ(ВыбранноеЗначение, ВидЗначения = "") Экспорт
	Результат = Новый Структура;
	
	Если ВидЗначения = "Водитель" Тогда
		Водитель = ВыбранноеЗначение;
	
		Результат = УчетГСМ.ПолучитьДанныеВодителя(Водитель, ТекущаяДата());
		
		РеквизитыВодителя = "Контрагент";
		СтруктураДанныхВодителя = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Водитель, РеквизитыВодителя);
		
		СтруктураДанныхКонтрагента = Новый Структура;
		ПолучитьДанныеЮрФизЛица(СтруктураДанныхВодителя.Контрагент, СтруктураДанныхКонтрагента);
		
		Результат.Вставить("ИНН", СтруктураДанныхКонтрагента.ИНН);
		Результат.Вставить("Телефоны", СтруктураДанныхКонтрагента.Телефоны);
		
		Результат.Вставить("Фамилия", СтруктураДанныхКонтрагента.Фамилия);
		Результат.Вставить("Имя", СтруктураДанныхКонтрагента.Имя);
		Результат.Вставить("Отчество", СтруктураДанныхКонтрагента.Отчество);

		Должность = Справочники.Сотрудники.ПолучитьСвойствоСотрудника(Водитель, "Должность");
		Результат.Вставить("Должность", Должность);
		
	ИначеЕсли ВидЗначения = "ПутевойЛист" Тогда
		ПутевойЛист = ВыбранноеЗначение;
		
		ДанныеПутевогоЛиста = УчетГСМ.ПолучитьДанныеПутевогоЛиста(ПутевойЛист);
		НомерДокумента = НомерДляПечати(ПутевойЛист, ДанныеПутевогоЛиста.Номер);
		Результат.Вставить("НомерДокумента", НомерДокумента);
		Результат.Вставить("ДатаДокумента", ДанныеПутевогоЛиста.Дата);
	ИначеЕсли ВидЗначения = "ТранспортноеСредство" Тогда
		ТранспортноеСредство = ВыбранноеЗначение;
		
		ДанныеТС = УчетГСМ.ПолучитьПаспортТранспортногоСредства(ТранспортноеСредство, ТекущаяДата());
		
		Результат.Вставить("РегистрационныйЗнак", ДанныеТС.РегистрационныйЗнак);
		Результат.Вставить("ИдентификационныйНомер", ДанныеТС.ИдентификационныйНомер);
		Результат.Вставить("Марка", ДанныеТС.Марка);
		Результат.Вставить("Модель", ДанныеТС.Модель);
		Результат.Вставить("Тип", ДанныеТС.Тип);
		Результат.Вставить("Грузоподъемность", ДанныеТС.Грузоподъемность);
		Результат.Вставить("ИнвентарныйНомер", УчетГСМ.ИнвентарныйНомерОбъекта(ТранспортноеСредство));
		
	ИначеЕсли ВидЗначения = "ПодтверждающийОтгрузкуДокумент" Тогда
		ДокументОтгрузкиТоваров = ВыбранноеЗначение;
		РеквизитыДокумента = "Номер, Дата";
		СтруктураДанныхДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОтгрузкиТоваров, РеквизитыДокумента);
		НомерДокумента = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументОтгрузкиТоваров, СтруктураДанныхДокумента.Номер);
		ДатаДокумента = СтруктураДанныхДокумента.Дата;
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	СчетФактураВыданный.Ссылка КАК Ссылка,
		               |	СчетФактураВыданный.Номер КАК Номер,
		               |	СчетФактураВыданный.Дата КАК Дата
		               |ИЗ
		               |	Документ.СчетФактураВыданный КАК СчетФактураВыданный
		               |ГДЕ
		               |	СчетФактураВыданный.ДокументОснование = &ДокументОснование
		               |	И СчетФактураВыданный.ПометкаУдаления = ЛОЖЬ";
		Запрос.УстановитьПараметр("ДокументОснование", ДокументОтгрузкиТоваров);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			НомерДокумента = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(Выборка.Ссылка, Выборка.Номер);
			ДатаДокумента = Выборка.Дата;
		КонецЕсли;	
		
		Результат.Вставить("НомерДокумента", НомерДокумента);
		Результат.Вставить("ДатаДокумента", ДатаДокумента);
	КонецЕсли;

	Возврат Результат;
КонецФункции	

Процедура ПроверитьУстановитьСвязьЭТрН(ПоступлениеТоваровСсылка)
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	ТранспортнаяНакладнаяШапка.Ссылка КАК Ссылка,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗначенияРеквизитовДокументовЭПД.ИмяРеквизита) КАК СовпадалоРеквизитов
	|ИЗ
	|	Документ.ЭлектронныйДокументПоставщика КАК ПоступлениеТоваровУслуг
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭлектроннаяТранспортнаяНакладная КАК ТранспортнаяНакладнаяШапка
	|		ПО ПоступлениеТоваровУслуг.Организация = ТранспортнаяНакладнаяШапка.Организация
	|			И ПоступлениеТоваровУслуг.Контрагент = ТранспортнаяНакладнаяШапка.СсылкаТитулГрузоотправителяГрузоотправитель
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияРеквизитовДокументовЭПД КАК ЗначенияРеквизитовДокументовЭПД
	|		ПО (ТранспортнаяНакладнаяШапка.Ссылка = ЗначенияРеквизитовДокументовЭПД.Документ)
	|			И (ЗначенияРеквизитовДокументовЭПД.ИмяТабличнойЧасти = ""ТитулГрузоотправителяДокументыПодтверждающиеОтгрузку"")
	|ГДЕ
	|	(ЗначенияРеквизитовДокументовЭПД.ИмяРеквизита = ""НомерДокумента""
	|				И (ВЫРАЗИТЬ(ЗначенияРеквизитовДокументовЭПД.ЗначениеРеквизитаСтрока КАК СТРОКА(50))) = ПоступлениеТоваровУслуг.НомерПервичногоДокумента
	|			ИЛИ ЗначенияРеквизитовДокументовЭПД.ИмяРеквизита = ""ДатаДокумента""
	|				И ЗначенияРеквизитовДокументовЭПД.ЗначениеРеквизита = ПоступлениеТоваровУслуг.ДатаПервичногоДокумента)
	|	И ПоступлениеТоваровУслуг.Ссылка = &ПоступлениеТоваровСсылка
	|	И НЕ ЗначенияРеквизитовДокументовЭПД.Документ ЕСТЬ NULL
	|
	|СГРУППИРОВАТЬ ПО
	|	ТранспортнаяНакладнаяШапка.Ссылка
	|
	|ИМЕЮЩИЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗначенияРеквизитовДокументовЭПД.ИмяРеквизита) = 2";
	
	Запрос.УстановитьПараметр("ПоступлениеТоваровСсылка",   ПоступлениеТоваровСсылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() = 1 Тогда
		Выборка.Следующий();
		
		ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
		Если ДокументОбъект <> Неопределено Тогда
			СтруктураПоиска = Новый Структура("ДокументОснование", ПоступлениеТоваровСсылка);
			Если ДокументОбъект.ДокументыОснования.НайтиСтроки(СтруктураПоиска).Количество() > 0 Тогда
				Возврат;
			КонецЕсли; 
			
			НоваяСтрока = ДокументОбъект.ДокументыОснования.Добавить();
			НоваяСтрока.ДокументОснование = ПоступлениеТоваровСсылка;
			
			РежимЗаписи = РежимЗаписиДокумента.Запись;
			Если ДокументОбъект.Проведен Тогда 
				РежимЗаписи = РежимЗаписиДокумента.Проведение;
			КонецЕсли;

			Текст = СокрЛП(ПоступлениеТоваровСсылка);
			Попытка
				ДокументОбъект.ОбменДанными.Загрузка = Ложь;
				Если НЕ ЗначениеЗаполнено(ДокументОбъект.Номер) Тогда
					ДокументОбъект.УстановитьНовыйНомер();
				КонецЕсли;
				ДокументОбъект.Записать(РежимЗаписи);
			Исключение
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Заполнение электронной транспортной накладной для электронного документа поставщика. %1'"), Текст)
					+ Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ВыполнитьЗаписьСобытияПоЭДВЖурналРегистрации(ТекстСообщения,
					2, УровеньЖурналаРегистрации.Ошибка, , ПоступлениеТоваровСсылка);
			ВызватьИсключение(Текст);
		КонецПопытки;
			
		КонецЕсли; 
	КонецЕсли; 

КонецПроцедуры

Функция ЭтоЭлектронныеПеревозочныеДокументы(Объект)
	ТипОбъекта = ТипЗнч(Объект);
	
	Возврат ТипОбъекта = Тип("ДокументОбъект.ЭлектроннаяТранспортнаяНакладная")
		ИЛИ ТипОбъекта = Тип("ДокументОбъект.ЭлектроннаяСопроводительнаяВедомость")
		ИЛИ ТипОбъекта = Тип("ДокументОбъект.ЭлектронныйЗаказНаряд");
	
КонецФункции	

//Изменения ЭПД 2026

Функция ДокументооборотЭПДНастроен(Организация, Контрагент, ВидимостьЭлементовЭДО = Истина, ТипЭПД = 0) Экспорт
	Если НЕ ВидимостьЭлементовЭДО Тогда
		Возврат Ложь;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(Организация) 
		ИЛИ НЕ ЗначениеЗаполнено(Контрагент)
		ИЛИ НЕ ЭлектронныеДокументыЭДО.ЕстьПравоЧтенияДокументов() Тогда
		
		Возврат Ложь;
	КонецЕсли; 
	
	ПараметрыЭД = Новый Структура;
	
	ПараметрыЭД.Вставить("Организация",  Организация);
	ПараметрыЭД.Вставить("Контрагент",   Контрагент);
	Если ТипЭПД = 2 Тогда
		ПараметрыЭД.Вставить("ТипДокумента", ОбменСКонтрагентами.ТипыДокументов().ЭЗЗ);
	Иначе
		ПараметрыЭД.Вставить("ТипДокумента", ОбменСКонтрагентами.ТипыДокументов().ЭТрН);
	КонецЕсли;
	
	ПараметрыЭД.Вставить("Направление",  Перечисления.НаправленияЭДО.Исходящий);
	
	Возврат ОбменСКонтрагентами.ДокументооборотНастроен(ПараметрыЭД);
КонецФункции

// Получить реквизиты договора.
// 
// Параметры:
//  СсылкаНаДоговор Ссылка на договор
//  Результат - Структура 
// 		* Наименование 	- строка
// 		* Номер 	- строка
// 		* Дата 	- дата
Процедура ПолучитьРеквизитыДоговора(СсылкаНаДоговор, Результат) Экспорт
	
	Результат = Новый Структура("Наименование,Номер,Дата");
	Если ЗначениеЗаполнено(СсылкаНаДоговор) Тогда
		Реквизиты = Новый Структура;
		Реквизиты.Вставить("Наименование", "ВидОбязательства");
		Реквизиты.Вставить("Номер", "НомерДоговора");
		Реквизиты.Вставить("Дата", "ДатаДоговора");
		РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаДоговор, Реквизиты);
		ЗаполнитьЗначенияСвойств(Результат, РеквизитыДоговора);
	КонецЕсли;
	
КонецПроцедуры


#КонецОбласти

Функция ЕстьАктуальныйВнутреннийДокумент(ДокументУчета) Экспорт
	Результат = Ложь;
	
	ЭД = ЭлектронныйДокументБЭДПоДокументуУчета(ДокументУчета);
	
	Если ЗначениеЗаполнено(ЭД) Тогда
		Если ЭД.СпособОбмена = Перечисления.СпособыОбменаЭД.Внутренний Тогда
			Результат = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

#КонецОбласти

#Область АктСверкиВзаиморасчетов

// Подготавливает данные для электронного документа вида "Акт сверки расчетов с контрагентом".
//
// Параметры:
//  Основание - ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО - основание для электронного документа.
//  Настройки - ФиксированнаяСтруктура - настройки заполнения данных:
//   * ТипДокумента - Произвольный - ожидаемый вид документа. Доступные значения представлены следующими свойствами
//                                   результата функции см. ОбменСКонтрагентами.ТипыДокументов:
//                                    - АктСверкиВзаиморасчетов.
//  Данные - ДеревоЗначений - данные для заполнения электронного документа. Строится по макету 
//                            см. Обработка.ОбменСКонтрагентами.Макет.АктСверкиВзаиморасчетов_ИнформацияОтправителя. Выходной параметр.
//  Описание - Структура - дополнительная информация о документе. Выходной параметр.
//   * Основания - Массив из ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО - ссылки на дополнительные объекты-основания
//                 электронного документа помимо указанного в параметре "Основание".
//  Отказ - Булево - признак отказа от дальнейшего формирования электронного документа.
//                   Информационное сообщение пользователю необходимо формировать самостоятельно.
//
Процедура ЗаполнитьДанныеАктСверкиВзаиморасчетов_ИнформацияОтправителя(Основание, Настройки, ДеревоДанных, Описание, Отказ) Экспорт

	Если Не ДоступенЭДОДляЭДАктСверкиВзаиморасчетов(Основание) Тогда
		ТекстСообщения = НСтр("ru = 'Электронный документ ""Акт сверки расчетов с контрагентом"" недоступен.'");
		СообщитьОбОшибкеПриФормированииЭД(Основание, ТекстСообщения, Отказ);
		Возврат;
	КонецЕсли;
	
	ПараметрыОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Основание, "ЭтоЭлектронныйДокумент,ЭтоДокументКонтрагента");
	
	Если Не ПараметрыОснования.ЭтоЭлектронныйДокумент Тогда
		ТекстСообщения = НСтр("ru = 'Не установлен признак составления в электронном виде.'");
		СообщитьОбОшибкеПриФормированииЭД(Основание, ТекстСообщения, Отказ);
		Возврат;
	ИначеЕсли ПараметрыОснования.ЭтоДокументКонтрагента Тогда
		ТекстСообщения = НСтр("ru = 'Для входящего документа недоступно формирование электронного документа.'");
		СообщитьОбОшибкеПриФормированииЭД(Основание, ТекстСообщения, Отказ);
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Основание);
	Запрос.Текст = Документы.АктСверкиВзаиморасчетов.ТекстЗапросаДляФормированияЭлектронногоДокументаДанныеОтправителя();
	Результат = Запрос.ВыполнитьПакет();
	ТаблицаРеквизитыДокумента = Результат[0].Выгрузить();
	Если ТаблицаРеквизитыДокумента.Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru = 'Нет данных для формирования электронного документа.'");
		СообщитьОбОшибкеПриФормированииЭД(Основание, ТекстСообщения, Отказ);
		Возврат;
	КонецЕсли;
	
	РеквизитыДокумента = ТаблицаРеквизитыДокумента[0];
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ДатаНачалаПериодаСверки", РеквизитыДокумента.ДатаНачала);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ДатаОкончанияПериодаСверки", РеквизитыДокумента.ДатаОкончания);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"НомерДокумента", ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(РеквизитыДокумента.Номер, Истина, Ложь));
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"КодВалюты", РеквизитыДокумента.КодВалюты, ТекстОшибкиНекорректнаяВалюта());
	ЗаполнитьРеквизитыУчастникаОбменаАктамиСверки(ДеревоДанных, РеквизитыДокумента.Организация, РеквизитыДокумента.Дата, "Отправитель");
	ЗаполнитьРеквизитыУчастникаОбменаАктамиСверки(ДеревоДанных, РеквизитыДокумента.Контрагент, РеквизитыДокумента.Дата, "Получатель");

	ТаблицаИтоги = Результат[1].Выгрузить();
	СальдоНаНачалоПериодаДебет = 0;
	СальдоНаНачалоПериодаКредит = 0;
	Если РеквизитыДокумента.ОстатокНаНачало > 0 Тогда
		СальдоНаНачалоПериодаДебет = РеквизитыДокумента.ОстатокНаНачало;
	Иначе
		СальдоНаНачалоПериодаКредит = - РеквизитыДокумента.ОстатокНаНачало;
	КонецЕсли;
	ОборотПоДебету   = ТаблицаИтоги.Итог("Дебет");
	ОборотПоКредиту = ТаблицаИтоги.Итог("Кредит");
	СальдоНаКонецПериодаДебет = СальдоНаНачалоПериодаДебет + ОборотПоДебету;
	СальдоНаКонецПериодаКредит = СальдоНаНачалоПериодаКредит + ОборотПоКредиту;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"СведенияОтправителя.СальдоНаНачалоПериодаДебет", СальдоНаНачалоПериодаДебет);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"СведенияОтправителя.СальдоНаНачалоПериодаКредит", СальдоНаНачалоПериодаКредит);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"СведенияОтправителя.ОборотПоДебету", ОборотПоДебету);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"СведенияОтправителя.ОборотПоКредиту", ОборотПоКредиту);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"СведенияОтправителя.СальдоНаКонецПериодаДебет", СальдоНаКонецПериодаДебет);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"СведенияОтправителя.СальдоНаКонецПериодаКредит", СальдоНаКонецПериодаКредит);
	
	СведенияПоДоговорам = НовыйТаблицаСведенияПоДоговорам();
	
	ЗаполнитьСведенияПоДоговорамАктСверкиЭД(СведенияПоДоговорам, Результат[3], Результат[2]);
	
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, СведенияПоДоговорам, "СведенияОтправителя.СведенияПоДоговорам");
	
КонецПроцедуры

// Подготавливает данные для электронного документа вида "Акт сверки расчетов с контрагентом".
//
// Параметры:
//  Основание - ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО - основание для электронного документа.
//  Настройки - ФиксированнаяСтруктура - настройки заполнения данных:
//   * ТипДокумента - Произвольный - ожидаемый вид документа. Доступные значения представлены следующими свойствами
//                                   результата функции см. ОбменСКонтрагентами.ТипыДокументов:
//                                    - АктСверкиВзаиморасчетов.
//  Данные - ДеревоЗначений - данные для заполнения электронного документа. Строится по макету 
//                            см. Обработка.ОбменСКонтрагентами.Макет.АктСверкиВзаиморасчетов_ИнформацияПолучателя. Выходной параметр.
//  Описание - Структура - дополнительная информация о документе. Выходной параметр.
//   * Основания - Массив из ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО - ссылки на дополнительные объекты-основания
//                 электронного документа помимо указанного в параметре "Основание".
//  Отказ - Булево - признак отказа от дальнейшего формирования электронного документа.
//                   Информационное сообщение пользователю необходимо формировать самостоятельно.
//
Процедура ЗаполнитьДанныеАктСверкиВзаиморасчетов_ИнформацияПолучателя(ОбъектыУчета, Настройки, ДеревоДанных, Описание, Отказ) Экспорт
	
	Если ТипЗнч(ОбъектыУчета) = Тип("Массив") Тогда
		Если ОбъектыУчета.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		Основание = ОбъектыУчета[0];
	Иначе
		Основание = ОбъектыУчета;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Основание) Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ДоступенЭДОДляЭДАктСверкиВзаиморасчетов(Основание) Тогда
		ТекстСообщения = НСтр("ru = 'Электронный документ ""Акт сверки расчетов с контрагентом"" недоступен.'");
		СообщитьОбОшибкеПриФормированииЭД(Основание, ТекстСообщения, Отказ);
		Возврат;
	КонецЕсли;
	
	ПараметрыОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Основание, "ЭтоЭлектронныйДокумент,ЭтоДокументКонтрагента");
	
	Если Не ПараметрыОснования.ЭтоЭлектронныйДокумент Тогда
		ТекстСообщения = НСтр("ru = 'Не установлен признак составления в электронном виде.'");
		СообщитьОбОшибкеПриФормированииЭД(Основание, ТекстСообщения, Отказ);
		Возврат;
	ИначеЕсли Не ПараметрыОснования.ЭтоДокументКонтрагента Тогда
		ТекстСообщения = НСтр("ru = 'Формирование ответного титула доступно только для полученного электронного документа.'");
		СообщитьОбОшибкеПриФормированииЭД(Основание, ТекстСообщения, Отказ);
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Основание);
	Запрос.Текст = Документы.АктСверкиВзаиморасчетов.ТекстЗапросаДляФормированияЭлектронногоДокументаДанныеПолучателя();
	Результат = Запрос.ВыполнитьПакет();
	ТаблицаРеквизитыДокумента = Результат[0].Выгрузить();
	Если ТаблицаРеквизитыДокумента.Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru = 'Нет данных для формирования электронного документа.'");
		СообщитьОбОшибкеПриФормированииЭД(Основание, ТекстСообщения, Отказ);
		Возврат;
	КонецЕсли;
	
	РеквизитыДокумента = ТаблицаРеквизитыДокумента[0];
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"ПризнакНаличияРазногласий", РеквизитыДокумента.ЕстьРасхождения И Не РеквизитыДокумента.СверкаСогласована);
	
	ТаблицаИтоги = Результат[1].Выгрузить();
	
	СальдоНаНачалоПериодаДебет = 0;
	СальдоНаНачалоПериодаКредит = 0;
	Если РеквизитыДокумента.ОстатокНаНачало > 0 Тогда
		СальдоНаНачалоПериодаДебет = РеквизитыДокумента.ОстатокНаНачало;
	Иначе
		СальдоНаНачалоПериодаКредит = - РеквизитыДокумента.ОстатокНаНачало;
	КонецЕсли;
	ОборотПоДебету   = ТаблицаИтоги.Итог("Дебет");
	ОборотПоКредиту = ТаблицаИтоги.Итог("Кредит");
	СальдоНаКонецПериодаДебет = СальдоНаНачалоПериодаДебет + ОборотПоДебету;
	СальдоНаКонецПериодаКредит = СальдоНаНачалоПериодаКредит + ОборотПоКредиту;
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"СведенияПолучателя.СальдоНаНачалоПериодаДебет", СальдоНаНачалоПериодаДебет);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"СведенияПолучателя.СальдоНаНачалоПериодаКредит", СальдоНаНачалоПериодаКредит);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"СведенияПолучателя.ОборотПоДебету", ОборотПоДебету);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"СведенияПолучателя.ОборотПоКредиту", ОборотПоКредиту);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"СведенияПолучателя.СальдоНаКонецПериодаДебет", СальдоНаКонецПериодаДебет);
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
		"СведенияПолучателя.СальдоНаКонецПериодаКредит", СальдоНаКонецПериодаКредит);
	
	СведенияПоДоговорам = НовыйТаблицаСведенияПоДоговорам();
	
	ЗаполнитьСведенияПоДоговорамАктСверкиЭД(СведенияПоДоговорам, Результат[3], Результат[2]);
	
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, СведенияПоДоговорам, "СведенияПолучателя.СведенияПоДоговорам");
	
КонецПроцедуры

// Поиск и создание учетного документа при отражении в учете документа Акт сверки взаиморасчетов (информация отправителя).
// Формат по приказу ЕД-7-26/405@.
//
// Параметры:
//  ДеревоДанных		 - ДеревоЗначений - данные электронного документа в виде заполненного макета 
//                         см. Обработка.ОбменСКонтрагентами.Макет.АктСверкиВзаиморасчетов_ИнформацияОтправителя.
//  ДокументУчета	     - ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО - ссылка на документ учета, если он уже
//                         прикреплен к электронному документу.
//  СпособОбработки		 - Строка - способ сохранения данных в информационной базе, выбранный пользователем. Передается 
//                         значение элемента списка значений, заданного в см. ОбменСКонтрагентамиПереопределяемый.СписокОперацийТипаЭД
//  ОписаниеОшибки       - Строка - описание ошибки создания учетного документа. Может быть выведена пользователю.
//
Процедура НайтиСоздатьАктСверкиВзаиморасчетов(ДеревоДанных, ДокументУчета = Неопределено, СпособОбработки = "", ОписаниеОшибки = "") Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	ДанныеДляЗаполнения = ПодготовитьСтруктуруДляАктСверкиВзаиморасчетовВходящий(ДеревоДанных, ОписаниеОшибки);
	ЗаполнитьДокументАктСверкиВзаиморасчетовВходящий(ДокументУчета, ДанныеДляЗаполнения, ОписаниеОшибки);
	
КонецПроцедуры

// Выполняет заполнение электронных документов вида "Акт сверки расчетов с контрагентом"
// данными, поступившими от их получателя.
//
// Параметры:
//  ДанныеДокумента - Структура - см. ФорматыЭДО.ДанныеЭлектронногоДокумента.
//  ОбъектыУчета - Массив - ОпределяемыеТипы.ОснованияЭлектронныхДокументовЭДО.
Процедура ЗаполнитьАктСверкиВзаиморасчетовПоДаннымПолучателя(ДанныеДокумента, ОбъектыУчета = Неопределено) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	ДанныеДляЗаполнения = ПодготовитьСтруктуруДляАктСверкиВзаиморасчетовПолученОтветныйТитул(ДанныеДокумента, ОбъектыУчета);
	ЗаполнитьДокументАктСверкиВзаиморасчетовИсходящийОтветнымТитулом(ДанныеДляЗаполнения);
	
КонецПроцедуры	

#КонецОбласти

#Область АктСверкиВзаиморасчетовСлужебные

Процедура СообщитьОбОшибкеПриФормированииЭД(Документ, ТекстОшибки, Отказ)

	ШаблонСообщения = НСтр("ru = 'Не удалось сформировать электронный документ на основании документа ""%1"". %2'");
	
	ОбщегоНазначения.СообщитьПользователю(СтрШаблон(ШаблонСообщения, Документ, ТекстОшибки),,,, Отказ);

КонецПроцедуры

Функция НовыйТаблицаСведенияПоДоговорам()
	
	СведенияПоДоговорам = Новый ТаблицаЗначений;
	СведенияПоДоговорам.Колонки.Добавить("НомерСтроки", );
	СведенияПоДоговорам.Колонки.Добавить("НомерДоговора", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	СведенияПоДоговорам.Колонки.Добавить("ДатаДоговора", );
	СведенияПоДоговорам.Колонки.Добавить("ОписаниеДоговора", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(500)));
	СведенияПоДоговорам.Колонки.Добавить("СведенияПоДокументам", );
	
	ТипСумма = ОбщегоНазначения.ОписаниеТипаЧисло(15,2);
	СведенияПоДоговорам.Колонки.Добавить("СальдоНаНачалоПериодаДебет",	ТипСумма);
	СведенияПоДоговорам.Колонки.Добавить("СальдоНаНачалоПериодаКредит",	ТипСумма);
	СведенияПоДоговорам.Колонки.Добавить("ОборотПоДебету",				ТипСумма);
	СведенияПоДоговорам.Колонки.Добавить("ОборотПоКредиту",				ТипСумма);
	СведенияПоДоговорам.Колонки.Добавить("СальдоНаКонецПериодаДебет",	ТипСумма);
	СведенияПоДоговорам.Колонки.Добавить("СальдоНаКонецПериодаКредит",	ТипСумма);
	СведенияПоДоговорам.Колонки.Добавить("ИдентификаторДоговора",		ОбщегоНазначения.ОписаниеТипаСтрока(100));
	
	Возврат СведенияПоДоговорам;

КонецФункции

Функция НовыйТаблицаСведенияПоДокументам()
	
	СведенияПоДокументам = Новый ТаблицаЗначений;
	СведенияПоДокументам.Колонки.Добавить("НомерСтроки", );
	СведенияПоДокументам.Колонки.Добавить("НаименованиеДокумента", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(100)));
	СведенияПоДокументам.Колонки.Добавить("НомерДокумента", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	СведенияПоДокументам.Колонки.Добавить("ДатаДокумента", );
	СведенияПоДокументам.Колонки.Добавить("СведенияПоОперациям", );
	СведенияПоДокументам.Колонки.Добавить("ИдентификаторДокумента", ОбщегоНазначения.ОписаниеТипаСтрока(100));
	
	Возврат СведенияПоДокументам;

КонецФункции

Функция НовыйТаблицаСведенияПоОперациям()
	
	СведенияПоОперациям = Новый ТаблицаЗначений;
	СведенияПоОперациям.Колонки.Добавить("НомерСтроки", );
	СведенияПоОперациям.Колонки.Добавить("ПорядковыйНомерСтроки", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(6, 0)));
	СведенияПоОперациям.Колонки.Добавить("ДатаОперации", );
	СведенияПоОперациям.Колонки.Добавить("НаименованиеОперации", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(500)));
	СведенияПоОперациям.Колонки.Добавить("СуммаДебет", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	СведенияПоОперациям.Колонки.Добавить("СуммаКредит", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	
	Возврат СведенияПоОперациям;
	
КонецФункции

Функция ДоступенЭДОДляЭДАктСверкиВзаиморасчетов(СсылкаНаОбъект)
	
	Возврат ЗначениеЗаполнено(СсылкаНаОбъект) И ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.АктСверкиВзаиморасчетов");
	
КонецФункции

Функция ТекстОшибкиНекорректнаяВалюта()
	
	Возврат НСтр("ru = 'Не удалось заполнить код валюты документа. Проверьте, что:
		|	- в документе указана валюта,
		|	- для нее заполнен код по Общероссийскому классификатору валют.'");
	
КонецФункции

Функция ЗаполнитьРеквизитыУчастникаОбменаАктамиСверки(ДеревоДанных, Участник, ДатаСведений, ВидУчастника, ВидАдреса = "ЮридическийАдрес")

	СведенияОбУчастнике = Новый Структура;
	ПолучитьДанныеЮрФизЛица(Участник, СведенияОбУчастнике, ДатаСведений);
	ТипУчастникаОрганизация = ТипЗнч(Участник) = Тип("СправочникСсылка.Организации");
	
	Если СведенияОбУчастнике.СтранаРегистрации <> Справочники.СтраныМира.Россия Тогда
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ВидУчастника + ".ТипУчастника.ИЛ.НаименованиеОрганизации", СведенияОбУчастнике.ПолноеНаименование);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ВидУчастника + ".ТипУчастника.ИЛ.ИдентификаторОрганизации", СведенияОбУчастнике.НалоговыйНомерВСтранеРегистрации);
		
	ИначеЕсли СведенияОбУчастнике.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ВидУчастника + ".ТипУчастника.ЮЛ.НаименованиеОрганизации", СведенияОбУчастнике.ПолноеНаименование);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ВидУчастника + ".ТипУчастника.ЮЛ.ИНН", СведенияОбУчастнике.ИНН);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ВидУчастника + ".ТипУчастника.ЮЛ.КПП", СведенияОбУчастнике.КПП);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ВидУчастника + ".ТипУчастника.ЮЛ.ОГРН", СведенияОбУчастнике.ОГРН);
		
	Иначе
		
		Если СведенияОбУчастнике.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
			ТипУчастника = ".ТипУчастника.ФЛ";
			Если СведенияОбУчастнике.ИП Тогда
				ТипУчастника = ".ТипУчастника.ИП";
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
					ВидУчастника + ".ТипУчастника.ИП.ОГРН", СведенияОбУчастнике.ОГРНИП);
			КонецЕсли;
		КонецЕсли;
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ВидУчастника + ТипУчастника + ".ИНН", СведенияОбУчастнике.ИНН);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ВидУчастника + ТипУчастника + ".Фамилия", СведенияОбУчастнике.Фамилия);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ВидУчастника + ТипУчастника + ".Имя", СведенияОбУчастнике.Имя);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ВидУчастника + ТипУчастника + ".Отчество", СведенияОбУчастнике.Отчество);
			
	КонецЕсли;
	
	// Передаем в дерево данные для заполнения адреса.
	ВидКонтактнойИнформации = Неопределено;
	
	Если ВидАдреса = "ПочтовыйАдрес"
		И ЗначениеЗаполнено(СведенияОбУчастнике[ВидАдреса]) Тогда
		
		Если ТипУчастникаОрганизация Тогда
			ВидКонтактнойИнформации = Справочники.ВидыКонтактнойИнформации.ПочтовыйАдресОрганизации;
		ИначеЕсли СведенияОбУчастнике.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
			ВидКонтактнойИнформации = Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты;
		ИначеЕсли СведенияОбУчастнике.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
			ВидКонтактнойИнформации = Справочники.ВидыКонтактнойИнформации.АдресПоПропискеФизическиеЛица;
		КонецЕсли;
		
	ИначеЕсли ВидАдреса = "ФактическийАдрес" 
		И ЗначениеЗаполнено(СведенияОбУчастнике[ВидАдреса]) Тогда
		
		Если ТипУчастникаОрганизация Тогда
			ВидКонтактнойИнформации = Справочники.ВидыКонтактнойИнформации.ФактАдресОрганизации;
		ИначеЕсли СведенияОбУчастнике.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
			ВидКонтактнойИнформации = Справочники.ВидыКонтактнойИнформации.ФактическийАдресКонтрагенты;
		ИначеЕсли СведенияОбУчастнике.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
			ВидКонтактнойИнформации = Справочники.ВидыКонтактнойИнформации.АдресМестаПроживанияФизическиеЛица;
		КонецЕсли;
		
	Иначе
		Если СведенияОбУчастнике.ИП Тогда	
			ВидКонтактнойИнформации = Справочники.ВидыКонтактнойИнформации.АдресПоПропискеФизическиеЛица;
		Иначе	
			ВидКонтактнойИнформации = ?(ТипУчастникаОрганизация, Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации,
				Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты);
		КонецЕсли;
	КонецЕсли;
		
	Если ВидКонтактнойИнформации <> Неопределено Тогда
		
		ПостфиксПоляАдрес = ?(ТипУчастникаОрганизация, "Организации", "Контрагента");
		
		ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(
			Участник, "КонтактнаяИнформацияПолеЮрАдрес" + ПостфиксПоляАдрес + ".");
		
		ЭлектронноеВзаимодействие.ДобавитьВРеквизитОбработкуОшибки(ДеревоДанных, ВидУчастника + ".Адрес.АвтоматическиЗаполняемый",
			ПараметрыОбработкиОшибок);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ВидУчастника + ".Адрес.АвтоматическиЗаполняемый.ОбъектКонтактнойИнформации", Участник);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ВидУчастника + ".Адрес.АвтоматическиЗаполняемый.ВидКонтактнойИнформации", ВидКонтактнойИнформации);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СведенияОбУчастнике.Телефоны) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ВидУчастника + ".КонтактныеСведения.Телефон", СведенияОбУчастнике.Телефоны);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СведенияОбУчастнике.ЭлектроннаяПочта) Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			ВидУчастника + ".КонтактныеСведения.ЭлектроннаяПочта", СведенияОбУчастнике.ЭлектроннаяПочта);
	КонецЕсли;
	
КонецФункции

Функция ДанныеВходящегоЭД(ДеревоДанных)
	
	Результат = Новый Структура;
	Для каждого СтрокаДерева Из ДеревоДанных.Строки Цикл
		Путь = СтрокаДерева.ПолныйПуть;
		ДанныеСтроки = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ДеревоДанных, Путь);
		Результат.Вставить(Путь, ДанныеСтроки);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПодготовитьСтруктуруДляАктСверкиВзаиморасчетовВходящий(ДеревоДанных, ОписаниеОшибки = "")
	
	ДанныеЭД = ДанныеВходящегоЭД(ДеревоДанных);
	
	Шапка = Новый Структура;
	Шапка.Вставить("ЭтоЭлектронныйДокумент",	Истина);
	Шапка.Вставить("ЭтоДокументКонтрагента",	Истина);
	Шапка.Вставить("ДетализироватьПоДоговорам",	Истина);
	Шапка.Вставить("ДатаНачала",              ДанныеЭД.ДатаНачалаПериодаСверки);
	Шапка.Вставить("ДатаОкончания",           ДанныеЭД.ДатаОкончанияПериодаСверки);
	Шапка.Вставить("НомерВходящегоДокумента", ДанныеЭД.НомерДокумента);
	Шапка.Вставить("ДатаВходящегоДокумента",  ДанныеЭД.ДатаДокумента);
	Шапка.Вставить("Контрагент",              КонтрагентПоДаннымЭД(ДеревоДанных, "Отправитель"));
	
	Организация = ОрганизацияАктаСверкиПоДаннымЭД(ДеревоДанных, ОписаниеОшибки);
	Шапка.Вставить("Организация", Организация);
	
	Валюта = Справочники.Валюты.ПустаяСсылка();
	НайтиСсылкуНаОбъект("Валюты", Валюта, ДанныеЭД.КодВалюты);
	Шапка.Вставить("ВалютаДокумента", Валюта);
	Шапка.Вставить("ОстатокНаНачалоПоДаннымКонтрагента",
		ДанныеЭД.СведенияОтправителя.СальдоНаНачалоПериодаДебет - ДанныеЭД.СведенияОтправителя.СальдоНаНачалоПериодаКредит);
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		Шапка.Вставить("БезУчетаИФО", Истина);
	КонецЕсли;
	
	ТаблицаПоДаннымКонтрагента = Новый ТаблицаЗначений;
	Для Каждого Реквизит Из Метаданные.Документы.АктСверкиВзаиморасчетов.ТабличныеЧасти.ПоДаннымКонтрагента.Реквизиты Цикл
		ТаблицаПоДаннымКонтрагента.Колонки.Добавить(Реквизит.Имя, Реквизит.Тип);
	КонецЦикла;
	
	ТаблицаОстаткиПоДаннымКонтрагента = Новый ТаблицаЗначений;
	Для Каждого Реквизит Из Метаданные.Документы.АктСверкиВзаиморасчетов.ТабличныеЧасти.ОстаткиПоДаннымКонтрагента.Реквизиты Цикл
		ТаблицаОстаткиПоДаннымКонтрагента.Колонки.Добавить(Реквизит.Имя, Реквизит.Тип);
	КонецЦикла;
	
	УдалитьФиктивныеСтрокиВходящегоАктаСверкиЭД(ДанныеЭД.СведенияОтправителя.СведенияПоДоговорам);
	
	Для Каждого СтрокаДоговора Из ДанныеЭД.СведенияОтправителя.СведенияПоДоговорам Цикл
		
		Договор = ДоговорПоСтрокеАктаСверки(Шапка, СтрокаДоговора);
		
		ОстатокНаНачало = СтрокаДоговора.СальдоНаНачалоПериодаДебет - СтрокаДоговора.СальдоНаНачалоПериодаКредит;
		
		Для Каждого СтрокаДокумента Из СтрокаДоговора.СведенияПоДокументам Цикл
			Для Каждого СтрокаОперации Из СтрокаДокумента.СведенияПоОперациям Цикл
				
				СтрокаПоДаннымКонтрагента  = ТаблицаПоДаннымКонтрагента.Добавить();
				СтрокаПоДаннымКонтрагента.Договор = Договор;
				СтрокаПоДаннымКонтрагента.Дата = СтрокаОперации.ДатаОперации;
				СтрокаПоДаннымКонтрагента.НаименованиеОперации = СтрокаОперации.НаименованиеОперации;
				СтрокаПоДаннымКонтрагента.НаименованиеДокумента = СтрокаДокумента.НаименованиеДокумента;
				СтрокаПоДаннымКонтрагента.Дебет = СтрокаОперации.СуммаДебет;
				СтрокаПоДаннымКонтрагента.Кредит = СтрокаОперации.СуммаКредит;
				СтрокаПоДаннымКонтрагента.НомерДокумента = СтрокаДокумента.НомерДокумента;
				СтрокаПоДаннымКонтрагента.ДатаДокумента = СтрокаДокумента.ДатаДокумента;
				
			КонецЦикла;
		КонецЦикла;
		
		СтрокаОстаткиПоДаннымКонтрагента = ТаблицаОстаткиПоДаннымКонтрагента.Добавить();
		СтрокаОстаткиПоДаннымКонтрагента.Договор = Договор;
		СтрокаОстаткиПоДаннымКонтрагента.ОстатокНаНачало = ОстатокНаНачало;
		
	КонецЦикла;
	
	ДанныеДляЗаполнения = Новый Структура();
	ДанныеДляЗаполнения.Вставить("Шапка", Шапка);
	ДанныеДляЗаполнения.Вставить("ПоДаннымКонтрагента", ТаблицаПоДаннымКонтрагента);
	ДанныеДляЗаполнения.Вставить("ОстаткиПоДаннымКонтрагента", ТаблицаОстаткиПоДаннымКонтрагента);
	
	Возврат ДанныеДляЗаполнения;
	
КонецФункции

Процедура ЗаполнитьДокументАктСверкиВзаиморасчетовВходящий(СсылкаНаВладельца, ДанныеДляЗаполнения, ОписаниеОшибки)
	
	Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеЗаполненияШапки = ДанныеДляЗаполнения.Шапка;
	РежимЗаписи = РежимЗаписиДокумента.Запись;
	Записывать = Истина;

	Попытка
		Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
			ДокументОбъект = СсылкаНаВладельца.ПолучитьОбъект();
			Если ДокументОбъект.Проведен Тогда 
				Текст = НСтр("ru = 'Операция возможна только для непроведенных документов!'");
			КонецЕсли;
		Иначе
			УстановитьПривилегированныйРежим(Истина);
			ДокументОбъект = Документы.АктСверкиВзаиморасчетов.СоздатьДокумент();
			ДокументОбъект.Дата = ТекущаяДатаСеанса();
		КонецЕсли;
		
		ДокументОбъект.ПоДаннымОрганизации.Очистить();
		ДокументОбъект.ПоДаннымКонтрагента.Очистить();
		ДокументОбъект.Сверка.Очистить();
		ДокументОбъект.СписокОрганизаций.Очистить();
		ДокументОбъект.СписокСчетов.Очистить();
		
		ЗаполнитьЗначенияСвойств(ДокументОбъект, ДанныеЗаполненияШапки);
		ДокументОбъект.ОбменДанными.Загрузка = Истина;
		
		Документы.АктСверкиВзаиморасчетов.ЗаполнитьПолученныйАктСверкиПоДаннымУчетаЭДО(ДокументОбъект);
		
		Документы.АктСверкиВзаиморасчетов.ЗаполнитьПолученныйАктСверкиПоДаннымКонтрагентаЭДО(ДокументОбъект, ДанныеДляЗаполнения);
		
		Документы.АктСверкиВзаиморасчетов.СопоставитьДанныеОрганизацииИКонтрагента(ДокументОбъект);
		
		ДокументОбъект.СверкаСогласована = Не ДокументОбъект.ЕстьРасхождения;
		
		ДокументОбъект.ДополнительныеСвойства.Вставить("ПроцессыОбработкиДокументов_ЗаписатьБезПроверкиОбменДаннымиЗагрузка", Истина);
		Если Записывать Тогда
			Если НЕ ЗначениеЗаполнено(ДокументОбъект.Номер) Тогда
				ДокументОбъект.УстановитьНовыйНомер();
			КонецЕсли;
			ДокументОбъект.Записать(РежимЗаписи);
			СсылкаНаВладельца = ДокументОбъект.Ссылка;
		Иначе
			СсылкаНаВладельца = ДокументОбъект;
		КонецЕсли;
	Исключение
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Заполнение документа на основе ЭД. %1'"), Текст)
			+ Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ВыполнитьЗаписьСобытияПоЭДВЖурналРегистрации(ТекстСообщения,
			2, УровеньЖурналаРегистрации.Ошибка, ДокументОбъект.Метаданные(), СсылкаНаВладельца);
		ВызватьИсключение(Текст);
	КонецПопытки;

КонецПроцедуры

Функция ДоговорПоСтрокеАктаСверки(ДанныеДокумента, РеквизитыДоговора)
	
	Договор = Справочники.Договоры.ПустаяСсылка();
	
	НомерДоговора = РеквизитыДоговора.НомерДоговора;
	ДатаДоговора  = РеквизитыДоговора.ДатаДоговора;
	Владелец = ДанныеДокумента.Контрагент;
	Организация = ДанныеДокумента.Организация; 
	
	ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком;
	Если РеквизитыДоговора.ОписаниеДоговора = "С поставщиком" Тогда
		ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем;
	КонецЕсли;	
	
	ДополнительныеРеквизиты = Новый Структура("ВидДоговора, НомерДоговора, ДатаДоговора, Владелец, Организация, НаименованиеДоговора",
		ВидДоговора, НомерДоговора, ДатаДоговора, Владелец, Организация); 
	НайтиСсылкуНаОбъект("ДоговорыКонтрагентов", Договор, , ДополнительныеРеквизиты);
	
	Если НЕ ЗначениеЗаполнено(Договор) Тогда
		СоздатьДоговорПоРеквизитам(ДополнительныеРеквизиты, Договор);
	КонецЕсли;
	
	Возврат Договор;
	
КонецФункции

Процедура УстановитьДоговорКонтрагента(ДоговорКонтрагента, ВладелецДоговора, ОрганизацияДоговора, СписокВидовДоговора = Неопределено, ВалютаДокумента) Экспорт
	
	ВестиУчетПоДоговорам = Истина;

	ВалютыДляОтбора = Новый Массив;
	ВИностраннойВалюте = Ложь;
	ВалютаРегУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	Если ЗначениеЗаполнено(ВалютаДокумента) Тогда
		Если НЕ ВалютаДокумента = ВалютаРегУчета Тогда
			ВИностраннойВалюте = Истина;
		КонецЕсли;	
	КонецЕсли;	
	Если ВИностраннойВалюте Тогда
		ВалютыДляОтбора.Добавить(ВалютаДокумента);
	Иначе
		ВалютыДляОтбора.Добавить(ВалютаРегУчета);
		ВалютыДляОтбора.Добавить(Справочники.Валюты.ПустаяСсылка());
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 2
	|	ДоговорыКонтрагентов.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА ДоговорыКонтрагентов.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПоставщиком)
	|			ТОГДА 1
	|		КОГДА ДоговорыКонтрагентов.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПокупателем)
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Приоритет
	|ИЗ
	|	Справочник.Договоры КАК ДоговорыКонтрагентов
	|ГДЕ
	|	&ТекстФильтра
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет УБЫВ";
	
	//Не учитывается головная организация как в БП
	
	Запрос.УстановитьПараметр("ОрганизацияДоговора", ОрганизацияДоговора);
	Запрос.УстановитьПараметр("ВладелецДоговора", ВладелецДоговора);
	Запрос.УстановитьПараметр("ВалютыДляОтбора", ВалютыДляОтбора);
	ТекстФильтра = "ДоговорыКонтрагентов.Организация = &ОрганизацияДоговора
		|	И ДоговорыКонтрагентов.Владелец = &ВладелецДоговора";
	
	Если ВестиУчетПоДоговорам Тогда
		ТекстФильтра = ТекстФильтра + "
		| И ДоговорыКонтрагентов.ПометкаУдаления = ЛОЖЬ
		| И ДоговорыКонтрагентов.ДоговорЗакрыт = ЛОЖЬ";
	КонецЕсли;
	ТекстФильтра = ТекстФильтра + "
	| И ДоговорыКонтрагентов.ВалютаНоминала В (&ВалютыДляОтбора)";

	Если СписокВидовДоговора <> Неопределено Тогда
		ТекстФильтра = ТекстФильтра + " И ДоговорыКонтрагентов.ВидДоговора В (&СписокВидовДоговора)";
		Запрос.УстановитьПараметр("СписокВидовДоговора", СписокВидовДоговора);
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ТекстФильтра", ТекстФильтра);
	
	Запрос.Текст = ТекстЗапроса;
	Результат = Запрос.Выполнить();
	
	Если Не Результат.Пустой() Тогда
		
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		
		ДоговорКонтрагента = Выборка.Ссылка;		
	КонецЕсли;
	
КонецПроцедуры

Функция ПодготовитьСтруктуруДляАктСверкиВзаиморасчетовПолученОтветныйТитул(ДанныеДокумента, ОбъектыУчета)
	
	ДанныеДляЗаполнения = Новый Структура();
	
	Если ОбъектыУчета.Количество() = 0 Тогда
		Возврат ДанныеДляЗаполнения;
	КонецЕсли;
	Основание = ОбъектыУчета[0];
	Если Не ЗначениеЗаполнено(Основание) Тогда
		Возврат ДанныеДляЗаполнения;
	КонецЕсли;
	ПараметрыОснования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Основание, "ВалютаДокумента,Организация,Контрагент,ПоДаннымОрганизации,ОстатокНаНачало");
	
	ДеревоДанных = ДанныеДокумента.НовыйЭД.ЗначениеРеквизита;
	ДанныеЭД = ДанныеВходящегоЭД(ДеревоДанных);
	
	Шапка = Новый Структура;
	
	Если ДанныеЭД.ПризнакНаличияРазногласий Тогда
		Шапка.Вставить("СверкаСогласована", Ложь);
		Шапка.Вставить("ОстатокНаНачалоПоДаннымКонтрагента",
			ДанныеЭД.СведенияПолучателя.СальдоНаНачалоПериодаДебет - ДанныеЭД.СведенияПолучателя.СальдоНаНачалоПериодаКредит);
	Иначе
		Шапка.Вставить("СверкаСогласована", Истина);
		Шапка.Вставить("ОстатокНаНачалоПоДаннымКонтрагента", - ПараметрыОснования.ОстатокНаНачало);
		ТаблицаПоДаннымКонтрагента = Документы.АктСверкиВзаиморасчетов.ТаблицаПоДаннымКонтрагентаНаОсновеТаблицыПоДаннымОрганизации(
			ПараметрыОснования.ПоДаннымОрганизации.Выгрузить());
		ДанныеДляЗаполнения.Вставить("Шапка", Шапка);
		ДанныеДляЗаполнения.Вставить("ПоДаннымКонтрагента", ТаблицаПоДаннымКонтрагента);
		ДанныеДляЗаполнения.Вставить("Основание", Основание);
		
		Возврат ДанныеДляЗаполнения;
		
	КонецЕсли;
	
	ТаблицаПоДаннымКонтрагента = Новый ТаблицаЗначений;
	Для Каждого Реквизит Из Метаданные.Документы.АктСверкиВзаиморасчетов.ТабличныеЧасти.ПоДаннымКонтрагента.Реквизиты Цикл
		ТаблицаПоДаннымКонтрагента.Колонки.Добавить(Реквизит.Имя, Реквизит.Тип);
	КонецЦикла;
	
	УдалитьФиктивныеСтрокиВходящегоАктаСверкиЭД(ДанныеЭД.СведенияПолучателя.СведенияПоДоговорам);
	
	Для Каждого СтрокаДоговора Из ДанныеЭД.СведенияПолучателя.СведенияПоДоговорам Цикл
		Для Каждого СтрокаДокумента Из СтрокаДоговора.СведенияПоДокументам Цикл
			Для Каждого СтрокаОперации Из СтрокаДокумента.СведенияПоОперациям Цикл
				
				СтрокаПоДаннымКонтрагента  = ТаблицаПоДаннымКонтрагента.Добавить();
				СтрокаПоДаннымКонтрагента.Договор = ДоговорПоСтрокеАктаСверки(ПараметрыОснования, СтрокаДоговора);
				СтрокаПоДаннымКонтрагента.Дата = СтрокаОперации.ДатаОперации;
				СтрокаПоДаннымКонтрагента.НаименованиеОперации = СтрокаОперации.НаименованиеОперации;
				СтрокаПоДаннымКонтрагента.НаименованиеДокумента = СтрокаДокумента.НаименованиеДокумента;
				СтрокаПоДаннымКонтрагента.Дебет = СтрокаОперации.СуммаДебет;
				СтрокаПоДаннымКонтрагента.Кредит = СтрокаОперации.СуммаКредит;
				СтрокаПоДаннымКонтрагента.НомерДокумента = СтрокаДокумента.НомерДокумента;
				СтрокаПоДаннымКонтрагента.ДатаДокумента = СтрокаДокумента.ДатаДокумента;
				
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	ДанныеДляЗаполнения.Вставить("Шапка", Шапка);
	ДанныеДляЗаполнения.Вставить("ПоДаннымКонтрагента", ТаблицаПоДаннымКонтрагента);
	ДанныеДляЗаполнения.Вставить("Основание", Основание);
	
	Возврат ДанныеДляЗаполнения;
	
КонецФункции

Процедура ЗаполнитьДокументАктСверкиВзаиморасчетовИсходящийОтветнымТитулом(ДанныеДляЗаполнения)
	
	Если ДанныеДляЗаполнения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Текст = НСтр("ru = 'Возникли затруднения при заполнении акта сверки взаиморасчетов ответным титулом!'");
	
	Шапка = ДанныеДляЗаполнения.Шапка;
	РежимЗаписи = РежимЗаписиДокумента.Запись;
	СсылкаНаВладельца = ДанныеДляЗаполнения.Основание;
	ДокументОбъект = СсылкаНаВладельца.ПолучитьОбъект();
	Если ДокументОбъект.Проведен Тогда 
		РежимЗаписи = РежимЗаписиДокумента.Проведение;
	КонецЕсли;
	
	Записывать = Истина;
	Попытка
		
		ЗаполнитьЗначенияСвойств(ДокументОбъект, Шапка, "ОстатокНаНачалоПоДаннымКонтрагента,СверкаСогласована");
		ДокументОбъект.ПоДаннымКонтрагента.Загрузить(ДанныеДляЗаполнения.ПоДаннымКонтрагента); // Данные входящего электронного документа
		Документы.АктСверкиВзаиморасчетов.СопоставитьДанныеОрганизацииИКонтрагента(ДокументОбъект);
		
		ДокументОбъект.ДополнительныеСвойства.Вставить("ПроцессыОбработкиДокументов_ЗаписьБезПроверки", Истина);
		Если Записывать Тогда
			Если НЕ ЗначениеЗаполнено(ДокументОбъект.Номер) Тогда
				ДокументОбъект.УстановитьНовыйНомер();
			КонецЕсли;
			ДокументОбъект.Записать(РежимЗаписи);
			СсылкаНаВладельца = ДокументОбъект.Ссылка;
		Иначе
			СсылкаНаВладельца = ДокументОбъект;
		КонецЕсли;
	Исключение
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Заполнение документа на основе ЭД. %1'"), Текст)
			+ Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ВыполнитьЗаписьСобытияПоЭДВЖурналРегистрации(ТекстСообщения,
			2, УровеньЖурналаРегистрации.Ошибка, ДокументОбъект.Метаданные(), СсылкаНаВладельца);
		ВызватьИсключение(Текст);
	КонецПопытки;	
	
КонецПроцедуры

Функция ПолучитьОписаниеФиктивнойСтрокиДляПустогоАктаСверкиЭД()
	
	ОписаниеДоговора = Новый Структура();
	ОписаниеДоговора.Вставить("Наименование",	НСтр("ru='Договоры за период отсутствуют.'"));
	ОписаниеДоговора.Вставить("Номер",			"0");
	ОписаниеДоговора.Вставить("Дата",			'20000101');
	ОписаниеДоговора.Вставить("Идентификатор",	"0");
 	ОписаниеДоговора.Вставить("СальдоНачДт",	"0");
 	ОписаниеДоговора.Вставить("СальдоНачКт",	"0");
	ОписаниеДоговора.Вставить("ОборотДт",		"0");
 	ОписаниеДоговора.Вставить("ОборотКт",		"0");
 	ОписаниеДоговора.Вставить("СальдоКонДт",	"0");
 	ОписаниеДоговора.Вставить("СальдоКонКт",	"0");
	
	ОписаниеДокумента = Новый Структура();
	ОписаниеДокумента.Вставить("Наименование",	НСтр("ru='Документы за период отсутствуют.'"));
	ОписаниеДокумента.Вставить("Номер",			"0");
	ОписаниеДокумента.Вставить("Дата",			'20000101');
	ОписаниеДокумента.Вставить("Идентификатор",	"0");
	
	ОписаниеОперации = Новый Структура();
	ОписаниеОперации.Вставить("НомерСтроки",	"-1");
	ОписаниеОперации.Вставить("Дата",			'20000101');
	ОписаниеОперации.Вставить("Наименование",	НСтр("ru='Операции за период отсутствуют.'"));
	ОписаниеОперации.Вставить("СуммаДт",		"0");
	ОписаниеОперации.Вставить("СуммаКт",		"0");
	
	ОписаниеФиктивнойСтроки = Новый Структура();
	ОписаниеФиктивнойСтроки.Вставить("ОписаниеДоговора",	ОписаниеДоговора);
	ОписаниеФиктивнойСтроки.Вставить("ОписаниеДокумента",	ОписаниеДокумента);
	ОписаниеФиктивнойСтроки.Вставить("ОписаниеОперации",	ОписаниеОперации);
	
	Возврат ОписаниеФиктивнойСтроки;
	
КонецФункции

Процедура ДобавитьСтрокуФиктивнойОперацииДляПустогоАктаСверкиЭД(СведенияПоДоговорам)
	
	ОписаниеФиктивнойСтроки = ПолучитьОписаниеФиктивнойСтрокиДляПустогоАктаСверкиЭД();
	
	// Фиктивная операция
	
	СведенияПоОперациям = НовыйТаблицаСведенияПоОперациям();
	
	СтрокаПоОперации = СведенияПоОперациям.Добавить();
	
	СтрокаПоОперации.НомерСтроки			= ОписаниеФиктивнойСтроки.ОписаниеОперации.НомерСтроки;
	СтрокаПоОперации.ДатаОперации			= ОписаниеФиктивнойСтроки.ОписаниеОперации.Дата;
	СтрокаПоОперации.НаименованиеОперации	= ОписаниеФиктивнойСтроки.ОписаниеОперации.Наименование;
	СтрокаПоОперации.НомерСтроки			= 1;
	СтрокаПоОперации.ПорядковыйНомерСтроки	= 1;
	
	// Фиктивный документ
	
	СведенияПоДокументам = НовыйТаблицаСведенияПоДокументам();
	
	СтрокаПоДокументу = СведенияПоДокументам.Добавить();
	
	СтрокаПоДокументу.НаименованиеДокумента		= ОписаниеФиктивнойСтроки.ОписаниеДокумента.Наименование;
	СтрокаПоДокументу.НомерДокумента			= ОписаниеФиктивнойСтроки.ОписаниеДокумента.Номер;
	СтрокаПоДокументу.ДатаДокумента				= ОписаниеФиктивнойСтроки.ОписаниеДокумента.Дата;
	СтрокаПоДокументу.ИдентификаторДокумента	= ОписаниеФиктивнойСтроки.ОписаниеДокумента.Идентификатор;
	СтрокаПоДокументу.СведенияПоОперациям		= СведенияПоОперациям;
	
	// Фиктивный договор
	
	СтрокаПоДоговору = СведенияПоДоговорам.Добавить();
	
	СтрокаПоДоговору.ОписаниеДоговора		= ОписаниеФиктивнойСтроки.ОписаниеДоговора.Наименование;
	СтрокаПоДоговору.НомерДоговора			= ОписаниеФиктивнойСтроки.ОписаниеДоговора.Номер;
	СтрокаПоДоговору.ДатаДоговора			= ОписаниеФиктивнойСтроки.ОписаниеДоговора.Дата;
	СтрокаПоДоговору.ИдентификаторДоговора	= ОписаниеФиктивнойСтроки.ОписаниеДоговора.Идентификатор;
	СтрокаПоДоговору.СведенияПоДокументам	= СведенияПоДокументам;
	
КонецПроцедуры

Процедура ДобавитьСтрокуФиктивнойОперацииДляДоговораСОстаткамиАктСверкиЭД(СведенияПоДоговорам, Договор, ТаблицаОстатков, НомерСтрокиПоДоговору)
	
	// Итоги по указанному договору
	
	Итоги = Документы.АктСверкиВзаиморасчетов.ПолучитьПустыеИтогиПоДоговору();
	
	Поиск = Новый Структура("Договор", Договор);
	
	МассивСтрок = ТаблицаОстатков.НайтиСтроки(Поиск);
	
	СтрокаОстатков = МассивСтрок[0];
	
	ОстатокНаНачало = СтрокаОстатков.ОстатокНаНачало;
	
	Если ОстатокНаНачало > 0 Тогда
		Итоги.СальдоНаНачалоПериодаДебет = ОстатокНаНачало;
		Итоги.СальдоНаКонецПериодаДебет = ОстатокНаНачало;
	Иначе
		Итоги.СальдоНаНачалоПериодаКредит = -ОстатокНаНачало;
		Итоги.СальдоНаКонецПериодаКредит = -ОстатокНаНачало;
	КонецЕсли;
	
	ОписаниеФиктивнойСтроки = ПолучитьОписаниеФиктивнойСтрокиДляПустогоАктаСверкиЭД();
	
	// Фиктивная операция
	
	СведенияПоОперациям = НовыйТаблицаСведенияПоОперациям();
	
	СтрокаПоОперации = СведенияПоОперациям.Добавить();
	
	СтрокаПоОперации.НомерСтроки			= ОписаниеФиктивнойСтроки.ОписаниеОперации.НомерСтроки;
	СтрокаПоОперации.ДатаОперации			= ОписаниеФиктивнойСтроки.ОписаниеОперации.Дата;
	СтрокаПоОперации.НаименованиеОперации	= ОписаниеФиктивнойСтроки.ОписаниеОперации.Наименование;
	СтрокаПоОперации.НомерСтроки			= 1;
	СтрокаПоОперации.ПорядковыйНомерСтроки	= 1;
	
	// Фиктивный документ
	
	СведенияПоДокументам = НовыйТаблицаСведенияПоДокументам();
	
	СтрокаПоДокументу = СведенияПоДокументам.Добавить();
	
	СтрокаПоДокументу.НаименованиеДокумента		= ОписаниеФиктивнойСтроки.ОписаниеДокумента.Наименование;
	СтрокаПоДокументу.НомерДокумента			= ОписаниеФиктивнойСтроки.ОписаниеДокумента.Номер;
	СтрокаПоДокументу.ДатаДокумента				= ОписаниеФиктивнойСтроки.ОписаниеДокумента.Дата;
	СтрокаПоДокументу.ИдентификаторДокумента	= ОписаниеФиктивнойСтроки.ОписаниеДокумента.Идентификатор;
	СтрокаПоДокументу.СведенияПоОперациям		= СведенияПоОперациям;
	
	// Указанный договор
	
	СтрокаПоДоговору = СведенияПоДоговорам.Добавить();
	
	СтрокаПоДоговору.НомерСтроки			= НомерСтрокиПоДоговору;
	СтрокаПоДоговору.ОписаниеДоговора		= Строка(СтрокаОстатков.ВидДоговора);
	СтрокаПоДоговору.НомерДоговора			= СтрокаОстатков.НомерДоговора;
	СтрокаПоДоговору.ДатаДоговора			= СтрокаОстатков.ДатаДоговора;
	СтрокаПоДоговору.ИдентификаторДоговора	= Договор.УникальныйИдентификатор();
	СтрокаПоДоговору.СведенияПоДокументам	= СведенияПоДокументам;
	
	ЗаполнитьЗначенияСвойств(СтрокаПоДоговору, Итоги);
	
КонецПроцедуры

Процедура УдалитьФиктивныеСтрокиВходящегоАктаСверкиЭД(СведенияПоДоговорам)
	
	ОписаниеФиктивнойСтроки = ПолучитьОписаниеФиктивнойСтрокиДляПустогоАктаСверкиЭД();
	
	УдаляемыеСтрокиДоговоров = Новый Соответствие();
	
	Для Каждого СтрокаПоДоговору Из СведенияПоДоговорам Цикл
		
		ЭтоФиктивныйДоговор = СтрокаПоДоговору.НомерДоговора = ОписаниеФиктивнойСтроки.ОписаниеДоговора.Номер
			И СтрокаПоДоговору.ДатаДоговора = ОписаниеФиктивнойСтроки.ОписаниеДоговора.Дата
			И СтрокаПоДоговору.ОписаниеДоговора = ОписаниеФиктивнойСтроки.ОписаниеДоговора.Наименование;
			
		Если ЭтоФиктивныйДоговор Тогда
			УдаляемыеСтрокиДоговоров.Вставить(СтрокаПоДоговору, 0);
			
			Продолжить;
		КонецЕсли;
		
		УдаляемыеСтрокиДокументов = Новый Соответствие();
		
		Для Каждого СтрокаПоДокументу Из СтрокаПоДоговору.СведенияПоДокументам Цикл
			
			ЭтоФиктивныйДокумент = СтрокаПоДокументу.НаименованиеДокумента = ОписаниеФиктивнойСтроки.ОписаниеДокумента.Наименование
				И СтрокаПоДокументу.НомерДокумента = ОписаниеФиктивнойСтроки.ОписаниеДокумента.Номер
				И СтрокаПоДокументу.ДатаДокумента = ОписаниеФиктивнойСтроки.ОписаниеДокумента.Дата;
				
			Если ЭтоФиктивныйДокумент Тогда
				УдаляемыеСтрокиДокументов.Вставить(СтрокаПоДокументу, 0);
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого Элемент Из УдаляемыеСтрокиДокументов Цикл
			УдаляемаяСтрока = Элемент.Ключ;
			
			СтрокаПоДоговору.СведенияПоДокументам.Удалить(УдаляемаяСтрока);
		КонецЦикла;
		
	КонецЦикла;
	
	Для Каждого Элемент Из УдаляемыеСтрокиДоговоров Цикл
		УдаляемаяСтрока = Элемент.Ключ;
		
		СведенияПоДоговорам.Удалить(УдаляемаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьСписокДоговоровИзОстатковИОперацийАктСверкиЭД(РезультатыЗапросаОстатков, РезультатыЗапросаОпераций)
	
	ТаблицаСписокДоговоров = Новый ТаблицаЗначений();
	ТаблицаСписокДоговоров.Колонки.Добавить("Договор",		Новый ОписаниеТипов("СправочникСсылка.Договоры"));
	ТаблицаСписокДоговоров.Колонки.Добавить("ЕстьОстатки",	Новый ОписаниеТипов("Булево"));
	ТаблицаСписокДоговоров.Колонки.Добавить("ЕстьОбороты",	Новый ОписаниеТипов("Булево"));
	
	ВыборкаОстатков = РезультатыЗапросаОстатков.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаОстатков.Следующий() Цикл
		НоваяСтрока = ТаблицаСписокДоговоров.Добавить();
		НоваяСтрока.Договор = ВыборкаОстатков.Договор;
		НоваяСтрока.ЕстьОстатки = Истина;
	КонецЦикла;
	
	ВыборкаОпераций = РезультатыЗапросаОпераций.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Поиск = Новый Структура("Договор");
	
	Пока ВыборкаОпераций.Следующий() Цикл
		Договор = ВыборкаОпераций.Договор;
		
		Поиск.Договор = Договор;
		
		МассивСтрок = ТаблицаСписокДоговоров.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() = 0 Тогда
			СтрокаТаблицы = ТаблицаСписокДоговоров.Добавить();
			СтрокаТаблицы.Договор = Договор;
		Иначе
			СтрокаТаблицы = МассивСтрок[0];
		КонецЕсли;
		
		СтрокаТаблицы.ЕстьОбороты = Истина;
	КонецЦикла;
	
	Возврат ТаблицаСписокДоговоров;
	
КонецФункции

Процедура ЗаполнитьСведенияПоДоговорамАктСверкиЭД(СведенияПоДоговорам, РезультатыЗапросаОстатков, РезультатыЗапросаОпераций)
	
	// Одинаковая процедура и для информации отправителя, и для информации получателя.
	
	СписокДоговоров = ПолучитьСписокДоговоровИзОстатковИОперацийАктСверкиЭД(РезультатыЗапросаОстатков, РезультатыЗапросаОпераций);
	
	Если СписокДоговоров.Количество() = 0 Тогда
		// Ни операций, ни остаков по договорам нет. Акт сверки пустой.
		ДобавитьСтрокуФиктивнойОперацииДляПустогоАктаСверкиЭД(СведенияПоДоговорам);
		
		Возврат;
	КонецЕсли;
	
	ТаблицаОстатков = РезультатыЗапросаОстатков.Выгрузить();
	
	ВыборкаПоДоговорам = РезультатыЗапросаОпераций.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ПоискДоговора = Новый Структура("Договор");
	
	НомерСтрокиПоДоговору = 0;
	
	Для Каждого СтрокаДоговора Из СписокДоговоров Цикл
		НомерСтрокиПоДоговору = НомерСтрокиПоДоговору + 1;
		
		Договор = СтрокаДоговора.Договор;
		
		Если СтрокаДоговора.ЕстьОбороты Тогда
			ПоискДоговора.Договор = Договор;
			
			// Выборка по операциям.
			ВыборкаПоДоговорам.Сбросить();
			ВыборкаПоДоговорам.НайтиСледующий(ПоискДоговора);
			
			СтрокаПоДоговору = СведенияПоДоговорам.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаПоДоговору, ВыборкаПоДоговорам);
			СтрокаПоДоговору.НомерСтроки = НомерСтрокиПоДоговору;
			СтрокаПоДоговору.ОписаниеДоговора = Строка(ВыборкаПоДоговорам.ВидДоговора);
			
			ТаблицаПоДокументам = НовыйТаблицаСведенияПоДокументам();
			СтрокаПоДоговору.СведенияПоДокументам = ТаблицаПоДокументам;
			
			ВыборкаПоДокументам = ВыборкаПоДоговорам.Выбрать();
			НомерСтрокиПоДокументам = 0;
			Пока ВыборкаПоДокументам.Следующий() Цикл

				НомерСтрокиПоДокументам = НомерСтрокиПоДокументам + 1;
				
				СтрокаПоДокументу = ТаблицаПоДокументам.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаПоДокументу, ВыборкаПоДокументам);
				СтрокаПоДокументу.НомерСтроки = НомерСтрокиПоДокументам;
				
				ТаблицаПоОперациям = НовыйТаблицаСведенияПоОперациям();
				СтрокаПоДокументу.СведенияПоОперациям = ТаблицаПоОперациям;
				
				Если ЗначениеЗаполнено(ВыборкаПоДокументам.Документ) Тогда
					СтрокаПоДокументу.ИдентификаторДокумента = ВыборкаПоДокументам.Документ.УникальныйИдентификатор();
				КонецЕсли;
				
				СтрокаПоОперациям = ТаблицаПоОперациям.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаПоОперациям, ВыборкаПоДокументам);
				СтрокаПоОперациям.НомерСтроки = 1;
				СтрокаПоОперациям.ПорядковыйНомерСтроки = 1;
				
			КонецЦикла;
			
			Документы.АктСверкиВзаиморасчетов.ЗаполнитьИтогиПоДоговоруЭДО(СтрокаПоДоговору, ТаблицаОстатков, Договор);
			СтрокаПоДоговору.ИдентификаторДоговора = Договор.УникальныйИдентификатор();
		Иначе
			// По договору нет операций, но есть остатки.
			ДобавитьСтрокуФиктивнойОперацииДляДоговораСОстаткамиАктСверкиЭД(СведенияПоДоговорам, Договор, ТаблицаОстатков, НомерСтрокиПоДоговору);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ОрганизацияАктаСверкиПоДаннымЭД(Знач ДеревоДанных, ОписаниеОшибки = "")
	
	// Тип участника для организации может быть только "ЮЛ".
	
	ИНН = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "Получатель.ТипУчастника.ЮЛ.ИНН");
	КПП = ЭлектронноеВзаимодействие.ЗначениеРеквизитаВДереве(ДеревоДанных, "Получатель.ТипУчастника.ЮЛ.КПП");
	
	Организация = Неопределено;
		
	СсылкаНаОбъектПоИННКПП("Организации", ИНН, КПП, Организация);
	
	// Если организация не найдена, то вызываем исключение и не создаем документ ИБ на основании ЭД.
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Если ЗначениеЗаполнено(КПП) Тогда
			Шаблон = НСтр("ru = 'Не удалось создать документ, организация с ИНН/КПП %1/%2 не найдена'");
			ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, ИНН, КПП);
		Иначе
			Шаблон = НСтр("ru = 'Не удалось создать документ, организация с ИНН %1 не найдена'");
			ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, ИНН);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Организация;
	
КонецФункции

#КонецОбласти

// Удаляет из массива ссылки на объекты, к которым у пользователя нет доступа
// Параметры:
//  МассивСсылок  - Массив - массив ссылок, из которого надо удалить те, к которым нет доступа
//
Процедура УдалитьНедоступныеЭлементыИзМассива(МассивСсылок) Экспорт
	
	Запрос = Новый Запрос;
	ОбъектыПоТипам = Новый Соответствие;
	
	Если Пользователи.ЭтоПолноправныйПользователь() Тогда
		Возврат;
	КонецЕсли;
	
	// Исключим из массива объекты  на чтение которых у пользователя нет прав по ролям.
	Для каждого Ссылка Из МассивСсылок Цикл
		Если ЗначениеЗаполнено(Ссылка) И ПравоДоступа("Чтение", Ссылка.Метаданные()) Тогда
			СсылкиЭтогоТипа = ОбъектыПоТипам[Ссылка.Метаданные()];
			Если СсылкиЭтогоТипа = Неопределено Тогда
				СсылкиЭтогоТипа = Новый Массив;
				ОбъектыПоТипам.Вставить(Ссылка.Метаданные(), СсылкиЭтогоТипа);
			КонецЕсли;
			СсылкиЭтогоТипа.Добавить(Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	Если ОбъектыПоТипам.Количество() = 0 Тогда
		// Все ссылки не доступны, вернем пустой массив.
		МассивСсылок = Новый Массив;
		Возврат;
	КонецЕсли;
	
	// С помощью запроса определим объекты, разрешенные по RLS.
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.ПакетЗапросов[0].ВыбиратьРазрешенные = Истина;
	Индекс = 0;
	Для каждого Объекты Из ОбъектыПоТипам Цикл
		
		Если Индекс = 0 Тогда
			// Оператор с индексом [0] создается конструктором схемы запроса всегда.
			Оператор = СхемаЗапроса.ПакетЗапросов[0].Операторы[0];
		Иначе
			Оператор = СхемаЗапроса.ПакетЗапросов[0].Операторы.Добавить();
		КонецЕсли;
		
		ИмяПараметра = СтрШаблон("МассивОбъектов_%1", Формат(Индекс + 1, "ЧГ=0"));
		
		Оператор.ВыбиратьРазличные = Истина;
		Оператор.Источники.Добавить(Объекты.Ключ.ПолноеИмя());
		Оператор.ВыбираемыеПоля.Добавить("Ссылка");
		Оператор.Отбор.Добавить(СтрШаблон("Ссылка В(&%1)", ИмяПараметра));
		
		Запрос.УстановитьПараметр(ИмяПараметра, Объекты.Значение);
		Индекс = Индекс + 1;
		
	КонецЦикла;
	
	Запрос.Текст = СхемаЗапроса.ПолучитьТекстЗапроса();
	
	ДопустимыеЗначения = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	// Ограничим исходную коллекцию только допустимыми значениями, через сокращение исходного массива чтобы сохранить порядок элементов.
	НедопустимыеЗначения = ОбщегоНазначенияКлиентСервер.РазностьМассивов(МассивСсылок, ДопустимыеЗначения);
	МассивСсылок         = ОбщегоНазначенияКлиентСервер.РазностьМассивов(МассивСсылок, НедопустимыеЗначения);
	
КонецПроцедуры

#Область СчетНаОплату101

// Подготавливает данные для электронного документа вида "Счет на оплату"
//
// Параметры:
//  Основание - ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО - основание для электронного документа.
//  Настройки - ФиксированнаяСтруктура - настройки заполнения данных:
//   * ТипДокумента - Произвольный - ожидаемый вид документа. Доступные значения представлены следующими свойствами
//                                   результата функции см. ОбменСКонтрагентами.ТипыДокументов:
//                                    - СчетНаОплату.
//  Данные - ДеревоЗначений - данные для заполнения электронного документа. Строится по макету 
//                            см. Обработка.ОбменСКонтрагентами.Макет.СчетНаОплату101. Выходной параметр.
//  Описание - Структура - дополнительная информация о документе. Выходной параметр.
//   * Основания - Массив из ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО - ссылки на дополнительные объекты-основания
//                 электронного документа помимо указанного в параметре "Основание".
//  Отказ - Булево - признак отказа от дальнейшего формирования электронного документа.
//                   Информационное сообщение пользователю необходимо формировать самостоятельно.
//
Процедура ЗаполнитьДанныеПоСчетуНаОплату101(Основание, Настройки, Данные, Описание, Отказ) Экспорт
	
	СсылкаНаОбъект = Основание;
	ДеревоДокумента = Данные;
	
	НетЗамечанийКДокументу = Документы.СчетНаОплату.ПредварительныйКонтрольДанныхДляЭД(СсылкаНаОбъект, "ФНС101");
	
	Если НЕ НетЗамечанийКДокументу Тогда
		ОписаниеОшибки = НСтр("ru='Вышеуказанные ошибки препятствуют формированию электронного документа.
		|По этой причине и прочие данные документа не будут выгружены в ЭД.
		|После заполнения указанных реквизитов повторите попытку формирования электронного документа.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки);
		Отказ = Истина;
		Возврат;
	КонецЕсли;	
	
	ДанныеДокИБ = Документы.СчетНаОплату.ПодготовитьДанныеДляЭД(СсылкаНаОбъект, "ФНС101");
	РеквизитыШапки = ДанныеДокИБ[0].Выбрать();
	ТабличнаяЧасть = ДанныеДокИБ[1].Выгрузить();
	ДобавитьИДНоменклатурыВТаблицу(ТабличнаяЧасть);
	
	РеквизитыШапки.Следующий();

	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "Функция", РеквизитыШапки.Функция);
	
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "НомерДокумента", НомерДляПечати(СсылкаНаОбъект, РеквизитыШапки.Номер));
	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "ДатаДокумента", РеквизитыШапки.Дата);

	//Продавец
	ЗаполнитьДанныеУчастникаСчетаНаОплатуДляФорматаФНС_1_01(РеквизитыШапки.Продавец, "Продавец", РеквизитыШапки.Дата, ДеревоДокумента, 
		РеквизитыШапки.ЛицевойСчетПродавца, РеквизитыШапки.РеквизитыЛицевогоСчетаПродавца, , РеквизитыШапки.ПодразделениеПродавца);
	
	//ПолучательДенежныхСредств
	НаименованиеПолучателяПлатежа = "";
	Если ЗначениеЗаполнено(РеквизитыШапки.ПолучательДенежныхСредств) Тогда
		ЗаполнитьДанныеУчастникаСчетаНаОплатуДляФорматаФНС_1_01(РеквизитыШапки.ПолучательДенежныхСредств, "ПолучательДенежныхСредств", РеквизитыШапки.Дата, ДеревоДокумента,
								РеквизитыШапки.ЛицевойСчетПолучателяДенежныхСредств, РеквизитыШапки.РеквизитыЛицевогоСчетаПолучателяДенежныхСредств,,,НаименованиеПолучателяПлатежа);
	Иначе
		ЗаполнитьДанныеУчастникаСчетаНаОплатуДляФорматаФНС_1_01(РеквизитыШапки.Продавец, "ПолучательДенежныхСредств", РеквизитыШапки.Дата, ДеревоДокумента, 
								РеквизитыШапки.ЛицевойСчетПродавца, РеквизитыШапки.РеквизитыЛицевогоСчетаПродавца,,,НаименованиеПолучателяПлатежа);
	КонецЕсли;
	
	//Плательщик
	Если ЗначениеЗаполнено(РеквизитыШапки.СчетПлательщика) Тогда
		ЗаполнитьДанныеУчастникаСчетаНаОплатуДляФорматаФНС_1_01(РеквизитыШапки.Плательщик, "Плательщик", РеквизитыШапки.Дата, ДеревоДокумента, 
							РеквизитыШапки.СчетПлательщика, );
	Иначе
	 	ПлательщикГоловнаяОрганизация = Справочники.Контрагенты.ПустаяСсылка();
		Если РеквизитыШапки.ПлательщикОбособленноеПодразделение И ЗначениеЗаполнено(РеквизитыШапки.ПлательщикГоловнаяОрганизация) Тогда
			ПлательщикГоловнаяОрганизация = РеквизитыШапки.ПлательщикГоловнаяОрганизация;
		КонецЕсли;
		
		ЗаполнитьДанныеУчастникаСчетаНаОплатуДляФорматаФНС_1_01(РеквизитыШапки.Плательщик, "Плательщик", РеквизитыШапки.Дата, ДеревоДокумента, 
							, ПлательщикГоловнаяОрганизация);
	КонецЕсли;
							
	//Покупатель
	ЗаполнитьДанныеУчастникаСчетаНаОплатуДляФорматаФНС_1_01(РеквизитыШапки.Покупатель, "Покупатель", РеквизитыШапки.Дата, ДеревоДокумента,,);
	
	//Грузоотправитель
	Если ЗначениеЗаполнено(РеквизитыШапки.Грузоотправитель) Тогда
		ЗаполнитьДанныеУчастникаСчетаНаОплатуДляФорматаФНС_1_01(РеквизитыШапки.Грузоотправитель, "Грузоотправитель", РеквизитыШапки.Дата, ДеревоДокумента,,);
	КонецЕсли;
	
	//Грузополучатель
	Если ЗначениеЗаполнено(РеквизитыШапки.Грузополучатель) Тогда
		ЗаполнитьДанныеУчастникаСчетаНаОплатуДляФорматаФНС_1_01(РеквизитыШапки.Грузополучатель, "Грузополучатель", РеквизитыШапки.Дата, ДеревоДокумента,,);
	КонецЕсли;
	
	ВсегоНаименований = ТабличнаяЧасть.Количество();
 	ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДокумента, "ВсегоНаименований", ВсегоНаименований);
	
	// Основание
	Если ЗначениеЗаполнено(РеквизитыШапки.Договор) Тогда
		ДанныеДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыШапки.Договор, "ВидОбязательства, НомерДоговора, ДатаДоговора");
		ТаблицаДанныхДоговора = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ДеревоДокумента, "Основания");
		СтрокаДанныхДоговора = ТаблицаДанныхДоговора.Добавить();
		СтрокаДанныхДоговора.Наименование = ДанныеДоговора.ВидОбязательства;
		СтрокаДанныхДоговора.Номер = ?(ЗначениеЗаполнено(ДанныеДоговора.НомерДоговора), ДанныеДоговора.НомерДоговора, "Без номера");
		СтрокаДанныхДоговора.Дата = ДанныеДоговора.ДатаДоговора;
		СтрокаДанныхДоговора.ИдентификаторГосКонтракта = РеквизитыШапки.ИдентификаторГосКонтракта;
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДокумента, ТаблицаДанныхДоговора, "Основания");
	КонецЕсли;
	
	// Таблица документа
	НДСУчтеноВСумме = РеквизитыШапки.СуммаВключаетНДС;
	ДокументБезНДС = Истина;
	ИтогоСуммаНДС = 0;
	ТаблицаТоваров = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ДеревоДокумента, "ТаблицаТоваров");
	Для Каждого ТекСтрока Из ТабличнаяЧасть Цикл
		СтрокаТоваров = ТаблицаТоваров.Добавить();
		СтрокаТоваров.Наименование                 	= ТекСтрока.Наименование;
		Если ЗначениеЗаполнено(ТекСтрока.Содержание) Тогда
			СтрокаТоваров.Наименование = ТекСтрока.Содержание;
		КонецЕсли;
		
		СтрокаТоваров.Количество                   	= ТекСтрока.Количество;
		СтрокаТоваров.КодЕдиницыИзмерения          	= СокрЛП(ТекСтрока.БазоваяЕдиницаКод);
		СтрокаТоваров.НаименованиеЕдиницыИзмерения 	= СокрЛП(ТекСтрока.БазоваяЕдиницаНаименование);
		
		СтрокаТоваров.ЦенаЗаЕдиницуИзмерения		= ТекСтрока.Цена;
		СтрокаТоваров.СтавкаНДС          			= ИнтеграцияЭДОПовтИсп.СтавкаНДСПеречисление(ТекСтрока.СтавкаНДС);
		СтрокаТоваров.СтоимостьБезНДС 				= ТекСтрока.Всего - ТекСтрока.СуммаНДС;
		СтрокаТоваров.СтоимостьСНДС 				= ТекСтрока.Всего;
		
		СтрокаТоваров.СуммаСкидки 					= ТекСтрока.Скидка;
		СтрокаТоваров.ЦенаБезСкидки 				= ТекСтрока.ЦенаБезСкидок;
		СуммаНДС = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
			ДеревоДокумента, "ТаблицаТоваров.НомерСтроки.СуммаНДС");
		Если ТекСтрока.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС Тогда
			СуммаНДС.Вставить("БезНДС", "без НДС");
		Иначе	
			СуммаНДС.Вставить("СуммаНалога", ТекСтрока.СуммаНДС);
		КонецЕсли;
		СтрокаТоваров.СуммаНДС = СуммаНДС;
		ИтогоСуммаНДС = ИтогоСуммаНДС + ТекСтрока.СуммаНДС;	
		
		СуммаНДСБезСкидки = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
			ДеревоДокумента, "ТаблицаТоваров.НомерСтроки.СуммаНДСБезСкидки");
		Если ТекСтрока.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС Тогда
			СуммаНДСБезСкидки.Вставить("БезНДС", "без НДС");
		Иначе
			СуммаНДСБезСкидки.Вставить("СуммаНалога", ТекСтрока.СуммаНДС);
		КонецЕсли;	
		СтрокаТоваров.СуммаНДСБезСкидки = СуммаНДСБезСкидки;
		
		СтрокаТоваров.СтоимостьБезНДСБезСкидки		= ТекСтрока.Всего - ТекСтрока.СуммаНДС;
		СтрокаТоваров.СтоимостьСНДСБезСкидки		= ТекСтрока.Всего;

		Если РеквизитыШапки.НеЗаполнятьЦеныВЭлектронномДокументе Тогда
			СтрокаТоваров.ЦенаЗаЕдиницуИзмерения = 0;
			СтрокаТоваров.ЦенаБезСкидки = 0;
		КонецЕсли;	
		
		ДополнительныеСведения = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(
			ДеревоДокумента, "ТаблицаТоваров.НомерСтроки.ДополнительныеСведения");
		ДополнительныеСведения.Признак = ТекСтрока.Признак;
		ДополнительныеСведения.АртикулТовара = СокрЛП(ТекСтрока.Артикул);
		ДополнительныеСведения.КодТовара = СокрЛП(ТекСтрока.КодТовара);
		ДополнительныеСведения.КодКаталога = СокрЛП(ТекСтрока.КодКаталога);
		ДополнительныеСведения.КодВидаТовара = СокрЛП(ТекСтрока.КодВидаТовара);
		
		Если ЗначениеЗаполнено(ТекСтрока.СтранаПроисхождения) Тогда
			СтранаПроисхождения = ТекСтрока.СтранаПроисхождения;
		Иначе
			СтранаПроисхождения = Справочники.СтраныМира.Россия;
		КонецЕсли;	
		
		ДанныеСтраны = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтранаПроисхождения, "Код, Наименование");
		
		ДополнительныеСведения.КодСтраныПроисхождения = СокрЛП(ДанныеСтраны.Код);
		ДополнительныеСведения.НаименованиеСтраныПроисхождения = ДанныеСтраны.Наименование; 
		
		СтрокаТоваров.ДополнительныеСведения = ДополнительныеСведения;

		//	Сопоставление	
		//		Идентификатор
		//		Наименование
		//		Характеристика
		//		ЕдиницаИзмерения
		//		ЕдиницаИзмеренияКод
		//		Артикул
		//		СтавкаНДС
		//		Штрихкод
		//		НоменклатураИБ
		//		ХарактеристикаИБ
		//		УпаковкаИБ	
		
		Сопоставление = Новый Структура();
		
		Сопоставление.Вставить("Наименование",			СтрокаТоваров.Наименование);
		Сопоставление.Вставить("ЕдиницаИзмерения",		СтрокаТоваров.НаименованиеЕдиницыИзмерения);
		Сопоставление.Вставить("ЕдиницаИзмеренияКод",	СтрокаТоваров.КодЕдиницыИзмерения);
		Сопоставление.Вставить("НоменклатураИБ",		ТекСтрока.Номенклатура);
		
		СтрокаТоваров.Сопоставление = Сопоставление;
	КонецЦикла;
	ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДокумента, ТаблицаТоваров, "ТаблицаТоваров");
	
	// Всего к оплате.
	ВсегоКОплате = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ДеревоДокумента, "ВсегоКОплате");
	ВсегоКОплате.СтоимостьБезНДС = ТабличнаяЧасть.Итог("Всего") - ТабличнаяЧасть.Итог("СуммаНДС");
	ВсегоКОплате.СтоимостьСНДС = ТабличнаяЧасть.Итог("Всего");
	ВсегоКОплате.Количество = ТабличнаяЧасть.Итог("Количество");
	ВсегоКОплате.СуммаСкидки = ТабличнаяЧасть.Итог("Скидка");
	Если ИтогоСуммаНДС > 0 Тогда
		ВсегоКОплате.СуммаНалога.Вставить("СуммаНалога", ИтогоСуммаНДС); 
	Иначе
		ВсегоКОплате.СуммаНалога.Вставить("СуммаНалога", ИтогоСуммаНДС); 
		ВсегоКОплате.СуммаНалога.Вставить("БезНДС", "без НДС"); 
	КонецЕсли;
	ЭлектронноеВзаимодействие.ЗагрузитьСтруктуруВГруппуДерева(ДеревоДокумента, ВсегоКОплате, "ВсегоКОплате");
	
	// Денежная единица
	ДанныеВалюты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыШапки.Валюта, "Код, Наименование");
	
	ДенежнаяЕдиница = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ДеревоДокумента, "ДенежнаяЕдиница");
	ДенежнаяЕдиница.КодВалюты          = СокрЛП(ДанныеВалюты.Код);
	ДенежнаяЕдиница.НаименованиеВалюты = СокрЛП(ДанныеВалюты.Наименование);
	ДенежнаяЕдиница.КурсВалюты         = РеквизитыШапки.Курс;
	Если ИтогоСуммаНДС > 0 Тогда
		ДенежнаяЕдиница.СуммаНалога.Вставить("СуммаНалога", ИтогоСуммаНДС); 
	Иначе
		ДенежнаяЕдиница.СуммаНалога.Вставить("СуммаНалога", ИтогоСуммаНДС); 
		ДенежнаяЕдиница.СуммаНалога.Вставить("БезНДС", "без НДС"); 
	КонецЕсли;
	
	ЭлектронноеВзаимодействие.ЗагрузитьСтруктуруВГруппуДерева(ДеревоДокумента, ДенежнаяЕдиница, "ДенежнаяЕдиница");
	
	// Дополнительные сведения
	ДополнительныеСведения = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ДеревоДокумента, "ДополнительныеСведения");
	
	ДополнительныеСведения.ОграничениеПоДатеОплаты = РеквизитыШапки.СрокОплаты;
	ДополнительныеСведения.НазначениеПлатежа = РеквизитыШапки.НазначениеПлатежа;
	
	ЭлектронноеВзаимодействие.ЗагрузитьСтруктуруВГруппуДерева(ДеревоДокумента, ДополнительныеСведения, "ДополнительныеСведения");
	
КонецПроцедуры

//См. ОбменСКонтрагентамиПереопределяемый.ПриОтраженииВУчетеДокументаСчетНаОплату101
Процедура ПриОтраженииВУчетеДокументаСчетНаОплату101(РезультатОтраженияВУчете, Знач ДанныеЭлектронногоДокумента,
	Знач ПараметрыДляОтраженияВУчете) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	Записывать = Истина;
	Данные = Новый Структура;
	Для каждого СтрокаДерева Из ДанныеЭлектронногоДокумента.Строки Цикл
		Путь = СтрокаДерева.ПолныйПуть;
		ДанныеСтроки = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ДанныеЭлектронногоДокумента, Путь);
		Данные.Вставить(Путь, ДанныеСтроки);
	КонецЦикла;
	
	РежимЗаписи = РежимЗаписиДокумента.Запись;
	СсылкаНаВладельца = РезультатОтраженияВУчете.ДокументыУчета[0];
	Попытка
		Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
			ДокументОбъект = СсылкаНаВладельца.ПолучитьОбъект();
			Если ДокументОбъект.Проведен Тогда
				Текст = НСтр("ru = 'Операция возможна только для непроведенных документов!'");
			КонецЕсли;
		Иначе
			ДокументОбъект = Документы.СчетНаОплатуОтПоставщика.СоздатьДокумент();
			ДокументОбъект.Дата = ТекущаяДатаСеанса();
			ДокументОбъект.Ответственный = Пользователи.ТекущийПользователь();
		КонецЕсли;
		
		ДокументОбъект.ТипФорматаЭД = 2;
		
		// Шапка.	
		ДокументОбъект.Организация = ОрганизацияПоДаннымЭД(ДанныеЭлектронногоДокумента, "Покупатель");
		ДокументОбъект.Контрагент  = КонтрагентПоДаннымЭД(ДанныеЭлектронногоДокумента, "Продавец");

		//Договор
		Основания = Данные.Основания;
		Если Основания.Количество() > 0 Тогда
			Договор = Справочники.Договоры.ПустаяСсылка();
			
			НомерДоговора = Основания[0].Номер;
			ДатаДоговора = Основания[0].Дата;
			
			Владелец = ДокументОбъект.Контрагент;
			Если  ЗначениеЗаполнено(Владелец) Тогда
				ДополнительныеРеквизиты = Новый Структура("НомерДоговора, ДатаДоговора, Владелец, Организация",
					НомерДоговора, ДатаДоговора, Владелец, ДокументОбъект.Организация); 
				НайтиСсылкуНаОбъект("ДоговорыКонтрагентов", Договор, , ДополнительныеРеквизиты);
			КонецЕсли;
			
			ДокументОбъект.Договор = Договор;
			ДокументОбъект.ИдентификаторГосКонтракта = Основания[0].ИдентификаторГосКонтракта;
		КонецЕсли;	
		
		ДокументОбъект.ПолучательДенежныхСредств = КонтрагентПоДаннымЭД(ДанныеЭлектронногоДокумента, "ПолучательДенежныхСредств");
		ДокументОбъект.Плательщик  = КонтрагентПоДаннымЭД(ДанныеЭлектронногоДокумента, "Плательщик");
		
		ДокументОбъект.Грузоотправитель = КонтрагентПоДаннымЭД(ДанныеЭлектронногоДокумента, "Грузоотправитель");
		ДокументОбъект.Грузополучатель  = КонтрагентПоДаннымЭД(ДанныеЭлектронногоДокумента, "Грузополучатель");
		
		ДокументОбъект.ВидПервичногоДокумента = "Счет на оплату";
		ДокументОбъект.НомерПервичногоДокумента = Данные.НомерДокумента;
		ДокументОбъект.ДатаПервичногоДокумента = Данные.ДатаДокумента;
		
		ДокументОбъект.ВалютаДокумента = ОбщегоНазначенияБЭД.НайтиСсылку("Валюты", Данные.ДенежнаяЕдиница.КодВалюты);
		Если Не ЗначениеЗаполнено(ДокументОбъект.ВалютаДокумента) Тогда
			ДокументОбъект.ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
		КонецЕсли;	
		
		ДокументОбъект.СуммаДокумента = Данные.ВсегоКОплате.СтоимостьСНДС;
		Если Данные.ВсегоКОплате.СуммаНалога.СуммаНалога > 0 Тогда
			ДокументОбъект.СуммаНалогаИтог = Данные.ВсегоКОплате.СуммаНалога.СуммаНалога;
			ДокументОбъект.ЦенаВключаетНДС = Истина;
		КонецЕсли;	
		
		ДополнительныеСведения = Данные.ДополнительныеСведения;
		ДокументОбъект.СрокОплаты = ДополнительныеСведения.ОграничениеПоДатеОплаты;
		ДокументОбъект.НазначениеПлатежа = ДополнительныеСведения.НазначениеПлатежа;
		
		ДокументОбъект.ОбменДанными.Загрузка = Истина;
		ДокументОбъект.ДополнительныеСвойства.Вставить("ЕстьСоглашение", Истина);
		ДокументОбъект.ДополнительныеСвойства.Вставить("ПроцессыОбработкиДокументов_ЗаписатьБезПроверкиОбменДаннымиЗагрузка", Истина);
		Если Записывать Тогда
			Если НЕ ЗначениеЗаполнено(ДокументОбъект.Номер) Тогда
				ДокументОбъект.УстановитьНовыйНомер();
			КонецЕсли;
			ДокументОбъект.Записать(РежимЗаписи);
			СсылкаНаВладельца = ДокументОбъект.Ссылка;
		Иначе // если функция вызвана из формы "Обработки.ЭлектронныеДокументы.ФормаЗагрузкиПросмотраЭД"
			СсылкаНаВладельца = ДокументОбъект;
		КонецЕсли;

		РезультатОтраженияВУчете.ДокументыУчета = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СсылкаНаВладельца);
	Исключение
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Заполнение документа на основе ЭД. %1'"), Текст);
		ЗаписьЖурналаРегистрации(ТекстСообщения, УровеньЖурналаРегистрации.Ошибка, ДокументОбъект.Метаданные(), СсылкаНаВладельца,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение(Текст);
	КонецПопытки;
	
КонецПроцедуры

// Поиск и создание учетного документа при отражении в учете документа Счет на оплату.
// Тестовый формат ФНС.
//
// Параметры:
//  ДеревоДанных		 - ДеревоЗначений - данные электронного документа в виде заполненного макета 
//                         см. Обработка.ОбменСКонтрагентами.Макет.СчетНаОплату_1_01.
//  СсылкаНаВладельца     - ОпределяемыйТип.ОснованияЭлектронныхДокументовЭДО - ссылка на документ учета, если он уже
//                         прикреплен к электронному документу.
//  СпособОбработки		 - Строка - способ сохранения данных в информационной базе, выбранный пользователем. Передается 
//                         значение элемента списка значений, заданного в см. ОбменСКонтрагентамиПереопределяемый.СписокОперацийТипаЭД
//  ОписаниеОшибки       - Строка - описание ошибки создания учетного документа. Может быть выведена пользователю.
//
Процедура НайтиСоздатьСчетНаОплату101(ДеревоДанных, СсылкаНаВладельца = Неопределено, СпособОбработки = "", ОписаниеОшибки = "") Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	Записывать = Истина;
	Данные = Новый Структура;
	Для каждого СтрокаДерева Из ДеревоДанных.Строки Цикл
		Путь = СтрокаДерева.ПолныйПуть;
		ДанныеСтроки = ЭлектронноеВзаимодействие.ДанныеЭлементаДереваЭлектронногоДокумента(ДеревоДанных, Путь);
		Данные.Вставить(Путь, ДанныеСтроки);
	КонецЦикла;
	
	
	РежимЗаписи = РежимЗаписиДокумента.Запись;
	Попытка
		Если ЗначениеЗаполнено(СсылкаНаВладельца) Тогда
			ДокументОбъект = СсылкаНаВладельца.ПолучитьОбъект();
			Если ДокументОбъект.Проведен Тогда
				Текст = НСтр("ru = 'Операция возможна только для непроведенных документов!'");
			КонецЕсли;
		Иначе
			ДокументОбъект = Документы.СчетНаОплатуОтПоставщика.СоздатьДокумент();
			ДокументОбъект.Дата = ТекущаяДатаСеанса();
			ДокументОбъект.Ответственный = Пользователи.ТекущийПользователь();
		КонецЕсли;
		
		ДокументОбъект.ТипФорматаЭД = 2;
		
		// Шапка.	
		ДокументОбъект.Организация = ОрганизацияПоДаннымЭД(ДеревоДанных, "Покупатель");
		ДокументОбъект.Контрагент  = КонтрагентПоДаннымЭД(ДеревоДанных, "Продавец");

		//Договор
		Основания = Данные.Основания;
		Если Основания.Количество() > 0 Тогда
			Договор = Справочники.Договоры.ПустаяСсылка();
			
			НомерДоговора = Основания[0].Номер;
			ДатаДоговора = Основания[0].Дата;
			
			Владелец = ДокументОбъект.Контрагент;
			Если  ЗначениеЗаполнено(Владелец) Тогда
				ДополнительныеРеквизиты = Новый Структура("НомерДоговора, ДатаДоговора, Владелец, Организация",
					НомерДоговора, ДатаДоговора, Владелец, ДокументОбъект.Организация); 
				НайтиСсылкуНаОбъект("ДоговорыКонтрагентов", Договор, , ДополнительныеРеквизиты);
			КонецЕсли;
			
			ДокументОбъект.Договор = Договор;
			ДокументОбъект.ИдентификаторГосКонтракта = Основания[0].ИдентификаторГосКонтракта;
		КонецЕсли;	
		
		ДокументОбъект.ПолучательДенежныхСредств = КонтрагентПоДаннымЭД(ДеревоДанных, "ПолучательДенежныхСредств");
		ДокументОбъект.Плательщик  = КонтрагентПоДаннымЭД(ДеревоДанных, "Плательщик");
		
		ДокументОбъект.Грузоотправитель = КонтрагентПоДаннымЭД(ДеревоДанных, "Грузоотправитель");
		ДокументОбъект.Грузополучатель  = КонтрагентПоДаннымЭД(ДеревоДанных, "Грузополучатель");
		
		ДокументОбъект.ВидПервичногоДокумента = "Счет на оплату";
		ДокументОбъект.НомерПервичногоДокумента = Данные.НомерДокумента;
		ДокументОбъект.ДатаПервичногоДокумента = Данные.ДатаДокумента;
		
		ДокументОбъект.ВалютаДокумента = ОбщегоНазначенияБЭД.НайтиСсылку("Валюты", Данные.ДенежнаяЕдиница.КодВалюты);
		Если Не ЗначениеЗаполнено(ДокументОбъект.ВалютаДокумента) Тогда
			ДокументОбъект.ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
		КонецЕсли;	
		
		ДокументОбъект.СуммаДокумента = Данные.ВсегоКОплате.СтоимостьСНДС;
		Если Данные.ВсегоКОплате.СуммаНалога.СуммаНалога > 0 Тогда
			ДокументОбъект.СуммаНалогаИтог = Данные.ВсегоКОплате.СуммаНалога.СуммаНалога;
			ДокументОбъект.ЦенаВключаетНДС = Истина;
		КонецЕсли;	
		
		ДополнительныеСведения = Данные.ДополнительныеСведения;
		ДокументОбъект.СрокОплаты = ДополнительныеСведения.ОграничениеПоДатеОплаты;
		ДокументОбъект.НазначениеПлатежа = ДополнительныеСведения.НазначениеПлатежа;
		
		ДокументОбъект.ОбменДанными.Загрузка = Истина;
		ДокументОбъект.ДополнительныеСвойства.Вставить("ЕстьСоглашение", Истина);
		ДокументОбъект.ДополнительныеСвойства.Вставить("ПроцессыОбработкиДокументов_ЗаписатьБезПроверкиОбменДаннымиЗагрузка", Истина);
		Если Записывать Тогда
			Если НЕ ЗначениеЗаполнено(ДокументОбъект.Номер) Тогда
				ДокументОбъект.УстановитьНовыйНомер();
			КонецЕсли;
			ДокументОбъект.Записать(РежимЗаписи);
			СсылкаНаВладельца = ДокументОбъект.Ссылка;
		Иначе // если функция вызвана из формы "Обработки.ЭлектронныеДокументы.ФормаЗагрузкиПросмотраЭД"
			СсылкаНаВладельца = ДокументОбъект;
		КонецЕсли;
		
	Исключение
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Заполнение документа на основе ЭД. %1'"), Текст);
		ЗаписьЖурналаРегистрации(ТекстСообщения, УровеньЖурналаРегистрации.Ошибка, ДокументОбъект.Метаданные(), СсылкаНаВладельца,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение(Текст);
	КонецПопытки;
		
КонецПроцедуры

#КонецОбласти

#Область ДоговорнойДокумент

Процедура ЗаполнитьДанныеПоДоговорномуДокументу101(СсылкаНаОбъект, КонструкторЭД, Отказ) Экспорт

	НетЗамечанийКДокументу = Справочники.Договоры.ПредварительныйКонтрольДанныхДляЭД(СсылкаНаОбъект);
	
	Если НЕ НетЗамечанийКДокументу Тогда
		ОписаниеОшибки = НСтр("ru='Вышеуказанные ошибки препятствуют формированию электронного документа.
		|По этой причине и прочие данные документа не будут выгружены в ЭД.
		|После заполнения указанных реквизитов повторите попытку формирования электронного документа.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки);
		Отказ = Истина;

		КонструкторЭД.ОбработчикОшибок.УстановитьСвязь(СсылкаНаОбъект, "Ссылка", "Объект.Ссылка");
		
		Возврат;
	КонецЕсли;	

	ДанныеЭД = Справочники.Договоры.ПолучитьДанныеДляЭД(СсылкаНаОбъект);
	Данные = ДанныеЭД[0];
	
	ВалютаДоговора = Данные.ВалютаДоговора;
	Если НЕ ЗначениеЗаполнено(ВалютаДоговора) Тогда
		ВалютаДоговора = Константы.ВалютаРегламентированногоУчета.Получить();
	КонецЕсли;
	ВалютаРасчетов = Данные.ВалютаРасчетов;
	Если НЕ ЗначениеЗаполнено(ВалютаРасчетов) Тогда
		ВалютаРасчетов = ВалютаДоговора;
	КонецЕсли;
	
	ДанныеВалюты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВалютаДоговора, "Код, Наименование");
	КодВалюты = ДанныеВалюты.Код;
	ДанныеВалютыРасчетов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВалютаДоговора, "Код, Наименование");
	КодВалютыРасчетов = ДанныеВалютыРасчетов.Код;
	
	КонструкторЭД.ОбработчикОшибок.ПараметрыСвязиПоУмолчанию(СсылкаНаОбъект);

	ДатаДанных = Данные.ДатаДоговора;
	Если НЕ ЗначениеЗаполнено(ДатаДанных) Тогда
		ДатаДанных = ТекущаяДатаСеанса();
	КонецЕсли;	
	
	ИнформацияДокумента = КонструкторЭД.ИнформацияДокумента(); // см. ОбработкаОбъект.ФорматДоговорныйДокумент101
	ИнформацияДокумента.ФункцияДокумента = ФункцияЭДДоговорнойДокумент101(КонструкторЭД, Данные.ФункцияЭД);
	ИнформацияДокумента.ПризнакПорядкаФормирования = КонструкторЭД.ПризнакиПорядкаФормирования().НеОферта;
	Если ЗначениеЗаполнено(Данные.НомерДоговора) Тогда
		НомерДоговора = Данные.НомерДоговора;
	Иначе
		НомерДоговора = НСтр("ru = 'без номера (б/н)'");
	КонецЕсли;
	
	ИнформацияДокумента.НомерДоговора = Данные.НомерДоговора;
	ИнформацияДокумента.ДатаДоговора = Данные.ДатаДоговора;
	ИнформацияДокумента.ТипДоговора = ИнтеграцияЭДОПовтИсп.ВидДоговоровКонтрагентовПеречисление(Данные.ВидДоговора);
	КонструкторЭД.ОбработчикОшибок.УстановитьСвязь(ИнформацияДокумента, "ТипДоговора", "Объект.ВидДоговора");
	ИнформацияДокумента.МестоЗаключенияДоговора = Данные.МестоЗаключенияДоговора;

	СторонаКонтрагент = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
	ПолучитьДанныеЮрФизЛица(Данные.Контрагент, СторонаКонтрагент, ДатаДанных);
	
	ИнформацияДокумента.Контрагент = КонструкторЭД.НоваяСторонаДоговора();
	КонструкторЭД.ОбработчикОшибок.УстановитьСвязь(ИнформацияДокумента, "Контрагент", "Объект.Контрагент");
	ИнформацияДокумента.Контрагент.КодОКПО = СторонаКонтрагент.КодПоОКПО;
	ИнформацияДокумента.Контрагент.КраткоеНазвание = СторонаКонтрагент.НаименованиеПолное;

	ИдентификационныеСведенияКонтрагента = Неопределено;
	
	ПолноеНаименованиеЮЛ = "";
	СокращенноеНаименование = "";
	Если Данные.Контрагент_ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
		ИнформацияДокумента.Контрагент.КраткоеНазвание = СокращенноеНаименование;
		
		ИдентификационныеСведенияКонтрагента = КонструкторЭД.НовыеИдентификационныеСведенияОрганизации();
		ИдентификационныеСведенияКонтрагента.НаименованиеПолное = СторонаКонтрагент.НаименованиеПолное;
		ПолноеНаименованиеЮЛ = СторонаКонтрагент.НаименованиеПолное;

		КонструкторЭД.ОбработчикОшибок.УстановитьСвязь(ИдентификационныеСведенияКонтрагента, "НаименованиеПолное",
			"Объект.НаименованиеПолное", , Данные.Контрагент);
		ИдентификационныеСведенияКонтрагента.ИНН = СторонаКонтрагент.ИНН;
		КонструкторЭД.ОбработчикОшибок.УстановитьСвязь(ИдентификационныеСведенияКонтрагента, "ИНН",
			"Объект.ИНН", , Данные.Контрагент);
		ИдентификационныеСведенияКонтрагента.ОГРН = СторонаКонтрагент.ОГРН;
		Если ЗначениеЗаполнено(СторонаКонтрагент.КПП) Тогда
			МассивКППКонтрагента = Новый Массив;
			МассивКППКонтрагента.Добавить(СторонаКонтрагент.КПП);
			ИдентификационныеСведенияКонтрагента.КПП = МассивКППКонтрагента;
		КонецЕсли;
		КонструкторЭД.ОбработчикОшибок.УстановитьСвязь(ИдентификационныеСведенияКонтрагента, "КПП",
			"Объект.КПП", , Данные.Контрагент);
	ИначеЕсли Данные.Контрагент_ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
		Если СторонаКонтрагент.ИП Тогда
			ИдентификационныеСведенияКонтрагента = КонструкторЭД.НовыеИдентификационныеСведенияИП();
			ИдентификационныеСведенияКонтрагента.ИНН = СторонаКонтрагент.ИНН;
			КонструкторЭД.ОбработчикОшибок.УстановитьСвязь(ИдентификационныеСведенияКонтрагента, "ИНН", "Объект.ИНН", ,
				Данные.Контрагент);
			ИдентификационныеСведенияКонтрагента.ОГРН = СторонаКонтрагент.ОГРНИП;
			КонструкторЭД.ОбработчикОшибок.УстановитьСвязь(ИдентификационныеСведенияКонтрагента, "ОГРН", "Объект.ОГРН", ,
				Данные.Контрагент);
			ИдентификационныеСведенияКонтрагента.ФИО = КонструкторЭД.НовыеФИО(СторонаКонтрагент.Фамилия,
				СторонаКонтрагент.Имя, СторонаКонтрагент.Отчество);
			КонструкторЭД.ОбработчикОшибок.УстановитьСвязь(ИдентификационныеСведенияКонтрагента.ФИО, "Фамилия",
				"Объект.Наименование", , Данные.Контрагент);
			КонструкторЭД.ОбработчикОшибок.УстановитьСвязь(ИдентификационныеСведенияКонтрагента.ФИО, "Имя",
				"Объект.Наименование", , Данные.Контрагент);
		Иначе
			ИдентификационныеСведенияКонтрагента = КонструкторЭД.НовыеИдентификационныеСведенияФизЛица();
			ИдентификационныеСведенияКонтрагента.ИНН = СторонаКонтрагент.ИНН;
			КонструкторЭД.ОбработчикОшибок.УстановитьСвязь(ИдентификационныеСведенияКонтрагента, "ИНН",
				"Объект.ИНН", , Данные.Контрагент);
			ИдентификационныеСведенияКонтрагента.ФИО = КонструкторЭД.НовыеФИО(СторонаКонтрагент.Фамилия,
				СторонаКонтрагент.Имя, СторонаКонтрагент.Отчество);
			КонструкторЭД.ОбработчикОшибок.УстановитьСвязь(ИдентификационныеСведенияКонтрагента.ФИО, "Фамилия",
				"Объект.Наименование", , Данные.Контрагент);
			КонструкторЭД.ОбработчикОшибок.УстановитьСвязь(ИдентификационныеСведенияКонтрагента.ФИО, "Имя",
				"Объект.Наименование", , Данные.Контрагент);
			
			ИдентификационныеСведенияКонтрагента.Адрес = КонструкторЭД.ЗаполнитьАдресАвтоматически(
				Справочники.ВидыКонтактнойИнформации.ФактическийАдресКонтрагенты, Данные.Контрагент,
					ИнформацияДокумента.ДатаДоговора, КонструкторЭД);
			КонструкторЭД.ОбработчикОшибок.УстановитьСвязь(ИдентификационныеСведенияКонтрагента, "Адрес", , ,
				Данные.Контрагент);
		КонецЕсли;	
	КонецЕсли;	

	ИнформацияДокумента.Контрагент.ИдентификационныеСведения = ИдентификационныеСведенияКонтрагента;

	Если ЗначениеЗаполнено(СторонаКонтрагент.Телефоны) ИЛИ ЗначениеЗаполнено(СторонаКонтрагент.ЭлектроннаяПочта) Тогда
		ИнформацияДокумента.Контрагент.КонтактныеДанные = КонструкторЭД.НовыеКонтактныеДанные();
		ИнформацияДокумента.Контрагент.КонтактныеДанные.НомерТелефона = СторонаКонтрагент.Телефоны;
		ИнформацияДокумента.Контрагент.КонтактныеДанные.АдресЭП = СторонаКонтрагент.ЭлектроннаяПочта;
	КонецЕсли;

	ИнформацияДокумента.Контрагент.БанковскиеРеквизиты = КонструкторЭД.НовыеБанковскиеРеквизиты();
	
	РасчетныеРеквизиты = ДанныеРасчетногоСчетаСтороныЭлектронногоДоговора(Данные.Контрагент, Данные.РасчетныйСчетКонтрагента, ПолноеНаименованиеЮЛ);
	
	Контрагент_БанковскийСчет_ИНН = РасчетныеРеквизиты.ИННБанка;
	Контрагент_БанковскийСчет_НомерСчета = РасчетныеРеквизиты.НомерСчетаВБанке;
	Контрагент_БанковскийСчет_НаименованиеБанка = РасчетныеРеквизиты.НаименованиеБанка;
	Контрагент_БанковскийСчет_БИК = РасчетныеРеквизиты.БИК;
	Контрагент_БанковскийСчет_КоррСчет = РасчетныеРеквизиты.КоррСчет;
	Контрагент_БанковскийСчет_ИныеСведения = РасчетныеРеквизиты.ИныеСведения;
	
	ИнформацияДокумента.Контрагент.БанковскиеРеквизиты.ИНН = Контрагент_БанковскийСчет_ИНН;
	ИнформацияДокумента.Контрагент.БанковскиеРеквизиты.НомерСчета = Контрагент_БанковскийСчет_НомерСчета;
	ИнформацияДокумента.Контрагент.БанковскиеРеквизиты.Наименование = Контрагент_БанковскийСчет_НаименованиеБанка;
	ИнформацияДокумента.Контрагент.БанковскиеРеквизиты.БИК = Контрагент_БанковскийСчет_БИК;
	ИнформацияДокумента.Контрагент.БанковскиеРеквизиты.КорреспондентскийСчет = Контрагент_БанковскийСчет_КоррСчет;
	ИнформацияДокумента.Контрагент.БанковскиеРеквизиты.ИныеСведения = Контрагент_БанковскийСчет_ИныеСведения;
		
	СторонаОрганизация = ЭлектронноеВзаимодействие.СтруктураДанныхЮрФизЛица();
	ПолучитьДанныеЮрФизЛица(Данные.Организация, СторонаОрганизация);

	ИнформацияДокумента.Организация = КонструкторЭД.НоваяСторонаДоговора();
	КонструкторЭД.ОбработчикОшибок.УстановитьСвязь(ИнформацияДокумента, "Организация", "Объект.Организация");
	ИнформацияДокумента.Организация.КодОКПО = СторонаОрганизация.КодПоОКПО;
	ИнформацияДокумента.Организация.КраткоеНазвание = СторонаОрганизация.СокращенноеНаименование;

	ИдентификационныеСведенияОрганизации = Неопределено;
	
	ИдентификационныеСведенияОрганизации = КонструкторЭД.НовыеИдентификационныеСведенияОрганизации();
	ИдентификационныеСведенияОрганизации.НаименованиеПолное = СторонаОрганизация.НаименованиеПолное;
	КонструкторЭД.ОбработчикОшибок.УстановитьСвязь(ИдентификационныеСведенияОрганизации, "НаименованиеПолное",
		"Объект.НаименованиеПолное", , Данные.Организация);
	ИдентификационныеСведенияОрганизации.ИНН = СторонаОрганизация.ИНН;
	КонструкторЭД.ОбработчикОшибок.УстановитьСвязь(ИдентификационныеСведенияОрганизации, "ИНН",
		"Объект.ИНН", , Данные.Организация);
	ИдентификационныеСведенияОрганизации.ОГРН = СторонаОрганизация.ОГРН;
	Если ЗначениеЗаполнено(СторонаОрганизация.КПП) Тогда
		МассивКППОрганизации = Новый Массив;
		МассивКППОрганизации.Добавить(СторонаОрганизация.КПП);
		ИдентификационныеСведенияОрганизации.КПП = МассивКППОрганизации;
	КонецЕсли;
	КонструкторЭД.ОбработчикОшибок.УстановитьСвязь(ИдентификационныеСведенияОрганизации, "КПП",
		"Объект.Организация.КПП", , Данные.Организация);

	ИнформацияДокумента.Организация.ИдентификационныеСведения = ИдентификационныеСведенияОрганизации;
	ИнформацияДокумента.Организация.Адрес = КонструкторЭД.ЗаполнитьАдресАвтоматически(
		Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации, Данные.Организация, ИнформацияДокумента.ДатаДоговора,
			КонструкторЭД);
			
	Если ЗначениеЗаполнено(СторонаОрганизация.Телефоны) ИЛИ ЗначениеЗаполнено(СторонаОрганизация.ЭлектроннаяПочта) Тогда
		ИнформацияДокумента.Организация.КонтактныеДанные = КонструкторЭД.НовыеКонтактныеДанные();
		ИнформацияДокумента.Организация.КонтактныеДанные.НомерТелефона = СторонаОрганизация.Телефоны;
		ИнформацияДокумента.Организация.КонтактныеДанные.АдресЭП = СторонаОрганизация.ЭлектроннаяПочта;
	КонецЕсли;

	РасчетныеРеквизиты = ДанныеРасчетногоСчетаСтороныЭлектронногоДоговора(Данные.Организация, Данные.РеквизитыЛицевогоСчета);
	
	Организация_БанковскийСчет_ИНН = РасчетныеРеквизиты.ИННБанка;
	Организация_БанковскийСчет_НомерСчета = РасчетныеРеквизиты.НомерСчетаВБанке;
	Организация_БанковскийСчет_НаименованиеБанка = РасчетныеРеквизиты.НаименованиеБанка;
	Организация_БанковскийСчет_БИК = РасчетныеРеквизиты.БИК;
	Организация_БанковскийСчет_КоррСчет = РасчетныеРеквизиты.КоррСчет;
	Организация_БанковскийСчет_ИныеСведения = РасчетныеРеквизиты.ИныеСведения;
	
	ИнформацияДокумента.Организация.БанковскиеРеквизиты = КонструкторЭД.НовыеБанковскиеРеквизиты();
	ИнформацияДокумента.Организация.БанковскиеРеквизиты.ИНН = Организация_БанковскийСчет_ИНН;
	ИнформацияДокумента.Организация.БанковскиеРеквизиты.НомерСчета = Организация_БанковскийСчет_НомерСчета;
	ИнформацияДокумента.Организация.БанковскиеРеквизиты.Наименование = Организация_БанковскийСчет_НаименованиеБанка;
	ИнформацияДокумента.Организация.БанковскиеРеквизиты.БИК = Организация_БанковскийСчет_БИК;
	ИнформацияДокумента.Организация.БанковскиеРеквизиты.КорреспондентскийСчет = Организация_БанковскийСчет_КоррСчет;
	ИнформацияДокумента.Организация.БанковскиеРеквизиты.ИныеСведения = Организация_БанковскийСчет_ИныеСведения;

	ИнформацияДокумента.СведенияОбОбщейСтоимости = КонструкторЭД.НовыеСведенияОбОбщейСтоимости();

	ИнформацияДокумента.СведенияОбОбщейСтоимости.СуммаСНДС = Данные.Сумма;
	ИнформацияДокумента.СведенияОбОбщейСтоимости.СуммаБезНДС = Данные.Сумма - Данные.СуммаНДС;
	
	ИнформацияДокумента.СведенияОбОбщейСтоимости.СуммаНДС = Данные.СуммаНДС;
	ИнформацияДокумента.СведенияОбОбщейСтоимости.КодВалюты = КодВалюты;
	ИнформацияДокумента.СведенияОбОбщейСтоимости.Предмет = Новый Массив;

	ПараметрыДоговораДляЭДО = ПараметрыДоговораДляЭДО(Данные.Ссылка);
	СсылкаНаПараметрыЭДО = ПараметрыДоговораДляЭДО.Ссылка;
	ТаблицаСпискаТРУ = ТРУПредметаЭлектронногоДоговора(ПараметрыДоговораДляЭДО.Ссылка);
	Если ЗначениеЗаполнено(СсылкаНаПараметрыЭДО) Тогда
		Для Каждого ТекСтрока Из ТаблицаСпискаТРУ Цикл
			СтрокаПредмета = КонструкторЭД.НовыйПредмет();
			
			ЗаполнитьЗначенияСвойств(СтрокаПредмета, ТекСтрока);
			
			СтрокаПредмета.СуммаБезНДС = ТекСтрока.Всего - ТекСтрока.СуммаНДС;
			СтрокаПредмета.СуммаСНДС = ТекСтрока.Всего;

			Если ТекСтрока.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС
				ИЛИ НЕ ЗначениеЗаполнено(ТекСтрока.СтавкаНДС) Тогда
				СтрокаПредмета.БезНДС = Истина;
			Иначе
				СтрокаПредмета.СтавкаНДС = ИнтеграцияЭДОПовтИсп.СтавкаНДСПеречисление(ТекСтрока.СтавкаНДС);
			КонецЕсли;
			СтрокаПредмета.КодВалюты = КодВалюты;
			СтрокаПредмета.СуммаНалога = ТекСтрока.СуммаНДС;
			
			Если СтрокаПредмета.СуммаАкциза = 0 Тогда
				СтрокаПредмета.БезАкциза = Истина;	
			КонецЕсли;
			СтрокаПредмета.НомерСтрокиТаблицы = СтрокаПредмета.НомерСтроки;
			
			ЕдиницаИзмеренияКод = "";
			Если ЗначениеЗаполнено(ТекСтрока.ЕдиницаИзмерения) Тогда
				ЗначенияРеквизитовЕдИзм = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекСтрока.ЕдиницаИзмерения, "Код");
				ЕдиницаИзмеренияКод = ЗначенияРеквизитовЕдИзм.Код;
			КонецЕсли;
			СтрокаПредмета.КодЕдиницыИзмерения = СокрЛП(ЕдиницаИзмеренияКод);
			
			КодТНВЭД = "";
			Если ЗначениеЗаполнено(ТекСтрока.КодТНВЭД) Тогда
				ЗначенияРеквизитовТНВЭД = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекСтрока.КодТНВЭД, "Код");
				КодТНВЭД = ЗначенияРеквизитовТНВЭД.Код;
			КонецЕсли;
			СтрокаПредмета.КодТНВЭД = СокрЛП(КодТНВЭД);
			
			СтрокаПредмета.КодКаталога = СокрЛП(СтрокаПредмета.КодКаталога);
			СтрокаПредмета.КодОКПД2 = СокрЛП(СтрокаПредмета.КодОКПД2);
			
			ИнформацияДокумента.СведенияОбОбщейСтоимости.Предмет.Добавить(СтрокаПредмета);
		КонецЦикла;
	КонецЕсли;
	
	
	ИнформацияДокумента.ПорядокРасчета = КонструкторЭД.НовыйПорядокРасчета();
	ИнформацияДокумента.ПорядокРасчета.ВидПлатежа = Данные.ВидПлатежа;
	ИнформацияДокумента.ПорядокРасчета.КодВалюты = КодВалютыРасчетов;
	ИнформацияДокумента.ПорядокРасчета.КоличествоПлатежей = Данные.КоличествоПлатежей;
	ИнформацияДокумента.ПорядокРасчета.ПроцентОтОбщейСуммы = Данные.ПроцентРасчета;
	ИнформацияДокумента.ПорядокРасчета.РазмерПени = Данные.РазмерПени;
	ИнформацияДокумента.ПорядокРасчета.СобытиеИсчисленияСрокаПлатежа = Данные.СобытиеНачалаОтсчетаСрокаОплаты;
	ИнформацияДокумента.ПорядокРасчета.СрокОплаты = Данные.СрокОплаты;
	ИнформацияДокумента.ПорядокРасчета.СрокПоставки = Данные.СрокПоставки;

	ИнформацияДокумента.УсловияПоставки = КонструкторЭД.НовыеУсловияПоставки();
	ИнформацияДокумента.УсловияПоставки.МестоПереходаПраваСобственности = Данные.МестоПереходаПраваСобственности;
	ИнформацияДокумента.УсловияПоставки.ИныеСведения = Данные.ИныеСведенияОбУсловияхПоставки;
	ИнформацияДокумента.УсловияПоставки.Инкотермс = Данные.Инкотермс;
	
	ИнформацияДокумента.СрокДействия = КонструкторЭД.НовыйСрокДействия();
	ИнформацияДокумента.СрокДействия.ДатаНачалаДействия = Данные.ДатаНачалаДействия;
	ИнформацияДокумента.СрокДействия.ДатаОкончанияДействия = Данные.ДатаОкончанияДействия;
	Если Данные.НаличиеПролонгации = Истина Тогда
		ИнформацияДокумента.СрокДействия.НаличиеПролонгации =
			КонструкторЭД.ПризнакиНаличияПролонгации().ПрисутствуетУсловиеПролонгации;
	Иначе
		ИнформацияДокумента.СрокДействия.НаличиеПролонгации =
			КонструкторЭД.ПризнакиНаличияПролонгации().ОтсутствуетУсловиеПролонгации;
	КонецЕсли;
КонецПроцедуры

Функция ТРУПредметаЭлектронногоДоговора(ПараметрыЭДО)
	Запрос = Новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПараметрыДоговораДляЭДОПредметДоговора.НомерСтроки КАК НомерСтроки,
	               |	ПараметрыДоговораДляЭДОПредметДоговора.Номенклатура КАК Номенклатура,
	               |	ПараметрыДоговораДляЭДОПредметДоговора.ПризнакПредмета КАК ПризнакПредмета,
	               |	ПараметрыДоговораДляЭДОПредметДоговора.ВидСделки КАК ВидСделки,
	               |	ПараметрыДоговораДляЭДОПредметДоговора.НаименованиеТРУ КАК НаименованиеТРУ,
	               |	ПараметрыДоговораДляЭДОПредметДоговора.Количество КАК Количество,
	               |	ВЫБОР
	               |		КОГДА ТИПЗНАЧЕНИЯ(ПараметрыДоговораДляЭДОПредметДоговора.Номенклатура) = ТИП(Справочник.Номенклатура)
	               |			ТОГДА ВЫРАЗИТЬ(ПараметрыДоговораДляЭДОПредметДоговора.Номенклатура КАК Справочник.Номенклатура).ЕдиницаИзмерения
	               |		КОГДА ТИПЗНАЧЕНИЯ(ПараметрыДоговораДляЭДОПредметДоговора.Номенклатура) = ТИП(Справочник.ОсновныеСредства)
	               |			ТОГДА &ЕдиницаИзмеренияШтуки
	               |	КОНЕЦ КАК ЕдиницаИзмерения,
	               |	ПараметрыДоговораДляЭДОПредметДоговора.Цена КАК Цена,
	               |	ПараметрыДоговораДляЭДОПредметДоговора.Сумма КАК Сумма,
	               |	ПараметрыДоговораДляЭДОПредметДоговора.Всего КАК Всего,
	               |	ПараметрыДоговораДляЭДОПредметДоговора.СтавкаНДС КАК СтавкаНДС,
	               |	ПараметрыДоговораДляЭДОПредметДоговора.СуммаНДС КАК СуммаНДС,
	               |	ПараметрыДоговораДляЭДОПредметДоговора.СуммаАкциза КАК СуммаАкциза,
	               |	ВЫРАЗИТЬ(ПараметрыДоговораДляЭДОПредметДоговора.Ссылка.ВалютаДоговора КАК Справочник.Валюты).Код КАК КодВалюты,
	               |	ВЫБОР
	               |		КОГДА ТИПЗНАЧЕНИЯ(ПараметрыДоговораДляЭДОПредметДоговора.Номенклатура) = ТИП(Справочник.Номенклатура)
	               |			ТОГДА ВЫРАЗИТЬ(ПараметрыДоговораДляЭДОПредметДоговора.Номенклатура КАК Справочник.Номенклатура).НаименованиеПолное
	               |		КОГДА ТИПЗНАЧЕНИЯ(ПараметрыДоговораДляЭДОПредметДоговора.Номенклатура) = ТИП(Справочник.ОсновныеСредства)
	               |			ТОГДА ВЫРАЗИТЬ(ПараметрыДоговораДляЭДОПредметДоговора.Номенклатура КАК Справочник.ОсновныеСредства).НаименованиеПолное
	               |	КОНЕЦ КАК НаименованиеТовара,
	               |	ВЫБОР
	               |		КОГДА ТИПЗНАЧЕНИЯ(ПараметрыДоговораДляЭДОПредметДоговора.Номенклатура) = ТИП(Справочник.Номенклатура)
	               |			ТОГДА ВЫРАЗИТЬ(ПараметрыДоговораДляЭДОПредметДоговора.Номенклатура КАК Справочник.Номенклатура).КодКаталога
	               |		КОГДА ТИПЗНАЧЕНИЯ(ПараметрыДоговораДляЭДОПредметДоговора.Номенклатура) = ТИП(Справочник.ОсновныеСредства)
	               |			ТОГДА ВЫРАЗИТЬ(ПараметрыДоговораДляЭДОПредметДоговора.Номенклатура КАК Справочник.ОсновныеСредства).КодКаталога
	               |	КОНЕЦ КАК КодКаталога,
	               |	ВЫБОР
	               |		КОГДА ТИПЗНАЧЕНИЯ(ПараметрыДоговораДляЭДОПредметДоговора.Номенклатура) = ТИП(Справочник.Номенклатура)
	               |			ТОГДА ВЫРАЗИТЬ(ПараметрыДоговораДляЭДОПредметДоговора.Номенклатура КАК Справочник.Номенклатура).КодПоКТРУ
	               |		КОГДА ТИПЗНАЧЕНИЯ(ПараметрыДоговораДляЭДОПредметДоговора.Номенклатура) = ТИП(Справочник.ОсновныеСредства)
	               |			ТОГДА ВЫРАЗИТЬ(ПараметрыДоговораДляЭДОПредметДоговора.Номенклатура КАК Справочник.ОсновныеСредства).КодПоКТРУ
	               |	КОНЕЦ КАК КодПоКТРУ,
	               |	ВЫБОР
	               |		КОГДА ТИПЗНАЧЕНИЯ(ПараметрыДоговораДляЭДОПредметДоговора.Номенклатура) = ТИП(Справочник.Номенклатура)
	               |			ТОГДА ВЫРАЗИТЬ(ПараметрыДоговораДляЭДОПредметДоговора.Номенклатура КАК Справочник.Номенклатура).ОКП
	               |		КОГДА ТИПЗНАЧЕНИЯ(ПараметрыДоговораДляЭДОПредметДоговора.Номенклатура) = ТИП(Справочник.ОсновныеСредства)
	               |			ТОГДА ВЫРАЗИТЬ(ПараметрыДоговораДляЭДОПредметДоговора.Номенклатура КАК Справочник.ОсновныеСредства).ОКП
	               |	КОНЕЦ КАК ОКП,
	               |	ВЫБОР
	               |		КОГДА ТИПЗНАЧЕНИЯ(ПараметрыДоговораДляЭДОПредметДоговора.Номенклатура) = ТИП(Справочник.Номенклатура)
	               |			ТОГДА ВЫРАЗИТЬ(ПараметрыДоговораДляЭДОПредметДоговора.Номенклатура КАК Справочник.Номенклатура).КодТНВЭД
	               |		КОГДА ТИПЗНАЧЕНИЯ(ПараметрыДоговораДляЭДОПредметДоговора.Номенклатура) = ТИП(Справочник.ОсновныеСредства)
	               |			ТОГДА ВЫРАЗИТЬ(ПараметрыДоговораДляЭДОПредметДоговора.Номенклатура КАК Справочник.ОсновныеСредства).КодТНВЭД
	               |	КОНЕЦ КАК КодТНВЭД,
	               |	ПараметрыДоговораДляЭДОПредметДоговора.КодОКВЭД2 КАК КодОКВЭД2
	               |ИЗ
	               |	Справочник.ПараметрыДоговораДляЭДО.ПредметДоговора КАК ПараметрыДоговораДляЭДОПредметДоговора
	               |ГДЕ
	               |	ПараметрыДоговораДляЭДОПредметДоговора.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("ЕдиницаИзмеренияШтуки", Штуки());
	Запрос.УстановитьПараметр("Ссылка", ПараметрыЭДО);
	Результат = Запрос.Выполнить().Выгрузить();

	Возврат Результат;
	
КонецФункции	

Функция ФункцияЭДДоговорнойДокумент101(КонструкторЭД, КодФункцииЭД)
	Результат = КонструкторЭД.ФункцииДокумента().Дог;
	Если КодФункцииЭД = 1 Тогда
		Результат = КонструкторЭД.ФункцииДокумента().Прораз;
	ИначеЕсли КодФункцииЭД = 2 Тогда
		Результат = КонструкторЭД.ФункцииДокумента().Допсогл;
	КонецЕсли;	

	Возврат Результат;
КонецФункции	

Функция ДанныеРасчетногоСчетаСтороныЭлектронногоДоговора(СторонаУчастник, РеквизитыЛицевогоСчета, ПолноеНаименованиеЮЛ = "")

	РасчетныеРеквизиты = Новый Структура("ИННБанка, КППБанка, НомерСчетаВБанке, НаименованиеБанка, БИК, КоррСчет, ИныеСведения",
		"", "", "", "", "", "", "");

	Если ТипЗнч(СторонаУчастник) = Тип("СправочникСсылка.Организации") Тогда
		ТекстБанка = "";
		НомерСчета = "";
		ЛицевойСчет = Справочники.ЛицевыеСчета.ПустаяСсылка();
		Если ЗначениеЗаполнено(РеквизитыЛицевогоСчета) Тогда
			ДанныеЛС = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыЛицевогоСчета, "Владелец, Код");
			ЛицевойСчет = ДанныеЛС.Владелец;
			Если ЗначениеЗаполнено(ЛицевойСчет) Тогда
				ДанныеЛицевойСчет = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыЛицевогоСчета, "СчетКазначейства, КассовыйОрган, Владелец, Код");
				ЛССчетКазначейства = ДанныеЛицевойСчет.СчетКазначейства;
				Если ЗначениеЗаполнено(ЛССчетКазначейства) Тогда
					БанкКазначейства = ЛССчетКазначейства.КассовыйОрган;
					ДанныеБанка = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(БанкКазначейства, "Наименование, ИНН, КоррСчет");
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;

		Если ЗначениеЗаполнено(ЛицевойСчет) И ЗначениеЗаполнено(РеквизитыЛицевогоСчета) Тогда
			РасчетныеРеквизитыПолучателя = Новый Структура("ИННПолучателя, КПППолучателя, ТекстПолучателя, НомерСчетаПолучателя, НаименованиеБанкаПолучателя, БикБанкаПолучателя, СчетБанкаПолучателя",
				"ИНН", "КПП", "Корреспондент", "СчетНомер", "Банк", "БИК", "КоррСчет");
		    ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(ЛицевойСчет, РеквизитыЛицевогоСчета, РасчетныеРеквизитыПолучателя, Истина);
		
			РасчетныеРеквизиты.ИныеСведения = РасчетныеРеквизитыПолучателя.ТекстПолучателя;
			РасчетныеРеквизиты.НаименованиеБанка = РасчетныеРеквизитыПолучателя.НаименованиеБанкаПолучателя;
			РасчетныеРеквизиты.НомерСчетаВБанке = РасчетныеРеквизитыПолучателя.НомерСчетаПолучателя;
			РасчетныеРеквизиты.БИК = РасчетныеРеквизитыПолучателя.БикБанкаПолучателя;
			РасчетныеРеквизиты.КоррСчет = СокрЛП(ДанныеБанка.КоррСчет);
			РасчетныеРеквизиты.ИННБанка = СокрЛП(ДанныеБанка.ИНН);
			Если НЕ ЗначениеЗаполнено(РасчетныеРеквизиты.НомерСчетаВБанке) Тогда
				РасчетныеРеквизиты.НомерСчетаВБанке = "00000000000000000000";
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(РасчетныеРеквизиты.КоррСчет) Тогда
				РасчетныеРеквизиты.КоррСчет = "00000000000000000000";
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ТипЗнч(СторонаУчастник) = Тип("СправочникСсылка.Контрагенты") Тогда	
		Если ТипЗнч(РеквизитыЛицевогоСчета.КассовыйОрган) = Тип("СправочникСсылка.Банки") Тогда
			ДанныеЛицевойСчет = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыЛицевогоСчета, "СчетКазначейства, КассовыйОрган, Владелец, Код");
			ЛСКассовыйОрган = ДанныеЛицевойСчет.КассовыйОрган;
			ДанныеЛСКассовыйОрган = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЛСКассовыйОрган, "Наименование, Код, ИНН");

			РасчетныеРеквизиты.НаименованиеБанка = ДанныеЛСКассовыйОрган.Наименование;
			РасчетныеРеквизиты.НомерСчетаВБанке = СокрЛП(ЛСКассовыйОрган.КоррСчет);
			РасчетныеРеквизиты.БИК = СокрЛП(ДанныеЛСКассовыйОрган.Код);
			РасчетныеРеквизиты.КоррСчет = СокрЛП(ДанныеЛицевойСчет.Код);
			РасчетныеРеквизиты.ИННБанка = СокрЛП(ДанныеЛСКассовыйОрган.ИНН);
		ИначеЕсли ТипЗнч(РеквизитыЛицевогоСчета.КассовыйОрган) = Тип("СправочникСсылка.Казначейства") Тогда
			ДанныеЛицевойСчет = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыЛицевогоСчета, "СчетКазначейства, КассовыйОрган, Владелец, Код");
			ЛССчетКазначейства = ДанныеЛицевойСчет.СчетКазначейства;
			ЛСКассовыйОрган = ДанныеЛицевойСчет.КассовыйОрган;
			ЛСВладелец = ДанныеЛицевойСчет.Владелец;
			ЛСКод = СокрЛП(ДанныеЛицевойСчет.Код);
			ДанныеЛССчетКазначейства = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЛССчетКазначейства, "КассовыйОрган, Код");
			БанкКазначейства = ЛССчетКазначейства.КассовыйОрган;
			ДанныеБанка = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(БанкКазначейства, "Наименование, ИНН, КоррСчет");
			ДанныеЛССККассовыйОрган = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДанныеЛССчетКазначейства.КассовыйОрган, "Наименование, Код, Город, КоррСчет, ИНН");
			ДанныеЛСКассовыйОрган = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЛСКассовыйОрган, "Наименование, Код");
			Если ТипЗнч(ЛСВладелец) = Тип("СправочникСсылка.Контрагенты") Тогда
				ДанныеЛСВладелец = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЛСВладелец, "НаименованиеСокращенное");
			ИначеЕсли ТипЗнч(ЛСВладелец) = Тип("СправочникСсылка.ЛицевыеСчета") Тогда
				ДанныеЛС = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РеквизитыЛицевогоСчета, "Владелец");
				ЛС = ДанныеЛС.Владелец;
				Данные = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЛС, "Владелец");
				
			КонецЕсли;
			ДанныеУчастника = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СторонаУчастник, "НаименованиеСокращенное");
			
			Если ЗначениеЗаполнено(ДанныеЛСВладелец.НаименованиеСокращенное) Тогда
				НаименованиеДляИныхСведений = ДанныеЛСВладелец.НаименованиеСокращенное;
			Иначе
				НаименованиеДляИныхСведений = ПолноеНаименованиеЮЛ;
			КонецЕсли;	
			
			ШаблонЗначения = НСтр("ru = '%1 (%2, л/с %3)'");
			ИныеСведения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонЗначения, 
				ДанныеЛСКассовыйОрган.Наименование, НаименованиеДляИныхСведений, ЛСКод);
			РасчетныеРеквизиты.БИК = СокрЛП(ДанныеЛССККассовыйОрган.Код);
			РасчетныеРеквизиты.НаименованиеБанка = СокрЛП(ДанныеБанка.Наименование);
			РасчетныеРеквизиты.НомерСчетаВБанке = СокрЛП(ДанныеЛССчетКазначейства.Код);
			РасчетныеРеквизиты.КоррСчет = СокрЛП(ДанныеБанка.КоррСчет);
			РасчетныеРеквизиты.ИННБанка = СокрЛП(ДанныеБанка.ИНН);
			РасчетныеРеквизиты.ИныеСведения = ИныеСведения;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(РасчетныеРеквизиты.НомерСчетаВБанке) Тогда
			РасчетныеРеквизиты.НомерСчетаВБанке = "00000000000000000000";
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(РасчетныеРеквизиты.КоррСчет) Тогда
			РасчетныеРеквизиты.КоррСчет = "00000000000000000000";
		КонецЕсли;
	КонецЕсли;	
	
	Возврат РасчетныеРеквизиты;
КонецФункции	

Процедура НайтиСоздатьДоговорнойДокумент101(КонструкторЭД, ДокументУчета = Неопределено,
	СпособОбработки = "", ОписаниеОшибки = "") Экспорт

	ИнформацияДокумента = КонструкторЭД.ИнформацияДокумента[0];
	
	// Если документ не соответствует ограничениям, то не распознаем.
	Если НЕ (ИнформацияДокумента.ФункцияДокумента = КонструкторЭД.ФункцииДокумента().Дог
		И ИнформацияДокумента.ПризнакПорядкаФормирования = КонструкторЭД.ПризнакиПорядкаФормирования().НеОферта) Тогда
		ОписаниеОшибки = НСтр("ru = 'Данный вид договора не поддерживается.'");
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументУчета) Тогда
		СправочникОбъект = ДокументУчета.ПолучитьОбъект();
	Иначе
		СправочникОбъект = Справочники.Договоры.СоздатьЭлемент();
	КонецЕсли;
	
	СправочникОбъект.ЭтоЭлектронныйДокумент = Истина;

	СоответствиеПротивоположныхВидовДоговоров = Новый Соответствие;
	ЗаполнитьСоответствиеВидовДоговоровПротивоположноеЗначениюКонтрагентов(СоответствиеПротивоположныхВидовДоговоров);
	ВидДоговора = СоответствиеПротивоположныхВидовДоговоров.Получить(ИнформацияДокумента.ТипДоговора);
	СправочникОбъект.ВидДоговора = ?(ЗначениеЗаполнено(ВидДоговора), ВидДоговора, Перечисления.ВидыДоговоровКонтрагентов.ИноеОбязательство);
	СправочникОбъект.ДатаДоговора = ИнформацияДокумента.ДатаДоговора;
	СправочникОбъект.НомерДоговора = ИнформацияДокумента.НомерДоговора;
	
	Если ЗначениеЗаполнено(СправочникОбъект.НомерДоговора) Тогда
		Если НРег(СправочникОбъект.НомерДоговора) <> "без номера (б/н)" Тогда
			СправочникОбъект.Наименование = СтрШаблон(НСтр("ru = 'Договор № %1'"), СправочникОбъект.НомерДоговора);
		Иначе
			СправочникОбъект.Наименование = СтрШаблон(НСтр("ru = 'Договор %1'"), СправочникОбъект.НомерДоговора);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СправочникОбъект.ДатаДоговора) Тогда
			СправочникОбъект.Наименование = СтрШаблон(НСтр("ru = '%1 от %2'"), СправочникОбъект.Наименование,
				Формат(СправочникОбъект.ДатаДоговора, "ДФ=dd.MM.yyyy;"));
		КонецЕсли;
	КонецЕсли;
	
	ТипыСторон = Обработки.ФорматДоговорныйДокумент101.ТипыСторонДоговора();
	Организация = ОрганизацияПоДаннымДоговорногоДокумента101(ИнформацияДокумента.Контрагент.ИдентификационныеСведения, ТипыСторон);
	СправочникОбъект.Организация = Организация;
	
	Контрагент = КонтрагентПоДаннымДоговорногоДокумента101(ИнформацияДокумента.Организация.ИдентификационныеСведения, ТипыСторон);
	СправочникОбъект.Контрагент = Контрагент;
	СчетКонтрагента = СчетКонтрагентаДляДоговорногоДокумента101(Контрагент, ИнформацияДокумента.Контрагент.БанковскиеРеквизиты);
	Если НЕ ЗначениеЗаполнено(СправочникОбъект.СчетКонтрагента) Тогда
		СправочникОбъект.СчетКонтрагента = СчетКонтрагента;
	КонецЕсли;
			
	ЗаписатьСправочник(СправочникОбъект);
	ДокументУчета = СправочникОбъект.Ссылка;
	
	//Заполнение связанного элемента справочника параметров договора для ЭДО
	ПараметрыДоговораДляЭДО = ПараметрыДоговораДляЭДО(ДокументУчета);
	
	Если ЗначениеЗаполнено(ПараметрыДоговораДляЭДО) Тогда
		ПараметрыДоговораДляЭДООбъект = ПараметрыДоговораДляЭДО.ПолучитьОбъект();
	Иначе
		ПараметрыДоговораДляЭДООбъект = Справочники.ПараметрыДоговораДляЭДО.СоздатьЭлемент();
	КонецЕсли;
	ПараметрыДоговораДляЭДООбъект.ВходящийЭД = Истина;
	ПараметрыДоговораДляЭДООбъект.Организация = Организация;
	ПараметрыДоговораДляЭДООбъект.Договор = ДокументУчета;
	ПараметрыДоговораДляЭДООбъект.Контрагент = Контрагент;
	ПараметрыДоговораДляЭДООбъект.РасчетныйСчетКонтрагента = СчетКонтрагента;
	
	Если ИнформацияДокумента.ФункцияДокумента = КонструкторЭД.ФункцииДокумента().Дог Тогда
		ПараметрыДоговораДляЭДООбъект.ФункцияЭД = 0;
	ИначеЕсли ИнформацияДокумента.ФункцияДокумента = КонструкторЭД.ФункцииДокумента().Прораз Тогда
		ПараметрыДоговораДляЭДООбъект.ФункцияЭД = 1;
	ИначеЕсли ИнформацияДокумента.ФункцияДокумента = КонструкторЭД.ФункцииДокумента().Допсогл Тогда
		ПараметрыДоговораДляЭДООбъект.ФункцияЭД = 2;
	КонецЕсли;	
	
	ПараметрыДоговораДляЭДООбъект.Наименование = СокрЛП(СправочникОбъект.Наименование);
	ПараметрыДоговораДляЭДООбъект.СуммаНДС = 0;
	ПараметрыДоговораДляЭДООбъект.Сумма = 0;
	ПараметрыДоговораДляЭДООбъект.ВалютаДоговора = Справочники.Валюты.ПустаяСсылка();
	ПараметрыДоговораДляЭДООбъект.ВалютаРасчетов = Справочники.Валюты.ПустаяСсылка();
	ПараметрыДоговораДляЭДООбъект.НаличиеПролонгации = Ложь;
	ПараметрыДоговораДляЭДООбъект.ДатаНачалаДействия = Дата(1, 1, 1);
	ПараметрыДоговораДляЭДООбъект.ДатаОкончанияДействия = Дата(1, 1, 1);

	ПараметрыДоговораДляЭДООбъект.МестоЗаключенияДоговора = ИнформацияДокумента.МестоЗаключенияДоговора;
	
	Валюта = Справочники.Валюты.ПустаяСсылка();
	Если ЗначениеЗаполнено(КонструкторЭД.СведенияОбОбщейСтоимости)
		И КонструкторЭД.СведенияОбОбщейСтоимости.Количество() > 0 Тогда
		
		СведенияОбОбщейСтоимости = КонструкторЭД.СведенияОбОбщейСтоимости[0];
		ПараметрыДоговораДляЭДООбъект.СуммаНДС = СведенияОбОбщейСтоимости.СуммаНДС;
		ПараметрыДоговораДляЭДООбъект.Сумма = СведенияОбОбщейСтоимости.СуммаСНДС;
		
		КодВалюты = СведенияОбОбщейСтоимости.КодВалюты;
		НайтиСсылкуНаОбъект("Валюты", Валюта, КодВалюты);
		
		ПараметрыДоговораДляЭДООбъект.ВалютаРасчетов = Валюта;
	КонецЕсли;
		
	Если ЗначениеЗаполнено(КонструкторЭД.Предмет) Тогда
		СуммаСНДС = 0;
		СуммаНДС = 0;
		
		Для Каждого ТекСтрока Из КонструкторЭД.Предмет Цикл
			СуммаСНДС = СуммаСНДС + ТекСтрока.СуммаСНДС;
			СуммаНДС = СуммаНДС + ТекСтрока.СуммаНалога;
			
			НоваяСтрока = ПараметрыДоговораДляЭДООбъект.ПредметДоговора.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		КонецЦикла;	
		
		Если ПараметрыДоговораДляЭДООбъект.Сумма = 0 Тогда
			ПараметрыДоговораДляЭДООбъект.СуммаНДС = СуммаНДС;
			ПараметрыДоговораДляЭДООбъект.Сумма = СуммаСНДС;
		КонецЕсли;
	КонецЕсли;
  	
	Если ЗначениеЗаполнено(ИнформацияДокумента.СрокДействия) Тогда
		ПараметрыДоговораДляЭДООбъект.ДатаНачалаДействия = ИнформацияДокумента.СрокДействия.ДатаНачалаДействия;
		ПараметрыДоговораДляЭДООбъект.ДатаОкончанияДействия = ИнформацияДокумента.СрокДействия.ДатаОкончанияДействия;
		ПризнакиНаличияПролонгации = ИнформацияДокумента.СрокДействия.НаличиеПролонгации;
		Если ПризнакиНаличияПролонгации = КонструкторЭД.ПризнакиНаличияПролонгации().ОтсутствуетУсловиеПролонгации Тогда
			ПараметрыДоговораДляЭДООбъект.НаличиеПролонгации = Ложь;
		Иначе
			ПараметрыДоговораДляЭДООбъект.НаличиеПролонгации = Истина;
		КонецЕсли;
	КонецЕсли;
	
	ЗаписатьСправочник(ПараметрыДоговораДляЭДООбъект);
	
КонецПроцедуры

Функция СчетКонтрагентаДляДоговорногоДокумента101(Контрагент, ПараметрыСчета)

	НомерСчета = ПараметрыСчета.НомерСчета;
	
	Результат = СчетКонтрагента(Контрагент, НомерСчета);
	
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		//Создание нового счета
		УстановитьПривилегированныйРежим(Истина);

		СчетКонтрагента					 = Справочники.БанковскиеИКазначейскиеСчета.СоздатьЭлемент();
		СчетКонтрагента.Владелец		 = Контрагент;
		
		Если СтрДлина(НомерСчета) = 20 Тогда
			ТипЛицевогоСчета = Перечисления.ТипыЛицевыхСчетов.Банковский;
			СчетКонтрагента.Код			 = НомерСчета;
		Иначе
			//Для лицевого счета в казначействе не создается новый
			Возврат Результат;
		КонецЕсли;	
		
		СчетКонтрагента.ТипЛицевогоСчета = ТипЛицевогоСчета;
		СчетКонтрагента.Наименование	 = Строка(ПараметрыСчета.Наименование);
		Банк = Справочники.Банки.НайтиПоКоду(ПараметрыСчета.БИК);
		Если НЕ ЗначениеЗаполнено(Банк) Тогда
			ТЗБанки = Справочники.Банки.ПолучитьТаблицуБанковПоРеквизитам("Код", ПараметрыСчета.БИК);
			Если ТЗБанки.Количество()>0 Тогда
				Банк = ТЗБанки[0].Ссылка;
			КонецЕсли;	
		КонецЕсли;	
		Если ЗначениеЗаполнено(Банк) Тогда
			СчетКонтрагента.КассовыйОрган	 = Банк;
		Иначе
			ТекстСообщения = НСтр("ru='Банк расчетного счета %1 контрагента %2 не найден в справочнике банков и его следует указать вручную.'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ПараметрыСчета.НомерСчета, КОнтрагент);
			ЗаписьЖурналаРегистрации(ТекстСообщения, УровеньЖурналаРегистрации.Ошибка, Контрагент.Метаданные(), Контрагент,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецЕсли;	
		
		Попытка
			СчетКонтрагента.Записать();
		
			Результат = СчетКонтрагента.Ссылка;
		Исключение
			Текст = НСтр("ru = 'Ошибка создания расчетного счета контрагента при загрузке сведений государственного контракта'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Создание расчетного счета контрагента %1'"), Текст);
			ЗаписьЖурналаРегистрации(ТекстСообщения, УровеньЖурналаРегистрации.Ошибка, Контрагент.Метаданные(), Контрагент,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
			
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

Функция ДополнительныеПараметрыЭлектронногоДоговора(Договор) Экспорт
	Результат = Справочники.ПараметрыДоговораДляЭДО.ПустаяСсылка();	
	
	Если ЗначениеЗаполнено(Договор) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ПараметрыДоговораДляЭДО.Ссылка КАК Ссылка
		               |ИЗ
		               |	Справочник.ПараметрыДоговораДляЭДО КАК ПараметрыДоговораДляЭДО
		               |ГДЕ
		               |	ПараметрыДоговораДляЭДО.Договор = &Договор
		               |	И ПараметрыДоговораДляЭДО.ПометкаУдаления = ЛОЖЬ";
		Запрос.УстановитьПараметр("Договор", Договор);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Результат = Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

Процедура ЗаполнитьСоответствиеВидовДоговоровКонтрагентов(Соответствие) Экспорт

	Соответствие.Вставить("С поставщиком", Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком);
	Соответствие.Вставить("С покупателем", Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
	Соответствие.Вставить("С комитентом (принципалом) на продажу", Перечисления.ВидыДоговоровКонтрагентов.СКомитентом);
	Соответствие.Вставить("С комитентом (принципалом) на закупку", Перечисления.ВидыДоговоровКонтрагентов.СКомитентомНаЗакупку);
	Соответствие.Вставить("Выпуск ценных бумаг", Перечисления.ВидыДоговоровКонтрагентов.ВыпускЦенныхБумаг);
	Соответствие.Вставить("Полученный кредит", Перечисления.ВидыДоговоровКонтрагентов.ПолученныйКредит);
	Соответствие.Вставить("Предоставленная гарантия", Перечисления.ВидыДоговоровКонтрагентов.ПредоставленнаяГарантия);
	Соответствие.Вставить("Предоставленный кредит (заем)", Перечисления.ВидыДоговоровКонтрагентов.ПредоставленныйКредит);
	Соответствие.Вставить("С получателем трансферта (субсидии)", Перечисления.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии);
	Соответствие.Вставить("С отправителем трансферта (субсидии)", Перечисления.ВидыДоговоровКонтрагентов.СОтправителемТрансферта);
	Соответствие.Вставить("Прочее", Перечисления.ВидыДоговоровКонтрагентов.ИноеОбязательство);
	
КонецПроцедуры

Процедура ЗаполнитьСоответствиеВидовДоговоровПротивоположноеЗначениюКонтрагентов(Соответствие) Экспорт
	
	Соответствие.Вставить("С покупателем", Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком);
	Соответствие.Вставить("С поставщиком", Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
	Соответствие.Вставить("С комиссионером (агентом) на продажу", Перечисления.ВидыДоговоровКонтрагентов.СКомитентом);
	Соответствие.Вставить("С комитентом (принципалом) на продажу", Перечисления.ВидыДоговоровКонтрагентов.ИноеОбязательство);
	Соответствие.Вставить("С комиссионером (агентом) на закупку", Перечисления.ВидыДоговоровКонтрагентов.СКомитентомНаЗакупку);
	Соответствие.Вставить("С комитентом (принципалом) на закупку", Перечисления.ВидыДоговоровКонтрагентов.ИноеОбязательство);
	Соответствие.Вставить("Прочее", Перечисления.ВидыДоговоровКонтрагентов.ИноеОбязательство);

КонецПроцедуры

Функция ОрганизацияПоДаннымДоговорногоДокумента101(Данные, ТипыСторон)
	
	Организация = Справочники.Организации.ПустаяСсылка();
	
	ИНН = Данные.ИНН;
	Если Данные.КПП.Количество() > 0 Тогда
		КПП = Данные.КПП[0];
	Иначе
		КПП = "";
	КонецЕсли;

	ДополнительныеРеквизиты = Новый Структура("ИНН, КПП", ИНН, КПП); 
	НайтиСсылкуНаОбъект("Организации", Организация, , ДополнительныеРеквизиты);

	Возврат Организация;
	
КонецФункции

Функция КонтрагентПоДаннымДоговорногоДокумента101(Данные, ТипыСторон)
	
	Контрагент = Справочники.Контрагенты.ПустаяСсылка();
	
	ИНН = Данные.ИНН;
	Если Данные.КПП.Количество() > 0 Тогда
		КПП = Данные.КПП[0];
	Иначе
		КПП = "";
	КонецЕсли;

	ДополнительныеРеквизиты = Новый Структура("ИНН, КПП", ИНН, КПП); 
	НайтиСсылкуНаОбъект("Контрагенты", Контрагент, , ДополнительныеРеквизиты);
	
	Возврат Контрагент;
	
КонецФункции

Процедура ЗаписатьСправочник(СправочникОбъект)
	
	СправочникОбъект.ДополнительныеСвойства.Вставить("ПроверитьЗаполнениеБезВыводаОшибок");
	
	Если СправочникОбъект.ЭтоНовый() И СправочникОбъект.ПроверитьЗаполнение() Тогда
		СправочникОбъект.ОбменДанными.Загрузка = Ложь;
		СправочникОбъект.Записать();
	Иначе
		СправочникОбъект.ОбменДанными.Загрузка = Истина;
		СправочникОбъект.Записать();
	КонецЕсли;
	
КонецПроцедуры

Функция ПараметрыДоговораДляЭДО(СсылкаНаОбъект) Экспорт
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ПараметрыДоговораДляЭДО.ДатаНачалаДействия КАК ДатаНачалаДействия,
	               |	ПараметрыДоговораДляЭДО.ДатаОкончанияДействия КАК ДатаОкончанияДействия,
	               |	ПараметрыДоговораДляЭДО.Сумма КАК Сумма,
	               |	ПараметрыДоговораДляЭДО.СуммаНДС КАК СуммаНДС,
	               |	ПараметрыДоговораДляЭДО.НаличиеПролонгации КАК НаличиеПролонгации,
	               |	ПараметрыДоговораДляЭДО.РеквизитыЛицевогоСчета КАК РеквизитыЛицевогоСчета,
	               |	ПараметрыДоговораДляЭДО.РасчетныйСчетКонтрагента КАК РасчетныйСчетКонтрагента,
	               |	ПараметрыДоговораДляЭДО.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ПараметрыДоговораДляЭДО КАК ПараметрыДоговораДляЭДО
	               |ГДЕ
	               |	ПараметрыДоговораДляЭДО.Договор = &Ссылка
	               |	И ПараметрыДоговораДляЭДО.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
    	Результат = Выборка;
	КонецЕсли;	

	Возврат Результат;
КонецФункции

// См. ОбменСКонтрагентамиПереопределяемый.ПриОтраженииВУчетеДоговорногоДокумента101.
Процедура ПриОтраженииВУчетеДоговорногоДокумента101(РезультатОтраженияВУчете, Знач ДанныеЭлектронногоДокумента,
	Знач ПараметрыДляОтраженияВУчете) Экспорт

	ИнформацияДокумента = ДанныеЭлектронногоДокумента.ИнформацияДокумента[0];
	
	// Если документ не соответствует ограничениям, то не распознаем.
	Если НЕ (ИнформацияДокумента.ФункцияДокумента = ДанныеЭлектронногоДокумента.ФункцииДокумента().Дог
		И ИнформацияДокумента.ПризнакПорядкаФормирования = ДанныеЭлектронногоДокумента.ПризнакиПорядкаФормирования().НеОферта) Тогда
		РезультатОтраженияВУчете.ОписаниеОшибки = НСтр("ru = 'Данный вид договора не поддерживается.'");
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РезультатОтраженияВУчете.ДокументУчета) Тогда
		СправочникОбъект = РезультатОтраженияВУчете.ДокументУчета.ПолучитьОбъект();
	Иначе
		СправочникОбъект = Справочники.Договоры.СоздатьЭлемент();
	КонецЕсли;
	
	СправочникОбъект.ЭтоЭлектронныйДокумент = Истина;

	СоответствиеПротивоположныхВидовДоговоров = Новый Соответствие;
	ЗаполнитьСоответствиеВидовДоговоровПротивоположноеЗначениюКонтрагентов(СоответствиеПротивоположныхВидовДоговоров);
	ВидДоговора = СоответствиеПротивоположныхВидовДоговоров.Получить(ИнформацияДокумента.ТипДоговора);
	СправочникОбъект.ВидДоговора = ?(ЗначениеЗаполнено(ВидДоговора), ВидДоговора, Перечисления.ВидыДоговоровКонтрагентов.ИноеОбязательство);
	СправочникОбъект.ДатаДоговора = ИнформацияДокумента.ДатаДоговора;
	СправочникОбъект.НомерДоговора = ИнформацияДокумента.НомерДоговора;
	
	Если ЗначениеЗаполнено(СправочникОбъект.НомерДоговора) Тогда
		Если НРег(СправочникОбъект.НомерДоговора) <> "без номера (б/н)" Тогда
			СправочникОбъект.Наименование = СтрШаблон(НСтр("ru = 'Договор № %1'"), СправочникОбъект.НомерДоговора);
		Иначе
			СправочникОбъект.Наименование = СтрШаблон(НСтр("ru = 'Договор %1'"), СправочникОбъект.НомерДоговора);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СправочникОбъект.ДатаДоговора) Тогда
			СправочникОбъект.Наименование = СтрШаблон(НСтр("ru = '%1 от %2'"), СправочникОбъект.Наименование,
				Формат(СправочникОбъект.ДатаДоговора, "ДФ=dd.MM.yyyy;"));
		КонецЕсли;
	КонецЕсли;
	
	ТипыСторон = Обработки.ФорматДоговорныйДокумент101.ТипыСторонДоговора();
	Организация = ОрганизацияПоДаннымДоговорногоДокумента101(ИнформацияДокумента.Контрагент.ИдентификационныеСведения, ТипыСторон);
	СправочникОбъект.Организация = Организация;
	
	Контрагент = КонтрагентПоДаннымДоговорногоДокумента101(ИнформацияДокумента.Организация.ИдентификационныеСведения, ТипыСторон);
	СправочникОбъект.Контрагент = Контрагент;
	СчетКонтрагента = СчетКонтрагентаДляДоговорногоДокумента101(Контрагент, ИнформацияДокумента.Контрагент.БанковскиеРеквизиты);
	Если НЕ ЗначениеЗаполнено(СправочникОбъект.СчетКонтрагента) Тогда
		СправочникОбъект.СчетКонтрагента = СчетКонтрагента;
	КонецЕсли;
			
	ЗаписатьСправочник(СправочникОбъект);
	ДокументУчета = СправочникОбъект.Ссылка;
	
	//Заполнение связанного элемента справочника параметров договора для ЭДО
	ПараметрыДоговораДляЭДО = ПараметрыДоговораДляЭДО(ДокументУчета);
	
	Если ЗначениеЗаполнено(ПараметрыДоговораДляЭДО) Тогда
		ПараметрыДоговораДляЭДООбъект = ПараметрыДоговораДляЭДО.ПолучитьОбъект();
	Иначе
		ПараметрыДоговораДляЭДООбъект = Справочники.ПараметрыДоговораДляЭДО.СоздатьЭлемент();
	КонецЕсли;
	ПараметрыДоговораДляЭДООбъект.ВходящийЭД = Истина;
	ПараметрыДоговораДляЭДООбъект.Организация = Организация;
	ПараметрыДоговораДляЭДООбъект.Договор = ДокументУчета;
	ПараметрыДоговораДляЭДООбъект.Контрагент = Контрагент;
	ПараметрыДоговораДляЭДООбъект.РасчетныйСчетКонтрагента = СчетКонтрагента;
	
	Если ИнформацияДокумента.ФункцияДокумента = ДанныеЭлектронногоДокумента.ФункцииДокумента().Дог Тогда
		ПараметрыДоговораДляЭДООбъект.ФункцияЭД = 0;
	ИначеЕсли ИнформацияДокумента.ФункцияДокумента = ДанныеЭлектронногоДокумента.ФункцииДокумента().Прораз Тогда
		ПараметрыДоговораДляЭДООбъект.ФункцияЭД = 1;
	ИначеЕсли ИнформацияДокумента.ФункцияДокумента = ДанныеЭлектронногоДокумента.ФункцииДокумента().Допсогл Тогда
		ПараметрыДоговораДляЭДООбъект.ФункцияЭД = 2;
	КонецЕсли;	
	
	ПараметрыДоговораДляЭДООбъект.Наименование = СокрЛП(СправочникОбъект.Наименование);
	ПараметрыДоговораДляЭДООбъект.СуммаНДС = 0;
	ПараметрыДоговораДляЭДООбъект.Сумма = 0;
	ПараметрыДоговораДляЭДООбъект.ВалютаДоговора = Справочники.Валюты.ПустаяСсылка();
	ПараметрыДоговораДляЭДООбъект.ВалютаРасчетов = Справочники.Валюты.ПустаяСсылка();
	ПараметрыДоговораДляЭДООбъект.НаличиеПролонгации = Ложь;
	ПараметрыДоговораДляЭДООбъект.ДатаНачалаДействия = Дата(1, 1, 1);
	ПараметрыДоговораДляЭДООбъект.ДатаОкончанияДействия = Дата(1, 1, 1);

	ПараметрыДоговораДляЭДООбъект.МестоЗаключенияДоговора = ИнформацияДокумента.МестоЗаключенияДоговора;
	
	Валюта = Справочники.Валюты.ПустаяСсылка();
	Если ЗначениеЗаполнено(ДанныеЭлектронногоДокумента.СведенияОбОбщейСтоимости)
		И ДанныеЭлектронногоДокумента.СведенияОбОбщейСтоимости.Количество() > 0 Тогда
		
		СведенияОбОбщейСтоимости = ДанныеЭлектронногоДокумента.СведенияОбОбщейСтоимости[0];
		ПараметрыДоговораДляЭДООбъект.СуммаНДС = СведенияОбОбщейСтоимости.СуммаНДС;
		ПараметрыДоговораДляЭДООбъект.Сумма = СведенияОбОбщейСтоимости.СуммаСНДС;
		
		КодВалюты = СведенияОбОбщейСтоимости.КодВалюты;
		НайтиСсылкуНаОбъект("Валюты", Валюта, КодВалюты);
		
		ПараметрыДоговораДляЭДООбъект.ВалютаРасчетов = Валюта;
	КонецЕсли;
		
	Если ЗначениеЗаполнено(ДанныеЭлектронногоДокумента.Предмет) Тогда
		СуммаСНДС = 0;
		СуммаНДС = 0;
		
		Для Каждого ТекСтрока Из ДанныеЭлектронногоДокумента.Предмет Цикл
			СуммаСНДС = СуммаСНДС + ТекСтрока.СуммаСНДС;
			СуммаНДС = СуммаНДС + ТекСтрока.СуммаНалога;
			
			НоваяСтрока = ПараметрыДоговораДляЭДООбъект.ПредметДоговора.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		КонецЦикла;	
		
		Если ПараметрыДоговораДляЭДООбъект.Сумма = 0 Тогда
			ПараметрыДоговораДляЭДООбъект.СуммаНДС = СуммаНДС;
			ПараметрыДоговораДляЭДООбъект.Сумма = СуммаСНДС;
		КонецЕсли;
	КонецЕсли;
  	
	Если ЗначениеЗаполнено(ИнформацияДокумента.СрокДействия) Тогда
		ПараметрыДоговораДляЭДООбъект.ДатаНачалаДействия = ИнформацияДокумента.СрокДействия.ДатаНачалаДействия;
		ПараметрыДоговораДляЭДООбъект.ДатаОкончанияДействия = ИнформацияДокумента.СрокДействия.ДатаОкончанияДействия;
		ПризнакиНаличияПролонгации = ИнформацияДокумента.СрокДействия.НаличиеПролонгации;
		Если ПризнакиНаличияПролонгации = ДанныеЭлектронногоДокумента.ПризнакиНаличияПролонгации().ОтсутствуетУсловиеПролонгации Тогда
			ПараметрыДоговораДляЭДООбъект.НаличиеПролонгации = Ложь;
		Иначе
			ПараметрыДоговораДляЭДООбъект.НаличиеПролонгации = Истина;
		КонецЕсли;
	КонецЕсли;
	
	ЗаписатьСправочник(ПараметрыДоговораДляЭДООбъект);
