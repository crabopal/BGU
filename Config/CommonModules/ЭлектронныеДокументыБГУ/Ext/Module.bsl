// Сопоставление номенклатуры

// Получает значение перечисления по имени перечисления и представлению в библиотеке.
// 
// Параметры:
//  ИмяПеречисления - Строка, наименование перечисления.
//  ПредставлениеПеречисления - Строка, наименование значения перечисления.
//  НайденноеЗначение - значение искомого перечисления.
//
Процедура ПолучитьЗначениеПеречисления(ИмяПеречисления, ПредставлениеПеречисления, НайденноеЗначение) Экспорт
	
	Для Каждого ЭлПеречисления Из Метаданные.Перечисления[ИмяПеречисления].ЗначенияПеречисления Цикл
		Если Найти(Врег(ЭлПеречисления.Синоним), Врег(ПредставлениеПеречисления)) > 0
			ИЛИ Найти(Врег(ЭлПеречисления.Имя), Врег(ПредставлениеПеречисления)) > 0 Тогда
			НайденноеЗначение = Перечисления[ИмяПеречисления][ЭлПеречисления.Имя];
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция КонтактныеДанныеXML(ЮрФизЛицо) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("ЮридическийАдресXML", "");
	Результат.Вставить("ЮридическийАдрес", "");
	Результат.Вставить("ФактическийАдресXML", "");
	Результат.Вставить("ФактическийАдрес", "");
	Результат.Вставить("ПочтовыйАдресXML", "");
	Результат.Вставить("ПочтовыйАдрес", "");
	Результат.Вставить("ТелефоныXML", "");
	Результат.Вставить("Телефоны", "");
	Результат.Вставить("ЭлектроннаяПочта", "");
	
	ТаблицаКИ = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ЮрФизЛицо,,,Ложь);
	
	Для Каждого СтрокаТаблицыКИ Из ТаблицаКИ Цикл
		
		Если СтрокаТаблицыКИ.Вид = Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации            
			ИЛИ СтрокаТаблицыКИ.Вид = Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты 
			ИЛИ СтрокаТаблицыКИ.Вид = Справочники.ВидыКонтактнойИнформации.АдресПоПропискеФизическиеЛица Тогда
			
			Результат.ЮридическийАдресXML = СтрокаТаблицыКИ.ЗначенияПолей;
			Результат.ЮридическийАдрес = СтрокаТаблицыКИ.Представление;
		ИначеЕсли СтрокаТаблицыКИ.Вид = Справочники.ВидыКонтактнойИнформации.ФактАдресОрганизации     
			ИЛИ СтрокаТаблицыКИ.Вид = Справочники.ВидыКонтактнойИнформации.ФактическийАдресПодразделенияОрганизаций
			ИЛИ СтрокаТаблицыКИ.Вид = Справочники.ВидыКонтактнойИнформации.ФактическийАдресКонтрагенты Тогда
			
			Результат.ФактическийАдресXML = СтрокаТаблицыКИ.ЗначенияПолей;
			Результат.ФактическийАдрес = СтрокаТаблицыКИ.Представление;
			
		ИначеЕсли СтрокаТаблицыКИ.Вид = Справочники.ВидыКонтактнойИнформации.ПочтовыйАдресОрганизации
			ИЛИ СтрокаТаблицыКИ.Вид = Справочники.ВидыКонтактнойИнформации.АдресДляИнформированияФизическиеЛица Тогда
			
			Результат.ПочтовыйАдресXML = СтрокаТаблицыКИ.ЗначенияПолей;
			Результат.ПочтовыйАдрес = СтрокаТаблицыКИ.Представление;
			
		ИначеЕсли СтрокаТаблицыКИ.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации
			ИЛИ СтрокаТаблицыКИ.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонРабочийФизическиеЛица
			ИЛИ СтрокаТаблицыКИ.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонПодразделенияОрганизаций
			ИЛИ СтрокаТаблицыКИ.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагенты Тогда
			
			Результат.ТелефоныXML = СтрокаТаблицыКИ.ЗначенияПолей;
			Результат.Телефоны = СтрокаТаблицыКИ.Представление;
			
		ИначеЕсли СтрокаТаблицыКИ.Вид = Справочники.ВидыКонтактнойИнформации.EmailОрганизации
			ИЛИ СтрокаТаблицыКИ.Вид = Справочники.ВидыКонтактнойИнформации.EmailПодразделенияОрганизаций
			ИЛИ СтрокаТаблицыКИ.Вид = Справочники.ВидыКонтактнойИнформации.EmailФизическиеЛица
			ИЛИ СтрокаТаблицыКИ.Вид = Справочники.ВидыКонтактнойИнформации.EmailКонтрагенты Тогда
			
			Результат.ЭлектроннаяПочта = СтрокаТаблицыКИ.Представление;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
КонецФункции	

// Получает данные о физическом (юридическом) лице по ссылке.
//
// Параметры:
//  ЮрФизЛицо - Ссылка на элемент справочника, по которому надо получить данные.
//
Процедура ПолучитьДанныеЮрФизЛица(ЮрФизЛицо, Сведения, ДатаСведений = Неопределено, ЭтоСчетФактура = Ложь) Экспорт
	
	ДатаПолученияДанных = ?(ДатаСведений = Неопределено, ТекущаяДатаСеанса(), ДатаСведений);
	
	КонтактныеДанныеXML = КонтактныеДанныеXML(ЮрФизЛицо);	
	
	Если ТипЗнч(ЮрФизЛицо) = Тип("СправочникСсылка.Организации") Тогда
		СтруктураДанных = Новый Структура("ДанныеУчреждения, КИУчреждения");
		
		ЮрАдресУчреждения = "";
		ТелефонОрганизации = "";
		ФамилияРуководителя = "";
		ИмяРуководителя = "";
		ОтчествоРуководителя = "";
		ДолжностьРуководителя = "";
		
		ЮрАдресУчреждения = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ЮрФизЛицо, Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);
		ФактАдресУчреждения = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ЮрФизЛицо, Справочники.ВидыКонтактнойИнформации.ФактАдресОрганизации);
		ТелефонОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ЮрФизЛицо, Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации);
		ЭлектроннаяПочтаОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ЮрФизЛицо, Справочники.ВидыКонтактнойИнформации.EmailОрганизации);
		
		Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации("Руководитель", ЮрФизЛицо, ДатаПолученияДанных,);
		Если ТипЗнч(Руководитель) = Тип("Структура") Тогда
			ФамилияРуководителя = Руководитель.ОтветственноеЛицоФамилия;
			ИмяРуководителя = Руководитель.ОтветственноеЛицоИмя;
			ОтчествоРуководителя = Руководитель.ОтветственноеЛицоОтчество;
			ДолжностьРуководителя = Руководитель.ДолжностьПредставление;
		КонецЕсли;
		
		ЛицевыеСчетаОрганизации = ЛицевыеСчетаОрганизации(ЮрФизЛицо);
		
		СвойстваОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЮрФизЛицо, "НаименованиеСокращенное, НаименованиеПолное,ИНН,КПП,КодОКПО,КодПоППП,КодПоРПБС,ОГРН");
		
		СтруктураДанных.Вставить("ВидКонтрагента", Перечисления.ЮрФизЛицо.ЮрЛицо);
		СтруктураДанных.Вставить("Телефоны", ТелефонОрганизации);
		СтруктураДанных.Вставить("ЭлектроннаяПочта", ЭлектроннаяПочтаОрганизации);
		СтруктураДанных.Вставить("ЮридическийАдрес", ЮрАдресУчреждения);
		СтруктураДанных.Вставить("ФактическийАдрес", ?(ЗначениеЗаполнено(ФактАдресУчреждения),ФактАдресУчреждения,ЮрАдресУчреждения));
		СтруктураДанных.Вставить("КодОКПО", СвойстваОрганизации.КодОКПО);
		СтруктураДанных.Вставить("НаименованиеПолное", СвойстваОрганизации.НаименованиеПолное);
		СтруктураДанных.Вставить("Наименование", СвойстваОрганизации.НаименованиеПолное);
		СтруктураДанных.Вставить("ИНН", СвойстваОрганизации.ИНН);
		СтруктураДанных.Вставить("КПП", СвойстваОрганизации.КПП);
		СтруктураДанных.Вставить("КодПоППП", СвойстваОрганизации.КодПоППП);
		СтруктураДанных.Вставить("КодПоРПБС", СвойстваОрганизации.КодПоРПБС);
		СтруктураДанных.Вставить("ФамилияРуководителя", ФамилияРуководителя);
		СтруктураДанных.Вставить("ИмяРуководителя", ИмяРуководителя);
		СтруктураДанных.Вставить("ОтчествоРуководителя", ОтчествоРуководителя);
		СтруктураДанных.Вставить("ДолжностьРуководителя", ДолжностьРуководителя);
		СтруктураДанных.Вставить("ЛицевыеСчета", ЛицевыеСчетаОрганизации);
		СтруктураДанных.Вставить("СтранаРегистрации", Справочники.СтраныМира.Россия);
		СтруктураДанных.Вставить("ОГРН", СвойстваОрганизации.ОГРН);
		СтруктураДанных.Вставить("ИП", Ложь);
		СтруктураДанных.Вставить("СокращенноеНаименование", СвойстваОрганизации.НаименованиеСокращенное);

		СтруктураДанных.Вставить("ЮридическийАдресXML", КонтактныеДанныеXML.ЮридическийАдресXML);
		СтруктураДанных.Вставить("ФактическийАдресXML", КонтактныеДанныеXML.ФактическийАдресXML);
		СтруктураДанных.Вставить("ПочтовыйАдресXML", КонтактныеДанныеXML.ПочтовыйАдресXML);
		
		НаименованиеОрганизации = СтруктураДанных.НаименованиеПолное;
		
		Если ЭтоСчетФактура Тогда
			ГоловнаяОрганизация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЮрФизЛицо, "ГоловнаяОрганизация");
			Если ЗначениеЗаполнено(ГоловнаяОрганизация) Тогда
				НаименованиеОрганизации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ГоловнаяОрганизация, "НаименованиеПолное");
				СтруктураДанных.НаименованиеПолное = НаименованиеОрганизации;
			КонецЕсли;	
		КонецЕсли;	
		
	ИначеЕсли ТипЗнч(ЮрФизЛицо) = Тип("СправочникСсылка.Подразделения") Тогда
		
		Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЮрФизЛицо, "Владелец");
		
		СвойстваОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Организация, "ИНН,КодОКПО,КодПоППП, КодПоРПБС");
		
		СвойстваПодразделения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЮрФизЛицо, "РегистрацияВНалоговомОргане,НаименованиеПолное");
		
		СвойстваРегистрацииВНО = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СвойстваПодразделения.РегистрацияВНалоговомОргане, "КПП");
		
		СтруктураДанных = Новый Структура("ДанныеУчреждения, КИУчреждения");
		
		ЮрАдресУчреждения = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(Организация, Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);
		ФактАдресУчреждения = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ЮрФизЛицо, Справочники.ВидыКонтактнойИнформации.ФактическийАдресПодразделенияОрганизаций);
		ТелефонОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ЮрФизЛицо, Справочники.ВидыКонтактнойИнформации.ТелефонПодразделенияОрганизаций);
		ЭлектроннаяПочтаОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ЮрФизЛицо, Справочники.ВидыКонтактнойИнформации.EmailПодразделенияОрганизаций);
		
		Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации("Руководитель", Организация, ДатаПолученияДанных, ЮрФизЛицо);
		
		Если ТипЗнч(Руководитель) = Тип("Структура") Тогда
			ФамилияРуководителя		= Руководитель.ОтветственноеЛицоФамилия;
			ИмяРуководителя			= Руководитель.ОтветственноеЛицоИмя;
			ОтчествоРуководителя	= Руководитель.ОтветственноеЛицоОтчество;
			ДолжностьРуководителя	= Руководитель.ДолжностьПредставление;
		Иначе
			ФамилияРуководителя		= "";
			ИмяРуководителя			= "";
			ОтчествоРуководителя	= "";
			ДолжностьРуководителя 	= "";
		КонецЕсли;
		
		ЛицевыеСчетаОрганизации = ЛицевыеСчетаОрганизации(Организация);
		
		СтруктураДанных.Вставить("СтранаРегистрации", 		Справочники.СтраныМира.Россия);
		СтруктураДанных.Вставить("ВидКонтрагента",			Перечисления.ЮрФизЛицо.ЮрЛицо);
		СтруктураДанных.Вставить("Телефоны",				ТелефонОрганизации);
		СтруктураДанных.Вставить("ЭлектроннаяПочта",		ЭлектроннаяПочтаОрганизации);
		СтруктураДанных.Вставить("ЮридическийАдрес",		ЮрАдресУчреждения);
		СтруктураДанных.Вставить("ФактическийАдрес", ?(ЗначениеЗаполнено(ФактАдресУчреждения),ФактАдресУчреждения,ЮрАдресУчреждения));
		СтруктураДанных.Вставить("КодОКПО",					СвойстваОрганизации.КодОКПО);
		СтруктураДанных.Вставить("НаименованиеПолное",		СвойстваПодразделения.НаименованиеПолное);
		СтруктураДанных.Вставить("Наименование", 			СтруктураДанных.НаименованиеПолное);
		СтруктураДанных.Вставить("ИНН",						СвойстваОрганизации.ИНН);
		СтруктураДанных.Вставить("КПП",						СвойстваРегистрацииВНО.КПП);
		СтруктураДанных.Вставить("КодПоППП",				СвойстваОрганизации.КодПоППП);
		СтруктураДанных.Вставить("КодПоРПБС",				СвойстваОрганизации.КодПоРПБС);
		
		СтруктураДанных.Вставить("ФамилияРуководителя", 	ФамилияРуководителя);
		СтруктураДанных.Вставить("ИмяРуководителя",			ИмяРуководителя);
		СтруктураДанных.Вставить("ОтчествоРуководителя",	ОтчествоРуководителя);
		СтруктураДанных.Вставить("ДолжностьРуководителя",	ДолжностьРуководителя);
		СтруктураДанных.Вставить("ЛицевыеСчета",			ЛицевыеСчетаОрганизации);
		СтруктураДанных.Вставить("ИП", Ложь);
		
		СтруктураДанных.Вставить("ЮридическийАдресXML", КонтактныеДанныеXML.ЮридическийАдресXML);
		СтруктураДанных.Вставить("ФактическийАдресXML", КонтактныеДанныеXML.ФактическийАдресXML);
		СтруктураДанных.Вставить("ПочтовыйАдресXML", КонтактныеДанныеXML.ПочтовыйАдресXML);
		
		НаименованиеОрганизации = СтруктураДанных.НаименованиеПолное;
		
	Иначе	
		// Справочник Контрагенты
		
		СтруктураДанных = Новый Структура("ДанныеКонтрагента, КИКонтрагента");
		
		ЮрФизЛицоКИ = ЮрФизЛицо.ЮридическоеФизическоеЛицо;
		
		ВидКонтрагента = ?(ТипЗнч(ЮрФизЛицоКИ) = Тип("СправочникСсылка.ФизическиеЛица"),
			Перечисления.ЮрФизЛицо.ФизЛицо,
			Перечисления.ЮрФизЛицо.ЮрЛицо);
		
		СтруктураДанных.Вставить("ВидКонтрагента", ВидКонтрагента);
		
		ЮрАдресУчреждения = "";
		ТелефонОрганизации = "";
		ЮрАдресФизЛица = "";
		ТелефонФизЛица = "";
		
		ЮрАдресУчреждения = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ЮрФизЛицоКИ, Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты);
		ФактАдресУчреждения = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ЮрФизЛицо, Справочники.ВидыКонтактнойИнформации.ФактическийАдресКонтрагенты);
		ЮрАдресФизЛица = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ЮрФизЛицоКИ, Справочники.ВидыКонтактнойИнформации.АдресПоПропискеФизическиеЛица);
		ТелефонОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ЮрФизЛицоКИ, Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагенты);
		ТелефонФизЛица = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ЮрФизЛицоКИ, Справочники.ВидыКонтактнойИнформации.ТелефонРабочийФизическиеЛица);
		Если НЕ ЗначениеЗаполнено(ТелефонФизЛица) Тогда
			ТелефонФизЛица = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ЮрФизЛицоКИ, Справочники.ВидыКонтактнойИнформации.ТелефонДомашнийФизическиеЛица);
		КонецЕсли;	
		ЭлектроннаяПочтаЮЛ = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ЮрФизЛицо, Справочники.ВидыКонтактнойИнформации.EmailКонтрагенты);
		ЭлектроннаяПочтаФЛ = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ЮрФизЛицо, Справочники.ВидыКонтактнойИнформации.EmailФизическиеЛица);
		
		Если СтруктураДанных.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
			СтруктураДанных.Вставить("Телефоны", ТелефонОрганизации);
			СтруктураДанных.Вставить("Юридическийадрес", ЮрАдресУчреждения);
			СтруктураДанныхЛица = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЮрФизЛицоКИ, "КодОКПО, НаименованиеПолное, КодПоППП, КодПоРПБС, СтранаРегистрации, ОГРН, НалоговыйНомер");
			Если СтруктураДанныхЛица.Свойство("КодОКПО") Тогда
				КодОКПО = СтруктураДанныхЛица.КодОКПО;
			Иначе
				КодОКПО = "";	
			КонецЕсли;
			
			Если СтруктураДанныхЛица.Свойство("НаименованиеПолное") Тогда
				НаименованиеПолное = СтруктураДанныхЛица.НаименованиеПолное;
			Иначе
				НаименованиеПолное = "";	
			КонецЕсли;
			
			Если СтруктураДанныхЛица.Свойство("КодПоППП") Тогда
				КодПоППП = СтруктураДанныхЛица.КодПоППП;
			Иначе
				КодПоППП = "";	
			КонецЕсли;
			
			Если СтруктураДанныхЛица.Свойство("КодПоРПБС") Тогда
				КодПоРПБС = СтруктураДанныхЛица.КодПоРПБС;
			Иначе
				КодПоРПБС = "";	
			КонецЕсли;
			
			Если СтруктураДанныхЛица.Свойство("ОГРН") Тогда
				ОГРН = СтруктураДанныхЛица.ОГРН;
			Иначе
				ОГРН = "";	
			КонецЕсли;
			
			Если СтруктураДанныхЛица.Свойство("СтранаРегистрации") Тогда
				СтранаРегистрации = СтруктураДанныхЛица.СтранаРегистрации;
			Иначе
				СтранаРегистрации = Справочники.СтраныМира.Россия;	
			КонецЕсли;
			
			СтруктураДанных.Вставить("КодОКПО", КодОКПО);
			СтруктураДанных.Вставить("КодПоППП", КодПоППП);
			СтруктураДанных.Вставить("КодПоРПБС", КодПоРПБС);
			СтруктураДанных.Вставить("ОГРН", ОГРН);
			СтруктураДанных.Вставить("НалоговыйНомерВСтранеРегистрации", СтруктураДанныхЛица.НалоговыйНомер);
			СтруктураДанных.Вставить("СтранаРегистрации", ?(ЗначениеЗаполнено(СтранаРегистрации), СтранаРегистрации, Справочники.СтраныМира.Россия));
			
			Если ЗначениеЗаполнено(НаименованиеПолное) Тогда
				СтруктураДанных.Вставить("НаименованиеПолное", НаименованиеПолное);
			ИначеЕсли ЗначениеЗаполнено(ЮрФизЛицо.НаименованиеСокращенное) Тогда	
				СтруктураДанных.Вставить("НаименованиеПолное", ЮрФизЛицо.НаименованиеСокращенное);
			Иначе
				СтруктураДанных.Вставить("НаименованиеПолное", ЮрФизЛицо.Наименование);
			КонецЕсли;
			СтруктураДанных.Вставить("Наименование", СтруктураДанных.НаименованиеПолное);
			СтруктураДанных.Вставить("ИНН", ЮрФизЛицо.ИНН);
			СтруктураДанных.Вставить("КПП", ЮрФизЛицо.КПП);
			СтруктураДанных.Вставить("ЭлектроннаяПочта", ЭлектроннаяПочтаЮЛ);
			СтруктураДанных.Вставить("ФактическийАдрес", ?(ЗначениеЗаполнено(ФактАдресУчреждения),ФактАдресУчреждения,ЮрАдресУчреждения));
			СтруктураДанных.Вставить("ИП", Ложь);
			
			СтруктураДанных.Вставить("ЮридическийАдресXML", КонтактныеДанныеXML.ЮридическийАдресXML);
			СтруктураДанных.Вставить("ФактическийАдресXML", КонтактныеДанныеXML.ФактическийАдресXML);
			СтруктураДанных.Вставить("ПочтовыйАдресXML", КонтактныеДанныеXML.ПочтовыйАдресXML);
			
		Иначе
			ЗначенияРеквизитовИП = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЮрФизЛицоКИ,
				"ОГРНИП, ДатаРегистрации, СвидетельствоСерияНомер, СвидетельствоДата, СтранаРегистрации, СтраховойНомерПФР");
			
			СтранаРегистрации = ЗначенияРеквизитовИП.СтранаРегистрации;
			СтруктураДанных.Вставить("СтранаРегистрации", ?(ЗначениеЗаполнено(СтранаРегистрации), СтранаРегистрации, Справочники.СтраныМира.Россия));
			
			СтруктураДанных.Вставить("Телефоны", ТелефонФизЛица);
			СтруктураДанных.Вставить("АдресРегистрации", ЮрАдресФизЛица);
			СтруктураДанных.Вставить("ФактическийАдрес", ЮрАдресФизЛица);
			СтруктураДанных.Вставить("КодОКПО", "");
			СтруктураДанных.Вставить("КодПоРПБС", "");
			
			НаименованиеПолное = ЮрФизЛицо.НаименованиеСокращенное;
			Если НЕ ЗначениеЗаполнено(НаименованиеПолное) Тогда
				НаименованиеПолное = ЮрФизЛицо.Наименование; 
			КонецЕсли;	
			Если НЕ ЗначениеЗаполнено(НаименованиеПолное) Тогда
				НаименованиеПолное = СокрЛП(ЮрФизЛицо); 
			КонецЕсли;	
			
			СтруктураДанных.Вставить("НаименованиеПолное", НаименованиеПолное);
			СтруктураДанных.Вставить("Наименование", СтруктураДанных.НаименованиеПолное);
			СтруктураДанных.Вставить("ИНН", ЮрФизЛицо.ИНН);
			СтруктураДанных.Вставить("КПП", "");
			СтруктураФИО = ФизическиеЛицаКлиентСервер.ЧастиИмени(ЮрФизЛицо.Наименование);
			СтруктураДанных.Вставить("Фамилия", СтруктураФИО.Фамилия);
			СтруктураДанных.Вставить("Имя", СтруктураФИО.Имя);
			СтруктураДанных.Вставить("Отчество", СтруктураФИО.Отчество);
			СтруктураДанных.Вставить("ЭлектроннаяПочта", ЭлектроннаяПочтаФЛ);
			
			СтруктураДанных.Вставить("ОГРНИП", ЗначенияРеквизитовИП.ОГРНИП);
			СтруктураДанных.Вставить("ДатаРегистрации", ЗначенияРеквизитовИП.ДатаРегистрации);
			СтруктураДанных.Вставить("СвидетельствоСерияНомер", ЗначенияРеквизитовИП.СвидетельствоСерияНомер);
			СтруктураДанных.Вставить("СвидетельствоДата", ЗначенияРеквизитовИП.СвидетельствоДата);
			СтруктураДанных.Вставить("СНИЛС", ЗначенияРеквизитовИП.СтраховойНомерПФР);
			
			ИП = Ложь;
			Если ЗначениеЗаполнено(ЗначенияРеквизитовИП.ОГРНИП)
				ИЛИ ЗначениеЗаполнено(ЗначенияРеквизитовИП.СвидетельствоСерияНомер) Тогда
				ИП = Истина;
			КонецЕсли;
			СтруктураДанных.Вставить("ИП", ИП);

			СтруктураДанных.Вставить("ЮридическийАдресXML", КонтактныеДанныеXML.ЮридическийАдресXML);
			СтруктураДанных.Вставить("ФактическийАдресXML", КонтактныеДанныеXML.ФактическийАдресXML);
			СтруктураДанных.Вставить("ПочтовыйАдресXML", КонтактныеДанныеXML.ПочтовыйАдресXML);
			
		КонецЕсли;
		
		НаименованиеОрганизации = СтруктураДанных.НаименованиеПолное;
	КонецЕсли;
	
	Сведения = СтруктураДанных;
	
	Сведения.Вставить("КодПоОКПО",					Сведения.КодОКПО);
	Сведения.Вставить("ПолноеНаименование",			Сведения.НаименованиеПолное);
	Сведения.Вставить("ОфициальноеНаименование",	Сведения.НаименованиеПолное);
	Сведения.Вставить("АдресИдентификатор",	"");
	
КонецПроцедуры

// Возвращает название региона по коду
//
// Параметры:
//  КодРегиона - Строка, содержащая двухсимвольный код региона
//
// Возвращаемое значение:
//  Строка - название региона.
//
Функция НазваниеРегиона(КодРегиона) Экспорт
	
	Если НЕ ЗначениеЗаполнено(КодРегиона) Тогда
		Возврат("");
	КонецЕсли;
	
	Запрос = Новый Запрос();
	Запрос.Параметры.Вставить("КодРегиона", Число(КодРегиона));
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	АдресныеОбъекты.Наименование,
	|	АдресныеОбъекты.Сокращение
	|ИЗ
	|	РегистрСведений.АдресныеОбъекты КАК АдресныеОбъекты
	|ГДЕ
	|	АдресныеОбъекты.Уровень = 1
	|	И АдресныеОбъекты.КодСубъектаРФ = &КодРегиона";
	Запрос.Текст = ТекстЗапроса;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат(СокрЛП(Выборка.Наименование+" "+Выборка.Сокращение));
	КонецЕсли;
	
	Возврат КодРегиона;
	
КонецФункции

// Получает структуру, содержащую информацию о юридическом адресе контрагента.
//
// Параметры:
//  СтруктураАдреса     - структура - содержит ссылки на элементы справочника;
//  СтруктураПараметров - структура - содержит ссылки на элементы справочника;
//  ВидКонтрагента      - строка - имя метаданных справочника;
//  ВидАдреса           - Строка - "Факт" или "Юр";
//  ТекстОшибки         - Строка - описание ошибки;
//
Процедура ПолучитьАдресСтруктурой(СтруктураПараметров, ВидКонтрагента, ВидАдреса, ТекстОшибки = "") Экспорт
	
	СтруктураАдреса = Новый Структура;
	
	СтруктураАдреса.Вставить("АдресРФ", Истина);
	СтруктураАдреса.Вставить("КодСтр", "");
	СтруктураАдреса.Вставить("КодСтраны", "");
	СтруктураАдреса.Вставить("Индекс", "");
	СтруктураАдреса.Вставить("КодРегион", "");
	СтруктураАдреса.Вставить("КодРегиона", "");
	СтруктураАдреса.Вставить("НаименованиеРегиона", "");
	СтруктураАдреса.Вставить("Район", "");
	СтруктураАдреса.Вставить("Город", "");
	СтруктураАдреса.Вставить("НаселПункт", "");
	СтруктураАдреса.Вставить("НаселенныйПункт", "");
	СтруктураАдреса.Вставить("Улица", "");
	СтруктураАдреса.Вставить("Дом", "");
	СтруктураАдреса.Вставить("Корпус", "");
	СтруктураАдреса.Вставить("Кварт", "");
	СтруктураАдреса.Вставить("Квартира", "");
	СтруктураАдреса.Вставить("АдрТекст", "");
	СтруктураАдреса.Вставить("АдресТекст", "");
	СтруктураАдреса.Вставить("КодГАР", "");
	
	СтруктураПараметров.Вставить("СтруктураАдреса", СтруктураАдреса);
	
	Если НЕ ЗначениеЗаполнено(СтруктураПараметров[ВидКонтрагента]) Тогда
		Возврат;
	КонецЕсли; 
	
	Если ТипЗнч(СтруктураПараметров[ВидКонтрагента]) = Тип("СправочникСсылка.Организации") Тогда
		Объект = СтруктураПараметров[ВидКонтрагента];
		ВидКонтактнойИнформации = ?(ВидАдреса = "Юр", Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации, Справочники.ВидыКонтактнойИнформации.ФактАдресОрганизации);
		ИмяСправочника = "Организации";
		
	ИначеЕсли ТипЗнч(СтруктураПараметров[ВидКонтрагента]) = Тип("СправочникСсылка.Контрагенты") Тогда
		Если  ТипЗнч(СтруктураПараметров[ВидКонтрагента].ЮридическоеФизическоеЛицо) = Тип("СправочникСсылка.ЮридическиеЛица") Тогда
			Объект = СтруктураПараметров[ВидКонтрагента].ЮридическоеФизическоеЛицо;
			ВидКонтактнойИнформации = ?(ВидАдреса = "Юр", Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты, Справочники.ВидыКонтактнойИнформации.ФактическийАдресКонтрагенты);
			ИмяСправочника = "ЮридическиеЛица";
		Иначе
			Объект = СтруктураПараметров[ВидКонтрагента].ЮридическоеФизическоеЛицо;
			ВидКонтактнойИнформации = Справочники.ВидыКонтактнойИнформации.АдресПоПропискеФизическиеЛица;
			ИмяСправочника = "ФизическиеЛица";
		КонецЕсли;
		
	КонецЕсли;
	
	ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КонтактнаяИнформация.ЗначенияПолей
		|ИЗ
		|	Справочник." + ИмяСправочника + ".КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	КонтактнаяИнформация.Ссылка = &Ссылка
		|	И КонтактнаяИнформация.Вид = &Вид";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", Объект);
	Запрос.УстановитьПараметр("Вид",    ВидКонтактнойИнформации);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Выборка.Следующий();
	
	АдресXML = Выборка.ЗначенияПолей;
	
	Параметры = Новый Структура("ПроверитьАдрес", Ложь);
	АдресСтруктурой = РаботаСАдресами.СведенияОбАдресе(АдресXML, Параметры);
	
	Если АдресСтруктурой.Свойство("Страна") Тогда 
		Если ЗначениеЗаполнено(АдресСтруктурой.Страна) Тогда
			Страна = Справочники.СтраныМира.НайтиПоНаименованию(АдресСтруктурой.Страна);
		Иначе
			Страна = Справочники.СтраныМира.Россия;	
		КонецЕсли;	
	Конецесли;
	
	Если Страна <> Справочники.СтраныМира.ПустаяСсылка() Тогда
		СтруктураАдреса.Вставить("КодСтр", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Страна, "Код"));
		СтруктураАдреса.Вставить("АдресРФ", Страна = Справочники.СтраныМира.Россия);
	Иначе
		СтруктураАдреса.Вставить("КодСтр", "");
		СтруктураАдреса.Вставить("АдресРФ", Ложь);
	КонецЕсли;
	
	СтруктураАдреса.Вставить("АдрТекст", АдресСтруктурой.Представление);
	СтруктураПараметров.СтруктураАдреса.АдрТекст = АдресСтруктурой.Представление;
	
	КодРегиона = Неопределено;
	Если АдресСтруктурой.Свойство("КодРегиона") Тогда
		КодРегиона = Формат(АдресСтруктурой.КодРегиона, "ЧЦ=2; ЧДЦ=; ЧВН=; ЧГ=0");
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(КодРегиона)
		И АдресСтруктурой.Свойство("Регион") Тогда
		АдресСтруктурой.Вставить("КодРегиона", РегламентированнаяОтчетностьВызовСервера.КодРегионаПоНазванию(АдресСтруктурой.Регион));
	КонецЕсли;
	Если АдресСтруктурой.Свойство("Регион") Тогда
		АдресСтруктурой.Вставить("НаименованиеРегиона", АдресСтруктурой.Регион);
	КонецЕсли;
	
	СтруктураАдреса["АдрТекст"]   = АдресСтруктурой.Представление;
	СтруктураАдреса["АдресТекст"] = АдресСтруктурой.Представление;
	
	Если АдресСтруктурой.Свойство("КодСтраны") Тогда
		СтруктураАдреса["КодСтраны"]  = АдресСтруктурой.КодСтраны;
		СтруктураАдреса["КодСтр"]     = АдресСтруктурой.КодСтраны;
	КонецЕсли;
	Если АдресСтруктурой.Свойство("КодРегиона") Тогда
		СтруктураАдреса["КодРегион"]  = АдресСтруктурой.КодРегиона;
		СтруктураАдреса["КодРегиона"] = АдресСтруктурой.КодРегиона;
	КонецЕсли;
	Если АдресСтруктурой.Свойство("НаименованиеРегиона") Тогда
		СтруктураАдреса["НаименованиеРегиона"] = ПредставлениеАдресногоЭлементаПоСоставляющим(
			АдресСтруктурой.НаименованиеРегиона, АдресСтруктурой.РегионСокращение);
	КонецЕсли;
	Если АдресСтруктурой.Свойство("Индекс") Тогда
		СтруктураАдреса["Индекс"]     = АдресСтруктурой.Индекс;
	КонецЕсли;	
	Если АдресСтруктурой.Свойство("Район") Тогда
		СтруктураАдреса["Район"]      = ПредставлениеАдресногоЭлементаПоСоставляющим(
			АдресСтруктурой.Район, АдресСтруктурой.РайонСокращение);
	КонецЕсли;
	Если АдресСтруктурой.Свойство("Город") Тогда
		СтруктураАдреса["Город"]      = ПредставлениеАдресногоЭлементаПоСоставляющим(
			АдресСтруктурой.Город, АдресСтруктурой.ГородСокращение);
	КонецЕсли;
	Если АдресСтруктурой.Свойство("НаселенныйПункт") Тогда
		СтруктураАдреса["НаселПункт"] = ПредставлениеАдресногоЭлементаПоСоставляющим(
			АдресСтруктурой.НаселенныйПункт, АдресСтруктурой.НаселенныйПунктСокращение);
		СтруктураАдреса["НаселенныйПункт"] = ПредставлениеАдресногоЭлементаПоСоставляющим(
			АдресСтруктурой.НаселенныйПункт, АдресСтруктурой.НаселенныйПунктСокращение);
	КонецЕсли;
	Если АдресСтруктурой.Свойство("Улица") Тогда
		СтруктураАдреса["Улица"]      = ПредставлениеАдресногоЭлементаПоСоставляющим(
			АдресСтруктурой.Улица, АдресСтруктурой.УлицаСокращение);
	КонецЕсли;
	Если АдресСтруктурой.Свойство("Здание") И ЗначениеЗаполнено(АдресСтруктурой.Здание) Тогда
		СтруктураАдреса["Дом"]   	  =  РаботаСАдресамиКлиентСервер.СоединитьНомерИТипЗдания(АдресСтруктурой.Здание.Номер, НРег(АдресСтруктурой.Здание.ТипЗдания), Истина);
	КонецЕсли;
	Если АдресСтруктурой.Свойство("Корпуса") И ЗначениеЗаполнено(АдресСтруктурой.Корпуса) Тогда
		СтруктураАдреса["Корпус"]     = РаботаСАдресамиКлиентСервер.СоединитьНомерИТипЗдания(АдресСтруктурой.Корпуса[0].Номер, НРег(АдресСтруктурой.Корпуса[0].ТипКорпуса), Истина);
	КонецЕсли;
	Если АдресСтруктурой.Свойство("Помещения") И ЗначениеЗаполнено(АдресСтруктурой.Помещения) Тогда
		СтруктураАдреса["Кварт"]      = РаботаСАдресамиКлиентСервер.СоединитьНомерИТипЗдания(АдресСтруктурой.Помещения[0].Номер, НРег(АдресСтруктурой.Помещения[0].ТипПомещения), Истина);
		СтруктураАдреса["Квартира"]   = РаботаСАдресамиКлиентСервер.СоединитьНомерИТипЗдания(АдресСтруктурой.Помещения[0].Номер, НРег(АдресСтруктурой.Помещения[0].ТипПомещения), Истина);
	КонецЕсли;
	
КонецПроцедуры

// Получает печатный номер документа.
//
// Параметры:
//  СсылкаНаОбъект - документссылка - ссылка на документ информационной базы.
//
// Возвращаемое значение:
//  НомерОбъекта - номер документа.
//
Процедура ПолучитьПечатныйНомерДокумента(Знач ВходящийПараметр, Результат) Экспорт
	
	Результат = "";
	
	Если ЗначениеЗаполнено(ВходящийПараметр) Тогда
		ТипВходящегоПараметра = ТипЗнч(ВходящийПараметр);
		Если ТипВходящегоПараметра <> Тип("Строка") И ТипВходящегоПараметра <> Тип("Число") Тогда
			ВходящийПараметр = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВходящийПараметр, "Номер");
		КонецЕсли;
		Результат = ВходящийПараметр;
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Просмотр электронных документов

// Возвращает текстовое описание организации.
//
// Параметры:
//  СведенияОКонтрагенте - Структура, сведения об организации, по которой надо составить описание.
//  Список - Строка, список запрашиваемых параметров организации.
//  СПрефиксом - Булево, признак вывода префикса параметра организации.
//
Процедура ОписаниеОрганизации(СведенияОКонтрагенте, Результат, Список = "") Экспорт
	
	Результат = "";
	
	СписокПолей = ?(Список = "", "ПолноеНаименование,ИНН,Свидетельство,ЮридическийАдрес,Телефоны,НомерСчета,Банк,БИК,КоррСчет", Список);
	
	Результат = ПолучениеОписанияОрганизации(СведенияОКонтрагенте, СписокПолей);
	
КонецПроцедуры

// Возвращает структуру данных со сводным описанием контрагента
//
// Параметры: 
//  СписокСведений - список значений со значениями параметров организации
//   СписокСведений формируется функцией СведенияОЮрФизЛице
//  Список         - список запрашиваемых параметров организации
//  СПрефиксом     - Признак выводить или нет префикс параметра организации
//
// Возвращаемое значение:
//  Строка - описатель организации / контрагента / физ.лица.
//
Функция ПолучениеОписанияОрганизации(СписокСведений, Список = "") Экспорт

	Если ПустаяСтрока(Список) Тогда
		Список = "ПолноеНаименование,ИНН,ЮридическийАдрес,Телефоны,НомерСчета,Банк,БИК,КоррСчет";
	КонецЕсли;

	Результат = "";

	СоответствиеПараметров = Новый Соответствие();
	СоответствиеПараметров.Вставить("ПолноеНаименование", " ");
	СоответствиеПараметров.Вставить("ИНН",                " ИНН ");
	СоответствиеПараметров.Вставить("КПП",                " КПП ");
	СоответствиеПараметров.Вставить("ЮридическийАдрес",   " ");
	СоответствиеПараметров.Вставить("ФактическийАдрес",   " ");
	СоответствиеПараметров.Вставить("Телефоны",           " тел.: ");
	СоответствиеПараметров.Вставить("НомерСчета",         " р/с ");
	СоответствиеПараметров.Вставить("Банк",               " в банке ");
	СоответствиеПараметров.Вставить("БИК",                " БИК ");
	СоответствиеПараметров.Вставить("КоррСчет",           " к/с ");
	СоответствиеПараметров.Вставить("КодПоОКПО",          " Код по ОКПО ");

	Список          = Список + ?(Прав(Список, 1) = ",", "", ",");
	ЧислоПараметров = СтрЧислоВхождений(Список, ",");

	Для Счетчик = 1 по ЧислоПараметров Цикл

		ПозЗапятой = Найти(Список, ",");

		Если ПозЗапятой > 0  Тогда
			
			ИмяПараметра = Лев(Список, ПозЗапятой - 1);
			Список       = Сред(Список, ПозЗапятой + 1, СтрДлина(Список));

			Попытка
				СтрокаДополнения = "";
				СписокСведений.Свойство(ИмяПараметра, СтрокаДополнения);

				Если ПустаяСтрока(СтрокаДополнения) Тогда
					Продолжить;
				КонецЕсли;

				Префикс = СоответствиеПараметров[ИмяПараметра];
				Если Не ПустаяСтрока(Результат)  Тогда
					Результат = Результат + ",";
				КонецЕсли; 

				Результат = Результат + СтрокаДополнения;
			Исключение
				
				ТекстСообщения  = НСтр("ru='Не удалось определить значение параметра организации: %ИмяПараметра%'");
				ТекстСообщения  = СтрЗаменить(ТекстСообщения,"%ИмяПараметра%",ИмяПараметра);
				Сообщение       = Новый СообщениеПользователю();
				Сообщение.Текст = ТекстСообщения;
				Сообщение.Сообщить();
				
			КонецПопытки;

		КонецЕсли;

	КонецЦикла;

	Возврат СокрЛП(Результат);

КонецФункции // ОписаниеОрганизации()

// Возвращает текстовое представление суммы.
//
// Параметры:
//  СуммаКПрописи - Число, сумма, по которой надо получить представление.
//  КодВалюты - Число, код используемой валюты.
//  ЧН - Строка, параметр нулевого значения числа.
//  ЧРГ - Строка, разделитель групп целой части числа.
//
Функция ФорматСумм(СуммаКПрописи, КодВалюты = Неопределено, ЧН = "", ЧРГ = "") Экспорт
	
	Результат = "";
	
	Валюта = Справочники.Валюты.ПустаяСсылка();
	НайтиСсылкуНаОбъект("Валюты", Валюта, КодВалюты);
	Результат = ОбщегоНазначенияБГУ.ФорматСумм(СуммаКПрописи, Валюта,  ЧН, ЧРГ);
	
	Возврат Результат;
	
КонецФункции

// Возвращает сумму прописью.
//
// Параметры:
//  СуммаЧислом - Число, преобразуемая сумма.
//  КодВалюты - Число, код используемой валюты.
//
Функция СуммаПрописью(СуммаЧислом, КодВалюты) Экспорт
	
	Результат = "";
	ВалютаРегУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
	Валюта = Справочники.Валюты.ПустаяСсылка();
	НайтиСсылкуНаОбъект("Валюты", Валюта, КодВалюты);
	Если Валюта = Неопределено Тогда
		Валюта = ВалютаРегУчета;
	КонецЕсли;
	
	Результат = ОбщегоНазначенияБГУ.СформироватьСуммуПрописью(СуммаЧислом, Валюта);
	
	Возврат Результат;
	
КонецФункции

// Формирует текст НДС по ставке для печатной формы счета и заказа
//
// Параметры:
//  СтавкаНДС       - ПеречислениеСсылка.СтавкиНДС - ставка НДС, для которой необходимо сформировать текст
//  ЦенаВключаетНДС - Булево - Признак включения НДС в цену
//
// Возвращаемое значение:
//  Строка
//
Функция ТекстНДСПоСтавке(СтавкаНДС, ЦенаВключаетНДС) Экспорт
	
	ТекстНДСПоСтавке = ?(ЦенаВключаетНДС, НСтр("ru='В т.ч. НДС (%СтавкаНДС%):'"), НСтр("ru='НДС (%СтавкаНДС%):'"));
	ТекстНДСПоСтавке = СтрЗаменить(ТекстНДСПоСтавке, "%СтавкаНДС%", СтавкаНДС);
	
	Возврат ТекстНДСПоСтавке;
	
КонецФункции

// Возвращает ответственного за электронный документооборот по данному соглашению
//
// Параметры:
//  Контрагент - СправочникСсылка.Контрагенты, ссылка на контрагента, по которому надо получить ответственного.
//  Соглашение - СправочникСсылка.СоглашениеОбИспользованииЭД, ссылка на соглашение, по которому надо найти ответственного.
//
Функция ПолучитьОтветственногоПоЭД(Контрагент, Соглашение) Экспорт
	
	ОтветственныйПоЭД = Пользователи.ТекущийПользователь();
	
	Возврат ОтветственныйПоЭД;
	
КонецФункции

// Возвращает признак физ. лица.
//
// Параметры:
//  ДанныеКонтрагента - ссылка на элемент справочника.
//
Функция ЭтоФизЛицо(ДанныеКонтрагента) Экспорт
	
	ЭтоФизЛицо = Ложь;
	
	Если ДанныеКонтрагента.Метаданные().Реквизиты.Найти("ВидКонтрагента") = Неопределено Тогда
		Возврат ЭтоФизЛицо;
	КонецЕсли;
	
	ЮрФизЛицо = ДанныеКонтрагента.ВидКонтрагента;
	
	Если ТипЗнч(ЮрФизЛицо) <> Тип("ПеречислениеСсылка.ЮрФизЛицо") Тогда
		Возврат ЭтоФизЛицо;
	КонецЕсли;
	
	ЭтоФизЛицо = (ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо);
	
	Возврат ЭтоФизЛицо;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Переопределение поведения электронных документов

// Данное событие возникает при изменении элемента справочника ЭДПрисоединенныеФайлы
// Предназначено для переопределения или добавления изменяемых реквизитов электронного документа
//
// Параметры:
//  Объект - СправочникСсылка.ЭДПрисоединенныеФайлы - изменяемый объект
//  СтруктураПараметров - Структура, содержит структуру изменяемых реквизитов
//
Процедура ПриИзмененииПрисоединенногоФайла(Объект, СтруктураПараметров) Экспорт
	
	Если НЕ СтруктураПараметров.Свойство("Ответственный") Тогда
		СтруктураПараметров.Вставить("Ответственный", Пользователи.АвторизованныйПользователь());
	КонецЕсли;
	
КонецПроцедуры

// Выполняет дополнительную обработку электронного документа, которому назначили статус "Утвержден".
// 
// Параметры:
//  ЭлектронныйДокумент - ссылка на присоединенный файл.
//
Процедура НазначенСтатусУтвержден(ЭлектронныйДокумент) Экспорт
	
	Попытка
		ФайлОбъект = ЭлектронныйДокумент.ПолучитьОбъект();
		ФайлОбъект.Изменил = ПользователиКлиентСервер.ТекущийПользователь();
		ФайлОбъект.Записать();
	Исключение
		ТекстСообщения = КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + НСтр("ru = ' (подробности см. в Журнале регистрации).'");
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ЭлектронныеДокументыБГУВызовСервера.ОбработатьИсключениеПоЭДНаСервере(НСтр("ru = 'утверждение ЭД'"), ТекстОшибки, ТекстСообщения);
	КонецПопытки;
	
КонецПроцедуры

// Проверяет, готовность документов ИБ для формирования ЭД, и удаляет из массива не готовые документы
//
// Параметры
//  ДокументыМассив - Массив   - ссылки на документы, которые должны быть проверены перед формированием ЭД.
//
Процедура ПроверитьГотовностьИсточников(ДокументыМассив, ФормаИсточник = Неопределено) Экспорт
	
	ОбщегоНазначенияКлиентСервер.УдалитьВсеВхожденияТипаИзМассива(ДокументыМассив, Тип("СтрокаГруппировкиДинамическогоСписка"));
	
	МассивТиповНепроводныхДокументовВнутреннегоЭДО = МассивТиповНепроводныхДокументовВнутреннегоЭДО();
	
	МассивПроводныхДокументов = Новый Массив;
	МассивТиповНепроводныхДокументов = Новый Массив;
	Для каждого Элемент из ДокументыМассив Цикл
		ИмяДокумента = Элемент.Метаданные().ПолноеИмя();
		Если Метаданные.Документы.Содержит(Метаданные.НайтиПоПолномуИмени(ИмяДокумента)) Тогда
			Если МассивТиповНепроводныхДокументовВнутреннегоЭДО.Найти(ТипЗнч(Элемент)) = Неопределено Тогда
				Если Элемент.Метаданные().Проведение = Метаданные.СвойстваОбъектов.Проведение.Запретить Тогда
					Если МассивТиповНепроводныхДокументов.Найти(ТипЗнч(Элемент)) = Неопределено Тогда
						МассивТиповНепроводныхДокументов.Добавить(ТипЗнч(Элемент));
					КонецЕсли;
				КонецЕсли;
				МассивПроводныхДокументов.Добавить(Элемент)
			Иначе
				МассивТиповНепроводныхДокументов.Добавить(ТипЗнч(Элемент));
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;
	
	Для каждого ТипНепроводногоДокумента ИЗ МассивТиповНепроводныхДокументов Цикл
		ОбщегоНазначенияКлиентСервер.УдалитьВсеВхожденияТипаИзМассива(МассивПроводныхДокументов, ТипНепроводногоДокумента);
	КонецЦикла;
	
	МассивНепроведенныхДокументов = ОбщегоНазначения.ПроверитьПроведенностьДокументов(МассивПроводныхДокументов);
	Если МассивНепроведенныхДокументов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ШаблонСообщения = НСтр("ru = 'Документ %1 не проведен. Электронный документ не сформирован.'");
	Для Каждого НепроведенныйДокумент Из МассивНепроведенныхДокументов Цикл
		Найденный = ДокументыМассив.Найти(НепроведенныйДокумент.Ссылка);
		Если Найденный <> Неопределено Тогда
			
			ДокументыМассив.Удалить(Найденный);
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения,
				Строка(НепроведенныйДокумент.Ссылка));
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Работа с правами

// Проверяет наличие прав обрабатывать электронный документы.
//
// Возвращаемое значение:
//  Булево - истина или ложь, в зависимости от установленных прав.
//
Функция ЕстьПравоОбработкиЭД() Экспорт
	
	Результат = Истина;
	
	Результат = Пользователи.РолиДоступны("ВыполнениеОбменаЭД");
	
	Возврат Результат;
	
КонецФункции

// Проверяет наличие прав читать электронный документы.
//
// Возвращаемое значение:
//  Булево - истина или ложь, в зависимости от установленных прав.
//
Функция ЕстьПравоЧтенияЭД() Экспорт
	
	Результат = Истина;
	
	Результат = Пользователи.РолиДоступны("ВыполнениеОбменаЭД, ЧтениеЭД");
	
	Возврат Результат;
	
КонецФункции

// Проверяет наличие прав на открытие журнала регистрации.
//
// Возвращаемое значение:
//  Булево - истина или ложь, в зависимости от установленных прав.
//
Процедура ЕстьПравоОткрытияЖурналаРегистрации(Результат) Экспорт
	
	Результат = Пользователи.ЭтоПолноправныйПользователь();
	
КонецПроцедуры

// Проверяет наличие прав на настройку параметров электронных документов.
//
// Возвращаемое значение:
//  Булево - истина или ложь, в зависимости от установленных прав.
//
Функция ЕстьПравоНастройкиПараметровЭД() Экспорт
	
	Результат = Истина;
	
	Результат = Пользователи.РолиДоступны("НастройкаПараметровЭД") ИЛИ Пользователи.ЭтоПолноправныйПользователь();
	
	Возврат Результат;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Работа с элементами форм

// Изменяет поведение элементов управляемой или обычной формы.
//
// Параметры:
//  Форма - <Управляемая или обычная форма> - управляемая или обычная форма для изменения.
//  СтруктураПараметров - <Структура> - параметры процедуры
//
Процедура ИзменитьСвойстваЭлементовФормы(Форма, СтруктураПараметров) Экспорт
	
	Если СтруктураПараметров.Свойство("ВидОперации")
		И СтруктураПараметров.Свойство("ЗначениеПараметра") Тогда
		Если ВРег(СтруктураПараметров.ВидОперации) = ВРег("УстановкаГиперссылки")
			И СтруктураПараметров.Свойство("ТекстСостоянияЭД") Тогда
			// Зададим особые условия.
			Если Найти(СтруктураПараметров.ТекстСостоянияЭД, "Не сформирован") > 0
				ИЛИ Найти(СтруктураПараметров.ТекстСостоянияЭД, "Нет действующего соглашения") > 0 Тогда
				СтруктураПараметров.ЗначениеПараметра = Ложь;
			КонецЕсли;
			// Определим элемент формы.
			НайденныйЭлементФормы = Неопределено;
			Если НЕ Форма.Элементы.Найти("СостояниеЭД") = Неопределено Тогда
				НайденныйЭлементФормы = Форма.Элементы.СостояниеЭД;
			КонецЕсли;
				
			// Заполним свойство найденного элемента.
			Если НЕ НайденныйЭлементФормы = Неопределено
				И НайденныйЭлементФормы.Вид = ВидПоляФормы.ПолеНадписи Тогда
				НайденныйЭлементФормы.Гиперссылка = СтруктураПараметров.ЗначениеПараметра;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЕстьПравоЧтенияЭД() Или Не ПолучитьФункциональнуюОпцию("ИспользоватьОбменЭД") Тогда
		Если НЕ Форма.Элементы.Найти("ГруппаСостояниеЭД") = Неопределено Тогда
			Форма.Элементы.ГруппаСостояниеЭД.Видимость = Ложь;
		ИначеЕсли НЕ Форма.Элементы.Найти("СостояниеЭД") = Неопределено Тогда
			Форма.Элементы.СостояниеЭД.Видимость = Ложь;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Переопределяет выводимое сообщение об ошибке
// КодОшибки - строка
// ТекстОшибки - строка
Процедура ИзменитьСообщениеОбОшибке(КодОшибки, ТекстОшибки) Экспорт
	
	Если КодОшибки = "100" ИЛИ КодОшибки = "110" Тогда
		ТекстОшибки = "Проверьте общие настройки криптографии."
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Общие процедуры и функции

// При необходимости, в функции можно определить каталог для временных файлов,
// отличный от устанавливаемого по умолчанию в библиотеке ЭД.
//
// Параметры:
//  ТекущийКаталог - путь к каталогу временных файлов.
//
Процедура ТекущийКаталогВременныхФайлов(ТекущийКаталог) Экспорт
	
	ТекущийКаталог = КаталогВременныхФайлов();
	
КонецПроцедуры

// Получает имя временного файла.
//
// Параметры:
//  ИмяВременногоФайла - Строка - имя временного файла;
//  Расширение - Строка - расширение для временного файла.
//
Процедура ТекущееИмяВременногоФайла(ИмяВременногоФайла, Расширение = "") Экспорт
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла(Расширение);
	
КонецПроцедуры

// Разбирает из переданной строки фамилию, имя и отчество.
//
// Параметры
//  ПолноеНаименование - строка с наименованием;
//  Фамилия - строка с фамилией;
//  Имя - строка с именем;
//  Отчество - строка с отчеством.
//
Процедура РазобратьНаименованиеФизЛица(ПолноеНаименование, Фамилия = " ", Имя = " ", Отчество = " ") Экспорт
	
	Массив = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПолноеНаименование, " ", Ложь);
	Если Массив.Количество() > 0 Тогда
		Фамилия = Массив[0];
	КонецЕсли;	
	Если Массив.Количество() > 1 Тогда
		Имя = Массив[1];
	КонецЕсли;	
	Если Массив.Количество() > 2 Тогда
		Отчество = Массив[2];
	КонецЕсли;	
	
КонецПроцедуры

// Получает реквизиты элемнта справочника "Организации", для выгрузки в xml-файл.
//
// Параметры:
//  Организация - СправочникСсылка.Организации - элемент справочника организации;
//  СтруктураВозврата - структура - перечень параметров организации.
//
Процедура ПолучитьРеквизитыОрганизацииДляВыгрузкиВФайл(Организация, СтруктураВозврата) Экспорт
	
	Запрос = Новый Запрос();
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Организации.НаименованиеПолное КАК Наименование,
	|	Организации.ИНН КАК ИНН,
	|	Организации.КПП КАК КПП,
	|	ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо) КАК ЮрФизЛицо
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Организация);
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если РезультатЗапроса.Следующий() Тогда
		
		СтруктураВозврата.Наименование = РезультатЗапроса.Наименование;
		СтруктураВозврата.НаименованиеПолное = РезультатЗапроса.Наименование;
		СтруктураВозврата.ИНН = РезультатЗапроса.ИНН;
		СтруктураВозврата.КПП = РезультатЗапроса.КПП;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЕдинственнаяОрганизация(Организация) Экспорт
	
	Запрос = Новый Запрос();
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Организации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.ПометкаУдаления = ЛОЖЬ";
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество()=1 Тогда
		Организация = РезультатЗапроса[0].Ссылка;
	КонецЕсли;
	
КонецПроцедуры	

////////////////////////////////////////////////////////////////////////////////
// Механизм прямого обмена между организациями

// Если в таблице нет колонки "ИдТовараУКонтрагента" добавляет.
// Затем заполняет ее GUID номенклатуры
Процедура ДобавитьИДНоменклатурыВТаблицу(ТаблицаНоменклатуры)
	Если ТипЗнч(ТаблицаНоменклатуры) = Тип("ТаблицаЗначений") Тогда
		Если ТаблицаНоменклатуры.Колонки.Найти("ИдТовараУКонтрагента") = Неопределено Тогда
			ТаблицаНоменклатуры.Колонки.Добавить("ИдТовараУКонтрагента", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(200)));
		КонецЕсли;
		
		Для Каждого ТекСтрока из ТаблицаНоменклатуры Цикл
			ТекСтрока.ИдТовараУКонтрагента = ТекСтрока.Номенклатура.УникальныйИдентификатор();
		КонецЦикла;	
	КонецЕсли;
КонецПроцедуры

// Возвращает структуру, содержащую информацию о юридическом адресе контрагента.
//
// Параметры:
//  СтруктураПараметров - структура - содержит ссылки на элементы справочника;
//  ВидКонтрагента      - строка - имя метаданных справочника;
//  ВидАдреса           - строка - "Факт" или "Юр";
//  ТекстОшибки         - строка - описание ошибки;
//
// Возвращаемое значение:
//  СтруктураАдреса - структура - информация о юридическом адресе.
//
Функция ПолучитьСтруктуруАдреса(СтруктураПараметров = Неопределено,
								ВидКонтрагента = Неопределено,
								ВидАдреса = Неопределено,
								ТекстОшибки = "") Экспорт
	
	СтруктураАдреса = Новый Структура;
	// Поля структуры для адреса РФ.
	СтруктураАдреса.Вставить("АдресРФ");
	СтруктураАдреса.Вставить("Индекс");
	СтруктураАдреса.Вставить("КодРегион");
	СтруктураАдреса.Вставить("Район");
	СтруктураАдреса.Вставить("Город");
	СтруктураАдреса.Вставить("НаселПункт");
	СтруктураАдреса.Вставить("Улица");
	СтруктураАдреса.Вставить("Дом");
	СтруктураАдреса.Вставить("Корпус");
	СтруктураАдреса.Вставить("Кварт");
	// Поля структуры для иностранного адреса или адреса РФ строкой.
	СтруктураАдреса.Вставить("КодСтр");
	СтруктураАдреса.Вставить("АдрТекст");
	
	Возврат СтруктураАдреса;
	
КонецФункции


// Заполняет данные участника
//
// Участник - ссылка на организацию (Контрагенты, Организации)
// ВидУчастника - Строка. "Исполнитель", "Заказчик" и т.п. Наименование ветки в дереве данных
// ЭтоСчетФактура - Булево - Признак  того, что нужно анализировать наличие головной организации, т.е. это
//							признак, что имеет значение филиал это или нет. Необходимо, пока, только для
//							счетов-фактур исходящих.
Процедура ЗаполнитьДанныеУчастника(Участник, 
								ВидУчастника, 
								ДатаДанных, 
								ДеревоДанных, 
								ЛицевойСчет = Неопределено, 
								РеквизитыЛицевогоСчета = Неопределено, 
								ЕстьКонтакт = Истина,
								ЕстьОКПО = Истина,
								ЭтоСчетФактура = Ложь,
								ПараметрыУчастниковСФ = Неопределено,
								ГоловнаяОрганизация = Неопределено,
								ГоловнаяОрганизацияНаименование = "",
								ГоловнаяОрганизацияИНН = "") Экспорт
								
	Если НЕ ЗначениеЗаполнено(Участник) Тогда
		Возврат;
	КонецЕсли;
	
	СведенияОбУчастнике = Новый Структура;
	ПолучитьДанныеЮрФизЛица(Участник, СведенияОбУчастнике, ДатаДанных, ЭтоСчетФактура);
	
	Если ПараметрыУчастниковСФ = Неопределено Тогда
		Если СведенияОбУчастнике.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
			Если ЗначениеЗаполнено(ГоловнаяОрганизация) Тогда
				НаименованиеКонтрагента = ГоловнаяОрганизацияНаименование;
				ИННКонтрагента = ГоловнаяОрганизацияИНН;
			Иначе
				НаименованиеКонтрагента = СведенияОбУчастнике.ОфициальноеНаименование;
				ИННКонтрагента = СведенияОбУчастнике.ИНН; 
			КонецЕсли;	
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.ИНН", ИННКонтрагента);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.КПП", СведенияОбУчастнике.КПП);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.НаименованиеОрганизации", НаименованиеКонтрагента);
		Иначе
			Если ЗначениеЗаполнено(Участник.ЮридическоеФизическоеЛицо.ОГРНИП) ИЛИ ЗначениеЗаполнено(Участник.ЮридическоеФизическоеЛицо.СвидетельствоСерияНомер) Тогда
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИП.ИНН", СведенияОбУчастнике.ИНН);
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИП.Фамилия", СведенияОбУчастнике.Фамилия);
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИП.Имя", СведенияОбУчастнике.Имя);
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИП.Отчество", СведенияОбУчастнике.Отчество);
			Иначе
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.ИНН", СведенияОбУчастнике.ИНН);
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Фамилия", СведенияОбУчастнике.Фамилия);
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Имя", СведенияОбУчастнике.Имя);
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Отчество", СведенияОбУчастнике.Отчество);
			КонецЕсли;
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(ГоловнаяОрганизация) Тогда
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("Участник", ГоловнаяОрганизация);
			АдресУчастника = "";
			ПолучитьАдресСтруктурой(СтруктураПараметров, "Участник", "Юр");
			АдресУчастника = СтруктураПараметров.СтруктураАдреса;
			АдресУчастникаСтрокой = СтруктураПараметров.СтруктураАдреса.АдрТекст;
			АдресВСвободнойФорме = АдресЮридическийУКонтрагентаВСвободнойФорме(ГоловнаяОрганизация);
		Иначе	
			СтруктураПараметров = Новый Структура;
			СтруктураПараметров.Вставить("Участник", Участник);
			АдресУчастника = "";
			ПолучитьАдресСтруктурой(СтруктураПараметров, "Участник", "Юр");
			АдресУчастника = СтруктураПараметров.СтруктураАдреса;
			АдресУчастникаСтрокой = СтруктураПараметров.СтруктураАдреса.АдрТекст;
			АдресВСвободнойФорме = АдресЮридическийУКонтрагентаВСвободнойФорме(Участник);
		КонецЕсли;
		
		Если АдресВСвободнойФорме.ТипАдреса = "Муниципальный" Тогда
			АдресВСвободнойФорме.АдресТекст = АдресУчастникаСтрокой;
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(АдресВСвободнойФорме.АдресТекст) Тогда
			АдресУчастника = АдресВСвободнойФорме;
			
			ТипАдреса = "Произвольный";
			СтруктураПараметров.Вставить("ТипАдреса", ТипАдреса);
			ПолныйПуть = ВидУчастника + ".Адрес.Структурированный";
			ЗаполнитьАдресВДереве(ДеревоДанных, АдресУчастника, СтруктураПараметров.ТипАдреса, ВидУчастника);
		Иначе	
			Если ЗначениеЗаполнено(АдресУчастникаСтрокой) Тогда
				Если (СтрДлина(АдресУчастника.Кварт)>20) ИЛИ (СтрДлина(АдресУчастника.Корпус)>20) Тогда
					ТипАдреса = "Произвольный";
					СтруктураПараметров.Вставить("ТипАдреса", ТипАдреса);
					ПолныйПуть = ВидУчастника + ".Адрес.Структурированный";
					ЗаполнитьАдресВДереве(ДеревоДанных, АдресУчастника, СтруктураПараметров.ТипАдреса, ВидУчастника);
				Иначе	
					ПолныйПуть = ВидУчастника + ".Адрес.Структурированный";
					Если ЭлектронноеВзаимодействие.СуществуетРеквизитВДереве(ДеревоДанных, ПолныйПуть) Тогда
						ТипАдреса = ?(АдресУчастника.АдресРФ, "Структурированный", "Иностранный");
					Иначе
						ТипАдреса = "Произвольный";
					КонецЕсли;
					СтруктураПараметров.Вставить("ТипАдреса", ТипАдреса);
					
					ЗаполнитьАдресВДереве(ДеревоДанных, АдресУчастника, СтруктураПараметров.ТипАдреса, ВидУчастника);
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;	
	Иначе
		//По данным общих процедур СФ
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("Участник", Участник);
		АдресУчастника = "";
		
		Если ВидУчастника = "Продавец" Тогда
			СведенияОбУчастнике.ИНН = ПараметрыУчастниковСФ.Продавец.ИНН;
			СведенияОбУчастнике.КПП = ПараметрыУчастниковСФ.Продавец.КПП;
			СведенияОбУчастнике.ОфициальноеНаименование = ПараметрыУчастниковСФ.Продавец.Наименование;
			СведенияОбУчастнике.ПолноеНаименование = ПараметрыУчастниковСФ.Продавец.Наименование;
			АдресУчастника = ПараметрыУчастниковСФ.Продавец.Адрес;
		ИначеЕсли ВидУчастника = "Покупатель" Тогда
			СведенияОбУчастнике.ИНН = ПараметрыУчастниковСФ.Покупатель.ИНН;
			СведенияОбУчастнике.КПП = ПараметрыУчастниковСФ.Покупатель.КПП;
			СведенияОбУчастнике.ОфициальноеНаименование = ПараметрыУчастниковСФ.Покупатель.Наименование;
			СведенияОбУчастнике.ПолноеНаименование = ПараметрыУчастниковСФ.Покупатель.Наименование;
			АдресУчастника = ПараметрыУчастниковСФ.Покупатель.Адрес;
		КонецЕсли;	
		
		Если СведенияОбУчастнике.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.ИНН", СведенияОбУчастнике.ИНН);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.КПП", СведенияОбУчастнике.КПП);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ЮЛ.НаименованиеОрганизации", СведенияОбУчастнике.ОфициальноеНаименование);
		Иначе	
			Если ЗначениеЗаполнено(Участник.ЮридическоеФизическоеЛицо.ОГРНИП) ИЛИ ЗначениеЗаполнено(Участник.ЮридическоеФизическоеЛицо.СвидетельствоСерияНомер) Тогда
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИП.ИНН", СведенияОбУчастнике.ИНН);
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИП.Фамилия", СведенияОбУчастнике.Фамилия);
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИП.Имя", СведенияОбУчастнике.Имя);
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ИП.Отчество", СведенияОбУчастнике.Отчество);
			Иначе
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.ИНН", СведенияОбУчастнике.ИНН);
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Фамилия", СведенияОбУчастнике.Фамилия);
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Имя", СведенияОбУчастнике.Имя);
				ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".ТипУчастника.ФЛ.Отчество", СведенияОбУчастнике.Отчество);
			КонецЕсли;
		КонецЕсли;	
		
		ТипАдреса = "Произвольный";
		СтруктураПараметров.Вставить("ТипАдреса", ТипАдреса);
		ПолныйПуть = ВидУчастника + ".Адрес.Структурированный";
		ЗаполнитьАдресВДереве(ДеревоДанных, АдресУчастника, СтруктураПараметров.ТипАдреса, ВидУчастника);
	КонецЕсли;
		
	Если ЕстьКонтакт Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".Контакт.Телефон", СведенияОбУчастнике.Телефоны);
	КонецЕсли;	
	
	Если ЛицевойСчет <> Неопределено Тогда
		
		ЗаполнитьРеквизитыЛицевогоСчета(ЛицевойСчет, РеквизитыЛицевогоСчета);
		
		Если ЗначениеЗаполнено(ЛицевойСчет) И ЗначениеЗаполнено(РеквизитыЛицевогоСчета) Тогда
			РасчетныеРеквизиты = Новый Структура("ИННПолучателя, КПППолучателя, ТекстПолучателя, НомерСчетаПолучателя, НаименованиеБанкаПолучателя, БикБанкаПолучателя, СчетБанкаПолучателя", "ИНН", "КПП", "Корреспондент", "СчетНомер", "Банк", "БИК", "КоррСчет");
		    ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(ЛицевойСчет, РеквизитыЛицевогоСчета, РасчетныеРеквизиты);
			
			ТекстБанка = "";
			НомерСчета = "";
			ТекстБанка = РасчетныеРеквизиты.НаименованиеБанкаПолучателя;
			Если НЕ ЗначениеЗаполнено(РеквизитыЛицевогоСчета) Тогда
				РасчетныеРеквизиты.НомерСчетаПолучателя = СокрЛП(ЛицевойСчет.Код);
				Если ТипЗнч(ЛицевойСчет) = Тип("СправочникСсылка.БанковскиеИКазначейскиеСчета") Тогда
					Если ТипЗнч(ЛицевойСчет.КассовыйОрган) = Тип("СправочникСсылка.Банки") Тогда
						ТекстБанка = ЛицевойСчет.КассовыйОрган.Наименование;
						РасчетныеРеквизиты.БикБанкаПолучателя = СокрЛП(ЛицевойСчет.КассовыйОрган.Код);
						НомерСчета = СокрЛП(РасчетныеРеквизиты.НомерСчетаПолучателя);
					ИначеЕсли ТипЗнч(ЛицевойСчет.КассовыйОрган) = Тип("СправочникСсылка.Казначейства") Тогда	
						ТекстБанка = ЛицевойСчет.СчетКазначейства.КассовыйОрган.Наименование + " " + ЛицевойСчет.СчетКазначейства.КассовыйОрган.Город + ", Казначейство: " +
						ЛицевойСчет.КассовыйОрган.Наименование + " ("+ЛицевойСчет.Владелец.НаименованиеСокращенное+", л/с "+ СокрЛП(ЛицевойСчет.Код)+")";
						РасчетныеРеквизиты.БикБанкаПолучателя = ЛицевойСчет.СчетКазначейства.КассовыйОрган.Код;
						НомерСчета = СокрЛП(ЛицевойСчет.СчетКазначейства.Код);
					КонецЕсли;
				КонецЕсли;
			Иначе
				ТекстБанка = РасчетныеРеквизиты.НаименованиеБанкаПолучателя;
				РасчетныеРеквизиты.БикБанкаПолучателя = РасчетныеРеквизиты.БикБанкаПолучателя;
				НомерСчета = РасчетныеРеквизиты.НомерСчетаПолучателя;
			КонецЕсли;	
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".БанковскийСчет.НомерСчета", НомерСчета);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".БанковскийСчет.НаимБанк", ТекстБанка);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".БанковскийСчет.БИК", РасчетныеРеквизиты.БикБанкаПолучателя);
		КонецЕсли;	
	КонецЕсли;	
	Если ЕстьОКПО Тогда
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, ВидУчастника + ".КодОКПО", СведенияОбУчастнике.КодПоОКПО);
	КонецЕсли;	
КонецПроцедуры	

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ПОЛУЧЕНИЯ ДАННЫХ ДЛЯ ЭД

// Подготавливает данные для электронного документа типа СчетФактураВыданный.
//
// Параметры:
//  СсылкаНаОбъект - ДокументСсылка, ссылка на объект информационной базы, по которому необходимо создать электронный документ.
//  СтруктураЭД - Структура, структура данных для формирования электронного документа.
//
Процедура ПодготовитьДанныеПоСчетуФактуре(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ = Ложь)
	НетЗамечанийКДокументу = Документы["СчетФактураВыданный"].ПредварительныйКонтрольДанныхДляЭД(СсылкаНаОбъект);
	
	Если НЕ НетЗамечанийКДокументу Тогда
		ОписаниеОшибки = НСтр("ru='Вышеуказанные ошибки препятствуют формированию электронного документа.
		|По этой причине и прочие данные документа не будут выгружены в ЭД.
		|После заполнения указанных реквизитов повторите попытку формирования электронного документа.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки);
		Отказ = Истина;
		Возврат;
	КонецЕсли;	
	
	ДанныеДокумента = Документы.СчетФактураВыданный.ПодготовитьДанныеДляЭД(СсылкаНаОбъект, Ложь);
	
	ТаблицаСФ	= ДанныеДокумента["Шапка"];
	ТаблицаНФА	= ДанныеДокумента["ТабЧастьНФА"];
	ТаблицаПРД	= ДанныеДокумента["ТабЧастьПРД"];
	
	Для каждого РеквизитыСФ Из ТаблицаСФ Цикл
		
		Если Не ЗначениеЗаполнено(РеквизитыСФ.ВалютаКод) Тогда
			ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
				"Объект.ВалютаДокумента");
		Иначе
			ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(РеквизитыСФ.ВалютаКод, 
				"Объект.Код");
		КонецЕсли;
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснования", РеквизитыСФ.ДокументОснование);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерСчетаФактуры", РеквизитыСФ.Номер);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаСчетаФактуры", РеквизитыСФ.Дата);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаКод", РеквизитыСФ.ВалютаКод, ПараметрыОбработкиОшибок);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ТолькоУслуги", ТолькоУслуги(РеквизитыСФ.ВидЦенности));
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВидСчетаФактуры", ВидСчетаФактуры(РеквизитыСФ.ПричинаНалогообложения));
		
		ПараметрыУчастниковСФ = ОпределитьПоСсылкеПродавцаПокупателяГрузоотправителяГрузополучателя(СсылкаНаОбъект);
		
		ЗаполнитьДанныеГрузополучателяГрузоотправителя(?(ЗначениеЗаполнено(РеквизитыСФ.Грузоотправитель), РеквизитыСФ.Грузоотправитель,
			РеквизитыСФ.Организация), "Грузоотправитель", РеквизитыСФ.Дата, ДеревоДанных, ПараметрыУчастниковСФ);
		ЗаполнитьДанныеГрузополучателяГрузоотправителя(?(ЗначениеЗаполнено(РеквизитыСФ.Грузополучатель), РеквизитыСФ.Грузополучатель,
			РеквизитыСФ.Контрагент), "Грузополучатель", РеквизитыСФ.Дата, ДеревоДанных, ПараметрыУчастниковСФ);
		
		ЗаполнитьДанныеУчастника(РеквизитыСФ.Организация, "Продавец", РеквизитыСФ.Дата, ДеревоДанных,,,  Ложь, Ложь, Истина, ПараметрыУчастниковСФ);
		ЗаполнитьДанныеУчастника(РеквизитыСФ.Контрагент, "Покупатель", РеквизитыСФ.Дата, ДеревоДанных,,, Ложь, Ложь, Истина, ПараметрыУчастниковСФ);
		
		//ПРД
		ПлатежныеДокументы = Новый ТаблицаЗначений;
		ПлатежныеДокументы.Колонки.Добавить("НомерПРД", Новый ОписаниеТипов("Строка", Новый КвалификаторыСтроки(30)));
		ПлатежныеДокументы.Колонки.Добавить("ДатаПРД", Новый ОписаниеТипов("Дата"));
		Для каждого ТекПРД Из ТаблицаПРД Цикл
			НоваяСтрока = ПлатежныеДокументы.Добавить();
			НоваяСтрока.НомерПРД = ТекПРД.НомерДокумента;
			НоваяСтрока.ДатаПРД  = ТекПРД.ДатаДокумента;
		КонецЦикла;	
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ПлатежныеДокументы, "ПлатежноРасчетныеДокументы");
		
		//НФА
		ТаблицаТоваров = СоздатьТаблицуТоваров();
				
		Для каждого ТекНФА Из ТаблицаНФА Цикл
			НоваяСтрока = ТаблицаТоваров.Добавить();
			Если ТипЗнч(ТекНФА.НФА) = Тип("СправочникСсылка.Номенклатура") Тогда
				НоваяСтрока.ИдТовараУКонтрагента  = ТекНФА.НФА.УникальныйИдентификатор();
				НоваяСтрока.НаименованиеНоменклатуры  = ТекНФА.НФА.НаименованиеПолное;
				
				Если ЗначениеЗаполнено(ТекНФА.НФА.СтранаПроисхождения) Тогда
					ТаможеннаяДекларация = Новый ТаблицаЗначений;
					ТаможеннаяДекларация.Колонки.Добавить("КодСтраныПроисхождения", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(3)));
					ТаможеннаяДекларация.Колонки.Добавить("НомерТаможеннойДекларации", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(29)));
					СтрокаТД = ТаможеннаяДекларация.Добавить();
					СтрокаТД.КодСтраныПроисхождения    = ?(ЗначениеЗаполнено(ТекНФА.НФА.СтранаПроисхождения), ТекНФА.НФА.СтранаПроисхождения.Код, "");
					СтрокаТД.НомерТаможеннойДекларации = ТекНФА.НФА.НомерГТД;
					НоваяСтрока.ТаможеннаяДекларация = ТаможеннаяДекларация;
				КонецЕсли;	
			ИначеЕсли ТипЗнч(ТекНФА.НФА) = Тип("СправочникСсылка.ОсновныеСредства") Тогда	
				НоваяСтрока.ИдТовараУКонтрагента  = ТекНФА.НФА.УникальныйИдентификатор();
				НоваяСтрока.НаименованиеНоменклатуры  = ТекНФА.НФА.НаименованиеПолное;
			Иначе
				НоваяСтрока.НаименованиеНоменклатуры  = ТекНФА.НФА;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ТекНФА.СодержаниеУслуги) Тогда
				НоваяСтрока.НаименованиеНоменклатуры  = ТекНФА.СодержаниеУслуги;
			КонецЕсли;	
			
			НоваяСтрока.Номенклатура              = ТекНФА.НФА;
			НоваяСтрока.ЕдиницаИзмеренияКод       = ТекНФА.ЕдиницаИзмеренияКод;
			НоваяСтрока.Количество                = ТекНФА.Количество;
			НоваяСтрока.Цена                      = ТекНФА.Цена ;
			НоваяСтрока.СуммаБезНДС               = ТекНФА.Всего - ТекНФА.СуммаНДС;
			НоваяСтрока.СуммаСНДС                 = ТекНФА.Всего;
			НоваяСтрока.Акциза                    = "без акциза";
			НоваяСтрока.СуммаНДС                  = ТекНФА.СуммаНДС;
			НоваяСтрока.СтавкаНДС                 = ТекНФА.СтавкаНДС;
			
			Сопоставление = Новый Структура;
			Сопоставление.Вставить("Наименование", НоваяСтрока.НаименованиеНоменклатуры);
			
			ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду(НоваяСтрока.ЕдиницаИзмеренияКод);
			
			Сопоставление.Вставить("ЕдиницаИзмерения", ЕдиницаИзмерения.Наименование);
			Сопоставление.Вставить("Артикул", "");
			
			ХарактеристикаНаименование = "";
			Сопоставление.Вставить("Характеристика", ХарактеристикаНаименование);
			ШтрихкодыТовара = "";
			Сопоставление.Вставить("Штрихкод", ШтрихкодыТовара);
			УпаковкаИБ = "";
			
			Сопоставление.Вставить("НоменклатураИБ", НоваяСтрока.Номенклатура);
			Сопоставление.Вставить("ХарактеристикаИБ", ХарактеристикаНаименование);
			Сопоставление.Вставить("УпаковкаИБ", УпаковкаИБ);
			НоваяСтрока.Сопоставление = Сопоставление;
			
		КонецЦикла;	
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВсегоКОплате.СуммаБезНДСВсего", ТаблицаТоваров.Итог("СуммаБезНДС"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВсегоКОплате.СуммаСНДСВсего", ТаблицаТоваров.Итог("СуммаСНДС"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВсегоКОплате.СуммаНДСВсего", ТаблицаТоваров.Итог("СуммаНДС"));
		
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаТоваров, "ТаблицаТоваров");
	КонецЦикла;
	
КонецПроцедуры	

// Подготавливает данные для электронного документа типа ИсправительныйСчетФактураВыданный,
// исправляющего счет-фактуру.
//
// Параметры:
//  СсылкаНаОбъект - ДокументСсылка, ссылка на объект информационной базы, по которому необходимо создать электронный документ.
//  СтруктураЭД - Структура, структура данных для формирования электронного документа.
//
Процедура ПодготовитьДанныеПоИсправительномуСчетуФактуре(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ = Ложь)
	НетЗамечанийКДокументу = Документы["ИсправительныйСчетФактураВыданный"].ПредварительныйКонтрольДанныхДляЭД(СсылкаНаОбъект);
	
	Если НЕ НетЗамечанийКДокументу Тогда
		ОписаниеОшибки = НСтр("ru='Вышеуказанные ошибки препятствуют формированию электронного документа.
		|По этой причине и прочие данные документа не будут выгружены в ЭД.
		|После заполнения указанных реквизитов повторите попытку формирования электронного документа.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки);
		Отказ = Истина;
		Возврат;
	КонецЕсли;	
	
	ДанныеДокумента = Документы.ИсправительныйСчетФактураВыданный.ПодготовитьДанныеДляЭД(СсылкаНаОбъект,, Ложь);
	
	ТаблицаСФ	= ДанныеДокумента["Шапка"];
	ТаблицаНФА	= ДанныеДокумента["ТабЧастьНФА"];
	ТаблицаПРД	= ДанныеДокумента["ТабЧастьПРД"];
	
	Для каждого РеквизитыИСФ Из ТаблицаСФ Цикл
		
		Если Не ЗначениеЗаполнено(РеквизитыИСФ.ВалютаКод) Тогда
			ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
				"Объект.ВалютаДокумента");
		Иначе
			ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект.ВалютаДокумента, 
				"Объект.Код");
		КонецЕсли;
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснования", РеквизитыИСФ.ДокументОснование);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерСчетаФактуры", РеквизитыИСФ.НомерСчетаФактуры);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаСчетаФактуры", РеквизитыИСФ.ДатаСчетаФактуры);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсправления", РеквизитыИСФ.НомерИсправления);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаИсправления", РеквизитыИСФ.ДатаИсправления);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаКод", РеквизитыИСФ.КодВалюты, ПараметрыОбработкиОшибок);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ТолькоУслуги", ТолькоУслуги(РеквизитыИСФ.ВидЦенности));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВидСчетаФактуры", ВидСчетаФактуры(РеквизитыИСФ.ПричинаНалогообложения));
		
		ПараметрыУчастниковСФ = ОпределитьПоСсылкеПродавцаПокупателяГрузоотправителяГрузополучателя(СсылкаНаОбъект);
		
		ЗаполнитьДанныеГрузополучателяГрузоотправителя(?(ЗначениеЗаполнено(РеквизитыИСФ.Грузоотправитель), РеквизитыИСФ.Грузоотправитель, РеквизитыИСФ.Организация), "Грузоотправитель",
			РеквизитыИСФ.ДатаСчетаФактуры, ДеревоДанных, ПараметрыУчастниковСФ);
		ЗаполнитьДанныеГрузополучателяГрузоотправителя(?(ЗначениеЗаполнено(РеквизитыИСФ.Грузополучатель), РеквизитыИСФ.Грузополучатель, РеквизитыИСФ.Контрагент), "Грузополучатель",
			РеквизитыИСФ.ДатаСчетаФактуры, ДеревоДанных, ПараметрыУчастниковСФ);
		
		ЗаполнитьДанныеУчастника(РеквизитыИСФ.Организация, "Продавец", РеквизитыИСФ.ДатаСчетаФактуры, ДеревоДанных,,, Ложь, Ложь, Истина, ПараметрыУчастниковСФ);
		ЗаполнитьДанныеУчастника(РеквизитыИСФ.Контрагент, "Покупатель", РеквизитыИСФ.ДатаСчетаФактуры, ДеревоДанных,,, Ложь, Ложь, Истина, ПараметрыУчастниковСФ);
		
		//ПРД
		ПлатежныеДокументы = Новый ТаблицаЗначений;
		ПлатежныеДокументы.Колонки.Добавить("НомерПРД", Новый ОписаниеТипов("Строка"));
		ПлатежныеДокументы.Колонки.Добавить("ДатаПРД", Новый ОписаниеТипов("Дата"));
		
		Для каждого ТекПРД Из ТаблицаПРД Цикл
			НоваяСтрока = ПлатежныеДокументы.Добавить();
			НоваяСтрока.НомерПРД = ТекПРД.НомерПлатежноРасчетногоДокумента;
			НоваяСтрока.ДатаПРД  = ТекПРД.ДатаПлатежноРасчетногоДокумента;
		КонецЦикла;	
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ПлатежныеДокументы, "ПлатежноРасчетныеДокументы");
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВсегоКОплате.СуммаБезНДСВсего", ТаблицаНФА.Итог("Всего") - ТаблицаНФА.Итог("СуммаНДС"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВсегоКОплате.СуммаСНДСВсего", ТаблицаНФА.Итог("Всего"));
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВсегоКОплате.СуммаНДСВсего", ТаблицаНФА.Итог("СуммаНДС"));
		
		//НФА
		ТаблицаТоваров = СоздатьТаблицуТоваров();
		Для каждого ТекНФА из ТаблицаНФА Цикл
			НоваяСтрока                           = ТаблицаТоваров.Добавить();
			Если ТипЗнч(ТекНФА.НФА) = Тип("СправочникСсылка.Номенклатура") Тогда
				НоваяСтрока.ИдТовараУКонтрагента  = ТекНФА.НФА.УникальныйИдентификатор();
				НоваяСтрока.НаименованиеНоменклатуры  = ТекНФА.НФА.НаименованиеПолное;
			
				Если ЗначениеЗаполнено(ТекНФА.НФА.СтранаПроисхождения) Тогда
					ТаможеннаяДекларация = Новый ТаблицаЗначений;
					ТаможеннаяДекларация.Колонки.Добавить("КодСтраныПроисхождения", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(3)));
					ТаможеннаяДекларация.Колонки.Добавить("НомерТаможеннойДекларации", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(29)));
					СтрокаТД = ТаможеннаяДекларация.Добавить();
					СтрокаТД.КодСтраныПроисхождения    = ?(ЗначениеЗаполнено(ТекНФА.НФА.СтранаПроисхождения), ТекНФА.НФА.СтранаПроисхождения.Код, "");
					СтрокаТД.НомерТаможеннойДекларации = ТекНФА.НФА.НомерГТД;
					НоваяСтрока.ТаможеннаяДекларация = ТаможеннаяДекларация;
				КонецЕсли;	
			ИначеЕсли ТипЗнч(ТекНФА.НФА) = Тип("СправочникСсылка.ОсновныеСредства") Тогда	
				НоваяСтрока.ИдТовараУКонтрагента  = ТекНФА.НФА.УникальныйИдентификатор();
				НоваяСтрока.НаименованиеНоменклатуры  = ТекНФА.НФА.НаименованиеПолное;
			Иначе
				НоваяСтрока.НаименованиеНоменклатуры  = ТекНФА.НФА;
			КонецЕсли;	
			НоваяСтрока.Номенклатура              = ТекНФА.НФА;
			НоваяСтрока.ЕдиницаИзмеренияКод       = ТекНФА.ЕдиницаИзмеренияКод;
			НоваяСтрока.Количество                = ТекНФА.Количество;
			НоваяСтрока.Цена                      = ТекНФА.Цена ;
			НоваяСтрока.СуммаБезНДС               = ТекНФА.Всего - ТекНФА.СуммаНДС;
			НоваяСтрока.СуммаСНДС                 = ТекНФА.Всего;
			НоваяСтрока.Акциза                    = "без акциза";
			НоваяСтрока.СуммаНДС                  = ТекНФА.СуммаНДС;
			НоваяСтрока.СтавкаНДС                 = ТекНФА.СтавкаНДС;
			
			Сопоставление = Новый Структура;
			Сопоставление.Вставить("Наименование", НоваяСтрока.НаименованиеНоменклатуры);
			
			ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду(НоваяСтрока.ЕдиницаИзмеренияКод);
			
			Сопоставление.Вставить("ЕдиницаИзмерения", ЕдиницаИзмерения.Наименование);
			Сопоставление.Вставить("Артикул", "");
			
			ХарактеристикаНаименование = "";
			Сопоставление.Вставить("Характеристика", ХарактеристикаНаименование);
			ШтрихкодыТовара = "";
			Сопоставление.Вставить("Штрихкод", ШтрихкодыТовара);
			УпаковкаИБ = "";
			
			Сопоставление.Вставить("НоменклатураИБ", НоваяСтрока.Номенклатура);
			Сопоставление.Вставить("ХарактеристикаИБ", ХарактеристикаНаименование);
			Сопоставление.Вставить("УпаковкаИБ", УпаковкаИБ);
			НоваяСтрока.Сопоставление = Сопоставление;
			
		КонецЦикла;	
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаТоваров, "ТаблицаТоваров");
	КонецЦикла;
	
КонецПроцедуры	

// Подготавливает данные для электронного документа типа КорректировочныйСчетФактураВыданный.
//
// Параметры:
//  СсылкаНаОбъект - ДокументСсылка, ссылка на объект информационной базы, по которому необходимо создать электронный документ.
//  СтруктураЭД - Структура, структура данных для формирования электронного документа.
//
Процедура ПодготовитьДанныеПоКорректировочномуСчетуФактуре(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ = Ложь) Экспорт
	НетЗамечанийКДокументу = Документы["КорректировочныйСчетФактураВыданный"].ПредварительныйКонтрольДанныхДляЭД(СсылкаНаОбъект);
	
	Если НЕ НетЗамечанийКДокументу Тогда
		ОписаниеОшибки = НСтр("ru='Вышеуказанные ошибки препятствуют формированию электронного документа.
		|По этой причине и прочие данные документа не будут выгружены в ЭД.
		|После заполнения указанных реквизитов повторите попытку формирования электронного документа.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки);
		Отказ = Истина;
		Возврат;
	КонецЕсли;	
	
	ДанныеДокумента = Документы.КорректировочныйСчетФактураВыданный.ПодготовитьДанныеДляЭД(СсылкаНаОбъект);
	
	ТаблицаСФ	= ДанныеДокумента["Шапка"];
	ТаблицаНФА	= ДанныеДокумента["ТабЧастьНФА"];
	
	Для каждого РеквизитыКСФ Из ТаблицаСФ Цикл
		
		Если Не ЗначениеЗаполнено(РеквизитыКСФ.ВалютаКод) Тогда
			ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
				"Объект.ВалютаДокумента");
		Иначе
			ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект.ВалютаДокумента, 
				"Объект.Код");
		КонецЕсли;
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснования", РеквизитыКСФ.ДокументОснование);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерСчетаФактуры", РеквизитыКСФ.НомерСчетаФактуры);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаСчетаФактуры", РеквизитыКСФ.ДатаСчетаФактуры);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерКорСчетаФактуры", РеквизитыКСФ.НомерКорректировки);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаКорСчетаФактуры", РеквизитыКСФ.Дата);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаКод", РеквизитыКСФ.ВалютаКод, ПараметрыОбработкиОшибок);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ТолькоУслуги", ТолькоУслуги(РеквизитыКСФ.ВидЦенности));
		
		ПараметрыУчастниковСФ = ОпределитьПоСсылкеПродавцаПокупателяГрузоотправителяГрузополучателя(СсылкаНаОбъект);
		
		ЗаполнитьДанныеУчастника(РеквизитыКСФ.Организация, "Продавец", РеквизитыКСФ.Дата, ДеревоДанных,,, Ложь, Ложь, Истина, ПараметрыУчастниковСФ);
		ЗаполнитьДанныеУчастника(РеквизитыКСФ.Контрагент, "Покупатель", РеквизитыКСФ.Дата, ДеревоДанных,,, Ложь, Ложь, Истина, ПараметрыУчастниковСФ);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВсегоКОплате.СуммаСНДСВсего", ТаблицаНФА.Итог("СтоимостьСНДСПослеИзменения"));
		
		ТаблицаТоваров = СоздатьТаблицуТоваровДляКорректировки();
		Для каждого ТекНФА из ТаблицаНФА Цикл
			НоваяСтрока                          = ТаблицаТоваров.Добавить();
			Если ТипЗнч(ТекНФА.НФА) = Тип("СправочникСсылка.Номенклатура") Тогда
				НоваяСтрока.ИдТовараУКонтрагента  = ТекНФА.НФА.УникальныйИдентификатор();
				НоваяСтрока.НаименованиеНоменклатуры  = ТекНФА.НФА.НаименованиеПолное;
				
				Если ЗначениеЗаполнено(ТекНФА.НФА.СтранаПроисхождения) Тогда
					ТаможеннаяДекларация = Новый ТаблицаЗначений;
					ТаможеннаяДекларация.Колонки.Добавить("КодСтраныПроисхождения", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(3)));
					ТаможеннаяДекларация.Колонки.Добавить("НомерТаможеннойДекларации", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(29)));
					СтрокаТД = ТаможеннаяДекларация.Добавить();
					СтрокаТД.КодСтраныПроисхождения    = ?(ЗначениеЗаполнено(ТекНФА.НФА.СтранаПроисхождения), ТекНФА.НФА.СтранаПроисхождения.Код, "");
					СтрокаТД.НомерТаможеннойДекларации = ТекНФА.НФА.НомерГТД;
					НоваяСтрока.ТаможеннаяДекларация = ТаможеннаяДекларация;
				КонецЕсли;	
			ИначеЕсли ТипЗнч(ТекНФА.НФА) = Тип("СправочникСсылка.ОсновныеСредства") Тогда	
				НоваяСтрока.ИдТовараУКонтрагента  = ТекНФА.НФА.УникальныйИдентификатор();
				НоваяСтрока.НаименованиеНоменклатуры  = ТекНФА.НФА.НаименованиеПолное;
			Иначе
				НоваяСтрока.НаименованиеНоменклатуры  = ТекНФА.НФА;
			КонецЕсли;	
			НоваяСтрока.Номенклатура             = ТекНФА.НФА;
			НоваяСтрока.ЕдиницаИзмеренияКодДо    = ТекНФА.ЕдиницаИзмеренияКод;
			НоваяСтрока.ЕдиницаИзмеренияКод      = ТекНФА.ЕдиницаИзмеренияКод;
			НоваяСтрока.КоличествоДо             = ТекНФА.КоличествоДоИзменения;
			НоваяСтрока.Количество               = ТекНФА.Количество;
			НоваяСтрока.ЦенаДо                   = ТекНФА.ЦенаДоИзменения;
			НоваяСтрока.Цена                     = ТекНФА.Цена;
			НоваяСтрока.СуммаБезНДСДо            = ТекНФА.СтоимостьБезНДСДоИзменения;
			НоваяСтрока.СуммаБезНДС              = ТекНФА.СтоимостьБезНДСПослеИзменения;
			НоваяСтрока.СтавкаНДСДо              = ТекНФА.СтавкаНДСДоИзменения;
			НоваяСтрока.СтавкаНДС                = ТекНФА.СтавкаНДС;
			НоваяСтрока.СуммаНДСДо               = ТекНФА.СуммаНДСДоИзменения;
			НоваяСтрока.СуммаНДС                 = ТекНФА.СуммаНДСПослеИзменения;
			НоваяСтрока.СуммаСНДСДо              = ТекНФА.СтоимостьСНДСДоИзменения;
			НоваяСтрока.СуммаСНДС                = ТекНФА.СтоимостьСНДСПослеИзменения;
			НоваяСтрока.АкцизаДо                 = "без акциза";
			НоваяСтрока.Акциза                   = "без акциза";
			
			Номенклатура = ТекНФА.НФА;
			
			Сопоставление = Новый Структура;
			Сопоставление.Вставить("Наименование", НоваяСтрока.НаименованиеНоменклатуры);
			
			ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду(НоваяСтрока.ЕдиницаИзмеренияКод);
			
			Сопоставление.Вставить("ЕдиницаИзмерения", ЕдиницаИзмерения.Наименование);
			Сопоставление.Вставить("Артикул", "");
			
			ХарактеристикаНаименование = "";
			Сопоставление.Вставить("Характеристика", ХарактеристикаНаименование);
			ШтрихкодыТовара = "";
			Сопоставление.Вставить("Штрихкод", ШтрихкодыТовара);
			УпаковкаИБ = "";
			
			Сопоставление.Вставить("НоменклатураИБ", Номенклатура);
			Сопоставление.Вставить("ХарактеристикаИБ", ХарактеристикаНаименование);
			Сопоставление.Вставить("УпаковкаИБ", УпаковкаИБ);
			НоваяСтрока.Сопоставление = Сопоставление;
			
		КонецЦикла;	
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаТоваров, "ТаблицаТоваров");
		
	КонецЦикла;
	
КонецПроцедуры	

// Подготавливает данные для электронного документа типа ИсправительныйСчетФактураВыданный,
// исправляющего корректировочный счет-фактуру.
//
// Параметры:
//  СсылкаНаОбъект - ДокументСсылка, ссылка на объект информационной базы, по которому необходимо создать электронный документ.
//  СтруктураЭД - Структура, структура данных для формирования электронного документа.
//
Процедура ПодготовитьДанныеПоИсправительномуСчетуФактуре_Корректировка(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ = Ложь)
	
	НетЗамечанийКДокументу = Документы["ИсправительныйСчетФактураВыданный"].ПредварительныйКонтрольДанныхДляЭД(СсылкаНаОбъект);
	
	Если НЕ НетЗамечанийКДокументу Тогда
		ОписаниеОшибки = НСтр("ru='Вышеуказанные ошибки препятствуют формированию электронного документа.
		|По этой причине и прочие данные документа не будут выгружены в ЭД.
		|После заполнения указанных реквизитов повторите попытку формирования электронного документа.'");
		Сообщить(ОписаниеОшибки);
		Отказ = Истина;
		Возврат;
	КонецЕсли;	
	
	ДанныеДокумента = Документы.ИсправительныйСчетФактураВыданный.ПодготовитьДанныеДляЭД(СсылкаНаОбъект, "Корректировка", Ложь);
	
	ТаблицаСФ	= ДанныеДокумента["Шапка"];
	ТаблицаНФА	= ДанныеДокумента["ТабЧастьНФА"];
	
	Для каждого РеквизитыИСФ Из ТаблицаСФ Цикл
		
		Если Не ЗначениеЗаполнено(РеквизитыИСФ.Валюта) Тогда
			ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект, 
				"Объект.ВалютаДокумента");
		Иначе
			ПараметрыОбработкиОшибок = ЭлектронноеВзаимодействиеКлиентСервер.НовыеПараметрыОбработкиОшибки(СсылкаНаОбъект.ВалютаДокумента, 
				"Объект.Код");
		КонецЕсли;
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДокументыОснования", РеквизитыИСФ.ДокументОснование);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерСчетаФактуры", РеквизитыИСФ.НомерСчетаФактуры);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаСчетаФактуры", РеквизитыИСФ.ДатаСчетаФактуры);
		
		Если ЗначениеЗаполнено(РеквизитыИСФ.НомерИсправления) И РеквизитыИСФ.НомерИсправления <> "---" Тогда
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсправления", РеквизитыИСФ.НомерИсправления);
			ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаИсправления", РеквизитыИСФ.ДатаИсправления);
		КонецЕсли;	
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерКорСчетаФактуры", РеквизитыИСФ.НомерКорректировки);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаКорСчетаФактуры", РеквизитыИСФ.Дата);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "НомерИсправленияКорСчетаФактуры", РеквизитыИСФ.НомерИсправленияКорректировки);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ДатаИсправленияКорСчетаФактуры", РеквизитыИСФ.ДатаИсправленияКорректировки);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВалютаКод", РеквизитыИСФ.ВалютаКод, ПараметрыОбработкиОшибок);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ТолькоУслуги", ТолькоУслуги(РеквизитыИСФ.ВидЦенности));
		
		ПараметрыУчастниковСФ = ОпределитьПоСсылкеПродавцаПокупателяГрузоотправителяГрузополучателя(СсылкаНаОбъект);
		
		ЗаполнитьДанныеУчастника(РеквизитыИСФ.Организация, "Продавец", РеквизитыИСФ.Дата, ДеревоДанных,,, Ложь, Ложь, Истина, ПараметрыУчастниковСФ);
		ЗаполнитьДанныеУчастника(РеквизитыИСФ.Контрагент, "Покупатель", РеквизитыИСФ.Дата, ДеревоДанных,,, Ложь, Ложь, Истина, ПараметрыУчастниковСФ);
		
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных, "ВсегоКОплате.СуммаСНДСВсего", ТаблицаНФА.Итог("СтоимостьСНДСПослеИзменения"));
		
		ТаблицаТоваров = СоздатьТаблицуТоваровДляКорректировки();
		Для каждого ТекНФА из ТаблицаНФА Цикл
			НоваяСтрока                          = ТаблицаТоваров.Добавить();
			Если ТипЗнч(ТекНФА.НФА) = Тип("СправочникСсылка.Номенклатура") Тогда
				НоваяСтрока.ИдТовараУКонтрагента  = ТекНФА.НФА.УникальныйИдентификатор();
				НоваяСтрока.НаименованиеНоменклатуры  = ТекНФА.НФА.НаименованиеПолное;
				
				Если ЗначениеЗаполнено(ТекНФА.НФА.СтранаПроисхождения) Тогда
					ТаможеннаяДекларация = Новый ТаблицаЗначений;
					ТаможеннаяДекларация.Колонки.Добавить("КодСтраныПроисхождения", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(3)));
					ТаможеннаяДекларация.Колонки.Добавить("НомерТаможеннойДекларации", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(29)));
					СтрокаТД = ТаможеннаяДекларация.Добавить();
					СтрокаТД.КодСтраныПроисхождения    = ?(ЗначениеЗаполнено(ТекНФА.НФА.СтранаПроисхождения), ТекНФА.НФА.СтранаПроисхождения.Код, "");
					СтрокаТД.НомерТаможеннойДекларации = ТекНФА.НФА.НомерГТД;
					НоваяСтрока.ТаможеннаяДекларация = ТаможеннаяДекларация;
				КонецЕсли;	
			ИначеЕсли ТипЗнч(ТекНФА.НФА) = Тип("СправочникСсылка.ОсновныеСредства") Тогда	
				НоваяСтрока.ИдТовараУКонтрагента  = ТекНФА.НФА.УникальныйИдентификатор();
				НоваяСтрока.НаименованиеНоменклатуры  = ТекНФА.НФА.НаименованиеПолное;
			Иначе
				НоваяСтрока.НаименованиеНоменклатуры  = ТекНФА.НФА;
			КонецЕсли;	
			НоваяСтрока.Номенклатура             = ТекНФА.НФА;
			НоваяСтрока.ЕдиницаИзмеренияКодДо    = ТекНФА.ЕдиницаИзмеренияКод;
			НоваяСтрока.ЕдиницаИзмеренияКод      = ТекНФА.ЕдиницаИзмеренияКод;
			НоваяСтрока.КоличествоДо             = ТекНФА.КоличествоДоИзменения;
			НоваяСтрока.Количество               = ТекНФА.КоличествоПослеИзменения;
			НоваяСтрока.ЦенаДо                   = ТекНФА.ЦенаДоИзменения;
			НоваяСтрока.Цена                     = ТекНФА.ЦенаПослеИзменения;
			НоваяСтрока.СуммаБезНДСДо            = ТекНФА.СтоимостьБезНДСДоИзменения;
			НоваяСтрока.СуммаБезНДС              = ТекНФА.СтоимостьБезНДСПослеИзменения;
			НоваяСтрока.СтавкаНДСДо              = ТекНФА.СтавкаНДСДоИзменения;
			НоваяСтрока.СтавкаНДС                = ТекНФА.СтавкаНДСПослеИзменения;
			НоваяСтрока.СуммаНДСДо               = ТекНФА.СуммаНДСДоИзменения;
			НоваяСтрока.СуммаНДС                 = ТекНФА.СуммаНДСПослеИзменения;
			НоваяСтрока.СуммаСНДСДо              = ТекНФА.СтоимостьСНДСДоИзменения;
			НоваяСтрока.СуммаСНДС                = ТекНФА.СтоимостьСНДСПослеИзменения;
			НоваяСтрока.АкцизаДо                 = "без акциза";
			НоваяСтрока.Акциза                   = "без акциза";
			
			Сопоставление = Новый Структура;
			Сопоставление.Вставить("Наименование", НоваяСтрока.НаименованиеНоменклатуры);
			
			ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду(НоваяСтрока.ЕдиницаИзмеренияКод);
			
			Сопоставление.Вставить("ЕдиницаИзмерения", ЕдиницаИзмерения.Наименование);
			Сопоставление.Вставить("Артикул", "");
			
			ХарактеристикаНаименование = "";
			Сопоставление.Вставить("Характеристика", ХарактеристикаНаименование);
			ШтрихкодыТовара = "";
			Сопоставление.Вставить("Штрихкод", ШтрихкодыТовара);
			УпаковкаИБ = "";
			
			Сопоставление.Вставить("НоменклатураИБ", НоваяСтрока.Номенклатура);
			Сопоставление.Вставить("ХарактеристикаИБ", ХарактеристикаНаименование);
			Сопоставление.Вставить("УпаковкаИБ", УпаковкаИБ);
			НоваяСтрока.Сопоставление = Сопоставление;
			
		КонецЦикла;	
		ЭлектронноеВзаимодействие.ЗагрузитьТаблицуВДерево(ДеревоДанных, ТаблицаТоваров, "ТаблицаТоваров");
	КонецЦикла;	
КонецПроцедуры	

