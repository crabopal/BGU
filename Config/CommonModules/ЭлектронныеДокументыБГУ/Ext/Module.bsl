Процедура ЗаписатьНовыйШтрихкодОС(ДанныеШтрихкода, ДокументУчета, ОписаниеОшибки) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	
	Попытка
		Запись					= РегистрыСведений.ШтрихКоды.СоздатьМенеджерЗаписи();
		Запись.Объект			= ДанныеШтрихкода.ОбъектНФА;
		Запись.ИнвентарныйНомер	= ДанныеШтрихкода.ИнвНомер;
		Запись.ТипШтрихкода		= ПланыВидовХарактеристик.ТипыШтрихКодов.НайтиПоНаименованию(ДанныеШтрихкода.НаименованиеТипаШтрихкода);
		Запись.Штрихкод			= ДанныеШтрихкода.ЗначениеШтрихкода;
		
		Запись.Записать();
	Исключение
		
		Если Не ЗначениеЗаполнено(ДокументУчета) Тогда
			ТекстСообщенияОбОшибке = НСтр("ru = 'Не удалось получить сведения документа учета.
				|Следует записать документ и повторно выполнить команду ""Заполнить по эл.акту ф.0510448"".'");      
			ВызватьИсключение(ТекстСообщенияОбОшибке);
		КонецЕсли;
		
		ДокументОбъект = ДокументУчета.ПолучитьОбъект();
		
		Текст = НСтр("ru = 'Ошибка записи загружаемого из электронного акта ф.0510448 штрихкода!'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Запись нового штрихкода для ОС по данным электронного акта ф.0510448. %1, %2, %3, %4, %5'"), Текст,
			ДанныеШтрихкода.ОбъектНФА, ДанныеШтрихкода.ИнвНомер, ДанныеШтрихкода.НаименованиеТипаШтрихкода, ДанныеШтрихкода.ЗначениеШтрихкода);
		ОписаниеОшибки = ТекстСообщения;	
		ЗаписьЖурналаРегистрации(ТекстСообщения, УровеньЖурналаРегистрации.Ошибка, ДокументОбъект.Метаданные(), ДокументУчета,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение(Текст);
	КонецПопытки;
КонецПроцедуры	

// См. ОбменСКонтрагентамиПереопределяемый.СписокВидовИсходящихДокументов.
Процедура СписокВидовИсходящихДокументов(ТипДокумента, СписокСпособовОбработки) Экспорт
	ТипыДокументов = ОбменСКонтрагентами.ТипыДокументов();
	
	Если ТипДокумента = ТипыДокументов.ТоварнаяНакладная Тогда
		
		СписокСпособовОбработки.Добавить("НакладнаяНаРеализациюТорг12", НСтр("ru = 'Товарная накладная'"), Истина);
		
	ИначеЕсли ТипДокумента = ТипыДокументов.СчетФактура Тогда
		
		СписокСпособовОбработки.Добавить("СчетФактураВыданный", НСтр("ru = 'Счет-фактура выданный'"), Истина);
		
	ИначеЕсли ТипДокумента = ТипыДокументов.УПД Или ТипДокумента = ТипыДокументов.УКД Тогда
		
		СписокСпособовОбработки.Добавить("НакладнаяНаРеализациюТорг12", НСтр("ru = 'Товарная накладная'"), Истина);
		СписокСпособовОбработки.Добавить("АктОбОказанииУслуг", НСтр("ru = 'Акт выполненных работ'"), Истина);
		СписокСпособовОбработки.Добавить("СчетФактураВыданный", НСтр("ru = 'Счет-фактура выданный'"), Истина);
	
	ИначеЕсли ТипДокумента = ТипыДокументов.АктОРасхождениях Тогда
		
		СписокСпособовОбработки.Добавить("АктОРасхождениях", НСтр("ru = 'Акт о расхождениях по приемке'"), Истина);
		
	ИначеЕсли ТипДокумента = ТипыДокументов.АктВыполненныхРабот Тогда
		
		СписокСпособовОбработки.Добавить("АктОбОказанииУслуг", НСтр("ru = 'Акт выполненных работ'"), Истина);
	
	ИначеЕсли ТипДокумента = ТипыДокументов.АктНаПередачуПрав Тогда
		
		СписокСпособовОбработки.Добавить("АктОбОказанииУслуг", НСтр("ru = 'Акт на передачу прав'"), Истина);
		
	ИначеЕсли ТипДокумента = ТипыДокументов.КорректировочныйСчетФактура Тогда
		
		СписокСпособовОбработки.Добавить("КорректировочныйСчетФактураВыданный", НСтр("ru = 'Корректировочный счет-фактура выданный'"), Истина);
		
	КонецЕсли;

КонецПроцедуры	

Процедура ЗаполнитьGUIDНоменклатурыУОтправителяВНоменклатуре(Номенклатура, GUIDНоменклатурыУОтправителя) Экспорт
	Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
		Возврат;
	КонецЕсли;
	НоменклатураОбъект = Номенклатура.ПолучитьОбъект();
	Попытка
		НоменклатураОбъект.GUIDНоменклатурыОтправителя = GUIDНоменклатурыУОтправителя;
		
		НоменклатураОбъект.Записать();
	Исключение
		Текст = НСтр("ru = 'Ошибка записи внутреннего идентификатора номенклатуры.'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Заполнение внутреннего идентификатора номенклатуры %1 у Отправителя номенклатуры %2 на основе ЭД.'"), 
			GUIDНоменклатурыУОтправителя, Номенклатура)
			+ Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ВыполнитьЗаписьСобытияПоЭДВЖурналРегистрации(ТекстСообщения,
			2, УровеньЖурналаРегистрации.Ошибка, НоменклатураОбъект.Метаданные(), Номенклатура);
		ВызватьИсключение(Текст);
	КонецПопытки;
	
КонецПроцедуры

