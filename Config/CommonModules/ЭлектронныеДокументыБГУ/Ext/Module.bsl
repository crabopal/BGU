Функция НовыйКонтрагент(СтрокаДляЗагрузки, ДеревоРазбора, СсылкаНаВладельца)
	ИНН = ПолучитьЗначениеРеквизитаДерева(СтрокаДляЗагрузки, "ИНН", Истина, ДеревоРазбора);
	КПП = ПолучитьЗначениеРеквизитаДерева(СтрокаДляЗагрузки, "КПП", Истина, ДеревоРазбора);
	
	ОфициальноеНаименование = ПолучитьЗначениеРеквизитаДерева(СтрокаДляЗагрузки, "ОфициальноеНаименование", Истина, ДеревоРазбора);
	
	Если ПустаяСтрока(ОфициальноеНаименование) Тогда
		ОфициальноеНаименование = ПолучитьЗначениеРеквизитаДерева(СтрокаДляЗагрузки, "ПолноеНаименование", Истина, ДеревоРазбора);
	КонецЕсли; 
	
	Адрес = "";
	Телефон = "";
	МассивКонтрагенты = ДеревоРазбора.Строки.НайтиСтроки(Новый Структура("ТипОбъекта", "Контрагенты"));
	НайденнаяСтрока = ДеревоРазбора.Строки.Найти("Контрагенты");
	Если НайденнаяСтрока <> Неопределено Тогда
		НайденнаяСтрокаАдреса = НайденнаяСтрока.Строки[0].Строки.Найти("ФактическийАдрес_Представление");
		Если НайденнаяСтрокаАдреса <> Неопределено Тогда
			Адрес = НайденнаяСтрокаАдреса.ЗначениеРеквизита;	
		КонецЕсли;
		НайденнаяСтрокаКонтакты = НайденнаяСтрока.Строки[0].Строки.Найти("Контакты");
		Если НайденнаяСтрокаКонтакты <> Неопределено Тогда
			Контакты = НайденнаяСтрокаКонтакты.ЗначениеРеквизита;
			
			Для Каждого ЭлементКонтакты Из Контакты Цикл  
				Если ЭлементКонтакты.Вид = "Телефон" Тогда
					Телефон = ЭлементКонтакты.Представление;
				КонецЕсли;	
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;	
	
	Если СтрДлина(ИНН) > 10 Тогда
		ЭтоЮрЛицо = Ложь;
	Иначе
		ЭтоЮрЛицо = Истина;
	КонецЕсли;	
	
	Если СсылкаНаВладельца = Неопределено Тогда
	
		Если НЕ ЭтоЮрЛицо Тогда
			КонтрагентПроверки = Справочники.ФизическиеЛица.ПустаяСсылка();
			СсылкаНаОбъектПоИННКПП("ФизическиеЛица", ИНН, КПП, КонтрагентПроверки, ТекущаяДатаСеанса());
			Если ЗначениеЗаполнено(КонтрагентПроверки) Тогда
				ТекЛицо = КонтрагентПроверки.ПолучитьОбъект();
	        Иначе
				//Создаем физ. лицо
				ТекЛицо = Справочники.ФизическиеЛица.СоздатьЭлемент();
				ТекЛицо.ИНН = ИНН;
				ТекЛицо.КПП = КПП;
				ТекЛицо.СтранаРегистрации = Справочники.СтраныМира.Россия;
				ТекЛицо.Наименование = ОфициальноеНаименование;
			КонецЕсли;
			ТекстСправочник = НСтр("ru = 'Физические лица'");
		Иначе
			КонтрагентПроверки = Справочники.ЮридическиеЛица.ПустаяСсылка();
			СсылкаНаОбъектПоИННКПП("ЮридическиеЛица", ИНН, КПП, КонтрагентПроверки, ТекущаяДатаСеанса());
			Если ЗначениеЗаполнено(КонтрагентПроверки) Тогда
				ТекЛицо = КонтрагентПроверки.ПолучитьОбъект();
	        Иначе
				//Создаем юр. лицо
				ТекЛицо = Справочники.ЮридическиеЛица.СоздатьЭлемент();
				ТекЛицо.ИНН = ИНН;
				ТекЛицо.КПП = КПП;
				ТекЛицо.СтранаРегистрации = Справочники.СтраныМира.Россия;
				ТекЛицо.Наименование = ОфициальноеНаименование;
				ТекЛицо.НаименованиеПолное = ОфициальноеНаименование;
			КонецЕсли;
			ТекстСправочник = НСтр("ru = 'Юридические лица'");
		КонецЕсли;
		
		ТекЛицоУспешноЗаписано = Ложь;
		Попытка
			ТекЛицо.Записать();
			ТекЛицоУспешноЗаписано = Истина;
		Исключение
			Отказ = Истина;
			ТекстДействия = НСтр("ru = 'Запись нового элемента справочника '")+ТекстСправочник;
			
			ЗаписьЖурналаРегистрации(
				ТекстДействия,
				УровеньЖурналаРегистрации.Ошибка,
				ТекЛицо.Метаданные(),
				ТекЛицо,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ТекстОшибки = НСтр("ru = 'Ошибка при записи нового элемента справочника '") + ТекстСправочник +
				НСтр("ru = '|Подробности см. в Журнале регистрации.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		КонецПопытки;
		
		
		Если ТекЛицоУспешноЗаписано Тогда	
			//Создаем контрагента
			
			Контрагент = Справочники.Контрагенты.СоздатьЭлемент();
		
			Контрагент.Наименование = ОфициальноеНаименование;
			Контрагент.НаименованиеСокращенное = ОфициальноеНаименование;
			Контрагент.ИНН = ИНН;
			Контрагент.КПП = КПП;
			
			Контрагент.НаименованиеСокращенное = ОфициальноеНаименование;
			Контрагент.ВидКонтрагента = ?(ЭтоЮрЛицо, Перечисления.ЮрФизЛицо.ЮрЛицо ,Перечисления.ЮрФизЛицо.ФизЛицо);
			
			Контрагент.ЮридическоеФизическоеЛицо = ТекЛицо.Ссылка;
			
		Иначе
			Контрагент.КПП = "";
			
			ТекЛицо.Записать();
			
			Если НЕ ЭтоЮрЛицо Тогда
				Фамилия = ПолучитьЗначениеРеквизитаДерева(СтрокаДляЗагрузки, "Фамилия", Истина, ДеревоРазбора);
				Имя = ПолучитьЗначениеРеквизитаДерева(СтрокаДляЗагрузки, "Имя", Истина, ДеревоРазбора);
				Отчество = ПолучитьЗначениеРеквизитаДерева(СтрокаДляЗагрузки, "Отчество", Истина, ДеревоРазбора);
				
				НоваяЗапись = РегистрыСведений.ФИОФизическихЛиц.СоздатьМенеджерЗаписи();
				НоваяЗапись.Период = '19800101';
				НоваяЗапись.ФизическоеЛицо = ТекЛицо.Ссылка;
				НоваяЗапись.Фамилия  = Фамилия;
				НоваяЗапись.Имя      = Имя;
				НоваяЗапись.Отчество = Отчество;
				НоваяЗапись.Записать(Ложь);
			КонецЕсли;	
		КонецЕсли;
		
		Попытка
			Контрагент.Записать();
			КонтрагентСсылка = Контрагент.Ссылка;
		Исключение
			Отказ = Истина;
			
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Запись нового элемента справочника Контрагенты'"),
				УровеньЖурналаРегистрации.Ошибка,
				Контрагент.Метаданные(),
				Контрагент,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ТекстОшибки = НСтр("ru = 'Ошибка при записи нового элемента справочника Контрагенты
				|Подробности см. в Журнале регистрации.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		КонецПопытки;
		
	Иначе
	
		Контрагент = СсылкаНаВладельца.ПолучитьОбъект();
	
		Контрагент.Наименование = ОфициальноеНаименование;
		Контрагент.НаименованиеСокращенное = ОфициальноеНаименование;
		Контрагент.ИНН = ИНН;
		Контрагент.КПП = КПП;
		
		Попытка
			Контрагент.Записать();
			КонтрагентСсылка = Контрагент.Ссылка;

		Исключение
			Отказ = Истина;
			
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Запись нового элемента справочника Контрагенты'"),
				УровеньЖурналаРегистрации.Ошибка,
				Контрагент.Метаданные(),
				Контрагент,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ТекстОшибки = НСтр("ru = 'Ошибка при записи нового элемента справочника Контрагенты
				|Подробности см. в Журнале регистрации.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		КонецПопытки;
		
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(Адрес) Тогда
		
		Если НЕ ЭтоЮрЛицо Тогда
			ВидКонтактнойИнформации = Справочники.ВидыКонтактнойИнформации.АдресПоПропискеФизическиеЛица;
		Иначе	
			ВидКонтактнойИнформации = Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты;
		КонецЕсли;
		
		ЮридическоеФизическоеЛицоОбъект = Контрагент.ЮридическоеФизическоеЛицо.ПолучитьОбъект();
		УдалениеЗаписиКонтактнойИнформацииКонтрагента(ЮридическоеФизическоеЛицоОбъект, ВидКонтактнойИнформации);
		ЗаписьАдресаКонтрагента(ЮридическоеФизическоеЛицоОбъект, Адрес, ВидКонтактнойИнформации);
		ЮридическоеФизическоеЛицоОбъект.Записать();
		
		УдалениеЗаписиКонтактнойИнформацииКонтрагента(Контрагент, ВидКонтактнойИнформации);
		ЗаписьАдресаКонтрагента(Контрагент, Адрес, ВидКонтактнойИнформации);
		Контрагент.Записать();
			
		Если НЕ ЭтоЮрЛицо Тогда
			ВидКонтактнойИнформации = Справочники.ВидыКонтактнойИнформации.АдресМестаПроживанияФизическиеЛица;
		Иначе	
			ВидКонтактнойИнформации = Справочники.ВидыКонтактнойИнформации.ФактическийАдресКонтрагенты;
		КонецЕсли;
			
		ЮридическоеФизическоеЛицоОбъект = Контрагент.ЮридическоеФизическоеЛицо.ПолучитьОбъект();
		УдалениеЗаписиКонтактнойИнформацииКонтрагента(ЮридическоеФизическоеЛицоОбъект, ВидКонтактнойИнформации);
		ЗаписьАдресаКонтрагента(ЮридическоеФизическоеЛицоОбъект, Адрес, ВидКонтактнойИнформации);
		ЮридическоеФизическоеЛицоОбъект.Записать();
		
		УдалениеЗаписиКонтактнойИнформацииКонтрагента(Контрагент, ВидКонтактнойИнформации);
		ЗаписьАдресаКонтрагента(Контрагент, Адрес, ВидКонтактнойИнформации);
		Контрагент.Записать();
	КонецЕсли;	
	
	Если НЕ ПустаяСтрока(Телефон) Тогда
		
		Если НЕ ЭтоЮрЛицо Тогда
			ВидКонтактнойИнформации = Справочники.ВидыКонтактнойИнформации.ТелефонРабочийФизическиеЛица;
		Иначе
			ВидКонтактнойИнформации = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагенты;
		КонецЕсли;
		
		ЮридическоеФизическоеЛицоОбъект = Контрагент.ЮридическоеФизическоеЛицо.ПолучитьОбъект();
		УдалениеЗаписиКонтактнойИнформацииКонтрагента(ЮридическоеФизическоеЛицоОбъект, ВидКонтактнойИнформации);
		ЗаписьТелефонаКонтрагента(ЮридическоеФизическоеЛицоОбъект, Телефон, ВидКонтактнойИнформации);
		ЮридическоеФизическоеЛицоОбъект.Записать();
		
		УдалениеЗаписиКонтактнойИнформацииКонтрагента(Контрагент, ВидКонтактнойИнформации);
		ЗаписьТелефонаКонтрагента(Контрагент, Телефон, ВидКонтактнойИнформации);
		Контрагент.Записать();
		
	КонецЕсли;
	
	КонтрагентСсылка = Контрагент.Ссылка;
	
	Отбор = Новый Структура("Реквизит", "СтрокаТЧРасчетныйСчет");
	МассивСчетов = СтрокаДляЗагрузки.Строки.НайтиСтроки(Отбор);
	
	Для Каждого ЭлементМассива Из МассивСчетов Цикл
		НомерСчета = ПолучитьЗначениеРеквизитаДерева(ЭлементМассива, "НомерСчета", Истина, ДеревоРазбора);
		Если Не ЗначениеЗаполнено(НомерСчета) Тогда
			Продолжить;
		КонецЕсли;
		БанкБИК = ПолучитьЗначениеРеквизитаДерева(ЭлементМассива, "БанкБИК", Истина, ДеревоРазбора);
		
		Если ЗначениеЗаполнено(БанкБИК) Тогда
			Банк = Справочники.Банки.ПустаяСсылка();
			НайтиСсылкуНаОбъект("Банки", Банк, БанкБИК);
		КонецЕсли;
		
		//поиск имеющихся и создание новых счетов в случае отсутствия
		СоздатьНовыйСчет(КонтрагентСсылка, НомерСчета, БанкБИК, Банк);
		
	КонецЦикла;
	
	Возврат КонтрагентСсылка;
	
КонецФункции

Процедура ЗаписьАдресаКонтрагента(ЭлементСправочника, Адрес, ВидКонтактнойИнформации)
	XMLШаблонПредставления = "<КонтактнаяИнформация xmlns=""http://www.v8.1c.ru/ssl/contactinfo"" xmlns:xs=""http://www.w3.org/2001/XMLSchema"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"" Представление=""АдресДляЗамены""><Комментарий/><Состав xsi:type=""Адрес"" Страна=""РОССИЯ""><Состав xsi:type=""АдресРФ""><Адрес_по_документу>АдресДляЗамены</Адрес_по_документу></Состав></Состав></КонтактнаяИнформация>";
	XMLПредставление = СтрЗаменить(XMLШаблонПредставления, "АдресДляЗамены", Адрес);
	УправлениеКонтактнойИнформацией.ЗаписатьКонтактнуюИнформацию(ЭлементСправочника, XMLПредставление, ВидКонтактнойИнформации, ВидКонтактнойИнформации.Тип);
КонецПроцедуры

Процедура ЗаписьТелефонаКонтрагента(ЭлементСправочника, Телефон, ВидКонтактнойИнформации)
	XMLШаблонПредставления = "<КонтактнаяИнформация xmlns=""http://www.v8.1c.ru/ssl/contactinfo"" xmlns:xs=""http://www.w3.org/2001/XMLSchema"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"" Представление=""ТелефонДляЗамены""><Комментарий/><Состав xsi:type=""НомерТелефона"" КодСтраны="""" КодГорода="""" Номер=""ТелефонДляЗамены"" Добавочный=""""/></КонтактнаяИнформация>";
	XMLПредставление = СтрЗаменить(XMLШаблонПредставления, "ТелефонДляЗамены", Телефон);
	УправлениеКонтактнойИнформацией.ЗаписатьКонтактнуюИнформацию(ЭлементСправочника, XMLПредставление, ВидКонтактнойИнформации, ВидКонтактнойИнформации.Тип);
КонецПроцедуры

Процедура УдалениеЗаписиКонтактнойИнформацииКонтрагента(ЭлементСправочника, ВидКонтактнойИнформации)
	Для каждого ТекСтрока Из ЭлементСправочника.КонтактнаяИнформация Цикл
		Если ТекСтрока.Вид = ВидКонтактнойИнформации Тогда
			ЭлементСправочника.КонтактнаяИнформация.Удалить(ТекСтрока);
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры

Процедура СоздатьНовыйСчет(Владелец, НомерСчета, БИКБанка, Банк)

	СчетКонтрагента = СчетКонтрагента(Владелец, НомерСчета);
	
	Если НЕ ЗначениеЗаполнено(СчетКонтрагента) Тогда
		//создание нового счета
		СчетКонтрагента					 = Справочники.БанковскиеИКазначейскиеСчета.СоздатьЭлемент();
		СчетКонтрагента.Владелец		 = Владелец;
		СчетКонтрагента.Код				 = НомерСчета;
		СчетКонтрагента.ТипЛицевогоСчета = Перечисления.ТипыЛицевыхСчетов.Банковский;
		СчетКонтрагента.Наименование	 = "Расчетный счет";
		
		Если НЕ ЗначениеЗаполнено(Банк) Тогда
			Банк = Справочники.Банки.НайтиПоКоду(БИКБанка);
			Если НЕ ЗначениеЗаполнено(Банк) Тогда
				ТЗБанки = Справочники.Банки.ПолучитьТаблицуБанковПоРеквизитам("Код", БИКБанка);
				Если ТЗБанки.Количество()>0 Тогда
					Банк = ТЗБанки[0].Ссылка;
				КонецЕсли;	
			КонецЕсли;	
			Если НЕ ЗначениеЗаполнено(Банк) Тогда
				ТекстСообщения = НСтр("ru='Банк расчетного счета %1 для контрагента %2 не найден в справочнике банков и его следует указать вручную.'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, НомерСчета, Владелец);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			КонецЕсли;	
		КонецЕсли;
		СчетКонтрагента.КассовыйОрган	 = Банк;
		Попытка
			СчетКонтрагента.Записать();
		Исключение
			Текст = НСтр("ru = 'Ошибка создания расчетного счета контрагента при загрузке электронного документа'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Создание расчетного счета с номером %1 для контрагента %2 при загрузке электронного документа'"), НомерСчета, Текст);
			ЗаписьЖурналаРегистрации(ТекстСообщения, УровеньЖурналаРегистрации.Ошибка, Владелец.Метаданные(), Владелец,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ВызватьИсключение(Текст);
		КонецПопытки;
	КонецЕсли;
	
