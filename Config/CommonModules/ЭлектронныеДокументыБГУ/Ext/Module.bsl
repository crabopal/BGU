		|	ПередачаОбъектовИК.Ссылка КАК ДокументОснование
		|ПОМЕСТИТЬ ПередачаОбъектовИК
		|ИЗ
		|	Документ.ПередачаОбъектовИК КАК ПередачаОбъектовИК
		|ГДЕ
		|	ПередачаОбъектовИК.Организация = &Организация
		|	И НАЧАЛОПЕРИОДА(ПередачаОбъектовИК.Дата, ДЕНЬ) = &ДатаДокумента
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	АктыОбОказанииУслуг.Организация КАК Организация,
		|	АктыОбОказанииУслуг.Номер КАК Номер,
		|	АктыОбОказанииУслуг.Дата КАК Дата,
		|	АктыОбОказанииУслуг.Приоритет КАК Приоритет,
		|	АктыОбОказанииУслуг.Ссылка КАК Ссылка,
		|	АктыОбОказанииУслуг.НомерДляПечати КАК НомерДляПечати,
		|	АктыОбОказанииУслуг.ДокументОснование КАК ДокументОснование
		|ИЗ
		|	АктыОбОказанииУслуг КАК АктыОбОказанииУслуг
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НакладныеИК.Организация,
		|	НакладныеИК.Номер,
		|	НакладныеИК.Дата,
		|	НакладныеИК.Приоритет,
		|	НакладныеИК.Ссылка,
		|	НакладныеИК.НомерДляПечати,
		|	НакладныеИК.ДокументОснование
		|ИЗ
		|	НакладныеИК КАК НакладныеИК
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НакладныеМ15.Организация,
		|	НакладныеМ15.Номер,
		|	НакладныеМ15.Дата,
		|	НакладныеМ15.Приоритет,
		|	НакладныеМ15.Ссылка,
		|	НакладныеМ15.НомерДляПечати,
		|	НакладныеМ15.ДокументОснование
		|ИЗ
		|	НакладныеМ15 КАК НакладныеМ15
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НакладныеТорг12.Организация,
		|	НакладныеТорг12.Номер,
		|	НакладныеТорг12.Дата,
		|	НакладныеТорг12.Приоритет,
		|	НакладныеТорг12.Ссылка,
		|	НакладныеТорг12.НомерДляПечати,
		|	НакладныеТорг12.ДокументОснование
		|ИЗ
		|	НакладныеТорг12 КАК НакладныеТорг12
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СчетаФактурыВыданные.Организация,
		|	СчетаФактурыВыданные.Номер,
		|	СчетаФактурыВыданные.Дата,
		|	СчетаФактурыВыданные.Приоритет,
		|	СчетаФактурыВыданные.Ссылка,
		|	СчетаФактурыВыданные.НомерДляПечати,
		|	СчетаФактурыВыданные.ДокументОснование
		|ИЗ
		|	СчетаФактурыВыданные КАК СчетаФактурыВыданные
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЭлектронныйПередаточныйДокументУслугиРаботы.Организация,
		|	ЭлектронныйПередаточныйДокументУслугиРаботы.Номер,
		|	ЭлектронныйПередаточныйДокументУслугиРаботы.Дата,
		|	ЭлектронныйПередаточныйДокументУслугиРаботы.Приоритет,
		|	ЭлектронныйПередаточныйДокументУслугиРаботы.Ссылка,
		|	ЭлектронныйПередаточныйДокументУслугиРаботы.НомерДляПечати,
		|	ЭлектронныйПередаточныйДокументУслугиРаботы.ДокументОснование
		|ИЗ
		|	ЭлектронныйПередаточныйДокументУслугиРаботы КАК ЭлектронныйПередаточныйДокументУслугиРаботы
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПередачаОбъектовОС.Организация,
		|	ПередачаОбъектовОС.Номер,
		|	ПередачаОбъектовОС.Дата,
		|	ПередачаОбъектовОС.Приоритет,
		|	ПередачаОбъектовОС.Ссылка,
		|	ПередачаОбъектовОС.НомерДляПечати,
		|	ПередачаОбъектовОС.ДокументОснование
		|ИЗ
		|	ПередачаОбъектовОС КАК ПередачаОбъектовОС
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПередачаОбъектовИК.Организация,
		|	ПередачаОбъектовИК.Номер,
		|	ПередачаОбъектовИК.Дата,
		|	ПередачаОбъектовИК.Приоритет,
		|	ПередачаОбъектовИК.Ссылка,
		|	ПередачаОбъектовИК.НомерДляПечати,
		|	ПередачаОбъектовИК.ДокументОснование
		|ИЗ
		|	ПередачаОбъектовИК КАК ПередачаОбъектовИК
		|
		|УПОРЯДОЧИТЬ ПО
		|	Приоритет,
		|	Дата,
		|	Номер";
	КонецЕсли;	
		
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("ДатаДокумента", НачалоДня(ДатаДокумента));
	
	СоздаватьЭлектронныеПередаточныеДокументыДляКонтрагентаИДоговора = ЭлектронныеДокументыБГУ.ЗначениеНастройкиСоздаватьПередаточныеДокументыПоКонтрагентуИДоговору(Организация);
	
	ТЗ = Запрос.Выполнить().Выгрузить();
	Для каждого ТекСтрока Из ТЗ Цикл
		Если ТипЗнч(ТекСтрока.Ссылка) = Тип("ДокументСсылка.ЭлектронныйПередаточныйДокументУслугиРаботы") Тогда
			РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекСтрока.Ссылка, "Контрагент, Договор");
			//Если НЕ СоздаватьЭлектронныеПередаточныеДокументыДляКонтрагентаИДоговора И ТекСтрока.Ссылка.ИдентификаторыСтрокДокументаОснования.Количество()>0 Тогда
				РеквизитыДокумента.Вставить("ИдентификаторЭД", ТекСтрока.Ссылка.ИдентификаторыСтрокДокументаОснования[0].ИдентификаторЭД);
			//КонецЕсли;	
			ТекСтрока.НомерДляПечати = НомерПередаточногоДокументаЭД(ТекСтрока.ДокументОснование, РеквизитыДокумента, СоздаватьЭлектронныеПередаточныеДокументыДляКонтрагентаИДоговора);
		Иначе	
			ТекСтрока.НомерДляПечати = НомерДляПечати(ТекСтрока.Ссылка, ТекСтрока.Номер);
		КонецЕсли;
	КонецЦикла;
	
	НайденнаяСтрока = ТЗ.Найти(НомерДокумента, "НомерДляПечати");
	Если НЕ НайденнаяСтрока = Неопределено Тогда
		Если ТипЗнч(НайденнаяСтрока.Ссылка) = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
			Результат = НайденнаяСтрока.ДокументОснование;
		Иначе	
			Результат = НайденнаяСтрока.Ссылка;
		КонецЕсли;
	Иначе
		НайденнаяСтрока = ТЗ.Найти(НомерДокумента, "Номер");
		Если НЕ НайденнаяСтрока = Неопределено Тогда
			Результат = НайденнаяСтрока.Ссылка;
		Иначе
			Результат = Документы.АктОбОказанииУслуг.ПустаяСсылка();
		КонецЕсли;	
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

Функция НайтиИсправляемыйАктОРасторженияхПолученный(Организация, НомерДокумента, ДатаДокумента, Контрагент)
	
	Результат = Неопределено;
	
	Запрос = Новый Запрос;
	Если ЗначениеЗаполнено(Контрагент) Тогда
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	АктОРасхожденияхПолученный.Организация КАК Организация,
		|	АктОРасхожденияхПолученный.Номер КАК Номер,
		|	АктОРасхожденияхПолученный.Дата КАК Дата,
		|	АктОРасхожденияхПолученный.Ссылка КАК Ссылка,
		|	"""" КАК НомерДляПечати
		|ИЗ
		|	Документ.АктОРасхожденияхПолученный КАК АктОРасхожденияхПолученный
		|ГДЕ
		|	АктОРасхожденияхПолученный.Организация = &Организация
		|	И НАЧАЛОПЕРИОДА(АктОРасхожденияхПолученный.Дата, ДЕНЬ) = &ДатаДокумента
		|	И АктОРасхожденияхПолученный.Контрагент = &Контрагент
		|	И АктОРасхожденияхПолученный.НомерВходящегоДокумента = &НомерВходящегоДокумента
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата,
		|	Номер";
	Иначе
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	АктОРасхожденияхПолученный.Организация КАК Организация,
		|	АктОРасхожденияхПолученный.Номер КАК Номер,
		|	АктОРасхожденияхПолученный.Дата КАК Дата,
		|	АктОРасхожденияхПолученный.Ссылка КАК Ссылка,
		|	"""" КАК НомерДляПечати
		|ИЗ
		|	Документ.АктОРасхожденияхПолученный КАК АктОРасхожденияхПолученный
		|ГДЕ
		|	АктОРасхожденияхПолученный.Организация = &Организация
		|	И НАЧАЛОПЕРИОДА(АктОРасхожденияхПолученный.Дата, ДЕНЬ) = &ДатаДокумента
		|	И АктОРасхожденияхПолученный.НомерВходящегоДокумента = &НомерВходящегоДокумента
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата,
		|	Номер";
	КонецЕсли;	
		
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("ДатаДокумента", НачалоДня(ДатаДокумента));
	Запрос.УстановитьПараметр("НомерВходящегоДокумента", НомерДокумента);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;	
	
	Возврат Результат;
	
КонецФункции

#Область УПД_2019

// Подготавливает данные для электронного документа типа УПД (информация продавца).
//
// Параметры:
//  СсылкаНаОбъект - ДокументСсылка - ссылка на объект информационной базы, по которому необходимо 
//                                    создать электронный документ.
//  СтруктураЭД - Структура - структура данных для формирования электронного документа.
//  ДеревоДанных - ДеревоЗначений - дерево данных заполнения электронного документа.
//  Отказ - Булево - если нужно отказаться от создания электронного документа, необходимо установить значение в Истина.
//                   После этого дальнейшие действия по формированию документа производиться не будут, поэтому
//                   нужно сформировать сообщения пользователю при необходимости самостоятельно.
//
Процедура ЗаполнитьДанныеДляУПДИнформацияПродавцаФНС_2019(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ) Экспорт
	ДанныеЗаполнены = Ложь;

	ЗаполнитьДанныеДляСЧФИнформацияПродавцаФНС_2019(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ, ДанныеЗаполнены, Истина);
	
	Если НЕ Отказ Тогда
		Если НЕ ДанныеЗаполнены Тогда
			ЗаполнитьДанныеДляДОПИнформацияПродавцаФНС_2019(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Подготавливает данные для электронного документа типа УПД (информация продавца).
//
// Параметры:
//  СсылкаНаОбъект - ДокументСсылка - ссылка на объект информационной базы, по которому необходимо 
//                                    создать электронный документ.
//  СтруктураЭД - Структура - структура данных для формирования электронного документа.
//  ДеревоДанных - ДеревоЗначений - дерево данных заполнения электронного документа.
//  Отказ - Булево - если нужно отказаться от создания электронного документа, необходимо установить значение в Истина.
//                   После этого дальнейшие действия по формированию документа производиться не будут, поэтому
//                   нужно сформировать сообщения пользователю при необходимости самостоятельно.
//
Процедура ЗаполнитьДанныеДляДОПИнформацияПродавцаФНС_2019(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ) Экспорт
	ТипДокумента = ТипЗнч(СсылкаНаОбъект);
	
	ЭтоРеализация = Ложь;
	ЭтоТовары = Ложь;
	ЭтоУслуги = Ложь;
	ЭтоСчетФактура = Ложь;
	Если ТипДокумента = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.НакладнаяНаОтпускМ15")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.ПередачаОбъектовОС")
		ИЛИ ТипДокумента = Тип("ДокументСсылка.ПередачаОбъектовИК") Тогда
		ЭтоРеализация = Истина;
		ЭтоТовары = Истина;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.АктОбОказанииУслуг") Тогда
		ЭтоРеализация = Истина;
		ЭтоУслуги = Истина;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ЭлектронныйПередаточныйДокументУслугиРаботы") Тогда
		ЭтоРеализация = Истина;
		ЭтоУслуги = Истина;
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		ЭтоСчетФактура = Истина;
	КонецЕсли;	
	
	Если ЭтоРеализация Тогда
		ДокументСсылкаДОП = СсылкаНаОбъект;
		Если СтруктураЭД.Функция = "СЧФДОП" Тогда //СЧФДОПУПД
			СчетФактура = НайтиПодчиненныйСчетФактуруВыданный(ДокументСсылкаДОП);
			Если ЗначениеЗаполнено(СчетФактура) Тогда
				ДокументСсылкаСЧФ = СчетФактура;
			Иначе
				Отказ = Истина;
				ШаблонСообщения = НСтр("ru = 'По документу %1 счет-фактура не выписан.'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, ДокументСсылкаДОП);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				Возврат;
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ЭтоСчетФактура Тогда
		ДокументСсылкаСЧФ = СсылкаНаОбъект;
		Если ЗначениеЗаполнено(ДокументСсылкаСЧФ.ДокументОснование) Тогда
			ДокументСсылкаДОП = ДокументСсылкаСЧФ.ДокументОснование;
			ТипДокумента = ТипЗнч(ДокументСсылкаДОП);
			
			Если ТипДокумента = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12")
				ИЛИ ТипДокумента = Тип("ДокументСсылка.НакладнаяНаОтпускМ15")
				ИЛИ ТипДокумента = Тип("ДокументСсылка.ПередачаОбъектовОС")
				ИЛИ ТипДокумента = Тип("ДокументСсылка.ПередачаОбъектовИК") Тогда
				ЭтоРеализация = Истина;
				ЭтоТовары = Истина;
			ИначеЕсли	ТипДокумента = Тип("ДокументСсылка.АктОбОказанииУслуг") Тогда
				ЭтоРеализация = Истина;
				ЭтоУслуги = Истина;
			КонецЕсли;	
		Иначе
			ШаблонСообщения = НСтр("ru = 'Для %1 универсальный передаточный документ не применяется.'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, ДокументСсылкаСЧФ);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ЭтоРеализация Тогда
		Если СтруктураЭД.Функция = "ДОП" Тогда //ДОПУПД
			Если ЭтоТовары Тогда 
				ЗаполнитьДанныеПоТорг12ПродавецУПД_2019(ДокументСсылкаДОП, СтруктураЭД, ДеревоДанных, Отказ);
			ИначеЕсли ЭтоУслуги Тогда
				ЗаполнитьДанныеПоАкт501ИсполнительУПД_2019(ДокументСсылкаДОП, СтруктураЭД, ДеревоДанных, Отказ);
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Подготавливает данные для электронного документа типа УПД (информация продавца).
//
// Параметры:
//  СсылкаНаОбъект - ДокументСсылка - ссылка на объект информационной базы, по которому необходимо 
//                                    создать электронный документ.
//  СтруктураЭД - Структура - структура данных для формирования электронного документа.
//  ДеревоДанных - ДеревоЗначений - дерево данных заполнения электронного документа.
//  Отказ - Булево - если нужно отказаться от создания электронного документа, необходимо установить значение в Истина.
//                   После этого дальнейшие действия по формированию документа производиться не будут, поэтому
//                   нужно сформировать сообщения пользователю при необходимости самостоятельно.
//
Процедура ЗаполнитьДанныеДляСЧФИнформацияПродавцаФНС_2019(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных, Отказ, ДанныеЗаполнены = Ложь, ЭтоУПД = Ложь) Экспорт
	ЭтоИсправительныйСФ = Ложь;
	ТипДокумента = ТипЗнч(СсылкаНаОбъект);
	Если ТипДокумента = Тип("ДокументСсылка.СчетФактураВыданный") Тогда
		
		ДокументСсылкаСЧФ = СсылкаНаОбъект;
		Если СтруктураЭД.Функция = "СЧФДОП" Тогда //СЧФДОПУПД
			Если ЗначениеЗаполнено(ДокументСсылкаСЧФ.ДокументОснование) Тогда
				ДокументСсылкаДОП = ДокументСсылкаСЧФ.ДокументОснование;
			Иначе
				ШаблонСообщения = НСтр("ru = 'Для %1 универсальный передаточный документ не применяется.'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, ДокументСсылкаСЧФ);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ИсправительныйСчетФактураВыданный") Тогда
		ЭтоИсправительныйСФ = Истина;
		ДокументСсылкаСЧФ = СсылкаНаОбъект;
		
		Если ТипЗнч(ДокументСсылкаСЧФ.ИсправляемыйДокумент) = Тип("ДокументСсылка.КорректировочныйСчетФактураВыданный") Тогда
			
			ЗаполнитьДанныеДляКСЧФИнформацияПродавцаФНС_2019(СсылкаНаОбъект, СтруктураЭД, ДеревоДанных);
			ДанныеЗаполнены = Истина;
			
			Возврат;
		КонецЕсли;	
		
	ИначеЕсли ТипДокумента = Тип("ДокументСсылка.НакладнаяНаРеализациюТорг12")
				ИЛИ	ТипДокумента = Тип("ДокументСсылка.АктОбОказанииУслуг")
				ИЛИ	ТипДокумента = Тип("ДокументСсылка.НакладнаяНаОтпускМ15")
				ИЛИ	ТипДокумента = Тип("ДокументСсылка.ПередачаОбъектовОС")
				ИЛИ	ТипДокумента = Тип("ДокументСсылка.ПередачаОбъектовИК") Тогда
		
		ДокументСсылкаДОП = СсылкаНаОбъект;
		СчетФактура = НайтиПодчиненныйСчетФактуруВыданный(ДокументСсылкаДОП);
		Если ЗначениеЗаполнено(СчетФактура) Тогда
			ДокументСсылкаСЧФ = СчетФактура;
		Иначе
			Отказ = Истина;
			ШаблонСообщения = НСтр("ru = 'По документу %1 счет-фактура не выписан.'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, ДокументСсылкаДОП);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Возврат;
		КонецЕсли;
	Иначе
		ДокументСсылкаДОП = Неопределено;
		СчетФактура = НайтиПодчиненныйСчетФактуруВыданный(СсылкаНаОбъект);
		Если ЗначениеЗаполнено(СчетФактура) Тогда
			ДокументСсылкаСЧФ = СчетФактура;
		Иначе
			Отказ = Истина;
			ШаблонСообщения = НСтр("ru = 'По документу %1 счет-фактура не выписан.'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, СсылкаНаОбъект);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ЭтоИсправительныйСФ Тогда
		ПодготовитьДанныеПоИсправительномуСчетуФактуреУПД_2019(ДокументСсылкаСЧФ, СтруктураЭД, ДеревоДанных, Отказ, ЭтоУПД);
		ДанныеЗаполнены = Истина;
	Иначе
		ПодготовитьДанныеПоСчетуФактуреУПД_2019(ДокументСсылкаСЧФ, СтруктураЭД, ДеревоДанных, Отказ, ЭтоУПД);
		ДанныеЗаполнены = Истина;
	КонецЕсли;	
	
КонецПроцедуры

// Подготавливает данные для электронного документа типа УПД (информация покупателя).
//
// Параметры:
//  СсылкаНаЭД - Ссылка - ссылка на ЭД, по которому необходимо сформировать электронный документ.
//  СтруктураЭД - Структура - структура данных для формирования электронного документа.
//  ДеревоДанных - ДеревоЗначений - дерево данных заполнения электронного документа.
//  Отказ - Булево - если нужно отказаться от создания электронного документа, необходимо установить значение в Истина.
//                   После этого дальнейшие действия по формированию документа производиться не будут, поэтому
//                   нужно сформировать сообщения пользователю при необходимости самостоятельно.
//
Процедура ЗаполнитьДанныеДляУПДИнформацииПокупателяФНС_2019(Основания, ДеревоДанных, Отказ) Экспорт
	
	Если НЕ ТипЗнч(Основания) = Тип("Массив") Тогда
		Основания = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Основания);
	КонецЕсли;
	
	ОснованияЕИС = Новый Массив;
	Для каждого Основание Из Основания Цикл
		Если ТипЗнч(Основание) = Тип("ДокументСсылка.РезультатыРассмотренияДокументаПриемкиЕИС") Тогда
			ОснованияЕИС.Добавить(Основание);
		КонецЕсли;
	КонецЦикла;
	Если ОснованияЕИС.Количество() > 0 Тогда
		ЭлектронноеАктированиеБГУ.ЗаполнитьДанныеДляУПДИнформацииПокупателяЕИС(ОснованияЕИС, ДеревоДанных, Отказ);
		
		Возврат;
	КонецЕсли;	
	
	ОрганизацияСоставитель = Справочники.Организации.ПустаяСсылка();
	
	ЭтоПоступлениеУслугРабот = Ложь;
	Если Основания.Количество() = 0 Тогда
		ЕдинственнаяОрганизация(ОрганизацияСоставитель);
	Иначе	
		Для каждого ТекСтрока Из Основания Цикл
			ОрганизацияСоставитель = ТекСтрока.Организация;
			Если ТипЗнч(ТекСтрока) = Тип("ДокументСсылка.ПоступлениеУслугРабот") Тогда
				ЭтоПоступлениеУслугРабот = Истина;
				Прервать;
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;
	
	СведенияОПокупателе = Новый Структура;
	Если ЗначениеЗаполнено(ОрганизацияСоставитель) Тогда
		ПолучитьДанныеЮрФизЛица(ОрганизацияСоставитель, СведенияОПокупателе);
		ЭлектронноеВзаимодействие.ЗаполнитьЗначениеРеквизитаВДереве(ДеревоДанных,
			"СоставительДокументаНаименование", СведенияОПокупателе.ПолноеНаименование);
	Иначе
		Отказ = Истина;
		
		ТекстСообщения  = НСтр("ru='Чтобы утвердить, подписать и отправить ответную часть электронного документа необходимо сопоставить номенклатуру, создать или подобрать документы отражения в учете.
		|Для этого необходимо перейти по ссылке в колонке ""Отражение в учете"" списка.'");
		Сообщение       = Новый СообщениеПользователю();
		Сообщение.Текст = ТекстСообщения;
		Сообщение.Сообщить();
		
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Если ЭтоПоступлениеУслугРабот Тогда
		ЗапросТекст = 
			"ВЫБРАТЬ
			|	ПоступлениеТоваровУслуг.Дата КАК Дата,
			|	ПоступлениеТоваровУслуг.Организация.НаименованиеПолное КАК ОрганизацияНаименованиеПолное,
			|	ПоступлениеТоваровУслуг.Организация.ИНН КАК ОрганизацияИНН,
			|	ПоступлениеТоваровУслуг.Организация.КПП КАК ОрганизацияКПП,
			|	ПоступлениеТоваровУслуг.Организация.КодПоППП КАК ОрганизацияППП,
			|	ПоступлениеТоваровУслуг.УслугиРаботыПриняты КАК ТоварыПриняты,
			|	ПоступлениеТоваровУслуг.ДатаПолученияУслугиРаботы КАК ДатаПолученияТоваров,
			|	ПоступлениеТоваровУслуг.ОтветственныйПринялУслугиРаботыВид КАК ОтветственныйПринялТоварыВид,
			|	ПоступлениеТоваровУслуг.ОтветственныйПринялУслугиРаботыДолжность КАК ОтветственныйПринялТоварыДолжность,
			|	ПоступлениеТоваровУслуг.ОтветственныйПринялУслугиРаботыИныеСведения КАК ОтветственныйПринялТоварыИныеСведения,
			|	ПоступлениеТоваровУслуг.ОтветственныйПринялУслугиРаботы КАК ОтветственныйПринялТовары,
			|	ПоступлениеТоваровУслуг.ОтветственныйПринялУслугиРаботыДоверенность КАК ОтветственныйПринялТоварыДоверенность,
			|	ПоступлениеТоваровУслуг.ОтветственныйПринялУслугиРаботыОснованиеПолномочий КАК ОтветственныйПринялТоварыОснованиеПолномочий,
			|	ПоступлениеТоваровУслуг.ОтветственныйПринялУслугиРаботыКонтрагент КАК ОтветственныйПринялТоварыКонтрагент,
			|	ПоступлениеТоваровУслуг.Ссылка КАК Ссылка
			|ИЗ
			|	Документ.ПоступлениеУслугРабот КАК ПоступлениеТоваровУслуг
			|ГДЕ
			|	ПоступлениеТоваровУслуг.Ссылка В(&ДокументыОснования)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	СчетФактураПолученный.Дата КАК Дата,
			|	СчетФактураПолученный.Организация.НаименованиеПолное КАК ОрганизацияНаименованиеПолное,
			|	СчетФактураПолученный.Организация.ИНН КАК ОрганизацияИНН,
			|	СчетФактураПолученный.Организация.КПП КАК ОрганизацияКПП
			|ИЗ
			|	Документ.СчетФактураПолученный КАК СчетФактураПолученный
			|ГДЕ
			|	СчетФактураПолученный.Ссылка В(&ДокументыОснования)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ПоступлениеТоваровУслуг.Дата КАК Дата,
			|	ПоступлениеТоваровУслуг.Организация.НаименованиеПолное КАК ОрганизацияНаименованиеПолное,
			|	ПоступлениеТоваровУслуг.Организация.ИНН КАК ОрганизацияИНН,
			|	ПоступлениеТоваровУслуг.Организация.КПП КАК ОрганизацияКПП,
			|	ПоступлениеТоваровУслуг.Организация.КодПоППП КАК ОрганизацияППП,
			|	ПоступлениеТоваровУслуг.Ссылка КАК Ссылка,
			|	ПоступлениеТоваровУслуг.Контрагент КАК Контрагент,
			|	ПоступлениеТоваровУслуг.Договор КАК Договор,
			|	ПоступлениеТоваровУслуг.Организация КАК Организация,
			|	ПоступлениеТоваровУслуг.ГосЗакупкаКодОКТМОПокупателя КАК ГосЗакупкаКодОКТМОПокупателя,
			|	ПоступлениеТоваровУслуг.ГосЗакупкаКодОКТМОМестаПоставки КАК ГосЗакупкаКодОКТМОМестаПоставки,
			|	ПоступлениеТоваровУслуг.ГосЗакупкаПредельнаяДатаОплаты КАК ГосЗакупкаПредельнаяДатаОплаты,
			|	ПоступлениеТоваровУслуг.ГосЗакупкаНомерДенежногоОбязательства КАК ГосЗакупкаНомерДенежногоОбязательства,
			|	ПоступлениеТоваровУслуг.ГосЗакупкаОчередностьПлатежа КАК ГосЗакупкаОчередностьПлатежа,
			|	ПоступлениеТоваровУслуг.ГосЗакупкаВидПлатежа КАК ГосЗакупкаВидПлатежа,
			|	ПоступлениеТоваровУслуг.ГосЗакупкаРеквизитыЛицевогоСчетаПокупателя КАК ГосЗакупкаРеквизитыЛицевогоСчетаПокупателя,
			|	ПоступлениеТоваровУслуг.ГосЗакупкиДенежныеОбязательства.(
			|		Ссылка КАК Ссылка,
			|		НомерСтроки КАК НомерСтроки,
			|		ОбъектФАИП КАК ОбъектФАИП,
			|		ИсточникСредств КАК ИсточникСредств,
			|		КПС КАК КПС,
			|		КодЦели КАК КодЦели,
			|		СуммаАванса КАК СуммаАванса
			|	) КАК ГосЗакупкиДенежныеОбязательства
			|ИЗ
			|	Документ.ПоступлениеУслугРабот КАК ПоступлениеТоваровУслуг
			|ГДЕ
			|	ПоступлениеТоваровУслуг.Ссылка В(&ДокументыОснования)";
		
	Иначе	
		ЗапросТекст = 
		"ВЫБРАТЬ
		|	ПоступлениеТоваровУслуг.Дата КАК Дата,
		|	ПоступлениеТоваровУслуг.Организация.НаименованиеПолное КАК ОрганизацияНаименованиеПолное,
		|	ПоступлениеТоваровУслуг.Организация.ИНН КАК ОрганизацияИНН,
		|	ПоступлениеТоваровУслуг.Организация.КПП КАК ОрганизацияКПП,
		|	ПоступлениеТоваровУслуг.Организация.КодПоППП КАК ОрганизацияППП,
		|	ПоступлениеТоваровУслуг.ТоварыПриняты КАК ТоварыПриняты,
		|	ПоступлениеТоваровУслуг.ДатаПолученияТоваров КАК ДатаПолученияТоваров,
		|	ПоступлениеТоваровУслуг.ОтветственныйПринялТоварыВид КАК ОтветственныйПринялТоварыВид,
		|	ПоступлениеТоваровУслуг.ОтветственныйПринялТоварыДолжность КАК ОтветственныйПринялТоварыДолжность,
		|	ПоступлениеТоваровУслуг.ОтветственныйПринялТоварыИныеСведения КАК ОтветственныйПринялТоварыИныеСведения,
		|	ПоступлениеТоваровУслуг.ОтветственныйПринялТовары КАК ОтветственныйПринялТовары,
		|	ПоступлениеТоваровУслуг.ОтветственныйПринялТоварыДоверенность КАК ОтветственныйПринялТоварыДоверенность,
		|	ПоступлениеТоваровУслуг.ОтветственныйПринялТоварыОснованиеПолномочий КАК ОтветственныйПринялТоварыОснованиеПолномочий,
		|	ПоступлениеТоваровУслуг.ОтветственныйПринялТоварыКонтрагент КАК ОтветственныйПринялТоварыКонтрагент,
		|	ПоступлениеТоваровУслуг.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЭлектронныйДокументПоставщика КАК ПоступлениеТоваровУслуг
		|ГДЕ
		|	ПоступлениеТоваровУслуг.Ссылка В(&ДокументыОснования)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СчетФактураПолученный.Дата КАК Дата,
		|	СчетФактураПолученный.Организация.НаименованиеПолное КАК ОрганизацияНаименованиеПолное,
		|	СчетФактураПолученный.Организация.ИНН КАК ОрганизацияИНН,
		|	СчетФактураПолученный.Организация.КПП КАК ОрганизацияКПП,
		|	СчетФактураПолученный.Организация.КодПоППП КАК ОрганизацияППП
		|ИЗ
		|	Документ.СчетФактураПолученный КАК СчетФактураПолученный
		|ГДЕ
		|	СчетФактураПолученный.Ссылка В(&ДокументыОснования)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПоступлениеТоваровУслуг.Дата КАК Дата,
